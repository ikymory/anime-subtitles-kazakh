Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.08,0:00:07.42,Default,,0,0,0,,Сағыныштың елі қандай тамаша, Жер!
Dialogue: 0,0:00:09.38,0:00:14.43,Default,,0,0,0,,Уақыт келді, Нехеления-сама.
Dialogue: 0,0:00:14.93,0:00:15.80,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:00:17.43,0:00:18.35,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:27.82,0:00:29.32,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:00:42.54,0:00:44.00,Default,,0,0,0,,Сәуір айы
Dialogue: 0,0:00:44.62,0:00:47.42,Default,,0,0,0,,Усаги керемет түрде Джубан орта мектебіне түседі
Dialogue: 0,0:00:48.67,0:00:51.71,Default,,0,0,0,,Мамо-чан университеттің медициналық училищесін оңай тапсырды
Dialogue: 0,0:00:54.01,0:00:57.43,Default,,0,0,0,,Ал мен жақсы жауынгер болып өстім.
Dialogue: 0,0:00:57.51,0:01:00.39,Default,,0,0,0,,Мен 30-ғасырға оралуды шештім.
Dialogue: 0,0:01:01.72,0:01:05.31,Default,,0,0,0,,Әке, ана, қарсы алыңыздар!
Dialogue: 0,0:01:11.15,0:01:12.86,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:01:12.94,0:01:14.15,Default,,0,0,0,,Ғажайып адам
Dialogue: 0,0:01:14.24,0:01:15.36,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:01:15.45,0:01:18.28,Default,,0,0,0,,Бүгін - осы ғасырдағы ең үлкен күн тұтылу күні.
Dialogue: 0,0:01:18.37,0:01:20.66,Default,,0,0,0,,Таңертең теледидардан көрсетілді.
Dialogue: 0,0:01:20.74,0:01:22.20,Default,,0,0,0,,Кайкинишоку?
Dialogue: 0,0:01:22.83,0:01:25.54,Default,,0,0,0,,Жаңа ай күннің алдынан өтеді
Dialogue: 0,0:01:25.62,0:01:27.67,Default,,0,0,0,,Күнді бүркейтін құбылыс.
Dialogue: 0,0:01:28.25,0:01:31.55,Default,,0,0,0,,Жаңа ай күнді бүркемелейді...
Dialogue: 0,0:01:31.63,0:01:34.17,Default,,0,0,0,,Қаласаңыз, күн тұтылуына арналған әйнек алыңыз.
Dialogue: 0,0:01:34.67,0:01:36.47,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:01:36.55,0:01:37.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:40.64,0:01:41.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:41.97,0:01:43.68,Default,,0,0,0,,Күн сөне бастады
Dialogue: 0,0:01:43.77,0:01:46.14,Default,,0,0,0,,Қызық, қазір қояндар қарап тұр ма?
Dialogue: 0,0:01:46.23,0:01:49.52,Default,,0,0,0,,Күннің толық тұтылуын осындай қолайлы жағдайларда көруге болады.
Dialogue: 0,0:01:49.61,0:01:51.36,Default,,0,0,0,,1000 жылда бір рет болуы керек!
Dialogue: 0,0:01:51.44,0:01:52.36,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:01:52.44,0:01:54.32,Default,,0,0,0,,Тілек айтсаңыз, ол орындалуы мүмкін!
Dialogue: 0,0:01:54.94,0:01:56.61,Default,,0,0,0,,Менің арманым – кумир болу!
Dialogue: 0,0:01:56.70,0:01:59.24,Default,,0,0,0,,Сіз өте танымал кумирге айналасыз деп үміттенемін!
Dialogue: 0,0:01:59.32,0:02:00.99,Default,,0,0,0,,Хехе... Мина болса
Dialogue: 0,0:02:01.08,0:02:03.08,Default,,0,0,0,,Менің арманым сенің әйелің болу!
Dialogue: 0,0:02:03.16,0:02:06.16,Default,,0,0,0,,Гүл сататын дүкен немесе торт дүкенін жүргізген кезде
Dialogue: 0,0:02:06.25,0:02:08.58,Default,,0,0,0,,Мен бақытты әйел болғым келеді.
Dialogue: 0,0:02:08.67,0:02:10.00,Default,,0,0,0,,Мако-чан сараң!
Dialogue: 0,0:02:10.08,0:02:12.50,Default,,0,0,0,,Менің арманым дәрігер болу
Dialogue: 0,0:02:12.59,0:02:14.59,Default,,0,0,0,,Сізден керемет дәрігер болады деп үміттенемін!
Dialogue: 0,0:02:14.67,0:02:17.38,Default,,0,0,0,,Мен ата жолын қуамын.
Dialogue: 0,0:02:17.47,0:02:20.43,Default,,0,0,0,,Сіз Хикава храмының тамаша бас діни қызметкері бола аласыз деп үміттенемін.
Dialogue: 0,0:02:22.51,0:02:23.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:25.68,0:02:27.98,Default,,0,0,0,,Қараңғыланып барады...
Dialogue: 0,0:02:32.65,0:02:34.32,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:02:36.19,0:02:37.15,Default,,0,0,0,,Қоңыраудың дыбысы?
Dialogue: 0,0:02:37.24,0:02:39.07,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:02:39.15,0:02:41.87,Default,,0,0,0,,Дыбыс қандай таза, әдемі
Dialogue: 0,0:02:41.95,0:02:42.83,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:02:42.91,0:02:44.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:45.95,0:02:46.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:47.71,0:02:48.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:48.71,0:02:49.62,Default,,0,0,0,,Маған көмектесіңіз...
Dialogue: 0,0:02:50.92,0:02:52.04,Default,,0,0,0,,Қыз
Dialogue: 0,0:02:53.09,0:02:54.04,Default,,0,0,0,,Әдемі қыз
Dialogue: 0,0:02:56.59,0:02:58.38,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:03:00.72,0:03:01.72,Default,,0,0,0,,Қыз…
Dialogue: 0,0:03:02.72,0:03:03.55,Default,,0,0,0,,Pegasus?
Dialogue: 0,0:03:03.64,0:03:04.56,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:04.64,0:03:06.68,Default,,0,0,0,,Мамо-чан да көрді ме?
Dialogue: 0,0:03:06.77,0:03:07.47,Default,,0,0,0,,О
Dialogue: 0,0:03:08.02,0:03:09.18,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:03:09.27,0:03:09.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:10.02,0:03:11.81,Default,,0,0,0,,Мамо-чан! Мамору-сама!
Dialogue: 0,0:03:12.44,0:03:14.69,Default,,0,0,0,,Мен жай ғана жеңілдеп қалдым.
Dialogue: 0,0:03:15.65,0:03:17.99,Default,,0,0,0,,Не? Ауыруы қазір
Dialogue: 0,0:03:18.07,0:03:22.16,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:25.20,0:03:27.45,Default,,0,0,0,,Күн мен жаңа ай...
Dialogue: 0,0:03:27.54,0:03:28.91,Default,,0,0,0,,Жабу
Dialogue: 0,0:03:30.29,0:03:33.33,Default,,0,0,0,,Жүр, цирк келді!
Dialogue: 0,0:03:33.42,0:03:36.50,Default,,0,0,0,,Әдемі армандарға толы жарықтар қаласы
Dialogue: 0,0:03:36.59,0:03:38.38,Default,,0,0,0,,Менің арманымдағы ел!
Dialogue: 0,0:03:38.46,0:03:41.43,Default,,0,0,0,,Мен бұл сәтті көптен күттім!
Dialogue: 0,0:03:41.51,0:03:44.22,Default,,0,0,0,,Біз өлі ай циркі
Dialogue: 0,0:03:44.30,0:03:45.89,Default,,0,0,0,,Сіз осындасыз!
Dialogue: 0,0:03:48.89,0:03:51.23,Default,,0,0,0,,Қанға боялған жерде жатқан Курису Макисе және
Dialogue: 0,0:03:51.89,0:03:54.65,Default,,0,0,0,,Бүгін күн тұтылудан кеме шықты!
Dialogue: 0,0:03:54.73,0:03:57.61,Default,,0,0,0,,Мен қателеспеген сияқтымын.
Dialogue: 0,0:03:58.78,0:04:00.07,Default,,0,0,0,,Бұл жайлы жаман сезім бар
Dialogue: 0,0:04:02.86,0:04:03.57,Default,,0,0,0,,(Гильда) Бірден көп жеме – аздап-аздап же.
Dialogue: 0,0:04:03.66,0:04:05.91,Default,,0,0,0,,Мен көрдім, тамаша.
Dialogue: 0,0:04:05.99,0:04:07.28,Default,,0,0,0,,Не? ток
Dialogue: 0,0:04:07.37,0:04:09.70,Default,,0,0,0,,Өлі Ай циркі…
Dialogue: 0,0:04:09.79,0:04:12.16,Default,,0,0,0,,Солай естілгеніне сенімдімін.
Dialogue: 0,0:04:12.25,0:04:14.12,Default,,0,0,0,,Фобос! Димос!
Dialogue: 0,0:04:20.21,0:04:21.09,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:21.80,0:04:22.84,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:04:24.30,0:04:26.18,Default,,0,0,0,,Tarot Moon картасы
Dialogue: 0,0:04:26.68,0:04:29.56,Default,,0,0,0,,Мағынасы «уайымдау, жаман ескерту»
Dialogue: 0,0:04:30.89,0:04:34.02,Default,,0,0,0,,Осыны айтып тұрсыз ба? Фобос Димос
Dialogue: 0,0:04:35.10,0:04:37.90,Default,,0,0,0,,Мамо-чан, бұрынғы кеме...
Dialogue: 0,0:04:37.98,0:04:39.27,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:39.36,0:04:42.61,Default,,0,0,0,,Қандай жағдай болмасын, біз бұл дүниені қорғаймыз.
Dialogue: 0,0:04:42.70,0:04:44.07,Default,,0,0,0,,Не? Қоян
Dialogue: 0,0:04:44.15,0:04:44.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:44.91,0:04:46.16,Default,,0,0,0,,Әрине!
Dialogue: 0,0:04:46.24,0:04:48.20,Default,,0,0,0,,Мұны бізге қалдырыңыз.
Dialogue: 0,0:04:48.28,0:04:50.58,Default,,0,0,0,,Чибиуса болашаққа бейбіт түрде орала алады.
Dialogue: 0,0:04:50.66,0:04:51.50,Default,,0,0,0,,Эй?
Dialogue: 0,0:04:52.71,0:04:55.04,Default,,0,0,0,,Жарайды, егер бұл жай қоян болса, мен уайымдайтын едім.
Dialogue: 0,0:04:55.12,0:04:57.58,Default,,0,0,0,,Мамо-чан және басқалары да сонда.
Dialogue: 0,0:04:57.67,0:04:58.67,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:04:58.75,0:05:01.21,Default,,0,0,0,,Бірақ қазір адамдар тым көп.
Dialogue: 0,0:05:01.30,0:05:04.09,Default,,0,0,0,,Чибиусаның болашаққа оралуы мүмкін емес.
Dialogue: 0,0:05:04.17,0:05:05.72,Default,,0,0,0,,Кейінірек келесің бе?
Dialogue: 0,0:05:05.80,0:05:06.68,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:06.76,0:05:09.31,Default,,0,0,0,,О, сәл күте тұрыңыз!
Dialogue: 0,0:05:12.06,0:05:12.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:13.60,0:05:15.35,Default,,0,0,0,,Мамо-чан, бұл...
Dialogue: 0,0:05:15.44,0:05:16.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:16.85,0:05:19.94,Default,,0,0,0,,«Амазонкадан: жұмбақ өлі ай циркі»
Dialogue: 0,0:05:20.02,0:05:22.90,Default,,0,0,0,,«Әлем бойынша, ақырында қону»
Dialogue: 0,0:05:23.65,0:05:26.99,Default,,0,0,0,,«Танукиана Сакагами саябағында жұртшылық үшін ашық»
Dialogue: 0,0:05:28.91,0:05:30.70,Default,,0,0,0,,Өлі Ай циркі…
Dialogue: 0,0:05:31.41,0:05:32.62,Default,,0,0,0,,Ал енді Пенбардан келген соңғы видео бар.
Dialogue: 0,0:05:33.91,0:05:35.83,Default,,0,0,0,,Әй, Чибиуса!
Dialogue: 0,0:05:39.29,0:05:41.09,Default,,0,0,0,,Не болды? Чибиуза
Dialogue: 0,0:05:41.17,0:05:42.30,Default,,0,0,0,,Бұл…
Dialogue: 0,0:05:42.38,0:05:44.17,Default,,0,0,0,,Шыны калейдоскоп?
Dialogue: 0,0:05:44.26,0:05:45.26,Default,,0,0,0,,Әдемі!
Dialogue: 0,0:05:45.34,0:05:46.38,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:05:46.47,0:05:49.89,Default,,0,0,0,,Калейдоскоп мырза сізден «сатып алуды және сатып алуды» сұрайды!
Dialogue: 0,0:05:49.97,0:05:51.26,Default,,0,0,0,,А, мен де!
Dialogue: 0,0:05:51.35,0:05:53.97,Default,,0,0,0,,Мен мұны қалаймын!
Dialogue: 0,0:05:54.06,0:05:54.77,Default,,0,0,0,,Хаа…
Dialogue: 0,0:05:54.85,0:05:56.35,Default,,0,0,0,,Аа, бұл да сүйкімді!
Dialogue: 0,0:05:56.44,0:05:58.73,Default,,0,0,0,,Усаги алдамшы! Хмм...
Dialogue: 0,0:05:58.81,0:06:00.77,Default,,0,0,0,,Әй, Мамо-чан!
Dialogue: 0,0:06:01.36,0:06:02.27,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:06:02.36,0:06:03.15,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:03.23,0:06:04.74,Default,,0,0,0,,Мамо-чанға рахмет
Dialogue: 0,0:06:04.82,0:06:06.15,Default,,0,0,0,,Мен оны бағалаймын.
Dialogue: 0,0:06:06.24,0:06:07.36,Default,,0,0,0,,Эххе
Dialogue: 0,0:06:07.45,0:06:09.49,Default,,0,0,0,,Мамо-чан маған сәйкес жұп сатып алды.
Dialogue: 0,0:06:09.57,0:06:10.82,Default,,0,0,0,,Бұл менің бірінші рет!
Dialogue: 0,0:06:10.91,0:06:11.91,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:13.29,0:06:16.50,Default,,0,0,0,,Иә, әлі де аз адамдар бар.
Dialogue: 0,0:06:16.58,0:06:19.58,Default,,0,0,0,,Чибиуса, ертең таңертең үйге қашан келесің?
Dialogue: 0,0:06:19.67,0:06:21.29,Default,,0,0,0,,Түнде қауіпті.
Dialogue: 0,0:06:21.38,0:06:22.46,Default,,0,0,0,,Олай болса орындаңыз!
Dialogue: 0,0:06:23.09,0:06:25.01,Default,,0,0,0,,Мамо-чан, жүр, білесің бе.
Dialogue: 0,0:06:25.09,0:06:26.92,Default,,0,0,0,,Менің өтінішім бар...
Dialogue: 0,0:06:27.01,0:06:28.43,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:06:28.51,0:06:29.72,Default,,0,0,0,,Оттомари~♪
Dialogue: 0,0:06:29.80,0:06:30.97,Default,,0,0,0,,(телефонның қоңырау үні)
Dialogue: 0,0:06:31.05,0:06:33.47,Default,,0,0,0,,Мен Мамо-чанның пижамасын қарызға алдым
Dialogue: 0,0:06:33.56,0:06:34.56,Default,,0,0,0,,Әй, ана?
Dialogue: 0,0:06:34.64,0:06:38.10,Default,,0,0,0,,Мен қазір Мамочанчиде оқимын... Иә, иә.
Dialogue: 0,0:06:38.19,0:06:40.48,Default,,0,0,0,,Мен бүгін түнде қалуым мүмкін. Сонда кездескенше!
Dialogue: 0,0:06:41.94,0:06:44.15,Default,,0,0,0,,Уау, өте әдемі!
Dialogue: 0,0:06:44.23,0:06:46.24,Default,,0,0,0,,Маған осындай нәрсе керек еді
Dialogue: 0,0:06:46.32,0:06:47.40,Default,,0,0,0,,Кя~!
Dialogue: 0,0:06:47.49,0:06:50.53,Default,,0,0,0,,Чибиуса, мен ертең сағат 5-те тұрып, үйге барамын.
Dialogue: 0,0:06:50.61,0:06:51.28,Default,,0,0,0,,Ерте ұйықтаңыз
Dialogue: 0,0:06:51.37,0:06:52.16,Default,,0,0,0,,Эх!
Dialogue: 0,0:06:52.74,0:06:54.95,Default,,0,0,0,,Қоян, үйге бару керек.
Dialogue: 0,0:06:55.04,0:06:56.37,Default,,0,0,0,,Сіз менің сенімімді жоғалтасыз, солай ма?
Dialogue: 0,0:06:56.45,0:06:57.37,Default,,0,0,0,,Эх!
Dialogue: 0,0:06:57.45,0:06:59.58,Default,,0,0,0,,Менің үйге барғым келмейді!
Dialogue: 0,0:06:59.67,0:07:00.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:04.09,0:07:04.88,Default,,0,0,0,,Уау
Dialogue: 0,0:07:04.96,0:07:06.26,Default,,0,0,0,,Гааах!
Dialogue: 0,0:07:06.34,0:07:10.13,Default,,0,0,0,,Мен қызымды өсірсем, міндетті түрде қатаң түрде тәрбиелеймін.
Dialogue: 0,0:07:10.22,0:07:11.64,Default,,0,0,0,,Ngggg…
Dialogue: 0,0:07:11.72,0:07:14.76,Default,,0,0,0,,Балалардың ашық еркелегені жақсы.
Dialogue: 0,0:07:14.85,0:07:18.06,Default,,0,0,0,,Хаа~ Мен де Чибиуса сияқты кішкентай болғым келеді.
Dialogue: 0,0:07:18.14,0:07:20.98,Default,,0,0,0,,Е! Мен мүмкіндігінше тезірек ересек болғым келеді!
Dialogue: 0,0:07:21.06,0:07:23.36,Default,,0,0,0,,Содан кейін, Мамо-чаннан
Dialogue: 0,0:07:23.44,0:07:26.19,Default,,0,0,0,,Сіз толыққанды әйел ретінде көрінесіз, солай ма?
Dialogue: 0,0:07:26.28,0:07:28.74,Default,,0,0,0,,Неге олай дейсің, Мамо-чан сонша мүйізді болса да!
Dialogue: 0,0:07:28.82,0:07:29.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:29.78,0:07:31.20,Default,,0,0,0,,Өтінемін, ұйықта!
Dialogue: 0,0:07:33.28,0:07:34.62,Default,,0,0,0,,Бұл шынымен менмін
Dialogue: 0,0:07:34.70,0:07:36.79,Default,,0,0,0,,Мен қоян сияқты болғым келеді
Dialogue: 0,0:07:36.87,0:07:40.08,Default,,0,0,0,,Ұзын, жіңішке аяқтары
Dialogue: 0,0:07:40.58,0:07:42.08,Default,,0,0,0,,Үлпілдек кеуде
Dialogue: 0,0:07:42.17,0:07:44.29,Default,,0,0,0,,Жұмсақ және ұзын шаш
Dialogue: 0,0:07:45.38,0:07:46.46,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:07:46.55,0:07:49.55,Default,,0,0,0,,Мен де қоян сияқты асығамын...
Dialogue: 0,0:07:50.72,0:07:51.84,Default,,0,0,0,,Сіз ұйықтай алмайсыз ба?
Dialogue: 0,0:07:51.93,0:07:54.01,Default,,0,0,0,,А... ештеңе!
Dialogue: 0,0:07:54.55,0:07:56.43,Default,,0,0,0,,Ертең 30 ғасыр.
Dialogue: 0,0:07:56.51,0:07:57.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:57.97,0:08:00.31,Default,,0,0,0,,Эй, менімен сөйлесші.
Dialogue: 0,0:08:00.39,0:08:01.35,Default,,0,0,0,,Әңгіме?
Dialogue: 0,0:08:01.89,0:08:05.52,Default,,0,0,0,,Түнде ұйықтағанда анам маған ертегі айтып беретін.
Dialogue: 0,0:08:06.57,0:08:08.69,Default,,0,0,0,,Теңізге батқан ұлы империя
Dialogue: 0,0:08:08.78,0:08:09.78,Default,,0,0,0,,Пирамидалар туралы жұмбақ
Dialogue: 0,0:08:10.57,0:08:11.99,Default,,0,0,0,,Қарғыс атқан гауһарға
Dialogue: 0,0:08:12.82,0:08:14.74,Default,,0,0,0,,Android құрылғылары, вампирлер,
Dialogue: 0,0:08:14.82,0:08:16.99,Default,,0,0,0,,Айна оқиғасы т.б.
Dialogue: 0,0:08:17.66,0:08:18.99,Default,,0,0,0,,Айна оқиғасы?
Dialogue: 0,0:08:19.95,0:08:21.83,Default,,0,0,0,,Білесің бе, айнаның арғы жағында
Dialogue: 0,0:08:21.91,0:08:25.50,Default,,0,0,0,,Қап қараңғы басқа әлем бар.
Dialogue: 0,0:08:25.58,0:08:28.63,Default,,0,0,0,,Сонымен, ай жаңарған қоңыр түнде
Dialogue: 0,0:08:28.71,0:08:30.67,Default,,0,0,0,,Айнаға қарамау керек
Dialogue: 0,0:08:31.22,0:08:35.01,Default,,0,0,0,,Өйткені мен айнаның ішіндегі басқа әлемге тартылдым.
Dialogue: 0,0:08:35.09,0:08:37.97,Default,,0,0,0,,Ей, мен енді түнде айнаға қарай алмаймын.
Dialogue: 0,0:08:38.06,0:08:40.18,Default,,0,0,0,,Чибиусаның ақымақ! қайырлы түн!
Dialogue: 0,0:08:40.27,0:08:41.35,Default,,0,0,0,,Бала?
Dialogue: 0,0:08:42.43,0:08:44.23,Default,,0,0,0,,Чибиуса жетілген.
Dialogue: 0,0:08:44.31,0:08:45.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:45.81,0:08:48.32,Default,,0,0,0,,Мамо-чан, бұл рас па?
Dialogue: 0,0:08:48.40,0:08:52.53,Default,,0,0,0,,Бұл менмін, тезірек есейгім келеді.
Dialogue: 0,0:08:56.12,0:08:59.83,Default,,0,0,0,,Күн сәулесі қарт адамдарға тым ашық.
Dialogue: 0,0:08:59.91,0:09:02.75,Default,,0,0,0,,Түнде мен өзімді жеңіл сезінемін
Dialogue: 0,0:09:04.04,0:09:06.38,Default,,0,0,0,,Осы қалада ерте
Dialogue: 0,0:09:06.46,0:09:10.75,Default,,0,0,0,,Мен өз циркімді табысты етуім керек.
Dialogue: 0,0:09:11.80,0:09:13.26,Default,,0,0,0,,Циркон
Dialogue: 0,0:09:14.88,0:09:18.55,Default,,0,0,0,,Сіз мені естисіз бе? Кішкентай қыздар
Dialogue: 0,0:09:18.64,0:09:21.02,Default,,0,0,0,,Мен білемін, әже.
Dialogue: 0,0:09:21.10,0:09:22.89,Default,,0,0,0,,Ура! Йо! біртүрлі!
Dialogue: 0,0:09:23.48,0:09:26.60,Default,,0,0,0,,Оны допты пайдаланушылардың амазониялық квартетіне қалдыратын кез келді.
Dialogue: 0,0:09:26.69,0:09:30.15,Default,,0,0,0,,Біздің бизнесімізге араласпау үшін.
Dialogue: 0,0:09:31.94,0:09:34.19,Default,,0,0,0,,Тіпті бір көріксіз жәндік келіп-кетіп жатыр
Dialogue: 0,0:09:34.28,0:09:35.57,Default,,0,0,0,,Мен сені кешіре алмаймын!
Dialogue: 0,0:09:35.65,0:09:38.37,Default,,0,0,0,,Кіру және шығу есіктері тығыз жабылуы керек.
Dialogue: 0,0:09:39.28,0:09:42.41,Default,,0,0,0,,Біздің амазонкалар арасында қалған қарғыс атқан тас.
Dialogue: 0,0:09:42.49,0:09:44.37,Default,,0,0,0,,Amazon Stone!
Dialogue: 0,0:09:45.37,0:09:46.87,Default,,0,0,0,,Нефриттен жасалған тәж!
Dialogue: 0,0:09:54.01,0:09:56.63,Default,,0,0,0,,Қыз... Қыз
Dialogue: 0,0:09:57.55,0:09:59.72,Default,,0,0,0,,Қыз? Бұл...
Dialogue: 0,0:10:00.39,0:10:02.10,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:10:03.31,0:10:04.35,Default,,0,0,0,,Ұшу!
Dialogue: 0,0:10:05.68,0:10:06.98,Default,,0,0,0,,Pegasus ол кезде?
Dialogue: 0,0:10:07.81,0:10:10.11,Default,,0,0,0,,Әдемі армандары бар қыз
Dialogue: 0,0:10:10.19,0:10:11.07,Default,,0,0,0,,Қыз…
Dialogue: 0,0:10:11.86,0:10:14.78,Default,,0,0,0,,Сіз шынымен мені айтқыңыз келді ме?
Dialogue: 0,0:10:14.86,0:10:15.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:16.15,0:10:18.78,Default,,0,0,0,,Уау! әдемі!
Dialogue: 0,0:10:19.62,0:10:21.70,Default,,0,0,0,,Сізге бұл көрініс ұнай ма?
Dialogue: 0,0:10:21.78,0:10:22.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:24.50,0:10:25.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:25.33,0:10:27.71,Default,,0,0,0,,Тек сонда ғана қараңғы
Dialogue: 0,0:10:27.79,0:10:29.38,Default,,0,0,0,,Бұл сіз тұрған қала.
Dialogue: 0,0:10:29.46,0:10:32.54,Default,,0,0,0,,А... Бұл Джубан сауда ауданы ма?
Dialogue: 0,0:10:32.63,0:10:34.51,Default,,0,0,0,,Неліктен түн қараңғы?
Dialogue: 0,0:10:41.35,0:10:43.22,Default,,0,0,0,,Маған қолыңды бер
Dialogue: 0,0:10:49.02,0:10:50.60,Default,,0,0,0,,Suzu…
Dialogue: 0,0:10:50.69,0:10:52.90,Default,,0,0,0,,Қажет болса
Dialogue: 0,0:10:52.98,0:10:54.94,Default,,0,0,0,,Маған сол қоңыраумен қоңырау шалыңыз
Dialogue: 0,0:10:55.82,0:10:57.40,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:57.49,0:10:59.61,Default,,0,0,0,,Мен Пегасуспын
Dialogue: 0,0:10:59.70,0:11:01.24,Default,,0,0,0,,Бұл Элиос
Dialogue: 0,0:11:02.07,0:11:02.99,Default,,0,0,0,,Қыз
Dialogue: 0,0:11:03.58,0:11:05.10,Default,,0,0,0,,Міндетті түрде өз күшіңіз болыңыз
Dialogue: 0,0:11:06.83,0:11:08.33,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:11:08.41,0:11:11.04,Default,,0,0,0,,Маған күшіңізді беріңізші
Dialogue: 0,0:11:11.13,0:11:12.33,Default,,0,0,0,,Менікі?
Dialogue: 0,0:11:12.42,0:11:15.50,Default,,0,0,0,,Мен Элизийді құтқарғым келеді.
Dialogue: 0,0:11:15.59,0:11:18.51,Default,,0,0,0,,Маған Алтын Кристалл керек.
Dialogue: 0,0:11:18.59,0:11:20.38,Default,,0,0,0,,Элиос!
Dialogue: 0,0:11:21.01,0:11:21.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:23.14,0:11:25.43,Default,,0,0,0,,Амансың ба? кішкентай ханым
Dialogue: 0,0:11:26.02,0:11:27.10,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:11:28.27,0:11:29.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:32.60,0:11:34.19,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,0:11:48.12,0:11:49.50,Default,,0,0,0,,Түсінде...
Dialogue: 0,0:11:49.58,0:11:51.71,Default,,0,0,0,,Чибиуса, әлгі Пегас...
Dialogue: 0,0:11:51.79,0:11:54.67,Default,,0,0,0,,Ха... Мамо-чан, сенің де түсің бар ма?
Dialogue: 0,0:11:54.75,0:11:55.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:56.21,0:11:57.71,Default,,0,0,0,,Мамо-чан мынау!
Dialogue: 0,0:11:57.80,0:11:59.09,Default,,0,0,0,,Мен үйге жалғыз барамын
Dialogue: 0,0:11:59.72,0:12:03.18,Default,,0,0,0,,Уайымдама, мен саған тағы да келемін.
Dialogue: 0,0:12:03.26,0:12:05.93,Default,,0,0,0,,Көріскенше, Чибиуса
Dialogue: 0,0:12:07.47,0:12:08.93,Default,,0,0,0,,Кішкентай ханым?
Dialogue: 0,0:12:10.89,0:12:13.19,Default,,0,0,0,,Менің үйге барғым келмейді
Dialogue: 0,0:12:13.77,0:12:14.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:14.77,0:12:16.65,Default,,0,0,0,,Мен Элиоспын
Dialogue: 0,0:12:16.73,0:12:19.15,Default,,0,0,0,,Мен Элизийді құтқарғым келеді.
Dialogue: 0,0:12:20.03,0:12:22.99,Default,,0,0,0,,Маған Алтын Кристалл керек.
Dialogue: 0,0:12:23.07,0:12:24.99,Default,,0,0,0,,Оның көзі байыпты.
Dialogue: 0,0:12:25.07,0:12:27.99,Default,,0,0,0,,Көмек сұрап тұрғандай көрінді
Dialogue: 0,0:12:30.62,0:12:32.21,Default,,0,0,0,,Кішкентай ханым…
Dialogue: 0,0:12:33.25,0:12:35.17,Default,,0,0,0,,Уақыт қорғаушысы!
Dialogue: 0,0:12:35.25,0:12:40.09,Default,,0,0,0,,Уақыт пен кеңістіктің есігі, Аспанды жарып, маған аш!
Dialogue: 0,0:12:40.17,0:12:42.88,Default,,0,0,0,,Мен сенің шын атыңды атаймын!
Dialogue: 0,0:12:42.97,0:12:47.18,Default,,0,0,0,,Уақыттың Құдіретті Құдайы, Сақшылардың Әкесі, Кронус!
Dialogue: 0,0:12:47.26,0:12:49.47,Default,,0,0,0,,Маған жол көрсет!
Dialogue: 0,0:12:49.56,0:12:51.18,Default,,0,0,0,,Мені қорға!
Dialogue: 0,0:12:51.77,0:12:53.48,Default,,0,0,0,,Маған жарық жолын әкел!
Dialogue: 0,0:12:54.94,0:12:56.94,Default,,0,0,0,,Взвод мүшелерінің бір-бірімен шайқасуына болмайды!
Dialogue: 0,0:12:58.40,0:13:00.28,Default,,0,0,0,,Кішкентай ханым!
Dialogue: 0,0:13:00.36,0:13:01.53,Default,,0,0,0,,Чибиуса!
Dialogue: 0,0:13:01.61,0:13:03.40,Default,,0,0,0,,Усаги-сама! Мамору-сама!
Dialogue: 0,0:13:03.49,0:13:05.86,Default,,0,0,0,,Кеңістік-уақыт кілті жұмыс істемейді.
Dialogue: 0,0:13:05.95,0:13:07.07,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:13:07.16,0:13:07.91,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:13:11.04,0:13:11.91,Default,,0,0,0,,Қыз
Dialogue: 0,0:13:12.00,0:13:13.12,Default,,0,0,0,,Элиос!
Dialogue: 0,0:13:13.75,0:13:15.50,Default,,0,0,0,,Маған күшіңізді беріңіз...
Dialogue: 0,0:13:16.46,0:13:17.71,Default,,0,0,0,,Сол Pegasus...
Dialogue: 0,0:13:17.79,0:13:19.50,Default,,0,0,0,,Қоян Мамо-чан
Dialogue: 0,0:13:19.59,0:13:21.71,Default,,0,0,0,,Маған үйге барудың қажеті жоқ!
Dialogue: 0,0:13:21.80,0:13:23.80,Default,,0,0,0,,Одан да әлгі Pegasus.
Dialogue: 0,0:13:23.88,0:13:25.72,Default,,0,0,0,,Сіз көмек сұрап жатқан сияқтысыз
Dialogue: 0,0:13:25.80,0:13:27.80,Default,,0,0,0,,Мен саған күшімді бергім келеді!
Dialogue: 0,0:13:29.56,0:13:31.68,Default,,0,0,0,,Мен сеземін... Мен оны сезінемін.
Dialogue: 0,0:13:32.27,0:13:35.94,Default,,0,0,0,,Біреу күшпен тосқауылдан өтпек болды.
Dialogue: 0,0:13:36.73,0:13:38.90,Default,,0,0,0,,Мен оны қарап шығуым керек.
Dialogue: 0,0:13:42.40,0:13:44.82,Default,,0,0,0,,Бар, Тора-но-ме-чан!
Dialogue: 0,0:13:44.90,0:13:48.16,Default,,0,0,0,,Сол күдікті жігіттердің құйрығынан ұстаңыз!
Dialogue: 0,0:13:48.24,0:13:50.24,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:13:51.04,0:13:53.58,Default,,0,0,0,,Элиос - Пегас.
Dialogue: 0,0:13:53.66,0:13:55.46,Default,,0,0,0,,«Мен Элизийді құтқарғым келеді»
Dialogue: 0,0:13:55.54,0:13:57.50,Default,,0,0,0,,«Алтын кристалл қажет»
Dialogue: 0,0:13:57.58,0:13:58.92,Default,,0,0,0,,Сіз мұны айттыңыз ба?
Dialogue: 0,0:13:59.59,0:14:00.42,Default,,0,0,0,,Иә
Dialogue: 0,0:14:01.05,0:14:02.88,Default,,0,0,0,,Элизиум…
Dialogue: 0,0:14:02.96,0:14:04.88,Default,,0,0,0,,Әйтеуір ностальгиялық естіледі...
Dialogue: 0,0:14:05.47,0:14:07.76,Default,,0,0,0,,Сіз кімсіз? Сол Пегасус
Dialogue: 0,0:14:09.35,0:14:12.97,Default,,0,0,0,,Солай болса да, кеңістік-уақыт кілті жұмыс істемейді...
Dialogue: 0,0:14:14.85,0:14:15.98,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:14:16.06,0:14:17.73,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:17.81,0:14:19.73,Default,,0,0,0,,Бірдеңе болған сияқты.
Dialogue: 0,0:14:20.86,0:14:22.94,Default,,0,0,0,,Цирк ұжымынан жолбарыс қашып кетті.
Dialogue: 0,0:14:23.03,0:14:25.24,Default,,0,0,0,,Мен Джубан сауда ауданына жүгірдім.
Dialogue: 0,0:14:25.32,0:14:26.57,Default,,0,0,0,,Жолбарыс?
Dialogue: 0,0:14:28.16,0:14:30.57,Default,,0,0,0,,Біз барлығын қорғауымыз керек!
Dialogue: 0,0:14:33.04,0:14:34.16,Default,,0,0,0,,Қоян! Чибиуса!
Dialogue: 0,0:14:34.24,0:14:35.16,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:36.75,0:14:39.46,Default,,0,0,0,,Бұл тікенді шаншып ауырды тағы
Dialogue: 0,0:14:44.76,0:14:47.42,Default,,0,0,0,,Чибиуса, түрлен! иә!
Dialogue: 0,0:14:47.51,0:14:50.18,Default,,0,0,0,,Айдың ғарыштық күші!
Dialogue: 0,0:14:50.26,0:14:52.43,Default,,0,0,0,,Ай призмасының күші!
Dialogue: 0,0:14:52.51,0:14:54.68,Default,,0,0,0,,Макияж!
Dialogue: 0,0:14:56.10,0:14:58.06,Default,,0,0,0,,Хмм... О, не?
Dialogue: 0,0:14:58.14,0:14:59.19,Default,,0,0,0,,Хмм?
Dialogue: 0,0:14:59.27,0:15:00.10,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:15:01.15,0:15:02.06,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:15:02.15,0:15:03.27,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:15:03.36,0:15:05.44,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:15:06.78,0:15:07.53,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:15.33,0:15:16.95,Default,,0,0,0,,Неліктен өзгерте алмайсыз?
Dialogue: 0,0:15:22.33,0:15:23.46,Default,,0,0,0,,Қасиетті Граил...
Dialogue: 0,0:15:26.76,0:15:27.59,Default,,0,0,0,,Қасиетті Граил
Dialogue: 0,0:15:27.67,0:15:30.88,Default,,0,0,0,,Тоғыз жауынгердің күші бір жерге жиналғанда не пайда болды
Dialogue: 0,0:15:33.68,0:15:36.39,Default,,0,0,0,,Бұл үшеуі енді жоқ.
Dialogue: 0,0:15:38.02,0:15:38.85,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:39.35,0:15:41.90,Default,,0,0,0,,Біз күресуіміз керек!
Dialogue: 0,0:15:42.52,0:15:45.65,Default,,0,0,0,,Қараңызшы, ішімізден толып жатыр.
Dialogue: 0,0:15:45.73,0:15:48.82,Default,,0,0,0,,Бұрынғыдан өзгеше жаңа қуат
Dialogue: 0,0:15:51.49,0:15:56.04,Default,,0,0,0,,Ай дағдарысына арналған макияж!
Dialogue: 0,0:16:24.73,0:16:26.48,Default,,0,0,0,,Махаббат пен әділеттілік
Dialogue: 0,0:16:27.19,0:16:29.40,Default,,0,0,0,,Матрос костюмі әдемі жауынгер қыз
Dialogue: 0,0:16:30.07,0:16:32.36,Default,,0,0,0,,Супер Сейлор Мун!
Dialogue: 0,0:16:33.74,0:16:36.12,Default,,0,0,0,,Супер Сейлор Чиби Мун!
Dialogue: 0,0:16:36.99,0:16:39.37,Default,,0,0,0,,Ай атынан
Dialogue: 0,0:16:39.45,0:16:41.08,Default,,0,0,0,,Мені жазала!
Dialogue: 0,0:16:43.12,0:16:44.63,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:16:44.71,0:16:45.83,Default,,0,0,0,,Йотто!
Dialogue: 0,0:16:47.71,0:16:49.25,Default,,0,0,0,,Тора но Ме-чан
Dialogue: 0,0:16:49.34,0:16:51.76,Default,,0,0,0,,Күдікті адамды әшкерелеудегі қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:16:53.93,0:16:57.18,Default,,0,0,0,,Барьерді бұзбақ болғандар сендер болдыңдар.
Dialogue: 0,0:16:57.26,0:16:57.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:58.06,0:16:58.93,Default,,0,0,0,,Тосқауыл?
Dialogue: 0,0:16:59.77,0:17:01.43,Default,,0,0,0,,Мазасыздықтан құтылыңыз!
Dialogue: 0,0:17:03.02,0:17:04.10,Default,,0,0,0,,Маған доптарды шақырыңыз!
Dialogue: 0,0:17:04.77,0:17:08.44,Default,,0,0,0,,Қобалжыған түн, Лемурлар, мені же!
Dialogue: 0,0:17:08.52,0:17:09.73,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:17:09.82,0:17:11.36,Default,,0,0,0,,Міне! Кекекеке!
Dialogue: 0,0:17:11.44,0:17:12.82,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:17:15.66,0:17:16.45,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:17.83,0:17:19.24,Default,,0,0,0,,Біз шабуылға шығуымыз керек...
Dialogue: 0,0:17:19.33,0:17:21.75,Default,,0,0,0,,Бұл жігіттерді жеңетін қару!
Dialogue: 0,0:17:21.83,0:17:22.50,Default,,0,0,0,,Біз оны да білмейміз.
Dialogue: 0,0:17:24.83,0:17:26.13,Default,,0,0,0,,Қоңырау...
Dialogue: 0,0:17:26.79,0:17:30.34,Default,,0,0,0,,Мен саған күшімді беремін, қыз.
Dialogue: 0,0:17:30.42,0:17:31.46,Default,,0,0,0,,Элиос?
Dialogue: 0,0:17:31.55,0:17:34.76,Default,,0,0,0,,Менің атымды атаңыз
Dialogue: 0,0:17:34.84,0:17:38.22,Default,,0,0,0,,және Twinkle Ale деп айқайлаңыз!
Dialogue: 0,0:17:38.30,0:17:39.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:40.14,0:17:41.81,Default,,0,0,0,,Кя~!
Dialogue: 0,0:17:41.89,0:17:43.27,Default,,0,0,0,,Қыз!
Dialogue: 0,0:17:44.89,0:17:46.48,Default,,0,0,0,,Элиос, өтінемін!
Dialogue: 0,0:17:46.56,0:17:48.77,Default,,0,0,0,,Бізге қару беріңіз!
Dialogue: 0,0:17:48.86,0:17:50.77,Default,,0,0,0,,Twinkle Ale!
Dialogue: 0,0:17:55.40,0:17:56.53,Default,,0,0,0,,Не!
Dialogue: 0,0:17:56.61,0:17:57.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:57.74,0:17:59.45,Default,,0,0,0,,Супер Сейлор Мун!
Dialogue: 0,0:18:00.58,0:18:01.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:02.83,0:18:04.00,Default,,0,0,0,,Калейдоскоп?
Dialogue: 0,0:18:05.25,0:18:07.92,Default,,0,0,0,,Бұл кристалды калейдоскоп
Dialogue: 0,0:18:08.00,0:18:11.00,Default,,0,0,0,,Мен сенімен берік байланысқа үміттендім.
Dialogue: 0,0:18:12.17,0:18:14.17,Default,,0,0,0,,Ай калейдоскопы және
Dialogue: 0,0:18:14.26,0:18:15.97,Default,,0,0,0,,Chibi Moon Kaleido ауқымы
Dialogue: 0,0:18:17.55,0:18:19.93,Default,,0,0,0,,Қарғыс атқыр... Жасай бер, Лемлес!
Dialogue: 0,0:18:20.01,0:18:22.43,Default,,0,0,0,,Кекекеке!
Dialogue: 0,0:18:37.20,0:18:42.49,Default,,0,0,0,,Айдың керемет медитациясы!
Dialogue: 0,0:18:50.13,0:18:50.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:50.83,0:18:51.75,Default,,0,0,0,,Ол адам қуанады…
Dialogue: 0,0:18:53.42,0:18:55.05,Default,,0,0,0,,Супер Сейлор Мун!
Dialogue: 0,0:18:55.13,0:18:56.59,Default,,0,0,0,,Супер Сейлор Чиби Мун!
Dialogue: 0,0:18:56.67,0:18:58.43,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,0:19:00.05,0:19:01.97,Default,,0,0,0,,Сол жарқыраған күш...
Dialogue: 0,0:19:03.14,0:19:04.06,Default,,0,0,0,,Өте рахмет! (Ол Майт) Ахахаха!
Dialogue: 0,0:19:06.93,0:19:08.14,Default,,0,0,0,,Элиос!
Dialogue: 0,0:19:09.48,0:19:10.31,Default,,0,0,0,,Элиос…
Dialogue: 0,0:19:11.73,0:19:14.73,Default,,0,0,0,,Күткендей, мен бұл дыбыста сағыныш сезінемін.
Dialogue: 0,0:19:14.82,0:19:16.24,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:19:16.74,0:19:17.90,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:19:18.99,0:19:19.86,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,0:19:22.83,0:19:24.79,Default,,0,0,0,,Бұл не? Сол жігіттер
Dialogue: 0,0:19:24.87,0:19:26.20,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:19:26.29,0:19:29.87,Default,,0,0,0,,Біріншіден, бірдеңені түсінбесеңіз, айнадан сұраңыз.
Dialogue: 0,0:19:29.96,0:19:33.09,Default,,0,0,0,,Сол балалардың әдемі армандары ше?
Dialogue: 0,0:19:33.17,0:19:34.63,Default,,0,0,0,,Сен мықты болуың керек!
Dialogue: 0,0:19:34.71,0:19:36.30,Default,,0,0,0,,Мен жетілген болуым керек!
Dialogue: 0,0:19:36.38,0:19:39.26,Default,,0,0,0,,Маған әлі ересек болу керек емес.
Dialogue: 0,0:19:40.63,0:19:42.47,Default,,0,0,0,,Мен бұл тілекті түсінемін!
Dialogue: 0,0:19:42.55,0:19:45.06,Default,,0,0,0,,Қай заманда болмасын шын айқай
Dialogue: 0,0:19:45.14,0:19:47.81,Default,,0,0,0,,Сөздердің астарында не жатыр
Dialogue: 0,0:19:47.89,0:19:49.23,Default,,0,0,0,,Гякудама!
Dialogue: 0,0:19:49.31,0:19:50.73,Default,,0,0,0,,Ауруханаға асығыңыз!
Dialogue: 0,0:19:50.81,0:19:51.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:53.48,0:19:54.52,Default,,0,0,0,,Кя!
Dialogue: 0,0:19:55.07,0:19:55.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:57.03,0:19:58.94,Default,,0,0,0,,Чибиуса? Қоян?
Dialogue: 0,0:19:59.95,0:20:03.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:05.28,0:20:06.99,Default,,0,0,0,,О...
Dialogue: 0,0:20:07.83,0:20:12.04,Default,,0,0,0,,Бұл шын мәнінде фантомдық күміс кристалының күші.
Dialogue: 0,0:20:12.12,0:20:15.04,Default,,0,0,0,,Ақ Ай патшалығының адамдары
Dialogue: 0,0:20:15.13,0:20:17.80,Default,,0,0,0,,Бұл дүниеде реинкарнация болу қандай болды?
Dialogue: 0,0:20:18.42,0:20:19.42,Default,,0,0,0,,Циркония…
Dialogue: 0,0:20:19.51,0:20:21.26,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:20:21.34,0:20:22.76,Default,,0,0,0,,Лорд Нехеления
Dialogue: 0,0:20:22.84,0:20:26.51,Default,,0,0,0,,Ақ Ай патшалығының адамдары
Dialogue: 0,0:20:26.60,0:20:29.02,Default,,0,0,0,,Біздің жек көретін жауымыз
Dialogue: 0,0:20:29.10,0:20:30.02,Default,,0,0,0,,Қош бол
Dialogue: 0,0:20:30.10,0:20:32.98,Default,,0,0,0,,Оларды түнгі түстердің жеміне айналдыр
Dialogue: 0,0:20:33.06,0:20:36.40,Default,,0,0,0,,Ал менің қолымда елес күміс кристалды ...
Dialogue: 0,0:20:37.15,0:20:39.11,Default,,0,0,0,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:20:39.19,0:20:40.99,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:20:42.57,0:20:44.16,Default,,0,0,0,,Мен дем ала алмаймын
Dialogue: 0,0:20:44.24,0:20:46.66,Default,,0,0,0,,Менің кеудемде бірдеңе...
Dialogue: 0,0:20:46.74,0:20:47.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:48.04,0:20:49.16,Default,,0,0,0,,Мамо-чан
Dialogue: 0,0:20:50.50,0:20:52.67,Default,,0,0,0,,АҚШ... Чибиуса...
Dialogue: 0,0:20:52.75,0:20:54.17,Default,,0,0,0,,Мамо-чан
Dialogue: 0,0:20:54.25,0:20:55.50,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:56.59,0:20:57.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:57.59,0:20:59.71,Default,,0,0,0,,Қоян! Чибиуса!
Dialogue: 0,0:20:59.80,0:21:01.01,Default,,0,0,0,,Мамору-сан ше?
Dialogue: 0,0:21:01.09,0:21:02.05,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:21:02.13,0:21:03.43,Default,,0,0,0,,Мен енді ғана ояндым
Dialogue: 0,0:21:03.51,0:21:04.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:06.89,0:21:08.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:08.64,0:21:11.52,Default,,0,0,0,,Кенет Усаги-чан кішірейіп кетті.
Dialogue: 0,0:21:11.60,0:21:13.35,Default,,0,0,0,,Чибиуса үлкейіп кетті ме?
Dialogue: 0,0:21:13.44,0:21:14.06,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:14.14,0:21:15.19,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:15.27,0:21:17.31,Default,,0,0,0,,Сондықтан мен оны мүлдем түсінбеймін!
Dialogue: 0,0:21:17.40,0:21:20.78,Default,,0,0,0,,Цирктен қашқан жолбарысты қудым.
Dialogue: 0,0:21:20.86,0:21:22.07,Default,,0,0,0,,Жау пайда болады...
Dialogue: 0,0:21:22.15,0:21:23.74,Default,,0,0,0,,Цирк тобы?
Dialogue: 0,0:21:23.82,0:21:24.78,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:24.86,0:21:26.82,Default,,0,0,0,,Өлі Ай циркі…
Dialogue: 0,0:21:26.91,0:21:28.20,Default,,0,0,0,,Бұл күдікті.
Dialogue: 0,0:21:30.20,0:21:33.54,Default,,0,0,0,,Мамору Чиба мырза, тексеру дайын.
Dialogue: 0,0:21:33.62,0:21:34.50,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:21:34.58,0:21:36.50,Default,,0,0,0,,Амидың анасы?
Dialogue: 0,0:21:36.58,0:21:37.79,Default,,0,0,0,,Өте әдемі!
Dialogue: 0,0:21:37.88,0:21:38.96,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:21:40.46,0:21:41.55,Default,,0,0,0,,Өкпедегі көлеңке?
Dialogue: 0,0:21:41.63,0:21:42.59,Default,,0,0,0,,Иә
Dialogue: 0,0:21:42.67,0:21:45.30,Default,,0,0,0,,Бір рет мұқият тексерген дұрыс.
Dialogue: 0,0:21:46.14,0:21:47.18,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:21:48.72,0:21:49.89,Default,,0,0,0,,Мамо-чан
Dialogue: 0,0:21:49.97,0:21:52.31,Default,,0,0,0,,Қалаған нәрсе бар ма?
Dialogue: 0,0:21:52.39,0:21:53.39,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:21:53.48,0:21:57.31,Default,,0,0,0,,Уса, сен де, осындай қиын кезеңнен өткенім үшін кешір.
Dialogue: 0,0:21:58.06,0:21:59.82,Default,,0,0,0,,Өлі Ай циркі
Dialogue: 0,0:21:59.90,0:22:03.07,Default,,0,0,0,,Олар міндетті түрде осы қаланы нысанаға алады.
Dialogue: 0,0:22:03.74,0:22:05.86,Default,,0,0,0,,Бізге тезірек бірдеңе істеу керек.
Dialogue: 0,0:22:05.95,0:22:07.20,Default,,0,0,0,,Иә.
Dialogue: 0,0:22:09.45,0:22:10.41,Default,,0,0,0,,Аха…
Dialogue: 0,0:22:11.12,0:22:13.54,Default,,0,0,0,,Бірдеңе дұрыс емес...
Dialogue: 0,0:22:13.62,0:22:14.75,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:15.62,0:22:16.75,Default,,0,0,0,,Мамо-чан?
Dialogue: 0,0:22:16.83,0:22:18.50,Default,,0,0,0,,Ой... жарайды.
Dialogue: 0,0:22:18.58,0:22:20.50,Default,,0,0,0,,Мен сәл демаламын.
Dialogue: 0,0:22:22.96,0:22:23.63,Default,,0,0,0,,Қоян
Dialogue: 0,0:22:24.30,0:22:27.43,Default,,0,0,0,,Мен саған көп жүк артып жатырмын.
Dialogue: 0,0:22:27.51,0:22:28.26,Default,,0,0,0,,А...
Dialogue: 0,0:22:29.55,0:22:32.68,Default,,0,0,0,,Менде сенің күшіңнің үзіндісі де жоқ.
Dialogue: 0,0:22:33.52,0:22:36.73,Default,,0,0,0,,Керісінше, ол бізді тек ұстап тұр.
Dialogue: 0,0:22:37.52,0:22:39.61,Default,,0,0,0,,Мен осында мәңгі боламын
Dialogue: 0,0:22:39.69,0:22:43.57,Default,,0,0,0,,Саған тек кедергі бола ма деп қорқамын.
Dialogue: 0,0:22:43.65,0:22:45.90,Default,,0,0,0,,Кейде ойлаймын
Dialogue: 0,0:22:47.66,0:22:48.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:48.61,0:22:50.37,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:22:50.45,0:22:51.45,Default,,0,0,0,,Мамо-чан
Dialogue: 0,0:22:52.03,0:22:55.95,Default,,0,0,0,,Мен сенің қасыңда болсам, Мамо-чан араласады.
Dialogue: 0,0:22:56.96,0:22:59.17,Default,,0,0,0,,Бұл мені жаман сезінеді
Dialogue: 0,0:23:00.29,0:23:03.30,Default,,0,0,0,,Мен болмасам жақсы емес пе?
Dialogue: 0,0:23:04.46,0:23:07.13,Default,,0,0,0,,Менің арманым – Мамо-чан
Dialogue: 0,0:23:08.13,0:23:11.22,Default,,0,0,0,,Мен сенің жаныңда осылай мәңгі қалсам деп едім
Dialogue: 0,0:23:12.47,0:23:14.64,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:23:16.93,0:23:18.06,Default,,0,0,0,,Мен білемін...
Dialogue: 0,0:23:19.31,0:23:20.90,Default,,0,0,0,,Қаншалықты ұнаса да
Dialogue: 0,0:23:20.98,0:23:23.90,Default,,0,0,0,,Мамо-чан менің болашақ әкем
Dialogue: 0,0:23:27.03,0:23:29.45,Default,,0,0,0,,Мамо-чанның қояны бар.
Dialogue: 0,0:23:33.03,0:23:34.49,Default,,0,0,0,,Кішкентай ханым…
Dialogue: 0,0:23:34.58,0:23:37.25,Default,,0,0,0,,Мен қазір кішкентай емеспін.
Dialogue: 0,0:23:39.16,0:23:40.12,Default,,0,0,0,,Ханым
Dialogue: 0,0:23:40.62,0:23:41.54,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:23:43.38,0:23:45.80,Default,,0,0,0,,Элиос іздеп жүрген қыз...
Dialogue: 0,0:23:46.55,0:23:48.17,Default,,0,0,0,,Бұл шынымен...
Dialogue: 0,0:23:48.26,0:23:49.88,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:23:49.97,0:23:51.34,Default,,0,0,0,,Қыз...
Dialogue: 0,0:23:52.01,0:23:52.80,Default,,0,0,0,,Элиос!
Dialogue: 0,0:23:53.51,0:23:55.06,Default,,0,0,0,,Бұл неге ұқсайды?
Dialogue: 0,0:23:55.97,0:23:57.35,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:23:57.43,0:24:00.94,Default,,0,0,0,,Өйткені, сен мен іздеген қызсың.
Dialogue: 0,0:24:01.02,0:24:02.02,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:24:02.10,0:24:03.86,Default,,0,0,0,,Бұл жаудың ісі шығар...
Dialogue: 0,0:24:03.94,0:24:05.48,Default,,0,0,0,,Жау?
Dialogue: 0,0:24:05.57,0:24:08.32,Default,,0,0,0,,Бұл олардың ісі шығар.
Dialogue: 0,0:24:08.40,0:24:11.70,Default,,0,0,0,,Элиос, сен жау туралы білесің бе?
Dialogue: 0,0:24:11.78,0:24:13.28,Default,,0,0,0,,Сіз...
Dialogue: 0,0:24:14.03,0:24:15.33,Default,,0,0,0,,Мен...
Dialogue: 0,0:24:16.70,0:24:18.83,Default,,0,0,0,,Жоқ, қазір айта алмаймын.
Dialogue: 0,0:24:18.91,0:24:21.04,Default,,0,0,0,,Бірақ маған сеніңіз.
Dialogue: 0,0:24:21.12,0:24:23.33,Default,,0,0,0,,Бізге сіздің көмегіңіз қажет.
Dialogue: 0,0:24:24.50,0:24:28.05,Default,,0,0,0,,Ай сәулесінен қорғалған әдемі армандар⸺
Dialogue: 0,0:24:28.13,0:24:29.84,Default,,0,0,0,,Ханшайым мен жауынгер...
Dialogue: 0,0:24:31.05,0:24:32.59,Default,,0,0,0,,Таңдалған қыз
Dialogue: 0,0:24:33.89,0:24:34.85,Default,,0,0,0,,Элиос!
Dialogue: 0,0:24:38.47,0:24:41.73,Default,,0,0,0,,Бұл қыз Элиос іздеп жүр ме?
Dialogue: 0,0:24:42.73,0:24:44.98,Default,,0,0,0,,Бұл шынымен мен бе?
Dialogue: 0,0:24:52.99,0:24:54.03,Default,,0,0,0,,Ханзада…
Dialogue: 0,0:24:55.03,0:24:56.53,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:24:57.28,0:24:59.75,Default,,0,0,0,,Элизиумды қорғау мүмкін емес
Dialogue: 0,0:24:59.83,0:25:01.62,Default,,0,0,0,,Тіпті сіздің денеңіз де...
Dialogue: 0,0:25:02.46,0:25:03.67,Default,,0,0,0,,Ханзада…
Dialogue: 0,0:25:05.83,0:25:06.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:10.38,0:25:11.34,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:25:17.55,0:25:19.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:25:19.39,0:25:22.94,Default,,0,0,0,,Джубан сауда ауданын қоршап тұрған бұл қалыпты емес аура...
Dialogue: 0,0:25:23.02,0:25:24.65,Default,,0,0,0,,Бұл шынымен де кедергі ме?
Dialogue: 0,0:25:24.73,0:25:25.94,Default,,0,0,0,,Ами…
Dialogue: 0,0:25:27.19,0:25:28.73,Default,,0,0,0,,Әрқашан жауға дайын бол
Dialogue: 0,0:25:28.82,0:25:31.40,Default,,0,0,0,,Сабырлы пайымдаулар жасай білу
Dialogue: 0,0:25:31.49,0:25:34.15,Default,,0,0,0,,Өйткені сен әркімнің миысың
Dialogue: 0,0:25:36.66,0:25:37.91,Default,,0,0,0,,Сецуна-сан…
Dialogue: 0,0:25:37.99,0:25:39.87,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:25:40.10,0:25:42.29,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:25:42.37,0:25:44.75,Default,,0,0,0,,Сіз әлі ояусыз ба? Сағат 1 болды
Dialogue: 0,0:25:44.83,0:25:46.08,Default,,0,0,0,,Кешкі ас ше?
Dialogue: 0,0:25:46.17,0:25:48.00,Default,,0,0,0,,Мен оны кездейсоқ жасап, жедім.
Dialogue: 0,0:25:49.25,0:25:51.63,Default,,0,0,0,,Сіз шынымен мықтысыз.
Dialogue: 0,0:25:51.71,0:25:55.22,Default,,0,0,0,,Бір жақсысы, мен саған үйде жалғыз қалуға рұқсат беремін.
Dialogue: 0,0:25:55.30,0:25:57.18,Default,,0,0,0,,Сіз ана болу құқығынан айырылдыңыз.
Dialogue: 0,0:25:57.26,0:25:58.26,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:25:59.72,0:26:01.81,Default,,0,0,0,,Менің әкем жапондық суретші
Dialogue: 0,0:26:01.89,0:26:04.48,Default,,0,0,0,,Анаммен бәрі жақсы болмады.
Dialogue: 0,0:26:06.19,0:26:10.27,Default,,0,0,0,,Менің туған күніме әкем әлі күнге дейін ашық хаттар жібереді.
Dialogue: 0,0:26:10.36,0:26:13.07,Default,,0,0,0,,Хехе... Әкем де мен туралы.
Dialogue: 0,0:26:13.15,0:26:16.86,Default,,0,0,0,,Мен тым қаталмын, бала сияқты емеспін деп айттыңыз ба?
Dialogue: 0,0:26:17.61,0:26:19.62,Default,,0,0,0,,Тора но Ме-чан♪
Dialogue: 0,0:26:20.58,0:26:22.37,Default,,0,0,0,,Така но Ме-чан♪
Dialogue: 0,0:26:22.45,0:26:25.33,Default,,0,0,0,,Жа сүйкімді У-но-мэ-чан♪
Dialogue: 0,0:26:25.96,0:26:29.29,Default,,0,0,0,,Балалар, адам болғыларың келе ме?
Dialogue: 0,0:26:29.38,0:26:31.25,Default,,0,0,0,,(айқай)
Dialogue: 0,0:26:31.34,0:26:33.71,Default,,0,0,0,,Хехе, сен сондай ақылдысың.
Dialogue: 0,0:26:33.80,0:26:34.63,Default,,0,0,0,,Парапара!
Dialogue: 0,0:26:35.59,0:26:36.22,Default,,0,0,0,,Хехе
Dialogue: 0,0:26:36.30,0:26:37.51,Default,,0,0,0,,Таманокоши!
Dialogue: 0,0:26:42.35,0:26:43.97,Default,,0,0,0,,Uso~!
Dialogue: 0,0:26:44.64,0:26:47.69,Default,,0,0,0,,Адам! Адам бейнесі!
Dialogue: 0,0:26:47.77,0:26:50.06,Default,,0,0,0,,Менің уақытым келді~
Dialogue: 0,0:26:50.15,0:26:52.48,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,0:26:52.57,0:26:56.28,Default,,0,0,0,,Біздің Өлі Ай циркінің ең маңызды сәті!
Dialogue: 0,0:26:56.36,0:26:59.45,Default,,0,0,0,,Жақсылық жасасаң, мені марапаттай аласың.
Dialogue: 0,0:26:59.53,0:27:02.28,Default,,0,0,0,,Бұл жолбарыстың көз арманы суретші
Dialogue: 0,0:27:02.37,0:27:03.33,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:27:04.12,0:27:07.41,Default,,0,0,0,,Ханымдар мен мырзалар, мұны Hawks Eye-ге қалдырыңыз.
Dialogue: 0,0:27:07.50,0:27:09.83,Default,,0,0,0,,Менің жасым жетпейді!
Dialogue: 0,0:27:09.92,0:27:12.13,Default,,0,0,0,,Fish Eye де қолынан келгеннің бәрін жасайды!
Dialogue: 0,0:27:12.21,0:27:13.38,Default,,0,0,0,,Эй!
Dialogue: 0,0:27:13.46,0:27:16.84,Default,,0,0,0,,Енді маған кім несие береді?
Dialogue: 0,0:27:16.92,0:27:18.55,Default,,0,0,0,,Уау
Dialogue: 0,0:27:18.63,0:27:21.76,Default,,0,0,0,,Алдымен мына балықтың көзіне қалдырыңыз!
Dialogue: 0,0:27:21.85,0:27:24.68,Default,,0,0,0,,Кел, айна, мені бейнеле.
Dialogue: 0,0:27:24.77,0:27:26.64,Default,,0,0,0,,Арманы көп, нұры барлар
Dialogue: 0,0:27:28.98,0:27:31.11,Default,,0,0,0,,Уух, таптым.
Dialogue: 0,0:27:31.19,0:27:34.36,Default,,0,0,0,,Судың ағынын басқаратын мен сияқты.
Dialogue: 0,0:27:38.82,0:27:41.24,Default,,0,0,0,,Осындай жерде тропикалық балық дүкені бар ма?
Dialogue: 0,0:27:42.03,0:27:44.45,Default,,0,0,0,,Ах... әдемі
Dialogue: 0,0:27:45.45,0:27:47.50,Default,,0,0,0,,Бұл суда жүргендей
Dialogue: 0,0:27:48.46,0:27:51.21,Default,,0,0,0,,Адамдар суды неліктен сағынады?
Dialogue: 0,0:27:51.29,0:27:54.17,Default,,0,0,0,,Бұл күйзелістің немесе көңілсіздіктің белгісі болса керек.
Dialogue: 0,0:27:54.25,0:27:55.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:55.25,0:27:57.55,Default,,0,0,0,,Біраз балық ұстасақ ше?
Dialogue: 0,0:27:57.63,0:27:59.51,Default,,0,0,0,,Мен бұл қызды өте ұсынамын.
Dialogue: 0,0:28:00.22,0:28:01.68,Default,,0,0,0,,Хех сүйкімді
Dialogue: 0,0:28:03.10,0:28:05.64,Default,,0,0,0,,Иә, анам да бақытты болуы мүмкін.
Dialogue: 0,0:28:05.72,0:28:06.60,Default,,0,0,0,,Хехе
Dialogue: 0,0:28:10.27,0:28:11.40,Default,,0,0,0,,Хехе
Dialogue: 0,0:28:11.48,0:28:14.15,Default,,0,0,0,,Әкем маған сыйлаған ашықхаттағы балыққа ұқсайды
Dialogue: 0,0:28:14.23,0:28:16.11,Default,,0,0,0,,Мама, таң қалдыңыз ба?
Dialogue: 0,0:28:21.82,0:28:22.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:24.37,0:28:25.24,Default,,0,0,0,,Ана?
Dialogue: 0,0:28:27.49,0:28:28.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:28:28.25,0:28:30.66,Default,,0,0,0,,Қызым, сен әлі ояу емессің бе?
Dialogue: 0,0:28:31.33,0:28:33.42,Default,,0,0,0,,Жалғыз қызығы оқу ғана болатын бала.
Dialogue: 0,0:28:33.50,0:28:36.17,Default,,0,0,0,,Оның маған қатысы жоқ, хехехе...
Dialogue: 0,0:28:41.30,0:28:42.05,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:28:43.51,0:28:45.01,Default,,0,0,0,,Ха... мен?
Dialogue: 0,0:28:45.68,0:28:47.72,Default,,0,0,0,,Әке, мен күнәмді айтуға келдім.
Dialogue: 0,0:28:47.81,0:28:49.60,Default,,0,0,0,,Анам жұмысқа кетті
Dialogue: 0,0:28:50.27,0:28:53.06,Default,,0,0,0,,Сіз тек оқуға қызығасыз, солай емес пе?
Dialogue: 0,0:28:53.15,0:28:54.48,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:28:55.61,0:28:56.57,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:28:56.65,0:28:58.86,Default,,0,0,0,,Неге түсінбейсің?
Dialogue: 0,0:28:58.94,0:29:01.07,Default,,0,0,0,,Мен анам мен әкем туралы ойлаймын...
Dialogue: 0,0:29:01.82,0:29:03.24,Default,,0,0,0,,Усаги-чан?
Dialogue: 0,0:29:03.32,0:29:05.53,Default,,0,0,0,,Үшеуміз әрқашан біргеміз.
Dialogue: 0,0:29:05.62,0:29:07.62,Default,,0,0,0,,Маған басқа ештеңе керек емес.
Dialogue: 0,0:29:07.70,0:29:08.33,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:29:08.41,0:29:11.29,Default,,0,0,0,,Хехе, үшеуің бақытты сияқтысыңдар.
Dialogue: 0,0:29:13.21,0:29:16.92,Default,,0,0,0,,Қараңдар, мен ұстанудың қажеті жоқ.
Dialogue: 0,0:29:17.00,0:29:19.71,Default,,0,0,0,,Қызғаныш болды ма? Сол үш адам
Dialogue: 0,0:29:19.80,0:29:23.51,Default,,0,0,0,,Маған шын мәнінде не ойлайтыныңызды айтыңыз, хехехе...
Dialogue: 0,0:29:23.59,0:29:25.68,Default,,0,0,0,,Иә, мен...
Dialogue: 0,0:29:26.35,0:29:28.06,Default,,0,0,0,,Менің арманым
Dialogue: 0,0:29:28.14,0:29:30.47,Default,,0,0,0,,Кім екенің маңызды емес, біреудің сүйгенін қалайсың...
Dialogue: 0,0:29:30.56,0:29:31.98,Default,,0,0,0,,Ха... жоқ!
Dialogue: 0,0:29:32.81,0:29:35.48,Default,,0,0,0,,Мықты бол, Ами! Бұл галлюцинация!
Dialogue: 0,0:29:35.56,0:29:37.44,Default,,0,0,0,,Усаги-чан, сен мені естисің бе?
Dialogue: 0,0:29:37.52,0:29:39.90,Default,,0,0,0,,Ами-чан Ами-чан?
Dialogue: 0,0:29:39.98,0:29:40.90,Default,,0,0,0,,Уф!
Dialogue: 0,0:29:40.99,0:29:41.90,Default,,0,0,0,,Ами-чан!
Dialogue: 0,0:29:41.99,0:29:44.15,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:29:45.66,0:29:46.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:46.62,0:29:47.87,Default,,0,0,0,,Хехе
Dialogue: 0,0:29:49.37,0:29:50.58,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:29:50.66,0:29:52.58,Default,,0,0,0,,О... аа!
Dialogue: 0,0:29:52.66,0:29:54.25,Default,,0,0,0,,Гү…
Dialogue: 0,0:29:56.75,0:29:59.17,Default,,0,0,0,,Бұл... қорқынышты түс.
Dialogue: 0,0:29:59.25,0:30:03.76,Default,,0,0,0,,Иә, бұл зұлым жын Лемураның тәтті түні.
Dialogue: 0,0:30:04.47,0:30:07.89,Default,,0,0,0,,Жылы түсте қайырлы түн
Dialogue: 0,0:30:09.51,0:30:10.56,Default,,0,0,0,,Жақсы сезінеді...
Dialogue: 0,0:30:11.93,0:30:14.81,Default,,0,0,0,,Маған осылай мәңгі ұйықтауға рұқсат етіңіз
Dialogue: 0,0:30:16.15,0:30:17.35,Default,,0,0,0,,Ханшайым…
Dialogue: 0,0:30:19.52,0:30:21.36,Default,,0,0,0,,Меркурий ханшайымы
Dialogue: 0,0:30:21.44,0:30:24.11,Default,,0,0,0,,Кім? мені кім шақырады
Dialogue: 0,0:30:26.20,0:30:28.07,Default,,0,0,0,,Ха... мен?
Dialogue: 0,0:30:28.16,0:30:31.16,Default,,0,0,0,,Иә, мен сенің қосарыңмын.
Dialogue: 0,0:30:31.24,0:30:34.08,Default,,0,0,0,,Оян, Меркурий ханшайым
Dialogue: 0,0:30:34.16,0:30:36.83,Default,,0,0,0,,Шынайы армандарыңызды есте сақтаңыз!
Dialogue: 0,0:30:36.92,0:30:39.96,Default,,0,0,0,,Менің... шын арманым?
Dialogue: 0,0:30:41.80,0:30:42.63,Default,,0,0,0,,Хехе
Dialogue: 0,0:30:43.80,0:30:45.42,Default,,0,0,0,,Иә
Dialogue: 0,0:30:45.51,0:30:46.51,Default,,0,0,0,,Маған
Dialogue: 0,0:30:46.59,0:30:48.89,Default,,0,0,0,,Мен жақсы көретін, жақсы көретін адамдар көп.
Dialogue: 0,0:30:49.76,0:30:52.81,Default,,0,0,0,,Сол адамдарды одан сайын жақсы көргім келеді
Dialogue: 0,0:30:52.89,0:30:53.77,Default,,0,0,0,,Мен сені қорғағым келеді
Dialogue: 0,0:30:54.52,0:30:56.44,Default,,0,0,0,,Сондықтан мен оқимын
Dialogue: 0,0:30:56.52,0:30:58.77,Default,,0,0,0,,Ал менің арманым...
Dialogue: 0,0:30:58.85,0:31:00.27,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:31:00.36,0:31:03.65,Default,,0,0,0,,Толық жауынгер болып, барлығын қорға
Dialogue: 0,0:31:04.28,0:31:05.49,Default,,0,0,0,,Не!
Dialogue: 0,0:31:05.57,0:31:06.99,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:31:07.07,0:31:08.99,Default,,0,0,0,,Бұл менің миссиям!
Dialogue: 0,0:31:10.57,0:31:14.24,Default,,0,0,0,,Меркурийлік кристалды күшті макияж!
Dialogue: 0,0:31:37.35,0:31:39.23,Default,,0,0,0,,Су жұлдызы!
Dialogue: 0,0:31:39.31,0:31:41.61,Default,,0,0,0,,Меркурийдің қамқоршысы болған білім жауынгері!
Dialogue: 0,0:31:42.69,0:31:44.27,Default,,0,0,0,,Теңізші Меркурий
Dialogue: 0,0:31:46.36,0:31:49.78,Default,,0,0,0,,Өзіңізді сумен жабыңыз және ойланыңыз!
Dialogue: 0,0:31:49.86,0:31:51.03,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:31:51.12,0:31:52.74,Default,,0,0,0,,Меркурий
Dialogue: 0,0:31:54.54,0:31:56.25,Default,,0,0,0,,Аква рапсодия
Dialogue: 0,0:31:59.92,0:32:01.29,Default,,0,0,0,,Кекекеке!
Dialogue: 0,0:32:01.38,0:32:02.29,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:32:02.79,0:32:05.17,Default,,0,0,0,,Лемрес қорқынышынан ояну!
Dialogue: 0,0:32:05.25,0:32:06.67,Default,,0,0,0,,Меркурий!
Dialogue: 0,0:32:06.76,0:32:08.38,Default,,0,0,0,,Қоян! Чибиуса-чан!
Dialogue: 0,0:32:08.47,0:32:10.84,Default,,0,0,0,,Мұның бәрі трансформация туралы!
Dialogue: 0,0:32:10.93,0:32:11.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:11.97,0:32:16.81,Default,,0,0,0,,Ай дағдарысына арналған макияж!
Dialogue: 0,0:32:19.10,0:32:20.56,Default,,0,0,0,,Супер Сейлор Мун!
Dialogue: 0,0:32:20.64,0:32:22.02,Default,,0,0,0,,Супер Сейлор Чиби Мун!
Dialogue: 0,0:32:22.10,0:32:23.77,Default,,0,0,0,,♬~
Dialogue: 0,0:32:26.57,0:32:28.49,Default,,0,0,0,,Кеттік, Чиби Мун!
Dialogue: 0,0:32:30.11,0:32:35.99,Default,,0,0,0,,Айдың керемет медитациясы!
Dialogue: 0,0:32:38.87,0:32:41.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:42.33,0:32:43.71,Default,,0,0,0,,Балық көзі!
Dialogue: 0,0:32:43.79,0:32:46.92,Default,,0,0,0,,Менің Гякудама техникамды бұзуға қалай дәтің бар...
Dialogue: 0,0:32:47.00,0:32:49.05,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:32:50.47,0:32:51.88,Default,,0,0,0,,Меркурий!
Dialogue: 0,0:32:51.97,0:32:54.85,Default,,0,0,0,,Екеуіңіз де бастапқы пішіндеріңізге оралдыңыздар!
Dialogue: 0,0:32:55.47,0:32:58.14,Default,,0,0,0,,Барлығына әрқашан қажет⸺
Dialogue: 0,0:32:58.22,0:32:59.89,Default,,0,0,0,,Күшті және әдемі қоян
Dialogue: 0,0:32:59.98,0:33:01.77,Default,,0,0,0,,Уау, сен істедің!
Dialogue: 0,0:33:01.85,0:33:03.69,Default,,0,0,0,,Мен білдім...
Dialogue: 0,0:33:03.77,0:33:06.90,Default,,0,0,0,,Бізде бірдей фантомдық күміс кристалы болса да
Dialogue: 0,0:33:06.98,0:33:08.82,Default,,0,0,0,,Сізде бірдей элемент болса да
Dialogue: 0,0:33:09.94,0:33:11.90,Default,,0,0,0,,Менен мүлдем басқасың.
Dialogue: 0,0:33:12.40,0:33:14.32,Default,,0,0,0,,Twinkle Ale!
Dialogue: 0,0:33:15.74,0:33:16.70,Default,,0,0,0,,Қыз...
Dialogue: 0,0:33:16.78,0:33:19.58,Default,,0,0,0,,Элиос Бұл сөзсіз басқаша.
Dialogue: 0,0:33:19.66,0:33:23.33,Default,,0,0,0,,Элиос іздеп жүрген қыз мен емес!
Dialogue: 0,0:33:23.42,0:33:26.00,Default,,0,0,0,,Елиос қыз іздеп жүр?
Dialogue: 0,0:33:26.09,0:33:28.63,Default,,0,0,0,,Мен іздеп жүрген қыз қандай?
Dialogue: 0,0:33:28.71,0:33:30.51,Default,,0,0,0,,Әдемі армандар көр
Dialogue: 0,0:33:30.59,0:33:33.84,Default,,0,0,0,,Ай жарығымен қорғалған ханшайым мен жауынгер
Dialogue: 0,0:33:33.93,0:33:37.39,Default,,0,0,0,,Алтын кристалдың мөрін бұзатын қасиетті тас бар.
Dialogue: 0,0:33:37.47,0:33:39.52,Default,,0,0,0,,Таңдалған қыз туралы
Dialogue: 0,0:33:41.52,0:33:44.56,Default,,0,0,0,,Жоқ, ол қыз Сейлор Мун...
Dialogue: 0,0:33:44.65,0:33:47.40,Default,,0,0,0,,Жоқ. Сіз Тыныштық ханшайымын айтып тұрсыз ба?
Dialogue: 0,0:33:47.48,0:33:49.48,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,0:33:49.57,0:33:51.40,Default,,0,0,0,,Сіз Серенити ханшайымсыз ба?
Dialogue: 0,0:33:52.07,0:33:52.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:33:52.99,0:33:54.53,Default,,0,0,0,,Чиби Мун!
Dialogue: 0,0:33:56.87,0:33:58.87,Default,,0,0,0,,«Уа, қыз»
Dialogue: 0,0:33:58.95,0:34:03.08,Default,,0,0,0,,Мені осылай атағанына қытықтап, қуандым.
Dialogue: 0,0:34:03.16,0:34:06.13,Default,,0,0,0,,Бірақ сізге керек мен емес
Dialogue: 0,0:34:07.46,0:34:10.88,Default,,0,0,0,,Жоқ, мен кішкентаймын және күшім жоқ.
Dialogue: 0,0:34:11.63,0:34:12.63,Default,,0,0,0,,Бұл ауырады
Dialogue: 0,0:34:12.72,0:34:13.55,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:34:13.63,0:34:15.80,Default,,0,0,0,,Ах... Элиос
Dialogue: 0,0:34:17.18,0:34:21.47,Default,,0,0,0,,Бәлкім бір күні мен де керек болармын
Dialogue: 0,0:34:22.31,0:34:25.23,Default,,0,0,0,,Өсіп, жақсы жауынгер бол
Dialogue: 0,0:34:25.31,0:34:26.94,Default,,0,0,0,,Керемет ханымға...
Dialogue: 0,0:34:28.23,0:34:32.11,Default,,0,0,0,,Мүмкін бір күні менің арманым орындалатын шығар
Dialogue: 0,0:34:38.57,0:34:39.95,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:34:42.91,0:34:43.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:52.25,0:34:55.17,Default,,0,0,0,,Жылама, кішкентай қыз
Dialogue: 0,0:34:55.84,0:34:58.39,Default,,0,0,0,,Сіз әрқашан сұранысқа иесіз
Dialogue: 0,0:34:58.93,0:35:02.93,Default,,0,0,0,,Махаббат айналаңда
Dialogue: 0,0:35:03.02,0:35:04.52,Default,,0,0,0,,Сондықтан жылама
Dialogue: 0,0:35:05.93,0:35:08.19,Default,,0,0,0,,Бұл формада бұл шек...
Dialogue: 0,0:35:09.02,0:35:10.48,Default,,0,0,0,,Кішкентай қыз
Dialogue: 0,0:35:10.56,0:35:12.36,Default,,0,0,0,,Мен міндетті түрде тағы да кездесуге келемін.
Dialogue: 0,0:35:12.44,0:35:14.03,Default,,0,0,0,,Сондықтан жылама
Dialogue: 0,0:35:14.11,0:35:16.65,Default,,0,0,0,,Чибиуса~! (Ами) Чибиуса-чан!
Dialogue: 0,0:35:16.74,0:35:19.62,Default,,0,0,0,,Чибиуса! Ха ха ха...
Dialogue: 0,0:35:20.78,0:35:21.87,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:35:22.87,0:35:24.54,Default,,0,0,0,,Мен суық тигіземін. Үйге барайық.
Dialogue: 0,0:35:25.95,0:35:26.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:26.66,0:35:27.92,Default,,0,0,0,,Чибиуса!
Dialogue: 0,0:35:28.00,0:35:28.75,Default,,0,0,0,,Ха!
Dialogue: 0,0:35:30.21,0:35:31.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:31.34,0:35:33.09,Default,,0,0,0,,Элиос…
Dialogue: 0,0:35:33.17,0:35:34.76,Default,,0,0,0,,Бұл Элиос па?
Dialogue: 0,0:35:44.43,0:35:46.10,Default,,0,0,0,,А... а...
Dialogue: 0,0:35:46.18,0:35:47.06,Default,,0,0,0,,Хо…
Dialogue: 0,0:35:47.85,0:35:50.65,Default,,0,0,0,,Мен сиқырымнан құтыламын деп ешқашан ойламадым.
Dialogue: 0,0:35:50.73,0:35:52.44,Default,,0,0,0,,Үлкен мәселе сияқты
Dialogue: 0,0:35:52.52,0:35:56.53,Default,,0,0,0,,Бірақ сіз және бұл жер менікісіз.
Dialogue: 0,0:35:57.70,0:36:01.74,Default,,0,0,0,,Ақырында жер бетіндегі бәрі менікі болады.
Dialogue: 0,0:36:02.62,0:36:05.54,Default,,0,0,0,,Мен сенің қалағаныңды істегеніңді кешірмеймін. Кукукуку...
Dialogue: 0,0:36:06.04,0:36:09.08,Default,,0,0,0,,Осы жер мен денені басып алса да
Dialogue: 0,0:36:09.16,0:36:11.96,Default,,0,0,0,,Тіпті менің жүрегім әлі басқарылмайды!
Dialogue: 0,0:36:12.63,0:36:14.75,Default,,0,0,0,,Сен зұлым ханзада.
Dialogue: 0,0:36:14.84,0:36:17.51,Default,,0,0,0,,Ал ханшайым оны міндетті түрде өшіреді.
Dialogue: 0,0:36:18.09,0:36:19.68,Default,,0,0,0,,Қарғыс атсын... арсыз!
Dialogue: 0,0:36:19.76,0:36:20.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:22.01,0:36:24.05,Default,,0,0,0,,Алтын кристалды тез алыңыз
Dialogue: 0,0:36:24.14,0:36:25.51,Default,,0,0,0,,Мен оны іздеуім керек.
Dialogue: 0,0:36:25.60,0:36:27.81,Default,,0,0,0,,Тіпті бұл планета...
Dialogue: 0,0:36:35.90,0:36:37.82,Default,,0,0,0,,Хино, не болды?
Dialogue: 0,0:36:37.90,0:36:39.49,Default,,0,0,0,,Жебе адасып бара жатқан сияқты.
Dialogue: 0,0:36:40.70,0:36:41.57,Default,,0,0,0,,Жоғалған...
Dialogue: 0,0:36:41.66,0:36:43.03,Default,,0,0,0,,Рэй-чан
Dialogue: 0,0:36:43.12,0:36:46.33,Default,,0,0,0,,Осылай істегенде, Ами-чанға ұқсайсың.
Dialogue: 0,0:36:46.41,0:36:47.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:47.20,0:36:48.87,Default,,0,0,0,,Ғибадатхананы басқару заңы?
Dialogue: 0,0:36:48.95,0:36:50.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:36:50.12,0:36:51.00,Default,,0,0,0,,Хаа…
Dialogue: 0,0:36:51.08,0:36:53.71,Default,,0,0,0,,Ата суық тиіп, құлап қалды.
Dialogue: 0,0:36:53.79,0:36:57.55,Default,,0,0,0,,Әлем рецессияда, сондықтан мен тиімді басқару әдісін іздеймін.
Dialogue: 0,0:36:57.63,0:36:59.17,Default,,0,0,0,,Мен біреуді жалдасам ше?
Dialogue: 0,0:36:59.26,0:37:01.13,Default,,0,0,0,,Жоқ! Еңбек құны жоғары!
Dialogue: 0,0:37:01.22,0:37:04.35,Default,,0,0,0,,Ондай жағдайда күйеу баланы тез асырап алсақ қайтеді?
Dialogue: 0,0:37:04.43,0:37:05.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:05.43,0:37:09.39,Default,,0,0,0,,Мен Рей-чанның еркектерді жек көретінін жақсы білемін.
Dialogue: 0,0:37:09.48,0:37:12.56,Default,,0,0,0,,Мәселе мынада, сіз үйленгенмін деп ойлаудың қажеті жоқ.
Dialogue: 0,0:37:12.65,0:37:13.48,Default,,0,0,0,,Ғибадатхана үшін
Dialogue: 0,0:37:13.56,0:37:16.02,Default,,0,0,0,,Сізге біреу тегін келді деп ойлаңыз.
Dialogue: 0,0:37:16.11,0:37:18.23,Default,,0,0,0,,Ғибадатханадағы барлық жұмыстарды орындаңыз.
Dialogue: 0,0:37:18.32,0:37:20.15,Default,,0,0,0,,Рей-чан өз өмірін өзіне ұнайтын іспен өткізеді.
Dialogue: 0,0:37:20.74,0:37:22.57,Default,,0,0,0,,Мені тек қызметші деп ойлаңыз.
Dialogue: 0,0:37:22.66,0:37:24.53,Default,,0,0,0,,Қызметші... жақсы шығар
Dialogue: 0,0:37:24.62,0:37:28.04,Default,,0,0,0,,Екеуміз де оқушыға ұқсас бірдеңе айтсақ ше?
Dialogue: 0,0:37:28.12,0:37:29.66,Default,,0,0,0,,Студентке ұқсас нәрселер туралы айтсақ!
Dialogue: 0,0:37:30.29,0:37:32.16,Default,,0,0,0,,Мен жігітті қалаймын~
Dialogue: 0,0:37:32.25,0:37:33.92,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:37:34.00,0:37:37.50,Default,,0,0,0,,Әй, бұл мектеп оқушысының шын тілегі!
Dialogue: 0,0:37:37.59,0:37:38.25,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:37:38.34,0:37:40.80,Default,,0,0,0,,Ертең «Өлі Ай» циркінің қойылымының бірінші күні.
Dialogue: 0,0:37:41.63,0:37:42.55,Default,,0,0,0,,Міне, ақыры!
Dialogue: 0,0:37:42.63,0:37:43.80,Default,,0,0,0,,Кез келген уақытта жақсы!
Dialogue: 0,0:37:43.88,0:37:45.93,Default,,0,0,0,,Хм, менің де уақытым келді.
Dialogue: 0,0:37:46.01,0:37:47.76,Default,,0,0,0,,Одабутсу...
Dialogue: 0,0:37:47.85,0:37:49.64,Default,,0,0,0,,Наму Амида Бутсу.
Dialogue: 0,0:37:49.72,0:37:52.85,Default,,0,0,0,,Ата, біздің үй – киелі үй.
Dialogue: 0,0:37:52.94,0:37:54.31,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:37:54.40,0:37:56.56,Default,,0,0,0,,Маған екі теңдестіру думанын беріңізші.
Dialogue: 0,0:37:56.65,0:37:57.77,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:37:59.07,0:38:00.48,Default,,0,0,0,,Өтінемін (жоғары сынып қызы А) Рахмет.
Dialogue: 0,0:38:00.57,0:38:03.15,Default,,0,0,0,,Мен ағама ғашық болсам ғой.
Dialogue: 0,0:38:03.24,0:38:04.45,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр!
Dialogue: 0,0:38:04.53,0:38:07.95,Default,,0,0,0,,Сіз шынымен жігітті қатты қалайсыз ба?
Dialogue: 0,0:38:08.03,0:38:09.41,Default,,0,0,0,,Мен мұны қалаймын!
Dialogue: 0,0:38:11.83,0:38:13.37,Default,,0,0,0,,Менің арманым келін болу!
Dialogue: 0,0:38:14.00,0:38:15.67,Default,,0,0,0,,Менің арманым дәрігер болу
Dialogue: 0,0:38:15.75,0:38:18.17,Default,,0,0,0,,Менің арманым – кумир болу!
Dialogue: 0,0:38:18.25,0:38:19.63,Default,,0,0,0,,Мен...
Dialogue: 0,0:38:20.63,0:38:23.17,Default,,0,0,0,,Ата жолын жалғастыр
Dialogue: 0,0:38:23.26,0:38:24.97,Default,,0,0,0,,Хикава храмының бас діни қызметкері бол
Dialogue: 0,0:38:25.80,0:38:27.89,Default,,0,0,0,,Мен бұл қалыпты деп ойладым.
Dialogue: 0,0:38:28.60,0:38:31.64,Default,,0,0,0,,Бірақ менің арманым...
Dialogue: 0,0:38:31.72,0:38:32.89,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:38:39.44,0:38:41.36,Default,,0,0,0,,Бүгін жебе адасып бара жатқан сияқты.
Dialogue: 0,0:38:52.62,0:38:54.33,Default,,0,0,0,,Рей осы ғибадатханаға келді
Dialogue: 0,0:38:54.41,0:38:57.29,Default,,0,0,0,,Менің ойымша, бұл бастауыш мектепке барғанға дейін болды.
Dialogue: 0,0:38:58.54,0:39:01.50,Default,,0,0,0,,Атаның бақшасында қарға бар ма?
Dialogue: 0,0:39:01.59,0:39:03.96,Default,,0,0,0,,Көптеген қалалар бар.
Dialogue: 0,0:39:04.05,0:39:05.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:05.72,0:39:08.14,Default,,0,0,0,,Фобос! Димос!
Dialogue: 0,0:39:08.22,0:39:09.05,Default,,0,0,0,,Рэй!
Dialogue: 0,0:39:09.14,0:39:12.47,Default,,0,0,0,,Бұл балалардың есімдері Фобос пен Деймос.
Dialogue: 0,0:39:12.56,0:39:14.10,Default,,0,0,0,,Осылайша шешілді.
Dialogue: 0,0:39:14.64,0:39:17.31,Default,,0,0,0,,Ол әрқашан жұмбақ бала болды.
Dialogue: 0,0:39:18.65,0:39:21.94,Default,,0,0,0,,Рэй, бір күні сен бұл жерден кетесің.
Dialogue: 0,0:39:22.02,0:39:25.99,Default,,0,0,0,,Сіз болу керек жерге ұшып кетесіз.
Dialogue: 0,0:39:26.07,0:39:30.45,Default,,0,0,0,,Мен қашан, қайда екенін білмеймін.
Dialogue: 0,0:39:31.83,0:39:33.04,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:39:34.75,0:39:36.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:36.12,0:39:38.12,Default,,0,0,0,,Өлі ай тамаша цирк шоуы!
Dialogue: 0,0:39:38.21,0:39:40.67,Default,,0,0,0,,Билеттерді алу үшін осы жерді басыңыз
Dialogue: 0,0:39:40.75,0:39:43.05,Default,,0,0,0,,Ішінде жылжымалы ойын-сауық саябағы да бар.
Dialogue: 0,0:39:43.80,0:39:45.26,Default,,0,0,0,,S орны 10 000 иен?
Dialogue: 0,0:39:45.34,0:39:46.88,Default,,0,0,0,,Қымбат! Бұл алаяқтық!
Dialogue: 0,0:39:46.97,0:39:49.22,Default,,0,0,0,,Одан да күдікті! өлі ай циркі
Dialogue: 0,0:39:49.30,0:39:51.76,Default,,0,0,0,,Мен айналама қараймын.
Dialogue: 0,0:39:51.85,0:39:52.64,Default,,0,0,0,,Жарайды
Dialogue: 0,0:39:52.72,0:39:54.72,Default,,0,0,0,,Уау, ойнайтын нәрсе өте көп!
Dialogue: 0,0:39:54.81,0:39:56.77,Default,,0,0,0,,Әй, сен мұнда ойнауға келмедің.
Dialogue: 0,0:39:56.85,0:39:59.48,Default,,0,0,0,,Мамо-чан, азғантай картаға мінейік.
Dialogue: 0,0:39:59.56,0:40:01.06,Default,,0,0,0,,А, мен де!
Dialogue: 0,0:40:01.15,0:40:02.94,Default,,0,0,0,,Бұл жай ғана ойын емес.
Dialogue: 0,0:40:03.52,0:40:05.48,Default,,0,0,0,,Бұл орынсыз.
Dialogue: 0,0:40:05.57,0:40:08.61,Default,,0,0,0,,Мен де Фобос пен Деймосты әдейі алып келдім.
Dialogue: 0,0:40:08.70,0:40:10.82,Default,,0,0,0,,Біз де барлаушыларға барайық.
Dialogue: 0,0:40:10.91,0:40:11.95,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:40:12.03,0:40:14.12,Default,,0,0,0,,Ха... Мен балмұздақ сататын дүңгіршек таптым!
Dialogue: 0,0:40:14.20,0:40:16.45,Default,,0,0,0,,А... Минако-чан, барлаушы!
Dialogue: 0,0:40:16.54,0:40:18.08,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:40:18.16,0:40:19.62,Default,,0,0,0,,Рей-чан не істейді?
Dialogue: 0,0:40:19.71,0:40:22.79,Default,,0,0,0,,Мен мұнда келген-кеткендерді қадағалаймын.
Dialogue: 0,0:40:22.88,0:40:24.63,Default,,0,0,0,,Жарайды, мен бірден қайтамын.
Dialogue: 0,0:40:24.71,0:40:26.01,Default,,0,0,0,,Бұл соншалықты қызықты болды ма?
Dialogue: 0,0:40:26.09,0:40:26.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:40:27.46,0:40:28.51,Default,,0,0,0,,Хехе
Dialogue: 0,0:40:29.09,0:40:31.93,Default,,0,0,0,,Бірақ мен бұлай сезінгеніме біраз уақыт болды
Dialogue: 0,0:40:32.01,0:40:33.14,Default,,0,0,0,,Қызықты!
Dialogue: 0,0:40:33.22,0:40:35.76,Default,,0,0,0,,Өйткені бұл цирк.
Dialogue: 0,0:40:35.85,0:40:36.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:37.52,0:40:38.68,Default,,0,0,0,,Айналы үй?
Dialogue: 0,0:40:41.56,0:40:44.15,Default,,0,0,0,,Көңілді болды (Ұ) Иә.
Dialogue: 0,0:40:45.23,0:40:46.44,Default,,0,0,0,,Ах… олар ақылды да, сүйкімді де көрінеді, иә, Аня?
Dialogue: 0,0:40:48.32,0:40:49.90,Default,,0,0,0,,Кекекеке…
Dialogue: 0,0:40:54.74,0:40:56.74,Default,,0,0,0,,Ол бірден басталды!
Dialogue: 0,0:40:56.83,0:41:00.21,Default,,0,0,0,,Айна үйіне бір адам шақырылады.
Dialogue: 0,0:41:01.46,0:41:02.63,Default,,0,0,0,,Джокукио!
Dialogue: 0,0:41:08.88,0:41:10.42,Default,,0,0,0,,(айқай)
Dialogue: 0,0:41:17.51,0:41:19.43,Default,,0,0,0,,Ештеңені көрсетпейтін айна?
Dialogue: 0,0:41:20.23,0:41:22.23,Default,,0,0,0,,Қызық, қандай қулық бар?
Dialogue: 0,0:41:22.31,0:41:25.65,Default,,0,0,0,,Уайымдамаңыз! Ешқандай тұқым немесе айла жоқ.
Dialogue: 0,0:41:25.73,0:41:26.52,Default,,0,0,0,,Ха!
Dialogue: 0,0:41:26.61,0:41:28.73,Default,,0,0,0,,Танысқаныма қуаныштымын «мен»
Dialogue: 0,0:41:28.82,0:41:30.49,Default,,0,0,0,,Иә! мен?
Dialogue: 0,0:41:30.57,0:41:35.07,Default,,0,0,0,,Енді мен саған жүрегіңде не бар екенін көрсетемін.
Dialogue: 0,0:41:35.16,0:41:37.45,Default,,0,0,0,,Жоқ! Бұл жау...
Dialogue: 0,0:41:37.53,0:41:38.45,Default,,0,0,0,,Күлкі
Dialogue: 0,0:41:39.20,0:41:42.41,Default,,0,0,0,,Қараңдаршы, анам ерте қайтыс болды.
Dialogue: 0,0:41:42.50,0:41:44.75,Default,,0,0,0,,Әкем саяси жұмыстармен айналысады.
Dialogue: 0,0:41:44.83,0:41:47.80,Default,,0,0,0,,Мені атамның үйіне қалдырыңыз.
Dialogue: 0,0:41:47.88,0:41:50.26,Default,,0,0,0,,Жастайыңнан бақытсыз болсаң керек.
Dialogue: 0,0:41:50.34,0:41:51.34,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:41:52.01,0:41:53.72,Default,,0,0,0,,Мен бақытты болғым келеді
Dialogue: 0,0:41:55.47,0:41:58.14,Default,,0,0,0,,Зұлым рухтар қуылды!
Dialogue: 0,0:41:59.64,0:42:00.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:42:01.56,0:42:02.98,Default,,0,0,0,,Ал...
Dialogue: 0,0:42:03.56,0:42:05.81,Default,,0,0,0,,Кейде өзіңе ұнамайтын адаммен
Dialogue: 0,0:42:05.90,0:42:07.82,Default,,0,0,0,,Мен сені бір-екі сүйемін.
Dialogue: 0,0:42:08.77,0:42:10.23,Default,,0,0,0,,Бірақ түпкі мақсат
Dialogue: 0,0:42:10.32,0:42:13.15,Default,,0,0,0,,Бай адамға тұрмысқа шығу
Dialogue: 0,0:42:13.24,0:42:14.86,Default,,0,0,0,,Өмір бойы бақытты өмір сүріңіз
Dialogue: 0,0:42:14.95,0:42:16.32,Default,,0,0,0,,Әйел бақыты деген осы
Dialogue: 0,0:42:16.99,0:42:19.54,Default,,0,0,0,,Ғибадатхананың бас діни қызметкері болу әзіл емес.
Dialogue: 0,0:42:19.62,0:42:21.87,Default,,0,0,0,,Мұндай жерде ұзақ тұрудың қажеті жоқ!
Dialogue: 0,0:42:22.79,0:42:25.37,Default,,0,0,0,,Марс жұлдызының қуаты…
Dialogue: 0,0:42:25.46,0:42:26.96,Default,,0,0,0,,Иә! Уф...
Dialogue: 0,0:42:29.00,0:42:30.34,Default,,0,0,0,,Өзгерту мүмкін емес!
Dialogue: 0,0:42:31.09,0:42:33.01,Default,,0,0,0,,Сіз қате түрлендіру заклинасын қолдандыңыз ба?
Dialogue: 0,0:42:33.09,0:42:34.72,Default,,0,0,0,,Ах... Трансформация...
Dialogue: 0,0:42:35.55,0:42:37.55,Default,,0,0,0,,Нені түрлендіру керек...
Dialogue: 0,0:42:38.05,0:42:41.97,Default,,0,0,0,,Мен... не іздедім?
Dialogue: 0,0:42:44.85,0:42:46.35,Default,,0,0,0,,Хехехе
Dialogue: 0,0:42:46.44,0:42:48.56,Default,,0,0,0,,Кел, Лемрес-чан!
Dialogue: 0,0:42:48.65,0:42:51.28,Default,,0,0,0,,Әдемі арманы бар мына байғұс қыз
Dialogue: 0,0:42:51.36,0:42:53.78,Default,,0,0,0,,Тәніңіз бен жаныңыз болсын
Dialogue: 0,0:42:53.86,0:42:56.74,Default,,0,0,0,,Кекекекекеке…
Dialogue: 0,0:42:56.82,0:42:57.70,Default,,0,0,0,,Мияу!
Dialogue: 0,0:42:57.78,0:42:59.24,Default,,0,0,0,,Мысықтар жоқ.
Dialogue: 0,0:42:59.33,0:43:00.33,Default,,0,0,0,,Міне!
Dialogue: 0,0:43:00.41,0:43:01.20,Default,,0,0,0,,Хмф! (3 жануар) Мияу!
Dialogue: 0,0:43:01.29,0:43:02.95,Default,,0,0,0,,Тынш! Тынш!
Dialogue: 0,0:43:04.00,0:43:05.29,Default,,0,0,0,,Енді.
Dialogue: 0,0:43:05.37,0:43:08.38,Default,,0,0,0,,Өлі Ай циркінің басталатын уақыты келді.
Dialogue: 0,0:43:14.30,0:43:15.72,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:43:15.80,0:43:17.18,Default,,0,0,0,,Ухухухуху
Dialogue: 0,0:43:22.68,0:43:23.60,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:43:26.35,0:43:27.56,Default,,0,0,0,,Эххе
Dialogue: 0,0:43:28.23,0:43:30.11,Default,,0,0,0,,Хе, ха!
Dialogue: 0,0:43:31.07,0:43:31.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:32.40,0:43:34.61,Default,,0,0,0,,Кекекеке!
Dialogue: 0,0:43:34.69,0:43:36.07,Default,,0,0,0,,Батырлар дереу қажет!
Dialogue: 0,0:43:36.70,0:43:41.53,Default,,0,0,0,,Нехеления көбірек, қайта тірілу үшін күш!
Dialogue: 0,0:43:41.62,0:43:44.75,Default,,0,0,0,,Адамдар үшін қорқынышты армандар!
Dialogue: 0,0:43:45.45,0:43:46.62,Default,,0,0,0,,Аспаз…
Dialogue: 0,0:43:46.71,0:43:48.83,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:43:51.75,0:43:52.75,Default,,0,0,0,,Хунда!
Dialogue: 0,0:43:52.84,0:43:54.88,Default,,0,0,0,,Біз бәрібір мысықпыз!
Dialogue: 0,0:43:54.96,0:43:56.51,Default,,0,0,0,,Мен циркті көргім келді.
Dialogue: 0,0:43:56.59,0:43:58.13,Default,,0,0,0,,(айқай)
Dialogue: 0,0:44:00.34,0:44:01.47,Default,,0,0,0,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,0:44:02.01,0:44:04.77,Default,,0,0,0,,Бұрын мұндай ғимарат болмаған.
Dialogue: 0,0:44:07.69,0:44:08.85,Default,,0,0,0,,Хехехе
Dialogue: 0,0:44:08.94,0:44:11.06,Default,,0,0,0,,Менің ойымша, тамақ ішетін уақыт келді.
Dialogue: 0,0:44:13.61,0:44:14.61,Default,,0,0,0,,Ха... Жарайды!
Dialogue: 0,0:44:17.57,0:44:18.24,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:44:20.16,0:44:21.70,Default,,0,0,0,,Марс…
Dialogue: 0,0:44:22.32,0:44:24.08,Default,,0,0,0,,Марс ханшайымы!
Dialogue: 0,0:44:24.79,0:44:27.00,Default,,0,0,0,,Хмм... кім?
Dialogue: 0,0:44:33.21,0:44:34.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:35.75,0:44:37.13,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:44:37.97,0:44:40.13,Default,,0,0,0,,Мұндай техникаға алданып қалу
Dialogue: 0,0:44:40.22,0:44:41.97,Default,,0,0,0,,Маған не болды!
Dialogue: 0,0:44:42.72,0:44:44.14,Default,,0,0,0,,Сен мықты болуың керек!
Dialogue: 0,0:44:44.76,0:44:47.89,Default,,0,0,0,,Бұл біздің Марс ханшайымымыз!
Dialogue: 0,0:44:48.77,0:44:49.81,Default,,0,0,0,,Балалар...
Dialogue: 0,0:44:50.39,0:44:51.77,Default,,0,0,0,,Мен Фобоспын
Dialogue: 0,0:44:51.85,0:44:53.15,Default,,0,0,0,,Мен Димоспын
Dialogue: 0,0:44:53.23,0:44:54.94,Default,,0,0,0,,Енді түрлендіру!
Dialogue: 0,0:44:55.02,0:44:57.61,Default,,0,0,0,,Сіздің Марс Кристаллыңыз!
Dialogue: 0,0:44:59.36,0:45:00.65,Default,,0,0,0,,Марс кристалы…
Dialogue: 0,0:45:03.91,0:45:05.58,Default,,0,0,0,,Менің кристалым!
Dialogue: 0,0:45:06.79,0:45:11.00,Default,,0,0,0,,Mars Crystal Power Макияж!
Dialogue: 0,0:45:38.40,0:45:39.78,Default,,0,0,0,,От жұлдызы!
Dialogue: 0,0:45:39.86,0:45:42.74,Default,,0,0,0,,Марстың қамқоршысы болған жауынгер!
Dialogue: 0,0:45:43.57,0:45:44.87,Default,,0,0,0,,Теңізші Марс!
Dialogue: 0,0:45:46.62,0:45:50.00,Default,,0,0,0,,Марс атынан жазалау!
Dialogue: 0,0:45:50.87,0:45:51.91,Default,,0,0,0,,Тек араласып жүрсің...
Dialogue: 0,0:45:52.67,0:45:56.29,Default,,0,0,0,,Ах! Денемнен жалындар өтіп жатыр
Dialogue: 0,0:45:56.38,0:45:59.09,Default,,0,0,0,,Сізді не қызықтырды?
Dialogue: 0,0:45:59.17,0:46:03.80,Default,,0,0,0,,Мен Серенити ханшайымына тазалығымды ант еткен отты жауынгермін.
Dialogue: 0,0:46:04.51,0:46:08.14,Default,,0,0,0,,Ханшайымды, осы планетаны және менің достарымды қорғау.
Dialogue: 0,0:46:08.22,0:46:09.64,Default,,0,0,0,,Мен күресемін!
Dialogue: 0,0:46:09.72,0:46:11.48,Default,,0,0,0,,Бұл менің арманым!
Dialogue: 0,0:46:14.48,0:46:15.56,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:46:15.65,0:46:18.40,Default,,0,0,0,,Менің арманым суретші болу!
Dialogue: 0,0:46:18.48,0:46:19.40,Default,,0,0,0,,Ахаха~
Dialogue: 0,0:46:19.48,0:46:21.40,Default,,0,0,0,,Уау! Ахх!
Dialogue: 0,0:46:22.36,0:46:24.66,Default,,0,0,0,,Бұл көркем эго…
Dialogue: 0,0:46:25.24,0:46:28.66,Default,,0,0,0,,Қайсысы нағыз мен екенін айта аласыз ба?
Dialogue: 0,0:46:29.37,0:46:30.12,Default,,0,0,0,,Тс!
Dialogue: 0,0:46:31.70,0:46:33.04,Default,,0,0,0,,Бұл өте күлкілі.
Dialogue: 0,0:46:34.25,0:46:38.25,Default,,0,0,0,,Сізде жүйкелер мен сезімдер жоғары дамыған.
Dialogue: 0,0:46:38.34,0:46:41.34,Default,,0,0,0,,Жау сені пайдаланып қалса
Dialogue: 0,0:46:41.42,0:46:44.26,Default,,0,0,0,,Жүрегіңдегі бір жіпті қатайт
Dialogue: 0,0:46:44.76,0:46:46.59,Default,,0,0,0,,Ал шын жүректен
Dialogue: 0,0:46:46.68,0:46:49.31,Default,,0,0,0,,Аяқтау көрсеткісін атыңыз
Dialogue: 0,0:46:49.39,0:46:50.47,Default,,0,0,0,,Марс!
Dialogue: 0,0:46:54.89,0:46:56.60,Default,,0,0,0,,Жалын снайпері!
Dialogue: 0,0:47:01.28,0:47:05.61,Default,,0,0,0,,Уф... Менің арманым суретші болу!
Dialogue: 0,0:47:06.66,0:47:08.57,Default,,0,0,0,,Кекекеке…
Dialogue: 0,0:47:09.41,0:47:10.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:15.62,0:47:17.04,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:47:17.12,0:47:19.17,Default,,0,0,0,,Жолбарыстың көзі жойылды ма?
Dialogue: 0,0:47:19.25,0:47:23.26,Default,,0,0,0,,Қайғы~ Тағы!
Dialogue: 0,0:47:24.21,0:47:26.22,Default,,0,0,0,,Неге... неге бұл тек мен?
Dialogue: 0,0:47:26.30,0:47:28.14,Default,,0,0,0,,Жалғыз карта?
Dialogue: 0,0:47:28.22,0:47:29.85,Default,,0,0,0,,Және үш рет
Dialogue: 0,0:47:29.93,0:47:31.31,Default,,0,0,0,,Ол қазірдің өзінде жоғары сынып оқушысы.
Dialogue: 0,0:47:31.39,0:47:33.68,Default,,0,0,0,,Сіз өз бетіңізше міне аласыз, солай ма?
Dialogue: 0,0:47:33.77,0:47:34.85,Default,,0,0,0,,Сіз әрқашан болдыңыз
Dialogue: 0,0:47:34.93,0:47:37.90,Default,,0,0,0,,Мамо-чан, менің ойымша, мұның барлығын өзіме сақтап қойғандықтан шығар!
Dialogue: 0,0:47:37.98,0:47:40.11,Default,,0,0,0,,Ақыр соңында, жігітіңмен осындай жерге келу керек емес пе?
Dialogue: 0,0:47:40.19,0:47:41.94,Default,,0,0,0,,Бұл жақсы (Ами) Хаа...
Dialogue: 0,0:47:42.02,0:47:42.98,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:47:43.07,0:47:44.36,Default,,0,0,0,,Рей-чан?
Dialogue: 0,0:47:45.44,0:47:47.36,Default,,0,0,0,,Жау пайда болып, сіз соғысып жатырсыз ба?
Dialogue: 0,0:47:47.45,0:47:48.24,Default,,0,0,0,,Иә
Dialogue: 0,0:47:48.86,0:47:52.62,Default,,0,0,0,,Екіленіп қалсаң, жүрегіңнің түбіне енеді.
Dialogue: 0,0:47:52.70,0:47:54.54,Default,,0,0,0,,Жау деген сондай жиіркенішті адамдар.
Dialogue: 0,0:47:54.62,0:47:58.29,Default,,0,0,0,,Бұл бүкіл цирк олардың тұзағы дегенді білдіре ме?
Dialogue: 0,0:47:58.37,0:48:00.42,Default,,0,0,0,,Өлі Ай циркі
Dialogue: 0,0:48:00.50,0:48:03.67,Default,,0,0,0,,Қандай жағдай болмасын, біз олардың шынайы болмысын ашуымыз керек!
Dialogue: 0,0:48:03.75,0:48:07.01,Default,,0,0,0,,Ал біз қала тұрғындарын қорғауымыз керек!
Dialogue: 0,0:48:07.09,0:48:09.13,Default,,0,0,0,,Хм, қазірдің өзінде!
Dialogue: 0,0:48:09.22,0:48:10.30,Default,,0,0,0,,Теңізші Сенши!
Dialogue: 0,0:48:10.39,0:48:13.26,Default,,0,0,0,,Әлгі қарғыс атқырлар да қауесет сияқты!
Dialogue: 0,0:48:13.35,0:48:16.81,Default,,0,0,0,,Жолбарыстың көзіне жету оңай болды...
Dialogue: 0,0:48:16.89,0:48:18.64,Default,,0,0,0,,Шоу да ортада ашылады!
Dialogue: 0,0:48:19.48,0:48:21.56,Default,,0,0,0,,Бұл кек қымбат!
Dialogue: 0,0:48:21.65,0:48:23.40,Default,,0,0,0,,Бірақ оны жарқыраған етіп орнатыңыз
Dialogue: 0,0:48:23.48,0:48:26.36,Default,,0,0,0,,Циркті бүлдіріп көріңіз.
Dialogue: 0,0:48:26.44,0:48:30.11,Default,,0,0,0,,Біз қарт қаңбақпен жыртылатынбыз.
Dialogue: 0,0:48:30.20,0:48:31.32,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:48:31.41,0:48:33.58,Default,,0,0,0,,Баяу және мұқият жоспарлаңыз
Dialogue: 0,0:48:33.66,0:48:36.25,Default,,0,0,0,,Ал көңілді болған жақсы.
Dialogue: 0,0:48:37.29,0:48:39.50,Default,,0,0,0,,Менің өлі ай циркінің шоуы
Dialogue: 0,0:48:39.58,0:48:41.63,Default,,0,0,0,,Бұл тек бастамасы ғана
Dialogue: 0,0:48:45.00,0:48:45.96,Default,,0,0,0,,Жылама
Dialogue: 0,0:48:47.09,0:48:48.51,Default,,0,0,0,,Кішкентай қыз
Dialogue: 0,0:48:50.22,0:48:52.68,Default,,0,0,0,,Содан бері Элиос көрінбеді.
Dialogue: 0,0:48:53.89,0:48:54.56,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:48:59.35,0:49:00.44,Default,,0,0,0,,Хаа…
Dialogue: 0,0:49:00.52,0:49:01.81,Default,,0,0,0,,Элиос…
Dialogue: 0,0:49:02.40,0:49:05.11,Default,,0,0,0,,Неліктен ол кенеттен көрінбей қалды?
Dialogue: 0,0:49:05.61,0:49:08.07,Default,,0,0,0,,Бұл Элиостың шынайы формасы ма?
Dialogue: 0,0:49:09.11,0:49:11.57,Default,,0,0,0,,Неліктен Пегасқа ұқсайды?
Dialogue: 0,0:49:15.45,0:49:18.12,Default,,0,0,0,,Чибиуса, сенде тамақ жоқ па?
Dialogue: 0,0:49:18.20,0:49:20.91,Default,,0,0,0,,Менің тәбетім жоқ. Менің кеудем толы.
Dialogue: 0,0:49:21.00,0:49:21.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:49:22.04,0:49:24.38,Default,,0,0,0,,Түсіндім, бұл ұят.
Dialogue: 0,0:49:24.46,0:49:28.01,Default,,0,0,0,,Бүгін менде анамның дәмді шоколадты торты болды.
Dialogue: 0,0:49:30.13,0:49:32.47,Default,,0,0,0,,Менің тәбетім жоқ, бірақ жеймін!
Dialogue: 0,0:49:32.55,0:49:34.55,Default,,0,0,0,,Иә? Қайда бара жатырсың?
Dialogue: 0,0:49:35.18,0:49:37.68,Default,,0,0,0,,Мамо-чан өзін нашар сезінеді.
Dialogue: 0,0:49:37.77,0:49:39.52,Default,,0,0,0,,Мен де университетте жоқпын.
Dialogue: 0,0:49:39.60,0:49:41.35,Default,,0,0,0,,Мен сізге қонаққа баруды ойладым.
Dialogue: 0,0:49:41.85,0:49:43.19,Default,,0,0,0,,Сен де барасың ба?
Dialogue: 0,0:49:45.06,0:49:47.52,Default,,0,0,0,,А... Жарайды.
Dialogue: 0,0:49:47.61,0:49:48.94,Default,,0,0,0,,О, бұл әдеттен тыс.
Dialogue: 0,0:49:50.11,0:49:51.36,Default,,0,0,0,,Ал, мен барамын.
Dialogue: 0,0:49:51.45,0:49:52.45,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:49:55.57,0:49:56.83,Default,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,0:49:57.62,0:50:00.83,Default,,0,0,0,,Содан бері мен Элиос туралы ғана ойладым.
Dialogue: 0,0:50:02.04,0:50:03.58,Default,,0,0,0,,Мен саған көмектескім келеді
Dialogue: 0,0:50:05.04,0:50:07.38,Default,,0,0,0,,Мүмкін мен біреумен сөйлесуім керек шығар...
Dialogue: 0,0:50:08.50,0:50:12.05,Default,,0,0,0,,Қояндардың сөйлесе алатын достары көп болғаны жақсы.
Dialogue: 0,0:50:12.13,0:50:14.76,Default,,0,0,0,,Кішкентай ханым Сіз жаттығудасыз!
Dialogue: 0,0:50:14.84,0:50:17.64,Default,,0,0,0,,Мен өз ұстанымымды Усаги-самамен салыстырып жатқаныма сене алар емеспін...
Dialogue: 0,0:50:18.43,0:50:19.93,Default,,0,0,0,,Жарайды, міне. Бағасы 12 доллар болады.
Dialogue: 0,0:50:22.69,0:50:25.35,Default,,0,0,0,,Бір күні мен де жақсы жауынгер боламын.
Dialogue: 0,0:50:25.44,0:50:27.82,Default,,0,0,0,,Мен қашан достасамын...
Dialogue: 0,0:50:27.90,0:50:29.86,Default,,0,0,0,,Сондай заман келер деп үміттенемін
Dialogue: 0,0:50:31.07,0:50:32.03,Default,,0,0,0,,Хаа…
Dialogue: 0,0:50:37.16,0:50:38.08,Default,,0,0,0,,Ха…
Dialogue: 0,0:50:38.66,0:50:39.87,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:50:39.95,0:50:41.20,Default,,0,0,0,,Мао-чан
Dialogue: 0,0:50:41.29,0:50:42.25,Default,,0,0,0,,Қоян
Dialogue: 0,0:50:42.33,0:50:43.21,Default,,0,0,0,,Эххе
Dialogue: 0,0:50:43.75,0:50:45.29,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:50:45.37,0:50:47.67,Default,,0,0,0,,Мен сені тамақ жеген жоқпын деп ойладым.
Dialogue: 0,0:50:47.75,0:50:49.42,Default,,0,0,0,,Мен түскі қорап әкелдім.
Dialogue: 0,0:50:49.50,0:50:51.71,Default,,0,0,0,,Осыдан кейін сусындар мен...
Dialogue: 0,0:50:51.80,0:50:52.63,Default,,0,0,0,,Қоян
Dialogue: 0,0:50:52.72,0:50:53.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:54.76,0:50:56.34,Default,,0,0,0,,Қайтып келе аласыз ба?
Dialogue: 0,0:50:56.43,0:50:57.26,Default,,0,0,0,,А...
Dialogue: 0,0:50:57.34,0:51:00.10,Default,,0,0,0,,Мен енді ұйықтайын деп ойладым.
Dialogue: 0,0:51:00.18,0:51:02.35,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:51:02.43,0:51:04.44,Default,,0,0,0,,Кешіріңіз, мен үйге бара жатырмын.
Dialogue: 0,0:51:05.44,0:51:08.44,Default,,0,0,0,,Сізге кенеттен кіріп кеткенім үшін кешіріңіз.
Dialogue: 0,0:51:09.11,0:51:09.86,Default,,0,0,0,,Секір!!
Dialogue: 0,0:51:10.69,0:51:12.03,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,0:51:13.40,0:51:14.86,Default,,0,0,0,,Өкпедегі көлеңкелер...
Dialogue: 0,0:51:15.53,0:51:18.28,Default,,0,0,0,,Менің денеме не болды...
Dialogue: 0,0:51:18.82,0:51:22.58,Default,,0,0,0,,Мен тағы да қоянға кедергі боламын ба?
Dialogue: 0,0:51:24.79,0:51:25.71,Default,,0,0,0,,Мамо-чан...
Dialogue: 0,0:51:29.13,0:51:30.84,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:51:30.92,0:51:33.51,Default,,0,0,0,,Цирк қалада өзін толықтай танытты.
Dialogue: 0,0:51:33.59,0:51:37.26,Default,,0,0,0,,Сол жігіттер келгеннен бері Джубан аздап кірленіп кетті.
Dialogue: 0,0:51:37.34,0:51:39.97,Default,,0,0,0,,Көмек болмайды, адамдар жиналып қалады.
Dialogue: 0,0:51:40.05,0:51:42.14,Default,,0,0,0,,Бізге тез арада бірдеңе істеу керек.
Dialogue: 0,0:51:43.52,0:51:45.89,Default,,0,0,0,,Сонда да ыстық, солай емес пе?
Dialogue: 0,0:51:48.06,0:51:49.90,Default,,0,0,0,,Макочан
Dialogue: 0,0:51:49.98,0:51:50.94,Default,,0,0,0,,Эххе
Dialogue: 0,0:51:51.02,0:51:52.07,Default,,0,0,0,,О!
Dialogue: 0,0:51:52.98,0:51:54.65,Default,,0,0,0,,Сәлем, Чибиуса!
Dialogue: 0,0:51:54.74,0:51:57.03,Default,,0,0,0,,Ах... Мако-чан
Dialogue: 0,0:51:57.11,0:51:59.53,Default,,0,0,0,,Мен сізбен бір нәрсені талқылағым келеді.
Dialogue: 0,0:52:00.12,0:52:02.33,Default,,0,0,0,,Не? Не? Ол өзгерді
Dialogue: 0,0:52:02.41,0:52:04.75,Default,,0,0,0,,Сізді қызықтырған баламен кездесе алдыңыз ба?
Dialogue: 0,0:52:05.37,0:52:06.21,Default,,0,0,0,,Өткір...
Dialogue: 0,0:52:06.29,0:52:07.04,Default,,0,0,0,,Хехехе
Dialogue: 0,0:52:07.12,0:52:08.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:09.04,0:52:09.92,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:52:10.00,0:52:12.84,Default,,0,0,0,,Осы уақытта Мако-чан сізге дәмді тағам дайындап береді.
Dialogue: 0,0:52:12.92,0:52:13.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:52:13.63,0:52:14.51,Default,,0,0,0,,Хехе
Dialogue: 0,0:52:15.13,0:52:17.01,Default,,0,0,0,,Ах... бұл иіс...
Dialogue: 0,0:52:23.35,0:52:25.56,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:52:25.64,0:52:28.69,Default,,0,0,0,,А, у... мына дүкен...
Dialogue: 0,0:52:28.77,0:52:30.81,Default,,0,0,0,,Дүкен бүгін ғана ашылды.
Dialogue: 0,0:52:30.90,0:52:32.61,Default,,0,0,0,,Қуаныштымын... Уһ.
Dialogue: 0,0:52:33.19,0:52:34.36,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:52:34.44,0:52:36.78,Default,,0,0,0,,Қандай керемет әртүрлілік!
Dialogue: 0,0:52:36.86,0:52:38.70,Default,,0,0,0,,Бізде көптеген шөптер бар.
Dialogue: 0,0:52:38.78,0:52:39.95,Default,,0,0,0,,Я~
Dialogue: 0,0:52:40.45,0:52:43.20,Default,,0,0,0,,Осындай шағын дүкеннің иесі менмін.
Dialogue: 0,0:52:43.28,0:52:45.41,Default,,0,0,0,,Бұл менің жас кезімнен арманым еді.
Dialogue: 0,0:52:45.49,0:52:47.83,Default,,0,0,0,,Сонымен, сіздің арманыңыз орындалды.
Dialogue: 0,0:52:47.91,0:52:50.79,Default,,0,0,0,,Орындалмады, орындалды.
Dialogue: 0,0:52:51.38,0:52:53.04,Default,,0,0,0,,Мен арманымды орындадым...
Dialogue: 0,0:52:53.13,0:52:55.38,Default,,0,0,0,,Бірақ арман әлі де жалғасуда
Dialogue: 0,0:52:55.46,0:52:58.26,Default,,0,0,0,,Бір күні мен дүние жүзінде дүкендер ашамын.
Dialogue: 0,0:52:59.55,0:53:00.38,Default,,0,0,0,,Ум...
Dialogue: 0,0:53:00.47,0:53:01.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:01.72,0:53:05.72,Default,,0,0,0,,Менің арманым бір күні дүкеннің иесі болу.
Dialogue: 0,0:53:05.81,0:53:07.89,Default,,0,0,0,,Гүл дүкені немесе торт дүкені?
Dialogue: 0,0:53:07.98,0:53:09.48,Default,,0,0,0,,Жақсы, жақсы!
Dialogue: 0,0:53:09.56,0:53:11.85,Default,,0,0,0,,Оны орындаңыз.
Dialogue: 0,0:53:12.35,0:53:13.44,Default,,0,0,0,,Мақсаттарыңызды анықтағаннан кейін
Dialogue: 0,0:53:13.52,0:53:15.77,Default,,0,0,0,,Жастайынан талпыну керек!
Dialogue: 0,0:53:15.86,0:53:17.61,Default,,0,0,0,,Тағы, тағы!
Dialogue: 0,0:53:17.69,0:53:18.78,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:53:20.03,0:53:24.20,Default,,0,0,0,,Алғашқы екі тұтынушыға арнайы сыйлық
Dialogue: 0,0:53:24.28,0:53:26.87,Default,,0,0,0,,Уау, әдемі сақина
Dialogue: 0,0:53:26.95,0:53:29.04,Default,,0,0,0,,Бұл зұлымдықтан сақтандыратын бойтұмар.
Dialogue: 0,0:53:29.12,0:53:31.79,Default,,0,0,0,,Бұл да арманды орындайтын бойтұмар.
Dialogue: 0,0:53:31.87,0:53:34.04,Default,,0,0,0,,Армандарыңызды орындаңыз?
Dialogue: 0,0:53:35.75,0:53:36.96,Default,,0,0,0,,Мако-чан
Dialogue: 0,0:53:37.05,0:53:39.21,Default,,0,0,0,,Мен қызанақты турап, салатқа саламын.
Dialogue: 0,0:53:39.30,0:53:40.09,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:53:40.17,0:53:42.64,Default,,0,0,0,,Содан кейін насыбайгүл себіңіз де, үстелге қызмет етіңіз.
Dialogue: 0,0:53:42.72,0:53:43.59,Default,,0,0,0,,Насыбайгүл?
Dialogue: 0,0:53:43.68,0:53:45.68,Default,,0,0,0,,Қызанақты дәмді ететін шөп.
Dialogue: 0,0:53:45.76,0:53:46.56,Default,,0,0,0,,Я~
Dialogue: 0,0:53:47.89,0:53:50.48,Default,,0,0,0,,Олай болса... (2 адам) Мен аламын.
Dialogue: 0,0:53:54.10,0:53:56.44,Default,,0,0,0,,Хмм, дәмді!
Dialogue: 0,0:53:56.52,0:53:57.44,Default,,0,0,0,,Хехе
Dialogue: 0,0:53:57.52,0:54:00.07,Default,,0,0,0,,Мако-чанның тамағы ең жақсы!
Dialogue: 0,0:54:00.15,0:54:03.16,Default,,0,0,0,,Армандарды орындайтын бойтұмар...
Dialogue: 0,0:54:03.24,0:54:06.08,Default,,0,0,0,,Бұл кеңсе қызметкері жақсы болды.
Dialogue: 0,0:54:06.78,0:54:09.87,Default,,0,0,0,,Армандарымды орындасам да, тырысамын.
Dialogue: 0,0:54:10.87,0:54:13.42,Default,,0,0,0,,Ата-анам жастай қайтыс болды.
Dialogue: 0,0:54:13.50,0:54:15.29,Default,,0,0,0,,Себебі мен ұзақ уақыт жалғыз тұрдым
Dialogue: 0,0:54:15.38,0:54:18.88,Default,,0,0,0,,Ерте үйленіп, бақытты отбасын құру
Dialogue: 0,0:54:19.76,0:54:23.30,Default,,0,0,0,,Ал шағын гүл дүкені мен торт дүкенін ашыңыз.
Dialogue: 0,0:54:25.84,0:54:28.18,Default,,0,0,0,,Бұл құпия, бірақ бұл шындық.
Dialogue: 0,0:54:28.26,0:54:31.23,Default,,0,0,0,,Мен Мичиру сияқты әдемі әйел болғым келеді
Dialogue: 0,0:54:31.31,0:54:33.77,Default,,0,0,0,,Мен Харука-сан сияқты күшті болғым келеді
Dialogue: 0,0:54:34.44,0:54:35.69,Default,,0,0,0,,Көптеген армандар
Dialogue: 0,0:54:36.56,0:54:37.40,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:54:38.27,0:54:41.69,Default,,0,0,0,,Сол арман үшін көп еңбек еттім бе?
Dialogue: 0,0:54:43.74,0:54:45.74,Default,,0,0,0,,Кеше Мако-чанға
Dialogue: 0,0:54:45.82,0:54:48.62,Default,,0,0,0,,Маған шөптен жасалған тағамдар көп болды.
Dialogue: 0,0:54:48.70,0:54:49.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:54:50.10,0:54:51.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:52.54,0:54:53.79,Default,,0,0,0,,Сонымен, бұл...
Dialogue: 0,0:54:53.87,0:54:56.50,Default,,0,0,0,,Мен оны кеше Мако-чанмен бірге барған дүкеннен алдым.
Dialogue: 0,0:54:56.58,0:54:58.75,Default,,0,0,0,,Бұл зұлым рухтардан қорғайтын бойтұмар.
Dialogue: 0,0:54:58.84,0:55:01.26,Default,,0,0,0,,Мамо-чанның қолында болғанын қалаймын.
Dialogue: 0,0:55:01.76,0:55:03.13,Default,,0,0,0,,Рахмет Чибиуса
Dialogue: 0,0:55:04.63,0:55:06.47,Default,,0,0,0,,Сау болыңыз Мамо-чан
Dialogue: 0,0:55:06.55,0:55:08.64,Default,,0,0,0,,Жақсы тамақтаныңыз.
Dialogue: 0,0:55:08.72,0:55:10.39,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:55:10.89,0:55:12.14,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:55:12.22,0:55:14.48,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:55:21.53,0:55:24.90,Default,,0,0,0,,Мен саған жақсылап қара дедім.
Dialogue: 0,0:55:24.99,0:55:27.49,Default,,0,0,0,,Мамо-чан әлі науқас болып көрінді.
Dialogue: 0,0:55:27.57,0:55:28.95,Default,,0,0,0,,Мен...
Dialogue: 0,0:55:29.03,0:55:31.24,Default,,0,0,0,,Кешіріңіз, Чибиуса, рахмет
Dialogue: 0,0:55:31.33,0:55:33.41,Default,,0,0,0,,Неге кездеспейміз?
Dialogue: 0,0:55:33.50,0:55:34.41,Default,,0,0,0,,Та-да!
Dialogue: 0,0:55:34.50,0:55:35.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:36.17,0:55:38.67,Default,,0,0,0,,Мен қайтадан қабылданбаудан қорқамын.
Dialogue: 0,0:55:39.92,0:55:42.30,Default,,0,0,0,,Бірдеңе болды, солай ма? Мамо-чан
Dialogue: 0,0:55:42.38,0:55:45.26,Default,,0,0,0,,Сіз маған уақытында айтасыз.
Dialogue: 0,0:55:52.31,0:55:53.60,Default,,0,0,0,,О, қош келдіңіз.
Dialogue: 0,0:55:54.18,0:55:56.44,Default,,0,0,0,,Мен қарап шыға аламын ба?
Dialogue: 0,0:55:56.52,0:55:58.06,Default,,0,0,0,,Әрине.
Dialogue: 0,0:55:59.23,0:56:01.94,Default,,0,0,0,,Не болды? Бірдеңе болды ма?
Dialogue: 0,0:56:03.23,0:56:06.32,Default,,0,0,0,,Мен достарыммен бірдеңе туралы сөйлесе алмаймын...
Dialogue: 0,0:56:07.53,0:56:10.41,Default,,0,0,0,,Менің армандарым көп.
Dialogue: 0,0:56:10.49,0:56:12.45,Default,,0,0,0,,Бірақ мен абдырап қалдым...
Dialogue: 0,0:56:13.29,0:56:14.70,Default,,0,0,0,,Жер
Dialogue: 0,0:56:14.79,0:56:17.16,Default,,0,0,0,,Егер мен осылай матрос сенші болып қала берсем.
Dialogue: 0,0:56:17.25,0:56:18.79,Default,,0,0,0,,Тек ұрыс
Dialogue: 0,0:56:19.29,0:56:22.17,Default,,0,0,0,,Менің армандарым орындалмайды, солай ма?
Dialogue: 0,0:56:22.84,0:56:24.30,Default,,0,0,0,,Мен жүрген жол
Dialogue: 0,0:56:24.38,0:56:26.97,Default,,0,0,0,,Мен қате болуы мүмкін деп ойладым.
Dialogue: 0,0:56:27.59,0:56:29.76,Default,,0,0,0,,Жоқ... не айтып тұрсың?
Dialogue: 0,0:56:29.84,0:56:32.64,Default,,0,0,0,,Күмәніңіз болса, неге тастамайсыз?
Dialogue: 0,0:56:32.72,0:56:33.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:33.51,0:56:35.60,Default,,0,0,0,,Теңізші Сенши?
Dialogue: 0,0:56:36.23,0:56:37.85,Default,,0,0,0,,Не, мына балалар!
Dialogue: 0,0:56:37.94,0:56:39.31,Default,,0,0,0,,Қашу мүмкін емес!
Dialogue: 0,0:56:39.40,0:56:41.81,Default,,0,0,0,,Қошмар инкарнация Ремрес-чан және т.б
Dialogue: 0,0:56:41.90,0:56:44.57,Default,,0,0,0,,Арманға толысың, жарылып кете жаздадың
Dialogue: 0,0:56:44.65,0:56:46.65,Default,,0,0,0,,Мен мұны қалаймын
Dialogue: 0,0:56:46.74,0:56:49.15,Default,,0,0,0,,Сіз де Өлі Ай циркіне қосылыңыз.
Dialogue: 0,0:56:49.24,0:56:50.66,Default,,0,0,0,,Неге кірмеске?
Dialogue: 0,0:56:50.74,0:56:52.16,Default,,0,0,0,,Өлі ай!
Dialogue: 0,0:56:52.24,0:56:54.12,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:56:54.20,0:56:55.20,Default,,0,0,0,,Менімен бірге
Dialogue: 0,0:56:55.29,0:56:58.50,Default,,0,0,0,,Дүние жүзінде түнгі түндерді сатайық.
Dialogue: 0,0:56:58.58,0:57:00.46,Default,,0,0,0,,Арх... аа!
Dialogue: 0,0:57:00.54,0:57:02.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:02.17,0:57:03.21,Default,,0,0,0,,Хехехе
Dialogue: 0,0:57:03.84,0:57:05.50,Default,,0,0,0,,Қуат...
Dialogue: 0,0:57:07.26,0:57:09.22,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:57:09.30,0:57:12.09,Default,,0,0,0,,Енді маған ешкім көмекке келе алмайды.
Dialogue: 0,0:57:12.18,0:57:14.81,Default,,0,0,0,,Бұл Амазонка тасының «шар түйіні».
Dialogue: 0,0:57:14.89,0:57:18.60,Default,,0,0,0,,Бұл жолы Теңізші Сеншидің соңы.
Dialogue: 0,0:57:19.56,0:57:21.48,Default,,0,0,0,,Бұл кішкентай ғана нәрсе.
Dialogue: 0,0:57:21.56,0:57:24.86,Default,,0,0,0,,Юпитер... Юпитер!
Dialogue: 0,0:57:25.69,0:57:26.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:57:28.36,0:57:29.53,Default,,0,0,0,,Бұл!
Dialogue: 0,0:57:29.61,0:57:31.28,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:57:31.91,0:57:33.87,Default,,0,0,0,,Жауға әлсіздігімді көрсетсем не істеймін?
Dialogue: 0,0:57:33.95,0:57:36.62,Default,,0,0,0,,Өз миссияңызды ұмыттыңыз ба?
Dialogue: 0,0:57:36.70,0:57:38.50,Default,,0,0,0,,Ешбір суперқуат Юпитер жоқ
Dialogue: 0,0:57:38.58,0:57:41.42,Default,,0,0,0,,Серенити ханшайымы мен оның басқа достарына кім қамқор болды...
Dialogue: 0,0:57:41.50,0:57:44.04,Default,,0,0,0,,Сіз бұл қаланың тұрғындарын қорғай аласыз!
Dialogue: 0,0:57:44.13,0:57:47.46,Default,,0,0,0,,Дұрыс... Мен Юпитермін
Dialogue: 0,0:57:48.13,0:57:49.88,Default,,0,0,0,,Арман көп, бірақ
Dialogue: 0,0:57:50.47,0:57:52.26,Default,,0,0,0,,Дәл қазір менің ең үлкен арманым
Dialogue: 0,0:57:52.34,0:57:55.89,Default,,0,0,0,,Өзің жақсы көретіндердің барлығын қорғайтын ең мықты жауынгер бол
Dialogue: 0,0:57:56.56,0:57:58.68,Default,,0,0,0,,Міне, миссия!
Dialogue: 0,0:57:58.77,0:57:59.89,Default,,0,0,0,,Шындық
Dialogue: 0,0:58:00.77,0:58:01.81,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:58:02.39,0:58:04.65,Default,,0,0,0,,Ең үлкен жау – өз әлсіздігің!
Dialogue: 0,0:58:04.73,0:58:06.90,Default,,0,0,0,,Мен білемін, Харука-сан.
Dialogue: 0,0:58:07.86,0:58:08.90,Default,,0,0,0,,Мен оларды дәл қазір толықтай сіңіріп алдым.
Dialogue: 0,0:58:08.98,0:58:11.90,Default,,0,0,0,,Хехе... Сондықтан Юпитер теңізші
Dialogue: 0,0:58:11.99,0:58:14.20,Default,,0,0,0,,Бұл менің Юпитер ханшайымым.
Dialogue: 0,0:58:16.58,0:58:18.66,Default,,0,0,0,,Бұл сіздің Юпитер Кристаллыңыз.
Dialogue: 0,0:58:19.24,0:58:20.00,Default,,0,0,0,,Сіз...
Dialogue: 0,0:58:20.08,0:58:22.96,Default,,0,0,0,,Менің ойымша, мен сенің алтер-эгосыңмын.
Dialogue: 0,0:58:24.21,0:58:25.67,Default,,0,0,0,,Мен сені үнемі бақылап отырамын!
Dialogue: 0,0:58:25.75,0:58:27.75,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Юпитер!
Dialogue: 0,0:58:29.96,0:58:30.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:58:31.72,0:58:33.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:34.26,0:58:36.55,Default,,0,0,0,,Юпитердің кристалдық күші
Dialogue: 0,0:58:36.64,0:58:38.56,Default,,0,0,0,,Макияж!
Dialogue: 0,0:58:59.87,0:59:01.83,Default,,0,0,0,,Найзағай жұлдызы!
Dialogue: 0,0:59:01.91,0:59:04.79,Default,,0,0,0,,Юпитер оның қамқоршысы болған қорғаныс жауынгері!
Dialogue: 0,0:59:05.37,0:59:07.21,Default,,0,0,0,,Теңізші Юпитер!
Dialogue: 0,0:59:08.75,0:59:11.76,Default,,0,0,0,,Өкінішті етіп, жансыздандырамын!
Dialogue: 0,0:59:13.63,0:59:15.80,Default,,0,0,0,,Мен сені бұл қаладан міндетті түрде қуамын.
Dialogue: 0,0:59:15.88,0:59:17.72,Default,,0,0,0,,Өлі Ай циркі!
Dialogue: 0,0:59:18.89,0:59:21.31,Default,,0,0,0,,Не! (Хокстың көзі) Жоқ!
Dialogue: 0,0:59:23.68,0:59:27.23,Default,,0,0,0,,Бұл Райденнің эмблемасы: емен жапырағы!
Dialogue: 0,0:59:30.57,0:59:32.07,Default,,0,0,0,,Юпитер!
Dialogue: 0,0:59:32.15,0:59:35.11,Default,,0,0,0,,Орк эволюциясы!
Dialogue: 0,0:59:35.20,0:59:36.41,Default,,0,0,0,,Иә... иә?
Dialogue: 0,0:59:38.45,0:59:39.53,Default,,0,0,0,,An!
Dialogue: 0,0:59:39.62,0:59:41.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:41.99,0:59:42.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:59:44.46,0:59:45.58,Default,,0,0,0,,Ойланба
Dialogue: 0,0:59:46.25,0:59:49.54,Default,,0,0,0,,Менің арманым осымен аяқталады деп ойлаймын...
Dialogue: 0,0:59:50.67,0:59:53.96,Default,,0,0,0,,Аз ғана уақыт болса да, сіз өзіңіздің жеке дүкеніңізге ие бола аласыз.
Dialogue: 0,0:59:54.05,0:59:55.26,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,0:59:57.22,0:59:58.80,Default,,0,0,0,,Сен де армансың...
Dialogue: 0,0:59:59.76,1:00:02.51,Default,,0,0,0,,Оны міндетті түрде орындаңыз
Dialogue: 0,1:00:02.60,1:00:04.68,Default,,0,0,0,,Кекекеке…
Dialogue: 0,1:00:06.85,1:00:08.02,Default,,0,0,0,,Юпитер!
Dialogue: 0,1:00:08.10,1:00:10.02,Default,,0,0,0,,Қоян! Чибиуса!
Dialogue: 0,1:00:12.40,1:00:14.40,Default,,0,0,0,,Бұл жігіттер қатты тітіркендіреді!
Dialogue: 0,1:00:14.49,1:00:16.74,Default,,0,0,0,,Бұл шынымен тітіркендіргіш.
Dialogue: 0,1:00:18.20,1:00:19.82,Default,,0,0,0,,Олар жау ма?
Dialogue: 0,1:00:19.91,1:00:20.66,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:00:20.74,1:00:21.62,Default,,0,0,0,,Ах!
Dialogue: 0,1:00:23.58,1:00:25.54,Default,,0,0,0,,Сузу... Элиос?
Dialogue: 0,1:00:26.62,1:00:29.29,Default,,0,0,0,,Элиос мені бір жерге шақырып жатыр!
Dialogue: 0,1:00:29.92,1:00:30.54,Default,,0,0,0,,Ха!
Dialogue: 0,1:00:30.63,1:00:31.96,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,1:00:32.04,1:00:33.21,Default,,0,0,0,,Чибиуса!
Dialogue: 0,1:00:33.30,1:00:34.30,Default,,0,0,0,,Иә!
Dialogue: 0,1:00:38.63,1:00:40.43,Default,,0,0,0,,Мамо-чан! (Чиби Мун) Элиос!
Dialogue: 0,1:00:40.51,1:00:41.64,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:00:41.72,1:00:42.39,Default,,0,0,0,,Иә!
Dialogue: 0,1:00:44.97,1:00:50.56,Default,,0,0,0,,Айдың керемет медитациясы!
Dialogue: 0,1:00:54.27,1:00:55.40,Default,,0,0,0,,Уф...
Dialogue: 0,1:00:56.15,1:00:57.36,Default,,0,0,0,,Кекекеке…
Dialogue: 0,1:00:57.44,1:00:59.82,Default,,0,0,0,,Қыз... Уф...
Dialogue: 0,1:00:59.91,1:01:00.99,Default,,0,0,0,,Элиос!
Dialogue: 0,1:01:01.07,1:01:02.83,Default,,0,0,0,,Мамо-чан! (Юпитер) Мамору-сан!
Dialogue: 0,1:01:02.91,1:01:05.49,Default,,0,0,0,,(Маморудың жөтелі)
Dialogue: 0,1:01:06.58,1:01:07.58,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:07.66,1:01:08.66,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,1:01:08.75,1:01:09.79,Default,,0,0,0,,(Танжиро) Ой… (Чунтарo) Чип, чип
Dialogue: 0,1:01:10.29,1:01:11.96,Default,,0,0,0,,Қара қан?
Dialogue: 0,1:01:12.04,1:01:14.50,Default,,0,0,0,,Мамо-чан, сен қашаннан бері осылайсың...
Dialogue: 0,1:01:15.05,1:01:17.42,Default,,0,0,0,,Біраз бұрын кеудем ауыра бастады...
Dialogue: 0,1:01:18.09,1:01:18.92,Default,,0,0,0,,Уф!
Dialogue: 0,1:01:19.01,1:01:21.34,Default,,0,0,0,,Ал өкпемде қара көлеңке...
Dialogue: 0,1:01:21.43,1:01:23.60,Default,,0,0,0,,Уақыт жеткен сияқты
Dialogue: 0,1:01:23.68,1:01:25.18,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,1:01:27.52,1:01:29.48,Default,,0,0,0,,Мен Элизийдің діни қызметкерімін
Dialogue: 0,1:01:30.73,1:01:31.98,Default,,0,0,0,,Элиос
Dialogue: 0,1:01:32.06,1:01:34.32,Default,,0,0,0,,Элизий діни қызметкері?
Dialogue: 0,1:01:35.98,1:01:38.57,Default,,0,0,0,,Элизий жердің тереңінде
Dialogue: 0,1:01:38.65,1:01:41.24,Default,,0,0,0,,Бұл планетаны қорғайтын киелі жер.
Dialogue: 0,1:01:41.32,1:01:43.87,Default,,0,0,0,,Осы планетаның жүрегі сияқты жер
Dialogue: 0,1:01:45.12,1:01:48.41,Default,,0,0,0,,Менің миссиям - Элизиум және бұл планета...
Dialogue: 0,1:01:48.50,1:01:52.79,Default,,0,0,0,,Ханзада Эндимион сізді бақылап отыру үшін
Dialogue: 0,1:01:54.04,1:01:56.80,Default,,0,0,0,,Мен де сенің қамқоршы діни қызметкеріңмін.
Dialogue: 0,1:01:56.88,1:01:59.55,Default,,0,0,0,,Менің қамқоршы діни қызметкерім?
Dialogue: 0,1:02:00.67,1:02:03.39,Default,,0,0,0,,Бұл планетаны киелі Элизиум жері қорғайды.
Dialogue: 0,1:02:03.93,1:02:06.76,Default,,0,0,0,,Менің өмірім де Элизиуммен.
Dialogue: 0,1:02:07.81,1:02:11.14,Default,,0,0,0,,Ханзада, бұл планета, Элизиум және мен
Dialogue: 0,1:02:11.77,1:02:13.90,Default,,0,0,0,,Төрт ақыл мен дене байланысқан
Dialogue: 0,1:02:13.98,1:02:16.73,Default,,0,0,0,,Олар бір-бірімен резонанс тудыруға арналған.
Dialogue: 0,1:02:17.32,1:02:18.11,Default,,0,0,0,,көрінгендей, шамамен 36 дана шығады.
Dialogue: 0,1:02:18.73,1:02:22.07,Default,,0,0,0,,Міне, осылай болды...
Dialogue: 0,1:02:23.41,1:02:26.12,Default,,0,0,0,,Ха... кеудемде қара раушан гүл бар!
Dialogue: 0,1:02:26.20,1:02:28.08,Default,,0,0,0,,Ах! Мамо-чан!
Dialogue: 0,1:02:28.66,1:02:32.04,Default,,0,0,0,,Мына қарғыс атқан қара раушан менің де жүрегімде...
Dialogue: 0,1:02:33.04,1:02:36.13,Default,,0,0,0,,Бұл Элизийдің эрозияға ұшырауының белгісі.
Dialogue: 0,1:02:36.21,1:02:39.84,Default,,0,0,0,,Ханзада мен сияқты қарғысқа ұшырады.
Dialogue: 0,1:02:39.92,1:02:41.84,Default,,0,0,0,,Ал менің денем...
Dialogue: 0,1:02:42.80,1:02:46.26,Default,,0,0,0,,Енді тағы бір қарғыстың кесірінен мен Пегас кейпіне айналдым.
Dialogue: 0,1:02:47.10,1:02:49.56,Default,,0,0,0,,Ол Элизиумда түрмеде отыр.
Dialogue: 0,1:02:51.14,1:02:54.56,Default,,0,0,0,,Жаңа айдың қараңғылығында мөрленген патшалық⸺
Dialogue: 0,1:02:55.06,1:02:58.32,Default,,0,0,0,,Өлі Айдың ханшайымы Нехеления
Dialogue: 0,1:02:58.40,1:03:00.07,Default,,0,0,0,,Өлі ай!
Dialogue: 0,1:03:00.86,1:03:03.28,Default,,0,0,0,,Ақ ай патшалығы⸺
Dialogue: 0,1:03:03.36,1:03:05.99,Default,,0,0,0,,Күміс мыңжылдықтың құлдырауымен
Dialogue: 0,1:03:06.07,1:03:09.37,Default,,0,0,0,,Нехеленияны жауып тастаған күш әлсіреді.
Dialogue: 0,1:03:10.41,1:03:12.58,Default,,0,0,0,,Нехеления қайта жандануда.
Dialogue: 0,1:03:12.66,1:03:14.46,Default,,0,0,0,,Элизийді қарғыс
Dialogue: 0,1:03:15.17,1:03:18.59,Default,,0,0,0,,Күннің толық тұтылуының әдемі, бірақ қарғыс атқан сәтінде
Dialogue: 0,1:03:18.67,1:03:21.38,Default,,0,0,0,,Ол жерге енді.
Dialogue: 0,1:03:23.76,1:03:25.47,Default,,0,0,0,,Тыныштық ханшайымы
Dialogue: 0,1:03:25.55,1:03:27.93,Default,,0,0,0,,Супер Сейлор Мун жоқ
Dialogue: 0,1:03:28.60,1:03:33.02,Default,,0,0,0,,Өтінемін, күміс кристалдың және алтын кристалдың күшімен,
Dialogue: 0,1:03:33.10,1:03:35.85,Default,,0,0,0,,Бәрімізді осы қорқынышты түстен құтқара гөр.
Dialogue: 0,1:03:35.94,1:03:36.98,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:38.65,1:03:39.77,Default,,0,0,0,,Элиос…
Dialogue: 0,1:03:39.86,1:03:41.73,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,1:03:42.94,1:03:44.70,Default,,0,0,0,,Менен аулақ болғаныңыз жөн
Dialogue: 0,1:03:44.78,1:03:45.45,Default,,0,0,0,,А...
Dialogue: 0,1:03:46.41,1:03:49.12,Default,,0,0,0,,Бұл қарғыс берілуі мүмкін
Dialogue: 0,1:03:49.20,1:03:50.08,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:50.66,1:03:51.83,Default,,0,0,0,,Мен сенің жаныңдамын
Dialogue: 0,1:03:52.79,1:03:55.46,Default,,0,0,0,,Осы планетаның азабын түсіну үшін...
Dialogue: 0,1:03:56.75,1:03:59.96,Default,,0,0,0,,Сенің азабың – менің азабым!
Dialogue: 0,1:04:03.01,1:04:06.09,Default,,0,0,0,,Мен сені міндетті түрде емдеймін!
Dialogue: 0,1:04:07.55,1:04:10.85,Default,,0,0,0,,Ендеше қандай жағдай болмасын сенімен бірге болуға рұқсат ет.
Dialogue: 0,1:04:11.51,1:04:13.60,Default,,0,0,0,,Айтайын, қолымыздан келгенді бірге жасайық!
Dialogue: 0,1:04:13.68,1:04:14.77,Default,,0,0,0,,Қоян...
Dialogue: 0,1:04:14.85,1:04:16.73,Default,,0,0,0,,Бұл жұлдызды міндетті түрде алыңыз
Dialogue: 0,1:04:16.81,1:04:19.77,Default,,0,0,0,,Бұл адам... Мен барлығын қорғаймын.
Dialogue: 0,1:04:23.32,1:04:24.44,Default,,0,0,0,,Элиос…
Dialogue: 0,1:04:27.66,1:04:30.03,Default,,0,0,0,,Жерді өлі айдан қалай құтқарамыз
Dialogue: 0,1:04:30.12,1:04:32.41,Default,,0,0,0,,Сізге алтын кристалл керек пе?
Dialogue: 0,1:04:32.49,1:04:34.24,Default,,0,0,0,,Жер ғана емес
Dialogue: 0,1:04:34.33,1:04:36.16,Default,,0,0,0,,Мамору-сан да, Элизиум да
Dialogue: 0,1:04:36.25,1:04:38.12,Default,,0,0,0,,Элиос та...
Dialogue: 0,1:04:38.83,1:04:42.04,Default,,0,0,0,,Енді бесеуміз қоянға көмектесеміз.
Dialogue: 0,1:04:42.13,1:04:44.21,Default,,0,0,0,,Біз Мамору-санды қорғап, соғысуымыз керек.
Dialogue: 0,1:04:44.30,1:04:45.38,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:45.46,1:04:46.47,Default,,0,0,0,,Иә.
Dialogue: 0,1:04:47.01,1:04:47.93,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:04:49.43,1:04:50.64,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:04:52.14,1:04:54.43,Default,,0,0,0,,Ха ха! Хехехехе!
Dialogue: 0,1:04:55.68,1:04:59.40,Default,,0,0,0,,Венера планетасының қуатты макияжы!
Dialogue: 0,1:05:02.48,1:05:04.90,Default,,0,0,0,,Иә, мен бәріне айтқан жоқпын.
Dialogue: 0,1:05:04.98,1:05:07.15,Default,,0,0,0,,Мен өзгерте алмаймын.
Dialogue: 0,1:05:07.82,1:05:09.66,Default,,0,0,0,,Дүрбелеңнің қажеті жоқ!
Dialogue: 0,1:05:09.74,1:05:10.82,Default,,0,0,0,,Өйткені
Dialogue: 0,1:05:10.91,1:05:13.33,Default,,0,0,0,,Сіз Теңізші Сеншінің басшысысыз!
Dialogue: 0,1:05:13.41,1:05:16.45,Default,,0,0,0,,Бұл туралы уайымдаудың еш пайдасы жоқ.
Dialogue: 0,1:05:17.41,1:05:19.71,Default,,0,0,0,,Жуынуға барайық.
Dialogue: 0,1:05:19.79,1:05:21.67,Default,,0,0,0,,Иә, бұл дәлел.
Dialogue: 0,1:05:21.75,1:05:25.34,Default,,0,0,0,,Мина, сен соңғы кездері әлдеқайда әдемі болып кетіпсің.
Dialogue: 0,1:05:26.42,1:05:30.26,Default,,0,0,0,,Венера құдайына жақындағандай
Dialogue: 0,1:05:31.68,1:05:32.89,Default,,0,0,0,,Көшбасшы?
Dialogue: 0,1:05:33.47,1:05:34.43,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,1:05:34.51,1:05:36.81,Default,,0,0,0,,Мен барлығына көшбасшы болдым, солай ма?
Dialogue: 0,1:05:42.60,1:05:43.94,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:05:44.02,1:05:47.94,Default,,0,0,0,,Өзгерте алмайтын бір матрос Сенши бар.
Dialogue: 0,1:05:48.03,1:05:48.94,Default,,0,0,0,,Иә!
Dialogue: 0,1:05:49.03,1:05:51.95,Default,,0,0,0,,Барлық әлемде мисо-чан бар.
Dialogue: 0,1:05:52.03,1:05:54.45,Default,,0,0,0,,Цирк шоуларынан шаршадым.
Dialogue: 0,1:05:54.53,1:05:55.74,Default,,0,0,0,,Осыны пайдаланыңыз
Dialogue: 0,1:05:55.83,1:05:58.12,Default,,0,0,0,,Көңілді шара өткіземіз бе?
Dialogue: 0,1:05:58.20,1:05:59.33,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,1:05:59.41,1:06:01.87,Default,,0,0,0,,Xenotime! Цеолит!
Dialogue: 0,1:06:03.25,1:06:05.79,Default,,0,0,0,,Оны бізге қалдырыңыз, ханымдар.
Dialogue: 0,1:06:05.88,1:06:09.34,Default,,0,0,0,,Біз қабілетсіз Amazon триосы емеспіз.
Dialogue: 0,1:06:09.42,1:06:11.26,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,1:06:13.22,1:06:16.01,Default,,0,0,0,,Ах~ Шикаши, өте ыстық.
Dialogue: 0,1:06:16.10,1:06:19.35,Default,,0,0,0,,Әйтеуір, көшелер қаңырап қалды.
Dialogue: 0,1:06:19.43,1:06:20.98,Default,,0,0,0,,Жоқ, ұрыс?
Dialogue: 0,1:06:21.06,1:06:22.31,Default,,0,0,0,,Эй!
Dialogue: 0,1:06:22.39,1:06:24.98,Default,,0,0,0,,Ыстық кезде мен тітіркенемін.
Dialogue: 0,1:06:28.28,1:06:30.07,Default,,0,0,0,,О? Бұл...
Dialogue: 0,1:06:30.15,1:06:31.86,Default,,0,0,0,,Мичиру айнасы
Dialogue: 0,1:06:31.95,1:06:33.53,Default,,0,0,0,,Мен оны Чибиусадан алдым.
Dialogue: 0,1:06:34.53,1:06:37.24,Default,,0,0,0,,Соңғы кездері мен мазасызданып жүрмін.
Dialogue: 0,1:06:37.33,1:06:39.04,Default,,0,0,0,,Осы Мичиру-санның айнасында
Dialogue: 0,1:06:39.12,1:06:41.54,Default,,0,0,0,,Бір оғаш нәрсенің себебін білсем ғой.
Dialogue: 0,1:06:41.62,1:06:46.00,Default,,0,0,0,,Цирк тобының айналасында орналасқан Джубанды біртүрлі сезім билейді.
Dialogue: 0,1:06:46.59,1:06:48.42,Default,,0,0,0,,Кедергіден басқа миды жуу толқындары да бар...
Dialogue: 0,1:06:48.50,1:06:49.88,Default,,0,0,0,,Тосқауыл?
Dialogue: 0,1:06:49.96,1:06:52.42,Default,,0,0,0,,Менің ойымша, сондықтан мен өзгере алмаймын ...
Dialogue: 0,1:06:52.51,1:06:53.51,Default,,0,0,0,,Мина?
Dialogue: 0,1:06:53.59,1:06:55.55,Default,,0,0,0,,А, уһ, ештеңе!
Dialogue: 0,1:06:55.64,1:06:58.72,Default,,0,0,0,,Ами-чан, мен сол тосқауыл бойынша деректерді өзім зерттедім.
Dialogue: 0,1:06:58.81,1:06:59.52,Default,,0,0,0,,Керемет!
Dialogue: 0,1:06:59.60,1:07:02.77,Default,,0,0,0,,Иә, маған Сецуна-сан берген бағдарламамен.
Dialogue: 0,1:07:02.85,1:07:04.44,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,1:07:04.52,1:07:06.19,Default,,0,0,0,,Тікұшақтың дыбысын естігенде
Dialogue: 0,1:07:06.27,1:07:08.65,Default,,0,0,0,,Бұл маған Харуканы және басқаларды еске түсіреді.
Dialogue: 0,1:07:09.44,1:07:11.49,Default,,0,0,0,,Харука-сан сияқты тікұшақ және басқалар...
Dialogue: 0,1:07:11.57,1:07:12.61,Default,,0,0,0,,5 рет
Dialogue: 0,1:07:12.70,1:07:13.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:13.65,1:07:16.32,Default,,0,0,0,,Осы үш есімнің бүгін неше рет келгені
Dialogue: 0,1:07:16.41,1:07:17.70,Default,,0,0,0,,барлығы 5 рет
Dialogue: 0,1:07:18.58,1:07:21.08,Default,,0,0,0,,Мұнда жоқ адамдар туралы ойлаудың пайдасы жоқ деп ойлаймын!
Dialogue: 0,1:07:21.16,1:07:22.04,Default,,0,0,0,,Мина?
Dialogue: 0,1:07:22.12,1:07:24.79,Default,,0,0,0,,Үш адамға сенуге болады дейді.
Dialogue: 0,1:07:26.25,1:07:28.25,Default,,0,0,0,,Мен бәрібір сенімсіз көшбасшымын!
Dialogue: 0,1:07:28.34,1:07:30.59,Default,,0,0,0,,Сіз бұлай айтқан жоқсыз.
Dialogue: 0,1:07:30.67,1:07:32.51,Default,,0,0,0,,Мина... Бүгін біртүрлі.
Dialogue: 0,1:07:33.38,1:07:34.80,Default,,0,0,0,,Бәрібір біртүрлі!
Dialogue: 0,1:07:34.88,1:07:37.72,Default,,0,0,0,,Біртүрлі болған дұрыс!
Dialogue: 0,1:07:38.39,1:07:39.39,Default,,0,0,0,,Мина!
Dialogue: 0,1:07:39.97,1:07:41.72,Default,,0,0,0,,О, бұл сұмдық!
Dialogue: 0,1:07:41.81,1:07:43.93,Default,,0,0,0,,Бұл мені көшбасшы ретінде айырады!
Dialogue: 0,1:07:46.02,1:07:47.31,Default,,0,0,0,,(Мұрынды шұқылау дыбысы)
Dialogue: 0,1:07:47.40,1:07:48.65,Default,,0,0,0,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,1:07:48.73,1:07:51.15,Default,,0,0,0,,Сіз кумирді тыңдағыңыз келе ме?
Dialogue: 0,1:07:52.61,1:07:55.03,Default,,0,0,0,,Мина! Сіз не ойлап отырсыз?
Dialogue: 0,1:07:55.11,1:07:56.70,Default,,0,0,0,,Сіз жалғыз отыруды жоспарлап отырсыз ба?
Dialogue: 0,1:07:56.78,1:07:58.28,Default,,0,0,0,,Мен өзгере алмасам да
Dialogue: 0,1:07:58.37,1:07:59.58,Default,,0,0,0,,О? Біреуге ғашық болдың ба?
Dialogue: 0,1:07:59.66,1:08:00.28,Default,,0,0,0,,Мугага...
Dialogue: 0,1:08:00.37,1:08:01.33,Default,,0,0,0,,Мен де
Dialogue: 0,1:08:01.41,1:08:03.45,Default,,0,0,0,,Менің білетінім - бұл Өлі Айдың тұзағы.
Dialogue: 0,1:08:04.16,1:08:06.58,Default,,0,0,0,,Мен көшбасшымын, маған әрекет етсе болғаны!
Dialogue: 0,1:08:07.17,1:08:08.46,Default,,0,0,0,,Теңізші Венера
Dialogue: 0,1:08:08.54,1:08:11.80,Default,,0,0,0,,Мен сізге қызық үшін де, пайда үшін де күресуге рұқсат етемін!
Dialogue: 0,1:08:17.80,1:08:19.01,Default,,0,0,0,,Баршаңыз!
Dialogue: 0,1:08:19.09,1:08:20.10,Default,,0,0,0,,Олай болса
Dialogue: 0,1:08:20.18,1:08:23.35,Default,,0,0,0,,Тыңдау өтетін шатырдың ішіне кіріңіз!
Dialogue: 0,1:08:23.43,1:08:25.14,Default,,0,0,0,,​​Джунгли?
Dialogue: 0,1:08:25.93,1:08:27.52,Default,,0,0,0,,Енді аман қалу тыңдалымы.
Dialogue: 0,1:08:27.60,1:08:28.90,Default,,0,0,0,,Бастау!
Dialogue: 0,1:08:28.98,1:08:31.69,Default,,0,0,0,,Бұл тыңдау оқиғаға негізделген.
Dialogue: 0,1:08:31.77,1:08:34.03,Default,,0,0,0,,Әр адам батырға айналып, джунглиден өтеді.
Dialogue: 0,1:08:34.11,1:08:37.20,Default,,0,0,0,,Сол мұнарадағы балаларды құтқарыңдар!
Dialogue: 0,1:08:37.28,1:08:39.24,Default,,0,0,0,,Балалар осындай жерде!
Dialogue: 0,1:08:39.32,1:08:42.03,Default,,0,0,0,,Бірінші орын 5 миллион иен мөлшерінде сыйлық алады.
Dialogue: 0,1:08:42.12,1:08:44.24,Default,,0,0,0,,Idol дебютіне кепілдік беріледі!
Dialogue: 0,1:08:44.33,1:08:45.83,Default,,0,0,0,,Бастайық!
Dialogue: 0,1:08:46.66,1:08:49.67,Default,,0,0,0,,Иә! Барған сайын көбірек энергияны босатыңыз
Dialogue: 0,1:08:49.75,1:08:52.38,Default,,0,0,0,,Бұл энергия және сіздің армандарыңыз
Dialogue: 0,1:08:52.46,1:08:55.05,Default,,0,0,0,,Ремрес оны қорқынышты түске айналдырады.
Dialogue: 0,1:08:55.84,1:08:58.22,Default,,0,0,0,,Барлығыңыз тынышталыңыздар! Эй, эй!
Dialogue: 0,1:08:58.30,1:08:59.09,Default,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,1:08:59.18,1:09:00.59,Default,,0,0,0,,Біз кумирге айналамыз!
Dialogue: 0,1:09:02.89,1:09:03.76,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:09:03.85,1:09:04.68,Default,,0,0,0,,Ха!
Dialogue: 0,1:09:08.10,1:09:09.02,Default,,0,0,0,,Ха!
Dialogue: 0,1:09:10.35,1:09:11.40,Default,,0,0,0,,Юпитер!
Dialogue: 0,1:09:11.48,1:09:13.61,Default,,0,0,0,,Мина! Бізде енді ондай ештеңе жоқ!
Dialogue: 0,1:09:13.69,1:09:14.61,Default,,0,0,0,,Иә!
Dialogue: 0,1:09:14.69,1:09:16.69,Default,,0,0,0,,Отырғызу кезінде барлығы бірге!
Dialogue: 0,1:09:16.78,1:09:19.28,Default,,0,0,0,,Марс! Меркурий!
Dialogue: 0,1:09:19.36,1:09:20.66,Default,,0,0,0,,Кекекеке…
Dialogue: 0,1:09:20.74,1:09:21.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:21.66,1:09:23.12,Default,,0,0,0,,Минаны өзгерту!
Dialogue: 0,1:09:24.62,1:09:28.62,Default,,0,0,0,,Венера планетасының қуатты макияжы!
Dialogue: 0,1:09:29.25,1:09:29.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:29.96,1:09:30.96,Default,,0,0,0,,Мина?
Dialogue: 0,1:09:31.92,1:09:34.96,Default,,0,0,0,,Жоқ, мен өзгере алмаймын!
Dialogue: 0,1:09:35.05,1:09:36.34,Default,,0,0,0,,Алға!
Dialogue: 0,1:09:36.42,1:09:38.09,Default,,0,0,0,,Мина!
Dialogue: 0,1:09:38.17,1:09:39.76,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:09:41.14,1:09:41.89,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:09:41.97,1:09:43.89,Default,,0,0,0,,Кекекеке!
Dialogue: 0,1:09:43.97,1:09:47.14,Default,,0,0,0,,Әр адамның таза арманын қалай пайдалануға болады?
Dialogue: 0,1:09:47.22,1:09:48.18,Default,,0,0,0,,Мен оларды кешіре алмаймын!
Dialogue: 0,1:09:48.27,1:09:49.35,Default,,0,0,0,,Мина!
Dialogue: 0,1:09:50.27,1:09:54.15,Default,,0,0,0,,Тыңдауға қатыспайтын адамдар бар сияқты.
Dialogue: 0,1:09:54.23,1:09:55.48,Default,,0,0,0,,Егер сіз нашар қозғалсаңыз
Dialogue: 0,1:09:55.57,1:10:00.61,Default,,0,0,0,,Мен өзгере алмайтын достарыңның өміріне кепілдік бере алмаймын.
Dialogue: 0,1:10:00.70,1:10:02.41,Default,,0,0,0,,Келіңдер, Лемурлар.
Dialogue: 0,1:10:02.49,1:10:05.62,Default,,0,0,0,,Теңізші Сенши жеп қойды!
Dialogue: 0,1:10:05.70,1:10:06.79,Default,,0,0,0,,Ахахха!
Dialogue: 0,1:10:06.87,1:10:08.58,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:11.25,1:10:14.63,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,1:10:14.71,1:10:15.54,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:10:15.63,1:10:16.88,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,1:10:17.63,1:10:18.59,Default,,0,0,0,,Кекекеке…
Dialogue: 0,1:10:18.67,1:10:20.51,Default,,0,0,0,,Жоқ! Алақай!
Dialogue: 0,1:10:24.60,1:10:25.68,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,1:10:25.76,1:10:28.18,Default,,0,0,0,,Көптеген кедергілерден өтті
Dialogue: 0,1:10:28.27,1:10:31.14,Default,,0,0,0,,Сіз бұған дейін бірінші орында келдіңіз.
Dialogue: 0,1:10:31.77,1:10:34.06,Default,,0,0,0,,Енді кумир болуға бір қадам жақындады
Dialogue: 0,1:10:34.15,1:10:37.57,Default,,0,0,0,,Соңында, біз сізге арнайы қазына іздеуді ұсынамыз.
Dialogue: 0,1:10:39.28,1:10:40.49,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:10:41.40,1:10:43.03,Default,,0,0,0,,Мен өзімді ессіз сезінемін...
Dialogue: 0,1:10:43.74,1:10:44.87,Default,,0,0,0,,Хехехе
Dialogue: 0,1:10:44.95,1:10:47.53,Default,,0,0,0,,Сіз енді Өлі Айдың мүшесісіз.
Dialogue: 0,1:10:48.33,1:10:51.04,Default,,0,0,0,,Енді достарыңызға барыңыз
Dialogue: 0,1:10:51.12,1:10:53.79,Default,,0,0,0,,Күміс кристалды алып тастаңыз!
Dialogue: 0,1:10:53.87,1:10:56.38,Default,,0,0,0,,Фантомдық күміс кристалы
Dialogue: 0,1:10:56.46,1:10:59.80,Default,,0,0,0,,Қолымызда, Өлі Ай...
Dialogue: 0,1:10:59.88,1:11:00.80,Default,,0,0,0,,Тағы да оралып келдім
Dialogue: 0,1:11:00.88,1:11:02.05,Default,,0,0,0,,Няняняня…
Dialogue: 0,1:11:02.68,1:11:04.01,Default,,0,0,0,,Мықты бол, Мина!
Dialogue: 0,1:11:04.93,1:11:05.93,Default,,0,0,0,,Артемида?
Dialogue: 0,1:11:06.01,1:11:06.85,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:11:08.68,1:11:09.85,Default,,0,0,0,,Өтірік!
Dialogue: 0,1:11:09.93,1:11:10.77,Default,,0,0,0,,Мияу!
Dialogue: 0,1:11:12.77,1:11:13.77,Default,,0,0,0,,Артемида!
Dialogue: 0,1:11:14.35,1:11:17.31,Default,,0,0,0,,Жоқ... қолым үзіліп кететін сияқты!
Dialogue: 0,1:11:18.40,1:11:21.49,Default,,0,0,0,,Маған да осы жерде көңіл көтеруіңізді өтінемін.
Dialogue: 0,1:11:22.36,1:11:23.24,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:11:27.41,1:11:28.87,Default,,0,0,0,,Артемида!
Dialogue: 0,1:11:30.95,1:11:32.37,Default,,0,0,0,,Артемида…
Dialogue: 0,1:11:34.25,1:11:37.58,Default,,0,0,0,,Менің бүкіл денем қатты ауырады
Dialogue: 0,1:11:37.67,1:11:40.50,Default,,0,0,0,,Қатты ауырып тұр, Артемида!
Dialogue: 0,1:11:40.59,1:11:43.84,Default,,0,0,0,,Сен менімен әрқашан бірсің.
Dialogue: 0,1:11:43.92,1:11:45.76,Default,,0,0,0,,Ол менің альтер эго болды!
Dialogue: 0,1:11:52.81,1:11:54.27,Default,,0,0,0,,(Норияки Какёин) Бұл бөлмедегі қиратулар барған сайын тереңдей түсуде.
Dialogue: 0,1:11:55.31,1:11:58.02,Default,,0,0,0,,Мина, сен өзгере алмадың.
Dialogue: 0,1:11:59.57,1:12:02.99,Default,,0,0,0,,Менің серігім, күшім жетпегендіктен!
Dialogue: 0,1:12:03.57,1:12:05.11,Default,,0,0,0,,Артемида?
Dialogue: 0,1:12:05.74,1:12:06.61,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:12:08.37,1:12:10.74,Default,,0,0,0,,Денемді қуат толтырады
Dialogue: 0,1:12:11.41,1:12:14.87,Default,,0,0,0,,Біз бұрынғыдан әлдеқайда көп байланыстамыз.
Dialogue: 0,1:12:14.96,1:12:17.00,Default,,0,0,0,,Мен және Артемида...
Dialogue: 0,1:12:22.96,1:12:25.63,Default,,0,0,0,,Бұл сіздің Венера Кристаллыңыз, Мина.
Dialogue: 0,1:12:26.63,1:12:28.59,Default,,0,0,0,,Енді түрленейік!
Dialogue: 0,1:12:30.89,1:12:33.27,Default,,0,0,0,,Венераның кристалдық күші
Dialogue: 0,1:12:33.35,1:12:35.02,Default,,0,0,0,,Макияж!
Dialogue: 0,1:13:03.13,1:13:04.71,Default,,0,0,0,,Сұлулық жұлдызы!
Dialogue: 0,1:13:04.80,1:13:07.76,Default,,0,0,0,,Венера өзінің қамқоршысы болған махаббат жауынгері!
Dialogue: 0,1:13:07.84,1:13:09.59,Default,,0,0,0,,Теңізші Венера!
Dialogue: 0,1:13:10.39,1:13:14.06,Default,,0,0,0,,Махаббаттың илаһи жазасынан бас тартамын!
Dialogue: 0,1:13:14.60,1:13:16.02,Default,,0,0,0,,Венера!
Dialogue: 0,1:13:16.10,1:13:17.77,Default,,0,0,0,,Артемида!
Dialogue: 0,1:13:17.85,1:13:19.40,Default,,0,0,0,,Бар!
Dialogue: 0,1:13:19.48,1:13:21.36,Default,,0,0,0,,Ал, мына Венера.
Dialogue: 0,1:13:21.44,1:13:24.82,Default,,0,0,0,,Сен мені қатты қинадың, қоқыс сияқты қарадың!
Dialogue: 0,1:13:24.90,1:13:28.78,Default,,0,0,0,,Венера құдайының махаббат қамшысын қабыл алыңыздар!
Dialogue: 0,1:13:29.49,1:13:30.45,Default,,0,0,0,,Венера!
Dialogue: 0,1:13:32.95,1:13:33.58,Default,,0,0,0,,Уау
Dialogue: 0,1:13:35.58,1:13:38.54,Default,,0,0,0,,Махаббат пен сұлулық соққысы!
Dialogue: 0,1:13:38.62,1:13:39.87,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:39.96,1:13:42.04,Default,,0,0,0,,Гяаа!
Dialogue: 0,1:13:42.13,1:13:44.00,Default,,0,0,0,,Бар!
Dialogue: 0,1:13:47.09,1:13:48.01,Default,,0,0,0,,Әй!
Dialogue: 0,1:13:48.09,1:13:49.76,Default,,0,0,0,,Ахх!
Dialogue: 0,1:13:49.84,1:13:51.72,Default,,0,0,0,,Гяаа!
Dialogue: 0,1:13:55.14,1:13:56.10,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:13:56.18,1:13:57.68,Default,,0,0,0,,Венера!
Dialogue: 0,1:13:57.77,1:13:59.02,Default,,0,0,0,,Сіз өзгере алдыңыз!
Dialogue: 0,1:13:59.10,1:14:00.81,Default,,0,0,0,,Барлығыңызды кешіріңіз!
Dialogue: 0,1:14:00.89,1:14:02.52,Default,,0,0,0,,Бірақ бәрібір!
Dialogue: 0,1:14:03.81,1:14:05.02,Default,,0,0,0,,Керемет!
Dialogue: 0,1:14:05.11,1:14:08.53,Default,,0,0,0,,Артемида, мұның бәрі сенің арқаң.
Dialogue: 0,1:14:09.11,1:14:10.03,Default,,0,0,0,,Мина…
Dialogue: 0,1:14:10.11,1:14:11.24,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:14:11.32,1:14:13.32,Default,,0,0,0,,Керемет оқиға!
Dialogue: 0,1:14:13.41,1:14:16.54,Default,,0,0,0,,Бұл Amazon квартеті оны жандандырады!
Dialogue: 0,1:14:16.62,1:14:17.58,Default,,0,0,0,,Парапара!
Dialogue: 0,1:14:17.66,1:14:19.04,Default,,0,0,0,,Вагон тежегішті басады!
Dialogue: 0,1:14:19.12,1:14:20.71,Default,,0,0,0,,Тамаказура!
Dialogue: 0,1:14:21.37,1:14:23.00,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,1:14:23.08,1:14:24.00,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:26.67,1:14:27.50,Default,,0,0,0,,Хехе
Dialogue: 0,1:14:27.59,1:14:31.43,Default,,0,0,0,,Біз Амазонкадағы аты аңызға айналған ең мықты жауынгерміз.
Dialogue: 0,1:14:31.51,1:14:33.26,Default,,0,0,0,,Менде амазониялық қан бар...
Dialogue: 0,1:14:33.34,1:14:35.35,Default,,0,0,0,,Амазонка квартеті!
Dialogue: 0,1:14:35.43,1:14:37.93,Default,,0,0,0,,Amazon квартеті?
Dialogue: 0,1:14:38.02,1:14:41.19,Default,,0,0,0,,Амазонка джунгли Амазонка тропикалық түні
Dialogue: 0,1:14:41.27,1:14:43.56,Default,,0,0,0,,Біз амазонкаларға беріледі⸺
Dialogue: 0,1:14:43.65,1:14:46.40,Default,,0,0,0,,Қарғыс атқан тас Амазонка тасы
Dialogue: 0,1:14:46.48,1:14:49.94,Default,,0,0,0,,Жаңа айдың қараңғылығы астында шын күшін танытқан адам
Dialogue: 0,1:14:50.03,1:14:51.86,Default,,0,0,0,,Бұдан былай
Dialogue: 0,1:14:51.95,1:14:53.86,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:14:53.95,1:14:54.87,Default,,0,0,0,,Уф...
Dialogue: 0,1:14:55.87,1:14:56.58,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:14:56.66,1:14:57.62,Default,,0,0,0,,Мина!
Dialogue: 0,1:14:57.70,1:15:00.66,Default,,0,0,0,,Көбірек, көбірек күш...
Dialogue: 0,1:15:01.46,1:15:05.50,Default,,0,0,0,,Жауды жеңу, өзің үшін маңыздыларды қорғау
Dialogue: 0,1:15:05.58,1:15:08.00,Default,,0,0,0,,Күш, жинал!
Dialogue: 0,1:15:08.09,1:15:08.75,Default,,0,0,0,,Ха…
Dialogue: 0,1:15:09.63,1:15:11.26,Default,,0,0,0,,Мен уайымдаймын
Dialogue: 0,1:15:11.97,1:15:14.51,Default,,0,0,0,,Мен бүгін түнде бір жұлдызды көре алмаймын.
Dialogue: 0,1:15:16.10,1:15:18.01,Default,,0,0,0,,Бұл да жаудың ісі ме?
Dialogue: 0,1:15:19.22,1:15:20.22,Default,,0,0,0,,Элиос…
Dialogue: 0,1:15:20.31,1:15:21.56,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:15:25.31,1:15:27.36,Default,,0,0,0,,Қоян, сен кешігіп қалдың.
Dialogue: 0,1:15:27.44,1:15:29.57,Default,,0,0,0,,Мамо-чанның жағдайы қалай?
Dialogue: 0,1:15:29.65,1:15:32.15,Default,,0,0,0,,Сузуха ше? Хмм?
Dialogue: 0,1:15:33.90,1:15:35.07,Default,,0,0,0,,Қоян?
Dialogue: 0,1:15:36.62,1:15:39.87,Default,,0,0,0,,Лорд Нехеления, ақыры осында.
Dialogue: 0,1:15:40.58,1:15:43.91,Default,,0,0,0,,Жиналған халықтың түнгі түндерінің күшімен
Dialogue: 0,1:15:44.00,1:15:47.88,Default,,0,0,0,,Бұл жұлдызды өлім жұлдызына айналдыр!
Dialogue: 0,1:15:51.17,1:15:53.17,Default,,0,0,0,,♪～
Dialogue: 0,1:19:32.31,1:19:34.31,Default,,0,0,0,,～♪
Dialogue: 0,1:19:34.40,1:19:37.19,Default,,0,0,0,,Шынында да, біраз аян жақын.
Dialogue: 0,1:19:38.86,1:19:41.69,Default,,0,0,0,,Шынында да, екінші келу уақыты жақын.
Dialogue: 0,1:19:42.90,1:19:46.66,Default,,0,0,0,,«Қайтару» Осы сөзді айтқан бойда
Dialogue: 0,1:19:47.32,1:19:50.16,Default,,0,0,0,,Дүниенің рухтарынан алынған алып бейне
Dialogue: 0,1:19:51.08,1:19:53.33,Default,,0,0,0,,Менің көзқарасымды бұзу
Dialogue: 0,1:19:54.83,1:20:00.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory