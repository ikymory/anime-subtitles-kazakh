Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.34,0:00:37.21,Default,,0,0,0,,♪♪ (Тақырыпты ашу)
Dialogue: 0,0:00:37.21,0:00:55.86,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:55.86,0:00:57.89,Default,,0,0,0,,♪♪ оны қайтар, эй, рок-н-ролл!!!
Dialogue: 0,0:00:57.89,0:01:10.37,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:10.37,0:01:16.18,Default,,0,0,0,,♪♪ өмір жалғасуда Мен аз ғана үмітке қанағаттандым
Dialogue: 0,0:01:16.18,0:01:21.48,Default,,0,0,0,,♪♪ Егер мен күткенімде, менің болашағымды біреу шешер еді.
Dialogue: 0,0:01:21.48,0:01:23.82,Default,,0,0,0,,♪♪ (тек сізді қайтарып, оны қайта қосу керек)
Dialogue: 0,0:01:23.82,0:01:27.32,Default,,0,0,0,,♪♪ Мен қаншалықты кішкентаймын?
Dialogue: 0,0:01:27.32,0:01:28.99,Default,,0,0,0,,♪♪ бұзыңыз! (Міне, 1, 2)
Dialogue: 0,0:01:28.99,0:01:31.03,Default,,0,0,0,,♪♪ оны жоғары жылжытып, сындырыңыз!
Dialogue: 0,0:01:31.03,0:01:33.86,Default,,0,0,0,,♪♪ Енді арманымызға жүгірейік
Dialogue: 0,0:01:33.86,0:01:37.33,Default,,0,0,0,,♪♪（қайтарыңыз, дәл уақыт келді, эй балам, рок-н-ролл）
Dialogue: 0,0:01:37.33,0:01:40.24,Default,,0,0,0,,♪♪ Gamble, сізде Rumble жасау мүмкіндігі болуы керек!
Dialogue: 0,0:01:40.24,0:01:43.21,Default,,0,0,0,,♪♪ Соңғы минуттық кезең (иә!)
Dialogue: 0,0:01:43.21,0:01:46.68,Default,,0,0,0,,♪♪ Құмар ойыны, сіз скреблге сүңгіңіз!
Dialogue: 0,0:01:46.68,0:01:49.58,Default,,0,0,0,,♪♪ Кішкене болса да ойланбастан (тексеріңіз!)
Dialogue: 0,0:01:49.58,0:01:54.35,Default,,0,0,0,,♪♪ Негізінде, қорғауды қажет ететін дүниелер көп емес.
Dialogue: 0,0:01:54.35,0:01:56.19,Default,,0,0,0,,♪♪ (бұдан бас тарт!
Dialogue: 0,0:01:56.19,0:01:58.22,Default,,0,0,0,,♪♪ Кішкене күштірек бол
Dialogue: 0,0:01:58.22,0:02:01.96,Default,,0,0,0,,♪♪ Барлығы ойын ойнайтынына бәс тігейік!
Dialogue: 0,0:02:01.96,0:02:03.69,Default,,0,0,0,,♪♪ құмар ойнап көрейік эй джумбо
Dialogue: 0,0:02:03.69,0:02:05.46,Default,,0,0,0,,♪♪ енді кеудеңізді сілкіп, шуылдатыңыз
Dialogue: 0,0:02:05.46,0:02:06.96,Default,,0,0,0,,♪♪ Үш өткір сызық
Dialogue: 0,0:02:06.96,0:02:08.70,Default,,0,0,0,,♪♪ Мен қатты толқып тұрмын, Бамбук
Dialogue: 0,0:02:08.70,0:02:12.04,Default,,0,0,0,,♪♪ Көрініс қозғалысы Үш адам барлығы тыныш ұйықтап жатыр
Dialogue: 0,0:02:12.04,0:02:16.44,Default,,0,0,0,,♪♪ Мен «Жігіттер өте тітіркендіргішсің!» дегенді ести бердім.
Dialogue: 0,0:02:25.25,0:02:30.25,Default,,0,0,0,,(Жұмыстың соңы қоңырауы)
Dialogue: 0,0:02:33.96,0:02:36.86,Default,,0,0,0,,(Оқушылардың шуы)
Dialogue: 0,0:02:36.86,0:02:38.86,Default,,0,0,0,,Эй, сен шайханаға тоқтағың келе ме?
Dialogue: 0,0:02:38.86,0:02:40.86,Default,,0,0,0,,Жақсы, Нацуки ше?
Dialogue: 0,0:02:40.86,0:02:42.80,Default,,0,0,0,,≪Ой, кешіріңіз, менің толық емес жұмыс күнім бар.
Dialogue: 0,0:02:42.80,0:02:44.70,Default,,0,0,0,,≪(2-оқушы қыз) Иә? Нацукидің толық емес жұмыс уақыты бар ма?
Dialogue: 0,0:02:44.70,0:02:46.84,Default,,0,0,0,,≪(1-оқушы қыз) Таңқаларлық (Ер оқушы 1) Тамақ ішейік.
Dialogue: 0,0:02:46.84,0:02:49.14,Default,,0,0,0,,Иә? Әлі ашпадың ба?
Dialogue: 0,0:02:57.28,0:02:59.28,Default,,0,0,0,,≪(Цуки) Сәлем Такуми!
Dialogue: 0,0:03:00.58,0:03:03.12,Default,,0,0,0,,Ах Ицуки, бұл күндері жағдай қалай?
Dialogue: 0,0:03:03.12,0:03:07.09,Default,,0,0,0,,Бұл не? Бұл көлік. Бұл көлік. Бұл көлік.
Dialogue: 0,0:03:07.09,0:03:12.23,Default,,0,0,0,,Ах, мен өзімді жақсы сезінемін. Мен жақсы жүре бастадым.
Dialogue: 0,0:03:12.23,0:03:14.53,Default,,0,0,0,,Иә, қозғалтқышты ауыстырғаннан кейін.
Dialogue: 0,0:03:14.53,0:03:17.43,Default,,0,0,0,,Сіз «міну қиын» деп айттыңыз.
Dialogue: 0,0:03:17.43,0:03:21.44,Default,,0,0,0,,Мен тахометрді орнатқаннан бері ол күрт өзгерді.
Dialogue: 0,0:03:21.44,0:03:24.74,Default,,0,0,0,,Бұл жылдам. Менің көлігім...
Dialogue: 0,0:03:26.01,0:03:29.95,Default,,0,0,0,,Тексеріңіз, мен бұл жолды бір рет айтқым келеді.
Dialogue: 0,0:03:29.95,0:03:32.55,Default,,0,0,0,,Әй, келесі жолы тау асуында қасыңа мініп көрейін.
Dialogue: 0,0:03:32.55,0:03:35.85,Default,,0,0,0,,Жарайды, бірақ... қорқынышты. Бұл нені білдіреді? ол
Dialogue: 0,0:03:35.85,0:03:40.02,Default,,0,0,0,,Ес-түсіңді түсірме Әй, не айтып тұрсың, мына жігіт!
Dialogue: 0,0:03:40.02,0:03:42.62,Default,,0,0,0,,Соқ! Хехе хахахаха
Dialogue: 0,0:03:44.66,0:03:46.66,Default,,0,0,0,,《Такуми-кун》
Dialogue: 0,0:03:59.91,0:04:02.11,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:04:04.38,0:04:09.25,Default,,0,0,0,,(ұялы мотор дыбысы)
Dialogue: 0,0:04:09.25,0:04:12.52,Default,,0,0,0,,Иә? Такуми, сен не қарап тұрсың? (Икея) Иә?
Dialogue: 0,0:04:12.52,0:04:16.36,Default,,0,0,0,,Мм... сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:04:16.36,0:04:19.26,Default,,0,0,0,,Не? Икейя-сенпай -
Dialogue: 0,0:04:19.26,0:04:22.07,Default,,0,0,0,,Механикаға қарсы қалай күшті болдыңыз?
Dialogue: 0,0:04:22.07,0:04:24.80,Default,,0,0,0,,Иә? А... А?
Dialogue: 0,0:04:24.80,0:04:28.67,Default,,0,0,0,,Хмм, қалай сұрасаң да
Dialogue: 0,0:04:28.67,0:04:33.41,Default,,0,0,0,,Мен орта мектептен бастап мотоциклмен ойнадым.
Dialogue: 0,0:04:33.41,0:04:36.11,Default,,0,0,0,,Мен өз көлігімді сатып алып, онымен айналыса бастағанда
Dialogue: 0,0:04:36.11,0:04:38.68,Default,,0,0,0,,Барған сайын қызық болып барады.
Dialogue: 0,0:04:38.68,0:04:42.55,Default,,0,0,0,,Мен мұны білмей тұрып, мен механың жанкүйері болдым.
Dialogue: 0,0:04:42.55,0:04:46.29,Default,,0,0,0,,Такуми, сен мехаға қатты қызығасың.
Dialogue: 0,0:04:46.29,0:04:53.16,Default,,0,0,0,,Жоқ... Ақыры түсіндім, бірақ әйтеуір...
Dialogue: 0,0:04:53.16,0:04:57.80,Default,,0,0,0,,Мысалы, тахометрді бекітіп, қозғалтқыш жылдамдығын арттырсаңыз...
Dialogue: 0,0:04:57.80,0:05:01.44,Default,,0,0,0,,Тіпті машинаның өзі де мүлде өзгереді.
Dialogue: 0,0:05:01.44,0:05:05.78,Default,,0,0,0,,Мен көлік жүргізу тәсілі механизмге байланысты соншалықты өзгереді деп ойламаппын.
Dialogue: 0,0:05:05.78,0:05:09.61,Default,,0,0,0,,Жүргізушімен не істей алатыныңызға шектеулер бар.
Dialogue: 0,0:05:09.61,0:05:12.08,Default,,0,0,0,,Жылдамырақ болу үшін—
Dialogue: 0,0:05:12.08,0:05:15.08,Default,,0,0,0,,Түрлі білім алмасаң жақсы емес.
Dialogue: 0,0:05:15.08,0:05:17.32,Default,,0,0,0,,Мен бұл туралы шынымен ойладым.
Dialogue: 0,0:05:17.32,0:05:21.62,Default,,0,0,0,,Ухаха! Такуми оянды!
Dialogue: 0,0:05:21.62,0:05:25.03,Default,,0,0,0,,Ах! Қандай прогресс!
Dialogue: 0,0:05:25.03,0:05:28.53,Default,,0,0,0,,Шынында да, соңғы уақытқа дейін, шамамен жаз.
Dialogue: 0,0:05:28.53,0:05:31.43,Default,,0,0,0,,Мен оны «Хачироку» деп атайтынымды да білмедім.
Dialogue: 0,0:05:31.43,0:05:35.71,Default,,0,0,0,,Бірақ Акинаның құйрықты жұлдыз сияқты еңселі дебютінен кейін,
Dialogue: 0,0:05:35.71,0:05:37.97,Default,,0,0,0,,Бұл жеңісті серия болды.
Dialogue: 0,0:05:37.97,0:05:39.91,Default,,0,0,0,,Оны шайқаста алып шығу
Dialogue: 0,0:05:39.91,0:05:43.18,Default,,0,0,0,,Бәріміз де қиын күндерді бастан өткердік.
Dialogue: 0,0:05:43.18,0:05:47.78,Default,,0,0,0,,Иә, бұл қазір жақсы есте сақтау.
Dialogue: 0,0:05:51.62,0:05:55.02,Default,,0,0,0,,《Мен шайқастарды жек көремін, солай ма?》
Dialogue: 0,0:05:55.02,0:05:57.72,Default,,0,0,0,,《Қарғыс атсын…》 (Икейя) 《Иә...》
Dialogue: 0,0:06:06.40,0:06:08.40,Default,,0,0,0,,《Шаш қыстырғыш болса да, жылдамдығын төмендетпе? 》
Dialogue: 0,0:06:12.84,0:06:14.84,Default,,0,0,0,,《Не? Қазіргісі》
Dialogue: 0,0:06:18.55,0:06:22.25,Default,,0,0,0,,《Егер сізге қарсылық болса, оны қабылдау керек.''
Dialogue: 0,0:06:22.25,0:06:24.25,Default,,0,0,0,,Мен мұндай нәрсені жек көремін》
Dialogue: 0,0:06:27.46,0:06:30.26,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:06:36.67,0:06:39.17,Default,,0,0,0,,《Не...? Сырттан? 》
Dialogue: 0,0:06:41.57,0:06:44.57,Default,,0,0,0,,《Мен кез келген нәрсені істеймін, тіпті жабысқақ таспаның өлімі сәйкес келеді》
Dialogue: 0,0:06:47.98,0:06:50.18,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:06:52.82,0:06:55.72,Default,,0,0,0,,《Руль дөңгелегін мүмкіндігінше бұрмай бұру жылдамырақ па? 》
Dialogue: 0,0:06:57.15,0:07:00.75,Default,,0,0,0,,《Мені қалай өтіп кеткеніңді түсінбеймін! 》
Dialogue: 0,0:07:02.02,0:07:04.23,Default,,0,0,0,,《Бұл менің шайқасым, солай ма? 》
Dialogue: 0,0:07:04.23,0:07:06.93,Default,,0,0,0,,《Мен өзім үшін жүгіремін》
Dialogue: 0,0:07:11.93,0:07:14.53,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:07:17.41,0:07:21.71,Default,,0,0,0,,《Мен шайқастағы серіктес ретінде жеңе алмайтын үлкен дәрежедегі құбыжықты таңдадым》
Dialogue: 0,0:07:31.25,0:07:34.25,Default,,0,0,0,,《Ол әр шайқас сайын дамиды》
Dialogue: 0,0:07:44.37,0:07:47.20,Default,,0,0,0,,《Мм... Мен одан да жылдамырақ болдым...''
Dialogue: 0,0:07:47.20,0:07:50.11,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:07:50.11,0:07:55.41,Default,,0,0,0,,《Ха, Такуми Фудзивара, сен жылдам болдың. Тағы кездескенше》
Dialogue: 0,0:07:57.25,0:08:00.25,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:08:04.39,0:08:08.69,Default,,0,0,0,,Такуми шайқас сайын дамып отырады, солай ма?
Dialogue: 0,0:08:08.69,0:08:12.09,Default,,0,0,0,,Иә, олар бұл күндері әсіресе амбициялы.
Dialogue: 0,0:08:12.09,0:08:14.36,Default,,0,0,0,,Шынымен, ол тез өсуде ≪(көліктің жүгіру дыбысы)
Dialogue: 0,0:08:14.36,0:08:16.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.73,0:08:20.13,Default,,0,0,0,,Иә? ақ ФК
Dialogue: 0,0:08:22.91,0:08:24.91,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:08:26.21,0:08:29.95,Default,,0,0,0,,Әзірше менде жоғары октанды газдың толық резервуары болуы мүмкін бе?
Dialogue: 0,0:08:29.95,0:08:31.75,Default,,0,0,0,,Иә
Dialogue: 0,0:08:31.75,0:08:36.35,Default,,0,0,0,,Өйткені, бұл Акагидің Ақ кометасы, Риосуке Такахаши.
Dialogue: 0,0:08:36.35,0:08:38.45,Default,,0,0,0,,Жоғары октанға толы!
Dialogue: 0,0:08:41.19,0:08:43.46,Default,,0,0,0,,Мен сізбен бір нәрсе туралы сөйлескім келеді.
Dialogue: 0,0:08:43.46,0:08:45.43,Default,,0,0,0,,Не? (Икея) Иә?
Dialogue: 0,0:08:45.43,0:08:47.90,Default,,0,0,0,,Толық емес жұмыс уақытым біткен соң кездесе аламыз ба?
Dialogue: 0,0:08:47.90,0:08:50.73,Default,,0,0,0,,Менімен? Жақсы емес пе? —
Dialogue: 0,0:08:50.73,0:08:53.27,Default,,0,0,0,,Уақытым болмаса, қайта бастаймын.
Dialogue: 0,0:08:53.27,0:08:58.54,Default,,0,0,0,,Жоқ, бәрібір... Толық емес жұмысымды аяқтаған соң бос уақытым болады.
Dialogue: 0,0:08:58.54,0:09:02.28,Default,,0,0,0,,Жұмыс біткен соң маған қоңырау шалыңыз.
Dialogue: 0,0:09:02.28,0:09:05.51,Default,,0,0,0,,Бұл сіздің ұялы телефон нөміріңіз Иә.
Dialogue: 0,0:09:05.51,0:09:07.81,Default,,0,0,0,,Мен күтемін (көлік есігінің ашылған дыбысы)
Dialogue: 0,0:09:11.99,0:09:13.99,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:09:19.06,0:09:21.30,Default,,0,0,0,,Сәлем, Такуми!
Dialogue: 0,0:09:21.30,0:09:24.93,Default,,0,0,0,,Бұл не болды? Риосуке Такахашидің әңгімесі
Dialogue: 0,0:09:24.93,0:09:27.30,Default,,0,0,0,,А... Мен түсінбеймін.
Dialogue: 0,0:09:27.30,0:09:30.31,Default,,0,0,0,,А? Неге қызарып тұрсың?
Dialogue: 0,0:09:30.31,0:09:32.68,Default,,0,0,0,,Не? Жоқ, шынымен емес...
Dialogue: 0,0:09:32.68,0:09:36.18,Default,,0,0,0,,Мен оны шынымен түсінбеймін, бірақ ол көтеріліп жатыр.
Dialogue: 0,0:09:36.18,0:09:39.28,Default,,0,0,0,,Бұл адам жақындағанда не болады? (Икея, Ицуки)
Dialogue: 0,0:09:44.99,0:09:48.59,Default,,0,0,0,,Иә! Префектурадан тыс экспедициялық топ?
Dialogue: 0,0:09:48.59,0:09:50.49,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:51.49,0:09:55.36,Default,,0,0,0,,Осы аймақтан аздаған элита мүшелерін жинаңыз.
Dialogue: 0,0:09:55.36,0:09:57.37,Default,,0,0,0,,Префектураның сыртындағы тау асуына экспедиция.
Dialogue: 0,0:09:57.37,0:10:01.07,Default,,0,0,0,,Жергілікті жарысушылармен шайқас бастаңыз
Dialogue: 0,0:10:01.07,0:10:05.97,Default,,0,0,0,,Әртүрлі жерлерде курс рекордтарын жаңартып, аңыз қалдырып, таралу
Dialogue: 0,0:10:07.28,0:10:10.85,Default,,0,0,0,,Өкінішке орай, менің уақытым аз.
Dialogue: 0,0:10:10.85,0:10:14.32,Default,,0,0,0,,Менің ойымша, шектеу тағы бір жыл.
Dialogue: 0,0:10:14.32,0:10:17.92,Default,,0,0,0,,Осы уақытқа дейін мен бұл ойынның соңын көргім келеді.
Dialogue: 0,0:10:19.12,0:10:21.06,Default,,0,0,0,,Сөзге тікелей көшейік—
Dialogue: 0,0:10:21.06,0:10:24.56,Default,,0,0,0,,Мен сіздің техникаңызды қалаймын?
Dialogue: 0,0:10:24.56,0:10:27.86,Default,,0,0,0,,Біздің экспедиция тобына жүргізуші ретінде қосылғыңыз келе ме?
Dialogue: 0,0:10:27.86,0:10:29.80,Default,,0,0,0,,О... мен?
Dialogue: 0,0:10:29.80,0:10:34.17,Default,,0,0,0,,Сіз менің жеңісті сериямды аяқтаған адамсыз.
Dialogue: 0,0:10:34.17,0:10:37.67,Default,,0,0,0,,Әрине, бұл менің ойыным, сондықтан маған көмектесе алсаңыз...
Dialogue: 0,0:10:37.67,0:10:40.24,Default,,0,0,0,,Мен белгілі бір мөлшерде өтемақы бере алатыныма сенемін.
Dialogue: 0,0:10:40.24,0:10:42.18,Default,,0,0,0,,Сыйақы?
Dialogue: 0,0:10:42.18,0:10:47.02,Default,,0,0,0,,Сіз өзіңіздің талантыңыз бен сезіміңізбен осы уақытқа дейін жүгіруді жалғастырдыңыз.
Dialogue: 0,0:10:47.02,0:10:48.95,Default,,0,0,0,,Бірақ уақыт келді
Dialogue: 0,0:10:48.95,0:10:51.85,Default,,0,0,0,,Қабырғаға ұқсас нәрсені соғу керек.
Dialogue: 0,0:10:51.85,0:10:55.66,Default,,0,0,0,,Қабырғадан асып, оның үстіндегі аймаққа жету үшін —
Dialogue: 0,0:10:55.66,0:10:59.20,Default,,0,0,0,,Бізге дәл теориямен қамтамасыз етілген жүргізу стилі қажет.
Dialogue: 0,0:10:59.20,0:11:02.43,Default,,0,0,0,,«Жылдам болу үшін білім керек».
Dialogue: 0,0:11:02.43,0:11:06.27,Default,,0,0,0,,Оны өзіңіз байқай бастадыңыз ба?
Dialogue: 0,0:11:06.27,0:11:09.51,Default,,0,0,0,,Мен білемін, өйткені
Dialogue: 0,0:11:09.51,0:11:13.38,Default,,0,0,0,,Өйткені сен менің ағама өте ұқсас жүргізушісің.
Dialogue: 0,0:11:13.38,0:11:15.31,Default,,0,0,0,,Кейсукемен?
Dialogue: 0,0:11:15.31,0:11:19.12,Default,,0,0,0,,Егер сіз өзіңіздің табиғи талантыңызға теория қоссаңыз, сіз жеңілмейтінсіз.
Dialogue: 0,0:11:19.12,0:11:21.38,Default,,0,0,0,,Сізге ең қажет нәрсе—
Dialogue: 0,0:11:21.38,0:11:23.35,Default,,0,0,0,,Мен саған үйретемін
Dialogue: 0,0:11:23.35,0:11:26.92,Default,,0,0,0,,Мұндай нәрселерді үйренудің ең жақсы жолы - оны көлік жүргізу кезінде сезіну.
Dialogue: 0,0:11:26.92,0:11:29.83,Default,,0,0,0,,Бұл ең жақсы.
Dialogue: 0,0:11:29.83,0:11:31.76,Default,,0,0,0,,Бірге жасайық...
Dialogue: 0,0:11:31.76,0:11:35.20,Default,,0,0,0,,Бірден жауап берудің қажеті жоқ. Ойлан.
Dialogue: 0,0:11:35.20,0:11:37.20,Default,,0,0,0,,Иә
Dialogue: 0,0:11:42.74,0:11:45.24,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:11:45.24,0:11:47.34,Default,,0,0,0,,Жақсы жауап күту
Dialogue: 0,0:11:56.85,0:11:59.46,Default,,0,0,0,,Өзін-өзі жөндеуді айтарлықтай тиімсіз етеді.
Dialogue: 0,0:11:59.46,0:12:02.36,Default,,0,0,0,,Риосуке Такахаши өзі жасақтауға тырысып жатқан жаңа командаға қосылды.
Dialogue: 0,0:12:02.36,0:12:04.83,Default,,0,0,0,,Сізді шақырды!?
Dialogue: 0,0:12:04.83,0:12:09.13,Default,,0,0,0,,Бір жыл шектеулі мерзімге бірдеңе жасаңыз, содан кейін тараңыз.
Dialogue: 0,0:12:09.13,0:12:12.00,Default,,0,0,0,,Бұл префектурадан тыс сапарға шыққан арнайы топ.
Dialogue: 0,0:12:12.00,0:12:14.04,Default,,0,0,0,,Сонымен… өте… таңқаларлық!
Dialogue: 0,0:12:14.04,0:12:17.14,Default,,0,0,0,,Сондай-ақ... бұл шынымен де, үлкен жаңалық!
Dialogue: 0,0:12:17.14,0:12:19.98,Default,,0,0,0,,Мен Икейя-сенпайды тезірек үйреткім келеді!
Dialogue: 0,0:12:19.98,0:12:22.98,Default,,0,0,0,,Өтінемін, бұл туралы үлкен мәміле жасамаңыз.
Dialogue: 0,0:12:22.98,0:12:25.88,Default,,0,0,0,,Мен әлі де абдырап қалдым, иә?
Dialogue: 0,0:12:27.55,0:12:31.25,Default,,0,0,0,,Сізді не қызықтырады?
Dialogue: 0,0:12:31.25,0:12:35.22,Default,,0,0,0,,Өйткені менің бірінші шайқасым осы жазда болды...
Dialogue: 0,0:12:35.22,0:12:38.03,Default,,0,0,0,,Тіпті жарты жыл да өткен жоқ.
Dialogue: 0,0:12:38.03,0:12:41.63,Default,,0,0,0,,Мен көліктерге осы кезде ғана қызыға бастадым.
Dialogue: 0,0:12:41.63,0:12:46.24,Default,,0,0,0,,Мен команда мүшесі ретінде қызмет ете алатыныма сенімді емеспін.
Dialogue: 0,0:12:46.24,0:12:48.77,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сіз орта мектептің бірінші курсында оқып жүрген кезіңізден...
Dialogue: 0,0:12:48.77,0:12:52.64,Default,,0,0,0,,Сіз тау асуы арқылы тофу жеткізетін болдыңыз, солай ма? бәрі жақсы!
Dialogue: 0,0:12:52.64,0:12:55.11,Default,,0,0,0,,Ах! Мен жұмыс істеуге немесе басқа нәрсеге қарсы емеспін.
Dialogue: 0,0:12:55.11,0:12:59.95,Default,,0,0,0,,Мен оны қосқаныңызды қалаймын! Бұл керемет! Бұл керемет!
Dialogue: 0,0:12:59.95,0:13:03.39,Default,,0,0,0,,Менің... менің қарсыласым!
Dialogue: 0,0:13:03.39,0:13:06.59,Default,,0,0,0,,Мен одан әрі алыстап бара жатырмын!
Dialogue: 0,0:13:06.59,0:13:08.52,Default,,0,0,0,,Қалай болғанда да, кешеден бері...
Dialogue: 0,0:13:08.52,0:13:12.26,Default,,0,0,0,,Мен командаға кірер алдында абдырап қалдым.
Dialogue: 0,0:13:12.26,0:13:16.76,Default,,0,0,0,,Мен істеу керек нәрселер бар сияқты.
Dialogue: 0,0:13:20.97,0:13:25.47,Default,,0,0,0,,Ой, бұл Риосуке Такахаши айтып тұрғаны ма?
Dialogue: 0,0:13:25.47,0:13:29.21,Default,,0,0,0,,Сәлем! Бұл үлкен жаңалық, солай емес пе?
Dialogue: 0,0:13:29.21,0:13:33.92,Default,,0,0,0,,Ах, Риосуке Такахаши туралы айтатын болсақ, біз харизматикалық жүгірушілерміз.
Dialogue: 0,0:13:33.92,0:13:37.85,Default,,0,0,0,,Өйткені ол қатарынан жеңіске жеткен тау асуының патшасы.
Dialogue: 0,0:13:37.85,0:13:42.22,Default,,0,0,0,,Алайда бұл жеңіс сериясын тоқтатқан Такуми болды.
Dialogue: 0,0:13:42.22,0:13:46.10,Default,,0,0,0,,Екеуі қосылса, мықты командаға айналады.
Dialogue: 0,0:13:46.10,0:13:48.03,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:13:48.03,0:13:51.00,Default,,0,0,0,,Менде бір нәрсеге қатысты сезімдерім аралас.
Dialogue: 0,0:13:51.00,0:13:53.24,Default,,0,0,0,,Не? (Икея) Иә?
Dialogue: 0,0:13:53.24,0:13:56.84,Default,,0,0,0,,Өйткені Такуми біздің Акина кейіпкеріміз.
Dialogue: 0,0:13:56.84,0:14:00.78,Default,,0,0,0,,Қызыл құм алып кететінін сезбейсің бе?
Dialogue: 0,0:14:00.78,0:14:05.21,Default,,0,0,0,,Мен Такумидің көбірек шығуымен келісемін.
Dialogue: 0,0:14:05.21,0:14:08.55,Default,,0,0,0,,Мен оның одан да үлкен болғанын қалаймын.
Dialogue: 0,0:14:08.55,0:14:11.92,Default,,0,0,0,,Иә, иә (Икейя) Бір жылға ғана, Риосуке Такахаши —
Dialogue: 0,0:14:11.92,0:14:13.86,Default,,0,0,0,,Оны менімен қалдыруды ойласаң жақсы емес пе?
Dialogue: 0,0:14:13.86,0:14:16.76,Default,,0,0,0,,күрсіну... Префектураның сыртындағы экспедиция?
Dialogue: 0,0:14:16.76,0:14:19.66,Default,,0,0,0,,Біз баяғыда бір нәрсені ойладық.
Dialogue: 0,0:14:19.66,0:14:21.66,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:14:21.66,0:14:24.96,Default,,0,0,0,,Такуми Акина асуына сыймайтын адам емес.
Dialogue: 0,0:14:35.14,0:14:37.44,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:14:39.98,0:14:42.68,Default,,0,0,0,,《Қозғалтқыштың соғуы – шығын.》
Dialogue: 0,0:14:53.60,0:14:55.90,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:57.13,0:15:02.13,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:15:03.31,0:15:05.51,Default,,0,0,0,,(Будың шығуы)
Dialogue: 0,0:15:20.19,0:15:24.19,Default,,0,0,0,,[Терминал] (рингтон)
Dialogue: 0,0:15:24.19,0:15:28.46,Default,,0,0,0,,[Терминал] (операция дыбысы) (Рйосуке) Сәлеметсіз бе? Иә, бірақ
Dialogue: 0,0:15:28.46,0:15:30.40,Default,,0,0,0,,Мм... кешіріңіз.
Dialogue: 0,0:15:30.40,0:15:33.30,Default,,0,0,0,,Мұның кеше айтқанымызға еш қатысы жоқ...
Dialogue: 0,0:15:33.30,0:15:36.91,Default,,0,0,0,,Жоқ... Менің ойымша, бұл мүлдем маңызды емес дегенді білдірмейді.
Dialogue: 0,0:15:36.91,0:15:40.78,Default,,0,0,0,,Маған бір нәрсе айтқым келеді.
Dialogue: 0,0:15:40.78,0:15:45.71,Default,,0,0,0,,Император командасының басшысы? Сіз Kyoichi Sudo туралы айтып отырсыз ба?
Dialogue: 0,0:15:45.71,0:15:48.48,Default,,0,0,0,,Иә, Судо есімді адам.
Dialogue: 0,0:15:48.48,0:15:51.39,Default,,0,0,0,,Сізбен кездесу үшін қайда баруға болатынын білесіз бе?
Dialogue: 0,0:15:51.39,0:15:54.22,Default,,0,0,0,,Кёичи менің ескі танысым.
Dialogue: 0,0:15:54.22,0:15:57.66,Default,,0,0,0,,Менімен хабарласқыңыз келсе, кез келген уақытта хабарласа аласыз.
Dialogue: 0,0:15:57.66,0:16:00.96,Default,,0,0,0,,Мен... Мүмкіндік болса...
Dialogue: 0,0:16:00.96,0:16:04.63,Default,,0,0,0,,Мен ол адаммен қайтадан жүгіргім келді.
Dialogue: 0,0:16:04.63,0:16:07.54,Default,,0,0,0,,Түсіндім, қайда істейсің?
Dialogue: 0,0:16:07.54,0:16:10.44,Default,,0,0,0,,Мен ана жақтағы туған жеріме баруды ойлап жүрмін.
Dialogue: 0,0:16:10.44,0:16:14.44,Default,,0,0,0,,Киоичидің үй курсы - Никконың "Ирохазака"
Dialogue: 0,0:16:15.98,0:16:19.48,Default,,0,0,0,,Егер сіз мұны сол жерде жасағыңыз келсе, бұл жаман қарсылас емес, бұл күшті қарсылас.
Dialogue: 0,0:16:20.65,0:16:23.55,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:16:32.26,0:16:35.50,Default,,0,0,0,,《Сырт-келбетіңізге қарамастан, сізде бәсекеге қабілетті рух бар.''
Dialogue: 0,0:16:35.50,0:16:39.50,Default,,0,0,0,,Маған қолайсыз жау аумағына батыл бару идеясы ұнады.
Dialogue: 0,0:16:39.50,0:16:44.20,Default,,0,0,0,,Бұл жылдам болу үшін өте қажет қасиет.
Dialogue: 0,0:16:48.58,0:16:52.41,Default,,0,0,0,,[TEL] (рингтон)
Dialogue: 0,0:16:52.41,0:16:54.48,Default,,0,0,0,,Иә Fujiwara Tofu дүкені
Dialogue: 0,0:16:54.48,0:16:56.95,Default,,0,0,0,,[ТЕЛ] Сәлеметсіз бе... Мен Такеучимін.
Dialogue: 0,0:16:56.95,0:17:01.26,Default,,0,0,0,,О, Такуми? Ол жерде жоқ
Dialogue: 0,0:17:01.26,0:17:05.96,Default,,0,0,0,,Не? Жоқ? Сіз шықтыңыз ба? Көлікпен? Мм... қайда?
Dialogue: 0,0:17:07.20,0:17:09.40,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:17:11.60,0:17:13.54,Default,,0,0,0,,≪(көліктің жүгіру дыбысы)
Dialogue: 0,0:17:13.54,0:17:25.55,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:25.55,0:17:27.55,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:17:30.09,0:17:32.02,Default,,0,0,0,,《Бұл Ирохазака ма?》
Dialogue: 0,0:17:32.02,0:17:34.92,Default,,0,0,0,,《Картаға қарасаңыз, аттас екі жол бар.''
Dialogue: 0,0:17:34.92,0:17:39.23,Default,,0,0,0,,Мен бұл біртүрлі деп ойладым, бірақ мұнда келгеннен кейін мен неге екенін түсіндім.
Dialogue: 0,0:17:39.23,0:17:42.10,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:17:42.10,0:17:44.47,Default,,0,0,0,,《Жоғары және төмен бағыттар бір жақты.''
Dialogue: 0,0:17:44.47,0:17:46.80,Default,,0,0,0,,Бұл басқа жол》
Dialogue: 0,0:17:46.80,0:17:49.57,Default,,0,0,0,,《Осындай жол бар ма...》
Dialogue: 0,0:17:49.57,0:17:54.57,Default,,0,0,0,,≪(Шырылдаған дыбыс және жүгіру дыбысы)
Dialogue: 0,0:18:03.82,0:18:05.82,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:18:05.82,0:18:09.12,Default,,0,0,0,,《Әйтеуір, бұл түсу керемет》
Dialogue: 0,0:18:12.56,0:18:15.46,Default,,0,0,0,,О... эй енді (Император 2-мүше) О
Dialogue: 0,0:18:15.46,0:18:20.07,Default,,0,0,0,,Не? Не? (Император 4-мүше) О... Сәлем.
Dialogue: 0,0:18:20.07,0:18:21.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:22.97,0:18:26.47,Default,,0,0,0,,Сол жігіт... (Император 4-мүше) Акинаның Хачироку.
Dialogue: 0,0:18:31.58,0:18:36.12,Default,,0,0,0,,Иә? Не? Иә, көремін...
Dialogue: 0,0:18:36.12,0:18:39.76,Default,,0,0,0,,Кёичи мырза, мен төменнен хабарлама алдым.
Dialogue: 0,0:18:39.76,0:18:43.46,Default,,0,0,0,,Жақында сізге ұқсайтын көлік келеді.
Dialogue: 0,0:18:46.53,0:18:49.26,Default,,0,0,0,,≪(Есіктің ашылған дыбысы) (Кейсуке) Үлкен аға, барсыз ба?
Dialogue: 0,0:18:49.26,0:18:51.70,Default,,0,0,0,,Кейсуке, не болды?
Dialogue: 0,0:18:51.70,0:18:56.27,Default,,0,0,0,,Акинаның Хачироку ақпараты бар Ирохазакада
Dialogue: 0,0:18:56.27,0:18:58.84,Default,,0,0,0,,көремін.
Dialogue: 0,0:18:58.84,0:19:01.88,Default,,0,0,0,,Не, сен білесің бе? (Рйосуке) Жарайды.
Dialogue: 0,0:19:01.88,0:19:06.01,Default,,0,0,0,,Әйтеуір, кек алмақшы ма?
Dialogue: 0,0:19:06.01,0:19:08.52,Default,,0,0,0,,Мүмкін қарапайым жеңіс немесе жеңіліс
Dialogue: 0,0:19:08.52,0:19:11.05,Default,,0,0,0,,Менің ойымша, сіз бұл туралы ерекше ойламайсыз.
Dialogue: 0,0:19:11.05,0:19:16.85,Default,,0,0,0,,Ол Ирохазакаға бірдеңені көргісі келгендіктен барған шығар.
Dialogue: 0,0:19:25.90,0:19:27.90,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:19:36.51,0:19:39.41,Default,,0,0,0,,《Не? Алдыңғы Хачирокудың дыбысы қандай...》
Dialogue: 0,0:19:39.41,0:19:41.25,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:19:41.25,0:19:43.52,Default,,0,0,0,,Бұл біраз бұрынғы оқиға.
Dialogue: 0,0:19:43.52,0:19:47.52,Default,,0,0,0,,«Шибукавадағы шағын жөндеу шеберханасында біртүрлі қозғалтқыш болды.
Dialogue: 0,0:19:47.52,0:19:50.76,Default,,0,0,0,,Бейресми арналар арқылы тарап кеткені туралы ақпаратты ұстадым.
Dialogue: 0,0:19:50.76,0:19:53.66,Default,,0,0,0,,Біртүрлі қозғалтқыш? (Рйосуке) Қазір ол жоғалып кетті...
Dialogue: 0,0:19:53.66,0:19:58.00,Default,,0,0,0,,Бұрын «А тобы» деп аталатын гастрольдік көліктер жарысы танымал болды.
Dialogue: 0,0:19:58.00,0:20:00.90,Default,,0,0,0,,Есіңде ме? (Кейсуке) Иә! Мүмкін емес -
Dialogue: 0,0:20:00.90,0:20:03.24,Default,,0,0,0,,Бұл А тобының қозғалтқышы ма?
Dialogue: 0,0:20:03.24,0:20:05.94,Default,,0,0,0,,Оннан тоғыз рет, бұған күмән жоқ.
Dialogue: 0,0:20:05.94,0:20:10.61,Default,,0,0,0,,TRD қозғалтқышы A тобында орнатылған болса AE101—
Dialogue: 0,0:20:10.61,0:20:14.38,Default,,0,0,0,,11 000-нан астам айналым диапазонында, тіпті ол NA tenrok болса да.
Dialogue: 0,0:20:14.38,0:20:18.25,Default,,0,0,0,,Бұл 240 ат күшін шығаратын өте жоғары өнімді қондырғы.
Dialogue: 0,0:20:18.25,0:20:20.96,Default,,0,0,0,,Көшеде пайдалану үшін өшірілген болуы мүмкін.
Dialogue: 0,0:20:20.96,0:20:24.56,Default,,0,0,0,,Ол Акинаның Хачироку капюшонына сәйкес келеді.
Dialogue: 0,0:20:24.56,0:20:28.10,Default,,0,0,0,,Дегенмен, қозғалтқыш қаншалықты жарысқа арналған болса да,
Dialogue: 0,0:20:28.10,0:20:32.83,Default,,0,0,0,,1,6 литр НА-дан сығуға болатын қуаттың шегі бар.
Dialogue: 0,0:20:32.83,0:20:35.17,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:35.17,0:20:38.97,Default,,0,0,0,,Хачирокуды жөндедіңіз бе? иә
Dialogue: 0,0:20:38.97,0:20:42.28,Default,,0,0,0,,Менің Акагиде не айтқаным есіңде ме?
Dialogue: 0,0:20:42.28,0:20:45.18,Default,,0,0,0,,«Сіз менімен бәсекелесуге жарамды көлікке ауысқанша.
Dialogue: 0,0:20:45.18,0:20:49.89,Default,,0,0,0,,Матчты сізге қалдырамын.'' Мен осылай дедім.
Dialogue: 0,0:20:49.89,0:20:52.89,Default,,0,0,0,,Бұл машина алдыңғысынан өзгеше.
Dialogue: 0,0:20:52.89,0:20:55.69,Default,,0,0,0,,Мен үшін бұл жақсы көлік.
Dialogue: 0,0:20:55.69,0:20:58.19,Default,,0,0,0,,Жақсы емес пе? Мынау
Dialogue: 0,0:21:01.53,0:21:05.17,Default,,0,0,0,,Жарайды, бұл мен үшін аяқталмаған шайқас.
Dialogue: 0,0:21:05.17,0:21:07.17,Default,,0,0,0,,Мен мұны осы жерден аяқтаймын.
Dialogue: 0,0:21:07.17,0:21:11.97,Default,,0,0,0,,Мен қарап отырған ат күші емес, иілісі.
Dialogue: 0,0:21:11.97,0:21:13.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:13.91,0:21:16.28,Default,,0,0,0,,Осы қозғалтқышты орнату арқылы—
Dialogue: 0,0:21:16.28,0:21:19.58,Default,,0,0,0,,Жаттығу өнімділігі күрт жақсарады—
Dialogue: 0,0:21:19.58,0:21:22.42,Default,,0,0,0,,Табиғи түрде иілуге төзімді бұрыштық жұмысы үшін.
Dialogue: 0,0:21:22.42,0:21:24.85,Default,,0,0,0,,Әрі қарай нақтылау
Dialogue: 0,0:21:24.85,0:21:27.76,Default,,0,0,0,,Кёичидің қате ату жүйесі және
Dialogue: 0,0:21:27.76,0:21:30.56,Default,,0,0,0,,Біз біркелкі төбелесуіміз мүмкін.
Dialogue: 0,0:21:39.97,0:21:41.97,Default,,0,0,0,,Матч - төмен қарай жүгіру.
Dialogue: 0,0:21:41.97,0:21:46.24,Default,,0,0,0,,Төменгі жағында жол үш көпірден өтеді.
Dialogue: 0,0:21:46.24,0:21:49.54,Default,,0,0,0,,Мақсат - соңғы көпірден өтетін нүкте.
Dialogue: 0,0:21:49.54,0:21:53.22,Default,,0,0,0,,Сен бірінші бар, мен соңынан еремін. Ха!
Dialogue: 0,0:21:53.22,0:21:57.22,Default,,0,0,0,,Маған жол бермей мақсатқа жүгіре алсаңыз, сіз жеңесіз.
Dialogue: 0,0:21:57.22,0:22:00.12,Default,,0,0,0,,Мен шықсам, мен жеңемін, жарай ма?
Dialogue: 0,0:22:00.12,0:22:03.29,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,0:22:03.29,0:22:08.23,Default,,0,0,0,,«Бұл әділетсіз жағдай» дегің келсе, бұл мені қорлау.
Dialogue: 0,0:22:08.23,0:22:12.13,Default,,0,0,0,,Бұл Ирохазака менің туған қалам екенін ұмытпа.
Dialogue: 0,0:22:12.13,0:22:15.94,Default,,0,0,0,,Егер сіз өзіңізді соншалықты кемітпесеңіз, жарысқа қатыса алмайсыз.
Dialogue: 0,0:22:15.94,0:22:17.71,Default,,0,0,0,,Уф
Dialogue: 0,0:22:17.71,0:22:20.61,Default,,0,0,0,,Айтар сөзің болса, біткен соң сұраймын.
Dialogue: 0,0:22:20.61,0:22:22.51,Default,,0,0,0,,Бастайық
Dialogue: 0,0:22:28.02,0:22:29.95,Default,,0,0,0,,《Ирохазаканың шығуы...
Dialogue: 0,0:22:29.95,0:22:34.22,Default,,0,0,0,,Гимнхана курсына тік еңіс қосу сияқты.
Dialogue: 0,0:22:34.22,0:22:37.76,Default,,0,0,0,,Кім келсе де, мұндағы Кёичиге тең келе алмайды.
Dialogue: 0,0:22:37.76,0:22:40.66,Default,,0,0,0,,Киоичидің Гымханада үйренген әдістері бар.
Dialogue: 0,0:22:40.66,0:22:43.17,Default,,0,0,0,,«Төмен жылдамдықты бұрыштардың темір адамы»》
Dialogue: 0,0:22:43.17,0:22:48.00,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:22:48.00,0:22:50.40,Default,,0,0,0,,(қозғалтқыштың соғу дыбысы)
Dialogue: 0,0:22:53.51,0:22:56.71,Default,,0,0,0,,(қозғалтқыштың соғу дыбысы)
Dialogue: 0,0:22:56.71,0:23:12.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:12.83,0:23:16.20,Default,,0,0,0,,《Түсіндім, сәл жылдамырақ.''
Dialogue: 0,0:23:16.20,0:23:19.60,Default,,0,0,0,,Бұл турбодан ерекшеленетін механикалық реттеуге ғана тән жеделдетудің бірегей артуы.
Dialogue: 0,0:23:19.60,0:23:24.14,Default,,0,0,0,,Бірақ сіз оны қанша баптасаңыз да, бұл бәрібір Хачироку.
Dialogue: 0,0:23:24.14,0:23:27.44,Default,,0,0,0,,Бұл 350 ат күші бар》 (сықырлаған дыбыс)
Dialogue: 0,0:23:27.44,0:23:41.46,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:41.46,0:23:46.46,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:23:57.41,0:24:01.84,Default,,0,0,0,,《Бұл өте жоғары айналымды қозғалтқыш. Бұл біраз қиын.''
Dialogue: 0,0:24:01.84,0:24:04.75,Default,,0,0,0,,Осындай манипуляция деңгейімен менің қате жіберетін жүйем...
Dialogue: 0,0:24:04.75,0:24:07.05,Default,,0,0,0,,Сіз қарсы тұра аламын деп ойлайсыз ба? 》
Dialogue: 0,0:24:07.05,0:24:26.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:26.30,0:24:29.97,Default,,0,0,0,,《Қандай көлік келсе де, мен мұнда ұтыла алмаймын.''
Dialogue: 0,0:24:29.97,0:24:35.38,Default,,0,0,0,,Мен Риосуке Акагиде болғандай, мұнда императормын.
Dialogue: 0,0:24:35.38,0:24:37.58,Default,,0,0,0,,Мақсатыңыздың қашып кетуіне жол бермеңіз.
Dialogue: 0,0:24:45.95,0:24:47.89,Default,,0,0,0,,《Тамаша тістеу》
Dialogue: 0,0:24:47.89,0:24:50.59,Default,,0,0,0,,《Қалай болса да, қолымнан келгенше барудан басқа амалым жоқ.》
Dialogue: 0,0:24:54.66,0:24:59.10,Default,,0,0,0,,《Жақында бұл градиент аяқталады, ал Хачироку сонда тоқтайды.''
Dialogue: 0,0:24:59.10,0:25:03.30,Default,,0,0,0,,Менің қарсы шабуылымнан ешқашан құтыла алмайсың.
Dialogue: 0,0:25:11.68,0:25:14.22,Default,,0,0,0,,《Бұл курстың ең үлкен қатесі...
Dialogue: 0,0:25:14.22,0:25:18.09,Default,,0,0,0,,Мен ұзаққа созылатын өте төмен жылдамдықты бөлімдерге үйреніп бара жатқандай сезінемін, мен оны қаламаймын...
Dialogue: 0,0:25:18.09,0:25:21.76,Default,,0,0,0,,Жоғары жылдамдықты жаққа бірден жауап беру мүмкін емес.
Dialogue: 0,0:25:21.76,0:25:24.53,Default,,0,0,0,,Тәжірибелі жүгірушілер бұл тұзаққа түссе, соғұрлым бұл тұзаққа түсу ықтималдығы артады.
Dialogue: 0,0:25:24.53,0:25:28.53,Default,,0,0,0,,Бұл техникадан ерекшеленетін адамның инстинктивті сезімі болғандықтан.
Dialogue: 0,0:25:28.53,0:25:31.93,Default,,0,0,0,,Ешкім бір кадрда жоғары жылдамдықты жағына ауыса алмайды.
Dialogue: 0,0:25:33.77,0:25:36.61,Default,,0,0,0,,``Бір ерекшелікпен...''
Dialogue: 0,0:25:36.61,0:25:41.41,Default,,0,0,0,,Акагидің ақ кометасы Риосуке Такахаши Ол жалғыз》
Dialogue: 0,0:25:41.41,0:25:45.51,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:25:51.95,0:25:55.26,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:25:55.26,0:25:58.53,Default,,0,0,0,,《Көпір? Мақсатқа тез жетеміз бе? 》
Dialogue: 0,0:25:58.53,0:26:02.46,Default,,0,0,0,,《Бірінші көпір, тік учаске осы жерде аяқталады―
Dialogue: 0,0:26:02.46,0:26:06.00,Default,,0,0,0,,Осыдан кейін бізге нақты күш керек.
Dialogue: 0,0:26:06.00,0:26:09.84,Default,,0,0,0,,Мен сізге Судо Кионың бірінші сыныбының жеңімпаз формуласын көрсетемін.
Dialogue: 0,0:26:09.84,0:26:29.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:29.79,0:26:31.73,Default,,0,0,0,,Екінші
Dialogue: 0,0:26:31.73,0:26:35.48,Default,,0,0,0,,《Жылдам бұрыштың оң жағы көпірдің басынан катапульт сияқты атылды.''
Dialogue: 0,0:26:35.73,0:26:37.78,Default,,0,0,0,,Төмен жылдамдық бөліміне үйрену сезімі бұл...
Dialogue: 0,0:26:37.82,0:26:40.18,Default,,0,0,0,,Менің жүрегім лүпілдеп кететін қорқынышты...
Dialogue: 0,0:26:40.46,0:26:44.42,Default,,0,0,0,,Көрнекі иллюзия жолды тар етіп, сыртқа шығуға мүмкіндік бермейді.
Dialogue: 0,0:26:44.92,0:26:47.60,Default,,0,0,0,,Егер мұрынды аздап бұрап алсаңыз...》
Dialogue: 0,0:26:49.84,0:26:51.84,Default,,0,0,0,,Мен бұл матчты алдым!
Dialogue: 0,0:26:55.65,0:26:57.28,Default,,0,0,0,,《Үшінші көпір》
Dialogue: 0,0:26:57.52,0:26:59.89,Default,,0,0,0,,《Көпірдегі кіріс және шығыс қосқыш орындары―
Dialogue: 0,0:26:59.89,0:27:02.76,Default,,0,0,0,,Мен үшін бұл әдеттегі мәре.
Dialogue: 0,0:27:02.76,0:27:05.56,Default,,0,0,0,,Сапқа тұра салысымен бәрі бітті.
Dialogue: 0,0:27:07.03,0:27:08.96,Default,,0,0,0,,《Мен көрдім. Барғың келе ме? 》
Dialogue: 0,0:27:08.96,0:27:11.53,Default,,0,0,0,,Жүр!
Dialogue: 0,0:27:11.53,0:27:13.80,Default,,0,0,0,,Не!? Ақымақ өлу керек пе? —
Dialogue: 0,0:27:13.80,0:27:16.17,Default,,0,0,0,,Сіз жылдамдықты асырып жатырсыз, бұрыла алмайсыз.
Dialogue: 0,0:27:16.17,0:27:20.71,Default,,0,0,0,,Иіліңіз, иіліңіз, менің Хачирокуім!
Dialogue: 0,0:27:20.71,0:27:24.51,Default,,0,0,0,,Хм... Барсақ болады ма! Хмм...
Dialogue: 0,0:27:26.21,0:27:28.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:34.29,0:27:39.53,Default,,0,0,0,,Бүгінгі шайқас үшінші көпір кіре берісінің сол жағында болды.
Dialogue: 0,0:27:39.53,0:27:42.83,Default,,0,0,0,,Қалыпты Хачироку ол жаққа бұрыла алмайды.
Dialogue: 0,0:27:42.83,0:27:47.13,Default,,0,0,0,,Дәлірек айтқанда, нервтерің қалыпты болса, олай асықпас едің.
Dialogue: 0,0:27:48.10,0:27:52.64,Default,,0,0,0,,Сен сенімдісің бе? Мен оны көре аламын
Dialogue: 0,0:27:52.64,0:27:56.64,Default,,0,0,0,,Сол кезде көлігімнің сыртқы дөңгелегі
Dialogue: 0,0:27:56.64,0:28:00.01,Default,,0,0,0,,Мен өтейін деп тұрған сызықты анық көріп тұрмын.
Dialogue: 0,0:28:00.01,0:28:04.35,Default,,0,0,0,,Мен әрең өтемін деп тежегішті шығарып, жүре бердім.
Dialogue: 0,0:28:04.35,0:28:09.19,Default,,0,0,0,,Мм... Мен оны жақсы түсіндіре алмаймын, бірақ мен әрқашан солаймын.
Dialogue: 0,0:28:09.19,0:28:11.59,Default,,0,0,0,,Оны көргенде баруға болады.
Dialogue: 0,0:28:11.59,0:28:15.56,Default,,0,0,0,,Иә, бұл біртүрлі көлік. Бұл...
Dialogue: 0,0:28:15.56,0:28:20.27,Default,,0,0,0,,Бұл әркім жүргізе алатын көлік емес, бірақ мен оның жақсы көлік екенін мойындаймын.
Dialogue: 0,0:28:20.27,0:28:21.94,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:28:21.94,0:28:25.24,Default,,0,0,0,,Бұл менің жоғалтуым. Мүмкіндік болғанда тағы кездесейік.
Dialogue: 0,0:28:29.68,0:28:33.68,Default,,0,0,0,,Мен шынымен бақыттымын, бірақ жеңгенімді сезбеймін.
Dialogue: 0,0:28:35.15,0:28:39.05,Default,,0,0,0,,Менің ойымша, бұл тең ойын, әділеттілік үшін.
Dialogue: 0,0:28:44.36,0:28:47.06,Default,,0,0,0,,Эй, Такуми, оян.
Dialogue: 0,0:28:48.56,0:28:51.90,Default,,0,0,0,,Сіз кешігіп қалдыңыз. Сен қайда болдың?
Dialogue: 0,0:28:51.90,0:28:55.20,Default,,0,0,0,,Ирохазака
Dialogue: 0,0:28:55.20,0:28:57.61,Default,,0,0,0,,Әй, әке, енді мені не күтіп тұр?
Dialogue: 0,0:28:57.61,0:29:00.31,Default,,0,0,0,,Осы сияқты нәрселер көбейіп кетуі мүмкін.
Dialogue: 0,0:29:00.31,0:29:03.61,Default,,0,0,0,,Соңғы минутта қайтып, оны жеткізу...
Dialogue: 0,0:29:03.61,0:29:05.88,Default,,0,0,0,,Менің ойымша, солай болуы мүмкін.
Dialogue: 0,0:29:05.88,0:29:09.75,Default,,0,0,0,,Жеткізу уақытында қайтып келгенше, мен шағымданбаймын.
Dialogue: 0,0:29:09.75,0:29:12.55,Default,,0,0,0,,Оның орнына, қараңыз!
Dialogue: 0,0:29:13.72,0:29:17.19,Default,,0,0,0,,Ұйықтап кетсең де, мен сенің жойылғаныңды қаламаймын.
Dialogue: 0,0:29:17.19,0:29:19.63,Default,,0,0,0,,Су төгілмеуі үшін көлікті абайлап жүргізіңіз.
Dialogue: 0,0:29:19.63,0:29:23.23,Default,,0,0,0,,Білсең мен келемін.
Dialogue: 0,0:29:40.08,0:29:42.08,Default,,0,0,0,,​​О?
Dialogue: 0,0:29:45.35,0:29:47.45,Default,,0,0,0,,Кейсуке-сан
Dialogue: 0,0:29:53.16,0:29:57.27,Default,,0,0,0,,Irohazaka-да Evo III-пен ойнағаныңызды естідім.
Dialogue: 0,0:29:57.27,0:30:00.50,Default,,0,0,0,,Сіз мұны бұрыннан білесіз бе?
Dialogue: 0,0:30:00.50,0:30:04.31,Default,,0,0,0,,Осындай әңгімелер тез тарады.
Dialogue: 0,0:30:04.31,0:30:06.57,Default,,0,0,0,,Жақында қыс келеді
Dialogue: 0,0:30:06.57,0:30:10.95,Default,,0,0,0,,Біздің префектурадан тыс экспедициямыз қызу басталады.
Dialogue: 0,0:30:10.95,0:30:15.15,Default,,0,0,0,,Мұздатылған жол маусымы келесі көктемде аяқталады.
Dialogue: 0,0:30:15.15,0:30:17.75,Default,,0,0,0,,Келесің бе? жаңа командамызға
Dialogue: 0,0:30:17.75,0:30:20.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:20.05,0:30:23.26,Default,,0,0,0,,Егер ағаңыздың мерзімі бір жыл қалса.
Dialogue: 0,0:30:23.26,0:30:25.99,Default,,0,0,0,,Сол бір жыл ішінде мен бар күшімді салдым.
Dialogue: 0,0:30:25.99,0:30:28.90,Default,,0,0,0,,Ағамның арманына жүгіргім келеді.
Dialogue: 0,0:30:28.90,0:30:32.73,Default,,0,0,0,,Менің ағам қатты ұнайтын эпикалық ойынның соңы—
Dialogue: 0,0:30:32.73,0:30:35.64,Default,,0,0,0,,Катарсистің қандай түрі бар?
Dialogue: 0,0:30:35.64,0:30:37.57,Default,,0,0,0,,Мен мұны білгім келеді
Dialogue: 0,0:30:37.57,0:30:40.41,Default,,0,0,0,,Бір жыл ағам жаттықтырған соң...
Dialogue: 0,0:30:40.41,0:30:43.85,Default,,0,0,0,,Сіз соншалықты күшті боласыз, бұл әзіл емес.
Dialogue: 0,0:30:43.85,0:30:48.68,Default,,0,0,0,,Бірақ мен оны одан да асып түсетін деңгейге дейін аяқтаймын.
Dialogue: 0,0:30:48.68,0:30:51.38,Default,,0,0,0,,Оған дейін мен шайқастан жалғыз кетемін.
Dialogue: 0,0:30:53.02,0:30:57.03,Default,,0,0,0,,Бір жылдан кейін мен сені жеңіп, кәсіпқой болуды мақсат етемін.
Dialogue: 0,0:30:57.03,0:30:59.03,Default,,0,0,0,,Үлкен әлемде үлкен болу
Dialogue: 0,0:31:03.50,0:31:06.73,Default,,0,0,0,,Кел, бірге орындайық.
Dialogue: 0,0:31:06.73,0:31:18.88,Default,,0,0,0,,♪♪~
Dialogue: 0,0:31:18.88,0:31:23.18,Default,,0,0,0,,《Уау, қандай керемет адамдар!》
Dialogue: 0,0:31:27.29,0:31:29.72,Default,,0,0,0,,Иә! Бұл рас па? ол
Dialogue: 0,0:31:29.72,0:31:33.09,Default,,0,0,0,,Бұл рас! Шынымен, император Судо
Dialogue: 0,0:31:33.09,0:31:36.00,Default,,0,0,0,,Ирохазакада шайқас болған сияқты.
Dialogue: 0,0:31:36.00,0:31:37.93,Default,,0,0,0,,Сонда нәтиже қандай?
Dialogue: 0,0:31:37.93,0:31:40.84,Default,,0,0,0,,Такуми бұл «галстук» дейді.
Dialogue: 0,0:31:40.84,0:31:42.77,Default,,0,0,0,,Сурет салу? Иә
Dialogue: 0,0:31:42.77,0:31:45.37,Default,,0,0,0,,Бірақ Такумидің жігіті риза болып көрінді.
Dialogue: 0,0:31:45.37,0:31:49.28,Default,,0,0,0,,Дұрыс. Sudo жылдамдығына кепілдік беріледі.
Dialogue: 0,0:31:49.28,0:31:53.01,Default,,0,0,0,,Өйткені, бұл жаудың үй курсы.
Dialogue: 0,0:31:53.01,0:31:55.92,Default,,0,0,0,,Дегенмен, жаңа Хачироку қозғалтқышы
Dialogue: 0,0:31:55.92,0:31:58.85,Default,,0,0,0,,Мүмкін бұл шектен шыққан нәрсе шығар.
Dialogue: 0,0:31:58.85,0:32:00.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:00.52,0:32:03.42,Default,,0,0,0,,Мүмкін Такумидің техникасы керемет шығар.
Dialogue: 0,0:32:03.42,0:32:06.93,Default,,0,0,0,,Егер оның Лан Эвомен тең дәрежеде бәсекелесе алатын жауынгерлік күші болса...
Dialogue: 0,0:32:06.93,0:32:09.93,Default,,0,0,0,,Менің ойымша, бұл маңызды оқиға.
Dialogue: 0,0:32:09.93,0:32:12.17,Default,,0,0,0,,Ауыр оқиға?
Dialogue: 0,0:32:12.17,0:32:14.24,Default,,0,0,0,,Иә...Такуми бірінші рет.
Dialogue: 0,0:32:14.24,0:32:18.44,Default,,0,0,0,,Бұл сізде барлығын лақтыра алатын машина бар дегенді білдіреді.
Dialogue: 0,0:32:18.44,0:32:20.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:20.38,0:32:23.11,Default,,0,0,0,,Акинаның Хачирокудың нағыз жеңілмеген мифі
Dialogue: 0,0:32:23.11,0:32:25.11,Default,,0,0,0,,Мүмкін ол басталғалы тұрған шығар...
Dialogue: 0,0:32:26.75,0:32:28.75,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:32:34.32,0:32:37.29,Default,,0,0,0,,Жоғары октанды... у... 20
Dialogue: 0,0:32:37.29,0:32:39.69,Default,,0,0,0,,20 литр жоғары октанды ұстайды
Dialogue: 0,0:32:39.69,0:32:41.50,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:32:41.50,0:32:44.70,Default,,0,0,0,,Не? Өйткені... 15 жақсы.
Dialogue: 0,0:32:48.67,0:32:50.91,Default,,0,0,0,,Сіз Акинаның Хачирокусысыз ба?
Dialogue: 0,0:32:50.91,0:32:54.11,Default,,0,0,0,,Жоқ, олай емеспін, бірақ... сен ше?
Dialogue: 0,0:32:54.11,0:32:58.35,Default,,0,0,0,,Маған: «Егер мұнда келсең, Акинаның Хачирокусын кездестіре аласың».
Dialogue: 0,0:32:58.35,0:33:00.38,Default,,0,0,0,,Менің атым Огашива.
Dialogue: 0,0:33:00.38,0:33:02.18,Default,,0,0,0,,《Иә? —
Dialogue: 0,0:33:02.18,0:33:05.28,Default,,0,0,0,,Кокашива ше? Амал жоқ…》
Dialogue: 0,0:33:07.42,0:33:34.18,Default,,0,0,0,,♪♪~
Dialogue: 0,0:33:34.18,0:33:37.65,Default,,0,0,0,,《Уфуфу... Кеттік! 》
Dialogue: 0,0:33:37.65,0:33:41.65,Default,,0,0,0,,《Ахха...》
Dialogue: 0,0:33:42.92,0:33:45.46,Default,,0,0,0,,《Бұл! 》 (2-әйел) 《Иә, хехе...》
Dialogue: 0,0:33:45.46,0:33:47.96,Default,,0,0,0,,《Ахаха…》
Dialogue: 0,0:33:47.96,0:33:49.90,Default,,0,0,0,,《Ол жолмен жүрсең қауіпті.》
Dialogue: 0,0:33:49.90,0:34:25.43,Default,,0,0,0,,♪♪~
Dialogue: 0,0:34:25.43,0:34:27.73,Default,,0,0,0,,(құбырдың құлаған дыбысы)
Dialogue: 0,0:34:30.84,0:34:32.51,Default,,0,0,0,,Тапсырыс енгізілді
Dialogue: 0,0:34:32.51,0:34:36.01,Default,,0,0,0,,Бірінші гамбургер картоптары мұздатылған шай
Dialogue: 0,0:34:36.01,0:34:37.95,Default,,0,0,0,,Барлығы 1 ≪(Сатушы) Иә!
Dialogue: 0,0:34:37.95,0:34:39.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:44.22,0:34:47.52,Default,,0,0,0,,Ол қазір жоқ, бірақ 5-те болуы керек.
Dialogue: 0,0:34:47.52,0:34:51.19,Default,,0,0,0,,Сіз тоқтайтын жер бар дедіңіз.
Dialogue: 0,0:34:51.19,0:34:54.70,Default,,0,0,0,,Түсінікті. Мен кейінірек қайтамын. ≪(Yuichi) Тұтынушы...
Dialogue: 0,0:34:54.70,0:34:57.40,Default,,0,0,0,,Жаңа ғана "Когашива" дедіңіз бе? —
Dialogue: 0,0:34:57.40,0:35:00.13,Default,,0,0,0,,Қателессем кешіріңіз.
Dialogue: 0,0:35:00.13,0:35:03.57,Default,,0,0,0,,Мүмкін Кен Огашива...
Dialogue: 0,0:35:03.57,0:35:06.77,Default,,0,0,0,,Кен Огашива - менің әкем.
Dialogue: 0,0:35:07.84,0:35:10.75,Default,,0,0,0,,Сізге үлкен рахмет хаха
Dialogue: 0,0:35:10.75,0:35:14.65,Default,,0,0,0,,Менеджер, маған бұрынғы тұтынушы туралы айтып беріңізші.
Dialogue: 0,0:35:14.65,0:35:16.55,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:35:16.55,0:35:20.92,Default,,0,0,0,,Сіз Кен Огашива туралы айтып отырсыз ба? Иә, сен кімсің?
Dialogue: 0,0:35:20.92,0:35:23.86,Default,,0,0,0,,Бұл есім есіме түспегеніне көп болды.
Dialogue: 0,0:35:23.86,0:35:27.06,Default,,0,0,0,,Содан бері қанша жыл өтті... 20 жыл...
Dialogue: 0,0:35:27.06,0:35:30.90,Default,,0,0,0,,Жоқ... бұдан оңайырақ болар еді.
Dialogue: 0,0:35:30.90,0:35:32.77,Default,,0,0,0,,Шамамен сол кезде Бунта екеуміз...
Dialogue: 0,0:35:32.77,0:35:35.67,Default,,0,0,0,,Мен әртүрлі тау асуларына бардым.
Dialogue: 0,0:35:35.67,0:35:37.47,Default,,0,0,0,,Кен Огашива деген кім?
Dialogue: 0,0:35:37.47,0:35:40.11,Default,,0,0,0,,Ирохазакадан өтіп бара жатқан митингі дүкенінде —
Dialogue: 0,0:35:40.11,0:35:42.48,Default,,0,0,0,,Ол сол кездегі Бунтаның ең күшті қарсыласы болды.
Dialogue: 0,0:35:42.48,0:35:43.98,Default,,0,0,0,,Эх!
Dialogue: 0,0:35:43.98,0:35:47.25,Default,,0,0,0,,Әйтеуір, жүгіру стилі өткір жігіт еді.
Dialogue: 0,0:35:47.25,0:35:52.49,Default,,0,0,0,,Бунта екеуміз бір-бірімізбен бірнеше рет шайқасқанбыз, ал соңғы үлкен жекпе-жекте Бунта жеңіске жетті.
Dialogue: 0,0:35:52.49,0:35:55.39,Default,,0,0,0,,Содан бері мен одан ештеңе естімедім.
Dialogue: 0,0:35:55.39,0:35:59.23,Default,,0,0,0,,《Аты аңызға айналған жүгіруші болған Такумидің әкесі―
Dialogue: 0,0:35:59.23,0:36:01.50,Default,,0,0,0,,Бунта Фудзивараның қарсыласы》
Dialogue: 0,0:36:01.50,0:36:04.70,Default,,0,0,0,,《Мына бала кенет үлкен болып кетті...''
Dialogue: 0,0:36:04.70,0:36:07.24,Default,,0,0,0,,Мен оны Такумиге келеді деп ойламаппын...》
Dialogue: 0,0:36:07.24,0:36:20.88,Default,,0,0,0,,♪♪~
Dialogue: 0,0:36:20.88,0:36:22.88,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:36:31.56,0:36:34.20,Default,,0,0,0,,《Өте жақсы дағдылар》
Dialogue: 0,0:36:34.20,0:36:37.60,Default,,0,0,0,,Не? Дәл қазір не болды?
Dialogue: 0,0:36:37.60,0:36:39.90,Default,,0,0,0,,Бір-біріне үйкеле отырып, мен шошып кеттім.
Dialogue: 0,0:36:40.97,0:36:44.24,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ бұл керемет
Dialogue: 0,0:36:44.24,0:36:46.47,Default,,0,0,0,,Шайқасқа өтініш?
Dialogue: 0,0:36:46.47,0:36:49.38,Default,,0,0,0,,Атмосфера осылай болды.
Dialogue: 0,0:36:49.38,0:36:53.55,Default,,0,0,0,,Дұрыс, Точиги саны SW20 екеніне сенімдімін
Dialogue: 0,0:36:53.55,0:36:57.22,Default,,0,0,0,,Орташа қозғалтқыш болғандықтан, оның жауынгерлік күші жоғары. Сол машина
Dialogue: 0,0:36:57.22,0:36:59.19,Default,,0,0,0,,Митинг?
Dialogue: 0,0:36:59.19,0:37:01.09,Default,,0,0,0,,Митинг дегеніміз не?
Dialogue: 0,0:37:01.09,0:37:03.59,Default,,0,0,0,,Жүргізушінің артында қозғалтқыш бар.
Dialogue: 0,0:37:03.59,0:37:07.06,Default,,0,0,0,,Кәдімгі көлікте ол жүргізуші орындығының алдында.
Dialogue: 0,0:37:07.06,0:37:09.00,Default,,0,0,0,,Мидшип керісінше.
Dialogue: 0,0:37:09.00,0:37:12.63,Default,,0,0,0,,Артқы жетекті жағдайда қозғалтқыштың артқы жағында болғаны дұрыс.
Dialogue: 0,0:37:12.63,0:37:15.90,Default,,0,0,0,,Газды ашқанда шиналар тайғақтығы азаяды.
Dialogue: 0,0:37:15.90,0:37:18.81,Default,,0,0,0,,Бұрыштан шыққан үдеу тиімді.
Dialogue: 0,0:37:18.81,0:37:21.84,Default,,0,0,0,,Ауыр қозғалтқыш машинаның ортасында болса жақсы болар еді.
Dialogue: 0,0:37:21.84,0:37:24.61,Default,,0,0,0,,Сондай-ақ жаттығулардың орындалуын жақсартудың артықшылығы бар.
Dialogue: 0,0:37:24.61,0:37:27.38,Default,,0,0,0,,F1 автомобильдері де ортаңғы қозғалтқышты.
Dialogue: 0,0:37:27.38,0:37:29.32,Default,,0,0,0,,≪(қозғалтқыш дыбысы) Ах!
Dialogue: 0,0:37:29.32,0:37:31.52,Default,,0,0,0,,Иә? Бұл жерде!
Dialogue: 0,0:37:34.06,0:37:37.86,Default,,0,0,0,,≪[TEL] (рингтон) ≪Иә Fujiwara Tofu дүкені
Dialogue: 0,0:37:38.89,0:37:42.36,Default,,0,0,0,,Кокашива? Кен Огашива?
Dialogue: 0,0:37:42.36,0:37:44.63,Default,,0,0,0,,Ол қандай жел соғады?
Dialogue: 0,0:37:44.63,0:37:47.83,Default,,0,0,0,,Даусыңды естігеніме қанша жыл болды?
Dialogue: 0,0:37:49.04,0:37:52.24,Default,,0,0,0,,Сіз Акинаның Хачирокусысыз ба? —
Dialogue: 0,0:37:52.24,0:37:55.28,Default,,0,0,0,,Мен сізді Ирохазакада император Судомен жеңгеніңізді естідім.
Dialogue: 0,0:37:55.28,0:37:57.95,Default,,0,0,0,,Судо менің мақсатым болды -
Dialogue: 0,0:37:57.95,0:38:00.31,Default,,0,0,0,,Бұл қатты Evo III...
Dialogue: 0,0:38:00.31,0:38:02.88,Default,,0,0,0,,Жау жоқ деп жергілікті жерде айтады, бірақ...
Dialogue: 0,0:38:02.88,0:38:06.65,Default,,0,0,0,,Мен оны жеңе алатыныма сенімді болдым.
Dialogue: 0,0:38:06.65,0:38:09.42,Default,,0,0,0,,Сіз дәмді бөлікті алып тастадыңыз.
Dialogue: 0,0:38:09.42,0:38:12.33,Default,,0,0,0,,Сондықтан автоматты түрде менің мақсатым
Dialogue: 0,0:38:12.33,0:38:14.80,Default,,0,0,0,,Маған оны өзгертуге рұқсат етіңіз...
Dialogue: 0,0:38:14.80,0:38:17.26,Default,,0,0,0,,Мен сенімен жарысқым келеді...
Dialogue: 0,0:38:17.26,0:38:20.10,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіздің жауабыңыз қандай?
Dialogue: 0,0:38:20.10,0:38:22.10,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:38:23.57,0:38:26.47,Default,,0,0,0,,Менің Evo III-ке қарсы жеңіске жету ниетім жоқ.
Dialogue: 0,0:38:26.47,0:38:30.57,Default,,0,0,0,,Оқиға осылай өрбісе, менің де қашатын ойым жоқ.
Dialogue: 0,0:38:32.78,0:38:34.72,Default,,0,0,0,,Қашан екенін айта алмаймын, бірақ
Dialogue: 0,0:38:34.72,0:38:37.62,Default,,0,0,0,,Қар жаумай тұрып, Ирохазакаға тағы барамын.
Dialogue: 0,0:38:38.62,0:38:41.22,Default,,0,0,0,,Жарайды, түсіндім. Мен оны асыға күтемін.
Dialogue: 0,0:38:42.42,0:38:45.69,Default,,0,0,0,,Менің атым Кай Огашива. Сен ше?
Dialogue: 0,0:38:45.69,0:38:50.00,Default,,0,0,0,,Такуми Фудзивара Кешіріңіз, бірақ мен жұмыстамын.
Dialogue: 0,0:38:50.00,0:38:53.87,Default,,0,0,0,,А... бұл жаман болды. О, тағы бір нәрсе.
Dialogue: 0,0:38:53.87,0:38:56.47,Default,,0,0,0,,Сіз дәл қазір Акинада жүгіріп жүрген жоқсыз ба?
Dialogue: 0,0:38:56.47,0:39:00.47,Default,,0,0,0,,Жоқ, түсіндім... онда бұл жақсы.
Dialogue: 0,0:39:19.59,0:39:21.30,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:39:21.30,0:39:23.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:26.83,0:39:29.43,Default,,0,0,0,,Сіз не істеп жатырсыз? Әкесі: иә?
Dialogue: 0,0:39:30.40,0:39:32.30,Default,,0,0,0,,Такуми…
Dialogue: 0,0:39:33.84,0:39:37.11,Default,,0,0,0,,Бүгін сені көруге келген адам болмады ма?
Dialogue: 0,0:39:37.11,0:39:39.85,Default,,0,0,0,,SW20 - тік көлік.
Dialogue: 0,0:39:39.85,0:39:43.05,Default,,0,0,0,,Әй, әкем қайдан білді?
Dialogue: 0,0:39:44.42,0:39:45.95,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:39:45.95,0:39:49.82,Default,,0,0,0,,Онымен мұны істегіңіз келе ме? О
Dialogue: 0,0:39:49.82,0:39:52.32,Default,,0,0,0,,Қиындыққа келгенде қашқанды ұнатпаймын.
Dialogue: 0,0:39:54.16,0:39:57.06,Default,,0,0,0,,Сіз ұтыласыз, иә?
Dialogue: 0,0:40:09.38,0:40:14.28,Default,,0,0,0,,Әке, мен кеше Акинадағы Хачирокуға бардым.
Dialogue: 0,0:40:14.28,0:40:18.59,Default,,0,0,0,,Түсіндім... ақырында Фудзивараның ұлымен жасайық.
Dialogue: 0,0:40:18.59,0:40:21.39,Default,,0,0,0,,Не? Сен білесің бе? Әке
Dialogue: 0,0:40:21.39,0:40:24.89,Default,,0,0,0,,Аа, біраз байланыс бар...
Dialogue: 0,0:40:24.89,0:40:30.09,Default,,0,0,0,,Кай Менде Хачирокуды жеңетін жақсы стратегия бар.
Dialogue: 0,0:40:31.70,0:40:35.17,Default,,0,0,0,,(Жұмыстың соңы қоңырауы)
Dialogue: 0,0:40:35.17,0:40:38.67,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:40:38.67,0:40:41.77,Default,,0,0,0,,Ах... Такуми-кун
Dialogue: 0,0:40:44.01,0:40:47.88,Default,,0,0,0,,Ах... Такуми-кун, Шикато, өтінемін, олай етпе.
Dialogue: 0,0:40:47.88,0:40:51.35,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім, бірақ кейінірек кездесіңізші.
Dialogue: 0,0:40:51.35,0:40:55.16,Default,,0,0,0,,Неге мен? Біз доспыз, солай ма?
Dialogue: 0,0:40:55.16,0:40:59.03,Default,,0,0,0,,Достар? Такуми-кун, сен бұрын айттың ғой.
Dialogue: 0,0:40:59.03,0:41:01.76,Default,,0,0,0,,«Біз шынымен кездесіп жатқан жоқпыз».
Dialogue: 0,0:41:01.76,0:41:04.50,Default,,0,0,0,,Сонымен... онда біз доспыз, солай ма?
Dialogue: 0,0:41:04.50,0:41:08.14,Default,,0,0,0,,Менің досым болсаң, ақыл сұрасаң да болады.
Dialogue: 0,0:41:08.14,0:41:12.71,Default,,0,0,0,,Такуми-кун, күт! Өтінемін, танысыңыз!
Dialogue: 0,0:41:12.71,0:41:15.61,Default,,0,0,0,,Мен бос емеспін.
Dialogue: 0,0:41:26.75,0:41:29.52,Default,,0,0,0,,≪Такуми!
Dialogue: 0,0:41:29.52,0:41:34.09,Default,,0,0,0,,Сіз қашан баруды ойлайсыз? Ирохазака
Dialogue: 0,0:41:34.09,0:41:37.03,Default,,0,0,0,,Сіз мұны шешкеннен кейін, соғұрлым тезірек жақсырақ, солай емес пе?
Dialogue: 0,0:41:37.03,0:41:40.43,Default,,0,0,0,,Кейінге қалдырсаң да, жағдай өзгермейді...
Dialogue: 0,0:41:40.43,0:41:44.87,Default,,0,0,0,,Сондықтан мен бүгін кешке барамын! Бұл өтірік емес пе? Шынайы ма?
Dialogue: 0,0:41:44.87,0:41:47.14,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:41:47.14,0:41:49.78,Default,,0,0,0,,Ертең сенбі, сондықтан менде жарты күн сабақ бар.
Dialogue: 0,0:41:49.78,0:41:52.68,Default,,0,0,0,,Бүгін түнде көп ұйықтамасаңыз да, өзіңізді жақсы сезінесіз.
Dialogue: 0,0:41:52.68,0:41:56.58,Default,,0,0,0,,Сіз соншалықты батылсыз, мен таң қалдым.
Dialogue: 0,0:41:56.58,0:41:59.22,Default,,0,0,0,,А, жарайды, не істейсің?
Dialogue: 0,0:41:59.22,0:42:01.99,Default,,0,0,0,,Жаңа команда туралы...
Dialogue: 0,0:42:01.99,0:42:05.86,Default,,0,0,0,,Сіз кіресіз бе? Сіз әлі жауап бердіңіз бе? Әлі емес
Dialogue: 0,0:42:05.86,0:42:10.30,Default,,0,0,0,,Әлі емес пе? Команда өз қызметін белсенді түрде бастайды -
Dialogue: 0,0:42:10.30,0:42:13.20,Default,,0,0,0,,Көктемнен кейін ғана болса керек.
Dialogue: 0,0:42:13.20,0:42:16.00,Default,,0,0,0,,Оған дейін әлі аз уақыт бар.
Dialogue: 0,0:42:16.00,0:42:20.44,Default,,0,0,0,,Мен әртүрлі нәрселер туралы ойлануға тырысамын Ойлану дегенді қалай түсінесіңдер?
Dialogue: 0,0:42:20.44,0:42:24.31,Default,,0,0,0,,Мен шешім қабылдадым, бірақ мен екіленіп отырмын.
Dialogue: 0,0:42:24.31,0:42:27.51,Default,,0,0,0,,Риосуке де, Кейсуке де керемет адамдар...
Dialogue: 0,0:42:27.51,0:42:31.85,Default,,0,0,0,,Бұл адамдардың мақсаты өте айқын.
Dialogue: 0,0:42:31.85,0:42:34.76,Default,,0,0,0,,Иә? Мен...
Dialogue: 0,0:42:34.76,0:42:38.63,Default,,0,0,0,,Мен жылдамырақ болғым келеді.
Dialogue: 0,0:42:38.63,0:42:41.13,Default,,0,0,0,,Мақсат сезімі...
Dialogue: 0,0:42:49.27,0:42:52.84,Default,,0,0,0,,Сіз барасыз ба? А... иә
Dialogue: 0,0:42:52.84,0:42:58.28,Default,,0,0,0,,Дұрыс, сен кереметсің. Мен сізге бір ғана кеңес беремін.
Dialogue: 0,0:42:58.28,0:43:00.68,Default,,0,0,0,,Аа... қандай жел соғып тұр?
Dialogue: 0,0:43:00.68,0:43:02.58,Default,,0,0,0,,Дұрыс. Көрдің бе, сен бәрібір істей аласың.
Dialogue: 0,0:43:05.95,0:43:07.96,Default,,0,0,0,,Сіз оны тек бір рет айта аласыз.
Dialogue: 0,0:43:07.96,0:43:10.82,Default,,0,0,0,,Бастапқы нүкте - соңғы көпір бөлімі.
Dialogue: 0,0:43:10.82,0:43:14.56,Default,,0,0,0,,Ол кезде басқа адам міндетті түрде сіздің алдыңызда болады.
Dialogue: 0,0:43:14.56,0:43:17.66,Default,,0,0,0,,А... сен мұны түсінбейсің.
Dialogue: 0,0:43:24.37,0:43:26.87,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:43:31.75,0:43:35.68,Default,,0,0,0,,Мұқият тыңда, Кай, басқа адам Фудзивараның ұлы.
Dialogue: 0,0:43:35.68,0:43:38.32,Default,,0,0,0,,Оның таңғажайып технологиясы болуы керек.
Dialogue: 0,0:43:38.32,0:43:39.92,Default,,0,0,0,,Шайқаста қалай жеңуге болады
Dialogue: 0,0:43:39.92,0:43:43.46,Default,,0,0,0,,Технология плюс стратегиясы қажет болады
Dialogue: 0,0:43:43.46,0:43:47.39,Default,,0,0,0,,Маған Фудзивараның ұлын жеңу стратегиясын айтып берейін.
Dialogue: 0,0:43:47.39,0:43:51.10,Default,,0,0,0,,Алдымен қарсыласыңды жібер, иә?
Dialogue: 0,0:43:51.10,0:43:55.50,Default,,0,0,0,,Сіз өз ниетіңізге сенімдісіз бе!? Мен мұндай ақымақ стратегияға шыдамаймын! —
Dialogue: 0,0:43:55.50,0:43:58.94,Default,,0,0,0,,Егер сіз өзіңізден жылдамырақ деп ойлайтын адам сізден алда...
Dialogue: 0,0:43:58.94,0:44:01.64,Default,,0,0,0,,Бұл кезде бұл жоғалту сияқты жақсы!
Dialogue: 0,0:44:01.64,0:44:05.95,Default,,0,0,0,,Егер сіз бұл туралы тура ойласаңыз, артқа шегіну мүлдем мүмкін емес!
Dialogue: 0,0:44:05.95,0:44:09.72,Default,,0,0,0,,Бұл дұрыс жолмен мүмкін емес.
Dialogue: 0,0:44:09.72,0:44:11.75,Default,,0,0,0,,Сондықтан бұл стратегия.
Dialogue: 0,0:44:11.75,0:44:14.39,Default,,0,0,0,,Иә? (Кен) Ирохазакада...
Dialogue: 0,0:44:14.39,0:44:18.69,Default,,0,0,0,,Кейде инвестордың ішінде әрі қарай сызық жасалады.
Dialogue: 0,0:44:18.69,0:44:20.66,Default,,0,0,0,,Сіз маған мұны істеуді айтасыз ба?
Dialogue: 0,0:44:20.66,0:44:24.06,Default,,0,0,0,,Жарайды ма? Әке! Сіздің көлігіңізбен не болатынын ешқашан білмейсіз!
Dialogue: 0,0:44:24.06,0:44:25.90,Default,,0,0,0,,Жарайды, орындаңыз!
Dialogue: 0,0:44:25.90,0:44:30.14,Default,,0,0,0,,Бокста біреуді артта қалдыру - нокаутпен жеңу.
Dialogue: 0,0:44:30.14,0:44:33.41,Default,,0,0,0,,Жеңіске жетудің барлығына анық көрінетін шешуші жолы.
Dialogue: 0,0:44:33.41,0:44:36.31,Default,,0,0,0,,Бұл жолы бұл туралы ерекше айтуға батылы бар.
Dialogue: 0,0:44:36.31,0:44:38.25,Default,,0,0,0,,Жарайсың ба? Кай-
Dialogue: 0,0:44:38.25,0:44:40.68,Default,,0,0,0,,Оны ортаңғы кезеңнен кейін орнатыңыз.
Dialogue: 0,0:44:40.68,0:44:44.15,Default,,0,0,0,,Оған дейін еш нәрсеге қарамай жүре бер.
Dialogue: 0,0:44:44.15,0:44:47.35,Default,,0,0,0,,≪(көліктің жүгіру дыбысы)
Dialogue: 0,0:44:51.89,0:44:54.70,Default,,0,0,0,,Әкесінің дарынды білімін алғаннан кейін
Dialogue: 0,0:44:54.70,0:44:59.00,Default,,0,0,0,,Ол бала кезінен картпен жарысып, көптеген жарыстарда жеңіске жеткен сияқты.
Dialogue: 0,0:45:00.03,0:45:03.40,Default,,0,0,0,,Неліктен мұндай байсалды жігіт көшеде?
Dialogue: 0,0:45:03.40,0:45:08.34,Default,,0,0,0,,Осы уақытқа дейін бұл Ирохазака төбесіндегі ең жылдам велосипед болды...
Dialogue: 0,0:45:08.34,0:45:12.58,Default,,0,0,0,,Иә! Императорда Киотсугу Иваки деген жігіт болған жоқ па?
Dialogue: 0,0:45:12.58,0:45:14.52,Default,,0,0,0,,Мен ақ түсті Evo IV міндім
Dialogue: 0,0:45:14.52,0:45:19.09,Default,,0,0,0,,Әй, шашын артына қайырған жексұрын жігіт...
Dialogue: 0,0:45:19.09,0:45:21.86,Default,,0,0,0,,Император Гунма аймағына басып кіргенде —
Dialogue: 0,0:45:21.86,0:45:24.39,Default,,0,0,0,,Бәрі де сол жігіттен жалғыз жеңілді.
Dialogue: 0,0:45:24.39,0:45:28.86,Default,,0,0,0,,Жақында Иваки сол СВ-ға оңай жеңіліп қалған сияқты.
Dialogue: 0,0:45:28.86,0:45:30.80,Default,,0,0,0,,Иә... иә?
Dialogue: 0,0:45:30.80,0:45:33.30,Default,,0,0,0,,≪(Көліктің жүгірген дыбысы) (Сэйджи) Иә?
Dialogue: 0,0:45:41.44,0:45:43.41,Default,,0,0,0,,Бұл тағы да сенсің!
Dialogue: 0,0:45:43.41,0:45:47.88,Default,,0,0,0,,Жоқ, бүгін кешке сендермен араласуға ниетім жоқ, Иваки-сан.
Dialogue: 0,0:45:47.88,0:45:50.85,Default,,0,0,0,,Мен сәлемдесудің бірнеше сөзін қосайын деп ойладым.
Dialogue: 0,0:45:50.85,0:45:52.75,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:45:52.75,0:45:55.32,Default,,0,0,0,,Бүгін түнде мен осы жерде Акинаның Хачирокуімен шайқасамын.
Dialogue: 0,0:45:55.32,0:45:56.92,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:45:56.92,0:46:00.16,Default,,0,0,0,,Сырттан келген адамдарға ұтыла алмаймыз.
Dialogue: 0,0:46:00.16,0:46:03.63,Default,,0,0,0,,Мен сізді тоқтатамын, Судо мырза (Киёджи) алдыңызда!
Dialogue: 0,0:46:03.63,0:46:06.23,Default,,0,0,0,,Бұл қызықты комбинация емес пе?
Dialogue: 0,0:46:06.23,0:46:09.77,Default,,0,0,0,,Акинаның Хачироку арбадағы Кокашиваға қарсы –
Dialogue: 0,0:46:09.77,0:46:12.97,Default,,0,0,0,,Нәтижесі қандай болатынын білгім келеді.
Dialogue: 0,0:46:22.28,0:46:25.99,Default,,0,0,0,,Сізді көргеніме қуаныштымын. Маған курсты алдын ала қарау керек пе?
Dialogue: 0,0:46:25.99,0:46:30.66,Default,,0,0,0,,Мен осындамын. Мен ерте келдім, сондықтан айналдым.
Dialogue: 0,0:46:30.66,0:46:34.53,Default,,0,0,0,,Олай болса, ережелерді түсіндірейік. Бір уақытта басталады.
Dialogue: 0,0:46:34.53,0:46:37.40,Default,,0,0,0,,Мақсат үшінші көпірден өткеннен кейін.
Dialogue: 0,0:46:37.40,0:46:39.80,Default,,0,0,0,,Оны бірінші жойған жеңеді.
Dialogue: 0,0:46:40.87,0:46:42.80,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:46:42.80,0:46:44.80,Default,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:46:48.44,0:46:51.18,Default,,0,0,0,,《Бұл Хачироку...
Dialogue: 0,0:46:51.18,0:46:54.08,Default,,0,0,0,,Бұл Панда Труэно, мен оны кеше Акинада кездестірдім.
Dialogue: 0,0:46:54.08,0:46:58.02,Default,,0,0,0,,Сонымен, сол кезде рульді ұстаған адам —
Dialogue: 0,0:46:58.02,0:47:01.56,Default,,0,0,0,,Әкесі Бунта Фудзивараны жеңген адам
Dialogue: 0,0:47:01.56,0:47:05.76,Default,,0,0,0,,Бұл жігіт ұлын трибунада кездестіргенде—
Dialogue: 0,0:47:05.76,0:47:08.96,Default,,0,0,0,,Мен оны анық түсінбедім, бірақ қазір сезіп тұрмын》
Dialogue: 0,0:47:11.06,0:47:13.37,Default,,0,0,0,,《Бұл жігіт жылдам―
Dialogue: 0,0:47:13.37,0:47:16.30,Default,,0,0,0,,Мен жансызданып барамын! Мен мұны істеуім керек! 》
Dialogue: 0,0:47:16.30,0:47:19.00,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:47:20.51,0:47:22.98,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:47:22.98,0:47:25.48,Default,,0,0,0,,Ақырында басталатын сияқты. (Сейджи) Түсіндім.
Dialogue: 0,0:47:25.48,0:47:27.68,Default,,0,0,0,,≪(Көліктің жүгіріп келе жатқан дыбысы) (Кёичи) Иә?
Dialogue: 0,0:47:30.32,0:47:32.62,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:47:34.62,0:47:36.62,Default,,0,0,0,,Риосуке
Dialogue: 0,0:47:38.26,0:47:42.66,Default,,0,0,0,,Қызықты шайқас болады деген ақпарат алғандықтан келдім.
Dialogue: 0,0:47:43.73,0:47:45.73,Default,,0,0,0,,Хмф, қалағаныңды істе.
Dialogue: 0,0:47:47.20,0:47:49.80,Default,,0,0,0,,Бүгін түнде жел күшті.
Dialogue: 0,0:47:54.07,0:47:57.34,Default,,0,0,0,,Бұл қауіпті болуы мүмкін.
Dialogue: 0,0:47:57.34,0:48:02.55,Default,,0,0,0,,Жол жиегінде көп мөлшерде қураған және шашыраңқы құлаған жапырақтар үйіліп тұруы керек.
Dialogue: 0,0:48:02.55,0:48:07.02,Default,,0,0,0,,Соңғы минуттық шайқасты шешетін құбылмалы қозыр дегеніміз не?
Dialogue: 0,0:48:07.02,0:48:10.22,Default,,0,0,0,,Күтпеген жерден бұл жапырақ болуы мүмкін.
Dialogue: 0,0:48:10.22,0:48:12.62,Default,,0,0,0,,Құлақ құлаған жапырақ...
Dialogue: 0,0:48:17.86,0:48:22.20,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:48:22.20,0:48:24.14,Default,,0,0,0,,Такуми Не болып жатыр?
Dialogue: 0,0:48:24.14,0:48:27.44,Default,,0,0,0,,Көп нәрсені күтпеңіз. Ха!
Dialogue: 0,0:48:27.44,0:48:30.28,Default,,0,0,0,,Стратегия жоқ па? Әке, ештеңе айтпадың ба?
Dialogue: 0,0:48:30.28,0:48:33.78,Default,,0,0,0,,А... Мен сенің айтқаныңды айтқым келді.
Dialogue: 0,0:48:33.78,0:48:35.72,Default,,0,0,0,,Гиббер
Dialogue: 0,0:48:35.72,0:48:40.15,Default,,0,0,0,,Е! (Кенджи) Эй, маған тынығып берші.
Dialogue: 0,0:48:40.15,0:48:42.66,Default,,0,0,0,,Барыңыз!
Dialogue: 0,0:48:42.66,0:48:44.39,Default,,0,0,0,,Е... қолыңнан келгенін істе, Такуми!
Dialogue: 0,0:48:44.39,0:48:47.69,Default,,0,0,0,,Өйткені сен оны жеңе аласың деп сенемін!
Dialogue: 0,0:48:47.69,0:48:50.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:48:50.16,0:48:52.16,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:48:53.97,0:48:59.21,Default,,0,0,0,,5.4.3.2.1—
Dialogue: 0,0:48:59.21,0:49:01.48,Default,,0,0,0,,Жүр! —
Dialogue: 0,0:49:01.48,0:49:03.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:03.48,0:49:06.45,Default,,0,0,0,,Уау! Керемет! Хачироку секірді!
Dialogue: 0,0:49:06.45,0:49:08.98,Default,,0,0,0,,Тез, Такуми!
Dialogue: 0,0:49:08.98,0:49:12.59,Default,,0,0,0,,《Тамаша! Ортаңғы қозғалтқыш бастапқы сызық үшін тиімді болса да...
Dialogue: 0,0:49:12.59,0:49:15.79,Default,,0,0,0,,Өйткені, Хачирокудың жаңа қозғалтқышы керемет! 》
Dialogue: 0,0:49:26.13,0:49:29.74,Default,,0,0,0,,《Тез, бұл дұрыс Хачироку емес.''
Dialogue: 0,0:49:29.74,0:49:32.64,Default,,0,0,0,,Қуаты 2 литр 3S-тен көп.
Dialogue: 0,0:49:32.64,0:49:35.18,Default,,0,0,0,,Қарсыласыңыздан озып, содан кейін оны басып озу...
Dialogue: 0,0:49:35.18,0:49:37.24,Default,,0,0,0,,Әкесі нокаутпен жеңгенін айтты.
Dialogue: 0,0:49:37.24,0:49:40.98,Default,,0,0,0,,Бұл тамаша. Сенің орнында болсам да, мен...
Dialogue: 0,0:49:40.98,0:49:44.58,Default,,0,0,0,,Мен бұл жылдам Хачирокуды арт жағынан жұдырықтаймын.
Dialogue: 0,0:49:51.73,0:49:54.66,Default,,0,0,0,,Жарайды, түсіндім...
Dialogue: 0,0:49:54.66,0:49:57.43,Default,,0,0,0,,Хачироку басынан алда.
Dialogue: 0,0:49:57.43,0:50:00.93,Default,,0,0,0,,Хмф, Огашивадан келгені сіздің аузыңыздағыдай жақсы емес.
Dialogue: 0,0:50:00.93,0:50:03.80,Default,,0,0,0,,Бұл Хачироку, оны тіпті Киоичи де түсіне алмады.
Dialogue: 0,0:50:03.80,0:50:07.67,Default,,0,0,0,,Егер сіз оны жалғастыруға рұқсат етсеңіз, турбосыз SW-мен ештеңе істей алмайсыз.
Dialogue: 0,0:50:07.67,0:50:09.67,Default,,0,0,0,,Қызық... (Киёджи) Иә?
Dialogue: 0,0:50:11.14,0:50:13.48,Default,,0,0,0,,Мен мақсаттың алдында есепте тұрамын.
Dialogue: 0,0:50:13.48,0:50:16.28,Default,,0,0,0,,Өйткені менде абсолютті сенімділік болды.
Dialogue: 0,0:50:16.28,0:50:18.89,Default,,0,0,0,,Онда абайсыздық болған жоқ деп айтуға болмайды.
Dialogue: 0,0:50:18.89,0:50:20.82,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:50:20.82,0:50:23.29,Default,,0,0,0,,Дөрекі әдістерден аулақ болыңыз
Dialogue: 0,0:50:23.29,0:50:26.19,Default,,0,0,0,,Ерекше емес, мен таза жүруге тырыстым.
Dialogue: 0,0:50:26.19,0:50:28.80,Default,,0,0,0,,Бұл мақтаныш молды қазды -
Dialogue: 0,0:50:28.80,0:50:32.67,Default,,0,0,0,,Егер сіз мұқият және тынымсыз жүгірсеңіз, Огашиваның да жеңіске жету мүмкіндігі бар.
Dialogue: 0,0:50:32.67,0:50:35.54,Default,,0,0,0,,Бұл мазаны алады.
Dialogue: 0,0:50:35.54,0:50:37.47,Default,,0,0,0,,Бір сөзбен айтқанда, жол.
Dialogue: 0,0:50:37.47,0:50:41.31,Default,,0,0,0,,Алдында келе жатқан көлікті басып озу үшін жергілікті арнайы сызықпен жүру —
Dialogue: 0,0:50:41.31,0:50:43.54,Default,,0,0,0,,Бұл Ирохазакада бар.
Dialogue: 0,0:50:43.54,0:50:56.49,Default,,0,0,0,,♪♪~
Dialogue: 0,0:50:56.49,0:50:59.86,Default,,0,0,0,,Когашива арбадан тұрған соң сол аяқ тежегішті қолданады.
Dialogue: 0,0:50:59.86,0:51:03.20,Default,,0,0,0,,Оң аяғыңызды газда, сол аяғыңызды тежегіште ұстаңыз...
Dialogue: 0,0:51:03.20,0:51:06.87,Default,,0,0,0,,Жүкті алдыңғы жаққа аударып, астыңғы жүрісті жою—
Dialogue: 0,0:51:06.87,0:51:10.27,Default,,0,0,0,,Осылайша, үдеткіш толығымен ашық күйде зарядтауға болады.
Dialogue: 0,0:51:14.31,0:51:16.38,Default,,0,0,0,,Бұл ерекше тау асуы –
Dialogue: 0,0:51:16.38,0:51:20.41,Default,,0,0,0,,Менің ойымша, сіз жергілікті болмасаңыз, түсінбейтін нәрселер бар.
Dialogue: 0,0:51:20.41,0:51:24.28,Default,,0,0,0,,Менің ойымша, Огашива әртүрлі стратегияларды ойлап отыр.
Dialogue: 0,0:51:24.28,0:51:27.52,Default,,0,0,0,,Такуми қолайсыз жағдайда (Кенджи) Бірақ Такумидің әкесі...
Dialogue: 0,0:51:27.52,0:51:30.52,Default,,0,0,0,,Огашива қарт екеуің баяғыда осында жарысып, жеңіске жеткен жоқсыңдар ма?
Dialogue: 0,0:51:30.52,0:51:33.99,Default,,0,0,0,,Аа, сол кездегі тәжірибеңізге негізделген бірнеше кеңес.
Dialogue: 0,0:51:33.99,0:51:37.40,Default,,0,0,0,,Мен бұл Такумидікі болуы мүмкін деп ойладым.
Dialogue: 0,0:51:37.40,0:51:39.70,Default,,0,0,0,,Гиббериш Уф...
Dialogue: 0,0:51:39.70,0:51:41.80,Default,,0,0,0,,Бұл қорқынышты... Такуми...
Dialogue: 0,0:51:45.00,0:51:47.20,Default,,0,0,0,,≪(көліктің жүгіру дыбысы)
Dialogue: 0,0:51:49.61,0:51:52.08,Default,,0,0,0,,《Бұл өте жапырақты түн.''
Dialogue: 0,0:51:52.08,0:51:54.95,Default,,0,0,0,,Не керек, желдің әсерінен қар үйінділері бар.
Dialogue: 0,0:51:54.95,0:51:58.35,Default,,0,0,0,,Оны мінсең, жол бойы жүреді. Мұны істеу қиын.
Dialogue: 0,0:51:58.35,0:52:02.62,Default,,0,0,0,,Дегенмен, бұл шарт алдыңғы Хачироку үшін қатаңырақ болуы керек.
Dialogue: 0,0:52:02.62,0:52:05.32,Default,,0,0,0,,Өйткені сіз қашан және қай жерде шаңғы тебуді білмейсіз.
Dialogue: 0,0:52:09.39,0:52:11.33,Default,,0,0,0,,《Жүгіру қиын》
Dialogue: 0,0:52:11.33,0:52:15.20,Default,,0,0,0,,《Егер бұл орын алса, оның сырғып кетуіне мүмкіндік берудің орнына мен оны осы жерден сырғытуым керек пе?》
Dialogue: 0,0:52:15.20,0:52:19.50,Default,,0,0,0,,《Артқы жағын ертерек шығарып, төртеуі де сырғып кетсін.》
Dialogue: 0,0:52:20.77,0:52:24.24,Default,,0,0,0,,Не... Не деген жігіт.
Dialogue: 0,0:52:24.24,0:52:27.24,Default,,0,0,0,,Тайғақ жол ағыс па?
Dialogue: 0,0:52:30.05,0:52:32.45,Default,,0,0,0,,《Қорқынышты, Такуми Фудзивара―
Dialogue: 0,0:52:32.45,0:52:35.32,Default,,0,0,0,,Жалқау амалдар жұмыс істемейді.
Dialogue: 0,0:52:35.32,0:52:37.25,Default,,0,0,0,,《Ирохазаканың шаш қыстырғышында...
Dialogue: 0,0:52:37.25,0:52:41.03,Default,,0,0,0,,Кейде инвестордың ішінде одан әрі сызық қалыптасады.
Dialogue: 0,0:52:41.03,0:52:45.56,Default,,0,0,0,,《Оны қай жерде орнатқаныңыздың уақыты маңызды》
Dialogue: 0,0:52:45.56,0:52:48.17,Default,,0,0,0,,Иә, бұл 33-бұрыш—
Dialogue: 0,0:52:48.17,0:52:50.10,Default,,0,0,0,,Шығарылған газдың дыбысы күшейе түсуде.
Dialogue: 0,0:52:50.10,0:52:51.97,Default,,0,0,0,,Мен жақында осы шаш қыстырғышқа келемін.
Dialogue: 0,0:52:51.97,0:52:55.51,Default,,0,0,0,,Түсіндім, келген кезде маған тікелей түсініктеме беріңізші.
Dialogue: 0,0:52:55.51,0:52:57.71,Default,,0,0,0,,Басталғалы жатыр (Кейсуке) Иә?
Dialogue: 0,0:53:00.18,0:53:02.11,Default,,0,0,0,,《Мен өзімді нашар сезінемін》
Dialogue: 0,0:53:02.11,0:53:05.61,Default,,0,0,0,,《Мен нақты білмеймін, бірақ мен бірдеңе жасап көремін! 》
Dialogue: 0,0:53:12.76,0:53:16.36,Default,,0,0,0,,《Енді күте алмаймын, қария! Енді кеткенім дұрыс емес пе? 》
Dialogue: 0,0:53:18.10,0:53:20.60,Default,,0,0,0,,《Қызығу сезімі бар》
Dialogue: 0,0:53:20.60,0:53:22.50,Default,,0,0,0,,Бірдеңе келе жатыр!
Dialogue: 0,0:53:23.50,0:53:26.70,Default,,0,0,0,,Мақсат - 33-ші бұрыш алға!
Dialogue: 0,0:53:26.70,0:53:29.20,Default,,0,0,0,,≪(сықырлаған дыбыс) (Император мүшесі) Міне, келдік!
Dialogue: 0,0:53:32.51,0:53:35.05,Default,,0,0,0,,Міне! Хачироку алға!
Dialogue: 0,0:53:35.05,0:53:36.95,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:53:39.32,0:53:41.09,Default,,0,0,0,,Ха! (2 адам) Ах!
Dialogue: 0,0:53:41.09,0:53:43.32,Default,,0,0,0,,Не? ше? не? —
Dialogue: 0,0:53:43.32,0:53:45.99,Default,,0,0,0,,БҚ қайтадан ішкі жағына соқты? —
Dialogue: 0,0:53:45.99,0:53:48.79,Default,,0,0,0,,Не? Сіз Хачирокуды шығардыңыз ба?
Dialogue: 0,0:53:48.79,0:53:52.60,Default,,0,0,0,,Хачироку жойылды ма? (Рйосуке) Бұл жергілікті ерекшелік пе?
Dialogue: 0,0:53:52.60,0:53:55.27,Default,,0,0,0,,Жарайсың, Огашива.
Dialogue: 0,0:53:55.27,0:53:58.20,Default,,0,0,0,,Не? SW Хачирокуды шығарып алды ма? —
Dialogue: 0,0:53:58.20,0:54:02.04,Default,,0,0,0,,Не? 33 бұрышта ма? Эй! Бұл керемет шайқас болды
Dialogue: 0,0:54:02.04,0:54:04.68,Default,,0,0,0,,Осындай шаш қыстырғыштарымен қалай жасауға болады?
Dialogue: 0,0:54:04.68,0:54:07.41,Default,,0,0,0,,Сіз мұны естідіңіз бе? (Икея) Бұл шайқас қиын...
Dialogue: 0,0:54:07.41,0:54:09.41,Default,,0,0,0,,Уф... Такуми!
Dialogue: 0,0:54:09.41,0:54:40.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:54:40.21,0:54:42.11,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:54:43.65,0:54:45.45,Default,,0,0,0,,《Өзіңді жаман сезінбе...
Dialogue: 0,0:54:45.45,0:54:49.09,Default,,0,0,0,,Инбетадан әрі қарай ауада сызылған сызық.
Dialogue: 0,0:54:49.09,0:54:52.42,Default,,0,0,0,,Биіктігі бойынша үлкен айырмашылық бар Ирохазакаға ғана тән шаш қыстырғыш қисығы.
Dialogue: 0,0:54:52.42,0:54:57.22,Default,,0,0,0,,Сондықтан жергілікті жерде жүгіріп, ережелерді бұзуға болады! 》
Dialogue: 0,0:54:58.26,0:55:00.36,Default,,0,0,0,,Мен бұл шайқаста жеңдім!
Dialogue: 0,0:55:04.87,0:55:08.17,Default,,0,0,0,,《Қарғыс атсын, мен жеңілемін... Осы қарқынмен мен жеңілемін! 》
Dialogue: 0,0:55:14.28,0:55:16.28,Default,,0,0,0,,Сіздің болжамдарыңыз туралы не айтасыз? үлкен аға
Dialogue: 0,0:55:16.28,0:55:21.45,Default,,0,0,0,,Қалған шаш қыстырғыштарының саны 11. Нәтиже әлі белгісіз.
Dialogue: 0,0:55:21.45,0:55:23.92,Default,,0,0,0,,Бұл нені білдіреді? Риосуке
Dialogue: 0,0:55:23.92,0:55:27.39,Default,,0,0,0,,Кёичи, сен айтқандай болды...
Dialogue: 0,0:55:27.39,0:55:30.33,Default,,0,0,0,,Бірақ әлі ерте болды деп ойламайсыз ба?
Dialogue: 0,0:55:30.33,0:55:32.73,Default,,0,0,0,,Иә? (Рйосуке) Айла тым ерте...
Dialogue: 0,0:55:32.73,0:55:36.47,Default,,0,0,0,,Қарсыласыңызға психологиялық зақымдануды қалпына келтіруге уақыт беріңіз.
Dialogue: 0,0:55:36.47,0:55:38.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:38.10,0:55:40.20,Default,,0,0,0,,Қазір 37 бұрыш көрінеді
Dialogue: 0,0:55:43.01,0:55:45.81,Default,,0,0,0,,《Егер жағдай осылай жалғаса берсе, алшақтық кеңейе түседі.》
Dialogue: 0,0:55:51.65,0:55:55.75,Default,,0,0,0,,《Тексер, бұл не? Жақсы! Басқасына барайық! 》
Dialogue: 0,0:55:57.39,0:56:00.26,Default,,0,0,0,,Уау! (2-мүше) Бұл мені ұшырды!
Dialogue: 0,0:56:00.26,0:56:01.96,Default,,0,0,0,,Жүр!
Dialogue: 0,0:56:02.99,0:56:04.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:08.73,0:56:10.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:20.28,0:56:22.05,Default,,0,0,0,,《Қандай нәрсе! —
Dialogue: 0,0:56:22.05,0:56:24.38,Default,,0,0,0,,Сіз бір атуда секіруді жойдыңыз.
Dialogue: 0,0:56:24.38,0:56:27.69,Default,,0,0,0,,Бұл Туге сезімінің массасы сияқты.
Dialogue: 0,0:56:27.69,0:56:31.26,Default,,0,0,0,,Бірақ мені бір рет алдыңа қойсаң, мүмкіндік болмайды.
Dialogue: 0,0:56:31.26,0:56:33.76,Default,,0,0,0,,Мақсатқа дейін осылай жүгіре беремін! 》
Dialogue: 0,0:56:42.87,0:56:45.77,Default,,0,0,0,,≪(Юичи) Бұл ешқашан алдын алуға болмайтын жүгіру сызығы ма?
Dialogue: 0,0:56:45.77,0:56:48.31,Default,,0,0,0,,≪(Ер) Маған бір дана беріңізші.
Dialogue: 0,0:56:48.31,0:56:51.71,Default,,0,0,0,,Мұны неге Такумиге айтпадың?
Dialogue: 0,0:56:51.71,0:56:55.71,Default,,0,0,0,,Ирохазака түсіп бара жатқанда, соңында көпір мен туннель бар, солай ма?
Dialogue: 0,0:56:55.71,0:56:58.42,Default,,0,0,0,,Ах... «Егер ойын желіде болса...
Dialogue: 0,0:56:58.42,0:57:02.59,Default,,0,0,0,,Менде тек осы соңғы ой бар, - дедім мен Такумиге.
Dialogue: 0,0:57:02.59,0:57:04.52,Default,,0,0,0,,«Сіз ол жерге жеткенде
Dialogue: 0,0:57:04.52,0:57:07.89,Default,,0,0,0,,Сіз менің артымда болуыңыз керек».
Dialogue: 0,0:57:07.89,0:57:10.53,Default,,0,0,0,,Бұл жігіт қатты әсерленген жоқ.
Dialogue: 0,0:57:10.53,0:57:13.36,Default,,0,0,0,,Сіз бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:57:13.36,0:57:17.06,Default,,0,0,0,,Сіз оны қалай алып тастау туралы кеңес бердіңіз бе? Тек жағдайда
Dialogue: 0,0:57:18.17,0:57:21.67,Default,,0,0,0,,Хм... Менің айтқанымды түсінсеңіз...
Dialogue: 0,0:57:23.14,0:57:26.88,Default,,0,0,0,,Қайтып шығудың 50% мүмкіндігі бар.
Dialogue: 0,0:57:26.88,0:57:31.28,Default,,0,0,0,,Не? Бұл тек 50%?
Dialogue: 0,0:57:31.28,0:57:33.18,Default,,0,0,0,,Бұл көп емес...
Dialogue: 0,0:57:33.18,0:57:37.38,Default,,0,0,0,,Әрине, бар күшіңмен қашатын адам бар.
Dialogue: 0,0:57:41.89,0:57:47.36,Default,,0,0,0,,《Хехехе... Бунта, енді өкіну сенің кезегің.》
Dialogue: 0,0:57:47.36,0:57:49.76,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:58:00.81,0:58:02.75,Default,,0,0,0,,《Өте дәмді! 》
Dialogue: 0,0:58:02.75,0:58:06.25,Default,,0,0,0,,《Суырып алған соң артынан қарасаңыз, анық көруге болады》
Dialogue: 0,0:58:06.25,0:58:10.15,Default,,0,0,0,,《Түзу жылдамдығы шамамен бірдей, бірақ бұрыштар қорқынышты жылдам》
Dialogue: 0,0:58:12.12,0:58:14.73,Default,,0,0,0,,《Көзім толып кетті, тек үлгеруге тырысамын...
Dialogue: 0,0:58:14.73,0:58:16.96,Default,,0,0,0,,Артқа кетуге қандай мүмкіндік бар...》
Dialogue: 0,0:58:16.96,0:58:19.86,Default,,0,0,0,,《Әкем айтқандай, жеңілме.》
Dialogue: 0,0:58:19.86,0:58:21.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:58:21.80,0:58:25.20,Default,,0,0,0,,《Ойланып қарашы, ол кезде не дедіңіз? Әке》
Dialogue: 0,0:58:28.01,0:58:31.51,Default,,0,0,0,,《Оны орнату нүктесі соңғы көпір бөлімі》
Dialogue: 0,0:58:31.51,0:58:34.98,Default,,0,0,0,,《Ол кезде басқа адам міндетті түрде сіздің алдыңызда болады》
Dialogue: 0,0:58:34.98,0:58:39.32,Default,,0,0,0,,《Сіз мұны түсінбейсіз бе? 》 《Мен мұны түсінемін.》
Dialogue: 0,0:58:39.32,0:58:43.12,Default,,0,0,0,,《Ары қарай не болатыны маңызды. Тыңда және тыңда.》
Dialogue: 0,0:58:43.12,0:58:44.92,Default,,0,0,0,,《Мен үлгі тұтқан Косэй Арима》
Dialogue: 0,0:58:44.92,0:58:48.79,Default,,0,0,0,,《Жылдың осы мезгілінде Ирохазакада жол жиегіндегі бұталар қурап қалады.''
Dialogue: 0,0:58:48.79,0:58:52.03,Default,,0,0,0,,Бұл сіздің мүмкіндігіңіз.》 《Не? 》
Dialogue: 0,0:58:52.03,0:58:54.93,Default,,0,0,0,,《Бірінші көпірмен мұрынды бұрап алғаннан кейін...
Dialogue: 0,0:58:54.93,0:58:58.33,Default,,0,0,0,,Екінші кіреберіс тар, бірақ мен әрең өтемін.
Dialogue: 0,0:58:59.47,0:59:02.51,Default,,0,0,0,,《Сенің шеберлігіңмен біз бір-біріміздің қасымызда тұра аламыз.》
Dialogue: 0,0:59:02.51,0:59:05.41,Default,,0,0,0,,《Үшіншіге секірсең...》
Dialogue: 0,0:59:06.78,0:59:10.38,Default,,0,0,0,,《Қалғаны – сәттілік, қолыңнан келгеннің бәрін жаса.》
Dialogue: 0,0:59:14.02,0:59:15.92,Default,,0,0,0,,≪(сықырлаған дыбыс)
Dialogue: 0,0:59:17.96,0:59:22.59,Default,,0,0,0,,《Әкесі Когашиваның сол секірумен келе жатқанын оқыды ма?》
Dialogue: 0,0:59:22.59,0:59:26.06,Default,,0,0,0,,《Бірақ мен не маңызды екенін білмеймін.》
Dialogue: 0,0:59:26.06,0:59:30.16,Default,,0,0,0,,《Бұталар қашан қура бастайды? Не істейсің!?》
Dialogue: 0,0:59:34.81,0:59:38.48,Default,,0,0,0,,《Тағы бір нәрсе, келесі соңғы шаш қыстырғыш қисығы―
Dialogue: 0,0:59:38.48,0:59:40.81,Default,,0,0,0,,Егер сіз одан жоғары орташа-жоғары жылдамдық бөліміне кірсеңіз...
Dialogue: 0,0:59:40.81,0:59:43.11,Default,,0,0,0,,Мен енді қолымды немесе аяғымды пайдалана алмаймын.
Dialogue: 0,0:59:49.12,0:59:53.02,Default,,0,0,0,,《Мен өзімді жақсы сезінемін, қария, бәрі жоспар бойынша жүріп жатыр.》
Dialogue: 0,0:59:54.79,0:59:56.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:56.73,1:00:00.43,Default,,0,0,0,,《Жол жиегіндегі бұталар қурап қалды, асфальт баспалдақтар көрінеді》
Dialogue: 0,1:00:00.43,1:00:02.93,Default,,0,0,0,,《Түсіндім! Сіз маған мұны істеуді айтасыз ба?
Dialogue: 0,1:00:07.17,1:00:09.97,Default,,0,0,0,,《Бұл жалғыз соңғы мүмкіндік》
Dialogue: 0,1:00:18.38,1:00:21.28,Default,,0,0,0,,Не? Бұл... бұл жеделдету
Dialogue: 0,1:00:25.76,1:00:29.46,Default,,0,0,0,,《Не болды? Сені қарғаймын! 》
Dialogue: 0,1:00:35.83,1:00:39.30,Default,,0,0,0,,Келе жатыр (Император 2-мүше) Қайсысы бас?
Dialogue: 0,1:00:39.30,1:00:41.64,Default,,0,0,0,,Ой, екі көлік қатар келді (Император 2-мүше) Уау! —
Dialogue: 0,1:00:41.64,1:00:45.51,Default,,0,0,0,,Егер сіз сызықты аз да болса өткізіп алсаңыз, екеуіңіз де бетон қабырғаға соғыласыз.
Dialogue: 0,1:00:45.51,1:01:01.33,Default,,0,0,0,,♪♪~
Dialogue: 0,1:01:01.33,1:01:03.79,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,1:01:03.79,1:01:19.89,Default,,0,0,0,,♪♪~
Dialogue: 0,1:01:26.48,1:01:30.32,Default,,0,0,0,,《Иә, мен жеңілдім.
Dialogue: 0,1:01:30.32,1:01:34.19,Default,,0,0,0,,Мен, жергілікті тұрғын, құлаған жапырақтардан жойылатыныма сене алар емеспін.
Dialogue: 0,1:01:34.19,1:01:37.79,Default,,0,0,0,,Бірақ ол керемет, Такуми Фудзивара.
Dialogue: 0,1:01:37.79,1:01:40.13,Default,,0,0,0,,[Терминал] (операция дыбысы) (Сэйджи) Хачироку жеңді—
Dialogue: 0,1:01:40.13,1:01:44.43,Default,,0,0,0,,Огашивадан келген адам голдың алдында айналдырған сияқты.
Dialogue: 0,1:01:44.43,1:01:47.43,Default,,0,0,0,,Көремін (Кейсуке) Үлкен аға
Dialogue: 0,1:01:48.74,1:01:53.04,Default,,0,0,0,,Үйге қайтайық? Кейсуке (Кейсуке) Ах.
Dialogue: 0,1:01:54.95,1:01:58.35,Default,,0,0,0,,《Такуми Фудзивара үлкен болады.''
Dialogue: 0,1:01:58.35,1:02:01.35,Default,,0,0,0,,Масштаб Гунма аймағымен шектелмейді.
Dialogue: 0,1:02:01.35,1:02:04.56,Default,,0,0,0,,Мен Риосукенің саған не үшін қарап тұрғанын анық көріп тұрмын.
Dialogue: 0,1:02:04.56,1:02:08.46,Default,,0,0,0,,— ақыр соңында тіпті Риосукеден де асып түсетін жүргізуші.
Dialogue: 0,1:02:10.26,1:02:13.20,Default,,0,0,0,,Түсіндім, түсіндім. Мен де бас тартамын.
Dialogue: 0,1:02:13.20,1:02:15.97,Default,,0,0,0,,Тіпті аяқталса да, Хачироку жеңді!
Dialogue: 0,1:02:15.97,1:02:19.34,Default,,0,0,0,,Уф! Урай Такуми жеңді
Dialogue: 0,1:02:19.34,1:02:24.14,Default,,0,0,0,,Ия, бұл керемет! Жаңа Хачироку аңызы қазір басталады.
Dialogue: 0,1:02:24.14,1:02:26.88,Default,,0,0,0,,Керемет Акинаның Хачироку
Dialogue: 0,1:02:26.88,1:02:30.88,Default,,0,0,0,,Эй, эй, жылама, Икейя (Икейя) сондай бақытты.
Dialogue: 0,1:02:30.88,1:02:35.28,Default,,0,0,0,,Мен де жылап жатырмын, Сенпай (Икейя мен Ицукидің сәлемі)
Dialogue: 0,1:02:42.36,1:02:44.66,Default,,0,0,0,,Менен жақсы қашқаның үшін рахмет.
Dialogue: 0,1:02:44.66,1:02:47.90,Default,,0,0,0,,Сізге рахмет, мен ештеңеге соқпадым.
Dialogue: 0,1:02:47.90,1:02:51.10,Default,,0,0,0,,Бұл менің әкемнің көлігі, сондықтан мүмкін болса, оны қиратпаңыз.
Dialogue: 0,1:02:51.10,1:02:54.70,Default,,0,0,0,,Мен оны қайтарғым келді. Мен үшін де солай.
Dialogue: 0,1:02:55.84,1:03:00.11,Default,,0,0,0,,Мен бұл көлікке бір рет, Акинада соқтым.
Dialogue: 0,1:03:00.11,1:03:02.75,Default,,0,0,0,,Мен сол кезде ойладым...
Dialogue: 0,1:03:02.75,1:03:06.38,Default,,0,0,0,,``Бұл мен бәсекелесе алмайтын адам болуы мүмкін.''
Dialogue: 0,1:03:06.38,1:03:10.25,Default,,0,0,0,,Мен сенің әкеңмен жарысып жатқан сияқты емеспін.
Dialogue: 0,1:03:10.25,1:03:13.09,Default,,0,0,0,,Менің әсерім соншалықты күшті болды.
Dialogue: 0,1:03:13.09,1:03:18.50,Default,,0,0,0,,Соңында мен жеңілдім, сондықтан менің болжамым дұрыс болды деп ойлаймын.
Dialogue: 0,1:03:18.50,1:03:22.80,Default,,0,0,0,,Туған жерімде жеңілгеніме таң қалдым, бірақ бұл үлкен тәжірибе болды.
Dialogue: 0,1:03:22.80,1:03:26.14,Default,,0,0,0,,Әкең екеуің керемет жансыңдар.
Dialogue: 0,1:03:26.14,1:03:30.61,Default,,0,0,0,,Бір жерде қайталап көрейік. Мен өз дағдыларымды шыңдаймын. Сонда кездескенше.
Dialogue: 0,1:03:30.61,1:03:45.61,Default,,0,0,0,,♪♪~
Dialogue: 0,1:03:53.36,1:03:56.07,Default,,0,0,0,,Уау, бүгін күн суық.
Dialogue: 0,1:03:56.07,1:03:59.00,Default,,0,0,0,,Такуми, сізде жылытқыштар бар ма?
Dialogue: 0,1:03:59.00,1:04:03.17,Default,,0,0,0,,Эй, бұл маған ұнамайды. Суық
Dialogue: 0,1:04:03.17,1:04:05.67,Default,,0,0,0,,Ауа соғады
Dialogue: 0,1:04:07.64,1:04:11.48,Default,,0,0,0,,Такуми, оқу бітіргеннен кейін не істеуді жоспарлайсыз?
Dialogue: 0,1:04:11.48,1:04:14.38,Default,,0,0,0,,Мектеп бітіру?... Дұрыс.
Dialogue: 0,1:04:14.38,1:04:17.29,Default,,0,0,0,,Сіз университетке түсуді жоспарламайсыз, солай ма?
Dialogue: 0,1:04:17.29,1:04:20.19,Default,,0,0,0,,Ал, сіз кәсіптік училищеге немесе басқа нәрсеге баруды жоспарлап отырсыз ба?
Dialogue: 0,1:04:20.19,1:04:23.93,Default,,0,0,0,,Егер сіз әлі шешім қабылдамаған болсаңыз...
Dialogue: 0,1:04:23.93,1:04:26.73,Default,,0,0,0,,Менімен осында келіп, жұмысқа тұрғың келе ме?
Dialogue: 0,1:04:26.73,1:04:29.13,Default,,0,0,0,,Мұнда?
Dialogue: 0,1:04:29.13,1:04:33.50,Default,,0,0,0,,Мен дүкен менеджерінен сәуір айынан бастап мені толық уақытты қызметкер етуді сұрадым.
Dialogue: 0,1:04:33.50,1:04:37.74,Default,,0,0,0,,Мен ойладым, сен де солай істеу керек.
Dialogue: 0,1:04:37.74,1:04:40.38,Default,,0,0,0,,Иә... Мен ойсыз жүргенімде...
Dialogue: 0,1:04:40.38,1:04:42.88,Default,,0,0,0,,Уақыт өтіп жатыр.
Dialogue: 0,1:04:46.18,1:04:48.18,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,1:04:50.99,1:04:52.99,Default,,0,0,0,,Ах!
Dialogue: 0,1:04:58.53,1:05:01.43,Default,,0,0,0,,Бұрынғыдан сәл өзгеше емес пе? Бұл машина-
Dialogue: 0,1:05:01.43,1:05:05.43,Default,,0,0,0,,Такумидің орындығы бөлек, ол да жүгіріп бара жатқандай.
Dialogue: 0,1:05:07.87,1:05:11.71,Default,,0,0,0,,Эй Такуми-кун, сен Рождествода не істеп жатырсың?
Dialogue: 0,1:05:11.71,1:05:13.64,Default,,0,0,0,,Бөлек
Dialogue: 0,1:05:13.64,1:05:17.25,Default,,0,0,0,,Эй, сен үйіңде той жасап жатқан жоқсың ба?
Dialogue: 0,1:05:17.25,1:05:21.82,Default,,0,0,0,,Мен бала кезімнен Рождество болғандықтан, мен ешқашан ерекше ештеңе жасаған емеспін.
Dialogue: 0,1:05:21.82,1:05:24.12,Default,,0,0,0,,Менің анам жоқ
Dialogue: 0,1:05:25.79,1:05:30.53,Default,,0,0,0,,Жарайды. «Менімен сөйлесу» дегенді қалай түсінесіңдер?
Dialogue: 0,1:05:30.53,1:05:34.06,Default,,0,0,0,,Мен, мен Бенц жігітімен ажырасып кеттім.
Dialogue: 0,1:05:34.06,1:05:37.43,Default,,0,0,0,,Иә, бұл маған қатысты емес.
Dialogue: 0,1:05:37.43,1:05:41.14,Default,,0,0,0,,Бұл шынымен де маңызды емес деп ойласаңыз, бұл өтірік.
Dialogue: 0,1:05:41.14,1:05:43.74,Default,,0,0,0,,Шикато: Мен жасамаймын.
Dialogue: 0,1:05:43.74,1:05:48.04,Default,,0,0,0,,Сіз Нацуки туралы ойлайсыз, сондықтан сіз бұл туралы ойлайсыз, солай ма? —
Dialogue: 0,1:05:48.04,1:05:51.68,Default,,0,0,0,,Жазда бірге жағаға бардық, тіпті сүйісіп те қалдық...
Dialogue: 0,1:05:51.68,1:05:56.32,Default,,0,0,0,,Такуми-кун, сен өзіңді сатқындықпен сезінгендіктен ашуланбайсың ба? —
Dialogue: 0,1:05:56.32,1:05:58.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:06:01.02,1:06:03.02,Default,,0,0,0,,Уф
Dialogue: 0,1:06:10.17,1:06:13.94,Default,,0,0,0,,Суық. Қазірдің өзінде қыс.
Dialogue: 0,1:06:13.94,1:06:18.41,Default,,0,0,0,,Нацуки бұрынғыдай Такумимен қайтадан дос болғысы келеді.
Dialogue: 0,1:06:18.41,1:06:21.31,Default,,0,0,0,,Маған ұнамайды, иә?
Dialogue: 0,1:06:21.31,1:06:24.61,Default,,0,0,0,,Сіз өз ойыңызды оңай өзгерте алмайсыз.
Dialogue: 0,1:06:27.48,1:06:30.28,Default,,0,0,0,,Нацуки де мұны істегісі келмейді.
Dialogue: 0,1:06:33.12,1:06:37.12,Default,,0,0,0,,Мен соңына дейін берілмеймін, Такуми-кунмен міндетті түрде бітісемін.
Dialogue: 0,1:06:46.47,1:06:51.44,Default,,0,0,0,,Менің сізден сұрайын дегенім бар, иә?
Dialogue: 0,1:06:51.44,1:06:55.71,Default,,0,0,0,,Сіз өте байсыз және біреумен кездескіңіз келеді.
Dialogue: 0,1:06:55.71,1:06:59.58,Default,,0,0,0,,Қалағаныңызша табасыз. Бұл сен сияқты емес.
Dialogue: 0,1:06:59.58,1:07:01.88,Default,,0,0,0,,Неге мен?
Dialogue: 0,1:07:05.39,1:07:08.29,Default,,0,0,0,,Ешқандай себеп жоқ.
Dialogue: 0,1:07:08.29,1:07:10.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:12.16,1:07:14.53,Default,,0,0,0,,Бұл сізге ұнағандықтан шешілді!
Dialogue: 0,1:07:14.53,1:07:44.45,Default,,0,0,0,,♪♪~
Dialogue: 0,1:07:46.03,1:07:48.47,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:07:48.47,1:07:50.87,Default,,0,0,0,,Ха, Сенпай!
Dialogue: 0,1:07:50.87,1:07:54.74,Default,,0,0,0,,Бұл ауа райы қар жауатын сияқты.
Dialogue: 0,1:07:54.74,1:07:57.41,Default,,0,0,0,,Бүгін күн суық.
Dialogue: 0,1:07:57.41,1:08:00.38,Default,,0,0,0,,Оның орнына, Ицуки, сен Рождество туралы не істейсің?
Dialogue: 0,1:08:00.38,1:08:04.65,Default,,0,0,0,,«Біз не істеуіміз керек?» Ол қазірдің өзінде шешілген жоқ па?
Dialogue: 0,1:08:04.65,1:08:09.49,Default,,0,0,0,,Сіз достарыңызбен кеш өткізіп жатырсыз ба? Бұл менің орта мектептегі соңғы Рождеством.
Dialogue: 0,1:08:09.49,1:08:12.49,Default,,0,0,0,,Жоқ, бұл толық емес жұмыс күні.
Dialogue: 0,1:08:12.49,1:08:16.09,Default,,0,0,0,,Менің көлігіме арналған Левин шиналары, қысқы шпилькасыз шиналар
Dialogue: 0,1:08:16.09,1:08:18.63,Default,,0,0,0,,Мен саған киіміңді ауыстыруға рұқсат беруім керек.
Dialogue: 0,1:08:18.63,1:08:22.23,Default,,0,0,0,,Хахахаха мен сол кездегідеймін.
Dialogue: 0,1:08:22.23,1:08:26.43,Default,,0,0,0,,Сонымен Такуми ше? Ах Такуми
Dialogue: 0,1:08:28.84,1:08:31.64,Default,,0,0,0,,Бұл жерде қорқынышты нәрсе бар. Бұл өте бұлыңғыр.
Dialogue: 0,1:08:31.64,1:08:33.84,Default,,0,0,0,,Бүгінгі күн ерекше
Dialogue: 0,1:08:46.62,1:08:50.96,Default,,0,0,0,,Әй, қария, мен... А?
Dialogue: 0,1:08:50.96,1:08:55.23,Default,,0,0,0,,Жақында оқуды бітіресің, солай ма? Сонымен...
Dialogue: 0,1:08:55.23,1:08:58.13,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз, иә?
Dialogue: 0,1:08:59.40,1:09:03.10,Default,,0,0,0,,Сіз қандай болсаңыз да, тофу дүкені боласыз ба, жоқ па.
Dialogue: 0,1:09:05.21,1:09:07.11,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,1:09:22.43,1:09:26.30,Default,,0,0,0,,Кейбір адамдар түнде бос болады.
Dialogue: 0,1:09:26.30,1:09:29.20,Default,,0,0,0,,Басқа баратын жеріңіз жоқ па? (Кенджи) Эххе, жоқ...
Dialogue: 0,1:09:29.20,1:09:32.94,Default,,0,0,0,,Осылай десең, хаха, жарайды, солай емес пе?
Dialogue: 0,1:09:32.94,1:09:35.64,Default,,0,0,0,,Бүгін қайда барсам да, жалғыз болу қиын.
Dialogue: 0,1:09:35.64,1:09:40.48,Default,,0,0,0,,Оңға қарасаң да, солға қарасаң да, жұптар көп.
Dialogue: 0,1:09:40.48,1:09:44.75,Default,,0,0,0,,Осындай күні бәріміз далаға шығып, дәмді тамақ ішейік.
Dialogue: 0,1:09:44.75,1:09:48.05,Default,,0,0,0,,Бұл да жақсы. Балалар сендер не істейсіңдер?
Dialogue: 0,1:09:48.05,1:09:50.95,Default,,0,0,0,,Әрине барамын, боспын.
Dialogue: 0,1:09:50.95,1:09:54.82,Default,,0,0,0,,Такуми туралы не деуге болады? Менің ақшам жоқ, сондықтан мен жұмыстан шығамын.
Dialogue: 0,1:09:54.82,1:10:00.62,Default,,0,0,0,,Не болып жатыр? Сіз бұрынғыдай нашарсыз, солай емес пе?
Dialogue: 0,1:10:08.91,1:10:14.31,Default,,0,0,0,,Хахахаха... Тофу дүкені Tofu—
Dialogue: 0,1:10:14.31,1:10:19.98,Default,,0,0,0,,Міне болды! Ақыры таптым хахаха...
Dialogue: 0,1:10:19.98,1:10:22.32,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,1:10:22.32,1:10:24.75,Default,,0,0,0,,Күн суып барады.
Dialogue: 0,1:10:24.75,1:10:29.99,Default,,0,0,0,,Хм, бұл кезде тауда қар бар, солай ма?
Dialogue: 0,1:10:29.99,1:10:32.46,Default,,0,0,0,,А... анау тофу... солай емес пе?
Dialogue: 0,1:10:32.46,1:10:36.13,Default,,0,0,0,,Мен... Мен Такумидің досымын.
Dialogue: 0,1:10:36.13,1:10:40.14,Default,,0,0,0,,Аа, ол толық емес жұмыс күнін әлі қайтқан жоқ.
Dialogue: 0,1:10:40.14,1:10:45.68,Default,,0,0,0,,Иә!? Солай ма? мм...
Dialogue: 0,1:10:45.68,1:10:49.15,Default,,0,0,0,,Иә? О, жоқ, жақсы
Dialogue: 0,1:10:49.15,1:10:52.55,Default,,0,0,0,,Бұл ештеңе емес, кешіріңіз.
Dialogue: 0,1:10:57.79,1:10:59.79,Default,,0,0,0,,Ех...
Dialogue: 0,1:11:01.59,1:11:05.09,Default,,0,0,0,,Саудагер ханым сияқты нәрсе.
Dialogue: 0,1:11:07.23,1:11:10.90,Default,,0,0,0,,Білесіз бе, сіздің жүгіңіз ауыр көрінеді.
Dialogue: 0,1:11:10.90,1:11:13.34,Default,,0,0,0,,Ұлымның бір ісі болса...
Dialogue: 0,1:11:13.34,1:11:17.27,Default,,0,0,0,,Менің ойымша, ол жақында келеді, сондықтан жоғарыға шығып, шай ішіңіз.
Dialogue: 0,1:11:17.27,1:11:19.47,Default,,0,0,0,,Иә! Жарайды ма?
Dialogue: 0,1:11:24.68,1:11:27.88,Default,,0,0,0,,Рождество өте қызықсыз
Dialogue: 0,1:11:30.12,1:11:32.42,Default,,0,0,0,,Менде тек шай бар.
Dialogue: 0,1:11:32.42,1:11:36.19,Default,,0,0,0,,Иә, үлкен жүк деген осы.
Dialogue: 0,1:11:36.19,1:11:40.43,Default,,0,0,0,,Сүйкімді емес пе? Қараңдаршы, мына ағаштың мынадай айласы бар.
Dialogue: 0,1:11:40.43,1:11:45.64,Default,,0,0,0,,Бұл әдемі, солай емес пе? Хачироку
Dialogue: 0,1:11:45.64,1:11:48.54,Default,,0,0,0,,Бұл қолдан жасалған. Мен жасадым.
Dialogue: 0,1:11:48.54,1:11:51.91,Default,,0,0,0,,Такуми бұл көлікті жақсы көретін сияқты.
Dialogue: 0,1:11:51.91,1:11:56.58,Default,,0,0,0,,Хмм... Такуми, кешігіп қалдың. Сен қайда жүрсің?
Dialogue: 0,1:11:56.58,1:11:58.55,Default,,0,0,0,,Кездесу сағат нешеде?
Dialogue: 0,1:11:58.55,1:12:02.39,Default,,0,0,0,,Жоқ, бұл уәде емес.
Dialogue: 0,1:12:02.39,1:12:05.29,Default,,0,0,0,,Бұл алдын ала жазылусыз Рождестволық кеш.
Dialogue: 0,1:12:05.29,1:12:07.29,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:09.03,1:12:11.73,Default,,0,0,0,,Бұл (қызметші) Иә.
Dialogue: 0,1:12:20.04,1:12:23.31,Default,,0,0,0,,Мен бұл туралы біраз уақыт ойладым, бірақ сіз жиі...
Dialogue: 0,1:12:23.31,1:12:26.34,Default,,0,0,0,,Сені шақырған қыз емес пе? Иә
Dialogue: 0,1:12:26.34,1:12:28.88,Default,,0,0,0,,PUTSURI Мен қоңырауларды қабылдауды тоқтаттым.
Dialogue: 0,1:12:28.88,1:12:32.08,Default,,0,0,0,,Мен не болды деп ойладым.
Dialogue: 0,1:12:32.08,1:12:34.48,Default,,0,0,0,,Такуми-кунға бірнеше жағдай болды.
Dialogue: 0,1:12:34.48,1:12:36.72,Default,,0,0,0,,Мені жек көргендей.
Dialogue: 0,1:12:36.72,1:12:39.16,Default,,0,0,0,,Хамф, сен оқуды осылай бітіресің бе?
Dialogue: 0,1:12:39.16,1:12:42.63,Default,,0,0,0,,Маған ұнамайды, бірақ мен қатты тырысамын.
Dialogue: 0,1:12:42.63,1:12:45.53,Default,,0,0,0,,Маған қиын, Такуми-кун, мені кешіру.
Dialogue: 0,1:12:45.53,1:12:50.30,Default,,0,0,0,,Мен қандай жағдайда екенін білмеймін, бірақ кешіремін бе, жоқ па?
Dialogue: 0,1:12:50.30,1:12:54.04,Default,,0,0,0,,Сіз бұлай бастық бола алмайсыз, Такуми...
Dialogue: 0,1:12:54.04,1:12:56.07,Default,,0,0,0,,Мүмкін ол сізге шындап қарайтын шығар...
Dialogue: 0,1:12:56.07,1:12:59.84,Default,,0,0,0,,Бала болса да сені жек көрмейді деп ойлаймын.
Dialogue: 0,1:12:59.84,1:13:02.78,Default,,0,0,0,,Оның қыңыр қарт сияқты көрінетін бір қасиеті бар...
Dialogue: 0,1:13:02.78,1:13:06.62,Default,,0,0,0,,Алып-соғып алған соң, иығымды, шынтағымды жиектеп қоятын әдетім бар.
Dialogue: 0,1:13:06.62,1:13:10.25,Default,,0,0,0,,Оның үстіне мұндай жағдайларда менің көзқарасым мен ойларым әдетте...
Dialogue: 0,1:13:10.25,1:13:13.05,Default,,0,0,0,,Барлық жерде.
Dialogue: 0,1:13:22.83,1:13:25.73,Default,,0,0,0,,≪(Есіктің ашылған және жабылған дыбысы) Мен үйдемін.
Dialogue: 0,1:13:28.14,1:13:31.44,Default,,0,0,0,,Иә? Біреу келе ме деп ойлаймын
Dialogue: 0,1:13:31.44,1:13:34.81,Default,,0,0,0,,Уау!
Dialogue: 0,1:13:34.81,1:13:38.25,Default,,0,0,0,,Рождество мерекесімен! Бұл не? ол
Dialogue: 0,1:13:38.25,1:13:40.18,Default,,0,0,0,,Сол әйел қалдырып кеткен тамақ… міне, сол ғой, иә?
Dialogue: 0,1:13:40.18,1:13:43.79,Default,,0,0,0,,≪Ой... Әке, не істеп жатырсыз?
Dialogue: 0,1:13:43.79,1:13:46.66,Default,,0,0,0,,≪Рождество мерекесімен!
Dialogue: 0,1:13:46.66,1:13:51.49,Default,,0,0,0,,Бұл қызық екен. Бұдан әрі не істеуіміз керек?
Dialogue: 0,1:13:51.49,1:13:54.86,Default,,0,0,0,,Оның ішінде тіпті алкоголь де жоқ.
Dialogue: 0,1:13:54.86,1:13:57.77,Default,,0,0,0,,Жалғыз (Кенджи) Қайғылы
Dialogue: 0,1:13:57.77,1:13:59.70,Default,,0,0,0,,Мако-чан (Кенджи) Әй?
Dialogue: 0,1:13:59.70,1:14:03.87,Default,,0,0,0,,Әйтеуір, жүйрікке әйел керек емес қой!
Dialogue: 0,1:14:03.87,1:14:06.64,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:06.64,1:14:10.58,Default,,0,0,0,,Такуми-кун, ағашты сол жерге қой. А... аа.
Dialogue: 0,1:14:10.58,1:14:14.45,Default,,0,0,0,,Нацуки кішкентай кезінен бастап Рождествоны жақсы көреді.
Dialogue: 0,1:14:14.45,1:14:18.92,Default,,0,0,0,,Сондықтан мен Рождествоны Такумимен бірге өткізгім келді.
Dialogue: 0,1:14:18.92,1:14:20.86,Default,,0,0,0,,Қараңызшы, сіз бір кездері осылай дедіңіз, солай ма? —
Dialogue: 0,1:14:20.86,1:14:23.33,Default,,0,0,0,,«Мен бұрын ешқашан Рождество тойлаған емеспін».
Dialogue: 0,1:14:23.33,1:14:26.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:26.23,1:14:30.73,Default,,0,0,0,,≪Ахаха, онда торт жейміз! Торт!
Dialogue: 0,1:14:30.73,1:14:33.64,Default,,0,0,0,,≪(Такуми/Бунта) О ≪Шамды жағыңыз.
Dialogue: 0,1:14:33.64,1:14:36.64,Default,,0,0,0,,Әке от ех
Dialogue: 0,1:14:39.91,1:14:42.51,Default,,0,0,0,,Мен жарықты өшіремін, аа
Dialogue: 0,1:14:42.51,1:14:44.45,Default,,0,0,0,,О...
Dialogue: 0,1:14:44.45,1:14:58.25,Default,,0,0,0,,♪♪~
Dialogue: 0,1:15:06.14,1:15:09.04,Default,,0,0,0,,≪(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:15:09.04,1:15:12.74,Default,,0,0,0,,Не? Әке, ұйықтап қалдыңыз ба?
Dialogue: 0,1:15:18.21,1:15:20.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:21.85,1:15:24.85,Default,,0,0,0,,《Такуми-кун, оқу бітірген соң не істейсің? 》
Dialogue: 0,1:15:24.85,1:15:28.26,Default,,0,0,0,,《Мен әлі шешкен жоқпын. Моги шешім қабылдады ма? 》
Dialogue: 0,1:15:28.26,1:15:32.20,Default,,0,0,0,,《Мен? Осы уақытқа дейін мен өзімді жеңіл сезінемін, бірақ...
Dialogue: 0,1:15:32.20,1:15:34.76,Default,,0,0,0,,Мен бұлай жүре алмаймын деп ойладым.
Dialogue: 0,1:15:34.76,1:15:37.20,Default,,0,0,0,,《Мен не істегім келетінін тапқым келеді》
Dialogue: 0,1:15:37.20,1:15:41.30,Default,,0,0,0,,《Сондықтан мен Токиодағы мектепке баруды шештім》
Dialogue: 0,1:15:49.04,1:15:51.94,Default,,0,0,0,,Жаңа жыл құтты болсын—
Dialogue: 0,1:15:51.94,1:15:54.84,Default,,0,0,0,,Осы жылы қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,1:15:54.84,1:15:58.55,Default,,0,0,0,,Құттықтаймын. Мен сені осы жылы тағы көремін деп үміттенемін.
Dialogue: 0,1:15:58.55,1:16:01.35,Default,,0,0,0,,Жаңа жылда тұтынушылар өте көп, сондықтан барлығыңыз қолыңыздан келгеннің бәрін жасаңыз.
Dialogue: 0,1:16:01.35,1:16:05.22,Default,,0,0,0,,Маған қалдырыңыз. Менеджер (Икейя) Сен өте ынталысың, Ицуки.
Dialogue: 0,1:16:05.22,1:16:07.89,Default,,0,0,0,,Дұрыс. Мен сәуір айынан бері осындамын.
Dialogue: 0,1:16:07.89,1:16:10.59,Default,,0,0,0,,Сіз толық уақытты қызметкер ретінде жұмыс істейсіз.
Dialogue: 0,1:16:10.59,1:16:13.16,Default,,0,0,0,,Ах! Мен ол жерді әлі тазалаған жоқпын.
Dialogue: 0,1:16:13.16,1:16:16.37,Default,,0,0,0,,Ицукимен сәуірден бері күнде осында кездесесің бе?
Dialogue: 0,1:16:16.37,1:16:19.24,Default,,0,0,0,,Мен бақытты немесе мұңайған сияқтымын.
Dialogue: 0,1:16:19.24,1:16:21.17,Default,,0,0,0,,Хахахаха... Ой қарашы, Такуми
Dialogue: 0,1:16:21.17,1:16:23.87,Default,,0,0,0,,Ол жерде отырмаңыз Терезе тазалау Терезе тазалау
Dialogue: 0,1:16:23.87,1:16:26.64,Default,,0,0,0,,Жұмысты өзіңіз табуыңыз керек.
Dialogue: 0,1:16:26.64,1:16:30.11,Default,,0,0,0,,Әй, олай деме, қоғам мүшесі ретінде дайын болуың керек...
Dialogue: 0,1:16:30.11,1:16:35.61,Default,,0,0,0,,Бұл басқаша. Такуми деген кім? (Икетани мен Юичидің күлкісі)
Dialogue: 0,1:16:39.56,1:16:41.96,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,1:16:44.96,1:16:48.20,Default,,0,0,0,,Рахмет (менеджер) Жарайды, Нацуки-чан.
Dialogue: 0,1:16:48.20,1:16:51.17,Default,,0,0,0,,Жаңа жыл болса да, еңбектеніп жатырсың.
Dialogue: 0,1:16:51.17,1:16:53.40,Default,,0,0,0,,Не? (Менеджер) Біздің де көңіл көтеруге жоспарымыз бар.
Dialogue: 0,1:16:53.40,1:16:56.31,Default,,0,0,0,,солай емес пе? Жарайды
Dialogue: 0,1:16:56.31,1:16:59.98,Default,,0,0,0,,Дәл қазір толық емес жұмыс күні қызық. (Менеджер) О, иә.
Dialogue: 0,1:16:59.98,1:17:02.38,Default,,0,0,0,,Мен толық емес жұмыс істегенде ғана түсіндім.
Dialogue: 0,1:17:02.38,1:17:06.72,Default,,0,0,0,,Жұмыс істеп, ақша табу шынымен қиын.
Dialogue: 0,1:17:06.72,1:17:10.42,Default,,0,0,0,,Хмм... жақсы, қош келдіңіз.
Dialogue: 0,1:17:10.42,1:17:12.36,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:17:12.36,1:17:16.53,Default,,0,0,0,,Не тапсырыс беруім керек? Сіз шешім қабылдағаннан кейін ...
Dialogue: 0,1:17:16.53,1:17:18.90,Default,,0,0,0,,Нацуки? иә?
Dialogue: 0,1:17:18.90,1:17:24.63,Default,,0,0,0,,Не болды? Суық емес пе? Менің бетімді ұмыттың ба?
Dialogue: 0,1:17:24.63,1:17:26.73,Default,,0,0,0,,Әй, Мики-сенпай.
Dialogue: 0,1:17:29.24,1:17:31.84,Default,,0,0,0,,Әзірше мен сізге чизбургер мен шейк алып берейін.
Dialogue: 0,1:17:31.84,1:17:35.55,Default,,0,0,0,,Ах... иә, чизбургер мен шейк барлығы бір жерде.
Dialogue: 0,1:17:35.55,1:17:37.98,Default,,0,0,0,,Ах
Dialogue: 0,1:17:37.98,1:17:40.05,Default,,0,0,0,,Толық емес жұмыс күніңізден кейін көлікке барғыңыз келе ме?
Dialogue: 0,1:17:40.05,1:17:44.52,Default,,0,0,0,,Мен оны сізге жіберемін. Мәселе жоқ.
Dialogue: 0,1:17:44.52,1:17:47.42,Default,,0,0,0,,Не, сен күзеттесің бе?
Dialogue: 0,1:17:47.42,1:17:50.33,Default,,0,0,0,,Оны жинап жеу туралы ойлама!
Dialogue: 0,1:17:50.33,1:17:54.53,Default,,0,0,0,,Мен... Жарайды, бүгін тез бітеді.
Dialogue: 0,1:17:58.87,1:18:01.80,Default,,0,0,0,,≪(Мики) Мен жаңа жылдық мерекелерге қайта келдім...
Dialogue: 0,1:18:01.80,1:18:05.27,Default,,0,0,0,,Сенің толық емес жұмыс күнің бар екеніне таң қалдым.
Dialogue: 0,1:18:05.27,1:18:08.01,Default,,0,0,0,,Бірдеңе басқаша сезіледі, сенпай.
Dialogue: 0,1:18:08.01,1:18:11.28,Default,,0,0,0,,Шынымен бе? Бұл қалыпты, бұл қалыпты -
Dialogue: 0,1:18:11.28,1:18:14.65,Default,,0,0,0,,Сіз де өзгердіңіз. Мен сенің жетілгеніңді айтар едім.
Dialogue: 0,1:18:14.65,1:18:18.82,Default,,0,0,0,,Сіз бұрынғыдан да сексуалдысыз. Сіз еркексіз бе?
Dialogue: 0,1:18:18.82,1:18:21.72,Default,,0,0,0,,Мұның сіздің үлкендеріңізге ешқандай қатысы жоқ, солай ма?
Dialogue: 0,1:18:21.72,1:18:25.43,Default,,0,0,0,,Не? Осылайша сіз бұл сізді еркек етпейді деп айтасыз.
Dialogue: 0,1:18:25.43,1:18:27.80,Default,,0,0,0,,Олай болса, менімен бірге бол.
Dialogue: 0,1:18:27.80,1:18:30.83,Default,,0,0,0,,Бұрынғыдай тағы да қызықты нәрселерді жасайық.
Dialogue: 0,1:18:30.83,1:18:34.04,Default,,0,0,0,,Сен мені ұмыта алмайсың, солай ма?
Dialogue: 0,1:18:34.04,1:18:38.54,Default,,0,0,0,,Осы жерден тоқтаңыз. (Мики) Не істеп жатырсың? Сен ашулысың ба?
Dialogue: 0,1:18:38.54,1:18:42.31,Default,,0,0,0,,Сенпай: Кешіріңіз, бірақ Нацуки онымен кездескісі келмейді.
Dialogue: 0,1:18:42.31,1:18:44.25,Default,,0,0,0,,Сіз кіммен кездесесіз?
Dialogue: 0,1:18:44.25,1:18:47.58,Default,,0,0,0,,Менде ешкім жоқ, бірақ дәл қазір маған қатты ұнайтын адам бар.
Dialogue: 0,1:18:47.58,1:18:50.49,Default,,0,0,0,,Өйткені ол өте маңызды адам (Мики) Уф.
Dialogue: 0,1:18:50.49,1:18:52.42,Default,,0,0,0,,Сонымен... (қозғалтқыш дыбысы)
Dialogue: 0,1:18:52.42,1:18:54.32,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:58.56,1:19:02.13,Default,,0,0,0,,Жоқ! Тоқта, сенпай
Dialogue: 0,1:19:02.13,1:19:05.03,Default,,0,0,0,,Жарайды, тағы біраз отырайық.
Dialogue: 0,1:19:05.03,1:19:08.74,Default,,0,0,0,,Маған осы маңызды тұлғаның, Эноның тарихын айтып беріңіз.
Dialogue: 0,1:19:08.74,1:19:11.24,Default,,0,0,0,,《Бұл адам қорқынышты》
Dialogue: 0,1:19:17.95,1:19:20.55,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Алдын ала кешірім сұраймын.
Dialogue: 0,1:19:22.72,1:19:27.62,Default,,0,0,0,,Әй, жаңбыр жауып тұр. Дұрыс, Такуми.
Dialogue: 0,1:19:27.62,1:19:31.39,Default,,0,0,0,,Неге маған келмейсің? Иә, екеуі де жақсы.
Dialogue: 0,1:19:31.39,1:19:33.70,Default,,0,0,0,,Бәрібір үйге жеткенде істейтін ештеңе жоқ, солай ма?
Dialogue: 0,1:19:33.70,1:19:35.80,Default,,0,0,0,,Иә
Dialogue: 0,1:19:38.53,1:19:40.77,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:19:40.77,1:19:46.41,Default,,0,0,0,,Ұзақ сөйлесейік, алыс жерде.
Dialogue: 0,1:19:46.41,1:19:48.34,Default,,0,0,0,,Түн ұзақ
Dialogue: 0,1:19:48.34,1:19:51.65,Default,,0,0,0,,《Такуми-кун》 Ха
Dialogue: 0,1:19:51.65,1:19:56.05,Default,,0,0,0,,Сол кезде Икейа-сенпай, ә? Такуми не болды?
Dialogue: 0,1:19:56.05,1:19:58.99,Default,,0,0,0,,Мен мұны бүгін жасамаймын деп ойлаймын. Неліктен?
Dialogue: 0,1:19:58.99,1:20:01.02,Default,,0,0,0,,Әйтеуір, маған ұнамайды.
Dialogue: 0,1:20:01.02,1:20:03.93,Default,,0,0,0,,Оның үстіне әкем жаңа жылдық кешке барады.
Dialogue: 0,1:20:03.93,1:20:07.03,Default,,0,0,0,,Мен оның мас болып, ''Мені көлікке мінгізіп алшы'' деп айтатынына сенімдімін.
Dialogue: 0,1:20:07.03,1:20:10.33,Default,,0,0,0,,Мені жалғыз қалдырыңыз.
Dialogue: 0,1:20:11.73,1:20:15.43,Default,,0,0,0,,Тексеріңіз, қарияны артта қалдыратын кез келді.
Dialogue: 0,1:20:17.17,1:20:19.37,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,1:20:21.54,1:20:26.38,Default,,0,0,0,,Нацуки! Біз бірге көңіл көтеретінбіз, солай емес пе?
Dialogue: 0,1:20:26.38,1:20:30.25,Default,,0,0,0,,Менің сұрағанымның бәрін орындадың, солай емес пе?
Dialogue: 0,1:20:30.25,1:20:33.82,Default,,0,0,0,,Бұрынғыдай? Жақсы емес пе?
Dialogue: 0,1:20:33.82,1:20:36.66,Default,,0,0,0,,Жоқ! (Мики) Неге?
Dialogue: 0,1:20:36.66,1:20:38.59,Default,,0,0,0,,Ол кездегі мен қазіргінің айырмашылығы неде?
Dialogue: 0,1:20:38.59,1:20:41.80,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,1:20:41.80,1:20:44.20,Default,,0,0,0,,≪(Түрту дыбысы) ≪Уф
Dialogue: 0,1:20:45.23,1:20:47.17,Default,,0,0,0,,Шатаспаңыз! Сіз
Dialogue: 0,1:20:47.17,1:20:49.81,Default,,0,0,0,,Сіз қашаннан бері қызықсыз әйел болдыңыз?
Dialogue: 0,1:20:49.81,1:20:53.68,Default,,0,0,0,,Бұрын жеңілірек, епті әйел болған.
Dialogue: 0,1:20:53.68,1:20:57.98,Default,,0,0,0,,Өзіңізге шынымен ұнайтын адамды тапқанда, бәрі өзгереді.
Dialogue: 0,1:20:57.98,1:21:01.55,Default,,0,0,0,,Немесе… немесе… Оны жақсы ойнамаңыз.
Dialogue: 0,1:21:01.55,1:21:03.29,Default,,0,0,0,,Боқ... ха
Dialogue: 0,1:21:03.29,1:21:06.12,Default,,0,0,0,,Хехехе
Dialogue: 0,1:21:06.12,1:21:09.82,Default,,0,0,0,,(Микидің айқайлауы)
Dialogue: 0,1:21:11.46,1:21:16.33,Default,,0,0,0,,≪[TEL] (рингтон)
Dialogue: 0,1:21:16.33,1:21:30.25,Default,,0,0,0,,♪♪~
Dialogue: 0,1:21:30.25,1:21:33.88,Default,,0,0,0,,Уау, алдыңда, күте тұр...
Dialogue: 0,1:21:33.88,1:21:38.12,Default,,0,0,0,,Сәлем! Нацуки! Хахаха...
Dialogue: 0,1:21:38.12,1:21:40.06,Default,,0,0,0,,≪[TEL] (рингтон)
Dialogue: 0,1:21:40.06,1:21:43.43,Default,,0,0,0,,《Такуми-кун, шықшы өтінемін! 》
Dialogue: 0,1:21:43.43,1:21:46.80,Default,,0,0,0,,Қарғыс атсын, ауырады... Шүкір—
Dialogue: 0,1:21:46.80,1:21:50.20,Default,,0,0,0,,Хе! Мен қашып құтыла алмаймын
Dialogue: 0,1:21:51.93,1:21:55.17,Default,,0,0,0,,≪[TEL] (рингтон)
Dialogue: 0,1:21:55.17,1:21:59.04,Default,,0,0,0,,《Такуми-кун, тез шықшы》
Dialogue: 0,1:21:59.04,1:22:01.44,Default,,0,0,0,,Хаха хехехе...
Dialogue: 0,1:22:02.91,1:22:05.71,Default,,0,0,0,,Иә Сәлем Моши [ТЕЛ] Маған көмектесші, Такуми-кун! —
Dialogue: 0,1:22:05.71,1:22:07.78,Default,,0,0,0,,Көл... Kya Huh? —
Dialogue: 0,1:22:07.78,1:22:10.92,Default,,0,0,0,,Сәлеметсіз бе, Моги?
Dialogue: 0,1:22:10.92,1:22:13.62,Default,,0,0,0,,Сәлеметсіз бе, не? Не болды?
Dialogue: 0,1:22:13.62,1:22:16.53,Default,,0,0,0,,Моши Моши Моши Моши
Dialogue: 0,1:22:16.53,1:22:20.90,Default,,0,0,0,,Сіз өзіңізді қалжыңдаймын деп ойламайсыз ба? көл?
Dialogue: 0,1:22:20.90,1:22:22.90,Default,,0,0,0,,Акина көлі!
Dialogue: 0,1:22:26.07,1:22:30.67,Default,,0,0,0,,Жаңа ғана "Такуми" дедіңіз бе? Мен сене алар емеспін...
Dialogue: 0,1:22:30.67,1:22:33.21,Default,,0,0,0,,Бұл Фудзивара туралы емес, солай емес пе?
Dialogue: 0,1:22:33.21,1:22:37.51,Default,,0,0,0,,Хмм, бұл бет осылай көрінеді.
Dialogue: 0,1:22:37.51,1:22:41.38,Default,,0,0,0,,Қарғыс атсын! Бұл дұрыс емес, Нацуки
Dialogue: 0,1:22:41.38,1:22:44.78,Default,,0,0,0,,Фудзиварамен жақсы араласасыз ба?
Dialogue: 0,1:22:45.92,1:22:49.33,Default,,0,0,0,,《Уайымдама, олай сөйлеуді доғар》
Dialogue: 0,1:22:49.33,1:22:53.26,Default,,0,0,0,,《Не? Такуми алдыңғы қатарда, жоғарғы сынып оқушыларымен бетпе-бет келеді.
Dialogue: 0,1:22:53.26,1:22:57.13,Default,,0,0,0,,Сөйлесуің... уау》
Dialogue: 0,1:22:57.13,1:23:00.87,Default,,0,0,0,,Эй, тіпті есіме түсіргім де келмейді.
Dialogue: 0,1:23:00.87,1:23:02.81,Default,,0,0,0,,Тағы да... (Мики) Иә?
Dialogue: 0,1:23:02.81,1:23:05.57,Default,,0,0,0,,Мені Такуми-кун ұрады.
Dialogue: 0,1:23:05.57,1:23:11.75,Default,,0,0,0,,Бұл! Ей, егер сіз көмекке шақыратын болсаңыз, басқа адам туралы ойлаңыз.
Dialogue: 0,1:23:11.75,1:23:16.12,Default,,0,0,0,,Фудзивара осы уақытқа дейін келе ала ма? Оның тіпті көлігі де жоқ.
Dialogue: 0,1:23:16.12,1:23:20.09,Default,,0,0,0,,Мен келемін, Такуми-кун, өйткені сен тау жолдарында жылдам жүгіресің.
Dialogue: 0,1:23:20.09,1:23:23.79,Default,,0,0,0,,Сіздің көлігіңіз бар ма? Кеттік... Жүріңдер.
Dialogue: 0,1:23:23.79,1:23:27.23,Default,,0,0,0,,Ой! Жібер (Мики), көлікке отыр.
Dialogue: 0,1:23:27.23,1:23:30.27,Default,,0,0,0,,Мені тартпа (Мики) Тезірек.
Dialogue: 0,1:23:30.27,1:23:32.40,Default,,0,0,0,,Ауырады, ауырады, тоқтат.
Dialogue: 0,1:23:32.40,1:23:47.95,Default,,0,0,0,,♪♪~
Dialogue: 0,1:23:47.95,1:23:50.39,Default,,0,0,0,,≪Қайда бара жатырсың? ≪(Мики) Сіз осында болдыңыз.
Dialogue: 0,1:23:50.39,1:23:54.76,Default,,0,0,0,,Кедергі болуы мүмкін, сондықтан таудан түсіп, орындарын ауыстырыңыз.
Dialogue: 0,1:23:54.76,1:23:59.40,Default,,0,0,0,,Дайын бол, көңілім тоймайынша, мен сені үйге жібермеймін.
Dialogue: 0,1:23:59.40,1:24:04.30,Default,,0,0,0,,《Бұл адам қатты кесілген. Не істеуім керек? Такуми-кун...》
Dialogue: 0,1:24:04.30,1:24:29.43,Default,,0,0,0,,♪♪~
Dialogue: 0,1:24:29.43,1:24:31.93,Default,,0,0,0,,《Кел, Такуми-кун》
Dialogue: 0,1:24:31.93,1:25:20.64,Default,,0,0,0,,♪♪~
Dialogue: 0,1:25:20.64,1:25:25.05,Default,,0,0,0,,Такуми-кун! (Мики) Өтірік айтасың!? Әлі ерте.
Dialogue: 0,1:25:25.05,1:25:38.93,Default,,0,0,0,,♪♪~
Dialogue: 0,1:25:38.93,1:25:42.33,Default,,0,0,0,,Такуми-кун, сен Нацукиге келдің.
Dialogue: 0,1:25:42.33,1:25:46.83,Default,,0,0,0,,Әй, бұл қандай көлік?
Dialogue: 0,1:25:47.90,1:25:50.57,Default,,0,0,0,,≪(Нацукидің айқайы) ≪(Мики) Осындай дрейфпен...
Dialogue: 0,1:25:50.57,1:25:52.51,Default,,0,0,0,,Айқайлама
Dialogue: 0,1:25:52.51,1:25:54.54,Default,,0,0,0,,Нацуки, бұл көңілсіз болды.
Dialogue: 0,1:25:54.54,1:25:58.61,Default,,0,0,0,,Ол көлікте бұл жігіттің артынан жүру мүмкін емес.
Dialogue: 0,1:25:58.61,1:26:02.08,Default,,0,0,0,,Мен Такумиге ілесе аламын, өйткені ол көлік жүргізуді жақсы біледі.
Dialogue: 0,1:26:02.08,1:26:04.02,Default,,0,0,0,,Ей, бұл туралы айтудың қажеті жоқ.
Dialogue: 0,1:26:04.02,1:26:05.99,Default,,0,0,0,,Бұл жақсы немесе жаман болуда емес.
Dialogue: 0,1:26:05.99,1:26:08.59,Default,,0,0,0,,Бұл 4WD.
Dialogue: 0,1:26:08.59,1:26:12.86,Default,,0,0,0,,Қарлы жолдарда 4WD жақсырақ болатыны бүкіл әлемге белгілі.
Dialogue: 0,1:26:12.86,1:26:33.92,Default,,0,0,0,,♪♪~
Dialogue: 0,1:26:33.92,1:26:37.12,Default,,0,0,0,,≪(Мики) Хехе, қарлы жолда сондай керемет жылдамдық.
Dialogue: 0,1:26:37.12,1:26:39.12,Default,,0,0,0,,Содан кейін үш қисық болады.
Dialogue: 0,1:26:39.12,1:26:43.56,Default,,0,0,0,,Фудзивараның көлігі алыс болғандықтан мен оны көрмедім... Уф...
Dialogue: 0,1:26:43.56,1:26:46.43,Default,,0,0,0,,Уау!
Dialogue: 0,1:26:46.43,1:26:48.23,Default,,0,0,0,,
Dialogue: 0,1:26:48.23,1:26:50.53,Default,,0,0,0,,Қарғыс атсын мына ақымақ!
Dialogue: 0,1:26:55.94,1:27:00.18,Default,,0,0,0,,≪(Мики) А... бұл мүмкін емес. 4WD FR сияқты...
Dialogue: 0,1:27:00.18,1:27:03.41,Default,,0,0,0,,Бұл көліктің кінәсі емес. Мүмкін мен жай айдап келе жатқан шығармын.
Dialogue: 0,1:27:03.41,1:27:06.92,Default,,0,0,0,,А... не!? Сіз мені соншалықты алысқа жеткіздіңіз!
Dialogue: 0,1:27:06.92,1:27:09.72,Default,,0,0,0,,≪Алға қарамасаң, апатқа ұшырайсың.≪(Мики) Ах! —
Dialogue: 0,1:27:09.72,1:27:12.62,Default,,0,0,0,,Ах! ≪Қия!
Dialogue: 0,1:27:12.62,1:27:15.52,Default,,0,0,0,,Уф... шіркін! Алтын балық нәжісі – тағам.
Dialogue: 0,1:27:15.52,1:27:18.16,Default,,0,0,0,,...
Dialogue: 0,1:27:18.16,1:27:20.16,Default,,0,0,0,,Ах, жоқ.
Dialogue: 0,1:27:21.06,1:27:23.73,Default,,0,0,0,,Иілуге ​​болмайды
Dialogue: 0,1:27:23.73,1:27:26.13,Default,,0,0,0,,(Мики мен Нацукидің айқайы)
Dialogue: 0,1:27:28.54,1:27:31.24,Default,,0,0,0,,Менен жалтарыңызшы!
Dialogue: 0,1:27:38.35,1:27:40.28,Default,,0,0,0,,Такуми-кун!
Dialogue: 0,1:27:40.28,1:27:42.08,Default,,0,0,0,,Мотеги
Dialogue: 0,1:27:42.08,1:27:44.89,Default,,0,0,0,,Такуми-кун келді.
Dialogue: 0,1:27:44.89,1:27:47.79,Default,,0,0,0,,...
Dialogue: 0,1:27:47.79,1:27:50.29,Default,,0,0,0,,Әйтеуір, мен қатты таң қалдым.
Dialogue: 0,1:27:50.29,1:27:54.16,Default,,0,0,0,,≪Бұл көлік кім? This is someone you know, right?
Dialogue: 0,1:27:54.16,1:27:57.46,Default,,0,0,0,,≪Көлікте сөйлесейік, сосын барайық, Такуми-кун.
Dialogue: 0,1:28:02.87,1:28:05.51,Default,,0,0,0,,≪Сен ашулысың ба? —
Dialogue: 0,1:28:05.51,1:28:10.18,Default,,0,0,0,,Кешіріңіз, Нацуки Мики-сенпайдың көлігіне отырды.
Dialogue: 0,1:28:10.18,1:28:14.45,Default,,0,0,0,,Әсіресе Такуми-кун
Dialogue: 0,1:28:14.45,1:28:18.32,Default,,0,0,0,,Мен сені түсіріп жіберемін, үйге асығыс.
Dialogue: 0,1:28:18.32,1:28:21.72,Default,,0,0,0,,Жоқ, мен бұлай үйге бара алмаймын.
Dialogue: 0,1:28:24.13,1:28:27.83,Default,,0,0,0,,≪Егер қазір айтпасам, енді ешқашан айта алмайтын сияқтымын.
Dialogue: 0,1:28:27.83,1:28:30.43,Default,,0,0,0,,Мен сіздің тыңдағаныңызды қалаймын
Dialogue: 0,1:28:30.43,1:28:35.80,Default,,0,0,0,,Нацукидің бұрын кездескен адамы, Такуми де білетін Бенц жігіті...
Dialogue: 0,1:28:35.80,1:28:39.71,Default,,0,0,0,,—
Dialogue: 0,1:28:39.71,1:28:45.21,Default,,0,0,0,,Нацуки, мен қазір қатты өкінемін.
Dialogue: 0,1:28:45.21,1:28:48.25,Default,,0,0,0,,Сол кезде ақша алудың орнына —
Dialogue: 0,1:28:48.25,1:28:52.82,Default,,0,0,0,,Маңызды нәрсе барған сайын жоғалып бара жатқандай сезіндім...
Dialogue: 0,1:28:52.82,1:28:55.49,Default,,0,0,0,,Нацукидің толық емес жұмыс күнін бастауының нақты себебі...
Dialogue: 0,1:28:55.49,1:28:59.83,Default,,0,0,0,,Өйткені мен жұмыс істесем, жоғалтқан нәрсені қайтарып аламын деп ойладым.
Dialogue: 0,1:28:59.83,1:29:04.37,Default,,0,0,0,,Такуми-кунға, мен сенің осылай жұмыс істеп жатқаныңды көргім келеді.
Dialogue: 0,1:29:04.37,1:29:08.60,Default,,0,0,0,,Себебі мен мұқият қарап, түсінгеніңізді қалаймын.
Dialogue: 0,1:29:08.60,1:29:11.57,Default,,0,0,0,,А, енді жоқ.
Dialogue: 0,1:29:11.57,1:29:15.24,Default,,0,0,0,,Ұлдардың көзінше жылаудың өзі жағымсыз.
Dialogue: 0,1:29:15.24,1:29:17.78,Default,,0,0,0,,Мен ешқашан қаламадым
Dialogue: 0,1:29:17.78,1:29:20.68,Default,,0,0,0,,Бұл ең нашар.
Dialogue: 0,1:29:20.68,1:29:24.55,Default,,0,0,0,,Сен қашаннан бері жылауық болып кеттің? —
Dialogue: 0,1:29:24.55,1:29:28.25,Default,,0,0,0,,Кешіріңіз, кешіріңіз, Такуми-кун.
Dialogue: 0,1:29:33.26,1:29:37.16,Default,,0,0,0,,I also have something to say.
Dialogue: 0,1:29:38.23,1:29:40.43,Default,,0,0,0,,Адал сезімдер
Dialogue: 0,1:29:42.04,1:29:46.94,Default,,0,0,0,,≪Мен сені жақсы көремін
Dialogue: 0,1:30:11.07,1:30:12.93,Default,,0,0,0,,Менімен шайқас!?
Dialogue: 0,1:30:12.93,1:30:16.27,Default,,0,0,0,,Хмм... Иә, өтінемін.
Dialogue: 0,1:30:16.27,1:30:20.64,Default,,0,0,0,,...
Dialogue: 0,1:30:20.64,1:30:23.55,Default,,0,0,0,,Мен мұны келесі шайқаста шешкім келеді.
Dialogue: 0,1:30:23.55,1:30:25.55,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:30:29.08,1:30:31.58,Default,,0,0,0,,Жарайды, қандай шарттар бар?
Dialogue: 0,1:30:32.82,1:30:37.22,Default,,0,0,0,,Риосуке жетекшілік етеді, мен оның соңынан еремін. Орналасқан жері - Акаги.
Dialogue: 0,1:30:39.09,1:30:43.73,Default,,0,0,0,,Мен жеңемін деп ойламаймын, бірақ соңғы рет Акина болды.
Dialogue: 0,1:30:43.73,1:30:47.90,Default,,0,0,0,,Келесі жолы мен оны Риосукенің туған қаласында көргім келеді.
Dialogue: 0,1:30:47.90,1:30:51.81,Default,,0,0,0,,Егер мен мұны істесем, мен жауапты табатын сияқтымын.
Dialogue: 0,1:30:51.81,1:30:55.61,Default,,0,0,0,,Жарайды, мен келесі сенбіні асыға күтемін.
Dialogue: 0,1:30:59.21,1:31:03.05,Default,,0,0,0,,Параметрлерді айта аласыз ба? О
Dialogue: 0,1:31:03.05,1:31:05.62,Default,,0,0,0,,Маған кеңес беріңізші.
Dialogue: 0,1:31:05.62,1:31:08.52,Default,,0,0,0,,Мен мұны өзім сынап көргім келеді.
Dialogue: 0,1:31:14.33,1:31:17.13,Default,,0,0,0,,Келесі жолы оны кіммен жасайсыз?
Dialogue: 0,1:31:17.13,1:31:20.23,Default,,0,0,0,,FC… Жоқ, I
Dialogue: 0,1:31:21.87,1:31:23.87,Default,,0,0,0,,Өзім...
Dialogue: 0,1:31:25.31,1:31:27.91,Default,,0,0,0,,《Міне, бітіру аяқталды》
Dialogue: 0,1:31:29.21,1:31:32.81,Default,,0,0,0,,Олай болса, бастайық! Бар!
Dialogue: 0,1:31:32.81,1:31:37.51,Default,,0,0,0,,(Қозғалтқыш дыбысы және жұмыс дыбысы)
Dialogue: 0,1:31:39.12,1:31:42.02,Default,,0,0,0,,Сонымен... ғажап (Икетани) Көзді ашып-жұмғанша
Dialogue: 0,1:31:42.02,1:31:44.39,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,1:31:44.39,1:31:48.39,Default,,0,0,0,,Бұл Твин Дрифт (Кёичи) Бұл керемет.
Dialogue: 0,1:31:53.74,1:31:56.67,Default,,0,0,0,,《Фудзивараның сезімдері өте айқын.''
Dialogue: 0,1:31:56.67,1:31:59.54,Default,,0,0,0,,Енді сіз өз шегіңіздесіз -
Dialogue: 0,1:31:59.54,1:32:02.34,Default,,0,0,0,,Ол тек жүгіруге шоғырлануы керек.
Dialogue: 0,1:32:08.15,1:32:10.95,Default,,0,0,0,,《Қалай жүгіретініңді көрсетейін》
Dialogue: 0,1:32:16.93,1:32:18.79,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,1:32:18.79,1:32:21.49,Default,,0,0,0,,Ғажайып (Саюки) Мен ессіз қалдым Бұл керемет
Dialogue: 0,1:32:23.97,1:32:25.90,Default,,0,0,0,,Уау! (Наказато) Ах!
Dialogue: 0,1:32:25.90,1:32:28.77,Default,,0,0,0,,ФК керемет, Хачироку да керемет.
Dialogue: 0,1:32:28.77,1:32:31.37,Default,,0,0,0,,Мен оның жүгіруінен аураны сезінемін.
Dialogue: 0,1:32:31.37,1:32:33.91,Default,,0,0,0,,Әй... Эй Цуёси, тым жақындама.
Dialogue: 0,1:32:33.91,1:32:35.98,Default,,0,0,0,,О? (Шинго) Егер сіз танымайтын адам көрсе...
Dialogue: 0,1:32:35.98,1:32:38.35,Default,,0,0,0,,Екеуміздің жақсы араласатынымызды көрмейсің бе?
Dialogue: 0,1:32:38.35,1:32:40.55,Default,,0,0,0,,О, ә...
Dialogue: 0,1:32:46.09,1:32:48.42,Default,,0,0,0,,Сіз қалай ойлайсыз? Кейсуке
Dialogue: 0,1:32:48.42,1:32:52.59,Default,,0,0,0,,Риосуке Кентаның жергілікті жарыста жеңілуі мүмкін емес.
Dialogue: 0,1:32:52.59,1:32:55.13,Default,,0,0,0,,Бірақ ше
Dialogue: 0,1:32:55.13,1:32:57.47,Default,,0,0,0,,Біреуі жақсы, иә?
Dialogue: 0,1:32:57.47,1:33:00.90,Default,,0,0,0,,Бұл шайқаста жеңу немесе жеңілу маңызды емес.
Dialogue: 0,1:33:00.90,1:33:03.81,Default,,0,0,0,,Екеуін де байыппен жүргізсеңіз, бәрі жақсы.
Dialogue: 0,1:33:03.81,1:33:05.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:05.74,1:33:10.44,Default,,0,0,0,,Мен байыпты жүгіре алатын екеуін қызғанамын.
Dialogue: 0,1:33:13.48,1:33:15.88,Default,,0,0,0,,Ғажайып Күтілгендей, таңқаларлық
Dialogue: 0,1:33:17.89,1:33:21.59,Default,,0,0,0,,《Ол Акинаның күндерімен салыстыруға келмейтіндей дамыды.》
Dialogue: 0,1:33:24.43,1:33:28.23,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,1:33:38.94,1:33:42.58,Default,,0,0,0,,《Мен сенімен жүгіріп жүргенімде біртүрлі...''
Dialogue: 0,1:33:42.58,1:33:47.55,Default,,0,0,0,,Мен жүгіруім аяқталды деп ойлағанымда, жаңа нәрсе пайда болды.
Dialogue: 0,1:33:47.55,1:33:51.92,Default,,0,0,0,,Мен төбелесіп жүргенде соншалықты көңілді боламын деп ойламаппын.
Dialogue: 0,1:33:51.92,1:33:56.62,Default,,0,0,0,,《Бәрінен айырылған осы адамның соңынан жүрсең болғаны》
Dialogue: 0,1:34:04.00,1:34:31.13,Default,,0,0,0,,♪♪~
Dialogue: 0,1:34:31.13,1:34:33.33,Default,,0,0,0,,≪Такуми-кун!
Dialogue: 0,1:34:36.83,1:34:39.73,Default,,0,0,0,,Сіз бітірдіңіз.
Dialogue: 0,1:34:39.73,1:34:41.77,Default,,0,0,0,,О
Dialogue: 0,1:34:41.77,1:34:44.57,Default,,0,0,0,,Мен осыдан кейін достарыммен бас қосамын...
Dialogue: 0,1:34:44.57,1:34:49.07,Default,,0,0,0,,Алдымен бетіңізді көрсетіңіз, мен бірден қайтамын!
Dialogue: 0,1:34:51.21,1:34:54.02,Default,,0,0,0,,Нацуки кеттік
Dialogue: 0,1:34:54.02,1:34:56.32,Default,,0,0,0,,Иә, мен қазір барамын
Dialogue: 0,1:34:57.45,1:34:59.25,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,1:34:59.25,1:35:03.06,Default,,0,0,0,,Эй Такуми, сен осындасың ба?
Dialogue: 0,1:35:03.06,1:35:07.90,Default,,0,0,0,,Бірақ мектеп бітіру мені жылатады (жылау)
Dialogue: 0,1:35:07.90,1:35:09.83,Default,,0,0,0,,Эй, бұдан кейін не істеуіміз керек?
Dialogue: 0,1:35:09.83,1:35:12.73,Default,,0,0,0,,Менің орнымда өткен жастық шақтағы естеліктеріңіз туралы айтқыңыз келе ме?
Dialogue: 0,1:35:12.73,1:35:16.71,Default,,0,0,0,,А-а, мен...
Dialogue: 0,1:35:16.71,1:35:20.44,Default,,0,0,0,,Ой, сіз Могимен жалғыз қалдыңыз ба?
Dialogue: 0,1:35:20.44,1:35:22.48,Default,,0,0,0,,Жоқ... жақсы, жақсы.
Dialogue: 0,1:35:22.48,1:35:26.01,Default,,0,0,0,,Жүр, бәрібір мен жалғыз жүргізушімін.
Dialogue: 0,1:35:26.01,1:35:28.38,Default,,0,0,0,,Тұрыңыз—
Dialogue: 0,1:35:28.38,1:35:32.19,Default,,0,0,0,,Икейя-сенпаймен сөйлесу менің жалғыздығымды азайтады
Dialogue: 0,1:35:32.19,1:35:34.19,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:35:43.40,1:35:47.27,Default,,0,0,0,,Көлдегі мұз толығымен еріді.
Dialogue: 0,1:35:47.27,1:35:51.77,Default,,0,0,0,,Күн жылынып барады.
Dialogue: 0,1:36:07.26,1:36:13.06,Default,,0,0,0,,Такуми-кун, сіз жергілікті көлік компаниясына жұмысқа тұруды шештіңіз, солай ма?
Dialogue: 0,1:36:13.06,1:36:19.33,Default,,0,0,0,,А, мен көлігімнен алыс өмірді елестете алмаймын.
Dialogue: 0,1:36:19.33,1:36:21.33,Default,,0,0,0,,Мен кеткім келмейді.
Dialogue: 0,1:36:22.80,1:36:25.30,Default,,0,0,0,,Мен мұны білдім, бірақ маған әлі де ұнамайды.
Dialogue: 0,1:36:27.21,1:36:31.08,Default,,0,0,0,,Эй, Такуми-кун, Токиоға бірге барайық.
Dialogue: 0,1:36:31.08,1:36:32.88,Default,,0,0,0,,Эй!
Dialogue: 0,1:36:34.28,1:36:37.12,Default,,0,0,0,,Мен қаламын, иә?
Dialogue: 0,1:36:37.12,1:36:40.82,Default,,0,0,0,,Мен бұл туралы өткен күзден бері ойлап жүрмін.
Dialogue: 0,1:36:42.82,1:36:46.13,Default,,0,0,0,,«Менің арманым қандай?»
Dialogue: 0,1:36:46.13,1:36:49.93,Default,,0,0,0,,Мен бұл туралы қыс бойы ойладым, ақыры түсіндім.
Dialogue: 0,1:36:51.83,1:36:54.57,Default,,0,0,0,,Өйткені маған көлік мінген ұнайды
Dialogue: 0,1:36:54.57,1:36:57.47,Default,,0,0,0,,Өйткені мен басқалардан жылдам жүгіргім келеді
Dialogue: 0,1:36:57.47,1:37:00.71,Default,,0,0,0,,Мен кәсіби жүргізуші болғым келеді
Dialogue: 0,1:37:00.71,1:37:03.51,Default,,0,0,0,,Сондықтан мен туған жерімде қаламын
Dialogue: 0,1:37:03.51,1:37:05.45,Default,,0,0,0,,Осы мақсатта?
Dialogue: 0,1:37:05.45,1:37:08.98,Default,,0,0,0,,Мен жаңа командаға қосыламын...
Dialogue: 0,1:37:08.98,1:37:11.42,Default,,0,0,0,,Мен көп нәрсені зерттегім келеді
Dialogue: 0,1:37:11.42,1:37:15.29,Default,,0,0,0,,Мені ешкім жеңе алмайтын сияқты
Dialogue: 0,1:37:15.29,1:37:18.13,Default,,0,0,0,,Мен ең жақсы жүргізуші болғым келеді
Dialogue: 0,1:37:18.13,1:37:21.43,Default,,0,0,0,,《Уау, бұл керемет.
Dialogue: 0,1:37:21.43,1:37:23.43,Default,,0,0,0,,Бұл керемет, Такуми-кун》
Dialogue: 0,1:37:26.37,1:37:32.37,Default,,0,0,0,,《Бұл таңқаларлық. Нацуки жалғыз, бірақ мен оған шыдаймын.》
Dialogue: 0,1:37:34.48,1:37:38.88,Default,,0,0,0,,《Егер Такуми-кун осында болмаса, Нацукидің орта мектептегі күндері өте жақсы болар еді...
Dialogue: 0,1:37:38.88,1:37:41.38,Default,,0,0,0,,Жаман естеліктерге толы болды》
Dialogue: 0,1:37:43.32,1:37:45.72,Default,,0,0,0,,《Такуми-кун осында болғандықтан...
Dialogue: 0,1:37:45.72,1:37:50.06,Default,,0,0,0,,Мен көптеген қызықты естеліктер қалдырдым.
Dialogue: 0,1:37:50.06,1:37:55.36,Default,,0,0,0,,Нацуки Такуми-кунға жақсы сәйкес келмейді.
Dialogue: 0,1:37:55.36,1:37:59.57,Default,,0,0,0,,Бірақ мен ешқашан ұмытпаймын...
Dialogue: 0,1:37:59.57,1:38:04.84,Default,,0,0,0,,Такуми-кунмен естеліктер - сағыныш қазынасы.
Dialogue: 0,1:38:04.84,1:38:07.94,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз және армандарыңызды орындаңыз》
Dialogue: 0,1:38:09.64,1:38:11.71,Default,,0,0,0,,Такуми-кун!
Dialogue: 0,1:38:11.71,1:38:13.51,Default,,0,0,0,,Ах
Dialogue: 0,1:38:15.12,1:38:19.95,Default,,0,0,0,,《Такуми-кун мен Нацуки жеңілмеу үшін барын салады》
Dialogue: 0,1:38:19.95,1:38:46.37,Default,,0,0,0,,♪♪~
Dialogue: 0,1:38:47.55,1:38:52.39,Default,,0,0,0,,♪♪ (Соңғы тақырып)
Dialogue: 0,1:38:52.39,1:39:06.03,Default,,0,0,0,,♪♪~
Dialogue: 0,1:39:06.03,1:39:13.44,Default,,0,0,0,,♪♪ Әрқашан «дилемма» болады
Dialogue: 0,1:39:13.44,1:39:20.25,Default,,0,0,0,,♪♪ Бұл мені мазалайды
Dialogue: 0,1:39:20.25,1:39:27.42,Default,,0,0,0,,♪♪ Өзімшіл екіжүзділерге толы жаңалықтар
Dialogue: 0,1:39:27.42,1:39:33.36,Default,,0,0,0,,♪♪ Мен одан шаршадым және оны енді қарай алмаймын
Dialogue: 0,1:39:33.36,1:39:37.10,Default,,0,0,0,,♪♪ «Ажыратамыз ба?!»
Dialogue: 0,1:39:37.10,1:39:40.60,Default,,0,0,0,,♪♪ Үмітсіздікке ұқсас сезімдер
Dialogue: 0,1:39:40.60,1:39:49.24,Default,,0,0,0,,♪♪ Бірақ сені кездестіру арқылы мен қайта тудым.
Dialogue: 0,1:39:49.24,1:39:56.68,Default,,0,0,0,,♪♪ Және сол бір махаббат, бір аспан астында
Dialogue: 0,1:39:56.68,1:40:03.46,Default,,0,0,0,,♪♪ Бүгін де дүние жүзінде тағы да көптеген адамдар дүниеге келеді.
Dialogue: 0,1:40:03.46,1:40:10.87,Default,,0,0,0,,♪♪ Энергия кез келген нәрседен де күшті
Dialogue: 0,1:40:10.87,1:40:18.91,Default,,0,0,0,,♪♪ Қорқатын ештеңе жоқ, өйткені сенің сезімдерің әрқашан жанымда
Dialogue: 0,1:40:18.91,1:40:25.71,Default,,0,0,0,,♪♪~
Dialogue: 0,1:40:35.26,1:44:12.19,Default,,0,0,0,,♪♪~
Dialogue: 0,1:44:12.19,1:44:14.19,Default,,0,0,0,,
Dialogue: 0,1:44:15.69,1:44:21.69,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory