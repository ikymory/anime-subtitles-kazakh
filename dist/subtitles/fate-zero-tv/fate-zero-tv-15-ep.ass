Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 1,0:00:13.48,0:00:14.52,JP,NTP,0,0,0,,Кирицугу-сама
Dialogue: 1,0:00:19.10,0:00:20.47,JP,NTP,0,0,0,,Сіз дүниеге келдіңіз
Dialogue: 1,0:00:24.47,0:00:25.60,JP,NTP,0,0,0,,Сүйкімді
Dialogue: 1,0:00:26.24,0:00:27.30,JP,NTP,0,0,0,,Өте
Dialogue: 1,0:00:28.42,0:00:29.42,JP,NTP,0,0,0,,Кіші
Dialogue: 1,0:00:29.91,0:00:30.90,JP,NTP,0,0,0,,Нәзік
Dialogue: 1,0:00:32.27,0:00:36.13,JP,NTP,0,0,0,,Қарашы, Кирицугу, оның көздері дәл сенікіне ұқсайды.
Dialogue: 1,0:00:40.67,0:00:44.63,JP,NTP,0,0,0,,Мен осы баланы дүниеге әкелгеніме өте қуаныштымын.
Dialogue: 1,0:00:51.25,0:00:55.20,JP,NTP,0,0,0,,Айри менмін
Dialogue: 1,0:00:56.67,0:00:58.52,JP,NTP,0,0,0,,Мен сені өлтіремін
Dialogue: 1,0:01:05.66,0:01:07.16,JP,NTP,0,0,0,,Мен білемін
Dialogue: 1,0:01:07.61,0:01:09.62,JP,NTP,0,0,0,,Бұл Эйнцберннің тілегі
Dialogue: 1,0:01:09.98,0:01:11.66,JP,NTP,0,0,0,,Сондықтан мен
Dialogue: 1,0:01:12.82,0:01:14.27,JP,NTP,0,0,0,,Өз идеалыңызды біліңіз
Dialogue: 1,0:01:14.77,0:01:16.86,JP,NTP,0,0,0,,Өйткені біз жүрегімізде бір дұғаны ұстандық
Dialogue: 1,0:01:17.53,0:01:19.55,JP,NTP,0,0,0,,Сондықтан мен бүгін кіммін.
Dialogue: 1,0:01:21.10,0:01:23.31,JP,NTP,0,0,0,,Мені тура жолға салдың
Dialogue: 1,0:01:24.13,0:01:26.36,JP,NTP,0,0,0,,Маған қуыршақтан басқа өмір сүруге жол берді
Dialogue: 1,0:01:28.38,0:01:30.40,JP,NTP,0,0,0,,Мені жоқтаудың қажеті жоқ
Dialogue: 1,0:01:30.79,0:01:32.88,JP,NTP,0,0,0,,Мен сенің бір бөлшегіммін
Dialogue: 1,0:01:34.67,0:01:35.86,JP,NTP,0,0,0,,Маған да солай
Dialogue: 1,0:01:38.79,0:01:45.64,JP,NTP,0,0,0,,Менің ол баланы ұстауға құқығым жоқ.
Dialogue: 1,0:01:49.58,0:01:51.77,JP,NTP,0,0,0,,Кирицугу Ұмытпаңыз
Dialogue: 1,0:01:53.42,0:01:55.70,JP,NTP,0,0,0,,Ешкім олай жыламайтын дүние
Dialogue: 1,0:01:56.33,0:01:57.52,JP,NTP,0,0,0,,Бұл сенікі
Dialogue: 1,0:01:58.60,0:02:01.26,JP,NTP,0,0,0,,Бұл Кирицугу Эмия армандаған идеал болса керек.
Dialogue: 1,0:02:03.03,0:02:06.79,JP,NTP,0,0,0,,Сегіз жыл қалды, сонда сіздің шайқасыңыз аяқталады.
Dialogue: 1,0:02:08.53,0:02:10.87,JP,NTP,0,0,0,,Сіз бен біз мұратымызға жетеміз
Dialogue: 1,0:02:11.90,0:02:15.39,JP,NTP,0,0,0,,Қасиетті Граил сені құтқаратынына сенімдімін.
Dialogue: 1,0:02:16.99,0:02:18.43,JP,NTP,0,0,0,,Сонымен, бұл бала
Dialogue: 1,0:02:19.26,0:02:21.19,JP,NTP,0,0,0,,Ильясвиелді ұстаңыз
Dialogue: 1,0:02:22.08,0:02:27.90,JP,NTP,0,0,0,,Мақтанышпен қарапайым әке ретінде
Dialogue: 1,0:03:03.47,0:03:04.29,JP,NTP,0,0,0,,Пәрмен емлесі
Dialogue: 1,0:03:04.67,0:03:06.90,JP,NTP,0,0,0,,Оң қолыңызда пайда болған өрнек
Dialogue: 1,0:03:07.58,0:03:10.05,JP,NTP,0,0,0,,Бұл сіздің Қасиетті Граил ретінде таңдалғаныңыздың дәлелі.
Dialogue: 1,0:03:10.47,0:03:13.77,JP,NTP,0,0,0,,Бұл бақылаушы қызметшілерге берілетін стигма.
Dialogue: 1,0:03:15.49,0:03:16.97,JP,NTP,0,0,0,,Кирей Котомине
Dialogue: 1,0:03:18.40,0:03:20.22,JP,NTP,0,0,0,,Қасиетті Граил соғысы
Dialogue: 1,0:03:20.76,0:03:24.02,JP,NTP,0,0,0,,Ғажайып тілек машинасы үшін күресте
Dialogue: 1,0:03:24.95,0:03:25.74,JP,NTP,0,0,0,,I
Dialogue: 1,0:03:26.21,0:03:30.47,JP,NTP,0,0,0,,Бастапқыда Қасиетті Граил Қызметші Қожайыны ретінде таңдайтын жеті адам болды
Dialogue: 1,0:03:30.81,0:03:32.97,JP,NTP,0,0,0,,Екеуі де сиқыршы болуы керек.
Dialogue: 1,0:03:33.29,0:03:35.37,JP,NTP,0,0,0,,Сиқырға қатысы жоқ сен сияқты біреу
Dialogue: 1,0:03:35.74,0:03:38.43,JP,NTP,0,0,0,,Қасиетті Граалды осындай ерте кезеңде көре білу ...
Dialogue: 1,0:03:38.51,0:03:40.02,JP,NTP,0,0,0,,Бұл өте ерекше болар еді.
Dialogue: 1,0:03:40.99,0:03:44.44,JP,NTP,0,0,0,,Қызметші Шақырған батырлық рух
Dialogue: 1,0:03:44.54,0:03:48.02,JP,NTP,0,0,0,,Сондай-ақ олар таныс адамдар ретінде бір-бірімен төбелесуге жаратылғаны айтылады.
Dialogue: 1,0:03:48.39,0:03:52.22,JP,NTP,0,0,0,,Менің ойымша, бір қарағанда сену қиын.
Dialogue: 1,0:03:52.52,0:03:56.18,JP,NTP,0,0,0,,Әр дәуір мен елдің батырлары жаңа заманда жаңғырады.
Dialogue: 1,0:03:56.50,0:03:58.82,JP,NTP,0,0,0,,Бірін-бірі өлтіру, үстемдік үшін жарысу
Dialogue: 1,0:04:00.81,0:04:02.69,JP,NTP,0,0,0,,Бұл Қасиетті Граил соғысы.
Dialogue: 1,0:04:02.95,0:04:07.56,JP,NTP,0,0,0,,Әрине, текетірестің жасырын түрде өтуі айтылмаған заңдылық.
Dialogue: 1,0:04:07.95,0:04:13.31,JP,NTP,0,0,0,,Мұны қамтамасыз ету үшін собор шіркеуінен бақылаушы жіберіледі.
Dialogue: 1,0:04:13.99,0:04:19.33,JP,NTP,0,0,0,,Біз шіркеу мүшелері сиқыршылардың шайқасында төреші боламыз ба?
Dialogue: 1,0:04:20.23,0:04:25.30,JP,NTP,0,0,0,,Сиқырлы қауымдастық қоршауларға жабылған және әділ төреші бола алмайды.
Dialogue: 1,0:04:26.86,0:04:30.60,JP,NTP,0,0,0,,Осы жағдайларға байланысты, соңғы рет 60 жыл бұрын,
Dialogue: 1,0:04:30.76,0:04:34.26,JP,NTP,0,0,0,,Әкем біздің шайқасымызды бақылайды.
Dialogue: 1,0:04:34.45,0:04:36.23,JP,NTP,0,0,0,,Әкесі Фуюки елінде
Dialogue: 1,0:04:38.14,0:04:45.01,JP,NTP,0,0,0,,Дегенмен, жетекшінің жақын туыстарының Қасиетті Граил соғысына қатысуы проблема емес пе?
Dialogue: 1,0:04:45.38,0:04:49.61,JP,NTP,0,0,0,,Токиоми-кун, енді негізгі тақырыпқа көшейік.
Dialogue: 1,0:04:51.10,0:04:57.16,JP,NTP,0,0,0,,Кирей Осы уақытқа дейін бәрі Қасиетті Граил соғысына қатысты «ресми» жағдайлар ғана.
Dialogue: 1,0:04:57.68,0:05:03.58,JP,NTP,0,0,0,,Бүгін мен сізді Токиоми Тохсака мырзамен бірге әкелуімнің тағы бір себебі бар.
Dialogue: 1,0:05:04.08,0:05:05.40,JP,NTP,0,0,0,,...
Dialogue: 1,0:05:05.94,0:05:06.76,JP,NTP,0,0,0,,Іс жүзінде
Dialogue: 1,0:05:07.21,0:05:12.19,JP,NTP,0,0,0,,Фуюкиге көрінетін Қасиетті Граил Құдай Ұлының киелі жәдігерінен ерекшеленетіні анық па?
Dialogue: 1,0:05:12.87,0:05:14.37,JP,NTP,0,0,0,,Баяғыда түсірілген.
Dialogue: 1,0:05:15.10,0:05:15.77,JP,NTP,0,0,0,,Менің ойымша
Dialogue: 1,0:05:16.65,0:05:21.80,JP,NTP,0,0,0,,Егер олай болмаса, онда біз, Сегізінші Сакраментальдық Қоғам, қалпына келтіруге жауапты боламыз.
Dialogue: 1,0:05:22.23,0:05:26.61,JP,NTP,0,0,0,,Дегенмен, Фуюкидің Қасиетті Граил жалғыз қалу үшін тым күшті.
Dialogue: 1,0:05:26.98,0:05:29.13,JP,NTP,0,0,0,,Өйткені, бұл құдіретті тілек машинасы.
Dialogue: 1,0:05:29.53,0:05:34.01,JP,NTP,0,0,0,,Егер ол қалаусыз адамдардың қолына түссе, ол қандай апат әкеледі?
Dialogue: 1,0:05:34.62,0:05:37.30,JP,NTP,0,0,0,,Содан кейін келесі ең жақсы нұсқа ретінде
Dialogue: 1,0:05:37.56,0:05:41.18,JP,NTP,0,0,0,,Қалаған адамға Фуюкидің Қасиетті Граясын тапсырудың жолы болса.
Dialogue: 1,0:05:41.62,0:05:43.62,JP,NTP,0,0,0,,Бұдан жақсы ештеңе жоқ.
Dialogue: 1,0:05:44.23,0:05:47.49,JP,NTP,0,0,0,,Тохсака отбасы сиқыршылар отбасы болса да,
Dialogue: 1,0:05:47.83,0:05:50.54,JP,NTP,0,0,0,,Шіркеумен бұрыннан байланысы бар отбасы
Dialogue: 1,0:05:50.93,0:05:55.01,JP,NTP,0,0,0,,Токиоми-кунның өзіне келетін болсақ, мен оның мінезіне кепілдік бере аламын.
Dialogue: 1,0:05:55.23,0:05:59.34,JP,NTP,0,0,0,,Ең бастысы, ол Қасиетті Граилді қолдануды нақты анықтайды.
Dialogue: 1,0:05:59.78,0:06:05.11,JP,NTP,0,0,0,,«Тамырға» жету Біздің Тохсаке ​​көптен бері аңсаған тілегіміз осы бір тұста ерекше.
Dialogue: 1,0:06:05.57,0:06:10.10,JP,NTP,0,0,0,,Алайда, бір кездері бірдей ұмтылыс болған Эйнцберн мен Мату,
Dialogue: 1,0:06:10.68,0:06:13.13,JP,NTP,0,0,0,,Мен бұл бастапқы ниетімді мүлде ұмыттым.
Dialogue: 1,0:06:13.78,0:06:17.90,JP,NTP,0,0,0,,Сырттан шақырылған шеберлер де бар екенін айтпай-ақ қояйық.
Dialogue: 1,0:06:18.43,0:06:23.71,JP,NTP,0,0,0,,Адамдардың Қасиетті Граилға қандай таяз қалаулары бар екенін білмеймін.
Dialogue: 1,0:06:24.17,0:06:28.81,JP,NTP,0,0,0,,Сонымен, Токиоми Тохсака мырзаның жеңіске жетуі үшін И
Dialogue: 1,0:06:29.23,0:06:32.33,JP,NTP,0,0,0,,Сізге келесі Қасиетті Граил соғысына қатысу жеткілікті.
Dialogue: 1,0:06:32.66,0:06:34.08,JP,NTP,0,0,0,,Әрине, сырттай
Dialogue: 1,0:06:34.38,0:06:38.98,JP,NTP,0,0,0,,Сіз және мен Қасиетті Граил үшін жарысатын жау ретінде әрекет етеміз.
Dialogue: 1,0:06:39.66,0:06:43.51,JP,NTP,0,0,0,,Бірақ біз күш біріктіріп, сахна артында бірге күресеміз.
Dialogue: 1,0:06:43.98,0:06:46.60,JP,NTP,0,0,0,,Қалған бес шеберді жойып, жойыңыз.
Dialogue: 1,0:06:47.09,0:06:49.49,JP,NTP,0,0,0,,Нақтырақ жеңіске жету үшін
Dialogue: 1,0:06:50.60,0:06:57.39,JP,NTP,0,0,0,,Міне, Кирей-кун, сен Киелі шіркеуден Сиқыршылар қауымдастығына жөнелтілім ретінде ауыстырдың.
Dialogue: 1,0:06:57.73,0:06:59.35,JP,NTP,0,0,0,,Менің шәкіртім бол
Dialogue: 1,0:06:59.79,0:07:02.13,JP,NTP,0,0,0,,Ресми кездесу қазірдің өзінде берілген.
Dialogue: 1,0:07:02.75,0:07:05.84,JP,NTP,0,0,0,,Сіз Жапониядағы біздің отбасымызда сиқыршылыққа қатты жаттығасыз.
Dialogue: 1,0:07:06.35,0:07:09.30,JP,NTP,0,0,0,,Үш жылдан кейін Қасиетті Граил соғысына дейін қызметшіге бағын.
Dialogue: 1,0:07:09.64,0:07:14.43,JP,NTP,0,0,0,,Шебер ретінде шайқасқа қатысуға жеткілікті сиқыршы болуы керек.
Dialogue: 1,0:07:18.86,0:07:19.51,JP,NTP,0,0,0,,♪ Ка-та-на
Dialogue: 1,0:07:20.15,0:07:22.14,JP,NTP,0,0,0,,Сұрақтарыңыз бар ма? Кирей
Dialogue: 1,0:07:22.89,0:07:23.81,JP,NTP,0,0,0,,(Теледидардың жарылу дыбысы)
Dialogue: 1,0:07:25.95,0:07:29.14,JP,NTP,0,0,0,,Шеберді таңдайтын Қасиетті Граилдың еркі
Dialogue: 1,0:07:29.52,0:07:31.48,JP,NTP,0,0,0,,Бұл не?
Dialogue: 1,0:07:34.67,0:07:40.28,JP,NTP,0,0,0,,Қасиетті Граил оған көбірек мұқтаж адамдардан шеберлерге басымдық береді.
Dialogue: 1,0:07:40.75,0:07:44.20,JP,NTP,0,0,0,,Сондықтан әрбір шебердің Қасиетті Граильді қалайтын себебі бар.
Dialogue: 1,0:07:44.63,0:07:45.87,JP,NTP,0,0,0,,Міндетті емес.
Dialogue: 1,0:07:46.53,0:07:49.57,JP,NTP,0,0,0,,Ертеде бастапқыда сайланбаған тәртіпсіз адамдар болған.
Dialogue: 1,0:07:50.20,0:07:52.52,JP,NTP,0,0,0,,Ол кейде командалық сиқырды қамтыған сияқты.
Dialogue: 1,0:07:54.14,0:08:00.71,JP,NTP,0,0,0,,А, мен түсіндім. Кирей-кун, сенің таңдалғаныңды әлі де түсінбейсің.
Dialogue: 1,0:08:03.78,0:08:06.80,JP,NTP,0,0,0,,Ол мен күткеннен де оңай келісті.
Dialogue: 1,0:08:07.46,0:08:11.72,JP,NTP,0,0,0,,Егер қауымның қалауы болса, ұлы отқа секіреді.
Dialogue: 1,0:08:12.31,0:08:14.74,JP,NTP,0,0,0,,Шынымды айтсам, мен қатты таң қалдым.
Dialogue: 1,0:08:15.45,0:08:16.73,JP,NTP,0,0,0,,Оның көзқарасы бойынша
Dialogue: 1,0:08:17.06,0:08:21.46,JP,NTP,0,0,0,,Екеуміз бір-біріне қатысы жоқ ұрысқа қатысқандай болар едік.
Dialogue: 1,0:08:22.23,0:08:26.45,JP,NTP,0,0,0,,Жоқ, мүмкін бұл оның құтқарылуы болды.
Dialogue: 1,0:08:27.93,0:08:31.50,JP,NTP,0,0,0,,Күні кеше ғана әйелімнен айырылдым.
Dialogue: 1,0:08:32.21,0:08:35.59,JP,NTP,0,0,0,,Фокусты өзгерту және жаңа тапсырмаларды шешу мүмкіндігі
Dialogue: 1,0:08:35.88,0:08:40.04,JP,NTP,0,0,0,,Қазір Кирей үшін бұл оның жарасын емдеудің төте жолы болуы мүмкін.
Dialogue: 1,0:08:51.17,0:08:51.99,JP,NTP,0,0,0,,Аои-сан
Dialogue: 1,0:08:57.45,0:08:59.28,JP,NTP,0,0,0,,Қария-күн, біраз болды.
Dialogue: 1,0:08:59.59,0:09:01.04,JP,NTP,0,0,0,,Мен жаңа ғана іссапардан келдім.
Dialogue: 1,0:09:01.64,0:09:04.23,JP,NTP,0,0,0,,Бұл жолы көп уақыт қажет болды.
Dialogue: 1,0:09:04.50,0:09:06.21,JP,NTP,0,0,0,,Жақсы.
Dialogue: 1,0:09:07.31,0:09:08.31,JP,NTP,0,0,0,,Қария ағай
Dialogue: 1,0:09:10.83,0:09:12.59,JP,NTP,0,0,0,,Қария аға, үйге қош келдіңіз
Dialogue: 1,0:09:13.31,0:09:14.02,JP,NTP,0,0,0,,Рин-чан
Dialogue: 1,0:09:15.29,0:09:17.55,JP,NTP,0,0,0,,Сен маған тағы бір кәдесый сатып алдың.
Dialogue: 1,0:09:17.86,0:09:20.41,JP,NTP,0,0,0,,Гор Риннің мінез-құлқы нашар
Dialogue: 1,0:09:22.61,0:09:23.04,JP,NTP,0,0,0,,Иә
Dialogue: 1,0:09:27.61,0:09:29.10,JP,NTP,0,0,0,,Рахмет, ағай.
Dialogue: 1,0:09:29.51,0:09:32.08,JP,NTP,0,0,0,,Ұнаса ағай да қуанады.
Dialogue: 1,0:09:36.09,0:09:37.09,JP,NTP,0,0,0,,Сакура-чан
Dialogue: 1,0:09:40.90,0:09:43.31,JP,NTP,0,0,0,,Шие гүлдері енді жоқ.
Dialogue: 1,0:09:48.23,0:09:48.75,JP,NTP,0,0,0,,Аои-сан
Dialogue: 1,0:09:49.80,0:09:55.04,JP,NTP,0,0,0,,Сакура енді менің қызым немесе Риннің әпкесі емес.
Dialogue: 1,0:09:56.67,0:10:00.88,JP,NTP,0,0,0,,Сол бала Матудың үйіне барды.
Dialogue: 1,0:10:02.15,0:10:02.98,JP,NTP,0,0,0,,Неліктен?
Dialogue: 1,0:10:03.81,0:10:08.39,JP,NTP,0,0,0,,Неліктен Мату сиқыршының қанын иемденетін баланы қалайды
Dialogue: 1,0:10:09.11,0:10:12.24,JP,NTP,0,0,0,,Әрине түсінер едіңіз.
Dialogue: 1,0:10:15.18,0:10:18.43,JP,NTP,0,0,0,,Менің ескі одақтасым Матудың өтінішіне жауап ретінде,
Dialogue: 1,0:10:18.68,0:10:21.05,JP,NTP,0,0,0,,Тохсака отағасы осылай шешті.
Dialogue: 1,0:10:21.67,0:10:23.62,JP,NTP,0,0,0,,Пікір айта алмаймын.
Dialogue: 1,0:10:25.61,0:10:26.97,JP,NTP,0,0,0,,Бұл жақсы ма?
Dialogue: 1,0:10:27.60,0:10:30.16,JP,NTP,0,0,0,,Мен Тохсака отбасына үйленемін деп шешкен кезде
Dialogue: 1,0:10:30.67,0:10:33.17,JP,NTP,0,0,0,,Мен сиқыршының әйелі боламын деп шешкен сәттен бастап
Dialogue: 1,0:10:33.71,0:10:35.70,JP,NTP,0,0,0,,Мен осындай нәрсеге дайындалдым.
Dialogue: 1,0:10:36.15,0:10:37.60,JP,NTP,0,0,0,,Бұл жақсы ма?
Dialogue: 1,0:10:37.89,0:10:40.15,JP,NTP,0,0,0,,Сиқыршылардың қанын иеленген отбасы
Dialogue: 1,0:10:40.66,0:10:44.68,JP,NTP,0,0,0,,Қарапайым отбасы бақытын іздеу қате.
Dialogue: 1,0:10:44.77,0:10:48.86,JP,NTP,0,0,0,,Бұл өтірік, бақыт тілейсің
Dialogue: 1,0:10:48.94,0:10:52.48,JP,NTP,0,0,0,,Бұл Тохсака мен Мату арасындағы мәселе.
Dialogue: 1,0:10:52.95,0:10:55.53,JP,NTP,0,0,0,,Сиқыршылар әлемінен бет бұрғандар үшін.
Dialogue: 1,0:10:56.33,0:10:57.76,JP,NTP,0,0,0,,Бір-бірімен байланысы жоқ әңгіме
Dialogue: 1,0:11:02.35,0:11:06.56,JP,NTP,0,0,0,,Сакураны кездестірсеңіз, оған мейірімді болыңыз.
Dialogue: 1,0:11:07.60,0:11:11.07,JP,NTP,0,0,0,,Себебі мен сол балаға, Қария-күнге байланып қалдым.
Dialogue: 1,0:11:14.54,0:11:18.43,JP,NTP,0,0,0,,Төбелескендер көңіл айтып жүретін.
Dialogue: 1,0:11:20.12,0:11:23.48,JP,NTP,0,0,0,,Сіз бұл бетті маған енді ешқашан көрсетпеуіңіз керек.
Dialogue: 1,0:11:23.65,0:11:26.27,JP,NTP,0,0,0,,Саған айтқаныма сенімдімін.
Dialogue: 1,0:11:27.08,0:11:27.83,JP,NTP,0,0,0,,Қария
Dialogue: 1,0:11:28.39,0:11:30.59,JP,NTP,0,0,0,,Олар Тохсақаның екінші қызын асырап алған көрінеді.
Dialogue: 1,0:11:31.90,0:11:33.03,JP,NTP,0,0,0,,жылдам құлақ
Dialogue: 1,0:11:33.92,0:11:35.25,JP,NTP,0,0,0,,Сол дәрежеде
Dialogue: 1,0:11:35.51,0:11:39.04,JP,NTP,0,0,0,,Матудың қанында сиқыршы факторды қалдырғыңыз келе ме?
Dialogue: 1,0:11:39.28,0:11:42.46,JP,NTP,0,0,0,,Оны түзететін сенсің.
Dialogue: 1,0:11:42.78,0:11:47.31,JP,NTP,0,0,0,,Матудың осы күйге түсуіне кім себепші болды деп ойлайсыз?
Dialogue: 1,0:11:48.14,0:11:54.27,JP,NTP,0,0,0,,Егер Онуши әулет басшысын адалдықпен мұраға алып, Матоудың құпиясын мұра еткен болса.
Dialogue: 1,0:11:54.51,0:11:57.02,JP,NTP,0,0,0,,Осы уақытқа дейін жағдай өзекті.
Dialogue: 1,0:11:57.30,0:11:59.42,JP,NTP,0,0,0,,Бұл сенсің.
Dialogue: 1,0:11:59.53,0:12:01.91,JP,NTP,0,0,0,,Бұл фарсты тоқтат, вампир.
Dialogue: 1,0:12:02.43,0:12:05.39,JP,NTP,0,0,0,,Өзіңнің өлмейтіндігіңе жету
Dialogue: 1,0:12:05.62,0:12:07.39,JP,NTP,0,0,0,,Ол жай ғана Қасиетті Граалды ұрлап жатқан шығар.
Dialogue: 1,0:12:09.96,0:12:13.22,JP,NTP,0,0,0,,Алпыс жылдық цикл келесі жылы келеді
Dialogue: 1,0:12:13.47,0:12:18.23,JP,NTP,0,0,0,,Бірақ Матуда төртінші Қасиетті Граил соғысында ойнайтын фигуралар жоқ.
Dialogue: 1,0:12:18.61,0:12:19.77,JP,NTP,0,0,0,,Сіз мадамашимосыз
Dialogue: 1,0:12:19.90,0:12:24.87,JP,NTP,0,0,0,,Менің ағам Цуруноның сиқырлы күші қызметшіні басқара алмайды.
Dialogue: 1,0:12:24.87,0:12:31.28,JP,NTP,0,0,0,,Демек, бұл шайқасты кейінге қалдырсақ та, алдағы 60 жылда жеңіске жетуге мүмкіндік бар.
Dialogue: 1,0:12:31.44,0:12:36.39,JP,NTP,0,0,0,,Тохсака қызының плацентасынан нағыз тамаша сиқыршы туады.
Dialogue: 1,0:12:36.90,0:12:40.62,JP,NTP,0,0,0,,Ыдыс ретінде көп үміт бар.
Dialogue: 1,0:12:40.97,0:12:44.70,JP,NTP,0,0,0,,​​Егер солай болса, мен Қасиетті Граильді ала алсам ғой.
Dialogue: 1,0:12:45.15,0:12:47.29,JP,NTP,0,0,0,,Тохсака Сакураның пайдасы жоқ.
Dialogue: 1,0:12:49.00,0:12:51.57,JP,NTP,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 1,0:12:52.31,0:12:54.08,JP,NTP,0,0,0,,Бұл мәміле.
Dialogue: 1,0:12:54.93,0:12:58.51,JP,NTP,0,0,0,,Мен келесі Қасиетті Граил соғысында Киелі Граалды Матуға қайтарамын.
Dialogue: 1,0:12:59.48,0:13:02.81,JP,NTP,0,0,0,,Оның орнына Тохсака Сакураны босатыңыз.
Dialogue: 1,0:13:04.16,0:13:09.55,JP,NTP,0,0,0,,Мені ақымақ деп атаңыз. Бүгінге дейін ешқандай жаттығу жасамаған тентек.
Dialogue: 1,0:13:09.87,0:13:13.97,JP,NTP,0,0,0,,Мен бар болғаны бір жылдың ішінде қызметші шебері болғым келеді.
Dialogue: 1,0:13:14.86,0:13:18.05,JP,NTP,0,0,0,,Сізде мұны мүмкін ететін құпия техника бар шығар.
Dialogue: 1,0:13:18.44,0:13:21.09,JP,NTP,0,0,0,,Жәндіктерді қолға үйретуші ретінде қандай ерекше дағдыларыңыз бар?
Dialogue: 1,0:13:25.36,0:13:27.51,JP,NTP,0,0,0,,Маған «мөр басылған қате» отырғыз
Dialogue: 1,0:13:28.32,0:13:31.10,JP,NTP,0,0,0,,Қария, өлгің келе ме?
Dialogue: 1,0:13:31.25,0:13:33.87,JP,NTP,0,0,0,,Матудың құмарлығын Матудың қолдарымен орындауға болады.
Dialogue: 1,0:13:34.27,0:13:36.57,JP,NTP,0,0,0,,Туысы жоқ адамдарды тартуға бола ма?
Dialogue: 1,0:13:38.22,0:13:41.79,JP,NTP,0,0,0,,Уайымдадым деп айта алмаймын, әке.
Dialogue: 1,0:13:44.75,0:13:48.48,JP,NTP,0,0,0,,Мақсатың араласпау болса, Қария
Dialogue: 1,0:13:50.17,0:13:52.78,JP,NTP,0,0,0,,Менің ойымша, сәл кеш болды.
Dialogue: 1,0:13:53.14,0:13:55.39,JP,NTP,0,0,0,,Атам жол жоқ
Dialogue: 1,0:13:59.31,0:14:03.98,JP,NTP,0,0,0,,Алғашқы үш күн көп жылау сияқты болды.
Dialogue: 1,0:14:05.00,0:14:08.30,JP,NTP,0,0,0,,Төртінші күннен кейін мен дыбыс шығаруды қойдым.
Dialogue: 1,0:14:09.09,0:14:12.35,JP,NTP,0,0,0,,Бүгін мен оны таң атқаннан мына жәндіктер қоймасына тастадым.
Dialogue: 1,0:14:12.51,0:14:15.05,JP,NTP,0,0,0,,Мен оны қанша уақыт сақтай алатынымды көруге тырысамын.
Dialogue: 1,0:14:15.27,0:14:19.52,JP,NTP,0,0,0,,Жәндіктер жарты күн азаптаған соң мен әлі тірімін.
Dialogue: 1,0:14:19.83,0:14:23.73,JP,NTP,0,0,0,,Тохсаканың материалдары да қоқысқа тасталмайды.
Dialogue: 1,0:14:24.31,0:14:25.12,JP,NTP,0,0,0,,Сакура
Dialogue: 1,0:14:25.26,0:14:27.04,JP,NTP,0,0,0,,Енді не істеуіміз керек?
Dialogue: 1,0:14:27.28,0:14:30.62,JP,NTP,0,0,0,,Басынан аяғына дейін жәндіктер зорлады
Dialogue: 1,0:14:30.76,0:14:33.03,JP,NTP,0,0,0,,Сынған кішкентай қыз
Dialogue: 1,0:14:33.45,0:14:36.53,JP,NTP,0,0,0,,Егер сіз әлі де сақтағыңыз келсе
Dialogue: 1,0:14:36.96,0:14:39.27,JP,NTP,0,0,0,,Бұл туралы ойлаудың қажеті жоқ.
Dialogue: 1,0:14:39.49,0:14:40.25,JP,NTP,0,0,0,,Менің еш қарсылығым жоқ.
Dialogue: 1,0:14:42.75,0:14:45.65,JP,NTP,0,0,0,,Бірақ нәтижелерді алғанша.
Dialogue: 1,0:14:45.78,0:14:48.89,JP,NTP,0,0,0,,Сакураның білімі жалғасады.
Dialogue: 1,0:14:49.19,0:14:53.62,JP,NTP,0,0,0,,Менің сүйікті ісім бірінен соң бірі өтетін Қасиетті Граил соғысы.
Dialogue: 1,0:14:53.93,0:14:58.19,JP,NTP,0,0,0,,Дегенмен, сіз кездейсоқ қолдарыңызды Қасиетті Граильге түсіруіңіз керек болса
Dialogue: 1,0:14:58.33,0:15:02.28,JP,NTP,0,0,0,,Ол кезде, әрине, кішкентай қыз қолданылған.
Dialogue: 1,0:15:02.64,0:15:07.46,JP,NTP,0,0,0,,Бұл білім бір жылдан кейін тоқтатылуы мүмкін.
Dialogue: 1,0:15:08.83,0:15:11.40,JP,NTP,0,0,0,,Екі сөз жоқ. Мату Зукен
Dialogue: 1,0:15:11.81,0:15:15.62,JP,NTP,0,0,0,,Алдымен бір апта бойы жәндіктерге арналған питомник болайық.
Dialogue: 1,0:15:15.77,0:15:21.49,JP,NTP,0,0,0,,Өлмей қалсаң, байсалды екеніңді мойындаймын.
Dialogue: 1,0:15:31.00,0:15:32.65,JP,NTP,0,0,0,,Ол ақыры келді ме?
Dialogue: 1,0:15:34.78,0:15:35.81,JP,NTP,0,0,0,,Қандай жаңалық?
Dialogue: 1,0:15:36.23,0:15:39.60,JP,NTP,0,0,0,,Бұл Лондонға сағат мұнарасына енген адамдардың есебі.
Dialogue: 1,0:15:40.38,0:15:44.01,JP,NTP,0,0,0,,Шамасы, Қасиетті Граил Сиқырлар қауымдастығының ең жоғары академиясы.
Dialogue: 1,0:15:44.50,0:15:47.18,JP,NTP,0,0,0,,Шеберді сағат мұнарасынан да таңдап алған сияқты.
Dialogue: 1,0:15:47.43,0:15:47.89,JP,NTP,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 1,0:15:48.37,0:15:49.52,JP,NTP,0,0,0,,Ол қиын адам.
Dialogue: 1,0:15:50.21,0:15:54.52,JP,NTP,0,0,0,,Арчибальдтың үлкен ұлы, тоғыз ұрпақтан тұратын әйгілі сиқырлы отбасы.
Dialogue: 1,0:15:54.91,0:15:57.65,JP,NTP,0,0,0,,Кейнет Эль-Меллои Арчибалд
Dialogue: 1,0:16:00.96,0:16:06.80,JP,NTP,0,0,0,,Сиқыр әлемінде адамның артықшылығы немесе кемдігі негізінен оның тегіне байланысты.
Dialogue: 1,0:16:07.57,0:16:08.77,JP,NTP,0,0,0,,Өйткені
Dialogue: 1,0:16:08.86,0:16:11.97,JP,NTP,0,0,0,,Сиқырдың құпияларына бір ұрпақта жету мүмкін емес.
Dialogue: 1,0:16:12.28,0:16:16.95,JP,NTP,0,0,0,,Бұл ата-ананың өмір бойы алған тәрбиесінің жемісін балаларына жеткізуі үшін.
Dialogue: 1,0:16:17.56,0:16:21.83,JP,NTP,0,0,0,,Сондықтан ұрпақтары көп сиқыршы отбасының беделі көбірек.
Dialogue: 1,0:16:22.37,0:16:26.58,JP,NTP,0,0,0,,Неліктен мұндай қарапайым әңгімеден бастау керек?
Dialogue: 1,0:16:26.89,0:16:32.14,JP,NTP,0,0,0,,Себебі өткен күні бір студент маған жұмыс тапсырды.
Dialogue: 1,0:16:33.26,0:16:36.96,JP,NTP,0,0,0,,Тақырыбы «Жаңа ғасырдағы сиқырлы жолға сұрақ»
Dialogue: 1,0:16:37.15,0:16:41.70,JP,NTP,0,0,0,,Бұл мақалада мен айтқан мұңдылыққа қарсы тұр.
Dialogue: 1,0:16:42.38,0:16:45.16,JP,NTP,0,0,0,,Хирургиялық әдістерді тереңірек түсіну және
Dialogue: 1,0:16:45.52,0:16:48.73,JP,NTP,0,0,0,,Сиқырды шебер қолдана алсаң
Dialogue: 1,0:16:48.96,0:16:52.57,JP,NTP,0,0,0,,Туа біткен қабілеттегі айырмашылықтарды кез келген жолмен өтеуге болады.
Dialogue: 1,0:16:53.20,0:16:59.11,JP,NTP,0,0,0,,Басқаша айтқанда, қаны таяздардың да бірінші дәрежелі сиқыршы бола алатынын үйретеді.
Dialogue: 1,0:16:59.44,0:17:02.98,JP,NTP,0,0,0,,Мен бұл қағазды оқығанда, шынымды айтсам, есіме түсті.
Dialogue: 1,0:17:03.28,0:17:04.42,JP,NTP,0,0,0,,Тыныш.
Dialogue: 1,0:17:07.10,0:17:08.47,JP,NTP,0,0,0,,Ашық сөйлеңіз
Dialogue: 1,0:17:08.63,0:17:11.97,JP,NTP,0,0,0,,Мұнда жазылғанның бәрі адасушылық.
Dialogue: 1,0:17:13.65,0:17:16.71,JP,NTP,0,0,0,,Сиқырдың артықшылығы немесе кемдігі қан тегінің айырмашылығымен анықталады.
Dialogue: 1,0:17:17.08,0:17:19.99,JP,NTP,0,0,0,,Бұл бұлтартпас факт
Dialogue: 1,0:17:21.36,0:17:23.36,JP,NTP,0,0,0,,Waver Velvet
Dialogue: 1,0:17:23.77,0:17:27.31,JP,NTP,0,0,0,,Менің кейбір оқушыларымның мұндай адасуы барын білмедім.
Dialogue: 1,0:17:27.57,0:17:29.27,JP,NTP,0,0,0,,Шынымен өкінішті
Dialogue: 1,0:17:29.34,0:17:34.53,JP,NTP,0,0,0,,Мұғалім, мен қазіргі ескі сиқыршылар қауымдастығына қатысты мәселе көтергім келеді.
Dialogue: 1,0:17:34.63,0:17:35.97,JP,NTP,0,0,0,,Уэйвер мырза
Dialogue: 1,0:17:36.34,0:17:42.21,JP,NTP,0,0,0,,Егер есімде дұрыс болса, сіздің отбасыңыздың сиқыршылар тегі үш ұрпаққа ғана жалғасты.
Dialogue: 1,0:17:42.86,0:17:46.47,JP,NTP,0,0,0,,Тыңдаңыз, егер сіз сиқырлы қауымдастықтың тарихына қарасаңыз,
Dialogue: 1,0:17:46.58,0:17:50.09,JP,NTP,0,0,0,,Үйің жаңа туған нәрестедей.
Dialogue: 1,0:17:50.36,0:17:51.89,JP,NTP,0,0,0,,Ата-анаңа өз пікіріңді айтпас бұрын
Dialogue: 1,0:17:52.15,0:17:54.69,JP,NTP,0,0,0,,Менің ойымша, алдымен сөздерді үйренуіміз керек.
Dialogue: 1,0:17:57.04,0:18:00.39,JP,NTP,0,0,0,,Мені мазақ ет мені мазақ қыл
Dialogue: 1,0:18:00.56,0:18:02.36,JP,NTP,0,0,0,,Лектор осылай істей ме?
Dialogue: 1,0:18:02.73,0:18:05.30,JP,NTP,0,0,0,,Ол менің қағазымды оқып, қызғанып кетті.
Dialogue: 1,0:18:05.54,0:18:07.24,JP,NTP,0,0,0,,Ол менің талантымнан қорықты.
Dialogue: 1,0:18:07.81,0:18:09.78,JP,NTP,0,0,0,,Сондықтан мен бәрінің көзінше солай істеп жүрмін.
Dialogue: 1,0:18:12.68,0:18:15.21,JP,NTP,0,0,0,,А, мен оны аяқтай алмаймын. Сенімен бәрі жақсы ма?
Dialogue: 1,0:18:15.66,0:18:16.96,JP,NTP,0,0,0,,Иә Жоқ
Dialogue: 1,0:18:18.03,0:18:21.70,JP,NTP,0,0,0,,Сіз некромантиканың студентісіз бе? Дәріс қалай өтті?
Dialogue: 1,0:18:22.25,0:18:23.28,JP,NTP,0,0,0,,О, дұрыс.
Dialogue: 1,0:18:24.52,0:18:26.89,JP,NTP,0,0,0,,Профессор Арчибалд маған тапсырма орындауымды өтінді.
Dialogue: 1,0:18:27.52,0:18:28.75,JP,NTP,0,0,0,,Сондықтан асығыңыз
Dialogue: 1,0:18:29.88,0:18:31.92,JP,NTP,0,0,0,,Иә, бұл дұрыс болды.
Dialogue: 1,0:18:32.14,0:18:34.72,JP,NTP,0,0,0,,Сіз мұны профессор Арчибальдқа жеткізе аласыз ба?
Dialogue: 1,0:18:37.18,0:18:38.67,JP,NTP,0,0,0,,Бұл ма?
Dialogue: 1,0:18:39.51,0:18:41.99,JP,NTP,0,0,0,,Маңызды болып көрінгендіктен сұрадым.
Dialogue: 1,0:18:42.86,0:18:43.75,JP,NTP,0,0,0,,Маңызды нәрселер
Dialogue: 1,0:18:45.28,0:18:48.96,JP,NTP,0,0,0,,Македониядан жіберілді
Dialogue: 1,0:18:55.52,0:18:56.54,JP,NTP,0,0,0,,Міне, осы
Dialogue: 1,0:18:57.52,0:18:58.82,JP,NTP,0,0,0,,Кейнеттің жігіті
Dialogue: 1,0:18:58.98,0:19:03.94,JP,NTP,0,0,0,,Жақында Қиыр Шығыста өтетін сиқырлы жарысқа қатысады деген қауесет бар.
Dialogue: 1,0:19:04.09,0:19:05.29,JP,NTP,0,0,0,,Бұл дұрыс болды.
Dialogue: 1,0:19:10.48,0:19:11.86,JP,NTP,0,0,0,,Қасиетті Граил соғысы
Dialogue: 1,0:19:12.99,0:19:16.15,JP,NTP,0,0,0,,200 жыл бұрын Бастаудың үш тұқымдастары деп атаған
Dialogue: 1,0:19:16.38,0:19:18.88,JP,NTP,0,0,0,,Эйнцберн Мату Тохсака
Dialogue: 1,0:19:19.51,0:19:22.47,JP,NTP,0,0,0,,Сиқыршылардың үш отауы бір-бірімен ынтымақтасады.
Dialogue: 1,0:19:22.79,0:19:27.12,JP,NTP,0,0,0,,Кез келген тілекті орындай алатын Қасиетті Граильді шақыра алды.
Dialogue: 1,0:19:28.35,0:19:33.24,JP,NTP,0,0,0,,Бірақ Қасиетті Граил тек бір дұғаны қабылдайды.
Dialogue: 1,0:19:34.37,0:19:38.61,JP,NTP,0,0,0,,Ынтымақтастық қанды қақтығысқа айналды
Dialogue: 1,0:19:39.56,0:19:41.94,JP,NTP,0,0,0,,Бұл Қасиетті Граил соғысының басталуы
Dialogue: 1,0:19:42.92,0:19:45.75,JP,NTP,0,0,0,,Содан бері алпыс жылда бір рет
Dialogue: 1,0:19:45.84,0:19:48.33,JP,NTP,0,0,0,,Қасиетті Граил Фуюки еліне оралады
Dialogue: 1,0:19:48.53,0:19:53.32,JP,NTP,0,0,0,,Оны алуға өкілеттігі бар жеті сиқыршыны таңдаңыз.
Dialogue: 1,0:19:54.39,0:19:58.08,JP,NTP,0,0,0,,Қызметшілер деп аталатын батырлық рухтарды шақыруға мүмкіндік береді.
Dialogue: 1,0:20:00.01,0:20:00.44,JP,NTP,0,0,0,,Садақшы
Dialogue: 1,0:20:01.16,0:20:01.87,JP,NTP,0,0,0,,Сабер
Dialogue: 1,0:20:02.26,0:20:02.95,JP,NTP,0,0,0,,Лансер
Dialogue: 1,0:20:03.36,0:20:03.97,JP,NTP,0,0,0,,Шабандоз
Dialogue: 1,0:20:04.46,0:20:05.09,JP,NTP,0,0,0,,Ассасин
Dialogue: 1,0:20:05.56,0:20:06.29,JP,NTP,0,0,0,,Кастер
Dialogue: 1,0:20:06.61,0:20:07.39,JP,NTP,0,0,0,,Берсеркер
Dialogue: 1,0:20:08.67,0:20:12.13,JP,NTP,0,0,0,,Жеті сыныпқа тағайындалған қызметшілер шек болып табылады
Dialogue: 1,0:20:12.93,0:20:19.03,JP,NTP,0,0,0,,Жеті адамның қайсысы Қасиетті Граил болуға лайықты екені өліммен аяқталған шайқаста шешіледі.
Dialogue: 1,0:20:23.24,0:20:27.27,JP,NTP,0,0,0,,Қасиетті Граил соғысы атақтарды немесе билікті қажет етпейді.
Dialogue: 1,0:20:27.61,0:20:30.48,JP,NTP,0,0,0,,Бұл нағыз қабілет бәсекесі ме?
Dialogue: 1,0:20:31.77,0:20:33.98,JP,NTP,0,0,0,,Бұл мен үшін тамаша сахна емес пе?
Dialogue: 1,0:20:36.38,0:20:42.55,JP,NTP,0,0,0,,Ей, қызметшіні шақыру үшін катализатор ретінде батырлық рухтың реликті қажет.
Dialogue: 1,0:20:43.67,0:20:44.63,JP,NTP,0,0,0,,Қасиетті жәдігерлер
Dialogue: 1,0:21:15.50,0:21:18.34,JP,NTP,0,0,0,,Қанша көрсем де, көлеңкелі қулық.
Dialogue: 1,0:21:19.23,0:21:20.93,JP,NTP,0,0,0,,Сағат мұнарасынан репортаж.
Dialogue: 1,0:21:21.45,0:21:24.97,JP,NTP,0,0,0,,Лорд Эль-Меллои жаңа жәдігерге ие болған сияқты.
Dialogue: 1,0:21:25.82,0:21:28.46,JP,NTP,0,0,0,,Қазір оның қатысуы расталған сияқты.
Dialogue: 1,0:21:29.16,0:21:32.73,JP,NTP,0,0,0,,Екі орындықтың әлі де бос тұрғаны қорқынышты.
Dialogue: 1,0:21:33.07,0:21:37.34,JP,NTP,0,0,0,,Уақыты келгенде Қасиетті Граил жеті адамды сапасына қарамай дайындайды.
Dialogue: 1,0:21:37.92,0:21:42.52,JP,NTP,0,0,0,,Ақырында, мұндай адамдар санымен, жақсы, бұл негізінен шағын заттар.
Dialogue: 1,0:21:42.98,0:21:44.36,JP,NTP,0,0,0,,Дабыл қағудың қажеті жоқ
Dialogue: 1,0:21:45.22,0:21:47.39,JP,NTP,0,0,0,,Сақтыққа келгенде, Кирей
Dialogue: 1,0:21:47.90,0:21:50.74,JP,NTP,0,0,0,,Бұл сарайға кіргеніңді ешкім көрмейді деп ойлаймын.
Dialogue: 1,0:21:51.20,0:21:54.40,JP,NTP,0,0,0,,Уайымдамаңыз, көрінетін немесе көрінбейтін
Dialogue: 1,0:21:54.76,0:21:58.28,JP,NTP,0,0,0,,Бұл сарайды бақылайтын таныс адамдар немесе сиқырлы құрылғылар жоқ.
Dialogue: 1,0:21:59.08,0:21:59.63,JP,NTP,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 1,0:21:59.98,0:22:02.26,JP,NTP,0,0,0,,Мен бұған кепілдік беремін
Dialogue: 1,0:22:03.80,0:22:05.80,JP,NTP,0,0,0,,Қандай айла қолдансаңыз да
Dialogue: 1,0:22:05.88,0:22:10.41,JP,NTP,0,0,0,,Барлаушының ерлік рухы ретінде мен Хасанды адастырмаймын.
Dialogue: 1,0:22:11.03,0:22:15.43,JP,NTP,0,0,0,,Қазіргі уақытта Ұстаздың айналасында ешқандай қудалау белгісі жоқ.
Dialogue: 1,0:22:16.81,0:22:19.32,JP,NTP,0,0,0,,Сенімді болыңыз.
Dialogue: 1,0:22:19.86,0:22:25.31,JP,NTP,0,0,0,,Егер Қасиетті Граилға шақырылған қызметші пайда болса, хабар міндетті түрде әкесіне беріледі.
Dialogue: 1,0:22:25.92,0:22:30.31,JP,NTP,0,0,0,,Басқа сиқыршылар әрекет ету үшін көп уақыт өтуі мүмкін.
Dialogue: 1,0:22:31.10,0:22:32.85,JP,NTP,0,0,0,,Assassin Бұл жер жеткілікті
Dialogue: 1,0:22:33.29,0:22:35.18,JP,NTP,0,0,0,,Сыртта қырағы болыңыз.
Dialogue: 1,0:22:35.65,0:22:36.48,JP,NTP,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 1,0:22:38.97,0:22:40.62,JP,NTP,0,0,0,,Бірақ бұл тек уақыт мәселесі
Dialogue: 1,0:22:41.84,0:22:45.84,JP,NTP,0,0,0,,Бір күні осы сарайдың айналасында басқа шеберлер шығарған таныс рухтар болады.
Dialogue: 1,0:22:45.95,0:22:48.09,JP,NTP,0,0,0,,Сіз абдырап қаласыз
Dialogue: 1,0:22:49.47,0:22:50.01,JP,NTP,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 1,0:22:50.52,0:22:52.00,JP,NTP,0,0,0,,Жеке тергеуде.
Dialogue: 1,0:22:53.02,0:22:56.80,JP,NTP,0,0,0,,Мен Эйнцберн Ұстазы туралы ақпарат жинадым.
Dialogue: 1,0:22:57.88,0:23:00.05,JP,NTP,0,0,0,,Міне тоғыз жылдай уақыт өтті.
Dialogue: 1,0:23:00.90,0:23:03.43,JP,NTP,0,0,0,,Эйнцберндер өздерінің таза қанды тегін мақтан тұтты.
Dialogue: 1,0:23:04.25,0:23:07.40,JP,NTP,0,0,0,,Кенет сырттан келген сиқыршыны күйеу бала етіп алды.
Dialogue: 1,0:23:09.99,0:23:13.78,JP,NTP,0,0,0,,Эйнцберндер отбасының сиқыршысы алғашында алхимияға маманданған.
Dialogue: 1,0:23:14.03,0:23:15.36,JP,NTP,0,0,0,,Дөрекі төсеу үшін жарамсыз
Dialogue: 1,0:23:16.27,0:23:19.63,JP,NTP,0,0,0,,Өткен Қасиетті Граил соғысындағы жеңілуіміздің себебі де осы болды.
Dialogue: 1,0:23:20.61,0:23:23.30,JP,NTP,0,0,0,,Менің ойымша, сондықтан олар ақыры одан шаршады.
Dialogue: 1,0:23:24.37,0:23:28.24,JP,NTP,0,0,0,,Шақырылған сиқыршы: «Бұл керемет» деген адам.
Dialogue: 1,0:23:31.36,0:23:32.62,JP,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 1,0:23:34.58,0:23:36.76,JP,NTP,0,0,0,,Ол «Сиқыршы өлтіруші» деген атпен белгілі болды.
Dialogue: 1,0:23:42.94,0:23:46.85,JP,NTP,0,0,0,,Корнуоллда біраз уақыт зерттелген қасиетті жәдігерлер табылды.
Dialogue: 1,0:23:47.05,0:23:48.63,JP,NTP,0,0,0,,Ақыры табылды
Dialogue: 1,0:23:48.88,0:23:50.35,JP,NTP,0,0,0,,Егер біз оны орта ретінде қолдансақ
Dialogue: 1,0:23:50.56,0:23:53.49,JP,NTP,0,0,0,,Қылыштың қаһармандық рухын қанша елестете аламын.
Dialogue: 1,0:23:53.72,0:23:56.49,JP,NTP,0,0,0,,Ең күшті қызметші шақырылады
Dialogue: 1,0:23:56.95,0:23:57.76,JP,NTP,0,0,0,,Кирицугу
Dialogue: 1,0:23:58.26,0:24:03.09,JP,NTP,0,0,0,,Мұны Эйнцберннің сізге жасаған ең үлкен көмегі деп санаңыз.
Dialogue: 1,0:24:04.02,0:24:06.20,JP,NTP,0,0,0,,Ауырды, мырза.
Dialogue: 1,0:24:06.58,0:24:09.40,JP,NTP,0,0,0,,Дәл осы жолы бір адамды да қалдырмаңыз.
Dialogue: 1,0:24:09.94,0:24:12.43,JP,NTP,0,0,0,,Барлық алты қызметшіні аңды
Dialogue: 1,0:24:12.74,0:24:16.59,JP,NTP,0,0,0,,Үшінші сиқырға, аспан тостағанына міндетті түрде қол жеткізіңіз.
Dialogue: 1,0:24:17.31,0:24:17.69,JP,NTP,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 1,0:24:19.85,0:24:21.41,JP,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 1,0:24:21.97,0:24:24.51,JP,NTP,0,0,0,,Бұл атау таныс сияқты.
Dialogue: 1,0:24:26.00,0:24:28.49,JP,NTP,0,0,0,,Собор шіркеуінде де жаңғырықты ма?
Dialogue: 1,0:24:29.79,0:24:31.83,JP,NTP,0,0,0,,Сиқыршы өлтіруші Эмиия туралы айту
Dialogue: 1,0:24:31.97,0:24:33.78,JP,NTP,0,0,0,,Ол кезде өте танымал болды.
Dialogue: 1,0:24:34.78,0:24:38.23,JP,NTP,0,0,0,,Ол Сиқырлы шіркеуге жатпайтын, сырттан шыққан адам болғанымен.
Dialogue: 1,0:24:38.99,0:24:43.44,JP,NTP,0,0,0,,Жоғарғы жақтағылар оны әртүрлі мақсатта пайдаланған сияқты.
Dialogue: 1,0:24:43.59,0:24:46.09,JP,NTP,0,0,0,,Біз соборлық шіркеуде айтқандай
Dialogue: 1,0:24:46.25,0:24:48.26,JP,NTP,0,0,0,,Агент сияқты ма?
Dialogue: 1,0:24:48.64,0:24:50.14,JP,NTP,0,0,0,,Одан да сорақы
Dialogue: 1,0:24:50.50,0:24:53.67,JP,NTP,0,0,0,,Бұл адам тек сиқыршыларға ғана маманданған.
Dialogue: 1,0:24:53.90,0:24:56.52,JP,NTP,0,0,0,,Бұл штаттан тыс өлтіруші сияқты.
Dialogue: 1,0:24:56.93,0:24:58.35,JP,NTP,0,0,0,,Өйткені мен сиқыршыны білемін
Dialogue: 1,0:24:58.60,0:25:01.14,JP,NTP,0,0,0,,Ең сиқырсыз жолмен
Dialogue: 1,0:25:01.30,0:25:02.91,JP,NTP,0,0,0,,Сиқыршыны іздеңіз
Dialogue: 1,0:25:04.39,0:25:05.67,JP,NTP,0,0,0,,Оқыңыз.
Dialogue: 1,0:25:07.31,0:25:09.53,JP,NTP,0,0,0,,Мергеннің улануы
Dialogue: 1,0:25:09.74,0:25:11.95,JP,NTP,0,0,0,,Қоғамдық орындарда бомбалау
Dialogue: 1,0:25:12.39,0:25:16.75,JP,NTP,0,0,0,,Нысана бортында болғандықтан бүкіл жолаушы ұшағын атып түсіру
Dialogue: 1,0:25:17.49,0:25:20.55,JP,NTP,0,0,0,,Мынандай төмен тактиканы еш ойланбастан жүргізетін адам.
Dialogue: 1,0:25:22.59,0:25:23.70,JP,NTP,0,0,0,,Сиқыршы дегеніміз не?
Dialogue: 1,0:25:24.18,0:25:26.90,JP,NTP,0,0,0,,Дәл дүние заңдарынан тыс өмір сүретіндіктен.
Dialogue: 1,0:25:27.30,0:25:30.74,JP,NTP,0,0,0,,Өздігінен бекітілген заңдарды қатаң сақтау керек
Dialogue: 1,0:25:31.37,0:25:32.52,JP,NTP,0,0,0,,Бірақ бұл адам
Dialogue: 1,0:25:32.85,0:25:36.55,JP,NTP,0,0,0,,Менде сиқыршы болғаныма мақтаныш сезімі жоқ.
Dialogue: 1,0:25:37.12,0:25:39.36,JP,NTP,0,0,0,,Мен мұндай мінез-құлыққа мүлдем шыдай алмаймын.
Dialogue: 1,0:25:40.79,0:25:41.54,JP,NTP,0,0,0,,Сонымен
Dialogue: 1,0:25:42.98,0:25:45.78,JP,NTP,0,0,0,,Бұл адам Кирицугу Эмиия деп аталады
Dialogue: 1,0:25:47.05,0:25:49.29,JP,NTP,0,0,0,,Адам өлтірудің мақсаты қандай?
Dialogue: 1,0:25:49.82,0:25:51.95,JP,NTP,0,0,0,,Мүмкін ақша.
Dialogue: 1,0:25:52.68,0:25:54.39,JP,NTP,0,0,0,,Бұл баяндамада да айтылуы мүмкін.
Dialogue: 1,0:25:54.97,0:25:58.67,JP,NTP,0,0,0,,Ол тек сиқыршыны өлтіруге қатысқан жоқ.
Dialogue: 1,0:25:59.23,0:26:02.18,JP,NTP,0,0,0,,Дүние жүзіндегі қақтығыс аймақтарында кез келген мүмкіндікте пайда болу.
Dialogue: 1,0:26:02.47,0:26:05.35,JP,NTP,0,0,0,,Жалдамалы болып қалталы ақша тапқан көрінеді.
Dialogue: 1,0:26:06.25,0:26:07.12,JP,NTP,0,0,0,,Осы құжат
Dialogue: 1,0:26:08.41,0:26:10.73,JP,NTP,0,0,0,,Мен қарызға ақша аламын ба?
Dialogue: 1,0:26:16.73,0:26:19.36,JP,NTP,0,0,0,,Airi жинаған ақпаратты жүйелеп көрейік
Dialogue: 1,0:26:20.96,0:26:23.18,JP,NTP,0,0,0,,Қасиетті Граил таңдаған жеті шебердің ішінен
Dialogue: 1,0:26:23.65,0:26:25.58,JP,NTP,0,0,0,,Қазіргі уақытта төрт адам белгілі.
Dialogue: 1,0:26:26.22,0:26:27.45,JP,NTP,0,0,0,,Токиоми Тохсака
Dialogue: 1,0:26:27.89,0:26:29.34,JP,NTP,0,0,0,,Тохсака әулетінің басшысы
Dialogue: 1,0:26:29.65,0:26:31.66,JP,NTP,0,0,0,,Өрт атрибуты бар зергерлік сиқырды өңдеу
Dialogue: 1,0:26:31.75,0:26:33.63,JP,NTP,0,0,0,,Ол қатал жігіт.
Dialogue: 1,0:26:33.79,0:26:34.83,JP,NTP,0,0,0,,Кария Мату
Dialogue: 1,0:26:36.38,0:26:38.12,JP,NTP,0,0,0,,Отағасына үлгере алмаған тентектер
Dialogue: 1,0:26:38.22,0:26:40.69,JP,NTP,0,0,0,,Олар сізді шебер болуға мәжбүр етті ме?
Dialogue: 1,0:26:40.92,0:26:42.65,JP,NTP,0,0,0,,Сол жақтағы қария да шарасыз.
Dialogue: 1,0:26:43.40,0:26:45.56,JP,NTP,0,0,0,,Кейнет Эль-Меллои Арчибалд
Dialogue: 1,0:26:46.16,0:26:48.15,JP,NTP,0,0,0,,Жел мен судың қос атрибуттары бар.
Dialogue: 1,0:26:48.39,0:26:52.62,JP,NTP,0,0,0,,Некромантия, шақыру, мұнай өңдеу зауытының сарапшысы
Dialogue: 1,0:26:53.36,0:26:53.97,JP,NTP,0,0,0,,Содан кейін
Dialogue: 1,0:26:54.25,0:26:55.48,JP,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 1,0:26:56.05,0:26:59.04,JP,NTP,0,0,0,,Эйнцберндер шақырған ең күшті козир
Dialogue: 1,0:27:00.07,0:27:02.05,JP,NTP,0,0,0,,Менің сүйіктім
Dialogue: 1,0:27:04.54,0:27:05.80,JP,NTP,0,0,0,,Және төртінші
Dialogue: 1,0:27:06.06,0:27:08.19,JP,NTP,0,0,0,,Жоқ, бесінші шебер
Dialogue: 1,0:27:08.67,0:27:10.58,JP,NTP,0,0,0,,Собор шіркеуінен алынған
Dialogue: 1,0:27:10.85,0:27:12.64,JP,NTP,0,0,0,,Аты - Котомине Кирей
Dialogue: 1,0:27:13.07,0:27:14.76,JP,NTP,0,0,0,,Собор шіркеуінен
Dialogue: 1,0:27:15.09,0:27:18.49,JP,NTP,0,0,0,,Ол жетекші болып қызмет ететін Римаса Котомине әкенің ұлы.
Dialogue: 1,0:27:19.34,0:27:21.52,JP,NTP,0,0,0,,Мен үш жыл бойы Токиоми Тохсаканың қол астында оқыдым.
Dialogue: 1,0:27:21.96,0:27:25.70,JP,NTP,0,0,0,,Бұйрық сиқырын алғаннан кейін ол ұстазымен ажырасып кеткен дейді.
Dialogue: 1,0:27:26.30,0:27:27.20,JP,NTP,0,0,0,,Не болды?
Dialogue: 1,0:27:28.13,0:27:29.93,JP,NTP,0,0,0,,Тіпті менің фоным да тазартылды.
Dialogue: 1,0:27:31.23,0:27:32.73,JP,NTP,0,0,0,,Оны да оқу керек.
Dialogue: 1,0:27:34.32,0:27:35.56,JP,NTP,0,0,0,,Кирей Котомине
Dialogue: 1,0:27:35.85,0:27:39.67,JP,NTP,0,0,0,,Бала кезінен әкесі Рисейді ертіп киелі жерлерге зиярат еткен.
Dialogue: 1,0:27:39.94,0:27:42.70,JP,NTP,0,0,0,,Манресаның Игнатиялық семинариясын бітірген
Dialogue: 1,0:27:43.28,0:27:44.61,JP,NTP,0,0,0,,2 жыл өткізіп жіберу
Dialogue: 1,0:27:44.94,0:27:46.39,JP,NTP,0,0,0,,Оның үстіне бастық
Dialogue: 1,0:27:46.58,0:27:48.20,JP,NTP,0,0,0,,Ол керемет адам сияқты.
Dialogue: 1,0:27:48.43,0:27:53.02,JP,NTP,0,0,0,,Алайда, ол кенеттен табысқа жету жолынан адасып, собор шіркеуіне жүгінеді.
Dialogue: 1,0:27:53.92,0:27:55.34,JP,NTP,0,0,0,,Себеп бойынша
Dialogue: 1,0:27:55.45,0:27:58.57,JP,NTP,0,0,0,,Ол өзін шіркеудің астыртын ұйымына қатысы бар деп көрсетті ме?
Dialogue: 1,0:27:58.93,0:28:00.80,JP,NTP,0,0,0,,Әкемнің ықпалынан ба?
Dialogue: 1,0:28:01.03,0:28:05.91,JP,NTP,0,0,0,,Қараңызшы, оның әкесі сияқты соборлық шіркеудің Сегізінші Сакраментальдық орденіне жататыны жазылған.
Dialogue: 1,0:28:06.45,0:28:09.65,JP,NTP,0,0,0,,Олай болса, ол әкесінің жолын әу бастан мақсат ету керек еді.
Dialogue: 1,0:28:10.10,0:28:13.14,JP,NTP,0,0,0,,Бірақ мен әкеммен бір бөлімге орналасқанша.
Dialogue: 1,0:28:13.49,0:28:15.56,JP,NTP,0,0,0,,Үш рет мүшелік өзгерді
Dialogue: 1,0:28:16.14,0:28:18.99,JP,NTP,0,0,0,,Ол тіпті бір рет агент болып тағайындалды.
Dialogue: 1,0:28:19.63,0:28:20.55,JP,NTP,0,0,0,,Агент
Dialogue: 1,0:28:21.48,0:28:23.30,JP,NTP,0,0,0,,Ол бидғатты бағындыру үшін жауапты.
Dialogue: 1,0:28:24.21,0:28:24.88,JP,NTP,0,0,0,,Қысқасы
Dialogue: 1,0:28:25.65,0:28:29.12,JP,NTP,0,0,0,,Менің рөлім бұрынғыдай сиқыршыны өлтіру.
Dialogue: 1,0:28:30.30,0:28:31.71,JP,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 1,0:28:32.54,0:28:34.71,JP,NTP,0,0,0,,Оған жатқызылған қастандық
Dialogue: 1,0:28:35.01,0:28:37.66,JP,NTP,0,0,0,,Қысқа уақыт ішінде дәйекті түрде орындалды
Dialogue: 1,0:28:37.80,0:28:41.00,JP,NTP,0,0,0,,Сонымен қатар қақтығыс аймақтары да өзгереді.
Dialogue: 1,0:28:41.32,0:28:45.10,JP,NTP,0,0,0,,Олар соғыс жағдайы күшейген кезде ғана пайда болады.
Dialogue: 1,0:28:45.74,0:28:48.12,JP,NTP,0,0,0,,Өлім орнына барғандай.
Dialogue: 1,0:28:48.48,0:28:51.26,JP,NTP,0,0,0,,Қандай да бір құмарлық бар сияқты.
Dialogue: 1,0:28:51.40,0:28:53.92,JP,NTP,0,0,0,,Іс-әрекеттің айқын өзін-өзі жою принциптері
Dialogue: 1,0:28:56.20,0:28:58.11,JP,NTP,0,0,0,,Бұл нені білдіреді?
Dialogue: 1,0:28:59.01,0:29:02.86,JP,NTP,0,0,0,,Тазалау Рухы Сәуегейлік емдеуге шақыру
Dialogue: 1,0:29:03.32,0:29:03.89,JP,NTP,0,0,0,,Қараңыз
Dialogue: 1,0:29:04.30,0:29:07.02,JP,NTP,0,0,0,,Бұл оның үйренген сиқырлық категориясы.
Dialogue: 1,0:29:07.80,0:29:09.22,JP,NTP,0,0,0,,Бұл позитив дегеніміз не?
Dialogue: 1,0:29:09.66,0:29:12.34,JP,NTP,0,0,0,,Барлығын келесі деңгейге көтеріңіз.
Dialogue: 1,0:29:12.60,0:29:15.97,JP,NTP,0,0,0,,Сол жерден еш өкінбей келесі жанрға ауысыңыз.
Dialogue: 1,0:29:16.39,0:29:21.66,JP,NTP,0,0,0,,Осы уақытқа дейін өсіргенімнің бәрін лақтырып жібергендеймін.
Dialogue: 1,0:29:22.87,0:29:23.65,JP,NTP,0,0,0,,Айри
Dialogue: 1,0:29:24.83,0:29:28.35,JP,NTP,0,0,0,,Котомине Кирейдің түрі мен үшін қорқынышты.
Dialogue: 1,0:29:28.73,0:29:31.07,JP,NTP,0,0,0,,Бұл адамның өзімшілдік туралы ойлары жоқ.
Dialogue: 1,0:29:31.36,0:29:36.10,JP,NTP,0,0,0,,Оның әрекеттері практикалық пайда мен тәуекел арасындағы теңгерімсіз.
Dialogue: 1,0:29:36.60,0:29:40.84,JP,NTP,0,0,0,,Бұл жігіттің ақша іздеген фрилансер болуы мүмкін емес.
Dialogue: 1,0:29:41.02,0:29:44.88,JP,NTP,0,0,0,,Бұл кісінің өмірінде бірде-бір құмарлық жоқ.
Dialogue: 1,0:29:45.25,0:29:47.49,JP,NTP,0,0,0,,Бұл кісі ештеңеге сенбейтін шығар.
Dialogue: 1,0:29:48.05,0:29:52.01,JP,NTP,0,0,0,,Сізде қалау деп атауға болатын ештеңе жоқ шығар.
Dialogue: 1,0:29:53.08,0:29:54.40,JP,NTP,0,0,0,,Мұндай адам
Dialogue: 1,0:29:54.69,0:29:57.21,JP,NTP,0,0,0,,Сонымен не іздеп жүрсіз?
Dialogue: 1,0:29:57.64,0:30:01.06,JP,NTP,0,0,0,,Неліктен Қасиетті Граалды іздеу үшін өз өміріңізді қатерге тігу керек?
Dialogue: 1,0:30:01.37,0:30:02.09,JP,NTP,0,0,0,,Бірақ
Dialogue: 1,0:30:02.47,0:30:06.83,JP,NTP,0,0,0,,Кирей Котомине Қасиетті Граил шеберлерінің бірі болып таңдалды.
Dialogue: 1,0:30:06.91,0:30:07.67,JP,NTP,0,0,0,,Иә.
Dialogue: 1,0:30:08.28,0:30:12.70,JP,NTP,0,0,0,,Бұл адамның Қасиетті Граильді алу үшін жеткілікті байланысы болуы керек.
Dialogue: 1,0:30:13.46,0:30:16.45,JP,NTP,0,0,0,,Бірақ мен оның не екенін көре алмаймын.
Dialogue: 1,0:30:17.03,0:30:19.29,JP,NTP,0,0,0,,Бұл мен үшін қорқынышты.
Dialogue: 1,0:30:21.46,0:30:22.65,JP,NTP,0,0,0,,Кирей Котомине
Dialogue: 1,0:30:23.61,0:30:24.93,JP,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 1,0:30:25.99,0:30:29.27,JP,NTP,0,0,0,,Бұл кісінің шайқасы тойымсыз қайталанды.
Dialogue: 1,0:30:29.81,0:30:32.50,JP,NTP,0,0,0,,9 жыл бұрын кенет аяқталды.
Dialogue: 1,0:30:32.84,0:30:36.35,JP,NTP,0,0,0,,Солтүстік сиқыршысы Эйнцбернмен кездесу
Dialogue: 1,0:30:37.01,0:30:40.92,JP,NTP,0,0,0,,Сол кезде ол өз жауабын алды.
Dialogue: 1,0:30:41.25,0:30:43.14,JP,NTP,0,0,0,,Олай болса сұрау керек
Dialogue: 1,0:30:43.51,0:30:45.22,JP,NTP,0,0,0,,Не үшін күресу керек
Dialogue: 1,0:30:45.37,0:30:46.84,JP,NTP,0,0,0,,Соңында
Dialogue: 1,0:30:48.30,0:30:50.07,JP,NTP,0,0,0,,Не алдыңыз?
Dialogue: 1,0:31:00.70,0:31:03.67,JP,NTP,0,0,0,,Біз уақытында әрең жеткен жоқпыз ба?
Dialogue: 1,0:31:04.16,0:31:06.23,JP,NTP,0,0,0,,Қасиетті Граил ретінде таңдалу дегенді білдіреді
Dialogue: 1,0:31:06.44,0:31:10.26,JP,NTP,0,0,0,,Бұл сіздің де лайықты сиқыршы ретінде танылғаныңызды білдіреді.
Dialogue: 1,0:31:10.55,0:31:13.81,JP,NTP,0,0,0,,​​Мен сені әзірше мақтаймын, Қария.
Dialogue: 1,0:31:15.14,0:31:16.03,JP,NTP,0,0,0,,Картоп
Dialogue: 1,0:31:16.86,0:31:19.54,JP,NTP,0,0,0,,Қандай сұмдық көрініс.
Dialogue: 1,0:31:20.13,0:31:23.15,JP,NTP,0,0,0,,Сол аяғыңыз әлі қозғала ма?
Dialogue: 1,0:31:32.18,0:31:33.57,JP,NTP,0,0,0,,Ашуланба Ашуланба
Dialogue: 1,0:31:33.76,0:31:36.18,JP,NTP,0,0,0,,Денеңіздегі жәндіктердің ізін қоздырсаңыз
Dialogue: 1,0:31:36.35,0:31:39.39,JP,NTP,0,0,0,,Жәндіктер сені жеп қояды.
Dialogue: 1,0:31:39.82,0:31:42.00,JP,NTP,0,0,0,,Менің көзқарасым бойынша
Dialogue: 1,0:31:42.06,0:31:46.46,JP,NTP,0,0,0,,Өмір сүруіңізге бір ай ғана қалды.
Dialogue: 1,0:31:47.00,0:31:47.68,JP,NTP,0,0,0,,Жетеді.
Dialogue: 1,0:31:48.40,0:31:49.56,JP,NTP,0,0,0,,Бұл не?
Dialogue: 1,0:31:49.91,0:31:52.17,JP,NTP,0,0,0,,Мен бұл жеткілікті дедім.
Dialogue: 1,0:31:53.30,0:31:56.40,JP,NTP,0,0,0,,Қария, бір жыл шыдағаның үшін сыйың.
Dialogue: 1,0:31:56.56,0:32:00.22,JP,NTP,0,0,0,,Мен саған лайықты қасиетті жәдігер таптым.
Dialogue: 1,0:32:01.07,0:32:04.34,JP,NTP,0,0,0,,Әкемнің мейіріміне жол бермеймін.
Dialogue: 1,0:32:16.81,0:32:19.05,JP,NTP,0,0,0,,Бұйрық сиқыры менде де болды.
Dialogue: 1,0:32:19.66,0:32:21.47,JP,NTP,0,0,0,,Мен Қасиетті Граил болу үшін таңдалдым.
Dialogue: 1,0:32:21.92,0:32:24.71,JP,NTP,0,0,0,,Қасиетті Граил менің талантымды мойындады.
Dialogue: 1,0:32:27.54,0:32:29.31,JP,NTP,0,0,0,,Мен мәңгі бақытты бола алмаймын
Dialogue: 1,0:32:29.79,0:32:32.32,JP,NTP,0,0,0,,Мен қызметшіні шақыруға дайындалуым керек.
Dialogue: 1,0:32:35.86,0:32:38.54,JP,NTP,0,0,0,,Ол Фуюки қаласында кеше кештен бері хабарсыз кеткен.
Dialogue: 1,0:32:38.84,0:32:40.19,JP,NTP,0,0,0,,Қайырлы таң Вавер
Dialogue: 1,0:32:40.26,0:32:42.13,JP,NTP,0,0,0,,Қайырлы таң Уэйвер-чан
Dialogue: 1,0:32:43.92,0:32:47.07,JP,NTP,0,0,0,,Қайырлы таң, ата мен әже.
Dialogue: 1,0:32:48.49,0:32:50.43,JP,NTP,0,0,0,,Фуюки де мазасызданды.
Dialogue: 1,0:32:50.52,0:32:52.06,JP,NTP,0,0,0,,Иә, мүлдем
Dialogue: 1,0:32:52.84,0:32:54.69,JP,NTP,0,0,0,,Қалай болғанда да, сәлем Марта
Dialogue: 1,0:32:55.02,0:32:58.82,JP,NTP,0,0,0,,Таңертеңнен бері тауықтардың қатты дауысы шыққаны сонша, мен оларға шыдай алмаймын.
Dialogue: 1,0:32:59.31,0:33:00.89,JP,NTP,0,0,0,,Қызық, бұл не?
Dialogue: 1,0:33:01.02,0:33:04.36,JP,NTP,0,0,0,,Менің бақшамда үш тауық бар.
Dialogue: 1,0:33:04.47,0:33:05.79,JP,NTP,0,0,0,,Менің бақшамда
Dialogue: 1,0:33:06.04,0:33:07.27,JP,NTP,0,0,0,,Не болды, мырза Мокки!
Dialogue: 1,0:33:07.35,0:33:09.72,JP,NTP,0,0,0,,Қызық, қайдан шықты?
Dialogue: 1,0:33:10.84,0:33:12.97,JP,NTP,0,0,0,,Уэйвер-чан да кофе іше алады.
Dialogue: 1,0:33:14.76,0:33:17.54,JP,NTP,0,0,0,,Вавер-чан, бұл қол не болды?
Dialogue: 1,0:33:18.82,0:33:19.47,JP,NTP,0,0,0,,Шима
Dialogue: 1,0:33:19.54,0:33:20.27,JP,NTP,0,0,0,,Туған белгі
Dialogue: 1,0:33:20.73,0:33:21.90,JP,NTP,0,0,0,,Тіпті туу белгісі
Dialogue: 1,0:33:22.02,0:33:24.57,JP,NTP,0,0,0,,Ол көгерген жер күні кешеге дейін болған жоқ.
Dialogue: 1,0:33:25.05,0:33:26.69,JP,NTP,0,0,0,,Шабуыл
Dialogue: 1,0:33:27.41,0:33:29.59,JP,NTP,0,0,0,,Мен қажет емес нәрсені байқадым
Dialogue: 1,0:33:29.91,0:33:31.41,JP,NTP,0,0,0,,Не болды, Уэйвер?
Dialogue: 1,0:33:31.74,0:33:32.80,JP,NTP,0,0,0,,Вавер-чан
Dialogue: 1,0:33:33.21,0:33:34.56,JP,NTP,0,0,0,,Мен бұған көмектесе алмаймын.
Dialogue: 1,0:33:34.98,0:33:36.97,JP,NTP,0,0,0,,Жүр, кофе ішейік.
Dialogue: 1,0:33:37.09,0:33:38.79,JP,NTP,0,0,0,,Сүтті көп қосыңыз
Dialogue: 1,0:33:39.02,0:33:40.34,JP,NTP,0,0,0,,Бұл екеуіңе де ұнайды.
Dialogue: 1,0:33:41.82,0:33:42.85,JP,NTP,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 1,0:33:50.15,0:33:51.16,JP,NTP,0,0,0,,Тағы да
Dialogue: 1,0:33:51.56,0:33:54.65,JP,NTP,0,0,0,,Себебі мен шетелден оқудан оралған немеремін.
Dialogue: 1,0:33:54.74,0:33:57.58,JP,NTP,0,0,0,,Менің ойымша, егер сіз оған кеңес бермесеңіз, бұл жақсы емес.
Dialogue: 1,0:34:01.91,0:34:05.65,JP,NTP,0,0,0,,Мен ұрлаған тауықты жасыруым керек.
Dialogue: 1,0:34:06.67,0:34:10.64,JP,NTP,0,0,0,,Аты аңызға айналған қасиетті қылыштың қынасын табамын деп ешқашан ойламаппын.
Dialogue: 1,0:34:11.14,0:34:12.48,JP,NTP,0,0,0,,Кемшіліктері жоқ
Dialogue: 1,0:34:13.01,0:34:16.23,JP,NTP,0,0,0,,Бұл 1500 жыл бұрынғы дәуірдің қазылған заты.
Dialogue: 1,0:34:16.78,0:34:19.68,JP,NTP,0,0,0,,Мұның өзі «концептуалды қаруланудың» бір түрі.
Dialogue: 1,0:34:20.11,0:34:23.29,JP,NTP,0,0,0,,Материал ретінде ол табиғи ауа райына әсер етпеуі мүмкін.
Dialogue: 1,0:34:23.94,0:34:25.66,JP,NTP,0,0,0,,Тек оны жабдықтау арқылы
Dialogue: 1,0:34:25.78,0:34:29.01,JP,NTP,0,0,0,,Аңыз бойынша, бұл қабық иесінің жарасын емдейді.
Dialogue: 1,0:34:29.21,0:34:30.81,JP,NTP,0,0,0,,Қартаюды тоқтатады
Dialogue: 1,0:34:31.27,0:34:35.41,JP,NTP,0,0,0,,Әрине, егер бастапқы иесі сиқырлы қуат берсе.
Dialogue: 1,0:34:35.76,0:34:39.22,JP,NTP,0,0,0,,Басқаша айтқанда, шақырылған батырлық рухпен жұп ретінде қолдансаңыз.
Dialogue: 1,0:34:39.59,0:34:43.01,JP,NTP,0,0,0,,Мұның өзін шебердің асыл фантасмасы ретінде пайдалануға болады.
Dialogue: 1,0:34:43.31,0:34:44.73,JP,NTP,0,0,0,,Сізге ұқсайды.
Dialogue: 1,0:34:45.01,0:34:47.54,JP,NTP,0,0,0,,Құрал әрқашан құрал болып табылады
Dialogue: 1,0:34:47.86,0:34:50.99,JP,NTP,0,0,0,,Олай десеңіз, қызметшілер үшін де солай.
Dialogue: 1,0:34:51.14,0:34:55.33,JP,NTP,0,0,0,,Батырлық рух қанша атақты болса да, қызметші болып шақырылса.
Dialogue: 1,0:34:55.69,0:34:57.74,JP,NTP,0,0,0,,Шеберге ол құрал сияқты жақсы.
Dialogue: 1,0:34:58.39,0:35:00.92,JP,NTP,0,0,0,,Онда біртүрлі елес әкелетіндер
Dialogue: 1,0:35:01.41,0:35:03.90,JP,NTP,0,0,0,,Мен бұл шайқастан аман қалмайтыныма сенімдімін.
Dialogue: 1,0:35:04.38,0:35:07.34,JP,NTP,0,0,0,,Бұл қынап сізге сәйкес келеді.
Dialogue: 1,0:35:07.75,0:35:10.02,JP,NTP,0,0,0,,Бұл атаның шешімі, солай емес пе?
Dialogue: 1,0:35:10.59,0:35:12.22,JP,NTP,0,0,0,,Бұл шынымен де солай ма?
Dialogue: 1,0:35:13.16,0:35:15.64,JP,NTP,0,0,0,,Атаның сыйына көңілі толмаған
Dialogue: 1,0:35:15.97,0:35:19.55,JP,NTP,0,0,0,,Амал жоқ, Ахт тамаша жұмыс жасады.
Dialogue: 1,0:35:19.78,0:35:22.93,JP,NTP,0,0,0,,Менің ойымша, мұндай қолында козирі бар шебер болған жоқ.
Dialogue: 1,0:35:23.11,0:35:25.20,JP,NTP,0,0,0,,Сонда не болды?
Dialogue: 1,0:35:25.35,0:35:28.56,JP,NTP,0,0,0,,Ондай мінсіз қасиетті жәдігер болса ше?
Dialogue: 1,0:35:29.08,0:35:33.63,JP,NTP,0,0,0,,Сіз іздеген батырлық рухтың шақыруға жауап беретіні сөзсіз.
Dialogue: 1,0:35:34.73,0:35:38.10,JP,NTP,0,0,0,,Аңызға айналған рыцарь король Артур Пендрагон
Dialogue: 1,0:35:38.85,0:35:40.72,JP,NTP,0,0,0,,Шебер ретінде менімен үйлесімділігіңіз қандай?
Dialogue: 1,0:35:41.09,0:35:42.46,JP,NTP,0,0,0,,Екінші орын алыңыз.
Dialogue: 1,0:35:43.13,0:35:45.77,JP,NTP,0,0,0,,Бірақ егер сіз «уәде етілген жеңіс қылышын» алып жүрсеңіз
Dialogue: 1,0:35:45.96,0:35:49.53,JP,NTP,0,0,0,,Сабер сыныбының ең жақсы картасы.
Dialogue: 1,0:35:49.98,0:35:50.63,JP,NTP,0,0,0,,That's right.
Dialogue: 1,0:35:51.49,0:35:54.89,JP,NTP,0,0,0,,Менде бәрінен де жеңілмейтін қызметші болады.
Dialogue: 1,0:35:55.33,0:35:56.40,JP,NTP,0,0,0,,Мәселе мынада
Dialogue: 1,0:35:57.00,0:36:00.69,JP,NTP,0,0,0,,Мен осы ең күшті күшті қалай толық пайдалануым керек?
Dialogue: 1,0:36:01.08,0:36:03.95,JP,NTP,0,0,0,,Шынымды айтсам, өңдеудің қарапайымдылығы жағынан
Dialogue: 1,0:36:04.27,0:36:06.29,JP,NTP,0,0,0,,Кастер немесе өлтіруші
Dialogue: 1,0:36:06.41,0:36:08.59,JP,NTP,0,0,0,,Бұл менің мінезіме өте сәйкес келді.
Dialogue: 1,0:36:09.38,0:36:12.75,JP,NTP,0,0,0,,Шақыру алдында уайымдасаңыз, көмектесе алмайды.
Dialogue: 1,0:36:13.47,0:36:16.96,JP,NTP,0,0,0,,Рыцарлар патшасының шын мәнінде қандай адам екенін білмеймін.
Dialogue: 1,0:36:17.40,0:36:20.46,JP,NTP,0,0,0,,Сіздің стратегияңыз қандай болса да
Dialogue: 1,0:36:20.79,0:36:23.53,JP,NTP,0,0,0,,Арманың мен мұратыңды білсең
Dialogue: 1,0:36:24.27,0:36:25.53,JP,NTP,0,0,0,,Сіз түсінесіз.
Dialogue: 1,0:36:25.90,0:36:27.21,JP,NTP,0,0,0,,Мүмкін ол
Dialogue: 1,0:36:29.61,0:36:30.83,JP,NTP,0,0,0,,Мен сияқты
Dialogue: 1,0:36:36.44,0:36:37.13,JP,NTP,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 1,0:36:37.74,0:36:39.05,JP,NTP,0,0,0,,Маған жоспар келді
Dialogue: 1,0:36:39.89,0:36:41.49,JP,NTP,0,0,0,,Ең күшті қызметші
Dialogue: 1,0:36:43.48,0:36:46.18,JP,NTP,0,0,0,,Ең күшті қуатты пайдаланудың жолы бар
Dialogue: 1,0:36:53.96,0:36:55.29,JP,NTP,0,0,0,,Сәлем Рин
Dialogue: 1,0:36:58.07,0:36:59.60,JP,NTP,0,0,0,,Сәлем Кирей
Dialogue: 1,0:36:59.95,0:37:03.75,JP,NTP,0,0,0,,Мен шығамын деп ойлаймын. Менің жүгім көп сияқты.
Dialogue: 1,0:37:03.90,0:37:07.71,JP,NTP,0,0,0,,Е, мен сені бүгіннен бастап Өрізеннің үйінде қарайтын боламын.
Dialogue: 1,0:37:10.03,0:37:14.02,JP,NTP,0,0,0,,Кирей әкеңнің қасында қалып, бірге соғысады, солай ма?
Dialogue: 1,0:37:14.48,0:37:18.09,JP,NTP,0,0,0,,Сол үшін сенің шәкіртің болып келдім.
Dialogue: 1,0:37:19.93,0:37:22.70,JP,NTP,0,0,0,,Кирей, мен саған сенсем болады ма?
Dialogue: 1,0:37:24.35,0:37:28.82,JP,NTP,0,0,0,,Әкеңді соңына дейін аман-есен қорғауға уәде бересің бе?
Dialogue: 1,0:37:29.38,0:37:31.50,JP,NTP,0,0,0,,Бұл мүмкін емес сұрақ.
Dialogue: 1,0:37:31.80,0:37:35.90,JP,NTP,0,0,0,,Егер мұндай уәде беру үшін шайқас жеткілікті бейбіт болса.
Dialogue: 1,0:37:36.26,0:37:40.27,JP,NTP,0,0,0,,Сізді немесе әйеліңізді эвакуациялаудың қажеті болмайды.
Dialogue: 1,0:37:43.25,0:37:46.75,JP,NTP,0,0,0,,Өйткені, мен саған ғашық бола алмаймын.
Dialogue: 1,0:37:47.02,0:37:51.45,JP,NTP,0,0,0,,Рин Сіз өзіңіздің шынайы сезімдеріңізді көпшілік алдында бұлай білдірмеуіңіз керек.
Dialogue: 1,0:37:51.88,0:37:56.48,JP,NTP,0,0,0,,Әйтпесе, сені тәрбиелеп отырған әкенің қадір-қасиетіне күмән келтіріледі.
Dialogue: 1,0:37:56.77,0:37:58.64,JP,NTP,0,0,0,,Әкеңнің бұған қатысы жоқ шығар.
Dialogue: 1,0:37:58.94,0:37:59.84,JP,NTP,0,0,0,,Жақсы Кирей
Dialogue: 1,0:38:00.03,0:38:03.93,JP,NTP,0,0,0,,Әкеңді ренжітсең ше?
Dialogue: 1,0:38:04.27,0:38:06.03,JP,NTP,0,0,0,,Мен сені ешқашан кешірмеймін.
Dialogue: 1,0:38:06.43,0:38:10.02,JP,NTP,0,0,0,,Рин, сен дауыстап не істеп жатырсың?
Dialogue: 1,0:38:11.47,0:38:12.23,JP,NTP,0,0,0,,Жақсы
Dialogue: 1,0:38:13.64,0:38:14.44,JP,NTP,0,0,0,,Бұл
Dialogue: 1,0:38:14.79,0:38:19.35,JP,NTP,0,0,0,,Біз қоштасар алдында ол мені жігерлендірді, ханым.
Dialogue: 1,0:38:20.40,0:38:21.30,JP,NTP,0,0,0,,Көмектесейік
Dialogue: 1,0:38:21.59,0:38:24.52,JP,NTP,0,0,0,,Ол чемодан саған тым ауыр болады.
Dialogue: 1,0:38:25.08,0:38:27.51,JP,NTP,0,0,0,,Ешқандай проблема жоқ, оны өзіңіз жасай аласыз.
Dialogue: 1,0:38:27.70,0:38:28.83,JP,NTP,0,0,0,,Котомине мырза
Dialogue: 1,0:38:29.33,0:38:31.86,JP,NTP,0,0,0,,Менің күйеуіме қамқорлық жасауыңызды өтінемін.
Dialogue: 1,0:38:32.15,0:38:34.54,JP,NTP,0,0,0,,Сол адамның тілегін орындаңыз.
Dialogue: 1,0:38:35.16,0:38:37.79,JP,NTP,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын, уайымдама.
Dialogue: 1,0:38:42.22,0:38:43.44,JP,NTP,0,0,0,,Кешіріңіз
Dialogue: 1,0:38:44.20,0:38:46.02,JP,NTP,0,0,0,,Сіз дұрыс жерге келдіңіз.
Dialogue: 1,0:38:46.52,0:38:50.01,JP,NTP,0,0,0,,Мен дайындаған қасиетті жәдігерлер бүгін таңертең келді.
Dialogue: 1,0:38:50.20,0:38:51.46,JP,NTP,0,0,0,,Қараңыз
Dialogue: 1,0:38:52.89,0:38:53.79,JP,NTP,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 1,0:38:55.11,0:38:56.20,JP,NTP,0,0,0,,Сонау ежелгі дәуір
Dialogue: 1,0:38:56.85,0:39:00.53,JP,NTP,0,0,0,,Бұл дүниеде алғаш рет терісін төккен жыланның тасқа айналған қабығы.
Dialogue: 1,0:39:01.11,0:39:02.50,JP,NTP,0,0,0,,Осы құрал арқылы
Dialogue: 1,0:39:02.72,0:39:05.05,JP,NTP,0,0,0,,Егер сіз оны сәтті шақырсаңыз
Dialogue: 1,0:39:05.07,0:39:06.58,JP,NTP,0,0,0,,Сол кезде
Dialogue: 1,0:39:06.83,0:39:09.43,JP,NTP,0,0,0,,Біздің жеңісіміз бекітілді.
Dialogue: 1,0:39:15.45,0:39:17.04,JP,NTP,0,0,0,,Сәлем Сакура-чан
Dialogue: 1,0:39:18.29,0:39:19.30,JP,NTP,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 1,0:39:20.10,0:39:21.97,JP,NTP,0,0,0,,Иә бет
Dialogue: 1,0:39:22.21,0:39:23.89,JP,NTP,0,0,0,,О, сәл ғана.
Dialogue: 1,0:39:24.17,0:39:27.93,JP,NTP,0,0,0,,Мен тағы да ішімдегі қателіктерге аздап өмірімді жоғалтқан сияқтымын.
Dialogue: 1,0:39:28.35,0:39:32.11,JP,NTP,0,0,0,,Қарт Сакура-чан сияқты шыдамды емес екеніне сенімдімін.
Dialogue: 1,0:39:33.56,0:39:37.58,JP,NTP,0,0,0,,Қария ағай барған сайын басқа адамға ұқсайды.
Dialogue: 1,0:39:40.04,0:39:41.60,JP,NTP,0,0,0,,Мүмкін солай.
Dialogue: 1,0:39:42.43,0:39:46.40,JP,NTP,0,0,0,,Бүгін түнде мен жәндіктер қоймасына барудың қажеті жоқ.
Dialogue: 1,0:39:46.74,0:39:50.40,JP,NTP,0,0,0,,Ата одан да маңызды рәсім бар деді.
Dialogue: 1,0:39:50.74,0:39:52.25,JP,NTP,0,0,0,,Мен олардың қазіргі күйінде Элкияны құтқара алатынына сенбеймін.
Dialogue: 1,0:39:52.57,0:39:55.91,JP,NTP,0,0,0,,Бүгін кешке оның орнына ағам жертөлеге барады.
Dialogue: 1,0:39:56.22,0:39:57.51,JP,NTP,0,0,0,,Қария аға
Dialogue: 1,0:39:57.68,0:39:59.52,JP,NTP,0,0,0,,Мен алыс жерге барамын
Dialogue: 1,0:39:59.88,0:40:01.03,JP,NTP,0,0,0,,Алдағы уақытта
Dialogue: 1,0:40:01.22,0:40:04.12,JP,NTP,0,0,0,,Ағам маңызды жұмыстармен айналысады.
Dialogue: 1,0:40:04.51,0:40:07.35,JP,NTP,0,0,0,,Сакура-чанмен осылай сөйлескен уақытым
Dialogue: 1,0:40:07.75,0:40:09.68,JP,NTP,0,0,0,,Ол азырақ таралған болуы мүмкін.
Dialogue: 1,0:40:10.97,0:40:11.88,JP,NTP,0,0,0,,Иә
Dialogue: 1,0:40:13.25,0:40:14.73,JP,NTP,0,0,0,,Сәлем Сакура-чан
Dialogue: 1,0:40:14.90,0:40:16.85,JP,NTP,0,0,0,,Ағамның жұмысы біткен соң
Dialogue: 1,0:40:17.04,0:40:19.22,JP,NTP,0,0,0,,Тағы бәріміз бірге шығамыз ба?
Dialogue: 1,0:40:19.41,0:40:21.34,JP,NTP,0,0,0,,Анаң мен әпкеңді де ала кел.
Dialogue: 1,0:40:22.51,0:40:24.17,JP,NTP,0,0,0,,Сенің анаң мен әпкең
Dialogue: 1,0:40:24.78,0:40:27.17,JP,NTP,0,0,0,,Сізді ешкім олай атай алмайды.
Dialogue: 1,0:40:27.78,0:40:32.28,JP,NTP,0,0,0,,«Ол жерде болмағандай кейіп таныт» деді қарт.
Dialogue: 1,0:40:34.47,0:40:35.24,JP,NTP,0,0,0,,Мен көремін.
Dialogue: 1,0:40:45.88,0:40:46.71,JP,NTP,0,0,0,,Ағай
Dialogue: 1,0:40:47.09,0:40:51.56,JP,NTP,0,0,0,,Олай болса, Тохсака отбасынан Аои-сан мен Рин-чанды алыңыз.
Dialogue: 1,0:40:51.84,0:40:53.91,JP,NTP,0,0,0,,Нағашы мен Сакура-чан және төртеуміз
Dialogue: 1,0:40:54.02,0:40:55.79,JP,NTP,0,0,0,,Алыс жерге барайық
Dialogue: 1,0:40:56.15,0:41:00.44,JP,NTP,0,0,0,,Бұрынғыдай тағы бірге ойнайық
Dialogue: 1,0:41:00.71,0:41:03.78,JP,NTP,0,0,0,,Мен ол адамдарды қайтадан көремін бе?
Dialogue: 1,0:41:04.19,0:41:06.28,JP,NTP,0,0,0,,Аа, мен тағы да кездесетінімізге сенімдімін.
Dialogue: 1,0:41:06.45,0:41:08.57,JP,NTP,0,0,0,,Ағай бұған уәде береді.
Dialogue: 1,0:41:13.71,0:41:14.55,JP,NTP,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 1,0:41:15.68,0:41:17.64,JP,NTP,0,0,0,,Ағай бармақшы.
Dialogue: 1,0:41:20.30,0:41:22.66,JP,NTP,0,0,0,,Аман болыңыз Қария аға
Dialogue: 1,0:41:29.75,0:41:33.03,JP,NTP,0,0,0,,Сіз шақыру заклинаниясын жаттаған болуыңыз керек.
Dialogue: 1,0:41:34.56,0:41:35.39,JP,NTP,0,0,0,,Бұл жақсы.
Dialogue: 1,0:41:35.59,0:41:40.04,JP,NTP,0,0,0,,Дегенмен, ортада тағы екі тармақ шығыршықталып тұр.
Dialogue: 1,0:41:40.98,0:41:42.13,JP,NTP,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 1,0:41:42.33,0:41:44.50,JP,NTP,0,0,0,,Не, бұл қарапайым ма?
Dialogue: 1,0:41:44.97,0:41:48.11,JP,NTP,0,0,0,,Қария Сиқыршы дәрежесі қандай?
Dialogue: 1,0:41:48.34,0:41:52.43,JP,NTP,0,0,0,,Басқа шеберлермен салыстырғанда, мен сәл ғана төменмін.
Dialogue: 1,0:41:52.77,0:41:55.66,JP,NTP,0,0,0,,Бұл қызметшінің негізгі қабілеттеріне де әсер етеді.
Dialogue: 1,0:41:55.85,0:41:58.90,JP,NTP,0,0,0,,Олай болса, түзету қызметші класына негізделген.
Dialogue: 1,0:41:59.06,0:42:02.72,JP,NTP,0,0,0,,Параметрлердің өздерін көтеруіміз керек.
Dialogue: 1,0:42:03.92,0:42:04.87,JP,NTP,0,0,0,,Қария
Dialogue: 1,0:42:05.28,0:42:07.30,JP,NTP,0,0,0,,Бұл жолы шақырылатын қызметші
Dialogue: 1,0:42:07.45,0:42:10.60,JP,NTP,0,0,0,,Жындылық қасиетін қосқыңыз келе ме?
Dialogue: 1,0:42:12.94,0:42:15.89,JP,NTP,0,0,0,,Жабу, жабу, жабу, жабу, жабу.
Dialogue: 1,0:42:16.55,0:42:18.22,JP,NTP,0,0,0,,Бес рет қайталаңыз
Dialogue: 1,0:42:18.54,0:42:20.94,JP,NTP,0,0,0,,Тек орындалу уақытын жойыңыз
Dialogue: 1,0:42:22.21,0:42:23.96,JP,NTP,0,0,0,,Негізінде күміс пен темір
Dialogue: 1,0:42:24.70,0:42:26.86,JP,NTP,0,0,0,,Негіз тасы және Келісім Ұлы Герцог
Dialogue: 1,0:42:27.40,0:42:30.12,JP,NTP,0,0,0,,Менің ата-бабам – қожайыным Швайорг.
Dialogue: 1,0:42:30.66,0:42:32.07,JP,NTP,0,0,0,,Құлаған желге қарсы қабырғалар
Dialogue: 1,0:42:32.48,0:42:33.99,JP,NTP,0,0,0,,Төрт қақпа жабық
Dialogue: 1,0:42:34.24,0:42:35.78,JP,NTP,0,0,0,,Тәжден
Dialogue: 1,0:42:36.11,0:42:38.93,JP,NTP,0,0,0,,Патшалыққа апаратын үш жақты жолды айналдыр.
Dialogue: 1,0:42:39.85,0:42:41.93,JP,NTP,0,0,0,,Бұл батырлық рухты шақыру туралы.
Dialogue: 1,0:42:42.20,0:42:44.41,JP,NTP,0,0,0,,Мен мұндай қарапайым рәсімге қарсы емеспін.
Dialogue: 1,0:42:44.83,0:42:47.01,JP,NTP,0,0,0,,Бұл біраз тақырыптан тыс болуы мүмкін.
Dialogue: 1,0:42:48.14,0:42:52.73,JP,NTP,0,0,0,,Қызметшіні шақыру үшін мұндай ауқымды сеанс қажет емес.
Dialogue: 1,0:42:53.06,0:42:56.57,JP,NTP,0,0,0,,Қызметшілерді шын мәнінде шақыратын Қасиетті Граил.
Dialogue: 1,0:42:57.06,0:42:58.53,JP,NTP,0,0,0,,Шебер ретінде
Dialogue: 1,0:42:58.94,0:43:01.74,JP,NTP,0,0,0,,Дүниенің осы жағына көрінетін қаһармандық рухты байланыстыр
Dialogue: 1,0:43:02.25,0:43:05.25,JP,NTP,0,0,0,,Сізге қажет нәрсенің орындалуы үшін жеткілікті сиқырлы қуат беру.
Dialogue: 1,0:43:06.69,0:43:07.44,JP,NTP,0,0,0,,Жарайды.
Dialogue: 1,0:43:08.78,0:43:09.19,JP,NTP,0,0,0,,Айри
Dialogue: 1,0:43:09.99,0:43:11.50,JP,NTP,0,0,0,,Қасиетті жәдігерлерді құрбандық үстеліне қойыңыз.
Dialogue: 1,0:43:12.39,0:43:15.17,JP,NTP,0,0,0,,Содан кейін дайындық аяқталады.
Dialogue: 1,0:43:15.17,0:43:15.93,JP,NTP,0,0,0,,айт
Dialogue: 1,0:43:16.52,0:43:18.41,JP,NTP,0,0,0,,Сенің денең менің астымда.
Dialogue: 1,0:43:18.60,0:43:21.16,JP,NTP,0,0,0,,Менің тағдырым сенің қылышыңда
Dialogue: 1,0:43:21.16,0:43:22.92,JP,NTP,0,0,0,,Қасиетті Граилдың жақындауына сәйкес
Dialogue: 1,0:43:23.01,0:43:27.10,JP,NTP,0,0,0,,Бұл мағына Осы принципті ұстанатын болсаңыз, жауап беріңіз.
Dialogue: 1,0:43:27.57,0:43:28.78,JP,NTP,0,0,0,,Ант
Dialogue: 1,0:43:29.49,0:43:31.90,JP,NTP,0,0,0,,Мен мәңгілікте барлық жақсылыққа айналатын адаммын.
Dialogue: 1,0:43:32.49,0:43:36.05,JP,NTP,0,0,0,,Мәңгілік дүниеде барлық зұлымдықты тудырушы менмін.
Dialogue: 1,0:43:36.47,0:43:40.92,JP,NTP,0,0,0,,Дегенмен, сіз бейберекетсіздікке толы көзбен қатысуыңыз керек.
Dialogue: 1,0:43:41.08,0:43:43.97,JP,NTP,0,0,0,,Сіз жындылық торындағы тұтқынсыз.
Dialogue: 1,0:43:44.20,0:43:47.08,JP,NTP,0,0,0,,Шынжырды ұстайтын менмін
Dialogue: 1,0:43:47.32,0:43:50.33,JP,NTP,0,0,0,,Рухтың үш ұлы сөзін киген жеті аспансың.
Dialogue: 1,0:43:50.54,0:43:52.27,JP,NTP,0,0,0,,Тоқтау шеңберінен келіңіз
Dialogue: 1,0:43:52.46,0:43:54.20,JP,NTP,0,0,0,,Таразыны сақтаушы
Dialogue: 1,0:44:26.21,0:44:27.67,JP,NTP,0,0,0,,Сен жеңдің, Кирей.
Dialogue: 1,0:44:28.39,0:44:29.69,JP,NTP,0,0,0,,Бұл шайқас
Dialogue: 1,0:44:31.09,0:44:33.24,JP,NTP,0,0,0,,Бұл біздің жеңісіміз.
Dialogue: 1,0:44:40.17,0:44:40.97,JP,NTP,0,0,0,,(Норияки) Уф. (Жан) Мм…
Dialogue: 1,0:44:42.70,0:44:43.80,JP,NTP,0,0,0,,Сұраймыз
Dialogue: 1,0:44:50.15,0:44:53.22,JP,NTP,0,0,0,,Сіз менің қожайынымсыз ба?
Dialogue: 1,0:47:29.35,0:47:32.32,JP,NTP,0,0,0,,Менің ойымша, сіз Кирицугу екеуіңнің көздегендерің дұрыс.
Dialogue: 1,0:47:32.45,0:47:34.38,JP,NTP,0,0,0,,Оверлордқа екі адам керек емес.
Dialogue: 1,0:47:34.46,0:47:35.64,JP,NTP,0,0,0,,Әке, мен уәде беремін.
Dialogue: 1,0:47:35.82,0:47:37.99,JP,NTP,0,0,0,,Сен маған қарауға қабілетсізсің.
Dialogue: 1,0:47:38.04,0:47:39.87,JP,NTP,0,0,0,,Сіз өте кереметсіз.
Dialogue: 1,0:47:39.92,0:47:42.13,JP,NTP,0,0,0,,Токиоми Тохсака дереу
Dialogue: 1,0:47:42.40,0:47:43.66,JP,NTP,0,0,0,,Жою
Dialogue: 0,0:47:45.16,0:47:51.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
