Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.98,0:00:23.00,Default,,0,0,0,,Бұл субтитрді Divine Subtitle Group (kamigami.org) шығарған және сатып алуға тыйым салынған.
Dialogue: 0,0:00:00.98,0:00:23.00,Default,,0,0,0,,:zwx : syura үлпілдек : :
Dialogue: 0,0:00:36.58,0:00:37.01,Default,,0,0,0,,Себептік байланыс
Dialogue: 0,0:00:38.54,0:00:39.61,Default,,0,0,0,,Себеп-салдар
Dialogue: 0,0:00:41.05,0:00:42.83,Default,,0,0,0,,Себеп - заттардың басы
Dialogue: 0,0:00:43.47,0:00:44.24,Default,,0,0,0,,Жеміс бітті
Dialogue: 0,0:00:45.87,0:00:49.88,Default,,0,0,0,,Бірігіп әңгіме құрастырылады.
Dialogue: 0,0:00:55.76,0:00:58.60,Default,,0,0,0,,Әйел аңшы және еркек ақ ит
Dialogue: 0,0:00:59.12,0:01:02.70,Default,,0,0,0,,Бір адам мен бір жануардың бұл кездесуі осы оқу кітабының басы.
Dialogue: 0,0:01:03.44,0:01:05.52,Default,,0,0,0,,Яғни, себеп
Dialogue: 0,0:01:24.98,0:01:28.93,Default,,0,0,0,,Жас аңшы таулардың көбін білетін.
Dialogue: 0,0:01:29.77,0:01:32.19,Default,,0,0,0,,Топырақтың қаттылығы және жел тоқтаған кезде
Dialogue: 0,0:01:32.58,0:01:33.88,Default,,0,0,0,,Аңның жолы
Dialogue: 0,0:01:34.28,0:01:37.01,Default,,0,0,0,,Осының бәрін мен атамнан үйрендім.
Dialogue: 0,0:01:43.86,0:01:47.77,Default,,0,0,0,,Аңшы мен оның олжасының арасында көрінбейтін жіп бар дейді.
Dialogue: 0,0:01:48.43,0:01:50.63,Default,,0,0,0,,Жіптің тартылған сәті
Dialogue: 0,0:01:50.99,0:01:55.12,Default,,0,0,0,,Бір-бірінің жүрегімен байланысқысы келетін күлкілі байланыс туады.
Dialogue: 0,0:02:08.46,0:02:09.57,Default,,0,0,0,,Қосылған
Dialogue: 0,0:02:16.35,0:02:22.99,Default,,0,0,0,,Қыздың аты Хамаджи Ояма болатын. Ол бұл тау туралы бәрін білетін.
Dialogue: 0,0:02:23.87,0:02:27.04,Default,,0,0,0,,Бірақ менің білетінім таулар еді.
Dialogue: 0,0:02:35.42,0:02:38.48,Default,,0,0,0,,Бүгінгі атаның сүйікті асы - итке арналған қазан.
Dialogue: 0,0:02:38.77,0:02:39.28,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:02:40.02,0:02:42.77,Default,,0,0,0,,Бұл маған азырақ мисо қосылған дәмдеуіш.
Dialogue: 0,0:02:43.08,0:02:44.81,Default,,0,0,0,,Бұл жеткіліксіз болуы мүмкін.
Dialogue: 0,0:02:48.01,0:02:48.88,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:02:57.15,0:03:01.53,Default,,0,0,0,,Хамаджи атасы аюға жем болып, осы күзде қайтыс болды.
Dialogue: 0,0:03:04.72,0:03:06.34,Default,,0,0,0,,Мен онша көп жей алмаймын
Dialogue: 0,0:03:23.03,0:03:24.33,Default,,0,0,0,,Не болды, Хамаджи?
Dialogue: 0,0:03:24.96,0:03:26.26,Default,,0,0,0,,Бас діни қызметкер
Dialogue: 0,0:03:28.08,0:03:28.93,Default,,0,0,0,,Рабу
Dialogue: 0,0:03:32.57,0:03:33.88,Default,,0,0,0,,Эдодан хат.
Dialogue: 0,0:03:36.43,0:03:39.85,Default,,0,0,0,,Хамадзи, Досецу-нии-чан саған қамқор болады.
Dialogue: 0,0:03:40.16,0:03:40.86,Default,,0,0,0,,Эдоға келіңіз
Dialogue: 0,0:03:41.49,0:03:45.39,Default,,0,0,0,,Сенің болашақ бақытың да боқ қарттың жоқтауы болады.
Dialogue: 0,0:03:46.23,0:03:47.51,Default,,0,0,0,,Мені ағам күтіп тұр.
Dialogue: 0,0:03:48.69,0:03:53.12,Default,,0,0,0,,Қосымша Бас діни қызметкер: Мен сүйкімді сіңіліме бірнеше тиын беремін.
Dialogue: 0,0:03:53.54,0:03:55.58,Default,,0,0,0,,Жол жағасы ретінде қамқорлық жасаңыз.
Dialogue: 0,0:03:55.89,0:03:57.39,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,0:04:01.10,0:04:01.54,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:04:04.39,0:04:07.06,Default,,0,0,0,,Не істесең де, жүрегің жалғыз
Dialogue: 0,0:04:11.09,0:04:14.41,Default,,0,0,0,,Барыңыз, ағам тұрған Эдоға барыңыз.
Dialogue: 0,0:05:41.78,0:05:44.84,Default,,0,0,0,,Эй, маған данго, данго сатып ал.
Dialogue: 0,0:05:53.95,0:05:57.28,Default,,0,0,0,,Эдодағы құлыптар өсіп келе жатқан тамырлар сияқты үлкен болды.
Dialogue: 0,0:05:58.29,0:05:59.70,Default,,0,0,0,,Тауға ұқсайды
Dialogue: 0,0:06:01.80,0:06:05.77,Default,,0,0,0,,Сонымен Токугава әлемі қауіпсіз.
Dialogue: 0,0:06:09.29,0:06:11.04,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:11.69,0:06:13.94,Default,,0,0,0,,Мен бүгін ғана Эдоға келдім.
Dialogue: 0,0:06:13.94,0:06:16.55,Default,,0,0,0,,Балық Сізге балық керек пе?
Dialogue: 0,0:06:16.73,0:06:18.69,Default,,0,0,0,,Лосось балығы
Dialogue: 0,0:06:19.10,0:06:21.28,Default,,0,0,0,,Бүгін таңертең ауланған жаңа балық.
Dialogue: 0,0:06:22.54,0:06:26.34,Default,,0,0,0,,Мм, мен Досецу Ояма есімді ағам туралы білмеймін.
Dialogue: 0,0:06:28.89,0:06:31.45,Default,,0,0,0,,Vidro Бұл Vidro.
Dialogue: 0,0:06:31.78,0:06:33.65,Default,,0,0,0,,Тенду-самаға дейін ұстап, қарасаң
Dialogue: 0,0:06:33.96,0:06:36.42,Default,,0,0,0,,Жеті түсті әлемге тез айналады
Dialogue: 0,0:06:36.83,0:06:39.16,Default,,0,0,0,,Vidro Бұл Vidro.
Dialogue: 0,0:06:39.50,0:06:41.88,Default,,0,0,0,,Бұл хаттың орналасқан жеріне қалай жетуге болады?
Dialogue: 0,0:06:41.44,0:06:43.17,Default,,0,0,0,,Не болды Не болды
Dialogue: 0,0:06:46.83,0:06:49.35,Default,,0,0,0,,Асагидің Цукудани Укке жеуі
Dialogue: 0,0:06:50.78,0:06:53.86,Default,,0,0,0,,Жабу немесе ашу? Эдоның болашағы осыған байланысты.
Dialogue: 0,0:06:53.86,0:06:55.49,Default,,0,0,0,,Мүмкін Фукагава труппасынан шыққан Фушихиме.
Dialogue: 0,0:06:55.74,0:06:58.77,Default,,0,0,0,,Кеудемдегі жылуды көрдім.
Dialogue: 0,0:07:08.36,0:07:10.22,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:11.22,0:07:12.56,Default,,0,0,0,,Ол сонда болды
Dialogue: 0,0:07:17.40,0:07:19.11,Default,,0,0,0,,Бұл кімнің олжасы?
Dialogue: 0,0:07:22.07,0:07:23.68,Default,,0,0,0,,Неліктен бұл жерде мойын ғана?
Dialogue: 0,0:07:24.12,0:07:25.49,Default,,0,0,0,,Ашық бас
Dialogue: 0,0:07:25.85,0:07:28.24,Default,,0,0,0,,Қорыққандықтан кішкентайсың ба?
Dialogue: 0,0:07:28.33,0:07:30.09,Default,,0,0,0,,Жоқ, мен аңшымын.
Dialogue: 0,0:07:30.40,0:07:31.47,Default,,0,0,0,,Мен мұндай нәрселерді көруге үйренгенмін.
Dialogue: 0,0:07:31.85,0:07:34.03,Default,,0,0,0,,Өйткені ол әлі күшік емес пе?
Dialogue: 0,0:07:34.23,0:07:36.47,Default,,0,0,0,,Сіз мұны естідіңіз бе? Ей, ауыл баласы.
Dialogue: 0,0:07:36.53,0:07:38.41,Default,,0,0,0,,Мен итті аяймын.
Dialogue: 0,0:07:39.45,0:07:40.25,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:44.31,0:07:45.18,Default,,0,0,0,,Күлме
Dialogue: 0,0:07:46.70,0:07:48.77,Default,,0,0,0,,Мен сізге айтамын.
Dialogue: 0,0:07:50.08,0:07:52.91,Default,,0,0,0,,Бұл жігіттер адам мен иттің төлдері.
Dialogue: 0,0:07:53.38,0:07:57.30,Default,,0,0,0,,Олардың сегізі де Эдоға биыл күздің басында келді.
Dialogue: 0,0:07:58.78,0:08:01.83,Default,,0,0,0,,Бұл жігіттер әр түнде адамдарды өлтіруі мүмкін.
Dialogue: 0,0:08:02.02,0:08:04.04,Default,,0,0,0,,Бұл арам пиғылды адамдар.
Dialogue: 0,0:08:05.71,0:08:09.36,Default,,0,0,0,,Бай, кедей, окабики және самурай
Dialogue: 0,0:08:09.58,0:08:11.65,Default,,0,0,0,,Әйелдер мен балалар да ерекшелік емес.
Dialogue: 0,0:08:12.17,0:08:15.76,Default,,0,0,0,,Ол жылдам, биікке ұшып, қаша алады.
Dialogue: 0,0:08:15.89,0:08:18.02,Default,,0,0,0,,Тіпті менің денем де, ойым да аңға ұқсайды.
Dialogue: 0,0:08:18.05,0:08:20.87,Default,,0,0,0,,Фуши деп аталды Қорқынышты болды
Dialogue: 0,0:08:21.10,0:08:23.76,Default,,0,0,0,,Олар адамға ұқсайды.
Dialogue: 0,0:08:23.96,0:08:26.32,Default,,0,0,0,,Мырзаны ұстау да қиын.
Dialogue: 0,0:08:26.64,0:08:32.60,Default,,0,0,0,,-да уайымға ұшыраған Шогун Токугава Иесада жауды аулауға бұйрық береді.
Dialogue: 0,0:08:32.71,0:08:35.66,Default,,0,0,0,,Бұл да үлкен сый болды.
Dialogue: 0,0:08:35.71,0:08:39.46,Default,,0,0,0,,Тіпті тістеген самурай да тот басқан қылышын қайтарып алуға мәжбүр болды.
Dialogue: 0,0:08:39.62,0:08:41.48,Default,,0,0,0,,Қаланы аралай бастады
Dialogue: 0,0:08:41.96,0:08:45.95,Default,,0,0,0,,Және бірінен соң бірі Фьюсті аңдыды.
Dialogue: 0,0:08:46.75,0:08:50.84,Default,,0,0,0,,Дәл бүгін мен Йосивараға жасырын түрде өтпек болған Фьюсті таптым.
Dialogue: 0,0:08:50.98,0:08:54.80,Default,,0,0,0,,Мына Умака-сама менің басымды алды. Бұл несие мәселесі.
Dialogue: 0,0:08:54.92,0:08:56.59,Default,,0,0,0,,Тағы екі қалды
Dialogue: 0,0:08:56.69,0:08:59.49,Default,,0,0,0,,Қараңызшы, бұл ауыл.
Dialogue: 0,0:08:59.87,0:09:04.43,Default,,0,0,0,,Әлгі кесілген бастың балғын болғаны сонша, буы бұрқырап тұр.
Dialogue: 0,0:09:09.12,0:09:11.05,Default,,0,0,0,,Өйткені, бұл кішкентай.
Dialogue: 0,0:09:42.26,0:09:45.74,Default,,0,0,0,,Күн батқанша ағаларымды табуым керек.
Dialogue: 0,0:09:47.40,0:09:49.09,Default,,0,0,0,,Әзірге жұмыс аяқталды.
Dialogue: 0,0:09:49.55,0:09:51.09,Default,,0,0,0,,Ваннаға түсу.
Dialogue: 0,0:09:55.43,0:09:57.80,Default,,0,0,0,,Өте жақсы істеп жатқан сияқтысыз, аға.
Dialogue: 0,0:09:58.71,0:10:00.44,Default,,0,0,0,,Сыйақы шамамен жарты сағатты құрайды.
Dialogue: 0,0:10:00.80,0:10:02.24,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:30.27,0:10:32.33,Default,,0,0,0,,Күтемін.
Dialogue: 0,0:10:33.23,0:10:35.28,Default,,0,0,0,,Сіз не істеп жатырсыз? Ауырды, солай емес пе?
Dialogue: 0,0:10:35.51,0:10:36.62,Default,,0,0,0,,Мен арғы бетке қашып кеттім.
Dialogue: 0,0:10:36.62,0:10:37.91,Default,,0,0,0,,Айнал, бұрыл
Dialogue: 0,0:10:50.01,0:10:53.53,Default,,0,0,0,,Мен жалықтым, менімен көбірек ойнаңызшы.
Dialogue: 0,0:10:53.64,0:10:55.99,Default,,0,0,0,,Ағаңа жарайсың.
Dialogue: 0,0:10:56.20,0:10:59.14,Default,,0,0,0,,Сол менгудің басын кесіңіз.
Dialogue: 0,0:11:09.78,0:11:11.48,Default,,0,0,0,,кешірім
Dialogue: 0,0:11:11.98,0:11:15.16,Default,,0,0,0,,Мен бүгін біртүрлі шөлдеп тұрмын.
Dialogue: 0,0:11:22.64,0:11:24.83,Default,,0,0,0,,Бұл шие гүлі маусымнан тыс.
Dialogue: 0,0:11:25.58,0:11:26.91,Default,,0,0,0,,Маған керек
Dialogue: 0,0:11:31.54,0:11:32.56,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:39.12,0:11:40.70,Default,,0,0,0,,Екеуміз осында тұрайық.
Dialogue: 0,0:11:41.28,0:11:43.13,Default,,0,0,0,,Мен бүгін мейірімді емеспін.
Dialogue: 0,0:11:44.93,0:11:45.87,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:11:50.10,0:11:51.06,Default,,0,0,0,,Ол қашып кетті.
Dialogue: 0,0:11:52.64,0:11:54.25,Default,,0,0,0,,Балалар сендер екіге бөліндіңдер.
Dialogue: 0,0:11:54.42,0:11:55.58,Default,,0,0,0,,Рёгоку көпірінде қамалған
Dialogue: 0,0:11:55.78,0:11:56.43,Default,,0,0,0,,Иә
Dialogue: 0,0:12:11.95,0:12:12.77,Default,,0,0,0,,Ол сонда болды
Dialogue: 0,0:12:13.58,0:12:17.45,Default,,0,0,0,,Маған бұл жағы қатты әсер етті.
Dialogue: 0,0:12:17.85,0:12:19.82,Default,,0,0,0,,Міне осылай, ұстаңыз!
Dialogue: 0,0:12:22.96,0:12:24.22,Default,,0,0,0,,Кешіріңіз, бірақ мен оны біраз уақытқа қарызға аламын.
Dialogue: 0,0:12:25.83,0:12:26.93,Default,,0,0,0,,Жолдан кет, балақай.
Dialogue: 0,0:12:27.17,0:12:27.74,Default,,0,0,0,,…бізге теңдей берілген.
Dialogue: 0,0:12:28.11,0:12:30.15,Default,,0,0,0,,Шапшаң болуға дайын болыңыз.
Dialogue: 0,0:12:31.47,0:12:33.42,Default,,0,0,0,,Маған да жүзіңді көрсет.
Dialogue: 0,0:12:33.74,0:12:35.77,Default,,0,0,0,,Табанды адам жек көреді.
Dialogue: 0,0:12:37.22,0:12:39.29,Default,,0,0,0,,Әй, егер мен оны қайтара алсам.
Dialogue: 0,0:12:43.85,0:12:44.94,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:12:45.27,0:12:46.47,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:12:52.50,0:12:53.59,Default,,0,0,0,,Енді құтылу мүмкін емес
Dialogue: 0,0:12:53.73,0:12:55.47,Default,,0,0,0,,Мен сені жұлып аламын
Dialogue: 0,0:12:55.92,0:12:56.72,Default,,0,0,0,,Оны маған қарызға бер
Dialogue: 0,0:13:09.33,0:13:10.18,Default,,0,0,0,,Мақсат
Dialogue: 0,0:13:13.26,0:13:14.49,Default,,0,0,0,,Қазірдің өзінде бас тартыңыз
Dialogue: 0,0:13:15.02,0:13:18.60,Default,,0,0,0,,Әйтпесе, екінші көз де жойылады.
Dialogue: 0,0:13:20.76,0:13:22.49,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:13:22.70,0:13:25.94,Default,,0,0,0,,Банчаны бір жұтып алып, ұзақ сөйлесейік.
Dialogue: 0,0:13:26.08,0:13:26.49,Default,,0,0,0,,Рух толқындарын қолдануды да ұмытып кеткенмін
Dialogue: 0,0:13:41.97,0:13:45.62,Default,,0,0,0,,Мен саған бүгін мейірімді емеспін дедім.
Dialogue: 0,0:13:48.54,0:13:50.10,Default,,0,0,0,,Саған қара!
Dialogue: 0,0:13:50.76,0:13:55.32,Default,,0,0,0,,Қалған өміріңді қараңғыда, тіпті ай көрінбейтін жерде өткізу.
Dialogue: 0,0:13:58.97,0:13:59.87,Default,,0,0,0,,Анықтама
Dialogue: 0,0:14:00.33,0:14:01.46,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:14:04.07,0:14:05.57,Default,,0,0,0,,Тамая
Dialogue: 0,0:14:08.16,0:14:08.59,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:14:10.57,0:14:11.70,Default,,0,0,0,,Бұл фейерверк түтігі ме?
Dialogue: 0,0:14:12.24,0:14:14.89,Default,,0,0,0,,Жоқ, бұл мылтық.
Dialogue: 0,0:14:15.14,0:14:18.65,Default,,0,0,0,,Мылтық Мен оны түсінбедім, өйткені оның пішіні біртүрлі болды.
Dialogue: 0,0:14:20.00,0:14:22.39,Default,,0,0,0,,Жарайды, жоқ, рахмет, балам.
Dialogue: 0,0:14:22.90,0:14:24.36,Default,,0,0,0,,Жоқ, бұл әйел.
Dialogue: 0,0:14:26.94,0:14:28.53,Default,,0,0,0,,Мен әйелмін.
Dialogue: 0,0:14:30.55,0:14:34.21,Default,,0,0,0,,Көшеде Көшеде екі жақ қызыл
Dialogue: 0,0:14:34.63,0:14:36.63,Default,,0,0,0,,Жоқ, бұл үсік шалу.
Dialogue: 0,0:14:37.69,0:14:39.37,Default,,0,0,0,,Мен оларды жек көремін.
Dialogue: 0,0:14:39.68,0:14:41.89,Default,,0,0,0,,Бұл сенікі. Ол сенікі. Ойлан.
Dialogue: 0,0:14:42.55,0:14:43.63,Default,,0,0,0,,Сол жігіттер
Dialogue: 0,0:14:43.86,0:14:45.80,Default,,0,0,0,,Менің ойымша, бұл сен және мен.
Dialogue: 0,0:14:45.87,0:14:48.62,Default,,0,0,0,,Әзірше қашудан басқа амалымыз жоқ.
Dialogue: 0,0:14:50.40,0:14:52.17,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:14:54.53,0:14:55.04,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:14:57.62,0:15:00.03,Default,,0,0,0,,Сен өзенге құладың. Сіз әлі тірісіз бе?
Dialogue: 0,0:15:01.23,0:15:02.57,Default,,0,0,0,,Есін жоғалту
Dialogue: 0,0:15:10.62,0:15:12.14,Default,,0,0,0,,Қызық, әкем қайтып келе жатыр ма?
Dialogue: 0,0:15:12.19,0:15:12.89,Default,,0,0,0,,Мен солай ойлаймын
Dialogue: 0,0:15:35.23,0:15:38.71,Default,,0,0,0,,Сен бүгін ғана Эдоға бауырыңды іздеп келдің бе?
Dialogue: 0,0:15:39.25,0:15:44.50,Default,,0,0,0,,Иә, бірақ мен Эдо бұлай үлкен және шулы болады деп күтпедім.
Dialogue: 0,0:15:44.97,0:15:45.59,Default,,0,0,0,,Маған қарызға бер
Dialogue: 0,0:15:46.04,0:15:48.74,Default,,0,0,0,,Маған ұнамайды. Мен бәрібір саған дөрекі қараймын.
Dialogue: 0,0:15:49.22,0:15:50.63,Default,,0,0,0,,Бұл мылтық емес.
Dialogue: 0,0:15:50.96,0:15:51.93,Default,,0,0,0,,Хат хат
Dialogue: 0,0:15:55.15,0:15:58.56,Default,,0,0,0,,Не? Неге тұрған жеріңді жазбайсың?
Dialogue: 0,0:15:59.00,0:16:00.60,Default,,0,0,0,,Мен оқи алмаймын.
Dialogue: 0,0:16:01.22,0:16:04.24,Default,,0,0,0,,Мұнда Косакурабаши Кавара Нагая деп жазылған.
Dialogue: 0,0:16:04.89,0:16:06.20,Default,,0,0,0,,Қуан, мылтық қыз
Dialogue: 0,0:16:06.73,0:16:07.55,Default,,0,0,0,,Ол жақын жерде.
Dialogue: 0,0:16:12.09,0:16:14.84,Default,,0,0,0,,Ақ шашың жылтыр.
Dialogue: 0,0:16:16.48,0:16:19.04,Default,,0,0,0,,Ағаңның жүрген жерін білген бойда ол бірден саған жағымпаздана бастады.
Dialogue: 0,0:16:19.86,0:16:20.59,Default,,0,0,0,,Менің тістерім қалқып тұр
Dialogue: 0,0:16:21.41,0:16:24.99,Default,,0,0,0,,Жоқ, тек сол пальто.
Dialogue: 0,0:16:27.31,0:16:29.57,Default,,0,0,0,,Сіз мен үшін қорқынышты емессіз бе?
Dialogue: 0,0:16:31.43,0:16:32.12,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:16:34.60,0:16:36.43,Default,,0,0,0,,Сіз көңілді жігітсіз.
Dialogue: 0,0:16:43.38,0:16:45.05,Default,,0,0,0,,Қараңызшы, бұл Акко.
Dialogue: 0,0:16:51.02,0:16:53.58,Default,,0,0,0,,Кептіру Құрманы кептіру
Dialogue: 0,0:16:55.51,0:16:56.34,Default,,0,0,0,,(JoJo) Дүрбелең шығарма!
Dialogue: 0,0:16:58.10,0:16:58.83,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:17:00.36,0:17:01.86,Default,,0,0,0,,Досецу-нии-чан
Dialogue: 0,0:17:05.85,0:17:06.57,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:17:08.57,0:17:09.43,Default,,0,0,0,,Хамаджи?
Dialogue: 0,0:17:09.68,0:17:12.16,Default,,0,0,0,,Дұрыс, мен таудан келдім.
Dialogue: 0,0:17:13.35,0:17:17.34,Default,,0,0,0,,Түсіндім, сіз Хамаджиге келдіңіз бе?
Dialogue: 0,0:17:18.06,0:17:19.44,Default,,0,0,0,,О, ағайын
Dialogue: 0,0:17:20.84,0:17:22.00,Default,,0,0,0,,Яғни, қарапайым есептеу бойынша да ол тек екі минуттан кейін ғана пайда болуы тиіс еді.
Dialogue: 0,0:17:22.00,0:17:22.80,Default,,0,0,0,,Салқын.
Dialogue: 0,0:17:23.24,0:17:24.98,Default,,0,0,0,,...
Dialogue: 0,0:17:27.08,0:17:29.70,Default,,0,0,0,,Хамадзи Бұл шынымен Хамаджи.
Dialogue: 0,0:17:31.02,0:17:32.05,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:17:32.47,0:17:34.53,Default,,0,0,0,,Рахмет. Жақсы жұмыс.
Dialogue: 0,0:17:34.65,0:17:36.14,Default,,0,0,0,,Ау! Ауырды!
Dialogue: 0,0:17:36.49,0:17:38.71,Default,,0,0,0,,Мен шынымен бақытты болдым.
Dialogue: 0,0:17:42.45,0:17:45.17,Default,,0,0,0,,Егер сіз менің хатымды қайтарсаңыз, мен сізді алып кетуге келер едім.
Dialogue: 0,0:17:45.67,0:17:47.30,Default,,0,0,0,,Бүгін Эдоға келдіңіз бе?
Dialogue: 0,0:17:47.54,0:17:48.71,Default,,0,0,0,,Мен адасып қалдым деп ойлаймын.
Dialogue: 0,0:17:49.14,0:17:52.33,Default,,0,0,0,,Жарайды, ол маған жол көрсетті.
Dialogue: 0,0:17:52.89,0:17:54.62,Default,,0,0,0,,Бұл қайда кетті?
Dialogue: 0,0:18:10.47,0:18:11.99,Default,,0,0,0,,Еш ойланбаңыз
Dialogue: 0,0:18:18.84,0:18:21.26,Default,,0,0,0,,Эдода да тар жерлер бар.
Dialogue: 0,0:18:21.66,0:18:25.85,Default,,0,0,0,,Аздап лас, бірақ жоғарыдағы сақтау бөлмесін қалауыңызша пайдалана аласыз.
Dialogue: 0,0:18:28.79,0:18:30.64,Default,,0,0,0,,Ол таудағы үйден кішірек.
Dialogue: 0,0:18:30.94,0:18:31.97,Default,,0,0,0,,Кішкене шыдамдылық
Dialogue: 0,0:18:32.69,0:18:35.02,Default,,0,0,0,,Күндердің бірінде мен саған сарай саламын.
Dialogue: 0,0:19:06.01,0:19:08.10,Default,,0,0,0,,Бауырым, маған бұл жер ұнайды.
Dialogue: 0,0:19:08.86,0:19:09.92,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:19:10.59,0:19:12.12,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:19:15.10,0:19:15.75,Default,,0,0,0,,Мылтық
Dialogue: 0,0:19:16.23,0:19:16.58,Default,,0,0,0,,Харизма!
Dialogue: 0,0:19:17.20,0:19:19.51,Default,,0,0,0,,Мен шарлар, оқпа, жөндеу құралдарын әкелдім.
Dialogue: 0,0:19:19.79,0:19:20.47,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:19:20.59,0:19:24.84,Default,,0,0,0,,Және зоми бұршақтары, аюдың өті және менің ағамның сүйікті кептірілген күріш торты.
Dialogue: 0,0:19:24.87,0:19:26.64,Default,,0,0,0,,Ал қабан терісінен жасалған қарын жолағы.
Dialogue: 0,0:19:27.17,0:19:28.64,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:30.70,0:19:31.42,Default,,0,0,0,,Осымен
Dialogue: 0,0:19:32.41,0:19:35.81,Default,,0,0,0,,Сенің қыз болсаң да шебер аңшы болып өскеніңді естідім.
Dialogue: 0,0:19:36.23,0:19:38.59,Default,,0,0,0,,Иә, атам мені мақтады.
Dialogue: 0,0:19:38.93,0:19:39.97,Default,,0,0,0,,Бұл мағынасы бар
Dialogue: 0,0:19:41.54,0:19:44.02,Default,,0,0,0,,Ештеңе әкелме.
Dialogue: 0,0:19:44.14,0:19:46.17,Default,,0,0,0,,Мен ағамды уайымдадым.
Dialogue: 0,0:19:46.65,0:19:49.15,Default,,0,0,0,,Сен, әңгімені бұзба.
Dialogue: 0,0:19:50.13,0:19:52.03,Default,,0,0,0,,Қолдарыңызды біріктіріңіз.
Dialogue: 0,0:19:59.02,0:20:00.43,Default,,0,0,0,,Өкінішке орай, қария.
Dialogue: 0,0:20:00.71,0:20:02.45,Default,,0,0,0,,Мен міндетті түрде самурай боламын
Dialogue: 0,0:20:02.96,0:20:05.26,Default,,0,0,0,,Мен мұны істеудің жолын таптым.
Dialogue: 0,0:20:05.71,0:20:06.32,Default,,0,0,0,,Жол дегеніміз не?
Dialogue: 0,0:20:06.96,0:20:10.45,Default,,0,0,0,,Эй, мен сені бірінші кезекте Эдоға шақырдым.
Dialogue: 0,0:20:10.55,0:20:11.90,Default,,0,0,0,,Сол жолмен жүріңіз
Dialogue: 0,0:20:10.74,0:20:12.55,Default,,0,0,0,,Е, Мичисетсу-сан, сен әйелді әкелесің.
Dialogue: 0,0:20:12.88,0:20:13.75,Default,,0,0,0,,Бұл жаман болар еді.
Dialogue: 0,0:20:13.79,0:20:15.48,Default,,0,0,0,,Фунамуши ашуланғанда қорқынышты.
Dialogue: 0,0:20:15.59,0:20:17.50,Default,,0,0,0,,А, әйел шығар.
Dialogue: 0,0:20:17.89,0:20:19.36,Default,,0,0,0,,Бірақ бәрібір осылай
Dialogue: 0,0:20:19.68,0:20:20.72,Default,,0,0,0,,Иә, бұл бала болуы керек.
Dialogue: 0,0:20:20.93,0:20:22.40,Default,,0,0,0,,Ол менен үлкенірек болды.
Dialogue: 0,0:20:22.82,0:20:23.84,Default,,0,0,0,,(JoJo) Дүрбелең шығарма!
Dialogue: 0,0:20:24.93,0:20:28.31,Default,,0,0,0,,Егер мұны істегіңіз келсе, абайлап жасырыңыз.
Dialogue: 0,0:20:28.97,0:20:30.91,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын.
Dialogue: 0,0:20:31.27,0:20:33.10,Default,,0,0,0,,Аға, оның аты Йоширо.
Dialogue: 0,0:20:33.55,0:20:34.24,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:20:34.50,0:20:35.29,Default,,0,0,0,,I үшін
Dialogue: 0,0:20:35.80,0:20:38.45,Default,,0,0,0,,Мен заттарымды жууға ертерек бардым.
Dialogue: 0,0:20:38.76,0:20:40.68,Default,,0,0,0,,Айтпақшы, бұл менің ұлым.
Dialogue: 0,0:20:41.05,0:20:43.88,Default,,0,0,0,,Сәлеметсіз бе, менің атым Хамаджи.
Dialogue: 0,0:20:44.42,0:20:45.17,Default,,0,0,0,,Әрқашан ағайын
Dialogue: 0,0:20:44.87,0:20:45.68,Default,,0,0,0,,Менің әпкем
Dialogue: 0,0:20:47.36,0:20:48.49,Default,,0,0,0,,Олар бір-біріне ұқсамайды.
Dialogue: 0,0:20:48.52,0:20:49.39,Default,,0,0,0,,Ұқсас емес
Dialogue: 0,0:20:49.42,0:20:50.00,Default,,0,0,0,,Хотокке
Dialogue: 0,0:20:50.45,0:20:53.38,Default,,0,0,0,,Менің атым Банзусуке.
Dialogue: 0,0:20:53.89,0:20:56.08,Default,,0,0,0,,Біз бәріміз осы қираған көп қабатты үйде тұрамыз.
Dialogue: 0,0:20:56.49,0:20:59.25,Default,,0,0,0,,Арғы жағында қайықшы, Занцо ата.
Dialogue: 0,0:20:59.77,0:21:01.15,Default,,0,0,0,,Үйге кететін уақыт келді
Dialogue: 0,0:21:01.68,0:21:02.83,Default,,0,0,0,,Бұл шалғай жер
Dialogue: 0,0:21:02.87,0:21:05.63,Default,,0,0,0,,Жақын жерде үлкен өзен, сонымен қатар Рёгоку көпірі бар.
Dialogue: 0,0:21:05.80,0:21:06.82,Default,,0,0,0,,Отшашу
Dialogue: 0,0:21:06.97,0:21:09.14,Default,,0,0,0,,Иә, жазда отшашу фестивалі болады.
Dialogue: 0,0:21:09.34,0:21:13.08,Default,,0,0,0,,Менің ойымша, бізбен осылай өмір сүру өте қызық болар еді.
Dialogue: 0,0:21:14.23,0:21:16.06,Default,,0,0,0,,Бұл біз туралы не? Бұл қорқынышты.
Dialogue: 0,0:21:17.88,0:21:18.88,Default,,0,0,0,,Міне, осында
Dialogue: 0,0:21:22.32,0:21:23.98,Default,,0,0,0,,Ах, иықтары қатайған.
Dialogue: 0,0:21:24.41,0:21:26.50,Default,,0,0,0,,үшін, кешкі ас.
Dialogue: 0,0:21:26.67,0:21:29.31,Default,,0,0,0,,Занцоның қарт адамы қайықпен жүзіп жүр.
Dialogue: 0,0:21:29.31,0:21:30.73,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:21:30.95,0:21:34.61,Default,,0,0,0,,Тамақтану Тамақтану Тамақтану
Dialogue: 0,0:21:35.57,0:21:37.17,Default,,0,0,0,,Оны Фунамуши деп атайды.
Dialogue: 0,0:21:37.93,0:21:39.93,Default,,0,0,0,,Күндіз қайықта тамақ саттым.
Dialogue: 0,0:21:40.39,0:21:42.06,Default,,0,0,0,,Ол оны жабу үшін осында тоқтап тұр.
Dialogue: 0,0:21:42.81,0:21:43.75,Default,,0,0,0,,Сіз аш болуыңыз керек.
Dialogue: 0,0:21:45.48,0:21:47.74,Default,,0,0,0,,Мисо денгаку және атсуяки
Dialogue: 0,0:21:47.91,0:21:50.35,Default,,0,0,0,,Сондай-ақ, мен қуырылған дайкон шалғамының дәмін көрдім.
Dialogue: 0,0:21:50.70,0:21:51.36,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:51.53,0:21:52.85,Default,,0,0,0,,Тота күткендей
Dialogue: 0,0:21:53.08,0:21:55.68,Default,,0,0,0,,Бұл жаңа өнім – үлпілдек жұмыртқа орауыштары
Dialogue: 0,0:21:55.83,0:21:56.65,Default,,0,0,0,,Солай етіңіз
Dialogue: 0,0:21:56.97,0:21:58.19,Default,,0,0,0,,Мен оны өзіңізбен бірге алып кетемін.
Dialogue: 0,0:21:58.28,0:21:59.14,Default,,0,0,0,,Сол жерде күтіңіз.
Dialogue: 0,0:21:59.42,0:22:00.17,Default,,0,0,0,,Иә
Dialogue: 0,0:22:00.27,0:22:02.20,Default,,0,0,0,,Бұл балон және жерленген тофу
Dialogue: 0,0:22:02.31,0:22:03.56,Default,,0,0,0,,Менің ойымша, бұл да алкогольмен бірге келеді.
Dialogue: 0,0:22:03.58,0:22:06.04,Default,,0,0,0,,Күтілгендей, сіз түсінесіз.
Dialogue: 0,0:22:09.86,0:22:12.89,Default,,0,0,0,,Мен денгаку мен қуырылған тауық етемін, сонымен қатар саке аламын.
Dialogue: 0,0:22:13.42,0:22:15.65,Default,,0,0,0,,Сіз жаңадан келген адамсыз. Сен қай жақтансын?
Dialogue: 0,0:22:15.95,0:22:18.02,Default,,0,0,0,,Менің әпкем Хамаджи.
Dialogue: 0,0:22:18.26,0:22:20.93,Default,,0,0,0,,Менің қарындасым бар еді
Dialogue: 0,0:22:21.19,0:22:22.50,Default,,0,0,0,,Сен мұны айтпадың ба?
Dialogue: 0,0:22:22.80,0:22:24.02,Default,,0,0,0,,Сіз қай жақтансыз?
Dialogue: 0,0:22:24.31,0:22:26.14,Default,,0,0,0,,Тау, Муцу елі
Dialogue: 0,0:22:26.65,0:22:28.03,Default,,0,0,0,,Ацуякиді де қосыңыз.
Dialogue: 0,0:22:28.48,0:22:29.40,Default,,0,0,0,,Қашан келдің?
Dialogue: 0,0:22:29.78,0:22:31.54,Default,,0,0,0,,Мен бүгін таңертең келдім.
Dialogue: 0,0:22:31.78,0:22:33.04,Default,,0,0,0,,Кейінірек сөйлесіңіз
Dialogue: 0,0:22:33.10,0:22:35.17,Default,,0,0,0,,Мына жігітке дұрыс көзқарас беріңізші.
Dialogue: 0,0:22:37.47,0:22:38.40,Default,,0,0,0,,Ақша
Dialogue: 0,0:22:38.48,0:22:40.05,Default,,0,0,0,,Сонымен бірге
Dialogue: 0,0:22:40.88,0:22:41.30,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:22:42.09,0:22:44.16,Default,,0,0,0,,Ал, бөлу арқылы.
Dialogue: 0,0:22:54.46,0:22:58.07,Default,,0,0,0,,Мен бес жыл бұрын таудан түскенмін.
Dialogue: 0,0:22:58.65,0:23:01.37,Default,,0,0,0,,Ұзақ уақыттан кейін ағайынның кездесуі.
Dialogue: 0,0:23:01.45,0:23:06.07,Default,,0,0,0,,Бұл бес жыл бұрын анам қайтыс болып, Чибисуке дүниеге келген кезде болды.
Dialogue: 0,0:23:06.55,0:23:08.20,Default,,0,0,0,,Олар бір-бірінен айтарлықтай ерекшеленеді.
Dialogue: 0,0:23:08.61,0:23:10.38,Default,,0,0,0,,Ағам аздап арықтады ма деп ойлаймын.
Dialogue: 0,0:23:10.59,0:23:11.84,Default,,0,0,0,,Бірақ мен көп ұзамай білдім
Dialogue: 0,0:23:12.18,0:23:14.32,Default,,0,0,0,,Досецу - прогресс жоқ дейді.
Dialogue: 0,0:23:14.48,0:23:17.52,Default,,0,0,0,,Ақымақ жасын көрсете бастады.
Dialogue: 0,0:23:19.30,0:23:21.57,Default,,0,0,0,,Ертеңнен бастап не істеуді жоспарлайсыз?
Dialogue: 0,0:23:22.68,0:23:26.82,Default,,0,0,0,,Жұмыс Жұмыс істемейтіндер тамақ ішпеуі керек.
Dialogue: 0,0:23:27.21,0:23:29.87,Default,,0,0,0,,Эдода тұру үшін сізге қандай ақша қажет?
Dialogue: 0,0:23:30.72,0:23:31.83,Default,,0,0,0,,Ақша?
Dialogue: 0,0:23:31.93,0:23:36.76,Default,,0,0,0,,Қарт пальма ағашында өмір сүріп, бамбук инеліктері мен қағаз шарлар сияқты заттарды сатқан.
Dialogue: 0,0:23:37.34,0:23:39.23,Default,,0,0,0,,Хамадзи-чан, менімен жұмыс жасағың келе ме?
Dialogue: 0,0:23:39.62,0:23:41.06,Default,,0,0,0,,Жұмыс
Dialogue: 0,0:23:41.06,0:23:46.12,Default,,0,0,0,,Эй, ол ертеңнен бастап менімен бірге Эдода тұрып, аң аулайтын болады.
Dialogue: 0,0:23:47.61,0:23:49.33,Default,,0,0,0,,Өз дағдыларыңызға сенімді емессіз бе?
Dialogue: 0,0:23:49.55,0:23:51.75,Default,,0,0,0,,Амал жоқ, мен аң аулауға сенімдімін.
Dialogue: 0,0:23:51.84,0:23:53.42,Default,,0,0,0,,Эй, біз Эдода аң аулап жатырмыз.
Dialogue: 0,0:23:53.85,0:23:54.92,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:23:55.51,0:23:59.89,Default,,0,0,0,,Ал, қарашы, мен үлкен нәрсені түсіремін.
Dialogue: 0,0:23:59.94,0:24:02.76,Default,,0,0,0,,Фунамуши: Экономиканы көтеру үшін тағы бір.
Dialogue: 0,0:24:10.15,0:24:12.43,Default,,0,0,0,,Бауырым, футонды жамылғың.
Dialogue: 0,0:24:12.85,0:24:14.61,Default,,0,0,0,,Бұл ескі әйел ме?
Dialogue: 0,0:24:18.82,0:24:21.49,Default,,0,0,0,,Бас діни қызметкер сізге бір нәрсені сеніп тапсырып жатыр ма?
Dialogue: 0,0:24:21.57,0:24:23.39,Default,,0,0,0,,Бірнеше алтын, т.б.
Dialogue: 0,0:24:24.37,0:24:25.03,Default,,0,0,0,,және үшінші (Three) фильмде алғашқы болып өлген адамның немересі, және т.б.—
Dialogue: 0,0:24:26.12,0:24:27.45,Default,,0,0,0,,Әлгі қарғыс атқыр бала
Dialogue: 0,0:24:29.23,0:24:30.99,Default,,0,0,0,,Әй, олжа
Dialogue: 0,0:24:31.89,0:24:34.28,Default,,0,0,0,,Біз нені аулап жатырмыз?
Dialogue: 0,0:24:35.94,0:24:36.61,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:25:06.11,0:25:07.30,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:25:07.82,0:25:09.50,Default,,0,0,0,,Кеме құртына сәлем айт
Dialogue: 0,0:25:09.93,0:25:11.62,Default,,0,0,0,,Жұмысыңызға сәттілік
Dialogue: 0,0:25:18.63,0:25:20.43,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:25:21.10,0:25:22.64,Default,,0,0,0,,Ауа райы жақсы болды.
Dialogue: 0,0:25:23.15,0:25:24.51,Default,,0,0,0,,Ерте
Dialogue: 0,0:25:24.34,0:25:25.38,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:25:29.01,0:25:32.06,Default,,0,0,0,,Бауырым, тез оянуың керек пе?
Dialogue: 0,0:25:34.91,0:25:35.91,Default,,0,0,0,,Асқабақ
Dialogue: 0,0:25:37.16,0:25:38.33,Default,,0,0,0,,Менің ойымша, ол аңға шығады.
Dialogue: 0,0:25:40.04,0:25:41.85,Default,,0,0,0,,Хамаджи, сенде мылтық бар.
Dialogue: 0,0:25:45.58,0:25:48.07,Default,,0,0,0,,Бұл әзіл
Dialogue: 0,0:25:49.35,0:25:50.12,Default,,0,0,0,,Тейе
Dialogue: 0,0:25:52.39,0:25:54.59,Default,,0,0,0,,Бүгіннен бастап бұл біздің жұмысымыз.
Dialogue: 0,0:25:56.04,0:25:59.38,Default,,0,0,0,,Жақсы достар, бір деммен алға ұмтылайық.
Dialogue: 0,0:26:00.35,0:26:02.40,Default,,0,0,0,,Мен оқи алмаймын.
Dialogue: 0,0:26:11.23,0:26:15.58,Default,,0,0,0,,Жатқан адам – адамның тірі жанын жейтін ит құбыжық.
Dialogue: 0,0:26:15.73,0:26:16.73,Default,,0,0,0,,Тірі жан дегеніміз не?
Dialogue: 0,0:26:17.13,0:26:18.54,Default,,0,0,0,,Жан дегеніміз не?
Dialogue: 0,0:26:20.00,0:26:22.76,Default,,0,0,0,,Негізі кеше, ағаммен кездескенше.
Dialogue: 0,0:26:23.34,0:26:26.16,Default,,0,0,0,,Мен құладым да, оның ашық тұрған басын көрдім.
Dialogue: 0,0:26:27.82,0:26:29.22,Default,,0,0,0,,Олай болса оқиға жылдам.
Dialogue: 0,0:26:29.85,0:26:31.22,Default,,0,0,0,,Фушиді жеңгеннен кейін
Dialogue: 0,0:26:31.72,0:26:35.46,Default,,0,0,0,,Сіз Аккода тұратын лордтан үлкен сыйлық ала аласыз.
Dialogue: 0,0:26:36.24,0:26:39.13,Default,,0,0,0,,Жағдайға байланысты сіз офицер ретінде жұмысқа орналаса аласыз.
Dialogue: 0,0:26:47.30,0:26:49.60,Default,,0,0,0,,Әй, аға, офицер деген не?
Dialogue: 0,0:26:51.20,0:26:53.37,Default,,0,0,0,,Жарайды, ол көп ақша табатын самурай.
Dialogue: 0,0:26:55.08,0:26:58.08,Default,,0,0,0,,Бүгін мен саған Эдоның айналасын көрсетіп, айналаны көрсетемін.
Dialogue: 0,0:26:58.59,0:27:02.23,Default,,0,0,0,,Дұрыс, Каминаримон арқылы өтіп, Шинобазуды айналып өтіңіз.
Dialogue: 0,0:27:02.72,0:27:05.04,Default,,0,0,0,,Менің ойымша, Йосивара күліп, секірген сияқты.
Dialogue: 0,0:27:05.59,0:27:06.55,Default,,0,0,0,,Йошивара
Dialogue: 0,0:27:06.79,0:27:10.00,Default,,0,0,0,,Дұрыс, Ақкода әйелдерге рұқсат жоқ.
Dialogue: 0,0:27:10.41,0:27:12.87,Default,,0,0,0,,Сол себепті олар сені осылай жасырды.
Dialogue: 0,0:27:14.49,0:27:17.08,Default,,0,0,0,,үшін үшін рахмет
Dialogue: 0,0:27:21.35,0:27:22.67,Default,,0,0,0,,Қандай әзіл
Dialogue: 0,0:27:23.17,0:27:26.74,Default,,0,0,0,,Бұл менің сүйкімді сіңілім үшін емес.
Dialogue: 0,0:27:28.49,0:27:29.42,Default,,0,0,0,,Сәлем бауырым
Dialogue: 0,0:27:31.10,0:27:33.67,Default,,0,0,0,,Жатып, адамға ұқсайды.
Dialogue: 0,0:27:33.87,0:27:34.54,Default,,0,0,0,,Сәлем
Dialogue: 0,0:27:34.76,0:27:36.07,Default,,0,0,0,,Қалай айтуға болады?
Dialogue: 0,0:27:36.28,0:27:37.86,Default,,0,0,0,,Біріншіден, ит тістері бар.
Dialogue: 0,0:27:38.69,0:27:41.31,Default,,0,0,0,,Менің ойымша, бұл да аңның иісі сияқты.
Dialogue: 0,0:27:42.86,0:27:46.52,Default,,0,0,0,,Сондай-ақ, менің денемнің бір жерінде пионға ұқсайтын туу белгісі бар.
Dialogue: 0,0:27:46.76,0:27:47.44,Default,,0,0,0,,Пион
Dialogue: 0,0:27:47.50,0:27:50.61,Default,,0,0,0,,Иә, сегіз шоғыры бар пион гүлі.
Dialogue: 0,0:27:51.31,0:27:52.85,Default,,0,0,0,,Әлсіз Әлсіздік
Dialogue: 0,0:27:54.39,0:27:55.13,Default,,0,0,0,,Эмилияның фракциясы мен Куруштың фракциясы арасындағы тең шарттардағы одақ.
Dialogue: 0,0:27:56.33,0:28:00.27,Default,,0,0,0,,Басыңды кесіп алғанша жорғаласаң да келе беретін көрінеді.
Dialogue: 0,0:28:04.89,0:28:05.88,Default,,0,0,0,,Ит азу тістері
Dialogue: 0,0:28:06.26,0:28:07.39,Default,,0,0,0,,Аңдардың иісі
Dialogue: 0,0:28:07.80,0:28:08.90,Default,,0,0,0,,Пионның туу белгісі
Dialogue: 0,0:28:15.45,0:28:16.32,Default,,0,0,0,,Ит азу тістері
Dialogue: 0,0:28:16.68,0:28:18.00,Default,,0,0,0,,Аңдардың иісі
Dialogue: 0,0:28:18.31,0:28:19.65,Default,,0,0,0,,Пионның туу белгісі
Dialogue: 0,0:28:23.46,0:28:24.28,Default,,0,0,0,,Ит азу тістері
Dialogue: 0,0:28:24.74,0:28:25.62,Default,,0,0,0,,Аңдардың иісі
Dialogue: 0,0:28:26.11,0:28:26.97,Default,,0,0,0,,Пионның туу белгісі
Dialogue: 0,0:28:40.04,0:28:42.81,Default,,0,0,0,,Мұның бәрі Хамаджи мен Тауы үшін.
Dialogue: 0,0:28:43.54,0:28:45.97,Default,,0,0,0,,Нағыз аң аулайтын жерлерге барайық.
Dialogue: 0,0:28:51.77,0:28:54.46,Default,,0,0,0,,Абайлаңыз, аяғыңыз тайып кетпейді.
Dialogue: 0,0:29:10.43,0:29:12.19,Default,,0,0,0,,Тез кел, адаспа.
Dialogue: 0,0:29:13.16,0:29:15.98,Default,,0,0,0,,Мына қақпаның үлкен аузын қара!
Dialogue: 0,0:29:16.13,0:29:18.32,Default,,0,0,0,,Аузыңыз ашық.
Dialogue: 0,0:29:18.94,0:29:21.02,Default,,0,0,0,,Кеттік, бұл Йосивара.
Dialogue: 0,0:29:36.01,0:29:39.51,Default,,0,0,0,,Мен таң қалдым, әр жерде ұшқын.
Dialogue: 0,0:29:39.92,0:29:41.32,Default,,0,0,0,,Эдо әйелдерінің түсі
Dialogue: 0,0:29:41.69,0:29:43.26,Default,,0,0,0,,Аң аулауға келгеніңді ұмытпа
Dialogue: 0,0:29:43.61,0:29:45.30,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:29:46.91,0:29:49.39,Default,,0,0,0,,Мұнда төрт мың әйел тұрады.
Dialogue: 0,0:29:50.10,0:29:54.16,Default,,0,0,0,,Шәкірттер мен тұтынушыларды қабылдасаңыз, күніне жеті мың адам ештеңе емес.
Dialogue: 0,0:29:54.47,0:29:56.52,Default,,0,0,0,,Араластың ішінде төмен түссе таң қалмас едім.
Dialogue: 0,0:29:57.06,0:29:58.00,Default,,0,0,0,,Сәлем бауырым
Dialogue: 0,0:29:58.86,0:30:01.50,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:30:02.85,0:30:07.43,Default,,0,0,0,,Әйел адам терісімен ердің жүрегін жылытатын жер
Dialogue: 0,0:30:08.31,0:30:10.47,Default,,0,0,0,,Дұрыс айта алмаймын.
Dialogue: 0,0:30:10.86,0:30:13.04,Default,,0,0,0,,Адамның жәннаты, былайша айтқанда.
Dialogue: 0,0:30:13.46,0:30:18.07,Default,,0,0,0,,Аспан? Бұл, әрине, аздап қорқынышты.
Dialogue: 0,0:30:20.17,0:30:21.71,Default,,0,0,0,,Не, не, қорқынышты?
Dialogue: 0,0:30:23.01,0:30:25.07,Default,,0,0,0,,Жарайсың, аға.
Dialogue: 0,0:30:25.35,0:30:26.49,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:30:26.56,0:30:29.72,Default,,0,0,0,,Бұл не, хаг? Сен бүгін ойынға келмедің.
Dialogue: 0,0:30:30.94,0:30:34.18,Default,,0,0,0,,Бүгін менің үйімде ең әдемі әйел бар.
Dialogue: 0,0:30:34.78,0:30:36.23,Default,,0,0,0,,Екі күміс монета жеткілікті.
Dialogue: 0,0:30:36.48,0:30:37.29,Default,,0,0,0,,Бичибичи
Dialogue: 0,0:30:37.58,0:30:39.29,Default,,0,0,0,,Иә, жылтыр.
Dialogue: 0,0:30:39.86,0:30:43.41,Default,,0,0,0,,Ей, қарт қаңбақ, мына қағазға қарашы. Мен оны сол жерде қалдыра алмаймын.
Dialogue: 0,0:30:43.41,0:30:44.66,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:30:49.21,0:30:49.67,Default,,0,0,0,,Бұл
Dialogue: 0,0:30:51.07,0:30:51.87,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:30:54.77,0:30:56.16,Default,,0,0,0,,Жоғалған балалар жаман.
Dialogue: 0,0:30:56.35,0:30:59.35,Default,,0,0,0,,Күйеуім, уайымдама.
Dialogue: 0,0:30:59.61,0:31:00.87,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:31:00.90,0:31:02.42,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:31:03.22,0:31:05.17,Default,,0,0,0,,Менің ойымша, бұл сіз көліктермен бірінші рет ойнап отырсыз.
Dialogue: 0,0:31:05.47,0:31:07.04,Default,,0,0,0,,Мен онымен айналысамын.
Dialogue: 0,0:31:07.23,0:31:08.65,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:31:09.20,0:31:10.62,Default,,0,0,0,,Мені жіберіңізші
Dialogue: 0,0:31:12.68,0:31:13.47,Default,,0,0,0,,Не болды, эй?
Dialogue: 0,0:31:15.83,0:31:16.63,Default,,0,0,0,,Әй, ұрыс па?
Dialogue: 0,0:31:16.63,0:31:17.86,Default,,0,0,0,,Шығару, көрушілер
Dialogue: 0,0:31:30.40,0:31:31.61,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:31:31.89,0:31:35.06,Default,,0,0,0,,Бір түнде қалуға бола ма? Демалу дұрыс па?
Dialogue: 0,0:31:37.16,0:31:38.71,Default,,0,0,0,,Бұрынғы қарт қарт
Dialogue: 0,0:31:41.89,0:31:44.62,Default,,0,0,0,,Қылыш Қылыш Мен ұмытып қалдым.
Dialogue: 0,0:31:48.17,0:31:48.96,Default,,0,0,0,,Сәлем
Dialogue: 0,0:31:51.87,0:31:54.40,Default,,0,0,0,,Аңға келгеніңді ұмытпа.
Dialogue: 0,0:31:55.03,0:31:58.59,Default,,0,0,0,,Әй, сүйкімді жігіт, сен Акимен ойнайсың ба?
Dialogue: 0,0:31:58.79,0:32:00.82,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:32:00.92,0:32:03.20,Default,,0,0,0,,Қандай да бір себептермен денем қызып кетті.
Dialogue: 0,0:32:03.39,0:32:06.01,Default,,0,0,0,,Міне, оны түртіңіз.
Dialogue: 0,0:32:06.15,0:32:08.28,Default,,0,0,0,,Мен біреуді іздеп жүрмін.
Dialogue: 0,0:32:07.98,0:32:10.42,Default,,0,0,0,,Ей, мұңды рахаттанайық.
Dialogue: 0,0:32:10.42,0:32:12.18,Default,,0,0,0,,Жоқ, жоқ, осылай.
Dialogue: 0,0:32:12.22,0:32:13.52,Default,,0,0,0,,Жарайсыңдар, балалар.
Dialogue: 0,0:32:15.33,0:32:17.05,Default,,0,0,0,,Йо Теппо мұражайы
Dialogue: 0,0:32:17.88,0:32:19.27,Default,,0,0,0,,Мен көптен бері іздеп жүрмін.
Dialogue: 0,0:32:19.59,0:32:22.67,Default,,0,0,0,,Қыз, сен қандай киінгенсің?
Dialogue: 0,0:32:22.76,0:32:23.90,Default,,0,0,0,,Шатастыру
Dialogue: 0,0:32:23.98,0:32:25.65,Default,,0,0,0,,Иә, бұл әйел.
Dialogue: 0,0:32:26.09,0:32:28.22,Default,,0,0,0,,Бұл өкінішті болды, Отаки.
Dialogue: 0,0:32:28.55,0:32:30.19,Default,,0,0,0,,Бұл Шино-ханның серігі.
Dialogue: 0,0:32:30.29,0:32:31.51,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:32:31.89,0:32:33.73,Default,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:32:33.88,0:32:35.09,Default,,0,0,0,,Читта читта
Dialogue: 0,0:32:35.37,0:32:38.01,Default,,0,0,0,,Ақшаны анда-санда тастау керек.
Dialogue: 0,0:32:45.25,0:32:47.57,Default,,0,0,0,,Бір нәрсе үшін рахмет
Dialogue: 0,0:32:48.40,0:32:50.26,Default,,0,0,0,,Сіз сол киімді кигеніңіз үшін қателесесіз.
Dialogue: 0,0:32:51.12,0:32:52.96,Default,,0,0,0,,Бұл менің ағамның киімі.
Dialogue: 0,0:32:54.57,0:32:56.83,Default,,0,0,0,,Мен солай ойладым. Мінеки.
Dialogue: 0,0:32:59.59,0:33:00.69,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:33:01.07,0:33:02.97,Default,,0,0,0,,Жаман етіп көрсетпе, жарайды.
Dialogue: 0,0:33:32.51,0:33:34.21,Default,,0,0,0,,Мен сені қалдырамын, жас шебер.
Dialogue: 0,0:33:54.68,0:33:57.84,Default,,0,0,0,,Бұл жерде біз сататынымыз әйелдер әдетте қолданатын нәрсе.
Dialogue: 0,0:33:58.83,0:34:02.48,Default,,0,0,0,,Алдыңғы жағы жарқыраған болса да, артқы жағы жұмсақ әрі сәнді.
Dialogue: 0,0:34:03.41,0:34:05.47,Default,,0,0,0,,Әйелдер керісінше.
Dialogue: 0,0:34:07.37,0:34:10.49,Default,,0,0,0,,Мен сізге рахмет ретінде сатып аламын.
Dialogue: 0,0:34:11.63,0:34:12.64,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз
Dialogue: 0,0:34:13.02,0:34:16.84,Default,,0,0,0,,Менде кенеттен осындай таңдау болды.
Dialogue: 0,0:34:17.58,0:34:20.22,Default,,0,0,0,,О, Шиноның күйеуі, қош келдіңіз.
Dialogue: 0,0:34:20.80,0:34:22.52,Default,,0,0,0,,Бүгін не істейсің?
Dialogue: 0,0:34:22.73,0:34:26.47,Default,,0,0,0,,Бұл жігітке типтік Цумуги кимоносын көрсетіңіз.
Dialogue: 0,0:34:26.68,0:34:28.83,Default,,0,0,0,,Әй, сүйкімді қыз
Dialogue: 0,0:34:29.95,0:34:32.57,Default,,0,0,0,,Жарайды, Шино-хан, екіншісін сол жақтан шайқама.
Dialogue: 0,0:34:33.35,0:34:35.63,Default,,0,0,0,,Жоғарыдан келген тұтынушыларды пайдаланбаңыз.
Dialogue: 0,0:34:37.58,0:34:39.84,Default,,0,0,0,,А, чау, чау, әлгі екеуі қасында.
Dialogue: 0,0:34:40.35,0:34:41.10,Default,,0,0,0,,Таку
Dialogue: 0,0:34:42.74,0:34:43.73,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:34:44.59,0:34:46.40,Default,,0,0,0,,Керемет оқиға болды.
Dialogue: 0,0:34:47.49,0:34:50.70,Default,,0,0,0,,Иә, иә, тоқта.
Dialogue: 0,0:34:51.95,0:34:53.57,Default,,0,0,0,,Мен қазір түсемін, күте тұрыңыз.
Dialogue: 0,0:34:59.87,0:35:04.61,Default,,0,0,0,,Бұл маған сәйкес келмейді
Dialogue: 0,0:35:05.34,0:35:07.26,Default,,0,0,0,,Маған сәйкес келмейді
Dialogue: 0,0:35:07.74,0:35:10.09,Default,,0,0,0,,Мұны сіз оны киіп көргеннен кейін ғана айта аласыз.
Dialogue: 0,0:35:10.33,0:35:11.21,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:35:11.48,0:35:13.50,Default,,0,0,0,,Өзіңізге ыңғайлы етіп өзгертіңіз.
Dialogue: 0,0:35:13.87,0:35:14.79,Default,,0,0,0,,Жағымды сөздерді айтпа
Dialogue: 0,0:35:14.98,0:35:15.91,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:35:16.06,0:35:17.31,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:35:22.73,0:35:24.58,Default,,0,0,0,,Жас келіншек, күйеуінің сүйіктісі
Dialogue: 0,0:35:24.92,0:35:27.09,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:35:27.68,0:35:29.61,Default,,0,0,0,,Менімен тіл табысу қиын, бірақ мен қиянат жасаймын.
Dialogue: 0,0:35:29.81,0:35:32.23,Default,,0,0,0,,Шиноның күйеуі шынымен мейірімді адам.
Dialogue: 0,0:35:32.60,0:35:35.75,Default,,0,0,0,,Сіз басқа адамға байланысты көзқарасыңызды өзгертпейтін тамаша адамсыз.
Dialogue: 0,0:35:43.60,0:35:47.43,Default,,0,0,0,,Бұл сізге жарасады, ақырында жүрегіңіз сізді қуып жетеді.
Dialogue: 0,0:35:48.11,0:35:50.25,Default,,0,0,0,,Маған ұнамайды. Менің бетім үлкен.
Dialogue: 0,0:35:51.10,0:35:52.94,Default,,0,0,0,,Кимоно Надешико бір бөлікке жоғары
Dialogue: 0,0:35:54.65,0:35:58.35,Default,,0,0,0,,Не? Сіз әйел едіңіз, солай емес пе?
Dialogue: 0,0:35:59.32,0:36:00.35,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:36:06.11,0:36:10.99,Default,,0,0,0,,Эй, тігінші, маған сәйкес гета мен шаш қыстырғышын бер.
Dialogue: 0,0:36:12.10,0:36:14.02,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:36:15.43,0:36:17.95,Default,,0,0,0,,Бұл самурай керемет еді.
Dialogue: 0,0:36:18.84,0:36:21.36,Default,,0,0,0,,Хамаджи шық, сен кінәлісің.
Dialogue: 0,0:36:46.30,0:36:49.04,Default,,0,0,0,,Сіз өте таныс сияқтысыз.
Dialogue: 0,0:36:52.96,0:36:53.67,Default,,0,0,0,,Жақсы
Dialogue: 0,0:36:55.41,0:36:56.01,Default,,0,0,0,,Әйел?
Dialogue: 0,0:36:58.22,0:37:00.20,Default,,0,0,0,,Ендеше, әйел – әйел.
Dialogue: 0,0:37:02.29,0:37:06.28,Default,,0,0,0,,Негізі мен оған бүгін бірдеңе айтуым керек еді.
Dialogue: 0,0:37:07.45,0:37:10.25,Default,,0,0,0,,Ешқандай емес, есек домалап, қашып кетем.
Dialogue: 0,0:37:14.85,0:37:15.80,Default,,0,0,0,,Иісі бар, солай ма?
Dialogue: 0,0:37:16.26,0:37:19.50,Default,,0,0,0,,Бұл Йосивараның мамандығы, Отогарогомизо.
Dialogue: 0,0:37:20.21,0:37:23.09,Default,,0,0,0,,Жанұясы бар әйелдердің тістеріне бояйтын қара түсті.
Dialogue: 0,0:37:24.29,0:37:28.02,Default,,0,0,0,,Аяғынан айырылған әйелдер мен алып кетер ешкімі жоқ сәбилері бар.
Dialogue: 0,0:37:28.29,0:37:30.76,Default,,0,0,0,,Адамдарды осы Мизокава өзеніне тастап жатыр.
Dialogue: 0,0:37:31.42,0:37:32.76,Default,,0,0,0,,Йошивараның сахна артында
Dialogue: 0,0:37:34.92,0:37:36.97,Default,,0,0,0,,Бұл да әйелдің асты.
Dialogue: 0,0:37:43.26,0:37:46.70,Default,,0,0,0,,Сіз үшін маңызды адам бар ма?
Dialogue: 0,0:37:47.91,0:37:50.17,Default,,0,0,0,,Неліктен бұлай сұрайсыз?
Dialogue: 0,0:37:54.03,0:37:58.04,Default,,0,0,0,,Мен ол жігітті қызғанамын.
Dialogue: 0,0:38:13.09,0:38:14.31,Default,,0,0,0,,Иә, әдемі адам
Dialogue: 0,0:38:14.91,0:38:16.31,Default,,0,0,0,,Жалғыз қақпа осында
Dialogue: 0,0:38:16.43,0:38:17.99,Default,,0,0,0,,Күте тұрғың келмесе де, кездесуге болады.
Dialogue: 0,0:38:18.30,0:38:20.72,Default,,0,0,0,,Джана Теппо Мусуме Хамаджи
Dialogue: 0,0:38:21.92,0:38:24.06,Default,,0,0,0,,Менің атымды неге қойдыңыз?
Dialogue: 0,0:38:24.39,0:38:27.10,Default,,0,0,0,,Мен ағамның хатын оқыдым.
Dialogue: 0,0:38:27.23,0:38:31.25,Default,,0,0,0,,Айла, атыңды дұрыс сұрамадым.
Dialogue: 0,0:38:32.93,0:38:34.23,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:38:36.77,0:38:38.36,Default,,0,0,0,,Мен Шиномын
Dialogue: 0,0:38:39.36,0:38:42.97,Default,,0,0,0,,Рахмет сізге Шино Кимоно
Dialogue: 0,0:38:43.13,0:38:45.52,Default,,0,0,0,,Маған рахмет айтамын, әзірге сізге қарыздармын.
Dialogue: 0,0:38:46.03,0:38:48.19,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,0:38:49.59,0:38:52.28,Default,,0,0,0,,Айко сен біртүрлі жігітсің.
Dialogue: 0,0:38:59.64,0:39:04.01,Default,,0,0,0,,Хамаджи Мен сені іздедім, сүйкімді серігім.
Dialogue: 0,0:39:05.64,0:39:06.10,Default,,0,0,0,,Эй
Dialogue: 0,0:39:06.31,0:39:07.59,Default,,0,0,0,,Табылды
Dialogue: 0,0:39:08.22,0:39:09.96,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:39:10.32,0:39:13.46,Default,,0,0,0,,Мұнда да дүкен жабық. Түнде шиенің гүлдегенін көріп, үйге барамын.
Dialogue: 0,0:39:18.43,0:39:19.55,Default,,0,0,0,,Бұл алты қоңырау.
Dialogue: 0,0:39:20.11,0:39:24.39,Default,,0,0,0,,Хана Йошивара Қазір нағыз мәміле, дүкен қызу жұмыс істей бастады.
Dialogue: 0,0:39:26.66,0:39:27.86,Default,,0,0,0,,Хосоми Йосивара
Dialogue: 0,0:39:28.03,0:39:28.92,Default,,0,0,0,,Маған беріңізші
Dialogue: 0,0:39:32.28,0:39:34.02,Default,,0,0,0,,Сюжеттік саяхат басталады
Dialogue: 0,0:39:34.09,0:39:36.40,Default,,0,0,0,,Бүгін мұздатылған тырна Даю.
Dialogue: 0,0:39:36.47,0:39:38.98,Default,,0,0,0,,Мұздатылған кран? Мен оны сирек көремін
Dialogue: 0,0:39:39.54,0:39:40.51,Default,,0,0,0,,Кеттік
Dialogue: 0,0:39:42.86,0:39:46.44,Default,,0,0,0,,Бұл аймақтың төбесі таңғаларлық әдемі.
Dialogue: 0,0:39:48.19,0:39:49.48,Default,,0,0,0,,Мен оны көргім келеді.
Dialogue: 0,0:39:50.78,0:39:51.13,Default,,0,0,0,,Иә
Dialogue: 0,0:40:09.58,0:40:10.70,Default,,0,0,0,,Келді, келді, келді.
Dialogue: 0,0:40:13.74,0:40:15.68,Default,,0,0,0,,Көктегі қыз түскен сияқты
Dialogue: 0,0:40:15.91,0:40:18.57,Default,,0,0,0,,Қараңызшы, теріңіз сондай ақ
Dialogue: 0,0:40:19.33,0:40:20.84,Default,,0,0,0,,Менің қолымнан бар болғаны күрсіну ғана
Dialogue: 0,0:40:21.43,0:40:23.10,Default,,0,0,0,,Ол соншалықты еріген
Dialogue: 0,0:40:23.46,0:40:25.68,Default,,0,0,0,,Өйткені, сыпайылар ғажап.
Dialogue: 0,0:40:27.97,0:40:30.54,Default,,0,0,0,,Әй, Хамаджи, тез кел! Бұл керемет көрініс.
Dialogue: 0,0:40:30.59,0:40:32.97,Default,,0,0,0,,Жоқ, мен оны мүлдем көрмеймін.
Dialogue: 0,0:40:33.54,0:40:34.76,Default,,0,0,0,,Эй, мені ұста.
Dialogue: 0,0:40:44.57,0:40:45.91,Default,,0,0,0,,Бұл ауырады
Dialogue: 0,0:41:06.98,0:41:07.58,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:41:07.85,0:41:09.67,Default,,0,0,0,,Нашар мен оны мүлде жіберіп алдым.
Dialogue: 0,0:41:09.95,0:41:11.12,Default,,0,0,0,,Әлгі жігіт құлап қалды.
Dialogue: 0,0:41:11.59,0:41:12.59,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:41:13.05,0:41:14.71,Default,,0,0,0,,Бұзаудағы сегіз шоқ
Dialogue: 0,0:41:15.89,0:41:16.49,Default,,0,0,0,,Пион
Dialogue: 0,0:41:16.57,0:41:16.99,Default,,0,0,0,,Туған белгі
Dialogue: 0,0:41:17.39,0:41:17.67,Default,,0,0,0,,Аң
Dialogue: 0,0:41:17.95,0:41:18.47,Default,,0,0,0,,Армандарым кеңейіп келеді
Dialogue: 0,0:41:20.81,0:41:23.09,Default,,0,0,0,,Мұздатылған тырна Даю болады деп күтпедім.
Dialogue: 0,0:41:28.56,0:41:29.45,Default,,0,0,0,,Төмен
Dialogue: 0,0:41:29.61,0:41:32.42,Default,,0,0,0,,Жиренішті, менің де жанымды шығарып алды.
Dialogue: 0,0:41:32.85,0:41:35.43,Default,,0,0,0,,Бұл әзіл емес. Мен саған тез қашып кет деп жатырмын.
Dialogue: 0,0:41:36.60,0:41:38.00,Default,,0,0,0,,Әпкеме дөрекілік
Dialogue: 0,0:41:38.13,0:41:39.51,Default,,0,0,0,,Ауылға түсіңіз
Dialogue: 0,0:41:40.47,0:41:42.55,Default,,0,0,0,,Досай
Dialogue: 0,0:41:45.78,0:41:48.08,Default,,0,0,0,,Бұл аң аулау, әуесқойлар онымен араласпауы керек.
Dialogue: 0,0:41:56.26,0:41:58.64,Default,,0,0,0,,Біртүрлі тұтынушы
Dialogue: 0,0:42:07.68,0:42:08.47,Default,,0,0,0,,Төмен
Dialogue: 0,0:42:09.03,0:42:10.29,Default,,0,0,0,,Менің бетім төмен түсті.
Dialogue: 0,0:42:13.93,0:42:15.22,Default,,0,0,0,,Сіз менімен бірінші рет кездестіңіз бе?
Dialogue: 0,0:42:15.46,0:42:16.51,Default,,0,0,0,,Барайық Хамаджи
Dialogue: 0,0:42:21.25,0:42:23.56,Default,,0,0,0,,Әпкем күткендей, мен оны дәл көрдім.
Dialogue: 0,0:42:23.88,0:42:25.00,Default,,0,0,0,,Бұл жігіт жылдам.
Dialogue: 0,0:42:25.81,0:42:27.14,Default,,0,0,0,,Шенеуніктерге берілетін сыйақылар
Dialogue: 0,0:42:34.27,0:42:36.60,Default,,0,0,0,,Қандай жол соңы немесе саңылау?
Dialogue: 0,0:42:36.94,0:42:38.37,Default,,0,0,0,,Буруто үлкен шие ағашының жанында
Dialogue: 0,0:42:38.55,0:42:39.14,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:42:41.77,0:42:42.67,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:42:42.85,0:42:43.90,Default,,0,0,0,,Менің ағам да
Dialogue: 0,0:42:56.92,0:43:01.77,Default,,0,0,0,,Әй, неге мені көруге келмедің?
Dialogue: 0,0:43:03.93,0:43:07.05,Default,,0,0,0,,Уәде етілген күн он күн де ​​өтті.
Dialogue: 0,0:43:08.90,0:43:11.05,Default,,0,0,0,,Эй Шинбэй
Dialogue: 0,0:43:15.85,0:43:19.22,Default,,0,0,0,,Шынымды айтыңызшы, мен сізді сонда қонақ ретінде қарсы алғым келді.
Dialogue: 0,0:43:21.55,0:43:23.14,Default,,0,0,0,,Кек сақтама, Дайфу
Dialogue: 0,0:43:26.91,0:43:29.06,Default,,0,0,0,,Асықпаңыз.
Dialogue: 0,0:43:34.29,0:43:35.65,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,0:43:36.19,0:43:39.17,Default,,0,0,0,,Соңғы кездері кеудем қатты ауырып жүр.
Dialogue: 0,0:43:43.84,0:43:45.96,Default,,0,0,0,,Мен тұтынушыны тастап, әрі қарай жүремін деп ойламаймын.
Dialogue: 0,0:43:46.69,0:43:47.80,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:43:51.11,0:43:52.63,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:43:57.15,0:44:00.35,Default,,0,0,0,,Мұздатылған тырна патшайым шығар.
Dialogue: 0,0:44:00.74,0:44:03.47,Default,,0,0,0,,Бір жылға жетпей көкке көтерілді.
Dialogue: 0,0:45:00.48,0:45:01.27,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:45:10.95,0:45:13.12,Default,,0,0,0,,Бауырым, саған зиян тигізбейді деп үміттенемін.
Dialogue: 0,0:45:21.71,0:45:23.15,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:45:23.54,0:45:26.72,Default,,0,0,0,,Жоқ, рахмет.
Dialogue: 0,0:45:32.03,0:45:33.38,Default,,0,0,0,,Мен асығыспын.
Dialogue: 0,0:45:40.75,0:45:44.79,Default,,0,0,0,,Өтінемін, менің баратын жерім ашық.
Dialogue: 0,0:45:47.22,0:45:50.38,Default,,0,0,0,,Мм, тамақ ішіп біткеніңіз маңызды емес.
Dialogue: 0,0:45:50.56,0:45:52.69,Default,,0,0,0,,Сіз оны шығарып жібере аласыз ба?
Dialogue: 0,0:46:19.58,0:46:20.17,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:46:20.85,0:46:23.20,Default,,0,0,0,,Тауда болған кезімнен еш айырмашылығы жоқ.
Dialogue: 0,0:46:26.37,0:46:27.27,Default,,0,0,0,,Қосылған
Dialogue: 0,0:46:40.56,0:46:41.12,Default,,0,0,0,,Сіз оны алдыңыз ба?
Dialogue: 0,0:46:50.30,0:46:53.25,Default,,0,0,0,,Біз Шинбэйге барайық па?
Dialogue: 0,0:46:55.04,0:46:56.85,Default,,0,0,0,,Оның орнына сіз қиындық тудырасыз.
Dialogue: 0,0:47:00.88,0:47:03.54,Default,,0,0,0,,Тек Акиді аулауға болады.
Dialogue: 0,0:47:28.90,0:47:31.55,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:47:32.36,0:47:34.09,Default,,0,0,0,,Сіз құладыңыз.
Dialogue: 0,0:47:34.44,0:47:35.34,Default,,0,0,0,,Мен енді қаша алмаймын
Dialogue: 0,0:47:35.67,0:47:40.84,Default,,0,0,0,,Қашу Акирафушиде қашатын жер жоқ.
Dialogue: 0,0:47:43.01,0:47:45.23,Default,,0,0,0,,Соңғы бөлік – тістің қара ойығы.
Dialogue: 0,0:47:45.23,0:47:47.12,Default,,0,0,0,,Қызық екен, сенің аяныштысың
Dialogue: 0,0:47:49.65,0:47:52.01,Default,,0,0,0,,Енді маусым аяқталды
Dialogue: 0,0:47:55.53,0:47:57.06,Default,,0,0,0,,Мен өміріме өкінбеймін
Dialogue: 0,0:47:57.94,0:48:00.81,Default,,0,0,0,,Жарайсың кішкентай қыз
Dialogue: 0,0:48:01.99,0:48:03.35,Default,,0,0,0,,Бұл сөзсіз әйелдік.
Dialogue: 0,0:48:04.27,0:48:06.67,Default,,0,0,0,,Мені таптым, Адам кейпінде.
Dialogue: 0,0:48:07.51,0:48:10.01,Default,,0,0,0,,Әйел болудан қорқасыз ба?
Dialogue: 0,0:48:10.11,0:48:10.77,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:48:10.77,0:48:16.31,Default,,0,0,0,,Екеуміз де бір әйелміз. Соңында Акиден жақсылық сұраңыз.
Dialogue: 0,0:48:18.25,0:48:19.32,Default,,0,0,0,,Өз бетіңізше қозғалмаңыз
Dialogue: 0,0:48:20.41,0:48:24.67,Default,,0,0,0,,Мен мұны Шиба Атагоямадағы Шинбэйге жеткізуіңізді қалаймын.
Dialogue: 0,0:48:25.12,0:48:26.48,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:48:27.64,0:48:29.79,Default,,0,0,0,,Мен саған Акидің басын беремін.
Dialogue: 0,0:48:31.42,0:48:34.34,Default,,0,0,0,,Енді сіз өзіңізге серік бола аласыз.
Dialogue: 0,0:48:40.14,0:48:41.18,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:48:42.28,0:48:45.84,Default,,0,0,0,,Төмен қаратып жазу кезінде ``адам'' дегеннің жанына ``ит'' деп жазыңыз.
Dialogue: 0,0:48:47.06,0:48:49.15,Default,,0,0,0,,Мен оқи алмаймын.
Dialogue: 0,0:48:50.86,0:48:52.04,Default,,0,0,0,,Хамадзи
Dialogue: 0,0:48:53.49,0:48:55.35,Default,,0,0,0,,Ол жерден кет!
Dialogue: 0,0:48:55.48,0:48:56.05,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:49:00.72,0:49:01.85,Default,,0,0,0,,Қоштасу
Dialogue: 0,0:49:23.64,0:49:26.39,Default,,0,0,0,,Жетіншісі аң аулауда. Асығыңыз, асығыңыз!
Dialogue: 0,0:49:26.71,0:49:27.71,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:49:29.85,0:49:34.14,Default,,0,0,0,,Эй, Кисуке, Окахикиге қоңырау шалып, оған хабар бер.
Dialogue: 0,0:49:49.17,0:49:49.76,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:49:55.86,0:49:56.87,Default,,0,0,0,,Жарайсың Хамаджи
Dialogue: 0,0:50:13.82,0:50:14.58,Default,,0,0,0,,Оқ жаудыр!
Dialogue: 0,0:50:16.84,0:50:17.96,Default,,0,0,0,,Бірінші, үш, төрт
Dialogue: 0,0:50:18.56,0:50:22.35,Default,,0,0,0,,Ауырлық центріңізді сол қолыңызбен көлденең ұстаңыз және денеңіздің шын ортасында позицияңызды ұстаңыз.
Dialogue: 0,0:50:22.99,0:50:25.31,Default,,0,0,0,,Келесі оқ дайын
Dialogue: 0,0:50:25.61,0:50:26.17,Default,,0,0,0,,Иә
Dialogue: 0,0:50:27.54,0:50:29.38,Default,,0,0,0,,Тағы біреуі ғана қалды
Dialogue: 0,0:50:30.39,0:50:32.95,Default,,0,0,0,,Мурасамемару-саманы жұлып алғанда шашырайтын әділет жүзі
Dialogue: 0,0:50:33.63,0:50:37.45,Default,,0,0,0,,Елді ашамын деп қорқытатын жалған ақша жасаушылардан тазалығымызды сақтай гөр.
Dialogue: 0,0:50:38.01,0:50:39.97,Default,,0,0,0,,Маған соңғы күшіңізді беріңізші.
Dialogue: 0,0:50:40.83,0:50:42.37,Default,,0,0,0,,Зұлымдарға үкім шығар.
Dialogue: 0,0:50:50.07,0:50:51.46,Default,,0,0,0,,Құрттар өсіп шықты.
Dialogue: 0,0:50:52.52,0:50:54.57,Default,,0,0,0,,Ауыстыру бұрышы Бұны кейінірек қалдырыңыз.
Dialogue: 0,0:50:54.89,0:50:55.43,Default,,0,0,0,,Иә
Dialogue: 0,0:50:56.09,0:50:56.87,Default,,0,0,0,,Абожи магистрі
Dialogue: 0,0:50:57.19,0:50:57.72,Default,,0,0,0,,Иә
Dialogue: 0,0:50:57.88,0:50:59.48,Default,,0,0,0,,Ойын-сауық фестиваліне дайындық
Dialogue: 0,0:50:59.94,0:51:03.64,Default,,0,0,0,,Мен Иесада-саманың денсаулығы туралы ойласам,
Dialogue: 0,0:51:03.84,0:51:05.73,Default,,0,0,0,,Фестивальді қазір кім өткізіп жатыр?
Dialogue: 0,0:51:05.84,0:51:07.27,Default,,0,0,0,,Өйткені мұндай уақыт
Dialogue: 0,0:51:07.61,0:51:08.61,Default,,0,0,0,,үшін алаңдаулы
Dialogue: 0,0:51:09.14,0:51:10.49,Default,,0,0,0,,Қамалдың ашылуы
Dialogue: 0,0:51:10.89,0:51:12.75,Default,,0,0,0,,Оларға үлкен жұбаныш берейік.
Dialogue: 0,0:51:13.12,0:51:14.14,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:51:14.77,0:51:16.53,Default,,0,0,0,,Даикаку сен тағы
Dialogue: 0,0:51:17.01,0:51:20.17,Default,,0,0,0,,Қамалдағылардың барлығы тек өздерін уайымдайды.
Dialogue: 0,0:51:20.74,0:51:22.91,Default,,0,0,0,,Мырзаның жүрегі, Ел-жұрты да қуанады.
Dialogue: 0,0:51:23.04,0:51:23.85,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:51:24.68,0:51:27.53,Default,,0,0,0,,Мен бұл себеп пен салдарды біржола тоқтатуым керек.
Dialogue: 0,0:51:31.32,0:51:34.96,Default,,0,0,0,,Йосиварадағы эвакуация оқиғасы Бұл шынымен шуақты күн болды.
Dialogue: 0,0:51:35.31,0:51:35.92,Default,,0,0,0,,Хаха
Dialogue: 0,0:51:35.98,0:51:36.76,Default,,0,0,0,,Хаха
Dialogue: 0,0:51:36.91,0:51:40.74,Default,,0,0,0,,Күш-қуатымды ысырап етпегеніме қуаныштымын, сэр.
Dialogue: 0,0:51:41.65,0:51:44.44,Default,,0,0,0,,Бұл уәде етілген сый.\NӘзірге
Dialogue: 0,0:51:44.97,0:51:46.23,Default,,0,0,0,,100 ryo
Dialogue: 0,0:51:47.40,0:51:48.31,Default,,0,0,0,,багаж да.
Dialogue: 0,0:51:48.76,0:51:51.83,Default,,0,0,0,,Қалған 400-ді ертең аламын.
Dialogue: 0,0:51:51.84,0:51:52.60,Default,,0,0,0,,Иә
Dialogue: 0,0:51:55.25,0:51:55.99,Default,,0,0,0,,Бөлімде
Dialogue: 0,0:51:57.60,0:51:58.27,Default,,0,0,0,,Бөлім
Dialogue: 0,0:51:59.21,0:52:01.18,Default,,0,0,0,,Сіз менің не айтқым келгенін түсіндім дейсіз бе?
Dialogue: 0,0:52:01.58,0:52:06.77,Default,,0,0,0,,Шенеунік мырза, сіз сол көп ақшаны кішкене бөліктерге бөліп, маған аз-аздап бере аласыз ба?
Dialogue: 0,0:52:07.03,0:52:09.01,Default,,0,0,0,,Эдо халқы сондай жиіркенішті еліктеушілер.
Dialogue: 0,0:52:09.59,0:52:10.54,Default,,0,0,0,,Себебін тыңдайық
Dialogue: 0,0:52:11.98,0:52:16.08,Default,,0,0,0,,Мен бәрін бір түнде жасаудың өзі қулық сияқты сезінемін.
Dialogue: 0,0:52:19.04,0:52:22.13,Default,,0,0,0,,Түсінемін, сіз үнемшіл болуға тырысасыз.
Dialogue: 0,0:52:22.66,0:52:25.95,Default,,0,0,0,,Несие: Ініңіз де көп жұмыс істеген деп естідім.
Dialogue: 0,0:52:26.41,0:52:27.72,Default,,0,0,0,,Аға
Dialogue: 0,0:52:29.02,0:52:29.88,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:52:30.02,0:52:30.86,Default,,0,0,0,,Бөлімде
Dialogue: 0,0:52:34.43,0:52:36.81,Default,,0,0,0,,Жасыл пияз және мицуба жапырақтары, оларды қалауыңызша жеуге болады.
Dialogue: 0,0:52:43.75,0:52:47.65,Default,,0,0,0,,Аңшылық байланыстыру деп атам айтқан.
Dialogue: 0,0:52:48.45,0:52:50.41,Default,,0,0,0,,Шабыт алдым, тез тамақтан.
Dialogue: 0,0:52:54.36,0:52:58.96,Default,,0,0,0,,Сол кезде Йосиварада мен сол Сақтандырғышпен қосылдым.
Dialogue: 0,0:52:59.60,0:53:01.79,Default,,0,0,0,,Бірақ олар серіктес емес.
Dialogue: 0,0:53:03.35,0:53:04.89,Default,,0,0,0,,Қайтадан ояныңыз
Dialogue: 0,0:53:06.47,0:53:07.98,Default,,0,0,0,,На Хамаджия
Dialogue: 0,0:53:09.15,0:53:11.60,Default,,0,0,0,,Бұдан былай мен анықтамаларды бөлек іздеймін.
Dialogue: 0,0:53:13.57,0:53:14.56,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:53:15.26,0:53:16.75,Default,,0,0,0,,Тапсырмаларды бөлу жылдамырақ болуы мүмкін
Dialogue: 0,0:53:17.56,0:53:18.75,Default,,0,0,0,,Сіз қайда тұрасыз?
Dialogue: 0,0:53:19.05,0:53:21.00,Default,,0,0,0,,Косакура көпіріндегі Кавахара Нагая
Dialogue: 0,0:53:21.31,0:53:22.42,Default,,0,0,0,,Жақсы жұмыс.
Dialogue: 0,0:53:40.51,0:53:47.07,Default,,0,0,0,,Амон, ол жігіт қауіпті.
Dialogue: 0,0:53:51.30,0:53:58.24,Default,,0,0,0,,Мені тастама
Dialogue: 0,0:54:00.44,0:54:15.46,Default,,0,0,0,,Мен мұңайып, жүрегім ауырады.
Dialogue: 0,0:54:16.93,0:54:22.98,Default,,0,0,0,,Түнгі аспандағы жұлдыздар да
Dialogue: 0,0:54:24.77,0:54:32.62,Default,,0,0,0,,Тіпті таңғы тұман
Dialogue: 0,0:54:33.05,0:54:36.44,Default,,0,0,0,,үшінна
Dialogue: 0,0:54:36.94,0:54:41.33,Default,,0,0,0,,Біз кездесе аламыз ба?
Dialogue: 0,0:54:41.33,0:54:46.48,Default,,0,0,0,,Мені тастама
Dialogue: 0,0:55:01.07,0:55:03.54,Default,,0,0,0,,Ләззат фестивалі дегеніміз не?
Dialogue: 0,0:55:03.54,0:55:07.83,Default,,0,0,0,,Лорд Иесада қарапайым адамдарды қамал алаңына шақыратын сияқты.
Dialogue: 0,0:55:07.93,0:55:11.05,Default,,0,0,0,,Сол генералдың да жүрегі әлсіз болуы керек.
Dialogue: 0,0:55:11.09,0:55:13.73,Default,,0,0,0,,Ел ашылғанша бәріміз сау болайық
Dialogue: 0,0:55:13.73,0:55:15.50,Default,,0,0,0,,Қоғамдық жиынды көру ғажап.
Dialogue: 0,0:55:15.50,0:55:16.97,Default,,0,0,0,,Досецу да көмектеседі
Dialogue: 0,0:55:17.07,0:55:18.52,Default,,0,0,0,,Фестиваль
Dialogue: 0,0:55:18.52,0:55:19.95,Default,,0,0,0,,Керемет Котта
Dialogue: 0,0:55:20.36,0:55:23.50,Default,,0,0,0,,Үкіметте жұмыс істеу туралы әңгіме не болып жатыр?
Dialogue: 0,0:55:23.67,0:55:25.75,Default,,0,0,0,,Мұғалім сізге көп рахмет.
Dialogue: 0,0:55:25.75,0:55:29.84,Default,,0,0,0,,Шынымды айтсам, бір рет ақша түскен соң, маған бәрібір болды.
Dialogue: 0,0:55:29.89,0:55:31.84,Default,,0,0,0,,Біраз уақыт ішіп өмір сүремін.
Dialogue: 0,0:55:32.94,0:55:35.19,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:55:39.88,0:55:40.72,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:55:42.66,0:55:46.36,Default,,0,0,0,,Бүгін кешке маңызды нәрсеге уақыт бөліңіз.
Dialogue: 0,0:55:46.72,0:55:49.21,Default,,0,0,0,,Менің ойымша, бұл еске салу емес.
Dialogue: 0,0:55:51.56,0:55:53.08,Default,,0,0,0,,Мен осында күтемін.
Dialogue: 0,0:55:53.50,0:55:54.03,Default,,0,0,0,,О.
Dialogue: 0,0:55:54.58,0:55:57.03,Default,,0,0,0,,Умоши
Dialogue: 0,0:55:58.09,0:56:03.63,Default,,0,0,0,,Өйткені, ол Фукуйді емдеген Досецу Ояма.
Dialogue: 0,0:56:03.90,0:56:05.30,Default,,0,0,0,,Оооо
Dialogue: 0,0:56:05.40,0:56:07.81,Default,,0,0,0,,Маған нұсқау беруді сұрады.
Dialogue: 0,0:56:09.60,0:56:11.10,Default,,0,0,0,,Бұл сізге ұнаса
Dialogue: 0,0:56:11.18,0:56:12.34,Default,,0,0,0,,Не?
Dialogue: 0,0:56:12.60,0:56:14.34,Default,,0,0,0,,Бұл ойын тегі немесе басқа нәрсе ме?
Dialogue: 0,0:56:14.47,0:56:15.24,Default,,0,0,0,,Иә
Dialogue: 0,0:56:15.34,0:56:17.24,Default,,0,0,0,,Бұл Фукагава труппасы
Dialogue: 0,0:56:17.24,0:56:19.47,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:56:19.62,0:56:23.85,Default,,0,0,0,,Біз сізді Вакашу Кабукиге шақырамыз.
Dialogue: 0,0:56:23.85,0:56:25.42,Default,,0,0,0,,Біз оны сіздерге ұсынуға келдік.
Dialogue: 0,0:56:25.59,0:56:28.81,Default,,0,0,0,,Әрине, қару қолданушының сіңлісі.
Dialogue: 0,0:56:28.81,0:56:30.55,Default,,0,0,0,,Бізге қосылыңыз
Dialogue: 0,0:56:30.67,0:56:32.07,Default,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,0:56:56.91,0:56:59.96,Default,,0,0,0,,Эдо бүгін қауіпсіз бе?
Dialogue: 0,0:57:04.73,0:57:06.11,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:57:12.56,0:57:14.64,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:57:27.83,0:57:29.86,Default,,0,0,0,,Кәуарабан әр бетте 3 сөйлем
Dialogue: 0,0:57:29.86,0:57:32.20,Default,,0,0,0,,Сіз мұны саттыңыз.
Dialogue: 0,0:57:33.37,0:57:35.49,Default,,0,0,0,,Оноши Өткен күні
Dialogue: 0,0:57:35.76,0:57:38.42,Default,,0,0,0,,Әріптерді оқи алмасам да, ең болмаса суреттерді түсінемін.
Dialogue: 0,0:57:38.66,0:57:40.72,Default,,0,0,0,,Неге еркекше жазбайсың?
Dialogue: 0,0:57:40.79,0:57:41.86,Default,,0,0,0,,Бұл дөрекі.
Dialogue: 0,0:57:41.95,0:57:43.69,Default,,0,0,0,,Оноши әйел
Dialogue: 0,0:57:43.69,0:57:45.39,Default,,0,0,0,,Иә, қайта жазыңыз.
Dialogue: 0,0:57:45.77,0:57:47.95,Default,,0,0,0,,Мен мұны істей алмаймын. Менде ағаштан жасалған баспа бар.
Dialogue: 0,0:57:48.31,0:57:49.23,Default,,0,0,0,,Ағаштан жасалған бұйымдар
Dialogue: 0,0:58:06.14,0:58:10.28,Default,,0,0,0,,Сіз осындай нәрсені жасау үшін керемет жігіт болуыңыз керек.
Dialogue: 0,0:58:10.74,0:58:14.00,Default,,0,0,0,,Бұл соншалықты үлкен мәміле емес.
Dialogue: 0,0:58:14.00,0:58:16.03,Default,,0,0,0,,Бұл соңғы нұсқа ма?
Dialogue: 0,0:58:16.03,0:58:17.43,Default,,0,0,0,,Менде біреуін алайын ба?
Dialogue: 0,0:58:17.43,0:58:19.93,Default,,0,0,0,,Ей, монах, мынау да бар.
Dialogue: 0,0:58:19.93,0:58:20.97,Default,,0,0,0,,Монах дегеніміз не?
Dialogue: 0,0:58:21.16,0:58:22.39,Default,,0,0,0,,Қанша?
Dialogue: 0,0:58:22.73,0:58:23.84,Default,,0,0,0,,Жақсы
Dialogue: 0,0:58:24.09,0:58:25.76,Default,,0,0,0,,Әр парақта үш сөйлем
Dialogue: 0,0:58:31.13,0:58:33.85,Default,,0,0,0,,Тақта нұсқасы Бұл тақтайша нұсқасы.
Dialogue: 0,0:58:33.95,0:58:35.61,Default,,0,0,0,,Әр парақта үш сөйлем
Dialogue: 0,0:58:35.73,0:58:37.78,Default,,0,0,0,,Бұл Фушигидің соңғы нұсқасы.
Dialogue: 0,0:58:37.78,0:58:38.87,Default,,0,0,0,,Тақта тақтайшасы
Dialogue: 0,0:58:46.19,0:58:47.92,Default,,0,0,0,,Шиба Атагояма
Dialogue: 0,0:58:47.92,0:58:49.91,Default,,0,0,0,,Иә, мен орналасқан жерді білемін.
Dialogue: 0,0:58:50.10,0:58:51.44,Default,,0,0,0,,Осы жерге жақын ба?
Dialogue: 0,0:58:51.60,0:58:53.64,Default,,0,0,0,,Жаяу жүрсең біраз алыс.
Dialogue: 0,0:58:53.69,0:58:57.37,Default,,0,0,0,,Окава өзеніне қайықпен түссеңіз, күн батқанда жетуіңіз мүмкін.
Dialogue: 0,0:58:57.37,0:58:58.48,Default,,0,0,0,,Рахмет
Dialogue: 0,0:59:13.12,0:59:14.75,Default,,0,0,0,,Жер асты әлемі ғажап
Dialogue: 0,0:59:14.75,0:59:17.37,Default,,0,0,0,,Ол менімен құрдас еді, тақтайшалар жасады.
Dialogue: 0,0:59:17.47,0:59:19.96,Default,,0,0,0,,Қарсыласу әлдеқайда ғажайып емес пе?
Dialogue: 0,0:59:20.24,0:59:23.29,Default,,0,0,0,,Бірақ, менің атам оқырман болып жұмыс істейді.
Dialogue: 0,0:59:23.29,0:59:24.87,Default,,0,0,0,,Мүмкін бұл әсер еткен шығар?
Dialogue: 0,0:59:24.87,0:59:26.22,Default,,0,0,0,,Түсіндім, түсінемін
Dialogue: 0,0:59:26.22,0:59:29.40,Default,,0,0,0,,Мен де атамның ықпалымен аңшы болдым.
Dialogue: 0,0:59:29.76,0:59:32.25,Default,,0,0,0,,Мен сүйген атам туралы
Dialogue: 0,0:59:34.19,0:59:37.34,Default,,0,0,0,,Мен атаммен көптен бері бетпе-бет келемін.
Dialogue: 0,0:59:37.63,0:59:40.89,Default,,0,0,0,,Менің анам көзінің көруі нашарлаған кезден бастап Когиді қолданады.
Dialogue: 0,0:59:41.12,0:59:45.13,Default,,0,0,0,,Сондықтан мен олардың кек алу мақсатында кездеспеуіне тырысамын.
Dialogue: 0,0:59:46.11,0:59:48.16,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:59:48.34,0:59:49.04,Default,,0,0,0,,Иә
Dialogue: 0,0:59:49.53,0:59:51.39,Default,,0,0,0,,Мен өзімді жек көретін сияқтымын
Dialogue: 0,0:59:52.45,0:59:53.85,Default,,0,0,0,,Хамадзи.
Dialogue: 0,0:59:54.83,0:59:58.53,Default,,0,0,0,,Бұл эротикалық көмекші әйелдерді тез табады.
Dialogue: 0,0:59:59.96,1:00:02.03,Default,,0,0,0,,Хамадзи
Dialogue: 0,1:00:02.93,1:00:06.19,Default,,0,0,0,,Мен Занзо қарияны шақырайын деп жатырмын.
Dialogue: 0,1:00:06.27,1:00:08.26,Default,,0,0,0,,Хамаджи де Кабукиге барады
Dialogue: 0,1:00:08.81,1:00:09.74,Default,,0,0,0,,Кабуки?
Dialogue: 0,1:00:09.89,1:00:12.71,Default,,0,0,0,,Фукагава труппасы үшін алда
Dialogue: 0,1:00:12.79,1:00:15.25,Default,,0,0,0,,Жақында танымал болған саятшылық ойынында.
Dialogue: 0,1:00:15.25,1:00:17.63,Default,,0,0,0,,Олар бизнесті Шибадағы Атагоямаға дейін сатады.
Dialogue: 0,1:00:18.67,1:00:20.35,Default,,0,0,0,,Сіздің әпкеңіз де барады ма?
Dialogue: 0,1:00:32.30,1:00:34.27,Default,,0,0,0,,Бұл Вакашу Кабуки деп айтыңыз.
Dialogue: 0,1:00:34.27,1:00:36.36,Default,,0,0,0,,Бұл тек ұлдар болатын пьеса.
Dialogue: 0,1:00:36.55,1:00:39.37,Default,,0,0,0,,Әйел рөлін де ер адам атқарады.
Dialogue: 0,1:00:39.37,1:00:43.20,Default,,0,0,0,,Иә, Омори Куроширодағы актерлер өте танымал.
Dialogue: 0,1:00:43.32,1:00:46.33,Default,,0,0,0,,Сарувакадағы негізгі ойыншы оны шығарып алуға тырысқан сияқты.
Dialogue: 0,1:00:46.77,1:00:47.77,Default,,0,0,0,,Мен алға шықтым
Dialogue: 0,1:00:47.77,1:00:48.27,Default,,0,0,0,,Иә
Dialogue: 0,1:00:58.41,1:01:00.89,Default,,0,0,0,,Курохаку мырза, уақыт таяп қалды.
Dialogue: 0,1:01:01.85,1:01:04.72,Default,,0,0,0,,Құрметті қонақ келді.
Dialogue: 0,1:01:17.01,1:01:19.03,Default,,0,0,0,,Сатоми Хаккенден
Dialogue: 0,1:01:20.09,1:01:23.35,Default,,0,0,0,,Бастапқыда ит пен адам туралы қайғылы оқиға.
Dialogue: 0,1:01:23.35,1:01:24.39,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,1:01:24.47,1:01:26.28,Default,,0,0,0,,Бұл қайғылы махаббат хикаясы.
Dialogue: 0,1:01:26.28,1:01:30.37,Default,,0,0,0,,Не? Мен оны Чанбара пьесасы деп ойладым.
Dialogue: 0,1:01:30.37,1:01:32.02,Default,,0,0,0,,Бұл мүлдем басқа.
Dialogue: 0,1:01:32.12,1:01:36.58,Default,,0,0,0,,Бұл махаббат хикаясы ма? Мен әйел тұтынушылар көп деп ойладым.
Dialogue: 0,1:01:36.78,1:01:39.03,Default,,0,0,0,,Оларға кеме жәндіктерін де қосқанда жақсы болар еді.
Dialogue: 0,1:01:39.27,1:01:42.60,Default,,0,0,0,,Менің ойымша, мен бүгін олай емес сияқтымын.
Dialogue: 0,1:01:42.60,1:01:43.54,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,1:01:43.54,1:01:47.16,Default,,0,0,0,,Эй, бұл Кабуки жалған, солай ма?
Dialogue: 0,1:01:47.26,1:01:48.27,Default,,0,0,0,,Жалғандық
Dialogue: 0,1:01:48.27,1:01:49.62,Default,,0,0,0,,ұқсайды
Dialogue: 0,1:01:49.62,1:01:53.55,Default,,0,0,0,,Бұл түпнұсқа оқу кітабының жалған нұсқасы.
Dialogue: 0,1:01:53.60,1:01:54.82,Default,,0,0,0,,Жалғандық
Dialogue: 0,1:01:54.82,1:01:57.38,Default,,0,0,0,,Жоқ, жоқ, мен блокбастермін.
Dialogue: 0,1:01:58.39,1:02:01.42,Default,,0,0,0,,Сонда да сен көп нәрсені білесің, жас ханым.
Dialogue: 0,1:02:01.42,1:02:05.84,Default,,0,0,0,,Е-е, менің атам Хақкенден жазыпты.
Dialogue: 0,1:02:07.13,1:02:10.11,Default,,0,0,0,,Такизава Бакин Менің атам
Dialogue: 0,1:02:20.88,1:02:23.05,Default,,0,0,0,,Уақыт - Сенгоку, Ава елі
Dialogue: 0,1:02:23.19,1:02:27.69,Default,,0,0,0,,Бұл Мурасамемару таңдаған дүние жүзіндегі асыл қылыш.
Dialogue: 0,1:02:27.69,1:02:29.81,Default,,0,0,0,,Батырдың оқиғасы
Dialogue: 0,1:02:30.33,1:02:31.73,Default,,0,0,0,,Йошими Сатоми
Dialogue: 0,1:02:33.09,1:02:35.35,Default,,0,0,0,,Аспалы сарайдың өзі зақымдалған
Dialogue: 0,1:02:35.35,1:02:38.51,Default,,0,0,0,,Бір түнде доптай қыз бала дүниеге келді.
Dialogue: 0,1:02:41.30,1:02:44.88,Default,,0,0,0,,Бүгінгі түнде толған айдай әдемі
Dialogue: 0,1:02:44.97,1:02:46.57,Default,,0,0,0,,Сен сарайда жатасың
Dialogue: 0,1:02:46.57,1:02:48.36,Default,,0,0,0,,Ауыл тұрғындарына жат
Dialogue: 0,1:02:48.36,1:02:51.62,Default,,0,0,0,,Өзіңізді тастап, бейбітшілік пен жанашырлықта өмір сүріңіз.
Dialogue: 0,1:02:52.21,1:02:55.88,Default,,0,0,0,,Ал қызының есімі Фьюзе болды.
Dialogue: 0,1:02:59.77,1:03:02.00,Default,,0,0,0,,Уақыт өтеді, 17 жылдан кейін
Dialogue: 0,1:03:05.04,1:03:07.74,Default,,0,0,0,,Мен көремін. Бұл құрылым ма?
Dialogue: 0,1:03:07.74,1:03:10.65,Default,,0,0,0,,А, мен күттім, Курохаку-сама.
Dialogue: 0,1:03:11.78,1:03:15.29,Default,,0,0,0,,Жас Фушихиме өрістерді аралап жүгіріп, тауға шықты.
Dialogue: 0,1:03:15.29,1:03:17.14,Default,,0,0,0,,Оқу мүмкін емес
Dialogue: 0,1:03:17.14,1:03:19.12,Default,,0,0,0,,Балаға ұқсайды
Dialogue: 0,1:03:19.67,1:03:22.66,Default,,0,0,0,,Бұл мен бұрын айтқан бүйірлік көздің ақ-қарасы.
Dialogue: 0,1:03:22.66,1:03:25.11,Default,,0,0,0,,Бірақ барқыт ақ аң
Dialogue: 0,1:03:26.53,1:03:28.65,Default,,0,0,0,,Яцуфуса деген итті көтеріп алған соң
Dialogue: 0,1:03:28.76,1:03:31.99,Default,,0,0,0,,Фушихиме әлдеқайда қыз болып кетті.
Dialogue: 0,1:03:40.37,1:03:43.38,Default,,0,0,0,,Фушихиме менің орынбасарым болғандай.
Dialogue: 0,1:03:43.45,1:03:49.00,Default,,0,0,0,,Яфусаның далада жүгіріп, тауға шыққанын сүйіспеншілікпен көрдім.
Dialogue: 0,1:03:51.63,1:03:52.45,Default,,0,0,0,,Шино
Dialogue: 0,1:03:53.10,1:03:54.99,Default,,0,0,0,,Ол өте әдемі
Dialogue: 0,1:03:54.99,1:03:59.09,Default,,0,0,0,,Еркек болсаң, сондай сұлу болсаң, айналаңдағы таяздан ерекшелене алмайсың.
Dialogue: 0,1:03:59.88,1:04:05.36,Default,,0,0,0,,Әттең, Фушихименің бақытты күндері ұзаққа бармады.
Dialogue: 0,1:04:05.77,1:04:09.53,Default,,0,0,0,,Көрші ел Анзай Кейрен кенет басып кірді.
Dialogue: 0,1:04:11.45,1:04:14.21,Default,,0,0,0,,Йошизане қиыншылыққа ұшырап, уайымдады
Dialogue: 0,1:04:14.24,1:04:16.90,Default,,0,0,0,,Жау генералының басын алғандарға сыйлық ретінде.
Dialogue: 0,1:04:16.90,1:04:21.39,Default,,0,0,0,,Ол Фьюс ханшайымға үйленуге уәде берді.
Dialogue: 0,1:04:25.90,1:04:29.51,Default,,0,0,0,,Кейреннің басын алған адам болып шығады
Dialogue: 0,1:04:29.51,1:04:31.51,Default,,0,0,0,,Фушихименің Хачифуса иті
Dialogue: 0,1:04:31.64,1:04:36.56,Default,,0,0,0,,Және уәде етілгендей, бір-бірі ерлі-зайыптылар болды.
Dialogue: 0,1:04:48.70,1:04:49.45,Default,,0,0,0,,Хамадзи
Dialogue: 0,1:04:51.77,1:04:55.00,Default,,0,0,0,,Егер пьеса шықса, мен артқы учаскеде күтемін.
Dialogue: 0,1:05:01.74,1:05:03.78,Default,,0,0,0,,Бірақ бұл жерде шегініс бар.
Dialogue: 0,1:05:03.78,1:05:09.20,Default,,0,0,0,,Әңгімеде Фушихиме мен Яцуфусаның күтпеген жерден балалы болғаны айтылады.
Dialogue: 0,1:05:10.08,1:05:11.58,Default,,0,0,0,,Мені кешіріңіз.
Dialogue: 0,1:05:11.58,1:05:15.32,Default,,0,0,0,,Менің қызым, Сатоми отбасының қызы
Dialogue: 0,1:05:15.32,1:05:17.70,Default,,0,0,0,,Иттің баласын ұрықтандыру және т.б.
Dialogue: 0,1:05:21.68,1:05:22.90,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,1:05:22.97,1:05:24.38,Default,,0,0,0,,Жақын адамдар
Dialogue: 0,1:05:24.66,1:05:29.86,Default,,0,0,0,,Мен Яфуса және мына баламен сарайдан алыс тұрамын.
Dialogue: 0,1:05:32.28,1:05:34.19,Default,,0,0,0,,Бір және бір
Dialogue: 0,1:05:34.19,1:05:37.55,Default,,0,0,0,,Шалғайдағы орманға жоғалып кетті
Dialogue: 0,1:05:35.32,1:05:38.11,Default,,0,0,0,,Ал, тағы кел~
Dialogue: 0,1:05:39.27,1:05:41.62,Default,,0,0,0,,Ханшайымның сол кезде жүкті болған өмірі
Dialogue: 0,1:05:41.62,1:05:46.73,Default,,0,0,0,,Бұл кейінірек ``буши'' деп аталатын нәрсенің басы емес пе еді?
Dialogue: 0,1:05:47.20,1:05:50.93,Default,,0,0,0,,Бұл да келесі пьесада.
Dialogue: 0,1:05:59.43,1:06:01.00,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:06:01.00,1:06:02.69,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:06:02.69,1:06:04.55,Default,,0,0,0,,Біз сіздің қамқорлығыңызды күтеміз.
Dialogue: 0,1:06:04.55,1:06:07.06,Default,,0,0,0,,Біз сізді тағы да күтеміз.
Dialogue: 0,1:06:07.65,1:06:09.06,Default,,0,0,0,,Бұл жақсы ойын болды.
Dialogue: 0,1:06:09.59,1:06:11.07,Default,,0,0,0,,Бұл шынымен де біртүрлі оқиға болды.
Dialogue: 0,1:06:11.07,1:06:12.36,Default,,0,0,0,,Әй, аға.
Dialogue: 0,1:06:13.39,1:06:14.19,Default,,0,0,0,,Не болды?
Dialogue: 0,1:06:14.40,1:06:17.08,Default,,0,0,0,,Мен актердің суретін сатып алуды ұмытып кетіппін.
Dialogue: 0,1:06:17.40,1:06:18.61,Default,,0,0,0,,Сіз мұны қалайсыз ба?
Dialogue: 0,1:06:18.87,1:06:20.35,Default,,0,0,0,,Мен саған бір нәрсе сатып аламын.
Dialogue: 0,1:06:20.35,1:06:21.49,Default,,0,0,0,,Ақша бар.
Dialogue: 0,1:06:22.67,1:06:24.56,Default,,0,0,0,,Алдымен үйге барыңыз
Dialogue: 0,1:06:24.88,1:06:26.62,Default,,0,0,0,,Жақында жететінімізге сенімдімін.
Dialogue: 0,1:06:28.56,1:06:31.22,Default,,0,0,0,,Хамаджи Сіз өте кешіктіңіз.
Dialogue: 0,1:06:31.86,1:06:32.51,Default,,0,0,0,,Иә
Dialogue: 0,1:06:39.29,1:06:41.41,Default,,0,0,0,,Мен саған қоңырау шалуды тоқтатқан жоқпын.
Dialogue: 0,1:06:41.82,1:06:43.59,Default,,0,0,0,,Хамаджи-чан артына қарады.
Dialogue: 0,1:06:45.00,1:06:48.66,Default,,0,0,0,,Сол кезде біз қосылдық.
Dialogue: 0,1:07:18.17,1:07:19.06,Default,,0,0,0,,Шино
Dialogue: 0,1:07:20.06,1:07:23.62,Default,,0,0,0,,Үйрек тұзды пиязды алды. Мынадай нәрсе.
Dialogue: 0,1:07:26.51,1:07:29.81,Default,,0,0,0,,Бұл мені құлатқан үлкен мылтық болды.
Dialogue: 0,1:07:31.13,1:07:33.14,Default,,0,0,0,,Қой, сен кімсің?
Dialogue: 0,1:07:33.28,1:07:34.88,Default,,0,0,0,,Жалғыздық
Dialogue: 0,1:07:35.41,1:07:40.27,Default,,0,0,0,,Сақтандырғышқа қосылғаныңызды жақсы білеміз.
Dialogue: 0,1:07:41.21,1:07:42.48,Default,,0,0,0,,Бұл әйел ме?
Dialogue: 0,1:07:42.53,1:07:44.66,Default,,0,0,0,,Көңілді түн болатын сияқты.
Dialogue: 0,1:07:45.45,1:07:47.25,Default,,0,0,0,,Бұл фуши қайда?
Dialogue: 0,1:07:47.40,1:07:49.93,Default,,0,0,0,,Жауап бермесең, киіміңді шешемін.
Dialogue: 0,1:07:52.61,1:07:55.32,Default,,0,0,0,,Балалар сендер шынымен бақытсыз екенсіңдер.
Dialogue: 0,1:07:59.47,1:08:01.65,Default,,0,0,0,,Бүгін тағы тамағым кепті.
Dialogue: 0,1:08:12.58,1:08:16.38,Default,,0,0,0,,Теме соңғы садақ болды.
Dialogue: 0,1:08:27.67,1:08:28.75,Default,,0,0,0,,Шин…жоқ
Dialogue: 0,1:08:30.55,1:08:31.67,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,1:08:32.23,1:08:34.71,Default,,0,0,0,,Мен сенің жаныңды жегім келеді.
Dialogue: 0,1:08:35.77,1:08:37.50,Default,,0,0,0,,Өтінемін, мені өлтіріңіз.
Dialogue: 0,1:08:37.86,1:08:41.04,Default,,0,0,0,,Мені сол мылтықпен өлтір.
Dialogue: 0,1:08:41.98,1:08:45.58,Default,,0,0,0,,Жаңа ғана Шинбэй деген жігітке хат беруге бардым.
Dialogue: 0,1:08:45.58,1:08:47.28,Default,,0,0,0,,Ол баяғыда қайтыс болды.
Dialogue: 0,1:08:48.76,1:08:50.67,Default,,0,0,0,,Шинбэй - Мұздатылған тырнаның баласы.
Dialogue: 0,1:08:51.11,1:08:52.44,Default,,0,0,0,,Фуши және адам баласы
Dialogue: 0,1:08:53.32,1:08:54.74,Default,,0,0,0,,Мен әкемді танымаймын
Dialogue: 0,1:08:55.27,1:08:57.89,Default,,0,0,0,,Баласы бар үй иесі кәсіппен айналыса алмайды.
Dialogue: 0,1:08:58.01,1:08:59.54,Default,,0,0,0,,Мен әдетте онымен айналысатынмын.
Dialogue: 0,1:09:00.86,1:09:02.99,Default,,0,0,0,,Ата-ана мен балаға айына бір рет оралу
Dialogue: 0,1:09:03.63,1:09:06.90,Default,,0,0,0,,Мен өзімді тұтынушы ретінде көрсетіп, екеуіңді біріктіремін.
Dialogue: 0,1:09:17.92,1:09:20.87,Default,,0,0,0,,Үйге ерте барма, мылтық қыз
Dialogue: 0,1:09:33.56,1:09:34.42,Default,,0,0,0,,Кеме құрты
Dialogue: 0,1:09:45.99,1:09:48.32,Default,,0,0,0,,Мен мемлекеттік қызметкер болып қызмет етер едім.
Dialogue: 0,1:09:49.24,1:09:52.18,Default,,0,0,0,,Менімен ерлі-зайыпты боласың ба?
Dialogue: 0,1:09:52.62,1:09:55.19,Default,,0,0,0,,Менің жұмыс істегім келеді, жоғалтқым келмейді.
Dialogue: 0,1:09:55.60,1:09:58.69,Default,,0,0,0,,Мен де көп нәрседен қорқамын.
Dialogue: 0,1:10:00.69,1:10:02.90,Default,,0,0,0,,Маған бір сәт беріңізші.
Dialogue: 0,1:10:27.21,1:10:28.47,Default,,0,0,0,,Хамадзи
Dialogue: 0,1:10:35.72,1:10:36.69,Default,,0,0,0,,(Ранпа) Зұлымдар Альянсы, иә? Тамаша! Кел, байқап көрейік!
Dialogue: 0,1:10:37.10,1:10:37.75,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:10:38.08,1:10:38.93,Default,,0,0,0,,Бұл да
Dialogue: 0,1:10:39.34,1:10:41.67,Default,,0,0,0,,Сіз адасып кеткен сияқтысыз.
Dialogue: 0,1:10:41.67,1:10:42.41,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,1:10:42.97,1:10:44.91,Default,,0,0,0,,Әй, қолшатырыңды әкел.
Dialogue: 0,1:11:00.35,1:11:03.82,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,1:11:05.94,1:11:10.45,Default,,0,0,0,,Бұл Мейдо-чан осында ма?
Dialogue: 0,1:11:10.63,1:11:14.37,Default,,0,0,0,,Эй, тозақ, сәл күте тұрыңыз.
Dialogue: 0,1:11:16.58,1:11:17.70,Default,,0,0,0,,Хамадзи-чан
Dialogue: 0,1:11:19.35,1:11:21.68,Default,,0,0,0,,Мұнда не болды?
Dialogue: 0,1:11:24.86,1:11:26.36,Default,,0,0,0,,Дұрыс айтасың — ол әдеттегіден де көп әуре-сарсаңға түсіп жүр.
Dialogue: 0,1:11:29.84,1:11:32.84,Default,,0,0,0,,Ақшаңызды ішке алып жүріңіз.
Dialogue: 0,1:11:32.84,1:11:34.78,Default,,0,0,0,,Иә, ханым
Dialogue: 0,1:11:34.87,1:11:36.85,Default,,0,0,0,,Мен алдымен суды қайнатамын.
Dialogue: 0,1:11:36.93,1:11:37.82,Default,,0,0,0,,Иә
Dialogue: 0,1:12:08.90,1:12:11.08,Default,,0,0,0,,Мұны да Аид жазды ма?
Dialogue: 0,1:12:11.64,1:12:12.84,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,1:12:13.17,1:12:15.23,Default,,0,0,0,,Мен оны әлі жақсы жаза алмаймын.
Dialogue: 0,1:12:15.50,1:12:17.09,Default,,0,0,0,,Жаңа плиткалар?
Dialogue: 0,1:12:17.29,1:12:19.24,Default,,0,0,0,,Әртүрлі оқу кітабы
Dialogue: 0,1:12:20.24,1:12:21.24,Default,,0,0,0,,Әңгіме
Dialogue: 0,1:12:21.98,1:12:24.98,Default,,0,0,0,,Бірақ бұл мүлдем жақсы емес. Ол қиын.
Dialogue: 0,1:12:26.78,1:12:29.11,Default,,0,0,0,,Сіздің қызуыңыз жоқ сияқты.
Dialogue: 0,1:12:29.58,1:12:31.49,Default,,0,0,0,,Менің денем суық болды.
Dialogue: 0,1:12:34.05,1:12:36.12,Default,,0,0,0,,Сіз оқу пәнінің мұғалімі боласыз ба?
Dialogue: 0,1:12:36.12,1:12:38.50,Default,,0,0,0,,Тоқта, бұл тек сағыныш
Dialogue: 0,1:12:38.68,1:12:40.98,Default,,0,0,0,,Жатып жүрген қызбен жарыса алмаймын.
Dialogue: 0,1:12:41.30,1:12:42.95,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,1:12:44.36,1:12:47.02,Default,,0,0,0,,Мен енді атуға шамасы келмейтін аңшымын.
Dialogue: 0,1:12:50.40,1:12:53.56,Default,,0,0,0,,Мен мұны жер асты әлемі оқығанын қаладым.
Dialogue: 0,1:12:57.62,1:12:58.92,Default,,0,0,0,,Махаббат хаты?
Dialogue: 0,1:12:59.45,1:13:00.48,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:13:00.89,1:13:03.51,Default,,0,0,0,,Барар жері жоқ жай ғана хат
Dialogue: 0,1:14:12.95,1:14:15.51,Default,,0,0,0,,Бүгінгі күннің бәрі осы.
Dialogue: 0,1:14:20.87,1:14:23.32,Default,,0,0,0,,Барлық жалған заттар жойылады
Dialogue: 0,1:14:23.32,1:14:25.61,Default,,0,0,0,,Мені таңдаңыз
Dialogue: 0,1:14:26.00,1:14:29.88,Default,,0,0,0,,Мурасамемару-сама Мурасамемару-сама...
Dialogue: 0,1:14:29.88,1:14:33.10,Default,,0,0,0,,Лорд Иесадаға деген алаңдаушылық сезімдеріңізді түсінемін.
Dialogue: 0,1:14:33.24,1:14:38.40,Default,,0,0,0,,Дегенмен, самурай ретінде біз мырзаларымыздың артында Токугаваның тарихына қызмет етеміз.
Dialogue: 0,1:14:38.40,1:14:40.90,Default,,0,0,0,,Ертең менің орнымда тұрудан басқа амалым жоқ.
Dialogue: 0,1:14:41.17,1:14:42.17,Default,,0,0,0,,Хаа
Dialogue: 0,1:14:42.55,1:14:44.14,Default,,0,0,0,,Жоспар қандай?
Dialogue: 0,1:14:44.32,1:14:47.94,Default,,0,0,0,,Маймылдың жаратылысына арналған арнайы сахнаның шымылдығы ашылады.
Dialogue: 0,1:14:48.03,1:14:50.83,Default,,0,0,0,,Егер есімде дұрыс болса, сіз ақ пен қараны айттыңыз.
Dialogue: 0,1:14:51.18,1:14:55.98,Default,,0,0,0,,Қалған көздеріңе бәс тігу, бұл жерде ешқандай қате жоқ.
Dialogue: 0,1:15:02.08,1:15:04.94,Default,,0,0,0,,Көшедегі сатушылардың алдында үлкен тоған болды.
Dialogue: 0,1:15:05.06,1:15:06.94,Default,,0,0,0,,Онда қалқымалы сахна бар.
Dialogue: 0,1:15:06.94,1:15:10.33,Default,,0,0,0,,Бұл таңқаларлық. Бұл біз үшін сахна.
Dialogue: 0,1:15:10.33,1:15:12.86,Default,,0,0,0,,Үлкен құрмет үшін рахмет.
Dialogue: 0,1:15:13.25,1:15:16.87,Default,,0,0,0,,Әйелдер осы Геджобаши көпірінен өтіп, оқиғаны көруге келеді.
Dialogue: 0,1:15:17.06,1:15:18.87,Default,,0,0,0,,Менен ешқашан бет бұрма
Dialogue: 0,1:15:18.87,1:15:21.59,Default,,0,0,0,,Бұл менің есегіме үлкен қадам болды.
Dialogue: 0,1:15:21.73,1:15:24.20,Default,,0,0,0,,Ол қай жер?
Dialogue: 0,1:15:24.26,1:15:26.09,Default,,0,0,0,,...
Dialogue: 0,1:15:26.56,1:15:28.50,Default,,0,0,0,,Ең жақынын пайдаланыңыз
Dialogue: 0,1:15:28.60,1:15:30.41,Default,,0,0,0,,Бірақ одан әрі кетпеңіз.
Dialogue: 0,1:15:30.85,1:15:32.71,Default,,0,0,0,,Бұл солай ма? көпір?
Dialogue: 0,1:15:32.71,1:15:34.73,Default,,0,0,0,,Сіз қима қағаздарды оқуды білмейсіз бе?
Dialogue: 0,1:15:34.77,1:15:36.84,Default,,0,0,0,,Бұл көпір Хонмару кезеңі
Dialogue: 0,1:15:48.59,1:15:49.64,Default,,0,0,0,,О, сәл күте тұрыңыз
Dialogue: 0,1:15:51.14,1:15:54.15,Default,,0,0,0,,Хамаджи-чан керемет еді, солай емес пе?
Dialogue: 0,1:15:55.03,1:15:57.65,Default,,0,0,0,,Менімен таңғы ас ішкіңіз келе ме?
Dialogue: 0,1:16:10.24,1:16:11.91,Default,,0,0,0,,Бізде әлі де қосымшалар бар.
Dialogue: 0,1:16:12.01,1:16:13.82,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,1:16:14.69,1:16:17.23,Default,,0,0,0,,Сізді алаңдатқаным үшін кешірім сұраймын.
Dialogue: 0,1:16:17.23,1:16:18.98,Default,,0,0,0,,Енді толық қалпына келтірілді
Dialogue: 0,1:16:20.05,1:16:23.12,Default,,0,0,0,,Бұл Мейдің атасы Бакин ата.
Dialogue: 0,1:16:23.62,1:16:27.29,Default,,0,0,0,,Танысқаныма қуаныштымын, сенің немереңнен түрлі өсек естідім.
Dialogue: 0,1:16:27.43,1:16:29.72,Default,,0,0,0,,Атам оқу кітабын жазып жатыр.
Dialogue: 0,1:16:29.81,1:16:32.90,Default,,0,0,0,,Иә, бұл Эдо тұрғындары арасында өте танымал.
Dialogue: 0,1:16:33.18,1:16:35.97,Default,,0,0,0,,Мен оқи алмаймын, сондықтан бұл туралы ештеңе білмеймін.
Dialogue: 0,1:16:36.16,1:16:38.40,Default,,0,0,0,,Мырза, сіз оқи аласыз ба?
Dialogue: 0,1:16:38.42,1:16:42.04,Default,,0,0,0,,Иә, оның орнына Мэйдо-чанға оқуын сұраймын.
Dialogue: 0,1:16:42.10,1:16:43.62,Default,,0,0,0,,Таро Хаккенден
Dialogue: 0,1:16:43.62,1:16:45.55,Default,,0,0,0,,Бака Сатоми Хаккенден
Dialogue: 0,1:16:46.38,1:16:48.51,Default,,0,0,0,,Кешіріңіз, ата.
Dialogue: 0,1:16:49.06,1:16:52.24,Default,,0,0,0,,Жоқ, кешірім сұрай аласыз.
Dialogue: 0,1:16:52.40,1:16:58.15,Default,,0,0,0,,Көруім нашарлағандықтан, маған осы жолда біреу жазып берді.
Dialogue: 0,1:16:58.67,1:17:00.33,Default,,0,0,0,,Мені кешіріңіз.
Dialogue: 0,1:17:02.62,1:17:05.83,Default,,0,0,0,,Оқымайды, жаза алмайды, доспыз.
Dialogue: 0,1:17:19.45,1:17:22.24,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,1:17:22.24,1:17:23.87,Default,,0,0,0,,Егер сіз маған айтқан болсаңыз!
Dialogue: 0,1:17:27.71,1:17:32.76,Default,,0,0,0,,Эй, екеуің бүгін Иесада-саманың ойын-сауық фестиваліне барасыңдар.
Dialogue: 0,1:17:32.93,1:17:35.00,Default,,0,0,0,,Сонымен қатар көптеген азық-түлік дүңгіршектері бар.
Dialogue: 0,1:17:35.00,1:17:36.66,Default,,0,0,0,,Не істеуіміз керек, Хамаджи-чан?
Dialogue: 0,1:17:36.66,1:17:37.98,Default,,0,0,0,,Эдо сарайының фестивалі
Dialogue: 0,1:17:38.21,1:17:39.14,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:17:39.14,1:17:43.95,Default,,0,0,0,,А, дұрыс. Онда кешегі Фукагава труппасы да өнер көрсетті.
Dialogue: 0,1:17:44.61,1:17:45.66,Default,,0,0,0,,Сол жігіт...
Dialogue: 0,1:17:51.24,1:17:53.48,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет.
Dialogue: 0,1:17:54.28,1:17:55.53,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,1:17:57.38,1:17:59.45,Default,,0,0,0,,Хамаджи-чан, қайда бара жатырсың?
Dialogue: 0,1:17:59.50,1:18:02.27,Default,,0,0,0,,Ақыры хатты қайда жіберу керектігін білдім.
Dialogue: 0,1:18:02.60,1:18:03.54,Default,,0,0,0,,Рахмет
Dialogue: 0,1:18:07.82,1:18:10.86,Default,,0,0,0,,Мен атамның қыңырлығын жер асты елінен алғанмын.
Dialogue: 0,1:18:11.44,1:18:12.82,Default,,0,0,0,,Жаға
Dialogue: 0,1:18:17.93,1:18:18.76,Default,,0,0,0,,Хамадзи
Dialogue: 0,1:18:20.36,1:18:21.08,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,1:18:27.27,1:18:27.88,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,1:18:28.76,1:18:31.63,Default,,0,0,0,,Мен де сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,1:18:33.46,1:18:36.52,Default,,0,0,0,,На Хамаджи мен ата-ана атандым.
Dialogue: 0,1:18:36.94,1:18:38.62,Default,,0,0,0,,Кеме құртының баласы болды.
Dialogue: 0,1:18:40.53,1:18:43.21,Default,,0,0,0,,Мүмкін мен әлі ата-ана сияқты емес шығармын.
Dialogue: 0,1:18:43.84,1:18:45.91,Default,,0,0,0,,Мен жақсы көрінгенімді қалаймын
Dialogue: 0,1:18:46.63,1:18:50.39,Default,,0,0,0,,Мен мұны істей аламын. Жақында ағамның жететініне сенімдімін.
Dialogue: 0,1:18:52.32,1:18:55.09,Default,,0,0,0,,Мен соңғысын байқадым.
Dialogue: 0,1:18:55.50,1:18:56.74,Default,,0,0,0,,Мен аңға шығамын
Dialogue: 0,1:18:57.74,1:18:58.74,Default,,0,0,0,,Сәлем Хамаджи
Dialogue: 0,1:19:00.58,1:19:02.93,Default,,0,0,0,,Мені өлтірме, маған кел
Dialogue: 0,1:19:03.95,1:19:05.56,Default,,0,0,0,,Мен сені жақсы көремін аға!
Dialogue: 0,1:19:28.48,1:19:30.69,Default,,0,0,0,,Бұл төңкерілген негізгі қоршау суының сатысы.
Dialogue: 0,1:19:30.69,1:19:33.84,Default,,0,0,0,,Бұл жаман, мен уже қобалжыдым.
Dialogue: 0,1:19:33.84,1:19:35.28,Default,,0,0,0,,Зәр шығаруға болмайды
Dialogue: 0,1:19:36.52,1:19:39.87,Default,,0,0,0,,Нағыз нәрсені қара, мен оны шатастырып аламын!
Dialogue: 0,1:19:40.34,1:19:42.93,Default,,0,0,0,,Мен байсалды емеспін, мен жай ғана мазақ етіп отырмын
Dialogue: 0,1:19:43.84,1:19:45.56,Default,,0,0,0,,Қараңдар!
Dialogue: 0,1:19:45.94,1:19:49.65,Default,,0,0,0,,Ол осындай керемет Хонмаруды арқасына алып жүру үшін батыл болуы керек.
Dialogue: 0,1:19:50.03,1:19:51.94,Default,,0,0,0,,Бүгін жақсы сахнаға шығайық.
Dialogue: 0,1:20:04.20,1:20:06.47,Default,,0,0,0,,Бұл не, Курохаку-сан?
Dialogue: 0,1:20:07.05,1:20:08.40,Default,,0,0,0,,Менің арқама жабысып қалды
Dialogue: 0,1:20:10.06,1:20:13.60,Default,,0,0,0,,Ақ қырлы көбелек Бұл жақсы нышан.
Dialogue: 0,1:20:14.18,1:20:15.50,Default,,0,0,0,,Сізде су бар ма?
Dialogue: 0,1:20:15.50,1:20:17.35,Default,,0,0,0,,Сіз бозарған сияқтысыз.
Dialogue: 0,1:20:17.66,1:20:19.01,Default,,0,0,0,,Мен кеше тым көп іштім
Dialogue: 0,1:20:24.31,1:20:27.33,Default,,0,0,0,,Сіз Фукагава труппасының мүшелерісіз бе?
Dialogue: 0,1:20:27.49,1:20:31.03,Default,,0,0,0,,А, иә, бүгін бізбен сөйлескеніңіз үшін рахмет.
Dialogue: 0,1:20:31.03,1:20:32.68,Default,,0,0,0,,Сізге алғысымды айта алмаймын.
Dialogue: 0,1:20:32.68,1:20:35.70,Default,,0,0,0,,Сіз өзін ақ-қара деп атайтын актерсіз.
Dialogue: 0,1:20:35.89,1:20:38.15,Default,,0,0,0,,Мен алғыс айтамын.
Dialogue: 0,1:20:38.35,1:20:40.39,Default,,0,0,0,,Әр адамның тартымдылығы
Dialogue: 0,1:20:40.67,1:20:42.99,Default,,0,0,0,,Сол адам соңғысы
Dialogue: 0,1:20:48.49,1:20:51.17,Default,,0,0,0,,Мені ұмыттың деп айтпа.
Dialogue: 0,1:20:53.13,1:20:55.31,Default,,0,0,0,,Қиындыққа тап болдым, солай сезінемін.
Dialogue: 0,1:20:55.48,1:20:57.88,Default,,0,0,0,,Курохаку мырза, сіз нені айтып тұрсыз?
Dialogue: 0,1:20:57.88,1:20:59.18,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,1:20:59.37,1:21:03.54,Default,,0,0,0,,Кешіріңіз, таныс мырза, біз спектакльді әлі бастаған жоқпыз.
Dialogue: 0,1:21:04.62,1:21:07.96,Default,,0,0,0,,Қарғыс атсын, пьеса бітті.
Dialogue: 0,1:21:09.12,1:21:09.92,Default,,0,0,0,,Oi сақтандырғыш
Dialogue: 0,1:21:10.23,1:21:12.38,Default,,0,0,0,,Мен бүгін мейірімді емеспін.
Dialogue: 0,1:21:12.60,1:21:14.43,Default,,0,0,0,,Бұл менің жолым
Dialogue: 0,1:21:14.65,1:21:18.13,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,1:21:31.28,1:21:32.63,Default,,0,0,0,,Жақын келме
Dialogue: 0,1:21:32.74,1:21:36.11,Default,,0,0,0,,Ақ пен қара, бетіңізді төмен түсірдіңіз бе?
Dialogue: 0,1:21:36.75,1:21:38.68,Default,,0,0,0,,Неліктен бас тарту керек?
Dialogue: 0,1:21:39.23,1:21:41.17,Default,,0,0,0,,Айтыңызшы, бұл да пьеса.
Dialogue: 0,1:21:41.75,1:21:43.63,Default,,0,0,0,,Соңына дейін итеріңіз
Dialogue: 0,1:21:45.06,1:21:48.10,Default,,0,0,0,,Содан кейін біз бірге болдық.
Dialogue: 0,1:21:48.93,1:21:52.96,Default,,0,0,0,,Өкінішке орай, пьеса аяқталды.
Dialogue: 0,1:21:55.31,1:21:59.26,Default,,0,0,0,,Қу, қу, ешқашан ішке кірме.
Dialogue: 0,1:22:05.01,1:22:09.43,Default,,0,0,0,,Шинбэй, мен сені қашан көретінімді сұраған сайын.
Dialogue: 0,1:22:09.87,1:22:13.41,Default,,0,0,0,,Кақаның жүрегіне жаңбыр жауа бастайды
Dialogue: 0,1:22:13.82,1:22:18.18,Default,,0,0,0,,Жаңбыр жауып, өкшенің іші тасып кете жаздаған кезде.
Dialogue: 0,1:22:18.57,1:22:21.67,Default,,0,0,0,,Мен сені тағы көремін деп үміттенемін.
Dialogue: 0,1:22:22.94,1:22:24.57,Default,,0,0,0,,Әрине
Dialogue: 0,1:22:24.70,1:22:27.58,Default,,0,0,0,,Менің ойымша, жаңбыр қуанышты көз жасына айналды
Dialogue: 0,1:22:28.24,1:22:33.43,Default,,0,0,0,,Эй Шинбэй, Йокогамада түсірілген дымқыл табақ суреті есімде.
Dialogue: 0,1:22:33.88,1:22:36.06,Default,,0,0,0,,Немесе мынаны қараңыз.
Dialogue: 0,1:22:36.33,1:22:39.51,Default,,0,0,0,,Дөңгелек маңдайың және мочи тәрізді щектерің
Dialogue: 0,1:22:39.79,1:22:42.69,Default,,0,0,0,,Күзгі жапырақтардай кішкентай қолдар есімде.
Dialogue: 0,1:22:43.37,1:22:45.07,Default,,0,0,0,,Қолымды жіберейін десем
Dialogue: 0,1:22:45.32,1:22:48.26,Default,,0,0,0,,Ақылды екенсің, үйректен сұрайсың.
Dialogue: 0,1:22:48.47,1:22:51.70,Default,,0,0,0,,Ей, енді қашан кездесеміз?
Dialogue: 0,1:22:55.67,1:22:56.70,Default,,0,0,0,,Хамадзи?
Dialogue: 0,1:23:08.11,1:23:09.45,Default,,0,0,0,,Сіз асығыссыз ба?
Dialogue: 0,1:23:09.91,1:23:11.26,Default,,0,0,0,,Мен оны сізге жіберемін.
Dialogue: 0,1:23:16.22,1:23:19.09,Default,,0,0,0,,Ойынның басталуына әлі жарты сағат бар.
Dialogue: 0,1:23:19.20,1:23:20.97,Default,,0,0,0,,Жарайды, уақытында үлгересің.
Dialogue: 0,1:23:20.97,1:23:21.89,Default,,0,0,0,,Иә
Dialogue: 0,1:23:23.84,1:23:28.41,Default,,0,0,0,,Маған да сол баланы ұстауға рұқсат етіңіз.
Dialogue: 0,1:23:28.55,1:23:29.44,Default,,0,0,0,,Бұрын
Dialogue: 0,1:23:31.60,1:23:35.50,Default,,0,0,0,,Бұл әлдеқашан әйелдік немесе еркектік.
Dialogue: 0,1:23:35.50,1:23:37.50,Default,,0,0,0,,Маған енді бұл маңызды емес.
Dialogue: 0,1:23:38.37,1:23:42.48,Default,,0,0,0,,Досецу мені сөгіп, өз сезімдеріңмен шын бол деді.
Dialogue: 0,1:23:42.48,1:23:44.78,Default,,0,0,0,,Сонда бұл қорқынышты болмайды.
Dialogue: 0,1:23:45.56,1:23:50.67,Default,,0,0,0,,Ағайыннан адалдық алсаң, қалғанының бәрі быт-шыт болары рас.
Dialogue: 0,1:23:52.16,1:23:54.78,Default,,0,0,0,,Мен ана болуға тырысамын
Dialogue: 0,1:23:56.23,1:23:58.29,Default,,0,0,0,,Орындалды, мен әйелге айналдым.
Dialogue: 0,1:23:58.99,1:23:59.74,Default,,0,0,0,,Иә
Dialogue: 0,1:24:08.95,1:24:11.11,Default,,0,0,0,,Алдымен Фунамуши мырза барады.
Dialogue: 0,1:24:11.43,1:24:12.67,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатырсыз.
Dialogue: 0,1:24:12.67,1:24:14.45,Default,,0,0,0,,Мен сізді пәтерде күтемін.
Dialogue: 0,1:24:14.45,1:24:15.69,Default,,0,0,0,,Рахмет
Dialogue: 0,1:24:16.29,1:24:18.88,Default,,0,0,0,,Әй, кимоно киюдің бәрі
Dialogue: 0,1:24:26.14,1:24:27.59,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,1:24:30.39,1:24:34.86,Default,,0,0,0,,Жаныңды жегім келсе, дұрыстап сапқа тұр.
Dialogue: 0,1:24:35.64,1:24:36.70,Default,,0,0,0,,Негізгі қоршауды енгізіңіз.
Dialogue: 0,1:24:36.95,1:24:39.57,Default,,0,0,0,,Шүкір, маған сол кепіл керек.
Dialogue: 0,1:24:39.57,1:24:41.66,Default,,0,0,0,,Атқыштар тобын қисық сызықтан алға тартыңыз.
Dialogue: 0,1:24:41.84,1:24:43.33,Default,,0,0,0,,Дегенмен, Абикен Бугио
Dialogue: 0,1:24:43.33,1:24:44.21,Default,,0,0,0,,Уа!!
Dialogue: 0,1:24:44.21,1:24:46.48,Default,,0,0,0,,Анна Санпинді алмастыратындар көп.
Dialogue: 0,1:24:51.66,1:24:55.34,Default,,0,0,0,,Тұрыс Оқ үшін жақсы
Dialogue: 0,1:24:55.84,1:25:00.20,Default,,0,0,0,,Қожайыныңыздың сатқындығы екеумізді аяймын.
Dialogue: 0,1:25:00.51,1:25:02.50,Default,,0,0,0,,Ит те үретін шығар.
Dialogue: 0,1:25:02.75,1:25:04.55,Default,,0,0,0,,Өкінішке орай, мен адаммын.
Dialogue: 0,1:25:04.77,1:25:06.61,Default,,0,0,0,,Мен сатқындыққа үйрендім.
Dialogue: 0,1:25:07.14,1:25:09.41,Default,,0,0,0,,Инуиягурадан шығатын артқы баспалдақтар
Dialogue: 0,1:25:09.76,1:25:11.36,Default,,0,0,0,,Иесада жоғарғы қабатта
Dialogue: 0,1:25:12.03,1:25:13.34,Default,,0,0,0,,Тез жүріңіз
Dialogue: 0,1:25:23.90,1:25:25.92,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,1:25:25.99,1:25:27.23,Default,,0,0,0,,Дайын
Dialogue: 0,1:25:28.55,1:25:31.63,Default,,0,0,0,,Қылышым Мен оны еш жерден көрмедім.
Dialogue: 0,1:25:37.05,1:25:38.04,Default,,0,0,0,,Алау
Dialogue: 0,1:25:38.04,1:25:38.86,Default,,0,0,0,,Су алыңыз
Dialogue: 0,1:25:38.86,1:25:40.63,Default,,0,0,0,,Адамның қолын тез шақыр.
Dialogue: 0,1:25:45.05,1:25:48.71,Default,,0,0,0,,Барып, толқынның көтерілуін күтіңіз.
Dialogue: 0,1:25:59.09,1:26:00.59,Default,,0,0,0,,Мен аң аулауға келдім
Dialogue: 0,1:26:01.15,1:26:02.36,Default,,0,0,0,,Польнарефф, рөл артында бәрі жақсы ма?
Dialogue: 0,1:26:10.01,1:26:13.74,Default,,0,0,0,,Қарғыс атсын, мен осылай ішке кіремін.
Dialogue: 0,1:26:13.96,1:26:15.43,Default,,0,0,0,,Тез атып өлтіріңіз
Dialogue: 0,1:26:15.43,1:26:17.96,Default,,0,0,0,,Абикен Бугио Бұл жерде ату қауіпті.
Dialogue: 0,1:26:18.13,1:26:20.35,Default,,0,0,0,,Фестивальге келушілерді эвакуациялаңыз...
Dialogue: 0,1:26:20.35,1:26:22.43,Default,,0,0,0,,Үндемей қал, мен сені кешіремін.
Dialogue: 0,1:26:22.53,1:26:24.88,Default,,0,0,0,,Жат, Хамаджидің олжасы, солай ма?
Dialogue: 0,1:26:25.02,1:26:25.82,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:26:26.23,1:26:27.80,Default,,0,0,0,,Адам бамбук инелігі
Dialogue: 0,1:26:27.92,1:26:30.37,Default,,0,0,0,,Парфюмердің ұлы күткендей.
Dialogue: 0,1:26:31.99,1:26:33.05,Default,,0,0,0,,Тұрыс
Dialogue: 0,1:26:33.54,1:26:35.03,Default,,0,0,0,,Магистратура
Dialogue: 0,1:26:35.93,1:26:38.25,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,1:26:47.18,1:26:48.39,Default,,0,0,0,,Абикен Бугио
Dialogue: 0,1:26:54.22,1:26:55.50,Default,,0,0,0,,Сәлем балалар
Dialogue: 0,1:27:42.25,1:27:44.72,Default,,0,0,0,,Садаққа ауыс, бейбақ.
Dialogue: 0,1:27:50.33,1:27:51.88,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:27:52.63,1:27:54.78,Default,,0,0,0,,Қолыңызды үстелге қоймаңыз
Dialogue: 0,1:27:55.17,1:27:57.15,Default,,0,0,0,,Ол менің олжам.
Dialogue: 0,1:27:57.42,1:27:58.84,Default,,0,0,0,,Әйел болса да аяма
Dialogue: 0,1:27:58.97,1:28:00.17,Default,,0,0,0,,Ату, ату
Dialogue: 0,1:28:00.17,1:28:01.19,Default,,0,0,0,,Матсуда мырза өледі.
Dialogue: 0,1:28:13.41,1:28:14.81,Default,,0,0,0,,Күтіңіз, күтіңіз
Dialogue: 0,1:28:15.05,1:28:16.36,Default,,0,0,0,,Эй, бұл Яфуса.
Dialogue: 0,1:28:16.98,1:28:19.09,Default,,0,0,0,,Апа, ол ақ-қара болуы керек.
Dialogue: 0,1:28:19.84,1:28:22.16,Default,,0,0,0,,Мен сарай орталығына барамын.
Dialogue: 0,1:28:22.62,1:28:23.98,Default,,0,0,0,,Менімен бармайды
Dialogue: 0,1:28:24.70,1:28:26.56,Default,,0,0,0,,Бірақ… ол ұзаққа созылмады
Dialogue: 0,1:28:29.78,1:28:31.67,Default,,0,0,0,,Жаңбыр шелегінен су әкеліңіз
Dialogue: 0,1:28:32.32,1:28:34.76,Default,,0,0,0,,Бұл өрт сөндіргіш. Тез өрт сөндіргішті шақырыңыз.
Dialogue: 0,1:28:34.76,1:28:35.97,Default,,0,0,0,,Қамал мұнарасындағы от бірінші болып шығады.
Dialogue: 0,1:28:35.97,1:28:37.74,Default,,0,0,0,,Оның одан әрі таралуына жол бермеңіз.
Dialogue: 0,1:28:37.98,1:28:39.82,Default,,0,0,0,,Өрт шығып жатыр. Тез қаш.
Dialogue: 0,1:28:39.82,1:28:41.58,Default,,0,0,0,,Өртті Сақтандырғыш бастаған сияқты.
Dialogue: 0,1:28:44.61,1:28:47.58,Default,,0,0,0,,Жалған заттар шығарылады Жалған заттар шығарылады
Dialogue: 0,1:28:47.70,1:28:50.10,Default,,0,0,0,,Иесада мырза, болт шешілді.
Dialogue: 0,1:28:50.17,1:28:52.54,Default,,0,0,0,,Өрт тарамай тұрып, сол жерден тез
Dialogue: 0,1:28:52.61,1:28:56.00,Default,,0,0,0,,Мен осында әңгіменің аяқталуын күтіп отырмын.
Dialogue: 0,1:28:56.60,1:28:58.88,Default,,0,0,0,,Қайсысы жалған екенін анықтауымыз керек.
Dialogue: 0,1:28:59.82,1:29:01.97,Default,,0,0,0,,Менің өмірім басталған жоқ
Dialogue: 0,1:29:11.50,1:29:16.08,Default,,0,0,0,,Тыныш қал, мен сені өлемін, қарғыс атқыр ит.
Dialogue: 0,1:29:18.32,1:29:21.57,Default,,0,0,0,,Мен қалай өлетінімді таңдауға рұқсат бермейсіз бе?
Dialogue: 0,1:29:27.59,1:29:32.23,Default,,0,0,0,,Жалғыз болу мен ойлағаннан да суық.
Dialogue: 0,1:30:04.86,1:30:05.54,Default,,0,0,0,,Кира мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,1:30:06.09,1:30:07.21,Default,,0,0,0,,Ол ауырады Ауырды
Dialogue: 0,1:30:08.76,1:30:11.17,Default,,0,0,0,,Егер сіз өрттен қорықсаңыз, т.б.
Dialogue: 0,1:30:11.92,1:30:14.37,Default,,0,0,0,,Оны тез өшіріңіз, құдыққа жүгіріңіз
Dialogue: 0,1:30:14.75,1:30:16.13,Default,,0,0,0,,Магистратура Сенсей
Dialogue: 0,1:30:17.03,1:30:21.16,Default,,0,0,0,,Егер сіз де самурай болсаңыз, оны алдымен әйелдер мен балаларға шешіңіз.
Dialogue: 0,1:30:21.43,1:30:23.39,Default,,0,0,0,,Бұл сізді жай ғана күйдіреді.
Dialogue: 0,1:30:23.44,1:30:27.07,Default,,0,0,0,,Токугаваға қарсы шыққан әйелдер мен балалар арасында ешқандай айырмашылық жоқ.
Dialogue: 0,1:30:27.26,1:30:29.19,Default,,0,0,0,,Егер сіз күйгенді ұнатпасаңыз
Dialogue: 0,1:30:30.19,1:30:32.31,Default,,0,0,0,,Мен бұтақтарды бір-бірімен бірге кесемін.
Dialogue: 0,1:30:33.14,1:30:34.06,Default,,0,0,0,,Әке
Dialogue: 0,1:30:34.25,1:30:35.87,Default,,0,0,0,,Оны елемеуге болмайды.
Dialogue: 0,1:30:38.22,1:30:40.97,Default,,0,0,0,,Шие гүлдері өздігінен түсуді күтіп тұр.
Dialogue: 0,1:30:41.58,1:30:44.02,Default,,0,0,0,,Самурай осылай өмір сүрсе
Dialogue: 0,1:30:44.72,1:30:46.54,Default,,0,0,0,,Бұл шынымен сұмдық.
Dialogue: 0,1:30:49.56,1:30:53.14,Default,,0,0,0,,Ішіндегі Фушиден құтылған ронин.
Dialogue: 0,1:30:53.91,1:30:55.10,Default,,0,0,0,,Қызықты
Dialogue: 0,1:30:55.51,1:30:57.35,Default,,0,0,0,,сағындым
Dialogue: 0,1:31:01.68,1:31:03.27,Default,,0,0,0,,Жол…До-буши
Dialogue: 0,1:31:03.86,1:31:05.41,Default,,0,0,0,,Енді бөлуге болмайды
Dialogue: 0,1:31:06.30,1:31:11.68,Default,,0,0,0,,Бұдан былай төлесең де, алсаң да бірден мақсат етейік.
Dialogue: 0,1:31:11.68,1:31:12.74,Default,,0,0,0,,бірақ бұл қауіпті.
Dialogue: 0,1:31:28.26,1:31:30.57,Default,,0,0,0,,Уайымдама, сен арқаңдасың.
Dialogue: 0,1:31:30.77,1:31:32.82,Default,,0,0,0,,Йо, тұрғын үйдің кейіпкері.
Dialogue: 0,1:31:32.82,1:31:33.75,Default,,0,0,0,,Досецу
Dialogue: 0,1:31:33.98,1:31:37.60,Default,,0,0,0,,Барлық қақпаларды ашыңдар, бәріміз ордағы суды тасайық
Dialogue: 0,1:31:37.60,1:31:41.33,Default,,0,0,0,,Қала тұрғындарынан тапсырыс аламын деп ойлайсың ба?
Dialogue: 0,1:31:41.33,1:31:42.78,Default,,0,0,0,,Бұл керемет бейбақ!
Dialogue: 0,1:31:44.15,1:31:48.47,Default,,0,0,0,,Бұл адамдарды ажырататын уақыт емес шығар.
Dialogue: 0,1:31:51.86,1:31:53.08,Default,,0,0,0,,Тасымалдау
Dialogue: 0,1:31:55.07,1:31:55.90,Default,,0,0,0,,Жел...
Dialogue: 0,1:31:56.00,1:31:57.86,Default,,0,0,0,,Өртке көмектеседі
Dialogue: 0,1:31:57.97,1:31:59.39,Default,,0,0,0,,Мырзалар, маған да көмектесіңізші.
Dialogue: 0,1:31:59.39,1:32:00.12,Default,,0,0,0,,О
Dialogue: 0,1:32:19.34,1:32:21.18,Default,,0,0,0,,Шино
Dialogue: 0,1:32:27.62,1:32:29.67,Default,,0,0,0,,Шино
Dialogue: 0,1:32:50.26,1:32:54.01,Default,,0,0,0,,Мурасамемару-сама мені таңдады.
Dialogue: 0,1:33:36.58,1:33:38.78,Default,,0,0,0,,Фуши но Мориге қош келдіңіз
Dialogue: 0,1:33:46.72,1:33:48.95,Default,,0,0,0,,Сіз ең соңғысысыз
Dialogue: 0,1:33:49.59,1:33:52.44,Default,,0,0,0,,«Бір» деп жауап берсем, қуанасың ба?
Dialogue: 0,1:33:53.19,1:33:54.97,Default,,0,0,0,,Мен сенімен әрқашан кездескім келеді
Dialogue: 0,1:33:55.31,1:33:57.43,Default,,0,0,0,,Ақ шаш, өте әдемі
Dialogue: 0,1:33:57.92,1:34:01.08,Default,,0,0,0,,Мен сенің өмірлік жаныңды жесем, одан да жылтыр болады.
Dialogue: 0,1:34:01.68,1:34:04.63,Default,,0,0,0,,Енді осы себеп-салдарды аяқтайық.
Dialogue: 0,1:34:04.86,1:34:07.32,Default,,0,0,0,,Әй, жұлып алсаң, шарлар шашылып қалады.
Dialogue: 0,1:34:09.78,1:34:13.55,Default,,0,0,0,,Әділдік жүзі Басыңды кесіп алайын.
Dialogue: 0,1:34:24.96,1:34:26.70,Default,,0,0,0,,Оны жойыңыз
Dialogue: 0,1:34:28.77,1:34:31.82,Default,,0,0,0,,Ол кезде қызым иттің баласына жүкті еді.
Dialogue: 0,1:34:32.11,1:34:34.05,Default,,0,0,0,,Бұл қате болды.
Dialogue: 0,1:34:34.05,1:34:36.40,Default,,0,0,0,,Сол үшін менің жолдастарымды өлтірдің бе?
Dialogue: 0,1:34:36.84,1:34:37.98,Default,,0,0,0,,Оны қабылдаңыз.
Dialogue: 0,1:34:37.98,1:34:40.10,Default,,0,0,0,,Сонда болашақ қорқынышты болмайды
Dialogue: 0,1:34:40.10,1:34:41.76,Default,,0,0,0,,Тыныш, жалған
Dialogue: 0,1:34:56.40,1:34:58.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:34:59.58,1:35:04.19,Default,,0,0,0,,Балалар сендер бастапқыда қателіктен тудыңдар.
Dialogue: 0,1:35:04.50,1:35:09.73,Default,,0,0,0,,Бұл дүниеде ешнәрсе қателіктен тумайды.
Dialogue: 0,1:35:19.15,1:35:22.72,Default,,0,0,0,,Мені тек осы пышақ таңдады
Dialogue: 0,1:35:23.88,1:35:27.04,Default,,0,0,0,,Тіпті мен де халыққа көмектесуге тырысамын.
Dialogue: 0,1:35:27.48,1:35:29.24,Default,,0,0,0,,Егер мені жалғандық үшін өлтірсең
Dialogue: 0,1:35:30.22,1:35:32.81,Default,,0,0,0,,Сіз генерал сияқты бола аламын деп ойладыңыз ба?
Dialogue: 0,1:35:33.40,1:35:34.31,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,1:35:36.84,1:35:39.74,Default,,0,0,0,,Сол өмірді шынайы нәрсеге арнайық.
Dialogue: 0,1:35:51.49,1:35:53.25,Default,,0,0,0,,Бұл түсініксіз.
Dialogue: 0,1:35:53.69,1:35:56.07,Default,,0,0,0,,Үмітсіз өмір сүру - бұл шынайы нәрсе
Dialogue: 0,1:36:00.96,1:36:05.23,Default,,0,0,0,,Тіпті мен қамалда жатып, халыққа жатамын.
Dialogue: 0,1:36:09.42,1:36:11.05,Default,,0,0,0,,Өзіңізді де тастаңыз
Dialogue: 0,1:36:17.00,1:36:17.91,Default,,0,0,0,,Қажет емес
Dialogue: 0,1:36:18.79,1:36:22.59,Default,,0,0,0,,Тірі жаныңды жесем, Өзім бейшара боламын.
Dialogue: 0,1:36:41.14,1:36:44.33,Default,,0,0,0,,Мен сіздің қолжазбаларыңызды жүктеп қойғанмын.
Dialogue: 0,1:36:44.33,1:36:45.85,Default,,0,0,0,,Жер асты әлеміне шақыру
Dialogue: 0,1:36:49.19,1:36:51.83,Default,,0,0,0,,От келе жатыр, әке, тез.
Dialogue: 0,1:36:51.88,1:36:54.88,Default,,0,0,0,,Оқыған кітаптарыңызды өртеп жіберіңіз, т.б.
Dialogue: 0,1:36:55.56,1:37:01.38,Default,,0,0,0,,Мен Хаккенден деген кітапта Фушиге әділдік ретінде қарағым келді.
Dialogue: 0,1:37:01.38,1:37:04.22,Default,,0,0,0,,Мен өзіме орын жасағым келді.
Dialogue: 0,1:37:04.64,1:37:05.73,Default,,0,0,0,,Бірақ
Dialogue: 0,1:37:08.18,1:37:15.30,Default,,0,0,0,,Әңгімені қанша жазуға тырыссам да, бұл ойдан шығарылған нәрсе ғой.
Dialogue: 0,1:37:18.71,1:37:20.22,Default,,0,0,0,,От тез қозғалады
Dialogue: 0,1:37:20.22,1:37:23.22,Default,,0,0,0,,Кешіріңіздер, барлығыңыз.
Dialogue: 0,1:37:21.48,1:37:23.17,Default,,0,0,0,,Мен оны қажетсіз өлуіне жол бермеймін!
Dialogue: 0,1:37:28.91,1:37:30.23,Default,,0,0,0,,Жүгіру, жүгіру
Dialogue: 0,1:37:31.24,1:37:32.22,Default,,0,0,0,,Шегіну, шегіну
Dialogue: 0,1:37:32.22,1:37:33.62,Default,,0,0,0,,Мен сонда қашып кеттім.
Dialogue: 0,1:37:33.90,1:37:35.53,Default,,0,0,0,,Қорықпа
Dialogue: 0,1:37:56.31,1:37:57.09,Default,,0,0,0,,...
Dialogue: 0,1:38:14.00,1:38:17.36,Default,,0,0,0,,Қош бол, менің жақындарым
Dialogue: 0,1:38:18.64,1:38:23.21,Default,,0,0,0,,Мен сарайдан алыс тұрамын
Dialogue: 0,1:38:29.25,1:38:31.45,Default,,0,0,0,,Амон, ол жігіт қауіпті.
Dialogue: 0,1:38:35.46,1:38:36.75,Default,,0,0,0,,Теппо мұражайы
Dialogue: 0,1:38:37.06,1:38:40.10,Default,,0,0,0,,Хокаку мен Шинбэй тірі жанды жемеген.
Dialogue: 0,1:38:40.35,1:38:44.52,Default,,0,0,0,,Бірге шыдаңдар деп хатпен бір-бірімізді жігерлендірдік.
Dialogue: 0,1:38:46.28,1:38:48.57,Default,,0,0,0,,Шинода бұл болуы керек.
Dialogue: 0,1:38:50.51,1:38:54.90,Default,,0,0,0,,Асығыңыз, артық емес, аяқ шегі
Dialogue: 0,1:39:02.42,1:39:07.47,Default,,0,0,0,,Шино мен үшін тірі жанды жеуге шыдаған шығар.
Dialogue: 0,1:39:08.32,1:39:12.08,Default,,0,0,0,,Менің ойымша, сіз маған пьесадан кейін соны айту үшін қоңырау шалдыңыз.
Dialogue: 0,1:39:12.74,1:39:14.06,Default,,0,0,0,,Мені жалғыз қалдырыңыз.
Dialogue: 0,1:39:14.75,1:39:18.13,Default,,0,0,0,,Мен жалғызбын, бәрібір өлемін.
Dialogue: 0,1:39:18.85,1:39:22.43,Default,,0,0,0,,Тірі қалғаныңыз үшін өзіңізді кінәлі сезінбеңіз
Dialogue: 0,1:39:31.15,1:39:32.96,Default,,0,0,0,,Шино мен сені сүйемін
Dialogue: 0,1:39:35.22,1:39:40.99,Default,,0,0,0,,Егер бұл қатты ауырса, сен менің өмірімді жей аласың.
Dialogue: 0,1:39:48.55,1:39:52.00,Default,,0,0,0,,Менімен мәңгі байланыста боласың ба?
Dialogue: 0,1:39:52.69,1:39:54.94,Default,,0,0,0,,Иә, мен сені енді өлтірмеймін.
Dialogue: 0,1:39:55.76,1:39:58.27,Default,,0,0,0,,Мен сені осылай жақсы көремін
Dialogue: 0,1:40:14.16,1:40:16.67,Default,,0,0,0,,Қазір сахнаны жойыңыз.
Dialogue: 0,1:40:16.67,1:40:17.99,Default,,0,0,0,,Өрттің таралуын болдырмау
Dialogue: 0,1:40:18.30,1:40:19.43,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,1:40:19.71,1:40:20.84,Default,,0,0,0,,Мурасаме
Dialogue: 0,1:40:24.42,1:40:25.80,Default,,0,0,0,,Аспан жылап тұр
Dialogue: 0,1:40:26.36,1:40:28.24,Default,,0,0,0,,Бұл қуаныштан жылау деп аталады.
Dialogue: 0,1:40:30.87,1:40:32.76,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,1:41:11.70,1:41:12.83,Default,,0,0,0,,Хамадзи-чан
Dialogue: 0,1:41:19.00,1:41:20.29,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,1:41:21.39,1:41:24.15,Default,,0,0,0,,Біз осында танысып, осы жерде ажырастық
Dialogue: 0,1:41:24.80,1:41:26.75,Default,,0,0,0,,Менің ойымша, ол қайтып келеді.
Dialogue: 0,1:41:28.16,1:41:31.73,Default,,0,0,0,,Эй, Мейдо, сен маған жазуды үйретпейсің.
Dialogue: 0,1:41:32.05,1:41:32.83,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:41:33.08,1:41:34.43,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,1:41:35.15,1:41:38.73,Default,,0,0,0,,Мен оған хат жазуды ойладым.
Dialogue: 0,1:41:46.75,1:41:48.41,Default,,0,0,0,,Қарашы, Хамадзи-чан
Dialogue: 0,1:41:49.17,1:41:50.20,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,1:42:03.87,1:42:07.41,Default,,0,0,0,,Жер асты әлемі, тез дайындал.
Dialogue: 0,1:42:07.41,1:42:09.04,Default,,0,0,0,,Сыртқа шығатын уақыт келді.
Dialogue: 0,1:42:09.11,1:42:11.77,Default,,0,0,0,,Алда болыңыз, мен жақында жетемін.
Dialogue: 0,1:42:17.57,1:42:20.43,Default,,0,0,0,,Себеп-салдар Себеп-салдар
Dialogue: 0,1:42:21.43,1:42:24.57,Default,,0,0,0,,Себеп - заттардың басы, ал салдар - соңы.
Dialogue: 0,1:42:25.20,1:42:29.49,Default,,0,0,0,,Екеуі бірігіп әңгіме құрастырады.
Dialogue: 0,1:42:30.01,1:42:34.49,Default,,0,0,0,,Аа, мен соңды ойлай алмаймын.
Dialogue: 0,1:42:37.91,1:42:40.73,Default,,0,0,0,,Фунамуши мейрамхана ашады
Dialogue: 0,1:42:41.12,1:42:43.77,Default,,0,0,0,,Хамама оралған үлпілдек жұмыртқа танымал болды.
Dialogue: 0,1:42:43.85,1:42:46.86,Default,,0,0,0,,Қазір тіпті әйгілі сарайлар мен храмдар бар.
Dialogue: 0,1:42:47.08,1:42:48.71,Default,,0,0,0,,Мен күнде өте бос емеспін.
Dialogue: 0,1:42:49.27,1:42:51.61,Default,,0,0,0,,Ей, балалар, жақынырақ келіңдер.
Dialogue: 0,1:42:51.61,1:42:54.82,Default,,0,0,0,,Қарамайды Қарамайды Жалайды
Dialogue: 0,1:42:54.87,1:42:56.17,Default,,0,0,0,,Онға дейін сана
Dialogue: 0,1:42:56.25,1:42:56.95,Default,,0,0,0,,Иә
Dialogue: 0,1:42:57.64,1:43:09.49,Default,,0,0,0,,Бір екі үш төрт бес алты жеті сегіз тоғыз он
Dialogue: 0,1:43:03.24,1:43:04.60,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,1:43:04.96,1:43:06.59,Default,,0,0,0,,Иә, қозғалма.
Dialogue: 0,1:43:09.87,1:43:10.90,Default,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,1:43:13.05,1:43:14.51,Default,,0,0,0,,Офицер алмаса да.
Dialogue: 0,1:43:14.74,1:43:19.29,Default,,0,0,0,,Конмичи Сецу - екі қылышы бар самурай: бамбук инелігі және денден барабаны.
Dialogue: 0,1:43:33.82,1:43:36.89,Default,,0,0,0,,Отшашу басталғанша ше, сэр?
Dialogue: 0,1:43:38.02,1:43:39.63,Default,,0,0,0,,Бір жұтым алкоголь және т.б.
Dialogue: 0,1:43:39.63,1:43:40.76,Default,,0,0,0,,Инкогнито.
Dialogue: 0,1:43:41.37,1:43:43.41,Default,,0,0,0,,Бұл қызықтырақ па?
Dialogue: 0,1:43:43.58,1:43:44.74,Default,,0,0,0,,Мен оны аламын ба?
Dialogue: 0,1:43:47.55,1:43:50.40,Default,,0,0,0,,Мен оны бір күні шеше алғым келеді
Dialogue: 0,1:43:54.35,1:43:56.34,Default,,0,0,0,,Жүр, маған сусын құй.
Dialogue: 0,1:43:58.22,1:44:01.45,Default,,0,0,0,,Эдо мамандығы Өрт пен шайқас басылғаннан кейін
Dialogue: 0,1:44:01.84,1:44:04.76,Default,,0,0,0,,Токугава әлемі тағы да бейбітшілікке оралды.
Dialogue: 0,1:44:05.32,1:44:09.52,Default,,0,0,0,,Сегізіншісі мықтап ұсталды, мойыны ашылды.
Dialogue: 0,1:44:09.76,1:44:14.93,Default,,0,0,0,,Жарайды, менің көзіме қорқынышты бас кесу сияқты көрінеді.
Dialogue: 0,1:44:15.04,1:44:20.23,Default,,0,0,0,,Адамдардың қасында иттер әрқашан болады деп сенемін.
Dialogue: 0,1:44:20.65,1:44:23.99,Default,,0,0,0,,Ал, мен әңгіменің қалған бөлігін жазамын.
Dialogue: 0,1:44:25.10,1:44:30.15,Default,,0,0,0,,Көркем әдебиет пен шындықтың арасында алға-артқа жүруге бел байлау керек.
Dialogue: 0,1:44:31.09,1:44:33.33,Default,,0,0,0,,Мен дайынмын.
Dialogue: 0,1:44:45.65,1:44:46.86,Default,,0,0,0,,Онда болды
Dialogue: 0,1:44:49.52,1:44:53.14,Default,,0,0,0,,Ақыр аяғында ол сол жерге тағы өрмелеп келе жатқан.
Dialogue: 0,1:44:55.76,1:44:58.33,Default,,0,0,0,,Әңгіме дегеніміз не? Ерекше түрлер? Қызықты оқиға?
Dialogue: 0,1:44:59.52,1:45:02.45,Default,,0,0,0,,Уақытыңды босқа өткізбе, тез айт, Хамаджи-чан.
Dialogue: 0,1:45:03.11,1:45:04.66,Default,,0,0,0,,Неліктен тақтайшаларға жазуға болмайды?
Dialogue: 0,1:45:04.82,1:45:08.05,Default,,0,0,0,,Мен жазбаймын Мен жазбаймын Мен ешқашан жазған емеспін
Dialogue: 0,1:45:12.56,1:45:14.82,Default,,0,0,0,,Мен Шинодан жауап алдым.
Dialogue: 0,1:45:20.60,1:45:21.59,Default,,0,0,0,,Бұл басталды
Dialogue: 0,1:45:51.73,1:45:53.44,Default,,0,0,0,,Фушиден хат келді.
Dialogue: 0,1:45:53.97,1:45:56.78,Default,,0,0,0,,Бұл оқырманның нәтижесі.
Dialogue: 0,1:45:57.34,1:45:59.44,Default,,0,0,0,,Иә Жабу
Dialogue: 0,1:44:13.63,1:44:20.18,Default,,0,0,0,,Қазір жыла, тек жыла
Dialogue: 0,1:44:20.84,1:44:28.33,Default,,0,0,0,,Өзіңді аспаннан лақтырғандай
Dialogue: 0,1:44:28.41,1:44:37.91,Default,,0,0,0,,Тағдыр біздің басымызға түсті
Dialogue: 0,1:44:38.19,1:44:44.43,Default,,0,0,0,,Мен жеңілуден шаршадым.
Dialogue: 0,1:44:45.29,1:44:51.26,Default,,0,0,0,,Адам жасаған бычий
Dialogue: 0,1:44:51.26,1:45:05.79,Default,,0,0,0,,Қайтып кетпес үшін оны дұрыстап байлаңыз.
Dialogue: 0,1:45:06.04,1:45:11.59,Default,,0,0,0,,Жіптің екінші жағына өтейік
Dialogue: 0,1:45:12.31,1:45:19.96,Default,,0,0,0,,Егер күте алмасаңыз, ол қайтадан жоғалады, иә
Dialogue: 0,1:45:20.29,1:45:25.90,Default,,0,0,0,,Шындық осында.
Dialogue: 0,1:45:26.45,1:45:34.27,Default,,0,0,0,,Мен сені көруге қайтамын, болды.
Dialogue: 0,1:45:34.82,1:45:41.01,Default,,0,0,0,,Мен жеңілуден шаршадым.
Dialogue: 0,1:45:41.87,1:45:47.83,Default,,0,0,0,,Отшашу әдемі түсті.
Dialogue: 0,1:45:48.19,1:46:00.13,Default,,0,0,0,,Саған бергім келгені ғана қалды, о
Dialogue: 0,1:46:02.53,1:46:08.11,Default,,0,0,0,,Жіптің екінші жағына өтейік
Dialogue: 0,1:46:08.75,1:46:16.18,Default,,0,0,0,,Шыдай алмасаң, қайта құлайсың иә
Dialogue: 0,1:46:16.70,1:46:32.14,Default,,0,0,0,,Шынымды айтсам, махаббаттан адасып қалдым, болды.
Dialogue: 0,1:46:32.83,1:46:38.88,Default,,0,0,0,,ой жылама, ақырын
Dialogue: 0,1:46:39.93,1:46:48.75,Default,,0,0,0,,Мен сенің жүрегіңдегі әдемі және мұңды нәрселерді санаймын
Dialogue: 0,1:46:51.09,1:46:55.82,Default,,0,0,0,,Төгілмейтіндей етіп жабуға бола ма?
Dialogue: 0,1:46:59.58,1:47:12.61,Default,,0,0,0,,Енді тоқтаңыз, мен саусақ кесудің мұндай түріне сенімді емеспін.
Dialogue: 0,1:47:12.75,1:47:23.80,Default,,0,0,0,,Аспанға алыс жерге ұшпа
Dialogue: 0,1:47:24.05,1:47:30.63,Default,,0,0,0,,Мен қозғала бастадым, қорықпаймын
Dialogue: 0,1:47:31.15,1:47:37.20,Default,,0,0,0,,Сізбен өмір сүру қиын емес.
Dialogue: 0,1:47:37.50,1:47:51.07,Default,,0,0,0,,Мен білмеймін. Мен сізге жете алмаймын. Менің сенімен болғым келеді.
Dialogue: 0,1:47:51.18,1:47:57.56,Default,,0,0,0,,Маған үлкен аяқ киімімді тағы да киюге рұқсат етіңіз
Dialogue: 0,1:47:57.70,1:48:11.18,Default,,0,0,0,,Аяқтың ұшымен тұрып сені бір жерде көргім келеді.
Dialogue: 0,1:48:11.18,1:48:18.20,Default,,0,0,0,,Күйреуге жақын сезімдер
Dialogue: 0,1:48:18.28,1:48:33.33,Default,,0,0,0,,Барлық әдемі нәрселерді сол әлеммен байланыстырыңыз
Dialogue: 0,1:48:39.66,1:48:45.79,Default,,0,0,0,,Жылама, мен ақырын санадым
Dialogue: 0,1:48:47.56,1:48:52.26,Default,,0,0,0,,Жүрегімдегі тесіктің ортасында
Dialogue: 0,1:48:54.63,1:48:59.72,Default,,0,0,0,,Оны саусақтармен жабуға болады ма?
Dialogue: 0,1:49:01.54,1:49:06.51,Default,,0,0,0,,Сол арманның төгіліп кетуіне жол берме
Dialogue: 0,1:49:08.83,1:49:13.64,Default,,0,0,0,,Оны саусақтармен жабуға болады ма?
Dialogue: 0,1:49:25.49,1:49:29.55,Default,,0,0,0,,Қайырлы түн, бас қосайық, махаббат.
Dialogue: 0,1:49:31.05,1:49:37.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
