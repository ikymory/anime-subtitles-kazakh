Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.54,0:01:28.54,Default,,0,0,0,,~♪
Dialogue: 0,0:01:33.80,0:01:36.88,Default,,0,0,0,,Өлген жоқ, жай ғана шал.
Dialogue: 0,0:01:36.97,0:01:39.30,Default,,0,0,0,,Осы деңгейде? Оны емдеуге болады ма?
Dialogue: 0,0:01:39.39,0:01:40.64,Default,,0,0,0,,Қазір...
Dialogue: 0,0:01:45.89,0:01:46.69,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:01:46.77,0:01:50.48,Default,,0,0,0,,Гехо Гехо Гехо Гехо...
Dialogue: 0,0:01:51.19,0:01:53.78,Default,,0,0,0,,Жарайды, емделіп кеткен сияқтысың.
Dialogue: 0,0:01:56.82,0:02:00.70,Default,,0,0,0,,Сіз толығымен жойылдыңыз ба? біз...
Dialogue: 0,0:02:00.78,0:02:02.99,Default,,0,0,0,,Ах! Менде алқа жоқ
Dialogue: 0,0:02:03.08,0:02:05.33,Default,,0,0,0,,Ах! менің тиыным да
Dialogue: 0,0:02:05.41,0:02:07.50,Default,,0,0,0,,Барлық әшекейлер де жоғалып кетті.
Dialogue: 0,0:02:08.17,0:02:10.54,Default,,0,0,0,,Кейбір заттарыңыз жоғалып кетті
Dialogue: 0,0:02:10.63,0:02:11.96,Default,,0,0,0,,Сіз ештеңе білмейсіз бе?
Dialogue: 0,0:02:12.54,0:02:14.76,Default,,0,0,0,,Бұл сөзсіз қазына жәндігі.
Dialogue: 0,0:02:14.84,0:02:15.67,Default,,0,0,0,,Тынш!
Dialogue: 0,0:02:15.76,0:02:17.63,Default,,0,0,0,,Ал, мен білмеймін.
Dialogue: 0,0:02:17.72,0:02:20.72,Default,,0,0,0,,Сен осында сап түзеп жаттың.
Dialogue: 0,0:02:20.80,0:02:24.47,Default,,0,0,0,,Бұл жерден бізден бұрын өткен адамдар болса керек.
Dialogue: 0,0:02:25.77,0:02:26.81,Default,,0,0,0,,Шаш…
Dialogue: 0,0:02:27.85,0:02:29.48,Default,,0,0,0,,Аруақтардан сақтандыратын сиқыр.
Dialogue: 0,0:02:29.98,0:02:32.61,Default,,0,0,0,,Сізге біреу хабарласқаны анық сияқты.
Dialogue: 0,0:02:32.69,0:02:33.23,Default,,0,0,0,,Иә
Dialogue: 0,0:02:33.32,0:02:35.73,Default,,0,0,0,,（）
Dialogue: 0,0:02:35.82,0:02:36.74,Default,,0,0,0,,Эльф…
Dialogue: 0,0:02:37.32,0:02:38.70,Default,,0,0,0,,Таллман
Dialogue: 0,0:02:39.32,0:02:42.24,Default,,0,0,0,,Жарты аяқ… Гном…
Dialogue: 0,0:02:42.95,0:02:44.99,Default,,0,0,0,,Мына жігіттер тамақ ішіп отыр.
Dialogue: 0,0:02:45.08,0:02:48.37,Default,,0,0,0,,Тамақ? Сізде қандай жүйке бар?
Dialogue: 0,0:02:48.46,0:02:49.37,Default,,0,0,0,,Мен сені қуамын
Dialogue: 0,0:02:49.46,0:02:51.50,Default,,0,0,0,,- (Жинаушы А) Тоқта - (Кабуру) Әй?
Dialogue: 0,0:02:52.08,0:02:53.50,Default,,0,0,0,,Бұл қайырымдылық емес.
Dialogue: 0,0:02:56.59,0:02:57.46,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:02:57.55,0:02:58.76,Default,,0,0,0,,Мен шын мәнінде айта алмаймын.
Dialogue: 0,0:03:00.84,0:03:03.01,Default,,0,0,0,,Неліктен бізге жасыру керек...
Dialogue: 0,0:03:03.10,0:03:06.85,Default,,0,0,0,,Мәйіт неғұрлым көп болса, соғұрлым жақсы.
Dialogue: 0,0:03:07.60,0:03:09.52,Default,,0,0,0,,(Су дыбысы)
Dialogue: 0,0:03:11.35,0:03:14.77,Default,,0,0,0,,Ах~ Мен шашымды тез жуғым келеді.
Dialogue: 0,0:03:14.86,0:03:16.78,Default,,0,0,0,,Оны шабсаң, сергек боласың.
Dialogue: 0,0:03:16.86,0:03:19.57,Default,,0,0,0,,Сіз тағы да осындай дөрекі сөздер айтып отырсыз.
Dialogue: 0,0:03:20.07,0:03:22.57,Default,,0,0,0,,Тіпті Сенші сақалын жуғысы келеді, солай ма?
Dialogue: 0,0:03:24.37,0:03:27.87,Default,,0,0,0,,Сіз қанша уақыттан бері киіміңізді жумайсыз? Қазір жуыңыз!
Dialogue: 0,0:03:28.95,0:03:31.79,Default,,0,0,0,,Сиқырда шаштың да маңызы зор
Dialogue: 0,0:03:31.87,0:03:35.54,Default,,0,0,0,,Оны күту денені қыздыру жаттығуымен бірдей.
Dialogue: 0,0:03:35.63,0:03:39.38,Default,,0,0,0,,Мұндай сақалмен менің тірек сиқырым жұмыс істемеуі мүмкін.
Dialogue: 0,0:03:39.46,0:03:40.92,Default,,0,0,0,,Мен бұл үшін ризамын.
Dialogue: 0,0:03:41.01,0:03:44.30,Default,,0,0,0,,Иә, менде жақсы сабын бар.
Dialogue: 0,0:03:44.89,0:03:47.35,Default,,0,0,0,,Олай болса сақалыңды жуып, өремін.
Dialogue: 0,0:03:50.06,0:03:52.81,Default,,0,0,0,,Иә? иә? Жоқ.
Dialogue: 0,0:03:52.90,0:03:53.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:54.52,0:03:56.69,Default,,0,0,0,,Түсіндім, сол кезде...
Dialogue: 0,0:03:56.77,0:03:59.86,Default,,0,0,0,,Міне! Қымбат болғанымен
Dialogue: 0,0:03:59.94,0:04:01.20,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:04:02.57,0:04:03.95,Default,,0,0,0,,4-ші жертөле қабаты
Dialogue: 0,0:04:04.03,0:04:07.12,Default,,0,0,0,,Ойылған тау жыныстарынан шығатын жер асты сулары
Dialogue: 0,0:04:07.20,0:04:09.16,Default,,0,0,0,,Көл құрайды
Dialogue: 0,0:04:10.33,0:04:13.71,Default,,0,0,0,,Құрамында сиқырлы күш бар су әлсіз жарқырайды.
Dialogue: 0,0:04:13.79,0:04:18.71,Default,,0,0,0,,Су түбінде көрінетін қамал қалашығы елес сияқты тербеледі.
Dialogue: 0,0:04:19.88,0:04:22.97,Default,,0,0,0,,Сенши әдетте 4-қабатты қалай зерттейді?
Dialogue: 0,0:04:23.05,0:04:27.97,Default,,0,0,0,,Бұл жерде балық аулау және аулау... Бұл туралы.
Dialogue: 0,0:04:28.56,0:04:30.97,Default,,0,0,0,,Балалар, сендер оған қалай жетесіңдер?
Dialogue: 0,0:04:31.06,0:04:33.85,Default,,0,0,0,,Әрине, бұл жерде сиқыр пайда болады.
Dialogue: 0,0:04:33.94,0:04:36.44,Default,,0,0,0,,Осылай орындаңыз...
Dialogue: 0,0:04:37.73,0:04:38.73,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:04:40.73,0:04:42.90,Default,,0,0,0,,Суда жүру
Dialogue: 0,0:04:42.99,0:04:45.07,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:45.16,0:04:45.99,Default,,0,0,0,,Ггаааах!
Dialogue: 0,0:04:46.07,0:04:47.99,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:04:48.08,0:04:50.24,Default,,0,0,0,,Маған ұнамайды! Маған ұнамайды~ Маған ұнамайды~
Dialogue: 0,0:04:50.33,0:04:51.75,Default,,0,0,0,,Оны сонша жек көрмесең де
Dialogue: 0,0:04:51.83,0:04:53.96,Default,,0,0,0,,-Маған ұнамайды- -Ой, жоқ.
Dialogue: 0,0:04:54.04,0:04:55.87,Default,,0,0,0,,Арқанды ілмектеп, тартайық.
Dialogue: 0,0:04:55.96,0:04:57.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:57.08,0:04:59.63,Default,,0,0,0,,Мен оны басып тұрғанда сиқырлы!
Dialogue: 0,0:04:59.71,0:05:00.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:00.34,0:05:01.88,Default,,0,0,0,,Құрышта... Уф
Dialogue: 0,0:05:01.96,0:05:05.26,Default,,0,0,0,,Бұл сауытпен судан өтудің жалғыз жолы
Dialogue: 0,0:05:05.34,0:05:07.26,Default,,0,0,0,,Қайықтағы қауіпті
Dialogue: 0,0:05:08.55,0:05:11.14,Default,,0,0,0,,Адамдар оңай жолға оңай түседі.
Dialogue: 0,0:05:11.22,0:05:14.73,Default,,0,0,0,,Бір сәт тот басады, бірақ оны қайрауға көп уақыт керек...
Dialogue: 0,0:05:14.81,0:05:16.35,Default,,0,0,0,,-Ей! -Гяаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:05:16.94,0:05:19.02,Default,,0,0,0,,Қараңызшы, бұл үлкен мәселе емес, солай ма?
Dialogue: 0,0:05:19.11,0:05:20.40,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:05:20.98,0:05:24.53,Default,,0,0,0,,Мен түсінбеймін. Нені сонша жек көресің?
Dialogue: 0,0:05:24.61,0:05:28.12,Default,,0,0,0,,Балалар, сиқырға тым немқұрайлы қарайсыңдар.
Dialogue: 0,0:05:28.20,0:05:30.16,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:05:30.24,0:05:33.29,Default,,0,0,0,,Ал... көмектесу мүмкін емес.
Dialogue: 0,0:05:33.37,0:05:35.66,Default,,0,0,0,,Сізге ұнауы мүмкін... Иә!
Dialogue: 0,0:05:35.75,0:05:36.29,Default,,0,0,0,,Нува
Dialogue: 0,0:05:39.71,0:05:40.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:41.17,0:05:44.30,Default,,0,0,0,,Не... не? Неліктен бұл соншалықты тиімсіз?
Dialogue: 0,0:05:44.38,0:05:45.80,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,0:05:45.88,0:05:47.68,Default,,0,0,0,,Иә! Бұл не, оқшаулағыш?
Dialogue: 0,0:05:47.76,0:05:50.72,Default,,0,0,0,,Түрлі құбыжықтардың майы мен қанына малынған.
Dialogue: 0,0:05:50.80,0:05:53.31,Default,,0,0,0,,Жоқ, тез жуып тастаңыз!
Dialogue: 0,0:05:53.39,0:05:55.35,Default,,0,0,0,,Бұны сумен жууға болмайды...
Dialogue: 0,0:05:55.43,0:05:56.73,Default,,0,0,0,,Мұндағы Окаринді
Dialogue: 0,0:05:57.52,0:06:00.69,Default,,0,0,0,,Мен судан өз жолыммен өтемін
Dialogue: 0,0:06:00.77,0:06:01.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:02.02,0:06:03.32,Default,,0,0,0,,Сіз қайық жасағыңыз келе ме?
Dialogue: 0,0:06:03.40,0:06:04.94,Default,,0,0,0,,Ол әп-сәтте балдырға айналады.
Dialogue: 0,0:06:05.03,0:06:08.49,Default,,0,0,0,,Жоқ, сізде керемет идея болуы керек.
Dialogue: 0,0:06:08.57,0:06:10.66,Default,,0,0,0,,Бұл жалпы сенім дегеніміз не?
Dialogue: 0,0:06:10.74,0:06:11.95,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:06:12.03,0:06:13.45,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:06:15.79,0:06:18.08,Default,,0,0,0,,- Мимикалық қабық? -Шш!
Dialogue: 0,0:06:22.67,0:06:23.80,Default,,0,0,0,,(Су дыбысы)
Dialogue: 0,0:06:31.68,0:06:32.97,Default,,0,0,0,,Су жылқысы (Келпи)
Dialogue: 0,0:06:33.06,0:06:34.68,Default,,0,0,0,,Қауіпті, артта қал
Dialogue: 0,0:06:34.77,0:06:36.68,Default,,0,0,0,,Жарайды, зияны жоқ.
Dialogue: 0,0:06:37.68,0:06:41.23,Default,,0,0,0,,Анна - балық аулауға барсам, үнемі маған келетін жылқы.
Dialogue: 0,0:06:41.31,0:06:42.23,Default,,0,0,0,,Анна?
Dialogue: 0,0:06:42.81,0:06:46.74,Default,,0,0,0,,Мен біраз уақыттан бері осы затпен көлден өтуді ойлап жүрмін.
Dialogue: 0,0:06:46.82,0:06:48.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:48.20,0:06:52.24,Default,,0,0,0,,Мимикалық қабықшаны сәтті бағыттау үшін қолдануға болады ма?
Dialogue: 0,0:06:52.32,0:06:55.12,Default,,0,0,0,,Міне...
Dialogue: 0,0:06:55.20,0:06:57.08,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,0:06:57.83,0:06:59.25,Default,,0,0,0,,-Мен қарсымын -Ой.
Dialogue: 0,0:06:59.87,0:07:03.84,Default,,0,0,0,,Менің ойымша, оның ішкі мүшелерінен жүзу қуығын жасау әлі де пайдалырақ болар еді.
Dialogue: 0,0:07:03.92,0:07:06.05,Default,,0,0,0,,Ха... не деп тұрсың!
Dialogue: 0,0:07:06.13,0:07:08.01,Default,,0,0,0,,Сіз қорқынышты адамсыз.
Dialogue: 0,0:07:08.59,0:07:10.13,Default,,0,0,0,,Құбыжықтар қауіпті
Dialogue: 0,0:07:10.22,0:07:12.39,Default,,0,0,0,,Әсіресе сүйкімділері
Dialogue: 0,0:07:12.47,0:07:16.01,Default,,0,0,0,,Келпилер адамдарды абайсызда ұстап алып, суға түсіреді.
Dialogue: 0,0:07:16.64,0:07:19.39,Default,,0,0,0,,Сіз құбыжықтың шынайы ниетін ешқашан байқамайсыз
Dialogue: 0,0:07:19.48,0:07:23.23,Default,,0,0,0,,Мен Аннді Голем сияқты бұрыннан білемін.
Dialogue: 0,0:07:23.31,0:07:25.90,Default,,0,0,0,,Мен сенен әлдеқайда жақсы білемін.
Dialogue: 0,0:07:25.98,0:07:26.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:27.48,0:07:30.28,Default,,0,0,0,,Неліктен бәрі сүтқоректілерге жұмсақ?
Dialogue: 0,0:07:30.36,0:07:33.32,Default,,0,0,0,,Адам жейтін өсімдіктерді өсіруге қарсы болсам да...
Dialogue: 0,0:07:33.82,0:07:36.24,Default,,0,0,0,,Мен шынымен неге екенін білмеймін?
Dialogue: 0,0:07:36.74,0:07:38.91,Default,,0,0,0,,Кеттік! Энн
Dialogue: 0,0:07:40.96,0:07:42.33,Default,,0,0,0,,Ах... Ei.
Dialogue: 0,0:07:44.00,0:07:45.42,Default,,0,0,0,,Хош иісті!
Dialogue: 0,0:07:45.50,0:07:47.55,Default,,0,0,0,,-Марсиль -Не? Ааа...
Dialogue: 0,0:07:55.47,0:07:56.56,Default,,0,0,0,,Анна…
Dialogue: 0,0:08:02.89,0:08:04.31,Default,,0,0,0,,Тоқта, Энн.
Dialogue: 0,0:08:04.40,0:08:05.48,Default,,0,0,0,,Сен Лорд Дио үшін шайқастың—сен нағыз жақсы жігіт едің, Дж. Гейл.
Dialogue: 0,0:08:07.19,0:08:08.48,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:08:08.57,0:08:10.49,Default,,0,0,0,,-Уф -Райос...
Dialogue: 0,0:08:10.57,0:08:12.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:12.28,0:08:14.20,Default,,0,0,0,,Ммм!
Dialogue: 0,0:08:14.91,0:08:16.20,Default,,0,0,0,,Кешір мені, Энн
Dialogue: 0,0:08:19.29,0:08:20.37,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:08:21.29,0:08:23.71,Default,,0,0,0,,Хмм, ха!
Dialogue: 0,0:08:24.75,0:08:25.96,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:08:26.04,0:08:28.00,Default,,0,0,0,,Егер болашақ өзгерсе, қайта оралудың қажеті болмайды.
Dialogue: 0,0:08:28.55,0:08:32.38,Default,,0,0,0,,Жоқ...! Ммммммм
Dialogue: 0,0:08:33.05,0:08:34.18,Default,,0,0,0,,Дәл…
Dialogue: 0,0:08:36.34,0:08:37.97,Default,,0,0,0,,Хаа~
Dialogue: 0,0:08:38.81,0:08:41.48,Default,,0,0,0,,Сен мені арқаңа мінуімді күтемін дедің бе?
Dialogue: 0,0:08:41.56,0:08:44.69,Default,,0,0,0,,Мен саған кез келген уақытта шабуыл жасауым мүмкін еді.
Dialogue: 0,0:08:44.77,0:08:48.94,Default,,0,0,0,,Келіңіздер, мен құбыжықтар не ойлайтынын түсінбеймін.
Dialogue: 0,0:08:50.57,0:08:53.45,Default,,0,0,0,,Мен білмеймін. Мен мүлде түсінбеймін.
Dialogue: 0,0:08:58.03,0:09:00.24,Default,,0,0,0,,Әй, суық, солай емес пе?
Dialogue: 0,0:09:00.33,0:09:02.45,Default,,0,0,0,,Енді өртті бастайық.
Dialogue: 0,0:09:02.54,0:09:04.83,Default,,0,0,0,,Ха! Эй...
Dialogue: 0,0:09:05.50,0:09:08.00,Default,,0,0,0,,Сен оны қатты жақсы көрсең де, жейсің бе?
Dialogue: 0,0:09:08.75,0:09:11.25,Default,,0,0,0,,Мен сене алар емеспін. Неліктен?
Dialogue: 0,0:09:12.30,0:09:13.30,Default,,0,0,0,,Саған көмектесейін бе?
Dialogue: 0,0:09:14.47,0:09:15.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:16.18,0:09:17.84,Default,,0,0,0,,Мен мұны жалғыз жасаймын
Dialogue: 0,0:09:24.64,0:09:25.52,Default,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 0,0:09:26.10,0:09:29.27,Default,,0,0,0,,Майдың біраз бөлігін алуға бола ма?
Dialogue: 0,0:09:29.90,0:09:32.11,Default,,0,0,0,,Ол қандай жел соғады?
Dialogue: 0,0:09:34.11,0:09:35.45,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:09:38.24,0:09:39.16,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:09:40.87,0:09:43.45,Default,,0,0,0,,Біз мұнда не үшін келдік?
Dialogue: 0,0:09:43.95,0:09:45.29,Default,,0,0,0,,- Чилчак - Әй?
Dialogue: 0,0:09:45.37,0:09:47.83,Default,,0,0,0,,Онда бір нәрсе қалқып жатыр
Dialogue: 0,0:09:47.92,0:09:50.50,Default,,0,0,0,,Адам болса жаман болар еді. Барып көрейік.
Dialogue: 0,0:09:50.59,0:09:52.59,Default,,0,0,0,,Иә, маған ұнамайды.
Dialogue: 0,0:09:57.01,0:09:58.89,Default,,0,0,0,,Не? Мынау ақ
Dialogue: 0,0:09:58.97,0:10:01.35,Default,,0,0,0,,Бұл бидай, ішіндегісі ағып жатыр.
Dialogue: 0,0:10:01.89,0:10:03.43,Default,,0,0,0,,Иесімен бірге келеді
Dialogue: 0,0:10:03.52,0:10:04.81,Default,,0,0,0,,Иә
Dialogue: 0,0:10:04.89,0:10:07.10,Default,,0,0,0,,Оны жерге апарайық, а?
Dialogue: 0,0:10:07.64,0:10:08.56,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:08.65,0:10:11.56,Default,,0,0,0,,Сіз бұл бетті бір жерден танисыз ба?
Dialogue: 0,0:10:11.65,0:10:12.57,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:10:13.11,0:10:15.44,Default,,0,0,0,,А, мен бұл коболды білемін.
Dialogue: 0,0:10:15.53,0:10:17.61,Default,,0,0,0,,Ол үшінші жертөле қабатында құлады.
Dialogue: 0,0:10:17.70,0:10:19.78,Default,,0,0,0,,Неге өзіңнен озып бара жатырсың?
Dialogue: 0,0:10:25.29,0:10:26.20,Default,,0,0,0,,Иә
Dialogue: 0,0:10:26.29,0:10:27.46,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:10:27.54,0:10:29.21,Default,,0,0,0,,Су перілерімен сауда жасау?
Dialogue: 0,0:10:29.79,0:10:31.79,Default,,0,0,0,,Кешіріңіз... Иә?
Dialogue: 0,0:10:35.96,0:10:36.92,Default,,0,0,0,,Chilchak?
Dialogue: 0,0:10:37.84,0:10:39.72,Default,,0,0,0,,Сау болыңыз! Чакты салқындатыңыз!
Dialogue: 0,0:10:42.30,0:10:43.51,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:10:45.31,0:10:52.31,Default,,0,0,0,,(су перісінің ән айту дауысы)
Dialogue: 0,0:10:54.07,0:11:00.95,Default,,0,0,0,,(Лайостың ән салған дауысы)
Dialogue: 0,0:11:01.70,0:11:04.62,Default,,0,0,0,,(Лайостың ән салған дауысы)
Dialogue: 0,0:11:04.70,0:11:07.62,Default,,0,0,0,,(су перісінің ән айту дауысы)
Dialogue: 0,0:11:07.70,0:11:13.96,Default,,0,0,0,,(Лайостың ән салған дауысы)
Dialogue: 0,0:11:14.04,0:11:15.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:15.96,0:11:18.47,Default,,0,0,0,,Тағы да соңына дейін ән айта алмадым
Dialogue: 0,0:11:18.55,0:11:20.55,Default,,0,0,0,,Мен оны үйренсем де...
Dialogue: 0,0:11:22.59,0:11:25.26,Default,,0,0,0,,Уф... Мен мұнымен жақсымын.
Dialogue: 0,0:11:26.64,0:11:29.06,Default,,0,0,0,,Шашылған бидай – ысырап.
Dialogue: 0,0:11:29.14,0:11:30.44,Default,,0,0,0,,Оларды жинауым керек пе?
Dialogue: 0,0:11:30.52,0:11:32.02,Default,,0,0,0,,Қолайсыздық үшін рахмет.
Dialogue: 0,0:11:32.10,0:11:35.82,Default,,0,0,0,,Олай болса алайық.Марсиль бақытты болады.
Dialogue: 0,0:11:35.90,0:11:37.65,Default,,0,0,0,,Мен Марсильді аяймын.
Dialogue: 0,0:11:37.73,0:11:38.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.36,0:11:40.99,Default,,0,0,0,,О
Dialogue: 0,0:11:42.86,0:11:43.95,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:44.53,0:11:45.87,Default,,0,0,0,,Мен әлі ештеңе айтқан жоқпын...
Dialogue: 0,0:11:45.95,0:11:48.83,Default,,0,0,0,,Сіз деми адамдарға тиіспеуге уәде бердіңіз!
Dialogue: 0,0:11:48.91,0:11:51.83,Default,,0,0,0,,Аджин Аджин
Dialogue: 0,0:11:52.42,0:11:53.96,Default,,0,0,0,,...Қызық, бұл не?
Dialogue: 0,0:11:54.04,0:11:55.09,Default,,0,0,0,,Не?
Dialogue: 0,0:11:55.17,0:11:59.09,Default,,0,0,0,,Су перілерінің әртүрлі түрлері бар: сүтқоректілер мен балықтар.
Dialogue: 0,0:11:59.17,0:12:01.13,Default,,0,0,0,,Бұл балыққа арналған
Dialogue: 0,0:12:01.22,0:12:03.55,Default,,0,0,0,,Жұмыртқа салатындықтан, кіндік те, емшегі де болмайды.
Dialogue: 0,0:12:03.64,0:12:04.59,Default,,0,0,0,,Желбезектері де бар.
Dialogue: 0,0:12:05.14,0:12:08.56,Default,,0,0,0,,Жіктелуі жағынан олар сиыр мен шошқаға қарағанда адамнан алысырақ деп ойлаймын.
Dialogue: 0,0:12:09.60,0:12:10.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:11.56,0:12:13.98,Default,,0,0,0,,-Жоқ~ -Ех~
Dialogue: 0,0:12:14.06,0:12:15.86,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:12:15.94,0:12:18.48,Default,,0,0,0,,Неліктен сиыр жақсы, балықшы жаман?
Dialogue: 0,0:12:18.57,0:12:20.49,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:12:20.57,0:12:22.49,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:12:23.78,0:12:24.82,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:12:28.33,0:12:29.70,Default,,0,0,0,,Әлі де істеп жатыр
Dialogue: 0,0:12:30.25,0:12:32.66,Default,,0,0,0,,Менің қарным ашты, тамақ жасап берейін деп ойлаймын.
Dialogue: 0,0:12:34.00,0:12:36.25,Default,,0,0,0,,Бидайды суға салып, қыздырыңыз.
Dialogue: 0,0:12:36.33,0:12:39.13,Default,,0,0,0,,Қопсытылған мимикалық ет пен су өсімдіктерін қосыңыз...
Dialogue: 0,0:12:39.21,0:12:40.51,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:12:40.59,0:12:42.88,Default,,0,0,0,,Балықшының басына өскені осы.
Dialogue: 0,0:12:42.97,0:12:46.39,Default,,0,0,0,,Иә, бірақ бұл жай ғана өсімдік.
Dialogue: 0,0:12:46.47,0:12:48.64,Default,,0,0,0,,Балықшылар мұны мимика үшін пайдаланады
Dialogue: 0,0:12:49.22,0:12:52.18,Default,,0,0,0,,Бұл болмаса, ол балыққа көбірек ұқсайтын еді...
Dialogue: 0,0:12:53.48,0:12:55.48,Default,,0,0,0,,Бұл менің көңіл-күйім үшін әлі де нашар ма?
Dialogue: 0,0:12:55.56,0:12:57.52,Default,,0,0,0,,Уф, бұл қиын.
Dialogue: 0,0:12:57.61,0:13:00.28,Default,,0,0,0,,Түсіндім, түсіндім, қалағаныңды істе.
Dialogue: 0,0:13:00.90,0:13:02.28,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:13:02.86,0:13:06.03,Default,,0,0,0,,Мен дәл қазір қате шешім қабылдағандай сезінемін.
Dialogue: 0,0:13:06.11,0:13:07.74,Default,,0,0,0,,Жарайды, дайын!
Dialogue: 0,0:13:10.62,0:13:12.87,Default,,0,0,0,,Марсиль Сенси Түскі ас ішейік
Dialogue: 0,0:13:13.37,0:13:15.12,Default,,0,0,0,,Бұл уақыт әлдеқашан ба?
Dialogue: 0,0:13:15.21,0:13:17.54,Default,,0,0,0,,Бидайды қайдан алдың?
Dialogue: 0,0:13:17.63,0:13:20.25,Default,,0,0,0,,Мен өлі авантюристті сонда алдым.
Dialogue: 0,0:13:20.34,0:13:21.80,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,0:13:21.88,0:13:22.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:22.63,0:13:25.55,Default,,0,0,0,,Дұрыс, Марсиль күткендей.
Dialogue: 0,0:13:25.63,0:13:28.14,Default,,0,0,0,,Жарайды, мен жасаған нәрсеме көмектесе алмаймын.
Dialogue: 0,0:13:28.80,0:13:30.14,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:13:31.43,0:13:33.39,Default,,0,0,0,,Өте ұзақ уақыттан бері көрмеппін.
Dialogue: 0,0:13:34.64,0:13:37.81,Default,,0,0,0,,Хм уфф уфф...
Dialogue: 0,0:13:37.90,0:13:41.48,Default,,0,0,0,,Бұл жабысқақ. Бұл не?
Dialogue: 0,0:13:41.57,0:13:44.86,Default,,0,0,0,,Балық улығы Су өсімдіктеріне қосылды деп ойлаймын?
Dialogue: 0,0:13:44.94,0:13:47.11,Default,,0,0,0,,Хмм, бұл дәмді.
Dialogue: 0,0:13:47.20,0:13:49.07,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:13:49.16,0:13:50.66,Default,,0,0,0,,Мен оны қолданып көргеніме қуаныштымын.
Dialogue: 0,0:13:51.28,0:13:52.33,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:13:52.99,0:13:53.83,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:53.91,0:13:56.12,Default,,0,0,0,,Бұл балықшының жұмыртқалары.
Dialogue: 0,0:13:56.21,0:14:01.34,Default,,0,0,0,,Балықшылардың басындағы су өсімдіктеріне жұмыртқа салып, қорғайтын әдеті бар дейді.
Dialogue: 0,0:14:02.00,0:14:03.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:03.80,0:14:05.22,Default,,0,0,0,,-Марсиль... -Ах...
Dialogue: 0,0:14:06.80,0:14:08.72,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:14:11.80,0:14:12.76,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:14:18.06,0:14:18.98,Default,,0,0,0,,Сенси
Dialogue: 0,0:14:20.40,0:14:21.73,Default,,0,0,0,,Мен саған мынаны беремін...
Dialogue: 0,0:14:22.57,0:14:25.49,Default,,0,0,0,,Ламинария майынан сабын жасадым.
Dialogue: 0,0:14:26.07,0:14:31.24,Default,,0,0,0,,Келпи майы шашқа арналған май ретінде пайдалы және оны киім мен ыдысқа да қолдануға болады.
Dialogue: 0,0:14:34.33,0:14:36.54,Default,,0,0,0,,Оны қазір қолдануға бола ма?
Dialogue: 0,0:14:36.62,0:14:39.25,Default,,0,0,0,,Ол әлі сабындану процесінде, сондықтан мен білмеймін ...
Dialogue: 0,0:14:39.83,0:14:43.00,Default,,0,0,0,,Мен оны пайдаланғым келеді. Бұл сіз көп еңбектенген нәрсе емес пе?
Dialogue: 0,0:14:44.84,0:14:45.84,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:15:01.60,0:15:06.03,Default,,0,0,0,,Хаа ха ха... хаа ха...
Dialogue: 0,0:15:06.11,0:15:11.28,Default,,0,0,0,,Ха ха ха... ха ха ха...
Dialogue: 0,0:15:20.37,0:15:21.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:25.25,0:15:27.21,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:15:27.30,0:15:29.42,Default,,0,0,0,,Енді бірге алға жылжайық.
Dialogue: 0,0:15:30.63,0:15:31.97,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:15:32.05,0:15:34.76,Default,,0,0,0,,Осылай қарағанымда мен бір нәрсені түсіндім.
Dialogue: 0,0:15:35.76,0:15:39.68,Default,,0,0,0,,Суда жүру өте жақсы сезінеді.
Dialogue: 0,0:15:40.73,0:15:42.81,Default,,0,0,0,,Рахмет сізге Марсиль
Dialogue: 0,0:15:43.77,0:15:44.48,Default,,0,0,0,,Иә
Dialogue: 0,0:15:45.15,0:15:48.19,Default,,0,0,0,,Сабын көзімді шағып тұр.
Dialogue: 0,0:15:55.83,0:15:56.91,Default,,0,0,0,,Ішек
Dialogue: 0,0:15:56.99,0:15:59.58,Default,,0,0,0,,...
Dialogue: 0,0:16:00.29,0:16:01.29,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:16:01.79,0:16:03.71,Default,,0,0,0,,I'll wipe it out!
Dialogue: 0,0:16:03.79,0:16:04.96,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:06.00,0:16:06.71,Default,,0,0,0,,Уау
Dialogue: 0,0:16:10.47,0:16:12.13,Default,,0,0,0,,- Қауіпті! -Оу
Dialogue: 0,0:16:12.22,0:16:14.01,Default,,0,0,0,,Nu… ku…
Dialogue: 0,0:16:14.59,0:16:16.14,Default,,0,0,0,,I told you not to!
Dialogue: 0,0:16:16.22,0:16:18.72,Default,,0,0,0,,Су астындағы жарылыс тым көп өлтіреді!
Dialogue: 0,0:16:18.81,0:16:19.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:19.72,0:16:26.23,Default,,0,0,0,,Бұл жүзді балықты қайнатып, грильде, бумен пісіруге, кептіруге, ысталған немесе шикі түрде жеуге болады...
Dialogue: 0,0:16:26.31,0:16:28.65,Default,,0,0,0,,Қалай пісірсең де дәмді балық екен.
Dialogue: 0,0:16:29.32,0:16:31.69,Default,,0,0,0,,Сондай-ақ басқа құбыжықтарға тамақ ретінде қызмет етеді
Dialogue: 0,0:16:31.78,0:16:35.91,Default,,0,0,0,,Егер ол азайса, лабиринттің экожүйесіне әсер етеді.
Dialogue: 0,0:16:35.99,0:16:38.58,Default,,0,0,0,,Егер сіз мұны жасағыңыз келсе, оны бір-бірден мақсат етіңіз.
Dialogue: 0,0:16:38.66,0:16:41.04,Default,,0,0,0,,Иә~ Бұл мүмкін емес.
Dialogue: 0,0:16:41.62,0:16:45.29,Default,,0,0,0,,Ойлап қарасам, орташа бойлы құбыжықтар әдеттегіден азырақ сияқты...
Dialogue: 0,0:16:45.38,0:16:46.29,Default,,0,0,0,,Мұнда қараңыз.
Dialogue: 0,0:16:46.38,0:16:48.96,Default,,0,0,0,,Мен бұрыштарды кесіп жатқан жоқпын.
Dialogue: 0,0:16:49.05,0:16:50.92,Default,,0,0,0,,Олар сені де өлтірмекші болып отыр.
Dialogue: 0,0:16:51.51,0:16:54.43,Default,,0,0,0,,Жүзді балықтар әдеттегіден көп.
Dialogue: 0,0:16:54.51,0:16:56.55,Default,,0,0,0,,Уайымдайтын ештеңе жоқ, солай ма?
Dialogue: 0,0:16:56.64,0:16:58.68,Default,,0,0,0,,Енді тамақ іше алмасаңыз не істейсіз?
Dialogue: 0,0:16:58.76,0:17:01.81,Default,,0,0,0,,Құбыжық экожүйесін қорға, менің өлгім келмейді.
Dialogue: 0,0:17:05.65,0:17:09.23,Default,,0,0,0,,Хмф, сендер оңай жолды таңдайсыңдар.
Dialogue: 0,0:17:09.73,0:17:13.07,Default,,0,0,0,,Иә? Ендеше, Сенші, оларды бір-бірлеп жеңіп көр.
Dialogue: 0,0:17:13.15,0:17:14.53,Default,,0,0,0,,Өйткені бұл қиын
Dialogue: 0,0:17:16.66,0:17:19.28,Default,,0,0,0,,Экожүйе туралы көбірек ойланыңыз...
Dialogue: 0,0:17:19.37,0:17:21.20,Default,,0,0,0,,-Ааааа~ -Ну~?
Dialogue: 0,0:17:21.29,0:17:23.58,Default,,0,0,0,,Уау! Не? Не?
Dialogue: 0,0:17:23.66,0:17:25.00,Default,,0,0,0,,Сенші!
Dialogue: 0,0:17:27.00,0:17:29.67,Default,,0,0,0,,Не? Мен өтіп бара жаттым
Dialogue: 0,0:17:30.55,0:17:31.59,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:17:33.30,0:17:34.30,Default,,0,0,0,,Сенши?
Dialogue: 0,0:17:36.01,0:17:38.18,Default,,0,0,0,,- Бірдеңе жақындап қалды - А?
Dialogue: 0,0:17:44.10,0:17:46.19,Default,,0,0,0,,-Уау! -Уау
Dialogue: 0,0:17:46.27,0:17:48.19,Default,,0,0,0,,-Уау~ -Бұл өтірік, солай ма?
Dialogue: 0,0:17:49.11,0:17:50.44,Default,,0,0,0,,Тым үлкен
Dialogue: 0,0:17:50.52,0:17:52.94,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,0:17:54.28,0:17:54.94,Default,,0,0,0,,Уау
Dialogue: 0,0:17:56.28,0:17:57.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:57.99,0:17:59.57,Default,,0,0,0,,Ахх!
Dialogue: 0,0:18:00.45,0:18:03.29,Default,,0,0,0,,Кальмар... Әлде сегізаяқ па?
Dialogue: 0,0:18:03.37,0:18:04.58,Default,,0,0,0,,Бұл Кракен!
Dialogue: 0,0:18:04.66,0:18:09.54,Default,,0,0,0,,Бұл бастапқыда үлкен құбыжық, бірақ әдеттегіден бірнеше есе үлкен.
Dialogue: 0,0:18:10.54,0:18:11.96,Default,,0,0,0,,Тамаша, салқын таң, иә?
Dialogue: 0,0:18:12.05,0:18:13.50,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:18:13.59,0:18:15.38,Default,,0,0,0,,Нашар қозғалсаң, өлтіресің.
Dialogue: 0,0:18:15.47,0:18:16.88,Default,,0,0,0,,Оны бірге тартамыз
Dialogue: 0,0:18:17.38,0:18:18.59,Default,,0,0,0,,Мен сені сұрадым, Марсиль.
Dialogue: 0,0:18:19.64,0:18:21.10,Default,,0,0,0,,Бұл тағы да сиқыр ма?
Dialogue: 0,0:18:21.18,0:18:23.97,Default,,0,0,0,,Уайымдамаңыз, мен мұны дұрыс түсінемін.
Dialogue: 0,0:18:26.10,0:18:26.98,Default,,0,0,0,,Ах
Dialogue: 0,0:18:27.69,0:18:28.60,Default,,0,0,0,,келді
Dialogue: 0,0:18:29.48,0:18:30.77,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,0:18:36.57,0:18:37.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:38.49,0:18:39.32,Default,,0,0,0,,Ол күтпеген жерден сол жақ қорғаныстан тік соққымен жауап қайтарды
Dialogue: 0,0:18:39.41,0:18:41.91,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:41.99,0:18:43.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:50.25,0:18:51.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:52.04,0:18:54.17,Default,,0,0,0,,Өтірік... Мен мүлде жауап бермедім.
Dialogue: 0,0:18:54.92,0:18:55.76,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:18:55.84,0:18:58.88,Default,,0,0,0,,Қару-жараққа келсек, бір жұқа тері – таудай қауіпсіздік...
Dialogue: 0,0:18:58.97,0:18:59.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:00.93,0:19:01.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:02.35,0:19:03.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:07.43,0:19:08.14,Default,,0,0,0,,Ой
Dialogue: 0,0:19:09.35,0:19:11.73,Default,,0,0,0,,Ахх! Уф!
Dialogue: 0,0:19:17.57,0:19:19.49,Default,,0,0,0,,Сиқырдың бір түрі Сиқырдың бір түрі...
Dialogue: 0,0:19:19.57,0:19:20.86,Default,,0,0,0,,-Марсиль! -Ах
Dialogue: 0,0:19:20.95,0:19:23.62,Default,,0,0,0,,-Тағы да сиқыр сұраңыз -Иә?
Dialogue: 0,0:19:23.70,0:19:26.20,Default,,0,0,0,,Мұндай үлкен атуды бірнеше рет ату мүмкін емес.
Dialogue: 0,0:19:26.29,0:19:27.12,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:27.79,0:19:28.70,Default,,0,0,0,,Жан-Пьер Польнарефф
Dialogue: 0,0:19:29.87,0:19:32.63,Default,,0,0,0,,Біріншіден, сіз Кракенді бірінші рет көріп тұрсыз, солай ма?
Dialogue: 0,0:19:33.75,0:19:35.80,Default,,0,0,0,,Оның қандай құбыжық екенін білесің бе?
Dialogue: 0,0:19:35.88,0:19:37.26,Default,,0,0,0,,-Білмеймін -Жоқ!
Dialogue: 0,0:19:37.84,0:19:39.42,Default,,0,0,0,,Мен Кракен туралы білмеймін, бірақ
Dialogue: 0,0:19:39.51,0:19:42.01,Default,,0,0,0,,Мен бұрын кальмар мен сегізаяқты өңдегенмін.
Dialogue: 0,0:19:43.43,0:19:44.89,Default,,0,0,0,,А, бұл қауіпті, Марсиль!
Dialogue: 0,0:19:44.97,0:19:46.14,Default,,0,0,0,,Мен сонда бардым!
Dialogue: 0,0:19:49.14,0:19:50.39,Default,,0,0,0,,Су…
Dialogue: 0,0:19:50.48,0:19:51.52,Default,,0,0,0,,Жаяу!
Dialogue: 0,0:19:52.35,0:19:53.40,Default,,0,0,0,,Ой-оу!
Dialogue: 0,0:19:58.78,0:19:59.40,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:06.33,0:20:08.41,Default,,0,0,0,,Кальмар сегізаяқты қатайтқанда
Dialogue: 0,0:20:08.49,0:20:09.66,Default,,0,0,0,,Көзге…
Dialogue: 0,0:20:09.75,0:20:10.66,Default,,0,0,0,,Арасында!
Dialogue: 0,0:20:11.66,0:20:12.67,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:20:22.26,0:20:23.68,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:20:24.59,0:20:26.72,Default,,0,0,0,,Иә? Лайос ше?
Dialogue: 0,0:20:27.89,0:20:31.18,Default,,0,0,0,,Әй, міне, осында.
Dialogue: 0,0:20:31.27,0:20:32.69,Default,,0,0,0,,Иә~
Dialogue: 0,0:20:33.85,0:20:37.32,Default,,0,0,0,,Мына жігіт орта бойлы құбыжықтарды жеп жүрген сияқты...
Dialogue: 0,0:20:37.98,0:20:39.19,Default,,0,0,0,,-Екеуі де -(Екі адам) Ах.
Dialogue: 0,0:20:39.28,0:20:40.53,Default,,0,0,0,,Бір сәт осында кел.
Dialogue: 0,0:20:42.15,0:20:42.95,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:43.03,0:20:46.91,Default,,0,0,0,,Теңіз өнімдерін бір рет тазалап көру керек.
Dialogue: 0,0:20:47.53,0:20:50.70,Default,,0,0,0,,Бұл аймақты ойып алсаңыз, кальмар мен сегізаяқ жақсы тартылады.
Dialogue: 0,0:20:50.79,0:20:52.96,Default,,0,0,0,,Кальмар мен сегізаяқ жақсы ма?
Dialogue: 0,0:20:53.04,0:20:55.42,Default,,0,0,0,,Не, бұл өтірік! Сіз оны ешқашан жеп көрмедіңіз бе?
Dialogue: 0,0:20:55.50,0:20:57.46,Default,,0,0,0,,Өте дәмді болса да...
Dialogue: 0,0:20:57.54,0:21:02.09,Default,,0,0,0,,Қайнату, пісіру, бумен пісіру, кептіру, шегу, шикі жеу...
Dialogue: 0,0:21:02.17,0:21:04.97,Default,,0,0,0,,Не істесең де дәмді~
Dialogue: 0,0:21:05.05,0:21:08.72,Default,,0,0,0,,Мен жақсы мейрамхананы білемін, сондықтан келесі жолы ол туралы айтамын.
Dialogue: 0,0:21:08.80,0:21:10.14,Default,,0,0,0,,Қазір жақсы емес пе?
Dialogue: 0,0:21:11.06,0:21:11.60,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:11.68,0:21:12.98,Default,,0,0,0,,Қабір...!
Dialogue: 0,0:21:13.68,0:21:15.98,Default,,0,0,0,,Уау, бұл біртүрлі.
Dialogue: 0,0:21:16.06,0:21:17.98,Default,,0,0,0,,Оны қалай жеу керек?
Dialogue: 0,0:21:18.06,0:21:20.23,Default,,0,0,0,,Оған тұз себу керек пе?
Dialogue: 0,0:21:20.32,0:21:21.40,Default,,0,0,0,,Ахх
Dialogue: 0,0:21:22.32,0:21:24.65,Default,,0,0,0,,Уф... сасық!
Dialogue: 0,0:21:24.74,0:21:25.36,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:21:25.95,0:21:29.62,Default,,0,0,0,,Сұмдық, аузымды шымырлатып жібереді.
Dialogue: 0,0:21:29.70,0:21:32.50,Default,,0,0,0,,Марсиль мұны барлық тағамдармен бірге жейді...
Dialogue: 0,0:21:32.58,0:21:35.50,Default,,0,0,0,,Жоқ, жоқ! Осы біртүрлі түсініспеушілікті тоқтатыңыз!
Dialogue: 0,0:21:36.12,0:21:36.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:40.50,0:21:42.00,Default,,0,0,0,,Фуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:21:43.51,0:21:45.42,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:21:45.51,0:21:47.64,Default,,0,0,0,,Ғажайып таңғажайып
Dialogue: 0,0:21:47.72,0:21:50.55,Default,,0,0,0,,Ірі құбыжықтардың да ірі паразиттері болады.
Dialogue: 0,0:21:50.64,0:21:52.77,Default,,0,0,0,,Жоқ, бұл жиіркенішті.
Dialogue: 0,0:21:52.85,0:21:53.93,Default,,0,0,0,,Оны қазір лақтырып тастаңыз!
Dialogue: 0,0:21:54.02,0:21:55.77,Default,,0,0,0,,Нені шулатып жатырсың?
Dialogue: 0,0:21:55.85,0:21:58.19,Default,,0,0,0,,Паразиттер тірі организмдерге ортақ
Dialogue: 0,0:21:58.27,0:22:01.65,Default,,0,0,0,,Олардың көпшілігі тамақ дайындауға да жол табады.
Dialogue: 0,0:22:01.73,0:22:03.32,Default,,0,0,0,,Мұны айтудың қажеті жоқ!
Dialogue: 0,0:22:03.90,0:22:06.20,Default,,0,0,0,,Олай болса, сіз оны пісірсеңіз, оны да жеуге болады.
Dialogue: 0,0:22:06.28,0:22:07.36,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:22:07.45,0:22:09.66,Default,,0,0,0,,Мұндай ойлау тәсілі де бар.
Dialogue: 0,0:22:09.74,0:22:11.45,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:22:11.53,0:22:12.49,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:22:29.09,0:22:32.60,Default,,0,0,0,,Мұны тұздықпен гриль жасап көруім керек пе?
Dialogue: 0,0:22:35.60,0:22:39.52,Default,,0,0,0,,А... бірер минут бұрын оның иісі шыққаны сонша, ашуланып кеттім.
Dialogue: 0,0:22:39.60,0:22:41.65,Default,,0,0,0,,(желдеткіш дыбыс)
Dialogue: 0,0:22:42.23,0:22:43.57,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:22:46.24,0:22:47.45,Default,,0,0,0,,Аму, аму...
Dialogue: 0,0:22:47.99,0:22:49.24,Default,,0,0,0,,Ол аяқталды!
Dialogue: 0,0:22:52.58,0:22:54.41,Default,,0,0,0,,Өте ұзақ уақыттан бері көрмеппін.
Dialogue: 0,0:22:55.12,0:22:55.62,Default,,0,0,0,,Аму
Dialogue: 0,0:22:56.50,0:22:57.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:57.75,0:22:59.00,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:22:59.58,0:23:03.00,Default,,0,0,0,,Маған қызық, бұл не, ол сондай үлпілдек, дәмді.
Dialogue: 0,0:23:03.09,0:23:05.84,Default,,0,0,0,,Бұл аздап шырышты, бірақ ол қалың.
Dialogue: 0,0:23:05.92,0:23:08.47,Default,,0,0,0,,-Ммммммммм -мммммммм
Dialogue: 0,0:23:09.30,0:23:11.18,Default,,0,0,0,,Әй, дәмді!
Dialogue: 0,0:23:11.26,0:23:12.35,Default,,0,0,0,,бара алмаймын
Dialogue: 0,0:23:12.43,0:23:15.64,Default,,0,0,0,,Дәмі кәдімгі балықтан өзгеше.
Dialogue: 0,0:23:15.72,0:23:18.31,Default,,0,0,0,,Бұл кальмардан немесе сегізаяқтан жақсы емес пе?
Dialogue: 0,0:23:18.39,0:23:20.48,Default,,0,0,0,,Бұл дұрыс емес... Ах.
Dialogue: 0,0:23:21.60,0:23:23.73,Default,,0,0,0,,Жоқ... мүмкін
Dialogue: 0,0:23:23.81,0:23:27.28,Default,,0,0,0,,Бірақ бұл қалай дайындасаңыз да дәмді болып көрінеді.
Dialogue: 0,0:23:27.36,0:23:29.65,Default,,0,0,0,,Мен оны шикі түрде тістеп алдым, дәмі жоқ.
Dialogue: 0,0:23:29.74,0:23:31.49,Default,,0,0,0,,Сәлем! Сіз оны шикі жедіңіз бе?
Dialogue: 0,0:23:32.07,0:23:33.12,Default,,0,0,0,,Кішкене ғана.
Dialogue: 0,0:23:33.20,0:23:34.78,Default,,0,0,0,,Жарайды, өйткені ол әлдеқашан өлді.
Dialogue: 0,0:23:34.87,0:23:35.49,Default,,0,0,0,,О
Dialogue: 0,0:23:35.58,0:23:38.75,Default,,0,0,0,,Ой, балықтар кракенді жеп жатыр.
Dialogue: 0,0:23:38.83,0:23:43.25,Default,,0,0,0,,Осы арқылы орташа өлшемді құбыжықтар саны біртіндеп қайтады.
Dialogue: 0,0:23:45.09,0:23:46.55,Default,,0,0,0,,Уф
Dialogue: 0,0:23:46.63,0:23:48.26,Default,,0,0,0,,Уф... Менің қарным ашты...
Dialogue: 0,0:23:48.34,0:23:49.09,Default,,0,0,0,,Уф, ауырып тұр
Dialogue: 0,0:23:49.80,0:23:51.26,Default,,0,0,0,,Itetetetetetete…
Dialogue: 0,0:23:51.34,0:23:53.55,Default,,0,0,0,,Не болды?Сенімен бәрі жақсы ма?
Dialogue: 0,0:23:53.64,0:23:54.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:23:55.35,0:23:57.14,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:23:57.22,0:23:58.14,Default,,0,0,0,,Лайос
Dialogue: 0,0:23:58.22,0:24:01.94,Default,,0,0,0,,Сіз алып паразиттің ішінде болдыңыз. Сізді паразит басып қалды.
Dialogue: 0,0:24:02.02,0:24:03.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:03.35,0:24:06.11,Default,,0,0,0,,Қарапайым балыққа да жабысады.
Dialogue: 0,0:24:06.19,0:24:07.98,Default,,0,0,0,,Мен оны тазалау кезінде көрдім
Dialogue: 0,0:24:08.07,0:24:09.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:24:09.61,0:24:14.03,Default,,0,0,0,,Адам үшін паразиттік емес, бірақ асқазанды тесетіндіктен өте ауырады.
Dialogue: 0,0:24:14.12,0:24:16.87,Default,,0,0,0,,Жарайды... жәндіктердің өлуін күтуіміз керек.
Dialogue: 0,0:24:17.87,0:24:20.54,Default,,0,0,0,,Мен бірінші өлмеймін бе?
Dialogue: 0,0:24:20.62,0:24:23.08,Default,,0,0,0,,Егер мен сізге оқтын-оқтын қалпына келтіру сиқырын жасасам ше?
Dialogue: 0,0:24:23.17,0:24:24.29,Default,,0,0,0,,Иә.
Dialogue: 0,0:24:24.38,0:24:26.42,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:24:26.96,0:24:31.51,Default,,0,0,0,,Балықшы жүзді балықты жейді, кракен балықшыны жейді
Dialogue: 0,0:24:31.59,0:24:35.93,Default,,0,0,0,,Кракенді жеңеміз, ал кішкентай балық оның етін жейді.
Dialogue: 0,0:24:36.64,0:24:39.85,Default,,0,0,0,,Кракен паразиттерін жеген Лайостың асқазан қабырғасында.
Dialogue: 0,0:24:39.93,0:24:43.19,Default,,0,0,0,,Сонымен қатар, паразит тесік жасайды.
Dialogue: 0,0:24:44.65,0:24:49.36,Default,,0,0,0,,«Экожүйені қорғау» аздап әсірелеу.
Dialogue: 0,0:24:49.44,0:24:54.45,Default,,0,0,0,,Бізді әуел бастан лабиринт шеңберіне қостық.
Dialogue: 0,0:24:56.41,0:24:58.45,Default,,0,0,0,,Лайос бірдеңе айтқысы келді, бірақ
Dialogue: 0,0:24:58.53,0:25:03.46,Default,,0,0,0,,Қатты ауырсыну мен жүрек айнуы ойлауға мүмкіндік бермеді.
Dialogue: 0,0:25:04.37,0:25:09.55,Default,,0,0,0,,Денемнің ішін кескен пышақтай ауыру түні бойы созылды.
Dialogue: 0,0:25:10.05,0:25:15.13,Default,,0,0,0,,Мен енді ешқашан шикі паразиттерді жемеуге ант бердім.
Dialogue: 0,0:25:16.05,0:25:18.05,Default,,0,0,0,,♪~
Dialogue: 0,0:26:43.22,0:26:45.22,Default,,0,0,0,,~♪
