Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.54,0:01:28.54,Default,,0,0,0,,~♪
Dialogue: 0,0:01:38.47,0:01:40.55,Default,,0,0,0,,Егер ол қайтадан жабылса
Dialogue: 0,0:01:40.64,0:01:41.89,Default,,0,0,0,,Маған біраз уақыт беріңіз
Dialogue: 0,0:01:41.97,0:01:43.27,Default,,0,0,0,,Қазір ашыңыз
Dialogue: 0,0:01:44.98,0:01:48.15,Default,,0,0,0,,Хмм, мен ұзақ жол жүрдім.
Dialogue: 0,0:01:48.23,0:01:51.15,Default,,0,0,0,,Мүмкін бүгін осы жерде демалуға болады.
Dialogue: 0,0:01:51.23,0:01:52.73,Default,,0,0,0,,(асқазанның айқайлауы)
Dialogue: 0,0:01:54.65,0:01:57.53,Default,,0,0,0,,Сіз ішіңізбен жауап беруге жарамайсыз, Марсиль.
Dialogue: 0,0:01:57.61,0:01:59.91,Default,,0,0,0,,Хмм, бұл мен емес.
Dialogue: 0,0:02:00.49,0:02:01.66,Default,,0,0,0,,Таңқаларлық емес
Dialogue: 0,0:02:01.74,0:02:04.79,Default,,0,0,0,,Мен бүгін тәттілерді ғана жедім.
Dialogue: 0,0:02:04.87,0:02:08.25,Default,,0,0,0,,Бірақ Лайос, мен үзіліске қарсымын.
Dialogue: 0,0:02:08.83,0:02:13.75,Default,,0,0,0,,Мен бүгін тапқан жалғыз ингредиенттер бір тостаған қазына жәндіктері болды.
Dialogue: 0,0:02:14.42,0:02:17.26,Default,,0,0,0,,Сіз 4-қабатты аздап болса да көздеуіңіз керек.
Dialogue: 0,0:02:17.80,0:02:23.31,Default,,0,0,0,,Хмм, бірақ құбыжықтар бұдан былай одан да қорқынышты болады.
Dialogue: 0,0:02:23.39,0:02:25.77,Default,,0,0,0,,Дәл қазір мен физикалық күшімді сақтағым келеді.
Dialogue: 0,0:02:25.85,0:02:30.56,Default,,0,0,0,,Дене күшіңді сақтасаң да, аштықтан құлап қалма.
Dialogue: 0,0:02:30.65,0:02:34.57,Default,,0,0,0,,Бірақ физикалық күшіңіз болмаса, құбыжықты жеңуіңіз мүмкін...
Dialogue: 0,0:02:34.65,0:02:36.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:36.36,0:02:37.65,Default,,0,0,0,,Ол ашық.
Dialogue: 0,0:02:38.36,0:02:40.41,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:46.87,0:02:49.79,Default,,0,0,0,,Бұл бөлме асхана болды ма?
Dialogue: 0,0:02:49.87,0:02:52.79,Default,,0,0,0,,Бұл бір кездері сәнді асхана болған болуы керек.
Dialogue: 0,0:02:57.84,0:02:58.67,Default,,0,0,0,,Өте ұзақ уақыттан бері көрмеппін.
Dialogue: 0,0:02:58.76,0:03:02.05,Default,,0,0,0,,Бірақ қазір айналада тек өлілер ғана жүр...
Dialogue: 0,0:03:02.14,0:03:04.01,Default,,0,0,0,,Бірде-бір егеуқұйрық емделмеді
Dialogue: 0,0:03:04.10,0:03:05.68,Default,,0,0,0,,Егеуқұйрықтар тамақ жемейді!
Dialogue: 0,0:03:05.76,0:03:10.69,Default,,0,0,0,,Күрсін... Неге олар тек өлі адамдарға шабуыл жасайды?
Dialogue: 0,0:03:11.27,0:03:13.77,Default,,0,0,0,,Қуырылған шошқаның шабуылына ұшыраған дұрыс.
Dialogue: 0,0:03:14.31,0:03:15.19,Default,,0,0,0,,Біз есімізді жоғалтқан болармыз, иә?
Dialogue: 0,0:03:16.36,0:03:17.82,Default,,0,0,0,,Шабуыл жасау...
Dialogue: 0,0:03:18.65,0:03:19.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:19.28,0:03:20.95,Default,,0,0,0,,Жоқ, бар...
Dialogue: 0,0:03:22.53,0:03:24.99,Default,,0,0,0,,Сізге шабуыл жасайтын тағам!
Dialogue: 0,0:03:28.29,0:03:29.83,Default,,0,0,0,,Тірі сурет!
Dialogue: 0,0:03:29.91,0:03:30.96,Default,,0,0,0,,Сәлем Райос!
Dialogue: 0,0:03:31.04,0:03:32.46,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:32.54,0:03:33.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:33.96,0:03:36.34,Default,,0,0,0,,Тым жақын! Сіз қосылғыңыз келе ме?
Dialogue: 0,0:03:36.42,0:03:39.30,Default,,0,0,0,,Иә, бұл жақсы жер болды!
Dialogue: 0,0:03:39.38,0:03:40.22,Default,,0,0,0,,Не?
Dialogue: 0,0:03:40.80,0:03:43.22,Default,,0,0,0,,Бұл суретте оның жүзімдері бар еді.
Dialogue: 0,0:03:43.30,0:03:47.35,Default,,0,0,0,,Сонымен сіз суреттегі тағамды жеп көрдіңіз.
Dialogue: 0,0:03:47.97,0:03:50.43,Default,,0,0,0,,А, бұл жақсы идея емес пе?
Dialogue: 0,0:03:50.52,0:03:52.23,Default,,0,0,0,,-Олай ойлама -Сен ақымақ емессің бе?
Dialogue: 0,0:03:52.31,0:03:55.65,Default,,0,0,0,,«Сурет толтырылған күріш торты» өрнекті білесіз бе?
Dialogue: 0,0:03:56.23,0:03:59.40,Default,,0,0,0,,Адамдар суретке салған күріш торттарын жей алмайтыны рас, бірақ...
Dialogue: 0,0:03:59.48,0:04:03.07,Default,,0,0,0,,Бұл күріш тортын жеп отырған адамның суреті болса, қателесуге болмайды!
Dialogue: 0,0:04:04.11,0:04:06.41,Default,,0,0,0,,Суретте ол өлтіріледі, солай емес пе?
Dialogue: 0,0:04:06.49,0:04:07.91,Default,,0,0,0,,Міне.
Dialogue: 0,0:04:07.99,0:04:11.66,Default,,0,0,0,,Бұл сурет ішінде бір-бірімізбен әрекеттесе алатынымыздың дәлелі.
Dialogue: 0,0:04:12.37,0:04:15.92,Default,,0,0,0,,- Уф йо йо йо - (қызметші) Уф ах...
Dialogue: 0,0:04:16.00,0:04:18.34,Default,,0,0,0,,Түсіндім, енді өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:04:18.42,0:04:20.05,Default,,0,0,0,,Бірақ тек бір рет.
Dialogue: 0,0:04:20.13,0:04:21.17,Default,,0,0,0,,О!
Dialogue: 0,0:04:21.26,0:04:23.13,Default,,0,0,0,,Мен сені арқанмен байлаймын
Dialogue: 0,0:04:24.26,0:04:26.64,Default,,0,0,0,,Егер сигнал берілсе, осы жерден тартыңыз.
Dialogue: 0,0:04:27.14,0:04:29.60,Default,,0,0,0,,Қандай сурет салуым керек?
Dialogue: 0,0:04:30.14,0:04:32.56,Default,,0,0,0,,Уа, бұл керемет
Dialogue: 0,0:04:33.14,0:04:34.73,Default,,0,0,0,,Көптеген мерекелер
Dialogue: 0,0:04:35.27,0:04:37.44,Default,,0,0,0,,Жарайды, мынаны салайық!
Dialogue: 0,0:04:40.44,0:04:41.36,Default,,0,0,0,,О!
Dialogue: 0,0:04:44.40,0:04:45.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:47.41,0:04:49.20,Default,,0,0,0,,Ауырды~
Dialogue: 0,0:04:49.28,0:04:50.29,Default,,0,0,0,,Сіз…
Dialogue: 0,0:04:50.79,0:04:52.79,Default,,0,0,0,,Сіз оны кенеттен таптыңыз ба?
Dialogue: 0,0:04:53.41,0:04:54.58,Default,,0,0,0,,-(Қыз) Анау қылыш... -Аа.
Dialogue: 0,0:04:55.29,0:04:57.29,Default,,0,0,0,,Ол біртүрлі сауыт киген.
Dialogue: 0,0:04:57.38,0:04:59.42,Default,,0,0,0,,Сіз қамал күзетшісісіз бе?
Dialogue: 0,0:04:59.50,0:05:00.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:00.42,0:05:01.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:01.42,0:05:03.17,Default,,0,0,0,,Енді мынаны алып жүр!
Dialogue: 0,0:05:03.67,0:05:07.09,Default,,0,0,0,,Жұмыс күші жетсе де, жетпейді.
Dialogue: 0,0:05:07.18,0:05:09.76,Default,,0,0,0,,Мына жерде, мына жерде, шу көтерме!
Dialogue: 0,0:05:10.43,0:05:11.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:14.18,0:05:17.60,Default,,0,0,0,,Мына ақылды жүзге қарашы.
Dialogue: 0,0:05:17.69,0:05:21.61,Default,,0,0,0,,Иә, менің мұрным дәл сенікіне ұқсайды.
Dialogue: 0,0:05:21.69,0:05:25.61,Default,,0,0,0,,Бір күні елге жақсы басшылық жасайды.
Dialogue: 0,0:05:25.70,0:05:26.82,Default,,0,0,0,,Ооооо...
Dialogue: 0,0:05:26.91,0:05:30.12,Default,,0,0,0,,Құттықтаймыз, Фринаг мырза.
Dialogue: 0,0:05:30.74,0:05:32.29,Default,,0,0,0,,Сіз не нәрсеге таң қалдыңыз?
Dialogue: 0,0:05:32.37,0:05:34.12,Default,,0,0,0,,Маған келесісін тез әкеліңізші.
Dialogue: 0,0:05:34.20,0:05:36.29,Default,,0,0,0,,А, анау... бір тістеу...
Dialogue: 0,0:05:36.37,0:05:37.62,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:05:38.21,0:05:41.21,Default,,0,0,0,,Делгал! сенің атың делгал
Dialogue: 0,0:05:41.71,0:05:46.26,Default,,0,0,0,,Хахахаха Делғал Жақсы патша бол!
Dialogue: 0,0:05:46.34,0:05:47.34,Default,,0,0,0,,Жоқ, бұл!
Dialogue: 0,0:05:47.43,0:05:48.89,Default,,0,0,0,,Мен оны жей алмаймын деп ойлаймын!
Dialogue: 0,0:05:51.26,0:05:53.18,Default,,0,0,0,,«көмек»
Dialogue: 0,0:05:54.10,0:05:55.43,Default,,0,0,0,,Сигнал келді!
Dialogue: 0,0:05:55.52,0:05:56.35,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:05:56.44,0:05:57.64,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:00.48,0:06:01.73,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:06:01.82,0:06:02.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:04.32,0:06:06.95,Default,,0,0,0,,Мен оны жеуге дайын болдым.
Dialogue: 0,0:06:07.03,0:06:10.20,Default,,0,0,0,,Бұлай сезілген жоқ.
Dialogue: 0,0:06:10.28,0:06:11.12,Default,,0,0,0,,Атмосфера?
Dialogue: 0,0:06:11.20,0:06:12.62,Default,,0,0,0,,Бұл атмосфераға қатысты ма?
Dialogue: 0,0:06:12.70,0:06:13.95,Default,,0,0,0,,Жоқ, бұл мүлдем...
Dialogue: 0,0:06:14.04,0:06:15.83,Default,,0,0,0,,Бұл атмосфера мәселесі болды.
Dialogue: 0,0:06:16.41,0:06:20.04,Default,,0,0,0,,Тағы бір рет. Мен оны неғұрлым қолайлы жағдайда жей аламын.
Dialogue: 0,0:06:20.13,0:06:22.34,Default,,0,0,0,,Не сәйкес келеді?
Dialogue: 0,0:06:22.42,0:06:23.59,Default,,0,0,0,,That's right.
Dialogue: 0,0:06:23.67,0:06:27.55,Default,,0,0,0,,Бұл дөрекі лекция сияқты...
Dialogue: 0,0:06:30.18,0:06:31.89,Default,,0,0,0,,Қираған лекция?
Dialogue: 0,0:06:32.68,0:06:35.10,Default,,0,0,0,,А, бұл туралы не деуге болады?
Dialogue: 0,0:06:35.60,0:06:37.73,Default,,0,0,0,,Той болып жатыр, бұл берекелі сияқты.
Dialogue: 0,0:06:37.81,0:06:39.39,Default,,0,0,0,,Кейбіреулер жалаңаш билейді.
Dialogue: 0,0:06:39.48,0:06:40.85,Default,,0,0,0,,Міне! мен барамын
Dialogue: 0,0:06:41.94,0:06:43.48,Default,,0,0,0,,О... ой
Dialogue: 0,0:06:44.40,0:06:46.94,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:06:47.03,0:06:49.15,Default,,0,0,0,,-Ох -хмм...
Dialogue: 0,0:06:50.28,0:06:51.49,Default,,0,0,0,,Сен ақымақ мас!
Dialogue: 0,0:06:52.03,0:06:54.28,Default,,0,0,0,,Патшаның алдында қандай еліктеу...
Dialogue: 0,0:06:54.37,0:06:55.66,Default,,0,0,0,,Хмф! Хамф!
Dialogue: 0,0:06:55.74,0:06:57.70,Default,,0,0,0,,Тез түс!
Dialogue: 0,0:06:57.79,0:06:58.83,Default,,0,0,0,,А, жарайды.
Dialogue: 0,0:06:59.92,0:07:01.83,Default,,0,0,0,,Бүгін менің үйлену тойым
Dialogue: 0,0:07:02.54,0:07:05.59,Default,,0,0,0,,Жолымнан сәл шығып кетсем, кешіріңіз.
Dialogue: 0,0:07:05.67,0:07:07.80,Default,,0,0,0,,Бірақ ханзада Делгал
Dialogue: 0,0:07:08.51,0:07:09.51,Default,,0,0,0,,Делгар…
Dialogue: 0,0:07:09.59,0:07:11.84,Default,,0,0,0,,Бұрынғы суреттегі нәресте?
Dialogue: 0,0:07:11.93,0:07:13.26,Default,,0,0,0,,Жүр!
Dialogue: 0,0:07:15.43,0:07:16.85,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:07:17.43,0:07:18.60,Default,,0,0,0,,Делгал
Dialogue: 0,0:07:18.68,0:07:20.35,Default,,0,0,0,,Әке!
Dialogue: 0,0:07:20.44,0:07:24.19,Default,,0,0,0,,Сіздің жақсы өскеніңізге қуаныштымын.
Dialogue: 0,0:07:25.40,0:07:27.48,Default,,0,0,0,,Осы елдің болашағы үшін
Dialogue: 0,0:07:28.36,0:07:29.36,Default,,0,0,0,,(әйнек дыбысы)
Dialogue: 0,0:07:31.91,0:07:33.87,Default,,0,0,0,,Ухх~
Dialogue: 0,0:07:35.45,0:07:36.87,Default,,0,0,0,,Ах~
Dialogue: 0,0:07:37.95,0:07:39.08,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:07:39.96,0:07:42.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:42.50,0:07:44.33,Default,,0,0,0,,Тч... Әке!
Dialogue: 0,0:07:44.42,0:07:47.42,Default,,0,0,0,,(мырылдаған дауыс)
Dialogue: 0,0:07:47.50,0:07:51.88,Default,,0,0,0,,Аа... Үйге апарып асықпай жеймін.
Dialogue: 0,0:07:54.05,0:07:56.30,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:07:56.39,0:07:57.01,Default,,0,0,0,,Ах
Dialogue: 0,0:07:57.10,0:07:58.27,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:58.35,0:07:59.52,Default,,0,0,0,,Патша!
Dialogue: 0,0:08:00.10,0:08:02.39,Default,,0,0,0,,Тезірек емделіңіз! Асығыңыз!
Dialogue: 0,0:08:02.48,0:08:05.56,Default,,0,0,0,,Сол пері де алдыңғы суретте болған.
Dialogue: 0,0:08:05.65,0:08:07.40,Default,,0,0,0,,Сайқымазақ немесе бір нәрсе...
Dialogue: 0,0:08:09.03,0:08:10.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:10.24,0:08:12.15,Default,,0,0,0,,-Мм -Мм
Dialogue: 0,0:08:12.24,0:08:13.66,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:08:13.74,0:08:15.41,Default,,0,0,0,,Бұл жолы мен үйге тамақ әкелдім...
Dialogue: 0,0:08:15.49,0:08:18.03,Default,,0,0,0,,Иә? ештеңе
Dialogue: 0,0:08:19.99,0:08:22.66,Default,,0,0,0,,Оны суреттен тыс алуға болмайды ма?
Dialogue: 0,0:08:22.75,0:08:25.42,Default,,0,0,0,,Ішінен тамақ ішпейінше, пайда жоқ.
Dialogue: 0,0:08:25.50,0:08:29.25,Default,,0,0,0,,Келесі! Егер бұл орын алса, мен оның дәмін білгім келеді!
Dialogue: 0,0:08:31.84,0:08:33.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:34.01,0:08:34.55,Default,,0,0,0,,Ах
Dialogue: 0,0:08:39.22,0:08:40.22,Default,,0,0,0,,О
Dialogue: 0,0:08:41.64,0:08:44.35,Default,,0,0,0,,Бұл тәж кию ме?
Dialogue: 0,0:08:44.90,0:08:47.40,Default,,0,0,0,,Сол ханзада тағына мұрагер болды ма?
Dialogue: 0,0:08:49.90,0:08:55.20,Default,,0,0,0,,Осы ел мен оның халқы мәңгі және мәңгі гүлдене берсін деп дұға етіңіз ...
Dialogue: 0,0:08:57.41,0:08:59.70,Default,,0,0,0,,А? Ааа...
Dialogue: 0,0:09:04.04,0:09:05.33,Default,,0,0,0,,Дәмді...
Dialogue: 0,0:09:08.71,0:09:09.50,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:10.34,0:09:11.30,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:09:11.38,0:09:13.76,Default,,0,0,0,,Мен бояудың дәмі болуы мүмкін деп ойладым.
Dialogue: 0,0:09:13.84,0:09:16.18,Default,,0,0,0,,Бұл нағыз мереке.
Dialogue: 0,0:09:16.26,0:09:16.89,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:17.89,0:09:18.43,Default,,0,0,0,,Ахх
Dialogue: 0,0:09:19.43,0:09:20.18,Default,,0,0,0,,(жұтатын дыбыс)
Dialogue: 0,0:09:20.26,0:09:22.52,Default,,0,0,0,,Әму Әму Әму Әму Әму…
Dialogue: 0,0:09:22.60,0:09:23.60,Default,,0,0,0,,Уф
Dialogue: 0,0:09:23.68,0:09:25.98,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:09:26.06,0:09:26.60,Default,,0,0,0,,О
Dialogue: 0,0:09:27.52,0:09:29.69,Default,,0,0,0,,А, өзгертіңізші.
Dialogue: 0,0:09:33.53,0:09:35.70,Default,,0,0,0,,жеді
Dialogue: 0,0:09:36.28,0:09:38.78,Default,,0,0,0,,Мен тойдым.
Dialogue: 0,0:09:39.91,0:09:42.08,Default,,0,0,0,,Енді қайтайық.
Dialogue: 0,0:09:42.87,0:09:43.37,Default,,0,0,0,,Ах
Dialogue: 0,0:09:46.54,0:09:47.96,Default,,0,0,0,,Иә? Бұл бала...
Dialogue: 0,0:09:48.04,0:09:49.08,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:49.67,0:09:51.92,Default,,0,0,0,,Сен сарайдан емессің ғой?
Dialogue: 0,0:09:52.00,0:09:52.59,Default,,0,0,0,,Бұл қауіпті…
Dialogue: 0,0:09:53.30,0:09:54.67,Default,,0,0,0,,Ұшып кет…
Dialogue: 0,0:09:54.76,0:09:57.13,Default,,0,0,0,,Ол ханзаданың туған күні мен үйлену тойында да болды.
Dialogue: 0,0:09:57.22,0:09:58.26,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:58.80,0:10:02.22,Default,,0,0,0,,Сіздің мақсатыңыз қандай? Сіз тағына ұмтыласыз ба?
Dialogue: 0,0:10:02.89,0:10:03.72,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:04.39,0:10:07.10,Default,,0,0,0,,Мен оны осылай көмірге айналдырамын.
Dialogue: 0,0:10:07.19,0:10:07.94,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:08.02,0:10:09.02,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:09.10,0:10:10.44,Default,,0,0,0,,Уау
Dialogue: 0,0:10:10.52,0:10:11.69,Default,,0,0,0,,Сурет...
Dialogue: 0,0:10:12.98,0:10:13.86,Default,,0,0,0,,Хааа~
Dialogue: 0,0:10:15.03,0:10:17.90,Default,,0,0,0,,Бірдеңе болды ма? суретте
Dialogue: 0,0:10:18.70,0:10:21.70,Default,,0,0,0,,Қаншама дәмді тағамдар тізіліп тұрды.
Dialogue: 0,0:10:21.78,0:10:24.41,Default,,0,0,0,,Көп тамақтанып, үйге қайтпақ болдым.
Dialogue: 0,0:10:24.99,0:10:28.37,Default,,0,0,0,,Сырттан болсам да, біліп, мойнымнан ұстап алды...
Dialogue: 0,0:10:29.04,0:10:31.17,Default,,0,0,0,,Мен қатты ашуландым...
Dialogue: 0,0:10:31.25,0:10:32.84,Default,,0,0,0,,Бұл мені ашуландырады.
Dialogue: 0,0:10:32.92,0:10:35.42,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:10:38.22,0:10:40.80,Default,,0,0,0,,Мен біраз шиеленістен құтылсам, қайтадан аш боламын...
Dialogue: 0,0:10:41.55,0:10:45.97,Default,,0,0,0,,О? Қанша жесем де, қарынымды тойғыза алмай жүрмін.
Dialogue: 0,0:10:46.56,0:10:48.18,Default,,0,0,0,,Хоора~
Dialogue: 0,0:10:48.27,0:10:50.52,Default,,0,0,0,,Өйткені, бұл «суреттегі мочи»
Dialogue: 0,0:10:50.60,0:10:52.23,Default,,0,0,0,,Уақытымды қайтар
Dialogue: 0,0:10:52.31,0:10:55.07,Default,,0,0,0,,Маған ұнамады, бірақ өте жақсы болды.
Dialogue: 0,0:11:00.66,0:11:03.03,Default,,0,0,0,,Бұл ас үй ме?
Dialogue: 0,0:11:04.24,0:11:06.49,Default,,0,0,0,,Мен де көрші бөлмеде су ішемін.
Dialogue: 0,0:11:06.58,0:11:08.71,Default,,0,0,0,,Бұл дем алуға жақсы бөлме.
Dialogue: 0,0:11:09.50,0:11:11.71,Default,,0,0,0,,Суреттермен ойнамасаңыз
Dialogue: 0,0:11:11.79,0:11:14.21,Default,,0,0,0,,Ол төртінші қабатқа жеткен болар еді.
Dialogue: 0,0:11:17.71,0:11:18.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:20.55,0:11:22.84,Default,,0,0,0,,Бұл мимика емес пе?
Dialogue: 0,0:11:23.93,0:11:26.85,Default,,0,0,0,,Ол жерде бұрын мұндай қорап болмаған.
Dialogue: 0,0:11:26.93,0:11:29.73,Default,,0,0,0,,Тым сенімді емес, тым жасырын емес
Dialogue: 0,0:11:29.81,0:11:31.85,Default,,0,0,0,,Назар аударатын ақылды ұстаным
Dialogue: 0,0:11:32.44,0:11:35.77,Default,,0,0,0,,Бұл бейбақ ұнататын жер сияқты.
Dialogue: 0,0:11:36.82,0:11:40.07,Default,,0,0,0,,Олай болса, бүгін осында ұйықтайық.
Dialogue: 0,0:11:40.15,0:11:41.53,Default,,0,0,0,,-Иә -Хмм
Dialogue: 0,0:11:42.11,0:11:43.41,Default,,0,0,0,,Жарайсың ба? салқындату
Dialogue: 0,0:11:43.49,0:11:44.87,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:11:48.50,0:11:50.46,Default,,0,0,0,,Үндеу керек пе?
Dialogue: 0,0:11:50.54,0:11:53.92,Default,,0,0,0,,Сенши мен Райостың бәрібір жейтініне сенімдімін.
Dialogue: 0,0:11:54.00,0:11:56.88,Default,,0,0,0,,Бұл жағдайда қорапты ашу менің міндетім.
Dialogue: 0,0:11:58.67,0:12:00.05,Default,,0,0,0,,Мимика
Dialogue: 0,0:12:00.13,0:12:03.68,Default,,0,0,0,,Сол бейбақ мені неше рет қинады?
Dialogue: 0,0:12:05.01,0:12:05.89,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:05.97,0:12:07.85,Default,,0,0,0,,Құлып немесе қақпақ жоқ
Dialogue: 0,0:12:07.93,0:12:09.18,Default,,0,0,0,,Хмм... Ах!
Dialogue: 0,0:12:12.60,0:12:15.69,Default,,0,0,0,,Бұл құлыптаулы, сондықтан бұл мимика емес.
Dialogue: 0,0:12:16.52,0:12:17.32,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:12:17.40,0:12:19.40,Default,,0,0,0,,А-а-а-а!
Dialogue: 0,0:12:22.40,0:12:24.16,Default,,0,0,0,,Ит!? Әрине, мүмкін емес—осы ит!?
Dialogue: 0,0:12:24.24,0:12:26.32,Default,,0,0,0,,Артынан ашсаңыз, ештеңе істей алмайсыз.
Dialogue: 0,0:12:27.91,0:12:29.79,Default,,0,0,0,,Уф... кетті.
Dialogue: 0,0:12:29.87,0:12:31.83,Default,,0,0,0,,Мен қақпанды ұмытып кетіппін!
Dialogue: 0,0:12:31.91,0:12:34.37,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:36.79,0:12:38.34,Default,,0,0,0,,Мимика...
Dialogue: 0,0:12:39.46,0:12:40.51,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:40.59,0:12:41.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:41.84,0:12:43.01,Default,,0,0,0,,Себебі мен аңырап қалдым
Dialogue: 0,0:12:43.59,0:12:44.97,Default,,0,0,0,,Сіз бір нәрсеге алаңдайсыз ба?
Dialogue: 0,0:12:45.72,0:12:47.01,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:12:47.10,0:12:50.27,Default,,0,0,0,,Шаршаған болуы керек, ол әлі бала.
Dialogue: 0,0:12:50.35,0:12:52.81,Default,,0,0,0,,Бүгін маған қарауға рұқсат берме, ұйықтауға рұқсат ет.
Dialogue: 0,0:12:53.31,0:12:55.27,Default,,0,0,0,,Мен бала болмасам да...
Dialogue: 0,0:12:55.98,0:12:57.27,Default,,0,0,0,,Олай болса, оның жасы нешеде?
Dialogue: 0,0:12:57.36,0:12:58.52,Default,,0,0,0,,Мен мұны айтқым келмейді
Dialogue: 0,0:12:58.61,0:13:01.82,Default,,0,0,0,,Міне~ Чилчак үнемі осылай
Dialogue: 0,0:13:01.90,0:13:04.53,Default,,0,0,0,,Ол маған қайдан келгенін, туған күнін айтпайды.
Dialogue: 0,0:13:04.61,0:13:07.82,Default,,0,0,0,,Мен жұмыс пен жеке өмірді бөліп алғым келеді.
Dialogue: 0,0:13:07.91,0:13:11.20,Default,,0,0,0,,Мұндай нәрсе сізге бір күні қымбатқа түсетіні анық~
Dialogue: 0,0:13:11.29,0:13:12.95,Default,,0,0,0,,-Иә Иә -Йоёёо~
Dialogue: 0,0:13:17.08,0:13:18.38,Default,,0,0,0,,(асқазанның айқайлауы)
Dialogue: 0,0:13:19.38,0:13:21.84,Default,,0,0,0,,Мен аштықтан әлсіреп барамын.
Dialogue: 0,0:13:21.92,0:13:24.05,Default,,0,0,0,,Мен екі күн бойы тамақ ішпей жақсы болдым.
Dialogue: 0,0:13:26.63,0:13:28.64,Default,,0,0,0,,Менің қасыма келесің бе?
Dialogue: 0,0:13:29.64,0:13:31.06,Default,,0,0,0,,Сәлем, Донкуса
Dialogue: 0,0:13:31.56,0:13:32.56,Default,,0,0,0,,Ммм
Dialogue: 0,0:13:32.64,0:13:33.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:33.48,0:13:35.06,Default,,0,0,0,,Су алуға шығады.
Dialogue: 0,0:13:36.73,0:13:38.90,Default,,0,0,0,,Хмм... мен сенімен барамын.
Dialogue: 0,0:13:38.98,0:13:40.52,Default,,0,0,0,,Қажет емес, дереу оралыңыз
Dialogue: 0,0:13:41.19,0:13:42.57,Default,,0,0,0,,Бұл қауіпті...
Dialogue: 0,0:13:42.65,0:13:44.03,Default,,0,0,0,,Көрші есік
Dialogue: 0,0:13:44.61,0:13:46.53,Default,,0,0,0,,(Судың ағып жатқан дыбысы)
Dialogue: 0,0:13:52.29,0:13:52.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:56.66,0:13:58.12,Default,,0,0,0,,Монета қатесі
Dialogue: 0,0:13:58.21,0:14:00.13,Default,,0,0,0,,Бұл жерде ұя бар ма?
Dialogue: 0,0:14:00.63,0:14:03.84,Default,,0,0,0,,Тағы бірнеше тауып алсам, қарын тойдырармын.
Dialogue: 0,0:14:05.05,0:14:07.93,Default,,0,0,0,,Мен Лайос емеспін, бірақ мен тиын қателерін жақсы көремін.
Dialogue: 0,0:14:08.51,0:14:12.22,Default,,0,0,0,,Бұл Мимик сияқты мимикалық құбыжық, бірақ сүйкімді.
Dialogue: 0,0:14:12.31,0:14:13.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:13.56,0:14:15.81,Default,,0,0,0,,Бір минут күтіңіз, бұл Мимик...
Dialogue: 0,0:14:15.89,0:14:17.56,Default,,0,0,0,,(тордың құлаған дыбысы)
Dialogue: 0,0:14:17.64,0:14:20.27,Default,,0,0,0,,Ха! ...сен ақымақ
Dialogue: 0,0:14:20.36,0:14:23.48,Default,,0,0,0,,Қаптың ауыр екенін ұмытпайсың ба?
Dialogue: 0,0:14:24.07,0:14:26.32,Default,,0,0,0,,Оның айналасында ашылатын механизм бар...
Dialogue: 0,0:14:28.53,0:14:29.99,Default,,0,0,0,,Ол келуі керек емес пе?
Dialogue: 0,0:14:30.62,0:14:32.20,Default,,0,0,0,,Көмек шақыруым керек пе?
Dialogue: 0,0:14:32.28,0:14:32.87,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:32.95,0:14:35.08,Default,,0,0,0,,Егер бұл дауыс басқа құбыжықтарды біріктірсе
Dialogue: 0,0:14:35.16,0:14:36.70,Default,,0,0,0,,Достарға қауіп төніп тұр
Dialogue: 0,0:14:36.79,0:14:37.66,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:37.75,0:14:40.08,Default,,0,0,0,,Мен қайтып келмесем, Марсиль байқайды.
Dialogue: 0,0:14:40.79,0:14:43.92,Default,,0,0,0,,...? Бұл жақсы емес шығар, мен одан үміт күте алмаймын.
Dialogue: 0,0:14:44.67,0:14:46.21,Default,,0,0,0,,Дүрбелеңге салынбаңыз
Dialogue: 0,0:14:46.30,0:14:48.34,Default,,0,0,0,,Жабық есікті ашу
Dialogue: 0,0:14:48.84,0:14:50.51,Default,,0,0,0,,Бұл сіздің жұмысыңыз!
Dialogue: 0,0:14:51.85,0:14:54.35,Default,,0,0,0,,Егер сіз қулықты шешсеңіз, мұндай есік ашылады.
Dialogue: 0,0:14:54.93,0:14:57.39,Default,,0,0,0,,Мимикаларға қол тигізбесеңіз жақсы.
Dialogue: 0,0:14:57.48,0:14:59.98,Default,,0,0,0,,Мен тіпті оғаш жабдықтың қозғалған дыбысын да естімеймін.
Dialogue: 0,0:15:00.06,0:15:01.35,Default,,0,0,0,,Уақыт шектеуі жоқ
Dialogue: 0,0:15:02.11,0:15:03.86,Default,,0,0,0,,Қабырғада бірнеше қосқыштар бар.
Dialogue: 0,0:15:04.44,0:15:07.24,Default,,0,0,0,,Найза сыртқа шығып тұрғандай етіп көрсететін құрылғы
Dialogue: 0,0:15:07.32,0:15:09.86,Default,,0,0,0,,Мен оны дұрыс емес ретпен бассам, ол ұшып кете ме?
Dialogue: 0,0:15:10.78,0:15:14.45,Default,,0,0,0,,...Осы табақтағы сөз түйіні болса керек.
Dialogue: 0,0:15:14.95,0:15:18.00,Default,,0,0,0,,Бұл көне тіл ме? Мен оны оқи алмаймын.
Dialogue: 0,0:15:18.08,0:15:20.54,Default,,0,0,0,,Тәтті, егер Марсиль осында болса...
Dialogue: 0,0:15:21.67,0:15:25.09,Default,,0,0,0,,Бірақ бірдеңе таныс сияқты ма?
Dialogue: 0,0:15:25.59,0:15:28.05,Default,,0,0,0,,Мен білмеймін. Мен оны бір рет ұйымдастыруым керек пе?
Dialogue: 0,0:15:28.80,0:15:31.09,Default,,0,0,0,,Бөлменің бұрышында үш ажыратқыш бар.
Dialogue: 0,0:15:31.18,0:15:32.34,Default,,0,0,0,,Неліктен үш?
Dialogue: 0,0:15:32.43,0:15:34.68,Default,,0,0,0,,Оны кез келген ретпен басыңыз?
Dialogue: 0,0:15:35.43,0:15:36.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:37.56,0:15:40.14,Default,,0,0,0,,Сондай-ақ мимиканың артында қосқыш бар.
Dialogue: 0,0:15:40.23,0:15:43.61,Default,,0,0,0,,Қат! Сіз мені мүлдем алаңдатасыз ба?
Dialogue: 0,0:15:43.69,0:15:48.23,Default,,0,0,0,,Бөлмеде ешқандай түсінік жоқ...
Dialogue: 0,0:15:48.82,0:15:51.61,Default,,0,0,0,,Мен оны дұрыс басқан кезде, ол шашырай бастайды...
Dialogue: 0,0:15:52.24,0:15:54.28,Default,,0,0,0,,Менің дене бітіміммен алшақтық болуы керек...
Dialogue: 0,0:15:54.37,0:15:56.53,Default,,0,0,0,,Жоқ, бұл қауіпті.
Dialogue: 0,0:15:57.04,0:16:00.58,Default,,0,0,0,,А, қазірдің өзінде! Мен не істерімді білмеймін
Dialogue: 0,0:16:02.33,0:16:03.12,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:16:03.79,0:16:08.38,Default,,0,0,0,,Таң атқанша тыныш отырамын... иә...
Dialogue: 0,0:16:08.92,0:16:09.88,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:10.97,0:16:12.84,Default,,0,0,0,,Міне!
Dialogue: 0,0:16:12.93,0:16:14.39,Default,,0,0,0,,Да...!
Dialogue: 0,0:16:15.14,0:16:16.01,Default,,0,0,0,,Күте тұрыңыз…
Dialogue: 0,0:16:16.60,0:16:17.85,Default,,0,0,0,,(Найзаның жарылған дыбысы)
Dialogue: 0,0:16:18.39,0:16:19.43,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:20.68,0:16:23.60,Default,,0,0,0,,Хмм... ауырады~
Dialogue: 0,0:16:23.69,0:16:25.15,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:16:32.15,0:16:34.99,Default,,0,0,0,,Ха ха ха ха сен сондай күштісің
Dialogue: 0,0:16:35.91,0:16:37.20,Default,,0,0,0,,Мимика аударылады
Dialogue: 0,0:16:37.28,0:16:38.83,Default,,0,0,0,,Шапылдап, сүйкімді
Dialogue: 0,0:16:39.58,0:16:42.50,Default,,0,0,0,,Төңкеру арқылы оның еркек немесе әйел екенін білуге болады.
Dialogue: 0,0:16:43.08,0:16:45.00,Default,,0,0,0,,Лайостың тривиальды тривиасы
Dialogue: 0,0:16:45.08,0:16:46.50,Default,,0,0,0,,Жанып тұрған шам сияқты...
Dialogue: 0,0:16:47.46,0:16:49.30,Default,,0,0,0,,Төңкеріңіз... қайтарыңыз...
Dialogue: 0,0:16:49.38,0:16:51.13,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:16:51.67,0:16:54.63,Default,,0,0,0,,Иә, бұл бәрі немесе ештеңе!
Dialogue: 0,0:16:54.72,0:16:56.18,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:16:57.76,0:16:58.55,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:17:00.47,0:17:05.40,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:17:06.19,0:17:07.94,Default,,0,0,0,,Хаа, ауырады~
Dialogue: 0,0:17:08.02,0:17:10.65,Default,,0,0,0,,Маған көмектесуге келмейсің бе?
Dialogue: 0,0:17:11.90,0:17:12.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:12.86,0:17:14.28,Default,,0,0,0,,Бұл аспан ба?
Dialogue: 0,0:17:14.36,0:17:15.78,Default,,0,0,0,,Ақымақ бол!
Dialogue: 0,0:17:16.36,0:17:18.62,Default,,0,0,0,,А, бұл кейіпкер...
Dialogue: 0,0:17:19.87,0:17:22.16,Default,,0,0,0,,Бұл тақтайшаның жазуы ма?
Dialogue: 0,0:17:22.75,0:17:24.87,Default,,0,0,0,,Егер бұлай болса, онда не айтылғанын білесіз.
Dialogue: 0,0:17:25.58,0:17:26.42,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:17:26.50,0:17:27.92,Default,,0,0,0,,«Күн неше рет шығады?»
Dialogue: 0,0:17:26.50,0:17:27.92,Default,,0,0,0,,Шығыс!
Dialogue: 0,0:17:28.00,0:17:29.92,Default,,0,0,0,,«Ай батып кетсе де»
Dialogue: 0,0:17:28.00,0:17:29.92,Default,,0,0,0,,Батыс!
Dialogue: 0,0:17:30.00,0:17:31.80,Default,,0,0,0,,«Тұрақты жұлдыз сияқты»
Dialogue: 0,0:17:30.00,0:17:31.80,Default,,0,0,0,,Солтүстік!
Dialogue: 0,0:17:31.88,0:17:34.34,Default,,0,0,0,,Оо оңтүстік оңтүстік!
Dialogue: 0,0:17:34.88,0:17:39.22,Default,,0,0,0,,«Болашақ мәңгілік желмен құтты болсын!»
Dialogue: 0,0:17:41.31,0:17:41.85,Default,,0,0,0,,Қостаушылардың көбі Босс жағында—
Dialogue: 0,0:17:41.93,0:17:44.56,Default,,0,0,0,,Ух ха ха ха ха ха ха...
Dialogue: 0,0:17:44.64,0:17:47.73,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:17:47.81,0:17:48.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:50.61,0:17:51.52,Default,,0,0,0,,(тордың құлаған дыбысы)
Dialogue: 0,0:17:57.03,0:17:59.74,Default,,0,0,0,,Чилчак қайтып келмейді.
Dialogue: 0,0:18:01.28,0:18:02.45,Default,,0,0,0,,Иә? Ха!
Dialogue: 0,0:18:02.54,0:18:03.45,Default,,0,0,0,,Ах
Dialogue: 0,0:18:04.50,0:18:06.79,Default,,0,0,0,,Чи... Чил Чак!
Dialogue: 0,0:18:07.37,0:18:09.42,Default,,0,0,0,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:18:09.92,0:18:11.13,Default,,0,0,0,,Мен тірімін
Dialogue: 0,0:18:11.63,0:18:13.17,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:13.25,0:18:15.38,Default,,0,0,0,,Сіз мұны жасадыңыз ба? Чилчак
Dialogue: 0,0:18:15.47,0:18:16.67,Default,,0,0,0,,Бұл үлкен!
Dialogue: 0,0:18:17.18,0:18:18.05,Default,,0,0,0,,Сәлем
Dialogue: 0,0:18:18.63,0:18:20.51,Default,,0,0,0,,Қандай керемет мимика.
Dialogue: 0,0:18:21.18,0:18:24.56,Default,,0,0,0,,Мимика... Мен бірінші рет пісіріп жатырмын.
Dialogue: 0,0:18:24.64,0:18:27.35,Default,,0,0,0,,Бұл! Оны жеуге тырыспаңыз!
Dialogue: 0,0:18:28.02,0:18:29.31,Default,,0,0,0,,Жарайды, Марсиль.
Dialogue: 0,0:18:29.90,0:18:31.86,Default,,0,0,0,,Мимиканың өзі улы емес.
Dialogue: 0,0:18:31.94,0:18:35.11,Default,,0,0,0,,Кейбір тағамдар ішкеніңізге байланысты улы болуы мүмкін сияқты.
Dialogue: 0,0:18:35.19,0:18:39.03,Default,,0,0,0,,Асқорыту жүйесін алып тастасақ жақсы болмай ма?
Dialogue: 0,0:18:40.07,0:18:42.58,Default,,0,0,0,,Мен ештеңе естімедім.
Dialogue: 0,0:18:43.33,0:18:45.08,Default,,0,0,0,,Марсильден бас тарт
Dialogue: 0,0:18:45.58,0:18:47.75,Default,,0,0,0,,Оларға не айтсаң да, пайдасы жоқ.
Dialogue: 0,0:18:47.83,0:18:51.46,Default,,0,0,0,,Бірақ мен оны бүгін міндетті түрде жемеймін!
Dialogue: 0,0:18:52.13,0:18:53.00,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:18:55.84,0:19:00.22,Default,,0,0,0,,Суды көп қайнатып, тұз...
Dialogue: 0,0:19:01.59,0:19:04.14,Default,,0,0,0,,Мимиканы қосып, жабыңыз.
Dialogue: 0,0:19:04.22,0:19:06.02,Default,,0,0,0,,Біраз күтіңіз
Dialogue: 0,0:19:07.23,0:19:09.64,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:09.73,0:19:13.06,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:13.15,0:19:14.65,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:14.73,0:19:15.98,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:20.91,0:19:21.66,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:25.08,0:19:26.66,Default,,0,0,0,,Егер жеткілікті қайнатылған болса
Dialogue: 0,0:19:26.74,0:19:27.91,Default,,0,0,0,,-О -Ах~
Dialogue: 0,0:19:28.00,0:19:29.16,Default,,0,0,0,,Ол аяқталды!
Dialogue: 0,0:19:32.00,0:19:34.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:35.92,0:19:38.34,Default,,0,0,0,,Мен денемді дұрыстап шығара алмаймын.
Dialogue: 0,0:19:38.42,0:19:40.17,Default,,0,0,0,,Тұтқаны пайдалану туралы не айтасыз?
Dialogue: 0,0:19:41.18,0:19:42.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:43.22,0:19:45.85,Default,,0,0,0,,Жоқ, мен оны терең ішке қарай итеріп жіберемін.
Dialogue: 0,0:19:45.93,0:19:46.89,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:46.97,0:19:49.85,Default,,0,0,0,,Чилчак, соны маған қарызға бер.
Dialogue: 0,0:19:49.93,0:19:50.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:50.89,0:19:54.65,Default,,0,0,0,,Қараңдаршы, менде әрқашан бар таңдау құралы!
Dialogue: 0,0:19:54.73,0:19:57.11,Default,,0,0,0,,Таңдау құралдары!
Dialogue: 0,0:19:57.19,0:19:59.36,Default,,0,0,0,,Ах... аа... ахх...
Dialogue: 0,0:20:00.15,0:20:02.32,Default,,0,0,0,,Сіз ақымақ емессіз.
Dialogue: 0,0:20:02.41,0:20:05.03,Default,,0,0,0,,Қайнатып зарарсыздандырсаңыз, жарайды.
Dialogue: 0,0:20:05.12,0:20:08.20,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:20:08.29,0:20:10.71,Default,,0,0,0,,Мәселе бұл емес!
Dialogue: 0,0:20:10.79,0:20:12.46,Default,,0,0,0,,Жоқ... тоқта...
Dialogue: 0,0:20:21.38,0:20:22.68,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:20:25.01,0:20:26.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:27.60,0:20:29.72,Default,,0,0,0,,Ммммммммммммммммммммммммммммм
Dialogue: 0,0:20:30.39,0:20:31.18,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:35.19,0:20:36.73,Default,,0,0,0,,Уау, дәмді
Dialogue: 0,0:20:37.44,0:20:38.32,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:20:39.07,0:20:42.07,Default,,0,0,0,,Жоқ, бұл өте дәмді.
Dialogue: 0,0:20:42.15,0:20:45.91,Default,,0,0,0,,Арқа мен аяқты бірге жесеңіз дәмді көрінеді.
Dialogue: 0,0:20:47.74,0:20:49.20,Default,,0,0,0,,Шын мәнінде емес
Dialogue: 0,0:20:49.79,0:20:52.58,Default,,0,0,0,,Шаянның ортаңғы ішек бездері нашар деп естідім.
Dialogue: 0,0:20:52.66,0:20:53.87,Default,,0,0,0,,Аммммм
Dialogue: 0,0:20:54.83,0:20:57.84,Default,,0,0,0,,Бірақ неге Мимик туралы үндемей қалдың?
Dialogue: 0,0:20:58.42,0:21:01.13,Default,,0,0,0,,Мимиктің жақсы естеліктері жоқ...
Dialogue: 0,0:21:01.21,0:21:04.34,Default,,0,0,0,,Егер сіз одан аулақ жүрсеңіз, онда ештеңе жоқ.
Dialogue: 0,0:21:04.97,0:21:07.47,Default,,0,0,0,,Қалай болғанда да, менің пайымдауым көптеген жағынан бұлыңғыр болды.
Dialogue: 0,0:21:09.56,0:21:12.98,Default,,0,0,0,,Мен қорқып кеттім, өйткені ол менің қазынамды жеп қояды деп ойладым.
Dialogue: 0,0:21:13.56,0:21:15.56,Default,,0,0,0,,Мимиктер қазына қателерін жемейді.
Dialogue: 0,0:21:15.65,0:21:16.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:16.56,0:21:19.52,Default,,0,0,0,,Керісінше, қазына жәндігі мимиканы жейді.
Dialogue: 0,0:21:19.61,0:21:23.19,Default,,0,0,0,,Мимиканы тапқанда, ол қораптың саңылауы арқылы жұмыртқа салады.
Dialogue: 0,0:21:23.28,0:21:27.37,Default,,0,0,0,,Личинка қораптың ішіне шығып, мимиканы жеген кезде өседі.
Dialogue: 0,0:21:28.03,0:21:31.74,Default,,0,0,0,,Ересек болған кезде адамдар оны қазына деп санайды.
Dialogue: 0,0:21:31.83,0:21:34.08,Default,,0,0,0,,Жаңа әлемге қадам басатын кез келді.
Dialogue: 0,0:21:34.58,0:21:36.54,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:21:37.04,0:21:38.75,Default,,0,0,0,,Сіз маған тоқтауыңызды айтып тұрсыз!
Dialogue: 0,0:21:38.83,0:21:41.59,Default,,0,0,0,,Өйткені сен маған жасыңды айтпайсың.
Dialogue: 0,0:21:42.25,0:21:45.88,Default,,0,0,0,,Сіз достарыңыздан бір нәрсені жасыру жоғалту екенін білдіңіз бе?
Dialogue: 0,0:21:45.97,0:21:48.76,Default,,0,0,0,,Айтыңызшы, қазір нешедесіз?
Dialogue: 0,0:21:50.89,0:21:51.81,Default,,0,0,0,,Ол ұзақ фильм сияқты көрінді, сондықтан мен оны көруге үлгермедім.
Dialogue: 0,0:21:51.89,0:21:52.97,Default,,0,0,0,,Не?
Dialogue: 0,0:21:54.60,0:21:56.98,Default,,0,0,0,,биыл 29 жаста...
Dialogue: 0,0:21:59.06,0:22:01.52,Default,,0,0,0,,Ей, сен бала екенсің!
Dialogue: 0,0:22:01.61,0:22:02.90,Default,,0,0,0,,Бұл қызықсыз
Dialogue: 0,0:22:02.98,0:22:05.28,Default,,0,0,0,,Сіз сонша жас болдыңыз ба?
Dialogue: 0,0:22:05.36,0:22:07.66,Default,,0,0,0,,Ой, сен нешедесің?
Dialogue: 0,0:22:07.74,0:22:10.12,Default,,0,0,0,,Міне, ұзақ өмір сүретін жарыстар!
Dialogue: 0,0:22:12.29,0:22:13.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:22:13.54,0:22:16.12,Default,,0,0,0,,Чилчак мырза...
Dialogue: 0,0:22:16.21,0:22:17.37,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:22:18.17,0:22:20.46,Default,,0,0,0,,Бүгінгі тамақ – құбыжық
Dialogue: 0,0:22:20.54,0:22:23.75,Default,,0,0,0,,Ертең біз тамаққа айналуымыз мүмкін
Dialogue: 0,0:22:24.38,0:22:25.97,Default,,0,0,0,,Зынданда тамақ
Dialogue: 0,0:22:26.05,0:22:28.55,Default,,0,0,0,,А, зындандағы тағам
Dialogue: 0,0:22:29.18,0:22:29.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:31.01,0:22:33.01,Default,,0,0,0,,♪~
Dialogue: 0,0:23:58.22,0:24:00.23,Default,,0,0,0,,~♪
Dialogue: 0,0:24:01.73,0:24:07.73,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory