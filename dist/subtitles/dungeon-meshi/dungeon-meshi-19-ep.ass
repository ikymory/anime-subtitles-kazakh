Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.50,0:01:28.50,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.84,0:01:33.80,Default,,0,0,0,,Қаруыңызды тез лақтырыңыз.
Dialogue: 0,0:01:34.38,0:01:35.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:37.13,0:01:39.39,Default,,0,0,0,,Артқа қадам жасаңыз
Dialogue: 0,0:01:39.47,0:01:42.06,Default,,0,0,0,,Кішкене қозғалсаң, мен сені өлтіремін.
Dialogue: 0,0:01:42.14,0:01:43.85,Default,,0,0,0,,Мен оның екеніне сенімдімін
Dialogue: 0,0:01:43.93,0:01:46.31,Default,,0,0,0,,Ол Шроның қолбасшыларының бірі емес пе?
Dialogue: 0,0:01:46.39,0:01:48.77,Default,,0,0,0,,Сіз бізді осы уақыт бойы бақылап жүрдіңіз бе?
Dialogue: 0,0:01:49.61,0:01:50.56,Default,,0,0,0,,Сен менің абыройымды осы лайға батырдың!
Dialogue: 0,0:01:50.65,0:01:52.11,Default,,0,0,0,,Осы техниканы шешіңіз
Dialogue: 0,0:01:52.19,0:01:53.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:53.15,0:01:56.32,Default,,0,0,0,,Айла менде. Асықшы!
Dialogue: 0,0:01:56.40,0:01:59.20,Default,,0,0,0,,Сізге қандай сиқыр жасалып жатыр?
Dialogue: 0,0:01:59.28,0:02:00.82,Default,,0,0,0,,Сіз оны көрмейсіз бе?
Dialogue: 0,0:02:00.91,0:02:03.12,Default,,0,0,0,,Сіз қара сиқыршысыз, солай ма?
Dialogue: 0,0:02:03.20,0:02:05.08,Default,,0,0,0,,Ең болмағанда қай жерде ілулі тұр?
Dialogue: 0,0:02:05.16,0:02:07.33,Default,,0,0,0,,Бұл қандай сиқыр екенін айт.
Dialogue: 0,0:02:08.17,0:02:08.83,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:02:08.92,0:02:12.09,Default,,0,0,0,,Менің үстімде екі түрлі сиқыр бар.
Dialogue: 0,0:02:12.17,0:02:13.80,Default,,0,0,0,,Біреуі мойынға
Dialogue: 0,0:02:14.55,0:02:15.84,Default,,0,0,0,,Басқа нәрсе ...
Dialogue: 0,0:02:15.92,0:02:16.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:18.43,0:02:19.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:20.05,0:02:21.39,Default,,0,0,0,,Барлық денеде
Dialogue: 0,0:02:22.93,0:02:25.60,Default,,0,0,0,,Бұл жануар ма? Яғни
Dialogue: 0,0:02:25.68,0:02:28.73,Default,,0,0,0,,Хаха... Баяғыда бір көргенмін.
Dialogue: 0,0:02:28.81,0:02:31.73,Default,,0,0,0,,Бұл жасанды түрде жасалған аңшы.
Dialogue: 0,0:02:31.81,0:02:35.57,Default,,0,0,0,,Адам мен хайуанның жанын араластыру үшін қара магия қолданылады дейді...
Dialogue: 0,0:02:37.57,0:02:40.32,Default,,0,0,0,,Жарайды, мен мүмкіндігінше тырысамын.
Dialogue: 0,0:02:42.16,0:02:43.24,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:43.83,0:02:45.95,Default,,0,0,0,,Шығыс тілінде жазылғанға ұқсайды.
Dialogue: 0,0:02:46.45,0:02:47.58,Default,,0,0,0,,Бұл техниканың қандай түрі?
Dialogue: 0,0:02:48.08,0:02:49.96,Default,,0,0,0,,Сіз оны көрмейсіз бе?
Dialogue: 0,0:02:50.04,0:02:53.67,Default,,0,0,0,,Бұл құюшы белгілі бір уақыт ішінде оған қол тигізбесе, іске қосылатын заклинание.
Dialogue: 0,0:02:53.75,0:02:56.51,Default,,0,0,0,,Бұл адам Майзуру деп аталады ма?
Dialogue: 0,0:02:56.59,0:02:58.34,Default,,0,0,0,,Жеңілдік мерзімі қанша?
Dialogue: 0,0:02:58.42,0:03:00.47,Default,,0,0,0,,Мерзім жеткенде не болады?
Dialogue: 0,0:03:00.55,0:03:03.14,Default,,0,0,0,,Келіңіздер ме? Мүмкін мен асығуым керек
Dialogue: 0,0:03:03.22,0:03:05.76,Default,,0,0,0,,Менімен бірге өлгің келмейді.
Dialogue: 0,0:03:06.81,0:03:08.81,Default,,0,0,0,,Сен оны босатсаң, мен сені босатамын.
Dialogue: 0,0:03:10.39,0:03:12.48,Default,,0,0,0,,Кейіпкерлер ерекше
Dialogue: 0,0:03:12.56,0:03:14.48,Default,,0,0,0,,Бірақ менің ойымша, мұны жоюға болады.
Dialogue: 0,0:03:14.57,0:03:15.48,Default,,0,0,0,,Сәлем балақай!
Dialogue: 0,0:03:15.57,0:03:16.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:16.40,0:03:17.86,Default,,0,0,0,,Маған тамақ әкел.
Dialogue: 0,0:03:20.90,0:03:22.16,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:23.99,0:03:24.83,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:26.95,0:03:28.37,Default,,0,0,0,,(тамақ араластыру дыбысы)
Dialogue: 0,0:03:28.45,0:03:31.50,Default,,0,0,0,,Мырза, сіз соңғы рет қашан кешкі астыңыз?
Dialogue: 0,0:03:32.04,0:03:34.96,Default,,0,0,0,,Асықпай тамақ ішсең, тұншығып қаласың.
Dialogue: 0,0:03:35.04,0:03:35.71,Default,,0,0,0,,Ой!
Dialogue: 0,0:03:35.79,0:03:38.09,Default,,0,0,0,,Маған жылы нәрсе дайындап беріңізші...
Dialogue: 0,0:03:38.17,0:03:39.88,Default,,0,0,0,,Ей, өзің қозғалма!
Dialogue: 0,0:03:39.97,0:03:40.51,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:03:40.59,0:03:42.22,Default,,0,0,0,,Мені жалап...
Dialogue: 0,0:03:42.84,0:03:44.51,Default,,0,0,0,,Гохо, гохо, гохо…
Dialogue: 0,0:03:44.60,0:03:47.56,Default,,0,0,0,,Сізге шөлді қандыру үшін бірдеңе керек болады.
Dialogue: 0,0:03:47.64,0:03:49.52,Default,,0,0,0,,Жай дайындаңыз.
Dialogue: 0,0:03:49.60,0:03:52.56,Default,,0,0,0,,Құбыжықты тамақтандырмақ болсаң, мен сені өлтіремін.
Dialogue: 0,0:03:53.44,0:03:54.40,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:03:55.73,0:03:57.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:57.23,0:04:00.94,Default,,0,0,0,,Есімде болса, драйадтың жанынан терген саңырауқұлақтар...
Dialogue: 0,0:04:01.03,0:04:01.78,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:04:02.53,0:04:05.12,Default,,0,0,0,,Аяқ тәрізді нәрсе өсе бастады ма?
Dialogue: 0,0:04:05.87,0:04:08.29,Default,,0,0,0,,Мүмкін бұл менің қиялым шығар...
Dialogue: 0,0:04:08.87,0:04:11.33,Default,,0,0,0,,Кәстрөлді сиқырлы шеңберге қойыңыз
Dialogue: 0,0:04:11.41,0:04:13.04,Default,,0,0,0,,Сары майды ерітіңіз
Dialogue: 0,0:04:13.12,0:04:15.17,Default,,0,0,0,,Сарымсақты қуырыңыз
Dialogue: 0,0:04:15.25,0:04:16.38,Default,,0,0,0,,Күрішті қосыңыз
Dialogue: 0,0:04:16.88,0:04:19.38,Default,,0,0,0,,Саңырауқұлақтарға дәмдеуіштер
Dialogue: 0,0:04:19.46,0:04:21.97,Default,,0,0,0,,Су құйып, біраз қайнатыңыз
Dialogue: 0,0:04:24.97,0:04:26.39,Default,,0,0,0,,(жұтатын дыбыс)
Dialogue: 0,0:04:26.89,0:04:27.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:28.47,0:04:31.27,Default,,0,0,0,,Мен тек осындай нәрсені жасай аламын.
Dialogue: 0,0:04:31.35,0:04:33.89,Default,,0,0,0,,Бұл қауқарсыз, аянышты...
Dialogue: 0,0:04:33.98,0:04:34.85,Default,,0,0,0,,Қандай болса да
Dialogue: 0,0:04:34.94,0:04:38.40,Default,,0,0,0,,Жастар күйзеліске түскенде шыдай алмаймын.
Dialogue: 0,0:04:38.48,0:04:39.40,Default,,0,0,0,,Кем дегенде...
Dialogue: 0,0:04:40.07,0:04:41.65,Default,,0,0,0,,Ірімшік қосуға болады ма?
Dialogue: 0,0:04:42.24,0:04:43.57,Default,,0,0,0,,Орындалды
Dialogue: 0,0:04:46.74,0:04:48.12,Default,,0,0,0,,Мен оны осында қоямын
Dialogue: 0,0:04:48.20,0:04:49.83,Default,,0,0,0,,Мұны кім жасайды...
Dialogue: 0,0:04:53.04,0:04:53.87,Default,,0,0,0,,Хун
Dialogue: 0,0:04:54.79,0:04:55.96,Default,,0,0,0,,Ох…
Dialogue: 0,0:04:56.04,0:04:56.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:59.00,0:04:59.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:00.00,0:05:02.05,Default,,0,0,0,,Амму абдырап қалды
Dialogue: 0,0:05:02.13,0:05:03.30,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:05:04.01,0:05:06.18,Default,,0,0,0,,Тамақтану этикеті
Dialogue: 0,0:05:06.26,0:05:07.47,Default,,0,0,0,,Нашар!
Dialogue: 0,0:05:08.51,0:05:09.68,Default,,0,0,0,,Маған көбірек беріңіз!
Dialogue: 0,0:05:10.26,0:05:11.35,Default,,0,0,0,,Шығыста, мұнда және
Dialogue: 0,0:05:11.43,0:05:13.43,Default,,0,0,0,,Этикеттер мүлдем қарама-қарсы ма?
Dialogue: 0,0:05:13.52,0:05:14.52,Default,,0,0,0,,Жоқ, Шлоу
Dialogue: 0,0:05:14.60,0:05:16.77,Default,,0,0,0,,Менің бұлай жегенімді ешқашан көрмегенсің.
Dialogue: 0,0:05:17.27,0:05:19.69,Default,,0,0,0,,Мен жай ғана жақсы тәрбие көрмедім.
Dialogue: 0,0:05:20.32,0:05:21.69,Default,,0,0,0,,Бұл сіз үшін әдеттен тыс па?
Dialogue: 0,0:05:27.82,0:05:28.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:28.82,0:05:29.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:33.58,0:05:35.25,Default,,0,0,0,,- Е! - Тегіс...
Dialogue: 0,0:05:36.21,0:05:37.54,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:05:37.62,0:05:38.88,Default,,0,0,0,,Мен саңырауқұлақтарды жек көремін
Dialogue: 0,0:05:38.96,0:05:39.88,Default,,0,0,0,,Таңдаушы жегіш!
Dialogue: 0,0:05:39.96,0:05:42.13,Default,,0,0,0,,Бұл бұрын-соңды болмаған үлгі
Dialogue: 0,0:05:42.21,0:05:43.13,Default,,0,0,0,,Сенси...
Dialogue: 0,0:05:45.88,0:05:46.76,Default,,0,0,0,,Қасық...
Dialogue: 0,0:05:46.84,0:05:47.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:47.47,0:05:50.01,Default,,0,0,0,,Қасықты дұрыс ұстаңыз
Dialogue: 0,0:05:50.10,0:05:52.97,Default,,0,0,0,,Сәлем! Егер жақындасаң, мен сені өлтіремін.
Dialogue: 0,0:05:53.06,0:05:57.73,Default,,0,0,0,,Қасықты дұрыс ұстаңыз және еденге жаңа лақтырғаныңызды алыңыз.
Dialogue: 0,0:05:57.81,0:05:59.94,Default,,0,0,0,,-Қалайсың! -Эй, жоқ!
Dialogue: 0,0:06:00.02,0:06:01.23,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:01.32,0:06:03.23,Default,,0,0,0,,Құлыптан босатылған кезде қозғалу қауіпті!
Dialogue: 0,0:06:03.86,0:06:05.07,Default,,0,0,0,,Ааааа~
Dialogue: 0,0:06:06.11,0:06:06.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:07.70,0:06:08.61,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:08.70,0:06:09.61,Default,,0,0,0,,Ммм
Dialogue: 0,0:06:10.16,0:06:11.87,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:11.95,0:06:13.41,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:06:14.62,0:06:15.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:16.79,0:06:18.79,Default,,0,0,0,,Қасықты осылай ұстау керек
Dialogue: 0,0:06:18.87,0:06:20.96,Default,,0,0,0,,Ей... бұл адамдарға байланысты!
Dialogue: 0,0:06:21.04,0:06:23.21,Default,,0,0,0,,Бұл мен үшін ең оңай!
Dialogue: 0,0:06:23.30,0:06:25.01,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:06:25.09,0:06:28.47,Default,,0,0,0,,Егер мен оны бейтаныс жолмен ұстауға мәжбүр етсем, мазасыз болар еді.
Dialogue: 0,0:06:28.55,0:06:29.26,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:29.34,0:06:30.72,Default,,0,0,0,,Сенші, артта!
Dialogue: 0,0:06:30.80,0:06:32.35,Default,,0,0,0,,Тааааааааа!
Dialogue: 0,0:06:32.43,0:06:33.68,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:06:33.76,0:06:34.64,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:06:34.72,0:06:35.47,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:06:35.56,0:06:37.14,Default,,0,0,0,,Жауап...
Dialogue: 0,0:06:37.23,0:06:37.98,Default,,0,0,0,,​​О?
Dialogue: 0,0:06:38.56,0:06:39.60,Default,,0,0,0,,Қағаз?
Dialogue: 0,0:06:40.19,0:06:41.69,Default,,0,0,0,,Сенші! Абайлаңыз!
Dialogue: 0,0:06:41.77,0:06:45.11,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:06:45.19,0:06:47.57,Default,,0,0,0,,Бұл ет кесу үшін қолданылады.
Dialogue: 0,0:06:47.65,0:06:49.70,Default,,0,0,0,,Бұл Суджихики деп аталатын пышақтың бір түрі.
Dialogue: 0,0:06:50.20,0:06:52.49,Default,,0,0,0,,Пышақ ұзын және өткір.
Dialogue: 0,0:06:52.57,0:06:54.12,Default,,0,0,0,,Бұл қорқынышты көрінеді
Dialogue: 0,0:06:54.20,0:06:56.12,Default,,0,0,0,,Жұқа және нәзік
Dialogue: 0,0:06:56.20,0:06:58.87,Default,,0,0,0,,Егер сіз оны осылай тербетсеңіз
Dialogue: 0,0:06:58.96,0:07:00.50,Default,,0,0,0,,Не болады...
Dialogue: 0,0:07:00.58,0:07:01.38,Default,,0,0,0,,Сенші!
Dialogue: 0,0:07:03.25,0:07:03.92,Default,,0,0,0,,(Куджо Йотаро) Польнареф, мына жігіт… Бұл адам кім өзі?
Dialogue: 0,0:07:05.46,0:07:06.13,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:07:06.21,0:07:07.30,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:07.84,0:07:09.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:09.84,0:07:10.76,Default,,0,0,0,,(пышақ сынған дыбыс)
Dialogue: 0,0:07:11.84,0:07:15.06,Default,,0,0,0,,Осылайша құралдың қабілетін толық шығару мүмкін емес.
Dialogue: 0,0:07:15.14,0:07:17.77,Default,,0,0,0,,Қолайсыз жағдайда болу мүмкіндігі
Dialogue: 0,0:07:18.81,0:07:19.81,Default,,0,0,0,,Жарақат салып жүріп, Магистрдің Қызына дәл ұқсайтын мүсін ойып тастапсың.
Dialogue: 0,0:07:20.81,0:07:21.65,Default,,0,0,0,,Мен жақсы сакэ әкелдім, сондықтан бүгін мені кешіріңіздер
Dialogue: 0,0:07:21.73,0:07:22.65,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:24.56,0:07:25.57,Default,,0,0,0,,Сенші!
Dialogue: 0,0:07:25.65,0:07:27.07,Default,,0,0,0,,Енді, Райос!
Dialogue: 0,0:07:27.15,0:07:27.78,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:27.86,0:07:28.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:29.07,0:07:33.07,Default,,0,0,0,,Гяаааааааааааааа...
Dialogue: 0,0:07:35.45,0:07:38.16,Default,,0,0,0,,Сіз жарақат алдыңыз ба? Мысық қыз...
Dialogue: 0,0:07:39.20,0:07:42.58,Default,,0,0,0,,Саған еліктеп таң қалдырғаным үшін өкіндім, бірақ...
Dialogue: 0,0:07:42.67,0:07:44.25,Default,,0,0,0,,Құралдарды ұстау жолы
Dialogue: 0,0:07:44.33,0:07:47.09,Default,,0,0,0,,Неліктен жақсылық пен жамандық бар?
Dialogue: 0,0:07:47.17,0:07:49.55,Default,,0,0,0,,Бұл туралы бір рет ойланыңыз.
Dialogue: 0,0:07:49.63,0:07:52.63,Default,,0,0,0,,Сиқырды жою кезінде кейде ол қозғалмайды.
Dialogue: 0,0:07:53.22,0:07:54.34,Default,,0,0,0,,Бұл қиынырақ әдіс болса ше?
Dialogue: 0,0:07:54.43,0:07:55.89,Default,,0,0,0,,Не болды...
Dialogue: 0,0:07:55.97,0:07:57.85,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:57.93,0:08:00.39,Default,,0,0,0,,Тағам суып кетті.
Dialogue: 0,0:08:00.48,0:08:02.27,Default,,0,0,0,,Дереу қайта қыздырыңыз
Dialogue: 0,0:08:04.48,0:08:05.36,Default,,0,0,0,,Сонымен
Dialogue: 0,0:08:05.44,0:08:07.69,Default,,0,0,0,,Сіз бізге неге ілесіп жүрсіз?
Dialogue: 0,0:08:08.90,0:08:10.11,Default,,0,0,0,,Мен әрқашан болдым
Dialogue: 0,0:08:10.19,0:08:13.78,Default,,0,0,0,,Мен денемдегі бұл қарғысты жоюдың жолын іздедім.
Dialogue: 0,0:08:13.86,0:08:15.12,Default,,0,0,0,,(жалау дыбысы)
Dialogue: 0,0:08:15.70,0:08:18.74,Default,,0,0,0,,Мен бұл қара сиқырдан туындаған қарғыс екенін білдім.
Dialogue: 0,0:08:18.83,0:08:22.00,Default,,0,0,0,,Қара магияны қолдана алатын ешкім табылмады.
Dialogue: 0,0:08:22.87,0:08:23.50,Default,,0,0,0,,Онда...
Dialogue: 0,0:08:23.58,0:08:24.62,Default,,0,0,0,,Мен Мимичомен кездескенше
Dialogue: 0,0:08:25.54,0:08:28.30,Default,,0,0,0,,Қара... Бұл ежелгі сиқыр болса да, неше түрлі түрі бар.
Dialogue: 0,0:08:28.38,0:08:30.88,Default,,0,0,0,,Менің зерттеуім негізінен басқа өлшемдерден келетін энергияға бағытталған.
Dialogue: 0,0:08:30.96,0:08:31.76,Default,,0,0,0,,Алдамаңыз!
Dialogue: 0,0:08:32.34,0:08:34.01,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:08:34.09,0:08:36.64,Default,,0,0,0,,Өйткені сіз мұны шынымен жасадыңыз!
Dialogue: 0,0:08:36.72,0:08:40.18,Default,,0,0,0,,Адамдар мен құбыжықтардың оғаш формаларын жасайтын қара магия!
Dialogue: 0,0:08:41.64,0:08:44.98,Default,,0,0,0,,Ендеше... бәрің де сол әйелдің қарғысын бұзуларың керек.
Dialogue: 0,0:08:45.06,0:08:46.69,Default,,0,0,0,,Сіз лабиринт арқылы өтіп бара жатырсыз, солай ма?
Dialogue: 0,0:08:46.77,0:08:49.90,Default,,0,0,0,,Бұл сіз қарғысты бұзуды білесіз бе?
Dialogue: 0,0:08:49.98,0:08:52.40,Default,,0,0,0,,Сонда менің қарғысым жойылар еді.
Dialogue: 0,0:08:52.99,0:08:56.57,Default,,0,0,0,,Мына хайуанның жанын мені иемденуден ал!
Dialogue: 0,0:08:59.08,0:09:00.12,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:09:00.70,0:09:03.25,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын ...
Dialogue: 0,0:09:04.08,0:09:04.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:05.25,0:09:08.13,Default,,0,0,0,,Жан түсінбейтін дүниелер әлі де көп.
Dialogue: 0,0:09:08.67,0:09:10.42,Default,,0,0,0,,Көбінесе жұмыртқамен салыстырылады
Dialogue: 0,0:09:11.17,0:09:14.09,Default,,0,0,0,,Әдетте дененің қабықшасының ішінде, бірақ
Dialogue: 0,0:09:14.17,0:09:16.80,Default,,0,0,0,,Дене ыдырағанда ішіндегісі ағып кетеді.
Dialogue: 0,0:09:16.89,0:09:18.39,Default,,0,0,0,,Ол ешқашан қалыпты жағдайға оралмайды.
Dialogue: 0,0:09:19.76,0:09:20.89,Default,,0,0,0,,Бұл лабиринтте
Dialogue: 0,0:09:20.97,0:09:24.52,Default,,0,0,0,,Қабықтың ішінде берік қабық жасау үшін қолданылатын әдіс бар.
Dialogue: 0,0:09:24.60,0:09:27.02,Default,,0,0,0,,Зардап алсам да, жаным кетпейді
Dialogue: 0,0:09:28.06,0:09:29.90,Default,,0,0,0,,Енді сіз және Фарин
Dialogue: 0,0:09:29.98,0:09:33.28,Default,,0,0,0,,Бір қабықтың екі мазмұны бар күй...
Dialogue: 0,0:09:34.03,0:09:36.61,Default,,0,0,0,,Жандар бір кезде араласқан
Dialogue: 0,0:09:36.70,0:09:38.87,Default,,0,0,0,,Ол ешқашан өзінің бастапқы түріне оралмайды...
Dialogue: 0,0:09:40.03,0:09:41.16,Default,,0,0,0,,Мен түсіндім, бірақ
Dialogue: 0,0:09:41.24,0:09:43.12,Default,,0,0,0,,Сіз мұны анық айтқан кезде...
Dialogue: 0,0:09:43.20,0:09:44.20,Default,,0,0,0,,(Тостағанның құлаған дыбысы)
Dialogue: 0,0:09:44.29,0:09:45.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:45.91,0:09:47.96,Default,,0,0,0,,Онда неге балалар?
Dialogue: 0,0:09:48.04,0:09:50.21,Default,,0,0,0,,Саяхатыңызды жалғастырып жатырсыз ба?
Dialogue: 0,0:09:50.92,0:09:52.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:52.50,0:09:53.55,Default,,0,0,0,,Бірі
Dialogue: 0,0:09:53.63,0:09:56.42,Default,,0,0,0,,Мен апамды ондай күйде жалғыз қалдыра алмаймын.
Dialogue: 0,0:09:56.51,0:09:59.18,Default,,0,0,0,,Мен келесі кездескен авантюристі өлтіруім мүмкін.
Dialogue: 0,0:09:59.84,0:10:01.10,Default,,0,0,0,,Сізді өлтіруі мүмкін...
Dialogue: 0,0:10:01.93,0:10:03.77,Default,,0,0,0,,Бұған дейін біз бірдеңе жасағымыз келеді.
Dialogue: 0,0:10:04.39,0:10:04.98,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:10:05.52,0:10:09.35,Default,,0,0,0,,Егер мен қазір жай ғана жерге оралсам, қара магияны қолданғаным үшін тұтқынға аламын.
Dialogue: 0,0:10:09.44,0:10:12.57,Default,,0,0,0,,Шроу бұл оқиға туралы арал иесіне хабарлайды.
Dialogue: 0,0:10:13.44,0:10:14.73,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:15.32,0:10:16.86,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:10:16.95,0:10:18.11,Default,,0,0,0,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,0:10:18.20,0:10:19.49,Default,,0,0,0,,Жоқ, бірақ мен!
Dialogue: 0,0:10:20.16,0:10:21.66,Default,,0,0,0,,Бұлай айтудың өзі біртүрлі.
Dialogue: 0,0:10:21.74,0:10:23.99,Default,,0,0,0,,Сізбен танысқаныма өте қуаныштымын!
Dialogue: 0,0:10:24.08,0:10:26.33,Default,,0,0,0,,Қандай құбыжықпен араласып кеткенін білмеймін.
Dialogue: 0,0:10:26.41,0:10:28.83,Default,,0,0,0,,Сіздің сөздеріңіз бен әрекеттеріңіз адамға ғана ұқсайды.
Dialogue: 0,0:10:28.92,0:10:30.75,Default,,0,0,0,,Өлтіретін импульстар жоқ!
Dialogue: 0,0:10:30.83,0:10:32.59,Default,,0,0,0,,Артқа қарасаң, Фарин екен.
Dialogue: 0,0:10:32.67,0:10:34.92,Default,,0,0,0,,Егер сізді лабиринт басқармаса
Dialogue: 0,0:10:35.01,0:10:37.51,Default,,0,0,0,,Сіз өзіңіздің бастапқы тұлғаңызды қалпына келтіре аласыз.
Dialogue: 0,0:10:38.13,0:10:41.26,Default,,0,0,0,,Мұны білу мені...
Dialogue: 0,0:10:41.34,0:10:43.56,Default,,0,0,0,,Мен қазір өте бақыттымын...
Dialogue: 0,0:10:44.18,0:10:45.27,Default,,0,0,0,,-Қараңыз -Ah
Dialogue: 0,0:10:45.85,0:10:49.10,Default,,0,0,0,,Бұл сіз күткеннен сәл өзгеше болуы мүмкін.
Dialogue: 0,0:10:49.19,0:10:52.81,Default,,0,0,0,,Неліктен сіз бұл туралы жақсы ойламайсыз?
Dialogue: 0,0:10:53.36,0:10:55.03,Default,,0,0,0,,Бұл лабиринттің шебері
Dialogue: 0,0:10:55.11,0:10:58.11,Default,,0,0,0,,Ежелгі сиқырда маған қарағанда әлдеқайда жақсысың.
Dialogue: 0,0:10:58.61,0:11:02.07,Default,,0,0,0,,Оның тіпті жандардың бөлінуіне қатысы болуы мүмкін.
Dialogue: 0,0:11:02.16,0:11:03.78,Default,,0,0,0,,Мүмкін сіз бірдеңе білетін шығарсыз
Dialogue: 0,0:11:03.87,0:11:06.99,Default,,0,0,0,,Не? Сіз шынымен мені сұрап жатырсыз ба?
Dialogue: 0,0:11:07.08,0:11:10.50,Default,,0,0,0,,Қай жолмен? Жерге жалғыз қайту мүмкін емес.
Dialogue: 0,0:11:10.58,0:11:13.17,Default,,0,0,0,,Есіміңді Әсеби деп айттың ба?
Dialogue: 0,0:11:13.25,0:11:15.09,Default,,0,0,0,,Бұл көше атауы.
Dialogue: 0,0:11:15.17,0:11:16.13,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:11:16.21,0:11:19.09,Default,,0,0,0,,Изуцуми Менің атым Изуцуми.
Dialogue: 0,0:11:19.17,0:11:20.51,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:11:20.59,0:11:23.51,Default,,0,0,0,,Crumble
Dialogue: 0,0:11:24.68,0:11:27.14,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:11:28.02,0:11:30.44,Default,,0,0,0,,Хмм... га...
Dialogue: 0,0:11:30.52,0:11:31.90,Default,,0,0,0,,Лайос
Dialogue: 0,0:11:31.98,0:11:34.19,Default,,0,0,0,,Сіз қашанға дейін осылай өмір сүргіңіз келеді?
Dialogue: 0,0:11:35.02,0:11:35.86,Default,,0,0,0,,Ол дәрігер атағын биліктегілердің көңілін табу үшін пайдаланып жүр
Dialogue: 0,0:11:35.94,0:11:38.07,Default,,0,0,0,,Дұрыс өмір сүрудің уақыты келді
Dialogue: 0,0:11:38.15,0:11:41.95,Default,,0,0,0,,Мен сені айдаһарды өлтіру үшін сыртқа жіберген жоқпын.
Dialogue: 0,0:11:42.03,0:11:43.57,Default,,0,0,0,,Ауылға қайт!
Dialogue: 0,0:11:44.16,0:11:45.41,Default,,0,0,0,,Бірақ Фарин бар...
Dialogue: 0,0:11:45.49,0:11:47.29,Default,,0,0,0,,Бұл туралы ұмытыңыз.
Dialogue: 0,0:11:47.79,0:11:51.29,Default,,0,0,0,,Сіз сияқты адам сыртта жақсы жұмыс істей алады деп ойлайсыз ба?
Dialogue: 0,0:11:51.79,0:11:54.79,Default,,0,0,0,,Мектепке де, әскерге де сыймасам да, қашып кеттім.
Dialogue: 0,0:11:55.79,0:11:58.30,Default,,0,0,0,,Сізде лабиринттерді зерттеу қабілеті жоқ.
Dialogue: 0,0:11:58.80,0:12:02.01,Default,,0,0,0,,Алтынды аршып жатқанымдай, Достарыма алданып қалдым.
Dialogue: 0,0:12:02.09,0:12:03.30,Default,,0,0,0,,Несие алынып тасталды
Dialogue: 0,0:12:03.80,0:12:06.72,Default,,0,0,0,,Адамдарға көзің жоқ.
Dialogue: 0,0:12:07.31,0:12:08.97,Default,,0,0,0,,Мен үшін де солай.
Dialogue: 0,0:12:09.06,0:12:12.14,Default,,0,0,0,,Сен мені ең жақын досым деп ойладың.
Dialogue: 0,0:12:12.23,0:12:14.06,Default,,0,0,0,,Мен саған әрқашан жаман болдым...
Dialogue: 0,0:12:14.15,0:12:16.65,Default,,0,0,0,,Өте табанды! Бұл бітті
Dialogue: 0,0:12:16.73,0:12:18.36,Default,,0,0,0,,Жоқ, күте тұрыңыз ба?
Dialogue: 0,0:12:18.44,0:12:20.86,Default,,0,0,0,,Сенің ата-анаң не үшін?
Dialogue: 0,0:12:20.94,0:12:23.11,Default,,0,0,0,,Бір-бірімізді көрмегенімізге 10 жылдан асты.
Dialogue: 0,0:12:23.20,0:12:26.62,Default,,0,0,0,,Біріншіден, бұл қай жер? Сіз не істеп жүрсіз?
Dialogue: 0,0:12:26.70,0:12:28.20,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:12:31.71,0:12:33.87,Default,,0,0,0,,Бұл күндері Марсиль туралы не айта аламын...
Dialogue: 0,0:12:34.46,0:12:36.67,Default,,0,0,0,,Ол әбден шаршаған сияқты.
Dialogue: 0,0:12:37.46,0:12:38.29,Default,,0,0,0,,Марсиль
Dialogue: 0,0:12:38.38,0:12:41.72,Default,,0,0,0,,Бүгін біз сағатқа қамқорлық жасаймыз, сендер демалыңдар.
Dialogue: 0,0:12:41.80,0:12:44.38,Default,,0,0,0,,Не? Неліктен? Жақсы. Солай ма?
Dialogue: 0,0:12:44.47,0:12:46.55,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,0:12:46.64,0:12:49.39,Default,,0,0,0,,Сәлем! Қазірдің өзінде ол не?
Dialogue: 0,0:12:49.97,0:12:52.23,Default,,0,0,0,,Мен соншалықты шаршаған емеспін.
Dialogue: 0,0:12:52.31,0:12:55.48,Default,,0,0,0,,Мен жақында оянамын. Мен жалғызбын...
Dialogue: 0,0:12:55.56,0:12:56.31,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:12:56.40,0:12:58.57,Default,,0,0,0,,Бірақ ұйықтап жатқан тыныс жақын арада келеді
Dialogue: 0,0:12:58.65,0:13:00.57,Default,,0,0,0,,Дауыс жан түршігерлік дыбысқа айналды.
Dialogue: 0,0:13:01.48,0:13:03.82,Default,,0,0,0,,Не болды, сәлем Марсиль?
Dialogue: 0,0:13:03.90,0:13:05.45,Default,,0,0,0,,Бұл жай ғана факті емес.
Dialogue: 0,0:13:05.53,0:13:06.41,Default,,0,0,0,,Бұл құбыжық па?
Dialogue: 0,0:13:06.49,0:13:08.78,Default,,0,0,0,,Иә, арман жын шығар.
Dialogue: 0,0:13:08.87,0:13:13.04,Default,,0,0,0,,Ұйықтап жатқан адамдарды аңдып, қорқынышты түс көреді, эмоцияларымен қоректенеді.
Dialogue: 0,0:13:14.12,0:13:17.13,Default,,0,0,0,,Бұлай жалғаса берсе, Марсиль әлсіреп өледі.
Dialogue: 0,0:13:17.63,0:13:19.34,Default,,0,0,0,,Оян! марсиль
Dialogue: 0,0:13:19.42,0:13:21.76,Default,,0,0,0,,Егер сіз өзіңізді оятуға мәжбүр етсеңіз, бұл сіздің рухыңызды ауыртады.
Dialogue: 0,0:13:21.84,0:13:22.55,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:13:23.34,0:13:25.22,Default,,0,0,0,,Шро бұрын иеленген кезде
Dialogue: 0,0:13:25.30,0:13:27.55,Default,,0,0,0,,Фарин түске кіріп, көмектесті.
Dialogue: 0,0:13:28.26,0:13:30.05,Default,,0,0,0,,Сол әдісті қолданып көрейік
Dialogue: 0,0:13:30.14,0:13:32.35,Default,,0,0,0,,Сіз Марсильдің ішіндесіз бе?
Dialogue: 0,0:13:32.43,0:13:35.31,Default,,0,0,0,,Біреу маған мұның арман екенін ұғындыруы керек.
Dialogue: 0,0:13:35.39,0:13:38.69,Default,,0,0,0,,Армандаушыны жастық ретінде пайдаланыңыз...
Dialogue: 0,0:13:38.77,0:13:40.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:41.44,0:13:44.15,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:13:45.36,0:13:46.11,Default,,0,0,0,,(Лайостың ұйықтау тынысы)
Dialogue: 0,0:13:46.20,0:13:47.86,Default,,0,0,0,,Иә, мен.
Dialogue: 0,0:13:47.95,0:13:49.32,Default,,0,0,0,,Марсильге көмектесу үшін...
Dialogue: 0,0:13:50.03,0:13:51.87,Default,,0,0,0,,Бұл менің түсімде
Dialogue: 0,0:13:52.41,0:13:55.08,Default,,0,0,0,,Кобус маған солай дәм татты.
Dialogue: 0,0:13:55.16,0:13:56.46,Default,,0,0,0,,Әрқашан осылай
Dialogue: 0,0:13:56.54,0:13:58.71,Default,,0,0,0,,Мен адамдарға не ұнамайтынын білемін.
Dialogue: 0,0:13:59.29,0:14:02.34,Default,,0,0,0,,Бірақ мен мұның арман екенін түсінгенде, бұл арман болды.
Dialogue: 0,0:14:02.42,0:14:05.26,Default,,0,0,0,,Келіңіздер! Менің ең күшті қызметшім!
Dialogue: 0,0:14:10.18,0:14:13.22,Default,,0,0,0,,Енді Марсильдің арманына кіру үшін...
Dialogue: 0,0:14:13.93,0:14:16.48,Default,,0,0,0,,Қазір ол менің басымның астында.
Dialogue: 0,0:14:16.56,0:14:19.44,Default,,0,0,0,,Бұл сізге тек жерді қазып алу керек дегенді білдіреді.
Dialogue: 0,0:14:23.44,0:14:25.36,Default,,0,0,0,,Бұл арманның жақсы жағы.
Dialogue: 0,0:14:25.44,0:14:27.07,Default,,0,0,0,,Менің армандарым шектеулі...
Dialogue: 0,0:14:29.20,0:14:29.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:30.49,0:14:31.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:32.83,0:14:33.79,Default,,0,0,0,,Бұл қауіпті болды...
Dialogue: 0,0:14:34.37,0:14:36.41,Default,,0,0,0,,Құлап бара жатқаннан ояндым.
Dialogue: 0,0:14:37.71,0:14:38.58,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:38.67,0:14:40.75,Default,,0,0,0,,Марсиль түсінде...
Dialogue: 0,0:14:42.25,0:14:43.88,Default,,0,0,0,,Керемет нәрсе...
Dialogue: 0,0:14:43.96,0:14:45.59,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:14:45.67,0:14:47.09,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:47.67,0:14:49.93,Default,,0,0,0,,Бұл жерде қауіпті, тез қаш.
Dialogue: 0,0:14:51.55,0:14:52.80,Default,,0,0,0,,Марсиль?
Dialogue: 0,0:14:52.89,0:14:54.72,Default,,0,0,0,,А... сен кімсің?
Dialogue: 0,0:14:54.81,0:14:56.31,Default,,0,0,0,,Бұл менмін, Райос.
Dialogue: 0,0:14:56.39,0:14:58.81,Default,,0,0,0,,Бұл сіздің арманыңызда
Dialogue: 0,0:14:58.89,0:15:01.81,Default,,0,0,0,,Енді ояныңыз...
Dialogue: 0,0:15:01.90,0:15:03.02,Default,,0,0,0,,Шайқау?
Dialogue: 0,0:15:03.11,0:15:05.40,Default,,0,0,0,,А... ол келе жатыр.
Dialogue: 0,0:15:05.48,0:15:07.32,Default,,0,0,0,,Мен қашуым керек.
Dialogue: 0,0:15:07.40,0:15:08.24,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:15:08.32,0:15:09.95,Default,,0,0,0,,Жарайды, осылай!
Dialogue: 0,0:15:10.03,0:15:10.95,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:15:11.03,0:15:14.20,Default,,0,0,0,,Папа мен Пипиді де сол жігіт жұтып қойды.
Dialogue: 0,0:15:14.28,0:15:15.79,Default,,0,0,0,,Папа мен Пипи...
Dialogue: 0,0:15:16.87,0:15:18.71,Default,,0,0,0,,Бірдеңе қуған арман ба...
Dialogue: 0,0:15:18.79,0:15:21.29,Default,,0,0,0,,Бұл кәдімгі, бірақ жағымсыз түс...
Dialogue: 0,0:15:22.29,0:15:23.46,Default,,0,0,0,,Мен сенімдімін Фарин...
Dialogue: 0,0:15:24.21,0:15:26.80,Default,,0,0,0,,Қобалжыған көңілді жақсы көреді
Dialogue: 0,0:15:27.71,0:15:30.09,Default,,0,0,0,,Стресс және жарақат
Dialogue: 0,0:15:30.17,0:15:34.01,Default,,0,0,0,,Сол естеліктерді ынталандыру және адамдарға қорқынышты армандар беру
Dialogue: 0,0:15:35.10,0:15:38.18,Default,,0,0,0,,Сондықтан сол сезім жараларын қорғаған дұрыс.
Dialogue: 0,0:15:38.27,0:15:39.23,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:15:39.31,0:15:40.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:40.10,0:15:43.23,Default,,0,0,0,,Бірақ бұл қауіпті, сондықтан оны көшірмеңіз.
Dialogue: 0,0:15:43.31,0:15:45.23,Default,,0,0,0,,Яғни, осы адамдарға зиян келтіру...
Dialogue: 0,0:15:45.32,0:15:47.61,Default,,0,0,0,,Мен оны жеңемін!
Dialogue: 0,0:15:48.19,0:15:50.24,Default,,0,0,0,,Сіз не істеп жатырсыз? Бұл қауіпті
Dialogue: 0,0:15:50.32,0:15:53.11,Default,,0,0,0,,Жарайды, жарайды, мен мына сияқтымын, бірақ мен жақсымын...
Dialogue: 0,0:15:58.20,0:15:59.62,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:16:03.96,0:16:05.63,Default,,0,0,0,,Вааааааааааа...
Dialogue: 0,0:16:05.71,0:16:07.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:07.30,0:16:09.67,Default,,0,0,0,,Мен мұны түсінбеймін!
Dialogue: 0,0:16:09.76,0:16:11.67,Default,,0,0,0,,Марсиль осыдан қорқады ма?
Dialogue: 0,0:16:12.63,0:16:14.72,Default,,0,0,0,,Бұл біршама драматизацияланған сияқты.
Dialogue: 0,0:16:14.80,0:16:17.31,Default,,0,0,0,,Мен үшін бұл нәрсені жеңу мүмкін емес сияқты.
Dialogue: 0,0:16:18.14,0:16:21.64,Default,,0,0,0,,Егер адамның өзі арманын жүзеге асырса, ол енді жау емес...
Dialogue: 0,0:16:22.81,0:16:24.81,Default,,0,0,0,,Осы уақытқа дейін жеткен болсаң... Әй?
Dialogue: 0,0:16:24.90,0:16:26.90,Default,,0,0,0,,Ешбір орын қауіпсіз емес
Dialogue: 0,0:16:27.40,0:16:29.44,Default,,0,0,0,,Ешкім қарсы тұра алмайды...
Dialogue: 0,0:16:30.94,0:16:34.45,Default,,0,0,0,,Жарайды, оны қалай жеңетінін бірге ойланайық.
Dialogue: 0,0:16:35.91,0:16:38.16,Default,,0,0,0,,Марсиль неден қорқады?
Dialogue: 0,0:16:38.79,0:16:40.58,Default,,0,0,0,,Бұл құбыжық.
Dialogue: 0,0:16:41.41,0:16:43.29,Default,,0,0,0,,Баяу жорғалау қозғалысы
Dialogue: 0,0:16:43.37,0:16:45.96,Default,,0,0,0,,Сансыз шандырлы және ашкөз тәбеті бар
Dialogue: 0,0:16:46.50,0:16:47.92,Default,,0,0,0,,Бұл жиіркенішті көрінеді...
Dialogue: 0,0:16:48.71,0:16:49.84,Default,,0,0,0,,Бұл жәндіктер түрі ме?
Dialogue: 0,0:16:49.92,0:16:53.34,Default,,0,0,0,,Дегенмен, жәндіктер соншалықты үлкен ... өсуі қиын.
Dialogue: 0,0:16:53.97,0:16:56.14,Default,,0,0,0,,Жәндіктер Жәндіктер… Жәндіктер…
Dialogue: 0,0:16:56.22,0:16:57.10,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:16:57.18,0:16:58.76,Default,,0,0,0,,Бұл құрт!
Dialogue: 0,0:16:58.85,0:17:00.60,Default,,0,0,0,,Айдаһар тұқымдасына жататын құрт.
Dialogue: 0,0:17:00.68,0:17:03.60,Default,,0,0,0,,Оның аяқтары мен көздері тозып, үлкен құртқа ұқсайды.
Dialogue: 0,0:17:03.69,0:17:06.35,Default,,0,0,0,,Ашкөз, тірінің бәрін жейді.
Dialogue: 0,0:17:06.44,0:17:08.36,Default,,0,0,0,,Әлсіздік – от пен жарық!
Dialogue: 0,0:17:08.44,0:17:10.94,Default,,0,0,0,,Бұл өте ащы.
Dialogue: 0,0:17:11.03,0:17:12.61,Default,,0,0,0,,- (Жас Марсиль) А, а... - А?
Dialogue: 0,0:17:14.45,0:17:15.99,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:17:16.07,0:17:16.57,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:16.66,0:17:17.87,Default,,0,0,0,,Құдай-ай.
Dialogue: 0,0:17:17.95,0:17:18.74,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:18.83,0:17:20.74,Default,,0,0,0,,Қаш, қаш!
Dialogue: 0,0:17:21.37,0:17:24.00,Default,,0,0,0,,Ол саған қолын тигізді ме?
Dialogue: 0,0:17:24.08,0:17:25.04,Default,,0,0,0,,Мен оны жаңа ғана тырнап алдым.
Dialogue: 0,0:17:25.12,0:17:26.00,Default,,0,0,0,,Маған көрсет!
Dialogue: 0,0:17:26.08,0:17:27.38,Default,,0,0,0,,(балқыған дыбыс)
Dialogue: 0,0:17:27.46,0:17:28.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:29.71,0:17:31.25,Default,,0,0,0,,-Бұл не? - (Жас Марсиль) Хмм...
Dialogue: 0,0:17:31.88,0:17:33.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:33.34,0:17:37.09,Default,,0,0,0,,Кяаааааааа...
Dialogue: 0,0:17:38.59,0:17:40.10,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:17:40.18,0:17:42.77,Default,,0,0,0,,Жаман, үрей тудырды.
Dialogue: 0,0:17:42.85,0:17:45.02,Default,,0,0,0,,Кобустың күші артады
Dialogue: 0,0:17:49.36,0:17:51.27,Default,,0,0,0,,Қаншалықты улы...
Dialogue: 0,0:17:51.36,0:17:53.94,Default,,0,0,0,,Біреудің түсінде өлсең не болады...?
Dialogue: 0,0:17:54.61,0:17:58.11,Default,,0,0,0,,Жоқ, егер сіз алаңдаушылық немесе қорқыныш сезінсеңіз, бұл туралы ойланыңыз.
Dialogue: 0,0:17:58.20,0:18:00.03,Default,,0,0,0,,Марсильді көтермелеу
Dialogue: 0,0:18:00.62,0:18:03.49,Default,,0,0,0,,Жарайды, сенің сиқырлы күштерің бар.
Dialogue: 0,0:18:03.58,0:18:06.00,Default,,0,0,0,,Ол жігітті өзің жеңе алуың керек.
Dialogue: 0,0:18:07.00,0:18:08.04,Default,,0,0,0,,Сиқыр...
Dialogue: 0,0:18:09.67,0:18:10.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:10.88,0:18:11.88,Default,,0,0,0,,Уау
Dialogue: 0,0:18:13.38,0:18:15.55,Default,,0,0,0,,Өріс одан сайын тұрақсыз болады...
Dialogue: 0,0:18:15.63,0:18:17.18,Default,,0,0,0,,Мен жаман нәрсе айттым ба?
Dialogue: 0,0:18:17.26,0:18:18.30,Default,,0,0,0,,Ел көлеміндегі ең ізденетін Зұлымдар Альянсы
Dialogue: 0,0:18:18.89,0:18:22.22,Default,,0,0,0,,Өйткені мен оны жеңу үшін сиқыр қолдандым.
Dialogue: 0,0:18:22.76,0:18:25.39,Default,,0,0,0,,Мына бала осылай көрінді.
Dialogue: 0,0:18:26.68,0:18:30.19,Default,,0,0,0,,Мына бала... Бұл Фарин кездейсоқ па?
Dialogue: 0,0:18:30.27,0:18:31.94,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:32.02,0:18:33.69,Default,,0,0,0,,Сол реанимация техникасының арқасында Марсиль
Dialogue: 0,0:18:33.78,0:18:36.03,Default,,0,0,0,,Мен Фаринмен болған оқиғаға өкінемін.
Dialogue: 0,0:18:36.11,0:18:38.70,Default,,0,0,0,,Егер сіз оны жеңуге тырыссаңыз, бұл...
Dialogue: 0,0:18:39.28,0:18:41.28,Default,,0,0,0,,Марсиль өлімнен қорқады.
Dialogue: 0,0:18:41.78,0:18:43.58,Default,,0,0,0,,Ал... Мен тағы келдім.
Dialogue: 0,0:18:44.16,0:18:46.58,Default,,0,0,0,,Сіз жай ғана қашып кете алмайсыз!
Dialogue: 0,0:18:46.66,0:18:48.41,Default,,0,0,0,,Сізге тұру керек!
Dialogue: 0,0:18:48.50,0:18:49.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:49.17,0:18:51.46,Default,,0,0,0,,Жарайды, қорқудың қажеті жоқ.
Dialogue: 0,0:18:51.54,0:18:53.42,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:18:53.50,0:18:55.84,Default,,0,0,0,,Бұл лабиринтте өлсең де қайта тірілуге ​​болады.
Dialogue: 0,0:18:55.92,0:18:56.59,Default,,0,0,0,,Тіпті Фарин
Dialogue: 0,0:18:56.67,0:18:59.34,Default,,0,0,0,,Сіздің реанимация техникаңыздың арқасында мен әлі тірімін.
Dialogue: 0,0:18:59.93,0:19:01.64,Default,,0,0,0,,Тіпті мәйіттер де таныс болды, солай ма?
Dialogue: 0,0:19:01.72,0:19:03.35,Default,,0,0,0,,Иә, иә~
Dialogue: 0,0:19:06.18,0:19:07.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:07.93,0:19:09.60,Default,,0,0,0,,Сорылған!
Dialogue: 0,0:19:09.69,0:19:11.35,Default,,0,0,0,,Не? Жоқ!
Dialogue: 0,0:19:11.44,0:19:13.11,Default,,0,0,0,,Мен ғана дем алып жатырмын
Dialogue: 0,0:19:13.19,0:19:14.69,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:18.07,0:19:19.61,Default,,0,0,0,,Улы емес
Dialogue: 0,0:19:19.70,0:19:22.12,Default,,0,0,0,,Мен өте тез қартаямын.
Dialogue: 0,0:19:23.07,0:19:25.45,Default,,0,0,0,,Сәл күте тұршы, Марсиль, мен дем ала алмаймын...
Dialogue: 0,0:19:26.95,0:19:28.50,Default,,0,0,0,,Бірдеңе дұрыс емес...
Dialogue: 0,0:19:28.58,0:19:31.25,Default,,0,0,0,,Мұны істей алатын тірі заттар бар ма?
Dialogue: 0,0:19:31.33,0:19:33.71,Default,,0,0,0,,Мүмкін бұл тірі зат емес шығар...
Dialogue: 0,0:19:33.79,0:19:36.38,Default,,0,0,0,,Менімен бірге келмейсің бе?
Dialogue: 0,0:19:36.46,0:19:39.51,Default,,0,0,0,,Жоқ, мен сәл демалғаннан кейін қайта жүгіре аламын.
Dialogue: 0,0:19:39.59,0:19:42.76,Default,,0,0,0,,Өтірік! Барлығы менімен жүгіруді қояды
Dialogue: 0,0:19:42.84,0:19:44.85,Default,,0,0,0,,Ол мені жұтып қойды
Dialogue: 0,0:19:44.93,0:19:48.35,Default,,0,0,0,,Папа, Пипи, Фарин, бәріңіз!
Dialogue: 0,0:19:48.43,0:19:51.69,Default,,0,0,0,,Сондықтан мен сиқырды көп зерттедім.
Dialogue: 0,0:19:51.77,0:19:55.02,Default,,0,0,0,,Фаринді осылай етіп көрсеткен болса.
Dialogue: 0,0:19:55.11,0:19:57.28,Default,,0,0,0,,Жағдайды бақылауға алдық, бірақ
Dialogue: 0,0:19:58.73,0:20:01.70,Default,,0,0,0,,Әкең жастай қайтыс болды ма?
Dialogue: 0,0:20:02.32,0:20:05.41,Default,,0,0,0,,Әкемнің жерлеу рәсімінде анам айтты.
Dialogue: 0,0:20:05.49,0:20:09.04,Default,,0,0,0,,Мен басқаларға қарағанда басқа жылдамдықпен жүгіремін дейді.
Dialogue: 0,0:20:09.54,0:20:13.46,Default,,0,0,0,,Мен көп адамдарды ұзатуға тура келеді.
Dialogue: 0,0:20:14.00,0:20:16.59,Default,,0,0,0,,Айтпақшы, Пипи туыс па?
Dialogue: 0,0:20:16.67,0:20:17.67,Default,,0,0,0,,Бұл құс.
Dialogue: 0,0:20:17.75,0:20:19.01,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:19.51,0:20:22.59,Default,,0,0,0,,Марсиль өлімнен қорықпайды.
Dialogue: 0,0:20:22.68,0:20:26.01,Default,,0,0,0,,Жақын адам сенен бұрын өліп қала ма деген уайым...
Dialogue: 0,0:20:32.14,0:20:32.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:32.85,0:20:34.44,Default,,0,0,0,,Марсиль! Тынышталыңыз
Dialogue: 0,0:20:34.52,0:20:37.19,Default,,0,0,0,,Сіз қаншалықты қорқатын болсаңыз, соғұрлым ол күштірек болады.
Dialogue: 0,0:20:37.27,0:20:38.94,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:20:39.03,0:20:41.07,Default,,0,0,0,,Мен не істеуім керек? Мен ештеңе істей алмаймын!
Dialogue: 0,0:20:41.15,0:20:42.70,Default,,0,0,0,,Жоқ, мүмкін!
Dialogue: 0,0:20:42.78,0:20:45.20,Default,,0,0,0,,Өйткені Марсиль керемет!
Dialogue: 0,0:20:45.28,0:20:47.28,Default,,0,0,0,,Қараңдар! осы кітаптың нөмірі
Dialogue: 0,0:20:47.78,0:20:50.29,Default,,0,0,0,,Түсімде ештеңе болған жоқ!
Dialogue: 0,0:20:50.79,0:20:53.46,Default,,0,0,0,,Сіз бұрыннан тырысып келдіңіз, солай емес пе?
Dialogue: 0,0:20:53.54,0:20:56.04,Default,,0,0,0,,Көңіліңізді түсірмеңіз! Өзіңізге сенімді болыңыз!
Dialogue: 0,0:20:56.54,0:20:58.34,Default,,0,0,0,,Сәттілік Марсиль!
Dialogue: 0,0:20:58.42,0:21:00.34,Default,,0,0,0,,Жоқ, тұр.
Dialogue: 0,0:21:00.42,0:21:02.97,Default,,0,0,0,,Ақыр соңында қашайық...
Dialogue: 0,0:21:03.05,0:21:05.72,Default,,0,0,0,,Менің сиқырым жетілмеген!
Dialogue: 0,0:21:05.80,0:21:08.26,Default,,0,0,0,,Кітап сол балада болса ғой
Dialogue: 0,0:21:08.85,0:21:11.56,Default,,0,0,0,,Мен сиқырды жақсырақ қолдана алсам да...
Dialogue: 0,0:21:11.64,0:21:13.60,Default,,0,0,0,,-Олай болса солай деп үміттенейік! - (Жас Марсиль) А.
Dialogue: 0,0:21:14.19,0:21:16.73,Default,,0,0,0,,Егер сіз қатты қаласаңыз, бәрі мүмкін!
Dialogue: 0,0:21:16.81,0:21:17.94,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:21:18.02,0:21:19.86,Default,,0,0,0,,Келесі жолы жақсы болатыныңызға сенімдімін
Dialogue: 0,0:21:19.94,0:21:21.36,Default,,0,0,0,,Гвааах…
Dialogue: 0,0:21:21.44,0:21:24.61,Default,,0,0,0,,А... Жоқ, жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:21:24.70,0:21:25.95,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:32.58,0:21:33.75,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:21:34.83,0:21:37.38,Default,,0,0,0,,Иә, Марсиль, жүр!
Dialogue: 0,0:21:37.46,0:21:39.25,Default,,0,0,0,,Вааааааааааааааааааааааааа
Dialogue: 0,0:21:39.34,0:21:40.04,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:21:48.01,0:21:51.31,Default,,0,0,0,,Сіз оны осылай пайдаланасыз ба?
Dialogue: 0,0:21:53.68,0:21:54.56,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:54.64,0:21:56.31,Default,,0,0,0,,О, ояусың ба?
Dialogue: 0,0:21:56.39,0:21:59.36,Default,,0,0,0,,Екеуміз бірге күлдік. Сенімен бәрі жақсы ма?
Dialogue: 0,0:21:59.44,0:22:01.86,Default,,0,0,0,,Мен жақсы есімде жоқ
Dialogue: 0,0:22:01.94,0:22:04.36,Default,,0,0,0,,Мен шаршаған түс көргендей болдым...
Dialogue: 0,0:22:04.44,0:22:05.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:05.90,0:22:09.07,Default,,0,0,0,,А... Мм
Dialogue: 0,0:22:09.16,0:22:10.20,Default,,0,0,0,,Мен қайтадан ұйықтаймын!
Dialogue: 0,0:22:10.28,0:22:12.37,Default,,0,0,0,,Жоқ! Оян, Марсиль!
Dialogue: 0,0:22:13.79,0:22:14.75,Default,,0,0,0,,Арман...?
Dialogue: 0,0:22:15.33,0:22:16.62,Default,,0,0,0,,Мен жақсы есімде жоқ
Dialogue: 0,0:22:16.71,0:22:19.58,Default,,0,0,0,,Мен жағымды түс көргендей болдым.
Dialogue: 0,0:22:19.67,0:22:21.29,Default,,0,0,0,,Бұл сәтті болған сияқты.
Dialogue: 0,0:22:21.38,0:22:22.88,Default,,0,0,0,,«Оның аман-есен жетуін қамтамасыз етші.»
Dialogue: 0,0:22:22.96,0:22:24.51,Default,,0,0,0,,Маған жастық беріңізші.
Dialogue: 0,0:22:24.59,0:22:25.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:27.22,0:22:28.68,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:28.76,0:22:29.43,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:22:29.51,0:22:31.01,Default,,0,0,0,,Қорқыныш
Dialogue: 0,0:22:31.10,0:22:32.89,Default,,0,0,0,,Мына жігіт адамдардың жастығына тығылып отыр.
Dialogue: 0,0:22:32.97,0:22:34.68,Default,,0,0,0,,Бұл маған қорқынышты түс береді.
Dialogue: 0,0:22:35.35,0:22:37.56,Default,,0,0,0,,Бұл әлі де үлкен сома.
Dialogue: 0,0:22:37.64,0:22:39.85,Default,,0,0,0,,Мүмкін ол жастығыңда біраз уақыт тығылып жатқан шығар.
Dialogue: 0,0:22:39.94,0:22:40.69,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:22:40.77,0:22:42.65,Default,,0,0,0,,Сенши, мынаны жесем болады ма?
Dialogue: 0,0:22:42.73,0:22:44.73,Default,,0,0,0,,Мен әрқашан дәмге қызығатынмын.
Dialogue: 0,0:22:44.82,0:22:46.19,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:22:46.74,0:22:49.16,Default,,0,0,0,,Алдымен қоқысты түкіріп алайық.
Dialogue: 0,0:22:50.24,0:22:53.03,Default,,0,0,0,,Оны біраз уақыт ыстық суға салып қойыңыз.
Dialogue: 0,0:22:53.12,0:22:54.16,Default,,0,0,0,,Әй?
Dialogue: 0,0:22:54.24,0:22:57.12,Default,,0,0,0,,Бұл түнгі түн Шин деп те аталады.
Dialogue: 0,0:22:57.20,0:22:59.00,Default,,0,0,0,,Негізінде бұл айдаһар тұқымдасының мүшесі.
Dialogue: 0,0:22:59.08,0:23:01.04,Default,,0,0,0,,Мұқият қарасаңыз, айдаһарға ұқсайды, солай ма?
Dialogue: 0,0:23:01.13,0:23:02.00,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,0:23:02.50,0:23:06.26,Default,,0,0,0,,Ерітілген сары майдың үстіне түнгі түндерді қойыңыз.
Dialogue: 0,0:23:06.34,0:23:08.63,Default,,0,0,0,,Шарап қосып, жабыңыз
Dialogue: 0,0:23:12.01,0:23:15.18,Default,,0,0,0,,Соңында аздап соя соусын қосамыз...
Dialogue: 0,0:23:15.26,0:23:16.22,Default,,0,0,0,,Орындалды
Dialogue: 0,0:23:16.31,0:23:17.73,Default,,0,0,0,,иә?
Dialogue: 0,0:23:19.23,0:23:20.39,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:20.48,0:23:22.44,Default,,0,0,0,,А, бұл менмін.
Dialogue: 0,0:23:22.52,0:23:26.03,Default,,0,0,0,,Қошмар жеген түс сағымға айналды.
Dialogue: 0,0:23:26.11,0:23:28.69,Default,,0,0,0,,Мүмкін есіме бірдеңе түсіп кеткен шығар...
Dialogue: 0,0:23:28.78,0:23:31.82,Default,,0,0,0,,Дұрыс, егер мен бір нәрседен қашып жүрсем
Dialogue: 0,0:23:31.91,0:23:33.49,Default,,0,0,0,,Бір ит шықты
Dialogue: 0,0:23:34.45,0:23:37.95,Default,,0,0,0,,Сол баламен бірге қазына табу үшін шытырман оқиғаға барыңыз.
Dialogue: 0,0:23:38.04,0:23:40.29,Default,,0,0,0,,Бұл қызық түс болды.
Dialogue: 0,0:23:40.37,0:23:42.29,Default,,0,0,0,,Қандай лас ит.
Dialogue: 0,0:23:42.38,0:23:43.96,Default,,0,0,0,,Ақылсыз сияқты
Dialogue: 0,0:23:44.04,0:23:45.67,Default,,0,0,0,,Не болды, Лайос?
Dialogue: 0,0:23:46.21,0:23:49.84,Default,,0,0,0,,Менің жадымда күміс қасқыр болуы керек еді...
Dialogue: 0,0:23:49.92,0:23:53.09,Default,,0,0,0,,Жақсы арманға үлесімді қоссам.
Dialogue: 0,0:23:53.18,0:23:54.10,Default,,0,0,0,,Жақсы шықты
Dialogue: 0,0:23:54.18,0:23:57.26,Default,,0,0,0,,(Кішкентай Марсильдің күлкісі)
Dialogue: 0,0:24:01.06,0:24:03.06,Default,,0,0,0,,♪~
Dialogue: 0,0:25:28.11,0:25:30.11,Default,,0,0,0,,~♪
