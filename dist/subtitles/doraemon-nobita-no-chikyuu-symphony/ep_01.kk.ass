Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.97,0:00:21.47,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:00:21.56,0:00:26.56,Default,,0,0,0,,(Қарды басқан дыбыс)
Dialogue: 0,0:00:30.73,0:00:32.57,Default,,0,0,0,,Я...
Dialogue: 0,0:00:34.70,0:00:39.16,Default,,0,0,0,,(Құстар мен жануарлардың дыбыстары)
Dialogue: 0,0:00:39.24,0:00:40.37,Default,,0,0,0,,Ах…
Dialogue: 0,0:00:45.92,0:00:48.13,Default,,0,0,0,,(аққудың айқайы)
Dialogue: 0,0:00:53.97,0:00:54.80,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:01:00.85,0:01:02.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:07.56,0:01:09.65,Default,,0,0,0,,(Соқтығысқан дыбыс)
Dialogue: 0,0:01:13.19,0:01:14.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:18.74,0:01:19.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:21.53,0:01:23.62,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:01:23.70,0:01:24.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:41.47,0:01:44.77,Default,,0,0,0,,(Флейта мен барабан әуені)
Dialogue: 0,0:01:41.47,0:01:44.77,Default,,0,0,0,,♪～
Dialogue: 0,0:01:44.85,0:01:46.35,Default,,0,0,0,,(аққудың айқайы)
Dialogue: 0,0:01:54.32,0:01:55.74,Default,,0,0,0,,(аққудың айқайы)
Dialogue: 0,0:01:57.45,0:02:01.53,Default,,0,0,0,,(ритмикалық балға дыбысы)
Dialogue: 0,0:02:21.51,0:02:25.52,Default,,0,0,0,,Оны осы әлемге байлап қою үшін—
Dialogue: 0,0:02:39.15,0:02:40.61,Default,,0,0,0,,(аққудың айқайы)
Dialogue: 0,0:02:48.12,0:02:53.13,Default,,0,0,0,,～♪
Dialogue: 0,0:02:57.01,0:03:01.55,Default,,0,0,0,,(Диктофонның өнімділігі: «Диктофонның тапсырмасы»)
Dialogue: 0,0:03:03.30,0:03:04.97,Default,,0,0,0,,(таза емес дыбыс)
Dialogue: 0,0:03:06.64,0:03:09.64,Default,,0,0,0,,…
Dialogue: 0,0:03:12.73,0:03:15.52,Default,,0,0,0,,(таза емес дыбыс)
Dialogue: 0,0:03:15.61,0:03:17.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:17.73,0:03:18.82,Default,,0,0,0,,(таза емес дыбыс)
Dialogue: 0,0:03:18.90,0:03:21.03,Default,,0,0,0,,-Пфф! -Хахаха!
Dialogue: 0,0:03:21.11,0:03:23.11,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,0:03:23.20,0:03:24.57,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:03:24.66,0:03:26.87,Default,,0,0,0,,Бұл өте ерекше қойылым.
Dialogue: 0,0:03:26.95,0:03:28.33,Default,,0,0,0,,Айтпақшы, барлығы
Dialogue: 0,0:03:28.41,0:03:31.54,Default,,0,0,0,,Дүние жүзіндегі ең көне музыкалық аспап қандай деп ойлайсың?
Dialogue: 0,0:03:31.62,0:03:34.00,Default,,0,0,0,,Хмм, бұл не екені қызық.
Dialogue: 0,0:03:34.08,0:03:37.34,Default,,0,0,0,,Фортепиано... солай емес пе?
Dialogue: 0,0:03:37.42,0:03:38.25,Default,,0,0,0,,Солардың бірі
Dialogue: 0,0:03:38.34,0:03:40.26,Default,,0,0,0,,Айтылады
Dialogue: 0,0:03:40.34,0:03:41.47,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:03:41.55,0:03:45.09,Default,,0,0,0,,Бұл Германияда шамамен 40 000 жыл бұрын жасалған.
Dialogue: 0,0:03:45.18,0:03:47.72,Default,,0,0,0,,Аққу сүйегінен жасалған сыбызғы.
Dialogue: 0,0:03:47.81,0:03:51.23,Default,,0,0,0,,Нағыз нәрсені Уэнодағы мұражайдан көруге болады
Dialogue: 0,0:03:51.81,0:03:54.60,Default,,0,0,0,,Керемет! Бұл керемет!
Dialogue: 0,0:03:54.69,0:03:56.94,Default,,0,0,0,,Қазір барлығы ойнап жатқан магнитофон
Dialogue: 0,0:03:57.02,0:03:58.57,Default,,0,0,0,,Оның ұрпақтары.
Dialogue: 0,0:03:58.65,0:04:00.90,Default,,0,0,0,,Сенпай, тоқта!
Dialogue: 0,0:04:00.99,0:04:05.62,Default,,0,0,0,,Енді күзгі концертке қызу жаттығу жасайық.
Dialogue: 0,0:04:05.70,0:04:07.12,Default,,0,0,0,,Иә
Dialogue: 0,0:04:07.20,0:04:10.58,Default,,0,0,0,,(Жасыл жарық әуені)
Dialogue: 0,0:04:10.66,0:04:13.29,Default,,0,0,0,,(Cicada хоры)
Dialogue: 0,0:04:13.37,0:04:16.25,Default,,0,0,0,,(Радиода ойналатын музыка)
Dialogue: 0,0:04:16.33,0:04:21.34,Default,,0,0,0,,(Қарттың ән салған дауысы)
Dialogue: 0,0:04:21.42,0:04:25.30,Default,,0,0,0,,Ватару!
Dialogue: 0,0:04:25.39,0:04:29.81,Default,,0,0,0,,♪ Nennnen kororiyo
Dialogue: 0,0:04:25.39,0:04:29.81,Default,,0,0,0,,(Ерлердің ысқыруы)
Dialogue: 0,0:04:29.89,0:04:32.27,Default,,0,0,0,,♪ Окорорийо
Dialogue: 0,0:04:32.35,0:04:35.69,Default,,0,0,0,,Аққу флейтасы сондай романтикалық.
Dialogue: 0,0:04:35.77,0:04:38.31,Default,,0,0,0,,Мен солай ойлаймын. Менде магнитофон жоқ...
Dialogue: 0,0:04:38.40,0:04:39.73,Default,,0,0,0,,(магнитофон дыбысы)
Dialogue: 0,0:04:39.82,0:04:42.11,Default,,0,0,0,,-Дэхехе... -(Сунео) Жоқ, бұл тым көп!
Dialogue: 0,0:04:42.19,0:04:44.36,Default,,0,0,0,,Не істесем де ондай дыбыс шығара алмаймын.
Dialogue: 0,0:04:44.45,0:04:46.70,Default,,0,0,0,,Сол ақымақ дыбыс туралы айтсақ...
Dialogue: 0,0:04:46.78,0:04:50.12,Default,,0,0,0,,Бұл жайбарақат және алаңсыз Нобитаның дыбысы.
Dialogue: 0,0:04:50.20,0:04:51.62,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:04:51.70,0:04:54.04,Default,,0,0,0,,Мен магнитофонмен жақсы емеспін!
Dialogue: 0,0:04:54.12,0:04:56.12,Default,,0,0,0,,Сонымен қатар, кішкене жаттығу арқылы,
Dialogue: 0,0:04:56.21,0:04:59.34,Default,,0,0,0,,Кез келген адам ойнауды үйрене алады!
Dialogue: 0,0:04:59.42,0:05:00.59,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:05:00.67,0:05:01.75,Default,,0,0,0,,Тіпті Нобита ма?
Dialogue: 0,0:05:01.84,0:05:05.76,Default,,0,0,0,,Ах! Қарсы болмасаң, құлағыммен көгершінді үрлеймін.
Dialogue: 0,0:05:06.43,0:05:11.47,Default,,0,0,0,,(Диктофонның өнімділігі)
Dialogue: 0,0:05:11.56,0:05:13.68,Default,,0,0,0,,Хм
Dialogue: 0,0:05:13.77,0:05:17.94,Default,,0,0,0,,Нобита Концертте аяғымызды тартсаң...
Dialogue: 0,0:05:18.02,0:05:20.02,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:05:20.11,0:05:22.15,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:05:22.23,0:05:24.11,Default,,0,0,0,,Қатты жаттығу!
Dialogue: 0,0:05:24.19,0:05:25.24,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:05:25.32,0:05:27.11,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:05:27.20,0:05:28.87,Default,,0,0,0,,Мен, келесі жолы
Dialogue: 0,0:05:28.95,0:05:31.16,Default,,0,0,0,,Мен Дива Минаның концертіне барамын.
Dialogue: 0,0:05:31.24,0:05:34.00,Default,,0,0,0,,Мина!? Мен де үлкен жанкүйермін.
Dialogue: 0,0:05:34.08,0:05:36.00,Default,,0,0,0,,Әрине, сенде де маған билет бар, солай ма?
Dialogue: 0,0:05:36.08,0:05:37.08,Default,,0,0,0,,Е!
Dialogue: 0,0:05:37.17,0:05:39.79,Default,,0,0,0,,Керемет! Жазушы сияқты
Dialogue: 0,0:05:39.88,0:05:41.17,Default,,0,0,0,,Мені мазақ ет!
Dialogue: 0,0:05:41.25,0:05:45.05,Default,,0,0,0,,Нобита жаттығу жасаса, мен оны ойнай алатынына сенімдімін.
Dialogue: 0,0:05:45.59,0:05:46.55,Default,,0,0,0,,Барымызды салайық!
Dialogue: 0,0:05:47.84,0:05:49.76,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:51.51,0:05:54.89,Default,,0,0,0,,Дораемон...
Dialogue: 0,0:05:57.81,0:05:59.31,Default,,0,0,0,,Шашың байланған екен.
Dialogue: 0,0:05:59.40,0:06:00.69,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:06:01.40,0:06:03.23,Default,,0,0,0,,Қайтадан қош келдіңіз~
Dialogue: 0,0:06:03.32,0:06:04.40,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:04.48,0:06:06.19,Default,,0,0,0,,Мен де үлкен жанкүйермін...
Dialogue: 0,0:06:06.28,0:06:07.49,Default,,0,0,0,,Ал...
Dialogue: 0,0:06:10.62,0:06:12.58,Default,,0,0,0,,Бұл драма мені жылатады~
Dialogue: 0,0:06:15.62,0:06:17.29,Default,,0,0,0,,Мен сені сағындым
Dialogue: 0,0:06:17.37,0:06:19.96,Default,,0,0,0,,Менің тәтті балым!
Dialogue: 0,0:06:20.04,0:06:21.50,Default,,0,0,0,,Дораемон
Dialogue: 0,0:06:21.58,0:06:24.34,Default,,0,0,0,,Менің сізден сұрайтыным бар...
Dialogue: 0,0:06:24.42,0:06:27.30,Default,,0,0,0,,Иә? сен не істеп жатырсың?
Dialogue: 0,0:06:27.38,0:06:29.55,Default,,0,0,0,,Ештеңе Ештеңе
Dialogue: 0,0:06:29.63,0:06:31.14,Default,,0,0,0,,Сіз бірдеңені жасырдыңыз, солай ма?
Dialogue: 0,0:06:31.22,0:06:33.60,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:06:33.68,0:06:35.60,Default,,0,0,0,,-Ах! -(Нобита) А, Дораяки!
Dialogue: 0,0:06:35.68,0:06:37.52,Default,,0,0,0,,Осыншама көптің не кінәсі бар?
Dialogue: 0,0:06:37.60,0:06:39.73,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:06:40.23,0:06:41.65,Default,,0,0,0,,-Ая! -(Нобита) А?
Dialogue: 0,0:06:42.44,0:06:43.27,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:43.36,0:06:45.48,Default,,0,0,0,,Бұл не? күнделік?
Dialogue: 0,0:06:45.98,0:06:47.11,Default,,0,0,0,,Егер ол жұмыс істемесе ше!
Dialogue: 0,0:06:47.74,0:06:48.74,Default,,0,0,0,,«Бүгінгі Дораяки»
Dialogue: 0,0:06:48.82,0:06:50.57,Default,,0,0,0,,«Мен 20 кесе жедім»
Dialogue: 0,0:06:51.16,0:06:53.53,Default,,0,0,0,,Енді оны жемейсің бе?
Dialogue: 0,0:06:53.62,0:06:55.03,Default,,0,0,0,,Я...
Dialogue: 0,0:06:55.62,0:06:57.62,Default,,0,0,0,,Бұл «алдын ала күнделік»
Dialogue: 0,0:06:57.70,0:07:00.71,Default,,0,0,0,,Күнделіктеріңізге не жазсаңыздар, дәл солай жазылады.
Dialogue: 0,0:07:00.79,0:07:01.75,Default,,0,0,0,,Я~
Dialogue: 0,0:07:01.83,0:07:05.00,Default,,0,0,0,,Бірақ бұл күнделікті пайдалану қиын!
Dialogue: 0,0:07:05.09,0:07:07.76,Default,,0,0,0,,Сондықтан мен оны сізге мүлдем бермеймін.
Dialogue: 0,0:07:07.84,0:07:09.42,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:09.51,0:07:10.43,Default,,0,0,0,,Әй, егеуқұйрық!
Dialogue: 0,0:07:10.51,0:07:13.47,Default,,0,0,0,,О, егеуқұйрық! Жоқ, жоқ, жоқ!
Dialogue: 0,0:07:14.18,0:07:15.64,Default,,0,0,0,,Қорқынышты егеуқұйрық Қорқынышты...
Dialogue: 0,0:07:15.72,0:07:19.14,Default,,0,0,0,,Кешіріңіз, кешіріңіз, мен қателестім деп ойлаймын.
Dialogue: 0,0:07:19.23,0:07:20.18,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:07:20.27,0:07:22.65,Default,,0,0,0,,Енді мені қорқытпа
Dialogue: 0,0:07:22.73,0:07:24.65,Default,,0,0,0,,Кешіріңіз, кешіріңіз, иә.
Dialogue: 0,0:07:25.69,0:07:27.57,Default,,0,0,0,,Ха~ Жақсы.
Dialogue: 0,0:07:27.65,0:07:30.15,Default,,0,0,0,,Ал, мен үй тапсырмасын орындаймын.
Dialogue: 0,0:07:30.24,0:07:31.90,Default,,0,0,0,,Не? Қазір ойлап қарасам, дәл қазір
Dialogue: 0,0:07:31.99,0:07:33.82,Default,,0,0,0,,Сенің маған қатысың бар сияқты көрінді...
Dialogue: 0,0:07:33.91,0:07:35.87,Default,,0,0,0,,Жарайды, себебі ол шешілген.
Dialogue: 0,0:07:35.95,0:07:37.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:37.16,0:07:38.79,Default,,0,0,0,,Иә, онда.
Dialogue: 0,0:07:39.45,0:07:42.54,Default,,0,0,0,,Иә? Тіпті қар жауып тұрған жоқ па?
Dialogue: 0,0:07:42.62,0:07:45.33,Default,,0,0,0,,Ахаха~ Бұл керемет~
Dialogue: 0,0:07:46.96,0:07:51.13,Default,,0,0,0,,Нихихихиуфуфухаха~
Dialogue: 0,0:07:51.22,0:07:53.72,Default,,0,0,0,,Барлығы жазылғандай бола ма?
Dialogue: 0,0:07:53.80,0:07:55.51,Default,,0,0,0,,Сізге тек осы ғана қажет!
Dialogue: 0,0:08:29.13,0:08:30.71,Default,,0,0,0,,(аққудың айқайы)
Dialogue: 0,0:08:33.67,0:08:34.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:48.52,0:08:51.78,Default,,0,0,0,,Нобита~ Ояныңыз~
Dialogue: 0,0:08:53.44,0:08:54.57,Default,,0,0,0,,Нобита~?
Dialogue: 0,0:08:54.65,0:08:55.49,Default,,0,0,0,,Келесі жаңалықтар
Dialogue: 0,0:08:55.57,0:08:57.07,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:08:57.16,0:08:59.58,Default,,0,0,0,,Астероидты зерттеуші лашын 2
Dialogue: 0,0:08:59.66,0:09:02.95,Default,,0,0,0,,Урашима астероидынан алынған үлгілер бойынша егжей-тегжейлі зерттеу
Dialogue: 0,0:09:03.04,0:09:06.46,Default,,0,0,0,,Әлемнің түкпір-түкпірінен келген ғалымдар тобы, соның ішінде Жапония
Dialogue: 0,0:09:06.54,0:09:08.25,Default,,0,0,0,,Орындалуда
Dialogue: 0,0:09:09.42,0:09:11.17,Default,,0,0,0,,Я~
Dialogue: 0,0:09:11.25,0:09:13.63,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:09:13.71,0:09:16.76,Default,,0,0,0,,(Жасыл жарық әуені жоқ)
Dialogue: 0,0:09:17.68,0:09:22.56,Default,,0,0,0,,А-а, бірінші сағат басталады.
Dialogue: 0,0:09:22.64,0:09:25.31,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:09:25.39,0:09:28.06,Default,,0,0,0,,Қоңырау Не болды?
Dialogue: 0,0:09:28.15,0:09:31.32,Default,,0,0,0,,Иә, музыка сабағын бастайық...
Dialogue: 0,0:09:31.40,0:09:33.78,Default,,0,0,0,,Ах, Хаттори мырза, сәл күте тұрыңыз.
Dialogue: 0,0:09:33.86,0:09:37.99,Default,,0,0,0,,Маған үйдегілер телефон соғып, үйге тез келуімді өтінді.
Dialogue: 0,0:09:38.07,0:09:39.99,Default,,0,0,0,,Ал... Жарайды.
Dialogue: 0,0:09:40.95,0:09:44.58,Default,,0,0,0,,Сондықтан бірінші сағат бос уақыт болады.
Dialogue: 0,0:09:44.66,0:09:45.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:46.54,0:09:48.42,Default,,0,0,0,,Доджбол ойнайық!
Dialogue: 0,0:09:48.50,0:09:50.08,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:50.17,0:09:54.21,Default,,0,0,0,,Иә! Музыка сабағы кетті.
Dialogue: 0,0:09:54.30,0:09:59.01,Default,,0,0,0,,Бұл күнделік керемет! Дәл мен жазғандай болып шықты!
Dialogue: 0,0:10:00.30,0:10:03.26,Default,,0,0,0,,Ал, тағы да...
Dialogue: 0,0:10:03.35,0:10:04.47,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:10:04.56,0:10:07.94,Default,,0,0,0,,Минаның концерті тоқтатылды.
Dialogue: 0,0:10:08.52,0:10:09.94,Default,,0,0,0,,Не болды, Джан?
Dialogue: 0,0:10:10.61,0:10:13.90,Default,,0,0,0,,Мен бүгін партизандық концертті өткіземін деп ойладым.
Dialogue: 0,0:10:13.98,0:10:16.15,Default,,0,0,0,,Менде қуыстар бар...
Dialogue: 0,0:10:16.24,0:10:18.11,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:10:18.20,0:10:19.11,Default,,0,0,0,,(қол соғу дыбысы)
Dialogue: 0,0:10:19.20,0:10:21.70,Default,,0,0,0,,Ән айта алмасаң ашуланба!
Dialogue: 0,0:10:21.78,0:10:24.33,Default,,0,0,0,,- Мен келдім... - (Сунео) А... а...
Dialogue: 0,0:10:24.41,0:10:25.83,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:10:25.91,0:10:29.92,Default,,0,0,0,,Қолдану керек пе... Қолданбау керек пе?
Dialogue: 0,0:10:30.00,0:10:32.42,Default,,0,0,0,,Аяая... мынау...
Dialogue: 0,0:10:32.50,0:10:33.84,Default,,0,0,0,,Оны қолданыңыз!
Dialogue: 0,0:10:33.92,0:10:36.13,Default,,0,0,0,,Ахх, бүгін 50 дана аласыз ба?
Dialogue: 0,0:10:36.21,0:10:37.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:37.63,0:10:38.67,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:39.84,0:10:41.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:41.93,0:10:43.51,Default,,0,0,0,,Міне... бұл!
Dialogue: 0,0:10:43.60,0:10:47.18,Default,,0,0,0,,Нобита-кунның үш күндік монах күнделігі...
Dialogue: 0,0:10:47.27,0:10:49.23,Default,,0,0,0,,Дора-чан, сәл күте тұрыңыз~
Dialogue: 0,0:10:49.31,0:10:50.23,Default,,0,0,0,,Кез келген нәрсені қия алады
Dialogue: 0,0:10:50.31,0:10:51.48,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:10:51.56,0:10:52.98,Default,,0,0,0,,Махаббатты бұзуға болмайды!
Dialogue: 0,0:10:53.81,0:10:54.98,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:10:55.07,0:10:56.48,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:10:57.32,0:10:59.20,Default,,0,0,0,,(Ватару) Жылама—барыңды салдын ғой, иә?—
Dialogue: 0,0:10:59.28,0:11:01.66,Default,,0,0,0,,Бұл теледидарда не болып жатыр?
Dialogue: 0,0:11:01.74,0:11:03.66,Default,,0,0,0,,Бұл жақсы жер!
Dialogue: 0,0:11:03.74,0:11:05.66,Default,,0,0,0,,Менде жағымсыз сезім бар
Dialogue: 0,0:11:06.70,0:11:09.08,Default,,0,0,0,,Енді соны жасап көрейік.
Dialogue: 0,0:11:31.81,0:11:33.06,Default,,0,0,0,,Такея~
Dialogue: 0,0:11:33.15,0:11:34.90,Default,,0,0,0,,Бүгін менің үйіме келгің келе ме?
Dialogue: 0,0:11:34.98,0:11:36.44,Default,,0,0,0,,Жүр, жүр!
Dialogue: 0,0:11:36.52,0:11:38.19,Default,,0,0,0,,Иә? Бірақ бүгін
Dialogue: 0,0:11:38.28,0:11:40.44,Default,,0,0,0,,Фортепиано сабағы емес пе еді?
Dialogue: 0,0:11:40.53,0:11:43.16,Default,,0,0,0,,Менің ұстазым шетелге іссапарға кетті.
Dialogue: 0,0:11:43.86,0:11:45.62,Default,,0,0,0,,-Кейін кездескенше -(Нобита) Иә!
Dialogue: 0,0:11:46.95,0:11:48.33,Default,,0,0,0,,Иә... Уау!
Dialogue: 0,0:11:48.41,0:11:51.25,Default,,0,0,0,,О, менің... Эй!
Dialogue: 0,0:11:51.33,0:11:53.75,Default,,0,0,0,,Күтілгендей! Сіз оны рұқсатсыз пайдаландыңыз!
Dialogue: 0,0:11:53.83,0:11:55.04,Default,,0,0,0,,Дораемон
Dialogue: 0,0:11:55.13,0:11:59.38,Default,,0,0,0,,Ал мен оны жазғанда, шынымен де музыка сабағы болған жоқ!
Dialogue: 0,0:11:59.46,0:12:03.01,Default,,0,0,0,,Маған бұдан былай магнитофонмен жаттығудың қажеті жоқ.
Dialogue: 0,0:12:03.09,0:12:05.47,Default,,0,0,0,,«Бүгін музыка болған жоқ».
Dialogue: 0,0:12:05.55,0:12:06.97,Default,,0,0,0,,«Бұл қызық болды»
Dialogue: 0,0:12:07.05,0:12:09.31,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:12:09.39,0:12:12.14,Default,,0,0,0,,Нобита-кунның кесірінен музыка сабағы болмады.
Dialogue: 0,0:12:12.23,0:12:15.69,Default,,0,0,0,,Музыканың өзі дүние жүзінде жоғалып кетті!
Dialogue: 0,0:12:15.77,0:12:17.65,Default,,0,0,0,,Иә!?
Dialogue: 0,0:12:17.73,0:12:19.61,Default,,0,0,0,,Өте жақсы емес.
Dialogue: 0,0:12:19.69,0:12:22.11,Default,,0,0,0,,Ата! Сіз...
Dialogue: 0,0:12:22.19,0:12:25.70,Default,,0,0,0,,Неееееееееееееееееееееееееееееееееееееееееееееееееееее...
Dialogue: 0,0:12:25.78,0:12:28.33,Default,,0,0,0,,Хмм... гохо гохо (ер ысқырық)
Dialogue: 0,0:12:28.41,0:12:30.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:30.75,0:12:32.79,Default,,0,0,0,,Уф... Эй!
Dialogue: 0,0:12:32.87,0:12:36.25,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:12:36.33,0:12:39.13,Default,,0,0,0,,Кәне, ән айтайық.
Dialogue: 0,0:12:39.21,0:12:40.71,Default,,0,0,0,,Уа!
Dialogue: 0,0:12:40.80,0:12:43.76,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:43.84,0:12:45.01,Default,,0,0,0,,Міне!
Dialogue: 0,0:12:45.76,0:12:47.05,Default,,0,0,0,,Уау
Dialogue: 0,0:12:47.14,0:12:49.39,Default,,0,0,0,,Барлығы, тоқтаңдар!
Dialogue: 0,0:12:51.81,0:12:53.73,Default,,0,0,0,,- (Бас) Ах - (Вокал) Иә?
Dialogue: 0,0:12:53.81,0:12:55.48,Default,,0,0,0,,Әй, бүгін неше рет болды?
Dialogue: 0,0:12:55.56,0:12:57.23,Default,,0,0,0,,Тіпті сен қателестің!
Dialogue: 0,0:12:57.31,0:12:59.40,Default,,0,0,0,,- (Вокал) Топ тарайды! -(Тұтынушылар) Ех!
Dialogue: 0,0:12:59.48,0:13:01.65,Default,,0,0,0,,Жақсы! 200 әнге арналған деректер
Dialogue: 0,0:13:01.73,0:13:03.82,Default,,0,0,0,,Мен бәрін жойдым!
Dialogue: 0,0:13:03.90,0:13:05.40,Default,,0,0,0,,Мұнда да жабық!?
Dialogue: 0,0:13:05.49,0:13:07.74,Default,,0,0,0,,Мен стресстен арылғым келеді!
Dialogue: 0,0:13:07.82,0:13:09.28,Default,,0,0,0,,Еңка уақыты.
Dialogue: 0,0:13:09.37,0:13:12.20,Default,,0,0,0,,Жаңалықтарды трансляциялау мерзімін өзгерту
Dialogue: 0,0:13:12.29,0:13:14.54,Default,,0,0,0,,Мен асығыспын!
Dialogue: 0,0:13:14.62,0:13:16.62,Default,,0,0,0,,Do… Дораэмон…
Dialogue: 0,0:13:16.71,0:13:19.42,Default,,0,0,0,,Барлығының тітіркенуі бар сияқты.
Dialogue: 0,0:13:19.50,0:13:20.88,Default,,0,0,0,,Енді түсіндің бе?
Dialogue: 0,0:13:20.96,0:13:23.46,Default,,0,0,0,,Музыка болмаған кезде не болады?
Dialogue: 0,0:13:23.55,0:13:26.38,Default,,0,0,0,,Түсіндім, тез бірдеңе істе!
Dialogue: 0,0:13:31.56,0:13:34.31,Default,,0,0,0,,(Cicada хоры)
Dialogue: 0,0:13:34.39,0:13:37.60,Default,,0,0,0,,Біздің музыка осындай ма?
Dialogue: 0,0:13:40.44,0:13:42.78,Default,,0,0,0,,Мен топты тастамаймын!
Dialogue: 0,0:13:42.86,0:13:45.86,Default,,0,0,0,,Жоқ, мен ән айттым, ән айттым!
Dialogue: 0,0:13:45.95,0:13:48.61,Default,,0,0,0,,Майдо! Тағы бір бөтелке тегін.
Dialogue: 0,0:13:48.70,0:13:50.49,Default,,0,0,0,,Минаның жаңа әні
Dialogue: 0,0:13:52.16,0:13:55.20,Default,,0,0,0,,Уф, бұл жақсы.
Dialogue: 0,0:13:55.29,0:13:57.16,Default,,0,0,0,,Қал... иә!?
Dialogue: 0,0:13:57.75,0:13:59.00,Default,,0,0,0,,Гах…
Dialogue: 0,0:14:00.08,0:14:02.13,Default,,0,0,0,,Балық сүйектері…
Dialogue: 0,0:14:02.71,0:14:04.51,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:04.59,0:14:06.80,Default,,0,0,0,,Жарайсыңдар! Кеттік, Сунео!
Dialogue: 0,0:14:06.88,0:14:08.59,Default,,0,0,0,,Иә!? Қайда бара жатырсың?
Dialogue: 0,0:14:08.68,0:14:10.59,Default,,0,0,0,,Концерт жалғасуда!
Dialogue: 0,0:14:10.68,0:14:13.85,Default,,0,0,0,,Жоқ! (радиода музыка ойнайды)
Dialogue: 0,0:14:13.93,0:14:17.60,Default,,0,0,0,,(Қарттың ән салған дауысы)
Dialogue: 0,0:14:17.69,0:14:19.60,Default,,0,0,0,,бәрібір.
Dialogue: 0,0:14:24.40,0:14:26.24,Default,,0,0,0,,Сіз кімсіз...
Dialogue: 0,0:14:26.99,0:14:30.20,Default,,0,0,0,,Құрал-сайманға оқтын-оқтын сенбе, өз бетінше жаттығу!
Dialogue: 0,0:14:32.87,0:14:33.91,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:34.49,0:14:35.58,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:14:35.66,0:14:38.91,Default,,0,0,0,,Нобита-кун пайдаланса жаман болмас еді.
Dialogue: 0,0:14:39.00,0:14:42.25,Default,,0,0,0,,Дора-чан, менде Дораяки тағы болды.
Dialogue: 0,0:14:42.33,0:14:44.25,Default,,0,0,0,,Дораяки~!?
Dialogue: 0,0:14:44.34,0:14:46.71,Default,,0,0,0,,Дораяки!
Dialogue: 0,0:14:46.80,0:14:48.88,Default,,0,0,0,,Менімен бірге қаш!
Dialogue: 0,0:14:48.97,0:14:50.68,Default,,0,0,0,,Ан, мен қатты ашуландым!
Dialogue: 0,0:14:50.76,0:14:55.76,Default,,0,0,0,,(Радиода ойналатын музыка)
Dialogue: 0,0:15:04.15,0:15:05.44,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:15:05.52,0:15:09.57,Default,,0,0,0,,Мен Карацукимін, радио диджеймін. Келесі менің радио атым.
Dialogue: 0,0:15:09.65,0:15:11.70,Default,,0,0,0,,Фуняковняоның сұрауы
Dialogue: 0,0:15:11.78,0:15:13.24,Default,,0,0,0,,«Қираған сарайдың айы»
Dialogue: 0,0:15:14.12,0:15:20.96,Default,,0,0,0,,(Радиода ойналатын музыка)
Dialogue: 0,0:15:24.13,0:15:26.50,Default,,0,0,0,,(шу төмен дыбыс)
Dialogue: 0,0:15:27.88,0:15:29.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:29.34,0:15:30.51,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:30.59,0:15:34.76,Default,,0,0,0,,Иә? Мен не болғанын білмеймін, мен оны сатып алдым.
Dialogue: 0,0:15:38.60,0:15:42.27,Default,,0,0,0,,Ал, жұмыртқа, тартылған ет және...
Dialogue: 0,0:15:42.35,0:15:43.52,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:44.06,0:15:45.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:46.52,0:15:50.74,Default,,0,0,0,,Нобитаның күнделігі? Оны осындай жерде шығарыңыз!
Dialogue: 0,0:15:56.45,0:15:58.58,Default,,0,0,0,,(магнитофон дыбысы)
Dialogue: 0,0:15:58.66,0:16:00.87,Default,,0,0,0,,- (Кіші мектеп оқушысы) Шынымен бе? -(Кіші мектеп оқушысы) Көрдім...
Dialogue: 0,0:16:00.96,0:16:02.46,Default,,0,0,0,,(«жоқ» дыбысы)
Dialogue: 0,0:16:02.54,0:16:04.88,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:16:04.96,0:16:09.13,Default,,0,0,0,,(сүрінетін өнімділік)
Dialogue: 0,0:16:09.21,0:16:10.05,Default,,0,0,0,,(«жоқ» дыбысы)
Dialogue: 0,0:16:10.13,0:16:12.97,Default,,0,0,0,,Бұлай жақсы үрлей алмайсың.
Dialogue: 0,0:16:13.05,0:16:14.59,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:16:14.68,0:16:18.68,Default,,0,0,0,,Музыка болмаса екен.
Dialogue: 0,0:16:22.77,0:16:24.31,Default,,0,0,0,,Понмюэй!
Dialogue: 0,0:16:24.40,0:16:27.77,Default,,0,0,0,,Иә!? Ал, сен...
Dialogue: 0,0:16:27.86,0:16:30.48,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:16:30.57,0:16:32.49,Default,,0,0,0,,Понмюи Мюи!
Dialogue: 0,0:16:32.57,0:16:35.28,Default,,0,0,0,,Шет тілі!? Не... не істеуім керек?
Dialogue: 0,0:16:35.36,0:16:38.24,Default,,0,0,0,,Мен... Мен ағылшынша сөйлей алмаймын
Dialogue: 0,0:16:38.33,0:16:39.41,Default,,0,0,0,,Хмм?
Dialogue: 0,0:16:39.49,0:16:42.66,Default,,0,0,0,,- (Нобита) Сонымен... бұл... - Ммм...
Dialogue: 0,0:16:44.00,0:16:46.33,Default,,0,0,0,,- (Нобита) А... - Әй! Ха!
Dialogue: 0,0:16:46.42,0:16:47.63,Default,,0,0,0,,Диктофон?
Dialogue: 0,0:16:48.46,0:16:51.09,Default,,0,0,0,,- Пиппипи... - (Нобита) Сіз үрлеймін бе?
Dialogue: 0,0:16:51.17,0:16:52.09,Default,,0,0,0,,Pipi~pi
Dialogue: 0,0:16:52.72,0:16:54.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:54.17,0:16:56.55,Default,,0,0,0,,Бірақ бұл ақымақ...
Dialogue: 0,0:16:56.64,0:16:58.26,Default,,0,0,0,,Менің!
Dialogue: 0,0:16:58.35,0:17:00.64,Default,,0,0,0,,Мен... түсіндім.
Dialogue: 0,0:17:06.31,0:17:10.02,Default,,0,0,0,,(сүрінетін өнімділік)
Dialogue: 0,0:17:10.11,0:17:10.94,Default,,0,0,0,,(«жоқ» дыбысы)
Dialogue: 0,0:17:11.02,0:17:14.03,Default,,0,0,0,,Кюхахаха Ахахха!
Dialogue: 0,0:17:14.11,0:17:16.16,Default,,0,0,0,,Сондықтан мен сені жақсы емес деп айттым!
Dialogue: 0,0:17:16.24,0:17:18.45,Default,,0,0,0,,Менің! Мьюидікі!
Dialogue: 0,0:17:20.12,0:17:23.87,Default,,0,0,0,,(сүрінетін өнімділік)
Dialogue: 0,0:17:43.47,0:17:46.44,Default,,0,0,0,,(«жоқ» дыбысы)
Dialogue: 0,0:17:46.52,0:17:47.98,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:17:49.27,0:17:54.69,Default,,0,0,0,,(Миканың анық ән айтатын дауысы: «Микканың әні»)
Dialogue: 0,0:18:24.47,0:18:27.18,Default,,0,0,0,,Уау~
Dialogue: 0,0:18:40.16,0:18:42.91,Default,,0,0,0,,(аққудың айқайы)
Dialogue: 0,0:18:49.25,0:18:54.00,Default,,0,0,0,,(Миканың ән салған дауысы)
Dialogue: 0,0:18:55.71,0:18:59.38,Default,,0,0,0,,Ой, бұл менің бірінші рет...
Dialogue: 0,0:18:59.47,0:19:01.68,Default,,0,0,0,,Сен неменесің... А?
Dialogue: 0,0:19:01.76,0:19:03.97,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:19:04.89,0:19:06.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:09.48,0:19:11.44,Default,,0,0,0,,Ол жоғалып кетті...
Dialogue: 0,0:19:18.32,0:19:23.57,Default,,0,0,0,,(Нобитаның гуілдеуі)
Dialogue: 0,0:19:23.66,0:19:25.20,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:25.28,0:19:27.16,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:19:27.24,0:19:28.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:28.54,0:19:32.12,Default,,0,0,0,,Моншада қандай ән жақсы естіледі?
Dialogue: 0,0:19:32.21,0:19:34.00,Default,,0,0,0,,- (Нобита) Мен білмеймін - және...
Dialogue: 0,0:19:34.59,0:19:38.21,Default,,0,0,0,,Ол бала біртүрлі бала еді.
Dialogue: 0,0:19:41.13,0:19:45.68,Default,,0,0,0,,(Диктофонның өнімділігі: «Диктофонның тапсырмасы»)
Dialogue: 0,0:19:45.76,0:19:47.35,Default,,0,0,0,,(«жоқ» дыбысы)
Dialogue: 0,0:19:47.43,0:19:49.43,Default,,0,0,0,,Қанша айтсам да, түсінесің!
Dialogue: 0,0:19:49.52,0:19:51.64,Default,,0,0,0,,(сүрінетін өнімділік)
Dialogue: 0,0:19:51.73,0:19:54.15,Default,,0,0,0,,Мынау... осылай
Dialogue: 0,0:19:54.23,0:19:56.86,Default,,0,0,0,,(сүрінетін өнімділік)
Dialogue: 0,0:19:56.94,0:19:59.07,Default,,0,0,0,,Қазірдің өзінде! «Жоқ» дыбысына тыйым салу!
Dialogue: 0,0:20:00.99,0:20:04.49,Default,,0,0,0,,Мен мұны істей алмаймын! Мен үйге бара жатырмын
Dialogue: 0,0:20:05.74,0:20:07.16,Default,,0,0,0,,О!
Dialogue: 0,0:20:07.24,0:20:10.66,Default,,0,0,0,,Жақында мен сізге арнайы тренинг өткіземін.
Dialogue: 0,0:20:10.75,0:20:12.04,Default,,0,0,0,,Сізге бұл ұнамайды ма?
Dialogue: 0,0:20:12.12,0:20:14.17,Default,,0,0,0,,Иә! Рақмет сізге!
Dialogue: 0,0:20:14.25,0:20:16.88,Default,,0,0,0,,Жалғыз емес, бірге жаттығу жақсы.
Dialogue: 0,0:20:16.96,0:20:18.00,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:20:18.09,0:20:19.05,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:20:19.13,0:20:21.34,Default,,0,0,0,,Бәріміз тағы сәйкестендірейік
Dialogue: 0,0:20:21.42,0:20:23.38,Default,,0,0,0,,-Жарайды! - (Сунео) Эй!
Dialogue: 0,0:20:24.38,0:20:29.10,Default,,0,0,0,,Кеше мен өзімді басқаша сезіндім...
Dialogue: 0,0:20:29.68,0:20:35.56,Default,,0,0,0,,(Диктофонның өнімділігі)
Dialogue: 0,0:20:35.65,0:20:36.61,Default,,0,0,0,,(«жоқ» дыбысы)
Dialogue: 0,0:20:36.69,0:20:37.94,Default,,0,0,0,,Сәлем Нобита!
Dialogue: 0,0:20:37.94,0:20:38.65,Default,,0,0,0,,Сәлем Нобита!
Dialogue: 0,0:20:37.94,0:20:38.65,Default,,0,0,0,,(Миканың ән салған дауысы)
Dialogue: 0,0:20:38.65,0:20:39.94,Default,,0,0,0,,(Миканың ән айту дауысы)
Dialogue: 0,0:20:39.94,0:20:41.11,Default,,0,0,0,,(Миканың ән салған дауысы)
Dialogue: 0,0:20:39.94,0:20:41.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:41.11,0:20:42.40,Default,,0,0,0,,(Миканың ән салған дауысы)
Dialogue: 0,0:20:42.40,0:20:44.61,Default,,0,0,0,,(Миканың ән салған дауысы)
Dialogue: 0,0:20:42.40,0:20:44.61,Default,,0,0,0,,Иә? Бұл дауыс...
Dialogue: 0,0:20:44.70,0:20:46.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:51.70,0:20:53.83,Default,,0,0,0,,-Уау -Уау...
Dialogue: 0,0:20:53.91,0:20:55.54,Default,,0,0,0,,Бұл қай бала?
Dialogue: 0,0:20:55.62,0:20:57.13,Default,,0,0,0,,- (Нобита) Бұл бала! -(3 адам) А?
Dialogue: 0,0:20:57.21,0:20:59.71,Default,,0,0,0,,Нобита-сан, сен оны танисың ба?
Dialogue: 0,0:21:02.01,0:21:03.13,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:21:03.22,0:21:06.05,Default,,0,0,0,,(Миканың ән айтатын дауысы және магнитофонның орындауы)
Dialogue: 0,0:21:06.13,0:21:09.14,Default,,0,0,0,,Аа, сіз дұрыс істеп жатырсыз.
Dialogue: 0,0:21:09.22,0:21:10.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:10.22,0:21:13.64,Default,,0,0,0,,(Миканың ән айту дауысы)
Dialogue: 0,0:21:15.94,0:21:21.69,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:21:21.78,0:21:24.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:30.87,0:21:32.54,Default,,0,0,0,,Менің Мико-чаным!
Dialogue: 0,0:21:32.62,0:21:34.87,Default,,0,0,0,,Менің жоғары дәрежелі жаңғаққұмар!
Dialogue: 0,0:21:34.96,0:21:36.50,Default,,0,0,0,,Бұл менің металл роботым!
Dialogue: 0,0:21:37.12,0:21:39.21,Default,,0,0,0,,Менің тұлыптарым да!
Dialogue: 0,0:21:39.29,0:21:42.38,Default,,0,0,0,,(контрабас орындауы)
Dialogue: 0,0:21:42.46,0:21:44.92,Default,,0,0,0,,Сіз қалай ойлайсыз? Ол көтеріледі, солай ма?
Dialogue: 0,0:21:46.72,0:21:51.18,Default,,0,0,0,,(Диктофон және ойыншықтар оркестрінің орындауы)
Dialogue: 0,0:21:51.26,0:21:52.93,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:21:53.02,0:21:55.56,Default,,0,0,0,,Хехехехехехехехехехехехе
Dialogue: 0,0:21:55.64,0:21:59.86,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:22:03.28,0:22:06.19,Default,,0,0,0,,(Ақ баланның дыбысы)
Dialogue: 0,0:22:10.28,0:22:15.70,Default,,0,0,0,,(ойыншықтар оркестрінің орындауы)
Dialogue: 0,0:22:25.92,0:22:31.72,Default,,0,0,0,,(Төрт адамның жеке орындауы)
Dialogue: 0,0:22:41.52,0:22:44.52,Default,,0,0,0,,(Ән айту және орындау)
Dialogue: 0,0:22:45.11,0:22:46.69,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:22:47.28,0:22:49.15,Default,,0,0,0,,- Көңілді! -(Нобита) Иә!
Dialogue: 0,0:22:49.24,0:22:51.24,Default,,0,0,0,,Керемет! Менің ішім пысып кетті!
Dialogue: 0,0:22:51.32,0:22:52.91,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:22:52.99,0:22:55.95,Default,,0,0,0,,Барлығының ойыншықтарына «роботер» қостым.
Dialogue: 0,0:22:56.04,0:22:59.33,Default,,0,0,0,,Сондай-ақ, міне, «Көңіл-күйді көтеру тобы»!
Dialogue: 0,0:22:59.41,0:23:00.96,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:23:01.04,0:23:03.79,Default,,0,0,0,,Фанонпипи! Поумян Питтанчо!
Dialogue: 0,0:23:03.88,0:23:05.46,Default,,0,0,0,,Әнші дауыс қандай керемет!
Dialogue: 0,0:23:05.55,0:23:07.92,Default,,0,0,0,,Сіз қайдансыз? Сіздің атыңыз кім?
Dialogue: 0,0:23:08.01,0:23:09.67,Default,,0,0,0,,Сіз Нобита-кунды білесіз бе?
Dialogue: 0,0:23:09.76,0:23:11.93,Default,,0,0,0,,Мен де кеше сені бірінші рет кездестірдім.
Dialogue: 0,0:23:12.01,0:23:13.76,Default,,0,0,0,,Пуруру Пуруру
Dialogue: 0,0:23:13.85,0:23:17.68,Default,,0,0,0,,Сөзді түсінбедім, бірақ жүрегіміз бір-бірімізбен жаңғырды!
Dialogue: 0,0:23:17.77,0:23:18.81,Default,,0,0,0,,Сізде жүрек болды ма?
Dialogue: 0,0:23:18.89,0:23:21.98,Default,,0,0,0,,Иә! Алдағы уақытта бар жүрегіммен ән айтамын!
Dialogue: 0,0:23:22.06,0:23:24.31,Default,,0,0,0,,- Е! -Ааааааааааааааааааааааааааа
Dialogue: 0,0:23:24.40,0:23:26.65,Default,,0,0,0,,Бұл басқа уақытта болады.
Dialogue: 0,0:23:26.73,0:23:28.94,Default,,0,0,0,,Көңілім бұзылды...
Dialogue: 0,0:23:29.03,0:23:30.74,Default,,0,0,0,,- (Сунео) Сәлем! -не?
Dialogue: 0,0:23:30.82,0:23:35.41,Default,,0,0,0,,Жоқ, егер біз жалғыз аудитория болсақ ысырап болар еді...
Dialogue: 0,0:23:35.49,0:23:37.66,Default,,0,0,0,,Иә? Ал сол бала ше?
Dialogue: 0,0:23:37.74,0:23:39.79,Default,,0,0,0,,Қызық, қайда бардың?
Dialogue: 0,0:23:40.96,0:23:42.96,Default,,0,0,0,,Ол қайтадан жоғалып кетті.
Dialogue: 0,0:23:43.04,0:23:45.59,Default,,0,0,0,,Бұл не? Қазірден қашан
Dialogue: 0,0:23:45.67,0:23:49.80,Default,,0,0,0,,Жүрек арқылы жеткізілген жоқ па? Бұл өмірге қауіпті
Dialogue: 0,0:23:49.88,0:23:52.47,Default,,0,0,0,,Ахи!
Dialogue: 0,0:23:52.55,0:23:54.64,Default,,0,0,0,,-Фью - (Дораэмон/Нобита) Хаха...
Dialogue: 0,0:23:54.72,0:23:56.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:03.48,0:24:04.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:05.06,0:24:07.02,Default,,0,0,0,,Құрғаған саңырауқұлақ?
Dialogue: 0,0:24:07.11,0:24:08.98,Default,,0,0,0,,Уау... уау
Dialogue: 0,0:24:09.78,0:24:11.65,Default,,0,0,0,,Бұл маған тиді...
Dialogue: 0,0:24:11.74,0:24:13.20,Default,,0,0,0,,Не болды, Джан?
Dialogue: 0,0:24:13.28,0:24:15.57,Default,,0,0,0,,Маған бірдеңе болды.
Dialogue: 0,0:24:16.99,0:24:18.33,Default,,0,0,0,,Таптым!
Dialogue: 0,0:24:18.91,0:24:21.46,Default,,0,0,0,,Бес виртуоз!
Dialogue: 0,0:24:24.46,0:24:25.75,Default,,0,0,0,,Я...
Dialogue: 0,0:24:27.71,0:24:29.21,Default,,0,0,0,,Сәлем Дораемон
Dialogue: 0,0:24:29.30,0:24:32.76,Default,,0,0,0,,Диктофон дағдыларын бірден жетілдіретін құрал жоқ па?
Dialogue: 0,0:24:32.84,0:24:33.84,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:24:33.93,0:24:35.97,Default,,0,0,0,,Тұрақты түрде жаттығу керек
Dialogue: 0,0:24:36.05,0:24:37.80,Default,,0,0,0,,Бұл сізге арналмаған!
Dialogue: 0,0:24:37.89,0:24:39.56,Default,,0,0,0,,-(Нобита) Ке-чи -ке!?
Dialogue: 0,0:24:39.64,0:24:42.18,Default,,0,0,0,,Сараңдық дегеніміз не? Сараңдық деген не?
Dialogue: 0,0:24:42.27,0:24:43.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:45.19,0:24:47.02,Default,,0,0,0,,Кімнен?
Dialogue: 0,0:24:47.11,0:24:49.11,Default,,0,0,0,,-Маған көрсетші - (Нобита) Иә.
Dialogue: 0,0:24:51.03,0:24:55.82,Default,,0,0,0,,«Мен бүгін кешке мектептің музыкалық бөлмесінде күтемін».
Dialogue: 0,0:24:55.91,0:24:58.41,Default,,0,0,0,,Ах, бұл белгі!
Dialogue: 0,0:25:02.04,0:25:03.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:09.00,0:25:11.13,Default,,0,0,0,,♪ Нян~ня~
Dialogue: 0,0:25:11.21,0:25:14.42,Default,,0,0,0,,♪ Няняняня~
Dialogue: 0,0:25:14.51,0:25:16.34,Default,,0,0,0,,Ня?
Dialogue: 0,0:25:16.43,0:25:18.09,Default,,0,0,0,,Ня~?
Dialogue: 0,0:25:21.18,0:25:22.39,Default,,0,0,0,,Ня?
Dialogue: 0,0:25:22.47,0:25:24.39,Default,,0,0,0,,Мияу!
Dialogue: 0,0:25:24.48,0:25:25.94,Default,,0,0,0,,Мияу!
Dialogue: 0,0:25:26.02,0:25:29.86,Default,,0,0,0,,Сол бала менің әнімді тыңдағысы келді.
Dialogue: 0,0:25:29.94,0:25:31.36,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:25:31.44,0:25:32.57,Default,,0,0,0,,-Аа? -(Сунео) Жоқ...
Dialogue: 0,0:25:32.65,0:25:35.15,Default,,0,0,0,,Бірақ неге сонша кеш...
Dialogue: 0,0:25:35.24,0:25:36.57,Default,,0,0,0,,Эй!
Dialogue: 0,0:25:37.41,0:25:39.91,Default,,0,0,0,,- Нобита-сан да? -Бұл дегеніміз...
Dialogue: 0,0:25:39.99,0:25:41.62,Default,,0,0,0,,Барлығына да жетті.
Dialogue: 0,0:25:41.70,0:25:42.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:42.95,0:25:45.12,Default,,0,0,0,,-Иә - (Сунео) Мен де.
Dialogue: 0,0:25:51.25,0:25:53.80,Default,,0,0,0,,Иносукэ, кешір мені. Егер оны ертерек байқап қалсам...
Dialogue: 0,0:25:56.38,0:25:57.38,Default,,0,0,0,,Әй!
Dialogue: 0,0:25:57.97,0:25:59.76,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:26:03.39,0:26:05.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:26:05.35,0:26:07.48,Default,,0,0,0,,Сонымен... ойланыңызшы, білесіз бе?
Dialogue: 0,0:26:07.56,0:26:11.11,Default,,0,0,0,,Мен түнде бос музыка бөлмесінде фортепиано ойнағанда,
Dialogue: 0,0:26:11.19,0:26:14.11,Default,,0,0,0,,Портреттегі Бетховен жымиып тұр...
Dialogue: 0,0:26:14.19,0:26:15.28,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:26:17.90,0:26:20.24,Default,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 0,0:26:22.74,0:26:24.79,Default,,0,0,0,,Ешкім...
Dialogue: 0,0:26:29.75,0:26:32.42,Default,,0,0,0,,А... мүмкін емес.
Dialogue: 0,0:26:32.50,0:26:35.13,Default,,0,0,0,,Бұл шынымен сол баладан болды ма?
Dialogue: 0,0:26:35.21,0:26:36.63,Default,,0,0,0,,(шу)
Dialogue: 0,0:26:38.43,0:26:39.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:26:40.72,0:26:41.97,Default,,0,0,0,,Бірдеңе
Dialogue: 0,0:26:42.60,0:26:45.06,Default,,0,0,0,,«Осы әуенді ойнатыңызшы»
Dialogue: 0,0:26:45.14,0:26:46.68,Default,,0,0,0,,Не болды?
Dialogue: 0,0:26:46.77,0:26:48.06,Default,,0,0,0,,Бұл...
Dialogue: 0,0:26:49.02,0:26:50.90,Default,,0,0,0,,Мен бұл әнді білемін
Dialogue: 0,0:26:50.98,0:26:52.44,Default,,0,0,0,,Не, ойнайсың ба!?
Dialogue: 0,0:26:53.27,0:26:55.07,Default,,0,0,0,,Бетховен күле бастайды...
Dialogue: 0,0:26:55.15,0:26:58.15,Default,,0,0,0,,А... не... неменеге байсалдысың?
Dialogue: 0,0:27:00.07,0:27:05.62,Default,,0,0,0,,(Фортепиано орындауы: «Für Elise»)
Dialogue: 0,0:27:17.26,0:27:18.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:18.97,0:27:20.84,Default,,0,0,0,,Не?
Dialogue: 0,0:27:20.93,0:27:22.09,Default,,0,0,0,,Жарық!
Dialogue: 0,0:27:22.18,0:27:24.39,Default,,0,0,0,,Мен күттім.
Dialogue: 0,0:27:24.47,0:27:26.31,Default,,0,0,0,,Енді осында кел.
Dialogue: 0,0:27:26.39,0:27:29.06,Default,,0,0,0,,- (Нобита) Әй... аруақ!? - Дора-чан!
Dialogue: 0,0:27:29.14,0:27:30.64,Default,,0,0,0,,Жүр, асығыңыз!
Dialogue: 0,0:27:30.73,0:27:32.02,Default,,0,0,0,,Сіз кімсіз!
Dialogue: 0,0:27:32.77,0:27:34.73,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:27:34.81,0:27:37.73,Default,,0,0,0,,Бізге сіздің көмегіңіз қажет!
Dialogue: 0,0:27:39.03,0:27:40.82,Default,,0,0,0,,Мен өзімді біраз қиналғандай сезінемін.
Dialogue: 0,0:27:40.90,0:27:42.45,Default,,0,0,0,,Не істеу керек? Барамыз ба?
Dialogue: 0,0:27:42.53,0:27:45.20,Default,,0,0,0,,Жоқ, енді... неге бүгін тоқтамасқа?
Dialogue: 0,0:27:45.28,0:27:46.66,Default,,0,0,0,,Ах
Dialogue: 0,0:27:45.28,0:27:46.66,Default,,0,0,0,,(Миканың ән салған дауысы)
Dialogue: 0,0:27:46.66,0:27:50.37,Default,,0,0,0,,(Миканың ән салған дауысы)
Dialogue: 0,0:27:50.46,0:27:51.96,Default,,0,0,0,,Бұл бала.
Dialogue: 0,0:27:52.04,0:27:53.63,Default,,0,0,0,,Мына қыз ән айтып жатыр!
Dialogue: 0,0:27:54.33,0:27:55.59,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:27:55.67,0:27:57.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:58.96,0:28:01.59,Default,,0,0,0,,Мына қыз қоңырау шалып тұр!
Dialogue: 0,0:28:01.68,0:28:02.51,Default,,0,0,0,,Жарайды
Dialogue: 0,0:28:05.47,0:28:06.47,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:28:07.06,0:28:08.72,Default,,0,0,0,,- (Нобита) Иә! -Иә!
Dialogue: 0,0:28:08.81,0:28:10.27,Default,,0,0,0,,О... шынымен!?
Dialogue: 0,0:28:10.35,0:28:11.73,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:28:13.65,0:28:15.65,Default,,0,0,0,,Қызық болып барады!
Dialogue: 0,0:28:15.73,0:28:17.94,Default,,0,0,0,,Жоқ, күтіңіз... күтіңіз!
Dialogue: 0,0:28:18.02,0:28:21.99,Default,,0,0,0,,Не болса да, білмеймін!
Dialogue: 0,0:28:22.07,0:28:23.45,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:28:34.71,0:28:36.75,Default,,0,0,0,,Не... не болып жатыр!?
Dialogue: 0,0:28:36.84,0:28:38.46,Default,,0,0,0,,Уау...
Dialogue: 0,0:28:38.55,0:28:39.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:40.05,0:28:41.46,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:28:42.05,0:28:43.93,Default,,0,0,0,,- (Нобита) Аспанға өрмелеу! -(Сунео) Иә!?
Dialogue: 0,0:28:44.01,0:28:46.43,Default,,0,0,0,,-Өтірік...! -Бұл...
Dialogue: 0,0:28:47.01,0:28:48.30,Default,,0,0,0,,Бұл тоқтамайды!
Dialogue: 0,0:28:48.39,0:28:49.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:50.01,0:28:53.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:56.35,0:28:57.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:57.31,0:28:59.40,Default,,0,0,0,,Иә!?
Dialogue: 0,0:29:00.02,0:29:01.44,Default,,0,0,0,,Жер...
Dialogue: 0,0:29:01.53,0:29:05.16,Default,,0,0,0,,Сонымен біз ғарышқа ұштық!?
Dialogue: 0,0:29:05.24,0:29:06.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:29:06.91,0:29:08.32,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:29:08.41,0:29:11.33,Default,,0,0,0,,Сен қайда бара жатырсың?
Dialogue: 0,0:29:19.63,0:29:21.38,Default,,0,0,0,,- Иә!? - (Нобита) Бұл не!?
Dialogue: 0,0:29:21.46,0:29:22.67,Default,,0,0,0,,Дора-чан!
Dialogue: 0,0:29:22.76,0:29:25.01,Default,,0,0,0,,Жердің жанында осындай нәрсе бар...
Dialogue: 0,0:29:34.43,0:29:35.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:37.81,0:29:38.90,Default,,0,0,0,,тоқтатылды
Dialogue: 0,0:29:42.73,0:29:43.86,Default,,0,0,0,,Иә!?
Dialogue: 0,0:29:47.91,0:29:49.99,Default,,0,0,0,,Мынау не...
Dialogue: 0,0:29:53.12,0:29:57.08,Default,,0,0,0,,Тыныш. Мен сонда біреу бар ма деп ойлаймын.
Dialogue: 0,0:29:57.17,0:30:00.04,Default,,0,0,0,,Ей, бұл қорқынышты. Үйге барайық.
Dialogue: 0,0:30:00.13,0:30:02.67,Default,,0,0,0,,Эй, мұнда!
Dialogue: 0,0:30:02.75,0:30:05.26,Default,,0,0,0,,Бұл бала шынымен сонда ма?
Dialogue: 0,0:30:05.34,0:30:07.51,Default,,0,0,0,,Бәрібір іздеп көрейік
Dialogue: 0,0:30:08.09,0:30:09.39,Default,,0,0,0,,Баспалдақтар бар
Dialogue: 0,0:30:09.47,0:30:11.10,Default,,0,0,0,,Жоғарыға көтерілу дейсіз бе?
Dialogue: 0,0:30:11.18,0:30:12.81,Default,,0,0,0,,Сәлем Джан!
Dialogue: 0,0:30:12.89,0:30:15.85,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:30:15.93,0:30:17.44,Default,,0,0,0,,Оо?
Dialogue: 0,0:30:20.15,0:30:21.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:23.78,0:30:25.36,Default,,0,0,0,,Керемет дыбыс!
Dialogue: 0,0:30:25.44,0:30:27.45,Default,,0,0,0,,О... йотто
Dialogue: 0,0:30:28.11,0:30:29.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:30.91,0:30:34.62,Default,,0,0,0,,Барлығы тым сақ.
Dialogue: 0,0:30:34.70,0:30:35.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:36.37,0:30:38.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:38.46,0:30:40.75,Default,,0,0,0,,Барлығы, күте тұрыңдар!
Dialogue: 0,0:30:41.42,0:30:43.63,Default,,0,0,0,,(маримбаға ұқсайды)
Dialogue: 0,0:30:43.71,0:30:45.88,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:30:45.96,0:30:46.88,Default,,0,0,0,,Хой хой... (барабан тәрізді дыбыс)
Dialogue: 0,0:30:46.97,0:30:48.88,Default,,0,0,0,,Алдыңғы және кейінгі күн
Dialogue: 0,0:30:48.97,0:30:50.89,Default,,0,0,0,,(Glockenspiel тәрізді дыбыс)
Dialogue: 0,0:30:51.84,0:30:52.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:53.68,0:30:55.39,Default,,0,0,0,,Хехехе
Dialogue: 0,0:30:55.47,0:30:58.14,Default,,0,0,0,,Тоттото… Тотототто
Dialogue: 0,0:30:58.23,0:31:01.90,Default,,0,0,0,,Уау... Уау (жел қоңырауының дыбысы)
Dialogue: 0,0:31:01.98,0:31:03.40,Default,,0,0,0,,Канг канг... (металлофон сияқты естіледі)
Dialogue: 0,0:31:03.48,0:31:05.36,Default,,0,0,0,,Уау хехе
Dialogue: 0,0:31:06.48,0:31:08.40,Default,,0,0,0,,Аяя… фууууууууу (барабан тәрізді дыбыс)
Dialogue: 0,0:31:08.49,0:31:11.91,Default,,0,0,0,,Ммм жақсы (маримба сияқты естіледі)
Dialogue: 0,0:31:11.99,0:31:14.37,Default,,0,0,0,,Иә?Ах!
Dialogue: 0,0:31:15.66,0:31:17.41,Default,,0,0,0,,Иә... Жарайды! (барабанның дыбысы сияқты)
Dialogue: 0,0:31:18.37,0:31:19.91,Default,,0,0,0,,Мен енот ит емеспін!
Dialogue: 0,0:31:20.00,0:31:21.42,Default,,0,0,0,,(маримбаға ұқсайды)
Dialogue: 0,0:31:21.50,0:31:24.42,Default,,0,0,0,,Иә? Хото (үшбұрышты дыбыс)
Dialogue: 0,0:31:24.50,0:31:25.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:25.71,0:31:27.96,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:31:28.76,0:31:30.17,Default,,0,0,0,,Мен... мен де!
Dialogue: 0,0:31:30.26,0:31:32.18,Default,,0,0,0,,(маримбаға ұқсайды)
Dialogue: 0,0:31:32.26,0:31:33.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:33.72,0:31:37.43,Default,,0,0,0,,Уф... Хохо...
Dialogue: 0,0:31:37.52,0:31:40.69,Default,,0,0,0,,(Қайталас дыбыстармен ойналатын музыка)
Dialogue: 0,0:31:40.77,0:31:42.94,Default,,0,0,0,,Хехе хахаха
Dialogue: 0,0:31:43.52,0:31:45.44,Default,,0,0,0,,Хе... Иә?
Dialogue: 0,0:31:46.02,0:31:46.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:47.03,0:31:48.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:48.15,0:31:49.69,Default,,0,0,0,,Уау
Dialogue: 0,0:31:49.78,0:31:53.20,Default,,0,0,0,,Ахахахаха, бұл қызық!
Dialogue: 0,0:31:53.28,0:31:55.24,Default,,0,0,0,,Кемпап
Dialogue: 0,0:31:55.33,0:31:57.20,Default,,0,0,0,,Кенкен тақтасы
Dialogue: 0,0:32:00.79,0:32:03.71,Default,,0,0,0,,(айналаны толтыратын музыка)
Dialogue: 0,0:32:17.81,0:32:20.02,Default,,0,0,0,,- Балалар! -(Нобита) Не болды?
Dialogue: 0,0:32:20.10,0:32:21.43,Default,,0,0,0,,Иллюзия!?
Dialogue: 0,0:32:21.52,0:32:23.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:23.23,0:32:24.85,Default,,0,0,0,,Әдемі~
Dialogue: 0,0:32:25.56,0:32:26.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:37.87,0:32:39.83,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:32:48.38,0:32:50.42,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:32:51.42,0:32:52.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:52.84,0:32:56.22,Default,,0,0,0,,Жел? Бұл кеңістік болса да, ауа бар
Dialogue: 0,0:32:56.76,0:32:59.47,Default,,0,0,0,,Тарифіңізге рахмет!
Dialogue: 0,0:33:00.64,0:33:04.02,Default,,0,0,0,,Аңызға айналған Виртуоздан күткендей!
Dialogue: 0,0:33:04.10,0:33:06.10,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:33:06.19,0:33:08.19,Default,,0,0,0,,Менің атым Capek...
Dialogue: 0,0:33:08.27,0:33:11.36,Default,,0,0,0,,Күте тұрыңыз! Күтіңіз... күтіңіз! Күте тұрыңыз!
Dialogue: 0,0:33:11.44,0:33:13.03,Default,,0,0,0,,Қарсы неге? Бүгін таңертең сен жақсылап көмектесіп жүрдің ғой, иә?
Dialogue: 0,0:33:13.11,0:33:14.24,Default,,0,0,0,,Масу…
Dialogue: 0,0:33:15.91,0:33:17.24,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:33:17.32,0:33:20.24,Default,,0,0,0,,Бұл мен бұрын-соңды көрмеген робот түрі.
Dialogue: 0,0:33:20.33,0:33:23.41,Default,,0,0,0,,Уф... аа... рахмет
Dialogue: 0,0:33:23.50,0:33:25.75,Default,,0,0,0,,Пуи Мупоппо Тончапе!
Dialogue: 0,0:33:25.83,0:33:26.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:30.63,0:33:33.01,Default,,0,0,0,,Мачичи Бонбонпе!
Dialogue: 0,0:33:33.09,0:33:35.55,Default,,0,0,0,,- (Нобита) Бұл бала! - екінші ойлар туралы!
Dialogue: 0,0:33:35.63,0:33:37.26,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:33:37.34,0:33:38.97,Default,,0,0,0,,Хэхэ~н
Dialogue: 0,0:33:39.89,0:33:41.93,Default,,0,0,0,,«Шынында Конняку»!
Dialogue: 0,0:33:43.02,0:33:45.48,Default,,0,0,0,,О, мисо соусы да бар.
Dialogue: 0,0:33:45.56,0:33:47.90,Default,,0,0,0,,Көзілдірік осында ма?
Dialogue: 0,0:33:49.94,0:33:52.15,Default,,0,0,0,,Нохохон көзілдірігі!?
Dialogue: 0,0:33:52.23,0:33:53.57,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:33:53.65,0:33:54.86,Default,,0,0,0,,Көретін көзің бар!
Dialogue: 0,0:33:55.65,0:33:57.20,Default,,0,0,0,,Мен Миккамын
Dialogue: 0,0:33:57.95,0:33:58.99,Default,,0,0,0,,Бұл...
Dialogue: 0,0:33:59.07,0:34:00.45,Default,,0,0,0,,Бұл Капек
Dialogue: 0,0:34:00.53,0:34:03.58,Default,,0,0,0,,Мен Микка-самаға қамқорлық жасаймын.
Dialogue: 0,0:34:03.66,0:34:05.20,Default,,0,0,0,,Мен Дораемонмын...
Dialogue: 0,0:34:05.29,0:34:06.16,Default,,0,0,0,,Мен Нобитамын!
Dialogue: 0,0:34:06.25,0:34:07.46,Default,,0,0,0,,Құрметті Джиан!
Dialogue: 0,0:34:07.54,0:34:09.13,Default,,0,0,0,,Мен Сунеомын!
Dialogue: 0,0:34:09.21,0:34:12.05,Default,,0,0,0,,Мен... Мен Шизукамын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:34:12.75,0:34:15.51,Default,,0,0,0,,Тариф залына қош келдіңіз
Dialogue: 0,0:34:15.59,0:34:17.68,Default,,0,0,0,,Тариф залы?
Dialogue: 0,0:34:17.76,0:34:21.39,Default,,0,0,0,,Сіз білмейсіз бе? Бұл виртуоз болса да?
Dialogue: 0,0:34:22.05,0:34:24.18,Default,,0,0,0,,Билл... не?
Dialogue: 0,0:34:24.27,0:34:26.43,Default,,0,0,0,,Капек түсіндіріңізші
Dialogue: 0,0:34:26.52,0:34:27.35,Default,,0,0,0,,Әһем
Dialogue: 0,0:34:28.06,0:34:31.19,Default,,0,0,0,,Сізге басқа ешкім қоңырау шалған жоқ.
Dialogue: 0,0:34:31.27,0:34:34.32,Default,,0,0,0,,Мен осы Тарифтік Даңқ Залының қайта жанданғанын қалаймын!
Dialogue: 0,0:34:34.40,0:34:37.03,Default,,0,0,0,,Бұл «жолақы» дегеніміз не?
Dialogue: 0,0:34:37.11,0:34:40.74,Default,,0,0,0,,Не?! Жолақы – бұл жол жүру ақысы...
Dialogue: 0,0:34:40.82,0:34:42.20,Default,,0,0,0,,Ум
Dialogue: 0,0:34:42.28,0:34:44.95,Default,,0,0,0,,Өзеннің бетін кесіп өткен жел сияқты...
Dialogue: 0,0:34:45.04,0:34:47.96,Default,,0,0,0,,Кішкентай құстың сайрағанындай...
Dialogue: 0,0:34:48.04,0:34:52.00,Default,,0,0,0,,Иә! Жердің өзен жағасында ойнап жүргенің осы!
Dialogue: 0,0:34:52.09,0:34:54.09,Default,,0,0,0,,Сіз музыканы айтасыз ба?
Dialogue: 0,0:34:54.17,0:34:57.30,Default,,0,0,0,,Иә, солай! Фарре - бұл музыка!
Dialogue: 0,0:34:57.38,0:34:59.18,Default,,0,0,0,,O… Музыка
Dialogue: 0,0:34:59.26,0:35:02.47,Default,,0,0,0,,Біздің туған планетамыз Мушика планетасы деп аталады.
Dialogue: 0,0:35:02.55,0:35:04.81,Default,,0,0,0,,Тарифтерге толы әдемі жұлдызбен
Dialogue: 0,0:35:04.89,0:35:06.43,Default,,0,0,0,,Алыста...
Dialogue: 0,0:35:06.93,0:35:09.27,Default,,0,0,0,,Шалғай аймақта орналасқан
Dialogue: 0,0:35:09.35,0:35:14.15,Default,,0,0,0,,Бұл зал ғарышта саяхаттап жүрген жер серігі іспеттес.
Dialogue: 0,0:35:14.23,0:35:17.99,Default,,0,0,0,,Мушика планетасы? Мен ол туралы ешқашан естіген емеспін.
Dialogue: 0,0:35:18.69,0:35:20.95,Default,,0,0,0,,Бұл Микканың жат планеталық екенін білдіре ме?!
Dialogue: 0,0:35:21.53,0:35:24.66,Default,,0,0,0,,Біздің көзқарасымыз бойынша, сіз жат планеталықтарсыз.
Dialogue: 0,0:35:24.74,0:35:28.29,Default,,0,0,0,,Қазіргі уақытта ғибадатхана энергияның жетіспеушілігінен ұйықтап жатыр.
Dialogue: 0,0:35:28.37,0:35:31.62,Default,,0,0,0,,Аты аңызға айналған Виртуозды іздеуде
Dialogue: 0,0:35:31.71,0:35:33.67,Default,,0,0,0,,Мен жер бетінде болдым
Dialogue: 0,0:35:33.75,0:35:35.42,Default,,0,0,0,,Мен оны таптым.
Dialogue: 0,0:35:36.30,0:35:37.80,Default,,0,0,0,,Сіз!
Dialogue: 0,0:35:37.88,0:35:39.30,Default,,0,0,0,,Иә!?
Dialogue: 0,0:35:39.80,0:35:42.22,Default,,0,0,0,,Бұл не сыра мен өтірік?
Dialogue: 0,0:35:42.30,0:35:46.18,Default,,0,0,0,,Виртуоз – музыканың шебері!
Dialogue: 0,0:35:46.26,0:35:47.89,Default,,0,0,0,,Біз...
Dialogue: 0,0:35:48.43,0:35:50.64,Default,,0,0,0,,Музыка шебері!?
Dialogue: 0,0:35:50.73,0:35:53.65,Default,,0,0,0,,Бірдеңе дұрыс емес сияқты...
Dialogue: 0,0:35:53.73,0:35:57.48,Default,,0,0,0,,Бұл аймақ сіздің тарифтеріңіз арқылы жанданды!
Dialogue: 0,0:35:57.57,0:35:59.49,Default,,0,0,0,,Бұл ең жақсы дәлел
Dialogue: 0,0:35:59.57,0:36:00.61,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:36:00.70,0:36:03.82,Default,,0,0,0,,Даңқ залын оятыңыз!
Dialogue: 0,0:36:03.91,0:36:05.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:05.58,0:36:07.03,Default,,0,0,0,,- Ей, кеттік - (Нобита) Уау!
Dialogue: 0,0:36:07.12,0:36:10.62,Default,,0,0,0,,-Асығыңыз, асығыңыз! -(Нобита) Бір минут күте тұрыңыз.
Dialogue: 0,0:36:10.71,0:36:13.83,Default,,0,0,0,,Микка-сама, сен сондай бақытты көрінесің...
Dialogue: 0,0:36:13.92,0:36:16.46,Default,,0,0,0,,Мұнда басқа балалар бар ма?
Dialogue: 0,0:36:16.54,0:36:19.26,Default,,0,0,0,,Біз барлық уақытта екеуміз ғана болдық.
Dialogue: 0,0:36:19.34,0:36:22.05,Default,,0,0,0,,Біреумен ойнау
Dialogue: 0,0:36:22.13,0:36:25.47,Default,,0,0,0,,Бұл Микка-саманың бірінші рет келуі еді.
Dialogue: 0,0:36:26.18,0:36:28.39,Default,,0,0,0,,Бір-бірімізге көмектесейік
Dialogue: 0,0:36:28.47,0:36:29.31,Default,,0,0,0,,Иә!?
Dialogue: 0,0:36:29.39,0:36:33.39,Default,,0,0,0,,Неліктен бізге көбірек күш беру үшін музыканы қолданбаймыз?
Dialogue: 0,0:36:33.48,0:36:36.52,Default,,0,0,0,,Бұрынғыдай, сондықтан қарсы болмасаңыз, оңай деп үміттенемін.
Dialogue: 0,0:36:36.61,0:36:39.11,Default,,0,0,0,,Хехе, өте қызық болды.
Dialogue: 0,0:36:39.19,0:36:40.82,Default,,0,0,0,,Уау...
Dialogue: 0,0:36:40.90,0:36:44.45,Default,,0,0,0,,Барлығыңызға рахмет!
Dialogue: 0,0:36:46.32,0:36:48.37,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:36:49.33,0:36:51.00,Default,,0,0,0,,Маэстро...!
Dialogue: 0,0:36:53.00,0:36:54.37,Default,,0,0,0,,Мұнда
Dialogue: 0,0:36:55.63,0:36:56.88,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:36:59.67,0:37:03.93,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:37:05.64,0:37:07.14,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:37:07.85,0:37:09.56,Default,,0,0,0,,Міне, Миккада ма?
Dialogue: 0,0:37:09.64,0:37:11.39,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:37:14.19,0:37:16.48,Default,,0,0,0,,-Нобита-кун! -(Нобита) Ух... Иә.
Dialogue: 0,0:37:16.56,0:37:19.65,Default,,0,0,0,,Виртуоз, музыкалық аспаптар туралы айтсақ!
Dialogue: 0,0:37:20.82,0:37:24.86,Default,,0,0,0,,Міне, мен жерге келген сайын жинаған музыкалық аспаптарым!
Dialogue: 0,0:37:24.95,0:37:28.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:28.24,0:37:31.08,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені таңдаңыз!
Dialogue: 0,0:37:31.16,0:37:34.04,Default,,0,0,0,,Иә? Бұл аспап па?
Dialogue: 0,0:37:34.12,0:37:35.12,Default,,0,0,0,,Иә!?
Dialogue: 0,0:37:35.21,0:37:37.00,Default,,0,0,0,,Бұл «сақина сақинасымен» оянғандай.
Dialogue: 0,0:37:37.08,0:37:39.38,Default,,0,0,0,,Фарре ойнайтын аспап емес пе?
Dialogue: 0,0:37:39.46,0:37:41.17,Default,,0,0,0,,Керемет!
Dialogue: 0,0:37:41.25,0:37:44.38,Default,,0,0,0,,Сіз керемет аспап жасағыңыз келеді!
Dialogue: 0,0:37:44.47,0:37:46.59,Default,,0,0,0,,Мен таңдай алмайтындар көп.
Dialogue: 0,0:37:47.22,0:37:49.05,Default,,0,0,0,,Осындай кезде...
Dialogue: 0,0:37:49.14,0:37:52.26,Default,,0,0,0,,«Тағдырдың қызыл жібі»!
Dialogue: 0,0:37:57.02,0:37:58.98,Default,,0,0,0,,Біреуін таңдап, тартыңыз
Dialogue: 0,0:37:59.06,0:38:02.32,Default,,0,0,0,,Сізге ең қолайлы жауапты болжай аласыз.
Dialogue: 0,0:38:02.40,0:38:03.53,Default,,0,0,0,,Иә
Dialogue: 0,0:38:03.61,0:38:04.99,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:38:05.07,0:38:07.03,Default,,0,0,0,,Ум...
Dialogue: 0,0:38:07.11,0:38:08.41,Default,,0,0,0,,Ал, мен ше?
Dialogue: 0,0:38:08.49,0:38:11.33,Default,,0,0,0,,-Мен бұл! -(Нобита) Мұнда абай бол...
Dialogue: 0,0:38:11.41,0:38:12.24,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:38:14.87,0:38:15.71,Default,,0,0,0,,Міне!
Dialogue: 0,0:38:18.54,0:38:20.67,Default,,0,0,0,,О, бұл үлкен! Бұл не?
Dialogue: 0,0:38:22.34,0:38:23.67,Default,,0,0,0,,Бұл туба.
Dialogue: 0,0:38:23.75,0:38:24.88,Default,,0,0,0,,Ал...
Dialogue: 0,0:38:24.96,0:38:27.88,Default,,0,0,0,,Уау, скрипка! керемет!
Dialogue: 0,0:38:29.51,0:38:31.85,Default,,0,0,0,,Хехе, мен Бонгомын!
Dialogue: 0,0:38:31.93,0:38:33.85,Default,,0,0,0,,Ауыр…
Dialogue: 0,0:38:33.93,0:38:36.77,Default,,0,0,0,,Бұл шынымен де тағдырдың құралы ма?
Dialogue: 0,0:38:36.85,0:38:38.98,Default,,0,0,0,,Мен оны ешқашан ұстаған емеспін
Dialogue: 0,0:38:39.06,0:38:41.52,Default,,0,0,0,,Ол бір ғана соққымен шығады, солай ма?
Dialogue: 0,0:38:41.61,0:38:43.57,Default,,0,0,0,,(қорқынышты дыбыс)
Dialogue: 0,0:38:43.65,0:38:45.32,Default,,0,0,0,,- (Сунео) Иә? -Хахаха!
Dialogue: 0,0:38:45.40,0:38:47.53,Default,,0,0,0,,Бұл үйлесімділік болжау сияқты.
Dialogue: 0,0:38:47.61,0:38:49.74,Default,,0,0,0,,Бұл кенеттен жақсы ойнайтын сияқты емес.
Dialogue: 0,0:38:49.82,0:38:51.28,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:38:51.37,0:38:52.58,Default,,0,0,0,,Егер Виртуоз мырза
Dialogue: 0,0:38:52.66,0:38:54.70,Default,,0,0,0,,Ойнау оңай болуы керек...
Dialogue: 0,0:38:54.79,0:38:56.54,Default,,0,0,0,,Кәпек бұзбады ма?
Dialogue: 0,0:38:56.62,0:38:57.62,Default,,0,0,0,,Иә!?
Dialogue: 0,0:38:57.71,0:39:00.83,Default,,0,0,0,,Бұл Кәпектің кінәсі емес Дұрыс!
Dialogue: 0,0:39:03.92,0:39:06.55,Default,,0,0,0,,«Музыкант лицензиясы»!
Dialogue: 0,0:39:06.63,0:39:08.26,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:39:08.34,0:39:12.01,Default,,0,0,0,,Егер сіз оны ұстасаңыз, құрал сіздің деңгейіңізге бейімделеді.
Dialogue: 0,0:39:12.68,0:39:14.35,Default,,0,0,0,,Бірге жаттығу
Dialogue: 0,0:39:14.43,0:39:17.18,Default,,0,0,0,,Бұл деңгейді көтеруге мүмкіндік беретін құрал.
Dialogue: 0,0:39:17.27,0:39:18.43,Default,,0,0,0,,Иә
Dialogue: 0,0:39:18.52,0:39:20.31,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:39:23.61,0:39:24.82,Default,,0,0,0,,Ах
Dialogue: 0,0:39:26.53,0:39:29.15,Default,,0,0,0,,Уау, керемет!
Dialogue: 0,0:39:29.24,0:39:31.91,Default,,0,0,0,,Иә? Уау...
Dialogue: 0,0:39:31.99,0:39:33.87,Default,,0,0,0,,(бонго дыбысы)
Dialogue: 0,0:39:33.95,0:39:36.41,Default,,0,0,0,,(Скрипка дыбысы)
Dialogue: 0,0:39:36.49,0:39:38.79,Default,,0,0,0,,(туба дыбысы)
Dialogue: 0,0:39:39.75,0:39:43.00,Default,,0,0,0,,Лицензиямен бекітілген музыкалық аспаптарда өсиет болады.
Dialogue: 0,0:39:43.08,0:39:45.63,Default,,0,0,0,,Мен тілде сөйлей алмаймын.
Dialogue: 0,0:39:45.71,0:39:47.46,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:39:47.55,0:39:49.09,Default,,0,0,0,,Дыбыстық сигнал естілді!
Dialogue: 0,0:39:49.17,0:39:50.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:50.88,0:39:52.55,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:39:52.64,0:39:54.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:55.05,0:39:56.26,Default,,0,0,0,,Мен де Мен де!
Dialogue: 0,0:39:56.35,0:39:59.68,Default,,0,0,0,,Бұл керней ме? Немесе гитара!?
Dialogue: 0,0:40:01.64,0:40:02.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:03.02,0:40:04.23,Default,,0,0,0,,Бұл...
Dialogue: 0,0:40:04.81,0:40:06.69,Default,,0,0,0,,Менің магнитофоным!?
Dialogue: 0,0:40:06.77,0:40:08.94,Default,,0,0,0,,Иә Лицензия
Dialogue: 0,0:40:14.53,0:40:15.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:15.45,0:40:19.12,Default,,0,0,0,,(магнитофон тәрізді дыбыс)
Dialogue: 0,0:40:19.20,0:40:21.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:21.91,0:40:25.54,Default,,0,0,0,,Кукукукукку, бұл Нобитаға жарасады.
Dialogue: 0,0:40:25.63,0:40:28.30,Default,,0,0,0,,Ол «жоқ» дыбысының шебері!
Dialogue: 0,0:40:28.92,0:40:30.55,Default,,0,0,0,,Не?!
Dialogue: 0,0:40:30.63,0:40:32.01,Default,,0,0,0,,- Уа! -(Сунео) Жоқ!
Dialogue: 0,0:40:32.09,0:40:34.26,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:40:35.01,0:40:37.01,Default,,0,0,0,,Сіздің жолыңызда ертерек
Dialogue: 0,0:40:37.10,0:40:39.68,Default,,0,0,0,,Сырттағы аумақты жандандыру керек еді.
Dialogue: 0,0:40:39.77,0:40:41.27,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:40:41.35,0:40:44.35,Default,,0,0,0,,Мен сыртқа шыға аламын! Алақай!
Dialogue: 0,0:40:44.44,0:40:48.32,Default,,0,0,0,,Барлығы, лицензияның бұрышымен құралды түртіп көріңіз.
Dialogue: 0,0:40:48.40,0:40:49.98,Default,,0,0,0,,Хмм?
Dialogue: 0,0:40:50.07,0:40:51.15,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:40:51.24,0:40:52.28,Default,,0,0,0,,Ой!
Dialogue: 0,0:40:52.86,0:40:54.20,Default,,0,0,0,,(туба дыбысы)
Dialogue: 0,0:40:54.99,0:40:56.24,Default,,0,0,0,,О!
Dialogue: 0,0:40:56.32,0:41:00.66,Default,,0,0,0,,Сіз кез келген ауыр аспапты салпыншақ ретінде алып жүре аласыз.
Dialogue: 0,0:41:00.74,0:41:02.96,Default,,0,0,0,,Сіз оны әрқашан тарту арқылы қайтара аласыз.
Dialogue: 0,0:41:03.04,0:41:05.04,Default,,0,0,0,,Хехехе
Dialogue: 0,0:41:05.12,0:41:06.92,Default,,0,0,0,,(Скрипка мен бонго дыбыстары)
Dialogue: 0,0:41:07.00,0:41:08.67,Default,,0,0,0,,- (Сунео) Уау! - сүйкімді!
Dialogue: 0,0:41:08.75,0:41:11.55,Default,,0,0,0,,Әй, неге магнитофон?
Dialogue: 0,0:41:11.63,0:41:13.30,Default,,0,0,0,,(ашулы дыбыс)
Dialogue: 0,0:41:14.43,0:41:16.14,Default,,0,0,0,,Мен мүлдем бақытты емеспін.
Dialogue: 0,0:41:16.22,0:41:17.55,Default,,0,0,0,,-Қызықты- Олай болса, бәріңе.
Dialogue: 0,0:41:17.64,0:41:19.31,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:41:20.01,0:41:21.31,Default,,0,0,0,,Қызықты
Dialogue: 0,0:41:22.52,0:41:23.93,Default,,0,0,0,,Ахх...
Dialogue: 0,0:41:24.02,0:41:24.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:24.98,0:41:25.85,Default,,0,0,0,,Қый!
Dialogue: 0,0:41:25.94,0:41:29.77,Default,,0,0,0,,Уа, не болып жатыр!?
Dialogue: 0,0:41:31.82,0:41:32.90,Default,,0,0,0,,- (Сунео) Уау - Иә!
Dialogue: 0,0:41:32.99,0:41:33.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:33.90,0:41:35.61,Default,,0,0,0,,Ннуну...
Dialogue: 0,0:41:37.11,0:41:38.16,Default,,0,0,0,,Уау! Ахх
Dialogue: 0,0:41:38.78,0:41:42.16,Default,,0,0,0,,(Бес адамның айқайы)
Dialogue: 0,0:41:42.83,0:41:44.16,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:41:45.21,0:41:47.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:48.54,0:41:50.75,Default,,0,0,0,,-Мика-сама! -Иә
Dialogue: 0,0:41:50.84,0:41:54.84,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:42:00.72,0:42:02.93,Default,,0,0,0,,Барлығы бір нәрсенің ұшып бара жатқанын елестетіңдер.
Dialogue: 0,0:42:03.02,0:42:04.85,Default,,0,0,0,,Тарифті ойнаңыз!
Dialogue: 0,0:42:04.93,0:42:06.48,Default,,0,0,0,,Керемет!
Dialogue: 0,0:42:06.56,0:42:08.81,Default,,0,0,0,,Неге екенін білмеймін, бірақ біз де!
Dialogue: 0,0:42:11.36,0:42:12.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:13.28,0:42:15.24,Default,,0,0,0,,(тыныс тәрізді дыбыс)
Dialogue: 0,0:42:15.32,0:42:16.15,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:42:16.74,0:42:19.03,Default,,0,0,0,,(жағымсыз дыбыс)
Dialogue: 0,0:42:19.11,0:42:20.16,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:42:20.24,0:42:22.83,Default,,0,0,0,,(кекірген дыбыс)
Dialogue: 0,0:42:23.74,0:42:26.08,Default,,0,0,0,,Дааааааааа!
Dialogue: 0,0:42:27.37,0:42:29.79,Default,,0,0,0,,- Фу - (Сунео) Не ​​болып жатыр?
Dialogue: 0,0:42:29.88,0:42:31.67,Default,,0,0,0,,Ах... Нобита ше?
Dialogue: 0,0:42:31.75,0:42:32.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:32.92,0:42:34.34,Default,,0,0,0,,Эй!
Dialogue: 0,0:42:34.42,0:42:37.80,Default,,0,0,0,,Міне!
Dialogue: 0,0:42:39.13,0:42:40.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:40.39,0:42:43.22,Default,,0,0,0,,Менің тарифім оған тұрарлық емес!
Dialogue: 0,0:42:43.31,0:42:45.06,Default,,0,0,0,,Микка-сама, бар!
Dialogue: 0,0:42:45.14,0:42:46.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:48.39,0:42:50.60,Default,,0,0,0,,Мен оны ұстай алмаймын, сэр.
Dialogue: 0,0:42:50.69,0:42:52.15,Default,,0,0,0,,(дыбыс)
Dialogue: 0,0:42:52.23,0:42:55.23,Default,,0,0,0,,Ешқандай балық аулай алмайтыныңыз табиғи нәрсе.
Dialogue: 0,0:42:55.82,0:42:58.36,Default,,0,0,0,,Өйткені су ағып жатқан жоқ.
Dialogue: 0,0:42:58.45,0:43:02.91,Default,,0,0,0,,Біз қанша уақыт ұйықтадық?
Dialogue: 0,0:43:02.99,0:43:04.33,Default,,0,0,0,,Бұл не? ол
Dialogue: 0,0:43:04.41,0:43:06.00,Default,,0,0,0,,- (Нобита) Уау! -Артық керек емес!
Dialogue: 0,0:43:06.66,0:43:08.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:43:08.71,0:43:10.04,Default,,0,0,0,,- (Нобита) Уау! -Эй!
Dialogue: 0,0:43:10.12,0:43:10.96,Default,,0,0,0,,Мугю
Dialogue: 0,0:43:12.42,0:43:13.71,Default,,0,0,0,,(Стефани) Бірдеңе шығармашылық болса болмас па?
Dialogue: 0,0:43:13.79,0:43:14.92,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:43:15.00,0:43:17.38,Default,,0,0,0,,Нобита!
Dialogue: 0,0:43:17.46,0:43:19.26,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:43:19.93,0:43:21.68,Default,,0,0,0,,Нобита-сан, жақсысың ба?
Dialogue: 0,0:43:21.76,0:43:22.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:22.85,0:43:23.97,Default,,0,0,0,,Бұл адамдар...
Dialogue: 0,0:43:24.05,0:43:27.14,Default,,0,0,0,,Мистер Батч! Мотцель мырза!
Dialogue: 0,0:43:27.22,0:43:30.31,Default,,0,0,0,,Capek! Біраз уақыт өтті!
Dialogue: 0,0:43:30.39,0:43:32.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:32.73,0:43:33.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:34.15,0:43:35.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:35.73,0:43:39.86,Default,,0,0,0,,Қайырлы күн Микка-сама, сен есейесің...
Dialogue: 0,0:43:39.95,0:43:43.12,Default,,0,0,0,,Мен Мотцельмін, ал бұл профессор Бах.
Dialogue: 0,0:43:43.20,0:43:44.78,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:43:44.87,0:43:47.62,Default,,0,0,0,,Не, сен мен туралы білесің бе?
Dialogue: 0,0:43:47.70,0:43:50.00,Default,,0,0,0,,Әрине! мұндағы адамдар
Dialogue: 0,0:43:50.08,0:43:52.58,Default,,0,0,0,,Сіз туралы барлығы біледі.
Dialogue: 0,0:43:52.67,0:43:54.25,Default,,0,0,0,,Барлығы...?
Dialogue: 0,0:43:54.34,0:43:55.79,Default,,0,0,0,,Басқалар да бар!
Dialogue: 0,0:43:55.88,0:43:57.05,Default,,0,0,0,,Иә
Dialogue: 0,0:43:57.13,0:43:58.13,Default,,0,0,0,,Capek
Dialogue: 0,0:43:58.21,0:44:00.26,Default,,0,0,0,,Маэстро Вентомен кездестіңіз бе?
Dialogue: 0,0:44:00.34,0:44:02.84,Default,,0,0,0,,Тек мен және Микка-сама оянамыз.
Dialogue: 0,0:44:02.93,0:44:05.05,Default,,0,0,0,,Даңқ залы әлі ұйықтап жатыр.
Dialogue: 0,0:44:05.14,0:44:07.60,Default,,0,0,0,,Мен де маэстромен байланыса алмаймын.
Dialogue: 0,0:44:07.68,0:44:09.68,Default,,0,0,0,,Сонымен, бұл Виртуоз
Dialogue: 0,0:44:09.77,0:44:11.81,Default,,0,0,0,,Мен оны жерден алдым.
Dialogue: 0,0:44:11.89,0:44:13.73,Default,,0,0,0,,Даңқ залын ояту үшін!
Dialogue: 0,0:44:13.81,0:44:15.86,Default,,0,0,0,,Виртуоз?
Dialogue: 0,0:44:15.94,0:44:19.57,Default,,0,0,0,,Түсіндім! бұл сендіреді
Dialogue: 0,0:44:19.65,0:44:20.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:44:21.03,0:44:24.91,Default,,0,0,0,,Осы өзенге су құюға рұқсат бере аласыз ба?
Dialogue: 0,0:44:24.99,0:44:28.12,Default,,0,0,0,,- Су? -(Сунео) Аа... қалай?
Dialogue: 0,0:44:28.20,0:44:29.79,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:44:29.87,0:44:31.83,Default,,0,0,0,,Егер сіз виртуоз болсаңыз!
Dialogue: 0,0:44:31.91,0:44:33.17,Default,,0,0,0,,Сол бағанада
Dialogue: 0,0:44:33.25,0:44:35.08,Default,,0,0,0,,Тарифтік энергияны алсаңыз
Dialogue: 0,0:44:35.17,0:44:36.54,Default,,0,0,0,,Су ағады
Dialogue: 0,0:44:36.63,0:44:38.71,Default,,0,0,0,,Хехехехе, сол допқа қарай
Dialogue: 0,0:44:38.80,0:44:40.26,Default,,0,0,0,,Мен оны үрлеуім керек пе?
Dialogue: 0,0:44:40.34,0:44:42.30,Default,,0,0,0,,Бұл Фарре Кені
Dialogue: 0,0:44:42.38,0:44:45.76,Default,,0,0,0,,Фарреге әсер ету энергияның үлкен мөлшерін шығарады.
Dialogue: 0,0:44:45.84,0:44:49.14,Default,,0,0,0,,Музыка өз күшімен өркениет құрды.
Dialogue: 0,0:44:49.22,0:44:52.48,Default,,0,0,0,,Фарре - бәрін қозғалтатын энергия көзі!
Dialogue: 0,0:44:52.56,0:44:55.77,Default,,0,0,0,,Бұл музыканың электр тогы сияқты дегенді білдіре ме?
Dialogue: 0,0:44:55.85,0:44:56.94,Default,,0,0,0,,Мен солай ойлаймын
Dialogue: 0,0:44:57.02,0:44:58.94,Default,,0,0,0,,Қандай керемет дүние!
Dialogue: 0,0:44:59.02,0:45:02.69,Default,,0,0,0,,Бұл шынымен де... әдемі жұлдыз болды.
Dialogue: 0,0:45:02.78,0:45:05.99,Default,,0,0,0,,(Қарлыған туба дыбысы)
Dialogue: 0,0:45:09.28,0:45:10.45,Default,,0,0,0,,(Сұңқыр дыбыс)
Dialogue: 0,0:45:13.04,0:45:15.92,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:45:16.00,0:45:18.46,Default,,0,0,0,,Я... тағы да!
Dialogue: 0,0:45:18.54,0:45:20.92,Default,,0,0,0,,Осылай ашулансаң жақсы емес.
Dialogue: 0,0:45:21.00,0:45:24.09,Default,,0,0,0,,Бірақ Джианның өкпе сыйымдылығы керемет!
Dialogue: 0,0:45:24.17,0:45:26.47,Default,,0,0,0,,Ән айту сияқты табиғи!
Dialogue: 0,0:45:26.55,0:45:27.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:28.97,0:45:31.10,Default,,0,0,0,,(туба дыбысы)
Dialogue: 0,0:45:31.18,0:45:34.69,Default,,0,0,0,,О? Көп дем алып, көп дем шығару керек пе?
Dialogue: 0,0:45:34.77,0:45:36.48,Default,,0,0,0,,Мынау... осылай ма?
Dialogue: 0,0:45:38.52,0:45:45.49,Default,,0,0,0,,...
Dialogue: 0,0:45:48.53,0:45:50.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:45:50.33,0:45:53.00,Default,,0,0,0,,Керемет! Міне солай!
Dialogue: 0,0:45:53.08,0:45:54.83,Default,,0,0,0,,Мен де!
Dialogue: 0,0:45:56.58,0:45:57.71,Default,,0,0,0,,Бірақ қызық емес пе?
Dialogue: 0,0:45:59.33,0:46:00.75,Default,,0,0,0,,Бірақ ол жоғалып кетті...
Dialogue: 0,0:46:00.84,0:46:03.46,Default,,0,0,0,,(бонго дыбысы)
Dialogue: 0,0:46:03.55,0:46:04.92,Default,,0,0,0,,Ал...
Dialogue: 0,0:46:05.01,0:46:07.38,Default,,0,0,0,,Денеңізді пайдаланып билегенді ұнатасыз ба?
Dialogue: 0,0:46:07.47,0:46:09.55,Default,,0,0,0,,(ритмикалық дыбыстар)
Dialogue: 0,0:46:09.64,0:46:13.35,Default,,0,0,0,,Соқпалы аспаптар инстинктивті эмоцияны білдіреді
Dialogue: 0,0:46:13.43,0:46:15.77,Default,,0,0,0,,Ұялма, жүрегіңе бағын!
Dialogue: 0,0:46:21.40,0:46:22.27,Default,,0,0,0,,Ахаха
Dialogue: 0,0:46:26.11,0:46:30.12,Default,,0,0,0,,(скрипканың жағымсыз дыбысы)
Dialogue: 0,0:46:34.20,0:46:35.58,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:46:36.08,0:46:39.08,Default,,0,0,0,,Барлығыңыз қобалжыдыңыздар ма?
Dialogue: 0,0:46:39.17,0:46:42.34,Default,,0,0,0,,(Скрипка дыбысы)
Dialogue: 0,0:46:42.42,0:46:43.84,Default,,0,0,0,,Ақырынырақ...?
Dialogue: 0,0:46:46.47,0:46:50.18,Default,,0,0,0,,(таза дыбыс)
Dialogue: 0,0:46:50.26,0:46:52.05,Default,,0,0,0,,Енді ше!
Dialogue: 0,0:46:52.14,0:46:58.94,Default,,0,0,0,,...
Dialogue: 0,0:47:01.61,0:47:04.15,Default,,0,0,0,,Өте жақсы екен!
Dialogue: 0,0:47:04.23,0:47:08.20,Default,,0,0,0,,Аспаптардың дауысын енді барлығы еститін сияқты.
Dialogue: 0,0:47:08.28,0:47:10.32,Default,,0,0,0,,Мен де Нохохон көзілдірігін қолданып көрейін.
Dialogue: 0,0:47:10.41,0:47:12.37,Default,,0,0,0,,Иә!? Ах...
Dialogue: 0,0:47:12.45,0:47:14.16,Default,,0,0,0,,Жарайды... Жарайды!
Dialogue: 0,0:47:17.29,0:47:23.50,Default,,0,0,0,,(до-ре-ми-фа-сорашидің сүрінген дыбысы)
Dialogue: 0,0:47:23.59,0:47:24.80,Default,,0,0,0,,(«жоқ» дыбысы)
Dialogue: 0,0:47:26.88,0:47:29.17,Default,,0,0,0,,-Ахахаха - (Сунео) Не істеп жатырсың!
Dialogue: 0,0:47:29.26,0:47:31.30,Default,,0,0,0,,Менің лицензиям болса да...
Dialogue: 0,0:47:31.39,0:47:34.35,Default,,0,0,0,,Сіз мүлде жақсы ойнай алмайсыз!
Dialogue: 0,0:47:34.43,0:47:37.31,Default,,0,0,0,,(магнитофон дыбысы)
Dialogue: 0,0:47:37.39,0:47:39.10,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:47:39.18,0:47:41.23,Default,,0,0,0,,Бұл жазу құрылғысы бұзылған.
Dialogue: 0,0:47:41.31,0:47:43.06,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:47:43.15,0:47:44.82,Default,,0,0,0,,Мазалама, Нобита!
Dialogue: 0,0:47:45.77,0:47:51.57,Default,,0,0,0,,(Үш адамның тамаша орындауы)
Dialogue: 0,0:47:58.91,0:48:01.08,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,0:48:01.16,0:48:03.04,Default,,0,0,0,,(Су дыбысы)
Dialogue: 0,0:48:11.68,0:48:13.80,Default,,0,0,0,,Бұл су, сэр!
Dialogue: 0,0:48:13.89,0:48:15.64,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:48:15.72,0:48:17.35,Default,,0,0,0,,(Арфа тәрізді дыбыс)
Dialogue: 0,0:48:17.43,0:48:20.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:48:22.39,0:48:24.90,Default,,0,0,0,,Ах, мен өмірге қайта оралатын сияқтымын.
Dialogue: 0,0:48:24.98,0:48:26.27,Default,,0,0,0,,(қоңырау қоңырау! дыбысы)
Dialogue: 0,0:48:26.36,0:48:28.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:32.28,0:48:34.91,Default,,0,0,0,,Иә! Деңгей көтерілді!
Dialogue: 0,0:48:34.99,0:48:36.91,Default,,0,0,0,,- (Сунео) Мен де! -мен де!
Dialogue: 0,0:48:36.99,0:48:38.29,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:48:38.37,0:48:40.12,Default,,0,0,0,,Нобита-кунды жайына қалдыр.
Dialogue: 0,0:48:40.20,0:48:41.46,Default,,0,0,0,,Күй!
Dialogue: 0,0:48:41.54,0:48:44.25,Default,,0,0,0,,Бәріңе сәлем! Бұл!
Dialogue: 0,0:48:45.00,0:48:45.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:47.25,0:48:51.30,Default,,0,0,0,,Орман қазіргі Тарифпен оянған сияқты!
Dialogue: 0,0:48:52.88,0:48:54.43,Default,,0,0,0,,Тез барайық
Dialogue: 0,0:48:54.51,0:48:56.39,Default,,0,0,0,,Қалай жүрсің?
Dialogue: 0,0:48:56.47,0:48:58.01,Default,,0,0,0,,Бұл оңай
Dialogue: 0,0:48:58.60,0:49:00.68,Default,,0,0,0,,Фарре ойнау
Dialogue: 0,0:49:00.77,0:49:04.98,Default,,0,0,0,,Аспанда еркін ұшып бара жатқаныңызды елестетіңіз!
Dialogue: 0,0:49:05.06,0:49:06.69,Default,,0,0,0,,(Tuba өнімділігі)
Dialogue: 0,0:49:06.77,0:49:09.98,Default,,0,0,0,,Уау, керемет! (скрипка орындауы)
Dialogue: 0,0:49:10.07,0:49:11.94,Default,,0,0,0,,Мен мұны осы жолы жасадым!
Dialogue: 0,0:49:12.03,0:49:14.40,Default,,0,0,0,,Фарре керемет!
Dialogue: 0,0:49:14.49,0:49:15.99,Default,,0,0,0,,(Миканың ән салған дауысы)
Dialogue: 0,0:49:16.07,0:49:17.91,Default,,0,0,0,,Ханымдар мен мырзалар, болды!
Dialogue: 0,0:49:17.99,0:49:19.95,Default,,0,0,0,,Неге бұл тек мен...
Dialogue: 0,0:49:20.04,0:49:22.41,Default,,0,0,0,,Дұрыс жаттығу, солай ма?
Dialogue: 0,0:49:22.50,0:49:25.08,Default,,0,0,0,,Абайлаңыз~
Dialogue: 0,0:49:26.46,0:49:27.96,Default,,0,0,0,,Қазір ойлап қарасам, дәл қазір
Dialogue: 0,0:49:28.04,0:49:30.38,Default,,0,0,0,,Мен сағыныш үнін естідім.
Dialogue: 0,0:49:30.96,0:49:32.80,Default,,0,0,0,,Не болды? мұғалім
Dialogue: 0,0:49:32.88,0:49:35.26,Default,,0,0,0,,(қоңырау қоңырау! дыбысы)
Dialogue: 0,0:49:35.93,0:49:40.39,Default,,0,0,0,,(Миканың ән салған дауысы)
Dialogue: 0,0:49:40.47,0:49:42.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:40.47,0:49:42.14,Default,,0,0,0,,(Скрипка орындауы)
Dialogue: 0,0:49:42.14,0:49:42.22,Default,,0,0,0,,(Скрипка орындауы)
Dialogue: 0,0:49:42.22,0:49:43.56,Default,,0,0,0,,(Скрипка орындауы)
Dialogue: 0,0:49:42.22,0:49:43.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:49:43.56,0:49:43.64,Default,,0,0,0,,(Скрипка орындауы)
Dialogue: 0,0:49:43.64,0:49:45.39,Default,,0,0,0,,(Скрипка орындауы)
Dialogue: 0,0:49:43.64,0:49:45.39,Default,,0,0,0,,Жұмбақ орман
Dialogue: 0,0:49:48.06,0:49:50.90,Default,,0,0,0,,Мен бұл әнді бір жерден естігендей болдым...
Dialogue: 0,0:49:50.98,0:49:52.90,Default,,0,0,0,,Иә?Ах!
Dialogue: 0,0:49:52.98,0:49:54.70,Default,,0,0,0,,-Ах! -(Нобита) Не?
Dialogue: 0,0:49:54.78,0:49:57.86,Default,,0,0,0,,-Ой, отты бәліштер? -Бұл...
Dialogue: 0,0:49:57.95,0:50:00.08,Default,,0,0,0,,А, бұл дыбысты жәндік!
Dialogue: 0,0:50:00.16,0:50:02.37,Default,,0,0,0,,Суреттер кітабында кездесетін дыбысты жәндік?
Dialogue: 0,0:50:02.45,0:50:03.33,Default,,0,0,0,,Манга ма? Ах, мен де бәрібір адам сияқты оқимын ғой, болар.
Dialogue: 0,0:50:03.41,0:50:05.83,Default,,0,0,0,,Әдемі фаррға дыбысты жәндік жауап береді.
Dialogue: 0,0:50:05.91,0:50:08.25,Default,,0,0,0,,Жарқырап тұратын әдеті бар.
Dialogue: 0,0:50:08.33,0:50:10.79,Default,,0,0,0,,Мен оның әлі осы орманда екеніне сене алар емеспін...
Dialogue: 0,0:50:10.88,0:50:12.84,Default,,0,0,0,,Сізге суретті кітаптар ұнайды ма?
Dialogue: 0,0:50:12.92,0:50:14.80,Default,,0,0,0,,Иә! Менің сүйіктім
Dialogue: 0,0:50:14.88,0:50:16.59,Default,,0,0,0,,Виртуоз бейнеленген суретті кітаптар
Dialogue: 0,0:50:16.68,0:50:17.97,Default,,0,0,0,,Каэдэ ол үшін біраз алаңдайды. Хайате де біраз жалғыз сияқты.
Dialogue: 0,0:50:18.05,0:50:20.26,Default,,0,0,0,,«Шеңбердегі виртуоздар мен роботтар»
Dialogue: 0,0:50:20.85,0:50:23.60,Default,,0,0,0,,«Ол өте әдемі ойнады».
Dialogue: 0,0:50:23.68,0:50:26.02,Default,,0,0,0,,«Дыбысты жәндіктер жарқырап ұшады»
Dialogue: 0,0:50:26.10,0:50:28.48,Default,,0,0,0,,«Әлем нұрға толды».
Dialogue: 0,0:50:28.56,0:50:31.82,Default,,0,0,0,,Кавахара концертін көргеннен кейін мен сенімді болдым!
Dialogue: 0,0:50:31.90,0:50:33.40,Default,,0,0,0,,Суретті кітаппен бірдей
Dialogue: 0,0:50:33.48,0:50:35.90,Default,,0,0,0,,Бұл Виртуоз мырза болуы керек!
Dialogue: 0,0:50:35.99,0:50:37.82,Default,,0,0,0,,Дыбыстық сигнал естілді!
Dialogue: 0,0:50:37.90,0:50:40.12,Default,,0,0,0,,Суретті кітап...?
Dialogue: 0,0:50:40.70,0:50:42.78,Default,,0,0,0,,Сонда мен көп тырысуым керек.
Dialogue: 0,0:50:42.87,0:50:44.95,Default,,0,0,0,,Мен кенеттен сенімімді жоғалта бастадым.
Dialogue: 0,0:50:45.04,0:50:46.37,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:50:46.46,0:50:49.75,Default,,0,0,0,,Мен суретті кітаптың кейіпкерлері екенімізге сене алар емеспін.
Dialogue: 0,0:50:49.83,0:50:51.84,Default,,0,0,0,,- Паропало! -Мика-сама!
Dialogue: 0,0:50:51.92,0:50:54.88,Default,,0,0,0,,- Паропало! Паро... -Аа...
Dialogue: 0,0:50:54.96,0:50:56.59,Default,,0,0,0,,-Жоқ~ -Паропало?
Dialogue: 0,0:50:56.67,0:50:58.76,Default,,0,0,0,,Қықылдау~
Dialogue: 0,0:50:59.30,0:51:02.93,Default,,0,0,0,,Жарайды! Бірақ Паропараның бар екендігі ...
Dialogue: 0,0:51:03.01,0:51:04.22,Default,,0,0,0,,Паропалок
Dialogue: 0,0:51:04.31,0:51:05.39,Default,,0,0,0,,Паро Паро!
Dialogue: 0,0:51:05.47,0:51:06.85,Default,,0,0,0,,Қоңырау шалып тұрған сияқты
Dialogue: 0,0:51:06.93,0:51:08.69,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:51:08.77,0:51:10.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:10.10,0:51:14.94,Default,,0,0,0,,(Такиреннің айқайы)
Dialogue: 0,0:51:16.11,0:51:18.65,Default,,0,0,0,,Күтілгендей! Бұл Такирен-сан болатын.
Dialogue: 0,0:51:18.74,0:51:19.70,Default,,0,0,0,,Міне, біз тағы да келдік!
Dialogue: 0,0:51:19.78,0:51:21.41,Default,,0,0,0,,Неге жылайсың?
Dialogue: 0,0:51:21.49,0:51:25.37,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:51:25.45,0:51:27.50,Default,,0,0,0,,Жыласаң мен түсінбеймін.
Dialogue: 0,0:51:27.58,0:51:30.04,Default,,0,0,0,,Мен саған бірдеңе бере аламын ба деп ойлаймын.
Dialogue: 0,0:51:30.12,0:51:32.08,Default,,0,0,0,,Осылай қалса жаман.
Dialogue: 0,0:51:32.67,0:51:36.00,Default,,0,0,0,,Осы орманда сенің сезімдерің ауа райымен байланысты.
Dialogue: 0,0:51:36.09,0:51:37.55,Default,,0,0,0,,Көңілді және шуақты
Dialogue: 0,0:51:37.63,0:51:40.34,Default,,0,0,0,,Мұңайсам, Жауады осылай
Dialogue: 0,0:51:40.43,0:51:42.76,Default,,0,0,0,,Бұл дауыл болуы мүмкін...
Dialogue: 0,0:51:42.84,0:51:45.47,Default,,0,0,0,,Не болды?
Dialogue: 0,0:51:45.56,0:51:47.68,Default,,0,0,0,,А... Мен бірдеңе ойнай аламын ба?
Dialogue: 0,0:51:47.77,0:51:50.81,Default,,0,0,0,,Дұрыс, Такирен-сан үшін ойнайық!
Dialogue: 0,0:51:50.89,0:51:52.44,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:51:52.52,0:51:54.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:51:55.44,0:51:56.61,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:51:56.69,0:51:58.03,Default,,0,0,0,,Оны Капек жазды!
Dialogue: 0,0:51:58.11,0:51:59.15,Default,,0,0,0,,Ми... Микка-сама...
Dialogue: 0,0:51:59.24,0:52:02.61,Default,,0,0,0,,Бұл таңқаларлық. Сіз музыка жаза аласыз ба?
Dialogue: 0,0:52:03.20,0:52:07.08,Default,,0,0,0,,Маэстро сияқты композитор болғым келеді...
Dialogue: 0,0:52:07.16,0:52:09.79,Default,,0,0,0,,Мен Жердің музыкасын зерттеп жатырмын!
Dialogue: 0,0:52:09.87,0:52:11.83,Default,,0,0,0,,Қандай көңілді ән!
Dialogue: 0,0:52:11.92,0:52:13.46,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:52:13.54,0:52:15.84,Default,,0,0,0,,Керемет! Жайлап оқыңыз!
Dialogue: 0,0:52:15.92,0:52:18.80,Default,,0,0,0,,Бұл да «музыкант лицензиясының» күші
Dialogue: 0,0:52:18.88,0:52:20.30,Default,,0,0,0,,Және…
Dialogue: 0,0:52:21.01,0:52:24.26,Default,,0,0,0,,«Маэстро қалпақ және таяқша»!
Dialogue: 0,0:52:24.34,0:52:25.22,Default,,0,0,0,,Ечен!
Dialogue: 0,0:52:25.30,0:52:28.68,Default,,0,0,0,,Қаншалықты нашар болса да тамаша өнімділік жасай алатын құрал ма?
Dialogue: 0,0:52:28.77,0:52:31.27,Default,,0,0,0,,Жоқ, бұл жай ғана парик пен таяқ.
Dialogue: 0,0:52:31.35,0:52:32.23,Default,,0,0,0,,Біз қашып кете аламыз. Бұл оңай болады.
Dialogue: 0,0:52:32.31,0:52:33.44,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:52:33.52,0:52:34.56,Default,,0,0,0,,Хаха
Dialogue: 0,0:52:34.65,0:52:35.61,Default,,0,0,0,,Ах
Dialogue: 0,0:52:36.86,0:52:38.78,Default,,0,0,0,,Иә, маримба!?
Dialogue: 0,0:52:38.86,0:52:42.07,Default,,0,0,0,,Ұрмалы аспаптар әнге қарай өзгеріп отырады.
Dialogue: 0,0:52:42.15,0:52:44.07,Default,,0,0,0,,Олай болса
Dialogue: 0,0:52:46.83,0:52:51.25,Default,,0,0,0,,(4 адам орындау: негізгі негізгі ән)
Dialogue: 0,0:52:51.33,0:52:58.00,Default,,0,0,0,,(Диктофонның өнімділігі тек «C»)
Dialogue: 0,0:52:58.09,0:53:02.51,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:53:07.10,0:53:12.52,Default,,0,0,0,,(4 адам орындау)
Dialogue: 0,0:53:14.60,0:53:17.02,Default,,0,0,0,,- Уф... Хэхе - А?
Dialogue: 0,0:53:17.11,0:53:18.73,Default,,0,0,0,,Иносукэ, кешір мені. Егер оны ертерек байқап қалсам...
Dialogue: 0,0:53:18.82,0:53:21.23,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:53:21.32,0:53:23.53,Default,,0,0,0,,Қолымнан келмей күліп тұрған сияқтымын
Dialogue: 0,0:53:23.61,0:53:26.62,Default,,0,0,0,,Тоқташы Ахахха...
Dialogue: 0,0:53:26.70,0:53:28.78,Default,,0,0,0,,Аа, қандай ұят...
Dialogue: 0,0:53:28.87,0:53:31.08,Default,,0,0,0,,(күн күркіреуі)
Dialogue: 0,0:53:31.16,0:53:32.54,Default,,0,0,0,,Бұл кері нәтиже емес пе?
Dialogue: 0,0:53:32.62,0:53:35.04,Default,,0,0,0,,Иә? мм... хмм?
Dialogue: 0,0:53:35.12,0:53:40.13,Default,,0,0,0,,(тіркегіштің дыбысы сәл төмен)
Dialogue: 0,0:53:44.42,0:53:45.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:45.76,0:53:46.80,Default,,0,0,0,,Паро?
Dialogue: 0,0:53:46.89,0:53:48.55,Default,,0,0,0,,Сәлем Нобита!
Dialogue: 0,0:53:48.64,0:53:50.68,Default,,0,0,0,,Дыбыс синхрондалмаған!
Dialogue: 0,0:53:50.76,0:53:52.93,Default,,0,0,0,,Иә!? Кешіріңіз... кешіріңіз
Dialogue: 0,0:53:53.02,0:53:56.02,Default,,0,0,0,,Бірақ қалай болғанда да бұл қайғылы сезінуге өте ыңғайлы.
Dialogue: 0,0:53:56.10,0:53:57.77,Default,,0,0,0,,Жаңбыр басылды
Dialogue: 0,0:53:58.36,0:54:00.15,Default,,0,0,0,,Дыбыстық сигнал естілді!
Dialogue: 0,0:54:00.23,0:54:01.32,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:54:01.40,0:54:04.24,Default,,0,0,0,,Сезіміңізге жақын болу маңызды ма?
Dialogue: 0,0:54:04.32,0:54:08.20,Default,,0,0,0,,Барлықтарыңызға тағы да рахмет!
Dialogue: 0,0:54:09.37,0:54:11.74,Default,,0,0,0,,Содан кейін қайтадан
Dialogue: 0,0:54:12.91,0:54:18.08,Default,,0,0,0,,(4 адамның орындауы: кіші кілттегі шығарма)
Dialogue: 0,0:54:18.17,0:54:23.09,Default,,0,0,0,,(Тек «ши» дыбысымен жазу құрылғысының өнімділігі)
Dialogue: 0,0:54:31.72,0:54:35.35,Default,,0,0,0,,Әй, бұл қандай өкінішті тариф.
Dialogue: 0,0:54:35.43,0:54:36.27,Default,,0,0,0,,Паро!
Dialogue: 0,0:54:36.35,0:54:38.35,Default,,0,0,0,,О, паро!
Dialogue: 0,0:55:09.47,0:55:11.01,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:55:11.09,0:55:12.60,Default,,0,0,0,,Жаңбыр тоқтады!
Dialogue: 0,0:55:12.68,0:55:15.27,Default,,0,0,0,,(пирорин дыбысы)
Dialogue: 0,0:55:15.35,0:55:17.64,Default,,0,0,0,,Иә! Деңгей қайтадан көтерілді!
Dialogue: 0,0:55:17.73,0:55:18.64,Default,,0,0,0,,Мен де!
Dialogue: 0,0:55:19.94,0:55:21.35,Default,,0,0,0,,Үш ескерту
Dialogue: 0,0:55:21.44,0:55:23.65,Default,,0,0,0,,Менің ойымша, бұл кәсіби деңгей?
Dialogue: 0,0:55:23.73,0:55:25.15,Default,,0,0,0,,Хмм?
Dialogue: 0,0:55:25.69,0:55:26.53,Default,,0,0,0,,Хмм?
Dialogue: 0,0:55:26.61,0:55:28.32,Default,,0,0,0,,Бұл жеңіл тариф болды
Dialogue: 0,0:55:29.36,0:55:32.20,Default,,0,0,0,,Мен қайтыс болған Ұстазыммен енді ешқашан кездесе алмаймын.
Dialogue: 0,0:55:32.28,0:55:34.53,Default,,0,0,0,,Мен өкінемін...
Dialogue: 0,0:55:34.62,0:55:36.62,Default,,0,0,0,,Сізге рахмет, мен өзімді жақсы сезінемін.
Dialogue: 0,0:55:36.70,0:55:37.54,Default,,0,0,0,,Паро!
Dialogue: 0,0:55:37.62,0:55:39.54,Default,,0,0,0,,«Өлген» нені білдіреді?
Dialogue: 0,0:55:39.62,0:55:41.00,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:55:41.67,0:55:42.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:42.75,0:55:44.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:44.54,0:55:46.17,Default,,0,0,0,,Бұрынғыдан алыс
Dialogue: 0,0:55:46.25,0:55:48.47,Default,,0,0,0,,Сіз күш-қуатқа толы сияқтысыз.
Dialogue: 0,0:55:48.55,0:55:49.80,Default,,0,0,0,,Паро Паро!
Dialogue: 0,0:55:50.47,0:55:51.30,Default,,0,0,0,,Кеттік
Dialogue: 0,0:55:51.38,0:55:53.43,Default,,0,0,0,,Ах... Микка-сама!
Dialogue: 0,0:55:56.14,0:55:58.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:00.98,0:56:04.36,Default,,0,0,0,,Тағы бір жаңа орын оянды!
Dialogue: 0,0:56:11.03,0:56:12.20,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:56:12.86,0:56:14.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:14.20,0:56:16.74,Default,,0,0,0,,Бұл бізді жаратқан Ұстаз
Dialogue: 0,0:56:17.49,0:56:20.00,Default,,0,0,0,,Мушика халқының бейіті
Dialogue: 0,0:56:20.08,0:56:21.54,Default,,0,0,0,,Қабір!?
Dialogue: 0,0:56:29.38,0:56:31.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:31.09,0:56:32.76,Default,,0,0,0,,Сіз әдемі адамсыз.
Dialogue: 0,0:56:32.84,0:56:35.05,Default,,0,0,0,,Музыка құдайы
Dialogue: 0,0:56:35.14,0:56:37.31,Default,,0,0,0,,Богиня ойнайтын сыбызғының фары
Dialogue: 0,0:56:37.39,0:56:41.23,Default,,0,0,0,,Оның кез келген мұңды немесе ауруды емдей алатын күші болды.
Dialogue: 0,0:56:41.31,0:56:44.40,Default,,0,0,0,,Бұл адам... робот емес.
Dialogue: 0,0:56:44.48,0:56:46.52,Default,,0,0,0,,Бұрын да осында болған шығар
Dialogue: 0,0:56:46.61,0:56:48.94,Default,,0,0,0,,Менің ойымша, ол жерде мушика халқы өмір сүрген.
Dialogue: 0,0:56:49.69,0:56:51.90,Default,,0,0,0,,Барлығы қайда кетті?
Dialogue: 0,0:56:54.74,0:56:55.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:56.45,0:56:58.33,Default,,0,0,0,,(поророн дыбысы)
Dialogue: 0,0:56:58.41,0:57:00.87,Default,,0,0,0,,Сіз маған айтқан жоқсыз.
Dialogue: 0,0:57:01.66,0:57:04.87,Default,,0,0,0,,Бұл да менің қорымшы ретіндегі міндетім.
Dialogue: 0,0:57:04.96,0:57:06.79,Default,,0,0,0,,Маған еріңіз
Dialogue: 0,0:57:09.75,0:57:12.26,Default,,0,0,0,,-Бұл... -Өтірік, солай ма?
Dialogue: 0,0:57:12.34,0:57:14.55,Default,,0,0,0,,Барлық... қабірлер!?
Dialogue: 0,0:57:14.63,0:57:15.47,Default,,0,0,0,,Ах
Dialogue: 0,0:57:17.80,0:57:20.64,Default,,0,0,0,,Біздің туған планетамыз Мушика
Dialogue: 0,0:57:20.72,0:57:21.68,Default,,0,0,0,,алыс
Dialogue: 0,0:57:22.85,0:57:25.15,Default,,0,0,0,,Ұлы апаттан қираған
Dialogue: 0,0:57:25.23,0:57:26.86,Default,,0,0,0,,Голонда!?
Dialogue: 0,0:57:26.94,0:57:28.57,Default,,0,0,0,,Бұл...
Dialogue: 0,0:57:28.65,0:57:29.82,Default,,0,0,0,,Бұл Даңқ залы
Dialogue: 0,0:57:29.90,0:57:32.82,Default,,0,0,0,,Үлкен апаттан аман қалған бірнеше музыкалық адамдармен.
Dialogue: 0,0:57:32.90,0:57:36.87,Default,,0,0,0,,Бұл роботы бар құтқару қайығы болды.
Dialogue: 0,0:57:36.95,0:57:38.99,Default,,0,0,0,,Сол Мушика адамдары ше?
Dialogue: 0,0:57:39.08,0:57:40.99,Default,,0,0,0,,Сіз әлі осындасыз ба?
Dialogue: 0,0:57:41.79,0:57:45.71,Default,,0,0,0,,Өкінішке орай, сол соңғы бала...
Dialogue: 0,0:57:46.96,0:57:49.67,Default,,0,0,0,,Бұл... мен бе?
Dialogue: 0,0:57:49.75,0:57:51.42,Default,,0,0,0,,Қожайынынан айырылған зал
Dialogue: 0,0:57:51.50,0:57:55.59,Default,,0,0,0,,Біз роботтармен бірге ұзақ ұйқыға кеттік.
Dialogue: 0,0:57:55.68,0:57:56.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:56.72,0:57:59.35,Default,,0,0,0,,Неліктен бұл қазір...
Dialogue: 0,0:57:59.43,0:58:02.31,Default,,0,0,0,,Бұл қандай үлкен апат?
Dialogue: 0,0:58:02.39,0:58:05.10,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін.
Dialogue: 0,0:58:05.19,0:58:08.02,Default,,0,0,0,,Маэстро Венто түсінуі керек.
Dialogue: 0,0:58:08.10,0:58:09.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:09.52,0:58:11.23,Default,,0,0,0,,Тыңда, Капек.
Dialogue: 0,0:58:11.82,0:58:13.48,Default,,0,0,0,,Осы балаға бірдеңе болса
Dialogue: 0,0:58:13.57,0:58:15.99,Default,,0,0,0,,Мен сені де оянуға бағдарламаладым.
Dialogue: 0,0:58:16.74,0:58:18.28,Default,,0,0,0,,Мұғалім ше!?
Dialogue: 0,0:58:18.36,0:58:21.33,Default,,0,0,0,,Мен оған қарап тұруым керек.
Dialogue: 0,0:58:21.41,0:58:24.62,Default,,0,0,0,,Біз Фарренің өлуіне жол бере алмаймыз.
Dialogue: 0,0:58:25.87,0:58:27.25,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:58:27.83,0:58:30.63,Default,,0,0,0,,Мен Микканы сұрадым.
Dialogue: 0,0:58:35.17,0:58:36.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:58:36.30,0:58:39.14,Default,,0,0,0,,Кешіріңіз, Микка-сама.
Dialogue: 0,0:58:39.22,0:58:41.64,Default,,0,0,0,,I… I…
Dialogue: 0,0:58:42.43,0:58:44.43,Default,,0,0,0,,Микка-чан... аа
Dialogue: 0,0:58:44.52,0:58:47.39,Default,,0,0,0,,Хехе... Ахахахаха!
Dialogue: 0,0:58:47.48,0:58:50.19,Default,,0,0,0,,Не! мен білдім
Dialogue: 0,0:58:50.27,0:58:52.65,Default,,0,0,0,,Capek Мен өтірік айтудан кенде емеспін.
Dialogue: 0,0:58:52.73,0:58:55.53,Default,,0,0,0,,Маған музыкалық адамдар немесе басқа нәрсе маңызды емес!
Dialogue: 0,0:58:55.61,0:58:57.49,Default,,0,0,0,,Моцель мырза, Бах мырза, т.б.
Dialogue: 0,0:58:57.57,0:58:58.70,Default,,0,0,0,,Такирен мырза т.б.
Dialogue: 0,0:58:58.78,0:59:00.53,Default,,0,0,0,,Бұл жерде әлі де көп адамдар бар, солай емес пе?
Dialogue: 0,0:59:00.62,0:59:01.49,Default,,0,0,0,,Иә
Dialogue: 0,0:59:01.57,0:59:03.70,Default,,0,0,0,,Мен тезірек барлығын оятуым керек!
Dialogue: 0,0:59:03.79,0:59:04.62,Default,,0,0,0,,Паро!
Dialogue: 0,0:59:06.45,0:59:09.58,Default,,0,0,0,,Нохохон көзілдірігі бар! Capek де!
Dialogue: 0,0:59:10.33,0:59:11.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:59:11.88,0:59:13.29,Default,,0,0,0,,Біз де барайық!
Dialogue: 0,0:59:13.38,0:59:14.55,Default,,0,0,0,,- (Сунео) Иә! -Иә!
Dialogue: 0,0:59:17.09,0:59:20.97,Default,,0,0,0,,Мен аздап көбірек ойнағым келеді.
Dialogue: 0,0:59:21.05,0:59:23.51,Default,,0,0,0,,Иә? иә…
Dialogue: 0,0:59:23.60,0:59:25.56,Default,,0,0,0,,(пилинг сияқты естіледі)
Dialogue: 0,0:59:27.68,0:59:28.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:59:28.60,0:59:31.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:59:31.60,0:59:32.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:35.28,0:59:37.24,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:59:37.94,0:59:40.36,Default,,0,0,0,,Барлығыңыз күтіңіздер!
Dialogue: 0,0:59:43.41,0:59:46.29,Default,,0,0,0,,♪ Жақында кездескенше~
Dialogue: 0,0:59:53.17,0:59:57.71,Default,,0,0,0,,(Қаладан тыңдалған қойылым)
Dialogue: 0,0:59:57.80,0:59:59.09,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:59:59.17,1:00:01.68,Default,,0,0,0,,- (Сунео) Бұл қала ма? -Қараңдар!
Dialogue: 0,1:00:05.97,1:00:07.97,Default,,0,0,0,,Барлығы оянды.
Dialogue: 0,1:00:08.06,1:00:10.35,Default,,0,0,0,,Керемет! Көптеген!
Dialogue: 0,1:00:10.44,1:00:11.98,Default,,0,0,0,,Ол мұнда бәрін талқандауға келген.
Dialogue: 0,1:00:12.06,1:00:14.23,Default,,0,0,0,,Біздің кезегіміз!
Dialogue: 0,1:00:14.31,1:00:15.65,Default,,0,0,0,,Қолыңызбен жасап көріңіз!
Dialogue: 0,1:00:15.73,1:00:18.15,Default,,0,0,0,,- Хяхахахаха - (Сунео) Хахаха
Dialogue: 0,1:00:18.23,1:00:19.69,Default,,0,0,0,,Микка-чан да!
Dialogue: 0,1:00:20.19,1:00:22.36,Default,,0,0,0,,Уау... Иә!
Dialogue: 0,1:00:23.16,1:00:26.03,Default,,0,0,0,,(Роботтардың өнімділігі)
Dialogue: 0,1:00:26.12,1:00:29.00,Default,,0,0,0,,(Скрипка орындауы)
Dialogue: 0,1:00:30.54,1:00:34.17,Default,,0,0,0,,(жанды және көңілді әуен)
Dialogue: 0,1:00:34.25,1:00:36.59,Default,,0,0,0,,(Бонго ойнау)
Dialogue: 0,1:00:36.67,1:00:39.84,Default,,0,0,0,,(Роботтардың өнімділігі)
Dialogue: 0,1:00:46.26,1:00:50.64,Default,,0,0,0,,(Tuba өнімділігі)
Dialogue: 0,1:00:53.44,1:00:55.06,Default,,0,0,0,,(Фартты орындау)
Dialogue: 0,1:01:10.41,1:01:15.42,Default,,0,0,0,,(Роботтардың ән айтуы)
Dialogue: 0,1:01:31.47,1:01:37.11,Default,,0,0,0,,(Ән айту)
Dialogue: 0,1:01:37.19,1:01:39.82,Default,,0,0,0,,Біздің өнеріміз тамаша болды.
Dialogue: 0,1:01:39.90,1:01:41.61,Default,,0,0,0,,(туба дыбысы)
Dialogue: 0,1:01:41.69,1:01:43.86,Default,,0,0,0,,Менің солоға бәрі есінен танып қалды, солай ма?
Dialogue: 0,1:01:43.95,1:01:45.32,Default,,0,0,0,,(Скрипка дыбысы)
Dialogue: 0,1:01:45.41,1:01:46.74,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,1:01:46.82,1:01:49.66,Default,,0,0,0,,Сіздің жеке әніңіз жақсырақ болды, солай ма?
Dialogue: 0,1:01:49.74,1:01:51.49,Default,,0,0,0,,Жоқ, жоқ, бұл менмін.
Dialogue: 0,1:01:51.58,1:01:53.20,Default,,0,0,0,,Не!
Dialogue: 0,1:01:53.29,1:01:54.16,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:54.25,1:01:58.13,Default,,0,0,0,,(бес музыка)
Dialogue: 0,1:01:59.75,1:02:00.96,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,1:02:01.05,1:02:02.59,Default,,0,0,0,,Қорқынышты музыка
Dialogue: 0,1:02:03.42,1:02:05.47,Default,,0,0,0,,Ол сынған ба?
Dialogue: 0,1:02:07.22,1:02:08.05,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:17.23,1:02:18.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:22.11,1:02:23.69,Default,,0,0,0,,Енді ше?
Dialogue: 0,1:02:23.78,1:02:26.20,Default,,0,0,0,,Бұл сегізаяқ па? кеттік
Dialogue: 0,1:02:26.28,1:02:29.49,Default,,0,0,0,,Иә, күтіңіз, күтіңіз!
Dialogue: 0,1:02:30.45,1:02:33.66,Default,,0,0,0,,♪ Winwinwinwinwin
Dialogue: 0,1:02:33.75,1:02:34.70,Default,,0,0,0,,♪ Ла ла ла жүгіру...
Dialogue: 0,1:02:35.29,1:02:36.50,Default,,0,0,0,,Маа!
Dialogue: 0,1:02:37.08,1:02:39.29,Default,,0,0,0,,Мұндай қорқынышты тариф
Dialogue: 0,1:02:39.38,1:02:44.30,Default,,0,0,0,,♪ Мен шыдай алмаймын.
Dialogue: 0,1:02:44.38,1:02:46.92,Default,,0,0,0,,Менің Fare зауытымда не бар?
Dialogue: 0,1:02:47.01,1:02:49.18,Default,,0,0,0,,♪ Ол дұрыс жұмыс істемеді ме?
Dialogue: 0,1:02:49.26,1:02:50.55,Default,,0,0,0,,Әй?
Dialogue: 0,1:02:50.64,1:02:52.76,Default,,0,0,0,,Олар не істеді?
Dialogue: 0,1:02:52.85,1:02:57.89,Default,,0,0,0,,♪ Жою~
Dialogue: 0,1:02:57.98,1:02:59.85,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:03:01.52,1:03:03.36,Default,,0,0,0,,Қал... қал
Dialogue: 0,1:03:03.44,1:03:05.28,Default,,0,0,0,,Не болып жатыр...
Dialogue: 0,1:03:05.36,1:03:06.19,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:06.78,1:03:08.82,Default,,0,0,0,,Ааааааааааааааааааааааааа...
Dialogue: 0,1:03:08.91,1:03:11.41,Default,,0,0,0,,Ахххх
Dialogue: 0,1:03:11.49,1:03:14.12,Default,,0,0,0,,Сәлем! Менде жаман сезім бар!
Dialogue: 0,1:03:17.16,1:03:18.66,Default,,0,0,0,,Уау!
Dialogue: 0,1:03:19.37,1:03:21.63,Default,,0,0,0,,Уау... Уау! О, жоқ!
Dialogue: 0,1:03:23.17,1:03:27.38,Default,,0,0,0,,(Маримба орындауы: «Некофунджатта»)
Dialogue: 0,1:03:31.01,1:03:32.18,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:39.77,1:03:41.06,Default,,0,0,0,,Я...
Dialogue: 0,1:03:43.77,1:03:47.57,Default,,0,0,0,,Гвахахахахахахаха!
Dialogue: 0,1:03:47.65,1:03:50.15,Default,,0,0,0,,Сіз түсіндіңіз бе... Иә?
Dialogue: 0,1:03:50.24,1:03:52.11,Default,,0,0,0,,Уау... аа!
Dialogue: 0,1:03:52.20,1:03:53.95,Default,,0,0,0,,Теттетте~
Dialogue: 0,1:03:54.03,1:03:55.41,Default,,0,0,0,,Ең алдымен, сен—
Dialogue: 0,1:03:55.49,1:03:58.79,Default,,0,0,0,,Біз аты аңызға айналған Биллидің айтқан өтірікпіз!
Dialogue: 0,1:03:58.87,1:04:00.33,Default,,0,0,0,,Виртуоз!
Dialogue: 0,1:04:00.41,1:04:02.83,Default,,0,0,0,,Бұл аты аңызға айналған Билли кім?
Dialogue: 0,1:04:02.92,1:04:04.04,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,1:04:08.38,1:04:09.67,Default,,0,0,0,,Джаджа... Джан!
Dialogue: 0,1:04:09.76,1:04:11.13,Default,,0,0,0,,Бұрынғы сегізаяқ!
Dialogue: 0,1:04:11.22,1:04:12.80,Default,,0,0,0,,Өте көп!
Dialogue: 0,1:04:13.84,1:04:16.64,Default,,0,0,0,,Ах... бұл шу споралары.
Dialogue: 0,1:04:16.72,1:04:18.10,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:04:18.18,1:04:19.64,Default,,0,0,0,,♪ Тарифті ойнаңыз
Dialogue: 0,1:04:19.73,1:04:21.60,Default,,0,0,0,,♪ Дәл қазір!
Dialogue: 0,1:04:21.69,1:04:23.02,Default,,0,0,0,,Жол ақысы?
Dialogue: 0,1:04:23.10,1:04:24.40,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,1:04:24.48,1:04:26.19,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,1:04:26.77,1:04:30.70,Default,,0,0,0,,(Tuba өнімділігі)
Dialogue: 0,1:04:38.54,1:04:41.96,Default,,0,0,0,,(Скрипка орындауы)
Dialogue: 0,1:04:49.80,1:04:51.59,Default,,0,0,0,,Ол еріді
Dialogue: 0,1:04:51.67,1:04:53.01,Default,,0,0,0,,Оңай жеңіс!
Dialogue: 0,1:04:53.09,1:04:55.01,Default,,0,0,0,,♪ Ақымақ
Dialogue: 0,1:04:55.09,1:04:57.64,Default,,0,0,0,,♪ Сіздің артыңызда!
Dialogue: 0,1:04:57.72,1:05:00.10,Default,,0,0,0,,-(Сунео) Ахх... -Уау!
Dialogue: 0,1:05:03.44,1:05:05.19,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:08.19,1:05:10.74,Default,,0,0,0,,- Сонымен... Деки - (Сунео) Эй!
Dialogue: 0,1:05:10.82,1:05:14.20,Default,,0,0,0,,Әй, үлкен болса да, анау кішкентаймен бірдей емес пе?
Dialogue: 0,1:05:14.28,1:05:16.41,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,1:05:16.49,1:05:19.74,Default,,0,0,0,,(Екі адам бөлек орындайды)
Dialogue: 0,1:05:28.09,1:05:31.46,Default,,0,0,0,,-Иә!? -(Сунео) Нана... Неге!?
Dialogue: 0,1:05:32.05,1:05:34.76,Default,,0,0,0,,♪ Қандай сұмдық қойылым!
Dialogue: 0,1:05:34.84,1:05:38.26,Default,,0,0,0,,Менің трансценденттік техникамды сынайсың ба?
Dialogue: 0,1:05:38.35,1:05:41.18,Default,,0,0,0,,Менің тамаша ойыным не болды?
Dialogue: 0,1:05:41.27,1:05:44.48,Default,,0,0,0,,♪ Балалар~
Dialogue: 0,1:05:44.56,1:05:47.65,Default,,0,0,0,,♪ Мен ештеңе түсінбеймін
Dialogue: 0,1:05:47.73,1:05:52.19,Default,,0,0,0,,♪ Жою~
Dialogue: 0,1:05:52.28,1:05:54.74,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:55.24,1:05:59.12,Default,,0,0,0,,- Уф... Уау - (Сунео) Уау... Уф
Dialogue: 0,1:05:59.20,1:06:01.08,Default,,0,0,0,,(ызылдаған дыбыс)
Dialogue: 0,1:06:01.16,1:06:03.83,Default,,0,0,0,,Тарифті үйлестіру деген нені білдіреді...
Dialogue: 0,1:06:03.91,1:06:06.37,Default,,0,0,0,,♪ Бірақ мәселе ~
Dialogue: 0,1:06:06.46,1:06:08.00,Default,,0,0,0,,♪ Ол бұдан да арта бермес бұрын
Dialogue: 0,1:06:08.08,1:06:10.00,Default,,0,0,0,,♪ Менің тарифіммен...
Dialogue: 0,1:06:10.59,1:06:12.25,Default,,0,0,0,,Ооо...
Dialogue: 0,1:06:12.34,1:06:13.42,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:14.59,1:06:16.05,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,1:06:17.13,1:06:19.72,Default,,0,0,0,,Джан-сан мен Сунео-сан бар емес пе?
Dialogue: 0,1:06:19.80,1:06:22.22,Default,,0,0,0,,Қызық, қайда кетті?
Dialogue: 0,1:06:22.31,1:06:23.81,Default,,0,0,0,,Маған тезірек үйге бару керек.
Dialogue: 0,1:06:23.89,1:06:26.06,Default,,0,0,0,,Ертең жабылу салтанаты.
Dialogue: 0,1:06:26.14,1:06:28.02,Default,,0,0,0,,О, мен ұмытып кетіппін!
Dialogue: 0,1:06:28.10,1:06:30.23,Default,,0,0,0,,Не!? Үйге барасың ба?
Dialogue: 0,1:06:30.31,1:06:33.65,Default,,0,0,0,,Иә, Даңқ залы бұрынғы күйіне оралған сияқты.
Dialogue: 0,1:06:33.73,1:06:34.82,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,1:06:34.90,1:06:38.45,Default,,0,0,0,,Соңғы қосқышты қоспайынша, Даңқ залы қайта жанданбайды!
Dialogue: 0,1:06:38.53,1:06:42.16,Default,,0,0,0,,Соңғы қосқыш? бұл қайда?
Dialogue: 0,1:06:42.74,1:06:46.37,Default,,0,0,0,,Маэстро Венто білетініне сенімдімін...
Dialogue: 0,1:06:46.46,1:06:49.63,Default,,0,0,0,,Ойланып қарасаңыз, сол маэстро Венто ше?
Dialogue: 0,1:06:49.71,1:06:51.92,Default,,0,0,0,,Сіз Капектің қожайынысыз ба?
Dialogue: 0,1:06:52.00,1:06:52.84,Default,,0,0,0,,Иә!
Dialogue: 0,1:06:52.92,1:06:57.05,Default,,0,0,0,,Маэстро осы залды басқаратын бас менеджер.
Dialogue: 0,1:06:57.13,1:06:59.47,Default,,0,0,0,,Тамаша ертегіші
Dialogue: 0,1:06:59.55,1:07:03.01,Default,,0,0,0,,Мені де қызықтыратын нәрсе бар, сондықтан мен сіздермен кездескім келеді.
Dialogue: 0,1:07:03.10,1:07:06.98,Default,,0,0,0,,Профессор Бах осылай істей береді, ғарышқа қадалады.
Dialogue: 0,1:07:07.81,1:07:09.69,Default,,0,0,0,,Менде жағымсыз сезім бар.
Dialogue: 0,1:07:09.77,1:07:13.15,Default,,0,0,0,,Менің қорқынышым негізсіз деп үміттенемін...
Dialogue: 0,1:07:13.23,1:07:15.48,Default,,0,0,0,,Жағымсыз сезім?
Dialogue: 0,1:07:15.57,1:07:17.86,Default,,0,0,0,,Уау
Dialogue: 0,1:07:17.95,1:07:21.74,Default,,0,0,0,,Уф... Менде бір қорқынышты оқиға болды.
Dialogue: 0,1:07:22.53,1:07:23.83,Default,,0,0,0,,Пхуха~!
Dialogue: 0,1:07:23.91,1:07:26.00,Default,,0,0,0,,Такеши-сан Сунео-сан!
Dialogue: 0,1:07:26.08,1:07:28.54,Default,,0,0,0,,Бұл арулар үйі...
Dialogue: 0,1:07:28.62,1:07:30.17,Default,,0,0,0,,Сізге жақсы
Dialogue: 0,1:07:30.25,1:07:33.29,Default,,0,0,0,,Жақсы! Жерге оралып, басынан бастайық!
Dialogue: 0,1:07:33.38,1:07:34.25,Default,,0,0,0,,Иә!
Dialogue: 0,1:07:34.34,1:07:37.47,Default,,0,0,0,,Әй, біз де Жерге бара аламыз ба?
Dialogue: 0,1:07:37.55,1:07:40.09,Default,,0,0,0,,- (Нобита) Әрине! -хехе
Dialogue: 0,1:07:40.18,1:07:42.55,Default,,0,0,0,,(Cicada хоры)
Dialogue: 0,1:07:42.64,1:07:45.51,Default,,0,0,0,,Ал, ертең жазғы демалыс басталады.
Dialogue: 0,1:07:45.60,1:07:47.64,Default,,0,0,0,,Тұрақты өмір сүріңіз
Dialogue: 0,1:07:47.73,1:07:50.19,Default,,0,0,0,,Қауіпті жерлерден аулақ болыңыз
Dialogue: 0,1:07:50.27,1:07:52.77,Default,,0,0,0,,Көп көңілді және көп нәрсені үйреніңіз
Dialogue: 0,1:07:52.86,1:07:54.90,Default,,0,0,0,,Үй тапсырмасын ұмытпа
Dialogue: 0,1:07:54.98,1:07:57.49,Default,,0,0,0,,Иә
Dialogue: 0,1:07:58.44,1:08:00.40,Default,,0,0,0,,Уау~
Dialogue: 0,1:08:00.49,1:08:03.37,Default,,0,0,0,,Иә? Қайта сынды ма?
Dialogue: 0,1:08:06.20,1:08:09.12,Default,,0,0,0,,(құлаққапта ойналатын музыка)
Dialogue: 0,1:08:09.21,1:08:10.58,Default,,0,0,0,,(BGM мониторы)
Dialogue: 0,1:08:10.66,1:08:13.08,Default,,0,0,0,,(Жасыл жарық әуені)
Dialogue: 0,1:08:13.17,1:08:15.54,Default,,0,0,0,,(дүкендегі музыка)
Dialogue: 0,1:08:15.63,1:08:17.55,Default,,0,0,0,,Уау, Минаның жаңа әні!
Dialogue: 0,1:08:17.63,1:08:20.84,Default,,0,0,0,,(Радио кассеталық ойнатқыштан ойналатын музыка)
Dialogue: 0,1:08:23.34,1:08:27.26,Default,,0,0,0,,Күтіңіз, күтіңіз!
Dialogue: 0,1:08:30.18,1:08:31.23,Default,,0,0,0,,Ха~
Dialogue: 0,1:08:31.31,1:08:34.23,Default,,0,0,0,,Жер шары жанды, солай емес пе?
Dialogue: 0,1:08:34.31,1:08:37.61,Default,,0,0,0,,Бірақ мен жаңа фарре суреттерін ойлап табамын.
Dialogue: 0,1:08:37.69,1:08:39.03,Default,,0,0,0,,Сәлем Микка-сама!
Dialogue: 0,1:08:39.11,1:08:39.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:40.03,1:08:41.57,Default,,0,0,0,,Микка-сама
Dialogue: 0,1:08:42.36,1:08:44.20,Default,,0,0,0,,А... иә
Dialogue: 0,1:08:47.91,1:08:49.95,Default,,0,0,0,,Үйге қайт, Кәпек, қарным ашты.
Dialogue: 0,1:08:50.04,1:08:53.25,Default,,0,0,0,,Әй, күте тұр, маған да бер!
Dialogue: 0,1:08:54.46,1:08:57.00,Default,,0,0,0,,(шуды бақылау)
Dialogue: 0,1:08:57.09,1:08:59.21,Default,,0,0,0,,(Көлік шуы)
Dialogue: 0,1:08:59.30,1:09:02.59,Default,,0,0,0,,(Мысықтың күлкілі дауысы)
Dialogue: 0,1:09:03.13,1:09:04.05,Default,,0,0,0,,Мияу!
Dialogue: 0,1:09:04.14,1:09:06.93,Default,,0,0,0,,Бұл енді мүмкін емес~
Dialogue: 0,1:09:07.01,1:09:09.14,Default,,0,0,0,,Мен жазғы демалыстағы үй тапсырмасын орындауым керек.
Dialogue: 0,1:09:09.22,1:09:11.68,Default,,0,0,0,,Анам мені ешқайда жібермейді!
Dialogue: 0,1:09:11.77,1:09:14.31,Default,,0,0,0,,Тез аяқтаңыз! көзілдірік
Dialogue: 0,1:09:15.19,1:09:17.19,Default,,0,0,0,,Асығыңыз! тез! Асығыңыз...
Dialogue: 0,1:09:17.27,1:09:19.53,Default,,0,0,0,,Дораемон
Dialogue: 0,1:09:19.61,1:09:21.49,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,1:09:21.57,1:09:23.95,Default,,0,0,0,,«Абыр-сабыр»!
Dialogue: 0,1:09:24.53,1:09:27.16,Default,,0,0,0,,Бұл шықты! Дораэмон құпия құралы
Dialogue: 0,1:09:27.24,1:09:28.37,Default,,0,0,0,,Көңілді!
Dialogue: 0,1:09:28.45,1:09:29.70,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,1:09:29.79,1:09:31.50,Default,,0,0,0,,Бұл керемет, Нобита-сан!
Dialogue: 0,1:09:31.58,1:09:33.29,Default,,0,0,0,,Беттері жоқ!
Dialogue: 0,1:09:33.37,1:09:35.29,Default,,0,0,0,,Қателер өте көп...
Dialogue: 0,1:09:35.37,1:09:38.75,Default,,0,0,0,,Асығыңыз! тез! тез! Асығыңыз...
Dialogue: 0,1:09:40.05,1:09:43.01,Default,,0,0,0,,Келесі күнделік! Бүгін біз музыкалық залға бардық...
Dialogue: 0,1:09:43.09,1:09:44.97,Default,,0,0,0,,барды
Dialogue: 0,1:09:45.05,1:09:47.80,Default,,0,0,0,,(Кёко) Ах…
Dialogue: 0,1:09:47.89,1:09:50.72,Default,,0,0,0,,Ал, келесі...
Dialogue: 0,1:09:50.81,1:09:52.35,Default,,0,0,0,,Келесі…
Dialogue: 0,1:09:52.43,1:09:54.64,Default,,0,0,0,,Мен бетіме қайта оралдым.
Dialogue: 0,1:09:54.73,1:09:57.06,Default,,0,0,0,,Нобита~Дорачан~
Dialogue: 0,1:09:57.15,1:09:58.94,Default,,0,0,0,,Ваннаға түспеңіз.
Dialogue: 0,1:09:59.02,1:10:01.07,Default,,0,0,0,,Ванна…
Dialogue: 0,1:10:01.15,1:10:03.65,Default,,0,0,0,,Бүгін бәріміз шомылдық.
Dialogue: 0,1:10:03.74,1:10:06.86,Default,,0,0,0,,Көңілді болды
Dialogue: 0,1:10:07.45,1:10:08.78,Default,,0,0,0,,Дайын!
Dialogue: 0,1:10:08.87,1:10:09.95,Default,,0,0,0,,Иә!
Dialogue: 0,1:10:10.03,1:10:11.87,Default,,0,0,0,,Иә, мұны қайталаңыз
Dialogue: 0,1:10:11.95,1:10:13.70,Default,,0,0,0,,Е!
Dialogue: 0,1:10:16.29,1:10:19.21,Default,,0,0,0,,Асығыңыз! тез! Асығыңыз...
Dialogue: 0,1:10:20.46,1:10:23.26,Default,,0,0,0,,Маэстро…
Dialogue: 0,1:10:26.09,1:10:27.43,Default,,0,0,0,,Сәлем Дораемон
Dialogue: 0,1:10:27.51,1:10:29.39,Default,,0,0,0,,Диктофон дағдыларын жақсартуға арналған құралдар...
Dialogue: 0,1:10:29.47,1:10:32.31,Default,,0,0,0,,Жоқ, жай ғана жаттығу.
Dialogue: 0,1:10:32.39,1:10:35.48,Default,,0,0,0,,Мен білемін, бірақ... бұл менмін, солай ма?
Dialogue: 0,1:10:35.56,1:10:38.69,Default,,0,0,0,,Аз уақытта барлығын қуып жетемін деп ойлайсыз ба?
Dialogue: 0,1:10:38.77,1:10:41.61,Default,,0,0,0,,Көзіңді қайта аштың...
Dialogue: 0,1:10:41.69,1:10:43.86,Default,,0,0,0,,Даңқ залы қайта жанбаса да, Дораемон
Dialogue: 0,1:10:43.94,1:10:45.19,Default,,0,0,0,,Жарайды дейсіз бе?
Dialogue: 0,1:10:45.28,1:10:47.91,Default,,0,0,0,,Сондықтан мұндай құрал жоқ!
Dialogue: 0,1:10:47.99,1:10:50.62,Default,,0,0,0,,Сіз оны маңызды уақытта пайдалана алмайсыз...
Dialogue: 0,1:10:50.70,1:10:51.78,Default,,0,0,0,,Не?!
Dialogue: 0,1:10:51.87,1:10:54.20,Default,,0,0,0,,Мен Нобита-кунды енді танымаймын!
Dialogue: 0,1:10:55.33,1:10:57.62,Default,,0,0,0,,Жақсы, бәрібір ертең кездесеміз.
Dialogue: 0,1:10:57.71,1:10:59.92,Default,,0,0,0,,Олар сізге бірдеңе береді.
Dialogue: 0,1:11:13.97,1:11:16.02,Default,,0,0,0,,(есік дыбысы)
Dialogue: 0,1:11:16.10,1:11:17.89,Default,,0,0,0,,(Дораэмонның ұйқысы)
Dialogue: 0,1:11:17.98,1:11:19.65,Default,,0,0,0,,(Диктофонның өнімділігі)
Dialogue: 0,1:11:19.73,1:11:20.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:21.31,1:11:22.56,Default,,0,0,0,,Хехехе
Dialogue: 0,1:11:25.28,1:11:29.28,Default,,0,0,0,,(«Диктофонға қажетті шығарманы» орындау қиын)
Dialogue: 0,1:11:41.88,1:11:45.80,Default,,0,0,0,,(Дораэмон гуілдейді)
Dialogue: 0,1:12:02.19,1:12:05.61,Default,,0,0,0,,Иә
Dialogue: 0,1:12:07.19,1:12:10.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:12.61,1:12:13.70,Default,,0,0,0,,Әй?
Dialogue: 0,1:12:15.24,1:12:17.20,Default,,0,0,0,,Нобита?
Dialogue: 0,1:12:23.17,1:12:25.09,Default,,0,0,0,,Хмм?
Dialogue: 0,1:12:25.17,1:12:26.84,Default,,0,0,0,,Мүмкін бұл менің қиялым шығар...
Dialogue: 0,1:12:29.17,1:12:31.93,Default,,0,0,0,,(Cicada хоры)
Dialogue: 0,1:12:32.01,1:12:33.68,Default,,0,0,0,,-Сәлем! -(Сунео) Қолайсыздық үшін кешіріңіз~
Dialogue: 0,1:12:33.76,1:12:35.80,Default,,0,0,0,,Сіз ештеңе ұмытпайсыз ба?
Dialogue: 0,1:12:35.89,1:12:37.39,Default,,0,0,0,,-Ой! -(Сунео) Керемет!
Dialogue: 0,1:12:37.47,1:12:40.35,Default,,0,0,0,,Мен анама бүгін кешігіп келемін дедім.
Dialogue: 0,1:12:40.43,1:12:41.35,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,1:12:41.44,1:12:45.27,Default,,0,0,0,,Ах~ Гага... Ах~ Ах~
Dialogue: 0,1:12:45.36,1:12:46.98,Default,,0,0,0,,Не болды, Дораемон?
Dialogue: 0,1:12:47.07,1:12:50.74,Default,,0,0,0,,Неге екені белгісіз, тамағым...
Dialogue: 0,1:12:50.82,1:12:53.32,Default,,0,0,0,,Сіз суық тиіп қалдыңыз ба?
Dialogue: 0,1:12:53.41,1:12:54.66,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:54.74,1:12:57.62,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:59.04,1:13:00.20,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:01.16,1:13:04.21,Default,,0,0,0,,Менің тамағымның түсінде бірдеңе дұрыс емес.
Dialogue: 0,1:13:05.63,1:13:08.50,Default,,0,0,0,,«Техникалық алғашқы көмек жинағы»
Dialogue: 0,1:13:08.59,1:13:11.01,Default,,0,0,0,,Ха, мен мұны әлі жалаймын.
Dialogue: 0,1:13:11.09,1:13:12.47,Default,,0,0,0,,Агага
Dialogue: 0,1:13:12.55,1:13:16.22,Default,,0,0,0,,Баршаңызға, Даңқ Залының қайта жандануына аз ғана уақыт қалды!
Dialogue: 0,1:13:16.30,1:13:19.18,Default,,0,0,0,,Бізге күш-қуатыңызды көбірек беріңізші!
Dialogue: 0,1:13:19.26,1:13:21.64,Default,,0,0,0,,- (Нобита және басқалар) Иә! -Жарайды, кеттік!
Dialogue: 0,1:13:31.40,1:13:33.24,Default,,0,0,0,,(цикаданың таңданған дауысы)
Dialogue: 0,1:13:49.09,1:13:51.46,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:13:57.64,1:13:59.43,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:59.51,1:14:01.43,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:14:01.52,1:14:03.89,Default,,0,0,0,,Бұл Даңқ залының басты алаңы!
Dialogue: 0,1:14:03.98,1:14:07.40,Default,,0,0,0,,Сіздің алдыңызда Маэстро храмы көрінеді!
Dialogue: 0,1:14:07.48,1:14:08.94,Default,,0,0,0,,Міне!
Dialogue: 0,1:14:09.44,1:14:12.36,Default,,0,0,0,,Бұл керемет, сіздің дауысыңыз өте жақсы естіледі.
Dialogue: 0,1:14:12.44,1:14:14.44,Default,,0,0,0,,Менің айтуым үшін өте қолайлы!
Dialogue: 0,1:14:14.53,1:14:16.07,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,1:14:16.16,1:14:17.82,Default,,0,0,0,,Хмм, гага...
Dialogue: 0,1:14:17.91,1:14:19.83,Default,,0,0,0,,Оны түзету қиын.
Dialogue: 0,1:14:19.91,1:14:21.54,Default,,0,0,0,,- (Нобита) Ах! -иә?
Dialogue: 0,1:14:21.62,1:14:22.74,Default,,0,0,0,,Не болды?
Dialogue: 0,1:14:22.83,1:14:24.79,Default,,0,0,0,,Мен магнитофонды ұмытып қалдым
Dialogue: 0,1:14:24.87,1:14:26.00,Default,,0,0,0,,-Аа!? -Ха!?
Dialogue: 0,1:14:26.08,1:14:28.96,Default,,0,0,0,,Бұл шынымен де ақылға қонымсыз!
Dialogue: 0,1:14:29.04,1:14:30.71,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,1:14:30.79,1:14:33.59,Default,,0,0,0,,Бұл ақымақ және бәрібір пайдасыз.
Dialogue: 0,1:14:33.67,1:14:35.38,Default,,0,0,0,,Бізге жетеді
Dialogue: 0,1:14:35.47,1:14:37.68,Default,,0,0,0,,-Болды... -(Нобита) Мен де!
Dialogue: 0,1:14:37.76,1:14:39.18,Default,,0,0,0,,Оны қайда ұмыттыңыз?
Dialogue: 0,1:14:39.26,1:14:43.39,Default,,0,0,0,,Жарайды... Кеше түнде жастығымда болған сияқты...
Dialogue: 0,1:14:43.47,1:14:46.94,Default,,0,0,0,,Бұдан былай «кез келген есікке» оралу қиын болады...
Dialogue: 0,1:14:47.02,1:14:48.15,Default,,0,0,0,,Иә!
Dialogue: 0,1:14:48.73,1:14:51.11,Default,,0,0,0,,«Кеңістік-уақыт өзгерткіш»!
Dialogue: 0,1:14:51.19,1:14:52.36,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,1:14:52.44,1:14:55.32,Default,,0,0,0,,Тек көрсетілген аймақ Нобита-кунның Юбедегі бөлмесіне жіберіледі.
Dialogue: 0,1:14:55.40,1:14:57.82,Default,,0,0,0,,Сіз оны өзгерте аласыз, ga ga ga ga.
Dialogue: 0,1:14:57.91,1:15:00.53,Default,,0,0,0,,Соңғы 24 сағат ішінде өзгертуге болады
Dialogue: 0,1:15:00.62,1:15:04.04,Default,,0,0,0,,Орын мен уақытпен шектелген
Dialogue: 0,1:15:04.66,1:15:05.79,Default,,0,0,0,,(Айзава) Сондықтан мен қабылдау емтиханы логикаға жат дедім
Dialogue: 0,1:15:06.37,1:15:08.75,Default,,0,0,0,,Содан кейін ауқымды көрсетіңіз
Dialogue: 0,1:15:08.83,1:15:10.83,Default,,0,0,0,,Аа, сәл артқа шегініңіз.
Dialogue: 0,1:15:11.34,1:15:15.42,Default,,0,0,0,,Бұл құралдың өлшемін кеңістік пен уақыт арасында реттеу қиын.
Dialogue: 0,1:15:15.51,1:15:18.51,Default,,0,0,0,,Егер дұрыс сәйкес келмесе, іс күрделене түседі.
Dialogue: 0,1:15:18.59,1:15:19.59,Default,,0,0,0,,Хмм.
Dialogue: 0,1:15:19.68,1:15:22.51,Default,,0,0,0,,Нобита-кунның бөлмесі осындай ма деп ойлаймын.
Dialogue: 0,1:15:22.60,1:15:23.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:23.51,1:15:25.35,Default,,0,0,0,,Уау!
Dialogue: 0,1:15:25.43,1:15:27.73,Default,,0,0,0,,Хаха, бұл ақымақтық.
Dialogue: 0,1:15:27.81,1:15:29.14,Default,,0,0,0,,Бұл менмін, солай ма?
Dialogue: 0,1:15:29.23,1:15:30.77,Default,,0,0,0,,Иә? жоқ!
Dialogue: 0,1:15:30.85,1:15:33.98,Default,,0,0,0,,Сіз оны шынымен осы бөлмеге соңғы рет қойдыңыз ба?
Dialogue: 0,1:15:34.07,1:15:36.86,Default,,0,0,0,,А, дұрыс! Ол монша
Dialogue: 0,1:15:36.94,1:15:38.57,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,1:15:38.65,1:15:40.70,Default,,0,0,0,,Ал, бұл шомылатын орын.
Dialogue: 0,1:15:40.78,1:15:42.37,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,1:15:44.91,1:15:46.33,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:15:46.41,1:15:47.79,Default,,0,0,0,,Кешіріңіз~
Dialogue: 0,1:15:47.87,1:15:49.50,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:15:49.58,1:15:51.38,Default,,0,0,0,,Бірақ неге ваннада?
Dialogue: 0,1:15:51.46,1:15:54.29,Default,,0,0,0,,Дыбыс резонанс тудырады және сіз оны жақсы естисіз, солай емес пе?
Dialogue: 0,1:15:57.26,1:16:01.09,Default,,0,0,0,,Мұғалім, менмін, Кәпек келді!
Dialogue: 0,1:16:01.18,1:16:02.26,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,1:16:02.34,1:16:05.22,Default,,0,0,0,,Мұғалім... Профессор Венто!
Dialogue: 0,1:16:05.31,1:16:08.89,Default,,0,0,0,,Сәлем, мен саған Микка-саманы алып келдім.
Dialogue: 0,1:16:08.98,1:16:11.06,Default,,0,0,0,,Оны тыңдаңыз! жерден
Dialogue: 0,1:16:11.14,1:16:13.69,Default,,0,0,0,,Біз барлық Виртуоздардан кешірім сұраймыз!
Dialogue: 0,1:16:14.44,1:16:17.44,Default,,0,0,0,,Менің ұстазым көргісі келетін нәрсе бар!
Dialogue: 0,1:16:17.53,1:16:19.40,Default,,0,0,0,,Мен ән шығарып жатырмын!
Dialogue: 0,1:16:19.49,1:16:20.90,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,1:16:20.99,1:16:23.78,Default,,0,0,0,,Жер тарифтері музыка сияқты...
Dialogue: 0,1:16:23.87,1:16:25.12,Default,,0,0,0,,Ха!
Dialogue: 0,1:16:30.16,1:16:31.79,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,1:16:32.42,1:16:34.04,Default,,0,0,0,,Неге...
Dialogue: 0,1:16:34.71,1:16:37.00,Default,,0,0,0,,Енді мұны істеуге ешқандай себеп жоқ
Dialogue: 0,1:16:37.09,1:16:39.59,Default,,0,0,0,,Мен тыныш ұйықтап жатқанда
Dialogue: 0,1:16:39.67,1:16:42.01,Default,,0,0,0,,Мұғалім жалғыз...
Dialogue: 0,1:16:42.09,1:16:45.72,Default,,0,0,0,,Мұнда жер мен ғибадатхананы бақылаңыз...
Dialogue: 0,1:16:45.80,1:16:47.97,Default,,0,0,0,,40 000 жыл бойы...
Dialogue: 0,1:16:48.06,1:16:49.52,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,1:16:50.35,1:16:52.02,Default,,0,0,0,,Мұғалім...!
Dialogue: 0,1:16:57.40,1:16:59.07,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,1:16:59.15,1:17:00.86,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,1:17:01.78,1:17:04.36,Default,,0,0,0,,Уау!
Dialogue: 0,1:17:10.45,1:17:12.50,Default,,0,0,0,,Жарайды... Гага
Dialogue: 0,1:17:12.58,1:17:14.58,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,1:17:14.67,1:17:16.38,Default,,0,0,0,,(Танжиро) Ә? (Кусари-карасу) Ка…
Dialogue: 0,1:17:25.09,1:17:26.35,Default,,0,0,0,,Гага Гага
Dialogue: 0,1:17:30.85,1:17:32.35,Default,,0,0,0,,Осы тапаншаны пайдаланып—
Dialogue: 0,1:17:33.94,1:17:36.23,Default,,0,0,0,,Жақсы... Гага
Dialogue: 0,1:17:43.32,1:17:45.16,Default,,0,0,0,,Ух... Мен оны көріп тұрмын.
Dialogue: 0,1:17:45.74,1:17:47.20,Default,,0,0,0,,Мен қандаймын...
Dialogue: 0,1:17:47.28,1:17:49.08,Default,,0,0,0,,Әй... Сенсей!
Dialogue: 0,1:17:49.16,1:17:53.08,Default,,0,0,0,,Керемет! Жақсы~
Dialogue: 0,1:17:55.21,1:17:57.13,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,1:17:57.21,1:18:00.09,Default,,0,0,0,,Сізге қалай алғыс айта аламын?
Dialogue: 0,1:18:00.17,1:18:03.09,Default,,0,0,0,,Капек те жақсы жұмыс жасады.
Dialogue: 0,1:18:03.17,1:18:04.42,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:18:09.64,1:18:11.26,Default,,0,0,0,,Микка, солай ма?
Dialogue: 0,1:18:11.85,1:18:12.97,Default,,0,0,0,,Мен...
Dialogue: 0,1:18:13.48,1:18:15.73,Default,,0,0,0,,Менен сұрағыңыз келетін нәрсе бар ма?
Dialogue: 0,1:18:16.31,1:18:19.19,Default,,0,0,0,,Мушика неге құлады?
Dialogue: 0,1:18:19.27,1:18:21.02,Default,,0,0,0,,Микка-чан...
Dialogue: 0,1:18:21.73,1:18:25.11,Default,,0,0,0,,Мен шындықты білгім келеді
Dialogue: 0,1:18:27.20,1:18:30.08,Default,,0,0,0,,Біздің туған планетамыз Мушика
Dialogue: 0,1:18:30.16,1:18:34.12,Default,,0,0,0,,Тарифтерге толы әдемі жұлдыз еді.
Dialogue: 0,1:18:34.20,1:18:37.08,Default,,0,0,0,,(Адамдардың ән айту дауыстары)
Dialogue: 0,1:18:40.13,1:18:42.84,Default,,0,0,0,,Дегенмен, белгілі бір сәтте Фарли энергиясы
Dialogue: 0,1:18:42.92,1:18:45.97,Default,,0,0,0,,Монополиялауға тырысатындар... пайда болады.
Dialogue: 0,1:18:46.05,1:18:49.26,Default,,0,0,0,,Адамдарға фарре ойнауға тыйым салынды
Dialogue: 0,1:18:50.01,1:18:52.97,Default,,0,0,0,,Бұл үлкен апат
Dialogue: 0,1:18:53.06,1:18:56.39,Default,,0,0,0,,Мен шу шығардым.
Dialogue: 0,1:18:56.48,1:18:58.31,Default,,0,0,0,,Шу?
Dialogue: 0,1:18:58.40,1:19:00.69,Default,,0,0,0,,Сіз шу немесе алаңдататын дыбыстарды айтасыз ба?
Dialogue: 0,1:19:00.77,1:19:02.90,Default,,0,0,0,,- (Вентау) Бұл дыбыс емес - А?
Dialogue: 0,1:19:02.98,1:19:05.78,Default,,0,0,0,,Ол ғаламда бар
Dialogue: 0,1:19:08.99,1:19:13.49,Default,,0,0,0,,Шу деген не? Жұлдыздарды жейтін алып ғарыштық тіршілік формасы.
Dialogue: 0,1:19:13.58,1:19:16.16,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:19:18.54,1:19:21.42,Default,,0,0,0,,Енді бәрі кеш
Dialogue: 0,1:19:22.00,1:19:26.84,Default,,0,0,0,,Бізде жұлдыздардан бас тартудан басқа амал қалмады.
Dialogue: 0,1:19:28.01,1:19:30.76,Default,,0,0,0,,Өте қорқынышты нәрсе...
Dialogue: 0,1:19:31.34,1:19:35.18,Default,,0,0,0,,Бірнеше жылдық зерттеулер бірнеше нәрсені анықтады.
Dialogue: 0,1:19:35.27,1:19:36.73,Default,,0,0,0,,Ең маңызды ерекшелігі
Dialogue: 0,1:19:37.48,1:19:39.94,Default,,0,0,0,,Фарретті жек көру
Dialogue: 0,1:19:41.06,1:19:42.90,Default,,0,0,0,,Мен Фаррды жек көремін...
Dialogue: 0,1:19:42.98,1:19:44.69,Default,,0,0,0,,Тарифтерге толы жұлдызда
Dialogue: 0,1:19:44.77,1:19:46.86,Default,,0,0,0,,Оған жақындауға болмайды
Dialogue: 0,1:19:46.94,1:19:51.57,Default,,0,0,0,,Осылайша ол өзінің спораларын бүкіл әлемге жібереді.
Dialogue: 0,1:19:51.66,1:19:54.53,Default,,0,0,0,,Тіршілік мекендейтін планетаға жететін споралар
Dialogue: 0,1:19:54.62,1:19:56.45,Default,,0,0,0,,Фарре ойнайтын нәрсеге құмар
Dialogue: 0,1:19:56.54,1:19:59.54,Default,,0,0,0,,Барлығын шуға айналдырады.
Dialogue: 0,1:19:59.62,1:20:02.21,Default,,0,0,0,,Ал бұл жұлдыз...
Dialogue: 0,1:20:03.42,1:20:05.55,Default,,0,0,0,,Арх! Гага Гага Гага
Dialogue: 0,1:20:05.63,1:20:08.01,Default,,0,0,0,,Дораемон! Бұл шынымен жақсы ма?
Dialogue: 0,1:20:08.09,1:20:10.01,Default,,0,0,0,,Түс қандай да бір түрде өзгерді ме?
Dialogue: 0,1:20:10.09,1:20:11.26,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,1:20:11.34,1:20:14.05,Default,,0,0,0,,Ал, белгілер...
Dialogue: 0,1:20:14.14,1:20:16.31,Default,,0,0,0,,Бұл шу спораларының жұмысы емес пе?
Dialogue: 0,1:20:16.39,1:20:18.48,Default,,0,0,0,,- (4 адам) Иә!? - Гах гах
Dialogue: 0,1:20:18.56,1:20:21.27,Default,,0,0,0,,Өте өкінішті, шу келеді!
Dialogue: 0,1:20:21.35,1:20:22.48,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,1:20:22.56,1:20:25.07,Default,,0,0,0,,Шу фаррды жек көреді, солай ма?
Dialogue: 0,1:20:25.15,1:20:28.49,Default,,0,0,0,,Жер үнемі тарифтерге толы болуы керек...
Dialogue: 0,1:20:28.57,1:20:31.53,Default,,0,0,0,,Егер тариф бір сәтке болса да жоғалып кетсе
Dialogue: 0,1:20:31.61,1:20:35.70,Default,,0,0,0,,Шу споралары оянып, көбейе алады.
Dialogue: 0,1:20:36.79,1:20:38.37,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,1:20:45.84,1:20:47.96,Default,,0,0,0,,- (Нобита) «Алдын ала күнделік»! -Га-га-га-га-га-га!
Dialogue: 0,1:20:48.05,1:20:51.42,Default,,0,0,0,,Жерге шуыл келсе...
Dialogue: 0,1:20:52.22,1:20:53.76,Default,,0,0,0,,Бұл жаман емес пе?
Dialogue: 0,1:20:53.84,1:20:55.89,Default,,0,0,0,,Не... не істеуіміз керек!?
Dialogue: 0,1:20:55.97,1:20:58.06,Default,,0,0,0,,Жерге шу шабуылы алдында
Dialogue: 0,1:20:58.14,1:20:59.77,Default,,0,0,0,,Даңқ залын ояту
Dialogue: 0,1:20:59.85,1:21:03.35,Default,,0,0,0,,Олай етсең, одан құтылу керек!
Dialogue: 0,1:21:03.44,1:21:05.40,Default,,0,0,0,,Не істеуім керек!?
Dialogue: 0,1:21:06.69,1:21:08.94,Default,,0,0,0,,Мұнда асығыңыз!
Dialogue: 0,1:21:16.12,1:21:19.08,Default,,0,0,0,,Бұл Даңқ Залының негізгі қосқышы.
Dialogue: 0,1:21:19.16,1:21:20.41,Default,,0,0,0,,Бұл...
Dialogue: 0,1:21:21.08,1:21:25.13,Default,,0,0,0,,Коммутаторды қосу үшін Мушиканың ысқырығы керек.
Dialogue: 0,1:21:25.21,1:21:27.17,Default,,0,0,0,,Сыбызғы
Dialogue: 0,1:21:27.25,1:21:31.17,Default,,0,0,0,,Оны тек Микка, соңғы Мушика ғана ойнай алады.
Dialogue: 0,1:21:31.26,1:21:32.67,Default,,0,0,0,,Тек мен үшін...
Dialogue: 0,1:21:32.76,1:21:35.39,Default,,0,0,0,,Сай... Гоно...
Dialogue: 0,1:21:35.47,1:21:38.18,Default,,0,0,0,,Мәселе Даңқ залында болды.
Dialogue: 0,1:21:38.26,1:21:41.35,Default,,0,0,0,,Осы жылдар ішінде не жоғалды
Dialogue: 0,1:21:41.43,1:21:42.64,Default,,0,0,0,,Бұл...
Dialogue: 0,1:21:42.73,1:21:45.31,Default,,0,0,0,,Бірақ үміт сақталады
Dialogue: 0,1:21:45.40,1:21:46.98,Default,,0,0,0,,Мика
Dialogue: 0,1:21:48.15,1:21:51.57,Default,,0,0,0,,Сіздің егіз қарындасыңыз болды.
Dialogue: 0,1:21:54.90,1:21:56.32,Default,,0,0,0,,Наги…
Dialogue: 0,1:21:58.16,1:22:00.29,Default,,0,0,0,,Ұзақ және азапты жолдың соңында
Dialogue: 0,1:22:00.37,1:22:02.37,Default,,0,0,0,,Біз оны Жер деп атаймыз.
Dialogue: 0,1:22:02.45,1:22:06.83,Default,,0,0,0,,Біздікіне ұқсас тіршілік бар планетаны таптық.
Dialogue: 0,1:22:07.38,1:22:10.55,Default,,0,0,0,,Соңғы балалар егіз болды.
Dialogue: 0,1:22:10.63,1:22:13.42,Default,,0,0,0,,Musika тұқымдарының өлуіне жол бермеу
Dialogue: 0,1:22:13.51,1:22:16.34,Default,,0,0,0,,Бір адам Жерге жіберілді, екіншісі
Dialogue: 0,1:22:16.43,1:22:19.93,Default,,0,0,0,,Даңқ залында суық ұйқыға кеттім.
Dialogue: 0,1:22:20.01,1:22:22.35,Default,,0,0,0,,Бұл мен...?
Dialogue: 0,1:22:23.22,1:22:24.56,Default,,0,0,0,,Иә.
Dialogue: 0,1:22:25.23,1:22:28.27,Default,,0,0,0,,Ал мен Жерге жіберген апаңа.
Dialogue: 0,1:22:28.36,1:22:30.36,Default,,0,0,0,,Тік сыбызғы бар
Dialogue: 0,1:22:30.44,1:22:36.07,Default,,0,0,0,,(Миканың анасының ән айту дауысы және әкесінің орындауы)
Dialogue: 0,1:22:37.95,1:22:40.95,Default,,0,0,0,,Бұл 40 000 жыл бұрын болған.
Dialogue: 0,1:22:41.03,1:22:42.62,Default,,0,0,0,,40 000 жыл...
Dialogue: 0,1:22:46.21,1:22:48.88,Default,,0,0,0,,Сонымен... не істеуім керек?
Dialogue: 0,1:22:48.96,1:22:51.67,Default,,0,0,0,,Жерге оралу, 40 000 жыл бұрынғы ысқырық
Dialogue: 0,1:22:51.75,1:22:54.09,Default,,0,0,0,,Мен оны табуым керек!
Dialogue: 0,1:22:54.17,1:22:56.09,Default,,0,0,0,,-Гагагагга... -(Нобита) Дораемон!
Dialogue: 0,1:22:56.17,1:22:58.76,Default,,0,0,0,,Сыбызғының емдік күшімен
Dialogue: 0,1:22:58.84,1:23:01.55,Default,,0,0,0,,Досыңды түзете білу керек.
Dialogue: 0,1:23:01.64,1:23:03.43,Default,,0,0,0,,- (Нобита) Шынымен!? - (Венто) О
Dialogue: 0,1:23:03.52,1:23:06.31,Default,,0,0,0,,Бірақ бізде уақыт жоқ, асығу керек!
Dialogue: 0,1:23:06.39,1:23:08.94,Default,,0,0,0,,Бірақ мен қайда қарауым керек...
Dialogue: 0,1:23:09.02,1:23:11.77,Default,,0,0,0,,40 000 жыл... Сыбызғы...
Dialogue: 0,1:23:11.86,1:23:13.98,Default,,0,0,0,,Ха! Бұл дұрыс!
Dialogue: 0,1:23:14.57,1:23:17.95,Default,,0,0,0,,Мұғалім, бірдеңе болды.
Dialogue: 0,1:23:18.03,1:23:20.91,Default,,0,0,0,,(қоңырау қоңырау! дыбысы)
Dialogue: 0,1:23:23.70,1:23:25.58,Default,,0,0,0,,(Арфа бұғы айқайлайды)
Dialogue: 0,1:23:27.21,1:23:29.04,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,1:23:29.12,1:23:31.96,Default,,0,0,0,,Хмм? Бұл біртүрлі
Dialogue: 0,1:23:32.04,1:23:34.67,Default,,0,0,0,,Не? Тағы да...
Dialogue: 0,1:23:34.75,1:23:35.63,Default,,0,0,0,,Міне!
Dialogue: 0,1:23:35.71,1:23:37.01,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,1:23:37.09,1:23:40.64,Default,,0,0,0,,Не болып жатыр?!
Dialogue: 0,1:23:40.72,1:23:42.55,Default,,0,0,0,,Бұл жазбамен не болып жатыр?
Dialogue: 0,1:23:42.64,1:23:44.81,Default,,0,0,0,,Смартфон деректері жоғалып кетті!
Dialogue: 0,1:23:44.89,1:23:47.14,Default,,0,0,0,,Анашым! Фортепиано біртүрлі!
Dialogue: 0,1:23:47.23,1:23:48.48,Default,,0,0,0,,Концерт тоқтатылды
Dialogue: 0,1:23:48.56,1:23:50.73,Default,,0,0,0,,Ах~аа~ Менің тамағым сезіліп тұр...
Dialogue: 0,1:23:50.81,1:23:54.02,Default,,0,0,0,,Бұл теледидарда не болып жатыр?
Dialogue: 0,1:24:07.33,1:24:08.66,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:24:08.75,1:24:10.46,Default,,0,0,0,,Мұражай
Dialogue: 0,1:24:10.54,1:24:13.42,Default,,0,0,0,,Қараңызшы, сіз музыка сабағында осылай дедіңіз, солай ма?
Dialogue: 0,1:24:13.50,1:24:15.80,Default,,0,0,0,,Әй, аққудың ысқырығы!
Dialogue: 0,1:24:15.88,1:24:17.38,Default,,0,0,0,,Эй
Dialogue: 0,1:24:17.46,1:24:19.55,Default,,0,0,0,,Осыны айтып тұрған жоқсыз ба?
Dialogue: 0,1:24:19.63,1:24:21.59,Default,,0,0,0,,Аа, бұл рас.
Dialogue: 0,1:24:21.68,1:24:22.93,Default,,0,0,0,,Я~
Dialogue: 0,1:24:23.01,1:24:25.06,Default,,0,0,0,,Бұл өте кішкентай.
Dialogue: 0,1:24:25.14,1:24:27.77,Default,,0,0,0,,Бұл Мушиканың сыбызғы ма?
Dialogue: 0,1:24:27.85,1:24:30.52,Default,,0,0,0,,Түсіну үшін тым ескі.
Dialogue: 0,1:24:31.10,1:24:33.48,Default,,0,0,0,,Гагагагага~!
Dialogue: 0,1:24:33.56,1:24:34.65,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,1:24:34.73,1:24:37.73,Default,,0,0,0,,«Омоид қос нүкте» арқылы флейтаның жадын көруге болады.
Dialogue: 0,1:24:37.82,1:24:38.94,Default,,0,0,0,,G…
Dialogue: 0,1:24:44.74,1:24:46.58,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:24:48.29,1:24:51.16,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:24:52.67,1:24:54.13,Default,,0,0,0,,(аққудың айқайы)
Dialogue: 0,1:24:54.21,1:25:00.22,Default,,0,0,0,,(Музыка флейта орындауы)
Dialogue: 0,1:25:00.30,1:25:01.13,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:05.72,1:25:07.14,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:07.22,1:25:09.14,Default,,0,0,0,,Аққуға ұқсайды
Dialogue: 0,1:25:15.69,1:25:17.15,Default,,0,0,0,,(тыныс тәрізді дыбыс)
Dialogue: 0,1:25:17.23,1:25:18.90,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:18.98,1:25:22.86,Default,,0,0,0,,(Музыка флейта орындауы)
Dialogue: 0,1:25:22.95,1:25:25.24,Default,,0,0,0,,(Аққу флейтасының орындауы)
Dialogue: 0,1:25:25.32,1:25:26.91,Default,,0,0,0,,Ах... иә?
Dialogue: 0,1:25:30.70,1:25:33.87,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен оны сізге еліктеу арқылы жасауға тырыстым.
Dialogue: 0,1:25:33.96,1:25:37.00,Default,,0,0,0,,Менің ойымша, бұл өте жақсы сызықта.
Dialogue: 0,1:25:37.09,1:25:39.09,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:25:40.96,1:25:45.89,Default,,0,0,0,,(Кроманьон халқының өнері және Микканың әпкесінің ән салған дауысы)
Dialogue: 0,1:25:46.47,1:25:51.10,Default,,0,0,0,,(Миканың әпкесінің ән салған дауысы)
Dialogue: 0,1:25:51.85,1:25:55.85,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:25:55.94,1:26:00.40,Default,,0,0,0,,(Миканың әпкесі мен анасының ән салған дауысы)
Dialogue: 0,1:26:08.16,1:26:10.37,Default,,0,0,0,,(аққудың айқайы)
Dialogue: 0,1:26:12.25,1:26:17.25,Default,,0,0,0,,(Миканың әпкесі мен анасының ән салған дауысы)
Dialogue: 0,1:26:22.88,1:26:25.88,Default,,0,0,0,,(Миканың әпкесі мен анасының ән салған дауысы)
Dialogue: 0,1:26:28.26,1:26:29.80,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,1:26:29.89,1:26:33.02,Default,,0,0,0,,Микканың әпкесі бақытты болып көрінді.
Dialogue: 0,1:26:33.10,1:26:33.93,Default,,0,0,0,,Иә
Dialogue: 0,1:26:34.02,1:26:36.94,Default,,0,0,0,,Мушиканың жолақысы мен жердің әуені
Dialogue: 0,1:26:37.02,1:26:38.61,Default,,0,0,0,,Екеуміздің қосылғанымызға сене алар емеспін...
Dialogue: 0,1:26:39.65,1:26:41.02,Default,,0,0,0,,Мен...
Dialogue: 0,1:26:43.28,1:26:45.32,Default,,0,0,0,,Мен жалғыз емес едім.
Dialogue: 0,1:26:47.32,1:26:49.28,Default,,0,0,0,,Хехехе
Dialogue: 0,1:26:49.87,1:26:53.24,Default,,0,0,0,,Бірақ бұл флейта Музыканыкі емес еді.
Dialogue: 0,1:26:53.33,1:26:57.12,Default,,0,0,0,,Бұл Микканың әпкесі ойнап жүрген ойын шынайы дегенді білдіре ме...
Dialogue: 0,1:26:57.21,1:26:59.71,Default,,0,0,0,,Осындай нәрсені қалай табуға болады...
Dialogue: 0,1:26:59.79,1:27:03.55,Default,,0,0,0,,(Сунеоның гуілдеуі)
Dialogue: 0,1:27:03.63,1:27:08.43,Default,,0,0,0,,Сол қыз айтатын әнді жақында бір жерден естігендей болдым...
Dialogue: 0,1:27:08.51,1:27:09.64,Default,,0,0,0,,Ах!
Dialogue: 0,1:27:09.72,1:27:11.80,Default,,0,0,0,,Дива Мина!
Dialogue: 0,1:27:12.68,1:27:15.06,Default,,0,0,0,,Бір күндік билеттер сатылып кетті.
Dialogue: 0,1:27:16.64,1:27:19.85,Default,,0,0,0,,Мина Шоудың басталуына әлі уақыт бар.
Dialogue: 0,1:27:19.94,1:27:21.77,Default,,0,0,0,,Босаңсып отырыңыз
Dialogue: 0,1:27:21.86,1:27:23.27,Default,,0,0,0,,Жарайды
Dialogue: 0,1:27:26.07,1:27:27.28,Default,,0,0,0,,(есік дыбысы)
Dialogue: 0,1:27:27.36,1:27:30.03,Default,,0,0,0,,Енді уайымдаудың қажеті жоқ...
Dialogue: 0,1:27:30.91,1:27:31.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:32.87,1:27:34.20,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:27:34.29,1:27:35.37,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:40.71,1:27:42.21,Default,,0,0,0,,Сол шаштың түсі...
Dialogue: 0,1:27:42.79,1:27:44.38,Default,,0,0,0,,Мен Миккамын
Dialogue: 0,1:27:44.46,1:27:47.17,Default,,0,0,0,,Мен осында сыбызғы іздеуге келдім.
Dialogue: 0,1:27:47.26,1:27:49.13,Default,,0,0,0,,Ысқырық?
Dialogue: 0,1:27:49.22,1:27:50.30,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:54.43,1:27:57.93,Default,,0,0,0,,Мүмкін сіз бұл туралы айтып отырған шығарсыз?
Dialogue: 0,1:27:58.02,1:28:01.23,Default,,0,0,0,,А...осы флейтаны маған қарызға берші.
Dialogue: 0,1:28:01.31,1:28:02.15,Default,,0,0,0,,А...
Dialogue: 0,1:28:02.23,1:28:06.40,Default,,0,0,0,,Бұл Германиядағы әжемнен қалған сүйкімділік.
Dialogue: 0,1:28:11.66,1:28:12.82,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:13.70,1:28:14.53,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,1:28:16.33,1:28:19.00,Default,,0,0,0,,Сүйкімді жанкүйердің өтініші
Dialogue: 0,1:28:19.75,1:28:22.46,Default,,0,0,0,,Рахмет, міндетті түрде қайтарамын!
Dialogue: 0,1:28:22.54,1:28:25.42,Default,,0,0,0,,Иә, тағы кездескенше!
Dialogue: 0,1:28:27.80,1:28:30.63,Default,,0,0,0,,- (Нобита) Қалай болды? -Хаха...
Dialogue: 0,1:28:30.72,1:28:35.10,Default,,0,0,0,,Иә! Ол сондай керемет әпке болды!
Dialogue: 0,1:28:35.18,1:28:37.39,Default,,0,0,0,,Әлемге әйгілі дива Мина
Dialogue: 0,1:28:37.47,1:28:40.39,Default,,0,0,0,,Мушиканың қаны сізге мұра болды ма?
Dialogue: 0,1:28:40.48,1:28:42.56,Default,,0,0,0,,Сізге жақсы, Дораемон
Dialogue: 0,1:28:42.65,1:28:43.81,Default,,0,0,0,,Дораемон?
Dialogue: 0,1:28:43.90,1:28:46.32,Default,,0,0,0,,Гагагагага…
Dialogue: 0,1:28:46.40,1:28:48.28,Default,,0,0,0,,-Пуссун~ (Нобита) Дораемон!
Dialogue: 0,1:28:48.36,1:28:50.86,Default,,0,0,0,,- (Нобита) Дораемон! -Мүйізді!
Dialogue: 0,1:28:50.95,1:28:53.16,Default,,0,0,0,,Тезірек осы ысқырықты пайдаланыңыз!
Dialogue: 0,1:28:53.24,1:28:56.16,Default,,0,0,0,,(Музыка флейта орындауы)
Dialogue: 0,1:29:00.58,1:29:02.87,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,1:29:02.96,1:29:04.21,Default,,0,0,0,,Ах! Құдай-ай!
Dialogue: 0,1:29:04.29,1:29:07.34,Default,,0,0,0,,Неліктен!? Оны тік ысқырықпен түзете аласыз...
Dialogue: 0,1:29:07.42,1:29:10.30,Default,,0,0,0,,Мына флейта... жоқ.
Dialogue: 0,1:29:10.38,1:29:12.51,Default,,0,0,0,,Мүмкін сондықтан болар
Dialogue: 0,1:29:12.59,1:29:13.80,Default,,0,0,0,,Міне!
Dialogue: 0,1:29:13.89,1:29:16.30,Default,,0,0,0,,Эй, Джан, сегізаяқ тәрізді нәрсе.
Dialogue: 0,1:29:16.39,1:29:18.01,Default,,0,0,0,,Олар шу споралары емес пе?
Dialogue: 0,1:29:18.10,1:29:20.85,Default,,0,0,0,,Сіз оны музыкамен оңай жеңе аласыз, солай ма?
Dialogue: 0,1:29:20.93,1:29:21.85,Default,,0,0,0,,О!
Dialogue: 0,1:29:21.93,1:29:24.19,Default,,0,0,0,,Егер бәріміз музыка ойнасақ
Dialogue: 0,1:29:24.27,1:29:26.94,Default,,0,0,0,,Дора-чан да қалыпты жағдайға орала ма деп ойлаймын!
Dialogue: 0,1:29:27.02,1:29:28.78,Default,,0,0,0,,Міне, солай!
Dialogue: 0,1:29:29.98,1:29:33.40,Default,,0,0,0,,(4 адамның орындауы: «Диктофонның тапсырмасы»)
Dialogue: 0,1:29:33.49,1:29:39.41,Default,,0,0,0,,(үйлесімсіз, ұйымдастырылмаған музыка)
Dialogue: 0,1:29:40.37,1:29:42.91,Default,,0,0,0,,(«жоқ» дыбысы)
Dialogue: 0,1:29:45.25,1:29:48.09,Default,,0,0,0,,Джан, басс тым алға!
Dialogue: 0,1:29:48.17,1:29:51.92,Default,,0,0,0,,Салқын болуды тоқтатып, оны дұрыс сәйкестендіруге тырысатын адам сізсіз!
Dialogue: 0,1:29:52.01,1:29:55.18,Default,,0,0,0,,Мен өзімді бұрынғыдан да нашар сезінемін...
Dialogue: 0,1:29:55.26,1:29:58.68,Default,,0,0,0,,(сүрінетін өнімділік)
Dialogue: 0,1:29:58.76,1:30:00.81,Default,,0,0,0,,Фарре төбелесіп жатыр
Dialogue: 0,1:30:00.89,1:30:03.73,Default,,0,0,0,,Егер бәрі бірдей әуенді ойнап бітсе...
Dialogue: 0,1:30:03.81,1:30:04.69,Default,,0,0,0,,(«жоқ» дыбысы)
Dialogue: 0,1:30:05.27,1:30:07.69,Default,,0,0,0,,Сәлем Нобита! Сіз енді соқпайсыз!
Dialogue: 0,1:30:07.77,1:30:10.48,Default,,0,0,0,,Егер Нобита осында болса, түзетуге болатын нәрселер түзетілмейді!
Dialogue: 0,1:30:10.57,1:30:11.57,Default,,0,0,0,,Міне!
Dialogue: 0,1:30:11.65,1:30:13.15,Default,,0,0,0,,(туба дыбысы)
Dialogue: 0,1:30:13.24,1:30:14.86,Default,,0,0,0,,Шулы!
Dialogue: 0,1:30:16.53,1:30:19.12,Default,,0,0,0,,-Тоқтатсаң -(Нобита) Маған ұнамайды!
Dialogue: 0,1:30:19.20,1:30:21.62,Default,,0,0,0,,Мен де жаттықтым.
Dialogue: 0,1:30:21.70,1:30:23.16,Default,,0,0,0,,Мен де...
Dialogue: 0,1:30:23.79,1:30:26.71,Default,,0,0,0,,Мен барлығымен ойнағым келеді!
Dialogue: 0,1:30:26.79,1:30:29.34,Default,,0,0,0,,Мен Дораэмон-ды түзеткім келеді!
Dialogue: 0,1:30:31.30,1:30:35.05,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,1:30:38.05,1:30:38.93,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:39.01,1:30:40.93,Default,,0,0,0,,(маримба дыбысы)
Dialogue: 0,1:30:41.01,1:30:42.72,Default,,0,0,0,,Иә.
Dialogue: 0,1:30:42.81,1:30:43.72,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,1:30:43.81,1:30:46.44,Default,,0,0,0,,Бұл жақсы, бәрі, міне...
Dialogue: 0,1:30:46.52,1:30:49.52,Default,,0,0,0,,(Кастанеттер ойнайды)
Dialogue: 0,1:30:49.61,1:30:51.15,Default,,0,0,0,,Хехехе
Dialogue: 0,1:30:51.23,1:30:53.11,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,1:30:54.07,1:30:58.49,Default,,0,0,0,,(Диктофонды толықтыратын сүйемелдеу)
Dialogue: 0,1:31:00.03,1:31:03.87,Default,,0,0,0,,(Диктофонды толықтыратын сүйемелдеу)
Dialogue: 0,1:31:03.95,1:31:05.37,Default,,0,0,0,,Хехехе
Dialogue: 0,1:31:11.21,1:31:16.01,Default,,0,0,0,,(«Диктофон тапсырмасының» тыныс үндестігі)
Dialogue: 0,1:31:17.30,1:31:21.30,Default,,0,0,0,,(Ән айту)
Dialogue: 0,1:31:30.10,1:31:32.61,Default,,0,0,0,,Ууу… С-сен… мықты екенсің
Dialogue: 0,1:31:32.69,1:31:34.53,Default,,0,0,0,,Гекция!
Dialogue: 0,1:31:42.74,1:31:48.21,Default,,0,0,0,,(Миканың ән айту дауысы және 4 адамның орындауы)
Dialogue: 0,1:31:50.08,1:31:51.83,Default,,0,0,0,,- (Нобита) Барлығы керемет! -Хахаха
Dialogue: 0,1:31:51.92,1:31:53.38,Default,,0,0,0,,Бұл бірінші рет!
Dialogue: 0,1:31:53.46,1:31:55.42,Default,,0,0,0,,Мен шошып кеттім!
Dialogue: 0,1:31:55.51,1:31:57.80,Default,,0,0,0,,Барлығы керемет болды!
Dialogue: 0,1:31:58.38,1:32:00.64,Default,,0,0,0,,(Шапалақтау дыбысы)
Dialogue: 0,1:32:00.72,1:32:02.35,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:32:03.14,1:32:07.81,Default,,0,0,0,,Мен сіздің магнитофоныңыздың жақсы екенін естідім.
Dialogue: 0,1:32:07.89,1:32:09.94,Default,,0,0,0,,Дораемон...
Dialogue: 0,1:32:10.02,1:32:11.98,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:32:12.06,1:32:13.52,Default,,0,0,0,,Керемет!
Dialogue: 0,1:32:13.61,1:32:16.53,Default,,0,0,0,,-Дора-чан! - Ол жөнделген сияқты.
Dialogue: 0,1:32:16.61,1:32:18.78,Default,,0,0,0,,Ах
Dialogue: 0,1:32:23.03,1:32:26.24,Default,,0,0,0,,Уау, мен виртуоз болдым!
Dialogue: 0,1:32:26.33,1:32:27.83,Default,,0,0,0,,- Мен де! -(Сунео) Мен де!
Dialogue: 0,1:32:27.91,1:32:29.50,Default,,0,0,0,,(Музыкалық аспаптардың дыбыстары)
Dialogue: 0,1:32:29.58,1:32:32.71,Default,,0,0,0,,Білемін, жаным!
Dialogue: 0,1:32:35.75,1:32:37.76,Default,,0,0,0,,Менің де деңгейім көтерілді!
Dialogue: 0,1:32:37.84,1:32:39.84,Default,,0,0,0,,Саған жақсы, Нобита-кун
Dialogue: 0,1:32:39.92,1:32:42.39,Default,,0,0,0,,Иә! (магнитофон дыбысы)
Dialogue: 0,1:32:42.47,1:32:46.31,Default,,0,0,0,,(магнитофон дыбысы)
Dialogue: 0,1:32:47.43,1:32:48.93,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,1:32:49.02,1:32:51.60,Default,,0,0,0,,Қойылым жақсы болды.
Dialogue: 0,1:32:51.69,1:32:52.56,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,1:32:52.65,1:32:56.40,Default,,0,0,0,,Бұл өте жақсы қойылым болды.
Dialogue: 0,1:32:56.48,1:32:58.53,Default,,0,0,0,,Сәлем Капек
Dialogue: 0,1:32:58.61,1:33:00.95,Default,,0,0,0,,Бәріміз бірге көңіл көтерейік
Dialogue: 0,1:33:01.70,1:33:03.07,Default,,0,0,0,,Бұл қызық!
Dialogue: 0,1:33:04.28,1:33:05.37,Default,,0,0,0,,Иә!
Dialogue: 0,1:33:05.87,1:33:06.95,Default,,0,0,0,,Yo~tto!
Dialogue: 0,1:33:07.54,1:33:09.41,Default,,0,0,0,,Даңқ залына барайық!
Dialogue: 0,1:33:09.50,1:33:12.62,Default,,0,0,0,,Жерді шудан қорғаңыз!
Dialogue: 0,1:33:12.71,1:33:14.42,Default,,0,0,0,,Иә!
Dialogue: 0,1:33:21.09,1:33:23.47,Default,,0,0,0,,Маэстро… (қоңырау дыбысы)
Dialogue: 0,1:33:23.55,1:33:26.89,Default,,0,0,0,,Қарғыс атқыр, біз бұл жерді не болса да қорғауымыз керек.
Dialogue: 0,1:33:26.97,1:33:28.06,Default,,0,0,0,,Иә!?
Dialogue: 0,1:33:31.02,1:33:37.86,Default,,0,0,0,,(Туба спектаклі: «Қуанышқа ода»)
Dialogue: 0,1:33:37.94,1:33:44.16,Default,,0,0,0,,(скрипкамен ансамбль)
Dialogue: 0,1:33:44.24,1:33:46.45,Default,,0,0,0,,- (Вентау) Әй... - (Моцель) Керемет!
Dialogue: 0,1:33:46.53,1:33:50.20,Default,,0,0,0,,(Дораэмонның ән айтатын дауысы: «Эйне Клейн Нахтмусик»)
Dialogue: 0,1:33:51.00,1:33:52.66,Default,,0,0,0,,Асығыңыз, қазір!
Dialogue: 0,1:33:52.75,1:33:53.83,Default,,0,0,0,,Иә!
Dialogue: 0,1:33:53.91,1:33:56.17,Default,,0,0,0,,Мұғалім! Мен ысқырық әкелдім!
Dialogue: 0,1:33:56.25,1:33:57.42,Default,,0,0,0,,Жарайсың
Dialogue: 0,1:33:57.50,1:34:00.92,Default,,0,0,0,,Біз бұл жерді қорғаймыз. Негізгі қосқышты жылдам қосыңыз!
Dialogue: 0,1:34:01.01,1:34:02.72,Default,,0,0,0,,Мен де осында күресемін.
Dialogue: 0,1:34:02.80,1:34:04.72,Default,,0,0,0,,-Мика-сама -Иә, маған қалдырыңыз!
Dialogue: 0,1:34:04.80,1:34:06.89,Default,,0,0,0,,Нобита-кун, Мика-чан!
Dialogue: 0,1:34:06.97,1:34:08.05,Default,,0,0,0,,Иә!
Dialogue: 0,1:34:08.14,1:34:09.72,Default,,0,0,0,,Дора-чан!
Dialogue: 0,1:34:09.81,1:34:14.73,Default,,0,0,0,,(Дораэмонның ән айтатын дауысы: «Кішкентай фуга минор»)
Dialogue: 0,1:34:20.73,1:34:22.19,Default,,0,0,0,,Бес…
Dialogue: 0,1:34:22.28,1:34:24.11,Default,,0,0,0,,Микка-чан!
Dialogue: 0,1:34:24.20,1:34:25.40,Default,,0,0,0,,Нобита
Dialogue: 0,1:34:27.66,1:34:30.28,Default,,0,0,0,,(Музиканың ысқырығы)
Dialogue: 0,1:34:32.91,1:34:35.29,Default,,0,0,0,,(Музиканың ысқырығы)
Dialogue: 0,1:34:38.08,1:34:40.75,Default,,0,0,0,,(Музиканың ысқырығы)
Dialogue: 0,1:34:42.05,1:34:43.92,Default,,0,0,0,,(Музиканың ысқырығы)
Dialogue: 0,1:34:46.72,1:34:48.47,Default,,0,0,0,,(тыныс тәрізді дыбыс)
Dialogue: 0,1:34:49.68,1:34:52.31,Default,,0,0,0,,Жоқ, бұл тіпті бір нота емес.
Dialogue: 0,1:34:52.39,1:34:53.56,Default,,0,0,0,,Міне!
Dialogue: 0,1:34:54.27,1:34:58.15,Default,,0,0,0,,(Контрабас орындау: «Тағдыр»)
Dialogue: 0,1:34:58.23,1:34:59.86,Default,,0,0,0,,Әлі жоқ... Микка
Dialogue: 0,1:34:59.94,1:35:00.77,Default,,0,0,0,,Ах!
Dialogue: 0,1:35:02.15,1:35:03.48,Default,,0,0,0,,Ұстаз!
Dialogue: 0,1:35:09.03,1:35:10.20,Default,,0,0,0,,Дора-чан!
Dialogue: 0,1:35:10.28,1:35:11.41,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:35:11.99,1:35:13.24,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,1:35:13.95,1:35:20.08,Default,,0,0,0,,(Музиканың ысқырығы)
Dialogue: 0,1:35:20.17,1:35:21.88,Default,,0,0,0,,Әлі де жақсы емес
Dialogue: 0,1:35:21.96,1:35:22.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:23.46,1:35:24.76,Default,,0,0,0,,- (Нобита) Микка-чан! -Эй!
Dialogue: 0,1:35:28.01,1:35:33.68,Default,,0,0,0,,(Диктофонның өнімділігі: «Диктофонның тапсырмасы»)
Dialogue: 0,1:35:36.23,1:35:37.69,Default,,0,0,0,,(«жоқ» дыбысы)
Dialogue: 0,1:35:37.77,1:35:40.10,Default,,0,0,0,,Бұл...
Dialogue: 0,1:35:40.19,1:35:41.65,Default,,0,0,0,,Нобита-кун…
Dialogue: 0,1:35:42.27,1:35:43.36,Default,,0,0,0,,«Жоқ» дыбысы!?
Dialogue: 0,1:35:43.44,1:35:45.82,Default,,0,0,0,,Бұл ностальгиялық дыбыс.
Dialogue: 0,1:35:45.90,1:35:49.24,Default,,0,0,0,,Неліктен мен... осындай қиын уақытта...
Dialogue: 0,1:35:49.32,1:35:50.78,Default,,0,0,0,,Нобитаға қара!
Dialogue: 0,1:35:59.96,1:36:01.46,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:36:01.54,1:36:05.67,Default,,0,0,0,,Жетіспейтін дыбыс Нобитаның «жоқ» дыбысы болды.
Dialogue: 0,1:36:24.61,1:36:26.65,Default,,0,0,0,,Сәлем...
Dialogue: 0,1:36:28.15,1:36:28.99,Default,,0,0,0,,Иә?
Dialogue: 0,1:36:31.28,1:36:32.70,Default,,0,0,0,,Хмм...
Dialogue: 0,1:36:32.78,1:36:34.70,Default,,0,0,0,,Не деген... ой!
Dialogue: 0,1:36:35.28,1:36:36.79,Default,,0,0,0,,Міне, алғашқы отбасыңды мүлде ұмытып қалғансың➡
Dialogue: 0,1:36:36.87,1:36:38.16,Default,,0,0,0,,Дораемон
Dialogue: 0,1:36:38.87,1:36:41.92,Default,,0,0,0,,Әй... Бұл жақын қоңырау болды.
Dialogue: 0,1:36:42.71,1:36:45.09,Default,,0,0,0,,Ха... Мұғалім!
Dialogue: 0,1:36:46.17,1:36:47.80,Default,,0,0,0,,Алайда, кейбір қарсыластар қашып кетті
Dialogue: 0,1:36:48.38,1:36:52.59,Default,,0,0,0,,Зал - дыбыссыз ғаламдағы біздің жолымыз.
Dialogue: 0,1:36:52.68,1:36:56.10,Default,,0,0,0,,Дыбыс шығаратын аспап.
Dialogue: 0,1:36:58.02,1:37:01.60,Default,,0,0,0,,Балалар, мен сендерді тағы көргеніме қуаныштымын.
Dialogue: 0,1:37:01.69,1:37:03.69,Default,,0,0,0,,Бірақ дәл қазір уақытым жоқ.
Dialogue: 0,1:37:03.77,1:37:06.36,Default,,0,0,0,,Шу жерге жақындап келеді.
Dialogue: 0,1:37:06.44,1:37:10.15,Default,,0,0,0,,Біз ешқашан өткенді қайталамауымыз керек.
Dialogue: 0,1:37:10.24,1:37:13.24,Default,,0,0,0,,Енді біз үшін тарифті ойнайтын кез келді...
Dialogue: 0,1:37:13.32,1:37:15.24,Default,,0,0,0,,Шуды жойыңыз!
Dialogue: 0,1:37:15.32,1:37:16.58,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,1:37:17.16,1:37:20.75,Default,,0,0,0,,Мен осы спектакльдің негізгі ойыншысын таныстырғым келеді.
Dialogue: 0,1:37:20.83,1:37:23.62,Default,,0,0,0,,Мен Жерден келіп, залды сақтап қалдым.
Dialogue: 0,1:37:23.71,1:37:26.54,Default,,0,0,0,,Бес виртуоз!
Dialogue: 0,1:37:27.75,1:37:30.01,Default,,0,0,0,,Барлығымыз кеттік.
Dialogue: 0,1:37:31.84,1:37:33.51,Default,,0,0,0,,(Шапалақтау дыбысы)
Dialogue: 0,1:37:33.59,1:37:34.80,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,1:37:37.60,1:37:41.98,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,1:37:42.06,1:37:44.73,Default,,0,0,0,,Осыншама көп адаммен ойнайсың ба?
Dialogue: 0,1:37:44.81,1:37:46.69,Default,,0,0,0,,Мен... Мен қобалжыдым.
Dialogue: 0,1:37:46.77,1:37:49.28,Default,,0,0,0,,Сізде бәрі жақсы болады.
Dialogue: 0,1:37:49.36,1:37:51.90,Default,,0,0,0,,Осы уақытқа дейін не істегеніңізді есте сақтаңыз.
Dialogue: 0,1:37:51.99,1:37:55.24,Default,,0,0,0,,Жарайды... дәл қазір біз үшін.
Dialogue: 0,1:37:55.32,1:37:57.78,Default,,0,0,0,,Ах хаха
Dialogue: 0,1:37:57.87,1:37:59.62,Default,,0,0,0,,Хехе, уайымдама.
Dialogue: 0,1:37:59.70,1:38:01.54,Default,,0,0,0,,Төтенше жағдайда менің әнімді пайдаланыңыз...
Dialogue: 0,1:38:01.62,1:38:05.37,Default,,0,0,0,,Сәлем! Тек оны тоқтатыңыз, сонда ғалам ыдырайтын болады!
Dialogue: 0,1:38:05.46,1:38:07.67,Default,,0,0,0,,Бірақ... қолдан келгеннің бәрін жасайық.
Dialogue: 0,1:38:07.75,1:38:09.84,Default,,0,0,0,,Ах хехе
Dialogue: 0,1:38:10.55,1:38:12.76,Default,,0,0,0,,Кез келген жағдайда «Tekio шамын» пайдаланыңыз.
Dialogue: 0,1:38:12.84,1:38:16.43,Default,,0,0,0,,Сондай-ақ, мен бірнеше күшті күшейтуді шақырдым.
Dialogue: 0,1:38:16.51,1:38:19.01,Default,,0,0,0,,-Уау - (Сунео) Керемет!
Dialogue: 0,1:38:19.10,1:38:20.81,Default,,0,0,0,,Сол кезде!
Dialogue: 0,1:38:20.89,1:38:22.47,Default,,0,0,0,,- (Нобита) А... - А?
Dialogue: 0,1:38:22.56,1:38:24.10,Default,,0,0,0,,Мен үшін күткендей...
Dialogue: 0,1:38:24.18,1:38:27.44,Default,,0,0,0,,Ах
Dialogue: 0,1:38:28.69,1:38:32.40,Default,,0,0,0,,Ахахахаха, тоқтат, қытықтайды...
Dialogue: 0,1:38:32.99,1:38:34.03,Default,,0,0,0,,Мен
Dialogue: 0,1:38:34.11,1:38:36.53,Default,,0,0,0,,Өйткені мен Капекпен жалғыз болдым.
Dialogue: 0,1:38:36.61,1:38:39.16,Default,,0,0,0,,Барлығымен ән айту өте қызықты
Dialogue: 0,1:38:39.24,1:38:40.99,Default,,0,0,0,,Мен білмедім
Dialogue: 0,1:38:41.08,1:38:43.62,Default,,0,0,0,,Барлығымен танысқаныма өте қуаныштымын.
Dialogue: 0,1:38:43.70,1:38:45.75,Default,,0,0,0,,Бәріміз ән айтайық!
Dialogue: 0,1:38:45.83,1:38:47.83,Default,,0,0,0,,Шудан арылайық!
Dialogue: 0,1:38:47.92,1:38:50.29,Default,,0,0,0,,Хахахаха Иә!
Dialogue: 0,1:38:50.88,1:38:53.26,Default,,0,0,0,,Айтпақшы, сіз қандай әнді орындамақсыз?
Dialogue: 0,1:38:53.34,1:38:56.22,Default,,0,0,0,,Әнді жазған Кәпек.
Dialogue: 0,1:38:56.30,1:38:58.93,Default,,0,0,0,,Capek? таңқаларлық!
Dialogue: 0,1:38:59.01,1:39:03.47,Default,,0,0,0,,Мен... Маэстроның әндері ұнайды дедім.
Dialogue: 0,1:39:03.56,1:39:06.73,Default,,0,0,0,,Өйткені мен жердің әуенімен араластым
Dialogue: 0,1:39:06.81,1:39:09.15,Default,,0,0,0,,Менің ойымша, жаңа тариф құруға болады...
Dialogue: 0,1:39:09.90,1:39:12.40,Default,,0,0,0,,Мен Нобита-санмен және басқалармен кездескеніме қуаныштымын.
Dialogue: 0,1:39:12.48,1:39:15.44,Default,,0,0,0,,Жердің музыкасына түскеніме қуаныштымын.
Dialogue: 0,1:39:15.53,1:39:17.36,Default,,0,0,0,,Біз бұл сезімді енгіздік!
Dialogue: 0,1:39:18.49,1:39:21.16,Default,,0,0,0,,Әй, ол әннің аты қалай?
Dialogue: 0,1:39:22.66,1:39:24.91,Default,,0,0,0,,«Жер симфониясы (Чикю симфониясы)»
Dialogue: 0,1:39:27.41,1:39:33.88,Default,,0,0,0,,(Оркестрді баптау)
Dialogue: 0,1:39:47.69,1:39:53.11,Default,,0,0,0,,」）
Dialogue: 0,1:39:53.19,1:39:57.11,Default,,0,0,0,,(керемет және күшті әуен)
Dialogue: 0,1:39:59.20,1:40:00.41,Default,,0,0,0,,Иә
Dialogue: 0,1:40:02.16,1:40:03.24,Default,,0,0,0,,Иә
Dialogue: 0,1:40:03.78,1:40:05.79,Default,,0,0,0,,Ах...хехе
Dialogue: 0,1:40:05.87,1:40:07.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:10.46,1:40:13.88,Default,,0,0,0,,）
Dialogue: 0,1:40:17.76,1:40:19.72,Default,,0,0,0,,- (Нобита) Дораемон! -Осында!
Dialogue: 0,1:41:00.51,1:41:02.30,Default,,0,0,0,,Тариф жұмыс істейді!
Dialogue: 0,1:41:02.38,1:41:05.10,Default,,0,0,0,,Тек мені қуа бер!
Dialogue: 0,1:41:14.61,1:41:15.44,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:41:15.52,1:41:17.94,Default,,0,0,0,,Ешқандай болмаңыз! Жалғастырайық!
Dialogue: 0,1:41:18.03,1:41:23.20,Default,,0,0,0,,(Әннің шарықтау шегі)
Dialogue: 0,1:41:27.03,1:41:32.46,Default,,0,0,0,,(«Микка әні» және «Диктофонға тапсырма әні»)
Dialogue: 0,1:41:32.54,1:41:36.96,Default,,0,0,0,,(Ән айту)
Dialogue: 0,1:42:18.59,1:42:21.00,Default,,0,0,0,,Уа, шу азайып барады
Dialogue: 0,1:42:21.09,1:42:25.97,Default,,0,0,0,,(Миканың ән айту дауысы)
Dialogue: 0,1:42:38.56,1:42:40.19,Default,,0,0,0,,Мотоциклді қолданғандағыдай, ол—
Dialogue: 0,1:42:41.02,1:42:42.69,Default,,0,0,0,,Микка-сама~!
Dialogue: 0,1:42:42.78,1:42:44.90,Default,,0,0,0,,- (Вентау) Бұл жаман - (Моцель) Мынау...
Dialogue: 0,1:42:44.99,1:42:47.32,Default,,0,0,0,,- Қарғыс атсын! -(Нобита) Дораемон!
Dialogue: 0,1:42:47.41,1:42:48.87,Default,,0,0,0,,Әй!
Dialogue: 0,1:42:48.95,1:42:50.83,Default,,0,0,0,,«Әуе зеңбірегі»! Бум!
Dialogue: 0,1:42:50.91,1:42:55.33,Default,,0,0,0,,Бум! Бум! Бум! Бум!
Dialogue: 0,1:42:55.41,1:42:57.17,Default,,0,0,0,,Бұл жұмыс істемейді... Уау!
Dialogue: 0,1:42:57.75,1:42:59.25,Default,,0,0,0,,Бұл музыка болуы керек пе?
Dialogue: 0,1:42:59.33,1:43:01.80,Default,,0,0,0,,Ум, музыкалық аспап, музыкалық аспап...
Dialogue: 0,1:43:01.88,1:43:03.09,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:43:03.63,1:43:07.13,Default,,0,0,0,,(Charumera әуені)
Dialogue: 0,1:43:10.18,1:43:12.64,Default,,0,0,0,,Жоқ! Бұл «Клиент Чарумера» болды…
Dialogue: 0,1:43:12.72,1:43:13.56,Default,,0,0,0,,Ха!
Dialogue: 0,1:43:13.64,1:43:15.10,Default,,0,0,0,,Уау!
Dialogue: 0,1:43:15.18,1:43:18.73,Default,,0,0,0,,Уау!
Dialogue: 0,1:43:18.81,1:43:20.27,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:43:20.36,1:43:21.19,Default,,0,0,0,,Уау!
Dialogue: 0,1:43:21.27,1:43:22.40,Default,,0,0,0,,Иә!
Dialogue: 0,1:43:22.48,1:43:23.90,Default,,0,0,0,,-Уау! -(Сунео) Жүр!
Dialogue: 0,1:43:27.11,1:43:28.99,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:43:30.16,1:43:33.87,Default,,0,0,0,,Уау!
Dialogue: 0,1:43:34.62,1:43:37.50,Default,,0,0,0,,Микка-сама~! Нобита-сан!
Dialogue: 0,1:43:37.58,1:43:40.00,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:43:41.00,1:43:44.21,Default,,0,0,0,,Бұл мен үшін...!
Dialogue: 0,1:43:44.30,1:43:49.30,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:43:54.60,1:43:56.10,Default,,0,0,0,,Дыбыс...
Dialogue: 0,1:43:56.68,1:43:57.89,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,1:44:38.52,1:44:42.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:44:42.15,1:44:43.56,Default,,0,0,0,,Дыбыс...
Dialogue: 0,1:44:43.65,1:44:45.27,Default,,0,0,0,,Музыка...!
Dialogue: 0,1:44:59.83,1:45:01.29,Default,,0,0,0,,Нобита-сан
Dialogue: 0,1:45:03.79,1:45:06.30,Default,,0,0,0,,Әлі біткен жоқ, иә? Сунео?
Dialogue: 0,1:45:06.38,1:45:07.80,Default,,0,0,0,,Міне, солай!
Dialogue: 0,1:45:07.88,1:45:08.84,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:45:08.92,1:45:10.63,Default,,0,0,0,,Кеттік, Нобита!
Dialogue: 0,1:45:10.72,1:45:11.84,Default,,0,0,0,,Микка!
Dialogue: 0,1:45:11.93,1:45:15.55,Default,,0,0,0,,(Миканың ән айту дауысы)
Dialogue: 0,1:45:15.64,1:45:19.64,Default,,0,0,0,,(Диктофон және туба өнімділігі)
Dialogue: 0,1:45:19.73,1:45:23.31,Default,,0,0,0,,(Ән айту)
Dialogue: 0,1:45:23.40,1:45:27.32,Default,,0,0,0,,(Диктофон және түтік өнімділігі)
Dialogue: 0,1:45:27.40,1:45:29.07,Default,,0,0,0,,Бұл...
Dialogue: 0,1:45:29.69,1:45:31.82,Default,,0,0,0,,Кеңістікте дыбыс бар...
Dialogue: 0,1:45:32.65,1:45:35.32,Default,,0,0,0,,Микка-сама Нобита-сан және басқалар!
Dialogue: 0,1:45:35.41,1:45:36.70,Default,,0,0,0,,(Миканың ән салған дауысы)
Dialogue: 0,1:45:36.78,1:45:39.20,Default,,0,0,0,,О? Мен бұл қайдан шыққанына таңғаламын
Dialogue: 0,1:45:39.29,1:45:42.58,Default,,0,0,0,,Бұл сіздің көршіңіздің теледидары емес пе?
Dialogue: 0,1:45:43.17,1:45:46.59,Default,,0,0,0,,(Миканың ән айту дауысы және Нобитаның орындауы)
Dialogue: 0,1:46:04.31,1:46:07.06,Default,,0,0,0,,(Ритмикалық тазалау машинасының дыбысы)
Dialogue: 0,1:46:07.15,1:46:07.98,Default,,0,0,0,,Иә?
Dialogue: 0,1:46:08.07,1:46:11.61,Default,,0,0,0,,(ритмикалық пышақ дыбысы)
Dialogue: 0,1:46:11.69,1:46:15.36,Default,,0,0,0,,(ритмикалық ара дыбысы)
Dialogue: 0,1:46:15.45,1:46:17.87,Default,,0,0,0,,(дәретхананың ағу дыбысы)
Dialogue: 0,1:46:17.95,1:46:18.78,Default,,0,0,0,,Иә
Dialogue: 0,1:46:18.87,1:46:20.79,Default,,0,0,0,,Екінші жағынан, тарих жауыздар деп аталған, бірақ өз ізін қалдырған адамдарға да толы
Dialogue: 0,1:46:20.87,1:46:23.00,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:46:23.08,1:46:26.38,Default,,0,0,0,,Олай болса, соңында бәріміз бірге жасайық!
Dialogue: 0,1:46:26.46,1:46:32.76,Default,,0,0,0,,(дүркін шапалақтау)
Dialogue: 0,1:46:32.84,1:46:36.76,Default,,0,0,0,,(Жерден естілетін музыка)
Dialogue: 0,1:46:36.84,1:46:39.26,Default,,0,0,0,,Жерден шыққан музыка...!
Dialogue: 0,1:46:39.35,1:46:40.51,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:46:40.60,1:46:45.02,Default,,0,0,0,,Оны осы әлемге байлап қою үшін—
Dialogue: 0,1:46:45.60,1:46:47.90,Default,,0,0,0,,Біз де солай етеміз!
Dialogue: 0,1:46:47.98,1:46:52.40,Default,,0,0,0,,(Оркестрдің орындауы және жерден естілген музыка)
Dialogue: 0,1:46:58.74,1:47:02.41,Default,,0,0,0,,(Миканың ән салған дауысы)
Dialogue: 0,1:47:02.49,1:47:06.16,Default,,0,0,0,,(Минаның ән салған дауысы)
Dialogue: 0,1:47:06.25,1:47:09.67,Default,,0,0,0,,(Мика мен Минаның ән салған дауысы)
Dialogue: 0,1:47:51.46,1:47:56.47,Default,,0,0,0,,(«Армандарыңды орында, Дораемон»)
Dialogue: 0,1:48:01.09,1:48:06.22,Default,,0,0,0,,(Миканың ән айту дауысы)
Dialogue: 0,1:48:11.35,1:48:13.11,Default,,0,0,0,,(аққудың айқайы)
Dialogue: 0,1:48:26.79,1:48:31.83,Default,,0,0,0,,(«жоқ» дыбысы жоғары)
Dialogue: 0,1:48:42.01,1:48:43.76,Default,,0,0,0,,(аққудың айқайы)
Dialogue: 0,1:48:50.60,1:48:53.10,Default,,0,0,0,,Уау, бұл тамаша.
Dialogue: 0,1:48:53.19,1:48:55.48,Default,,0,0,0,,Бұл керемет концерт болды.
Dialogue: 0,1:48:55.57,1:48:57.90,Default,,0,0,0,,Бірақ бұл өте қызықты болды!
Dialogue: 0,1:48:57.98,1:49:00.70,Default,,0,0,0,,Иә! Мен сенімдімін...
Dialogue: 0,1:49:01.32,1:49:02.45,Default,,0,0,0,,-(Нобита) А... -Мм?
Dialogue: 0,1:49:02.53,1:49:03.99,Default,,0,0,0,,Ұстаз!
Dialogue: 0,1:49:04.07,1:49:05.03,Default,,0,0,0,,О
Dialogue: 0,1:49:05.12,1:49:07.41,Default,,0,0,0,,Әй, Микка-сама!
Dialogue: 0,1:49:07.49,1:49:10.46,Default,,0,0,0,,«Шеңбердегі виртуоздар мен роботтар»
Dialogue: 0,1:49:10.54,1:49:13.25,Default,,0,0,0,,«Ол өте әдемі ойнады».
Dialogue: 0,1:49:13.33,1:49:15.84,Default,,0,0,0,,«Дыбыс жәндіктер жарқырап ұшады»
Dialogue: 0,1:49:15.92,1:49:18.59,Default,,0,0,0,,«Әлем нұрға толды».
Dialogue: 0,1:49:19.21,1:49:21.47,Default,,0,0,0,,Бірақ неге үнсіз болуы керек ғаламда?
Dialogue: 0,1:49:21.55,1:49:24.18,Default,,0,0,0,,Дыбыс болған шығар... А?
Dialogue: 0,1:49:24.26,1:49:25.68,Default,,0,0,0,,Міне!
Dialogue: 0,1:49:25.76,1:49:28.52,Default,,0,0,0,,«Кеңістік-уақыт өзгерткіш»? Неге мұндасың...
Dialogue: 0,1:49:28.60,1:49:29.56,Default,,0,0,0,,Не болды?
Dialogue: 0,1:49:29.64,1:49:31.60,Default,,0,0,0,,Ах! Ол қосылды
Dialogue: 0,1:49:32.19,1:49:34.52,Default,,0,0,0,,Баратын жер...
Dialogue: 0,1:49:42.95,1:49:46.12,Default,,0,0,0,,Сондықтан да дыбыс өте жақсы резонанс жасады...
Dialogue: 0,1:49:55.88,1:49:57.00,Default,,0,0,0,,Ах... Юрико... Мұнда мен үшін орын жоқ па?
Dialogue: 0,1:49:57.09,1:49:59.05,Default,,0,0,0,,Нобита-кун мен ұмытып қалдым!
Dialogue: 0,1:49:59.13,1:50:01.51,Default,,0,0,0,,Жоқ, жоқ, кеттік!
Dialogue: 0,1:50:01.59,1:50:04.01,Default,,0,0,0,,Мүлдем
Dialogue: 0,1:50:15.56,1:50:17.40,Default,,0,0,0,,Микка-сама~!
Dialogue: 0,1:50:17.48,1:50:19.36,Default,,0,0,0,,Дәл қазір, профессор Венто
Dialogue: 0,1:50:19.44,1:50:21.94,Default,,0,0,0,,Мушикадан қашқан басқа кеменің сигналы.
Dialogue: 0,1:50:22.03,1:50:23.86,Default,,0,0,0,,Ол оны алғанын айтты!
Dialogue: 0,1:50:23.95,1:50:25.24,Default,,0,0,0,,Бізден басқа
Dialogue: 0,1:50:25.32,1:50:28.33,Default,,0,0,0,,Мушиканың адамдары әлі тірі еді!
Dialogue: 0,1:50:28.41,1:50:29.91,Default,,0,0,0,,Сол кездегі Фарре
Dialogue: 0,1:50:29.99,1:50:33.54,Default,,0,0,0,,Олар біздің бар екендігімізден хабардар етті!
Dialogue: 0,1:50:34.04,1:50:35.87,Default,,0,0,0,,Дыбыстық сигнал естілді!
Dialogue: 0,1:50:40.17,1:50:42.46,Default,,0,0,0,,Рахмет Нохохо...
Dialogue: 0,1:50:44.17,1:50:45.93,Default,,0,0,0,,Нобита аға!
Dialogue: 0,1:50:50.35,1:50:52.18,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:50:53.56,1:50:59.27,Default,,0,0,0,,(Диктофонның өнімділігі: «Диктофонның тапсырмасы»)
Dialogue: 0,1:51:15.12,1:51:17.83,Default,,0,0,0,,(«жоқ» дыбысы)
Dialogue: 0,1:51:20.84,1:51:25.84,Default,,0,0,0,,♪～
Dialogue: 0,1:55:02.52,1:55:07.52,Default,,0,0,0,,～♪
