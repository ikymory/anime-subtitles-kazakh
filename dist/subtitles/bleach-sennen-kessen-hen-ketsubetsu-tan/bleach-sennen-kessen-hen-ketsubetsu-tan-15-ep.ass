Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.54,0:00:04.71,Default,,0,0,0,,Ұрланған Банкаймен
Dialogue: 0,0:00:04.79,0:00:06.92,Default,,0,0,0,,Капитанды өлтіріңіз...
Dialogue: 0,0:00:07.00,0:00:09.17,Default,,0,0,0,,Оның мақсаты қандай?
Dialogue: 0,0:00:10.26,0:00:14.59,Default,,0,0,0,,) Бейтараптандырылған Шинигамиге қасиетті солдат (Золдат) жеткілікті емес пе?
Dialogue: 0,0:00:15.22,0:00:17.18,Default,,0,0,0,,Әлі де алып кететін нәрсе бар
Dialogue: 0,0:00:20.18,0:00:21.31,Default,,0,0,0,,Үміт
Dialogue: 0,0:00:22.39,0:00:24.89,Default,,0,0,0,,Банкай ұрланған капитандар
Dialogue: 0,0:00:24.98,0:00:26.65,Default,,0,0,0,,Банкайсыз аз уақыт болса да
Dialogue: 0,0:00:26.73,0:00:29.52,Default,,0,0,0,,Менің ойымша, сіз күресуді үйренесіз.
Dialogue: 0,0:00:29.61,0:00:31.32,Default,,0,0,0,,Мәртебелі қарап тұр
Dialogue: 0,0:00:31.40,0:00:34.95,Default,,0,0,0,,Банкай болмаса да, сен бізді жеңе аласың.
Dialogue: 0,0:00:35.53,0:00:38.49,Default,,0,0,0,,Егер бәрі жақсы болса, Банкайыңызды қайтарып алуыңыз мүмкін.
Dialogue: 0,0:00:39.03,0:00:43.08,Default,,0,0,0,,Бірегей мүмкіндікке сенетін жүрек
Dialogue: 0,0:00:43.16,0:00:45.54,Default,,0,0,0,,Бұл өлім құдайларының панасы.
Dialogue: 0,0:00:46.04,0:00:49.17,Default,,0,0,0,,Занпакутомен үміт жойылды.
Dialogue: 0,0:00:49.25,0:00:54.51,Default,,0,0,0,,Өлім құдайларының денелері мен жүректеріне шынайы жеңілістерді бейнелеңіз.
Dialogue: 0,0:00:55.30,0:00:57.68,Default,,0,0,0,,Бұл ұлы мәртебелі қалауынан басқа ештеңе емес.
Dialogue: 0,0:00:58.18,0:01:01.43,Default,,0,0,0,,Өте нашар және көңілді көрінеді
Dialogue: 0,0:01:01.51,0:01:02.68,Default,,0,0,0,,Хмф!
Dialogue: 0,0:01:02.77,0:01:06.64,Default,,0,0,0,,Иттерді және басқа иттерді тапқан бойда оларды өлтіріңіз.
Dialogue: 0,0:01:07.69,0:01:09.48,Default,,0,0,0,,Соңғы рет
Dialogue: 0,0:01:09.56,0:01:11.65,Default,,0,0,0,,Мәртебеліден бұйрықтарды жеткізу
Dialogue: 0,0:01:14.03,0:01:17.16,Default,,0,0,0,,«Барлық жау күштерін бірден жойыңыз»
Dialogue: 0,0:01:18.49,0:01:20.49,Default,,0,0,0,,♪～
Dialogue: 0,0:02:45.54,0:02:47.54,Default,,0,0,0,,～♪
Dialogue: 0,0:02:50.16,0:02:51.92,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:02:52.42,0:02:53.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:53.96,0:02:55.71,Default,,0,0,0,,Капитан: Бұл қиын!
Dialogue: 0,0:02:56.34,0:02:57.46,Default,,0,0,0,,Сейрейтей!
Dialogue: 0,0:02:57.55,0:02:58.84,Default,,0,0,0,,Капитан Укитаке!
Dialogue: 0,0:02:58.92,0:03:01.30,Default,,0,0,0,,Капитан Укитаке!
Dialogue: 0,0:03:03.64,0:03:04.97,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:03:05.72,0:03:09.60,Default,,0,0,0,,Мен олар бәрібір кенет тағы шабуыл жасайды деп ойладым.
Dialogue: 0,0:03:09.68,0:03:12.69,Default,,0,0,0,,Сот ішінде небір қулықтар болды...
Dialogue: 0,0:03:13.44,0:03:17.78,Default,,0,0,0,,Біздің артықшылығымыз осылай жойылады деп ешқашан күткен емеспін.
Dialogue: 0,0:03:19.44,0:03:20.95,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:03:21.03,0:03:23.57,Default,,0,0,0,,Мың жыл бұрын шайқаста жеңілген
Dialogue: 0,0:03:23.66,0:03:27.45,Default,,0,0,0,,Баратын жерімді жоғалтты, менің жойғышым (Квинси) бұл дүниені тастап кетті.
Dialogue: 0,0:03:27.54,0:03:30.83,Default,,0,0,0,,Сіз Шинигами ең қырағы болдыңыз...
Dialogue: 0,0:03:30.91,0:03:33.96,Default,,0,0,0,,Сейрейтейге қашып кетті
Dialogue: 0,0:03:34.04,0:03:37.84,Default,,0,0,0,,Ал Сейрейтейдің әр көлеңкесінде
Dialogue: 0,0:03:37.92,0:03:40.47,Default,,0,0,0,,Рухани балалармен кеңістік құру
Dialogue: 0,0:03:40.55,0:03:47.31,Default,,0,0,0,,Осылайша ол Ванденрейх «көрінбейтін империя» деп аталды.
Dialogue: 0,0:03:47.81,0:03:49.06,Default,,0,0,0,,Тәтті... Тәтті!
Dialogue: 0,0:03:49.14,0:03:50.10,Default,,0,0,0,,Қысқаша айтқанда!?
Dialogue: 0,0:03:50.18,0:03:52.98,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,0:03:53.06,0:03:55.10,Default,,0,0,0,,Жоспар өте сәтті болды.
Dialogue: 0,0:03:55.19,0:03:55.81,Default,,0,0,0,,А...
Dialogue: 0,0:03:55.90,0:03:58.23,Default,,0,0,0,,Өйткені, бұл дүниеге ұқсамайды
Dialogue: 0,0:03:58.32,0:04:00.49,Default,,0,0,0,,Біздің күш-қуатымыздың бастауы болып табылатын рухани перзент
Dialogue: 0,0:04:00.57,0:04:04.82,Default,,0,0,0,,Жан қоғамының толып кеткені сонша, жиіркенішті.
Dialogue: 0,0:04:04.91,0:04:07.58,Default,,0,0,0,,Істеуге болатын нәрседе шек болмады.
Dialogue: 0,0:04:08.16,0:04:13.83,Default,,0,0,0,,Көлеңкеде күш жинап, мың жылды бос өткіздік.
Dialogue: 0,0:04:16.25,0:04:19.30,Default,,0,0,0,,Басқаша айтқанда, біз өткен жолы да, осы жолы да
Dialogue: 0,0:04:19.38,0:04:23.55,Default,,0,0,0,,Олар жанын қорғайтын қабығын бұзып Сейрейтейді басып алған жоқ.
Dialogue: 0,0:04:24.05,0:04:26.97,Default,,0,0,0,,Ол қазірдің өзінде жанды қорғайтын қабықшаның ішінде болды.
Dialogue: 0,0:04:28.89,0:04:32.56,Default,,0,0,0,,Қош келдіңіз, құнды ақпаратыңыз үшін рахмет.
Dialogue: 0,0:04:33.06,0:04:36.23,Default,,0,0,0,,Көшбасшы бөлмесі тұрған жерге тез жетеді.
Dialogue: 0,0:04:36.73,0:04:40.27,Default,,0,0,0,,Жаудың жеткілікті қабілетті мүшелері бар сияқты.
Dialogue: 0,0:04:40.36,0:04:43.03,Default,,0,0,0,,Көрінбейтін империя (Ванденрейх) императордың көмекшісі
Dialogue: 0,0:04:43.11,0:04:45.20,Default,,0,0,0,,Қасиетті Крест рыцарлары (Sternritter) Ең жоғары дәреже (Гранд Мастер)
Dialogue: 0,0:04:45.70,0:04:47.37,Default,,0,0,0,,Эуграм Хашвальд
Dialogue: 0,0:04:47.87,0:04:50.91,Default,,0,0,0,,Он үш Готей корпусының қолбасшысы
Dialogue: 0,0:04:50.99,0:04:54.25,Default,,0,0,0,,Бұл Шунсуй Кёраку, бірінші жасақтың капитаны.
Dialogue: 0,0:04:54.83,0:04:57.79,Default,,0,0,0,,Мен келгеннен бері сіз мұны білмейтініңізге сенімдімін.
Dialogue: 0,0:04:58.29,0:05:02.17,Default,,0,0,0,,Немесе сіз мұнда келетініңізді білесіз бе?
Dialogue: 0,0:05:02.26,0:05:05.51,Default,,0,0,0,,Аа, мен мұнда бірінші келген себебім.
Dialogue: 0,0:05:05.59,0:05:07.34,Default,,0,0,0,,Бұл шыдамсыз оқиға.
Dialogue: 0,0:05:07.84,0:05:11.39,Default,,0,0,0,,Мың жыл күткен шайқастан ләззат алғың келмей ме?
Dialogue: 0,0:05:12.31,0:05:14.64,Default,,0,0,0,,Мәртебелі бейбітшілік сүйгіш
Dialogue: 0,0:05:15.14,0:05:18.77,Default,,0,0,0,,Сіз шайқас неғұрлым қысқа болса, соғұрлым жақсы деп ойлайсыз.
Dialogue: 0,0:05:19.86,0:05:22.48,Default,,0,0,0,,Сондықтан бір бұйрық беріледі.
Dialogue: 0,0:05:23.78,0:05:26.61,Default,,0,0,0,,«Барлық жау күштерін бірден жойыңыз»
Dialogue: 0,0:05:27.91,0:05:29.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:30.12,0:05:31.78,Default,,0,0,0,,Сен несін... білмей тұрып!
Dialogue: 0,0:05:31.87,0:05:33.12,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:33.20,0:05:36.33,Default,,0,0,0,,Эй, эй Түсіндіру Сіз мұны естіген жоқсыз ба?
Dialogue: 0,0:05:36.41,0:05:38.83,Default,,0,0,0,,Әлде бұл Технологияларды дамыту бюросы ма?
Dialogue: 0,0:05:38.92,0:05:41.54,Default,,0,0,0,,Ақылды көрінетін есім ғана ма?
Dialogue: 0,0:05:41.63,0:05:44.01,Default,,0,0,0,,Бір жерден келген жоқ.
Dialogue: 0,0:05:44.09,0:05:46.55,Default,,0,0,0,,Мен басынан бері осындамын.
Dialogue: 0,0:05:46.63,0:05:48.51,Default,,0,0,0,,Қарғыс атсын... Дұрыс.
Dialogue: 0,0:05:48.59,0:05:49.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:49.47,0:05:50.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:56.52,0:06:00.02,Default,,0,0,0,,Сіз Квинсилер көлеңкеде болдыңыз.
Dialogue: 0,0:06:00.81,0:06:04.36,Default,,0,0,0,,Екі дүние бір жерде бір уақытта өмір сүрсе
Dialogue: 0,0:06:04.44,0:06:07.15,Default,,0,0,0,,Біз бір-бірімізге қол тигізбедік
Dialogue: 0,0:06:07.24,0:06:11.91,Default,,0,0,0,,Әй... көлеңкеде дүние жасау, т.б.
Dialogue: 0,0:06:11.99,0:06:15.20,Default,,0,0,0,,Бұл өте ақылсыз оқиға.
Dialogue: 0,0:06:15.70,0:06:16.87,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:17.91,0:06:21.17,Default,,0,0,0,,Мен ақылсыз нәрселерді ұнатпаймын.
Dialogue: 0,0:06:21.25,0:06:24.30,Default,,0,0,0,,Та... Капитан, бұл түрі...
Dialogue: 0,0:06:24.96,0:06:28.01,Default,,0,0,0,,Өткен күнгі шайқас кезінде жиналған ақпаратпен.
Dialogue: 0,0:06:28.09,0:06:32.05,Default,,0,0,0,,Көлеңкелер Квинси шабуылына қатысқанға дейін.
Dialogue: 0,0:06:32.14,0:06:33.89,Default,,0,0,0,,Болжалды болды
Dialogue: 0,0:06:35.10,0:06:37.81,Default,,0,0,0,,Сонымен, менің зертханамның ішінде,
Dialogue: 0,0:06:37.89,0:06:42.31,Default,,0,0,0,,Мен оны көлеңке түсірмейтіндей етіп өзгерттім.
Dialogue: 0,0:06:42.40,0:06:46.90,Default,,0,0,0,,Енді, шынында да, ақылды деген атау ғана ма?
Dialogue: 0,0:06:46.98,0:06:49.65,Default,,0,0,0,,Неге тексеріп, үйге жібермейсің?
Dialogue: 0,0:06:50.78,0:06:52.20,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:06:58.04,0:07:00.67,Default,,0,0,0,,Қарғыс атсын... (Шинигами) Өтпесін! Оның өтуіне жол бермеңіз!
Dialogue: 0,0:07:00.75,0:07:01.37,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:01.46,0:07:04.88,Default,,0,0,0,,Ха, «өтпесін» деген не керек ақымақ!
Dialogue: 0,0:07:04.96,0:07:07.51,Default,,0,0,0,,Шабуыл аяқталды.
Dialogue: 0,0:07:08.71,0:07:11.68,Default,,0,0,0,,Сіз бізді өткізе алмайсыз немесе жібере алмайсыз.
Dialogue: 0,0:07:11.76,0:07:13.47,Default,,0,0,0,,Балалар келесіге барыңдар.
Dialogue: 0,0:07:13.55,0:07:14.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:14.26,0:07:16.26,Default,,0,0,0,,Пісіру...
Dialogue: 0,0:07:16.35,0:07:16.85,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:19.48,0:07:20.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.43,0:07:21.10,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:21.19,0:07:25.02,Default,,0,0,0,,Өтетін де, өтпейтін де рас.
Dialogue: 0,0:07:25.52,0:07:26.02,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:26.77,0:07:29.40,Default,,0,0,0,,Сіздің жалыныңыз өтпеді.
Dialogue: 0,0:07:30.11,0:07:31.78,Default,,0,0,0,,А...
Dialogue: 0,0:07:32.36,0:07:33.24,Default,,0,0,0,,О!
Dialogue: 0,0:07:33.32,0:07:36.16,Default,,0,0,0,,Не? Не? Кім екенін ойласам, есіме түсті.
Dialogue: 0,0:07:36.24,0:07:41.37,Default,,0,0,0,,Банкайды Цанг Тудан бейбақ ұрлап кеткен мұз капитаны емес пе?
Dialogue: 0,0:07:41.87,0:07:45.67,Default,,0,0,0,,Бұл Тосиро Хицугая, 10-шы дивизияның командирі.
Dialogue: 0,0:07:45.75,0:07:49.55,Default,,0,0,0,,Стернритер «H» The Heat Busbee
Dialogue: 0,0:07:51.63,0:07:54.64,Default,,0,0,0,,Біз жақсы сәйкестік сияқтымыз, солай емес пе?
Dialogue: 0,0:07:54.72,0:07:56.26,Default,,0,0,0,,Көп!
Dialogue: 0,0:07:57.31,0:07:58.47,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:59.97,0:08:01.48,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:08:01.56,0:08:03.39,Default,,0,0,0,,(Изуку) Токоями! (Қара көлеңке) Ой!
Dialogue: 0,0:08:03.48,0:08:05.98,Default,,0,0,0,,Неліктен сарай жоғалып кетті...
Dialogue: 0,0:08:07.77,0:08:08.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:08.73,0:08:09.90,Default,,0,0,0,,Аға
Dialogue: 0,0:08:10.53,0:08:12.53,Default,,0,0,0,,Өтінемін, барма.
Dialogue: 0,0:08:12.61,0:08:14.86,Default,,0,0,0,,Киё қорқынышты
Dialogue: 0,0:08:15.49,0:08:18.41,Default,,0,0,0,,Осы жерде қалуыңызды өтінемін.
Dialogue: 0,0:08:20.58,0:08:22.54,Default,,0,0,0,,Жоқ, мен барамын.
Dialogue: 0,0:08:23.04,0:08:24.92,Default,,0,0,0,,А... ағайын.
Dialogue: 0,0:08:25.50,0:08:29.25,Default,,0,0,0,,Киё... Ақылды Киё болсаң, түсінесің.
Dialogue: 0,0:08:29.75,0:08:34.43,Default,,0,0,0,,Мен сені қорқыту үшін Киёны тастап кетпеймін.
Dialogue: 0,0:08:35.09,0:08:40.68,Default,,0,0,0,,Өз болашағыңды қорға, Сабуро, әпкең, әкең мен анаңды қорға.
Dialogue: 0,0:08:40.77,0:08:44.06,Default,,0,0,0,,Көршілері Гондахара-сан мен Канемицу-санды да қорға.
Dialogue: 0,0:08:44.14,0:08:49.82,Default,,0,0,0,,Ал Сейрейтейді қорғау үшін ағам бару керек.
Dialogue: 0,0:08:50.73,0:08:52.07,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:08:52.65,0:08:56.41,Default,,0,0,0,,Өйткені менің ағам Готей 13 корпусының мүшесі.
Dialogue: 0,0:08:56.49,0:08:57.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:58.07,0:09:02.33,Default,,0,0,0,,Эй, бұл бетті жасама. Мен аман-есен ораламын.
Dialogue: 0,0:09:02.41,0:09:03.20,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:03.29,0:09:04.08,Default,,0,0,0,,Ха! (Омаэда) Иә?
Dialogue: 0,0:09:06.62,0:09:08.04,Default,,0,0,0,,Сен, жексұрын!
Dialogue: 0,0:09:08.13,0:09:11.17,Default,,0,0,0,,Мен қанішер ара капитанынан Банкайды ұрлап алдым...
Dialogue: 0,0:09:25.81,0:09:28.06,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:09:28.56,0:09:29.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:30.40,0:09:32.65,Default,,0,0,0,,Бәрің де артта тұрып, басқа күзетшілерді қорғаңдар!
Dialogue: 0,0:09:32.73,0:09:33.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:36.65,0:09:38.49,Default,,0,0,0,,Он үшінші өлім!
Dialogue: 0,0:09:38.57,0:09:41.20,Default,,0,0,0,,Бұл жұқа мұз! Эй!
Dialogue: 0,0:09:41.28,0:09:45.04,Default,,0,0,0,,Неге түкке тұрғысыз қарсылығыңызды тоқтатып, жаныңызды сұрамайсыз?
Dialogue: 0,0:09:45.12,0:09:48.46,Default,,0,0,0,,Өмірің үшін қайыр сұрау жеңген тараптың ісі ме?
Dialogue: 0,0:09:48.54,0:09:51.92,Default,,0,0,0,,Сен айтпайсың ба...Ио!
Dialogue: 0,0:09:53.96,0:09:54.92,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:09:55.01,0:09:56.55,Default,,0,0,0,,Кешіріңіз, мен сұрадым.
Dialogue: 0,0:09:56.63,0:10:00.18,Default,,0,0,0,,Мен күткендей, өзімді басқару әлі қиын.
Dialogue: 0,0:10:01.80,0:10:02.47,Default,,0,0,0,,Не?
Dialogue: 0,0:10:02.97,0:10:04.35,Default,,0,0,0,,Жоқ~
Dialogue: 0,0:10:04.43,0:10:09.02,Default,,0,0,0,,Міне, мен Банкайды жоғалтып алдым. Мұның бәрі жаман емес.
Dialogue: 0,0:10:09.10,0:10:10.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:10.19,0:10:13.07,Default,,0,0,0,,Өйткені капитан маған арқа сүйейді.
Dialogue: 0,0:10:13.15,0:10:13.86,Default,,0,0,0,,Ка~вай!
Dialogue: 0,0:10:13.94,0:10:15.28,Default,,0,0,0,,Жоқ... Мацумото!
Dialogue: 0,0:10:15.36,0:10:17.86,Default,,0,0,0,,Иә, иә, кеттік.
Dialogue: 0,0:10:18.36,0:10:20.11,Default,,0,0,0,,Айқай Хайнеко!
Dialogue: 0,0:10:20.95,0:10:23.87,Default,,0,0,0,,Кеттік! Миль-фель операциясы!
Dialogue: 0,0:10:23.95,0:10:26.58,Default,,0,0,0,,Операцияны бұлай атағаным есімде жоқ!
Dialogue: 0,0:10:26.66,0:10:30.08,Default,,0,0,0,,Не? Өйткені, бұл мұз қабырғасы ғана емес пе?
Dialogue: 0,0:10:30.17,0:10:31.50,Default,,0,0,0,,Хайнеко үйі!
Dialogue: 0,0:10:31.58,0:10:34.17,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:10:38.34,0:10:39.88,Default,,0,0,0,,Оның еріп кетуіне жол бермеңіз!
Dialogue: 0,0:10:39.97,0:10:42.85,Default,,0,0,0,,«Миль-фель» операциясы өте сәтті өтті!
Dialogue: 0,0:10:42.93,0:10:44.35,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:44.43,0:10:47.10,Default,,0,0,0,,Қан алу қызметі туралы айтайын.
Dialogue: 0,0:10:47.68,0:10:52.19,Default,,0,0,0,,Біріншіден, мен Хайнеко күлімнен өте жұқа қабырғаларды жасаймын.
Dialogue: 0,0:10:52.69,0:10:56.28,Default,,0,0,0,,Оның бетін капитанның жұқа мұз қабырғасымен жабыңыз.
Dialogue: 0,0:10:56.78,0:10:59.07,Default,,0,0,0,,Үш екі бір мияу!
Dialogue: 0,0:10:59.57,0:11:02.62,Default,,0,0,0,,Хайнеко семсерге қайтарылса, бұл керемет болар еді!
Dialogue: 0,0:11:02.70,0:11:06.49,Default,,0,0,0,,Вакуумдық қабаты бар мұз миль-фелье дайын!
Dialogue: 0,0:11:06.58,0:11:08.58,Default,,0,0,0,,Термос сияқты механизм... (Хисугая) Бұл вакуумды көп қабатты мұз қабырғасы.
Dialogue: 0,0:11:08.66,0:11:11.83,Default,,0,0,0,,Сонымен вакуумдық қабат жылуды өткізбеді.
Dialogue: 0,0:11:13.71,0:11:18.17,Default,,0,0,0,,Менің Хёринмаруым капитан деңгейіндегі Занпакуто болуы мүмкін.
Dialogue: 0,0:11:18.26,0:11:22.26,Default,,0,0,0,,Бұл Шикай мен Банкайдың қабілеттері бойынша ең аз айырмашылығы бар Занпакуто.
Dialogue: 0,0:11:22.89,0:11:24.72,Default,,0,0,0,,Бұл жай ғана
Dialogue: 0,0:11:24.80,0:11:28.52,Default,,0,0,0,,Шығаруға болатын мұз мөлшері өте аз.
Dialogue: 0,0:11:29.10,0:11:30.39,Default,,0,0,0,,Оның орнын толтыру
Dialogue: 0,0:11:30.48,0:11:33.77,Default,,0,0,0,,Мен аз мұзбен күресуді үйрендім.
Dialogue: 0,0:11:34.73,0:11:37.15,Default,,0,0,0,,Сіздікіндей жалынды қалай болдырмауға болады
Dialogue: 0,0:11:37.23,0:11:39.65,Default,,0,0,0,,Бұл дұрыс сияқты.
Dialogue: 0,0:11:39.74,0:11:41.20,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:11:44.32,0:11:46.33,Default,,0,0,0,,Өтпейді дедім ғой.
Dialogue: 0,0:11:46.41,0:11:47.16,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:47.66,0:11:48.49,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:11:50.58,0:11:54.25,Default,,0,0,0,,Вакуумды мұз қалақшасымен кесіңіз
Dialogue: 0,0:11:57.25,0:11:58.13,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:05.64,0:12:08.97,Default,,0,0,0,,Банкай болмаса да, Квинсимен және басқалармен бәсекелесуге болады.
Dialogue: 0,0:12:09.06,0:12:10.73,Default,,0,0,0,,Сіз мұны дәлелдедіңіз.
Dialogue: 0,0:12:13.85,0:12:15.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:25.66,0:12:26.91,Default,,0,0,0,,Ақ қабырға
Dialogue: 0,0:12:27.53,0:12:29.66,Default,,0,0,0,,Квинси билігіне басып кіру
Dialogue: 0,0:12:29.74,0:12:33.04,Default,,0,0,0,,Бұл уақытша, бірақ толық кедергі.
Dialogue: 0,0:12:33.12,0:12:37.17,Default,,0,0,0,,Нанао Исэ, бірінші отрядтың вице-капитанының көмекшісі
Dialogue: 0,0:12:37.71,0:12:39.50,Default,,0,0,0,,Бұл сіз жасаған онидо ма?
Dialogue: 0,0:12:39.59,0:12:41.84,Default,,0,0,0,,Сіз мені танитын сияқтысыз.
Dialogue: 0,0:12:42.34,0:12:45.43,Default,,0,0,0,,Мен тек кидоға қабілетім үшін вице-капитан болып тағайындалдым.
Dialogue: 0,0:12:45.51,0:12:47.43,Default,,0,0,0,,Жалғызсың деме
Dialogue: 0,0:12:47.51,0:12:49.56,Default,,0,0,0,,Бұлай жын жолын жасау мүмкін емес.
Dialogue: 0,0:12:49.64,0:12:50.93,Default,,0,0,0,,Түсіндірме жоқ
Dialogue: 0,0:12:51.02,0:12:55.56,Default,,0,0,0,,Жақында болған шапқыншылық кезінде Сейрейтейде реиацу іздері шашылып қалды.
Dialogue: 0,0:12:55.64,0:12:57.06,Default,,0,0,0,,Бұл сәтсіздік болды.
Dialogue: 0,0:12:57.15,0:13:01.03,Default,,0,0,0,,Бұл бізге шара қолдануды айтқанмен бірдей.
Dialogue: 0,0:13:02.94,0:13:04.99,Default,,0,0,0,,Арх... Арх!
Dialogue: 0,0:13:05.07,0:13:06.36,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:13:06.45,0:13:07.87,Default,,0,0,0,,Уф... Киё
Dialogue: 0,0:13:08.66,0:13:12.37,Default,,0,0,0,,То... Менің ағам жақсы. Жасыру!
Dialogue: 0,0:13:13.29,0:13:13.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:13.95,0:13:17.17,Default,,0,0,0,,Сіздің жасақ жетекшісі қайда?
Dialogue: 0,0:13:17.25,0:13:20.50,Default,,0,0,0,,Бұл менің үшінші сұрағым. Жауап күтемін.
Dialogue: 0,0:13:20.59,0:13:23.59,Default,,0,0,0,,Сіз ақымақсыз ба? Сіз шынымен білмейсіз.
Dialogue: 0,0:13:23.67,0:13:26.05,Default,,0,0,0,,Мендей жақсы біреу білсе де
Dialogue: 0,0:13:26.13,0:13:27.93,Default,,0,0,0,,Капитанның жеңіліп қалуы мүмкін емес.
Dialogue: 0,0:13:28.01,0:13:29.09,Default,,0,0,0,,Оны жасырмаңыз!
Dialogue: 0,0:13:29.18,0:13:31.26,Default,,0,0,0,,Бұл жауап беруден үшінші бас тарту.
Dialogue: 0,0:13:31.35,0:13:33.97,Default,,0,0,0,,Сұрақ әдісін өзгерту
Dialogue: 0,0:13:34.06,0:13:34.93,Default,,0,0,0,,А...
Dialogue: 0,0:13:35.43,0:13:36.14,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:36.89,0:13:37.81,Default,,0,0,0,,Ааах…
Dialogue: 0,0:13:37.90,0:13:38.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:40.94,0:13:42.48,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:13:42.57,0:13:43.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:43.82,0:13:48.07,Default,,0,0,0,,Мен Киёге тіпті сызат түсіруге жол бермеймін.
Dialogue: 0,0:13:54.08,0:13:56.87,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:56.96,0:13:58.83,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:13:59.75,0:14:00.38,Default,,0,0,0,,Хмм!
Dialogue: 0,0:14:01.25,0:14:04.96,Default,,0,0,0,,Мен Квинси садақ пен жебені пайдаланады деп ойладым, бірақ...
Dialogue: 0,0:14:06.80,0:14:09.80,Default,,0,0,0,,Бұл менің естігенімнен әлдеқайда мәдениетті.
Dialogue: 0,0:14:10.64,0:14:13.26,Default,,0,0,0,,Датчикке реакция болған жоқ.
Dialogue: 0,0:14:13.35,0:14:16.31,Default,,0,0,0,,Сіздің ойыңызша, жасырын маневрлер реиацуды жоя алмайды ма?
Dialogue: 0,0:14:16.39,0:14:21.69,Default,,0,0,0,,Тоғызыншы буын Хачие екінші дивизиясының командирі жасырын ұтқырлық қолбасшысы
Dialogue: 0,0:14:21.77,0:14:23.07,Default,,0,0,0,,Араларды ұсақтау
Dialogue: 0,0:14:23.15,0:14:24.86,Default,,0,0,0,,Бұл неге ұқсайды?
Dialogue: 0,0:14:25.36,0:14:26.40,Default,,0,0,0,,«Не?»
Dialogue: 0,0:14:26.94,0:14:31.57,Default,,0,0,0,,Осы ақпараттың барлығына қарамастан, сіз бұл санның не екенін сұрайсыз ба?
Dialogue: 0,0:14:32.16,0:14:33.41,Default,,0,0,0,,Шункан
Dialogue: 0,0:14:33.49,0:14:35.08,Default,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:14:35.16,0:14:35.79,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:35.87,0:14:40.21,Default,,0,0,0,,«Соңғы рет шайқасқанымызда аяқталмаған болуы керек»?
Dialogue: 0,0:14:43.21,0:14:47.34,Default,,0,0,0,,Бұл қысқа уақыт ішінде техниканы жетілдіргеніңізді білдіре ме?
Dialogue: 0,0:14:47.42,0:14:48.17,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:49.26,0:14:50.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:53.10,0:14:54.97,Default,,0,0,0,,Мукю Шуннан
Dialogue: 0,0:14:56.93,0:14:58.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:58.93,0:15:01.60,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:01.69,0:15:04.57,Default,,0,0,0,,Ммммммммм
Dialogue: 0,0:15:05.61,0:15:06.98,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:07.57,0:15:09.95,Default,,0,0,0,,Бұл сізге көп уақыт алатын сияқты.
Dialogue: 0,0:15:10.03,0:15:11.91,Default,,0,0,0,,Тоқта және тоқта
Dialogue: 0,0:15:11.99,0:15:14.95,Default,,0,0,0,,Уақыт қажет дегенді қалай түсінесіз?
Dialogue: 0,0:15:15.03,0:15:16.74,Default,,0,0,0,,Өлту үшін
Dialogue: 0,0:15:16.83,0:15:19.79,Default,,0,0,0,,Байқауға болатын үлгілер көп болуы мүмкін.
Dialogue: 0,0:15:19.87,0:15:23.63,Default,,0,0,0,,Мен мұндай бөлшектерге өте нашармын.
Dialogue: 0,0:15:23.71,0:15:25.84,Default,,0,0,0,,Тез орында, соңы жақсы.
Dialogue: 0,0:15:25.92,0:15:27.88,Default,,0,0,0,,Мұны басқа біреумен істеу керек.
Dialogue: 0,0:15:28.51,0:15:29.63,Default,,0,0,0,,Сожа
Dialogue: 0,0:15:34.01,0:15:35.85,Default,,0,0,0,,Менің артымнан келмейсің бе?
Dialogue: 0,0:15:35.93,0:15:39.18,Default,,0,0,0,,Сіз қайда барасыз?
Dialogue: 0,0:15:39.27,0:15:42.65,Default,,0,0,0,,Маған да сіздің реиатсуыңызды талдауға уақыт керек.
Dialogue: 0,0:15:43.15,0:15:44.56,Default,,0,0,0,,Әлде бір нәрсе ме?
Dialogue: 0,0:15:44.65,0:15:48.94,Default,,0,0,0,,Сіз мені өз территорияңызға кіргенімді қалайсыз деп әдейі арандатып жатырсыз ба?
Dialogue: 0,0:15:49.44,0:15:51.20,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:15:51.28,0:15:54.32,Default,,0,0,0,,Қабілетімді соншалықты немқұрайлы көрсетпегеніме қуаныштымын.
Dialogue: 0,0:15:54.41,0:15:55.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:56.41,0:15:58.99,Default,,0,0,0,,Бұл рейатсу... Бұл ара шабуылы ма?
Dialogue: 0,0:15:59.08,0:16:00.04,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:16:00.12,0:16:02.46,Default,,0,0,0,,Жауды Банкайсыз басып бара жатқан сияқты!
Dialogue: 0,0:16:02.54,0:16:04.46,Default,,0,0,0,,Ақыр соңында?
Dialogue: 0,0:16:04.54,0:16:07.04,Default,,0,0,0,,Мәртебелі күткендей.
Dialogue: 0,0:16:08.17,0:16:11.05,Default,,0,0,0,,Сіз бұл сөздердің мағынасын білесіз бе?
Dialogue: 0,0:16:11.13,0:16:13.63,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:16:15.26,0:16:19.10,Default,,0,0,0,,Сіз әлі де өлімшісіз.
Dialogue: 0,0:16:26.40,0:16:30.40,Default,,0,0,0,,Әлгі Рейацу... Мұны капитан Сабай да жасаған сияқты.
Dialogue: 0,0:16:30.48,0:16:34.41,Default,,0,0,0,,Капитан Басқа капитандарға қосылғың келе ме?
Dialogue: 0,0:16:34.49,0:16:35.91,Default,,0,0,0,,Эй, эй (Хисугая) Ха!
Dialogue: 0,0:16:35.99,0:16:38.87,Default,,0,0,0,,Жалғызбын демейсің бе?
Dialogue: 0,0:16:38.95,0:16:43.50,Default,,0,0,0,,Сен мені тергеудің ортасында қалдырып, басқа жаққа кетесің бе?
Dialogue: 0,0:16:43.58,0:16:46.96,Default,,0,0,0,,Біз әлі ұрысқан жоқпыз!
Dialogue: 0,0:16:57.26,0:16:58.22,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:59.39,0:17:00.60,Default,,0,0,0,,Иә
Dialogue: 0,0:17:01.77,0:17:05.64,Default,,0,0,0,,«Сіздікіндей жалынның алдын алу үшін?» Дедіңіз бе?
Dialogue: 0,0:17:05.73,0:17:09.44,Default,,0,0,0,,Менде қазір Банкайдың жоқтығы ұят.
Dialogue: 0,0:17:09.52,0:17:13.19,Default,,0,0,0,,Банкай мұзыңыз қанша болса, саусақтарыңыз да жеткілікті.
Dialogue: 0,0:17:13.28,0:17:15.49,Default,,0,0,0,,Мен сізге көрсете алар едім.
Dialogue: 0,0:17:17.74,0:17:18.41,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:18.49,0:17:20.16,Default,,0,0,0,,Ол келмейді.
Dialogue: 0,0:17:20.24,0:17:23.12,Default,,0,0,0,,Артқа тұрыңыз, Мацумото! қайта топтастыру
Dialogue: 0,0:17:23.20,0:17:25.21,Default,,0,0,0,,Мен Аяжин мұз қабырғасына тоқтаймын!
Dialogue: 0,0:17:25.29,0:17:26.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:27.50,0:17:30.34,Default,,0,0,0,,Бұл жұқа тоқылған мұздан жасалған мұз қабырғасы ма?
Dialogue: 0,0:17:30.92,0:17:34.13,Default,,0,0,0,,Бірақ бұл мұзбен не істейтінім маңызды емес...
Dialogue: 0,0:17:34.97,0:17:37.22,Default,,0,0,0,,Бір саусақ
Dialogue: 0,0:17:38.34,0:17:40.01,Default,,0,0,0,,Оттық саусақ 1!
Dialogue: 0,0:17:44.85,0:17:45.81,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:17:54.61,0:17:55.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:56.40,0:17:57.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:06.16,0:18:08.58,Default,,0,0,0,,Әлі де дем аласың ба, құбыжық?
Dialogue: 0,0:18:11.13,0:18:14.05,Default,,0,0,0,,Тыныс деген ұғым жоқ.
Dialogue: 0,0:18:16.47,0:18:17.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:17.59,0:18:19.59,Default,,0,0,0,,Мукю Шуннан
Dialogue: 0,0:18:19.68,0:18:22.76,Default,,0,0,0,,Өте мағыналы деректер ретінде алынды
Dialogue: 0,0:18:23.26,0:18:25.27,Default,,0,0,0,,Бірақ менің де көңілім қалды.
Dialogue: 0,0:18:25.35,0:18:26.48,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:18:26.56,0:18:29.98,Default,,0,0,0,,Мен сізден алған Банкайды пайдаланудың қажеті жоқ.
Dialogue: 0,0:18:32.98,0:18:34.27,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:18:35.61,0:18:37.03,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:18:37.11,0:18:37.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:44.24,0:18:45.37,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:18:52.25,0:18:54.25,Default,,0,0,0,,Сізге тағы бір сұрақ қоюға рұқсат етіңіз.
Dialogue: 0,0:18:54.75,0:18:57.51,Default,,0,0,0,,Басқа капитандар бұл әдісті қолдана ала ма?
Dialogue: 0,0:18:58.42,0:18:59.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:00.13,0:19:03.39,Default,,0,0,0,,Техниканы жетілдіріп аяқтамайсың.
Dialogue: 0,0:19:03.47,0:19:07.56,Default,,0,0,0,,Олар оны барлығы пайдалана алғанша нақтылауы керек еді.
Dialogue: 0,0:19:08.56,0:19:12.94,Default,,0,0,0,,Осылайша, кем дегенде капитандар бұл біржақты түрде орындалмас еді.
Dialogue: 0,0:19:13.44,0:19:15.32,Default,,0,0,0,,Ол шайқаста өлетін еді
Dialogue: 0,0:19:17.73,0:19:21.11,Default,,0,0,0,,Ей, ей, ей, капитан болсаң да қашпа!
Dialogue: 0,0:19:21.61,0:19:22.32,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:22.41,0:19:24.66,Default,,0,0,0,,Ол келмейді деп ойлаймын!
Dialogue: 0,0:19:25.53,0:19:26.91,Default,,0,0,0,,Хе-хе-хе-хе-хе
Dialogue: 0,0:19:27.41,0:19:27.91,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:31.79,0:19:33.92,Default,,0,0,0,,Бұл жолы мұзды тұман ба?
Dialogue: 0,0:19:34.00,0:19:35.00,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:19:36.13,0:19:37.75,Default,,0,0,0,,Жанып тұрған төбе!
Dialogue: 0,0:19:38.42,0:19:38.96,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:39.46,0:19:41.26,Default,,0,0,0,,...Менің алдымда тұрма.
Dialogue: 0,0:19:41.34,0:19:45.22,Default,,0,0,0,,Тұман таралып жатқанда, жасырынып, стратегияңызды жоспарлаңыз.
Dialogue: 0,0:19:45.72,0:19:48.14,Default,,0,0,0,,Стратегияны жоспарлауға уақыт болмады.
Dialogue: 0,0:19:48.64,0:19:49.35,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:49.43,0:19:51.35,Default,,0,0,0,,Егер бұл тұзақ болса, мен оны қойдым.
Dialogue: 0,0:19:51.44,0:19:53.44,Default,,0,0,0,,А? Бұл не?
Dialogue: 0,0:19:53.94,0:19:55.73,Default,,0,0,0,,Рокуи мұздату түзілімі
Dialogue: 0,0:20:00.74,0:20:01.24,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:03.03,0:20:04.11,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:20:04.62,0:20:07.53,Default,,0,0,0,,«Бұл өтірік» менің жолым.
Dialogue: 0,0:20:07.62,0:20:11.00,Default,,0,0,0,,Мені ашуландырып, екіншісін қолдануға мәжбүрсіз бе?
Dialogue: 0,0:20:11.08,0:20:11.87,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:12.37,0:20:15.13,Default,,0,0,0,,Оттық саусақ 2!
Dialogue: 0,0:20:23.09,0:20:24.05,Default,,0,0,0,,Ал ең бастысы, Иносукэ, өзің қалайсың?
Dialogue: 0,0:20:27.18,0:20:29.43,Default,,0,0,0,,Тоқта, Базби.
Dialogue: 0,0:20:29.51,0:20:30.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:30.60,0:20:32.81,Default,,0,0,0,,Банкайды алып кеткен капитан
Dialogue: 0,0:20:32.89,0:20:35.77,Default,,0,0,0,,Оны ұрлаған адамға қалдыру туралы уәде болуы керек еді.
Dialogue: 0,0:20:36.61,0:20:38.44,Default,,0,0,0,,Мен сізге соңғы соққыны беремін
Dialogue: 0,0:20:39.57,0:20:40.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:40.23,0:20:43.11,Default,,0,0,0,,Шамамен екі Рейацу жоғалып кетті.
Dialogue: 0,0:20:43.20,0:20:46.07,Default,,0,0,0,,Иә, капитан Сайхоу мен капитан Хицугая...
Dialogue: 0,0:20:46.57,0:20:50.16,Default,,0,0,0,,Банқайсыз күресе алсаң
Dialogue: 0,0:20:50.24,0:20:52.29,Default,,0,0,0,,Мен сияқты үлкен бола ма?
Dialogue: 0,0:20:52.79,0:20:53.79,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:20:53.87,0:20:54.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:55.17,0:20:56.96,Default,,0,0,0,,Ах, жалғанған, жалғанған
Dialogue: 0,0:20:57.04,0:20:57.75,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:20:57.83,0:21:00.92,Default,,0,0,0,,Сәлем, бұл мен, Урахара.
Dialogue: 0,0:21:01.51,0:21:04.26,Default,,0,0,0,,Банкайды қайтару әдісі аяқталды.
Dialogue: 0,0:21:04.34,0:21:05.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:06.80,0:21:08.80,Default,,0,0,0,,♪～
Dialogue: 0,0:22:32.01,0:22:34.01,Default,,0,0,0,,～♪
Dialogue: 0,0:22:39.39,0:22:42.48,Default,,0,0,0,,«Басы бар, соңы жоқ»
Dialogue: 0,0:22:43.07,0:22:46.36,Default,,0,0,0,,«Даңқсыз және дауыссыз»
Dialogue: 0,0:22:46.86,0:22:49.99,Default,,0,0,0,,«Көтеріліп, кері аунайтын Муракумо тұңғиығы»
Dialogue: 0,0:22:51.07,0:22:54.37,Default,,0,0,0,,«Төмен түсіп, толтырылған ыдыс бос».
Dialogue: 0,0:22:54.87,0:22:57.75,Default,,0,0,0,,«Әттең, қабілетсіздер».
Dialogue: 0,0:22:58.87,0:23:02.00,Default,,0,0,0,,«Салмаққа көніп, жартас бол»
Dialogue: 0,0:23:02.50,0:23:05.25,Default,,0,0,0,,«Сынған тастар қиыршық тасқа айналады»
Dialogue: 0,0:23:05.34,0:23:08.42,Default,,0,0,0,,«Жаңбыр жауып, шаңға айналды»
Dialogue: 0,0:23:08.92,0:23:12.55,Default,,0,0,0,,«Сіз ыдыста болмасаңыз, шығуға жол жоқ»
Dialogue: 0,0:23:12.64,0:23:13.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:13.72,0:23:15.93,Default,,0,0,0,,Бұл қандай салмақ...
Dialogue: 0,0:23:16.43,0:23:20.73,Default,,0,0,0,,«Алайда сіз кірмейінше келуге жол жоқ».
Dialogue: 0,0:23:24.82,0:23:27.86,Default,,0,0,0,,«Өлетіндер»
Dialogue: 0,0:23:28.36,0:23:30.45,Default,,0,0,0,,«Аты аталады»
Dialogue: 0,0:23:32.36,0:23:35.41,Default,,0,0,0,,«Кіру жолы жоқ»
Dialogue: 0,0:23:38.62,0:23:41.58,Default,,0,0,0,,Сіздің өміріңіз де махаббат сияқты
Dialogue: 0,0:23:42.17,0:23:44.84,Default,,0,0,0,,Қабырғаға шашырасын
Dialogue: 0,0:23:46.34,0:23:52.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
