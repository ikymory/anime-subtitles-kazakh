Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.79,0:00:08.17,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:00:08.25,0:00:14.59,Default,,0,0,0,,Жан қоғамы (Жан қоғамы) Осы дүние мен қиял әлемінен тұратын үш дүниені теңестіруші ретінде.
Dialogue: 0,0:00:14.68,0:00:18.14,Default,,0,0,0,,Жан қоғамы мен Жарық империясы арасындағы
Dialogue: 0,0:00:18.22,0:00:22.02,Default,,0,0,0,,Біз мызғымас одақ құру туралы айтып отырмыз.
Dialogue: 0,0:00:22.77,0:00:26.02,Default,,0,0,0,,Дүниені бізге, өлім құдайларына қалдыр.
Dialogue: 0,0:00:26.10,0:00:30.44,Default,,0,0,0,,Сізге тек империяның гүлденуінен ләззат алу керек.
Dialogue: 0,0:00:30.53,0:00:34.70,Default,,0,0,0,,Әрине, Лихтрейхтің Квинсиді біріктіруі
Dialogue: 0,0:00:34.78,0:00:36.95,Default,,0,0,0,,Біздің ешқандай қатысымыз жоқ.
Dialogue: 0,0:00:37.78,0:00:41.95,Default,,0,0,0,,Біз тек пайдасы бар одақ құруға мүмкіндік жоқ.
Dialogue: 0,0:00:43.96,0:00:45.46,Default,,0,0,0,,Бұл алдау
Dialogue: 0,0:00:45.54,0:00:46.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:47.54,0:00:50.59,Default,,0,0,0,,Надан сәби деп менсінбедің бе?
Dialogue: 0,0:00:50.67,0:00:54.76,Default,,0,0,0,,Ой, мен сені қорлайын деген жоқпын.
Dialogue: 0,0:00:54.84,0:00:57.76,Default,,0,0,0,,Ештеңені білмейтінің рас.
Dialogue: 0,0:00:59.18,0:01:00.47,Default,,0,0,0,,Сұрайық
Dialogue: 0,0:01:00.97,0:01:03.31,Default,,0,0,0,,Дүние бір кездері бір болған
Dialogue: 0,0:01:03.81,0:01:07.06,Default,,0,0,0,,Мәңгілік бейбітшілікке шекара қою
Dialogue: 0,0:01:07.15,0:01:10.15,Default,,0,0,0,,Өмір мен өлімді кім ажыратты?
Dialogue: 0,0:01:10.23,0:01:12.07,Default,,0,0,0,,Рух патшасы
Dialogue: 0,0:01:12.15,0:01:16.07,Default,,0,0,0,,Халыққа өлім қорқынышын әкелген кім?
Dialogue: 0,0:01:16.15,0:01:18.82,Default,,0,0,0,,Бұл да Рух Патшасы.
Dialogue: 0,0:01:20.16,0:01:22.70,Default,,0,0,0,,Маған оралған жандардың
Dialogue: 0,0:01:22.79,0:01:25.12,Default,,0,0,0,,Ауырып жылау
Dialogue: 0,0:01:25.62,0:01:30.38,Default,,0,0,0,,Өлімнен қорқып, өткінші өмірге жабысқан халықтың реніші.
Dialogue: 0,0:01:30.46,0:01:32.05,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:01:32.55,0:01:37.01,Default,,0,0,0,,Менің алдыңғы сөздеріме жауап бересіз бе?
Dialogue: 0,0:01:37.51,0:01:39.51,Default,,0,0,0,,Хёшубу Ичибей
Dialogue: 0,0:01:40.01,0:01:43.18,Default,,0,0,0,,Менің атымды жеңіл атама
Dialogue: 0,0:01:43.26,0:01:47.81,Default,,0,0,0,,Үш дүниенің қай жерінен тыныштық табасың?
Dialogue: 0,0:01:49.15,0:01:50.61,Default,,0,0,0,,Маған көрсетейін (Юхбах) Мен оны көріп тұрмын.
Dialogue: 0,0:02:07.50,0:02:08.54,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:09.54,0:02:12.38,Default,,0,0,0,,Бұл... Рух патшасы
Dialogue: 0,0:02:12.46,0:02:16.30,Default,,0,0,0,,Сіз ештеңе білмедіңіз ғой?
Dialogue: 0,0:02:16.38,0:02:18.93,Default,,0,0,0,,Біз Рух Патшасымен біргеміз
Dialogue: 0,0:02:19.01,0:02:22.64,Default,,0,0,0,,Сіз бұл қауіпті әлемді қауіпсіз ұстайсыз.
Dialogue: 0,0:02:23.60,0:02:25.52,Default,,0,0,0,,Қандай өкінішті...
Dialogue: 0,0:02:26.06,0:02:29.35,Default,,0,0,0,,Қалай... шіркін!
Dialogue: 0,0:02:29.44,0:02:30.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:31.69,0:02:34.57,Default,,0,0,0,,Мен оны көремін дедім, Хёсубу Ичибей.
Dialogue: 0,0:02:34.65,0:02:38.07,Default,,0,0,0,,Сіз мені сол қолдарыңызбен өлтіре аласыз деп ойлайсыз ба?
Dialogue: 0,0:02:38.15,0:02:42.16,Default,,0,0,0,,Ұлының құрбандығы болған әке алақаны жанын берсін.
Dialogue: 0,0:02:42.24,0:02:44.41,Default,,0,0,0,,Алып тастау мүмкін емес
Dialogue: 0,0:02:44.49,0:02:47.58,Default,,0,0,0,,Мазасыз көздер
Dialogue: 0,0:02:47.66,0:02:51.79,Default,,0,0,0,,Сіз Рух Патшасын өз көзіңізбен көре алмайсыз.
Dialogue: 0,0:02:56.25,0:02:57.67,Default,,0,0,0,,Не!
Dialogue: 0,0:02:58.67,0:03:02.72,Default,,0,0,0,,Мен саған Рух патшасының қолын тегін беремін деп ойладың ба?
Dialogue: 0,0:03:04.64,0:03:07.35,Default,,0,0,0,,Адам өлгенше көзі қысылады.
Dialogue: 0,0:03:07.43,0:03:09.98,Default,,0,0,0,,Ешқашан қайта ашпаңыз
Dialogue: 0,0:03:10.56,0:03:12.31,Default,,0,0,0,,Қарапайымды өмір сүр
Dialogue: 0,0:03:15.32,0:03:18.23,Default,,0,0,0,,Көзімнің қысылғаны қандай жақсы.
Dialogue: 0,0:03:18.32,0:03:21.20,Default,,0,0,0,,Қорлаудың соңын көрудің қажеті жоқ
Dialogue: 0,0:03:22.03,0:03:23.24,Default,,0,0,0,,Рух патшасы
Dialogue: 0,0:03:23.74,0:03:29.41,Default,,0,0,0,,Ерік-жігерінен айырылып, табынатын сұмдық етке айналған әкем.
Dialogue: 0,0:03:29.95,0:03:33.33,Default,,0,0,0,,Мен сендерге жаңа рөл беремін.
Dialogue: 0,0:03:34.08,0:03:37.84,Default,,0,0,0,,Дүниемен бірге жоғалып кету
Dialogue: 0,0:03:37.92,0:03:41.38,Default,,0,0,0,,Үш дүниенің құлпытасы боласың.
Dialogue: 0,0:03:44.09,0:03:45.51,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:46.39,0:03:48.97,Default,,0,0,0,,Бұл Рух патша сарайы ма?
Dialogue: 0,0:03:50.48,0:03:53.44,Default,,0,0,0,,Мәртебелі мырзаға көңіл айтамын.
Dialogue: 0,0:03:53.52,0:03:56.52,Default,,0,0,0,,Сіз нені айтасыз, Хашвальд?
Dialogue: 0,0:03:57.11,0:04:00.40,Default,,0,0,0,,Шіріген қабір маркеріне қарағанымда
Dialogue: 0,0:04:00.49,0:04:03.53,Default,,0,0,0,,Сіз аздап эмоционалды сезінесіз бе?
Dialogue: 0,0:04:05.49,0:04:06.91,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:04:07.53,0:04:08.91,Default,,0,0,0,,Кеттік
Dialogue: 0,0:04:08.99,0:04:11.91,Default,,0,0,0,,Өтірікке толы дүниені аяқтау
Dialogue: 0,0:04:12.00,0:04:17.09,Default,,0,0,0,,Нағыз бейбітшілік... жаңа әлем құру
Dialogue: 0,0:04:17.63,0:04:20.05,Default,,0,0,0,,Біздің қолымызбен
Dialogue: 0,0:04:40.53,0:04:42.53,Default,,0,0,0,,♪～
Dialogue: 0,0:06:07.45,0:06:09.45,Default,,0,0,0,,～♪
Dialogue: 0,0:06:13.12,0:06:14.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:15.08,0:06:18.04,Default,,0,0,0,,Күте тұрыңыз! Күтіңіз, күтіңіз, күтіңіз!
Dialogue: 0,0:06:18.12,0:06:21.04,Default,,0,0,0,,Өзін-өзі жариялаған «Рух сарайын басқалардан жақсы білетін адам»
Dialogue: 0,0:06:21.13,0:06:24.71,Default,,0,0,0,,Шиба Иваваши-саманың рұқсатынсыз мен Рейу сарайына бардым.
Dialogue: 0,0:06:24.80,0:06:27.30,Default,,0,0,0,,Батылдық!
Dialogue: 0,0:06:28.84,0:06:31.47,Default,,0,0,0,,Сіз Ивавасисіз бе? Мұнда не үшін келдің?
Dialogue: 0,0:06:31.55,0:06:33.05,Default,,0,0,0,,Бұл ақымақ сұрақ.
Dialogue: 0,0:06:33.14,0:06:36.93,Default,,0,0,0,,Сіздің ойыңызша, «Нөлдік эскадронның» аспан көлігін кім ұшырды?
Dialogue: 0,0:06:37.02,0:06:38.64,Default,,0,0,0,,Сіздің әпкеңіз (Иваваси) Дұрыс!
Dialogue: 0,0:06:38.73,0:06:39.89,Default,,0,0,0,,Бұл сен емессің.
Dialogue: 0,0:06:39.98,0:06:41.77,Default,,0,0,0,,Иә, бұл мен емес.
Dialogue: 0,0:06:41.85,0:06:43.73,Default,,0,0,0,,Көңіліңіз қалмады.
Dialogue: 0,0:06:43.82,0:06:46.03,Default,,0,0,0,,Сонда сен мұнда не үшін келдің?
Dialogue: 0,0:06:46.11,0:06:49.32,Default,,0,0,0,,Квинстерді жеңуден басқа не істеу керек?
Dialogue: 0,0:06:49.99,0:06:54.16,Default,,0,0,0,,Сол үшін апам маған Аспан сарайына апаратын жол картасын берді.
Dialogue: 0,0:06:54.24,0:06:57.45,Default,,0,0,0,,Бұл жігітсіз сіз Рух патшасының сарайына жете алмайсыз.
Dialogue: 0,0:06:57.54,0:06:58.66,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:06:59.16,0:07:03.00,Default,,0,0,0,,Иваваси Осыдан кейін ол бұрынғыдай болмайды.
Dialogue: 0,0:07:03.08,0:07:05.09,Default,,0,0,0,,Бұл қауіпті шайқас болады.
Dialogue: 0,0:07:05.17,0:07:07.30,Default,,0,0,0,,Ақымақ! Мен түсінемін
Dialogue: 0,0:07:07.38,0:07:09.59,Default,,0,0,0,,Сондықтан мен барамын деп ойлаймын.
Dialogue: 0,0:07:11.68,0:07:14.18,Default,,0,0,0,,А... Түсіндім.
Dialogue: 0,0:07:16.43,0:07:18.47,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:07:32.07,0:07:32.61,Default,,0,0,0,,３…
Dialogue: 0,0:07:33.87,0:07:36.78,Default,,0,0,0,,２ １…
Dialogue: 0,0:07:39.41,0:07:42.54,Default,,0,0,0,,А, мынау... осылай ұшады!
Dialogue: 0,0:07:57.72,0:08:00.27,Default,,0,0,0,,Қандай бейберекет жоғары траектория.
Dialogue: 0,0:08:00.35,0:08:03.39,Default,,0,0,0,,Үйлестірудің болмауының шегі бар.
Dialogue: 0,0:08:05.35,0:08:08.36,Default,,0,0,0,,Юха Бахтан бері көп уақыт өтті
Dialogue: 0,0:08:08.94,0:08:12.86,Default,,0,0,0,,Сіз бұл Рух Патшасының сарайына шақырусыз кіруге қалай батылыңыз бар?
Dialogue: 0,0:08:12.95,0:08:16.95,Default,,0,0,0,,Генрюсайды жеңгеннен кейін қаны кеткен сияқты.
Dialogue: 0,0:08:18.03,0:08:18.95,Default,,0,0,0,,Қасиетті солдат (Золдат)
Dialogue: 0,0:08:20.04,0:08:21.95,Default,,0,0,0,,Рух патшасының жүзі
Dialogue: 0,0:08:32.05,0:08:33.47,Default,,0,0,0,,Жеткізбеу
Dialogue: 0,0:08:34.13,0:08:36.93,Default,,0,0,0,,Рух патшасының жүзіндегі тот бол.
Dialogue: 0,0:08:41.64,0:08:42.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:42.60,0:08:45.48,Default,,0,0,0,,Балалар, сендер оған лайық емессіңдер.
Dialogue: 0,0:08:46.27,0:08:48.15,Default,,0,0,0,,Оның қасиетті әрпі «W»
Dialogue: 0,0:08:48.73,0:08:51.65,Default,,0,0,0,,Нянзор бұрылыстар шебері (Жел)
Dialogue: 0,0:08:51.73,0:08:53.15,Default,,0,0,0,,Мен тапқан жау болды
Dialogue: 0,0:08:53.24,0:08:55.53,Default,,0,0,0,,Бәрі қисық
Dialogue: 0,0:08:55.61,0:08:57.95,Default,,0,0,0,,Жиеннің денесінен аулақ бол
Dialogue: 0,0:09:00.12,0:09:03.91,Default,,0,0,0,,«Мен тапқан барлық жаулар» дедіңіз
Dialogue: 0,0:09:04.00,0:09:05.41,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:09:05.50,0:09:09.63,Default,,0,0,0,,Жау табылмаса, иілмейді.
Dialogue: 0,0:09:10.13,0:09:14.17,Default,,0,0,0,,Сіз тапқан жау – «сенің инстинкті арқылы тапқан жау».
Dialogue: 0,0:09:14.76,0:09:18.97,Default,,0,0,0,,Маған төменнен шабуыл жасасаң да, жиеннің денесінен қашамын.
Dialogue: 0,0:09:21.72,0:09:24.23,Default,,0,0,0,,Сөздердің аздығы үшін кешіріңіз
Dialogue: 0,0:09:24.31,0:09:26.44,Default,,0,0,0,,Бұлай жиі айтпа.
Dialogue: 0,0:09:26.52,0:09:29.69,Default,,0,0,0,,Жиенімнің сөзі де, тілі де жоқ.
Dialogue: 0,0:09:29.77,0:09:31.73,Default,,0,0,0,,Зиянды әдеттер
Dialogue: 0,0:09:31.82,0:09:34.19,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ
Dialogue: 0,0:09:34.28,0:09:36.99,Default,,0,0,0,,Әр адамның жаман әдеттері болады
Dialogue: 0,0:09:38.03,0:09:39.49,Default,,0,0,0,,Жау дегеніміз не?
Dialogue: 0,0:09:39.57,0:09:40.74,Default,,0,0,0,,жақынырақ
Dialogue: 0,0:09:40.83,0:09:44.50,Default,,0,0,0,,Неғұрлым көзге көрінетін заттар болса, соғұрлым олар көрінбейді.
Dialogue: 0,0:09:45.25,0:09:47.96,Default,,0,0,0,,Денеңді жауып тұратын киім
Dialogue: 0,0:09:48.04,0:09:49.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:49.08,0:09:52.59,Default,,0,0,0,,Құдайдың сарбаздарымен ойнап жүргенде...
Dialogue: 0,0:09:53.75,0:09:56.84,Default,,0,0,0,,Мен оны сабаннан қайта жасадым.
Dialogue: 0,0:09:56.92,0:10:00.22,Default,,0,0,0,,Уф... өтірікшілер! Осылай...
Dialogue: 0,0:10:00.30,0:10:02.85,Default,,0,0,0,,Мен тіккен ең жоғарғы киім
Dialogue: 0,0:10:03.43,0:10:07.27,Default,,0,0,0,,Сендей кішкентай солдат кие алса да шүкіршілік ет.
Dialogue: 0,0:10:07.77,0:10:08.98,Default,,0,0,0,,Және…
Dialogue: 0,0:10:09.06,0:10:12.23,Default,,0,0,0,,Өлгенше шешіп аламын деп ойлама.
Dialogue: 0,0:10:12.32,0:10:13.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:14.07,0:10:18.20,Default,,0,0,0,,Ойланып қарасақ, жаман әдеттер туралы әңгіменің ортасында қалдық.
Dialogue: 0,0:10:18.28,0:10:24.08,Default,,0,0,0,,Тігін инесін алуды ұмыту – бұзылмайтын жаман әдет.
Dialogue: 0,0:10:24.70,0:10:26.29,Default,,0,0,0,,Бұл сабан...
Dialogue: 0,0:10:27.08,0:10:30.71,Default,,0,0,0,,Сөздердің аздығы үшін кешіріңіз
Dialogue: 0,0:10:35.09,0:10:39.47,Default,,0,0,0,,Хаа... Бірақ бір сұмдық болды.
Dialogue: 0,0:10:39.55,0:10:42.64,Default,,0,0,0,,Мен қандай да бір себептермен «Қырық Орақ» жеңеді деп ойладым.
Dialogue: 0,0:10:43.43,0:10:47.52,Default,,0,0,0,,Мен олардың мұндай қамал салып, оны лақтырып жібергеніне сене алар емеспін.
Dialogue: 0,0:10:47.60,0:10:50.73,Default,,0,0,0,,Сіз не ойлап отырсыз? Джухабах деген жігіт
Dialogue: 0,0:10:51.23,0:10:54.65,Default,,0,0,0,,Сонымен Рух патшасының сарайында не бар?
Dialogue: 0,0:10:54.73,0:10:58.36,Default,,0,0,0,,Жүр, мен де ол жерде ешқашан болған емеспін.
Dialogue: 0,0:10:58.44,0:10:59.82,Default,,0,0,0,,Ах... Иваваси-кун
Dialogue: 0,0:10:59.90,0:11:03.20,Default,,0,0,0,,Ол өзін «Рух сарайын басқалардан жақсы білетін адам» деп атайды, солай емес пе?
Dialogue: 0,0:11:03.28,0:11:07.24,Default,,0,0,0,,Әй, апам маған көп нәрсені үйретті.
Dialogue: 0,0:11:07.33,0:11:09.12,Default,,0,0,0,,Бірақ бұл кішкене...
Dialogue: 0,0:11:09.21,0:11:10.46,Default,,0,0,0,,Бұл деталь ма?
Dialogue: 0,0:11:10.54,0:11:11.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:11.25,0:11:13.42,Default,,0,0,0,,Дахахаха!
Dialogue: 0,0:11:13.50,0:11:15.96,Default,,0,0,0,,Рух патшасының сарайына кіріңіз.
Dialogue: 0,0:11:16.05,0:11:18.21,Default,,0,0,0,,Рух патшасынан басқа нысана жоқ.
Dialogue: 0,0:11:18.30,0:11:19.72,Default,,0,0,0,,Рух патшасы…
Dialogue: 0,0:11:20.47,0:11:23.84,Default,,0,0,0,,...
Dialogue: 0,0:11:24.35,0:11:28.14,Default,,0,0,0,,Бүкіл әлемге билік жүргізетін құдайға ұқсас тіршілік иесі.
Dialogue: 0,0:11:28.77,0:11:32.40,Default,,0,0,0,,Мен бұл туралы тек естідім, бірақ мен оны ешқашан кездестірмедім.
Dialogue: 0,0:11:32.48,0:11:33.56,Default,,0,0,0,,Құдай?
Dialogue: 0,0:11:34.36,0:11:37.40,Default,,0,0,0,,Юхабах солай болуға тырысып жатыр ма?
Dialogue: 0,0:11:37.48,0:11:39.11,Default,,0,0,0,,О, мен бұл сенімдімін!
Dialogue: 0,0:11:39.19,0:11:40.28,Default,,0,0,0,,Аха…
Dialogue: 0,0:11:40.90,0:11:43.74,Default,,0,0,0,,Қызық, Рух патшасының орнын басуға бола ма?
Dialogue: 0,0:11:44.74,0:11:46.33,Default,,0,0,0,,Рух патша сарайында жаттығу кезінде
Dialogue: 0,0:11:46.83,0:11:49.12,Default,,0,0,0,,Айтайын дегенім... Мен көп нәрсені көрдім.
Dialogue: 0,0:11:50.12,0:11:54.04,Default,,0,0,0,,Рух Патшасы әлемнің қалай жұмыс істейтіні туралы басты кітап сияқты.
Dialogue: 0,0:11:54.13,0:11:56.92,Default,,0,0,0,,Менің ойымша, оны ауыстыру мүмкін емес.
Dialogue: 0,0:11:57.00,0:11:59.63,Default,,0,0,0,,Сонда мақсат не?
Dialogue: 0,0:11:59.71,0:12:01.09,Default,,0,0,0,,Менен сұрама
Dialogue: 0,0:12:01.67,0:12:03.72,Default,,0,0,0,,Міне, біз осы уақытқа дейін келдік,
Dialogue: 0,0:12:03.80,0:12:07.18,Default,,0,0,0,,Мақсат қандай болса да, оларды ұрып-соғу керек.
Dialogue: 0,0:12:07.26,0:12:08.39,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:09.77,0:12:12.39,Default,,0,0,0,,Осы сияқты бірдеңені есіме түсіреді.
Dialogue: 0,0:12:12.89,0:12:15.86,Default,,0,0,0,,Барлығымыз Кучики-санды құтқаруға барғанда не болды?
Dialogue: 0,0:12:16.69,0:12:19.44,Default,,0,0,0,,Ол кезде Йоруичи әлі мысық еді...
Dialogue: 0,0:12:27.66,0:12:29.70,Default,,0,0,0,,Ишида-кун сонда болды, солай ма?
Dialogue: 0,0:12:36.92,0:12:40.05,Default,,0,0,0,,Ишида-кун, қайтесің?
Dialogue: 0,0:12:43.01,0:12:44.09,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:44.18,0:12:44.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:45.01,0:12:47.68,Default,,0,0,0,,Біз Юхабахты жеңеміз.
Dialogue: 0,0:12:48.18,0:12:51.06,Default,,0,0,0,,Сосын Ишида оны жұдырықпен ұрып, кері қайтарады.
Dialogue: 0,0:12:51.14,0:12:52.56,Default,,0,0,0,,Сіз осылай шештіңіз, солай ма?
Dialogue: 0,0:12:53.68,0:12:55.69,Default,,0,0,0,,Кейінгі ой сияқты
Dialogue: 0,0:12:55.77,0:12:58.81,Default,,0,0,0,,Хехе, дұрыс!
Dialogue: 0,0:13:02.07,0:13:03.19,Default,,0,0,0,,Қазір...
Dialogue: 0,0:13:03.28,0:13:07.45,Default,,0,0,0,,Енді пышақ сізге жетеді.
Dialogue: 0,0:13:08.57,0:13:10.53,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:13:12.50,0:13:13.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:19.08,0:13:21.00,Default,,0,0,0,,Менің SS
Dialogue: 0,0:13:21.84,0:13:24.17,Default,,0,0,0,,Жауап берілген.
Dialogue: 0,0:13:29.72,0:13:31.31,Default,,0,0,0,,Ой
Dialogue: 0,0:13:31.39,0:13:33.77,Default,,0,0,0,,Жақсылап қарасам, маған төменнен әкелінген адам екен
Dialogue: 0,0:13:33.85,0:13:35.31,Default,,0,0,0,,Мен жалғызбын ба?
Dialogue: 0,0:13:35.39,0:13:38.02,Default,,0,0,0,,Бұл жігіт белсенді болуы керек.
Dialogue: 0,0:13:38.10,0:13:39.73,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:13:39.81,0:13:44.49,Default,,0,0,0,,Маған пайдаң болмаса, мен сені қиып, лақтырып тастаймын.
Dialogue: 0,0:13:46.24,0:13:47.99,Default,,0,0,0,,Тірі қалсам да
Dialogue: 0,0:13:48.07,0:13:48.99,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:13:50.45,0:13:54.12,Default,,0,0,0,,Менің қылышымды әйелдің жіңішке қолдары тоқтата ала ма?
Dialogue: 0,0:14:00.75,0:14:03.46,Default,,0,0,0,,Екінші дәрежелі құдай сарбазы Рух патшасының қалқаны
Dialogue: 0,0:14:03.55,0:14:05.30,Default,,0,0,0,,Мына жігіттерді тоқтатыңыз!
Dialogue: 0,0:14:11.93,0:14:13.85,Default,,0,0,0,,О, бұл өте үлкен.
Dialogue: 0,0:14:16.10,0:14:18.85,Default,,0,0,0,,Не? Сіз бірдеңе айтқыңыз келеді.
Dialogue: 0,0:14:18.94,0:14:22.36,Default,,0,0,0,,«Бұл үлкен, сонда не?»
Dialogue: 0,0:14:31.91,0:14:35.83,Default,,0,0,0,,Сіз Рух патшасының сарайы құлап кетуі мүмкін деп ойладыңыз ба?
Dialogue: 0,0:14:36.45,0:14:37.29,Default,,0,0,0,,Кеш болды
Dialogue: 0,0:14:37.91,0:14:42.88,Default,,0,0,0,,Ұрыста жеңілген тарап әрқашан түсінуге баяу, реакцияға баяу келеді.
Dialogue: 0,0:14:43.38,0:14:48.30,Default,,0,0,0,,Мәртебелі осында қадам басқан кезде, Рух патшасының сарайы құлап үлгерді.
Dialogue: 0,0:14:48.38,0:14:48.88,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:18.16,0:15:22.29,Default,,0,0,0,,Бұл өте қарапайым. Zero Squad осындай нәрсе ме?
Dialogue: 0,0:15:22.37,0:15:23.83,Default,,0,0,0,,Сіз бұрын болдыңыз ба?
Dialogue: 0,0:15:24.34,0:15:27.76,Default,,0,0,0,,Көз алдымызда кім оңай өлді?
Dialogue: 0,0:15:33.43,0:15:35.89,Default,,0,0,0,,Енді барлық кедергілер жойылды.
Dialogue: 0,0:15:37.31,0:15:38.97,Default,,0,0,0,,Өтінемін, Мәртебелі.
Dialogue: 0,0:15:45.73,0:15:46.98,Default,,0,0,0,,Эй, Сакута. Иә, не болды?
Dialogue: 0,0:15:47.48,0:15:49.28,Default,,0,0,0,,Рейу сарайының декорациясы...
Dialogue: 0,0:15:49.36,0:15:50.90,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:15:51.40,0:15:53.20,Default,,0,0,0,,Мына жер қайда?
Dialogue: 0,0:15:53.28,0:15:56.58,Default,,0,0,0,,Бұл жер сізді қарсы алу үшін осында.
Dialogue: 0,0:15:56.66,0:15:58.95,Default,,0,0,0,,Жалған рух сарайы
Dialogue: 0,0:15:59.04,0:16:01.46,Default,,0,0,0,,Нағыз Рух сарайы
Dialogue: 0,0:16:01.96,0:16:04.71,Default,,0,0,0,,Діни қызметкер оны сол жерде тығып жатыр.
Dialogue: 0,0:16:10.97,0:16:15.01,Default,,0,0,0,,О, не? Не? Сіз оны қазірдің өзінде бұздыңыз ба?
Dialogue: 0,0:16:15.09,0:16:16.97,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:16:17.05,0:16:19.85,Default,,0,0,0,,Менің ойымша, тор дер кезінде келді.
Dialogue: 0,0:16:21.73,0:16:22.81,Default,,0,0,0,,(Баяндаушы) Цезарь не болып жатқанын мүлде түсінбеді.
Dialogue: 0,0:16:22.89,0:16:26.81,Default,,0,0,0,,Иә, иә, иә, мен оны уақытында жасадым.
Dialogue: 0,0:16:26.90,0:16:30.82,Default,,0,0,0,,Осыншама үлкен босанғанымызға біраз болды.
Dialogue: 0,0:16:30.90,0:16:33.28,Default,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:16:34.28,0:16:37.12,Default,,0,0,0,,Ой... Бұл не?
Dialogue: 0,0:16:37.20,0:16:39.33,Default,,0,0,0,,Менің біртүрлі техникам!
Dialogue: 0,0:16:39.41,0:16:40.58,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:42.96,0:16:45.46,Default,,0,0,0,,Бір нүктені қайта-қайта соқсаңыз да сынбайды.
Dialogue: 0,0:16:45.96,0:16:48.79,Default,,0,0,0,,Егер сіз алшақтықты мақсат етсеңіз де, бұтақтар бірден өседі.
Dialogue: 0,0:16:48.88,0:16:52.84,Default,,0,0,0,,Хаха, бұл барлық нәрсеге ене алмау, Лидье.
Dialogue: 0,0:16:52.92,0:16:54.68,Default,,0,0,0,,Еніп жатқан
Dialogue: 0,0:16:54.76,0:16:59.43,Default,,0,0,0,,Тамақты бақылау өмірді басқару дегенді білдіреді.
Dialogue: 0,0:16:59.51,0:17:02.60,Default,,0,0,0,,Өмірге пішін беру үшін тамақ жасаймын.
Dialogue: 0,0:17:02.68,0:17:05.94,Default,,0,0,0,,Материал өз денесінен де жасалады
Dialogue: 0,0:17:06.02,0:17:09.44,Default,,0,0,0,,Бұл ағаш менің рухани қысымымды қабылдап, жемісін береді.
Dialogue: 0,0:17:09.52,0:17:13.94,Default,,0,0,0,,Сіздің оқыңыз рух бөлшектерінің өте жоғары концентрациясы емес пе?
Dialogue: 0,0:17:14.03,0:17:18.95,Default,,0,0,0,,Осындай дәмді нәрселер, бұл өмір ағашы қашып кетпейді.
Dialogue: 0,0:17:19.03,0:17:23.20,Default,,0,0,0,,Сіз еніп кетсеңіз де, өсу қарқыны одан асып түседі.
Dialogue: 0,0:17:24.46,0:17:26.83,Default,,0,0,0,,Сіз қалағаныңызша зорлық көрсете аласыз.
Dialogue: 0,0:17:26.92,0:17:31.21,Default,,0,0,0,,Сіздің қабілеттеріңіз бұл өмір торынан құтылуға мүмкіндік бермейді.
Dialogue: 0,0:17:32.92,0:17:36.55,Default,,0,0,0,,Таң қалмаңыздар, қонақтар!
Dialogue: 0,0:17:39.39,0:17:43.47,Default,,0,0,0,,Нөлдік отрядтың бірінші офицері Тухоу Год генерал Изуми Юки
Dialogue: 0,0:17:43.56,0:17:47.60,Default,,0,0,0,,Киринджи Тендзиро Таа, бұл мен туралы!
Dialogue: 0,0:17:47.69,0:17:51.82,Default,,0,0,0,,Нөлдік дивизияның төртінші офицері Солтүстік Құдай генералы
Dialogue: 0,0:17:51.90,0:17:56.07,Default,,0,0,0,,Оороками Шутара Сенжумару
Dialogue: 0,0:17:56.15,0:18:00.20,Default,,0,0,0,,Нөлдік отрядтың 2-ші офицері Оңтүстік Құдай генералы
Dialogue: 0,0:18:00.28,0:18:03.70,Default,,0,0,0,,Бұл Кокуу Хикифунэ Кирю.
Dialogue: 0,0:18:07.16,0:18:07.83,Default,,0,0,0,,Yo!
Dialogue: 0,0:18:09.17,0:18:13.80,Default,,0,0,0,,Мен бірінші нөмірлі Занпакуто Крейрамын!
Dialogue: 0,0:18:13.88,0:18:16.97,Default,,0,0,0,,19 8 7 6 5 дана
Dialogue: 0,0:18:17.05,0:18:18.30,Default,,0,0,0,,Соңында, үш бөлік
Dialogue: 0,0:18:18.38,0:18:20.30,Default,,0,0,0,,Нимаия О-Эцу!
Dialogue: 0,0:18:20.80,0:18:23.89,Default,,0,0,0,,Закоға апаратын жол жоқ.
Dialogue: 0,0:18:24.39,0:18:27.73,Default,,0,0,0,,Үніңді жап, маған қоңырау шал.
Dialogue: 0,0:18:28.23,0:18:31.19,Default,,0,0,0,,Нөлдік жасақ үшін шайқас осы жерден басталады.
Dialogue: 0,0:18:32.69,0:18:36.28,Default,,0,0,0,,Иә? Ұзақ уақыттан кейін жұлып алғанымнан шығар.
Dialogue: 0,0:18:36.36,0:18:39.45,Default,,0,0,0,,Пышақтың шеті дірілдеп тұр.
Dialogue: 0,0:18:41.24,0:18:42.95,Default,,0,0,0,,Жақсы қашу!
Dialogue: 0,0:18:43.03,0:18:45.95,Default,,0,0,0,,Адамның құшағынан жалтару әдептілік.
Dialogue: 0,0:18:46.04,0:18:47.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:47.66,0:18:48.66,Default,,0,0,0,,Содан кейін!
Dialogue: 0,0:18:50.87,0:18:52.67,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:18:54.75,0:18:56.67,Default,,0,0,0,,ше? Эй...
Dialogue: 0,0:18:57.26,0:18:58.80,Default,,0,0,0,,Не... бұл өтірік, солай ма?
Dialogue: 0,0:19:01.72,0:19:04.93,Default,,0,0,0,,Чанбоку кім деп ойлайсың?
Dialogue: 0,0:19:05.01,0:19:07.47,Default,,0,0,0,,19 8 7 6 5 дана
Dialogue: 0,0:19:07.98,0:19:09.14,Default,,0,0,0,,Соңында, үш бөлік
Dialogue: 0,0:19:09.23,0:19:11.81,Default,,0,0,0,,Нимаия О-Эцу!
Dialogue: 0,0:19:11.90,0:19:14.98,Default,,0,0,0,,Zero Squad тобының ең керемет мүшесі
Dialogue: 0,0:19:16.32,0:19:19.95,Default,,0,0,0,,Чанбоктың қылыш бір сермеп өлтіреді
Dialogue: 0,0:19:20.45,0:19:22.66,Default,,0,0,0,,Біртүрлі әдістерді қолданбаңыз
Dialogue: 0,0:19:22.74,0:19:24.87,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,0:19:25.45,0:19:27.87,Default,,0,0,0,,Бұл өтірік. Оны көргенде білесің.
Dialogue: 0,0:19:28.50,0:19:31.42,Default,,0,0,0,,Сол желе сияқты бірдеңеге малынған
Dialogue: 0,0:19:31.50,0:19:34.00,Default,,0,0,0,,Қылыштың зақымдалғаны сонша, жүзі шайқалған.
Dialogue: 0,0:19:34.50,0:19:36.92,Default,,0,0,0,,Джералд оны кесіп тастай алмайды.
Dialogue: 0,0:19:37.00,0:19:38.55,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:38.63,0:19:39.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:40.72,0:19:42.38,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:19:42.93,0:19:43.97,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:19:44.47,0:19:46.64,Default,,0,0,0,,Сіз осылай орнатқанда
Dialogue: 0,0:19:46.72,0:19:50.98,Default,,0,0,0,,Сіздің тамаша оқыңыз белгіге тамаша тиді.
Dialogue: 0,0:19:51.06,0:19:53.40,Default,,0,0,0,,Ол екіге бөлінді.
Dialogue: 0,0:19:58.28,0:19:59.57,Default,,0,0,0,,(Баяндаушы) Цезарь не болып жатқанын мүлде түсінбеді.
Dialogue: 0,0:20:02.86,0:20:03.95,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:13.04,0:20:15.29,Default,,0,0,0,,О! Бұл жақсы!
Dialogue: 0,0:20:15.38,0:20:18.21,Default,,0,0,0,,Менің қиғаш сызықтың жылдамдығына сәйкес артқа секірдім.
Dialogue: 0,0:20:18.30,0:20:22.34,Default,,0,0,0,,Бұл жігіттің өткір екенін білмесең, қолыңнан келмейді.
Dialogue: 0,0:20:23.47,0:20:24.84,Default,,0,0,0,,Білмейсің бе?
Dialogue: 0,0:20:28.76,0:20:31.31,Default,,0,0,0,,Бұл қынап ақау болып табылады.
Dialogue: 0,0:20:31.89,0:20:35.06,Default,,0,0,0,,Өткірлік тым жақсы, жүзі тым тегіс
Dialogue: 0,0:20:35.15,0:20:37.56,Default,,0,0,0,,Қанша кессең де жүзі төгілмейді.
Dialogue: 0,0:20:37.65,0:20:40.82,Default,,0,0,0,,Бұл қайрау үшін жеткілікті.
Dialogue: 0,0:20:40.90,0:20:45.28,Default,,0,0,0,,Ең сорақысы, мен оны салу үшін қабық жасай алмаймын.
Dialogue: 0,0:20:45.36,0:20:48.83,Default,,0,0,0,,Бұл қылышқа сәйкес келмейді.
Dialogue: 0,0:20:48.91,0:20:51.62,Default,,0,0,0,,Сейрейтейге жіберуге болмайтын орынбасар еді.
Dialogue: 0,0:20:52.70,0:20:55.29,Default,,0,0,0,,Рух патша сарайына асығыс келгеніңізге қуаныштымын.
Dialogue: 0,0:20:55.87,0:20:58.25,Default,,0,0,0,,Сіздің арқаңызда бұл жігіттің кезегі мүмкін болды.
Dialogue: 0,0:20:58.75,0:21:02.42,Default,,0,0,0,,Рахмет, У-Хар.
Dialogue: 0,0:21:19.19,0:21:24.36,Default,,0,0,0,,Босану кезеңінен аман қалу үшін күшке ие болу өте қиын.
Dialogue: 0,0:21:24.44,0:21:28.28,Default,,0,0,0,,Патша күткендей, жарқын көтерілу
Dialogue: 0,0:21:28.37,0:21:30.66,Default,,0,0,0,,Мен ұлы мәртебелілердің соңынан еруім керек емес пе?
Dialogue: 0,0:21:30.74,0:21:33.75,Default,,0,0,0,,Оларды қуу керек емес пе?
Dialogue: 0,0:21:33.83,0:21:34.91,Default,,0,0,0,,Жоғарыда кім бар?
Dialogue: 0,0:21:35.00,0:21:39.92,Default,,0,0,0,,Менің ыстық суым да иісінен арыла алмайды. Сіз қанды монахсыз.
Dialogue: 0,0:21:40.00,0:21:44.17,Default,,0,0,0,,Арамыз алшақ болса да, сен қалағаныңды істей аласың.
Dialogue: 0,0:21:44.67,0:21:46.51,Default,,0,0,0,,Оны қалай көресіз?
Dialogue: 0,0:21:47.93,0:21:52.14,Default,,0,0,0,,Мен сізге рұқсат етемін бе? Хёсубу Ичибей
Dialogue: 0,0:21:52.22,0:21:53.22,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:53.72,0:21:58.81,Default,,0,0,0,,Қанша ұрыссам да, атыммен атайсың.
Dialogue: 0,0:22:00.52,0:22:03.48,Default,,0,0,0,,Маған бәрібір, тамағың езілген.
Dialogue: 0,0:22:06.78,0:22:08.78,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.99,0:23:33.99,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.25,0:23:44.58,Default,,0,0,0,,Гөзен мүлде қараңғы және мүлдем қарама-қарсы.
Dialogue: 0,0:23:46.08,0:23:52.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
