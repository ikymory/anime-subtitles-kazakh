Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:02.91,Default,,0,0,0,,Сол Серизава Камо
Dialogue: 0,0:00:03.00,0:00:05.67,Default,,0,0,0,,Ассасин жасырын түрде кіріп кетті ме?
Dialogue: 0,0:00:05.75,0:00:09.05,Default,,0,0,0,,- (Фуджимото) Уау! -(Хосокава) Серизава мырза!
Dialogue: 0,0:00:09.13,0:00:11.01,Default,,0,0,0,,- (Яширо) Уф... - (Маджиро) Уф...
Dialogue: 0,0:00:11.09,0:00:15.55,Default,,0,0,0,,(Сарбаздардың айқайы)
Dialogue: 0,0:00:15.64,0:00:18.76,Default,,0,0,0,,Мен Осакаға бара жатқанда...
Dialogue: 0,0:00:27.98,0:00:30.11,Default,,0,0,0,,Таро, қош айт
Dialogue: 0,0:01:02.31,0:01:06.69,Default,,0,0,0,,Ұстаз, мен сіздің жақсылығыңызды өтей де алмаймын...
Dialogue: 0,0:01:10.32,0:01:12.48,Default,,0,0,0,,Бүгін қаралы күн
Dialogue: 0,0:01:12.57,0:01:17.91,Default,,0,0,0,,Мен сүйіктім Серизава Сенсеймен қоштасуым керек.
Dialogue: 0,0:01:18.62,0:01:24.83,Default,,0,0,0,,Серизава Сенсей Мибу Роши-гумидің алғашқы бас директоры ретінде негізін қалауда маңызды рөл атқарды.
Dialogue: 0,0:01:24.91,0:01:27.08,Default,,0,0,0,,Керемет және бәрі жақсы көреді
Dialogue: 0,0:01:27.17,0:01:31.42,Default,,0,0,0,,Әрқашан алдыңғы қатарда болдың, бізді алға сүйредің.
Dialogue: 0,0:01:31.50,0:01:33.63,Default,,0,0,0,,Киото қаласының тұрғындары
Dialogue: 0,0:01:33.71,0:01:37.13,Default,,0,0,0,,Бұл қаншалықты пайдалы және сенімді болды!
Dialogue: 0,0:01:38.01,0:01:41.14,Default,,0,0,0,,Мұғалім қылыштан өледі деп ойлау
Dialogue: 0,0:01:43.43,0:01:46.14,Default,,0,0,0,,Бұл дәмді, Яманами мырза.
Dialogue: 0,0:01:46.23,0:01:50.81,Default,,0,0,0,,Жоқ, мен дайындаған сөйлемді оқымадыңыз.
Dialogue: 0,0:01:50.90,0:01:53.73,Default,,0,0,0,,Бұл Кондо мырзаның шынайы сезімі болуы керек.
Dialogue: 0,0:01:54.69,0:01:57.11,Default,,0,0,0,,Артында қалған біздер
Dialogue: 0,0:01:57.20,0:02:00.95,Default,,0,0,0,,Серизава мырзаның ұлт жауынгері ретіндегі өсиетін мұра ету
Dialogue: 0,0:02:01.62,0:02:04.87,Default,,0,0,0,,Осы Киото қаласын бұрынғыдан да көбірек қорғау
Dialogue: 0,0:02:04.95,0:02:08.50,Default,,0,0,0,,Әскери қызметімді күн сайын өтеуге бел байладым.
Dialogue: 0,0:02:13.42,0:02:16.55,Default,,0,0,0,,Егер сіз өзіңізді нашар сезінсеңіз, артқы жағымен демалыңыз.
Dialogue: 0,0:02:16.63,0:02:18.93,Default,,0,0,0,,Тек жерлеу ғана қалды.
Dialogue: 0,0:02:19.01,0:02:21.47,Default,,0,0,0,,Ах, Таро-кун...
Dialogue: 0,0:02:35.82,0:02:39.86,Default,,0,0,0,,(Тароның айқайы)
Dialogue: 0,0:02:47.91,0:02:52.04,Default,,0,0,0,,Mibro енді сіздің идеалды пішініңізге ие емес.
Dialogue: 0,0:02:52.13,0:02:53.96,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:02:54.04,0:02:59.05,Default,,0,0,0,,♪～
Dialogue: 0,0:04:18.92,0:04:23.93,Default,,0,0,0,,～♪
Dialogue: 0,0:04:24.55,0:04:27.68,Default,,0,0,0,,Сол жаңбыр жазды шайып кеткен сияқты.
Dialogue: 0,0:04:28.76,0:04:31.02,Default,,0,0,0,,Магистратураға хабарлама да жіберілді.
Dialogue: 0,0:04:31.10,0:04:32.93,Default,,0,0,0,,Айзуға түсіндіру аяқталды.
Dialogue: 0,0:04:33.56,0:04:35.31,Default,,0,0,0,,Барлығы кесте бойынша.
Dialogue: 0,0:04:36.60,0:04:37.73,Default,,0,0,0,,Кондо мырза
Dialogue: 0,0:04:40.73,0:04:41.57,Default,,0,0,0,,Не?
Dialogue: 0,0:04:41.65,0:04:45.20,Default,,0,0,0,,Бұл Серизаваның хаориі. Сен оны киесің.
Dialogue: 0,0:04:45.86,0:04:47.53,Default,,0,0,0,,Сіз оны кие алмайсыз.
Dialogue: 0,0:04:48.03,0:04:50.99,Default,,0,0,0,,Менде ондай ештеңе болмаса да, Мибуроны иығыма салып алып жүремін.
Dialogue: 0,0:04:52.12,0:04:52.95,Default,,0,0,0,,Я...
Dialogue: 0,0:04:54.66,0:04:56.46,Default,,0,0,0,,Соңғы соққыны бердіңіз бе?
Dialogue: 0,0:04:59.59,0:05:01.38,Default,,0,0,0,,Бұл туралы айтуға болатын нәрсе бар.
Dialogue: 0,0:05:02.84,0:05:03.67,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:03.76,0:05:05.34,Default,,0,0,0,,Басы?
Dialogue: 0,0:05:05.43,0:05:07.80,Default,,0,0,0,,Маған да сол оқиғаны айтып беріңізші.
Dialogue: 0,0:05:10.05,0:05:11.89,Default,,0,0,0,,Сол түні не болды?
Dialogue: 0,0:05:12.97,0:05:13.81,Default,,0,0,0,,Кондо мырза
Dialogue: 0,0:05:19.27,0:05:21.40,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:05:24.53,0:05:26.90,Default,,0,0,0,,Мен түсіндім, мағынасы бар.
Dialogue: 0,0:05:27.86,0:05:30.45,Default,,0,0,0,,Жетер, менің ісім аяқталды.
Dialogue: 0,0:05:30.53,0:05:33.41,Default,,0,0,0,,Біріншіден, Тароның жағдайы қалай?
Dialogue: 0,0:05:34.45,0:05:37.17,Default,,0,0,0,,Серизава осылай қайтыс болды.
Dialogue: 0,0:05:37.25,0:05:39.96,Default,,0,0,0,,Менің жүрегім тыныш болмауы керек
Dialogue: 0,0:05:40.04,0:05:43.38,Default,,0,0,0,,Артынан ілесу идеясы...
Dialogue: 0,0:05:43.46,0:05:46.09,Default,,0,0,0,,Біз енді бала емеспіз.
Dialogue: 0,0:05:46.17,0:05:47.63,Default,,0,0,0,,Бұл соншалықты әлсіз емес.
Dialogue: 0,0:05:48.63,0:05:50.39,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:50.47,0:05:52.51,Default,,0,0,0,,Ол мені жек көретін шығар.
Dialogue: 0,0:05:52.60,0:05:55.81,Default,,0,0,0,,Ха, сен жек көретін рөлді ойнауға үйреніп қалған шығарсың.
Dialogue: 0,0:05:57.98,0:06:00.02,Default,,0,0,0,,- (Хиджиката) Хун - (Кондо) Тоши
Dialogue: 0,0:06:00.10,0:06:03.27,Default,,0,0,0,,Мүмкін сен маған бұл жерден кет деп айта бастайсың.
Dialogue: 0,0:06:03.36,0:06:04.40,Default,,0,0,0,,- (Кондо) Сол кезде... - (Хиджиката) Кондо мырза
Dialogue: 0,0:06:04.48,0:06:05.32,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:05.40,0:06:08.61,Default,,0,0,0,,Оны Миброға әкелген мен болдым.
Dialogue: 0,0:06:09.11,0:06:11.57,Default,,0,0,0,,Мен саған соңына дейін қамқор боламын.
Dialogue: 0,0:06:11.66,0:06:13.99,Default,,0,0,0,,Не істесеңіз де
Dialogue: 0,0:06:17.08,0:06:21.88,Default,,0,0,0,,Серизава: Камо тым үлкен болды.
Dialogue: 0,0:06:23.96,0:06:27.55,Default,,0,0,0,,Сосын Мибро өзгерді.
Dialogue: 0,0:06:28.93,0:06:33.85,Default,,0,0,0,,Алдымен отрядта жасырынып жүрген Чошу өлтірушіні өлтірдім.
Dialogue: 0,0:06:34.60,0:06:38.56,Default,,0,0,0,,Сол жерден мен тағы бірнеше адамды өлтірдім.
Dialogue: 0,0:06:40.44,0:06:42.90,Default,,0,0,0,,Басқа адамды сақтықтан шығару үшін...
Dialogue: 0,0:06:42.98,0:06:43.94,Default,,0,0,0,,Ішек
Dialogue: 0,0:06:46.57,0:06:50.03,Default,,0,0,0,,Аяусыз шара қолдануға дайын
Dialogue: 0,0:06:50.99,0:06:51.91,Default,,0,0,0,,Ха...
Dialogue: 0,0:06:53.66,0:06:58.66,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:06:58.75,0:07:02.67,Default,,0,0,0,,Хиджиката мырза, бұл тәсіл дұрыс емес.
Dialogue: 0,0:07:04.29,0:07:08.59,Default,,0,0,0,,Қазіргі Мибро «Макото» туына бағынбайды ма?
Dialogue: 0,0:07:08.67,0:07:12.01,Default,,0,0,0,,«Шынайылық» әдіс емес, көзқарас.
Dialogue: 0,0:07:12.09,0:07:16.64,Default,,0,0,0,,Бұл жағдайда Серизава-сан және басқалар болса жақсы болар еді.
Dialogue: 0,0:07:16.72,0:07:20.39,Default,,0,0,0,,Босаңдық танытсаң, ұйымның әлсіреуі сөзсіз.
Dialogue: 0,0:07:20.48,0:07:23.90,Default,,0,0,0,,Мен ол жігіттерден құтылу үшін кез келген әдісті қолданамын.
Dialogue: 0,0:07:25.86,0:07:27.23,Default,,0,0,0,,Келгеніңе қуаныштымын.
Dialogue: 0,0:07:27.32,0:07:31.74,Default,,0,0,0,,Мен сізді аздап бүлдіріп алған сияқтымын.
Dialogue: 0,0:07:31.82,0:07:33.82,Default,,0,0,0,,Мен енді саған бала сияқты қарамаймын.
Dialogue: 0,0:07:33.91,0:07:36.20,Default,,0,0,0,,Қолымнан келгенін пайдалануға рұқсат етіңіз.
Dialogue: 0,0:07:37.91,0:07:41.54,Default,,0,0,0,,Мен Хиджиката-сан қалағандай қозғалмаймын.
Dialogue: 0,0:07:46.63,0:07:47.46,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:07:48.92,0:07:50.26,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:07:51.67,0:07:52.63,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,0:07:52.72,0:07:54.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:54.09,0:07:58.31,Default,,0,0,0,,Нагакура мырза жеңілудің ұят жоқ екенін айтты.
Dialogue: 0,0:07:58.39,0:08:02.89,Default,,0,0,0,,Енді Серизава қайтыс болды, Мибро да өзгерді, солай емес пе?
Dialogue: 0,0:08:02.98,0:08:04.52,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,0:08:07.94,0:08:09.73,Default,,0,0,0,,Мүмкін, мен кенеттен үйленуге ұсыныс жасағандықтан шығар—
Dialogue: 0,0:08:09.82,0:08:11.78,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:08:12.61,0:08:13.70,Default,,0,0,0,,Картоп
Dialogue: 0,0:08:14.91,0:08:19.91,Default,,0,0,0,,Жеңілген адамның кесірінен кейбір адамдар өзгерді.
Dialogue: 0,0:08:22.96,0:08:24.08,Default,,0,0,0,,Хаджиме-кун
Dialogue: 0,0:08:26.04,0:08:27.54,Default,,0,0,0,,Бұл жұмыс істеді ме?
Dialogue: 0,0:08:27.63,0:08:29.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:29.09,0:08:32.84,Default,,0,0,0,,Мен сені аямаймын.
Dialogue: 0,0:08:32.92,0:08:34.68,Default,,0,0,0,,Өйткені бұл анық
Dialogue: 0,0:08:35.30,0:08:36.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:36.89,0:08:39.01,Default,,0,0,0,,Егер сені осылай ұрып-соғып алсаң
Dialogue: 0,0:08:39.10,0:08:41.47,Default,,0,0,0,,Бұл сізге арналған.
Dialogue: 0,0:08:41.97,0:08:43.68,Default,,0,0,0,,Бұл жұмыс істемесе, біраз уақыт ұйықтаңыз.
Dialogue: 0,0:08:51.98,0:08:53.36,Default,,0,0,0,,Я...
Dialogue: 0,0:08:54.28,0:08:55.45,Default,,0,0,0,,Дахаха! Неге күйзеліп жатырсың!
Dialogue: 0,0:08:55.45,0:08:56.53,Default,,0,0,0,,Дахаха! Неге күйзеліп жатырсың!
Dialogue: 0,0:08:55.45,0:08:56.53,Default,,0,0,0,,Ха...
Dialogue: 0,0:08:56.53,0:08:58.12,Default,,0,0,0,,Дахаха! Неге күйзеліп жатырсың!
Dialogue: 0,0:08:58.20,0:08:58.91,Default,,0,0,0,,Үлкен ұстанымды ұстаныңыз!
Dialogue: 0,0:08:58.91,0:09:00.28,Default,,0,0,0,,Үлкен ұстанымды ұстаныңыз!
Dialogue: 0,0:08:58.91,0:09:00.28,Default,,0,0,0,,Га
Dialogue: 0,0:09:00.37,0:09:04.71,Default,,0,0,0,,Бұл ауыр! Күл! Күл!\NМен
Dialogue: 0,0:09:11.46,0:09:12.92,Default,,0,0,0,,Серизава мырза
Dialogue: 0,0:09:13.01,0:09:13.84,Default,,0,0,0,,Ах
Dialogue: 0,0:09:19.01,0:09:20.05,Default,,0,0,0,,Таро-кун
Dialogue: 0,0:09:26.73,0:09:28.69,Default,,0,0,0,,сұрадым
Dialogue: 0,0:09:28.77,0:09:29.69,Default,,0,0,0,,Ха...
Dialogue: 0,0:09:31.15,0:09:34.82,Default,,0,0,0,,Серизава-сенсейге соңғы соққыны сен бергенсің.
Dialogue: 0,0:09:39.12,0:09:40.37,Default,,0,0,0,,-Кешіріңіз... -(Таро) Кешірім сұрамаңыз.
Dialogue: 0,0:09:40.45,0:09:41.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:41.37,0:09:43.74,Default,,0,0,0,,Бұл адам бәрібір оны қалайды, солай ма?
Dialogue: 0,0:09:44.45,0:09:47.58,Default,,0,0,0,,Мен тіпті жете алмадым.
Dialogue: 0,0:09:48.08,0:09:50.59,Default,,0,0,0,,Бұл менің күш-қуатымның жоқтығы.
Dialogue: 0,0:09:50.67,0:09:55.59,Default,,0,0,0,,Ол адам мен үшін тым үлкен.
Dialogue: 0,0:09:55.67,0:09:57.59,Default,,0,0,0,,Серизава Үйрек өлді
Dialogue: 0,0:09:58.55,0:10:00.26,Default,,0,0,0,,Мен енді ешқайда кетпеймін
Dialogue: 0,0:10:02.60,0:10:05.68,Default,,0,0,0,,Мен оны қабылдадым және оған қанағаттанамын.
Dialogue: 0,0:10:05.77,0:10:10.10,Default,,0,0,0,,Дегенмен, бұл туралы ештеңе істеу қиын болатын кездер болады.
Dialogue: 0,0:10:10.98,0:10:12.73,Default,,0,0,0,,Бірақ мен түсіндім
Dialogue: 0,0:10:13.23,0:10:15.15,Default,,0,0,0,,Мен жылай алмаймын
Dialogue: 0,0:10:16.28,0:10:18.40,Default,,0,0,0,,Ертең күлесің
Dialogue: 0,0:10:19.24,0:10:21.82,Default,,0,0,0,,Бүгін бұл «ертең»
Dialogue: 0,0:10:26.37,0:10:28.96,Default,,0,0,0,,Сізге де күлу керек.
Dialogue: 0,0:10:31.92,0:10:33.09,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:33.96,0:10:37.17,Default,,0,0,0,,Неге маған әдеттегідей қарайсың?
Dialogue: 0,0:10:40.63,0:10:44.43,Default,,0,0,0,,Менің ойымша, сіз мұндай нәрсені оңай қабылдай алмайсыз ...
Dialogue: 0,0:10:45.18,0:10:48.35,Default,,0,0,0,,Ха... Бұл оңай емес.
Dialogue: 0,0:10:49.27,0:10:50.90,Default,,0,0,0,,Бұл оңай болған жоқ
Dialogue: 0,0:10:52.15,0:10:53.23,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:10:54.27,0:10:55.61,Default,,0,0,0,,Бірақ?
Dialogue: 0,0:10:56.32,0:10:59.28,Default,,0,0,0,,Бұл одан да көп жұмыс. Қазір дайын бол.
Dialogue: 0,0:10:59.36,0:11:01.03,Default,,0,0,0,,-(Таро) Бұл Годжо жағалауы. -Ах.
Dialogue: 0,0:11:02.53,0:11:04.78,Default,,0,0,0,,Бір сәтке бола ма?
Dialogue: 0,0:11:04.87,0:11:06.49,Default,,0,0,0,,Нагакура мырза
Dialogue: 0,0:11:09.58,0:11:11.92,Default,,0,0,0,,Осы жолмен
Dialogue: 0,0:11:12.50,0:11:14.59,Default,,0,0,0,,-Таро-кун - (Таро) Қараңдаршы, міне.
Dialogue: 0,0:11:15.67,0:11:18.96,Default,,0,0,0,,Көрдім, кешегі жаңбырмен...
Dialogue: 0,0:11:19.05,0:11:21.84,Default,,0,0,0,,А, бізде жұмыс күші жетпейді.
Dialogue: 0,0:11:22.47,0:11:24.97,Default,,0,0,0,,Қарғыс атсын... қарғыс атсын, ауыр екен
Dialogue: 0,0:11:25.05,0:11:27.35,Default,,0,0,0,,Ах, Хаджиме, сен осындасың!
Dialogue: 0,0:11:27.43,0:11:28.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:31.39,0:11:33.69,Default,,0,0,0,,-Хаджиме-кун? -(Нагакура) Ой
Dialogue: 0,0:11:38.28,0:11:41.40,Default,,0,0,0,,Серизаваның Тенмацусын мен де естідім.
Dialogue: 0,0:11:41.49,0:11:44.41,Default,,0,0,0,,Хаджиме Тароға шындықты айтты.
Dialogue: 0,0:11:44.49,0:11:47.54,Default,,0,0,0,,Меншік иесінің заңдылығына шағымданды
Dialogue: 0,0:11:47.62,0:11:51.16,Default,,0,0,0,,Уф, ол ластанып қалады.
Dialogue: 0,0:11:51.75,0:11:54.79,Default,,0,0,0,,Таро шынымен түтінге ашты.
Dialogue: 0,0:11:54.88,0:11:59.67,Default,,0,0,0,,Сонда да сабырлы, шыдамды болды.
Dialogue: 0,0:11:59.76,0:12:01.51,Default,,0,0,0,,Ммм.
Dialogue: 0,0:12:02.09,0:12:06.47,Default,,0,0,0,,Бұрын айлакер болған Окураның өзі кесуді тамаша орындады.
Dialogue: 0,0:12:07.14,0:12:10.06,Default,,0,0,0,,Мүмкін бұл оның бірінші өлтіруі болар.
Dialogue: 0,0:12:10.85,0:12:15.02,Default,,0,0,0,,Бәлкім, сен менің жүкімді жалғыз көтеруге шыдай алмас едім.
Dialogue: 0,0:12:15.86,0:12:17.31,Default,,0,0,0,,Адамды не етеді
Dialogue: 0,0:12:17.40,0:12:20.94,Default,,0,0,0,,Ішіңізден қан кетіп жатқаныңызды білмейсіз.
Dialogue: 0,0:12:21.99,0:12:26.41,Default,,0,0,0,,Қайын інілердің кесе алмасуынан өзгеше.
Dialogue: 0,0:12:26.49,0:12:28.12,Default,,0,0,0,,Я...
Dialogue: 0,0:12:28.66,0:12:30.12,Default,,0,0,0,,Ой, балалар!
Dialogue: 0,0:12:30.20,0:12:31.75,Default,,0,0,0,,Мен білдім
Dialogue: 0,0:12:31.83,0:12:34.71,Default,,0,0,0,,Сен неге тұрсың! Тез көмектес!
Dialogue: 0,0:12:34.79,0:12:36.71,Default,,0,0,0,,-(Таро) Кеттік. -Иә.
Dialogue: 0,0:12:38.09,0:12:43.26,Default,,0,0,0,,Ата-анам, бауырларымнан басқа кім қан төксін?
Dialogue: 0,0:12:44.09,0:12:47.68,Default,,0,0,0,,Нағыз дос... Меніңше, сіз солай айта аласыз.
Dialogue: 0,0:12:52.31,0:12:55.60,Default,,0,0,0,,Уф... бұл ауыр
Dialogue: 0,0:12:56.40,0:12:58.94,Default,,0,0,0,,Иә, мен бос жерлерді топырақпен толтырамын.
Dialogue: 0,0:12:59.02,0:13:00.73,Default,,0,0,0,,Көңіл көтеруге тырыспаңыз!
Dialogue: 0,0:13:00.82,0:13:05.03,Default,,0,0,0,,Аа, қазір ойлап қарасам, Фуджимото мырза мен оның достары Миброны тастап жатыр.
Dialogue: 0,0:13:05.11,0:13:09.78,Default,,0,0,0,,А, бұл Серизава мырзаның алтын балық саңырауқұлағы еді.
Dialogue: 0,0:13:09.87,0:13:12.91,Default,,0,0,0,,Менің ойымша, сіз онымен де құтыла аласыз деп отырған жоқсыз!
Dialogue: 0,0:13:13.00,0:13:16.62,Default,,0,0,0,,Серизава-сан кеткендіктен, Мибро бітті.
Dialogue: 0,0:13:16.71,0:13:19.34,Default,,0,0,0,,Мибро әлі аяқталған жоқ.
Dialogue: 0,0:13:20.04,0:13:23.46,Default,,0,0,0,,Өйткені бұл дүниеде бір ғана самурай бар
Dialogue: 0,0:13:23.55,0:13:25.01,Default,,0,0,0,,деді Серизава мырза
Dialogue: 0,0:13:27.55,0:13:28.68,Default,,0,0,0,,Кондо?
Dialogue: 0,0:13:28.76,0:13:32.10,Default,,0,0,0,,Иә, мен Миброға жауапты қалдырдым.
Dialogue: 0,0:13:32.85,0:13:36.23,Default,,0,0,0,,Серизава-санның соңғы сәттері керемет болды ма?
Dialogue: 0,0:13:38.02,0:13:39.65,Default,,0,0,0,,Иә, өте көп
Dialogue: 0,0:13:39.73,0:13:40.94,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:43.19,0:13:46.99,Default,,0,0,0,,Жан бар деп қашан айттыңыз?
Dialogue: 0,0:13:47.07,0:13:49.62,Default,,0,0,0,,А... иә
Dialogue: 0,0:13:50.41,0:13:52.87,Default,,0,0,0,,Өлгеннен кейін жаның не болады?
Dialogue: 0,0:13:53.45,0:13:56.25,Default,,0,0,0,,Ол сол жердегі өсімдіктерде тіршілік ете ме?
Dialogue: 0,0:13:56.33,0:13:59.58,Default,,0,0,0,,Аспанға ұшып, құс боласың ба?
Dialogue: 0,0:14:00.08,0:14:01.46,Default,,0,0,0,,-Кешіріңіз - (Таро) А?
Dialogue: 0,0:14:01.54,0:14:05.63,Default,,0,0,0,,Сол кезде айтқаным, бірақ түсінбеймін.
Dialogue: 0,0:14:07.59,0:14:10.89,Default,,0,0,0,,Бірақ менің ойымша, жан бар.
Dialogue: 0,0:14:11.68,0:14:14.31,Default,,0,0,0,,Мен сол кезде сенімді болдым
Dialogue: 0,0:14:14.39,0:14:18.27,Default,,0,0,0,,Кондо мырза мен Серизава мырзаның екі жаны
Dialogue: 0,0:14:18.35,0:14:20.19,Default,,0,0,0,,Өйткені мен саған тиіскендей болдым
Dialogue: 0,0:14:24.78,0:14:27.03,Default,,0,0,0,,Маған Серизава мырза айтты.
Dialogue: 0,0:14:27.53,0:14:29.15,Default,,0,0,0,,Мен қателеспеймін
Dialogue: 0,0:14:31.03,0:14:33.70,Default,,0,0,0,,Мен әлсіздерге, қиналғандарға көмектескім келеді.
Dialogue: 0,0:14:34.24,0:14:36.08,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:14:36.58,0:14:40.08,Default,,0,0,0,,Серизава мырзаның Кондо мырзаны тастап кеткен жері—
Dialogue: 0,0:14:41.13,0:14:42.59,Default,,0,0,0,,Миброда жұмыс істеу
Dialogue: 0,0:14:44.30,0:14:45.42,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:14:45.50,0:14:48.55,Default,,0,0,0,,Мұны естіп, көңілім босап кетті.
Dialogue: 0,0:14:49.17,0:14:51.80,Default,,0,0,0,,Менің де айтайын дегенім бар еді.
Dialogue: 0,0:14:51.89,0:14:53.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:54.76,0:14:56.14,Default,,0,0,0,,«Танака»!?
Dialogue: 0,0:14:56.72,0:15:00.44,Default,,0,0,0,,Бұл кім? Оған лайықты атау беріңіз
Dialogue: 0,0:15:00.52,0:15:02.06,Default,,0,0,0,,Сен тозаққа түскенде
Dialogue: 0,0:15:02.15,0:15:05.77,Default,,0,0,0,,Мен Серизава мырзадан менімен тағы бір кесе айырбастауын өтінемін.
Dialogue: 0,0:15:05.86,0:15:07.28,Default,,0,0,0,,Кубок?
Dialogue: 0,0:15:07.36,0:15:09.28,Default,,0,0,0,,Егер тым алысқа кетсек, Радио ғимаратында дүрбелең болады,
Dialogue: 0,0:15:10.28,0:15:14.41,Default,,0,0,0,,Бүгіннен бастап менің атым Таро Серизава.
Dialogue: 0,0:15:14.49,0:15:15.41,Default,,0,0,0,,Га
Dialogue: 0,0:15:15.49,0:15:16.41,Default,,0,0,0,,Га
Dialogue: 0,0:15:16.49,0:15:21.33,Default,,0,0,0,,Мүмкін Серизава мырзаның жанының бір бөлігі менің ішімде жатқан шығар, солай ма?
Dialogue: 0,0:15:22.83,0:15:26.75,Default,,0,0,0,,«Таро-сама» Мен сені ақырында осылай атаймын.
Dialogue: 0,0:15:28.13,0:15:29.42,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:15:29.51,0:15:31.01,Default,,0,0,0,,Мен де айтайын.
Dialogue: 0,0:15:31.59,0:15:34.72,Default,,0,0,0,,Балалар, сендер мені ұрдым деп ойлайсыңдар, солай ма?
Dialogue: 0,0:15:34.80,0:15:36.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:36.35,0:15:40.14,Default,,0,0,0,,Бұл жолы артта қалғаным рас.
Dialogue: 0,0:15:40.98,0:15:43.23,Default,,0,0,0,,Таро маған жақсы қарады.
Dialogue: 0,0:15:43.85,0:15:46.94,Default,,0,0,0,,Менің жауапкершілігім ең ауыр жұмыс болды.
Dialogue: 0,0:15:47.44,0:15:50.69,Default,,0,0,0,,Балалар сендер тапсырманы жақсы орындадыңдар.
Dialogue: 0,0:15:50.78,0:15:52.57,Default,,0,0,0,,Бұл сөзсіз дұрыс
Dialogue: 0,0:15:53.82,0:15:54.66,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:55.66,0:15:58.41,Default,,0,0,0,,Бірақ мен жеңілмеймін!
Dialogue: 0,0:15:58.49,0:16:01.66,Default,,0,0,0,,Мен саған болашақта ешқашан ештеңе істемеймін!
Dialogue: 0,0:16:02.58,0:16:05.63,Default,,0,0,0,,Мен сендерден ұтыла алмаймын.
Dialogue: 0,0:16:06.25,0:16:07.67,Default,,0,0,0,,Кіріспе
Dialogue: 0,0:16:08.50,0:16:10.13,Default,,0,0,0,,Хаджиме-кун
Dialogue: 0,0:16:11.59,0:16:13.30,Default,,0,0,0,,- (Таро) Пфф - Ой... Эй!
Dialogue: 0,0:16:13.38,0:16:14.59,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:16:14.68,0:16:16.55,Default,,0,0,0,,Жоқ, өйткені
Dialogue: 0,0:16:17.05,0:16:19.72,Default,,0,0,0,,Мен бұл соққыларды біртүрлі деп ойладым.
Dialogue: 0,0:16:19.81,0:16:22.35,Default,,0,0,0,,Иә!? Менің ойымша, сіз мұны жасадыңыз!
Dialogue: 0,0:16:22.43,0:16:24.27,Default,,0,0,0,,А Хажиме-кун, сабыр ет!
Dialogue: 0,0:16:24.35,0:16:25.48,Default,,0,0,0,,Жібер!
Dialogue: 0,0:16:26.73,0:16:29.07,Default,,0,0,0,,Сіз жеңілдіңіз, мойындауыңыз керек.
Dialogue: 0,0:16:29.15,0:16:30.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:30.23,0:16:31.99,Default,,0,0,0,,Жоғары
Dialogue: 0,0:16:32.07,0:16:33.90,Default,,0,0,0,,Фуфуфуфу… Гахахахаха…
Dialogue: 0,0:16:33.99,0:16:36.12,Default,,0,0,0,,Бұл жігітке Серизаваның жаны бар.
Dialogue: 0,0:16:36.20,0:16:37.62,Default,,0,0,0,,Тоқта, бұл арсыздық!
Dialogue: 0,0:16:37.70,0:16:38.83,Default,,0,0,0,,Иә
Dialogue: 0,0:16:39.99,0:16:43.37,Default,,0,0,0,,Маған уайымдап келдің бе? Нагакура мырза да.
Dialogue: 0,0:16:43.46,0:16:44.29,Default,,0,0,0,,Соджи
Dialogue: 0,0:16:45.04,0:16:49.67,Default,,0,0,0,,Олар Mibro негізгі блогының алдында жинала алатын сияқты.
Dialogue: 0,0:16:49.75,0:16:53.51,Default,,0,0,0,,Хмф... Бұл жерде таңғаларлық ештеңе жоқ.
Dialogue: 0,0:16:53.59,0:16:56.80,Default,,0,0,0,,Жүрегімен байланысқан адамдар шыншыл болады.
Dialogue: 0,0:16:56.89,0:17:00.26,Default,,0,0,0,,Қарғыс атсын, маған да түс, Серизава~!
Dialogue: 0,0:17:00.35,0:17:01.01,Default,,0,0,0,,Ендеше тоқтат!
Dialogue: 0,0:17:01.01,0:17:02.81,Default,,0,0,0,,Ендеше тоқтат!
Dialogue: 0,0:17:01.01,0:17:02.81,Default,,0,0,0,,(Нио күлді)
Dialogue: 0,0:17:02.81,0:17:04.10,Default,,0,0,0,,(Нио күлді)
Dialogue: 0,0:17:04.18,0:17:06.15,Default,,0,0,0,,Бұл дүние қатыгез
Dialogue: 0,0:17:07.35,0:17:09.11,Default,,0,0,0,,Әркім өз орнында
Dialogue: 0,0:17:09.19,0:17:11.53,Default,,0,0,0,,Әр адамның өз рөлі бар
Dialogue: 0,0:17:12.19,0:17:13.94,Default,,0,0,0,,Олар бір-бірімен төбелеседі
Dialogue: 0,0:17:14.70,0:17:16.36,Default,,0,0,0,,Кейде біреудің сөзін кесіп тастайды
Dialogue: 0,0:17:16.95,0:17:19.03,Default,,0,0,0,,Кейде аяусыз шешім қабылдау
Dialogue: 0,0:17:19.78,0:17:23.37,Default,,0,0,0,,Заман ағымында күресу
Dialogue: 0,0:17:23.95,0:17:28.04,Default,,0,0,0,,Бірақ мен адасып кететініме сенімдімін, егер күресе берсем
Dialogue: 0,0:17:28.83,0:17:31.21,Default,,0,0,0,,Бір жерде құтқарылу бар емес пе?
Dialogue: 0,0:17:31.88,0:17:35.72,Default,,0,0,0,,Енді соған сеніп, әрі қарай жүруім керек.
Dialogue: 0,0:17:37.30,0:17:39.22,Default,,0,0,0,,Серизаваның бейіті
Dialogue: 0,0:17:39.30,0:17:41.10,Default,,0,0,0,,Ол осы Мибу-дера храмында салынған.
Dialogue: 0,0:17:41.85,0:17:43.68,Default,,0,0,0,,Мен өлсем де Мибро ма?
Dialogue: 0,0:17:43.77,0:17:45.48,Default,,0,0,0,,Жарайды, солай сияқты.
Dialogue: 0,0:17:46.44,0:17:47.27,Default,,0,0,0,,Иә
Dialogue: 0,0:17:48.44,0:17:51.82,Default,,0,0,0,,Бірақ сарбаздар саны айтарлықтай азайды.
Dialogue: 0,0:17:51.90,0:17:53.78,Default,,0,0,0,,Ол жиынтыққа да байланысты.
Dialogue: 0,0:17:53.86,0:17:56.74,Default,,0,0,0,,Ха, олай емес сияқты.
Dialogue: 0,0:17:56.82,0:17:57.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:04.04,0:18:07.83,Default,,0,0,0,,Әлемнің билеушісі лорд Серизава тұрған жер осы ма?
Dialogue: 0,0:18:08.50,0:18:11.29,Default,,0,0,0,,Бұл Сенгокуяри Санджуро аңғары
Dialogue: 0,0:18:11.38,0:18:14.30,Default,,0,0,0,,Такаматуру отбасымен Мибуға қосылады
Dialogue: 0,0:18:14.38,0:18:17.17,Default,,0,0,0,,-(Тани) Нухахаха... -Бұл Серизаваның мұрасы.
Dialogue: 0,0:18:17.26,0:18:20.64,Default,,0,0,0,,Мен қайтып келдім!
Dialogue: 0,0:18:20.72,0:18:21.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:22.22,0:18:25.22,Default,,0,0,0,,Менмін, тұйыққа тірелдім!
Dialogue: 0,0:18:25.31,0:18:26.85,Default,,0,0,0,,Балалар, мені күттірдіңдер.
Dialogue: 0,0:18:26.93,0:18:28.02,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:18:28.10,0:18:29.27,Default,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:18:29.35,0:18:31.81,Default,,0,0,0,,Мен міндетті түрде қайтамын!
Dialogue: 0,0:18:31.90,0:18:34.53,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:18:34.61,0:18:35.86,Default,,0,0,0,,Фукурокоджи мырза
Dialogue: 0,0:18:35.94,0:18:37.99,Default,,0,0,0,,Мына басқа қараңыз.
Dialogue: 0,0:18:38.07,0:18:41.91,Default,,0,0,0,,Мен саған Фукурокодзи-саманың күшін көрсетемін, оның денесі мен санасы қайта туды.
Dialogue: 0,0:18:41.99,0:18:43.41,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:18:43.49,0:18:46.50,Default,,0,0,0,,Бірақ сыртқы түрі ішіндегіні өзгертсе, бұл туралы алаңдаудың қажеті жоқ.
Dialogue: 0,0:18:46.58,0:18:48.37,Default,,0,0,0,,Гах... кенет улы!
Dialogue: 0,0:18:48.46,0:18:50.58,Default,,0,0,0,,Мейірімділігің қайда?
Dialogue: 0,0:18:52.46,0:18:54.96,Default,,0,0,0,,Айзу мырзаның хабарламасы болса да.
Dialogue: 0,0:18:55.05,0:18:58.38,Default,,0,0,0,,Мен олар Мибу Роши-гумидің атын өзгертеді деп ешқашан ойламадым.
Dialogue: 0,0:19:00.93,0:19:01.80,Default,,0,0,0,,Тоши
Dialogue: 0,0:19:02.72,0:19:05.47,Default,,0,0,0,,Мен Серизава мырза жасаған Мибро мұраға аламын.
Dialogue: 0,0:19:06.68,0:19:08.43,Default,,0,0,0,,Аты маңызды емес
Dialogue: 0,0:19:12.19,0:19:13.52,Default,,0,0,0,,Төре
Dialogue: 0,0:19:13.61,0:19:16.15,Default,,0,0,0,,Бұл Серизаваның ақ хаориі
Dialogue: 0,0:19:16.23,0:19:19.74,Default,,0,0,0,,Бұл сіздің шешіміңіз және оның дәлелі.
Dialogue: 0,0:19:19.82,0:19:22.45,Default,,0,0,0,,Мен саған бұны кимеймін дедім.
Dialogue: 0,0:19:22.53,0:19:25.24,Default,,0,0,0,,Ондай болмаса да, мен бекінемін.
Dialogue: 0,0:19:30.08,0:19:31.87,Default,,0,0,0,,Не... не істеп жатырсың!
Dialogue: 0,0:19:31.96,0:19:34.33,Default,,0,0,0,,Сіз мұны жалғыз жасай алмайсыз.
Dialogue: 0,0:19:34.42,0:19:36.96,Default,,0,0,0,,Ол кісінің ессіздігі сенікі емес.
Dialogue: 0,0:19:37.67,0:19:38.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:39.92,0:19:42.09,Default,,0,0,0,,Мен мына жеңді киемін
Dialogue: 0,0:19:42.93,0:19:46.05,Default,,0,0,0,,Мен Миброның бір қолы боламын.
Dialogue: 0,0:19:46.68,0:19:50.31,Default,,0,0,0,,Сенің қолыңнан келмейтін нәрсені мен істеймін.
Dialogue: 0,0:19:55.73,0:19:56.57,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:19:57.32,0:19:58.48,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:01.32,0:20:02.15,Default,,0,0,0,,Кеттік
Dialogue: 0,0:20:05.82,0:20:09.62,Default,,0,0,0,,Ұйымға «оны» кім әкелді?
Dialogue: 0,0:20:10.29,0:20:13.08,Default,,0,0,0,,Ой мен философия жай ғана безендіру
Dialogue: 0,0:20:13.79,0:20:18.55,Default,,0,0,0,,Дін де, тәртіп те, рөл де, мақсат та шешуші емес.
Dialogue: 0,0:20:19.25,0:20:22.42,Default,,0,0,0,,Кез келген адам ақылдырақ болуы мүмкін еді.
Dialogue: 0,0:20:22.51,0:20:25.30,Default,,0,0,0,,Қозғалатын қолдар бір-бірін алмастырады.
Dialogue: 0,0:20:25.39,0:20:30.39,Default,,0,0,0,,Қанша аяғым көтеріп жүрсе де, мен алға жылжыған болуым керек.
Dialogue: 0,0:20:30.89,0:20:35.65,Default,,0,0,0,,Бұрын да, кейін де ешқашан көрінбейтін біртүрлі топ
Dialogue: 0,0:20:36.90,0:20:40.65,Default,,0,0,0,,Тек жан ғана ерекше болды.
Dialogue: 0,0:20:41.94,0:20:43.82,Default,,0,0,0,,Ұйым қалай аталады?
Dialogue: 0,0:20:44.74,0:20:46.57,Default,,0,0,0,,«Шинсенгуми»
Dialogue: 0,0:20:59.54,0:21:02.21,Default,,0,0,0,,Бұл жан туралы хикая
Dialogue: 0,0:21:03.17,0:21:05.97,Default,,0,0,0,,Жан спираль салады
Dialogue: 0,0:21:07.05,0:21:11.72,Default,,0,0,0,,Мүмкін сіздің сүйікті адамыңыз бір күні жоғалып кетсе де...
Dialogue: 0,0:21:18.77,0:21:20.27,Default,,0,0,0,,Иори!
Dialogue: 0,0:21:20.36,0:21:22.07,Default,,0,0,0,,Бұл жаман, Иори.
Dialogue: 0,0:21:22.15,0:21:24.70,Default,,0,0,0,,Көрші ауылдан келген жезөкше генералдар шабуыл жасап жатыр!
Dialogue: 0,0:21:24.78,0:21:26.45,Default,,0,0,0,,Хмм…
Dialogue: 0,0:21:26.53,0:21:29.49,Default,,0,0,0,,Неге ақымақ көрінесің, Иори?
Dialogue: 0,0:21:29.57,0:21:30.62,Default,,0,0,0,,Сукцессия
Dialogue: 0,0:21:30.70,0:21:32.70,Default,,0,0,0,,Маған сенің көмегің керек
Dialogue: 0,0:21:32.79,0:21:33.83,Default,,0,0,0,,Тасбақа...
Dialogue: 0,0:21:34.50,0:21:36.46,Default,,0,0,0,,Тасбақалар кейінірек! Оны жай қалдырыңыз!
Dialogue: 0,0:21:36.54,0:21:38.33,Default,,0,0,0,,Міне! Бұл жерде!
Dialogue: 0,0:21:38.42,0:21:40.34,Default,,0,0,0,,А, қарашы, міне!
Dialogue: 0,0:21:40.42,0:21:42.71,Default,,0,0,0,,- (Цугицугу) Қараңыз - (Иори) Иә.
Dialogue: 0,0:21:42.80,0:21:44.34,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:21:44.42,0:21:46.43,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:21:46.51,0:21:49.72,Default,,0,0,0,,Тұқым қуалайтын жан туралы әңгіме
Dialogue: 0,0:21:51.01,0:21:56.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:16.68,0:23:20.98,Default,,0,0,0,,～♪
