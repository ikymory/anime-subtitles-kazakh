Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:50.22,0:00:55.22,Default,,0,0,0,,(Соғыс ұшағы қозғалтқышының дыбысы)
Dialogue: 0,0:01:05.24,0:01:10.24,Default,,0,0,0,,(бомбаны тастау дыбысы)
Dialogue: 0,0:01:10.24,0:01:12.25,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:01:12.25,0:01:16.25,Default,,0,0,0,,<1945 жылғы 8 желтоқсан Жапония
Dialogue: 0,0:01:16.25,0:01:18.25,Default,,0,0,0,,Америка Ұлыбритания сияқты одақтас күштерге қарсы
Dialogue: 0,0:01:18.25,0:01:22.26,Default,,0,0,0,,Тынық мұхиты соғысына кіру>
Dialogue: 0,0:01:22.26,0:01:24.26,Default,,0,0,0,,<4 жыл 1945 жылы өтті
Dialogue: 0,0:01:24.26,0:01:28.26,Default,,0,0,0,,Америка әскерлері бірінен соң бірі Тынық мұхитына шабуыл жасады.
Dialogue: 0,0:01:28.26,0:01:32.27,Default,,0,0,0,,Майдан шебі материктік Жапонияға бағытталды>
Dialogue: 0,0:01:32.27,0:01:35.27,Default,,0,0,0,,<Жапондық әуе базаларын алдын ала жойды
Dialogue: 0,0:01:35.27,0:01:38.27,Default,,0,0,0,,Американың 20-шы бомбалаушы корпусы
Dialogue: 0,0:01:38.27,0:01:43.28,Default,,0,0,0,,Боинг 29 ұшақтарының үлкен құрамы бойынша аспан бекінісі деп аталды
Dialogue: 0,0:01:43.28,0:01:48.21,Default,,0,0,0,,Материктік Жапонияны кілеммен бомбалау басталды>
Dialogue: 0,0:01:48.21,0:01:51.22,Default,,0,0,0,,<Оны адамдар алғаш рет басынан өткерді.
Dialogue: 0,0:01:51.22,0:01:54.22,Default,,0,0,0,,Қатты әуе шабуылы болды>
Dialogue: 0,0:01:58.22,0:02:02.23,Default,,0,0,0,,<Екінші жағынан, Америкада оны «Манхэттен жобасы» деп атайды.
Dialogue: 0,0:02:02.23,0:02:05.23,Default,,0,0,0,,Ғалымдар, соның ішінде Оппенгеймер
Dialogue: 0,0:02:05.23,0:02:08.23,Default,,0,0,0,,Үш жыл бойы зерттеуді жалғастыру
Dialogue: 0,0:02:08.23,0:02:12.24,Default,,0,0,0,,Ядролық қаруды өндіру аяқталуға жақын болды>
Dialogue: 0,0:02:12.24,0:02:17.24,Default,,0,0,0,,(Әуе шабуылы туралы ескерту)
Dialogue: 0,0:02:22.25,0:02:27.25,Default,,0,0,0,,Әуе шабуылы туралы ескерту жойылды!
Dialogue: 0,0:02:27.25,0:02:32.26,Default,,0,0,0,,Әуе шабуылы туралы ескерту жойылды!
Dialogue: 0,0:02:32.26,0:02:38.26,Default,,0,0,0,,Иә! (Ер) Әуе шабуылы туралы ескерту жойылды!
Dialogue: 0,0:02:47.21,0:02:49.21,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:02:49.21,0:02:51.21,Default,,0,0,0,,Қысқартылған сан
Dialogue: 0,0:02:51.21,0:02:54.21,Default,,0,0,0,,Жүр, далаға барайық (Кибінің жылауы)
Dialogue: 0,0:02:54.21,0:02:57.22,Default,,0,0,0,,Әке, біз бұл бидайды жақын арада жей аламыз.
Dialogue: 0,0:02:57.22,0:02:59.22,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:02:59.22,0:03:02.22,Default,,0,0,0,,Жарайды, мен саған нан пісіріп берейін.
Dialogue: 0,0:03:02.22,0:03:06.23,Default,,0,0,0,,Мен сізге көп-көп удон кеспесін дайындаймын.
Dialogue: 0,0:03:06.23,0:03:08.23,Default,,0,0,0,,Бас?
Dialogue: 0,0:03:08.23,0:03:11.23,Default,,0,0,0,,Синдзи (Шиндзи) иә?
Dialogue: 0,0:03:11.23,0:03:16.24,Default,,0,0,0,,Бидай өседі Бидай өскіндері қақаған қыста
Dialogue: 0,0:03:16.24,0:03:20.24,Default,,0,0,0,,Талай рет басқан, Жерге нық орнаған
Dialogue: 0,0:03:20.24,0:03:23.24,Default,,0,0,0,,Аяз да, жел де, қар да соқса да көніп, түзу өсемін.
Dialogue: 0,0:03:23.24,0:03:26.25,Default,,0,0,0,,Жіңішке құлақтар жасаңыз
Dialogue: 0,0:03:26.25,0:03:28.25,Default,,0,0,0,,«Сен де бидайдай мықты бол!»
Dialogue: 0,0:03:28.25,0:03:31.25,Default,,0,0,0,,Дұрыс па? Естуден шаршадым, әке.
Dialogue: 0,0:03:31.25,0:03:34.25,Default,,0,0,0,,О? Бұл жігіт! Уау Yahoo!
Dialogue: 0,0:03:34.25,0:03:37.26,Default,,0,0,0,,Вай Вай! Қаш, қаш!
Dialogue: 0,0:03:37.26,0:03:40.26,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:03:40.26,0:03:43.26,Default,,0,0,0,,Ия, жүгір! Яййй!
Dialogue: 0,0:03:43.26,0:03:46.16,Default,,0,0,0,,Вай Вай!
Dialogue: 0,0:03:48.20,0:03:50.20,Default,,0,0,0,,Оля!
Dialogue: 0,0:03:50.20,0:04:10.22,Default,,0,0,0,,Сен
Dialogue: 0,0:04:10.22,0:04:30.24,Default,,0,0,0,,Сен
Dialogue: 0,0:04:30.24,0:04:50.20,Default,,0,0,0,,Сен
Dialogue: 0,0:04:50.20,0:05:10.22,Default,,0,0,0,,Сен
Dialogue: 0,0:05:10.22,0:05:12.22,Default,,0,0,0,,Сен
Dialogue: 0,0:05:12.22,0:05:15.22,Default,,0,0,0,,Нобуо Ояма Мен соғысқа аттанғалы тұрмын!
Dialogue: 0,0:05:15.22,0:05:17.22,Default,,0,0,0,,Келгеніңізге рахмет!
Dialogue: 0,0:05:17.22,0:05:20.23,Default,,0,0,0,,Нобуо Ояма аман болсын!
Dialogue: 0,0:05:20.23,0:05:24.23,Default,,0,0,0,,Аман болсын! Ура! Ура!
Dialogue: 0,0:05:24.23,0:05:29.24,Default,,0,0,0,,♪Батыл болып, жеңемін деп айт
Dialogue: 0,0:05:29.24,0:05:34.24,Default,,0,0,0,,♪Туған жерімнен жаңа шыққаннан бері
Dialogue: 0,0:05:34.24,0:05:39.25,Default,,0,0,0,,♪Ешқандай несие алмай өлуім керек пе?
Dialogue: 0,0:05:39.25,0:05:44.25,Default,,0,0,0,,♪ Шеру керней Мен естіген сайын
Dialogue: 0,0:05:44.25,0:05:49.19,Default,,0,0,0,,♪Қабақтарыңда қалықтаған жалау толқындары
Dialogue: 0,0:05:49.19,0:05:56.20,Default,,0,0,0,,Аман болсын! Ура! Ура!
Dialogue: 0,0:05:56.20,0:06:00.20,Default,,0,0,0,,♪Әскери деп ойламайсың ба
Dialogue: 0,0:06:00.20,0:06:04.20,Default,,0,0,0,,♪Ақшаның тостағанына ♪Ақшаның шетіне
Dialogue: 0,0:06:04.20,0:06:07.21,Default,,0,0,0,,♪Мен Будда болғандай.
Dialogue: 0,0:06:07.21,0:06:12.21,Default,,0,0,0,,♪ Толық тамақтану дегеніміз не?
Dialogue: 0,0:06:12.21,0:06:15.21,Default,,0,0,0,,Менің қарным ашты, иә...
Dialogue: 0,0:06:15.21,0:06:18.22,Default,,0,0,0,,Менің басым айналып кетті.
Dialogue: 0,0:06:18.22,0:06:20.22,Default,,0,0,0,,
Dialogue: 0,0:06:20.22,0:06:24.22,Default,,0,0,0,,Әй, бүгінгі күріш ботқасы өте бай!
Dialogue: 0,0:06:24.22,0:06:29.23,Default,,0,0,0,,Шынымен бе? О, бұл рас
Dialogue: 0,0:06:29.23,0:06:33.23,Default,,0,0,0,,Қараңдаршы, бүгінгі күріш ботқасы керемет! Мен таяқшаларыма шыдай аламын!
Dialogue: 0,0:06:33.23,0:06:39.24,Default,,0,0,0,,(шулы дауыс)
Dialogue: 0,0:06:39.24,0:06:42.24,Default,,0,0,0,,Ах! Әке, мен де күріш ботқасын жегім келеді.
Dialogue: 0,0:06:42.24,0:06:45.18,Default,,0,0,0,,Мен жегім келеді (еркек) мммммммм
Dialogue: 0,0:06:45.18,0:06:49.18,Default,,0,0,0,,Күте тұрыңыз, сіз белгіленген тағам билеттерін таусылғансыз.
Dialogue: 0,0:06:49.18,0:06:51.18,Default,,0,0,0,,Олай болмаса, жегім келеді.
Dialogue: 0,0:06:51.18,0:06:54.19,Default,,0,0,0,,Мен жегім келеді (еркек) Сөзіңді бөлме, бейбақ!
Dialogue: 0,0:06:54.19,0:06:57.19,Default,,0,0,0,,Не!? Менің кезегім болды деп ойлаймын.
Dialogue: 0,0:06:57.19,0:06:59.19,Default,,0,0,0,,Бұл қиын. Шағымдамаңыз. (Ер) Не? бұл!
Dialogue: 0,0:06:59.19,0:07:02.19,Default,,0,0,0,,Иә! (Еркек) Сен солай істедің, бейбақ!
Dialogue: 0,0:07:02.19,0:07:04.20,Default,,0,0,0,,Бұл! (соққы дыбысы)
Dialogue: 0,0:07:04.20,0:07:06.20,Default,,0,0,0,,Иә! О, құдайым!
Dialogue: 0,0:07:06.20,0:07:09.20,Default,,0,0,0,,Не болып жатыр? Қарғыс атсын!
Dialogue: 0,0:07:09.20,0:07:13.21,Default,,0,0,0,,Ересек адамның бір тостаған күріш ботқасымен мұны істей алмайтыны өкінішті.
Dialogue: 0,0:07:13.21,0:07:17.21,Default,,0,0,0,,Бір кесе күріш ботқасы жеткілікті.
Dialogue: 0,0:07:19.21,0:07:23.22,Default,,0,0,0,,Менің қарным ашты! (Синджи) Мен үйдемін!
Dialogue: 0,0:07:23.22,0:07:26.22,Default,,0,0,0,,Ой... ой, қарным ашты~
Dialogue: 0,0:07:26.22,0:07:29.22,Default,,0,0,0,,Маған дәл қазір бірдеңе жеу керек!
Dialogue: 0,0:07:29.22,0:07:31.22,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:07:39.23,0:07:44.24,Default,,0,0,0,,Әй, анашым, сіз алдап жатырсыз! Сіз картопты жасырдыңыз ба?
Dialogue: 0,0:07:44.24,0:07:47.17,Default,,0,0,0,,Аруса Синдзи биі!
Dialogue: 0,0:07:47.17,0:07:49.17,Default,,0,0,0,,Сонымен, сіз жалғыз тамақ ішуді жоспарлап отырсыз ба? (Синджи) Келме! Келме!
Dialogue: 0,0:07:49.17,0:07:53.18,Default,,0,0,0,,Күте тұрыңыз~! Оля!
Dialogue: 0,0:07:53.18,0:07:56.18,Default,,0,0,0,,Мұны күтіңіз! Оля! Бұл менікі!
Dialogue: 0,0:07:56.18,0:08:00.19,Default,,0,0,0,,Күтіңіз! Оля!
Dialogue: 0,0:08:00.19,0:08:03.19,Default,,0,0,0,,Ей, жібер, ақымақ!
Dialogue: 0,0:08:03.19,0:08:06.19,Default,,0,0,0,,(шулы дауыс)
Dialogue: 0,0:08:06.19,0:08:08.19,Default,,0,0,0,,Менің қашып кетуіме жол берме.
Dialogue: 0,0:08:08.19,0:08:10.20,Default,,0,0,0,,Бұл Ватари-сан!
Dialogue: 0,0:08:10.20,0:08:12.20,Default,,0,0,0,,Сіз тітіркендіргіш бейбақ!
Dialogue: 0,0:08:12.20,0:08:17.20,Default,,0,0,0,,Мына жігітті күт! Бұл жігіт...
Dialogue: 0,0:08:17.20,0:08:20.21,Default,,0,0,0,,Ннн! (Эйко) Ах
Dialogue: 0,0:08:20.21,0:08:23.21,Default,,0,0,0,,Мынау ақымақ баклажан! Эй, ақымақ!
Dialogue: 0,0:08:23.21,0:08:26.21,Default,,0,0,0,,Ннннннн Оля, күте тұр, о!
Dialogue: 0,0:08:26.21,0:08:29.21,Default,,0,0,0,,Ой...
Dialogue: 0,0:08:29.21,0:08:31.22,Default,,0,0,0,,О, ауырып тұр! Кяах!
Dialogue: 0,0:08:31.22,0:08:35.22,Default,,0,0,0,,Ах! Күте тұрыңыз, эй!
Dialogue: 0,0:08:35.22,0:08:37.22,Default,,0,0,0,,Ах! Боке!
Dialogue: 0,0:08:37.22,0:08:40.23,Default,,0,0,0,,Оля оля! Ватари-сан, мынау!
Dialogue: 0,0:08:40.23,0:08:44.23,Default,,0,0,0,,Әй, қайтар! Бұл менікі!
Dialogue: 0,0:08:44.23,0:08:48.17,Default,,0,0,0,,Екеуің тоқтаңдар! Уау, қайтар
Dialogue: 0,0:08:48.17,0:08:51.17,Default,,0,0,0,,Анам мына картопты жеуі керек.
Dialogue: 0,0:08:51.17,0:08:55.17,Default,,0,0,0,,Неліктен? Эй, неге?
Dialogue: 0,0:08:55.17,0:08:58.18,Default,,0,0,0,,Бұл тәтті картопты ана құрсағындағы нәрестеге береді.
Dialogue: 0,0:08:58.18,0:09:01.18,Default,,0,0,0,,Бұл бағалы картоп. Оны жесең,
Dialogue: 0,0:09:01.18,0:09:05.18,Default,,0,0,0,,Сәбилер өледі. Сәбилердің өлуі дұрыс емес пе?
Dialogue: 0,0:09:05.18,0:09:07.19,Default,,0,0,0,,Эйко
Dialogue: 0,0:09:07.19,0:09:09.19,Default,,0,0,0,,Бізге жарайды, оны Ген мен Шинджиге жасайық.
Dialogue: 0,0:09:09.19,0:09:13.19,Default,,0,0,0,,Анасы оянса да, бала қиналады.
Dialogue: 0,0:09:15.19,0:09:18.19,Default,,0,0,0,,Эйко... (Эйко) Жарайды, тамақтан.
Dialogue: 0,0:09:20.20,0:09:24.20,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:09:26.21,0:09:30.21,Default,,0,0,0,,Енді шыдамды болу керек, жарай ма?
Dialogue: 0,0:09:32.21,0:09:34.21,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:09:34.21,0:09:37.22,Default,,0,0,0,,Балаларға толық қарын беру
Dialogue: 0,0:09:37.22,0:09:40.22,Default,,0,0,0,,Мен саған тамақ бергім келеді (Дайкичи) Иә.
Dialogue: 0,0:09:40.22,0:09:42.22,Default,,0,0,0,,Ақша берсең де, тамақ ала алмайсың.
Dialogue: 0,0:09:42.22,0:09:44.22,Default,,0,0,0,,Бұл аянышты дүние.
Dialogue: 0,0:09:44.22,0:09:47.16,Default,,0,0,0,,Әйтеуір, бар күшімді салудан басқа амалым жоқ.
Dialogue: 0,0:09:47.16,0:09:49.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:49.16,0:09:51.16,Default,,0,0,0,,Не болды? (Кими) Бала құрсағында жатыр
Dialogue: 0,0:09:51.16,0:09:54.17,Default,,0,0,0,,Жынды болып барады, қытықтап, хехехехе
Dialogue: 0,0:09:54.17,0:09:57.17,Default,,0,0,0,,Сау бала туып берші.
Dialogue: 0,0:09:57.17,0:10:00.17,Default,,0,0,0,,Өтінемін (Кими) Менде бәрі жақсы.
Dialogue: 0,0:10:00.17,0:10:04.18,Default,,0,0,0,,Ах, мен оны қайтадан тептім (Кимие/Даикичи) Ахахах
Dialogue: 0,0:10:04.18,0:10:06.18,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:10:06.18,0:10:08.18,Default,,0,0,0,,Нәресте әрекет етеді. Бұл біртүрлі.
Dialogue: 0,0:10:08.18,0:10:12.18,Default,,0,0,0,,Хух~ Қанша қатыгез болсаң да (Синджи) ауырады!
Dialogue: 0,0:10:12.18,0:10:15.18,Default,,0,0,0,,Ахаха (Шиндзи) Хэхехе
Dialogue: 0,0:10:19.19,0:10:23.20,Default,,0,0,0,,Иә! Қозғалды, хаха, қозғалды, қозғалды
Dialogue: 0,0:10:23.20,0:10:25.20,Default,,0,0,0,,Осы қарқынмен сен ер адамсың.
Dialogue: 0,0:10:25.20,0:10:27.20,Default,,0,0,0,,Мен оны туғаннан кейін де түсінбеймін.
Dialogue: 0,0:10:27.20,0:10:30.20,Default,,0,0,0,,Синдзи маған ұл бала керек.
Dialogue: 0,0:10:30.20,0:10:32.20,Default,,0,0,0,,Ан-чан, менімен үнемі сөйлес
Dialogue: 0,0:10:32.20,0:10:34.21,Default,,0,0,0,,Бұл жолы мен айта аламын
Dialogue: 0,0:10:34.21,0:10:38.21,Default,,0,0,0,,Анашым, сіз ұл тууыңыз керек. Оны менің жанұяма айналдырмаңыз.
Dialogue: 0,0:10:38.21,0:10:42.21,Default,,0,0,0,,Егер мен Шинджидің қолбасшысы болсам, оған не үйретерімді білмеймін.
Dialogue: 0,0:10:42.21,0:10:44.22,Default,,0,0,0,,Анашым, мен сізді уайымдап жүрмін.
Dialogue: 0,0:10:44.22,0:10:48.22,Default,,0,0,0,,Қожа! Бұл сізге байланысты емес
Dialogue: 0,0:10:48.22,0:10:50.22,Default,,0,0,0,,Ой...
Dialogue: 0,0:10:50.22,0:10:54.23,Default,,0,0,0,,Қалжың... (Кими) Жай қалжың.
Dialogue: 0,0:10:54.23,0:10:56.23,Default,,0,0,0,,Синдзи - үлкен ағасы.
Dialogue: 0,0:10:56.23,0:11:00.23,Default,,0,0,0,,Бала дүниеге келгенде маған көп нәрсені айтыңызшы.
Dialogue: 0,0:11:00.23,0:11:04.24,Default,,0,0,0,,Хехе... (Барлығы) Ахаха
Dialogue: 0,0:11:04.24,0:11:06.24,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:11:06.24,0:11:08.24,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,0:11:08.24,0:11:11.24,Default,,0,0,0,,Қуаныштымын, жақында босанамын~
Dialogue: 0,0:11:11.24,0:11:15.24,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:11:21.25,0:11:26.25,Default,,0,0,0,,(Әуе шабуылы туралы ескерту)
Dialogue: 0,0:11:36.27,0:11:38.27,Default,,0,0,0,,Уф…!
Dialogue: 0,0:11:38.27,0:11:40.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.27,0:11:42.27,Default,,0,0,0,,Ген Синдзи оян!
Dialogue: 0,0:11:42.27,0:11:44.28,Default,,0,0,0,,Әуе шабуылы туралы ескерту берілді!
Dialogue: 0,0:11:44.28,0:11:49.21,Default,,0,0,0,,Әуе шабуылы туралы ескерту берілді! (айқай)
Dialogue: 0,0:11:49.21,0:11:52.22,Default,,0,0,0,,Ген Синдзи Мен әуе шабуылына қарсы панаханаға барамын.
Dialogue: 0,0:11:52.22,0:11:56.22,Default,,0,0,0,,Ұйқысы бар Тайно (Эйко) Мықты болыңыз
Dialogue: 0,0:11:56.22,0:11:59.22,Default,,0,0,0,,() ()
Dialogue: 0,0:11:59.22,0:12:02.23,Default,,0,0,0,,Синдзи! Синдзи!
Dialogue: 0,0:12:02.23,0:12:06.23,Default,,0,0,0,,Жарайды, мен сені ояттым.
Dialogue: 0,0:12:06.23,0:12:08.23,Default,,0,0,0,,
Dialogue: 0,0:12:08.23,0:12:11.24,Default,,0,0,0,,Егер Синдзи десеңіз...
Dialogue: 0,0:12:11.24,0:12:15.24,Default,,0,0,0,,Уау! Бұл күріш! Бұл нан! Бізде удон кеспесі де бар!
Dialogue: 0,0:12:15.24,0:12:17.24,Default,,0,0,0,,Өте көп! Еееее!
Dialogue: 0,0:12:17.24,0:12:21.25,Default,,0,0,0,,Иә! Ол бос...
Dialogue: 0,0:12:21.25,0:12:24.25,Default,,0,0,0,,Ан-чан, өзің тамақ ішесің бе?
Dialogue: 0,0:12:24.25,0:12:27.25,Default,,0,0,0,,Қарғыс атсын! Маған берші!
Dialogue: 0,0:12:27.25,0:12:30.26,Default,,0,0,0,,Ой! бұл!
Dialogue: 0,0:12:30.26,0:12:32.26,Default,,0,0,0,,Би! (Синджи) Менікі!
Dialogue: 0,0:12:32.26,0:12:35.26,Default,,0,0,0,,Шулы! Қат!
Dialogue: 0,0:12:35.26,0:12:38.26,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:12:38.26,0:12:41.27,Default,,0,0,0,,Польнарефф, мен сені жеңе алмаймын.
Dialogue: 0,0:12:41.27,0:12:45.20,Default,,0,0,0,,Біз не істеп жатырмыз? Хмм...
Dialogue: 0,0:12:45.20,0:12:48.21,Default,,0,0,0,,Әй... (Бала) Уау!
Dialogue: 0,0:12:48.21,0:12:52.21,Default,,0,0,0,,Шығарылды! (әуе шабуылы туралы ескерту)
Dialogue: 0,0:12:52.21,0:12:55.21,Default,,0,0,0,,Иә! Әуе шабуылына қарсы баспанаға барыңыз (бала) Бұл қорқынышты!
Dialogue: 0,0:12:55.21,0:13:01.22,Default,,0,0,0,,Уау! Уууу... (Еркек) Тезірек!
Dialogue: 0,0:13:01.22,0:13:04.22,Default,,0,0,0,,Ей, эй, мына жақта! (Дайкичи) Генерал, келіңіз!
Dialogue: 0,0:13:06.22,0:13:09.23,Default,,0,0,0,,Бомба құласа не істейсің? Ол аурады!
Dialogue: 0,0:13:09.23,0:13:11.23,Default,,0,0,0,,Мама, уайымдаудың қажеті жоқ.
Dialogue: 0,0:13:11.23,0:13:15.23,Default,,0,0,0,,Бәрібір барлау ұшағы келеді (Кимие) Ақымақ болма.
Dialogue: 0,0:13:15.23,0:13:19.23,Default,,0,0,0,,Күні кеше 4-ші бала автоматтан атқанын ұмыттыңыз ба?
Dialogue: 0,0:13:29.25,0:13:34.25,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:39.26,0:13:41.26,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:45.20,0:13:49.20,Default,,0,0,0,,Токио, Йокогама, Нагоя, Осака және Окинава
Dialogue: 0,0:13:49.20,0:13:53.21,Default,,0,0,0,,Бүкіл Жапонияның бомбаланып, өртеніп кетуіне жол берме.
Dialogue: 0,0:13:53.21,0:13:55.21,Default,,0,0,0,,Бұл әзілдейтін уақыт емес.
Dialogue: 0,0:13:55.21,0:13:58.21,Default,,0,0,0,,Дегенмен, бұл біртүрлі.
Dialogue: 0,0:13:58.21,0:14:01.21,Default,,0,0,0,,Айналадағы барлық қалалар жойылады.
Dialogue: 0,0:14:01.21,0:14:04.21,Default,,0,0,0,,Хиросима қаласына неліктен шабуыл жасалмады?
Dialogue: 0,0:14:09.22,0:14:13.23,Default,,0,0,0,,()
Dialogue: 0,0:14:13.23,0:14:17.23,Default,,0,0,0,,()
Dialogue: 0,0:14:17.23,0:14:20.23,Default,,0,0,0,,Әуе шабуылы туралы ескерту жойылды!
Dialogue: 0,0:14:20.23,0:14:23.24,Default,,0,0,0,,Бұл барлау ұшағы еді ғой, иә.
Dialogue: 0,0:14:23.24,0:14:26.24,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:14:32.24,0:14:35.25,Default,,0,0,0,,Бұл жолы да қауіпсіз болғаныңызға қуаныштымын... (Эйко)
Dialogue: 0,0:14:35.25,0:14:38.25,Default,,0,0,0,,Не болды? Анам (Кими) аа...
Dialogue: 0,0:14:38.25,0:14:40.25,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:40.25,0:14:42.25,Default,,0,0,0,,Менің басым айналып кетті...
Dialogue: 0,0:14:42.25,0:14:44.26,Default,,0,0,0,,Кими! (Эйко) Анашым!
Dialogue: 0,0:14:44.26,0:14:47.19,Default,,0,0,0,,Генерал, дәрігерді шақырыңыз! Мм... иә
Dialogue: 0,0:14:47.19,0:14:50.20,Default,,0,0,0,,Эйко, футонды қойыңыз (Эйко) Иә.
Dialogue: 0,0:14:50.20,0:14:53.20,Default,,0,0,0,,Кими! Кими!
Dialogue: 0,0:14:53.20,0:14:57.20,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Кими!
Dialogue: 0,0:14:59.20,0:15:04.21,Default,,0,0,0,,Ан-чан, сенің анаң өле ме? Анам өле ме?
Dialogue: 0,0:15:04.21,0:15:08.21,Default,,0,0,0,,Джакаашии! Мұндай жағдай болуы мүмкін бе?
Dialogue: 0,0:15:16.22,0:15:19.22,Default,,0,0,0,,Ха ха... ха...
Dialogue: 0,0:15:19.22,0:15:22.23,Default,,0,0,0,,(есік қағу)
Dialogue: 0,0:15:22.23,0:15:26.23,Default,,0,0,0,,Мұғалім, келіңіз! Анаңа қиын болса керек!
Dialogue: 0,0:15:26.23,0:15:29.23,Default,,0,0,0,,Менің құлыным анаңның ішінде.
Dialogue: 0,0:15:29.23,0:15:32.24,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:15:32.24,0:15:34.24,Default,,0,0,0,,Ах, дұрыс... Уф.
Dialogue: 0,0:15:34.24,0:15:38.24,Default,,0,0,0,,Әй, олай асықсаң өлемін.
Dialogue: 0,0:15:38.24,0:15:40.25,Default,,0,0,0,,Мұғалім өлсе де, жақсы.
Dialogue: 0,0:15:40.25,0:15:43.25,Default,,0,0,0,,Ана маңыздырақ!
Dialogue: 0,0:15:49.19,0:15:51.19,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:51.19,0:15:54.19,Default,,0,0,0,,Шамадан тыс жұмыс және дұрыс тамақтанбау
Dialogue: 0,0:15:54.19,0:16:00.20,Default,,0,0,0,,Демалсаңыз, құнарлы тамақты көп жесеңіз, сауығып кетесіз.
Dialogue: 0,0:16:00.20,0:16:02.20,Default,,0,0,0,,Аа, әрине бұл заманда.
Dialogue: 0,0:16:02.20,0:16:06.20,Default,,0,0,0,,Дәрі-дәрмек жетпей, құнарлы тағам ала алмағанда
Dialogue: 0,0:16:06.20,0:16:09.21,Default,,0,0,0,,Қалай болғанда да, сақ болыңыз
Dialogue: 0,0:16:09.21,0:16:12.21,Default,,0,0,0,,(есік дыбысы)
Dialogue: 0,0:16:12.21,0:16:14.21,Default,,0,0,0,,Бұл үлкен мәселе, бұл біздің отбасымызда болған ауыр оқиға.
Dialogue: 0,0:16:14.21,0:16:17.22,Default,,0,0,0,,Бұл үлкен мәселе, шыдай алмаймын.
Dialogue: 0,0:16:17.22,0:16:37.24,Default,,0,0,0,,Сен
Dialogue: 0,0:16:37.24,0:16:57.19,Default,,0,0,0,,Сен
Dialogue: 0,0:16:57.19,0:17:00.19,Default,,0,0,0,,Сен
Dialogue: 0,0:17:00.19,0:17:02.19,Default,,0,0,0,,Не болды? иә? Эйко
Dialogue: 0,0:17:02.19,0:17:06.20,Default,,0,0,0,,Иә... бізде күріш көп емес.
Dialogue: 0,0:17:06.20,0:17:10.20,Default,,0,0,0,,Ақша да шулайды.
Dialogue: 0,0:17:10.20,0:17:14.21,Default,,0,0,0,,Мен бұл туралы бірдеңе істеймін, бірақ сен жақсысың.
Dialogue: 0,0:17:14.21,0:17:20.21,Default,,0,0,0,,Жарайды, оны бітіріп, көтерме сатушыға жеткізіп берсеңіз, біраз ақша табасыз, солай ма?
Dialogue: 0,0:17:20.21,0:17:23.22,Default,,0,0,0,,Сіз әлсіз болуыңыз керек.
Dialogue: 0,0:17:23.22,0:17:26.22,Default,,0,0,0,,Тыныш тыныш
Dialogue: 0,0:17:26.22,0:17:28.22,Default,,0,0,0,,Эйко…
Dialogue: 0,0:17:28.22,0:17:40.23,Default,,0,0,0,,Сен
Dialogue: 0,0:17:40.23,0:17:45.13,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:17:51.18,0:17:53.18,Default,,0,0,0,,Ан-чан, бұл не?
Dialogue: 0,0:17:53.18,0:17:56.18,Default,,0,0,0,,Сіз бұл құртты жей аласыз ба?
Dialogue: 0,0:17:56.18,0:17:59.18,Default,,0,0,0,,Хоуджану... (Синдзи) Бұл нәрлі ме?
Dialogue: 0,0:17:59.18,0:18:01.19,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:18:01.19,0:18:03.19,Default,,0,0,0,,Анамды тамақтандырайын ба?
Dialogue: 0,0:18:03.19,0:18:05.19,Default,,0,0,0,,Ммм
Dialogue: 0,0:18:11.20,0:18:13.20,Default,,0,0,0,,Бақатаре! Ол аурады!
Dialogue: 0,0:18:13.20,0:18:16.20,Default,,0,0,0,,Анашым, не болды? (Синдзи) Парк-сан
Dialogue: 0,0:18:16.20,0:18:18.20,Default,,0,0,0,,Біраз шулы болған сияқты.
Dialogue: 0,0:18:18.20,0:18:23.21,Default,,0,0,0,,Анашым, сіз тамақтанбағандықтан ауырып қалдыңыз.
Dialogue: 0,0:18:23.21,0:18:25.21,Default,,0,0,0,,Мені уайымдағаны осы.
Dialogue: 0,0:18:25.21,0:18:28.21,Default,,0,0,0,,Сазанның қанын ішіп, денесін жеу
Dialogue: 0,0:18:28.21,0:18:31.22,Default,,0,0,0,,Мен қатты толқып тұрмын
Dialogue: 0,0:18:31.22,0:18:35.22,Default,,0,0,0,,Сазан? тұқы?
Dialogue: 0,0:18:35.22,0:18:38.22,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:18:43.23,0:18:47.17,Default,,0,0,0,,Сазанның ауыратынын білмедім.
Dialogue: 0,0:18:47.17,0:18:51.17,Default,,0,0,0,,Мен анамды тамақтандырғым келеді.
Dialogue: 0,0:18:51.17,0:18:55.17,Default,,0,0,0,,Мен сазан алғым келеді! қалаймын!
Dialogue: 0,0:18:55.17,0:18:58.18,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:18:58.18,0:19:00.18,Default,,0,0,0,,Синдзи Ан-чан
Dialogue: 0,0:19:00.18,0:19:03.18,Default,,0,0,0,,Төлем! Бұл допқа ғашық!
Dialogue: 0,0:19:03.18,0:19:23.20,Default,,0,0,0,,Сен
Dialogue: 0,0:19:23.20,0:19:33.21,Default,,0,0,0,,Сен
Dialogue: 0,0:19:33.21,0:19:35.21,Default,,0,0,0,,Тас, қағаз, қайшы Әй!
Dialogue: 0,0:19:35.21,0:19:37.22,Default,,0,0,0,,Хи хи хи қажырлы еңбектеріңізге рахмет
Dialogue: 0,0:19:37.22,0:19:40.22,Default,,0,0,0,,Ио-хо-хо-о-о, ауырады!
Dialogue: 0,0:19:42.22,0:19:45.16,Default,,0,0,0,,Ио... Мен қатты толқып тұрмын.
Dialogue: 0,0:19:45.16,0:19:48.16,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:19:48.16,0:19:50.16,Default,,0,0,0,,Оран оран Жарайды!
Dialogue: 0,0:19:52.16,0:19:54.17,Default,,0,0,0,,Йотто
Dialogue: 0,0:19:54.17,0:19:56.17,Default,,0,0,0,,Сиыр! Уау
Dialogue: 0,0:19:56.17,0:19:59.17,Default,,0,0,0,,Қараңдар! Апыр-ай! А... Ан-чан!
Dialogue: 0,0:19:59.17,0:20:02.17,Default,,0,0,0,,Иә, бұл мені бірден ұстады.
Dialogue: 0,0:20:02.17,0:20:04.18,Default,,0,0,0,,Дәл мен сияқты сен де жегің келмейді.
Dialogue: 0,0:20:04.18,0:20:07.18,Default,,0,0,0,,Уау, бұл қиын! Сіз тартыласыз!
Dialogue: 0,0:20:10.18,0:20:12.18,Default,,0,0,0,,Үлкен балық
Dialogue: 0,0:20:12.18,0:20:14.19,Default,,0,0,0,,Тоғанның иесі
Dialogue: 0,0:20:14.19,0:20:17.19,Default,,0,0,0,,Синдзи Таяқты жіберме (Шинджи) Ан-чан!
Dialogue: 0,0:20:17.19,0:20:22.19,Default,,0,0,0,,Оны қатты ұстаңыз, ә, мынау~!
Dialogue: 0,0:20:22.19,0:20:25.20,Default,,0,0,0,,О, мынау! Әй! Оля!
Dialogue: 0,0:20:25.20,0:20:27.20,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:20:29.20,0:20:32.20,Default,,0,0,0,,О! (Синджи) Уау!
Dialogue: 0,0:20:37.21,0:20:39.21,Default,,0,0,0,,Қарашы, Синдзи, қара!
Dialogue: 0,0:20:39.21,0:20:41.21,Default,,0,0,0,,Ан-чан, мен жасадым!
Dialogue: 0,0:20:41.21,0:20:45.22,Default,,0,0,0,,Хехе хи хи хи
Dialogue: 0,0:20:45.22,0:20:50.22,Default,,0,0,0,,Бұл ғажап, бұл тоғанның иесі ғой.
Dialogue: 0,0:20:50.22,0:20:54.23,Default,,0,0,0,,Ух... (найзағай)
Dialogue: 0,0:20:54.23,0:20:58.23,Default,,0,0,0,,Мына тұқы ұры! (Синджи) Уау!
Dialogue: 0,0:20:58.23,0:21:01.23,Default,,0,0,0,,Мына масқара! Апыр-ай! Апыр-ай!
Dialogue: 0,0:21:01.23,0:21:04.23,Default,,0,0,0,,Кешіріңіз! Апыр-ай!
Dialogue: 0,0:21:06.24,0:21:10.24,Default,,0,0,0,,Уф... Ан-чан!
Dialogue: 0,0:21:17.25,0:21:23.25,Default,,0,0,0,,Әй... қария, ұр мені, ұр! Маған көбірек ұрыңыз!
Dialogue: 0,0:21:23.25,0:21:27.26,Default,,0,0,0,,Оның орнына мені ұрғаныңа қанағаттансаң, мына сазанды бер!
Dialogue: 0,0:21:27.26,0:21:29.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:29.26,0:21:32.26,Default,,0,0,0,,Әй, маған қолыңнан келгенше ұр!
Dialogue: 0,0:21:32.26,0:21:36.26,Default,,0,0,0,,Иә? (Шинджи) Оның орнына маған сазан балық беріңіз!
Dialogue: 0,0:21:47.21,0:21:51.22,Default,,0,0,0,,Балалар, сендер сазанды неге қатты қалайсыңдар?
Dialogue: 0,0:21:51.22,0:21:54.22,Default,,0,0,0,,Анаңа сазанның қанын бер.
Dialogue: 0,0:21:54.22,0:21:58.22,Default,,0,0,0,,Ал, мен анамның көңілін көтергім келеді.
Dialogue: 0,0:22:02.23,0:22:04.23,Default,,0,0,0,,Мен анамның өлгенін қаламаймын.
Dialogue: 0,0:22:04.23,0:22:07.23,Default,,0,0,0,,Анама көмектесіңізші
Dialogue: 0,0:22:10.24,0:22:14.24,Default,,0,0,0,,Қария, өтінемін! (Синджи) Өтінемін, өтінемін
Dialogue: 0,0:22:14.24,0:22:19.24,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:22:19.24,0:22:22.25,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:22:22.25,0:22:25.25,Default,,0,0,0,,Бұл шынымен жақсы емес пе?
Dialogue: 0,0:22:25.25,0:22:29.25,Default,,0,0,0,,Қарттың ақымақ!
Dialogue: 0,0:22:29.25,0:22:31.26,Default,,0,0,0,,Анаң өлсе
Dialogue: 0,0:22:31.26,0:22:34.26,Default,,0,0,0,,Мен саған бетпердемен шық деп айтамын!
Dialogue: 0,0:22:34.26,0:22:39.26,Default,,0,0,0,,Уау! Аааааан ааааан... уфхх...
Dialogue: 0,0:22:39.26,0:22:42.27,Default,,0,0,0,,Ууааан…аа…
Dialogue: 0,0:22:42.27,0:22:47.21,Default,,0,0,0,,《Ата-анаға ұл болғың келсе, ата-анаң жоқ.》
Dialogue: 0,0:22:47.21,0:22:51.21,Default,,0,0,0,,Уууу... (Еркек) Түсіндім, ал.
Dialogue: 0,0:22:51.21,0:22:54.21,Default,,0,0,0,,Не? (Шинджи) Уф...
Dialogue: 0,0:22:54.21,0:22:57.22,Default,,0,0,0,,Сазанға алаңдама, енді жылама.
Dialogue: 0,0:22:57.22,0:22:59.22,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:22:59.22,0:23:02.22,Default,,0,0,0,,Өтірік айтсаң, мың ине ішемін!
Dialogue: 0,0:23:02.22,0:23:05.22,Default,,0,0,0,,Бақатаре! Менің саған айтып отырғаным осы
Dialogue: 0,0:23:05.22,0:23:08.23,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:23:08.23,0:23:10.23,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:23:10.23,0:23:30.25,Default,,0,0,0,,Сен
Dialogue: 0,0:23:30.25,0:23:35.25,Default,,0,0,0,,Сен
Dialogue: 0,0:23:35.25,0:23:38.26,Default,,0,0,0,,Мына тұқы шынымен өліп жатыр ма?
Dialogue: 0,0:23:38.26,0:23:42.26,Default,,0,0,0,,Бұл шынымен қызықсыз. Бұл өтірік емес.
Dialogue: 0,0:23:42.26,0:23:46.20,Default,,0,0,0,,Оның орнына мен тамақ пісіріп, анама тамақ берейін.
Dialogue: 0,0:23:46.20,0:23:49.20,Default,,0,0,0,,Қайырлы таң Қайырлы таң
Dialogue: 0,0:23:51.20,0:23:55.21,Default,,0,0,0,,Мм... Эйко, маған тамақ жасап берші.
Dialogue: 0,0:23:55.21,0:23:57.21,Default,,0,0,0,,Иә
Dialogue: 0,0:23:57.21,0:24:08.11,Default,,0,0,0,,Сен
Dialogue: 0,0:24:10.22,0:24:15.23,Default,,0,0,0,,Ан-чан, анашым, сауығып кетесіз бе?
Dialogue: 0,0:24:15.23,0:24:18.23,Default,,0,0,0,,Ходжану, сауығып кеттің деп үміттенемін.
Dialogue: 0,0:24:18.23,0:24:23.23,Default,,0,0,0,,Сізді де алаңдатқаным үшін кешіріңіз. Әкем де қолынан келгеннің бәрін жасауы керек.
Dialogue: 0,0:24:23.23,0:24:25.24,Default,,0,0,0,,Әке, біз қашан боламыз
Dialogue: 0,0:24:25.24,0:24:27.24,Default,,0,0,0,,Тойып жей аласыз ба?
Dialogue: 0,0:24:27.24,0:24:30.24,Default,,0,0,0,,Соғыс біткен соң бәрі жақсы болады.
Dialogue: 0,0:24:30.24,0:24:33.24,Default,,0,0,0,,Соғыс аяқталады ма?
Dialogue: 0,0:24:33.24,0:24:36.25,Default,,0,0,0,,Бұл соғыс жақын арада аяқталады. Жапония жеңіледі.
Dialogue: 0,0:24:36.25,0:24:40.25,Default,,0,0,0,,Жапония жеңілсе, неге олар мәңгілікке жүре береді?
Dialogue: 0,0:24:40.25,0:24:42.25,Default,,0,0,0,,Елдің қазіргі басшылары да қателеседі.
Dialogue: 0,0:24:42.25,0:24:45.19,Default,,0,0,0,,Әскери жігіттер де бірдеңе істеу керек.
Dialogue: 0,0:24:45.19,0:24:47.19,Default,,0,0,0,,Әке, сіз осылай айтасыз.
Dialogue: 0,0:24:47.19,0:24:50.19,Default,,0,0,0,,Барлығы мені азамат емес деп айтатын шығар.
Dialogue: 0,0:24:50.19,0:24:53.20,Default,,0,0,0,,Эй, сен азамат емессің.
Dialogue: 0,0:24:53.20,0:24:57.20,Default,,0,0,0,,Әкең мұны мақтан тұтса керек.
Dialogue: 0,0:24:57.20,0:25:03.21,Default,,0,0,0,,Бірін-бірі осылай өлтіретін соғыс дұрыс әрекет болуы керек.
Dialogue: 0,0:25:03.21,0:25:06.21,Default,,0,0,0,,Ұлтжанды деп атауға болмайды.
Dialogue: 0,0:25:06.21,0:25:08.21,Default,,0,0,0,,Мен қорқақ деп атауға қарсы емеспін.
Dialogue: 0,0:25:08.21,0:25:12.22,Default,,0,0,0,,Нағыз батылдық – біреудің өмірін немесе өз өміріңді қорғау.
Dialogue: 0,0:25:12.22,0:25:16.22,Default,,0,0,0,,Жалғыз нағыз күрес – сол мақсат үшін күрес.
Dialogue: 0,0:25:16.22,0:25:20.22,Default,,0,0,0,,Ген Синдзи құлдық жасама, кеудеңді тік ұстама
Dialogue: 0,0:25:20.22,0:25:22.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:26.23,0:25:28.23,Default,,0,0,0,,Әке, бұл не?
Dialogue: 0,0:25:28.23,0:25:30.23,Default,,0,0,0,,Мен әкемді жақсы көремін.
Dialogue: 0,0:25:30.23,0:25:33.24,Default,,0,0,0,,Мен де әкемді жақсы көремін.
Dialogue: 0,0:25:33.24,0:25:36.24,Default,,0,0,0,,Хоука
Dialogue: 0,0:25:36.24,0:25:38.24,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:25:38.24,0:25:41.25,Default,,0,0,0,,Тек біз балықты көп жейміз.
Dialogue: 0,0:25:41.25,0:25:46.18,Default,,0,0,0,,Не дейсің? Сенің ауырып тұрғаның көрініп тұр.
Dialogue: 0,0:25:46.18,0:25:49.19,Default,,0,0,0,,Жаман емес (Эйко) Дәмді ме?
Dialogue: 0,0:25:49.19,0:25:52.19,Default,,0,0,0,,Иә, бұл дәмді.
Dialogue: 0,0:25:52.19,0:25:54.19,Default,,0,0,0,,Синдзи
Dialogue: 0,0:25:54.19,0:25:57.20,Default,,0,0,0,,Ммм... мммм... (Кими) Не? Shinji
Dialogue: 0,0:25:57.20,0:26:01.20,Default,,0,0,0,,А... білесің бе... (Кими) А?
Dialogue: 0,0:26:05.20,0:26:09.21,Default,,0,0,0,,Ах, а... (Шинджи) А...
Dialogue: 0,0:26:09.21,0:26:14.21,Default,,0,0,0,,Ах... (Кими) Ух... Ууу...
Dialogue: 0,0:26:14.21,0:26:17.22,Default,,0,0,0,,Шинжи, анаңа не дедің!
Dialogue: 0,0:26:17.22,0:26:19.22,Default,,0,0,0,,Анам балық жеген соң
Dialogue: 0,0:26:19.22,0:26:21.22,Default,,0,0,0,,Қалған сүйектерді беруімді сұрадың.
Dialogue: 0,0:26:21.22,0:26:23.22,Default,,0,0,0,,Сіз шынымен солай айттыңыз ба?
Dialogue: 0,0:26:23.22,0:26:26.22,Default,,0,0,0,,Бұл ақымақтық!
Dialogue: 0,0:26:26.22,0:26:28.23,Default,,0,0,0,,Ах, сен ақымақ
Dialogue: 0,0:26:28.23,0:26:32.23,Default,,0,0,0,,Сен мені ұрсаң қарсы емеспін, бірақ Шинжи, жүр!
Dialogue: 0,0:26:32.23,0:26:35.23,Default,,0,0,0,,Ан-чанның бақа бақасы!
Dialogue: 0,0:26:35.23,0:26:39.24,Default,,0,0,0,,Эйко-чан Эйко-чан
Dialogue: 0,0:26:39.24,0:26:41.24,Default,,0,0,0,,Иә
Dialogue: 0,0:26:41.24,0:26:43.24,Default,,0,0,0,,Мұны барлығына беріңіз.
Dialogue: 0,0:26:43.24,0:26:46.18,Default,,0,0,0,,Не? (Саябақ) Өтінемін
Dialogue: 0,0:26:46.18,0:26:50.18,Default,,0,0,0,,Күріш? (Саябақ) Мен кішкентаймын, бірақ
Dialogue: 0,0:26:50.18,0:26:53.18,Default,,0,0,0,,Пак мырза...
Dialogue: 0,0:26:53.18,0:26:55.18,Default,,0,0,0,,Рахмет
Dialogue: 0,0:26:58.19,0:27:01.19,Default,,0,0,0,,Анчан, тұқы шынымен тиімді.
Dialogue: 0,0:27:01.19,0:27:04.20,Default,,0,0,0,,Эй, анашым, мен өзімді әлдеқайда жақсы сезінемін.
Dialogue: 0,0:27:04.20,0:27:08.20,Default,,0,0,0,,Ах! (Еркек) Кешіріңіз, Накаока-сан.
Dialogue: 0,0:27:19.21,0:27:23.21,Default,,0,0,0,,Менің үйіме анау қарт келеді деп күтпедім.
Dialogue: 0,0:27:23.21,0:27:25.22,Default,,0,0,0,,Ұлы Кочча
Dialogue: 0,0:27:25.22,0:27:27.22,Default,,0,0,0,,Сазан ұрлап жатқан жерімнен ұсталдым.
Dialogue: 0,0:27:27.22,0:27:30.22,Default,,0,0,0,,Әке: Ашуланғанда қорқынышты болады.
Dialogue: 0,0:27:30.22,0:27:34.23,Default,,0,0,0,,Солай ма? Кешіріңіз, Ако.
Dialogue: 0,0:27:34.23,0:27:38.23,Default,,0,0,0,,Мен саған ұрысамын! (Еркек) Жоқ, жоқ, тоқтатыңыз.
Dialogue: 0,0:27:38.23,0:27:41.23,Default,,0,0,0,,Анау екеуін ұрыссам, қиналып қаламын.
Dialogue: 0,0:27:41.23,0:27:46.17,Default,,0,0,0,,２
Dialogue: 0,0:27:46.17,0:27:49.17,Default,,0,0,0,,...
Dialogue: 0,0:27:49.17,0:27:52.18,Default,,0,0,0,,Сенде бар деп қызғанамын.
Dialogue: 0,0:27:52.18,0:27:54.18,Default,,0,0,0,,...
Dialogue: 0,0:27:54.18,0:27:56.18,Default,,0,0,0,,Ан-чан, не істеуіміз керек?
Dialogue: 0,0:27:56.18,0:27:59.18,Default,,0,0,0,,Бұл туралы ештеңе істей алмайсыз. Ұруға дайындалыңыз.
Dialogue: 0,0:27:59.18,0:28:02.19,Default,,0,0,0,,Уау, бұл қорқынышты.
Dialogue: 0,0:28:02.19,0:28:05.19,Default,,0,0,0,,Ген (Кими) Синдзи
Dialogue: 0,0:28:05.19,0:28:08.19,Default,,0,0,0,,Мұнда отыр (Кими) Мұнда кел.
Dialogue: 0,0:28:16.20,0:28:18.20,Default,,0,0,0,,Бас
Dialogue: 0,0:28:24.21,0:28:26.21,Default,,0,0,0,,Синдзи
Dialogue: 0,0:28:31.22,0:28:34.22,Default,,0,0,0,,Хехехе (Кими) Хэхехехе
Dialogue: 0,0:28:34.22,0:28:36.22,Default,,0,0,0,,Анчан
Dialogue: 0,0:28:36.22,0:28:38.22,Default,,0,0,0,,Хехехе
Dialogue: 0,0:28:40.22,0:28:43.23,Default,,0,0,0,,Кәрі сазан маған Куса Мочи берді.
Dialogue: 0,0:28:43.23,0:28:47.16,Default,,0,0,0,,Ан-чан, менің жақтарым түсіп кете жаздады.
Dialogue: 0,0:28:47.16,0:28:49.17,Default,,0,0,0,,Хехе, эй!
Dialogue: 0,0:28:49.17,0:28:51.17,Default,,0,0,0,,Ойчи
Dialogue: 0,0:28:51.17,0:28:54.17,Default,,0,0,0,,Анау қария, иә, ол қарт.
Dialogue: 0,0:28:54.17,0:28:57.17,Default,,0,0,0,,Жарайды, қария болсаң, мақтау қағазының керегі жоқ.
Dialogue: 0,0:28:57.17,0:29:02.17,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:29:05.18,0:29:09.19,Default,,0,0,0,,(Соғыс ұшағы қозғалтқышының дыбысы)
Dialogue: 0,0:29:09.19,0:29:13.19,Default,,0,0,0,,сол күні сағат <2:45
Dialogue: 0,0:29:13.19,0:29:16.19,Default,,0,0,0,,Мариана аралындағы АҚШ-тың Тиниан базасынан
Dialogue: 0,0:29:16.19,0:29:20.20,Default,,0,0,0,,Үш B-29 ұшады>
Dialogue: 0,0:29:20.20,0:29:22.20,Default,,0,0,0,,(жуу дыбысы)
Dialogue: 0,0:29:22.20,0:29:25.20,Default,,0,0,0,,Мама, мен кір жуайын.
Dialogue: 0,0:29:25.20,0:29:28.21,Default,,0,0,0,,Өзіңізді әлі тым қатты итермеңіз.
Dialogue: 0,0:29:28.21,0:29:32.21,Default,,0,0,0,,Иә, көп демалсаң, денең түтіккен болады.
Dialogue: 0,0:29:32.21,0:29:34.21,Default,,0,0,0,,Әке, солай ма? Бұл кеме
Dialogue: 0,0:29:34.21,0:29:37.21,Default,,0,0,0,,Ан-чан мен үшін жасады (Дайкичи).
Dialogue: 0,0:29:37.21,0:29:41.22,Default,,0,0,0,,Ан-чан, мектептен келгенде, өзенге барып, қайықты жүргіз.
Dialogue: 0,0:29:41.22,0:29:44.22,Default,,0,0,0,,Хоука, бұл қызық (әуе шабуылы туралы ескерту)
Dialogue: 0,0:29:44.22,0:29:47.16,Default,,0,0,0,,О? Жау-сан, мен бүгін қайырлы таңға келдім.
Dialogue: 0,0:29:47.16,0:29:52.16,Default,,0,0,0,,(Әуе шабуылы туралы ескерту)
Dialogue: 0,0:30:03.17,0:30:10.18,Default,,0,0,0,,()
Dialogue: 0,0:30:10.18,0:30:13.18,Default,,0,0,0,,...
Dialogue: 0,0:30:13.18,0:30:16.19,Default,,0,0,0,,Әке, бұл В-ның ұстамасы.
Dialogue: 0,0:30:16.19,0:30:19.19,Default,,0,0,0,,Қазір күн ашық, әлі ашық
Dialogue: 0,0:30:19.19,0:30:23.19,Default,,0,0,0,,Бүгін күн ыстық болады (радио: американдық солдаттың ағылшыншасы)
Dialogue: 0,0:30:29.20,0:30:32.20,Default,,0,0,0,,(Радио: американдық сарбаздарға арналған ағылшын тілі)
Dialogue: 0,0:30:32.20,0:30:36.20,Default,,0,0,0,,(жел үні)
Dialogue: 0,0:30:38.21,0:30:41.21,Default,,0,0,0,,(Маятник дыбысы)
Dialogue: 0,0:30:41.21,0:30:44.22,Default,,0,0,0,,Әпке, мен бірінші мектепке барамын.
Dialogue: 0,0:30:44.22,0:30:46.22,Default,,0,0,0,,Иә
Dialogue: 0,0:30:46.22,0:30:49.22,Default,,0,0,0,,Ан-чан, қайтып келші! Барып, кемені жүргізіңіз.
Dialogue: 0,0:30:49.22,0:30:51.22,Default,,0,0,0,,О (Синдзи) Бұл уәде!
Dialogue: 0,0:30:51.22,0:30:54.23,Default,,0,0,0,,О!
Dialogue: 0,0:30:54.23,0:30:56.23,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:30:56.23,0:31:02.23,Default,,0,0,0,,Боу?
Dialogue: 0,0:31:02.23,0:31:05.23,Default,,0,0,0,,Жарты күн…?
Dialogue: 0,0:31:08.24,0:31:10.24,Default,,0,0,0,,Әке, әпке, келіңізші.
Dialogue: 0,0:31:10.24,0:31:12.24,Default,,0,0,0,,Не? (Дайкичи) Не болды?
Dialogue: 0,0:31:12.24,0:31:15.25,Default,,0,0,0,,Үйге құмырсқалар кіріп келеді.
Dialogue: 0,0:31:15.25,0:31:19.25,Default,,0,0,0,,Бұл ғажап (Дайкичи) Мен не болады деп ойлаймын
Dialogue: 0,0:31:25.26,0:31:29.26,Default,,0,0,0,,B (әйел) Иә?
Dialogue: 0,0:31:29.26,0:31:31.26,Default,,0,0,0,,B-29
Dialogue: 0,0:31:31.26,0:31:33.26,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:31:35.27,0:31:38.27,Default,,0,0,0,,Сіз қашан келдіңіз? Бұл біртүрлі
Dialogue: 0,0:31:38.27,0:31:41.27,Default,,0,0,0,,Әуе шабуылының сиреналары естілмейді.
Dialogue: 0,0:31:41.27,0:31:43.27,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:31:43.27,0:31:58.22,Default,,0,0,0,,Сен
Dialogue: 0,0:31:58.22,0:32:03.22,Default,,0,0,0,,(электрондық дыбыс)
Dialogue: 0,0:32:08.23,0:32:12.24,Default,,0,0,0,,(Американдық сарбаздарға арналған ағылшын тілі)
Dialogue: 0,0:32:12.24,0:32:14.24,Default,,0,0,0,,(американдық солдат ағылшын)
Dialogue: 0,0:32:14.24,0:32:17.24,Default,,0,0,0,,(Американдық сарбаздарға арналған ағылшын тілі)
Dialogue: 0,0:32:35.26,0:32:40.26,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:33:00.22,0:33:02.22,Default,,0,0,0,,
Dialogue: 0,0:33:02.22,0:33:05.22,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:33:25.24,0:33:32.25,Default,,0,0,0,,
Dialogue: 0,0:33:32.25,0:33:36.25,Default,,0,0,0,,Уф…!
Dialogue: 0,0:33:42.26,0:33:44.26,Default,,0,0,0,,(терезенің сынған дыбысы)
Dialogue: 0,0:34:04.22,0:34:23.23,Default,,0,0,0,,
Dialogue: 0,0:34:23.23,0:34:28.23,Default,,0,0,0,,(үй құлаған дыбыс)
Dialogue: 0,0:34:48.19,0:35:08.21,Default,,0,0,0,,
Dialogue: 0,0:35:08.21,0:35:28.23,Default,,0,0,0,,
Dialogue: 0,0:35:28.23,0:35:30.23,Default,,0,0,0,,
Dialogue: 0,0:35:30.23,0:35:33.24,Default,,0,0,0,,Ым... ауырады, ауырады
Dialogue: 0,0:35:33.24,0:35:36.24,Default,,0,0,0,,Не болды? Мен мүлде түсінбеймін
Dialogue: 0,0:35:36.24,0:35:39.24,Default,,0,0,0,,Неліктен менде осындай нәрсе бар?
Dialogue: 0,0:35:39.24,0:35:42.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:42.25,0:35:45.18,Default,,0,0,0,,Уау! Не болды... не болды!
Dialogue: 0,0:35:45.18,0:35:47.18,Default,,0,0,0,,Мықты бол!
Dialogue: 0,0:35:47.18,0:35:51.19,Default,,0,0,0,,Сәлем! I... I'm dying...
Dialogue: 0,0:35:51.19,0:35:55.19,Default,,0,0,0,,Біреу~! Біреу өтінемін! Бұл...
Dialogue: 0,0:35:57.19,0:36:09.21,Default,,0,0,0,,Сен
Dialogue: 0,0:36:09.21,0:36:11.21,Default,,0,0,0,,Жер бетінде не болды!? Ах!
Dialogue: 0,0:36:11.21,0:36:13.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:13.21,0:36:24.22,Default,,0,0,0,,Сен
Dialogue: 0,0:36:24.22,0:36:26.22,Default,,0,0,0,,Ахх...
Dialogue: 0,0:36:26.22,0:36:36.23,Default,,0,0,0,,Сен
Dialogue: 0,0:36:36.23,0:36:47.18,Default,,0,0,0,,Сен
Dialogue: 0,0:36:47.18,0:36:52.18,Default,,0,0,0,,Бұл елес... Барлығы да елес (жылқы киді)
Dialogue: 0,0:36:55.19,0:36:58.19,Default,,0,0,0,,Бұл өрт!
Dialogue: 0,0:36:58.19,0:37:03.19,Default,,0,0,0,,It's tough! Үйі бар адам!
Dialogue: 0,0:37:03.19,0:37:10.09,Default,,0,0,0,,Dad! Анашым! Әпке! Shinji~!
Dialogue: 0,0:37:12.20,0:37:17.21,Default,,0,0,0,,Сәлем әке!
Dialogue: 0,0:37:17.21,0:37:21.21,Default,,0,0,0,,Анашым! Әпке! Синдзи!
Dialogue: 0,0:37:21.21,0:37:24.21,Default,,0,0,0,,Someone! Біреу келіп, қамқорлық жасайды!
Dialogue: 0,0:37:24.21,0:37:27.22,Default,,0,0,0,,Бұл сенің анаңның дауысы! (Kimie) Қойшы енді!
Dialogue: 0,0:37:27.22,0:37:29.22,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:37:29.22,0:37:34.22,Default,,0,0,0,,Анашым, не болды!? Генерал! You're okay.
Dialogue: 0,0:37:34.22,0:37:36.23,Default,,0,0,0,,Ан-чан, ауырып тұр!
Dialogue: 0,0:37:36.23,0:37:40.23,Default,,0,0,0,,Shinji! Әпке! Әке!
Dialogue: 0,0:37:42.23,0:37:45.17,Default,,0,0,0,,Қайырлы таң, мына бағананы алысқа жылжытайық.
Dialogue: 0,0:37:45.17,0:37:48.17,Default,,0,0,0,,Бұл жолы атаның намысын қорғауға қалдырайын.
Dialogue: 0,0:37:48.17,0:37:51.18,Default,,0,0,0,,Ан-чан, мені шығар!
Dialogue: 0,0:37:51.18,0:37:53.18,Default,,0,0,0,,Күте тұрыңыз, мен оны қазір шығарамын!
Dialogue: 0,0:37:53.18,0:37:57.18,Default,,0,0,0,,Қайырлы таң, қайырлы таң, күн ыстық!
Dialogue: 0,0:37:57.18,0:38:04.08,Default,,0,0,0,,Ауырып тұр! Ан-Чан, анашым, ыстық!
Dialogue: 0,0:38:09.19,0:38:11.20,Default,,0,0,0,,Жақсы емес...
Dialogue: 0,0:38:11.20,0:38:13.20,Default,,0,0,0,,Чикусо!
Dialogue: 0,0:38:13.20,0:38:17.20,Default,,0,0,0,,Ген Кими Иә!
Dialogue: 0,0:38:17.20,0:38:21.21,Default,,0,0,0,,Сен (Дайкичи), қаш!
Dialogue: 0,0:38:21.21,0:38:24.21,Default,,0,0,0,,Сіз! Эйко! Синдзи!
Dialogue: 0,0:38:24.21,0:38:28.21,Default,,0,0,0,,Енді жоқ! Жігіттер, қашпасаңдар, жалынға оранасыңдар.
Dialogue: 0,0:38:28.21,0:38:32.22,Default,,0,0,0,,Маған ұнамайды! Біз де осында өлеміз!
Dialogue: 0,0:38:32.22,0:38:34.22,Default,,0,0,0,,Bakatare! Сіз, Ген және ішіңіздегі нәресте.
Dialogue: 0,0:38:34.22,0:38:37.22,Default,,0,0,0,,Оны көтерме, қаш!
Dialogue: 0,0:38:37.22,0:38:41.23,Default,,0,0,0,,Маған ұнамайды! Мен барлығымен қоштасқым келмейді!
Dialogue: 0,0:38:41.23,0:38:44.23,Default,,0,0,0,,Генерал, сіз не істеп жатырсыз?
Dialogue: 0,0:38:44.23,0:38:47.16,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:38:47.16,0:38:49.17,Default,,0,0,0,,Анаңды алып қаш!
Dialogue: 0,0:38:49.17,0:38:53.17,Default,,0,0,0,,Маған ұнамайды! Мен де жек көремін!
Dialogue: 0,0:38:53.17,0:38:57.17,Default,,0,0,0,,Анчан! Синдзи!
Dialogue: 0,0:38:57.17,0:38:59.18,Default,,0,0,0,,Эйко…
Dialogue: 0,0:38:59.18,0:39:01.18,Default,,0,0,0,,Ана…
Dialogue: 0,0:39:01.18,0:39:05.18,Default,,0,0,0,,Мен бұл бағаны жек көремін... Мен бұл бағаны жек көремін!
Dialogue: 0,0:39:05.18,0:39:08.19,Default,,0,0,0,,Бас сұрақ
Dialogue: 0,0:39:08.19,0:39:13.19,Default,,0,0,0,,Ана мен баланы қорғаңыз!
Dialogue: 0,0:39:13.19,0:39:16.19,Default,,0,0,0,,Менің орнымда
Dialogue: 0,0:39:18.20,0:39:20.20,Default,,0,0,0,,Өтінемін, Ген!
Dialogue: 0,0:39:27.20,0:39:30.21,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:39:30.21,0:39:34.21,Default,,0,0,0,,Анам да сенімен бірге өледі!
Dialogue: 0,0:39:36.21,0:39:39.22,Default,,0,0,0,,Ыстық! Бұл ыстық!
Dialogue: 0,0:39:39.22,0:39:42.22,Default,,0,0,0,,Күн ыстық! Бұл ыстық! (Кими) Синдзи! Эйко!
Dialogue: 0,0:39:42.22,0:39:46.16,Default,,0,0,0,,Анашым, күн ыстық! (Кими) Сен!
Dialogue: 0,0:39:46.16,0:39:49.16,Default,,0,0,0,,Анчан!! (Жыйрау дыбысы)
Dialogue: 0,0:39:49.16,0:39:52.16,Default,,0,0,0,,Сіз!
Dialogue: 0,0:40:03.17,0:40:09.17,Default,,0,0,0,,Әкем күйіп жатыр... Эйко күйіп жатыр... Синдзи...
Dialogue: 0,0:40:18.19,0:40:22.19,Default,,0,0,0,,Күйік күйік... Барлығы күйеді...
Dialogue: 0,0:40:22.19,0:40:25.20,Default,,0,0,0,,Ана... Ахах...
Dialogue: 0,0:40:25.20,0:40:29.20,Default,,0,0,0,,Мм, анашым, анашым, бар күшіңізді салыңыз.
Dialogue: 0,0:40:29.20,0:40:32.20,Default,,0,0,0,,Сіз не істеп жатырсыз? Жүгіріп кету!
Dialogue: 0,0:40:32.20,0:40:34.20,Default,,0,0,0,,Пак мырза! Генерал!
Dialogue: 0,0:40:34.20,0:40:36.21,Default,,0,0,0,,Накаока-сан, мықты бол!
Dialogue: 0,0:40:36.21,0:40:39.21,Default,,0,0,0,,Ахаха! (Саябақ) Генерал, тез кел!
Dialogue: 0,0:40:44.21,0:40:48.22,Default,,0,0,0,,(Адамдардың ыңырануы)
Dialogue: 0,0:40:48.22,0:40:52.22,Default,,0,0,0,,Ыстық! Ааа, бұл ыстық... (Еркек) Ааа...
Dialogue: 0,0:40:52.22,0:40:56.23,Default,,0,0,0,,Гохо гохо... (Ер адам) Ыстық!
Dialogue: 0,0:40:56.23,0:40:58.23,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:40:58.23,0:41:05.24,Default,,0,0,0,,(Адамдардың ыңырануы)
Dialogue: 0,0:41:05.24,0:41:07.24,Default,,0,0,0,,Су... (судың дыбысы)
Dialogue: 0,0:41:16.25,0:41:19.25,Default,,0,0,0,,Ааа... (Бала) Күн ыстық...
Dialogue: 0,0:41:19.25,0:41:22.25,Default,,0,0,0,,Ағаш Жібермеңіз!
Dialogue: 0,0:41:22.25,0:41:27.26,Default,,0,0,0,,Ауырды... (Еркек) Бәрің, көңілдеріңді көтеріңдер!
Dialogue: 0,0:41:27.26,0:41:30.26,Default,,0,0,0,,Йошито! Муцуко!
Dialogue: 0,0:41:30.26,0:41:36.27,Default,,0,0,0,,Ыстық! (Еркек) Бұл өзен! Уф...
Dialogue: 0,0:41:36.27,0:41:38.27,Default,,0,0,0,,Осы уақытқа дейін келген болсаңыз, өзіңізді қауіпсіз сезінесіз.
Dialogue: 0,0:41:38.27,0:41:43.27,Default,,0,0,0,,Ген Мен барып анама қарауым керек.
Dialogue: 0,0:41:43.27,0:41:46.21,Default,,0,0,0,,Рахмет, Пак мырза (Кими)...
Dialogue: 0,0:41:46.21,0:41:49.21,Default,,0,0,0,,Mom, what's wrong? Сәби дүниеге келді...
Dialogue: 0,0:41:49.21,0:41:51.21,Default,,0,0,0,,Балақай!?
Dialogue: 0,0:41:51.21,0:41:53.22,Default,,0,0,0,,Акушерді немесе дәрігерді шақырыңыз.
Dialogue: 0,0:41:53.22,0:41:56.22,Default,,0,0,0,,Түсіндім! содан кейін бір жерде
Dialogue: 0,0:41:56.22,0:41:59.22,Default,,0,0,0,,Тарай, шелек, футон және мата
Dialogue: 0,0:41:59.22,0:42:01.22,Default,,0,0,0,,Оларды көп әкеліңіз.
Dialogue: 0,0:42:01.22,0:42:04.23,Default,,0,0,0,,Әйтеуір, қайшы мен жіп... Уф...
Dialogue: 0,0:42:04.23,0:42:06.23,Default,,0,0,0,,Біз не істеуіміз керек? Ол емес
Dialogue: 0,0:42:06.23,0:42:09.23,Default,,0,0,0,,Кіндік кесу үшін керек Ах, түсіндім!
Dialogue: 0,0:42:09.23,0:42:15.24,Default,,0,0,0,,Мұнда акушер бар ма? Дәрігер жоқ па?
Dialogue: 0,0:42:15.24,0:42:18.24,Default,,0,0,0,,Акушерка бар ма?
Dialogue: 0,0:42:18.24,0:42:21.24,Default,,0,0,0,,Анам сәбилі болғалы жатыр!
Dialogue: 0,0:42:21.24,0:42:24.25,Default,,0,0,0,,Маған көмектесіңізші!
Dialogue: 0,0:42:24.25,0:42:28.25,Default,,0,0,0,,Жоқ! Не істеуім керек? Не істеуім керек?
Dialogue: 0,0:42:30.25,0:42:33.26,Default,,0,0,0,,Анашым, бұл жақсы емес.
Dialogue: 0,0:42:33.26,0:42:38.26,Default,,0,0,0,,Акушер мен дәрігер жоқ. Не істеуім керек?
Dialogue: 0,0:42:38.26,0:42:40.26,Default,,0,0,0,,Генерал, сіз оны шығарыңыз.
Dialogue: 0,0:42:40.26,0:42:43.27,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:42:43.27,0:42:46.20,Default,,0,0,0,,Мен мұны істеймін, солай ма?
Dialogue: 0,0:42:46.20,0:42:48.21,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:42:48.21,0:42:50.21,Default,,0,0,0,,Мен саған су әкелемін.
Dialogue: 0,0:42:50.21,0:42:52.21,Default,,0,0,0,,Жақсы, су?
Dialogue: 0,0:42:58.22,0:43:02.22,Default,,0,0,0,,Бала туылғаннан кейін оны сумен жуыңыз.
Dialogue: 0,0:43:02.22,0:43:04.22,Default,,0,0,0,,Ахх! Уууу...
Dialogue: 0,0:43:04.22,0:43:07.22,Default,,0,0,0,,Сәттілік анашым!
Dialogue: 0,0:43:07.22,0:43:13.23,Default,,0,0,0,,Ха ха ха... у... туылу... туылу...
Dialogue: 0,0:43:13.23,0:43:17.23,Default,,0,0,0,,Ха ха ха... ахх ахх... аа! Ах!
Dialogue: 0,0:43:17.23,0:43:22.24,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:43:22.24,0:43:25.24,Default,,0,0,0,,Нәрестенің басынан ақырын ұстаңыз.
Dialogue: 0,0:43:25.24,0:43:29.25,Default,,0,0,0,,Мына жігітте түк жоқ, ол әйел.
Dialogue: 0,0:43:29.25,0:43:32.25,Default,,0,0,0,,Картоп мыжылған, маймылға ұқсайды.
Dialogue: 0,0:43:32.25,0:43:35.25,Default,,0,0,0,,Сәбилердің бәрі сондай, сен де солай болдың.
Dialogue: 0,0:43:35.25,0:43:40.26,Default,,0,0,0,,Жарайды, ол сұлулыққа айналады.
Dialogue: 0,0:43:40.26,0:43:44.26,Default,,0,0,0,,Хехехе! сен менсің
Dialogue: 0,0:43:44.26,0:43:47.20,Default,,0,0,0,,Сіз оны осы дүниеге әкелгеніңіз үшін алғыс айтуыңыз керек.
Dialogue: 0,0:43:47.20,0:43:50.20,Default,,0,0,0,,Егер сен мені тыңдамасаң, мен оны қабылдамаймын. Түсінесіз бе?
Dialogue: 0,0:43:50.20,0:43:55.20,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:43:57.21,0:44:01.21,Default,,0,0,0,,Ана мен баланы қорғаңыз!
Dialogue: 0,0:44:01.21,0:44:06.22,Default,,0,0,0,,Адам туып, оны маған құда ет.
Dialogue: 0,0:44:06.22,0:44:11.22,Default,,0,0,0,,Әке, әпке, Синдзи~!
Dialogue: 0,0:44:11.22,0:44:13.22,Default,,0,0,0,,Сәби дүниеге келді!
Dialogue: 0,0:44:13.22,0:44:18.23,Default,,0,0,0,,Синдзи Сенің қолбасшың әйел!
Dialogue: 0,0:44:18.23,0:44:24.23,Default,,0,0,0,,Уау! Ааа! Ааа!
Dialogue: 0,0:44:24.23,0:44:28.24,Default,,0,0,0,,Әке, әпке, Синдзи!
Dialogue: 0,0:44:28.24,0:44:34.24,Default,,0,0,0,,Бұл нәрестені бәрі көре алмайды! Ууааан!
Dialogue: 0,0:44:34.24,0:44:37.25,Default,,0,0,0,,Ген, балаңды маған қарызға бер.
Dialogue: 0,0:44:37.25,0:44:39.25,Default,,0,0,0,,Иә
Dialogue: 0,0:44:39.25,0:44:42.25,Default,,0,0,0,,Ал, мұқият қараңдар.
Dialogue: 0,0:44:42.25,0:44:44.25,Default,,0,0,0,,Әкеңмен
Dialogue: 0,0:44:44.25,0:44:48.19,Default,,0,0,0,,Әпкем мен ағамды өлтірген соғыс.
Dialogue: 0,0:44:48.19,0:44:53.19,Default,,0,0,0,,Йомито-кун, солай ма? Иә?
Dialogue: 0,0:44:55.20,0:45:00.20,Default,,0,0,0,,(Жаңбыр дыбысы)
Dialogue: 0,0:45:02.21,0:45:07.21,Default,,0,0,0,,Ой, жаңбырда қиын.
Dialogue: 0,0:45:07.21,0:45:09.21,Default,,0,0,0,,Құлап қалма, құлама!
Dialogue: 0,0:45:09.21,0:45:12.22,Default,,0,0,0,,Йокойшо
Dialogue: 0,0:45:12.22,0:45:15.22,Default,,0,0,0,,Иә? Бұл не? Бұл жаңбыр
Dialogue: 0,0:45:15.22,0:45:19.22,Default,,0,0,0,,Үлкен қара жаңбыр
Dialogue: 0,0:45:19.22,0:45:25.23,Default,,0,0,0,,<Бұл қара жаңбыр Хиросима қаласының солтүстік-батыс бөлігінде шоғырлануын жалғастыруда.
Dialogue: 0,0:45:25.23,0:45:30.23,Default,,0,0,0,,Бұл ондаған жылдар өтсе де адамдарды азаптайтын жаңбыр.
Dialogue: 0,0:45:30.23,0:45:33.24,Default,,0,0,0,,Әлі ешкім білмеді>
Dialogue: 0,0:45:33.24,0:45:36.24,Default,,0,0,0,,<Атом бомбасының жарылуымен
Dialogue: 0,0:45:36.24,0:45:39.24,Default,,0,0,0,,Атмосферада шашыраған радиоактивтілік
Dialogue: 0,0:45:39.24,0:45:42.25,Default,,0,0,0,,Шаңмен бірге аспанға ұшып, бұлтқа айналады.
Dialogue: 0,0:45:42.25,0:45:44.25,Default,,0,0,0,,Құрамында радиоактивтілігі бар жаңбыр
Dialogue: 0,0:45:44.25,0:45:49.19,Default,,0,0,0,,Адамдар мен жерге жаңбыр жауды>
Dialogue: 0,0:45:49.19,0:45:54.19,Default,,0,0,0,,<4000 градус жылу сәулелері, жарылыс толқындары және өрт әсерінен болатын жойылу
Dialogue: 0,0:45:54.19,0:45:58.19,Default,,0,0,0,,Радиоактивті жаңбырдан кейінгі ластану
Dialogue: 0,0:45:58.19,0:46:02.20,Default,,0,0,0,,Ядролық бомба екінші қорқыныш болды>
Dialogue: 0,0:46:02.20,0:46:07.20,Default,,0,0,0,,(Адамдардың ыңырануы)
Dialogue: 0,0:46:13.21,0:46:16.21,Default,,0,0,0,,Су... (Ер) А...
Dialogue: 0,0:46:16.21,0:46:20.22,Default,,0,0,0,,Анам шулы, ұйықтап жатыр.
Dialogue: 0,0:46:20.22,0:46:22.22,Default,,0,0,0,,А, су... Иә? су келеді
Dialogue: 0,0:46:22.22,0:46:25.22,Default,,0,0,0,,Сен сондай сүйкімдісің, мен саған сусын беремін.
Dialogue: 0,0:46:25.22,0:46:31.23,Default,,0,0,0,,Біреу маған су беріңізші...
Dialogue: 0,0:46:31.23,0:46:33.23,Default,,0,0,0,,Су...
Dialogue: 0,0:46:33.23,0:46:36.23,Default,,0,0,0,,Мықты болыңыз Қажырлы болыңыз
Dialogue: 0,0:46:36.23,0:46:39.23,Default,,0,0,0,,...
Dialogue: 0,0:46:41.24,0:46:45.14,Default,,0,0,0,,Yes, it's water. Көңіл көтеру.
Dialogue: 0,0:46:47.18,0:46:50.18,Default,,0,0,0,,Эй, эй, не болды?
Dialogue: 0,0:46:50.18,0:46:54.18,Default,,0,0,0,,Шынымен!? I’m dying!
Dialogue: 0,0:46:54.18,0:46:56.19,Default,,0,0,0,,Ууууууууууу... (Кимие) Бұл кісі де.
Dialogue: 0,0:46:56.19,0:47:00.19,Default,,0,0,0,,Ууу...уууууууу...
Dialogue: 0,0:47:00.19,0:47:03.19,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:47:03.19,0:47:07.19,Default,,0,0,0,,Су ішсең, бірден өлесің.
Dialogue: 0,0:47:09.20,0:47:11.20,Default,,0,0,0,,Мама, ішпегеніңіз жақсы.
Dialogue: 0,0:47:11.20,0:47:13.20,Default,,0,0,0,,Хоуджан
Dialogue: 0,0:47:13.20,0:47:18.20,Default,,0,0,0,,(Адамдардың ыңырануы)
Dialogue: 0,0:47:26.22,0:47:29.22,Default,,0,0,0,,Мама, енді не істейсіз?
Dialogue: 0,0:47:29.22,0:47:33.22,Default,,0,0,0,,Ал...
Dialogue: 0,0:47:33.22,0:47:36.23,Default,,0,0,0,,Біздің туыстарымыздың бәрі қалада.
Dialogue: 0,0:47:36.23,0:47:40.23,Default,,0,0,0,,Менің үйім өртеніп кеткен болуы керек, баратын жерім жоқ...
Dialogue: 0,0:47:40.23,0:47:44.23,Default,,0,0,0,,Басым абыржып, не істерімді білмеймін.
Dialogue: 0,0:47:44.23,0:47:47.17,Default,,0,0,0,,Мәселе жоқ, жарайды.
Dialogue: 0,0:47:47.17,0:47:49.17,Default,,0,0,0,,Не болды? (жылау)
Dialogue: 0,0:47:49.17,0:47:51.17,Default,,0,0,0,,Менің сүтім шығып жатыр.
Dialogue: 0,0:47:51.17,0:47:54.18,Default,,0,0,0,,Сүт шықпаса, бала өледі.
Dialogue: 0,0:47:54.18,0:47:58.18,Default,,0,0,0,,Дұрыс, біз бүгін үш күн ғана су іштік.
Dialogue: 0,0:47:58.18,0:48:01.18,Default,,0,0,0,,Менің ештеңе жегім келмейді.
Dialogue: 0,0:48:01.18,0:48:03.19,Default,,0,0,0,,Тамақтану үшін бірдеңе іздеу
Dialogue: 0,0:48:03.19,0:48:07.19,Default,,0,0,0,,Ой, жарайды, жарайды, жарайды.
Dialogue: 0,0:48:07.19,0:48:09.19,Default,,0,0,0,,Мама, күте тұрыңыз.
Dialogue: 0,0:48:09.19,0:48:11.19,Default,,0,0,0,,Не болды? генерал
Dialogue: 0,0:48:11.19,0:48:15.19,Default,,0,0,0,,Мен тамақ тауып алайын, генерал.
Dialogue: 0,0:48:17.20,0:48:20.20,Default,,0,0,0,,《Ана мен бала өлмейді.
Dialogue: 0,0:48:20.20,0:48:22.21,Default,,0,0,0,,Мен ешқашан өлмеймін》
Dialogue: 0,0:48:22.21,0:48:25.21,Default,,0,0,0,,《Күте тұрыңыз! Күте тұрыңыз! 》
Dialogue: 0,0:48:27.21,0:48:31.21,Default,,0,0,0,,Бірақ мен қайда барсам болады?
Dialogue: 0,0:48:31.21,0:48:35.22,Default,,0,0,0,,Әй, мына күрішті қайдан алдың?
Dialogue: 0,0:48:35.22,0:48:38.22,Default,,0,0,0,,Әскери жүк көліктері заттарды таратып жатыр.
Dialogue: 0,0:48:38.22,0:48:41.22,Default,,0,0,0,,Хо... шынымен бе? Қайда?
Dialogue: 0,0:48:41.22,0:48:43.23,Default,,0,0,0,,Мен білмеймін. Оны өзіңіз табыңыз.
Dialogue: 0,0:48:43.23,0:48:46.16,Default,,0,0,0,,Біз мұны Цучибашиде көрдік.
Dialogue: 0,0:48:46.16,0:48:49.16,Default,,0,0,0,,Добаши? Бұл әскери жүк көлігі ме?
Dialogue: 0,0:48:53.17,0:48:57.17,Default,,0,0,0,,Сәлем! Маған да күріш шарын беріңіз!
Dialogue: 0,0:48:57.17,0:48:59.17,Default,,0,0,0,,Ахх...
Dialogue: 0,0:49:07.18,0:49:09.19,Default,,0,0,0,,Үйілген мәйіт...
Dialogue: 0,0:49:09.19,0:49:12.19,Default,,0,0,0,,Тез ұйымдастырыңыз! Тез күйдірмесең, мәйіт шіриді!
Dialogue: 0,0:49:12.19,0:49:14.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:49:20.20,0:49:24.20,Default,,0,0,0,,Тазалау мен тазалаудың шегі жоқ.
Dialogue: 0,0:49:24.20,0:49:29.20,Default,,0,0,0,,Өлі дененің иісі шығады.
Dialogue: 0,0:49:38.21,0:49:42.21,Default,,0,0,0,,Иә? Бұл өрт сөндірушінің бас киімі
Dialogue: 0,0:49:45.16,0:49:48.16,Default,,0,0,0,,Ммм... Нмм...
Dialogue: 0,0:49:48.16,0:49:50.16,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:49:50.16,0:49:52.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:52.16,0:49:54.16,Default,,0,0,0,,...
Dialogue: 0,0:49:54.16,0:49:57.16,Default,,0,0,0,,Угой... Угой жоқ угой
Dialogue: 0,0:50:00.17,0:50:03.17,Default,,0,0,0,,Адамдар тас сияқты.
Dialogue: 0,0:50:05.18,0:50:07.18,Default,,0,0,0,,Сол мәйіттердің әрқайсысы
Dialogue: 0,0:50:07.18,0:50:11.18,Default,,0,0,0,,Жылап күлгенім өтірік сияқты.
Dialogue: 0,0:50:11.18,0:50:13.18,Default,,0,0,0,,Бұл тозақ...
Dialogue: 0,0:50:13.18,0:50:27.20,Default,,0,0,0,,Сен
Dialogue: 0,0:50:27.20,0:50:32.20,Default,,0,0,0,,Күйіктің тыртықтарына құрт уылдырық шашады деп ойламаппын.
Dialogue: 0,0:50:32.20,0:50:36.21,Default,,0,0,0,,Бұл зат қозғалса, ауырады, қышиды, бірақ мен оған көмектесе алмаймын.
Dialogue: 0,0:50:36.21,0:50:38.21,Default,,0,0,0,,Мен құрттарды жей аламын.
Dialogue: 0,0:50:38.21,0:50:41.21,Default,,0,0,0,,Ақымақ нәрселер туралы айтпа.
Dialogue: 0,0:50:41.21,0:50:44.21,Default,,0,0,0,,Біреу өтінемін!
Dialogue: 0,0:50:44.21,0:50:47.22,Default,,0,0,0,,Осы баланы емізе аласыз ба?
Dialogue: 0,0:50:47.22,0:50:51.22,Default,,0,0,0,,Мен өлейін деп жатырмын, өтінемін!
Dialogue: 0,0:50:54.22,0:50:57.23,Default,,0,0,0,,Мм... Кешіріңіз.
Dialogue: 0,0:50:57.23,0:51:00.23,Default,,0,0,0,,Ха! (бала жылайды)
Dialogue: 0,0:51:03.23,0:51:07.24,Default,,0,0,0,,Өлерімді де білмеймін... (жылап)
Dialogue: 0,0:51:07.24,0:51:10.24,Default,,0,0,0,,Біреу мына баланы емізуін өтінемін.
Dialogue: 0,0:51:10.24,0:51:12.24,Default,,0,0,0,,Өтінемін (әйел) Бұл шулы!
Dialogue: 0,0:51:12.24,0:51:15.25,Default,,0,0,0,,Бұлай болса, нәресте өледі.
Dialogue: 0,0:51:15.25,0:51:17.25,Default,,0,0,0,,Өл, өл, өл!
Dialogue: 0,0:51:17.25,0:51:19.25,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:51:19.25,0:51:22.25,Default,,0,0,0,,Сені өлтіруге жол берме.
Dialogue: 0,0:51:22.25,0:51:25.26,Default,,0,0,0,,Сіз не істеп жатырсыз? (жылау)
Dialogue: 0,0:51:25.26,0:51:28.26,Default,,0,0,0,,Тоқта! Тоқта!
Dialogue: 0,0:51:28.26,0:51:34.26,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:51:34.26,0:51:38.27,Default,,0,0,0,,Жүр, темекі тарт.
Dialogue: 0,0:51:38.27,0:51:42.27,Default,,0,0,0,,Менің сүтім бос болғанша сор.
Dialogue: 0,0:51:42.27,0:51:44.27,Default,,0,0,0,,Әйелі...
Dialogue: 0,0:51:44.27,0:51:47.21,Default,,0,0,0,,Дөрекі болғаным үшін кешіріңіз.
Dialogue: 0,0:51:47.21,0:51:49.21,Default,,0,0,0,,Дені сау сәбилерге қызғанышпен қарай алмаймын.
Dialogue: 0,0:51:49.21,0:51:52.22,Default,,0,0,0,,Менің балам да сондай.
Dialogue: 0,0:51:52.22,0:51:58.22,Default,,0,0,0,,Менің кеудем қазір жарамсыз. Мен бұл нәресте оларды дұрыс соратынына көз жеткіземін.
Dialogue: 0,0:52:00.22,0:52:02.23,Default,,0,0,0,,Әйелі...
Dialogue: 0,0:52:02.23,0:52:07.23,Default,,0,0,0,,Сізге жақсы болды, сіз шынымен жақсы болдыңыз.
Dialogue: 0,0:52:07.23,0:52:12.24,Default,,0,0,0,,Бәрі кетті, бәрі кетті.
Dialogue: 0,0:52:12.24,0:52:17.24,Default,,0,0,0,,А... салқын... суық...
Dialogue: 0,0:52:17.24,0:52:20.24,Default,,0,0,0,,Солдат, сен жындысың ба? Бұл өте ыстық
Dialogue: 0,0:52:20.24,0:52:24.25,Default,,0,0,0,,Суық Суық! Жаңбырға шомылсам да, суық тиіп қалғандай болдым.
Dialogue: 0,0:52:24.25,0:52:28.25,Default,,0,0,0,,Солдат, мен сені боқтаймын, ақымақ! Мен ақымақпын
Dialogue: 0,0:52:28.25,0:52:33.26,Default,,0,0,0,,Ах... Қан... Қан, қанды нәжіс.
Dialogue: 0,0:52:33.26,0:52:35.26,Default,,0,0,0,,Қызық, қашан...
Dialogue: 0,0:52:35.26,0:52:38.26,Default,,0,0,0,,Солдаттың бәрі таз.
Dialogue: 0,0:52:38.26,0:52:42.27,Default,,0,0,0,,Бақатаре! Мен тазмын...
Dialogue: 0,0:52:42.27,0:52:45.17,Default,,0,0,0,,Не... не болды?
Dialogue: 0,0:52:47.20,0:52:49.21,Default,,0,0,0,,Уууу! Гохо…
Dialogue: 0,0:52:49.21,0:52:52.21,Default,,0,0,0,,Гохогохо... Не болып жатыр!?
Dialogue: 0,0:52:52.21,0:52:55.21,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууу... Солдат, шыда!
Dialogue: 0,0:52:55.21,0:52:58.21,Default,,0,0,0,,Уу-у... аа!
Dialogue: 0,0:52:58.21,0:53:03.22,Default,,0,0,0,,Не... не істеуім керек... не істеуім керек!
Dialogue: 0,0:53:03.22,0:53:06.22,Default,,0,0,0,,Не істеуім керек!? (Солдат) А...
Dialogue: 0,0:53:06.22,0:53:10.23,Default,,0,0,0,,Қалай болғанда да, мен бірдеңе істеуім керек.
Dialogue: 0,0:53:10.23,0:53:12.23,Default,,0,0,0,,Ух... (Солдат) Ух...
Dialogue: 0,0:53:12.23,0:53:16.23,Default,,0,0,0,,Мен... (Солдат) Ах... Ха ха...
Dialogue: 0,0:53:16.23,0:53:20.24,Default,,0,0,0,,Сіз аш болуыңыз керек (Солдат) Ух...
Dialogue: 0,0:53:20.24,0:53:23.24,Default,,0,0,0,,Түскі түсте!
Dialogue: 0,0:53:23.24,0:53:26.24,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:53:26.24,0:53:30.25,Default,,0,0,0,,Жарайды, дайын! Йо! Хмм...
Dialogue: 0,0:53:30.25,0:53:33.25,Default,,0,0,0,,Иә! Менің басым үлкен
Dialogue: 0,0:53:33.25,0:53:36.25,Default,,0,0,0,,Солдат, берік бол.
Dialogue: 0,0:53:36.25,0:53:39.26,Default,,0,0,0,,Жедел жәрдем пункті қайда орналасқан? Алғашқы медициналық көмек көрсету пункті
Dialogue: 0,0:53:39.26,0:53:43.26,Default,,0,0,0,,Жедел жәрдем пункті қайда орналасқан? Ха ха...
Dialogue: 0,0:53:43.26,0:53:47.20,Default,,0,0,0,,Ауырды~ Анашым
Dialogue: 0,0:53:47.20,0:53:53.20,Default,,0,0,0,,(Адамдардың ыңырануы)
Dialogue: 0,0:53:53.20,0:53:56.21,Default,,0,0,0,,Медбике Қайырлы таң Қайырлы таң (Солдат) Жарайсың ба?
Dialogue: 0,0:53:56.21,0:53:58.21,Default,,0,0,0,,Тірі қалуы мүмкін адамдарға ғана қара.
Dialogue: 0,0:53:58.21,0:54:00.21,Default,,0,0,0,,Иә
Dialogue: 0,0:54:00.21,0:54:05.21,Default,,0,0,0,,Ешқандай дәрі қалмады.
Dialogue: 0,0:54:05.21,0:54:10.22,Default,,0,0,0,,Мына жауынгерді тексеріп көріңізші, ол өлуге жақын.
Dialogue: 0,0:54:10.22,0:54:12.22,Default,,0,0,0,,Тағы да келдің бе?
Dialogue: 0,0:54:12.22,0:54:14.22,Default,,0,0,0,,Оны білмейсің бе? Картаға қара!
Dialogue: 0,0:54:14.22,0:54:17.23,Default,,0,0,0,,Диарея, қан құсу немесе суық тию болды ма?
Dialogue: 0,0:54:17.23,0:54:21.23,Default,,0,0,0,,Мен жасадым. Өтінемін, маған қамқорлық жасаңыз.
Dialogue: 0,0:54:21.23,0:54:25.23,Default,,0,0,0,,Енді мұның қажеті жоқ. Қазір өлді.
Dialogue: 0,0:54:25.23,0:54:29.24,Default,,0,0,0,,Бұл Пика, Пика, Пиканың кінәсі болуы керек.
Dialogue: 0,0:54:29.24,0:54:32.24,Default,,0,0,0,,<Бір атом бомбасы бірден
Dialogue: 0,0:54:32.24,0:54:36.25,Default,,0,0,0,,Олар 200 000-нан астам адамды өлтіріп қана қоймай,
Dialogue: 0,0:54:36.25,0:54:40.25,Default,,0,0,0,,Қалдық радиоактивтілік деп аталатын көрінбейтін құбыжыққа айналу
Dialogue: 0,0:54:40.25,0:54:44.25,Default,,0,0,0,,Мәйіттерді шығаратын сарбаздарға бару және жақын туыстарының қауіпсіздігі
Dialogue: 0,0:54:44.25,0:54:47.19,Default,,0,0,0,,Өртенген қирандыларға кіргендердің денесіне кіріп шығу
Dialogue: 0,0:54:47.19,0:54:54.20,Default,,0,0,0,,Жасушаларды жоюды жалғастыру, жедел лейкоз және қатерлі ісік тудыруы және оларды өлтіру>
Dialogue: 0,0:54:54.20,0:55:14.22,Default,,0,0,0,,Сен
Dialogue: 0,0:55:14.22,0:55:26.23,Default,,0,0,0,,Сен
Dialogue: 0,0:55:26.23,0:55:28.23,Default,,0,0,0,,Я...
Dialogue: 0,0:55:28.23,0:55:30.23,Default,,0,0,0,,Пикаджа
Dialogue: 0,0:55:32.24,0:55:35.24,Default,,0,0,0,,Бұл Пиканың кінәсі болуы керек.
Dialogue: 0,0:55:37.24,0:55:41.24,Default,,0,0,0,,Бақатаре! Бақатаре! Бақатаре! Бақатаре!
Dialogue: 0,0:55:43.25,0:55:46.18,Default,,0,0,0,,Иә? Бұл не? Мынау
Dialogue: 0,0:55:46.18,0:55:49.19,Default,,0,0,0,,Күріш! А, ол көмірге айналады
Dialogue: 0,0:55:49.19,0:55:54.19,Default,,0,0,0,,Жарайды, бұл базар қоймасы.
Dialogue: 0,0:55:54.19,0:55:57.19,Default,,0,0,0,,Бұл ысырап, сонша күріш...
Dialogue: 0,0:55:57.19,0:56:00.19,Default,,0,0,0,,Осылай көмірге айналса, оны жеуге болмайды.
Dialogue: 0,0:56:07.20,0:56:12.20,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:56:18.21,0:56:21.22,Default,,0,0,0,,Өйткені! Іші күйген жоқ!
Dialogue: 0,0:56:21.22,0:56:24.22,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:56:24.22,0:56:28.22,Default,,0,0,0,,Хэхехе ахахахахахха
Dialogue: 0,0:56:28.22,0:56:31.22,Default,,0,0,0,,Иә, иә! Алақай!
Dialogue: 0,0:56:34.23,0:56:36.23,Default,,0,0,0,,Күріште маринадталған шалғам да бар.
Dialogue: 0,0:56:36.23,0:56:39.24,Default,,0,0,0,,Мама, енді бәрі жақсы, уайымдамаңыз.
Dialogue: 0,0:56:39.24,0:56:43.24,Default,,0,0,0,,Генерал, оны алғаныңызға рахмет.
Dialogue: 0,0:56:43.24,0:56:46.18,Default,,0,0,0,,Анам да көп заттарды жинады.
Dialogue: 0,0:56:46.18,0:56:48.18,Default,,0,0,0,,Ой, ұйықтап жатырмын
Dialogue: 0,0:56:48.18,0:56:51.18,Default,,0,0,0,,Бұл затқа атау беруіміз керек.
Dialogue: 0,0:56:51.18,0:56:56.19,Default,,0,0,0,,Меніңше, оның аты жоқ.
Dialogue: 0,0:56:56.19,0:56:58.19,Default,,0,0,0,,Өрт көп
Dialogue: 0,0:56:58.19,0:57:00.19,Default,,0,0,0,,Өлгендерді өртеу
Dialogue: 0,0:57:00.19,0:57:03.19,Default,,0,0,0,,Көп адам өлді (Кими) Бұл дұрыс емес.
Dialogue: 0,0:57:03.19,0:57:07.19,Default,,0,0,0,,Мен оны аяқтай алмаймын (Кими) Мен оны аяқтай алмаймын.
Dialogue: 0,0:57:09.20,0:57:11.20,Default,,0,0,0,,Анашым, бұл не?
Dialogue: 0,0:57:11.20,0:57:15.20,Default,,0,0,0,,Бұл жігіттің достары көп болады деп үміттенемін.
Dialogue: 0,0:57:15.20,0:57:17.21,Default,,0,0,0,,«Томоко» ше?
Dialogue: 0,0:57:17.21,0:57:22.21,Default,,0,0,0,,Томоко? Жарайды, бұл атау емес, оны Томоко дейік.
Dialogue: 0,0:57:22.21,0:57:24.21,Default,,0,0,0,,Жарайды, сен бүгіннен бастап Томокосың!
Dialogue: 0,0:57:24.21,0:57:27.22,Default,,0,0,0,,Генерал, саған не болды? Үлкен таз басын жасаңыз
Dialogue: 0,0:57:27.22,0:57:30.22,Default,,0,0,0,,Мен таз емеспін.
Dialogue: 0,0:57:30.22,0:57:35.22,Default,,0,0,0,,Хо... бұл рас... мен білмей тұрып
Dialogue: 0,0:57:37.23,0:57:40.23,Default,,0,0,0,,Ааааа!
Dialogue: 0,0:57:40.23,0:57:42.23,Default,,0,0,0,,Уууу!
Dialogue: 0,0:57:42.23,0:57:44.23,Default,,0,0,0,,Уууу…
Dialogue: 0,0:57:44.23,0:57:46.17,Default,,0,0,0,,Мен өлдім
Dialogue: 0,0:57:46.17,0:57:50.17,Default,,0,0,0,,Бұл Пиканың кінәсі. Бұл атом бомбасының кінәсі.
Dialogue: 0,0:57:50.17,0:57:52.17,Default,,0,0,0,,Ген?
Dialogue: 0,0:57:52.17,0:57:55.18,Default,,0,0,0,,Маған ұнамайды! Менің өлгім келмейді!
Dialogue: 0,0:57:55.18,0:57:58.18,Default,,0,0,0,,Не болды? Мен қорқамын, өлгім келмейді
Dialogue: 0,0:57:58.18,0:58:01.18,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мен өлмеймін. Жарайды.
Dialogue: 0,0:58:01.18,0:58:03.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:03.19,0:58:06.19,Default,,0,0,0,,<Осы уақытта Құрама Штаттар Хиросиманың қирағанын көрді.
Dialogue: 0,0:58:06.19,0:58:09.19,Default,,0,0,0,,Оның атом бомбасы екенін хабарлау>
Dialogue: 0,0:58:09.19,0:58:14.20,Default,,0,0,0,,
Dialogue: 0,0:58:14.20,0:58:17.20,Default,,0,0,0,,
Dialogue: 0,0:58:17.20,0:58:22.20,Default,,0,0,0,,
Dialogue: 0,0:58:22.20,0:58:27.20,Default,,0,0,0,,
Dialogue: 0,0:58:37.22,0:58:42.22,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:59:00.18,0:59:07.18,Default,,0,0,0,,Империяның қазіргі жағдайына шолу
Dialogue: 0,0:59:07.18,0:59:13.19,Default,,0,0,0,,Жағдайды шешу үшін шұғыл шаралар қабылдау.
Dialogue: 0,0:59:13.19,0:59:18.19,Default,,0,0,0,,Адал субъектілерді айыптау
Dialogue: 0,0:59:18.19,0:59:22.20,Default,,0,0,0,,Мен Империяның үкіметімін.
Dialogue: 0,0:59:22.20,0:59:26.20,Default,,0,0,0,,АҚШ, Ұлыбритания, Қытай, Сикоку және Қытай
Dialogue: 0,0:59:26.20,0:59:33.21,Default,,0,0,0,,Бірлескен декларацияның қабылданғаны туралы хабарлама
Dialogue: 0,0:59:33.21,0:59:37.21,Default,,0,0,0,,Мен үшін уақыт пен сәттіліктің қазіргі үрдісі
Dialogue: 0,0:59:37.21,0:59:42.22,Default,,0,0,0,,Төзу қиын, шыдау қиын, қарсы тұру қиын.
Dialogue: 0,0:59:42.22,0:59:47.16,Default,,0,0,0,,Мәңгілік үшін мен тыныштықты ашқым келеді.
Dialogue: 0,0:59:47.16,0:59:52.16,Default,,0,0,0,,Мен ұлттық саясатты сақтауым керек.
Dialogue: 0,0:59:52.16,0:59:55.16,Default,,0,0,0,,Тадара Нарудың субъектілері...
Dialogue: 0,0:59:57.17,1:00:01.17,Default,,0,0,0,,Бас... Не? анам
Dialogue: 0,1:00:01.17,1:00:04.17,Default,,0,0,0,,Шынымен, әке, Эйко және Синдзи.
Dialogue: 0,1:00:04.17,1:00:06.18,Default,,0,0,0,,Ол өлген жоқ.
Dialogue: 0,1:00:06.18,1:00:09.18,Default,,0,0,0,,Менің өлгенім артық.
Dialogue: 0,1:00:09.18,1:00:11.18,Default,,0,0,0,,Уф, у…
Dialogue: 0,1:00:11.18,1:00:15.18,Default,,0,0,0,,Уууу... (ер) Уууу...
Dialogue: 0,1:00:15.18,1:00:18.19,Default,,0,0,0,,Қария, неге жылайсың?
Dialogue: 0,1:00:18.19,1:00:21.19,Default,,0,0,0,,Дәл қазір ұлы мәртебелі императордың хабары болды.
Dialogue: 0,1:00:21.19,1:00:24.19,Default,,0,0,0,,Жапония соғыста жеңілді.
Dialogue: 0,1:00:24.19,1:00:29.20,Default,,0,0,0,,Соғыс сөзсіз берілумен аяқталады (әйел) Ух...
Dialogue: 0,1:00:29.20,1:00:32.20,Default,,0,0,0,,Соғыс осы уақытқа дейін аяқталуы керек!
Dialogue: 0,1:00:37.21,1:00:41.21,Default,,0,0,0,,Ууууууу... анашым
Dialogue: 0,1:00:41.21,1:00:43.21,Default,,0,0,0,,Менің көңіл-күйімді көтеріңізші.
Dialogue: 0,1:00:43.21,1:00:46.22,Default,,0,0,0,,Мен де сен үшін бар күшімді саламын.
Dialogue: 0,1:00:46.22,1:00:50.22,Default,,0,0,0,,Жарайды, мұнда үй салайық.
Dialogue: 0,1:00:50.22,1:01:00.23,Default,,0,0,0,,Сен
Dialogue: 0,1:01:00.23,1:01:02.23,Default,,0,0,0,,(Томоконың айқайы)
Dialogue: 0,1:01:02.23,1:01:05.23,Default,,0,0,0,,Томоко, жылама, жарайды, жарайды.
Dialogue: 0,1:01:05.23,1:01:08.24,Default,,0,0,0,,Мама, сүтім шықпайды.
Dialogue: 0,1:01:08.24,1:01:10.24,Default,,0,0,0,,Мұның бәрі ауыр ванналар туралы.
Dialogue: 0,1:01:10.24,1:01:12.24,Default,,0,0,0,,Мен сенің нағыз сүт ішуіңді қалаймын.
Dialogue: 0,1:01:12.24,1:01:16.25,Default,,0,0,0,,Сіз тапқан күріш көп ұзамай жоғалады.
Dialogue: 0,1:01:16.25,1:01:19.25,Default,,0,0,0,,Я...
Dialogue: 0,1:01:19.25,1:01:22.25,Default,,0,0,0,,Жүр, тамақ ішейік, Томоко, мұнда кел.
Dialogue: 0,1:01:24.25,1:01:28.26,Default,,0,0,0,,Мен жұмыс істейтін жер таппай жүрмін, сондықтан мен қатты қиналдым.
Dialogue: 0,1:01:28.26,1:01:33.26,Default,,0,0,0,,Қиындыққа тап болдым, бірдеңе істеуім керек.
Dialogue: 0,1:01:33.26,1:01:35.26,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:01:35.26,1:01:38.27,Default,,0,0,0,,Уау! Сен бейбақ!
Dialogue: 0,1:01:38.27,1:01:40.27,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:01:40.27,1:01:43.27,Default,,0,0,0,,Маған ұнамайды! Иә! Иә!
Dialogue: 0,1:01:43.27,1:01:46.21,Default,,0,0,0,,Бұл! Оля! ол аурады!
Dialogue: 0,1:01:46.21,1:01:48.21,Default,,0,0,0,,О! Дааа!
Dialogue: 0,1:01:48.21,1:01:51.21,Default,,0,0,0,,Ууу...аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,1:01:51.21,1:01:53.22,Default,,0,0,0,,Жеңілу жаман!
Dialogue: 0,1:01:53.22,1:01:56.22,Default,,0,0,0,,Маған не айтатыныңызды көрсетіңіз!
Dialogue: 0,1:01:56.22,1:01:58.22,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:58.22,1:02:01.22,Default,,0,0,0,,Әй... Анашым, мына жігіттің түрін қарашы!
Dialogue: 0,1:02:01.22,1:02:05.22,Default,,0,0,0,,Қараңдар, мына жүзге қараңдар! Жіберу!
Dialogue: 0,1:02:07.23,1:02:09.23,Default,,0,0,0,,Синдзи!
Dialogue: 0,1:02:09.23,1:02:12.23,Default,,0,0,0,,Бұл тітіркендіргіш. Бұл Шинджи емес!
Dialogue: 0,1:02:12.23,1:02:15.24,Default,,0,0,0,,Бұл Синдзи емес пе? Мүмкін емес!
Dialogue: 0,1:02:15.24,1:02:18.24,Default,,0,0,0,,Синдзидің аман қалуы мүмкін емес.
Dialogue: 0,1:02:18.24,1:02:21.24,Default,,0,0,0,,Бұл Рюта Кондо!
Dialogue: 0,1:02:21.24,1:02:27.25,Default,,0,0,0,,Мен ештеңе жемегеніме төрт күн болды. Күріш ботқасының иісі адам төзгісіз, мен өзімді басқара алмаймын...
Dialogue: 0,1:02:27.25,1:02:29.25,Default,,0,0,0,,Туыстарың кімдер?
Dialogue: 0,1:02:29.25,1:02:32.25,Default,,0,0,0,,Пиканың кесірінен бәрі өлсе, өте жаман болар еді.
Dialogue: 0,1:02:32.25,1:02:35.26,Default,,0,0,0,,Сіз өлген ағаңызға тура ұқсайсыз.
Dialogue: 0,1:02:35.26,1:02:38.26,Default,,0,0,0,,Бұл Рюта!
Dialogue: 0,1:02:38.26,1:02:40.26,Default,,0,0,0,,Мен үшін тамақтан.
Dialogue: 0,1:02:40.26,1:02:44.27,Default,,0,0,0,,Жарайсың ба? О
Dialogue: 0,1:02:44.27,1:02:46.17,Default,,0,0,0,,Сіз сенімдісіз бе? О
Dialogue: 0,1:02:51.21,1:02:53.21,Default,,0,0,0,,Жарайды, тез тамақтанып алайық.
Dialogue: 0,1:02:53.21,1:02:55.21,Default,,0,0,0,,Дұрыс тамақтанбасаң, сені алып кетеді.
Dialogue: 0,1:02:55.21,1:02:57.21,Default,,0,0,0,,Оны қабылдамаңыз.
Dialogue: 0,1:02:57.21,1:02:59.21,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:02:59.21,1:03:01.22,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,1:03:01.22,1:03:03.22,Default,,0,0,0,,Сіз қайда тұрасыз?
Dialogue: 0,1:03:03.22,1:03:05.22,Default,,0,0,0,,Сол аумақтың айналасында күйген қалдықтар қалды.
Dialogue: 0,1:03:07.22,1:03:11.23,Default,,0,0,0,,Сіз де апайдың сыбағасын жей алмайсыз. Отырыңыз және тамақтаныңыз.
Dialogue: 0,1:03:11.23,1:03:13.23,Default,,0,0,0,,Хо... шынымен бе?
Dialogue: 0,1:03:18.23,1:03:22.24,Default,,0,0,0,,Дегенмен, бұл Шинджиге ұқсайды.
Dialogue: 0,1:03:22.24,1:03:24.24,Default,,0,0,0,,Шын мәнінде емес
Dialogue: 0,1:03:24.24,1:03:28.24,Default,,0,0,0,,Дүниеде бір-біріне ұқсайтын кем дегенде 5 адам бар дейді.
Dialogue: 0,1:03:28.24,1:03:30.24,Default,,0,0,0,,Мен шынымен таң қалдым.
Dialogue: 0,1:03:32.25,1:03:34.25,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:03:34.25,1:03:38.25,Default,,0,0,0,,Бұл бос хехехехе
Dialogue: 0,1:03:38.25,1:03:41.26,Default,,0,0,0,,Оның бейтаныс адам екеніне сене алар емеспін.
Dialogue: 0,1:03:41.26,1:03:45.19,Default,,0,0,0,,Анашым, сіз қалай ойлайсыз?
Dialogue: 0,1:03:45.19,1:03:50.20,Default,,0,0,0,,Жарайды, жалғыз бізге қиын.
Dialogue: 0,1:03:50.20,1:03:52.20,Default,,0,0,0,,Мен Шинджи аман қалады деп ойламаймын.
Dialogue: 0,1:03:52.20,1:03:54.20,Default,,0,0,0,,Хойо!
Dialogue: 0,1:03:59.21,1:04:03.21,Default,,0,0,0,,Мен осындай дәмді нәрсені жегеніме біраз болды.
Dialogue: 0,1:04:03.21,1:04:07.22,Default,,0,0,0,,Егер сіз осында болғыңыз келсе
Dialogue: 0,1:04:07.22,1:04:10.22,Default,,0,0,0,,Маған бәрібір, Рюта.
Dialogue: 0,1:04:10.22,1:04:13.22,Default,,0,0,0,,Бізбен бірге өмір сүріңіз (құмыра құлаған дыбыс)
Dialogue: 0,1:04:13.22,1:04:17.23,Default,,0,0,0,,Иә, иә, иә, апа...
Dialogue: 0,1:04:17.23,1:04:20.23,Default,,0,0,0,,Әй... Апай, сізге ешқандай алғыс айта алмаймын.
Dialogue: 0,1:04:20.23,1:04:22.23,Default,,0,0,0,,Менің иығымды уқалаңыз.
Dialogue: 0,1:04:22.23,1:04:26.24,Default,,0,0,0,,Жарайды, өлген әкеңе массаж жаса. Бұл дәмді.
Dialogue: 0,1:04:26.24,1:04:28.24,Default,,0,0,0,,Хойджагаға рахмет
Dialogue: 0,1:04:28.24,1:04:31.24,Default,,0,0,0,,Балалар бұл туралы алаңдамауы керек.
Dialogue: 0,1:04:31.24,1:04:34.24,Default,,0,0,0,,Біз отбасымыз ғой... Мен...
Dialogue: 0,1:04:34.24,1:04:38.25,Default,,0,0,0,,Маған бірінші рет осындай мейірімділік танытуым!
Dialogue: 0,1:04:38.25,1:04:41.25,Default,,0,0,0,,Уау!
Dialogue: 0,1:04:41.25,1:04:44.25,Default,,0,0,0,,Тым қатты жыласаң Томоко оянады.
Dialogue: 0,1:04:44.25,1:04:46.19,Default,,0,0,0,,(Томоконың айқайы)
Dialogue: 0,1:04:46.19,1:04:48.19,Default,,0,0,0,,Қараңызшы.
Dialogue: 0,1:04:48.19,1:04:50.19,Default,,0,0,0,,Жылаудың қажеті жоқ.
Dialogue: 0,1:04:50.19,1:04:52.19,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,1:04:52.19,1:04:55.20,Default,,0,0,0,,Бұл тамаша нәрсе, солай емес пе?
Dialogue: 0,1:04:55.20,1:04:57.20,Default,,0,0,0,,Мен тамақтанбадым.
Dialogue: 0,1:04:57.20,1:05:00.20,Default,,0,0,0,,Иә, мен сені тамақтандыруым керек.
Dialogue: 0,1:05:00.20,1:05:04.21,Default,,0,0,0,,Жарайды! Менде бір идея бар.
Dialogue: 0,1:05:04.21,1:05:07.21,Default,,0,0,0,,Жұмысты орындайық!
Dialogue: 0,1:05:07.21,1:05:10.21,Default,,0,0,0,,Мен кез келген жұмысты істеймін! Мен аламын!
Dialogue: 0,1:05:10.21,1:05:13.22,Default,,0,0,0,,Мен бәрін істеймін! Мен аламын!
Dialogue: 0,1:05:13.22,1:05:18.22,Default,,0,0,0,,Сізге жұмыс беруі мүмкін адам - ​​Оранну, Анчан.
Dialogue: 0,1:05:18.22,1:05:20.22,Default,,0,0,0,,Сіз мені жаңа ғана не деп атадыңыз?
Dialogue: 0,1:05:20.22,1:05:22.22,Default,,0,0,0,,Сіз «Ан-чан» дедіңіз
Dialogue: 0,1:05:22.22,1:05:24.23,Default,,0,0,0,,Маған тағы бір рет қоңырау шалыңыз.
Dialogue: 0,1:05:24.23,1:05:26.23,Default,,0,0,0,,Ан-чан көбірек
Dialogue: 0,1:05:26.23,1:05:30.23,Default,,0,0,0,,Ан-чан, сен мені осылай атағаныңа ризасың ба?
Dialogue: 0,1:05:30.23,1:05:33.24,Default,,0,0,0,,О, мен сондай бақыттымын.
Dialogue: 0,1:05:33.24,1:05:35.24,Default,,0,0,0,,Эй, мен саған көбірек қоңырау шаламын.
Dialogue: 0,1:05:35.24,1:05:37.24,Default,,0,0,0,,Ан-чан (нанның тарсылдаған дыбысы)
Dialogue: 0,1:05:37.24,1:05:40.24,Default,,0,0,0,,Ан-чан саған керек емес пе?
Dialogue: 0,1:05:40.24,1:05:42.24,Default,,0,0,0,,Мен оны арзан ұстаймын!
Dialogue: 0,1:05:42.24,1:05:44.25,Default,,0,0,0,,Бақатаре
Dialogue: 0,1:05:44.25,1:05:47.18,Default,,0,0,0,,Балалар, сендер шынымен де қандай да бір жұмыс түрімен айналысасыңдар ма?
Dialogue: 0,1:05:47.18,1:05:50.19,Default,,0,0,0,,Ағай, маған жұмыс бересіз бе?
Dialogue: 0,1:05:50.19,1:05:53.19,Default,,0,0,0,,Жұмысыңызды сәтті аяқтасаңыз, мен сізге күніне 10 иен беремін.
Dialogue: 0,1:05:53.19,1:05:57.19,Default,,0,0,0,,10 иен!? Жаса! Мен жасаймын!
Dialogue: 0,1:05:57.19,1:06:00.20,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,1:06:00.20,1:06:02.20,Default,,0,0,0,,(цикаданың айқайы)
Dialogue: 0,1:06:02.20,1:06:06.20,Default,,0,0,0,,Оның үлкен үйі бар, өте бай.
Dialogue: 0,1:06:06.20,1:06:08.20,Default,,0,0,0,,Жүр, сал.
Dialogue: 0,1:06:08.20,1:06:11.21,Default,,0,0,0,,Әкем тағы біреуді алып келді.
Dialogue: 0,1:06:11.21,1:06:13.21,Default,,0,0,0,,Мен бәрібір бірден қашып кетемін (Харуко) Ахаха
Dialogue: 0,1:06:13.21,1:06:15.21,Default,,0,0,0,,Сіздің жұмыс орныңыз осында.
Dialogue: 0,1:06:15.21,1:06:18.21,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:06:18.21,1:06:20.22,Default,,0,0,0,,Сасық! Эй!
Dialogue: 0,1:06:20.22,1:06:24.22,Default,,0,0,0,,Не? Бұл бөлмеде боқ пен зәр толып жатыр.
Dialogue: 0,1:06:24.22,1:06:28.22,Default,,0,0,0,,Құрттардың үнемі көктеп шығуы шыдамайды.
Dialogue: 0,1:06:28.22,1:06:32.23,Default,,0,0,0,,Сейджи мен сені күту үшін біреуді алып келдім.
Dialogue: 0,1:06:32.23,1:06:35.23,Default,,0,0,0,,Маған (Сейджи) бірдеңе айтыңызшы... Аға.
Dialogue: 0,1:06:35.23,1:06:38.23,Default,,0,0,0,,Иә, балалар, өздеріңе жақсы қарау керек.
Dialogue: 0,1:06:38.23,1:06:41.24,Default,,0,0,0,,Тоқта, саған айтар сөзім бар, аға.
Dialogue: 0,1:06:41.24,1:06:45.17,Default,,0,0,0,,Уф... (Рюта/Ген) Уф!
Dialogue: 0,1:06:45.17,1:06:47.18,Default,,0,0,0,,Оххххххх!
Dialogue: 0,1:06:47.18,1:06:51.18,Default,,0,0,0,,Күткендей (Акико) Мен бірден қашамын.
Dialogue: 0,1:06:51.18,1:06:54.18,Default,,0,0,0,,Осылай болғанша оны жай қалдырыңыз.
Dialogue: 0,1:06:54.18,1:06:57.19,Default,,0,0,0,,Енді не істеуім керек? Ан-чан
Dialogue: 0,1:06:57.19,1:06:59.19,Default,,0,0,0,,10 иен үшін сізге Томоко сүті керек.
Dialogue: 0,1:06:59.19,1:07:01.19,Default,,0,0,0,,Ходжана (Сейджи) Міне, лашын!
Dialogue: 0,1:07:01.19,1:07:04.19,Default,,0,0,0,,Сіз біз туралы айтып отырсыз ба? Солай сияқты
Dialogue: 0,1:07:04.19,1:07:07.20,Default,,0,0,0,,Қайырлы таң, менің құрттарымды алып, бөлмеңді жина.
Dialogue: 0,1:07:07.20,1:07:10.20,Default,,0,0,0,,Иә Иә
Dialogue: 0,1:07:10.20,1:07:14.20,Default,,0,0,0,,♪Құрт ақ, сондай лас.
Dialogue: 0,1:07:14.20,1:07:18.21,Default,,0,0,0,,♪Тазалау Тазалау қызық!
Dialogue: 0,1:07:18.21,1:07:21.21,Default,,0,0,0,,Ол жігіттер қашпайды. (Акико) Олар жынды.
Dialogue: 0,1:07:21.21,1:07:23.21,Default,,0,0,0,,Харуко! Акико!
Dialogue: 0,1:07:23.21,1:07:26.22,Default,,0,0,0,,Пика ауруын жұқтырып алсаңыз не істейсіз?
Dialogue: 0,1:07:26.22,1:07:28.22,Default,,0,0,0,,Иә, сол жаққа барыңыз!
Dialogue: 0,1:07:28.22,1:07:32.22,Default,,0,0,0,,Сіз Сейджи мырзаны ауруханаға апара аласыз ба?
Dialogue: 0,1:07:32.22,1:07:35.22,Default,,0,0,0,,Кез келген ауруханада Пикадон қабылдаған адам
Dialogue: 0,1:07:35.22,1:07:37.23,Default,,0,0,0,,Ол жерде (хана) толы.
Dialogue: 0,1:07:37.23,1:07:39.23,Default,,0,0,0,,Ақшаңыз бен күшіңізбен
Dialogue: 0,1:07:39.23,1:07:42.23,Default,,0,0,0,,Ол Сейджиді жек көреді.
Dialogue: 0,1:07:42.23,1:07:45.17,Default,,0,0,0,,Ол менің жалғыз інім.
Dialogue: 0,1:07:45.17,1:07:47.17,Default,,0,0,0,,Менің туған ағам болсаң да
Dialogue: 0,1:07:47.17,1:07:49.17,Default,,0,0,0,,Оны жек көріп, маған сүйенбейсің бе?
Dialogue: 0,1:07:49.17,1:07:52.17,Default,,0,0,0,,Сасық, елес сияқты, жарайды.
Dialogue: 0,1:07:52.17,1:07:54.18,Default,,0,0,0,,Аң сияқты айқайлау
Dialogue: 0,1:07:54.18,1:07:58.18,Default,,0,0,0,,Көршілер бұл үйді аруақ үйі дейді.
Dialogue: 0,1:07:58.18,1:08:03.18,Default,,0,0,0,,Ху... Сейджи мырза, өліңізші.
Dialogue: 0,1:08:05.19,1:08:08.19,Default,,0,0,0,,Бақаттаре! Апыр-ай!
Dialogue: 0,1:08:08.19,1:08:10.19,Default,,0,0,0,,Ой! Сен не істеп жатырсың?
Dialogue: 0,1:08:10.19,1:08:14.20,Default,,0,0,0,,Неге сыпайы болмайсың? Мені теппесең жақсы!
Dialogue: 0,1:08:14.20,1:08:16.20,Default,,0,0,0,,Ірің жиналғандықтан таңғыш шешілмейді.
Dialogue: 0,1:08:16.20,1:08:19.20,Default,,0,0,0,,Шулы! Құс...
Dialogue: 0,1:08:19.20,1:08:22.20,Default,,0,0,0,,Әдепті болуды түсінбейсің бе, лашын?
Dialogue: 0,1:08:22.20,1:08:24.21,Default,,0,0,0,,Би! Анхан мына жігіт
Dialogue: 0,1:08:24.21,1:08:27.21,Default,,0,0,0,,Сіз оны қысып жібердіңіз бе? Бұл бар болғаны 10 иен
Dialogue: 0,1:08:27.21,1:08:30.21,Default,,0,0,0,,Партадағы кітапты ал, лашын.
Dialogue: 0,1:08:30.21,1:08:33.22,Default,,0,0,0,,Мен лашын емеспін. Накаока: Бұл Мото!
Dialogue: 0,1:08:33.22,1:08:36.22,Default,,0,0,0,,Қожа! О, бұл Рюта Кондо!
Dialogue: 0,1:08:36.22,1:08:41.22,Default,,0,0,0,,Шіріген денелермен қоректенетіндер лашындар.
Dialogue: 0,1:08:41.22,1:08:43.23,Default,,0,0,0,,Түсіндім, лашын!
Dialogue: 0,1:08:43.23,1:08:46.16,Default,,0,0,0,,Күте тұрыңыз, бұл күніне небәрі 10 иен.
Dialogue: 0,1:08:46.16,1:08:48.16,Default,,0,0,0,,Бұл 10 иен.
Dialogue: 0,1:08:48.16,1:08:50.16,Default,,0,0,0,,Қараңызшы, бұл кітап.
Dialogue: 0,1:08:53.17,1:08:56.17,Default,,0,0,0,,Құлғынды ал
Dialogue: 0,1:08:56.17,1:08:59.17,Default,,0,0,0,,10 иен - 10 иен
Dialogue: 0,1:08:59.17,1:09:02.18,Default,,0,0,0,,Су ішкім келеді, лашын
Dialogue: 0,1:09:02.18,1:09:04.18,Default,,0,0,0,,Кітап
Dialogue: 0,1:09:04.18,1:09:06.18,Default,,0,0,0,,Құлғынды ал
Dialogue: 0,1:09:06.18,1:09:09.18,Default,,0,0,0,,Рюта! Бұл не? Ан-чан
Dialogue: 0,1:09:09.18,1:09:14.19,Default,,0,0,0,,10 иен төлеуді тоқтатыңыз. Қартайғанда тоқмейілсіп қалма!
Dialogue: 0,1:09:14.19,1:09:19.19,Default,,0,0,0,,Оля! Оля! (Сейджи) Уау!
Dialogue: 0,1:09:19.19,1:09:22.20,Default,,0,0,0,,Сен маған қамқор бола аласың ба?
Dialogue: 0,1:09:22.20,1:09:25.20,Default,,0,0,0,,Әй, мен мына ақымақты аламын ба?
Dialogue: 0,1:09:25.20,1:09:28.20,Default,,0,0,0,,Мен үйге бара жатырмын! О, мен жиіркенішті сезінемін!
Dialogue: 0,1:09:28.20,1:09:31.21,Default,,0,0,0,,Ал... күте тұрыңыз! Накаока мырза, осылай болды.
Dialogue: 0,1:09:31.21,1:09:34.21,Default,,0,0,0,,Әтеш, сен біздің атымызды бірінші рет атадың.
Dialogue: 0,1:09:34.21,1:09:36.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:38.21,1:09:43.22,Default,,0,0,0,,Соққыдан ауырды ма? Жоқ, мен бақытты болдым.
Dialogue: 0,1:09:43.22,1:09:46.15,Default,,0,0,0,,Таяқ жесе қуану біртүрлі.
Dialogue: 0,1:09:46.15,1:09:48.16,Default,,0,0,0,,Қызық жігіт
Dialogue: 0,1:09:48.16,1:09:52.16,Default,,0,0,0,,Мен сені көбірек ұруым керек пе еді? Иә, мен сені ұрсам, иә.
Dialogue: 0,1:09:52.16,1:09:55.16,Default,,0,0,0,,Иә, маған қатты тиді.
Dialogue: 0,1:09:55.16,1:09:58.17,Default,,0,0,0,,Неге сонша ұрғың келеді?
Dialogue: 0,1:09:58.17,1:10:01.17,Default,,0,0,0,,Терінің бір бөлігі ғана шығып кетті
Dialogue: 0,1:10:01.17,1:10:04.17,Default,,0,0,0,,Адамдардың жүрегі жағымсыз жолмен өзгеруі мүмкін.
Dialogue: 0,1:10:04.17,1:10:06.17,Default,,0,0,0,,Менің ағам да, әйелім де
Dialogue: 0,1:10:06.17,1:10:10.18,Default,,0,0,0,,Харуко да, Акико да маған «аға, аға» деп қарады.
Dialogue: 0,1:10:10.18,1:10:14.18,Default,,0,0,0,,Барлығы менен алыстап кетті.
Dialogue: 0,1:10:14.18,1:10:17.19,Default,,0,0,0,,Маған қамқорлық жасауға көп адамдар келді.
Dialogue: 0,1:10:17.19,1:10:21.19,Default,,0,0,0,,Барлығы, мынау, дереу қашып кетті.
Dialogue: 0,1:10:21.19,1:10:26.19,Default,,0,0,0,,Маған шындап келген тек сендерсіңдер.
Dialogue: 0,1:10:26.19,1:10:29.19,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,1:10:36.20,1:10:39.21,Default,,0,0,0,,Рюта Не? Ан-чан
Dialogue: 0,1:10:39.21,1:10:41.21,Default,,0,0,0,,Анама не айтыңыз?
Dialogue: 0,1:10:41.21,1:10:43.21,Default,,0,0,0,,Біраз уақыт үйге бара алмайтын шығармын.
Dialogue: 0,1:10:43.21,1:10:46.21,Default,,0,0,0,,Жарайды, Ан-Чан, мен барамын.
Dialogue: 0,1:10:46.21,1:10:48.22,Default,,0,0,0,,Ген…
Dialogue: 0,1:10:48.22,1:10:51.22,Default,,0,0,0,,Сэйджи-сан, көңіліңді көтер.
Dialogue: 0,1:10:51.22,1:10:53.22,Default,,0,0,0,,Ух... Ой...
Dialogue: 0,1:10:53.22,1:10:58.23,Default,,0,0,0,,Жылама, күліп, көңіліңді көтер Ууу...
Dialogue: 0,1:10:58.23,1:11:01.23,Default,,0,0,0,,Күліп, ауруды үрле! Эй!
Dialogue: 0,1:11:01.23,1:11:06.23,Default,,0,0,0,,Я... Тоқташы, хехехе, тоқтат, генерал Ахаха!
Dialogue: 0,1:11:06.23,1:11:12.24,Default,,0,0,0,,Ахаха, тоқтатшы Ген Ахаха, хахаха!
Dialogue: 0,1:11:12.24,1:11:17.25,Default,,0,0,0,,《Егер Ген дұрыс болса, менің көңіл-күйімді көтеру керек.》
Dialogue: 0,1:11:17.25,1:11:21.25,Default,,0,0,0,,《Мен бұл қолмен енді ешқашан сүйікті суретімді сала алмаймын деп ойладым.
Dialogue: 0,1:11:21.25,1:11:24.25,Default,,0,0,0,,Сіз қолыңызды пайдалансаңыз да сурет сала аласыз.
Dialogue: 0,1:11:24.25,1:11:28.26,Default,,0,0,0,,(цикаданың айқайы)
Dialogue: 0,1:11:28.26,1:11:31.26,Default,,0,0,0,,Гооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо
Dialogue: 0,1:11:31.26,1:11:34.26,Default,,0,0,0,,Ааа аа...
Dialogue: 0,1:11:34.26,1:11:36.26,Default,,0,0,0,,Уууу…
Dialogue: 0,1:11:36.26,1:11:38.27,Default,,0,0,0,,Жоқ... Жоқ, жоқ.
Dialogue: 0,1:11:38.27,1:11:41.27,Default,,0,0,0,,Сәттілік, Сэйджи-сан!
Dialogue: 0,1:11:41.27,1:11:43.27,Default,,0,0,0,,Берілме!
Dialogue: 0,1:11:43.27,1:11:46.21,Default,,0,0,0,,Қарғыс атсын... Тәтті...
Dialogue: 0,1:11:46.21,1:11:49.21,Default,,0,0,0,,Кук кук... уфх
Dialogue: 0,1:11:49.21,1:11:52.21,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,1:11:52.21,1:11:54.22,Default,,0,0,0,,Уф, у…
Dialogue: 0,1:11:54.22,1:11:56.22,Default,,0,0,0,,Сәттілік! жалғастыра бер!
Dialogue: 0,1:11:56.22,1:11:59.22,Default,,0,0,0,,Берілме! Дұрыс, дұрыс!
Dialogue: 0,1:11:59.22,1:12:01.22,Default,,0,0,0,,100 иен енгізіңіз
Dialogue: 0,1:12:01.22,1:12:04.23,Default,,0,0,0,,Сәлем... Хя... 100 иен!?
Dialogue: 0,1:12:04.23,1:12:08.23,Default,,0,0,0,,Жоқ! Маған қамқорлық жасауға рұқсат етіңіз
Dialogue: 0,1:12:08.23,1:12:11.23,Default,,0,0,0,,Інімнің де бақытты болатынына шын жүректен сенімдімін.
Dialogue: 0,1:12:11.23,1:12:13.24,Default,,0,0,0,,Мен ризамын.
Dialogue: 0,1:12:13.24,1:12:16.24,Default,,0,0,0,,Жарайды, менің ағам солай істеді.
Dialogue: 0,1:12:16.24,1:12:21.24,Default,,0,0,0,,Иә, енді мен Томокоға сүт сатып аламын.
Dialogue: 0,1:12:21.24,1:12:24.25,Default,,0,0,0,,Сізге жақсы, қайта келіңіз.
Dialogue: 0,1:12:24.25,1:12:26.25,Default,,0,0,0,,Сэйджи-санға да сәттілік!
Dialogue: 0,1:12:26.25,1:12:28.25,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:12:28.25,1:12:32.25,Default,,0,0,0,,Жарайды, мен істеймін. Сендер қолыңнан келгеннің бәрін жасауың керек.
Dialogue: 0,1:12:32.25,1:12:35.26,Default,,0,0,0,,♪Джанджанг картопы
Dialogue: 0,1:12:35.26,1:12:37.26,Default,,0,0,0,,♪Тәтті картоп
Dialogue: 0,1:12:37.26,1:12:42.26,Default,,0,0,0,,♪Қуырсаңыз, қайнатыңыз, жеңіз
Dialogue: 0,1:12:42.26,1:12:47.20,Default,,0,0,0,,♪ Менің ішім ісіп кетті Боу Бу Боо!
Dialogue: 0,1:12:47.20,1:12:51.21,Default,,0,0,0,,♪Сасық иіс шығады, Боу Бу Бу!
Dialogue: 0,1:12:51.21,1:12:56.21,Default,,0,0,0,,
Dialogue: 0,1:12:59.21,1:13:03.22,Default,,0,0,0,,Бір кесеге 10 иен болса, бар болғаны 10 иен қалды.
Dialogue: 0,1:13:03.22,1:13:06.22,Default,,0,0,0,,Бірінші келген, бірінші қызмет етеді! (Қызметкерлер) Сізге сүт керек пе?
Dialogue: 0,1:13:06.22,1:13:09.22,Default,,0,0,0,,Сүт! Сүт қоректік заттарға толы!
Dialogue: 0,1:13:09.22,1:13:12.23,Default,,0,0,0,,Америкадан тікелей жеткізілген ұнтақ сүт
Dialogue: 0,1:13:12.23,1:13:15.23,Default,,0,0,0,,Сіз оны осында алу арқылы басқа ештеңе ала алмайсыз.
Dialogue: 0,1:13:15.23,1:13:18.23,Default,,0,0,0,,Қария, сол сүттің бәрін маған берші.
Dialogue: 0,1:13:18.23,1:13:22.24,Default,,0,0,0,,Иә? Сізде ақша бар ма?
Dialogue: 0,1:13:22.24,1:13:25.24,Default,,0,0,0,,Қараңызшы, бұл былай.
Dialogue: 0,1:13:25.24,1:13:28.24,Default,,0,0,0,,Не?! (Сатушы) О!
Dialogue: 0,1:13:28.24,1:13:32.25,Default,,0,0,0,,Анашым! Томоко!
Dialogue: 0,1:13:32.25,1:13:35.25,Default,,0,0,0,,Апай!
Dialogue: 0,1:13:35.25,1:13:38.25,Default,,0,0,0,,Сүт! Сүт!
Dialogue: 0,1:13:38.25,1:13:41.26,Default,,0,0,0,,Үлкен сүт өнімі!
Dialogue: 0,1:13:41.26,1:13:48.20,Default,,0,0,0,,♪Томоко сүті Томоко сүті Томоко сүті~
Dialogue: 0,1:13:48.20,1:13:53.20,Default,,0,0,0,,♪Бұл Томоконың сүті ♪Бұл Томоконың сүті~
Dialogue: 0,1:14:01.21,1:14:05.21,Default,,0,0,0,,Анашым! Апай!
Dialogue: 0,1:14:05.21,1:14:08.22,Default,,0,0,0,,Мама, мен үйдемін!
Dialogue: 0,1:14:08.22,1:14:12.22,Default,,0,0,0,,Қараңдар! Бұл нағыз сүт
Dialogue: 0,1:14:12.22,1:14:15.22,Default,,0,0,0,,Мен қара базардан бәрін сатып алдым.
Dialogue: 0,1:14:15.22,1:14:19.23,Default,,0,0,0,,Енді ештеңені уайымдаудың қажеті жоқ. Енді Томоко-чан да.
Dialogue: 0,1:14:19.23,1:14:21.23,Default,,0,0,0,,Өзіңізді жақсы сезінесіз
Dialogue: 0,1:14:21.23,1:14:24.23,Default,,0,0,0,,Сәлем! Эй, капитан, бұл үлкен жетістік.
Dialogue: 0,1:14:24.23,1:14:29.24,Default,,0,0,0,,Сәттілік! (2 адам) Аман болсын! Ура! Ура!
Dialogue: 0,1:14:29.24,1:14:31.24,Default,,0,0,0,,Абайлаңыз! Кашира кетіп қалды!
Dialogue: 0,1:14:31.24,1:14:34.24,Default,,0,0,0,,Қараңызшы, анашым.
Dialogue: 0,1:14:48.19,1:14:51.19,Default,,0,0,0,,Ааа...
Dialogue: 0,1:14:51.19,1:14:55.20,Default,,0,0,0,,Ууу... ха ха...
Dialogue: 0,1:14:55.20,1:15:03.20,Default,,0,0,0,,Ген Кеш болды... Кеш болды.
Dialogue: 0,1:15:03.20,1:15:05.20,Default,,0,0,0,,Ахх...
Dialogue: 0,1:15:08.21,1:15:11.21,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:11.21,1:15:15.22,Default,,0,0,0,,Ал... Томоко... Ааааа...
Dialogue: 0,1:15:15.22,1:15:20.22,Default,,0,0,0,,Томоко! Томоко! Көзіңді аш!
Dialogue: 0,1:15:20.22,1:15:22.22,Default,,0,0,0,,Мен нағыз сүт әкелдім.
Dialogue: 0,1:15:22.22,1:15:25.23,Default,,0,0,0,,Томоко! Не болды?
Dialogue: 0,1:15:25.23,1:15:27.23,Default,,0,0,0,,Иә, көзіңді аш.
Dialogue: 0,1:15:27.23,1:15:31.23,Default,,0,0,0,,Томоко көзін ашпайды. Томоко жыламайды.
Dialogue: 0,1:15:31.23,1:15:37.24,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,1:15:37.24,1:15:41.24,Default,,0,0,0,,Уф…
Dialogue: 0,1:15:41.24,1:15:45.18,Default,,0,0,0,,Жыла, жыла, көзіңді аш
Dialogue: 0,1:15:45.18,1:15:49.18,Default,,0,0,0,,Жақсылық жоқ, жақсылық жоқ, өлсең жақсылық жоқ!
Dialogue: 0,1:15:49.18,1:15:52.19,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,1:15:52.19,1:15:57.19,Default,,0,0,0,,Ой... неге... неге маған айтпай өлмейсің?
Dialogue: 0,1:15:57.19,1:16:02.20,Default,,0,0,0,,Томоко~! Уф...
Dialogue: 0,1:16:02.20,1:16:04.20,Default,,0,0,0,,Уууу…
Dialogue: 0,1:16:12.21,1:16:16.21,Default,,0,0,0,,《Әке, әпке, Шинжи! 》
Dialogue: 0,1:16:16.21,1:16:19.21,Default,,0,0,0,,《Мен Томоконы қорғай алмадым》
Dialogue: 0,1:16:19.21,1:16:23.22,Default,,0,0,0,,《Кешіріңіз, кешіріңіз...》
Dialogue: 0,1:16:23.22,1:16:43.24,Default,,0,0,0,,Сен
Dialogue: 0,1:16:43.24,1:17:03.19,Default,,0,0,0,,Сен
Dialogue: 0,1:17:03.19,1:17:07.20,Default,,0,0,0,,Сен
Dialogue: 0,1:17:07.20,1:17:12.20,Default,,0,0,0,,(Өзен дыбысы)
Dialogue: 0,1:17:12.20,1:17:15.20,Default,,0,0,0,,Ан-чан Хиросимада 70 жыл болды
Dialogue: 0,1:17:15.20,1:17:20.21,Default,,0,0,0,,Шөп те, ағаш та өспейді деген рас па?
Dialogue: 0,1:17:20.21,1:17:24.21,Default,,0,0,0,,Бұдан былай
Dialogue: 0,1:17:24.21,1:17:26.21,Default,,0,0,0,,Не болады?
Dialogue: 0,1:17:28.22,1:17:30.22,Default,,0,0,0,,Иә
Dialogue: 0,1:17:30.22,1:17:34.22,Default,,0,0,0,,Ан-чан, сен жақсы емессің. Мен бақытты емеспін.
Dialogue: 0,1:17:34.22,1:17:36.22,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,1:17:36.22,1:17:40.23,Default,,0,0,0,,Күте тұрыңыз! Күтіңіз, күтіңіз, иә!
Dialogue: 0,1:17:40.23,1:17:43.23,Default,,0,0,0,,Иә? Ан-Чан, кел!
Dialogue: 0,1:17:43.23,1:17:46.17,Default,,0,0,0,,Иә, иә! Не?
Dialogue: 0,1:17:46.17,1:17:49.17,Default,,0,0,0,,Мынаны қараңызшы?
Dialogue: 0,1:17:49.17,1:17:53.17,Default,,0,0,0,,Бүршік... Бүршік өсіп шығады.
Dialogue: 0,1:17:53.17,1:17:57.18,Default,,0,0,0,,Бидай қақаған қыста көктеп шығады.
Dialogue: 0,1:17:57.18,1:18:00.18,Default,,0,0,0,,Талай рет басқан, Жерге нық орнаған
Dialogue: 0,1:18:00.18,1:18:04.19,Default,,0,0,0,,Аяз да, жел де, қар да соқса да көніп, түзу өсемін.
Dialogue: 0,1:18:04.19,1:18:07.19,Default,,0,0,0,,Жіңішке құлақтар жасаңыз
Dialogue: 0,1:18:07.19,1:18:10.19,Default,,0,0,0,,Сен де мына бидайдай күшті болып өсесің.
Dialogue: 0,1:18:10.19,1:18:13.19,Default,,0,0,0,,Жемістерді молырақ шығару
Dialogue: 0,1:18:13.19,1:18:16.20,Default,,0,0,0,,Бидай аман қалады, хехе, аман қалады.
Dialogue: 0,1:18:16.20,1:18:18.20,Default,,0,0,0,,Хехехе
Dialogue: 0,1:18:21.20,1:18:24.21,Default,,0,0,0,,Мен аман қаламын, Пика сияқты нәрседен жеңілмеймін.
Dialogue: 0,1:18:24.21,1:18:27.21,Default,,0,0,0,,Ештеңе демеген жігіт ондаған жылдар бойы өседі
Dialogue: 0,1:18:27.21,1:18:29.21,Default,,0,0,0,,Бұл кім? ми? Ан-чан
Dialogue: 0,1:18:29.21,1:18:32.21,Default,,0,0,0,,О? Сол бас! иә?
Dialogue: 0,1:18:32.21,1:18:36.22,Default,,0,0,0,,Менің басымда шаш өсіп жатыр!
Dialogue: 0,1:18:36.22,1:18:38.22,Default,,0,0,0,,Ан-чан, сенің басыңдағы шаш
Dialogue: 0,1:18:38.22,1:18:41.22,Default,,0,0,0,,Томоко-чан өлудің орнына қайта туылған болуы мүмкін.
Dialogue: 0,1:18:41.22,1:18:43.22,Default,,0,0,0,,Томоко? Иә, мен сенімдімін.
Dialogue: 0,1:18:43.22,1:18:45.16,Default,,0,0,0,,Иә, мұны маған айта аласыз.
Dialogue: 0,1:18:45.16,1:18:49.16,Default,,0,0,0,,О, сен Томоконың өмірін қатерге тігесің!
Dialogue: 0,1:18:49.16,1:18:52.17,Default,,0,0,0,,♪Бидай өсті, шашы да өсті.
Dialogue: 0,1:18:52.17,1:18:55.17,Default,,0,0,0,,♪Әтеш шашы әлі өскен жоқ
Dialogue: 0,1:18:55.17,1:18:57.17,Default,,0,0,0,,Күшік Бақатаре
Dialogue: 0,1:18:57.17,1:19:00.17,Default,,0,0,0,,Жоқ! Апай білсін
Dialogue: 0,1:19:02.18,1:19:05.18,Default,,0,0,0,,《Әке, мен жеңілмеймін》
Dialogue: 0,1:19:05.18,1:19:08.18,Default,,0,0,0,,《Өмір сүр, өмір сүр, аман бол》
Dialogue: 0,1:19:08.18,1:19:10.18,Default,,0,0,0,,《Маған қарашы》
Dialogue: 0,1:19:13.19,1:19:16.19,Default,,0,0,0,,Ан-чан, қайтып кел.
Dialogue: 0,1:19:16.19,1:19:18.19,Default,,0,0,0,,Өзенге барып, кемені жүргіз.
Dialogue: 0,1:19:18.19,1:19:20.19,Default,,0,0,0,,Бұл уәде!
Dialogue: 0,1:19:20.19,1:19:30.20,Default,,0,0,0,,Сен
Dialogue: 0,1:19:30.20,1:19:33.20,Default,,0,0,0,,Ан-чан, сен не істей бастадың?
Dialogue: 0,1:19:39.21,1:19:42.22,Default,,0,0,0,,Синдзи, бұл сенің әскери кемең.
Dialogue: 0,1:19:42.22,1:19:45.12,Default,,0,0,0,,Уәде етілгендей, мен мұны іске қосамын.
Dialogue: 0,1:19:49.16,1:19:51.16,Default,,0,0,0,,(сіріңкені жағу дыбысы)
Dialogue: 0,1:19:53.16,1:19:55.16,Default,,0,0,0,,Иә? Рюта: Иә.
Dialogue: 0,1:19:55.16,1:19:58.16,Default,,0,0,0,,Анашым, солай ма? Иә
Dialogue: 0,1:20:10.18,1:20:30.20,Default,,0,0,0,,Сен
Dialogue: 0,1:20:30.20,1:20:50.22,Default,,0,0,0,,Сен
Dialogue: 0,1:20:50.22,1:21:10.24,Default,,0,0,0,,Сен
Dialogue: 0,1:21:10.24,1:21:30.26,Default,,0,0,0,,Сен
Dialogue: 0,1:21:30.26,1:21:50.21,Default,,0,0,0,,Сен
Dialogue: 0,1:21:50.21,1:22:10.23,Default,,0,0,0,,Сен
Dialogue: 0,1:22:10.23,1:22:30.25,Default,,0,0,0,,Сен
Dialogue: 0,1:22:30.25,1:22:50.20,Default,,0,0,0,,Сен
Dialogue: 0,1:22:50.20,1:23:10.22,Default,,0,0,0,,Сен
Dialogue: 0,1:23:10.22,1:23:30.24,Default,,0,0,0,,Сен
Dialogue: 0,1:23:30.24,1:23:50.20,Default,,0,0,0,,Сен
Dialogue: 0,1:23:50.20,1:24:02.10,Default,,0,0,0,,Сен
