Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.16,0:00:03.33,Default,,0,0,0,,Ай!
Dialogue: 0,0:00:03.46,0:00:04.50,Default,,0,0,0,,(құты ашылған дыбыс)
Dialogue: 0,0:00:06.63,0:00:07.46,Default,,0,0,0,,Ей!
Dialogue: 0,0:00:07.59,0:00:09.25,Default,,0,0,0,,Оянғанда сыра?
Dialogue: 0,0:00:09.75,0:00:10.67,Default,,0,0,0,,(дауыс дыбысы)
Dialogue: 0,0:00:11.05,0:00:12.67,Default,,0,0,0,,Бұл арпа шырыны.
Dialogue: 0,0:00:12.80,0:00:14.13,Default,,0,0,0,,Сіз бұл жолы не істейсіз?
Dialogue: 0,0:00:14.26,0:00:15.22,Default,,0,0,0,,Профессионалды күрес?
Dialogue: 0,0:00:15.34,0:00:16.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:17.30,0:00:19.10,Default,,0,0,0,,Бір адам әлі келген жоқ.
Dialogue: 0,0:00:19.76,0:00:22.48,Default,,0,0,0,,Бірақ ол келгенше сөйлесейік.
Dialogue: 0,0:00:23.39,0:00:27.15,Default,,0,0,0,,Бұл ұзақ әңгіме, сіз бірінші рет естіген нәрселер көп шығар.
Dialogue: 0,0:00:27.73,0:00:28.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:28.94,0:00:30.86,Default,,0,0,0,,Бұл жолы өте қауіпті.
Dialogue: 0,0:00:31.19,0:00:32.82,Default,,0,0,0,,Қаласаңыз, түсе аласыз.
Dialogue: 0,0:00:36.95,0:00:39.37,Default,,0,0,0,,Масато тынышталсын!
Dialogue: 0,0:00:40.29,0:00:42.70,Default,,0,0,0,,Мен сені де, анамды да жақсы көрдім.
Dialogue: 0,0:00:42.83,0:00:44.46,Default,,0,0,0,,Әрине, қазір де.
Dialogue: 0,0:00:44.79,0:00:48.59,Default,,0,0,0,,Шаңхайдағы ұйымға кіруден басқа амалым қалмады.
Dialogue: 0,0:00:49.17,0:00:50.84,Default,,0,0,0,,Енді мылтықты қойыңыз.
Dialogue: 0,0:00:51.59,0:00:54.30,Default,,0,0,0,,Маған сеніңіз, өтінемін!
Dialogue: 0,0:00:59.22,0:01:01.51,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:03.98,0:01:04.81,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:01:19.53,0:01:24.12,Default,,0,0,0,,(теңіз құстарының айқайы)
Dialogue: 0,0:01:24.83,0:01:27.58,Default,,0,0,0,,(судың шашырауы)
Dialogue: 0,0:01:29.08,0:01:33.30,Default,,0,0,0,,Бұл Oz қуыршақ сәл артық болды.
Dialogue: 0,0:01:33.42,0:01:35.84,Default,,0,0,0,,Олар еске алынбайды деп үміттенейік.
Dialogue: 0,0:01:36.22,0:01:39.51,Default,,0,0,0,,Уау~ Мен теңіз суын ішкеніме біраз болды.
Dialogue: 0,0:01:39.64,0:01:42.39,Default,,0,0,0,,Әр жолы, әр жолы, мен өлген сияқтымын.
Dialogue: 0,0:01:42.51,0:01:44.39,Default,,0,0,0,,Жақсырақ қадам ойла
Dialogue: 0,0:01:44.52,0:01:47.02,Default,,0,0,0,,Сізде шынымен идеялар таусылып жатыр.
Dialogue: 0,0:01:47.19,0:01:49.56,Default,,0,0,0,,Сіз дұрыс емес адамға шағымданып жатырсыз.
Dialogue: 0,0:01:49.69,0:01:50.52,Default,,0,0,0,,Таку
Dialogue: 0,0:01:51.11,0:01:53.94,Default,,0,0,0,,Қартты қанша жұмыс істеуді жоспарлайсыз?
Dialogue: 0,0:01:54.11,0:01:57.03,Default,,0,0,0,,Сондықтан артыңыздағы жігітке шағымданыңыз.
Dialogue: 0,0:01:57.15,0:01:57.99,Default,,0,0,0,,Иә
Dialogue: 0,0:01:58.66,0:02:00.78,Default,,0,0,0,,Мен оны дәл солай қайтарамын.
Dialogue: 0,0:02:00.91,0:02:01.74,Default,,0,0,0,,Фу…
Dialogue: 0,0:02:02.33,0:02:04.49,Default,,0,0,0,,Екеуінен кешірім сұра, Оз.
Dialogue: 0,0:02:04.62,0:02:06.33,Default,,0,0,0,,Біраздан бері шу болды.
Dialogue: 0,0:02:06.45,0:02:07.29,Default,,0,0,0,,О
Dialogue: 0,0:02:07.46,0:02:10.50,Default,,0,0,0,,Сізге қауіп төндіргенім үшін кешіріңіз.
Dialogue: 0,0:02:10.75,0:02:11.63,Default,,0,0,0,,Көрсетілгендей
Dialogue: 0,0:02:11.75,0:02:12.75,Default,,0,0,0,,О Оз
Dialogue: 0,0:02:13.42,0:02:16.51,Default,,0,0,0,,Мұның бәрі аққұбаның баласы кінәлі.
Dialogue: 0,0:02:16.63,0:02:17.47,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:02:18.22,0:02:21.89,Default,,0,0,0,,Ол мен барлаған жігітке ұқсамайтын жақсы мүше.
Dialogue: 0,0:02:22.01,0:02:22.85,Default,,0,0,0,,Маған ұнады — тым драмалық естіледі!
Dialogue: 0,0:02:23.10,0:02:24.47,Default,,0,0,0,,Тағы бір адам жоқ.
Dialogue: 0,0:02:26.64,0:02:28.18,Default,,0,0,0,,Бұл жұмыс істеді ме деп ойлаймын.
Dialogue: 0,0:02:28.39,0:02:29.35,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:02:29.56,0:02:33.52,Default,,0,0,0,,Бұл бастапқы жоспардан біршама өзгерді, солай емес пе?
Dialogue: 0,0:02:33.65,0:02:35.86,Default,,0,0,0,,Әрине, ол қазірдің өзінде қосылды.
Dialogue: 0,0:02:35.98,0:02:38.99,Default,,0,0,0,,Мен әрқашан осылай құтыламын.
Dialogue: 0,0:02:39.78,0:02:42.45,Default,,0,0,0,,Сіз Эдамамды сүйреп кірдіңіз, солай ма?
Dialogue: 0,0:02:42.62,0:02:44.62,Default,,0,0,0,,Олай болса, маған кішкене сеніңіз.
Dialogue: 0,0:02:44.74,0:02:47.37,Default,,0,0,0,,Басынан түсіндіріп бергеніңіз дұрыс емес пе еді?
Dialogue: 0,0:02:47.66,0:02:48.96,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:02:49.08,0:02:51.04,Default,,0,0,0,,Ол мен барғанға дейін болды.
Dialogue: 0,0:02:51.17,0:02:52.58,Default,,0,0,0,,Ол арамза шарлатан еді, солай емес пе?
Dialogue: 0,0:02:53.63,0:02:57.17,Default,,0,0,0,,Бұратино сияқты ұзын мұрнын сындырдым.
Dialogue: 0,0:02:57.30,0:02:59.59,Default,,0,0,0,,Енді сен тіпті маған ризасың
Dialogue: 0,0:03:00.34,0:03:04.10,Default,,0,0,0,,Эдамаменің ерекшеліктерін түсіндірудің қажеті жоқ.
Dialogue: 0,0:03:05.64,0:03:06.93,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:07.14,0:03:10.60,Default,,0,0,0,,Егер оған стратегияны айтсаң, ол бірден сөйлейтін жігіт.
Dialogue: 0,0:03:10.73,0:03:11.56,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:03:12.48,0:03:13.77,Default,,0,0,0,,Жақсы
Dialogue: 0,0:03:13.90,0:03:16.61,Default,,0,0,0,,Әкемге ештеңе айтпастан қалтасына салу
Dialogue: 0,0:03:16.73,0:03:19.32,Default,,0,0,0,,Бұл да едамаменің қауіпсіздігі үшін.
Dialogue: 0,0:03:19.65,0:03:20.78,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,0:03:20.90,0:03:21.86,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:21.99,0:03:25.66,Default,,0,0,0,,Бұл түсініктеме сияқты, бірақ софизм сияқты естіледі.
Dialogue: 0,0:03:25.78,0:03:28.12,Default,,0,0,0,,Бірақ әрі қарай не болады?
Dialogue: 0,0:03:28.79,0:03:33.17,Default,,0,0,0,,Сіз оған бәрін айтып берсеңіз де, ол қазір сенеді деп ойлайсыз ба?
Dialogue: 0,0:03:34.96,0:03:35.92,Default,,0,0,0,,Лоран
Dialogue: 0,0:03:36.13,0:03:37.92,Default,,0,0,0,,Сіз оны жақсы жеткізесіз деп үміттенемін.
Dialogue: 0,0:03:38.05,0:03:40.67,Default,,0,0,0,,Жарайды, мен саған қалдырамын.
Dialogue: 0,0:03:41.05,0:03:41.88,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:03:42.63,0:03:45.26,Default,,0,0,0,,Мен ескі досыма баруым керек пе?
Dialogue: 0,0:03:47.39,0:03:53.39,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:04:45.86,0:04:51.87,Default,,0,0,0,,~♪
Dialogue: 0,0:04:53.04,0:04:57.67,Default,,0,0,0,,<Шетелде соғысқанда тілдік кедергі күткеннен жоғары>
Dialogue: 0,0:04:58.21,0:04:59.29,Default,,0,0,0,,<Сіз түсінесіз бе? 〉
Dialogue: 0,0:04:59.79,0:05:02.38,Default,,0,0,0,,〈Озды жоғалтуымыздың мәні〉
Dialogue: 0,0:05:03.01,0:05:04.30,Default,,0,0,0,,〈Әйтеуір...〉
Dialogue: 0,0:05:04.42,0:05:05.59,Default,,0,0,0,,〈Басқаша айтқанда〉
Dialogue: 0,0:05:05.72,0:05:10.60,Default,,0,0,0,,〈Егер сізде сенімді аудармашы болмаса, келіссөздерді өз пайдаңызға қарай алға жылжыта алмайсыз...〉
Dialogue: 0,0:05:10.76,0:05:11.97,Default,,0,0,0,,<Мүмкін емес>
Dialogue: 0,0:05:12.10,0:05:14.52,Default,,0,0,0,,〈Жарайды, мен таныстарымнан сұрайын.〉
Dialogue: 0,0:05:14.64,0:05:17.48,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:05:18.15,0:05:18.98,Default,,0,0,0,,<Не? 〉
Dialogue: 0,0:05:19.90,0:05:21.23,Default,,0,0,0,,<Себебі! 〉
Dialogue: 0,0:05:21.44,0:05:23.03,Default,,0,0,0,,〈Oioi〉
Dialogue: 0,0:05:23.19,0:05:24.74,Default,,0,0,0,,〈Дәл сол ақымақ айтқандай болды! 〉
Dialogue: 0,0:05:25.61,0:05:27.24,Default,,0,0,0,,〈Лорен келеді〉
Dialogue: 0,0:05:27.91,0:05:28.74,Default,,0,0,0,,Иә
Dialogue: 0,0:05:33.87,0:05:35.25,Default,,0,0,0,,〈Иә, мынау, мынау! 〉
Dialogue: 0,0:05:35.71,0:05:36.58,Default,,0,0,0,,(шаянның жарылған дыбысы)
Dialogue: 0,0:05:36.71,0:05:39.46,Default,,0,0,0,,〈Шанхайға келсең, баратын жер осы! 〉
Dialogue: 0,0:05:42.55,0:05:45.05,Default,,0,0,0,,〈Мм~ Бай! 〉
Dialogue: 0,0:05:45.42,0:05:47.76,Default,,0,0,0,,Содан бері не істеп жүрсің? 〉
Dialogue: 0,0:05:47.93,0:05:50.64,Default,,0,0,0,,〈Неге ертерек оралмадың? 〉
Dialogue: 0,0:05:50.76,0:05:53.89,Default,,0,0,0,,〈Аа, бұл туралы айту тым ұзақ болар еді...〉
Dialogue: 0,0:05:54.02,0:05:55.06,Default,,0,0,0,,<Ағылшын тілінде сөйлеу>
Dialogue: 0,0:05:55.18,0:05:56.52,Default,,0,0,0,,〈Оқу〉
Dialogue: 0,0:05:57.23,0:05:58.19,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:58.60,0:06:02.65,Default,,0,0,0,,Осыдан кейін мен Францияға оралып, анама қамқор болдым.
Dialogue: 0,0:06:03.23,0:06:05.15,Default,,0,0,0,,Мейірбике күтімі бірқатар қиындықтар болды
Dialogue: 0,0:06:05.78,0:06:10.07,Default,,0,0,0,,Ақыры анам екі жыл бұрын жұмаққа кеткен.
Dialogue: 0,0:06:10.53,0:06:14.66,Default,,0,0,0,,Одан кейін мұраны сұрыптау кезінде қызықсыз күн болды.
Dialogue: 0,0:06:14.79,0:06:17.16,Default,,0,0,0,,Бірақ кенет есіме түсіп кетті
Dialogue: 0,0:06:17.29,0:06:20.67,Default,,0,0,0,,Бұл Шанхай шаянының және Шанхай отбасыларының дәмі болды.
Dialogue: 0,0:06:21.63,0:06:23.54,Default,,0,0,0,,Аа, менің не айтып тұрғанымды түсіндің бе?
Dialogue: 0,0:06:23.96,0:06:25.13,Default,,0,0,0,,Шамамен
Dialogue: 0,0:06:25.30,0:06:26.13,Default,,0,0,0,,Wonderful
Dialogue: 0,0:06:27.47,0:06:29.22,Default,,0,0,0,,Негізі, ағайындар
Dialogue: 0,0:06:29.34,0:06:30.93,Default,,0,0,0,,Аудармашы жоғалып кетті
Dialogue: 0,0:06:31.05,0:06:31.93,Default,,0,0,0,,Жоғалып кетті ме?
Dialogue: 0,0:06:33.01,0:06:34.43,Default,,0,0,0,,Созаку өшірген
Dialogue: 0,0:06:34.56,0:06:36.97,Default,,0,0,0,,Қандай жексұрын.
Dialogue: 0,0:06:37.43,0:06:38.48,Default,,0,0,0,,<Сіз Созаку туралы айтып отырсыз ба? 〉
Dialogue: 0,0:06:38.60,0:06:39.44,Default,,0,0,0,,〈Аа〉
Dialogue: 0,0:06:39.56,0:06:42.69,Default,,0,0,0,,<Олар нені қалдырды деп ойлайсыңдар? 〉
Dialogue: 0,0:06:42.81,0:06:44.52,Default,,0,0,0,,<Мен барлық сатылымдарды маған бергеніңізді қалаймын! 〉
Dialogue: 0,0:06:44.65,0:06:47.03,Default,,0,0,0,,<Ха, бұл әзіл болу үшін тым қатал.>
Dialogue: 0,0:06:47.15,0:06:48.07,Default,,0,0,0,,<Ессіз>
Dialogue: 0,0:06:48.19,0:06:49.78,Default,,0,0,0,,<О, иә! 〉
Dialogue: 0,0:06:50.28,0:06:52.87,Default,,0,0,0,,〈Менімен қайтадан маджонг ойнайсың ба?〉
Dialogue: 0,0:06:53.57,0:06:54.45,Default,,0,0,0,,Жасайық! 〉
Dialogue: 0,0:06:55.24,0:06:56.33,Default,,0,0,0,,〈Сәлеметсіз бе! 〉
Dialogue: 0,0:06:57.04,0:07:00.16,Default,,0,0,0,,(желдеткіштің бұрылу дыбысы)
Dialogue: 0,0:07:01.00,0:07:02.25,Default,,0,0,0,,А...
Dialogue: 0,0:07:03.88,0:07:04.84,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:07:05.80,0:07:06.63,Default,,0,0,0,,Бітті
Dialogue: 0,0:07:07.30,0:07:08.76,Default,,0,0,0,,А...
Dialogue: 0,0:07:10.72,0:07:13.80,Default,,0,0,0,,«Бұл өмір жолы тым азапты» деп бұрын айттыңыз.
Dialogue: 0,0:07:14.14,0:07:15.30,Default,,0,0,0,,Бұл да пьеса ма?
Dialogue: 0,0:07:15.81,0:07:17.81,Default,,0,0,0,,Кел, мен ұмытып кетіппін.
Dialogue: 0,0:07:19.02,0:07:21.69,Default,,0,0,0,,Соңында мен ақымақ болдым.
Dialogue: 0,0:07:22.35,0:07:24.56,Default,,0,0,0,,Мен мұны бір жерде түсіндіремін деп едім.
Dialogue: 0,0:07:24.69,0:07:25.98,Default,,0,0,0,,Өтірік айту
Dialogue: 0,0:07:26.15,0:07:27.98,Default,,0,0,0,,Оз сиқыршысы дегеніміз не?
Dialogue: 0,0:07:28.61,0:07:31.36,Default,,0,0,0,,Сагами шығанағында жаңа ғана батып кетсе жақсы болар еді.
Dialogue: 0,0:07:33.24,0:07:34.20,Default,,0,0,0,,Айтыңыз
Dialogue: 0,0:07:34.53,0:07:36.33,Default,,0,0,0,,Мен сенің сылтауыңды тыңдаймын.
Dialogue: 0,0:07:37.58,0:07:38.79,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:40.79,0:07:44.42,Default,,0,0,0,,Мики мен сізді Шанхайдағылардан қорғау үшін.
Dialogue: 0,0:07:44.88,0:07:46.29,Default,,0,0,0,,Менің мұны істеуден басқа амалым қалмады.
Dialogue: 0,0:07:46.88,0:07:48.55,Default,,0,0,0,,Жалғыз нұсқа – байланыстарды толығымен үзу...
Dialogue: 0,0:07:48.67,0:07:50.05,Default,,0,0,0,,Сол себепті!
Dialogue: 0,0:07:50.42,0:07:53.30,Default,,0,0,0,,Неліктен отбасыңды ойламадың?
Dialogue: 0,0:07:53.43,0:07:55.55,Default,,0,0,0,,Дороти соншалықты маңызды болды ма?
Dialogue: 0,0:07:55.93,0:07:57.47,Default,,0,0,0,,Менен әлде анамнан артық па?
Dialogue: 0,0:07:57.64,0:07:59.52,Default,,0,0,0,,Қателігіңнен өлдің бе?
Dialogue: 0,0:08:00.27,0:08:01.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:03.56,0:08:05.27,Default,,0,0,0,,Сіз мұны баяғыда айтып едіңіз.
Dialogue: 0,0:08:05.90,0:08:07.69,Default,,0,0,0,,«Әрқашан дұрыс бол»
Dialogue: 0,0:08:07.82,0:08:09.69,Default,,0,0,0,,«Әлемге пайдалы болу»
Dialogue: 0,0:08:09.90,0:08:12.49,Default,,0,0,0,,«Өзгелер сыйлайтын адам бол»
Dialogue: 0,0:08:13.99,0:08:16.32,Default,,0,0,0,,Сіз бәрін керісінше істедіңіз.
Dialogue: 0,0:08:16.91,0:08:20.37,Default,,0,0,0,,Балаларыңызға өтірік айтудан ұялмайсыз ба?
Dialogue: 0,0:08:22.75,0:08:24.87,Default,,0,0,0,,Ешқашан әкеңмен бетпе-бет келме.
Dialogue: 0,0:08:25.25,0:08:27.34,Default,,0,0,0,,Ал мен саған енді сенбеймін.
Dialogue: 0,0:08:28.63,0:08:29.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:35.43,0:08:37.97,Default,,0,0,0,,Лоран мені осы уақытқа дейін не істеуге мәжбүр етті
Dialogue: 0,0:08:38.26,0:08:40.10,Default,,0,0,0,,Бұл уақыт үшін құрғақ жүгіру, солай ма?
Dialogue: 0,0:08:42.23,0:08:43.06,Default,,0,0,0,,О
Dialogue: 0,0:08:44.94,0:08:47.31,Default,,0,0,0,,I'll do it as I'm told.
Dialogue: 0,0:08:48.69,0:08:49.57,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:05.71,0:09:06.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:10.50,0:09:11.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:15.59,0:09:16.80,Default,,0,0,0,,Бұл жұмыс істейтін сияқты ма?
Dialogue: 0,0:09:17.43,0:09:18.43,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:22.97,0:09:23.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:26.73,0:09:29.06,Default,,0,0,0,,Тым болмаса бір сусынды бірге ішейік.
Dialogue: 0,0:09:30.98,0:09:33.90,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:09:36.36,0:09:37.86,Default,,0,0,0,,(дыбысты тарту)
Dialogue: 0,0:09:43.33,0:09:44.87,Default,,0,0,0,,Сіз бұршақтарды ауыстырдыңыз ба?
Dialogue: 0,0:09:45.20,0:09:46.21,Default,,0,0,0,,Иә
Dialogue: 0,0:09:46.37,0:09:49.50,Default,,0,0,0,,Мен Маса Макириман атты сирек бұршақ алдым.
Dialogue: 0,0:09:50.00,0:09:51.04,Default,,0,0,0,,және оны осы кезеңде бізге қалдыру қисынсыз болар еді, иә?
Dialogue: 0,0:09:51.46,0:09:53.34,Default,,0,0,0,,Иә, жаман емес
Dialogue: 0,0:09:55.72,0:09:56.72,Default,,0,0,0,,Масато
Dialogue: 0,0:09:56.88,0:09:57.72,Default,,0,0,0,,Иә
Dialogue: 0,0:09:58.43,0:09:59.68,Default,,0,0,0,,Қаласаңыз пайдаланыңыз.
Dialogue: 0,0:10:00.18,0:10:01.68,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:02.18,0:10:03.01,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:03.14,0:10:04.31,Default,,0,0,0,,Бұл галстук.
Dialogue: 0,0:10:04.43,0:10:05.93,Default,,0,0,0,,Бұл шықты.
Dialogue: 0,0:10:06.06,0:10:07.60,Default,,0,0,0,,"Бүгін түнде біз батырды құрметтейміз!!"
Dialogue: 0,0:10:08.60,0:10:10.19,Default,,0,0,0,,Мұнда келіңіз...
Dialogue: 0,0:10:10.69,0:10:12.69,Default,,0,0,0,,(матаның үйкелу дыбысы)
Dialogue: 0,0:10:22.07,0:10:23.66,Default,,0,0,0,,Өте орынды.
Dialogue: 0,0:10:23.78,0:10:25.33,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:26.83,0:10:29.00,Default,,0,0,0,,Бүгін бізде Шанхаймен кездесу бар.
Dialogue: 0,0:10:29.12,0:10:31.54,Default,,0,0,0,,А, мен құлықсызмын.
Dialogue: 0,0:10:31.67,0:10:34.09,Default,,0,0,0,,
Dialogue: 0,0:10:35.30,0:10:39.26,Default,,0,0,0,,〈It is important to perform poorly〉
Dialogue: 0,0:10:39.51,0:10:41.64,Default,,0,0,0,,<Әкемнің көңіл-күйін көтеріп, кездесуге жазылсам...>
Dialogue: 0,0:10:41.76,0:10:42.93,Default,,0,0,0,,<Шаракусее>
Dialogue: 0,0:10:43.05,0:10:45.85,Default,,0,0,0,,<Әй, үстелдің үстіндегі ваза жолда! Ауысым! 〉
Dialogue: 0,0:10:45.93,0:10:46.52,Default,,0,0,0,,<Ха! 〉
Dialogue: 0,0:10:49.98,0:10:51.48,Default,,0,0,0,,〈Ёши Цунагу〉
Dialogue: 0,0:10:54.23,0:10:55.69,Default,,0,0,0,,
Dialogue: 0,0:11:07.24,0:11:09.71,Default,,0,0,0,,〈Ал, неге ол жерде бірінші кезекте ешкім жоқ? 〉
Dialogue: 0,0:11:09.83,0:11:10.87,Default,,0,0,0,,<Тынышталыңыз>
Dialogue: 0,0:11:11.92,0:11:13.88,Default,,0,0,0,,<You little Japanese bastards>
Dialogue: 0,0:11:14.04,0:11:15.54,Default,,0,0,0,,〈Бұл мәселе.〉
Dialogue: 0,0:11:16.59,0:11:18.59,Default,,0,0,0,,〈Әжетханалар қарт адамдарға жақын болғандықтан〉
Dialogue: 0,0:11:19.01,0:11:19.84,Default,,0,0,0,,Иә
Dialogue: 0,0:11:19.97,0:11:20.80,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:28.10,0:11:30.52,Default,,0,0,0,,<Сіз дәретханаға аман-есен жеткен сияқтысыз.>
Dialogue: 0,0:11:35.31,0:11:37.40,Default,,0,0,0,,Liu It's been a while.
Dialogue: 0,0:11:37.61,0:11:39.07,Default,,0,0,0,,Are you feeling better?
Dialogue: 0,0:11:40.57,0:11:41.99,Default,,0,0,0,,〈қазірдің өзінде〉
Dialogue: 0,0:11:42.11,0:11:43.28,Default,,0,0,0,,Толық
Dialogue: 0,0:11:43.66,0:11:44.53,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:11:44.78,0:11:48.54,Default,,0,0,0,,Жарайды, осында келіп, басыңды иіп тұр.
Dialogue: 0,0:11:48.66,0:11:51.58,Default,,0,0,0,,I want to hear directly from your mouth.
Dialogue: 0,0:11:51.91,0:11:52.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:53.00,0:11:53.92,Default,,0,0,0,,<What did you say? 〉
Dialogue: 0,0:11:54.83,0:11:58.63,Default,,0,0,0,,<67% акция сөзсіз беріледі>
Dialogue: 0,0:11:59.96,0:12:01.22,Default,,0,0,0,,<Күтілгендей>
Dialogue: 0,0:12:01.34,0:12:03.63,Default,,0,0,0,,〈Мен оны басынан бастап жарып жібереді деп ойладым〉
Dialogue: 0,0:12:05.68,0:12:06.76,Default,,0,0,0,,〈Қазір...〉
Dialogue: 0,0:12:07.22,0:12:08.72,Default,,0,0,0,,<Түсінікті>
Dialogue: 0,0:12:08.85,0:12:11.39,Default,,0,0,0,,<Төраға талап етсе, амал жоқ>
Dialogue: 0,0:12:12.35,0:12:14.69,Default,,0,0,0,,〈Бірақ оны шешудің басқа жолы бар ма?〉
Dialogue: 0,0:12:14.81,0:12:15.65,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:16.02,0:12:16.98,Default,,0,0,0,,Не?
Dialogue: 0,0:12:17.27,0:12:18.11,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:12:18.23,0:12:19.90,Default,,0,0,0,,Маңызды емес деп айтыңыз.
Dialogue: 0,0:12:20.73,0:12:23.36,Default,,0,0,0,,Егер сіз компанияны қаласаңыз, оны қолайлы бағаға сатып алыңыз.
Dialogue: 0,0:12:23.49,0:12:24.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:24.99,0:12:27.41,Default,,0,0,0,,Паразиттер бос сөз айтады
Dialogue: 0,0:12:27.87,0:12:29.29,Default,,0,0,0,,<Бұл күлкілі! 〉
Dialogue: 0,0:12:29.62,0:12:30.87,Default,,0,0,0,,<Не? 〉
Dialogue: 0,0:12:31.20,0:12:32.50,Default,,0,0,0,,<Акциялар да>
Dialogue: 0,0:12:32.62,0:12:35.96,Default,,0,0,0,,<Ыңғайсыздық үшін 100 миллиард иен әкеліңіз.>
Dialogue: 0,0:12:36.67,0:12:38.38,Default,,0,0,0,,<Мынау қарт, әзіл! 〉
Dialogue: 0,0:12:39.88,0:12:41.96,Default,,0,0,0,,<Мен сізге бірнеше негізгі сұрақтар қоямын>
Dialogue: 0,0:12:42.09,0:12:44.84,Default,,0,0,0,,〈Мұндай үлкен ақшаны қалай алып жүруім керек? 〉
Dialogue: 0,0:12:45.84,0:12:48.80,Default,,0,0,0,,Маған ақша берсең, мен саған бас иемін.
Dialogue: 0,0:12:50.97,0:12:52.10,Default,,0,0,0,,Қанша?
Dialogue: 0,0:12:53.23,0:12:56.10,Default,,0,0,0,,Әлгі бақытты жігіт, 100 миллиардтың несі бар!
Dialogue: 0,0:12:56.35,0:12:57.98,Default,,0,0,0,,Сома маңызды емес
Dialogue: 0,0:12:58.11,0:12:59.02,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:12:59.15,0:13:01.73,Default,,0,0,0,,Олар жай ғана айтқысы келетінін айтады.
Dialogue: 0,0:13:02.07,0:13:05.53,Default,,0,0,0,,Төрағаға бұдан әрі құрметсіздікке жол берілмейді.
Dialogue: 0,0:13:06.07,0:13:08.62,Default,,0,0,0,,Тоқтап, қайта бастайық.
Dialogue: 0,0:13:10.24,0:13:11.54,Default,,0,0,0,,〈100 миллиард иен...〉
Dialogue: 0,0:13:12.16,0:13:14.79,Default,,0,0,0,,<Алдын ала төлеу тым көп.>
Dialogue: 0,0:13:14.91,0:13:19.00,Default,,0,0,0,,〈Ал, бастапқы нұсқада ол шамамен 6 миллиард болады.〉
Dialogue: 0,0:13:19.67,0:13:21.17,Default,,0,0,0,,<Аудармашының пікірі қандай? 〉
Dialogue: 0,0:13:22.92,0:13:24.13,Default,,0,0,0,,〈Шынымды айтсам? 〉
Dialogue: 0,0:13:24.34,0:13:25.17,Default,,0,0,0,,<Маған бәрібір>
Dialogue: 0,0:13:25.30,0:13:27.68,Default,,0,0,0,,〈Мүмкін мен мұны мүмкіндік ретінде қарастыруым керек.〉
Dialogue: 0,0:13:28.34,0:13:29.18,Default,,0,0,0,,〈Хо〉
Dialogue: 0,0:13:29.43,0:13:33.27,Default,,0,0,0,,〈Мәселе ақшада емес, Созакумен қарым-қатынаста〉
Dialogue: 0,0:13:33.39,0:13:34.60,Default,,0,0,0,,<Олар Азияда>
Dialogue: 0,0:13:34.73,0:13:36.73,Default,,0,0,0,,<Олар біз туралы өсек таратып жатқан көрінеді>
Dialogue: 0,0:13:36.85,0:13:37.69,Default,,0,0,0,,<Не? 〉
Dialogue: 0,0:13:38.27,0:13:40.36,Default,,0,0,0,,〈Шанхай Лонфу Ван〉
Dialogue: 0,0:13:40.48,0:13:43.61,Default,,0,0,0,,(Сұзакудың үй жануары)
Dialogue: 0,0:13:44.36,0:13:45.19,Default,,0,0,0,,Төлейік
Dialogue: 0,0:13:45.57,0:13:46.49,Default,,0,0,0,,Эдамура!
Dialogue: 0,0:13:46.90,0:13:49.37,Default,,0,0,0,,Енді Люді сүйреп шығарудың жалғыз мүмкіндігі.
Dialogue: 0,0:13:49.49,0:13:50.37,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:13:50.49,0:13:52.03,Default,,0,0,0,,Маңыздысы – төраға айтқандай.
Dialogue: 0,0:13:52.16,0:13:53.83,Default,,0,0,0,,Бұл ақша емес, мақтаныш!
Dialogue: 0,0:13:53.95,0:13:56.33,Default,,0,0,0,,Сондай бақытты құлақ бар ма?
Dialogue: 0,0:13:56.46,0:13:58.00,Default,,0,0,0,,Бұл сөзсіз пластикалық хирургия!
Dialogue: 0,0:13:59.33,0:14:01.67,Default,,0,0,0,,Ең бастысы, менің шыдай алмайтыным
Dialogue: 0,0:14:02.17,0:14:05.42,Default,,0,0,0,,Төраға Созақуды сыйламау.
Dialogue: 0,0:14:08.38,0:14:12.97,Default,,0,0,0,,Күні тек сен, мен және ең аз бағынушылар кездеседі.
Dialogue: 0,0:14:13.10,0:14:15.14,Default,,0,0,0,,Қажетсіз адамдарды әкелмеңіз
Dialogue: 0,0:14:15.39,0:14:17.27,Default,,0,0,0,,Күні кейінірек жарияланады
Dialogue: 0,0:14:17.64,0:14:20.02,Default,,0,0,0,,Мен саған қалағаныңды аламын.
Dialogue: 0,0:14:20.15,0:14:23.02,Default,,0,0,0,,Ендеше кел, басыңды иіп, Лю.
Dialogue: 0,0:14:23.86,0:14:26.53,Default,,0,0,0,,〈Оқиғаны түсінетін адам болғаныңыз үшін рахмет〉
Dialogue: 0,0:14:26.65,0:14:28.57,Default,,0,0,0,,(Кейін кездескенше)
Dialogue: 0,0:14:29.15,0:14:32.66,Default,,0,0,0,,〈Аа...100 миллиард құнды қағаздар〉
Dialogue: 0,0:14:32.83,0:14:35.45,Default,,0,0,0,,<Бұл жай ғана жалған емес пе? 〉
Dialogue: 0,0:14:35.58,0:14:37.04,Default,,0,0,0,,<Егер сіз жалған дайындасаңыз>
Dialogue: 0,0:14:37.58,0:14:39.75,Default,,0,0,0,,<Олар білсе, не болады деп ойлайсың? 〉
Dialogue: 0,0:14:39.87,0:14:41.71,Default,,0,0,0,,<Міне, бұл>
Dialogue: 0,0:14:41.83,0:14:43.00,Default,,0,0,0,,<Қаржылық себептер бойынша>
Dialogue: 0,0:14:43.13,0:14:45.25,Default,,0,0,0,,<Сол кәрі қаңбақты өлтірудің жолын ойла.>
Dialogue: 0,0:14:45.63,0:14:48.38,Default,,0,0,0,,〈Менің бірдеңе ішкім келеді.〉
Dialogue: 0,0:14:48.51,0:14:50.47,Default,,0,0,0,,〈Біз тойлаймыз ба?〉
Dialogue: 0,0:14:50.97,0:14:53.05,Default,,0,0,0,,Ишигами 100 миллиард дайындаңыз
Dialogue: 0,0:14:53.18,0:14:56.64,Default,,0,0,0,,Бірақ... Бірақ бұл чек болса, оның абыройын түсіруге болады.
Dialogue: 0,0:14:56.77,0:14:58.77,Default,,0,0,0,,Олар осылай істейді
Dialogue: 0,0:14:58.89,0:15:01.27,Default,,0,0,0,,Бұл Созаку Әкемінің айласы жоқ.
Dialogue: 0,0:15:01.40,0:15:02.52,Default,,0,0,0,,Өз еркіңмен осыған секіріп келгенің қандай ақымақтық!
Dialogue: 0,0:15:02.69,0:15:05.27,Default,,0,0,0,,Ал егер біз оларды қуып жіберсек
Dialogue: 0,0:15:05.40,0:15:08.11,Default,,0,0,0,,Азияда бизнес жүргізу оңайырақ болады
Dialogue: 0,0:15:08.61,0:15:09.45,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:15:09.65,0:15:11.53,Default,,0,0,0,,Ха, дұрыс айтасың!
Dialogue: 0,0:15:11.66,0:15:13.91,Default,,0,0,0,,Аа, төраға?
Dialogue: 0,0:15:14.03,0:15:16.04,Default,,0,0,0,,Маған түнде біраз уақыт беріңізші.
Dialogue: 0,0:15:16.16,0:15:17.79,Default,,0,0,0,,Мен сізге не көрсеткім келеді
Dialogue: 0,0:15:17.91,0:15:18.95,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:21.42,0:15:24.38,Default,,0,0,0,,Сондықтан мен кеңсеге бір рет қайтайын.
Dialogue: 0,0:15:24.54,0:15:25.42,Default,,0,0,0,,Иә
Dialogue: 0,0:15:27.84,0:15:30.84,Default,,0,0,0,,(лифттің көтерілу дыбысы)
Dialogue: 0,0:15:30.97,0:15:32.18,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:15:36.76,0:15:38.89,Default,,0,0,0,,Ой, кенет қайта бояйсың ба?
Dialogue: 0,0:15:39.02,0:15:39.85,Default,,0,0,0,,Иә
Dialogue: 0,0:15:40.23,0:15:41.98,Default,,0,0,0,,Президент кеңсесіне де солай.
Dialogue: 0,0:15:42.27,0:15:45.11,Default,,0,0,0,,Мен Фукумиге алданып қалмас үшін көңіл-күйімді көтеремін.
Dialogue: 0,0:15:45.23,0:15:46.73,Default,,0,0,0,,Бұл керемет идея.
Dialogue: 0,0:15:47.19,0:15:49.94,Default,,0,0,0,,Айтпақшы, не әкелдің?
Dialogue: 0,0:15:50.07,0:15:52.36,Default,,0,0,0,,Төрағаға ұсыну
Dialogue: 0,0:15:53.20,0:15:55.24,Default,,0,0,0,,Жүр, жақында.
Dialogue: 0,0:15:55.82,0:15:56.91,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:57.62,0:15:59.45,Default,,0,0,0,,(Зенitsu) Сеніңнен басқа ешкімім жоқ~! (Танжиро) Иә… иә
Dialogue: 0,0:16:01.29,0:16:02.29,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:16:02.41,0:16:05.63,Default,,0,0,0,,Бұл әлсіз реакция.
Dialogue: 0,0:16:05.88,0:16:08.30,Default,,0,0,0,,Мына орындық ғажап емес пе?
Dialogue: 0,0:16:08.42,0:16:09.38,Default,,0,0,0,,Бөлек
Dialogue: 0,0:16:09.51,0:16:12.30,Default,,0,0,0,,Енді оң жақтағы қолтық тірекке қараңыз.
Dialogue: 0,0:16:12.42,0:16:15.01,Default,,0,0,0,,Ол әдетте өшіру қосқышы ретінде белгілі...
Dialogue: 0,0:16:15.68,0:16:16.51,Default,,0,0,0,,(қосқышты басқан дыбыс)
Dialogue: 0,0:16:19.52,0:16:22.48,Default,,0,0,0,,(қосқышты үздіксіз басу дыбысы)
Dialogue: 0,0:16:22.98,0:16:24.31,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:16:24.98,0:16:28.02,Default,,0,0,0,,Бұл жылдам болды, сондықтан мен уақытында үлгере алмадым.
Dialogue: 0,0:16:28.15,0:16:28.98,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:16:29.73,0:16:32.24,Default,,0,0,0,,Бұл көңілді трюк болса керек.
Dialogue: 0,0:16:32.78,0:16:33.70,Default,,0,0,0,,(Зенitsu) Өтінемін! (Күсари-карасу) Кә~!
Dialogue: 0,0:16:33.99,0:16:36.99,Default,,0,0,0,,Әй, сол жақтағы менің сенімділігім!
Dialogue: 0,0:16:37.12,0:16:39.03,Default,,0,0,0,,Келіңіздер, оны басыңыз.
Dialogue: 0,0:16:50.50,0:16:53.51,Default,,0,0,0,,Оның басының ұшып бара жатқанын көрдіңіз бе?
Dialogue: 0,0:16:53.67,0:16:55.59,Default,,0,0,0,,Мына көздерімен Шикато
Dialogue: 0,0:16:56.01,0:16:58.51,Default,,0,0,0,,Маған ұнады Мен мақтап жіберемін
Dialogue: 0,0:16:58.97,0:17:01.81,Default,,0,0,0,,Мен ризамын және бақыттымын.
Dialogue: 0,0:17:02.43,0:17:05.44,Default,,0,0,0,,Егер сіз допты алсаңыз, сіз шайқаста жеңесіз.
Dialogue: 0,0:17:05.85,0:17:07.73,Default,,0,0,0,,〈Енді маған қолыңды бер.〉
Dialogue: 0,0:17:08.90,0:17:09.73,Default,,0,0,0,,〈Цу…〉
Dialogue: 0,0:17:09.86,0:17:11.44,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:17:12.03,0:17:14.40,Default,,0,0,0,,<Бұл инсулин инъекциясына ұқсайды.>
Dialogue: 0,0:17:15.24,0:17:16.91,Default,,0,0,0,,〈Бүкіл денеге таралатын улану туралы не деуге болады? 〉
Dialogue: 0,0:17:17.24,0:17:20.70,Default,,0,0,0,,〈Ол қартайған, сондықтан ол бір сағатқа шыдамайды.〉
Dialogue: 0,0:17:21.08,0:17:22.87,Default,,0,0,0,,<Сарысу дұрыс дайындалған>
Dialogue: 0,0:17:23.37,0:17:25.75,Default,,0,0,0,,<Сен не айтсаң да, басқа адам тыңдайды>
Dialogue: 0,0:17:25.87,0:17:26.71,Default,,0,0,0,,<Маған ұнады>
Dialogue: 0,0:17:27.37,0:17:29.96,Default,,0,0,0,,Бұл мен күткеннен әлдеқайда оңай болды.
Dialogue: 0,0:17:30.34,0:17:34.21,Default,,0,0,0,,Сіз бұл жерге сіңіп кетем деп ойламаған шығарсыз.
Dialogue: 0,0:17:34.34,0:17:35.97,Default,,0,0,0,,Токиодағы Баа-сан
Dialogue: 0,0:17:36.47,0:17:39.18,Default,,0,0,0,,〈Аа, сіз қазіргі ағылшын тілін түсіндіңіз бе? 〉
Dialogue: 0,0:17:39.34,0:17:41.51,Default,,0,0,0,,〈Тек «Токиодағы Баа-сан»〉
Dialogue: 0,0:17:42.77,0:17:47.85,Default,,0,0,0,,Шанхайды сіңірген соң, менеджментті сізге тапсырамын деп ойлаймын.
Dialogue: 0,0:17:47.98,0:17:49.52,Default,,0,0,0,,Тағы да солай ма?
Dialogue: 0,0:17:49.69,0:17:52.19,Default,,0,0,0,,Қайта-қайта айтамын.
Dialogue: 0,0:17:52.32,0:17:55.94,Default,,0,0,0,,Сіз келгеннен бері төраға өзгерді, шынымен.
Dialogue: 0,0:17:56.45,0:18:00.87,Default,,0,0,0,,Оның көрінісі жұмсақ әрі сүйкімді болады~
Dialogue: 0,0:18:00.99,0:18:01.83,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:18:02.12,0:18:03.62,Default,,0,0,0,,(Ишигами ықыласы)
Dialogue: 0,0:18:03.74,0:18:04.95,Default,,0,0,0,,Төраға
Dialogue: 0,0:18:05.08,0:18:07.92,Default,,0,0,0,,Ол бастапқыда қарапайым адам болған.
Dialogue: 0,0:18:08.17,0:18:11.29,Default,,0,0,0,,Әкем маған қарай бастады, мен оның екінші әйелі болдым.
Dialogue: 0,0:18:11.50,0:18:15.59,Default,,0,0,0,,Қария дүниеден өткен соң, бір жіңішке қолымен ұйымды біріктірді.
Dialogue: 0,0:18:16.09,0:18:19.18,Default,,0,0,0,,Осыдан кейін Дора ұлы мені тастап кетті.
Dialogue: 0,0:18:19.30,0:18:22.05,Default,,0,0,0,,Мен жалғыз өзім көп жұмыс жасадым.
Dialogue: 0,0:18:23.22,0:18:26.73,Default,,0,0,0,,Бұл өте жалғыз болған болуы керек.
Dialogue: 0,0:18:27.18,0:18:28.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:28.27,0:18:29.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:29.56,0:18:30.77,Default,,0,0,0,,Міне, солай~
Dialogue: 0,0:18:30.90,0:18:32.73,Default,,0,0,0,,Сол галстук!
Dialogue: 0,0:18:33.36,0:18:37.24,Default,,0,0,0,,Бұл фильмде Дора Сонның жасаған әрекеті.
Dialogue: 0,0:18:38.28,0:18:39.61,Default,,0,0,0,,Ыстық бұлақтар ше?
Dialogue: 0,0:18:41.07,0:18:42.24,Default,,0,0,0,,Бәрінен бұрын
Dialogue: 0,0:18:43.41,0:18:45.58,Default,,0,0,0,,Аа, Токиода кездескенше.
Dialogue: 0,0:18:49.37,0:18:50.42,Default,,0,0,0,,Хаа…
Dialogue: 0,0:18:54.21,0:18:55.96,Default,,0,0,0,,Сіздің кезегіңіз келді!
Dialogue: 0,0:18:56.34,0:18:57.63,Default,,0,0,0,,Байқап көріңіз!
Dialogue: 0,0:18:57.76,0:18:59.01,Default,,0,0,0,,Байқап көріңіз!
Dialogue: 0,0:18:59.55,0:19:03.47,Default,,0,0,0,,Дегенмен, Оздің салған суреттері өте батыл.
Dialogue: 0,0:19:03.60,0:19:07.06,Default,,0,0,0,,Олар екі ұйымды біріктіруге тырысуда.
Dialogue: 0,0:19:07.47,0:19:10.64,Default,,0,0,0,,Бала данышпан болса, ата-ана құдай.
Dialogue: 0,0:19:11.44,0:19:15.02,Default,,0,0,0,,Хаа... ата-ана да, бала да қарапайым адамдар.
Dialogue: 0,0:19:19.19,0:19:21.61,Default,,0,0,0,,Пуха~ Хахаха... Қолымнан келмейді!
Dialogue: 0,0:19:21.99,0:19:25.70,Default,,0,0,0,,Ах~ Жапониядағы ыстық бұлақтар бүгін түнде ғана қолжетімді.
Dialogue: 0,0:19:26.95,0:19:29.33,Default,,0,0,0,,Қайта ащы көріндің.
Dialogue: 0,0:19:29.45,0:19:31.46,Default,,0,0,0,,Эдамаме жақсы жұмыс істейді.
Dialogue: 0,0:19:31.79,0:19:35.67,Default,,0,0,0,,Ол бәрі ойлағаннан да сезімтал.
Dialogue: 0,0:19:36.84,0:19:37.67,Default,,0,0,0,,Мазасыз
Dialogue: 0,0:19:38.42,0:19:40.13,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:40.47,0:19:43.68,Default,,0,0,0,,Біріншіден, мен оған мүлде сенбеймін.
Dialogue: 0,0:19:44.85,0:19:46.85,Default,,0,0,0,,Егер сіз ұзақ уақыт бойы инфильтрациялансаңыз
Dialogue: 0,0:19:47.14,0:19:49.60,Default,,0,0,0,,Сіз өзіңіздің кім екеніңізді білмейсіз
Dialogue: 0,0:19:50.64,0:19:55.02,Default,,0,0,0,,Адам қаншалықты қорқынышты болса да, оның жанында болсаң, оған жанашырлық танытасың.
Dialogue: 0,0:19:56.27,0:19:57.57,Default,,0,0,0,,Бізге де қауіп төнді.
Dialogue: 0,0:19:58.44,0:20:00.32,Default,,0,0,0,,Ол бала да өсіп келеді.
Dialogue: 0,0:20:04.49,0:20:05.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:05.82,0:20:08.08,Default,,0,0,0,,Ол үмітсіз ақымақ.
Dialogue: 0,0:20:08.49,0:20:12.16,Default,,0,0,0,,Менің ыңғайлылығымды елемей, өз бетіңізше әрекет етіңіз.
Dialogue: 0,0:20:13.17,0:20:15.04,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:20:15.21,0:20:17.46,Default,,0,0,0,,(матаның үйкелу дыбысы)
Dialogue: 0,0:20:31.73,0:20:33.35,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:20:39.86,0:20:41.19,Default,,0,0,0,,Хаа…
Dialogue: 0,0:20:41.69,0:20:43.32,Default,,0,0,0,,Ертең осында.
Dialogue: 0,0:20:43.82,0:20:45.24,Default,,0,0,0,,Сонымен, бұл зат шынымен «Меро-Меро Ган» деп атала ма?
Dialogue: 0,0:20:45.66,0:20:46.70,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:48.62,0:20:49.53,Default,,0,0,0,,О
Dialogue: 0,0:20:50.99,0:20:57.00,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.82,0:22:50.82,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.32,0:22:58.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory