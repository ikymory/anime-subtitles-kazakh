Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.75,0:00:03.87,Default,,0,0,0,,«Бала айтады»
Dialogue: 0,0:00:04.54,0:00:07.63,Default,,0,0,0,,«Мен өз жасымда оқуға ұмтыламын».
Dialogue: 0,0:00:08.38,0:00:09.50,Default,,0,0,0,,«Цзу Юэ»
Dialogue: 0,0:00:09.63,0:00:11.01,Default,,0,0,0,,«Цзу Юэ»
Dialogue: 0,0:00:11.26,0:00:12.80,Default,,0,0,0,,«Оши сен»
Dialogue: 0,0:00:13.26,0:00:15.84,Default,,0,0,0,,Вуши Му Му!
Dialogue: 0,0:00:15.97,0:00:18.01,Default,,0,0,0,,Ашық! (Мики) Мұны шындап істе!
Dialogue: 0,0:00:18.14,0:00:19.22,Default,,0,0,0,,Буу!
Dialogue: 0,0:00:19.93,0:00:23.56,Default,,0,0,0,,Хаха... Сондықтан қытайша сөйлей алмаймын.
Dialogue: 0,0:00:23.69,0:00:28.61,Default,,0,0,0,,Қазірдің өзінде! Ондай сөздерді айтатындарды ешкім қолдамайды.
Dialogue: 0,0:00:28.86,0:00:29.77,Default,,0,0,0,,А, қайтып келе жатырсың ба?
Dialogue: 0,0:00:30.44,0:00:33.74,Default,,0,0,0,,Уууу, мен сені Жапонияда тағы жұмыс істейтініңді естідім.
Dialogue: 0,0:00:34.53,0:00:36.32,Default,,0,0,0,,Кейде барып көргің келе ме?
Dialogue: 0,0:00:36.45,0:00:39.74,Default,,0,0,0,,Ех! Бұл жақсы~
Dialogue: 0,0:00:41.54,0:00:42.75,Default,,0,0,0,,Ол ешқашан
Dialogue: 0,0:00:43.46,0:00:47.00,Default,,0,0,0,,Қылмыс жеке пайда үшін жасалмаған.
Dialogue: 0,0:00:47.83,0:00:50.50,Default,,0,0,0,,Жеңілдететін жағдайларға көп орын бар.
Dialogue: 0,0:00:50.96,0:00:53.13,Default,,0,0,0,,Маған жеңіл жаза беріңізші.
Dialogue: 0,0:00:53.26,0:00:54.51,Default,,0,0,0,,Хаа…
Dialogue: 0,0:00:55.93,0:00:56.76,Default,,0,0,0,,Егер Масато
Dialogue: 0,0:00:57.22,0:00:59.26,Default,,0,0,0,,Бұл әрқашан бірдей нәрсе
Dialogue: 0,0:00:59.60,0:01:01.18,Default,,0,0,0,,Қараңдаршы, мен не дедім.
Dialogue: 0,0:01:01.31,0:01:02.27,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:01:02.39,0:01:05.89,Default,,0,0,0,,Жұмыс істейтін әке өте керемет! Айтайын дегенім?
Dialogue: 0,0:01:06.02,0:01:07.40,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:07.52,0:01:09.90,Default,,0,0,0,,Барлық жұмысты орындамаңыз
Dialogue: 0,0:01:10.11,0:01:12.19,Default,,0,0,0,,Анда-санда қайтып кел!
Dialogue: 0,0:01:12.32,0:01:13.53,Default,,0,0,0,,Уф! (Масато) А...
Dialogue: 0,0:01:13.65,0:01:15.36,Default,,0,0,0,,Осыны айтқыңыз келеді ме?
Dialogue: 0,0:01:15.49,0:01:17.57,Default,,0,0,0,,Уууу, мен жай ғана ренжідім.
Dialogue: 0,0:01:17.70,0:01:18.87,Default,,0,0,0,,Папаға еліктеу!
Dialogue: 0,0:01:19.16,0:01:21.28,Default,,0,0,0,,«Әрқашан дұрыс бол»
Dialogue: 0,0:01:21.41,0:01:23.58,Default,,0,0,0,,«Әлемге пайдалы болу»
Dialogue: 0,0:01:23.79,0:01:26.54,Default,,0,0,0,,«Өзгелер сыйлайтын адам бол»
Dialogue: 0,0:01:27.37,0:01:29.54,Default,,0,0,0,,Сіз әкеңіз сияқты заңгер бола аламын деп ойлайсыз ба?
Dialogue: 0,0:01:29.79,0:01:31.50,Default,,0,0,0,,Мен оқуды ұнатпаймын
Dialogue: 0,0:01:31.80,0:01:35.63,Default,,0,0,0,,Оқудан да маңыздысы – адамгершілік.
Dialogue: 0,0:01:35.76,0:01:37.38,Default,,0,0,0,,Мен де мұны естуден шаршадым.
Dialogue: 0,0:01:37.76,0:01:40.39,Default,,0,0,0,,Уау, әдеттегідей.
Dialogue: 0,0:01:45.10,0:01:47.52,Default,,0,0,0,,Бұл жолы кәмелетке толмағандарды саудалау...
Dialogue: 0,0:01:47.64,0:01:48.73,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:01:48.85,0:01:50.61,Default,,0,0,0,,А, алдағы үш жақты сұхбат бар...
Dialogue: 0,0:01:50.73,0:01:52.40,Default,,0,0,0,,Созаку федерациясының мүшелері
Dialogue: 0,0:01:52.65,0:01:53.90,Default,,0,0,0,,Цюнео Тадзима
Dialogue: 0,0:01:54.32,0:01:56.78,Default,,0,0,0,,Мүше Джуня Ишии
Dialogue: 0,0:01:57.07,0:01:59.74,Default,,0,0,0,,Және заңгер Сейджи Озаки
Dialogue: 0,0:02:00.16,0:02:03.45,Default,,0,0,0,,Елде заңсыз жүрген үш кәмелетке толмағандарды алдап кеткен.
Dialogue: 0,0:02:03.62,0:02:05.16,Default,,0,0,0,,Елден тыс адам саудасы —
Dialogue: 0,0:02:05.33,0:02:07.04,Default,,0,0,0,,Күдікті
Dialogue: 0,0:02:07.16,0:02:10.79,Default,,0,0,0,,Негізгі күдікті Озаки өзінің адвокаттық қызметін пайдаланды
Dialogue: 0,0:02:10.92,0:02:13.67,Default,,0,0,0,,Андеррайтер қызметін атқарған дейді.
Dialogue: 0,0:02:13.80,0:02:15.59,Default,,0,0,0,,Ах... (құлап түскен дыбыс)
Dialogue: 0,0:02:16.42,0:02:22.43,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:14.86,0:03:20.86,Default,,0,0,0,,~♪
Dialogue: 0,0:03:25.62,0:03:26.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:32.08,0:03:33.63,Default,,0,0,0,,Жұмысыңызға үйрендіңіз бе?
Dialogue: 0,0:03:34.21,0:03:36.63,Default,,0,0,0,,Аа, президент «жарайды».
Dialogue: 0,0:03:37.25,0:03:38.55,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:03:38.80,0:03:40.72,Default,,0,0,0,,Ой, бұл жолы қандай сериал?
Dialogue: 0,0:03:41.05,0:03:43.59,Default,,0,0,0,,Мен бақытты періштемді болжауға мүмкіндік беремін деп ойладым.
Dialogue: 0,0:03:44.18,0:03:45.72,Default,,0,0,0,,Бұл періште ме?
Dialogue: 0,0:03:46.35,0:03:49.97,Default,,0,0,0,,Ум, бұл сиқыршы ма?
Dialogue: 0,0:03:50.48,0:03:51.68,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:03:52.23,0:03:54.65,Default,,0,0,0,,Өкінішті, жеңілген сияқты.
Dialogue: 0,0:03:54.77,0:03:55.61,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:03:56.48,0:03:57.69,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:03:58.02,0:04:00.36,Default,,0,0,0,,Ауруыңызды сиқырмен емдеңіз
Dialogue: 0,0:04:00.82,0:04:04.11,Default,,0,0,0,,Сондай-ақ, әкеңіздің түсініспеушілігін жоюға рұқсат етіңіз.
Dialogue: 0,0:04:05.70,0:04:07.41,Default,,0,0,0,,Тек оны қабылдаңыз.
Dialogue: 0,0:04:07.95,0:04:10.08,Default,,0,0,0,,Ол ең нашар қылмыскер.
Dialogue: 0,0:04:11.91,0:04:13.50,Default,,0,0,0,,Бірақ... сонда!
Dialogue: 0,0:04:13.75,0:04:15.38,Default,,0,0,0,,Неге маған қонаққа келмедің?
Dialogue: 0,0:04:15.50,0:04:17.71,Default,,0,0,0,,Ол жазасын бітіріп, босатылуы керек еді!
Dialogue: 0,0:04:21.71,0:04:23.13,Default,,0,0,0,,Ол қашып кетті.
Dialogue: 0,0:04:24.34,0:04:25.72,Default,,0,0,0,,Оны қазірдің өзінде ұмытыңыз
Dialogue: 0,0:04:29.01,0:04:31.85,Default,,0,0,0,,Сіз адамгершіліктен де маңызды не екенін білесіз бе?
Dialogue: 0,0:04:31.98,0:04:32.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:33.31,0:04:35.81,Default,,0,0,0,,Бұл кешірімді жүрек
Dialogue: 0,0:04:36.65,0:04:38.82,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:04:39.61,0:04:41.40,Default,,0,0,0,,Бұл қазір жақсы, солай ма?
Dialogue: 0,0:04:45.32,0:04:49.33,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:04:58.92,0:05:00.17,Default,,0,0,0,,Мен неге бақыттымын?
Dialogue: 0,0:05:02.26,0:05:03.21,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:20.61,0:05:21.52,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:05:24.94,0:05:27.95,Default,,0,0,0,,Қараңызшы, бұл сіз қалаған бекон мен жұмыртқа бургері.
Dialogue: 0,0:05:29.78,0:05:31.53,Default,,0,0,0,,Бұл жерде қанша уақыт болуды жоспарлайсыз?
Dialogue: 0,0:05:32.41,0:05:34.37,Default,,0,0,0,,Барлығы құтқарылғанға дейін
Dialogue: 0,0:05:35.04,0:05:36.33,Default,,0,0,0,,Ол қабылданбады.
Dialogue: 0,0:05:36.71,0:05:38.50,Default,,0,0,0,,Біреуді күштеп алып шығу
Dialogue: 0,0:05:39.17,0:05:42.34,Default,,0,0,0,,Дегенмен, дайындалуға біраз уақыт керек сияқты.
Dialogue: 0,0:05:43.30,0:05:44.46,Default,,0,0,0,,Шындығында, 2-сыныпты үш тәжірибеші мен бір 1-сыныпты тәжірибеші қызмет барысында қаза тапты.
Dialogue: 0,0:05:44.67,0:05:45.51,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:45.80,0:05:46.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:47.26,0:05:48.59,Default,,0,0,0,,Мен мұнда араласа аламын.
Dialogue: 0,0:05:48.72,0:05:49.55,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:05:50.97,0:05:51.80,Default,,0,0,0,,Хаа~
Dialogue: 0,0:05:52.60,0:05:53.77,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:05:53.89,0:05:56.06,Default,,0,0,0,,А... бұл не?
Dialogue: 0,0:05:56.81,0:05:58.85,Default,,0,0,0,,Мен мұнда сүңгіп жүргеніме көп уақыт болды.
Dialogue: 0,0:05:58.98,0:06:02.07,Default,,0,0,0,,Ахаха, уайымдама.
Dialogue: 0,0:06:02.61,0:06:05.23,Default,,0,0,0,,Мен якудза болғым келмейді.
Dialogue: 0,0:06:05.86,0:06:06.78,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:06:07.57,0:06:09.86,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:10.24,0:06:11.20,Default,,0,0,0,,(құлыптау дыбысы)
Dialogue: 0,0:06:15.20,0:06:18.21,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:06:21.38,0:06:22.21,Default,,0,0,0,,Иә
Dialogue: 0,0:06:23.96,0:06:25.80,Default,,0,0,0,,Ах... Қайырлы таң.
Dialogue: 0,0:06:27.76,0:06:28.59,Default,,0,0,0,,Не!
Dialogue: 0,0:06:29.47,0:06:32.01,Default,,0,0,0,,Төраға мені...?
Dialogue: 0,0:06:32.35,0:06:35.60,Default,,0,0,0,,Хмф, сен мені қатты ұнатасың.
Dialogue: 0,0:06:36.06,0:06:36.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:37.23,0:06:38.60,Default,,0,0,0,,Ойы ұшқыр
Dialogue: 0,0:06:38.73,0:06:42.06,Default,,0,0,0,,Қорқақ көрінгенімен, батылдығы күшті.
Dialogue: 0,0:06:42.81,0:06:46.15,Default,,0,0,0,,Меніңше, оған түрмеде қызмет еткені ұнады.
Dialogue: 0,0:06:46.86,0:06:48.32,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:06:48.82,0:06:50.07,Default,,0,0,0,,Мүмкін Яганың серіктесі
Dialogue: 0,0:06:50.20,0:06:51.07,Default,,0,0,0,,Эх!
Dialogue: 0,0:06:52.12,0:06:54.49,Default,,0,0,0,,Жай қалжың, tsk.
Dialogue: 0,0:06:56.20,0:06:58.33,Default,,0,0,0,,Қытай тілінде сөйлей алатыныңызды естідім.
Dialogue: 0,0:06:58.62,0:07:01.08,Default,,0,0,0,,А... иә, аздап.
Dialogue: 0,0:07:01.46,0:07:04.13,Default,,0,0,0,,Гонконгтағы сатып алу да тамаша болды, солай емес пе?
Dialogue: 0,0:07:04.42,0:07:06.67,Default,,0,0,0,,Мен ағылшын тілін түсіндім.
Dialogue: 0,0:07:07.34,0:07:10.38,Default,,0,0,0,,Дегенмен, мен оны қытай тілінен үйрендім, сондықтан біраз оғаш болуы мүмкін.
Dialogue: 0,0:07:11.18,0:07:12.43,Default,,0,0,0,,Аудармашы жалдаңыз
Dialogue: 0,0:07:12.55,0:07:13.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:13.80,0:07:14.93,Default,,0,0,0,,Аудармашы?
Dialogue: 0,0:07:15.60,0:07:17.35,Default,,0,0,0,,Шанхай жігіттері келе жатыр.
Dialogue: 0,0:07:17.47,0:07:18.39,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:07:19.98,0:07:21.89,Default,,0,0,0,,Бұл Шанхай Лонгфу Ван.
Dialogue: 0,0:07:25.11,0:07:26.69,Default,,0,0,0,,Шанхай айдаһары мен жолбарыс сарайы?
Dialogue: 0,0:07:27.28,0:07:28.78,Default,,0,0,0,,Бұл қытай мафиясы.
Dialogue: 0,0:07:30.90,0:07:35.16,Default,,0,0,0,,Ол жігіттер бастапқыда Қытайда біз құрған бағынышты ұйым болатын.
Dialogue: 0,0:07:35.70,0:07:37.37,Default,,0,0,0,,Жоқ, бәрібір солай болуы керек.
Dialogue: 0,0:07:39.37,0:07:41.21,Default,,0,0,0,,Шанхайда қаскөйлер тобын пайдалану
Dialogue: 0,0:07:41.87,0:07:45.92,Default,,0,0,0,,Shanghai Trading деп аталатын жалған сауда компаниясы құрылды.
Dialogue: 0,0:07:47.00,0:07:50.05,Default,,0,0,0,,Ауылдың ескі жолын ғана білетіндерге
Dialogue: 0,0:07:50.30,0:07:53.55,Default,,0,0,0,,Маған нөлден бастап күресудің жаңа әдісін үйретіңіз.
Dialogue: 0,0:07:54.76,0:07:57.35,Default,,0,0,0,,Оны Қытай экономикасы басқарды.
Dialogue: 0,0:07:57.60,0:08:00.39,Default,,0,0,0,,Ол ақыры біздің сатылымдарымыздан асып түсті.
Dialogue: 0,0:08:01.14,0:08:05.23,Default,,0,0,0,,Содан кейін олар Shanghai Trading-ті өз бетінше тізімге алды.
Dialogue: 0,0:08:05.56,0:08:08.19,Default,,0,0,0,,Бізді елемей, тәуелсіз болдың.
Dialogue: 0,0:08:08.86,0:08:12.74,Default,,0,0,0,,Босс Лю қазір Шанхай бизнес әлеміндегі атақты адам.
Dialogue: 0,0:08:14.86,0:08:16.82,Default,,0,0,0,,Төраға қызық емес.
Dialogue: 0,0:08:17.03,0:08:19.33,Default,,0,0,0,,Бұл жанасу нүктесінің жағдайы
Dialogue: 0,0:08:21.12,0:08:24.75,Default,,0,0,0,,Біз өткен жылы ресейлік қару сатушылармен де байланыса бастадық.
Dialogue: 0,0:08:25.63,0:08:29.21,Default,,0,0,0,,Шынымды айтсам, біз соғысқа бір қадам қалдық.
Dialogue: 0,0:08:29.63,0:08:32.63,Default,,0,0,0,,Сонымен, сіз кешірім сұрауға келдіңіз бе?
Dialogue: 0,0:08:33.93,0:08:35.76,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:35.93,0:08:38.72,Default,,0,0,0,,Менің ойымша, бұл заң жобасына толық сәйкес келмейді.
Dialogue: 0,0:08:39.51,0:08:41.60,Default,,0,0,0,,Цк, сіз қалжыңдап тұрған жоқсыз.
Dialogue: 0,0:08:41.89,0:08:43.31,Default,,0,0,0,,Лю осында емес пе?
Dialogue: 0,0:08:43.43,0:08:44.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.56,0:08:46.81,Default,,0,0,0,,Менің оң қолым Чен ғана қиындыққа тап болды.
Dialogue: 0,0:08:47.31,0:08:49.61,Default,,0,0,0,,<Сәлеметсіз бе, Исигами мырза>
Dialogue: 0,0:08:49.73,0:08:50.69,Default,,0,0,0,,<Сәлеметсіз бе>
Dialogue: 0,0:08:50.82,0:08:52.90,Default,,0,0,0,,〈Бізге қош келдіңіз〉
Dialogue: 0,0:08:53.11,0:08:55.11,Default,,0,0,0,,<Сәлем... өтінемін>
Dialogue: 0,0:08:55.91,0:08:59.08,Default,,0,0,0,,Бұл сувенирлік цивет кофе дәні.
Dialogue: 0,0:08:59.74,0:09:02.08,Default,,0,0,0,,Бұл көп емес, бірақ бәрі жақсы.
Dialogue: 0,0:09:02.95,0:09:04.75,Default,,0,0,0,,Назар аударғаныңызға рахмет.
Dialogue: 0,0:09:05.08,0:09:06.29,Default,,0,0,0,,Міне, алыңыз.
Dialogue: 0,0:09:06.79,0:09:08.46,Default,,0,0,0,,Төраға жоғарыда күтіп тұр.
Dialogue: 0,0:09:09.21,0:09:10.13,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:09:10.25,0:09:11.09,Default,,0,0,0,,Әй, ә!
Dialogue: 0,0:09:11.21,0:09:12.42,Default,,0,0,0,,Сіз немен айналысасыз?
Dialogue: 0,0:09:12.55,0:09:14.09,Default,,0,0,0,,А, а... иә.
Dialogue: 0,0:09:14.84,0:09:15.68,Default,,0,0,0,,Гааах!
Dialogue: 0,0:09:16.26,0:09:18.72,Default,,0,0,0,,Міне, мен оны Шанхайдан кәдесый ретінде алдым.
Dialogue: 0,0:09:18.84,0:09:20.89,Default,,0,0,0,,Цивет кофесі
Dialogue: 0,0:09:21.10,0:09:22.22,Default,,0,0,0,,Мен кофе ішпеймін.
Dialogue: 0,0:09:22.85,0:09:26.06,Default,,0,0,0,,<Сіз әдеттегідей қатты боянып жүрсіз, кемпір.>
Dialogue: 0,0:09:26.19,0:09:28.85,Default,,0,0,0,,Көңіл-күйлерің жақсы, бақытты болсаңдар.
Dialogue: 0,0:09:29.36,0:09:32.19,Default,,0,0,0,,Ұлы жапон императрица Акеми
Dialogue: 0,0:09:32.48,0:09:35.86,Default,,0,0,0,,Хмф, бұл әдемі емес, ұры.
Dialogue: 0,0:09:37.45,0:09:39.91,Default,,0,0,0,,Иә? Эдамураны аударыңыз
Dialogue: 0,0:09:40.16,0:09:41.95,Default,,0,0,0,,А, ә~
Dialogue: 0,0:09:42.08,0:09:44.25,Default,,0,0,0,,<Қош келдіңіз>
Dialogue: 0,0:09:44.37,0:09:45.29,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:09:45.66,0:09:50.38,Default,,0,0,0,,Сіз, аудармашы, анау анау ақымақтан да жамансыз.
Dialogue: 0,0:09:50.63,0:09:53.63,Default,,0,0,0,,Сондықтан біз тіпті аудармашы да бердік.
Dialogue: 0,0:09:54.26,0:09:56.59,Default,,0,0,0,,Сонда... неге Лю келмей жатыр?
Dialogue: 0,0:09:56.88,0:10:01.10,Default,,0,0,0,,Кешіріңіз, Лю мырза кенеттен нашарлап кетті.
Dialogue: 0,0:10:01.35,0:10:03.10,Default,,0,0,0,,Мен Люға кел дедім.
Dialogue: 0,0:10:03.89,0:10:05.85,Default,,0,0,0,,Сізге көрінетін перде жоқ.
Dialogue: 0,0:10:05.98,0:10:08.27,Default,,0,0,0,,<Менің бастығым барлық келіссөздерді маған сеніп тапсырды...>
Dialogue: 0,0:10:08.39,0:10:09.31,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:10:10.02,0:10:12.44,Default,,0,0,0,,Қатты дауыс шығарма (Чен) Ух...
Dialogue: 0,0:10:12.86,0:10:17.07,Default,,0,0,0,,Мені Чен деп атама. Саған бұлай айту дұрыс емес деп ойлаймын.
Dialogue: 0,0:10:17.19,0:10:19.70,Default,,0,0,0,,Shanghai Trading – менің компаниям
Dialogue: 0,0:10:20.20,0:10:22.49,Default,,0,0,0,,Шанхайда бизнеспен айналысуды жалғастырсаңыз
Dialogue: 0,0:10:22.62,0:10:25.66,Default,,0,0,0,,Жылдық сатылымның 80% алдын ала төленеді
Dialogue: 0,0:10:25.79,0:10:27.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:29.71,0:10:32.13,Default,,0,0,0,,〈Не ойлап отырсың, қарт қарт! 〉
Dialogue: 0,0:10:32.25,0:10:34.34,Default,,0,0,0,,<Мен сенің көмегіңді алмай-ақ келдім! 〉
Dialogue: 0,0:10:36.09,0:10:39.05,Default,,0,0,0,,Оны осыншама үлкен еткен біз...
Dialogue: 0,0:10:39.55,0:10:41.22,Default,,0,0,0,,Ол бақытты жігіт.
Dialogue: 0,0:10:41.68,0:10:45.47,Default,,0,0,0,,Біздің қолдауымыз болғандықтан ғана табысқа жеттік.
Dialogue: 0,0:10:46.06,0:10:47.52,Default,,0,0,0,,Тыңдаңдар, шанхайлықтар.
Dialogue: 0,0:10:47.89,0:10:49.64,Default,,0,0,0,,Әлемнің түкпір-түкпірінен VIP-лер
Dialogue: 0,0:10:49.77,0:10:54.07,Default,,0,0,0,,Токио Сузаку федерациясының маңдайшасына сеніп, бизнес жасаңыз
Dialogue: 0,0:10:54.65,0:10:59.40,Default,,0,0,0,,Ыңғайлы түсіндірулер арқылы мақтанышыңызды сақтауға тырыспаңыз.
Dialogue: 0,0:11:00.86,0:11:02.74,Default,,0,0,0,,Сіз елден бас тарттыңыз.
Dialogue: 0,0:11:03.20,0:11:05.87,Default,,0,0,0,,<Не айтып тұрғаныңызды түсінбедім>
Dialogue: 0,0:11:10.96,0:11:12.00,Default,,0,0,0,,Хаа~
Dialogue: 0,0:11:12.88,0:11:15.50,Default,,0,0,0,,Енді ол қауіпті бола бастады.
Dialogue: 0,0:11:15.96,0:11:19.55,Default,,0,0,0,,Ха~а Мен қатты толқып тұрмын.
Dialogue: 0,0:11:21.43,0:11:22.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:22.93,0:11:23.97,Default,,0,0,0,,Исигами мырза
Dialogue: 0,0:11:24.30,0:11:25.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:25.35,0:11:29.27,Default,,0,0,0,,Сол жерде аудармашы болып жүрген адам кім?
Dialogue: 0,0:11:29.52,0:11:31.94,Default,,0,0,0,,Аудармашы? Ах...
Dialogue: 0,0:11:32.52,0:11:36.11,Default,,0,0,0,,Ол «Оз» деген лақап атқа ие болды.
Dialogue: 0,0:11:36.40,0:11:37.23,Default,,0,0,0,,Oz…
Dialogue: 0,0:11:37.61,0:11:39.19,Default,,0,0,0,,Бастапқыда жапон
Dialogue: 0,0:11:40.03,0:11:41.45,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:11:41.57,0:11:44.70,Default,,0,0,0,,Ол да заңгер және адам саудасымен айналысқан.
Dialogue: 0,0:11:45.49,0:11:47.70,Default,,0,0,0,,Бірақ ол ұрланған.
Dialogue: 0,0:11:48.33,0:11:50.41,Default,,0,0,0,,Содан соң үнсіз түрмеден шықты.
Dialogue: 0,0:11:50.54,0:11:54.58,Default,,0,0,0,,Оны Шанхайдағы жігіттер аудармашы және заңгер етіп алып кетті.
Dialogue: 0,0:11:56.09,0:11:58.09,Default,,0,0,0,,Сізге не ұнайды?
Dialogue: 0,0:11:58.21,0:11:59.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:59.30,0:12:00.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:00.59,0:12:03.13,Default,,0,0,0,,Жазушы Сіз ұмыттыңыз ба? Ах!
Dialogue: 0,0:12:03.38,0:12:05.39,Default,,0,0,0,,Уф! (Ишигами) Эй!
Dialogue: 0,0:12:08.01,0:12:09.22,Default,,0,0,0,,Шақпақ
Dialogue: 0,0:12:13.19,0:12:14.65,Default,,0,0,0,,Ниппон жоқ Аки
Dialogue: 0,0:12:14.77,0:12:16.90,Default,,0,0,0,,Тотемо Уцукушидесуна
Dialogue: 0,0:12:17.19,0:12:20.82,Default,,0,0,0,,Демо Футарино Кирейсани Канаванаи
Dialogue: 0,0:12:20.94,0:12:23.65,Default,,0,0,0,,Дозо I, Аннайшитекле
Dialogue: 0,0:12:24.07,0:12:26.12,Default,,0,0,0,,Иә~ Әй, бұл тапсырыс.
Dialogue: 0,0:12:26.24,0:12:27.53,Default,,0,0,0,,Жаңа
Dialogue: 0,0:12:27.66,0:12:28.78,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:28.91,0:12:29.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:29.99,0:12:31.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:34.58,0:12:35.62,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:12:35.75,0:12:36.96,Default,,0,0,0,,Ең нашар!
Dialogue: 0,0:12:37.08,0:12:38.29,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:38.42,0:12:39.92,Default,,0,0,0,,Мен оны саған беремін!
Dialogue: 0,0:12:40.05,0:12:41.55,Default,,0,0,0,,О... не?
Dialogue: 0,0:12:41.96,0:12:43.13,Default,,0,0,0,,Бұл Оз туралы!
Dialogue: 0,0:12:43.26,0:12:44.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:44.93,0:12:46.72,Default,,0,0,0,,Мен сені енді ешқашан көргім келмеді
Dialogue: 0,0:12:46.84,0:12:48.01,Default,,0,0,0,,Мұндай жерде!
Dialogue: 0,0:12:48.55,0:12:49.89,Default,,0,0,0,,Шынында да, саған бір нәрсе сұрағым келеді.
Dialogue: 0,0:12:50.43,0:12:52.06,Default,,0,0,0,,Өзіңізді алдамаңыз!
Dialogue: 0,0:12:52.27,0:12:54.06,Default,,0,0,0,,Ол енді менің әкем де емес!
Dialogue: 0,0:12:54.44,0:12:55.85,Default,,0,0,0,,Бейтаныс адам!
Dialogue: 0,0:12:56.81,0:12:59.77,Default,,0,0,0,,Сонда сіз бұлай ренжімес едіңіз, солай ма?
Dialogue: 0,0:13:01.69,0:13:02.53,Default,,0,0,0,,Чи…
Dialogue: 0,0:13:04.20,0:13:05.32,Default,,0,0,0,,Иә
Dialogue: 0,0:13:05.82,0:13:08.20,Default,,0,0,0,,Бүгін түнгі сағат 3-те
Dialogue: 0,0:13:11.74,0:13:12.62,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:13:13.41,0:13:16.33,Default,,0,0,0,,Мұның бәрі бар.
Dialogue: 0,0:13:17.08,0:13:18.54,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:13:19.21,0:13:20.88,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,0:13:21.46,0:13:22.30,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:13:22.88,0:13:24.38,Default,,0,0,0,,Фу~
Dialogue: 0,0:13:24.51,0:13:26.01,Default,,0,0,0,,Мұнда темекі шекпеңіз
Dialogue: 0,0:13:26.72,0:13:29.51,Default,,0,0,0,,А, онда бүгін түнде сағат 3-те.
Dialogue: 0,0:13:31.22,0:13:33.22,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:13:34.39,0:13:37.69,Default,,0,0,0,,«Мені құтқар» деп тұрған жоқсың ба?
Dialogue: 0,0:13:38.10,0:13:39.23,Default,,0,0,0,,Құтқару?
Dialogue: 0,0:13:39.73,0:13:41.40,Default,,0,0,0,,Сенің әкең
Dialogue: 0,0:13:44.57,0:13:46.24,Default,,0,0,0,,Қажеттіліктен ұйымға кіру
Dialogue: 0,0:13:46.36,0:13:48.70,Default,,0,0,0,,Мүмкін осы уақытқа дейін жеткенім шығар.
Dialogue: 0,0:13:50.24,0:13:51.91,Default,,0,0,0,,Бұлай көрінбеді.
Dialogue: 0,0:13:52.58,0:13:54.29,Default,,0,0,0,,Енді сіз ше?
Dialogue: 0,0:13:54.45,0:13:55.29,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:13:55.41,0:13:56.71,Default,,0,0,0,,Бұл ұқсас, солай ма?
Dialogue: 0,0:13:56.83,0:13:59.08,Default,,0,0,0,,Сіз өзіңізді бір жаққа қоясыз ба?
Dialogue: 0,0:14:00.96,0:14:03.75,Default,,0,0,0,,Мұндай жиіркенішті бейбақпен өмір сүрме!
Dialogue: 0,0:14:04.17,0:14:06.30,Default,,0,0,0,,«Ең жаман бейбақ»?
Dialogue: 0,0:14:06.55,0:14:09.01,Default,,0,0,0,,Сонымен, бізбен танысқанға дейін қандай едің?
Dialogue: 0,0:14:09.13,0:14:09.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:11.10,0:14:11.93,Default,,0,0,0,,Тс!
Dialogue: 0,0:14:13.26,0:14:14.31,Default,,0,0,0,,Фу~
Dialogue: 0,0:14:14.43,0:14:17.35,Default,,0,0,0,,Лоран сені неге мұнда жіберді?
Dialogue: 0,0:14:17.73,0:14:19.10,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,0:14:22.77,0:14:25.99,Default,,0,0,0,,Бұл сіздің шешіміңіз. Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:14:27.61,0:14:30.24,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:14:31.32,0:14:34.33,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:14:36.45,0:14:38.87,Default,,0,0,0,,Иә~ Жеке ұшақта ма?
Dialogue: 0,0:14:39.00,0:14:40.54,Default,,0,0,0,,Чен мырза керемет
Dialogue: 0,0:14:40.83,0:14:42.84,Default,,0,0,0,,Мен де Шанхайға бардым
Dialogue: 0,0:14:42.96,0:14:44.67,Default,,0,0,0,,Хахаха жарайды
Dialogue: 0,0:14:44.80,0:14:47.26,Default,,0,0,0,,Мен де бардым
Dialogue: 0,0:14:47.38,0:14:50.38,Default,,0,0,0,,<Жарайды, бәріміз кеттік~>
Dialogue: 0,0:14:50.51,0:14:51.34,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:14:51.72,0:14:53.76,Default,,0,0,0,,Әлі ішіп үлгермеген шығармын~
Dialogue: 0,0:14:53.89,0:14:56.06,Default,,0,0,0,,〈О, алға! 〉
Dialogue: 0,0:14:53.89,0:14:56.06,Default,,0,0,0,,Бөлме қызметіне Domperi тапсырыс берейік! Домпери!
Dialogue: 0,0:14:56.06,0:14:56.18,Default,,0,0,0,,Бөлме қызметіне Domperi тапсырыс берейік! Домпери!
Dialogue: 0,0:14:56.18,0:14:57.06,Default,,0,0,0,,Бөлме қызметіне Domperi тапсырыс берейік! Домпери!
Dialogue: 0,0:14:56.18,0:14:57.06,Default,,0,0,0,,<Бұл Дом Пери>
Dialogue: 0,0:15:01.31,0:15:02.15,Default,,0,0,0,,Сәлем! Уф!
Dialogue: 0,0:15:02.40,0:15:03.65,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:15:05.77,0:15:06.61,Default,,0,0,0,,(құлыптау дыбысы)
Dialogue: 0,0:15:08.19,0:15:09.15,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:15:09.61,0:15:12.49,Default,,0,0,0,,Хаа... Кенет не болды?
Dialogue: 0,0:15:13.03,0:15:14.24,Default,,0,0,0,,Сіз сенімдісіз бе...
Dialogue: 0,0:15:14.37,0:15:15.91,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:15:16.08,0:15:18.04,Default,,0,0,0,,Кешіріңіз, бірақ басқа біреумен...
Dialogue: 0,0:15:18.37,0:15:20.33,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:15:21.92,0:15:22.75,Default,,0,0,0,,Хмм…
Dialogue: 0,0:15:25.00,0:15:29.05,Default,,0,0,0,,Ана саған соңына дейін сенді.
Dialogue: 0,0:15:39.31,0:15:40.60,Default,,0,0,0,,Түрмеден шыққаннан кейін...
Dialogue: 0,0:15:41.23,0:15:44.02,Default,,0,0,0,,Аурухананы іздеп, бөлменің алдына шықтым.
Dialogue: 0,0:15:45.06,0:15:47.19,Default,,0,0,0,,Бірақ мен кіре алмадым.
Dialogue: 0,0:15:48.36,0:15:50.40,Default,,0,0,0,,Сәйкес келетін бет болмады.
Dialogue: 0,0:15:51.40,0:15:54.70,Default,,0,0,0,,Сол кезде мені Шанхайдан алып кетуге біреу келді.
Dialogue: 0,0:15:55.78,0:16:01.83,Default,,0,0,0,,Шанхайдағы жігіттер маған аудармашы, заңгер ретінде орын жасап берді.
Dialogue: 0,0:16:02.71,0:16:07.09,Default,,0,0,0,,Мен әрқашан «бұлай жалғаса беруге болмайды» деп ойлайтынмын.
Dialogue: 0,0:16:07.50,0:16:09.63,Default,,0,0,0,,Менің орнымнан кетуге батылым жетпеді.
Dialogue: 0,0:16:11.05,0:16:14.47,Default,,0,0,0,,Анам екеумізді бірден тастап кету керек еді.
Dialogue: 0,0:16:14.97,0:16:18.97,Default,,0,0,0,,Әй, ол өзін де таң қалдыратын қорқақ еді.
Dialogue: 0,0:16:22.69,0:16:25.69,Default,,0,0,0,,Енді бәрі маңызды емес
Dialogue: 0,0:16:27.44,0:16:29.65,Default,,0,0,0,,Бұл өмір жолы тым азапты
Dialogue: 0,0:16:34.07,0:16:34.95,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:35.57,0:16:36.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:37.78,0:16:39.45,Default,,0,0,0,,Мен саған тағы да сенемін
Dialogue: 0,0:16:40.58,0:16:41.66,Default,,0,0,0,,Екеуміз бірге қашайық
Dialogue: 0,0:16:42.08,0:16:44.04,Default,,0,0,0,,А... қашасың ба?
Dialogue: 0,0:16:48.79,0:16:49.75,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:16:50.46,0:16:53.05,Default,,0,0,0,,Қамқоршылықтағы балалармен бірге елден кету
Dialogue: 0,0:16:53.51,0:16:54.47,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:16:55.26,0:16:57.85,Default,,0,0,0,,Барлығын басынан бастаңыз.
Dialogue: 0,0:17:00.56,0:17:01.56,Default,,0,0,0,,Масато
Dialogue: 0,0:17:03.85,0:17:06.85,Default,,0,0,0,,Бұл менің кінәм болды, мені кешіріңіз.
Dialogue: 0,0:17:10.73,0:17:15.11,Default,,0,0,0,,
Dialogue: 0,0:17:18.62,0:17:20.78,Default,,0,0,0,,Ммм...
Dialogue: 0,0:17:21.41,0:17:23.33,Default,,0,0,0,,
Dialogue: 0,0:17:25.79,0:17:26.62,Default,,0,0,0,,Бұл бесінші қабат.
Dialogue: 0,0:17:28.25,0:17:29.08,Default,,0,0,0,,Эбби
Dialogue: 0,0:17:29.59,0:17:30.84,Default,,0,0,0,,Бұл қария ма?
Dialogue: 0,0:17:31.21,0:17:33.34,Default,,0,0,0,,А, мен оны тез дайындауым керек.
Dialogue: 0,0:17:33.71,0:17:35.26,Default,,0,0,0,,Бұл бала Абигейл ме?
Dialogue: 0,0:17:36.13,0:17:37.93,Default,,0,0,0,,Ол дөрекі ханшайым.
Dialogue: 0,0:17:38.22,0:17:41.22,Default,,0,0,0,,Мен жапон тілін онша түсінбеймін, бірақ бұл жаман сөз.
Dialogue: 0,0:17:44.52,0:17:47.60,Default,,0,0,0,,Мафияда болғаныңыз сіздің қаруыңыз бар дегенді білдірмейді, солай емес пе?
Dialogue: 0,0:17:49.90,0:17:50.86,Default,,0,0,0,,Сіз мені қорқытасыз ба?
Dialogue: 0,0:17:51.48,0:17:53.98,Default,,0,0,0,,Бұл балалар аздап немесе тыныш қозғалмайды.
Dialogue: 0,0:17:57.28,0:17:58.66,Default,,0,0,0,,Барлығы ояныңдар!
Dialogue: 0,0:17:58.78,0:18:00.53,Default,,0,0,0,,Тыныштап айт, тыңда!
Dialogue: 0,0:18:01.28,0:18:03.41,Default,,0,0,0,,Даусыңды көтерсең, мен сені атып тастаймын!
Dialogue: 0,0:18:05.00,0:18:06.66,Default,,0,0,0,,Жарайсыңдар ма?
Dialogue: 0,0:18:07.08,0:18:08.58,Default,,0,0,0,,Шу шығармай менің артымнан жүр.
Dialogue: 0,0:18:13.50,0:18:14.51,Default,,0,0,0,,Сәлем
Dialogue: 0,0:18:14.80,0:18:16.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:17.72,0:18:19.51,Default,,0,0,0,,Жүр, мін, мін
Dialogue: 0,0:18:20.34,0:18:22.68,Default,,0,0,0,,Эбби Қош келдіңіз (Эбби) О
Dialogue: 0,0:18:23.26,0:18:25.22,Default,,0,0,0,,Жарайды, барлығы бортқа отырды, солай ма?
Dialogue: 0,0:18:26.18,0:18:27.52,Default,,0,0,0,,Сіз мұнда кімсіз?
Dialogue: 0,0:18:27.85,0:18:29.81,Default,,0,0,0,,Әкесі (Сэйджи) Ах
Dialogue: 0,0:18:30.65,0:18:32.31,Default,,0,0,0,,Онда кеттік!
Dialogue: 0,0:18:42.28,0:18:45.99,Default,,0,0,0,,Масато, трассадан бір жерге түсу керек.
Dialogue: 0,0:18:46.95,0:18:49.71,Default,,0,0,0,,Менің бұлай қашып кетуіме жол бермейді деп ойлаймын.
Dialogue: 0,0:19:10.35,0:19:11.73,Default,,0,0,0,,Эдамама Оян!
Dialogue: 0,0:19:11.85,0:19:12.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:12.81,0:19:14.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:14.69,0:19:15.52,Default,,0,0,0,,Бұл олар!
Dialogue: 0,0:19:16.02,0:19:17.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:17.99,0:19:19.49,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:23.53,0:19:24.70,Default,,0,0,0,,Мен күшпен баруым керек пе?
Dialogue: 0,0:19:24.99,0:19:27.08,Default,,0,0,0,,Бұл мүмкін емес, өйткені менің балаларым бар.
Dialogue: 0,0:19:40.59,0:19:42.47,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:44.09,0:19:48.97,Default,,0,0,0,,А... Мен мұны алаяқтар тобының бір бөлігі деп ойламаппын.
Dialogue: 0,0:19:49.93,0:19:52.52,Default,,0,0,0,,Вьетнам Лаос және Камбоджа
Dialogue: 0,0:19:52.85,0:19:55.73,Default,,0,0,0,,Мен оларды аяғыммен жинасам да.
Dialogue: 0,0:19:56.57,0:20:00.19,Default,,0,0,0,,Бірақ сен мұның бәрін өзіңе сақтау үшін өте айлакерсің, Эдамура-кун.
Dialogue: 0,0:20:00.49,0:20:04.57,Default,,0,0,0,,Сізді сатып алған төраға Әкемі шошып жылай береді.
Dialogue: 0,0:20:06.87,0:20:09.37,Default,,0,0,0,,Мен де сені сатып алатынмын~
Dialogue: 0,0:20:09.49,0:20:10.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:11.66,0:20:14.54,Default,,0,0,0,,А, бұл ақпарат пайдалы болды.
Dialogue: 0,0:20:14.75,0:20:17.21,Default,,0,0,0,,Шанхай мен Токио жоқ
Dialogue: 0,0:20:17.46,0:20:20.05,Default,,0,0,0,,Біз қазірден бастап жақсы араласуымыз керек.
Dialogue: 0,0:20:20.17,0:20:22.17,Default,,0,0,0,,Жоқ, бұл дұрыс.
Dialogue: 0,0:20:22.76,0:20:23.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:25.30,0:20:26.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:29.31,0:20:31.56,Default,,0,0,0,,Уф
Dialogue: 0,0:20:32.56,0:20:33.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:33.52,0:20:34.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:35.44,0:20:36.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:39.40,0:20:41.86,Default,,0,0,0,,Айтпадың ба, Масато?
Dialogue: 0,0:20:42.82,0:20:45.16,Default,,0,0,0,,Шанхай айдаһары мен жолбарысы
Dialogue: 0,0:20:47.32,0:20:49.37,Default,,0,0,0,,Бұл нағыз мен
Dialogue: 0,0:20:50.95,0:20:56.96,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.82,0:22:50.82,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.32,0:22:58.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory