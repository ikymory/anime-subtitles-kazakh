Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:06.38,Default,,0,0,0,,Ай!
Dialogue: 0,0:00:18.10,0:00:20.56,Default,,0,0,0,,Рұқсатсыз сурет салмаңыз
Dialogue: 0,0:00:22.27,0:00:26.02,Default,,0,0,0,,Әдемі нәрсе көрсем, суретін салмаймын.
Dialogue: 0,0:00:26.40,0:00:28.19,Default,,0,0,0,,СМАШ АҚШ-ы!
Dialogue: 0,0:00:28.31,0:00:30.15,Default,,0,0,0,,Мен сені алдап жатырмын.
Dialogue: 0,0:00:30.32,0:00:32.15,Default,,0,0,0,,А, сен жалықтысың.
Dialogue: 0,0:00:32.28,0:00:35.28,Default,,0,0,0,,Жақсы, ол азаймайды.
Dialogue: 0,0:00:37.49,0:00:39.53,Default,,0,0,0,,Мен сурет салатын еркектерді ұнатпаймын.
Dialogue: 0,0:00:40.08,0:00:41.70,Default,,0,0,0,,Ауыратын сөздер
Dialogue: 0,0:00:41.83,0:00:44.83,Default,,0,0,0,,Сіздің сүйіктіңіз - Эдамаме, солай ма?
Dialogue: 0,0:00:46.08,0:00:48.17,Default,,0,0,0,,Эй, қарным ашты.
Dialogue: 0,0:00:48.29,0:00:51.25,Default,,0,0,0,,Жүр, Эдамаме суши жейік
Dialogue: 0,0:00:52.76,0:00:55.84,Default,,0,0,0,,Сіз француз тілін үйрендіңіз бе?
Dialogue: 0,0:00:56.18,0:01:00.18,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:01:07.77,0:01:11.48,Default,,0,0,0,,<Талай рет айттым, қаттырақ ұста, құлайсың.>
Dialogue: 0,0:01:11.61,0:01:14.53,Default,,0,0,0,,Суши құлап кетпес үшін ұстаңыз.
Dialogue: 0,0:01:14.74,0:01:16.65,Default,,0,0,0,,(қытайша)
Dialogue: 0,0:01:16.78,0:01:18.91,Default,,0,0,0,,Ах~ не айтып тұрғаныңды түсінбедім!
Dialogue: 0,0:01:19.03,0:01:19.66,Default,,0,0,0,,<Ұнамаса, тоқта! 〉
Dialogue: 0,0:01:19.74,0:01:20.37,Default,,0,0,0,,〈Иә, солай сияқты〉
Dialogue: 0,0:01:20.49,0:01:21.45,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:01:21.58,0:01:23.12,Default,,0,0,0,,Мен қазір тастаймын
Dialogue: 0,0:01:23.24,0:01:24.08,Default,,0,0,0,,Ах
Dialogue: 0,0:01:25.33,0:01:27.67,Default,,0,0,0,,〈Француз тілін есіңе түсірмеген сияқтысың.〉
Dialogue: 0,0:01:28.33,0:01:34.34,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:26.89,0:02:32.90,Default,,0,0,0,,~♪
Dialogue: 0,0:02:36.99,0:02:38.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:38.57,0:02:41.74,Default,,0,0,0,,Мен эдамаме суши жей аламын деп ойладым.
Dialogue: 0,0:02:41.87,0:02:42.95,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:02:43.07,0:02:47.33,Default,,0,0,0,,"Маған мұндай жұмыс ұнамайды. Мен ресми жұмысты қалаймын."
Dialogue: 0,0:02:47.45,0:02:49.54,Default,,0,0,0,,Мен осылай дедім, сондықтан таптым.
Dialogue: 0,0:02:49.66,0:02:51.58,Default,,0,0,0,,Бұл үшін кешіріңіз.
Dialogue: 0,0:02:52.04,0:02:53.67,Default,,0,0,0,,Сонда бұл оңай.
Dialogue: 0,0:02:53.79,0:02:55.92,Default,,0,0,0,,Бұл дүниеге қайта кел.
Dialogue: 0,0:02:56.05,0:02:57.46,Default,,0,0,0,,Мен бас тартамын.
Dialogue: 0,0:02:58.26,0:03:01.43,Default,,0,0,0,,Еуропалықтар үшін Азия – Азия.
Dialogue: 0,0:03:01.55,0:03:04.43,Default,,0,0,0,,Шығыстың қиыр шетіндегі мәдениетте көп айырмашылық болмауы мүмкін.
Dialogue: 0,0:03:04.55,0:03:06.89,Default,,0,0,0,,Иә! Мұнда бәрі дәмді.
Dialogue: 0,0:03:07.72,0:03:09.64,Default,,0,0,0,,<Әке, бұл дәмді! 〉
Dialogue: 0,0:03:09.77,0:03:11.27,Default,,0,0,0,,<Рахмет, ханым>
Dialogue: 0,0:03:11.39,0:03:12.85,Default,,0,0,0,,<Мадемуазель>
Dialogue: 0,0:03:12.98,0:03:15.32,Default,,0,0,0,,Сіз жақсы пансионат таптыңыз, Эдамаме.
Dialogue: 0,0:03:15.44,0:03:18.65,Default,,0,0,0,,Аа, бұл арзан, тамақ дәмді. Бұл ең жақсы.
Dialogue: 0,0:03:21.53,0:03:22.66,Default,,0,0,0,,сызық!
Dialogue: 0,0:03:23.28,0:03:25.53,Default,,0,0,0,,〈Мырза, бұл кімдікі? 〉
Dialogue: 0,0:03:25.66,0:03:30.25,Default,,0,0,0,,<Иә? А~ Тапсырыс беруші оны әкеме қалдырып кеткен сияқты.
Dialogue: 0,0:03:30.37,0:03:34.04,Default,,0,0,0,,<Егер бұл Шагал немесе Матисс болса, фольгамен жабылған болар еді.>
Dialogue: 0,0:03:34.38,0:03:35.88,Default,,0,0,0,,<Хмм>
Dialogue: 0,0:03:36.00,0:03:37.80,Default,,0,0,0,,<Бұл Монтойяның суретіне ұқсайды>
Dialogue: 0,0:03:38.21,0:03:39.96,Default,,0,0,0,,Монтойя?
Dialogue: 0,0:03:40.17,0:03:42.26,Default,,0,0,0,,Эдамаме Сіз қалай ойлайсыз?
Dialogue: 0,0:03:42.59,0:03:45.01,Default,,0,0,0,,Француз тілінде сөйлесеңіз де
Dialogue: 0,0:03:45.14,0:03:48.51,Default,,0,0,0,,Мен бұл сурет Монтойяға ұқсайды ма деп ойладым.
Dialogue: 0,0:03:48.64,0:03:51.14,Default,,0,0,0,,Мен бұл Монтойяны да түсінбеймін.
Dialogue: 0,0:03:51.27,0:03:53.23,Default,,0,0,0,,Синтияға түсініктеме беріңізші
Dialogue: 0,0:03:55.10,0:03:59.44,Default,,0,0,0,,Меланхолия мен ностальгияның суретшісі Серджо Монтойя
Dialogue: 0,0:03:59.78,0:04:03.36,Default,,0,0,0,,Жұмбақ фигура және аздаған шығармалары бар
Dialogue: 0,0:04:03.49,0:04:08.08,Default,,0,0,0,,Соңғы жылдары танымал бола бастаған аты аңызға айналған суретші.
Dialogue: 0,0:04:09.08,0:04:11.83,Default,,0,0,0,,Бірақ бұл картинаның жанасуы Монтояға қарағанда жақсырақ.
Dialogue: 0,0:04:11.96,0:04:14.67,Default,,0,0,0,,Менің ойымша, оған Модильяни әсер етті.
Dialogue: 0,0:04:14.79,0:04:15.75,Default,,0,0,0,,Кітапханада жәндіктер ұяласып жатыр ма? Бұл өте қорқынышты.
Dialogue: 0,0:04:15.88,0:04:18.59,Default,,0,0,0,,Ол бәрібір бірнеше тиын ғана жасайтын белгісіз суретші.
Dialogue: 0,0:04:18.75,0:04:22.01,Default,,0,0,0,,Маған осындай сурет жарасады.
Dialogue: 0,0:04:22.63,0:04:25.05,Default,,0,0,0,,Ой! Бұл тирамису ма?
Dialogue: 0,0:04:25.76,0:04:29.51,Default,,0,0,0,,〈Ей, балам, жұмысыңды тастау оңай.''
Dialogue: 0,0:04:29.64,0:04:34.23,Default,,0,0,0,,〈Төзімділік - бұл күш, сондықтан оны жеп, сау болыңыз〉
Dialogue: 0,0:04:34.35,0:04:36.40,Default,,0,0,0,,Біз мейірімдіміз
Dialogue: 0,0:04:36.52,0:04:39.65,Default,,0,0,0,,«Жұмысыңды тастама, жай ғана жалғастыр».
Dialogue: 0,0:04:40.28,0:04:42.69,Default,,0,0,0,,Сонымен... иә
Dialogue: 0,0:04:42.94,0:04:45.20,Default,,0,0,0,,Ертең мен басымды иемін.
Dialogue: 0,0:04:45.32,0:04:46.49,Default,,0,0,0,,Сол дүкен менеджеріне ме?
Dialogue: 0,0:04:46.61,0:04:47.45,Default,,0,0,0,,...
Dialogue: 0,0:04:48.20,0:04:50.37,Default,,0,0,0,,Мені ашуландыратын нәрселер көп.
Dialogue: 0,0:04:50.49,0:04:53.75,Default,,0,0,0,,Мынадай қиын жұмыс пен жайлы орын бар.
Dialogue: 0,0:04:54.50,0:04:56.96,Default,,0,0,0,,Бұл жерде бар күшіңді салмасаң, жазаланасың.
Dialogue: 0,0:04:58.88,0:05:00.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:16.02,0:05:17.48,Default,,0,0,0,,(Бұрылу тетігінің дыбысы)
Dialogue: 0,0:05:19.81,0:05:20.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:24.78,0:05:26.11,Default,,0,0,0,,О, сәл күте тұрыңыз (Дүкенші) А?
Dialogue: 0,0:05:26.70,0:05:27.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:27.99,0:05:30.12,Default,,0,0,0,,Ах, Эдвард VIII.
Dialogue: 0,0:05:31.95,0:05:34.37,Default,,0,0,0,,Мен оны кейінірек қарастырамын.
Dialogue: 0,0:05:35.08,0:05:36.83,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:36.96,0:05:40.38,Default,,0,0,0,,Бұдан былай дүкен меңгерушісінің айтқанын барынша тыңдаймын.
Dialogue: 0,0:05:40.88,0:05:42.84,Default,,0,0,0,,Сот…
Dialogue: 0,0:05:42.96,0:05:44.71,Default,,0,0,0,,Хаа…
Dialogue: 0,0:05:46.84,0:05:49.39,Default,,0,0,0,,Менеджер! Кешегі күн үшін кешіріңіз!
Dialogue: 0,0:05:49.97,0:05:51.43,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:05:51.55,0:05:52.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:53.35,0:05:55.60,Default,,0,0,0,,... Қаңғыбас мысықтарға арналған азық?
Dialogue: 0,0:05:55.73,0:05:57.81,Default,,0,0,0,,Ағылшын тілі түсінікті сияқты.
Dialogue: 0,0:05:58.56,0:06:02.40,Default,,0,0,0,,Қазір сізге арнайы ұпай беретін жақсы уақыт.
Dialogue: 0,0:06:03.44,0:06:06.99,Default,,0,0,0,,Біріншіден, әңгіме толық ашылмаған.
Dialogue: 0,0:06:07.11,0:06:09.36,Default,,0,0,0,,Қытырлақ шербет
Dialogue: 0,0:06:10.66,0:06:13.91,Default,,0,0,0,,Әрі қарай, филе қалың.
Dialogue: 0,0:06:14.04,0:06:16.20,Default,,0,0,0,,Бұл қандай кесінді?
Dialogue: 0,0:06:17.62,0:06:19.37,Default,,0,0,0,,Сірке суы бар күріш... (түкірген дыбыс)
Dialogue: 0,0:06:19.83,0:06:21.21,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,0:06:21.63,0:06:23.96,Default,,0,0,0,,Күрішті ұстау да қатты.
Dialogue: 0,0:06:24.09,0:06:25.96,Default,,0,0,0,,Оның үлкен денесі бар.
Dialogue: 0,0:06:26.84,0:06:28.72,Default,,0,0,0,,Бұл мүлдем маңызды емес
Dialogue: 0,0:06:29.59,0:06:31.68,Default,,0,0,0,,Сіз сәтсізсіз.
Dialogue: 0,0:06:32.64,0:06:36.64,Default,,0,0,0,,Мен Ниццада суши жей аламын деп ойлап, тоқтадым.
Dialogue: 0,0:06:36.89,0:06:38.73,Default,,0,0,0,,Уақытты босқа өткізген сияқты.
Dialogue: 0,0:06:40.52,0:06:41.56,Default,,0,0,0,,Мазасыздық төлемі
Dialogue: 0,0:06:43.19,0:06:45.32,Default,,0,0,0,,Дөрекілігім үшін кешіріңіз.
Dialogue: 0,0:06:45.61,0:06:49.28,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:58.25,0:06:59.08,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:07:04.04,0:07:05.75,Default,,0,0,0,,Көңіліңізді көтеріңіз, менеджер
Dialogue: 0,0:07:05.88,0:07:08.09,Default,,0,0,0,,Мен қазір дүкенді жауып жатырмын.
Dialogue: 0,0:07:08.46,0:07:11.34,Default,,0,0,0,,Ол жігіт үшін уайымдама.
Dialogue: 0,0:07:11.47,0:07:13.55,Default,,0,0,0,,Мен бәрібір уақытты босқа өткізетін шағымданушымын.
Dialogue: 0,0:07:13.68,0:07:15.47,Default,,0,0,0,,Жетеді
Dialogue: 0,0:07:15.60,0:07:18.06,Default,,0,0,0,,Мен бәрімен бірге Қытайға қайтамын.
Dialogue: 0,0:07:18.56,0:07:20.31,Default,,0,0,0,,Сіз де Кореяға қайтуыңыз керек.
Dialogue: 0,0:07:21.27,0:07:22.10,Default,,0,0,0,,Әй, Жапония...!
Dialogue: 0,0:07:25.15,0:07:26.40,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:27.44,0:07:29.74,Default,,0,0,0,,〈Ей, монах, таптың ба? 〉
Dialogue: 0,0:07:29.86,0:07:33.53,Default,,0,0,0,,Иә? Әй, бұл әдеттегідей Тревиан.
Dialogue: 0,0:07:33.66,0:07:34.70,Default,,0,0,0,,<Бұл дұрыс емес>
Dialogue: 0,0:07:35.32,0:07:38.29,Default,,0,0,0,,<Мен сізден жаңа үй таптыңыз ба деп сұраймын.>
Dialogue: 0,0:07:38.74,0:07:42.29,Default,,0,0,0,,О? Кешіріңіз, бірақ менің француз тілім аз...
Dialogue: 0,0:07:42.42,0:07:43.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:43.62,0:07:46.79,Default,,0,0,0,,〈Сіз кешегі әңгімені толық тыңдамаған сияқтысыз.〉
Dialogue: 0,0:07:46.92,0:07:50.17,Default,,0,0,0,,〈Аа~ мен жай ғана басымды изеп едім.〉
Dialogue: 0,0:07:50.30,0:07:51.92,Default,,0,0,0,,〈мүлдем〉
Dialogue: 0,0:07:52.59,0:07:54.76,Default,,0,0,0,,〈Осы пансионатты жабу〉
Dialogue: 0,0:07:55.39,0:07:57.22,Default,,0,0,0,,Мари, сен не айтып тұрсың?
Dialogue: 0,0:07:58.01,0:07:59.47,Default,,0,0,0,,Айтайын дегенім, Макото.
Dialogue: 0,0:07:59.60,0:08:02.44,Default,,0,0,0,,Мен бұл жерден көшу үшін дүкенімді жауып жатырмын.
Dialogue: 0,0:08:03.81,0:08:05.02,Default,,0,0,0,,Жабық?
Dialogue: 0,0:08:05.90,0:08:08.11,Default,,0,0,0,,А... мына жерді жауып жатырсың ба?
Dialogue: 0,0:08:08.23,0:08:09.19,Default,,0,0,0,,Эден мектебінің сұхбатына барамын
Dialogue: 0,0:08:09.73,0:08:11.90,Default,,0,0,0,,О... ештеңе жоқ па?
Dialogue: 0,0:08:12.03,0:08:15.53,Default,,0,0,0,,Жоқ? Керемет пансионат!
Dialogue: 0,0:08:18.41,0:08:21.12,Default,,0,0,0,,Қарыз бар сияқты.
Dialogue: 0,0:08:21.41,0:08:22.33,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:08:22.87,0:08:24.00,Default,,0,0,0,,Маридің анасы
Dialogue: 0,0:08:24.12,0:08:27.04,Default,,0,0,0,,Қарыздан өлген көрінеді.
Dialogue: 0,0:08:27.71,0:08:30.05,Default,,0,0,0,,А, ол ауырып қалған сияқты.
Dialogue: 0,0:08:30.88,0:08:33.93,Default,,0,0,0,,Сондықтан мен сол пансионатты сатып, көшуді жөн көрдім.
Dialogue: 0,0:08:34.05,0:08:35.89,Default,,0,0,0,,Міне (дірілдеген дыбыс)
Dialogue: 0,0:08:36.26,0:08:37.39,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:08:37.93,0:08:38.85,Default,,0,0,0,,Қайтадан қоңырау шалыңыз
Dialogue: 0,0:08:38.97,0:08:42.48,Default,,0,0,0,,Сіз жалғызсыз ба? Хаха мен де
Dialogue: 0,0:08:42.60,0:08:45.90,Default,,0,0,0,,Тізе жастығыңсыз түнде ұйықтай алмаймын.
Dialogue: 0,0:08:46.27,0:08:49.48,Default,,0,0,0,,Иә? О, мен келесі аптада қайтамын
Dialogue: 0,0:08:50.94,0:08:52.44,Default,,0,0,0,,Француз кәдесыйы?
Dialogue: 0,0:08:52.57,0:08:56.11,Default,,0,0,0,,Содан кейін мен Парижге тоқтап, галереяларды тексеремін.
Dialogue: 0,0:08:56.24,0:08:58.66,Default,,0,0,0,,20 000-нан 30 000-ға дейін жақсы сурет болса
Dialogue: 0,0:09:09.59,0:09:10.42,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:17.26,0:09:18.18,Default,,0,0,0,,〈Не болды? 〉
Dialogue: 0,0:09:19.68,0:09:22.14,Default,,0,0,0,,Бұл жерді сату үшін маған қанша керек?
Dialogue: 0,0:09:22.27,0:09:23.18,Default,,0,0,0,,Не? 〉
Dialogue: 0,0:09:23.31,0:09:24.39,Default,,0,0,0,,<Ақша>
Dialogue: 0,0:09:24.48,0:09:25.60,Default,,0,0,0,,〈Бұл қанша тұрады? 〉
Dialogue: 0,0:09:26.23,0:09:30.02,Default,,0,0,0,,Ах... Мысалы, сізде 20 000 еуро болса, ше?
Dialogue: 0,0:09:30.23,0:09:31.40,Default,,0,0,0,,20 000 еуро
Dialogue: 0,0:09:31.52,0:09:32.82,Default,,0,0,0,,<20 000 еуро ма? 〉
Dialogue: 0,0:09:33.32,0:09:36.40,Default,,0,0,0,,〈Егер дәл солай болса, бұл үлкен көмек болар еді.〉
Dialogue: 0,0:09:36.53,0:09:38.07,Default,,0,0,0,,Бұл жерді жабудан аулақ бола аламыз ба?
Dialogue: 0,0:09:38.20,0:09:39.03,Default,,0,0,0,,〈Неге қозғалмайсың? 〉
Dialogue: 0,0:09:39.20,0:09:45.08,Default,,0,0,0,,〈Мүмкін, бірақ мен лотерея ұтып алмасам, бұл өте, өте.〉
Dialogue: 0,0:09:46.46,0:09:48.83,Default,,0,0,0,,Өтінемін, бұл суретті маған сатыңыз.
Dialogue: 0,0:09:49.29,0:09:51.42,Default,,0,0,0,,〈Аа, бұл суретке не болды? 〉
Dialogue: 0,0:09:51.54,0:09:54.84,Default,,0,0,0,,Мен бұл суретті сатып алдым.
Dialogue: 0,0:09:55.30,0:09:56.80,Default,,0,0,0,,20 000 еуроға
Dialogue: 0,0:09:59.43,0:10:00.43,Default,,0,0,0,,<Не? 〉
Dialogue: 0,0:10:02.68,0:10:03.93,Default,,0,0,0,,Аа...
Dialogue: 0,0:10:05.47,0:10:06.93,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:10:07.35,0:10:09.23,Default,,0,0,0,,Не? Дәл осылай!
Dialogue: 0,0:10:09.35,0:10:12.19,Default,,0,0,0,,Синтия~ Сіз маған көмектесе аласыз ба?
Dialogue: 0,0:10:12.40,0:10:13.73,Default,,0,0,0,,Ммм
Dialogue: 0,0:10:13.86,0:10:15.99,Default,,0,0,0,,Үлеске байланысты десем ше?
Dialogue: 0,0:10:16.11,0:10:18.03,Default,,0,0,0,,Көп емес...
Dialogue: 0,0:10:18.57,0:10:21.53,Default,,0,0,0,,Жарайды. Мен де ара-тұра қайырымдылықпен айналысамын.
Dialogue: 0,0:10:21.66,0:10:23.28,Default,,0,0,0,,Уау~ Рахмет!
Dialogue: 0,0:10:23.66,0:10:27.00,Default,,0,0,0,,А, өтінемін, мұны Лораннан құпия сақтаңыз.
Dialogue: 0,0:10:27.25,0:10:28.33,Default,,0,0,0,,Өйткені бұл қиындық тудырады
Dialogue: 0,0:10:28.46,0:10:31.50,Default,,0,0,0,,Мен Эдамаме ойлап тапқан стратегияны асыға күтемін.
Dialogue: 0,0:10:31.75,0:10:34.17,Default,,0,0,0,,Сіз Лоранға қарағанда әлдеқайда жақсы жұмыс істеуіңіз керек.
Dialogue: 0,0:10:34.30,0:10:36.59,Default,,0,0,0,,Мен оны асыға күтемін, Көшбасшы.
Dialogue: 0,0:10:37.26,0:10:39.88,Default,,0,0,0,,Мен өз сезімдерімді не істеуім керек?
Dialogue: 0,0:10:40.01,0:10:42.72,Default,,0,0,0,,Сен мені жек көретініңді түсіндің.
Dialogue: 0,0:10:43.10,0:10:44.35,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:44.47,0:10:47.52,Default,,0,0,0,,Ұнамайтындар, не істеп жатқаныңды бақылап отыр.
Dialogue: 0,0:10:47.64,0:10:48.77,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:10:49.52,0:10:53.15,Default,,0,0,0,,(ағынды дыбыс)
Dialogue: 0,0:11:02.66,0:11:03.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:05.08,0:11:06.16,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:11:09.54,0:11:11.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:11.62,0:11:12.58,Default,,0,0,0,,Шашыңызды қидыңыз ба?
Dialogue: 0,0:11:12.71,0:11:13.63,Default,,0,0,0,,Бұл керісінше.
Dialogue: 0,0:11:14.09,0:11:16.30,Default,,0,0,0,,Әй, біраз уақыт болды ғой, солай емес пе?
Dialogue: 0,0:11:16.42,0:11:18.88,Default,,0,0,0,,Ол жылқы шаянына қатты ұқсайды.
Dialogue: 0,0:11:19.01,0:11:20.72,Default,,0,0,0,,Бұл жаман сөз.
Dialogue: 0,0:11:21.80,0:11:23.39,Default,,0,0,0,,Көптен бері көрмегелі, Эбби
Dialogue: 0,0:11:23.51,0:11:25.51,Default,,0,0,0,,Жалақы аз сияқты.
Dialogue: 0,0:11:25.72,0:11:29.68,Default,,0,0,0,,Мен оның иек жастығы бар уақыт өлтіруші екенін білемін.
Dialogue: 0,0:11:29.81,0:11:31.39,Default,,0,0,0,,Кудо да кейінірек келеді деп жоспарланған.
Dialogue: 0,0:11:31.52,0:11:34.27,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:11:34.40,0:11:36.15,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:11:36.36,0:11:38.23,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:11:38.36,0:11:41.53,Default,,0,0,0,,Мен Кудоны күтемін, сен алдымен үйге бара аласың.
Dialogue: 0,0:11:41.65,0:11:44.78,Default,,0,0,0,,Ах~ Онда мен бірдеңе жеуім керек.
Dialogue: 0,0:11:51.75,0:11:53.08,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:11:53.96,0:11:55.33,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:11:57.17,0:11:59.55,Default,,0,0,0,,Суық қыста тек жылы заттарды
Dialogue: 0,0:11:59.67,0:12:00.92,Default,,0,0,0,,Жақсы
Dialogue: 0,0:12:01.05,0:12:04.43,Default,,0,0,0,,Париждегі рамен Жапониядағыдай дәмді.
Dialogue: 0,0:12:04.55,0:12:06.39,Default,,0,0,0,,Жапонияда дәмді тағамдар бар ма?
Dialogue: 0,0:12:06.51,0:12:09.35,Default,,0,0,0,,А, мен саған бір күні айналаны көрсетемін.
Dialogue: 0,0:12:10.22,0:12:12.18,Default,,0,0,0,,
Dialogue: 0,0:12:13.06,0:12:14.60,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:12:14.73,0:12:17.82,Default,,0,0,0,,Аа, мен оны 80% толған күйде қалдырамын.
Dialogue: 0,0:12:19.90,0:12:22.49,Default,,0,0,0,,Эбби өз еліне қайтпайды, солай ма?
Dialogue: 0,0:12:22.61,0:12:24.36,Default,,0,0,0,,Қайтуға ешқандай себеп жоқ
Dialogue: 0,0:12:24.49,0:12:26.74,Default,,0,0,0,,Ата-анаң ештеңе айтпады ма?
Dialogue: 0,0:12:27.70,0:12:30.24,Default,,0,0,0,,Соғыста қаза тапқан жоқ
Dialogue: 0,0:12:30.74,0:12:32.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:33.21,0:12:36.63,Default,,0,0,0,,Оранто да осыған ұқсас.
Dialogue: 0,0:12:36.83,0:12:39.59,Default,,0,0,0,,Жоқ, сен қиынырақсың.
Dialogue: 0,0:12:42.47,0:12:44.34,Default,,0,0,0,,Әлі ашпыз ба?
Dialogue: 0,0:12:46.01,0:12:47.30,Default,,0,0,0,,1-әже
Dialogue: 0,0:12:47.60,0:12:49.60,Default,,0,0,0,,〈Қандай сүйкімді жас ханым〉
Dialogue: 0,0:12:49.72,0:12:51.10,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:12:51.39,0:12:55.44,Default,,0,0,0,,Ыстықта жеген дұрыс шығар.
Dialogue: 0,0:13:00.32,0:13:01.69,Default,,0,0,0,,Ертеңгі күнді сұрама
Dialogue: 0,0:13:01.82,0:13:02.69,Default,,0,0,0,,О
Dialogue: 0,0:13:05.36,0:13:08.03,Default,,0,0,0,,Соған қарамастан, менің бөксем суып қалады.
Dialogue: 0,0:13:08.20,0:13:09.20,Default,,0,0,0,,О
Dialogue: 0,0:13:22.51,0:13:23.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:33.18,0:13:34.02,Default,,0,0,0,,Чи…
Dialogue: 0,0:13:42.78,0:13:44.40,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:45.57,0:13:47.74,Default,,0,0,0,,Алып тастау да жақсы нәрсе.
Dialogue: 0,0:13:47.86,0:13:48.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:49.95,0:13:53.20,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:13:57.54,0:14:00.96,Default,,0,0,0,,Синтия Эбби Кудо Мен сонда бардым.
Dialogue: 0,0:14:01.09,0:14:02.42,Default,,0,0,0,,«Соңғы жылдардағы танымалдылықтың артуы...» (Кудо)
Dialogue: 0,0:14:02.55,0:14:03.92,Default,,0,0,0,,Оны қатты ұстаңыз.
Dialogue: 0,0:14:04.05,0:14:06.05,Default,,0,0,0,,Біз мадемуазель
Dialogue: 0,0:14:06.26,0:14:09.18,Default,,0,0,0,,Мұндай ұқыпсыз блокнот дұрыс па?
Dialogue: 0,0:14:09.51,0:14:10.68,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:14:10.80,0:14:12.10,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:14:12.22,0:14:14.93,Default,,0,0,0,,Ол суреттің қадірін білмеуі мүмкін емес.
Dialogue: 0,0:14:15.39,0:14:16.39,Default,,0,0,0,,20 000-нан 30 000 картинаға арналған
Dialogue: 0,0:14:16.52,0:14:19.40,Default,,0,0,0,,Маған кішкене кеңес берсеңіз, мен оны сатып алатыныма сенімдімін.
Dialogue: 0,0:14:22.19,0:14:23.07,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:23.19,0:14:24.19,Default,,0,0,0,,Боджо Боджо!
Dialogue: 0,0:14:24.69,0:14:28.15,Default,,0,0,0,,Сізде Пикассо бар ма? Ван Гог ше? Достоевский де жақсы болар еді
Dialogue: 0,0:14:28.28,0:14:30.57,Default,,0,0,0,,Эй, бұл аздап көмектесер деп ойладым, маған лекция оқып берші.
Dialogue: 0,0:14:30.70,0:14:31.53,Default,,0,0,0,,Ах… Хаа
Dialogue: 0,0:14:31.66,0:14:36.04,Default,,0,0,0,,Мен жапон өнеріне талғампазмын, мен Юзан Кайбурамын.
Dialogue: 0,0:14:36.16,0:14:38.16,Default,,0,0,0,,Мен не сатып аларымды білмеймін.
Dialogue: 0,0:14:38.66,0:14:40.71,Default,,0,0,0,,Түсіндің бе? Сіз тіпті түсінесіз бе?
Dialogue: 0,0:14:41.29,0:14:42.63,Default,,0,0,0,,Ал бюджет...
Dialogue: 0,0:14:55.81,0:14:56.81,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:57.27,0:14:59.06,Default,,0,0,0,,Уақытыңызды бөліп, қараңызшы.
Dialogue: 0,0:14:59.35,0:15:01.06,Default,,0,0,0,,Сұрақтарыңыз болса...
Dialogue: 0,0:15:12.66,0:15:14.12,Default,,0,0,0,,Әкем мені құтқарды.
Dialogue: 0,0:15:17.62,0:15:20.79,Default,,0,0,0,,Тұтынушы Бұл суретке қалай қарайсыз?
Dialogue: 0,0:15:20.92,0:15:21.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:22.42,0:15:23.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:28.96,0:15:32.47,Default,,0,0,0,,Соңғы жылдары бұл жұмыстың танымалдығы тез артып келеді.
Dialogue: 0,0:15:32.59,0:15:34.51,Default,,0,0,0,,Антуан Дешамның еңбектерінде
Dialogue: 0,0:15:34.64,0:15:35.68,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:15:42.31,0:15:43.56,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:48.23,0:15:49.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:49.28,0:15:51.32,Default,,0,0,0,,Синтия! ше?
Dialogue: 0,0:15:52.40,0:15:53.91,Default,,0,0,0,,Синтия!
Dialogue: 0,0:15:58.62,0:15:59.75,Default,,0,0,0,,Шығу!
Dialogue: 0,0:15:59.87,0:16:01.00,Default,,0,0,0,,Не?
Dialogue: 0,0:16:01.50,0:16:04.25,Default,,0,0,0,,Мен ол адамды алдай алмаймын.
Dialogue: 0,0:16:04.38,0:16:05.21,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:16:05.79,0:16:09.34,Default,,0,0,0,,Ол Ұлыбританиядағы ең жақсы аукционшылардың бірі.
Dialogue: 0,0:16:09.46,0:16:11.92,Default,,0,0,0,,Англиядағы ең жақсысы
Dialogue: 0,0:16:12.05,0:16:15.01,Default,,0,0,0,,Жоқ, әлемдегі ең үздік бағалаушы.
Dialogue: 0,0:16:16.89,0:16:17.72,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:16:18.14,0:16:18.97,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:16:19.97,0:16:21.31,Default,,0,0,0,,Шығарайық
Dialogue: 0,0:16:21.77,0:16:22.89,Default,,0,0,0,,Сен
Dialogue: 0,0:16:23.27,0:16:24.19,Default,,0,0,0,,Иә
Dialogue: 0,0:16:24.44,0:16:25.65,Default,,0,0,0,,25 000...
Dialogue: 0,0:16:27.19,0:16:30.57,Default,,0,0,0,,25 000 жеткілікті екеніне сенімдісіз бе?
Dialogue: 0,0:16:30.82,0:16:31.65,Default,,0,0,0,,Иә
Dialogue: 0,0:16:32.49,0:16:33.53,Default,,0,0,0,,Сатып алайық
Dialogue: 0,0:16:38.83,0:16:42.00,Default,,0,0,0,,Жоқ, мен бұл туралы терең ойламаймын.
Dialogue: 0,0:16:42.54,0:16:46.38,Default,,0,0,0,,Мына сұмдық сурет 25 000 еуроға айналды, солай ма?
Dialogue: 0,0:16:46.50,0:16:48.21,Default,,0,0,0,,Бұл үлкен жетістік емес пе?
Dialogue: 0,0:16:48.34,0:16:50.34,Default,,0,0,0,,Қандай башаламандық
Dialogue: 0,0:16:50.46,0:16:51.88,Default,,0,0,0,,Сіз ауысуыңыз керек пе?
Dialogue: 0,0:16:52.01,0:16:55.76,Default,,0,0,0,,Лоран болмағанда, бәрі бір қалыпты жүретін еді.
Dialogue: 0,0:16:56.22,0:16:59.76,Default,,0,0,0,,Енді маған сыйақы уақытын беріңізші.
Dialogue: 0,0:17:00.43,0:17:02.89,Default,,0,0,0,,Сіз уәде етілгендей 20 000 алуыңыз керек.
Dialogue: 0,0:17:03.02,0:17:04.98,Default,,0,0,0,,Қалғанын үшеумізге бөліп беріңдерші.
Dialogue: 0,0:17:05.10,0:17:07.65,Default,,0,0,0,,Басқаларға көмектесу – мәртебе.
Dialogue: 0,0:17:08.19,0:17:10.32,Default,,0,0,0,,Мен өз үлесімді Кудоға беремін.
Dialogue: 0,0:17:10.44,0:17:12.61,Default,,0,0,0,,Иә, жақсы ма? Әпке!
Dialogue: 0,0:17:18.99,0:17:21.12,Default,,0,0,0,,Эй, бұл уәде етілген ақша.
Dialogue: 0,0:17:21.24,0:17:23.50,Default,,0,0,0,,<Ол шынымен 20 000 еуроға сатылды ма?>
Dialogue: 0,0:17:23.62,0:17:25.62,Default,,0,0,0,,Сіз бұл ақшаны қарызыңызды өтеуге пайдалана аласыз.
Dialogue: 0,0:17:26.46,0:17:29.38,Default,,0,0,0,,Оның үстіне соңғы кездері мен сізге көп қамқорлық жасап жүрмін.
Dialogue: 0,0:17:29.63,0:17:30.46,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:17:30.59,0:17:31.67,Default,,0,0,0,,<Сәлем Мари>
Dialogue: 0,0:17:31.80,0:17:34.21,Default,,0,0,0,,<Мен бірінші кезекте қарызды өтеуім керек болды>
Dialogue: 0,0:17:34.59,0:17:36.01,Default,,0,0,0,,<Сурет салудан бас тарту>
Dialogue: 0,0:17:36.13,0:17:36.97,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:37.09,0:17:41.85,Default,,0,0,0,,〈Бірақ мен мұндай картина 20 000 иен тұрады дегенге сене алмаймын〉
Dialogue: 0,0:17:41.97,0:17:43.85,Default,,0,0,0,,Сене алмайсың ба?
Dialogue: 0,0:17:43.97,0:17:45.23,Default,,0,0,0,,Жарайсың ба? себастьян
Dialogue: 0,0:17:45.35,0:17:48.65,Default,,0,0,0,,Суреттің құндылығы оны салған суретшінің аты ғана емес.
Dialogue: 0,0:17:48.77,0:17:51.57,Default,,0,0,0,,Ең бастысы, сіз суретке қаншалықты ғашық болдыңыз.
Dialogue: 0,0:17:51.69,0:17:53.65,Default,,0,0,0,,Ах~ Сонымен, жақсы...
Dialogue: 0,0:17:53.78,0:17:55.53,Default,,0,0,0,,Әйтеуір, суреттің құны қандай...
Dialogue: 0,0:17:55.65,0:17:57.91,Default,,0,0,0,,Суреттің нақты құндылығы қандай?
Dialogue: 0,0:17:58.57,0:18:00.03,Default,,0,0,0,,Париждегі шағын галереяда
Dialogue: 0,0:18:00.16,0:18:01.78,Default,,0,0,0,,Бізді үлкен тосынсый күтіп тұрды.
Dialogue: 0,0:18:02.53,0:18:04.24,Default,,0,0,0,,Көп жылдар бойы оның қайда екені белгісіз болды.
Dialogue: 0,0:18:04.37,0:18:07.46,Default,,0,0,0,,Серхио Монтойяның әйгілі «Лондонның қарлары» картинасы
Dialogue: 0,0:18:07.58,0:18:09.29,Default,,0,0,0,,Кенеттен табылды
Dialogue: 0,0:18:09.83,0:18:13.21,Default,,0,0,0,,Бұл жаңалықтың артында тұрған адам – «Өнер әлемінің 007»
Dialogue: 0,0:18:13.34,0:18:15.09,Default,,0,0,0,,Джеймс Коулман мырза
Dialogue: 0,0:18:15.21,0:18:17.55,Default,,0,0,0,,Надандық өте ұят нәрсе.
Dialogue: 0,0:18:18.38,0:18:22.76,Default,,0,0,0,,Өнерді шын сүйетін адам ретінде қатты таң қалдым.
Dialogue: 0,0:18:23.43,0:18:25.43,Default,,0,0,0,,«Лондондағы қар»
Dialogue: 0,0:18:25.56,0:18:30.31,Default,,0,0,0,,Мүлдем басқа адамның туындысы деп екі-үш тиынға сатылды.
Dialogue: 0,0:18:30.77,0:18:34.19,Default,,0,0,0,,Заттардың құндылығын түсінбеу немесе зерттемеу
Dialogue: 0,0:18:34.32,0:18:36.07,Default,,0,0,0,,Арсыз адамдар тым көп
Dialogue: 0,0:18:36.90,0:18:39.28,Default,,0,0,0,,Бұл мәдени құлдырау енді жоқ
Dialogue: 0,0:18:39.40,0:18:42.07,Default,,0,0,0,,Оны ұлттық дерт деп сенімді түрде айтуға болады.
Dialogue: 0,0:18:42.62,0:18:45.45,Default,,0,0,0,,Болжалды бағасы 20 миллион еуро деп айтылады...
Dialogue: 0,0:18:48.08,0:18:50.37,Default,,0,0,0,,〈Қуырылған сиыр етін жейтін жігіт〉
Dialogue: 0,0:18:50.50,0:18:53.96,Default,,0,0,0,,Сіз не айттыңыз? Мен француз тілін жақсы түсінбеймін.
Dialogue: 0,0:18:54.09,0:18:55.71,Default,,0,0,0,,«Қуырылған сиыр жігіті»
Dialogue: 0,0:18:55.84,0:18:57.26,Default,,0,0,0,,Теледидар
Dialogue: 0,0:18:57.38,0:19:00.26,Default,,0,0,0,,А, бұл ағылшын арнасы еді ғой?
Dialogue: 0,0:19:00.38,0:19:02.85,Default,,0,0,0,,Бұл картинаның құны 20 миллион еуро болды.
Dialogue: 0,0:19:03.01,0:19:04.05,Default,,0,0,0,,Ni!
Dialogue: 0,0:19:04.72,0:19:06.10,Default,,0,0,0,,20 миллион...
Dialogue: 0,0:19:07.18,0:19:10.85,Default,,0,0,0,,Монтойя менің сүйікті суретшілерімнің бірі.
Dialogue: 0,0:19:11.10,0:19:12.15,Default,,0,0,0,,«Лондондағы қар»
Dialogue: 0,0:19:12.27,0:19:14.77,Default,,0,0,0,,Бұл менің көп жылдар бойы іздеген шығармам еді.
Dialogue: 0,0:19:14.90,0:19:18.03,Default,,0,0,0,,Бақытымызға орай, мен аукционшымын
Dialogue: 0,0:19:18.15,0:19:19.70,Default,,0,0,0,,Сондай-ақ өнер дилері болып жұмыс істейді
Dialogue: 0,0:19:20.53,0:19:24.28,Default,,0,0,0,,Мен бұл туындыны бір күні аукционда көрсете аламын деп ойлаймын.
Dialogue: 0,0:19:24.41,0:19:25.87,Default,,0,0,0,,Бізбен бірге болыңыз
Dialogue: 0,0:19:26.37,0:19:28.58,Default,,0,0,0,,Қандай қателік!
Dialogue: 0,0:19:28.70,0:19:33.29,Default,,0,0,0,,Құны 20 миллион иен болатын картинаны 20 000 иенге сату – қызмет көрсету рухының тамаша үлгісі.
Dialogue: 0,0:19:33.42,0:19:34.92,Default,,0,0,0,,Қалағаныңды айт
Dialogue: 0,0:19:35.04,0:19:38.05,Default,,0,0,0,,Терезені жабыңыз, мен сергек боламын.
Dialogue: 0,0:19:38.46,0:19:41.97,Default,,0,0,0,,Синтия мен Эбби бар Зама деген не?
Dialogue: 0,0:19:42.09,0:19:44.60,Default,,0,0,0,,Мен оның айтқанын орындадым.
Dialogue: 0,0:19:44.72,0:19:47.64,Default,,0,0,0,,Мақсатты дұрыс зерттемегенім үшін кінәлімін.
Dialogue: 0,0:19:47.76,0:19:51.94,Default,,0,0,0,,Сол картинаның суретшісі белгісіз суретші екенін айтқан адам
Dialogue: 0,0:19:52.06,0:19:53.65,Default,,0,0,0,,Ол қайда және кім болды?
Dialogue: 0,0:19:53.77,0:19:55.27,Default,,0,0,0,,Сіз ұмыттыңыз.
Dialogue: 0,0:19:56.23,0:19:58.53,Default,,0,0,0,,Лоран Мен не істеуім керек?
Dialogue: 0,0:19:58.98,0:20:02.28,Default,,0,0,0,,Бас тарту. Сатылған нәрсеге қатысты ештеңе істей алмайсыз.
Dialogue: 0,0:20:02.40,0:20:03.36,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:20:03.49,0:20:05.99,Default,,0,0,0,,Жақсы, ол 25 000-ға сатылды.
Dialogue: 0,0:20:06.12,0:20:07.78,Default,,0,0,0,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:20:08.16,0:20:11.25,Default,,0,0,0,,Мен Мари мен қартқа қарсы тұра алмаймын.
Dialogue: 0,0:20:11.50,0:20:12.62,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:20:12.87,0:20:14.75,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:20:15.96,0:20:16.96,Default,,0,0,0,,Қый!
Dialogue: 0,0:20:17.09,0:20:19.71,Default,,0,0,0,,Шешілді! Мен оны қайтарамын
Dialogue: 0,0:20:19.84,0:20:23.88,Default,,0,0,0,,Біз тұрғанда оны жойып жіберейік.
Dialogue: 0,0:20:24.30,0:20:25.34,Default,,0,0,0,,Қираған ба?
Dialogue: 0,0:20:25.47,0:20:27.39,Default,,0,0,0,,Мақсат - Джеймс Коулман.
Dialogue: 0,0:20:27.89,0:20:32.39,Default,,0,0,0,,Өнер әлемінің 007-сі ретінде белгілі, Ұлыбританиядағы жетекші аукционшылардың бірі
Dialogue: 0,0:20:32.98,0:20:35.65,Default,,0,0,0,,Әлемдегі ең жақсы бағалаушы және өнер дилері
Dialogue: 0,0:20:36.06,0:20:39.65,Default,,0,0,0,,Ал алаяқ пен жалған мырза.
Dialogue: 0,0:20:40.07,0:20:41.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:43.95,0:20:46.41,Default,,0,0,0,,Бірдеңе болды.
Dialogue: 0,0:20:46.78,0:20:50.62,Default,,0,0,0,,Қуырамыз~
Dialogue: 0,0:20:50.99,0:20:57.00,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.86,0:22:50.86,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.36,0:22:58.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory