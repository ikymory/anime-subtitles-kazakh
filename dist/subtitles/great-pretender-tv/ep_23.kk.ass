Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:03.33,Default,,0,0,0,,Ай!
Dialogue: 0,0:00:09.55,0:00:10.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:10.51,0:00:11.51,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:00:11.72,0:00:12.55,Default,,0,0,0,,Хаа…
Dialogue: 0,0:00:12.67,0:00:19.22,Default,,0,0,0,,(ағаштың жарылған дыбысы)
Dialogue: 0,0:00:33.45,0:00:34.28,Default,,0,0,0,,Хаа…
Dialogue: 0,0:00:39.28,0:00:40.16,Default,,0,0,0,,(жану дыбысы жеңілірек)
Dialogue: 0,0:00:41.54,0:00:43.00,Default,,0,0,0,,Хаа~
Dialogue: 0,0:00:44.54,0:00:50.96,Default,,0,0,0,,(теңіз құстарының айқайы)
Dialogue: 0,0:00:51.71,0:00:55.05,Default,,0,0,0,,Хмм... ой...
Dialogue: 0,0:00:56.76,0:00:57.59,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:59.43,0:01:00.72,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:01:00.93,0:01:02.02,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:01:02.43,0:01:03.39,Default,,0,0,0,,Хаа…
Dialogue: 0,0:01:04.43,0:01:07.10,Default,,0,0,0,,Көмек!
Dialogue: 0,0:01:07.31,0:01:12.40,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:01:12.61,0:01:13.86,Default,,0,0,0,,Пури...!
Dialogue: 0,0:01:14.36,0:01:20.37,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:12.88,0:02:18.88,Default,,0,0,0,,~♪
Dialogue: 0,0:02:19.59,0:02:21.89,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:02:23.68,0:02:24.51,Default,,0,0,0,,Uhu…
Dialogue: 0,0:02:24.97,0:02:26.56,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:27.23,0:02:28.89,Default,,0,0,0,,Ол ояу болды ма?
Dialogue: 0,0:02:29.19,0:02:31.44,Default,,0,0,0,,Иә, кір жуғаныңызға рахмет.
Мен оны алуға бардым
Dialogue: 0,0:02:31.56,0:02:32.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:32.69,0:02:34.44,Default,,0,0,0,,.
Dialogue: 0,0:02:34.57,0:02:36.69,Default,,0,0,0,,Кептіргіштен рұқсатсыз шығарылған.
Dialogue: 0,0:02:37.15,0:02:39.36,Default,,0,0,0,,Сәл күтсеңіз жақсы ма?
Dialogue: 0,0:02:39.86,0:02:41.78,Default,,0,0,0,,Уақытында болмадыңыз ба?
Dialogue: 0,0:02:42.24,0:02:44.91,Default,,0,0,0,,Ол бірнеше минутқа ғана кешігіп келді.
Dialogue: 0,0:02:45.03,0:02:46.87,Default,,0,0,0,,Өйткені, бұл пойыз емес.
Dialogue: 0,0:02:47.00,0:02:48.08,Default,,0,0,0,,Фу…
Dialogue: 0,0:02:48.20,0:02:51.08,Default,,0,0,0,,Қызықсыз нәрселерден тітіркеніп қалсаңыз, шаршамайсыз ба?
Dialogue: 0,0:02:52.96,0:02:56.59,Default,,0,0,0,,«Кешірімді жүрек» деп тағы айтқыңыз келетін шығар?
Dialogue: 0,0:02:56.71,0:02:59.42,Default,,0,0,0,,
Dialogue: 0,0:02:59.55,0:03:01.93,Default,,0,0,0,,Қараңдаршы, мен ерініп, сөйлесемін.
Dialogue: 0,0:03:08.85,0:03:12.60,Default,,0,0,0,,Сиқыршының не істей алатынын білесіз бе?
Dialogue: 0,0:03:13.48,0:03:16.77,Default,,0,0,0,,Қорқақ қызды көңілді кемпірге айналдыру
Dialogue: 0,0:03:17.23,0:03:18.90,Default,,0,0,0,,Төсекте жатқан науқас адам
Dialogue: 0,0:03:19.03,0:03:21.99,Default,,0,0,0,,Ол мені төсегіммен бірге әлемді аралауға апарды.
Dialogue: 0,0:03:22.36,0:03:24.03,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,0:03:24.16,0:03:26.83,Default,,0,0,0,,Хехе... Түсімде үнемі пайда болады.
Dialogue: 0,0:03:28.08,0:03:31.00,Default,,0,0,0,,Оны басқа балалармен бірге көрсетіңіз.
Dialogue: 0,0:03:31.54,0:03:32.79,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:03:34.21,0:03:36.17,Default,,0,0,0,,Біз тағы кездесеміз.
Dialogue: 0,0:03:36.54,0:03:37.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:42.34,0:03:43.38,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:45.47,0:03:47.01,Default,,0,0,0,,Шебер...
Dialogue: 0,0:03:47.47,0:03:48.31,Default,,0,0,0,,(кранның ашылған дыбысы)
Dialogue: 0,0:03:51.68,0:03:52.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:52.94,0:03:53.77,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:54.02,0:03:56.65,Default,,0,0,0,,Не... Жоқ, сен!
Dialogue: 0,0:03:57.27,0:03:58.44,Default,,0,0,0,,Айналма жол
Dialogue: 0,0:03:59.40,0:04:00.74,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:04:02.61,0:04:04.86,Default,,0,0,0,,«Гравитациядан босатылған»
Dialogue: 0,0:04:04.99,0:04:09.49,Default,,0,0,0,,«Ренжден, қызғаныштан және осының бәрінен аулақ бол».
Dialogue: 0,0:04:09.91,0:04:11.50,Default,,0,0,0,,Бұл сіз айтқан сөздер.
Dialogue: 0,0:04:13.29,0:04:16.63,Default,,0,0,0,,Кімді алдасаң да, сатсаң да, ол сенің еркіндігің.
Dialogue: 0,0:04:17.21,0:04:18.71,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз
Dialogue: 0,0:04:20.21,0:04:21.05,Default,,0,0,0,,Тек...
Dialogue: 0,0:04:22.22,0:04:23.59,Default,,0,0,0,,Өзіңізді кешіріңіз
Dialogue: 0,0:04:25.09,0:04:27.43,Default,,0,0,0,,Бұл мені құтқарды
Dialogue: 0,0:04:27.55,0:04:28.68,Default,,0,0,0,,(секіру дыбысы)
Dialogue: 0,0:04:33.23,0:04:36.60,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:04:39.48,0:04:40.69,Default,,0,0,0,,(Бұрылу тетігінің дыбысы)
Dialogue: 0,0:04:55.50,0:04:58.00,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:04:58.71,0:04:59.92,Default,,0,0,0,,Уәде етілгендей
Dialogue: 0,0:05:00.04,0:05:02.01,Default,,0,0,0,,Мен саған оның бұралған түрін көрсетемін.
Dialogue: 0,0:05:02.26,0:05:03.76,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:05:03.88,0:05:06.72,Default,,0,0,0,,Мен оны өз қолыммен тұншықтырып өлтіргім келді.
Dialogue: 0,0:05:06.93,0:05:08.47,Default,,0,0,0,,Бұл ережелерге қайшы
Dialogue: 0,0:05:08.97,0:05:11.89,Default,,0,0,0,,Сіз бұрын ұсынған сыйақы үшін ақы алатыныңызды айтқан жоқсыз ба?
Dialogue: 0,0:05:12.47,0:05:15.60,Default,,0,0,0,,Ал, бұл жолы мен сені жақтаймын.
Dialogue: 0,0:05:16.10,0:05:18.77,Default,,0,0,0,,Өйткені, бұл бизнес.
Dialogue: 0,0:05:18.90,0:05:20.02,Default,,0,0,0,,Көтеру
Dialogue: 0,0:05:20.19,0:05:22.65,Default,,0,0,0,,Жас әйелдер болмаса, өтіңіз.
Dialogue: 0,0:05:22.82,0:05:24.74,Default,,0,0,0,,Әңгімені кейінірек айтып бер.
Dialogue: 0,0:05:24.86,0:05:25.70,Default,,0,0,0,,Олар Жапонияда, анамды күтіп, оны қауіпсіз ұстап отыр ➡
Dialogue: 0,0:05:26.15,0:05:27.61,Default,,0,0,0,,Оң жақпен бірдей
Dialogue: 0,0:05:27.91,0:05:30.33,Default,,0,0,0,,Мен көмектесу үшін ештеңе істей алмаймын.
Dialogue: 0,0:05:30.66,0:05:31.66,Default,,0,0,0,,Көбірек көтеру!
Dialogue: 0,0:05:32.12,0:05:33.75,Default,,0,0,0,,Түскіңіз келсе, дәл қазір.
Dialogue: 0,0:05:33.87,0:05:35.20,Default,,0,0,0,,Ха~хахахаха
Dialogue: 0,0:05:35.33,0:05:36.75,Default,,0,0,0,,Қызықты балалар
Dialogue: 0,0:05:36.87,0:05:38.21,Default,,0,0,0,,Әрі қарай көтеру
Dialogue: 0,0:05:38.33,0:05:39.17,Default,,0,0,0,,Олар Жапонияда, анамды күтіп, оны қауіпсіз ұстап отыр ➡
Dialogue: 0,0:05:39.50,0:05:40.84,Default,,0,0,0,,Ал, бүгін кешке.
Dialogue: 0,0:05:40.96,0:05:41.79,Default,,0,0,0,,(Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,0:05:43.34,0:05:45.38,Default,,0,0,0,,Біз оған шынымен де қол жеткіздік.
Есептік жазбаңызда
Dialogue: 0,0:05:46.51,0:05:49.18,Default,,0,0,0,,100 миллиард дайын
Dialogue: 0,0:05:49.59,0:05:50.64,Default,,0,0,0,,Лю және басқалары ше?
Dialogue: 0,0:05:51.10,0:05:52.22,Default,,0,0,0,,Токиоға бару
Dialogue: 0,0:05:55.68,0:05:57.56,Default,,0,0,0,,Олар түнгі үкілер.
Dialogue: 0,0:05:59.98,0:06:03.69,Default,,0,0,0,,Мен бұршақты қайтадан ауыстырып көрдім, бірақ бұл менің дәміме сәйкес келетінін білмеймін.
Dialogue: 0,0:06:11.78,0:06:15.41,Default,,0,0,0,,Шынымды айтсам, мен ешқашан кофе ішкен емеспін.
Dialogue: 0,0:06:15.79,0:06:16.62,Default,,0,0,0,,Е...
Dialogue: 0,0:06:16.91,0:06:19.33,Default,,0,0,0,,Бірақ жасағандарың дәмді болады.
Dialogue: 0,0:06:20.17,0:06:21.71,Default,,0,0,0,,Мен сені ұната бастадым
Dialogue: 0,0:06:24.30,0:06:25.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:26.76,0:06:28.26,Default,,0,0,0,,Исигами мырза, өтінемін.
Dialogue: 0,0:06:28.47,0:06:30.84,Default,,0,0,0,,Не? Мен кофені ұнатпаймын
Dialogue: 0,0:06:30.97,0:06:32.39,Default,,0,0,0,,Кафе ау лайт болсын
Dialogue: 0,0:06:57.50,0:06:59.00,Default,,0,0,0,,Барлығы қатты ұйықтап жатыр.
Dialogue: 0,0:07:00.16,0:07:02.25,Default,,0,0,0,,Мен ойлағаннан да жақсы ұйықтадым.
Dialogue: 0,0:07:03.42,0:07:05.17,Default,,0,0,0,,〈Жергілікті жерде не болып жатыр? 〉
Dialogue: 0,0:07:05.80,0:07:08.05,Default,,0,0,0,,<Созақудың штаб-пәтерінің айналасы қатайтылып қойған>
Dialogue: 0,0:07:08.34,0:07:12.64,Default,,0,0,0,,〈    〉
Dialogue: 0,0:07:12.76,0:07:14.85,Default,,0,0,0,,〈Жарайды, мына сақинадағы сарысу қандай? 〉
Dialogue: 0,0:07:15.68,0:07:18.39,Default,,0,0,0,,<Аа, Лоранның бейбақы, қамқорлық жасаңыз.>
Dialogue: 0,0:07:18.52,0:07:20.81,Default,,0,0,0,,〈Ол жерге жеткенде〉
Dialogue: 0,0:07:20.94,0:07:22.27,Default,,0,0,0,,〈Сізге алкоголь ұсынса да, оған қол тигізбеңіз〉
Dialogue: 0,0:07:22.44,0:07:25.40,Default,,0,0,0,,<Саса қазір өмір суы>
Dialogue: 0,0:07:31.86,0:07:33.87,Default,,0,0,0,,〈О, қатты ішетін адам күткендей! 〉
Dialogue: 0,0:07:34.03,0:07:35.07,Default,,0,0,0,,〈Тағы да бар! 〉
Dialogue: 0,0:07:40.16,0:07:41.37,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:42.08,0:07:44.33,Default,,0,0,0,,Мен ұшақта тым көп ішіп алдым деп ойлаймын.
Dialogue: 0,0:07:45.00,0:07:46.63,Default,,0,0,0,,
Dialogue: 0,0:07:46.75,0:07:48.92,Default,,0,0,0,,Мені әлі де көлік алып кеткенін қаламаймын.
Dialogue: 0,0:07:49.55,0:07:51.17,Default,,0,0,0,,Барлығыңызға кофе іше аласыз ба?
Dialogue: 0,0:07:52.34,0:07:54.72,Default,,0,0,0,,
Dialogue: 0,0:07:57.18,0:07:58.89,Default,,0,0,0,,Мен оны алып жүрейін бе?
Dialogue: 0,0:08:05.73,0:08:06.81,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:08:07.19,0:08:11.11,Default,,0,0,0,,Жол бос емес, сондықтан мен төте жолды аламын.
Dialogue: 0,0:08:11.99,0:08:13.40,Default,,0,0,0,,Тышқан қақпанына сақ болыңыз
Dialogue: 0,0:08:13.53,0:08:14.36,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:27.00,0:08:27.84,Default,,0,0,0,,(Жан) Д… Жоқ, басқа нәрсе. Қара, ол сонда тұр.
Dialogue: 0,0:08:27.96,0:08:30.17,Default,,0,0,0,,Біраз уақыт өтті
Dialogue: 0,0:08:30.38,0:08:32.67,Default,,0,0,0,,Сәлем Шого, мен саған қамқор боламын.
Dialogue: 0,0:08:33.13,0:08:34.97,Default,,0,0,0,,Жарайды, бастайық!
Dialogue: 0,0:08:35.22,0:08:36.39,Default,,0,0,0,,О!
Dialogue: 0,0:08:36.51,0:08:39.60,Default,,0,0,0,,
Dialogue: 0,0:08:41.14,0:08:43.73,Default,,0,0,0,,Мен де шұғыл тамақ дайындадым.
Dialogue: 0,0:08:43.85,0:08:45.23,Default,,0,0,0,,Күткендей!
Dialogue: 0,0:09:17.80,0:09:19.51,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:09:19.64,0:09:21.26,Default,,0,0,0,,Олар келе жатыр!
Dialogue: 0,0:09:21.39,0:09:22.31,Default,,0,0,0,,Oz!
Dialogue: 0,0:09:22.72,0:09:24.77,Default,,0,0,0,,Мазасыз бірдеңе айта бастаған шығарсыз!
Dialogue: 0,0:09:24.89,0:09:26.69,Default,,0,0,0,,Бетіңізді алға қаратып, қолыңызды қозғаңыз.
Dialogue: 0,0:09:26.81,0:09:27.65,Default,,0,0,0,,Тс!
Dialogue: 0,0:09:28.10,0:09:29.23,Default,,0,0,0,,Рас
Dialogue: 0,0:09:29.36,0:09:33.07,Default,,0,0,0,,Эдамаме маған Роппонгиді де бояуымды айтсын.
Dialogue: 0,0:09:33.19,0:09:34.94,Default,,0,0,0,,Уақыт өте нашарлаған түстер
Dialogue: 0,0:09:35.07,0:09:38.11,Default,,0,0,0,,Мен оны қайта шығаруға мүмкіндік жоқ, сондықтан менің таңдауым жоқ!
Dialogue: 0,0:09:38.32,0:09:40.99,Default,,0,0,0,,Синтия! Ол сонда болды ма?
Dialogue: 0,0:09:41.12,0:09:42.33,Default,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:09:42.58,0:09:44.08,Default,,0,0,0,,Сіз бәрібір байқамайсыз
Dialogue: 0,0:09:44.91,0:09:45.79,Default,,0,0,0,,Әлі де орындық!
Dialogue: 0,0:09:45.91,0:09:47.12,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:09:47.33,0:09:49.63,Default,,0,0,0,,Мен соңғы сәтте орындық ауыстырғанын естіген емеспін!
Dialogue: 0,0:09:50.00,0:09:51.84,Default,,0,0,0,,Қылыш жасанды болуы керек емес пе?
Dialogue: 0,0:09:51.96,0:09:53.38,Default,,0,0,0,,Шынайы болыңыз!
Dialogue: 0,0:09:53.59,0:09:54.92,Default,,0,0,0,,Не? Сен ақымақсың ба?
Dialogue: 0,0:09:55.05,0:09:56.22,Default,,0,0,0,,Әкемнің тікұшағы келе жатыр.
Dialogue: 0,0:09:56.38,0:09:57.68,Default,,0,0,0,,Эвакуацияға дайындалу Асығыңыз!
Dialogue: 0,0:09:57.80,0:09:59.55,Default,,0,0,0,,Өйткені соңында бір ғана лифт жұмыс істейді.
Dialogue: 0,0:10:00.30,0:10:01.64,Default,,0,0,0,,Бәріміз бірге түсейік!
Dialogue: 0,0:10:01.76,0:10:02.60,Default,,0,0,0,,Әй, асығыңыз!
Dialogue: 0,0:10:02.72,0:10:03.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:04.27,0:10:05.18,Default,,0,0,0,,Мен онымен екеуміз ғана, бір рет болса да сөйлескенді қатты қалаймын. Хехе.
Dialogue: 0,0:10:05.77,0:10:06.68,Default,,0,0,0,,Төраға!
Dialogue: 0,0:10:08.27,0:10:09.35,Default,,0,0,0,,Біз келдік.
Dialogue: 0,0:10:09.65,0:10:11.81,Default,,0,0,0,,Исигами мырза да (Ишигами) Ха!
Dialogue: 0,0:10:14.53,0:10:15.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:15.74,0:10:17.03,Default,,0,0,0,,Жоғарыдан келді ме?
Dialogue: 0,0:10:17.15,0:10:18.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:18.36,0:10:19.24,Default,,0,0,0,,Артқа қайту Артқа қайту!
Dialogue: 0,0:10:19.36,0:10:22.74,Default,,0,0,0,,(шу)
Dialogue: 0,0:10:23.99,0:10:25.70,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:10:28.54,0:10:30.67,Default,,0,0,0,,Менің басым ауыр болып тұр.
Dialogue: 0,0:10:31.13,0:10:33.38,Default,,0,0,0,,Менің ойымша, сіз аздап шаршаған шығарсыз.
Dialogue: 0,0:10:34.00,0:10:35.25,Default,,0,0,0,,Екеуі сол бөлмеде.
Dialogue: 0,0:10:35.42,0:10:36.26,Default,,0,0,0,,Иә
Dialogue: 0,0:10:39.63,0:10:40.76,Default,,0,0,0,,(электрондық құлыпты ашу дыбысы)
Dialogue: 0,0:10:40.89,0:10:42.22,Default,,0,0,0,,Бұл қандай мүсінше?
Dialogue: 0,0:10:42.35,0:10:43.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:43.39,0:10:44.35,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:44.47,0:10:45.31,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:45.43,0:10:46.72,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:10:46.85,0:10:49.27,Default,,0,0,0,,Егер сізге ұнамаса, біз оны кәдеге жаратамыз.
Dialogue: 0,0:10:51.77,0:10:52.61,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:53.11,0:10:54.23,Default,,0,0,0,,Оны сол күйінде қалдырыңыз.
Dialogue: 0,0:10:57.65,0:10:58.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:23.22,0:11:25.60,Default,,0,0,0,,Лоран Мен оны көріп тұрмын
Dialogue: 0,0:11:33.31,0:11:35.98,Default,,0,0,0,,Менің сүйкімді эдамама сәлем айтыңыз
Dialogue: 0,0:11:36.11,0:11:36.94,Default,,0,0,0,,О
Dialogue: 0,0:11:46.45,0:11:48.58,Default,,0,0,0,,Ахаха, бұл керемет!
Dialogue: 0,0:11:57.96,0:12:00.55,Default,,0,0,0,,〈Екеуің де келдіңдер〉
Dialogue: 0,0:12:00.76,0:12:02.26,Default,,0,0,0,,Мен бұны бұрыннан-ақ есіме түсіріп қойдым, білесің бе.
Dialogue: 0,0:12:03.47,0:12:04.64,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:04.80,0:12:05.80,Default,,0,0,0,,Мен сені алып келдім
Dialogue: 0,0:12:11.31,0:12:16.23,Default,,0,0,0,,(кездейсоқ ату дыбысы)
Dialogue: 0,0:12:16.36,0:12:17.19,Default,,0,0,0,,(электрондық құлыпты құлыптау дыбысы)
Dialogue: 0,0:12:17.48,0:12:20.11,Default,,0,0,0,,Нуоооо~ Мені атып тастады!
Dialogue: 0,0:12:20.23,0:12:21.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:22.03,0:12:24.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:24.28,0:12:26.03,Default,,0,0,0,,Аха~! Ахахаха~!
Dialogue: 0,0:12:26.57,0:12:27.62,Default,,0,0,0,,Гааах!
Dialogue: 0,0:12:27.83,0:12:30.33,Default,,0,0,0,,Жақсырақ жол бар.
Dialogue: 0,0:12:31.75,0:12:34.12,Default,,0,0,0,,Бұл маған әкемнен қалған нәрсе.
Dialogue: 0,0:12:34.50,0:12:36.50,Default,,0,0,0,,Эй, оны араластырма.
Dialogue: 0,0:12:36.63,0:12:40.38,Default,,0,0,0,,(кездейсоқ ату мен дүрбелең дыбыстары)
Dialogue: 0,0:12:44.43,0:12:45.26,Default,,0,0,0,,Надаба…
Dialogue: 0,0:12:45.59,0:12:46.97,Default,,0,0,0,,Түсіңіз!
Dialogue: 0,0:12:52.02,0:12:52.85,Default,,0,0,0,,(Тығынның тартылған дыбысы)
Dialogue: 0,0:12:53.10,0:12:54.52,Default,,0,0,0,,Чинг Чинг!
Dialogue: 0,0:12:54.64,0:12:57.61,Default,,0,0,0,,Бірақ бұл жолы мен шынымен таң қалдым.
Dialogue: 0,0:12:57.73,0:13:00.19,Default,,0,0,0,,Балалар сендерді күтпеген қонақ болады деп күтпедім.
Dialogue: 0,0:13:00.65,0:13:02.44,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:13:02.74,0:13:05.70,Default,,0,0,0,,Сэм мен Коулман да сені алдап кетті.
Dialogue: 0,0:13:06.16,0:13:09.83,Default,,0,0,0,,Мен Америкалық раундта Эддимен жұмыс істедім.
Dialogue: 0,0:13:09.95,0:13:11.91,Default,,0,0,0,,Ол өте сенімді адам.
Dialogue: 0,0:13:12.04,0:13:15.16,Default,,0,0,0,,Мен Монтойяның «Кисс» фильмін сатып алған тұтынушымын.
Dialogue: 0,0:13:15.29,0:13:17.12,Default,,0,0,0,,Содан бері қарым-қатынас
Dialogue: 0,0:13:17.33,0:13:20.88,Default,,0,0,0,,Әй, біз әзілдеп жатырмыз, әуре болма.
Dialogue: 0,0:13:21.17,0:13:23.96,Default,,0,0,0,,Ақша таппайды, Кек алуға қызықпаймын.
Dialogue: 0,0:13:24.09,0:13:26.72,Default,,0,0,0,,Бизнес - бұл бөлек әңгіме.
Dialogue: 0,0:13:26.84,0:13:29.76,Default,,0,0,0,,Мен жай ғана қатал сөйлейтін бағынушы мен реквизиттерді жалға алдым.
Dialogue: 0,0:13:29.89,0:13:31.14,Default,,0,0,0,,Ол байсалды болды ма?
Dialogue: 0,0:13:31.93,0:13:32.85,Default,,0,0,0,,О
Dialogue: 0,0:13:33.22,0:13:35.64,Default,,0,0,0,,Бірақ маған бір алаяқ айтты
Dialogue: 0,0:13:36.35,0:13:38.77,Default,,0,0,0,,«Өзіңді кешір»
Dialogue: 0,0:13:39.44,0:13:42.69,Default,,0,0,0,,Жоқ, бұл жалғыз себеп емес.
Dialogue: 0,0:13:43.15,0:13:46.40,Default,,0,0,0,,Бұл жігіт әрқашан маңызды нәрселер туралы айтпайды.
Dialogue: 0,0:13:46.53,0:13:48.11,Default,,0,0,0,,Дұрыс, бір-бірімізді оңаша қалдырайық.
Dialogue: 0,0:13:48.24,0:13:49.62,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:49.99,0:13:51.66,Default,,0,0,0,,Бірақ Лоран мырза
Dialogue: 0,0:13:51.78,0:13:54.37,Default,,0,0,0,,Сіз Эдамура мырзамен жақсы сәйкестендіңіз.
Dialogue: 0,0:13:55.08,0:13:57.12,Default,,0,0,0,,Оз семсермен бетпе-бет келгенде
Dialogue: 0,0:13:57.71,0:13:59.88,Default,,0,0,0,,Қан пакеті толық көрінеді.
Dialogue: 0,0:14:00.25,0:14:03.13,Default,,0,0,0,,Сен оны Озден көре аласың ба деп ойлап едім.
Dialogue: 0,0:14:03.25,0:14:04.42,Default,,0,0,0,,Осылайша
Dialogue: 0,0:14:04.55,0:14:06.38,Default,,0,0,0,,Сізге рахмет, мен жақсы көрдім.
Dialogue: 0,0:14:06.76,0:14:07.63,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:07.76,0:14:10.89,Default,,0,0,0,,Мен шынымен де Эдамура мырзаны толығымен жеңілді деп ойладым.
Dialogue: 0,0:14:11.72,0:14:14.43,Default,,0,0,0,,Ішімдегі бәрінен айырылып қала жаздадым.
Dialogue: 0,0:14:14.89,0:14:16.39,Default,,0,0,0,,Сізге рахмет, сіз өзіңізді сергек сезінесіз, солай емес пе?
Dialogue: 0,0:14:17.39,0:14:18.23,Default,,0,0,0,,Иә
Dialogue: 0,0:14:18.60,0:14:20.73,Default,,0,0,0,,Лоран, сен де.
Dialogue: 0,0:14:20.90,0:14:23.15,Default,,0,0,0,,Люға бір соққы беріңіз, өзіңізді сергітіңіз, солай ма?
Dialogue: 0,0:14:23.52,0:14:26.15,Default,,0,0,0,,А, өте жақсы сезінді.
Dialogue: 0,0:14:26.40,0:14:27.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:28.07,0:14:29.15,Default,,0,0,0,,Сонымен
Dialogue: 0,0:14:29.66,0:14:31.87,Default,,0,0,0,,Егін - ең жақсы!
Dialogue: 0,0:14:31.99,0:14:35.16,Default,,0,0,0,,Бұл бір тонна шегерім сияқты.
Dialogue: 0,0:14:50.47,0:14:52.55,Default,,0,0,0,,
Dialogue: 0,0:14:52.68,0:14:55.35,Default,,0,0,0,,Сол үш адаммен жарасып қалғаныма қуаныштымын.
Dialogue: 0,0:14:56.27,0:14:58.48,Default,,0,0,0,,Оның орнына электрондық поштаны жібердіңіз бе?
Dialogue: 0,0:14:58.60,0:14:59.52,Default,,0,0,0,,О
Dialogue: 0,0:14:59.73,0:15:02.23,Default,,0,0,0,,Сивон түсірген фильмін де қосыңыз.
Dialogue: 0,0:15:02.77,0:15:03.69,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:15:03.81,0:15:07.28,Default,,0,0,0,,Қалғаны ата-ана мен баланың күнделікті не істейтініне байланысты деп ойлаймын.
Dialogue: 0,0:15:07.48,0:15:08.94,Default,,0,0,0,,Қосымша…
Dialogue: 0,0:15:09.07,0:15:12.28,Default,,0,0,0,,Масато Масато!
Dialogue: 0,0:15:12.87,0:15:14.03,Default,,0,0,0,,Мен сені ұмытып кеттім.
Dialogue: 0,0:15:14.28,0:15:16.08,Default,,0,0,0,,Күнделікті әрекеттер...
Dialogue: 0,0:15:16.20,0:15:17.83,Default,,0,0,0,,Сен және Оз сияқты
Dialogue: 0,0:15:18.20,0:15:19.20,Default,,0,0,0,,Жалғыз қалдырыңыз
Dialogue: 0,0:15:21.25,0:15:23.21,Default,,0,0,0,,Аяғыңызды жуғаннан кейін не істейсіз?
Dialogue: 0,0:15:23.75,0:15:26.50,Default,,0,0,0,,Біз... Меніңше, солай.
Dialogue: 0,0:15:26.67,0:15:29.63,Default,,0,0,0,,Егер сіз кофені ұнатсаңыз, неге кафе ашпасқа?
Dialogue: 0,0:15:30.13,0:15:31.76,Default,,0,0,0,,Осы уақытқа дейін әлі жоқ.
Dialogue: 0,0:15:32.01,0:15:33.93,Default,,0,0,0,,Бірақ сіз дайындаған кофемен
Dialogue: 0,0:15:34.05,0:15:35.51,Default,,0,0,0,,Егер мен бәріне күлкі сыйлай алсам...
Dialogue: 0,0:15:35.64,0:15:37.51,Default,,0,0,0,,
Dialogue: 0,0:15:37.64,0:15:39.64,Default,,0,0,0,,Мен білмей тұрып, таң ата бастады.
Dialogue: 0,0:15:42.23,0:15:43.35,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:15:44.31,0:15:45.81,Default,,0,0,0,,Қалай болғанда да, мен жақында 15-ке толамын.
Dialogue: 0,0:15:57.66,0:15:59.08,Default,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,0:15:59.50,0:16:00.33,Default,,0,0,0,,(Чак!)
Dialogue: 0,0:16:23.94,0:16:25.31,Default,,0,0,0,,Сонымен
Dialogue: 0,0:16:25.44,0:16:27.65,Default,,0,0,0,,Масатоның бүлікшіл кезеңі аяқталды.
Dialogue: 0,0:16:28.69,0:16:30.90,Default,,0,0,0,,Мен сенен үндемеуіңді өтіндім.
Dialogue: 0,0:16:31.03,0:16:32.57,Default,,0,0,0,,Жақсы болды ма, жоқ па?
Dialogue: 0,0:16:34.11,0:16:35.03,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:16:35.20,0:16:39.58,Default,,0,0,0,,Біраз уақыт өзім бағып-қаққан балаларды бағып-қағумен айналысатын сияқтымын.
Dialogue: 0,0:16:40.37,0:16:45.21,Default,,0,0,0,,Егер мен барлығына патронаттық ата-ана таба алсам, Масатомен бірге сусын ішуге барамын деп ойлаймын.
Dialogue: 0,0:16:46.42,0:16:48.13,Default,,0,0,0,,Мені қарауды жалғастыра беріңіз.
Dialogue: 0,0:16:49.71,0:16:51.76,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:16:52.72,0:16:53.55,Default,,0,0,0,,Иә
Dialogue: 0,0:16:54.47,0:16:57.51,Default,,0,0,0,,Не, қазірден бастап? Ақымақ болма!
Dialogue: 0,0:16:57.85,0:17:00.31,Default,,0,0,0,,Бүгінгі күнді мереке ретінде қабылдап, Сеулде ішіңіз!
Dialogue: 0,0:17:00.43,0:17:01.27,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:17:01.39,0:17:02.60,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:17:02.73,0:17:04.27,Default,,0,0,0,,Йобосеё Йобосеё!
Dialogue: 0,0:17:04.64,0:17:07.19,Default,,0,0,0,,Цк, сен анау бейбақты кесіп тастадың.
Dialogue: 0,0:17:07.56,0:17:09.69,Default,,0,0,0,,<5 табақ кармегуисал қосылды! 〉
Dialogue: 0,0:17:09.82,0:17:10.98,Default,,0,0,0,,<Мен түсіндім>
Dialogue: 0,0:17:11.61,0:17:14.95,Default,,0,0,0,,Керісінше, мені тыңдаңыз.
Dialogue: 0,0:17:15.07,0:17:18.82,Default,,0,0,0,,Әй, ажырасқан әйелімен жабысқан қыз.
Dialogue: 0,0:17:19.20,0:17:21.08,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:17:21.29,0:17:24.41,Default,,0,0,0,,Ол кішкентай кезінде сүйкімді болған.
Dialogue: 0,0:17:24.71,0:17:27.08,Default,,0,0,0,,Мен сізбен қазір де байланыса алмаймын.
Dialogue: 0,0:17:27.58,0:17:29.33,Default,,0,0,0,,Мен сізге кеңес беремін.
Dialogue: 0,0:17:29.54,0:17:30.38,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:17:30.50,0:17:31.34,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:17:31.46,0:17:32.30,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:17:34.80,0:17:35.84,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:17:37.26,0:17:40.30,Default,,0,0,0,,-да? Сіз әлі мансап жолын таңдадыңыз ба?
Dialogue: 0,0:17:40.72,0:17:41.97,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:17:42.26,0:17:45.73,Default,,0,0,0,,Егер сіз университетке түскіңіз келсе, дұрыс оқу бағдарламасынан өтуіңіз керек.
Dialogue: 0,0:17:46.98,0:17:48.15,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:48.27,0:17:50.69,Default,,0,0,0,,Шынымды айтсам, бұл мені алаңдатпайды.
Dialogue: 0,0:17:51.44,0:17:54.07,Default,,0,0,0,,Сен шешесің, Кавин.
Dialogue: 0,0:18:02.58,0:18:03.54,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:18:07.16,0:18:08.37,Default,,0,0,0,,Бұл менің інім.
Dialogue: 0,0:18:08.50,0:18:10.00,Default,,0,0,0,,Бұл біраз дәріптелді.
Dialogue: 0,0:18:17.51,0:18:18.84,Default,,0,0,0,,Маған мынаны беріңізші
Dialogue: 0,0:18:19.09,0:18:20.09,Default,,0,0,0,,Майдо бар
Dialogue: 0,0:18:28.69,0:18:29.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:30.65,0:18:32.31,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:18:38.20,0:18:39.03,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:41.07,0:18:42.70,Default,,0,0,0,,<Бұл Эдамура-кун ма? 〉
Dialogue: 0,0:18:42.99,0:18:44.33,Default,,0,0,0,,〈Осыдан кейін не істейміз? 〉
Dialogue: 0,0:18:44.45,0:18:47.20,Default,,0,0,0,,Мен осы жердегі кофелерді салыстырып көргім келеді.
Dialogue: 0,0:18:47.54,0:18:50.21,Default,,0,0,0,,〈Аа, бәрі дәмді〉
Dialogue: 0,0:18:50.33,0:18:53.88,Default,,0,0,0,,〈Оппа, Америка тізімнің басында.〉
Dialogue: 0,0:18:54.00,0:18:55.38,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:18:55.50,0:18:57.42,Default,,0,0,0,,<Мен бұл жігітті бір жерден көрдім...>
Dialogue: 0,0:18:57.80,0:18:58.63,Default,,0,0,0,,Иә
Dialogue: 0,0:18:59.38,0:19:01.68,Default,,0,0,0,,Ақыр соңында, қысқа ұзындықтар сізге жақсырақ жарасады.
Dialogue: 0,0:19:02.55,0:19:05.10,Default,,0,0,0,,Біздің ең жақсы күш-жігеріміз және
Dialogue: 0,0:19:05.22,0:19:07.14,Default,,0,0,0,,Өз қабілетіне сенетін жүрек...
Dialogue: 0,0:19:07.52,0:19:10.10,Default,,0,0,0,,Міне, сіз биікке көтерілдіңіз.
Dialogue: 0,0:19:10.85,0:19:13.73,Default,,0,0,0,,Ол қазіргі Хидейоши ме?
Dialogue: 0,0:19:14.11,0:19:16.07,Default,,0,0,0,,Тағы да керемет болады
Dialogue: 0,0:19:16.36,0:19:18.90,Default,,0,0,0,,Баршаңызға Алла разы болсын.
Dialogue: 0,0:19:19.07,0:19:19.90,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:20.82,0:19:27.37,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:19:28.00,0:19:31.25,Default,,0,0,0,,Ей, жалығып кете жаздадың ғой?
Dialogue: 0,0:19:32.00,0:19:38.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:21:27.82,0:21:31.83,Default,,0,0,0,,~♪
Dialogue: 0,0:21:39.46,0:21:41.50,Default,,0,0,0,,<Иә? Бұл не?
Dialogue: 0,0:21:41.88,0:21:42.92,Default,,0,0,0,,〈Не болды? 〉
Dialogue: 0,0:21:43.42,0:21:45.42,Default,,0,0,0,,〈балықтың қарнынан шықты〉
Dialogue: 0,0:21:45.92,0:21:47.55,Default,,0,0,0,,〈Мұндай нәрсені қайдан алдың?〉
Dialogue: 0,0:21:48.05,0:21:49.18,Default,,0,0,0,,〈Жоқ.〉
Dialogue: 0,0:21:49.51,0:21:51.76,Default,,0,0,0,,<Әй, шай ішейік! 〉
Dialogue: 0,0:21:53.43,0:21:54.81,Default,,0,0,0,,<Әй, әке>
Dialogue: 0,0:21:55.23,0:21:58.40,Default,,0,0,0,,<Соңғы уақытта мен есте сақтау қабілетім анық бола бастағандай сезінемін>
Dialogue: 0,0:21:58.77,0:22:01.40,Default,,0,0,0,,<Бұл қайтадан Эфиопия ма? 〉
Dialogue: 0,0:22:01.94,0:22:04.19,Default,,0,0,0,,<Мен мұны бұрын айттым ба? 〉
Dialogue: 0,0:22:04.53,0:22:08.32,Default,,0,0,0,,<Бұған дейін мен саябақтың бас директорының хатшысы болдым.>
Dialogue: 0,0:22:08.53,0:22:10.41,Default,,0,0,0,,<Аха, сен солай айттың ба? 〉
Dialogue: 0,0:22:10.78,0:22:12.53,Default,,0,0,0,,〈Бұл әлі де көп уақыт алатын сияқты〉
Dialogue: 0,0:22:12.66,0:22:14.58,Default,,0,0,0,,〈Ей, қария! 〉
Dialogue: 0,0:22:14.87,0:22:15.79,Default,,0,0,0,,〈Иә〉
Dialogue: 0,0:22:15.91,0:22:17.29,Default,,0,0,0,,〈Шаншан бұл〉
Dialogue: 0,0:22:18.50,0:22:19.37,Default,,0,0,0,,<Сақина? 〉
Dialogue: 0,0:22:19.88,0:22:22.63,Default,,0,0,0,,〈Ол балықтың қарнынан шықты〉
Dialogue: 0,0:22:22.79,0:22:24.88,Default,,0,0,0,,〈Хмм, рахмет〉
Dialogue: 0,0:22:25.26,0:22:27.26,Default,,0,0,0,,〈Ой, жаңбыр тоқтады〉
Dialogue: 0,0:22:27.38,0:22:28.47,Default,,0,0,0,,Уау~
Dialogue: 0,0:22:29.97,0:22:33.51,Default,,0,0,0,,<Менің ойымша, бұл бұрынғыдай жақсы.>
Dialogue: 0,0:22:33.68,0:22:34.97,Default,,0,0,0,,〈Иә〉
Dialogue: 0,0:22:35.31,0:22:37.10,Default,,0,0,0,,<Асығудың қажеті жоқ>
Dialogue: 0,0:22:38.02,0:22:40.90,Default,,0,0,0,,Ай!
Dialogue: 0,0:22:45.82,0:22:47.40,Default,,0,0,0,,Уау~
Dialogue: 0,0:22:48.70,0:22:50.24,Default,,0,0,0,,жеткілікті.
Dialogue: 0,0:22:51.74,0:22:57.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory