Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.25,0:00:05.25,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:00:07.50,0:00:11.88,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:00:12.09,0:00:13.51,Default,,0,0,0,,(Түрту дыбысы)
Dialogue: 0,0:00:14.76,0:00:17.05,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:00:19.01,0:00:19.85,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:00:23.02,0:00:24.39,Default,,0,0,0,,Өлім мерейтойы?
Dialogue: 0,0:00:27.52,0:00:30.53,Default,,0,0,0,,Қабірді зиярат етуді әлсіретіп алғаным үшін кешірім сұраймын.
Dialogue: 0,0:00:31.15,0:00:33.36,Default,,0,0,0,,Өйткені, көп нәрсе болды.
Dialogue: 0,0:00:38.32,0:00:39.20,Default,,0,0,0,,Жарайды
Dialogue: 0,0:00:39.33,0:00:40.70,Default,,0,0,0,,Мен саған бәрін айтамын, мені тыңда.
Dialogue: 0,0:00:46.96,0:00:49.96,Default,,0,0,0,,Бұл қайғылы оқиға, бірақ анам жоғалып кеткеннен бері.
Dialogue: 0,0:00:50.84,0:00:53.67,Default,,0,0,0,,Қарттарды, жақсы адамдарды алдап жүрді.
Dialogue: 0,0:00:57.09,0:00:58.09,Default,,0,0,0,,Бір күні, Лоран
Dialogue: 0,0:00:58.22,0:01:01.14,Default,,0,0,0,,Мен жирен, тәкаппар және ұнамсыз французды кездестірдім.
Dialogue: 0,0:01:01.89,0:01:04.27,Default,,0,0,0,,Барлығы «Аққұба қаншық» дейді
Dialogue: 0,0:01:06.31,0:01:10.15,Default,,0,0,0,,-де мен оны мазақ еткім келді, бірақ ол мені келеке етті.
Dialogue: 0,0:01:14.57,0:01:17.53,Default,,0,0,0,,Мен мұны білмей тұрып, өз міндеттерімнің бірін орындауға тура келді.
Dialogue: 0,0:01:19.99,0:01:23.45,Default,,0,0,0,,Ол және оның тобы халықаралық несие алаяқтары.
Dialogue: 0,0:01:23.58,0:01:26.00,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:01:26.79,0:01:28.33,Default,,0,0,0,,Сенімді адам
Dialogue: 0,0:01:30.08,0:01:31.96,Default,,0,0,0,,Бірінші мақсат болды
Dialogue: 0,0:01:32.25,0:01:34.26,Default,,0,0,0,,Лос-Анджелес есірткі мафиясының басшысы
Dialogue: 0,0:01:34.38,0:01:35.22,Default,,0,0,0,,Эдди Кассано
Dialogue: 0,0:01:36.38,0:01:38.93,Default,,0,0,0,,Мені дәріхана дәрігерінің рөлін сомдады.
Dialogue: 0,0:01:39.09,0:01:42.35,Default,,0,0,0,,Олар есірткінің жаңа түрі ретінде қарапайым кәмпит сатты.
Dialogue: 0,0:01:42.97,0:01:44.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:44.72,0:01:46.94,Default,,0,0,0,,Мынау... балақай!
Dialogue: 0,0:01:47.06,0:01:48.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:48.56,0:01:49.52,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:50.94,0:01:53.94,Default,,0,0,0,,Соңында ол 100 миллион доллардан астам ақшаны алдап кеткен.
Dialogue: 0,0:01:54.36,0:01:57.03,Default,,0,0,0,,Айтпақшы, Кассано да ФБР тарапынан қамауға алынды.
Dialogue: 0,0:01:57.15,0:01:59.36,Default,,0,0,0,,Тіпті ұйым жойылды.
Dialogue: 0,0:02:01.74,0:02:02.99,Default,,0,0,0,,Менің ағам – ескі мектептің адамы – алдау мен айла-шарғы арқылы жеңетіндерден—
Dialogue: 0,0:02:03.12,0:02:05.54,Default,,0,0,0,,Сіз өзіңіздің қол астындағы банды да бостандыққа шығардыңыз ба?
Dialogue: 0,0:02:08.21,0:02:10.21,Default,,0,0,0,,Одан басқа да біртүрлі адамдар бар.
Dialogue: 0,0:02:10.42,0:02:12.09,Default,,0,0,0,,Эбби есімді қыз
Dialogue: 0,0:02:12.63,0:02:15.67,Default,,0,0,0,,Әдемі көрінеді... Айтайын дегенім...
Dialogue: 0,0:02:15.80,0:02:18.13,Default,,0,0,0,,Бұл өте сүйкімді.
Dialogue: 0,0:02:18.55,0:02:19.38,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:19.63,0:02:21.39,Default,,0,0,0,,Гуг... (Эбби) Сен қашып барасың ба? Ақымақ
Dialogue: 0,0:02:21.51,0:02:22.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:22.97,0:02:24.68,Default,,0,0,0,,Ішінде жауыз аң бар
Dialogue: 0,0:02:24.81,0:02:25.81,Default,,0,0,0,,Мейірім жоқ!
Dialogue: 0,0:02:26.72,0:02:28.73,Default,,0,0,0,,Сингапурдан көңілім қалды.
Dialogue: 0,0:02:31.81,0:02:34.07,Default,,0,0,0,,Skyrace келіссөздер арқылы пайдаланылуда.
Dialogue: 0,0:02:34.19,0:02:36.61,Default,,0,0,0,,Мен інім ханзадаларды нысанаға алдым.
Dialogue: 0,0:02:37.78,0:02:38.61,Default,,0,0,0,,Аққұба қаншық
Dialogue: 0,0:02:38.82,0:02:41.53,Default,,0,0,0,,Bay Sands топтамасында жалған казино құрыңыз
Dialogue: 0,0:02:42.99,0:02:45.37,Default,,0,0,0,,Мен қарсылас командада механик болып жұмыс істеймін.
Dialogue: 0,0:02:47.66,0:02:49.83,Default,,0,0,0,,Эбби ұшқыш болсын.
Dialogue: 0,0:02:55.50,0:02:57.96,Default,,0,0,0,,Соңында Лоран ақшаны алдап кетті.
Dialogue: 0,0:02:58.21,0:03:00.05,Default,,0,0,0,,Мен және Эбби қатты қысылып қалды.
Dialogue: 0,0:03:03.47,0:03:04.60,Default,,0,0,0,,Бірге өлейік!
Dialogue: 0,0:03:04.72,0:03:05.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:05.76,0:03:07.02,Default,,0,0,0,,Нөл! (мылтық)
Dialogue: 0,0:03:10.48,0:03:11.31,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:03:12.19,0:03:15.02,Default,,0,0,0,,Мен Марина Бэй Сэндстен секірдім.
Dialogue: 0,0:03:15.36,0:03:17.48,Default,,0,0,0,,Мен оны өлді деп ойладым.
Dialogue: 0,0:03:19.44,0:03:23.78,Default,,0,0,0,,Сексуалды патшайым Синтияға байсалды болатын кез келген сияқты.
Dialogue: 0,0:03:24.82,0:03:27.99,Default,,0,0,0,,Тағы бір үлкен апа бар, ол өте қиын.
Dialogue: 0,0:03:30.66,0:03:33.00,Default,,0,0,0,,Ол өте әдемі көрінеді.
Dialogue: 0,0:03:34.54,0:03:36.92,Default,,0,0,0,,Ішімде мен ақша мен ішімдікті жақсы көремін.
Dialogue: 0,0:03:37.05,0:03:39.30,Default,,0,0,0,,20-дағы әйел сияқты сезіну
Dialogue: 0,0:03:41.05,0:03:44.18,Default,,0,0,0,,Бірақ Лондонның күтпеген жағы болды.
Dialogue: 0,0:03:47.06,0:03:51.02,Default,,0,0,0,,«Өнер әлемінің 007» деген атпен белгілі жосықсыз өнер дилері.
Dialogue: 0,0:03:51.14,0:03:52.98,Default,,0,0,0,,Мен сені жалған аукционмен алдадым.
Dialogue: 0,0:03:54.31,0:03:55.98,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:03:56.98,0:03:59.44,Default,,0,0,0,,Синтия, сен мұны міндетті түрде орындайтыныңды айт.
Dialogue: 0,0:04:03.36,0:04:05.74,Default,,0,0,0,,Менің бұрынғы жігітімді өнер дилері пайдаланды
Dialogue: 0,0:04:05.91,0:04:08.41,Default,,0,0,0,,Біздің өміріміз ақылсыз болып кеткен сияқты.
Dialogue: 0,0:04:12.04,0:04:15.67,Default,,0,0,0,,Егер бұл болмағанда, Синтия осы уақытқа дейін...
Dialogue: 0,0:04:19.21,0:04:21.51,Default,,0,0,0,,Жоқ, бұл дұрыс емес пе?
Dialogue: 0,0:04:23.76,0:04:26.84,Default,,0,0,0,,Сивон деген үлкен ардагер де бар.
Dialogue: 0,0:04:27.26,0:04:29.18,Default,,0,0,0,,Лоранмен көптен бері дос болған сияқтысыз.
Dialogue: 0,0:04:30.10,0:04:33.48,Default,,0,0,0,,Сондай-ақ, Кудо менімен бірігіп жаман істер жасаған жігіт.
Dialogue: 0,0:04:34.27,0:04:36.02,Default,,0,0,0,,Ол жақсы адам және оқуға құштар.
Dialogue: 0,0:04:38.48,0:04:41.61,Default,,0,0,0,,Лоранның барлық жерде басқа әріптестері болды.
Dialogue: 0,0:04:43.36,0:04:45.61,Default,,0,0,0,,Олар өте күлкілі ессіздер.
Dialogue: 0,0:04:50.41,0:04:52.45,Default,,0,0,0,,Мен мұны істегенде өте қызық болдым.
Dialogue: 0,0:04:53.12,0:04:56.29,Default,,0,0,0,,Жарайды, мен жақсы нәрсе істеп жатырмын деп ойламаймын.
Dialogue: 0,0:04:56.58,0:04:59.21,Default,,0,0,0,,Мен сенің тыңдауыңды қаладым.
Dialogue: 0,0:05:00.71,0:05:01.71,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:04.47,0:05:10.47,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:06:02.44,0:06:08.45,Default,,0,0,0,,~♪
Dialogue: 0,0:06:09.86,0:06:10.87,Default,,0,0,0,,Ах, бұл не? Бұл шарф
Dialogue: 0,0:06:10.99,0:06:13.20,Default,,0,0,0,,Хаа... Эй, мен шаршадым.
Dialogue: 0,0:06:13.33,0:06:14.54,Default,,0,0,0,,Мен де
Dialogue: 0,0:06:14.66,0:06:15.66,Default,,0,0,0,,О… Бәрі бітті. Мен енді біттім.
Dialogue: 0,0:06:15.79,0:06:17.58,Default,,0,0,0,,Біраз уақыттан кейін
Dialogue: 0,0:06:18.08,0:06:20.17,Default,,0,0,0,,Біраз жақсы, солай ма?
Dialogue: 0,0:06:20.29,0:06:22.29,Default,,0,0,0,,Жарайды, осы жерден айналайын.
Dialogue: 0,0:06:23.09,0:06:24.55,Default,,0,0,0,,Оны қазір ашуға болады.
Dialogue: 0,0:06:26.63,0:06:28.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:31.05,0:06:34.56,Default,,0,0,0,,О... Әй!
Dialogue: 0,0:06:38.73,0:06:40.48,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,0:06:47.24,0:06:48.40,Default,,0,0,0,,Лоран!
Dialogue: 0,0:06:48.78,0:06:50.20,Default,,0,0,0,,Лоран
Dialogue: 0,0:06:50.57,0:06:51.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:54.53,0:06:56.04,Default,,0,0,0,,Қараңызшы (Лоран) Ах.
Dialogue: 0,0:06:56.62,0:06:59.66,Default,,0,0,0,,Синтия түскі ас әзірледі, тез кел!
Dialogue: 0,0:07:00.41,0:07:03.96,Default,,0,0,0,,Хаа... Арман мен шындықтың айырмашылығы
Dialogue: 0,0:07:10.22,0:07:12.34,Default,,0,0,0,,Сәлем! Оянғанда сыра?
Dialogue: 0,0:07:12.80,0:07:14.05,Default,,0,0,0,,(дауыс дыбысы)
Dialogue: 0,0:07:14.68,0:07:16.39,Default,,0,0,0,,Бұл арпа шырыны.
Dialogue: 0,0:07:16.51,0:07:18.98,Default,,0,0,0,,Сіз бұл жолы не істейсіз? Бұл кәсіпқой күрес пе?
Dialogue: 0,0:07:19.14,0:07:19.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:20.98,0:07:22.77,Default,,0,0,0,,Бір адам әлі келген жоқ.
Dialogue: 0,0:07:23.06,0:07:26.40,Default,,0,0,0,,(Ауыр аяқ дыбысы және ауыр тыныс алу)
Dialogue: 0,0:07:27.28,0:07:28.94,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:29.07,0:07:29.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:34.41,0:07:36.91,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:07:37.70,0:07:38.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:38.95,0:07:41.08,Default,,0,0,0,,Өлді деп көрсету қиын.
Dialogue: 0,0:07:41.21,0:07:43.88,Default,,0,0,0,,Мен контекстсіз өлсем де, маған мағынасы болмайды
Dialogue: 0,0:07:44.00,0:07:45.92,Default,,0,0,0,,Сценарийді қайта өңдеу
Dialogue: 0,0:07:46.04,0:07:48.17,Default,,0,0,0,,Егер сіз мұны істегіңіз келсе, оны сыртта жасаңыз.
Dialogue: 0,0:07:48.30,0:07:50.63,Default,,0,0,0,,Соңында да қатал тұтынушылар ғана бар.
Dialogue: 0,0:07:51.05,0:07:52.22,Default,,0,0,0,,Соңғысы?
Dialogue: 0,0:07:52.34,0:07:54.64,Default,,0,0,0,,А, мен қоштасуға келдім.
Dialogue: 0,0:07:54.76,0:07:56.35,Default,,0,0,0,,Иә, иә, тағы да солай ма?
Dialogue: 0,0:08:01.35,0:08:02.77,Default,,0,0,0,,Бірге сөйлесейік
Dialogue: 0,0:08:05.94,0:08:09.98,Default,,0,0,0,,Егер сіз алаяқтық жасасаңыз, сіз бір күні осындай жағдайға тап боласыз.
Dialogue: 0,0:08:10.44,0:08:12.57,Default,,0,0,0,,Өлудің бұл жолы әзіл емес.
Dialogue: 0,0:08:13.65,0:08:16.20,Default,,0,0,0,,Шынымды айтсам, менде саған реніштен басқа ештеңе жоқ.
Dialogue: 0,0:08:16.87,0:08:18.70,Default,,0,0,0,,Мен сәл ғана ризамын.
Dialogue: 0,0:08:20.54,0:08:23.12,Default,,0,0,0,,Сіз Жапонияда лаулап тұрған былғарды өзгерттіңіз.
Dialogue: 0,0:08:26.21,0:08:27.92,Default,,0,0,0,,Ал мен не айта аламын?
Dialogue: 0,0:08:28.04,0:08:31.80,Default,,0,0,0,,Бұлай жалғаса берсе, бұдан былай өзіңіздің кім екеніңізді білмейсіз.
Dialogue: 0,0:08:32.72,0:08:35.51,Default,,0,0,0,,Басқа адамға сену үшін айтылған өтірік
Dialogue: 0,0:08:35.64,0:08:38.51,Default,,0,0,0,,Сіз білмей тұрып, бұл шындыққа айнала бастайды.
Dialogue: 0,0:08:40.01,0:08:41.97,Default,,0,0,0,,Мен солай сезінемін және бұл қорқынышты.
Dialogue: 0,0:08:42.93,0:08:46.02,Default,,0,0,0,,Жарайды, менің ойымша, саған тым кеш.
Dialogue: 0,0:08:46.48,0:08:49.52,Default,,0,0,0,,Хаа... Мен сенің әрқашан байсалды болатыныңа сенімдімін.
Dialogue: 0,0:08:49.65,0:08:52.49,Default,,0,0,0,,Сондықтан бәрі қозғалады.
Dialogue: 0,0:08:54.11,0:08:56.45,Default,,0,0,0,,Уақыт таяп қалды...
Dialogue: 0,0:08:57.41,0:09:00.24,Default,,0,0,0,,Тастауды ұмытып кеткендіктен айтсам да сендірмейді.
Dialogue: 0,0:09:02.79,0:09:04.33,Default,,0,0,0,,Орындалмаған не қалды?
Dialogue: 0,0:09:04.58,0:09:05.67,Default,,0,0,0,,Бар болса
Dialogue: 0,0:09:05.79,0:09:08.67,Default,,0,0,0,,Мен сені бір рет алдап алғым келді.
Dialogue: 0,0:09:08.79,0:09:10.88,Default,,0,0,0,,Бұл ұят болды.
Dialogue: 0,0:09:11.00,0:09:11.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:11.96,0:09:14.51,Default,,0,0,0,,Мен сізге керемет кеңес бере алмаймын.
Dialogue: 0,0:09:15.42,0:09:17.43,Default,,0,0,0,,Қалағаныңызша қозғалыңыз
Dialogue: 0,0:09:17.76,0:09:19.14,Default,,0,0,0,,Оны өз түйсігіңе қалдырсаң
Dialogue: 0,0:09:19.26,0:09:21.97,Default,,0,0,0,,Сіз жүру керек жол сізге табиғи түрде келеді.
Dialogue: 0,0:09:22.89,0:09:23.72,Default,,0,0,0,,Иә
Dialogue: 0,0:09:27.85,0:09:28.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:29.77,0:09:31.11,Default,,0,0,0,,Лоран кездескенше
Dialogue: 0,0:09:42.66,0:09:47.71,Default,,0,0,0,,Ей, Жапонияға оралып, өмірді қайта бастайық.
Dialogue: 0,0:09:48.75,0:09:50.63,Default,,0,0,0,,Мен не істей алатынымды білмеймін
Dialogue: 0,0:09:51.04,0:09:56.67,Default,,0,0,0,,Дегенмен, мен аңшылық жұмысымды байыппен атқарып, қоғамның байыпты мүшесі боламын.
Dialogue: 0,0:09:57.97,0:10:00.72,Default,,0,0,0,,Мен сендердің көпшілігіңе алданып қалдым.
Dialogue: 0,0:10:01.55,0:10:04.06,Default,,0,0,0,,Енді аздап алданбайсың.
Dialogue: 0,0:10:15.11,0:10:16.15,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:28.33,0:10:31.71,Default,,0,0,0,,Сонда сіздің отбасыңыздың полицияға қатысы жоқ па?
Dialogue: 0,0:10:31.83,0:10:32.67,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:32.88,0:10:34.84,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:34.96,0:10:36.76,Default,,0,0,0,,Сізде соттылығы бар.
Dialogue: 0,0:10:36.88,0:10:39.97,Default,,0,0,0,,Олай болса, мұны бір жаққа қалдырайық. Сонда ше?
Dialogue: 0,0:10:41.18,0:10:43.35,Default,,0,0,0,,Мен дүние жүзінде әртүрлі жұмыстарды атқардым.
Dialogue: 0,0:10:43.47,0:10:44.89,Default,,0,0,0,,Қай жерде?
Dialogue: 0,0:10:45.14,0:10:45.97,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:47.10,0:10:48.85,Default,,0,0,0,,Американдық Голливуд
Dialogue: 0,0:10:48.98,0:10:51.85,Default,,0,0,0,,Сингапур Марина Бэй Сэндстің айналасында орналасқан
Dialogue: 0,0:10:51.98,0:10:53.94,Default,,0,0,0,,Иә... Лондонның айналасында, Англия
Dialogue: 0,0:10:54.07,0:10:56.94,Default,,0,0,0,,Ал Франция – Париж және Ницца
Dialogue: 0,0:10:57.07,0:10:59.49,Default,,0,0,0,,Бұл туризм емес.
Dialogue: 0,0:10:59.61,0:11:00.57,Default,,0,0,0,,Иә
Dialogue: 0,0:11:01.03,0:11:04.99,Default,,0,0,0,,Мен өз дағдыларымды сіздің компанияңыздың сауда бизнесінде қолдана аламын деп ойладым...
Dialogue: 0,0:11:06.04,0:11:08.87,Default,,0,0,0,,Маған оңай сенеді деп күтпеймін.
Dialogue: 0,0:11:10.04,0:11:10.87,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:11.96,0:11:14.75,Default,,0,0,0,,Өмірімді қайта бастайтындай барымды саламын!
Dialogue: 0,0:11:15.67,0:11:17.25,Default,,0,0,0,,«Басынан бастау»?
Dialogue: 0,0:11:17.84,0:11:19.17,Default,,0,0,0,,Ағылшын тілінде еркін сөйлейсіз бе?
Dialogue: 0,0:11:19.42,0:11:20.26,Default,,0,0,0,,Иә
Dialogue: 0,0:11:20.55,0:11:22.89,Default,,0,0,0,,Бұл сәл ескірген сияқты.
Dialogue: 0,0:11:23.01,0:11:24.76,Default,,0,0,0,,Мен бұл туралы білмеймін, бірақ...
Dialogue: 0,0:11:25.01,0:11:28.85,Default,,0,0,0,,Сондай-ақ, мен қытай әдебиетінің мұғалімі болған анамнан қытай тілін аздап үйрендім.
Dialogue: 0,0:11:29.52,0:11:31.69,Default,,0,0,0,,Иә, қытайша да.
Dialogue: 0,0:11:31.81,0:11:34.48,Default,,0,0,0,,Мен тек қарапайым ағылшын тілінде сөйлеймін.
Dialogue: 0,0:11:34.81,0:11:36.07,Default,,0,0,0,,(қағазды аудару дыбысы)
Dialogue: 0,0:11:36.19,0:11:37.86,Default,,0,0,0,,Фучуде болды ма?
Dialogue: 0,0:11:38.11,0:11:40.19,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:11:40.49,0:11:44.78,Default,,0,0,0,,Өмірді қайта бастау мүмкіндіктері бірдей емес, солай ма?
Dialogue: 0,0:11:45.07,0:11:47.58,Default,,0,0,0,,Сіз оны шәкірт ретінде сынап көргіңіз келе ме?
Dialogue: 0,0:11:52.08,0:11:52.96,Default,,0,0,0,,Эдамура мырза?
Dialogue: 0,0:11:53.29,0:11:54.29,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:11:54.42,0:11:55.58,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:11:56.13,0:11:58.46,Default,,0,0,0,,Аха, енді ұсталма.
Dialogue: 0,0:11:58.59,0:12:00.01,Default,,0,0,0,,Aha ahahaha
Dialogue: 0,0:12:00.13,0:12:00.97,Default,,0,0,0,,Хаха...
Dialogue: 0,0:12:28.45,0:12:30.08,Default,,0,0,0,,(лифттің келу дыбысы)
Dialogue: 0,0:12:30.45,0:12:31.62,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:12:31.75,0:12:33.12,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:12:33.25,0:12:35.12,Default,,0,0,0,,О, Эдамура-кун, иә.
Dialogue: 0,0:12:35.75,0:12:37.25,Default,,0,0,0,,Жұмысыңызға үйрендіңіз бе?
Dialogue: 0,0:12:37.38,0:12:39.50,Default,,0,0,0,,Иә, бұл қоңырау болуы мүмкін.
Dialogue: 0,0:12:39.84,0:12:42.30,Default,,0,0,0,,Эй, сен жақсысың.
Dialogue: 0,0:12:42.55,0:12:44.38,Default,,0,0,0,,Оны алып кетсем болады ма?
Dialogue: 0,0:12:44.51,0:12:45.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:49.56,0:12:51.06,Default,,0,0,0,,Сіздің бас кеңсеңіз Роппонгиде орналасқан ба?
Dialogue: 0,0:12:51.35,0:12:53.81,Default,,0,0,0,,А, қойылым да жаман емес.
Dialogue: 0,0:12:54.31,0:12:57.69,Default,,0,0,0,,Оң баға болған жағдайда бонус жарты жылға кепілдік беріледі.
Dialogue: 0,0:12:57.81,0:12:58.90,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:12:59.40,0:13:00.69,Default,,0,0,0,,Кесімді мөлшерлеме негізінде.
Dialogue: 0,0:13:00.82,0:13:03.49,Default,,0,0,0,,Жоғары тәуекел, жоғары табыстылық.
Dialogue: 0,0:13:03.61,0:13:05.32,Default,,0,0,0,,Жоғары тәуекел дегеніміз не?
Dialogue: 0,0:13:05.45,0:13:08.32,Default,,0,0,0,,А-а-а... Мысал ғой.
Dialogue: 0,0:13:09.62,0:13:11.54,Default,,0,0,0,,Сізді біреумен таныстыру
Dialogue: 0,0:13:12.33,0:13:13.45,Default,,0,0,0,,Біреу?
Dialogue: 0,0:13:13.91,0:13:15.04,Default,,0,0,0,,Бұл иесі.
Dialogue: 0,0:13:15.41,0:13:18.46,Default,,0,0,0,,Бүгін бізді Каруизавадан көретін күн.
Dialogue: 0,0:13:18.58,0:13:21.05,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:23.59,0:13:24.59,Default,,0,0,0,,Usu!
Dialogue: 0,0:13:24.97,0:13:26.47,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:13:26.59,0:13:29.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:30.64,0:13:32.31,Default,,0,0,0,,Эдамура-кун, тез сапқа тұр!
Dialogue: 0,0:13:32.43,0:13:33.56,Default,,0,0,0,,Иә
Dialogue: 0,0:13:42.57,0:13:43.98,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:13:52.28,0:13:53.12,Default,,0,0,0,,Төраға!
Dialogue: 0,0:13:53.74,0:13:55.00,Default,,0,0,0,,Төраға!
Dialogue: 0,0:13:56.33,0:13:58.54,Default,,0,0,0,,Бұл Эдамура, жаңа мүше.
Dialogue: 0,0:13:59.58,0:14:00.42,Default,,0,0,0,,Эй!
Dialogue: 0,0:14:00.75,0:14:02.84,Default,,0,0,0,,Е... Мен Масато Эдамурамын.
Dialogue: 0,0:14:02.96,0:14:03.80,Default,,0,0,0,,Хун
Dialogue: 0,0:14:12.26,0:14:13.10,Default,,0,0,0,,Ынталандыру
Dialogue: 0,0:14:13.64,0:14:14.97,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:17.73,0:14:19.40,Default,,0,0,0,,Төрағаның рұқсаты берілді.
Dialogue: 0,0:14:19.73,0:14:22.23,Default,,0,0,0,,Сіз енді қарапайым қызметкерсіз. Құттықтаймыз.
Dialogue: 0,0:14:23.02,0:14:26.11,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:14:38.62,0:14:40.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:41.13,0:14:42.88,Default,,0,0,0,,(сиырдың шуы)
Dialogue: 0,0:14:43.63,0:14:46.51,Default,,0,0,0,,(Тауықтың айқайлауы)
Dialogue: 0,0:14:48.88,0:14:51.51,Default,,0,0,0,,Ал...
Dialogue: 0,0:14:52.72,0:14:54.64,Default,,0,0,0,,Көп емес, бірақ жақсы
Dialogue: 0,0:14:56.81,0:14:58.14,Default,,0,0,0,,Бұл балалар ше?
Dialogue: 0,0:14:58.35,0:14:59.56,Default,,0,0,0,,Бұл өнім, иә?
Dialogue: 0,0:14:59.98,0:15:01.73,Default,,0,0,0,,Тауарлар
Dialogue: 0,0:15:02.27,0:15:04.15,Default,,0,0,0,,Қараңызшы, біз бәрін реттейміз.
Dialogue: 0,0:15:05.65,0:15:07.65,Default,,0,0,0,,Тағы үш үйді аралаған соң, қайтар жолда...
Dialogue: 0,0:15:09.19,0:15:12.11,Default,,0,0,0,,Бұл круиз болатындықтан, өнімді басқару дұрыс орындалуы керек.
Dialogue: 0,0:15:12.78,0:15:15.03,Default,,0,0,0,,Мүмкін мен қозғалыс ауруына қарсы дәрі сатып алуым керек шығар.
Dialogue: 0,0:15:15.24,0:15:16.08,Default,,0,0,0,,(Түкірген тұқымның дыбысы)
Dialogue: 0,0:15:16.91,0:15:18.33,Default,,0,0,0,,Көптеген түрлері бар.
Dialogue: 0,0:15:19.16,0:15:20.00,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:15:22.88,0:15:24.59,Default,,0,0,0,,Исигами мырза, бұлай істеуге болады...
Dialogue: 0,0:15:24.71,0:15:27.17,Default,,0,0,0,,Сіз мұны істеп жатырсыз, солай емес пе?
Dialogue: 0,0:15:27.71,0:15:29.26,Default,,0,0,0,,Жүр, тезірек.
Dialogue: 0,0:15:29.38,0:15:32.13,Default,,0,0,0,,Осы жерде ұсталсаң, түрме қиын болады.
Dialogue: 0,0:15:32.26,0:15:33.09,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:33.59,0:15:34.64,Default,,0,0,0,,Атпен жүру
Dialogue: 0,0:15:34.97,0:15:35.80,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:15:36.64,0:15:40.18,Default,,0,0,0,,Мм, бұл Скарлет Компани, солай ма?
Dialogue: 0,0:15:40.60,0:15:41.44,Default,,0,0,0,,Иә
Dialogue: 0,0:15:41.73,0:15:44.98,Default,,0,0,0,,Негізінен жиһаз және киім, жемістер мен көкөністер де бар.
Dialogue: 0,0:15:45.31,0:15:47.19,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:15:47.48,0:15:50.03,Default,,0,0,0,,А... иә... у...
Dialogue: 0,0:15:50.15,0:15:50.99,Default,,0,0,0,,Хмм…
Dialogue: 0,0:15:51.74,0:15:53.86,Default,,0,0,0,,Сіз орнында тексеру жүргізесіз бе?
Dialogue: 0,0:15:54.11,0:15:54.95,Default,,0,0,0,,Ах
Dialogue: 0,0:15:55.28,0:15:57.37,Default,,0,0,0,,Ой, жаман, жаман, мен ваннаға бардым.
Dialogue: 0,0:15:57.83,0:16:00.70,Default,,0,0,0,,Комада, менің жаңа келгенім, оны көп мазақ етпе.
Dialogue: 0,0:16:00.91,0:16:02.92,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:16:03.04,0:16:05.88,Default,,0,0,0,,Мен жаңа адамдарды көргенде, мен оны қолданып көргім келеді.
Dialogue: 0,0:16:06.00,0:16:06.84,Default,,0,0,0,,Жақсы
Dialogue: 0,0:16:06.96,0:16:09.00,Default,,0,0,0,,Жүр, мен саған мөр басамын, оны шығарып ал.
Dialogue: 0,0:16:12.80,0:16:17.64,Default,,0,0,0,,
Dialogue: 0,0:16:24.69,0:16:28.48,Default,,0,0,0,,Сонымен, біз Оңтүстік-Шығыс Азияны қанша араладық?
Dialogue: 0,0:16:28.61,0:16:29.94,Default,,0,0,0,,Меніңше, бұл матч…
Dialogue: 0,0:16:30.61,0:16:31.65,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:16:32.15,0:16:34.07,Default,,0,0,0,,2 айдан кейін аукцион
Dialogue: 0,0:16:34.36,0:16:35.45,Default,,0,0,0,,Оны жылтыратыңыз.
Dialogue: 0,0:16:35.57,0:16:36.41,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:39.62,0:16:41.16,Default,,0,0,0,,Сатылым төмендеуде
Dialogue: 0,0:16:41.66,0:16:43.41,Default,,0,0,0,,Сіз оның осылай қалатынын білесіз бе?
Dialogue: 0,0:16:43.87,0:16:44.71,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:45.67,0:16:46.63,Default,,0,0,0,,Көрші есік...
Dialogue: 0,0:16:46.75,0:16:48.13,Default,,0,0,0,,Бұл Масато Эдамура!
Dialogue: 0,0:16:48.50,0:16:50.34,Default,,0,0,0,,Осыдан кейін аукцион болады, сондықтан оны тамашалаңыз.
Dialogue: 0,0:16:50.46,0:16:51.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:53.88,0:16:54.97,Default,,0,0,0,,Хаа…
Dialogue: 0,0:16:55.34,0:16:58.68,Default,,0,0,0,,Мен Төраға Сузаку мені шақырады деп ешқашан күтпедім.
Dialogue: 0,0:16:58.80,0:16:59.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:59.81,0:17:03.43,Default,,0,0,0,,Біреуге мені қанша жыл есіне алды?
Dialogue: 0,0:17:03.64,0:17:05.64,Default,,0,0,0,,Енді төменде өтетін орынға көшейік.
Dialogue: 0,0:17:17.24,0:17:18.91,Default,,0,0,0,,Түсінуім үшін неше рет айту керек?
Dialogue: 0,0:17:19.45,0:17:21.49,Default,,0,0,0,,Бұл күлімсіреу. Бұл күлімсіреу.
Dialogue: 0,0:17:21.62,0:17:22.54,Default,,0,0,0,,Күлімсіре!
Dialogue: 0,0:17:22.87,0:17:24.71,Default,,0,0,0,,Мен саған күле бер дедім!
Dialogue: 0,0:17:24.83,0:17:27.12,Default,,0,0,0,,Жапон тілін түсінбейсіз бе?
Dialogue: 0,0:17:27.25,0:17:29.25,Default,,0,0,0,,Үнемі бетіме қатал көзқараспен
Dialogue: 0,0:17:29.92,0:17:32.17,Default,,0,0,0,,Нақты қозғалыс кезінде мен үйреткенімдей қозғалыңыз!
Dialogue: 0,0:17:32.30,0:17:34.26,Default,,0,0,0,,Әйтпесе, мен ашуландым!
Dialogue: 0,0:17:34.72,0:17:37.97,Default,,0,0,0,,Эхехехе, кешіріңіз, Исигами мырза.
Dialogue: 0,0:17:38.09,0:17:39.89,Default,,0,0,0,,Әдетте 2-3 рет ұрсам,
Dialogue: 0,0:17:40.01,0:17:42.22,Default,,0,0,0,,Айтқаныңды тыңдаймын, хахаха...
Dialogue: 0,0:17:43.64,0:17:45.98,Default,,0,0,0,,Ханымдар мен мырзалар!
Dialogue: 0,0:17:46.10,0:17:48.23,Default,,0,0,0,,Би шоуына қош келдіңіздер!
Dialogue: 0,0:17:48.81,0:17:51.11,Default,,0,0,0,,Көру уақыты!
Dialogue: 0,0:17:53.40,0:17:57.20,Default,,0,0,0,,№1 жазба, Наталья.
Dialogue: 0,0:17:57.57,0:18:00.87,Default,,0,0,0,,14 жаста, Түркиядан.
Dialogue: 0,0:18:01.62,0:18:03.20,Default,,0,0,0,,2 миллион иеннен
Dialogue: 0,0:18:03.33,0:18:04.91,Default,,0,0,0,,2 миллионнан бастап.
Dialogue: 0,0:18:05.58,0:18:07.50,Default,,0,0,0,,3 миллион (түсіндіру: ағылшын) 3 миллион.
Dialogue: 0,0:18:07.83,0:18:09.46,Default,,0,0,0,,5 миллион (түсіндіру: ағылшын) 5 миллион.
Dialogue: 0,0:18:09.83,0:18:11.59,Default,,0,0,0,,5,5 млн
Dialogue: 0,0:18:11.71,0:18:12.63,Default,,0,0,0,,6 миллион
Dialogue: 0,0:18:12.75,0:18:14.84,Default,,0,0,0,,Тағы бірдеңе бар ма? (Аудармашы: Ағылшын) Басқа біреу ме?
Dialogue: 0,0:18:15.17,0:18:16.84,Default,,0,0,0,,Ой, 7 миллион!
Dialogue: 0,0:18:16.97,0:18:19.22,Default,,0,0,0,,Басқалары бар ма? Жоқ, солай ма?
Dialogue: 0,0:18:19.34,0:18:20.18,Default,,0,0,0,,Сәтті өтінім!
Dialogue: 0,0:18:20.30,0:18:21.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:21.47,0:18:23.35,Default,,0,0,0,,Қалағаныңызша қозғалыңыз
Dialogue: 0,0:18:24.89,0:18:26.27,Default,,0,0,0,,Оны өз түйсігіңе қалдырсаң
Dialogue: 0,0:18:26.39,0:18:29.52,Default,,0,0,0,,Сіз жүру керек жол сізге табиғи түрде түсінікті болады.
Dialogue: 0,0:18:30.56,0:18:32.94,Default,,0,0,0,,Ертең мен Наритадан Сингапурға барамын.
Dialogue: 0,0:18:33.07,0:18:34.36,Default,,0,0,0,,Сіз бос емес сияқтысыз.
Dialogue: 0,0:18:34.61,0:18:36.11,Default,,0,0,0,,Сіз қандай жұмыс жасайсыз?
Dialogue: 0,0:18:36.32,0:18:38.03,Default,,0,0,0,,Бұл сауда қатынасы.
Dialogue: 0,0:18:38.15,0:18:39.95,Default,,0,0,0,,Мүмкін менің де жұмысымды ауыстыруым керек.
Dialogue: 0,0:18:54.21,0:18:56.00,Default,,0,0,0,,Әлгі бейбақ!
Dialogue: 0,0:18:57.13,0:18:59.51,Default,,0,0,0,,Әй, бұл не деген сұмдық?
Dialogue: 0,0:18:59.63,0:19:01.01,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:19:01.14,0:19:01.97,Default,,0,0,0,,Скарлет компаниясы
Dialogue: 0,0:19:02.09,0:19:04.18,Default,,0,0,0,,Бұл якузаның алдыңғы қатарлы компаниясы емес пе?
Dialogue: 0,0:19:05.22,0:19:07.35,Default,,0,0,0,,Сіз бізге жол сілтедіңіз, ал біз ренжідік!
Dialogue: 0,0:19:07.85,0:19:09.23,Default,,0,0,0,,Жоқ, мен шынымен қызығып тұрмын.
Dialogue: 0,0:19:09.35,0:19:11.48,Default,,0,0,0,,Қанағат ету үшін қанша алдауым керек!
Dialogue: 0,0:19:11.60,0:19:13.36,Default,,0,0,0,,Жарайды, бұлай ашуланба.
Dialogue: 0,0:19:13.81,0:19:17.36,Default,,0,0,0,,Соңғы эдамаме гүл жолы Токиода көрсетіледі.
Dialogue: 0,0:19:17.48,0:19:19.36,Default,,0,0,0,,Сүйіспеншілікке толы аранжировкалар
Dialogue: 0,0:19:19.90,0:19:23.37,Default,,0,0,0,,Әй, сен Созаку федерациясының қандай екенін білесің бе?
Dialogue: 0,0:19:23.70,0:19:26.79,Default,,0,0,0,,Азияның түкпір-түкпірінен жетім балалар мен босқындарды жинау
Dialogue: 0,0:19:26.91,0:19:30.87,Default,,0,0,0,,Дүние жүзіндегі бай адамдарға сататын жапондық якудза
Dialogue: 0,0:19:31.58,0:19:36.25,Default,,0,0,0,,Ал бастық Жапонияның жер асты әлемінің императрицасы Акеми Сузаку.
Dialogue: 0,0:19:37.17,0:19:38.88,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:19:39.63,0:19:42.18,Default,,0,0,0,,Әзірше жақсы дос болып кеткен достарыма.
Dialogue: 0,0:19:42.30,0:19:44.47,Default,,0,0,0,,Мен сізден ынтымақтастық сұраймын.
Dialogue: 0,0:19:56.06,0:19:57.36,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:20:04.03,0:20:04.87,Default,,0,0,0,,Фу~
Dialogue: 0,0:20:05.87,0:20:06.70,Default,,0,0,0,,Хун
Dialogue: 0,0:20:07.66,0:20:08.95,Default,,0,0,0,,Сіз Лорансыз ба?
Dialogue: 0,0:20:09.16,0:20:10.04,Default,,0,0,0,,О
Dialogue: 0,0:20:10.16,0:20:12.62,Default,,0,0,0,,Бірінші кездесуіміз екеніне сене алар емеспін.
Dialogue: 0,0:20:12.75,0:20:13.75,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:20:13.87,0:20:16.50,Default,,0,0,0,,Балалар сендерге рахмет, біз нөлден бастауымыз керек.
Dialogue: 0,0:20:16.96,0:20:18.92,Default,,0,0,0,,Жақсы көрінесіз! абби
Dialogue: 0,0:20:19.05,0:20:21.51,Default,,0,0,0,,Таға шаян тәрізді шаш үлгісі де керемет.
Dialogue: 0,0:20:23.26,0:20:24.72,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:25.55,0:20:28.47,Default,,0,0,0,,Сонымен мен осы жерге келдім.
Dialogue: 0,0:20:28.60,0:20:29.97,Default,,0,0,0,,Сіз мені қайтадан алып жүруді жоспарлап отырсыз ба?
Dialogue: 0,0:20:30.60,0:20:34.23,Default,,0,0,0,,Сіздің ұжым ағаңыздан тәуелсіз тынбай еңбек етуде.
Dialogue: 0,0:20:34.35,0:20:36.86,Default,,0,0,0,,Демеуші болуды қарастырыңыз.
Dialogue: 0,0:20:36.98,0:20:37.98,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:20:38.82,0:20:40.57,Default,,0,0,0,,Оның орнына не істеуім керек?
Dialogue: 0,0:20:40.73,0:20:42.78,Default,,0,0,0,,Мен мүгедектер арбасын пайдалана аламын ба?
Dialogue: 0,0:20:44.32,0:20:47.24,Default,,0,0,0,,Жарыс сияқты қызық ойын ойнайық
Dialogue: 0,0:20:48.41,0:20:50.37,Default,,0,0,0,,Менде сценарий бар.
Dialogue: 0,0:20:51.16,0:20:57.17,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.86,0:22:50.86,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.36,0:22:58.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory