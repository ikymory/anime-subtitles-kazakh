Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.50,0:00:06.08,Default,,0,0,0,,Сонымен, мақсаты қандай?
Dialogue: 0,0:00:06.21,0:00:07.04,Default,,0,0,0,,Мақсаты?
Dialogue: 0,0:00:07.54,0:00:10.17,Default,,0,0,0,,Мені осында әкелді.
Dialogue: 0,0:00:10.30,0:00:13.05,Default,,0,0,0,,Мен сізді паром дөңгелегіне шақыруым керек пе?
Dialogue: 0,0:00:13.68,0:00:16.68,Default,,0,0,0,,Егер сіз әдепсіз әрекетті жоспарлап жатсаңыз, бас тартыңыз
Dialogue: 0,0:00:16.80,0:00:17.68,Default,,0,0,0,,және өлтіріңіз
Dialogue: 0,0:00:17.80,0:00:19.06,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:00:20.52,0:00:22.85,Default,,0,0,0,,Мен жай ғана сөйлескім келді.
Dialogue: 0,0:00:22.98,0:00:24.69,Default,,0,0,0,,Содан кейін адамдардың көзіне қарап, олармен сөйлесіңіз.
Dialogue: 0,0:00:24.81,0:00:26.65,Default,,0,0,0,,Бұл қабылданбауы керек.
Dialogue: 0,0:00:27.69,0:00:28.77,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:00:29.19,0:00:31.19,Default,,0,0,0,,-да не туралы айтамыз?
Dialogue: 0,0:00:31.57,0:00:35.66,Default,,0,0,0,,Жоқ, бұл жай сенсің, мен сені жақсы танымаймын.
Dialogue: 0,0:00:35.78,0:00:36.99,Default,,0,0,0,,Әріптестер ретінде...
Dialogue: 0,0:00:37.12,0:00:39.03,Default,,0,0,0,,Біз дос емеспіз
Dialogue: 0,0:00:39.66,0:00:41.45,Default,,0,0,0,,Иә... түсіндім.
Dialogue: 0,0:00:42.00,0:00:44.54,Default,,0,0,0,,Дегенмен, сенім қарым-қатынасы қажет.
Dialogue: 0,0:00:44.66,0:00:45.67,Default,,0,0,0,,Мұндағы Окаринді
Dialogue: 0,0:00:48.00,0:00:49.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:49.67,0:00:52.26,Default,,0,0,0,,Мен жаңа ғана сауда үйінен өттім.
Dialogue: 0,0:00:52.38,0:00:53.76,Default,,0,0,0,,Капсула ойыншық
Dialogue: 0,0:00:53.88,0:00:55.05,Default,,0,0,0,,Қаласаңыз, орындаңыз.
Dialogue: 0,0:00:55.88,0:00:58.47,Default,,0,0,0,,Бұл өте сүйкімді және жақсы жасалған.
Dialogue: 0,0:00:58.60,0:01:00.31,Default,,0,0,0,,Әй, қолыңды берші.
Dialogue: 0,0:01:00.43,0:01:01.89,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:01:03.27,0:01:04.77,Default,,0,0,0,,Капсула ойыншық дегеніміз не?
Dialogue: 0,0:01:04.89,0:01:08.15,Default,,0,0,0,,Егер жақсы нәрсе шықса, менің ойымша, ол бүгінде.
Dialogue: 0,0:01:08.27,0:01:10.23,Default,,0,0,0,,Болжам немесе заклинание үшін қолдануға болады
Dialogue: 0,0:01:10.36,0:01:12.90,Default,,0,0,0,,Тереңірек Бұл ең жақсы хобби
Dialogue: 0,0:01:13.53,0:01:15.28,Default,,0,0,0,,Олай ойламасаңыз, қайтарыңыз.
Dialogue: 0,0:01:16.86,0:01:18.62,Default,,0,0,0,,А, мен не істеуім керек!
Dialogue: 0,0:01:18.74,0:01:20.78,Default,,0,0,0,,Бір ісің болса, тез айт.
Dialogue: 0,0:01:22.37,0:01:26.04,Default,,0,0,0,,Эбби Адамдар Әр адамның уайымы бар.
Dialogue: 0,0:01:26.16,0:01:28.50,Default,,0,0,0,,Менің ойымша, сіз маған сене алмайсыз.
Dialogue: 0,0:01:28.71,0:01:31.29,Default,,0,0,0,,Жай сөйлесу өзіңізді жақсы сезінеді.
Dialogue: 0,0:01:32.25,0:01:34.21,Default,,0,0,0,,Мен кез келген кеңесті аламын.
Dialogue: 0,0:01:34.34,0:01:35.17,Default,,0,0,0,,Кім?
Dialogue: 0,0:01:35.55,0:01:37.18,Default,,0,0,0,,Сіз кімсіз (Эбби)?
Dialogue: 0,0:01:37.30,0:01:38.89,Default,,0,0,0,,Сіздің (Эбби) неге?
Dialogue: 0,0:01:39.14,0:01:41.89,Default,,0,0,0,,Неге мен сенімен сөйлесе алмаймын...
Dialogue: 0,0:01:42.01,0:01:42.85,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:01:43.06,0:01:44.85,Default,,0,0,0,,Та... өте жоғары!
Dialogue: 0,0:01:45.52,0:01:48.27,Default,,0,0,0,,Сәлем! Қараңғы биіктікке көтерілу...
Dialogue: 0,0:01:48.81,0:01:50.86,Default,,0,0,0,,А-а...жүйкем жоғалып кетті.
Dialogue: 0,0:01:51.36,0:01:57.36,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:49.71,0:02:55.71,Default,,0,0,0,,~♪
Dialogue: 0,0:02:57.59,0:02:59.42,Default,,0,0,0,,Бұл жер асты казиноға айналады ма?
Dialogue: 0,0:03:00.01,0:03:03.09,Default,,0,0,0,,Мемлекеттік деңгейдегі қонақ келсе де, жарайды.
Dialogue: 0,0:03:03.51,0:03:05.72,Default,,0,0,0,,Көбісі дәрі-дәрмек зауытын жөндеуден
Dialogue: 0,0:03:05.85,0:03:07.68,Default,,0,0,0,,Бұл өте арзан
Dialogue: 0,0:03:08.52,0:03:10.77,Default,,0,0,0,,Бұдан жақсы орын жоқ, солай ма?
Dialogue: 0,0:03:11.06,0:03:12.98,Default,,0,0,0,,Енді Сэмді осында әкеліңіз.
Dialogue: 0,0:03:13.10,0:03:15.40,Default,,0,0,0,,Сіз Эббидің көзін тойғызуға мәжбүр етесіз бе?
Dialogue: 0,0:03:15.57,0:03:17.78,Default,,0,0,0,,Ах, финалда Кларкқа қарсы.
Dialogue: 0,0:03:17.90,0:03:20.19,Default,,0,0,0,,Егер Эбби әдейі жеңілсе, бітті.
Dialogue: 0,0:03:20.70,0:03:22.07,Default,,0,0,0,,Керемет жоспар, солай ма?
Dialogue: 0,0:03:22.20,0:03:23.49,Default,,0,0,0,,Қандай керемет?
Dialogue: 0,0:03:23.95,0:03:27.20,Default,,0,0,0,,Сіз бірінші кезекте мұндай сценарийді қабылдай алмайсыз.
Dialogue: 0,0:03:27.70,0:03:31.00,Default,,0,0,0,,Мен, әрине, Сэм келіспейді деп ойлаймын.
Dialogue: 0,0:03:31.12,0:03:32.58,Default,,0,0,0,,Маған рұқсат етіңіз
Dialogue: 0,0:03:33.46,0:03:37.84,Default,,0,0,0,,Сексуалды патшайым Синтияға байсалды болатын кез келген сияқты.
Dialogue: 0,0:03:38.67,0:03:40.72,Default,,0,0,0,,Мен сені іштей аламын
Dialogue: 0,0:03:40.97,0:03:42.34,Default,,0,0,0,,Мен қызғанамын.
Dialogue: 0,0:03:45.85,0:03:50.23,Default,,0,0,0,,Бәсекелестікке көзіміз жетпейтіндігімен де ұқсаспыз.
Dialogue: 0,0:03:51.14,0:03:54.48,Default,,0,0,0,,Мен сіздермен күш біріктіргенім үшін бақыттымын.
Dialogue: 0,0:03:54.60,0:03:57.90,Default,,0,0,0,,Сізге алғыс айтуыма рұқсат бересіз бе? Тек екеуміз
Dialogue: 0,0:03:58.02,0:04:01.69,Default,,0,0,0,,Ей, саған кім қосылды?
Dialogue: 0,0:04:01.86,0:04:03.74,Default,,0,0,0,,Бұл жай ғана бизнес.
Dialogue: 0,0:04:03.86,0:04:06.16,Default,,0,0,0,,Мен саған бұрын айттым, ашуланба.
Dialogue: 0,0:04:06.74,0:04:09.91,Default,,0,0,0,,Бұл қорқынышты нәрсе. Әйелдер муза.
Dialogue: 0,0:04:10.16,0:04:12.08,Default,,0,0,0,,Muse 20-ға дейін
Dialogue: 0,0:04:12.21,0:04:14.67,Default,,0,0,0,,Одан асып кетсең, лас кәрі қаңбақсың.
Dialogue: 0,0:04:15.21,0:04:17.92,Default,,0,0,0,,Көңілсіз теріңді көрсетпе Жүрек айныды
Dialogue: 0,0:04:21.17,0:04:22.80,Default,,0,0,0,,Тей! Бала!
Dialogue: 0,0:04:22.92,0:04:27.47,Default,,0,0,0,,Мен бұл сүйкімді түсінбеймін, сен лоликон болсаң керек!
Dialogue: 0,0:04:27.72,0:04:30.35,Default,,0,0,0,,О... тыныштал, Синтия, оған көмектесу мүмкін емес.
Dialogue: 0,0:04:30.47,0:04:32.60,Default,,0,0,0,,Сіз нені айтасыз, оған көмектесуге болмайды?
Dialogue: 0,0:04:32.73,0:04:34.89,Default,,0,0,0,,Не? Менен кемпір ме деп сұрап тұрсың!
Dialogue: 0,0:04:35.02,0:04:36.81,Default,,0,0,0,,Сонымен, біз не істейміз?
Dialogue: 0,0:04:37.11,0:04:39.61,Default,,0,0,0,,Маған қарт қаңбақтай қарайды.
Dialogue: 0,0:04:39.77,0:04:41.53,Default,,0,0,0,,Мм, стратегия өзгерді!
Dialogue: 0,0:04:41.90,0:04:43.28,Default,,0,0,0,,Сенсіз дәл солай...
Dialogue: 0,0:04:43.40,0:04:45.32,Default,,0,0,0,,Шаа! Уау...
Dialogue: 0,0:04:45.91,0:04:48.12,Default,,0,0,0,,Эбби жомарттықпен Сэмге бал тасымалдайды...
Dialogue: 0,0:04:48.24,0:04:49.37,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:04:49.66,0:04:51.29,Default,,0,0,0,,Сонда оған көмектесу мүмкін емес.
Dialogue: 0,0:04:51.95,0:04:53.66,Default,,0,0,0,,Сіздің кезегіңіз, Эдамаме
Dialogue: 0,0:04:53.79,0:04:54.62,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:04:54.87,0:04:56.54,Default,,0,0,0,,Ал, тыңда.
Dialogue: 0,0:04:56.71,0:04:59.71,Default,,0,0,0,,Неліктен механик болып жұмыс істеуді үйрендіңіз?
Dialogue: 0,0:04:59.84,0:05:00.88,Default,,0,0,0,,Саана
Dialogue: 0,0:05:01.00,0:05:02.59,Default,,0,0,0,,Сен мені алдадың.
Dialogue: 0,0:05:02.71,0:05:04.97,Default,,0,0,0,,Эббидің машинасына қызмет көрсету үшін.
Dialogue: 0,0:05:05.30,0:05:06.72,Default,,0,0,0,,Nonnonnon
Dialogue: 0,0:05:06.84,0:05:09.35,Default,,0,0,0,,Олардың механик тобына еніңіз.
Dialogue: 0,0:05:09.47,0:05:11.47,Default,,0,0,0,,Машинаны еркелету.
Dialogue: 0,0:05:11.89,0:05:14.48,Default,,0,0,0,,Иә, жасырын кіргіңіз келе ме? Қалай?
Dialogue: 0,0:05:15.27,0:05:18.06,Default,,0,0,0,,Механик ретіндегі дағдыларыңызға кепілдік береді.
Dialogue: 0,0:05:18.19,0:05:20.15,Default,,0,0,0,,Біз арнайы қонақ шақырдық.
Dialogue: 0,0:05:21.11,0:05:24.36,Default,,0,0,0,,Бірде ағайынды Ибраһимге қарсы шықты
Dialogue: 0,0:05:24.49,0:05:26.20,Default,,0,0,0,,Мен батылдықпен...
Dialogue: 0,0:05:26.61,0:05:29.53,Default,,0,0,0,,Луи Мюллермен жалғызбасты сиыр
Dialogue: 0,0:05:29.66,0:05:31.41,Default,,0,0,0,,Оның әйелі Изабель.
Dialogue: 0,0:05:32.33,0:05:34.20,Default,,0,0,0,,Барлығыңызбен танысқаныма қуаныштымын.
Dialogue: 0,0:05:34.87,0:05:38.29,Default,,0,0,0,,Жоқ, жоқ, мен мүгедектер арбасын пайдалану қиындығынан өтуім керек.
Dialogue: 0,0:05:38.79,0:05:42.84,Default,,0,0,0,,Мен алаңдау үшін қандай да бір жолмен көмектесе аламын ба деп сұрадым.
Dialogue: 0,0:05:42.96,0:05:45.88,Default,,0,0,0,,Эй, мен әлі ештеңе естіген жоқпын.
Dialogue: 0,0:05:46.05,0:05:47.55,Default,,0,0,0,,Тез түсіндіріңіз.
Dialogue: 0,0:05:47.68,0:05:48.59,Default,,0,0,0,,Льюис
Dialogue: 0,0:05:50.43,0:05:54.56,Default,,0,0,0,,Hmph. Сонда сен мені алаяқтықпен көмектесуімді сұрап тұрсың ба?
Dialogue: 0,0:05:54.93,0:05:59.02,Default,,0,0,0,,Лоран Хель кейіпкерлері әдетте жақсы адамдар.
Dialogue: 0,0:05:59.15,0:06:00.81,Default,,0,0,0,,Мен өзімді әрекет етуге мәжбүрлеп жатырмын.
Dialogue: 0,0:06:00.94,0:06:02.23,Default,,0,0,0,,Қатысуға болмайды
Dialogue: 0,0:06:02.36,0:06:03.73,Default,,0,0,0,,Бұл жылы
Dialogue: 0,0:06:03.86,0:06:04.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:05.23,0:06:06.19,Default,,0,0,0,,Бұл – тұзақ екенінің дәлелі.
Dialogue: 0,0:06:06.32,0:06:07.57,Default,,0,0,0,,Сәлем Льюис!
Dialogue: 0,0:06:07.70,0:06:10.74,Default,,0,0,0,,Менің ағам Сэмді оның ақшасын ұрлаған соң өлтіріңіз.
Dialogue: 0,0:06:10.87,0:06:13.49,Default,,0,0,0,,Жалқау ағаңды жазала.
Dialogue: 0,0:06:14.12,0:06:16.16,Default,,0,0,0,,Олай болса мен сенімен қызметтес боламын.
Dialogue: 0,0:06:16.50,0:06:18.71,Default,,0,0,0,,Бұл біздің стиль емес.
Dialogue: 0,0:06:19.12,0:06:22.21,Default,,0,0,0,,Мен оларды банкротқа жіберген дұрыс деп ойлаймын.
Dialogue: 0,0:06:22.34,0:06:24.96,Default,,0,0,0,,(Льюистің ауыр тыныс алуы)
Dialogue: 0,0:06:25.09,0:06:27.97,Default,,0,0,0,,Менің денем осылай аяқталды!
Dialogue: 0,0:06:28.67,0:06:32.01,Default,,0,0,0,,Оны жойыңыз! Машиналарды және өтетін орынды өртеп жіберіңіз!
Dialogue: 0,0:06:32.14,0:06:33.55,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:33.68,0:06:34.93,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:06:40.06,0:06:43.36,Default,,0,0,0,,Мен ойлағаннан да сынған сияқты.
Dialogue: 0,0:06:43.48,0:06:44.44,Default,,0,0,0,,Эбби
Dialogue: 0,0:06:44.57,0:06:46.86,Default,,0,0,0,,Егер сізге ұнамаса, оған көмектесу мүмкін емес.
Dialogue: 0,0:06:47.07,0:06:50.20,Default,,0,0,0,,Мен сенімен бұл жолы кездескеніме қуаныштымын. Ерен еңбегіңіз үшін рахмет.
Dialogue: 0,0:06:50.32,0:06:51.20,Default,,0,0,0,,Хаа…
Dialogue: 0,0:06:52.07,0:06:55.66,Default,,0,0,0,,Өлсем де кешіріңіз, мен алаяқтыққа бей-жай еліктеушімін.
Dialogue: 0,0:06:55.79,0:06:59.62,Default,,0,0,0,,Бірақ сіз көмектесе аласыз, Изабель.
Dialogue: 0,0:06:59.75,0:07:00.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:02.21,0:07:04.59,Default,,0,0,0,,Өтінемін, үйге баруға рұқсат етіңізші.
Dialogue: 0,0:07:05.50,0:07:07.13,Default,,0,0,0,,Лондонда өрт болып жатыр!
Dialogue: 0,0:07:07.26,0:07:08.30,Default,,0,0,0,,Кевин, тыныштал.
Dialogue: 0,0:07:08.42,0:07:10.05,Default,,0,0,0,,Дик бөлмеде...
Dialogue: 0,0:07:10.17,0:07:12.39,Default,,0,0,0,,Иә? Сіз бойдақ емес пе едіңіз?
Dialogue: 0,0:07:12.59,0:07:14.47,Default,,0,0,0,,Дик – көк игуана
Dialogue: 0,0:07:14.60,0:07:15.64,Default,,0,0,0,,Игуана?
Dialogue: 0,0:07:15.76,0:07:19.06,Default,,0,0,0,,Аа, егер мұндай жағдай болса, мен Лондоннан кетпеуім керек еді.
Dialogue: 0,0:07:19.18,0:07:21.35,Default,,0,0,0,,Сіз әуе жарысын сынайсыз ба?
Dialogue: 0,0:07:21.48,0:07:24.19,Default,,0,0,0,,Осылай үйге барсам, жүзіңді көре алмаймын...
Dialogue: 0,0:07:24.73,0:07:25.61,Default,,0,0,0,,Кевин!
Dialogue: 0,0:07:27.02,0:07:28.48,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:07:28.65,0:07:31.57,Default,,0,0,0,,Біз не істеуіміз керек? Бізде механикалар таусылады.
Dialogue: 0,0:07:31.70,0:07:33.49,Default,,0,0,0,,Маған ондай адам керек емес.
Dialogue: 0,0:07:34.20,0:07:37.12,Default,,0,0,0,,О, мүмкін Кларк шығар?
Dialogue: 0,0:07:37.54,0:07:38.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.49,0:07:41.12,Default,,0,0,0,,Изабель! Жақсы көрінесің
Dialogue: 0,0:07:41.25,0:07:44.38,Default,,0,0,0,,Қараңызшы, бұл Льюистің әйелі, есіңде ме?
Dialogue: 0,0:07:44.50,0:07:46.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:46.21,0:07:47.04,Default,,0,0,0,,О
Dialogue: 0,0:07:47.34,0:07:49.59,Default,,0,0,0,,Қандай кездейсоқтық. Льюис де сенімен бірге ме?
Dialogue: 0,0:07:50.13,0:07:53.38,Default,,0,0,0,,Жоқ, мен әлі көп қозғала алмаймын...
Dialogue: 0,0:07:53.51,0:07:55.09,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:55.22,0:07:58.26,Default,,0,0,0,,Апатқа өкінемін.
Dialogue: 0,0:07:58.39,0:08:01.35,Default,,0,0,0,,Дегенмен, бұл спорттың қауіптілігі көп.
Dialogue: 0,0:08:01.48,0:08:03.48,Default,,0,0,0,,Хе, қай ауыз айтып жатыр екен...
Dialogue: 0,0:08:03.69,0:08:05.23,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:05.40,0:08:08.73,Default,,0,0,0,,Кешіріңіз, ол команданың бұрынғы механигі...
Dialogue: 0,0:08:08.86,0:08:10.03,Default,,0,0,0,,Механик…
Dialogue: 0,0:08:10.23,0:08:11.82,Default,,0,0,0,,Бұл Масато Эдамура.
Dialogue: 0,0:08:12.61,0:08:16.66,Default,,0,0,0,,Мен Льюис мырзаның командасына Австралияға қарсы ойыннан ғана қосылдым.
Dialogue: 0,0:08:17.70,0:08:20.54,Default,,0,0,0,,Ол әлі жас және талантты.
Dialogue: 0,0:08:20.66,0:08:24.25,Default,,0,0,0,,Сондықтан мен мұнда келдім, себебі мен сізге жаңа жұмыс табуға көмектескім келді...
Dialogue: 0,0:08:24.37,0:08:26.75,Default,,0,0,0,,Бірақ бұл өте қиын...
Dialogue: 0,0:08:27.21,0:08:28.29,Default,,0,0,0,,Шитанебе
Dialogue: 0,0:08:29.13,0:08:31.51,Default,,0,0,0,,Сол апатта мен ауыр жарақат алдым.
Dialogue: 0,0:08:31.96,0:08:35.68,Default,,0,0,0,,Мен бұл біздің кінәміз екеніне күмәнданамын.
Dialogue: 0,0:08:35.93,0:08:37.43,Default,,0,0,0,,Күмән дегенді қалай түсінесіңдер?
Dialogue: 0,0:08:37.55,0:08:40.01,Default,,0,0,0,,Басқа біреу қозғалтқышты бұзды.
Dialogue: 0,0:08:40.68,0:08:43.35,Default,,0,0,0,,Мен тек болжау арқылы мұндайды айтпас едім.
Dialogue: 0,0:08:43.48,0:08:46.40,Default,,0,0,0,,Бірақ мен өз шеберлігіме сенімдімін.
Dialogue: 0,0:08:47.86,0:08:52.19,Default,,0,0,0,,Шындығында, біз қосылғаннан бері Льюистің уақыты күрт жақсарды.
Dialogue: 0,0:08:53.15,0:08:54.65,Default,,0,0,0,,Егер ол дәл осылай ұшып кетсе...
Dialogue: 0,0:08:54.78,0:08:56.32,Default,,0,0,0,,Тоқта! (Кларк) Ха!
Dialogue: 0,0:08:56.95,0:08:59.37,Default,,0,0,0,,Дөрекі болғаным үшін кешіріңіз...
Dialogue: 0,0:09:00.16,0:09:01.74,Default,,0,0,0,,Сәлем Изабель!
Dialogue: 0,0:09:02.41,0:09:03.96,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:09:04.25,0:09:07.21,Default,,0,0,0,,Көптен бері көрмедім! Луис қалай?
Dialogue: 0,0:09:07.33,0:09:09.21,Default,,0,0,0,,Біртіндеп
Dialogue: 0,0:09:09.38,0:09:12.38,Default,,0,0,0,,Сонда ол? Керемет ұл
Dialogue: 0,0:09:12.92,0:09:13.97,Default,,0,0,0,,Бұл Эдамура.
Dialogue: 0,0:09:14.09,0:09:15.76,Default,,0,0,0,,Сен мен ойлағаннан да бала екенсің.
Dialogue: 0,0:09:15.88,0:09:18.09,Default,,0,0,0,,Бұл шынымен Құдайдың қолы деп аталады ма?
Dialogue: 0,0:09:18.55,0:09:19.60,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:19.72,0:09:21.10,Default,,0,0,0,,Сіз қайда оқыдыңыз?
Dialogue: 0,0:09:21.26,0:09:23.35,Default,,0,0,0,,Жапониядағы Наканошима өндірісі
Dialogue: 0,0:09:23.85,0:09:26.23,Default,,0,0,0,,Zero Fighter жасаған технологияны мұраға алу
Dialogue: 0,0:09:26.98,0:09:30.27,Default,,0,0,0,,Кешкі ас үстінде егжей-тегжейлерді талқылайық.
Dialogue: 0,0:09:30.77,0:09:32.53,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:32.94,0:09:34.24,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:09:34.36,0:09:37.74,Default,,0,0,0,,Бізбен сөйлескіңіз келе ме? Эда мырза...
Dialogue: 0,0:09:38.11,0:09:40.87,Default,,0,0,0,,Эдамура Бұл Масато Эдамура.
Dialogue: 0,0:09:41.20,0:09:43.24,Default,,0,0,0,,Кешіріңіз, бірақ менде алдын ала міндеттеме бар.
Dialogue: 0,0:09:43.37,0:09:46.25,Default,,0,0,0,,Иә, ол кіріп келеді.
Dialogue: 0,0:09:46.37,0:09:48.12,Default,,0,0,0,,Қарт қарттың командасына.
Dialogue: 0,0:09:48.25,0:09:49.38,Default,,0,0,0,,Эдамура мырза!
Dialogue: 0,0:09:49.71,0:09:51.84,Default,,0,0,0,,Ертең менің командама келіңіз!
Dialogue: 0,0:09:52.00,0:09:54.71,Default,,0,0,0,,Содан кейін қай топқа қосылу керектігін шешіңіз.
Dialogue: 0,0:09:56.72,0:09:59.55,Default,,0,0,0,,(Эдамаманың және басқалардың күлкісі)
Dialogue: 0,0:09:59.68,0:10:01.26,Default,,0,0,0,,Чорой Мондабе
Dialogue: 0,0:10:01.39,0:10:03.85,Default,,0,0,0,,Несиенің көп бөлігі Изабельге беріледі.
Dialogue: 0,0:10:04.06,0:10:05.52,Default,,0,0,0,,Сізді актриса ретіндегі дебютіңізбен құттықтаймыз
Dialogue: 0,0:10:05.64,0:10:06.48,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:10:06.60,0:10:10.48,Default,,0,0,0,,Мен әлі де қобалжып жүрмін, себебі бұл менің бірінші рет ойнауым.
Dialogue: 0,0:10:10.61,0:10:15.61,Default,,0,0,0,,Әйелдер актриса болып туылады дейді, бірақ олардың дауысы мен стилі дұрыс.
Dialogue: 0,0:10:15.78,0:10:18.53,Default,,0,0,0,,Олай болса, мұны қалай істеу керектігін неге көрсетпеймін?
Dialogue: 0,0:10:18.65,0:10:21.82,Default,,0,0,0,,Изабель Саған менімен араласудың қажеті жоқ.
Dialogue: 0,0:10:22.16,0:10:24.24,Default,,0,0,0,,Әй, мен алдымен қайтайын.
Dialogue: 0,0:10:24.37,0:10:25.79,Default,,0,0,0,,Қарғыс энергиясы оған ағып кетті. Мүмкін емес…
Dialogue: 0,0:10:26.33,0:10:27.96,Default,,0,0,0,,Дәрі таусылады
Dialogue: 0,0:10:28.08,0:10:29.96,Default,,0,0,0,,Мен оны өз бөлмеме қалдырдым.
Dialogue: 0,0:10:30.08,0:10:30.92,Default,,0,0,0,,Чи…
Dialogue: 0,0:10:31.79,0:10:34.71,Default,,0,0,0,,Хаа... Әрқашан солай.
Dialogue: 0,0:10:34.84,0:10:36.34,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:10:37.17,0:10:39.80,Default,,0,0,0,,Егер біз бірдеңе істей алатын болсақ, бізге айтыңыз.
Dialogue: 0,0:10:39.93,0:10:41.93,Default,,0,0,0,,Ахаха, ол шөптей өсіп жатыр ғой~
Dialogue: 0,0:10:42.60,0:10:45.22,Default,,0,0,0,,Неліктен Сэмге опасыздық жасап жеңуге тырыстың?
Dialogue: 0,0:10:47.14,0:10:48.18,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:10:48.31,0:10:52.44,Default,,0,0,0,,Егер ол жаңа ғана сценарийді орындаса, ол әлі де ұша алар еді.
Dialogue: 0,0:10:52.56,0:10:53.98,Default,,0,0,0,,Бұл сізге байланысты.
Dialogue: 0,0:10:57.11,0:10:58.03,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:58.57,0:11:02.16,Default,,0,0,0,,Ақымақ болғандықтан, бала болып қала бересің.
Dialogue: 0,0:11:03.82,0:11:04.66,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:11:04.78,0:11:08.04,Default,,0,0,0,,Оның қызу қандылығы бұрынғы жауынгер болғандықтан шығар.
Dialogue: 0,0:11:08.87,0:11:10.54,Default,,0,0,0,,Шынымен солай ма?
Dialogue: 0,0:11:11.12,0:11:14.42,Default,,0,0,0,,Льюис апатқа ұшырады, себебі машина бұрмаланған.
Dialogue: 0,0:11:14.71,0:11:18.59,Default,,0,0,0,,Бұл сіздің басынан бастап бүлік шығаруды жоспарлағаныңызды білдіре ме?
Dialogue: 0,0:11:19.01,0:11:22.34,Default,,0,0,0,,Бірақ Сэм мұны білді...
Dialogue: 0,0:11:22.47,0:11:24.68,Default,,0,0,0,,Иә? Кім қышиды?
Dialogue: 0,0:11:25.22,0:11:29.52,Default,,0,0,0,,Ал, оның орнына өз жұмысыңа көңіл бөл.
Dialogue: 0,0:11:29.68,0:11:30.85,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:11:30.98,0:11:32.35,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:11:32.48,0:11:35.86,Default,,0,0,0,,Ал, мен кейінірек шұңқырды аралаймын.
Dialogue: 0,0:11:36.94,0:11:38.61,Default,,0,0,0,,Бізде механизаторлар жеткіліксіз.
Dialogue: 0,0:11:38.98,0:11:42.66,Default,,0,0,0,,Сенбейтін адамды алып келсең, командаң ыдырап кетеді.
Dialogue: 0,0:11:42.78,0:11:45.32,Default,,0,0,0,,Ол жапондық туралы не ойлайсың?
Dialogue: 0,0:11:46.16,0:11:49.04,Default,,0,0,0,,Өзі тәкаппар еді, бірақ жаман адам емес сияқты.
Dialogue: 0,0:11:49.54,0:11:51.75,Default,,0,0,0,,Адамдарға көзің жетпейді.
Dialogue: 0,0:11:52.37,0:11:53.21,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:11:53.33,0:11:56.46,Default,,0,0,0,,Кем дегенде бір механик жетіспесе де проблема жоқ.
Dialogue: 0,0:11:56.59,0:11:59.09,Default,,0,0,0,,Одан да көп... (Кларк) Иә, мен жеңемін.
Dialogue: 0,0:12:01.63,0:12:05.59,Default,,0,0,0,,Дұрыс, бәрі сценарий бойынша.
Dialogue: 0,0:12:05.93,0:12:07.01,Default,,0,0,0,,Қанағаттанбады ма?
Dialogue: 0,0:12:09.47,0:12:10.47,Default,,0,0,0,,Кларк!
Dialogue: 0,0:12:11.18,0:12:12.35,Default,,0,0,0,,Соған ұқсайды ма?
Dialogue: 0,0:12:14.90,0:12:15.73,Default,,0,0,0,,Tsk
Dialogue: 0,0:12:17.44,0:12:19.32,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:12:22.32,0:12:24.99,Default,,0,0,0,,Иә? Бірге кірейік пе?
Dialogue: 0,0:12:25.32,0:12:26.82,Default,,0,0,0,,Сіз бұрынғы әскери адамсыз ба?
Dialogue: 0,0:12:26.95,0:12:28.99,Default,,0,0,0,,Не? (кран жабылған дыбыс)
Dialogue: 0,0:12:29.49,0:12:31.41,Default,,0,0,0,,Льюис бұрынғы әскери адам ба?
Dialogue: 0,0:12:31.54,0:12:32.46,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:33.33,0:12:34.62,Default,,0,0,0,,Мұны кім айтады?
Dialogue: 0,0:12:34.75,0:12:35.96,Default,,0,0,0,,Хигучи
Dialogue: 0,0:12:36.08,0:12:39.46,Default,,0,0,0,,Маған оның барлық материалдарын көрсетіңіз. Сіз оны зерттеп жатырсыз, солай ма?
Dialogue: 0,0:12:40.00,0:12:43.30,Default,,0,0,0,,Ал, мен саған көрсетемін, орамалды ана жаққа апара аласың ба?
Dialogue: 0,0:12:43.97,0:12:45.72,Default,,0,0,0,,(Төңкерілген парақ дыбысы)
Dialogue: 0,0:12:46.22,0:12:49.64,Default,,0,0,0,,Хаа... Қауіпсіздік мен күткеннен де жұмсақ.
Dialogue: 0,0:12:50.10,0:12:51.68,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:51.81,0:12:52.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:53.89,0:12:55.73,Default,,0,0,0,,Не... бірдеңе керек пе?
Dialogue: 0,0:12:56.52,0:12:58.15,Default,,0,0,0,,Масканы шешкеніңіз дұрыс...
Dialogue: 0,0:12:58.27,0:12:59.94,Default,,0,0,0,,Жаса! Эй... сәл күте тұрыңыз!
Dialogue: 0,0:13:00.07,0:13:01.40,Default,,0,0,0,,Коккооо~!
Dialogue: 0,0:13:04.36,0:13:06.03,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:13:06.49,0:13:08.32,Default,,0,0,0,,Хехе... Уау! (құлап түскен дыбыс)
Dialogue: 0,0:13:09.20,0:13:12.08,Default,,0,0,0,,Кешіріңіз. Өтінемін, мені кешірші. Мен бәрін істеймін!
Dialogue: 0,0:13:12.20,0:13:13.33,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:13:15.00,0:13:16.29,Default,,0,0,0,,Жылдам болды, мен тартамын.
Dialogue: 0,0:13:16.42,0:13:17.88,Default,,0,0,0,,（）
Dialogue: 0,0:13:19.04,0:13:19.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:23.26,0:13:24.42,Default,,0,0,0,,(үлкен күрсіну)
Dialogue: 0,0:13:25.17,0:13:29.09,Default,,0,0,0,,Ол Сэмнің қолбасшысы болуы керек. Оның қаншалықты жабайы екеніне таң қаламын.
Dialogue: 0,0:13:29.35,0:13:31.93,Default,,0,0,0,,Көшбасшы тәрізді жігіт: «Бұл тез болды», - деді.
Dialogue: 0,0:13:32.06,0:13:33.64,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:13:33.77,0:13:36.31,Default,,0,0,0,,Келіңіздер ме? Бұл қашу жылдамдығы ма?
Dialogue: 0,0:13:36.44,0:13:39.36,Default,,0,0,0,,Ертең олардың орнына баруға болады ма?
Dialogue: 0,0:13:39.48,0:13:40.69,Default,,0,0,0,,Саана
Dialogue: 0,0:13:41.07,0:13:43.94,Default,,0,0,0,,Бірақ Кларк бізді қалайды.
Dialogue: 0,0:13:44.74,0:13:47.15,Default,,0,0,0,,Лоран Маған бірнеше адамдарды қарызға алу керек.
Dialogue: 0,0:13:47.32,0:13:49.45,Default,,0,0,0,,Төлем - хайнандық тауық күріш.
Dialogue: 0,0:13:49.57,0:13:52.37,Default,,0,0,0,,Қарсы емеспін, бірақ мен сенен жақсы нәрсе жасауыңды өтінемін.
Dialogue: 0,0:13:52.87,0:13:54.20,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:13:55.25,0:13:56.21,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:56.33,0:13:57.87,Default,,0,0,0,,Эй, сен осындасың.
Dialogue: 0,0:13:58.42,0:14:00.71,Default,,0,0,0,,Сізге рахмет, мен кеше жақсы өттім.
Dialogue: 0,0:14:01.09,0:14:03.46,Default,,0,0,0,,ше? Не айтқың келеді?
Dialogue: 0,0:14:03.80,0:14:04.92,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:05.05,0:14:06.26,Default,,0,0,0,,Мені жұмысқа алсаңыз...
Dialogue: 0,0:14:06.38,0:14:07.68,Default,,0,0,0,,Тест тапсыру
Dialogue: 0,0:14:08.30,0:14:09.34,Default,,0,0,0,,Тест?
Dialogue: 0,0:14:09.47,0:14:10.89,Default,,0,0,0,,Қандай қарапайымдылық
Dialogue: 0,0:14:11.01,0:14:13.06,Default,,0,0,0,,Менің машинамды тезірек жасай аласыз деп үміттенемін.
Dialogue: 0,0:14:13.43,0:14:16.98,Default,,0,0,0,,Құдайдың қолын дәлелдеймін.
Dialogue: 0,0:14:17.60,0:14:19.94,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,0:14:26.90,0:14:29.36,Default,,0,0,0,,Жарайды, енді операцияны тексеріңіз.
Dialogue: 0,0:14:29.53,0:14:30.53,Default,,0,0,0,,Сіз маған көлік бере аласыз ба?
Dialogue: 0,0:14:30.66,0:14:31.49,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:33.08,0:14:36.12,Default,,0,0,0,,Бұл өте кең таралған техникалық қызмет көрсету. Ештеңе өзгермейді.
Dialogue: 0,0:14:36.62,0:14:38.50,Default,,0,0,0,,Қарапайым адамға солай көрінеді.
Dialogue: 0,0:14:39.37,0:14:40.33,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:14:40.46,0:14:45.21,Default,,0,0,0,,Пропеллер дегеніміз не? Бұл ауыр химия мен сұйықтық механикасының біріктірілген өнері.
Dialogue: 0,0:14:45.67,0:14:48.92,Default,,0,0,0,,Бұрандаларды бұрау Тек май қосу арқылы
Dialogue: 0,0:14:49.05,0:14:52.34,Default,,0,0,0,,Ұшу қашықтығы мен жылдамдығы толығымен өзгереді.
Dialogue: 0,0:14:52.68,0:14:55.10,Default,,0,0,0,,Мұны бәрі де түсінбейді.
Dialogue: 0,0:14:55.35,0:14:56.56,Default,,0,0,0,,Тек ауыз
Dialogue: 0,0:14:56.72,0:14:58.10,Default,,0,0,0,,Ұшайық
Dialogue: 0,0:14:58.23,0:14:59.52,Default,,0,0,0,,Сіз ұшқанда білесіз
Dialogue: 0,0:15:11.11,0:15:12.20,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:15:12.32,0:15:13.91,Default,,0,0,0,,Ол әлдеқайда жақсарды.
Dialogue: 0,0:15:14.12,0:15:16.99,Default,,0,0,0,,Кездейсоқ нәрселерді айтпаңыз. Бұл орташа уақыт.
Dialogue: 0,0:15:17.41,0:15:19.41,Default,,0,0,0,,Сондықтан өнерпаздар қиындыққа тап болуы керек.
Dialogue: 0,0:15:19.54,0:15:20.58,Default,,0,0,0,,Не?
Dialogue: 0,0:15:20.83,0:15:23.75,Default,,0,0,0,,Уақытымның жақсармауының себебі желдің бағыты болды.
Dialogue: 0,0:15:24.21,0:15:26.96,Default,,0,0,0,,Сіз бұл рейсті көргенде де дұрыс түсінбедіңіз бе?
Dialogue: 0,0:15:27.21,0:15:29.63,Default,,0,0,0,,Кларк мырза, мен оны қарап тұрдым!
Dialogue: 0,0:15:29.76,0:15:32.18,Default,,0,0,0,,Осы жылы сіз айтарлықтай жақсардыңыз.
Dialogue: 0,0:15:32.30,0:15:35.93,Default,,0,0,0,,Жеделдеу, реакция... Барлығы бір саты жоғары тұрғандай сезіледі.
Dialogue: 0,0:15:36.26,0:15:38.60,Default,,0,0,0,,Бүйірден қарасаң да көруге болады.
Dialogue: 0,0:15:38.72,0:15:40.27,Default,,0,0,0,,Сіз ұшақты ауыстырдыңыз ба?
Dialogue: 0,0:15:40.81,0:15:43.15,Default,,0,0,0,,Кларктың өзі де солай сезінгеніне сенімдімін.
Dialogue: 0,0:15:43.27,0:15:45.65,Default,,0,0,0,,Жоғары ұшқыш айырмашылықты біледі.
Dialogue: 0,0:15:45.94,0:15:50.36,Default,,0,0,0,,Жарайды... дұрыс, мен міндетті түрде жауап болған сияқтымын.
Dialogue: 0,0:15:50.57,0:15:54.66,Default,,0,0,0,,Негізгі қанат пен құйрықтың бұрышын түзетсеңіз, уақыт одан да артады.
Dialogue: 0,0:15:55.03,0:15:57.33,Default,,0,0,0,,Сэм, оны жұмысқа алайық.
Dialogue: 0,0:15:57.53,0:16:00.16,Default,,0,0,0,,Бастық бізге сене алмайтын сияқты.
Dialogue: 0,0:16:00.29,0:16:01.91,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:16:02.04,0:16:05.58,Default,,0,0,0,,Жарайды, мен Синтия командасымен сөйлесіп жатырмын.
Dialogue: 0,0:16:05.71,0:16:06.92,Default,,0,0,0,,Олай болса (Кларк) А...
Dialogue: 0,0:16:07.25,0:16:09.63,Default,,0,0,0,,Менің ағам сен туралы осылай деді.
Dialogue: 0,0:16:09.84,0:16:12.13,Default,,0,0,0,,«Ол тәкаппар, бірақ ол жаман адам емес».
Dialogue: 0,0:16:13.18,0:16:15.14,Default,,0,0,0,,Мен сәл басқашамын
Dialogue: 0,0:16:15.39,0:16:19.14,Default,,0,0,0,,Өзім айтсам да, жаман адаммын.
Dialogue: 0,0:16:19.26,0:16:21.23,Default,,0,0,0,,Ол тым-тырыс адам.
Dialogue: 0,0:16:21.81,0:16:23.14,Default,,0,0,0,,Сондықтан мен түсінемін.
Dialogue: 0,0:16:23.39,0:16:25.77,Default,,0,0,0,,Бұл мұрын иістерді анықтайды
Dialogue: 0,0:16:26.19,0:16:28.23,Default,,0,0,0,,Мен сияқты иіс
Dialogue: 0,0:16:28.73,0:16:30.32,Default,,0,0,0,,Сіз ақымақсыз
Dialogue: 0,0:16:31.11,0:16:32.57,Default,,0,0,0,,Бұл маскалар ше?
Dialogue: 0,0:16:32.70,0:16:33.53,Default,,0,0,0,,Саана
Dialogue: 0,0:16:33.65,0:16:34.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:34.99,0:16:36.03,Default,,0,0,0,,Сэм... Сэм!
Dialogue: 0,0:16:36.16,0:16:38.91,Default,,0,0,0,,Айтсаң, жамансың ба маған бәрібір.
Dialogue: 0,0:16:39.03,0:16:40.33,Default,,0,0,0,,Әңгімелесейік! Не!
Dialogue: 0,0:16:40.87,0:16:43.21,Default,,0,0,0,,Мен тым дөрекі сөз айттым.
Dialogue: 0,0:16:43.66,0:16:44.92,Default,,0,0,0,,Мен бұл жігіттер туралы білмеймін.
Dialogue: 0,0:16:45.04,0:16:48.38,Default,,0,0,0,,Олай айтпа... уф!
Dialogue: 0,0:16:48.84,0:16:51.51,Default,,0,0,0,,Мен бұл жігіттер туралы білмеймін!
Dialogue: 0,0:16:51.63,0:16:54.38,Default,,0,0,0,,Президент, мен сізді ұстадым. Мені өлтіргің келе ме?
Dialogue: 0,0:16:55.13,0:16:58.39,Default,,0,0,0,,Тазалау – қиыншылық. Сол жерде жасаңыз.
Dialogue: 0,0:16:58.93,0:16:59.85,Default,,0,0,0,,Кешіріңіз, мазаладым.
Dialogue: 0,0:17:00.51,0:17:03.10,Default,,0,0,0,,Күте тұрыңыз! Масатомен не істейміз?
Dialogue: 0,0:17:03.52,0:17:05.35,Default,,0,0,0,,Сұрамағаныңыз жөн
Dialogue: 0,0:17:05.48,0:17:06.98,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:17:07.52,0:17:08.77,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:17:08.90,0:17:12.15,Default,,0,0,0,,Ол Луи Мюллердің меценаты болды.
Dialogue: 0,0:17:12.28,0:17:13.11,Default,,0,0,0,,Патрон?
Dialogue: 0,0:17:13.69,0:17:16.49,Default,,0,0,0,,Осы жігіттің кесірінен Льюис қалпына келе алмайды.
Dialogue: 0,0:17:16.61,0:17:18.07,Default,,0,0,0,,Команда таратылды
Dialogue: 0,0:17:18.20,0:17:19.87,Default,,0,0,0,,Біз үлкен тапшылыққа тап болдық.
Dialogue: 0,0:17:20.62,0:17:22.83,Default,,0,0,0,,Масато не істеді?
Dialogue: 0,0:17:23.04,0:17:25.16,Default,,0,0,0,,Ол Льюисті ашуландырды.
Dialogue: 0,0:17:25.50,0:17:27.21,Default,,0,0,0,,«Машина өнімділігі біркелкі»
Dialogue: 0,0:17:27.33,0:17:30.25,Default,,0,0,0,,«Қалғаны бір-бірінің шеберлігіне байланысты».
Dialogue: 0,0:17:30.50,0:17:34.63,Default,,0,0,0,,-де барын салған бейшара Льюис - бұл бейбақ.
Dialogue: 0,0:17:35.42,0:17:39.64,Default,,0,0,0,,Алайда бұл жігіттің шын мақсаты басқа еді.
Dialogue: 0,0:17:39.89,0:17:41.39,Default,,0,0,0,,Жер асты казино
Dialogue: 0,0:17:41.76,0:17:43.31,Default,,0,0,0,,Құпия казино…
Dialogue: 0,0:17:43.56,0:17:44.52,Default,,0,0,0,,О
Dialogue: 0,0:17:44.64,0:17:47.90,Default,,0,0,0,,Әуе жарыстарын көздейтін астыртын казино бар сияқты.
Dialogue: 0,0:17:48.60,0:17:51.90,Default,,0,0,0,,Сонымен, жоспар ұзақ уақыт өткен Льюиске бәс тігу болды.
Dialogue: 0,0:17:52.02,0:17:55.86,Default,,0,0,0,,О? Сіз Льюисті өлтірген боларсыз!
Dialogue: 0,0:17:55.99,0:17:57.78,Default,,0,0,0,,Жоқ? Эй! Уф...
Dialogue: 0,0:17:58.49,0:17:59.91,Default,,0,0,0,,Мына қоқысты алып кетіңіз.
Dialogue: 0,0:18:00.03,0:18:00.95,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:18:01.12,0:18:01.95,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:18:02.49,0:18:03.41,Default,,0,0,0,,Қанша?
Dialogue: 0,0:18:03.58,0:18:04.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:05.37,0:18:07.92,Default,,0,0,0,,Мен бұл қоқысты сатып аламын.
Dialogue: 0,0:18:10.63,0:18:12.00,Default,,0,0,0,,(Ағып жатқан судың дыбысы)
Dialogue: 0,0:18:12.13,0:18:15.42,Default,,0,0,0,,Тағы да рахмет. Көмегіңіз үшін рақмет.
Dialogue: 0,0:18:15.84,0:18:16.97,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:18:17.09,0:18:21.18,Default,,0,0,0,,Шынымды айтсам, менде Льюис туралы түрлі сезімдер болды.
Dialogue: 0,0:18:21.93,0:18:24.01,Default,,0,0,0,,Қалай болғанда да, мен сізді шақырғаныма қуаныштымын.
Dialogue: 0,0:18:24.14,0:18:24.97,Default,,0,0,0,,Эй?
Dialogue: 0,0:18:25.27,0:18:26.31,Default,,0,0,0,,(кран жабылған дыбыс)
Dialogue: 0,0:18:26.56,0:18:28.98,Default,,0,0,0,,Мен өз түрімді жақсы көремін
Dialogue: 0,0:18:29.23,0:18:31.77,Default,,0,0,0,,Мен сияқты жаман адам болуды доғар.
Dialogue: 0,0:18:32.31,0:18:35.48,Default,,0,0,0,,Мен өзін жақсы адам деп санайтын адамға қарағанда сенімдімін.
Dialogue: 0,0:18:35.94,0:18:38.74,Default,,0,0,0,,Алайда жұмысқа қабылдаудың бір шарты бар.
Dialogue: 0,0:18:38.86,0:18:40.16,Default,,0,0,0,,Не?
Dialogue: 0,0:18:40.82,0:18:44.37,Default,,0,0,0,,Маған сол астыртын казиноны көрсетіңіз.
Dialogue: 0,0:18:44.87,0:18:46.95,Default,,0,0,0,,Мен саған ілесе алмаймын.
Dialogue: 0,0:18:48.91,0:18:50.42,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:18:50.67,0:18:52.21,Default,,0,0,0,,Егер олар Сэм Ибрахим екенін білсе...
Dialogue: 0,0:18:52.33,0:18:53.42,Default,,0,0,0,,Ұсталмаңыз
Dialogue: 0,0:18:55.09,0:18:57.17,Default,,0,0,0,,Қош келдіңіз, Эдамура мырза
Dialogue: 0,0:19:00.13,0:19:00.97,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:01.51,0:19:02.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:02.47,0:19:04.22,Default,,0,0,0,,Мынау... бұл менің серігім.
Dialogue: 0,0:19:04.35,0:19:05.43,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:05.68,0:19:07.27,Default,,0,0,0,,No 7 Маллери қызу қуғында
Dialogue: 0,0:19:07.39,0:19:09.94,Default,,0,0,0,,№ 15 Біреуі ақыры Мэллериден өтті.
Dialogue: 0,0:19:10.06,0:19:11.73,Default,,0,0,0,,Бұл мақсат. Тапсырыс аяқталуда...
Dialogue: 0,0:19:12.48,0:19:14.69,Default,,0,0,0,,Мен мұндай жер бар деп ойламаппын
Dialogue: 0,0:19:15.07,0:19:17.53,Default,,0,0,0,,Құмар ойындары ұтыс ойындарының бөлігі болып табылады.
Dialogue: 0,0:19:18.65,0:19:19.49,Default,,0,0,0,,Мынау...
Dialogue: 0,0:19:19.82,0:19:22.57,Default,,0,0,0,,Эдамура мырза, біраз уақыт өтті.
Dialogue: 0,0:19:22.95,0:19:25.58,Default,,0,0,0,,Бұл сіздің тұтынушы ретінде бірінші рет болуыңыз.
Dialogue: 0,0:19:25.70,0:19:27.62,Default,,0,0,0,,Бұл Лоран, менеджер.
Dialogue: 0,0:19:28.00,0:19:29.33,Default,,0,0,0,,Менің досым...
Dialogue: 0,0:19:29.45,0:19:31.54,Default,,0,0,0,,Бұл Майк. Майк Портной.
Dialogue: 0,0:19:31.67,0:19:33.83,Default,,0,0,0,,Уау! Сол барабаншы?
Dialogue: 0,0:19:33.96,0:19:36.84,Default,,0,0,0,,Жоқ, мен түрік мейрамханасын басқарамын.
Dialogue: 0,0:19:36.96,0:19:38.46,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:38.59,0:19:40.76,Default,,0,0,0,,Әлемдегі ең ыстық казиноға қош келдіңіз
Dialogue: 0,0:19:41.09,0:19:44.47,Default,,0,0,0,,Біздің дүкен мүшелік жүйесі болып табылады және ұтыс көлемі шексіз.
Dialogue: 0,0:19:44.60,0:19:47.72,Default,,0,0,0,,Біз тек қолма-қол ақшаны қабылдаймыз.
Dialogue: 0,0:19:47.85,0:19:52.52,Default,,0,0,0,,Артқы жағында VIP орындар бар, сондықтан қараңызшы.
Dialogue: 0,0:19:52.64,0:19:56.61,Default,,0,0,0,,Жарайды, VIP сияқты ләззат алайық.
Dialogue: 0,0:19:58.23,0:20:00.69,Default,,0,0,0,,Ағылшын тіліңіз айтарлықтай жақсарды.
Dialogue: 0,0:20:00.82,0:20:03.95,Default,,0,0,0,,Мен осы командаға қосылғым келгендіктен көп оқыдым.
Dialogue: 0,0:20:04.11,0:20:05.53,Default,,0,0,0,,Мен оны сенен жақсы айта аламын.
Dialogue: 0,0:20:05.66,0:20:06.49,Default,,0,0,0,,Хмф!
Dialogue: 0,0:20:06.62,0:20:08.95,Default,,0,0,0,,Менімен күліп сөйлеспе!
Dialogue: 0,0:20:09.62,0:20:10.75,Default,,0,0,0,,Неге ашуланасың?
Dialogue: 0,0:20:11.29,0:20:13.62,Default,,0,0,0,,Неліктен олардың жеке басын жасырдың?
Dialogue: 0,0:20:13.83,0:20:14.92,Default,,0,0,0,,Мына жігіттер?
Dialogue: 0,0:20:15.04,0:20:16.96,Default,,0,0,0,,Ким және бұзақылар Тачидабе
Dialogue: 0,0:20:17.09,0:20:19.76,Default,,0,0,0,,Ах! Қызық емес пе?
Dialogue: 0,0:20:20.17,0:20:23.55,Default,,0,0,0,,Мен кеше түсінбеушіліктен саған шабуыл жасаған сияқтымын.
Dialogue: 0,0:20:23.76,0:20:25.09,Default,,0,0,0,,Жылдам болды, мен тартамын.
Dialogue: 0,0:20:25.30,0:20:26.43,Default,,0,0,0,,Өте орынды!
Dialogue: 0,0:20:26.55,0:20:27.93,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:20:28.26,0:20:31.56,Default,,0,0,0,,Сені осында әкелгенім жақсы емес пе?
Dialogue: 0,0:20:32.10,0:20:34.73,Default,,0,0,0,,Қараңдар, мен бақыттымын.
Dialogue: 0,0:20:34.85,0:20:39.23,Default,,0,0,0,,Жүр, түрік мейрамханасының түбі жоқ шұңқырына сүңгейік.
Dialogue: 0,0:20:39.36,0:20:41.03,Default,,0,0,0,,Жалқау
Dialogue: 0,0:20:51.16,0:20:57.17,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.73,0:22:50.74,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.24,0:22:58.24,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory