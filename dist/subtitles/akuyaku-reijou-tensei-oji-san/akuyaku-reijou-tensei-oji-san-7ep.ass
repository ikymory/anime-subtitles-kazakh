Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.42,0:00:11.42,Default,,0,0,0,,Оверн герцогтерінің үйі
Dialogue: 0,0:00:12.13,0:00:16.22,Default,,0,0,0,,Керемет сарай мен кең бақтарды ұстау
Dialogue: 0,0:00:16.30,0:00:19.93,Default,,0,0,0,,Қызметкерлердің көп саны тұрғын ретінде жұмыс істейді.
Dialogue: 0,0:00:20.02,0:00:23.85,Default,,0,0,0,,Ал Ұстаз – Ол.
Dialogue: 0,0:00:23.94,0:00:25.44,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:00:27.11,0:00:30.48,Default,,0,0,0,,Леопольд, Оверн герцогы
Dialogue: 0,0:00:32.03,0:00:37.03,Default,,0,0,0,,♪～
Dialogue: 0,0:01:56.90,0:02:01.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:03.87,0:02:05.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:06.16,0:02:07.46,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:02:11.58,0:02:13.04,Default,,0,0,0,,Әке!
Dialogue: 0,0:02:14.34,0:02:16.63,Default,,0,0,0,,О, Рақым!
Dialogue: 0,0:02:17.63,0:02:19.59,Default,,0,0,0,,Ешқандай өзгеріс болған жоқ па?
Dialogue: 0,0:02:19.68,0:02:20.51,Default,,0,0,0,,Иә
Dialogue: 0,0:02:20.59,0:02:23.68,Default,,0,0,0,,Өткен айда аттан құлап қалғаныңды естігенде.
Dialogue: 0,0:02:23.76,0:02:26.06,Default,,0,0,0,,Мен өзімді тірі сезінбедім.
Dialogue: 0,0:02:26.64,0:02:29.31,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:02:29.39,0:02:33.31,Default,,0,0,0,,Көріп тұрғаныңыздай, қазір ештеңе болып жатқан жоқ, әке.
Dialogue: 0,0:02:33.40,0:02:36.40,Default,,0,0,0,,көремін.
Dialogue: 0,0:02:36.48,0:02:37.99,Default,,0,0,0,,Барлығы бірдей емес пе?
Dialogue: 0,0:02:38.07,0:02:39.45,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:02:39.53,0:02:41.57,Default,,0,0,0,,Герцог Леопольд Оверн
Dialogue: 0,0:02:41.66,0:02:44.83,Default,,0,0,0,,Грейстің әкесі және елдің қаржы министрі.
Dialogue: 0,0:02:44.91,0:02:47.45,Default,,0,0,0,,Мен жиі жұмыс бабымен үйден алыс боламын.
Dialogue: 0,0:02:47.54,0:02:50.62,Default,,0,0,0,,Бұл менің үйге екі айдан кейін бірінші рет келуім.
Dialogue: 0,0:02:50.71,0:02:52.63,Default,,0,0,0,,Кез келген нәрсе болуы мүмкін
Dialogue: 0,0:02:50.71,0:02:52.63,Default,,0,0,0,,Ақсүйектер қауымының төбесі бола отырып, ол өте абыройлы.
Dialogue: 0,0:02:52.63,0:02:52.71,Default,,0,0,0,,Ақсүйектер қауымының шыңы болғандықтан, ол өте абыройлы.
Dialogue: 0,0:02:52.71,0:02:54.54,Default,,0,0,0,,Ақсүйектер қауымының шыңы болғандықтан, ол өте абыройлы.
Dialogue: 0,0:02:52.71,0:02:54.54,Default,,0,0,0,,Күн сайын, егжей-тегжейлі
Dialogue: 0,0:02:54.54,0:02:54.63,Default,,0,0,0,,Ақсүйектер қауымының шыңы болғандықтан, ол өте абыройлы.
Dialogue: 0,0:02:54.63,0:02:55.25,Default,,0,0,0,,Ақсүйектер қауымының төбесі бола отырып, ол өте абыройлы.
Dialogue: 0,0:02:54.63,0:02:55.25,Default,,0,0,0,,Өзіңізді мінсіз күйде ұстаңыз.
Dialogue: 0,0:02:55.25,0:02:55.34,Default,,0,0,0,,Өзіңізді мінсіз күйде ұстаңыз.
Dialogue: 0,0:02:55.34,0:02:56.84,Default,,0,0,0,,Өзіңізді мінсіз күйде ұстаңыз.
Dialogue: 0,0:02:55.34,0:02:56.84,Default,,0,0,0,,Жасы биыл 45 жаста
Dialogue: 0,0:02:56.84,0:02:56.92,Default,,0,0,0,,Жасы биыл 45 жаста
Dialogue: 0,0:02:56.92,0:02:58.46,Default,,0,0,0,,Жасы биыл 45 жаста
Dialogue: 0,0:02:56.92,0:02:58.46,Default,,0,0,0,,Тек мен және Грейс емес
Dialogue: 0,0:02:58.46,0:02:58.55,Default,,0,0,0,,Бұл тек мен және Грейс емес.
Dialogue: 0,0:02:58.55,0:02:59.05,Default,,0,0,0,,Бұл тек мен және Грейс емес.
Dialogue: 0,0:02:58.55,0:02:59.05,Default,,0,0,0,,Ішіндегі адам менен кіші.
Dialogue: 0,0:02:59.05,0:02:59.13,Default,,0,0,0,,Ішіндегі адам менен кіші.
Dialogue: 0,0:02:59.13,0:03:00.80,Default,,0,0,0,,Ішіндегі адам менен кіші.
Dialogue: 0,0:02:59.13,0:03:00.80,Default,,0,0,0,,Бәріңіз де, Оверн отбасынан.
Dialogue: 0,0:03:00.80,0:03:00.88,Default,,0,0,0,,Ішіндегі адам менен кіші.
Dialogue: 0,0:03:00.88,0:03:02.55,Default,,0,0,0,,Ішіндегі адам менен кіші.
Dialogue: 0,0:03:00.88,0:03:02.55,Default,,0,0,0,,Мүше болу
Dialogue: 0,0:03:02.64,0:03:04.97,Default,,0,0,0,,Бұл кінә сезімі қандай?
Dialogue: 0,0:03:02.64,0:03:04.97,Default,,0,0,0,,Армандауды ұмытпаңыз
Dialogue: 0,0:03:05.05,0:03:07.35,Default,,0,0,0,,Иә, Себастьян, бұл.
Dialogue: 0,0:03:07.93,0:03:10.85,Default,,0,0,0,,Грейс, менің саған кәдесыйым бар.
Dialogue: 0,0:03:12.44,0:03:14.36,Default,,0,0,0,,Не болды? Тез әкел
Dialogue: 0,0:03:14.44,0:03:16.65,Default,,0,0,0,,Бұл... Иә, сэр.
Dialogue: 0,0:03:16.73,0:03:17.78,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:17.86,0:03:20.78,Default,,0,0,0,,Қазір бұл жерде болмаған дұрыс емес пе?
Dialogue: 0,0:03:20.86,0:03:22.32,Default,,0,0,0,,Тамағыңызды бітіріңіз
Dialogue: 0,0:03:22.41,0:03:24.74,Default,,0,0,0,,Сабыр еткеннен кейін жақсы...
Dialogue: 0,0:03:24.82,0:03:25.99,Default,,0,0,0,,Не айтып тұрсың өзі?
Dialogue: 0,0:03:26.08,0:03:28.45,Default,,0,0,0,,Неғұрлым тезірек болса, соғұрлым жақсы, солай ма?
Dialogue: 0,0:03:35.84,0:03:38.84,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл жақсы тербелетін ат
Dialogue: 0,0:03:38.92,0:03:43.01,Default,,0,0,0,,Мен оны ағаш өңдеу танымал қаладан кездейсоқ тауып алдым, мен оны алдым.
Dialogue: 0,0:03:43.09,0:03:44.89,Default,,0,0,0,,-Аа... -Хахахаха...
Dialogue: 0,0:03:44.97,0:03:46.64,Default,,0,0,0,,-Ммм...
Dialogue: 0,0:03:46.72,0:03:49.27,Default,,0,0,0,,Ах~ Мынау ма?
Dialogue: 0,0:03:49.35,0:03:52.69,Default,,0,0,0,,Грейс 5-6 жасында тербелетін атқа мінгенді ұнататын.
Dialogue: 0,0:03:52.77,0:03:58.65,Default,,0,0,0,,Мен сол кездегі сезімімді ескере отырып, кәдесый таңдадым.
Dialogue: 0,0:03:58.73,0:04:02.90,Default,,0,0,0,,Егер түпнұсқа Грейс осындай нәрсені көрсе...
Dialogue: 0,0:04:02.99,0:04:05.87,Default,,0,0,0,,Мен қазірдің өзінде 15 жастағы ханыммын!
Dialogue: 0,0:04:05.95,0:04:07.28,Default,,0,0,0,,Әкем мені әлі де жақсы көреді
Dialogue: 0,0:04:07.37,0:04:10.58,Default,,0,0,0,,Сіз өзіңізді жақсы баламын деп ойлайсыз!?
Dialogue: 0,0:04:10.66,0:04:12.75,Default,,0,0,0,,Міне осылай болады.
Dialogue: 0,0:04:13.25,0:04:16.25,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:04:17.38,0:04:20.13,Default,,0,0,0,,(тербелген аттың дыбысы)
Dialogue: 0,0:04:20.63,0:04:22.30,Default,,0,0,0,,-Әке -сәлем
Dialogue: 0,0:04:23.01,0:04:26.89,Default,,0,0,0,,Сіз күткендей, мені есіңе түсірдің.
Dialogue: 0,0:04:27.51,0:04:28.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:28.60,0:04:31.72,Default,,0,0,0,,Келесі айда немере ағам Франсуаның туған күніне.
Dialogue: 0,0:04:31.81,0:04:33.56,Default,,0,0,0,,Жақсы сыйлықтар бар ма?
Dialogue: 0,0:04:34.06,0:04:36.19,Default,,0,0,0,,Мен іздеген нәрсе
Dialogue: 0,0:04:36.27,0:04:40.53,Default,,0,0,0,,Кензабуро әп-сәтте Грейстің жадын ақтарды.
Dialogue: 0,0:04:41.19,0:04:43.74,Default,,0,0,0,,О, маған ұнамайды, Себастьян.
Dialogue: 0,0:04:43.82,0:04:47.95,Default,,0,0,0,,Мына ағаш атты мен үшін кәдесый деп ойладың ба?
Dialogue: 0,0:04:48.03,0:04:48.91,Default,,0,0,0,,Ха...
Dialogue: 0,0:04:48.99,0:04:51.37,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:04:51.45,0:04:53.29,Default,,0,0,0,,Мұқият ойлан
Dialogue: 0,0:04:53.37,0:04:58.13,Default,,0,0,0,,Мен 15 жасар қызыма кәдесый ретінде тербелетін ат сатып аламын деп ойламаппын.
Dialogue: 0,0:04:58.21,0:05:01.25,Default,,0,0,0,,Сенің әкеңнің бұлай істеуі мүмкін емес, солай ма?
Dialogue: 0,0:05:01.34,0:05:02.76,Default,,0,0,0,,Га
Dialogue: 0,0:05:02.84,0:05:04.26,Default,,0,0,0,,-А-а?
Dialogue: 0,0:05:04.34,0:05:07.39,Default,,0,0,0,,Сіз дәл солай айттыңыз!
Dialogue: 0,0:05:07.47,0:05:08.55,Default,,0,0,0,,Күйеуім күткендей.
Dialogue: 0,0:05:08.55,0:05:09.22,Default,,0,0,0,,Күйеуім күткендей.
Dialogue: 0,0:05:08.55,0:05:09.22,Default,,0,0,0,,(қызметшілерді қолдау)
Dialogue: 0,0:05:09.22,0:05:09.30,Default,,0,0,0,,(қыздардың қошеметі)
Dialogue: 0,0:05:09.30,0:05:10.47,Default,,0,0,0,,(Қызметшілердің қошеметі)
Dialogue: 0,0:05:09.30,0:05:10.47,Default,,0,0,0,,Грейс үшін дәл бір нәрсені таңдағаныңызға сене алмаймын.
Dialogue: 0,0:05:10.47,0:05:14.27,Default,,0,0,0,,Грейс үшін соншалықты дәл таңдағаныңызға сене алмаймын.
Dialogue: 0,0:05:14.35,0:05:16.94,Default,,0,0,0,,- Иә? - Күйеуіңіз күткендей!
Dialogue: 0,0:05:14.35,0:05:16.94,Default,,0,0,0,,(қызметшілерді қолдау)
Dialogue: 0,0:05:16.94,0:05:17.02,Default,,0,0,0,,(Қызметшілердің қошеметі)
Dialogue: 0,0:05:17.02,0:05:18.23,Default,,0,0,0,,(Қызметшілердің қошеметі)
Dialogue: 0,0:05:17.02,0:05:18.23,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:05:18.23,0:05:18.31,Default,,0,0,0,,(Қызметшілердің қошеметі)
Dialogue: 0,0:05:18.31,0:05:20.19,Default,,0,0,0,,(Қызметшілердің қошеметі)
Dialogue: 0,0:05:18.31,0:05:20.19,Default,,0,0,0,,Тамаша жұмыс, Грейс!
Dialogue: 0,0:05:20.19,0:05:20.27,Default,,0,0,0,,(Қызметшілердің қошеметі)
Dialogue: 0,0:05:20.27,0:05:21.36,Default,,0,0,0,,(Қызметшілердің қошеметі)
Dialogue: 0,0:05:20.27,0:05:21.36,Default,,0,0,0,,Ата-ана мен бала күткендей!
Dialogue: 0,0:05:21.36,0:05:22.69,Default,,0,0,0,,Ата-ана мен бала күткендей!
Dialogue: 0,0:05:23.69,0:05:27.03,Default,,0,0,0,,Ал... бұл не?
Dialogue: 0,0:05:27.11,0:05:30.83,Default,,0,0,0,,Мен... Түсінгеніңізге қуаныштымын, Грейс.
Dialogue: 0,0:05:30.91,0:05:32.74,Default,,0,0,0,,Иә, әке.
Dialogue: 0,0:05:45.51,0:05:47.47,Default,,0,0,0,,Леопольд әке
Dialogue: 0,0:05:47.55,0:05:49.43,Default,,0,0,0,,Дворян ретінде тамаша болса да
Dialogue: 0,0:05:49.51,0:05:53.56,Default,,0,0,0,,Әке ретінде ол өте ақымақ.
Dialogue: 0,0:05:54.35,0:05:58.48,Default,,0,0,0,,Жарайды, мен де қызымның өсуіне ілесе алмадым.
Dialogue: 0,0:05:58.56,0:06:01.31,Default,,0,0,0,,Оның басқа біреу екеніне сене алар емеспін.
Dialogue: 0,0:06:01.40,0:06:02.86,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:06:02.94,0:06:06.61,Default,,0,0,0,,Бұл тәттілер Мастер вальске сыйлық па?
Dialogue: 0,0:06:06.69,0:06:07.57,Default,,0,0,0,,Иә
Dialogue: 0,0:06:07.65,0:06:11.07,Default,,0,0,0,,Мен қожайыннан сұрағым келетін тағы бір нәрсе бар ма?
Dialogue: 0,0:06:11.16,0:06:12.53,Default,,0,0,0,,Енді таяқ пен кітапты ал...
Dialogue: 0,0:06:12.62,0:06:14.24,Default,,0,0,0,,Кеттік, қожайын!
Dialogue: 0,0:06:14.33,0:06:16.08,Default,,0,0,0,,- (Вальс) Мен қабылдаймын. - А?
Dialogue: 0,0:06:17.96,0:06:19.46,Default,,0,0,0,,-Ммм -Ах
Dialogue: 0,0:06:19.54,0:06:22.96,Default,,0,0,0,,Келесі... Мен жеңілмеймін!
Dialogue: 0,0:06:23.04,0:06:25.88,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:06:28.55,0:06:30.80,Default,,0,0,0,,Жарайды, жүр! Міне!
Dialogue: 0,0:06:30.89,0:06:32.72,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,0:06:32.80,0:06:34.56,Default,,0,0,0,,Жоғарыдан айналдыру
Dialogue: 0,0:06:34.64,0:06:37.60,Default,,0,0,0,,Бұл дүниеде де бар ойын ма?
Dialogue: 0,0:06:38.89,0:06:39.89,Default,,0,0,0,,(Леопольд пен оның достарының дауысы)
Dialogue: 0,0:06:39.89,0:06:43.65,Default,,0,0,0,,(Леопольд пен оның достарының дауысы)
Dialogue: 0,0:06:39.89,0:06:43.65,Default,,0,0,0,,Жоқ, не керек, әкем шыңдарды иіреді.
Dialogue: 0,0:06:43.65,0:06:43.73,Default,,0,0,0,,(Леопольд пен оның достарының дауысы)
Dialogue: 0,0:06:43.73,0:06:44.90,Default,,0,0,0,,(Леопольд пен оның достарының дауысы)
Dialogue: 0,0:06:43.73,0:06:44.90,Default,,0,0,0,,Грейстің өзі де білмеді.
Dialogue: 0,0:06:44.90,0:06:45.82,Default,,0,0,0,,Грейстің өзі де білмеді.
Dialogue: 0,0:06:45.90,0:06:50.74,Default,,0,0,0,,Неліктен үлкен ақсүйек отбасының басшысы қала орталығындағы баладай ойнап жүр?
Dialogue: 0,0:06:50.82,0:06:52.07,Default,,0,0,0,,-Уау! -(Вальс) Тағы біраз!
Dialogue: 0,0:06:52.16,0:06:54.70,Default,,0,0,0,,-Мен жеңілдім! -(Вальс) Хахаха...
Dialogue: 0,0:06:54.78,0:06:58.45,Default,,0,0,0,,Хмм, мен өзімнің қожайыныммен бәсекелесе алмайтын шығармын.
Dialogue: 0,0:06:58.54,0:07:01.54,Default,,0,0,0,,Хехехе, жыл мезгілдері әртүрлі.
Dialogue: 0,0:07:02.21,0:07:04.46,Default,,0,0,0,,Кешіріңіз, мен жұмыста болдым.
Dialogue: 0,0:07:04.54,0:07:06.50,Default,,0,0,0,,Осындай нәрсеге байланысты
Dialogue: 0,0:07:06.59,0:07:08.09,Default,,0,0,0,,Не...
Dialogue: 0,0:07:08.17,0:07:13.55,Default,,0,0,0,,Егер бұл сізді алаңдататын болса, кез келген уақытта келуге болады.
Dialogue: 0,0:07:14.10,0:07:16.72,Default,,0,0,0,,Шамасы, әке мен қожайын
Dialogue: 0,0:07:16.81,0:07:20.52,Default,,0,0,0,,Біраз уақыттан бері осындай қарым-қатынасымыз болған сияқты.
Dialogue: 0,0:07:21.44,0:07:23.48,Default,,0,0,0,,Негізінде, Ұстаз.
Dialogue: 0,0:07:23.56,0:07:27.11,Default,,0,0,0,,Мен де қызыма кәдесый таңдауда сәтсіздікке ұшырадым.
Dialogue: 0,0:07:27.19,0:07:31.03,Default,,0,0,0,,Бұдан кейін Грейс сөз болды.
Dialogue: 0,0:07:31.11,0:07:33.95,Default,,0,0,0,,Мен жұрттың алдында ұятқа қалдым.
Dialogue: 0,0:07:34.03,0:07:37.03,Default,,0,0,0,,Дегенмен, бұл менің есімде.
Dialogue: 0,0:07:37.12,0:07:40.37,Default,,0,0,0,,Өйткені, герцог болу маған жараспайды.
Dialogue: 0,0:07:40.45,0:07:43.83,Default,,0,0,0,,Шосенді ел ақсүйектерінің екінші ұлы дейді.
Dialogue: 0,0:07:43.92,0:07:44.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:44.88,0:07:48.84,Default,,0,0,0,,Иә, шын мәнінде, герцогтік отбасының қандас тұқымын алған адам
Dialogue: 0,0:07:48.92,0:07:51.51,Default,,0,0,0,,Грейстің анасы Жаклинде
Dialogue: 0,0:07:51.59,0:07:53.89,Default,,0,0,0,,Леопольд мырзаны қабілеті үшін сатып алды.
Dialogue: 0,0:07:53.97,0:07:56.64,Default,,0,0,0,,Үйленген, асырап алған бала.
Dialogue: 0,0:07:56.72,0:07:58.97,Default,,0,0,0,,Мен Қаржы министрі болсам да, бұл әлі де шындық.
Dialogue: 0,0:07:59.06,0:08:02.64,Default,,0,0,0,,Бұл оның комплексі бар дегенді білдіре ме?
Dialogue: 0,0:08:02.73,0:08:05.56,Default,,0,0,0,,Мен ер адам ретінде бұл сезімді түсінемін.
Dialogue: 0,0:08:05.65,0:08:08.07,Default,,0,0,0,,...бірақ!
Dialogue: 0,0:08:10.32,0:08:11.57,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:08:12.57,0:08:14.99,Default,,0,0,0,,Грейс
Dialogue: 0,0:08:15.62,0:08:16.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:16.99,0:08:19.99,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:08:20.08,0:08:22.46,Default,,0,0,0,,Бұл қулық, әке.
Dialogue: 0,0:08:22.54,0:08:25.50,Default,,0,0,0,,Мұның бәрі сен туралы, осылай ойнап көңіл көтеру.
Dialogue: 0,0:08:25.58,0:08:28.21,Default,,0,0,0,,Маған да хабарлаңыз.
Dialogue: 0,0:08:28.29,0:08:31.01,Default,,0,0,0,,Не? Жоқ... иә?
Dialogue: 0,0:08:31.09,0:08:32.38,Default,,0,0,0,,Жақында
Dialogue: 0,0:08:32.47,0:08:35.64,Default,,0,0,0,,Мен де ата-анама қарыздармын.
Dialogue: 0,0:08:35.72,0:08:38.51,Default,,0,0,0,,Әйтсе де анаңда жоқ.
Dialogue: 0,0:08:39.31,0:08:40.26,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:41.77,0:08:46.06,Default,,0,0,0,,Түсіндім, оған көмектесу мүмкін емес, Грейс.
Dialogue: 0,0:08:46.15,0:08:48.48,Default,,0,0,0,,Ал, ең алдымен жіпті қалай орау керек...
Dialogue: 0,0:08:48.56,0:08:49.40,Default,,0,0,0,,Иә
Dialogue: 0,0:08:49.48,0:08:51.53,Default,,0,0,0,,Күйеуім, бақытты көрінесің.
Dialogue: 0,0:08:51.61,0:08:53.95,Default,,0,0,0,,Хехе, дұрыс.
Dialogue: 0,0:08:56.11,0:08:59.74,Default,,0,0,0,,Сенің әкең ауылда туғаны анық.
Dialogue: 0,0:08:59.83,0:09:03.20,Default,,0,0,0,,Отбасы да беделді болмауы мүмкін.
Dialogue: 0,0:09:03.29,0:09:05.04,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:09:05.12,0:09:07.79,Default,,0,0,0,,Отбасыңды сүй, жұмысыңды сүй
Dialogue: 0,0:09:07.88,0:09:11.80,Default,,0,0,0,,Өз міндетін адал орындаған әке.
Dialogue: 0,0:09:11.88,0:09:15.05,Default,,0,0,0,,Сіз басқалардан жақсысыз!
Dialogue: 0,0:09:15.13,0:09:17.30,Default,,0,0,0,,Қандай керемет әке!
Dialogue: 0,0:09:17.39,0:09:20.30,Default,,0,0,0,,Мен әкемді құрметтеймін!
Dialogue: 0,0:09:22.64,0:09:23.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.64,0:09:31.11,Default,,0,0,0,,Иә? Грейс, сен неге сонша жақсысың?
Dialogue: 0,0:09:31.19,0:09:34.57,Default,,0,0,0,,Жоқ, бұл жай ғана кездейсоқтық.
Dialogue: 0,0:09:34.65,0:09:38.32,Default,,0,0,0,,Жоқ! Мен мұны шындап жасадым
Dialogue: 0,0:09:43.54,0:09:45.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:49.83,0:09:52.92,Default,,0,0,0,,Мен жақсы ұйықтадым~
Dialogue: 0,0:09:56.76,0:09:58.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:58.51,0:10:00.93,Default,,0,0,0,,Уф... иә?
Dialogue: 0,0:10:01.01,0:10:02.31,Default,,0,0,0,,Уф
Dialogue: 0,0:10:03.26,0:10:05.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:10.10,0:10:14.78,Default,,0,0,0,,Бүгін тәжірибелік сиқырлы емтихан басталады.
Dialogue: 0,0:10:15.28,0:10:17.28,Default,,0,0,0,,Құрметті Грейс!
Dialogue: 0,0:10:17.78,0:10:18.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:18.78,0:10:22.70,Default,,0,0,0,,Уф, кешіріңіз! Мені күткеніңіз үшін рахмет!
Dialogue: 0,0:10:22.78,0:10:26.54,Default,,0,0,0,,Жоқ, мен уақытында келдім, Анна.
Dialogue: 0,0:10:26.62,0:10:28.00,Default,,0,0,0,,Я...
Dialogue: 0,0:10:28.08,0:10:29.21,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:10:29.29,0:10:33.21,Default,,0,0,0,,Қарашы, мен асығыс едім, галстук қайырылып қалыпты.
Dialogue: 0,0:10:34.67,0:10:37.13,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:10:37.21,0:10:38.72,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:39.51,0:10:41.72,Default,,0,0,0,,Әке...
Dialogue: 0,0:10:42.68,0:10:45.68,Default,,0,0,0,,Ханымның қозғалысы қазір тақтада.
Dialogue: 0,0:10:45.77,0:10:47.27,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:47.35,0:10:50.73,Default,,0,0,0,,Әрине, әсем түрлендіру (талғампаз алдау) бұған көп қатысы бар шығар.
Dialogue: 0,0:10:50.81,0:10:55.19,Default,,0,0,0,,Бұл бірінші кезекте олардың бейімделу қабілеті жоғары екенін білдіре ме?
Dialogue: 0,0:10:55.27,0:10:55.65,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:10:55.65,0:10:56.61,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:10:55.65,0:10:56.61,Default,,0,0,0,,Охохохо...
Dialogue: 0,0:10:56.61,0:10:56.69,Default,,0,0,0,,Охохохо...
Dialogue: 0,0:10:56.69,0:11:00.15,Default,,0,0,0,,Охохохо...
Dialogue: 0,0:10:56.69,0:11:00.15,Default,,0,0,0,,Әке, бұрынғы денеңе оралсаң да, одан жас келіншек шықпаса.
Dialogue: 0,0:11:00.15,0:11:00.24,Default,,0,0,0,,Әке, бұрынғы денеңе оралсаң да, одан жас келіншек шықпаса.
Dialogue: 0,0:11:00.24,0:11:01.07,Default,,0,0,0,,Әке, бұрынғы денеңе оралсаң да, одан жас келіншек шықпаса.
Dialogue: 0,0:11:00.24,0:11:01.07,Default,,0,0,0,,Охо о о о о о
Dialogue: 0,0:11:01.07,0:11:01.16,Default,,0,0,0,,Охо о о о о о
Dialogue: 0,0:11:01.16,0:11:02.87,Default,,0,0,0,,Охо о о о о о
Dialogue: 0,0:11:01.16,0:11:02.87,Default,,0,0,0,,Маған одан үзіліс беріңізші.
Dialogue: 0,0:11:02.87,0:11:03.49,Default,,0,0,0,,Маған осыдан үзіліс беріңізші.
Dialogue: 0,0:11:04.08,0:11:05.87,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:11:05.95,0:11:08.58,Default,,0,0,0,,Бұл маңызды оқиғаның күні, солай ма?
Dialogue: 0,0:11:08.66,0:11:10.21,Default,,0,0,0,,Иә, бүгін.
Dialogue: 0,0:11:10.29,0:11:13.50,Default,,0,0,0,,Бұл сиқырлы мектепте қорытынды емтихан болатын күн.
Dialogue: 0,0:11:13.58,0:11:15.84,Default,,0,0,0,,Емтихан алушылар алдында қарапайым оқушылар
Dialogue: 0,0:11:15.92,0:11:19.01,Default,,0,0,0,,Мен саған өз сиқырымды көрсетейін деп жатырмын.
Dialogue: 0,0:11:19.09,0:11:20.93,Default,,0,0,0,,Әсіресе дарынды оқушылар
Dialogue: 0,0:11:21.01,0:11:25.01,Default,,0,0,0,,Басқа студенттер мен шақырылған қонақтар алдында демонстрациялар орындау
Dialogue: 0,0:11:27.60,0:11:28.52,Default,,0,0,0,,Бұл —
Dialogue: 0,0:11:29.27,0:11:31.02,Default,,0,0,0,,Сиқырлы көрме!
Dialogue: 0,0:11:31.69,0:11:32.77,Default,,0,0,0,,Иә
Dialogue: 0,0:11:32.85,0:11:34.56,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:35.86,0:11:36.69,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:40.61,0:11:41.95,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:11:42.03,0:11:44.53,Default,,0,0,0,,Қалқан пайдаланушыға қарсы тұрайық!
Dialogue: 0,0:11:44.62,0:11:49.54,Default,,0,0,0,,Онда B сыныбында да осындай адамдар бар екен ғой.
Dialogue: 0,0:11:50.62,0:11:53.54,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:53.62,0:11:55.46,Default,,0,0,0,,Хохо
Dialogue: 0,0:11:55.54,0:11:59.38,Default,,0,0,0,,Жануарларды соғысу үшін қару ретінде пайдаланатын қандай сиқыр?
Dialogue: 0,0:11:59.46,0:12:03.05,Default,,0,0,0,,Мен оны бірінші рет көріп тұрмын, сэр.
Dialogue: 0,0:12:03.13,0:12:06.72,Default,,0,0,0,,Сіз қалай ойлайсыз? Оверн герцогы
Dialogue: 0,0:12:06.80,0:12:09.06,Default,,0,0,0,,О, мектеп директоры
Dialogue: 0,0:12:09.14,0:12:12.06,Default,,0,0,0,,Жоқ, Корольдік сиқыр академиясынан күткендей
Dialogue: 0,0:12:12.64,0:12:16.81,Default,,0,0,0,,Осындай озық сиқырды қолдана алатын оқушылардың барына таң қалдым.
Dialogue: 0,0:12:16.90,0:12:20.19,Default,,0,0,0,,Мен де солай сезінемін.
Dialogue: 0,0:12:20.28,0:12:23.36,Default,,0,0,0,,шын мәнінде герцог.
Dialogue: 0,0:12:23.45,0:12:27.74,Default,,0,0,0,,Бұл сиқыр герцог жақсы білетін адамнан шыққан.
Dialogue: 0,0:12:27.83,0:12:30.37,Default,,0,0,0,,Маған берілген сияқты.
Dialogue: 0,0:12:30.45,0:12:31.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:31.41,0:12:34.33,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,0:12:37.38,0:12:38.67,Default,,0,0,0,,Біз жындан жаңа мәлімет алдық.
Dialogue: 0,0:12:39.42,0:12:42.34,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:42.42,0:12:44.13,Default,,0,0,0,,Огюст Лион және
Dialogue: 0,0:12:44.22,0:12:47.34,Default,,0,0,0,,Бұл Ричард Версоның үлгі көрсетуі болды.
Dialogue: 0,0:12:48.18,0:12:49.85,Default,,0,0,0,,Келесі спектакль
Dialogue: 0,0:12:50.51,0:12:53.85,Default,,0,0,0,,Екеуі де биыл оқуға түсетін бірінші курс студенттері.
Dialogue: 0,0:12:54.44,0:12:57.86,Default,,0,0,0,,Грейс Оверн және Анна Доул
Dialogue: 0,0:12:59.61,0:13:01.65,Default,,0,0,0,,Тұрыңдар, ағалар.
Dialogue: 0,0:13:01.73,0:13:03.86,Default,,0,0,0,,Мен оны басқа оқушыларға көрсете алмаймын.
Dialogue: 0,0:13:03.94,0:13:08.20,Default,,0,0,0,,Аға болсаң да, бұл рыцарьлардың әдеті.
Dialogue: 0,0:13:08.28,0:13:10.20,Default,,0,0,0,,Аға және рыцарь лауазымы
Dialogue: 0,0:13:10.28,0:13:13.29,Default,,0,0,0,,Бұл ұстанған «дәстүр».
Dialogue: 0,0:13:13.37,0:13:14.62,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:13:14.71,0:13:16.58,Default,,0,0,0,,Қалай
Dialogue: 0,0:13:16.67,0:13:20.13,Default,,0,0,0,,Грейс бұл сиқырды екеуіне қолданды ма?
Dialogue: 0,0:13:20.21,0:13:21.46,Default,,0,0,0,,Иә
Dialogue: 0,0:13:21.55,0:13:26.13,Default,,0,0,0,,Қызыңызда адамдарды басқаратын талант бар сияқты.
Dialogue: 0,0:13:26.80,0:13:32.26,Default,,0,0,0,,Стипендияда оқитын Анна да оның мақтауын білдіреді.
Dialogue: 0,0:13:32.35,0:13:37.27,Default,,0,0,0,,Түсінемін, Грейс стипендиатты қабылдады...
Dialogue: 0,0:13:37.35,0:13:40.77,Default,,0,0,0,,бастайық
Dialogue: 0,0:13:40.86,0:13:43.78,Default,,0,0,0,,Сиқырлы көрме!
Dialogue: 0,0:13:49.87,0:13:51.49,Default,,0,0,0,,Профессор Гарнет жасаған
Dialogue: 0,0:13:51.58,0:13:53.45,Default,,0,0,0,,Үш сиқырлы қуыршақ (Гиньоль)
Dialogue: 0,0:13:53.95,0:13:56.33,Default,,0,0,0,,Бұл оны сиқырмен алып тастайтыныңызды білдіре ме?
Dialogue: 0,0:13:56.41,0:13:58.21,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:13:58.29,0:14:01.17,Default,,0,0,0,,Алайда бірінші курс студенттерінің бірінші емтиханында
Dialogue: 0,0:14:01.25,0:14:05.26,Default,,0,0,0,,Қозғалмайтын нысанаға сиқырды қолдану әдетте өту үшін жеткілікті.
Dialogue: 0,0:14:05.34,0:14:08.26,Default,,0,0,0,,Аспанда ұшып, бірнеше нысанаға тигізу
Dialogue: 0,0:14:08.34,0:14:10.51,Default,,0,0,0,,Бұл өте қиын емес пе?
Dialogue: 0,0:14:10.59,0:14:12.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:12.26,0:14:13.26,Default,,0,0,0,,Орион!
Dialogue: 0,0:14:16.98,0:14:18.23,Default,,0,0,0,,От шары!
Dialogue: 0,0:14:19.98,0:14:21.31,Default,,0,0,0,,Үлкен
Dialogue: 0,0:14:21.40,0:14:23.61,Default,,0,0,0,,Бірақ ол баяу қозғалады
Dialogue: 0,0:14:23.69,0:14:25.61,Default,,0,0,0,,Бұл белгіге жетпейді.
Dialogue: 0,0:14:26.24,0:14:27.49,Default,,0,0,0,,- Анна! -иә!
Dialogue: 0,0:14:27.57,0:14:29.03,Default,,0,0,0,,Сириус, кел!
Dialogue: 0,0:14:29.11,0:14:30.57,Default,,0,0,0,,Құйын!
Dialogue: 0,0:14:34.33,0:14:36.33,Default,,0,0,0,,Жалын құйын!
Dialogue: 0,0:14:37.08,0:14:38.75,Default,,0,0,0,,Сонымен... керемет
Dialogue: 0,0:14:38.83,0:14:40.62,Default,,0,0,0,,Бірден екеуін басып алды!
Dialogue: 0,0:14:40.71,0:14:42.50,Default,,0,0,0,,Бірақ біреуі қашып кетті.
Dialogue: 0,0:14:42.59,0:14:44.34,Default,,0,0,0,,Қашып кетуіме жол берме... Жоқ!
Dialogue: 0,0:14:53.35,0:14:54.56,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:14:54.64,0:14:56.52,Default,,0,0,0,,Үшеуі де атылды!
Dialogue: 0,0:14:57.22,0:14:59.23,Default,,0,0,0,,Жарайсың Анна
Dialogue: 0,0:14:59.31,0:15:02.52,Default,,0,0,0,,Иә, Грейске рахмет.
Dialogue: 0,0:15:02.61,0:15:05.36,Default,,0,0,0,,Екеуің де керемет сиқыршыларсыңдар.
Dialogue: 0,0:15:05.44,0:15:08.53,Default,,0,0,0,,... әлі аяқталған жоқ!
Dialogue: 0,0:15:20.12,0:15:22.17,Default,,0,0,0,,Үш гиньол!
Dialogue: 0,0:15:22.25,0:15:23.54,Default,,0,0,0,,Біріктірілген!
Dialogue: 0,0:15:23.63,0:15:24.88,Default,,0,0,0,,Орион!
Dialogue: 0,0:15:29.38,0:15:31.68,Default,,0,0,0,,Өрт сиқыры жұмыс істемейді
Dialogue: 0,0:15:31.76,0:15:34.05,Default,,0,0,0,,Гуигнолдың беті күйіп кеткен.
Dialogue: 0,0:15:34.14,0:15:36.56,Default,,0,0,0,,Ішкі құрылымның металы пайда болады
Dialogue: 0,0:15:36.64,0:15:39.64,Default,,0,0,0,,Су атрибутынан жер атрибутына өзгерген сияқты.
Dialogue: 0,0:15:39.73,0:15:43.90,Default,,0,0,0,,Әй, бірақ ол кісінің қасиеті жер болса...
Dialogue: 0,0:15:43.98,0:15:44.86,Default,,0,0,0,,Иә
Dialogue: 0,0:15:46.15,0:15:48.94,Default,,0,0,0,,Орион су атрибуты болып өзгерді!
Dialogue: 0,0:15:49.78,0:15:51.70,Default,,0,0,0,,Түсінікті әке!
Dialogue: 0,0:15:56.53,0:15:58.62,Default,,0,0,0,,Мен Гиньольды көремін
Dialogue: 0,0:15:58.70,0:16:02.96,Default,,0,0,0,,Ол Орионның атрибуттарды өзгерту мүмкіндігін пайдалануға арналған.
Dialogue: 0,0:16:03.04,0:16:05.46,Default,,0,0,0,,Профессор Гарнет күткендей!
Dialogue: 0,0:16:06.17,0:16:07.54,Default,,0,0,0,,Сонымен Анна
Dialogue: 0,0:16:07.63,0:16:11.47,Default,,0,0,0,,Жел сиқырыңызды сол гиньольға салыңыз.
Dialogue: 0,0:16:11.55,0:16:13.80,Default,,0,0,0,,Менің су сиқырымды соған сәйкестендір.
Dialogue: 0,0:16:13.88,0:16:14.72,Default,,0,0,0,,Иә!?
Dialogue: 0,0:16:14.80,0:16:17.51,Default,,0,0,0,,Төрт қасиет принципі.
Dialogue: 0,0:16:17.60,0:16:20.52,Default,,0,0,0,,Су сиқыры жел магиясын толықтырады және күшейтеді.
Dialogue: 0,0:16:20.60,0:16:22.23,Default,,0,0,0,,Басқаша айтқанда, бұл жолы И
Dialogue: 0,0:16:22.31,0:16:25.23,Default,,0,0,0,,Бұл Аннаны қолдаудың бір түрі болады.
Dialogue: 0,0:16:25.31,0:16:28.07,Default,,0,0,0,,Гугу... Грейс-сама мені қолдайды!?
Dialogue: 0,0:16:28.15,0:16:29.73,Default,,0,0,0,,Бұл өте қорқынышты!
Dialogue: 0,0:16:29.82,0:16:31.49,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:31.57,0:16:34.15,Default,,0,0,0,,Әкем сиқырлы үйлесімділікті пайдаланады
Dialogue: 0,0:16:34.24,0:16:37.24,Default,,0,0,0,,Олар Аннаны басты кейіпкерге айналдыруға тырысады.
Dialogue: 0,0:16:37.83,0:16:40.49,Default,,0,0,0,,Жоқ... бірақ жақсы ма?
Dialogue: 0,0:16:40.58,0:16:44.42,Default,,0,0,0,,Осы ойынның басында Аннаның статусы...
Dialogue: 0,0:16:44.50,0:16:48.29,Default,,0,0,0,,Бұл әсіресе қиын, өйткені сіздің физикалық күшіңіз бен сиқырлы күшіңіз төмен.
Dialogue: 0,0:16:48.38,0:16:51.21,Default,,0,0,0,,Дәл қазір осындай үлкен сиқырды шығарған Аннаға.
Dialogue: 0,0:16:51.30,0:16:55.01,Default,,0,0,0,,Сиқыр жеткілікті ме?
Dialogue: 0,0:16:55.09,0:16:57.76,Default,,0,0,0,,Бұлай айтатын уақыт емес.
Dialogue: 0,0:16:58.60,0:17:02.68,Default,,0,0,0,,Менің жалғыз сиқырым бұл нысананы жеңе алмайтынына сенімдімін.
Dialogue: 0,0:17:02.77,0:17:07.35,Default,,0,0,0,,Сондықтан мен сенің көмегің керек деп айтып отырмын.
Dialogue: 0,0:17:07.44,0:17:08.27,Default,,0,0,0,,Анна!
Dialogue: 0,0:17:08.36,0:17:10.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:10.82,0:17:11.78,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:14.82,0:17:17.91,Default,,0,0,0,,Мен! Мен жасаймын!
Dialogue: 0,0:17:17.99,0:17:21.20,Default,,0,0,0,,Өтінемін! Маған күш беріңіз, Сириус!
Dialogue: 0,0:17:21.79,0:17:23.41,Default,,0,0,0,,Торнадо!
Dialogue: 0,0:17:23.50,0:17:25.16,Default,,0,0,0,,Ой
Dialogue: 0,0:17:25.25,0:17:27.17,Default,,0,0,0,,Желдің жылдамдығы керемет
Dialogue: 0,0:17:30.29,0:17:31.42,Default,,0,0,0,,Құрметті Грейс!
Dialogue: 0,0:17:31.50,0:17:32.76,Default,,0,0,0,,Иә
Dialogue: 0,0:17:32.84,0:17:34.26,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:17:34.76,0:17:36.09,Default,,0,0,0,,Мұз!
Dialogue: 0,0:17:40.55,0:17:41.47,Default,,0,0,0,,Үлкен боран!
Dialogue: 0,0:17:48.77,0:17:50.61,Default,,0,0,0,,Хааа!
Dialogue: 0,0:18:02.16,0:18:02.99,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:03.08,0:18:05.50,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:06.16,0:18:07.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:16.38,0:18:18.55,Default,,0,0,0,,Бұл керемет болды, Грейс.
Dialogue: 0,0:18:18.63,0:18:20.76,Default,,0,0,0,,Бұл таңғажайып болды, екеуміз де.
Dialogue: 0,0:18:20.84,0:18:23.18,Default,,0,0,0,,Иә, Аннаға рахмет.
Dialogue: 0,0:18:23.26,0:18:27.73,Default,,0,0,0,,Міне... Мен Грейс-саманың нұсқауларын орындадым...
Dialogue: 0,0:18:27.81,0:18:30.77,Default,,0,0,0,,Жоқ, жоқ, бұл үлкен мәселе, екеуміз де.
Dialogue: 0,0:18:27.81,0:18:30.77,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:18:30.85,0:18:32.77,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:18:34.69,0:18:36.86,Default,,0,0,0,,Сіз стипендиаттың студентісіз.
Dialogue: 0,0:18:36.94,0:18:38.82,Default,,0,0,0,,Қызыма қамқорлық жасап жатқан сияқты.
Dialogue: 0,0:18:38.90,0:18:40.41,Default,,0,0,0,,-Уау... -Рахмет.
Dialogue: 0,0:18:40.49,0:18:44.08,Default,,0,0,0,,Иә, өздеріңіз көріп тұрғандай, бұл сиқырлы күш.
Dialogue: 0,0:18:44.16,0:18:47.20,Default,,0,0,0,,Мынау... шектен шыққан!
Dialogue: 0,0:18:47.29,0:18:50.33,Default,,0,0,0,,Бүгін... Мен бүгін де сиқырды соңына дейін қолдана алдым.
Dialogue: 0,0:18:50.42,0:18:53.04,Default,,0,0,0,,Мұның бәрі Грейстің арқасында.
Dialogue: 0,0:18:53.13,0:18:56.26,Default,,0,0,0,,Уф, өйткені мен...
Dialogue: 0,0:18:56.34,0:18:59.22,Default,,0,0,0,,Осы мектепке келген соң...
Dialogue: 0,0:19:00.51,0:19:02.80,Default,,0,0,0,,Мен салмақ қостым!
Dialogue: 0,0:19:03.51,0:19:04.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:05.39,0:19:09.23,Default,,0,0,0,,Аа, кешіріңіз... Мен сізге біртіндеп айтамын ...
Dialogue: 0,0:19:09.31,0:19:10.73,Default,,0,0,0,,Сіз салмақ қосасыз ба?
Dialogue: 0,0:19:10.81,0:19:15.48,Default,,0,0,0,,Аа, мен сенімдімін осындай әңгіме оқиғасы...
Dialogue: 0,0:19:17.65,0:19:21.07,Default,,0,0,0,,Міне. Мектепке кіргеннен кейінгі үшінші аптадан бастап күнделікті көрініс.
Dialogue: 0,0:19:28.62,0:19:31.33,Default,,0,0,0,,Иә, шын мәнінде...
Dialogue: 0,0:19:31.42,0:19:33.96,Default,,0,0,0,,Мұндағы тағамның бәрі дәмді.
Dialogue: 0,0:19:34.04,0:19:36.38,Default,,0,0,0,,Көңіл-күйім көтеріліп тамақ ішкенде
Dialogue: 0,0:19:37.00,0:19:40.97,Default,,0,0,0,,Салмақ қосып алғаным сонша, формаға әрең сыйдым!
Dialogue: 0,0:19:41.47,0:19:43.34,Default,,0,0,0,,Сонымен... дұрыс.
Dialogue: 0,0:19:43.43,0:19:46.97,Default,,0,0,0,,Бұрын мен рефлексивті түрде...
Dialogue: 0,0:19:47.06,0:19:50.56,Default,,0,0,0,,Жас кезіңізде салмақ жоғалту болашақта сүйектеріңізді әлсіретуі мүмкін.
Dialogue: 0,0:19:50.64,0:19:51.69,Default,,0,0,0,,немесе соған ұқсас нәрсе
Dialogue: 0,0:19:51.77,0:19:55.52,Default,,0,0,0,,Қыздардың еті сәл артық болса, сүйкімді болады.\NМен
Dialogue: 0,0:19:55.61,0:19:57.36,Default,,0,0,0,,сияқты бірдеңе айтқым келеді
Dialogue: 0,0:20:01.74,0:20:02.95,Default,,0,0,0,,Бірақ мен де
Dialogue: 0,0:20:03.03,0:20:05.57,Default,,0,0,0,,Грейстің денесіне айналғаннан кейін бір айдан кейін
Dialogue: 0,0:20:05.66,0:20:08.08,Default,,0,0,0,,Қыз баланың салмақ қосқысы келмейтіні туралы сезімі
Dialogue: 0,0:20:08.16,0:20:12.37,Default,,0,0,0,,Мен оны түсінгендей сезінемін.
Dialogue: 0,0:20:13.58,0:20:15.29,Default,,0,0,0,,Сен эмоцияларыңды басқара алмайсың ғана емес, сонымен бірге тәуекелден қорқатын, өзін-өзі сақтауға бағытталған ой-санамен әрекет етесің.
Dialogue: 0,0:20:15.38,0:20:17.38,Default,,0,0,0,,Бірақ оны асыра алмаңыз.
Dialogue: 0,0:20:17.46,0:20:21.17,Default,,0,0,0,,Денсаулығың бұзылса, балаң болмайды.
Dialogue: 0,0:20:21.72,0:20:24.55,Default,,0,0,0,,... Иә, мен бұған сақ боламын.
Dialogue: 0,0:20:25.43,0:20:28.39,Default,,0,0,0,,Бұл аздап көңіліңді қалдырды.
Dialogue: 0,0:20:28.47,0:20:30.18,Default,,0,0,0,,-Мм? -Мен-
Dialogue: 0,0:20:30.27,0:20:33.77,Default,,0,0,0,,Анна дәмді көрінеді, тамақты көп жейді.
Dialogue: 0,0:20:33.85,0:20:35.73,Default,,0,0,0,,Маған қатты ұнады...
Dialogue: 0,0:20:38.48,0:20:39.86,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:39.94,0:20:43.36,Default,,0,0,0,,Сіз Грейс-саманы соншалықты жалғыз етіп көрсетуге қалай жетесіз?
Dialogue: 0,0:20:43.45,0:20:46.32,Default,,0,0,0,,Сіз немен мақтанасыз, Анна Қуыршақ?
Dialogue: 0,0:20:46.41,0:20:50.29,Default,,0,0,0,,Себебі сен маған қатты ұнадың... Себебі сен маған ұнадың...
Dialogue: 0,0:20:50.99,0:20:54.16,Default,,0,0,0,,Мүмкіндігінше тамақтаныңыз!
Dialogue: 0,0:20:54.25,0:20:57.42,Default,,0,0,0,,Қарапайым адамның санасы осындай! Сонымен...
Dialogue: 0,0:20:57.50,0:20:59.13,Default,,0,0,0,,Ақыр соңында мен оны жеймін!
Dialogue: 0,0:20:59.21,0:21:02.67,Default,,0,0,0,,Қанша жесең, сонша қозғалу керек!
Dialogue: 0,0:21:03.42,0:21:05.47,Default,,0,0,0,,Өтінемін, мені бақылаңыз, Грейс!
Dialogue: 0,0:21:05.55,0:21:07.05,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:21:07.14,0:21:10.68,Default,,0,0,0,,Е... иә, өзіңізді қатты итермеңіз.
Dialogue: 0,0:21:11.47,0:21:12.98,Default,,0,0,0,,Содан кейін I
Dialogue: 0,0:21:13.06,0:21:15.56,Default,,0,0,0,,Таңертең және кешке жүгіру арқылы калорияларды жағыңыз.
Dialogue: 0,0:21:15.64,0:21:18.81,Default,,0,0,0,,Егер мен жоғары сынып оқушыларымнан сиқырды немесе жекпе-жек өнерін үйренсем.
Dialogue: 0,0:21:18.90,0:21:21.65,Default,,0,0,0,,Мен көп күш жинадым!
Dialogue: 0,0:21:21.73,0:21:22.69,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:21:22.78,0:21:24.53,Default,,0,0,0,,Міне!
Dialogue: 0,0:21:24.61,0:21:25.74,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:21:25.82,0:21:28.20,Default,,0,0,0,,Менің бұлшық еттерім бүгін таңертең етегімді тарылтты.
Dialogue: 0,0:21:28.28,0:21:30.49,Default,,0,0,0,,Мен біраз қобалжыдым.
Dialogue: 0,0:21:31.03,0:21:35.62,Default,,0,0,0,,Жарайды... бұл Аннаның өз күш-жігерінің нәтижесі екенін білдіреді...
Dialogue: 0,0:21:35.71,0:21:37.12,Default,,0,0,0,,-(Пьер) Түсіндім. -Хмм?
Dialogue: 0,0:21:37.21,0:21:40.59,Default,,0,0,0,,Басқаша айтқанда, Грейс-сама маған сөгіс те, мәжбүрлеген де жоқ.
Dialogue: 0,0:21:40.67,0:21:44.97,Default,,0,0,0,,Ол мисс Аннаны ынталандырып, оның өсуіне ықпал етті...
Dialogue: 0,0:21:46.80,0:21:49.72,Default,,0,0,0,,Түсіндім, істеймін, қызым.
Dialogue: 0,0:21:50.35,0:21:51.97,Default,,0,0,0,,Мемлекетке пайдалы
Dialogue: 0,0:21:52.06,0:21:54.10,Default,,0,0,0,,Ол үлкен жігіт.
Dialogue: 0,0:21:54.18,0:21:57.60,Default,,0,0,0,,«Өсуге» ықпал ететін «әулие» сияқты
Dialogue: 0,0:21:58.19,0:22:00.40,Default,,0,0,0,,Грейс күткендей
Dialogue: 0,0:22:01.69,0:22:05.36,Default,,0,0,0,,Бұл ұнамдылықты арттыратын әсер болса керек.
Dialogue: 0,0:22:05.44,0:22:08.86,Default,,0,0,0,,Күткендей мен Грейстің Кензабуро екенін байқадым.
Dialogue: 0,0:22:08.95,0:22:10.87,Default,,0,0,0,,Хмм?
Dialogue: 0,0:22:11.62,0:22:16.62,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.87,0:23:40.87,Default,,0,0,0,,～♪
Dialogue: 0,0:23:46.80,0:23:49.59,Default,,0,0,0,,Мен соңғы уақытта онша құлаған емеспін, Анна.
Dialogue: 0,0:23:49.67,0:23:51.22,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:23:51.30,0:23:52.26,Default,,0,0,0,,Сәлем Анна
Dialogue: 0,0:23:52.34,0:23:54.72,Default,,0,0,0,,Аулада құлап қалдың, жарайсың ба?
Dialogue: 0,0:23:54.80,0:23:56.01,Default,,0,0,0,,Сен де дәлізде құлап қалдың.
Dialogue: 0,0:23:56.10,0:23:57.31,Default,,0,0,0,,Мен оны баспалдақта көрдім
Dialogue: 0,0:23:57.39,0:23:59.43,Default,,0,0,0,,-(Пьер) Мен кітапханадамын -(Ламберт) Мен асханадамын
Dialogue: 0,0:23:59.52,0:24:01.06,Default,,0,0,0,,Сіз құлап қалдыңыз~
Dialogue: 0,0:24:01.14,0:24:04.02,Default,,0,0,0,,Мен оны кездейсоқ көрмеген сияқтымын.
Dialogue: 0,0:24:04.10,0:24:05.81,Default,,0,0,0,,Абайлаңыз...
Dialogue: 0,0:24:07.31,0:24:13.31,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
