Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:30.92,0:01:35.92,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.64,0:01:45.93,Default,,0,0,0,,Бұл басталды.
Dialogue: 0,0:01:46.02,0:01:47.94,Default,,0,0,0,,Бұл мектеп мерекесі
Dialogue: 0,0:01:48.02,0:01:50.56,Default,,0,0,0,,Жанды, барлығы көңіл көтеріп жатқан сияқты.
Dialogue: 0,0:01:50.65,0:01:54.53,Default,,0,0,0,,Жан-жағыма қарап, мен студенттер кеңесінің бөлмесіне қайтайын.
Dialogue: 0,0:01:54.61,0:01:57.82,Default,,0,0,0,,Мен өз актерлік шеберлігімді тағы біраз жаттықтыруым керек.
Dialogue: 0,0:01:57.90,0:01:59.20,Default,,0,0,0,,Иә, Грейс.
Dialogue: 0,0:01:59.28,0:02:01.07,Default,,0,0,0,,Анна! Грейс!
Dialogue: 0,0:02:01.16,0:02:02.08,Default,,0,0,0,,Ах
Dialogue: 0,0:02:02.16,0:02:03.87,Default,,0,0,0,,Міне!
Dialogue: 0,0:02:03.95,0:02:05.20,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:02:05.29,0:02:07.71,Default,,0,0,0,,Ханым... Жоқ, ханым.
Dialogue: 0,0:02:07.79,0:02:10.29,Default,,0,0,0,,Уау, бос емес.
Dialogue: 0,0:02:10.38,0:02:14.25,Default,,0,0,0,,Мектеп мерекесіне қош келдіңіздер. Қарсы болмасаң, мен саған айналамын.
Dialogue: 0,0:02:14.34,0:02:16.76,Default,,0,0,0,,Жақсы, жақсы, уайымдама.
Dialogue: 0,0:02:16.84,0:02:19.13,Default,,0,0,0,,Балалар сендерге көп нәрсе керек, солай ма?
Dialogue: 0,0:02:19.22,0:02:20.97,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:02:21.05,0:02:22.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:24.56,0:02:26.31,Default,,0,0,0,,Кел, танысайық.
Dialogue: 0,0:02:26.39,0:02:28.52,Default,,0,0,0,,Біз, Жер сиқырын зерттеу қоғамы,
Dialogue: 0,0:02:28.60,0:02:32.86,Default,,0,0,0,,Түстен бастап күшті голем жекпе-жегі өтеді!
Dialogue: 0,0:02:32.94,0:02:34.48,Default,,0,0,0,,Балалар, күте тұрыңдар.
Dialogue: 0,0:02:35.11,0:02:38.61,Default,,0,0,0,,Белгіленген жерлерден тыс сиқырды көрсетуге тыйым салынады.
Dialogue: 0,0:02:38.70,0:02:40.78,Default,,0,0,0,,Жарайды, мен оны бірден жоямын.
Dialogue: 0,0:02:40.86,0:02:43.62,Default,,0,0,0,,Бұл аз ғана жарнама.
Dialogue: 0,0:02:43.70,0:02:45.33,Default,,0,0,0,,Жерге оралу
Dialogue: 0,0:02:48.71,0:02:49.54,Default,,0,0,0,,Ах
Dialogue: 0,0:02:51.08,0:02:52.29,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:02:54.38,0:02:56.59,Default,,0,0,0,,Оверн герцогы
Dialogue: 0,0:02:56.67,0:02:58.46,Default,,0,0,0,,Грейстің әкесі
Dialogue: 0,0:02:58.55,0:03:00.30,Default,,0,0,0,,Қазынашы күткендей
Dialogue: 0,0:03:00.38,0:03:03.30,Default,,0,0,0,,Көңіл күй жақсы, бірақ...
Dialogue: 0,0:03:03.39,0:03:07.06,Default,,0,0,0,,Асыл адам уақыт пен орынды ескеруі керек.
Dialogue: 0,0:03:07.14,0:03:08.47,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:03:08.56,0:03:10.73,Default,,0,0,0,,Кешіріңіз, сэр!
Dialogue: 0,0:03:10.81,0:03:12.56,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:03:13.15,0:03:15.23,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,0:03:15.32,0:03:19.49,Default,,0,0,0,,Ей, сен уайымдама, мектептегі фестиваль деген осындай.
Dialogue: 0,0:03:19.57,0:03:22.78,Default,,0,0,0,,Асыл әулеттің барлық балалары өзімшіл.
Dialogue: 0,0:03:22.86,0:03:27.83,Default,,0,0,0,,Біз жыл сайын партизандық стильдегі тірі қойылымдар мен сиқырлы трюктерді жасай бастаймыз.
Dialogue: 0,0:03:27.91,0:03:31.58,Default,,0,0,0,,Иә? Бұл көңілді естіледі.
Dialogue: 0,0:03:27.91,0:03:31.58,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:03:31.58,0:03:31.66,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:03:31.66,0:03:34.13,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:03:31.66,0:03:34.13,Default,,0,0,0,,Ойынға тыйым салынған аймақ бар.
Dialogue: 0,0:03:34.21,0:03:36.25,Default,,0,0,0,,Менің айтқаным осы.
Dialogue: 0,0:03:36.34,0:03:39.09,Default,,0,0,0,,Мен үшін уайымдама, жүр, Грейс.
Dialogue: 0,0:03:39.17,0:03:41.47,Default,,0,0,0,,Енді кешіріңіз, әке.
Dialogue: 0,0:03:41.97,0:03:45.22,Default,,0,0,0,,Мен анаммен сенің ойыныңды көрейін.
Dialogue: 0,0:03:45.30,0:03:47.97,Default,,0,0,0,,Иә, біз сізді күтеміз!
Dialogue: 0,0:03:48.06,0:03:50.60,Default,,0,0,0,,Жас келіншектің келбеті...
Dialogue: 0,0:03:50.68,0:03:54.31,Default,,0,0,0,,Жас кезіңізде Жаклинге ұқсайсыз.
Dialogue: 0,0:03:54.40,0:03:56.56,Default,,0,0,0,,Шынымен
Dialogue: 0,0:03:57.07,0:04:00.57,Default,,0,0,0,,Менің де мұндағы мектептегі кезім есімде.
Dialogue: 0,0:04:00.65,0:04:01.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:04.45,0:04:05.87,Default,,0,0,0,,Бізге ілесіп жүруді қойып, тезірек кетші!
Dialogue: 0,0:04:09.24,0:04:11.08,Default,,0,0,0,,-Аа -мырза?
Dialogue: 0,0:04:11.16,0:04:14.54,Default,,0,0,0,,О... жоқ, ештеңе.
Dialogue: 0,0:04:15.21,0:04:17.88,Default,,0,0,0,,Ақыры шешілді.
Dialogue: 0,0:04:17.96,0:04:20.13,Default,,0,0,0,,Иә, қиын болды.
Dialogue: 0,0:04:20.21,0:04:23.01,Default,,0,0,0,,Әкең айтқандай болды.
Dialogue: 0,0:04:23.09,0:04:27.18,Default,,0,0,0,,Егер сіз менен бір сәт көзіңізді алсаңыз, онда спектакль бар, ал мұнда сиқыр бар.
Dialogue: 0,0:04:27.26,0:04:30.52,Default,,0,0,0,,Мен оқушыларымның мұндай өзімшіл болатынын ешқашан күткен емеспін.
Dialogue: 0,0:04:30.60,0:04:32.85,Default,,0,0,0,,Бірақ Грейс күткендей.
Dialogue: 0,0:04:32.93,0:04:37.19,Default,,0,0,0,,Барлығын төбелеспен ұрысудың орнына, бәрін мұқият көндіріңіз.
Dialogue: 0,0:04:37.27,0:04:38.86,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:38.94,0:04:42.90,Default,,0,0,0,,Герцогтың беделіне ие болған адамды басу дұрыс емес.
Dialogue: 0,0:04:42.99,0:04:46.78,Default,,0,0,0,,Мен осындай фестивальдерде көңіл көтеруге деген ұмтылысты түсінемін.
Dialogue: 0,0:04:46.86,0:04:51.41,Default,,0,0,0,,Студент кезімде мектептегі фестивальдерде партизандық шоулар да көрсеттім.
Dialogue: 0,0:04:51.49,0:04:56.25,Default,,0,0,0,,Қалай болғанда да, біздің қойылымымызға бір сағаттан аз уақыт қалды.
Dialogue: 0,0:04:56.33,0:04:58.25,Default,,0,0,0,,Бізге тездетіп дайындықты бастау керек.
Dialogue: 0,0:04:58.33,0:04:59.42,Default,,0,0,0,,Ах
Dialogue: 0,0:04:59.50,0:05:02.17,Default,,0,0,0,,Құрметті Грейс! Анна мырза!
Dialogue: 0,0:05:02.92,0:05:04.67,Default,,0,0,0,,Фран Бұл дұрыс болды.
Dialogue: 0,0:05:04.76,0:05:06.09,Default,,0,0,0,,Барлығын бірден жинаңыз...
Dialogue: 0,0:05:06.18,0:05:08.18,Default,,0,0,0,,Иә, уайымдамаңыз.
Dialogue: 0,0:05:08.26,0:05:09.68,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:10.81,0:05:11.68,Default,,0,0,0,,Ах
Dialogue: 0,0:05:11.76,0:05:14.39,Default,,0,0,0,,Екеуің де келдіңдер.
Dialogue: 0,0:05:14.48,0:05:15.69,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:05:15.77,0:05:18.69,Default,,0,0,0,,Барлығы қазірдің өзінде? Барлығы, неге...
Dialogue: 0,0:05:18.77,0:05:22.03,Default,,0,0,0,,Екеуің осы пьесада көп жұмыс істеп жатырсыңдар.
Dialogue: 0,0:05:22.11,0:05:23.44,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:05:23.53,0:05:27.20,Default,,0,0,0,,Мен мұны дұрыс орындауымыз керек деп ойлаймын.
Dialogue: 0,0:05:27.28,0:05:29.12,Default,,0,0,0,,Ханымдар мен мырзалар...
Dialogue: 0,0:05:29.20,0:05:30.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:31.91,0:05:33.83,Default,,0,0,0,,-Кешіріңіз -(бәрі) Ах...
Dialogue: 0,0:05:33.91,0:05:38.17,Default,,0,0,0,,Мен барынша тырыстым, бірақ
Dialogue: 0,0:05:38.25,0:05:40.75,Default,,0,0,0,,Мен дұрыс айта алмай жүрген жолдар көп.
Dialogue: 0,0:05:40.84,0:05:43.50,Default,,0,0,0,,Бұлай жалғаса берсе, бәріне қиындық тудырамыз...
Dialogue: 0,0:05:43.59,0:05:46.67,Default,,0,0,0,,Әй, қарапайым адамның сөзін айта алмайсың.
Dialogue: 0,0:05:46.76,0:05:47.59,Default,,0,0,0,,Ах
Dialogue: 0,0:05:47.68,0:05:51.18,Default,,0,0,0,,Менің көзім түйін емес, Грейс.
Dialogue: 0,0:05:51.26,0:05:53.01,Default,,0,0,0,,Мисс Анна мен Френ ханымнан
Dialogue: 0,0:05:53.10,0:05:55.10,Default,,0,0,0,,Мен сіздің жағдайыңызды естідім.
Dialogue: 0,0:05:55.18,0:05:56.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:56.93,0:05:59.35,Default,,0,0,0,,Менің сізді кінәлайтын ойым жоқ.
Dialogue: 0,0:05:59.44,0:06:02.15,Default,,0,0,0,,Азаматтық сөйлей алмау
Dialogue: 0,0:06:02.23,0:06:06.94,Default,,0,0,0,,Бұл сіздің ханымдық біліміңіз сіздің денеңізге өзегіне дейін енгізілгенін білдіреді.
Dialogue: 0,0:06:07.03,0:06:08.70,Default,,0,0,0,,Себебі, бұл соның бір көрінісі.
Dialogue: 0,0:06:08.78,0:06:10.87,Default,,0,0,0,,Иә, Грейс күткендей!
Dialogue: 0,0:06:10.95,0:06:12.45,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:06:14.04,0:06:15.75,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:15.83,0:06:18.50,Default,,0,0,0,,Артық ойлану азапты.
Dialogue: 0,0:06:18.58,0:06:22.21,Default,,0,0,0,,Осындай жас кезінде басқа адамдардың жағдайын түсінуге жеткілікті ойлы
Dialogue: 0,0:06:22.29,0:06:25.63,Default,,0,0,0,,Ол жақсы патша болып өсе береді деп сенемін.
Dialogue: 0,0:06:26.42,0:06:27.67,Default,,0,0,0,,Грейс-сама қазірдің өзінде
Dialogue: 0,0:06:27.76,0:06:30.89,Default,,0,0,0,,Асыл үнмен итеріп өткен дұрыс емес пе?
Dialogue: 0,0:06:30.97,0:06:32.68,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:06:32.76,0:06:35.60,Default,,0,0,0,,Осындай жағдайда ашық айтқан дұрыс.
Dialogue: 0,0:06:35.68,0:06:39.10,Default,,0,0,0,,Аудитория да солай екеніне көз жеткізеді.
Dialogue: 0,0:06:39.19,0:06:41.15,Default,,0,0,0,,Эй, уайымдама
Dialogue: 0,0:06:41.23,0:06:44.19,Default,,0,0,0,,Біз бәріміз әуесқоймыз.
Dialogue: 0,0:06:44.27,0:06:46.65,Default,,0,0,0,,Ешкім кемелдік күтпеуі керек.
Dialogue: 0,0:06:46.73,0:06:49.36,Default,,0,0,0,,Мм, толыққанды спектакльге күлетіндер
Dialogue: 0,0:06:49.45,0:06:50.95,Default,,0,0,0,,Мен «үндемедім»
Dialogue: 0,0:06:51.03,0:06:53.66,Default,,0,0,0,,Одан ләззат алған адам жеңеді. Мұндай нәрсе
Dialogue: 0,0:06:53.74,0:06:56.58,Default,,0,0,0,,Дегенмен, мен сәтсіздікке ұшырамаймын.
Dialogue: 0,0:06:56.66,0:06:58.79,Default,,0,0,0,,Барлығының жолдары есімде...
Dialogue: 0,0:06:58.87,0:07:01.71,Default,,0,0,0,,Біреу кептеліп қалса да, сіз бірден бақылай аласыз.
Dialogue: 0,0:07:01.79,0:07:04.17,Default,,0,0,0,,Мен де, Грейс.
Dialogue: 0,0:07:08.30,0:07:10.68,Default,,0,0,0,,Иә, мен саған сенемін.
Dialogue: 0,0:07:11.34,0:07:13.51,Default,,0,0,0,,Енді аудиторияға көшейік.
Dialogue: 0,0:07:13.59,0:07:15.22,Default,,0,0,0,,Спектакль жақында басталады.
Dialogue: 0,0:07:15.30,0:07:16.43,Default,,0,0,0,,О!
Dialogue: 0,0:07:21.02,0:07:22.94,Default,,0,0,0,,Толуға жақын.
Dialogue: 0,0:07:23.02,0:07:26.52,Default,,0,0,0,,Күтілгендей, бұл студенттік кеңесте өте танымал.
Dialogue: 0,0:07:26.61,0:07:27.69,Default,,0,0,0,,Құрметті Грейс
Dialogue: 0,0:07:27.78,0:07:31.70,Default,,0,0,0,,Екінші қабаттағы герцогтың жанындағы адам...
Dialogue: 0,0:07:31.78,0:07:33.41,Default,,0,0,0,,Бұл сенің анаң.
Dialogue: 0,0:07:33.49,0:07:36.95,Default,,0,0,0,,Мынау! Қараңғы, мен жақсы көрмеймін
Dialogue: 0,0:07:37.03,0:07:39.70,Default,,0,0,0,,Мен жай ғана Жаклинге сәлем бердім.
Dialogue: 0,0:07:40.50,0:07:41.33,Default,,0,0,0,,Құрметті Лукас
Dialogue: 0,0:07:41.41,0:07:42.75,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:07:42.83,0:07:45.84,Default,,0,0,0,,А... жарайды, кейінірек болады.
Dialogue: 0,0:07:45.92,0:07:48.59,Default,,0,0,0,,Олай болса, бәріміз көңіл көтерейік!
Dialogue: 0,0:07:48.67,0:07:49.84,Default,,0,0,0,,Мен тек қағаз ғана лақтырамын.
Dialogue: 0,0:07:49.92,0:07:51.84,Default,,0,0,0,,Иә, барымызды салайық.
Dialogue: 0,0:07:52.76,0:07:54.64,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:07:54.72,0:08:00.81,Default,,0,0,0,,Студенттер кеңесі енді «Ханзада мен қарапайым» пьесасын орындайды.
Dialogue: 0,0:08:00.89,0:08:05.73,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:08:12.82,0:08:14.74,Default,,0,0,0,,Бұл есептің бірінші дауысы.
Dialogue: 0,0:08:14.82,0:08:16.74,Default,,0,0,0,,Бірінші қойылымымда, мұнда
Dialogue: 0,0:08:16.82,0:08:20.37,Default,,0,0,0,,Өзіңізді бос сезіну оңай.
Dialogue: 0,0:08:20.45,0:08:24.25,Default,,0,0,0,,Жел сиқырыммен жолдарды жеткізуге дайынмын.
Dialogue: 0,0:08:24.33,0:08:26.75,Default,,0,0,0,,Жоқ, күте тұрыңыз, Мәртебелі.
Dialogue: 0,0:08:28.34,0:08:31.01,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:08:32.17,0:08:36.76,Default,,0,0,0,,Қанша еңбек етсем де, өмір оңайға түспейді.
Dialogue: 0,0:08:37.35,0:08:38.26,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:08:39.85,0:08:41.77,Default,,0,0,0,,Мен бас тартпаймын
Dialogue: 0,0:08:41.85,0:08:46.27,Default,,0,0,0,,Өйткені, мен осы елдің ханзадасымен бір күнде дүниеге келгенмін.
Dialogue: 0,0:08:46.35,0:08:48.77,Default,,0,0,0,,Ақырында жақсы нәрсе болатынына сенімдімін!
Dialogue: 0,0:08:48.86,0:08:52.03,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:08:52.11,0:08:53.78,Default,,0,0,0,,Мен – Рубелиер,
Dialogue: 0,0:08:53.86,0:08:57.32,Default,,0,0,0,,Көрермендер Аннаның ойынына бірден тартылды.
Dialogue: 0,0:08:57.41,0:08:59.08,Default,,0,0,0,,Иә, күткендей.
Dialogue: 0,0:08:59.16,0:09:01.41,Default,,0,0,0,,Өйткені, бұл бас кейіпкердің ыдысы.
Dialogue: 0,0:09:01.49,0:09:06.67,Default,,0,0,0,,Мен бұл күндері ұмытуға бейіммін, бірақ мен бірінші кезекте зұлыммын.
Dialogue: 0,0:09:06.75,0:09:10.04,Default,,0,0,0,,Сахнада қалай ерекшеленетінін ойлаудың қажеті жоқ.
Dialogue: 0,0:09:10.13,0:09:14.51,Default,,0,0,0,,Басты рөлді Аннаға қалдырып, қосалқы рөлдерге назар аударыңыз.
Dialogue: 0,0:09:15.01,0:09:18.93,Default,,0,0,0,,Қақпашы, балаға жамандық жасама.
Dialogue: 0,0:09:19.01,0:09:20.97,Default,,0,0,0,,Мені өзіңізге апарыңыз
Dialogue: 0,0:09:21.06,0:09:24.18,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:09:24.27,0:09:27.81,Default,,0,0,0,,Мен де осындай сарайда тұрғым келеді.
Dialogue: 0,0:09:27.90,0:09:28.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:28.98,0:09:32.69,Default,,0,0,0,,Мен де бір рет қалада тұрып көргім келеді.
Dialogue: 0,0:09:32.78,0:09:35.65,Default,,0,0,0,,Мен бұл тілегімді орындаймын!
Dialogue: 0,0:09:35.74,0:09:36.57,Default,,0,0,0,,Ах
Dialogue: 0,0:09:38.49,0:09:39.82,Default,,0,0,0,,Ахаха
Dialogue: 0,0:09:40.62,0:09:43.58,Default,,0,0,0,,Қызық екен!
Dialogue: 0,0:09:43.66,0:09:48.08,Default,,0,0,0,,Перінің сиқыры екі адамның жүрегін өзгертеді!
Dialogue: 0,0:09:48.17,0:09:50.08,Default,,0,0,0,,- Ламберт мырза - (Ламберт) Түсінікті.
Dialogue: 0,0:09:51.13,0:09:52.09,Default,,0,0,0,,Раушан боран!
Dialogue: 0,0:09:54.17,0:09:55.84,Default,,0,0,0,,Уф
Dialogue: 0,0:09:58.93,0:10:00.80,Default,,0,0,0,,және осы адаммен шайқасуға рұқсат етті—
Dialogue: 0,0:10:00.89,0:10:04.35,Default,,0,0,0,,Мен сондамын ба? Яғни...
Dialogue: 0,0:10:05.02,0:10:08.60,Default,,0,0,0,,Бұл менің Тоби балаға айналғанымды білдіре ме?
Dialogue: 0,0:10:09.23,0:10:10.35,Default,,0,0,0,,Құрметті Грейс!
Dialogue: 0,0:10:10.44,0:10:12.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:12.44,0:10:13.98,Default,,0,0,0,,Олай болса, мен
Dialogue: 0,0:10:14.07,0:10:16.36,Default,,0,0,0,,Бұл сіздің ханзада болғаныңызды білдіре ме?
Dialogue: 0,0:10:16.44,0:10:17.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:17.95,0:10:19.86,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:10:19.95,0:10:24.87,Default,,0,0,0,,Бұл менің ханзада кейпіне енгенімді білдіре ме?
Dialogue: 0,0:10:28.71,0:10:30.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:30.21,0:10:31.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:33.67,0:10:34.75,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:35.38,0:10:36.88,Default,,0,0,0,,- Сәттілік! -Ах
Dialogue: 0,0:10:36.96,0:10:39.38,Default,,0,0,0,,Айтпақшы, менің сиқырыммен
Dialogue: 0,0:10:40.38,0:10:41.68,Default,,0,0,0,,Тек князьдік тонмен
Dialogue: 0,0:10:41.76,0:10:44.89,Default,,0,0,0,,Мен сенің сөйлесуіңді мүмкін етпедім!
Dialogue: 0,0:10:44.97,0:10:46.14,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:46.72,0:10:48.64,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:10:51.73,0:10:53.65,Default,,0,0,0,,Мәртебелі Лукас Жоғары мәртебелі Лукас!
Dialogue: 0,0:10:53.73,0:10:55.82,Default,,0,0,0,,Керемет импровизация!
Dialogue: 0,0:10:55.90,0:10:57.90,Default,,0,0,0,,Оның үстіне Лукас мұны айтқан сияқты.
Dialogue: 0,0:10:57.99,0:11:00.99,Default,,0,0,0,,Егер солай болса, сіздің ханзадалық үніңізді сақтауыңыз табиғи болар еді.
Dialogue: 0,0:11:01.07,0:11:02.16,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:11:02.91,0:11:04.41,Default,,0,0,0,,-Не болды? -Ой.
Dialogue: 0,0:11:04.49,0:11:06.33,Default,,0,0,0,,Шын мәнінде, бұл ad-lib
Dialogue: 0,0:11:06.41,0:11:08.20,Default,,0,0,0,,Мен сенімен бұрын кездескенімде, Жаклин.
Dialogue: 0,0:11:08.29,0:11:10.58,Default,,0,0,0,,Менде мұны істеу керектігі туралы жадынама бар.
Dialogue: 0,0:11:10.66,0:11:11.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:11.75,0:11:16.34,Default,,0,0,0,,Олай болса анам менің жағдайымды түсінеді...
Dialogue: 0,0:11:16.42,0:11:19.42,Default,,0,0,0,,Басқаша айтқанда, менің талғампаз түрлендіруімді (талғампаз алдау) білесіз бе?
Dialogue: 0,0:11:19.51,0:11:21.76,Default,,0,0,0,,Иә... ойланып қарасаңыз
Dialogue: 0,0:11:21.84,0:11:26.01,Default,,0,0,0,,Бұл пьесаның сценарийі осыдан 30 жыл бұрын жазылса да.
Dialogue: 0,0:11:26.51,0:11:27.47,Default,,0,0,0,,Негізі сол баланың уақыты келді.
Dialogue: 0,0:11:27.47,0:11:28.93,Default,,0,0,0,,Негізі бұл баланың уақыты келді.
Dialogue: 0,0:11:27.47,0:11:28.93,Default,,0,0,0,,Қызық екен!
Dialogue: 0,0:11:28.93,0:11:29.02,Default,,0,0,0,,Қызық екен!
Dialogue: 0,0:11:29.02,0:11:31.19,Default,,0,0,0,,Қызық екен!
Dialogue: 0,0:11:29.02,0:11:31.19,Default,,0,0,0,,Сіз тағынан бас тартуды ойлайсыз ба?
Dialogue: 0,0:11:31.27,0:11:34.44,Default,,0,0,0,,Менің ойымша, бұл жақсы идея, Мәртебелі.
Dialogue: 0,0:11:34.52,0:11:38.11,Default,,0,0,0,,Ханзада Вирджилия патшайымның рөлін абыроймен және абыроймен атқарады
Dialogue: 0,0:11:38.19,0:11:40.44,Default,,0,0,0,,Пьер дарынды қызметші қыздың рөлін сомдайды
Dialogue: 0,0:11:40.53,0:11:43.41,Default,,0,0,0,,Сіз өзіңізді ханзадамын деп ойлайсыз ба?
Dialogue: 0,0:11:43.49,0:11:44.62,Default,,0,0,0,,Ол біртүрлі бала.
Dialogue: 0,0:11:44.70,0:11:47.45,Default,,0,0,0,,Огюст және басқалар динамикалық әйел рыцарь рөлінде
Dialogue: 0,0:11:47.54,0:11:50.20,Default,,0,0,0,,Мен әрқашан кешірім сұраймын.
Dialogue: 0,0:11:50.29,0:11:51.71,Default,,0,0,0,,Мен жақсы болсам
Dialogue: 0,0:11:51.79,0:11:55.17,Default,,0,0,0,,Мен мұндай үйшікте «өмір сүрмес едім».
Dialogue: 0,0:11:55.25,0:11:59.71,Default,,0,0,0,,Әу бастан-ақ барлық актерлік құрам қазіргі студенттік кеңес үшін өте жақсы болды.
Dialogue: 0,0:11:59.80,0:12:01.63,Default,,0,0,0,,Ондайда менің балам жақсы болар еді
Dialogue: 0,0:12:01.72,0:12:03.55,Default,,0,0,0,,Мен келесі патша болуға лайықпын!
Dialogue: 0,0:12:03.63,0:12:05.80,Default,,0,0,0,,Менің ойымша, бұл кездейсоқтық емес.
Dialogue: 0,0:12:05.89,0:12:06.72,Default,,0,0,0,,Егер...
Dialogue: 0,0:12:07.35,0:12:08.72,Default,,0,0,0,,Оны сол жерде түзетіңіз
Dialogue: 0,0:12:08.81,0:12:11.81,Default,,0,0,0,,Егер Жаклиннің мұндай қабілеті болса...
Dialogue: 0,0:12:11.89,0:12:13.81,Default,,0,0,0,,No Сиқырлы күш?
Dialogue: 0,0:12:13.89,0:12:15.48,Default,,0,0,0,,- Құрметті Грейс - Ах.
Dialogue: 0,0:12:15.56,0:12:16.98,Default,,0,0,0,,Жол!
Dialogue: 0,0:12:17.06,0:12:19.28,Default,,0,0,0,,Осындай екіұшты дәлелдермен
Dialogue: 0,0:12:19.36,0:12:21.53,Default,,0,0,0,,Бір адамды өлім жазасына кесейік, т.б.
Dialogue: 0,0:12:21.61,0:12:24.41,Default,,0,0,0,,Бұл мен қабылдай алмайтын нәрсе.
Dialogue: 0,0:12:24.49,0:12:27.24,Default,,0,0,0,,О... қандай мейірімді!
Dialogue: 0,0:12:27.32,0:12:30.41,Default,,0,0,0,,Жоқ, жоқ, әзірше барлық қажетсіз нәрселерді ұмытыңыз.
Dialogue: 0,0:12:30.49,0:12:33.00,Default,,0,0,0,,Дәл қазір мен осы пьесаға назар аударуым керек.
Dialogue: 0,0:12:33.08,0:12:36.00,Default,,0,0,0,,Мен зұлыммын, ал Анна басты кейіпкермін.
Dialogue: 0,0:12:36.58,0:12:39.00,Default,,0,0,0,,Жоқ, енді олай емес...
Dialogue: 0,0:12:39.09,0:12:42.17,Default,,0,0,0,,Мен патшаны қабылдағанда сенімдімін,
Dialogue: 0,0:12:42.26,0:12:46.01,Default,,0,0,0,,Осы елді бақытты өмір сүретін елге айналдырайық!
Dialogue: 0,0:12:49.60,0:12:51.10,Default,,0,0,0,,Бұл пьесада...
Dialogue: 0,0:12:51.18,0:12:54.23,Default,,0,0,0,,Бір іске берілген жастар
Dialogue: 0,0:12:54.31,0:12:56.52,Default,,0,0,0,,Мен көмектескім келеді
Dialogue: 0,0:12:57.15,0:12:59.02,Default,,0,0,0,,Жарайды, Грейс.
Dialogue: 0,0:12:59.11,0:13:02.69,Default,,0,0,0,,Қызымыз күткендей, солай ма? Жаклин
Dialogue: 0,0:13:02.78,0:13:04.53,Default,,0,0,0,,Иә, Леопольд.
Dialogue: 0,0:13:04.61,0:13:09.78,Default,,0,0,0,,Сіз мен ойлағаннан әлдеқайда жақсы істеп жатырсыз.
Dialogue: 0,0:13:09.87,0:13:12.66,Default,,0,0,0,,Енді, ақыры, тәж кию рәсімі.
Dialogue: 0,0:13:12.75,0:13:16.67,Default,,0,0,0,,Сонымен, талай рет айтқанымдай, мен нағыз ханзадамын...
Dialogue: 0,0:13:16.75,0:13:18.96,Default,,0,0,0,,Мен қарапайым адаммын
Dialogue: 0,0:13:19.04,0:13:21.38,Default,,0,0,0,,Мен бұған сене алмаймын!
Dialogue: 0,0:13:21.46,0:13:22.38,Default,,0,0,0,,Кейбір дәлелдер бар...
Dialogue: 0,0:13:22.46,0:13:23.67,Default,,0,0,0,,- (Ричард) Тоби - (Грэйс Анна) Ах.
Dialogue: 0,0:13:24.38,0:13:26.68,Default,,0,0,0,,Ол бала менің ұлым.
Dialogue: 0,0:13:26.76,0:13:30.68,Default,,0,0,0,,Тоби, күлкілі болуды доғар да, үйге қайтайық.
Dialogue: 0,0:13:30.76,0:13:32.43,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:13:32.52,0:13:35.94,Default,,0,0,0,,Ханзада, менің дөрекілігімді кешіріңіз.
Dialogue: 0,0:13:36.02,0:13:38.44,Default,,0,0,0,,Ол бала менің сүйікті ұлым.
Dialogue: 0,0:13:38.52,0:13:41.19,Default,,0,0,0,,Маған беріңізші...
Dialogue: 0,0:13:41.27,0:13:43.94,Default,,0,0,0,,Хмм... Сіз бұл жерде сөзді сөз етіп жатқаныңызға сенімдісіз бе?
Dialogue: 0,0:13:44.03,0:13:48.86,Default,,0,0,0,,Мен… Мен… Мен… Мен…
Dialogue: 0,0:13:50.03,0:13:51.83,Default,,0,0,0,,Оны маған қайтарыңыз!
Dialogue: 0,0:13:51.91,0:13:53.08,Default,,0,0,0,,Мен шыдай алдым!
Dialogue: 0,0:13:53.16,0:13:55.45,Default,,0,0,0,,Жақсы жұмыс Ричард!
Dialogue: 0,0:13:56.25,0:13:59.00,Default,,0,0,0,,- (Ричард) А, - Әй, анашым!
Dialogue: 0,0:13:59.08,0:14:00.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:01.59,0:14:04.26,Default,,0,0,0,,Мені қолдаған қолдардың жұмсақтығы
Dialogue: 0,0:14:04.84,0:14:07.68,Default,,0,0,0,,Сіз нағыз Тобисыз ба?
Dialogue: 0,0:14:07.76,0:14:08.59,Default,,0,0,0,,Ах
Dialogue: 0,0:14:15.64,0:14:17.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:17.14,0:14:20.19,Default,,0,0,0,,Жоқ, мен білсем, мен ештеңе істей алмаймын.
Dialogue: 0,0:14:20.27,0:14:21.73,Default,,0,0,0,,Ертегі!
Dialogue: 0,0:14:21.81,0:14:25.40,Default,,0,0,0,,Егер сізді жақсы көретін адам шындықты байқаса
Dialogue: 0,0:14:25.48,0:14:27.99,Default,,0,0,0,,Ертегі сиқырын бұзуға болады, солай ма?
Dialogue: 0,0:14:28.07,0:14:30.53,Default,,0,0,0,,Бұл жолы мен жеңілдім!
Dialogue: 0,0:14:31.07,0:14:32.24,Default,,0,0,0,,Сонда кездескенше!
Dialogue: 0,0:14:32.32,0:14:33.74,Default,,0,0,0,,Эй... Эй!
Dialogue: 0,0:14:33.83,0:14:34.99,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:35.08,0:14:37.75,Default,,0,0,0,,- (Ричард) Тоби! -Анашым!
Dialogue: 0,0:14:37.83,0:14:44.75,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:14:53.89,0:14:57.02,Default,,0,0,0,,Мен бұл оғаш тәжірибені пайдаланамын.
Dialogue: 0,0:14:57.10,0:15:01.19,Default,,0,0,0,,Мен осы елдің тарихындағы ең жақсы патша болуға ант етемін!
Dialogue: 0,0:15:05.73,0:15:08.15,Default,,0,0,0,,-Еңбек еткеніңе рахмет -Еңбегің үшін рахмет
Dialogue: 0,0:15:08.24,0:15:10.15,Default,,0,0,0,,Жоқ, бітті, бітті
Dialogue: 0,0:15:10.24,0:15:12.16,Default,,0,0,0,,- Уф - А?
Dialogue: 0,0:15:12.24,0:15:17.41,Default,,0,0,0,,Мен... Осындай тамаша қойылымға қатыса алғаныма өте қуаныштымын!
Dialogue: 0,0:15:17.49,0:15:19.20,Default,,0,0,0,,Рахмет Фрэн
Dialogue: 0,0:15:19.29,0:15:23.25,Default,,0,0,0,,Сіздің көмегіңізсіз бұл пьеса аяқталмас еді.
Dialogue: 0,0:15:23.33,0:15:25.92,Default,,0,0,0,,Дұрыс. Фрэн сізге көп рахмет.
Dialogue: 0,0:15:26.00,0:15:28.76,Default,,0,0,0,,Бұл тек франк емес.
Dialogue: 0,0:15:28.84,0:15:34.09,Default,,0,0,0,,Аннаға, менің үлкендеріме және драма үйірмесіне қатысқандардың барлығына көп рахмет.
Dialogue: 0,0:15:34.18,0:15:36.93,Default,,0,0,0,,Нана... Нана... Нана...
Dialogue: 0,0:15:37.01,0:15:38.52,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:15:38.60,0:15:39.43,Default,,0,0,0,,Ах
Dialogue: 0,0:15:39.52,0:15:41.81,Default,,0,0,0,,Бұл пьесаның соншалықты жақсы болуына не себеп болды?
Dialogue: 0,0:15:41.89,0:15:43.44,Default,,0,0,0,,Грейске рахмет!
Dialogue: 0,0:15:44.02,0:15:44.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:45.02,0:15:46.61,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:15:46.69,0:15:50.57,Default,,0,0,0,,Әрине, Анна мисс пен Френ, барлығы қолдарынан келгенін жасады.
Dialogue: 0,0:15:50.65,0:15:54.41,Default,,0,0,0,,Бұл мисс Грейстің негізгі тас болғандығынан болса керек.
Dialogue: 0,0:15:54.49,0:15:55.45,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:15:55.53,0:15:58.12,Default,,0,0,0,,Құрметті Грейс, біз де солай ойлаймыз.
Dialogue: 0,0:15:58.20,0:16:01.04,Default,,0,0,0,,Біз драма үйірмесіне қатысу құрметіне ие болдық!
Dialogue: 0,0:16:01.12,0:16:02.96,Default,,0,0,0,,Мен де, Грейс.
Dialogue: 0,0:16:03.04,0:16:05.79,Default,,0,0,0,,Аа, мм...
Dialogue: 0,0:16:05.88,0:16:08.96,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:16:09.59,0:16:11.38,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:16:11.47,0:16:12.59,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:16.05,0:16:17.51,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:16:17.60,0:16:21.85,Default,,0,0,0,,Бүгінгі күнді ешқашан ұмытпайтыныма сенімдімін.
Dialogue: 0,0:16:29.73,0:16:31.57,Default,,0,0,0,,Бүгін әркімнің сезімін айтайық.
Dialogue: 0,0:16:31.65,0:16:33.74,Default,,0,0,0,,Оны адал қабылдаңыз
Dialogue: 0,0:16:42.41,0:16:43.25,Default,,0,0,0,,Ах
Dialogue: 0,0:16:43.33,0:16:45.25,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:16:45.33,0:16:48.04,Default,,0,0,0,,Бұл тамаша ойын болды, Грейс.
Dialogue: 0,0:16:48.13,0:16:49.67,Default,,0,0,0,,Қызым күткендей
Dialogue: 0,0:16:49.75,0:16:51.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:51.09,0:16:52.76,Default,,0,0,0,,Анаң ше?
Dialogue: 0,0:16:52.84,0:16:54.01,Default,,0,0,0,,Міне.
Dialogue: 0,0:16:54.63,0:16:58.05,Default,,0,0,0,,Мен қалдыра алмайтын ісім бар екенін айту.
Dialogue: 0,0:16:58.14,0:17:00.18,Default,,0,0,0,,Үйге қош келдіңіз
Dialogue: 0,0:17:00.26,0:17:01.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:01.27,0:17:04.94,Default,,0,0,0,,Мен хатты саған ғана сақтап отырмын.
Dialogue: 0,0:17:05.02,0:17:06.02,Default,,0,0,0,,Хат?
Dialogue: 0,0:17:08.73,0:17:12.03,Default,,0,0,0,,Сол сценарий сияқты, бұл сіздің анаңыздың қолжазбасы.
Dialogue: 0,0:17:12.11,0:17:14.57,Default,,0,0,0,,«Құрметті Рақым»
Dialogue: 0,0:17:14.65,0:17:17.53,Default,,0,0,0,,«Біріншіден, сізбен жеке кездесе алмағаным үшін кешірім сұраймын».
Dialogue: 0,0:17:18.20,0:17:20.45,Default,,0,0,0,,«Спектакль керемет болды».
Dialogue: 0,0:17:20.53,0:17:23.16,Default,,0,0,0,,«Сен менің анамның мақтанышысың»
Dialogue: 0,0:17:23.25,0:17:25.16,Default,,0,0,0,,«Жаныңда керемет адамдар».
Dialogue: 0,0:17:25.25,0:17:28.67,Default,,0,0,0,,«Мен олардың көп болғанына қуаныштымын».
Dialogue: 0,0:17:28.75,0:17:32.50,Default,,0,0,0,,«Бұдан былай сіздің алдыңызда қандай қиындықтар туындаса да»
Dialogue: 0,0:17:32.59,0:17:35.17,Default,,0,0,0,,«Егер сіз жақын адамдарыңызбен күш біріктірсеңіз»
Dialogue: 0,0:17:35.26,0:17:38.47,Default,,0,0,0,,«Мен мұны жеңетінімізге сенемін».
Dialogue: 0,0:17:38.55,0:17:41.01,Default,,0,0,0,,«Мұны ұмытпа.»
Dialogue: 0,0:17:41.51,0:17:44.06,Default,,0,0,0,,«Мен сені әлі біраз уақытқа дейін көре алмаймын».
Dialogue: 0,0:17:44.14,0:17:46.98,Default,,0,0,0,,«Мен әрқашан сені ойлаймын».
Dialogue: 0,0:17:47.06,0:17:48.06,Default,,0,0,0,,«Анамнан»
Dialogue: 0,0:17:48.15,0:17:49.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:51.02,0:17:52.48,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:18:00.12,0:18:00.95,Default,,0,0,0,,Ммм
Dialogue: 0,0:18:01.03,0:18:02.49,Default,,0,0,0,,А...
Dialogue: 0,0:18:03.24,0:18:04.70,Default,,0,0,0,,Үлкен күрсіну
Dialogue: 0,0:18:04.79,0:18:06.75,Default,,0,0,0,,Егер сіз қатты өкінсеңіз
Dialogue: 0,0:18:06.83,0:18:08.87,Default,,0,0,0,,Біраз уақытқа болса да танысқаныма жақсы болар еді.
Dialogue: 0,0:18:08.96,0:18:09.96,Default,,0,0,0,,Жаклин
Dialogue: 0,0:18:10.04,0:18:12.21,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:12.29,0:18:15.46,Default,,0,0,0,,Мен де сенімен кездескім келді, Грейс!
Dialogue: 0,0:18:15.55,0:18:18.38,Default,,0,0,0,,Мен көрмей тұрып, ол бала қайтадан есейіп кетті.
Dialogue: 0,0:18:18.47,0:18:23.22,Default,,0,0,0,,Мен сені құшақтап, шашыңды сипап, тіпті бетіңнен сүйгім келді!
Dialogue: 0,0:18:23.31,0:18:26.48,Default,,0,0,0,,Бірақ қазір уақыт емес.
Dialogue: 0,0:18:26.56,0:18:28.52,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:18:28.60,0:18:30.56,Default,,0,0,0,,Ху... (жарық сферасы) Жарайды.
Dialogue: 0,0:18:30.65,0:18:32.90,Default,,0,0,0,,Әзірге бәрі жақсы болып жатқан сияқты.
Dialogue: 0,0:18:32.98,0:18:35.23,Default,,0,0,0,,Мен бұза алмаймын, солай ма?
Dialogue: 0,0:18:36.19,0:18:42.49,Default,,0,0,0,,«Сүйген адамың шындықты көрсе, ертегі сиқыры бұзылады»?
Dialogue: 0,0:18:42.57,0:18:45.66,Default,,0,0,0,,Бұл жолды кім жазған?
Dialogue: 0,0:18:45.74,0:18:47.79,Default,,0,0,0,,Бұл сенсің, Жаклин.
Dialogue: 0,0:18:47.87,0:18:50.08,Default,,0,0,0,,Ә? Жоқ, мен ештеңе істеген жоқпын…
Dialogue: 0,0:18:52.58,0:18:53.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:53.92,0:18:57.55,Default,,0,0,0,,Ақырында мен Грейстің анасын кездестіре алмаймын.
Dialogue: 0,0:18:57.63,0:19:00.26,Default,,0,0,0,,Бірдеңе болса, жұмбақ тереңдей түсті.
Dialogue: 0,0:19:00.34,0:19:01.51,Default,,0,0,0,,Содан кейін не болады?
Dialogue: 0,0:19:01.59,0:19:04.26,Default,,0,0,0,,Егер бұл ойын болса, онда кейінгі партия
Dialogue: 0,0:19:05.01,0:19:08.10,Default,,0,0,0,,Сол сәтте ең көп жеңгіңіз келетін қарсыласпен.
Dialogue: 0,0:19:08.18,0:19:10.56,Default,,0,0,0,,Бұл отшашуды көруге арналған оқиға.
Dialogue: 0,0:19:10.64,0:19:12.52,Default,,0,0,0,,Айтпақшы, олар сиқырлы отшашулар.
Dialogue: 0,0:19:12.60,0:19:14.27,Default,,0,0,0,,Түсіндім, бұл классика.
Dialogue: 0,0:19:14.36,0:19:19.40,Default,,0,0,0,,Бірақ дәл қазір Анна отшашуды бірге көргісі келетін адам...
Dialogue: 0,0:19:19.49,0:19:21.03,Default,,0,0,0,,Құрметті Грейс!
Dialogue: 0,0:19:21.74,0:19:24.95,Default,,0,0,0,,Кешіріңіз, сіз Грейсті көрмедіңіз бе?
Dialogue: 0,0:19:25.03,0:19:26.24,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:26.33,0:19:27.70,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:29.12,0:19:30.91,Default,,0,0,0,,-Мм, кешіріңіз -Хмм...
Dialogue: 0,0:19:31.00,0:19:32.29,Default,,0,0,0,,Кешіріңіз, Анна
Dialogue: 0,0:19:32.37,0:19:35.29,Default,,0,0,0,,Мен жасырмаймын, өйткені мен жаманмын.
Dialogue: 0,0:19:35.38,0:19:38.59,Default,,0,0,0,,Бірақ кешті кіммен өткізесіз?
Dialogue: 0,0:19:38.67,0:19:42.05,Default,,0,0,0,,Бұл болашақ стратегия үшін маңызды сала болуы керек.
Dialogue: 0,0:19:42.13,0:19:44.14,Default,,0,0,0,,Анна Грейспен бірге емес
Dialogue: 0,0:19:44.22,0:19:47.72,Default,,0,0,0,,Отшашуды студенттік кеңес мүшелерімен бірге көру керек.
Dialogue: 0,0:19:47.81,0:19:49.39,Default,,0,0,0,,Әкеңіз күткендей
Dialogue: 0,0:19:49.47,0:19:53.06,Default,,0,0,0,,Сіз әлі ойнамаған ойындардың стратегияларын тамаша шығарады.
Dialogue: 0,0:19:53.15,0:19:55.06,Default,,0,0,0,,Енді, осы арада
Dialogue: 0,0:19:55.15,0:19:57.65,Default,,0,0,0,,Мен мүмкіндігінше басқа оқушылар жоқ жерде тұрамын.
Dialogue: 0,0:19:57.73,0:19:59.78,Default,,0,0,0,,Мен күтіп, не болатынын көргім келеді, бірақ...
Dialogue: 0,0:19:59.86,0:20:00.69,Default,,0,0,0,,Ах
Dialogue: 0,0:20:04.53,0:20:05.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:06.53,0:20:08.58,Default,,0,0,0,,Рақым жоқ па?
Dialogue: 0,0:20:08.66,0:20:10.25,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:10.33,0:20:11.75,Default,,0,0,0,,Өйткені ол туралы.
Dialogue: 0,0:20:11.83,0:20:14.54,Default,,0,0,0,,Мүмкін сізден басқа жерде тапсырма орындауды сұрап жатқан шығар?
Dialogue: 0,0:20:14.63,0:20:15.58,Default,,0,0,0,,Иә
Dialogue: 0,0:20:15.67,0:20:18.30,Default,,0,0,0,,Бірақ бүгінге дейін, Грейс
Dialogue: 0,0:20:18.38,0:20:21.63,Default,,0,0,0,,Ол әрқашан барлық студенттер үшін аянбай еңбек етті.
Dialogue: 0,0:20:21.72,0:20:25.84,Default,,0,0,0,,Ең болмаса, кештен кейінгі отшашуды тамашалап, демалуыңызды қалаймын.
Dialogue: 0,0:20:25.93,0:20:27.39,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:27.47,0:20:29.35,Default,,0,0,0,,Жарайды, бөлініп, ізденейік.
Dialogue: 0,0:20:29.43,0:20:32.35,Default,,0,0,0,,Отшашудың сөнуіне 30 минуттай уақыт қалды.
Dialogue: 0,0:20:32.43,0:20:36.36,Default,,0,0,0,,Кез келген жағдайда 30 минуттан кейін студенттер кеңесінің бөлмесінде жиналыңыз.
Dialogue: 0,0:20:37.06,0:20:38.11,Default,,0,0,0,,Иә
Dialogue: 0,0:21:36.29,0:21:38.42,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:21:41.17,0:21:43.42,Default,,0,0,0,,Бұл басталды
Dialogue: 0,0:21:43.51,0:21:46.43,Default,,0,0,0,,Мен оны таба алмадым.
Dialogue: 0,0:21:47.30,0:21:48.93,Default,,0,0,0,,Құрметті Грейс
Dialogue: 0,0:21:50.10,0:21:51.43,Default,,0,0,0,,Бұл отшашулар...
Dialogue: 0,0:21:52.01,0:21:52.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:54.77,0:21:57.94,Default,,0,0,0,,Бір отшашуда қызыл және көк түстер араласады
Dialogue: 0,0:21:58.02,0:22:00.06,Default,,0,0,0,,Біздің мектептің сиқырлы отшашуы
Dialogue: 0,0:22:00.15,0:22:02.82,Default,,0,0,0,,Түс оны іске қосқан адамның атрибуттарымен анықталады.
Dialogue: 0,0:22:02.90,0:22:07.32,Default,,0,0,0,,Бір отшашуда ұшқынның екі түсі араласады...
Dialogue: 0,0:22:07.40,0:22:08.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:11.32,0:22:14.83,Default,,0,0,0,,♪～
Dialogue: 0,0:22:14.91,0:22:17.75,Default,,0,0,0,,Сізде екі қасиеттің сиқырлы күші бар.
Dialogue: 0,0:22:17.83,0:22:20.67,Default,,0,0,0,,Маған көмектескеніңізге қуаныштымын, Грейс.
Dialogue: 0,0:22:20.75,0:22:23.25,Default,,0,0,0,,Кешіріңіз, директор мырза.
Dialogue: 0,0:22:23.34,0:22:27.22,Default,,0,0,0,,Мен Аннаның қазір кіммен жүргенін білмеймін.
Dialogue: 0,0:22:27.30,0:22:30.18,Default,,0,0,0,,Егер сіз ерекше отшашу туралы естеліктеріңізбен бөліссеңіз
Dialogue: 0,0:22:30.26,0:22:33.26,Default,,0,0,0,,Өзара ұнамдылық та айтарлықтай артады.
Dialogue: 0,0:22:36.60,0:22:40.60,Default,,0,0,0,,Кештегі отшашулар «осылай» ма?
Dialogue: 0,0:22:40.69,0:22:42.19,Default,,0,0,0,,Ол үлкен жігіт.
Dialogue: 0,0:22:42.27,0:22:44.32,Default,,0,0,0,,Ол үлкен адам.
Dialogue: 0,0:22:44.40,0:22:46.15,Default,,0,0,0,,Бұл әдемі~
Dialogue: 0,0:22:46.23,0:22:48.61,Default,,0,0,0,,Бұл тектіліктің нағыз рухы
Dialogue: 0,0:22:48.70,0:22:50.53,Default,,0,0,0,,Еліміз үшін әлі де пайдалы
Dialogue: 0,0:22:52.03,0:22:54.03,Default,,0,0,0,,Грейс күткендей
Dialogue: 0,0:23:00.62,0:23:02.58,Default,,0,0,0,,Иә, жақсы...
Dialogue: 0,0:23:02.67,0:23:05.05,Default,,0,0,0,,Қолайлылық рейтингі жоғарылағанымен
Dialogue: 0,0:23:05.13,0:23:07.01,Default,,0,0,0,,таудың тереңінде демалыс үйін сатып алу туралы оқиға ше?
Dialogue: 0,0:23:08.13,0:23:09.17,Default,,0,0,0,,Отоме ойыны—
Dialogue: 0,0:23:09.26,0:23:12.18,Default,,0,0,0,,«Махаббат пен аңның сиқырлы академиясы»
Dialogue: 0,0:23:12.26,0:23:14.60,Default,,0,0,0,,Мен, кедей қария,
Dialogue: 0,0:23:14.68,0:23:17.27,Default,,0,0,0,,Неліктен сіз бұл дүниеге қайта келдіңіз?
Dialogue: 0,0:23:17.35,0:23:19.43,Default,,0,0,0,,Әлі де жұмбақ
Dialogue: 0,0:23:19.52,0:23:23.36,Default,,0,0,0,,Бүгінгі өмір сүріп жатқан жастарға көмектесу үшін не істей аламыз
Dialogue: 0,0:23:23.44,0:23:26.44,Default,,0,0,0,,Бұл маған берілген рөл емес пе?
Dialogue: 0,0:23:26.53,0:23:29.40,Default,,0,0,0,,Мен қазір солай ойлаймын
Dialogue: 0,0:23:30.03,0:23:32.95,Default,,0,0,0,,Менің зұлымдық өмірім
