Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:35.94,0:02:38.97,Default,,0,0,0,,Сұрау Болжалды байланыс желісін растау
Dialogue: 0,0:02:39.71,0:02:41.31,Default,,0,0,0,,Дельта 1-ден Қарулы 1-ге дейін
Dialogue: 0,0:02:41.84,0:02:45.67,Default,,0,0,0,,Бас сүйек Ангел Аполлон взводтары ұшыруға дайын
Dialogue: 0,0:02:52.04,0:02:52.84,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:04:05.21,0:04:11.94,Default,,0,0,0,,Көк аспан махаббат белгісі
Dialogue: 0,0:04:12.07,0:04:13.57,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:04:13.71,0:04:15.77,Default,,0,0,0,,Сен мені сүйесің бе?
Dialogue: 0,0:04:16.07,0:04:19.77,Default,,0,0,0,,Бірақ ол менен жақсырақ
Dialogue: 0,0:04:20.17,0:04:25.97,Default,,0,0,0,,Мен өз ұшағыма ессіз.
Dialogue: 0,0:04:26.51,0:04:29.64,Default,,0,0,0,,Кюн Кюн Кюн Кюн
Dialogue: 0,0:04:29.81,0:04:35.94,Default,,0,0,0,,Менің жігітім ұшқыш
Dialogue: 0,0:04:38.11,0:04:47.71,Default,,0,0,0,,Минмей! Минмай! Минмай!
Dialogue: 0,0:04:50.04,0:04:52.61,Default,,0,0,0,,Сәлем, бүгін кешке.
Dialogue: 0,0:04:53.31,0:04:55.07,Default,,0,0,0,,Бұл Лин Мингмэй!
Dialogue: 0,0:04:55.21,0:04:59.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:59.47,0:05:02.27,Default,,0,0,0,,Бүгін кеште менің алғашқы концертім.
Dialogue: 0,0:05:02.84,0:05:06.74,Default,,0,0,0,,Көп адам жиналғандарыңызға көп рахмет.
Dialogue: 0,0:05:06.87,0:05:08.57,Default,,0,0,0,,Ринми!
Dialogue: 0,0:05:08.67,0:05:10.14,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:10.31,0:05:15.57,Default,,0,0,0,,Біздің Макростың Жерден ұшқанына бес ай болды.
Dialogue: 0,0:05:15.91,0:05:18.64,Default,,0,0,0,,Осы уақыт ішінде көп нәрсе болды.
Dialogue: 0,0:05:19.24,0:05:22.44,Default,,0,0,0,,Мен азапты басынан өткерген адамдар көп екеніне сенімдімін.
Dialogue: 0,0:05:25.71,0:05:31.21,Default,,0,0,0,,Бірақ! Бүгін түнде сол қайғылы нәрселерді ұмытып, толық рахат алыңыз!
Dialogue: 0,0:05:31.34,0:05:35.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:35.17,0:05:38.91,Default,,0,0,0,,Енді жақында шығатын бірінші альбомымнан.
Dialogue: 0,0:05:39.24,0:05:40.94,Default,,0,0,0,,Біз сізге жекпе-жек жібереміз!
Dialogue: 0,0:05:44.11,0:05:45.71,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:05:45.84,0:05:50.21,Default,,0,0,0,,Аспанда билеген күміс қанат
Dialogue: 0,0:05:50.57,0:05:56.44,Default,,0,0,0,,Кішкентай ақ айдаһар! Кішкентай ақ айдаһар!
Dialogue: 0,0:05:57.17,0:05:58.94,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:05:59.21,0:06:03.01,Default,,0,0,0,,Жанып тұрған көздер қараңғылықты тазартады
Dialogue: 0,0:06:03.57,0:06:09.41,Default,,0,0,0,,Кішкентай ақ айдаһар! Кішкентай ақ айдаһар!
Dialogue: 0,0:06:10.67,0:06:16.41,Default,,0,0,0,,Ауру қаланы іздеген адам
Dialogue: 0,0:06:17.31,0:06:20.04,Default,,0,0,0,,Зұлымдық өлтіруші
Dialogue: 0,0:06:20.17,0:06:24.91,Default,,0,0,0,,Қанішер өлтіруші
Dialogue: 0,0:06:25.04,0:06:27.11,Default,,0,0,0,,Кішкентай ақ айдаһар!
Dialogue: 0,0:06:28.07,0:06:28.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:30.07,0:06:31.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:32.34,0:06:34.87,Default,,0,0,0,,Назар аударыңыз Назар аударыңыз
Dialogue: 0,0:06:35.04,0:06:41.61,Default,,0,0,0,,Кеме трансформацияға 30 минут Мүмкіндігінше бірінші жақын маңдағы баспанаға барыңыз
Dialogue: 0,0:06:42.27,0:06:44.71,Default,,0,0,0,,Назар аударыңыз Назар аударыңыз
Dialogue: 0,0:06:44.81,0:06:46.71,Default,,0,0,0,,Трансформация! Ол қайтадан деформацияланған!
Dialogue: 0,0:06:47.74,0:06:48.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:53.67,0:06:56.24,Default,,0,0,0,,Дельта 1-ден Бас сүйек Ангел Аполлон взводының ұшағына дейін
Dialogue: 0,0:06:56.91,0:07:03.94,Default,,0,0,0,,Курсты түзету 308 плюс A15 30 секундтан кейін сіз ауқымда боласыз. Кедергі позициясына көшіңіз!
Dialogue: 0,0:07:05.97,0:07:08.84,Default,,0,0,0,,Бас сүйегінің көшбасшысынан әр машинаға дейін естігеніңіздей!
Dialogue: 0,0:07:09.01,0:07:12.51,Default,,0,0,0,,Енді 17-кепшілікті қалыптастыруға көшіңіз Керемет!
Dialogue: 0,0:07:12.67,0:07:13.37,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:07:31.37,0:07:34.17,Default,,0,0,0,,Жоқ, мен саған кеше айтқан жоқпын ба? Лукако – нағыз жігіт.
Dialogue: 0,0:07:35.27,0:07:36.71,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:48.51,0:07:49.41,Default,,0,0,0,,Иә! Хаха!
Dialogue: 0,0:07:49.47,0:07:53.24,Default,,0,0,0,,Қуануға әлі ерте! Салыстырмалы жылдамдықты реттеп, ұстап қалу режиміне көшіңіз!
Dialogue: 0,0:07:53.47,0:07:55.64,Default,,0,0,0,,Барлық ұшақтарды таратып, кері үдеуге көшіңіз!
Dialogue: 0,0:07:58.27,0:07:58.94,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:08:01.81,0:08:02.54,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:03.14,0:08:03.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:05.11,0:08:07.11,Default,,0,0,0,,Үш ұшақ... Түсіндім!
Dialogue: 0,0:08:13.91,0:08:14.84,Default,,0,0,0,,Мұны істеме!
Dialogue: 0,0:08:19.74,0:08:20.61,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:08:23.61,0:08:24.61,Default,,0,0,0,,Мен бардым! Макс!
Dialogue: 0,0:08:24.74,0:08:25.27,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:08:34.61,0:08:35.57,Default,,0,0,0,,3 ұшақ атып түсірілді!
Dialogue: 0,0:08:36.01,0:08:37.04,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:08:37.34,0:08:39.04,Default,,0,0,0,,Ол шынымен де данышпан!
Dialogue: 0,0:08:39.37,0:08:40.37,Default,,0,0,0,,Мен де!
Dialogue: 0,0:08:44.67,0:08:45.44,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,0:08:46.54,0:08:47.07,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:08:55.64,0:08:56.67,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:02.41,0:09:03.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:04.14,0:09:07.97,Default,,0,0,0,,Дельта 1-ден әр ұшаққа дейін 108-ші аймақта үлкен әскери кеме пайда болады
Dialogue: 0,0:09:08.07,0:09:12.17,Default,,0,0,0,,Көптеген тасымалдаушыларға негізделген ұшақтар кемеге жақындап келеді! Қарсыласуға асығыңыз!
Dialogue: 0,0:09:12.54,0:09:14.71,Default,,0,0,0,,Иә! Бұл жау азғын ба?
Dialogue: 0,0:09:54.71,0:09:58.91,Default,,0,0,0,,Дельта 1-ден Бас сүйек 11-ге дейін сіздің міндетіңіз жаудың әскери кемелерін ұстау болуы керек.
Dialogue: 0,0:09:59.24,0:10:01.01,Default,,0,0,0,,Дереу постыңызға өтіңіз!
Dialogue: 0,0:10:01.31,0:10:04.77,Default,,0,0,0,,Қалжың емес! Мен саған көмектестім, бірақ олай айту мүмкін емес!
Dialogue: 0,0:10:05.04,0:10:08.81,Default,,0,0,0,,Тәртіпті бұзсаңыз, бригадаға барыңыз! Жаңа баланың әдеттеріне қарсы шықпаңыз!
Dialogue: 0,0:10:09.07,0:10:11.74,Default,,0,0,0,,Жау ұшақтары басып келеді! Сіз үндемей аласыз ба?
Dialogue: 0,0:10:11.87,0:10:15.04,Default,,0,0,0,,Оны 2-ші қорғаныс күштеріне қалдырыңыз! Бұл бұйрық!
Dialogue: 0,0:10:15.64,0:10:19.67,Default,,0,0,0,,Әйелдің нұсқауын қабылдайсыз ба? Кемеге кіріп, жауды жойыңыз! Міне бітті!
Dialogue: 0,0:10:19.94,0:10:21.91,Default,,0,0,0,,А, сәл күте тұрыңыз!
Dialogue: 0,0:10:22.64,0:10:25.57,Default,,0,0,0,,Қазірдің өзінде! Қайсысы жақсы, еркек пе, әйел ме?
Dialogue: 0,0:10:31.97,0:10:36.01,Default,,0,0,0,,Трансформация 1 минуттан кейін басталады
Dialogue: 0,0:10:37.57,0:10:38.94,Default,,0,0,0,,Бүгін жақсысың ба?
Dialogue: 0,0:10:39.04,0:10:39.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:40.44,0:10:41.57,Default,,0,0,0,,Бұл әдеттегіден күштірек...
Dialogue: 0,0:10:58.14,0:10:59.74,Default,,0,0,0,,Кяах! Апыр-ай!
Dialogue: 0,0:11:00.31,0:11:01.51,Default,,0,0,0,,Минмей! Жүгіріп кету!
Dialogue: 0,0:11:13.54,0:11:14.67,Default,,0,0,0,,...
Dialogue: 0,0:11:22.21,0:11:22.71,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:11:23.47,0:11:24.31,Default,,0,0,0,,Минмай!
Dialogue: 0,0:11:24.94,0:11:26.01,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:11:26.07,0:11:26.74,Default,,0,0,0,,Кя!
Dialogue: 0,0:11:27.41,0:11:28.17,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:11:31.84,0:11:32.61,Default,,0,0,0,,Кя!
Dialogue: 0,0:11:47.01,0:11:47.61,Default,,0,0,0,,Кя!
Dialogue: 0,0:11:58.01,0:12:00.17,Default,,0,0,0,,Гравитацияны басқару жүйесі №11 зақымдалған!
Dialogue: 0,0:12:00.27,0:12:01.81,Default,,0,0,0,,Ішкі жүйе жұмыс істемейді!
Dialogue: 0,0:12:15.27,0:12:19.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:22.77,0:12:24.01,Default,,0,0,0,,О, о!
Dialogue: 0,0:12:49.21,0:12:50.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:55.94,0:12:59.34,Default,,0,0,0,,Жау кемесі 107 бағытына жақындап келеді
Dialogue: 0,0:12:59.51,0:13:01.81,Default,,0,0,0,,Курсты растау Автоматты бақылау құрылғысы іске қосылды
Dialogue: 0,0:13:01.94,0:13:04.64,Default,,0,0,0,,Қуат деңгейін арттыру Артиллериялық күту режимі
Dialogue: 0,0:13:12.01,0:13:12.91,Default,,0,0,0,,Ату!
Dialogue: 0,0:13:45.11,0:13:46.14,Default,,0,0,0,,Оишо
Dialogue: 0,0:14:02.77,0:14:03.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:04.04,0:14:05.01,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:14:12.94,0:14:14.21,Default,,0,0,0,,Бұл шын...
Dialogue: 0,0:14:17.61,0:14:19.41,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:21.84,0:14:22.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:24.67,0:14:26.14,Default,,0,0,0,,Сіз менісіз бе?
Dialogue: 0,0:14:26.24,0:14:27.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:29.07,0:14:33.74,Default,,0,0,0,,А... сен маған көмектестің.
Dialogue: 0,0:14:33.84,0:14:37.64,Default,,0,0,0,,Мен Жер Біріккен Күштерінің Валькири Бассүйек взводына тиесілімін.
Dialogue: 0,0:14:37.77,0:14:40.54,Default,,0,0,0,,Акира Ичиджо... Уф, мен екінші лейтенантпын.
Dialogue: 0,0:14:40.64,0:14:42.64,Default,,0,0,0,,Рахмет, лейтенант-сан.
Dialogue: 0,0:14:42.74,0:14:44.94,Default,,0,0,0,,Жарайды, мен үлкен жанкүйермін.
Dialogue: 0,0:14:45.27,0:14:48.41,Default,,0,0,0,,Хехе, мен өте қуаныштымын, менің әнімді тыңдап тұрсың ба?
Dialogue: 0,0:14:48.61,0:14:50.74,Default,,0,0,0,,Иә! әрқашан
Dialogue: 0,0:14:52.04,0:14:54.54,Default,,0,0,0,,Барлығы уайымдауы керек.
Dialogue: 0,0:14:57.51,0:14:59.04,Default,,0,0,0,,Эй, лейтенант-сан, бұл қайда?
Dialogue: 0,0:14:59.11,0:15:00.91,Default,,0,0,0,,Мм... қол қоя аласыз ба?
Dialogue: 0,0:15:00.97,0:15:01.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:01.91,0:15:03.01,Default,,0,0,0,,(Кёко) Қыз ба? (Юки) Ұл ба?
Dialogue: 0,0:15:06.11,0:15:06.67,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:15:06.77,0:15:07.84,Default,,0,0,0,,Уау, рахмет!
Dialogue: 0,0:15:08.11,0:15:08.81,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:15:10.14,0:15:12.54,Default,,0,0,0,,Мен қозғалтқыш блогына құладым.
Dialogue: 0,0:15:12.64,0:15:14.07,Default,,0,0,0,,Бір жерде шығу бар ма?
Dialogue: 0,0:15:14.27,0:15:15.47,Default,,0,0,0,,Қарап көрейік.
Dialogue: 0,0:15:15.64,0:15:18.61,Default,,0,0,0,,Уау... ааааааааааааааааай
Dialogue: 0,0:15:22.21,0:15:23.17,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:15:23.71,0:15:24.94,Default,,0,0,0,,Сіз бұза алмайсыз ба?
Dialogue: 0,0:15:25.24,0:15:27.74,Default,,0,0,0,,Бұл мүмкін емес. Ол гиперкөміртектен жасалған.
Dialogue: 0,0:15:28.84,0:15:30.04,Default,,0,0,0,,Сәл күте тұрыңыз
Dialogue: 0,0:15:31.47,0:15:33.21,Default,,0,0,0,,Шудың көптігі сонша, мүмкін емес...
Dialogue: 0,0:15:33.54,0:15:35.37,Default,,0,0,0,,Ұшақтың радиосын пайдалана алмайсыз ба?
Dialogue: 0,0:15:35.47,0:15:38.11,Default,,0,0,0,,Бұл жақсы емес, ол бұзылған.
Dialogue: 0,0:15:38.54,0:15:39.54,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:15:40.67,0:15:44.51,Default,,0,0,0,,Бұл кім? Біреу бар ма?
Dialogue: 0,0:15:49.17,0:15:50.87,Default,,0,0,0,,А, жоқ...
Dialogue: 0,0:15:53.61,0:15:55.37,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:57.51,0:16:00.14,Default,,0,0,0,,Толық кесте жеткілікті!
Dialogue: 0,0:16:00.24,0:16:01.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:02.17,0:16:05.11,Default,,0,0,0,,Енді мен дем аламын. Хехе.
Dialogue: 0,0:16:06.04,0:16:06.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:08.07,0:16:10.07,Default,,0,0,0,,Не болды? Сәлем, лейтенант-сан.
Dialogue: 0,0:16:10.51,0:16:13.04,Default,,0,0,0,,Макрос Титаннан ұшырылды.
Dialogue: 0,0:16:13.11,0:16:13.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.77,0:16:15.64,Default,,0,0,0,,Уф, бұл рас.
Dialogue: 0,0:16:24.54,0:16:25.44,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:16:26.41,0:16:27.94,Default,,0,0,0,,Гравитацияны басқару жұмыс істемейді.
Dialogue: 0,0:16:28.04,0:16:29.67,Default,,0,0,0,,Ах аа
Dialogue: 0,0:16:29.77,0:16:32.54,Default,,0,0,0,,Эй, эй, Минмей-сан! Мені сонша ұстасаң...
Dialogue: 0,0:16:32.61,0:16:33.11,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:33.17,0:16:34.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:34.24,0:16:35.31,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,0:16:36.04,0:16:39.04,Default,,0,0,0,,А... Әй, бұл оқыс оқиға болды! Хмм, бұл дұрыс емес!
Dialogue: 0,0:16:39.27,0:16:41.27,Default,,0,0,0,,Одан да жақсы нәрсе істе!
Dialogue: 0,0:16:41.37,0:16:46.27,Default,,0,0,0,,А-а... Сосын аяғыңызды алға қарай сермеп, ақырын тоқтаңыз!
Dialogue: 0,0:16:46.64,0:16:47.97,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:16:49.91,0:16:50.77,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:16:51.24,0:16:53.07,Default,,0,0,0,,Бұл жақсы! Міне бітті!
Dialogue: 0,0:16:53.21,0:16:55.84,Default,,0,0,0,,Ахаха, бұл қызық!
Dialogue: 0,0:16:58.21,0:17:00.77,Default,,0,0,0,,Ах, Минмей-сан! Онда барсаң...
Dialogue: 0,0:17:01.04,0:17:03.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:03.57,0:17:04.57,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:05.71,0:17:07.21,Default,,0,0,0,,О? Ах!
Dialogue: 0,0:17:07.44,0:17:09.21,Default,,0,0,0,,Minmei-Сан! Кәне!
Dialogue: 0,0:17:10.11,0:17:12.21,Default,,0,0,0,,Жоқ, мен жарықты сындырдым... Иә?
Dialogue: 0,0:17:14.07,0:17:14.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:15.01,0:17:15.81,Default,,0,0,0,,Ахаха
Dialogue: 0,0:17:17.31,0:17:18.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:19.94,0:17:23.04,Default,,0,0,0,,Қараңдар, қараңдар, хаха
Dialogue: 0,0:17:24.07,0:17:27.97,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл көйлек заманауи жеңіл голография болып табылады.
Dialogue: 0,0:17:35.11,0:17:38.34,Default,,0,0,0,,Уау... көкөністер мен тунец жүзіп жатыр.
Dialogue: 0,0:17:38.44,0:17:40.17,Default,,0,0,0,,Барлығы құлады.
Dialogue: 0,0:17:41.81,0:17:44.37,Default,,0,0,0,,О, тіпті менің қуыршағым да бар.
Dialogue: 0,0:17:45.77,0:17:46.61,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:47.37,0:17:50.14,Default,,0,0,0,,0-G Махаббат 0-G Махаббат
Dialogue: 0,0:17:50.47,0:17:53.51,Default,,0,0,0,,0-G Махаббат 0-G Махаббат
Dialogue: 0,0:17:53.77,0:17:59.21,Default,,0,0,0,,Онымен мектептен қайтып келе жатқанда
Dialogue: 0,0:17:59.81,0:18:05.47,Default,,0,0,0,,Кәдімгі бұрышта қоштасу
Dialogue: 0,0:18:06.14,0:18:10.87,Default,,0,0,0,,Өтінемін, айналада ешкім жоқ сыңай танытыңыз.
Dialogue: 0,0:18:12.31,0:18:17.27,Default,,0,0,0,,Ескертусіз сүйді
Dialogue: 0,0:18:17.77,0:18:23.41,Default,,0,0,0,,Мен ашуланғандай кейіп таныттым.
Dialogue: 0,0:18:23.94,0:18:27.11,Default,,0,0,0,,Бірақ, бірақ, бірақ
Dialogue: 0,0:18:27.41,0:18:30.14,Default,,0,0,0,,Басы жеңіл, жүрегі жеңіл
Dialogue: 0,0:18:30.27,0:18:33.04,Default,,0,0,0,,0-G Махаббат 0-G Махаббат
Dialogue: 0,0:18:33.21,0:18:36.01,Default,,0,0,0,,4-3-2-1 0-G Махаббат
Dialogue: 0,0:18:36.64,0:18:45.07,Default,,0,0,0,,Денем желмен ұшады 0-G Махаббат 0-G Махаббат
Dialogue: 0,0:19:52.44,0:19:55.84,Default,,0,0,0,,Уф... мәдениеттілік...
Dialogue: 0,0:19:58.97,0:20:04.87,Default,,0,0,0,,Күрсін… Уф
Dialogue: 0,0:20:21.51,0:20:24.84,Default,,0,0,0,,Скрипт және қалықтау
Dialogue: 0,0:20:25.17,0:20:30.97,Default,,0,0,0,,Ұзын ізі бар
Dialogue: 0,0:20:31.24,0:20:37.51,Default,,0,0,0,,Үсті-үстіне жиналған екі үлкен жүрек
Dialogue: 0,0:20:52.87,0:20:56.51,Default,,0,0,0,,Әйтеуір... оның өлгені әлі шешілген жоқ.
Dialogue: 0,0:20:56.61,0:20:57.37,Default,,0,0,0,,Иә
Dialogue: 0,0:20:57.97,0:21:00.91,Default,,0,0,0,,Бүгін біз батыс блокты мұқият іздейміз.
Dialogue: 0,0:21:00.97,0:21:02.67,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:21:03.31,0:21:05.01,Default,,0,0,0,,Енді кешіріңіз.
Dialogue: 0,0:21:06.41,0:21:08.91,Default,,0,0,0,,Ол баланы әлі таппаған сияқтымыз.
Dialogue: 0,0:21:09.01,0:21:10.27,Default,,0,0,0,,Содан бері үш күн өтті.
Dialogue: 0,0:21:10.41,0:21:14.51,Default,,0,0,0,,Менің ойымша, ол әскерге баруға тырысты, бірақ қорқып, қашып кетті.
Dialogue: 0,0:21:14.61,0:21:15.34,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:21:15.77,0:21:21.11,Default,,0,0,0,,Менің ойымша, ол бала әскерге жарамайды. Егер бала дұрыс жұмыс істемесе, ол өмір бойы бақытсыз болады.
Dialogue: 0,0:21:21.81,0:21:25.77,Default,,0,0,0,,Мен оның қазір жұмысын ауыстырғаны дұрыс деп ойладым.
Dialogue: 0,0:21:25.87,0:21:28.87,Default,,0,0,0,,Бұл бұрынғыдай қатал, солай емес пе? Егер солай болса...
Dialogue: 0,0:21:28.97,0:21:31.61,Default,,0,0,0,,Қанша уақыт өтсе де, менің үйленетін адамым жоқ.
Dialogue: 0,0:21:31.67,0:21:32.67,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:21:33.31,0:21:38.51,Default,,0,0,0,,Жарайды, қыз деген сезімнен баяғыда бас тартқанмын.
Dialogue: 0,0:21:38.64,0:21:43.47,Default,,0,0,0,,Қайтадан ақымақ сияқты сөз айтсаң да, жарайды. Мен кепілдік беремін Миса...
Dialogue: 0,0:22:09.67,0:22:12.81,Default,,0,0,0,,Әкем мен шешем осылай дейді.
Dialogue: 0,0:22:13.21,0:22:15.67,Default,,0,0,0,,Ағаңның басынан қанша қиындық өткенін білесің бе?
Dialogue: 0,0:22:16.41,0:22:19.64,Default,,0,0,0,,Мені тыңдамасаң, ата-ана мен бала арасындағы қарым-қатынасты үземін!
Dialogue: 0,0:22:20.87,0:22:22.71,Default,,0,0,0,,Сондықтан мен мұны айттым.
Dialogue: 0,0:22:23.54,0:22:29.31,Default,,0,0,0,,Ұзақ уақыт бойы көмек көрсеткеніңіз үшін рахмет. Мен міндетті түрде әнші боламын! Бұл дұрыс
Dialogue: 0,0:22:29.41,0:22:30.37,Default,,0,0,0,,Сонда?
Dialogue: 0,0:22:30.47,0:22:31.34,Default,,0,0,0,,Ахаха
Dialogue: 0,0:22:35.17,0:22:37.81,Default,,0,0,0,,Дәл солай үйден жүгіріп шықтым.
Dialogue: 0,0:22:37.91,0:22:38.97,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:22:39.61,0:22:44.91,Default,,0,0,0,,Бірақ... Мен мұны сәл артық айтқан болармын.
Dialogue: 0,0:22:49.17,0:22:52.74,Default,,0,0,0,,Әкең мен анаң жақсы деп үміттенемін...
Dialogue: 0,0:22:52.84,0:22:54.64,Default,,0,0,0,,Сіз Макроссқа мінбейсіз бе?
Dialogue: 0,0:22:58.17,0:22:59.44,Default,,0,0,0,,Жер...
Dialogue: 0,0:23:01.34,0:23:02.64,Default,,0,0,0,,Жер?
Dialogue: 0,0:23:10.57,0:23:13.41,Default,,0,0,0,,Жерге не болғанын білмейсің бе?
Dialogue: 0,0:23:13.47,0:23:18.17,Default,,0,0,0,,Хабарландыруда қатты радиокедергілер болғаны және олармен байланысу мүмкін емес екені айтылған...
Dialogue: 0,0:23:18.67,0:23:20.47,Default,,0,0,0,,Жоқ, бұл рас.
Dialogue: 0,0:23:22.64,0:23:27.37,Default,,0,0,0,,Қатты бомбаланған соң, ол жайдан-жай кетеді деп ойламаймын.
Dialogue: 0,0:23:28.97,0:23:29.91,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:23:30.04,0:23:36.31,Default,,0,0,0,,А, алаңдайтын ештеңе жоқ. Мен Жерге бір айдан кейін қайтып келемін.
Dialogue: 0,0:23:36.81,0:23:37.57,Default,,0,0,0,,Иә...
Dialogue: 0,0:23:40.97,0:23:42.94,Default,,0,0,0,,Эй, мен сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:23:43.04,0:23:43.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:43.71,0:23:45.07,Default,,0,0,0,,Өткен күнгі теледидар туралы
Dialogue: 0,0:23:45.44,0:23:46.14,Default,,0,0,0,,Ах… Оу
Dialogue: 0,0:23:46.27,0:23:50.37,Default,,0,0,0,,Иә, `` Жылағым келген түнде'' Басқа рөлді ойнайтын адам туралы қауесет.
Dialogue: 0,0:23:50.47,0:23:55.47,Default,,0,0,0,,Иә! Сен де шындап тұрсың ба? Бұл журнал компаниясының ойлап тапқаны.
Dialogue: 0,0:23:55.77,0:24:01.37,Default,,0,0,0,,Бірақ... не айтамын, әлгі ғашықтық сахнасы сондай шынайы болды...
Dialogue: 0,0:24:01.51,0:24:08.91,Default,,0,0,0,,Ah ha ha ha ha! Ах ха ха...
Dialogue: 0,0:24:09.01,0:24:12.31,Default,,0,0,0,,Актерлік өнермен бұлай істей алмайсың! Business! Хехе
Dialogue: 0,0:24:12.37,0:24:12.87,Default,,0,0,0,,Уф!
Dialogue: 0,0:24:13.94,0:24:15.51,Default,,0,0,0,,Мен жасап көрейін бе?
Dialogue: 0,0:24:15.57,0:24:16.44,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:24:16.74,0:24:17.41,Default,,0,0,0,,Аха…
Dialogue: 0,0:24:17.57,0:24:18.57,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:24:24.94,0:24:27.24,Default,,0,0,0,,Сәлем, Акира
Dialogue: 0,0:24:27.31,0:24:28.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:30.01,0:24:34.27,Default,,0,0,0,,Бұл мен. Шындық, мен сені әрқашан жақсы көрдім.
Dialogue: 0,0:24:35.14,0:24:36.87,Default,,0,0,0,,Мені жақсы көретініңді айт
Dialogue: 0,0:24:36.94,0:24:37.91,Default,,0,0,0,,О, бірақ!
Dialogue: 0,0:24:37.97,0:24:42.71,Default,,0,0,0,,Сонда... сен мені жақсы көрмейсің ғой?
Dialogue: 0,0:24:42.81,0:24:45.47,Default,,0,0,0,,Жоқ! Маған ұнайды
Dialogue: 0,0:24:46.31,0:24:47.71,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:24:47.91,0:24:49.77,Default,,0,0,0,,О, бұл рас!
Dialogue: 0,0:24:50.44,0:24:52.17,Default,,0,0,0,,Мен бақыттымын...
Dialogue: 0,0:25:15.14,0:25:21.31,Default,,0,0,0,,О! Апыр-ай!
Dialogue: 0,0:25:21.44,0:25:22.47,Default,,0,0,0,,Қас!
Dialogue: 0,0:25:25.87,0:25:26.47,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:25:30.67,0:25:35.74,Default,,0,0,0,,Бұл жолы мен Минмэй-санға көмектескендіктен, қоғаммен байланыс бөлімі мені ерекше кешірім сұрады.
Dialogue: 0,0:25:35.84,0:25:39.34,Default,,0,0,0,,Алайда алдағы уақытта тәртіпті бұзсаңыз, жазаланбайсыз!
Dialogue: 0,0:25:39.64,0:25:42.11,Default,,0,0,0,,Біз сені қатаң жазалаймыз! сол ниетпен
Dialogue: 0,0:25:43.11,0:25:43.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:44.81,0:25:45.94,Default,,0,0,0,,Шағымдарыңыз бар ма?
Dialogue: 0,0:25:46.21,0:25:47.37,Default,,0,0,0,,Бұл Музан мырза…
Dialogue: 0,0:25:47.94,0:25:50.31,Default,,0,0,0,,Бұдан былай абай болыңыз, жарай ма?
Dialogue: 0,0:25:50.91,0:25:51.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:51.61,0:25:52.57,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:25:52.64,0:25:53.14,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:25:53.21,0:25:54.24,Default,,0,0,0,,Ой...
Dialogue: 0,0:25:57.17,0:25:59.47,Default,,0,0,0,,Хмм... Иә!
Dialogue: 0,0:26:04.71,0:26:06.57,Default,,0,0,0,,Әй, бұл да әйел!
Dialogue: 0,0:26:16.47,0:26:17.57,Default,,0,0,0,,Эй, сен істедің! Жарқыраған!
Dialogue: 0,0:26:17.67,0:26:18.27,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:26:18.47,0:26:19.27,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:26:19.34,0:26:21.27,Default,,0,0,0,,Мынау әдемі адам!
Dialogue: 0,0:26:21.37,0:26:23.97,Default,,0,0,0,,Хаха, жақсы нәрсе жасаңыз!
Dialogue: 0,0:26:24.04,0:26:24.84,Default,,0,0,0,,Жоқ
Dialogue: 0,0:26:24.94,0:26:28.07,Default,,0,0,0,,Қалай болды? Біздің кумир Минмей Чанның дәмі қандай?
Dialogue: 0,0:26:28.17,0:26:28.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:28.94,0:26:32.51,Default,,0,0,0,,Ичижо-сенпай солай ма еді... Кешіріңіз.
Dialogue: 0,0:26:32.64,0:26:33.77,Default,,0,0,0,,Толығырақ айтып беріңізші!
Dialogue: 0,0:26:33.84,0:26:35.87,Default,,0,0,0,,Мен ештеңе істеген жоқпын.
Dialogue: 0,0:26:35.94,0:26:36.94,Default,,0,0,0,,Бұл өтірікші!
Dialogue: 0,0:26:37.04,0:26:39.01,Default,,0,0,0,,Шынымен, шынымен, шынымен ақымақ
Dialogue: 0,0:26:39.27,0:26:41.21,Default,,0,0,0,,Абсолютті жауапкершілікті алу керек
Dialogue: 0,0:26:41.41,0:26:43.57,Default,,0,0,0,,Шынымен! Мен ештеңе істеп жатқан жоқпын!
Dialogue: 0,0:26:44.17,0:26:47.94,Default,,0,0,0,,Екеуің үш күн жалғыз болып, ештеңе істемедіңдер ме?
Dialogue: 0,0:26:48.01,0:26:48.87,Default,,0,0,0,,(Тодороки) Оған өз қалауынша сол күшті босатуға жол беру қауіпті
Dialogue: 0,0:26:48.94,0:26:50.64,Default,,0,0,0,,Не, сен әлі ер адамсың ба?
Dialogue: 0,0:26:50.71,0:26:51.47,Default,,0,0,0,,Һм? Бұл не?
Dialogue: 0,0:26:52.11,0:26:52.64,Default,,0,0,0,,Барка
Dialogue: 0,0:26:53.84,0:26:54.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:57.51,0:27:02.41,Default,,0,0,0,,"Сіз Валькириялық ұшқыш прапорщик Ичижоумен не істедіңіз? Тазалық сектасын бітіргенсіз..."
Dialogue: 0,0:27:02.87,0:27:05.71,Default,,0,0,0,,«Менің серіктесім әскери адам, бұл арам қатынас па?»
Dialogue: 0,0:27:05.84,0:27:08.81,Default,,0,0,0,,Қараңызшы, мен дәл солай айттым, солай ма?
Dialogue: 0,0:27:08.87,0:27:12.84,Default,,0,0,0,,Расында да қазіргі заманда таза адамдар жоқ.
Dialogue: 0,0:27:12.91,0:27:18.64,Default,,0,0,0,,Хмм, ойын-сауық әлемінің бей-берекет болуы табиғи нәрсе. Қанша еркек бар... Қызық...
Dialogue: 0,0:27:19.27,0:27:22.47,Default,,0,0,0,,Әй, ғашығыңды бұлай қалай өзгерттің!
Dialogue: 0,0:27:22.54,0:27:25.74,Default,,0,0,0,,Хехе, сен не айтып тұрсың? Негізі мен сені қызғанамын.
Dialogue: 0,0:27:25.84,0:27:26.37,Default,,0,0,0,,Иә
Dialogue: 0,0:27:26.47,0:27:29.77,Default,,0,0,0,,Ой, жоқ! Ахахахахахха...
Dialogue: 0,0:27:29.87,0:27:31.24,Default,,0,0,0,,Мен ештеңе білмеймін.
Dialogue: 0,0:27:31.31,0:27:33.47,Default,,0,0,0,,Хмм, иә! Ахаха
Dialogue: 0,0:27:36.07,0:27:39.97,Default,,0,0,0,,Минмей-чан мен Ичиджо Кагаюки қазір күдікке ілінді.
Dialogue: 0,0:27:40.07,0:27:42.57,Default,,0,0,0,,Егер сіз кеткіңіз келсе, жабық аумақты қалдыра аласыз.
Dialogue: 0,0:27:42.64,0:27:43.31,Default,,0,0,0,,Хухун
Dialogue: 0,0:27:43.41,0:27:44.24,Default,,0,0,0,,Бірақ ол шықпады!
Dialogue: 0,0:27:44.41,0:27:45.24,Default,,0,0,0,,Апа, жақсысың ба?
Dialogue: 0,0:27:45.41,0:27:46.91,Default,,0,0,0,,Бұл сұрақ!
Dialogue: 0,0:27:47.74,0:27:49.04,Default,,0,0,0,,Неге шықпадың?
Dialogue: 0,0:28:16.34,0:28:19.47,Default,,0,0,0,,Майор, мен сізге ертеңгі патрульді ұйымдастыру кестесін әкелдім.
Dialogue: 0,0:28:19.57,0:28:23.21,Default,,0,0,0,,Әй, қандай азап! Жақсы, ішіңіз.
Dialogue: 0,0:28:23.61,0:28:24.41,Default,,0,0,0,,Жоқ...жоқ
Dialogue: 0,0:28:24.57,0:28:26.21,Default,,0,0,0,,Жарайды, отырыңыз.
Dialogue: 0,0:28:26.37,0:28:27.14,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:28:27.94,0:28:29.87,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:28:29.97,0:28:30.61,Default,,0,0,0,,Әй?
Dialogue: 0,0:28:30.71,0:28:32.14,Default,,0,0,0,,Сіз мені мазалайды деп үміттенемін.
Dialogue: 0,0:28:32.47,0:28:36.64,Default,,0,0,0,,Қарашы, Теру, бастығың сені уайымдап жатыр...тез отыр.
Dialogue: 0,0:28:36.74,0:28:37.57,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:28:42.04,0:28:44.67,Default,,0,0,0,,Бұл не, Хаясе?
Dialogue: 0,0:28:45.37,0:28:48.71,Default,,0,0,0,,Жұмыстан кеткенде, сәл әйелдікке ұмтылыңыз.
Dialogue: 0,0:28:48.84,0:28:50.87,Default,,0,0,0,,Тұлғаны оңай түзетуге болмайды.
Dialogue: 0,0:28:51.04,0:28:54.87,Default,,0,0,0,,Хехе, нуахахахах... Кешіріңіз.
Dialogue: 0,0:28:55.81,0:29:00.51,Default,,0,0,0,,Қарашы, Хаясе, сен әскери академияның бастығы болсаң да, әйел адамсың.
Dialogue: 0,0:29:00.77,0:29:05.21,Default,,0,0,0,,Тіпті кейде адамның айтқаны дұрыс емес болса да, оның дұрыс екенін мойындау маңызды.
Dialogue: 0,0:29:06.84,0:29:07.97,Default,,0,0,0,,Сәлем Теру
Dialogue: 0,0:29:08.11,0:29:08.94,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:29:09.31,0:29:13.27,Default,,0,0,0,,Ер адам болған соң, кейде күш көрсету керек.
Dialogue: 0,0:29:13.44,0:29:15.94,Default,,0,0,0,,Әйелдің сезімін ойлауға ерінбе
Dialogue: 0,0:29:16.04,0:29:20.74,Default,,0,0,0,,Егер сіз бір нәрсені шынымен жақсы көретін болсаңыз, оны күшпен болса да бір нәрсеге айналдыру үшін жеткілікті белсенділік таныту маңызды.
Dialogue: 0,0:29:20.84,0:29:21.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:21.87,0:29:24.31,Default,,0,0,0,,Рой, сен тым көп сөйлейсің.
Dialogue: 0,0:29:24.61,0:29:27.74,Default,,0,0,0,,Тыңдаңдар, мен сендерге ерлер мен әйелдердің кереметтерін көрсетемін.
Dialogue: 0,0:29:28.07,0:29:30.27,Default,,0,0,0,,Мұқият қараңыз.
Dialogue: 0,0:29:30.71,0:29:32.04,Default,,0,0,0,,Ха... Рой...
Dialogue: 0,0:29:32.11,0:29:33.31,Default,,0,0,0,,Ах
Dialogue: 0,0:29:34.14,0:29:36.51,Default,,0,0,0,,О! ...Екеуі де таң қалды.
Dialogue: 0,0:29:36.57,0:29:37.97,Default,,0,0,0,,Маңызды ма?
Dialogue: 0,0:29:38.04,0:29:41.54,Default,,0,0,0,,Рой... Рой болса
Dialogue: 0,0:29:41.77,0:29:44.97,Default,,0,0,0,,Хехе Клаудиа
Dialogue: 0,0:29:45.37,0:29:45.87,Default,,0,0,0,,Хе...
Dialogue: 0,0:29:45.94,0:29:48.44,Default,,0,0,0,,О, Рой...
Dialogue: 0,0:29:49.11,0:29:50.77,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:29:51.41,0:29:53.71,Default,,0,0,0,,Ичиджо мырзаға қоңырау келді.
Dialogue: 0,0:29:53.81,0:29:54.71,Default,,0,0,0,,Ол солай деді де, бізді біраз уақыт күттіріп қойды
Dialogue: 0,0:29:54.91,0:29:56.47,Default,,0,0,0,,Сіздің отбасыңыздан.
Dialogue: 0,0:29:56.61,0:29:57.71,Default,,0,0,0,,Отбасы! ?
Dialogue: 0,0:30:01.64,0:30:03.67,Default,,0,0,0,,Мм... Ичиджо.
Dialogue: 0,0:30:03.84,0:30:05.81,Default,,0,0,0,,Иә! … Өтірік…
Dialogue: 0,0:30:06.91,0:30:09.94,Default,,0,0,0,,Мен... Жарайды, мен бірден кетемін! Жарайды онда
Dialogue: 0,0:30:10.77,0:30:11.97,Default,,0,0,0,,Не болды? Жарқыраған
Dialogue: 0,0:30:12.04,0:30:16.24,Default,,0,0,0,,Эй... менің отбасымның бір мүшесі кенет ауырып қалды... Кешіріңіз.
Dialogue: 0,0:30:18.64,0:30:19.74,Default,,0,0,0,,Әй?
Dialogue: 0,0:30:20.54,0:30:22.04,Default,,0,0,0,,Отбасы?
Dialogue: 0,0:30:28.11,0:30:31.17,Default,,0,0,0,,Уф… Тоқтады ма?
Dialogue: 0,0:30:34.11,0:30:34.84,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:30:35.24,0:30:37.87,Default,,0,0,0,,Жоқ, түсіндің бе?
Dialogue: 0,0:30:38.01,0:30:40.77,Default,,0,0,0,,Түсіндім, барлығында фотокітап бар.
Dialogue: 0,0:30:40.87,0:30:43.21,Default,,0,0,0,,Мен өзімді жасыруға тырыссам да...
Dialogue: 0,0:30:44.34,0:30:46.11,Default,,0,0,0,,Осындай нәрсені істеуге болады ма?
Dialogue: 0,0:30:46.67,0:30:48.41,Default,,0,0,0,,Менімен бірге болғың келмей ме?
Dialogue: 0,0:30:48.51,0:30:49.07,Default,,0,0,0,,А...
Dialogue: 0,0:30:52.31,0:30:56.37,Default,,0,0,0,,...Жарайды онда, бүгін кешке бір нәрсе істейік!
Dialogue: 0,0:30:57.74,0:30:58.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:31:51.84,0:31:53.17,Default,,0,0,0,,Уау
Dialogue: 0,0:32:51.71,0:32:53.11,Default,,0,0,0,,Маған енді ұнамайды
Dialogue: 0,0:32:53.21,0:32:53.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:55.44,0:32:57.07,Default,,0,0,0,,Ағымдағы өмір…
Dialogue: 0,0:32:59.37,0:33:04.01,Default,,0,0,0,,Әнші болу арманыңыз еді ғой? Мен аздап ұстануым керек
Dialogue: 0,0:33:04.07,0:33:04.97,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:33:08.24,0:33:09.24,Default,,0,0,0,,Ах
Dialogue: 0,0:33:17.47,0:33:18.94,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:33:21.81,0:33:24.54,Default,,0,0,0,,Мен барғым келеді... осындай жерге...
Dialogue: 0,0:33:35.47,0:33:36.64,Default,,0,0,0,,Алыс
Dialogue: 0,0:33:40.84,0:33:43.37,Default,,0,0,0,,Бірақ рұқсатсыз пайдаланғаның үшін ұрыспайсың ба?
Dialogue: 0,0:33:43.74,0:33:45.07,Default,,0,0,0,,Саған жақсы нәрсе көрсетейін бе?
Dialogue: 0,0:33:45.14,0:33:46.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:46.14,0:33:47.07,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:33:49.94,0:33:50.71,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:34:02.87,0:34:04.91,Default,,0,0,0,,Енді көзіңді аш.
Dialogue: 0,0:34:05.21,0:34:06.14,Default,,0,0,0,,Иә
Dialogue: 0,0:34:07.04,0:34:08.31,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:34:15.81,0:34:17.17,Default,,0,0,0,,Керемет!
Dialogue: 0,0:34:17.41,0:34:18.84,Default,,0,0,0,,Сатурн кемпірқосақ
Dialogue: 0,0:34:18.97,0:34:21.27,Default,,0,0,0,,Уау, бұл ең жақсы!
Dialogue: 0,0:34:32.51,0:34:34.27,Default,,0,0,0,,Британ 7018
Dialogue: 0,0:34:34.37,0:34:34.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:34:49.01,0:34:49.61,Default,,0,0,0,,Мм...
Dialogue: 0,0:34:50.07,0:34:50.97,Default,,0,0,0,,Элкест
Dialogue: 0,0:34:51.14,0:34:51.64,Default,,0,0,0,,Му?
Dialogue: 0,0:34:58.17,0:34:59.31,Default,,0,0,0,,...
Dialogue: 0,0:35:04.84,0:35:05.51,Default,,0,0,0,,Ескес
Dialogue: 0,0:35:15.71,0:35:22.04,Default,,0,0,0,,Артыңыздан жайбарақат жүру
Dialogue: 0,0:35:23.24,0:35:26.81,Default,,0,0,0,,Шұңқыр және қуу
Dialogue: 0,0:35:27.21,0:35:32.41,Default,,0,0,0,,Жарқыраған ақ құмды жағажай
Dialogue: 0,0:35:32.97,0:35:39.27,Default,,0,0,0,,Сен оған ғашықпын дейсің, бірақ
Dialogue: 0,0:35:40.27,0:35:43.77,Default,,0,0,0,,Сен маған көбірек ұнайсың.
Dialogue: 0,0:35:44.07,0:35:49.71,Default,,0,0,0,,Әрқашан бірге SUNSET BEACH
Dialogue: 0,0:35:51.11,0:35:56.11,Default,,0,0,0,,Теңіз самалы, үлкен толқындар
Dialogue: 0,0:35:56.47,0:36:03.87,Default,,0,0,0,,Жүрегімде өмір сүре бастады
Dialogue: 0,0:36:04.51,0:36:11.51,Default,,0,0,0,,Көңілді секіреді
Dialogue: 0,0:36:11.64,0:36:19.21,Default,,0,0,0,,Серфингке арналған аспа...
Dialogue: 0,0:36:21.57,0:36:22.11,Default,,0,0,0,,Ах
Dialogue: 0,0:36:23.74,0:36:25.94,Default,,0,0,0,,Жасырудың қажеті жоқ, Минмэй-сан.
Dialogue: 0,0:36:29.54,0:36:30.67,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:36:31.31,0:36:32.21,Default,,0,0,0,,… Капитан!
Dialogue: 0,0:36:32.84,0:36:35.97,Default,,0,0,0,,Мен сіздің Valkyrie қолданбасын жеке пайдалану үшін пайдаланып жатқаныңызға таң қалдым.
Dialogue: 0,0:36:37.07,0:36:41.24,Default,,0,0,0,,Бұл Кагуяның кінәсі емес, мен оны сұрауға мәжбүрледім.
Dialogue: 0,0:36:41.64,0:36:43.11,Default,,0,0,0,,Минмей, тез қайт!
Dialogue: 0,0:36:43.17,0:36:44.04,Default,,0,0,0,,Аға
Dialogue: 0,0:36:44.14,0:36:49.61,Default,,0,0,0,,Ичиджо мырза, егер бұл оқиғаны БАҚ анықтаса, Минмейдің әнші ретіндегі мансабы аяқталады.
Dialogue: 0,0:36:50.14,0:36:53.87,Default,,0,0,0,,Мен әскери басшылармен сөйлестім, бірақ мен сізге аямаймын.
Dialogue: 0,0:36:54.64,0:36:57.27,Default,,0,0,0,,Түсіндім, мен ауыр жазаға дайынмын.
Dialogue: 0,0:36:57.71,0:37:00.24,Default,,0,0,0,,Қандай солдат, тез қайт!
Dialogue: 0,0:37:00.57,0:37:01.51,Default,,0,0,0,,Түсінді
Dialogue: 0,0:37:02.61,0:37:03.27,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:37:03.64,0:37:04.14,Default,,0,0,0,,Иә
Dialogue: 0,0:37:06.54,0:37:07.71,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:37:13.64,0:37:14.21,Default,,0,0,0,,Бұл жаудың ұшағы.
Dialogue: 0,0:37:14.84,0:37:15.91,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:37:16.21,0:37:17.24,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:37:17.44,0:37:20.61,Default,,0,0,0,,Бұл Хаяс. Майор Фоккердің бөлмесіне дереу барыңыз.
Dialogue: 0,0:37:23.91,0:37:24.64,Default,,0,0,0,,Жарқыраған…
Dialogue: 0,0:37:24.87,0:37:26.61,Default,,0,0,0,,Жарайды, маған қалдырыңыз!
Dialogue: 0,0:37:33.81,0:37:35.91,Default,,0,0,0,,Жоқ, бұл жігіт жаттығуға келген.
Dialogue: 0,0:37:36.01,0:37:36.87,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:37:43.84,0:37:46.47,Default,,0,0,0,,Бұл біртүрлі. Мені неге атпайды деп ойлаймын.
Dialogue: 0,0:37:52.81,0:37:53.34,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:37:55.74,0:37:57.61,Default,,0,0,0,,Қат! Мазалау және жек көру
Dialogue: 0,0:38:05.17,0:38:06.71,Default,,0,0,0,,Ей, жарқырай бер!
Dialogue: 0,0:38:07.57,0:38:10.21,Default,,0,0,0,,Сіз тағы да қиындық тудырып жатырсыз! Ықылық
Dialogue: 0,0:38:10.37,0:38:11.51,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:38:13.47,0:38:14.97,Default,,0,0,0,,Бірақ жарайсың!
Dialogue: 0,0:38:15.17,0:38:19.67,Default,,0,0,0,,Әйелді затқа айналдыру үшін ер адам сондай агрессивті болуы керек.
Dialogue: 0,0:38:20.31,0:38:22.31,Default,,0,0,0,,Сенпай, мас екенсің бе?
Dialogue: 0,0:38:22.64,0:38:26.77,Default,,0,0,0,,Барлоу! Қызық, мен ішімдіктен қорқып төбелесе аламын ба?
Dialogue: 0,0:38:39.21,0:38:40.17,Default,,0,0,0,,Тергеу штабында да дәл осылай деді.
Dialogue: 0,0:38:40.54,0:38:41.14,Default,,0,0,0,,Ах
Dialogue: 0,0:38:44.51,0:38:45.44,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:38:46.27,0:38:47.74,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:38:48.27,0:38:50.11,Default,,0,0,0,,Яху!
Dialogue: 0,0:39:00.71,0:39:02.77,Default,,0,0,0,,Көрдіңіз бе? Кагуя... Уау.
Dialogue: 0,0:39:03.24,0:39:04.11,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:39:13.71,0:39:14.24,Default,,0,0,0,,Бұл жаман...!
Dialogue: 0,0:39:27.94,0:39:29.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:39:48.84,0:39:49.47,Default,,0,0,0,,Ах
Dialogue: 0,0:39:52.04,0:39:52.61,Default,,0,0,0,,Га
Dialogue: 0,0:39:52.67,0:39:53.51,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:39:56.97,0:39:57.74,Default,,0,0,0,,Ик!
Dialogue: 0,0:39:57.87,0:39:59.01,Default,,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:40:00.57,0:40:05.74,Default,,0,0,0,,Девранның тілі қазірдің өзінде аударылады. Зентраның сұрағына жауап беріңіз.
Dialogue: 0,0:40:06.94,0:40:11.24,Default,,0,0,0,,Неліктен аталық және аналық микроклондар бірге бола алады?
Dialogue: 0,0:40:11.71,0:40:13.44,Default,,0,0,0,,Ер және әйел микрофондары?
Dialogue: 0,0:40:13.54,0:40:14.77,Default,,0,0,0,,Не?
Dialogue: 0,0:40:14.94,0:40:16.67,Default,,0,0,0,,Нені естігіңіз келеді?
Dialogue: 0,0:40:17.37,0:40:21.17,Default,,0,0,0,,Ер мен әйелдің бір дақанда тұруына болатындығы зерттелді.
Dialogue: 0,0:40:21.71,0:40:24.17,Default,,0,0,0,,Мұндай нәрсені тергеудің мәні неде?
Dialogue: 0,0:40:24.44,0:40:26.61,Default,,0,0,0,,Мәдени формалар әр түрлі сияқты.
Dialogue: 0,0:40:27.41,0:40:31.74,Default,,0,0,0,,Девран неге төбелеспейді? Неліктен ол микрон болды?
Dialogue: 0,0:40:31.84,0:40:34.81,Default,,0,0,0,,Біз сен сияқты алыптарға ұқсамаймыз.
Dialogue: 0,0:40:35.01,0:40:38.47,Default,,0,0,0,,Мен туылғаннан бері әрқашан микрон болдым. Мен бір болған жоқпын.
Dialogue: 0,0:40:39.17,0:40:43.41,Default,,0,0,0,,Умаретадан бері? Womarel өндірілетінін білдіреді ме?
Dialogue: 0,0:40:43.51,0:40:45.17,Default,,0,0,0,,Өндіріс! ?
Dialogue: 0,0:40:45.51,0:40:46.61,Default,,0,0,0,,Олай емес пе?
Dialogue: 0,0:40:46.71,0:40:50.54,Default,,0,0,0,,Оны ерлер мен әйелдер бірлесіп жасау керек.
Dialogue: 0,0:40:51.01,0:40:54.71,Default,,0,0,0,,Ерлер мен әйелдер ынтымақтасады! ? Якуде мәдениеті
Dialogue: 0,0:40:54.81,0:40:56.14,Default,,0,0,0,,Неге ұрыспасқа?
Dialogue: 0,0:40:57.07,0:40:58.81,Default,,0,0,0,,Ұрыс? Бұл әзіл емес
Dialogue: 0,0:40:58.91,0:41:02.41,Default,,0,0,0,,Әйелдің ұрысқанша құшақтап алғаны жақсы екеніне сенімдімін.
Dialogue: 0,0:41:03.34,0:41:05.91,Default,,0,0,0,,Қараңғы? Darku дегеніміз не?
Dialogue: 0,0:41:06.41,0:41:07.44,Default,,0,0,0,,Бұл сіз жасайсыз
Dialogue: 0,0:41:07.51,0:41:08.01,Default,,0,0,0,,Ах
Dialogue: 0,0:41:08.07,0:41:09.84,Default,,0,0,0,,Соғыс
Dialogue: 0,0:41:10.07,0:41:11.91,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:41:12.01,0:41:16.11,Default,,0,0,0,,Әйелдер мен еркектерде осындай мәдениет бар ма?
Dialogue: 0,0:41:16.21,0:41:18.37,Default,,0,0,0,,О, сүю немесе бәрібір.
Dialogue: 0,0:41:18.44,0:41:21.27,Default,,0,0,0,,Кит? Кит деп аталатын нәрсені көріңіз
Dialogue: 0,0:41:21.44,0:41:22.51,Default,,0,0,0,,А... бұл...
Dialogue: 0,0:41:23.21,0:41:24.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:25.04,0:41:25.67,Default,,0,0,0,,Га
Dialogue: 0,0:41:26.27,0:41:27.67,Default,,0,0,0,,Ик!
Dialogue: 0,0:41:27.97,0:41:29.44,Default,,0,0,0,,Кя ах
Dialogue: 0,0:41:30.44,0:41:31.14,Default,,0,0,0,,Минмай!
Dialogue: 0,0:41:31.27,0:41:32.07,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:41:32.21,0:41:33.31,Default,,0,0,0,,Кяаааа
Dialogue: 0,0:41:34.07,0:41:35.44,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:41:35.54,0:41:37.77,Default,,0,0,0,,Кит Макоки
Dialogue: 0,0:41:38.67,0:41:39.37,Default,,0,0,0,,…ол қалағанынша барлығын басқара алады…
Dialogue: 0,0:41:45.41,0:41:47.01,Default,,0,0,0,,Мен сені сүйемін, мені жібер
Dialogue: 0,0:41:47.24,0:41:49.11,Default,,0,0,0,,Жарайды, Мақаукей.
Dialogue: 0,0:41:49.21,0:41:50.67,Default,,0,0,0,,Кя… Кя
Dialogue: 0,0:41:53.64,0:41:55.87,Default,,0,0,0,,Тез әрекет ет, сен өлесің.
Dialogue: 0,0:41:55.97,0:41:56.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:57.44,0:41:58.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:58.81,0:42:03.91,Default,,0,0,0,,О... Уау...
Dialogue: 0,0:42:04.71,0:42:07.24,Default,,0,0,0,,Кит...
Dialogue: 0,0:42:07.34,0:42:09.71,Default,,0,0,0,,О
Dialogue: 0,0:42:25.01,0:42:25.74,Default,,0,0,0,,Минмей?
Dialogue: 0,0:42:27.71,0:42:28.81,Default,,0,0,0,,Жарқыраған…
Dialogue: 0,0:42:32.74,0:42:33.81,Default,,0,0,0,,Минмэй...
Dialogue: 0,0:42:34.67,0:42:37.67,Default,,0,0,0,,Олар сүйіспеншілікке неге таң қалды деп ойлаймын.
Dialogue: 0,0:42:38.57,0:42:40.81,Default,,0,0,0,,Еркек пен әйел төбелесіп жатқан сияқты...
Dialogue: 0,0:42:41.37,0:42:42.04,Default,,0,0,0,,Га
Dialogue: 0,0:42:42.31,0:42:43.31,Default,,0,0,0,,...
Dialogue: 0,0:42:45.71,0:42:46.84,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:42:50.87,0:42:51.94,Default,,0,0,0,,Барлығы қауіпсіз бе?
Dialogue: 0,0:42:52.04,0:42:52.71,Default,,0,0,0,,Иә
Dialogue: 0,0:42:52.81,0:42:53.87,Default,,0,0,0,,әйтеуір
Dialogue: 0,0:43:11.54,0:43:12.94,Default,,0,0,0,,Таруни Буритай
Dialogue: 0,0:43:13.04,0:43:13.54,Default,,0,0,0,,N?
Dialogue: 0,0:43:19.91,0:43:20.61,Default,,0,0,0,,Ум
Dialogue: 0,0:43:24.17,0:43:25.07,Default,,0,0,0,,Міне!
Dialogue: 0,0:43:25.31,0:43:26.11,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:43:32.87,0:43:33.47,Default,,0,0,0,,Ах
Dialogue: 0,0:43:34.64,0:43:35.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:43:35.41,0:43:36.57,Default,,0,0,0,,Жарқырап тұр! мені сүй
Dialogue: 0,0:43:36.77,0:43:39.01,Default,,0,0,0,,О, түсіндім. Кешіріңіз.
Dialogue: 0,0:43:40.31,0:43:43.84,Default,,0,0,0,,О... Уау...!
Dialogue: 0,0:43:44.31,0:43:46.01,Default,,0,0,0,,Топозды өсіру
Dialogue: 0,0:43:46.87,0:43:47.57,Default,,0,0,0,,Профессор, шай ішесіз бе?
Dialogue: 0,0:43:47.81,0:43:48.87,Default,,0,0,0,,Хиденаа
Dialogue: 0,0:43:48.97,0:43:50.44,Default,,0,0,0,,Қазір бастаңыз.
Dialogue: 0,0:43:50.54,0:43:52.14,Default,,0,0,0,,Айтпасаң да, тексер!
Dialogue: 0,0:43:55.31,0:43:56.57,Default,,0,0,0,,Мен Минмейге көмектесуім керек.
Dialogue: 0,0:44:08.91,0:44:09.74,Default,,0,0,0,,Уаа
Dialogue: 0,0:44:10.11,0:44:11.37,Default,,0,0,0,,Гяаа
Dialogue: 0,0:44:11.47,0:44:13.44,Default,,0,0,0,,Нуоооо
Dialogue: 0,0:44:29.71,0:44:32.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:36.51,0:44:37.01,Default,,0,0,0,,N?
Dialogue: 0,0:44:57.11,0:44:58.57,Default,,0,0,0,,Ууаах
Dialogue: 0,0:45:23.51,0:45:24.61,Default,,0,0,0,,Уау...
Dialogue: 0,0:45:32.44,0:45:33.17,Default,,0,0,0,,Уф
Dialogue: 0,0:45:34.44,0:45:38.94,Default,,0,0,0,,Ой... Уау.
Dialogue: 0,0:45:40.07,0:45:41.04,Default,,0,0,0,,Ахх
Dialogue: 0,0:45:41.77,0:45:42.54,Default,,0,0,0,,Бұл әйел!
Dialogue: 0,0:45:42.84,0:45:45.14,Default,,0,0,0,,Ер мен әйел төбелесіп жатыр
Dialogue: 0,0:45:45.34,0:45:46.57,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:45:46.67,0:45:47.41,Default,,0,0,0,,Жарқырап тұр!
Dialogue: 0,0:45:47.67,0:45:49.34,Default,,0,0,0,,Қазір қашыңыз!
Dialogue: 0,0:45:49.44,0:45:49.94,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:45:51.44,0:45:52.17,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:46:01.91,0:46:03.31,Default,,0,0,0,,Соғыс
Dialogue: 0,0:46:07.64,0:46:08.14,Default,,0,0,0,,ДеВри!
Dialogue: 0,0:46:14.51,0:46:16.04,Default,,0,0,0,,Ууаааах
Dialogue: 0,0:46:20.07,0:46:20.97,Default,,0,0,0,,Уау
Dialogue: 0,0:46:21.34,0:46:22.21,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:46:22.57,0:46:25.51,Default,,0,0,0,,Келме! ... Қарғыс атқыр... Мен Минмейге көмектесемін!
Dialogue: 0,0:46:25.91,0:46:26.94,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:46:27.64,0:46:28.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:30.44,0:46:32.81,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:46:41.31,0:46:42.44,Default,,0,0,0,,Уау
Dialogue: 0,0:46:45.91,0:46:52.47,Default,,0,0,0,,Эй... Теру... Клаудияға сәлем айт...
Dialogue: 0,0:47:00.71,0:47:01.47,Default,,0,0,0,,Сенпай!
Dialogue: 0,0:47:01.54,0:47:04.14,Default,,0,0,0,,Жоқ! Майордың өлімі босқа кетпесін...
Dialogue: 0,0:47:04.24,0:47:05.57,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:47:08.47,0:47:09.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:11.97,0:47:17.14,Default,,0,0,0,,Минмэй-санда таратқыш жалғанған. Жауапқа бет бұрыңыз.
Dialogue: 0,0:47:17.51,0:47:18.37,Default,,0,0,0,,…Түсінікті
Dialogue: 0,0:47:34.27,0:47:35.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:35.91,0:47:36.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:40.01,0:47:40.61,Default,,0,0,0,,Минмей!
Dialogue: 0,0:47:40.71,0:47:41.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:41.31,0:47:42.31,Default,,0,0,0,,Жарқырап тұр!
Dialogue: 0,0:47:42.67,0:47:44.67,Default,,0,0,0,,Жарқыра! Жарқырау келді!
Dialogue: 0,0:47:46.91,0:47:47.97,Default,,0,0,0,,А...
Dialogue: 0,0:47:49.21,0:47:49.87,Default,,0,0,0,,Ах
Dialogue: 0,0:47:50.51,0:47:51.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:57.81,0:47:58.54,Default,,0,0,0,,Міне, алғашқы отбасыңды мүлде ұмытып қалғансың➡
Dialogue: 0,0:47:58.61,0:48:01.51,Default,,0,0,0,,Бүктеу Бұл кеме бүктелуге жақын.
Dialogue: 0,0:48:08.11,0:48:09.04,Default,,0,0,0,,Минмей!
Dialogue: 0,0:48:09.37,0:48:10.44,Default,,0,0,0,,Жарқырап тұр!
Dialogue: 0,0:48:10.84,0:48:12.74,Default,,0,0,0,,Уау
Dialogue: 0,0:48:14.17,0:48:16.77,Default,,0,0,0,,Жарқыра... Жарқыра...
Dialogue: 0,0:49:00.21,0:49:00.87,Default,,0,0,0,,Га
Dialogue: 0,0:49:05.97,0:49:07.07,Default,,0,0,0,,Минмэй...
Dialogue: 0,0:49:08.77,0:49:13.14,Default,,0,0,0,,Ух...ха...мына?
Dialogue: 0,0:49:13.24,0:49:14.71,Default,,0,0,0,,Сіз білуге ​​мүмкіндік жоқ.
Dialogue: 0,0:49:15.81,0:49:16.91,Default,,0,0,0,,Жау кемелері ше?
Dialogue: 0,0:49:17.14,0:49:18.84,Default,,0,0,0,,Еш жерде жауап жоқ
Dialogue: 0,0:49:19.04,0:49:20.34,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:49:22.94,0:49:25.97,Default,,0,0,0,,Дегенмен, бұл қорқынышты жұлдыз...
Dialogue: 0,0:49:26.64,0:49:30.37,Default,,0,0,0,,Ха... Мен сол жақтағы мұхитты көріп тұрмын. Өтінемін, сол жаққа бара аласыз ба?
Dialogue: 0,0:49:32.07,0:49:33.41,Default,,0,0,0,,Мен барсам не болады?
Dialogue: 0,0:49:33.51,0:49:34.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:34.94,0:49:37.11,Default,,0,0,0,,Мен бәрібір Минмеймен қайта кездесе алмаймын...
Dialogue: 0,0:49:37.21,0:49:38.81,Default,,0,0,0,,А, осы ма?
Dialogue: 0,0:49:40.17,0:49:44.21,Default,,0,0,0,,Минмей де өлтіріледі... дәл Сенпай сияқты.
Dialogue: 0,0:49:46.57,0:49:49.21,Default,,0,0,0,,Мен сені Сатурнға апаруым керек...!
Dialogue: 0,0:49:49.31,0:49:52.97,Default,,0,0,0,,Бірақ қай жерде екенімізді білу де біздің міндетіміз.
Dialogue: 0,0:49:53.71,0:49:56.61,Default,,0,0,0,,О! ...Миссия Миссия! Бар болғаны осы!
Dialogue: 0,0:49:56.67,0:49:57.47,Default,,0,0,0,,Га
Dialogue: 0,0:49:57.71,0:50:00.81,Default,,0,0,0,,Түсіндім! Мен енді сенен сұрамаймын!
Dialogue: 0,0:50:01.01,0:50:02.97,Default,,0,0,0,,Уф... Эй... Эй, капитан...!
Dialogue: 0,0:50:03.11,0:50:03.81,Default,,0,0,0,,Сол кезде мен Кирамен есептесемін.
Dialogue: 0,0:50:07.91,0:50:09.31,Default,,0,0,0,,Ааааа... уф
Dialogue: 0,0:50:09.41,0:50:10.97,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:50:19.64,0:50:22.04,Default,,0,0,0,,Уф...! Ха...
Dialogue: 0,0:50:22.31,0:50:23.77,Default,,0,0,0,,Ақылсыз ештеңе жасама!
Dialogue: 0,0:50:25.91,0:50:27.54,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,0:50:27.87,0:50:30.37,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:50:40.57,0:50:41.44,Default,,0,0,0,,Бұл...
Dialogue: 0,0:50:44.34,0:50:51.94,Default,,0,0,0,,Біріккен күштердің Тынық мұхиты флотына жататын шабуылдаушы ұшақ тасығыш... Прометей
Dialogue: 0,0:50:52.44,0:50:53.31,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:50:54.41,0:50:58.71,Default,,0,0,0,,Бұл... біздің Жер...!
Dialogue: 0,0:51:52.91,0:51:58.97,Default,,0,0,0,,Түн ортасы қоңырауы соғылғанда
Dialogue: 0,0:51:59.91,0:52:06.91,Default,,0,0,0,,Жұмбақ сиқыр бұзылады...
Dialogue: 0,0:52:07.81,0:52:15.71,Default,,0,0,0,,Селкінгендей, құладым.
Dialogue: 0,0:52:15.87,0:52:22.64,Default,,0,0,0,,Баспалдақтағы шыны тәпішке...
Dialogue: 0,0:52:22.91,0:52:30.64,Default,,0,0,0,,Золушканың махаббаты сияқты
Dialogue: 0,0:52:31.67,0:52:37.61,Default,,0,0,0,,Сағат механизмі
Dialogue: 0,0:52:39.47,0:52:46.64,Default,,0,0,0,,Кеткеннің бәрі
Dialogue: 0,0:52:47.74,0:52:55.91,Default,,0,0,0,,Таң атқанша бір орында тұр
Dialogue: 0,0:52:56.07,0:52:59.04,Default,,0,0,0,,Қозғалмай отырыңыз
Dialogue: 0,0:53:00.04,0:53:07.37,Default,,0,0,0,,Таң атқанша...
Dialogue: 0,0:53:10.14,0:53:11.81,Default,,0,0,0,,О
Dialogue: 0,0:54:06.97,0:54:08.11,Default,,0,0,0,,О
Dialogue: 0,0:54:09.17,0:54:13.17,Default,,0,0,0,,«Әннің» ер мен әйелді жақындастыратын күші бар сияқты.
Dialogue: 0,0:54:13.74,0:54:15.11,Default,,0,0,0,,Қандай күш! ?
Dialogue: 0,0:54:15.81,0:54:17.44,Default,,0,0,0,,Бұл біздің жауынгерлік рухымызды алып тастай ма?
Dialogue: 0,0:54:18.27,0:54:19.97,Default,,0,0,0,,Данц
Dialogue: 0,0:54:24.24,0:54:25.44,Default,,0,0,0,,О...
Dialogue: 0,0:55:24.61,0:55:27.11,Default,,0,0,0,,Токио ақырында жойылады ма?
Dialogue: 0,0:55:29.01,0:55:31.74,Default,,0,0,0,,Аляскадағы бірлескен әскери штаб та лаваға көмілген.
Dialogue: 0,0:55:32.24,0:55:35.74,Default,,0,0,0,,Өткен аптада қайда қарасам да, бірде-бір адамды таба алмаймын.
Dialogue: 0,0:55:39.21,0:55:44.87,Default,,0,0,0,,Капитан Хаясе, келесі қайда барасыз? Лондон ба, Париж бе?
Dialogue: 0,0:55:45.44,0:55:47.91,Default,,0,0,0,,Нью-Йорк? тез тапсырыс беріңіз
Dialogue: 0,0:55:47.97,0:55:49.37,Default,,0,0,0,,Уф, тоқтат!
Dialogue: 0,0:55:49.77,0:55:50.67,Default,,0,0,0,,Га
Dialogue: 0,0:55:50.94,0:55:56.31,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз ...
Dialogue: 0,0:56:21.21,0:56:22.74,Default,,0,0,0,,Қараңызшы, күйіп қалды.
Dialogue: 0,0:56:28.47,0:56:32.27,Default,,0,0,0,,Сіз үш күннен бері тамақ ішпеген шығарсыз. Мен аздап жеуім керек.
Dialogue: 0,0:56:33.07,0:56:36.64,Default,,0,0,0,,Мен мұндай нәрсені жегенше өлгенім артық.
Dialogue: 0,0:56:37.04,0:56:41.04,Default,,0,0,0,,Радиоактивтілікті бейтараптандырғыш тиімді, сондықтан ешқандай зияны жоқ.
Dialogue: 0,0:56:44.17,0:56:47.21,Default,,0,0,0,,Сарбаздың аман қалу міндеті.
Dialogue: 0,0:56:47.67,0:56:48.97,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:56:52.21,0:56:54.94,Default,,0,0,0,,Бірақ мен жерге түсе алдым.
Dialogue: 0,0:56:55.24,0:56:59.17,Default,,0,0,0,,Макросс қауіпсіз болса, ол жақын арада оралады.
Dialogue: 0,0:57:00.61,0:57:01.51,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:57:02.67,0:57:04.27,Default,,0,0,0,,Сіз ештеңе түсінбейсіз.
Dialogue: 0,0:57:04.64,0:57:05.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:05.67,0:57:08.51,Default,,0,0,0,,Макрос келсе де, көмектеспейді.
Dialogue: 0,0:57:08.61,0:57:09.37,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:57:10.44,0:57:13.14,Default,,0,0,0,,Жерде ешкім қалмады.
Dialogue: 0,0:57:13.51,0:57:15.37,Default,,0,0,0,,Бірақ Макросстың адамдары болса...
Dialogue: 0,0:57:15.47,0:57:21.71,Default,,0,0,0,,Жер жойылды. Жау – бір сәтте 10 миллиард адамды жойып жіберетін жау.
Dialogue: 0,0:57:21.84,0:57:24.14,Default,,0,0,0,,Уф гохо гохо
Dialogue: 0,0:57:24.34,0:57:26.41,Default,,0,0,0,,Гохо
Dialogue: 0,0:57:28.14,0:57:31.74,Default,,0,0,0,,Гохо... гохо
Dialogue: 0,0:57:32.91,0:57:33.41,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:57:33.47,0:57:37.84,Default,,0,0,0,,А-а-а-а... аянышты нәрселер.
Dialogue: 0,0:57:39.27,0:57:41.91,Default,,0,0,0,,Қай әскери офицер жеңілетінін білді?
Dialogue: 0,0:57:44.91,0:57:47.77,Default,,0,0,0,,Керісінше, сіз қаталсыз.
Dialogue: 0,0:57:49.71,0:57:52.77,Default,,0,0,0,,Мен майор Фоккерден естідім.
Dialogue: 0,0:57:52.87,0:57:53.97,Default,,0,0,0,,Сіздің аға буыныңыздан?
Dialogue: 0,0:57:55.27,0:57:58.04,Default,,0,0,0,,Сіздің отбасыңыз жоқ
Dialogue: 0,0:57:58.91,0:58:03.44,Default,,0,0,0,,Анаң өмірден ерте кетті, әкең апаттан қайтыс болды.
Dialogue: 0,0:58:04.74,0:58:09.64,Default,,0,0,0,,Ой, мен акробатика жасап отырып қателесіппін.
Dialogue: 0,0:58:10.71,0:58:11.94,Default,,0,0,0,,Иә
Dialogue: 0,0:58:12.67,0:58:16.51,Default,,0,0,0,,Ал сен көптен бері жалғыз тұрдың ғой, солай емес пе?
Dialogue: 0,0:58:16.64,0:58:21.97,Default,,0,0,0,,Мен жай ғана сыйлы аңшымын. Мен бала кезімнен ұшақпен ұшатынмын.
Dialogue: 0,0:58:22.51,0:58:23.37,Default,,0,0,0,,Әй
Dialogue: 0,0:58:24.77,0:58:28.17,Default,,0,0,0,,Бірақ сондықтан мен жақсы бола аламын.
Dialogue: 0,0:58:29.87,0:58:31.37,Default,,0,0,0,,Мен емес
Dialogue: 0,0:58:32.41,0:58:34.37,Default,,0,0,0,,Мен жай ғана жауынгермін
Dialogue: 0,0:58:34.51,0:58:39.94,Default,,0,0,0,,Мен соңғы солдат болсам да аман қалармын деп ойладым, бірақ олай емес.
Dialogue: 0,0:58:40.57,0:58:41.21,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:58:43.41,0:58:44.21,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:58:51.41,0:58:53.87,Default,,0,0,0,,Кешіріңіз, мен...
Dialogue: 0,0:58:56.64,0:58:57.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:26.34,0:59:28.47,Default,,0,0,0,,Бұл не? Сол тірек
Dialogue: 0,0:59:29.71,0:59:30.54,Default,,0,0,0,,Кеттік
Dialogue: 0,0:59:49.81,0:59:52.41,Default,,0,0,0,,Көптен бері батып бара жатқан сияқты.
Dialogue: 0,0:59:53.11,0:59:53.97,Default,,0,0,0,,О
Dialogue: 0,0:59:54.97,0:59:57.37,Default,,0,0,0,,Ол жерде адамдар бар сияқты емес.
Dialogue: 0,0:59:57.54,1:00:00.34,Default,,0,0,0,,Бірақ кейбір функциялар тірі сияқты.
Dialogue: 0,1:00:07.31,1:00:09.21,Default,,0,0,0,,Өлшемі бізбен бірдей.
Dialogue: 0,1:00:09.47,1:00:12.24,Default,,0,0,0,,Алыптарға тиесілі болмаса ше?
Dialogue: 0,1:00:13.07,1:00:16.21,Default,,0,0,0,,Бұл қатпарлы байланыс жүйесі ме?
Dialogue: 0,1:00:16.67,1:00:17.74,Default,,0,0,0,,Бүктемелік байланыс?
Dialogue: 0,1:00:19.17,1:00:20.11,Default,,0,0,0,,Ол қозғалады!
Dialogue: 0,1:00:20.21,1:00:20.84,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:20.94,1:00:22.94,Default,,0,0,0,,Макросспен байланыса аласыз
Dialogue: 0,1:00:23.41,1:00:27.31,Default,,0,0,0,,Бірақ оны басқа адамдар ұстап алса, жаман болар еді...
Dialogue: 0,1:00:27.41,1:00:30.14,Default,,0,0,0,,Мен білемін, бірақ енді тырысуым керек...
Dialogue: 0,1:00:31.71,1:00:34.84,Default,,0,0,0,,Макросс қауіпсіз болса, ол сізге жауап беретініне сенімдімін.
Dialogue: 0,1:00:40.44,1:00:42.01,Default,,0,0,0,,Жауап жоқ...
Dialogue: 0,1:00:42.91,1:00:45.27,Default,,0,0,0,,Машина сынған болуы керек.
Dialogue: 0,1:00:47.71,1:00:50.07,Default,,0,0,0,,Жұмыс әдісі әртүрлі болуы мүмкін.
Dialogue: 0,1:00:50.57,1:00:51.27,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:00:52.64,1:00:54.14,Default,,0,0,0,,Басқаларды сынап көрейік
Dialogue: 0,1:01:01.47,1:01:02.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:03.27,1:01:04.81,Default,,0,0,0,,Ааа аа...
Dialogue: 0,1:01:07.14,1:01:10.51,Default,,0,0,0,,Дина Фрагкон Мелтерас
Dialogue: 0,1:01:11.54,1:01:15.37,Default,,0,0,0,,Мен... қайтуымызды күттім.
Dialogue: 0,1:01:15.47,1:01:16.37,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,1:01:16.54,1:01:18.44,Default,,0,0,0,,Иә, аздап
Dialogue: 0,1:01:18.94,1:01:20.04,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:01:20.21,1:01:23.74,Default,,0,0,0,,...
Dialogue: 0,1:01:24.11,1:01:27.04,Default,,0,0,0,,Ғарыштық иммигранттар кемесін басқару компьютері?
Dialogue: 0,1:01:27.24,1:01:29.24,Default,,0,0,0,,Де Тарни Деданцен?
Dialogue: 0,1:01:29.34,1:01:32.54,Default,,0,0,0,,Жоқ, біз осы планетаның адамдарымыз.
Dialogue: 0,1:01:32.64,1:01:35.67,Default,,0,0,0,,...
Dialogue: 0,1:01:35.74,1:01:38.27,Default,,0,0,0,,Га Генетикалық манипуляция
Dialogue: 0,1:01:38.47,1:01:42.34,Default,,0,0,0,,Ара протокультурасы Биобрант Кармазан
Dialogue: 0,1:01:42.44,1:01:48.94,Default,,0,0,0,,Waddle үшін Ort mo zentran te merutran dewan
Dialogue: 0,1:01:49.04,1:01:52.71,Default,,0,0,0,,Дьюан уадл де вогле жағдайда демия…
Dialogue: 0,1:01:58.44,1:01:59.41,Default,,0,0,0,,Жоғалып кетті…
Dialogue: 0,1:02:00.51,1:02:03.84,Default,,0,0,0,,Ха! асылу! Мен сенен бірдеңе сұрағым келеді
Dialogue: 0,1:02:04.84,1:02:06.27,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:02:06.51,1:02:08.57,Default,,0,0,0,,Сіз энергияны ауыстырдыңыз.
Dialogue: 0,1:02:08.94,1:02:10.31,Default,,0,0,0,,Жерде не бар?
Dialogue: 0,1:02:10.64,1:02:14.64,Default,,0,0,0,,Соңғы қалған энергия қаланы жер бетіне көтеруге жұмсалады.
Dialogue: 0,1:02:15.17,1:02:16.74,Default,,0,0,0,,Қаланы көтеру?
Dialogue: 0,1:02:16.84,1:02:17.61,Default,,0,0,0,,Иә
Dialogue: 0,1:02:19.94,1:02:20.44,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:02:20.51,1:02:21.51,Default,,0,0,0,,Ол қозғалды!
Dialogue: 0,1:02:30.44,1:02:35.77,Default,,0,0,0,,Ертеде Протомәдениет деп аталатын ғарыштық өркениет болған.
Dialogue: 0,1:02:36.61,1:02:40.27,Default,,0,0,0,,Онда гендік инженерия дамыды.
Dialogue: 0,1:02:40.71,1:02:47.31,Default,,0,0,0,,Ерлер өз ұрпақтарын еркектерге, ал әйелдерді тек әйелдерге көбейте алатын кезде
Dialogue: 0,1:02:48.17,1:02:56.94,Default,,0,0,0,,Олар ер адамдардан тұратын Зентраеди мен әйелдерден тұратын Мелтландиге бөлініп, соғыс бастады.
Dialogue: 0,1:02:57.81,1:03:03.47,Default,,0,0,0,,Ол кезде жаратылған адамдар тек соғысуды ғана білетін алыптар еді.
Dialogue: 0,1:03:04.17,1:03:04.74,Default,,0,0,0,,Иә
Dialogue: 0,1:03:06.57,1:03:13.34,Default,,0,0,0,,Бірақ алпауыттардың арасындағы соғыс тым қызып кеткен соң, кейбіреулер өз қателіктерін ақыры түсінді.
Dialogue: 0,1:03:14.14,1:03:19.54,Default,,0,0,0,,Тағы да ерлер мен әйелдер бірге тұратын жерді іздеуде
Dialogue: 0,1:03:20.61,1:03:23.74,Default,,0,0,0,,Бұл жерге қашып кеткен сияқты.
Dialogue: 0,1:03:28.34,1:03:34.01,Default,,0,0,0,,Және сол кезде жер бетінде болған жергілікті организмдердің гендерін манипуляциялау арқылы.
Dialogue: 0,1:03:34.14,1:03:36.91,Default,,0,0,0,,біздің ата-бабаларымызды жасаған
Dialogue: 0,1:03:37.47,1:03:39.21,Default,,0,0,0,,Ата-бабамызға дейін
Dialogue: 0,1:03:39.44,1:03:40.24,Default,,0,0,0,,Иә
Dialogue: 0,1:03:42.27,1:03:47.14,Default,,0,0,0,,Түсіндім... Сонда бұл қалашықтағы адамдар қайда?
Dialogue: 0,1:03:48.07,1:03:53.11,Default,,0,0,0,,20 000 жыл бұрын алыптар арасындағы шайқас осы Күн жүйесіне жеткенде.
Dialogue: 0,1:03:53.57,1:03:58.17,Default,,0,0,0,,Олар қаланы теңіз астына жасырып, Жерді уақытша тастап кеткен сияқты.
Dialogue: 0,1:03:59.14,1:04:01.91,Default,,0,0,0,,Бірақ ол ешқашан қайтып келмеді...
Dialogue: 0,1:04:02.54,1:04:03.27,Default,,0,0,0,,Иә
Dialogue: 0,1:04:04.91,1:04:08.17,Default,,0,0,0,,Осылайша алты ай бұрын Зентраеди армиясының пайда болуы
Dialogue: 0,1:04:08.67,1:04:12.07,Default,,0,0,0,,Компьютер осы қала тұрғындары қайтып келді деген елестің астында қалды.
Dialogue: 0,1:04:12.24,1:04:14.94,Default,,0,0,0,,Сонда сіз қаланы жер бетіне шығардыңыз ба?
Dialogue: 0,1:04:15.51,1:04:20.71,Default,,0,0,0,,Олай болса осы қалада тұрайық.
Dialogue: 0,1:04:21.81,1:04:27.04,Default,,0,0,0,,Бірақ біз 20 000 жыл күттік және біз ғана келдік...
Dialogue: 0,1:04:30.01,1:04:32.57,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:04:41.17,1:04:42.64,Default,,0,0,0,,Ол өте зақымдалған.
Dialogue: 0,1:04:43.17,1:04:43.94,Default,,0,0,0,,Иә
Dialogue: 0,1:04:49.87,1:04:50.57,Default,,0,0,0,,О.
Dialogue: 0,1:04:53.27,1:04:54.54,Default,,0,0,0,,Бірдеңе
Dialogue: 0,1:04:55.21,1:04:56.24,Default,,0,0,0,,Бірдеңе таптыңыз ба?
Dialogue: 0,1:04:56.34,1:04:58.34,Default,,0,0,0,,Иә, онда бірдеңе жазылған сияқты.
Dialogue: 0,1:04:59.77,1:05:01.04,Default,,0,0,0,,Есте сақта...
Dialogue: 0,1:05:02.11,1:05:05.11,Default,,0,0,0,,Есте сақта... Есіңде ме?
Dialogue: 0,1:05:05.47,1:05:09.71,Default,,0,0,0,,Хмм... Алпауыттардың жазуынан әлдеқайда күрделі, сондықтан мен оны шынымен түсінбеймін.
Dialogue: 0,1:05:09.81,1:05:10.94,Default,,0,0,0,,Иә
Dialogue: 0,1:05:17.57,1:05:18.51,Default,,0,0,0,,Хмм...
Dialogue: 0,1:05:20.47,1:05:22.14,Default,,0,0,0,,Үйге ұқсайды.
Dialogue: 0,1:05:23.11,1:05:24.24,Default,,0,0,0,,Басқа жерлерге барайық
Dialogue: 0,1:05:24.37,1:05:26.41,Default,,0,0,0,,Мен осында тағы біраз тұра аламын ба?
Dialogue: 0,1:05:26.51,1:05:27.04,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:27.71,1:05:32.91,Default,,0,0,0,,Бұл үлкен мәселе емес, бірақ хехе, бәрібір.
Dialogue: 0,1:05:33.84,1:05:37.81,Default,,0,0,0,,Дұрыс, онда мен басқа нәрсені қарастырамын.
Dialogue: 0,1:05:38.57,1:05:39.34,Default,,0,0,0,,Әй
Dialogue: 0,1:05:39.94,1:05:41.67,Default,,0,0,0,,Мен бірден қайтамын.
Dialogue: 0,1:05:45.44,1:05:46.01,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:05:56.74,1:05:57.51,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:06:02.31,1:06:03.91,Default,,0,0,0,,Бұл өзгермейді, солай ма?
Dialogue: 0,1:06:16.07,1:06:18.04,Default,,0,0,0,,Ааааааааааааааааааааааа
Dialogue: 0,1:06:34.31,1:06:39.11,Default,,0,0,0,,Ол жерде ешкім жоқ сияқты, ал машиналар жарамсыз дерлік.
Dialogue: 0,1:06:39.94,1:06:40.67,Default,,0,0,0,,Ах
Dialogue: 0,1:06:46.17,1:06:48.37,Default,,0,0,0,,Сәлем, қош келдіңіз.
Dialogue: 0,1:06:48.91,1:06:50.71,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,1:06:52.31,1:06:54.91,Default,,0,0,0,,Енді тамақтанайық
Dialogue: 0,1:06:59.31,1:07:00.14,Default,,0,0,0,,Га
Dialogue: 0,1:07:11.27,1:07:12.07,Default,,0,0,0,,О
Dialogue: 0,1:07:14.91,1:07:15.97,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:07:33.77,1:07:35.21,Default,,0,0,0,,Хехе
Dialogue: 0,1:07:45.11,1:07:45.77,Default,,0,0,0,,Ах
Dialogue: 0,1:07:49.41,1:07:54.81,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,1:07:58.27,1:07:59.44,Default,,0,0,0,,Ерен, көрдің бе?
Dialogue: 0,1:08:01.61,1:08:08.07,Default,,0,0,0,,Барлығының орнында
Dialogue: 0,1:08:09.67,1:08:10.47,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:08:16.77,1:08:18.04,Default,,0,0,0,,Ичиджо-кун
Dialogue: 0,1:09:01.51,1:09:03.21,Default,,0,0,0,,Қызық, ол қайтадан қозғала бастайды ма?
Dialogue: 0,1:09:03.31,1:09:05.47,Default,,0,0,0,,Жоқ, бұл дыбыс аспаннан келеді.
Dialogue: 0,1:09:05.81,1:09:06.71,Default,,0,0,0,,Қарсылығы барлар қазір айтсын, әйтпесе үнсіз қалсын…
Dialogue: 0,1:09:07.51,1:09:08.54,Default,,0,0,0,,О
Dialogue: 0,1:09:11.71,1:09:12.47,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:09:12.54,1:09:13.14,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,1:09:18.97,1:09:19.77,Default,,0,0,0,,О
Dialogue: 0,1:09:20.11,1:09:21.64,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:27.47,1:09:28.51,Default,,0,0,0,,Макросс!
Dialogue: 0,1:09:30.11,1:09:32.04,Default,,0,0,0,,Хабарды алдыңыз.
Dialogue: 0,1:09:32.14,1:09:33.04,Default,,0,0,0,,О
Dialogue: 0,1:09:42.21,1:09:45.87,Default,,0,0,0,,Миса Хаясе Акира Ичижо жақында оралды.
Dialogue: 0,1:09:45.94,1:09:46.77,Default,,0,0,0,,Иә
Dialogue: 0,1:09:54.81,1:09:59.54,Default,,0,0,0,,Енді қайтып келдің, Жердегі жағдай қандай?
Dialogue: 0,1:09:59.77,1:10:00.47,Default,,0,0,0,,Иә
Dialogue: 0,1:10:02.17,1:10:08.61,Default,,0,0,0,,Соңғы айда біз жерден 15 000 километр биіктікте және бөтен қала ғарыш кемелерін зерттедік.
Dialogue: 0,1:10:09.21,1:10:11.77,Default,,0,0,0,,Екі жағдайда да тірі қалғандар жоқ.
Dialogue: 0,1:10:13.41,1:10:15.24,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:10:16.57,1:10:21.41,Default,,0,0,0,,Толық есепті кейінірек аласыз. Алдымен жақсылап демалыңыз.
Dialogue: 0,1:10:21.61,1:10:22.27,Default,,0,0,0,,Иә!
Dialogue: 0,1:10:44.04,1:10:45.84,Default,,0,0,0,,Рой құрметті болды ма?
Dialogue: 0,1:10:46.91,1:10:47.84,Default,,0,0,0,,Иә
Dialogue: 0,1:10:51.27,1:10:55.34,Default,,0,0,0,,Рахмет, жеткілікті.
Dialogue: 0,1:11:17.74,1:11:18.77,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:11:19.67,1:11:20.74,Default,,0,0,0,,Уау...
Dialogue: 0,1:11:27.21,1:11:30.97,Default,,0,0,0,,Түрік кофесінің иісіне міну...
Dialogue: 0,1:11:32.77,1:11:33.44,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:39.57,1:11:40.27,Default,,0,0,0,,Минмэй...
Dialogue: 0,1:11:41.34,1:11:43.01,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:11:47.07,1:11:52.21,Default,,0,0,0,,Біртүрлі, Минмей-сан бір жерге кетіп қалды.
Dialogue: 0,1:11:52.71,1:11:55.54,Default,,0,0,0,,Ән әлі ойнап тұр
Dialogue: 0,1:11:56.27,1:11:57.31,Default,,0,0,0,,Ән...
Dialogue: 0,1:12:01.61,1:12:04.54,Default,,0,0,0,,Тірі сияқты
Dialogue: 0,1:12:05.01,1:12:05.91,Default,,0,0,0,,О
Dialogue: 0,1:12:07.77,1:12:10.04,Default,,0,0,0,,Қандай да бір сағыныш сезімін тудырады.
Dialogue: 0,1:12:10.64,1:12:11.87,Default,,0,0,0,,Ностальгиялық?
Dialogue: 0,1:12:15.54,1:12:18.11,Default,,0,0,0,,Содан бері бір ай ғана өтті.
Dialogue: 0,1:12:19.04,1:12:24.67,Default,,0,0,0,,Мен Минмэймен бірге ұшқанда баяғыда сияқты болдым.
Dialogue: 0,1:12:26.17,1:12:26.67,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:12:26.74,1:12:31.21,Default,,0,0,0,,Түнді жылататын сыған скрипкасы
Dialogue: 0,1:12:31.41,1:12:35.64,Default,,0,0,0,,Бір бөтелке шарап пен екі стақан
Dialogue: 0,1:12:35.91,1:12:40.57,Default,,0,0,0,,Тіпті менің күйіп тұрған сезімім де көмектеспейді
Dialogue: 0,1:12:50.94,1:12:53.17,Default,,0,0,0,,Милия Рен Тинг Нан
Dialogue: 0,1:12:53.31,1:12:54.91,Default,,0,0,0,,Саа! Морк Лапрамиз
Dialogue: 0,1:13:16.37,1:13:20.14,Default,,0,0,0,,Теңіз бетіне жақындап келе жатқан 27-ауданнан қолға түскен жау ұшағы
Dialogue: 0,1:13:20.47,1:13:23.57,Default,,0,0,0,,Ол тек әйелдерден тұратын Мелтландқа тиесілі деп болжануда.
Dialogue: 0,1:13:23.74,1:13:24.57,Default,,0,0,0,,Тек әйелдер?
Dialogue: 0,1:13:24.91,1:13:26.14,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:13:26.27,1:13:28.27,Default,,0,0,0,,Әйел адаммын деп жеңіл қабылдамаңыз.
Dialogue: 0,1:13:28.77,1:13:31.11,Default,,0,0,0,,Егер олар шатасса, олар Zentraedi-ге қарағанда қатал болады.
Dialogue: 0,1:13:32.14,1:13:33.37,Default,,0,0,0,,Бұл қызық
Dialogue: 0,1:13:33.77,1:13:34.87,Default,,0,0,0,,Қызықты ма?
Dialogue: 0,1:13:35.21,1:13:39.04,Default,,0,0,0,,Не болды, Ичиджо-кун, сен кенет қорқақ болып кеттің.
Dialogue: 0,1:13:39.14,1:13:39.97,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,1:13:40.37,1:13:45.87,Default,,0,0,0,,Капитан Макс айтқандай, ол әйел алғандықтан шығар? Ихихаха!
Dialogue: 0,1:13:46.24,1:13:47.01,Default,,0,0,0,,Уау!
Dialogue: 0,1:13:47.31,1:13:48.17,Default,,0,0,0,,Какидзаки!
Dialogue: 0,1:13:55.54,1:13:56.04,Default,,0,0,0,,Аһ!
Dialogue: 0,1:14:09.64,1:14:10.37,Default,,0,0,0,,Әй!
Dialogue: 0,1:14:14.24,1:14:14.74,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:14:15.07,1:14:15.71,Default,,0,0,0,,Қабылданбады!
Dialogue: 0,1:14:17.47,1:14:18.21,Default,,0,0,0,,Мәдениет!
Dialogue: 0,1:14:24.37,1:14:25.27,Default,,0,0,0,,Дебран!
Dialogue: 0,1:14:26.54,1:14:27.11,Default,,0,0,0,,Уау!
Dialogue: 0,1:14:35.77,1:14:36.27,Default,,0,0,0,,Ғү!
Dialogue: 0,1:14:38.17,1:14:39.44,Default,,0,0,0,,Дебран мәдениеті!
Dialogue: 0,1:14:42.47,1:14:43.37,Default,,0,0,0,,Сағынып қаласыз ба?
Dialogue: 0,1:14:43.74,1:14:44.44,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:45.41,1:14:46.34,Default,,0,0,0,,Жауынгерлік кеме?
Dialogue: 0,1:14:57.27,1:14:57.77,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,1:15:12.51,1:15:13.07,Default,,0,0,0,,Уф!
Dialogue: 0,1:15:14.27,1:15:15.31,Default,,0,0,0,,Ахх!
Dialogue: 0,1:16:01.31,1:16:03.01,Default,,0,0,0,,Қарғыс атсын! Осылай қала берсе
Dialogue: 0,1:16:05.34,1:16:05.91,Default,,0,0,0,,Әй?
Dialogue: 0,1:16:07.31,1:16:09.64,Default,,0,0,0,,Лулулулулу…
Dialogue: 0,1:16:10.54,1:16:11.64,Default,,0,0,0,,Минмэй...
Dialogue: 0,1:16:12.31,1:16:13.07,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:13.41,1:16:14.14,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:14.81,1:16:16.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:16:16.17,1:16:17.14,Default,,0,0,0,,Қай ән?
Dialogue: 0,1:16:17.81,1:16:19.91,Default,,0,0,0,,Неліктен Минмэй...
Dialogue: 0,1:16:20.71,1:16:25.74,Default,,0,0,0,,Ааа аа...
Dialogue: 0,1:16:26.61,1:16:27.14,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:29.77,1:16:31.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:32.21,1:16:35.11,Default,,0,0,0,,Жұмған аузыңды ашпа. Бір күні білесің.
Dialogue: 0,1:16:35.21,1:16:37.44,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,1:16:40.71,1:16:42.41,Default,,0,0,0,,Әдемі...
Dialogue: 0,1:16:43.57,1:16:47.11,Default,,0,0,0,,А... Уцукусии?
Dialogue: 0,1:16:59.94,1:17:00.44,Default,,0,0,0,,Ха!
Dialogue: 0,1:17:00.81,1:17:05.94,Default,,0,0,0,,Лулулу Лулулу…
Dialogue: 0,1:17:06.47,1:17:09.71,Default,,0,0,0,,Лулулулу…
Dialogue: 0,1:17:18.91,1:17:21.87,Default,,0,0,0,,Сәттілік, Мелтран, біз шегіндік.
Dialogue: 0,1:17:22.07,1:17:27.47,Default,,0,0,0,,Ходанц Егер сізде Минмейдің осы мен аймағында айтқан каши болса,
Dialogue: 0,1:17:27.61,1:17:29.84,Default,,0,0,0,,Мелтранды тапсыруға болады
Dialogue: 0,1:17:41.51,1:17:45.34,Default,,0,0,0,,Капитан, Зентраеди бейбіт келіссөздер жүргізуді сұрады.
Dialogue: 0,1:17:46.14,1:17:47.84,Default,,0,0,0,,Бейбітшілік келіссөздері?
Dialogue: 0,1:18:10.37,1:18:12.27,Default,,0,0,0,,А, сізде қандай хабарландыру бар?
Dialogue: 0,1:18:12.37,1:18:14.94,Default,,0,0,0,,А... тыңдап тұрсың ба?
Dialogue: 0,1:18:15.24,1:18:18.61,Default,,0,0,0,,Мені қашанға дейін күтесің...
Dialogue: 0,1:18:19.11,1:18:23.71,Default,,0,0,0,,Біз бригада генералы Глобалдың ресми мәлімдемесін жасағалы отырмыз.
Dialogue: 0,1:18:30.27,1:18:32.64,Default,,0,0,0,,Мммммммммф
Dialogue: 0,1:18:33.07,1:18:37.47,Default,,0,0,0,,Біріккен ғарыш күштері SDF-1 Макросс болып табылады
Dialogue: 0,1:18:38.17,1:18:41.51,Default,,0,0,0,,11 қыркүйек күні сағат 11.00-дегі жағдай бойынша
Dialogue: 0,1:18:41.84,1:18:49.31,Default,,0,0,0,,Біз Зентраеди армиясының 425-ші Бодор негізгі флотымен бітімге келдік.
Dialogue: 0,1:18:49.44,1:18:54.17,Default,,0,0,0,,Иә? Не болды...
Dialogue: 0,1:18:54.34,1:18:58.41,Default,,0,0,0,,О... иә?
Dialogue: 0,1:18:58.61,1:19:05.31,Default,,0,0,0,,Енді осы қалалық ғарыш кемесі қирандыларын зерттегеннен кейін біз апатты жағдайда қондық.
Dialogue: 0,1:19:06.57,1:19:09.44,Default,,0,0,0,,Бұл қаланы салған жат планеталықтар
Dialogue: 0,1:19:09.87,1:19:14.37,Default,,0,0,0,,500 000 жыл бұрын өркендеген протомәдениет болған.
Dialogue: 0,1:19:14.94,1:19:17.81,Default,,0,0,0,,Ірі жұлдызаралық өркениеттің ұрпағы.
Dialogue: 0,1:19:17.94,1:19:25.84,Default,,0,0,0,,Біз Жер тұрғындары, Зентраеди сарбаздары және оларға дұшпандық білдіретін Мелтланди халқы.
Dialogue: 0,1:19:25.94,1:19:32.27,Default,,0,0,0,,Бастапқыда олардың барлығының генетикалық құрылымы осы протокультурамен бірдей болды.
Dialogue: 0,1:19:32.41,1:19:33.91,Default,,0,0,0,,Бұл түсінікті болды
Dialogue: 0,1:19:34.37,1:19:35.61,Default,,0,0,0,,Дәл біз сияқты!
Dialogue: 0,1:19:35.71,1:19:38.11,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,1:19:38.37,1:19:42.47,Default,,0,0,0,,Протокультураның таңғажайып ғылыми күшімен олар
Dialogue: 0,1:19:42.64,1:19:47.61,Default,,0,0,0,,Ол адам гендерін өзгерту арқылы жасалған.
Dialogue: 0,1:19:47.71,1:19:49.27,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,1:19:54.74,1:20:01.81,Default,,0,0,0,,Олардың гендік инженериясы арқылы алыптарды біз сияқты адамға айналдыруға болады.
Dialogue: 0,1:20:04.37,1:20:10.54,Default,,0,0,0,,Мұнда отырған үш адам жаңа ғана көрген Зентраеди.
Dialogue: 0,1:20:10.64,1:20:12.01,Default,,0,0,0,,Иә!
Dialogue: 0,1:20:14.91,1:20:18.81,Default,,0,0,0,,Олар мүлде мәдениеті жоқ жауынгерлік нәсіл.
Dialogue: 0,1:20:19.17,1:20:25.64,Default,,0,0,0,,500 000 жыл бойы екі топ, еркек пен әйел бір-бірімен соғысып келеді.
Dialogue: 0,1:20:25.77,1:20:31.67,Default,,0,0,0,,Операция сәтті болмайынша Протокультураның Еркелін алуға тыйым салу керек емес пе?
Dialogue: 0,1:20:31.97,1:20:32.54,Default,,0,0,0,,Хмм
Dialogue: 0,1:20:33.11,1:20:34.04,Default,,0,0,0,,Марқа ят?
Dialogue: 0,1:20:34.91,1:20:37.37,Default,,0,0,0,,Сіз оны көре аласыз ба? Сол үш адам
Dialogue: 0,1:20:38.27,1:20:42.77,Default,,0,0,0,,Жер тұрғындары атысты тоқтату үшін жіберілген микроклон қандай?
Dialogue: 0,1:20:43.07,1:20:43.94,Default,,0,0,0,,Хмм
Dialogue: 0,1:20:44.37,1:20:48.94,Default,,0,0,0,,Британ ешқашан Зентраны мұндай мәдениетті көрмеген.
Dialogue: 0,1:20:49.01,1:20:51.07,Default,,0,0,0,,Мен мұны бірінші рет айтып отырмын.
Dialogue: 0,1:20:51.17,1:20:54.97,Default,,0,0,0,,Ал Мелтранмен осылай, әйелмен...
Dialogue: 0,1:20:55.04,1:20:58.31,Default,,0,0,0,,Мен де шағын несие алғым келеді.
Dialogue: 0,1:20:58.41,1:21:00.14,Default,,0,0,0,,Ят мәдениеті!
Dialogue: 0,1:21:00.47,1:21:01.71,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,1:21:02.14,1:21:03.87,Default,,0,0,0,,Хмм, әзілдеп тұрмын.
Dialogue: 0,1:21:04.17,1:21:05.17,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,1:21:06.07,1:21:07.17,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,1:21:07.24,1:21:07.97,Default,,0,0,0,,Иә
Dialogue: 0,1:21:09.11,1:21:15.21,Default,,0,0,0,,Протокультура қызметкері Минмей маған бұл «маңызды емес» дегенді білдіретінін айтты
Dialogue: 0,1:21:15.64,1:21:17.01,Default,,0,0,0,,Мәдениет…
Dialogue: 0,1:21:17.31,1:21:21.84,Default,,0,0,0,,Сіздерді галактикадағы ең үлкен супержұлдызбен таныстыруға рұқсат етіңіздер.
Dialogue: 0,1:21:22.41,1:21:24.64,Default,,0,0,0,,Лин Мингмэй!
Dialogue: 0,1:21:38.24,1:21:40.07,Default,,0,0,0,,Бұл қазір ойнап жатқан әуен
Dialogue: 0,1:21:40.47,1:21:45.34,Default,,0,0,0,,Бұл ежелгі дәуірден Зентраеди әскерилеріне жеткен жад тақтасының шифрланған нұсқасы.
Dialogue: 0,1:21:46.24,1:21:50.47,Default,,0,0,0,,Өкінішке орай, олардың есте сақтау тақталары...
Dialogue: 0,1:21:50.84,1:21:53.47,Default,,0,0,0,,Бұл әннің сөздері жазылмаған
Dialogue: 0,1:21:53.87,1:21:58.94,Default,,0,0,0,,Сонымен, қазіргі уақытта Макроссты ойнап жүрген лириктер осы әнге арналған ән ойлап тапты.
Dialogue: 0,1:21:59.24,1:22:01.31,Default,,0,0,0,,Тамаша ән мәтіндерін жасапсыз.
Dialogue: 0,1:22:02.01,1:22:07.81,Default,,0,0,0,,Содан мен бұл әнді бүкіл әлемге таратып, Мелтланди халқымен татуластым.
Dialogue: 0,1:22:07.91,1:22:11.37,Default,,0,0,0,,Мен соғыссыз бейбіт әлем құрғым келеді.
Dialogue: 0,1:22:11.57,1:22:17.77,Default,,0,0,0,,Уау! Апыр-ай! Хуухюу!
Dialogue: 0,1:22:19.21,1:22:23.04,Default,,0,0,0,,Осылайша біз бейбітшілікке алғашқы қадам жасай аламыз.
Dialogue: 0,1:22:23.41,1:22:27.44,Default,,0,0,0,,Қаншама адамдардың асыл құрбандықтарының арқасында ғана болды.
Dialogue: 0,1:22:27.54,1:22:30.64,Default,,0,0,0,,Ойлап қарасам, ол күндер азапты, мұңды болды.
Dialogue: 0,1:22:30.74,1:22:37.01,Default,,0,0,0,,Соғысқа түсіп, тұтқынға түсті, бөлініп кетті, бірақ керемет түрде құтқарылды.
Dialogue: 0,1:22:37.41,1:22:40.41,Default,,0,0,0,,Қиындыққа төзген жастар
Dialogue: 0,1:22:40.64,1:22:43.57,Default,,0,0,0,,Енді міне көз жасы төгілген кездесу.
Dialogue: 0,1:22:43.71,1:22:47.17,Default,,0,0,0,,Лин Мингмей күткен адам...
Dialogue: 0,1:22:47.91,1:22:51.97,Default,,0,0,0,,Біріккен күштердің бас операторы майор Хаясемен
Dialogue: 0,1:22:52.41,1:22:57.41,Default,,0,0,0,,Бұл Валькири бас сүйек взводының лейтенанты Ичижо.
Dialogue: 0,1:22:57.57,1:23:01.51,Default,,0,0,0,,Ооо! Хуухюу!
Dialogue: 0,1:23:01.61,1:23:02.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:09.37,1:23:10.61,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,1:23:13.24,1:23:14.54,Default,,0,0,0,,Жарқыраған…
Dialogue: 0,1:23:20.94,1:23:22.11,Default,,0,0,0,,Минмай…
Dialogue: 0,1:23:24.91,1:23:27.41,Default,,0,0,0,,Жарқырап тұр! Жарқыраған!
Dialogue: 0,1:23:29.74,1:23:30.64,Default,,0,0,0,,Хмм...
Dialogue: 0,1:23:31.31,1:23:34.61,Default,,0,0,0,,Жарқырайды, жарқырайды, жарқырайды!
Dialogue: 0,1:23:34.71,1:23:40.94,Default,,0,0,0,,Ах! о! Ах...
Dialogue: 0,1:23:42.24,1:23:44.67,Default,,0,0,0,,Ха... а...
Dialogue: 0,1:23:45.31,1:23:47.54,Default,,0,0,0,,Жарқырап... Жарқырап жатыр ма?
Dialogue: 0,1:23:49.69,1:23:51.12,Default,,0,0,0,,Уф...
Dialogue: 0,1:24:08.62,1:24:10.92,Default,,0,0,0,,«Сүйікті қыз, арман мезгілі»?
Dialogue: 0,1:24:11.02,1:24:13.32,Default,,0,0,0,,А, бәрі жақсы емес.
Dialogue: 0,1:24:20.25,1:24:20.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:24.65,1:24:28.65,Default,,0,0,0,,Есіңде ме? Көзге...
Dialogue: 0,1:24:32.25,1:24:37.72,Default,,0,0,0,,Есіңде ме, көзіміз тоғысты...
Dialogue: 0,1:24:40.72,1:24:42.02,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,1:24:49.92,1:24:50.69,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:24:54.72,1:24:55.29,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,1:24:56.19,1:24:56.89,Default,,0,0,0,,Иә
Dialogue: 0,1:25:03.55,1:25:04.22,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:06.09,1:25:07.22,Default,,0,0,0,,Минмай…
Dialogue: 0,1:25:12.02,1:25:12.82,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,1:25:27.69,1:25:32.92,Default,,0,0,0,,Менің ойымша, сіз қазір бос емессіз. Ойлап қарасам, әннің сөзін жаза алмаймын...
Dialogue: 0,1:25:34.19,1:25:35.25,Default,,0,0,0,,Минмай…
Dialogue: 0,1:25:38.22,1:25:39.36,Default,,0,0,0,,Мен сені жақсы көремін...
Dialogue: 0,1:25:41.92,1:25:42.85,Default,,0,0,0,,Әй
Dialogue: 0,1:25:43.42,1:25:50.15,Default,,0,0,0,,Мен ол адамның арасында не болғанын білмеймін, бірақ бәрібір.
Dialogue: 0,1:25:51.32,1:25:53.62,Default,,0,0,0,,Маған ұнайсың
Dialogue: 0,1:26:11.82,1:26:14.05,Default,,0,0,0,,Минмэй I...
Dialogue: 0,1:26:17.12,1:26:17.65,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:26:19.39,1:26:19.89,Default,,0,0,0,,Ха!
Dialogue: 0,1:26:20.25,1:26:20.92,Default,,0,0,0,,Ах!
Dialogue: 0,1:26:22.36,1:26:22.92,Default,,0,0,0,,Га
Dialogue: 0,1:26:31.99,1:26:33.25,Default,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,1:26:38.05,1:26:39.25,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:26:39.62,1:26:41.09,Default,,0,0,0,,Қалай...
Dialogue: 0,1:26:42.29,1:26:44.25,Default,,0,0,0,,Бұл не екені есіңізде ме?
Dialogue: 0,1:26:44.36,1:26:46.25,Default,,0,0,0,,(Тісін қысып)
Dialogue: 0,1:26:46.92,1:26:49.32,Default,,0,0,0,,Қираған қаладан табылған табақ.
Dialogue: 0,1:26:50.75,1:26:55.29,Default,,0,0,0,,Осыны ашқанда, бұл әннің мәтініндей екенін түсіндім...
Dialogue: 0,1:26:55.52,1:26:56.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:56.95,1:26:58.05,Default,,0,0,0,,Сол ән?
Dialogue: 0,1:27:00.09,1:27:04.12,Default,,0,0,0,,Мен сізден алдымен тексеруіңізді өтінемін деп ойладым...
Dialogue: 0,1:27:04.89,1:27:05.52,Default,,0,0,0,,Хмм...
Dialogue: 0,1:27:08.39,1:27:12.02,Default,,0,0,0,,Бір минут күте тұрыңыз! Жоқ, бұл сіздің түсінбеуіңіз...
Dialogue: 0,1:27:12.09,1:27:13.25,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:27:13.46,1:27:14.49,Default,,0,0,0,,О
Dialogue: 0,1:27:16.79,1:27:18.09,Default,,0,0,0,,Бұл түсінбеушілік...
Dialogue: 0,1:27:18.29,1:27:19.82,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:27:20.79,1:27:26.02,Default,,0,0,0,,Уф, артық емес... Артық емес! Уф!
Dialogue: 0,1:27:27.39,1:27:28.36,Default,,0,0,0,,Минмей!
Dialogue: 0,1:27:28.62,1:27:29.72,Default,,0,0,0,,Мин... а
Dialogue: 0,1:27:32.15,1:27:34.12,Default,,0,0,0,,Оны тезірек қуып жетсеңіз, соғұрлым жақсы.
Dialogue: 0,1:27:35.95,1:27:39.62,Default,,0,0,0,,Сізбен тағы да кездескеніме қуаныштымын, сондықтан тосқауыл қоятын ештеңе жоқ.
Dialogue: 0,1:27:42.25,1:27:45.79,Default,,0,0,0,,Біреу маған жанашырлық танытса, одан да аянышты болар еді...
Dialogue: 0,1:27:45.85,1:27:46.65,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,1:27:46.72,1:27:47.32,Default,,0,0,0,,Ха!
Dialogue: 0,1:27:48.46,1:27:50.02,Default,,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 0,1:27:51.65,1:27:52.25,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:27:55.59,1:27:58.39,Default,,0,0,0,,Ешкім жоқ жерді кезіп жүру
Dialogue: 0,1:28:00.79,1:28:03.36,Default,,0,0,0,,Мен Макроссқа аман-есен оралдым.
Dialogue: 0,1:28:05.95,1:28:09.55,Default,,0,0,0,,Қалада Минмейдің әнін естігенде
Dialogue: 0,1:28:10.22,1:28:13.02,Default,,0,0,0,,Мен оны экранда көргенде
Dialogue: 0,1:28:15.02,1:28:16.02,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:28:22.92,1:28:25.85,Default,,0,0,0,,Мәңгілік қасымда болғаныңды қалаймын
Dialogue: 0,1:28:29.85,1:28:30.95,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,1:28:31.62,1:28:32.32,Default,,0,0,0,,Га
Dialogue: 0,1:28:33.99,1:28:35.75,Default,,0,0,0,,Мен әлі де солай етуге ниеттемін.
Dialogue: 0,1:28:41.05,1:28:42.42,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,1:28:44.55,1:28:47.19,Default,,0,0,0,,Мен қашан өлетінімді білмеймін
Dialogue: 0,1:28:49.69,1:28:52.19,Default,,0,0,0,,Менің бұлай болғаным дұрыс болса
Dialogue: 0,1:28:57.15,1:29:02.32,Default,,0,0,0,,Ой-а-а...
Dialogue: 0,1:29:03.19,1:29:09.36,Default,,0,0,0,,Ууууууууууууу, не болды?
Dialogue: 0,1:29:09.65,1:29:12.32,Default,,0,0,0,,Біртүрлі екен, Акира...
Dialogue: 0,1:29:13.19,1:29:13.89,Default,,0,0,0,,Ха...
Dialogue: 0,1:29:18.79,1:29:21.89,Default,,0,0,0,,Мен жылауымды тоқтата алмаймын
Dialogue: 0,1:29:24.65,1:29:25.75,Default,,0,0,0,,Миса...
Dialogue: 0,1:29:27.89,1:29:30.85,Default,,0,0,0,,А-а, жарқырай бер!
Dialogue: 0,1:29:42.29,1:29:42.99,Default,,0,0,0,,Ах!
Dialogue: 0,1:29:43.89,1:29:45.89,Default,,0,0,0,,Бірінші дәрежелі төтенше жағдай
Dialogue: 0,1:29:51.92,1:29:55.59,Default,,0,0,0,,Соғыстың зейін деңгейі
Dialogue: 0,1:29:56.55,1:29:58.95,Default,,0,0,0,,Максималды позицияны алыңыз…
Dialogue: 0,1:30:13.95,1:30:16.92,Default,,0,0,0,,Ух, иә...
Dialogue: 0,1:30:17.52,1:30:19.52,Default,,0,0,0,,Осы өлең сөздерін Минмейсаға жіберіңіз
Dialogue: 0,1:30:21.05,1:30:21.62,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,1:30:35.36,1:30:38.12,Default,,0,0,0,,Жарайсың! Егер сізде каши болмаса ше?
Dialogue: 0,1:30:38.39,1:30:42.42,Default,,0,0,0,,Саттаруни Бұл Лин Минмэй жоғалып кетті деген Еркел.
Dialogue: 0,1:30:42.99,1:30:45.19,Default,,0,0,0,,Данц мәдениеті
Dialogue: 0,1:30:45.92,1:30:47.69,Default,,0,0,0,,Холт Мельтран Дефолд
Dialogue: 0,1:30:47.75,1:30:48.25,Default,,0,0,0,,Хмм?
Dialogue: 0,1:31:19.69,1:31:24.25,Default,,0,0,0,,Минмэйді ән айтуды тек сен ғана жасай аласың.
Dialogue: 0,1:31:25.42,1:31:28.39,Default,,0,0,0,,Лапрамиз Алма Зукара Дефолд
Dialogue: 0,1:31:28.99,1:31:32.72,Default,,0,0,0,,Ән аяқталмаса, Мелтранды бағындыру мүмкін емес.
Dialogue: 0,1:31:33.12,1:31:35.25,Default,,0,0,0,,Егер бұл орын алса, оны жойыңыз.
Dialogue: 0,1:31:35.95,1:31:41.85,Default,,0,0,0,,Мақсат Макросс және Лапрамиз флотының Алма Центран ақауы Гадра!
Dialogue: 0,1:31:46.55,1:31:50.85,Default,,0,0,0,,Бейбітшілік қысқа ғана болды ма?
Dialogue: 0,1:31:51.82,1:31:55.42,Default,,0,0,0,,Барлық кемелер бірден ұшырылады! Бұл жерді дереу эвакуациялаңыз!
Dialogue: 0,1:32:33.72,1:32:34.55,Default,,0,0,0,,Уау!
Dialogue: 0,1:32:35.52,1:32:36.42,Default,,0,0,0,,Бұл басталды!
Dialogue: 0,1:32:43.82,1:32:45.85,Default,,0,0,0,,Қарғыс атсын! Дебран Бодолза
Dialogue: 0,1:33:01.95,1:33:04.39,Default,,0,0,0,,Мен қатты толқып тұрмын!
Dialogue: 0,1:33:11.55,1:33:12.19,Default,,0,0,0,,Уау!
Dialogue: 0,1:33:13.69,1:33:17.65,Default,,0,0,0,,Қарғыс атсын! Ха ха ха...
Dialogue: 0,1:33:17.75,1:33:22.75,Default,,0,0,0,,Мен қатты толқып тұрмын!
Dialogue: 0,1:33:22.85,1:33:27.15,Default,,0,0,0,,Мен қатты толқып тұрмын!
Dialogue: 0,1:33:29.85,1:33:36.22,Default,,0,0,0,,Мен қатты толқып тұрмын!
Dialogue: 0,1:33:36.39,1:33:42.65,Default,,0,0,0,,Уф! Уф! Ха ха ха...
Dialogue: 0,1:33:58.36,1:33:58.95,Default,,0,0,0,,Га
Dialogue: 0,1:34:03.05,1:34:08.12,Default,,0,0,0,,Ой-а-а...
Dialogue: 0,1:34:09.39,1:34:10.99,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,1:34:14.36,1:34:15.29,Default,,0,0,0,,Акира
Dialogue: 0,1:34:17.15,1:34:21.25,Default,,0,0,0,,Ха ха Минмей
Dialogue: 0,1:34:28.62,1:34:33.05,Default,,0,0,0,,Сен келдің. Мен үшін келдің.
Dialogue: 0,1:34:36.29,1:34:39.19,Default,,0,0,0,,Осы әнді айтқым келеді
Dialogue: 0,1:34:39.36,1:34:44.62,Default,,0,0,0,,Ха, бұл не! Ол тапқан әнді мен неге айтуым керек?
Dialogue: 0,1:34:50.82,1:34:53.62,Default,,0,0,0,,Горг Ганц зеңбірегі Гарма Зукара Индензенбан
Dialogue: 0,1:34:53.72,1:34:56.95,Default,,0,0,0,,Тұрақтылық тізбегінің зақымдалуы. Бір рет қана жұмыстан шығаруға болады.
Dialogue: 0,1:34:57.29,1:35:00.69,Default,,0,0,0,,Ескерту! Ганц Холтгадра дереу!
Dialogue: 0,1:35:01.15,1:35:05.69,Default,,0,0,0,,Дегенмен, Лапрамиз кемесінің осінде ондаған мың достық флоттар бар.
Dialogue: 0,1:35:06.15,1:35:08.25,Default,,0,0,0,,Маған бәрібір, Гадрас!
Dialogue: 0,1:35:12.69,1:35:13.25,Default,,0,0,0,,Жарайсың!
Dialogue: 0,1:35:31.72,1:35:34.02,Default,,0,0,0,,Мәдениет!
Dialogue: 0,1:35:36.29,1:35:41.52,Default,,0,0,0,,Егер сіз осындай ән айтсаңыз да, жеңіске жетуге үміт жоқ!
Dialogue: 0,1:35:45.69,1:35:51.79,Default,,0,0,0,,...
Dialogue: 0,1:35:51.89,1:35:55.42,Default,,0,0,0,,Мен бәрібір өлетін болсам, сенімен қалғым келеді.
Dialogue: 0,1:35:56.82,1:36:01.46,Default,,0,0,0,,Бұл біз үшін ғана проблема емес, бұл Макросс мінетіндердің барлығына қатысты.
Dialogue: 0,1:36:01.55,1:36:07.55,Default,,0,0,0,,Бұл маңызды емес! Неге бұл дүниеде екеуміз ғана емеспіз?
Dialogue: 0,1:36:09.65,1:36:14.59,Default,,0,0,0,,Сен екеумізден басқаның бәрі өлсе ғой! Ух...
Dialogue: 0,1:36:15.75,1:36:16.25,Default,,0,0,0,,Ах!
Dialogue: 0,1:36:34.95,1:36:39.65,Default,,0,0,0,,Тіпті менің ағаларым да, Какизаки де өлді.
Dialogue: 0,1:36:40.65,1:36:43.19,Default,,0,0,0,,Менің істегім келген нәрселер көп болуы керек...
Dialogue: 0,1:36:43.79,1:36:44.72,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:37:00.02,1:37:02.46,Default,,0,0,0,,Сіз әлі де ән айта аласыз, солай ма?
Dialogue: 0,1:37:03.82,1:37:04.49,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:32.36,1:37:33.15,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:37:38.19,1:37:43.75,Default,,0,0,0,,Ах... Кешіріңіз, Акира.
Dialogue: 0,1:37:46.09,1:37:47.95,Default,,0,0,0,,Маған не болды?
Dialogue: 0,1:37:49.02,1:37:52.36,Default,,0,0,0,,Маған ұнағандықтан осы жолды таңдадым.
Dialogue: 0,1:37:55.92,1:38:00.72,Default,,0,0,0,,Осы жерде ән айтпасам, өлетін едім. Анам мен әкем қарсы емес.
Dialogue: 0,1:38:02.59,1:38:03.65,Default,,0,0,0,,Минмей
Dialogue: 0,1:38:06.09,1:38:10.36,Default,,0,0,0,,Бар күшіммен ән саламын
Dialogue: 0,1:38:36.92,1:38:40.99,Default,,0,0,0,,Мен сіздің дауысыңызды қазір естимін
Dialogue: 0,1:38:41.15,1:38:43.82,Default,,0,0,0,,«Мұнда кел»
Dialogue: 0,1:38:44.32,1:38:50.95,Default,,0,0,0,,Жалғыздыққа бой алдыратын сияқтымын
Dialogue: 0,1:38:54.79,1:38:58.79,Default,,0,0,0,,Мен сені қазір көріп тұрмын
Dialogue: 0,1:38:59.22,1:39:01.75,Default,,0,0,0,,Жаяу жүру
Dialogue: 0,1:39:03.82,1:39:04.65,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:39:05.42,1:39:06.69,Default,,0,0,0,,Минмейдің әні
Dialogue: 0,1:39:12.79,1:39:14.82,Default,,0,0,0,,Бұл ән біртүрлі екен
Dialogue: 0,1:39:16.59,1:39:19.39,Default,,0,0,0,,Мен мұны бұрыннан естігендей болдым
Dialogue: 0,1:39:20.12,1:39:21.29,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:39:21.52,1:39:29.15,Default,,0,0,0,,Жүрек қазір
Dialogue: 0,1:39:29.75,1:39:36.05,Default,,0,0,0,,Есіңде ме, көзіміз тоғысты...
Dialogue: 0,1:39:36.09,1:39:37.75,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,1:39:38.09,1:39:43.69,Default,,0,0,0,,Біздің гендік донорларымыздың бұйра әуендері оянуда.
Dialogue: 0,1:39:44.22,1:39:45.29,Default,,0,0,0,,Не?
Dialogue: 0,1:39:45.62,1:39:48.42,Default,,0,0,0,,500 000 циклден артық...
Dialogue: 0,1:39:49.89,1:39:54.95,Default,,0,0,0,,Мәдениетімізді жаңғырта аламыз ба?
Dialogue: 0,1:39:56.22,1:40:00.69,Default,,0,0,0,,Мен сені қатты жақсы көремін
Dialogue: 0,1:40:21.52,1:40:24.52,Default,,0,0,0,,Jinzem Inban Ad Class флотынан Макроссқа дейін
Dialogue: 0,1:40:25.15,1:40:27.39,Default,,0,0,0,,Бұдан былай мен сенің кемеңді қолдаймын.
Dialogue: 0,1:40:27.89,1:40:28.49,Default,,0,0,0,,Қолдау?
Dialogue: 0,1:40:28.62,1:40:29.29,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,1:40:30.69,1:40:34.39,Default,,0,0,0,,Біз протомәдениет мәдениетін жоғалта алмаймыз.
Dialogue: 0,1:40:39.62,1:40:43.52,Default,,0,0,0,,Лин Минмэйдің әнін естігендердің бәріне айтыңыз
Dialogue: 0,1:40:43.62,1:40:45.85,Default,,0,0,0,,Біздің бір ғана жауымыз бар
Dialogue: 0,1:40:45.95,1:40:53.09,Default,,0,0,0,,Гол Бодрутерді жеңіп, мәдениетті қайтадан қалпына келтіріңіз.
Dialogue: 0,1:41:01.85,1:41:05.95,Default,,0,0,0,,Мен сенің көзқарасыңды сеземін
Dialogue: 0,1:41:06.32,1:41:08.62,Default,,0,0,0,,Біз бөлек болсақ та
Dialogue: 0,1:41:11.79,1:41:14.59,Default,,0,0,0,,Бұл Лин Мингмейдің әні ме?
Dialogue: 0,1:41:19.65,1:41:23.75,Default,,0,0,0,,Енді мен сенің махаббатыңа сенемін
Dialogue: 0,1:41:24.09,1:41:26.65,Default,,0,0,0,,Мені алып кетіңізші
Dialogue: 0,1:41:27.25,1:41:33.55,Default,,0,0,0,,Алыстан бақылаңыз
Dialogue: 0,1:41:37.52,1:41:40.39,Default,,0,0,0,,Кешегі күнге дейін
Dialogue: 0,1:41:40.92,1:41:44.52,Default,,0,0,0,,Көз жасымен бұлтты болды
Dialogue: 0,1:41:46.25,1:41:52.72,Default,,0,0,0,,Әлем қазір...
Dialogue: 0,1:41:54.82,1:42:02.65,Default,,0,0,0,,Есіңде ме, біздің көзіміз түйіскен кезде?
Dialogue: 0,1:42:03.65,1:42:11.65,Default,,0,0,0,,Біздің қолымыз бір-бірімізге тигені есіңде ме?
Dialogue: 0,1:42:12.46,1:42:20.55,Default,,0,0,0,,Бұл махаббаттың алғашқы кетуі еді.
Dialogue: 0,1:42:20.89,1:42:25.29,Default,,0,0,0,,Мен сені қатты жақсы көремін
Dialogue: 0,1:42:25.99,1:42:33.95,Default,,0,0,0,,Мен енді жалғыз емеспін
Dialogue: 0,1:42:34.89,1:42:41.95,Default,,0,0,0,,Себебі сіз осындасыз...
Dialogue: 0,1:42:43.82,1:42:51.82,Default,,0,0,0,,Есіңде ме, біздің көзіміз түйіскен кезде?
Dialogue: 0,1:42:52.62,1:43:00.79,Default,,0,0,0,,Есіңде ме, қашан қолымыз бір-бірімізге тиді?
Dialogue: 0,1:43:01.39,1:43:09.65,Default,,0,0,0,,Бұл махаббаттың алғашқы кетуі еді.
Dialogue: 0,1:43:09.92,1:43:14.25,Default,,0,0,0,,Мен сені қатты жақсы көремін
Dialogue: 0,1:43:21.65,1:43:29.42,Default,,0,0,0,,Мен енді жалғыз емеспін
Dialogue: 0,1:43:30.42,1:43:34.22,Default,,0,0,0,,Себебі сіз осындасыз...
Dialogue: 0,1:43:39.65,1:43:47.32,Default,,0,0,0,,Мен енді жалғыз емеспін
Dialogue: 0,1:43:48.46,1:43:54.55,Default,,0,0,0,,Себебі сіз осындасыз...
Dialogue: 0,1:43:54.62,1:43:59.15,Default,,0,0,0,,О! Протокультура!
Dialogue: 0,1:44:09.55,1:44:13.42,Default,,0,0,0,,Уау!
Dialogue: 0,1:45:47.99,1:45:49.79,Default,,0,0,0,,1-бас сүйектен 1-дельтаға дейін
Dialogue: 0,1:45:51.19,1:45:52.05,Default,,0,0,0,,О
Dialogue: 0,1:45:52.95,1:45:55.72,Default,,0,0,0,,Миссия аяқталды, мен енді кемеге ораламын.
Dialogue: 0,1:45:56.82,1:45:57.89,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:59.82,1:46:01.89,Default,,0,0,0,,Бұл Delta 1. Түсінікті.
Dialogue: 0,1:46:05.22,1:46:06.72,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,1:46:08.69,1:46:15.99,Default,,0,0,0,,Уау! Апыр-ай! Апыр-ай!
Dialogue: 0,1:46:16.12,1:46:22.79,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:47:36.29,1:47:38.36,Default,,0,0,0,,Бұдан былай жағдай қиындай түседі.
Dialogue: 0,1:47:38.52,1:47:39.25,Default,,0,0,0,,Иә?
Dialogue: 0,1:47:39.59,1:47:44.55,Default,,0,0,0,,Тіпті осы галактиканың өзінде Бодолзор және Лапрамиз кластарының жылжымалы бекіністері бар.
Dialogue: 0,1:47:44.75,1:47:47.72,Default,,0,0,0,,1000-нан астам флот жұмыс істеуі керек.
Dialogue: 0,1:47:48.22,1:47:49.62,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,1:47:50.52,1:47:54.75,Default,,0,0,0,,Бірақ бір әннің өзі мұны істей алады.
Dialogue: 0,1:47:55.85,1:47:58.85,Default,,0,0,0,,Мәдениеттің құдіретіне сенуден басқа амалымыз жоқ.
Dialogue: 0,1:49:08.02,1:49:09.09,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:49:10.59,1:49:11.95,Default,,0,0,0,,Хмм
Dialogue: 0,1:49:17.85,1:49:18.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:49:19.22,1:49:20.05,Default,,0,0,0,,О
Dialogue: 0,1:49:32.52,1:49:35.99,Default,,0,0,0,,Бұл ән не туралы болды?
Dialogue: 0,1:49:38.82,1:49:40.46,Default,,0,0,0,,Бұл жай ғана танымал ән
Dialogue: 0,1:49:40.55,1:49:41.65,Default,,0,0,0,,Танымал ән?
Dialogue: 0,1:49:46.69,1:49:50.79,Default,,0,0,0,,Ол он мыңдаған жылдар бұрын бөтен қалада танымал болған...
Dialogue: 0,1:49:53.65,1:49:58.02,Default,,0,0,0,,Кәдімгі махаббат жыры...
Dialogue: 0,1:50:10.05,1:50:16.25,Default,,0,0,0,,Бір екі үш төрт бір екі үш төрт...
Dialogue: 0,1:50:16.39,1:50:20.55,Default,,0,0,0,,Бір екі үш төрт бір екі үш төрт...
Dialogue: 0,1:50:29.09,1:50:37.22,Default,,0,0,0,,Бір екі үш төрт бір екі үш төрт...
Dialogue: 0,1:50:37.59,1:50:45.69,Default,,0,0,0,,Бір екі үш төрт бір екі үш төрт...
Dialogue: 0,1:50:45.95,1:50:54.09,Default,,0,0,0,,Бір екі үш төрт бір екі үш төрт...
Dialogue: 0,1:50:54.32,1:51:02.52,Default,,0,0,0,,Бір екі үш төрт бір екі үш төрт...
Dialogue: 0,1:51:02.62,1:51:06.85,Default,,0,0,0,,Бір екі үш төрт бір екі үш төрт...
Dialogue: 0,1:51:10.85,1:51:12.02,Default,,0,0,0,,Әй, бір екі!
Dialogue: 0,1:51:42.22,1:51:53.52,Default,,0,0,0,,Ымыртқа ой жүгіртіп, Терезеге ұшамын
Dialogue: 0,1:51:57.09,1:52:04.15,Default,,0,0,0,,Жарқыраған самалмен дем ал
Dialogue: 0,1:52:04.29,1:52:09.69,Default,,0,0,0,,Аспанға қараған кезде
Dialogue: 0,1:52:09.92,1:52:24.49,Default,,0,0,0,,Қайғылы оқиғалардан менің жүрегім де көк түске боялған.
Dialogue: 0,1:52:24.79,1:52:33.55,Default,,0,0,0,,Мен оны періште бояуымен қайта бояймын
Dialogue: 0,1:52:33.92,1:52:39.89,Default,,0,0,0,,Өз қалауыңыз бойынша
Dialogue: 0,1:52:55.89,1:53:07.39,Default,,0,0,0,,Екеуміз кездескен кезде мен тіпті ғарышқа тамсандым.
Dialogue: 0,1:53:10.55,1:53:17.82,Default,,0,0,0,,Мені әрқашан қорғады
Dialogue: 0,1:53:17.99,1:53:23.15,Default,,0,0,0,,Махаббаттан бейхабар
Dialogue: 0,1:53:23.49,1:53:37.75,Default,,0,0,0,,Мен сенімен сәл ғана қоштассам
Dialogue: 0,1:53:38.25,1:53:40.39,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:53:41.92,1:53:52.85,Default,,0,0,0,,Бұл сезім көз жасына айнала ма?
Dialogue: 0,1:53:54.82,1:54:07.42,Default,,0,0,0,,Алысқа қарасаң, бәрі кетеді
Dialogue: 0,1:54:07.69,1:54:22.09,Default,,0,0,0,,Бір күні мәңгілік нұр мені азғырар
Dialogue: 0,1:54:22.42,1:54:36.99,Default,,0,0,0,,Қайғылы оқиғалардан менің жүрегім де көкке боялған.
Dialogue: 0,1:54:37.12,1:54:46.25,Default,,0,0,0,,Мен оны періште бояуымен қайта бояймын
Dialogue: 0,1:54:46.46,1:54:52.99,Default,,0,0,0,,Өз қалауыңыз бойынша
