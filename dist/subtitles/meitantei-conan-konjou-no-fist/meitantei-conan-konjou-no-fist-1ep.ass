Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:31.23,0:00:32.65,Default,,0,0,0,,(ағылшынша әңгіме)
Dialogue: 0,0:00:34.28,0:00:35.16,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:00:55.93,0:00:56.89,Default,,0,0,0,,(шу)
Dialogue: 0,0:00:57.64,0:00:59.22,Default,,0,0,0,,(ағылшын тілінде Леон)
Dialogue: 0,0:01:01.93,0:01:05.60,Default,,0,0,0,,(Sherilyn English)
Dialogue: 0,0:01:07.19,0:01:08.61,Default,,0,0,0,,Егер оны біреу көрсе—
Dialogue: 0,0:01:08.69,0:01:10.77,Default,,0,0,0,,Сіз оғаш нәрселер жасай алмайсыз, солай ма?
Dialogue: 0,0:01:10.86,0:01:12.53,Default,,0,0,0,,Бұл өте көп сандырақ.
Dialogue: 0,0:01:12.61,0:01:15.20,Default,,0,0,0,,Мен сені көздеген сияқтымын.
Dialogue: 0,0:01:15.28,0:01:16.11,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:01:16.91,0:01:19.95,Default,,0,0,0,,Сіз екеуміз дос ретінде жақсы қарым-қатынаста екенбіз деп естідім...
Dialogue: 0,0:01:20.03,0:01:22.74,Default,,0,0,0,,Қажетсіз әңгіме жоқ
Dialogue: 0,0:01:22.83,0:01:25.71,Default,,0,0,0,,Менің ұсынысыма сіздің жауабыңызды тыңдауға рұқсат етіңіз.
Dialogue: 0,0:01:25.79,0:01:28.50,Default,,0,0,0,,Иә немесе жоқ?
Dialogue: 0,0:01:30.13,0:01:30.96,Default,,0,0,0,,Хун
Dialogue: 0,0:01:33.38,0:01:38.30,Default,,0,0,0,,Жауап бермес бұрын, не тапсырыс бергеніңізді болжап көрейін.
Dialogue: 0,0:01:38.84,0:01:39.68,Default,,0,0,0,,Мұзды шай
Dialogue: 0,0:01:39.76,0:01:42.43,Default,,0,0,0,,...Бұл шампан емес
Dialogue: 0,0:01:42.51,0:01:45.81,Default,,0,0,0,,Жоқ, бұл шарап. Ол қызыл емес, ақ.
Dialogue: 0,0:01:45.89,0:01:46.85,Default,,0,0,0,,Салқындатылған Мерсо
Dialogue: 0,0:01:46.94,0:01:48.94,Default,,0,0,0,,(ұлдарға арналған ағылшын тілі)
Dialogue: 0,0:01:49.48,0:01:52.11,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:01:52.69,0:01:54.69,Default,,0,0,0,,Мен сіздің ойыңызды оқыдым
Dialogue: 0,0:01:55.36,0:01:56.61,Default,,0,0,0,,Маған керек емес
Dialogue: 0,0:01:59.53,0:02:00.49,Default,,0,0,0,,О, күте тұрыңыз.
Dialogue: 0,0:02:02.12,0:02:02.99,Default,,0,0,0,,Не?
Dialogue: 0,0:02:03.66,0:02:05.45,Default,,0,0,0,,Жауабы жоқ.
Dialogue: 0,0:02:11.42,0:02:12.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:15.34,0:02:16.80,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:02:53.21,0:02:54.79,Default,,0,0,0,,(Ерлер ағылшын)
Dialogue: 0,0:02:56.25,0:03:01.09,Default,,0,0,0,,(Әйелдің айғайы)
Dialogue: 0,0:03:01.76,0:03:03.97,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:03:12.65,0:03:14.19,Default,,0,0,0,,(ағылшынша күзетші)
Dialogue: 0,0:03:15.19,0:03:18.74,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:03:21.53,0:03:24.74,Default,,0,0,0,,(ағылшынша күзетші)
Dialogue: 0,0:03:30.21,0:03:32.96,Default,,0,0,0,,(ағылшынша күзетші)
Dialogue: 0,0:03:33.96,0:03:39.51,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:03:54.85,0:03:59.48,Default,,0,0,0,,(ағылшынша әңгіме)
Dialogue: 0,0:04:01.36,0:04:03.28,Default,,0,0,0,,(Aidan English)
Dialogue: 0,0:04:03.36,0:04:06.91,Default,,0,0,0,,(ағылшынша Риши сөзі)
Dialogue: 0,0:04:06.99,0:04:13.29,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:04:14.83,0:04:18.17,Default,,0,0,0,,(Aidan English)
Dialogue: 0,0:04:18.25,0:04:19.92,Default,,0,0,0,,(ағылшынша Риши сөзі)
Dialogue: 0,0:04:21.01,0:04:26.84,Default,,0,0,0,,(ағылшынша әңгіме)
Dialogue: 0,0:04:39.44,0:04:41.48,Default,,0,0,0,,-Жапон тілінде сөйлесейік -Иә
Dialogue: 0,0:04:42.44,0:04:43.99,Default,,0,0,0,,Енді азаматтық запастағы полиция қызметкері ретінде —
Dialogue: 0,0:04:44.07,0:04:45.78,Default,,0,0,0,,Сіз жұмыс істеп жатырсыз ба?
Dialogue: 0,0:04:45.86,0:04:47.16,Default,,0,0,0,,Сіз жоғарылатылған жоқсыз ба?
Dialogue: 0,0:04:47.24,0:04:48.41,Default,,0,0,0,,Нұсқаушы ретінде
Dialogue: 0,0:04:48.49,0:04:51.20,Default,,0,0,0,,Мені қылмыстық мінез-құлық психологиясымен таныстырғаныңыз үшін рахмет.
Dialogue: 0,0:04:51.29,0:04:52.75,Default,,0,0,0,,Профессор Леонға рахмет
Dialogue: 0,0:04:52.83,0:04:55.16,Default,,0,0,0,,Мұғалім болғаным үшін кешіріңіз.
Dialogue: 0,0:04:55.25,0:04:57.00,Default,,0,0,0,,Мен қазір азаматтықпын.
Dialogue: 0,0:04:57.08,0:05:00.75,Default,,0,0,0,,Солай бола тұра, кінәлі тіпті бомба дайындап қойған.
Dialogue: 0,0:05:00.84,0:05:05.22,Default,,0,0,0,,Жарылған көлік жәбірленуші Шерилин Танға тиесілі.
Dialogue: 0,0:05:05.30,0:05:07.80,Default,,0,0,0,,Өйткені ол тамаша заңгер болды
Dialogue: 0,0:05:07.89,0:05:09.80,Default,,0,0,0,,Мені жек көрген кездер болған шығар.
Dialogue: 0,0:05:09.89,0:05:11.68,Default,,0,0,0,,Қауіпті адамдармен араласу...
Dialogue: 0,0:05:11.76,0:05:13.31,Default,,0,0,0,,(Ағылшын тілі радиосы)
Dialogue: 0,0:05:14.31,0:05:16.60,Default,,0,0,0,,(Aidan English)
Dialogue: 0,0:05:17.73,0:05:19.86,Default,,0,0,0,,(полиция қызметкері үшін ағылшын тілі)
Dialogue: 0,0:05:31.03,0:05:32.41,Default,,0,0,0,,Ах
Dialogue: 0,0:05:56.89,0:05:57.77,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:59.10,0:06:00.81,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз!
Dialogue: 0,0:06:00.90,0:06:03.23,Default,,0,0,0,,- (Хайбара) Егер ол істемесе, онда ол жұмыс істемейді! -сұра!
Dialogue: 0,0:06:03.32,0:06:04.69,Default,,0,0,0,,Екеуіңе не болды?
Dialogue: 0,0:06:04.78,0:06:08.91,Default,,0,0,0,,Дәрі-дәрмекті қайтадан қолданып, бастапқы күйіне оралғысы келеді.
Dialogue: 0,0:06:08.99,0:06:12.74,Default,,0,0,0,,Мектептегі саяхат кезінде де менде қорқынышты оқиға болды.
Dialogue: 0,0:06:12.83,0:06:15.58,Default,,0,0,0,,Әйтеуір сол уақыттан да өттім.
Dialogue: 0,0:06:15.66,0:06:17.79,Default,,0,0,0,,Сондықтан бәрі жақсы. Маған дәрі беріңізші!
Dialogue: 0,0:06:17.87,0:06:20.00,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:06:20.79,0:06:22.46,Default,,0,0,0,,Сіз қайда баруды жоспарлап отырсыз?
Dialogue: 0,0:06:23.04,0:06:24.13,Default,,0,0,0,,Сингапур
Dialogue: 0,0:06:24.21,0:06:25.46,Default,,0,0,0,,Дәрігер, міне, солай
Dialogue: 0,0:06:25.55,0:06:29.13,Default,,0,0,0,,Бұл адам осы турнирге қатысады. Ол 400 жекпе-жектен жеңілмеген...
Dialogue: 0,0:06:29.22,0:06:32.89,Default,,0,0,0,,О, Макото Кёгоку?
Dialogue: 0,0:06:32.97,0:06:36.35,Default,,0,0,0,,Соноко ойынды көретінін айтты.
Dialogue: 0,0:06:36.43,0:06:38.81,Default,,0,0,0,,Өзіңізбен бірге Когораның ағасы мен Ранды әкеліңіз.
Dialogue: 0,0:06:38.89,0:06:42.90,Default,,0,0,0,,Мені де шақырды, бірақ мен бұл күйде елден шыға алмаймын.
Dialogue: 0,0:06:42.98,0:06:46.40,Default,,0,0,0,,Дұрыс, төлқұжат Шиничидікі.
Dialogue: 0,0:06:46.48,0:06:48.78,Default,,0,0,0,,Өтінемін, Хайбара.
Dialogue: 0,0:06:48.86,0:06:49.70,Default,,0,0,0,,Ұсталу аяқталды.
Dialogue: 0,0:06:49.78,0:06:50.99,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:06:51.07,0:06:53.66,Default,,0,0,0,,Бұл жолы бас тартқан дұрыс
Dialogue: 0,0:06:53.74,0:06:56.87,Default,,0,0,0,,Ха~ Мен барғым келді~
Dialogue: 0,0:06:56.95,0:06:59.04,Default,,0,0,0,,Иә, көңілім түспесе де.
Dialogue: 0,0:06:59.12,0:07:01.92,Default,,0,0,0,,Ио, міне, алаңдататын нәрсе!
Dialogue: 0,0:07:02.00,0:07:03.46,Default,,0,0,0,,Не, біттің бе?
Dialogue: 0,0:07:03.54,0:07:06.84,Default,,0,0,0,,Азиялық викторина!
Dialogue: 0,0:07:06.92,0:07:11.22,Default,,0,0,0,,Сингапурдағы ең танымал оқиғалар қандай?
Dialogue: 0,0:07:11.30,0:07:12.89,Default,,0,0,0,,1 Мемлекеттік әнұран
Dialogue: 0,0:07:12.97,0:07:15.72,Default,,0,0,0,,2 Айдың жаңа жылын тойлау
Dialogue: 0,0:07:15.81,0:07:18.06,Default,,0,0,0,,3 Мемлекеттік туды көтеру
Dialogue: 0,0:07:18.14,0:07:21.14,Default,,0,0,0,,4 Марина шығанағы отшашу фестивалі
Dialogue: 0,0:07:21.69,0:07:23.65,Default,,0,0,0,,Бұл қандай көрініс?
Dialogue: 0,0:07:23.73,0:07:24.77,Default,,0,0,0,,Жауабы қарапайым
Dialogue: 0,0:07:24.86,0:07:27.07,Default,,0,0,0,,3 саны мемлекеттік ту көтерілсін.
Dialogue: 0,0:07:27.15,0:07:29.19,Default,,0,0,0,,Өйткені, «өзегі – тірек»
Dialogue: 0,0:07:29.28,0:07:32.57,Default,,0,0,0,,Ой, дұрыс түсіндің, күткендей.
Dialogue: 0,0:07:32.66,0:07:34.49,Default,,0,0,0,,Жарайды, тағы бір сұрақ.
Dialogue: 0,0:07:34.57,0:07:37.08,Default,,0,0,0,,-Болды - (Ағаса) Иә... Дадада...
Dialogue: 0,0:07:37.66,0:07:41.08,Default,,0,0,0,,Өйткені, балаларымсыз өзімді жалғыз сезінемін.
Dialogue: 0,0:07:44.25,0:07:46.46,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:07:49.92,0:07:51.84,Default,,0,0,0,,Тексеріңіз, Хайбарлық жігіт...
Dialogue: 0,0:08:17.41,0:08:23.79,Default,,0,0,0,,А, Ран-ничан, мұнда не болды?
Dialogue: 0,0:08:25.42,0:08:27.96,Default,,0,0,0,,Жүгіріп... Әпке...
Dialogue: 0,0:08:28.04,0:08:31.46,Default,,0,0,0,,Мен көптен бері күттім
Dialogue: 0,0:08:31.55,0:08:33.34,Default,,0,0,0,,Хи хи
Dialogue: 0,0:08:37.43,0:08:40.97,Default,,0,0,0,,Иә? Мұнда не бар...
Dialogue: 0,0:08:41.06,0:08:42.06,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:08:42.06,0:08:42.85,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:08:42.06,0:08:42.85,Default,,0,0,0,,Орхидеяның дауысы? Бұл қайда?
Dialogue: 0,0:08:42.85,0:08:42.93,Default,,0,0,0,,Орхидеяның дауысы? Бұл қайда?
Dialogue: 0,0:08:42.93,0:08:44.64,Default,,0,0,0,,Орхидеяның дауысы? Бұл қайда?
Dialogue: 0,0:08:42.93,0:08:44.64,Default,,0,0,0,,Бұл су бірнеше күн бұрын ашық қызыл түсті.
Dialogue: 0,0:08:44.64,0:08:44.73,Default,,0,0,0,,Бұл су бірнеше күн бұрын ашық қызыл түсті.
Dialogue: 0,0:08:44.73,0:08:45.98,Default,,0,0,0,,Бұл су бірнеше күн бұрын ашық қызыл түсті.
Dialogue: 0,0:08:44.73,0:08:45.98,Default,,0,0,0,,Сіз бірдеңеге қамалып қалдыңыз ба? Қарғыс атсын
Dialogue: 0,0:08:45.98,0:08:47.81,Default,,0,0,0,,Сіз бірдеңеге қамалып қалдыңыз ба? Қарғыс атсын
Dialogue: 0,0:08:49.52,0:08:50.86,Default,,0,0,0,,Жарайды, енді...
Dialogue: 0,0:08:52.36,0:08:56.20,Default,,0,0,0,,(сыдырманың ашылған дыбысы)
Dialogue: 0,0:08:56.28,0:08:57.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:01.74,0:09:02.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:07.33,0:09:11.55,Default,,0,0,0,,Мерлион?
Dialogue: 0,0:09:17.76,0:09:18.68,Default,,0,0,0,,На
Dialogue: 0,0:09:19.72,0:09:23.39,Default,,0,0,0,,Сингапур!
Dialogue: 0,0:09:23.47,0:09:28.48,Default,,0,0,0,,♪～
Dialogue: 0,0:09:43.95,0:09:46.37,Default,,0,0,0,,Мен орта мектептің детективімін, Шиничи Кудо
Dialogue: 0,0:09:46.46,0:09:48.50,Default,,0,0,0,,Бала күнгі досы және сыныптасы Ран Моримен
Dialogue: 0,0:09:48.58,0:09:50.29,Default,,0,0,0,,Ойын-сауық саябағына барыңыз
Dialogue: 0,0:09:50.38,0:09:54.67,Default,,0,0,0,,Мен қара киінген адамның қатысуымен жасалған күдікті мәміленің куәсі болдым.
Dialogue: 0,0:09:56.01,0:09:58.18,Default,,0,0,0,,Мен транзакцияларды қарауға құмар болдым.
Dialogue: 0,0:09:58.26,0:10:01.93,Default,,0,0,0,,Артынан келе жатқан басқа серігін байқамадым.
Dialogue: 0,0:10:04.47,0:10:07.35,Default,,0,0,0,,Ол кісі маған у ішті.
Dialogue: 0,0:10:07.44,0:10:08.52,Default,,0,0,0,,Мен оянғанда...
Dialogue: 0,0:10:12.32,0:10:14.73,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:10:16.40,0:10:18.90,Default,,0,0,0,,Егер олар Шиничи Кудоның тірі екенін білсе ше?
Dialogue: 0,0:10:18.99,0:10:20.16,Default,,0,0,0,,Менің өміріме жасалған тағы бір әрекет
Dialogue: 0,0:10:20.24,0:10:22.45,Default,,0,0,0,,Айналаңыздағы адамдарға да қауіп төніп тұр.
Dialogue: 0,0:10:23.24,0:10:24.33,Default,,0,0,0,,Доктор Агасаның кеңесі бойынша
Dialogue: 0,0:10:24.41,0:10:26.37,Default,,0,0,0,,Мен өзімнің шынайы тұлғамды жасыруды шештім.
Dialogue: 0,0:10:26.45,0:10:29.08,Default,,0,0,0,,Ран менің атымды сұрағанда, мен бірден айттым
Dialogue: 0,0:10:29.17,0:10:31.21,Default,,0,0,0,,өзін «Конан Эдогава» деп атады
Dialogue: 0,0:10:31.29,0:10:33.09,Default,,0,0,0,,Олар туралы мәлімет алу
Dialogue: 0,0:10:33.17,0:10:36.46,Default,,0,0,0,,Ранның үйіне көшіп келді, оның әкесі детектив болып жұмыс істейді.
Dialogue: 0,0:10:38.72,0:10:41.68,Default,,0,0,0,,Менің қарсыластарымның бірі осы адам.
Dialogue: 0,0:10:41.76,0:10:43.14,Default,,0,0,0,,Кайто Кид
Dialogue: 0,0:10:43.47,0:10:46.72,Default,,0,0,0,,Бетперделеудің де шебері белгісіз елес ұры.
Dialogue: 0,0:10:46.81,0:10:48.06,Default,,0,0,0,,Неге екені белгісіз, менің шынайы болмысымды білесің.
Dialogue: 0,0:10:48.14,0:10:50.10,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:10:50.19,0:10:52.77,Default,,0,0,0,,Бір күні мен сені өз қолыммен ұстаймын.
Dialogue: 0,0:10:52.86,0:10:55.52,Default,,0,0,0,,Баланың қарсыласы Макото Кёгоку
Dialogue: 0,0:10:55.61,0:10:56.90,Default,,0,0,0,,Жоғары сынып оқушысы кезінде
Dialogue: 0,0:10:56.98,0:10:59.65,Default,,0,0,0,,400 жеңіліссіз жекпе-жек өткізген каратэ шебері.
Dialogue: 0,0:10:59.74,0:11:01.53,Default,,0,0,0,,Неге екені белгісіз, ол Ранның сыныптасы.
Dialogue: 0,0:11:01.61,0:11:03.37,Default,,0,0,0,,Ол Сузуки зайбацудың қызы.
Dialogue: 0,0:11:03.45,0:11:04.99,Default,,0,0,0,,Соноко Сузуки оны жақсы көретін сияқты.
Dialogue: 0,0:11:05.08,0:11:08.70,Default,,0,0,0,,Сіз не қарап тұрсыз? Асығыңыз және әрқашан жасайтын нәрсені жасаңыз!
Dialogue: 0,0:11:09.91,0:11:11.79,Default,,0,0,0,,Кішірейсең де, миың сол күйінде қалады
Dialogue: 0,0:11:12.54,0:11:13.92,Default,,0,0,0,,Лабиринті жоқ детектив
Dialogue: 0,0:11:15.42,0:11:19.88,Default,,0,0,0,,Әрқашан бір шындық бар! ～♪
Dialogue: 0,0:11:25.18,0:11:27.18,Default,,0,0,0,,Не, менің қолым?
Dialogue: 0,0:11:27.72,0:11:29.85,Default,,0,0,0,,Дәрігердің құралдары жоқ
Dialogue: 0,0:11:29.93,0:11:32.69,Default,,0,0,0,,Иә, Ран сонда болды!
Dialogue: 0,0:11:33.52,0:11:35.90,Default,,0,0,0,,Күте тұрыңыз, Ран-ничан
Dialogue: 0,0:11:37.73,0:11:40.78,Default,,0,0,0,,- (Жүгіріп) А, Шиничи! Міне, міне! -сурет?
Dialogue: 0,0:11:40.86,0:11:43.78,Default,,0,0,0,,Жаман, жаман, мен сені күттім.
Dialogue: 0,0:11:43.86,0:11:46.70,Default,,0,0,0,,Сіз қайда болдыңыз? Мен сені іздедім.
Dialogue: 0,0:11:46.78,0:11:48.12,Default,,0,0,0,,Өйткені сіз ыстық деп айтасыз
Dialogue: 0,0:11:48.20,0:11:50.20,Default,,0,0,0,,Мен қартты ағаштың көлеңкесіне жетелеп бардым.
Dialogue: 0,0:11:50.79,0:11:52.87,Default,,0,0,0,,Эй, рахмет
Dialogue: 0,0:11:52.96,0:11:55.96,Default,,0,0,0,,Әлі баяғы қарт.
Dialogue: 0,0:11:56.04,0:11:58.71,Default,,0,0,0,,Эй Ран, сен маған су сатып ала аласың ба?
Dialogue: 0,0:11:58.80,0:12:00.67,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:12:00.76,0:12:03.22,Default,,0,0,0,,- (Жүгіріп) Ей, бірге барайық - (Шиничи) А?
Dialogue: 0,0:12:03.30,0:12:05.47,Default,,0,0,0,,-(Жүгіріп) Жүр, тез~ -(Шиничи) Ой, ой... ой.
Dialogue: 0,0:12:05.55,0:12:09.01,Default,,0,0,0,,Не? Бұл енді жақсы емес.
Dialogue: 0,0:12:10.06,0:12:11.98,Default,,0,0,0,,Әлгі бейбақ!
Dialogue: 0,0:12:12.06,0:12:13.98,Default,,0,0,0,,...
Dialogue: 0,0:12:14.06,0:12:16.48,Default,,0,0,0,,Уф, мен өмірге қайта оралдым.
Dialogue: 0,0:12:16.56,0:12:19.23,Default,,0,0,0,,Иә? Әке, сенің мойныңда ілулі тұрған не?
Dialogue: 0,0:12:19.32,0:12:23.11,Default,,0,0,0,,Иә? Мен төлқұжатымды осының ішіне салдым.
Dialogue: 0,0:12:23.20,0:12:25.99,Default,,0,0,0,,Оның жоғалып кетпеуін немесе ұрланбағанын тексеріңіз, солай ма?
Dialogue: 0,0:12:26.07,0:12:28.78,Default,,0,0,0,,Әке, енді мұны істеудің қажеті жоқ.
Dialogue: 0,0:12:28.87,0:12:30.16,Default,,0,0,0,,Сингапур қауіпсіз
Dialogue: 0,0:12:30.24,0:12:32.16,Default,,0,0,0,,Эй, сен ояусың ба?
Dialogue: 0,0:12:32.25,0:12:33.62,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:12:33.71,0:12:37.63,Default,,0,0,0,,Хехе... Чемоданнан қалай шықтың?
Dialogue: 0,0:12:37.71,0:12:38.71,Default,,0,0,0,,Міне
Dialogue: 0,0:12:38.79,0:12:44.22,Default,,0,0,0,,Егер сіз бұл заттың ұшын салсаңыз, ол тіпті ішінен де таңқаларлық оңай ашылады.
Dialogue: 0,0:12:44.30,0:12:46.34,Default,,0,0,0,,Мен шарикті қаламдармен проблема болмайды деп ойладым, бірақ...
Dialogue: 0,0:12:46.43,0:12:48.60,Default,,0,0,0,,Сақтыққа жол бермеңіз немесе тәуекелге бармаңыз.
Dialogue: 0,0:12:48.68,0:12:51.43,Default,,0,0,0,,Бұл менің жолым, Кайто Кид!
Dialogue: 0,0:12:51.52,0:12:52.35,Default,,0,0,0,,Иә
Dialogue: 0,0:12:53.43,0:12:55.10,Default,,0,0,0,,О, болды!
Dialogue: 0,0:12:55.69,0:12:58.06,Default,,0,0,0,,Мұнымен нені айтасыз?
Dialogue: 0,0:12:58.15,0:13:01.61,Default,,0,0,0,,Ия, іздегеніңіз осы.
Dialogue: 0,0:13:01.69,0:13:03.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:06.11,0:13:07.91,Default,,0,0,0,,Бұл Соноконың...
Dialogue: 0,0:13:07.99,0:13:10.03,Default,,0,0,0,,19 ғасырдың соңы…
Dialogue: 0,0:13:10.12,0:13:14.75,Default,,0,0,0,,Сингапур маңындағы теңізде қарақшылар кемесімен бірге батып кеткен дейді.
Dialogue: 0,0:13:14.83,0:13:16.71,Default,,0,0,0,,Аңызға айналған қазына
Dialogue: 0,0:13:17.37,0:13:20.96,Default,,0,0,0,,Дүние жүзіндегі ең үлкен көк сапфир...
Dialogue: 0,0:13:22.00,0:13:23.92,Default,,0,0,0,,«Көк жұдырық»
Dialogue: 0,0:13:25.63,0:13:27.09,Default,,0,0,0,,Өткен жылы Чонхан Чен мырза
Dialogue: 0,0:13:27.18,0:13:28.43,Default,,0,0,0,,Сәтті көтерілді—
Dialogue: 0,0:13:28.51,0:13:30.14,Default,,0,0,0,,Бұл үлкен асыл тас.
Dialogue: 0,0:13:30.22,0:13:31.85,Default,,0,0,0,,Чонхан Чен туралы айту
Dialogue: 0,0:13:31.93,0:13:34.14,Default,,0,0,0,,Ол Сингапурдағы күшті адамдардың бірі.
Dialogue: 0,0:13:34.23,0:13:35.89,Default,,0,0,0,,Иә, бұл қарт
Dialogue: 0,0:13:35.98,0:13:37.31,Default,,0,0,0,,Мен жекпе-жек өнерін жақсы көремін.
Dialogue: 0,0:13:37.94,0:13:39.90,Default,,0,0,0,,Чемпиондық белбеуіне зергерлік бұйымдарды салу —
Dialogue: 0,0:13:39.98,0:13:43.36,Default,,0,0,0,,Біз каратэден турнир өткізуді шештік.
Dialogue: 0,0:13:43.44,0:13:46.57,Default,,0,0,0,,Аты аңызға айналған асыл тас жеңімпаздың қолында болады...
Dialogue: 0,0:13:47.15,0:13:48.78,Default,,0,0,0,,Байдың азғындығы.
Dialogue: 0,0:13:48.86,0:13:49.95,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:13:50.03,0:13:53.29,Default,,0,0,0,,Турнир бейберекет болып жатқанда, мен сендерге асыл тастарды беремін.
Dialogue: 0,0:13:53.37,0:13:54.87,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:13:54.95,0:13:58.12,Default,,0,0,0,,Бала кезінде елге кіре алмайды.
Dialogue: 0,0:13:58.21,0:14:00.33,Default,,0,0,0,,Егер сіз асыл тастарды мақсат еткіңіз келсе —
Dialogue: 0,0:14:00.42,0:14:02.92,Default,,0,0,0,,Мені өзіңізбен бірге алып келудің қажеті жоқ.
Dialogue: 0,0:14:04.05,0:14:06.42,Default,,0,0,0,,Бұл жолы сәл ерекше.
Dialogue: 0,0:14:06.51,0:14:09.18,Default,,0,0,0,,Ал, мен сізге жағдайды айтайын.
Dialogue: 0,0:14:09.26,0:14:12.26,Default,,0,0,0,,-Темее... -(Шиничи) А? Хехе!
Dialogue: 0,0:14:12.35,0:14:13.93,Default,,0,0,0,,Бұл Шиничи ме?
Dialogue: 0,0:14:14.01,0:14:16.52,Default,,0,0,0,,- (Шиничи) Ой, мен сені шақырып жатырмын - Тоқта, балақай!
Dialogue: 0,0:14:17.60,0:14:20.23,Default,,0,0,0,,Мен Ранға бірдеңе жасасам, бұл жай ғана жеткіліксіз болады.
Dialogue: 0,0:14:20.31,0:14:24.57,Default,,0,0,0,,Е, хехе, кешіріңіз, бірақ мен бұған кепілдік бере алмаймын.
Dialogue: 0,0:14:24.65,0:14:27.53,Default,,0,0,0,,Олай болса, мен сіздің шынайы болмысыңызды дәл осы жерде және қазір ашамын.
Dialogue: 0,0:14:27.61,0:14:29.70,Default,,0,0,0,,Олай етпеген дұрыс.
Dialogue: 0,0:14:30.70,0:14:35.12,Default,,0,0,0,,Осы чемоданның арқасында елге кіре алдыңыз.
Dialogue: 0,0:14:36.70,0:14:40.12,Default,,0,0,0,,Багажды тексеру кезінде рентген сәулелерінен өтпейтін арнайы сипаттама
Dialogue: 0,0:14:40.21,0:14:44.09,Default,,0,0,0,,Ал ішінде 12 сағат жұмыс істейтін оттегі генераторы бар.
Dialogue: 0,0:14:44.17,0:14:46.80,Default,,0,0,0,,Ішінде ұзақ тұрсам да денем ауырмайды.
Dialogue: 0,0:14:46.88,0:14:50.09,Default,,0,0,0,,Ең жақсы жастықпен толтырылған тамаша өнім
Dialogue: 0,0:14:50.93,0:14:54.39,Default,,0,0,0,,Бұл нені білдіретінін түсінесіз бе? Детектив
Dialogue: 0,0:14:55.01,0:14:56.35,Default,,0,0,0,,Менің көмегімсіз
Dialogue: 0,0:14:56.43,0:14:59.44,Default,,0,0,0,,Сіз бұл елден төлқұжатсыз кете алмайсыз.
Dialogue: 0,0:14:59.52,0:15:01.65,Default,,0,0,0,,Бұл сіздің Жапонияға орала алмайтыныңызды білдіреді.
Dialogue: 0,0:15:01.73,0:15:02.65,Default,,0,0,0,,Құт
Dialogue: 0,0:15:02.73,0:15:04.65,Default,,0,0,0,,Шиничи сонда!
Dialogue: 0,0:15:04.73,0:15:07.65,Default,,0,0,0,,Жақында ол бір жерге кетеді.
Dialogue: 0,0:15:08.78,0:15:09.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:10.57,0:15:12.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:12.28,0:15:16.62,Default,,0,0,0,,Бұл әзіл емес! Неге мұндасың?
Dialogue: 0,0:15:16.70,0:15:17.70,Default,,0,0,0,,Конан-кун?
Dialogue: 0,0:15:17.79,0:15:19.37,Default,,0,0,0,,А, мен қашып кеттім.
Dialogue: 0,0:15:19.91,0:15:24.21,Default,,0,0,0,,Қандай таң қалдырды. Мына жігіт мына жерден бала сияқты.
Dialogue: 0,0:15:24.29,0:15:25.63,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:15:25.71,0:15:26.17,Default,,0,0,0,,Дегенмен, олар өте ұқсас.
Dialogue: 0,0:15:26.17,0:15:28.30,Default,,0,0,0,,Дегенмен, олар өте ұқсас.
Dialogue: 0,0:15:26.17,0:15:28.30,Default,,0,0,0,,Балалар, сендер тым оңай алданып қаласыңдар.
Dialogue: 0,0:15:28.30,0:15:28.38,Default,,0,0,0,,Сонда да олар өте ұқсас.
Dialogue: 0,0:15:28.38,0:15:29.26,Default,,0,0,0,,Сонда да олар өте ұқсас.
Dialogue: 0,0:15:28.38,0:15:29.26,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:29.88,0:15:33.51,Default,,0,0,0,,Сіздің атыңыз кім? Жапон тілін түсінесіз бе?
Dialogue: 0,0:15:34.09,0:15:35.76,Default,,0,0,0,,Ал...
Dialogue: 0,0:15:36.93,0:15:37.77,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:15:41.10,0:15:44.90,Default,,0,0,0,,Артур! менің атым Артур Хираи
Dialogue: 0,0:15:45.69,0:15:47.19,Default,,0,0,0,,Артур Хираи?
Dialogue: 0,0:15:47.27,0:15:49.90,Default,,0,0,0,,Менің анам жапон, сондықтан...
Dialogue: 0,0:15:49.99,0:15:51.65,Default,,0,0,0,,Мен Соноко Сузукимін
Dialogue: 0,0:15:51.74,0:15:56.16,Default,,0,0,0,,Мен Моури Ранмын, ал ана жақтағы адам...
Dialogue: 0,0:15:57.28,0:15:59.37,Default,,0,0,0,,Әкесі Когоро Моури
Dialogue: 0,0:15:59.45,0:16:00.96,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:16:01.04,0:16:02.96,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:16:03.04,0:16:06.09,Default,,0,0,0,,жүгірді Кешіріңіз, мен сәлден кейін барамын.
Dialogue: 0,0:16:06.17,0:16:07.00,Default,,0,0,0,,Иә
Dialogue: 0,0:16:08.34,0:16:10.67,Default,,0,0,0,,Бала, әкең мен шешең ше?
Dialogue: 0,0:16:10.76,0:16:14.13,Default,,0,0,0,,Е! Мм... мен Жапонияға барамын.
Dialogue: 0,0:16:14.22,0:16:17.64,Default,,0,0,0,,Ех! Артур, сен үйде жалғызсың ба?
Dialogue: 0,0:16:17.72,0:16:20.22,Default,,0,0,0,,Иә, бірақ бәрібір, мен үйреніп қалдым.
Dialogue: 0,0:16:20.31,0:16:21.14,Default,,0,0,0,,Иә
Dialogue: 0,0:16:21.23,0:16:23.64,Default,,0,0,0,,Олай болса бізбен бірге келесің бе?
Dialogue: 0,0:16:24.35,0:16:26.69,Default,,0,0,0,,-Жарайды ма? -(Шиничи) О, әрине.
Dialogue: 0,0:16:28.65,0:16:31.11,Default,,0,0,0,,Аа, дұрыс, мен де әкеңе барамын.
Dialogue: 0,0:16:31.94,0:16:33.36,Default,,0,0,0,,О
Dialogue: 0,0:16:33.45,0:16:38.20,Default,,0,0,0,,Сонда да кеш. Маған тым болмаса электрондық хат жіберсеңіз екен.
Dialogue: 0,0:16:38.28,0:16:41.37,Default,,0,0,0,,Біз осында кездесуіміз керек.
Dialogue: 0,0:16:42.37,0:16:43.62,Default,,0,0,0,,Сен жолға түстің, жолдан кет.
Dialogue: 0,0:16:43.71,0:16:45.37,Default,,0,0,0,,Додок
Dialogue: 0,0:16:45.46,0:16:46.96,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:16:47.46,0:16:49.13,Default,,0,0,0,,Олар қандай?
Dialogue: 0,0:16:49.21,0:16:52.05,Default,,0,0,0,,Ортадағы адам - ​​Рейдзиро Накатоми.
Dialogue: 0,0:16:52.13,0:16:56.14,Default,,0,0,0,,Накатоми... Ах, Nakatomi Shipping компаниясының президенті.
Dialogue: 0,0:16:56.22,0:16:57.76,Default,,0,0,0,,Баратын атағы бар.
Dialogue: 0,0:16:57.85,0:17:00.14,Default,,0,0,0,,Ол үнемі қара қауесеттің ортасында жүретін адам.
Dialogue: 0,0:17:01.18,0:17:05.06,Default,,0,0,0,,Эй, сен Сингапурға жалғыз келдің бе?
Dialogue: 0,0:17:05.14,0:17:06.31,Default,,0,0,0,,Қаласаңыз, менімен бірге...
Dialogue: 0,0:17:06.40,0:17:08.11,Default,,0,0,0,,Қазір емес.
Dialogue: 0,0:17:08.19,0:17:09.48,Default,,0,0,0,,Онда барыңыз
Dialogue: 0,0:17:10.44,0:17:12.23,Default,,0,0,0,,Бұлай айту дұрыс па?
Dialogue: 0,0:17:12.32,0:17:16.78,Default,,0,0,0,,Қаласаңыз, сізді көлікке жалғыз сүйреп апарғандай оңай.
Dialogue: 0,0:17:17.87,0:17:18.70,Default,,0,0,0,,Соноко!
Dialogue: 0,0:17:19.62,0:17:21.20,Default,,0,0,0,,Шиничи
Dialogue: 0,0:17:21.29,0:17:23.08,Default,,0,0,0,,Қажетсіз істермен айналыспаңыз
Dialogue: 0,0:17:23.16,0:17:24.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:24.62,0:17:25.91,Default,,0,0,0,,Эй
Dialogue: 0,0:17:26.00,0:17:27.54,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:17:30.29,0:17:33.13,Default,,0,0,0,,(Оққағарлар ыңырсып)
Dialogue: 0,0:17:33.21,0:17:34.84,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:17:34.92,0:17:38.80,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:17:38.89,0:17:41.72,Default,,0,0,0,,Ол менің серігім, бірақ не?
Dialogue: 0,0:17:41.81,0:17:43.43,Default,,0,0,0,,Темеха!
Dialogue: 0,0:17:43.52,0:17:45.73,Default,,0,0,0,,Макото-сан, электрондық поштаңызды тексеріңіз!
Dialogue: 0,0:17:45.81,0:17:48.40,Default,,0,0,0,,Кешіріңіз, мен машиналар туралы көп білмеймін.
Dialogue: 0,0:17:48.48,0:17:50.56,Default,,0,0,0,,Уау! Иә
Dialogue: 0,0:17:50.65,0:17:52.07,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:17:52.15,0:17:56.15,Default,,0,0,0,,Қарғыс атсын, есіңізде болсын! Мен келесі жолы мейірімділік танытпаймын
Dialogue: 0,0:17:56.24,0:17:59.36,Default,,0,0,0,,Шин мырза! Соноко қорқынышты болды~
Dialogue: 0,0:17:59.45,0:18:01.66,Default,,0,0,0,,Кешіктіргеніміз үшін кешірім сұраймыз.
Dialogue: 0,0:18:01.74,0:18:03.83,Default,,0,0,0,,Бауырым, сен кереметсің
Dialogue: 0,0:18:03.91,0:18:06.83,Default,,0,0,0,,Мен мұны істей аламын.
Dialogue: 0,0:18:06.91,0:18:08.67,Default,,0,0,0,,(Ерлер ағылшын)
Dialogue: 0,0:18:08.75,0:18:10.46,Default,,0,0,0,,(Ағылшын тілі)
Dialogue: 0,0:18:10.54,0:18:11.67,Default,,0,0,0,,Ах
Dialogue: 0,0:18:20.22,0:18:22.10,Default,,0,0,0,,Соноко, жақсысың ба?
Dialogue: 0,0:18:22.18,0:18:24.85,Default,,0,0,0,,Иә, өйткені Макото-сан мені қорғады.
Dialogue: 0,0:18:24.93,0:18:27.43,Default,,0,0,0,,Кёгоку-сан, біраз уақыт өтті.
Dialogue: 0,0:18:27.52,0:18:28.94,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:18:29.02,0:18:29.85,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:18:29.94,0:18:32.65,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Шиничи Кудомын.
Dialogue: 0,0:18:32.73,0:18:36.44,Default,,0,0,0,,Макото Кёгоку, иә?
Dialogue: 0,0:18:40.74,0:18:42.95,Default,,0,0,0,,Макото-сан, не болды?
Dialogue: 0,0:18:43.03,0:18:46.79,Default,,0,0,0,,Жоқ, мен Кудомен бірінші рет кездесіп тұрғандай емеспін.
Dialogue: 0,0:18:48.08,0:18:49.04,Default,,0,0,0,,Иә
Dialogue: 0,0:18:49.12,0:18:53.17,Default,,0,0,0,,Мен... жоқ, бұл менің қиялым хахаха...
Dialogue: 0,0:18:53.25,0:18:56.42,Default,,0,0,0,,Мерлионды көрдік, енді қонақ үйге барайық.
Dialogue: 0,0:18:56.51,0:18:59.01,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:18:59.09,0:19:01.26,Default,,0,0,0,,ше? Ах...
Dialogue: 0,0:19:02.80,0:19:05.26,Default,,0,0,0,,Турнирге қатыса алмайсыз ба?
Dialogue: 0,0:19:05.35,0:19:08.27,Default,,0,0,0,,Біз Макотоның матчын көруге келдік.
Dialogue: 0,0:19:08.35,0:19:11.52,Default,,0,0,0,,Кешіріңіз, бүгінгі турнир
Dialogue: 0,0:19:11.60,0:19:15.27,Default,,0,0,0,,Мені біреу шақырды, бірақ...
Dialogue: 0,0:19:15.36,0:19:17.11,Default,,0,0,0,,Сонымен демеуші ме?
Dialogue: 0,0:19:17.19,0:19:19.53,Default,,0,0,0,,Иә мен заңгермін.
Dialogue: 0,0:19:19.61,0:19:21.53,Default,,0,0,0,,Шерилин Тан
Dialogue: 0,0:19:21.61,0:19:25.03,Default,,0,0,0,,Мен барлық жол жүру және тұру шығындарын төлеймін, сондықтан мен сізді қатысқыңыз келеді деп ойладым.
Dialogue: 0,0:19:25.12,0:19:28.00,Default,,0,0,0,,Алайда ол адам кенеттен дүниеден өтті.
Dialogue: 0,0:19:29.71,0:19:31.92,Default,,0,0,0,,Бүгін адамға туысқан біреуден
Dialogue: 0,0:19:32.00,0:19:34.75,Default,,0,0,0,,Маған оқиға ешқашан болмағандай етіп көрсетуді өтінді.
Dialogue: 0,0:19:34.84,0:19:35.88,Default,,0,0,0,,(Йотаро Куджо) Өкінішті, бірақ осы сапарда… Какёинге жарыстан шығудан басқа амал қалмауы мүмкін.
Dialogue: 0,0:19:35.96,0:19:41.30,Default,,0,0,0,,Бұл турнирге Сингапурдың ең мықты спортшысы да қатысады деп отыр.
Dialogue: 0,0:19:41.38,0:19:44.30,Default,,0,0,0,,Бірде мен жекпе-жек көргім келген бір қарсыласым болды...
Dialogue: 0,0:19:44.39,0:19:48.52,Default,,0,0,0,,Жарайды, мен сол демеуші боламын!
Dialogue: 0,0:19:48.60,0:19:51.27,Default,,0,0,0,,- (барлығы) Иә! - (Соноко) Оны маған қалдырыңыз!
Dialogue: 0,0:19:51.35,0:19:55.02,Default,,0,0,0,,Сузуки конгломератының жас ханымы күткендей...
Dialogue: 0,0:19:57.32,0:19:59.07,Default,,0,0,0,,Барлығы шешілді!
Dialogue: 0,0:19:59.15,0:20:02.82,Default,,0,0,0,,Макото-сан, мен шақырылған ойыншы ретінде қайта кіре алдым!
Dialogue: 0,0:20:02.91,0:20:04.32,Default,,0,0,0,,Бұл рас па, Соноко-сан?
Dialogue: 0,0:20:04.41,0:20:05.37,Default,,0,0,0,,Иә
Dialogue: 0,0:20:06.66,0:20:09.91,Default,,0,0,0,,Макотоның қонақ үйі бізбен бірге болды.
Dialogue: 0,0:20:10.00,0:20:13.08,Default,,0,0,0,,Бұл қос кездесу, иә?
Dialogue: 0,0:20:13.17,0:20:14.58,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:14.67,0:20:17.59,Default,,0,0,0,,Енді іс бітті, қонақ үйге қайтайық.
Dialogue: 0,0:20:17.67,0:20:20.09,Default,,0,0,0,,Тез сыра алайық...
Dialogue: 0,0:20:20.17,0:20:21.34,Default,,0,0,0,,-Мори-сан-(Когоро) Иә?
Dialogue: 0,0:20:22.72,0:20:24.84,Default,,0,0,0,,Сіз Когоро Моурисіз бе?
Dialogue: 0,0:20:24.93,0:20:26.09,Default,,0,0,0,,А? Иә
Dialogue: 0,0:20:26.93,0:20:30.60,Default,,0,0,0,,Менің атым Риши, мен запастағы полиция қызметкерімін. Сізбен кездескеніме қуаныштымын.
Dialogue: 0,0:20:30.68,0:20:33.02,Default,,0,0,0,,А... Аа, солай.
Dialogue: 0,0:20:33.10,0:20:36.77,Default,,0,0,0,,Ум, запастағы полиция қызметкері?
Dialogue: 0,0:20:36.86,0:20:40.48,Default,,0,0,0,,Иә Қылмыстық мінез-құлық психологиясының сарапшысы ретінде—
Dialogue: 0,0:20:40.57,0:20:43.65,Default,,0,0,0,,Біз тергеуге арнайы көмек көрсетеміз.
Dialogue: 0,0:20:43.74,0:20:45.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:45.32,0:20:48.83,Default,,0,0,0,,Негізі Мори мырзаның елге кіргенін естідім.
Dialogue: 0,0:20:48.91,0:20:50.29,Default,,0,0,0,,Мен сені күттім.
Dialogue: 0,0:20:50.37,0:20:52.00,Default,,0,0,0,,Сіз мені күттіңіз бе?
Dialogue: 0,0:20:52.08,0:20:55.37,Default,,0,0,0,,Иә, өйткені туристердің көбі осында келеді.
Dialogue: 0,0:20:55.46,0:20:58.09,Default,,0,0,0,,Бірақ неге мен?
Dialogue: 0,0:20:58.17,0:21:02.13,Default,,0,0,0,,Негізі, мен детектив Моридің көмегін алғым келетін жағдай болды.
Dialogue: 0,0:21:02.21,0:21:06.09,Default,,0,0,0,,Иә? О, жоқ, жоқ, мен қазір демалыстамын.
Dialogue: 0,0:21:06.18,0:21:10.10,Default,,0,0,0,,А, менің ойымша, біз мұнда бірге баруымыз керек.
Dialogue: 0,0:21:10.18,0:21:11.43,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:11.52,0:21:14.18,Default,,0,0,0,,Ол запастағы полиция қызметкері болса да, жарасып қалсақ...
Dialogue: 0,0:21:14.27,0:21:17.69,Default,,0,0,0,,Сіз мені арзан әрі дәмді мейрамханамен таныстыра аласыз.
Dialogue: 0,0:21:18.27,0:21:20.94,Default,,0,0,0,,Тіпті казинода да... сіз түсінесіз.
Dialogue: 0,0:21:21.02,0:21:25.99,Default,,0,0,0,,Хм, солай шығар, хехехе
Dialogue: 0,0:21:26.07,0:21:27.61,Default,,0,0,0,,Гохон Жарайды.
Dialogue: 0,0:21:27.70,0:21:31.08,Default,,0,0,0,,Осы арнайы детектив Когоро Мориге көмектесейік.
Dialogue: 0,0:21:31.16,0:21:31.87,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:21:31.87,0:21:33.08,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:21:31.87,0:21:33.08,Default,,0,0,0,,Бұл құрмет!
Dialogue: 0,0:21:33.62,0:21:36.54,Default,,0,0,0,,Детектив Мори - менің әкемнің туған елі Жапонияның батыры.
Dialogue: 0,0:21:36.62,0:21:38.08,Default,,0,0,0,,Мен өзім үлкен жанкүйермін.
Dialogue: 0,0:21:38.17,0:21:39.33,Default,,0,0,0,,Эххе
Dialogue: 0,0:21:39.42,0:21:43.26,Default,,0,0,0,,Іс жүзінде бір кәсіпкер осындай нәрсені алды.
Dialogue: 0,0:21:43.34,0:21:46.13,Default,,0,0,0,,- (барлығы) Иә? -(Соноко) Ах!
Dialogue: 0,0:21:46.22,0:21:49.34,Default,,0,0,0,,- (Барлығы) Кайто Кид? - (Соноко) Бала мырза!
Dialogue: 0,0:21:54.22,0:21:59.90,Default,,0,0,0,,(Leon English)
Dialogue: 0,0:21:59.98,0:22:01.90,Default,,0,0,0,,(Джамалуддиннің ағылшын тілі)
Dialogue: 0,0:22:08.49,0:22:09.74,Default,,0,0,0,,(Leon English)
Dialogue: 0,0:22:09.82,0:22:10.91,Default,,0,0,0,,(Рейчелдің ағылшыншасы)
Dialogue: 0,0:22:15.50,0:22:19.21,Default,,0,0,0,,(Leon English)
Dialogue: 0,0:22:21.00,0:22:24.09,Default,,0,0,0,,(Leon English)
Dialogue: 0,0:22:24.17,0:22:26.92,Default,,0,0,0,,(Джамалуддиннің ағылшыншасы)
Dialogue: 0,0:22:32.68,0:22:34.89,Default,,0,0,0,,(Джамалуддиннің ағылшыншасы)
Dialogue: 0,0:22:36.77,0:22:39.14,Default,,0,0,0,,Уау, бұл керемет.
Dialogue: 0,0:22:39.23,0:22:41.06,Default,,0,0,0,,Әке, тыныш болыңыз
Dialogue: 0,0:22:41.15,0:22:44.73,Default,,0,0,0,,Ой, бұл сауыт да керемет~
Dialogue: 0,0:22:46.49,0:22:50.16,Default,,0,0,0,,Ой! иә?
Dialogue: 0,0:22:50.86,0:22:52.24,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:22:52.32,0:22:53.41,Default,,0,0,0,,- (Когоро) Оу - (Жүгіріп) Әке
Dialogue: 0,0:22:54.41,0:22:55.91,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:22:55.99,0:22:58.00,Default,,0,0,0,,Мен әкем үшін өкінемін.
Dialogue: 0,0:22:58.08,0:23:01.38,Default,,0,0,0,,Сонымен Леон заңы кім?
Dialogue: 0,0:23:01.46,0:23:05.55,Default,,0,0,0,,Доктор Леон бастапқыда атақты қылмыстық мінез-құлық психологы болды.
Dialogue: 0,0:23:05.63,0:23:09.51,Default,,0,0,0,,Біз бірнеше қатыгез қылмыскерлерді ұстау үшін полициямен жұмыс жасадық.
Dialogue: 0,0:23:09.59,0:23:10.51,Default,,0,0,0,,Иә
Dialogue: 0,0:23:10.59,0:23:13.51,Default,,0,0,0,,Сингапурдың атақты детективі?
Dialogue: 0,0:23:13.60,0:23:15.93,Default,,0,0,0,,Екі жыл бұрын мен полициядан кеттім.
Dialogue: 0,0:23:16.01,0:23:20.02,Default,,0,0,0,,Ол қазір өте табысты қауіпсіздік компаниясының президенті.
Dialogue: 0,0:23:20.60,0:23:24.44,Default,,0,0,0,,Мен Леон мырзадан қылмыстық мінез-құлық психологиясын да оқыдым.
Dialogue: 0,0:23:24.52,0:23:25.94,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:23:26.02,0:23:28.69,Default,,0,0,0,,Бұл Леонның ескертуі бар ма?
Dialogue: 0,0:23:28.78,0:23:31.03,Default,,0,0,0,,Жоқ, мен кезең-кезеңімен түсіндіремін.
Dialogue: 0,0:23:31.11,0:23:33.03,Default,,0,0,0,,Алдымен мынаны қараңыз
Dialogue: 0,0:23:33.12,0:23:35.24,Default,,0,0,0,,Кайто Баланың мақсаты —
Dialogue: 0,0:23:35.33,0:23:38.04,Default,,0,0,0,,Қара көк жұдырық деп аталатын асыл тас.
Dialogue: 0,0:23:38.12,0:23:40.71,Default,,0,0,0,,Қожайыны - бизнесмен Чонхан Чен.
Dialogue: 0,0:23:41.29,0:23:44.21,Default,,0,0,0,,Оған баланың хабарламасы келді.
Dialogue: 0,0:23:44.29,0:23:47.05,Default,,0,0,0,,Олай болса сол Чонхан деген жігітке бар.
Dialogue: 0,0:23:47.13,0:23:48.09,Default,,0,0,0,,Барған жөн
Dialogue: 0,0:23:48.17,0:23:52.34,Default,,0,0,0,,Сондықтан зергерлік бұйымдар осы сарайдың жертөлесінде сақталады.
Dialogue: 0,0:23:52.93,0:23:54.59,Default,,0,0,0,,Әшекей осында...
Dialogue: 0,0:23:54.68,0:23:57.89,Default,,0,0,0,,Иә, бұл иесінің қалауы.
Dialogue: 0,0:23:57.97,0:24:01.64,Default,,0,0,0,,Мұндағы сейф дербес әзірленген заманауи жүйе болып табылады.
Dialogue: 0,0:24:01.73,0:24:02.85,Default,,0,0,0,,Банктік сейфтен де артық...
Dialogue: 0,0:24:01.73,0:24:02.85,Default,,0,0,0,,Хехехе
Dialogue: 0,0:24:02.94,0:24:04.81,Default,,0,0,0,,Соңғысы ма...
Dialogue: 0,0:24:04.90,0:24:08.23,Default,,0,0,0,,Бала бұл жолы қиынға соғатын сияқты.
Dialogue: 0,0:24:08.32,0:24:09.99,Default,,0,0,0,,Оны мен өзім жиі айтамын.
Dialogue: 0,0:24:10.07,0:24:13.70,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сейф қаншалықты заманауи болса да...
Dialogue: 0,0:24:13.78,0:24:16.07,Default,,0,0,0,,Егер ол Кид-самаға тисе, бұл сәл ғана.
Dialogue: 0,0:24:16.16,0:24:17.20,Default,,0,0,0,,Сәлем Соноко
Dialogue: 0,0:24:17.28,0:24:19.12,Default,,0,0,0,,Сен Ранды білесің, солай емес пе?
Dialogue: 0,0:24:19.20,0:24:21.83,Default,,0,0,0,,Кид-саманың тамаша ұрлық техникасы
Dialogue: 0,0:24:22.58,0:24:25.79,Default,,0,0,0,,Дүниедегі кез келген әйел оған ғашық болса, оның жүрегі ұрланады...
Dialogue: 0,0:24:25.88,0:24:27.67,Default,,0,0,0,,Соноконы тоқтатыңыз
Dialogue: 0,0:24:27.75,0:24:28.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:30.55,0:24:35.59,Default,,0,0,0,,Ха! Ран екеумізден басқа.
Dialogue: 0,0:24:35.68,0:24:38.76,Default,,0,0,0,,- (Соноко) Эй Ран - (Жүгіріп) Ух, иә, әрине.
Dialogue: 0,0:24:39.22,0:24:40.10,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:24:43.69,0:24:46.40,Default,,0,0,0,,Ей, жақсы істемесең, жақсы болмайсың.
Dialogue: 0,0:24:46.48,0:24:48.61,Default,,0,0,0,,Қылышты қолына алғаннан кейін екі айдың ішінде-ақ қоғам тірегіне айналғандар да бар.
Dialogue: 0,0:24:49.27,0:24:51.99,Default,,0,0,0,,- (Жүгіріп) Керемет аула! -(Соноко) Дұрыс.
Dialogue: 0,0:24:52.07,0:24:54.11,Default,,0,0,0,,Барлығыңызбен танысқаныма қуаныштымын.
Dialogue: 0,0:24:54.86,0:24:56.62,Default,,0,0,0,,Менің атым Леон Лоу.
Dialogue: 0,0:24:56.70,0:24:59.78,Default,,0,0,0,,Сондай-ақ, менің күзетшім және күзет бастығым.
Dialogue: 0,0:24:59.87,0:25:03.25,Default,,0,0,0,,Хезри Жамалуддинге бізбен бірге отыруға рұқсат етіңіз.
Dialogue: 0,0:25:08.79,0:25:13.13,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:25:20.18,0:25:24.06,Default,,0,0,0,,О, сен ұлы детективсің, Когоро Моури.
Dialogue: 0,0:25:24.14,0:25:26.94,Default,,0,0,0,,Жоқ, мен бұған сене алмаймын-
Dialogue: 0,0:25:27.02,0:25:30.44,Default,,0,0,0,,Менің атымды басқа елдердің адамдары да білетініне сене алмаймын.
Dialogue: 0,0:25:31.15,0:25:34.86,Default,,0,0,0,,(Leon English)
Dialogue: 0,0:25:34.95,0:25:36.53,Default,,0,0,0,,Не? а?
Dialogue: 0,0:25:41.79,0:25:45.21,Default,,0,0,0,,Ал орта мектептің детективі Шиничи Кудо
Dialogue: 0,0:25:45.79,0:25:47.21,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:25:47.29,0:25:50.63,Default,,0,0,0,,Сіз детективтен гөрі сиқыршыға көбірек ұқсайсыз.
Dialogue: 0,0:25:50.71,0:25:51.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:52.55,0:25:54.01,Default,,0,0,0,,Бұл сіздің саусағыңыз
Dialogue: 0,0:25:54.59,0:25:56.09,Default,,0,0,0,,Жұқа және серпімді
Dialogue: 0,0:25:56.17,0:26:01.01,Default,,0,0,0,,Мен детектив болсам да, мен шеберлігімнен гөрі мұнда бәсекелестікке көбірек көңіл бөлемін.
Dialogue: 0,0:26:01.89,0:26:02.93,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:26:03.01,0:26:05.39,Default,,0,0,0,,Әй, мұнда кім бар?
Dialogue: 0,0:26:05.48,0:26:07.81,Default,,0,0,0,,Сіздің атыңыз Соноко Сузуки.
Dialogue: 0,0:26:07.89,0:26:10.56,Default,,0,0,0,,Бұл жігіт сақтығын түсіре алмайды.
Dialogue: 0,0:26:10.65,0:26:13.07,Default,,0,0,0,,(Рейчелдің ағылшыншасы)
Dialogue: 0,0:26:13.15,0:26:15.61,Default,,0,0,0,,(Джонханның ағылшыншасы)
Dialogue: 0,0:26:15.69,0:26:18.07,Default,,0,0,0,,О, Когоро Моури мырза!
Dialogue: 0,0:26:18.15,0:26:21.24,Default,,0,0,0,,Әйелім де, мен де сенің жанкүйерлеріңміз.
Dialogue: 0,0:26:21.32,0:26:22.33,Default,,0,0,0,,О
Dialogue: 0,0:26:22.99,0:26:24.58,Default,,0,0,0,,Мен бір фотосурет аламын ба?
Dialogue: 0,0:26:24.66,0:26:28.00,Default,,0,0,0,,(Рейчелдің ағылшыншасы)
Dialogue: 0,0:26:35.71,0:26:40.51,Default,,0,0,0,,Мен қара көк жұдырықты мұқият қарағаныңызды қалаймын.
Dialogue: 0,0:26:42.22,0:26:45.72,Default,,0,0,0,,Бұл есіктің ар жағында біздің компанияның мақтаныш қоймасы орналасқан.
Dialogue: 0,0:26:46.35,0:26:50.23,Default,,0,0,0,,Бұл орынды тек шектеулі адамдар ғана аша алады.
Dialogue: 0,0:27:05.45,0:27:09.21,Default,,0,0,0,,Қабырғалары ыстыққа төзімді қорытпадан жасалған және ешқашан бұзылмайды.
Dialogue: 0,0:27:09.29,0:27:09.91,Default,,0,0,0,,(ағылшынша әңгіме)
Dialogue: 0,0:27:09.91,0:27:13.21,Default,,0,0,0,,Сондай-ақ сырттан келетін радиотолқындар толығымен бұғатталған.
Dialogue: 0,0:27:13.29,0:27:16.50,Default,,0,0,0,,Әрбір жүктің орны периодты түрде ауыстырылады.
Dialogue: 0,0:27:16.59,0:27:22.01,Default,,0,0,0,,Бұл сейф әлемдегі менің идеалдарыма толы жалғыз ерекше сейф.
Dialogue: 0,0:27:23.89,0:27:25.35,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:27:25.43,0:27:28.35,Default,,0,0,0,,Барлығыңыз, сәл қашықтықты қалдырыңыз.
Dialogue: 0,0:27:30.64,0:27:32.73,Default,,0,0,0,,Бұл қарақшы патшаның дәлелі деп айтылды.
Dialogue: 0,0:27:33.36,0:27:35.73,Default,,0,0,0,,Бұл «Қара көк жұдырық» деп аталатын асыл тас.
Dialogue: 0,0:27:35.82,0:27:37.32,Default,,0,0,0,,Бұл үлкен көк сапфир.
Dialogue: 0,0:27:37.32,0:27:38.90,Default,,0,0,0,,Бұл үлкен көк сапфир.
Dialogue: 0,0:27:37.32,0:27:38.90,Default,,0,0,0,,Сен мені көресің бе, Артур?
Dialogue: 0,0:27:38.99,0:27:40.74,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:27:40.82,0:27:43.49,Default,,0,0,0,,Мен түсінемін, бұл жерде болғанша...
Dialogue: 0,0:27:43.57,0:27:46.24,Default,,0,0,0,,Кидд қанша болса да, ол араласа алмайды деп ойлаймын.
Dialogue: 0,0:27:46.33,0:27:48.95,Default,,0,0,0,,Бұлай жұмыс істемейді.
Dialogue: 0,0:27:49.04,0:27:51.08,Default,,0,0,0,,Ертең басталатын каратэден турнир кезінде
Dialogue: 0,0:27:51.16,0:27:54.67,Default,,0,0,0,,Белбеу шара өтетін жерде көрсетіледі деп шешілді.
Dialogue: 0,0:27:54.75,0:27:56.71,Default,,0,0,0,,Яғни, турнир кезеңінде
Dialogue: 0,0:27:56.80,0:27:59.71,Default,,0,0,0,,Ол өтетін жердегі бөлмеде сақталады.
Dialogue: 0,0:27:59.80,0:28:03.18,Default,,0,0,0,,Біз қауіпсіздікті қатаң сақтаймыз, бірақ ол мұндағыдан да нашар болады.
Dialogue: 0,0:28:03.26,0:28:04.14,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:28:04.22,0:28:06.72,Default,,0,0,0,,(Джонхан ағылшын тілі)
Dialogue: 0,0:28:19.15,0:28:22.11,Default,,0,0,0,,Сіз қауіпсіздік жағдайы мұндағыдан да нашар дедіңіз.
Dialogue: 0,0:28:22.20,0:28:25.91,Default,,0,0,0,,Сонымен, Кид Сапфирдің өтетін орынға көшуін күтіп отыр.
Dialogue: 0,0:28:25.99,0:28:27.41,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:28:27.49,0:28:28.83,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:28:28.91,0:28:31.20,Default,,0,0,0,,Мұнда көздеу өте қауіпті.
Dialogue: 0,0:28:31.29,0:28:32.58,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:28:32.66,0:28:36.13,Default,,0,0,0,,Маған зергерлік бұйымдарды қорғауға көмектесуге рұқсат етіңізші.
Dialogue: 0,0:28:36.21,0:28:38.63,Default,,0,0,0,,<Бірақ ол өлмеді>
Dialogue: 0,0:29:06.66,0:29:08.12,Default,,0,0,0,,Жеңіл жеңіс
Dialogue: 0,0:29:09.99,0:29:11.49,Default,,0,0,0,,Ой
Dialogue: 0,0:29:25.22,0:29:26.63,Default,,0,0,0,,Маған саусақ іздерін беріңізші.
Dialogue: 0,0:29:40.19,0:29:41.77,Default,,0,0,0,,Тым оңай ма?
Dialogue: 0,0:29:47.28,0:29:48.53,Default,,0,0,0,,Мен көптен күттім
Dialogue: 0,0:29:51.24,0:29:56.96,Default,,0,0,0,,Фантом ұры бала, сенің осы уақытқа дейін жеткенің таңқаларлық.
Dialogue: 0,0:29:57.54,0:29:59.21,Default,,0,0,0,,Бұл үлкен сенімділік.
Dialogue: 0,0:29:59.29,0:30:03.96,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге асыл тастарды бере алмаймын.
Dialogue: 0,0:30:04.05,0:30:07.30,Default,,0,0,0,,Мен Чонхан Ченге өтемақы төлегім келмейді.
Dialogue: 0,0:30:07.38,0:30:11.85,Default,,0,0,0,,Аа, менің жұмысым осындай қазыналарды ұрлау.
Dialogue: 0,0:30:11.93,0:30:17.14,Default,,0,0,0,,Ал ұрлау қиын болған сайын мен күйіп кетем.
Dialogue: 0,0:30:18.23,0:30:19.48,Default,,0,0,0,,Ну ха!
Dialogue: 0,0:30:19.56,0:30:22.82,Default,,0,0,0,,Гаха, аа, а...
Dialogue: 0,0:30:22.90,0:30:26.74,Default,,0,0,0,,(Баланың ыңырсыуы)
Dialogue: 0,0:30:28.91,0:30:30.57,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:30:36.00,0:30:37.66,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:30:37.75,0:30:40.54,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:31:01.98,0:31:05.28,Default,,0,0,0,,Мен олар Тазер мылтығын пайдаланады деп ешқашан ойламадым.
Dialogue: 0,0:31:15.45,0:31:16.45,Default,,0,0,0,,Суретке түсіріп алсам болар еді
Dialogue: 0,0:31:17.87,0:31:19.37,Default,,0,0,0,,Терең! Өте сау-саламат көрінесің! Бір жақсы жаңалық болды ма?
Dialogue: 0,0:31:37.97,0:31:39.64,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:31:39.73,0:31:41.27,Default,,0,0,0,,Бала
Dialogue: 0,0:31:41.35,0:31:42.73,Default,,0,0,0,,Уау
Dialogue: 0,0:31:44.11,0:31:45.52,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:31:45.61,0:31:46.61,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:31:46.69,0:31:48.44,Default,,0,0,0,,(бағыныңқы ағылшын тілі)
Dialogue: 0,0:31:51.32,0:31:54.12,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:31:54.20,0:31:55.49,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:31:55.58,0:31:56.62,Default,,0,0,0,,(бағыныңқы ағылшын тілі)
Dialogue: 0,0:32:01.46,0:32:06.38,Default,,0,0,0,,Жоғары деңгейдегі адамдар әрқашан ең нашар мүмкіндікті ескере отырып әрекет етеді.
Dialogue: 0,0:32:06.46,0:32:08.38,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:32:08.46,0:32:11.13,Default,,0,0,0,,Бізге бұл жерден тез кету керек.
Dialogue: 0,0:32:12.34,0:32:13.43,Default,,0,0,0,,Ах
Dialogue: 0,0:32:17.51,0:32:19.22,Default,,0,0,0,,Ах
Dialogue: 0,0:32:19.81,0:32:20.68,Default,,0,0,0,,Құт
Dialogue: 0,0:32:20.77,0:32:21.73,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:32:21.81,0:32:22.69,Default,,0,0,0,,Гува!
Dialogue: 0,0:32:25.06,0:32:26.19,Default,,0,0,0,,Хи хи
Dialogue: 0,0:32:32.95,0:32:33.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:32:35.03,0:32:38.53,Default,,0,0,0,,Оны кінәлаңыз! Ха!
Dialogue: 0,0:32:40.79,0:32:42.21,Default,,0,0,0,,- (Кёгоку) Хмм - Уау
Dialogue: 0,0:32:45.96,0:32:49.59,Default,,0,0,0,,Қандай пышақ. Мен артқа секіруім керек еді, әйтпесе қауіпті болар еді.
Dialogue: 0,0:32:49.67,0:32:53.59,Default,,0,0,0,,Бұл заңсыз кіру емес пе?
Dialogue: 0,0:32:53.68,0:32:56.59,Default,,0,0,0,,Олай болса, мұнда не үшін келдің?
Dialogue: 0,0:32:56.68,0:33:00.22,Default,,0,0,0,,Мені осында жаттығуға шақырды.
Dialogue: 0,0:33:00.31,0:33:02.93,Default,,0,0,0,,Мен сенімен келісе аламын деп ешқашан ойламаппын.
Dialogue: 0,0:33:03.02,0:33:04.85,Default,,0,0,0,,Жоқ, жоқ, мен мұны істегім келмейді.
Dialogue: 0,0:33:04.94,0:33:07.40,Default,,0,0,0,,Сұрақтар қойылмайды! Фусей
Dialogue: 0,0:33:07.48,0:33:09.02,Default,,0,0,0,,Эй... Не?
Dialogue: 0,0:33:09.94,0:33:11.03,Default,,0,0,0,,Дайындық～
Dialogue: 0,0:33:16.74,0:33:17.82,Default,,0,0,0,,Сондықтан, жас ханым,
Dialogue: 0,0:33:29.67,0:33:32.84,Default,,0,0,0,,Футбол добы... Ол қайдан шыққан...
Dialogue: 0,0:33:32.92,0:33:35.93,Default,,0,0,0,,Рахмет, детектив
Dialogue: 0,0:33:37.14,0:33:39.85,Default,,0,0,0,,(мотор дыбысы)
Dialogue: 0,0:33:50.31,0:33:51.86,Default,,0,0,0,,Бұл жігіт керемет!
Dialogue: 0,0:33:51.94,0:33:55.86,Default,,0,0,0,,Мен атама мың да бір шүкіршілік етуім керек, тіпті қиналғанда да еркін болғаны үшін.
Dialogue: 0,0:33:56.95,0:34:00.24,Default,,0,0,0,,Бірақ олай емес.
Dialogue: 0,0:34:18.97,0:34:23.43,Default,,0,0,0,,Мен құтқарылдым. Жабдықты қайтару туралы дұрыс шешім қабылдадым.
Dialogue: 0,0:34:23.51,0:34:25.43,Default,,0,0,0,,Мен саған көмектескім келмеді.
Dialogue: 0,0:34:25.52,0:34:26.35,Default,,0,0,0,,ол маған шексіз артықшылық беретін қаруға айналады.
Dialogue: 0,0:34:26.43,0:34:29.44,Default,,0,0,0,,Одан гөрі маған айтатын кез келді.
Dialogue: 0,0:34:29.52,0:34:32.15,Default,,0,0,0,,Мені осында әкелгеніңіздің нақты себебі
Dialogue: 0,0:34:33.02,0:34:34.40,Default,,0,0,0,,Иә
Dialogue: 0,0:34:34.48,0:34:35.74,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:34:38.20,0:34:42.83,Default,,0,0,0,,Леон жылдар бойы қара көк жұдырықты іздеді.
Dialogue: 0,0:34:42.91,0:34:45.20,Default,,0,0,0,,Құтқаруға бір қадам қалды
Dialogue: 0,0:34:45.29,0:34:48.12,Default,,0,0,0,,Мені Чонхан Чен басып озды.
Dialogue: 0,0:34:48.21,0:34:53.38,Default,,0,0,0,,Оған біреу суға батқан кеменің орналасқан жерін айтып берген сияқты.
Dialogue: 0,0:34:53.46,0:34:56.88,Default,,0,0,0,,Ең күдікті адам Шерилин Тан.
Dialogue: 0,0:34:56.96,0:35:00.43,Default,,0,0,0,,Біраз уақыт ол Леон компаниясында заң кеңесшісі қызметін атқарды.
Dialogue: 0,0:35:00.51,0:35:02.68,Default,,0,0,0,,Екеуінің қарым-қатынасы нашарлады.
Dialogue: 0,0:35:02.76,0:35:06.27,Default,,0,0,0,,Сыбыс бойынша ол Кёгокуның демеушісі болды...
Dialogue: 0,0:35:06.35,0:35:08.56,Default,,0,0,0,,Жамалуддиннің жеңісі
Dialogue: 0,0:35:08.64,0:35:12.27,Default,,0,0,0,,Басқаша айтқанда, ол Леонның асыл тасты алуына жол бермек болды.
Dialogue: 0,0:35:12.36,0:35:14.44,Default,,0,0,0,,Егер бұл рас болса
Dialogue: 0,0:35:14.52,0:35:19.11,Default,,0,0,0,,Суға батқан кеме туралы ақпарат тарап кетті деген қауесеттің де растығы бар.
Dialogue: 0,0:35:19.20,0:35:21.78,Default,,0,0,0,,Ал Шерилин Тан өлтірілді.
Dialogue: 0,0:35:22.62,0:35:24.74,Default,,0,0,0,,Егер ағып кету туралы қауесет шын болса—
Dialogue: 0,0:35:24.83,0:35:28.12,Default,,0,0,0,,Бұл Леонның Шерилинді өлтіруге ниеті болғанын білдіреді.
Dialogue: 0,0:35:28.20,0:35:30.54,Default,,0,0,0,,Полиция не ойлайды?
Dialogue: 0,0:35:30.62,0:35:34.29,Default,,0,0,0,,Өкінішке орай, Леон күдіктілер тізімінен шығарылды.
Dialogue: 0,0:35:34.38,0:35:35.59,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:35:35.67,0:35:38.88,Default,,0,0,0,,Күдіктілер болуы мүмкін.
Dialogue: 0,0:35:38.97,0:35:40.30,Default,,0,0,0,,Күдікті?
Dialogue: 0,0:35:43.43,0:35:47.64,Default,,0,0,0,,Полиция Шерилин Танды өлтірген жерде екенін жариялаған жоқ.
Dialogue: 0,0:35:47.72,0:35:50.35,Default,,0,0,0,,Бір карта қалды
Dialogue: 0,0:35:50.43,0:35:52.23,Default,,0,0,0,,Бұл менің ескертуім.
Dialogue: 0,0:35:53.23,0:35:55.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:35:55.11,0:35:57.94,Default,,0,0,0,,Бірақ неге мұндай керемет көрініс?
Dialogue: 0,0:35:58.03,0:35:59.74,Default,,0,0,0,,Мен бұл жігітті көруім керек.
Dialogue: 0,0:36:00.95,0:36:03.03,Default,,0,0,0,,Бәрібір бірге көретін болсақ...
Dialogue: 0,0:36:11.08,0:36:12.50,Default,,0,0,0,,...
Dialogue: 0,0:36:12.58,0:36:15.88,Default,,0,0,0,,Артур Хирайға қайтатын уақыт.
Dialogue: 0,0:36:15.96,0:36:17.25,Default,,0,0,0,,Айтпақшы, Артур
Dialogue: 0,0:36:17.34,0:36:19.01,Default,,0,0,0,,Мүмкін Артур Конан Дойл
Dialogue: 0,0:36:19.55,0:36:20.92,Default,,0,0,0,,Хирай дегеніміз не?
Dialogue: 0,0:36:21.01,0:36:22.38,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:36:23.01,0:36:26.39,Default,,0,0,0,,Эдогава Ранпоның шын аты мен оны Таро Хирайдан алдым.
Dialogue: 0,0:36:26.47,0:36:27.64,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:36:27.72,0:36:30.93,Default,,0,0,0,,Одан да бұл жігіттің тұзақ екені сөзсіз.
Dialogue: 0,0:36:31.02,0:36:33.19,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:36:33.27,0:36:36.98,Default,,0,0,0,,Мен сені осында әкелдім, ұлы детектив.
Dialogue: 0,0:36:37.06,0:36:38.94,Default,,0,0,0,,Сіз мұндай нәрсеге жақсысыз ба?
Dialogue: 0,0:36:39.03,0:36:42.95,Default,,0,0,0,,Мен себебін түсіндім, бірақ оның жасалғаны маған ұнамайды.
Dialogue: 0,0:36:43.78,0:36:46.03,Default,,0,0,0,,Бұл Бала-сама
Dialogue: 0,0:36:46.99,0:36:50.12,Default,,0,0,0,,Мен бұлай үндемей отыра алмаймын.
Dialogue: 0,0:36:56.25,0:36:59.84,Default,,0,0,0,,Әлі де кеш емес, көптен күттім.
Dialogue: 0,0:36:59.92,0:37:01.71,Default,,0,0,0,,жаман жаман
Dialogue: 0,0:37:02.47,0:37:03.59,Default,,0,0,0,,Сәлем қарашы
Dialogue: 0,0:37:03.67,0:37:08.60,Default,,0,0,0,,Өте әдемі түнгі көрініс, сондай романтикалық.
Dialogue: 0,0:37:12.14,0:37:13.56,Default,,0,0,0,,Ха
Dialogue: 0,0:37:17.15,0:37:21.61,Default,,0,0,0,,Енді ұялмаңыз. Біз кездесіп жатырмыз, солай ма?
Dialogue: 0,0:37:21.69,0:37:22.57,Default,,0,0,0,,Ааа
Dialogue: 0,0:37:22.65,0:37:24.57,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:37:24.65,0:37:26.57,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:37:26.66,0:37:30.03,Default,,0,0,0,,Ранның жігіті, оның жалған екенін де түсінбейсің бе?
Dialogue: 0,0:37:30.12,0:37:32.95,Default,,0,0,0,,А, бірақ олар білсе, мен Жапонияға қайта алмаймын.
Dialogue: 0,0:37:33.58,0:37:37.96,Default,,0,0,0,,Шыу!
Dialogue: 0,0:37:47.59,0:37:50.39,Default,,0,0,0,,Каа~ Сингапур Цутара
Dialogue: 0,0:37:50.47,0:37:52.22,Default,,0,0,0,,Singapore Sling.
Dialogue: 0,0:37:52.31,0:37:53.47,Default,,0,0,0,,Тағы бір сусын!
Dialogue: 0,0:37:54.43,0:37:55.98,Default,,0,0,0,,-Мистер Моури? - (Когоро) Иә?
Dialogue: 0,0:37:56.06,0:37:59.23,Default,,0,0,0,,А, ана, ана... сен...
Dialogue: 0,0:37:59.31,0:38:01.61,Default,,0,0,0,,Мен осында отыра аламын ба?
Dialogue: 0,0:38:01.69,0:38:06.70,Default,,0,0,0,,О! Өтінемін, бірге ішейік.
Dialogue: 0,0:38:07.45,0:38:10.12,Default,,0,0,0,,Шындығында, мен... аа
Dialogue: 0,0:38:11.08,0:38:12.12,Default,,0,0,0,,Ah (төгілген дыбыс)
Dialogue: 0,0:38:12.70,0:38:13.62,Default,,0,0,0,,О
Dialogue: 0,0:38:13.70,0:38:16.37,Default,,0,0,0,,Мен не істер едім?
Dialogue: 0,0:38:17.16,0:38:19.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:38:19.42,0:38:22.04,Default,,0,0,0,,Жоқ, жоқ, жоқ, уайымдамаңыз.
Dialogue: 0,0:38:24.17,0:38:26.47,Default,,0,0,0,,(ұл үшін ағылшын тілі)
Dialogue: 0,0:38:26.55,0:38:28.43,Default,,0,0,0,,Хмм, қоңырау шалу керек пе?
Dialogue: 0,0:38:28.51,0:38:31.05,Default,,0,0,0,,Қоңырау Мори мырзаға арналған сияқты.
Dialogue: 0,0:38:31.14,0:38:33.97,Default,,0,0,0,,Мен үшін? Ол кім?
Dialogue: 0,0:38:34.06,0:38:35.14,Default,,0,0,0,,Моури мырза
Dialogue: 0,0:38:35.22,0:38:36.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:36.68,0:38:38.81,Default,,0,0,0,,Мен сізбен бір нәрсе туралы сөйлескім келеді.
Dialogue: 0,0:38:40.15,0:38:41.86,Default,,0,0,0,,Ертең осында
Dialogue: 0,0:38:41.94,0:38:42.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:43.82,0:38:45.82,Default,,0,0,0,,Аа... соншалықты
Dialogue: 0,0:38:47.78,0:38:51.78,Default,,0,0,0,,Құдай-ау, бұзылып қалды.
Dialogue: 0,0:38:51.87,0:38:55.41,Default,,0,0,0,,Ей, тағы да ішейік!
Dialogue: 0,0:38:56.50,0:39:00.33,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:39:04.05,0:39:06.46,Default,,0,0,0,,Кім жеңеді деп ойлайсың?
Dialogue: 0,0:39:06.55,0:39:07.92,Default,,0,0,0,,Бұл Киогоку.
Dialogue: 0,0:39:08.01,0:39:09.26,Default,,0,0,0,,Мен ешқашан жеңілген емеспін.
Dialogue: 0,0:39:09.34,0:39:12.68,Default,,0,0,0,,Иә? Солай ма? Ұстаз, бірінші рет естіп тұрмын.
Dialogue: 0,0:39:12.76,0:39:16.52,Default,,0,0,0,,Қажетті жерде және бағытта жеткілікті күш жұмсалады.
Dialogue: 0,0:39:16.60,0:39:18.60,Default,,0,0,0,,Жеміс береді, солай ма?
Dialogue: 0,0:39:18.68,0:39:20.52,Default,,0,0,0,,Барлығы түсінді ме?
Dialogue: 0,0:39:20.60,0:39:21.73,Default,,0,0,0,,Иә
Dialogue: 0,0:39:30.91,0:39:33.49,Default,,0,0,0,,(ағылшынша хабарландыру)
Dialogue: 0,0:39:38.20,0:39:40.12,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:39:46.71,0:39:51.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:39:51.59,0:39:52.64,Default,,0,0,0,,Иә~
Dialogue: 0,0:39:52.72,0:39:55.89,Default,,0,0,0,,Жамалуддин шынымен де күшті көрінеді.
Dialogue: 0,0:39:55.97,0:39:57.64,Default,,0,0,0,,Ауыр қуат үшін —
Dialogue: 0,0:39:57.72,0:40:00.68,Default,,0,0,0,,Оның жылдамдығы мен техникасы да бар.
Dialogue: 0,0:40:00.77,0:40:01.64,Default,,0,0,0,,Қатты көрінеді.
Dialogue: 0,0:40:02.73,0:40:05.27,Default,,0,0,0,,Тейтан орта мектебінің каратэ клубының жетекшісі күткендей
Dialogue: 0,0:40:05.36,0:40:08.03,Default,,0,0,0,,Фокус әртүрлі.
Dialogue: 0,0:40:08.11,0:40:12.49,Default,,0,0,0,,Әй, әшекейлер Кёгоку-санның қолында жоғалып кетсе ше?
Dialogue: 0,0:40:12.57,0:40:14.53,Default,,0,0,0,,Енді оны көтере алмаймын деп ойламайсың ба?
Dialogue: 0,0:40:14.62,0:40:16.41,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:40:16.49,0:40:19.08,Default,,0,0,0,,Мен оған барынша жақындағым келмейді.
Dialogue: 0,0:40:21.91,0:40:24.71,Default,,0,0,0,,Ах, Шин-сан келді!
Dialogue: 0,0:40:26.38,0:40:27.84,Default,,0,0,0,,Қараңдар, бәрі де сені жақтайды!
Dialogue: 0,0:40:27.92,0:40:31.09,Default,,0,0,0,,Неліктен жергілікті гакинчо менің артымнан еріп жүр?
Dialogue: 0,0:40:31.17,0:40:33.34,Default,,0,0,0,,Әйтеуір, сені сағындым.
Dialogue: 0,0:40:43.44,0:40:45.40,Default,,0,0,0,,(ағылшынша төреші)
Dialogue: 0,0:40:52.07,0:40:54.99,Default,,0,0,0,,Уау (ойыншылар) Уау!
Dialogue: 0,0:40:55.07,0:40:57.91,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:40:57.99,0:40:59.37,Default,,0,0,0,,Хар…
Dialogue: 0,0:41:01.08,0:41:02.75,Default,,0,0,0,,Дыбыс~
Dialogue: 0,0:41:01.08,0:41:02.75,Default,,0,0,0,,Иә! Макото-сан, бұл керемет.
Dialogue: 0,0:41:02.75,0:41:02.83,Default,,0,0,0,,Яй, Шин-сан, тамаша
Dialogue: 0,0:41:02.83,0:41:04.54,Default,,0,0,0,,Иә! Шин-сан, бұл тамаша.
Dialogue: 0,0:41:02.83,0:41:04.54,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:41:04.54,0:41:05.00,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:41:05.00,0:41:06.92,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:41:05.00,0:41:06.92,Default,,0,0,0,,Мен дәл қазір сені көргім келеді.
Dialogue: 0,0:41:06.92,0:41:07.50,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:41:07.59,0:41:09.75,Default,,0,0,0,,Бұл менің әкемнен.
Dialogue: 0,0:41:09.84,0:41:12.88,Default,,0,0,0,,Менің ойымша, сондықтан сіз бұл күдікті емес деп отырсыз.
Dialogue: 0,0:41:12.97,0:41:16.09,Default,,0,0,0,,Әке! Не болды?
Dialogue: 0,0:41:16.18,0:41:19.18,Default,,0,0,0,,Жүгір, мына жігіттерге түсіндіріп берші.
Dialogue: 0,0:41:19.26,0:41:21.93,Default,,0,0,0,,Мен барлық металл заттарды шығардым.
Dialogue: 0,0:41:22.02,0:41:24.14,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:41:24.23,0:41:25.06,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:41:25.14,0:41:26.56,Default,,0,0,0,,(ағылшынша күзетші)
Dialogue: 0,0:41:26.65,0:41:27.69,Default,,0,0,0,,Жоқ, ол әдеттегідей салқынқанды емес.
Dialogue: 0,0:41:28.81,0:41:32.19,Default,,0,0,0,,Боқ~ Мен мұнымен ішке кіре алмаймын.
Dialogue: 0,0:41:32.78,0:41:34.57,Default,,0,0,0,,Моури мырза, жақсысыз ба?
Dialogue: 0,0:41:34.65,0:41:35.49,Default,,0,0,0,,Әй, Риши!
Dialogue: 0,0:41:35.57,0:41:39.62,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:41:39.70,0:41:41.04,Default,,0,0,0,,Риши мырзаға рахмет
Dialogue: 0,0:41:41.12,0:41:42.70,Default,,0,0,0,,Кездескенімізге қуаныштымын.
Dialogue: 0,0:41:43.37,0:41:45.66,Default,,0,0,0,,Ашылу салтанатында белбеу ашылғаннан кейін.
Dialogue: 0,0:41:45.75,0:41:48.50,Default,,0,0,0,,Қазіргі уақытта жер асты сейфінде сақтаулы.
Dialogue: 0,0:41:48.58,0:41:50.71,Default,,0,0,0,,Қарсы болмасаңыз, мен сізге кейін хабарлаймын.
Dialogue: 0,0:41:51.46,0:41:53.34,Default,,0,0,0,,Осы уақытқа дейін қандай жолмен жүрдіңіз?
Dialogue: 0,0:41:53.42,0:41:56.59,Default,,0,0,0,,Е...жақсы, кішкене патрульге шығайық.
Dialogue: 0,0:41:57.22,0:41:59.55,Default,,0,0,0,,Асқазанға байланысты ұйықтап қалдыңыз.
Dialogue: 0,0:42:01.56,0:42:04.64,Default,,0,0,0,,PIN коды әр 10 минут сайын өзгереді
Dialogue: 0,0:42:04.73,0:42:08.48,Default,,0,0,0,,Басқару компьютер арқылы жүзеге асырылады және хабарландырулар электрондық пошта арқылы жіберіледі.
Dialogue: 0,0:42:08.56,0:42:11.61,Default,,0,0,0,,Бұл лейтенант Айданға және маған жеткізіледі.
Dialogue: 0,0:42:11.69,0:42:15.49,Default,,0,0,0,,Бұл үшеуміз, оның ішінде сейфті басқаратын профессор Леон.
Dialogue: 0,0:42:18.61,0:42:20.74,Default,,0,0,0,,Бұл тағы бір бос бөлме.
Dialogue: 0,0:42:20.82,0:42:22.12,Default,,0,0,0,,Жағдайлар?
Dialogue: 0,0:42:22.83,0:42:25.62,Default,,0,0,0,,Едендегі салмақ датчигі Төбедегі бақылау камерасы
Dialogue: 0,0:42:25.70,0:42:28.87,Default,,0,0,0,,Ал өтетін жер полициямен қоршалған.
Dialogue: 0,0:42:28.96,0:42:33.38,Default,,0,0,0,,А, бұл жағдайда әлгі елес ұры қолдары мен аяқтарын пайдалана алады. Иә.
Dialogue: 0,0:42:33.46,0:42:35.63,Default,,0,0,0,,Моури мырза, мұнда темекі шегуге тыйым салынған.
Dialogue: 0,0:42:35.71,0:42:38.43,Default,,0,0,0,,О, бұл құрметсіздік, иә?
Dialogue: 0,0:42:41.01,0:42:41.93,Default,,0,0,0,,Хмм?
Dialogue: 0,0:42:42.01,0:42:45.14,Default,,0,0,0,,Мас болғаным сонша, ұмытып кеттім.
Dialogue: 0,0:42:45.22,0:42:48.56,Default,,0,0,0,,Оны маған барда берді. Бір әңгіме бар деп естідім.
Dialogue: 0,0:42:50.44,0:42:52.82,Default,,0,0,0,,Бұл Леон мырзаның хатшысының визит карточкасы.
Dialogue: 0,0:42:52.90,0:42:55.11,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:42:55.19,0:42:58.24,Default,,0,0,0,,Негізі мен мас болдым, көп нәрсені есіме түсіре алмадым.
Dialogue: 0,0:42:58.32,0:42:59.91,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:42:59.99,0:43:02.57,Default,,0,0,0,,Онда Леон компаниясының белгісі бар.
Dialogue: 0,0:43:02.66,0:43:04.41,Default,,0,0,0,,Белгі.
Dialogue: 0,0:43:04.91,0:43:07.75,Default,,0,0,0,,«Ұлттық стадионның артында 15:00»
Dialogue: 0,0:43:07.83,0:43:11.54,Default,,0,0,0,,«№3 есіктің алдында күтіңіз» деп жазылған.
Dialogue: 0,0:43:11.63,0:43:14.30,Default,,0,0,0,,Сондай-ақ, «Ешкімге білмеу».
Dialogue: 0,0:43:14.38,0:43:18.51,Default,,0,0,0,,Түсіндім, сағат 15.00...
Dialogue: 0,0:43:18.59,0:43:19.80,Default,,0,0,0,,Міне таяп қалды!
Dialogue: 0,0:43:19.88,0:43:21.89,Default,,0,0,0,,Ах, Моури-сан.
Dialogue: 0,0:43:21.97,0:43:24.51,Default,,0,0,0,,Әйелін күту еркектің ұят
Dialogue: 0,0:43:28.02,0:43:28.85,Default,,0,0,0,,Иә
Dialogue: 0,0:43:32.15,0:43:34.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:39.53,0:43:41.28,Default,,0,0,0,,Бұл өте жақсы матч болды.
Dialogue: 0,0:43:42.24,0:43:45.91,Default,,0,0,0,,Мен ертеңгі жартылай финал мен финалды асыға күтіп жүрмін.
Dialogue: 0,0:43:45.99,0:43:47.75,Default,,0,0,0,,Рахмет
Dialogue: 0,0:43:47.83,0:43:49.54,Default,,0,0,0,,Сіздің күшіңіз ерекше
Dialogue: 0,0:43:50.29,0:43:51.25,Default,,0,0,0,,«Токио Доумдағы Джайентс матчында Шинигаминің бар-жоғын растау»
Dialogue: 0,0:43:51.33,0:43:54.00,Default,,0,0,0,,Менің оққағарым болғың келе ме?
Dialogue: 0,0:43:55.59,0:43:56.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:44:01.01,0:44:04.30,Default,,0,0,0,,Жарайды, күте тұрыңыз, әрине, мен әзілдедім.
Dialogue: 0,0:44:04.39,0:44:07.43,Default,,0,0,0,,Негізі мен сенен бір нәрсе сұрайын деп едім.
Dialogue: 0,0:44:08.85,0:44:09.68,Default,,0,0,0,,Бізге жақсылап сөйлесу керек!
Dialogue: 0,0:44:12.10,0:44:14.98,Default,,0,0,0,,Жұдырығың не үшін?
Dialogue: 0,0:44:15.56,0:44:19.28,Default,,0,0,0,,Күшке ұмтыл, алда не күтіп тұр?
Dialogue: 0,0:44:20.40,0:44:22.82,Default,,0,0,0,,Сізді не итермелейді?
Dialogue: 0,0:44:22.91,0:44:24.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:25.07,0:44:27.41,Default,,0,0,0,,Жауап бере алмайсыз ба?
Dialogue: 0,0:44:27.49,0:44:30.62,Default,,0,0,0,,Мақсатсыз толық емес жұдырық қауіпті.
Dialogue: 0,0:44:30.70,0:44:35.63,Default,,0,0,0,,Сіз өзіңізді ғана емес, айналаңыздағы адамдарды да бақытсыз етесіз.
Dialogue: 0,0:44:35.71,0:44:38.13,Default,,0,0,0,,Айналаңыздағы адамдар? Бақытсыз ба?
Dialogue: 0,0:44:38.21,0:44:41.55,Default,,0,0,0,,Иә, мысалы, сіз жақсы көретін адам
Dialogue: 0,0:44:42.30,0:44:44.89,Default,,0,0,0,,Сіз де сондасыз ба? Ондай адам
Dialogue: 0,0:44:46.10,0:44:50.93,Default,,0,0,0,,Жұдырығың қауіп тудырып, жақсы көретін адамға зиянын тигізуі мүмкін.
Dialogue: 0,0:44:51.02,0:44:54.77,Default,,0,0,0,,Егер мұндай жағдай орын алса, сіз не істер едіңіз?
Dialogue: 0,0:44:58.15,0:44:59.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:59.57,0:45:01.78,Default,,0,0,0,,Мен де ертеңгі ойынды асыға күтемін.
Dialogue: 0,0:45:13.50,0:45:14.42,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:45:16.00,0:45:18.29,Default,,0,0,0,,Хехе, еңбегіңіз үшін рахмет.
Dialogue: 0,0:45:18.38,0:45:20.05,Default,,0,0,0,,Соноко-сан
Dialogue: 0,0:45:20.13,0:45:23.47,Default,,0,0,0,,Ол енді мұнда жиі келмейді, сондықтан мен оны көруге келдім.
Dialogue: 0,0:45:23.55,0:45:25.30,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:45:25.38,0:45:27.97,Default,,0,0,0,,Олай болса, бәріміз түскі асқа барайық.
Dialogue: 0,0:45:28.05,0:45:29.89,Default,,0,0,0,,Менің барғым келетін дүкенім бар.
Dialogue: 0,0:45:29.97,0:45:33.10,Default,,0,0,0,,Кешіріңіз, Соноко, біз кешкі асқа бірге бардық.
Dialogue: 0,0:45:33.18,0:45:34.31,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:45:34.39,0:45:36.31,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:45:36.40,0:45:40.32,Default,,0,0,0,,Бірақ Шиничи, асыл тас мені күзетіп тұрғанда, мен бұл жерден кете алмаймын деп ойлаймын.
Dialogue: 0,0:45:40.40,0:45:44.70,Default,,0,0,0,,Мен түсіндім, онда оған көмектесу мүмкін емес.
Dialogue: 0,0:45:44.78,0:45:47.07,Default,,0,0,0,,Біз бірге барамыз ба, Макото?
Dialogue: 0,0:45:47.16,0:45:48.12,Default,,0,0,0,,Иә
Dialogue: 0,0:45:48.20,0:45:50.24,Default,,0,0,0,,Кейін кездескенше Ран
Dialogue: 0,0:45:50.33,0:45:51.83,Default,,0,0,0,,Алдын ала кешіріңіз.
Dialogue: 0,0:45:51.95,0:45:54.41,Default,,0,0,0,,Мен Макотоның көп жегенін қалаймын.
Dialogue: 0,0:45:54.50,0:45:56.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:46:07.34,0:46:10.26,Default,,0,0,0,,(Aidan English)
Dialogue: 0,0:46:17.52,0:46:18.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:18.56,0:46:23.78,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:46:28.91,0:46:30.32,Default,,0,0,0,,А…?
Dialogue: 0,0:46:32.74,0:46:38.33,Default,,0,0,0,,(Рейчелдің ағылшыншасы)
Dialogue: 0,0:46:47.80,0:46:50.22,Default,,0,0,0,,(ағылшын тілінен басшы)
Dialogue: 0,0:46:50.30,0:46:52.47,Default,,0,0,0,,(ағылшынша күзетші)
Dialogue: 0,0:46:52.55,0:46:58.89,Default,,0,0,0,,(Рейчел мен полицей ағылшын тілінде)
Dialogue: 0,0:47:10.28,0:47:11.32,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:47:14.24,0:47:16.33,Default,,0,0,0,,Мен қазынаны аламын.
Dialogue: 0,0:47:29.68,0:47:30.51,Default,,0,0,0,,Әй?
Dialogue: 0,0:47:34.39,0:47:37.18,Default,,0,0,0,,Итадакидама
Dialogue: 0,0:47:39.73,0:47:41.94,Default,,0,0,0,,Сізді бір нәрсе ұстап алды ма?
Dialogue: 0,0:47:42.02,0:47:43.61,Default,,0,0,0,,Ах
Dialogue: 0,0:47:49.24,0:47:51.28,Default,,0,0,0,,Мәйіт!? Және...
Dialogue: 0,0:47:52.91,0:47:54.16,Default,,0,0,0,,Рейчел
Dialogue: 0,0:47:54.87,0:47:57.41,Default,,0,0,0,,Қарғыс атсын, тез арада құтылуым керек.
Dialogue: 0,0:47:57.49,0:48:00.04,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:48:00.12,0:48:01.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:01.50,0:48:03.29,Default,,0,0,0,,Кейбір таңбалар...
Dialogue: 0,0:48:05.13,0:48:06.50,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:48:11.88,0:48:13.05,Default,,0,0,0,,(полиция қызметкері үшін ағылшын тілі)
Dialogue: 0,0:48:14.76,0:48:16.31,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:48:18.02,0:48:21.94,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:48:31.82,0:48:35.32,Default,,0,0,0,,Сен мені қашанға дейін күтесің, Рахила?
Dialogue: 0,0:48:35.41,0:48:36.12,Default,,0,0,0,,Тағы 10 минут күтіңіз...
Dialogue: 0,0:48:36.12,0:48:37.87,Default,,0,0,0,,Тағы 10 минут күтіңіз...
Dialogue: 0,0:48:36.12,0:48:37.87,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:48:37.87,0:48:38.58,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:48:38.58,0:48:39.87,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:48:38.58,0:48:39.87,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:48:39.87,0:48:39.95,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:48:39.95,0:48:41.91,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:48:39.95,0:48:41.91,Default,,0,0,0,,Мүмкін бала!
Dialogue: 0,0:48:41.91,0:48:42.00,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:48:42.00,0:48:43.00,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:48:42.00,0:48:43.00,Default,,0,0,0,,Енді ұрыспауға тырысайық.
Dialogue: 0,0:48:46.88,0:48:47.96,Default,,0,0,0,,(полиция қызметкері үшін ағылшын тілі)
Dialogue: 0,0:48:48.05,0:48:50.42,Default,,0,0,0,,Уау! Бұл ақылсыз
Dialogue: 0,0:48:51.21,0:48:54.59,Default,,0,0,0,,Бірақ мен сыртқа шыға алсам, ол менікі.
Dialogue: 0,0:48:56.85,0:48:58.31,Default,,0,0,0,,О
Dialogue: 0,0:49:01.68,0:49:04.35,Default,,0,0,0,,Сонша адам болды ма?
Dialogue: 0,0:49:04.44,0:49:05.85,Default,,0,0,0,,Әй?
Dialogue: 0,0:49:07.40,0:49:08.86,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:49:13.24,0:49:14.78,Default,,0,0,0,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,0:49:19.12,0:49:23.96,Default,,0,0,0,,(Айдан және полицей ағылшын тілінде)
Dialogue: 0,0:49:24.04,0:49:26.58,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:49:26.67,0:49:29.21,Default,,0,0,0,,Мен Моури мырзаны іздедім.
Dialogue: 0,0:49:29.29,0:49:32.34,Default,,0,0,0,,Уау, бұл үлкен мәселе.
Dialogue: 0,0:49:32.42,0:49:35.22,Default,,0,0,0,,Мен Баланың тапа-тал түсте бұлай шығады деп күтпеген едім...
Dialogue: 0,0:49:35.76,0:49:37.43,Default,,0,0,0,,Ал, уайымдама.
Dialogue: 0,0:49:37.51,0:49:39.93,Default,,0,0,0,,Бұл ұлы детектив Когоро Моури бірден бақылауға кірісті...
Dialogue: 0,0:49:40.01,0:49:41.72,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:49:41.81,0:49:46.19,Default,,0,0,0,,Бір қорқынышты нәрсе болды. Қазір қоймаға келіңіз.
Dialogue: 0,0:49:46.27,0:49:47.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:50.07,0:49:53.65,Default,,0,0,0,,(Ағылшын тілі)
Dialogue: 0,0:50:02.70,0:50:04.50,Default,,0,0,0,,Осы уақытқа дейін келсең...
Dialogue: 0,0:50:04.58,0:50:06.79,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:50:06.87,0:50:08.08,Default,,0,0,0,,Ха-ха
Dialogue: 0,0:50:08.17,0:50:09.46,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:50:14.17,0:50:16.05,Default,,0,0,0,,Бұл...
Dialogue: 0,0:50:16.13,0:50:19.18,Default,,0,0,0,,Жәбірленуші Леон мырзаның хатшысы Рейчел.
Dialogue: 0,0:50:19.26,0:50:21.01,Default,,0,0,0,,Рейчел?
Dialogue: 0,0:50:22.31,0:50:23.14,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:50:23.22,0:50:25.48,Default,,0,0,0,,Сіз бақылау камераларын тексердіңіз бе?
Dialogue: 0,0:50:25.56,0:50:29.56,Default,,0,0,0,,Жоқ, кадрлар бұзылып, қараусыз түсірілген.
Dialogue: 0,0:50:29.65,0:50:32.15,Default,,0,0,0,,Қайталап жіберу керек
Dialogue: 0,0:50:32.23,0:50:34.86,Default,,0,0,0,,Сонымен, қылмыскердің мақсаты...
Dialogue: 0,0:50:34.94,0:50:36.61,Default,,0,0,0,,Әрине солай.
Dialogue: 0,0:50:36.70,0:50:39.11,Default,,0,0,0,,Біз сізді іздеу үшін қолдан келгеннің бәрін жасаймыз.
Dialogue: 0,0:50:39.20,0:50:41.78,Default,,0,0,0,,Бақылау құралдары...
Dialogue: 0,0:50:41.87,0:50:45.20,Default,,0,0,0,,Кінәлі - сөзсіз Кайто Кид.
Dialogue: 0,0:50:45.29,0:50:48.04,Default,,0,0,0,,Кез келген жағдайда мен қауіпсіздік құрылғысын өшіруге тура келді, себебі...
Dialogue: 0,0:50:48.12,0:50:49.96,Default,,0,0,0,,Бұл сен кінәлі, балам.
Dialogue: 0,0:50:50.67,0:50:54.09,Default,,0,0,0,,Ей, эй, рас болса, сол кезде Рейчел-сан...
Dialogue: 0,0:50:54.17,0:50:58.13,Default,,0,0,0,,Сіз стадионға осы қариямен кездесуге келген боларсыз, солай ма?
Dialogue: 0,0:50:58.22,0:51:00.30,Default,,0,0,0,,Неліктен қоймада болдың?
Dialogue: 0,0:51:00.39,0:51:02.43,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:51:02.51,0:51:05.27,Default,,0,0,0,,Қойма алдындағы полиция қызметкерінің айтуы бойынша.
Dialogue: 0,0:51:05.35,0:51:08.56,Default,,0,0,0,,Ол сізге лейтенант Айданның ісін айту үшін келгенін айтты.
Dialogue: 0,0:51:08.64,0:51:12.31,Default,,0,0,0,,Бұл шұғыл мәселе болған сияқты, сондықтан сіз оны бірінші орынға қойдыңыз деп ойлаймын.
Dialogue: 0,0:51:12.40,0:51:15.36,Default,,0,0,0,,Осыдан кейін бірден әбігер болды.
Dialogue: 0,0:51:15.44,0:51:19.28,Default,,0,0,0,,Бірақ мен Баланың кісі өлтіргенін естіген емеспін.
Dialogue: 0,0:51:21.03,0:51:26.04,Default,,0,0,0,,Ой, ей, рұқсатсыз кірме. Бұл жігіт қайта келгісі келеді...
Dialogue: 0,0:51:28.41,0:51:30.29,Default,,0,0,0,,Ей, қанмен жазылса да.
Dialogue: 0,0:51:30.37,0:51:32.25,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:51:32.33,0:51:34.04,Default,,0,0,0,,Тыныштық, балам.
Dialogue: 0,0:51:34.13,0:51:35.09,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:51:40.68,0:51:42.09,Default,,0,0,0,,(Саяма) Тыныш бол, бәрің!
Dialogue: 0,0:51:42.18,0:51:43.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:51:44.35,0:51:47.89,Default,,0,0,0,,Сен мүлде қамалып қалдың, балам.
Dialogue: 0,0:51:50.19,0:51:53.81,Default,,0,0,0,,(порттық сирена)
Dialogue: 0,0:51:53.90,0:51:54.94,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:51:55.69,0:52:00.74,Default,,0,0,0,,Әй, қызық болып барады емес пе?
Dialogue: 0,0:52:02.28,0:52:04.91,Default,,0,0,0,,Соноко-санның таңдауынан күткендей.
Dialogue: 0,0:52:04.99,0:52:08.33,Default,,0,0,0,,Тауық күріші де, қарбыз шырыны да өте дәмді болды.
Dialogue: 0,0:52:08.41,0:52:09.58,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:52:11.41,0:52:13.08,Default,,0,0,0,,Не?
Dialogue: 0,0:52:13.17,0:52:17.50,Default,,0,0,0,,А-а-а... Е, менің ішім ісіп кетті.
Dialogue: 0,0:52:17.59,0:52:21.05,Default,,0,0,0,,Макото мырза, менің барғым келетін жерім бар.
Dialogue: 0,0:52:21.13,0:52:22.59,Default,,0,0,0,,Мен сені кез келген жерде ертіп барамын
Dialogue: 0,0:52:25.64,0:52:26.89,Default,,0,0,0,,Ик!
Dialogue: 0,0:52:28.22,0:52:33.77,Default,,0,0,0,,(Ерлерге арналған ағылшын тілі)
Dialogue: 0,0:52:33.85,0:52:36.57,Default,,0,0,0,,А... менімен соқтығысып қалған сол еді ғой?
Dialogue: 0,0:52:36.65,0:52:40.44,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:52:47.49,0:52:48.58,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:52:49.16,0:52:50.95,Default,,0,0,0,,Шыу!
Dialogue: 0,0:52:51.04,0:52:52.33,Default,,0,0,0,,(Қонақтар айқайлайды)
Dialogue: 0,0:52:57.09,0:52:59.67,Default,,0,0,0,,Басқа достар жасырынып жүрген болуы мүмкін.
Dialogue: 0,0:52:59.75,0:53:02.92,Default,,0,0,0,,Соноко-сан, мені тастамашы.
Dialogue: 0,0:53:03.01,0:53:03.84,Default,,0,0,0,,Иә
Dialogue: 0,0:53:06.26,0:53:07.60,Default,,0,0,0,,А... Иә!
Dialogue: 0,0:53:08.85,0:53:09.72,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:53:14.27,0:53:19.61,Default,,0,0,0,,Жұдырығың қауіп тудырып, жақсы көретін адамға зиянын тигізуі мүмкін.
Dialogue: 0,0:53:19.69,0:53:22.11,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:53:23.24,0:53:24.70,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:53:32.70,0:53:34.29,Default,,0,0,0,,Соноко-сан
Dialogue: 0,0:53:34.37,0:53:36.67,Default,,0,0,0,,(ер адамның айқайы)
Dialogue: 0,0:53:38.88,0:53:41.17,Default,,0,0,0,,Хуу
Dialogue: 0,0:53:48.35,0:53:50.51,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:53:56.06,0:53:59.56,Default,,0,0,0,,Табылды, көмектесіңізші
Dialogue: 0,0:54:12.49,0:54:15.79,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:54:16.75,0:54:18.46,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:54:28.18,0:54:29.22,Default,,0,0,0,,Соноко-сан!
Dialogue: 0,0:54:31.05,0:54:35.10,Default,,0,0,0,,(Халық ағылшын тілі)
Dialogue: 0,0:54:35.18,0:54:36.10,Default,,0,0,0,,Ha
Dialogue: 0,0:54:37.69,0:54:39.02,Default,,0,0,0,,Соноко-сан!
Dialogue: 0,0:54:46.95,0:54:48.36,Default,,0,0,0,,Соноко-сан!
Dialogue: 0,0:54:48.91,0:54:54.04,Default,,0,0,0,,Соноко-сан! Соноко-сан! Соноко-сан!
Dialogue: 0,0:55:02.59,0:55:04.80,Default,,0,0,0,,Сіздің жарақатыңыз қалай?
Dialogue: 0,0:55:04.88,0:55:07.17,Default,,0,0,0,,Өмірге қауіп төндіретін жарақаттар жоқ
Dialogue: 0,0:55:07.26,0:55:12.64,Default,,0,0,0,,Ол қазір ұйықтап жатыр, сондықтан оны бүгін түнде ауруханаға жатқызып, ертең тексереді.
Dialogue: 0,0:55:13.39,0:55:15.43,Default,,0,0,0,,Ха... бұл өте жақсы болды
Dialogue: 0,0:55:15.52,0:55:19.06,Default,,0,0,0,,Ха... Бірақ мен зұлым соққыны кешіре алмаймын.
Dialogue: 0,0:55:19.14,0:55:20.52,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:55:20.60,0:55:24.27,Default,,0,0,0,,Мен үшін, Соноко...
Dialogue: 0,0:55:26.28,0:55:27.53,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:55:27.61,0:55:29.90,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:55:29.99,0:55:31.28,Default,,0,0,0,,Ой, еңбектеріңізге рахмет.
Dialogue: 0,0:55:31.87,0:55:33.37,Default,,0,0,0,,Тергеу жағдайы қандай?
Dialogue: 0,0:55:33.45,0:55:38.41,Default,,0,0,0,,Иә, оқиға орны қаңырап бос жатқан артқы жолда болды және куәгерлер болған жоқ.
Dialogue: 0,0:55:38.50,0:55:41.42,Default,,0,0,0,,Жоқ, дәлірек айтсақ, адамдар болды.
Dialogue: 0,0:55:41.50,0:55:43.92,Default,,0,0,0,,Полиция көлігі ұрланған кезде таң қалды
Dialogue: 0,0:55:44.00,0:55:46.05,Default,,0,0,0,,Ол таң қалды.
Dialogue: 0,0:55:48.84,0:55:49.67,Default,,0,0,0,,Ах
Dialogue: 0,0:55:51.05,0:55:52.68,Default,,0,0,0,,Мен сізді мазаладым ба?
Dialogue: 0,0:55:52.76,0:55:55.51,Default,,0,0,0,,Профессор Леон, мұнда неге келдің?
Dialogue: 0,0:55:55.60,0:55:57.77,Default,,0,0,0,,Мен апатты естіп, ұшып келдім.
Dialogue: 0,0:55:57.85,0:56:00.31,Default,,0,0,0,,Соноко әлі ұйықтап жатыр еді.
Dialogue: 0,0:56:00.39,0:56:02.60,Default,,0,0,0,,Енді маған мынаны бере аласыз ба?
Dialogue: 0,0:56:02.69,0:56:03.81,Default,,0,0,0,,Рахмет
Dialogue: 0,0:56:07.86,0:56:11.32,Default,,0,0,0,,Менің уайымым дұрыс болған сияқты.
Dialogue: 0,0:56:12.03,0:56:15.58,Default,,0,0,0,,Соғыс Құдайы сізге сынақ береді.
Dialogue: 0,0:56:16.16,0:56:21.04,Default,,0,0,0,,Сізде әлі де жұдырықтай алатын ақыл, техника немесе дене жоқ.
Dialogue: 0,0:56:21.66,0:56:25.04,Default,,0,0,0,,Дұрыс, мен саған сүйкімді сыйлаймын.
Dialogue: 0,0:56:27.17,0:56:29.09,Default,,0,0,0,,Бұл Мисанга сияқты.
Dialogue: 0,0:56:29.80,0:56:34.72,Default,,0,0,0,,Бұл тозған кезде, бұл Құдай сенің ақыл-ойың, шеберлігің мен денеңнің дамығанын мойындағанының дәлелі.
Dialogue: 0,0:56:34.80,0:56:38.52,Default,,0,0,0,,Бірақ жұдырығың үзілмей тұрып сілкіп алсаң...
Dialogue: 0,0:56:38.60,0:56:40.35,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:56:44.94,0:56:47.82,Default,,0,0,0,,Онда қал... кет
Dialogue: 0,0:56:48.44,0:56:50.36,Default,,0,0,0,,Сізге қатты соққы болды.
Dialogue: 0,0:56:50.44,0:56:52.82,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:56:52.90,0:56:55.53,Default,,0,0,0,,Еш ойланбастан ату...
Dialogue: 0,0:56:55.62,0:56:57.99,Default,,0,0,0,,Бұл жолы ол мұны істеді.
Dialogue: 0,0:56:58.08,0:57:02.00,Default,,0,0,0,,Рейчелді өлтіру сенің ісің деп айтылады.
Dialogue: 0,0:57:02.08,0:57:04.37,Default,,0,0,0,,Мұның бәрі тұзақ
Dialogue: 0,0:57:04.46,0:57:06.88,Default,,0,0,0,,Кінәні өзіңе жүктеу
Dialogue: 0,0:57:06.96,0:57:09.21,Default,,0,0,0,,Бұл сиқыр сияқты
Dialogue: 0,0:57:09.30,0:57:11.51,Default,,0,0,0,,Мен ол жерде жоқпын
Dialogue: 0,0:57:12.34,0:57:15.76,Default,,0,0,0,,Көрермендерге мен дәл кісі өлтірушімін...
Dialogue: 0,0:57:15.84,0:57:18.01,Default,,0,0,0,,Сіз сонда болған сияқтысыз
Dialogue: 0,0:57:18.10,0:57:22.93,Default,,0,0,0,,Басқаша айтқанда, егер сіз өз көзқарасыңызды өзгертсеңіз, сіз тұқымдарды көре аласыз ба?
Dialogue: 0,0:57:24.73,0:57:27.36,Default,,0,0,0,,Ах, жұдырығымда...
Dialogue: 0,0:57:27.44,0:57:31.44,Default,,0,0,0,,Сиқыршы сізді бірдеңе бар сияқты сезінеді.
Dialogue: 0,0:57:31.53,0:57:36.41,Default,,0,0,0,,Бұл жұдырық ашылмай тұрып оның ішінде не бар екенін анықтау детективтің міндеті, солай ма?
Dialogue: 0,0:57:38.03,0:57:40.24,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:57:45.29,0:57:48.08,Default,,0,0,0,,Ішінде не бар, айтшы, тамаша детектив.
Dialogue: 0,0:57:48.75,0:57:53.21,Default,,0,0,0,,Кісі өлтіру деп аталатын жұмбақ жұдырықтың ішінде не бар?
Dialogue: 0,0:57:54.01,0:57:54.84,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:58:07.44,0:58:09.86,Default,,0,0,0,,Бала, сен әлі үйге келдің бе?
Dialogue: 0,0:58:09.94,0:58:12.98,Default,,0,0,0,,Эй, сен бүгін түндей аласың ба?
Dialogue: 0,0:58:13.07,0:58:15.61,Default,,0,0,0,,А... менің үйімде ме?
Dialogue: 0,0:58:15.70,0:58:18.62,Default,,0,0,0,,Үйге келсем де жалғызбын.
Dialogue: 0,0:58:19.16,0:58:22.95,Default,,0,0,0,,Жаңа ғана солай болды, мен қорқып кеттім.
Dialogue: 0,0:58:23.04,0:58:24.83,Default,,0,0,0,,Риши-санмен бірге болу туралы...
Dialogue: 0,0:58:24.91,0:58:27.62,Default,,0,0,0,,Менің ойымша, әкелер де өздерін қауіпсіз сезінеді.
Dialogue: 0,0:58:27.71,0:58:29.33,Default,,0,0,0,,Хмм.
Dialogue: 0,0:58:30.17,0:58:34.30,Default,,0,0,0,,Сол жігітпен екі күн қатарынан бір бөлмеде болу - ең жаманы.
Dialogue: 0,0:58:41.60,0:58:42.93,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:58:43.01,0:58:46.27,Default,,0,0,0,,Осының бәрін саған Ришидің әкесі берді ме?
Dialogue: 0,0:58:46.35,0:58:49.27,Default,,0,0,0,,Дұрыс, менің әкем мұхиттанушы.
Dialogue: 0,0:58:49.35,0:58:52.32,Default,,0,0,0,,Ол бес жыл бұрын, бірақ зерттеу барысында қайтыс болды.
Dialogue: 0,0:58:52.40,0:58:55.32,Default,,0,0,0,,Мен теңізге батып кеткен қирандыларды таптым.
Dialogue: 0,0:58:55.40,0:58:57.07,Default,,0,0,0,,Сіз мақтаншақ әкесіз.
Dialogue: 0,0:58:57.15,0:59:01.07,Default,,0,0,0,,Иә, онда менде әлі жұмыс қалды.
Dialogue: 0,0:59:01.16,0:59:02.83,Default,,0,0,0,,Артур, өтінемін, алдымен ұйықта.
Dialogue: 0,0:59:02.91,0:59:04.62,Default,,0,0,0,,Иә
Dialogue: 0,0:59:05.37,0:59:07.21,Default,,0,0,0,,Ах, эй, Риши-сан.
Dialogue: 0,0:59:07.29,0:59:10.46,Default,,0,0,0,,Мына картада қандай қызыл белгі бар?
Dialogue: 0,0:59:10.54,0:59:14.34,Default,,0,0,0,,Ах, бұл кеме қарақшылардың қай жерде шабуыл жасағанын көрсетеді.
Dialogue: 0,0:59:14.92,0:59:16.92,Default,,0,0,0,,Қарақшылар әлі де бар ма?
Dialogue: 0,0:59:17.01,0:59:18.09,Default,,0,0,0,,Иса
Dialogue: 0,0:59:18.17,0:59:21.34,Default,,0,0,0,,Сингапур маңында олар көп болатын.
Dialogue: 0,0:59:21.43,0:59:26.60,Default,,0,0,0,,Менің қазіргі проблемам қарақшылардан гөрі кісі өлтіру туралы.
Dialogue: 0,0:59:26.68,0:59:29.02,Default,,0,0,0,,Және Кайту Кид
Dialogue: 0,0:59:29.10,0:59:31.98,Default,,0,0,0,,Мен лейтенант Айданнан біраз материалдарды алдым.
Dialogue: 0,0:59:33.57,0:59:36.11,Default,,0,0,0,,Мен бүгін түні бойы ұйықтамаймын.
Dialogue: 0,0:59:37.32,0:59:38.53,Default,,0,0,0,,Уф
Dialogue: 0,0:59:40.28,0:59:41.11,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:59:41.70,0:59:43.53,Default,,0,0,0,,Мен Риши-санды аяймын.
Dialogue: 0,0:59:43.62,0:59:45.24,Default,,0,0,0,,Мен сенен ұйықтауыңды сұраймын.
Dialogue: 0,1:00:06.89,1:00:08.89,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,1:00:08.98,1:00:10.64,Default,,0,0,0,,Сіз мұны істедіңіз бе?
Dialogue: 0,1:00:10.73,1:00:12.94,Default,,0,0,0,,Соноко-сан, байқадың ба?
Dialogue: 0,1:00:13.02,1:00:15.69,Default,,0,0,0,,Хехехе, біраз уақыт бұрын.
Dialogue: 0,1:00:15.77,1:00:19.19,Default,,0,0,0,,Ха... бұл жақсы, шынымен.
Dialogue: 0,1:00:19.28,1:00:21.53,Default,,0,0,0,,Эй, бұл қандай да бір сиқыр ма?
Dialogue: 0,1:00:21.61,1:00:24.53,Default,,0,0,0,,Иә, осындай нәрсе.
Dialogue: 0,1:00:26.41,1:00:27.95,Default,,0,0,0,,Yotto
Dialogue: 0,1:00:29.50,1:00:32.46,Default,,0,0,0,,Жоқ, сәл демалыңыз.
Dialogue: 0,1:00:33.63,1:00:36.09,Default,,0,0,0,,Сіз мүлдем ұйықтамайсыз, солай ма?
Dialogue: 0,1:00:36.17,1:00:38.96,Default,,0,0,0,,Мен Сингапурға дейін келсем де, қызықсыз.
Dialogue: 0,1:00:39.05,1:00:42.84,Default,,0,0,0,,Өзіңді зорласаң, мен саған тиісемін. Өтінемін, бүгін түнде тыныш болыңыз.
Dialogue: 0,1:00:44.93,1:00:47.51,Default,,0,0,0,,Эй, мен сенен біраз уақыт сұрайын деп едім.
Dialogue: 0,1:00:47.60,1:00:50.35,Default,,0,0,0,,Сол жақ қасыңыздағы таңғышты неге алып тастамадыңыз?
Dialogue: 0,1:00:50.43,1:00:55.10,Default,,0,0,0,,Жоқ, жоқ, бұл ештеңе емес, шынымен.
Dialogue: 0,1:01:14.33,1:01:18.42,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:01:18.50,1:01:22.76,Default,,0,0,0,,(Евгений Ағылшын)
Dialogue: 0,1:01:23.84,1:01:27.01,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:01:27.10,1:01:29.51,Default,,0,0,0,,(Евгений Ағылшын)
Dialogue: 0,1:01:38.31,1:01:41.69,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:01:42.94,1:01:45.99,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:01:47.74,1:01:51.95,Default,,0,0,0,,Соқса, қайтарамын, бұл менің стилім.
Dialogue: 0,1:02:00.04,1:02:02.71,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,1:02:04.80,1:02:09.80,Default,,0,0,0,,(ағылшынша хабарландыру)
Dialogue: 0,1:02:14.10,1:02:16.94,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:02:17.56,1:02:19.48,Default,,0,0,0,,Турнирден бас тарттыңыз ба?
Dialogue: 0,1:02:19.56,1:02:21.90,Default,,0,0,0,,Неліктен? Менің кінәм бар ма?
Dialogue: 0,1:02:21.98,1:02:23.40,Default,,0,0,0,,Бізге шабуыл жасағандар —
Dialogue: 0,1:02:23.48,1:02:25.99,Default,,0,0,0,,Оның қайта шабуыл жасамайтынына кепілдік жоқ.
Dialogue: 0,1:02:26.07,1:02:28.87,Default,,0,0,0,,Мен Соноконың жанынан кете алмаймын.
Dialogue: 0,1:02:28.95,1:02:31.87,Default,,0,0,0,,Ха, бұл менің кінәм емес.
Dialogue: 0,1:02:31.95,1:02:35.87,Default,,0,0,0,,Турнирге келіңіз. Сіз ұрысқыңыз келетін адам бар, солай ма?
Dialogue: 0,1:02:35.96,1:02:37.37,Default,,0,0,0,,Иә
Dialogue: 0,1:02:37.46,1:02:40.79,Default,,0,0,0,,Бірақ мен Соноконы жалғыз қорғай алмадым.
Dialogue: 0,1:02:40.88,1:02:43.42,Default,,0,0,0,,Мен әлі де бірдеңе жетіспей тұрғандай сезінемін
Dialogue: 0,1:02:44.88,1:02:47.22,Default,,0,0,0,,Бұл жоқ шығар.
Dialogue: 0,1:02:47.76,1:02:49.89,Default,,0,0,0,,Макото-сан, сен үнемі бір нәрсені жасырасың.
Dialogue: 0,1:02:49.97,1:02:51.01,Default,,0,0,0,,Жасырын нәрсе?
Dialogue: 0,1:02:51.10,1:02:55.22,Default,,0,0,0,,Сен маған Мисанга немесе таңғыш туралы айтпайсың.
Dialogue: 0,1:02:55.31,1:02:58.85,Default,,0,0,0,,Жоқ, бұл шынымен...
Dialogue: 0,1:02:59.65,1:03:01.36,Default,,0,0,0,,- (Соноко) Шық - (Кёгоку) Иә?
Dialogue: 0,1:03:01.44,1:03:05.74,Default,,0,0,0,,Мені сондай өтірікке толы адам қорғағым келмейді.
Dialogue: 0,1:03:08.49,1:03:10.74,Default,,0,0,0,,Мен кеше қатты уайымдадым.
Dialogue: 0,1:03:10.82,1:03:12.87,Default,,0,0,0,,Мен көптен бері сізбен байланыса алмадым.
Dialogue: 0,1:03:12.95,1:03:14.29,Default,,0,0,0,,жаман жаман
Dialogue: 0,1:03:14.37,1:03:17.04,Default,,0,0,0,,Мен Баланы қууға құмар болдым.
Dialogue: 0,1:03:17.12,1:03:19.00,Default,,0,0,0,,Ай астындағы иллюзионист күткендей.
Dialogue: 0,1:03:19.08,1:03:24.63,Default,,0,0,0,,Осы Кудо Шиничи болса да, оны ұстау мүмкін емес... Уа!
Dialogue: 0,1:03:25.34,1:03:26.71,Default,,0,0,0,,О, Артур.
Dialogue: 0,1:03:26.80,1:03:27.88,Default,,0,0,0,,Сәлем
Dialogue: 0,1:03:27.97,1:03:31.26,Default,,0,0,0,,Сіздің досыңыз Соноко-ни-сан жақсы болды ма?
Dialogue: 0,1:03:31.34,1:03:34.10,Default,,0,0,0,,Иә, мен аурухананың жанына тоқтадым.
Dialogue: 0,1:03:34.18,1:03:36.02,Default,,0,0,0,,Тест нәтижелері: Мәселелер жоқ.
Dialogue: 0,1:03:36.10,1:03:39.31,Default,,0,0,0,,Мен түстен кейін ауруханадан шығып, қонақүйге қайтамын деп ойлаймын.
Dialogue: 0,1:03:39.39,1:03:40.98,Default,,0,0,0,,Әй, бұл жақсы.
Dialogue: 0,1:03:41.06,1:03:43.23,Default,,0,0,0,,Мазалағаныңызға рахмет.
Dialogue: 0,1:03:43.31,1:03:45.19,Default,,0,0,0,,Қонақүйге қайтатын кез келді.
Dialogue: 0,1:03:45.27,1:03:47.15,Default,,0,0,0,,Мен қайтар жолға заттарымды жинағым келеді.
Dialogue: 0,1:03:47.24,1:03:49.57,Default,,0,0,0,,Соноко мен басқаларды жалғыз қалдыруға бола ма?
Dialogue: 0,1:03:49.65,1:03:52.87,Default,,0,0,0,,Иә, мен оны біраз уақытқа қалдырамын деп ойлаймын.
Dialogue: 0,1:03:52.95,1:03:55.28,Default,,0,0,0,,Екеуі бірдеңе туралы айтысып жатқан сияқты.
Dialogue: 0,1:03:55.37,1:03:58.50,Default,,0,0,0,,Кёгоку-сан да матчтан шығып қалды.
Dialogue: 0,1:03:59.62,1:04:01.50,Default,,0,0,0,,Бұл Шиничи ме?
Dialogue: 0,1:04:04.92,1:04:08.63,Default,,0,0,0,,Олай болса, ұлы детектив Юбемен жолың болды ма?
Dialogue: 0,1:04:08.71,1:04:11.59,Default,,0,0,0,,Ришидің үйінде көрген тергеу құжаттарына сәйкес:
Dialogue: 0,1:04:17.10,1:04:18.85,Default,,0,0,0,,Куәгердің айтуы бойынша
Dialogue: 0,1:04:18.93,1:04:22.48,Default,,0,0,0,,Шерилин құлаған сауда орталығында пышақталған жоқ.
Dialogue: 0,1:04:22.56,1:04:25.61,Default,,0,0,0,,Бұл 3-мұнарадағы лифт ішінде болуы мүмкін.
Dialogue: 0,1:04:25.69,1:04:28.11,Default,,0,0,0,,Неліктен лифтте алаңдау керек?
Dialogue: 0,1:04:28.19,1:04:30.65,Default,,0,0,0,,Жақсы болмасаң, құтылудың жолы жоқ.
Dialogue: 0,1:04:34.28,1:04:36.91,Default,,0,0,0,,Ол сатылымдағы пышақпен арқасынан пышақталған.
Dialogue: 0,1:04:36.99,1:04:39.62,Default,,0,0,0,,Сауда орталығына саяхат
Dialogue: 0,1:04:39.70,1:04:42.00,Default,,0,0,0,,(Өтіп бара жатқандардың айқайы)
Dialogue: 0,1:04:42.08,1:04:43.37,Default,,0,0,0,,Ал құлағаннан кейін бірден
Dialogue: 0,1:04:45.33,1:04:47.63,Default,,0,0,0,,Оның көлігі жерасты тұрағында жарылды
Dialogue: 0,1:04:48.38,1:04:51.13,Default,,0,0,0,,Нәтижесінде бүкіл қонақүй электр қуатын жоғалтты.
Dialogue: 0,1:04:51.22,1:04:53.72,Default,,0,0,0,,Қазір қонақүйдің ішіндегі қауіпсіздік камераларынан түсірілген бейнелер
Dialogue: 0,1:04:53.80,1:04:56.35,Default,,0,0,0,,Сонда бәрі жоғалып кетті ме?
Dialogue: 0,1:04:56.43,1:04:59.31,Default,,0,0,0,,Бір қызығы Леон оқиға орнында болды.
Dialogue: 0,1:04:59.39,1:05:00.52,Default,,0,0,0,,Оның өз бөлмесі бар және
Dialogue: 0,1:05:00.60,1:05:03.35,Default,,0,0,0,,Мен тіпті Шерилиннің бөлмесін де ұйымдастырдым.
Dialogue: 0,1:05:03.44,1:05:05.27,Default,,0,0,0,,Бірақ оны өлтірген кезде
Dialogue: 0,1:05:05.35,1:05:08.90,Default,,0,0,0,,Көптеген куәгерлер оның басқа лифтте болғанын айтты.
Dialogue: 0,1:05:08.98,1:05:10.69,Default,,0,0,0,,Өйткені алиби расталды
Dialogue: 0,1:05:10.78,1:05:13.36,Default,,0,0,0,,Бұл оның тергеуден шеттетілгенін білдіре ме?
Dialogue: 0,1:05:13.45,1:05:14.70,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,1:05:14.78,1:05:16.57,Default,,0,0,0,,Ойланып қарашы, неге Леон?
Dialogue: 0,1:05:16.66,1:05:18.33,Default,,0,0,0,,Сізде чемодан болды ма?
Dialogue: 0,1:05:18.41,1:05:21.00,Default,,0,0,0,,А, әрине, полиция мұны да тексерді, бірақ...
Dialogue: 0,1:05:22.04,1:05:23.12,Default,,0,0,0,,Іші бос
Dialogue: 0,1:05:23.21,1:05:25.33,Default,,0,0,0,,Чемодан жөндеуге жіберілді.
Dialogue: 0,1:05:25.42,1:05:27.13,Default,,0,0,0,,Мен оны жаңа ғана алдым.
Dialogue: 0,1:05:27.21,1:05:31.38,Default,,0,0,0,,Қонақ үй маңындағы дүкен сұрауды алғаны да расталды.
Dialogue: 0,1:05:31.96,1:05:34.93,Default,,0,0,0,,Сіздің әлібиіңіз мінсіз бе? Бір ғана нәрсе қалды
Dialogue: 0,1:05:35.51,1:05:36.68,Default,,0,0,0,,Міне, осы
Dialogue: 0,1:05:36.76,1:05:40.14,Default,,0,0,0,,Неліктен оқиға орнында мұндай нәрсе қалды?
Dialogue: 0,1:05:40.22,1:05:42.27,Default,,0,0,0,,Мені тартудың қажеті не?
Dialogue: 0,1:05:42.35,1:05:46.19,Default,,0,0,0,,Неліктен олар оған қан жағу қиыншылыққа барды ...
Dialogue: 0,1:05:48.69,1:05:52.07,Default,,0,0,0,,Олар сені Рейчелді өлтірді деп айыптауға тырысуда.
Dialogue: 0,1:05:52.15,1:05:54.15,Default,,0,0,0,,Кісі өлтіру қаруы ретінде қолданылған пышақ Шерилинді өлтіру үшін қолданылған.
Dialogue: 0,1:05:54.24,1:05:55.45,Default,,0,0,0,,Дәл солай болды
Dialogue: 0,1:05:56.53,1:05:58.95,Default,,0,0,0,,Рейчел-сан, мен қоймаға кіргенге дейін.
Dialogue: 0,1:05:59.03,1:06:01.37,Default,,0,0,0,,Тұғырға қойылды.
Dialogue: 0,1:06:01.45,1:06:03.16,Default,,0,0,0,,Бірақ бөлмеге кіру үшін
Dialogue: 0,1:06:03.25,1:06:06.92,Default,,0,0,0,,Күзетшілер мен бірнеше қауіпсіздік құрылғыларынан өту керек
Dialogue: 0,1:06:07.00,1:06:08.46,Default,,0,0,0,,Қауіпсіздіктен жалтару
Dialogue: 0,1:06:08.54,1:06:11.21,Default,,0,0,0,,Датчикке қол тигізбей-ақ ене алатындар...
Dialogue: 0,1:06:12.25,1:06:13.46,Default,,0,0,0,,Жоқ, бұл мен емес.
Dialogue: 0,1:06:14.67,1:06:17.09,Default,,0,0,0,,Күдікті әлі де Леон Лоу.
Dialogue: 0,1:06:17.80,1:06:22.31,Default,,0,0,0,,Леон, қойма менеджері қауіпсіздік жүйесімен таныс.
Dialogue: 0,1:06:22.39,1:06:26.52,Default,,0,0,0,,Сонымен қатар, кеше таңертең белбеу стадионға жеткізілді.
Dialogue: 0,1:06:26.60,1:06:27.73,Default,,0,0,0,,Және Рахила
Dialogue: 0,1:06:27.81,1:06:30.77,Default,,0,0,0,,Ол өткен түнге дейін тірі екені расталды.
Dialogue: 0,1:06:30.86,1:06:35.19,Default,,0,0,0,,Басқаша айтқанда, қылмыс сол түнде, белбеу тасымалданбай тұрып болған болуы мүмкін.
Dialogue: 0,1:06:36.28,1:06:37.82,Default,,0,0,0,,Бірақ қандай мақсатта?
Dialogue: 0,1:06:37.91,1:06:40.70,Default,,0,0,0,,Неліктен мен өз хатшымды өлтіруім керек болды?
Dialogue: 0,1:06:40.78,1:06:44.33,Default,,0,0,0,,Мотив осы шығар.
Dialogue: 0,1:06:44.41,1:06:48.29,Default,,0,0,0,,Рахила қартқа бірдеңе айтқысы келді.
Dialogue: 0,1:06:48.37,1:06:51.46,Default,,0,0,0,,Артында қалған ізі сол қанды хат.
Dialogue: 0,1:06:51.54,1:06:55.21,Default,,0,0,0,,ол... «ол»? Сіз кім туралы айтып тұрсыз?
Dialogue: 0,1:07:06.48,1:07:09.73,Default,,0,0,0,,Жоқ, бір қорқынышты нәрсе болады.
Dialogue: 0,1:07:09.81,1:07:11.36,Default,,0,0,0,,Мен дұрыс ойлай алмаймын
Dialogue: 0,1:07:11.44,1:07:14.61,Default,,0,0,0,,Ұлы детектив сәтсіздікке ұшырады ма?
Dialogue: 0,1:07:14.69,1:07:17.28,Default,,0,0,0,,Олай болса әзірше үзіліс жасайық.
Dialogue: 0,1:07:17.36,1:07:18.90,Default,,0,0,0,,Айтпақшы, екі жұдырықта не бар...
Dialogue: 0,1:07:18.99,1:07:21.95,Default,,0,0,0,,Сол жақ жұдырықтағы кокос суы
Dialogue: 0,1:07:22.03,1:07:24.70,Default,,0,0,0,,Дұрыс Сіз қайдан білдіңіз?
Dialogue: 0,1:07:24.79,1:07:26.16,Default,,0,0,0,,Мен оны ертерек сатып алар едім.
Dialogue: 0,1:07:26.25,1:07:27.58,Default,,0,0,0,,Сіз көрдіңіз бе?
Dialogue: 0,1:07:28.54,1:07:29.83,Default,,0,0,0,,Сиқыр?
Dialogue: 0,1:07:30.71,1:07:31.83,Default,,0,0,0,,Жұдырықпен –
Dialogue: 0,1:07:31.92,1:07:35.63,Default,,0,0,0,,Сиқыршы сізді бірдеңе бар сияқты сезінеді.
Dialogue: 0,1:07:35.71,1:07:40.34,Default,,0,0,0,,Бұл жұдырық ашылмай тұрып оның ішінде не бар екенін анықтау детективтің міндеті, солай ма?
Dialogue: 0,1:07:40.43,1:07:43.05,Default,,0,0,0,,А, түсіндім.
Dialogue: 0,1:07:43.14,1:07:44.97,Default,,0,0,0,,Айтпақшы, Соноко ханым.
Dialogue: 0,1:07:45.72,1:07:47.93,Default,,0,0,0,,Сен сол каратэші жігітпен төбелесіп жатырсың ба?
Dialogue: 0,1:07:48.02,1:07:48.85,Default,,0,0,0,,Эй, Зекро
Dialogue: 0,1:07:49.73,1:07:52.35,Default,,0,0,0,,Ал, сапарда төбелес болып, жол-көлік оқиғасы болды...
Dialogue: 0,1:07:52.94,1:07:55.61,Default,,0,0,0,,Сіз өзіңізді тұрақсыз сезінесіз бе?
Dialogue: 0,1:07:55.69,1:07:57.90,Default,,0,0,0,,- Солай ма? - (Шиничи) А?
Dialogue: 0,1:07:57.99,1:08:02.32,Default,,0,0,0,,Сонокону жарақаттап, Киогокуды психикалық түрде шайқаңыз
Dialogue: 0,1:08:02.41,1:08:03.95,Default,,0,0,0,,Жамалуддинді жеңімпаз ету
Dialogue: 0,1:08:04.03,1:08:07.24,Default,,0,0,0,,Ең үлкен кедергі – Кёгоку-сан.
Dialogue: 0,1:08:07.33,1:08:08.66,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:08:08.75,1:08:11.25,Default,,0,0,0,,Бұл апатқа да Леон себеп болды.
Dialogue: 0,1:08:11.33,1:08:14.42,Default,,0,0,0,,Ойлағандай, Кёгоку мырза турнирден бас тартты.
Dialogue: 0,1:08:14.50,1:08:17.71,Default,,0,0,0,,Енді чемпиондық белбеу міндетті түрде Джамалуддинге тиесілі.
Dialogue: 0,1:08:17.80,1:08:21.13,Default,,0,0,0,,Басқаша айтқанда, ол менің жұмыс берушім Леонның қолында болады.
Dialogue: 0,1:08:21.22,1:08:23.64,Default,,0,0,0,,Қара көк жұдырықпен
Dialogue: 0,1:08:23.72,1:08:25.85,Default,,0,0,0,,Бірақ неге Леон қара көк жұдырыққа айналды?
Dialogue: 0,1:08:25.97,1:08:27.89,Default,,0,0,0,,Сіз бұл туралы ерекше айтасыз ба?
Dialogue: 0,1:08:27.97,1:08:30.89,Default,,0,0,0,,Мен анықтама болатын нәрсе таптым.
Dialogue: 0,1:08:30.98,1:08:33.81,Default,,0,0,0,,Бұл Леон таң ата кездескен адам.
Dialogue: 0,1:08:33.90,1:08:35.82,Default,,0,0,0,,Мына жігіттің кім екенін біле алмайсың ба?
Dialogue: 0,1:08:35.90,1:08:39.32,Default,,0,0,0,,А... Менің ойымша, бұл мүмкін емес.
Dialogue: 0,1:08:39.40,1:08:39.94,Default,,0,0,0,,(Гента және оның достары ойнайды)
Dialogue: 0,1:08:39.94,1:08:41.11,Default,,0,0,0,,(Гента және оның достары ойнайды)
Dialogue: 0,1:08:39.94,1:08:41.11,Default,,0,0,0,,Сіз
Dialogue: 0,1:08:41.11,1:08:41.20,Default,,0,0,0,,(Гента және оның достары ойнайды)
Dialogue: 0,1:08:41.20,1:08:44.20,Default,,0,0,0,,(Гента мен оның достары ойнайды)
Dialogue: 0,1:08:41.20,1:08:44.20,Default,,0,0,0,,Дәрігер кенет маған қоңырау шалып: «Мен Хоккайдоға барамын» деді.
Dialogue: 0,1:08:44.28,1:08:45.99,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,1:08:46.08,1:08:48.41,Default,,0,0,0,,Жаман Хайбара, мұнда да неше түрлі нәрсе бар.
Dialogue: 0,1:08:48.49,1:08:50.66,Default,,0,0,0,,Балалар, тыныш болыңдар.
Dialogue: 0,1:08:50.75,1:08:51.87,Default,,0,0,0,,Иә
Dialogue: 0,1:08:51.96,1:08:52.96,Default,,0,0,0,,Мүлдем
Dialogue: 0,1:08:53.04,1:08:56.04,Default,,0,0,0,,Ол бір жерде басқа оқиғаға қатысқан шығар, солай ма?
Dialogue: 0,1:08:56.13,1:08:58.00,Default,,0,0,0,,Шындығында, бұл дұрыс.
Dialogue: 0,1:08:58.09,1:09:01.76,Default,,0,0,0,,Мен жаңа ғана сізге Бала түсірген фотоның деректерін жібердім.
Dialogue: 0,1:09:01.84,1:09:04.30,Default,,0,0,0,,Бала? Жаңа ғана бала дедіңіз бе?
Dialogue: 0,1:09:04.39,1:09:06.76,Default,,0,0,0,,Өтірікші! Kaitou Kid шықты ма?
Dialogue: 0,1:09:06.85,1:09:08.72,Default,,0,0,0,,Конан телефоны, солай ма?
Dialogue: 0,1:09:08.81,1:09:11.31,Default,,0,0,0,,Конан-кун қазір Хоккайдода ма?
Dialogue: 0,1:09:11.39,1:09:13.69,Default,,0,0,0,,Бала не ұрлайды?
Dialogue: 0,1:09:13.77,1:09:15.44,Default,,0,0,0,,Ойылған ағаш аю?
Dialogue: 0,1:09:15.52,1:09:17.11,Default,,0,0,0,,Саппоро рамені мүмкін
Dialogue: 0,1:09:17.19,1:09:19.11,Default,,0,0,0,,Мен оны ұрламаймын.
Dialogue: 0,1:09:19.19,1:09:20.19,Default,,0,0,0,,Ай-чан
Dialogue: 0,1:09:20.28,1:09:21.86,Default,,0,0,0,,Оның орнына маған қоңырау шалыңыз
Dialogue: 0,1:09:21.94,1:09:22.90,Default,,0,0,0,,Жоспар
Dialogue: 0,1:09:22.99,1:09:23.99,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:09:24.70,1:09:27.28,Default,,0,0,0,,Кешіріңіз, балалар қазір қонақта.
Dialogue: 0,1:09:27.37,1:09:30.62,Default,,0,0,0,,Түсіндім. Мәліметтерді қайтып келген соң айтамын.
Dialogue: 0,1:09:30.70,1:09:34.33,Default,,0,0,0,,Енді сол фотодағы адамның кім екенін білгім келеді.
Dialogue: 0,1:09:34.42,1:09:36.21,Default,,0,0,0,,Иә, иә, түсіндім.
Dialogue: 0,1:09:36.29,1:09:38.63,Default,,0,0,0,,-де? Сіз шынымен жақсысыз ба?
Dialogue: 0,1:09:38.71,1:09:41.09,Default,,0,0,0,,Әй, әйтеуір
Dialogue: 0,1:09:41.17,1:09:43.51,Default,,0,0,0,,Менің ойымша, бұл бәрібір мағынасыз.
Dialogue: 0,1:09:43.59,1:09:44.63,Default,,0,0,0,,Тым қобалжымаңыз
Dialogue: 0,1:09:44.72,1:09:46.18,Default,,0,0,0,,Рахмет
Dialogue: 0,1:09:46.26,1:09:48.76,Default,,0,0,0,,Уф... Қазір бәрі жақсы.
Dialogue: 0,1:09:48.85,1:09:51.14,Default,,0,0,0,,Бұдан кейін не істейміз? тамаша детектив
Dialogue: 0,1:09:52.06,1:09:56.73,Default,,0,0,0,,Леон қара көк жұдырықты алғаннан кейін не болатынын көрейік.
Dialogue: 0,1:09:57.23,1:09:58.65,Default,,0,0,0,,Бірақ алдымен ағай бар.
Dialogue: 0,1:09:59.40,1:10:01.40,Default,,0,0,0,,Әй, күте тұрыңыз.
Dialogue: 0,1:10:04.99,1:10:06.07,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,1:10:06.16,1:10:09.91,Default,,0,0,0,,(ағылшынша хабарландыру)
Dialogue: 0,1:10:14.00,1:10:15.50,Default,,0,0,0,,Хмм…
Dialogue: 0,1:10:19.00,1:10:22.17,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:10:25.30,1:10:27.76,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:10:27.84,1:10:33.81,Default,,0,0,0,,(Leon English)
Dialogue: 0,1:10:45.61,1:10:49.70,Default,,0,0,0,,(Джонхан ағылшын тілі)
Dialogue: 0,1:10:49.78,1:10:53.20,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,1:10:56.75,1:10:58.33,Default,,0,0,0,,(Leon English)
Dialogue: 0,1:11:18.14,1:11:19.56,Default,,0,0,0,,(Pirate English)
Dialogue: 0,1:11:20.65,1:11:22.19,Default,,0,0,0,,(Капитанның ағылшын тілі)
Dialogue: 0,1:11:25.48,1:11:27.95,Default,,0,0,0,,Менің сенімен жақсы байланысым бар.
Dialogue: 0,1:11:28.57,1:11:32.45,Default,,0,0,0,,Егер бұл жоспар орындалса, біз серіктес боламыз.
Dialogue: 0,1:11:32.53,1:11:36.45,Default,,0,0,0,,Өтінемін, мен сізге қарыздармын.
Dialogue: 0,1:11:37.04,1:11:38.41,Default,,0,0,0,,Ұрлық жасады деген күдікті
Dialogue: 0,1:11:38.50,1:11:40.96,Default,,0,0,0,,Мені полиция алып кететін болды
Dialogue: 0,1:11:41.04,1:11:43.92,Default,,0,0,0,,Сен маған бірінші болып көмектестің.
Dialogue: 0,1:11:44.00,1:11:46.46,Default,,0,0,0,,Содан кейін басқа да көптеген нәрселер болды.
Dialogue: 0,1:11:47.38,1:11:50.84,Default,,0,0,0,,Өйткені сіз бұл адамның Рейдзиро Накатоми екенін білесіз.
Dialogue: 0,1:11:50.93,1:11:54.97,Default,,0,0,0,,Жапонияның кеме королі ретінде белгілі Джузо Накатомидің ұлы...
Dialogue: 0,1:11:55.06,1:11:57.60,Default,,0,0,0,,Әкемнің атын айтпа
Dialogue: 0,1:11:57.68,1:12:01.10,Default,,0,0,0,,Ах, бұл үшін кешіріңіз, бәрібір...
Dialogue: 0,1:12:01.19,1:12:04.11,Default,,0,0,0,,Бүгін түнде бәрі өзгереді
Dialogue: 0,1:12:04.19,1:12:06.98,Default,,0,0,0,,Сол сәтті жақыннан көруге ше?
Dialogue: 0,1:12:07.07,1:12:08.36,Default,,0,0,0,,Тағы бір… үкі ме?
Dialogue: 0,1:12:09.65,1:12:10.99,Default,,0,0,0,,Жүр, бірге барайық.
Dialogue: 0,1:12:11.49,1:12:16.49,Default,,0,0,0,,Сингапур тарихындағы бір парақтың куәгері болу
Dialogue: 0,1:12:19.58,1:12:20.50,Default,,0,0,0,,Әй?
Dialogue: 0,1:12:20.58,1:12:22.37,Default,,0,0,0,,Өте өкінішті, адам.
Dialogue: 0,1:12:23.13,1:12:26.13,Default,,0,0,0,,Не, кенеттен... ахехе
Dialogue: 0,1:12:26.21,1:12:27.63,Default,,0,0,0,,Жоқ, тоқтат!
Dialogue: 0,1:12:28.55,1:12:29.38,Default,,0,0,0,,Міне, осы
Dialogue: 0,1:12:31.80,1:12:32.97,Default,,0,0,0,,Накатоми?
Dialogue: 0,1:12:33.05,1:12:36.31,Default,,0,0,0,,Накатоми Накатоми жеткізуді білдіреді ме?
Dialogue: 0,1:12:36.39,1:12:37.22,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,1:12:37.31,1:12:40.18,Default,,0,0,0,,Ағай, мынаны қарызға алуға рұқсат етіңіз.
Dialogue: 0,1:12:42.85,1:12:45.15,Default,,0,0,0,,Жаңа ғана ағай деп айтқан жоқсыз ба?
Dialogue: 0,1:12:45.23,1:12:47.15,Default,,0,0,0,,Әлгі бала... Ықылық
Dialogue: 0,1:12:48.03,1:12:50.40,Default,,0,0,0,,Неліктен сіз кенеттен Жапониядан кетіп қалдыңыз?
Dialogue: 0,1:12:50.49,1:12:52.53,Default,,0,0,0,,Бұл демалыс. Бұл демалыс.
Dialogue: 0,1:12:52.61,1:12:55.07,Default,,0,0,0,,Сіз Сингапурға бес жыл бұрын бардыңыз, солай ма?
Dialogue: 0,1:12:55.16,1:12:58.49,Default,,0,0,0,,А, содан бері?
Dialogue: 0,1:12:58.58,1:12:59.70,Default,,0,0,0,,Президент Накатомиге
Dialogue: 0,1:12:59.79,1:13:01.16,Default,,0,0,0,,Қазіргі уақытта саясаткерлерге
Dialogue: 0,1:12:59.79,1:13:01.16,Default,,0,0,0,,Мерлион алаңындағы?
Dialogue: 0,1:13:01.16,1:13:01.25,Default,,0,0,0,,Бұл Мерлион алаңындағы жігіт пе еді?
Dialogue: 0,1:13:01.25,1:13:01.96,Default,,0,0,0,,Бұл Мерлион алаңындағы жігіт пе еді?
Dialogue: 0,1:13:01.25,1:13:01.96,Default,,0,0,0,,Пара алды деген күдік туындады...
Dialogue: 0,1:13:01.96,1:13:02.04,Default,,0,0,0,,Пара алды деген күдік туындады...
Dialogue: 0,1:13:02.04,1:13:03.83,Default,,0,0,0,,Пара алды деген күдік туындады...
Dialogue: 0,1:13:02.04,1:13:03.83,Default,,0,0,0,,Сол каратэші жігіт мені ұрды.
Dialogue: 0,1:13:03.83,1:13:04.88,Default,,0,0,0,,Әлгі каратэші мені ұрды.
Dialogue: 0,1:13:04.96,1:13:07.34,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:13:07.42,1:13:08.59,Default,,0,0,0,,Әй, Хайбара?
Dialogue: 0,1:13:09.34,1:13:11.17,Default,,0,0,0,,Мысалдағы адамның кім екенін білесің бе?
Dialogue: 0,1:13:11.26,1:13:12.84,Default,,0,0,0,,Иә, әйтеуір.
Dialogue: 0,1:13:12.93,1:13:16.85,Default,,0,0,0,,Оның аты Евгений Лим, қандай таңқаларлық қарақшы.
Dialogue: 0,1:13:16.93,1:13:17.81,Default,,0,0,0,,Пират?
Dialogue: 0,1:13:17.89,1:13:21.31,Default,,0,0,0,,Жақында Сингапурда көргендер туралы хабарламалар пайда болды.
Dialogue: 0,1:13:21.39,1:13:23.85,Default,,0,0,0,,Хайбар күткендей! Сіз маған сене аласыз.
Dialogue: 0,1:13:23.94,1:13:25.85,Default,,0,0,0,,Жалпақтау дегеніміз—
Dialogue: 0,1:13:25.94,1:13:28.52,Default,,0,0,0,,Менің тергеуімді қалайтын тағы бір нәрсе бар ма?
Dialogue: 0,1:13:28.61,1:13:30.19,Default,,0,0,0,,Ааа
Dialogue: 0,1:13:30.94,1:13:34.11,Default,,0,0,0,,Сіз Рейдзиро Накатоми есімін естідіңіз бе?
Dialogue: 0,1:13:34.20,1:13:35.32,Default,,0,0,0,,Nakatomi Shipping...
Dialogue: 0,1:13:35.41,1:13:36.57,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:13:37.20,1:13:40.95,Default,,0,0,0,,Мен Nakatomi Shipping компаниясына тиесілі кеменің күйін білгім келеді.
Dialogue: 0,1:13:41.04,1:13:43.62,Default,,0,0,0,,Сингапурдың айналасындағы кемелер ғана жеткілікті.
Dialogue: 0,1:13:46.71,1:13:51.09,Default,,0,0,0,,Сингапурдың айналасында екі жүк кемесі мен бір танкер бар.
Dialogue: 0,1:13:51.17,1:13:52.59,Default,,0,0,0,,Something I'm a little curious about is—
Dialogue: 0,1:13:52.67,1:13:55.38,Default,,0,0,0,,That the tanker is off its planned route.
Dialogue: 0,1:13:55.47,1:13:58.51,Default,,0,0,0,,Міне, сол танкердің деректерін маған жіберіңіз.
Dialogue: 0,1:13:58.60,1:14:00.47,Default,,0,0,0,,Okay, I'll contact you again.
Dialogue: 0,1:14:00.56,1:14:01.39,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,1:14:02.60,1:14:04.14,Default,,0,0,0,,What happened to the tanker?
Dialogue: 0,1:14:04.23,1:14:07.27,Default,,0,0,0,,It's the letter "she" left by Rachel.
Dialogue: 0,1:14:08.23,1:14:10.77,Default,,0,0,0,,“she” is also a word for “ship”
Dialogue: 0,1:14:17.20,1:14:19.28,Default,,0,0,0,,Is the story on the phone true?
Dialogue: 0,1:14:19.37,1:14:23.54,Default,,0,0,0,,Қазір болып жатқанның бәрі Леон-сенсейдің жоспары.
Dialogue: 0,1:14:23.62,1:14:26.17,Default,,0,0,0,,Мен түсінетіндей етіп түсіндіріп беріңізші.
Dialogue: 0,1:14:27.00,1:14:30.42,Default,,0,0,0,,Шығу тегі - Чонхан Чен ашқан көк сапфир.
Dialogue: 0,1:14:30.50,1:14:31.67,Default,,0,0,0,,Dark Blue Fist
Dialogue: 0,1:14:32.34,1:14:35.17,Default,,0,0,0,,Ол оны каратэден турнир белбеуіне салды.
Dialogue: 0,1:14:35.26,1:14:37.18,Default,,0,0,0,,The prize will be given to the winner.
Dialogue: 0,1:14:37.26,1:14:40.05,Default,,0,0,0,,Леон мырза Джамалуддин мырзаны қатысуға шақырды.
Dialogue: 0,1:14:40.14,1:14:42.31,Default,,0,0,0,,I tried to get the jewel.
Dialogue: 0,1:14:43.02,1:14:45.93,Default,,0,0,0,,However, there was an unexpected twist.
Dialogue: 0,1:14:46.02,1:14:50.52,Default,,0,0,0,,400 каратэ матчында жеңілмеген Киогоку турнирдің нағыз қатысушысы.
Dialogue: 0,1:14:50.61,1:14:54.32,Default,,0,0,0,,Оны шақырған адам өлтірілген Шерилин Тан болды.
Dialogue: 0,1:14:54.90,1:14:58.99,Default,,0,0,0,,Мотив осы болса да, Леон мырзаның алиби бар.
Dialogue: 0,1:14:59.07,1:15:03.04,Default,,0,0,0,,Ол пышақталған кезде басқа лифтте болған.
Dialogue: 0,1:15:03.12,1:15:04.58,Default,,0,0,0,,Міне, шындық
Dialogue: 0,1:15:04.66,1:15:07.04,Default,,0,0,0,,After meeting Leon by the pool
Dialogue: 0,1:15:07.12,1:15:10.96,Default,,0,0,0,,Ол өз бөлмесіне қайту үшін лифтке отырды.
Dialogue: 0,1:15:11.92,1:15:16.22,Default,,0,0,0,,Бірақ ол 3-мұнарада тұрған бөлме 16-қабатта болатын.
Dialogue: 0,1:15:17.13,1:15:21.97,Default,,0,0,0,,Қонақүйдің құрылымына байланысты қайту үшін 34-ші қабаттағы пойыздарды ауыстыруға тура келді.
Dialogue: 0,1:15:22.55,1:15:25.14,Default,,0,0,0,,She was on her way back to her room.
Dialogue: 0,1:15:25.22,1:15:27.89,Default,,0,0,0,,I was taken to another room.
Dialogue: 0,1:15:27.98,1:15:30.65,Default,,0,0,0,,By Rachel the Secretary
Dialogue: 0,1:15:30.73,1:15:34.02,Default,,0,0,0,,Is Rachel an accomplice? Амал жоқ
Dialogue: 0,1:15:34.11,1:15:35.61,Default,,0,0,0,,Leon that day
Dialogue: 0,1:15:35.69,1:15:37.95,Default,,0,0,0,,Тек қонақтарға арналған бассейн жанындағы мейрамханада.
Dialogue: 0,1:15:38.03,1:15:41.41,Default,,0,0,0,,Мен кіру үшін кірген бөлме 34-қабатта болды.
Dialogue: 0,1:15:43.12,1:15:48.00,Default,,0,0,0,,Сол кезде Леон түсіп, сол бөлмеде Шерилинді пышақтап өлтірді.
Dialogue: 0,1:15:49.50,1:15:51.46,Default,,0,0,0,,The body was placed in the trunk.
Dialogue: 0,1:15:51.54,1:15:55.21,Default,,0,0,0,,Кейінірек Рейчел мен Леон бөлек лифттерге отырды.
Dialogue: 0,1:15:56.00,1:15:59.68,Default,,0,0,0,,Менің ойымша, бұл қулық үшін қандай да бір сиқырлы пышақ қолданылған.
Dialogue: 0,1:15:59.76,1:16:02.22,Default,,0,0,0,,Алайда қан Шерилиннің өзіне тиесілі.
Dialogue: 0,1:16:07.06,1:16:09.73,Default,,0,0,0,,Рэйчел пышақталғандай кейіп танытып, құлап қалады.
Dialogue: 0,1:16:11.81,1:16:13.15,Default,,0,0,0,,Осыдан кейін бірден...
Dialogue: 0,1:16:14.44,1:16:15.57,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:16:16.48,1:16:21.36,Default,,0,0,0,,Жарылыс салдарынан электр қуатын өшіру кезінде барлығы жасырын түрде жасалды.
Dialogue: 0,1:16:36.71,1:16:37.75,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:16:38.51,1:16:41.84,Default,,0,0,0,,Рейчел Леонның шынайы жоспарын біледі.
Dialogue: 0,1:16:41.93,1:16:46.39,Default,,0,0,0,,Менің қорыққаным сонша, мен детектив Мориге бәрін жасыруға дайын болдым.
Dialogue: 0,1:16:46.47,1:16:48.27,Default,,0,0,0,,Leon noticed that.
Dialogue: 0,1:16:48.89,1:16:52.39,Default,,0,0,0,,Қоймаға келген Рейчел бетперде киген бала еді.
Dialogue: 0,1:16:52.48,1:16:56.40,Default,,0,0,0,,Леонның жоспарында Кид де қолданылған.
Dialogue: 0,1:16:57.11,1:17:00.03,Default,,0,0,0,,Нағыз Рейчел қазірдің өзінде өлтірілген.
Dialogue: 0,1:17:00.11,1:17:01.86,Default,,0,0,0,,Оны тұғырға итеріп жіберді.
Dialogue: 0,1:17:02.82,1:17:05.37,Default,,0,0,0,,Мен Баланың Рейчел кейпінде келгенін оқыдым.
Dialogue: 0,1:17:05.45,1:17:09.62,Default,,0,0,0,,Әліби құру және оқиғаны Кидтің жұмысына ұқсату.
Dialogue: 0,1:17:10.25,1:17:11.75,Default,,0,0,0,,Бұл қалай болуы мүмкін?
Dialogue: 0,1:17:11.83,1:17:15.17,Default,,0,0,0,,Сонымен, егер сіз Риши болсаңыз, өзіңізді кім ретінде жасыруға қауіпсіз деп ойлайсыз?
Dialogue: 0,1:17:15.25,1:17:17.25,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,1:17:17.34,1:17:21.92,Default,,0,0,0,,Қаншалықты жақсы бүркемелесең де, шынайы нәрсеге тап болсаң, мағынасыз.
Dialogue: 0,1:17:22.01,1:17:25.43,Default,,0,0,0,,Қайда, қай уақытта болатынын алдын ала білетін адам болғаны дұрыс.
Dialogue: 0,1:17:25.51,1:17:29.77,Default,,0,0,0,,Мен көремін. Рейчел Моури мырзамен сағат 15.00-де кездесіп тұрған.
Dialogue: 0,1:17:29.85,1:17:30.72,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:17:30.81,1:17:35.44,Default,,0,0,0,,Иә, Кид қоймаға келмейтін адамның кейпіне енеді.
Dialogue: 0,1:17:35.52,1:17:38.69,Default,,0,0,0,,Осыны оқығаннан кейін мен Леонның тұзағына түсіп қалдым.
Dialogue: 0,1:17:38.77,1:17:39.78,Default,,0,0,0,,Цк
Dialogue: 0,1:17:41.23,1:17:42.24,Default,,0,0,0,,Бізге жақсылап сөйлесу керек!
Dialogue: 0,1:17:42.32,1:17:44.95,Default,,0,0,0,,Мұғалім не істемекші?
Dialogue: 0,1:17:45.03,1:17:47.49,Default,,0,0,0,,Мұның бәрі ақымақ жоспар үшін.
Dialogue: 0,1:17:47.57,1:17:52.00,Default,,0,0,0,,Леон Евгений Лим атты қарақшылар көсемімен байланыста болды.
Dialogue: 0,1:17:52.08,1:17:55.37,Default,,0,0,0,,Рейчелді өлтірген жердегі тұғырда қалдырылған сөздер:
Dialogue: 0,1:17:55.46,1:17:56.42,Default,,0,0,0,,«ол»
Dialogue: 0,1:17:56.50,1:18:00.38,Default,,0,0,0,,Рейчел детектив Мориге жасырын түрде сеніп тапсырған нәрсе
Dialogue: 0,1:18:00.46,1:18:02.01,Default,,0,0,0,,Накатоми Жеткізу медалі
Dialogue: 0,1:18:02.67,1:18:04.55,Default,,0,0,0,,Кемелерге қатысты барлық нәрсе
Dialogue: 0,1:18:04.63,1:18:06.26,Default,,0,0,0,,Мұның не қатысы бар
Dialogue: 0,1:18:06.34,1:18:07.64,Default,,0,0,0,,Mr. Rishi
Dialogue: 0,1:18:07.72,1:18:11.47,Default,,0,0,0,,Мұны маған Токиодан детектив ағам жіберді.
Dialogue: 0,1:18:11.56,1:18:14.98,Default,,0,0,0,,Бұл Накатомиге тиесілі кемелердің осы жердегі маршруттарының талдауы.
Dialogue: 0,1:18:15.85,1:18:19.48,Default,,0,0,0,,Бір танкер жоспарланған бағыттан алыс.
Dialogue: 0,1:18:19.56,1:18:22.73,Default,,0,0,0,,Осылай жалғастырсаңыз, баратын жеріңіз Марина Бей болады.
Dialogue: 0,1:18:23.44,1:18:25.57,Default,,0,0,0,,Леон мырза қарақшыларды пайдаланады.
Dialogue: 0,1:18:25.65,1:18:27.86,Default,,0,0,0,,Мен танкерді қалаға кіргізуді жоспарлап отырмын.
Dialogue: 0,1:18:32.45,1:18:36.62,Default,,0,0,0,,Біріншіден, не үшін мұны істеу керек?
Dialogue: 0,1:18:36.71,1:18:37.67,Default,,0,0,0,,Дәлдік
Dialogue: 0,1:18:38.67,1:18:41.21,Default,,0,0,0,,Леон-санның не айтарын білмеймін.
Dialogue: 0,1:18:41.92,1:18:44.84,Default,,0,0,0,,Егер біз бұл қаланы қиратып, оны қайта тұрғызатын болсақ...
Dialogue: 0,1:18:44.92,1:18:47.84,Default,,0,0,0,,Қомақты ақшаның қозғалатыны сөзсіз.
Dialogue: 0,1:18:48.84,1:18:51.39,Default,,0,0,0,,Леон-сан қара көк жұдырық туралы ерекше айтты.
Dialogue: 0,1:18:51.47,1:18:55.10,Default,,0,0,0,,Қарақшыларды өз қалауыңыз бойынша басқарыңыз, өйткені бұл айырбастау үшін қажет болды.
Dialogue: 0,1:18:55.18,1:19:00.56,Default,,0,0,0,,Бірақ... қарақшылар полициядан жасырынып, жан-жаққа шашылып жатыр.
Dialogue: 0,1:19:00.65,1:19:01.94,Default,,0,0,0,,Менімен қалай хабарластыңыз?
Dialogue: 0,1:19:02.52,1:19:03.94,Default,,0,0,0,,Бұл Мерлион.
Dialogue: 0,1:19:04.03,1:19:07.65,Default,,0,0,0,,Мерлион қызыл суды шашыратқан оқиға болды, солай ма?
Dialogue: 0,1:19:07.74,1:19:11.49,Default,,0,0,0,,Бұл дүние жүзінде жарияланғандықтан, ол қарақшылардың назарын аударған болуы керек.
Dialogue: 0,1:19:11.58,1:19:13.95,Default,,0,0,0,,Бұл жалғастыру сигналы болуы керек.
Dialogue: 0,1:19:14.49,1:19:15.87,Default,,0,0,0,,Бірақ қазір одан да көп
Dialogue: 0,1:19:15.95,1:19:18.08,Default,,0,0,0,,Иә, асықпасаң, кеш болады.
Dialogue: 0,1:19:18.17,1:19:21.04,Default,,0,0,0,,Айтсаң да, бұл менің шешімім.
Dialogue: 0,1:19:21.13,1:19:23.96,Default,,0,0,0,,Полицияны жылжыту үшін бізге қосымша дәлелдер қажет.
Dialogue: 0,1:19:24.05,1:19:25.46,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,1:19:25.55,1:19:26.76,Default,,0,0,0,,Басқа амал жоқ па?
Dialogue: 0,1:19:26.84,1:19:29.68,Default,,0,0,0,,Иә, Чонхан Чен мырзамен сөйлесейік.
Dialogue: 0,1:19:29.76,1:19:32.22,Default,,0,0,0,,Ол әскери және полициямен жұмыс істей алады.
Dialogue: 0,1:19:32.30,1:19:34.47,Default,,0,0,0,,Оның сізге күш беретініне сенімдімін.
Dialogue: 0,1:19:34.56,1:19:35.97,Default,,0,0,0,,Риши мырза, тағы бір нәрсе.
Dialogue: 0,1:19:36.06,1:19:37.48,Default,,0,0,0,,Не?
Dialogue: 0,1:19:37.56,1:19:40.90,Default,,0,0,0,,Егер танкер жоспарланғандай қалаға құласа
Dialogue: 0,1:19:40.98,1:19:43.23,Default,,0,0,0,,Сол кезде Леон мырза қайда болады деп ойлайсыз?
Dialogue: 0,1:19:43.94,1:19:47.15,Default,,0,0,0,,Иә, мұғалім – ұқыпты адам.
Dialogue: 0,1:19:47.24,1:19:49.74,Default,,0,0,0,,Мен оны алыс жерге барып көрейін.
Dialogue: 0,1:19:49.82,1:19:53.16,Default,,0,0,0,,Ол енді елде жоқ шығар.
Dialogue: 0,1:19:53.24,1:19:54.99,Default,,0,0,0,,Олай болса, мен асығамын.
Dialogue: 0,1:19:55.70,1:19:58.00,Default,,0,0,0,,Түсіндім, рахмет
Dialogue: 0,1:20:01.08,1:20:05.75,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,1:20:05.84,1:20:10.68,Default,,0,0,0,,Әке, сіз қайдасыз? Шоу басталғалы жатыр.
Dialogue: 0,1:20:10.76,1:20:13.76,Default,,0,0,0,,Шиничи де бір жерге кетіп қалды.
Dialogue: 0,1:20:16.31,1:20:19.77,Default,,0,0,0,,Неліктен мен бұл оқиғаға қатыстым?
Dialogue: 0,1:20:20.52,1:20:23.27,Default,,0,0,0,,Шерилинді өлтірген жерде менің картамды қалдырған адам —
Dialogue: 0,1:20:23.36,1:20:25.11,Default,,0,0,0,,Бұл шынымен Леон ба?
Dialogue: 0,1:20:25.65,1:20:30.03,Default,,0,0,0,,Жоқ, лифтке жабыстырылған карта табылды.
Dialogue: 0,1:20:30.11,1:20:32.91,Default,,0,0,0,,Көп уақыт өткеннен кейін сайтта тексеру басталды
Dialogue: 0,1:20:32.99,1:20:34.49,Default,,0,0,0,,Жеңіске жетіп, сол адамдардың өмірімен сол жараларды жазайық
Dialogue: 0,1:20:34.57,1:20:35.41,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:20:35.49,1:20:39.41,Default,,0,0,0,,Ой, бұл танкер курсының соңғы талдауы.
Dialogue: 0,1:20:39.50,1:20:40.54,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:42.00,1:20:45.29,Default,,0,0,0,,Не!? Бұл жаман! Бұлай жалғаса берсе, танкер қонақүйге айналады.
Dialogue: 0,1:20:48.67,1:20:53.68,Default,,0,0,0,,(Музыканы көрсету)
Dialogue: 0,1:21:04.02,1:21:05.31,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:21:06.94,1:21:09.57,Default,,0,0,0,,Жүгіріп, телефонға жауап беріңізші.
Dialogue: 0,1:21:51.82,1:21:54.49,Default,,0,0,0,,(Аудитория ағылшын тілі)
Dialogue: 0,1:22:31.61,1:22:33.78,Default,,0,0,0,,(Адамдардың қашып бара жатқан дыбыстары)
Dialogue: 0,1:22:36.86,1:22:39.03,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:22:39.12,1:22:41.62,Default,,0,0,0,,Эй, Ран! Көңіл көтеріп жатырсыз ба?
Dialogue: 0,1:22:41.70,1:22:43.79,Default,,0,0,0,,Әке, қазір қайдасыз?
Dialogue: 0,1:22:43.87,1:22:48.29,Default,,0,0,0,,Иә? Неге екенін білмеймін, бірақ мен үлкен кемені көріп тұрмын.
Dialogue: 0,1:22:48.38,1:22:50.92,Default,,0,0,0,,Әй, сәлем әке.
Dialogue: 0,1:22:51.00,1:22:52.55,Default,,0,0,0,,Қонақ үйдің үстінде ме?
Dialogue: 0,1:22:52.63,1:22:54.55,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,1:22:59.89,1:23:01.26,Default,,0,0,0,,(Евгений Ағылшын тілі)
Dialogue: 0,1:23:01.35,1:23:02.56,Default,,0,0,0,,(бағыныңқы ағылшын тілі)
Dialogue: 0,1:23:02.64,1:23:04.85,Default,,0,0,0,,Соноко мырза Соноко мырза
Dialogue: 0,1:23:05.64,1:23:06.73,Default,,0,0,0,,Не?
Dialogue: 0,1:23:06.81,1:23:08.60,Default,,0,0,0,,Сыртта бірдеңе болған сияқты.
Dialogue: 0,1:23:08.69,1:23:10.40,Default,,0,0,0,,Қонақ үйден шыққаным дұрыс шығар деп ойладым.
Dialogue: 0,1:23:10.48,1:23:14.40,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,1:23:14.48,1:23:15.82,Default,,0,0,0,,Иә
Dialogue: 0,1:23:15.90,1:23:18.20,Default,,0,0,0,,сіз оларды әдейі жеке-жеке сынақтарға қарсы қойып отырсыз ғой?
Dialogue: 0,1:23:18.28,1:23:19.57,Default,,0,0,0,,Кімнен?
Dialogue: 0,1:23:19.66,1:23:20.57,Default,,0,0,0,,Полиция қызметкері
Dialogue: 0,1:23:20.66,1:23:24.12,Default,,0,0,0,,Жаман жолмен шықсаңыз, сізді тағы да нысанаға алуы мүмкін.
Dialogue: 0,1:23:24.20,1:23:25.58,Default,,0,0,0,,Бөлмеде күтіңіз.
Dialogue: 0,1:23:26.41,1:23:28.37,Default,,0,0,0,,Жолсерік келе жатқан сияқты.
Dialogue: 0,1:23:30.08,1:23:31.88,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:23:31.96,1:23:34.80,Default,,0,0,0,,Жарайды, мен осындамын.
Dialogue: 0,1:23:36.30,1:23:37.88,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:23:44.72,1:23:46.39,Default,,0,0,0,,(Адамдардың қашып бара жатқан дыбыстары)
Dialogue: 0,1:23:47.14,1:23:49.89,Default,,0,0,0,,Бұл жаман. Осы топпен мен қонақүйге жақындай алмаймын.
Dialogue: 0,1:23:50.98,1:23:52.44,Default,,0,0,0,,Уайымдамаңыз, бұл бәрі немесе ештеңе емес.
Dialogue: 0,1:23:56.94,1:23:58.61,Default,,0,0,0,,(Ағылшын тілі)
Dialogue: 0,1:23:59.24,1:24:01.61,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:24:03.70,1:24:08.71,Default,,0,0,0,,Эхехехе~ Бұл жеке тапсырыс.
Dialogue: 0,1:24:08.83,1:24:11.75,Default,,0,0,0,,Не? Ах...
Dialogue: 0,1:24:11.83,1:24:14.88,Default,,0,0,0,,Ха! Эй, ұйықтап жатқан Когоро!
Dialogue: 0,1:24:20.09,1:24:22.80,Default,,0,0,0,,(Когороның қорылдауы)
Dialogue: 0,1:24:23.89,1:24:26.14,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:24:28.98,1:24:30.77,Default,,0,0,0,,Жоқ, қосылмаңыз.
Dialogue: 0,1:24:34.48,1:24:35.77,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:24:36.44,1:24:37.78,Default,,0,0,0,,О, тозақ!
Dialogue: 0,1:24:45.33,1:24:48.24,Default,,0,0,0,,Сіз қайдасыз? әке
Dialogue: 0,1:24:51.16,1:24:54.25,Default,,0,0,0,,Хехехехехе...
Dialogue: 0,1:24:54.33,1:24:58.34,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:24:58.42,1:25:04.18,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:25:05.68,1:25:06.51,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:06.60,1:25:08.39,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:25:13.69,1:25:14.65,Default,,0,0,0,,Уф
Dialogue: 0,1:25:16.86,1:25:18.36,Default,,0,0,0,,Сәлем
Dialogue: 0,1:25:18.44,1:25:19.40,Default,,0,0,0,,Қара мысықтар – тек ырым ғой.
Dialogue: 0,1:25:22.07,1:25:22.90,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:25:22.99,1:25:26.45,Default,,0,0,0,,Мен сенің мұндай қабілетің бар екенін білмедім.
Dialogue: 0,1:25:26.53,1:25:28.74,Default,,0,0,0,,Мен де оқып бітіре алмадым.
Dialogue: 0,1:25:30.62,1:25:31.66,Default,,0,0,0,,Риши
Dialogue: 0,1:25:32.37,1:25:34.79,Default,,0,0,0,,Егер бұл орын алса, мен оны сыпайы түрде мойындаймын.
Dialogue: 0,1:25:34.87,1:25:37.17,Default,,0,0,0,,Иә, мұның бәрі менің жоспарым.
Dialogue: 0,1:25:37.25,1:25:39.50,Default,,0,0,0,,Кішкене сөйлесейік.
Dialogue: 0,1:25:39.59,1:25:41.67,Default,,0,0,0,,Мазалаған нәрсені тастаңыз.
Dialogue: 0,1:25:42.67,1:25:45.93,Default,,0,0,0,,Менің ойымша, Леон мырза бір нәрсені дұрыс түсінбеуі мүмкін.
Dialogue: 0,1:25:46.01,1:25:47.18,Default,,0,0,0,,Ha
Dialogue: 0,1:25:47.97,1:25:49.56,Default,,0,0,0,,(әскери үшін ағылшын)
Dialogue: 0,1:25:51.39,1:25:54.56,Default,,0,0,0,,(солдаттың ағылшын тілі)
Dialogue: 0,1:26:11.16,1:26:14.08,Default,,0,0,0,,(Мылтық дыбысы)
Dialogue: 0,1:26:14.16,1:26:16.50,Default,,0,0,0,,Танкер тоқтады! бала
Dialogue: 0,1:26:16.58,1:26:18.17,Default,,0,0,0,,Мұны полицияға қалдырайық.
Dialogue: 0,1:26:18.25,1:26:19.17,Default,,0,0,0,,О
Dialogue: 0,1:26:19.25,1:26:22.01,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:26:22.09,1:26:25.34,Default,,0,0,0,,Әй, тыныш бол, мені атпа.
Dialogue: 0,1:26:25.43,1:26:27.05,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:26:27.14,1:26:28.18,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,1:26:28.76,1:26:31.93,Default,,0,0,0,,Өтінемін, мені өлтірме!
Dialogue: 0,1:26:32.02,1:26:34.81,Default,,0,0,0,,Риши-кун, мен сені атып аламын деп ойламадым.
Dialogue: 0,1:26:35.27,1:26:40.77,Default,,0,0,0,,(ағылшынша әңгіме)
Dialogue: 0,1:26:48.41,1:26:49.32,Default,,0,0,0,,Леон мұғалім
Dialogue: 0,1:26:49.41,1:26:52.83,Default,,0,0,0,,Кешіріңіз, бірақ сіздің дағдыларыңыз аздап солғын емес пе?
Dialogue: 0,1:26:53.54,1:26:55.83,Default,,0,0,0,,Әлемді басқаратын сен емес едің
Dialogue: 0,1:26:59.08,1:27:00.08,Default,,0,0,0,,Мен
Dialogue: 0,1:27:00.96,1:27:03.09,Default,,0,0,0,,Мен саған сенбеймін...
Dialogue: 0,1:27:03.76,1:27:06.55,Default,,0,0,0,,Ал... күте тұрыңыз! Күте тұрыңыз
Dialogue: 0,1:27:06.63,1:27:08.26,Default,,0,0,0,,Мұны сіз үшін жасайық
Dialogue: 0,1:27:08.34,1:27:10.39,Default,,0,0,0,,Ішінде асыл тастар бар.
Dialogue: 0,1:27:10.47,1:27:12.31,Default,,0,0,0,,Бұл жақсы келісім, Риши.
Dialogue: 0,1:27:14.39,1:27:15.68,Default,,0,0,0,,Ах
Dialogue: 0,1:27:22.07,1:27:24.23,Default,,0,0,0,,Нах... Гуаааааааааааааааааааааа
Dialogue: 0,1:27:25.19,1:27:26.74,Default,,0,0,0,,Кайто Кид
Dialogue: 0,1:27:26.82,1:27:30.16,Default,,0,0,0,,А... сен неге мұндасың, Артур?
Dialogue: 0,1:27:30.82,1:27:34.41,Default,,0,0,0,,Менің ойымша, шатырға шығу үшін 34-ші қабаттағы пойыздарды ауыстыруым керек.
Dialogue: 0,1:27:36.12,1:27:38.41,Default,,0,0,0,,(Pirate English)
Dialogue: 0,1:27:49.76,1:27:53.10,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:27:53.68,1:27:57.02,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,1:27:57.10,1:27:58.39,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:27:58.48,1:28:01.94,Default,,0,0,0,,Мен екі қаскүнемді ұстауға тырыстым.
Dialogue: 0,1:28:02.02,1:28:04.52,Default,,0,0,0,,Жаман ойындарды доғар, Риши Раманатан
Dialogue: 0,1:28:05.40,1:28:08.03,Default,,0,0,0,,Мен сендердің ұйымдастырушы екеніңді білемін.
Dialogue: 0,1:28:08.11,1:28:10.20,Default,,0,0,0,,Менің бірінші күмәнім болды
Dialogue: 0,1:28:10.28,1:28:13.16,Default,,0,0,0,,Бұл оқиға орнында қалдырылған Kid хабарламасы.
Dialogue: 0,1:28:13.24,1:28:15.62,Default,,0,0,0,,Полиция қызметкері хабарлама туралы білгенде
Dialogue: 0,1:28:15.70,1:28:19.29,Default,,0,0,0,,Риши, сіз оқиға орнына көп ұзамай келдіңіз.
Dialogue: 0,1:28:19.37,1:28:22.88,Default,,0,0,0,,Мен сізден бұрын Леон мырза қайда болды деп сұрағанымда.
Dialogue: 0,1:28:22.96,1:28:25.04,Default,,0,0,0,,Менің саған деген күдігім шешуші болды.
Dialogue: 0,1:28:25.13,1:28:26.30,Default,,0,0,0,,Не!?
Dialogue: 0,1:28:26.38,1:28:29.47,Default,,0,0,0,,Леон сияқты бос адам
Dialogue: 0,1:28:29.55,1:28:32.80,Default,,0,0,0,,Жоспарымды орындамай тұрып, шетелге қашып кетуге мүмкіндік жоқ.
Dialogue: 0,1:28:33.68,1:28:37.27,Default,,0,0,0,,Сіз ең жақсы көрінісі бар жерге қарап отырған болуыңыз керек.
Dialogue: 0,1:28:37.89,1:28:40.18,Default,,0,0,0,,Мұны байқамау мүмкін емес.
Dialogue: 0,1:28:41.56,1:28:44.61,Default,,0,0,0,,Мен таң қалдым. Бұл мені сынады.
Dialogue: 0,1:28:44.69,1:28:46.19,Default,,0,0,0,,Барлығы 5 жыл бұрын болған
Dialogue: 0,1:28:46.77,1:28:49.69,Default,,0,0,0,,Әкеңіздің апаты сіздің жоспарыңыздың басы болды, солай ма?
Dialogue: 0,1:28:49.78,1:28:54.20,Default,,0,0,0,,«Океанографты өлтіргенін жоққа шығарған күдікті кенеттен кінәсін мойындайды»
Dialogue: 0,1:28:54.99,1:28:56.37,Default,,0,0,0,,Белгілі
Dialogue: 0,1:28:56.45,1:28:57.41,Default,,0,0,0,,Сәлем
Dialogue: 0,1:28:57.49,1:29:01.54,Default,,0,0,0,,Накатоми мырза бес жыл бұрын Сингапурға барды, солай емес пе?
Dialogue: 0,1:29:01.62,1:29:03.21,Default,,0,0,0,,Е, жоқ, мен...
Dialogue: 0,1:29:03.79,1:29:05.67,Default,,0,0,0,,Леон қылмыскерді ұстады.
Dialogue: 0,1:29:05.75,1:29:08.71,Default,,0,0,0,,Шерилин ханым өзін қорғап, оны кінәсін мойындауға мәжбүр етті.
Dialogue: 0,1:29:09.42,1:29:11.22,Default,,0,0,0,,Бұл жай ғана кездейсоқтық деп ойламаймын.
Dialogue: 0,1:29:11.30,1:29:13.13,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:29:13.22,1:29:15.39,Default,,0,0,0,,Танкер Nakatomi Shipping компаниясына тиесілі
Dialogue: 0,1:29:15.47,1:29:17.47,Default,,0,0,0,,Оны алу үшін бұл тұзақ болды.
Dialogue: 0,1:29:18.22,1:29:19.97,Default,,0,0,0,,Барлығы реттелді.
Dialogue: 0,1:29:20.81,1:29:23.94,Default,,0,0,0,,Тағы бір тұзақ болды.
Dialogue: 0,1:29:25.10,1:29:27.07,Default,,0,0,0,,Сіз байқадыңыз, солай ма?
Dialogue: 0,1:29:27.61,1:29:31.11,Default,,0,0,0,,Мен де алғашында оқыс оқиға деп ойладым, бірақ...
Dialogue: 0,1:29:31.19,1:29:33.99,Default,,0,0,0,,Мен мұны әкемнің заттарын сұрыптау кезінде байқадым.
Dialogue: 0,1:29:34.07,1:29:38.49,Default,,0,0,0,,Әкесі су астындағы қирандыларды зерттеп жатыр және кездейсоқ қарақшылар патшасының дәлелін тауып алады.
Dialogue: 0,1:29:38.58,1:29:43.29,Default,,0,0,0,,Біз көк жұдырық ұйықтап жатқан болуы мүмкін суға батқан кемені таптық.
Dialogue: 0,1:29:44.17,1:29:46.75,Default,,0,0,0,,Сондықтан болар алдымен әкені өлтірді.
Dialogue: 0,1:29:46.83,1:29:49.88,Default,,0,0,0,,Әуелі әшекейдің құтқарылуына жол бермеу үшін.
Dialogue: 0,1:29:50.84,1:29:53.38,Default,,0,0,0,,(Ерлер ағылшын)
Dialogue: 0,1:29:55.80,1:29:59.14,Default,,0,0,0,,(Халық ағылшын тілі)
Dialogue: 0,1:29:59.22,1:30:04.02,Default,,0,0,0,,Әкемнің әділдік сезімі күшті болса, маған міндетті түрде көмектесер еді.
Dialogue: 0,1:30:14.24,1:30:17.78,Default,,0,0,0,,Не... Не айтып тұрсың, Леон?
Dialogue: 0,1:30:17.87,1:30:18.87,Default,,0,0,0,,Жібер!
Dialogue: 0,1:30:19.58,1:30:20.41,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:30:21.54,1:30:25.12,Default,,0,0,0,,Риши мырза, сіз бір нәрсені дұрыс түсінбейсіз.
Dialogue: 0,1:30:25.21,1:30:27.29,Default,,0,0,0,,Әкемді өлтірген адам түрмеге түседі.
Dialogue: 0,1:30:27.38,1:30:29.50,Default,,0,0,0,,Мен әкемнің өліміне күмәндандым.
Dialogue: 0,1:30:29.59,1:30:33.30,Default,,0,0,0,,Осы елде саған шәкірт болып, запастағы полиция қызметкері болдым.
Dialogue: 0,1:30:33.38,1:30:36.26,Default,,0,0,0,,Содан кейін мен апатты тергеуге кірістім.
Dialogue: 0,1:30:36.34,1:30:39.30,Default,,0,0,0,,Қорғанысқа жауапты Шерилин Танға жақындау...
Dialogue: 0,1:30:39.39,1:30:43.14,Default,,0,0,0,,Мен Рейдзироның ісін әзіл ретінде пайдаланып Леонды бопсалауға бола ма деп сұрағанымда,
Dialogue: 0,1:30:43.22,1:30:45.18,Default,,0,0,0,,Ол маған оңай айтты.
Dialogue: 0,1:30:45.27,1:30:48.77,Default,,0,0,0,,Ал Рахила, иә, ол арқылы
Dialogue: 0,1:30:48.86,1:30:52.32,Default,,0,0,0,,Барлық ақпаратыңыз ағып кетті.
Dialogue: 0,1:30:52.98,1:30:56.78,Default,,0,0,0,,Олай болса, неге оған Kid ескертуін қойдыңыз?
Dialogue: 0,1:30:56.86,1:30:58.95,Default,,0,0,0,,Маған айта аласыз ба?
Dialogue: 0,1:30:59.03,1:31:03.49,Default,,0,0,0,,Қара көк жұдырық және белгісіз кісі өлтіру ісі
Dialogue: 0,1:31:04.04,1:31:07.29,Default,,0,0,0,,Осы екі затты іліп қойсаң, елес ұры міндетті түрде келеді.
Dialogue: 0,1:31:07.37,1:31:10.21,Default,,0,0,0,,Және олар сіздің жоспарларыңызға кедергі жасайды.
Dialogue: 0,1:31:11.42,1:31:14.59,Default,,0,0,0,,Сол орта мектеп детективінің пайда болуы күтпеген еді, бірақ...
Dialogue: 0,1:31:14.67,1:31:17.59,Default,,0,0,0,,Өз жұмысын жақсы орындады.
Dialogue: 0,1:31:17.68,1:31:21.35,Default,,0,0,0,,Накатоми мырза, сіз ұрлық жасады деп күдіктендіңіз.
Dialogue: 0,1:31:21.43,1:31:26.02,Default,,0,0,0,,Оны Леон құтқарған сияқты, бірақ бұл кездейсоқтық болуы мүмкін бе?
Dialogue: 0,1:31:26.10,1:31:30.90,Default,,0,0,0,,Ойлан, мүмкін соның бәрі...
Dialogue: 0,1:31:30.98,1:31:32.40,Default,,0,0,0,,Ахх!
Dialogue: 0,1:31:32.94,1:31:34.23,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,1:31:34.32,1:31:38.32,Default,,0,0,0,,Эй, сен жақсы зерттедің, Риши-кун.
Dialogue: 0,1:31:38.40,1:31:39.66,Default,,0,0,0,,(шу)
Dialogue: 0,1:31:39.74,1:31:42.58,Default,,0,0,0,,(Когороның есінеу)
Dialogue: 0,1:31:42.66,1:31:46.33,Default,,0,0,0,,Иә? Бұл қайда? Мен сенімдімін...
Dialogue: 0,1:31:46.41,1:31:47.50,Default,,0,0,0,,Әкем
Dialogue: 0,1:31:47.58,1:31:49.17,Default,,0,0,0,,Иә? О
Dialogue: 0,1:31:49.25,1:31:51.96,Default,,0,0,0,,Ой... Уау!
Dialogue: 0,1:31:52.79,1:31:54.55,Default,,0,0,0,,Жүгірді...не!?
Dialogue: 0,1:31:58.93,1:32:00.47,Default,,0,0,0,,Не?
Dialogue: 0,1:32:00.55,1:32:01.55,Default,,0,0,0,,Әкем
Dialogue: 0,1:32:03.64,1:32:04.93,Default,,0,0,0,,А... Жүгіріп кетті...
Dialogue: 0,1:32:06.93,1:32:10.10,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:32:14.15,1:32:15.86,Default,,0,0,0,,Не, балалар?
Dialogue: 0,1:32:17.24,1:32:21.57,Default,,0,0,0,,Енді, Риши-кун, өкінішке орай, кестелер өзгерді.
Dialogue: 0,1:32:21.66,1:32:26.33,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:32:34.09,1:32:36.13,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:32:36.21,1:32:37.26,Default,,0,0,0,,(Pirate English)
Dialogue: 0,1:32:37.34,1:32:39.01,Default,,0,0,0,,Эй... Уау
Dialogue: 0,1:32:39.09,1:32:41.01,Default,,0,0,0,,А... маған көмектесші...
Dialogue: 0,1:32:41.09,1:32:44.80,Default,,0,0,0,,(ағылшынша әңгіме)
Dialogue: 0,1:32:56.77,1:32:58.65,Default,,0,0,0,,Сіздің мақсатыңыз...
Dialogue: 0,1:32:58.73,1:33:02.15,Default,,0,0,0,,Аа... Өте зейінді бала екен.
Dialogue: 0,1:33:02.24,1:33:06.74,Default,,0,0,0,,Дұрыс. Бұл қонақүйде Сузуки Зайбатсудан келген жас келіншек бар.
Dialogue: 0,1:33:06.83,1:33:09.50,Default,,0,0,0,,Егер сіз ұрлап алсаңыз, төлем мөлшері одан да жоғары болады.
Dialogue: 0,1:33:09.58,1:33:12.83,Default,,0,0,0,,Жас ханым эвакуацияланған жоқ па?
Dialogue: 0,1:33:12.92,1:33:14.50,Default,,0,0,0,,Ол әлі де өз бөлмесінде болуы керек.
Dialogue: 0,1:33:14.58,1:33:18.50,Default,,0,0,0,,Мен сізге телефон арқылы бөлмеден шықпаңыз дедім.
Dialogue: 0,1:33:19.30,1:33:20.84,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:33:21.84,1:33:23.59,Default,,0,0,0,,А... Сәлем Макото?
Dialogue: 0,1:33:23.68,1:33:24.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:33:24.59,1:33:25.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:25.72,1:33:27.22,Default,,0,0,0,,Барлық лифттер тоқтатылды.
Dialogue: 0,1:33:27.31,1:33:28.14,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:28.22,1:33:29.85,Default,,0,0,0,,Бұл жерден кетейік
Dialogue: 0,1:33:32.69,1:33:34.27,Default,,0,0,0,,(Pirate English)
Dialogue: 0,1:33:34.81,1:33:36.77,Default,,0,0,0,,(Евгений Ағылшын)
Dialogue: 0,1:33:36.86,1:33:40.44,Default,,0,0,0,,Машин-сан, бұл нені білдіреді?
Dialogue: 0,1:33:46.62,1:33:47.70,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,1:33:47.78,1:33:51.16,Default,,0,0,0,,Соңында бәрі мен елестеткендей болып шығады.
Dialogue: 0,1:33:51.25,1:33:53.54,Default,,0,0,0,,Бұл қала өртеніп, қайта туады.
Dialogue: 0,1:33:54.12,1:34:00.38,Default,,0,0,0,,(Леонның күлкісі)
Dialogue: 0,1:34:01.92,1:34:04.22,Default,,0,0,0,,Сіз оны ешқашан көрмейсіз
Dialogue: 0,1:34:08.01,1:34:09.60,Default,,0,0,0,,(Барлығы жөтеледі)
Dialogue: 0,1:34:09.68,1:34:11.60,Default,,0,0,0,,(Pirate English)
Dialogue: 0,1:34:11.68,1:34:15.60,Default,,0,0,0,,(Қарақшылардың ыңырануы)
Dialogue: 0,1:34:15.69,1:34:17.94,Default,,0,0,0,,Сейя!
Dialogue: 0,1:34:21.48,1:34:23.40,Default,,0,0,0,,- (Когоро) Әй! - (Қарақшы) Әй...
Dialogue: 0,1:34:24.99,1:34:26.16,Default,,0,0,0,,- (Ран) Ах - (Когоро) Уау
Dialogue: 0,1:34:29.91,1:34:30.74,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:34:34.96,1:34:35.96,Default,,0,0,0,,Жеңдер!
Dialogue: 0,1:34:37.79,1:34:39.96,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:34:40.04,1:34:41.67,Default,,0,0,0,,Шин мырза!
Dialogue: 0,1:34:48.39,1:34:51.01,Default,,0,0,0,,Не не не...
Dialogue: 0,1:34:51.10,1:34:52.14,Default,,0,0,0,,(Евгений Ағылшын)
Dialogue: 0,1:34:56.85,1:34:59.52,Default,,0,0,0,,(Соноко) Міне, осында! Келді, келді, келді...
Dialogue: 0,1:35:04.36,1:35:07.53,Default,,0,0,0,,(Чонхан және оның достарының ағылшын тілі)
Dialogue: 0,1:35:07.61,1:35:09.82,Default,,0,0,0,,(Aidan English)
Dialogue: 0,1:35:09.91,1:35:11.91,Default,,0,0,0,,(Джонхан ағылшын тілі)
Dialogue: 0,1:35:11.99,1:35:14.54,Default,,0,0,0,,(Aidan English)
Dialogue: 0,1:35:20.00,1:35:21.75,Default,,0,0,0,,Ура! Қарғыс атқыр...
Dialogue: 0,1:35:22.84,1:35:24.80,Default,,0,0,0,,Ух... аааа
Dialogue: 0,1:35:35.56,1:35:37.44,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,1:35:44.61,1:35:45.65,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:35:45.73,1:35:46.94,Default,,0,0,0,,Ааа
Dialogue: 0,1:35:47.03,1:35:50.41,Default,,0,0,0,,Бұлай жалғаса берсе, қала шынымен де жойылады.
Dialogue: 0,1:35:51.20,1:35:53.62,Default,,0,0,0,,Қарғыс атқыр, жақсырақ жол бар ма?
Dialogue: 0,1:35:55.70,1:35:58.54,Default,,0,0,0,,Сіз мұны пайдалана аласыз!
Dialogue: 0,1:35:58.62,1:35:59.62,Default,,0,0,0,,Бала
Dialogue: 0,1:36:01.79,1:36:03.29,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,1:36:03.38,1:36:04.46,Default,,0,0,0,,Әрине
Dialogue: 0,1:36:07.92,1:36:09.34,Default,,0,0,0,,(Pirate English)
Dialogue: 0,1:36:09.43,1:36:10.34,Default,,0,0,0,,(Евгений Ағылшын)
Dialogue: 0,1:36:12.09,1:36:15.01,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:36:15.10,1:36:17.02,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:36:17.68,1:36:21.52,Default,,0,0,0,,Эй, біз бұл операцияны бастамас бұрын, қарақшылар туралы бірдеңе жасауымыз керек.
Dialogue: 0,1:36:21.60,1:36:23.98,Default,,0,0,0,,Тағы бір Трамп мылтығы
Dialogue: 0,1:36:24.06,1:36:26.15,Default,,0,0,0,,Ол әлі де бар, солай емес пе?
Dialogue: 0,1:36:29.78,1:36:32.16,Default,,0,0,0,,Бір рет кері қайтарудың құпиясы
Dialogue: 0,1:36:32.24,1:36:34.16,Default,,0,0,0,,Ха, түсіндім.
Dialogue: 0,1:36:34.24,1:36:35.99,Default,,0,0,0,,Мен асығыс кіремін.
Dialogue: 0,1:36:36.66,1:36:37.79,Default,,0,0,0,,(Pirate English)
Dialogue: 0,1:36:38.62,1:36:39.46,Default,,0,0,0,,Ик!
Dialogue: 0,1:36:42.00,1:36:43.21,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:36:47.80,1:36:51.09,Default,,0,0,0,,(Қарақшылардың ыңырануы)
Dialogue: 0,1:36:52.80,1:36:56.35,Default,,0,0,0,,Ахх...
Dialogue: 0,1:36:56.43,1:36:57.60,Default,,0,0,0,,Макото мырза
Dialogue: 0,1:37:00.68,1:37:02.27,Default,,0,0,0,,(Евгений Ағылшын тілі)
Dialogue: 0,1:37:03.94,1:37:05.11,Default,,0,0,0,,(Джамалуддиннің ағылшын тілі)
Dialogue: 0,1:37:12.74,1:37:13.86,Default,,0,0,0,,Бала
Dialogue: 0,1:37:13.95,1:37:15.62,Default,,0,0,0,,Мені садаққа апарыңыз
Dialogue: 0,1:37:15.70,1:37:17.74,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,1:37:17.83,1:37:18.74,Default,,0,0,0,,Уау!
Dialogue: 0,1:37:22.92,1:37:24.38,Default,,0,0,0,,Жүгір, артта қал.
Dialogue: 0,1:37:25.92,1:37:27.63,Default,,0,0,0,,Жүгірдім!
Dialogue: 0,1:37:27.71,1:37:28.63,Default,,0,0,0,,Ha
Dialogue: 0,1:37:31.47,1:37:33.80,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:37:41.64,1:37:44.27,Default,,0,0,0,,Ах, Джентл!
Dialogue: 0,1:37:45.02,1:37:47.61,Default,,0,0,0,,Уау! Uga...
Dialogue: 0,1:37:47.69,1:37:50.40,Default,,0,0,0,,Қарғыс атсын... Не болып жатыр?
Dialogue: 0,1:37:50.48,1:37:52.78,Default,,0,0,0,,Шиничидің дауысы
Dialogue: 0,1:37:52.86,1:37:54.36,Default,,0,0,0,,Әпке, амансыз ба?
Dialogue: 0,1:37:54.45,1:37:56.62,Default,,0,0,0,,Артур, сен мұнда не үшін келдің?
Dialogue: 0,1:37:56.70,1:37:59.62,Default,,0,0,0,,А... Мен апамды уайымдап жүрмін.
Dialogue: 0,1:38:00.24,1:38:01.50,Default,,0,0,0,,Рахмет
Dialogue: 0,1:38:02.50,1:38:05.12,Default,,0,0,0,,Ол қазір қайда?
Dialogue: 0,1:38:06.58,1:38:07.59,Default,,0,0,0,,Я...
Dialogue: 0,1:38:07.67,1:38:09.09,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,1:38:10.09,1:38:11.80,Default,,0,0,0,,(Евгений Ағылшын)
Dialogue: 0,1:38:15.76,1:38:16.80,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,1:38:16.89,1:38:19.68,Default,,0,0,0,,(Джамалуддиннің айқайы)
Dialogue: 0,1:38:21.10,1:38:21.93,Default,,0,0,0,,Шин мырза
Dialogue: 0,1:38:22.81,1:38:26.44,Default,,0,0,0,,(Евгений Ағылшын)
Dialogue: 0,1:38:26.52,1:38:27.98,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:38:41.54,1:38:42.45,Default,,0,0,0,,Ах
Dialogue: 0,1:38:44.54,1:38:45.83,Default,,0,0,0,,Сіз ойладыңыз ба?
Dialogue: 0,1:38:45.92,1:38:48.33,Default,,0,0,0,,- (Соноко) Кя! -(Кёгоку) Жарайды, Соноко-сан.
Dialogue: 0,1:38:48.42,1:38:49.59,Default,,0,0,0,,- (Кёгоку) Уф! -(Соноко) Кя!
Dialogue: 0,1:38:52.67,1:38:57.30,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,1:38:57.38,1:38:58.47,Default,,0,0,0,,Сәлем
Dialogue: 0,1:39:06.60,1:39:10.52,Default,,0,0,0,,(Қарақшылар ағылшын тілі)
Dialogue: 0,1:39:11.98,1:39:13.73,Default,,0,0,0,,Макотоның қаны
Dialogue: 0,1:39:14.36,1:39:15.90,Default,,0,0,0,,Соноко-сан, кешіріңіз.
Dialogue: 0,1:39:16.78,1:39:19.03,Default,,0,0,0,,Не? О, күтіңіз, не істеп жатырсыз?
Dialogue: 0,1:39:19.11,1:39:21.78,Default,,0,0,0,,Осындай жерде... Макото мырза?
Dialogue: 0,1:39:21.87,1:39:24.29,Default,,0,0,0,,Жоқ, не? Ах
Dialogue: 0,1:39:27.04,1:39:28.83,Default,,0,0,0,,Артқы түйін
Dialogue: 0,1:39:28.92,1:39:31.42,Default,,0,0,0,,Соноко-сан, бұл жолы, сөзсіз...
Dialogue: 0,1:39:32.42,1:39:34.17,Default,,0,0,0,,Кетпеңіз
Dialogue: 0,1:39:34.25,1:39:35.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:39:35.59,1:39:39.18,Default,,0,0,0,,Мен сені қаласам да тастап кете алмаймын, бірақ...
Dialogue: 0,1:39:43.26,1:39:46.68,Default,,0,0,0,,Увааааааааааааааааааааааааа
Dialogue: 0,1:39:46.77,1:39:48.60,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:39:48.69,1:39:49.60,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,1:39:56.99,1:40:00.36,Default,,0,0,0,,(Соноконың айқайы)
Dialogue: 0,1:40:13.38,1:40:17.26,Default,,0,0,0,,Ууууууу...
Dialogue: 0,1:40:22.68,1:40:23.93,Default,,0,0,0,,(Джамалуддин Ағылшын тілі)
Dialogue: 0,1:40:27.56,1:40:29.81,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,1:40:31.52,1:40:34.19,Default,,0,0,0,,Сеияаааааааааааа!
Dialogue: 0,1:40:34.27,1:40:39.36,Default,,0,0,0,,(Қарақшылар айқайлайды)
Dialogue: 0,1:40:45.20,1:40:50.21,Default,,0,0,0,,(Соноконың айқайы)
Dialogue: 0,1:40:52.54,1:40:55.42,Default,,0,0,0,,Кёгоку-сан, бірдеңені ұстап тұр.
Dialogue: 0,1:41:12.52,1:41:13.94,Default,,0,0,0,,Жоооу!
Dialogue: 0,1:41:35.92,1:41:38.59,Default,,0,0,0,,О... у...
Dialogue: 0,1:41:38.67,1:41:39.92,Default,,0,0,0,,(Aidan English)
Dialogue: 0,1:41:50.85,1:41:52.27,Default,,0,0,0,,Мен оны қайтарамын
Dialogue: 0,1:41:54.19,1:41:58.36,Default,,0,0,0,,Мен іздеген асыл тас бұл емес еді.
Dialogue: 0,1:42:06.87,1:42:10.24,Default,,0,0,0,,Соноко-сан, осында сәл отырыңызшы.
Dialogue: 0,1:42:10.87,1:42:14.87,Default,,0,0,0,,Кешіріңіз, мен оны тым қатты байладым.
Dialogue: 0,1:42:19.67,1:42:22.01,Default,,0,0,0,,A, ол жойылды.
Dialogue: 0,1:42:22.09,1:42:23.38,Default,,0,0,0,,Уф...
Dialogue: 0,1:42:23.47,1:42:28.68,Default,,0,0,0,,Жоқ, бұл сол бойтұмар...дәлірек айтсақ...
Dialogue: 0,1:42:28.76,1:42:31.01,Default,,0,0,0,,Сіз мұны үнемі киіп жүрдіңіз бе?
Dialogue: 0,1:42:31.93,1:42:36.85,Default,,0,0,0,,Иә, мен мұны айта алмадым, өйткені ол адам бас тартады деп ойладым.
Dialogue: 0,1:42:37.40,1:42:40.82,Default,,0,0,0,,Не? Мен сені әрқашан қорғайды деп ойладым.
Dialogue: 0,1:42:41.61,1:42:44.78,Default,,0,0,0,,Мен Макотоны қорғадым, солай ма?
Dialogue: 0,1:42:45.82,1:42:47.20,Default,,0,0,0,,Хехе
Dialogue: 0,1:42:52.24,1:42:53.75,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,1:42:53.83,1:42:55.41,Default,,0,0,0,,Маған таңғышты қайтарып беріңізші.
Dialogue: 0,1:42:55.50,1:42:57.04,Default,,0,0,0,,- (Соноко) Даме - (Кёгоку) Өтінемін
Dialogue: 0,1:42:57.12,1:42:59.33,Default,,0,0,0,,Оны өмір бойы бағалаңыз
Dialogue: 0,1:42:59.42,1:43:00.79,Default,,0,0,0,,Махаббат махаббат
Dialogue: 0,1:43:08.39,1:43:12.06,Default,,0,0,0,,Ха, сен кімсің?
Dialogue: 0,1:43:12.81,1:43:15.10,Default,,0,0,0,,Ол жай ғана бала емес, солай ма?
Dialogue: 0,1:43:16.94,1:43:19.98,Default,,0,0,0,,Конан Эдогава детективі
Dialogue: 0,1:43:21.77,1:43:26.78,Default,,0,0,0,,♪～
Dialogue: 0,1:47:05.29,1:47:10.17,Default,,0,0,0,,～♪
Dialogue: 0,1:47:13.55,1:47:14.67,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,1:47:14.76,1:47:18.51,Default,,0,0,0,,Мен сол мықты жігітті Америкаға қайта жібердім.
Dialogue: 0,1:47:18.59,1:47:19.68,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,1:47:19.76,1:47:23.18,Default,,0,0,0,,Макото-сан бір жерде соғысуы керек.
Dialogue: 0,1:47:24.77,1:47:26.69,Default,,0,0,0,,О, шықты.
Dialogue: 0,1:47:26.77,1:47:28.19,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,1:47:28.27,1:47:32.19,Default,,0,0,0,,Әй, бір-біріңе тым жақындамаңдар.
Dialogue: 0,1:47:32.27,1:47:35.32,Default,,0,0,0,,Дай, мен сені енді ешқашан жібермеймін.
Dialogue: 0,1:47:35.40,1:47:37.20,Default,,0,0,0,,Иә? (түрту дыбысы)
Dialogue: 0,1:47:38.07,1:47:40.53,Default,,0,0,0,,Мен сені көптен бері күттім
Dialogue: 0,1:47:40.66,1:47:41.74,Default,,0,0,0,,Осы сәт!
Dialogue: 0,1:47:41.83,1:47:42.74,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,1:47:43.41,1:47:45.33,Default,,0,0,0,,Бала мен сені күттім!
Dialogue: 0,1:47:45.41,1:47:46.87,Default,,0,0,0,,Иә? Шынайы ма?
Dialogue: 0,1:47:46.96,1:47:50.29,Default,,0,0,0,,Мен сіздің Шиничи емес екеніңізді басынан-ақ білдім.
Dialogue: 0,1:47:50.38,1:47:52.38,Default,,0,0,0,,Шиничи, сенің әкең туралы.
Dialogue: 0,1:47:52.46,1:47:54.21,Default,,0,0,0,,Мен сені «қарт» демеймін.
Dialogue: 0,1:47:54.30,1:47:56.21,Default,,0,0,0,,Иә? Өйткені ол әрқашан...
Dialogue: 0,1:47:57.13,1:48:00.59,Default,,0,0,0,,Айтпақшы, мен сені Ранның алдында ағай деп айтқан емеспін.
Dialogue: 0,1:48:00.68,1:48:03.72,Default,,0,0,0,,Мен саған бір емес, екі рет Шиничиге айналуға рұқсат бермеймін.
Dialogue: 0,1:48:03.81,1:48:06.60,Default,,0,0,0,,Жас ханым, бұл қолды ешқашан жібермеңіз.
Dialogue: 0,1:48:07.23,1:48:08.56,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,1:48:08.64,1:48:10.77,Default,,0,0,0,,Уау!
Dialogue: 0,1:48:14.82,1:48:16.99,Default,,0,0,0,,Мен сені ешқашан жібермеймін
Dialogue: 0,1:48:17.07,1:48:18.74,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,1:48:20.03,1:48:21.16,Default,,0,0,0,,Dr.
Dialogue: 0,1:48:22.62,1:48:24.74,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,1:48:27.87,1:48:29.25,Default,,0,0,0,,Онда жоқ.
Dialogue: 0,1:48:32.08,1:48:34.09,Default,,0,0,0,,О, қазірдің өзінде! Мен қашып құтыла алдым
Dialogue: 0,1:48:34.17,1:48:37.01,Default,,0,0,0,,Шүкір, ол әлі жақын жерде болуы керек.
Dialogue: 0,1:48:37.09,1:48:39.09,Default,,0,0,0,,(Кристи) Ах! (Нат) Ах…
Dialogue: 0,1:48:40.84,1:48:42.09,Default,,0,0,0,,Я...
Dialogue: 0,1:48:43.85,1:48:45.85,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:48:45.93,1:48:48.27,Default,,0,0,0,,Қош келдіңіз Ран-ничан
Dialogue: 0,1:48:49.27,1:48:50.27,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:48:51.69,1:48:53.27,Default,,0,0,0,,Сіз жалғыз емес пе едіңіз?
Dialogue: 0,1:48:54.23,1:48:57.82,Default,,0,0,0,,Барлоу Біз мәңгі бірге болдық.
Dialogue: 0,1:48:59.32,1:49:05.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory