Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.03,0:00:34.60,Default,,0,0,0,,А? Не? Бұл тұман
Dialogue: 0,0:00:34.96,0:00:37.30,Default,,0,0,0,,Ах, бұл шығу.
Dialogue: 0,0:00:41.70,0:00:42.63,Default,,0,0,0,,Уау
Dialogue: 0,0:00:42.70,0:00:44.46,Default,,0,0,0,,Уф, ауырды…
Dialogue: 0,0:00:44.60,0:00:46.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:46.16,0:00:47.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:48.66,0:00:51.10,Default,,0,0,0,,Мектептің артындағы тауда емес...
Dialogue: 0,0:00:52.53,0:00:54.50,Default,,0,0,0,,Қайда? Мұнда...
Dialogue: 0,0:00:57.83,0:01:00.90,Default,,0,0,0,,Мен ол жерде ешқашан болған емеспін, ешқашан көрген емеспін.
Dialogue: 0,0:01:01.93,0:01:05.09,Default,,0,0,0,,Иә, бұл арман
Dialogue: 0,0:01:05.23,0:01:07.56,Default,,0,0,0,,Түсіңізде ме?
Dialogue: 0,0:01:07.66,0:01:10.83,Default,,0,0,0,,Егер бұл арман болса, мен бәрібір жақсырақ түс көргім келеді.
Dialogue: 0,0:01:10.93,0:01:14.50,Default,,0,0,0,,Оян, оян, оян, оян, оян
Dialogue: 0,0:01:14.60,0:01:17.93,Default,,0,0,0,,Уф... Мен оянбаймын!
Dialogue: 0,0:01:18.06,0:01:20.76,Default,,0,0,0,,Бірақ бұл ауырады!
Dialogue: 0,0:01:21.50,0:01:25.10,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:01:25.76,0:01:30.76,Default,,0,0,0,,♪〜
Dialogue: 0,0:02:33.06,0:02:38.06,Default,,0,0,0,,〜♪
Dialogue: 0,0:02:38.16,0:02:42.00,Default,,0,0,0,,Дораемон! Бірдеңе істе, эй, эй
Dialogue: 0,0:02:42.23,0:02:44.16,Default,,0,0,0,,Уау~ Уау
Dialogue: 0,0:02:44.26,0:02:46.33,Default,,0,0,0,,Ау, ауырып тұр!
Dialogue: 0,0:02:46.43,0:02:49.83,Default,,0,0,0,,Қараңғы, ауырады, қауіпті!
Dialogue: 0,0:02:50.50,0:02:52.60,Default,,0,0,0,,Иә? иә? сөйлейтін дауыс
Dialogue: 0,0:02:54.90,0:02:58.06,Default,,0,0,0,,Әй, тезірек үйге қайтайық.
Dialogue: 0,0:02:58.16,0:03:02.06,Default,,0,0,0,,Не? Мен аңдыған орманды зерттеуге келдім.
Dialogue: 0,0:03:02.23,0:03:03.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:03.83,0:03:06.03,Default,,0,0,0,,Бірақ шынымен де елес болса...
Dialogue: 0,0:03:06.33,0:03:07.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:07.13,0:03:08.56,Default,,0,0,0,,Бұл ырым
Dialogue: 0,0:03:08.66,0:03:11.40,Default,,0,0,0,,Бүгін кешке біз шынайы тұлғаны анықтаймыз.
Dialogue: 0,0:03:11.53,0:03:12.90,Default,,0,0,0,,Сәлем! Ах
Dialogue: 0,0:03:13.00,0:03:14.73,Default,,0,0,0,,Балалар! Ахх
Dialogue: 0,0:03:14.83,0:03:16.40,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:03:16.50,0:03:17.50,Default,,0,0,0,,Әке
Dialogue: 0,0:03:17.56,0:03:19.50,Default,,0,0,0,,Қазір үйге қайт.
Dialogue: 0,0:03:19.56,0:03:21.03,Default,,0,0,0,,Иә
Dialogue: 0,0:03:22.06,0:03:23.40,Default,,0,0,0,,Мен бір күні тағы келемін.
Dialogue: 0,0:03:23.53,0:03:25.46,Default,,0,0,0,,Менің ойымша, Чиппо барлығын шақырды.
Dialogue: 0,0:03:25.56,0:03:26.90,Default,,0,0,0,,Ол үмітсіз бала.
Dialogue: 0,0:03:28.73,0:03:30.13,Default,,0,0,0,,Біртүрлі түс
Dialogue: 0,0:03:33.73,0:03:34.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:35.73,0:03:37.53,Default,,0,0,0,,Не? бұл гүл
Dialogue: 0,0:03:38.03,0:03:39.33,Default,,0,0,0,,Әй, отты бәліштер!
Dialogue: 0,0:03:40.63,0:03:43.03,Default,,0,0,0,,Аа, күте тұрыңыз, маған жарық керек.
Dialogue: 0,0:03:43.13,0:03:45.80,Default,,0,0,0,,Эй, күт!
Dialogue: 0,0:03:47.56,0:03:49.70,Default,,0,0,0,,Ха! Ой... аа
Dialogue: 0,0:03:50.40,0:03:51.96,Default,,0,0,0,,Бұрынғы Мояда
Dialogue: 0,0:03:52.13,0:03:53.20,Default,,0,0,0,,Түстен ояну
Dialogue: 0,0:03:53.63,0:03:55.73,Default,,0,0,0,,Осыны ойласам, ұйқым қаша бастады.
Dialogue: 0,0:04:09.63,0:04:12.63,Default,,0,0,0,,Нобита-кун Нобита-кун, оян!
Dialogue: 0,0:04:13.86,0:04:15.53,Default,,0,0,0,,Оян
Dialogue: 0,0:04:15.63,0:04:17.03,Default,,0,0,0,,Уф... иә?
Dialogue: 0,0:04:17.13,0:04:19.06,Default,,0,0,0,,Осындай жерде ұйықтаңыз
Dialogue: 0,0:04:19.13,0:04:21.56,Default,,0,0,0,,Өйткені мен мүлдем ұйықтамаймын.
Dialogue: 0,0:04:21.63,0:04:23.26,Default,,0,0,0,,Мен сабаққа кешігіп барамын
Dialogue: 0,0:04:23.36,0:04:24.06,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:26.20,0:04:28.03,Default,,0,0,0,,Мен біртүрлі түс көрдім
Dialogue: 0,0:04:28.46,0:04:29.96,Default,,0,0,0,,Қандай арман?
Dialogue: 0,0:04:30.73,0:04:34.63,Default,,0,0,0,,Мен терең орманда жалғыз жүрген кезім.
Dialogue: 0,0:04:34.76,0:04:36.80,Default,,0,0,0,,Мен сенің сөйлескеніңді естимін.
Dialogue: 0,0:04:36.93,0:04:38.20,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:04:38.43,0:04:40.80,Default,,0,0,0,,Хухахаха! Гуфу Ахахха...
Dialogue: 0,0:04:40.93,0:04:43.26,Default,,0,0,0,,Бұл шынымен де біртүрлі ме?
Dialogue: 0,0:04:43.63,0:04:47.23,Default,,0,0,0,,«Ит полициясының қызметкері»
Dialogue: 0,0:04:47.30,0:04:49.63,Default,,0,0,0,,Бұл суретті кітап әлеміне ұқсамайды.
Dialogue: 0,0:04:49.76,0:04:51.46,Default,,0,0,0,,Ахахаха...! (Нобита) Хмф!
Dialogue: 0,0:04:51.56,0:04:53.93,Default,,0,0,0,,Уфуфуфухаха...
Dialogue: 0,0:04:54.03,0:04:55.30,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:04:56.06,0:04:57.30,Default,,0,0,0,,Мені мазақ ет!
Dialogue: 0,0:04:58.40,0:05:01.10,Default,,0,0,0,,Фухахахаха! Ахахаха!
Dialogue: 0,0:05:01.20,0:05:02.76,Default,,0,0,0,,Хаха хаха хаха
Dialogue: 0,0:05:02.86,0:05:05.13,Default,,0,0,0,,Нобитаға ұқсайды.
Dialogue: 0,0:05:05.20,0:05:06.83,Default,,0,0,0,,Нобита-чан сүйкімді
Dialogue: 0,0:05:06.93,0:05:08.20,Default,,0,0,0,,Гахахаха... (Нобита) Мен
Dialogue: 0,0:05:08.33,0:05:10.36,Default,,0,0,0,,Көргім келгендіктен көрмедім.
Dialogue: 0,0:05:10.50,0:05:13.60,Default,,0,0,0,,Түс көрген адамның зиялылық деңгейін көрсетеді.
Dialogue: 0,0:05:13.93,0:05:17.13,Default,,0,0,0,,Басқаша айтқанда, Нобита балабақшамен тең.
Dialogue: 0,0:05:17.20,0:05:19.36,Default,,0,0,0,,Мен не істерімді білмеймін (Сунео) Иә.
Dialogue: 0,0:05:19.50,0:05:21.20,Default,,0,0,0,,Токио күмбезінде... (Нобита) Ғұн
Dialogue: 0,0:05:21.30,0:05:23.36,Default,,0,0,0,,Мен бәрібір балабақшадамын.
Dialogue: 0,0:05:23.46,0:05:24.86,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:05:25.36,0:05:27.00,Default,,0,0,0,,Токио күмбезінде не болды?
Dialogue: 0,0:05:27.13,0:05:30.86,Default,,0,0,0,,Мен өз баяндамамды лық толы аудитория алдында бердім.
Dialogue: 0,0:05:30.96,0:05:34.96,Default,,0,0,0,,Міне, ду қол шапалақтау, қошемет көрсету.
Dialogue: 0,0:05:35.03,0:05:36.96,Default,,0,0,0,,Хахаха бұл түс болғанына қуаныштымын
Dialogue: 0,0:05:37.03,0:05:39.26,Default,,0,0,0,,Иә? Жоқ... Бұл не? Эй
Dialogue: 0,0:05:39.36,0:05:40.93,Default,,0,0,0,,Жоқ, бұл таңқаларлық.
Dialogue: 0,0:05:41.43,0:05:42.86,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:05:43.16,0:05:46.86,Default,,0,0,0,,Менің қызғанышым сонша, суретті кітаптар сияқты армандарым болады.
Dialogue: 0,0:05:46.96,0:05:48.80,Default,,0,0,0,,Тіпті Шизука-чан да мені алып кетеді...
Dialogue: 0,0:05:48.86,0:05:50.86,Default,,0,0,0,,Жоқ, Нобита-сан (Нобита) иә?
Dialogue: 0,0:05:51.46,0:05:54.50,Default,,0,0,0,,Мен әрқашан осындай арман көргім келетін
Dialogue: 0,0:05:54.60,0:05:55.83,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:56.00,0:05:57.80,Default,,0,0,0,,Кейде мен армандаймын.
Dialogue: 0,0:05:57.86,0:06:01.86,Default,,0,0,0,,Жануарлармен сөйлесу қандай тамаша болар еді.
Dialogue: 0,0:06:03.23,0:06:06.26,Default,,0,0,0,,(Нобитаның гуілдеуі)
Dialogue: 0,0:06:06.40,0:06:08.33,Default,,0,0,0,,Мен үйдемін! Анашым!
Dialogue: 0,0:06:10.03,0:06:11.73,Default,,0,0,0,,Анаға арналған тағамдар! а?
Dialogue: 0,0:06:12.26,0:06:13.86,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:06:15.83,0:06:16.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:17.66,0:06:20.06,Default,,0,0,0,,Мынау... мынау... мынау гүл.
Dialogue: 0,0:06:21.16,0:06:23.90,Default,,0,0,0,,Жаса... істе... Дораемон!
Dialogue: 0,0:06:25.36,0:06:27.90,Default,,0,0,0,,Осының ішінде от ұшып бара жатқан.
Dialogue: 0,0:06:28.40,0:06:30.90,Default,,0,0,0,,Сонда бұл арман емес пе?
Dialogue: 0,0:06:31.00,0:06:32.20,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:06:32.26,0:06:36.00,Default,,0,0,0,,Сіз шынымен сөйлейтін жануарлар әлеміне бардыңыз ба?
Dialogue: 0,0:06:36.10,0:06:36.86,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:06:37.40,0:06:39.33,Default,,0,0,0,,Ешқандай құралдарды қолданбай?
Dialogue: 0,0:06:39.43,0:06:41.70,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:06:42.06,0:06:44.60,Default,,0,0,0,,Нобита-кун, ешкімге айтпа.
Dialogue: 0,0:06:44.70,0:06:46.60,Default,,0,0,0,,Өйткені мені одан сайын мазақ етеді
Dialogue: 0,0:06:46.73,0:06:48.76,Default,,0,0,0,,Өйткені бұл гүл...
Dialogue: 0,0:06:48.86,0:06:51.93,Default,,0,0,0,,Жартылай ұйықтап жатқанда арғы таудан алып кетпедің бе?
Dialogue: 0,0:06:52.03,0:06:53.26,Default,,0,0,0,,Ех~ Аа...
Dialogue: 0,0:06:55.36,0:06:58.66,Default,,0,0,0,,Қызық, арғы тауда осындай гүл жайқалып тұр ма еді?
Dialogue: 0,0:07:08.83,0:07:10.16,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:07:10.26,0:07:12.50,Default,,0,0,0,,Бұл өте қорқынышты оқиға (Нобита) Иә?
Dialogue: 0,0:07:12.83,0:07:14.50,Default,,0,0,0,,Бұл ананың дауысы
Dialogue: 0,0:07:15.16,0:07:17.90,Default,,0,0,0,,Мен оны одан әрі дамытып жатқаныма сене алмаймын.
Dialogue: 0,0:07:18.00,0:07:19.33,Default,,0,0,0,,Эй (әйел) Иә.
Dialogue: 0,0:07:19.43,0:07:22.76,Default,,0,0,0,,Бұл аймақ аз уақыт ішінде толығымен өзгерді.
Dialogue: 0,0:07:22.83,0:07:26.90,Default,,0,0,0,,Бала кезімде біз тәтті балық аулайтын едік.
Dialogue: 0,0:07:27.13,0:07:28.83,Default,,0,0,0,,Сондай-ақ өрт сөндірушілер де болды.
Dialogue: 0,0:07:28.93,0:07:31.63,Default,,0,0,0,,Жасыл түс азайып барады.
Dialogue: 0,0:07:32.13,0:07:34.60,Default,,0,0,0,,Сонда бұл тау не болады?
Dialogue: 0,0:07:34.83,0:07:39.06,Default,,0,0,0,,Шамасы, олар бәрін қиратып, гольф алаңына айналдыруды жоспарлап отыр.
Dialogue: 0,0:07:39.40,0:07:40.46,Default,,0,0,0,,Иә
Dialogue: 0,0:07:40.56,0:07:42.66,Default,,0,0,0,,Бұл таңғаларлық оқиға.
Dialogue: 0,0:07:42.83,0:07:46.80,Default,,0,0,0,,Барлық көршілес бірлестіктер күш біріктіріп, наразылық қозғалысын бастайық.
Dialogue: 0,0:07:46.90,0:07:49.10,Default,,0,0,0,,Алдымен қол жинау
Dialogue: 0,0:07:49.16,0:07:51.16,Default,,0,0,0,,Мына тауды кесу
Dialogue: 0,0:07:51.26,0:07:52.80,Default,,0,0,0,,Мен оны кешіре алмаймын.
Dialogue: 0,0:07:54.60,0:07:58.26,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:08:01.56,0:08:05.50,Default,,0,0,0,,Ха, тездетіп қол жинау керек. Бұл үлкен жұмыс.
Dialogue: 0,0:08:07.30,0:08:09.90,Default,,0,0,0,,Қош келдіңіз анашым, еңбегіңіз үшін рахмет.
Dialogue: 0,0:08:10.00,0:08:10.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.90,0:08:12.96,Default,,0,0,0,,Оппозициялық қозғалысқа сәттілік
Dialogue: 0,0:08:13.06,0:08:15.00,Default,,0,0,0,,Мен сізге көмектесетін нәрсе бар ма?
Dialogue: 0,0:08:15.06,0:08:18.06,Default,,0,0,0,,Ноби-чан, көп уайымдама
Dialogue: 0,0:08:18.20,0:08:20.73,Default,,0,0,0,,Үй тапсырмасын дұрыс орында
Dialogue: 0,0:08:21.30,0:08:24.40,Default,,0,0,0,,Және бұл басқа мәселе деп ойлаймын.
Dialogue: 0,0:08:24.53,0:08:25.53,Default,,0,0,0,,Анашым
Dialogue: 0,0:08:25.90,0:08:27.50,Default,,0,0,0,,Бұл гүл қайда болды?
Dialogue: 0,0:08:28.03,0:08:30.46,Default,,0,0,0,,А, бүгін таңертең бөлмеңнің алдына құлап түсті.
Dialogue: 0,0:08:31.06,0:08:33.16,Default,,0,0,0,,Менің бөлмемнің алдында?
Dialogue: 0,0:08:35.90,0:08:39.90,Default,,0,0,0,,(Ит айқайлайды)
Dialogue: 0,0:08:43.06,0:08:47.06,Default,,0,0,0,,(Нобитаның қорылдауы)
Dialogue: 0,0:09:06.03,0:09:08.10,Default,,0,0,0,,Анам зәр шығару
Dialogue: 0,0:09:26.76,0:09:29.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:30.13,0:09:34.13,Default,,0,0,0,,(зәр шығару дыбысы)
Dialogue: 0,0:09:35.86,0:09:36.60,Default,,0,0,0,,Хойёо
Dialogue: 0,0:09:36.70,0:09:39.70,Default,,0,0,0,,(Дәретхананың ағу дыбысы)
Dialogue: 0,0:09:47.36,0:09:50.36,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:58.30,0:09:59.56,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:09:59.63,0:10:01.96,Default,,0,0,0,,Уф уф ах аа
Dialogue: 0,0:10:02.06,0:10:04.23,Default,,0,0,0,,Юубенің... тұман!
Dialogue: 0,0:10:06.63,0:10:08.60,Default,,0,0,0,,Бүгін түнде біз армандар елінің шынайы табиғатын ашамыз...
Dialogue: 0,0:10:12.03,0:10:14.46,Default,,0,0,0,,Мен анықтаймын! Det Det
Dialogue: 0,0:10:21.43,0:10:22.56,Default,,0,0,0,,Шығу!
Dialogue: 0,0:10:23.36,0:10:24.93,Default,,0,0,0,,Даа!
Dialogue: 0,0:10:25.03,0:10:27.76,Default,,0,0,0,,Ой-ой, әй, әй!
Dialogue: 0,0:10:27.86,0:10:30.70,Default,,0,0,0,,Ууу...
Dialogue: 0,0:10:30.80,0:10:33.26,Default,,0,0,0,,Уф, қандай қорқынышты дауыл!
Dialogue: 0,0:10:33.46,0:10:36.73,Default,,0,0,0,,Мен ол жануарларды қайта көрмейінше берілмеймін.
Dialogue: 0,0:10:43.20,0:10:45.63,Default,,0,0,0,,Уау, бұл өте үлкен орман.
Dialogue: 0,0:10:45.86,0:10:47.60,Default,,0,0,0,,А, а, а, татата... Такекоптер!
Dialogue: 0,0:10:47.80,0:10:51.60,Default,,0,0,0,,Уау! Апыр-ай! Апыр-ай!
Dialogue: 0,0:10:52.20,0:10:54.30,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:10:54.43,0:10:57.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:57.46,0:10:58.13,Default,,0,0,0,,Ішек
Dialogue: 0,0:10:58.26,0:11:00.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:00.20,0:11:01.43,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:11:01.76,0:11:05.93,Default,,0,0,0,,Түн ортасында ояндың, сондықтан мен сенің соңынан ердім.
Dialogue: 0,0:11:06.03,0:11:08.60,Default,,0,0,0,,О, кешірім сұрауым керек.
Dialogue: 0,0:11:08.70,0:11:11.50,Default,,0,0,0,,Суретті кітап сияқты арман деп, мазақ еттім.
Dialogue: 0,0:11:11.60,0:11:14.86,Default,,0,0,0,,Мен мұндай әлем шынымен бар деп ойламаппын.
Dialogue: 0,0:11:14.96,0:11:18.13,Default,,0,0,0,,Нобита-кун, мен қалай кешірім сұраймын...
Dialogue: 0,0:11:18.20,0:11:20.50,Default,,0,0,0,,Дораемон
Dialogue: 0,0:11:20.60,0:11:23.86,Default,,0,0,0,,Жарайды, пойыздан тез түс.
Dialogue: 0,0:11:25.30,0:11:27.13,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:11:27.70,0:11:31.83,Default,,0,0,0,,Мұндай қатты желде таккоптермен ұшу мүмкін емес.
Dialogue: 0,0:11:31.93,0:11:33.80,Default,,0,0,0,,Себебі мен бұны киіп жүрмін
Dialogue: 0,0:11:34.00,0:11:36.20,Default,,0,0,0,,«Тайфунның көздері»
Dialogue: 0,0:11:36.66,0:11:40.66,Default,,0,0,0,,Бұны кигенде жаңбыр мен жел басылады.
Dialogue: 0,0:11:40.76,0:11:43.36,Default,,0,0,0,,Демек, бұл тайфунның көзі сияқты.
Dialogue: 0,0:11:43.46,0:11:44.96,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:11:45.33,0:11:47.13,Default,,0,0,0,,Кішкене зерттеп көрейік
Dialogue: 0,0:11:47.20,0:11:48.20,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:50.60,0:11:54.26,Default,,0,0,0,,Сонымен, сіз осы жерде жануарларды кездестірдіңіз бе?
Dialogue: 0,0:11:54.53,0:11:57.20,Default,,0,0,0,,Иә, бірақ мына желмен сен қайдасың?
Dialogue: 0,0:11:58.86,0:12:01.20,Default,,0,0,0,,Аа, орман сонда бітеді.
Dialogue: 0,0:12:05.90,0:12:08.33,Default,,0,0,0,,Орманның сыртында үлкен өзен бар.
Dialogue: 0,0:12:08.43,0:12:09.10,Default,,0,0,0,,Иә
Dialogue: 0,0:12:09.23,0:12:12.26,Default,,0,0,0,,Жаңбыр судың деңгейін жоғарылатып, ағын жылдамырақ болады.
Dialogue: 0,0:12:12.36,0:12:14.50,Default,,0,0,0,,Бұл үлкен серпін.
Dialogue: 0,0:12:14.86,0:12:15.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:16.23,0:12:17.83,Default,,0,0,0,,Әй, Дораемон!
Dialogue: 0,0:12:17.93,0:12:18.93,Default,,0,0,0,,Анау, анау! иә?
Dialogue: 0,0:12:19.06,0:12:21.40,Default,,0,0,0,,(Чиппоның айқайы)
Dialogue: 0,0:12:21.93,0:12:24.06,Default,,0,0,0,,Ууу
Dialogue: 0,0:12:24.16,0:12:26.56,Default,,0,0,0,,Уа, ау, ау...
Dialogue: 0,0:12:26.66,0:12:28.36,Default,,0,0,0,,Ха, бұл Юбенің иті.
Dialogue: 0,0:12:28.43,0:12:29.93,Default,,0,0,0,,Әй, мынаны маған ертеректен берші.
Dialogue: 0,0:12:30.03,0:12:33.10,Default,,0,0,0,,Иә «Нобир қолы»
Dialogue: 0,0:12:35.00,0:12:35.86,Default,,0,0,0,,Ei
Dialogue: 0,0:12:36.16,0:12:37.36,Default,,0,0,0,,Бұл белгіде көрсетілмеген ғой, иә?
Dialogue: 0,0:12:37.76,0:12:39.73,Default,,0,0,0,,(айқай)
Dialogue: 0,0:12:39.83,0:12:41.56,Default,,0,0,0,,Құйрықты ұстасаң жақсы емес.
Dialogue: 0,0:12:41.66,0:12:43.10,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:12:50.93,0:12:52.16,Default,,0,0,0,,Ауырды
Dialogue: 0,0:12:52.26,0:12:53.53,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:12:53.60,0:12:55.00,Default,,0,0,0,,Сіздің үйіңіз қайда?
Dialogue: 0,0:12:55.93,0:12:57.43,Default,,0,0,0,,Осы өзеннің жоғары жағындағы қала
Dialogue: 0,0:12:58.03,0:13:00.73,Default,,0,0,0,,Ал, мені сонда апар, арқама мін.
Dialogue: 0,0:13:00.83,0:13:02.16,Default,,0,0,0,,Не? иә
Dialogue: 0,0:13:02.30,0:13:04.00,Default,,0,0,0,,Кету! Уау аа
Dialogue: 0,0:13:04.16,0:13:06.63,Default,,0,0,0,,Олар біртүрлі адамдар.
Dialogue: 0,0:13:06.73,0:13:09.93,Default,,0,0,0,,Еңот ит пен ұша алатын маймыл
Dialogue: 0,0:13:10.00,0:13:11.96,Default,,0,0,0,,Мен маймыл емеспін, мен адаммын
Dialogue: 0,0:13:12.06,0:13:13.80,Default,,0,0,0,,Мен роботпын!
Dialogue: 0,0:13:14.76,0:13:17.83,Default,,0,0,0,,А, мен оны көріп тұрмын. Бұл қала.
Dialogue: 0,0:13:20.40,0:13:21.40,Default,,0,0,0,,Әй, солай.
Dialogue: 0,0:13:21.90,0:13:23.33,Default,,0,0,0,,А? Чиппо!
Dialogue: 0,0:13:25.83,0:13:27.30,Default,,0,0,0,,Әке! Чиппо!
Dialogue: 0,0:13:27.40,0:13:28.16,Default,,0,0,0,,Хаха
Dialogue: 0,0:13:28.30,0:13:29.10,Default,,0,0,0,,Міне! Ах
Dialogue: 0,0:13:29.43,0:13:30.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:30.43,0:13:31.83,Default,,0,0,0,,Ол мүлде жаман бала.
Dialogue: 0,0:13:31.96,0:13:34.66,Default,,0,0,0,,Әрқашан әркімге алаңдау
Dialogue: 0,0:13:34.80,0:13:36.56,Default,,0,0,0,,Мен жаңа ғана тәжірибе жасадым.
Dialogue: 0,0:13:37.16,0:13:38.00,Default,,0,0,0,,Эксперимент?
Dialogue: 0,0:13:38.93,0:13:41.33,Default,,0,0,0,,Тайфунда желкенді салға бекіткенде
Dialogue: 0,0:13:41.46,0:13:43.66,Default,,0,0,0,,Қызық, ол қаншалықты жылдам өтеді?
Dialogue: 0,0:13:43.80,0:13:46.43,Default,,0,0,0,,Сіз қандай абайсызда әрекет етесіз?
Dialogue: 0,0:13:47.16,0:13:51.16,Default,,0,0,0,,Жарайды, аман-есен оралғаныңызға қуаныштымын.
Dialogue: 0,0:13:51.26,0:13:54.26,Default,,0,0,0,,Олай болса, іздеу тобы таратылды.
Dialogue: 0,0:13:54.33,0:13:56.76,Default,,0,0,0,,Әлсіреп қалма — жолды бөгеп тұрсың.
Dialogue: 0,0:13:56.83,0:13:58.40,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:13:58.76,0:14:01.80,Default,,0,0,0,,үшінңызға рахмет. Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:14:02.20,0:14:06.20,Default,,0,0,0,,Сәлем, солай ма? Барлық жануарлар сөйлейді, солай ма?
Dialogue: 0,0:14:06.46,0:14:08.73,Default,,0,0,0,,Шынымен сөйлейді
Dialogue: 0,0:14:10.70,0:14:13.63,Default,,0,0,0,,Солай ма? Тануки мырза мен Маймыл мырзаға.
Dialogue: 0,0:14:14.50,0:14:17.56,Default,,0,0,0,,Жоқ, жоқ, баламның өмірін сақтап қалғаныңызды естідім.
Dialogue: 0,0:14:17.70,0:14:18.63,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:18.73,0:14:19.73,Default,,0,0,0,,Жоқ, жоқ, бұл
Dialogue: 0,0:14:19.83,0:14:22.63,Default,,0,0,0,,Айтпақшы, мен енот ит емеспін...
Dialogue: 0,0:14:22.73,0:14:25.03,Default,,0,0,0,,Қарсы болмасаңыз, біз дәл сол жердеміз.
Dialogue: 0,0:14:25.13,0:14:27.06,Default,,0,0,0,,Барып, жылы шәй ішіңізші.
Dialogue: 0,0:14:29.73,0:14:32.20,Default,,0,0,0,,(Чиппо мен оның достарының күлкісі)
Dialogue: 0,0:14:32.56,0:14:35.30,Default,,0,0,0,,Жүр, Чиппо, ертең сенің сабағың бар, солай ма?
Dialogue: 0,0:14:35.40,0:14:36.53,Default,,0,0,0,,Мен ұйықтауым керек
Dialogue: 0,0:14:36.63,0:14:38.73,Default,,0,0,0,,Жоқ, сіз әлі ояусыз...
Dialogue: 0,0:14:38.83,0:14:40.30,Default,,0,0,0,,А, жоқ.
Dialogue: 0,0:14:40.40,0:14:42.20,Default,,0,0,0,,Біз де үйге баруымыз керек.
Dialogue: 0,0:14:42.30,0:14:43.06,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:43.46,0:14:45.06,Default,,0,0,0,,Әй, түнде қалуыңды өтінемін.
Dialogue: 0,0:14:45.56,0:14:47.53,Default,,0,0,0,,Иә, бұл мүмкін емес.
Dialogue: 0,0:14:47.63,0:14:48.73,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:14:48.86,0:14:49.73,Default,,0,0,0,,Жапония
Dialogue: 0,0:14:49.86,0:14:51.40,Default,,0,0,0,,Не? Жапония дегеніміз не?
Dialogue: 0,0:14:51.56,0:14:53.50,Default,,0,0,0,,Хехе, мазалағаным үшін кешіріңіз.
Dialogue: 0,0:14:53.56,0:14:56.06,Default,,0,0,0,,Ал, рахмет, сау болыңдар.
Dialogue: 0,0:14:56.63,0:14:58.80,Default,,0,0,0,,Жарайды, мен тағы келемін.
Dialogue: 0,0:14:58.90,0:15:00.36,Default,,0,0,0,,Мен сенімдімін (Нобита) Иә.
Dialogue: 0,0:15:00.46,0:15:04.26,Default,,0,0,0,,Жоқ, бірақ менде керемет жоспарлар бар.
Dialogue: 0,0:15:04.36,0:15:05.80,Default,,0,0,0,,Маған қосылуға рұқсат етіңіз
Dialogue: 0,0:15:05.93,0:15:06.96,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:15:07.06,0:15:08.10,Default,,0,0,0,,Сонда кездескенше, иә
Dialogue: 0,0:15:08.20,0:15:09.53,Default,,0,0,0,,Олай болса, сау болыңыз.
Dialogue: 0,0:15:09.63,0:15:12.46,Default,,0,0,0,,Тағы да келетініңізге сенімдімін!
Dialogue: 0,0:15:13.53,0:15:14.73,Default,,0,0,0,,Сонда кездескенше!
Dialogue: 0,0:15:15.46,0:15:16.93,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:17.03,0:15:18.46,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:15:19.30,0:15:20.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:20.20,0:15:21.43,Default,,0,0,0,,Иә? Ахх
Dialogue: 0,0:15:21.93,0:15:24.76,Default,,0,0,0,,Уау, қандай үлкен ай!
Dialogue: 0,0:15:24.86,0:15:26.86,Default,,0,0,0,,Шынымен
Dialogue: 0,0:15:27.13,0:15:28.30,Default,,0,0,0,,Хия~ Күтілгендей.
Dialogue: 0,0:15:28.43,0:15:30.93,Default,,0,0,0,,Бұл Жер емес екені анық.
Dialogue: 0,0:15:31.03,0:15:32.63,Default,,0,0,0,,Иә, сонда не болды...
Dialogue: 0,0:15:32.73,0:15:34.36,Default,,0,0,0,,Неге сонша дүрлігіп жатырсың? Бұл табиғи емес пе?
Dialogue: 0,0:15:35.76,0:15:39.63,Default,,0,0,0,,Менің білетінім – ормандағы қызғылт тұман.
Dialogue: 0,0:15:39.73,0:15:42.46,Default,,0,0,0,,Бұл жердің қақпасы.
Dialogue: 0,0:15:42.96,0:15:44.63,Default,,0,0,0,,Мен бұған сенімдімін...
Dialogue: 0,0:15:44.76,0:15:46.40,Default,,0,0,0,,Иә? иә? Жоқ
Dialogue: 0,0:15:46.46,0:15:47.80,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:47.93,0:15:50.26,Default,,0,0,0,,Сіз оны басқа орынмен шатастырып жатқаныңызға сенімдісіз бе?
Dialogue: 0,0:15:50.63,0:15:53.20,Default,,0,0,0,,Жоқ, қарашы, «көздің ізі» бар ғой, солай ма?
Dialogue: 0,0:15:53.63,0:15:54.96,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:15:55.06,0:15:58.13,Default,,0,0,0,,Ой, байқадым, жел ұшырып әкетті.
Dialogue: 0,0:15:58.40,0:16:00.86,Default,,0,0,0,,Не?! Жоқ... не істеуіміз керек?
Dialogue: 0,0:16:01.00,0:16:02.13,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:16:02.20,0:16:03.53,Default,,0,0,0,,«Кез келген жерде есік» туралы не деуге болады?
Dialogue: 0,0:16:03.66,0:16:07.20,Default,,0,0,0,,Біз бұл орынды білмегендіктен, оны пайдалана алмаймыз.
Dialogue: 0,0:16:07.66,0:16:10.76,Default,,0,0,0,,Қалжың емес! Бірдеңе жасаңыз
Dialogue: 0,0:16:10.86,0:16:12.96,Default,,0,0,0,,Мен өмір бойы мұндай жерде тұрғым келмейді.
Dialogue: 0,0:16:13.03,0:16:15.86,Default,,0,0,0,,Жел мына жерден соғып тұрды.
Dialogue: 0,0:16:15.96,0:16:17.93,Default,,0,0,0,,Моямояхато… Хмм.
Dialogue: 0,0:16:18.03,0:16:19.76,Default,,0,0,0,,Әй, қайда бара жатырсың? Дораемон
Dialogue: 0,0:16:24.53,0:16:28.36,Default,,0,0,0,,Қараңдаршы, қызғылт бұлыңғыр кесек.
Dialogue: 0,0:16:28.46,0:16:29.70,Default,,0,0,0,,Жақсы
Dialogue: 0,0:16:30.33,0:16:32.70,Default,,0,0,0,,Бірақ бұл сыйғызу үшін тым кішкентай.
Dialogue: 0,0:16:33.00,0:16:36.53,Default,,0,0,0,,Хм, бұл жердің ішінен ағып жатыр ...
Dialogue: 0,0:16:36.63,0:16:39.63,Default,,0,0,0,,«Жеткі моль» тесігін кеңейтіңіз
Dialogue: 0,0:16:43.00,0:16:43.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:44.03,0:16:46.13,Default,,0,0,0,,Сөз көпіршіктелді Сөз көпіршіктелді
Dialogue: 0,0:16:46.20,0:16:47.93,Default,,0,0,0,,Мен құтқарылдым~
Dialogue: 0,0:16:50.70,0:16:54.53,Default,,0,0,0,,Көңілім жеңілдеп қалғанда, кенет ұйқым келді.
Dialogue: 0,0:16:54.66,0:16:57.00,Default,,0,0,0,,Мен түні бойы дерлік отырдым.
Dialogue: 0,0:16:59.80,0:17:01.33,Default,,0,0,0,,Уау Уау Уау (Нобита) Уау
Dialogue: 0,0:17:01.43,0:17:03.43,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:17:03.93,0:17:06.09,Default,,0,0,0,,Шығу да ауысқан сияқты.
Dialogue: 0,0:17:06.23,0:17:07.40,Default,,0,0,0,,олар ондағы жазбаларды сақтау үшін көшіріп жазады—
Dialogue: 0,0:17:14.59,0:17:17.26,Default,,0,0,0,,Оян! Мен сабаққа кешігіп барамын.
Dialogue: 0,0:17:18.20,0:17:19.66,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:17:19.76,0:17:22.90,Default,,0,0,0,,Иә, мен барамын.
Dialogue: 0,0:17:23.00,0:17:27.00,Default,,0,0,0,,(Нобита мен Дорэмонның ұйқысы)
Dialogue: 0,0:17:27.59,0:17:31.60,Default,,0,0,0,,Сенпай, тоқта!
Dialogue: 0,0:17:40.06,0:17:44.06,Default,,0,0,0,,Сенпай, тоқта!
Dialogue: 0,0:17:52.50,0:17:55.83,Default,,0,0,0,,Қош бол ұстаз
Dialogue: 0,0:17:55.93,0:17:58.16,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:17:59.50,0:18:02.63,Default,,0,0,0,,Сөмкеңді қоя салысымен, менің үйімде қарсы ал, жарай ма?
Dialogue: 0,0:18:02.73,0:18:04.60,Default,,0,0,0,,Бүгін жаман емес пе?
Dialogue: 0,0:18:04.66,0:18:06.60,Default,,0,0,0,,Анам мені ұрсады
Dialogue: 0,0:18:06.66,0:18:09.73,Default,,0,0,0,,Бүгін мен Жарық баспалдақтарының жұмбағын шешуге тырысамын дедім.
Dialogue: 0,0:18:09.83,0:18:11.06,Default,,0,0,0,,Кофе жасау, яғни
Dialogue: 0,0:18:11.16,0:18:12.93,Default,,0,0,0,,Жай ғана жасырын шық.
Dialogue: 0,0:18:13.00,0:18:14.66,Default,,0,0,0,,Ах, бірақ...
Dialogue: 0,0:18:15.06,0:18:16.16,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:16.26,0:18:18.40,Default,,0,0,0,,Жарайды, мен өзім барамын.
Dialogue: 0,0:18:22.63,0:18:24.66,Default,,0,0,0,,Бұл не? үшін, мені жақсы қыз деп айтып жатырсыңдар.
Dialogue: 0,0:18:29.66,0:18:30.90,Default,,0,0,0,,Үйдемін!
Dialogue: 0,0:18:34.16,0:18:34.83,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:37.33,0:18:38.46,Default,,0,0,0,,Eit
Dialogue: 0,0:18:38.56,0:18:40.40,Default,,0,0,0,,Чиппо! Тағы қайда барасың?
Dialogue: 0,0:18:40.50,0:18:42.50,Default,,0,0,0,,А-а... сәл ғана сонда.
Dialogue: 0,0:18:42.83,0:18:44.10,Default,,0,0,0,,№
Dialogue: 0,0:18:44.16,0:18:46.66,Default,,0,0,0,,Әкем де жақында үйге келеді.
Dialogue: 0,0:18:46.93,0:18:48.40,Default,,0,0,0,,Иә
Dialogue: 0,0:18:48.73,0:18:50.90,Default,,0,0,0,,Үй тапсырмасын өз бөлмеңде орында.
Dialogue: 0,0:18:51.00,0:18:52.63,Default,,0,0,0,,Иә
Dialogue: 0,0:18:54.90,0:18:57.96,Default,,0,0,0,,Бұл жоғалған котенканың үйі ме?
Dialogue: 0,0:18:58.56,0:19:00.56,Default,,0,0,0,,Мен оны тапқаныма қуаныштымын.
Dialogue: 0,0:19:00.66,0:19:03.06,Default,,0,0,0,,Олай болса, қазірден бастап абай болыңыз.
Dialogue: 0,0:19:03.80,0:19:04.46,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:19:05.13,0:19:07.30,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:19:07.73,0:19:09.06,Default,,0,0,0,,Қош бол~
Dialogue: 0,0:19:09.63,0:19:12.73,Default,,0,0,0,,Ах~ Міне бүгінгі жұмыс.
Dialogue: 0,0:19:13.86,0:19:15.50,Default,,0,0,0,,Полицей, бұл төбелес.
Dialogue: 0,0:19:15.56,0:19:17.80,Default,,0,0,0,,Дереу кел, жарай ма?
Dialogue: 0,0:19:17.90,0:19:19.53,Default,,0,0,0,,Теке мырза мен Пеликан мырза
Dialogue: 0,0:19:20.13,0:19:23.73,Default,,0,0,0,,Мен ұзақ уақыт жеткізген хатты жегеніңізге сене алар емеспін.
Dialogue: 0,0:19:23.83,0:19:27.56,Default,,0,0,0,,Хат болса, мен оны жегенше айтып жіберсеңші.
Dialogue: 0,0:19:27.70,0:19:29.53,Default,,0,0,0,,Қазір кім көрсе де
Dialogue: 0,0:19:29.63,0:19:30.20,Default,,0,0,0,,Сіз оның мөрі бар-жоғын білесіз.
Dialogue: 0,0:19:30.20,0:19:32.30,Default,,0,0,0,,Сіз оның мөрі бар-жоғын білесіз.
Dialogue: 0,0:19:30.20,0:19:32.30,Default,,0,0,0,,Ал, күте тұрыңыз.
Dialogue: 0,0:19:33.00,0:19:34.40,Default,,0,0,0,,Екеуің де тынышталыңдар.
Dialogue: 0,0:19:35.06,0:19:37.46,Default,,0,0,0,,Сіз жейтін нәрсеге ештеңе істей алмайсыз
Dialogue: 0,0:19:37.56,0:19:41.40,Default,,0,0,0,,Маған тағы да хат жазуыңызды өтінсем ше?
Dialogue: 0,0:19:41.86,0:19:45.36,Default,,0,0,0,,Хахахаха Керемет, солай істейік.
Dialogue: 0,0:19:46.00,0:19:47.66,Default,,0,0,0,,Жарай, тікелей іске кірісейік
Dialogue: 0,0:19:47.73,0:19:50.16,Default,,0,0,0,,Қайта жемеңіз.
Dialogue: 0,0:19:50.23,0:19:51.30,Default,,0,0,0,,Иә
Dialogue: 0,0:19:51.63,0:19:54.23,Default,,0,0,0,,«Құрметті қара ешкі мырза»
Dialogue: 0,0:19:54.33,0:19:58.23,Default,,0,0,0,,«Алдында айтқан хат туралы не деуге болады?»
Dialogue: 0,0:19:58.80,0:20:01.66,Default,,0,0,0,,Әй, бүгін неше түрлі оқиғалар болды.
Dialogue: 0,0:20:01.73,0:20:03.40,Default,,0,0,0,,Жүр, үйге тез жетейік.
Dialogue: 0,0:20:08.46,0:20:09.80,Default,,0,0,0,,Үйге қайтқалы жатырсың ба?
Dialogue: 0,0:20:09.90,0:20:11.66,Default,,0,0,0,,Еңбегіңізге рахмет (Пілдің әйелі)
Dialogue: 0,0:20:12.30,0:20:13.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:14.40,0:20:17.03,Default,,0,0,0,,А, бұл қызықсыз.
Dialogue: 0,0:20:30.53,0:20:32.46,Default,,0,0,0,,А, бұл Чиппо.
Dialogue: 0,0:20:34.46,0:20:36.20,Default,,0,0,0,,Сәлем Чиппо! Қайда бара жатырсың?
Dialogue: 0,0:20:36.30,0:20:38.40,Default,,0,0,0,,А, әке, сіз бара алмайсыз.
Dialogue: 0,0:20:39.20,0:20:40.06,Default,,0,0,0,,Уф
Dialogue: 0,0:20:40.40,0:20:43.36,Default,,0,0,0,,Әкем мені тағы тапты.
Dialogue: 0,0:20:43.90,0:20:45.36,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:20:46.03,0:20:47.80,Default,,0,0,0,,О, бұл қызықсыз.
Dialogue: 0,0:20:48.56,0:20:50.40,Default,,0,0,0,,Сол жұмбақ бала
Dialogue: 0,0:20:50.80,0:20:53.13,Default,,0,0,0,,Сіз Нобита-кунмен кездестіңіз бе?
Dialogue: 0,0:20:53.50,0:20:56.13,Default,,0,0,0,,Маған қонаққа келе аласыз ба?
Dialogue: 0,0:20:58.03,0:21:01.10,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:21:03.60,0:21:04.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:06.56,0:21:09.13,Default,,0,0,0,,Эй, сөйлесе аласың ба?
Dialogue: 0,0:21:09.26,0:21:11.76,Default,,0,0,0,,Мен, Нобита, сенің атың кім?
Dialogue: 0,0:21:11.86,0:21:13.70,Default,,0,0,0,,(айқай)
Dialogue: 0,0:21:13.90,0:21:17.10,Default,,0,0,0,,Сіздің атыңыз «Чиппо» емес, солай ма?
Dialogue: 0,0:21:17.20,0:21:19.13,Default,,0,0,0,,Мен итпін (Нобита) Ах...
Dialogue: 0,0:21:19.36,0:21:21.70,Default,,0,0,0,,Мен ит болғандықтан сенімен сөйлесе алмаймын.
Dialogue: 0,0:21:21.80,0:21:23.70,Default,,0,0,0,,Ноби-чан өте сүйкімді
Dialogue: 0,0:21:23.80,0:21:25.40,Default,,0,0,0,,Қазірдің өзінде! (Сунео) Бүгін де суретті кітаптар елінде
Dialogue: 0,0:21:25.46,0:21:27.13,Default,,0,0,0,,Сіз көңіл көтересіз бе?
Dialogue: 0,0:21:27.23,0:21:30.63,Default,,0,0,0,,Келесі жолы Кума-чанмен сумо күресін өткізіп көріңіз.
Dialogue: 0,0:21:30.73,0:21:33.10,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:21:33.20,0:21:36.03,Default,,0,0,0,,Сәлем! Сұрасам да сені енді өзіммен бірге алып кетпеймін.
Dialogue: 0,0:21:36.13,0:21:39.43,Default,,0,0,0,,Ммм...
Dialogue: 0,0:21:40.06,0:21:42.06,Default,,0,0,0,,Бұл өте біртүрлі.
Dialogue: 0,0:21:43.13,0:21:44.30,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:21:44.70,0:21:46.60,Default,,0,0,0,,О, сен не қарап тұрсың?
Dialogue: 0,0:21:46.76,0:21:50.86,Default,,0,0,0,,Ааа, кешегі фото керемет көрінеді.
Dialogue: 0,0:21:50.96,0:21:54.80,Default,,0,0,0,,Осыған қарап мен жануарлардың аяқ-қолын создым.
Dialogue: 0,0:21:54.90,0:21:56.43,Default,,0,0,0,,Адамдар сияқты
Dialogue: 0,0:21:56.70,0:21:57.56,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:21:57.63,0:21:59.23,Default,,0,0,0,,Жануарлар түріне қарай
Dialogue: 0,0:21:59.30,0:22:03.36,Default,,0,0,0,,Саусақтардың саны мен тұяқтардың бөліну жолы әртүрлі болғанымен.
Dialogue: 0,0:22:04.13,0:22:06.30,Default,,0,0,0,,Бұл жұмбақ туралы не ойлайсың?
Dialogue: 0,0:22:06.36,0:22:09.53,Default,,0,0,0,,Сіз қалай ойлайсыз? Тас, қағаз, қайшы ойнай алатындықтан емес пе?
Dialogue: 0,0:22:09.66,0:22:10.86,Default,,0,0,0,,О, менің...
Dialogue: 0,0:22:11.16,0:22:12.66,Default,,0,0,0,,Сонда мына... мына аяқ.
Dialogue: 0,0:22:12.76,0:22:15.33,Default,,0,0,0,,Бұл екі аяқпен жүруге мүмкіндік береді.
Dialogue: 0,0:22:16.03,0:22:17.36,Default,,0,0,0,,Бұл мүшелер
Dialogue: 0,0:22:17.46,0:22:21.33,Default,,0,0,0,,Адамдардың басқа жануарлардан алшақ дамуы үшін
Dialogue: 0,0:22:21.43,0:22:24.20,Default,,0,0,0,,Бұл басты факторға айналды.
Dialogue: 0,0:22:24.33,0:22:27.26,Default,,0,0,0,,Бірақ Юбедегі жануарлар
Dialogue: 0,0:22:27.36,0:22:31.20,Default,,0,0,0,,Аяқтар адамдар сияқты эволюциялық жолмен жүреді
Dialogue: 0,0:22:31.30,0:22:33.20,Default,,0,0,0,,Бұл биологиялық тұрғыдан.
Dialogue: 0,0:22:33.26,0:22:35.20,Default,,0,0,0,,Эй, әжетхана, бұл мүмкін емес.
Dialogue: 0,0:22:35.43,0:22:37.36,Default,,0,0,0,,Бұл... Әй?
Dialogue: 0,0:22:37.66,0:22:41.53,Default,,0,0,0,,Нобитаның миының эволюциясы баяу.
Dialogue: 0,0:22:41.70,0:22:45.53,Default,,0,0,0,,(Дәретхананың ағу дыбысы)
Dialogue: 0,0:22:45.66,0:22:47.10,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:22:47.20,0:22:47.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:48.26,0:22:50.10,Default,,0,0,0,,Біз оны әлі талқылаған жоқпыз.
Dialogue: 0,0:22:50.20,0:22:52.70,Default,,0,0,0,,Гольф алаңын салуға дайындық - уақытты босқа өткізу.
Dialogue: 0,0:22:52.83,0:22:53.53,Default,,0,0,0,,Иә
Dialogue: 0,0:22:53.63,0:22:55.33,Default,,0,0,0,,Иә, мен бірден келемін. Иә, иә.
Dialogue: 0,0:22:55.70,0:22:57.20,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:22:58.00,0:23:00.66,Default,,0,0,0,,Дораемонның артқы тауы жойылды!
Dialogue: 0,0:23:00.76,0:23:01.56,Default,,0,0,0,,Иә!?
Dialogue: 0,0:23:01.83,0:23:03.00,Default,,0,0,0,,(Баспропеллер орнату дыбысы)
Dialogue: 0,0:23:03.26,0:23:04.10,Default,,0,0,0,,Міне.
Dialogue: 0,0:23:10.26,0:23:12.43,Default,,0,0,0,,Президент, осында клуб үйін салайық.
Dialogue: 0,0:23:12.76,0:23:14.70,Default,,0,0,0,,Аа, ағаштар көп екен
Dialogue: 0,0:23:14.76,0:23:16.40,Default,,0,0,0,,Сіз фарвейге жете аласыз ба?
Dialogue: 0,0:23:17.10,0:23:18.56,Default,,0,0,0,,Жоқ, олардың көпшілігі қысқартылады.
Dialogue: 0,0:23:18.66,0:23:20.50,Default,,0,0,0,,Бұл қызықты курс болады.
Dialogue: 0,0:23:20.60,0:23:22.10,Default,,0,0,0,,Ал, мен оны асыға күтемін.
Dialogue: 0,0:23:22.23,0:23:23.90,Default,,0,0,0,,(Президенттердің күлкісі)
Dialogue: 0,0:23:24.00,0:23:25.56,Default,,0,0,0,,«Көңілді» деген не?
Dialogue: 0,0:23:25.66,0:23:28.26,Default,,0,0,0,,Мұнда мекендейтін жануарлармен не болады?
Dialogue: 0,0:23:28.36,0:23:30.56,Default,,0,0,0,,«Өсімдіктерді өңдеуші»
Dialogue: 0,0:23:30.66,0:23:34.00,Default,,0,0,0,,Өсімдік жасушаларының жануарларға уақытша айналуы
Dialogue: 0,0:23:34.10,0:23:34.90,Default,,0,0,0,,Радиотолқын командасы бойынша...
Dialogue: 0,0:23:35.00,0:23:37.16,Default,,0,0,0,,Түсіндіру маған бәрібір, асығыңыз!
Dialogue: 0,0:23:37.50,0:23:38.86,Default,,0,0,0,,Ал, бірінші тесіктен бастаңыз.
Dialogue: 0,0:23:38.93,0:23:39.60,Default,,0,0,0,,О
Dialogue: 0,0:23:39.93,0:23:40.60,Default,,0,0,0,,Ei
Dialogue: 0,0:23:42.83,0:23:44.53,Default,,0,0,0,,Оппозициялық қозғалыстар туралы не деуге болады?
Dialogue: 0,0:23:44.60,0:23:45.76,Default,,0,0,0,,Олай емес...
Dialogue: 0,0:23:45.86,0:23:48.76,Default,,0,0,0,,Бұл орманға қол тигізуге болмайды.
Dialogue: 0,0:23:48.86,0:23:49.90,Default,,0,0,0,,Не?
Dialogue: 0,0:23:50.00,0:23:51.90,Default,,0,0,0,,Бұл кім? бастық
Dialogue: 0,0:23:52.26,0:23:55.93,Default,,0,0,0,,Бұл ормандағы барлық тіршілік иелерін бейнелейді.
Dialogue: 0,0:23:56.53,0:23:58.10,Default,,0,0,0,,Ағаш... Ағаш сөйлейді
Dialogue: 0,0:23:58.23,0:24:00.46,Default,,0,0,0,,Бір жерде қулық бар ма?
Dialogue: 0,0:24:00.76,0:24:04.90,Default,,0,0,0,,Ағаштарды абайсызда кессең, орман құдайы сені аңдып қалады.
Dialogue: 0,0:24:05.50,0:24:08.50,Default,,0,0,0,,Біздің компания бұл тауды сатып алу үшін көп ақша төледі.
Dialogue: 0,0:24:08.63,0:24:10.83,Default,,0,0,0,,Мен не істесем де, өз қолымда!
Dialogue: 0,0:24:11.10,0:24:14.33,Default,,0,0,0,,Менмен адамдар
Dialogue: 0,0:24:14.43,0:24:16.83,Default,,0,0,0,,Орман құдайының қаһарын қара
Dialogue: 0,0:24:17.26,0:24:19.26,Default,,0,0,0,,(Президенттердің айқайы)
Dialogue: 0,0:24:19.46,0:24:20.93,Default,,0,0,0,,Тс. Олардың қаншасы бар?
Dialogue: 0,0:24:21.00,0:24:23.73,Default,,0,0,0,,Бірақ бұл жылдамдықпен мен бір күні тағы келемін.
Dialogue: 0,0:24:24.00,0:24:25.16,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:24:25.40,0:24:28.00,Default,,0,0,0,,Хмм, мен бірдеңе істеуім керек.
Dialogue: 0,0:24:28.13,0:24:29.16,Default,,0,0,0,,Иә? (Нобита) Иә?
Dialogue: 0,0:24:29.50,0:24:31.63,Default,,0,0,0,,А, қызғылт тұман.
Dialogue: 0,0:24:31.83,0:24:34.13,Default,,0,0,0,,Күн ортасында осындай жерде
Dialogue: 0,0:24:35.66,0:24:39.00,Default,,0,0,0,,Чиппоның орнына барайық, жарай ма? эй? эй?
Dialogue: 0,0:24:39.13,0:24:42.06,Default,,0,0,0,,Аа, дұрыс, Шизука-чан, сәл күте тұрыңыз!
Dialogue: 0,0:24:42.16,0:24:46.00,Default,,0,0,0,,Хмм, бұл тұман мен оны бір жерден көрген сияқтымын...
Dialogue: 0,0:24:50.26,0:24:52.46,Default,,0,0,0,,Иә? Жануарлар елі?
Dialogue: 0,0:24:52.80,0:24:54.50,Default,,0,0,0,,Бұл арман емес еді
Dialogue: 0,0:24:54.60,0:24:56.80,Default,,0,0,0,,Бірақ кенеттен осындай жерде...
Dialogue: 0,0:24:56.90,0:24:57.76,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,0:24:57.83,0:24:59.90,Default,,0,0,0,,Енді, Шизука-чан, аа... иә.
Dialogue: 0,0:25:00.56,0:25:02.03,Default,,0,0,0,,Артқы тауда кіреберіс бар.
Dialogue: 0,0:25:02.13,0:25:02.90,Default,,0,0,0,,Хмм.
Dialogue: 0,0:25:05.46,0:25:08.00,Default,,0,0,0,,Ах, Нобита және Шизука-чан
Dialogue: 0,0:25:08.06,0:25:09.33,Default,,0,0,0,,Сіз бір жерге барасыз ба?
Dialogue: 0,0:25:09.40,0:25:10.13,Default,,0,0,0,,Артқы тауда.
Dialogue: 0,0:25:10.23,0:25:11.46,Default,,0,0,0,,Барайық (Сунео) Иә.
Dialogue: 0,0:25:19.40,0:25:21.73,Default,,0,0,0,,Ааа~ Мынаның ішіне кіресің бе?
Dialogue: 0,0:25:21.83,0:25:23.90,Default,,0,0,0,,Жүр, мен сенімен біргемін.
Dialogue: 0,0:25:24.03,0:25:25.00,Default,,0,0,0,,Иә
Dialogue: 0,0:25:25.86,0:25:28.36,Default,,0,0,0,,Сіз не ойлап отырсыз? Тез барайық.
Dialogue: 0,0:25:28.46,0:25:31.90,Default,,0,0,0,,Бұл тұман бір нәрсеге ұқсайды...
Dialogue: 0,0:25:33.16,0:25:35.06,Default,,0,0,0,,Иә, кәмпитке ұқсайды.
Dialogue: 0,0:25:35.20,0:25:38.20,Default,,0,0,0,,Жоқ, 22 ғасырда әлем...
Dialogue: 0,0:25:38.30,0:25:39.40,Default,,0,0,0,,Өте әдемі!
Dialogue: 0,0:25:39.80,0:25:43.80,Default,,0,0,0,,Мен Чиппо есімді өте жігерлі күшікпен достастым.
Dialogue: 0,0:25:43.90,0:25:45.80,Default,,0,0,0,,Мен сені Шизука-чанмен де таныстырамын.
Dialogue: 0,0:25:45.90,0:25:47.56,Default,,0,0,0,,Иә (Нобита) Қараңызшы, бұл шығу.
Dialogue: 0,0:25:47.66,0:25:49.66,Default,,0,0,0,,Тез Уау!
Dialogue: 0,0:25:50.90,0:25:53.56,Default,,0,0,0,,...
Dialogue: 0,0:25:53.66,0:25:54.80,Default,,0,0,0,,Мына орман арқылы өт
Dialogue: 0,0:26:04.63,0:26:06.80,Default,,0,0,0,,Бұл жануарлар қаласы дерлік
Dialogue: 0,0:26:06.93,0:26:07.93,Default,,0,0,0,,Бір минут күте тұрыңыз (Нобита) Иә?
Dialogue: 0,0:26:08.03,0:26:09.96,Default,,0,0,0,,Қалаға кірмес бұрын түсейік.
Dialogue: 0,0:26:10.10,0:26:10.90,Default,,0,0,0,,Иә
Dialogue: 0,0:26:14.30,0:26:17.30,Default,,0,0,0,,«Жануарларды бейнелеу ойыны»
Dialogue: 0,0:26:17.40,0:26:20.73,Default,,0,0,0,,Адамсыз дүние ғой, мына қалпақты киіп ал.
Dialogue: 0,0:26:20.80,0:26:22.13,Default,,0,0,0,,Уау өте сүйкімді
Dialogue: 0,0:26:22.36,0:26:25.70,Default,,0,0,0,,Бұл менің маймылым емес пе?
Dialogue: 0,0:26:25.80,0:26:26.63,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:26:26.73,0:26:29.60,Default,,0,0,0,,Уууу, сізге керемет көрінеді, Аю мырза.
Dialogue: 0,0:26:29.70,0:26:32.10,Default,,0,0,0,,Хехе, Шизука саған да жақсы көрінеді.
Dialogue: 0,0:26:32.20,0:26:34.06,Default,,0,0,0,,Айтпақшы, Дораемон ше?
Dialogue: 0,0:26:34.13,0:26:35.53,Default,,0,0,0,,Менде осы ғана
Dialogue: 0,0:26:36.40,0:26:37.46,Default,,0,0,0,,Мысықтың құлақтары
Dialogue: 0,0:26:37.60,0:26:39.46,Default,,0,0,0,,Енот ит емес пе еді? Хмм
Dialogue: 0,0:26:39.56,0:26:41.46,Default,,0,0,0,,Мен мысық тәрізді роботпын
Dialogue: 0,0:26:42.06,0:26:46.46,Default,,0,0,0,,Джан мен Сунеоның мені бұлай киінгенін көрмегеніне қуаныштымын.
Dialogue: 0,0:26:46.86,0:26:49.46,Default,,0,0,0,,Джиан Жақсы екеніңізге сенімдісіз бе?
Dialogue: 0,0:26:49.60,0:26:51.03,Default,,0,0,0,,Бұл... бұл жалғыз орын.
Dialogue: 0,0:26:51.13,0:26:53.43,Default,,0,0,0,,Нобита мен оның достары артымыздағы тауда жоғалып кетті.
Dialogue: 0,0:26:54.46,0:26:55.26,Default,,0,0,0,,Ах (Сунео) Ах.
Dialogue: 0,0:26:55.36,0:26:56.03,Default,,0,0,0,,Мен бұған жол бере алмаймын.
Dialogue: 0,0:26:56.13,0:26:58.46,Default,,0,0,0,,Уау, бұл көмектесті!
Dialogue: 0,0:26:59.76,0:27:00.76,Default,,0,0,0,,Хахаха (Сунео) Иә
Dialogue: 0,0:27:00.86,0:27:02.33,Default,,0,0,0,,О, не? (Сунео) Ауырып тұр.
Dialogue: 0,0:27:02.86,0:27:04.66,Default,,0,0,0,,Мен басқа ормандамын.
Dialogue: 0,0:27:04.76,0:27:06.76,Default,,0,0,0,,Бұл қорқынышты. Үйге барайық.
Dialogue: 0,0:27:06.96,0:27:08.66,Default,,0,0,0,,Нобита мен Шизука-чан осында.
Dialogue: 0,0:27:08.76,0:27:10.70,Default,,0,0,0,,Мен жақсы нәрсе болатынына сенімдімін!
Dialogue: 0,0:27:11.03,0:27:14.63,Default,,0,0,0,,Мен ары қарай жүре аламын ба? Эй
Dialogue: 0,0:27:14.86,0:27:16.70,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:27:16.83,0:27:19.70,Default,,0,0,0,,Тіпті мен түсінбеймін. Үніңді жап, жүр!
Dialogue: 0,0:27:20.70,0:27:23.53,Default,,0,0,0,,Нобита! (Сунео) Нобита!
Dialogue: 0,0:27:23.63,0:27:27.30,Default,,0,0,0,,Шизука-чан! (Сунео) Шизука-чан!
Dialogue: 0,0:27:29.13,0:27:31.20,Default,,0,0,0,,Ақылсыз тыныш.
Dialogue: 0,0:27:31.30,0:27:32.70,Default,,0,0,0,,Қызық, бәрі ұйықтап жатыр ма?
Dialogue: 0,0:27:32.93,0:27:35.76,Default,,0,0,0,,Мен оның Нобита-сан екеніне сене алар емеспін.
Dialogue: 0,0:27:35.86,0:27:37.20,Default,,0,0,0,,А, ол Чиппоның ішінде.
Dialogue: 0,0:27:41.00,0:27:44.16,Default,,0,0,0,,Кешіріңіз, Чиппо-кун!
Dialogue: 0,0:27:44.70,0:27:48.53,Default,,0,0,0,,Сәлеметсіз бе! Сәлем!
Dialogue: 0,0:27:48.63,0:27:50.43,Default,,0,0,0,,Қызық, бәрі жоқ па?
Dialogue: 0,0:27:50.70,0:27:52.33,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:27:53.03,0:27:56.70,Default,,0,0,0,,Сәлеметсіз бе! Сіз алыстасыз ба?
Dialogue: 0,0:27:56.83,0:27:57.93,Default,,0,0,0,,Әй
Dialogue: 0,0:27:58.03,0:27:59.26,Default,,0,0,0,,Бұл не? (Нобита) Иә?
Dialogue: 0,0:28:00.20,0:28:01.36,Default,,0,0,0,,О, не?
Dialogue: 0,0:28:01.43,0:28:03.56,Default,,0,0,0,,Соңғы рет қашан келгенімді білмедім.
Dialogue: 0,0:28:04.10,0:28:06.56,Default,,0,0,0,,Бұл сиқырдың бір түрі ме?
Dialogue: 0,0:28:06.90,0:28:10.10,Default,,0,0,0,,Көрші бақшада осыған ұқсас нәрсе болды.
Dialogue: 0,0:28:10.23,0:28:12.00,Default,,0,0,0,,Ешкім жоқ
Dialogue: 0,0:28:13.06,0:28:15.20,Default,,0,0,0,,Түнгі ме? үшін
Dialogue: 0,0:28:15.26,0:28:15.93,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:28:16.53,0:28:20.43,Default,,0,0,0,,Қаланы мұқият қарастырайық.
Dialogue: 0,0:28:24.20,0:28:26.40,Default,,0,0,0,,үшін қайда кетті?
Dialogue: 0,0:28:26.86,0:28:28.33,Default,,0,0,0,,Күте тұрыңыз! не болды?
Dialogue: 0,0:28:29.10,0:28:30.60,Default,,0,0,0,,Мен бірдеңе естідім.
Dialogue: 0,0:28:32.83,0:28:34.60,Default,,0,0,0,,Мен ештеңе естімеймін
Dialogue: 0,0:28:34.76,0:28:39.26,Default,,0,0,0,,Шидзуканың бас киімі қоянның қызметімен бірдей.
Dialogue: 0,0:28:39.40,0:28:40.76,Default,,0,0,0,,Сөйлеу?
Dialogue: 0,0:28:41.23,0:28:43.66,Default,,0,0,0,,Жоқ, бұл жерден шыққан машинаның дыбысы.
Dialogue: 0,0:28:43.76,0:28:44.73,Default,,0,0,0,,Не? Иә?
Dialogue: 0,0:29:01.50,0:29:02.56,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:29:02.66,0:29:04.66,Default,,0,0,0,,Тек машиналар өздігінен қозғалады
Dialogue: 0,0:29:04.76,0:29:06.60,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:29:11.23,0:29:12.56,Default,,0,0,0,,Бұл өнім ме?
Dialogue: 0,0:29:13.10,0:29:15.26,Default,,0,0,0,,Жағымды иіс 1
Dialogue: 0,0:29:16.76,0:29:19.26,Default,,0,0,0,,Ммм, дәмді, бифштекс сияқты
Dialogue: 0,0:29:19.93,0:29:21.43,Default,,0,0,0,,Бұл салат дәмі
Dialogue: 0,0:29:21.83,0:29:23.40,Default,,0,0,0,,Бұл Паня
Dialogue: 0,0:29:25.26,0:29:27.56,Default,,0,0,0,,Әртүрлі тағамдарды синтездеу
Dialogue: 0,0:29:27.66,0:29:30.83,Default,,0,0,0,,Оның үстіне шикізат су, ауа, жарық.
Dialogue: 0,0:29:30.93,0:29:32.63,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:29:32.73,0:29:35.33,Default,,0,0,0,,О, жер астынан судың керемет дыбысы шықты.
Dialogue: 0,0:29:42.90,0:29:44.46,Default,,0,0,0,,Бұл кәріз.
Dialogue: 0,0:29:44.80,0:29:46.73,Default,,0,0,0,,Бірақ бұл мүлде жағымсыз иіс емес.
Dialogue: 0,0:29:46.93,0:29:49.16,Default,,0,0,0,,Ағынды суларды тазарту жүйесі мінсіз.
Dialogue: 0,0:30:00.16,0:30:01.30,Default,,0,0,0,,Эй, міне, осы.
Dialogue: 0,0:30:01.40,0:30:04.66,Default,,0,0,0,,Теңізге қанша ағынды су төгілсе де, ол ластанбайды.
Dialogue: 0,0:30:04.80,0:30:08.63,Default,,0,0,0,,Олар өздері өмір сүретін планетаға қамқорлық жасайды, солай емес пе?
Dialogue: 0,0:30:08.73,0:30:12.96,Default,,0,0,0,,Әй, қараңдаршы, төбе тәрізді жылтыр не?
Dialogue: 0,0:30:16.66,0:30:19.50,Default,,0,0,0,,Бұл күн батареясы.
Dialogue: 0,0:30:19.93,0:30:23.50,Default,,0,0,0,,Дегенмен, мен мұндай тиімді нәрсені ешқашан көрген емеспін.
Dialogue: 0,0:30:23.93,0:30:27.60,Default,,0,0,0,,Бұл ғылыми тұрғыдан өте дамыған дүние.
Dialogue: 0,0:30:27.66,0:30:32.00,Default,,0,0,0,,Бұл 22 ғасырдағы Жермен салыстырғанда таңғажайып экологиялық нысан.
Dialogue: 0,0:30:34.73,0:30:36.40,Default,,0,0,0,,Джанға қара
Dialogue: 0,0:30:36.50,0:30:38.10,Default,,0,0,0,,Сондай үлкен ай болды
Dialogue: 0,0:30:38.16,0:30:38.90,Default,,0,0,0,,Хун
Dialogue: 0,0:30:39.50,0:30:41.73,Default,,0,0,0,,Қалағаныңды, тіпті айды да шығар.
Dialogue: 0,0:30:41.83,0:30:43.46,Default,,0,0,0,,Маған енді бұл орман ұнамайды.
Dialogue: 0,0:30:43.56,0:30:45.90,Default,,0,0,0,,Сондықтан мен оны басынан бастап ұнатпаймын дедім.
Dialogue: 0,0:30:46.46,0:30:48.23,Default,,0,0,0,,Нобитаның жігіті Мен қайтып келгенде
Dialogue: 0,0:30:48.33,0:30:49.80,Default,,0,0,0,,Мен оны қолымнан келгенше ұрдым.
Dialogue: 0,0:30:50.40,0:30:52.33,Default,,0,0,0,,Үйге баратын жолды білесің бе?
Dialogue: 0,0:30:52.46,0:30:54.83,Default,,0,0,0,,Жарайды, мен ағашты белгіледім.
Dialogue: 0,0:31:00.06,0:31:02.40,Default,,0,0,0,,Мен бұл жерде болуы керек екеніне сенімдімін.
Dialogue: 0,0:31:02.50,0:31:04.23,Default,,0,0,0,,Хаха, келдің бе?
Dialogue: 0,0:31:04.56,0:31:05.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:06.66,0:31:08.00,Default,,0,0,0,,Тұман жоғалып барады
Dialogue: 0,0:31:08.06,0:31:09.90,Default,,0,0,0,,Ой... уау, бірдеңе істе!
Dialogue: 0,0:31:10.00,0:31:11.73,Default,,0,0,0,,(Сунео мен Джианның күш айқайы)
Dialogue: 0,0:31:12.36,0:31:14.66,Default,,0,0,0,,Ах, Дораемонның моль роботы.
Dialogue: 0,0:31:15.40,0:31:17.46,Default,,0,0,0,,Жарайды, толық қуат...
Dialogue: 0,0:31:18.50,0:31:19.23,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:31:19.73,0:31:21.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:28.83,0:31:31.23,Default,,0,0,0,,Ғажайып күш Иә
Dialogue: 0,0:31:31.80,0:31:32.63,Default,,0,0,0,,Әй?
Dialogue: 0,0:31:33.30,0:31:35.53,Default,,0,0,0,,Жоқ... не? Бұл хмм
Dialogue: 0,0:31:35.63,0:31:37.63,Default,,0,0,0,,Тұман шығаратын машина емес пе?
Dialogue: 0,0:31:37.86,0:31:39.56,Default,,0,0,0,,Жарайды (Сунео) Жарайды.
Dialogue: 0,0:31:40.36,0:31:41.46,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:31:41.56,0:31:43.30,Default,,0,0,0,,Сіз мұны түсінесіз бе?
Dialogue: 0,0:31:43.40,0:31:45.23,Default,,0,0,0,,Боқтық жоқ.
Dialogue: 0,0:31:45.36,0:31:46.73,Default,,0,0,0,,О? сурет? (Сунео) Ах.
Dialogue: 0,0:31:46.86,0:31:48.86,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:31:51.40,0:31:52.36,Default,,0,0,0,,Уф
Dialogue: 0,0:31:52.70,0:31:54.73,Default,,0,0,0,,Иә? О
Dialogue: 0,0:31:54.83,0:31:56.46,Default,,0,0,0,,А, тұманда.
Dialogue: 0,0:31:56.56,0:31:58.96,Default,,0,0,0,,Сақталды! Мен қазір үйге бара алмаймын!
Dialogue: 0,0:31:59.06,0:32:00.56,Default,,0,0,0,,Yahoo! (Сунэо) Yahoo!
Dialogue: 0,0:32:00.76,0:32:02.96,Default,,0,0,0,,А, бұл шығу! (Сунео) Иә!
Dialogue: 0,0:32:03.73,0:32:06.10,Default,,0,0,0,,Уау, ностальгиялық арқа тау!
Dialogue: 0,0:32:06.20,0:32:06.86,Default,,0,0,0,,Ах
Dialogue: 0,0:32:06.96,0:32:08.36,Default,,0,0,0,,А... не? Мынау
Dialogue: 0,0:32:09.40,0:32:11.86,Default,,0,0,0,,Ах... аа... (Сунео) А...
Dialogue: 0,0:32:21.63,0:32:22.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:23.40,0:32:25.26,Default,,0,0,0,,Жоқ... не? ше?
Dialogue: 0,0:32:25.36,0:32:27.30,Default,,0,0,0,,Дәл қазір мен бір жарық көрдім.
Dialogue: 0,0:32:27.80,0:32:28.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:29.13,0:32:31.20,Default,,0,0,0,,Сіз ештеңе көрмейсіз, солай ма?
Dialogue: 0,0:32:31.56,0:32:34.20,Default,,0,0,0,,Мен су мен тамақ бар екеніне сенімдімін.
Dialogue: 0,0:32:34.30,0:32:36.70,Default,,0,0,0,,Мына тозақ сияқты жерде кім тұрады?
Dialogue: 0,0:32:36.80,0:32:38.13,Default,,0,0,0,,Бұл шайтан немесе аруақ.
Dialogue: 0,0:32:39.20,0:32:42.26,Default,,0,0,0,,Бұл баяғыда жер сілкінісі немесе соғыс немесе бір нәрсе болуы керек.
Dialogue: 0,0:32:42.36,0:32:44.10,Default,,0,0,0,,Бұл қала қиратылды.
Dialogue: 0,0:32:44.63,0:32:48.53,Default,,0,0,0,,Сәлем! Мұндай қалада су да, тамақ та жоқ!
Dialogue: 0,0:32:48.63,0:32:50.10,Default,,0,0,0,,Достарыңмен ажырасқан дұрыс сияқты.
Dialogue: 0,0:32:50.96,0:32:52.03,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:32:53.10,0:32:55.80,Default,,0,0,0,,(Сунео дауысының жаңғырығы)
Dialogue: 0,0:32:55.90,0:32:58.10,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:32:58.20,0:33:01.36,Default,,0,0,0,,(Джиан дауысының жаңғырығы)
Dialogue: 0,0:33:01.46,0:33:03.76,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:33:03.86,0:33:05.46,Default,,0,0,0,,(Сунео дауысының жаңғырығы)
Dialogue: 0,0:33:08.43,0:33:10.36,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:33:10.46,0:33:12.00,Default,,0,0,0,,Қоян мен аю
Dialogue: 0,0:33:14.16,0:33:16.96,Default,,0,0,0,,Пілдер мен жирафтар да болуы керек.
Dialogue: 0,0:33:17.70,0:33:19.86,Default,,0,0,0,,Мен кеше сонда болдым.
Dialogue: 0,0:33:19.96,0:33:21.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:33:21.83,0:33:23.86,Default,,0,0,0,,Мен үйге барғым келеді
Dialogue: 0,0:33:24.16,0:33:24.83,Default,,0,0,0,,Әй?
Dialogue: 0,0:33:26.83,0:33:27.86,Default,,0,0,0,,Эй (Нобита) Иә?
Dialogue: 0,0:33:28.00,0:33:30.20,Default,,0,0,0,,Әлгі төбе бұлыңғыр жарқырай бастады.
Dialogue: 0,0:33:30.30,0:33:32.36,Default,,0,0,0,,Иә (Нобита) Бұл рас.
Dialogue: 0,0:33:36.03,0:33:38.10,Default,,0,0,0,,Баспалдақтар жарқырап тұр
Dialogue: 0,0:33:38.20,0:33:39.93,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:33:42.83,0:33:44.60,Default,,0,0,0,,Барайық (Шидзука/Нобита) Иә.
Dialogue: 0,0:33:44.80,0:33:48.60,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:33:48.93,0:33:50.53,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:33:50.66,0:33:51.53,Default,,0,0,0,,Әй?
Dialogue: 0,0:33:52.16,0:33:54.30,Default,,0,0,0,,Уау~
Dialogue: 0,0:34:04.16,0:34:06.00,Default,,0,0,0,,Уау~ Уау~ Әдемі.
Dialogue: 0,0:34:06.10,0:34:08.00,Default,,0,0,0,,Құттықтау Құттықтау
Dialogue: 0,0:34:08.10,0:34:10.43,Default,,0,0,0,,Жаңа жыл құтты болсын
Dialogue: 0,0:34:10.93,0:34:13.90,Default,,0,0,0,,Құттықтаймыз Жаңа жыл құтты болсын
Dialogue: 0,0:34:14.19,0:34:16.36,Default,,0,0,0,,үшін бірден шықты.
Dialogue: 0,0:34:16.86,0:34:20.86,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:34:22.76,0:34:24.60,Default,,0,0,0,,Жануарлар көп
Dialogue: 0,0:34:24.73,0:34:26.60,Default,,0,0,0,,Дұрыс па? Бұл таңқаларлық емес пе?
Dialogue: 0,0:34:26.69,0:34:29.26,Default,,0,0,0,,Бүгін бұл елде Жаңа жыл болды ма?
Dialogue: 0,0:34:29.90,0:34:31.23,Default,,0,0,0,,Бәрің қайда бара жатырсыңдар?
Dialogue: 0,0:34:31.33,0:34:32.73,Default,,0,0,0,,Бірдей бағыт
Dialogue: 0,0:34:33.53,0:34:36.83,Default,,0,0,0,,Жарайды, жеңіл баспалдақ.
Dialogue: 0,0:34:37.06,0:34:39.50,Default,,0,0,0,,үшін намаз оқиды.
Dialogue: 0,0:34:39.60,0:34:42.33,Default,,0,0,0,,Ойланып қарасам, намаз оқып үйге барамын.
Dialogue: 0,0:34:42.43,0:34:47.06,Default,,0,0,0,,Жарайды, бұл жаңа жылдық сапар сияқты.
Dialogue: 0,0:34:53.73,0:34:55.60,Default,,0,0,0,,Өтінемін, иә.
Dialogue: 0,0:34:55.93,0:34:57.83,Default,,0,0,0,,А, бұл Чиппо!
Dialogue: 0,0:34:57.93,0:34:59.06,Default,,0,0,0,,Сәлем Чиппо!
Dialogue: 0,0:34:59.43,0:35:01.83,Default,,0,0,0,,Нобита-кун! О, құттықтаймын!
Dialogue: 0,0:35:01.93,0:35:03.66,Default,,0,0,0,,Е-е, құттықтаймын.
Dialogue: 0,0:35:03.80,0:35:06.26,Default,,0,0,0,,Бұл біртүрлі, бірақ құттықтаймын.
Dialogue: 0,0:35:06.33,0:35:09.00,Default,,0,0,0,,Мен сені досым Шизука-чанмен таныстырамын
Dialogue: 0,0:35:09.10,0:35:10.10,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:35:10.16,0:35:12.00,Default,,0,0,0,,Бұл Шидзука қоян.
Dialogue: 0,0:35:12.56,0:35:13.96,Default,,0,0,0,,Ал мынау... хехехе
Dialogue: 0,0:35:14.23,0:35:15.96,Default,,0,0,0,,Мен Тануки мырзаны білемін.
Dialogue: 0,0:35:16.26,0:35:19.40,Default,,0,0,0,,Иә? Мысық тәрізді робот! Қазірдің өзінде...
Dialogue: 0,0:35:20.50,0:35:23.83,Default,,0,0,0,,Бұл жерде көп болдыңыз, қайда тығылып жүрсіз?
Dialogue: 0,0:35:24.43,0:35:26.26,Default,,0,0,0,,Бұл үлкен түн
Dialogue: 0,0:35:26.33,0:35:29.10,Default,,0,0,0,,Түн ортасына дейін үйде отыру керек.
Dialogue: 0,0:35:29.26,0:35:30.33,Default,,0,0,0,,Үлкен кешігу?
Dialogue: 0,0:35:30.73,0:35:33.83,Default,,0,0,0,,Кез келген жағдайда, балалар, сізде үлкен топтасу болған жоқ па?
Dialogue: 0,0:35:33.93,0:35:35.30,Default,,0,0,0,,Неліктен бұлай етер едіңіз?
Dialogue: 0,0:35:35.80,0:35:37.80,Default,,0,0,0,,О, сен білмейсің бе!?
Dialogue: 0,0:35:37.90,0:35:39.66,Default,,0,0,0,,Әй, сен ешқашан Жазбаларды оқыған жоқсың ба?
Dialogue: 0,0:35:39.76,0:35:41.13,Default,,0,0,0,,Сіз оны балабақшада үйренбедіңіз бе?
Dialogue: 0,0:35:41.23,0:35:42.83,Default,,0,0,0,,Саған анаң мен әкең сабақ бермеді ме?
Dialogue: 0,0:35:42.96,0:35:44.90,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:35:45.00,0:35:47.16,Default,,0,0,0,,Нобита-кун мені сынап жатыр.
Dialogue: 0,0:35:47.30,0:35:50.33,Default,,0,0,0,,Бұл дүниеде жалқаулықты білмейтін адам бар ма?
Dialogue: 0,0:35:50.43,0:35:51.66,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:35:52.06,0:35:53.43,Default,,0,0,0,,Кел, Чиппо.
Dialogue: 0,0:35:53.50,0:35:55.63,Default,,0,0,0,,Жазба туралы әңгімелеу Сіз мұны дұрыс жасай аласыз ба?
Dialogue: 0,0:35:56.40,0:35:59.63,Default,,0,0,0,,Қолымнан келеді, Ертегідей бала емеспін.
Dialogue: 0,0:36:00.20,0:36:02.63,Default,,0,0,0,,Бұл ертегі емес, бұл миф.
Dialogue: 0,0:36:03.30,0:36:04.56,Default,,0,0,0,,Мен... түсінемін.
Dialogue: 0,0:36:05.06,0:36:07.30,Default,,0,0,0,,Олай болса мен сенен бірнәрсе сұрайын.
Dialogue: 0,0:36:07.40,0:36:09.16,Default,,0,0,0,,Ел басы туралы әңгіме
Dialogue: 0,0:36:09.23,0:36:11.53,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:36:12.30,0:36:15.33,Default,,0,0,0,,Баяғыда біздің ата-бабаларымыз
Dialogue: 0,0:36:15.40,0:36:17.63,Default,,0,0,0,,Мен сол айда өмір сүрдім
Dialogue: 0,0:36:20.36,0:36:22.90,Default,,0,0,0,,Дегенмен, айды басқарған адам
Dialogue: 0,0:36:23.00,0:36:24.96,Default,,0,0,0,,Ол Нимуге деген жын болды.
Dialogue: 0,0:36:25.73,0:36:28.90,Default,,0,0,0,,Жындар ата-бабамызды өз қалауынша қорлады.
Dialogue: 0,0:36:30.06,0:36:31.90,Default,,0,0,0,,Құдай мені аяды.
Dialogue: 0,0:36:32.03,0:36:34.30,Default,,0,0,0,,Ата-бабамыз алысқа қашсын
Dialogue: 0,0:36:34.40,0:36:37.40,Default,,0,0,0,,Мен бұл планетаға жұлдызды кемемен келдім.
Dialogue: 0,0:36:38.33,0:36:41.90,Default,,0,0,0,,Ол кезде бұл планета бос дүние болатын.
Dialogue: 0,0:36:42.20,0:36:45.33,Default,,0,0,0,,Құдай өсімдіктерді отырғызып, оларды тірі планетаға айналдырды.
Dialogue: 0,0:36:46.03,0:36:47.23,Default,,0,0,0,,Бірақ мәселе сонда
Dialogue: 0,0:36:47.33,0:36:49.83,Default,,0,0,0,,Мәселе оны осында қалай жеткізуге болады.
Dialogue: 0,0:36:50.63,0:36:54.46,Default,,0,0,0,,Құдай жаңа жыл түнінде ұйқының сыбызғысын үрледі.
Dialogue: 0,0:36:55.46,0:36:57.36,Default,,0,0,0,,Жындардың бәрі ұйықтап жатыр.
Dialogue: 0,0:36:57.46,0:37:00.60,Default,,0,0,0,,Біздің ата-бабаларымыз алдын ала алған әшекейлерін пайдаланған.
Dialogue: 0,0:37:00.70,0:37:02.23,Default,,0,0,0,,Ешкім ұйықтамады
Dialogue: 0,0:37:02.43,0:37:06.86,Default,,0,0,0,,Осылайша Құдай Айға жарық баспалдағын іліп, оны құтқарды.
Dialogue: 0,0:37:07.46,0:37:09.06,Default,,0,0,0,,Құттықтау Құттықтау
Dialogue: 0,0:37:10.70,0:37:14.13,Default,,0,0,0,,Сондықтан Алланың рақымын ұмытпа
Dialogue: 0,0:37:14.26,0:37:17.23,Default,,0,0,0,,Мифтерге байланысты оқиғалар әлі де бар.
Dialogue: 0,0:37:17.63,0:37:20.70,Default,,0,0,0,,Ал, мен бұл жоспарды биыл орындаймын.
Dialogue: 0,0:37:21.10,0:37:22.30,Default,,0,0,0,,Қаһарман болуды армандап, беделді U.A. орта мектебінің Қаһармандар курсына оқуға түстім
Dialogue: 0,0:37:22.63,0:37:25.46,Default,,0,0,0,,Сіз мұны құпия жоспар деп айттыңыз.
Dialogue: 0,0:37:25.56,0:37:28.53,Default,,0,0,0,,Жарық баспалдағын және жұлдызды кемені ашыңыз
Dialogue: 0,0:37:28.63,0:37:29.80,Default,,0,0,0,,Иә!?
Dialogue: 0,0:37:29.90,0:37:31.46,Default,,0,0,0,,Өйткені бұл миф, солай ма?
Dialogue: 0,0:37:31.56,0:37:33.60,Default,,0,0,0,,Бұл өткеннен қалған миф емес пе?
Dialogue: 0,0:37:33.70,0:37:34.86,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:37:36.46,0:37:37.56,Default,,0,0,0,,Бұл ешкімде жоқ.
Dialogue: 0,0:37:37.80,0:37:39.53,Default,,0,0,0,,Иә, жазғы демалыста
Dialogue: 0,0:37:39.63,0:37:43.80,Default,,0,0,0,,Бұл елдегі әкемнің шатырынан тауып алған ескі құжат.
Dialogue: 0,0:37:44.06,0:37:44.86,Default,,0,0,0,,Амансың ба? (Нобита және басқалар) Иә
Dialogue: 0,0:37:44.96,0:37:47.53,Default,,0,0,0,,Мұнда «тыйым салынған орманның тереңінде»
Dialogue: 0,0:37:48.13,0:37:51.96,Default,,0,0,0,,Онда «Бұл жерде жарық баспалдақтары мен жұлдызды кемелер жерленген» делінген.
Dialogue: 0,0:37:52.06,0:37:53.60,Default,,0,0,0,,Иә
Dialogue: 0,0:37:53.70,0:37:55.46,Default,,0,0,0,,«Тыйым салынған орман» дегеніміз не?
Dialogue: 0,0:37:55.56,0:37:57.30,Default,,0,0,0,,Бұл планетада бір ғана
Dialogue: 0,0:37:57.40,0:37:59.80,Default,,0,0,0,,Бұл орман, оған ешкім кірмейді.
Dialogue: 0,0:37:59.93,0:38:03.53,Default,,0,0,0,,Демек, көне заманнан қалған дүниелердің болуы таңқаларлық емес.
Dialogue: 0,0:38:03.86,0:38:05.86,Default,,0,0,0,,Қызық емес
Dialogue: 0,0:38:06.46,0:38:09.00,Default,,0,0,0,,Мен сені міндетті түрде келерсің деп ойладым.
Dialogue: 0,0:38:09.10,0:38:11.00,Default,,0,0,0,,Чиппо! Қазірдің өзінде кеш
Dialogue: 0,0:38:11.10,0:38:12.83,Default,,0,0,0,,Ерте жат!
Dialogue: 0,0:38:13.36,0:38:14.96,Default,,0,0,0,,Иә
Dialogue: 0,0:38:16.46,0:38:18.03,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:38:31.10,0:38:33.26,Default,,0,0,0,,Ух... (Сунео) А...
Dialogue: 0,0:38:36.03,0:38:38.83,Default,,0,0,0,,Арттағы тауға қайтуға болады деп ойлайсың ба?
Dialogue: 0,0:38:39.26,0:38:41.03,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:38:41.36,0:38:42.60,Default,,0,0,0,,Мүлдем әлдеқашан (Сунео) А?
Dialogue: 0,0:38:42.70,0:38:45.30,Default,,0,0,0,,Сіз жауапсызсыз
Dialogue: 0,0:38:46.20,0:38:47.63,Default,,0,0,0,,500 метр радиустағы тұрғындар да көшірілді.
Dialogue: 0,0:38:47.70,0:38:48.83,Default,,0,0,0,,Тыныш
Dialogue: 0,0:38:49.53,0:38:51.13,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:38:51.93,0:38:53.93,Default,,0,0,0,,Артымнан біреу келе жатқандай
Dialogue: 0,0:38:54.26,0:38:56.86,Default,,0,0,0,,Қанша іздесең де ешкімді таппадың.
Dialogue: 0,0:38:57.26,0:38:59.13,Default,,0,0,0,,Мен дәл осылай сезіндім.
Dialogue: 0,0:38:59.20,0:39:00.50,Default,,0,0,0,,Эй, бұл шығу.
Dialogue: 0,0:39:00.60,0:39:01.66,Default,,0,0,0,,А, сен бірінші барасың (Сунео) Иә?
Dialogue: 0,0:39:01.76,0:39:03.90,Default,,0,0,0,,Қараңдар, қараңдар! (Сунео) Солай...
Dialogue: 0,0:39:04.06,0:39:06.26,Default,,0,0,0,,Жарайды... түпкі орман ғой.
Dialogue: 0,0:39:06.36,0:39:07.76,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,0:39:08.00,0:39:10.53,Default,,0,0,0,,Мен тағы бір қадам баса алмаймын.
Dialogue: 0,0:39:10.60,0:39:12.83,Default,,0,0,0,,Қайтадан кірейік, Джан.
Dialogue: 0,0:39:12.93,0:39:15.86,Default,,0,0,0,,Мені жалғыз қалдырыңыз! Мен осы жерде өлемін!
Dialogue: 0,0:39:16.70,0:39:19.33,Default,,0,0,0,,Анам мен Джайкоға сәлем айтыңыз.
Dialogue: 0,0:39:19.70,0:39:22.76,Default,,0,0,0,,Уа, эй, сен неге бұл бетті жасайсың?
Dialogue: 0,0:39:23.03,0:39:27.23,Default,,0,0,0,,Бұл бетті жасауды доғар, иә? Сен қалжыңдап тұрсың ба?
Dialogue: 0,0:39:29.43,0:39:31.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:31.33,0:39:33.83,Default,,0,0,0,,Уау, күте тұрыңыз! Гайя!
Dialogue: 0,0:39:34.03,0:39:35.23,Default,,0,0,0,,Мен бір қадам да жүре алмаймын...
Dialogue: 0,0:39:35.30,0:39:37.93,Default,,0,0,0,,Шу, бұл басқаша.
Dialogue: 0,0:39:38.00,0:39:38.86,Default,,0,0,0,,Джан!
Dialogue: 0,0:39:39.60,0:39:43.60,Default,,0,0,0,,(Сунео мен Джианның ауыр тыныс алуы)
Dialogue: 0,0:39:46.70,0:39:50.23,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:39:50.43,0:39:54.66,Default,,0,0,0,,Ха... Не болса да, мен енді сенен кейін келмеймін, ха.
Dialogue: 0,0:39:55.20,0:39:57.26,Default,,0,0,0,,Ах, Джан, біз орман арқылы өттік!
Dialogue: 0,0:39:57.36,0:39:59.56,Default,,0,0,0,,Не? Мен оны істедім! (Сунео) Ия!
Dialogue: 0,0:39:59.66,0:40:01.86,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:40:01.93,0:40:04.43,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,0:40:04.56,0:40:05.26,Default,,0,0,0,,Бұл қан сенікі емес; бұл Абдулдің қаны.
Dialogue: 0,0:40:05.40,0:40:06.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:40:07.56,0:40:09.36,Default,,0,0,0,,Орманнан кейін өзен бар ма?
Dialogue: 0,0:40:09.43,0:40:11.06,Default,,0,0,0,,Менің күшім таусылды
Dialogue: 0,0:40:11.50,0:40:13.76,Default,,0,0,0,,Сәттілік, Сунео!
Dialogue: 0,0:40:14.76,0:40:16.93,Default,,0,0,0,,Уф бу бу бу ха
Dialogue: 0,0:40:17.03,0:40:19.76,Default,,0,0,0,,Ей, мен өлейін деп жатырмын, ха.
Dialogue: 0,0:40:19.86,0:40:21.60,Default,,0,0,0,,Сунео, жақсысың ба?
Dialogue: 0,0:40:21.70,0:40:23.73,Default,,0,0,0,,Енді жоқ~
Dialogue: 0,0:40:23.93,0:40:25.40,Default,,0,0,0,,Сунео!
Dialogue: 0,0:40:25.90,0:40:29.23,Default,,0,0,0,,Сәттілік Сунео! Хаха...
Dialogue: 0,0:40:29.33,0:40:32.60,Default,,0,0,0,,Сунео, бетіңді көрсет! Күн…
Dialogue: 0,0:40:34.90,0:40:38.60,Default,,0,0,0,,Ооои Сунео... уф
Dialogue: 0,0:40:41.50,0:40:43.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:48.10,0:40:49.53,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:40:50.93,0:40:53.83,Default,,0,0,0,,Иә? Эй, сен Гориро емессің бе?
Dialogue: 0,0:40:53.93,0:40:56.90,Default,,0,0,0,,Иә? Уа, жүр... жүр... горилла! Уф
Dialogue: 0,0:40:57.00,0:41:00.30,Default,,0,0,0,,Горилла болсам да, мен нені қалдырамын?
Dialogue: 0,0:41:00.56,0:41:02.33,Default,,0,0,0,,Жүр... горилла сөйлеп тұр!
Dialogue: 0,0:41:02.80,0:41:05.90,Default,,0,0,0,,Маған «Тыйым салынған орманға» жақын суға түспеу керек!
Dialogue: 0,0:41:06.00,0:41:08.76,Default,,0,0,0,,Ақымақ! Уф...
Dialogue: 0,0:41:09.13,0:41:12.23,Default,,0,0,0,,Иә? ше? Мен бұл өсетініне сене алмаймын
Dialogue: 0,0:41:12.33,0:41:14.00,Default,,0,0,0,,Ақымақ қаншық
Dialogue: 0,0:41:14.10,0:41:17.83,Default,,0,0,0,,Сәлем Гориро! Өз-өзіңді күт!
Dialogue: 0,0:41:17.96,0:41:19.76,Default,,0,0,0,,Не? әке
Dialogue: 0,0:41:20.10,0:41:21.83,Default,,0,0,0,,Эй, сен осындасың ба?
Dialogue: 0,0:41:21.93,0:41:22.90,Default,,0,0,0,,О?
Dialogue: 0,0:41:23.60,0:41:26.23,Default,,0,0,0,,Сонда бұл бала кім?
Dialogue: 0,0:41:26.63,0:41:29.56,Default,,0,0,0,,Бұл менің туыстарымның бірі болды ма?
Dialogue: 0,0:41:32.93,0:41:37.23,Default,,0,0,0,,♪ Жыл басында
Dialogue: 0,0:41:37.33,0:41:41.26,Default,,0,0,0,,♪ Мысалы
Dialogue: 0,0:41:41.33,0:41:46.00,Default,,0,0,0,,♪ Шексіз әлем...
Dialogue: 0,0:41:46.13,0:41:48.40,Default,,0,0,0,,Әке, бұл кім?
Dialogue: 0,0:41:48.50,0:41:50.13,Default,,0,0,0,,Не? ше? ше?
Dialogue: 0,0:41:54.50,0:41:56.80,Default,,0,0,0,,Әй, сен, сен, оян.
Dialogue: 0,0:41:56.90,0:41:59.16,Default,,0,0,0,,Мен осындай жерде ұйықтап қалдым.
Dialogue: 0,0:41:59.73,0:42:02.23,Default,,0,0,0,,Папа, бұл түлкі екеніне сенімдімін.
Dialogue: 0,0:42:02.70,0:42:04.90,Default,,0,0,0,,Мүмкін ол суға батып кеткен шығар?
Dialogue: 0,0:42:05.03,0:42:06.73,Default,,0,0,0,,А, солай шығар.
Dialogue: 0,0:42:07.23,0:42:10.06,Default,,0,0,0,,Жаңа жылдың басында сен сондай ақымақ адамсың.
Dialogue: 0,0:42:10.66,0:42:12.06,Default,,0,0,0,,Әй, қолыңнан келгеннің бәрін істе
Dialogue: 0,0:42:16.23,0:42:18.20,Default,,0,0,0,,Бұл пошта.
Dialogue: 0,0:42:19.23,0:42:20.33,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:42:20.80,0:42:21.73,Default,,0,0,0,,Міне.
Dialogue: 0,0:42:27.03,0:42:28.13,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:42:30.83,0:42:32.20,Default,,0,0,0,,Эй, сен үйдесің бе?
Dialogue: 0,0:42:32.30,0:42:34.66,Default,,0,0,0,,Е... иә, мен үйге бара жатырмын.
Dialogue: 0,0:42:34.73,0:42:37.56,Default,,0,0,0,,Чиппо ше? (Нобита) Сол жерде.
Dialogue: 0,0:42:37.66,0:42:38.46,Default,,0,0,0,,Чиппо!
Dialogue: 0,0:42:38.56,0:42:40.13,Default,,0,0,0,,Ұсқынсыз
Dialogue: 0,0:42:40.23,0:42:41.66,Default,,0,0,0,,Не болды? (телефон қоңырау үні)
Dialogue: 0,0:42:42.36,0:42:43.90,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:42:47.13,0:42:49.56,Default,,0,0,0,,Иә, бұл Вангель.
Dialogue: 0,0:42:49.96,0:42:53.20,Default,,0,0,0,,Ал, екі бала жоғалып кетті ме? Суға батып кете жаздадың ба?
Dialogue: 0,0:42:53.30,0:42:55.03,Default,,0,0,0,,Иә, мен бірден хабарласамын.
Dialogue: 0,0:42:57.06,0:42:59.00,Default,,0,0,0,,Горилла мен түлкіге ұқсайды.
Dialogue: 0,0:42:59.06,0:43:00.93,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:43:01.03,0:43:02.03,Default,,0,0,0,,Жарайды, мен қазір барамын.
Dialogue: 0,0:43:02.43,0:43:05.03,Default,,0,0,0,,Сіз естідіңіз бе? горилла мен түлкі
Dialogue: 0,0:43:05.53,0:43:06.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:43:07.53,0:43:10.43,Default,,0,0,0,,Ха, бұл ерекше жаңа жыл мерекесі.
Dialogue: 0,0:43:10.53,0:43:11.93,Default,,0,0,0,,Оқиға болса, көмектесу мүмкін емес.
Dialogue: 0,0:43:15.06,0:43:17.56,Default,,0,0,0,,Эй, мен де барамын!
Dialogue: 0,0:43:17.63,0:43:18.46,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:43:23.60,0:43:25.13,Default,,0,0,0,,(Джан мен Сунеоның жылауы)
Dialogue: 0,0:43:25.26,0:43:28.73,Default,,0,0,0,,Мен сенен қай жақтансың, есімің кім деп сұрадым.
Dialogue: 0,0:43:28.80,0:43:31.43,Default,,0,0,0,,Мен түсінбейтін нәрселерді айта бер.
Dialogue: 0,0:43:31.53,0:43:32.86,Default,,0,0,0,,Сәлем Горилла-кун
Dialogue: 0,0:43:33.20,0:43:35.56,Default,,0,0,0,,Мен енді горилла емеспін
Dialogue: 0,0:43:35.93,0:43:37.53,Default,,0,0,0,,Олай болса, түлкі.
Dialogue: 0,0:43:37.96,0:43:40.46,Default,,0,0,0,,Не? Жұмыс істемей жатыр…
Dialogue: 0,0:43:40.56,0:43:42.86,Default,,0,0,0,,(Джиан мен Сунеоның жылауы)
Dialogue: 0,0:43:42.96,0:43:45.03,Default,,0,0,0,,Джан! (Нобита) Сунео!
Dialogue: 0,0:43:45.20,0:43:45.90,Default,,0,0,0,,Ой! (Сунео) Ах!
Dialogue: 0,0:43:45.96,0:43:47.36,Default,,0,0,0,,Жан достар!
Dialogue: 0,0:43:47.46,0:43:48.56,Default,,0,0,0,,Сәлем балалар
Dialogue: 0,0:43:48.63,0:43:49.96,Default,,0,0,0,,Дорэмон Джиан
Dialogue: 0,0:43:50.10,0:43:50.76,Default,,0,0,0,,Әй?
Dialogue: 0,0:43:50.86,0:43:52.80,Default,,0,0,0,,Сунео-сан қатты
Dialogue: 0,0:43:53.46,0:43:56.13,Default,,0,0,0,,Шаршадық...
Dialogue: 0,0:43:56.23,0:43:57.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:43:57.43,0:43:59.13,Default,,0,0,0,,Джан! Тұрақты!
Dialogue: 0,0:43:59.23,0:44:00.20,Default,,0,0,0,,Сунео!
Dialogue: 0,0:44:09.50,0:44:13.50,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:44:16.10,0:44:18.66,Default,,0,0,0,,Уа, келме, келме.
Dialogue: 0,0:44:18.76,0:44:20.86,Default,,0,0,0,,Анашым! Анашым!
Dialogue: 0,0:44:21.03,0:44:23.36,Default,,0,0,0,,Анашым, көмектесіңізші
Dialogue: 0,0:44:23.46,0:44:25.93,Default,,0,0,0,,Анашым, көмектесіңізші, көмектесіңізші!
Dialogue: 0,0:44:26.03,0:44:29.00,Default,,0,0,0,,Келме Келме Келме!
Dialogue: 0,0:44:29.10,0:44:32.13,Default,,0,0,0,,Ұйқыда қатты сөйлейтінім сонша, енді ұйықтай алмаймын.
Dialogue: 0,0:44:32.20,0:44:33.36,Default,,0,0,0,,Неге қорқасың?
Dialogue: 0,0:44:33.50,0:44:35.43,Default,,0,0,0,,Тәкаппар, арсыз, ақымақ
Dialogue: 0,0:44:35.53,0:44:36.83,Default,,0,0,0,,Шыққан Джиан
Dialogue: 0,0:44:36.93,0:44:38.50,Default,,0,0,0,,Кім сезімсіз? (Сунео) Ха!
Dialogue: 0,0:44:39.13,0:44:41.86,Default,,0,0,0,,А, сен ояндың ба? Жақсы
Dialogue: 0,0:44:41.96,0:44:42.70,Default,,0,0,0,,Бұл (Сунео) Уау!
Dialogue: 0,0:44:43.26,0:44:45.16,Default,,0,0,0,,Сіз ақымақ күшпен шығуға тырысасыз ба?
Dialogue: 0,0:44:45.26,0:44:46.20,Default,,0,0,0,,Қайтадан айтыңыз
Dialogue: 0,0:44:46.33,0:44:49.16,Default,,0,0,0,,Уау, қазір екеуміз де жақсы сезінеміз.
Dialogue: 0,0:44:49.53,0:44:52.63,Default,,0,0,0,,А, байқадым, ес-түссіз қалдық.
Dialogue: 0,0:44:53.30,0:44:56.10,Default,,0,0,0,,Балалар сендер екі күн ұйықтадыңдар.
Dialogue: 0,0:44:56.43,0:44:58.03,Default,,0,0,0,,Екі күн бойы!?
Dialogue: 0,0:44:58.50,0:45:01.06,Default,,0,0,0,,Бірақ жақсы болсаң, жақсы боласың.
Dialogue: 0,0:45:01.90,0:45:03.16,Default,,0,0,0,,Мен ауруханадан шыққаныма қуаныштымын.
Dialogue: 0,0:45:03.26,0:45:05.20,Default,,0,0,0,,Жақсы (Нобита) Жақсы~
Dialogue: 0,0:45:05.26,0:45:06.03,Default,,0,0,0,,«үшінн мен үшін» мұрагері…
Dialogue: 0,0:45:06.56,0:45:10.00,Default,,0,0,0,,Ешқашан тыйым салынған орманға енді кірмеңіз.
Dialogue: 0,0:45:10.26,0:45:11.83,Default,,0,0,0,,Маған бұл енді ұнамайды
Dialogue: 0,0:45:12.03,0:45:13.70,Default,,0,0,0,,Ешқашан барма
Dialogue: 0,0:45:16.26,0:45:19.50,Default,,0,0,0,,Барлық көмектеріңіз үшін көп рахмет.
Dialogue: 0,0:45:19.93,0:45:21.90,Default,,0,0,0,,Жерге бір рет оралайық.
Dialogue: 0,0:45:22.00,0:45:24.76,Default,,0,0,0,,Бұған дейін Чиппо-кунға сәлем беруім керек.
Dialogue: 0,0:45:24.90,0:45:27.10,Default,,0,0,0,,Сіз маған көп жағынан көмектестіңіз.
Dialogue: 0,0:45:27.76,0:45:30.56,Default,,0,0,0,,Аа, дұрыс, мынаны да кию керек.
Dialogue: 0,0:45:31.00,0:45:31.83,Default,,0,0,0,,Иә
Dialogue: 0,0:45:31.93,0:45:35.10,Default,,0,0,0,,Бізді де жануарлар ойнатпақшысың ба?
Dialogue: 0,0:45:35.20,0:45:36.53,Default,,0,0,0,,Салқын емес
Dialogue: 0,0:45:36.66,0:45:38.10,Default,,0,0,0,,(Сидзука мен Нобитаның күлкісі)
Dialogue: 0,0:45:38.73,0:45:41.03,Default,,0,0,0,,Бұл жануарлар елі.
Dialogue: 0,0:45:41.10,0:45:43.43,Default,,0,0,0,,Эй, бұл мектеп шоуы емес.
Dialogue: 0,0:45:44.43,0:45:45.93,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:45:46.60,0:45:48.66,Default,,0,0,0,,Аа, оны киіп алсаңыз да, көп нәрсе өзгермейді.
Dialogue: 0,0:45:48.76,0:45:49.76,Default,,0,0,0,,Ммм (Сунео) Ахахаха
Dialogue: 0,0:45:49.90,0:45:50.86,Default,,0,0,0,,Тағы да айтыңыз!
Dialogue: 0,0:45:50.93,0:45:52.16,Default,,0,0,0,,Е, эй, эй, эй...
Dialogue: 0,0:45:52.26,0:45:54.50,Default,,0,0,0,,Джан Такеши
Dialogue: 0,0:45:58.10,0:46:00.50,Default,,0,0,0,,Таксиге немесе басқа нәрсеге отырыңыз, ақшаңыз бар ма?
Dialogue: 0,0:46:00.96,0:46:03.16,Default,,0,0,0,,Бұл тегін. Неліктен?
Dialogue: 0,0:46:03.26,0:46:05.50,Default,,0,0,0,,Өйткені ол геомагниттік энергияны пайдаланады
Dialogue: 0,0:46:05.60,0:46:07.00,Default,,0,0,0,,Жанармай шығыны жоқ
Dialogue: 0,0:46:07.96,0:46:09.83,Default,,0,0,0,,Ойлап қарасам, қозғалтқыштың шуы жоқ.
Dialogue: 0,0:46:09.96,0:46:13.56,Default,,0,0,0,,Бұл елде таза энергетика дамыған сияқты.
Dialogue: 0,0:46:13.66,0:46:15.43,Default,,0,0,0,,Демек, ауа ластанбайды.
Dialogue: 0,0:46:16.06,0:46:19.00,Default,,0,0,0,,Бұл елді шынымен жануарлар ғана жаратты ма?
Dialogue: 0,0:46:19.43,0:46:21.46,Default,,0,0,0,,Өйткені адам жоқ.
Dialogue: 0,0:46:21.93,0:46:23.16,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:46:23.26,0:46:25.66,Default,,0,0,0,,Бірдеңе дұрыс емес, мен сенбеймін
Dialogue: 0,0:46:25.80,0:46:28.16,Default,,0,0,0,,Бірақ мен бұл елді жақсы көремін
Dialogue: 0,0:46:28.83,0:46:31.80,Default,,0,0,0,,Бұл нағыз утопия емес пе?
Dialogue: 0,0:46:35.66,0:46:36.63,Default,,0,0,0,,Мен көптен күттім.
Dialogue: 0,0:46:37.43,0:46:40.16,Default,,0,0,0,,Қазір экспедиция мүшелері жиналды.
Dialogue: 0,0:46:40.30,0:46:42.06,Default,,0,0,0,,Сіздің әкеңіз немесе анаңыз ше?
Dialogue: 0,0:46:42.16,0:46:43.96,Default,,0,0,0,,Мен туыстарыма бардым, бүгін кешке қайтпаймын.
Dialogue: 0,0:46:44.06,0:46:44.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:46:44.93,0:46:46.60,Default,,0,0,0,,Экспедиция дегеніміз не?
Dialogue: 0,0:46:49.83,0:46:51.56,Default,,0,0,0,,Менің жоспарымды тыңда (Нобита) Иә.
Dialogue: 0,0:46:52.30,0:46:54.63,Default,,0,0,0,,Бұл біз тұратын жер
Dialogue: 0,0:46:54.83,0:46:56.50,Default,,0,0,0,,Осы өзеннің арғы жағында
Dialogue: 0,0:46:57.23,0:46:58.76,Default,,0,0,0,,Тыйым салынған орман бар
Dialogue: 0,0:46:58.93,0:47:00.20,Default,,0,0,0,,Көне мәтіндер бойынша
Dialogue: 0,0:47:00.30,0:47:04.13,Default,,0,0,0,,Жарық баспалдақтары мен жұлдызды кеме ұйқысын жалғастырады.
Dialogue: 0,0:47:04.23,0:47:07.20,Default,,0,0,0,,Храм қирандыларының тура оңтүстігінде
Dialogue: 0,0:47:08.40,0:47:09.53,Default,,0,0,0,,Менің ойымша, бұл осы жерде
Dialogue: 0,0:47:10.33,0:47:12.90,Default,,0,0,0,,Бірақ өзендегі осы иілуден
Dialogue: 0,0:47:13.03,0:47:15.86,Default,,0,0,0,,Бұл шығысқа қарай төте жол.
Dialogue: 0,0:47:16.40,0:47:19.80,Default,,0,0,0,,Негізі осы жолмен өткен күні салмен түстім.
Dialogue: 0,0:47:19.90,0:47:21.06,Default,,0,0,0,,Мен сәтсіздікке ұшырадым
Dialogue: 0,0:47:21.20,0:47:23.30,Default,,0,0,0,,Иә, бұл Нобита-сан мені құтқарған күн еді.
Dialogue: 0,0:47:23.83,0:47:26.90,Default,,0,0,0,,Бұл қашықтықта сіз таккоптерді пайдалана алмайсыз.
Dialogue: 0,0:47:27.03,0:47:27.73,Default,,0,0,0,,Маған да қарызға бер
Dialogue: 0,0:47:28.50,0:47:31.40,Default,,0,0,0,,Бірақ мен бір нәрсені айтуым керек.
Dialogue: 0,0:47:31.56,0:47:33.73,Default,,0,0,0,,Сол орманда елес бар.
Dialogue: 0,0:47:34.13,0:47:36.66,Default,,0,0,0,,А, солай... шықты, шықты, шықты!
Dialogue: 0,0:47:36.73,0:47:38.00,Default,,0,0,0,,А? не? (Нобита) Иә?
Dialogue: 0,0:47:38.23,0:47:39.53,Default,,0,0,0,,Иә? (Сунео) Иә?
Dialogue: 0,0:47:40.70,0:47:42.00,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:47:42.63,0:47:44.96,Default,,0,0,0,,Мен сонда болдым, терезеден саған қарап тұрдым.
Dialogue: 0,0:47:45.53,0:47:47.70,Default,,0,0,0,,Елес оқиға үшін кешіріңіз.
Dialogue: 0,0:47:47.80,0:47:51.40,Default,,0,0,0,,Тыйым салынған орманға адамдарды жібермеу үшін үлкендердің жасаған ырымдары.
Dialogue: 0,0:47:51.83,0:47:54.46,Default,,0,0,0,,Жоқ, мен оны орманда көрдім.
Dialogue: 0,0:47:54.56,0:47:56.73,Default,,0,0,0,,Бұл галлюцинация болса керек.
Dialogue: 0,0:47:56.83,0:48:00.20,Default,,0,0,0,,Мен зерттеуді ұнатпаймын. Мен үйге барғым келеді.
Dialogue: 0,0:48:00.56,0:48:02.70,Default,,0,0,0,,Кәдімгі Джианға ұқсамайды.
Dialogue: 0,0:48:02.80,0:48:05.86,Default,,0,0,0,,Мен мұнда келгеннен бері қатты қобалжыдым.
Dialogue: 0,0:48:06.23,0:48:07.80,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:48:08.73,0:48:11.93,Default,,0,0,0,,Енді қызықты зерттеуді жақсарту үшін кішкене бірдеңе жасайық.
Dialogue: 0,0:48:12.03,0:48:13.76,Default,,0,0,0,,Ой, сен маған бірдеңе қызмет етесің бе?
Dialogue: 0,0:48:14.13,0:48:16.26,Default,,0,0,0,,«Миномуши стиліндегі Небукуро»
Dialogue: 0,0:48:16.70,0:48:19.23,Default,,0,0,0,,«Котлеті бар сығымдалған шұғыл тағам»
Dialogue: 0,0:48:19.70,0:48:21.70,Default,,0,0,0,,«Лайлы су тазартқыш»
Dialogue: 0,0:48:22.23,0:48:23.63,Default,,0,0,0,,«Жіпсіз телефон»
Dialogue: 0,0:48:24.13,0:48:26.06,Default,,0,0,0,,«Ескерту отшашуы»
Dialogue: 0,0:48:26.26,0:48:29.53,Default,,0,0,0,,«Ән картасы бар шағын караоке жиынтығы»
Dialogue: 0,0:48:30.26,0:48:33.63,Default,,0,0,0,,Осы жинақтардың барлығы ықшам қорапқа салынған
Dialogue: 0,0:48:33.76,0:48:35.03,Default,,0,0,0,,(Нобита мен оның достары қуанады)
Dialogue: 0,0:48:35.46,0:48:36.70,Default,,0,0,0,,Кету!
Dialogue: 0,0:48:36.80,0:48:40.30,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:48:41.06,0:48:42.43,Default,,0,0,0,,Джиан да жылдам
Dialogue: 0,0:48:42.53,0:48:44.80,Default,,0,0,0,,Мен тағы да осылай орманға барамын ба?
Dialogue: 0,0:48:45.70,0:48:46.93,Default,,0,0,0,,Джан
Dialogue: 0,0:48:47.70,0:48:49.03,Default,,0,0,0,,Үйге қалай баруға болады
Dialogue: 0,0:48:49.10,0:48:51.43,Default,,0,0,0,,Мен сол тұманнан өтуім керек.
Dialogue: 0,0:48:51.86,0:48:53.86,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:48:54.10,0:48:56.43,Default,,0,0,0,,Иә, бұл «Такекоптер»
Dialogue: 0,0:48:56.70,0:48:57.63,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:48:58.96,0:49:00.66,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:49:00.76,0:49:02.83,Default,,0,0,0,,Күте тұрыңыз, мен жаттығуым керек.
Dialogue: 0,0:49:02.93,0:49:04.50,Default,,0,0,0,,Уаа~
Dialogue: 0,0:49:04.70,0:49:06.96,Default,,0,0,0,,Чиппо! (Нобита) Чиппо!
Dialogue: 0,0:49:15.20,0:49:16.53,Default,,0,0,0,,Үй күтушіге не болды?
Dialogue: 0,0:49:17.03,0:49:19.36,Default,,0,0,0,,Әкең келуге келмеді ме?
Dialogue: 0,0:49:19.50,0:49:21.63,Default,,0,0,0,,Күнтізбе өзгеруі мүмкін
Dialogue: 0,0:49:22.70,0:49:25.50,Default,,0,0,0,,Кешіріңіз, біз сізді шақырдық.
Dialogue: 0,0:49:25.93,0:49:29.86,Default,,0,0,0,,Екеуінің де ауруханадан шыққанына қуаныштымын.
Dialogue: 0,0:49:30.53,0:49:32.83,Default,,0,0,0,,Енді үйге бірге барайық.
Dialogue: 0,0:49:34.00,0:49:35.13,Default,,0,0,0,,Шынында, сол сырғаң өте батыл екен.
Dialogue: 0,0:49:35.20,0:49:37.70,Default,,0,0,0,,Үніңді жап, мені үйге қалдыр, сен жаман қызсың.
Dialogue: 0,0:49:37.80,0:49:39.03,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:49:39.16,0:49:40.86,Default,,0,0,0,,Чиппо-чан?
Dialogue: 0,0:49:41.70,0:49:43.83,Default,,0,0,0,,Олай айтпа, үйге қайтайық.
Dialogue: 0,0:49:44.30,0:49:45.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:46.10,0:49:46.83,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:49:47.83,0:49:49.80,Default,,0,0,0,,Сәлем Чиппо
Dialogue: 0,0:49:50.36,0:49:51.26,Default,,0,0,0,,Роми-чан!
Dialogue: 0,0:49:51.66,0:49:52.70,Default,,0,0,0,,Сен ойнауға келдің бе?
Dialogue: 0,0:49:53.26,0:49:55.16,Default,,0,0,0,,Бұл Жаңа жыл күні
Dialogue: 0,0:49:55.26,0:49:57.16,Default,,0,0,0,,Бәріміз бірге ойын ойнап, көңіл көтерейік.
Dialogue: 0,0:49:57.36,0:49:58.66,Default,,0,0,0,,Өте сүйкімді~
Dialogue: 0,0:49:59.10,0:50:01.60,Default,,0,0,0,,Ах, менің немере ағам Роми
Dialogue: 0,0:50:01.70,0:50:03.63,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:50:04.50,0:50:08.30,Default,,0,0,0,,Кешіріңіз, мен оны басқа уақытта зерттеймін...
Dialogue: 0,0:50:08.36,0:50:11.10,Default,,0,0,0,,О, мен бұған мүлдем қарсы емеспін.
Dialogue: 0,0:50:11.46,0:50:12.60,Default,,0,0,0,,Әке, үйге қайтайық.
Dialogue: 0,0:50:13.20,0:50:15.33,Default,,0,0,0,,Ха ха ха Кәне, бәріміз жиналайық
Dialogue: 0,0:50:15.70,0:50:18.26,Default,,0,0,0,,Жоқ, біз де үйге барамыз.
Dialogue: 0,0:50:19.36,0:50:21.03,Default,,0,0,0,,Әке, асығыңыз!
Dialogue: 0,0:50:21.13,0:50:22.36,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:50:22.63,0:50:23.96,Default,,0,0,0,,үшінңыз қайта келіңіздер.
Dialogue: 0,0:50:24.03,0:50:25.50,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:50:30.70,0:50:31.96,Default,,0,0,0,,Қош бол~
Dialogue: 0,0:50:32.03,0:50:33.20,Default,,0,0,0,,Мен қайта ораламын.
Dialogue: 0,0:50:37.03,0:50:39.60,Default,,0,0,0,,Жүр, біз де үйге тез жетейік.
Dialogue: 0,0:50:39.70,0:50:40.76,Default,,0,0,0,,Иә
Dialogue: 0,0:50:44.20,0:50:48.20,Default,,0,0,0,,Осы қарқынмен Чиппоның қазына іздеуі орындалмауы мүмкін.
Dialogue: 0,0:50:48.33,0:50:51.03,Default,,0,0,0,,Осылай армандаған дұрыс емес пе?
Dialogue: 0,0:50:51.70,0:50:55.00,Default,,0,0,0,,Ей, жарық баспалдақтары жай ғана миф пе?
Dialogue: 0,0:50:55.50,0:50:57.36,Default,,0,0,0,,Мені есіңде бар ғой, иә?
Dialogue: 0,0:50:57.46,0:51:00.76,Default,,0,0,0,,Жұлдыздарды қосатын баспалдақтар жоқ.
Dialogue: 0,0:51:01.23,0:51:05.23,Default,,0,0,0,,Бірақ мифтер басқа нәрсеге негізделген емес пе?
Dialogue: 0,0:51:08.90,0:51:11.10,Default,,0,0,0,,А, мен орманды көріп тұрмын.
Dialogue: 0,0:51:11.73,0:51:14.66,Default,,0,0,0,,Егер Чиппо солай айтса, бұл қорқынышты орман.
Dialogue: 0,0:51:15.60,0:51:17.33,Default,,0,0,0,,Маған ұнамайды, иә?
Dialogue: 0,0:51:17.43,0:51:19.60,Default,,0,0,0,,Мен енді орманға бармаймын деп ойлаймын.
Dialogue: 0,0:51:19.73,0:51:21.86,Default,,0,0,0,,Джан, сен не айтып тұрсың?
Dialogue: 0,0:51:21.93,0:51:23.93,Default,,0,0,0,,Маған ұнамайды, маған мүлдем ұнамайды.
Dialogue: 0,0:51:24.06,0:51:25.60,Default,,0,0,0,,Джан Ах (Нобита) Ах
Dialogue: 0,0:51:27.66,0:51:29.70,Default,,0,0,0,,Бұл галлюцинация
Dialogue: 0,0:51:29.76,0:51:32.06,Default,,0,0,0,,Бұл шынымен болған жоқ, Джан.
Dialogue: 0,0:51:33.00,0:51:35.43,Default,,0,0,0,,Мен тұманнан өтпей үйге бара алмаймын.
Dialogue: 0,0:51:35.53,0:51:38.43,Default,,0,0,0,,Тұманға түспей үйге жетудің жолын ойластыр.
Dialogue: 0,0:51:38.53,0:51:40.03,Default,,0,0,0,,Бұл Дораемон болса да
Dialogue: 0,0:51:40.10,0:51:42.43,Default,,0,0,0,,Артық айтсаң, сол жерде қалдырамын.
Dialogue: 0,0:51:42.56,0:51:46.10,Default,,0,0,0,,Қалағаныңды істе, мен мұнда көшпеймін.
Dialogue: 0,0:51:46.23,0:51:48.10,Default,,0,0,0,,Ух... кеттік!
Dialogue: 0,0:51:48.20,0:51:49.86,Default,,0,0,0,,Ах (Нобита) Ах... Иә...
Dialogue: 0,0:51:50.26,0:51:51.93,Default,,0,0,0,,Кеттік... Хмф!
Dialogue: 0,0:51:54.53,0:51:56.73,Default,,0,0,0,,Артында қалдыра алсаң, қалдыр...
Dialogue: 0,0:51:56.83,0:51:58.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:58.26,0:52:00.90,Default,,0,0,0,,Мен оны шынымен де қалдырдым.
Dialogue: 0,0:52:01.00,0:52:04.40,Default,,0,0,0,,Жүректерің суық екен, мен сені енді дос санамаймын!
Dialogue: 0,0:52:07.06,0:52:08.33,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:52:11.10,0:52:15.00,Default,,0,0,0,,Біраз уақыттан кейін ол мұңайып, сені қуады.
Dialogue: 0,0:52:15.10,0:52:16.26,Default,,0,0,0,,Сіз шынымен келе жатырсыз ба?
Dialogue: 0,0:52:19.46,0:52:22.66,Default,,0,0,0,,үшін мені қорқақ деп ойлайтын шығар.
Dialogue: 0,0:52:23.43,0:52:26.93,Default,,0,0,0,,Жоқ, менде хайуандық инстинкт бар.
Dialogue: 0,0:52:27.00,0:52:31.13,Default,,0,0,0,,Сол тұманға кіргенімде менде бір жаман сезім пайда болды. Жау болды.
Dialogue: 0,0:52:31.80,0:52:34.80,Default,,0,0,0,,Күшті, жауыз және қорқынышты жау
Dialogue: 0,0:52:39.73,0:52:41.83,Default,,0,0,0,,Бұл мүлде қыңыр.
Dialogue: 0,0:52:41.93,0:52:44.46,Default,,0,0,0,,А... (Нобита) А...
Dialogue: 0,0:52:59.16,0:53:01.36,Default,,0,0,0,,Әлі жұмыс істемейді
Dialogue: 0,0:53:01.66,0:53:04.33,Default,,0,0,0,,Оны күшпен алып кетуден басқа амалым жоқ па?
Dialogue: 0,0:53:04.40,0:53:07.23,Default,,0,0,0,,Күш? Сол Джиан?
Dialogue: 0,0:53:07.50,0:53:09.06,Default,,0,0,0,,Кім?
Dialogue: 0,0:53:11.03,0:53:13.03,Default,,0,0,0,,Эй
Dialogue: 0,0:53:13.50,0:53:14.90,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:53:15.00,0:53:17.00,Default,,0,0,0,,Гориро! Ахх
Dialogue: 0,0:53:17.66,0:53:19.96,Default,,0,0,0,,Мен тағы да сондай жерде әлсіреймін.
Dialogue: 0,0:53:20.56,0:53:22.03,Default,,0,0,0,,Гориро! Гориро!
Dialogue: 0,0:53:22.13,0:53:23.73,Default,,0,0,0,,Жақында кездескенше!
Dialogue: 0,0:53:24.16,0:53:26.33,Default,,0,0,0,,Әй, ақыры келді. Үйге барайық.
Dialogue: 0,0:53:26.40,0:53:28.33,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:53:32.46,0:53:34.63,Default,,0,0,0,,Қызғылт тұман әлі бар ма?
Dialogue: 0,0:53:34.73,0:53:37.20,Default,,0,0,0,,Мен бұл жерде болғанына сенімдімін.
Dialogue: 0,0:53:42.06,0:53:44.73,Default,,0,0,0,,Әй, мен аман едім, қызғылт тұман.
Dialogue: 0,0:53:45.46,0:53:47.13,Default,,0,0,0,,Мен осылайша асығамын.
Dialogue: 0,0:53:47.23,0:53:48.40,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:53:48.90,0:53:51.63,Default,,0,0,0,,Кенеттен секірсең, тозаққа түсесің.
Dialogue: 0,0:53:51.73,0:53:53.20,Default,,0,0,0,,Ах~
Dialogue: 0,0:53:54.06,0:53:55.66,Default,,0,0,0,,Шын мәнінде, осы уақыт ішінде...
Dialogue: 0,0:53:56.23,0:53:57.63,Default,,0,0,0,,Не?
Dialogue: 0,0:53:57.96,0:53:59.56,Default,,0,0,0,,Жерге орала алмадыңыз ба?
Dialogue: 0,0:53:59.70,0:54:00.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:01.13,0:54:02.63,Default,,0,0,0,,Түсіндім, бұл газ
Dialogue: 0,0:54:03.13,0:54:05.60,Default,,0,0,0,,Осыған ұқсас газ есімде
Dialogue: 0,0:54:05.70,0:54:09.56,Default,,0,0,0,,Тіпті 22 ғасырда Жерде сатылған.
Dialogue: 0,0:54:09.63,0:54:11.10,Default,,0,0,0,,Сонымен не істей аламыз?
Dialogue: 0,0:54:11.80,0:54:15.26,Default,,0,0,0,,Бұл газды «барлық жерде газ» деп атайды.
Dialogue: 0,0:54:15.36,0:54:18.30,Default,,0,0,0,,Ол «кез келген жердегі есік» сияқты жұмыс істейді.
Dialogue: 0,0:54:18.43,0:54:21.56,Default,,0,0,0,,Ол ақауларға толы болды және тоқтатылды.
Dialogue: 0,0:54:21.96,0:54:23.90,Default,,0,0,0,,Сондықтан мен түсіндім.
Dialogue: 0,0:54:24.13,0:54:27.56,Default,,0,0,0,,Жарықтың мифтік баспалдақтары осы газға қатысты емес пе?
Dialogue: 0,0:54:28.26,0:54:30.03,Default,,0,0,0,,Иә? баяғыда
Dialogue: 0,0:54:30.13,0:54:32.43,Default,,0,0,0,,Жарық тұманынан өтетін жануарлар
Dialogue: 0,0:54:32.53,0:54:34.70,Default,,0,0,0,,Мен бұл планетаға көшіп келдім.
Dialogue: 0,0:54:34.80,0:54:37.43,Default,,0,0,0,,Сонда бұл тұманды не жаратты...
Dialogue: 0,0:54:37.53,0:54:39.93,Default,,0,0,0,,Мифологияда ол құдай.
Dialogue: 0,0:54:40.03,0:54:42.30,Default,,0,0,0,,Ол тамаша ғалым емес пе?
Dialogue: 0,0:54:42.73,0:54:47.26,Default,,0,0,0,,Бәрі біткен соң, Құдай газ генераторын осы орманға көмді.
Dialogue: 0,0:54:47.36,0:54:49.43,Default,,0,0,0,,Мыңдаған жылдар өткен соң
Dialogue: 0,0:54:49.90,0:54:52.43,Default,,0,0,0,,Қандай да бір екпіннен газ ағып кетті.
Dialogue: 0,0:54:52.93,0:54:55.46,Default,,0,0,0,,Бұл жұлдыз болды...
Dialogue: 0,0:54:55.56,0:54:58.70,Default,,0,0,0,,Сонымен, сіз мені қостыңыз ба?
Dialogue: 0,0:54:58.80,0:55:00.13,Default,,0,0,0,,Сонда біз
Dialogue: 0,0:55:00.20,0:55:03.03,Default,,0,0,0,,Себебі мен газ генераторындағы циферблатпен шатастым...
Dialogue: 0,0:55:03.13,0:55:05.63,Default,,0,0,0,,Жерге өту жолы жоғалды.
Dialogue: 0,0:55:05.70,0:55:08.96,Default,,0,0,0,,Енді мен бұл тұманға кіргенде
Dialogue: 0,0:55:09.70,0:55:11.93,Default,,0,0,0,,Мен сол айға барамын
Dialogue: 0,0:55:13.50,0:55:15.86,Default,,0,0,0,,О? Тұман аздап сейілді
Dialogue: 0,0:55:16.00,0:55:18.70,Default,,0,0,0,,Жоқ, мен бірдеңе істеуім керек.
Dialogue: 0,0:55:19.43,0:55:22.36,Default,,0,0,0,,Газ өлшегіш нөлге жақын
Dialogue: 0,0:55:22.66,0:55:26.20,Default,,0,0,0,,Мен онымен араласпас бұрын циферблат қайда еді... хм... қайда болды?
Dialogue: 0,0:55:26.33,0:55:27.66,Default,,0,0,0,,есімде жоқ.
Dialogue: 0,0:55:27.76,0:55:29.03,Default,,0,0,0,,Бір нәрсені тез орындаңыз
Dialogue: 0,0:55:29.66,0:55:32.03,Default,,0,0,0,,Егер нөмірді кері бұрмасаңыз, үйге бара алмайсыз.
Dialogue: 0,0:55:32.53,0:55:34.46,Default,,0,0,0,,«Уақыт ұлғайтқыш әйнегі»
Dialogue: 0,0:55:34.53,0:55:35.26,Default,,0,0,0,,Дора-чан
Dialogue: 0,0:55:35.36,0:55:38.93,Default,,0,0,0,,3 күн бұрынғы нөмір... Мм...
Dialogue: 0,0:55:35.36,0:55:38.93,Default,,0,0,0,,Асығыңыз, асығыңыз... Дораемон!
Dialogue: 0,0:55:40.53,0:55:43.20,Default,,0,0,0,,Мен оны қайтадан біріктірдім деп ойладым. Тезірек газға отырыңыз!
Dialogue: 0,0:55:43.30,0:55:44.33,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:55:45.03,0:55:46.60,Default,,0,0,0,,Әйтеуір, газ жойылмай тұрып
Dialogue: 0,0:55:46.70,0:55:48.70,Default,,0,0,0,,Менің ойымша, біз Жерге орала аламыз ба?
Dialogue: 0,0:55:49.36,0:55:50.13,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:55:51.00,0:55:52.10,Default,,0,0,0,,Газ жоғалады!
Dialogue: 0,0:55:52.66,0:55:55.03,Default,,0,0,0,,Бұл шықты! (Нобита және басқалар) Уф
Dialogue: 0,0:55:57.20,0:55:57.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:01.93,0:56:02.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:06.60,0:56:07.66,Default,,0,0,0,,Ооо
Dialogue: 0,0:56:08.33,0:56:10.76,Default,,0,0,0,,Бұл мектептің артындағы тау.
Dialogue: 0,0:56:10.93,0:56:12.93,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:56:13.03,0:56:13.90,Default,,0,0,0,,Ура!
Dialogue: 0,0:56:14.00,0:56:16.43,Default,,0,0,0,,Джиан Иә, бұл жақсы болды.
Dialogue: 0,0:56:16.56,0:56:20.56,Default,,0,0,0,,(Сунео мен Джианның жылауы)
Dialogue: 0,0:56:24.43,0:56:26.10,Default,,0,0,0,,Бұл жақсы. Иә, шынымен, шынымен.
Dialogue: 0,0:56:26.20,0:56:27.26,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:56:27.36,0:56:28.93,Default,,0,0,0,,Мен үйге аман-есен жеттім, бірақ
Dialogue: 0,0:56:29.06,0:56:32.10,Default,,0,0,0,,Мен Чиппо-кунды енді көре алмаймын деп ойлаймын.
Dialogue: 0,0:56:32.23,0:56:32.83,Default,,0,0,0,,Иә...
Dialogue: 0,0:56:33.70,0:56:35.66,Default,,0,0,0,,Дос болып қалар едік.
Dialogue: 0,0:56:35.76,0:56:36.43,Default,,0,0,0,,Иә
Dialogue: 0,0:56:36.56,0:56:39.16,Default,,0,0,0,,Осы ғаламдағы қандай да бір планетада
Dialogue: 0,0:56:39.26,0:56:41.10,Default,,0,0,0,,Керемет ел бар
Dialogue: 0,0:56:41.23,0:56:42.20,Default,,0,0,0,,Онда барыңыз
Dialogue: 0,0:56:42.26,0:56:46.23,Default,,0,0,0,,Маған жағымды түс көрсеттің деп ойлаңыз.
Dialogue: 0,0:56:49.40,0:56:50.33,Default,,0,0,0,,Қош бол, көріскенше
Dialogue: 0,0:56:50.43,0:56:52.60,Default,,0,0,0,,Қош бол (Нобита/Дораемон) Қайырлы түн
Dialogue: 0,0:56:56.90,0:56:58.93,Default,,0,0,0,,Чиппо әлі ұйықтап қалды ма?
Dialogue: 0,0:56:59.03,0:57:00.16,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:57:03.06,0:57:04.96,Default,,0,0,0,,Қайырлы түн Чиппо
Dialogue: 0,0:57:17.56,0:57:19.40,Default,,0,0,0,,үшінң тыңдаңдар.
Dialogue: 0,0:57:19.83,0:57:23.16,Default,,0,0,0,,Мен оны өз көзіммен көрдім.
Dialogue: 0,0:57:23.73,0:57:27.83,Default,,0,0,0,,Көрші планетада жануарлар көңілді.
Dialogue: 0,0:57:27.93,0:57:29.26,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:57:29.33,0:57:33.30,Default,,0,0,0,,Бұл жасыл желекке толы әдемі, бай планета.
Dialogue: 0,0:57:33.40,0:57:36.30,Default,,0,0,0,,Не!? Қандай ұятсыз
Dialogue: 0,0:57:36.43,0:57:39.66,Default,,0,0,0,,Біз соншалықты аянышты түрде аман қалдық.
Dialogue: 0,0:57:40.10,0:57:42.76,Default,,0,0,0,,Ескі жоспарыңызды жүзеге асыруға асығыңыз.
Dialogue: 0,0:57:42.96,0:57:46.66,Default,,0,0,0,,Жануарларды жеңіп, оны біздің әлемге айналдыр!
Dialogue: 0,0:57:46.76,0:57:47.93,Default,,0,0,0,,О!
Dialogue: 0,0:57:49.10,0:57:49.96,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:57:54.13,0:57:55.16,Default,,0,0,0,,Не болды?
Dialogue: 0,0:57:55.30,0:57:57.23,Default,,0,0,0,,Жұлдыз гүлі солып жатыр
Dialogue: 0,0:57:57.33,0:57:59.40,Default,,0,0,0,,Ал, гүл ғой, солып қалады.
Dialogue: 0,0:57:59.83,0:58:01.20,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:58:01.40,0:58:03.73,Default,,0,0,0,,Мен бірдеңе дұрыс емес сияқты сезінемін.
Dialogue: 0,0:58:03.86,0:58:07.23,Default,,0,0,0,,Сіз нені кешіктіресіз? Сіз сабаққа кешігіп келесіз
Dialogue: 0,0:58:07.33,0:58:08.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:58:10.23,0:58:11.66,Default,,0,0,0,,Ах... Юрико... Мұнда мен үшін орын жоқ па?
Dialogue: 0,0:58:12.73,0:58:15.56,Default,,0,0,0,,Жануарлар елінің осылай босаңсып жатқанына қуаныштымын.
Dialogue: 0,0:58:15.66,0:58:16.46,Default,,0,0,0,,Хахаха
Dialogue: 0,0:58:19.83,0:58:22.83,Default,,0,0,0,,Хмм, иә~
Dialogue: 0,0:58:22.90,0:58:24.90,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:58:25.23,0:58:27.33,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:58:27.83,0:58:28.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:58:29.20,0:58:33.20,Default,,0,0,0,,А... Мм... Бұл Нобитаның оқу бөлмесі.
Dialogue: 0,0:58:33.30,0:58:35.30,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:58:35.56,0:58:36.80,Default,,0,0,0,,Жоқ... шынымен емес.
Dialogue: 0,0:58:37.33,0:58:41.73,Default,,0,0,0,,Жарайды, себебі бұл оқу бөлмесінен гөрі ұйықтайтын бөлме.
Dialogue: 0,0:58:42.33,0:58:44.30,Default,,0,0,0,,Нобита қайтып келгенде...
Dialogue: 0,0:58:44.40,0:58:47.73,Default,,0,0,0,,А, Нобита-кун қайтып келді!
Dialogue: 0,0:58:47.90,0:58:52.40,Default,,0,0,0,,Иә? Анам менің үстелімде оқи ма?
Dialogue: 0,0:58:53.40,0:58:54.70,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:58:54.80,0:58:57.06,Default,,0,0,0,,Мен анамның көргісі келмейтін нәрселер көп.
Dialogue: 0,0:58:57.20,0:59:00.13,Default,,0,0,0,,Дұрыс, 0 ұпаймен жауап.
Dialogue: 0,0:59:00.30,0:59:04.03,Default,,0,0,0,,Әй, мама, егер оқығың келсе, төменгі қабаттағы қонақ бөлмеге жайғаса бер...
Dialogue: 0,0:59:04.13,0:59:06.60,Default,,0,0,0,,Анам қазір оқып жатыр.
Dialogue: 0,0:59:07.13,0:59:10.03,Default,,0,0,0,,Мен партада дұрыс отырғанда өзімді жақсы сезінемін.
Dialogue: 0,0:59:10.30,0:59:13.96,Default,,0,0,0,,Ей, тіпті аналар кейде қиын кітаптарды оқиды.
Dialogue: 0,0:59:14.40,0:59:17.30,Default,,0,0,0,,Артқы таулардағы жасыл желектерді қорғау науқанын бастадыңыз, солай ма?
Dialogue: 0,0:59:17.43,0:59:19.63,Default,,0,0,0,,Мен аздап оқуым керек
Dialogue: 0,0:59:19.73,0:59:21.43,Default,,0,0,0,,Мен көп ізденіп, таң қалдым.
Dialogue: 0,0:59:22.56,0:59:26.26,Default,,0,0,0,,Жапония ормандарды тазартатын жалғыз жер емес.
Dialogue: 0,0:59:26.36,0:59:29.46,Default,,0,0,0,,Жасыл жыл сайын дүние жүзінде жоғалады.
Dialogue: 0,0:59:29.56,0:59:33.36,Default,,0,0,0,,Бұл Жапония аумағының жартысы.
Dialogue: 0,0:59:33.63,0:59:37.30,Default,,0,0,0,,Иә, Жапонияның жартысы? Кім мұны істейді?
Dialogue: 0,0:59:37.80,0:59:39.93,Default,,0,0,0,,Оны жай сөз тіркесі сияқты айтпа.
Dialogue: 0,0:59:40.03,0:59:43.30,Default,,0,0,0,,Мысалы, мына қоқыс себетіндегі қағаз қалдықтары.
Dialogue: 0,0:59:43.40,0:59:45.03,Default,,0,0,0,,Ал жәшікте...
Dialogue: 0,0:59:45.13,0:59:47.06,Default,,0,0,0,,Әй, қағазды босқа жұмсадым.
Dialogue: 0,0:59:47.13,0:59:49.13,Default,,0,0,0,,Ағаштарды кеспесе болмайды.
Dialogue: 0,0:59:49.23,0:59:50.93,Default,,0,0,0,,Түсіндім, ақшаны ысырап етуді доғар.
Dialogue: 0,0:59:51.03,0:59:51.76,Default,,0,0,0,,Иә
Dialogue: 0,0:59:51.86,0:59:54.73,Default,,0,0,0,,Жасыл басынан айырылған жер шөлге айналып барады.
Dialogue: 0,0:59:54.80,0:59:57.96,Default,,0,0,0,,Жер шарының үштен бір бөлігі шөл.
Dialogue: 0,0:59:58.06,1:00:00.30,Default,,0,0,0,,Шөлде егін өсіруге болмайды
Dialogue: 0,1:00:00.40,1:00:02.80,Default,,0,0,0,,Сонымен аштықтан қиналғандар
Dialogue: 0,1:00:02.93,1:00:05.10,Default,,0,0,0,,Африканың өзінде 30 миллион адам
Dialogue: 0,1:00:05.56,1:00:08.10,Default,,0,0,0,,Тамақты да ысырап етпеңіз.
Dialogue: 0,1:00:08.20,1:00:09.20,Default,,0,0,0,,№ №
Dialogue: 0,1:00:09.30,1:00:10.06,Default,,0,0,0,,Иә
Dialogue: 0,1:00:10.70,1:00:13.13,Default,,0,0,0,,Энергияны шамадан тыс пайдалану да проблема болып табылады.
Dialogue: 0,1:00:13.26,1:00:14.03,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,1:00:14.63,1:00:16.13,Default,,0,0,0,,Автомобильдер мен зауыттар
Dialogue: 0,1:00:16.23,1:00:19.56,Default,,0,0,0,,Электр энергиясына айналатын майды пайдаланғанда
Dialogue: 0,1:00:19.63,1:00:23.90,Default,,0,0,0,,Көмірқышқыл газы ауада көбейген сайын жердің ауа райы біртүрлі болады.
Dialogue: 0,1:00:24.13,1:00:27.13,Default,,0,0,0,,Сіз шамдарды жиі жанып қоясыз ба?
Dialogue: 0,1:00:27.26,1:00:28.90,Default,,0,0,0,,Жарайды, мен абай боламын.
Dialogue: 0,1:00:29.70,1:00:31.56,Default,,0,0,0,,Өсімдіктер ғана емес
Dialogue: 0,1:00:31.63,1:00:33.80,Default,,0,0,0,,Үйінен айырылған жануарлар
Dialogue: 0,1:00:34.03,1:00:36.26,Default,,0,0,0,,Суы ластанған балықтар
Dialogue: 0,1:00:36.36,1:00:38.76,Default,,0,0,0,,Көптеген өмірлер жойылуда.
Dialogue: 0,1:00:39.43,1:00:40.76,Default,,0,0,0,,Мен білмедім
Dialogue: 0,1:00:40.86,1:00:43.70,Default,,0,0,0,,Адамдардың сонша қиындық тудырғанына сене алар емеспін.
Dialogue: 0,1:00:43.80,1:00:45.46,Default,,0,0,0,,Жер құламас бұрын
Dialogue: 0,1:00:45.56,1:00:46.80,Default,,0,0,0,,Маған бірдеңе істеу керек
Dialogue: 0,1:00:46.90,1:00:48.70,Default,,0,0,0,,Анам осы мақсатта оқиды.
Dialogue: 0,1:00:49.26,1:00:52.13,Default,,0,0,0,,Мен мұны түсінемін, бірақ ештеңе менікі емес...
Dialogue: 0,1:00:52.23,1:00:55.36,Default,,0,0,0,,Бұл жерді қорғау. Тым болмаса бір ұйықтау үшін өзіңізді ұстаңыз.
Dialogue: 0,1:00:55.46,1:00:56.96,Default,,0,0,0,,Иә! иә!
Dialogue: 0,1:00:57.96,1:01:01.60,Default,,0,0,0,,Егер мен ана болсам, өзімді Қоршаған ортаны қорғау министрі болғандай сезінер едім.
Dialogue: 0,1:01:02.03,1:01:05.60,Default,,0,0,0,,Бірақ мен Жердің тағдырына алаңдай бастадым.
Dialogue: 0,1:01:06.50,1:01:08.86,Default,,0,0,0,,Мен Чиппоның жұлдызын қызғанамын.
Dialogue: 0,1:01:08.96,1:01:14.46,Default,,0,0,0,,Бұл шынымен әдемі, бейбіт және жақсы планета болды.
Dialogue: 0,1:01:15.50,1:01:19.43,Default,,0,0,0,,Хехе, бұл менің қиялым екеніне сене алар емеспін.
Dialogue: 0,1:01:19.86,1:01:22.26,Default,,0,0,0,,Бұл менің қиялым ғана емес! (Сунео) Ах!
Dialogue: 0,1:01:22.53,1:01:24.36,Default,,0,0,0,,Бұл сөзсіз Чиппоның елесі.
Dialogue: 0,1:01:25.80,1:01:27.96,Default,,0,0,0,,Чиппоның елесі?
Dialogue: 0,1:01:28.46,1:01:29.86,Default,,0,0,0,,Бұл шынымен шықты ма? Иә
Dialogue: 0,1:01:30.66,1:01:32.96,Default,,0,0,0,,Мен Чиппоның дауысын естігеніме сенімдімін.
Dialogue: 0,1:01:33.03,1:01:33.76,Default,,0,0,0,,Қайда?
Dialogue: 0,1:01:34.26,1:01:36.60,Default,,0,0,0,,Менің бөлмемде күтпеген жерден
Dialogue: 0,1:01:36.70,1:01:40.03,Default,,0,0,0,,«Ей, сен мені ести аласың ба?»
Dialogue: 0,1:01:40.13,1:01:42.70,Default,,0,0,0,,«Егер естісеңіз, жауап беріңіз».
Dialogue: 0,1:01:42.83,1:01:44.76,Default,,0,0,0,,«Сәлем»
Dialogue: 0,1:01:44.86,1:01:46.46,Default,,0,0,0,,(Нобита мен Сунеоның күлкісі)
Dialogue: 0,1:01:46.53,1:01:49.46,Default,,0,0,0,,Чиппо шалғай ғаламда өмір сүреді.
Dialogue: 0,1:01:49.53,1:01:50.46,Default,,0,0,0,,Елестер...
Dialogue: 0,1:01:50.53,1:01:52.63,Default,,0,0,0,,(Нобита мен оның достарының күлкісі)
Dialogue: 0,1:01:52.70,1:01:54.43,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:55.10,1:01:56.33,Default,,0,0,0,,Ақымақ болма! (Сунео) Уау
Dialogue: 0,1:01:56.43,1:01:57.53,Default,,0,0,0,,Уау
Dialogue: 0,1:01:57.66,1:01:58.83,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:59.50,1:02:02.00,Default,,0,0,0,,Сіз ит елесі туралы ешқашан естімегенсіз.
Dialogue: 0,1:02:02.10,1:02:03.16,Default,,0,0,0,,Әй (Нобита) Мама!
Dialogue: 0,1:02:03.60,1:02:04.90,Default,,0,0,0,,Дора-чан тез
Dialogue: 0,1:02:05.00,1:02:06.66,Default,,0,0,0,,Не болды? ана жалаң аяқ
Dialogue: 0,1:02:07.03,1:02:09.23,Default,,0,0,0,,Мен қорқынышты дауысты естимін.
Dialogue: 0,1:02:09.33,1:02:10.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:10.76,1:02:13.03,Default,,0,0,0,,Джиан сияқты айтты
Dialogue: 0,1:02:13.86,1:02:15.53,Default,,0,0,0,,Иә? (Нобита) Иә?
Dialogue: 0,1:02:19.43,1:02:21.43,Default,,0,0,0,,Мен ештеңе естімеймін
Dialogue: 0,1:02:21.56,1:02:25.26,Default,,0,0,0,,Хаха, мен бұрын-соңды бұлай істеген емеспін, тек сабақ оқимын.
Dialogue: 0,1:02:25.40,1:02:26.23,Default,,0,0,0,,Тыныш
Dialogue: 0,1:02:26.93,1:02:27.76,Default,,0,0,0,,Не болды?
Dialogue: 0,1:02:27.86,1:02:29.16,Default,,0,0,0,,Тыныш.
Dialogue: 0,1:02:29.26,1:02:29.93,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:31.93,1:02:33.73,Default,,0,0,0,,Біреу жауап береді! (Нобита/Дораемон) Га
Dialogue: 0,1:02:33.83,1:02:35.23,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:02:35.33,1:02:36.20,Default,,0,0,0,,Бұл Чиппоның дауысы.
Dialogue: 0,1:02:36.53,1:02:38.10,Default,,0,0,0,,Сәлем! Бұл жерде!
Dialogue: 0,1:02:38.70,1:02:39.90,Default,,0,0,0,,(Мейірбике 1) Ә? Неге бұл кішкентай ит тілім-шайыр шайнап отыр?
Dialogue: 0,1:02:40.83,1:02:42.86,Default,,0,0,0,,Біреу жауап беріңізші!
Dialogue: 0,1:02:43.93,1:02:45.10,Default,,0,0,0,,Эмилияның фракциясы мен Куруштың фракциясы арасындағы тең шарттардағы одақ.
Dialogue: 0,1:02:45.33,1:02:46.56,Default,,0,0,0,,«экспедиция жинағы» емес
Dialogue: 0,1:02:47.10,1:02:49.70,Default,,0,0,0,,Осы «жіпсіз телефоннан»
Dialogue: 0,1:02:49.76,1:02:51.03,Default,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,1:02:51.53,1:02:52.60,Default,,0,0,0,,Чиппо!
Dialogue: 0,1:02:52.70,1:02:54.93,Default,,0,0,0,,Нобита-кун? Нобита-кун!
Dialogue: 0,1:02:55.40,1:02:56.50,Default,,0,0,0,,Chippo Сәлем!
Dialogue: 0,1:02:57.10,1:02:58.76,Default,,0,0,0,,Рахмет, көмектесіңізші
Dialogue: 0,1:02:58.86,1:03:00.56,Default,,0,0,0,,Көмек дегенді қалай түсінесіңдер?
Dialogue: 0,1:03:01.10,1:03:03.33,Default,,0,0,0,,Біз қазір үлкен қиындыққа тап болдық.
Dialogue: 0,1:03:03.63,1:03:05.26,Default,,0,0,0,,Ең маңызды мәселе неде?
Dialogue: 0,1:03:05.33,1:03:07.50,Default,,0,0,0,,Нимуге маған шабуыл жасады.
Dialogue: 0,1:03:07.63,1:03:08.90,Default,,0,0,0,,Айдың жын келді...
Dialogue: 0,1:03:09.46,1:03:12.50,Default,,0,0,0,,Чиппо-кун, мен сені жақсы естімеймін. Сәлем!
Dialogue: 0,1:03:12.60,1:03:13.66,Default,,0,0,0,,О, тағы бір шабуыл!
Dialogue: 0,1:03:13.76,1:03:16.60,Default,,0,0,0,,Уау
Dialogue: 0,1:03:16.66,1:03:19.66,Default,,0,0,0,,Моши Моши Моши Моши Чиппо! Сәлем
Dialogue: 0,1:03:19.80,1:03:21.33,Default,,0,0,0,,Тасымалдау тоқтатылды
Dialogue: 0,1:03:21.80,1:03:23.30,Default,,0,0,0,,Дорэмон, қазір барайық
Dialogue: 0,1:03:23.40,1:03:27.56,Default,,0,0,0,,Бұл мүмкін емес. Бұл планетаға бару үшін бізге «барлық жерде газ» қажет.
Dialogue: 0,1:03:28.00,1:03:29.80,Default,,0,0,0,,Олай болса, оны жайына қалдыр дейсің бе?
Dialogue: 0,1:03:29.90,1:03:32.26,Default,,0,0,0,,Маған осылай айтсаң да...
Dialogue: 0,1:03:32.33,1:03:35.33,Default,,0,0,0,,Чиппо қатты көмек сұрайды.
Dialogue: 0,1:03:35.43,1:03:37.63,Default,,0,0,0,,Десең де…
Dialogue: 0,1:03:37.83,1:03:40.50,Default,,0,0,0,,Иә! «Ғарыштық құтқару қайығы» бар
Dialogue: 0,1:03:40.93,1:03:46.16,Default,,0,0,0,,Жоқ, мен ол жұлдыздың бір тасын да пайдалана аламын.
Dialogue: 0,1:03:46.73,1:03:48.50,Default,,0,0,0,,Мен ондай ештеңе әкелген жоқпын.
Dialogue: 0,1:03:48.93,1:03:51.93,Default,,0,0,0,,Эй, біз не істей аламыз? Эй
Dialogue: 0,1:03:52.00,1:03:52.93,Default,,0,0,0,,Ах, мм...
Dialogue: 0,1:03:55.56,1:03:56.40,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:58.33,1:03:59.16,Default,,0,0,0,,Жұлдызды гүл
Dialogue: 0,1:04:00.30,1:04:02.83,Default,,0,0,0,,Анам гүлдерді басып, оларды бетбелгі ретінде пайдаланды.
Dialogue: 0,1:04:02.90,1:04:04.03,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,1:04:04.13,1:04:05.73,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,1:04:05.86,1:04:07.20,Default,,0,0,0,,үшінна хабарлаңыз
Dialogue: 0,1:04:07.63,1:04:09.66,Default,,0,0,0,,Иә, аңызға айналған шайтан!?
Dialogue: 0,1:04:10.23,1:04:12.13,Default,,0,0,0,,Олар Чиппо планетасына шабуыл жасады деп айттыңыз ба?
Dialogue: 0,1:04:12.73,1:04:14.13,Default,,0,0,0,,Чиппоға қауіп төніп тұр.
Dialogue: 0,1:04:14.40,1:04:15.56,Default,,0,0,0,,Сен менімен барасың, солай ма?
Dialogue: 0,1:04:15.90,1:04:17.80,Default,,0,0,0,,Әрине барамын.
Dialogue: 0,1:04:18.06,1:04:21.03,Default,,0,0,0,,Мен... Джианмен кеңескеннен кейін...
Dialogue: 0,1:04:21.46,1:04:23.73,Default,,0,0,0,,Бізге асығу керек.
Dialogue: 0,1:04:24.86,1:04:25.90,Default,,0,0,0,,Мм... (Нобита) Ei
Dialogue: 0,1:04:27.23,1:04:29.90,Default,,0,0,0,,Олай болса, Сунео, егер Джанды көрсең, маған хабарлаңыз.
Dialogue: 0,1:04:30.23,1:04:31.86,Default,,0,0,0,,Жоқ... не?
Dialogue: 0,1:04:32.13,1:04:34.50,Default,,0,0,0,,«Мен бұрын күлдім, бұл жаман болды».
Dialogue: 0,1:04:34.56,1:04:35.73,Default,,0,0,0,,Ал, мен барамын.
Dialogue: 0,1:04:35.83,1:04:36.83,Default,,0,0,0,,Сәлем! (Нобита) А
Dialogue: 0,1:04:37.03,1:04:37.80,Default,,0,0,0,,Ах Джиан
Dialogue: 0,1:04:37.90,1:04:40.16,Default,,0,0,0,,Ха, дайындалуға көп уақыт кетті!
Dialogue: 0,1:04:40.23,1:04:42.50,Default,,0,0,0,,Сунео, нені кешіктіріп жатырсың?
Dialogue: 0,1:04:42.56,1:04:44.46,Default,,0,0,0,,Себебі Джиан қорқып кетті.
Dialogue: 0,1:04:44.73,1:04:48.90,Default,,0,0,0,,Сіз досыңызға көмек қажет болған кезде білмегендей бола аласыз ба?
Dialogue: 0,1:04:49.16,1:04:50.36,Default,,0,0,0,,Джан
Dialogue: 0,1:04:50.73,1:04:52.50,Default,,0,0,0,,Тезірек (Сунео) Жарайды.
Dialogue: 0,1:04:55.06,1:04:57.56,Default,,0,0,0,,Гүлден анықтау қондырғысына
Dialogue: 0,1:04:57.96,1:04:58.73,Default,,0,0,0,,Ах
Dialogue: 0,1:05:00.26,1:05:01.80,Default,,0,0,0,,Ұшыңыз!
Dialogue: 0,1:05:15.60,1:05:17.30,Default,,0,0,0,,Мен оны таптым деп ойлаймын. Бұл бұрылыс.
Dialogue: 0,1:05:23.30,1:05:25.13,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:25.70,1:05:28.70,Default,,0,0,0,,Уау~ (Дораэмон/Шидзука) Уау
Dialogue: 0,1:05:28.96,1:05:32.63,Default,,0,0,0,,Жануарлар планетасы қос жұлдыз болды ма?
Dialogue: 0,1:05:32.76,1:05:35.76,Default,,0,0,0,,Сол қызыл қоңыр жұлдыз Нимуге жұлдызы.
Dialogue: 0,1:05:35.86,1:05:40.20,Default,,0,0,0,,Ал әдемі жасыл жұлдыз - Чиппо жұлдызы.
Dialogue: 0,1:05:49.13,1:05:50.73,Default,,0,0,0,,Кім осындай нәрсені жасайды...
Dialogue: 0,1:05:50.80,1:05:52.20,Default,,0,0,0,,О...құдай-ау
Dialogue: 0,1:05:52.30,1:05:54.03,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:54.13,1:05:55.56,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,1:05:56.46,1:05:58.03,Default,,0,0,0,,Chippo қауіпсіз.
Dialogue: 0,1:05:58.13,1:05:59.53,Default,,0,0,0,,Чиппо!
Dialogue: 0,1:06:03.50,1:06:05.03,Default,,0,0,0,,Чиппо
Dialogue: 0,1:06:05.36,1:06:06.66,Default,,0,0,0,,Чиппо мырза
Dialogue: 0,1:06:06.76,1:06:08.63,Default,,0,0,0,,Мұнда енді ешкім жоқ сияқты.
Dialogue: 0,1:06:11.30,1:06:13.10,Default,,0,0,0,,Бөлініп, қаланы іздейік
Dialogue: 0,1:06:13.20,1:06:15.26,Default,,0,0,0,,Иә, бірақ сақ болыңыз.
Dialogue: 0,1:06:15.36,1:06:17.33,Default,,0,0,0,,Жаудың кім екені анық болмаса да
Dialogue: 0,1:06:17.53,1:06:19.46,Default,,0,0,0,,Жақын жерде екеніңізге сенімдімін
Dialogue: 0,1:06:19.53,1:06:22.03,Default,,0,0,0,,Әр адамның «барлау жинағы» бар, солай ма?
Dialogue: 0,1:06:22.33,1:06:23.70,Default,,0,0,0,,Оу!
Dialogue: 0,1:06:25.36,1:06:26.36,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:06:26.70,1:06:30.20,Default,,0,0,0,,Маған мезгіл-мезгіл сымсыз телефон арқылы хабарласуды ұмытпаңыз.
Dialogue: 0,1:06:30.30,1:06:31.20,Default,,0,0,0,,Иә, солай!
Dialogue: 0,1:06:31.33,1:06:32.46,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,1:06:42.36,1:06:45.13,Default,,0,0,0,,Ой, не?
Dialogue: 0,1:06:45.93,1:06:46.60,Default,,0,0,0,,Ах
Dialogue: 0,1:06:46.70,1:06:50.70,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:06:54.60,1:06:55.26,Default,,0,0,0,,Чиппо?
Dialogue: 0,1:06:56.93,1:06:57.60,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,1:06:57.76,1:06:58.53,Default,,0,0,0,,Бұл кім!?
Dialogue: 0,1:06:58.66,1:07:00.40,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,1:07:02.56,1:07:04.20,Default,,0,0,0,,Ешкім жоқ па?
Dialogue: 0,1:07:05.66,1:07:06.93,Default,,0,0,0,,Ж-жарайды… Сатып алғаныңызға рахмет.
Dialogue: 0,1:07:07.43,1:07:10.93,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,1:07:12.93,1:07:15.10,Default,,0,0,0,,Нобита-кун Нобита-кун (Нобита) Ах
Dialogue: 0,1:07:15.23,1:07:16.60,Default,,0,0,0,,Мен мылтық дауысын естідім, жақсысың ба?
Dialogue: 0,1:07:16.73,1:07:20.56,Default,,0,0,0,,Дорэмонды жай ғана Нимугеге ұқсайтын адам атып тастады.
Dialogue: 0,1:07:20.66,1:07:22.43,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:07:22.56,1:07:23.83,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,1:07:24.20,1:07:26.43,Default,,0,0,0,,Иә, жақсы, менің ойымша, ол кетіп қалды.
Dialogue: 0,1:07:26.76,1:07:28.43,Default,,0,0,0,,Жақсы
Dialogue: 0,1:07:28.56,1:07:30.40,Default,,0,0,0,,Мен осы жерден шағын жаңалық аштым.
Dialogue: 0,1:07:30.50,1:07:31.26,Default,,0,0,0,,үшінңыз келіңіздер.
Dialogue: 0,1:07:31.36,1:07:32.90,Default,,0,0,0,,Менің қайда келгенімді қалайсың?
Dialogue: 0,1:07:33.73,1:07:37.33,Default,,0,0,0,,Мен сізге бағыт-бағдар беремін, сондықтан әркім өзінің «жіпсіз телефондарын» тастауы керек.
Dialogue: 0,1:07:37.43,1:07:39.26,Default,,0,0,0,,Мұны түсіндім
Dialogue: 0,1:07:48.23,1:07:49.33,Default,,0,0,0,,Ах Шизука-чан
Dialogue: 0,1:07:49.43,1:07:51.36,Default,,0,0,0,,А, Нобита-сан
Dialogue: 0,1:07:54.93,1:07:56.43,Default,,0,0,0,,мұнда
Dialogue: 0,1:07:56.53,1:07:58.43,Default,,0,0,0,,Сіз қандай да бір анықтама таптыңыз ба?
Dialogue: 0,1:07:58.53,1:08:00.10,Default,,0,0,0,,Не болды? ше?
Dialogue: 0,1:08:00.50,1:08:01.60,Default,,0,0,0,,Бұл құлады.
Dialogue: 0,1:08:02.00,1:08:04.33,Default,,0,0,0,,«Барлау жинағы» Катсудон ыдысы
Dialogue: 0,1:08:04.46,1:08:06.06,Default,,0,0,0,,Чиппо-кун оны жеп қойды.
Dialogue: 0,1:08:06.50,1:08:09.00,Default,,0,0,0,,Тамақтанып болған соң, қызық, олар қайда кетті?
Dialogue: 0,1:08:09.16,1:08:10.96,Default,,0,0,0,,Осы уақытқа дейін...
Dialogue: 0,1:08:11.06,1:08:12.00,Default,,0,0,0,,Маған аздап қарыз бер
Dialogue: 0,1:08:12.13,1:08:14.33,Default,,0,0,0,,Хмм.
Dialogue: 0,1:08:14.63,1:08:16.96,Default,,0,0,0,,Осы жолмен! (Нобита) Уау, керемет
Dialogue: 0,1:08:17.06,1:08:21.16,Default,,0,0,0,,«Мал ойынын» ойнағанда оның мұрны түлкідей жақсы.
Dialogue: 0,1:08:21.26,1:08:22.39,Default,,0,0,0,,Міне, міне, а?
Dialogue: 0,1:08:29.80,1:08:30.73,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,1:08:31.33,1:08:33.16,Default,,0,0,0,,Осы жерден жер астына кеткен сияқты.
Dialogue: 0,1:08:33.66,1:08:36.00,Default,,0,0,0,,Мен канализацияға тығылдым.
Dialogue: 0,1:08:36.13,1:08:38.06,Default,,0,0,0,,Жақсы, жақсы
Dialogue: 0,1:08:38.16,1:08:41.23,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:08:43.89,1:08:47.26,Default,,0,0,0,,Бұл жерде нашар ағынның салдарынан иіс үзіледі.
Dialogue: 0,1:08:47.33,1:08:49.30,Default,,0,0,0,,Иә, бұл не? (Нобита) Иә~
Dialogue: 0,1:08:49.60,1:08:52.39,Default,,0,0,0,,Осы жерге кел, ол жерде жоқ.
Dialogue: 0,1:08:52.50,1:08:56.23,Default,,0,0,0,,Тшш, мен біреудің жылағанын естимін.
Dialogue: 0,1:08:56.56,1:08:58.33,Default,,0,0,0,,Бұл Чиппо, асығайық.
Dialogue: 0,1:08:58.43,1:08:59.43,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,1:09:04.06,1:09:08.06,Default,,0,0,0,,(Судың ағып жатқан дыбысы)
Dialogue: 0,1:09:09.89,1:09:11.89,Default,,0,0,0,,Міне, мен оны төменнен естимін.
Dialogue: 0,1:09:12.16,1:09:15.06,Default,,0,0,0,,Жарайды, мұны маған қалдыр, Нуо.
Dialogue: 0,1:09:15.20,1:09:17.36,Default,,0,0,0,,Уау... (Сунео) Ах!
Dialogue: 0,1:09:17.73,1:09:19.63,Default,,0,0,0,,Горилла сияқты адамдық күш
Dialogue: 0,1:09:19.73,1:09:21.30,Default,,0,0,0,,Дарындылық жеткілікті болды.
Dialogue: 0,1:09:21.39,1:09:25.13,Default,,0,0,0,,Жоо
Dialogue: 0,1:09:25.23,1:09:27.00,Default,,0,0,0,,Міне болды! Чиппо!
Dialogue: 0,1:09:27.06,1:09:28.23,Default,,0,0,0,,Ахх...
Dialogue: 0,1:09:28.70,1:09:30.56,Default,,0,0,0,,Чиппо, жақсысың ба?
Dialogue: 0,1:09:30.70,1:09:31.80,Default,,0,0,0,,Йойшо
Dialogue: 0,1:09:31.89,1:09:33.33,Default,,0,0,0,,О, Чиппо!
Dialogue: 0,1:09:33.39,1:09:35.70,Default,,0,0,0,,Мен сенің келетініңе сендім.
Dialogue: 0,1:09:35.80,1:09:37.16,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,1:09:37.56,1:09:39.86,Default,,0,0,0,,Не болды?
Dialogue: 0,1:09:39.96,1:09:43.06,Default,,0,0,0,,Бұл біз мүлдем түсінбейтін нәрсе.
Dialogue: 0,1:09:43.96,1:09:47.56,Default,,0,0,0,,Кенет тақтаға ұқсайтын ұшақ бомба тастады.
Dialogue: 0,1:09:48.23,1:09:51.03,Default,,0,0,0,,Қаладан әрең құтылдық.
Dialogue: 0,1:09:51.50,1:09:53.66,Default,,0,0,0,,Сіз қашып кетпедіңіз бе?
Dialogue: 0,1:09:53.73,1:09:57.46,Default,,0,0,0,,Әрине қашып кеттім, бірақ Роми-чаннан айырылдым.
Dialogue: 0,1:09:57.83,1:10:00.66,Default,,0,0,0,,Сонда сіз өзіңіз іздеуге қайта оралдыңыз ба?
Dialogue: 0,1:10:00.73,1:10:01.40,Default,,0,0,0,,Иә
Dialogue: 0,1:10:01.80,1:10:04.36,Default,,0,0,0,,Сіз әдеттегідей абайсыздасыз.
Dialogue: 0,1:10:04.46,1:10:06.83,Default,,0,0,0,,Жақсы батылдық, маған ұнайды.
Dialogue: 0,1:10:06.90,1:10:09.30,Default,,0,0,0,,Бірақ мені ұстаған болар.
Dialogue: 0,1:10:09.40,1:10:11.00,Default,,0,0,0,,Мен олардың аман-есен құтылғанына сенімдімін (дабыл дыбысы)
Dialogue: 0,1:10:11.06,1:10:11.73,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:11.86,1:10:14.73,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:10:15.20,1:10:15.90,Default,,0,0,0,,Кеттік
Dialogue: 0,1:10:16.03,1:10:17.30,Default,,0,0,0,,Ооши
Dialogue: 0,1:10:23.40,1:10:25.33,Default,,0,0,0,,Күте тұрыңыз, бұл Нимге.
Dialogue: 0,1:10:28.36,1:10:29.03,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:43.40,1:10:45.46,Default,,0,0,0,,Бұл Нимугенің дискісі.
Dialogue: 0,1:10:49.86,1:10:51.90,Default,,0,0,0,,Тыңдаңдар, жануарлар.
Dialogue: 0,1:10:52.16,1:10:54.46,Default,,0,0,0,,Бұл жолы мен барлау жасап, үйге қайтайын.
Dialogue: 0,1:10:54.56,1:10:57.86,Default,,0,0,0,,Бірақ келесі жолы мен қысқартпаймын.
Dialogue: 0,1:10:58.16,1:11:02.06,Default,,0,0,0,,Толық ауқымды шабуыл басталғанға дейін момындықпен берілсеңіз,
Dialogue: 0,1:11:02.13,1:11:05.73,Default,,0,0,0,,Оны еркелетейік Вахахаха...
Dialogue: 0,1:11:05.80,1:11:07.63,Default,,0,0,0,,Мен мұны қосқым келеді
Dialogue: 0,1:11:07.76,1:11:09.96,Default,,0,0,0,,Бір сүйкімді күшік
Dialogue: 0,1:11:10.06,1:11:13.30,Default,,0,0,0,,Ол кепілде ұсталды.
Dialogue: 0,1:11:13.40,1:11:14.06,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:14.93,1:11:16.96,Default,,0,0,0,,Роми-чан! (Нобита) Күте тұрыңыз, Чиппо!
Dialogue: 0,1:11:17.06,1:11:19.26,Default,,0,0,0,,Аххх, уф (Нобита) Гррр... уф
Dialogue: 0,1:11:19.36,1:11:21.80,Default,,0,0,0,,Роми-чан!
Dialogue: 0,1:11:22.76,1:11:23.60,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:26.46,1:11:28.20,Default,,0,0,0,,Менің артымнан қуғанның пайдасы жоқ
Dialogue: 0,1:11:28.30,1:11:29.90,Default,,0,0,0,,Өйткені Роми-чан
Dialogue: 0,1:11:29.96,1:11:31.10,Default,,0,0,0,,(Чиппоның айқайы)
Dialogue: 0,1:11:31.20,1:11:33.60,Default,,0,0,0,,Көмек көрсету жолдарын ойластырыңыз
Dialogue: 0,1:11:34.10,1:11:36.70,Default,,0,0,0,,Иә, құтқарушы қайықпен оның соңынан қуып барайық.
Dialogue: 0,1:11:36.80,1:11:38.10,Default,,0,0,0,,Ах Саетеру
Dialogue: 0,1:11:38.53,1:11:39.96,Default,,0,0,0,,Тезірек барайық. Ах, сол.
Dialogue: 0,1:11:40.06,1:11:43.03,Default,,0,0,0,,Болды, күте тұрыңыз, ау, ауырады...
Dialogue: 0,1:11:43.40,1:11:44.90,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:11:45.26,1:11:48.96,Default,,0,0,0,,үшін, бұл... Бір минут күтіңіз!
Dialogue: 0,1:11:49.13,1:11:50.20,Default,,0,0,0,,Кел, тез, тез
Dialogue: 0,1:11:50.30,1:11:51.96,Default,,0,0,0,,Асығыңыз! Асығыңыз!
Dialogue: 0,1:11:53.93,1:11:55.23,Default,,0,0,0,,Дораэмон тез!
Dialogue: 0,1:11:55.30,1:11:58.03,Default,,0,0,0,,Хахаха, «тез» бұл қайық...
Dialogue: 0,1:11:58.30,1:11:59.46,Default,,0,0,0,,Бастау
Dialogue: 0,1:12:03.60,1:12:05.83,Default,,0,0,0,,Хаха... (Нобита) Бұл қай қайық?
Dialogue: 0,1:12:05.93,1:12:07.70,Default,,0,0,0,,Секірсең де... Ха...
Dialogue: 0,1:12:07.83,1:12:09.16,Default,,0,0,0,,Тіпті секірсеңіз де?
Dialogue: 0,1:12:09.26,1:12:12.46,Default,,0,0,0,,Өйткені бұл жануарлар планетасына кіріс
Dialogue: 0,1:12:13.20,1:12:15.80,Default,,0,0,0,,Сонымен? Түпнұсқаға оралу
Dialogue: 0,1:12:15.86,1:12:18.86,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:19.00,1:12:23.00,Default,,0,0,0,,(Нобита мен оның достарының айқайы)
Dialogue: 0,1:12:23.70,1:12:25.86,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:28.03,1:12:31.60,Default,,0,0,0,,Уау... уф...
Dialogue: 0,1:12:33.13,1:12:35.63,Default,,0,0,0,,Нобита-кун, жақсысың ба?
Dialogue: 0,1:12:35.70,1:12:37.70,Default,,0,0,0,,Әйтеуір тірімін
Dialogue: 0,1:12:37.83,1:12:40.86,Default,,0,0,0,,Уф... бұл Тыйым салынған орман.
Dialogue: 0,1:12:43.30,1:12:45.76,Default,,0,0,0,,Эй, мен бұл сенімдімін...
Dialogue: 0,1:12:45.86,1:12:46.96,Default,,0,0,0,,U.A. спорттық күні теледидарда көрсетілген сол жігіт қой.
Dialogue: 0,1:12:47.03,1:12:49.43,Default,,0,0,0,,Қараңдаршы, мен осында болғанда...
Dialogue: 0,1:12:49.53,1:12:50.70,Default,,0,0,0,,Сәлем, Гориро!
Dialogue: 0,1:12:50.83,1:12:52.66,Default,,0,0,0,,Ой, міне, келді.
Dialogue: 0,1:12:53.03,1:12:55.76,Default,,0,0,0,,Орманнан кетсең, Нимге сені тауып алады.
Dialogue: 0,1:12:55.86,1:12:57.13,Default,,0,0,0,,Күте тұрыңыз, Гориро!
Dialogue: 0,1:12:57.20,1:13:00.16,Default,,0,0,0,,Уау~ Жоқ, бұл дұрыс емес~
Dialogue: 0,1:13:00.40,1:13:03.23,Default,,0,0,0,,Ugg... Мен Джанмын!
Dialogue: 0,1:13:03.33,1:13:04.83,Default,,0,0,0,,Эй, мен мұндамын.
Dialogue: 0,1:13:04.93,1:13:06.16,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:08.10,1:13:09.56,Default,,0,0,0,,Дәл Джан сияқты
Dialogue: 0,1:13:10.10,1:13:11.76,Default,,0,0,0,,Мен тағы да қателестім бе?
Dialogue: 0,1:13:11.90,1:13:13.53,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,1:13:17.93,1:13:21.26,Default,,0,0,0,,Сонда қала тұрғындары орманға тығылды ма?
Dialogue: 0,1:13:21.36,1:13:24.00,Default,,0,0,0,,Олай болса, сәл күте тұрыңыз.
Dialogue: 0,1:13:24.43,1:13:26.50,Default,,0,0,0,,Хой-Хой
Dialogue: 0,1:13:26.90,1:13:29.76,Default,,0,0,0,,Хой Хой
Dialogue: 0,1:13:29.86,1:13:32.10,Default,,0,0,0,,Сәлеметсіз бе, сіз жаңа доссыз ба?
Dialogue: 0,1:13:32.20,1:13:33.76,Default,,0,0,0,,О, мынау
Dialogue: 0,1:13:33.86,1:13:36.93,Default,,0,0,0,,Жүр, жүр, мына жерде жасырынған шаянды тез көрсетейік.
Dialogue: 0,1:13:37.70,1:13:40.43,Default,,0,0,0,,Чиппо, әкең сені іздеп жүрген.
Dialogue: 0,1:13:40.53,1:13:43.43,Default,,0,0,0,,Аюдың, қоянның және еноттың бәрі жақсы және қауіпсіз деп үміттенеміз.
Dialogue: 0,1:13:43.90,1:13:45.93,Default,,0,0,0,,Мен... Мен мысықпын.
Dialogue: 0,1:13:46.03,1:13:48.56,Default,,0,0,0,,«Енот ит» деп айту әрқашан өрескел.
Dialogue: 0,1:13:48.66,1:13:50.83,Default,,0,0,0,,Ракон ит не үшін ашуланады?
Dialogue: 0,1:13:50.93,1:13:53.20,Default,,0,0,0,,А, жоқ, бұл... бұл мағынада.
Dialogue: 0,1:13:53.26,1:13:54.86,Default,,0,0,0,,Сонымен бұл нені білдіреді?
Dialogue: 0,1:13:54.93,1:13:57.26,Default,,0,0,0,,(Нобита мен оның достарының күлкісі)
Dialogue: 0,1:14:00.26,1:14:03.13,Default,,0,0,0,,Бұл жерде қала тұрғындары шатыр тігіп жатыр.
Dialogue: 0,1:14:03.23,1:14:05.13,Default,,0,0,0,,Балалар, сендер де осындасыңдар деп үміттенемін.
Dialogue: 0,1:14:05.23,1:14:06.63,Default,,0,0,0,,Иә
Dialogue: 0,1:14:10.50,1:14:11.16,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:13.00,1:14:13.66,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,1:14:14.73,1:14:15.60,Default,,0,0,0,,Анашым!
Dialogue: 0,1:14:16.16,1:14:17.33,Default,,0,0,0,,Ой-ой
Dialogue: 0,1:14:17.46,1:14:20.16,Default,,0,0,0,,Ах Чиппо, сен амансың деп үміттенемін.
Dialogue: 0,1:14:20.30,1:14:21.10,Default,,0,0,0,,Чиппо!
Dialogue: 0,1:14:21.33,1:14:24.33,Default,,0,0,0,,Роми-чанды Нимге ұрлап әкетті
Dialogue: 0,1:14:24.43,1:14:29.00,Default,,0,0,0,,Уууу, жарайды, сені Құдай қорғайтынына сенімдімін.
Dialogue: 0,1:14:29.26,1:14:32.96,Default,,0,0,0,,Жарайды, мұнда да лагерь орнатайық...
Dialogue: 0,1:14:33.06,1:14:34.60,Default,,0,0,0,,Тамақ ішейік!
Dialogue: 0,1:14:34.66,1:14:36.66,Default,,0,0,0,,О, менің...
Dialogue: 0,1:14:44.83,1:14:48.10,Default,,0,0,0,,Әй, неше нимуге бар?
Dialogue: 0,1:14:48.16,1:14:50.40,Default,,0,0,0,,Келіңіздер, менде ештеңе жоқ.
Dialogue: 0,1:14:51.16,1:14:54.00,Default,,0,0,0,,Сіз келіп, Нимугенің жұлдызында не болып жатқанын біле аласыз ба?
Dialogue: 0,1:14:54.10,1:14:57.33,Default,,0,0,0,,Бұл мүмкін емес, қайық өзеннің түбіне батып бара жатыр.
Dialogue: 0,1:14:57.76,1:14:58.83,Default,,0,0,0,,Бізде қандай қару бар?
Dialogue: 0,1:14:59.16,1:15:01.06,Default,,0,0,0,,Әрқашан таныс
Dialogue: 0,1:15:01.40,1:15:03.83,Default,,0,0,0,,«Оқпалы мылтық» және «пневматикалық зеңбірек»
Dialogue: 0,1:15:04.56,1:15:06.73,Default,,0,0,0,,Кішкене жақсырақ нәрсе бар емес пе?
Dialogue: 0,1:15:06.86,1:15:07.83,Default,,0,0,0,,Кешіріңіз, ә
Dialogue: 0,1:15:10.33,1:15:11.73,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:15:12.23,1:15:16.16,Default,,0,0,0,,Роми-чанды құтқару үшін Нимге планетасына барудан басқа амалым жоқ.
Dialogue: 0,1:15:16.73,1:15:20.13,Default,,0,0,0,,Онда баруға мүмкіндік жоқ, ғарыш кемесі де жоқ.
Dialogue: 0,1:15:20.80,1:15:22.56,Default,,0,0,0,,Иә (Нобита) Иә?
Dialogue: 0,1:15:23.50,1:15:25.83,Default,,0,0,0,,Аңызға айналған жарық баспалдақтары болды.
Dialogue: 0,1:15:25.90,1:15:28.56,Default,,0,0,0,,Жұлдызды кеме де бір жерге көмілген болуы керек.
Dialogue: 0,1:15:28.73,1:15:30.83,Default,,0,0,0,,Иә, үміт бар.
Dialogue: 0,1:15:30.90,1:15:32.36,Default,,0,0,0,,Бірден қазып алайық
Dialogue: 0,1:15:32.46,1:15:33.83,Default,,0,0,0,,Дегенмен
Dialogue: 0,1:15:34.13,1:15:36.63,Default,,0,0,0,,Мольдің энергиясы таусылады.
Dialogue: 0,1:15:36.73,1:15:38.46,Default,,0,0,0,,Егер сіз оны бір оқта соқпасаңыз
Dialogue: 0,1:15:39.06,1:15:42.56,Default,,0,0,0,,Оның қай жерде екеніне ешқандай белгі жоқ.
Dialogue: 0,1:15:43.73,1:15:46.40,Default,,0,0,0,,Аа, дұрыс, оны алған кезден бастап шығарайық.
Dialogue: 0,1:15:47.50,1:15:50.00,Default,,0,0,0,,Әй, міне, бұл...
Dialogue: 0,1:15:50.06,1:15:50.83,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:15:51.40,1:15:53.30,Default,,0,0,0,,«Сәттілік айы»
Dialogue: 0,1:15:53.66,1:15:57.06,Default,,0,0,0,,Шикізат - жапон бұтасының жапырақтары
Dialogue: 0,1:15:57.16,1:15:58.56,Default,,0,0,0,,3 сағат бойы ішіңіз
Dialogue: 0,1:15:58.70,1:16:01.70,Default,,0,0,0,,Бақытты болғаныма сене алар емеспін.
Dialogue: 0,1:16:01.80,1:16:02.80,Default,,0,0,0,,Біреу?
Dialogue: 0,1:16:03.13,1:16:06.73,Default,,0,0,0,,Бұл әдетте твиттер жазбайтын адамдар үшін тиімдірек.
Dialogue: 0,1:16:07.20,1:16:08.40,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:16:08.63,1:16:11.20,Default,,0,0,0,,Ах! (Нобита) Мен? А, мен білдім
Dialogue: 0,1:16:11.96,1:16:14.46,Default,,0,0,0,,Сіз шынымен бақыттысыз ба?
Dialogue: 0,1:16:16.46,1:16:17.13,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,1:16:17.73,1:16:20.13,Default,,0,0,0,,3 сағатқа ғана тиімді, асығыңыз!
Dialogue: 0,1:16:20.73,1:16:22.70,Default,,0,0,0,,Өйткені мен тек саған ғана сенемін
Dialogue: 0,1:16:22.80,1:16:24.96,Default,,0,0,0,,Оны бір кадрдан табыңыз
Dialogue: 0,1:16:25.10,1:16:26.96,Default,,0,0,0,,Сәттілік Нобита-сан
Dialogue: 0,1:16:27.06,1:16:29.10,Default,,0,0,0,,Өмір сүру немесе өлу Нобитаға байланысты
Dialogue: 0,1:16:29.93,1:16:30.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:31.13,1:16:32.43,Default,,0,0,0,,Иә (Сунео) Жақсы.
Dialogue: 0,1:16:33.30,1:16:35.03,Default,,0,0,0,,Мына жерде сияқты
Dialogue: 0,1:16:35.13,1:16:36.73,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,1:16:36.80,1:16:38.96,Default,,0,0,0,,Қателік жасасаң, өзің кінәлісің.
Dialogue: 0,1:16:39.06,1:16:40.46,Default,,0,0,0,,Мен оны тауып, өлтіремін!
Dialogue: 0,1:16:41.13,1:16:43.46,Default,,0,0,0,,Нобитаның бақытына сенуден басқа амалым жоқ.
Dialogue: 0,1:16:43.73,1:16:46.90,Default,,0,0,0,,Қуатты толығымен ашыңыз. Қауіптен аулақ болыңыз.
Dialogue: 0,1:16:47.30,1:16:48.93,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:50.03,1:16:51.90,Default,,0,0,0,,Уау!
Dialogue: 0,1:17:00.80,1:17:01.70,Default,,0,0,0,,Уау
Dialogue: 0,1:17:01.83,1:17:03.66,Default,,0,0,0,,Мен оны шынымен таптым.
Dialogue: 0,1:17:03.76,1:17:05.36,Default,,0,0,0,,Өтірік сияқты
Dialogue: 0,1:17:06.30,1:17:08.36,Default,,0,0,0,,Шынымен де жұлдызды кеме
Dialogue: 0,1:17:08.46,1:17:09.66,Default,,0,0,0,,Бұл екі орындық па?
Dialogue: 0,1:17:09.76,1:17:11.03,Default,,0,0,0,,Мен мұны істедім (Нобита) Ах!
Dialogue: 0,1:17:11.13,1:17:12.20,Default,,0,0,0,,Уау Уау Уау Уау...
Dialogue: 0,1:17:12.30,1:17:13.20,Default,,0,0,0,,Уау
Dialogue: 0,1:17:14.50,1:17:16.03,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:16.63,1:17:18.16,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:17:18.26,1:17:19.63,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:17:21.03,1:17:23.76,Default,,0,0,0,,Нобита-сан, сен шынымен жақсысың ба?
Dialogue: 0,1:17:24.46,1:17:26.10,Default,,0,0,0,,3 сағат ішінде тиімді
Dialogue: 0,1:17:26.80,1:17:29.13,Default,,0,0,0,,2 сағат 45 минут қалды
Dialogue: 0,1:17:31.30,1:17:33.13,Default,,0,0,0,,Уау~
Dialogue: 0,1:17:49.26,1:17:50.70,Default,,0,0,0,,Деку…
Dialogue: 0,1:17:50.83,1:17:52.53,Default,,0,0,0,,Мм... иә?
Dialogue: 0,1:17:53.36,1:17:54.46,Default,,0,0,0,,Бұл
Dialogue: 0,1:17:54.86,1:17:57.53,Default,,0,0,0,,Ой, бұл ненің иісі? бұл иіс
Dialogue: 0,1:17:58.26,1:17:59.96,Default,,0,0,0,,Мына жаңбырдың иісі
Dialogue: 0,1:18:00.66,1:18:03.00,Default,,0,0,0,,Бұл міндетті түрде тозақ планетасы.
Dialogue: 0,1:18:03.53,1:18:05.76,Default,,0,0,0,,Дәрі жұмыс істеп тұр, асығайық.
Dialogue: 0,1:18:09.33,1:18:12.06,Default,,0,0,0,,Алдымен Нимугенің үйін табыңыз.
Dialogue: 0,1:18:12.16,1:18:14.33,Default,,0,0,0,,Ромиді күдіктенбей іздеңіз
Dialogue: 0,1:18:14.43,1:18:16.43,Default,,0,0,0,,Сосын мен сені үйіңе апарамын
Dialogue: 0,1:18:16.56,1:18:18.33,Default,,0,0,0,,Бұл шынымен де ыңғайлы ма?
Dialogue: 0,1:18:18.43,1:18:19.00,Default,,0,0,0,,Әй?
Dialogue: 0,1:18:20.00,1:18:21.10,Default,,0,0,0,,Жарық.
Dialogue: 0,1:18:24.03,1:18:25.43,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,1:18:28.93,1:18:31.76,Default,,0,0,0,,Бұл Нимугенің үйі. Бұл күлкілі.
Dialogue: 0,1:18:31.86,1:18:33.66,Default,,0,0,0,,Уау...
Dialogue: 0,1:18:34.53,1:18:35.20,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:18:35.93,1:18:37.10,Default,,0,0,0,,Оны ішке салыңыз
Dialogue: 0,1:18:37.23,1:18:39.26,Default,,0,0,0,,Уау аа
Dialogue: 0,1:18:39.73,1:18:40.86,Default,,0,0,0,,Хмм...
Dialogue: 0,1:18:40.93,1:18:41.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:42.66,1:18:45.60,Default,,0,0,0,,Нимге жердегілер сияқты адам болды ма?
Dialogue: 0,1:18:45.90,1:18:46.93,Default,,0,0,0,,Иә.
Dialogue: 0,1:18:52.10,1:18:53.93,Default,,0,0,0,,Ластанған ортада өмір сүру
Dialogue: 0,1:18:56.06,1:18:58.43,Default,,0,0,0,,Сіз осындай қорғаныс киімін киіп көрдіңіз бе?
Dialogue: 0,1:19:03.06,1:19:04.23,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:04.33,1:19:05.66,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,1:19:06.83,1:19:08.76,Default,,0,0,0,,Егер сіз ерінбей қалсаңыз, капитан сізге ұрысады.
Dialogue: 0,1:19:08.83,1:19:09.80,Default,,0,0,0,,Иә!
Dialogue: 0,1:19:12.16,1:19:14.00,Default,,0,0,0,,Қаруға қолдануға болатын бөлшектер
Dialogue: 0,1:19:14.10,1:19:16.50,Default,,0,0,0,,Әрқайсысын табыңыз.
Dialogue: 0,1:19:26.60,1:19:30.73,Default,,0,0,0,,Не болса да, ата-бабаң ұлы болған.
Dialogue: 0,1:19:30.83,1:19:34.60,Default,,0,0,0,,Мұны бәріміз өз күшімізбен жасадық.
Dialogue: 0,1:19:37.00,1:19:37.73,Default,,0,0,0,,Не болды?
Dialogue: 0,1:19:37.83,1:19:39.46,Default,,0,0,0,,Жоқ... жоқ.
Dialogue: 0,1:19:39.73,1:19:43.16,Default,,0,0,0,,Дегенмен ғылым мен техника дамып жатты.
Dialogue: 0,1:19:43.26,1:19:46.10,Default,,0,0,0,,Себебі мен аздап алданып, тым көп жасадым.
Dialogue: 0,1:19:46.16,1:19:49.00,Default,,0,0,0,,Дүниенің тас-талқан болғаны жаман болды.
Dialogue: 0,1:19:50.00,1:19:51.10,Default,,0,0,0,,Не болды?
Dialogue: 0,1:19:52.46,1:19:54.90,Default,,0,0,0,,Не? Шпион кіріп кетті ме?
Dialogue: 0,1:19:55.63,1:19:58.33,Default,,0,0,0,,Кіруді бекітіп, барлығын сапқа тұрғызыңыз.
Dialogue: 0,1:19:58.50,1:20:01.13,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:20:01.23,1:20:03.90,Default,,0,0,0,,үшін сапқа тұрады үшін сапқа тұрады
Dialogue: 0,1:20:04.93,1:20:06.80,Default,,0,0,0,,О... не істеуім керек?
Dialogue: 0,1:20:07.16,1:20:08.96,Default,,0,0,0,,Адам, бұл қиын.
Dialogue: 0,1:20:09.06,1:20:11.76,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,1:20:14.93,1:20:18.16,Default,,0,0,0,,Қазір мұнда тыңшы бар сияқты.
Dialogue: 0,1:20:19.56,1:20:22.16,Default,,0,0,0,,Әр адам бетперделерін шешсін, жарай ма?
Dialogue: 0,1:20:22.83,1:20:24.76,Default,,0,0,0,,Бетпердеңізді шешіңіз (мүше) Иә.
Dialogue: 0,1:20:25.66,1:20:26.66,Default,,0,0,0,,Жарайды
Dialogue: 0,1:20:28.13,1:20:29.00,Default,,0,0,0,,Келесі!
Dialogue: 0,1:20:31.80,1:20:32.83,Default,,0,0,0,,Жарайды
Dialogue: 0,1:20:34.90,1:20:35.56,Default,,0,0,0,,Келесі!
Dialogue: 0,1:20:38.16,1:20:39.23,Default,,0,0,0,,Жарайды
Dialogue: 0,1:20:39.90,1:20:40.83,Default,,0,0,0,,Келесі!
Dialogue: 0,1:20:41.76,1:20:42.80,Default,,0,0,0,,Жарайды
Dialogue: 0,1:20:43.56,1:20:45.16,Default,,0,0,0,,Келесі! (масканы шешкен дыбыс)
Dialogue: 0,1:20:46.60,1:20:47.50,Default,,0,0,0,,Жарайды
Dialogue: 0,1:20:47.76,1:20:50.46,Default,,0,0,0,,Хмм...дәрінің әсері тозған шығар?
Dialogue: 0,1:20:50.93,1:20:51.96,Default,,0,0,0,,Жарайды
Dialogue: 0,1:20:53.06,1:20:53.90,Default,,0,0,0,,Келесі!
Dialogue: 0,1:20:56.23,1:20:56.90,Default,,0,0,0,,Жарайды
Dialogue: 0,1:20:57.26,1:20:59.33,Default,,0,0,0,,Дорэмон, біз не істеуіміз керек?
Dialogue: 0,1:21:06.40,1:21:09.20,Default,,0,0,0,,Бұл Чиппо айтқан қирандылар.
Dialogue: 0,1:21:09.30,1:21:11.56,Default,,0,0,0,,1000 жыл бұрын алғашқы иммигранттар
Dialogue: 0,1:21:11.66,1:21:13.90,Default,,0,0,0,,Бұл жерде құдайға табынған деп айтылады.
Dialogue: 0,1:21:15.73,1:21:17.33,Default,,0,0,0,,Бұл керемет
Dialogue: 0,1:21:17.40,1:21:20.36,Default,,0,0,0,,Бұл жерде оңай жеңілуіңіз екіталай.
Dialogue: 0,1:21:25.90,1:21:28.70,Default,,0,0,0,,Әкім, сіз менің баламды құтқардыңыз.
Dialogue: 0,1:21:28.80,1:21:31.83,Default,,0,0,0,,Ержүрек иттер... жоқ, мысықтар.
Dialogue: 0,1:21:32.53,1:21:35.16,Default,,0,0,0,,Мен мэр Ву-Танмын.
Dialogue: 0,1:21:35.23,1:21:37.40,Default,,0,0,0,,Енді бұл мәселе.
Dialogue: 0,1:21:37.53,1:21:40.23,Default,,0,0,0,,Біз төбелесуді мүлде білмейміз
Dialogue: 0,1:21:40.56,1:21:45.23,Default,,0,0,0,,Сондықтан мен енот иттің...дәлірек айтсақ, мысықтың көмегін алғым келеді.
Dialogue: 0,1:21:45.83,1:21:48.20,Default,,0,0,0,,Нимге ертең таңертең болатын шығар.
Dialogue: 0,1:21:48.30,1:21:50.86,Default,,0,0,0,,Олар бұл планетаға тағы да шабуыл жасайды.
Dialogue: 0,1:21:50.96,1:21:53.63,Default,,0,0,0,,Сондықтан мен қолымнан келгенше көп қару жасадым...
Dialogue: 0,1:21:53.73,1:21:55.13,Default,,0,0,0,,«Оқпалы мылтық» немесе «пневматикалық зеңбірек»?
Dialogue: 0,1:21:55.70,1:21:58.20,Default,,0,0,0,,Бұл сенімсіз, бірақ санын көбейтіңіз
Dialogue: 0,1:21:58.30,1:22:01.20,Default,,0,0,0,,үшінмыз бірігіп жұмыс жасасақ, қолымыздан бәрі келеді.
Dialogue: 0,1:22:01.30,1:22:03.63,Default,,0,0,0,,Қалай болғанда да, мен оны жерге қонбай тұрып жеңгім келеді.
Dialogue: 0,1:22:04.30,1:22:08.63,Default,,0,0,0,,Біз бар күшімізді саламыз. Сізге көп рахмет.
Dialogue: 0,1:22:09.26,1:22:12.13,Default,,0,0,0,,Енот ит... Жоқ, мысық, өтінемін.
Dialogue: 0,1:22:12.26,1:22:14.86,Default,,0,0,0,,Енот ит болсаң бәрібір.
Dialogue: 0,1:22:14.96,1:22:17.13,Default,,0,0,0,,(Сунео мен оның достарының күлкісі)
Dialogue: 0,1:22:18.30,1:22:20.63,Default,,0,0,0,,«Пневматикалық зеңбірек» және «шок мылтығы» туралы тезірек сөйлесейік.
Dialogue: 0,1:22:20.73,1:22:22.40,Default,,0,0,0,,Жаппай өндірісті бастау
Dialogue: 0,1:22:22.46,1:22:23.46,Default,,0,0,0,,Иә
Dialogue: 0,1:22:23.90,1:22:25.46,Default,,0,0,0,,Нобита-сан, жақсысың ба?
Dialogue: 0,1:22:26.06,1:22:27.63,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,1:22:28.03,1:22:30.90,Default,,0,0,0,,Уф... 1 сағат қалды.
Dialogue: 0,1:22:32.80,1:22:33.80,Default,,0,0,0,,Келесі
Dialogue: 0,1:22:34.63,1:22:35.90,Default,,0,0,0,,Хигучи
Dialogue: 0,1:22:36.86,1:22:38.13,Default,,0,0,0,,Уф...
Dialogue: 0,1:22:38.70,1:22:40.73,Default,,0,0,0,,Сіз не күтіп тұрсыз?
Dialogue: 0,1:22:40.80,1:22:42.13,Default,,0,0,0,,Бетпердеңізді тез шешіңіз
Dialogue: 0,1:22:42.26,1:22:42.96,Default,,0,0,0,,Уф
Dialogue: 0,1:22:43.10,1:22:43.96,Default,,0,0,0,,Тецу (Нобита) Уау!
Dialogue: 0,1:22:44.10,1:22:44.96,Default,,0,0,0,,Қашудың пайдасы жоқ!
Dialogue: 0,1:22:45.30,1:22:46.96,Default,,0,0,0,,Иә? Айқай? Хаха
Dialogue: 0,1:22:47.36,1:22:50.36,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,1:22:50.46,1:22:52.30,Default,,0,0,0,,Уф аааа
Dialogue: 0,1:22:52.90,1:22:54.40,Default,,0,0,0,,Ах... у...
Dialogue: 0,1:23:02.53,1:23:03.36,Default,,0,0,0,,Уф
Dialogue: 0,1:23:03.93,1:23:04.86,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,1:23:05.96,1:23:08.30,Default,,0,0,0,,Өйткені, ол федералды полицияның тыңшысы.
Dialogue: 0,1:23:08.70,1:23:09.80,Default,,0,0,0,,Полиция тыңшысы?
Dialogue: 0,1:23:10.76,1:23:11.76,Default,,0,0,0,,Эй, мына екі адам.
Dialogue: 0,1:23:12.10,1:23:13.20,Default,,0,0,0,,Иә! (Нобита) Ух...
Dialogue: 0,1:23:13.76,1:23:16.20,Default,,0,0,0,,Мына жігітті ұяшыққа қамап қойыңыз.
Dialogue: 0,1:23:16.50,1:23:18.16,Default,,0,0,0,,Иә, иә! (мүше) А?
Dialogue: 0,1:23:18.60,1:23:20.13,Default,,0,0,0,,Хмм...
Dialogue: 0,1:23:21.30,1:23:23.03,Default,,0,0,0,,Тез жүріңіз
Dialogue: 0,1:23:26.33,1:23:28.20,Default,,0,0,0,,Тезірек кіріңіз!
Dialogue: 0,1:23:39.03,1:23:40.46,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,1:23:40.53,1:23:41.93,Default,,0,0,0,,Мен сүйкімді итіммен біргемін.
Dialogue: 0,1:23:42.20,1:23:42.86,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:43.20,1:23:43.86,Default,,0,0,0,,Роми-чан!
Dialogue: 0,1:23:44.36,1:23:45.26,Default,,0,0,0,,Не? Сіз
Dialogue: 0,1:23:45.36,1:23:46.66,Default,,0,0,0,,Ой... иә
Dialogue: 0,1:23:46.76,1:23:48.10,Default,,0,0,0,,Уау
Dialogue: 0,1:23:48.96,1:23:51.46,Default,,0,0,0,,Роми-чан, асығыңыз! Мм... кім?
Dialogue: 0,1:23:51.53,1:23:53.13,Default,,0,0,0,,Жоқ... О, түсіндім.
Dialogue: 0,1:23:53.20,1:23:55.20,Default,,0,0,0,,Аю! (Нобита) Жүр, тез кетейік.
Dialogue: 0,1:23:56.36,1:23:57.20,Default,,0,0,0,,Тея (мүше) Уау!
Dialogue: 0,1:23:58.20,1:23:59.03,Default,,0,0,0,,Хмм
Dialogue: 0,1:23:59.80,1:24:01.50,Default,,0,0,0,,Тез қаш!
Dialogue: 0,1:24:01.60,1:24:03.56,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,1:24:04.60,1:24:06.43,Default,,0,0,0,,Енді, иә.
Dialogue: 0,1:24:11.06,1:24:14.10,Default,,0,0,0,,Біздің уақытымыз жоқ. Асықпасақ, салдары жойылады.
Dialogue: 0,1:24:14.23,1:24:15.10,Default,,0,0,0,,Тиімділік?
Dialogue: 0,1:24:18.10,1:24:20.43,Default,,0,0,0,,Кейінірек түсіндіру, асығыңыз да, бортқа мініңіз.
Dialogue: 0,1:24:20.53,1:24:21.06,Default,,0,0,0,,Иә
Dialogue: 0,1:24:21.50,1:24:22.53,Default,,0,0,0,,осы портта бір жерде жасырынып, бізді бақылап отыр.
Dialogue: 0,1:24:22.86,1:24:25.00,Default,,0,0,0,,Бәрі де болса, мұны істейік.
Dialogue: 0,1:24:38.83,1:24:40.36,Default,,0,0,0,,Га
Dialogue: 0,1:24:43.40,1:24:46.16,Default,,0,0,0,,Эй, бұл жиналу тәртібі. Тезірек алаңға келіңіз.
Dialogue: 0,1:24:46.26,1:24:47.26,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,1:24:57.16,1:25:00.33,Default,,0,0,0,,Жолдастар, көптен күткен сәт те келді.
Dialogue: 0,1:25:01.23,1:25:05.30,Default,,0,0,0,,Ертеңгі күннің шығуын күтіп, Жылдар бойы жасаған еңбегің қайтарылады.
Dialogue: 0,1:25:05.83,1:25:10.16,Default,,0,0,0,,Біз адамдардың ғарышқа қайтадан ұшатын кезі келді.
Dialogue: 0,1:25:12.00,1:25:13.96,Default,,0,0,0,,Ойлап қарасаңыз, 1000 жыл бұрын
Dialogue: 0,1:25:14.33,1:25:18.00,Default,,0,0,0,,Біздің ақымақ бабаларымыз табиғатты бүлдірген.
Dialogue: 0,1:25:18.13,1:25:19.66,Default,,0,0,0,,Су, ауа,
Dialogue: 0,1:25:19.93,1:25:21.56,Default,,0,0,0,,Жерді ластаңыз
Dialogue: 0,1:25:21.83,1:25:24.50,Default,,0,0,0,,Күннің соңында бұл планета ядролық соғыспен жойылады
Dialogue: 0,1:25:24.63,1:25:26.90,Default,,0,0,0,,Тәртіпсіздік жасағаннан кейін
Dialogue: 0,1:25:27.26,1:25:31.83,Default,,0,0,0,,Адамзат жер астында, аянышты түрде аман қалды.
Dialogue: 0,1:25:32.96,1:25:34.56,Default,,0,0,0,,Бірақ не?
Dialogue: 0,1:25:34.66,1:25:39.13,Default,,0,0,0,,Қолымды созғанымда, қол жететін жерде қазына жұлдызы тұр екен.
Dialogue: 0,1:25:44.30,1:25:49.00,Default,,0,0,0,,Ғалым жануарларды сол планетаға көшірді.
Dialogue: 0,1:25:49.50,1:25:52.43,Default,,0,0,0,,Және сол жерде дамиды
Dialogue: 0,1:25:52.50,1:25:55.40,Default,,0,0,0,,Олар өздері үшін ғана қоғам құру үшін жаратылған.
Dialogue: 0,1:26:04.06,1:26:06.03,Default,,0,0,0,,Бұл жұлдыз
Dialogue: 0,1:26:09.33,1:26:11.30,Default,,0,0,0,,Кеттік, басып алайық
Dialogue: 0,1:26:12.56,1:26:17.23,Default,,0,0,0,,1000 жыл бұрынғы бай өмірді өз қолымызбен қалпына келтірейік!
Dialogue: 0,1:26:17.63,1:26:21.16,Default,,0,0,0,,О! о! о!
Dialogue: 0,1:26:25.20,1:26:28.53,Default,,0,0,0,,Сонымен, ол қанша уақытта жұмысын тоқтатады?
Dialogue: 0,1:26:28.63,1:26:29.56,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:26:29.80,1:26:30.86,Default,,0,0,0,,Иә!?
Dialogue: 0,1:26:36.40,1:26:37.50,Default,,0,0,0,,1 минут қалды
Dialogue: 0,1:26:37.90,1:26:40.46,Default,,0,0,0,,Сіз не күтіп тұрсыз?
Dialogue: 0,1:26:40.90,1:26:43.13,Default,,0,0,0,,Ай бірте-бірте жоғалып барады
Dialogue: 0,1:26:43.23,1:26:45.86,Default,,0,0,0,,Дорэмон, біз не істей аламыз?
Dialogue: 0,1:26:45.96,1:26:47.46,Default,,0,0,0,,40 секунд қалды
Dialogue: 0,1:26:47.56,1:26:48.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:50.66,1:26:51.90,Default,,0,0,0,,Ай жоғалып кетті
Dialogue: 0,1:26:54.23,1:26:55.83,Default,,0,0,0,,А, мен қайтып келдім!
Dialogue: 0,1:26:56.16,1:26:57.23,Default,,0,0,0,,Не? шын?
Dialogue: 0,1:26:57.36,1:26:58.16,Default,,0,0,0,,Бұл рас!
Dialogue: 0,1:26:58.23,1:27:02.30,Default,,0,0,0,,(Дораэмонның қуанышы)
Dialogue: 0,1:27:03.06,1:27:04.73,Default,,0,0,0,,Нобита! Нобита-сан!
Dialogue: 0,1:27:08.86,1:27:09.63,Default,,0,0,0,,Міне, міне!
Dialogue: 0,1:27:09.76,1:27:11.23,Default,,0,0,0,,Сәттілік! жалғастыра бер!
Dialogue: 0,1:27:11.30,1:27:12.13,Default,,0,0,0,,Міне, міне!
Dialogue: 0,1:27:12.70,1:27:14.63,Default,,0,0,0,,Жоқ, уақыт бітті.
Dialogue: 0,1:27:15.06,1:27:16.56,Default,,0,0,0,,Уау!
Dialogue: 0,1:27:17.26,1:27:18.90,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:27:19.26,1:27:20.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:20.86,1:27:21.93,Default,,0,0,0,,О
Dialogue: 0,1:27:22.56,1:27:23.90,Default,,0,0,0,,Иә...
Dialogue: 0,1:27:23.96,1:27:25.73,Default,,0,0,0,,А-а, Чиппо-чан!
Dialogue: 0,1:27:25.80,1:27:26.80,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:27:27.36,1:27:28.76,Default,,0,0,0,,Роми-чан! (Нобита) Шизука-чан!
Dialogue: 0,1:27:28.86,1:27:31.06,Default,,0,0,0,,Нобита! Нобита-кун!
Dialogue: 0,1:27:31.13,1:27:33.70,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,1:27:33.80,1:27:35.60,Default,,0,0,0,,Жарайсың
Dialogue: 0,1:27:35.70,1:27:36.63,Default,,0,0,0,,«Сәттілік айы» арқасында
Dialogue: 0,1:27:36.73,1:27:39.40,Default,,0,0,0,,Керемет, Нобита, мен уайымдадым.
Dialogue: 0,1:27:39.46,1:27:41.76,Default,,0,0,0,,Нобита болса жақсы болар еді.
Dialogue: 0,1:27:45.23,1:27:48.70,Default,,0,0,0,,Нимуге адам болған ба?
Dialogue: 0,1:27:49.13,1:27:52.96,Default,,0,0,0,,Чиппо айтқан мифтердің барлығы шынайы оқиғалар болды.
Dialogue: 0,1:27:53.30,1:27:55.43,Default,,0,0,0,,Адамдар өзімшіл.
Dialogue: 0,1:27:55.53,1:27:58.43,Default,,0,0,0,,Иә? Джан, ол адам емес пе?
Dialogue: 0,1:27:58.53,1:28:01.50,Default,,0,0,0,,Иә, ұмытып кетіппін.
Dialogue: 0,1:28:01.60,1:28:03.46,Default,,0,0,0,,(Нобита мен оның достарының күлкісі)
Dialogue: 0,1:28:03.86,1:28:06.03,Default,,0,0,0,,Мүмкін ертең таңертең олар келетін шығар.
Dialogue: 0,1:28:06.16,1:28:08.43,Default,,0,0,0,,Біз бұл планетаны қандай жағдайда да қорғауымыз керек.
Dialogue: 0,1:28:09.10,1:28:12.13,Default,,0,0,0,,Бүгін жақсы ұйықтап, ертеңгі күнге дайындалайық!
Dialogue: 0,1:28:12.20,1:28:13.76,Default,,0,0,0,,Оу!
Dialogue: 0,1:28:23.66,1:28:25.10,Default,,0,0,0,,Nimuge?
Dialogue: 0,1:28:26.20,1:28:27.43,Default,,0,0,0,,Нобита-сан (Нобита) Уау!
Dialogue: 0,1:28:27.53,1:28:29.33,Default,,0,0,0,,Бір минут күтіңіз, күте тұрыңыз, о...
Dialogue: 0,1:28:29.53,1:28:32.30,Default,,0,0,0,,Жарайды, мен ондай ештеңе кимеймін.
Dialogue: 0,1:28:32.36,1:28:33.36,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:33.66,1:28:37.76,Default,,0,0,0,,Мен оның бөтен адам екенін әу бастан білдім.
Dialogue: 0,1:28:38.03,1:28:39.70,Default,,0,0,0,,Сонда неге?
Dialogue: 0,1:28:40.63,1:28:42.70,Default,,0,0,0,,Мен дос болғым келді (Нобита) Иә?
Dialogue: 0,1:28:43.36,1:28:47.20,Default,,0,0,0,,Нобита-сан, сен неге біздің планетаны қорғайсың?
Dialogue: 0,1:28:47.76,1:28:52.20,Default,,0,0,0,,Дұрыс, бұл арман сияқты әдемі жұлдыз.
Dialogue: 0,1:28:52.63,1:28:55.03,Default,,0,0,0,,Нобита мен оның достарының планеталары туралы не ойлайсың?
Dialogue: 0,1:28:55.16,1:28:58.83,Default,,0,0,0,,Міне, мына жұлдыздай әдемі екен.
Dialogue: 0,1:28:59.36,1:29:00.73,Default,,0,0,0,,Әзірге.
Dialogue: 0,1:29:01.10,1:29:02.16,Default,,0,0,0,,Қазір ше?
Dialogue: 0,1:29:02.53,1:29:05.50,Default,,0,0,0,,Енді, бұдан былай әрқашан біз боламыз.
Dialogue: 0,1:29:05.60,1:29:07.73,Default,,0,0,0,,Мен оны әдемі жұлдызға айналдырамын
Dialogue: 0,1:29:09.26,1:29:11.16,Default,,0,0,0,,Бірде барсам болады ма?
Dialogue: 0,1:29:11.26,1:29:12.43,Default,,0,0,0,,Қажеті жоқ. Айтқым келетін ешкім жоқ.
Dialogue: 0,1:29:12.56,1:29:14.40,Default,,0,0,0,,Мен шынымен уәде бердім
Dialogue: 0,1:29:14.50,1:29:15.53,Default,,0,0,0,,Иә
Dialogue: 0,1:29:15.60,1:29:16.50,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,1:29:16.60,1:29:19.53,Default,,0,0,0,,Ах Чиппо, ертең барымызды салайық.
Dialogue: 0,1:29:19.60,1:29:20.43,Default,,0,0,0,,Иә
Dialogue: 0,1:29:36.83,1:29:39.00,Default,,0,0,0,,үшін тағайындалды
Dialogue: 0,1:29:53.10,1:29:55.10,Default,,0,0,0,,Хмм...
Dialogue: 0,1:29:58.66,1:30:00.60,Default,,0,0,0,,Бұл шығыс аспаннан келді!
Dialogue: 0,1:30:03.86,1:30:06.56,Default,,0,0,0,,Қалаға түспес бұрын, оны осында тартып алайық.
Dialogue: 0,1:30:10.06,1:30:13.43,Default,,0,0,0,,Шизука-чан, сен «ескерту отшашуына» дайынсың ба?
Dialogue: 0,1:30:13.70,1:30:14.43,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:30:16.83,1:30:18.56,Default,,0,0,0,,Бұл қаланың орталығы дерлік.
Dialogue: 0,1:30:18.66,1:30:20.33,Default,,0,0,0,,Қонуға дайындал (бригадир) Ха!
Dialogue: 0,1:30:25.56,1:30:27.40,Default,,0,0,0,,Өрт!
Dialogue: 0,1:30:32.26,1:30:33.26,Default,,0,0,0,,Күте тұрыңыз! (отшашудың дыбысы)
Dialogue: 0,1:30:33.40,1:30:36.93,Default,,0,0,0,,Бізбен жекпе-жекке шығуға тырысқаның соншалық.
Dialogue: 0,1:30:37.20,1:30:38.66,Default,,0,0,0,,Орманға барыңыз (бастық) га!
Dialogue: 0,1:30:39.26,1:30:43.10,Default,,0,0,0,,Олар келе жатыр, бір мезгілде барлық «пневматикалық зеңбіректерді» атады.
Dialogue: 0,1:30:43.23,1:30:45.10,Default,,0,0,0,,Тек орындаңыз! (Сунео) Жарайды.
Dialogue: 0,1:30:48.93,1:30:50.40,Default,,0,0,0,,Өрт!
Dialogue: 0,1:30:50.50,1:30:53.16,Default,,0,0,0,,Бум бум!
Dialogue: 0,1:30:57.90,1:31:00.33,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,1:31:00.96,1:31:02.83,Default,,0,0,0,,Сіз қаруды қашан алдыңыз?
Dialogue: 0,1:31:06.33,1:31:09.23,Default,,0,0,0,,А-а... (Нобита) А-а
Dialogue: 0,1:31:15.96,1:31:18.43,Default,,0,0,0,,Шегін!
Dialogue: 0,1:31:21.33,1:31:23.76,Default,,0,0,0,,(Жануарлардың айқайы)
Dialogue: 0,1:31:24.30,1:31:25.66,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,1:31:39.96,1:31:41.16,Default,,0,0,0,,«Оқпалы мылтық»
Dialogue: 0,1:31:41.30,1:31:42.56,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,1:31:42.76,1:31:45.50,Default,,0,0,0,,Не? Ол ауырмайды және қышымайды
Dialogue: 0,1:31:45.90,1:31:48.00,Default,,0,0,0,,Қорғаныс киіміне қолданылмайды
Dialogue: 0,1:31:48.33,1:31:49.76,Default,,0,0,0,,Уау! Не?
Dialogue: 0,1:31:50.66,1:31:52.43,Default,,0,0,0,,Жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,1:31:52.50,1:31:53.76,Default,,0,0,0,,Иә (Нобита) Жақсы емес.
Dialogue: 0,1:31:53.83,1:31:54.90,Default,,0,0,0,,Ei
Dialogue: 0,1:31:56.73,1:31:58.46,Default,,0,0,0,,Уа, уай, уау (2-мүше) Не болды!?
Dialogue: 0,1:31:58.56,1:32:00.13,Default,,0,0,0,,Whoa (4-мүше) Не? Апыр-ай!
Dialogue: 0,1:32:00.20,1:32:02.06,Default,,0,0,0,,Уау, мен жасадым! мен оны істедім!
Dialogue: 0,1:32:02.20,1:32:03.06,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,1:32:03.16,1:32:05.06,Default,,0,0,0,,Уау!
Dialogue: 0,1:32:05.46,1:32:08.03,Default,,0,0,0,,Жануарлардың танк корпусы жөнелтілді!
Dialogue: 0,1:32:08.13,1:32:10.03,Default,,0,0,0,,Жануарлардың танкі? Иә
Dialogue: 0,1:32:10.23,1:32:12.46,Default,,0,0,0,,(Жануарлардың айқайы)
Dialogue: 0,1:32:12.63,1:32:14.00,Default,,0,0,0,,Керемет күш!
Dialogue: 0,1:32:14.06,1:32:15.90,Default,,0,0,0,,Мен де барамын! (Сунео) Бұл!
Dialogue: 0,1:32:18.36,1:32:20.56,Default,,0,0,0,,Жер бетіндегі соғыс жағдайы қалай болып жатыр?
Dialogue: 0,1:32:21.36,1:32:23.40,Default,,0,0,0,,(мүшелердің айқайы)
Dialogue: 0,1:32:23.70,1:32:24.70,Default,,0,0,0,,Жоқ... не болды!?
Dialogue: 0,1:32:24.80,1:32:26.06,Default,,0,0,0,,(мүшелердің айқайы)
Dialogue: 0,1:32:26.20,1:32:30.06,Default,,0,0,0,,(Жануарлар үреді)
Dialogue: 0,1:32:30.23,1:32:33.03,Default,,0,0,0,,Бұл планетаны дереу тастаңыз!
Dialogue: 0,1:32:33.30,1:32:36.40,Default,,0,0,0,,Мен көремін. Бұл енот иттің жұмысы ма?
Dialogue: 0,1:32:37.30,1:32:39.23,Default,,0,0,0,,Түсіндік, артқа шегінейік.
Dialogue: 0,1:32:40.00,1:32:41.06,Default,,0,0,0,,Шегін!
Dialogue: 0,1:32:42.66,1:32:44.63,Default,,0,0,0,,Иә! (Сунео) Ей, әлсіз!
Dialogue: 0,1:32:44.73,1:32:45.90,Default,,0,0,0,,Жақсы, иә?
Dialogue: 0,1:32:46.66,1:32:48.66,Default,,0,0,0,,Президент Мисумису...
Dialogue: 0,1:32:48.73,1:32:50.86,Default,,0,0,0,,Беткейлеу! (Бастық) Анау енот ит...
Dialogue: 0,1:32:51.20,1:32:55.50,Default,,0,0,0,,Хехе, жолдастар, мен сендерді қуыруға жол бере алмаймын.
Dialogue: 0,1:32:55.56,1:32:56.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:56.86,1:32:58.73,Default,,0,0,0,,Орманды өрте!
Dialogue: 0,1:33:01.90,1:33:03.30,Default,,0,0,0,,(Жануарлардың айқайы)
Dialogue: 0,1:33:03.80,1:33:05.63,Default,,0,0,0,,Жоқ. Мен орманды өртеп жіберемін.
Dialogue: 0,1:33:05.73,1:33:06.76,Default,,0,0,0,,Қаш, қаш!
Dialogue: 0,1:33:07.03,1:33:09.20,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,1:33:09.30,1:33:11.63,Default,,0,0,0,,(Жануарлардың айқайы)
Dialogue: 0,1:33:11.73,1:33:13.43,Default,,0,0,0,,Мен сені таңдадым, себебі маған асталы дүниеде ауыр қару-жарақ қажет болады.
Dialogue: 0,1:33:13.63,1:33:15.96,Default,,0,0,0,,«Жаңбыр бұлтын жасаушы»
Dialogue: 0,1:33:22.96,1:33:25.86,Default,,0,0,0,,Жаңбыр жауып тұр!
Dialogue: 0,1:33:25.93,1:33:28.30,Default,,0,0,0,,Ия, иә, от сөнді!
Dialogue: 0,1:33:28.40,1:33:29.76,Default,,0,0,0,,Қанша рет айтсаң да түсінбейтін ақымақтар әрқашан болады.
Dialogue: 0,1:33:29.86,1:33:31.13,Default,,0,0,0,,Ах
Dialogue: 0,1:33:37.36,1:33:39.60,Default,,0,0,0,,Бұл керемет. Мен енді мұны істей алмаймын.
Dialogue: 0,1:33:39.70,1:33:41.53,Default,,0,0,0,,Кира мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,1:33:41.93,1:33:44.20,Default,,0,0,0,,Джан тез тез
Dialogue: 0,1:33:44.30,1:33:46.73,Default,,0,0,0,,Дораемон, ол біртүрлі әрекет етеді.
Dialogue: 0,1:33:46.80,1:33:47.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:54.90,1:33:57.86,Default,,0,0,0,,Кокурочи Мен енді қаша алмаймын
Dialogue: 0,1:33:57.96,1:33:59.86,Default,,0,0,0,,Момындықпен беріл!
Dialogue: 0,1:34:00.66,1:34:02.36,Default,,0,0,0,,Олар сенің жаныңда ма?
Dialogue: 0,1:34:10.20,1:34:11.83,Default,,0,0,0,,(Жануарлардың шулары)
Dialogue: 0,1:34:12.36,1:34:14.20,Default,,0,0,0,,Күтілгендей, Кума-кун
Dialogue: 0,1:34:16.10,1:34:16.76,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,1:34:17.10,1:34:18.13,Default,,0,0,0,,Шпион мырза!
Dialogue: 0,1:34:18.20,1:34:19.70,Default,,0,0,0,,Не? шпион?
Dialogue: 0,1:34:20.16,1:34:21.36,Default,,0,0,0,,Жақсысың деп үміттенемін.
Dialogue: 0,1:34:21.46,1:34:23.20,Default,,0,0,0,,Эй, сен нені айтып тұрсың?
Dialogue: 0,1:34:23.33,1:34:24.70,Default,,0,0,0,,Мен сізді қорқытқаным үшін кешіріңіз.
Dialogue: 0,1:34:25.13,1:34:28.16,Default,,0,0,0,,Біз оларды ұстау үшін келдік.
Dialogue: 0,1:34:28.36,1:34:29.60,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,1:34:30.20,1:34:33.03,Default,,0,0,0,,Кокурочидан құпия қоғамы
Dialogue: 0,1:34:34.10,1:34:36.26,Default,,0,0,0,,Кешіріңіз, маскаңызды шешіңіз.
Dialogue: 0,1:34:36.36,1:34:37.03,Default,,0,0,0,,Жарайды
Dialogue: 0,1:34:39.80,1:34:41.03,Default,,0,0,0,,(бастың тыныс алу дыбысы)
Dialogue: 0,1:34:41.70,1:34:42.86,Default,,0,0,0,,Хмм...
Dialogue: 0,1:34:43.00,1:34:45.20,Default,,0,0,0,,Керемет атмосфера
Dialogue: 0,1:34:45.30,1:34:47.33,Default,,0,0,0,,Тез жүр (Бастық) А.
Dialogue: 0,1:34:54.46,1:34:58.53,Default,,0,0,0,,Адамдардың барлығын ақымақ деп ойламаңыз.
Dialogue: 0,1:34:58.86,1:35:01.60,Default,,0,0,0,,Біздің планетамызға қауіп төнгенде
Dialogue: 0,1:35:01.73,1:35:04.73,Default,,0,0,0,,Мен ешқашан бұрынғы қателікті қайталамауым керек.
Dialogue: 0,1:35:05.50,1:35:10.66,Default,,0,0,0,,Осыны сабақ ретінде қабылдай отырып, біз күш біріктіріп, басынан бастауды жөн көрдік.
Dialogue: 0,1:35:11.00,1:35:13.33,Default,,0,0,0,,Ал 1000 жылдан кейін
Dialogue: 0,1:35:13.43,1:35:16.23,Default,,0,0,0,,Әйтеуір өркениетті қайта құру перспективасы белгіленді.
Dialogue: 0,1:35:16.53,1:35:20.43,Default,,0,0,0,,Алайда кейбір ақымақ адамдар ескі армандарынан бас тарта алмайды.
Dialogue: 0,1:35:20.56,1:35:23.23,Default,,0,0,0,,Әлемнің адамдар үшін бар екендігі
Dialogue: 0,1:35:23.33,1:35:25.56,Default,,0,0,0,,Осы планетадағы барлық адамдарға қиындық тудырыңыз
Dialogue: 0,1:35:25.66,1:35:27.76,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:35:28.76,1:35:30.23,Default,,0,0,0,,Біздің жұлдыз да
Dialogue: 0,1:35:30.33,1:35:33.73,Default,,0,0,0,,Біз жануарлармен бірге өмір сүретін планета жасаймыз.
Dialogue: 0,1:35:33.83,1:35:35.56,Default,,0,0,0,,Мұнда Он екі Құбыжық Айдың тек Төменгі Айлары ғана жиналған
Dialogue: 0,1:35:41.20,1:35:43.76,Default,,0,0,0,,Анашым! Анашым! Нобита ше?
Dialogue: 0,1:35:43.90,1:35:47.10,Default,,0,0,0,,О? Чиппо қоштаспады ма?
Dialogue: 0,1:35:47.20,1:35:49.93,Default,,0,0,0,,Иә? Қайтып кеттің бе? Ол емес
Dialogue: 0,1:35:50.06,1:35:52.16,Default,,0,0,0,,Мен сонда біраз уақыт боламын. Сәлем Чиппо.
Dialogue: 0,1:35:52.26,1:35:53.53,Default,,0,0,0,,Қайырлы таң... Ах, қайырлы таң!
Dialogue: 0,1:35:53.60,1:35:55.76,Default,,0,0,0,,Сіз не туралы үрейленесіз?
Dialogue: 0,1:35:56.76,1:35:59.06,Default,,0,0,0,,Нобита-сан, сен жасырынсың.
Dialogue: 0,1:35:59.66,1:36:01.50,Default,,0,0,0,,Жерге қалай ораласыз?
Dialogue: 0,1:36:02.10,1:36:04.30,Default,,0,0,0,,Мен бұл туралы қазір ойлап отырмын.
Dialogue: 0,1:36:04.40,1:36:05.83,Default,,0,0,0,,Өйткені қоштасу азапты
Dialogue: 0,1:36:05.93,1:36:08.50,Default,,0,0,0,,Чиппо менсіз шықса да.
Dialogue: 0,1:36:08.96,1:36:10.93,Default,,0,0,0,,Біз бұл туралы бірдеңе істей алмаймыз ба?
Dialogue: 0,1:36:11.00,1:36:12.40,Default,,0,0,0,,Хой
Dialogue: 0,1:36:12.50,1:36:13.96,Default,,0,0,0,,Эй, мен тағы келдім.
Dialogue: 0,1:36:14.43,1:36:17.90,Default,,0,0,0,,Сәлем, балалар, солай ма? Бұл заттарды өзенге тастаңыз
Dialogue: 0,1:36:18.60,1:36:20.40,Default,,0,0,0,,Өзен ластанбай ма?
Dialogue: 0,1:36:20.50,1:36:21.80,Default,,0,0,0,,(Қарғыс атқан рухтың айқайы)
Dialogue: 0,1:36:21.90,1:36:23.83,Default,,0,0,0,,(Нобита мен оның достары қуанады)
Dialogue: 0,1:36:24.10,1:36:26.16,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:36:26.30,1:36:27.93,Default,,0,0,0,,Уайымдамаңыз, ол бұзылған жоқ.
Dialogue: 0,1:36:28.00,1:36:29.60,Default,,0,0,0,,(Нобита мен оның достары қуанады)
Dialogue: 0,1:36:29.66,1:36:32.33,Default,,0,0,0,,Жерге бару!
Dialogue: 0,1:36:34.00,1:36:36.23,Default,,0,0,0,,О? Бұл Чиппоның дауысы
Dialogue: 0,1:36:36.66,1:36:39.66,Default,,0,0,0,,Қош бол! Нобита-сан!
Dialogue: 0,1:36:40.43,1:36:42.60,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:36:42.96,1:36:45.16,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:36:45.73,1:36:49.13,Default,,0,0,0,,Сау болыңыз! Қайта келіңіз!
Dialogue: 0,1:36:51.10,1:36:54.80,Default,,0,0,0,,Қош бол Чиппо, мен міндетті түрде қайтамын!
Dialogue: 0,1:36:55.00,1:37:00.06,Default,,0,0,0,,♪〜
Dialogue: 0,1:37:08.73,1:37:11.50,Default,,0,0,0,,Мен гольф алаңын салуға қарсы болғым келеді.
Dialogue: 0,1:37:11.73,1:37:12.96,Default,,0,0,0,,Ол жойылды.
Dialogue: 0,1:37:13.20,1:37:13.90,Default,,0,0,0,,Иә
Dialogue: 0,1:37:14.13,1:37:15.40,Default,,0,0,0,,Сәлем! (Нобита) Мама керемет
Dialogue: 0,1:37:15.73,1:37:18.33,Default,,0,0,0,,Сіз қайда болдыңыз? Тез бақшаға барыңыз
Dialogue: 0,1:37:18.53,1:37:19.83,Default,,0,0,0,,Маған арамшөптер беріңіз.
Dialogue: 0,1:37:20.00,1:37:21.23,Default,,0,0,0,,Иә? Болды
Dialogue: 0,1:37:21.53,1:37:22.73,Default,,0,0,0,,Табиғаттың жойылуы...
Dialogue: 0,1:37:22.86,1:37:24.70,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,1:37:25.03,1:37:26.13,Default,,0,0,0,,Сіз қазірдің өзінде жасырынсыз, мама.
Dialogue: 0,1:37:26.23,1:37:28.20,Default,,0,0,0,,Иә мен мұны істеймін, істеймін
Dialogue: 0,1:39:54.16,1:39:59.16,Default,,0,0,0,,〜♪
Dialogue: 0,1:40:00.66,1:40:06.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
