Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:12.13,0:00:15.63,Default,,0,0,0,,Мені мұндай жұмыс стилі таңдандырмайды.
Dialogue: 0,0:00:16.42,0:00:17.88,Default,,0,0,0,,(Хайда) А...
Dialogue: 0,0:00:21.63,0:00:23.04,Default,,0,0,0,,Аяқ
Dialogue: 0,0:00:23.13,0:00:25.46,Default,,0,0,0,,Тиімді жол болса⸺
Dialogue: 0,0:00:25.54,0:00:28.88,Default,,0,0,0,,Оны өзіңізге қалдырмаңыз, бөлім ішінде бөлісіңіз
Dialogue: 0,0:00:31.04,0:00:33.13,Default,,0,0,0,,(Директор Ягю) Хм... Расымен де бәрі бітті.
Dialogue: 0,0:00:33.21,0:00:35.38,Default,,0,0,0,,Қандай сиқыр қолдандың?
Dialogue: 0,0:00:35.46,0:00:38.75,Default,,0,0,0,,(Хайда) Жоқ, мен жұмыс тәртібін қалыпты түрде автоматтандырдым.
Dialogue: 0,0:00:38.84,0:00:40.42,Default,,0,0,0,,(директор Ягю) Автоматтандыру?
Dialogue: 0,0:00:41.00,0:00:44.84,Default,,0,0,0,,Мен жұмыс процедурасын қысу үшін шағын бағдарламаны орнаттым.
Dialogue: 0,0:00:44.92,0:00:47.29,Default,,0,0,0,,(Директор Ягю) Сұрыптау мен жіберуді бірден орындау мүмкін емес.
Dialogue: 0,0:00:47.38,0:00:49.21,Default,,0,0,0,,Бұл өте ыңғайлы.
Dialogue: 0,0:00:49.29,0:00:51.42,Default,,0,0,0,,(Хайда) Бұл үлкен мәселе емес.
Dialogue: 0,0:00:51.50,0:00:53.84,Default,,0,0,0,,Менің жүйем тым ескі.
Dialogue: 0,0:00:54.71,0:00:56.00,Default,,0,0,0,,Тұрақтылық туралы не деуге болады?
Dialogue: 0,0:00:56.50,0:00:58.29,Default,,0,0,0,,Не? Ах...
Dialogue: 0,0:00:58.38,0:01:01.59,Default,,0,0,0,,Мен оны үш жыл бойы қолданып келемін және еш қиындық көрмедім.
Dialogue: 0,0:01:02.17,0:01:03.54,Default,,0,0,0,,Үш жыл?
Dialogue: 0,0:01:03.63,0:01:06.29,Default,,0,0,0,,Бұрынғы менеджерді мұндай нәрсе қызықтырмаған.
Dialogue: 0,0:01:06.38,0:01:09.42,Default,,0,0,0,,Мен ұсыныс жасасам да маған ешқашан жақсы қараған емеспін.
Dialogue: 0,0:01:10.79,0:01:12.17,Default,,0,0,0,,Аяқ
Dialogue: 0,0:01:18.59,0:01:19.63,Default,,0,0,0,,(Хайда) А...
Dialogue: 0,0:01:20.88,0:01:22.67,Default,,0,0,0,,Мен оны бағалаймын.
Dialogue: 0,0:01:23.29,0:01:27.42,Default,,0,0,0,,Ұсынатын тағы бір нәрсеңіз болса, оны қазір осында көрсетіңіз.
Dialogue: 0,0:01:32.09,0:01:33.09,Default,,0,0,0,,Иә
Dialogue: 0,0:01:34.13,0:01:39.59,Default,,0,0,0,,‪♪～
Dialogue: 0,0:02:07.59,0:02:13.59,Default,,0,0,0,,‪～♪
Dialogue: 0,0:02:16.88,0:02:21.09,Default,,0,0,0,,Кешіріңіз, мен мейрамханаға бара жатыр едім, бірақ компаниямның фойесінде болдым.
Dialogue: 0,0:02:21.17,0:02:23.63,Default,,0,0,0,,(Ретсуко) Жоқ, мен көмектесе алмаймын.
Dialogue: 0,0:02:23.71,0:02:25.96,Default,,0,0,0,,Келесі жолы оның орнын толтырамын.
Dialogue: 0,0:02:26.04,0:02:28.13,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:02:28.21,0:02:29.88,Default,,0,0,0,,Одан да көп⸺
Dialogue: 0,0:02:29.96,0:02:32.71,Default,,0,0,0,,Хайда-кун керемет
Dialogue: 0,0:02:33.84,0:02:35.46,Default,,0,0,0,,Мм...
Dialogue: 0,0:02:36.29,0:02:37.92,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:38.00,0:02:42.59,Default,,0,0,0,,Бұл менің өмірімде Рецуконың мені «керемет» деп атаған екінші рет болуы мүмкін.
Dialogue: 0,0:02:42.67,0:02:44.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:44.79,0:02:47.75,Default,,0,0,0,,Президент бақытты болды емес пе?
Dialogue: 0,0:02:47.84,0:02:49.21,Default,,0,0,0,,О
Dialogue: 0,0:02:50.79,0:02:53.29,Default,,0,0,0,,Негізі мен қазір көп нәрсені ойлап жүрмін.
Dialogue: 0,0:02:53.38,0:02:54.96,Default,,0,0,0,,Не?
Dialogue: 0,0:02:55.04,0:02:57.67,Default,,0,0,0,,Үйде босқа жұмыс көп, өлесің.
Dialogue: 0,0:02:57.75,0:02:59.29,Default,,0,0,0,,Иә көп
Dialogue: 0,0:02:59.88,0:03:01.46,Default,,0,0,0,,Оны қарап шығу мүмкіндігі⸺
Dialogue: 0,0:03:01.54,0:03:03.50,Default,,0,0,0,,Менің ойымша, бұл қазір немесе ешқашан.
Dialogue: 0,0:03:04.17,0:03:05.50,Default,,0,0,0,,Қажетсіз жұмыс азайса⸺
Dialogue: 0,0:03:05.59,0:03:07.96,Default,,0,0,0,,Ол сондай-ақ бос орындарды жабуға мүмкіндік береді.
Dialogue: 0,0:03:08.04,0:03:10.96,Default,,0,0,0,,Осыны басынан бастап дұрыс орындай алсақ екен⸺
Dialogue: 0,0:03:11.04,0:03:13.96,Default,,0,0,0,,Мен бұл Кабае-сан екеніне сенімдімін...
Dialogue: 0,0:03:14.75,0:03:19.09,Default,,0,0,0,,♪ («Кюнкюн әлемі»)
Dialogue: 0,0:03:27.00,0:03:30.88,Default,,0,0,0,,♪ Қол жетпес сезімімді жасыра бердім
Dialogue: 0,0:03:35.67,0:03:39.09,Default,,0,0,0,,Эй, Хайда-кун, сен соңғы кездері бос емессің.
Dialogue: 0,0:03:39.17,0:03:42.25,Default,,0,0,0,,(Ретсуко) Иә, мен де бүгін кеңседе артық жұмыс істеп жатырмын.
Dialogue: 0,0:03:42.34,0:03:45.92,Default,,0,0,0,,Бұл саған бәрібір деген сөз емес, бейшара.
Dialogue: 0,0:03:48.04,0:03:53.25,Default,,0,0,0,,Бірақ мен Хайда-кунның өзін бір нәрсеге арнағанын бірінші рет көріп тұрмын.
Dialogue: 0,0:03:53.34,0:03:55.96,Default,,0,0,0,,Мен бірдеңе салқын деп ойладым.
Dialogue: 0,0:03:59.13,0:04:00.71,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:00.79,0:04:01.79,Default,,0,0,0,,(Ретсуко) Иә?
Dialogue: 0,0:04:01.88,0:04:03.92,Default,,0,0,0,,Хмф, сіз тыңдамайсыз.
Dialogue: 0,0:04:04.00,0:04:07.00,Default,,0,0,0,,Иә? Жарайды, тыңда.
Dialogue: 0,0:04:07.09,0:04:09.54,Default,,0,0,0,,Мен өлгенше шаршадым
Dialogue: 0,0:04:09.63,0:04:12.00,Default,,0,0,0,,Бүгін де менің басымнан бір сұмдық болды.
Dialogue: 0,0:04:12.71,0:04:14.29,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:04:15.63,0:04:18.21,Default,,0,0,0,,Қазіргі уақытта сіз толық емес жұмыс уақытында жаңа қызметкерлерді оқытуға жауаптысыз ба?
Dialogue: 0,0:04:18.29,0:04:19.34,Default,,0,0,0,,(Ретсуко) Иә.
Dialogue: 0,0:04:19.42,0:04:22.54,Default,,0,0,0,,Әлгі жаңадан келген адамды құбыжық етіп қолдануға болмайды, ол кәрі адам.
Dialogue: 0,0:04:22.63,0:04:23.84,Default,,0,0,0,,Не?
Dialogue: 0,0:04:23.92,0:04:25.88,Default,,0,0,0,,Үлкен, денелі қарт
Dialogue: 0,0:04:25.96,0:04:27.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:27.25,0:04:28.92,Default,,0,0,0,,Менің жұмысым мүлдем есімде жоқ.
Dialogue: 0,0:04:29.00,0:04:30.00,Default,,0,0,0,,(Ретсуко) Иә.
Dialogue: 0,0:04:30.09,0:04:32.88,Default,,0,0,0,,Кассадан алған кезде штрих-кодты оқитын адам, солай ма?
Dialogue: 0,0:04:32.96,0:04:36.21,Default,,0,0,0,,Тіпті бұл мені қанағаттандырмайды.
Dialogue: 0,0:04:36.71,0:04:38.09,Default,,0,0,0,,(Ретсуко) Иә.
Dialogue: 0,0:04:38.17,0:04:41.29,Default,,0,0,0,,Оның орнына абакуспен есептейсіз бе?
Dialogue: 0,0:04:41.88,0:04:43.25,Default,,0,0,0,,Абакус?
Dialogue: 0,0:04:44.00,0:04:46.92,Default,,0,0,0,,(Директор Тон) Банкрот боласыз деп үміттенемін⸺
Dialogue: 0,0:04:47.75,0:04:53.04,Default,,0,0,0,,298 иен 472 иен 128 иен 2 элементке тең 365 иен…
Dialogue: 0,0:04:53.13,0:04:54.54,Default,,0,0,0,,Сәлем, Тон мырза.
Dialogue: 0,0:04:54.63,0:04:57.79,Default,,0,0,0,,Мен сізге абакусты пайдалануды тоқтатуды айттым, себебі сіз сату деректерін жинай алмайсыз.
Dialogue: 0,0:04:58.59,0:05:00.79,Default,,0,0,0,,Жоқ, Манака-сан, бірақ...
Dialogue: 0,0:05:01.67,0:05:03.75,Default,,0,0,0,,98 иен 158 иен...
Dialogue: 0,0:05:03.84,0:05:05.63,Default,,0,0,0,,Мен саған тоқтаңдар дедім.
Dialogue: 0,0:05:07.38,0:05:09.50,Default,,0,0,0,,...Ол сондай керексіз қария.
Dialogue: 0,0:05:21.46,0:05:23.09,Default,,0,0,0,,(Ретсуко) Директор Тонг?
Dialogue: 0,0:05:24.04,0:05:25.46,Default,,0,0,0,,... дегенмен
Dialogue: 0,0:05:26.42,0:05:29.96,Default,,0,0,0,,Бірақ Менеджер Тонның ыңғайлы дүкенде жұмыс істеуі мүмкін емес.
Dialogue: 0,0:05:31.46,0:05:33.13,Default,,0,0,0,,Басқа біреуге ұқсас па?
Dialogue: 0,0:05:33.21,0:05:36.04,Default,,0,0,0,,(камера ысырмасының дыбысы)
Dialogue: 0,0:05:38.00,0:05:39.71,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:05:39.79,0:05:41.46,Default,,0,0,0,,(Фенеко) А? ше?
Dialogue: 0,0:05:41.54,0:05:44.25,Default,,0,0,0,,А...Фенеко фотоны жіберді.
Dialogue: 0,0:05:44.34,0:05:45.46,Default,,0,0,0,,Фото?
Dialogue: 0,0:05:45.54,0:05:47.84,Default,,0,0,0,,Бұл не? Сен сондай азаптысың... Ах!
Dialogue: 0,0:05:47.92,0:05:50.09,Default,,0,0,0,,Нонононо… Тотото… Тонбу…
Dialogue: 0,0:05:50.17,0:05:51.29,Default,,0,0,0,,(Қоңыраудың аяқталу дыбысы)
Dialogue: 0,0:05:51.79,0:05:54.88,Default,,0,0,0,,Әрине, бұл директор Тонг.
Dialogue: 0,0:06:01.29,0:06:02.67,Default,,0,0,0,,Га
Dialogue: 0,0:06:02.75,0:06:03.92,Default,,0,0,0,,(Тонмусуме 1) Эй
Dialogue: 0,0:06:04.00,0:06:05.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:18.46,0:06:20.71,Default,,0,0,0,,(Тон Мусуме 2) Сен (Ретсуко) Фу
Dialogue: 0,0:06:28.21,0:06:29.71,Default,,0,0,0,,(Тон қыздар) Маған бірнеше кеңес беріңіз.
Dialogue: 0,0:06:29.79,0:06:31.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:35.25,0:06:36.42,Default,,0,0,0,,яғни⸺
Dialogue: 0,0:06:37.42,0:06:40.46,Default,,0,0,0,,Бұл менеджер Тонг компанияға енді келмейтінін білдіре ме?
Dialogue: 0,0:06:41.54,0:06:42.67,Default,,0,0,0,,Иә
Dialogue: 0,0:06:43.71,0:06:46.04,Default,,0,0,0,,Әкем соңғы кездері біртүрлі болып жүр⸺
Dialogue: 0,0:06:46.13,0:06:49.00,Default,,0,0,0,,Екеуміз оның соңынан жасырын жүрдік.
Dialogue: 0,0:06:50.29,0:06:54.21,Default,,0,0,0,,Содан мен сол дүкенде жұмыс істейтінмін...
Dialogue: 0,0:06:55.42,0:06:57.71,Default,,0,0,0,,Сенің анаң бұл туралы біледі ме?
Dialogue: 0,0:06:57.79,0:07:00.00,Default,,0,0,0,,Мүмкін мен білмеймін.
Dialogue: 0,0:07:00.09,0:07:03.42,Default,,0,0,0,,Мен әдетте үйден таңертең шығып, түнде қайтамын.
Dialogue: 0,0:07:04.92,0:07:09.29,Default,,0,0,0,,Әке, сіз компаниядан қуылдыңыз ба?
Dialogue: 0,0:07:10.21,0:07:14.54,Default,,0,0,0,,Бізге айта алмағандықтан жалғыз қиналып жүрсің бе?
Dialogue: 0,0:07:15.59,0:07:17.13,Default,,0,0,0,,Рецу-чан...
Dialogue: 0,0:07:17.79,0:07:20.50,Default,,0,0,0,,(Тон қыздар) Өтінемін, әке туралы бірдеңе беріңізші.
Dialogue: 0,0:07:20.96,0:07:25.38,Default,,0,0,0,,(жылау)
Dialogue: 0,0:07:29.17,0:07:31.38,Default,,0,0,0,,(Фенеко) Сол жаста қайтадан жұмысқа тұрғанда⸺
Dialogue: 0,0:07:31.46,0:07:33.54,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:07:33.63,0:07:35.17,Default,,0,0,0,,Иә
Dialogue: 0,0:07:35.79,0:07:38.17,Default,,0,0,0,,Үйіңізге несие бар дедіңіз.
Dialogue: 0,0:07:38.25,0:07:39.63,Default,,0,0,0,,Иә
Dialogue: 0,0:07:40.34,0:07:43.38,Default,,0,0,0,,Менің екі қызым келесі жылы қабылдау емтихандарын тапсырады...
Dialogue: 0,0:07:43.92,0:07:45.17,Default,,0,0,0,,Иә
Dialogue: 0,0:07:48.96,0:07:50.54,Default,,0,0,0,,Міне
Dialogue: 0,0:07:51.09,0:07:54.46,Default,,0,0,0,,Өйткені біз президентке директор Тонг туралы жаман сөздер айтып жүрдік.
Dialogue: 0,0:07:54.54,0:07:56.29,Default,,0,0,0,,Бұл... дегенді білдірмейді?
Dialogue: 0,0:07:57.17,0:07:58.63,Default,,0,0,0,,(Ретсуко) Иә.
Dialogue: 0,0:07:58.71,0:08:01.04,Default,,0,0,0,,(Цубоне) Енді араласпа.
Dialogue: 0,0:08:01.13,0:08:03.92,Default,,0,0,0,,Мен ескі әдіспен жақсымын.
Dialogue: 0,0:08:04.00,0:08:06.38,Default,,0,0,0,,(Хайда) Олай айтпа, пайдаланып көр.
Dialogue: 0,0:08:06.46,0:08:08.84,Default,,0,0,0,,Мен де егде жастағы адамдардан пікір алғым келеді...
Dialogue: 0,0:08:08.92,0:08:12.88,Default,,0,0,0,,Менің қартайғаным өкінішті. Маған керек емес.
Dialogue: 0,0:08:12.96,0:08:14.04,Default,,0,0,0,,Вирус қорқынышты
Dialogue: 0,0:08:14.13,0:08:17.34,Default,,0,0,0,,Бұл вирус немесе басқа нәрсе емес.
Dialogue: 0,0:08:17.42,0:08:20.54,Default,,0,0,0,,(Огами) Цубоне мырза, бұл өте ыңғайлы.
Dialogue: 0,0:08:20.63,0:08:22.42,Default,,0,0,0,,Хайда мырза, бұл өте жақсы болды.
Dialogue: 0,0:08:22.50,0:08:23.79,Default,,0,0,0,,Директор Тонг сонда болған кезде⸺
Dialogue: 0,0:08:23.88,0:08:26.71,Default,,0,0,0,,Мен мұндай нәрсені мүлдем істей алмадым.
Dialogue: 0,0:08:26.79,0:08:29.13,Default,,0,0,0,,Хаха, бірдеңе ұсынсаң да⸺
Dialogue: 0,0:08:29.21,0:08:32.00,Default,,0,0,0,,Түсіндіруде катакананы қолдансаңыз, ол қабылданбайды.
Dialogue: 0,0:08:32.09,0:08:36.00,Default,,0,0,0,,(Огами) Хахахахаха Катакана Ябайсуне
Dialogue: 0,0:08:36.50,0:08:40.75,Default,,0,0,0,,Цубоне мырза, біздің жүйе тым ескі.
Dialogue: 0,0:08:40.84,0:08:42.79,Default,,0,0,0,,Міндеттердің бөлінуі де анық емес.
Dialogue: 0,0:08:42.88,0:08:44.63,Default,,0,0,0,,Журнал жазбаларын әлі де қолмен енгізіп жатырсыз ба?
Dialogue: 0,0:08:44.92,0:08:46.29,Default,,0,0,0,,Біз туралы...
Dialogue: 0,0:08:47.17,0:08:48.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:48.71,0:08:50.67,Default,,0,0,0,,Бұл ескі және нашар болды.
Dialogue: 0,0:08:53.54,0:08:55.79,Default,,0,0,0,,(Огами) Иә? Не?
Dialogue: 0,0:08:56.50,0:08:57.96,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:09:02.84,0:09:04.50,Default,,0,0,0,,(Ретсуко) Ах... (Цубоне) Сен менің жолымдасың, хун.
Dialogue: 0,0:09:05.79,0:09:07.13,Default,,0,0,0,,(Ретсуко) Иә?
Dialogue: 0,0:09:09.50,0:09:11.79,Default,,0,0,0,,(қайнаған судың дыбысы)
Dialogue: 0,0:09:18.79,0:09:20.38,Default,,0,0,0,,Цубоне мырза?
Dialogue: 0,0:09:21.67,0:09:24.79,Default,,0,0,0,,Шулы екен, мені жайына қалдыршы.
Dialogue: 0,0:09:28.34,0:09:30.04,Default,,0,0,0,,Сіз де⸺
Dialogue: 0,0:09:30.13,0:09:33.34,Default,,0,0,0,,Тон-кун кеткеннен кейін өзіңізді сергек сезінесіз, солай ма?
Dialogue: 0,0:09:36.92,0:09:40.96,Default,,0,0,0,,(Ретсуко) Сіз директор Тон туралы бірдеңе білесіз бе?
Dialogue: 0,0:09:48.00,0:09:49.92,Default,,0,0,0,,(Пернетақтаның соғу дыбысы)
Dialogue: 0,0:09:50.50,0:09:53.42,Default,,0,0,0,,(Ретсуко) Директор Тонг: Бұл шын мәнінде көтерілу туралы емес сияқты.
Dialogue: 0,0:09:53.50,0:09:56.92,Default,,0,0,0,,Тарату орталығындағы жабдық қоймасы кеңсеге айналды.
Dialogue: 0,0:09:57.00,0:09:58.96,Default,,0,0,0,,Оның жұмысы мүлдем болған жоқ.
Dialogue: 0,0:10:00.59,0:10:02.13,Default,,0,0,0,,(Хайда) Түсіндім.
Dialogue: 0,0:10:02.21,0:10:04.96,Default,,0,0,0,,Шығару бөлмесі деп нені айтады?
Dialogue: 0,0:10:05.04,0:10:08.54,Default,,0,0,0,,Мен тасымалдаушы бөлмесі күдікті деп ойладым.
Dialogue: 0,0:10:09.96,0:10:14.42,Default,,0,0,0,,Цубоне мырза, менеджер мені үнсіз қалдырды, сондықтан мен бәрін өзіме жасырдым.
Dialogue: 0,0:10:16.92,0:10:20.42,Default,,0,0,0,,Менеджер Тонгтың қыздарын аядым.
Dialogue: 0,0:10:21.96,0:10:23.54,Default,,0,0,0,,Дүкенде жыладым.
Dialogue: 0,0:10:23.63,0:10:26.09,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:10:27.88,0:10:30.13,Default,,0,0,0,,Бұған көмектесу мүмкін емес.
Dialogue: 0,0:10:33.04,0:10:34.54,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:34.63,0:10:37.75,Default,,0,0,0,,Жұмыстан кетуге шешім қабылдаған адам директор Тонгтың өзі болды.
Dialogue: 0,0:10:38.38,0:10:39.92,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:10:40.63,0:10:44.04,Default,,0,0,0,,Бұл мен оны өзім таңдадым дегенді білдіре ме?
Dialogue: 0,0:10:44.13,0:10:47.34,Default,,0,0,0,,Бірақ менде бас тартпау мүмкіндігі болды.
Dialogue: 0,0:10:47.42,0:10:49.84,Default,,0,0,0,,Бұл Рецуконың алаңдауы керек нәрсе емес.
Dialogue: 0,0:10:54.00,0:10:55.63,Default,,0,0,0,,Мен
Dialogue: 0,0:10:56.29,0:11:00.13,Default,,0,0,0,,Бұрын Фенеко екеумізді президент той бергенде...
Dialogue: 0,0:11:00.21,0:11:02.13,Default,,0,0,0,,(Хаида) Нууааа!
Dialogue: 0,0:11:02.63,0:11:03.96,Default,,0,0,0,,Күте тұрыңыз...
Dialogue: 0,0:11:05.25,0:11:07.25,Default,,0,0,0,,Не? сурет? Неліктен қуат өшірілген?
Dialogue: 0,0:11:07.34,0:11:09.17,Default,,0,0,0,,Мен сақтық көшірме жасадым ба?
Dialogue: 0,0:11:09.79,0:11:10.88,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:11:10.96,0:11:13.46,Default,,0,0,0,,(Хайда) Бір минут күте тұрыңыз.
Dialogue: 0,0:11:13.54,0:11:16.34,Default,,0,0,0,,Цк, о, деректер жоғалып кетті.
Dialogue: 0,0:11:16.42,0:11:19.00,Default,,0,0,0,,Қарғыс атқыр, мен уақытымды босқа өткіздім.
Dialogue: 0,0:11:19.46,0:11:21.59,Default,,0,0,0,,Маған үзіліс беріңізші...
Dialogue: 0,0:11:37.54,0:11:40.46,Default,,0,0,0,,Жарайды, қайтару аяқталды
Dialogue: 0,0:11:41.09,0:11:45.46,Default,,0,0,0,,Аа... Қап, Сақтау Сақтау және
Dialogue: 0,0:11:47.92,0:11:49.42,Default,,0,0,0,,Сіз қосымша уақыттан кеш жұмыс істейсіз бе?
Dialogue: 0,0:11:49.50,0:11:51.46,Default,,0,0,0,,Ха...
Dialogue: 0,0:11:54.00,0:11:55.88,Default,,0,0,0,,Маған әсер еткен жоқ.
Dialogue: 0,0:12:01.34,0:12:03.59,Default,,0,0,0,,Жұмыспен айналысқан жақсы⸺
Dialogue: 0,0:12:03.67,0:12:07.00,Default,,0,0,0,,Тамырларды тым көп толтыру да жақсы емес.
Dialogue: 0,0:12:07.92,0:12:09.71,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:12:10.67,0:12:12.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:13.67,0:12:18.00,Default,,0,0,0,,Шындығында, мен жұмысты бірінші рет ләззат алуым.
Dialogue: 0,0:12:19.09,0:12:21.46,Default,,0,0,0,,Президент бекіткен
Dialogue: 0,0:12:21.54,0:12:25.13,Default,,0,0,0,,Иә? Егер сізде де бірдеңе бар ма деп ойласаңыз⸺
Dialogue: 0,0:12:25.21,0:12:28.59,Default,,0,0,0,,Осындай бірдеңе мені қатты қыздырады...
Dialogue: 0,0:12:28.67,0:12:29.67,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:38.29,0:12:41.09,Default,,0,0,0,,Директор болып тағайындалғанда⸺
Dialogue: 0,0:12:41.17,0:12:45.50,Default,,0,0,0,,Мені компаниядағы өте ескі атмосфера таң қалдырды.
Dialogue: 0,0:12:46.17,0:12:48.04,Default,,0,0,0,,«Шоу дәуірі ме?» деп таң қалдым.
Dialogue: 0,0:12:48.13,0:12:49.67,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:12:50.71,0:12:52.92,Default,,0,0,0,,Бірақ мен керісінше ойладым.
Dialogue: 0,0:12:53.00,0:12:54.84,Default,,0,0,0,,Бұл компанияны қайта құрудың кілті⸺
Dialogue: 0,0:12:54.92,0:12:58.50,Default,,0,0,0,,Мүмкін бұл маған берілген тапсырма шығар
Dialogue: 0,0:12:59.84,0:13:03.29,Default,,0,0,0,,Енді мен президент болғандықтан, менде мұны істеу құқығы бар.
Dialogue: 0,0:13:03.38,0:13:05.13,Default,,0,0,0,,Қуат?
Dialogue: 0,0:13:05.21,0:13:08.79,Default,,0,0,0,,Бұл кемеге отырғызылатын персоналды таңдау құқығы.
Dialogue: 0,0:13:08.88,0:13:13.46,Default,,0,0,0,,Өкінішке орай, менеджер Ягюдің жаңа есеп бөлімін құруға құқығы жоқ.
Dialogue: 0,0:13:14.63,0:13:16.84,Default,,0,0,0,,Жұмысқа кім қолайлы?
Dialogue: 0,0:13:16.92,0:13:21.17,Default,,0,0,0,,Менің ойымша, бұл сен сияқты жас жігіт.
Dialogue: 0,0:13:24.92,0:13:26.84,Default,,0,0,0,,(Директор Гори) Сондықтан⸺
Dialogue: 0,0:13:26.92,0:13:29.63,Default,,0,0,0,,Менеджер Тонгтың өзі жұмыстан кетуге шешім қабылдаған жоқ па?
Dialogue: 0,0:13:29.71,0:13:31.00,Default,,0,0,0,,Иә
Dialogue: 0,0:13:31.09,0:13:33.42,Default,,0,0,0,,Сізде тастамау мүмкіндігі болды, солай ма?
Dialogue: 0,0:13:34.09,0:13:35.09,Default,,0,0,0,,‪
Dialogue: 0,0:13:35.75,0:13:39.04,Default,,0,0,0,,Егер солай болса, бұл Рецуконы алаңдататын нәрсе емес.
Dialogue: 0,0:13:41.09,0:13:42.54,Default,,0,0,0,,Бірақ мен үшін директор Тонг⸺
Dialogue: 0,0:13:42.63,0:13:44.50,Default,,0,0,0,,Мені шығарып салу бөлмесіне қойды деп ойлаған кезде...
Dialogue: 0,0:13:45.13,0:13:46.75,Default,,0,0,0,,Тым көп ойлау
Dialogue: 0,0:13:46.84,0:13:49.71,Default,,0,0,0,,Мен президент пен директор Тонның арасында бірдеңе болғанына сенімдімін бе?
Dialogue: 0,0:13:49.79,0:13:53.67,Default,,0,0,0,,Бұл екеуі сөзсіз жараспайтын сияқты, эй Вашими.
Dialogue: 0,0:13:55.63,0:13:56.92,Default,,0,0,0,,(Вашими) Жүр.
Dialogue: 0,0:14:01.21,0:14:03.46,Default,,0,0,0,,Мен Рецуконың сезімін түсінемін.
Dialogue: 0,0:14:05.54,0:14:08.42,Default,,0,0,0,,Бірақ дәл қазір біздің компанияға қажет нәрсе⸺
Dialogue: 0,0:14:08.50,0:14:11.46,Default,,0,0,0,,Бұл жақсы шешім емес, дұрыс шешім деп ойлаймын.
Dialogue: 0,0:14:12.63,0:14:14.00,Default,,0,0,0,,Иә
Dialogue: 0,0:14:15.09,0:14:19.17,Default,,0,0,0,,(Вашими) Нәтижесін көрмейінше, мен ненің дұрыс екенін білмеймін.
Dialogue: 0,0:14:19.25,0:14:21.13,Default,,0,0,0,,Осыны айта аламын
Dialogue: 0,0:14:22.00,0:14:23.46,Default,,0,0,0,,Қалай жасасаңыз да⸺
Dialogue: 0,0:14:23.54,0:14:26.75,Default,,0,0,0,,Бұл компанияның болашағын президент Химуродан артық кім ойлайды?
Dialogue: 0,0:14:27.34,0:14:29.59,Default,,0,0,0,,Басқа ешкім жоқ
Dialogue: 0,0:14:42.17,0:14:47.79,Default,,0,0,0,,(Бухгалтерия бөлімінің барлық мүшелері) Иә! ?
Dialogue: 0,0:14:50.42,0:14:52.63,Default,,0,0,0,,(Анай) Хайда-сенпай есеп меңгерушісі ме?
Dialogue: 0,0:14:52.71,0:14:54.42,Default,,0,0,0,,(Комия) Мені жалғыз қалдырыңыз ба?
Dialogue: 0,0:14:54.50,0:14:56.38,Default,,0,0,0,,Не? Сонда директор Ягю ше?
Dialogue: 0,0:14:56.46,0:14:57.92,Default,,0,0,0,,(Огами) Ой... ол дем алмай жатыр.
Dialogue: 0,0:14:58.00,0:14:59.29,Default,,0,0,0,,-ге... Хехе
Dialogue: 0,0:14:59.38,0:15:00.71,Default,,0,0,0,,(Фенеко) Бұл не?
Dialogue: 0,0:15:00.79,0:15:02.88,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:10.54,0:15:14.29,Default,,0,0,0,,Енді Хайда-кунды менеджер қызметіне көтерілуімен құттықтаймыз⸺
Dialogue: 0,0:15:14.38,0:15:15.84,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:15:15.92,0:15:17.38,Default,,0,0,0,,(үшін) Сәлем!
Dialogue: 0,0:15:17.46,0:15:19.71,Default,,0,0,0,,Жоқ, рахмет, рахмет, рахмет...
Dialogue: 0,0:15:19.79,0:15:21.38,Default,,0,0,0,,Сәлем, сәлем, сәлем, сәлем…
Dialogue: 0,0:15:21.46,0:15:23.50,Default,,0,0,0,,Аха аха аха аха
Dialogue: 0,0:15:23.59,0:15:26.92,Default,,0,0,0,,(Огами) Хайда-сенпай тым қауіпті, иә? Анаи
Dialogue: 0,0:15:27.63,0:15:30.09,Default,,0,0,0,,Сен президентке құйрығыңды бұлғап тұрсың ғой?
Dialogue: 0,0:15:31.38,0:15:34.54,Default,,0,0,0,,(Какуда) Директор, мен сіздің кезегіңізді алғым келеді.
Dialogue: 0,0:15:34.63,0:15:36.92,Default,,0,0,0,,Рахмет, рахмет
Dialogue: 0,0:15:39.75,0:15:41.84,Default,,0,0,0,,Режиссер: Керемет
Dialogue: 0,0:15:43.46,0:15:44.42,Default,,0,0,0,,(Огами) Жарайды ма?
Dialogue: 0,0:15:44.50,0:15:46.79,Default,,0,0,0,,Рецуко-сенпайдың болмағаны жақсы⸺
Dialogue: 0,0:15:46.88,0:15:48.96,Default,,0,0,0,,Цунода басынан бастап аңшы режимінде.
Dialogue: 0,0:15:49.79,0:15:53.13,Default,,0,0,0,,Ақшаның иісін жақсы көретін қыз ғой.
Dialogue: 0,0:15:54.54,0:15:56.59,Default,,0,0,0,,(Огами) Рецуко-сенпай, бірдеңе болды ма?
Dialogue: 0,0:15:56.67,0:15:58.92,Default,,0,0,0,,Хмм... Мен білмеймін.
Dialogue: 0,0:16:00.63,0:16:02.54,Default,,0,0,0,,Ол бірдеңе істеу керек екенін айтты.
Dialogue: 0,0:16:10.92,0:16:12.59,Default,,0,0,0,,(Бала) Мен осында күтемін.
Dialogue: 0,0:16:12.67,0:16:14.29,Default,,0,0,0,,(Ретсуко) Рахмет
Dialogue: 0,0:16:24.25,0:16:27.00,Default,,0,0,0,,(Тадано) Көптен бері көрмегелі, Рецу-чан
Dialogue: 0,0:16:27.79,0:16:33.79,Default,,0,0,0,,♪～
Dialogue: 0,0:16:51.71,0:16:57.71,Default,,0,0,0,,～♪
