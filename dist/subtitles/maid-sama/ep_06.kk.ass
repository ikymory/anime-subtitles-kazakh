Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.57,0:03:00.57,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:01.95,0:03:11.72,Default,,0000,0000,0000,,
Dialogue: 0,0:04:13.84,0:04:16.87,Default,,0000,0000,0000,,〈(Мисаки) Бір күні...〉
Dialogue: 0,0:04:16.87,0:04:18.72,Default,,0000,0000,0000,,《(5 Инуяма ағайынды) Өтінемін! 》
Dialogue: 0,0:04:18.72,0:04:21.92,Default,,0000,0000,0000,,<Бұл кенеттен>
Dialogue: 0,0:04:21.92,0:04:24.92,Default,,0000,0000,0000,,《(5 ағайынды) Біздің қожайын болыңыз》
Dialogue: 0,0:04:26.80,0:04:28.80,Default,,0000,0000,0000,,<Шәкірт тәрбиеленді>
Dialogue: 0,0:04:29.50,0:04:31.50,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:43.80,0:04:46.66,Default,,0000,0000,0000,,Бұл не? (Куросаки) Алтын балық саңырауқұлағы?
Dialogue: 0,0:04:46.66,0:04:48.36,Default,,0000,0000,0000,,Сол балғындық бірінші курс студентіндей.
Dialogue: 0,0:04:48.36,0:04:52.23,Default,,0000,0000,0000,,Мектептен үйге қожайыныммен бірге жаяу бару – үлкен мәртебе!
Dialogue: 0,0:04:52.23,0:04:57.77,Default,,0000,0000,0000,,Біз, бес ағайынды Инуяма, Сейка орта мектебіне түскенімізге қуаныштымыз.
Dialogue: 0,0:04:57.77,0:05:00.80,Default,,0000,0000,0000,,Мен Аюзава Джукуны жасағаныма өте қуаныштымын!
Dialogue: 0,0:05:00.80,0:05:04.84,Default,,0000,0000,0000,,Қызықты орта мектеп өмірі (Горо) енді сіздің қолыңызда!
Dialogue: 0,0:05:04.84,0:05:07.87,Default,,0000,0000,0000,,Сол Аюзава Джукудан бас тарту керек емес пе?
Dialogue: 0,0:05:07.87,0:05:09.89,Default,,0000,0000,0000,,Бұл өте ұят.
Dialogue: 0,0:05:09.89,0:05:11.09,Default,,0000,0000,0000,,Бірақ ұстаз, сізде бұдан жақсы идея бар ма? ?
Dialogue: 0,0:05:11.09,0:05:14.62,Default,,0000,0000,0000,,Мен Аюзава Кай немесе Аюзава клубында өзімді жайлы сезінбеймін.
Dialogue: 0,0:05:14.62,0:05:17.81,Default,,0000,0000,0000,,Барлығы келісетін жалғыз нәрсе.
Dialogue: 0,0:05:17.81,0:05:21.85,Default,,0000,0000,0000,,Ыстық, қалағаныңды істе, иә...
Dialogue: 0,0:05:21.85,0:05:23.87,Default,,0000,0000,0000,,Рахмет! Апыр-ай!
Dialogue: 0,0:05:23.87,0:05:27.91,Default,,0000,0000,0000,,Бірақ сендер соншалықты қызықсыңдар, мен сендерге сабақ беруімді сұрайды деп ойламаппын.
Dialogue: 0,0:05:27.91,0:05:30.78,Default,,0000,0000,0000,,Сіз не айтып тұрсыз? Біз көптен бері төрағаның өмір салтын қадағалап келеміз.
Dialogue: 0,0:05:30.78,0:05:34.81,Default,,0000,0000,0000,,Менің өмір сүру тәсілім маған қатты әсер етті...
Dialogue: 0,0:05:34.81,0:05:38.86,Default,,0000,0000,0000,,（）
Dialogue: 0,0:05:38.86,0:05:40.54,Default,,0000,0000,0000,,（）
Dialogue: 0,0:05:40.54,0:05:43.74,Default,,0000,0000,0000,,（）
Dialogue: 0,0:05:43.74,0:05:46.93,Default,,0000,0000,0000,,（）
Dialogue: 0,0:05:46.93,0:05:49.46,Default,,0000,0000,0000,,Барлық студенттерді басқару Біліктілікті сақтау
Dialogue: 0,0:05:49.46,0:05:51.82,Default,,0000,0000,0000,,Студенттік кеңес төрағасының нағыз үлгісі!
Dialogue: 0,0:05:51.82,0:05:56.70,Default,,0000,0000,0000,,Не, ол сондай үлкен мәселе...
Dialogue: 0,0:05:56.70,0:06:01.75,Default,,0000,0000,0000,,（５） …
Dialogue: 0,0:06:01.75,0:06:04.78,Default,,0000,0000,0000,,Жоқ Шебер – өмірдің мақсаты.
Dialogue: 0,0:06:04.78,0:06:06.30,Default,,0000,0000,0000,,Біз де сондай жақсы адамдар болғымыз келеді!
Dialogue: 0,0:06:06.30,0:06:10.67,Default,,0000,0000,0000,,Шебер біздің жолбасшымыз, біз құрметтейтін нөмір бірінші тұлғамыз
Dialogue: 0,0:06:10.67,0:06:12.67,Default,,0000,0000,0000,,Мисаки Аюзава Банзай!
Dialogue: 0,0:06:17.74,0:06:21.95,Default,,0000,0000,0000,,Менің қожайыным мектепке жаяу барады деп естідім.
Dialogue: 0,0:06:21.95,0:06:24.98,Default,,0000,0000,0000,,Неліктен пойыз? Мен бұл туралы қауесет арқылы естідім →
Dialogue: 0,0:06:24.98,0:06:27.98,Default,,0000,0000,0000,,Сізде толық емес жұмыс күні бар, солай ма?
Dialogue: 0,0:06:28.85,0:06:32.73,Default,,0000,0000,0000,,Отбасын қаржыландыруға көмектесу үшін, тіпті бірнеше сағат болса да, үйге бару.
Dialogue: 0,0:06:32.73,0:06:37.94,Default,,0000,0000,0000,,О, сіз күткендей, ұстаз, сіздің осындай тығыз жұмыс кестесін басқаратыныңызға сене алар емеспін.
Dialogue: 0,0:06:37.94,0:06:39.46,Default,,0000,0000,0000,,Біз де сізден үйренгіміз келеді.
Dialogue: 0,0:06:39.46,0:06:41.46,Default,,0000,0000,0000,,Сізге еріп жүруге рұқсат етіңіз!
Dialogue: 0,0:06:43.51,0:06:46.86,Default,,0000,0000,0000,,Бұл тамаша жұмыс болуы керек.
Dialogue: 0,0:06:46.86,0:06:51.75,Default,,0000,0000,0000,,Жоқ, бұл кәдімгі толық емес жұмыс, сондықтан оның еш пайдасы болмайды.
Dialogue: 0,0:06:51.75,0:06:55.79,Default,,0000,0000,0000,,Жоқ, тек оның қандай жұмыс екенін білу – үйрену тәжірибесі.
Dialogue: 0,0:06:55.79,0:06:57.81,Default,,0000,0000,0000,,Сіз үйренесіз!
Dialogue: 0,0:06:57.81,0:07:01.52,Default,,0000,0000,0000,,Бүгін барлығы үйге қайтуы керек. Сіз бірден үйге барып, үй тапсырмасын орындауыңыз керек.
Dialogue: 0,0:07:01.52,0:07:05.72,Default,,0000,0000,0000,,Төраға жоқ деп жауап берді. Үйге тыныш жүр.
Dialogue: 0,0:07:05.72,0:07:09.26,Default,,0000,0000,0000,,Түсіндім, түсіндім, ұстаз.
Dialogue: 0,0:07:09.26,0:07:12.96,Default,,0000,0000,0000,,Қош келдіңіз (4 адам) Қош келдіңіз
Dialogue: 0,0:07:12.96,0:07:15.65,Default,,0000,0000,0000,,Хмм 〈Рахмет...〉
Dialogue: 0,0:07:15.65,0:07:17.67,Default,,0000,0000,0000,,Мектепте кездескенше.
Dialogue: 0,0:07:17.67,0:07:19.86,Default,,0000,0000,0000,,Біз сенімен бірге боламыз.
Dialogue: 0,0:07:19.86,0:07:24.91,Default,,0000,0000,0000,,Біз ұпайларды жинақтауымыз керек. Бұл біздің миссиямыз, солай ма?
Dialogue: 0,0:07:24.91,0:07:26.77,Default,,0000,0000,0000,,Сәлем! (3 ақымақ) Иә?
Dialogue: 0,0:07:26.77,0:07:28.79,Default,,0000,0000,0000,,Сонда біз де солай етеміз! Қалай болғанда да!
Dialogue: 0,0:07:28.79,0:07:31.31,Default,,0000,0000,0000,,Демек, сіз жоқ дейсіз!
Dialogue: 0,0:07:31.31,0:07:33.83,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:33.83,0:07:35.83,Default,,0000,0000,0000,,Күте тұрыңыз, ұстаз~
Dialogue: 0,0:07:43.77,0:07:46.80,Default,,0000,0000,0000,,Ұстаз!
Dialogue: 0,0:07:46.80,0:07:48.82,Default,,0000,0000,0000,,〈Мені өзіңмен бірге алып кетпе! 〉
Dialogue: 0,0:07:48.82,0:07:50.84,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:07:50.84,0:07:53.84,Default,,0000,0000,0000,,Мастер шебер~!
Dialogue: 0,0:07:57.74,0:07:59.76,Default,,0000,0000,0000,,Сіз тег ойнайсыз ба?
Dialogue: 0,0:07:59.76,0:08:01.78,Default,,0000,0000,0000,,（）
Dialogue: 0,0:08:01.78,0:08:03.80,Default,,0000,0000,0000,,Ұстаз~! еш жерде
Dialogue: 0,0:08:03.80,0:08:06.83,Default,,0000,0000,0000,,Қожайыным күткендей, мен оңай таң қалдым.
Dialogue: 0,0:08:06.83,0:08:08.85,Default,,0000,0000,0000,,Мен сиқыр жасаймын.
Dialogue: 0,0:08:08.85,0:08:11.88,Default,,0000,0000,0000,,Сіз қашан сонша танымал болдыңыз?
Dialogue: 0,0:08:11.88,0:08:15.42,Default,,0000,0000,0000,,Сіз маған еліктегіңіз келетін сияқты...
Dialogue: 0,0:08:15.42,0:08:18.42,Default,,0000,0000,0000,,Сіз күткендей жылдамсыз. Күткендей.
Dialogue: 0,0:08:19.63,0:08:23.63,Default,,0000,0000,0000,,Сіз мұны маған көрсете алмайтыныңызға сенімдісіз бе?
Dialogue: 0,0:08:26.86,0:08:29.89,Default,,0000,0000,0000,,Ақыры мен ұпай жинадым.
Dialogue: 0,0:08:29.89,0:08:32.92,Default,,0000,0000,0000,,Ха! ? Сіз қазірдің өзінде соншалықты кереметсіз бе?
Dialogue: 0,0:08:32.92,0:08:35.29,Default,,0000,0000,0000,,Сіз ол жерге тым жиі барасыз! Сондықтан мен бүгін ойынды сынап көремін
Dialogue: 0,0:08:35.29,0:08:38.82,Default,,0000,0000,0000,,Менімен суретке түс
Dialogue: 0,0:08:38.82,0:08:40.82,Default,,0000,0000,0000,,Күрсін...
Dialogue: 0,0:08:45.72,0:08:48.75,Default,,0000,0000,0000,,Жоқ, Миса-чан, сен тым қаталсың!
Dialogue: 0,0:08:48.75,0:08:53.97,Default,,0000,0000,0000,,Әдеттегідей табиғи түрде күлейік. Е, а, жоқ...
Dialogue: 0,0:08:53.97,0:08:56.67,Default,,0000,0000,0000,,Ұстаз, сіз басқа суретке түсіре аласыз.
Dialogue: 0,0:08:56.67,0:08:59.20,Default,,0000,0000,0000,,Сізге қалай ұнайды? Бұл жақсы
Dialogue: 0,0:08:59.20,0:09:02.73,Default,,0000,0000,0000,,Әдеттегідей Миса Чан ең жақсы.
Dialogue: 0,0:09:02.73,0:09:04.75,Default,,0000,0000,0000,,Күрсін!
Dialogue: 0,0:09:04.75,0:09:07.78,Default,,0000,0000,0000,,Миса-чан, сенің қожайын сені қатты жақсы көреді.
Dialogue: 0,0:09:07.78,0:09:10.80,Default,,0000,0000,0000,,Мұның бәрі Мэйд Миори туралы!
Dialogue: 0,0:09:10.80,0:09:12.82,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:09:12.82,0:09:14.82,Default,,0000,0000,0000,,Не болды, Миса Чан?
Dialogue: 0,0:09:22.76,0:09:25.96,Default,,0000,0000,0000,,Қайырлы таң ұстаз!
Dialogue: 0,0:09:25.96,0:09:27.98,Default,,0000,0000,0000,,Қайырлы таң...
Dialogue: 0,0:09:27.98,0:09:31.98,Default,,0000,0000,0000,,Бүгінгі қолдауыңыз үшін рахмет!
Dialogue: 0,0:09:37.74,0:09:41.45,Default,,0000,0000,0000,,Ұстаз! Маған бірдеңе айтыңызшы
Dialogue: 0,0:09:41.45,0:09:44.81,Default,,0000,0000,0000,,Кешіріңіз, менде қызық ештеңе жоқ.
Dialogue: 0,0:09:44.81,0:09:47.67,Default,,0000,0000,0000,,Сонда оған көмектесу мүмкін емес. Еш нәрсе істей алмайсың.
Dialogue: 0,0:09:47.67,0:09:49.67,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:09:50.87,0:09:52.87,Default,,0000,0000,0000,,Күрсін!
Dialogue: 0,0:09:53.90,0:09:55.75,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:09:55.75,0:09:57.75,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:10:05.18,0:10:08.21,Default,,0000,0000,0000,,Норибен негізіне арналған гарнирлер: Тамагояки және Винер
Dialogue: 0,0:10:08.21,0:10:10.21,Default,,0000,0000,0000,,Ертең менде қожайыным сияқты бенто болады!
Dialogue: 0,0:10:12.75,0:10:14.78,Default,,0000,0000,0000,,Ха~ Тамақ ішпейсің бе?
Dialogue: 0,0:10:14.78,0:10:17.81,Default,,0000,0000,0000,,Амансыз ба, мырза?
Dialogue: 0,0:10:17.81,0:10:19.66,Default,,0000,0000,0000,,Күрсін!
Dialogue: 0,0:10:19.66,0:10:22.19,Default,,0000,0000,0000,,- (Қосуги) Төраға, бұл мектеп газетіндегі мақала...
Dialogue: 0,0:10:22.19,0:10:24.04,Default,,0000,0000,0000,,Жүріңдер, көрсетіңдерші.
Dialogue: 0,0:10:24.04,0:10:27.07,Default,,0000,0000,0000,,Төраға, тазалық жұмыстарын жүргізуге бөлінген аумақ...
Dialogue: 0,0:10:27.07,0:10:29.92,Default,,0000,0000,0000,,А, мен бүгін шешемін.
Dialogue: 0,0:10:29.92,0:10:31.95,Default,,0000,0000,0000,,Төраға, ұсыныс жолағында осындай пікір бар.
Dialogue: 0,0:10:31.95,0:10:34.95,Default,,0000,0000,0000,,Жарайды, ертең жиналыста...
Dialogue: 0,0:10:39.69,0:10:43.06,Default,,0000,0000,0000,,Бұл Аюзава Джуку деген қауесет... Олар сондай ынталы.
Dialogue: 0,0:10:43.06,0:10:46.09,Default,,0000,0000,0000,,Балалар! Сіз осындай нәрсені істеп жатқаныңызша
Dialogue: 0,0:10:46.09,0:10:48.62,Default,,0000,0000,0000,,Бос партаны оқу үшін пайдалануға болады!
Dialogue: 0,0:10:48.62,0:10:50.62,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:10:54.67,0:10:58.67,Default,,0000,0000,0000,,Сіз байыптысыз... (Катата) Аюзава Джуку күткендей.
Dialogue: 0,0:11:00.73,0:11:02.75,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:02.75,0:11:04.75,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:11:05.96,0:11:10.84,Default,,0000,0000,0000,,Уау, бұл шынымен де мағыналы. Төраға Аюзава, бүгін сізде де толық емес жұмыс бар ма?
Dialogue: 0,0:11:10.84,0:11:13.70,Default,,0000,0000,0000,,Бүгін сенімен бірге жүруге рұқсат етіңіз... Сонда кездескенше!
Dialogue: 0,0:11:13.70,0:11:16.73,Default,,0000,0000,0000,,Барлығы сақ болып, үйлеріне қайтсын. Күте тұрыңыз.
Dialogue: 0,0:11:16.73,0:11:18.91,Default,,0000,0000,0000,,Неліктен жоқ?
Dialogue: 0,0:11:18.91,0:11:20.91,Default,,0000,0000,0000,,Дәлізде жүгірме! (5 ағайынды) Ұстаз!
Dialogue: 0,0:11:23.96,0:11:25.65,Default,,0000,0000,0000,,Ахх
Dialogue: 0,0:11:25.65,0:11:27.65,Default,,0000,0000,0000,,Ұстаз!
Dialogue: 0,0:11:30.53,0:11:32.89,Default,,0000,0000,0000,,Тағы да қиын болатын сияқты!
Dialogue: 0,0:11:32.89,0:11:35.92,Default,,0000,0000,0000,,Мен сізге не істеу керектігін айтайын ба?
Dialogue: 0,0:11:35.92,0:11:38.79,Default,,0000,0000,0000,,Не? Мен еркектерді ұнатпаймын, сондықтан оларға жақындама
Dialogue: 0,0:11:38.79,0:11:43.66,Default,,0000,0000,0000,,Жоқ, бірақ... Шынымды айтсам, аздап бақыттымын...
Dialogue: 0,0:11:43.66,0:11:46.03,Default,,0000,0000,0000,,Ұстаз! (Широ) Қайдасың?
Dialogue: 0,0:11:46.03,0:11:51.03,Default,,0000,0000,0000,,Мазасыз, бірақ мен ондай қызба жігіттерді жек көрмеймін.
Dialogue: 0,0:11:58.81,0:12:01.81,Default,,0000,0000,0000,,Қош келдіңіз, ұстаз.
Dialogue: 0,0:12:05.89,0:12:07.91,Default,,0000,0000,0000,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:12:07.91,0:12:10.77,Default,,0000,0000,0000,,Бүгінгі ерекше, шебер.
Dialogue: 0,0:12:10.77,0:12:12.29,Default,,0000,0000,0000,,Жақсырақ...
Dialogue: 0,0:12:12.29,0:12:14.65,Default,,0000,0000,0000,,Толығырақ айтып беріңізші!
Dialogue: 0,0:12:14.65,0:12:17.65,Default,,0000,0000,0000,,Жұмысыңызға еріп баруға рұқсат етіңіз!
Dialogue: 0,0:12:19.86,0:12:23.86,Default,,0000,0000,0000,,(жүгірген аяқ дыбысы)
Dialogue: 0,0:12:24.74,0:12:26.76,Default,,0000,0000,0000,,Егер мен оны бөлшектеп алсам ше?
Dialogue: 0,0:12:26.76,0:12:28.45,Default,,0000,0000,0000,,Сіздің уақытыңыз әрқашан жақсы емес пе?
Dialogue: 0,0:12:28.45,0:12:33.17,Default,,0000,0000,0000,,Оларға жағдайды айтсақ түсінбей ме?
Dialogue: 0,0:12:33.17,0:12:35.17,Default,,0000,0000,0000,,Жоқ, бірақ...
Dialogue: 0,0:12:37.70,0:12:39.72,Default,,0000,0000,0000,,Күткендей, қызметші...
Dialogue: 0,0:12:39.72,0:12:42.76,Default,,0000,0000,0000,,Мен мұны құпия сақтағым келеді.
Dialogue: 0,0:12:42.76,0:12:47.81,Default,,0000,0000,0000,,Қараңызшы, олар мені төраға ретінде көздеп отыр.
Dialogue: 0,0:12:47.81,0:12:50.67,Default,,0000,0000,0000,,Менің көңілімді қалдырғың келмейді.
Dialogue: 0,0:12:50.67,0:12:54.67,Default,,0000,0000,0000,,Мм, сонда біз осылай мәңгілікке қашамыз ба?
Dialogue: 0,0:13:02.79,0:13:04.79,Default,,0000,0000,0000,,Қашу...?
Dialogue: 0,0:13:05.82,0:13:09.52,Default,,0000,0000,0000,,
Dialogue: 0,0:14:18.88,0:14:21.91,Default,,0000,0000,0000,,Бүгін біз құймақтарды ұсынамыз.
Dialogue: 0,0:14:21.91,0:14:24.78,Default,,0000,0000,0000,,Уақытыңызды бөліп, демалыңыз.
Dialogue: 0,0:14:24.78,0:14:27.80,Default,,0000,0000,0000,,Ұстаз, мен не жазуым керек?
Dialogue: 0,0:14:27.80,0:14:29.99,Default,,0000,0000,0000,,МАХАББАТ деп жазғаныңды қалаймын
Dialogue: 0,0:14:29.99,0:14:31.99,Default,,0000,0000,0000,,Кашикомаримасу
Dialogue: 0,0:14:36.73,0:14:39.92,Default,,0000,0000,0000,,Иә, бар.
Dialogue: 0,0:14:39.92,0:14:44.97,Default,,0000,0000,0000,,〈Мен Аюзава Джукудағы жігіттердің мені бұлай көруіне жол бере алмаймын...〉
Dialogue: 0,0:14:44.97,0:14:46.97,Default,,0000,0000,0000,,Уақытыңызды бөліп, демалыңыз.
Dialogue: 0,0:14:48.85,0:14:51.88,Default,,0000,0000,0000,,Сен бірдеңеден қиналып жатқан сияқтысың, Миса-чан.
Dialogue: 0,0:14:51.88,0:14:53.40,Default,,0000,0000,0000,,Мен үйреніп қалдым деп ойладым, бірақ...
Dialogue: 0,0:14:53.40,0:14:55.75,Default,,0000,0000,0000,,...
Dialogue: 0,0:14:55.75,0:15:00.75,Default,,0000,0000,0000,,Күйеуіңіз суретке түсіп, сізді ойынға шақырады.
Dialogue: 0,0:15:01.81,0:15:04.84,Default,,0000,0000,0000,,→
Dialogue: 0,0:15:04.84,0:15:06.86,Default,,0000,0000,0000,,Ойын не туралы?
Dialogue: 0,0:15:06.86,0:15:09.73,Default,,0000,0000,0000,,Жылдамдықпен О, сен салқын болуға тырысыпсың, Ақ.
Dialogue: 0,0:15:09.73,0:15:12.76,Default,,0000,0000,0000,,Бұл сізге сәйкес келмейді. Миса Чанмен түскен сурет.
Dialogue: 0,0:15:12.76,0:15:14.76,Default,,0000,0000,0000,,Жарайды, онда...
Dialogue: 0,0:15:15.45,0:15:19.99,Default,,0000,0000,0000,,Жарайды! Мен көп жаттықтым
Dialogue: 0,0:15:19.99,0:15:21.85,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:21.85,0:15:25.71,Default,,0000,0000,0000,,Мен бүгін көп еңбек еттім...
Dialogue: 0,0:15:25.71,0:15:28.71,Default,,0000,0000,0000,,Сәттілік! Ұрыс~! Широян
Dialogue: 0,0:15:30.76,0:15:32.96,Default,,0000,0000,0000,,Мен барамын Иә
Dialogue: 0,0:15:32.96,0:15:34.96,Default,,0000,0000,0000,,Бұл мүмкін емес қой?
Dialogue: 0,0:15:45.75,0:15:47.77,Default,,0000,0000,0000,,Е! тым жылдам
Dialogue: 0,0:15:47.77,0:15:49.79,Default,,0000,0000,0000,,Бұл мүмкін бе? Бұл мүмкін бе? ?
Dialogue: 0,0:15:49.79,0:15:52.82,Default,,0000,0000,0000,,Уфуфу Миса-чан күткендей, сен сондай аяусызсың.
Dialogue: 0,0:15:52.82,0:15:55.85,Default,,0000,0000,0000,,Барлығы мені соңғы бастық деп атайды.
Dialogue: 0,0:15:55.85,0:15:57.21,Default,,0000,0000,0000,,Ойын ойнау кезінде
Dialogue: 0,0:15:57.21,0:16:00.74,Default,,0000,0000,0000,,<Әрине, суретке түсірілген күні>
Dialogue: 0,0:16:00.74,0:16:02.76,Default,,0000,0000,0000,,〈Ол мектепке қашан барады?''
Dialogue: 0,0:16:02.76,0:16:07.80,Default,,0000,0000,0000,,Әй! Усуи жеңді, сондықтан мен бара аламын деп ойладым.
Dialogue: 0,0:16:07.80,0:16:09.66,Default,,0000,0000,0000,,Ол бірінші болып Миса-чанды түсірді.
Dialogue: 0,0:16:09.66,0:16:11.66,Default,,0000,0000,0000,,Бұл керемет болды!
Dialogue: 0,0:16:17.24,0:16:20.77,Default,,0000,0000,0000,,〈Ол мені ұрды, бірақ...〉
Dialogue: 0,0:16:20.77,0:16:23.80,Default,,0000,0000,0000,,《Мен президентпен алғаш рет суретке түсуім.》
Dialogue: 0,0:16:23.80,0:16:26.83,Default,,0000,0000,0000,,<Сол фотоға не болды?>
Dialogue: 0,0:16:26.83,0:16:30.83,Default,,0000,0000,0000,,<Сен оны мектепке әкелмегенсің бе...>
Dialogue: 0,0:16:31.87,0:16:35.91,Default,,0000,0000,0000,,《Біз осылай мәңгілікке қашамыз》
Dialogue: 0,0:16:35.91,0:16:40.46,Default,,0000,0000,0000,,〈Мен олардың көңілін қалдырғым келмейді〉
Dialogue: 0,0:16:40.46,0:16:42.99,Default,,0000,0000,0000,,<Мен қашпаймын...>
Dialogue: 0,0:16:42.99,0:16:44.84,Default,,0000,0000,0000,,Қарғыс атсын, Миса Чанмен естелік сурет
Dialogue: 0,0:16:44.84,0:16:48.72,Default,,0000,0000,0000,,<Бұл жігіттер... басында мені жиіркенішті деп ойлады...>
Dialogue: 0,0:16:48.72,0:16:51.91,Default,,0000,0000,0000,,《Мен саған сыртқы түріңді жөндеп бер дедім! 》
Dialogue: 0,0:16:51.91,0:16:55.78,Default,,0000,0000,0000,,《Хехе, кейін шешемін》
Dialogue: 0,0:16:55.78,0:16:58.98,Default,,0000,0000,0000,,〈Мен сенің қызметші болып істейтініңді білгенде солай болды〉
Dialogue: 0,0:16:58.98,0:17:00.50,Default,,0000,0000,0000,,<Бірақ...>
Dialogue: 0,0:17:00.50,0:17:02.69,Default,,0000,0000,0000,,Ұпайларды жинап, тапсырманы қайта орындаңыз.
Dialogue: 0,0:17:02.69,0:17:05.72,Default,,0000,0000,0000,,Жарайды, қайталап көрейік! Қайтадан ұпай жинайық
Dialogue: 0,0:17:05.72,0:17:07.91,Default,,0000,0000,0000,,Миса-чанмен естелік суретке
Dialogue: 0,0:17:07.91,0:17:09.91,Default,,0000,0000,0000,,О!
Dialogue: 0,0:17:14.80,0:17:19.52,Default,,0000,0000,0000,,Аа, Миса-чан, мен ертең қоян құлақ күнін жасауды ойладым.
Dialogue: 0,0:17:19.52,0:17:21.04,Default,,0000,0000,0000,,Усауса Хонока Пён десу
Dialogue: 0,0:17:21.04,0:17:25.91,Default,,0000,0000,0000,,Усаусапён, сәбізден тістеп алғың келе ме?
Dialogue: 0,0:17:25.91,0:17:28.94,Default,,0000,0000,0000,,Субарупён, саған сақал керек емес пе?
Dialogue: 0,0:17:28.94,0:17:32.82,Default,,0000,0000,0000,,Ақыр аяғында егеуқұйрыққа ұқсайды ма деп ойладым.
Dialogue: 0,0:17:32.82,0:17:34.84,Default,,0000,0000,0000,,Иә Мисапён
Dialogue: 0,0:17:34.84,0:17:37.87,Default,,0000,0000,0000,,Сіз Мисапёнсыз ба...?
Dialogue: 0,0:17:37.87,0:17:40.23,Default,,0000,0000,0000,,Ой, жарайды, жарайды, айтшы.
Dialogue: 0,0:17:40.23,0:17:43.77,Default,,0000,0000,0000,,Usausa Misapyon Қолдар осылай!
Dialogue: 0,0:17:43.77,0:17:46.96,Default,,0000,0000,0000,,Бұл солай ма...
Dialogue: 0,0:17:46.96,0:17:49.32,Default,,0000,0000,0000,,Қоян қоян... Мисапён...
Dialogue: 0,0:17:49.32,0:17:52.85,Default,,0000,0000,0000,,Бұл қандай қозғалыс? ? Сен елес емессің, Мисапён.
Dialogue: 0,0:17:52.85,0:17:55.55,Default,,0000,0000,0000,,Усапённың қолдары сәл қайырылған, саусақтарының ұшы да сүйкімді!
Dialogue: 0,0:17:55.55,0:17:58.25,Default,,0000,0000,0000,,Гонокапьон бұрынғыдай қатал!
Dialogue: 0,0:17:58.25,0:18:01.78,Default,,0000,0000,0000,,<Мына суретке қарап, мен сізді шебер деп айта алмаймын.>
Dialogue: 0,0:18:01.78,0:18:03.78,Default,,0000,0000,0000,,Мастер~
Dialogue: 0,0:18:04.81,0:18:07.83,Default,,0000,0000,0000,,Әпке, ертең қандай күн?
Dialogue: 0,0:18:07.83,0:18:10.86,Default,,0000,0000,0000,,Иә? Ертең?
Dialogue: 0,0:18:10.86,0:18:12.88,Default,,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:18:12.88,0:18:14.90,Default,,0000,0000,0000,,Жауап бере алмасаңыз жақсы.
Dialogue: 0,0:18:14.90,0:18:18.90,Default,,0000,0000,0000,,Бұл үлкен мәселе емес десең, бұл үлкен мәселе емес.
Dialogue: 0,0:18:19.45,0:18:21.81,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:18:21.81,0:18:25.85,Default,,0000,0000,0000,,Ертең, 3-ші көшедегі дәріханада екі еселік ұпайларға қызмет көрсету күні болады.
Dialogue: 0,0:18:25.85,0:18:28.88,Default,,0000,0000,0000,,Ол екі есе үлкен, солай емес пе? Иә...
Dialogue: 0,0:18:28.88,0:18:33.76,Default,,0000,0000,0000,,Егер сізге бірдеңе қажет болса, картаңызды 3-chome-ге апарыңыз.
Dialogue: 0,0:18:33.76,0:18:35.76,Default,,0000,0000,0000,,Иә, түсінемін.
Dialogue: 0,0:18:36.79,0:18:41.67,Default,,0000,0000,0000,,Бірдеңе болды ма? Ал, шампунь, жуғыш зат және т.б.
Dialogue: 0,0:18:41.67,0:18:44.87,Default,,0000,0000,0000,,Онда болды ма? Жоқ, әпке
Dialogue: 0,0:18:44.87,0:18:48.91,Default,,0000,0000,0000,,Ол бірдеңе ойлап отырған сияқты, сондықтан бірдеңе болды ма деп ойлаймын.
Dialogue: 0,0:18:48.91,0:18:51.78,Default,,0000,0000,0000,,Мен! Жоқ, басқа ештеңе...
Dialogue: 0,0:18:51.78,0:18:55.82,Default,,0000,0000,0000,,Хмм, шын мәнінде ертең ғана емес.
Dialogue: 0,0:18:55.82,0:18:58.01,Default,,0000,0000,0000,,Бұл артта қалды ма? Қызмет көрсету күндері және арнайы сату күндері дегеніміз не?
Dialogue: 0,0:18:58.01,0:19:01.71,Default,,0000,0000,0000,,Бұл дүкенде күн сайын дерлік жасалатын нәрсе.
Dialogue: 0,0:19:01.71,0:19:05.92,Default,,0000,0000,0000,,Бұл керемет, Сана. Мұндайды көргенде бәрі кері кетпей ме?
Dialogue: 0,0:19:05.92,0:19:10.97,Default,,0000,0000,0000,,Мүлде жоқ. Барлығы маған ұпай жинауға көмектесу арқылы көмектеседі.
Dialogue: 0,0:19:10.97,0:19:15.97,Default,,0000,0000,0000,,Ей, бұл Сана туралы жақсы...
Dialogue: 0,0:19:17.87,0:19:20.87,Default,,0000,0000,0000,,〈Әрқашан өзің сияқты, өз қарқынмен...〉
Dialogue: 0,0:19:23.76,0:19:25.76,Default,,0000,0000,0000,,〈Бірақ мен...〉
Dialogue: 0,0:19:28.81,0:19:33.86,Default,,0000,0000,0000,,Әй, ана жақтағы жігіт, баспалдақта отырма, жолға түсіп бара жатырсың!
Dialogue: 0,0:19:33.86,0:19:36.89,Default,,0000,0000,0000,,Үзее келді. Барайық.
Dialogue: 0,0:19:36.89,0:19:38.89,Default,,0000,0000,0000,,Міне, Абдул мырза дәл осылай дейді
Dialogue: 0,0:19:41.77,0:19:43.79,Default,,0000,0000,0000,,（５）
Dialogue: 0,0:19:43.79,0:19:45.81,Default,,0000,0000,0000,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:19:45.81,0:19:47.81,Default,,0000,0000,0000,,Қайырлы таң!
Dialogue: 0,0:19:53.73,0:19:55.08,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:19:55.08,0:19:58.78,Default,,0000,0000,0000,,Ұстаз, бүгін маған Айкидо үйрете аласыз ба?
Dialogue: 0,0:19:58.78,0:20:00.80,Default,,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:20:00.80,0:20:02.80,Default,,0000,0000,0000,,О
Dialogue: 0,0:20:08.88,0:20:10.88,Default,,0000,0000,0000,,Тааа!
Dialogue: 0,0:20:11.74,0:20:14.11,Default,,0000,0000,0000,,Осылай лақтыру - төрт жақты лақтыру.
Dialogue: 0,0:20:14.11,0:20:18.81,Default,,0000,0000,0000,,Айкидо шабуылды өзіңіз бастау емес.
Dialogue: 0,0:20:18.81,0:20:21.84,Default,,0000,0000,0000,,Қарсыластың орынсыз шабуылдарына соқтығыспай
Dialogue: 0,0:20:21.84,0:20:24.87,Default,,0000,0000,0000,,Қарсыласыңыздың күшін пайдаланып, оларға трюктар жасаңыз.
Dialogue: 0,0:20:24.87,0:20:27.73,Default,,0000,0000,0000,,Мен сізден күткендей көп нәрсені үйренемін, Ұстаз→
Dialogue: 0,0:20:27.73,0:20:29.76,Default,,0000,0000,0000,,Күтілгендей! О, күткендей!
Dialogue: 0,0:20:29.76,0:20:34.76,Default,,0000,0000,0000,,<Ақыр соңында, мен бұл түзу жігіттердің көңілін қалдырғым келмейді...>
Dialogue: 0,0:20:38.51,0:20:41.87,Default,,0000,0000,0000,,(есік ашылады)
Dialogue: 0,0:20:41.87,0:20:43.73,Default,,0000,0000,0000,,Уау, қатты жел соғады...
Dialogue: 0,0:20:43.73,0:20:45.75,Default,,0000,0000,0000,,Не болды? Төраға: Бұл әдеттен тыс.
Dialogue: 0,0:20:45.75,0:20:47.77,Default,,0000,0000,0000,,Усуи! ?
Dialogue: 0,0:20:47.77,0:20:50.80,Default,,0000,0000,0000,,Сені тағы сол жігіттер қуып жүр ме?
Dialogue: 0,0:20:50.80,0:20:55.80,Default,,0000,0000,0000,,Жоқ... басымды сәл салқындату үшін...
Dialogue: 0,0:21:06.79,0:21:10.79,Default,,0000,0000,0000,,Мен оларға қызметші туралы айтайын деп жатырмын...
Dialogue: 0,0:21:16.89,0:21:20.93,Default,,0000,0000,0000,,Мені таң қалдырып, біліп қалған кезді ойлау.
Dialogue: 0,0:21:20.93,0:21:23.80,Default,,0000,0000,0000,,Енді адал болған дұрыс.
Dialogue: 0,0:21:23.80,0:21:28.84,Default,,0000,0000,0000,,Мен олардың идеалына жақынмын деп ойладым...
Dialogue: 0,0:21:28.84,0:21:31.84,Default,,0000,0000,0000,,Олар үшін де?
Dialogue: 0,0:21:33.90,0:21:36.90,Default,,0000,0000,0000,,Өзіңіз үшін емес пе?
Dialogue: 0,0:21:42.81,0:21:45.85,Default,,0000,0000,0000,,Иә, бәрінен кейін қорқатын менмін.
Dialogue: 0,0:21:45.85,0:21:50.89,Default,,0000,0000,0000,,Қызметші киімінде көріну олардың бейнесін бұзады.
Dialogue: 0,0:21:50.89,0:21:53.76,Default,,0000,0000,0000,,Менсінуге...
Dialogue: 0,0:21:53.76,0:21:58.76,Default,,0000,0000,0000,,Бір кездері сізге жақсы ниет танытқан адамның көңілін қалдыру өте ауыр...
Dialogue: 0,0:21:59.65,0:22:01.84,Default,,0000,0000,0000,,Жарайды, көңілім қалмады.
Dialogue: 0,0:22:01.84,0:22:04.84,Default,,0000,0000,0000,,Төраға не істесе де...
Dialogue: 0,0:22:05.88,0:22:07.73,Default,,0000,0000,0000,,Жіңішке... Қараңызшы, дәлел
Dialogue: 0,0:22:07.73,0:22:11.94,Default,,0000,0000,0000,,Уау! Мақтанышпен не ұстап тұрсың?
Dialogue: 0,0:22:11.94,0:22:13.80,Default,,0000,0000,0000,,Бұл бойтұмар. Бұл не? ?
Dialogue: 0,0:22:13.80,0:22:17.33,Default,,0000,0000,0000,,Я, махаббат... Хааааа! ?
Dialogue: 0,0:22:17.33,0:22:19.85,Default,,0000,0000,0000,,Мен мұны түсіндім!
Dialogue: 0,0:22:19.85,0:22:21.85,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:22:26.75,0:22:29.79,Default,,0000,0000,0000,,Менің ойымша, сыныпқа қайтатын уақыт келді.
Dialogue: 0,0:22:29.79,0:22:32.82,Default,,0000,0000,0000,,Әй, оны ұрламақ болған төраға кінәлі.
Dialogue: 0,0:22:32.82,0:22:35.85,Default,,0000,0000,0000,,Эй... сен... Бұл қауіпті.
Dialogue: 0,0:22:35.85,0:22:38.85,Default,,0000,0000,0000,,Мен не істеуім керек, не болса да...
Dialogue: 0,0:22:41.24,0:22:43.76,Default,,0000,0000,0000,,Мен оны аламын ба?
Dialogue: 0,0:22:43.76,0:22:47.97,Default,,0000,0000,0000,,Бірақ, бұдан былай сені алдымен астыңдағы жігіттер алып кетуі керек.
Dialogue: 0,0:22:47.97,0:22:50.83,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? ең қысқа қашықтық
Dialogue: 0,0:22:50.83,0:22:52.85,Default,,0000,0000,0000,,Бұл рас, бірақ сен өлесің!
Dialogue: 0,0:22:52.85,0:22:55.88,Default,,0000,0000,0000,,Төраға алып кел десе, әкелемін.
Dialogue: 0,0:22:55.88,0:22:57.90,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Неге олай сөйлеп тұрсың?
Dialogue: 0,0:22:57.90,0:23:01.27,Default,,0000,0000,0000,,Байқап көріңіз! Неге...
Dialogue: 0,0:23:01.27,0:23:03.27,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:23:12.89,0:23:15.89,Default,,0000,0000,0000,,Өйткені маған Аюзава ұнайды...
Dialogue: 0,0:23:24.00,0:23:27.00,Default,,0000,0000,0000,,Усуи!
Dialogue: 0,0:23:29.88,0:23:31.88,Default,,0000,0000,0000,,<Не істеп жатырсың...>
Dialogue: 0,0:23:33.92,0:23:35.92,Default,,0000,0000,0000,,<Не істеп жатырсың...>
Dialogue: 0,0:23:38.81,0:23:40.81,Default,,0000,0000,0000,,<Не істеп жатырсың?>
Dialogue: 0,0:23:42.68,0:23:44.68,Default,,0000,0000,0000,,<Не істеп жатырсың?>
Dialogue: 0,0:24:07.77,0:24:10.77,Default,,0000,0000,0000,,Мен күткендей!
Dialogue: 0,0:24:12.82,0:24:15.82,Default,,0000,0000,0000,,Шынымен... Күткендей...
Dialogue: 0,0:24:16.86,0:24:19.72,Default,,0000,0000,0000,,Ақымақ!
Dialogue: 0,0:24:19.72,0:24:22.92,Default,,0000,0000,0000,,Ұстаз, бірдеңе болды ма? Усуи-сан! ?
Dialogue: 0,0:24:22.92,0:24:26.79,Default,,0000,0000,0000,,Тезірек ауруханаға барыңыз! Менің ойымша, бәрі жақсы
Dialogue: 0,0:24:26.79,0:24:29.48,Default,,0000,0000,0000,,Төбеден секіруге жарайтын адам бар ма?
Dialogue: 0,0:24:29.48,0:24:31.67,Default,,0000,0000,0000,,Неліктен бұл жер бетінде болды?
Dialogue: 0,0:24:31.67,0:24:34.67,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:24:38.74,0:24:42.74,Default,,0000,0000,0000,,Мен сізге айтпаған бір нәрсе бар.
Dialogue: 0,0:24:45.98,0:24:48.98,Default,,0000,0000,0000,,Негізі менің толық емес жұмысым... Төраға
Dialogue: 0,0:24:52.88,0:24:57.88,Default,,0000,0000,0000,,Бұл мектептен кейін төраға екенімді білдіре ме?
Dialogue: 0,0:24:59.79,0:25:03.79,Default,,0000,0000,0000,,Бұрынғы үшін сыйлық ретінде мен сізге құпия сақтаушы болуға рұқсат етемін.
Dialogue: 0,0:25:06.85,0:25:10.85,Default,,0000,0000,0000,,Мен сені қатты жек көремін!
Dialogue: 0,0:25:11.90,0:25:15.94,Default,,0000,0000,0000,,（） （）
Dialogue: 0,0:25:15.94,0:25:17.80,Default,,0000,0000,0000,,（）
Dialogue: 0,0:25:17.80,0:25:20.99,Default,,0000,0000,0000,,Егер солай болса, біз кедергі жасай алмаймыз.
Dialogue: 0,0:25:20.99,0:25:22.99,Default,,0000,0000,0000,,Усуй деген кім?
Dialogue: 0,0:25:27.73,0:25:30.76,Default,,0000,0000,0000,,Ақыр соңында, сіз ешкімнің сізді алаңдатқанын қаламайсыз, солай ма?
Dialogue: 0,0:25:30.76,0:25:32.78,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:25:32.78,0:25:36.99,Default,,0000,0000,0000,,Миса Чанның жанкүйерлері көбейсе де~
Dialogue: 0,0:25:36.99,0:25:38.99,Default,,0000,0000,0000,,Науқасты қызметші киімінде күту
Dialogue: 0,0:25:39.85,0:25:41.20,Default,,0000,0000,0000,,Га!
Dialogue: 0,0:25:41.20,0:25:43.20,Default,,0000,0000,0000,,Үйге қайт!
Dialogue: 0,0:25:47.77,0:25:52.81,Default,,0000,0000,0000,,Ол бәрібір бұзық! Ол керемет бұзылған бөтен планеталық!
Dialogue: 0,0:25:52.81,0:26:36.81,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:38.27,0:27:21.70,Default,,0000,0000,0000,,
Dialogue: 0,0:27:23.20,0:27:29.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory