Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:24.13,0:02:51.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:52.51,0:03:02.27,Default,,0000,0000,0000,,
Dialogue: 0,0:04:05.40,0:04:08.76,Default,,0000,0000,0000,,Қош келдіңіз, ұстаз.
Dialogue: 0,0:04:08.76,0:04:10.28,Default,,0000,0000,0000,,Миса-чан көзілдірік қыз
Dialogue: 0,0:04:10.28,0:04:12.28,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:04:24.09,0:04:26.09,Default,,0000,0000,0000,,Ахх
Dialogue: 0,0:04:28.13,0:04:30.15,Default,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:04:30.15,0:04:32.67,Default,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:04:32.67,0:04:35.03,Default,,0000,0000,0000,,Кешіріңіз, Субару-сан.
Dialogue: 0,0:04:35.03,0:04:37.72,Default,,0000,0000,0000,,Тынышталыңыз Иә
Dialogue: 0,0:04:37.72,0:04:41.72,Default,,0000,0000,0000,,Ұрыс~! Біз осындамыз! О иә!
Dialogue: 0,0:04:42.27,0:04:45.96,Default,,0000,0000,0000,,Жоқ, мен дұрыс көңіл бөлуім керек.
Dialogue: 0,0:04:45.96,0:04:48.83,Default,,0000,0000,0000,,Миса Чан, жақсысың ба? Ах, менеджер, кешіріңіз.
Dialogue: 0,0:04:48.83,0:04:51.36,Default,,0000,0000,0000,,Егер сізде қиындықтар болса, бізбен кеңесіңіз.
Dialogue: 0,0:04:51.36,0:04:54.73,Default,,0000,0000,0000,,Бәрі жақсы. Жуықта көріскенше.
Dialogue: 0,0:04:54.73,0:04:57.08,Default,,0000,0000,0000,,Кешіріңіз, бәрі жақсы.
Dialogue: 0,0:04:57.08,0:05:00.11,Default,,0000,0000,0000,,Өйткені мен Миса Чанға сенемін.
Dialogue: 0,0:05:00.11,0:05:02.13,Default,,0000,0000,0000,,Сонда Хонока ше?
Dialogue: 0,0:05:02.13,0:05:05.00,Default,,0000,0000,0000,,Әрине, Хонока-чан мен Субару-чан да.
Dialogue: 0,0:05:05.00,0:05:08.87,Default,,0000,0000,0000,,Эрика-чан, Гон-чан, Саю-чан, барлығы.
Dialogue: 0,0:05:08.87,0:05:12.23,Default,,0000,0000,0000,,Уфуфуфу Сондықтан дүкен меңгерушісіне қауіп төніп тұр.
Dialogue: 0,0:05:12.23,0:05:15.93,Default,,0000,0000,0000,,Хонока-чан, оның аурасы әйтеуір қара.
Dialogue: 0,0:05:15.93,0:05:18.13,Default,,0000,0000,0000,,Бірақ мен жай ғана жалқау адамдарға ашуланамын.
Dialogue: 0,0:05:18.13,0:05:20.32,Default,,0000,0000,0000,,Уау, Хонока, мен дүкенге қайтамын.
Dialogue: 0,0:05:20.32,0:05:23.68,Default,,0000,0000,0000,,Миса-чан бітуге жақын, еңбектеріңізге рахмет.
Dialogue: 0,0:05:23.68,0:05:25.70,Default,,0000,0000,0000,,Алдын ала кешіріңіз.
Dialogue: 0,0:05:25.70,0:05:27.72,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:05:27.72,0:05:29.58,Default,,0000,0000,0000,,Көңілді сияқты
Dialogue: 0,0:05:29.58,0:05:32.77,Default,,0000,0000,0000,,Усуи! Сіз әлі ауруханадан шықтыңыз ба?
Dialogue: 0,0:05:32.77,0:05:34.12,Default,,0000,0000,0000,,Мен күткендей, солай емес пе?
Dialogue: 0,0:05:34.12,0:05:37.15,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Ол таңғышпен оралған.
Dialogue: 0,0:05:37.15,0:05:39.00,Default,,0000,0000,0000,,Мен сені уайымдаймын.
Dialogue: 0,0:05:39.00,0:05:41.70,Default,,0000,0000,0000,,Рұқсатсыз кірме, өйткені тез.
Dialogue: 0,0:05:41.70,0:05:45.23,Default,,0000,0000,0000,,Мен Мэйд Латтеден Мисамен танысқым келді.
Dialogue: 0,0:05:45.23,0:05:47.23,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:06:04.42,0:06:06.42,Default,,0000,0000,0000,,《Себебі маған Аюзава ұнайды》
Dialogue: 0,0:06:22.11,0:06:26.48,Default,,0000,0000,0000,,(Кіріс ұялы қоңырау)
Dialogue: 0,0:06:26.48,0:06:28.48,Default,,0000,0000,0000,,Сакура?
Dialogue: 0,0:06:35.40,0:06:37.40,Default,,0000,0000,0000,,Мисаки~ осында
Dialogue: 0,0:06:40.95,0:06:42.13,Default,,0000,0000,0000,,Кіммен ұрысып жатырсың?
Dialogue: 0,0:06:42.13,0:06:44.49,Default,,0000,0000,0000,,Мен Масагаока академиясының студентімін.
Dialogue: 0,0:06:44.49,0:06:47.69,Default,,0000,0000,0000,,Бұл барлық бай адамдар жиналатын супер атақты мектеп.
Dialogue: 0,0:06:47.69,0:06:51.22,Default,,0000,0000,0000,,Ең аз араласқыңыз келетін адамның түріне байланысты
Dialogue: 0,0:06:51.22,0:06:53.58,Default,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,0:06:53.58,0:06:55.60,Default,,0000,0000,0000,,Кешіріңіз, өтуге рұқсат етіңіз.
Dialogue: 0,0:06:55.60,0:06:59.31,Default,,0000,0000,0000,,Балалар, қалада нені шулатып жатырсыңдар?
Dialogue: 0,0:06:59.31,0:07:02.17,Default,,0000,0000,0000,,Төраға не үшін келеді? (Такамизава) Мен білемін бе?
Dialogue: 0,0:07:02.17,0:07:04.53,Default,,0000,0000,0000,,Мен тастап кеткен құралдар—
Dialogue: 0,0:07:04.53,0:07:09.41,Default,,0000,0000,0000,,Мен Мисаки Аюзавамын, Сейка орта мектебінің студенттер кеңесінің президенті. Менің оқушыма не болды?
Dialogue: 0,0:07:09.41,0:07:13.28,Default,,0000,0000,0000,,Мені ренжіген оқушы еріксіз жұдырықпен ұрды.
Dialogue: 0,0:07:13.28,0:07:15.30,Default,,0000,0000,0000,,Мистер Столкер
Dialogue: 0,0:07:15.30,0:07:21.30,Default,,0000,0000,0000,,Сейка орта мектебі варвар ретінде танымал, бірақ бұл мені тағы бір рет түсінді.
Dialogue: 0,0:07:22.21,0:07:26.58,Default,,0000,0000,0000,,Мен оны кешірім сұрауға қалай жеткізуге болатынын білмеймін.
Dialogue: 0,0:07:26.58,0:07:30.28,Default,,0000,0000,0000,,Ақымақ болма, неге кешірім сұрау керек?
Dialogue: 0,0:07:30.28,0:07:32.64,Default,,0000,0000,0000,,Балалар, кешірім сұраймыз!
Dialogue: 0,0:07:32.64,0:07:34.83,Default,,0000,0000,0000,,Ити, не істеп жатырсың!
Dialogue: 0,0:07:34.83,0:07:37.19,Default,,0000,0000,0000,,Егер мені ұрсаң, кешірім сұра деп жатырмын.
Dialogue: 0,0:07:37.19,0:07:40.72,Default,,0000,0000,0000,,（） （）
Dialogue: 0,0:07:40.72,0:07:44.08,Default,,0000,0000,0000,,Осындай шулы қалада басқа адамдарға қолайсыздық тудыратынын ойлаңыз.
Dialogue: 0,0:07:44.08,0:07:46.10,Default,,0000,0000,0000,,Бірден бастағандар – ақымақ.
Dialogue: 0,0:07:46.10,0:07:49.13,Default,,0000,0000,0000,,Дәл қазір сөйлесудің қажеті жоқ сияқты.
Dialogue: 0,0:07:49.13,0:07:52.16,Default,,0000,0000,0000,,Біз сізді әрқашан Миагаокада күтеміз→
Dialogue: 0,0:07:52.16,0:07:55.86,Default,,0000,0000,0000,,Егер кешірім сұрағыңыз келмесе, онда →
Dialogue: 0,0:07:55.86,0:07:58.86,Default,,0000,0000,0000,,Бұл жалпы мектептегі мәселе болады.
Dialogue: 0,0:08:03.45,0:08:06.64,Default,,0000,0000,0000,,Қалағаныңды істе, кеттік.
Dialogue: 0,0:08:06.64,0:08:08.83,Default,,0000,0000,0000,,Келесі шайқас!
Dialogue: 0,0:08:08.83,0:08:12.53,Default,,0000,0000,0000,,Мисаки Үлкен бірдеңе болса не істер едің?
Dialogue: 0,0:08:12.53,0:08:16.41,Default,,0000,0000,0000,,Сейканың имиджі жақсарса да.
Dialogue: 0,0:08:16.41,0:08:19.41,Default,,0000,0000,0000,,Мисакидің барлық қиындықтары босқа кетті.
Dialogue: 0,0:08:20.45,0:08:24.45,Default,,0000,0000,0000,,Уайымдама, мен оны реттеймін.
Dialogue: 0,0:08:26.51,0:08:28.70,Default,,0000,0000,0000,,<Мен мұны айтқанмен>
Dialogue: 0,0:08:28.70,0:08:32.40,Default,,0000,0000,0000,,<Менің ойымша, олар кешірім сұрауға тырыспайды.>
Dialogue: 0,0:08:32.40,0:08:35.77,Default,,0000,0000,0000,,Мен Масагаока туралы естідім.
Dialogue: 0,0:08:35.77,0:08:37.79,Default,,0000,0000,0000,,(Мисаки орындықтан құлады)
Dialogue: 0,0:08:37.79,0:08:40.48,Default,,0000,0000,0000,,Төраға, амансың ба?
Dialogue: 0,0:08:40.48,0:08:42.48,Default,,0000,0000,0000,,Пыс, пыс… Э?
Dialogue: 0,0:08:48.73,0:08:51.59,Default,,0000,0000,0000,,Не болды? Аюзава
Dialogue: 0,0:08:51.59,0:08:55.59,Default,,0000,0000,0000,,<Қазір қажетсіз нәрселер туралы ойлайтын уақыт емес>
Dialogue: 0,0:08:59.17,0:09:01.02,Default,,0000,0000,0000,,(есік ашылады)
Dialogue: 0,0:09:01.02,0:09:03.04,Default,,0000,0000,0000,,Жай... жарайды.
Dialogue: 0,0:09:03.04,0:09:06.74,Default,,0000,0000,0000,,Кешіріңіз, маған біреу көмектесе алады ма?
Dialogue: 0,0:09:06.74,0:09:10.28,Default,,0000,0000,0000,,Уау, Усуй-сан? Сізге көп рахмет
Dialogue: 0,0:09:10.28,0:09:12.47,Default,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:09:12.47,0:09:14.47,Default,,0000,0000,0000,,Рахмет...
Dialogue: 0,0:09:29.97,0:09:31.49,Default,,0000,0000,0000,,Юкимура (Хагимото) Мықты бол.
Dialogue: 0,0:09:31.49,0:09:33.01,Default,,0000,0000,0000,,Юкимура~!
Dialogue: 0,0:09:33.01,0:09:36.37,Default,,0000,0000,0000,,Хехехе, түсіндім.
Dialogue: 0,0:09:36.37,0:09:38.37,Default,,0000,0000,0000,,Ол жігіт...
Dialogue: 0,0:09:40.08,0:09:42.93,Default,,0000,0000,0000,,Мен ерекше ренжідім, бірақ
Dialogue: 0,0:09:42.93,0:09:44.62,Default,,0000,0000,0000,,Ол бәріне солай.
Dialogue: 0,0:09:44.62,0:09:47.98,Default,,0000,0000,0000,,Мен жағдайға ілесе алмаймын.
Dialogue: 0,0:09:47.98,0:09:50.68,Default,,0000,0000,0000,,Уайымдамаңыз, қазір бірдеңе дұрыс емес.
Dialogue: 0,0:09:50.68,0:09:52.68,Default,,0000,0000,0000,,Ақыр аяғында бұл хентай бөтен планета.
Dialogue: 0,0:09:58.10,0:10:00.62,Default,,0000,0000,0000,,Не байсалдысың?
Dialogue: 0,0:10:00.62,0:10:03.97,Default,,0000,0000,0000,,Көңілді сияқты, мен де бірге келемін.
Dialogue: 0,0:10:03.97,0:10:05.66,Default,,0000,0000,0000,,Автобусқа мінгеніме біраз болды.
Dialogue: 0,0:10:05.66,0:10:07.18,Default,,0000,0000,0000,,Неліктен Усуй мырза?
Dialogue: 0,0:10:07.18,0:10:09.87,Default,,0000,0000,0000,,Неліктен кешірім сұраймыз?
Dialogue: 0,0:10:09.87,0:10:14.75,Default,,0000,0000,0000,,Егер кешірім сұрауға соншалықты көңіліңіз толмаса, төбелестің себебін айтыңыз.
Dialogue: 0,0:10:14.75,0:10:16.44,Default,,0000,0000,0000,,Иә? Оған көмектесу мүмкін емес
Dialogue: 0,0:10:16.44,0:10:18.44,Default,,0000,0000,0000,,Біз сол күні...
Dialogue: 0,0:10:19.47,0:10:21.49,Default,,0000,0000,0000,,《Шахмат?》
Dialogue: 0,0:10:21.49,0:10:23.34,Default,,0000,0000,0000,,《Мен мұны істей алсам жақсы болар еді~》
Dialogue: 0,0:10:23.34,0:10:25.53,Default,,0000,0000,0000,,《...Уау, бұл өте жоғары》
Dialogue: 0,0:10:25.53,0:10:28.06,Default,,0000,0000,0000,,《Отеллода сен шынымен әлсіз емессің бе?》
Dialogue: 0,0:10:28.06,0:10:31.76,Default,,0000,0000,0000,,《（） 》
Dialogue: 0,0:10:31.76,0:10:34.62,Default,,0000,0000,0000,,《Бұл менің отбасылық дүкенім》
Dialogue: 0,0:10:34.62,0:10:37.98,Default,,0000,0000,0000,,《Ол сен арсыз адамдар келетін жер емес.》
Dialogue: 0,0:10:37.98,0:10:39.84,Default,,0000,0000,0000,,《Шашыраңқы шыбындар》
Dialogue: 0,0:10:39.84,0:10:41.84,Default,,0000,0000,0000,,《О? 》
Dialogue: 0,0:10:44.72,0:10:47.91,Default,,0000,0000,0000,,Егер сіз осындай нәрсені айтсаңыз ше?
Dialogue: 0,0:10:47.91,0:10:49.91,Default,,0000,0000,0000,,Кешірім сұрағыңыз келе ме?
Dialogue: 0,0:10:57.35,0:11:00.04,Default,,0000,0000,0000,,Сондықтан кешірім сұрау керек.
Dialogue: 0,0:11:00.04,0:11:02.40,Default,,0000,0000,0000,,Шынымды айтсам, мағынасы жоқ.
Dialogue: 0,0:11:02.40,0:11:07.40,Default,,0000,0000,0000,,Бірақ мен оны қарасам да, Масагаокадағы жағымсыз мектеп ғимараты.
Dialogue: 0,0:11:09.64,0:11:14.02,Default,,0000,0000,0000,,（）
Dialogue: 0,0:11:14.02,0:11:17.72,Default,,0000,0000,0000,,Әй, тағы бірдеңе көбейіп кеткен сияқты.
Dialogue: 0,0:11:17.72,0:11:19.74,Default,,0000,0000,0000,,Ол вице-президент пе әлде басқасы ма?
Dialogue: 0,0:11:19.74,0:11:21.74,Default,,0000,0000,0000,,Жоқ, бұл саяхат.
Dialogue: 0,0:11:22.77,0:11:25.63,Default,,0000,0000,0000,,Солай ма? Хахахаха
Dialogue: 0,0:11:25.63,0:11:27.63,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:11:28.66,0:11:31.36,Default,,0000,0000,0000,,Енді әлгі екеуі кешірім сұраңыз.
Dialogue: 0,0:11:31.36,0:11:36.07,Default,,0000,0000,0000,,Шынайылығыңды қалай көрсететініңді күттім.
Dialogue: 0,0:11:36.07,0:11:38.09,Default,,0000,0000,0000,,Чи Хун
Dialogue: 0,0:11:38.09,0:11:41.63,Default,,0000,0000,0000,,Не болды? Кешірім сұрау үшін келмедің бе?
Dialogue: 0,0:11:41.63,0:11:45.33,Default,,0000,0000,0000,,Сондықтан мен ақымақ кедейлерді жек көремін.
Dialogue: 0,0:11:45.33,0:11:50.88,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес. Мұны студенттік кеңес бөлмесінде талқылайық.
Dialogue: 0,0:11:50.88,0:11:54.76,Default,,0000,0000,0000,,Сен ақымақ кедейсің бе? Мен түсінемін.
Dialogue: 0,0:11:54.76,0:11:58.76,Default,,0000,0000,0000,,Сондықтан ол менің оқушымды шыбын деп атады.
Dialogue: 0,0:11:59.81,0:12:02.67,Default,,0000,0000,0000,,Студенттік кеңес бөлмесінде сөйлескен дұрыс.
Dialogue: 0,0:12:02.67,0:12:06.71,Default,,0000,0000,0000,,Сіз мұны жалпы мектеп мәселесіне де айналдыра аласыз.
Dialogue: 0,0:12:06.71,0:12:09.40,Default,,0000,0000,0000,,Дегенмен, біз үшін ең алдымен
Dialogue: 0,0:12:09.40,0:12:12.40,Default,,0000,0000,0000,,Кешірім сұрағаныңызды қалаймын.
Dialogue: 0,0:12:13.11,0:12:16.14,Default,,0000,0000,0000,,Неге мен? Бұл сен бірінші
Dialogue: 0,0:12:16.14,0:12:20.68,Default,,0000,0000,0000,,Өйткені мен оларға қатты балағат сөздер айтқаным сонша, мен оларды жұдырықтай салғым келді.
Dialogue: 0,0:12:20.68,0:12:24.39,Default,,0000,0000,0000,,Шынымды айтсам, мен де оны ұрғым келеді, қателер жүгіріп жатыр емес пе?
Dialogue: 0,0:12:24.39,0:12:27.75,Default,,0000,0000,0000,,Егер сіз Сейканың студенті болсаңыз, сізді шыбын десе де болады.
Dialogue: 0,0:12:27.75,0:12:29.27,Default,,0000,0000,0000,,Мұның орын алуына ешқандай себеп болуы мүмкін емес.
Dialogue: 0,0:12:29.27,0:12:31.27,Default,,0000,0000,0000,,Кешірім сұрау
Dialogue: 0,0:12:32.64,0:12:34.66,Default,,0000,0000,0000,,Не қалжыңдадың...
Dialogue: 0,0:12:34.66,0:12:37.66,Default,,0000,0000,0000,,Шыбынды шыбын десе несі жаман?
Dialogue: 0,0:12:39.71,0:12:43.41,Default,,0000,0000,0000,,Иә, онда шахмат ойнасақ ше?
Dialogue: 0,0:12:43.41,0:12:46.27,Default,,0000,0000,0000,,Иә? Осымен мені жеңе алсаң
Dialogue: 0,0:12:46.27,0:12:50.31,Default,,0000,0000,0000,,Ең болмаса Сейканың шәкірттері шыбын емес.
Dialogue: 0,0:12:50.31,0:12:53.01,Default,,0000,0000,0000,,Бұрын шахмат ойнамаған сияқтысыз.
Dialogue: 0,0:12:53.01,0:12:55.03,Default,,0000,0000,0000,,Біліп, айтқаның мені ренжітеді.
Dialogue: 0,0:12:55.03,0:12:57.72,Default,,0000,0000,0000,,Төраға кім? Тек шоги...
Dialogue: 0,0:12:57.72,0:13:00.75,Default,,0000,0000,0000,,Олай болса, мен байқап көрейін деп ойлаймын. иә?
Dialogue: 0,0:13:00.75,0:13:03.44,Default,,0000,0000,0000,,Ендеше ережелерді түсіндіріп берген дұрыс болар еді...
Dialogue: 0,0:13:03.44,0:13:06.47,Default,,0000,0000,0000,,Мен мұны біраз уақыт бұрын жасадым, сондықтан бәрі жақсы.
Dialogue: 0,0:13:06.47,0:13:09.47,Default,,0000,0000,0000,,Мен көремін. Әй, жақсы.
Dialogue: 0,0:13:11.19,0:13:13.19,Default,,0000,0000,0000,,<Сіз ұстай алмайтын адам>
Dialogue: 0,0:13:15.56,0:13:17.58,Default,,0000,0000,0000,,О, мен мұны айтуды ұмытып кетіппін
Dialogue: 0,0:13:17.58,0:13:21.58,Default,,0000,0000,0000,,Биылғы республикалық байқауда 4-ші орын алдым.
Dialogue: 0,0:13:22.63,0:13:24.82,Default,,0000,0000,0000,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:13:24.82,0:13:28.86,Default,,0000,0000,0000,,Сондықтан мен аздап қысқартуға тура келеді.
Dialogue: 0,0:13:28.86,0:13:30.86,Default,,0000,0000,0000,,Уайымдамаңыз
Dialogue: 0,0:13:31.89,0:13:35.60,Default,,0000,0000,0000,,Оның орнына қарсыласыңмен бар күшіңді салып, жеңсең,
Dialogue: 0,0:13:35.60,0:13:41.98,Default,,0000,0000,0000,,Сейканың төрағасын шыбын емес, көбелек болғаны үшін мадақтаңыз.
Dialogue: 0,0:13:41.98,0:13:43.17,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:13:43.17,0:13:45.02,Default,,0000,0000,0000,,Біз ше?
Dialogue: 0,0:13:45.02,0:13:48.02,Default,,0000,0000,0000,,Жалпы айтқанда, мен байсалды болғандықтан жеңіліп қалдым...
Dialogue: 0,0:13:55.46,0:13:57.65,Default,,0000,0000,0000,,Ол ренжіген жоқ па?
Dialogue: 0,0:13:57.65,0:14:00.17,Default,,0000,0000,0000,,Мүмкін Усуй-сан күшті болып көрінетін шығар?
Dialogue: 0,0:14:00.17,0:14:02.17,Default,,0000,0000,0000,,Күшті болып көрінетін шығар
Dialogue: 0,0:14:03.88,0:14:05.73,Default,,0000,0000,0000,,Не істеу керек? Сіз отставкаға кеткіңіз келе ме?
Dialogue: 0,0:14:05.73,0:14:07.73,Default,,0000,0000,0000,,Кім
Dialogue: 0,0:14:11.29,0:14:13.29,Default,,0000,0000,0000,,Енді не істейміз?
Dialogue: 0,0:14:20.71,0:14:22.73,Default,,0000,0000,0000,,(Сора) Сол жақтағы қарт кітапханада мені бақылап тұрды—
Dialogue: 0,0:14:22.73,0:14:24.75,Default,,0000,0000,0000,,Ех! ? бөлме!
Dialogue: 0,0:14:24.75,0:14:26.75,Default,,0000,0000,0000,,Тағы бір рет пе?
Dialogue: 0,0:14:28.63,0:14:31.32,Default,,0000,0000,0000,,Ахахахаха! Кора, айқайлама
Dialogue: 0,0:14:31.32,0:14:34.69,Default,,0000,0000,0000,,Сіз басқа жолаушыларды мазалайсыз ба? Сіз бұл көзілдірікті көрдіңіз бе?
Dialogue: 0,0:14:34.69,0:14:39.40,Default,,0000,0000,0000,,«Осындай ойын арқылы адам туралы не білуге ​​болады?»
Dialogue: 0,0:14:39.40,0:14:42.77,Default,,0000,0000,0000,,《Ұш, бұл шыбын, Сейканың оқушысы》
Dialogue: 0,0:14:42.77,0:14:45.29,Default,,0000,0000,0000,,《Мен бірдей ауамен тыныс алғым келмейді》
Dialogue: 0,0:14:45.29,0:14:49.16,Default,,0000,0000,0000,,Бұл лақтыру сызығы дегеніміз не?
Dialogue: 0,0:14:49.16,0:14:51.02,Default,,0000,0000,0000,,А, мен өзімді сергек сезіндім.
Dialogue: 0,0:14:51.02,0:14:53.21,Default,,0000,0000,0000,,Усуй мырза, төраға, болды!
Dialogue: 0,0:14:53.21,0:14:57.08,Default,,0000,0000,0000,,Көп алданбаңыздар, сіздердің де кінәларыңыз бар.
Dialogue: 0,0:14:57.08,0:15:00.61,Default,,0000,0000,0000,,Осындай жағдай қайталанса...
Dialogue: 0,0:15:00.61,0:15:03.61,Default,,0000,0000,0000,,Ондай жағдайда мен төрағамен ақылдасамын.
Dialogue: 0,0:15:08.69,0:15:11.05,Default,,0000,0000,0000,,Ол жігіттер көп қиындыққа тап болды.
Dialogue: 0,0:15:11.05,0:15:14.75,Default,,0000,0000,0000,,Мені мазалайтын төраға.
Dialogue: 0,0:15:14.75,0:15:18.29,Default,,0000,0000,0000,,Бірақ Миягаоканың мұндай оқушылары көп пе?
Dialogue: 0,0:15:18.29,0:15:21.66,Default,,0000,0000,0000,,Жарайды, менің ойымша, олардың бәрі жаман адамдар емес.
Dialogue: 0,0:15:21.66,0:15:26.66,Default,,0000,0000,0000,,Мен бай адам болуды елестете алмайтын қиындықтар бар шығар.
Dialogue: 0,0:15:27.38,0:15:30.41,Default,,0000,0000,0000,,（） →
Dialogue: 0,0:15:30.41,0:15:33.78,Default,,0000,0000,0000,,Төрағадан кешірім сұрауды сұраймын →
Dialogue: 0,0:15:33.78,0:15:36.64,Default,,0000,0000,0000,,Сейка қауесеттен гөрі жабайы және қауіпті мектеп.
Dialogue: 0,0:15:36.64,0:15:39.67,Default,,0000,0000,0000,,Жалпы айтқанда, барлық еркектер арасында әйел төраға болған кезде,
Dialogue: 0,0:15:39.67,0:15:42.87,Default,,0000,0000,0000,,Мотивацияның болмауы және қауіпсіздіктің нашарлығы көрінеді...
Dialogue: 0,0:15:42.87,0:15:45.87,Default,,0000,0000,0000,,（）
Dialogue: 0,0:15:46.40,0:15:48.40,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:15:49.43,0:15:52.30,Default,,0000,0000,0000,,
Dialogue: 0,0:17:21.36,0:17:23.54,Default,,0000,0000,0000,,Миягаокадағы жігіттер...
Dialogue: 0,0:17:23.54,0:17:26.41,Default,,0000,0000,0000,,Сен мұнда не үшін келдің? Discipline me.
Dialogue: 0,0:17:26.41,0:17:29.44,Default,,0000,0000,0000,,Мен қиындыққа тап болдым. Не болды?
Dialogue: 0,0:17:29.44,0:17:31.44,Default,,0000,0000,0000,,Масагаока студенттік кеңесінің президенті...
Dialogue: 0,0:17:40.21,0:17:43.58,Default,,0000,0000,0000,,Бұл адам Игараши Зайбацудың мұрагері.
Dialogue: 0,0:17:43.58,0:17:45.60,Default,,0000,0000,0000,,Мен оны журналдан көрдім.
Dialogue: 0,0:17:45.60,0:17:49.96,Default,,0000,0000,0000,,Мен не істеуім керек? Мен Мисакиге шағымдану үшін келген сияқтымын.
Dialogue: 0,0:17:49.96,0:17:53.96,Default,,0000,0000,0000,,Жарайды, Мисаки-сан міндетті түрде бірдеңе жасайды.
Dialogue: 0,0:18:03.27,0:18:08.99,Default,,0000,0000,0000,,Менің атым Тора Игараши және мен Масагаока студенттер кеңесінің президентімін.
Dialogue: 0,0:18:08.99,0:18:12.69,Default,,0000,0000,0000,,Миягаоканың студенттік кеңесінің төрағасына не қажет?
Dialogue: 0,0:18:12.69,0:18:15.23,Default,,0000,0000,0000,,Бұл жолы оқушым дөрекі болған сияқты.
Dialogue: 0,0:18:15.23,0:18:17.08,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:18:17.08,0:18:19.60,Default,,0000,0000,0000,,Не? иә?
Dialogue: 0,0:18:19.60,0:18:21.45,Default,,0000,0000,0000,,Ол мектептен шығарылсын.
Dialogue: 0,0:18:21.45,0:18:25.82,Default,,0000,0000,0000,,Мен мектеп директорына кеңес бердім.
Dialogue: 0,0:18:25.82,0:18:28.19,Default,,0000,0000,0000,,Шығу сәл тым қатал.
Dialogue: 0,0:18:28.19,0:18:31.71,Default,,0000,0000,0000,,Мені ұрған адам да кінәлі.
Dialogue: 0,0:18:31.71,0:18:33.41,Default,,0000,0000,0000,,Сіз мені кешіре аласыз ба?
Dialogue: 0,0:18:33.41,0:18:37.45,Default,,0000,0000,0000,,Мен сені кешірсем де, мен ешнәрсе істеу үшін жолдан шығуға тура келмейді...
Dialogue: 0,0:18:37.45,0:18:41.15,Default,,0000,0000,0000,,- (Игараши) Ендеше, шығаруды тоқтатқан дұрыс.
Dialogue: 0,0:18:41.15,0:18:44.52,Default,,0000,0000,0000,,Бұл сөзді естігенде, әрине, жеңілдеп қалдым.
Dialogue: 0,0:18:44.52,0:18:48.72,Default,,0000,0000,0000,,Бірақ сіз әлі де қауесет айтқандай жақсысыз.
Dialogue: 0,0:18:48.72,0:18:50.74,Default,,0000,0000,0000,,Сыбыс? Иә
Dialogue: 0,0:18:50.74,0:18:56.47,Default,,0000,0000,0000,,Әрқашан студенттерді бірінші орынға қойып, әділ және ілтипатты болыңыз.
Dialogue: 0,0:18:56.47,0:18:59.83,Default,,0000,0000,0000,,Бұл өте джентльмен.
Dialogue: 0,0:18:59.83,0:19:02.02,Default,,0000,0000,0000,,Өйткені, нағыз атақты адамдар әртүрлі.
Dialogue: 0,0:19:02.02,0:19:04.38,Default,,0000,0000,0000,,Вахахаха!
Dialogue: 0,0:19:04.38,0:19:06.57,Default,,0000,0000,0000,,They're playing another prank!
Dialogue: 0,0:19:06.57,0:19:08.57,Default,,0000,0000,0000,,Балалар, тоқтаңдар!
Dialogue: 0,0:19:12.30,0:19:14.48,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:19:14.48,0:19:18.48,Default,,0000,0000,0000,,Сіз маған босқа жұмсалған физикалық күшімді оқуға жұмсаймын деп жатқан шығарсыз.
Dialogue: 0,0:19:19.37,0:19:22.40,Default,,0000,0000,0000,,<Мен төраға Игарашиді мүлдем ұмытып кеттім>
Dialogue: 0,0:19:22.40,0:19:24.42,Default,,0000,0000,0000,,（）
Dialogue: 0,0:19:24.42,0:19:29.13,Default,,0000,0000,0000,,Сұлулығымен қатар күштілігі де сенімді.
Dialogue: 0,0:19:29.13,0:19:33.00,Default,,0000,0000,0000,,Негізі кешірім сұраудан басқа мен бүгін тағы бір нәрсе сұрадым.
Dialogue: 0,0:19:33.00,0:19:36.86,Default,,0000,0000,0000,,Өйткені менің саған бір өтінішім бар еді ғой?
Dialogue: 0,0:19:36.86,0:19:38.88,Default,,0000,0000,0000,,Мисаки Аюзава
Dialogue: 0,0:19:38.88,0:19:41.88,Default,,0000,0000,0000,,Менің Миагаока студенттік кеңесіме қосыла аласыз ба?
Dialogue: 0,0:19:44.45,0:19:47.45,Default,,0000,0000,0000,,Иә? Эй
Dialogue: 0,0:19:50.68,0:19:53.04,Default,,0000,0000,0000,,Сіз не туралы айтып тұрсыз ...
Dialogue: 0,0:19:53.04,0:19:57.91,Default,,0000,0000,0000,,Мен оның басқа мектептің студенттер кеңесінде жұмыс істегенін естіген емеспін...
Dialogue: 0,0:19:57.91,0:19:59.76,Default,,0000,0000,0000,,Сізге тек аудару керек.
Dialogue: 0,0:19:59.76,0:20:02.46,Default,,0000,0000,0000,,Әрине, форма сияқты қажетті заттарды береміз.
Dialogue: 0,0:20:02.46,0:20:06.00,Default,,0000,0000,0000,,Жоқ, өкінішке орай, менің отбасым өте кедей.
Dialogue: 0,0:20:06.00,0:20:09.53,Default,,0000,0000,0000,,Масагаока сияқты оқу ақысы жоғары мектеп өте...
Dialogue: 0,0:20:09.53,0:20:11.55,Default,,0000,0000,0000,,（）
Dialogue: 0,0:20:11.55,0:20:14.08,Default,,0000,0000,0000,,Арнайы стипендиялар бар
Dialogue: 0,0:20:14.08,0:20:18.12,Default,,0000,0000,0000,,Егер сіз өте жақсы болсаңыз, толық қайтару босату мүмкіндігін алуыңыз мүмкін.
Dialogue: 0,0:20:18.12,0:20:20.48,Default,,0000,0000,0000,,Стипендия? иә?
Dialogue: 0,0:20:20.48,0:20:23.48,Default,,0000,0000,0000,,Мен бәріне кепілдік беремін.
Dialogue: 0,0:20:25.36,0:20:30.36,Default,,0000,0000,0000,,Мен байыптымын, төраға Аюзава.
Dialogue: 0,0:20:32.76,0:20:34.45,Default,,0000,0000,0000,,（）
Dialogue: 0,0:20:34.45,0:20:37.98,Default,,0000,0000,0000,,Мен сізден жақсы жауап күтемін.
Dialogue: 0,0:20:37.98,0:20:40.34,Default,,0000,0000,0000,,Төраға Игараши Күткендей, мен...
Dialogue: 0,0:20:40.34,0:20:42.53,Default,,0000,0000,0000,,Мисаки Аюзава
Dialogue: 0,0:20:42.53,0:20:44.88,Default,,0000,0000,0000,,Бұрынғы Сейка орта мектебі
Dialogue: 0,0:20:44.88,0:20:49.76,Default,,0000,0000,0000,,Атмосфераның дөрекі болғаны сонша, оны қазіргімен салыстыруға келмейді→
Dialogue: 0,0:20:49.76,0:20:51.45,Default,,0000,0000,0000,,Бірақ қазір студенттер кеңесі біртұтас →
Dialogue: 0,0:20:51.45,0:20:55.82,Default,,0000,0000,0000,,Біз мектебімізді жақсартуға тырысамыз.
Dialogue: 0,0:20:55.82,0:20:57.82,Default,,0000,0000,0000,,Бұл тамаша мектепке айналды.
Dialogue: 0,0:21:10.48,0:21:12.50,Default,,0000,0000,0000,,Ыстық! →
Dialogue: 0,0:21:12.50,0:21:15.53,Default,,0000,0000,0000,,Бұл нашар мектеп және кондиционер күткендей жұмыс істемейді→
Dialogue: 0,0:21:15.53,0:21:18.22,Default,,0000,0000,0000,,Бірақ... хахахаха→
Dialogue: 0,0:21:18.22,0:21:21.91,Default,,0000,0000,0000,,Бұл күлкілі лариат →
Dialogue: 0,0:21:21.91,0:21:23.77,Default,,0000,0000,0000,,Әлгі әйелдің лариясы бар →
Dialogue: 0,0:21:23.77,0:21:26.80,Default,,0000,0000,0000,,Мен оны соншалықты қызықты деп ойламадым.
Dialogue: 0,0:21:26.80,0:21:28.82,Default,,0000,0000,0000,,Мисаки Аюзава ұнады
Dialogue: 0,0:21:28.82,0:21:30.34,Default,,0000,0000,0000,,Мен бұл жерден істің қалай болатынын асыға күтемін.
Dialogue: 0,0:21:30.34,0:21:32.36,Default,,0000,0000,0000,,Маки (Маки) Иә
Dialogue: 0,0:21:32.36,0:21:35.56,Default,,0000,0000,0000,,（）
Dialogue: 0,0:21:35.56,0:21:37.56,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:39.10,0:21:41.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:41.12,0:21:43.14,Default,,0000,0000,0000,,Әйелдер күні кіре алмайсыз.
Dialogue: 0,0:21:43.14,0:21:46.14,Default,,0000,0000,0000,,Мен тұманды әйнектен көрінбеймін.
Dialogue: 0,0:21:48.36,0:21:51.36,Default,,0000,0000,0000,,Қош келдіңіз, жас ханым.
Dialogue: 0,0:21:55.43,0:21:58.12,Default,,0000,0000,0000,,Мен сізге орныңызды көрсетуге рұқсат етіңіз.
Dialogue: 0,0:21:58.12,0:22:00.12,Default,,0000,0000,0000,,Иә иә
Dialogue: 0,0:22:01.15,0:22:03.15,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:22:06.70,0:22:09.40,Default,,0000,0000,0000,,Сақ болыңыз, жас ханым.
Dialogue: 0,0:22:09.40,0:22:12.40,Default,,0000,0000,0000,,Өте керемет~ Мисаки-кун
Dialogue: 0,0:22:13.27,0:22:16.47,Default,,0000,0000,0000,,Миса-чан күткендей, табиғи материалдар
Dialogue: 0,0:22:16.47,0:22:20.67,Default,,0000,0000,0000,,Бұл жоба тек Миса Чанның арқасында мүмкін болды.
Dialogue: 0,0:22:20.67,0:22:23.04,Default,,0000,0000,0000,,Мен әрқашан жас ханымды сізге ғашық етемін~
Dialogue: 0,0:22:23.04,0:22:25.06,Default,,0000,0000,0000,,Тш, мен бақыттымын.
Dialogue: 0,0:22:25.06,0:22:29.43,Default,,0000,0000,0000,,Ойланып қарасам, мен қыздарға толы ортада ешқашан болған емеспін.
Dialogue: 0,0:22:29.43,0:22:31.45,Default,,0000,0000,0000,,Бұл қызық болуы мүмкін
Dialogue: 0,0:22:31.45,0:22:33.47,Default,,0000,0000,0000,,Мисаки-кун, көңілді жүрген сияқтысың.
Dialogue: 0,0:22:33.47,0:22:37.34,Default,,0000,0000,0000,,Сонда сіз танымал болғаныңызда, әйел әйелге айналады ма?
Dialogue: 0,0:22:37.34,0:22:41.22,Default,,0000,0000,0000,,Бұл тітіркендіргіш. Мен қазірдің өзінде адаммын, бірақ...
Dialogue: 0,0:22:41.22,0:22:45.22,Default,,0000,0000,0000,,Өзгелерге танылған жақсы сезінеді.
Dialogue: 0,0:22:46.10,0:22:51.81,Default,,0000,0000,0000,,Барлық еркектер осылай болса, мен тым болмаса мойындар едім.
Dialogue: 0,0:22:51.81,0:22:54.68,Default,,0000,0000,0000,,Бұл не? Сондықтан әйелдерге мейірімді болыңыз
Dialogue: 0,0:22:54.68,0:22:57.87,Default,,0000,0000,0000,,Сенімді және джентльмен болыңыз.
Dialogue: 0,0:22:57.87,0:22:59.89,Default,,0000,0000,0000,,Мен ше? Жоқ
Dialogue: 0,0:22:59.89,0:23:03.44,Default,,0000,0000,0000,,Сонда сен Миягаоканың президенті сияқтысың ба?
Dialogue: 0,0:23:03.44,0:23:07.98,Default,,0000,0000,0000,,Төраға Игарашидің әңгімесі неліктен шығады?
Dialogue: 0,0:23:07.98,0:23:10.98,Default,,0000,0000,0000,,Ендеше, сөзіңді қойып, жұмысыңды істей бер.
Dialogue: 0,0:23:16.40,0:23:18.92,Default,,0000,0000,0000,,Тапсырыс беруге дайынсыз ба?
Dialogue: 0,0:23:18.92,0:23:20.11,Default,,0000,0000,0000,,Әлі абдырап қалды~
Dialogue: 0,0:23:20.11,0:23:23.14,Default,,0000,0000,0000,,Олай болса бірге шешейік.
Dialogue: 0,0:23:23.14,0:23:25.16,Default,,0000,0000,0000,,Мисаки-кун өте керемет
Dialogue: 0,0:23:25.16,0:23:29.69,Default,,0000,0000,0000,,Сендей ағам болса ғой. Мен құрметтемін.
Dialogue: 0,0:23:29.69,0:23:32.72,Default,,0000,0000,0000,,Бірақ Мисаки-кун сіз ойлағаннан да кіші іні кейіпкері болуы мүмкін.
Dialogue: 0,0:23:32.72,0:23:35.59,Default,,0000,0000,0000,,Бұл тым көп оқу, солай емес пе? Бұл ақыр соңында шабуыл.
Dialogue: 0,0:23:35.59,0:23:39.62,Default,,0000,0000,0000,,А, бірақ шақыруды қабылдаудан бас тартқыңыз келмейді, солай ма?
Dialogue: 0,0:23:39.62,0:23:41.62,Default,,0000,0000,0000,,Ол Киригумо-суги деп аталатын өте жеңіл ағаш түрінен жасалған
Dialogue: 0,0:23:44.52,0:23:47.52,Default,,0000,0000,0000,,Онда мен мынаны ұсынамын.
Dialogue: 0,0:23:48.72,0:23:51.25,Default,,0000,0000,0000,,Не? Бұл менің сүйікті мәзірім ме?
Dialogue: 0,0:23:51.25,0:23:53.27,Default,,0000,0000,0000,,Иә, мен үшін бе?
Dialogue: 0,0:23:53.27,0:23:55.46,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:23:55.46,0:23:59.46,Default,,0000,0000,0000,,Мен ояндым Мисаки оянды
Dialogue: 0,0:24:00.00,0:24:02.36,Default,,0000,0000,0000,,Өйткені, қыздар сүйкімді~
Dialogue: 0,0:24:02.36,0:24:05.88,Default,,0000,0000,0000,,Ер адамдарда жоқ тазалық пен махаббат
Dialogue: 0,0:24:05.88,0:24:08.08,Default,,0000,0000,0000,,Ертеңнен бастап еркек болып киіне аламын ба, тіпті мен болсам да.
Dialogue: 0,0:24:08.08,0:24:12.79,Default,,0000,0000,0000,,Тағы не? Шабуыл? Сіз шақыруды қабылдадыңыз ба?
Dialogue: 0,0:24:12.79,0:24:14.79,Default,,0000,0000,0000,,Оның нені білдіретінін білесіз бе?
Dialogue: 0,0:24:15.66,0:24:17.34,Default,,0000,0000,0000,,Do you want me to tell you?
Dialogue: 0,0:24:17.34,0:24:19.53,Default,,0000,0000,0000,,Сіз не ұшып бара жатырсыз?
Dialogue: 0,0:24:19.53,0:24:22.39,Default,,0000,0000,0000,,Мен терлеп кеттім, көйлегімді шешкім келді.
Dialogue: 0,0:24:22.39,0:24:25.75,Default,,0000,0000,0000,,Мисаки-кун, неге тез киіміңді ауыстырмайсың?
Dialogue: 0,0:24:25.75,0:24:27.94,Default,,0000,0000,0000,,Сіз қайтып келген соң, мен
Dialogue: 0,0:24:27.94,0:24:31.81,Default,,0000,0000,0000,,Неліктен ерлердің жалаңаш болғаны дұрыс?
Dialogue: 0,0:24:31.81,0:24:33.81,Default,,0000,0000,0000,,Барлығы келеді...
Dialogue: 0,0:24:34.51,0:24:37.51,Default,,0000,0000,0000,,Не болды? Тезірек киімдеріңді шешіңдер!
Dialogue: 0,0:24:39.06,0:24:43.93,Default,,0000,0000,0000,,Неге оны шешуге рұқсат бермейсің? Мисаки-кун
Dialogue: 0,0:24:43.93,0:24:45.78,Default,,0000,0000,0000,,Осы дүкеннен қанша адам ғайып болды екен?
Dialogue: 0,0:24:45.78,0:24:49.78,Default,,0000,0000,0000,,Қараңызшы, Аюзава – әйел.
Dialogue: 0,0:24:51.52,0:24:55.52,Default,,0000,0000,0000,,Шабуыл деген осыны білдірсе керек.
Dialogue: 0,0:24:56.06,0:24:58.06,Default,,0000,0000,0000,,Сабыр етіңіз.
Dialogue: 0,0:25:00.27,0:25:04.81,Default,,0000,0000,0000,,Сізді қанағаттандыру үшін менде қаншалықты шатасуы керек?
Dialogue: 0,0:25:04.81,0:25:08.81,Default,,0000,0000,0000,,...
Dialogue: 0,0:25:18.29,0:25:22.29,Default,,0000,0000,0000,,Төраға Мисаки Аюзава туралы есеп
Dialogue: 0,0:25:26.87,0:25:30.73,Default,,0000,0000,0000,,Ха ха ха ха ха Бұл не?
Dialogue: 0,0:25:30.73,0:25:33.73,Default,,0000,0000,0000,,Иә, бұл шынымен де ең жақсы әйел.
Dialogue: 0,0:25:35.46,0:25:41.46,Default,,0000,0000,0000,,Сізге рахмет, мен ең көңілді сәлемдесу шарасын ойлап таптым.
Dialogue: 0,0:25:43.37,0:26:28.37,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:29.99,0:27:12.09,Default,,0000,0000,0000,,
Dialogue: 0,0:27:13.59,0:27:19.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory