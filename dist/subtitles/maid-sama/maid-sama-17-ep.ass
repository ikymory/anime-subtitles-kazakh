Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:01.15,0:02:29.15,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:30.37,0:02:39.13,Default,,0000,0000,0000,,
Dialogue: 0,0:03:44.11,0:03:49.49,Default,,0000,0000,0000,,Қытырлақ Қытырлақ Қытырлақ Қытырлақ
Dialogue: 0,0:03:49.49,0:03:52.02,Default,,0000,0000,0000,,Қытырлақ қытырлақ қарлығаш
Dialogue: 0,0:03:52.02,0:03:55.89,Default,,0000,0000,0000,,Ойлап қарасам, мен лотереяда шетелге жолдама ұтып алдым.
Dialogue: 0,0:03:55.89,0:03:58.92,Default,,0000,0000,0000,,Бірақ төлқұжат – азап.
Dialogue: 0,0:03:58.92,0:04:01.95,Default,,0000,0000,0000,,Қалта ақшаңызды да өзіңіз дайындауыңыз керек.
Dialogue: 0,0:04:01.95,0:04:04.95,Default,,0000,0000,0000,,Мен оны басқа клуб мүшесіне бердім.
Dialogue: 0,0:04:07.18,0:04:10.87,Default,,0000,0000,0000,,Қарбызбен пісірілген күріш
Dialogue: 0,0:04:10.87,0:04:12.87,Default,,0000,0000,0000,,Мен оны қолданып көруім керек пе?
Dialogue: 0,0:04:14.57,0:04:16.57,Default,,0000,0000,0000,,Тоқтау керек.
Dialogue: 0,0:04:30.07,0:04:33.43,Default,,0000,0000,0000,,〈(Мисаки) менеджердің әпкесі〉
Dialogue: 0,0:04:33.43,0:04:36.63,Default,,0000,0000,0000,,<Біз Нагиса-санның дүкеніне жайлы саяхатқа келдік>
Dialogue: 0,0:04:36.63,0:04:39.66,Default,,0000,0000,0000,,〈Бірінші күн қандай да бір шумен аяқталды〉
Dialogue: 0,0:04:39.66,0:04:42.35,Default,,0000,0000,0000,,<Екінші күннің таңы келді>
Dialogue: 0,0:04:42.35,0:04:44.37,Default,,0000,0000,0000,,〈Алайда〉
Dialogue: 0,0:04:44.37,0:04:47.41,Default,,0000,0000,0000,,〈Барлығы өте кешке дейін қуанды〉
Dialogue: 0,0:04:47.41,0:04:50.27,Default,,0000,0000,0000,,〈Таңғы болды, дәлірек айтсақ түске дейін...〉
Dialogue: 0,0:04:50.27,0:04:52.96,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:52.96,0:04:55.96,Default,,0000,0000,0000,,Қайырлы таң Миса Чан
Dialogue: 0,0:04:56.00,0:04:59.00,Default,,0000,0000,0000,,О
Dialogue: 0,0:05:01.37,0:05:03.37,Default,,0000,0000,0000,,Қайырлы таң Усуй
Dialogue: 0,0:05:09.45,0:05:11.47,Default,,0000,0000,0000,,(Усуи есінеу)
Dialogue: 0,0:05:11.47,0:05:13.47,Default,,0000,0000,0000,,<Гипотензия? 〉
Dialogue: 0,0:05:25.78,0:05:27.78,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:28.15,0:05:31.34,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Миса Чан
Dialogue: 0,0:05:31.34,0:05:33.03,Default,,0000,0000,0000,,Бұл оятқыш, оған алаңдамаңыз.
Dialogue: 0,0:05:33.03,0:05:37.74,Default,,0000,0000,0000,,Оянудың орнына, мәңгілік ұйықтайтын сияқты.
Dialogue: 0,0:05:37.74,0:05:40.10,Default,,0000,0000,0000,,Не айтып тұрсың, Усуй, мен бірдеңені түсінбеймін...
Dialogue: 0,0:05:40.10,0:05:44.47,Default,,0000,0000,0000,,→
Dialogue: 0,0:05:44.47,0:05:46.49,Default,,0000,0000,0000,,Тағы да солай киін
Dialogue: 0,0:05:46.49,0:05:49.49,Default,,0000,0000,0000,,Бұлай киіну мен үшін табиғи нәрсе.
Dialogue: 0,0:05:51.21,0:05:54.57,Default,,0000,0000,0000,,Иә, иә, мен мұны көп естідім.
Dialogue: 0,0:05:54.57,0:05:56.26,Default,,0000,0000,0000,,Хун
Dialogue: 0,0:05:56.26,0:05:59.62,Default,,0000,0000,0000,,Жарайды, солай киін.
Dialogue: 0,0:05:59.62,0:06:01.81,Default,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:06:01.81,0:06:05.81,Default,,0000,0000,0000,,Бүгінгі жағажай волейболынан турнирді жеңіп алсам ше?
Dialogue: 0,0:06:07.37,0:06:09.23,Default,,0000,0000,0000,,Сіз мені шынымен босатасыз ба?
Dialogue: 0,0:06:09.23,0:06:13.59,Default,,0000,0000,0000,,Сіз бұл түрге шағымданбайсыз, тіпті парикіңізді де шешпейсіз бе?
Dialogue: 0,0:06:13.59,0:06:16.79,Default,,0000,0000,0000,,Иә, қазір үйге бара аласыз.
Dialogue: 0,0:06:16.79,0:06:19.82,Default,,0000,0000,0000,,Күнге күйгенді ұнатпайсыз, солай ма? Иә
Dialogue: 0,0:06:19.82,0:06:22.69,Default,,0000,0000,0000,,Жағажай волейболын ер адамдай ұтсаң
Dialogue: 0,0:06:22.69,0:06:26.73,Default,,0000,0000,0000,,Сіздің ағаңыз (Аойдың әкесі) сәл келісетініне сенімдімін.
Dialogue: 0,0:06:26.73,0:06:28.75,Default,,0000,0000,0000,,Нагиса-сан
Dialogue: 0,0:06:28.75,0:06:31.78,Default,,0000,0000,0000,,Рахмет Нағиса-сан, қолымыздан келгеннің бәрін бірге жасайық.
Dialogue: 0,0:06:31.78,0:06:34.47,Default,,0000,0000,0000,,А, сен не айтып тұрсың?
Dialogue: 0,0:06:34.47,0:06:37.67,Default,,0000,0000,0000,,Не? Турнир ерлер мен әйелдер жұбы, солай ма? Бұл дұрыс
Dialogue: 0,0:06:37.67,0:06:40.70,Default,,0000,0000,0000,,Нагиса-сан, сен менімен бірлесесің, солай ма? →
Dialogue: 0,0:06:40.70,0:06:43.73,Default,,0000,0000,0000,,Өткен жылғы чемпионмен жұптассаңыз, жеңе аласыз...
Dialogue: 0,0:06:43.73,0:06:46.59,Default,,0000,0000,0000,,Керемет, Нағиса-сан, сен жеңдің!
Dialogue: 0,0:06:46.59,0:06:48.78,Default,,0000,0000,0000,,（）
Dialogue: 0,0:06:48.78,0:06:51.81,Default,,0000,0000,0000,,Осы жылдан бастап жас шектеуі болады, сондықтан мен қатыса алмаймын.
Dialogue: 0,0:06:51.81,0:06:54.34,Default,,0000,0000,0000,,Ендеше, серігіңді таб!
Dialogue: 0,0:06:54.34,0:06:57.70,Default,,0000,0000,0000,,Иә~ Бұл мүмкін емес.
Dialogue: 0,0:06:57.70,0:07:00.23,Default,,0000,0000,0000,,Бұл жерде менің достарым жоқ.
Dialogue: 0,0:07:00.23,0:07:04.23,Default,,0000,0000,0000,,Мүмкін емес пе? Мен оңай бас тарта аламын
Dialogue: 0,0:07:05.78,0:07:07.14,Default,,0000,0000,0000,,Олай болса, солай қалдырыңыз.
Dialogue: 0,0:07:07.14,0:07:10.14,Default,,0000,0000,0000,,Осы жазда адам сияқты жұмыс істейік
Dialogue: 0,0:07:11.35,0:07:13.35,Default,,0000,0000,0000,,Мен берілмеймін!
Dialogue: 0,0:07:15.38,0:07:17.90,Default,,0000,0000,0000,,Бұл оңай емес.
Dialogue: 0,0:07:17.90,0:07:20.43,Default,,0000,0000,0000,,Мен оны үнемі ұстандым
Dialogue: 0,0:07:20.43,0:07:23.30,Default,,0000,0000,0000,,Адамдар оны оғаш немесе жиіркенішті деп ойласа да
Dialogue: 0,0:07:23.30,0:07:25.15,Default,,0000,0000,0000,,Өйткені бұл менмін!
Dialogue: 0,0:07:25.15,0:07:29.15,Default,,0000,0000,0000,,Өйткені сен өзіңнің ең шынайы нұсқасысың!
Dialogue: 0,0:07:30.70,0:07:32.70,Default,,0000,0000,0000,,Басқа адамды табыңыз
Dialogue: 0,0:07:37.60,0:07:40.80,Default,,0000,0000,0000,,Мен ер бала емеспін
Dialogue: 0,0:07:40.80,0:07:42.80,Default,,0000,0000,0000,,Аои-чан...
Dialogue: 0,0:07:50.07,0:07:54.44,Default,,0000,0000,0000,,<Бірақ жағажай волейболын ойнай алатын қыздар бар>
Dialogue: 0,0:07:54.44,0:07:56.79,Default,,0000,0000,0000,,〈Оңай...〉
Dialogue: 0,0:07:56.79,0:07:59.32,Default,,0000,0000,0000,,Хаа…
Dialogue: 0,0:07:59.32,0:08:01.34,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:08:01.34,0:08:03.03,Default,,0000,0000,0000,,(Мисаки ызылдап)
Dialogue: 0,0:08:03.03,0:08:06.89,Default,,0000,0000,0000,,Аа, бұл дұрыс болды.
Dialogue: 0,0:08:06.89,0:08:10.43,Default,,0000,0000,0000,,Мен теңіз спортымен айналысқым келеді.
Dialogue: 0,0:08:10.43,0:08:13.43,Default,,0000,0000,0000,,Аои-чан, маған бірдеңе айта аласың ба?
Dialogue: 0,0:08:14.64,0:08:17.34,Default,,0000,0000,0000,,Миса-чан, сен жағажай волейболынан турнирге қатысасың ба?
Dialogue: 0,0:08:17.34,0:08:20.70,Default,,0000,0000,0000,,Мен сенің жеңіп, жағажай ханшайымы болғаныңды қалаймын →
Dialogue: 0,0:08:20.70,0:08:22.72,Default,,0000,0000,0000,,Сәттілік тілеймін!
Dialogue: 0,0:08:22.72,0:08:24.72,Default,,0000,0000,0000,,Жағажай ханшайымы?
Dialogue: 0,0:08:25.92,0:08:27.77,Default,,0000,0000,0000,,Сіз білмейсіз бе? иә
Dialogue: 0,0:08:27.77,0:08:30.46,Default,,0000,0000,0000,,Жеңіске жеткен ер-әйел жұбы
Dialogue: 0,0:08:30.46,0:08:33.49,Default,,0000,0000,0000,,Бұл кешкі фестивальде ханзада мен ханшайым→
Dialogue: 0,0:08:33.49,0:08:36.19,Default,,0000,0000,0000,,Бұл салтанатты түрде атап өтілді және естелік фотосуреттерге сұраныс жоғары болды→
Dialogue: 0,0:08:36.19,0:08:39.72,Default,,0000,0000,0000,,Фотосессияға түрлі костюмдер дайындалды →
Dialogue: 0,0:08:39.72,0:08:42.75,Default,,0000,0000,0000,,Қалағаныңызша сүйкімді бикини киюге болады.
Dialogue: 0,0:08:42.75,0:08:45.29,Default,,0000,0000,0000,,Түсіндім, бұл мені қызықтырмайды.
Dialogue: 0,0:08:45.29,0:08:48.82,Default,,0000,0000,0000,,Бірақ бәсекелестікке келетін болсақ, ұран – байыпты болу.
Dialogue: 0,0:08:48.82,0:08:51.84,Default,,0000,0000,0000,,Сіз жеңесіз.
Dialogue: 0,0:08:51.84,0:08:54.21,Default,,0000,0000,0000,,Ал, мен қазір Аои Чанмен жаттығуға барамын.
Dialogue: 0,0:08:54.21,0:08:58.21,Default,,0000,0000,0000,,Иә, сен Аои Чанмен бірге шығасың ба?
Dialogue: 0,0:09:04.81,0:09:06.16,Default,,0000,0000,0000,,Миса-чан
Dialogue: 0,0:09:06.16,0:09:08.35,Default,,0000,0000,0000,,Бұл не, Усуй?
Dialogue: 0,0:09:08.35,0:09:11.88,Default,,0000,0000,0000,,Сіздің тәжірибеңіз бар ма? жағажай волейболы
Dialogue: 0,0:09:11.88,0:09:13.73,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:09:13.73,0:09:16.09,Default,,0000,0000,0000,,Бұл жабық волейболдан мүлде бөлек.
Dialogue: 0,0:09:16.09,0:09:20.80,Default,,0000,0000,0000,,Менің ойымша, құмды жағажайда жүру өте қиын болар еді.
Dialogue: 0,0:09:20.80,0:09:23.33,Default,,0000,0000,0000,,Сіз өте сенімді сияқтысыз.
Dialogue: 0,0:09:23.33,0:09:25.51,Default,,0000,0000,0000,,Сенімділік?
Dialogue: 0,0:09:25.51,0:09:28.51,Default,,0000,0000,0000,,Жоқ, бұл сенімділік немесе рух деп ойлаймын. Мүмкін менде сенім жоқ шығар.
Dialogue: 0,0:09:29.72,0:09:33.43,Default,,0000,0000,0000,,Иә, мен міндетті түрде жеңемін, тек рух.
Dialogue: 0,0:09:33.43,0:09:35.78,Default,,0000,0000,0000,,Аоидың көзі
Dialogue: 0,0:09:35.78,0:09:38.48,Default,,0000,0000,0000,,Сол байсалды көздерді көргенде
Dialogue: 0,0:09:38.48,0:09:41.34,Default,,0000,0000,0000,,Мен сізге қолдау көрсеткім келеді.
Dialogue: 0,0:09:41.34,0:09:45.72,Default,,0000,0000,0000,,Жарайды, менің тәжірибем жоқ, сондықтан пайдалы ма, жоқ па білмеймін.
Dialogue: 0,0:09:45.72,0:09:49.59,Default,,0000,0000,0000,,Сонда Аюзава болмаса жақсы болмас па еді?
Dialogue: 0,0:09:49.59,0:09:52.59,Default,,0000,0000,0000,,Не? Барма, Аюзава
Dialogue: 0,0:09:58.01,0:10:01.71,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Сіз түсінбейсіз.
Dialogue: 0,0:10:01.71,0:10:03.71,Default,,0000,0000,0000,,Мен қазір кетемін!
Dialogue: 0,0:10:12.48,0:10:14.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:15.68,0:10:18.68,Default,,0000,0000,0000,,Күте тұрыңыз, кеш болды.
Dialogue: 0,0:10:19.06,0:10:21.08,Default,,0000,0000,0000,,（）
Dialogue: 0,0:10:21.08,0:10:24.08,Default,,0000,0000,0000,,Иә, қош келдіңіз.
Dialogue: 0,0:10:26.29,0:10:29.32,Default,,0000,0000,0000,,→
Dialogue: 0,0:10:29.32,0:10:32.02,Default,,0000,0000,0000,,Shiraizengahama ұйымдастырған Viva Royal жағажай волейбол турнирі! →
Dialogue: 0,0:10:32.02,0:10:35.71,Default,,0000,0000,0000,,Жау тек қарсылас емес →
Dialogue: 0,0:10:35.71,0:10:39.92,Default,,0000,0000,0000,,Жарқыраған күн, қозғалысты қиындатқан құмды жағажай, соққан желмен күресу→
Dialogue: 0,0:10:39.92,0:10:42.62,Default,,0000,0000,0000,,Турнирде командалық ойын арқылы жеңіске жету →
Dialogue: 0,0:10:42.62,0:10:45.99,Default,,0000,0000,0000,,Бүгінгі кешкі фестивальдің жұлдыздары жағажайдың ханзадасы мен ханшайымы болады→
Dialogue: 0,0:10:45.99,0:10:47.17,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:10:47.17,0:10:50.86,Default,,0000,0000,0000,,Биылғы жылы да бәрімізге қуаныш сыйлайық!
Dialogue: 0,0:10:50.86,0:10:52.88,Default,,0000,0000,0000,,Міне, осында.
Dialogue: 0,0:10:52.88,0:10:55.58,Default,,0000,0000,0000,,Миса-чан мен Аои-чан ше?
Dialogue: 0,0:10:55.58,0:10:58.58,Default,,0000,0000,0000,,Мен жаңа ғана жаттығуға шықтым.
Dialogue: 0,0:11:01.14,0:11:04.14,Default,,0000,0000,0000,,Сіз міндетті түрде жеңесіз!
Dialogue: 0,0:11:06.35,0:11:10.73,Default,,0000,0000,0000,,Бұл Миса Чан мен Аои Чан... дұрыс па?
Dialogue: 0,0:11:10.73,0:11:14.43,Default,,0000,0000,0000,,...
Dialogue: 0,0:11:14.43,0:11:17.43,Default,,0000,0000,0000,,Қандай жаттығу түрі?
Dialogue: 0,0:11:29.58,0:11:32.28,Default,,0000,0000,0000,,Шүкір, менің уақытым мүлдем болмады.
Dialogue: 0,0:11:32.28,0:11:34.47,Default,,0000,0000,0000,,Бірақ мен жеңемін
Dialogue: 0,0:11:34.47,0:11:37.47,Default,,0000,0000,0000,,Аои-чанның байыптылығы анық айтылды.
Dialogue: 0,0:11:39.52,0:11:41.21,Default,,0000,0000,0000,,Хмф, кеттік, Мисакичи!
Dialogue: 0,0:11:41.21,0:11:43.73,Default,,0000,0000,0000,,Мисакичи?
Dialogue: 0,0:11:43.73,0:11:45.75,Default,,0000,0000,0000,,...
Dialogue: 0,0:11:45.75,0:11:48.44,Default,,0000,0000,0000,,Не, сен сонша оттайсың ба?
Dialogue: 0,0:11:48.44,0:11:50.63,Default,,0000,0000,0000,,Эрика
Dialogue: 0,0:11:50.63,0:11:52.82,Default,,0000,0000,0000,,...және Усуй
Dialogue: 0,0:11:52.82,0:11:54.17,Default,,0000,0000,0000,,Екеуің мұнда неге келдіңдер?
Dialogue: 0,0:11:54.17,0:11:57.20,Default,,0000,0000,0000,,Миса-чанның шығатынын естігенде мен де көрінгім келді.
Dialogue: 0,0:11:57.20,0:12:00.07,Default,,0000,0000,0000,,Мен Усуйкуннан сұрадым, ол маған жарайды.
Dialogue: 0,0:12:00.07,0:12:03.10,Default,,0000,0000,0000,,Жағажай волейболы Маған ұнайды, себебі ол қызық.
Dialogue: 0,0:12:03.10,0:12:07.80,Default,,0000,0000,0000,,Жарайды, Усуй, сен шынымен мотивация аласың ба?
Dialogue: 0,0:12:07.80,0:12:09.80,Default,,0000,0000,0000,,Мәселе бұл емес.
Dialogue: 0,0:12:11.50,0:12:13.50,Default,,0000,0000,0000,,Мен чемпионатты аламын.
Dialogue: 0,0:12:16.55,0:12:19.55,Default,,0000,0000,0000,,Менің қалағаным осы, Конояро!
Dialogue: 0,0:12:20.26,0:12:24.97,Default,,0000,0000,0000,,
Dialogue: 0,0:13:37.87,0:13:40.56,Default,,0000,0000,0000,,Конояро!
Dialogue: 0,0:13:40.56,0:13:43.59,Default,,0000,0000,0000,,...
Dialogue: 0,0:13:43.59,0:13:45.59,Default,,0000,0000,0000,,Үйден қашқандарды да қоса алғанда.
Dialogue: 0,0:13:49.65,0:13:51.50,Default,,0000,0000,0000,,Желді оқы!
Dialogue: 0,0:13:51.50,0:13:54.20,Default,,0000,0000,0000,,Құмға жеңіліп қалмаңыз! Конояро!
Dialogue: 0,0:13:54.20,0:13:56.20,Default,,0000,0000,0000,,Дрят
Dialogue: 0,0:13:57.73,0:13:59.73,Default,,0000,0000,0000,,...
Dialogue: 0,0:14:04.80,0:14:08.51,Default,,0000,0000,0000,,Кел, Конояро!
Dialogue: 0,0:14:08.51,0:14:10.36,Default,,0000,0000,0000,,Әлде сенбейсің бе?
Dialogue: 0,0:14:10.36,0:14:12.36,Default,,0000,0000,0000,,Конояро!
Dialogue: 0,0:14:13.06,0:14:16.06,Default,,0000,0000,0000,,
Dialogue: 0,0:14:17.26,0:14:20.80,Default,,0000,0000,0000,,...
Dialogue: 0,0:14:20.80,0:14:22.82,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:14:22.82,0:14:25.18,Default,,0000,0000,0000,,Бұл екеуі керемет емес пе?
Dialogue: 0,0:14:25.18,0:14:29.72,Default,,0000,0000,0000,,Сіз жеңген сайын қарсыласыңыздың күресуге деген ынтасын жоғалтасыз...
Dialogue: 0,0:14:29.72,0:14:32.41,Default,,0000,0000,0000,,Мұны жасамаңыз
Dialogue: 0,0:14:32.41,0:14:34.43,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:34.43,0:14:37.43,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:14:42.02,0:14:45.54,Default,,0000,0000,0000,,Даму күтілгендей.
Dialogue: 0,0:14:45.54,0:14:47.54,Default,,0000,0000,0000,,Егер сіз мұны жеңіп алсаңыз, сіз бос боласыз.
Dialogue: 0,0:14:48.74,0:14:51.74,Default,,0000,0000,0000,,Айналада көп заттар бар.
Dialogue: 0,0:14:57.83,0:15:00.83,Default,,0000,0000,0000,,Әй, Усуй, ұстанба!
Dialogue: 0,0:15:05.58,0:15:07.60,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:15:07.60,0:15:10.46,Default,,0000,0000,0000,,Шынымен, сен неге қатыстың?
Dialogue: 0,0:15:10.46,0:15:15.84,Default,,0000,0000,0000,,〈Ол Аои Чанның еркіне қауіп төніп тұрғанын білуі керек〉
Dialogue: 0,0:15:15.84,0:15:18.37,Default,,0000,0000,0000,,Қызық, қайсысы биылғы ханшайым болады?
Dialogue: 0,0:15:18.37,0:15:21.40,Default,,0000,0000,0000,,Маған бұл сексуалды қыз ұнайды.
Dialogue: 0,0:15:21.40,0:15:24.60,Default,,0000,0000,0000,,Баркер, сенің жігітің бар, солай ма?
Dialogue: 0,0:15:24.60,0:15:27.46,Default,,0000,0000,0000,,Одан гөрі ана жақтағы қыз нысана болуы керек →
Dialogue: 0,0:15:27.46,0:15:31.46,Default,,0000,0000,0000,,Жұптың серіктесі сенің інің бе? Жігітке ұқсамайды
Dialogue: 0,0:15:32.18,0:15:35.21,Default,,0000,0000,0000,,〈Мүмкін Усуйдің бірі, күшті жұпты сындырыңыз〉
Dialogue: 0,0:15:35.21,0:15:39.25,Default,,0000,0000,0000,,<Аои-чанның финалда жеңуіне мүмкіндік беру үшін бе? 〉
Dialogue: 0,0:15:39.25,0:15:42.12,Default,,0000,0000,0000,,〈Жоқ, бірақ солай...〉
Dialogue: 0,0:15:42.12,0:15:45.64,Default,,0000,0000,0000,,〈Мүмкін солай шығар? 〉
Dialogue: 0,0:15:45.64,0:15:48.85,Default,,0000,0000,0000,,〈Себебі ол әрқашан...''
Dialogue: 0,0:15:48.85,0:15:51.85,Default,,0000,0000,0000,,...
Dialogue: 0,0:16:05.84,0:16:07.84,Default,,0000,0000,0000,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:16:08.71,0:16:10.89,Default,,0000,0000,0000,,Ах! Ах!
Dialogue: 0,0:16:10.89,0:16:12.75,Default,,0000,0000,0000,,
Dialogue: 0,0:16:12.75,0:16:15.75,Default,,0000,0000,0000,,＆ １
Dialogue: 0,0:16:16.79,0:16:18.81,Default,,0000,0000,0000,,Пайдасы жоқ.
Dialogue: 0,0:16:18.81,0:16:20.83,Default,,0000,0000,0000,,Мен аңғал болдым
Dialogue: 0,0:16:20.83,0:16:24.83,Default,,0000,0000,0000,,Усуй жігіті жеңіске шындап ұмтылуда.
Dialogue: 0,0:16:25.21,0:16:28.57,Default,,0000,0000,0000,,Реттелетін жылдамдық
Dialogue: 0,0:16:28.57,0:16:30.76,Default,,0000,0000,0000,,Ол өте талантты.
Dialogue: 0,0:16:30.76,0:16:33.76,Default,,0000,0000,0000,,２
Dialogue: 0,0:16:35.47,0:16:37.66,Default,,0000,0000,0000,,Бітім, бұл не?
Dialogue: 0,0:16:37.66,0:16:41.53,Default,,0000,0000,0000,,Мен мүлдем тыныс алмаймын. Мен жай ғана лақтырып жатырмын.
Dialogue: 0,0:16:41.53,0:16:44.23,Default,,0000,0000,0000,,Мен ұнамайтын нәрселердің бәрін тастаймын.
Dialogue: 0,0:16:44.23,0:16:46.26,Default,,0000,0000,0000,,Бірақ мен берілмеймін!
Dialogue: 0,0:16:46.26,0:16:49.45,Default,,0000,0000,0000,,Аои-чан...
Dialogue: 0,0:16:49.45,0:16:51.45,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:55.51,0:16:57.53,Default,,0000,0000,0000,,Ах! Ах!
Dialogue: 0,0:16:57.53,0:16:59.38,Default,,0000,0000,0000,,<Мен сені жеймін! 〉
Dialogue: 0,0:16:59.38,0:17:04.43,Default,,0000,0000,0000,,<Осымен де Нағиса-сан мені көптен бері қорқытып жүр! 〉
Dialogue: 0,0:17:04.43,0:17:06.43,Default,,0000,0000,0000,,Аои-чан!
Dialogue: 0,0:17:08.30,0:17:11.30,Default,,0000,0000,0000,,Ah~ жақсы бақылау
Dialogue: 0,0:17:16.38,0:17:18.38,Default,,0000,0000,0000,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:17:22.12,0:17:26.12,Default,,0000,0000,0000,,〈Аои Чан қатты жұмыс істеп жатыр〉
Dialogue: 0,0:17:36.75,0:17:41.75,Default,,0000,0000,0000,,〈Онымен ойнап жүргендей ауыр сезім, сырласу〉
Dialogue: 0,0:17:44.00,0:17:47.20,Default,,0000,0000,0000,,<Әрқашан, әрқашан, дегенмен>
Dialogue: 0,0:17:47.20,0:17:51.20,Default,,0000,0000,0000,,〈Төтенше жағдайда мен сізге көмекке келемін〉
Dialogue: 0,0:17:55.44,0:17:58.44,Default,,0000,0000,0000,,<Оны жақсы жігіт деп ойласа да>
Dialogue: 0,0:18:02.51,0:18:05.54,Default,,0000,0000,0000,,〈Ең ренжітетін нәрсе! 〉
Dialogue: 0,0:18:05.54,0:18:08.54,Default,,0000,0000,0000,,Неліктен Усуй менің жауым?
Dialogue: 0,0:18:17.83,0:18:19.85,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:18:19.85,0:18:22.88,Default,,0000,0000,0000,,Не, мен көмектесе алмадым ...
Dialogue: 0,0:18:22.88,0:18:25.57,Default,,0000,0000,0000,,Миса-чан сондай өзімшіл.
Dialogue: 0,0:18:25.57,0:18:27.57,Default,,0000,0000,0000,,Саған жау болғаным ұнамайды.
Dialogue: 0,0:18:30.79,0:18:33.32,Default,,0000,0000,0000,,Мені қалайсың ба?
Dialogue: 0,0:18:33.32,0:18:36.35,Default,,0000,0000,0000,,Сен ақымақсың ба? Ешкім бұлай айтқан жоқ...
Dialogue: 0,0:18:36.35,0:18:38.35,Default,,0000,0000,0000,,Түсіндім, онда кеттік.
Dialogue: 0,0:18:41.07,0:18:43.42,Default,,0000,0000,0000,,А, сен қайда жүрсің?
Dialogue: 0,0:18:43.42,0:18:46.42,Default,,0000,0000,0000,,（Ａ）
Dialogue: 0,0:18:47.80,0:18:50.49,Default,,0000,0000,0000,,Жеткізу!
Dialogue: 0,0:18:50.49,0:18:52.85,Default,,0000,0000,0000,,Аои-чан!
Dialogue: 0,0:18:52.85,0:18:55.05,Default,,0000,0000,0000,,（Ａ） （Ｂ）
Dialogue: 0,0:18:55.05,0:18:57.07,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:18:57.07,0:18:59.09,Default,,0000,0000,0000,,〈Не болса да қабылда! 〉
Dialogue: 0,0:18:59.09,0:19:02.09,Default,,0000,0000,0000,,Миса-чан! қауіпті!
Dialogue: 0,0:19:04.14,0:19:06.14,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:19:08.18,0:19:11.53,Default,,0000,0000,0000,,А, бұл қауіпті!
Dialogue: 0,0:19:11.53,0:19:13.53,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:18.27,0:19:20.27,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:22.81,0:19:24.81,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:25.68,0:19:27.68,Default,,0000,0000,0000,,Уау Уау
Dialogue: 0,0:19:34.27,0:19:36.29,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:19:36.29,0:19:38.31,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,0:19:38.31,0:19:43.19,Default,,0000,0000,0000,,Ол басқа түске айнала бастады. Бұл артқы жағынан тікелей соққы болды, солай ма? →
Dialogue: 0,0:19:43.19,0:19:45.19,Default,,0000,0000,0000,,Бәрібір сақ болыңыз
Dialogue: 0,0:19:54.80,0:19:57.49,Default,,0000,0000,0000,,Жақсы, мен асыра айттым.
Dialogue: 0,0:19:57.49,0:20:00.52,Default,,0000,0000,0000,,Әй, Усуй, әлі көп қозғалма.
Dialogue: 0,0:20:00.52,0:20:03.89,Default,,0000,0000,0000,,Миса-чан тым көп уайымдайды, себебі...
Dialogue: 0,0:20:03.89,0:20:06.09,Default,,0000,0000,0000,,Сіз уайымдауыңыз керек, себебі бұл сіздің кінәңіз.
Dialogue: 0,0:20:06.09,0:20:10.46,Default,,0000,0000,0000,,-да? Сен өкініп, менің артымнан келе жатырсың.
Dialogue: 0,0:20:10.46,0:20:13.32,Default,,0000,0000,0000,,Жағажай волейбол ойынында жеңіске жеткені үшін құттықтаулар да қабылданбайды
Dialogue: 0,0:20:13.32,0:20:16.02,Default,,0000,0000,0000,,Басқа команданы жарақаттау арқылы қалай жеңеміз?
Dialogue: 0,0:20:16.02,0:20:18.21,Default,,0000,0000,0000,,Шынайы бақытты болу мүмкін емес.
Dialogue: 0,0:20:18.21,0:20:21.07,Default,,0000,0000,0000,,Осылай сезінсеңіз, тойласаңыз да,
Dialogue: 0,0:20:21.07,0:20:24.60,Default,,0000,0000,0000,,Бұл жай ғана атмосфераны нашарлатады.
Dialogue: 0,0:20:24.60,0:20:27.13,Default,,0000,0000,0000,,Дүкендегілердің бәрі жақсы көңіл-күй сыйлағанына қуаныштымын.
Dialogue: 0,0:20:27.13,0:20:31.33,Default,,0000,0000,0000,,《Олай болса, Эрика ханшайымның рөлін ойнайды. Оған қалдырыңыз! 》
Dialogue: 0,0:20:31.33,0:20:34.36,Default,,0000,0000,0000,,《Менен ерекшеленбе, жарай ма?》
Dialogue: 0,0:20:34.36,0:20:36.36,Default,,0000,0000,0000,,《Хонока да ханшайымды ойнағысы келді》
Dialogue: 0,0:20:40.59,0:20:42.78,Default,,0000,0000,0000,,《Aoi→》
Dialogue: 0,0:20:42.78,0:20:45.47,Default,,0000,0000,0000,,《Мен сіздің шешіміңізді көрдім.》
Dialogue: 0,0:20:45.47,0:20:47.49,Default,,0000,0000,0000,,《Не? 》
Dialogue: 0,0:20:47.49,0:20:49.49,Default,,0000,0000,0000,,《Жеңіспен құттықтаймыз》
Dialogue: 0,0:20:51.54,0:20:53.54,Default,,0000,0000,0000,,《Нагиса-сан…》
Dialogue: 0,0:20:56.75,0:20:58.94,Default,,0000,0000,0000,,Бірақ шын мәнінде
Dialogue: 0,0:20:58.94,0:21:01.94,Default,,0000,0000,0000,,Миса-чан сондай агрессивті, солай емес пе?
Dialogue: 0,0:21:03.65,0:21:06.65,Default,,0000,0000,0000,,Бұл керемет асық болды.
Dialogue: 0,0:21:09.38,0:21:12.38,Default,,0000,0000,0000,,Усуи Кешіріңіз.
Dialogue: 0,0:21:16.95,0:21:18.95,Default,,0000,0000,0000,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:21:23.52,0:21:25.71,Default,,0000,0000,0000,,Мен... десем не істер едің?
Dialogue: 0,0:21:25.71,0:21:27.71,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:29.08,0:21:32.44,Default,,0000,0000,0000,,Мені тағы да қалжыңдап тұрсың ба?
Dialogue: 0,0:21:32.44,0:21:35.81,Default,,0000,0000,0000,,Бастапқыда бұл турнирге қатысатын болғандықтан...
Dialogue: 0,0:21:35.81,0:21:37.16,Default,,0000,0000,0000,,Маған ұнамады.
Dialogue: 0,0:21:37.16,0:21:40.36,Default,,0000,0000,0000,,Жағажай ханшайымы бол
Dialogue: 0,0:21:40.36,0:21:43.89,Default,,0000,0000,0000,,Ерлерді қуантатын киім киіңіз
Dialogue: 0,0:21:43.89,0:21:46.92,Default,,0000,0000,0000,,Менің суретімді арам ниетпен түсірген.
Dialogue: 0,0:21:46.92,0:21:49.92,Default,,0000,0000,0000,,Мен Аюзаваны олай көргім келмеді.
Dialogue: 0,0:21:52.47,0:21:54.83,Default,,0000,0000,0000,,Бұл... бәрі осы ма?
Dialogue: 0,0:21:54.83,0:21:56.85,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:21:56.85,0:21:59.05,Default,,0000,0000,0000,,Сондықтан жеңіске жетуді мақсат еттіңіз бе?
Dialogue: 0,0:21:59.05,0:22:01.40,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:22:01.40,0:22:04.93,Default,,0000,0000,0000,,Ах~ Бұл не?
Dialogue: 0,0:22:04.93,0:22:08.80,Default,,0000,0000,0000,,Аои-чан одан да маңыздырақ шығар.
Dialogue: 0,0:22:08.80,0:22:12.68,Default,,0000,0000,0000,,Бұл мен үшін маңыздырақ.
Dialogue: 0,0:22:12.68,0:22:14.20,Default,,0000,0000,0000,,Әлі түсінбедіңіз бе?
Dialogue: 0,0:22:14.20,0:22:18.90,Default,,0000,0000,0000,,Не? Көбінесе сіз үнемі қалжыңдап жүргендіктен...
Dialogue: 0,0:22:18.90,0:22:20.90,Default,,0000,0000,0000,,Содан кейін мұқият қараңыз.
Dialogue: 0,0:22:23.12,0:22:25.48,Default,,0000,0000,0000,,Үш ойыншы оны құлатып тастады
Dialogue: 0,0:22:25.48,0:22:28.50,Default,,0000,0000,0000,,Мен қалжыңдамаймын.
Dialogue: 0,0:22:28.50,0:22:30.50,Default,,0000,0000,0000,,Usui…
Dialogue: 0,0:22:37.10,0:22:40.10,Default,,0000,0000,0000,,Отшашу…
Dialogue: 0,0:22:45.18,0:22:50.18,Default,,0000,0000,0000,,Айтпақшы, олар фестиваль соңында отшашу болатынын айтты.
Dialogue: 0,0:23:03.52,0:23:05.52,Default,,0000,0000,0000,,Олардың мен адамзаттың күш арасындағы алшақтық аса үлкен еді,
Dialogue: 0,0:23:09.41,0:23:13.41,Default,,0000,0000,0000,,Бұл күннің күйіп қалуы... иә иә
Dialogue: 0,0:23:15.97,0:23:18.50,Default,,0000,0000,0000,,Ах~ мен жақында қайтамын!
Dialogue: 0,0:23:18.50,0:23:20.50,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:23:26.58,0:23:28.58,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:23:30.29,0:23:33.65,Default,,0000,0000,0000,,А, мен қайтып келдім, Бэкуп.
Dialogue: 0,0:23:33.65,0:23:36.51,Default,,0000,0000,0000,,Қош келдіңіз~ Аои-чан, бұл не?
Dialogue: 0,0:23:36.51,0:23:40.72,Default,,0000,0000,0000,,Өйткені, меннен артық ханшайым болуға лайықты ешкім жоқ.
Dialogue: 0,0:23:40.72,0:23:42.24,Default,,0000,0000,0000,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:23:42.24,0:23:45.77,Default,,0000,0000,0000,,Соңында бұл Аои-чан фестиваліндей болды.
Dialogue: 0,0:23:45.77,0:23:49.48,Default,,0000,0000,0000,,Гон-чан мен Саю-чан да жасырын түрде қатысты.
Dialogue: 0,0:23:49.48,0:23:52.18,Default,,0000,0000,0000,,Мені жаңа ғана қонаққа келген туыстарымның бәрі шақырды.
Dialogue: 0,0:23:52.18,0:23:55.21,Default,,0000,0000,0000,,Менің де туыстарымның бәрі келді.
Dialogue: 0,0:23:55.21,0:23:59.58,Default,,0000,0000,0000,,Жасы үлкен бастауыш сынып оқушысы шығамын деді.
Dialogue: 0,0:23:59.58,0:24:02.78,Default,,0000,0000,0000,,Мен Миса-чанмен және басқалармен төбелеспей тұрып жеңіліп қалдым.
Dialogue: 0,0:24:02.78,0:24:05.47,Default,,0000,0000,0000,,Маған айтқаныңызды қалаймын.
Dialogue: 0,0:24:05.47,0:24:09.51,Default,,0000,0000,0000,,Дәл солай, екеуміз де қайтып келдік, ендеше бастайық.
Dialogue: 0,0:24:09.51,0:24:12.54,Default,,0000,0000,0000,,Бастау? Сапар ертең ғана аяқталады.
Dialogue: 0,0:24:12.54,0:24:14.73,Default,,0000,0000,0000,,Барлығымен естелік сурет
Dialogue: 0,0:24:14.73,0:24:17.10,Default,,0000,0000,0000,,Барлығың ортаға сәл жақынырақ келіңдер.
Dialogue: 0,0:24:17.10,0:24:19.12,Default,,0000,0000,0000,,Бұл солай ма?
Dialogue: 0,0:24:19.12,0:24:22.65,Default,,0000,0000,0000,,Автобус жұбы баяу болды, сондықтан мен күтуден шаршадым.
Dialogue: 0,0:24:22.65,0:24:25.18,Default,,0000,0000,0000,,Кешіріңіз... Айтайын дегенім, біз жұп емеспіз.
Dialogue: 0,0:24:25.18,0:24:27.20,Default,,0000,0000,0000,,Таймер Кеттік
Dialogue: 0,0:24:27.20,0:24:30.06,Default,,0000,0000,0000,,Бәрібір түнде теңізде тентектік жасап жүрген боларсың.
Dialogue: 0,0:24:30.06,0:24:32.25,Default,,0000,0000,0000,,Мен... Менде жоқ.
Dialogue: 0,0:24:32.25,0:24:36.25,Default,,0000,0000,0000,,Енді мен оны жоққа шығаруға қиналдым. Бұлай емес!
Dialogue: 0,0:24:37.13,0:24:42.13,Default,,0000,0000,0000,,<Әртүрлі ойлар кездейсоқ өседі...>
Dialogue: 0,0:24:48.40,0:24:51.40,Default,,0000,0000,0000,,<Жаз өтті>
Dialogue: 0,0:25:02.54,0:25:05.24,Default,,0000,0000,0000,,Миса әлі сонда ма? (Сарашина) Маған ұнамайды, сенгім келмейді.
Dialogue: 0,0:25:05.24,0:25:09.78,Default,,0000,0000,0000,,Біздің де жаздың біткеніне сене алар емеспін~
Dialogue: 0,0:25:09.78,0:25:13.48,Default,,0000,0000,0000,,Миса-чан қайтып кел!
Dialogue: 0,0:25:13.48,0:25:16.02,Default,,0000,0000,0000,,Неге үйге барып, жазғы үй тапсырмасын орындамайсың?
Dialogue: 0,0:25:16.02,0:25:20.06,Default,,0000,0000,0000,,Бұл жазғы әңгіменің соңы, Чан Чан.
Dialogue: 0,0:25:20.06,0:25:57.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:58.11,0:26:49.95,Default,,0000,0000,0000,,
Dialogue: 0,0:26:51.45,0:26:57.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory