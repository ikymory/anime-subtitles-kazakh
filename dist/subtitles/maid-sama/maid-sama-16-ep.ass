Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:05.98,0:01:35.98,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:36.29,0:02:43.79,Default,,0000,0000,0000,,
Dialogue: 0,0:03:52.15,0:03:54.17,Default,,0000,0000,0000,,Кел, жазғы демалыс
Dialogue: 0,0:03:54.17,0:03:57.37,Default,,0000,0000,0000,,Мен Maid Latte-ге көп барамын.
Dialogue: 0,0:03:57.37,0:04:01.24,Default,,0000,0000,0000,,Қалтадағы ақшам біткенше, мен Maid Latte-ге барамын.
Dialogue: 0,0:04:01.24,0:04:05.28,Default,,0000,0000,0000,,Жанымыз жаздан да ыстық
Dialogue: 0,0:04:05.28,0:04:09.28,Default,,0000,0000,0000,,Мен айқайлап жатырмын: ``Ешқашан ұмытпайтын жазға айналдырайық!''
Dialogue: 0,0:04:11.34,0:04:13.34,Default,,0000,0000,0000,,Не~! ?
Dialogue: 0,0:04:19.92,0:04:23.92,Default,,0000,0000,0000,,Миса-чан!
Dialogue: 0,0:04:26.16,0:04:30.20,Default,,0000,0000,0000,,Ыстық~ О, жоқ~ Мен өз шегімдемін
Dialogue: 0,0:04:30.20,0:04:34.24,Default,,0000,0000,0000,,Сіз жақындап қалдыңыз, сондықтан қолыңыздан келгеннің барлығын жасаңыз, Хонока-чан
Dialogue: 0,0:04:34.24,0:04:38.28,Default,,0000,0000,0000,,Мен жайлы саяхатқа қатыспауым керек еді.
Dialogue: 0,0:04:38.28,0:04:40.30,Default,,0000,0000,0000,,Олай айтпа.
Dialogue: 0,0:04:40.30,0:04:44.67,Default,,0000,0000,0000,,Мені дүкен меңгерушісінің әпкесі шақырды.
Dialogue: 0,0:04:44.67,0:04:46.02,Default,,0000,0000,0000,,Дұрыс, мен шағымданбаймын.
Dialogue: 0,0:04:46.02,0:04:48.21,Default,,0000,0000,0000,,Миса Чан ше?
Dialogue: 0,0:04:48.21,0:04:50.23,Default,,0000,0000,0000,,Сол жерде
Dialogue: 0,0:04:50.23,0:04:53.09,Default,,0000,0000,0000,,...
Dialogue: 0,0:04:53.09,0:04:55.09,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:04:58.31,0:05:00.31,Default,,0000,0000,0000,,Бұл теңіз!
Dialogue: 0,0:05:12.28,0:05:15.15,Default,,0000,0000,0000,,Мен оны үлкен етіп кесіп алдым
Dialogue: 0,0:05:15.15,0:05:17.17,Default,,0000,0000,0000,,Уау, сәнді адам~
Dialogue: 0,0:05:17.17,0:05:19.19,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:05:19.19,0:05:21.37,Default,,0000,0000,0000,,Сіздің әпкеңіз теңіз бе?
Dialogue: 0,0:05:21.37,0:05:23.23,Default,,0000,0000,0000,,Менің анам да жұмыс істейді.
Dialogue: 0,0:05:23.23,0:05:25.25,Default,,0000,0000,0000,,Мен мұның соншалықты сәтті болады деп күткен жоқпын.
Dialogue: 0,0:05:25.25,0:05:29.45,Default,,0000,0000,0000,,Бәрін жей алмасам, не істеуім керек?
Dialogue: 0,0:05:29.45,0:05:33.16,Default,,0000,0000,0000,,Аа, дұрыс, ұтыс ойыны бөлімінің жігіттерін шақырайық. Гүлп.
Dialogue: 0,0:05:33.16,0:05:35.18,Default,,0000,0000,0000,,Әзірше мынаны жеп қойыңыз →
Dialogue: 0,0:05:35.18,0:05:39.18,Default,,0000,0000,0000,,Қытырлақ... Pupupupupupu
Dialogue: 0,0:05:40.23,0:05:42.08,Default,,0000,0000,0000,,→
Dialogue: 0,0:05:42.08,0:05:44.27,Default,,0000,0000,0000,,Көптен бері көрмедім, Сатсуки-ни-сан
Dialogue: 0,0:05:44.27,0:05:47.13,Default,,0000,0000,0000,,Нағиса, қалайсың? <Қара...>
Dialogue: 0,0:05:47.13,0:05:49.15,Default,,0000,0000,0000,,<Бұл қара дүкеннің менеджері>
Dialogue: 0,0:05:49.15,0:05:51.18,Default,,0000,0000,0000,,Тіпті әпкең де дүкен меңгерушісі шығар.
Dialogue: 0,0:05:51.18,0:05:56.89,Default,,0000,0000,0000,,Баршаңызға еңбектеріңіз үшін рахмет. Теңізге шықпас бұрын біраз демалып алайық.
Dialogue: 0,0:05:56.89,0:05:58.24,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:58.24,0:06:01.24,Default,,0000,0000,0000,,...
Dialogue: 0,0:06:03.12,0:06:05.14,Default,,0000,0000,0000,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:06:05.14,0:06:07.16,Default,,0000,0000,0000,,Бұл өте әдемі.
Dialogue: 0,0:06:07.16,0:06:09.18,Default,,0000,0000,0000,,Биыл басталған сияқты.
Dialogue: 0,0:06:09.18,0:06:11.20,Default,,0000,0000,0000,,Террасада орындықтар да бар.
Dialogue: 0,0:06:11.20,0:06:13.23,Default,,0000,0000,0000,,Хмм, жақсы жел
Dialogue: 0,0:06:13.23,0:06:16.25,Default,,0000,0000,0000,,（）→
Dialogue: 0,0:06:16.25,0:06:19.62,Default,,0000,0000,0000,,Қызметші кафеде жұмыс істейтін әйел болса да
Dialogue: 0,0:06:19.62,0:06:22.15,Default,,0000,0000,0000,,Мен осындай ультракүлгін сәулелерге толы жерге келгеніме сене алар емеспін.
Dialogue: 0,0:06:22.15,0:06:26.35,Default,,0000,0000,0000,,Менің терімнің жыртылуы маңызды ма?
Dialogue: 0,0:06:26.35,0:06:29.22,Default,,0000,0000,0000,,Аои-чан〈Аои Хиодо, 14 жас→〉
Dialogue: 0,0:06:29.22,0:06:32.25,Default,,0000,0000,0000,,〈Ол дүкен менеджерінің жиені және ``AOI'' деген атпен танымал онлайн кумирі→〉
Dialogue: 0,0:06:32.25,0:06:34.27,Default,,0000,0000,0000,,<Жынысы: Ерлердің хоббиі: Айқас киіну>
Dialogue: 0,0:06:34.27,0:06:36.29,Default,,0000,0000,0000,,Мүмкін сіз тағы да бас тарттыңыз ба?
Dialogue: 0,0:06:36.29,0:06:40.33,Default,,0000,0000,0000,,Сіз бұл жолы теңіздегі адамды азғыруды жоспарлап отырсыз ба?
Dialogue: 0,0:06:40.33,0:06:42.35,Default,,0000,0000,0000,,Мұнда Aoi
Dialogue: 0,0:06:42.35,0:06:44.87,Default,,0000,0000,0000,,Сен тағы солай киіндің!
Dialogue: 0,0:06:44.87,0:06:46.23,Default,,0000,0000,0000,,Әй, қайтар!
Dialogue: 0,0:06:46.23,0:06:50.10,Default,,0000,0000,0000,,Бұл жағажай. Қарап тұрып қызып кететін киімдерді кимеңіз.
Dialogue: 0,0:06:50.10,0:06:53.30,Default,,0000,0000,0000,,Аои-чан, ерке болуға тырыс
Dialogue: 0,0:06:53.30,0:06:56.30,Default,,0000,0000,0000,,Оны ағам осында қалдырып кеткен. Мен түсінемін.
Dialogue: 0,0:06:59.18,0:07:01.37,Default,,0000,0000,0000,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:07:01.37,0:07:03.22,Default,,0000,0000,0000,,Аа, төраға.
Dialogue: 0,0:07:03.22,0:07:07.26,Default,,0000,0000,0000,,Усуиге не үшін келдің?
Dialogue: 0,0:07:07.26,0:07:10.63,Default,,0000,0000,0000,,Сіз дүкен менеджері мұны істеуді сұрағанын айттыңыз.
Dialogue: 0,0:07:10.63,0:07:13.16,Default,,0000,0000,0000,,Сіз оққағар рөлін қалайсыз ба? иә?
Dialogue: 0,0:07:13.16,0:07:17.20,Default,,0000,0000,0000,,Мен ыстықты ұнатпаймын деп таңертең ерте келдім.
Dialogue: 0,0:07:17.20,0:07:20.23,Default,,0000,0000,0000,,Мотивацияңыз бар ма, жоқ па?
Dialogue: 0,0:07:20.23,0:07:24.10,Default,,0000,0000,0000,,Миса-чан үшін болса, мен мотивация аламын.
Dialogue: 0,0:07:24.10,0:07:27.30,Default,,0000,0000,0000,,Миса суға батып кеткен жағдайда
Dialogue: 0,0:07:27.30,0:07:30.16,Default,,0000,0000,0000,,Сізге басқа біреудің жасанды тыныс бергенін қаламайсыз.
Dialogue: 0,0:07:30.16,0:07:32.16,Default,,0000,0000,0000,,Жүр, бұл теңіз, жүзейік.
Dialogue: 0,0:07:35.71,0:07:38.71,Default,,0000,0000,0000,,Ал, Усуйкун, біз киім ауыстырамыз.
Dialogue: 0,0:07:39.26,0:07:42.28,Default,,0000,0000,0000,,Сен қатты толқыдың, Миса-чан.
Dialogue: 0,0:07:42.28,0:07:47.16,Default,,0000,0000,0000,,Негізі, анам маған: ``Бір кездері сен орта мектеп оқушысы сияқты ойнау керексің'' деді.
Dialogue: 0,0:07:47.16,0:07:51.21,Default,,0000,0000,0000,,Маған біртүрлі лекция оқылды, сондықтан мен біраз уақыттан кейін бірінші рет бар күшіммен ойнап көрейін деп ойладым.
Dialogue: 0,0:07:51.21,0:07:54.24,Default,,0000,0000,0000,,Сіз шынымен де барлық нәрсеге бар күшіңізді саласыз, Миса-чан.
Dialogue: 0,0:07:54.24,0:07:56.43,Default,,0000,0000,0000,,Эй, Миса Чан, бұл сенің купальникің бе?
Dialogue: 0,0:07:56.43,0:07:59.43,Default,,0000,0000,0000,,Ал, мен бірінші барамын.
Dialogue: 0,0:08:01.31,0:08:03.31,Default,,0000,0000,0000,,Соңында
Dialogue: 0,0:08:08.21,0:08:10.23,Default,,0000,0000,0000,,Бәріңе сәлем
Dialogue: 0,0:08:10.23,0:08:13.26,Default,,0000,0000,0000,,Жақсы сезіледі~ Мектепке арналған купальник...
Dialogue: 0,0:08:13.26,0:08:16.45,Default,,0000,0000,0000,,Дұрыс, купальник қымбат.
Dialogue: 0,0:08:16.45,0:08:18.48,Default,,0000,0000,0000,,Бірақ неге жүзу қалпақ?
Dialogue: 0,0:08:18.48,0:08:21.84,Default,,0000,0000,0000,,Сіз жүзе алсаңыз, көңіліңіз толады.
Dialogue: 0,0:08:21.84,0:08:23.19,Default,,0000,0000,0000,,Миса-чан күткендей
Dialogue: 0,0:08:23.19,0:08:25.38,Default,,0000,0000,0000,,Теңізден толық ләззат алу
Dialogue: 0,0:08:25.38,0:08:29.08,Default,,0000,0000,0000,,→
Dialogue: 0,0:08:29.08,0:08:31.27,Default,,0000,0000,0000,,Сіз үлкен үміт күттіңіз бе?
Dialogue: 0,0:08:31.27,0:08:33.29,Default,,0000,0000,0000,,Бұл теңіз ғой.
Dialogue: 0,0:08:33.29,0:08:35.14,Default,,0000,0000,0000,,Бірақ ол
Dialogue: 0,0:08:35.14,0:08:37.16,Default,,0000,0000,0000,,Эй, сен жалғызсың ба? Менімен ойнағың келе ме?
Dialogue: 0,0:08:37.16,0:08:40.20,Default,,0000,0000,0000,,Жағажай волейболына адам аз. Ойнағың келе ме?
Dialogue: 0,0:08:40.20,0:08:44.20,Default,,0000,0000,0000,,...
Dialogue: 0,0:08:49.29,0:08:52.31,Default,,0000,0000,0000,,〈Теңізден бері қанша уақыт өтті?〉
Dialogue: 0,0:08:52.31,0:08:54.17,Default,,0000,0000,0000,,<Бастауыш мектеп...>
Dialogue: 0,0:08:54.17,0:08:57.37,Default,,0000,0000,0000,,<Оның алдында мен бальзамды аулауға шықтым.>
Dialogue: 0,0:08:57.37,0:09:00.23,Default,,0000,0000,0000,,Ей, ойнайық!
Dialogue: 0,0:09:00.23,0:09:02.23,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:08.31,0:09:11.34,Default,,0000,0000,0000,,...
Dialogue: 0,0:09:11.34,0:09:15.21,Default,,0000,0000,0000,,Біріншіден, орналасқан жері нашар. Ол жағажайдың шетінде.
Dialogue: 0,0:09:15.21,0:09:18.24,Default,,0000,0000,0000,,Тек осы дүкен алыс.
Dialogue: 0,0:09:18.24,0:09:22.28,Default,,0000,0000,0000,,Жаңадан келгендерге, иә, сіз жақсы орын ала алмайсыз.
Dialogue: 0,0:09:22.28,0:09:25.98,Default,,0000,0000,0000,,Дүкеннің өзі жаңа және таза.
Dialogue: 0,0:09:25.98,0:09:27.33,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:09:27.33,0:09:31.37,Default,,0000,0000,0000,,（）
Dialogue: 0,0:09:31.37,0:09:35.24,Default,,0000,0000,0000,,Тезірек жығыла, сосын мен үйге барамын.
Dialogue: 0,0:09:35.24,0:09:38.61,Default,,0000,0000,0000,,Аои-чан〈Ол балаға ұқсайды...〉
Dialogue: 0,0:09:38.61,0:09:42.65,Default,,0000,0000,0000,,Батылдық, бұл жігітке не болғаны маған бәрібір.
Dialogue: 0,0:09:42.65,0:09:44.67,Default,,0000,0000,0000,,Қақпақ, қайтар!
Dialogue: 0,0:09:44.67,0:09:46.69,Default,,0000,0000,0000,,Жұмыс біткен соң қайтаратынын айтты.
Dialogue: 0,0:09:46.69,0:09:50.56,Default,,0000,0000,0000,,Бірақ біз бірдеңені шынымен ойламасақ қауіпті емес пе?
Dialogue: 0,0:09:50.56,0:09:56.12,Default,,0000,0000,0000,,Нашар орналасу жағдайының орнын толтыратын нәрсе болса жақсы болар еді.
Dialogue: 0,0:09:56.12,0:10:01.51,Default,,0000,0000,0000,,-ге келгенде, көзге түсетін нәрселер бар.
Dialogue: 0,0:10:01.51,0:10:03.51,Default,,0000,0000,0000,,Басқа дүкендерде жоқ ерекше мүмкіндіктер бар...
Dialogue: 0,0:10:05.21,0:10:08.24,Default,,0000,0000,0000,,Барлығы? Фуфуфу…
Dialogue: 0,0:10:08.24,0:10:11.27,Default,,0000,0000,0000,,Қайда барсақ та, біз
Dialogue: 0,0:10:11.27,0:10:14.97,Default,,0000,0000,0000,,Менің қолымдағы жалғыз қару осы емес пе?
Dialogue: 0,0:10:14.97,0:10:16.83,Default,,0000,0000,0000,,Не? Күте тұрыңыз... мүмкін емес
Dialogue: 0,0:10:16.83,0:10:18.85,Default,,0000,0000,0000,,Өйткені қанша болса да...
Dialogue: 0,0:10:18.85,0:10:22.55,Default,,0000,0000,0000,,Кәне, бәріміз, осында қалайық→
Dialogue: 0,0:10:22.55,0:10:24.55,Default,,0000,0000,0000,,Сіз мұны істегіңіз келе ме?
Dialogue: 0,0:10:25.91,0:10:28.91,Default,,0000,0000,0000,,Қош келдіңіз, ұстаз.
Dialogue: 0,0:10:29.28,0:10:31.47,Default,,0000,0000,0000,,Оны насихаттау үшін жағажайда серуендейміз.
Dialogue: 0,0:10:31.47,0:10:33.33,Default,,0000,0000,0000,,Мұнда адам көп емес.
Dialogue: 0,0:10:33.33,0:10:36.35,Default,,0000,0000,0000,,Біртүрлі болса да, араласпа
Dialogue: 0,0:10:36.35,0:10:39.22,Default,,0000,0000,0000,,Бұл жай ғана кездейсоқ нәрсе.
Dialogue: 0,0:10:39.22,0:10:41.24,Default,,0000,0000,0000,,АОI кезегі.
Dialogue: 0,0:10:41.24,0:10:44.77,Default,,0000,0000,0000,,Кора! Сіз душ бөлмесін тазалап жатырсыз, солай ма?
Dialogue: 0,0:10:44.77,0:10:46.12,Default,,0000,0000,0000,,Нагиса-сан
Dialogue: 0,0:10:46.12,0:10:49.15,Default,,0000,0000,0000,,Амансың ба? Кенеттен осылай...
Dialogue: 0,0:10:49.15,0:10:51.17,Default,,0000,0000,0000,,Керемет емес пе? Бұл қызық→
Dialogue: 0,0:10:51.17,0:10:55.21,Default,,0000,0000,0000,,Бұл бір күндік шектеулі оқиға, сондықтан ол тек бүгінгі күн үшін ерекше →
Dialogue: 0,0:10:55.21,0:10:57.23,Default,,0000,0000,0000,,Әдеттегідей ертеңнен бастап
Dialogue: 0,0:10:57.23,0:11:01.27,Default,,0000,0000,0000,,Егер реакция жақсы болса, осы бағыттан да сабақ алуға болады.
Dialogue: 0,0:11:01.27,0:11:03.29,Default,,0000,0000,0000,,Олар мұны ерікті негізде жасайтын сияқты.
Dialogue: 0,0:11:03.29,0:11:05.81,Default,,0000,0000,0000,,Бүгін өзіңіз қалаған нәрсені жасаңыз
Dialogue: 0,0:11:05.81,0:11:07.17,Default,,0000,0000,0000,,Егер сізге бірдеңе керек болса, маған хабарласыңыз~
Dialogue: 0,0:11:07.17,0:11:09.35,Default,,0000,0000,0000,,Жібер!
Dialogue: 0,0:11:09.35,0:11:11.37,Default,,0000,0000,0000,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:11:11.37,0:11:13.37,Default,,0000,0000,0000,,Дөңгелек лақтыру! ?
Dialogue: 0,0:11:14.40,0:11:16.40,Default,,0000,0000,0000,,Мыңғыр...
Dialogue: 0,0:11:23.16,0:11:27.03,Default,,0000,0000,0000,,Қызметші кафесі жағажайда бір күн ғана жұмыс істейді
Dialogue: 0,0:11:27.03,0:11:31.40,Default,,0000,0000,0000,,Ұстаздар мен ханымдар, келіңіздер.
Dialogue: 0,0:11:31.40,0:11:33.42,Default,,0000,0000,0000,,Біз сізді «Жағажай үйінде» күтеміз
Dialogue: 0,0:11:33.42,0:11:37.30,Default,,0000,0000,0000,,...
Dialogue: 0,0:11:37.30,0:11:39.30,Default,,0000,0000,0000,,－
Dialogue: 0,0:11:40.16,0:11:42.16,Default,,0000,0000,0000,,〈Жақсысың ба? Шынымен...〉
Dialogue: 0,0:11:48.24,0:11:51.27,Default,,0000,0000,0000,,А, ол енді қолданылмайды.
Dialogue: 0,0:11:51.27,0:11:55.31,Default,,0000,0000,0000,,Ультракүлгін сәулелер соншалықты күшті болған кезде біз неге тазалауымыз керек...
Dialogue: 0,0:11:55.31,0:11:57.33,Default,,0000,0000,0000,,Мен саған көмектесемін, иә?
Dialogue: 0,0:11:57.33,0:11:59.35,Default,,0000,0000,0000,,Мен мұны істей аламын ба?
Dialogue: 0,0:11:59.35,0:12:01.37,Default,,0000,0000,0000,,Сен неге...
Dialogue: 0,0:12:01.37,0:12:05.58,Default,,0000,0000,0000,,Хмм... Мен бүгін сахнаның артында көмектесемін деп ойладым.
Dialogue: 0,0:12:05.58,0:12:10.12,Default,,0000,0000,0000,,Хмф, сіз өзіңіздің жыныстық тартымдылығыңыздың жоқтығын білетін сияқтысыз.
Dialogue: 0,0:12:10.12,0:12:13.15,Default,,0000,0000,0000,,Сіздің купальник болу қызықсыз.
Dialogue: 0,0:12:13.15,0:12:17.19,Default,,0000,0000,0000,,Иә, жақсы... Сонда бұл жұмыс жақсы ма?
Dialogue: 0,0:12:17.19,0:12:19.89,Default,,0000,0000,0000,,Аои-чан, сен де ішін тазалауың керек, солай ма?
Dialogue: 0,0:12:19.89,0:12:22.92,Default,,0000,0000,0000,,Басқа амал жоқ, тек өзіңді ойла.
Dialogue: 0,0:12:22.92,0:12:25.44,Default,,0000,0000,0000,,Жарайды, асығыңыз.
Dialogue: 0,0:12:25.44,0:12:27.44,Default,,0000,0000,0000,,Ол жанып кетеді
Dialogue: 0,0:12:37.23,0:12:39.25,Default,,0000,0000,0000,,Араласатын қара қаңбақ!
Dialogue: 0,0:12:39.25,0:12:41.25,Default,,0000,0000,0000,,Қара…
Dialogue: 0,0:12:42.28,0:12:54.73,Default,,0000,0000,0000,,
Dialogue: 0,0:14:00.56,0:14:03.76,Default,,0000,0000,0000,,（Ａ）
Dialogue: 0,0:14:03.76,0:14:05.11,Default,,0000,0000,0000,,（Ｂ）
Dialogue: 0,0:14:05.11,0:14:08.64,Default,,0000,0000,0000,,Қош келдіңіз, ұстаз.
Dialogue: 0,0:14:08.64,0:14:10.99,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:14:10.99,0:14:13.02,Default,,0000,0000,0000,,Осы жерде демалыңыз.
Dialogue: 0,0:14:13.02,0:14:17.06,Default,,0000,0000,0000,,Бүгін не шай ішер едің?
Dialogue: 0,0:14:17.06,0:14:20.09,Default,,0000,0000,0000,,Мұзды кофе мен мұздатылған шай.
Dialogue: 0,0:14:20.09,0:14:22.95,Default,,0000,0000,0000,,Кашикомаримасу
Dialogue: 0,0:14:22.95,0:14:25.97,Default,,0000,0000,0000,,Бұл қызметші кафесі ме?
Dialogue: 0,0:14:25.97,0:14:29.69,Default,,0000,0000,0000,,Мен ол жерге бір рет барғым келді, бірақ жағажайда болады деп ойламадым.
Dialogue: 0,0:14:29.69,0:14:32.69,Default,,0000,0000,0000,,Теңізге келгеніңізге қуаныштымын~ Эй~
Dialogue: 0,0:14:34.06,0:14:37.06,Default,,0000,0000,0000,,(жанды атмосфера)
Dialogue: 0,0:14:41.97,0:14:43.99,Default,,0000,0000,0000,,Күткеніңізге рахмет
Dialogue: 0,0:14:43.99,0:14:45.01,Default,,0000,0000,0000,,Жарайсың, жас ханым.
Dialogue: 0,0:14:45.01,0:14:47.03,Default,,0000,0000,0000,,Тіпті жас ханым~
Dialogue: 0,0:14:47.03,0:14:50.56,Default,,0000,0000,0000,,Маған тұтынушыларға қызмет көрсетудің сыпайы болғаны ұнайды.
Dialogue: 0,0:14:50.56,0:14:54.93,Default,,0000,0000,0000,,Бүгін тек «Sea Petit Cake Set»
Dialogue: 0,0:14:54.93,0:14:59.98,Default,,0000,0000,0000,,Ханымдар, ыстық душ қызметі туралы не айтасыз?
Dialogue: 0,0:14:59.98,0:15:03.02,Default,,0000,0000,0000,,Мен саған салқын сусын әкелдім.
Dialogue: 0,0:15:03.02,0:15:07.06,Default,,0000,0000,0000,,Тапсырысыңызды шешсеңіз, бізге хабарласыңыз.
Dialogue: 0,0:15:07.06,0:15:11.60,Default,,0000,0000,0000,,Ұстаз, мен сізге мына орынды көрсетемін.
Dialogue: 0,0:15:11.60,0:15:15.60,Default,,0000,0000,0000,,Монахқа арналған жарты өлшемді жинақ туралы не деуге болады?
Dialogue: 0,0:15:24.06,0:15:26.06,Default,,0000,0000,0000,,Ats…
Dialogue: 0,0:15:28.10,0:15:30.10,Default,,0000,0000,0000,,(адамдардың болуы)
Dialogue: 0,0:15:36.69,0:15:38.69,Default,,0000,0000,0000,,Уау, Усуй!
Dialogue: 0,0:15:40.06,0:15:42.91,Default,,0000,0000,0000,,Сіз сонда болдыңыз! ?
Dialogue: 0,0:15:42.91,0:15:44.10,Default,,0000,0000,0000,,Жоқ, бұл өте нашар болды.
Dialogue: 0,0:15:44.10,0:15:47.96,Default,,0000,0000,0000,,Миса Чан, бұл не?
Dialogue: 0,0:15:47.96,0:15:49.98,Default,,0000,0000,0000,,Әй, менеджерге.
Dialogue: 0,0:15:49.98,0:15:53.19,Default,,0000,0000,0000,,《Мен де саған көмектесемін. Сізде алжапқыш бар ма? 》
Dialogue: 0,0:15:53.19,0:15:56.72,Default,,0000,0000,0000,,《Миса-чан, бұл жайлы сапар болды кешіріңіз》
Dialogue: 0,0:15:56.72,0:16:00.09,Default,,0000,0000,0000,,《Жоқ, олай емес... Мен әрқашан дүкен меңгерушісіне қарыздармын.》
Dialogue: 0,0:16:00.09,0:16:02.95,Default,,0000,0000,0000,,《Олай болса, бұл үлкен мәселе болғандықтан》
Dialogue: 0,0:16:02.95,0:16:06.98,Default,,0000,0000,0000,,《Мен мектептегі купальниктерге аздап алаңдаймын》
Dialogue: 0,0:16:06.98,0:16:09.98,Default,,0000,0000,0000,,《Мен саған осыны қарызға беремін, өтінемін.》 《Күрсін...》
Dialogue: 0,0:16:10.03,0:16:14.23,Default,,0000,0000,0000,,Мен бас тарта алмаймын... Дәл қазір менің тұтынушыларым аз емес.
Dialogue: 0,0:16:14.23,0:16:16.59,Default,,0000,0000,0000,,Менің оны қарызға алудан басқа амалым қалмады.
Dialogue: 0,0:16:16.59,0:16:19.95,Default,,0000,0000,0000,,Миса-чан, сен сол киіммен шығуды жоспарлап жүрсің бе?
Dialogue: 0,0:16:19.95,0:16:23.99,Default,,0000,0000,0000,,Иә? Дұрыс, сол себепті киіміңді ауыстырдың деп ойлаймын.
Dialogue: 0,0:16:23.99,0:16:26.02,Default,,0000,0000,0000,,Неге ұйықтап, маған көмектеспейсің?
Dialogue: 0,0:16:26.02,0:16:29.05,Default,,0000,0000,0000,,Дәл қазір бізде толық тапсырыс бар және тапсырыстар үшін үлкен күту тізімі бар.
Dialogue: 0,0:16:29.05,0:16:32.05,Default,,0000,0000,0000,,Мен тез баруым керек... Аюзава
Dialogue: 0,0:16:39.98,0:16:41.00,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:16:41.00,0:16:43.00,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:44.03,0:16:46.05,Default,,0000,0000,0000,,Жарайды ма? Миса Чан
Dialogue: 0,0:16:46.05,0:16:50.05,Default,,0000,0000,0000,,Артқы жағындағы Хики Бәрі көрсе де
Dialogue: 0,0:16:53.95,0:16:55.47,Default,,0000,0000,0000,,...
Dialogue: 0,0:16:55.47,0:16:57.47,Default,,0000,0000,0000,,Миса-чан?
Dialogue: 0,0:16:59.18,0:17:02.05,Default,,0000,0000,0000,,Кешіріңіз... Бұл үшін мені кешіріңіз.
Dialogue: 0,0:17:02.05,0:17:05.08,Default,,0000,0000,0000,,Иә? Сіз де маған бір нәрсемен көмектесе аласыз.
Dialogue: 0,0:17:05.08,0:17:08.93,Default,,0000,0000,0000,,Ол күзетші болып жұмыс істейді.
Dialogue: 0,0:17:08.93,0:17:10.93,Default,,0000,0000,0000,,...
Dialogue: 0,0:17:21.06,0:17:25.94,Default,,0000,0000,0000,,Олай болса, еңбектеріңізге рахмет, баршаңызға!
Dialogue: 0,0:17:25.94,0:17:27.96,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:17:27.96,0:17:30.15,Default,,0000,0000,0000,,...
Dialogue: 0,0:17:30.15,0:17:32.17,Default,,0000,0000,0000,,→
Dialogue: 0,0:17:32.17,0:17:35.20,Default,,0000,0000,0000,,Осының арқасында дүкен ашылғаннан бері үлкен жетістікке жетті.
Dialogue: 0,0:17:35.20,0:17:39.91,Default,,0000,0000,0000,,Менің әпкем менеджер болатын дүкеннің де танымал екеніне сенімдімін.
Dialogue: 0,0:17:39.91,0:17:41.91,Default,,0000,0000,0000,,Барлығына рахмет
Dialogue: 0,0:17:43.95,0:17:45.95,Default,,0000,0000,0000,,Хун
Dialogue: 0,0:17:46.15,0:17:48.00,Default,,0000,0000,0000,,Иә, бұл
Dialogue: 0,0:17:48.00,0:17:50.02,Default,,0000,0000,0000,,Ыстық бұлақ тегін билет Ыстық бұлақ?
Dialogue: 0,0:17:50.02,0:17:53.05,Default,,0000,0000,0000,,Жақын жерде жаяу баруға болатын нәрсе бар.
Dialogue: 0,0:17:53.05,0:17:55.07,Default,,0000,0000,0000,,Я~
Dialogue: 0,0:17:55.07,0:17:57.26,Default,,0000,0000,0000,,Тамақтанып болған соң бәріміз бірге барайық.
Dialogue: 0,0:17:57.26,0:17:59.61,Default,,0000,0000,0000,,Тіпті ыстық бұлақтарда шомылуға болады.
Dialogue: 0,0:17:59.61,0:18:02.14,Default,,0000,0000,0000,,Осы жазғы демалыс қаншалықты керемет?
Dialogue: 0,0:18:02.14,0:18:04.00,Default,,0000,0000,0000,,Бұл жағалау ыстық бұлақ аймағы ретінде де танымал.
Dialogue: 0,0:18:04.00,0:18:07.02,Default,,0000,0000,0000,,Хе хе хе хе хе хе хе хе хе хе хе хе
Dialogue: 0,0:18:07.02,0:18:10.05,Default,,0000,0000,0000,,Бұған не болды? Хонока-сан
Dialogue: 0,0:18:10.05,0:18:12.07,Default,,0000,0000,0000,,Бұл жағалау
Dialogue: 0,0:18:12.07,0:18:15.07,Default,,0000,0000,0000,,Бұл шын мәнінде арулар мекені ретінде танымал.
Dialogue: 0,0:18:16.28,0:18:18.80,Default,,0000,0000,0000,,Психикалық... нүкте?
Dialogue: 0,0:18:18.80,0:18:20.99,Default,,0000,0000,0000,,...
Dialogue: 0,0:18:20.99,0:18:22.01,Default,,0000,0000,0000,,Өз-өзіне қол жұмсауға уәде берген әйел мен ер адам
Dialogue: 0,0:18:22.01,0:18:25.04,Default,,0000,0000,0000,,Мен өзімді лақтырмақ болдым →
Dialogue: 0,0:18:25.04,0:18:30.09,Default,,0000,0000,0000,,Шындығында, ер адам басқа әйелді жасап жатыр еді, секіретін сәті →
Dialogue: 0,0:18:30.09,0:18:35.30,Default,,0000,0000,0000,,Еркек сатқындықпен, Теңіз түбінде жалғыз қалған әйел...→
Dialogue: 0,0:18:35.30,0:18:40.02,Default,,0000,0000,0000,,Әйелдің денесі бірнеше ай бойы ашылмаған күйде қалады →
Dialogue: 0,0:18:40.02,0:18:46.02,Default,,0000,0000,0000,,Мұны бір түнде осында келген ғашықтар көрді.
Dialogue: 0,0:18:47.09,0:18:50.95,Default,,0000,0000,0000,,Не көрдің?
Dialogue: 0,0:18:50.95,0:18:53.15,Default,,0000,0000,0000,,Мұхит түбінен орасан жылдамдықпен→
Dialogue: 0,0:18:53.15,0:18:56.15,Default,,0000,0000,0000,,Қанға боялған әйел жартасқа жорғалайды.
Dialogue: 0,0:18:58.87,0:19:03.92,Default,,0000,0000,0000,,Содан бері Жапония жағалауындағы бұталарда психикалық құбылыстар бірінен соң бірі орын алуда.
Dialogue: 0,0:19:03.92,0:19:06.12,Default,,0000,0000,0000,,Ах~ Мен де көргім келеді~
Dialogue: 0,0:19:06.12,0:19:11.00,Default,,0000,0000,0000,,Бұл құйрық қанаты бекітілген қауесет.
Dialogue: 0,0:19:11.00,0:19:13.02,Default,,0000,0000,0000,,Иә, бірақ неге?
Dialogue: 0,0:19:13.02,0:19:16.02,Default,,0000,0000,0000,,Сіз өзіңізді атақтымын деп ойлайсыз ба?
Dialogue: 0,0:19:19.58,0:19:21.10,Default,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:19:21.10,0:19:23.10,Default,,0000,0000,0000,,Мұнда, Сингапурда—
Dialogue: 0,0:19:28.00,0:19:30.02,Default,,0000,0000,0000,,Жарайды, ыстық бұлақтарға барайық.
Dialogue: 0,0:19:30.02,0:19:32.04,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:32.04,0:19:35.90,Default,,0000,0000,0000,,Жаяу қашықтықта орналасқаны өте жақсы.
Dialogue: 0,0:19:35.90,0:19:39.94,Default,,0000,0000,0000,,Жалаңаш араласудан ләззат алайық Жақсы...
Dialogue: 0,0:19:39.94,0:19:43.48,Default,,0000,0000,0000,,<Жалаңаш? Сіздің арқаңыз... сіз оны көре аласыз!
Dialogue: 0,0:19:43.48,0:19:45.48,Default,,0000,0000,0000,,《Кяк хики! 》
Dialogue: 0,0:19:48.03,0:19:52.91,Default,,0000,0000,0000,,Мм... Ақыр аяғында мен одан аулақ боламын.
Dialogue: 0,0:19:52.91,0:19:55.94,Default,,0000,0000,0000,,Неліктен? Біраз ыңғайсыз...
Dialogue: 0,0:19:55.94,0:19:57.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:57.96,0:19:59.98,Default,,0000,0000,0000,,Мен бұл мүмкін емес деп айтпаймын, бірақ...
Dialogue: 0,0:19:59.98,0:20:01.98,Default,,0000,0000,0000,,Мен үйде боламын.
Dialogue: 0,0:20:02.35,0:20:06.35,Default,,0000,0000,0000,,Онда мен барамын.
Dialogue: 0,0:20:09.08,0:20:11.08,Default,,0000,0000,0000,,күрсіну
Dialogue: 0,0:20:15.97,0:20:17.97,Default,,0000,0000,0000,,Миса...
Dialogue: 0,0:20:31.96,0:20:34.99,Default,,0000,0000,0000,,Бұл сен кінәлі, ақымақ Усуй.
Dialogue: 0,0:20:34.99,0:20:38.03,Default,,0000,0000,0000,,Менің арқам болмаса, мен бәрінің соңынан еруім мүмкін еді.
Dialogue: 0,0:20:38.03,0:20:41.06,Default,,0000,0000,0000,,Сондықтан мен де артта қалдым.
Dialogue: 0,0:20:41.06,0:20:45.06,Default,,0000,0000,0000,,Сонымен не? Бұл кешірілетін күнә деп ойламаңыз.
Dialogue: 0,0:20:46.28,0:20:48.80,Default,,0000,0000,0000,,Сіз сонша барғыңыз келді ме?
Dialogue: 0,0:20:48.80,0:20:51.00,Default,,0000,0000,0000,,Бұл анық. Саяхаттағаныма біраз болды.
Dialogue: 0,0:20:51.00,0:20:53.02,Default,,0000,0000,0000,,Ендеше одан толық ләззат алайық
Dialogue: 0,0:20:53.02,0:20:57.06,Default,,0000,0000,0000,,Мен ыстық бұлақтарға сирек барамын, және
Dialogue: 0,0:20:57.06,0:21:00.06,Default,,0000,0000,0000,,Барлығымен бірге болған жақсы болар еді...
Dialogue: 0,0:21:02.11,0:21:04.11,Default,,0000,0000,0000,,Елес Қорқасың ба?
Dialogue: 0,0:21:06.31,0:21:11.03,Default,,0000,0000,0000,,Жоқ! Менеджердің маған дайындап берген тегін ыстық бұлақ купонын ысырап еттім...
Dialogue: 0,0:21:11.03,0:21:13.05,Default,,0000,0000,0000,,Гаса?
Dialogue: 0,0:21:13.05,0:21:18.10,Default,,0000,0000,0000,,Менеджер~! Неге ұмыттың?
Dialogue: 0,0:21:18.10,0:21:23.15,Default,,0000,0000,0000,,Барлығының ыстық көктемдегі тегін билеттері босқа кеткен сияқты.
Dialogue: 0,0:21:23.15,0:21:25.17,Default,,0000,0000,0000,,Қазір жүгірсең, уақытында боласың, Усуй.
Dialogue: 0,0:21:25.17,0:21:27.52,Default,,0000,0000,0000,,Үйде қалу керек!
Dialogue: 0,0:21:27.52,0:21:33.08,Default,,0000,0000,0000,,Мүмкін жеткізерсіз бе? Бұлай алысқа барудың қажеті жоқ.
Dialogue: 0,0:21:33.08,0:21:35.10,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Бұл тегін билет.
Dialogue: 0,0:21:35.10,0:21:38.97,Default,,0000,0000,0000,,Сіз әдетте ақшасыз кіре алмайтын ыстық бұлақта.
Dialogue: 0,0:21:38.97,0:21:40.99,Default,,0000,0000,0000,,Оны тегін алыңыз!
Dialogue: 0,0:21:40.99,0:21:42.01,Default,,0000,0000,0000,,Мен мұны жалғыз қалдыра алмаймын.
Dialogue: 0,0:21:42.01,0:21:44.01,Default,,0000,0000,0000,,Бірақ елестер пайда болуы мүмкін.
Dialogue: 0,0:21:46.05,0:21:48.40,Default,,0000,0000,0000,,Қорқатын ештеңе жоқ.
Dialogue: 0,0:21:48.40,0:21:52.40,Default,,0000,0000,0000,,Мен мұндай... шындыққа жанаспайтын нәрсеге сенбеймін.
Dialogue: 0,0:22:07.09,0:22:09.95,Default,,0000,0000,0000,,Бұл шынайы болуы мүмкін емес.
Dialogue: 0,0:22:09.95,0:22:12.14,Default,,0000,0000,0000,,Осындай бос сөзден қорқады
Dialogue: 0,0:22:12.14,0:22:16.02,Default,,0000,0000,0000,,Барлығын ақша жұмсауға мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:22:16.02,0:22:18.04,Default,,0000,0000,0000,,Бұл ақымақ...
Dialogue: 0,0:22:18.04,0:22:20.89,Default,,0000,0000,0000,,《 →》
Dialogue: 0,0:22:20.89,0:22:24.09,Default,,0000,0000,0000,,《Ол сондай-ақ аң аулайтын жер ретінде танымал》
Dialogue: 0,0:22:24.09,0:22:26.11,Default,,0000,0000,0000,,Жалпы елестер.
Dialogue: 0,0:22:26.11,0:22:28.11,Default,,0000,0000,0000,,Мен оны бұрын ешқашан көрген емеспін
Dialogue: 0,0:22:31.67,0:22:33.67,Default,,0000,0000,0000,,Неге сену керек...
Dialogue: 0,0:22:38.06,0:22:41.93,Default,,0000,0000,0000,,Иә? Маған ұнамайды
Dialogue: 0,0:22:41.93,0:22:43.93,Default,,0000,0000,0000,,Бұл қай жерде...
Dialogue: 0,0:22:56.08,0:22:58.08,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:23:01.96,0:23:03.96,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:23:23.01,0:23:25.01,Default,,0000,0000,0000,,Бұл не, Усуй?
Dialogue: 0,0:23:28.06,0:23:30.92,Default,,0000,0000,0000,,Сізді таң қалдырғаны үшін кешіріңіз.
Dialogue: 0,0:23:30.92,0:23:34.12,Default,,0000,0000,0000,,Дүкеннің есігі құлыптаулы, ендеше бірге барайық.
Dialogue: 0,0:23:34.12,0:23:36.12,Default,,0000,0000,0000,,Тұру керек пе?
Dialogue: 0,0:23:39.51,0:23:41.03,Default,,0000,0000,0000,,Шынымен
Dialogue: 0,0:23:41.03,0:23:43.03,Default,,0000,0000,0000,,Бұл ақылсыз
Dialogue: 0,0:23:47.09,0:23:49.09,Default,,0000,0000,0000,,Не...
Dialogue: 0,0:23:53.98,0:23:57.98,Default,,0000,0000,0000,,Мен бұған мүлдем күш салып жатқан жоқпын, Аюзава.
Dialogue: 0,0:23:58.03,0:24:00.05,Default,,0000,0000,0000,,Әлі де қорқасыз ба?
Dialogue: 0,0:24:00.05,0:24:02.40,Default,,0000,0000,0000,,Сен мені мазақ етіп тұрсың.
Dialogue: 0,0:24:02.40,0:24:04.92,Default,,0000,0000,0000,,Менде жоқ.
Dialogue: 0,0:24:04.92,0:24:07.95,Default,,0000,0000,0000,,Сен менің әлсіз тұсымды ұстап, мені тағы да мазақ етейін деп жатырсың.
Dialogue: 0,0:24:07.95,0:24:10.98,Default,,0000,0000,0000,,Хе, қарғыс атсын, енді жібер.
Dialogue: 0,0:24:10.98,0:24:13.01,Default,,0000,0000,0000,,Аюзава тынышталғанша жіберме
Dialogue: 0,0:24:13.01,0:24:15.01,Default,,0000,0000,0000,,Мен дәл осындамын.
Dialogue: 0,0:24:17.05,0:24:20.05,Default,,0000,0000,0000,,Бұл не... Идиот Усуй
Dialogue: 0,0:24:22.27,0:24:24.79,Default,,0000,0000,0000,,Не істеп жүрсің?
Dialogue: 0,0:24:24.79,0:24:28.00,Default,,0000,0000,0000,,Маған демалыс берші, мен сенімен көшенің қақ ортасында жарасып жатырмын.
Dialogue: 0,0:24:28.00,0:24:30.02,Default,,0000,0000,0000,,Мен сенімен сырласып жүрген сияқты емеспін.
Dialogue: 0,0:24:30.02,0:24:32.88,Default,,0000,0000,0000,,Неге қазір алдауға тырысып жатырсың?
Dialogue: 0,0:24:32.88,0:24:36.08,Default,,0000,0000,0000,,Сіз әлдеқашан кездесіп жүрсіз бе? Біз кездеспейміз!
Dialogue: 0,0:24:36.08,0:24:39.11,Default,,0000,0000,0000,,（）
Dialogue: 0,0:24:39.11,0:24:42.14,Default,,0000,0000,0000,,Бұл... қазірдің өзінде тітіркендіргіш →
Dialogue: 0,0:24:42.14,0:24:44.49,Default,,0000,0000,0000,,Мен сізге ұнайсыз, солай ма? Мойында.
Dialogue: 0,0:24:44.49,0:24:46.49,Default,,0000,0000,0000,,Сондықтан басқаша.
Dialogue: 0,0:24:59.97,0:25:03.01,Default,,0000,0000,0000,,〈Осылайша, Maid Latte Inn Beach House-тің бірінші күні〉
Dialogue: 0,0:25:03.01,0:25:08.01,Default,,0000,0000,0000,,〈Біз әдеттегіден сәл ыстық болатын түнгі самалда өттік〉
Dialogue: 0,0:25:09.41,0:25:11.93,Default,,0000,0000,0000,,Ванна жақсы.
Dialogue: 0,0:25:11.93,0:25:14.96,Default,,0000,0000,0000,,Бұл тек ыстық бұлақтармен шектеледі.
Dialogue: 0,0:25:14.96,0:25:17.15,Default,,0000,0000,0000,,Бұл қосымша ақшаға тегін билет.
Dialogue: 0,0:25:17.15,0:25:19.01,Default,,0000,0000,0000,,Гаан!
Dialogue: 0,0:25:19.01,0:25:21.03,Default,,0000,0000,0000,,Олай болса, ішке кірейік.
Dialogue: 0,0:25:21.03,0:25:23.03,Default,,0000,0000,0000,,Мен ерлердің ваннасын жек көремін!
Dialogue: 0,0:25:24.06,0:26:00.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:01.10,0:26:53.95,Default,,0000,0000,0000,,
Dialogue: 0,0:26:55.45,0:27:01.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory