Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:41.87,0:00:43.91,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:00:44.00,0:00:46.25,Default,,0,0,0,,Бұл Кампания ма?
Dialogue: 0,0:00:46.33,0:00:47.83,Default,,0,0,0,,Үлкен
Dialogue: 0,0:00:47.92,0:00:49.88,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:00:50.63,0:00:52.96,Default,,0,0,0,,A66 бірінші класты пакетіне
Dialogue: 0,0:00:55.09,0:00:56.47,Default,,0,0,0,,Кампания...
Dialogue: 0,0:00:58.05,0:01:00.18,Default,,0,0,0,,Majestic Star Line, Inc.
Dialogue: 0,0:01:00.26,0:01:03.02,Default,,0,0,0,,Кәсіпорын салынып, пайдалануға берілген кезде оның байлығы қауіпке ұшырады.
Dialogue: 0,0:01:03.10,0:01:05.77,Default,,0,0,0,,Бұл Атлант мұхиты арқылы жүзетін супер люкс лайнер.
Dialogue: 0,0:01:05.85,0:01:08.40,Default,,0,0,0,,Қарап-ақ толқып кетемін.
Dialogue: 0,0:01:08.48,0:01:10.48,Default,,0,0,0,,Керемет, жылан мырза менімен бірге бара алады.
Dialogue: 0,0:01:10.57,0:01:13.19,Default,,0,0,0,,Балаға жақсы қарау.
Dialogue: 0,0:01:13.28,0:01:15.28,Default,,0,0,0,,Қайықпен саяхаттау – менің арманым.
Dialogue: 0,0:01:16.11,0:01:19.99,Default,,0,0,0,,Мен жоқ болсам, жұмысыңда бәрі саған тәуелді болады.
Dialogue: 0,0:01:20.08,0:01:21.24,Default,,0,0,0,,Бір, екі, үш.
Dialogue: 0,0:01:21.33,0:01:22.45,Default,,0,0,0,,Хо хо хо
Dialogue: 0,0:01:26.46,0:01:28.25,Default,,0,0,0,,Кеттік
Dialogue: 0,0:01:28.75,0:01:30.29,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:30.38,0:01:31.54,Default,,0,0,0,,Абайлаңыз~
Dialogue: 0,0:01:32.67,0:01:33.71,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:01:33.80,0:01:35.84,Default,,0,0,0,,Егер сіз кемеге отырсаңыз, асығыңыз.
Dialogue: 0,0:01:36.84,0:01:38.97,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:01:39.05,0:01:40.26,Default,,0,0,0,,Әй!
Dialogue: 0,0:01:40.76,0:01:42.31,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:01:47.56,0:01:50.44,Default,,0,0,0,,Қош келдің, балақай!
Dialogue: 0,0:02:01.45,0:02:05.04,Default,,0,0,0,,Уф, қауіпсіз емес!
Dialogue: 0,0:02:05.12,0:02:07.83,Default,,0,0,0,,Жоспарлағандай аман-есен жүзіп шықтық.
Dialogue: 0,0:02:08.41,0:02:11.58,Default,,0,0,0,,Тегіс жүзу! Болашағы жарқын!
Dialogue: 0,0:02:12.38,0:02:14.13,Default,,0,0,0,,Біз үшін
Dialogue: 0,0:02:29.23,0:02:31.60,Default,,0,0,0,,Сіз желкенге шықтыңыз.
Dialogue: 0,0:02:31.69,0:02:32.52,Default,,0,0,0,,О
Dialogue: 0,0:02:32.61,0:02:35.11,Default,,0,0,0,,Бізді алда не күтіп тұр...
Dialogue: 0,0:02:35.61,0:02:39.15,Default,,0,0,0,,Сен тек Атлант мұхиты туралы білесің бе?
Dialogue: 0,0:02:44.08,0:02:45.29,Default,,0,0,0,,Яғни, мұнда
Dialogue: 0,0:02:45.37,0:02:47.62,Default,,0,0,0,,Өлгендерді тірілтемін дейсіз бе?
Dialogue: 0,0:02:47.70,0:02:49.29,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:02:50.12,0:02:53.17,Default,,0,0,0,,Өкінішке орай, оккультизмдегі хоббиім...
Dialogue: 0,0:02:53.25,0:02:55.17,Default,,0,0,0,,Бұл оккультизм болмаса ше?
Dialogue: 0,0:02:55.25,0:02:55.92,Default,,0,0,0,,Не?
Dialogue: 0,0:02:56.00,0:02:57.80,Default,,0,0,0,,Карнштейн ауруханасы
Dialogue: 0,0:02:58.46,0:03:01.93,Default,,0,0,0,,Менің граф маған басқаруды сеніп тапсырған артқы портта.
Dialogue: 0,0:03:02.01,0:03:03.89,Default,,0,0,0,,Сіз көп сауда жасап жатқан сияқтысыз.
Dialogue: 0,0:03:04.80,0:03:05.60,Default,,0,0,0,,Медицина?
Dialogue: 0,0:03:06.76,0:03:08.56,Default,,0,0,0,,Жоқ... адамдар
Dialogue: 0,0:03:09.14,0:03:11.69,Default,,0,0,0,,Мен шетелден заңсыз сатып алудамын.
Dialogue: 0,0:03:11.77,0:03:13.77,Default,,0,0,0,,Өте аз.
Dialogue: 0,0:03:16.57,0:03:17.32,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:03:17.40,0:03:22.03,Default,,0,0,0,,Адамның заңсыз эксперименттері арқылы өлгендерді тірілту...
Dialogue: 0,0:03:22.11,0:03:23.66,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:03:24.74,0:03:25.66,Default,,0,0,0,,Хмм…
Dialogue: 0,0:03:25.74,0:03:28.58,Default,,0,0,0,,Егер бұл рас болса, бұл, әрине, мәселе.
Dialogue: 0,0:03:29.29,0:03:33.08,Default,,0,0,0,,Раушан тікенектері қолыңызға зақым келтірмес бұрын ғана алып тастаңыз.
Dialogue: 0,0:03:33.58,0:03:35.71,Default,,0,0,0,,Себастьян, дереу тексер.
Dialogue: 0,0:03:35.79,0:03:37.13,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:03:43.22,0:03:44.14,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:03:44.22,0:03:45.85,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:03:45.93,0:03:47.68,Default,,0,0,0,,Бұрынғыдай жылдам
Dialogue: 0,0:03:47.76,0:03:49.77,Default,,0,0,0,,О, бұл қандай көрінеді?
Dialogue: 0,0:03:50.48,0:03:53.60,Default,,0,0,0,,Қалаға кіргенде, қалаға бағын.
Dialogue: 0,0:03:54.10,0:03:57.32,Default,,0,0,0,,Мен тағы да қызықты ақпарат алдым.
Dialogue: 0,0:03:57.94,0:03:58.69,Default,,0,0,0,,Не?
Dialogue: 0,0:03:59.19,0:04:00.61,Default,,0,0,0,,Сөйлеген медбикенің айтуы бойынша
Dialogue: 0,0:04:01.40,0:04:02.99,Default,,0,0,0,,Карнштейн ауруханасы
Dialogue: 0,0:04:03.07,0:04:06.32,Default,,0,0,0,,Ол «Аврора қоғамы» деп аталатын құпия қоғамды басқарады.
Dialogue: 0,0:04:06.41,0:04:09.37,Default,,0,0,0,,Біздің ұранымыз – адамзатты медицина арқылы толық құтқару.
Dialogue: 0,0:04:09.45,0:04:11.04,Default,,0,0,0,,Дворяндардың қолдауымен
Dialogue: 0,0:04:11.12,0:04:14.21,Default,,0,0,0,,Олар адамдарға заңсыз эксперименттер жүргізіп жатқан көрінеді.
Dialogue: 0,0:04:14.29,0:04:18.54,Default,,0,0,0,,Өкінішке орай, ауруханада бұл туралы ешқандай дәлел табылмады.
Dialogue: 0,0:04:18.63,0:04:23.26,Default,,0,0,0,,Менің Аврора қоғамының жиналысына жасырын кіруден басқа амалым жоқ деп ойлаймын.
Dialogue: 0,0:04:23.34,0:04:23.84,Default,,0,0,0,,Иә
Dialogue: 0,0:04:24.55,0:04:27.68,Default,,0,0,0,,Айтпақшы, келесі кездесу 17 сәуірде.
Dialogue: 0,0:04:28.35,0:04:32.06,Default,,0,0,0,,Саутгемптоннан аттанатын круиздік кеменің бортында жоспарланған
Dialogue: 0,0:04:32.14,0:04:32.73,Default,,0,0,0,,Хун
Dialogue: 0,0:04:32.81,0:04:36.31,Default,,0,0,0,,Кемедегі кездесу өте ақсүйектік
Dialogue: 0,0:04:36.90,0:04:39.44,Default,,0,0,0,,Иә? 17 сәуір?
Dialogue: 0,0:04:39.52,0:04:40.19,Default,,0,0,0,,Ах
Dialogue: 0,0:04:40.78,0:04:43.19,Default,,0,0,0,,Мен сәуірде отбасылық саяхатқа барамын!
Dialogue: 0,0:04:43.28,0:04:47.16,Default,,0,0,0,,17-ден үш апта: Нью-Йоркке сәнді круиздік кемеде саяхат
Dialogue: 0,0:04:47.24,0:04:49.37,Default,,0,0,0,,Әкем Сиелді бізге қосылуын өтінді.
Dialogue: 0,0:04:50.41,0:04:51.37,Default,,0,0,0,,Бұл кеме қалай аталады?
Dialogue: 0,0:04:51.45,0:04:54.71,Default,,0,0,0,,Majestic Star Line сәнді круиздік кемесі
Dialogue: 0,0:04:55.29,0:04:56.87,Default,,0,0,0,,Кампания
Dialogue: 0,0:05:04.55,0:05:06.55,Default,,0,0,0,,♪～
Dialogue: 0,0:05:14.39,0:05:16.39,Default,,0,0,0,,～♪
Dialogue: 0,0:05:17.77,0:05:19.27,Default,,0,0,0,,Сиел?
Dialogue: 0,0:05:20.73,0:05:21.57,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:05:21.65,0:05:24.86,Default,,0,0,0,,Мен сізді кеше шақырғанымда, мүмкін емес дедіңіз.
Dialogue: 0,0:05:24.94,0:05:27.86,Default,,0,0,0,,Әй... Мен сені таң қалдырмақ болдым.
Dialogue: 0,0:05:27.95,0:05:30.45,Default,,0,0,0,,Мен үшін демалдың ба?
Dialogue: 0,0:05:30.53,0:05:31.74,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,0:05:31.83,0:05:33.20,Default,,0,0,0,,Элизабет
Dialogue: 0,0:05:33.29,0:05:35.62,Default,,0,0,0,,Қоғамдық орындарда басқаларға ұқсаудан аулақ болыңыз.
Dialogue: 0,0:05:35.71,0:05:37.71,Default,,0,0,0,,Анаң дұрыс айтады, Лиззи.
Dialogue: 0,0:05:37.79,0:05:39.13,Default,,0,0,0,,Және...
Dialogue: 0,0:05:39.21,0:05:43.71,Default,,0,0,0,,Мен сені әлі күнге дейін жездем деп қабылдамаймын.
Dialogue: 0,0:05:43.80,0:05:45.26,Default,,0,0,0,,Тез кет!
Dialogue: 0,0:05:45.34,0:05:45.88,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:05:46.47,0:05:48.93,Default,,0,0,0,,Сен менің ағам болсаң, тағы да айтар едің.
Dialogue: 0,0:05:49.01,0:05:49.89,Default,,0,0,0,,J-
Dialogue: 0,0:05:49.97,0:05:50.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:50.93,0:05:53.68,Default,,0,0,0,,Ми... Мидфордтық Маркес...
Dialogue: 0,0:05:53.77,0:05:55.89,Default,,0,0,0,,Мен сені көрмегелі көп болды.
Dialogue: 0,0:05:56.39,0:05:59.02,Default,,0,0,0,,Көп болды, болашақ ұлым!
Dialogue: 0,0:05:59.10,0:06:00.19,Default,,0,0,0,,Әдеттегідей сүйкімді!
Dialogue: 0,0:06:00.27,0:06:02.07,Default,,0,0,0,,- Сіз! - (Эдуард) Әке!
Dialogue: 0,0:06:06.90,0:06:09.91,Default,,0,0,0,,Сонымен, біз үш апта бірге бола аламыз ба?
Dialogue: 0,0:06:09.99,0:06:10.99,Default,,0,0,0,,О
Dialogue: 0,0:06:11.07,0:06:12.95,Default,,0,0,0,,Біз бірінші рет мұнша көп бірге болдық!
Dialogue: 0,0:06:13.03,0:06:16.04,Default,,0,0,0,,Мені кешкі асқа шығарып салуыңызды өтінемін, Сиэл.
Dialogue: 0,0:06:16.12,0:06:17.66,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:06:18.16,0:06:20.08,Default,,0,0,0,,-(Эдвард) Нух~ -Ах...
Dialogue: 0,0:06:20.88,0:06:22.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:22.09,0:06:23.34,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:23.42,0:06:25.00,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:06:25.51,0:06:28.59,Default,,0,0,0,,Әдеттегі жиналыс 19-ға қараған түні өтеді.
Dialogue: 0,0:06:29.55,0:06:31.93,Default,,0,0,0,,Неліктен анда-санда демалуға болмайды?
Dialogue: 0,0:06:33.55,0:06:36.35,Default,,0,0,0,,Мен киінуім керек хехехехе
Dialogue: 0,0:06:37.14,0:06:39.14,Default,,0,0,0,,Ал...кейде, жарай ма?
Dialogue: 0,0:06:39.23,0:06:42.27,Default,,0,0,0,,Эй, мен демалыстамын ғой, рас па?
Dialogue: 0,0:06:42.36,0:06:43.11,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:43.69,0:06:45.57,Default,,0,0,0,,Лорд Грей және Лорд Фиппс те.
Dialogue: 0,0:06:45.65,0:06:47.61,Default,,0,0,0,,Көптен бері кездеспедік, Мистер Мидфорд.
Dialogue: 0,0:06:47.69,0:06:48.86,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:49.36,0:06:51.03,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:06:51.11,0:06:53.07,Default,,0,0,0,,Бұл менің жолым.
Dialogue: 0,0:06:53.16,0:06:58.29,Default,,0,0,0,,Біз Мәртебелі Королеваның атынан осы кеменің алғашқы сапарына шақырылдық.
Dialogue: 0,0:06:58.91,0:07:01.50,Default,,0,0,0,,Содан мен күтпеген адамды кездестірдім.
Dialogue: 0,0:07:01.58,0:07:03.25,Default,,0,0,0,,Сондықтан мен сізге қоңырау шалуға тырыстым.
Dialogue: 0,0:07:03.33,0:07:06.84,Default,,0,0,0,,Әйтеуір, сен өлген жоқсың ғой.
Dialogue: 0,0:07:06.92,0:07:09.72,Default,,0,0,0,,Мен қайта демімді баса алмадым.
Dialogue: 0,0:07:09.80,0:07:13.68,Default,,0,0,0,,Бәлкім, біреу мені аяусыз тепкендіктен шығар.
Dialogue: 0,0:07:13.76,0:07:14.97,Default,,0,0,0,,Я~
Dialogue: 0,0:07:15.05,0:07:17.72,Default,,0,0,0,,Ал, мен сол кісіге алғыс айтуым керек.
Dialogue: 0,0:07:17.81,0:07:18.64,Default,,0,0,0,,Бұл құтқарушы
Dialogue: 0,0:07:19.68,0:07:20.69,Default,,0,0,0,,Қош бол
Dialogue: 0,0:07:20.77,0:07:24.23,Default,,0,0,0,,Саяхатыңыз жақсы болады деп үміттенемін.
Dialogue: 0,0:07:24.31,0:07:25.94,Default,,0,0,0,,Бір-біріне
Dialogue: 0,0:07:34.62,0:07:40.62,Default,,0,0,0,,(Адамдардың сөйлескен дыбыстары)
Dialogue: 0,0:07:44.00,0:07:47.09,Default,,0,0,0,,Фуфуфу аа! Сиелге ұқсайды
Dialogue: 0,0:07:47.17,0:07:48.75,Default,,0,0,0,,Мына торт сүйкімді!
Dialogue: 0,0:07:48.84,0:07:50.47,Default,,0,0,0,,Мен Сиелге де аздап аламын.
Dialogue: 0,0:07:50.55,0:07:51.97,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:07:52.97,0:07:55.09,Default,,0,0,0,,Эрл Кроуфорд күткендей...
Dialogue: 0,0:07:55.18,0:07:57.39,Default,,0,0,0,,Нағыз ақсүйектер болып табылатындар
Dialogue: 0,0:07:57.47,0:08:00.14,Default,,0,0,0,,Біз күнде жиналып, маңызды емес нәрселер туралы сөйлесеміз.
Dialogue: 0,0:08:00.85,0:08:03.98,Default,,0,0,0,,Жұмысты тастағаны үшін өзімді ақымақ сезіне бастадым.
Dialogue: 0,0:08:04.48,0:08:05.61,Default,,0,0,0,,Сонымен ертең
Dialogue: 0,0:08:05.69,0:08:08.82,Default,,0,0,0,,Маршионерден қылыштасу сабағын алғыңыз келе ме?
Dialogue: 0,0:08:08.90,0:08:12.36,Default,,0,0,0,,Сіз маған Азаттық мүсінінің бетіне табынуға рұқсат бермейсіз бе?
Dialogue: 0,0:08:12.95,0:08:14.03,Default,,0,0,0,,Одан да көп, Ботчан.
Dialogue: 0,0:08:14.70,0:08:15.70,Default,,0,0,0,,Бүгін түн.
Dialogue: 0,0:08:16.28,0:08:16.99,Default,,0,0,0,,О
Dialogue: 0,0:08:17.49,0:08:19.12,Default,,0,0,0,,Сіз сусын алғыңыз келе ме?
Dialogue: 0,0:08:23.96,0:08:24.83,Default,,0,0,0,,Осымен.
Dialogue: 0,0:08:25.92,0:08:28.09,Default,,0,0,0,,Аврора қоғамының ашылу сигналы
Dialogue: 0,0:08:28.17,0:08:32.13,Default,,0,0,0,,Даяшы бос рюмканы көтеріп залды айналып өтіп бара жатқан көрінеді.
Dialogue: 0,0:08:32.22,0:08:33.13,Default,,0,0,0,,Бұл карта сәл ақымақтай көрінбей ме?
Dialogue: 0,0:08:34.76,0:08:36.43,Default,,0,0,0,,Оны тастаңыз.
Dialogue: 0,0:08:36.51,0:08:37.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:42.93,0:08:43.43,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:44.69,0:08:45.90,Default,,0,0,0,,Йошикава шынымен де оның жағдайын ойлап жүр…
Dialogue: 0,0:08:47.48,0:08:50.57,Default,,0,0,0,,Өйткені, але талғампаз шампаннан жақсы!
Dialogue: 0,0:08:50.65,0:08:52.11,Default,,0,0,0,,Сіз де солай ойлайсыз, солай ма?
Dialogue: 0,0:08:52.69,0:08:57.11,Default,,0,0,0,,Жарайды, бірақ егер сіз онымен бірге ішетін болсаңыз, сіз шампанның нағыз брендін алғыңыз келеді.
Dialogue: 0,0:08:57.20,0:08:59.87,Default,,0,0,0,,Керемет~ Мен сенің қызыңды қызғанамын
Dialogue: 0,0:08:59.95,0:09:01.62,Default,,0,0,0,,Сен болсаң жақсы болар еді.
Dialogue: 0,0:09:01.70,0:09:02.66,Default,,0,0,0,,Не? Сен жоқсың ба?
Dialogue: 0,0:09:02.75,0:09:04.79,Default,,0,0,0,,Өтірік Айтыңызшы...
Dialogue: 0,0:09:04.87,0:09:08.17,Default,,0,0,0,,Сондықтан онсыз да менің уақытым бар.
Dialogue: 0,0:09:08.67,0:09:10.13,Default,,0,0,0,,Бос уақытымызда...
Dialogue: 0,0:09:10.21,0:09:11.96,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:09:15.72,0:09:17.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:17.18,0:09:18.64,Default,,0,0,0,,ол немесе сенімге толы қуғыншы,
Dialogue: 0,0:09:19.14,0:09:20.47,Default,,0,0,0,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:09:21.31,0:09:22.56,Default,,0,0,0,,«Соған қарамастан дәрігерлер шынымен де өте бос болады екен, иә?»
Dialogue: 0,0:09:22.64,0:09:25.85,Default,,0,0,0,,Аврора қоғамының сәлемдесуі бар.
Dialogue: 0,0:09:25.94,0:09:27.94,Default,,0,0,0,,Білмейтіндерден ойын орнынан кету сұралады.
Dialogue: 0,0:09:28.02,0:09:30.27,Default,,0,0,0,,Мұндайды тез айт!
Dialogue: 0,0:09:30.36,0:09:32.07,Default,,0,0,0,,Бұл қандай сәлемдесу?
Dialogue: 0,0:09:32.15,0:09:32.69,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:33.69,0:09:34.65,Default,,0,0,0,,Құпия сөз...
Dialogue: 0,0:09:35.70,0:09:36.20,Default,,0,0,0,,Не!
Dialogue: 0,0:09:37.45,0:09:39.03,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:09:39.12,0:09:40.74,Default,,0,0,0,,Сіз шынымен солай істедіңіз бе?
Dialogue: 0,0:09:40.83,0:09:44.66,Default,,0,0,0,,Егер сіз мұны істей алмасаңыз, сіз сырттан қаралып, бірден оқудан шығарыласыз.
Dialogue: 0,0:09:44.75,0:09:46.66,Default,,0,0,0,,Ешқашан ойланбаңыз
Dialogue: 0,0:09:46.75,0:09:48.12,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:49.50,0:09:51.54,Default,,0,0,0,,Жүр, кеттік
Dialogue: 0,0:09:51.63,0:09:52.55,Default,,0,0,0,,Иә
Dialogue: 0,0:09:53.50,0:09:54.67,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:03.68,0:10:05.27,Default,,0,0,0,,Сіз бірінші рет келіп тұрсыз ба?
Dialogue: 0,0:10:05.35,0:10:06.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:09.02,0:10:12.52,Default,,0,0,0,,Немесе… «Керемет кеуде жалыны»
Dialogue: 0,0:10:12.61,0:10:15.11,Default,,0,0,0,,«Оны ешкім өшіре алмайды»
Dialogue: 0,0:10:15.19,0:10:15.86,Default,,0,0,0,,«Біз»
Dialogue: 0,0:10:15.94,0:10:16.53,Default,,0,0,0,,«Біз»
Dialogue: 0,0:10:17.40,0:10:18.90,Default,,0,0,0,,«Феникс»
Dialogue: 0,0:10:19.82,0:10:22.20,Default,,0,0,0,,Бұл қандай поза?
Dialogue: 0,0:10:22.28,0:10:24.45,Default,,0,0,0,,Менің ойымша, бұл өте дұрыс емес.
Dialogue: 0,0:10:24.54,0:10:28.46,Default,,0,0,0,,Егер қателессең, бәрі бұзылады, Себастьян!
Dialogue: 0,0:10:29.46,0:10:30.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:31.58,0:10:33.25,Default,,0,0,0,,«Феникс»!
Dialogue: 0,0:10:33.34,0:10:35.67,Default,,0,0,0,,Аврора қоғамына қош келдіңіз!
Dialogue: 0,0:10:35.76,0:10:38.05,Default,,0,0,0,,Мүшелік билет белгісі
Dialogue: 0,0:10:38.13,0:10:40.63,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:10:41.93,0:10:43.80,Default,,0,0,0,,Мен мұны енді ешқашан жасамаймын
Dialogue: 0,0:10:44.43,0:10:46.77,Default,,0,0,0,,) Ухьяхьяхьяхья!
Dialogue: 0,0:10:46.85,0:10:48.60,Default,,0,0,0,,Өте ыстық!
Dialogue: 0,0:10:48.68,0:10:51.56,Default,,0,0,0,,Мен сені мұндай әрекетке барады деп ойламаппын.
Dialogue: 0,0:10:51.65,0:10:52.61,Default,,0,0,0,,Жетекші!
Dialogue: 0,0:10:52.69,0:10:55.73,Default,,0,0,0,,Байсалды жүзбен «Феникс»
Dialogue: 0,0:10:55.82,0:10:57.23,Default,,0,0,0,,Ахахахаха
Dialogue: 0,0:10:57.32,0:10:58.36,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:10:58.44,0:10:59.86,Default,,0,0,0,,Ал, балам.
Dialogue: 0,0:11:00.36,0:11:02.24,Default,,0,0,0,,Оның орнына не үшін келдің?
Dialogue: 0,0:11:03.95,0:11:07.33,Default,,0,0,0,,Мектеп тапсырмасын ұмыттыңыз ба?
Dialogue: 0,0:11:07.41,0:11:10.71,Default,,0,0,0,,Ауруханалар жерлеу директорларының жақсы клиенттері болып табылады.
Dialogue: 0,0:11:12.21,0:11:16.25,Default,,0,0,0,,Сіз мұнда не болып жатқаны туралы бірдеңе білесіз бе?
Dialogue: 0,0:11:16.34,0:11:17.30,Default,,0,0,0,,Ой
Dialogue: 0,0:11:17.38,0:11:20.42,Default,,0,0,0,,Ақпарат алғыңыз келсе, сіз оны төлеуіңіз керек.
Dialogue: 0,0:11:20.51,0:11:22.34,Default,,0,0,0,,Сен мені көп күлдірдің ғой, солай ма?
Dialogue: 0,0:11:22.43,0:11:23.64,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:24.26,0:11:26.43,Default,,0,0,0,,Сонымен, сол позаны қайталап көрсек қалай болады?
Dialogue: 0,0:11:28.02,0:11:28.60,Default,,0,0,0,,Кім...
Dialogue: 0,0:11:28.68,0:11:29.93,Default,,0,0,0,,«Феникс»!
Dialogue: 0,0:11:31.56,0:11:34.06,Default,,0,0,0,,Менің жеке келісімім үшін кешірім сұраймын.
Dialogue: 0,0:11:34.15,0:11:36.82,Default,,0,0,0,,Бұл Виконт Друитт пе?
Dialogue: 0,0:11:36.90,0:11:39.65,Default,,0,0,0,,Ойлап қарасам, оның медициналық лицензиясы бар екен.
Dialogue: 0,0:11:42.24,0:11:43.41,Default,,0,0,0,,Уф... Мен мұнда келдім.
Dialogue: 0,0:11:44.24,0:11:46.41,Default,,0,0,0,,Әй, сендер жаңадан келгенсіңдер ме?
Dialogue: 0,0:11:46.49,0:11:47.74,Default,,0,0,0,,-Ух... -Иә.
Dialogue: 0,0:11:47.83,0:11:50.12,Default,,0,0,0,,Мен оны газеттегі мақаладан көрдім.
Dialogue: 0,0:11:50.62,0:11:51.12,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:51.21,0:11:54.04,Default,,0,0,0,,Мен сені бір жерде кездестірдім бе?
Dialogue: 0,0:11:54.13,0:11:56.50,Default,,0,0,0,,Жоқ... Жоқ, біз бірінші рет кездесіп тұрғанымыз сөзсіз!
Dialogue: 0,0:11:59.84,0:12:02.55,Default,,0,0,0,,Расында да сендей сұлу бала.
Dialogue: 0,0:12:02.63,0:12:05.01,Default,,0,0,0,,Оны бір рет көрсең, оны ешқашан ұмытпайсың
Dialogue: 0,0:12:05.51,0:12:09.56,Default,,0,0,0,,А... бәрібір аянышты таңғыш.
Dialogue: 0,0:12:09.64,0:12:11.14,Default,,0,0,0,,Әй... әкем
Dialogue: 0,0:12:11.23,0:12:14.44,Default,,0,0,0,,Мұнда келсең, емделуге болады!
Dialogue: 0,0:12:15.94,0:12:16.86,Default,,0,0,0,,Әке?
Dialogue: 0,0:12:19.40,0:12:20.44,Default,,0,0,0,,Ой, балалар
Dialogue: 0,0:12:20.53,0:12:22.03,Default,,0,0,0,,Басталып жатыр
Dialogue: 0,0:12:35.04,0:12:38.34,Default,,0,0,0,,Бұл менің Аврора қоғамымның негізін қалаушы.
Dialogue: 0,0:12:38.42,0:12:40.09,Default,,0,0,0,,Лин Стокер
Dialogue: 0,0:12:40.75,0:12:45.26,Default,,0,0,0,,«Менің жүрегімдегі тамаша жалынды ешкім өшіре алмайды».
Dialogue: 0,0:12:46.80,0:12:47.30,Default,,0,0,0,,«Біз»
Dialogue: 0,0:12:48.18,0:12:50.26,Default,,0,0,0,,«Феникс»!
Dialogue: 0,0:12:50.35,0:12:52.48,Default,,0,0,0,,«Феникс»!
Dialogue: 0,0:12:54.02,0:12:56.69,Default,,0,0,0,,Барлығы, бүгін Аврора қоғамы.
Dialogue: 0,0:12:56.77,0:13:01.40,Default,,0,0,0,,«Адамзаттың медицина арқылы толық құтқарылуы» тақырыбындағы зерттеу презентациясына келіңіз.
Dialogue: 0,0:13:01.48,0:13:02.53,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:03.24,0:13:05.45,Default,,0,0,0,,Толық рельеф дегеніміз не?
Dialogue: 0,0:13:05.53,0:13:07.87,Default,,0,0,0,,Бұл мінсіз денсаулық
Dialogue: 0,0:13:08.37,0:13:10.08,Default,,0,0,0,,Дені сау
Dialogue: 0,0:13:10.16,0:13:11.37,Default,,0,0,0,,Сау тістер
Dialogue: 0,0:13:11.45,0:13:12.83,Default,,0,0,0,,Салауатты ақыл
Dialogue: 0,0:13:12.91,0:13:14.33,Default,,0,0,0,,Салауатты ауа райы
Dialogue: 0,0:13:15.21,0:13:17.04,Default,,0,0,0,,Денсаулық шынымен керемет!
Dialogue: 0,0:13:17.12,0:13:19.04,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:13:21.17,0:13:22.00,Default,,0,0,0,,Бізде бар
Dialogue: 0,0:13:22.09,0:13:26.59,Default,,0,0,0,,Қанша тырыссаңыз да, денсаулықтың ең үлкен түрі бар, оны жеңу мүмкін емес.
Dialogue: 0,0:13:27.55,0:13:28.39,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:30.76,0:13:31.85,Default,,0,0,0,,Өлім
Dialogue: 0,0:13:32.77,0:13:37.14,Default,,0,0,0,,Бізді сол апаттан құтқаратын ғажайып күш.
Dialogue: 0,0:13:37.65,0:13:41.73,Default,,0,0,0,,Бұл Аврора қоғамының дәрісі.
Dialogue: 0,0:13:41.82,0:13:44.69,Default,,0,0,0,,Енді біз сіздермен зерттеу нәтижелерімізбен бөлісеміз.
Dialogue: 0,0:13:44.78,0:13:48.61,Default,,0,0,0,,«Адамзаттың медицина арқылы толық құтқарылуын» қарастырайық.
Dialogue: 0,0:13:52.87,0:13:55.25,Default,,0,0,0,,Маргарет Коннор 17 жаста
Dialogue: 0,0:13:55.87,0:13:59.42,Default,,0,0,0,,Ол жас кезінде бақытсыз жағдайда қайтыс болды.
Dialogue: 0,0:13:59.50,0:14:01.13,Default,,0,0,0,,Өте ауыр
Dialogue: 0,0:14:01.63,0:14:05.21,Default,,0,0,0,,Оның өлімі оның отбасын психикалық тұрғыдан сау емес етті.
Dialogue: 0,0:14:05.80,0:14:06.88,Default,,0,0,0,,Мен оларды қалаймын...
Dialogue: 0,0:14:06.97,0:14:08.26,Default,,0,0,0,,Мәйіт шын ба?
Dialogue: 0,0:14:08.34,0:14:08.93,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:14:09.76,0:14:12.35,Default,,0,0,0,,Мұрнымды қайыратын өлім иісі бар.
Dialogue: 0,0:14:12.85,0:14:15.47,Default,,0,0,0,,Енді оны барлығына қарап көрейік.
Dialogue: 0,0:14:15.56,0:14:17.14,Default,,0,0,0,,Медицинаның құдіреті!
Dialogue: 0,0:14:20.31,0:14:22.36,Default,,0,0,0,,Толық жеңілдік!
Dialogue: 0,0:14:31.49,0:14:34.33,Default,,0,0,0,,О... уақыт келді.
Dialogue: 0,0:14:34.41,0:14:35.49,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:14:35.58,0:14:37.33,Default,,0,0,0,,Кішкене жұмыс
Dialogue: 0,0:14:37.83,0:14:39.37,Default,,0,0,0,,Иә? қазірдің өзінде?
Dialogue: 0,0:14:39.46,0:14:41.67,Default,,0,0,0,,Ендеше, ертең де осында кездеспейміз бе?
Dialogue: 0,0:14:42.17,0:14:42.96,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:45.25,0:14:46.55,Default,,0,0,0,,Тірі кездессем
Dialogue: 0,0:14:46.63,0:14:48.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:49.63,0:14:52.51,Default,,0,0,0,,Әй, Феникстей тіріл
Dialogue: 0,0:15:01.44,0:15:03.69,Default,,0,0,0,,О... қозғалды.
Dialogue: 0,0:15:05.32,0:15:06.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:07.90,0:15:09.61,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:15:09.70,0:15:13.20,Default,,0,0,0,,Біздің медицина тіпті өлімді де жеңе алады.
Dialogue: 0,0:15:14.41,0:15:15.03,Default,,0,0,0,,Иә
Dialogue: 0,0:15:16.83,0:15:18.29,Default,,0,0,0,,Рахмет, мұғалім!
Dialogue: 0,0:15:19.08,0:15:21.04,Default,,0,0,0,,Бұл толық жеңілдік
Dialogue: 0,0:15:21.12,0:15:23.75,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:15:23.83,0:15:25.67,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:15:25.75,0:15:27.76,Default,,0,0,0,,Өлгендер шынымен қайта тіріле ала ма?
Dialogue: 0,0:15:28.26,0:15:32.18,Default,,0,0,0,,Маргарет, сен тірі болсаң...
Dialogue: 0,0:15:32.26,0:15:35.47,Default,,0,0,0,,Менің анам... Анашым...
Dialogue: 0,0:15:37.31,0:15:39.81,Default,,0,0,0,,Жаңа түрдегі рух толқыны пайда болды!
Dialogue: 0,0:15:39.89,0:15:41.06,Default,,0,0,0,,Күте тұрыңыз, Мэгги...
Dialogue: 0,0:15:42.35,0:15:45.11,Default,,0,0,0,,(анасының ыңырсыуы)
Dialogue: 0,0:15:45.19,0:15:46.19,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:15:48.61,0:15:51.99,Default,,0,0,0,,Ууууууу…
Dialogue: 0,0:15:52.07,0:15:53.82,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:15:55.53,0:15:56.16,Default,,0,0,0,,Себастьян!
Dialogue: 0,0:15:57.28,0:15:58.87,Default,,0,0,0,,Менің Ием Иса
Dialogue: 0,0:16:04.12,0:16:05.17,Default,,0,0,0,,Тиіп көр!
Dialogue: 0,0:16:05.79,0:16:06.54,Default,,0,0,0,,Артқа шегініңіз.
Dialogue: 0,0:16:10.63,0:16:13.63,Default,,0,0,0,,Ааа...аааа...
Dialogue: 0,0:16:13.72,0:16:16.05,Default,,0,0,0,,Ах! Бұл не деген жігіт...
Dialogue: 0,0:16:16.14,0:16:18.68,Default,,0,0,0,,Жүрекке соғуы керек еді.
Dialogue: 0,0:16:19.43,0:16:22.02,Default,,0,0,0,,Бұл мен түсінбейтін нәрсе.
Dialogue: 0,0:16:23.94,0:16:25.90,Default,,0,0,0,,Ааааа…
Dialogue: 0,0:16:27.98,0:16:29.61,Default,,0,0,0,,Тәтті, сәтсіздікке ұшырадың!
Dialogue: 0,0:16:29.69,0:16:32.07,Default,,0,0,0,,Неге жалқаусың? Тез тоқтат!
Dialogue: 0,0:16:37.28,0:16:40.91,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:16:44.42,0:16:45.33,Default,,0,0,0,,(Журналдың таусылып бара жатқан дыбысы)
Dialogue: 0,0:16:45.42,0:16:48.09,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:16:48.17,0:16:50.21,Default,,0,0,0,,Пайдасыз бейбақтар!
Dialogue: 0,0:16:50.71,0:16:52.09,Default,,0,0,0,,- Күте тұрыңыз! -Бала!
Dialogue: 0,0:16:54.88,0:16:57.80,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:16:57.89,0:17:00.43,Default,,0,0,0,,Онымен қалай күресу керек?
Dialogue: 0,0:17:02.85,0:17:07.02,Default,,0,0,0,,Қозғалмайтындай етіп бөлшектеп алсақ, жақсы болмай ма?
Dialogue: 0,0:17:07.52,0:17:09.94,Default,,0,0,0,,Басымды жармай өлтіре алмайсың.
Dialogue: 0,0:17:12.99,0:17:14.32,Default,,0,0,0,,Осылай!
Dialogue: 0,0:17:18.28,0:17:20.16,Default,,0,0,0,,Мұны дұрыс орындау керек.
Dialogue: 0,0:17:24.58,0:17:25.12,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:17:25.87,0:17:26.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:26.92,0:17:30.00,Default,,0,0,0,,Бұл жігіттің өлгені анық.
Dialogue: 0,0:17:30.09,0:17:32.25,Default,,0,0,0,,Сондықтан мен оны дұрыс қалпына келтірдім дедім.
Dialogue: 0,0:17:32.34,0:17:34.42,Default,,0,0,0,,Марж, бұл мүмкін емес.
Dialogue: 0,0:17:34.51,0:17:35.59,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:17:35.67,0:17:38.22,Default,,0,0,0,,Мұны сіз де білетініңізге сенімдімін.
Dialogue: 0,0:17:38.30,0:17:41.26,Default,,0,0,0,,Ааааааааа, мынау дұрыс.
Dialogue: 0,0:17:41.35,0:17:42.43,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:17:51.94,0:17:53.32,Default,,0,0,0,,Емтихан аяқталды
Dialogue: 0,0:17:55.03,0:17:56.40,Default,,0,0,0,,Грим Реапер?
Dialogue: 0,0:17:56.49,0:17:57.99,Default,,0,0,0,,Иә? Сол көзқарас
Dialogue: 0,0:17:58.07,0:18:00.82,Default,,0,0,0,,Сіз қауесет Себас-чансыз ба?
Dialogue: 0,0:18:01.33,0:18:06.79,Default,,0,0,0,,Мен Рональд Нокспін, Шинигами диспетчерлік қауымдастығының коллекция бөлімі.
Dialogue: 0,0:18:06.87,0:18:09.25,Default,,0,0,0,,Менің ағам маған қамқорлық жасайды!
Dialogue: 0,0:18:09.33,0:18:10.75,Default,,0,0,0,,Мұндайды қалай байқадың, Рюзаки?
Dialogue: 0,0:18:10.83,0:18:14.05,Default,,0,0,0,,Менің басымды жаншуым керек дедіңіз.
Dialogue: 0,0:18:14.13,0:18:17.80,Default,,0,0,0,,Балалар, бұл туралы бірдеңе білесіңдер ме?
Dialogue: 0,0:18:18.30,0:18:21.80,Default,,0,0,0,,Жоқ, бізде де ешқандай мәліметтер жоқ.
Dialogue: 0,0:18:21.89,0:18:26.98,Default,,0,0,0,,Дегенмен, жандарды алу керек болған қабықтардың әлі де белсенді екендігі туралы мәліметтер бар.
Dialogue: 0,0:18:27.06,0:18:28.77,Default,,0,0,0,,Мен тергеуге келдім.
Dialogue: 0,0:18:29.69,0:18:32.36,Default,,0,0,0,,Бұл шын мәйіт.
Dialogue: 0,0:18:32.44,0:18:36.32,Default,,0,0,0,,Өйткені бұл баланың жанын екі апта бұрын міндетті түрде ордым.
Dialogue: 0,0:18:37.03,0:18:39.82,Default,,0,0,0,,Менің Лианды құсудан басқа амалым жоқ сияқты.
Dialogue: 0,0:18:40.32,0:18:40.82,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:18:42.78,0:18:43.37,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:18:45.37,0:18:48.29,Default,,0,0,0,,Басқару бөлімі кемеде шайтан барын білсе ше?
Dialogue: 0,0:18:48.37,0:18:50.50,Default,,0,0,0,,Бұл қиын болады, солай емес пе?
Dialogue: 0,0:18:50.58,0:18:55.21,Default,,0,0,0,,Ал қосымша жұмыс, сен неге осында жоғалып кетпейсің?
Dialogue: 0,0:18:55.30,0:18:57.13,Default,,0,0,0,,Цк, мен бірінші барамын!
Dialogue: 0,0:18:57.21,0:18:59.13,Default,,0,0,0,,Біраз ойнаған соң, тез кел!
Dialogue: 0,0:18:59.22,0:19:00.01,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:19:00.09,0:19:01.39,Default,,0,0,0,,Өзіңді нашар сезіну~
Dialogue: 0,0:19:01.47,0:19:03.26,Default,,0,0,0,,Балалар қазір қандай көрінеді?
Dialogue: 0,0:19:04.18,0:19:06.22,Default,,0,0,0,,Мен басқа жаққа қарасам дұрыс па?
Dialogue: 0,0:19:06.81,0:19:07.68,Default,,0,0,0,,Міне, Абдул.
Dialogue: 0,0:19:07.77,0:19:08.60,Default,,0,0,0,,Және…
Dialogue: 0,0:19:19.78,0:19:21.57,Default,,0,0,0,,Орақ орағы күткендей
Dialogue: 0,0:19:21.66,0:19:23.45,Default,,0,0,0,,Айқындыққа кепілдік беріледі ме?
Dialogue: 0,0:19:23.53,0:19:24.70,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:19:43.39,0:19:44.72,Default,,0,0,0,,Жүк қоймасы...
Dialogue: 0,0:19:45.47,0:19:46.22,Default,,0,0,0,,Ах
Dialogue: 0,0:19:47.72,0:19:48.72,Default,,0,0,0,,Гү…
Dialogue: 0,0:19:53.77,0:19:54.61,Default,,0,0,0,,Лиззи!
Dialogue: 0,0:19:54.69,0:19:57.40,Default,,0,0,0,,Сіз қалыңдықты атуға дайынсыз ба?
Dialogue: 0,0:19:57.48,0:19:59.65,Default,,0,0,0,,Одан гөрі мұнда неге келдің?
Dialogue: 0,0:19:59.74,0:20:00.94,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:20:01.03,0:20:04.95,Default,,0,0,0,,Мен саған мені күт дедім, бірақ сен кенет жоғалып кеттің ғой, солай ма?
Dialogue: 0,0:20:05.03,0:20:08.54,Default,,0,0,0,,Мен оны іздеп келе жатқанымда оның жүгіріп келе жатқанын көрдім.
Dialogue: 0,0:20:09.58,0:20:10.83,Default,,0,0,0,,Сиел!
Dialogue: 0,0:20:11.83,0:20:14.79,Default,,0,0,0,,Жоқ, бұл өте қараңғы және қорқынышты жер.
Dialogue: 0,0:20:14.88,0:20:16.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:16.17,0:20:17.09,Default,,0,0,0,,Ha
Dialogue: 0,0:20:17.79,0:20:18.55,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:20:20.76,0:20:22.05,Default,,0,0,0,,Жылан?
Dialogue: 0,0:20:22.72,0:20:24.80,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:20:24.89,0:20:26.47,Default,,0,0,0,,Уордсворт былай дейді...
Dialogue: 0,0:20:26.55,0:20:28.10,Default,,0,0,0,,Сен мұндай жерде не істеп жүрсің?
Dialogue: 0,0:20:28.18,0:20:31.81,Default,,0,0,0,,Тамақтың дәмді болғаны сонша, мен оны барлығымен бөлістім.
Dialogue: 0,0:20:32.39,0:20:33.81,Default,,0,0,0,,... Дэн осылай дейді.
Dialogue: 0,0:20:34.77,0:20:36.10,Default,,0,0,0,,Хаа…
Dialogue: 0,0:20:36.19,0:20:37.02,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:20:37.11,0:20:39.11,Default,,0,0,0,,Ал торт өте дәмді болды.
Dialogue: 0,0:20:39.69,0:20:42.24,Default,,0,0,0,,Сиэлге құлпынай қосылған торт ұнайды
Dialogue: 0,0:20:42.32,0:20:44.53,Default,,0,0,0,,Мен сенің оны жегеніңді қалаймын.
Dialogue: 0,0:20:44.61,0:20:45.11,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:20:46.91,0:20:47.82,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:47.91,0:20:49.99,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:20:51.58,0:20:52.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:52.37,0:20:52.91,Default,,0,0,0,,Ах
Dialogue: 0,0:20:53.75,0:20:54.87,Default,,0,0,0,,Гү…
Dialogue: 0,0:21:01.92,0:21:04.88,Default,,0,0,0,,Гууу...ааааааааааааааааааааааааааааа...
Dialogue: 0,0:21:04.97,0:21:06.22,Default,,0,0,0,,Бұрынғыдан өзгеше
Dialogue: 0,0:21:06.80,0:21:08.39,Default,,0,0,0,,Басқалар болды ма?
Dialogue: 0,0:21:10.10,0:21:10.64,Default,,0,0,0,,Ах
Dialogue: 0,0:21:10.72,0:21:13.64,Default,,0,0,0,,Маған қалдырыңыз! ... дейді Уайлд.
Dialogue: 0,0:21:14.52,0:21:16.14,Default,,0,0,0,,Аврора қоғамының белгісі!
Dialogue: 0,0:21:17.10,0:21:20.52,Default,,0,0,0,,Риан басқа мәйітті әкелді ме...
Dialogue: 0,0:21:20.61,0:21:23.03,Default,,0,0,0,,Жылан! Мен оған қамқор боламын.
Dialogue: 0,0:21:23.11,0:21:24.11,Default,,0,0,0,,Лиззиді сұраңыз
Dialogue: 0,0:21:24.19,0:21:24.70,Default,,0,0,0,,Ах
Dialogue: 0,0:21:26.53,0:21:29.70,Default,,0,0,0,,Жылан! Эй, мені тыңда...
Dialogue: 0,0:21:30.87,0:21:33.16,Default,,0,0,0,,Ол жерде құстардың іздері көп.
Dialogue: 0,0:21:33.25,0:21:35.16,Default,,0,0,0,,... Оскар осылай дейді.
Dialogue: 0,0:21:42.63,0:21:45.38,Default,,0,0,0,,Мен мұның бәріне сене алмаймын ...
Dialogue: 0,0:21:45.47,0:21:47.88,Default,,0,0,0,,(Табыттың дірілдеген дыбысы)
Dialogue: 0,0:21:58.40,0:21:59.52,Default,,0,0,0,,Кяах!
Dialogue: 0,0:22:05.53,0:22:07.99,Default,,0,0,0,,Уф… Жоғарыдан ба?
Dialogue: 0,0:22:21.67,0:22:23.88,Default,,0,0,0,,Мен мұны өсек ретінде жасаймын.
Dialogue: 0,0:22:23.96,0:22:24.80,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:22:24.88,0:22:27.55,Default,,0,0,0,,Ой, уақыт таяп қалды.
Dialogue: 0,0:22:32.14,0:22:34.68,Default,,0,0,0,,Бұл ойнайтын уақыт емес еді.
Dialogue: 0,0:22:38.35,0:22:40.77,Default,,0,0,0,,Мен кешігіп қалдым, менде қорытынды хат жоқ.
Dialogue: 0,0:22:40.85,0:22:43.36,Default,,0,0,0,,Жұмыс нүктеге дейін орындалуы керек.
Dialogue: 0,0:22:43.44,0:22:45.90,Default,,0,0,0,,Сондықтан мен сабырлымын~ Себас-чан
Dialogue: 0,0:22:47.40,0:22:48.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:51.53,0:22:53.08,Default,,0,0,0,,Жүгір, Лиззи!
Dialogue: 0,0:22:54.62,0:22:57.20,Default,,0,0,0,,(Зомбилердің ыңырсыуы)
Dialogue: 0,0:22:58.96,0:22:59.46,Default,,0,0,0,,Ах
Dialogue: 0,0:23:03.96,0:23:04.46,Default,,0,0,0,,Сиел!
Dialogue: 0,0:23:10.38,0:23:11.43,Default,,0,0,0,,Кя!
Dialogue: 0,0:23:11.51,0:23:12.76,Default,,0,0,0,,Күлімсіре!
Dialogue: 0,0:23:13.26,0:23:16.26,Default,,0,0,0,,Тез көтеріл! ...Оскар осылай дейді.
Dialogue: 0,0:23:27.98,0:23:29.65,Default,,0,0,0,,Олар қандай?
Dialogue: 0,0:23:29.74,0:23:32.82,Default,,0,0,0,,Біздің уымыз жұмыс істемейді, иісі сұмдық.
Dialogue: 0,0:23:32.91,0:23:34.78,Default,,0,0,0,,... дейді Вебстер.
Dialogue: 0,0:23:34.87,0:23:36.66,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін, бірақ
Dialogue: 0,0:23:36.74,0:23:39.58,Default,,0,0,0,,Мәйіт неге екені белгісіз қозғалып бара жатқан сияқты.
Dialogue: 0,0:23:40.50,0:23:42.79,Default,,0,0,0,,А... мәйіті?
Dialogue: 0,0:23:43.33,0:23:43.88,Default,,0,0,0,,- (Жылан) Уф - Ах!
Dialogue: 0,0:23:43.96,0:23:44.88,Default,,0,0,0,,Не?
Dialogue: 0,0:23:49.51,0:23:50.97,Default,,0,0,0,,Жылан жылан!
Dialogue: 0,0:23:51.05,0:23:52.88,Default,,0,0,0,,Бұл сан сөзсіз мүмкін емес.
Dialogue: 0,0:23:52.97,0:23:54.09,Default,,0,0,0,,... Оскар осылай дейді.
Dialogue: 0,0:23:57.22,0:23:59.56,Default,,0,0,0,,С... Сиел!
Dialogue: 0,0:23:59.64,0:24:00.35,Default,,0,0,0,,Келесі орын – оңтүстік-оңтүстік-шығыс!
Dialogue: 0,0:24:00.43,0:24:03.48,Default,,0,0,0,,Мен міндетті түрде сені ғана қорғаймын.
Dialogue: 0,0:24:04.02,0:24:05.52,Default,,0,0,0,,Не болса да!
Dialogue: 0,0:24:06.36,0:24:08.44,Default,,0,0,0,,Өте жақсы, балам.
Dialogue: 0,0:24:14.16,0:24:16.99,Default,,0,0,0,,Ағылшын джентльмен болуы керек
Dialogue: 0,0:24:17.08,0:24:18.62,Default,,0,0,0,,Себастьян!
Dialogue: 0,0:24:18.70,0:24:20.70,Default,,0,0,0,,Оңай болмай, тез бітір!
Dialogue: 0,0:24:21.29,0:24:22.16,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:24:27.00,0:24:29.21,Default,,0,0,0,,Біраз ақылдылық жетіспейді
Dialogue: 0,0:24:29.30,0:24:30.80,Default,,0,0,0,,Егер сіз жай ғана басын жойғыңыз келсе,
Dialogue: 0,0:24:35.14,0:24:37.47,Default,,0,0,0,,Бұл жылдамырақ көрінеді.
Dialogue: 0,0:24:56.95,0:25:00.20,Default,,0,0,0,,Жаңа қан шашып, билеген жындар
Dialogue: 0,0:25:04.33,0:25:08.46,Default,,0,0,0,,Бұл... сол күнгі көрініс.
Dialogue: 0,0:25:29.02,0:25:31.27,Default,,0,0,0,,Бітті, балам.
Dialogue: 0,0:25:31.36,0:25:33.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:35.20,0:25:36.57,Default,,0,0,0,,Не болды?
Dialogue: 0,0:25:36.66,0:25:39.07,Default,,0,0,0,,Енді осында келші.
Dialogue: 0,0:25:41.79,0:25:44.41,Default,,0,0,0,,Қолыңмен ұстама, ластанып кетеді
Dialogue: 0,0:25:44.50,0:25:47.42,Default,,0,0,0,,Ах... Бұл үшін кешірім сұраймын.
Dialogue: 0,0:25:57.76,0:26:00.47,Default,,0,0,0,,Сіз оны сәл талғампаз етіп жасай алмайсыз ба?
Dialogue: 0,0:26:00.97,0:26:02.14,Default,,0,0,0,,Бұл аң сияқты
Dialogue: 0,0:26:02.22,0:26:04.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:26:04.64,0:26:06.48,Default,,0,0,0,,Бұл шұғыл болды, сондықтан
Dialogue: 0,0:26:08.65,0:26:13.07,Default,,0,0,0,,Ал олардың физикалық күші кәдімгі адамның күшінен төмен болып көрінеді.
Dialogue: 0,0:26:13.78,0:26:17.28,Default,,0,0,0,,Бірақ неге мұндай үлкен сома бұл кемеде болады?
Dialogue: 0,0:26:17.78,0:26:18.28,Default,,0,0,0,,Бұл...
Dialogue: 0,0:26:20.12,0:26:20.74,Default,,0,0,0,,Сәлем
Dialogue: 0,0:26:23.16,0:26:25.08,Default,,0,0,0,,Менің ойымша, мен одан сұрауым керек.
Dialogue: 0,0:26:25.75,0:26:27.41,Default,,0,0,0,,Лин Стокер
Dialogue: 0,0:26:27.50,0:26:28.12,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:26:28.71,0:26:30.33,Default,,0,0,0,,Бұл толық емес толық рельеф.
Dialogue: 0,0:26:30.92,0:26:33.80,Default,,0,0,0,,Мен сені ондай сау емес күйде тірілту ойымда жоқ...
Dialogue: 0,0:26:34.30,0:26:37.05,Default,,0,0,0,,Оның үстіне қоймадағы мәйіт те оянады...
Dialogue: 0,0:26:37.13,0:26:37.63,Default,,0,0,0,,Уф, ауырып тұр
Dialogue: 0,0:26:37.72,0:26:42.05,Default,,0,0,0,,Нью-Йоркке көп уайымдамай жетуге көп уақыт бар.
Dialogue: 0,0:26:42.14,0:26:44.68,Default,,0,0,0,,Мен сенің әңгімеңді асықпай тыңдаймын.
Dialogue: 0,0:26:44.76,0:26:46.14,Default,,0,0,0,,(Танжиро) Тұр, тұр! Тоқта, Иносукэ~!
Dialogue: 0,0:26:46.22,0:26:47.39,Default,,0,0,0,,Не?
Dialogue: 0,0:26:47.48,0:26:49.06,Default,,0,0,0,,Олар да бәрін тазалады...
Dialogue: 0,0:26:49.14,0:26:50.44,Default,,0,0,0,,Олай емес!
Dialogue: 0,0:26:50.52,0:26:51.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:51.23,0:26:54.61,Default,,0,0,0,,Бұл кемеде соңғы үлгідегі поршеньді бу қозғалтқышы пайдаланылды.
Dialogue: 0,0:26:54.69,0:26:57.90,Default,,0,0,0,,Кеменің ортасында үлкен қазандық орнатылған.
Dialogue: 0,0:26:57.99,0:27:01.53,Default,,0,0,0,,Бұл жер қазандықтың айналасында орналасқан екі бөлікке бөлінген.
Dialogue: 0,0:27:02.41,0:27:03.37,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:27:04.74,0:27:07.66,Default,,0,0,0,,Демек, бұл кемеде тағы бір жүк қоймасы бар.
Dialogue: 0,0:27:08.62,0:27:12.83,Default,,0,0,0,,Мұндағыдан он есе көп тестілеушілер бар!
Dialogue: 0,0:27:13.71,0:27:15.05,Default,,0,0,0,,10 рет?
Dialogue: 0,0:27:38.11,0:27:38.61,Default,,0,0,0,,Эй
Dialogue: 0,0:27:39.32,0:27:40.45,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:27:40.53,0:27:42.57,Default,,0,0,0,,Алдыңғы кемеден ескерту сигналы.
Dialogue: 0,0:27:43.53,0:27:46.79,Default,,0,0,0,,Не? Бұл жаман!
Dialogue: 0,0:27:49.54,0:27:50.96,Default,,0,0,0,,Капитанға асығыңыз!
Dialogue: 0,0:27:51.04,0:27:52.00,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:27:54.67,0:27:55.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:57.05,0:27:58.55,Default,,0,0,0,,(Байланысшының айқайы)
Dialogue: 0,0:27:59.05,0:28:04.64,Default,,0,0,0,,(Гран Торино) «Барлығын Бірге» бүкіл денеме тараған күй
Dialogue: 0,0:28:05.60,0:28:07.26,Default,,0,0,0,,Сонымен, кеменің ішінде...
Dialogue: 0,0:28:07.93,0:28:11.14,Default,,0,0,0,,Қаңғып жүргендер көп шығар.
Dialogue: 0,0:28:11.23,0:28:12.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:28:12.23,0:28:13.06,Default,,0,0,0,,Себастьян
Dialogue: 0,0:28:13.14,0:28:16.56,Default,,0,0,0,,Сен алға, апайларыңды қауіпсіз жерге апар.
Dialogue: 0,0:28:16.65,0:28:18.07,Default,,0,0,0,,Ұлдар ше?
Dialogue: 0,0:28:18.15,0:28:19.82,Default,,0,0,0,,Біз кедергіге айналамыз
Dialogue: 0,0:28:19.90,0:28:22.70,Default,,0,0,0,,Менде мылтық бар, сондықтан біраз уақытқа дейін жақсы боламын.
Dialogue: 0,0:28:24.74,0:28:27.20,Default,,0,0,0,,Қауіпсіз болған кезде оралыңыз.
Dialogue: 0,0:28:27.70,0:28:28.58,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:28:32.58,0:28:33.25,Default,,0,0,0,,Қазір...
Dialogue: 0,0:28:34.29,0:28:36.21,Default,,0,0,0,,Мен сендерге бір оқиғаны айтып берейін.
Dialogue: 0,0:28:36.29,0:28:39.21,Default,,0,0,0,,Біріншіден, олармен қалай күресеміз?
Dialogue: 0,0:28:39.30,0:28:40.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:41.05,0:28:43.26,Default,,0,0,0,,Өте қауіпті нәрсе
Dialogue: 0,0:28:43.34,0:28:45.93,Default,,0,0,0,,Оны сақтандырусыз тасымалдау мүмкін емес.
Dialogue: 0,0:28:46.01,0:28:48.60,Default,,0,0,0,,Оны тоқтатудың қиратудан басқа жолы бар емес пе?
Dialogue: 0,0:28:49.43,0:28:52.06,Default,,0,0,0,,А... бар.
Dialogue: 0,0:28:52.85,0:28:54.14,Default,,0,0,0,,Менің бөлмемде
Dialogue: 0,0:28:54.23,0:28:59.27,Default,,0,0,0,,Науқасты толық апаттық тоқтатуға жеткізу үшін арнайы ультрадыбыстық генератор қолданылады...
Dialogue: 0,0:28:59.77,0:29:00.28,Default,,0,0,0,,Уф
Dialogue: 0,0:29:00.98,0:29:02.19,Default,,0,0,0,,Маған жол көрсет
Dialogue: 0,0:29:02.28,0:29:04.28,Default,,0,0,0,,…
Dialogue: 0,0:29:06.41,0:29:06.91,Default,,0,0,0,,Не!
Dialogue: 0,0:29:08.28,0:29:08.95,Default,,0,0,0,,Тей!
Dialogue: 0,0:29:14.79,0:29:15.83,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:29:15.92,0:29:16.88,Default,,0,0,0,,Батлер!
Dialogue: 0,0:29:17.46,0:29:18.50,Default,,0,0,0,,Бұл балалар кімдер?
Dialogue: 0,0:29:18.59,0:29:20.04,Default,,0,0,0,,Қосымша ақпарат алу үшін...
Dialogue: 0,0:29:21.13,0:29:23.21,Default,,0,0,0,,Оларды жеңудің бір ғана жолы бар.
Dialogue: 0,0:29:23.72,0:29:25.22,Default,,0,0,0,,Тек бастың жойылуы
Dialogue: 0,0:29:27.93,0:29:28.72,Default,,0,0,0,,Хмф!
Dialogue: 0,0:29:35.23,0:29:36.85,Default,,0,0,0,,Оқиға рас сияқты.
Dialogue: 0,0:29:36.94,0:29:38.31,Default,,0,0,0,,Өтемақы
Dialogue: 0,0:29:38.40,0:29:42.32,Default,,0,0,0,,Бүгін мен бұл жалқау бет пен шаш үлгісін кешіремін.
Dialogue: 0,0:29:42.40,0:29:44.07,Default,,0,0,0,,Рахмет
Dialogue: 0,0:29:44.15,0:29:45.40,Default,,0,0,0,,Сәлем Батлер!
Dialogue: 0,0:29:45.90,0:29:47.20,Default,,0,0,0,,Лиззиге не болды?
Dialogue: 0,0:29:47.28,0:29:48.95,Default,,0,0,0,,Мен баламен біргемін.
Dialogue: 0,0:29:49.45,0:29:51.45,Default,,0,0,0,,Екеуің де амансыңдар деп үміттенемін.
Dialogue: 0,0:29:52.04,0:29:54.54,Default,,0,0,0,,Егер біз бірге болсақ, алаңдаудың қажеті жоқ.
Dialogue: 0,0:29:54.62,0:29:55.33,Default,,0,0,0,,Иә
Dialogue: 0,0:29:55.41,0:29:58.04,Default,,0,0,0,,Ол қыз міндетті түрде қалыңдығын қорғайды.
Dialogue: 0,0:29:58.12,0:30:00.88,Default,,0,0,0,,Ол «сөзсіз» деді
Dialogue: 0,0:30:01.38,0:30:05.13,Default,,0,0,0,,Сенің бұйрығың бойынша мен бәріңді қауіпсіз жерге апарамын...
Dialogue: 0,0:30:05.22,0:30:06.72,Default,,0,0,0,,Мұны істеу мүмкін емес!
Dialogue: 0,0:30:06.80,0:30:07.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:08.84,0:30:10.97,Default,,0,0,0,,Менің отбасым, Мидфорд маркесі,
Dialogue: 0,0:30:11.05,0:30:14.18,Default,,0,0,0,,Англияны ұрпақтар бойы қорғап келген рыцарьлар отбасы.
Dialogue: 0,0:30:14.27,0:30:17.89,Default,,0,0,0,,Халықтың дағдарысын елемеу рыцарлыққа қарсы.
Dialogue: 0,0:30:20.27,0:30:23.40,Default,,0,0,0,,Біз, британдық рыцарьлар, әлсіздерді қорғайтын қалқан боламыз!
Dialogue: 0,0:30:23.98,0:30:25.57,Default,,0,0,0,,-Бұл Фрэнсис - (Эдвард), анашым.
Dialogue: 0,0:30:25.65,0:30:27.07,Default,,0,0,0,,…Тоқта, қайда барасың, Зура?
Dialogue: 0,0:30:27.78,0:30:30.53,Default,,0,0,0,,Сіз оларға тез оралуыңыз керек.
Dialogue: 0,0:30:30.62,0:30:31.41,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:30:31.91,0:30:34.45,Default,,0,0,0,,Біздің қылыш шеберліктерімізге сенбесеңіз ше?
Dialogue: 0,0:30:35.54,0:30:36.87,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:30:36.96,0:30:38.21,Default,,0,0,0,,Аман болыңыз.
Dialogue: 0,0:30:38.29,0:30:39.33,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:30:39.42,0:30:41.25,Default,,0,0,0,,Мұны Сиелге айт!
Dialogue: 0,0:30:41.33,0:30:43.42,Default,,0,0,0,,Әпкеме бірдеңе болса, мен сені кешіремін.
Dialogue: 0,0:30:44.00,0:30:45.63,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:30:50.93,0:30:53.10,Default,,0,0,0,,Қарашы, мен сені кездестіру үшін өмір сүрген жоқпын.
Dialogue: 0,0:30:53.81,0:30:56.10,Default,,0,0,0,,Себебі сіз тізімдесіз.
Dialogue: 0,0:30:56.64,0:30:58.85,Default,,0,0,0,,Мен оны қатты жек көремін.
Dialogue: 0,0:30:59.52,0:31:01.10,Default,,0,0,0,,Қазірдің өзінде мен өте бос емеспін.
Dialogue: 0,0:31:01.77,0:31:03.73,Default,,0,0,0,,Енді нақты нәрсе келді... иә?
Dialogue: 0,0:31:03.82,0:31:08.36,Default,,0,0,0,,(Гран Торино) «Барлығын Бірге» бүкіл денеме тараған күй
Dialogue: 0,0:31:08.44,0:31:10.07,Default,,0,0,0,,Суық~
Dialogue: 0,0:31:10.15,0:31:12.62,Default,,0,0,0,,Әй, бұл бір шулы, солай емес пе?
Dialogue: 0,0:31:12.70,0:31:15.91,Default,,0,0,0,,Әйтеуір, маскүнем тағы бір көрініс жасап жатыр... А?
Dialogue: 0,0:31:16.41,0:31:16.91,Default,,0,0,0,,Әй?
Dialogue: 0,0:31:20.96,0:31:25.25,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:31:29.26,0:31:30.51,Default,,0,0,0,,Неліктен ешкім көрінбейді?
Dialogue: 0,0:31:30.59,0:31:31.47,Default,,0,0,0,,және тек үшеуміз – анам, әкем және мен – бірге өмір сүремін…
Dialogue: 0,0:31:31.55,0:31:37.43,Default,,0,0,0,,(кеме қоңырауының дыбысы)
Dialogue: 0,0:31:38.77,0:31:39.98,Default,,0,0,0,,Хаа…
Dialogue: 0,0:31:40.06,0:31:42.31,Default,,0,0,0,,Бұл шынымен де қосымша жұмыс емес пе?
Dialogue: 0,0:31:42.40,0:31:45.32,Default,,0,0,0,,Менде артық жұмыс істемеу саясаты бар.
Dialogue: 0,0:31:45.40,0:31:48.23,Default,,0,0,0,,Басқару бөлімі де тым бейқам.
Dialogue: 0,0:31:48.74,0:31:50.36,Default,,0,0,0,,Осы санның жинағы…
Dialogue: 0,0:31:50.45,0:31:52.82,Default,,0,0,0,,Мұны істеу үшін екі адам керек болғанына сене алар емеспін.
Dialogue: 0,0:31:53.45,0:31:56.66,Default,,0,0,0,,Бірінші түн болса да, мінез-құлқың дұрыс емес.
Dialogue: 0,0:31:56.74,0:32:00.12,Default,,0,0,0,,Егер мен осындай үлкен адамды күшпен басып жіберсем,
Dialogue: 0,0:32:00.20,0:32:01.87,Default,,0,0,0,,Ол бұзылады.
Dialogue: 0,0:32:06.34,0:32:09.30,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:32:11.59,0:32:14.72,Default,,0,0,0,,Жыртылған қанды қыз саяхаты
Dialogue: 0,0:32:14.80,0:32:16.60,Default,,0,0,0,,Оны тоқтату мүмкін емес!
Dialogue: 0,0:32:17.60,0:32:19.06,Default,,0,0,0,,Артқа жол жоқ!
Dialogue: 0,0:32:19.56,0:32:21.31,Default,,0,0,0,,Артқа қарасаң да, бәрі кеш!
Dialogue: 0,0:32:24.27,0:32:25.65,Default,,0,0,0,,Міне.
Dialogue: 0,0:32:26.69,0:32:29.40,Default,,0,0,0,,DIE Voyage ӨЛІМ!
Dialogue: 0,0:32:37.62,0:32:39.62,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:32:42.12,0:32:44.12,Default,,0,0,0,,Уф... Мынау не дірілдеп тұр?
Dialogue: 0,0:32:44.71,0:32:45.33,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:32:48.96,0:32:50.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:32:51.80,0:32:53.93,Default,,0,0,0,,Сіз шынымен де сол нәрсеге тап болдыңыз ба?
Dialogue: 0,0:32:56.93,0:32:58.18,Default,,0,0,0,,Су өткізбейтін есік…
Dialogue: 0,0:33:01.47,0:33:04.44,Default,,0,0,0,,Бұл біраз уақытқа су тасқынының алдын алуы керек.
Dialogue: 0,0:33:05.60,0:33:08.11,Default,,0,0,0,,Бірақ ұшқыштар жойылды...
Dialogue: 0,0:33:10.15,0:33:12.61,Default,,0,0,0,,Ең жаман түн болатын сияқты.
Dialogue: 0,0:33:13.11,0:33:15.91,Default,,0,0,0,,Ууууууу…
Dialogue: 0,0:33:16.78,0:33:18.87,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:33:18.95,0:33:19.83,Default,,0,0,0,,Әй?
Dialogue: 0,0:33:19.91,0:33:22.33,Default,,0,0,0,,Қарамаңдар.
Dialogue: 0,0:33:22.83,0:33:25.58,Default,,0,0,0,,Ей, сен де сезінуің керек.
Dialogue: 0,0:33:25.67,0:33:30.42,Default,,0,0,0,,Мына теңіз самалы бүкіл денемді сипап тұрғандай!
Dialogue: 0,0:33:30.50,0:33:32.26,Default,,0,0,0,,Эй, Сатклиф-сенпай.
Dialogue: 0,0:33:32.34,0:33:34.13,Default,,0,0,0,,Жаңа кіші баламен қиналып жүрсіз бе?
Dialogue: 0,0:33:34.22,0:33:37.01,Default,,0,0,0,,Тіпті мен жақсырақ адаммен бірге болғым келеді!
Dialogue: 0,0:33:37.09,0:33:39.68,Default,,0,0,0,,Мен қалаймын, мен...
Dialogue: 0,0:33:40.97,0:33:42.27,Default,,0,0,0,,Хаа…
Dialogue: 0,0:33:42.35,0:33:45.02,Default,,0,0,0,,Сен менің қарсыласым болсаң, мен толқпаймын.
Dialogue: 0,0:33:45.10,0:33:45.98,Default,,0,0,0,,Stop Stop
Dialogue: 0,0:33:46.06,0:33:47.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:47.65,0:33:49.77,Default,,0,0,0,,Шынымды айтсам, қазір мұндай нәрсені жасайтын уақыт емес.
Dialogue: 0,0:33:50.36,0:33:52.23,Default,,0,0,0,,Мына тізімге қараңыз!
Dialogue: 0,0:33:52.32,0:33:55.03,Default,,0,0,0,,Сауықтыру үшін тағы 1034 адам бар.
Dialogue: 0,0:33:55.99,0:33:58.91,Default,,0,0,0,,Біз үшін жандарды алу міндетті болып табылады.
Dialogue: 0,0:33:59.74,0:34:01.70,Default,,0,0,0,,Мен оны тез бітіремін.
Dialogue: 0,0:34:05.83,0:34:06.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:34:08.37,0:34:09.63,Default,,0,0,0,,шешілді
Dialogue: 0,0:34:10.84,0:34:13.21,Default,,0,0,0,,Қазір дүмпу қандай?
Dialogue: 0,0:34:13.71,0:34:14.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:34:17.26,0:34:18.09,Default,,0,0,0,,Кя!
Dialogue: 0,0:34:20.01,0:34:20.80,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:34:20.89,0:34:23.51,Default,,0,0,0,,Бұл дабыл... Су өткізбейтін есік жабылады!
Dialogue: 0,0:34:25.39,0:34:27.31,Default,,0,0,0,,Асығыңыз! Сіз тұзаққа түсесіз!
Dialogue: 0,0:34:29.56,0:34:30.52,Default,,0,0,0,,Лиззи!
Dialogue: 0,0:34:31.44,0:34:32.94,Default,,0,0,0,,C... Сиел!
Dialogue: 0,0:34:33.02,0:34:35.19,Default,,0,0,0,,- (Инженер) Менің енді қолымнан келмейді, монах - Ух...
Dialogue: 0,0:34:35.94,0:34:37.65,Default,,0,0,0,,-Лиззи! -Ши...
Dialogue: 0,0:34:47.25,0:34:49.17,Default,,0,0,0,,Сиел Неліктен?
Dialogue: 0,0:34:49.25,0:34:51.46,Default,,0,0,0,,Мен оны қандай жағдай болса да сақтауға уәде бердім.
Dialogue: 0,0:34:52.67,0:34:53.71,Default,,0,0,0,,Жылан!
Dialogue: 0,0:34:53.80,0:34:55.67,Default,,0,0,0,,Барыңдар!
Dialogue: 0,0:34:56.80,0:34:58.51,Default,,0,0,0,,Мен сені тастап кете алмаймын
Dialogue: 0,0:34:58.59,0:35:00.68,Default,,0,0,0,,Эмили дейді...
Dialogue: 0,0:35:04.18,0:35:07.18,Default,,0,0,0,,Уайымдамаңыз, канал арқылы қашыңыз!
Dialogue: 0,0:35:07.27,0:35:08.85,Default,,0,0,0,,Сіздің досыңыз
Dialogue: 0,0:35:08.94,0:35:11.35,Default,,0,0,0,,Суық суды көп салу жаман емес пе?
Dialogue: 0,0:35:11.85,0:35:12.86,Default,,0,0,0,,Жүр!
Dialogue: 0,0:35:17.53,0:35:18.53,Default,,0,0,0,,Күлімсіре!
Dialogue: 0,0:35:19.28,0:35:21.74,Default,,0,0,0,,Китс сізді каналдың ішіне бағыттайды.
Dialogue: 0,0:35:22.74,0:35:25.70,Default,,0,0,0,,Эмили кейін кездесейік дейді...
Dialogue: 0,0:35:25.79,0:35:28.33,Default,,0,0,0,,Әй, кейінірек!
Dialogue: 0,0:35:42.89,0:35:45.43,Default,,0,0,0,,Лиззи, алдымен мына киімдерді шеш.
Dialogue: 0,0:35:45.51,0:35:46.76,Default,,0,0,0,,Не? Мен... Маған ұнамайды!
Dialogue: 0,0:35:46.85,0:35:48.43,Default,,0,0,0,,Өзімшіл сөздер айтпа!
Dialogue: 0,0:35:48.52,0:35:50.56,Default,,0,0,0,,Бұл жерден өту үшін сізге юбка керек...
Dialogue: 0,0:35:50.64,0:35:51.52,Default,,0,0,0,,Мүлдем жоқ!
Dialogue: 0,0:35:52.56,0:35:56.36,Default,,0,0,0,,Мен Сиэлдің алдында соңына дейін сүйкімді болып қалғым келеді.
Dialogue: 0,0:35:58.61,0:35:59.90,Default,,0,0,0,,Кя!
Dialogue: 0,0:36:02.74,0:36:03.82,Default,,0,0,0,,Сен өлгенде...
Dialogue: 0,0:36:04.53,0:36:07.16,Default,,0,0,0,,Сіз өзіңіздің сүйікті киіміңізді енді ешқашан кие алмайсыз!
Dialogue: 0,0:36:07.79,0:36:09.75,Default,,0,0,0,,Өлсең бітті.
Dialogue: 0,0:36:09.83,0:36:10.66,Default,,0,0,0,,Барлығы!
Dialogue: 0,0:36:14.13,0:36:16.84,Default,,0,0,0,,Эмма! Рэй!
Dialogue: 0,0:36:21.92,0:36:25.72,Default,,0,0,0,,Келесі жолы мен Нинадан саған жаңа көйлек тігіп беруін өтінемін.
Dialogue: 0,0:36:26.26,0:36:28.81,Default,,0,0,0,,Бүгінгіден әлдеқайда жақсы...
Dialogue: 0,0:36:29.39,0:36:30.89,Default,,0,0,0,,Жоқ, Сиэл
Dialogue: 0,0:36:31.39,0:36:33.31,Default,,0,0,0,,Өзімшіл болғаным үшін кешіріңіз
Dialogue: 0,0:36:34.15,0:36:36.61,Default,,0,0,0,,Саған дөрекі болғаным үшін де кешірім сұраймын.
Dialogue: 0,0:36:38.32,0:36:40.11,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:36:42.82,0:36:45.03,Default,,0,0,0,,Міне, Нии-чан, тезірек жүр!
Dialogue: 0,0:36:45.11,0:36:46.03,Default,,0,0,0,,Ha
Dialogue: 0,0:36:46.12,0:36:48.83,Default,,0,0,0,,Оған не болды? ...Оскар осылай дейді.
Dialogue: 0,0:36:50.04,0:36:51.00,Default,,0,0,0,,Ах
Dialogue: 0,0:36:51.79,0:36:52.91,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:36:54.25,0:36:55.63,Default,,0,0,0,,Эй, күт!
Dialogue: 0,0:36:56.33,0:36:58.25,Default,,0,0,0,,... Оскар осылай дейді.
Dialogue: 0,0:37:04.72,0:37:05.68,Default,,0,0,0,,Аа...
Dialogue: 0,0:37:12.98,0:37:14.60,Default,,0,0,0,,Бір қарағанда
Dialogue: 0,0:37:14.69,0:37:17.86,Default,,0,0,0,,Корпустың жеткілікті кең жерінде сызаттар болды.
Dialogue: 0,0:37:19.36,0:37:24.99,Default,,0,0,0,,Сыртынан қарағанда, 3...немесе 4 бөлім толығымен су астында қалуы керек.
Dialogue: 0,0:37:25.07,0:37:26.95,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:37:31.41,0:37:35.37,Default,,0,0,0,,Хаа... Бірінен соң бірі бітпесе
Dialogue: 0,0:37:37.08,0:37:38.54,Default,,0,0,0,,Сіз мұны тоқтатқыңыз келе ме?
Dialogue: 0,0:37:39.46,0:37:42.13,Default,,0,0,0,,Өйткені бұл кеме бір сағатқа жетпейді...
Dialogue: 0,0:37:42.21,0:37:43.59,Default,,0,0,0,,Ол батып кетеді.
Dialogue: 0,0:37:45.59,0:37:47.47,Default,,0,0,0,,Судың температурасы шамамен 2 градус
Dialogue: 0,0:37:48.84,0:37:51.01,Default,,0,0,0,,Ұзақ уақыт пайдалансаңыз, денсаулығыңызға зиян тигізеді.
Dialogue: 0,0:37:56.60,0:38:00.36,Default,,0,0,0,,Мұны тез арада алу керек.
Dialogue: 0,0:38:01.07,0:38:03.28,Default,,0,0,0,,Кяах~!
Dialogue: 0,0:38:03.36,0:38:07.36,Default,,0,0,0,,А, а... жоқ...
Dialogue: 0,0:38:09.07,0:38:09.91,Default,,0,0,0,,Эй!
Dialogue: 0,0:38:12.16,0:38:13.66,Default,,0,0,0,,Міне, тексеріп көрейік.
Dialogue: 0,0:38:13.74,0:38:15.87,Default,,0,0,0,,Жерге қайтсам, жақсы өмір сүре аламын... Уау!
Dialogue: 0,0:38:15.96,0:38:17.46,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:38:18.87,0:38:20.96,Default,,0,0,0,,Құтқару қайығын түсірейік.
Dialogue: 0,0:38:21.04,0:38:23.84,Default,,0,0,0,,Бірақ олар да сыртта болса ше...
Dialogue: 0,0:38:26.17,0:38:27.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:29.30,0:38:30.51,Default,,0,0,0,,Ніл өзенінің батыс жағалауындағы қиын өткелі бар шатқалдың тереңінде —
Dialogue: 0,0:38:32.85,0:38:34.85,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:38:35.35,0:38:36.77,Default,,0,0,0,,Берілме!
Dialogue: 0,0:38:47.11,0:38:51.45,Default,,0,0,0,,Күйме тәрізді нәрсені тек бірінші сыныпты күтуші ғана екіге бөле алады.
Dialogue: 0,0:38:51.95,0:38:55.20,Default,,0,0,0,,Бірақ бұл өте өкінішті жағдай болып шықты.
Dialogue: 0,0:38:55.29,0:38:59.37,Default,,0,0,0,,Бірақ жолаушылардың бәрі осылай өлсе...
Dialogue: 0,0:38:59.96,0:39:02.21,Default,,0,0,0,,Мәртебелі мұңы тереңдей түседі.
Dialogue: 0,0:39:02.29,0:39:03.96,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:39:06.88,0:39:08.34,Default,,0,0,0,,Біз бұған жол бермейміз.
Dialogue: 0,0:39:08.84,0:39:11.22,Default,,0,0,0,,Жарақат алмаған кез келген адам қайықты түсіруге көмектесуі керек.
Dialogue: 0,0:39:12.14,0:39:12.72,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:39:12.80,0:39:13.97,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:39:15.72,0:39:18.18,Default,,0,0,0,,Ойлап қарасам, құбыжық екен.
Dialogue: 0,0:39:18.27,0:39:19.94,Default,,0,0,0,,Жарай ма? сұр
Dialogue: 0,0:39:20.02,0:39:21.98,Default,,0,0,0,,Қылышпен кесіп алсам, қорықпаймын
Dialogue: 0,0:39:24.07,0:39:25.32,Default,,0,0,0,,Енді әрі қарай жүрейік.
Dialogue: 0,0:39:25.82,0:39:26.78,Default,,0,0,0,,Кел!
Dialogue: 0,0:39:28.65,0:39:31.24,Default,,0,0,0,,Мәртебелі қалағандай!
Dialogue: 0,0:39:33.32,0:39:34.08,Default,,0,0,0,,-Уау -Сиел!
Dialogue: 0,0:39:34.16,0:39:36.58,Default,,0,0,0,,Сәлем! Ауырмайды ма...?
Dialogue: 0,0:39:37.79,0:39:39.16,Default,,0,0,0,,Себастьян!
Dialogue: 0,0:39:39.25,0:39:41.42,Default,,0,0,0,,Кешігу үшін кешірім сұраймыз.
Dialogue: 0,0:39:42.63,0:39:45.04,Default,,0,0,0,,Екеуіңіз де жарақат алдыңыз ба?
Dialogue: 0,0:39:45.54,0:39:48.84,Default,,0,0,0,,Жарайды, өйткені Сиэл мені қорғады.
Dialogue: 0,0:39:50.22,0:39:51.38,Default,,0,0,0,,Апайларыңыз ше?
Dialogue: 0,0:39:51.47,0:39:53.76,Default,,0,0,0,,Барлығы аман деп үміттенемін.
Dialogue: 0,0:39:55.01,0:39:56.81,Default,,0,0,0,,Рахмет Себастьян
Dialogue: 0,0:39:56.89,0:39:58.06,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:39:58.14,0:40:00.43,Default,,0,0,0,,Құтқару қайығына дайындық басталды.
Dialogue: 0,0:40:00.52,0:40:02.23,Default,,0,0,0,,Палубаға асығайық.
Dialogue: 0,0:40:02.31,0:40:03.65,Default,,0,0,0,,(Араның дыбысы)
Dialogue: 0,0:40:06.61,0:40:07.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:09.57,0:40:11.07,Default,,0,0,0,,Уау
Dialogue: 0,0:40:12.07,0:40:15.32,Default,,0,0,0,,Сексуалды адам Хакке~н
Dialogue: 0,0:40:15.41,0:40:16.58,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:40:17.45,0:40:19.16,Default,,0,0,0,,Грелл Сатклиф
Dialogue: 0,0:40:19.25,0:40:21.87,Default,,0,0,0,,Сәлем Себас-чан!
Dialogue: 0,0:40:21.96,0:40:25.13,Default,,0,0,0,,Тағдырдың жазғаны болар, осындай жерде тағы кездесіп қалдық.
Dialogue: 0,0:40:25.21,0:40:26.17,Default,,0,0,0,,Бұл кездейсоқтық
Dialogue: 0,0:40:26.25,0:40:28.80,Default,,0,0,0,,Ах! Мен жалықтым
Dialogue: 0,0:40:28.88,0:40:32.59,Default,,0,0,0,,Бұл жер әлі де тамаша!
Dialogue: 0,0:40:32.68,0:40:34.39,Default,,0,0,0,,Ооо, таптың ба?
Dialogue: 0,0:40:34.47,0:40:35.30,Default,,0,0,0,,Кеуектер әлі де бар...
Dialogue: 0,0:40:35.39,0:40:38.51,Default,,0,0,0,,Сенпай, коллекцияны ұмытпа.
Dialogue: 0,0:40:38.60,0:40:40.27,Default,,0,0,0,,Рональд!
Dialogue: 0,0:40:40.35,0:40:42.52,Default,,0,0,0,,Себас-чан осында болса, тез айт!
Dialogue: 0,0:40:42.60,0:40:44.31,Default,,0,0,0,,Содан кейін макияж дұрыс орындалады...
Dialogue: 0,0:40:44.40,0:40:47.19,Default,,0,0,0,,Ах! Бір минут күтіңіз!
Dialogue: 0,0:40:48.73,0:40:51.61,Default,,0,0,0,,Мен асығып жатырмын, маған жолды босатыңызшы?
Dialogue: 0,0:40:52.82,0:40:54.03,Default,,0,0,0,,Маған ұнамайды десем ше?
Dialogue: 0,0:40:55.07,0:40:56.24,Default,,0,0,0,,Тіпті күшпен
Dialogue: 0,0:40:56.32,0:40:57.41,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:40:58.03,0:41:00.54,Default,,0,0,0,,Мен итермелеуді жек көрмеймін.
Dialogue: 0,0:41:01.04,0:41:05.46,Default,,0,0,0,,Олай болса, махаббат романтикасынан да ыстық бір-бірімізді өлтірейік!
Dialogue: 0,0:41:06.33,0:41:07.59,Default,,0,0,0,,Не? Сол адам
Dialogue: 0,0:41:07.67,0:41:09.25,Default,,0,0,0,,Жай ғана бұзық
Dialogue: 0,0:41:09.34,0:41:12.01,Default,,0,0,0,,Жақын болсаңыз, жұқтыру қаупі бар.
Dialogue: 0,0:41:12.09,0:41:13.01,Default,,0,0,0,,Артқа шегініңіз.
Dialogue: 0,0:41:13.09,0:41:14.51,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:41:15.09,0:41:18.22,Default,,0,0,0,,Мен өз сезімдеріммен шыншылмын!
Dialogue: 0,0:41:21.68,0:41:22.43,Default,,0,0,0,,(Кондуктор) Сабыр сақтап, батырды күтіңіздер…
Dialogue: 0,0:41:22.98,0:41:23.64,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:41:26.23,0:41:27.27,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:41:28.86,0:41:29.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:29.52,0:41:30.61,Default,,0,0,0,,Қый!
Dialogue: 0,0:41:31.73,0:41:32.86,Default,,0,0,0,,Бала!
Dialogue: 0,0:41:34.45,0:41:36.53,Default,,0,0,0,,Менің де сонда екенімді ұмытып кеттің.
Dialogue: 0,0:41:36.61,0:41:37.53,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:41:37.62,0:41:39.37,Default,,0,0,0,,Лиззи…
Dialogue: 0,0:41:39.45,0:41:40.16,Default,,0,0,0,,Ах
Dialogue: 0,0:41:40.87,0:41:41.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:41:41.79,0:41:43.08,Default,,0,0,0,,Лиззи!
Dialogue: 0,0:41:43.16,0:41:43.70,Default,,0,0,0,,Уф
Dialogue: 0,0:41:44.33,0:41:45.08,Default,,0,0,0,,Менің аяғым...
Dialogue: 0,0:41:45.16,0:41:47.71,Default,,0,0,0,,Лиззи, жүгір!
Dialogue: 0,0:41:50.21,0:41:50.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:55.05,0:41:55.76,Default,,0,0,0,,(Журналдың таусылып бара жатқан дыбысы)
Dialogue: 0,0:41:55.84,0:41:57.30,Default,,0,0,0,,А... оқ!
Dialogue: 0,0:41:59.93,0:42:00.72,Default,,0,0,0,,20-шы эпизод: Бастықтың соңғы бұйрығы
Dialogue: 0,0:42:01.39,0:42:06.27,Default,,0,0,0,,Мен Сиелдің алдында соңына дейін сүйкімді болып қалғым келді...
Dialogue: 0,0:42:13.28,0:42:14.32,Default,,0,0,0,,Лиззи!
Dialogue: 0,0:42:24.25,0:42:26.37,Default,,0,0,0,,Иә! Уф!
Dialogue: 0,0:42:34.67,0:42:35.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:42:44.60,0:42:45.56,Default,,0,0,0,,Әй!
Dialogue: 0,0:42:48.56,0:42:53.15,Default,,0,0,0,,Бұл... кесілмеген көрініс
Dialogue: 0,0:42:54.19,0:42:57.95,Default,,0,0,0,,Мен оны Сиелге көрсеткім келмеді.
Dialogue: 0,0:42:59.11,0:42:59.74,Default,,0,0,0,,Бірақ
Dialogue: 0,0:43:00.86,0:43:04.45,Default,,0,0,0,,Бұл жолы мен сені қорғаймын!
Dialogue: 0,0:43:09.83,0:43:14.88,Default,,0,0,0,,Менің атым Алексис Леон, Мидфордтық Маркес, Британ рыцарларының капитаны.
Dialogue: 0,0:43:14.96,0:43:16.38,Default,,0,0,0,,Элизабет!
Dialogue: 0,0:43:19.01,0:43:21.34,Default,,0,0,0,,Королеваның күзетшісінің әйелі!
Dialogue: 0,0:43:21.43,0:43:21.93,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:43:24.51,0:43:27.35,Default,,0,0,0,,Қыздар неден жасалған?
Dialogue: 0,0:43:28.27,0:43:32.69,Default,,0,0,0,,Қант, дәмдеуіштер, бәрі жақсы
Dialogue: 0,0:43:34.77,0:43:37.36,Default,,0,0,0,,Осылайша орындалды
Dialogue: 0,0:43:42.03,0:43:43.78,Default,,0,0,0,,Философиядан гөрі поэзия
Dialogue: 0,0:43:43.87,0:43:45.45,Default,,0,0,0,,Ас әзірлеуден гөрі кесте тігу
Dialogue: 0,0:43:45.53,0:43:47.16,Default,,0,0,0,,Шахмат үстінде билеу
Dialogue: 0,0:43:48.70,0:43:51.33,Default,,0,0,0,,«Ештеңені білмейтін періште бол»
Dialogue: 0,0:43:52.54,0:43:57.30,Default,,0,0,0,,Раушан елінде туылған әрбір қыз бала осылай айтып өседі.
Dialogue: 0,0:44:01.05,0:44:01.76,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:44:10.56,0:44:11.19,Default,,0,0,0,,Сұр
Dialogue: 0,0:44:12.02,0:44:16.15,Default,,0,0,0,,Бұл қылыш данышпан деген қауесет бар Мидфордтық Маркестің ұлы ма?
Dialogue: 0,0:44:16.23,0:44:18.82,Default,,0,0,0,,ше? Не туралы айтып тұрсың, Фиппс?
Dialogue: 0,0:44:18.90,0:44:20.15,Default,,0,0,0,,Мұнда емес
Dialogue: 0,0:44:20.24,0:44:20.74,Default,,0,0,0,,Әй?
Dialogue: 0,0:44:24.57,0:44:25.07,Default,,0,0,0,,Жарамды!
Dialogue: 0,0:44:25.16,0:44:26.66,Default,,0,0,0,,Тергеуіміз қажет нәрселер бар… біртіндеп шешеміз
Dialogue: 0,0:44:29.50,0:44:32.08,Default,,0,0,0,,Менің қызым – данышпан
Dialogue: 0,0:44:39.13,0:44:41.76,Default,,0,0,0,,Бірақ бір күні Сиэл айтты
Dialogue: 0,0:44:41.84,0:44:42.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:42.80,0:44:44.47,Default,,0,0,0,,Бүгінгі күннің бәрі осы!
Dialogue: 0,0:44:46.55,0:44:48.64,Default,,0,0,0,,Сиэл, жақсысың ба?
Dialogue: 0,0:44:48.72,0:44:51.06,Default,,0,0,0,,Күшті әйелдер қорқынышты
Dialogue: 0,0:44:51.14,0:44:51.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:51.98,0:44:55.19,Default,,0,0,0,,Лиззи менің әйелім болғанына қуаныштымын.
Dialogue: 0,0:44:55.85,0:44:59.48,Default,,0,0,0,,Өзімнен бір жас кіші сүйкімді күйеуім
Dialogue: 0,0:45:00.03,0:45:02.53,Default,,0,0,0,,Сол кезде мен шештім.
Dialogue: 0,0:45:03.20,0:45:07.37,Default,,0,0,0,,Мен Сиэлдің қорғалған әйелі боламын.
Dialogue: 0,0:45:09.37,0:45:10.74,Default,,0,0,0,,Бірақ сол күні...
Dialogue: 0,0:45:12.79,0:45:14.75,Default,,0,0,0,,Бұл оқиға болды.
Dialogue: 0,0:45:15.25,0:45:18.79,Default,,0,0,0,,Сол арман мәңгілікке кетті
Dialogue: 0,0:45:26.30,0:45:27.39,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:45:28.97,0:45:31.27,Default,,0,0,0,,Сиэл қайтып келді
Dialogue: 0,0:45:31.85,0:45:34.39,Default,,0,0,0,,Қара малшыны әкелу
Dialogue: 0,0:45:36.19,0:45:40.36,Default,,0,0,0,,Сиэл қайтып келгенде, ол менен қарағанда арық және кішірек болды.
Dialogue: 0,0:45:41.40,0:45:43.28,Default,,0,0,0,,Бірақ мен бірден түсіндім
Dialogue: 0,0:45:44.03,0:45:46.45,Default,,0,0,0,,Сиэл кішірейген жоқ.
Dialogue: 0,0:45:46.53,0:45:49.07,Default,,0,0,0,,Мен есейдім.
Dialogue: 0,0:45:49.58,0:45:52.08,Default,,0,0,0,,Мен сонда шештім.
Dialogue: 0,0:45:53.62,0:45:58.29,Default,,0,0,0,,Мен Сиэлді қорғап, оның әйелі бола аламын.
Dialogue: 0,0:46:00.59,0:46:04.84,Default,,0,0,0,,Менің жасымдағы балалардың барлығы сүйкімді биік өкшелі туфли киген.
Dialogue: 0,0:46:14.35,0:46:18.69,Default,,0,0,0,,Бойы өсіп келе жатқан Сиел үшін мен тез өсуім керек.
Dialogue: 0,0:46:20.19,0:46:25.44,Default,,0,0,0,,Мен балаша туфлиді киіп, сенің жаныңда күлемін.
Dialogue: 0,0:46:26.74,0:46:28.41,Default,,0,0,0,,Төмен өкшелі аяқ киім
Dialogue: 0,0:46:29.20,0:46:30.74,Default,,0,0,0,,Ана тағылымы
Dialogue: 0,0:46:31.37,0:46:32.91,Default,,0,0,0,,Сені қорғайтын қылыш
Dialogue: 0,0:46:36.41,0:46:37.16,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:46:39.75,0:46:41.67,Default,,0,0,0,,Мені қазір кіммін
Dialogue: 0,0:46:42.67,0:46:44.21,Default,,0,0,0,,Барлығы
Dialogue: 0,0:46:45.80,0:46:47.88,Default,,0,0,0,,Қазірдің өзінде суланған
Dialogue: 0,0:46:48.38,0:46:49.13,Default,,0,0,0,,Әй?
Dialogue: 0,0:46:50.68,0:46:52.43,Default,,0,0,0,,Оның сүйкімді болуы міндетті емес
Dialogue: 0,0:46:52.51,0:46:54.85,Default,,0,0,0,,Мен сені қорғай алсам!
Dialogue: 0,0:46:57.94,0:47:00.73,Default,,0,0,0,,Ханым, енді жоқ...
Dialogue: 0,0:47:01.77,0:47:04.69,Default,,0,0,0,,Себас... Чан
Dialogue: 0,0:47:04.78,0:47:05.44,Default,,0,0,0,,Ханымға
Dialogue: 0,0:47:05.53,0:47:08.20,Default,,0,0,0,,Неліктен мен мұндай қиындықтан өтуім керек?
Dialogue: 0,0:47:08.70,0:47:10.28,Default,,0,0,0,,Қамқоршы болу құқығынан айырылды
Dialogue: 0,0:47:11.16,0:47:12.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:47:14.87,0:47:16.50,Default,,0,0,0,,Бұдан былай жасаймын
Dialogue: 0,0:47:16.58,0:47:19.33,Default,,0,0,0,,Жарайды, мен жеңілдім, бірақ
Dialogue: 0,0:47:19.41,0:47:20.50,Default,,0,0,0,,Толық түсінгенім жоқ, бірақ—
Dialogue: 0,0:47:20.58,0:47:22.29,Default,,0,0,0,,Әрі қарай жалғастырайық
Dialogue: 0,0:47:22.79,0:47:24.42,Default,,0,0,0,,Күлімсіре! қара!
Dialogue: 0,0:47:25.00,0:47:26.21,Default,,0,0,0,,Жылан
Dialogue: 0,0:47:27.13,0:47:28.84,Default,,0,0,0,,Лианға не болды?
Dialogue: 0,0:47:28.92,0:47:32.72,Default,,0,0,0,,Қашып кеткені өкінішті...Оскар дейді.
Dialogue: 0,0:47:34.68,0:47:35.43,Default,,0,0,0,,Себастьян!
Dialogue: 0,0:47:36.01,0:47:38.27,Default,,0,0,0,,Қазір ондай адамға алаңдайтын уақыт емес.
Dialogue: 0,0:47:38.35,0:47:40.64,Default,,0,0,0,,Лиан бұл мәселені толық бақылауында.
Dialogue: 0,0:47:40.73,0:47:42.19,Default,,0,0,0,,Оны қуып жіберейік!
Dialogue: 0,0:47:42.27,0:47:44.40,Default,,0,0,0,,-Аа? Не? -Лян...
Dialogue: 0,0:47:44.48,0:47:47.73,Default,,0,0,0,,Сонымен, егер сіз оны қатайтсаңыз, сіз қозғалатын мәйіт туралы білесіз бе?
Dialogue: 0,0:47:47.82,0:47:49.70,Default,,0,0,0,,Сенпай бұл
Dialogue: 0,0:47:50.40,0:47:52.61,Default,,0,0,0,,Хмм? Соншалықты
Dialogue: 0,0:47:52.70,0:47:54.95,Default,,0,0,0,,Бұл, әрине, ойнайтын уақыт емес.
Dialogue: 0,0:47:58.00,0:48:02.12,Default,,0,0,0,,Шындығында, бізге өлі дененің қозғалысын зерттеуді сұрады.
Dialogue: 0,0:48:02.75,0:48:06.63,Default,,0,0,0,,Кешіріңіз, бірақ әзірше осымен бітті, Себас-чан.
Dialogue: 0,0:48:07.34,0:48:11.59,Default,,0,0,0,,Келесі жолы мен сені раушан гүлдерімен ораймын.
Dialogue: 0,0:48:12.43,0:48:14.30,Default,,0,0,0,,Бұл не? Һмм… Білгің келе ме?
Dialogue: 0,0:48:14.89,0:48:15.80,Default,,0,0,0,,Біз де асығамыз...
Dialogue: 0,0:48:16.76,0:48:17.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:48:18.77,0:48:21.14,Default,,0,0,0,,Қатты! Мен сені арқамда алып жүремін.
Dialogue: 0,0:48:21.23,0:48:22.14,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:48:22.23,0:48:25.27,Default,,0,0,0,,Құрметті Элизабет, бұл менмін...
Dialogue: 0,0:48:25.77,0:48:30.24,Default,,0,0,0,,Ах! Дұрыс, маған ұнамайды...
Dialogue: 0,0:48:32.53,0:48:33.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:33.36,0:48:36.24,Default,,0,0,0,,Қайда? Огимото-яда екен ғой.
Dialogue: 0,0:48:36.33,0:48:40.16,Default,,0,0,0,,Мен Сиэл жек көретін қорқынышты қызбын.
Dialogue: 0,0:48:40.25,0:48:42.16,Default,,0,0,0,,ше? Бұл не?
Dialogue: 0,0:48:42.25,0:48:46.42,Default,,0,0,0,,Өйткені мен күшті әйелдерді ұнатпаймын деп баяғыда айтқанмын.
Dialogue: 0,0:48:46.50,0:48:49.13,Default,,0,0,0,,Сонымен... бұл баяғыда, солай ма?
Dialogue: 0,0:48:49.92,0:48:52.55,Default,,0,0,0,,Мен кешірім сұрауым керек.
Dialogue: 0,0:48:54.01,0:48:56.39,Default,,0,0,0,,Сонда маған тұрмысқа шығасың ба?
Dialogue: 0,0:48:56.47,0:48:57.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:57.30,0:48:58.81,Default,,0,0,0,,Сен оны жек көрмейсің бе?
Dialogue: 0,0:48:58.89,0:49:00.93,Default,,0,0,0,,Мен... Маған ұнамайды...
Dialogue: 0,0:49:03.89,0:49:04.60,Default,,0,0,0,,А… арыстан!
Dialogue: 0,0:49:04.69,0:49:06.06,Default,,0,0,0,,Қазір уақыт емес!
Dialogue: 0,0:49:06.15,0:49:07.02,Default,,0,0,0,,Куку куку…
Dialogue: 0,0:49:07.11,0:49:08.19,Default,,0,0,0,,Жоғарыға барайық!
Dialogue: 0,0:49:09.32,0:49:11.11,Default,,0,0,0,,А, бұл біртүрлі.
Dialogue: 0,0:49:11.61,0:49:15.36,Default,,0,0,0,,Жас бала күткендей, ол ханым алдында мүлдем пайдасыз ба?
Dialogue: 0,0:49:15.45,0:49:16.53,Default,,0,0,0,,Шулы, үндемеңіз
Dialogue: 0,0:49:17.49,0:49:20.62,Default,,0,0,0,,Хмм... кеттік.
Dialogue: 0,0:49:22.75,0:49:24.08,Default,,0,0,0,,Тіркелмеген Арнайы Сынып па?
Dialogue: 0,0:49:24.16,0:49:26.92,Default,,0,0,0,,Сіз қашанға дейін күліп жүресіз?
Dialogue: 0,0:49:30.46,0:49:32.80,Default,,0,0,0,,Түсіңіз! Алдымен әйелдер мен балалар!
Dialogue: 0,0:49:32.88,0:49:35.01,Default,,0,0,0,,Әлі де ағылшын джентльмені ме?
Dialogue: 0,0:49:35.51,0:49:36.89,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:49:38.14,0:49:40.89,Default,,0,0,0,,О! Аман жүргеніңізге қуаныштымын!
Dialogue: 0,0:49:43.39,0:49:45.56,Default,,0,0,0,,Эдвард, сенен бір өтінішім бар.
Dialogue: 0,0:49:46.40,0:49:48.73,Default,,0,0,0,,Менің орныма мына жігітті мінгіз.
Dialogue: 0,0:49:48.81,0:49:49.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:50.27,0:49:52.32,Default,,0,0,0,,Мен әлі қайыққа міне алмаймын.
Dialogue: 0,0:49:52.40,0:49:54.07,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Жоқ!
Dialogue: 0,0:49:54.15,0:49:55.95,Default,,0,0,0,,Бұл қауіпті! ...Оскар осылай дейді.
Dialogue: 0,0:49:56.03,0:49:58.41,Default,,0,0,0,,Егер Сиэл қалса, мен де солай боламын...
Dialogue: 0,0:49:58.49,0:49:59.78,Default,,0,0,0,,Батлер!
Dialogue: 0,0:49:59.87,0:50:02.12,Default,,0,0,0,,Элизабетті қалай сендіруге болады
Dialogue: 0,0:50:02.20,0:50:04.12,Default,,0,0,0,,Өйткені бұл көп уақытты алатын сияқты.
Dialogue: 0,0:50:05.29,0:50:07.00,Default,,0,0,0,,Мен Лиззиді сұраймын.
Dialogue: 0,0:50:08.71,0:50:10.42,Default,,0,0,0,,Түсіндім, сақтаймын.
Dialogue: 0,0:50:11.84,0:50:13.34,Default,,0,0,0,,Кеттік, Себастьян.
Dialogue: 0,0:50:13.42,0:50:14.01,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:50:14.51,0:50:16.38,Default,,0,0,0,,Қайтып келудің қажеті жоқ.
Dialogue: 0,0:50:17.47,0:50:20.10,Default,,0,0,0,,Менің сүйкімді әпкемге үйленудің қажеті жоқ
Dialogue: 0,0:50:20.72,0:50:22.39,Default,,0,0,0,,Міндетті түрде оралады
Dialogue: 0,0:50:33.53,0:50:36.03,Default,,0,0,0,,Қат! Ол қатты қисайған
Dialogue: 0,0:50:36.53,0:50:37.95,Default,,0,0,0,,≪(Дэннидің үрген дауысы) (Джонатан) Дұрыс~, жақсы бала!
Dialogue: 0,0:50:38.03,0:50:38.53,Default,,0,0,0,,О... уау
Dialogue: 0,0:50:39.49,0:50:40.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:50:42.83,0:50:45.79,Default,,0,0,0,,А, ол өте жақсы жігіт емес.
Dialogue: 0,0:50:46.37,0:50:47.96,Default,,0,0,0,,Цуккамэта!
Dialogue: 0,0:50:49.12,0:50:52.42,Default,,0,0,0,,Мәйітті өзгертіп, оны жылжытып жатқаныңыз дұрыс па?
Dialogue: 0,0:50:53.13,0:50:56.13,Default,,0,0,0,,Тәртіпсіздіктер проблема болып табылады, солай емес пе?
Dialogue: 0,0:50:56.76,0:51:01.14,Default,,0,0,0,,Өлім бұл дүниеде ешқашан жойылмайтын ереже болуы керек.
Dialogue: 0,0:51:01.22,0:51:03.76,Default,,0,0,0,,-да? Бұл мәйітті қалай тоқтатуға болады?
Dialogue: 0,0:51:03.85,0:51:07.98,Default,,0,0,0,,Мен... Менің бөлмемде толық жеңілдікті жоққа шығаратын құрылғы бар!
Dialogue: 0,0:51:09.14,0:51:12.31,Default,,0,0,0,,(Қиындық сигналының іске қосылу дыбысы)
Dialogue: 0,0:51:18.45,0:51:20.16,Default,,0,0,0,,Сағатыңызды назардан тыс қалдырмаңыз!
Dialogue: 0,0:51:20.24,0:51:23.58,Default,,0,0,0,,Бұл құбыжықтар бізге кез келген уақытта қайта шабуыл жасауы мүмкін.
Dialogue: 0,0:51:24.28,0:51:27.08,Default,,0,0,0,,Теңізге жақын жүзіп бара жатқан жүк кемесінен хабар алдық!
Dialogue: 0,0:51:27.16,0:51:29.54,Default,,0,0,0,,Олар екі сағаттан кейін келеміз дейді.
Dialogue: 0,0:51:29.62,0:51:30.58,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:51:30.67,0:51:32.88,Default,,0,0,0,,Осы уақытқа дейін мүмкіндігінше көп адамды қайыққа отырғызыңыз.
Dialogue: 0,0:51:32.96,0:51:34.00,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:51:34.09,0:51:35.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:35.88,0:51:39.55,Default,,0,0,0,,-де? Ол құрылғы қайда?
Dialogue: 0,0:51:39.63,0:51:40.80,Default,,0,0,0,,Бұл...
Dialogue: 0,0:51:40.88,0:51:41.72,Default,,0,0,0,,Бұл жерде...
Dialogue: 0,0:51:42.34,0:51:42.97,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:51:43.55,0:51:45.01,Default,,0,0,0,,Әлгі адам...
Dialogue: 0,0:51:45.81,0:51:47.52,Default,,0,0,0,,А, сен
Dialogue: 0,0:51:48.81,0:51:50.31,Default,,0,0,0,,Виконт Друитт!
Dialogue: 0,0:51:50.94,0:51:54.31,Default,,0,0,0,,Иә? Бір жерде кездескен сияқтымыз...
Dialogue: 0,0:51:54.40,0:51:55.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:55.98,0:52:00.07,Default,,0,0,0,,Әлде мәйіттің қозғалуын тоқтататын құрылғы шығар?
Dialogue: 0,0:52:00.15,0:52:03.11,Default,,0,0,0,,Хехехе, білгің келсе менімен жүр.
Dialogue: 0,0:52:03.99,0:52:10.08,Default,,0,0,0,,Медицина арқылы жаңа таң, Аврораның келуі...
Dialogue: 0,0:52:12.79,0:52:15.13,Default,,0,0,0,,Мен оны күшпен аламын ба?
Dialogue: 0,0:52:15.63,0:52:18.80,Default,,0,0,0,,Жоқ, біз оны қалай қолдану керектігін білмейміз.
Dialogue: 0,0:52:19.30,0:52:21.76,Default,,0,0,0,,-Ол іске қоссын... -(Жаназашы) Хехехе...
Dialogue: 0,0:52:21.84,0:52:24.30,Default,,0,0,0,,Не...жерлеуді ұйымдастырушы?
Dialogue: 0,0:52:24.39,0:52:25.22,Default,,0,0,0,,Сәлем
Dialogue: 0,0:52:25.30,0:52:26.35,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:52:26.43,0:52:27.76,Default,,0,0,0,,Жүгіруде
Dialogue: 0,0:52:27.85,0:52:31.35,Default,,0,0,0,,Ол менен оны көтеруге көмектесуімді өтінді.
Dialogue: 0,0:52:32.06,0:52:35.36,Default,,0,0,0,,Сонымен қатар, сіз мұны қалай пайдалану керектігін білмейсіз бе?
Dialogue: 0,0:52:36.06,0:52:39.36,Default,,0,0,0,,Ендеше, мұндай нәрседен не пайда?
Dialogue: 0,0:52:44.11,0:52:46.37,Default,,0,0,0,,Сақ болуларыңызды сұраймын.
Dialogue: 0,0:52:46.45,0:52:48.91,Default,,0,0,0,,Бұл сенің өміріңнен де қымбат.
Dialogue: 0,0:52:48.99,0:52:50.58,Default,,0,0,0,,Бұл басталады ма?
Dialogue: 0,0:52:50.66,0:52:53.25,Default,,0,0,0,,Әлі жоқ Әлі жоқ Актер құрамы жеткіліксіз
Dialogue: 0,0:52:53.33,0:52:54.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:54.29,0:52:55.17,Default,,0,0,0,,Актер?
Dialogue: 0,0:52:55.25,0:52:56.75,Default,,0,0,0,,А, сен!
Dialogue: 0,0:52:56.84,0:52:58.21,Default,,0,0,0,,Неліктен құрылғы?
Dialogue: 0,0:52:58.30,0:52:59.25,Default,,0,0,0,,Сәлем, Линна
Dialogue: 0,0:52:59.34,0:53:01.42,Default,,0,0,0,,Мен сені күттім
Dialogue: 0,0:53:01.51,0:53:06.60,Default,,0,0,0,,Бүгін сіз құрған империя Помпей сияқты бір түнде жойылады.
Dialogue: 0,0:53:06.68,0:53:10.10,Default,,0,0,0,,Бұл менің жаңа империямның туған күні!
Dialogue: 0,0:53:11.06,0:53:16.77,Default,,0,0,0,,Мен осы құрылғының күшімен жаңа империя құрамын.
Dialogue: 0,0:53:16.86,0:53:17.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:17.86,0:53:22.40,Default,,0,0,0,,Мәңгілікке қол жеткізгендер азғындықпен және декадентті сұлулықпен билік жүргізеді.
Dialogue: 0,0:53:22.49,0:53:25.86,Default,,0,0,0,,Оның аты Аврора империясы!
Dialogue: 0,0:53:25.95,0:53:28.66,Default,,0,0,0,,Бұл өте күрделі сияқты.
Dialogue: 0,0:53:28.74,0:53:30.95,Default,,0,0,0,,Әлгі жігіт, мен оны бірден қызартып жіберемін.
Dialogue: 0,0:53:31.04,0:53:32.50,Default,,0,0,0,,Ой
Dialogue: 0,0:53:32.58,0:53:34.75,Default,,0,0,0,,Бұл құрылғымен не болады?
Dialogue: 0,0:53:34.83,0:53:36.75,Default,,0,0,0,,- Иә? Сіз қандайсыз? -Танма, сенпайым.
Dialogue: 0,0:53:37.33,0:53:39.50,Default,,0,0,0,,Бұл нағыз күш!
Dialogue: 0,0:53:39.59,0:53:43.51,Default,,0,0,0,,Мен сені бір стақан шараппен жеңемін.
Dialogue: 0,0:53:43.59,0:53:45.76,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:53:45.84,0:53:47.72,Default,,0,0,0,,Сені өлтіргенімді қалайсың ба?
Dialogue: 0,0:53:47.80,0:53:49.76,Default,,0,0,0,,Жоқ, күте тұрыңыз, мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:53:51.35,0:53:51.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:53:52.06,0:53:57.06,Default,,0,0,0,,Уф… Жоғарыдан ба?
Dialogue: 0,0:53:59.98,0:54:02.32,Default,,0,0,0,,Эй, бұл нөмір...
Dialogue: 0,0:54:04.24,0:54:05.95,Default,,0,0,0,,Виконт Құрылғыны алуға асығыңыз!
Dialogue: 0,0:54:06.03,0:54:07.32,Default,,0,0,0,,Екінші жігіт мені мазақ еткенде…
Dialogue: 0,0:54:07.41,0:54:09.45,Default,,0,0,0,,Мен енді виконт емеспін
Dialogue: 0,0:54:09.53,0:54:14.12,Default,,0,0,0,,Император (Кайзер) Егер мені осылай атасаңыз, мен оны іске қосамын.
Dialogue: 0,0:54:14.20,0:54:16.33,Default,,0,0,0,,Енді оны өлтірейік.
Dialogue: 0,0:54:16.41,0:54:18.79,Default,,0,0,0,,Күте тұрыңыз. Сенің сезіміңді түсінемін.
Dialogue: 0,0:54:20.42,0:54:22.05,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:54:28.68,0:54:30.39,Default,,0,0,0,,Не болып жатыр? Не болып жатыр?
Dialogue: 0,0:54:36.35,0:54:36.85,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:54:36.94,0:54:38.56,Default,,0,0,0,,Энн До…
Dialogue: 0,0:54:41.15,0:54:41.73,Default,,0,0,0,,Троа!
Dialogue: 0,0:54:44.69,0:54:45.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:54:45.78,0:54:47.32,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:54:49.49,0:54:51.20,Default,,0,0,0,,О!
Dialogue: 0,0:54:51.28,0:54:54.66,Default,,0,0,0,,Өмірлерін қатерге тіккен гладиаторлар
Dialogue: 0,0:54:55.16,0:54:58.50,Default,,0,0,0,,Бұл азғындықтың колизейі сияқты.
Dialogue: 0,0:54:58.58,0:55:05.01,Default,,0,0,0,,Төмен қарап, шарап жұтып отырсам, мен император Нерон сияқтымын!
Dialogue: 0,0:55:05.09,0:55:08.13,Default,,0,0,0,,А, сен оны өлтірген жоқсың ба?
Dialogue: 0,0:55:08.22,0:55:10.14,Default,,0,0,0,,Сіз мені ертерек тоқтаттыңыз, солай ма?
Dialogue: 0,0:55:10.22,0:55:13.05,Default,,0,0,0,,Сіз, қазір жылжытыңыз!
Dialogue: 0,0:55:13.76,0:55:17.02,Default,,0,0,0,,Жарайды, ұлтты табатын кез келді.
Dialogue: 0,0:55:17.64,0:55:21.98,Default,,0,0,0,,Кәне, бәріміз, Қайзерге ант етіңдер.
Dialogue: 0,0:55:22.06,0:55:25.03,Default,,0,0,0,,Маған Феникс биін көрсет!
Dialogue: 0,0:55:25.82,0:55:27.36,Default,,0,0,0,,Мен сені өлтіремін деп ойлаймын.
Dialogue: 0,0:55:27.94,0:55:33.49,Default,,0,0,0,,О, мен бұл құрылғының не екенін білмеймін. Жарайды ма?
Dialogue: 0,0:55:34.20,0:55:34.91,Default,,0,0,0,,Цк
Dialogue: 0,0:55:34.99,0:55:36.79,Default,,0,0,0,,- (жерлеуші) Гуфуфуфуфу - Не болып жатыр?
Dialogue: 0,0:55:36.87,0:55:38.62,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:55:41.46,0:55:43.59,Default,,0,0,0,,«Керемет кеуде жалыны»
Dialogue: 0,0:55:44.59,0:55:47.01,Default,,0,0,0,,«Оны ешкім өшіре алмайды»
Dialogue: 0,0:55:47.76,0:55:49.88,Default,,0,0,0,,«Біз жаңамыз»
Dialogue: 0,0:55:49.97,0:55:51.80,Default,,0,0,0,,«Феникс»
Dialogue: 0,0:55:53.89,0:55:56.47,Default,,0,0,0,,Жарайсыңдар балалар! Мен саған көрсетемін
Dialogue: 0,0:55:56.56,0:55:58.77,Default,,0,0,0,,Маған тағзым етіңдер, өлім легиондары!
Dialogue: 0,0:55:59.93,0:56:02.94,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,0:56:06.90,0:56:07.90,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:56:07.98,0:56:08.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:08.78,0:56:09.74,Default,,0,0,0,,- Иә? -сурет?
Dialogue: 0,0:56:09.82,0:56:10.86,Default,,0,0,0,,Гуаааааа!
Dialogue: 0,0:56:10.95,0:56:11.86,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:56:11.95,0:56:13.95,Default,,0,0,0,,Гяхахахаха!
Dialogue: 0,0:56:14.03,0:56:15.24,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:56:15.33,0:56:16.20,Default,,0,0,0,,Лиан
Dialogue: 0,0:56:16.28,0:56:19.16,Default,,0,0,0,,Сіз жасаған құрылғы әсер етпейді.
Dialogue: 0,0:56:19.25,0:56:19.91,Default,,0,0,0,,Міне!
Dialogue: 0,0:56:20.00,0:56:21.75,Default,,0,0,0,,Сіз үлгермедіңіз бе?
Dialogue: 0,0:56:21.83,0:56:24.63,Default,,0,0,0,,Мен мұндай нәрсені жасай алмаймын.
Dialogue: 0,0:56:25.25,0:56:26.75,Default,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,0:56:26.84,0:56:28.42,Default,,0,0,0,,Мені алдадың ба?
Dialogue: 0,0:56:29.96,0:56:31.80,Default,,0,0,0,,Қандай фарс.
Dialogue: 0,0:56:38.01,0:56:39.18,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:56:39.27,0:56:41.60,Default,,0,0,0,,Бұл керемет... сенпай!
Dialogue: 0,0:56:41.68,0:56:44.65,Default,,0,0,0,,Адам өлтіру жаман деп айттық!
Dialogue: 0,0:56:47.48,0:56:48.11,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:56:50.94,0:56:52.61,Default,,0,0,0,,Хи хи хи хи...
Dialogue: 0,0:56:53.82,0:56:56.66,Default,,0,0,0,,Осылай күлгеніме біраз болды.
Dialogue: 0,0:56:58.08,0:57:00.50,Default,,0,0,0,,Осындай қызық адамнан айырылу
Dialogue: 0,0:57:00.58,0:57:05.08,Default,,0,0,0,,Мен үшін бұл дүние үшін шығын, солай емес пе?
Dialogue: 0,0:57:05.96,0:57:09.46,Default,,0,0,0,,Сіз де солай ойламайсыз ба? Шинигами-кун
Dialogue: 0,0:57:21.81,0:57:22.60,Default,,0,0,0,,Тұтқындарға арналған екінші жатақхана.
Dialogue: 0,0:57:35.91,0:57:37.32,Default,,0,0,0,,-Ботчан! -Аа...
Dialogue: 0,0:57:39.08,0:57:42.20,Default,,0,0,0,,Аа, бұл өкінішті.
Dialogue: 0,0:57:43.54,0:57:47.25,Default,,0,0,0,,Бұл жерде күлкі жоғалады
Dialogue: 0,0:57:51.38,0:57:53.05,Default,,0,0,0,,Жетекші…
Dialogue: 0,0:57:53.55,0:57:55.84,Default,,0,0,0,,Сіз өзіңіздің қатысуыңызды өшіру үшін жақсы жұмыс жасадыңыз.
Dialogue: 0,0:57:55.93,0:57:59.68,Default,,0,0,0,,Оның көзі де жасырын, сондықтан мен де байқамадым.
Dialogue: 0,0:57:59.76,0:58:03.14,Default,,0,0,0,,Мені де ұрды.
Dialogue: 0,0:58:03.22,0:58:04.52,Default,,0,0,0,,Сенпай, анау көздер...
Dialogue: 0,0:58:05.19,0:58:09.73,Default,,0,0,0,,Иә, бұл сары-жасыл фосфоресценция сөзсіз...
Dialogue: 0,0:58:09.81,0:58:11.32,Default,,0,0,0,,Қылмыскер!
Dialogue: 0,0:58:11.82,0:58:12.73,Default,,0,0,0,,Хи хи
Dialogue: 0,0:58:12.82,0:58:17.53,Default,,0,0,0,,Бұл соншалықты сағыныш. Бұлай аталмағаныма жарты ғасыр болды.
Dialogue: 0,0:58:18.36,0:58:20.99,Default,,0,0,0,,Жүргізуші өлім құдайы ма?
Dialogue: 0,0:58:21.49,0:58:23.45,Default,,0,0,0,,Сіз нені айтасыз, кәсіпкер?
Dialogue: 0,0:58:24.20,0:58:25.25,Default,,0,0,0,,Осы құрылғымен
Dialogue: 0,0:58:25.33,0:58:27.92,Default,,0,0,0,,Мен саған бұл мәйітті басқара алатынымды айттым ғой!
Dialogue: 0,0:58:28.00,0:58:29.83,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:58:29.92,0:58:31.46,Default,,0,0,0,,Сіз алдадыңыз ба?
Dialogue: 0,0:58:31.54,0:58:36.42,Default,,0,0,0,,Өйткені сіз дәрі-дәрмектің көмегімен өлгендерді тірілтуге тырысып жатырсыз.
Dialogue: 0,0:58:36.51,0:58:38.30,Default,,0,0,0,,Бұл күлкілі.
Dialogue: 0,0:58:38.38,0:58:41.47,Default,,0,0,0,,Бұл бүкіл әлемді медицина арқылы сау ету туралы.
Dialogue: 0,0:58:41.55,0:58:42.81,Default,,0,0,0,,Өйткені мақсат бар...
Dialogue: 0,0:58:42.89,0:58:48.73,Default,,0,0,0,,Бірақ жас студенттің шеберлігіне сенгеннен кейін, ол енді медицина емес.
Dialogue: 0,0:58:48.81,0:58:49.94,Default,,0,0,0,,Ха…
Dialogue: 0,0:58:50.02,0:58:52.07,Default,,0,0,0,,Сіз түсінбейтін емдеу әдістері
Dialogue: 0,0:58:52.15,0:58:56.24,Default,,0,0,0,,Науқастарды емдейтін адам енді дәрігер емес.
Dialogue: 0,0:58:56.32,0:58:58.74,Default,,0,0,0,,А... міне, солай...
Dialogue: 0,0:59:03.08,0:59:07.16,Default,,0,0,0,,Сіз менің әңгімеме ақымақ сендіңіз.
Dialogue: 0,0:59:07.96,0:59:09.67,Default,,0,0,0,,Ол жақсы бала еді.
Dialogue: 0,0:59:10.71,0:59:15.92,Default,,0,0,0,,Демек, сіз адам реанимациясының тәжірибесін ұйымдастырушысыз ба?
Dialogue: 0,0:59:16.01,0:59:17.30,Default,,0,0,0,,Жетекші
Dialogue: 0,0:59:18.38,0:59:19.47,Default,,0,0,0,,№
Dialogue: 0,0:59:20.09,0:59:22.01,Default,,0,0,0,,...
Dialogue: 0,0:59:22.10,0:59:23.55,Default,,0,0,0,,Граф үшін феникс позасын қолданыңыз.
Dialogue: 0,0:59:23.64,0:59:27.31,Default,,0,0,0,,Мен көп ақпарат төлеуге тура келді.
Dialogue: 0,0:59:28.02,0:59:29.48,Default,,0,0,0,,Мен сізге айтайын
Dialogue: 0,0:59:30.40,0:59:34.65,Default,,0,0,0,,Бұл қозғалатын мәйітті жасаған мен болғаным рас.
Dialogue: 0,0:59:34.73,0:59:35.65,Default,,0,0,0,,Не үшін?
Dialogue: 0,0:59:36.69,0:59:38.40,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:59:38.49,0:59:43.20,Default,,0,0,0,,Бастапқыда бұл тек адамдарға деген қызығушылық болса керек.
Dialogue: 0,0:59:57.88,1:00:01.01,Default,,0,0,0,,Адамның тән тәні мен жаны бар.
Dialogue: 0,1:00:01.09,1:00:04.26,Default,,0,0,0,,Бұл екеуі қосылса, олар тірі жан ретінде өмір сүреді.
Dialogue: 0,1:00:04.35,1:00:07.27,Default,,0,0,0,,«Кинематографиялық рекорд» өмір туралы естеліктер
Dialogue: 0,1:00:07.35,1:00:09.14,Default,,0,0,0,,Жазуды жалғастырыңыз
Dialogue: 0,1:00:10.18,1:00:15.77,Default,,0,0,0,,Ал физикалық дене ыдырап, өлім құдайы жанды жинағанда,
Dialogue: 0,1:00:15.86,1:00:19.49,Default,,0,0,0,,Онда жазу бітеді, ал тірілер өліге айналады.
Dialogue: 0,1:00:20.45,1:00:24.91,Default,,0,0,0,,Қасқыр адам денеден тізім бойынша жанды шығарады.
Dialogue: 0,1:00:24.99,1:00:28.33,Default,,0,0,0,,Жазбаның соңын келтіретін адам
Dialogue: 0,1:00:30.16,1:00:34.67,Default,,0,0,0,,Күн сайын байсалды және немқұрайлы
Dialogue: 0,1:00:35.34,1:00:40.01,Default,,0,0,0,,Бірақ мен өлім құдайы ретінде күнделікті өмірімді осылай өткізетінмін.
Dialogue: 0,1:00:40.09,1:00:42.51,Default,,0,0,0,,Бір күні мен ойладым
Dialogue: 0,1:00:43.38,1:00:46.60,Default,,0,0,0,,«Егер аяқталудың жалғасы болса не болар еді?»
Dialogue: 0,1:00:46.68,1:00:47.72,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:48.35,1:00:51.48,Default,,0,0,0,,Жанынан айырылып, соңына жеткен жазба
Dialogue: 0,1:00:51.56,1:00:53.44,Default,,0,0,0,,Жалғасын жалғастырсаңыз
Dialogue: 0,1:00:53.52,1:00:56.77,Default,,0,0,0,,Физикалық денемен не болады?
Dialogue: 0,1:00:57.82,1:01:01.24,Default,,0,0,0,,Жазбаны өңдедім дегіңіз келді ме?
Dialogue: 0,1:01:01.32,1:01:03.99,Default,,0,0,0,,Хи хи, онда.
Dialogue: 0,1:01:04.70,1:01:08.28,Default,,0,0,0,,Неліктен олардың жазбаларын өз мүмкіндіктеріңізбен тексермейсіз?
Dialogue: 0,1:01:08.37,1:01:09.16,Default,,0,0,0,,Құт
Dialogue: 0,1:01:21.80,1:01:22.80,Default,,0,0,0,,Саған қонақүй тауып беремін.
Dialogue: 0,1:01:26.59,1:01:28.85,Default,,0,0,0,,Күте тұрыңыз... бұл не?
Dialogue: 0,1:01:28.93,1:01:29.56,Default,,0,0,0,,Бұл...
Dialogue: 0,1:01:29.64,1:01:30.64,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:01:31.60,1:01:33.31,Default,,0,0,0,,Өліммен бірге келуі керек
Dialogue: 0,1:01:33.39,1:01:35.73,Default,,0,0,0,,Кинематографиялық жазбаның аяқталу белгісі болып табылады
Dialogue: 0,1:01:36.40,1:01:40.07,Default,,0,0,0,,Осылайша оқушы жалған жазбаны қосты.
Dialogue: 0,1:01:40.15,1:01:42.61,Default,,0,0,0,,Енді бармаған
Dialogue: 0,1:01:42.69,1:01:47.87,Default,,0,0,0,,Сосын таң қалдым, өмір әлі жалғасып жатыр деп қателескен денемнің бөліктері.
Dialogue: 0,1:01:47.95,1:01:52.12,Default,,0,0,0,,Қайтадан ісімді жансыз бастадым.
Dialogue: 0,1:01:52.20,1:01:53.08,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:01:53.71,1:01:56.00,Default,,0,0,0,,Ал олар оянғанда инстинктивті түрде
Dialogue: 0,1:01:56.08,1:02:02.46,Default,,0,0,0,,Маған жетпейтінін, «жанын» іздеп, тірінің тәнін ашуға талпынамын
Dialogue: 0,1:02:03.34,1:02:07.55,Default,,0,0,0,,Ешқашан бітпейтін кинематографиялық рекордты теңестіру үшін
Dialogue: 0,1:02:08.18,1:02:11.60,Default,,0,0,0,,Сонда олар біздің жанымызды қуып жатыр ма?
Dialogue: 0,1:02:12.85,1:02:15.10,Default,,0,0,0,,Басқа адамдардың жан дүниесі
Dialogue: 0,1:02:15.18,1:02:18.56,Default,,0,0,0,,Мен оны өз бетімше жасай алмаймын.
Dialogue: 0,1:02:20.65,1:02:23.03,Default,,0,0,0,,Эгосыз ет қуыршақ
Dialogue: 0,1:02:23.11,1:02:25.90,Default,,0,0,0,,«Біртүрлі қуыршақ» тірі де, өлі де емес
Dialogue: 0,1:02:25.99,1:02:28.16,Default,,0,0,0,,Гуаааа!
Dialogue: 0,1:02:28.66,1:02:30.99,Default,,0,0,0,,Тірі кезіндегідей әдемі тігілген.
Dialogue: 0,1:02:31.08,1:02:34.00,Default,,0,0,0,,Балауыз тәрізді ақ тері
Dialogue: 0,1:02:34.79,1:02:39.92,Default,,0,0,0,,Енді шу шығармайтын, өтірік айтпайтын ауыз.
Dialogue: 0,1:02:40.00,1:02:43.13,Default,,0,0,0,,Сіз тірі кезіңізден әлдеқайда сұлусыз, солай емес пе?
Dialogue: 0,1:02:43.21,1:02:44.51,Default,,0,0,0,,Оларды осылай тазартып отыруды жалғастыр.
Dialogue: 0,1:02:44.59,1:02:46.13,Default,,0,0,0,,Хи хи
Dialogue: 0,1:02:46.22,1:02:50.72,Default,,0,0,0,,Бұл сұлулықты графтың өзі әлі түсінбейді.
Dialogue: 0,1:02:51.43,1:02:55.22,Default,,0,0,0,,Бұл қызық қуыршақты қалайтындар бар, солай ма?
Dialogue: 0,1:02:56.31,1:02:59.69,Default,,0,0,0,,Бұл балалар ауруды немесе қорқынышты сезбейді.
Dialogue: 0,1:02:59.77,1:03:02.82,Default,,0,0,0,,Жан іздеп, жанды жеу
Dialogue: 0,1:03:02.90,1:03:06.82,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл жануарлардың ең жақсы қаруы емес пе?
Dialogue: 0,1:03:08.40,1:03:10.45,Default,,0,0,0,,Сол ессіз адамдар
Dialogue: 0,1:03:10.53,1:03:13.62,Default,,0,0,0,,Ол мұны қаншалықты жақсы пайдалана алатынын көргісі келетінін айтты.
Dialogue: 0,1:03:14.20,1:03:18.21,Default,,0,0,0,,Сәнді круиздік кемеге бірдей адамдар мен қызық қуыршақтарды тастаңыз.
Dialogue: 0,1:03:18.29,1:03:20.67,Default,,0,0,0,,Мен эксперимент жасап көрейін деп шештім.
Dialogue: 0,1:03:20.75,1:03:24.55,Default,,0,0,0,,Бір-бірімізді өлтірсек, қайсысы тірі қалады және қанша уақытқа дейін?
Dialogue: 0,1:03:24.63,1:03:25.71,Default,,0,0,0,,Иә
Dialogue: 0,1:03:25.80,1:03:27.42,Default,,0,0,0,,Ол сынған.
Dialogue: 0,1:03:27.92,1:03:28.72,Default,,0,0,0,,Хи хи
Dialogue: 0,1:03:28.80,1:03:33.55,Default,,0,0,0,,Бірақ мен айсбергке соғылатынымды ешқашан ойламадым.
Dialogue: 0,1:03:34.06,1:03:38.43,Default,,0,0,0,,Шинигами болуды тастаған студентте енді тізім жоқ.
Dialogue: 0,1:03:38.94,1:03:43.69,Default,,0,0,0,,Жарайды, бұл мені суға батыру қиындығынан құтқарды, сондықтан мен бір таспен екі құсты өлтірдім.
Dialogue: 0,1:03:43.77,1:03:44.69,Default,,0,0,0,,Өтінемін, осы екеуін қорға
Dialogue: 0,1:03:46.07,1:03:49.32,Default,,0,0,0,,Хмф! Мен оны енді сағынбаймын
Dialogue: 0,1:03:49.40,1:03:50.45,Default,,0,0,0,,Ал...
Dialogue: 0,1:03:50.53,1:03:53.82,Default,,0,0,0,,Қасқырдың өлімді бұрмалауы тым мүмкін емес.
Dialogue: 0,1:03:53.91,1:03:58.08,Default,,0,0,0,,Шаршасам да көзілдірік тақпаймын. Бөлінген топ ше?
Dialogue: 0,1:03:58.87,1:04:00.79,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,1:04:00.87,1:04:06.13,Default,,0,0,0,,Қалай болғанда да, Шинигамидің өмір мен өлім тұрғысынан адам әлеміне араласуы ережелерге қайшы келеді.
Dialogue: 0,1:04:06.21,1:04:08.21,Default,,0,0,0,,Менің ағам осылай деді...
Dialogue: 0,1:04:08.30,1:04:09.42,Default,,0,0,0,,Бірақ одан да көп
Dialogue: 0,1:04:10.09,1:04:12.30,Default,,0,0,0,,Қыздың бетіне тыртық салу қылмысы
Dialogue: 0,1:04:12.39,1:04:15.10,Default,,0,0,0,,Қанша сымбатты болса да, мен оны кешірмеймін!
Dialogue: 0,1:04:15.18,1:04:16.06,Default,,0,0,0,,Күрсін!
Dialogue: 0,1:04:18.81,1:04:20.06,Default,,0,0,0,,Артқа Тори…
Dialogue: 0,1:04:20.14,1:04:21.06,Default,,0,0,0,,Өте беделді адамды әкеліпсің ғой, иә?
Dialogue: 0,1:04:23.23,1:04:23.90,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,1:04:26.86,1:04:28.53,Default,,0,0,0,,Себас-чан, сен не айтып тұрсың?
Dialogue: 0,1:04:28.61,1:04:31.82,Default,,0,0,0,,Мен сенің оны алып кеткеніңді қаламас едім.
Dialogue: 0,1:04:31.90,1:04:32.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:32.53,1:04:36.87,Default,,0,0,0,,Біздің де патшайымның алдында шындықты жеткізу міндеті бар.
Dialogue: 0,1:04:37.37,1:04:40.00,Default,,0,0,0,,Біз оның мұнда қашып кетуіне жол бере алмаймыз.
Dialogue: 0,1:04:40.50,1:04:43.46,Default,,0,0,0,,Бұл Шинигами біз үшін проблема.
Dialogue: 0,1:04:43.54,1:04:44.63,Default,,0,0,0,,Сырттағы алаңды тартыңыз!
Dialogue: 0,1:04:44.71,1:04:47.30,Default,,0,0,0,,Бұл да күтушінің жұмысы.
Dialogue: 0,1:04:47.38,1:04:49.38,Default,,0,0,0,,Сыртта болыңыз.
Dialogue: 0,1:04:49.46,1:04:50.92,Default,,0,0,0,,О, ау
Dialogue: 0,1:04:51.42,1:04:53.68,Default,,0,0,0,,Сіз бұрынғыдай шыдамсызсыз.
Dialogue: 0,1:04:53.76,1:04:54.97,Default,,0,0,0,,Себас-чан
Dialogue: 0,1:04:56.14,1:04:56.72,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,1:04:57.39,1:05:00.60,Default,,0,0,0,,Қаласаңыз, мен де тыйылмаймын.
Dialogue: 0,1:05:00.68,1:05:03.98,Default,,0,0,0,,Сіздің сөздігіңізде ``құлықсыздық'' сөзі болуы мүмкін бе?
Dialogue: 0,1:05:04.06,1:05:06.11,Default,,0,0,0,,Бүгінгі таңдағы ең үлкен тосынсый.
Dialogue: 0,1:05:06.61,1:05:09.44,Default,,0,0,0,,Бұл қарапайым, бірінші келген, бірінші қызмет ететін.
Dialogue: 0,1:05:10.19,1:05:12.65,Default,,0,0,0,,Қариядан жеңілгім келмейді.
Dialogue: 0,1:05:12.74,1:05:17.20,Default,,0,0,0,,Хи хи, қоян аулау сияқты~
Dialogue: 0,1:05:17.28,1:05:18.70,Default,,0,0,0,,Қазір
Dialogue: 0,1:05:19.20,1:05:21.66,Default,,0,0,0,,Қандай қоянды аулайды?
Dialogue: 0,1:05:26.13,1:05:26.63,Default,,0,0,0,,Иә
Dialogue: 0,1:05:29.88,1:05:32.63,Default,,0,0,0,,Talattatattatta…ta~♪
Dialogue: 0,1:05:33.13,1:05:34.47,Default,,0,0,0,,Ах... эй!
Dialogue: 0,1:05:34.55,1:05:35.38,Default,,0,0,0,,Керемет!
Dialogue: 0,1:05:41.56,1:05:42.64,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,1:05:49.61,1:05:50.78,Default,,0,0,0,,Хун
Dialogue: 0,1:05:57.62,1:05:59.87,Default,,0,0,0,,Ой, мен қателік жібердім.
Dialogue: 0,1:05:59.95,1:06:02.45,Default,,0,0,0,,Сіздің көру қабілетіңіз шынымен нашар сияқты.
Dialogue: 0,1:06:02.54,1:06:03.33,Default,,0,0,0,,Ой
Dialogue: 0,1:06:03.41,1:06:06.62,Default,,0,0,0,,Синигамидің барлығы қысқа көргіш.
Dialogue: 0,1:06:06.71,1:06:07.79,Default,,0,0,0,,Сонда сіз қолайсызсыз!
Dialogue: 0,1:06:09.50,1:06:10.04,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:10.54,1:06:11.71,Default,,0,0,0,,Кесу?
Dialogue: 0,1:06:12.46,1:06:13.71,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,1:06:13.80,1:06:14.51,Default,,0,0,0,,Иә
Dialogue: 0,1:06:19.93,1:06:20.47,Default,,0,0,0,,Уау
Dialogue: 0,1:06:21.76,1:06:22.56,Default,,0,0,0,,Мен... көзілдірік!
Dialogue: 0,1:06:23.35,1:06:26.06,Default,,0,0,0,,Көзіңе сүйенсең, әлі көгілдірсің.
Dialogue: 0,1:06:27.14,1:06:30.94,Default,,0,0,0,,Кішкентай бала осындай кішкентай ыдыспен аң аулай ала ма?
Dialogue: 0,1:06:31.02,1:06:33.98,Default,,0,0,0,,Біздің күмістің өткірлігі бірінші дәрежелі.
Dialogue: 0,1:06:35.53,1:06:36.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:06:39.24,1:06:40.99,Default,,0,0,0,,Эй, эй, не болып жатыр?
Dialogue: 0,1:06:41.08,1:06:44.45,Default,,0,0,0,,Бұл үш адамға керек пе?
Dialogue: 0,1:06:44.54,1:06:46.16,Default,,0,0,0,,Сіз кішкентай балаларды ауламақсыз, солай ма?
Dialogue: 0,1:06:46.83,1:06:48.25,Default,,0,0,0,,Ал, бәрін айтып таста
Dialogue: 0,1:06:48.92,1:06:50.33,Default,,0,0,0,,Марж мені тітіркендіреді.
Dialogue: 0,1:06:50.42,1:06:52.04,Default,,0,0,0,,Кеме біршама еңкейіп келеді.
Dialogue: 0,1:06:52.13,1:06:53.59,Default,,0,0,0,,Енді уақыт жоқ!
Dialogue: 0,1:06:53.67,1:06:55.46,Default,,0,0,0,,Өлдірудің қажеті жоқ!
Dialogue: 0,1:06:55.55,1:06:58.26,Default,,0,0,0,,Бетпе-бет күресуден басқа амал жоқ!
Dialogue: 0,1:07:00.34,1:07:02.43,Default,,0,0,0,,Тағы да? Мүмкін емес!
Dialogue: 0,1:07:02.51,1:07:05.68,Default,,0,0,0,,Өлім орағы кесе алмайтын ештеңе жоқ...
Dialogue: 0,1:07:06.23,1:07:07.98,Default,,0,0,0,,Бірақ неге оны қабылдай алмайсың?
Dialogue: 0,1:07:08.48,1:07:12.11,Default,,0,0,0,,Кез келген нәрсені кесетін өлім орағы... иә?
Dialogue: 0,1:07:12.86,1:07:16.28,Default,,0,0,0,,Сіз бұл сөз тіркесін біртүрлі деп ойламайсыз ба?
Dialogue: 0,1:07:16.36,1:07:17.45,Default,,0,0,0,,Әй?
Dialogue: 0,1:07:17.53,1:07:18.86,Default,,0,0,0,,Бір ғана
Dialogue: 0,1:07:20.16,1:07:21.49,Default,,0,0,0,,Үзілмейтін
Dialogue: 0,1:07:21.57,1:07:22.16,Default,,0,0,0,,Қарсы неге? Бүгін таңертең сен жақсылап көмектесіп жүрдің ғой, иә?
Dialogue: 0,1:07:22.24,1:07:23.03,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:07:28.83,1:07:29.33,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:07:33.67,1:07:34.42,Default,,0,0,0,,-Гах -Гах
Dialogue: 0,1:07:38.55,1:07:39.34,Default,,0,0,0,,Бұл...
Dialogue: 0,1:07:44.39,1:07:46.14,Default,,0,0,0,,Өлім орағы!
Dialogue: 0,1:07:47.27,1:07:48.85,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:07:48.93,1:07:50.85,Default,,0,0,0,,Өлім орақтары көп болған кезде
Dialogue: 0,1:07:51.60,1:07:54.94,Default,,0,0,0,,Кез келген нәрсені қия алады деген сөз өтірік.
Dialogue: 0,1:07:56.03,1:07:58.78,Default,,0,0,0,,Зейнетке шыққанда міндетті түрде жиналады ма?
Dialogue: 0,1:07:59.36,1:08:03.28,Default,,0,0,0,,Екеуміздің бірге болғанымыз сонша, оны жіберу қиын.
Dialogue: 0,1:08:03.78,1:08:05.79,Default,,0,0,0,,Маған оны шығару қиын болды.
Dialogue: 0,1:08:06.83,1:08:11.42,Default,,0,0,0,,Енді мен сендерді осы жолы аңдып көрейін.
Dialogue: 0,1:08:12.17,1:08:15.38,Default,,0,0,0,,Аңға шыққан бейшара қоян сияқты
Dialogue: 0,1:08:20.76,1:08:21.34,Default,,0,0,0,,-Гах -Уау!
Dialogue: 0,1:08:42.49,1:08:43.70,Default,,0,0,0,,Пәтуа жоқ
Dialogue: 0,1:08:43.78,1:08:47.54,Default,,0,0,0,,Үстелді кесу печенье сындырумен бірдей.
Dialogue: 0,1:08:48.41,1:08:51.50,Default,,0,0,0,,Мен жай ғана қолы кең орақтың төсіне кіргім келді.
Dialogue: 0,1:08:52.62,1:08:55.00,Default,,0,0,0,,Қызықты нәрсе туралы ойланыңыз
Dialogue: 0,1:08:55.58,1:08:56.59,Default,,0,0,0,,Ийда…
Dialogue: 0,1:08:57.75,1:08:58.46,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:59.55,1:09:00.84,Default,,0,0,0,,Бастауыш сынып оқушылары да
Dialogue: 0,1:09:01.38,1:09:06.64,Default,,0,0,0,,Сіз өзіңіздің арнайы табытыңызға кіре аласыз, Эрл.
Dialogue: 0,1:09:09.39,1:09:10.60,Default,,0,0,0,,Мен келе жатыр деп ойладым!
Dialogue: 0,1:09:14.23,1:09:15.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:31.16,1:09:32.62,Default,,0,0,0,,Аһ!
Dialogue: 0,1:09:34.75,1:09:36.63,Default,,0,0,0,,Әлсіз, нәзік болса да
Dialogue: 0,1:09:36.71,1:09:42.05,Default,,0,0,0,,Біреудің өмірін қию өте қиын, Батлер.
Dialogue: 0,1:09:42.55,1:09:45.34,Default,,0,0,0,,Сізді біраз уақыттан бері қызықтырғансыз, солай емес пе?
Dialogue: 0,1:09:45.43,1:09:50.64,Default,,0,0,0,,Зиянкестерге ұқсас адам неліктен күтуші болып жұмыс істейді?
Dialogue: 0,1:09:51.22,1:09:53.85,Default,,0,0,0,,Жазбаңызды көруге рұқсат етіңіз.
Dialogue: 0,1:09:55.94,1:09:57.65,Default,,0,0,0,,Себастьян!
Dialogue: 0,1:10:02.74,1:10:05.24,Default,,0,0,0,,А, мен қоңырау шалып жатырмын.
Dialogue: 0,1:10:05.99,1:10:10.74,Default,,0,0,0,,Қайғы мен ашуда, шатасуда және үмітсіздікте -
Dialogue: 0,1:10:10.83,1:10:13.33,Default,,0,0,0,,Құсу қарғыс сөздері
Dialogue: 0,1:10:15.08,1:10:17.33,Default,,0,0,0,,Маған қоңырау шалу
Dialogue: 0,1:10:19.92,1:10:21.96,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,1:10:23.26,1:10:27.30,Default,,0,0,0,,Менің атым Сиэл
Dialogue: 0,1:10:27.93,1:10:29.60,Default,,0,0,0,,Сиэл Фантомхайв
Dialogue: 0,1:10:30.60,1:10:33.06,Default,,0,0,0,,Phantomhive Earl отбасының мұрагері
Dialogue: 0,1:10:33.14,1:10:36.85,Default,,0,0,0,,Хехе, түсіндім, бұл жақсы.
Dialogue: 0,1:10:38.02,1:10:43.40,Default,,0,0,0,,Олай болса, мен де графқа қызмет етуге жарамды болуым керек.
Dialogue: 0,1:10:46.90,1:10:52.03,Default,,0,0,0,,Енді маған бұйрықтарыңызды беріңіз.
Dialogue: 0,1:10:52.53,1:10:54.66,Default,,0,0,0,,Кішкентай мырза
Dialogue: 0,1:10:57.71,1:11:00.33,Default,,0,0,0,,Үш нәрсені маған тіледі
Dialogue: 0,1:11:01.34,1:11:05.05,Default,,0,0,0,,Ол кек қайтармайынша, оған опасыздық жасама және оны қорға.
Dialogue: 0,1:11:05.55,1:11:08.34,Default,,0,0,0,,Оның әмірлеріне толық бағыну
Dialogue: 0,1:11:08.43,1:11:11.72,Default,,0,0,0,,Ешқашан өтірік айтпа
Dialogue: 0,1:11:12.72,1:11:16.18,Default,,0,0,0,,Графқа қызмет ететін күтуші ретінде қалай ақылды әрекет ету керек
Dialogue: 0,1:11:16.27,1:11:18.73,Default,,0,0,0,,Мұның бәрі ауыр жұмыс.
Dialogue: 0,1:11:18.81,1:11:22.27,Default,,0,0,0,,Бір жерде Phantomhive отбасын жоюға тырысқан біреу бар.
Dialogue: 0,1:11:23.48,1:11:25.53,Default,,0,0,0,,Алдыңғы шайқаста жеңілді.
Dialogue: 0,1:11:26.36,1:11:27.49,Default,,0,0,0,,Басқаша айтқанда, бұл сенің махаббатыңның күші
Dialogue: 0,1:11:28.53,1:11:30.41,Default,,0,0,0,,Мен ешқашан жеңілмеймін
Dialogue: 0,1:11:30.91,1:11:35.54,Default,,0,0,0,,Сиэл Фантомхайв ретінде, Phantomhive отбасының басшысы
Dialogue: 0,1:11:35.62,1:11:36.87,Default,,0,0,0,,Ол сонда—сол жақта~
Dialogue: 0,1:11:37.75,1:11:38.62,Default,,0,0,0,,Хехе
Dialogue: 0,1:11:39.33,1:11:40.17,Default,,0,0,0,,Хмм…
Dialogue: 0,1:11:40.25,1:11:44.25,Default,,0,0,0,,Жоқ... өтірік айтпа десең де.
Dialogue: 0,1:11:44.34,1:11:46.71,Default,,0,0,0,,Сен сондай өтірікшісің.
Dialogue: 0,1:11:47.92,1:11:49.97,Default,,0,0,0,,Қандай қиын
Dialogue: 0,1:11:50.47,1:11:51.76,Default,,0,0,0,,Бірақ тіпті
Dialogue: 0,1:11:51.84,1:11:55.47,Default,,0,0,0,,Адам баласының өмірін аяқтау үшін сонша уақыт қажет болды делік.
Dialogue: 0,1:11:55.56,1:11:58.10,Default,,0,0,0,,Маған көзді ашып жұмғанша
Dialogue: 0,1:11:58.18,1:12:03.31,Default,,0,0,0,,Біраз уақыт уақытты өлтіріп, қарын тойдырсам, жақсы.
Dialogue: 0,1:12:04.44,1:12:06.11,Default,,0,0,0,,Олай болса, ұстаз.
Dialogue: 0,1:12:06.19,1:12:07.40,Default,,0,0,0,,Үйге қайтайық.
Dialogue: 0,1:12:09.19,1:12:10.36,Default,,0,0,0,,Мен орналасқан жерді білмеймін
Dialogue: 0,1:12:10.45,1:12:11.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:12.49,1:12:15.20,Default,,0,0,0,,Лондондағы Корольдік ауруханада менің туысым бар.
Dialogue: 0,1:12:15.28,1:12:16.70,Default,,0,0,0,,Алдымен орналасқан жер туралы сұраңыз.
Dialogue: 0,1:12:16.79,1:12:18.83,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,1:12:20.33,1:12:21.58,Default,,0,0,0,,Мынау
Dialogue: 0,1:12:22.08,1:12:24.92,Default,,0,0,0,,Бұл қораптағы ақымақ бала.
Dialogue: 0,1:12:25.67,1:12:26.42,Default,,0,0,0,,Тоқта, шайтан
Dialogue: 0,1:12:27.25,1:12:28.67,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,1:12:28.76,1:12:30.97,Default,,0,0,0,,Қожаның қалауы бойынша
Dialogue: 0,1:12:31.63,1:12:32.59,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,1:12:35.14,1:12:36.35,Default,,0,0,0,,Себастьян
Dialogue: 0,1:12:37.26,1:12:39.89,Default,,0,0,0,,Бүгіннен бастап сіз Себастьянсыз.
Dialogue: 0,1:12:40.48,1:12:42.06,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,1:12:42.14,1:12:45.27,Default,,0,0,0,,Енді мені Себастьян деп атаңыз.
Dialogue: 0,1:12:46.11,1:12:48.15,Default,,0,0,0,,Бұл алдыңғы диаконның есімі ме?
Dialogue: 0,1:12:48.23,1:12:50.28,Default,,0,0,0,,Жоқ, бұл иттің аты.
Dialogue: 0,1:12:51.28,1:12:52.78,Default,,0,0,0,,Алдыңғы мәлімдеменің күшін жою
Dialogue: 0,1:12:52.86,1:12:57.37,Default,,0,0,0,,Мен өте тентек балаға жұмыс істедім.
Dialogue: 0,1:13:02.83,1:13:05.79,Default,,0,0,0,,Бұл... қорқынышты.
Dialogue: 0,1:13:06.46,1:13:07.59,Default,,0,0,0,,Бала?
Dialogue: 0,1:13:19.39,1:13:22.48,Default,,0,0,0,,Әке, ана…
Dialogue: 0,1:13:24.94,1:13:27.19,Default,,0,0,0,,Бұл бірінші және соңғы рет болды
Dialogue: 0,1:13:27.69,1:13:30.82,Default,,0,0,0,,Мен оның ата-анасын осылай атағанын естідім.
Dialogue: 0,1:13:34.40,1:13:36.87,Default,,0,0,0,,Бала, күн батып барады.
Dialogue: 0,1:13:37.37,1:13:39.54,Default,,0,0,0,,Түнгі жел денсаулыққа зиян тигізеді.
Dialogue: 0,1:13:39.62,1:13:42.79,Default,,0,0,0,,Жақын жерде паб пен қонақ үй бар.
Dialogue: 0,1:13:42.87,1:13:43.71,Default,,0,0,0,,Бүгін бар
Dialogue: 0,1:13:43.79,1:13:46.29,Default,,0,0,0,,Жоқ, мұның қажеті жоқ.
Dialogue: 0,1:13:50.25,1:13:51.30,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,1:13:51.80,1:13:55.47,Default,,0,0,0,,Сіз уәде бердіңіз, солай ма? мен өтірік айтпаймын
Dialogue: 0,1:13:57.89,1:14:00.76,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,1:14:00.85,1:14:02.72,Default,,0,0,0,,Графтың қамқоршысы
Dialogue: 0,1:14:02.81,1:14:05.06,Default,,0,0,0,,Осыншама қолыңнан келмесе, не істейсің?
Dialogue: 0,1:14:09.82,1:14:13.15,Default,,0,0,0,,Енді бүгіннен бастап бұл сенің сарайың.
Dialogue: 0,1:14:17.87,1:14:21.33,Default,,0,0,0,,Қош келдіңіз, ұстаз.
Dialogue: 0,1:14:22.58,1:14:23.37,Default,,0,0,0,,Қызу екен!
Dialogue: 0,1:14:23.45,1:14:25.91,Default,,0,0,0,,Сізге кенеттен ыстық су құйып алған адам бар ма?
Dialogue: 0,1:14:26.00,1:14:26.71,Default,,0,0,0,,Температураны қараңыз!
Dialogue: 0,1:14:26.79,1:14:30.00,Default,,0,0,0,,Кешіріңіз, келесі жолы мұқият боламын.
Dialogue: 0,1:14:30.09,1:14:32.25,Default,,0,0,0,,Енді кешіріңізші.
Dialogue: 0,1:14:32.34,1:14:35.38,Default,,0,0,0,,Уф, ауырады, ауырады, жетеді, маған тиіспе!
Dialogue: 0,1:14:35.47,1:14:36.13,Default,,0,0,0,,Ол қазірдің өзінде көтеріліп жатыр!
Dialogue: 0,1:14:36.22,1:14:38.55,Default,,0,0,0,,Мынадай лас денемен не айтып тұрсың?
Dialogue: 0,1:14:38.64,1:14:41.05,Default,,0,0,0,,Егер жара іріңдеп, сіз өлсеңіз...
Dialogue: 0,1:14:41.14,1:14:42.06,Default,,0,0,0,,Шығу!
Dialogue: 0,1:14:44.64,1:14:46.23,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,1:14:48.19,1:14:49.27,Default,,0,0,0,,Әлгі қарғыс атқыр бала
Dialogue: 0,1:14:49.35,1:14:49.86,Default,,0,0,0,,(шу)
Dialogue: 0,1:14:52.73,1:14:53.36,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,1:14:53.44,1:14:56.20,Default,,0,0,0,,Орамал алайын деп жатып, тайып кеттім.
Dialogue: 0,1:14:56.95,1:14:59.45,Default,,0,0,0,,Бүгін басынан өткерген барлық нәрселерден шаршағаныңызға сенімдімін.
Dialogue: 0,1:14:59.53,1:15:01.28,Default,,0,0,0,,Мен сенің денеңді жуамын.
Dialogue: 0,1:15:01.37,1:15:02.20,Default,,0,0,0,,Мен мұны жақсы деп айтамын!
Dialogue: 0,1:15:03.29,1:15:04.20,Default,,0,0,0,,Уф!
Dialogue: 0,1:15:04.29,1:15:06.58,Default,,0,0,0,,Қыңыр болма.
Dialogue: 0,1:15:06.66,1:15:08.50,Default,,0,0,0,,Адамдар, әлсіз жануар,
Dialogue: 0,1:15:08.58,1:15:11.92,Default,,0,0,0,,Кішкентай жара арқылы енген бактериялар сізді оңай өлтіруі мүмкін.
Dialogue: 0,1:15:12.00,1:15:15.92,Default,,0,0,0,,Өзін-өзі күтуге мүмкіндігі жоқ балаларға жол бермеңіз
Dialogue: 0,1:15:16.01,1:15:16.92,Default,,0,0,0,,Хун
Dialogue: 0,1:15:20.89,1:15:21.89,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,1:15:22.47,1:15:25.72,Default,,0,0,0,,Адамдар қандай жағдайда да аштыққа бейім.
Dialogue: 0,1:15:26.43,1:15:27.64,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,1:15:29.65,1:15:30.73,Default,,0,0,0,,Енді кешіріңіз.
Dialogue: 0,1:15:35.15,1:15:35.86,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:15:35.94,1:15:38.65,Default,,0,0,0,,Қалағаныңызша ләззат алыңыз.
Dialogue: 0,1:15:39.82,1:15:42.74,Default,,0,0,0,,Себастьян, бұдан былай мұндай нәрселерді кездейсоқ істеме.
Dialogue: 0,1:15:43.66,1:15:44.53,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:15:44.62,1:15:46.87,Default,,0,0,0,,Егер сізді басқа біреу көрсе, сіз күдіктенесіз
Dialogue: 0,1:15:46.95,1:15:50.71,Default,,0,0,0,,Сонымен, біз адамдар сияқты қадамдарды орындауымыз керек пе?
Dialogue: 0,1:15:50.79,1:15:51.71,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,1:15:51.79,1:15:54.96,Default,,0,0,0,,Сен менің қамқоршымсың, солай ма? мені тыңда
Dialogue: 0,1:15:55.55,1:15:57.42,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,1:16:00.30,1:16:01.13,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,1:16:01.22,1:16:03.05,Default,,0,0,0,,Әй, саған ұнамады ма?
Dialogue: 0,1:16:03.93,1:16:06.60,Default,,0,0,0,,А... майлы, ащы, тұзды...
Dialogue: 0,1:16:06.68,1:16:10.14,Default,,0,0,0,,Ах! Ондай жерде көп болған балаға,
Dialogue: 0,1:16:10.23,1:16:12.60,Default,,0,0,0,,Мәзір тым ауыр болды.
Dialogue: 0,1:16:12.69,1:16:13.56,Default,,0,0,0,,Енді тіпті рисотто...
Dialogue: 0,1:16:13.65,1:16:15.02,Default,,0,0,0,,Жетеді! ұйықта!
Dialogue: 0,1:16:21.36,1:16:22.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:16:23.03,1:16:24.49,Default,,0,0,0,,Не?
Dialogue: 0,1:16:25.37,1:16:27.87,Default,,0,0,0,,Мен саған ыстық сүт әкелдім.
Dialogue: 0,1:16:27.95,1:16:30.12,Default,,0,0,0,,Мен аз болса да бірдеңе алғым келеді.
Dialogue: 0,1:16:30.91,1:16:31.87,Default,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,1:16:31.96,1:16:33.33,Default,,0,0,0,,Бұл бәрібір жаман емес пе?
Dialogue: 0,1:16:34.04,1:16:35.71,Default,,0,0,0,,Тек сүтті қыздыру арқылы
Dialogue: 0,1:16:35.79,1:16:37.59,Default,,0,0,0,,Дәмдеуіштер жоқ
Dialogue: 0,1:16:37.67,1:16:40.67,Default,,0,0,0,,Дәмді ме, жоқ па, айта алмаймын.
Dialogue: 0,1:16:40.76,1:16:42.22,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,1:16:44.55,1:16:46.10,Default,,0,0,0,,Бал ше?
Dialogue: 0,1:16:46.18,1:16:48.14,Default,,0,0,0,,Қалағаныңызша беріңізші.
Dialogue: 0,1:16:48.22,1:16:52.31,Default,,0,0,0,,Атам тістерім көгеріп кетеді, төсекке жатпа деп ұрысты.
Dialogue: 0,1:16:53.52,1:16:56.52,Default,,0,0,0,,Ал, ертеңнен бастап мен де солай істеймін.
Dialogue: 0,1:17:10.08,1:17:13.37,Default,,0,0,0,,Себастьянның ыстық сүті дәмді болды
Dialogue: 0,1:17:15.38,1:17:17.21,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,1:17:17.29,1:17:18.42,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,1:17:18.92,1:17:21.55,Default,,0,0,0,,Ертеңгі таңғы ас бүгінгі күн сияқты нашар болса ше?
Dialogue: 0,1:17:21.63,1:17:22.55,Default,,0,0,0,,Мен сені кешірмеймін.
Dialogue: 0,1:17:23.26,1:17:27.72,Default,,0,0,0,,Мен әр тамақ үшін ыстық сүтке ие болған күшік сияқты өмір сүргім келмейді.
Dialogue: 0,1:17:29.60,1:17:32.06,Default,,0,0,0,,Ақырында бүгінгі таңғы ас та жаман болды.
Dialogue: 0,1:17:32.14,1:17:34.35,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:17:34.44,1:17:36.94,Default,,0,0,0,,Менің дәм сезуім адамдікінен өзгеше.
Dialogue: 0,1:17:37.02,1:17:40.36,Default,,0,0,0,,Қалай болғанда да, бүгіннен бастап көп нәрсе істеу керек.
Dialogue: 0,1:17:40.44,1:17:43.53,Default,,0,0,0,,Бұл үй туралы мен білмейтін көп нәрсе бар.
Dialogue: 0,1:17:43.61,1:17:44.91,Default,,0,0,0,,Бірақ бұл бәрі емес.
Dialogue: 0,1:17:45.57,1:17:49.95,Default,,0,0,0,,Сіз отағасы ретінде үлкендермен бірдей білім мен тәрбие алуыңыз керек.
Dialogue: 0,1:17:50.04,1:17:53.71,Default,,0,0,0,,Тәкаппар болсам да, ұстазың боламын.
Dialogue: 0,1:17:53.79,1:17:55.25,Default,,0,0,0,,Сіз?
Dialogue: 0,1:17:56.25,1:17:58.09,Default,,0,0,0,,Бос нәрсеге ұзақ өмір сүрудің қажеті жоқ.
Dialogue: 0,1:17:58.17,1:18:00.05,Default,,0,0,0,,Қаласаңыз, Спартада.
Dialogue: 0,1:18:00.13,1:18:01.96,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,1:18:02.05,1:18:03.72,Default,,0,0,0,,Граф пен Батлер
Dialogue: 0,1:18:03.80,1:18:06.51,Default,,0,0,0,,Сен де, мен де әлі жалғанбыз.
Dialogue: 0,1:18:06.59,1:18:09.43,Default,,0,0,0,,Сіз басқаларға қарағанда тезірек шындыққа айналуыңыз керек.
Dialogue: 0,1:18:11.93,1:18:13.56,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,1:18:16.65,1:18:17.98,Default,,0,0,0,,Тағы бір қате аударма
Dialogue: 0,1:18:18.48,1:18:19.98,Default,,0,0,0,,Мен кеше де дәл осындай қателік жасадым.
Dialogue: 0,1:18:20.07,1:18:21.73,Default,,0,0,0,,Сіз әлі ұмыттыңыз ба?
Dialogue: 0,1:18:22.73,1:18:24.28,Default,,0,0,0,,Иә, қолыңды берші.
Dialogue: 0,1:18:24.90,1:18:25.82,Default,,0,0,0,,Уф
Dialogue: 0,1:18:25.90,1:18:27.36,Default,,0,0,0,,Қайталап көріңіз
Dialogue: 0,1:18:30.24,1:18:33.50,Default,,0,0,0,,Бүгінгі шай - Дарджилинг.
Dialogue: 0,1:18:33.58,1:18:35.58,Default,,0,0,0,,Себастьян, маған қолыңды бер.
Dialogue: 0,1:18:37.79,1:18:41.42,Default,,0,0,0,,Бұл қара шай емес, шай түстес ыстық су.
Dialogue: 0,1:18:41.50,1:18:42.30,Default,,0,0,0,,Қайталап көріңіз!
Dialogue: 0,1:18:43.00,1:18:45.13,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:18:45.22,1:18:46.88,Default,,0,0,0,,Мен өзімді әлсіз сезінемін
Dialogue: 0,1:18:46.97,1:18:48.59,Default,,0,0,0,,Қолтық тым қатты
Dialogue: 0,1:18:49.30,1:18:53.10,Default,,0,0,0,,Ондайда ат үстінде аң аулау тек қана арман.
Dialogue: 0,1:18:54.72,1:18:56.52,Default,,0,0,0,,Шанышқы бұлтты
Dialogue: 0,1:18:56.60,1:18:59.81,Default,,0,0,0,,Күйеуіңізді лас күміс ыдыстармен тамақтандырасыз ба?
Dialogue: 0,1:19:00.44,1:19:00.98,Default,,0,0,0,,Қайталап көріңіз!
Dialogue: 0,1:19:02.69,1:19:04.03,Default,,0,0,0,,Аңдармен қарым-қатынас жасағанда
Dialogue: 0,1:19:04.11,1:19:05.61,Default,,0,0,0,,Қорықсаң, ұтыласың.
Dialogue: 0,1:19:06.11,1:19:08.28,Default,,0,0,0,,Енді алға қарап, әрекетті қайталаңыз.
Dialogue: 0,1:19:08.86,1:19:10.45,Default,,0,0,0,,Уау!
Dialogue: 0,1:19:11.28,1:19:15.33,Default,,0,0,0,,(Ерлердің айқайы)
Dialogue: 0,1:19:16.71,1:19:18.62,Default,,0,0,0,,Бұл тым қатты, Себастьян!
Dialogue: 0,1:19:19.79,1:19:21.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:19:21.21,1:19:23.84,Default,,0,0,0,,Қауіптілер көп болды, сондықтан біраз уақыт кетті.
Dialogue: 0,1:19:23.92,1:19:28.05,Default,,0,0,0,,Келесі жолы ұйқымды бұзсаң, мен сені босқа жібермеймін!
Dialogue: 0,1:19:30.76,1:19:32.26,Default,,0,0,0,,Бірақ ол
Dialogue: 0,1:19:32.35,1:19:36.22,Default,,0,0,0,,Бұл дүрбелең болмаса да, мен әр түндегідей оянамын.
Dialogue: 0,1:19:36.31,1:19:38.31,Default,,0,0,0,,(Сиелдің айқайы)
Dialogue: 0,1:19:41.02,1:19:42.56,Default,,0,0,0,,Балам, жақсысың ба?
Dialogue: 0,1:19:43.94,1:19:44.90,Default,,0,0,0,,Кім?
Dialogue: 0,1:19:47.40,1:19:48.99,Default,,0,0,0,,Бұл Себастьян.
Dialogue: 0,1:19:49.07,1:19:50.36,Default,,0,0,0,,Мен сенің қамқоршыңмын.
Dialogue: 0,1:19:51.20,1:19:52.28,Default,,0,0,0,,Себастьян…
Dialogue: 0,1:19:53.24,1:19:54.58,Default,,0,0,0,,Тағы бір жаман арман?
Dialogue: 0,1:19:54.66,1:19:57.58,Default,,0,0,0,,Мұнда бәрі өледі.
Dialogue: 0,1:19:58.37,1:19:59.54,Default,,0,0,0,,Маған қарап
Dialogue: 0,1:19:59.62,1:20:02.38,Default,,0,0,0,,Бұл сарайда тек сен екеуміз.
Dialogue: 0,1:20:03.17,1:20:04.84,Default,,0,0,0,,Басқа ешкім жоқ.
Dialogue: 0,1:20:04.92,1:20:06.59,Default,,0,0,0,,Бүгін ештеңе жоқ па?
Dialogue: 0,1:20:07.09,1:20:09.05,Default,,0,0,0,,Иә, түн тыныш.
Dialogue: 0,1:20:09.13,1:20:10.51,Default,,0,0,0,,Енді жат.
Dialogue: 0,1:20:10.59,1:20:11.18,Default,,0,0,0,,Егер бұл Бірінші нөмірлі Батырға жақындауға көмектессе, мен бәрін жасауға дайынмын
Dialogue: 0,1:20:12.09,1:20:13.72,Default,,0,0,0,,Қойшы, біз дәл дүкеннің алдында тұрмыз.
Dialogue: 0,1:20:14.22,1:20:17.22,Default,,0,0,0,,Маған тиіспе
Dialogue: 0,1:20:18.27,1:20:21.60,Default,,0,0,0,,Сонымен мен төмен түсемін, бірақ бірдеңе болып қалса.
Dialogue: 0,1:20:23.02,1:20:23.98,Default,,0,0,0,,Түс…
Dialogue: 0,1:20:25.36,1:20:26.86,Default,,0,0,0,,Онда
Dialogue: 0,1:20:27.90,1:20:29.07,Default,,0,0,0,,Мен ұйықтағанша
Dialogue: 0,1:20:31.91,1:20:34.74,Default,,0,0,0,,Менің Ием Иса
Dialogue: 0,1:20:35.37,1:20:36.20,Default,,0,0,0,,Өте ұзақ уақыттан бері көрмеппін.
Dialogue: 0,1:20:42.04,1:20:42.79,Default,,0,0,0,,Керемет!
Dialogue: 0,1:20:42.87,1:20:44.42,Default,,0,0,0,,Толық бағалар
Dialogue: 0,1:20:50.30,1:20:51.84,Default,,0,0,0,,Өте орынды.
Dialogue: 0,1:20:55.80,1:20:57.01,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,1:21:02.73,1:21:06.57,Default,,0,0,0,,Қонақтар негізгі кіреберіс арқылы кіруі керек.
Dialogue: 0,1:21:07.23,1:21:11.15,Default,,0,0,0,,Бұл да бала күйеуімнің ояу кезінде.
Dialogue: 0,1:21:21.58,1:21:22.58,Default,,0,0,0,,Бұл...
Dialogue: 0,1:21:39.89,1:21:42.48,Default,,0,0,0,,Қайтадан қош келдіңіз, граф Фантомхив
Dialogue: 0,1:21:43.06,1:21:45.73,Default,,0,0,0,,Біз сізді қайта қарсы аламыз.
Dialogue: 0,1:21:45.81,1:21:50.15,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:21:50.98,1:21:53.57,Default,,0,0,0,,Мен жақынырақ қарауым керек еді.
Dialogue: 0,1:21:54.07,1:21:57.82,Default,,0,0,0,,Сіз Сиелдің отбасы сияқтысыз.
Dialogue: 0,1:21:57.91,1:22:00.24,Default,,0,0,0,,Отбасы деп айту менмендік.
Dialogue: 0,1:22:01.41,1:22:05.96,Default,,0,0,0,,Мен жай ғана күзетшімін.
Dialogue: 0,1:22:08.75,1:22:11.80,Default,,0,0,0,,Сіз енді ресми түрде графсыз.
Dialogue: 0,1:22:11.88,1:22:17.39,Default,,0,0,0,,Мәртебең де, байлығың да, сұлу жарың да сенікі.
Dialogue: 0,1:22:18.43,1:22:22.85,Default,,0,0,0,,Сіз қалай ойлайсыз? Кек алу сияқты ақымақ істерді доғар.
Dialogue: 0,1:22:22.93,1:22:25.35,Default,,0,0,0,,Осылай бақытты өмір сүруді жалғастыру нені білдіреді?
Dialogue: 0,1:22:26.56,1:22:28.02,Default,,0,0,0,,Бұл да жаман емес.
Dialogue: 0,1:22:32.48,1:22:33.36,Default,,0,0,0,,Бірақ!
Dialogue: 0,1:22:33.44,1:22:37.78,Default,,0,0,0,,Мен мұнда бақыт іздеп қайтып келген жоқпын.
Dialogue: 0,1:22:37.86,1:22:40.62,Default,,0,0,0,,Мен күресуге қайта оралдым
Dialogue: 0,1:22:41.12,1:22:44.16,Default,,0,0,0,,Сиэл Фантомхайв есімін алып шыққаннан кейін,
Dialogue: 0,1:22:45.08,1:22:47.00,Default,,0,0,0,,Бізде алға ұмтылудан басқа амал жоқ.
Dialogue: 0,1:22:47.71,1:22:51.80,Default,,0,0,0,,Жаман атыммен, Міндетті түрде кек аламын!
Dialogue: 0,1:22:53.71,1:22:54.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:55.34,1:22:57.80,Default,,0,0,0,,Еш ойланбастан арқаңызды жарыққа бұрыңыз
Dialogue: 0,1:22:58.30,1:23:01.72,Default,,0,0,0,,Асыл қарқынмен шыңырауға алға ұмтылған фигура.
Dialogue: 0,1:23:02.22,1:23:05.56,Default,,0,0,0,,Қандай әдемі және ақымақ
Dialogue: 0,1:23:06.81,1:23:08.40,Default,,0,0,0,,Бұл бұйрық, Себастьян.
Dialogue: 0,1:23:08.90,1:23:11.56,Default,,0,0,0,,Сен менің қылышым, қалқаным боласың.
Dialogue: 0,1:23:12.98,1:23:14.78,Default,,0,0,0,,Маған жеңіс сыйла!
Dialogue: 0,1:23:19.66,1:23:22.24,Default,,0,0,0,,Менің Ием Иса
Dialogue: 0,1:23:25.16,1:23:27.71,Default,,0,0,0,,Мен саған міндетті түрде жеңіс тәжін беремін.
Dialogue: 0,1:23:29.25,1:23:31.71,Default,,0,0,0,,Үмітсіздікпен әшекейленген тәж кигенде
Dialogue: 0,1:23:33.09,1:23:34.21,Default,,0,0,0,,Сенің жаның сөзсіз
Dialogue: 0,1:23:35.88,1:23:38.51,Default,,0,0,0,,Тамшылайтындай дәмді болуы керек.
Dialogue: 0,1:23:40.59,1:23:41.59,Default,,0,0,0,,Себастьян!
Dialogue: 0,1:23:42.93,1:23:44.06,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:50.90,1:23:53.94,Default,,0,0,0,,Мен сен графты қорғайсың деп ойладым.
Dialogue: 0,1:23:54.73,1:23:56.74,Default,,0,0,0,,Батлер күткендей.
Dialogue: 0,1:23:57.78,1:23:58.78,Default,,0,0,0,,Уф...
Dialogue: 0,1:24:00.20,1:24:00.74,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:05.08,1:24:06.54,Default,,0,0,0,,Себастьян…
Dialogue: 0,1:24:06.62,1:24:08.46,Default,,0,0,0,,Сәлем Себастьян!
Dialogue: 0,1:24:08.54,1:24:09.75,Default,,0,0,0,,-Себас... -Уф
Dialogue: 0,1:24:10.37,1:24:11.88,Default,,0,0,0,,Шулы.
Dialogue: 0,1:24:11.96,1:24:13.46,Default,,0,0,0,,Мен сізді тыңдаймын.
Dialogue: 0,1:24:17.30,1:24:21.38,Default,,0,0,0,,Сіздің жазбаңыз өте қызықты болды.
Dialogue: 0,1:24:21.47,1:24:25.47,Default,,0,0,0,,Бірақ сіз графты тек бақытсыз етіп жатқан сияқтысыз.
Dialogue: 0,1:24:25.56,1:24:27.97,Default,,0,0,0,,Сондықтан мен жоғалып кетемін деп ойлаймын.
Dialogue: 0,1:24:28.06,1:24:28.93,Default,,0,0,0,,Ха…
Dialogue: 0,1:24:30.52,1:24:31.39,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:24:33.69,1:24:34.69,Default,,0,0,0,,Уф
Dialogue: 0,1:24:34.77,1:24:36.57,Default,,0,0,0,,-Яббе! -Жоқ, әлдеқашан?
Dialogue: 0,1:24:36.65,1:24:37.82,Default,,0,0,0,,Ух... уау!
Dialogue: 0,1:24:37.90,1:24:39.07,Default,,0,0,0,,О, ау
Dialogue: 0,1:24:39.15,1:24:40.07,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:24:45.62,1:24:47.87,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:24:51.29,1:24:53.17,Default,,0,0,0,,Ух... уау!
Dialogue: 0,1:24:53.25,1:24:55.13,Default,,0,0,0,,-Уау! -Лян!
Dialogue: 0,1:24:57.38,1:24:59.17,Default,,0,0,0,,Лин Стокер
Dialogue: 0,1:24:59.26,1:25:02.72,Default,,0,0,0,,1854 жылы 24 тамызда дүниеге келген
Dialogue: 0,1:25:02.80,1:25:07.47,Default,,0,0,0,,1889 жылы 20 сәуірде құлау салдарынан қайтыс болды
Dialogue: 0,1:25:07.56,1:25:09.18,Default,,0,0,0,,Ескертулер Атап айтқанда
Dialogue: 0,1:25:09.27,1:25:12.94,Default,,0,0,0,,Себас-чан, көріп тұрғаныңыздай, менің уақытым жоқ.
Dialogue: 0,1:25:13.52,1:25:15.69,Default,,0,0,0,,Кешіріңіз, бірақ мен оны аламын.
Dialogue: 0,1:25:17.90,1:25:19.78,Default,,0,0,0,,Сіз сонда қарауыңыз керек!
Dialogue: 0,1:25:19.86,1:25:20.69,Default,,0,0,0,,Ал...
Dialogue: 0,1:25:22.28,1:25:24.45,Default,,0,0,0,,Сенпай, мұны саған қалдырамын!
Dialogue: 0,1:25:25.03,1:25:27.45,Default,,0,0,0,,Мен өте әлсізмін. Мен сені өлтіремін.
Dialogue: 0,1:25:28.66,1:25:31.29,Default,,0,0,0,,Енді, енді.
Dialogue: 0,1:25:32.21,1:25:35.58,Default,,0,0,0,,Ха... Мен адамдар менің қамқоршыма тіл тигізгенін қаламаймын.
Dialogue: 0,1:25:36.08,1:25:37.71,Default,,0,0,0,,Сіз соншалықты әлсізсіз бе?
Dialogue: 0,1:25:38.21,1:25:39.38,Default,,0,0,0,,Бұл күлкілі әзіл емес.
Dialogue: 0,1:25:40.00,1:25:41.05,Default,,0,0,0,,Дұрыс па? себастьян
Dialogue: 0,1:25:42.34,1:25:44.68,Default,,0,0,0,,Иә, мүлде.
Dialogue: 0,1:25:47.26,1:25:48.64,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,1:25:48.72,1:25:52.10,Default,,0,0,0,,Бұл әлсіздерді қорлау сияқты...
Dialogue: 0,1:25:52.77,1:25:53.56,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:55.65,1:25:56.94,Default,,0,0,0,,Эй... Уау!
Dialogue: 0,1:26:03.07,1:26:05.11,Default,,0,0,0,,Әлсіздерді қорлау дегеніміз не?
Dialogue: 0,1:26:07.49,1:26:08.41,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,1:26:24.17,1:26:26.63,Default,,0,0,0,,Сен, мен оны бір жерден көрдім деп ойладым.
Dialogue: 0,1:26:26.72,1:26:29.93,Default,,0,0,0,,Сіз Ред ханымның қамқоршысы болған өлім құдайысыз ба?
Dialogue: 0,1:26:30.01,1:26:32.64,Default,,0,0,0,,Сіз де адамдардың өмірін сүйретіп жатырсыз.
Dialogue: 0,1:26:32.72,1:26:34.98,Default,,0,0,0,,Шұбыратын еркектер танымал емес!
Dialogue: 0,1:26:38.81,1:26:42.03,Default,,0,0,0,,Балалар, сендерге уақыт келді емес пе?
Dialogue: 0,1:26:42.53,1:26:43.90,Default,,0,0,0,,Әдемі жігіттің алдында
Dialogue: 0,1:26:43.99,1:26:46.24,Default,,0,0,0,,Мен Золушка сияқты үйге бара алмаймын!
Dialogue: 0,1:26:50.41,1:26:51.12,Default,,0,0,0,,Уф...
Dialogue: 0,1:26:52.83,1:26:54.12,Default,,0,0,0,,-Роналд? -Ух...
Dialogue: 0,1:26:54.20,1:26:57.08,Default,,0,0,0,,Қазіргі жастар шынымен әлсіз.
Dialogue: 0,1:26:58.12,1:26:59.96,Default,,0,0,0,,Енді қалғаны...
Dialogue: 0,1:27:01.88,1:27:02.67,Default,,0,0,0,,Әй?
Dialogue: 0,1:27:02.75,1:27:04.01,Default,,0,0,0,,-Уау! -Бала!
Dialogue: 0,1:27:12.72,1:27:14.06,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,1:27:15.48,1:27:18.85,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:27:21.94,1:27:23.23,Default,,0,0,0,,Қараңдар... қараңдар!
Dialogue: 0,1:27:24.48,1:27:25.61,Default,,0,0,0,,Кеме!
Dialogue: 0,1:27:33.53,1:27:35.50,Default,,0,0,0,,Міне, қоштасатын кез келді.
Dialogue: 0,1:27:36.08,1:27:37.75,Default,,0,0,0,,Бұл өте қызықты болды.
Dialogue: 0,1:27:41.88,1:27:42.79,Default,,0,0,0,,Уф...
Dialogue: 0,1:27:50.05,1:27:50.55,Default,,0,0,0,,Иә
Dialogue: 0,1:27:53.60,1:27:57.60,Default,,0,0,0,,Санақ, мен мұны біраз уақытқа қалдырамын.
Dialogue: 0,1:27:57.68,1:27:59.19,Default,,0,0,0,,Оны сақтаңыз
Dialogue: 0,1:27:59.89,1:28:02.40,Default,,0,0,0,,Бұл кішкентай баланың қазынасы.
Dialogue: 0,1:28:02.48,1:28:04.02,Default,,0,0,0,,Күте тұрыңыз! іскер
Dialogue: 0,1:28:04.82,1:28:06.69,Default,,0,0,0,,Кездескенше, Эрл.
Dialogue: 0,1:28:07.32,1:28:08.32,Default,,0,0,0,,Тағы кездескенше
Dialogue: 0,1:28:14.24,1:28:14.78,Default,,0,0,0,,Кеме...
Dialogue: 0,1:28:17.08,1:28:18.91,Default,,0,0,0,,Уау!
Dialogue: 0,1:28:24.17,1:28:28.01,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:28:41.73,1:28:42.81,Default,,0,0,0,,Терең тыныс ал!
Dialogue: 0,1:28:43.48,1:28:44.56,Default,,0,0,0,,Иә? Не...
Dialogue: 0,1:28:44.65,1:28:46.02,Default,,0,0,0,,Өйткені жағдай – бұл жағдай
Dialogue: 0,1:28:46.11,1:28:47.23,Default,,0,0,0,,Мырза Президент, қазіргі L, шатастырмау үшін,
Dialogue: 0,1:28:47.32,1:28:49.74,Default,,0,0,0,,О... Уау!
Dialogue: 0,1:29:03.54,1:29:08.55,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,1:29:10.21,1:29:11.59,Default,,0,0,0,,А... а...
Dialogue: 0,1:29:20.64,1:29:22.02,Default,,0,0,0,,(Ақ) Адамнан тыс қабілеттері бар данышпан қыз
Dialogue: 0,1:29:24.69,1:29:27.82,Default,,0,0,0,,Оны суға батып бара жатқан кемеден алуға біраз уақыт кетті.
Dialogue: 0,1:29:27.90,1:29:29.23,Default,,0,0,0,,Мынаны киіңіз
Dialogue: 0,1:29:29.32,1:29:32.70,Default,,0,0,0,,Ыстық шай бере алмағанымыз үшін кешірім сұраймыз.
Dialogue: 0,1:29:34.82,1:29:36.07,Default,,0,0,0,,Әлі де адамдар бар...
Dialogue: 0,1:29:39.62,1:29:42.33,Default,,0,0,0,,Бұл теңіз температурасында өмір сүру мүмкін емес.
Dialogue: 0,1:29:42.41,1:29:44.00,Default,,0,0,0,,А... артта!
Dialogue: 0,1:29:45.08,1:29:46.42,Default,,0,0,0,,Себастьян!
Dialogue: 0,1:29:47.54,1:29:49.55,Default,,0,0,0,,Олар суда қозғала ала ма?
Dialogue: 0,1:29:50.30,1:29:52.05,Default,,0,0,0,,Тыныс алудың қажеті жоқ
Dialogue: 0,1:29:52.13,1:29:54.26,Default,,0,0,0,,Бұл сіздің суға батпайтыныңызды білдіреді.
Dialogue: 0,1:29:54.84,1:29:55.64,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:01.35,1:30:02.14,Default,,0,0,0,,Бұл...
Dialogue: 0,1:30:03.02,1:30:04.35,Default,,0,0,0,,Гуаааааа!
Dialogue: 0,1:30:04.44,1:30:06.35,Default,,0,0,0,,Кел, Себастьян!
Dialogue: 0,1:30:11.19,1:30:13.61,Default,,0,0,0,,Қалай... нешеу бар?
Dialogue: 0,1:30:13.69,1:30:14.45,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:30:15.36,1:30:18.45,Default,,0,0,0,,Мүмкін олар адам денесі ыдырағанша жалғаса береді.
Dialogue: 0,1:30:18.53,1:30:20.58,Default,,0,0,0,,Тек жанға ұмтыл
Dialogue: 0,1:30:20.66,1:30:23.45,Default,,0,0,0,,Бұл жерде жалғыз тірі адам - Ботчан.
Dialogue: 0,1:30:24.00,1:30:25.42,Default,,0,0,0,,...
Dialogue: 0,1:30:28.25,1:30:30.38,Default,,0,0,0,,Сонда қашып құтыла алмайсың.
Dialogue: 0,1:30:30.88,1:30:33.42,Default,,0,0,0,,Егер біз қашсақ, Лиззи және басқалары нысанаға алынады.
Dialogue: 0,1:30:34.51,1:30:36.93,Default,,0,0,0,,Біз тірі қалғандарға қауіп төндіре алмаймыз.
Dialogue: 0,1:30:37.72,1:30:40.56,Default,,0,0,0,,Сіз бақыттысыз ба, әлде бақытсыз ба?
Dialogue: 0,1:30:40.64,1:30:44.48,Default,,0,0,0,,Сізге ең жақын жанға ғана көңіл бөлетін сияқтысыз.
Dialogue: 0,1:30:44.56,1:30:46.56,Default,,0,0,0,,Осы жерден тоқтаңыз
Dialogue: 0,1:30:46.64,1:30:47.65,Default,,0,0,0,,Сіз мұны істей аласыз ба? себастьян
Dialogue: 0,1:30:48.48,1:30:51.07,Default,,0,0,0,,Қызметшіден сұраудың қажеті жоқ.
Dialogue: 0,1:30:51.98,1:30:53.15,Default,,0,0,0,,Тапсырыстарыңызды беріңіздер.
Dialogue: 0,1:30:56.15,1:30:57.53,Default,,0,0,0,,Гуаааааааа!
Dialogue: 0,1:30:57.61,1:30:59.49,Default,,0,0,0,,Бұл бұйрық, Себастьян.
Dialogue: 0,1:30:59.57,1:31:01.12,Default,,0,0,0,,Тазалаңыз!
Dialogue: 0,1:31:01.20,1:31:03.41,Default,,0,0,0,,Менің Ием Иса
Dialogue: 0,1:31:04.79,1:31:05.71,Default,,0,0,0,,Ол аздап шайқалады.
Dialogue: 0,1:31:06.62,1:31:08.12,Default,,0,0,0,,Қайықты ұстаңыз!
Dialogue: 0,1:31:18.18,1:31:20.97,Default,,0,0,0,,Уф! Арх... хе!
Dialogue: 0,1:31:24.10,1:31:25.39,Default,,0,0,0,,Қызықты
Dialogue: 0,1:31:27.73,1:31:29.60,Default,,0,0,0,,Адамдар өлгеннен кейін де,
Dialogue: 0,1:31:30.10,1:31:34.69,Default,,0,0,0,,Сіз басқаларды төмен түсіріп, қалағаныңызды алуға тырысасыз.
Dialogue: 0,1:31:37.15,1:31:40.03,Default,,0,0,0,,Олар нағыз сараң тіршілік иелері.
Dialogue: 0,1:31:47.96,1:31:52.54,Default,,0,0,0,,(қорқынышты айқай)
Dialogue: 0,1:31:52.63,1:31:54.63,Default,,0,0,0,,Бұл не... дауыс?
Dialogue: 0,1:31:54.71,1:31:56.71,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:31:56.80,1:31:58.63,Default,,0,0,0,,Тірі қалғандар болуы мүмкін
Dialogue: 0,1:31:58.72,1:31:59.88,Default,,0,0,0,,Артқа бұрылайық!
Dialogue: 0,1:31:59.97,1:32:00.64,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:32:00.72,1:32:04.14,Default,,0,0,0,,Мына қараңғыда абайсызда жүру қауіпті.
Dialogue: 0,1:32:04.22,1:32:07.18,Default,,0,0,0,,Ал егер әлгі құбыжық әлі сонда болса ше?
Dialogue: 0,1:32:07.27,1:32:08.43,Default,,0,0,0,,Бұл қорқынышты~
Dialogue: 0,1:32:08.52,1:32:11.52,Default,,0,0,0,,(қыз жылап жатыр)
Dialogue: 0,1:32:13.36,1:32:14.65,Default,,0,0,0,,Күлімсіреу…
Dialogue: 0,1:32:44.39,1:32:45.14,Default,,0,0,0,,Гррр…
Dialogue: 0,1:32:46.72,1:32:47.47,Default,,0,0,0,,Себастьян!
Dialogue: 0,1:32:48.06,1:32:50.06,Default,,0,0,0,,Менен де күткендей
Dialogue: 0,1:32:50.14,1:32:52.48,Default,,0,0,0,,Өлім орақтың соққысына жауап берілді.
Dialogue: 0,1:32:56.82,1:33:00.19,Default,,0,0,0,,Жетекші Оның мақсаты қандай...
Dialogue: 0,1:33:00.28,1:33:02.61,Default,,0,0,0,,Мен түсінбеймін, бірақ
Dialogue: 0,1:33:03.11,1:33:06.24,Default,,0,0,0,,Діни қызметкерде шашқа арналған ыдыс болғанша.
Dialogue: 0,1:33:06.33,1:33:08.74,Default,,0,0,0,,Бір күні тағы кездесеміз.
Dialogue: 0,1:33:08.83,1:33:09.95,Default,,0,0,0,,Гаха…
Dialogue: 0,1:33:10.91,1:33:14.25,Default,,0,0,0,,Мен сені қайта көргім келмейді.
Dialogue: 0,1:33:14.33,1:33:14.83,Default,,0,0,0,,Қандай жағымсыз иіс! Тамағымның арты ұстап, ауырып барады.
Dialogue: 0,1:33:15.42,1:33:18.71,Default,,0,0,0,,Мен сені бірінші рет көріп тұрмын.
Dialogue: 0,1:33:19.88,1:33:23.34,Default,,0,0,0,,Осындай көріксіз көрініс үшін кешірім сұраймын.
Dialogue: 0,1:33:24.14,1:33:26.10,Default,,0,0,0,,Phantomhive жанұясы күзетші ретінде дисквалификацияланды.
Dialogue: 0,1:33:26.18,1:33:28.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:32.39,1:33:33.85,Default,,0,0,0,,Бұл құтқару кемесі.
Dialogue: 0,1:33:36.65,1:33:37.90,Default,,0,0,0,,Себастьян
Dialogue: 0,1:33:38.40,1:33:40.69,Default,,0,0,0,,Phantomhive отбасының қамаушысы
Dialogue: 0,1:33:40.78,1:33:43.65,Default,,0,0,0,,Мәңгі осылай қалсам, қиналып қалар едім.
Dialogue: 0,1:33:43.74,1:33:45.99,Default,,0,0,0,,Үйге қайтып келгенде, жақсылап демалыңыз.
Dialogue: 0,1:33:46.57,1:33:48.33,Default,,0,0,0,,Сен бүгін жақсы өнер көрсеттің
Dialogue: 0,1:33:49.70,1:33:50.95,Default,,0,0,0,,Бала...
Dialogue: 0,1:33:52.20,1:33:53.46,Default,,0,0,0,,Тоқтаңыз
Dialogue: 0,1:33:53.96,1:33:56.46,Default,,0,0,0,,Бұлай айтқаныңызға сене алар емеспін.
Dialogue: 0,1:33:57.29,1:34:01.21,Default,,0,0,0,,Осыдан кейінгі дауыл үшін кешірім сұраймын.
Dialogue: 0,1:34:08.01,1:34:10.01,Default,,0,0,0,,♪～
Dialogue: 0,1:38:03.66,1:38:05.67,Default,,0,0,0,,～♪
Dialogue: 0,1:38:13.34,1:38:14.09,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,1:38:15.51,1:38:19.26,Default,,0,0,0,,Тіпті жинауды дұрыс орындау мүмкін емес.
Dialogue: 0,1:38:19.85,1:38:23.56,Default,,0,0,0,,Карантин кезінде тым жалқау болуыңыз мүмкін бе?
Dialogue: 0,1:38:24.06,1:38:27.77,Default,,0,0,0,,Мен басқа бөлімде болсам да жұмылдырыламын. Мен сияқты болғаныңды қалаймын.
Dialogue: 0,1:38:28.77,1:38:30.98,Default,,0,0,0,,Бүгін де жұмысқа уақытында жете алмайсың.
Dialogue: 0,1:38:31.57,1:38:33.86,Default,,0,0,0,,Оян, Грелл Сатклиф!
Dialogue: 0,1:38:33.94,1:38:34.78,Default,,0,0,0,,Рональд Нокс!
Dialogue: 0,1:38:35.36,1:38:38.28,Default,,0,0,0,,А, міне, кеттік... Уилл!
Dialogue: 0,1:38:38.37,1:38:40.53,Default,,0,0,0,,Сен мені алып кетуге келдің!
Dialogue: 0,1:38:40.62,1:38:41.49,Default,,0,0,0,,Әй...
Dialogue: 0,1:38:42.83,1:38:44.79,Default,,0,0,0,,Бұл алып кету емес!
Dialogue: 0,1:38:44.87,1:38:48.79,Default,,0,0,0,,Мен тіпті өз ісін де істей алмайтын ақымақ диспетчермін.
Dialogue: 0,1:38:49.29,1:38:51.46,Default,,0,0,0,,Қалпына келтіру процесін дереу бастайық.
Dialogue: 0,1:38:51.55,1:38:52.05,Default,,0,0,0,,Бухаха
Dialogue: 0,1:38:52.76,1:38:56.30,Default,,0,0,0,,Адам құқығын елемейтін бұл көзқарас мына теңізден де суық!
Dialogue: 0,1:38:56.38,1:38:58.26,Default,,0,0,0,,Керісінше денем қызып барады!
Dialogue: 0,1:38:58.34,1:39:00.30,Default,,0,0,0,,Сенпай, сен жақсысың...
Dialogue: 0,1:39:00.39,1:39:03.18,Default,,0,0,0,,Сізді күтемін~!
Dialogue: 0,1:39:03.27,1:39:03.93,Default,,0,0,0,,Сәлем Уилл
Dialogue: 0,1:39:04.64,1:39:05.68,Default,,0,0,0,,Тыңдап тұрсың ба? Will
Dialogue: 0,1:39:05.77,1:39:07.90,Default,,0,0,0,,Ей, күт, мені де көтер.
Dialogue: 0,1:39:08.98,1:39:10.19,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:39:18.11,1:39:20.16,Default,,0,0,0,,Сиел~!
Dialogue: 0,1:39:21.45,1:39:23.08,Default,,0,0,0,,-Сиел~ -Ух... уау
Dialogue: 0,1:39:26.21,1:39:27.83,Default,,0,0,0,,Ittata...
Dialogue: 0,1:39:29.00,1:39:29.92,Default,,0,0,0,,Лиззи
Dialogue: 0,1:39:30.00,1:39:33.88,Default,,0,0,0,,Уау! Жақсы~
Dialogue: 0,1:39:33.96,1:39:35.51,Default,,0,0,0,,Ciel…
Dialogue: 0,1:39:36.97,1:39:38.18,Default,,0,0,0,,Сиел~!
Dialogue: 0,1:39:40.09,1:39:43.89,Default,,0,0,0,,(Элизабеттің айқайы)
Dialogue: 0,1:39:45.39,1:39:51.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory