Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.03,0:00:12.04,Default,,0,0,0,,《Мен кішкентай кезімнен Котори-тори суретті кітаптарды жақсы көретінмін》→
Dialogue: 0,0:00:12.04,0:00:18.05,Default,,0,0,0,,《Түрлі әлемді шарлап, Түрлі дүниелерді киіп →
Dialogue: 0,0:00:18.05,0:00:24.05,Default,,0,0,0,,Соңында түсі лайланып кетті...》→
Dialogue: 0,0:00:24.05,0:00:27.05,Default,,0,0,0,,《Өліп жатқан Которитори》→
Dialogue: 0,0:00:27.05,0:00:31.06,Default,,0,0,0,,《Өте қайғылы аяқталу》→
Dialogue: 0,0:00:31.06,0:00:34.06,Default,,0,0,0,,《Бірақ неге?→
Dialogue: 0,0:00:34.06,0:00:38.07,Default,,0,0,0,,Котори-тори сізді неге сонша қызықтырады? 》→
Dialogue: 0,0:00:38.07,0:00:40.07,Default,,0,0,0,,《Неге...》
Dialogue: 0,0:00:42.07,0:02:09.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:16.82,0:02:21.69,Default,,0,0,0,,Ха ха…. →
Dialogue: 0,0:02:23.24,0:02:25.24,Default,,0,0,0,,Мүмкін емес….
Dialogue: 0,0:02:27.25,0:02:31.25,Default,,0,0,0,,Өйткені, мен ол дүниеге қол тигізе алмаймын. →
Dialogue: 0,0:02:31.25,0:02:36.26,Default,,0,0,0,,Алтын араға қол тигізуге болмайды. →
Dialogue: 0,0:02:36.26,0:02:41.26,Default,,0,0,0,,Өйткені Голдсо сол баланың әлемінде қалып қояды.
Dialogue: 0,0:02:41.26,0:02:46.26,Default,,0,0,0,,Мен енді ештеңе істей алмаймын.
Dialogue: 0,0:02:49.27,0:02:51.27,Default,,0,0,0,,Мен жасап көремін.
Dialogue: 0,0:02:51.27,0:02:54.27,Default,,0,0,0,,Не? Сая-чанның қоңырауы бойынша →
Dialogue: 0,0:02:54.27,0:02:59.28,Default,,0,0,0,,Black Rock Shooter ішіндегі Мато әрекет етті, солай ма?
Dialogue: 0,0:02:59.28,0:03:01.28,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:03:01.28,0:03:04.28,Default,,0,0,0,,Жоқ! Егер сіз сол әлемге барсаңыз→
Dialogue: 0,0:03:04.28,0:03:10.29,Default,,0,0,0,,Біздің баламыз! бірақ….
Dialogue: 0,0:03:10.29,0:03:14.29,Default,,0,0,0,,Бармасам, Матоға көмектесе алмаймын.
Dialogue: 0,0:03:14.29,0:03:16.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:16.30,0:03:20.30,Default,,0,0,0,,Мато – жұмбақ бала.
Dialogue: 0,0:03:22.24,0:03:28.24,Default,,0,0,0,,Жек көру, қызғаныш, уайымдау. Мұндай сезімдер өте аз. →
Dialogue: 0,0:03:28.24,0:03:33.25,Default,,0,0,0,,Керісінше, мен уайымдардың өзін жек көремін.
Dialogue: 0,0:03:33.25,0:03:36.25,Default,,0,0,0,,Уайымдаңыз...
Dialogue: 0,0:03:36.25,0:03:39.25,Default,,0,0,0,,Уайымдап жүрген өзіңізді жоққа шығарыңыз. →
Dialogue: 0,0:03:39.25,0:03:42.26,Default,,0,0,0,,Қиындыққа тап болған адамға көмектесуге тырысыңыз. →
Dialogue: 0,0:03:42.26,0:03:47.26,Default,,0,0,0,,Бұл сезім Black Rock Shooter-ді жасайды.
Dialogue: 0,0:03:50.26,0:03:53.27,Default,,0,0,0,,Біреуді қиындықтан құтқару →
Dialogue: 0,0:03:53.27,0:03:56.27,Default,,0,0,0,,Біреудің сезімін өлтіру. →
Dialogue: 0,0:03:56.27,0:04:00.27,Default,,0,0,0,,Black Rock Shooter біздің баламызды міндетті түрде алады→
Dialogue: 0,0:04:00.27,0:04:02.28,Default,,0,0,0,,Жеңілді. →
Dialogue: 0,0:04:02.28,0:04:07.28,Default,,0,0,0,,Содан кейін сіз енді Матаға қоңырау шала алмайсыз.
Dialogue: 0,0:04:07.28,0:04:09.28,Default,,0,0,0,,Алғышарт сол бала жоғалады деген сияқты!
Dialogue: 0,0:04:09.28,0:04:13.29,Default,,0,0,0,,Сіз осылай айтасыз!
Dialogue: 0,0:04:13.29,0:04:15.29,Default,,0,0,0,,Ол жоғалып кетпейді. иә?
Dialogue: 0,0:04:15.29,0:04:19.23,Default,,0,0,0,,Мато да, ол бала да жоғалмайды.
Dialogue: 0,0:04:19.23,0:04:21.23,Default,,0,0,0,,Өшірмеңіз.
Dialogue: 0,0:04:21.23,0:04:25.23,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:04:27.23,0:04:30.24,Default,,0,0,0,,Саған көп рахмет, Сая-чан.
Dialogue: 0,0:04:30.24,0:04:35.24,Default,,0,0,0,,Бір сәт танысқаныма қуаныштымын.
Dialogue: 0,0:04:39.25,0:04:41.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:57.26,0:04:59.27,Default,,0,0,0,,≪Мато! →
Dialogue: 0,0:04:59.27,0:05:01.27,Default,,0,0,0,,Мато!
Dialogue: 0,0:05:03.27,0:05:06.27,Default,,0,0,0,,≪Біліңіз! Мато!
Dialogue: 0,0:05:09.28,0:05:12.28,Default,,0,0,0,,Хмм….
Dialogue: 0,0:05:12.28,0:05:14.28,Default,,0,0,0,,<<Оян! Мато! →
Dialogue: 0,0:05:14.28,0:05:16.28,Default,,0,0,0,,Мато!
Dialogue: 0,0:05:18.22,0:05:20.22,Default,,0,0,0,,Ю….
Dialogue: 0,0:05:20.22,0:05:23.22,Default,,0,0,0,,Бұл дауыс - Юу! ?
Dialogue: 0,0:05:23.22,0:05:43.24,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:43.24,0:06:03.26,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:03.26,0:06:08.27,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:08.27,0:06:12.27,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:12.27,0:06:15.27,Default,,0,0,0,,Сонда әлгі бала...
Dialogue: 0,0:06:15.27,0:06:19.27,Default,,0,0,0,,Тоқта! Оны ренжітсең мен сені кешірмеймін!
Dialogue: 0,0:06:23.22,0:06:26.29,Default,,0,0,0,,Енді бір-біріңді ренжітуді доғарыңдар!
Dialogue: 0,0:06:26.29,0:06:30.19,Default,,0,0,0,,Мен сенің төбелескеніңді қаламаймын!
Dialogue: 0,0:06:35.23,0:06:37.23,Default,,0,0,0,,≪Мато!
Dialogue: 0,0:06:39.23,0:06:45.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:45.24,0:06:50.24,Default,,0,0,0,,≪Мато Кешіріңіз! Кешіріңіз... бірақ бас тартпаңыз! →
Dialogue: 0,0:06:50.24,0:06:52.25,Default,,0,0,0,,Жоғалтпа! →
Dialogue: 0,0:06:52.25,0:06:56.25,Default,,0,0,0,,Мен ол жерден кеткім келеді!
Dialogue: 0,0:07:01.25,0:07:05.26,Default,,0,0,0,,Ол жерден кеткіңіз келе ме?
Dialogue: 0,0:07:05.26,0:07:07.26,Default,,0,0,0,,<<Дұрыс. →
Dialogue: 0,0:07:07.26,0:07:10.26,Default,,0,0,0,,Мен Black Rock Shooter ойынынан шықсам екен! →
Dialogue: 0,0:07:10.26,0:07:14.26,Default,,0,0,0,,Бұл бала мен емес деп айқайла!
Dialogue: 0,0:07:18.20,0:07:22.21,Default,,0,0,0,,Бұл бала мен емес пе?
Dialogue: 0,0:07:22.21,0:07:26.28,Default,,0,0,0,,≪Не болды? Мато!
Dialogue: 0,0:07:26.28,0:07:28.21,Default,,0,0,0,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,0:07:28.21,0:07:30.21,Default,,0,0,0,,≪Мато!
Dialogue: 0,0:07:33.22,0:07:37.22,Default,,0,0,0,,Black Rock Shooter мен емес...
Dialogue: 0,0:07:37.22,0:07:41.23,Default,,0,0,0,,Не? Әпкең ше?
Dialogue: 0,0:07:41.23,0:07:48.23,Default,,0,0,0,,Мен өте жалқаумын, дәлірек айтсам, мен заттарды оңай ұмытамын.
Dialogue: 0,0:07:48.23,0:07:50.24,Default,,0,0,0,,Гя гя Бұл өте шулы.
Dialogue: 0,0:07:50.24,0:07:54.24,Default,,0,0,0,,Бірақ ол менің әпкем→
Dialogue: 0,0:07:54.24,0:07:57.24,Default,,0,0,0,,Менің ойымша, ол жақсы жігіт.
Dialogue: 0,0:07:57.24,0:07:59.25,Default,,0,0,0,,Курои мырза?
Dialogue: 0,0:07:59.25,0:08:05.25,Default,,0,0,0,,Не айтсам екен, ол жақсы адам сияқты, бірақ әйтеуір бір төбе?
Dialogue: 0,0:08:05.25,0:08:08.25,Default,,0,0,0,,Бұл біршама жарық болса да→
Dialogue: 0,0:08:08.25,0:08:13.26,Default,,0,0,0,,Мен ол маған ашылмай тұрғандай сезінемін.
Dialogue: 0,0:08:13.26,0:08:17.26,Default,,0,0,0,,Иә, иә. Айтуға болатын өте әдемі нәрсе?
Dialogue: 0,0:08:19.20,0:08:25.20,Default,,0,0,0,,Мато жақсы бала. Әкем үнемі іссапарларда →
Dialogue: 0,0:08:25.20,0:08:29.21,Default,,0,0,0,,Мен сені жалғыз сезіндім деп ойлаймын.
Dialogue: 0,0:08:29.21,0:08:33.21,Default,,0,0,0,,Сіз ешқашан шағымданған жоқсыз.
Dialogue: 0,0:08:33.21,0:08:37.22,Default,,0,0,0,,Менің ойымша, бұл тым жетілген.
Dialogue: 0,0:08:37.22,0:08:41.22,Default,,0,0,0,,Мен ешқашан теріс сөз айтпаймын →
Dialogue: 0,0:08:41.22,0:08:46.23,Default,,0,0,0,,Ол сондай жақсы қыз, мен уайымдаймын.
Dialogue: 0,0:08:46.23,0:08:49.23,Default,,0,0,0,,Мен өзімді мәжбүрлеп жатырмын ба деп ойлаймын.
Dialogue: 0,0:08:49.23,0:08:51.23,Default,,0,0,0,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,0:08:51.23,0:08:53.23,Default,,0,0,0,,《Мен жақсы қызбын》
Dialogue: 0,0:09:09.25,0:09:13.25,Default,,0,0,0,,≪Не болды? Мато! Мато!
Dialogue: 0,0:09:16.26,0:09:18.19,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:09:18.19,0:09:22.20,Default,,0,0,0,,《Мен үшін ауыратын ештеңе жоқ》
Dialogue: 0,0:09:22.20,0:09:26.27,Default,,0,0,0,,《Ешқандай уайым жоқ》
Dialogue: 0,0:09:26.27,0:09:28.20,Default,,0,0,0,,《Егер...》
Dialogue: 0,0:09:28.20,0:09:31.20,Default,,0,0,0,,《Шындық бәрі мейірімді》
Dialogue: 0,0:09:31.20,0:09:33.21,Default,,0,0,0,,《Бір-бірімізді түсінетінімізге сенімдімін》
Dialogue: 0,0:09:33.21,0:09:35.21,Default,,0,0,0,,《Мен солай ойладым》
Dialogue: 0,0:09:35.21,0:09:39.21,Default,,0,0,0,,《Мен солай ойлағым келді》
Dialogue: 0,0:09:39.21,0:09:43.22,Default,,0,0,0,,《Мен өзімді қатты уайымдайтынмын.》
Dialogue: 0,0:09:43.22,0:09:47.22,Default,,0,0,0,,《Менде адамдарды жек көретін жүрегім бар...》
Dialogue: 0,0:09:47.22,0:09:52.23,Default,,0,0,0,,《Бірақ бұл менің жарақат алғым келмегендіктен》
Dialogue: 0,0:09:52.23,0:09:55.23,Default,,0,0,0,,《Себебі мені жек көргім келмейді》
Dialogue: 0,0:09:57.23,0:10:03.24,Default,,0,0,0,,《Мен кішкентай кезімнен Котори-тори туралы суретті кітаптарды жақсы көретінмін.》
Dialogue: 0,0:10:03.24,0:10:07.24,Default,,0,0,0,,《Которитори соңында толығымен қара болады》
Dialogue: 0,0:10:07.24,0:10:09.24,Default,,0,0,0,,≪Мато! Мато! !
Dialogue: 0,0:10:09.24,0:10:13.25,Default,,0,0,0,,Мен... Мен шынымен байқадым.
Dialogue: 0,0:10:13.25,0:10:15.25,Default,,0,0,0,,Мен қашып бара жатырмын.
Dialogue: 0,0:10:15.25,0:10:17.27,Default,,0,0,0,,≪Не?
Dialogue: 0,0:10:17.27,0:10:21.19,Default,,0,0,0,,Құс енді ғана кірленеді→
Dialogue: 0,0:10:21.19,0:10:23.19,Default,,0,0,0,,Мен саған тәнті болғаныма сенімдімін.
Dialogue: 0,0:10:23.19,0:10:25.19,Default,,0,0,0,,≪Не болды, Мато?
Dialogue: 0,0:10:25.19,0:10:29.19,Default,,0,0,0,,Мен үшін Kotoritori...
Dialogue: 0,0:10:38.20,0:10:40.21,Default,,0,0,0,,Иә….
Dialogue: 0,0:10:40.21,0:10:44.21,Default,,0,0,0,,...
Dialogue: 0,0:10:44.21,0:10:47.21,Default,,0,0,0,,Мен... ≪Жарайды, Мато! →
Dialogue: 0,0:10:47.21,0:10:52.21,Default,,0,0,0,,Мен жарақат алғым келмейді, бұл жақсы!
Dialogue: 0,0:10:54.22,0:10:57.22,Default,,0,0,0,,≪Матода ештеңе жоқ!
Dialogue: 0,0:10:57.22,0:10:59.23,Default,,0,0,0,,Ю….
Dialogue: 0,0:10:59.23,0:11:02.23,Default,,0,0,0,,≪Мато басқа. Қашу жоқ! →
Dialogue: 0,0:11:02.23,0:11:06.23,Default,,0,0,0,,Сіз шындыққа қатысты бірдеңе жасауға тырысып жатырсыз!
Dialogue: 0,0:11:06.23,0:11:10.23,Default,,0,0,0,,≪Қашып бара жатқан Мато емес!
Dialogue: 0,0:11:20.18,0:11:26.19,Default,,0,0,0,,Мато емес, кім қашып барады?
Dialogue: 0,0:11:26.19,0:11:28.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:32.19,0:11:36.20,Default,,0,0,0,,Мен туралы жаман сөз айтатын адамдарды жек көремін.
Dialogue: 0,0:11:36.20,0:11:39.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:39.20,0:11:44.20,Default,,0,0,0,,Біраз уақыттан бері қатты дыбыс! Эй!
Dialogue: 0,0:11:44.20,0:11:46.21,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:11:46.21,0:11:50.21,Default,,0,0,0,,Эй, ауырып тұр. Қараңдар!
Dialogue: 0,0:11:50.21,0:11:52.21,Default,,0,0,0,,Ю! Мына бала!
Dialogue: 0,0:11:54.21,0:11:58.22,Default,,0,0,0,,Сіз зардап шегесіз. Ол аурады! Эй!
Dialogue: 0,0:11:58.22,0:12:03.22,Default,,0,0,0,,Сен мені жалғыз қалдыра алмайсың. Сіз маған көмектесесіз, солай ма? Эй!
Dialogue: 0,0:12:03.22,0:12:06.23,Default,,0,0,0,,Олай емес. Бұл жақсы емес. →
Dialogue: 0,0:12:06.23,0:12:09.23,Default,,0,0,0,,Біз.
Dialogue: 0,0:12:09.23,0:12:12.23,Default,,0,0,0,,Сіз маған өз пікіріңізді білдіресіз! ?
Dialogue: 0,0:12:16.24,0:12:18.24,Default,,0,0,0,,Сен басқа менсің.
Dialogue: 0,0:12:18.24,0:12:22.24,Default,,0,0,0,,Сіз мені қорғауға міндеттісіз!
Dialogue: 0,0:12:28.25,0:12:32.25,Default,,0,0,0,,Дұрыс! Күш!
Dialogue: 0,0:12:38.26,0:12:44.26,Default,,0,0,0,,Шыу!
Dialogue: 0,0:12:44.26,0:12:46.26,Default,,0,0,0,,Ю!
Dialogue: 0,0:12:52.94,0:12:55.94,Default,,0,0,0,,Ах…. Уф...
Dialogue: 0,0:13:35.92,0:13:37.92,Default,,0,0,0,,Уау.
Dialogue: 0,0:13:37.92,0:13:40.92,Default,,0,0,0,,Ха ха ха ха ха…. →
Dialogue: 0,0:13:40.92,0:13:44.92,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:13:54.90,0:13:56.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:56.90,0:14:10.91,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:10.91,0:14:13.92,Default,,0,0,0,,Неліктен...→
Dialogue: 0,0:14:13.92,0:14:18.92,Default,,0,0,0,,Неліктен...Күш.
Dialogue: 0,0:14:20.86,0:14:23.86,Default,,0,0,0,,Ю!
Dialogue: 0,0:14:23.86,0:14:26.86,Default,,0,0,0,,Не? Ха...
Dialogue: 0,0:14:26.86,0:14:30.87,Default,,0,0,0,,Сәлем беруге кешігіп қалдым. Қара Мато.
Dialogue: 0,0:14:30.87,0:14:34.87,Default,,0,0,0,,Менің күш-қуатыма осы уақытқа дейін қамқорлық жасалған сияқты.
Dialogue: 0,0:14:34.87,0:14:37.87,Default,,0,0,0,,Менің күшім...?
Dialogue: 0,0:14:37.87,0:14:40.88,Default,,0,0,0,,Менің атым Ю Кантари.
Dialogue: 0,0:14:40.88,0:14:43.88,Default,,0,0,0,,Күш дәл қазір сіздей →
Dialogue: 0,0:14:43.88,0:14:45.88,Default,,0,0,0,,Мен осындамын. Ха...
Dialogue: 0,0:14:53.48,0:14:58.48,Default,,0,0,0,,《Мен қатты ауыратын нәрсе болғандай сезінемін》
Dialogue: 0,0:15:01.49,0:15:04.49,Default,,0,0,0,,《Бірақ жақсы есімде жоқ→
Dialogue: 0,0:15:04.49,0:15:09.49,Default,,0,0,0,,Мен есте сақтамағаным дұрыс сияқты.
Dialogue: 0,0:15:16.50,0:15:20.50,Default,,0,0,0,,Бәріңе сәлем, жарай ма? →
Dialogue: 0,0:15:20.50,0:15:24.51,Default,,0,0,0,,Курой мырза туралы білетіндер бар ма?
Dialogue: 0,0:15:24.51,0:15:28.51,Default,,0,0,0,,Курой-сан, бүгін сенің демалыс күнің емес пе?
Dialogue: 0,0:15:31.52,0:15:34.52,Default,,0,0,0,,Жаңа ғана үйімнен қоңырау шалды→
Dialogue: 0,0:15:34.52,0:15:38.52,Default,,0,0,0,,Кешеден бері үйге келмеген сияқтысың.
Dialogue: 0,0:15:38.52,0:15:42.53,Default,,0,0,0,,Үйге барма, бұл не? ? Жүгіріп кету?
Dialogue: 0,0:15:42.53,0:15:45.53,Default,,0,0,0,,Өтірік! ? (Оқушы) Бұл ұрлау сияқты емес пе?
Dialogue: 0,0:15:45.53,0:15:49.47,Default,,0,0,0,,Сәлем! Тыныш бол! Иә, иә, шу шығармаңыз!
Dialogue: 0,0:15:49.47,0:15:53.47,Default,,0,0,0,,(Камино) Санатоның тәттілері де дәл солай —
Dialogue: 0,0:15:53.47,0:15:56.47,Default,,0,0,0,,Ах... Йоми.
Dialogue: 0,0:16:04.48,0:16:06.48,Default,,0,0,0,,Курои Мато….
Dialogue: 0,0:16:06.48,0:16:11.49,Default,,0,0,0,,《Кіші мектептің оқушысы болып, бір сыныпта оқыдық→
Dialogue: 0,0:16:11.49,0:16:14.49,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:16:14.49,0:16:19.49,Default,,0,0,0,,《Бәрі... Бірақ неге? 》
Dialogue: 0,0:16:24.50,0:16:29.51,Default,,0,0,0,,Ха! Уф….
Dialogue: 0,0:16:29.51,0:16:33.51,Default,,0,0,0,,《Неге сонша ауырады? 》
Dialogue: 0,0:16:41.52,0:16:45.52,Default,,0,0,0,,Келе жатыр Келе жатыр. (Оқушы) Полиция керемет!
Dialogue: 0,0:16:45.52,0:16:47.54,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:16:47.54,0:16:49.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:52.46,0:16:55.46,Default,,0,0,0,,Кагалли? ол аурады….
Dialogue: 0,0:16:57.47,0:17:00.47,Default,,0,0,0,,Бір жері ауырып тұр...
Dialogue: 0,0:17:00.47,0:17:06.48,Default,,0,0,0,,Иә. Тіпті мен үшін. Иә, иә.
Dialogue: 0,0:17:06.48,0:17:11.48,Default,,0,0,0,,Кешіріңіз. Мен демалыс күнін маңызды уақытта аяқтадым.
Dialogue: 0,0:17:11.48,0:17:14.48,Default,,0,0,0,,Иә. Жарайды онда.
Dialogue: 0,0:17:17.49,0:17:19.49,Default,,0,0,0,,Күш….
Dialogue: 0,0:17:32.50,0:17:38.51,Default,,0,0,0,,Мен білмеймін. Ю бұл күшті дейді.
Dialogue: 0,0:17:38.51,0:17:42.51,Default,,0,0,0,,Юу... Ю!
Dialogue: 0,0:17:42.51,0:17:47.48,Default,,0,0,0,,Ю жүрегінде терең жара бар еді.
Dialogue: 0,0:17:47.48,0:17:49.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:49.35,0:17:53.35,Default,,0,0,0,,Бұл дүниеде мен соғыстым.
Dialogue: 0,0:17:59.36,0:18:03.37,Default,,0,0,0,,Шындықта өмір сүретін қыздардың азаптары мен уайымдары →
Dialogue: 0,0:18:03.37,0:18:08.37,Default,,0,0,0,,Бұл дүниені жаратып, бізді жаратқан.
Dialogue: 0,0:18:10.37,0:18:13.38,Default,,0,0,0,,Бізде эмоциялар жоқ. →
Dialogue: 0,0:18:13.38,0:18:18.38,Default,,0,0,0,,Қыздардың эмоциясының жетегінде отырып, ол тек инстинктпен күреседі.
Dialogue: 0,0:18:20.38,0:18:26.39,Default,,0,0,0,,Black Rock Shooter осы әлемде пайда болды. →
Dialogue: 0,0:18:26.39,0:18:31.39,Default,,0,0,0,,Мен өзімді күшті сезіндім. Бірақ тек төбелескісі келетін мен үшін →
Dialogue: 0,0:18:31.39,0:18:36.40,Default,,0,0,0,,Жеңістің де, жеңілудің де мәні болмады. →
Dialogue: 0,0:18:36.40,0:18:43.41,Default,,0,0,0,,Ал мен өлейін деп тұрған сәт...
Dialogue: 0,0:18:43.41,0:18:45.41,Default,,0,0,0,,《Жақсы емес》
Dialogue: 0,0:18:50.45,0:18:52.45,Default,,0,0,0,,Мен Юның дауысын естідім. →
Dialogue: 0,0:18:52.45,0:18:57.45,Default,,0,0,0,,Сол сәтте менің бойымда бір сезім пайда болды.
Dialogue: 0,0:18:57.45,0:18:59.46,Default,,0,0,0,,Сезімдер?
Dialogue: 0,0:18:59.46,0:19:01.46,Default,,0,0,0,,Юудың азабы →
Dialogue: 0,0:19:01.46,0:19:04.46,Default,,0,0,0,,Басқа қыздармен салыстыруға болмайды→
Dialogue: 0,0:19:04.46,0:19:06.46,Default,,0,0,0,,Оның үлкен массасы болды. →
Dialogue: 0,0:19:06.46,0:19:11.47,Default,,0,0,0,,Бұл маған әсер етті. →
Dialogue: 0,0:19:11.47,0:19:16.47,Default,,0,0,0,,Алғашқы сезімдеріммен іштей ойладым. →
Dialogue: 0,0:19:16.47,0:19:21.48,Default,,0,0,0,,Юу эмоцияларының көпшілігі ауырсыну мен жек көрушіліктен тұрады. →
Dialogue: 0,0:19:21.48,0:19:24.48,Default,,0,0,0,,Мен олардың барлығын ұстаймын→
Dialogue: 0,0:19:24.48,0:19:31.49,Default,,0,0,0,,Егер сізді Black Rock Shooter өлтірсе →
Dialogue: 0,0:19:31.49,0:19:35.49,Default,,0,0,0,,Ю үшін не қалады?
Dialogue: 0,0:19:38.50,0:19:40.50,Default,,0,0,0,,Және….
Dialogue: 0,0:19:43.50,0:19:48.44,Default,,0,0,0,,Жақсы. Мен өлмегеніме қуаныштымын. →
Dialogue: 0,0:19:48.44,0:19:51.44,Default,,0,0,0,,Сен жоғалып кетсең мен қиыншылыққа ұшырайтын едім.
Dialogue: 0,0:19:51.44,0:19:54.44,Default,,0,0,0,,Ю…. Бұл дұрыс. Бұл Юу.
Dialogue: 0,0:19:54.44,0:19:56.45,Default,,0,0,0,,Неліктен? →
Dialogue: 0,0:19:56.45,0:19:58.45,Default,,0,0,0,,Мен жоғалсам, сенің уайымдарың да кетеді...
Dialogue: 0,0:19:58.45,0:20:02.45,Default,,0,0,0,,Ол жақтағы дүние қатал. Бұл жай ғана қорқынышты. →
Dialogue: 0,0:20:02.45,0:20:04.45,Default,,0,0,0,,Мұның бәрі ауыр. →
Dialogue: 0,0:20:04.45,0:20:07.46,Default,,0,0,0,,Менің қиыншылықтарыммен осында өлсең де→
Dialogue: 0,0:20:07.46,0:20:10.46,Default,,0,0,0,,Менде тағы да жаңа мәселе болады. →
Dialogue: 0,0:20:10.46,0:20:14.46,Default,,0,0,0,,Егер сіз сол уақытта жоқ болсаңыз→
Dialogue: 0,0:20:14.46,0:20:16.46,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:20:18.47,0:20:22.47,Default,,0,0,0,,Онымен салыстырғанда бұл дүниені түсіну оңайырақ. →
Dialogue: 0,0:20:22.47,0:20:24.47,Default,,0,0,0,,Бей-берекет алаңдайтын ештеңе жоқ. →
Dialogue: 0,0:20:24.47,0:20:28.48,Default,,0,0,0,,Тек күрес. Ауырсынуды түсіну бәрінен де оңай. →
Dialogue: 0,0:20:28.48,0:20:32.48,Default,,0,0,0,,Эй, айырбаста. алмасу?
Dialogue: 0,0:20:32.48,0:20:34.48,Default,,0,0,0,,Иә, айырбас.
Dialogue: 0,0:20:34.48,0:20:39.49,Default,,0,0,0,,Уау! Уф... Ах...
Dialogue: 0,0:20:39.49,0:20:42.49,Default,,0,0,0,,Өйткені мен бұл дүниеде қаламын →
Dialogue: 0,0:20:42.49,0:20:46.49,Default,,0,0,0,,Сіз шындыққа жауаптысыз.
Dialogue: 0,0:20:50.43,0:20:57.44,Default,,0,0,0,,Кешіріңіз. Маған бәрін сенің мойныңа алуға рұқсат ет. →
Dialogue: 0,0:20:57.44,0:21:00.44,Default,,0,0,0,,Бірақ өтінемін→
Dialogue: 0,0:21:00.44,0:21:05.45,Default,,0,0,0,,Өтінемін, менің орныма сол әлемді қорға. →
Dialogue: 0,0:21:05.45,0:21:11.45,Default,,0,0,0,,Өйткені ол дүние сол бала үшін жалғыз баспана.
Dialogue: 0,0:21:11.45,0:21:27.47,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:27.47,0:21:32.48,Default,,0,0,0,,Ха! аа….
Dialogue: 0,0:21:32.48,0:21:34.78,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:21:42.49,0:21:44.49,Default,,0,0,0,,《Мен бұл туралы ойлағым келмейді》
Dialogue: 0,0:21:44.49,0:21:47.49,Default,,0,0,0,,《Ауырып тұр... ауырса да》
Dialogue: 0,0:21:50.43,0:21:52.43,Default,,0,0,0,,《Уау! Ақылды есім! 》
Dialogue: 0,0:21:52.43,0:21:56.43,Default,,0,0,0,,Оны тоқтатыңыз. сен….
Dialogue: 0,0:21:56.43,0:21:59.44,Default,,0,0,0,,《Ендеше кеттік! ойнайық! 》
Dialogue: 0,0:21:59.44,0:22:02.11,Default,,0,0,0,,《Әртүрлі нәрселерді бірге көрейік! 》
Dialogue: 0,0:22:02.11,0:22:07.34,Default,,0,0,0,,Сіз… менің….
Dialogue: 0,0:22:07.34,0:22:09.35,Default,,0,0,0,,《Жоқ! 》
Dialogue: 0,0:22:09.35,0:22:12.35,Default,,0,0,0,,《Үйге барсам, Которию-сан мен Йомимен бірге боламын! 》
Dialogue: 0,0:22:12.35,0:22:14.35,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:17.35,0:22:21.35,Default,,0,0,0,,Менің досым...
Dialogue: 0,0:22:26.36,0:22:31.36,Default,,0,0,0,,Мато…. Мато!
Dialogue: 0,0:22:33.37,0:22:35.14,Default,,0,0,0,,《Неге мен...》
Dialogue: 0,0:22:35.14,0:22:37.81,Default,,0,0,0,,Мато! Мато!
Dialogue: 0,0:22:37.81,0:22:40.48,Default,,0,0,0,,《Сіз Матоны ұмытпақ болдыңыз ба? 》
Dialogue: 0,0:22:40.48,0:22:42.48,Default,,0,0,0,,Мато!
Dialogue: 0,0:22:44.48,0:22:46.48,Default,,0,0,0,,Мато!
Dialogue: 0,0:25:17.47,0:25:20.47,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:25:20.47,0:25:26.48,Default,,0,0,0,,Хауа ананың таңдауы, біздің жаңа патшамыз.
Dialogue: 0,0:25:26.48,0:25:29.48,Default,,0,0,0,,Король?
Dialogue: 0,0:25:29.48,0:25:33.48,Default,,0,0,0,,Жақында шын есім де Коцитке қайта оралады.
Dialogue: 0,0:25:33.48,0:25:36.49,Default,,0,0,0,,Бұл табиғат заңы.
Dialogue: 0,0:25:37.99,0:25:43.99,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
