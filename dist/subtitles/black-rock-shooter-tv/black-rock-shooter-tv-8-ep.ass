Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.79,0:00:13.79,Default,,0,0,0,,Елемеу азабы!
Dialogue: 0,0:00:13.79,0:00:16.79,Default,,0,0,0,,Мазақ етудің азабы! →
Dialogue: 0,0:00:16.79,0:00:19.80,Default,,0,0,0,,Менің қайтып баратын жерім жоқ, сондықтан мен жүре беремін →
Dialogue: 0,0:00:19.80,0:00:22.80,Default,,0,0,0,,Табаныңыздың ауыруы!
Dialogue: 0,0:00:27.80,0:00:31.80,Default,,0,0,0,,Біркелкі Бөлшектеп, жүрегіңді ойып алғанша!
Dialogue: 0,0:00:36.81,0:00:40.81,Default,,0,0,0,,Мен өзімді кесіп тастағаным жөн!
Dialogue: 0,0:00:43.82,0:00:46.82,Default,,0,0,0,,Бұл әлдеқайда жақсы.
Dialogue: 0,0:00:46.82,0:00:48.83,Default,,0,0,0,,Уф! Уф….
Dialogue: 0,0:00:48.83,0:00:51.83,Default,,0,0,0,,Мато кешіріңіз.
Dialogue: 0,0:00:51.83,0:00:53.83,Default,,0,0,0,,Ю! ? Мато→
Dialogue: 0,0:00:53.83,0:00:56.77,Default,,0,0,0,,Мен оны Black Rock Shooter ішінен құтқарғым келді. →
Dialogue: 0,0:00:56.77,0:01:01.77,Default,,0,0,0,,Бірақ бұл жұмыс істемесе... Ю?
Dialogue: 0,0:01:08.78,0:01:11.78,Default,,0,0,0,,Мен Матоны өлтіру үшін қолымды пайдаланғым келмейді. →
Dialogue: 0,0:01:11.78,0:01:14.78,Default,,0,0,0,,Өйткені мен оны мүлдем жек көремін.
Dialogue: 0,0:01:14.78,0:01:17.79,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Ю!
Dialogue: 0,0:01:17.79,0:01:20.79,Default,,0,0,0,,Рахмет досым.
Dialogue: 0,0:01:20.79,0:01:23.79,Default,,0,0,0,,Ю? Ю!
Dialogue: 0,0:01:31.80,0:01:33.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:33.80,0:01:36.81,Default,,0,0,0,,Не болды? Юу. Ю?
Dialogue: 0,0:01:36.81,0:01:38.81,Default,,0,0,0,,Жауап Ю!
Dialogue: 0,0:01:38.81,0:01:41.81,Default,,0,0,0,,《Мен Юудың ойлау формасымын》→
Dialogue: 0,0:01:41.81,0:01:44.81,Default,,0,0,0,,《Ой денесі жойылғанша→
Dialogue: 0,0:01:44.81,0:01:47.82,Default,,0,0,0,,Юу қазір сезініп отырған ауырсыну жоғалады.
Dialogue: 0,0:01:47.82,0:01:49.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:49.82,0:01:51.82,Default,,0,0,0,,Уф... тоқтатыңыз...
Dialogue: 0,0:01:51.82,0:01:53.82,Default,,0,0,0,,Ю өзінің азабын ұмытты→
Dialogue: 0,0:01:53.82,0:01:57.76,Default,,0,0,0,,Сіз енді бұл жерде қала алмайсыз.
Dialogue: 0,0:01:57.76,0:02:00.76,Default,,0,0,0,,Тоқта... Ия, тоқта! →
Dialogue: 0,0:02:00.76,0:02:03.77,Default,,0,0,0,,Мен шындыққа оралғым келмейді!
Dialogue: 0,0:02:03.77,0:02:05.77,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:05.77,0:02:09.77,Default,,0,0,0,,Жоқ! Жоқ. Мүлдем жоқ!
Dialogue: 0,0:02:11.77,0:02:17.77,Default,,0,0,0,,Рұқсат етілмейді. Юу менің досым!
Dialogue: 0,0:02:21.78,0:02:27.78,Default,,0,0,0,,Уф! !
Dialogue: 0,0:02:31.79,0:02:33.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:35.80,0:02:37.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:45.81,0:02:51.81,Default,,0,0,0,,А... бұл қайда?
Dialogue: 0,0:02:51.81,0:02:55.84,Default,,0,0,0,,Тамаша қараңғы, жарық жоқ.
Dialogue: 0,0:02:55.84,0:02:58.76,Default,,0,0,0,,Қираған жол...
Dialogue: 0,0:02:58.76,0:03:02.76,Default,,0,0,0,,Бұл Black Rock Shooter әлемі.
Dialogue: 0,0:03:02.76,0:03:05.76,Default,,0,0,0,,≪(Black Rock Shooter) Иә, сіздің әлеміңіз.
Dialogue: 0,0:03:05.76,0:03:08.77,Default,,0,0,0,,Не... сен!
Dialogue: 0,0:03:08.77,0:03:11.77,Default,,0,0,0,,Жараланғанда қандай сезім пайда болады? →
Dialogue: 0,0:03:11.77,0:03:13.77,Default,,0,0,0,,...
Dialogue: 0,0:03:13.77,0:03:15.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:47.95,0:03:52.80,Default,,0,0,0,,≪(аяқ дыбысы)
Dialogue: 0,0:03:52.95,0:03:55.96,Default,,0,0,0,,Күш? Неліктен? →
Dialogue: 0,0:03:55.96,0:03:58.96,Default,,0,0,0,,Неліктен олай істедің? →
Dialogue: 0,0:03:58.96,0:04:03.97,Default,,0,0,0,,Сен жоғалып кетсең, мен... қайтуым керек!
Dialogue: 0,0:04:03.97,0:04:06.97,Default,,0,0,0,,Шындық! →
Dialogue: 0,0:04:06.97,0:04:10.97,Default,,0,0,0,,Маған ұнамайды. Неліктен? Жалғызсың ба? →
Dialogue: 0,0:04:10.97,0:04:14.98,Default,,0,0,0,,Мен қайтып баратын жер жоқ!
Dialogue: 0,0:04:14.98,0:04:18.98,Default,,0,0,0,,Жалғыз ба? →
Dialogue: 0,0:04:18.98,0:04:24.98,Default,,0,0,0,,Мато маған көмектесуге тырысты... Юуға көмектесуге тырысты.
Dialogue: 0,0:04:37.93,0:04:41.94,Default,,0,0,0,,Мен саған өзімді мәжбүрледім.
Dialogue: 0,0:04:41.94,0:04:45.94,Default,,0,0,0,,Менің қасіретім, менің уайымым, менің күмәнім.
Dialogue: 0,0:04:45.94,0:04:48.94,Default,,0,0,0,,Бұл жақсы. Біз сондай жаратылыстармыз.
Dialogue: 0,0:04:48.94,0:04:51.95,Default,,0,0,0,,Жоқ! Мен ешкімді ренжіткім келмейді.
Dialogue: 0,0:04:51.95,0:04:54.95,Default,,0,0,0,,Ю, Йоми және сен де.
Dialogue: 0,0:04:54.95,0:04:59.95,Default,,0,0,0,,Жоқ, бұл дұрыс емес. Мен ренжіткім келеді. Өзіңіз жасаңыз!
Dialogue: 0,0:04:59.95,0:05:01.96,Default,,0,0,0,,Мен ренжіткім келеді...
Dialogue: 0,0:05:01.96,0:05:04.96,Default,,0,0,0,,Иә, мен жарақат алғым келеді!
Dialogue: 0,0:05:04.96,0:05:09.96,Default,,0,0,0,,Өйткені, егер сіз зардап шекпесеңіз, сіз дүниені көре алмайсыз!
Dialogue: 0,0:05:09.96,0:05:14.97,Default,,0,0,0,,Дұрыс... Көргім келеді Айналмай-ақ көргім келеді!
Dialogue: 0,0:05:14.97,0:05:16.97,Default,,0,0,0,,Күлімсіреген қызғылт сары→
Dialogue: 0,0:05:16.97,0:05:19.97,Default,,0,0,0,,Суық қызғылт да →
Dialogue: 0,0:05:19.97,0:05:21.98,Default,,0,0,0,,Көздің жасы да →
Dialogue: 0,0:05:21.98,0:05:24.98,Default,,0,0,0,,Бұлыңғыр күлгін де→
Dialogue: 0,0:05:24.98,0:05:27.98,Default,,0,0,0,,Пунсука да қызыл!
Dialogue: 0,0:05:27.98,0:05:29.98,Default,,0,0,0,,Бұл ауыр түс.
Dialogue: 0,0:05:29.98,0:05:32.92,Default,,0,0,0,,Мен мұның бәрін өзім көргім келеді!
Dialogue: 0,0:05:32.92,0:05:35.92,Default,,0,0,0,,Мен білмей жазылатын жараны ұнатпаймын!
Dialogue: 0,0:05:35.92,0:05:38.93,Default,,0,0,0,,Мен өзіме зиян келтіргім келеді!
Dialogue: 0,0:05:38.93,0:05:40.93,Default,,0,0,0,,Мен сені ренжітемін.
Dialogue: 0,0:05:48.94,0:05:51.94,Default,,0,0,0,,《Бұл қызыл...》 Уф!
Dialogue: 0,0:05:51.94,0:05:53.94,Default,,0,0,0,,Бізден өзгеше→
Dialogue: 0,0:05:53.94,0:05:56.94,Default,,0,0,0,,Жараларыңыз оңай жазылмайды.
Dialogue: 0,0:05:58.95,0:06:00.95,Default,,0,0,0,,Неліктен оны қолданбасқа?
Dialogue: 0,0:06:00.95,0:06:02.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:02.95,0:06:07.96,Default,,0,0,0,,Жоқ, мен мұны қолданбаймын. Мен мүлде істеймін!
Dialogue: 0,0:06:07.96,0:06:09.96,Default,,0,0,0,,Қулық.
Dialogue: 0,0:06:11.96,0:06:16.96,Default,,0,0,0,,Ешкімді ренжітпей тек өзіңді ренжіткің келеді. →
Dialogue: 0,0:06:16.96,0:06:18.97,Default,,0,0,0,,Қулық.
Dialogue: 0,0:06:18.97,0:06:23.97,Default,,0,0,0,,Әй, біреуді ренжіткеннің азабы...
Dialogue: 0,0:06:27.98,0:06:31.91,Default,,0,0,0,,《Зақым келтірмей-ақ жараласаңшы...》
Dialogue: 0,0:06:31.91,0:06:34.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:34.92,0:06:37.92,Default,,0,0,0,,Осыған байланысты мен қозғала алмаймын.
Dialogue: 0,0:06:37.92,0:06:40.92,Default,,0,0,0,,《Уф... Уф! 》
Dialogue: 0,0:06:40.92,0:06:43.92,Default,,0,0,0,,《Жоқ, мүмкін емес》
Dialogue: 0,0:06:43.92,0:06:46.93,Default,,0,0,0,,《Біреуді ренжіту》
Dialogue: 0,0:06:46.93,0:06:49.93,Default,,0,0,0,,《Мүмкін емес...》
Dialogue: 0,0:06:49.93,0:06:53.93,Default,,0,0,0,,《Мен енді қозғала алмаймын...》
Dialogue: 0,0:06:53.93,0:06:57.93,Default,,0,0,0,,Кішкентай құс өлді.
Dialogue: 0,0:07:00.94,0:07:03.94,Default,,0,0,0,,《Соған қарамастан》 Мен өлдім.
Dialogue: 0,0:07:03.94,0:07:07.95,Default,,0,0,0,,《Түсті есте сақтау》 өледі...
Dialogue: 0,0:07:07.95,0:07:09.95,Default,,0,0,0,,《Түс》
Dialogue: 0,0:07:11.95,0:07:13.95,Default,,0,0,0,,《Көк аспан》
Dialogue: 0,0:07:13.95,0:07:32.91,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:32.91,0:07:38.91,Default,,0,0,0,,《Иә, мен әртүрлі түстерді көру үшін ұшамын》
Dialogue: 0,0:07:38.91,0:07:41.92,Default,,0,0,0,,《Ұшу үшін...》
Dialogue: 0,0:07:41.92,0:07:49.92,Default,,0,0,0,,Уф! !
Dialogue: 0,0:07:56.93,0:08:08.94,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:08.94,0:08:10.94,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:19.95,0:08:21.95,Default,,0,0,0,,Кохаччи?
Dialogue: 0,0:08:30.98,0:08:35.90,Default,,0,0,0,,Ах! ол аурады…. →
Dialogue: 0,0:08:35.90,0:08:38.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:38.91,0:08:41.91,Default,,0,0,0,,《Неге ұмыттың...》
Dialogue: 0,0:08:43.91,0:08:48.92,Default,,0,0,0,,《Мен Кагаллиді жалғыз қалдыра алмадым》→
Dialogue: 0,0:08:48.92,0:08:55.92,Default,,0,0,0,,《Себебі мен біреумен достасуды білмедім》
Dialogue: 0,0:08:55.92,0:08:57.93,Default,,0,0,0,,(Йомидің айқайы)
Dialogue: 0,0:08:57.93,0:09:03.93,Default,,0,0,0,,《Мені ауыртты... Үнемі ауырды》→
Dialogue: 0,0:09:03.93,0:09:07.94,Default,,0,0,0,,《Бірақ бұл маған Матоны ұнататындықтан》→
Dialogue: 0,0:09:07.94,0:09:14.94,Default,,0,0,0,,《Себебі мен ауырып, уайымдасам да біреумен қосылғым келді》
Dialogue: 0,0:09:19.95,0:09:21.95,Default,,0,0,0,,Мато….
Dialogue: 0,0:09:21.95,0:09:27.96,Default,,0,0,0,,Уау! !
Dialogue: 0,0:09:27.96,0:09:33.96,Default,,0,0,0,,Уф! !
Dialogue: 0,0:09:52.08,0:09:54.08,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:09:54.08,0:09:57.08,Default,,0,0,0,,Бізде эмоция жоқ.
Dialogue: 0,0:10:05.09,0:10:08.09,Default,,0,0,0,,Бірақ бұл маңызды...
Dialogue: 0,0:10:13.10,0:10:16.10,Default,,0,0,0,,Күш! Барлығы...
Dialogue: 0,0:10:18.10,0:10:21.10,Default,,0,0,0,,Біз де барайық. Ха! ?
Dialogue: 0,0:10:24.11,0:10:28.11,Default,,0,0,0,,Біздің асыл балаларымыз...→
Dialogue: 0,0:10:28.11,0:10:31.12,Default,,0,0,0,,Себебі мен жылап жатырмын.
Dialogue: 0,0:10:31.12,0:10:35.12,Default,,0,0,0,,Себебі мен қышидым→
Dialogue: 0,0:10:35.12,0:10:39.13,Default,,0,0,0,,Біздің асыл →
Dialogue: 0,0:10:39.13,0:10:41.13,Default,,0,0,0,,Біздің→
Dialogue: 0,0:10:41.13,0:10:43.13,Default,,0,0,0,,Жаралар.
Dialogue: 0,0:10:49.07,0:10:53.07,Default,,0,0,0,,Маған Йоми қатты ұнайды.
Dialogue: 0,0:10:55.08,0:10:57.08,Default,,0,0,0,,Мен қосылғым келеді.
Dialogue: 0,0:11:05.09,0:11:08.09,Default,,0,0,0,,Зардап шегуге болмайды. →
Dialogue: 0,0:11:08.09,0:11:11.09,Default,,0,0,0,,Сонда да қосылғым келеді!
Dialogue: 0,0:11:15.10,0:11:17.10,Default,,0,0,0,,Оқу….
Dialogue: 0,0:11:21.10,0:11:24.10,Default,,0,0,0,,...
Dialogue: 0,0:11:24.10,0:11:26.11,Default,,0,0,0,,Мен сені қалаймын→
Dialogue: 0,0:11:26.11,0:11:28.11,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:11:31.11,0:11:39.12,Default,,0,0,0,,Зардап шегеді, бірақ мен →
Dialogue: 0,0:11:39.12,0:11:41.12,Default,,0,0,0,,Сізбен байланысыңыз!
Dialogue: 0,0:11:41.12,0:12:01.07,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:01.07,0:12:06.07,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:46.05,0:12:49.06,Default,,0,0,0,,Мм... Аа!
Dialogue: 0,0:12:49.06,0:12:51.06,Default,,0,0,0,,Ю!
Dialogue: 0,0:12:53.06,0:12:56.06,Default,,0,0,0,,Ю! Ю!
Dialogue: 0,0:13:02.07,0:13:04.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:06.07,0:13:09.08,Default,,0,0,0,,Менің атымды атаңыз.
Dialogue: 0,0:13:09.08,0:13:11.08,Default,,0,0,0,,Ю?
Dialogue: 0,0:13:13.08,0:13:15.08,Default,,0,0,0,,Күш…. Күш!
Dialogue: 0,0:13:15.08,0:13:20.09,Default,,0,0,0,,Күш! Мен оны ұнатпаймын. Өтінемін өлме.
Dialogue: 0,0:13:20.09,0:13:25.09,Default,,0,0,0,,Мен төбелесе алмаймын. Мен шынайы өмірде күресе алмаймын!
Dialogue: 0,0:13:25.09,0:13:28.09,Default,,0,0,0,,Нағыз жаулар тым қорқынышты!
Dialogue: 0,0:13:28.09,0:13:31.10,Default,,0,0,0,,бәрі жақсы.
Dialogue: 0,0:13:31.10,0:13:34.10,Default,,0,0,0,,Ю Жарайды.
Dialogue: 0,0:13:36.10,0:13:39.10,Default,,0,0,0,,Ах. Ах.
Dialogue: 0,0:13:44.11,0:13:46.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:46.05,0:13:51.05,Default,,0,0,0,,Сая-чан осында. Мато бар.
Dialogue: 0,0:13:51.05,0:13:55.06,Default,,0,0,0,,Сенің көптеген достар табатыныңа сенімдімін.
Dialogue: 0,0:13:55.06,0:13:57.06,Default,,0,0,0,,Ах…. Ах.
Dialogue: 0,0:14:00.06,0:14:04.06,Default,,0,0,0,,Қарашы, Ю. Ах.
Dialogue: 0,0:14:04.06,0:14:06.07,Default,,0,0,0,,Дүние біртұтас болды. →
Dialogue: 0,0:14:06.07,0:14:13.07,Default,,0,0,0,,Дүние біртұтас бола алатыны сияқты, біздің жүрегіміз де солай бола алады.
Dialogue: 0,0:14:13.07,0:14:18.08,Default,,0,0,0,,Бірақ... бірақ бұл мүмкін емес! Бұл мүмкін емес! →
Dialogue: 0,0:14:18.08,0:14:21.08,Default,,0,0,0,,Мені ешкім ойламайды→
Dialogue: 0,0:14:21.08,0:14:25.09,Default,,0,0,0,,Сен маған ғашық болмайсың! а….
Dialogue: 0,0:14:25.09,0:14:29.09,Default,,0,0,0,,Мен Юудың ойлау формасымын.
Dialogue: 0,0:14:29.09,0:14:34.09,Default,,0,0,0,,Юу үшін эмоциясыз күреседі. →
Dialogue: 0,0:14:34.09,0:14:37.10,Default,,0,0,0,,Бұл бәрі емес. иә?
Dialogue: 0,0:14:37.10,0:14:41.10,Default,,0,0,0,,Бізде эмоция болмаса да→
Dialogue: 0,0:14:41.10,0:14:44.10,Default,,0,0,0,,Мен тек инстинктпен қозғала алатын болсам да →
Dialogue: 0,0:14:44.10,0:14:51.04,Default,,0,0,0,,Сондықтан ұнатпайтын адам үшін күресуге болмайды. →
Dialogue: 0,0:14:51.04,0:14:59.05,Default,,0,0,0,,Себебі мен сендерді жақсы көремін. Өйткені мен сені қорғағым келеді. →
Dialogue: 0,0:14:59.05,0:15:04.06,Default,,0,0,0,,Себебі жылап тұрған жүздеріңді көргім келмейді.
Dialogue: 0,0:15:04.06,0:15:10.06,Default,,0,0,0,,Біз сені жақсы көретіндіктен, сол үшін ұрысып қалдық.
Dialogue: 0,0:15:10.06,0:15:12.06,Default,,0,0,0,,Ах.
Dialogue: 0,0:15:16.07,0:15:20.07,Default,,0,0,0,,《Себебі мен сені сүйемін》
Dialogue: 0,0:15:23.08,0:15:27.08,Default,,0,0,0,,Сүйіктім Юға өтірік айтпаймын.
Dialogue: 0,0:15:27.08,0:15:32.09,Default,,0,0,0,,Өйткені шындық - өте тамаша дүние →
Dialogue: 0,0:15:32.09,0:15:35.09,Default,,0,0,0,,Маған сеніңіз.
Dialogue: 0,0:15:35.09,0:15:39.09,Default,,0,0,0,,Күш…. Ах! Күш!
Dialogue: 0,0:15:46.03,0:15:48.03,Default,,0,0,0,,Мато…. Ах.
Dialogue: 0,0:15:48.03,0:15:53.04,Default,,0,0,0,,Рахмет, Мато. Мато айтты. →
Dialogue: 0,0:15:53.04,0:15:57.04,Default,,0,0,0,,Ол маған сол дүниенің ғажайыптарын үйретті.
Dialogue: 0,0:15:57.04,0:15:59.05,Default,,0,0,0,,Күш!
Dialogue: 0,0:15:59.05,0:16:03.05,Default,,0,0,0,,Достармен үйге бара жатқанда→
Dialogue: 0,0:16:03.05,0:16:06.05,Default,,0,0,0,,Ол маған заттардың көзді ашып-жұмғанша қалай өтетінін үйретті. →
Dialogue: 0,0:16:06.05,0:16:11.06,Default,,0,0,0,,Үйге қайтып бара жатып жейтін балмұздақ қандай тәтті →
Dialogue: 0,0:16:11.06,0:16:18.06,Default,,0,0,0,,Доспен бірге қарау Ол маған күн батқанның қызаруын үйретті.
Dialogue: 0,0:16:18.06,0:16:26.07,Default,,0,0,0,,Мат. Біз мәңгі доспыз.
Dialogue: 0,0:16:26.07,0:16:29.08,Default,,0,0,0,,Әрине. Юудың бакателесі.
Dialogue: 0,0:16:29.08,0:16:32.08,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:16:32.08,0:16:34.08,Default,,0,0,0,,Күш!
Dialogue: 0,0:16:34.08,0:16:37.08,Default,,0,0,0,,Ах! а….
Dialogue: 0,0:16:37.08,0:16:40.09,Default,,0,0,0,,Ах…. Уф...
Dialogue: 0,0:16:40.09,0:16:43.09,Default,,0,0,0,,Юуу!
Dialogue: 0,0:16:43.09,0:16:58.04,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:58.04,0:17:00.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:00.04,0:17:02.04,Default,,0,0,0,,Ах.
Dialogue: 0,0:17:08.05,0:17:10.05,Default,,0,0,0,,...
Dialogue: 0,0:17:13.05,0:17:17.05,Default,,0,0,0,,Өйткені мен сендерді жақсы көремін.
Dialogue: 0,0:17:29.07,0:17:31.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:31.07,0:17:39.08,Default,,0,0,0,,(Саяның жылағаны)
Dialogue: 0,0:17:39.08,0:17:41.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:41.08,0:17:56.03,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:56.03,0:18:00.03,Default,,0,0,0,,≪Мато! а….
Dialogue: 0,0:18:00.03,0:18:03.04,Default,,0,0,0,,Оқу.
Dialogue: 0,0:18:03.04,0:18:05.04,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:18:07.04,0:18:09.04,Default,,0,0,0,,Мм... сіз білесіз →
Dialogue: 0,0:18:09.04,0:18:14.05,Default,,0,0,0,,Менің сізге айтқым келетін нәрселер көп.
Dialogue: 0,0:18:14.05,0:18:17.05,Default,,0,0,0,,Білесіз бе, мен бір нәрсе үшін кешірім сұрағым келеді...
Dialogue: 0,0:18:21.05,0:18:25.06,Default,,0,0,0,,Мато…. Саған ауыр тигенім үшін кешірім сұраймын.
Dialogue: 0,0:18:25.06,0:18:28.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:28.06,0:18:35.07,Default,,0,0,0,,Мен де қиналамын, бірге қиналайық.
Dialogue: 0,0:18:35.07,0:18:40.07,Default,,0,0,0,,Ах…. өтінемін
Dialogue: 0,0:18:40.07,0:18:44.08,Default,,0,0,0,,Мато Кішкентай балаға ұқсайды.
Dialogue: 0,0:18:44.08,0:18:48.08,Default,,0,0,0,,Бұл дүниеде көптеген түстер бар.
Dialogue: 0,0:18:51.02,0:18:55.02,Default,,0,0,0,,Ашық түстер. Жылы түстер.
Dialogue: 0,0:18:55.02,0:18:58.02,Default,,0,0,0,,Жарқыраған түстер.
Dialogue: 0,0:18:58.02,0:19:00.03,Default,,0,0,0,,Уау. сирек. Сіз жалғыз оянасыз ба?
Dialogue: 0,0:19:00.03,0:19:02.03,Default,,0,0,0,,Шулы! (Матоның анасы) Міне!
Dialogue: 0,0:19:02.03,0:19:05.03,Default,,0,0,0,,Тез тамақтанып, дайындал. Өйткені Хиро...
Dialogue: 0,0:19:05.03,0:19:11.04,Default,,0,0,0,,Лас түстер, жалғыз түстер, мұңды түстер.
Dialogue: 0,0:19:11.04,0:19:15.04,Default,,0,0,0,,Қош келдіңіз. (Йоми Кагари) Кеттік!
Dialogue: 0,0:19:20.05,0:19:23.05,Default,,0,0,0,,Бірақ барлық жақсы түстер емес.
Dialogue: 0,0:19:23.05,0:19:42.07,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:42.07,0:19:47.07,Default,,0,0,0,,Сонда да бұл дүние әлі де әдемі!
Dialogue: 0,0:19:52.08,0:19:57.08,Default,,0,0,0,,Менің достарым бар, бәріміз бірге күле аламыз.
Dialogue: 0,0:20:00.09,0:20:04.09,Default,,0,0,0,,Неше түрлі заттар, неше түрлі түстер бар.
Dialogue: 0,0:20:13.10,0:20:18.10,Default,,0,0,0,,Дегенмен, біз әрқайсысын қабылдаймыз.
Dialogue: 0,0:20:26.11,0:20:31.11,Default,,0,0,0,,Оны қабылдап, бірінен соң бірі ересек адам бол.
Dialogue: 0,0:20:36.12,0:20:42.13,Default,,0,0,0,,Бұл дүниеде ересек адам болу.
Dialogue: 0,0:20:42.13,0:20:52.13,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:26.10,0:22:28.10,Default,,0,0,0,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,0:22:31.10,0:22:35.11,Default,,0,0,0,,Мен күресуді жалғастырамын. →
Dialogue: 0,0:22:35.11,0:22:40.11,Default,,0,0,0,,Ауырсыну мен жараны әлі де ұстап тұр.
Dialogue: 0,0:22:48.05,0:22:52.05,Default,,0,0,0,,Мен бұл дүниеде күресуді жалғастырамын!
Dialogue: 0,0:25:13.07,0:25:23.07,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:24.57,0:25:30.57,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
