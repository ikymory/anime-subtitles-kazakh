Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.72,0:00:17.54,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:20.74,0:00:41.22,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:40.93,0:00:44.93,Default,,0,0,0,,«Котори көк аспанда ұшады».
Dialogue: 0,0:00:44.93,0:00:57.88,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:57.88,0:01:01.88,Default,,0,0,0,,«Аспанның көгілдір түсі теңізге тарайды».
Dialogue: 0,0:01:04.89,0:01:07.89,Default,,0,0,0,,«Эсора но Аоно Сора но Уми»
Dialogue: 0,0:01:07.89,0:01:13.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:13.90,0:01:25.91,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:25.91,0:01:29.91,Default,,0,0,0,,«Эсора жоқ Аони, Сора жоқ Намида».
Dialogue: 0,0:01:39.92,0:01:43.92,Default,,0,0,0,,«Намида но Аони Котори ұшады»
Dialogue: 0,0:01:56.39,0:01:58.39,Default,,0,0,0,,[Майк] (Басшы) Олай болса, бір күнде өз өміріңізді білдіре алсаңыз→
Dialogue: 0,0:01:58.39,0:02:03.40,Default,,0,0,0,,Кіші сынып оқушысы кезіңізде, таңның атысы әлі қараңғы еді...
Dialogue: 0,0:02:03.40,0:02:05.40,Default,,0,0,0,,《Ұзын…》
Dialogue: 0,0:02:10.40,0:02:12.40,Default,,0,0,0,,《Қысқа》
Dialogue: 0,0:02:17.41,0:02:19.41,Default,,0,0,0,,《Блум》
Dialogue: 0,0:02:26.42,0:02:28.42,Default,,0,0,0,,《Шашырау》
Dialogue: 0,0:02:33.43,0:02:35.43,Default,,0,0,0,,《Көк》
Dialogue: 0,0:02:35.43,0:02:37.43,Default,,0,0,0,,Тез кеттік! Ах... Уау!
Dialogue: 0,0:02:37.43,0:02:40.43,Default,,0,0,0,,А, кешіріңіз. Уау... Ах! !
Dialogue: 0,0:02:40.43,0:02:42.43,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:02:44.44,0:02:46.44,Default,,0,0,0,,Қызыл…. иә?
Dialogue: 0,0:02:46.44,0:02:50.44,Default,,0,0,0,,Уау! жоқ. Кез келген нәрсе. Сенімен бәрі жақсы ма. Хехе….
Dialogue: 0,0:02:50.44,0:02:54.47,Default,,0,0,0,,Мм... бұл жақсы.
Dialogue: 0,0:02:54.47,0:02:58.39,Default,,0,0,0,,Мен оны өзім жасадым. Сіз өзіңіз осындай нәрсені жасай аласыз ба?
Dialogue: 0,0:02:58.39,0:03:02.39,Default,,0,0,0,,Бұл оңай. Бұл жай ғана тізбекті тігіс.
Dialogue: 0,0:03:02.39,0:03:04.39,Default,,0,0,0,,Тізбекті тігіс….
Dialogue: 0,0:03:04.39,0:03:07.40,Default,,0,0,0,,Ал...
Dialogue: 0,0:03:07.40,0:03:10.40,Default,,0,0,0,,《«Құс ойыны»! ? 》
Dialogue: 0,0:03:12.40,0:03:15.40,Default,,0,0,0,,《Ақ》
Dialogue: 0,0:03:15.40,0:03:18.41,Default,,0,0,0,,《Түрлі түсті қыздар》
Dialogue: 0,0:03:18.41,0:03:22.41,Default,,0,0,0,,Йосу Мато. Жақсы.
Dialogue: 0,0:03:22.41,0:03:24.41,Default,,0,0,0,,Сәлем Юу. иә?
Dialogue: 0,0:03:24.41,0:03:27.42,Default,,0,0,0,,Құстармен ойнау қандай ойын деп ойлайсыңдар?
Dialogue: 0,0:03:27.42,0:03:29.42,Default,,0,0,0,,Құстармен ойнау? иә.
Dialogue: 0,0:03:29.42,0:03:34.42,Default,,0,0,0,,Құстың аяғына жіңішке шынжырмен орап, шар тәрізді қалқып тұру.
Dialogue: 0,0:03:34.42,0:03:37.43,Default,,0,0,0,,Қатыгездік. Мен енді сөйлескім келмейді.
Dialogue: 0,0:03:37.43,0:03:41.43,Default,,0,0,0,,Сәлем. Мато-сан, басыңды бүкпе.
Dialogue: 0,0:03:41.43,0:03:44.43,Default,,0,0,0,,Бұл мистер Бердплей туралы емес.
Dialogue: 0,0:03:44.43,0:03:47.44,Default,,0,0,0,,Ах! Бірақ тізбекті тігіс! Не?
Dialogue: 0,0:03:47.44,0:03:51.44,Default,,0,0,0,,Бірақ сіз қызыл түсте жақсы көрінесіз. Өйткені ол өте ақ!
Dialogue: 0,0:03:51.44,0:03:53.44,Default,,0,0,0,,Жапон тілінде сұрау.
Dialogue: 0,0:03:53.44,0:03:56.38,Default,,0,0,0,,Ал, не? Сол кішкентай құс ойыны →
Dialogue: 0,0:03:56.38,0:03:58.38,Default,,0,0,0,,Дос болғың келеді.
Dialogue: 0,0:03:58.38,0:04:00.38,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:04:00.38,0:04:04.38,Default,,0,0,0,,Жоқ, бұл дұрыс. Не? Бұл жігіт.
Dialogue: 0,0:04:06.39,0:04:08.39,Default,,0,0,0,,Мен үйдемін...
Dialogue: 0,0:04:16.40,0:04:19.40,Default,,0,0,0,,[Майк] Есеп беру керек пе?
Dialogue: 0,0:04:19.40,0:04:22.40,Default,,0,0,0,,Бір қызық бала болды. [Майк] Иә.
Dialogue: 0,0:04:22.40,0:04:25.47,Default,,0,0,0,,Дөңгелек және дөңгелек тұлға... өрнек өзгерді. [Майк] Бұл жақсы емес.
Dialogue: 0,0:04:25.47,0:04:27.37,Default,,0,0,0,,Мен білемін. [Майк] Өйткені бұл жақсы емес.
Dialogue: 0,0:04:29.41,0:04:32.41,Default,,0,0,0,,♪♪ (мырылдау)
Dialogue: 0,0:04:32.41,0:04:36.42,Default,,0,0,0,,Әпке. Анам маған ванна берді.
Dialogue: 0,0:04:36.42,0:04:40.42,Default,,0,0,0,,Иә... Мен мұны қайтадан оқып жатырмын.
Dialogue: 0,0:04:40.42,0:04:42.42,Default,,0,0,0,,Анам шомылып жатыр... Түсіндім!
Dialogue: 0,0:04:45.43,0:04:48.43,Default,,0,0,0,,《Мен сені кішкентай кезімнен жақсы көремін》
Dialogue: 0,0:04:48.43,0:04:52.43,Default,,0,0,0,,《Түрлі түсті әлемге апаратын кішкентай құс》
Dialogue: 0,0:04:52.43,0:04:55.43,Default,,0,0,0,,《Көк қызғылт сары》
Dialogue: 0,0:04:59.37,0:05:01.38,Default,,0,0,0,,《Қара》
Dialogue: 0,0:05:01.38,0:05:21.40,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:21.40,0:05:32.41,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:32.41,0:05:36.41,Default,,0,0,0,,Бұл... кішкентай құс ойыны...!
Dialogue: 0,0:05:36.41,0:05:39.41,Default,,0,0,0,,Ах... Kotoriyu. Ол «Таканаши» деп оқылады.
Dialogue: 0,0:05:39.41,0:05:43.42,Default,,0,0,0,,«Құс ойынын» жаз. Неліктен бұл Таканаши?
Dialogue: 0,0:05:43.42,0:05:47.42,Default,,0,0,0,,Өйткені кішкентай құстар ойнайтын жерде сұңқар жоқ.
Dialogue: 0,0:05:47.42,0:05:50.42,Default,,0,0,0,,Ах, уау! Ақылды есім!
Dialogue: 0,0:05:50.42,0:05:53.43,Default,,0,0,0,,Хэхехе...
Dialogue: 0,0:05:53.43,0:05:57.36,Default,,0,0,0,,А-а... Которию-сан, сен үйірме жұмыстарымен не істейсің?
Dialogue: 0,0:05:57.36,0:06:00.36,Default,,0,0,0,,Сіз әлі шешім қабылдадыңыз ба? мен….
Dialogue: 0,0:06:02.37,0:06:04.37,Default,,0,0,0,,Мен әлі шешкен жоқпын.
Dialogue: 0,0:06:04.37,0:06:07.37,Default,,0,0,0,,Не болды? Дәретхана.
Dialogue: 0,0:06:07.37,0:06:09.37,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:11.38,0:06:14.38,Default,,0,0,0,,Мен оны әдетте ұнатпаймын.
Dialogue: 0,0:06:14.38,0:06:16.38,Default,,0,0,0,,Мен бұлай жабысқақ болуды жек көремін.
Dialogue: 0,0:06:16.38,0:06:20.39,Default,,0,0,0,,Маған сылтау айтсаң да.
Dialogue: 0,0:06:20.39,0:06:23.39,Default,,0,0,0,,«Асаяке кеңес беру бөлмесі»?
Dialogue: 0,0:06:23.39,0:06:27.39,Default,,0,0,0,,Дұрыс. Уфуфу... Сіз сусын алғыңыз келе ме?
Dialogue: 0,0:06:29.40,0:06:32.40,Default,,0,0,0,,≪Сізге көбірек қант керек пе?
Dialogue: 0,0:06:32.40,0:06:34.40,Default,,0,0,0,,А, иә.
Dialogue: 0,0:06:34.40,0:06:38.41,Default,,0,0,0,,Мм... міне? Ұстазыңыз айтпады ма?
Dialogue: 0,0:06:38.41,0:06:41.41,Default,,0,0,0,,Егер сізді мазалаған мәселелер болса, осы жерден сұрай аласыз.
Dialogue: 0,0:06:41.41,0:06:44.41,Default,,0,0,0,,Бұл адам кеңесші. уайымдайды?\NБұл
Dialogue: 0,0:06:44.41,0:06:49.42,Default,,0,0,0,,. Кіші мектеп оқушысы болған кезде көп нәрсе ойға оралады →
Dialogue: 0,0:06:49.42,0:06:52.42,Default,,0,0,0,,Мазасыздық. Хмм, солай ма? Мен оны дұрыс түсінбеймін.
Dialogue: 0,0:06:52.42,0:06:54.44,Default,,0,0,0,,, солай ма? Апыр-ай!
Dialogue: 0,0:06:54.44,0:06:57.36,Default,,0,0,0,,Иә. Қант. Рақмет сізге….
Dialogue: 0,0:06:57.36,0:07:00.36,Default,,0,0,0,,Ешқандай уайымға салынбау өте жақсы нәрсе.
Dialogue: 0,0:07:00.36,0:07:02.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:02.36,0:07:06.37,Default,,0,0,0,,Сұрақтарыңыз болса, қайта келіңіз.
Dialogue: 0,0:07:06.37,0:07:10.37,Default,,0,0,0,,Тіпті жай ғана кофе ішу. (Ю Мато) Иә!
Dialogue: 0,0:07:10.37,0:07:12.37,Default,,0,0,0,,Сәлем! Жылдамдықты арттырыңыз! →
Dialogue: 0,0:07:12.37,0:07:15.38,Default,,0,0,0,,Сандарыңызды көтеріңіз!
Dialogue: 0,0:07:15.38,0:07:20.38,Default,,0,0,0,,Сынақ клубына кіргеннен кейін кенет серуендеу. Бұл орта мектептің сапасы ма?
Dialogue: 0,0:07:20.38,0:07:23.38,Default,,0,0,0,,Сәлем! Келесі - Токайдоға саяхат! →
Dialogue: 0,0:07:23.38,0:07:26.39,Default,,0,0,0,,Секір! (мүшелер) Иә!
Dialogue: 0,0:07:26.39,0:07:29.39,Default,,0,0,0,,Сонымен, мен әр баладан екі кровиз салуды тапсырамын.
Dialogue: 0,0:07:29.39,0:07:31.39,Default,,0,0,0,,≪Файт О! (Директор) Алдымен екі адамнан жұптасып алайық →
Dialogue: 0,0:07:31.39,0:07:34.40,Default,,0,0,0,,Болыңыз. Бірінен соң бірі үлгі болыңыз →
Dialogue: 0,0:07:34.40,0:07:38.40,Default,,0,0,0,,Кезекпен сурет салыңыз. Әдемі...
Dialogue: 0,0:07:38.40,0:07:41.40,Default,,0,0,0,,Мен өзімді жаман сезініп тұрмын... Тым толқыдым. →
Dialogue: 0,0:07:41.40,0:07:45.41,Default,,0,0,0,,Бір рет құсқан дұрыс. Маған құсу ұнамайды.
Dialogue: 0,0:07:45.41,0:07:47.41,Default,,0,0,0,,Сәлем. рақмет сізге.
Dialogue: 0,0:07:47.41,0:07:49.41,Default,,0,0,0,,Сонымен, егер сіз менеджер болғыңыз келсе →
Dialogue: 0,0:07:49.41,0:07:51.41,Default,,0,0,0,,Осыдан кейін түсініктеме болады. Иә.
Dialogue: 0,0:07:53.41,0:07:56.35,Default,,0,0,0,,Ах... Жеңіл күріш жақсы.
Dialogue: 0,0:07:56.35,0:07:58.35,Default,,0,0,0,,Карри! ? Жоқ!
Dialogue: 0,0:07:58.35,0:08:01.36,Default,,0,0,0,,Карри болса, жеймін! Ах.
Dialogue: 0,0:08:01.36,0:08:03.36,Default,,0,0,0,,Аа... Кешіріңіз. Уф. карри.
Dialogue: 0,0:08:03.36,0:08:05.36,Default,,0,0,0,,Иә, өтінемін. жақсы.
Dialogue: 0,0:08:07.36,0:08:09.36,Default,,0,0,0,,Ах. бұл….
Dialogue: 0,0:08:09.36,0:08:11.37,Default,,0,0,0,,Не? «Котори Тори әртүрлі түстер»
Dialogue: 0,0:08:11.37,0:08:13.37,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:08:13.37,0:08:15.37,Default,,0,0,0,,А, мен де. Апыр-ай!
Dialogue: 0,0:08:15.37,0:08:17.37,Default,,0,0,0,,Коториторидің күту режимі!
Dialogue: 0,0:08:17.37,0:08:19.37,Default,,0,0,0,,Иә! ? Бұл қайда болды?
Dialogue: 0,0:08:19.37,0:08:23.38,Default,,0,0,0,,Бұл мен өзім салған нәрсе. өтірік! ? таңқаларлық!
Dialogue: 0,0:08:23.38,0:08:27.38,Default,,0,0,0,,Аа, бірақ дұрыс айтасыз. Бұл сурет сурет кітабында жоқ еді.
Dialogue: 0,0:08:27.38,0:08:30.38,Default,,0,0,0,,Сізде бірінші басылым емес шығар?
Dialogue: 0,0:08:30.38,0:08:32.39,Default,,0,0,0,,Бірінші басылымда бұл сурет бар ма?
Dialogue: 0,0:08:32.39,0:08:36.39,Default,,0,0,0,,Иә. Қақпағы әртүрлі. Ха! Бұл дұрыс! ?
Dialogue: 0,0:08:36.39,0:08:38.39,Default,,0,0,0,,Мен оны көргім келеді! Ах...
Dialogue: 0,0:08:42.40,0:08:44.40,Default,,0,0,0,,Қарап алғыңыз келе ме? иә?
Dialogue: 0,0:08:44.40,0:08:47.40,Default,,0,0,0,,Өйткені ол біздің үйде бар. Бірінші басылым.
Dialogue: 0,0:08:47.40,0:08:49.40,Default,,0,0,0,,Ах...! Хехе.
Dialogue: 0,0:08:52.41,0:08:54.43,Default,,0,0,0,,≪(есіктің ашылу дыбысы)
Dialogue: 0,0:08:54.43,0:08:59.43,Default,,0,0,0,,Уау, өте кең. Бұл керемет! Мен тіпті баскетбол ойнай аламын деп ойлаймын!
Dialogue: 0,0:09:02.35,0:09:06.35,Default,,0,0,0,,Не болды? иә? Жоқ, ештеңе емес.
Dialogue: 0,0:09:06.35,0:09:08.36,Default,,0,0,0,,Ах, міне...
Dialogue: 0,0:09:08.36,0:09:18.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:18.37,0:09:21.37,Default,,0,0,0,,Уау! Күткендей, бұл керемет!
Dialogue: 0,0:09:21.37,0:09:24.37,Default,,0,0,0,,Қаласаң, беремін. иә? Жарайды ма?
Dialogue: 0,0:09:24.37,0:09:27.37,Default,,0,0,0,,Иә. Тек қайта жасаңыз.
Dialogue: 0,0:09:27.37,0:09:31.38,Default,,0,0,0,,Рахмет. Ахаха.
Dialogue: 0,0:09:31.38,0:09:33.38,Default,,0,0,0,,Уууу. ≪
Dialogue: 0,0:09:33.38,0:09:36.38,Default,,0,0,0,,≪
Dialogue: 0,0:09:36.38,0:09:38.39,Default,,0,0,0,,Тұтынушы? аа….
Dialogue: 0,0:09:38.39,0:09:40.39,Default,,0,0,0,,≪
Dialogue: 0,0:09:40.39,0:09:42.39,Default,,0,0,0,,≪(Йомидің анасы) Йоми? Кагари-чан...
Dialogue: 0,0:09:42.39,0:09:45.39,Default,,0,0,0,,О... күте тұрыңыз! әлі…. Которию-сан...?
Dialogue: 0,0:09:45.39,0:09:47.39,Default,,0,0,0,,Күте тұрыңыз! !
Dialogue: 0,0:09:52.40,0:09:54.37,Default,,0,0,0,,Сәлеметсіз бе. Кагари...
Dialogue: 0,0:09:54.37,0:09:58.24,Default,,0,0,0,,Сәлеметсіз бе. Йоми осылай жасады.
Dialogue: 0,0:09:58.24,0:10:01.66,Default,,0,0,0,,Не? Йоми жасады.
Dialogue: 0,0:10:09.91,0:10:11.46,Default,,0,0,0,,Тамақтану. Макарон.
Dialogue: 0,0:10:11.53,0:10:13.53,Default,,0,0,0,,А, рахмет.
Dialogue: 0,0:10:13.53,0:10:16.53,Default,,0,0,0,,Қоңыр тағам. Мен мұны ұнатамын.
Dialogue: 0,0:10:19.54,0:10:21.54,Default,,0,0,0,,Дәмді! Додом түсі.
Dialogue: 0,0:10:21.54,0:10:23.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:23.54,0:10:25.54,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:10:25.54,0:10:28.54,Default,,0,0,0,,Түссіз түстер. Ах...
Dialogue: 0,0:10:32.55,0:10:35.55,Default,,0,0,0,,Қызғылт түс – оқу.
Dialogue: 0,0:10:35.55,0:10:37.56,Default,,0,0,0,,Кагалли қызыл!
Dialogue: 0,0:10:37.56,0:10:39.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:39.56,0:10:41.56,Default,,0,0,0,,Қалай болғанда да лас түс.
Dialogue: 0,0:10:45.56,0:10:47.57,Default,,0,0,0,,Курои мырза.
Dialogue: 0,0:10:47.57,0:10:49.57,Default,,0,0,0,,А, өзіңді қатты итерме...
Dialogue: 0,0:10:49.57,0:10:52.57,Default,,0,0,0,,Жоқ. Мен жеймін.
Dialogue: 0,0:10:58.58,0:11:02.60,Default,,0,0,0,,Уау! Өте егжей-тегжейлі!
Dialogue: 0,0:11:02.60,0:11:04.52,Default,,0,0,0,,Торт кілегеймен бұралған!
Dialogue: 0,0:11:04.52,0:11:08.52,Default,,0,0,0,,Иә. Сіз бұлсыз.
Dialogue: 0,0:11:10.52,0:11:13.52,Default,,0,0,0,,Ка... Сүйкімді.
Dialogue: 0,0:11:16.53,0:11:19.53,Default,,0,0,0,,Ах.
Dialogue: 0,0:11:19.53,0:11:21.53,Default,,0,0,0,,Сәлем Мэри.
Dialogue: 0,0:11:21.53,0:11:24.54,Default,,0,0,0,,Бұл адам қанша уақыт қалады?
Dialogue: 0,0:11:24.54,0:11:28.54,Default,,0,0,0,,Не? Сіз әлі үйге бармайсыз ба?
Dialogue: 0,0:11:28.54,0:11:32.54,Default,,0,0,0,,Kaeere. Kaeere.
Dialogue: 0,0:11:32.54,0:11:34.55,Default,,0,0,0,,Kaeere. Кагари...
Dialogue: 0,0:11:34.55,0:11:38.55,Default,,0,0,0,,Бұл Кагаллидің айтқаны емес. Мэри осылай дейді.
Dialogue: 0,0:11:38.55,0:11:45.56,Default,,0,0,0,,...
Dialogue: 0,0:11:45.56,0:11:48.56,Default,,0,0,0,,Kaeere. Ка….
Dialogue: 0,0:11:50.56,0:11:53.56,Default,,0,0,0,,Олай болса, рахмет.
Dialogue: 0,0:11:53.56,0:11:56.56,Default,,0,0,0,,Олай болса... Иә.
Dialogue: 0,0:12:10.52,0:12:13.52,Default,,0,0,0,,《Қорқынышты...》
Dialogue: 0,0:12:13.52,0:12:16.52,Default,,0,0,0,,《Қорқынышты! 》
Dialogue: 0,0:12:16.52,0:12:18.52,Default,,0,0,0,,《Мына бала қорқынышты》
Dialogue: 0,0:12:22.53,0:12:24.53,Default,,0,0,0,,≪(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:28.53,0:12:30.54,Default,,0,0,0,,Мато? Карри ше?
Dialogue: 0,0:12:30.54,0:12:32.54,Default,,0,0,0,,Қажет емес! Иә?
Dialogue: 0,0:12:32.54,0:12:35.54,Default,,0,0,0,,Не? қазірдің өзінде.
Dialogue: 0,0:12:37.54,0:12:43.55,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:12:43.55,0:12:46.55,Default,,0,0,0,,《Неге олайсың...》
Dialogue: 0,0:12:46.55,0:12:48.55,Default,,0,0,0,,《Неге макарондар...》
Dialogue: 0,0:12:48.55,0:12:50.55,Default,,0,0,0,,《Неге...》
Dialogue: 0,0:12:52.56,0:12:56.56,Default,,0,0,0,,Мен бірдеңені дұрыс істемедім бе деп ойлаймын...
Dialogue: 0,0:12:56.56,0:13:00.56,Default,,0,0,0,,(Хироко) Мұндай ақымақ нәрселерге алаңдама →
Dialogue: 0,0:13:03.50,0:13:06.50,Default,,0,0,0,,Которию мырза….
Dialogue: 0,0:13:06.50,0:13:08.51,Default,,0,0,0,,≪(есіктің ашылу дыбысы)
Dialogue: 0,0:13:08.51,0:13:23.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:23.52,0:13:29.53,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:29.53,0:13:32.53,Default,,0,0,0,,[Майк] Мен жоқ дедім. →
Dialogue: 0,0:13:32.53,0:13:38.54,Default,,0,0,0,,Йоми Кагаллидікі, сондықтан ол үшін жауапкершілікті өз мойнына алу керек. →
Dialogue: 0,0:13:38.54,0:13:42.54,Default,,0,0,0,,Сіз мұны білесіз бе? Мен түссіндім.
Dialogue: 0,0:13:44.54,0:13:46.54,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:14:26.52,0:14:41.53,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:41.53,0:14:47.54,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:47.54,0:14:54.55,Default,,0,0,0,,...
Dialogue: 0,0:14:54.55,0:15:01.55,Default,,0,0,0,,...
Dialogue: 0,0:15:01.55,0:15:03.49,Default,,0,0,0,,Kaeere….
Dialogue: 0,0:15:03.49,0:15:23.51,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:23.51,0:15:43.53,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:43.53,0:16:03.48,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:03.48,0:16:10.49,Default,,0,0,0,,...
Dialogue: 0,0:16:10.49,0:16:18.50,Default,,0,0,0,,Kaeere. Kaeere. Kaeere. Каир….
Dialogue: 0,0:16:18.50,0:16:20.50,Default,,0,0,0,,Қайырлы таң. (Оқушы) Қайырлы таң.
Dialogue: 0,0:16:32.51,0:16:34.51,Default,,0,0,0,,≪(аяқ дыбысы)
Dialogue: 0,0:16:34.51,0:16:36.51,Default,,0,0,0,,Ах. (Оқушы) Эй, Курой-сан.
Dialogue: 0,0:16:36.51,0:16:38.52,Default,,0,0,0,,Вокзал алдындағы қасиетті жерде мереке болатынын білесіз бе?
Dialogue: 0,0:16:38.52,0:16:41.52,Default,,0,0,0,,Иә. Менің сыныбымдағы кейбір қыздар →
Dialogue: 0,0:16:41.52,0:16:44.52,Default,,0,0,0,,Бірге жиналайық. мыс?
Dialogue: 0,0:16:44.52,0:16:47.53,Default,,0,0,0,,Мен... Мен.
Dialogue: 0,0:16:47.53,0:16:50.53,Default,,0,0,0,,Ах.
Dialogue: 0,0:16:50.53,0:16:53.53,Default,,0,0,0,,Ах. Мен... менде бәрі жақсы.
Dialogue: 0,0:16:53.53,0:16:55.53,Default,,0,0,0,,Ех! (Оқушы) Кеттік.
Dialogue: 0,0:16:55.53,0:16:58.54,Default,,0,0,0,,Бұл да тапсырма ма? (Оқушы) Менің ойымша, бұл қызық.
Dialogue: 0,0:16:58.54,0:17:00.54,Default,,0,0,0,,Сәлем. (Оқушы) Жақсы емес пе?
Dialogue: 0,0:17:00.54,0:17:04.48,Default,,0,0,0,,Сонымен… қанша →
Dialogue: 0,0:17:04.48,0:17:08.48,Default,,0,0,0,,Оңаша қалғанда жақсы сөйлесе алмаймыз деп ойлаймын.
Dialogue: 0,0:17:08.48,0:17:11.48,Default,,0,0,0,,Сен маған айтшы, Обата-кун.
Dialogue: 0,0:17:11.48,0:17:14.49,Default,,0,0,0,,Бұл оңай емес. қазірдің өзінде.
Dialogue: 0,0:17:14.49,0:17:16.49,Default,,0,0,0,,≪(Есіктің ашылған дыбысы) Дәл мұғалім сияқты→
Dialogue: 0,0:17:16.49,0:17:20.49,Default,,0,0,0,,Егер кеудеңіз бос болса... а....
Dialogue: 0,0:17:20.49,0:17:23.49,Default,,0,0,0,,Обата... Сенпай? Гайя! 1 жыл!
Dialogue: 0,0:17:23.49,0:17:25.50,Default,,0,0,0,,Ал, кететін уақыт келді!
Dialogue: 0,0:17:25.50,0:17:30.50,Default,,0,0,0,,Айтпа, Сая-чан! құпия!
Dialogue: 0,0:17:32.50,0:17:37.50,Default,,0,0,0,,Сәлем. Бірден уайымдайсыз ба?
Dialogue: 0,0:17:39.51,0:17:45.52,Default,,0,0,0,,Мен көремін. Сіз мені жек көрдіңіз бе деп ойлайсыз ба?
Dialogue: 0,0:17:45.52,0:17:49.52,Default,,0,0,0,,Ым, бұл Курой-кун, солай ма?
Dialogue: 0,0:17:51.52,0:17:57.53,Default,,0,0,0,,Мен сені алғаш көргенде солай ойладым.
Dialogue: 0,0:17:57.53,0:18:01.53,Default,,0,0,0,,Оның көздері өте әдемі. иә?
Dialogue: 0,0:18:01.53,0:18:08.47,Default,,0,0,0,,Мүмкін. Адамдар ешқашан жек көрмейтін немесе жек көрмеген көздер.
Dialogue: 0,0:18:08.47,0:18:10.47,Default,,0,0,0,,Міне...
Dialogue: 0,0:18:10.47,0:18:13.48,Default,,0,0,0,,Жау жасамаған жақсы.
Dialogue: 0,0:18:13.48,0:18:17.48,Default,,0,0,0,,Бірақ сіз білмей жау жасауға да болады→
Dialogue: 0,0:18:17.48,0:18:20.48,Default,,0,0,0,,Жалпы мағына. Бұл анық па?
Dialogue: 0,0:18:20.48,0:18:23.49,Default,,0,0,0,,Иә, бәрі біледі.
Dialogue: 0,0:18:23.49,0:18:27.49,Default,,0,0,0,,Егер сіз жай ғана анық нәрсені қабылдасаңыз, жақсы.
Dialogue: 0,0:18:29.49,0:18:33.50,Default,,0,0,0,,Сіздің кеудеңіз ауырады.
Dialogue: 0,0:18:33.50,0:18:38.50,Default,,0,0,0,,Бірақ кеудем шаншып ауырса да →
Dialogue: 0,0:18:38.50,0:18:40.57,Default,,0,0,0,,Қан атқылауы мүмкін →
Dialogue: 0,0:18:40.57,0:18:44.51,Default,,0,0,0,,Жара ісінбейді.
Dialogue: 0,0:18:44.51,0:18:50.51,Default,,0,0,0,,Сен үшін ауыртпалықты біреу алады.
Dialogue: 0,0:18:50.51,0:18:53.52,Default,,0,0,0,,Біреу? Иә.
Dialogue: 0,0:18:53.52,0:18:55.52,Default,,0,0,0,,Ендеше, жарайды.
Dialogue: 0,0:18:55.52,0:18:59.52,Default,,0,0,0,,Қанша ауырса да, ауырса да→
Dialogue: 0,0:18:59.52,0:19:04.46,Default,,0,0,0,,Шынымен ренжітетін сен емессің.
Dialogue: 0,0:19:04.46,0:19:09.47,Default,,0,0,0,,Сонымен қант. Көбірек салайын ба?
Dialogue: 0,0:19:09.47,0:19:14.47,Default,,0,0,0,,《Біреу... менің ауырғанымды алады》
Dialogue: 0,0:19:14.47,0:19:18.48,Default,,0,0,0,,《Бұл кім? 》
Dialogue: 0,0:19:18.48,0:19:20.48,Default,,0,0,0,,≪(Директор) Сіз тағы да қаласыз ба? ≪Иә.
Dialogue: 0,0:19:20.48,0:19:23.48,Default,,0,0,0,,Кешіктірме. ≪Иә.
Dialogue: 0,0:19:26.48,0:19:28.49,Default,,0,0,0,,Өнер бөлімі….
Dialogue: 0,0:19:28.49,0:19:31.49,Default,,0,0,0,,Сіз енгіздіңіз.
Dialogue: 0,0:19:33.49,0:19:37.50,Default,,0,0,0,,Күткендей, сіз мұны жақсы білесіз! Сіз түсіндіңіз.
Dialogue: 0,0:19:37.50,0:19:43.50,Default,,0,0,0,,Менімен дос болуға тырыссаң да... мүмкін емес. сондықтан….
Dialogue: 0,0:19:43.50,0:19:45.50,Default,,0,0,0,,Фестиваль! иә?
Dialogue: 0,0:19:45.50,0:19:49.51,Default,,0,0,0,,Бірге барайық! О... фестиваль.
Dialogue: 0,0:19:49.51,0:19:51.51,Default,,0,0,0,,Жоқ. Неліктен?
Dialogue: 0,0:19:51.51,0:19:54.51,Default,,0,0,0,,Өйткені... бұл мүмкін емес.
Dialogue: 0,0:19:54.51,0:19:57.52,Default,,0,0,0,,Сен тек Курой-санды ренжітесің.
Dialogue: 0,0:19:57.52,0:19:59.52,Default,,0,0,0,,Бұл зиян тигізбейді!
Dialogue: 0,0:19:59.52,0:20:01.52,Default,,0,0,0,,Қанша ауырса да →
Dialogue: 0,0:20:01.52,0:20:05.52,Default,,0,0,0,,Мен шынымен зардап шеккен жоқпын!
Dialogue: 0,0:20:05.52,0:20:07.53,Default,,0,0,0,,Курои мырза.
Dialogue: 0,0:20:07.53,0:20:11.53,Default,,0,0,0,,Ендеше кеттік! ойнайық! а….
Dialogue: 0,0:20:11.53,0:20:14.53,Default,,0,0,0,,Әртүрлі нәрселерді бірге көрейік!
Dialogue: 0,0:20:17.54,0:20:21.54,Default,,0,0,0,,Әр түрлі заттар... әр түрлі заттар.
Dialogue: 0,0:20:26.54,0:20:29.55,Default,,0,0,0,,«Әртүрлі әлемдер»
Dialogue: 0,0:20:29.55,0:20:49.57,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:49.57,0:21:03.51,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:03.51,0:21:06.52,Default,,0,0,0,,«Ол теңізге жіберілді...»
Dialogue: 0,0:21:06.52,0:21:10.52,Default,,0,0,0,,«Сора но Ао»
Dialogue: 0,0:21:10.52,0:21:15.52,Default,,0,0,0,,«Эсора но Аоно Сора но Уми»
Dialogue: 0,0:21:19.53,0:21:21.53,Default,,0,0,0,,«Намида но Аони»
Dialogue: 0,0:21:23.53,0:21:25.54,Default,,0,0,0,,«Котори ұшуы»
Dialogue: 0,0:21:25.54,0:21:35.54,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:12.50,0:25:17.50,Default,,0,0,0,,Барлық студенттер геномдық резонанс индексі негізінде А-дан F-ға дейін бағаланады →
Dialogue: 0,0:25:17.50,0:25:20.50,Default,,0,0,0,,Жоғарыда сіз билік етесіз. →
Dialogue: 0,0:25:20.50,0:25:23.50,Default,,0,0,0,,Былайша айтқанда, бұл Void ранг жүйесі.
Dialogue: 0,0:25:25.51,0:25:29.51,Default,,0,0,0,,Ауырды, ауырады, ұшады!
Dialogue: 0,0:25:35.52,0:25:37.52,Default,,0,0,0,,Оу!
Dialogue: 0,0:25:39.02,0:25:45.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
