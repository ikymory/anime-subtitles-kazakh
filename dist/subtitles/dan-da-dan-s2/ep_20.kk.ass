Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.30,0:00:15.09,Default,,0,0,0,,(аспаптық дыбыс)
Dialogue: 0,0:00:15.18,0:00:17.97,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:00:18.06,0:00:21.31,Default,,0,0,0,,Менің оркестрімде лас дыбыс шығаратын жігіт
Dialogue: 0,0:00:21.39,0:00:23.52,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:00:24.98,0:00:28.40,Default,,0,0,0,,Мен... Мен мұнда емеспін. Үйге баруым керек пе?
Dialogue: 0,0:00:28.48,0:00:30.65,Default,,0,0,0,,Иә... дұрыс па?
Dialogue: 0,0:00:30.74,0:00:32.19,Default,,0,0,0,,Мына жігіттер!
Dialogue: 0,0:00:33.86,0:00:35.61,Default,,0,0,0,,-Эхехехе... -Хехехехе...
Dialogue: 0,0:00:35.70,0:00:36.95,Default,,0,0,0,,Мына жігіттер!
Dialogue: 0,0:00:37.74,0:00:40.29,Default,,0,0,0,,Балалар!
Dialogue: 0,0:00:42.50,0:00:44.25,Default,,0,0,0,,Не? ағымдағы шабуыл
Dialogue: 0,0:00:44.33,0:00:45.17,Default,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:00:45.25,0:00:50.25,Default,,0,0,0,,(Скрипка дыбысы)
Dialogue: 0,0:00:58.01,0:01:00.93,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:01:12.36,0:01:13.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:13.28,0:01:14.49,Default,,0,0,0,,Такакура мырза!
Dialogue: 0,0:01:14.57,0:01:16.20,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:01:16.28,0:01:17.53,Default,,0,0,0,,Гах...
Dialogue: 0,0:01:17.62,0:01:20.53,Default,,0,0,0,,Мына ақымақтан құтыл! (БэмБэмнің күлкісі)
Dialogue: 0,0:01:20.53,0:01:23.16,Default,,0,0,0,,(БэмБэмнің күлкісі)
Dialogue: 0,0:01:23.25,0:01:25.75,Default,,0,0,0,,Әсіресе демалыс кезінде ұстамаңыз.
Dialogue: 0,0:01:25.83,0:01:28.17,Default,,0,0,0,,Сіз қозғала алмайсыз.
Dialogue: 0,0:01:28.25,0:01:31.21,Default,,0,0,0,,Мен саған ұсталма деп айтсам да...
Dialogue: 0,0:01:31.30,0:01:35.59,Default,,0,0,0,,Мен мұндай тосқауылдан қалай құтыламын!
Dialogue: 0,0:01:37.01,0:01:38.59,Default,,0,0,0,,♪~
Dialogue: 0,0:03:02.97,0:03:06.97,Default,,0,0,0,,~♪
Dialogue: 0,0:03:07.06,0:03:11.48,Default,,0,0,0,,«Симфония №6 пастораль» Ей!
Dialogue: 0,0:03:11.56,0:03:16.23,Default,,0,0,0,,(Өнімділік)
Dialogue: 0,0:03:16.32,0:03:17.57,Default,,0,0,0,,Бұл күріш алқабы!
Dialogue: 0,0:03:17.65,0:03:19.19,Default,,0,0,0,,Үйге қайт...
Dialogue: 0,0:03:19.28,0:03:21.99,Default,,0,0,0,,Концентрат! Музыкалық ноталар ұшады!
Dialogue: 0,0:03:22.07,0:03:24.62,Default,,0,0,0,,Бұл күріш алқабы емес!
Dialogue: 0,0:03:24.70,0:03:26.95,Default,,0,0,0,,Өл, шошқа!
Dialogue: 0,0:03:27.04,0:03:28.91,Default,,0,0,0,,Тосқауылдан қашыңыз!
Dialogue: 0,0:03:33.50,0:03:36.84,Default,,0,0,0,,Сәлем! Мен жақсы жүгіре алмаймын, өйткені мен аяғыма жабысып қалдым!
Dialogue: 0,0:03:36.92,0:03:38.42,Default,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:03:39.30,0:03:40.80,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:03:41.68,0:03:43.89,Default,,0,0,0,,Өлме!
Dialogue: 0,0:03:43.97,0:03:45.93,Default,,0,0,0,,Гатанго үні
Dialogue: 0,0:03:46.01,0:03:48.31,Default,,0,0,0,,6-платформа пойыз кіреді
Dialogue: 0,0:03:48.39,0:03:50.35,Default,,0,0,0,,Тәкір! Тәкір!
Dialogue: 0,0:03:50.43,0:03:53.90,Default,,0,0,0,,Ото-сан! Ото-сан!
Dialogue: 0,0:03:53.98,0:03:56.19,Default,,0,0,0,,Әкең туралы жай айтпа!
Dialogue: 0,0:03:56.27,0:03:58.23,Default,,0,0,0,,Мен де кереметпін!
Dialogue: 0,0:03:58.32,0:03:59.78,Default,,0,0,0,,Сіз кешіктіңіз!
Dialogue: 0,0:03:59.86,0:04:05.37,Default,,0,0,0,,Көбірек шах! Жылдамдығыңызды арттырыңыз!
Dialogue: 0,0:04:10.50,0:04:13.33,Default,,0,0,0,,Фухахахахахаха~!
Dialogue: 0,0:04:13.42,0:04:15.21,Default,,0,0,0,,Өл!
Dialogue: 0,0:04:15.29,0:04:17.84,Default,,0,0,0,,Өл, өл, өл!
Dialogue: 0,0:04:17.92,0:04:19.67,Default,,0,0,0,,Бұл керемет, Исла-чан
Dialogue: 0,0:04:19.76,0:04:20.84,Default,,0,0,0,,Барлығын айналып өтіңіз
Dialogue: 0,0:04:20.92,0:04:22.68,Default,,0,0,0,,Бұл таңданатын уақыт емес!
Dialogue: 0,0:04:22.76,0:04:25.22,Default,,0,0,0,,Осылайша сіз одан құтыласыз!
Dialogue: 0,0:04:25.30,0:04:26.14,Default,,0,0,0,,(өткір соққы дыбысы)
Dialogue: 0,0:04:26.22,0:04:29.31,Default,,0,0,0,,Ита! Уау, бұл дауыс біртүрлі!
Dialogue: 0,0:04:29.39,0:04:31.35,Default,,0,0,0,,Бұл тітіркендіргіш!
Dialogue: 0,0:04:33.85,0:04:36.61,Default,,0,0,0,,Қарғыс атсын... Мүмкіндік жоқ!
Dialogue: 0,0:04:40.15,0:04:43.45,Default,,0,0,0,,Өл, өл, өл, өл!
Dialogue: 0,0:04:43.53,0:04:45.91,Default,,0,0,0,,Өл!
Dialogue: 0,0:04:47.53,0:04:48.37,Default,,0,0,0,,Уф
Dialogue: 0,0:04:49.79,0:04:52.04,Default,,0,0,0,,Уф... Мен қозғала алмаймын...
Dialogue: 0,0:04:52.12,0:04:53.46,Default,,0,0,0,,Бұл сұмдық!
Dialogue: 0,0:04:53.54,0:04:56.13,Default,,0,0,0,,Қалғандарға абай бол дедім...
Dialogue: 0,0:04:56.96,0:04:57.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:58.92,0:05:01.30,Default,,0,0,0,,Иә! Өлді!
Dialogue: 0,0:05:01.38,0:05:02.76,Default,,0,0,0,,Такакура мырза!
Dialogue: 0,0:05:02.84,0:05:04.47,Default,,0,0,0,,Гррр…
Dialogue: 0,0:05:09.76,0:05:13.18,Default,,0,0,0,,Сен де өлуің керек! Қарғыс атсын, қорқақ! Төмен түсу!
Dialogue: 0,0:05:13.18,0:05:14.14,Default,,0,0,0,,Қарғыс атсын, қорқақ! Төмен түсу!
Dialogue: 0,0:05:15.19,0:05:18.81,Default,,0,0,0,,(Окалунның жөтелі)
Dialogue: 0,0:05:20.32,0:05:21.69,Default,,0,0,0,,Бұл қате болса да Ширатори мырза керемет
Dialogue: 0,0:05:21.69,0:05:23.36,Default,,0,0,0,,Ширатори мырза керемет Бұл қате болса да!
Dialogue: 0,0:05:23.44,0:05:25.20,Default,,0,0,0,,Тек өл!
Dialogue: 0,0:05:25.28,0:05:27.91,Default,,0,0,0,,Джибунға не болды...
Dialogue: 0,0:05:27.99,0:05:30.03,Default,,0,0,0,,Түрлі күшті жауларға қарсы шықтым.
Dialogue: 0,0:05:30.12,0:05:33.16,Default,,0,0,0,,Мен аздап күштірек болдым деп ойладым, бірақ...
Dialogue: 0,0:05:31.37,0:05:33.16,Default,,0,0,0,,Буха!
Dialogue: 0,0:05:33.25,0:05:37.58,Default,,0,0,0,,Мүлдем емес... Джибун мүлде...
Dialogue: 0,0:05:37.67,0:05:38.50,Default,,0,0,0,,Құт
Dialogue: 0,0:05:38.58,0:05:41.63,Default,,0,0,0,,Қыңылдауға уақыт жоқ болса, денеңді қозғалт!
Dialogue: 0,0:05:41.71,0:05:43.96,Default,,0,0,0,,Ырғақ сезімі! Ритм сезімі!
Dialogue: 0,0:05:42.17,0:05:43.96,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:05:48.64,0:05:50.85,Default,,0,0,0,,Бұл әлі жалғасуда.
Dialogue: 0,0:05:50.93,0:05:54.93,Default,,0,0,0,,Әлгі қарғыс атқан әйелден қашанға дейін аулақ жүретінімді білмеймін.
Dialogue: 0,0:05:55.02,0:05:58.19,Default,,0,0,0,,Олардың ойынын түсінудің қажеті жоқ.
Dialogue: 0,0:05:58.27,0:06:02.44,Default,,0,0,0,,Өзіңіз білетін кез келген музыканы есте сақтаңыз!
Dialogue: 0,0:06:02.52,0:06:06.20,Default,,0,0,0,,Денеңізді сол ырғақ сезімімен қозғалтып көріңіз!
Dialogue: 0,0:06:06.28,0:06:08.41,Default,,0,0,0,,Сіз мұны айтқан болсаңыз да...
Dialogue: 0,0:06:08.49,0:06:12.83,Default,,0,0,0,,Джибун... Мен музыканы мүлде тыңдамаймын, сондықтан білмеймін.
Dialogue: 0,0:06:17.46,0:06:18.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:18.37,0:06:19.54,Default,,0,0,0,,бар...
Dialogue: 0,0:06:19.63,0:06:22.21,Default,,0,0,0,,Жақында мен музыка тыңдадым...
Dialogue: 0,0:06:23.55,0:06:25.55,Default,,0,0,0,,Мен қатты әсер еттім...
Dialogue: 0,0:06:26.22,0:06:28.09,Default,,0,0,0,,Ырғаққа кірді
Dialogue: 0,0:06:31.64,0:06:35.27,Default,,0,0,0,,Жүгіріп жүрме, қарғыс атсын!
Dialogue: 0,0:06:36.64,0:06:38.52,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:06:38.60,0:06:40.23,Default,,0,0,0,,Шашымды ұзартқым келсе де
Dialogue: 0,0:06:40.31,0:06:42.86,Default,,0,0,0,,Жазбаны басыңыз, ол оларға жетпейді!
Dialogue: 0,0:06:50.03,0:06:51.03,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:53.62,0:06:54.62,Default,,0,0,0,,Әй
Dialogue: 0,0:06:55.33,0:06:56.33,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:56.87,0:06:58.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:59.04,0:06:59.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:00.96,0:07:04.67,Default,,0,0,0,,Ол аздап өсірілген сияқты.
Dialogue: 0,0:07:05.96,0:07:07.92,Default,,0,0,0,,Бұл сіздің қашып бара жатқаныңыз үшін!
Dialogue: 0,0:07:08.01,0:07:08.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:08.92,0:07:10.47,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:07:10.55,0:07:13.14,Default,,0,0,0,,♪~
Dialogue: 0,0:07:13.22,0:07:17.31,Default,,0,0,0,,Көңіл-күйлеріңіз көтеріңкі болсын!
Dialogue: 0,0:07:17.39,0:07:18.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:19.10,0:07:20.69,Default,,0,0,0,,Такакура мырза...
Dialogue: 0,0:07:20.77,0:07:23.40,Default,,0,0,0,,Кішкентай жырау!
Dialogue: 0,0:07:23.48,0:07:26.40,Default,,0,0,0,,Өл, өл, өл, өл!
Dialogue: 0,0:07:28.07,0:07:30.90,Default,,0,0,0,,Өл!
Dialogue: 0,0:07:38.00,0:07:39.29,Default,,0,0,0,,♪ Аңшылық жан
Dialogue: 0,0:07:39.37,0:07:43.29,Default,,0,0,0,,♪ Құрбандық іздеуді жалғастыру
Dialogue: 0,0:07:43.38,0:07:46.13,Default,,0,0,0,,Сооо! Міне бітті! ♪ Аңшылық жан, бүгін түнде де дірілдеп ұйқы
Dialogue: 0,0:07:46.13,0:07:48.26,Default,,0,0,0,,♪ Аңшы жан, бүгін түнде де ұйқың қалтырап ♪ Аңшылық жан, бүгін түнде де дірілдеп ұйқы Қарғыс атсын!
Dialogue: 0,0:07:48.26,0:07:48.76,Default,,0,0,0,,♪ Аңшылық жан, бүгін түнде де дірілдеп ұйқы
Dialogue: 0,0:07:49.05,0:07:51.84,Default,,0,0,0,,Әлгі кішкентай баланың ырғағы ♪ Жанымды күйдіріп
Dialogue: 0,0:07:50.34,0:07:53.51,Default,,0,0,0,,Маған ұнамайды! Қарғыс атсын!
Dialogue: 0,0:07:51.93,0:07:54.34,Default,,0,0,0,,♪ Өртеніп, қыдыруды жалғастыр
Dialogue: 0,0:07:54.43,0:07:55.97,Default,,0,0,0,,♪ Аңшылық жан бақылауды жоғалтады
Dialogue: 0,0:07:55.05,0:07:55.97,Default,,0,0,0,,-Аа? -Апыр-ай!
Dialogue: 0,0:07:55.97,0:07:57.35,Default,,0,0,0,,♪ Аңшылық жан бақылауды жоғалтады
Dialogue: 0,0:07:56.76,0:07:58.72,Default,,0,0,0,,Кяаааааа!
Dialogue: 0,0:07:57.43,0:07:59.64,Default,,0,0,0,,♪ Сізді соңына дейін қуып келеді
Dialogue: 0,0:07:58.81,0:07:59.64,Default,,0,0,0,,Ол сәл қорқынышты емес пе?
Dialogue: 0,0:07:59.64,0:08:03.02,Default,,0,0,0,,♪ Сізді соңына дейін қуып келеді
Dialogue: 0,0:08:05.23,0:08:09.44,Default,,0,0,0,,Аңшылық жан!!
Dialogue: 0,0:08:07.98,0:08:09.44,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:08:09.44,0:08:10.57,Default,,0,0,0,,Аңшылық жан!!
Dialogue: 0,0:08:10.65,0:08:13.45,Default,,0,0,0,,Той уақыты.
Dialogue: 0,0:08:25.33,0:08:26.96,Default,,0,0,0,,Әй, тез бітірейік.
Dialogue: 0,0:08:27.04,0:08:28.50,Default,,0,0,0,,Құсасың бөртпе.
Dialogue: 0,0:08:28.59,0:08:30.80,Default,,0,0,0,,Маған не істеу керектігін айтпа!
Dialogue: 0,0:08:30.88,0:08:31.72,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:08:31.80,0:08:35.39,Default,,0,0,0,,Мишитаның ақымақтығына қарамастан, маған жауап қайтарма!
Dialogue: 0,0:08:35.47,0:08:36.43,Default,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:08:38.10,0:08:43.10,Default,,0,0,0,,♪ «Twinkle Twinkle Star Variations K.265»
Dialogue: 0,0:08:47.23,0:08:52.24,Default,,0,0,0,,♪ «Жабайы раушан»
Dialogue: 0,0:08:53.61,0:08:58.62,Default,,0,0,0,,♪ «Г минордағы кішкентай фуга»
Dialogue: 0,0:09:00.70,0:09:05.71,Default,,0,0,0,,♪“В минордағы виолончельдік концерт, 104-оп.”
Dialogue: 0,0:09:22.14,0:09:23.68,Default,,0,0,0,,Бұл пайдасыз!
Dialogue: 0,0:09:23.77,0:09:26.31,Default,,0,0,0,,Дыбыс бұдан былай жұмыс істемейді!
Dialogue: 0,0:09:27.35,0:09:29.98,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:32.48,0:09:37.45,Default,,0,0,0,,Сен мені ашуландырдың, солай емес пе?
Dialogue: 0,0:09:37.53,0:09:40.08,Default,,0,0,0,,Мен сені біржолата өлтіремін!
Dialogue: 0,0:09:40.16,0:09:44.79,Default,,0,0,0,,«No9 симфониялық хор»!
Dialogue: 0,0:09:45.79,0:09:50.79,Default,,0,0,0,,(Өнімділік)
Dialogue: 0,0:09:55.88,0:10:00.89,Default,,0,0,0,,(тенордың ән айту дауысы)
Dialogue: 0,0:11:11.63,0:11:15.00,Default,,0,0,0,,(хормен айту)
Dialogue: 0,0:11:30.77,0:11:31.60,Default,,0,0,0,,Ахх!
Dialogue: 0,0:11:35.19,0:11:36.07,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:36.15,0:11:37.73,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:11:37.82,0:11:39.65,Default,,0,0,0,,Бұл жігіттер елес!
Dialogue: 0,0:11:39.74,0:11:42.78,Default,,0,0,0,,Уайымдама, орындаушыны ұр!
Dialogue: 0,0:11:42.86,0:11:45.37,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:11:46.20,0:11:47.58,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:47.66,0:11:49.79,Default,,0,0,0,,-Хмф -Хмф!
Dialogue: 0,0:11:49.87,0:11:50.71,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:11:54.54,0:11:57.59,Default,,0,0,0,,Бұл үлкен нәрсенің артында сахнада!
Dialogue: 0,0:11:57.67,0:12:00.80,Default,,0,0,0,,Уф... тоқта, қайда тиіп тұрсың!?
Dialogue: 0,0:12:01.38,0:12:03.93,Default,,0,0,0,,Мен бұлай қозғала алмаймын!
Dialogue: 0,0:12:04.01,0:12:06.51,Default,,0,0,0,,Асықпасаң жаншылып өлесің!
Dialogue: 0,0:12:06.60,0:12:09.22,Default,,0,0,0,,Такакура-сама, маған қол ұшын беріңіз!
Dialogue: 0,0:12:09.31,0:12:10.73,Default,,0,0,0,,Мм...!
Dialogue: 0,0:12:19.69,0:12:20.86,Default,,0,0,0,,Мен мұнда отырып ауа оғын атып, оны дәл тигізе алар едім
Dialogue: 0,0:12:30.37,0:12:35.38,Default,,0,0,0,,(Барлығы ән айтады)
Dialogue: 0,0:12:49.01,0:12:50.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:52.23,0:12:53.35,Default,,0,0,0,,Исла-чан!
Dialogue: 0,0:12:53.44,0:12:55.65,Default,,0,0,0,,Мына жігіттерді маған қалдырыңыз.
Dialogue: 0,0:12:55.73,0:12:56.65,Default,,0,0,0,,Орындаушы!
Dialogue: 0,0:12:58.69,0:13:00.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:04.07,0:13:05.49,Default,,0,0,0,,Хмф...!
Dialogue: 0,0:13:13.87,0:13:15.08,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:17.88,0:13:22.17,Default,,0,0,0,,Хмммм... Дааааааааааааааааааааааааа!
Dialogue: 0,0:13:44.03,0:13:46.45,Default,,0,0,0,,Ахх...
Dialogue: 0,0:13:52.16,0:13:53.37,Default,,0,0,0,,Гуа…
Dialogue: 0,0:13:55.62,0:13:56.87,Default,,0,0,0,,Хмм!
Dialogue: 0,0:13:57.87,0:14:01.00,Default,,0,0,0,,Hap Hap…
Dialogue: 0,0:14:01.09,0:14:03.09,Default,,0,0,0,,Уф! Ууууууу...
Dialogue: 0,0:14:11.30,0:14:12.72,Default,,0,0,0,,Ол сәл қорқынышты емес пе?
Dialogue: 0,0:14:17.27,0:14:22.27,Default,,0,0,0,,(тенордың ән айту дауысы)
Dialogue: 0,0:15:01.77,0:15:02.94,Default,,0,0,0,,Хамф!
Dialogue: 0,0:15:16.04,0:15:19.16,Default,,0,0,0,,Асығыңыз! Асықпасаң тағы да қоршап аласың!
Dialogue: 0,0:15:19.25,0:15:20.21,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:15:23.29,0:15:25.42,Default,,0,0,0,,Бірақ «байыптылық» тек екі соққыны алады...
Dialogue: 0,0:15:25.50,0:15:27.88,Default,,0,0,0,,Бір адамға бір ату жеткіліксіз!
Dialogue: 0,0:15:30.34,0:15:32.47,Default,,0,0,0,,1 соққыда 5 соққы
Dialogue: 0,0:15:34.01,0:15:35.89,Default,,0,0,0,,Менің қолымнан келеді.
Dialogue: 0,0:15:40.85,0:15:43.61,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:15:56.03,0:15:59.29,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:14.34,0:16:15.47,Default,,0,0,0,,Гррр…
Dialogue: 0,0:16:16.22,0:16:17.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:41.87,0:16:43.50,Default,,0,0,0,,Жеңілді...?
Dialogue: 0,0:16:45.83,0:16:49.17,Default,,0,0,0,,Ширатори мырза! Жарайды?
Dialogue: 0,0:16:49.80,0:16:50.92,Default,,0,0,0,,Иә
Dialogue: 0,0:16:51.01,0:16:53.01,Default,,0,0,0,,Жарайды... иә...
Dialogue: 0,0:16:53.09,0:16:56.64,Default,,0,0,0,,Ширатори-санның арқасында мен оны жеңдім.
Dialogue: 0,0:16:57.64,0:16:59.39,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:17:01.43,0:17:02.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:03.02,0:17:07.73,Default,,0,0,0,,Бұл дұрыс емес~ Такакура-кун да керемет болды~
Dialogue: 0,0:17:09.19,0:17:13.15,Default,,0,0,0,,Кәдімгі мен... тезірек шықшы.
Dialogue: 0,0:17:20.12,0:17:22.62,Default,,0,0,0,,Дәрісімнің арқасында.
Dialogue: 0,0:17:22.70,0:17:24.71,Default,,0,0,0,,Алғыс айту және құрмет көрсету.
Dialogue: 0,0:17:24.79,0:17:26.00,Default,,0,0,0,,-Ах!? -(Турбо хаг) А!?
Dialogue: 0,0:17:26.08,0:17:29.79,Default,,0,0,0,,Сіз осындасыз ба? Босқа көрінетін қатысу
Dialogue: 0,0:17:29.88,0:17:33.97,Default,,0,0,0,,Шық! Теменің қоштасуы әлдеқашан шешілді.
Dialogue: 0,0:17:34.05,0:17:36.13,Default,,0,0,0,,Турбо Хагқа рахмет
Dialogue: 0,0:17:36.22,0:17:39.14,Default,,0,0,0,,Мен ырғақ сезімі дегеннің не екенін түсіндім деп ойлаймын.
Dialogue: 0,0:17:39.22,0:17:40.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:40.14,0:17:42.56,Default,,0,0,0,,Алаңдамаңыз.
Dialogue: 0,0:17:42.64,0:17:47.40,Default,,0,0,0,,Сіз әлі құлағыңыздан көп нәрсені түсінбейсіз.
Dialogue: 0,0:17:47.48,0:17:51.36,Default,,0,0,0,,Менің күшім ондай емес.
Dialogue: 0,0:17:51.44,0:17:52.44,Default,,0,0,0,,Иә
Dialogue: 0,0:17:53.07,0:17:54.32,Default,,0,0,0,,Сонымен
Dialogue: 0,0:17:54.40,0:17:56.95,Default,,0,0,0,,Ақыр соңында, бұл балалар қандай болды?
Dialogue: 0,0:17:57.03,0:17:59.16,Default,,0,0,0,,Жай ғана ой тұлғасы
Dialogue: 0,0:17:59.24,0:18:00.66,Default,,0,0,0,,Барлығында бар -
Dialogue: 0,0:18:00.74,0:18:06.16,Default,,0,0,0,,Музыка бөлмесіндегі портреттің үрейлері жиналып, іске асты.
Dialogue: 0,0:18:06.25,0:18:08.17,Default,,0,0,0,,Таңғы сағат 2-де пианинода ойнасаңыз.
Dialogue: 0,0:18:08.25,0:18:09.96,Default,,0,0,0,,Ол қайтадан келеді.
Dialogue: 0,0:18:10.04,0:18:13.00,Default,,0,0,0,,Егер өлтірілсең, өмірде де өлесің.
Dialogue: 0,0:18:13.09,0:18:15.09,Default,,0,0,0,,-Мені қайта кешірме -Мені қайта кешірме
Dialogue: 0,0:18:15.17,0:18:18.89,Default,,0,0,0,,Дәлірек айтсақ, бұл мектептің оғаш жағдайын қайдан білесіз?
Dialogue: 0,0:18:18.97,0:18:21.18,Default,,0,0,0,,Сіз бірдеңе жоспарлап отырған жоқсыз, солай ма?
Dialogue: 0,0:18:21.26,0:18:26.64,Default,,0,0,0,,Мен әрқашан оларды өлтіруім керек деп ойлаймын ...
Dialogue: 0,0:18:24.68,0:18:26.64,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:18:28.35,0:18:30.02,Default,,0,0,0,,- (Турбо хаг)... - (Окарун Айра) Ху...
Dialogue: 0,0:18:30.10,0:18:35.11,Default,,0,0,0,,Ааааааааа!
Dialogue: 0,0:18:36.57,0:18:39.41,Default,,0,0,0,,Музыканы қайта шақырайық!
Dialogue: 0,0:18:39.49,0:18:43.24,Default,,0,0,0,,Міндетті түрде қара көзге қарсы шара қолданамыз.
Dialogue: 0,0:18:43.33,0:18:45.70,Default,,0,0,0,,Бұдан әрі мүмкін емес.
Dialogue: 0,0:18:45.79,0:18:47.08,Default,,0,0,0,,Мен бұл туралы ойлағым келмейді, бірақ...
Dialogue: 0,0:18:48.08,0:18:49.92,Default,,0,0,0,,Біреу өледі.
Dialogue: 0,0:18:54.59,0:18:56.13,Default,,0,0,0,,Тіпті Джиги
Dialogue: 0,0:18:56.21,0:18:59.30,Default,,0,0,0,,Хошико мен Момоны өлтіргіңіз келмейді, солай ма?
Dialogue: 0,0:18:59.38,0:19:03.51,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, мен Джиджидің ата-анасымен тұра алмаймын.
Dialogue: 0,0:19:05.27,0:19:08.35,Default,,0,0,0,,Ертең мен жын шығару рәсімін жасаймын.
Dialogue: 0,0:19:08.43,0:19:10.10,Default,,0,0,0,,А...
Dialogue: 0,0:19:10.19,0:19:13.98,Default,,0,0,0,,Негізі мен музыкаға аранжировка жасап қойғанмын.
Dialogue: 0,0:19:14.07,0:19:17.19,Default,,0,0,0,,Біраз күте тұрыңыз, сөйлесуді жалғастырмаңыз!
Dialogue: 0,0:19:17.28,0:19:20.11,Default,,0,0,0,,Бата айтайын.
Dialogue: 0,0:19:20.20,0:19:23.37,Default,,0,0,0,,Ммм...!
Dialogue: 0,0:19:23.45,0:19:25.41,Default,,0,0,0,,Әже, сіз де айтыңызшы!
Dialogue: 0,0:19:25.49,0:19:27.54,Default,,0,0,0,,Мен оны өз отбасыма айналдырдым!
Dialogue: 0,0:19:27.62,0:19:30.79,Default,,0,0,0,,Тіпті Джиджи рухани күшке жаттығады!
Dialogue: 0,0:19:30.87,0:19:33.38,Default,,0,0,0,,Сәлем! Әй, әже!
Dialogue: 0,0:19:35.84,0:19:39.59,Default,,0,0,0,,Хитоши Энджудзи! Шығу!
Dialogue: 0,0:19:39.67,0:19:41.59,Default,,0,0,0,,Не? Окарун?
Dialogue: 0,0:20:01.11,0:20:02.95,Default,,0,0,0,,Окарун, не болды?
Dialogue: 0,0:20:03.03,0:20:07.41,Default,,0,0,0,,Дәлірек айтсақ, осы сағатта екеуің қайдасыңдар...?
Dialogue: 0,0:20:07.49,0:20:09.37,Default,,0,0,0,,Ширатори мырза, су!
Dialogue: 0,0:20:09.45,0:20:10.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:11.66,0:20:14.42,Default,,0,0,0,,А, күте тұрыңыз, сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:20:14.50,0:20:17.05,Default,,0,0,0,,Ешкіммен араласпа!
Dialogue: 0,0:20:17.13,0:20:21.05,Default,,0,0,0,,Бұдан былай мен жаман көзді басып тастаймын!!
Dialogue: 0,0:20:21.13,0:20:25.26,Default,,0,0,0,,Эй Окарун, мен ашуланып барамын! Бұл ойын емес!
Dialogue: 0,0:20:26.93,0:20:28.93,Default,,0,0,0,,Мен ашуландым.
Dialogue: 0,0:20:29.02,0:20:31.73,Default,,0,0,0,,Аясе мырзаға жаман көз шабуыл жасағанда, Джибун...
Dialogue: 0,0:20:32.94,0:20:35.06,Default,,0,0,0,,Мен қатты ашуландым!
Dialogue: 0,0:20:35.15,0:20:36.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:36.15,0:20:38.73,Default,,0,0,0,,Бір кезде бұл қалай болса да болады деп ойладым.
Dialogue: 0,0:20:38.82,0:20:41.03,Default,,0,0,0,,Бірақ жаман көз әлі де қауіпті.
Dialogue: 0,0:20:41.11,0:20:44.99,Default,,0,0,0,,Ол қатыгез және айлакер, ол жалғыз қалдыратын жігіт емес.
Dialogue: 0,0:20:45.07,0:20:49.45,Default,,0,0,0,,Сонда да Аясе-сан және басқалары жаман көзді қабылдауға тырысады.
Dialogue: 0,0:20:49.54,0:20:52.21,Default,,0,0,0,,Бұл өте таңқаларлық.
Dialogue: 0,0:20:52.79,0:20:54.75,Default,,0,0,0,,Бұл шынымен...
Dialogue: 0,0:20:55.67,0:20:57.54,Default,,0,0,0,,Бұл тамаша емес.
Dialogue: 0,0:20:57.63,0:20:58.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:58.67,0:21:02.92,Default,,0,0,0,,Сондықтан әлсіздігіңізге ашуланыңыз.
Dialogue: 0,0:21:03.01,0:21:04.72,Default,,0,0,0,,Күте тұр, Джижи.
Dialogue: 0,0:21:04.80,0:21:08.01,Default,,0,0,0,,Жаман көзден қорғану ниетіңіз күшті.
Dialogue: 0,0:21:08.89,0:21:10.85,Default,,0,0,0,,Мен оны міндетті түрде қорғаймын!
Dialogue: 0,0:21:12.39,0:21:14.73,Default,,0,0,0,,Такакура-сан, сабыр ет!
Dialogue: 0,0:21:14.81,0:21:17.81,Default,,0,0,0,,Джиги-сан жын шығаруды шешіп қойған!
Dialogue: 0,0:21:17.90,0:21:20.44,Default,,0,0,0,,Жаман көзбен күресудің қажеті жоқ!
Dialogue: 0,0:21:20.53,0:21:21.61,Default,,0,0,0,,Манджиро!
Dialogue: 0,0:21:21.69,0:21:22.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:23.95,0:21:26.32,Default,,0,0,0,,Ер адам резервуарды кесіп тастады.
Dialogue: 0,0:21:26.99,0:21:28.62,Default,,0,0,0,,Өзіңізді ұятқа қалдырмаңыз
Dialogue: 0,0:21:28.70,0:21:29.53,Default,,0,0,0,,Не!
Dialogue: 0,0:21:30.62,0:21:31.91,Default,,0,0,0,,Такакура-кун!
Dialogue: 0,0:21:32.58,0:21:34.21,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:21:34.83,0:21:36.67,Default,,0,0,0,,Момо-чан, кет
Dialogue: 0,0:21:43.92,0:21:46.18,Default,,0,0,0,,Окарун, өтінемін! Жаман көз!
Dialogue: 0,0:21:46.84,0:21:48.22,Default,,0,0,0,,Айо
Dialogue: 0,0:22:00.23,0:22:01.23,Default,,0,0,0,,Хамф!
Dialogue: 0,0:22:06.99,0:22:11.99,Default,,0,0,0,,♪~
Dialogue: 0,0:23:32.45,0:23:35.28,Default,,0,0,0,,~♪
Dialogue: 0,0:23:37.83,0:23:39.33,Default,,0,0,0,,Мені төмендетпе
Dialogue: 0,0:23:39.41,0:23:41.75,Default,,0,0,0,,Бүркіт сені кез келген уақытта өлтіруі мүмкін.
Dialogue: 0,0:23:41.83,0:23:43.71,Default,,0,0,0,,Мына үйге қараңдар, құлап кетсін.
Dialogue: 0,0:23:43.79,0:23:45.21,Default,,0,0,0,,Қараңызшы, қарныңыз ашты.
Dialogue: 0,0:23:45.29,0:23:47.21,Default,,0,0,0,,Кешкі ас дайын болғанша жей беріңіз.
Dialogue: 0,0:23:47.30,0:23:48.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:48.26,0:23:49.97,Default,,0,0,0,,Келесі жолы «Мен үйімді қалпына келтіргім келеді»
Dialogue: 0,0:23:50.05,0:23:51.88,Default,,0,0,0,,Сіз де көмектесе аласыз.
Dialogue: 0,0:23:53.38,0:23:58.38,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
