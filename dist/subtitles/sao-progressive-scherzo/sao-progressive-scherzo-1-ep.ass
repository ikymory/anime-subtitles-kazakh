Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:21.08,0:01:22.45,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:22.54,0:01:23.95,Default,,0,0,0,,Жабдықты қайта тексеріңіз
Dialogue: 0,0:01:29.21,0:01:31.17,Default,,0,0,0,,-Тым қобалжыма -Ах
Dialogue: 0,0:01:32.13,0:01:35.09,Default,,0,0,0,,Маған жаңадан келген ғұн сияқты қарама
Dialogue: 0,0:01:35.17,0:01:36.01,Default,,0,0,0,,Хаха
Dialogue: 0,0:01:36.09,0:01:39.01,Default,,0,0,0,,Кирито-кун, сен қаруыңды ұстайсың ба?
Dialogue: 0,0:01:39.09,0:01:41.97,Default,,0,0,0,,Әрине мен оны кеше бітірдім.
Dialogue: 0,0:01:42.06,0:01:43.01,Default,,0,0,0,,Мұндай Асуна...
Dialogue: 0,0:01:50.36,0:01:51.73,Default,,0,0,0,,Сұрау қажет емес.
Dialogue: 0,0:01:52.69,0:01:55.69,Default,,0,0,0,,Иә, бұл маңызды қылыш.
Dialogue: 0,0:02:05.45,0:02:08.12,Default,,0,0,0,,Міне, уақыт келді, ендеше бастайық.
Dialogue: 0,0:02:08.83,0:02:10.88,Default,,0,0,0,,Өзімді таныстырып өтейін.
Dialogue: 0,0:02:10.96,0:02:14.05,Default,,0,0,0,,Мен Айдаһар рыцарлары бригадасының Линдімін.
Dialogue: 0,0:02:14.13,0:02:17.09,Default,,0,0,0,,Мен осы рейд жетекшісі ретінде қызмет етемін.
Dialogue: 0,0:02:17.17,0:02:18.51,Default,,0,0,0,,Барлығыңызға сәлем
Dialogue: 0,0:02:18.59,0:02:20.51,Default,,0,0,0,,(DKB мүшелерінің қол шапалақтауы)
Dialogue: 0,0:02:25.35,0:02:27.43,Default,,0,0,0,,(қол шапалақтау тоқтайды)
Dialogue: 0,0:02:27.52,0:02:28.35,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:02:28.43,0:02:30.19,Default,,0,0,0,,Вай - Айнкрад азат ету күштерінің Кибауы.
Dialogue: 0,0:02:30.19,0:02:31.65,Default,,0,0,0,,Вай - Айнкрад азат ету күштерінің Кибауы.
Dialogue: 0,0:02:30.19,0:02:31.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:31.73,0:02:33.61,Default,,0,0,0,,Бұл жолы мен қосалқы көшбасшы ретінде әрекет етуді сұраймын.
Dialogue: 0,0:02:33.69,0:02:34.52,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:02:34.61,0:02:37.82,Default,,0,0,0,,(ALS мүшелерінің қол шапалақтауы мен қошеметі)
Dialogue: 0,0:02:37.90,0:02:40.78,Default,,0,0,0,,(ALS мүшелерінің қол шапалақтауы мен қошеметі)
Dialogue: 0,0:02:40.86,0:02:42.74,Default,,0,0,0,,Хаха…
Dialogue: 0,0:02:40.86,0:02:42.74,Default,,0,0,0,,Бастық шабуылының үлгілері және әр жасақтың рөлдері
Dialogue: 0,0:02:42.74,0:02:43.49,Default,,0,0,0,,Бастық шабуылының үлгілері және әр жасақтың рөлдері
Dialogue: 0,0:02:43.58,0:02:45.66,Default,,0,0,0,,Алдын ала түсіндірілгендей
Dialogue: 0,0:02:48.54,0:02:50.42,Default,,0,0,0,,Бұған не себеп болды?
Dialogue: 0,0:02:50.50,0:02:53.46,Default,,0,0,0,,Біз үздік ойыншымыз. Барлығының ерен еңбегіне рахмет.
Dialogue: 0,0:02:53.54,0:02:56.05,Default,,0,0,0,,Сол билікті маған сеніп тапсырсаң, басшы.
Dialogue: 0,0:02:56.13,0:02:58.30,Default,,0,0,0,,Бұл деңгейде сіз міндетті түрде бастықты жеңе аласыз.
Dialogue: 0,0:02:58.38,0:02:59.76,Default,,0,0,0,,Көшбасшы десең де
Dialogue: 0,0:02:59.84,0:03:04.35,Default,,0,0,0,,Сіз бастық бөлмесін Вейра гильдиясынан сәл ертерек тапқан жоқсыз ба?
Dialogue: 0,0:03:04.43,0:03:08.47,Default,,0,0,0,,Бұл тәртіп, солай емес пе? Енді көңіліңіз толмай ма?
Dialogue: 0,0:03:08.56,0:03:10.89,Default,,0,0,0,,Хан! бөлек
Dialogue: 0,0:03:12.90,0:03:15.82,Default,,0,0,0,,Ал, бүгін 5-ші қабатқа жетейік!
Dialogue: 0,0:03:15.90,0:03:19.11,Default,,0,0,0,,(Ұжымдық ұрыс айқайы)
Dialogue: 0,0:03:20.36,0:03:23.70,Default,,0,0,0,,
Dialogue: 0,0:03:23.78,0:03:25.41,Default,,0,0,0,,-Ооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо
Dialogue: 0,0:03:28.41,0:03:29.45,Default,,0,0,0,,О!
Dialogue: 0,0:03:30.83,0:03:31.66,Default,,0,0,0,,Уау
Dialogue: 0,0:03:38.09,0:03:39.13,Default,,0,0,0,,Ех!
Dialogue: 0,0:03:44.97,0:03:46.39,Default,,0,0,0,,Хааааа!
Dialogue: 0,0:03:49.64,0:03:52.23,Default,,0,0,0,,
Dialogue: 0,0:04:13.21,0:04:15.75,Default,,0,0,0,,
Dialogue: 0,0:04:15.83,0:04:18.42,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:04:20.84,0:04:23.51,Default,,0,0,0,,
Dialogue: 0,0:04:25.47,0:04:28.10,Default,,0,0,0,,Тағы бір дем, итеруді жалғастыр!
Dialogue: 0,0:04:28.18,0:04:29.68,Default,,0,0,0,,О!
Dialogue: 0,0:04:30.52,0:04:33.69,Default,,0,0,0,,Өлшем өзгерді. D тобы ауысуға дайындалуда!
Dialogue: 0,0:04:33.77,0:04:35.56,Default,,0,0,0,,А тобы алға шығуға дайындалыңыз!
Dialogue: 0,0:04:36.40,0:04:37.94,Default,,0,0,0,,Хмм, не істеп жатырсың!
Dialogue: 0,0:04:38.02,0:04:39.57,Default,,0,0,0,,Біз мұны әлі істей аламыз!
Dialogue: 0,0:04:39.65,0:04:42.11,Default,,0,0,0,,Мен көшбасшымын. Айналуды қорғаңыз!
Dialogue: 0,0:04:42.19,0:04:43.78,Default,,0,0,0,,Осындай нәрсені айтыңыз
Dialogue: 0,0:04:43.86,0:04:46.11,Default,,0,0,0,,Олар соңғы шабуылды жасауды жоспарлап отыр.
Dialogue: 0,0:04:46.20,0:04:47.16,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:04:47.24,0:04:49.12,Default,,0,0,0,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:04:49.20,0:04:50.41,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:04:50.49,0:04:52.62,Default,,0,0,0,,
Dialogue: 0,0:04:59.71,0:05:00.88,Default,,0,0,0,,Уау
Dialogue: 0,0:05:03.09,0:05:04.05,Default,,0,0,0,,Уау
Dialogue: 0,0:05:08.26,0:05:09.43,Default,,0,0,0,,Асуна!
Dialogue: 0,0:05:13.77,0:05:14.98,Default,,0,0,0,,Кирито-кун
Dialogue: 0,0:05:16.48,0:05:17.90,Default,,0,0,0,,Арго!
Dialogue: 0,0:05:18.52,0:05:19.73,Default,,0,0,0,,Хоикита
Dialogue: 0,0:05:37.87,0:05:39.79,Default,,0,0,0,,-Асуна кеттік! -Иә!
Dialogue: 0,0:05:44.76,0:05:46.38,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:05:46.47,0:05:48.09,Default,,0,0,0,,Теяаа!
Dialogue: 0,0:06:00.94,0:06:03.65,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,0:06:03.73,0:06:06.78,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,0:06:06.86,0:06:09.57,Default,,0,0,0,,Жолдан тез кет, Кибау-сан.
Dialogue: 0,0:06:09.66,0:06:12.49,Default,,0,0,0,,Оған дейін достарыңнан құтыл!
Dialogue: 0,0:06:15.87,0:06:16.87,Default,,0,0,0,,Иә
Dialogue: 0,0:06:18.16,0:06:19.17,Default,,0,0,0,,Иә
Dialogue: 0,0:06:45.19,0:06:47.44,Default,,0,0,0,,Олай болса, 5-қабатқа жеткенің құтты болсын.
Dialogue: 0,0:06:47.53,0:06:48.90,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:49.61,0:06:51.24,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:06:52.87,0:06:54.24,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:06:54.33,0:06:56.08,Default,,0,0,0,,Пхуха~
Dialogue: 0,0:06:56.58,0:06:58.58,Default,,0,0,0,,Әпке, қосымша көмек!
Dialogue: 0,0:06:58.66,0:07:01.75,Default,,0,0,0,,Босс шайқасы Маған көмектескеніңіз үшін рахмет, Арго.
Dialogue: 0,0:07:01.83,0:07:04.38,Default,,0,0,0,,Бастық бөлмесі су астында қалуы мүмкін екендігі туралы ақпарат
Dialogue: 0,0:07:04.46,0:07:07.55,Default,,0,0,0,,Себебі мен оны Ойраның стратегиялық кітабына енгізе алмадым.
Dialogue: 0,0:07:07.63,0:07:09.76,Default,,0,0,0,,Сатудан кейінгі қызмет көрсету деңгейі
Dialogue: 0,0:07:09.84,0:07:12.84,Default,,0,0,0,,Шынымды айтсам, сіз мені бас тартасыз деп ойладым.
Dialogue: 0,0:07:12.93,0:07:15.97,Default,,0,0,0,,Әрине, алымдар бөлек алынады.
Dialogue: 0,0:07:16.06,0:07:18.22,Default,,0,0,0,,О... маған мейірімді болыңыз.
Dialogue: 0,0:07:19.89,0:07:23.81,Default,,0,0,0,,Дегенмен, 4-қабатты тазалауға шамамен бір апта қажет.
Dialogue: 0,0:07:23.90,0:07:25.94,Default,,0,0,0,,Күтпеген жерден ерте болды.
Dialogue: 0,0:07:26.90,0:07:30.86,Default,,0,0,0,,Бірінші қабатты бағындыруға бір ай уақыт кетті.
Dialogue: 0,0:07:30.95,0:07:34.45,Default,,0,0,0,,Осы қарқынмен осы жылдың ішінде 6-қабатқа жетуіміз керек емес пе?
Dialogue: 0,0:07:34.53,0:07:37.49,Default,,0,0,0,,Жоқ, жоқ, биыл екі күн ғана қалды.
Dialogue: 0,0:07:37.58,0:07:38.87,Default,,0,0,0,,Әрине, бұл мүмкін емес...
Dialogue: 0,0:07:38.95,0:07:39.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:43.00,0:07:45.54,Default,,0,0,0,,Мм... Асуна-сан?
Dialogue: 0,0:07:45.63,0:07:47.80,Default,,0,0,0,,Қалай қарасаң да, сол кез еді.
Dialogue: 0,0:07:47.88,0:07:49.46,Default,,0,0,0,,ше? Не?
Dialogue: 0,0:07:49.55,0:07:51.38,Default,,0,0,0,,Соңғы шабуыл бонусы
Dialogue: 0,0:07:51.47,0:07:54.47,Default,,0,0,0,,Ах... ха... ха...
Dialogue: 0,0:07:57.51,0:08:00.89,Default,,0,0,0,,Соңында Киритоның қылыш шеберлігі және менің қылыш шеберлігім
Dialogue: 0,0:08:00.98,0:08:02.73,Default,,0,0,0,,Олар бір уақытта соқты!
Dialogue: 0,0:08:02.81,0:08:03.94,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:08:04.02,0:08:07.11,Default,,0,0,0,,Бірақ бонусты неге өзіңізбен бірге алып жүрсіз?
Dialogue: 0,0:08:07.77,0:08:10.49,Default,,0,0,0,,Мм... бұл...
Dialogue: 0,0:08:10.57,0:08:15.07,Default,,0,0,0,,Мүмкін менің техникам тезірек жерге тиген шығар...
Dialogue: 0,0:08:15.16,0:08:18.16,Default,,0,0,0,,Жоқ! Бұл бір уақытта болды!
Dialogue: 0,0:08:18.87,0:08:20.20,Default,,0,0,0,,Бірақ жүйе бойынша мен жылдамырақ болдым...
Dialogue: 0,0:08:20.20,0:08:21.79,Default,,0,0,0,,Бірақ жүйе бойынша мен жылдамырақ болдым...
Dialogue: 0,0:08:20.20,0:08:21.79,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:08:21.79,0:08:21.87,Default,,0,0,0,,Бірақ жүйе бойынша мен жылдамырақ болдым...
Dialogue: 0,0:08:21.87,0:08:22.66,Default,,0,0,0,,Бірақ жүйе бойынша мен жылдамырақ болдым...
Dialogue: 0,0:08:21.87,0:08:22.66,Default,,0,0,0,,Кел, кел, кел
Dialogue: 0,0:08:22.66,0:08:22.75,Default,,0,0,0,,Кел, кел, кел
Dialogue: 0,0:08:22.75,0:08:23.37,Default,,0,0,0,,Кел, кел, кел
Dialogue: 0,0:08:22.75,0:08:23.37,Default,,0,0,0,,Аргоны да түсіндіріп беріңізші.
Dialogue: 0,0:08:23.37,0:08:25.08,Default,,0,0,0,,Аргоны да түсіндіріп беріңізші.
Dialogue: 0,0:08:25.17,0:08:28.04,Default,,0,0,0,,Менің иттер де жемейтін нәрсеге араласуға ниетім жоқ.
Dialogue: 0,0:08:28.13,0:08:29.21,Default,,0,0,0,,- Иә? -ит?
Dialogue: 0,0:08:29.30,0:08:33.22,Default,,0,0,0,,Керісінше, Ах-чан, қуырылған тауықты ал.
Dialogue: 0,0:08:33.72,0:08:35.47,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:08:38.39,0:08:41.14,Default,,0,0,0,,Бірақ бұл, әрине, жылдам қарқын, солай емес пе?
Dialogue: 0,0:08:41.22,0:08:42.23,Default,,0,0,0,,Хмм, не?
Dialogue: 0,0:08:42.31,0:08:43.98,Default,,0,0,0,,Стратегия
Dialogue: 0,0:08:44.06,0:08:48.31,Default,,0,0,0,,2-ші, 3-ші және 4-ші қабаттармен қарқын барған сайын жылдамдауда.
Dialogue: 0,0:08:48.40,0:08:51.61,Default,,0,0,0,,Кибаудың ''ALS'' және Линдтің ''DKB''
Dialogue: 0,0:08:51.69,0:08:54.74,Default,,0,0,0,,Өйткені біз бір-бірімізбен ашық жарысып жатырмыз.
Dialogue: 0,0:08:54.82,0:08:58.12,Default,,0,0,0,,Осы уақытқа дейін жақсы нәтижелерге әкелді.
Dialogue: 0,0:08:58.20,0:08:59.70,Default,,0,0,0,,Көптеген мәселелер бар...
Dialogue: 0,0:08:59.78,0:09:01.16,Default,,0,0,0,,Иә
Dialogue: 0,0:09:01.74,0:09:05.79,Default,,0,0,0,,Кешегі бастық шайқасында да үйлестіру жақсы болмады.
Dialogue: 0,0:09:06.33,0:09:11.05,Default,,0,0,0,,Ха... Кездескен сайын төбелеседі.
Dialogue: 0,0:09:11.63,0:09:14.17,Default,,0,0,0,,Ағымдағы «стратегиялық топ» болып табылады
Dialogue: 0,0:09:14.26,0:09:16.68,Default,,0,0,0,,Бұл Диавелдің рейдтік партиясы, солай ма?
Dialogue: 0,0:09:16.76,0:09:20.05,Default,,0,0,0,,Сол Диавел бірінші қабаттағы бастық шайқасында қайтыс болды.
Dialogue: 0,0:09:20.14,0:09:24.06,Default,,0,0,0,,Линд мырза өз қолына алып, ``DKB'' құрды.
Dialogue: 0,0:09:24.14,0:09:26.60,Default,,0,0,0,,Бірақ Линдтің көшбасшылыққа ерекше мән беру әдісі
Dialogue: 0,0:09:26.69,0:09:28.31,Default,,0,0,0,,тойтарыс берген Кибау
Dialogue: 0,0:09:28.40,0:09:31.48,Default,,0,0,0,,Ынтымақтастыққа баса назар аударатын ALS іске қосылды.
Dialogue: 0,0:09:31.57,0:09:36.57,Default,,0,0,0,,Екі гильдия ``жаулап алу тобының'' тірегі деп есептейді.
Dialogue: 0,0:09:36.65,0:09:39.99,Default,,0,0,0,,Линд және басқалары үздік ойыншыларға ресурстарын шоғырландыруға мүмкіндік берді.
Dialogue: 0,0:09:40.07,0:09:41.83,Default,,0,0,0,,Мен оны бағындыруды мақсат етіп отырмын.
Dialogue: 0,0:09:41.91,0:09:46.16,Default,,0,0,0,,Керісінше, Кибау ресурстарды кеңінен тарату керек деп есептейді.
Dialogue: 0,0:09:47.12,0:09:50.59,Default,,0,0,0,,Екеуі де Диавелдің мұрагері болуды мақсат етеді.
Dialogue: 0,0:09:50.67,0:09:53.09,Default,,0,0,0,,Идея мүлде керісінше.
Dialogue: 0,0:09:53.17,0:09:56.01,Default,,0,0,0,,Сонда да келесі кері санақ кеші
Dialogue: 0,0:09:56.09,0:09:59.47,Default,,0,0,0,,Оны DKB және ALS бірлесіп жоспарлаған, солай ма?
Dialogue: 0,0:09:59.55,0:10:02.60,Default,,0,0,0,,Ондай жағдайда біз қалыпты тіл табысуымыз керек.
Dialogue: 0,0:10:02.68,0:10:04.35,Default,,0,0,0,,Міне, сол балалар күткендей.
Dialogue: 0,0:10:04.43,0:10:07.14,Default,,0,0,0,,Менің ойымша, олар жыл басында бір-бірімен төбелескісі келмеді.
Dialogue: 0,0:10:07.23,0:10:08.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:09.19,0:10:11.40,Default,,0,0,0,,Бұл не туралы?
Dialogue: 0,0:10:13.44,0:10:16.69,Default,,0,0,0,,Кілт бала, мүмкін...
Dialogue: 0,0:10:16.78,0:10:18.74,Default,,0,0,0,,Сізді шақырған жоқсыз ба?
Dialogue: 0,0:10:20.20,0:10:22.87,Default,,0,0,0,,Шақыру дегенді қалай түсінесіңдер?
Dialogue: 0,0:10:22.95,0:10:26.95,Default,,0,0,0,,Дұрыс, биылғы жылға екі-ақ күн қалды дедіңіз.
Dialogue: 0,0:10:27.04,0:10:28.91,Default,,0,0,0,,Ертең неше күн?
Dialogue: 0,0:10:29.00,0:10:32.84,Default,,0,0,0,,Ал... 31 желтоқсан.
Dialogue: 0,0:10:32.92,0:10:33.92,Default,,0,0,0,,Я...
Dialogue: 0,0:10:34.00,0:10:36.55,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:10:36.63,0:10:40.51,Default,,0,0,0,,Жаңа жыл түні екі үлкен гильдия қосылды.
Dialogue: 0,0:10:40.59,0:10:42.47,Default,,0,0,0,,Олар кері санақ кешін өткізіп жатыр.
Dialogue: 0,0:10:42.55,0:10:46.27,Default,,0,0,0,,Иә! Мен... мен ештеңе естіген жоқпын.
Dialogue: 0,0:10:51.90,0:10:56.03,Default,,0,0,0,,Айтпақшы, Асуна-сан, бұл туралы кімнен естідің?
Dialogue: 0,0:10:56.11,0:10:58.90,Default,,0,0,0,,《DKB》 Шивата мырзадан
Dialogue: 0,0:10:58.99,0:11:00.91,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:00.99,0:11:02.66,Default,,0,0,0,,Басқалардан да
Dialogue: 0,0:11:02.74,0:11:05.49,Default,,0,0,0,,Маған көптеген жедел хабарламалар келді.
Dialogue: 0,0:11:06.12,0:11:07.95,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:08.04,0:11:09.96,Default,,0,0,0,,Сіз онша жалықпайсыз, солай ма?
Dialogue: 0,0:11:10.04,0:11:12.25,Default,,0,0,0,,Мен... Мен мұңайып тұрған жоқпын!
Dialogue: 0,0:11:12.33,0:11:15.17,Default,,0,0,0,,Жеке ойыншылар үшін партия маңызды емес.
Dialogue: 0,0:11:16.59,0:11:18.63,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:18.71,0:11:21.30,Default,,0,0,0,,Сіз жеке өнер көрсетуді жоспарлағансыз.
Dialogue: 0,0:11:21.38,0:11:22.43,Default,,0,0,0,,Я...
Dialogue: 0,0:11:23.39,0:11:25.05,Default,,0,0,0,,Нихихихихи
Dialogue: 0,0:11:25.76,0:11:27.18,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:11:27.26,0:11:30.39,Default,,0,0,0,,Жоқ, жоқ, бұл ештеңе емес.
Dialogue: 0,0:11:30.48,0:11:33.19,Default,,0,0,0,,Менің баратын уақытым таяп қалды деп ойлаймын.
Dialogue: 0,0:11:33.27,0:11:36.02,Default,,0,0,0,,Иә? Қазірдің өзінде? Соңында десерт...
Dialogue: 0,0:11:36.11,0:11:38.32,Default,,0,0,0,,Осы қаладағы квесттер
Dialogue: 0,0:11:38.40,0:11:41.95,Default,,0,0,0,,Өйткені біз дүкендерде сатылатын заттар туралы деректерді жинауымыз керек.
Dialogue: 0,0:11:42.03,0:11:45.28,Default,,0,0,0,,Көріскенше, А-чан, Кей-бо.
Dialogue: 0,0:11:47.58,0:11:48.87,Default,,0,0,0,,А-а, дұрыс, А-чан.
Dialogue: 0,0:11:48.95,0:11:49.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:49.87,0:11:53.87,Default,,0,0,0,,Сіз маған осыны сұрадыңыз, бірақ бұл біраз уақытты алады.
Dialogue: 0,0:11:53.96,0:11:55.92,Default,,0,0,0,,Түсінген кезде мен сізге қайта хабарласамын.
Dialogue: 0,0:11:56.00,0:11:57.46,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:12:05.22,0:12:06.14,Default,,0,0,0,,Десерт
Dialogue: 0,0:12:06.22,0:12:08.47,Default,,0,0,0,,Мен саған көкжидек тортын әкелдім.
Dialogue: 0,0:12:12.77,0:12:15.19,Default,,0,0,0,,Екі адамға бола ма?
Dialogue: 0,0:12:15.27,0:12:17.90,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:12:20.65,0:12:22.86,Default,,0,0,0,,Уау~ Дәмді көрінеді
Dialogue: 0,0:12:24.45,0:12:27.70,Default,,0,0,0,,Бұл торт - буфпен бірге келетін шектеулі шығарылым мәзірі.
Dialogue: 0,0:12:27.78,0:12:30.91,Default,,0,0,0,,Буфф қолдау әсерін білдіреді, солай ма?
Dialogue: 0,0:12:31.66,0:12:34.04,Default,,0,0,0,,Бұл кәдімгі көкжидек тортына ұқсайды.
Dialogue: 0,0:12:34.75,0:12:36.67,Default,,0,0,0,,Оның қандай әсері бар?
Dialogue: 0,0:12:36.75,0:12:39.13,Default,,0,0,0,,Тамақтанған рахат
Dialogue: 0,0:12:52.02,0:12:54.14,Default,,0,0,0,,Әй, дәмді
Dialogue: 0,0:12:56.15,0:12:58.11,Default,,0,0,0,,Бұл белгіше қандай?
Dialogue: 0,0:12:58.19,0:13:00.98,Default,,0,0,0,,Еденге мұқият қараңыз.
Dialogue: 0,0:13:02.69,0:13:03.82,Default,,0,0,0,,Ах
Dialogue: 0,0:13:03.90,0:13:05.91,Default,,0,0,0,,Бірдеңе...
Dialogue: 0,0:13:15.33,0:13:16.58,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:16.67,0:13:18.38,Default,,0,0,0,,Бұл жоғалған зат па?
Dialogue: 0,0:13:21.50,0:13:23.92,Default,,0,0,0,,Жоқ, бұл 《Реликт》.
Dialogue: 0,0:13:24.01,0:13:27.01,Default,,0,0,0,,Бұл бесінші қабат қираған қабат.
Dialogue: 0,0:13:27.09,0:13:29.97,Default,,0,0,0,,Осындай ұсақ жәдігерлер барлық жерде құлап жатыр.
Dialogue: 0,0:13:30.05,0:13:31.68,Default,,0,0,0,,Бір-екі күнде
Dialogue: 0,0:13:31.76,0:13:34.10,Default,,0,0,0,,Төменгі қабаттан көптеген ойыншылар шықты.
Dialogue: 0,0:13:34.18,0:13:37.52,Default,,0,0,0,,Менің ойымша, бұл бүкіл қалада реликтерді жинау фестивалі болады.
Dialogue: 0,0:13:37.60,0:13:39.36,Default,,0,0,0,,Я~
Dialogue: 0,0:13:40.98,0:13:41.82,Default,,0,0,0,,Ах
Dialogue: 0,0:13:45.78,0:13:47.03,Default,,0,0,0,,Тағы да болды
Dialogue: 0,0:13:47.11,0:13:49.74,Default,,0,0,0,,Бұл жерден жәдігерлерді жинауға құмар болып кетсең қауіпті.
Dialogue: 0,0:13:49.82,0:13:53.99,Default,,0,0,0,,Қалыпты ойында заттардың орналасуы шағын картада көрсетіледі.
Dialogue: 0,0:13:54.08,0:13:56.21,Default,,0,0,0,,Экранда жанады.
Dialogue: 0,0:13:56.29,0:13:58.96,Default,,0,0,0,,《SAO》 - бұл шелектегі тамшы ғана.
Dialogue: 0,0:13:59.04,0:14:01.88,Default,,0,0,0,,Не? Бірақ сіз жарықты көре аласыз ба?
Dialogue: 0,0:14:03.92,0:14:06.34,Default,,0,0,0,,А, онда бұл бафф...
Dialogue: 0,0:14:06.42,0:14:09.64,Default,,0,0,0,,Иә, тиындар мен әшекейлер құлап жатыр.
Dialogue: 0,0:14:09.72,0:14:12.05,Default,,0,0,0,,Бұл көмескі жарқылға ұқсайды, бұл өте жақсы...
Dialogue: 0,0:14:12.14,0:14:12.97,Default,,0,0,0,,Зергерлік бұйымдар?
Dialogue: 0,0:14:13.06,0:14:14.72,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:14:16.48,0:14:18.60,Default,,0,0,0,,Бұл буфф қанша уақытқа жарамды?
Dialogue: 0,0:14:20.81,0:14:21.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:23.32,0:14:27.03,Default,,0,0,0,,Мен де реликтерді жинау фестивалін өткізгім келеді!
Dialogue: 0,0:14:32.87,0:14:35.79,Default,,0,0,0,,А... Түсіндім.
Dialogue: 0,0:14:35.87,0:14:38.75,Default,,0,0,0,,Егер сіз оған тәуелді болсаңыз, бұл қауіпті.
Dialogue: 0,0:14:38.83,0:14:40.79,Default,,0,0,0,,Дұрыс? Бета нұсқасы кезінде
Dialogue: 0,0:14:40.87,0:14:44.42,Default,,0,0,0,,Тіпті мұнда жәдігерлерді табуға маманданған бір жігіт болды.
Dialogue: 0,0:14:44.50,0:14:47.63,Default,,0,0,0,,Мені құрметпен ``Геровар'' деп атады.
Dialogue: 0,0:14:47.72,0:14:50.18,Default,,0,0,0,,Бұл құрметті атақ па деп ойлаймын...
Dialogue: 0,0:14:50.68,0:14:54.64,Default,,0,0,0,,Бірақ мен өз күшімізбен соншалықты көп жинай алғанымыз жақсы болды ма деп ойлаймын.
Dialogue: 0,0:14:54.72,0:14:55.89,Default,,0,0,0,,Сіз өте мейірімдісіз.
Dialogue: 0,0:14:55.97,0:14:57.35,Default,,0,0,0,,Ха... иә?
Dialogue: 0,0:14:57.43,0:14:59.98,Default,,0,0,0,,Эй... Мен шынымен...
Dialogue: 0,0:15:00.06,0:15:02.19,Default,,0,0,0,,Асунаның алаңдайтын ештеңесі жоқ.
Dialogue: 0,0:15:02.27,0:15:03.86,Default,,0,0,0,,Біздің жаңадан алғанымыз
Dialogue: 0,0:15:03.94,0:15:06.48,Default,,0,0,0,,Осы қалада құлаған барлық жәдігерлерді ескере отырып,
Dialogue: 0,0:15:06.57,0:15:08.24,Default,,0,0,0,,Бұл аз ғана сома.
Dialogue: 0,0:15:08.32,0:15:12.20,Default,,0,0,0,,Біріншіден, қаладағы жәдігерлерді жинау - бұл жерде қазына іздеу.
Dialogue: 0,0:15:12.28,0:15:13.95,Default,,0,0,0,,Бұл жай ғана бонус.
Dialogue: 0,0:15:14.03,0:15:16.79,Default,,0,0,0,,Иә? Бұл нені білдіреді?
Dialogue: 0,0:15:16.87,0:15:20.50,Default,,0,0,0,,Мұнда керемет үлкен катакомба бар...
Dialogue: 0,0:15:20.58,0:15:22.88,Default,,0,0,0,,Басқаша айтқанда, зындан жайылған.
Dialogue: 0,0:15:22.96,0:15:24.96,Default,,0,0,0,,Қазына іздеу - сүйікті
Dialogue: 0,0:15:25.04,0:15:29.34,Default,,0,0,0,,Шынымды айтсам, қаланың айналасында табуға болатын жәдігерлер таң қалдырады.
Dialogue: 0,0:15:29.42,0:15:31.38,Default,,0,0,0,,ше? иә?
Dialogue: 0,0:15:31.47,0:15:33.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:33.39,0:15:35.43,Default,,0,0,0,,Мұны істе... алдымен!
Dialogue: 0,0:15:35.93,0:15:38.10,Default,,0,0,0,,Айт!
Dialogue: 0,0:15:38.18,0:15:39.35,Default,,0,0,0,,Аһ!
Dialogue: 0,0:15:39.85,0:15:41.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:41.31,0:15:44.48,Default,,0,0,0,,Ол ауқымда болса да, Асунаның ілгегі қандай да бір тиімді.
Dialogue: 0,0:15:47.27,0:15:51.90,Default,,0,0,0,,Олай болса, фестивальді көгергенше жалғастырамыз ба?
Dialogue: 0,0:15:52.49,0:15:55.95,Default,,0,0,0,,Мен жоғарыда айтқан катакомбаларға баспалдақтар бар.
Dialogue: 0,0:15:56.03,0:15:58.54,Default,,0,0,0,,Төменге көбірек түсу бар ма?
Dialogue: 0,0:15:58.62,0:16:00.96,Default,,0,0,0,,Иә, тек монеталар ғана емес.
Dialogue: 0,0:16:01.04,0:16:03.42,Default,,0,0,0,,Сиқырлы әсерлері бар сақиналар мен алқалар...
Dialogue: 0,0:16:03.50,0:16:05.33,Default,,0,0,0,,Сақина? алқа?
Dialogue: 0,0:16:05.42,0:16:08.09,Default,,0,0,0,,Иә, астральды типтер көп шығады.
Dialogue: 0,0:16:08.17,0:16:09.88,Default,,0,0,0,,Сіз екінші жертөле қабатында қалағаныңызша ала аласыз.
Dialogue: 0,0:16:09.96,0:16:11.97,Default,,0,0,0,,Қалағаныңызша алыңыз...
Dialogue: 0,0:16:12.47,0:16:14.72,Default,,0,0,0,,А, астральды тип?
Dialogue: 0,0:16:14.80,0:16:19.01,Default,,0,0,0,,Бұл құбыжықтың түрі. Сіз жәндіктер немесе жарты адам түрі дейсіз бе?
Dialogue: 0,0:16:19.10,0:16:22.06,Default,,0,0,0,,Астральды түрі затсыз елес сияқты...
Dialogue: 0,0:16:22.14,0:16:23.27,Default,,0,0,0,,Нет!
Dialogue: 0,0:16:23.77,0:16:25.94,Default,,0,0,0,,Нгг... уф...
Dialogue: 0,0:16:30.61,0:16:32.44,Default,,0,0,0,,Қазір «nie» дегеніміз не?
Dialogue: 0,0:16:33.28,0:16:34.82,Default,,0,0,0,,Орыс тіліндегі «Жоқ».
Dialogue: 0,0:16:34.91,0:16:36.45,Default,,0,0,0,,Жоқ деген не?
Dialogue: 0,0:16:36.53,0:16:40.91,Default,,0,0,0,,Яғни... спойлер жоқ!
Dialogue: 0,0:16:42.75,0:16:45.62,Default,,0,0,0,,Жарайды, оның қандай жер екенін алдын ала білсем.
Dialogue: 0,0:16:45.71,0:16:47.84,Default,,0,0,0,,Бұл ойынның қызығын екіге азайтуы мүмкін.
Dialogue: 0,0:16:47.92,0:16:51.26,Default,,0,0,0,,Иә, онда Асуна катакомбаларға бірінші болып бара алады.
Dialogue: 0,0:16:51.34,0:16:53.51,Default,,0,0,0,,-Мм... уф... -Хмм?
Dialogue: 0,0:16:55.01,0:16:55.93,Default,,0,0,0,,
Dialogue: 0,0:16:56.01,0:16:57.09,Default,,0,0,0,,И-иә… дұрыс
Dialogue: 0,0:16:57.18,0:17:00.64,Default,,0,0,0,,Онда мен саған мұны істеуге рұқсат етемін. Дайынсың ба?
Dialogue: 0,0:17:00.72,0:17:02.52,Default,,0,0,0,,Мен әрқашанмын
Dialogue: 0,0:17:03.48,0:17:04.73,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:17:04.81,0:17:06.56,Default,,0,0,0,,Олай болса кеттік!
Dialogue: 0,0:17:11.15,0:17:12.28,Default,,0,0,0,,О!
Dialogue: 0,0:17:20.37,0:17:21.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:24.87,0:17:27.33,Default,,0,0,0,,Құлаған тас жолды жауып тұр...
Dialogue: 0,0:17:35.72,0:17:36.80,Default,,0,0,0,,Асуна
Dialogue: 0,0:17:36.88,0:17:37.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:12.17,0:18:14.13,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:18:21.39,0:18:23.26,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:18:23.35,0:18:25.39,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:18:25.47,0:18:26.73,Default,,0,0,0,,Хехехе
Dialogue: 0,0:18:26.81,0:18:28.52,Default,,0,0,0,,Қатты ашуланбаңыз!
Dialogue: 0,0:18:28.60,0:18:30.52,Default,,0,0,0,,Ол құламайды!
Dialogue: 0,0:18:32.65,0:18:33.52,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:18:33.61,0:18:36.44,Default,,0,0,0,,Қабырғалардың жанында тұзақтар болуы мүмкін, сондықтан абай болыңыз.
Dialogue: 0,0:18:36.53,0:18:39.53,Default,,0,0,0,,Сондай-ақ, біз ауқымнан тыспыз, сондықтан құбыжықтар пайда болады.
Dialogue: 0,0:18:39.61,0:18:41.16,Default,,0,0,0,,Мүмкін сіз, мырза, сөгіс естігенді ұнататын сол қиын мінезді жандардың бірісіз бе?
Dialogue: 0,0:18:41.24,0:18:44.12,Default,,0,0,0,,Атап айтқанда, Қайғылы қасірет кенеттен пайда болады.
Dialogue: 0,0:18:45.87,0:18:50.12,Default,,0,0,0,,Шотландия фольклорында жындар кездеседі...
Dialogue: 0,0:18:50.21,0:18:52.00,Default,,0,0,0,,Бұл егжей-тегжейлі.
Dialogue: 0,0:18:52.08,0:18:54.80,Default,,0,0,0,,Дұрыс, мен жоғарыда айтқан елес типті құбыжық.
Dialogue: 0,0:18:54.88,0:18:55.84,Default,,0,0,0,,Елес…
Dialogue: 0,0:18:55.92,0:18:57.84,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:18:57.92,0:18:59.01,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:59.63,0:19:01.22,Default,,0,0,0,,Сәлем... Сәлем...
Dialogue: 0,0:19:09.23,0:19:11.15,Default,,0,0,0,,Ах... жарық...
Dialogue: 0,0:19:12.40,0:19:14.48,Default,,0,0,0,,Ах... Рахмет, Кирито-кун...
Dialogue: 0,0:19:16.02,0:19:17.57,Default,,0,0,0,,Асуна! Сақ болыңыз!
Dialogue: 0,0:19:23.82,0:19:24.66,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,0:19:33.46,0:19:36.59,Default,,0,0,0,,Жоқ, жоқ, жоқ, тоқта, тоқта, тоқта...
Dialogue: 0,0:19:37.09,0:19:39.13,Default,,0,0,0,,- Сәлем! -Асуна!
Dialogue: 0,0:19:46.51,0:19:47.76,Default,,0,0,0,,(Қайғылы уайымның айқайы)
Dialogue: 0,0:19:47.85,0:19:48.68,Default,,0,0,0,,Ай!
Dialogue: 0,0:19:49.77,0:19:51.39,Default,,0,0,0,,А-а, уау!
Dialogue: 0,0:19:53.69,0:19:55.23,Default,,0,0,0,,Асуна!
Dialogue: 0,0:20:00.82,0:20:02.03,Default,,0,0,0,,Ах кутсу
Dialogue: 0,0:20:07.58,0:20:10.54,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:20:11.66,0:20:12.50,Default,,0,0,0,,Ha
Dialogue: 0,0:20:16.21,0:20:17.17,Default,,0,0,0,,(айқай)
Dialogue: 0,0:20:23.05,0:20:24.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:27.05,0:20:28.18,Default,,0,0,0,,(Сли Шлюманның айқайы)
Dialogue: 0,0:20:28.76,0:20:29.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:30.93,0:20:33.35,Default,,0,0,0,,Өтірік! Бір минут күтіңіз!
Dialogue: 0,0:20:37.40,0:20:39.57,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін...
Dialogue: 0,0:20:46.03,0:20:47.16,Default,,0,0,0,,Кешір...
Dialogue: 0,0:20:48.08,0:20:49.49,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:20:50.87,0:20:52.04,Default,,0,0,0,,(Итадори) Ол менің жұдырығымды толық жеделдемей тұрып маңдайына алды!
Dialogue: 0,0:20:54.33,0:20:56.63,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:21:06.97,0:21:07.97,Default,,0,0,0,,Ha
Dialogue: 0,0:21:09.51,0:21:10.51,Default,,0,0,0,,Ах
Dialogue: 0,0:21:16.60,0:21:18.23,Default,,0,0,0,,Я...
Dialogue: 0,0:21:18.86,0:21:21.48,Default,,0,0,0,,Маған хабар жіберіңізші!
Dialogue: 0,0:21:25.28,0:21:27.24,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:21:28.24,0:21:29.49,Default,,0,0,0,,Я...
Dialogue: 0,0:21:39.00,0:21:40.09,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:21:40.09,0:21:41.09,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:21:40.09,0:21:41.09,Default,,0,0,0,,(су тамшылардың дыбысы)
Dialogue: 0,0:21:41.09,0:21:45.59,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:21:45.63,0:21:47.34,Default,,0,0,0,,(дауыл дыбысы)
Dialogue: 0,0:21:47.43,0:21:48.84,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:21:55.77,0:21:57.27,Default,,0,0,0,,Кирито-кун...
Dialogue: 0,0:22:00.86,0:22:02.11,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:22:17.33,0:22:20.54,Default,,0,0,0,,Барлығын сол жерде қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:22:22.13,0:22:24.80,Default,,0,0,0,,Маған көмектесіңізші...
Dialogue: 0,0:22:39.44,0:22:41.10,Default,,0,0,0,,Осы арқылы сіз оны тартып алуыңыз керек.
Dialogue: 0,0:22:43.86,0:22:47.36,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:47.44,0:22:48.28,Default,,0,0,0,,келді
Dialogue: 0,0:22:51.32,0:22:53.58,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:23:07.51,0:23:08.88,Default,,0,0,0,,Хааааа!
Dialogue: 0,0:23:17.60,0:23:19.14,Default,,0,0,0,,Ондай емес пе...
Dialogue: 0,0:23:19.94,0:23:21.19,Default,,0,0,0,,Я...
Dialogue: 0,0:23:26.11,0:23:27.32,Default,,0,0,0,,(айқай)
Dialogue: 0,0:23:31.41,0:23:32.61,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:23:33.53,0:23:34.57,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:23:35.37,0:23:36.70,Default,,0,0,0,,Жоқ Жоқ…
Dialogue: 0,0:23:40.25,0:23:41.87,Default,,0,0,0,,Қайта емес...
Dialogue: 0,0:23:45.84,0:23:48.76,Default,,0,0,0,,Иә? «Мыжылған қағаз қалдықтары»?
Dialogue: 0,0:23:50.80,0:23:53.43,Default,,0,0,0,,Гуннуну...
Dialogue: 0,0:23:54.64,0:23:55.64,Default,,0,0,0,,Ha
Dialogue: 0,0:23:58.97,0:24:00.10,Default,,0,0,0,,Ах
Dialogue: 0,0:24:01.98,0:24:03.06,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:24:03.15,0:24:08.15,Default,,0,0,0,,22.00. 29...3-ші жертөледе...
Dialogue: 0,0:24:08.23,0:24:10.03,Default,,0,0,0,,Жақшадағы сандар...
Dialogue: 0,0:24:10.11,0:24:11.70,Default,,0,0,0,,Координаталар?
Dialogue: 0,0:24:11.78,0:24:14.28,Default,,0,0,0,,Біз зынданның ар жағында осылай кездесіп жатырмыз ба?
Dialogue: 0,0:24:19.54,0:24:20.70,Default,,0,0,0,,Жақын...
Dialogue: 0,0:24:23.75,0:24:26.75,Default,,0,0,0,,Қате жазғаным үшін лақтырдым дейсіз бе?
Dialogue: 0,0:24:27.42,0:24:29.92,Default,,0,0,0,,Оның тамырын құбыжық құртты ма?
Dialogue: 0,0:24:45.19,0:24:47.81,Default,,0,0,0,,Осы жерге кездесіп жүрген адамдар келсе
Dialogue: 0,0:24:47.90,0:24:50.44,Default,,0,0,0,,Мен толық войермін...
Dialogue: 0,0:24:52.78,0:24:54.70,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:24:54.78,0:24:55.78,Default,,0,0,0,,Ах
Dialogue: 0,0:25:17.30,0:25:19.43,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:25:30.11,0:25:32.69,Default,,0,0,0,,Сәлем балалар~ Бүгін ерте, солай емес пе?
Dialogue: 0,0:25:32.78,0:25:34.90,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:25:34.99,0:25:37.03,Default,,0,0,0,,Маған көп күтудің қажеті жоқ.
Dialogue: 0,0:25:37.11,0:25:39.28,Default,,0,0,0,,Бұл жерге жетудің өзі азап.
Dialogue: 0,0:25:39.37,0:25:42.54,Default,,0,0,0,,Егер сіз жалқау болсаңыз, кездесуге арналған қолжазба жазбасы да бар.
Dialogue: 0,0:25:42.62,0:25:46.04,Default,,0,0,0,,Бұл өте қиын және мен бұл қаламда жақсы емеспін.
Dialogue: 0,0:25:46.12,0:25:48.17,Default,,0,0,0,,Хабар алмасу қазір жақсы.
Dialogue: 0,0:25:48.25,0:25:50.34,Default,,0,0,0,,Даме, жоқ.
Dialogue: 0,0:25:50.42,0:25:53.88,Default,,0,0,0,,Хабарлар тізімінде тарих қалды емес пе?
Dialogue: 0,0:25:53.96,0:25:57.47,Default,,0,0,0,,Олай болса, тура сөзге көшейік.
Dialogue: 0,0:25:57.97,0:26:00.43,Default,,0,0,0,,Мысал әңгіме Не болды?
Dialogue: 0,0:26:00.51,0:26:02.89,Default,,0,0,0,,А, бұл жұмыс істеді.
Dialogue: 0,0:26:02.97,0:26:04.39,Default,,0,0,0,,``ALS'' негізгі күші болып табылады
Dialogue: 0,0:26:04.47,0:26:07.31,Default,,0,0,0,,Келесі күні бірлескен кері санақ оқиғасы толық
Dialogue: 0,0:26:07.39,0:26:09.56,Default,,0,0,0,,Бірден лабиринт ауданынан өтуді мақсат ету
Dialogue: 0,0:26:09.65,0:26:11.36,Default,,0,0,0,,Оқиғаны ашу арқылы лабиринт аймағын жарып шығу?
Dialogue: 0,0:26:11.36,0:26:13.07,Default,,0,0,0,,Оқиғаны ашу арқылы лабиринт аймағын жарып шығу?
Dialogue: 0,0:26:11.36,0:26:13.07,Default,,0,0,0,,Иә, иә, бұл жақсы сезінеді.
Dialogue: 0,0:26:13.07,0:26:14.82,Default,,0,0,0,,Иә, иә, бұл жақсы сезінеді.
Dialogue: 0,0:26:14.90,0:26:15.57,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:26:15.57,0:26:16.11,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:26:15.57,0:26:16.11,Default,,0,0,0,,Киба-чан мен Рин-чан
Dialogue: 0,0:26:16.11,0:26:17.03,Default,,0,0,0,,Киба-чан мен Рин-чан
Dialogue: 0,0:26:17.11,0:26:19.95,Default,,0,0,0,,Бізге мұнда да, жерде де соғу керек.
Dialogue: 0,0:26:20.03,0:26:21.24,Default,,0,0,0,,Қызықсыз, солай емес пе?
Dialogue: 0,0:26:21.32,0:26:23.45,Default,,0,0,0,,Оны оңай айтпа.
Dialogue: 0,0:26:23.54,0:26:27.33,Default,,0,0,0,,Гильдия жиналысына жетекшілік ету өте қиын.
Dialogue: 0,0:26:27.41,0:26:29.50,Default,,0,0,0,,Мен білемін~
Dialogue: 0,0:26:29.58,0:26:33.17,Default,,0,0,0,,Бірақ міне, бұл үшін керемет сөйлесу техникасы.
Dialogue: 0,0:26:33.25,0:26:36.05,Default,,0,0,0,,Басы жақсы дайындалған, солай емес пе?
Dialogue: 0,0:26:36.13,0:26:37.17,Default,,0,0,0,,Жақсы
Dialogue: 0,0:26:37.26,0:26:40.93,Default,,0,0,0,,Бірін-бірі өлтіруге дейін итермелеу
Dialogue: 0,0:26:41.01,0:26:42.64,Default,,0,0,0,,Мен сенің барғаныңды қалаймын.
Dialogue: 0,0:26:42.72,0:26:43.97,Default,,0,0,0,,Бір-бірін өлтіру?
Dialogue: 0,0:26:44.06,0:26:45.93,Default,,0,0,0,,Бірақ тек бастың ойы
Dialogue: 0,0:26:46.02,0:26:48.60,Default,,0,0,0,,Мен оны әлі оқи алмаймын.
Dialogue: 0,0:26:48.69,0:26:51.35,Default,,0,0,0,,Неге мұндай айналмалы әрекет жасайсың?
Dialogue: 0,0:26:51.44,0:26:55.11,Default,,0,0,0,,Аа, дәл қазір біз әлі тұқым себеміз.
Dialogue: 0,0:26:55.19,0:26:57.11,Default,,0,0,0,,Асығыс болсаң, көңілді фестиваль де бар
Dialogue: 0,0:26:57.19,0:26:59.36,Default,,0,0,0,,Біраз уақыттан кейін бітеді, солай ма?
Dialogue: 0,0:26:59.45,0:27:02.24,Default,,0,0,0,,Мен білемін. Процесстен де рахат алыңыз, солай ма?
Dialogue: 0,0:27:02.24,0:27:03.20,Default,,0,0,0,,Процесс сізге ұнайтынын білемін, солай ма?
Dialogue: 0,0:27:02.24,0:27:03.20,Default,,0,0,0,,(домалақ тастардың дыбысы)
Dialogue: 0,0:27:03.28,0:27:04.16,Default,,0,0,0,,Ha
Dialogue: 0,0:27:04.24,0:27:05.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:07.87,0:27:09.91,Default,,0,0,0,,Сіз бірдеңе естідіңіз бе?
Dialogue: 0,0:27:10.00,0:27:10.87,Default,,0,0,0,,О
Dialogue: 0,0:27:10.96,0:27:14.25,Default,,0,0,0,,Егер менің құпия әңгімемді біреу естісе,
Dialogue: 0,0:27:14.34,0:27:15.84,Default,,0,0,0,,Бұл үлкен сорақылық
Dialogue: 0,0:27:30.81,0:27:34.86,Default,,0,0,0,,Тез, тез, тез кел...
Dialogue: 0,0:27:39.94,0:27:40.82,Default,,0,0,0,,Ах
Dialogue: 0,0:27:40.90,0:27:41.78,Default,,0,0,0,,Ha
Dialogue: 0,0:27:41.86,0:27:43.49,Default,,0,0,0,,Уау! Бұл не жігіт?
Dialogue: 0,0:27:43.57,0:27:45.49,Default,,0,0,0,,Ей, қыдырма!
Dialogue: 0,0:27:43.57,0:27:45.49,Default,,0,0,0,,(Шлюманның айқайы)
Dialogue: 0,0:27:45.49,0:27:45.58,Default,,0,0,0,,(Шлюманның айқайы)
Dialogue: 0,0:27:45.58,0:27:46.66,Default,,0,0,0,,(Шлюманның айқайы)
Dialogue: 0,0:27:45.58,0:27:46.66,Default,,0,0,0,,Ахаха
Dialogue: 0,0:27:46.66,0:27:46.74,Default,,0,0,0,,(Шлюманның айқайы)
Dialogue: 0,0:27:46.74,0:27:48.79,Default,,0,0,0,,(Шлюманның айқайы)
Dialogue: 0,0:27:46.74,0:27:48.79,Default,,0,0,0,,Бұл шығуды бір сәтке блоктаңыз.
Dialogue: 0,0:27:48.87,0:27:50.08,Default,,0,0,0,,Хехе
Dialogue: 0,0:27:54.67,0:27:58.25,Default,,0,0,0,,Уау, бұл оның қадамдары немесе басқалары болуы керек.
Dialogue: 0,0:27:58.34,0:28:00.92,Default,,0,0,0,,Бұл маршрутизаторлар өте жиіркенішті.
Dialogue: 0,0:28:01.01,0:28:03.51,Default,,0,0,0,,Бұл жігіттер бета нұсқасы кезінде де пайда болды ма?
Dialogue: 0,0:28:03.59,0:28:06.39,Default,,0,0,0,,Бірақ мен кейде басқа ойыншылар түсірген қаруды қолданамын.
Dialogue: 0,0:28:06.47,0:28:10.10,Default,,0,0,0,,Бұл дәмді болды...
Dialogue: 0,0:28:10.81,0:28:13.06,Default,,0,0,0,,Әй, әй, мен айтқан жақтан.
Dialogue: 0,0:28:14.23,0:28:17.65,Default,,0,0,0,,О, шынымен! Бұл сирек көрінетін рапира.
Dialogue: 0,0:28:17.73,0:28:18.57,Default,,0,0,0,,Ha
Dialogue: 0,0:28:19.98,0:28:21.95,Default,,0,0,0,,Уау, бұл ауыр!
Dialogue: 0,0:28:22.03,0:28:23.70,Default,,0,0,0,,Техникалық сипаттамалар...
Dialogue: 0,0:28:24.24,0:28:27.95,Default,,0,0,0,,Шоу! Шынайы ма? Бұл шабуылдың күші қандай?
Dialogue: 0,0:28:28.03,0:28:30.29,Default,,0,0,0,,Бұл екі қолды қару сияқты.
Dialogue: 0,0:28:30.37,0:28:32.12,Default,,0,0,0,,Иә~ Шынымен бе?
Dialogue: 0,0:28:32.21,0:28:34.46,Default,,0,0,0,,Эй, сенің реакцияң баяу.
Dialogue: 0,0:28:34.54,0:28:37.09,Default,,0,0,0,,Егер сізді қызықтырмаса, маған беріңіз.
Dialogue: 0,0:28:37.17,0:28:40.71,Default,,0,0,0,,Аа, сен қанжар қолданушы емессің бе?
Dialogue: 0,0:28:40.80,0:28:42.30,Default,,0,0,0,,Бұлшықет күші жеткілікті ме?
Dialogue: 0,0:28:44.26,0:28:48.93,Default,,0,0,0,,Егер мен бұл қылышты қолдана алмасам, мен семсершіге айналамын.
Dialogue: 0,0:28:49.01,0:28:51.85,Default,,0,0,0,,Аты... Күміс рапира?
Dialogue: 0,0:28:51.93,0:28:53.39,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:28:53.48,0:28:57.77,Default,,0,0,0,,Мұқият қара, бұл «Шибаррик»
Dialogue: 0,0:29:00.90,0:29:02.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:02.40,0:29:03.53,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:29:06.57,0:29:07.57,Default,,0,0,0,,Ha
Dialogue: 0,0:29:07.66,0:29:10.20,Default,,0,0,0,,Сіз онда қанша уақыт болдыңыз?
Dialogue: 0,0:29:10.29,0:29:11.95,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:29:12.04,0:29:14.41,Default,,0,0,0,,Мен сіздің сөйлескеніңізді естідім.
Dialogue: 0,0:29:14.50,0:29:16.96,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:29:17.04,0:29:19.17,Default,,0,0,0,,Негізгі үзіндіге жетпейтін көлемде
Dialogue: 0,0:29:19.25,0:29:21.00,Default,,0,0,0,,Мен сөйлеп тұрмын деп ойладым.
Dialogue: 0,0:29:21.09,0:29:24.30,Default,,0,0,0,,Сирек кездесетін қарудың түсуіне байланысты толқуыңыз артқан сияқты.
Dialogue: 0,0:29:24.38,0:29:25.88,Default,,0,0,0,,Ахахахаха
Dialogue: 0,0:29:25.97,0:29:28.39,Default,,0,0,0,,Бұл сирек қару
Dialogue: 0,0:29:28.47,0:29:31.81,Default,,0,0,0,,Сіз жай ғана Sybarric Rapier деп айтпадыңыз ба?
Dialogue: 0,0:29:31.89,0:29:33.10,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:29:33.18,0:29:36.85,Default,,0,0,0,,Ой, бір рет тыңдаған соң есіме түсті.
Dialogue: 0,0:29:36.94,0:29:38.81,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:29:38.90,0:29:42.28,Default,,0,0,0,,Ол рапираны менің серіктесім жабдықтады.
Dialogue: 0,0:29:42.36,0:29:43.53,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:29:43.61,0:29:48.45,Default,,0,0,0,,Осыны айтып тұрсыз ба? Бұл досыңның қаруы, сондықтан оны қайтар.
Dialogue: 0,0:29:48.53,0:29:51.95,Default,,0,0,0,,Жоқ, мен мұндай қиын әдетке айналдырғым келмейді.
Dialogue: 0,0:29:52.04,0:29:52.87,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:29:54.00,0:29:57.25,Default,,0,0,0,,Сіз менің серіктесіме дуэль PK жібердіңіз.
Dialogue: 0,0:29:57.33,0:30:01.46,Default,,0,0,0,,Мүмкін сенде бұл қылыш бар шығар, Морт.
Dialogue: 0,0:30:02.71,0:30:05.97,Default,,0,0,0,,Аха... Түсіндім. Мен түсінемін.
Dialogue: 0,0:30:06.05,0:30:11.30,Default,,0,0,0,,Төменгі деңгейлерде саған жасағаным сияқты...?
Dialogue: 0,0:30:11.39,0:30:12.76,Default,,0,0,0,,Кирито-сан
Dialogue: 0,0:30:21.27,0:30:22.36,Default,,0,0,0,,Ha
Dialogue: 0,0:30:29.45,0:30:30.87,Default,,0,0,0,,(айқай)
Dialogue: 0,0:30:30.95,0:30:33.08,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:30:33.16,0:30:35.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:36.75,0:30:38.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:42.63,0:30:43.80,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:30:43.88,0:30:44.88,Default,,0,0,0,,(айқай)
Dialogue: 0,0:30:56.43,0:30:58.10,Default,,0,0,0,,Не... Не... Не... Қайдан шықты?
Dialogue: 0,0:30:58.10,0:31:00.31,Default,,0,0,0,,Не... Не... Қайдан шықты?
Dialogue: 0,0:30:58.10,0:31:00.31,Default,,0,0,0,,(Морте күлкі)
Dialogue: 0,0:31:00.40,0:31:02.52,Default,,0,0,0,,Ой, күтпеген «Уау!»
Dialogue: 0,0:31:02.61,0:31:04.32,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:31:04.40,0:31:06.90,Default,,0,0,0,,Сіз сонда қанша уақыт болдыңыз?
Dialogue: 0,0:31:08.40,0:31:10.41,Default,,0,0,0,,О, жақсысың ба?
Dialogue: 0,0:31:10.49,0:31:14.24,Default,,0,0,0,,Менің өмірім 3 секундқа қысқарды, себебі артымнан қорқытты.
Dialogue: 0,0:31:14.33,0:31:17.33,Default,,0,0,0,,Маған осыншама көп нәрсені айтып берсеңіз жақсы болар еді деп ойлаймын.
Dialogue: 0,0:31:17.41,0:31:20.83,Default,,0,0,0,,Мен қатты ашуландым.
Dialogue: 0,0:31:20.92,0:31:23.59,Default,,0,0,0,,Енді бұл туралы айтатын уақыт емес.
Dialogue: 0,0:31:23.67,0:31:26.80,Default,,0,0,0,,Барлығы сұралды деген болжаммен жауап беруден басқа амалыңыз жоқ.
Dialogue: 0,0:31:26.88,0:31:28.55,Default,,0,0,0,,Сабырсыздық – жаман мінез.
Dialogue: 0,0:31:28.63,0:31:31.93,Default,,0,0,0,,Сіз сол рапирадағы ерекшеліктерді көрдіңіз бе?
Dialogue: 0,0:31:32.01,0:31:36.26,Default,,0,0,0,,Мен жалқау PvP әуесқой әйелден жеңіле алмаймын.
Dialogue: 0,0:31:36.35,0:31:39.60,Default,,0,0,0,,Және менің баримон рапирім
Dialogue: 0,0:31:39.68,0:31:43.48,Default,,0,0,0,,Мен оны кездейсоқ қалдырып, мені алып кеткендей үйге баруым керек пе?
Dialogue: 0,0:32:00.46,0:32:01.92,Default,,0,0,0,,Аһ!
Dialogue: 0,0:32:02.00,0:32:04.08,Default,,0,0,0,,А...ха
Dialogue: 0,0:32:04.17,0:32:05.08,Default,,0,0,0,,Әй?
Dialogue: 0,0:32:05.17,0:32:06.84,Default,,0,0,0,,(Жақындап келе жатқан құбыжықтар тобының дыбысы)
Dialogue: 0,0:32:06.92,0:32:10.67,Default,,0,0,0,,Қат! Топты тарту үшін айқайлаңыз және оларды соққыға жығыңыз.
Dialogue: 0,0:32:10.76,0:32:12.84,Default,,0,0,0,,Бұл кір! Мұны істеудің жолы!
Dialogue: 0,0:32:12.93,0:32:16.18,Default,,0,0,0,,Ахаха, сен солай айтасың ба?
Dialogue: 0,0:32:16.26,0:32:18.81,Default,,0,0,0,,Жарайды, әзірше шығарып алайық.
Dialogue: 0,0:32:18.89,0:32:20.81,Default,,0,0,0,,Цк, мен көмектесе алмаймын.
Dialogue: 0,0:32:20.89,0:32:21.73,Default,,0,0,0,,(Қашып кету)
Dialogue: 0,0:32:40.29,0:32:41.29,Default,,0,0,0,,Я...
Dialogue: 0,0:32:48.09,0:32:48.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:59.68,0:33:03.60,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз. Аман екеніңізге қуаныштымын...
Dialogue: 0,0:33:03.69,0:33:04.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:05.48,0:33:08.86,Default,,0,0,0,,Қорқынышты болды... Шынымен де қорқынышты болды...
Dialogue: 0,0:33:09.48,0:33:12.11,Default,,0,0,0,,Елес пайда болып, шұңқырға құлады.
Dialogue: 0,0:33:12.19,0:33:14.07,Default,,0,0,0,,Мен жолды білмеймін ...
Dialogue: 0,0:33:14.70,0:33:18.83,Default,,0,0,0,,Мен рапиамнан айырылып қалдым және бұл жақсы емес деп ойладым.
Dialogue: 0,0:33:18.91,0:33:22.95,Default,,0,0,0,,Бәрі осылай қараңғы үңгірде аяқталады...
Dialogue: 0,0:33:23.04,0:33:27.25,Default,,0,0,0,,Сосын мен қорықтым, қорқып кеттім... шынымен қорықтым...
Dialogue: 0,0:33:27.33,0:33:30.34,Default,,0,0,0,,Жарайды... енді жақсы.
Dialogue: 0,0:33:31.42,0:33:36.80,Default,,0,0,0,,Егер мен адасып қалсам, міндетті түрде сені тауып, көмекке келемін.
Dialogue: 0,0:33:37.34,0:33:40.60,Default,,0,0,0,,Өйткені Асуна менің серіктесім.
Dialogue: 0,0:33:42.89,0:33:44.02,Default,,0,0,0,,Иә
Dialogue: 0,0:33:58.99,0:34:01.62,Default,,0,0,0,,Хафурухохи~
Dialogue: 0,0:34:01.70,0:34:04.08,Default,,0,0,0,,Фуруруру~
Dialogue: 0,0:34:05.04,0:34:07.79,Default,,0,0,0,,Ха~ Рахмет Ах-чан
Dialogue: 0,0:34:07.87,0:34:10.08,Default,,0,0,0,,Мені осындай жақсы ваннаға шақырғаның үшін рахмет.
Dialogue: 0,0:34:10.17,0:34:11.59,Default,,0,0,0,,Жоқ
Dialogue: 0,0:34:11.67,0:34:15.55,Default,,0,0,0,,Мен де Арго-санға ризашылығымды дұрыс жеткізгім келді.
Dialogue: 0,0:34:15.63,0:34:19.64,Default,,0,0,0,,Жоқ, жоқ, бұл маңызды мәселе емес.
Dialogue: 0,0:34:19.72,0:34:24.52,Default,,0,0,0,,Не керек, сіз кеше мазасыз адамдарды кездестірдіңіз бе?
Dialogue: 0,0:34:24.60,0:34:25.68,Default,,0,0,0,,Иә...
Dialogue: 0,0:34:25.77,0:34:28.27,Default,,0,0,0,,А-чанның аман қалғанына қуаныштымын.
Dialogue: 0,0:34:28.35,0:34:31.23,Default,,0,0,0,,Мен де оларды қуып келемін.
Dialogue: 0,0:34:31.31,0:34:33.82,Default,,0,0,0,,Егер мен бірдеңе білсем, мен сізге хабарлаймын.
Dialogue: 0,0:34:33.90,0:34:35.23,Default,,0,0,0,,Сол Арго-сан
Dialogue: 0,0:34:35.32,0:34:37.20,Default,,0,0,0,,Хмм, не болды?
Dialogue: 0,0:34:37.28,0:34:41.66,Default,,0,0,0,,Мұндай адамдарды жалғыз тергеу тым қауіпті емес пе?
Dialogue: 0,0:34:44.45,0:34:46.20,Default,,0,0,0,,Аргоның мәліметі
Dialogue: 0,0:34:46.29,0:34:49.12,Default,,0,0,0,,Біз тек табысты ойыншылар емеспіз.
Dialogue: 0,0:34:49.21,0:34:52.79,Default,,0,0,0,,Кейінірек бастаулар қаласын тастап кеткен орта деңгейдегі ойыншылар үшін де.
Dialogue: 0,0:34:52.88,0:34:54.71,Default,,0,0,0,,Бұл өте пайдалы болды.
Dialogue: 0,0:34:55.21,0:34:57.59,Default,,0,0,0,,Аргоға бірдеңе болса ше?
Dialogue: 0,0:34:57.67,0:35:00.22,Default,,0,0,0,,Стратегияның өзі тоқтайтыны сонша
Dialogue: 0,0:35:00.30,0:35:04.81,Default,,0,0,0,,Сонымен... бұл оңайырақ.
Dialogue: 0,0:35:04.89,0:35:07.98,Default,,0,0,0,,Менің ойымша, бұл жалғыз Арго-сан үшін артық.
Dialogue: 0,0:35:08.06,0:35:09.69,Default,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:35:09.77,0:35:13.06,Default,,0,0,0,,Дос ретінде...
Dialogue: 0,0:35:14.82,0:35:16.48,Default,,0,0,0,,Рахмет сізге А-чан
Dialogue: 0,0:35:16.57,0:35:20.78,Default,,0,0,0,,Сенің мен үшін уайымдағаныңа мен өте қуаныштымын.
Dialogue: 0,0:35:20.86,0:35:24.83,Default,,0,0,0,,Бірақ мен өз денемді желіге қойып, ақпарат алуды жалғастыруым керек.
Dialogue: 0,0:35:24.91,0:35:26.20,Default,,0,0,0,,Сіз жауаптысыз ба?
Dialogue: 0,0:35:26.29,0:35:29.71,Default,,0,0,0,,Бұл ... ақпарат беруші ретінде дегенді білдіре ме?
Dialogue: 0,0:35:29.79,0:35:33.08,Default,,0,0,0,,Жоқ, бұрынғы бета-тестер ретінде.
Dialogue: 0,0:35:33.17,0:35:36.88,Default,,0,0,0,,Ах... Олай болса да, Арго жалғыз.
Dialogue: 0,0:35:36.96,0:35:39.92,Default,,0,0,0,,Сізге қауіпті рөлді алудың қажеті жоқ.
Dialogue: 0,0:35:40.01,0:35:42.64,Default,,0,0,0,,Тіпті Кирито-кун еден бастығы шайқасында.
Dialogue: 0,0:35:42.72,0:35:45.64,Default,,0,0,0,,Мен әрқашан «Стратегия тобының» рейдтеріне қатысамын.
Dialogue: 0,0:35:45.72,0:35:49.31,Default,,0,0,0,,Мм... Ах-чан мен үшін уайымдап отыр.
Dialogue: 0,0:35:49.39,0:35:53.06,Default,,0,0,0,,Daro, себебі мен жауынгерлік емес типтегі құрылысшымын?
Dialogue: 0,0:35:53.15,0:35:56.02,Default,,0,0,0,,Е... Иә, жақсы...
Dialogue: 0,0:35:56.11,0:35:57.73,Default,,0,0,0,,Нихи
Dialogue: 0,0:36:00.49,0:36:02.41,Default,,0,0,0,,Иносукэ… Иносукэ, өзіңді жина! Иносукэ!
Dialogue: 0,0:36:05.32,0:36:07.95,Default,,0,0,0,,Дәлел теориядан жақсы...
Dialogue: 0,0:36:08.04,0:36:10.25,Default,,0,0,0,,Ах-чан, байқап көрейік.
Dialogue: 0,0:36:10.33,0:36:12.21,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:36:12.29,0:36:14.67,Default,,0,0,0,,Әрине, бұл дуэль.
Dialogue: 0,0:36:14.75,0:36:17.30,Default,,0,0,0,,...артықтау ма?
Dialogue: 0,0:36:17.38,0:36:19.05,Default,,0,0,0,,Иә, Чамбара?
Dialogue: 0,0:36:19.13,0:36:21.80,Default,,0,0,0,,Дуэльге еліктеп көрейік
Dialogue: 0,0:36:21.88,0:36:23.05,Default,,0,0,0,,Мен... енді?
Dialogue: 0,0:36:23.72,0:36:24.55,Default,,0,0,0,,Әрине!
Dialogue: 0,0:36:24.64,0:36:27.89,Default,,0,0,0,,Неге... тым болмаса купальник кимейсің бе?
Dialogue: 0,0:36:27.97,0:36:31.39,Default,,0,0,0,,Не? Эй, сенде купальник жоқ па?
Dialogue: 0,0:36:31.48,0:36:34.02,Default,,0,0,0,,Онда мен қазір жетемін!
Dialogue: 0,0:36:35.19,0:36:38.98,Default,,0,0,0,,Хмм... Қызық, қандай ережелер бар?
Dialogue: 0,0:36:39.82,0:36:43.45,Default,,0,0,0,,Кім бірінші орындаса, сол жеңеді?
Dialogue: 0,0:36:43.53,0:36:45.57,Default,,0,0,0,,Бұл таза соққы дегенді білдіре ме?
Dialogue: 0,0:36:45.66,0:36:47.20,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:36:47.28,0:36:48.66,Default,,0,0,0,,У… у… Құдай-ай!
Dialogue: 0,0:36:50.95,0:36:53.33,Default,,0,0,0,,Шынымен де, кез келген уақытта ше?
Dialogue: 0,0:36:54.04,0:36:55.21,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:36:59.09,0:37:00.38,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:37:07.55,0:37:10.01,Default,,0,0,0,,А-чан күткендей.
Dialogue: 0,0:37:10.10,0:37:12.73,Default,,0,0,0,,Мен сені бірінші оқпен өлтіруді жоспарлап едім.
Dialogue: 0,0:37:12.81,0:37:15.85,Default,,0,0,0,,Өйткені бұл «беши» орнына «сис» болды.
Dialogue: 0,0:37:15.94,0:37:18.81,Default,,0,0,0,,Олай болса Чанбарамен жалғастырайық.
Dialogue: 0,0:37:25.66,0:37:26.57,Default,,0,0,0,,Эй!
Dialogue: 0,0:37:35.33,0:37:36.75,Default,,0,0,0,,Ха…
Dialogue: 0,0:37:38.58,0:37:40.54,Default,,0,0,0,,Бұл белгіде көрсетілмеген ғой, иә?
Dialogue: 0,0:37:41.84,0:37:43.09,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:37:51.26,0:37:52.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:02.02,0:38:03.44,Default,,0,0,0,,Няхахахаха
Dialogue: 0,0:38:03.53,0:38:05.32,Default,,0,0,0,,(Аргоның күлкісі)
Dialogue: 0,0:38:05.40,0:38:07.70,Default,,0,0,0,,(Асунаның күлуі)
Dialogue: 0,0:38:07.78,0:38:11.16,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:38:11.24,0:38:15.66,Default,,0,0,0,,Ху~ Жарайды, қызық болды.
Dialogue: 0,0:38:15.75,0:38:17.87,Default,,0,0,0,,Әрбір «шапалақ» бір рет
Dialogue: 0,0:38:17.96,0:38:20.63,Default,,0,0,0,,Чамбара тең түсті деуге бола ма?
Dialogue: 0,0:38:20.71,0:38:22.96,Default,,0,0,0,,Е... иә, әрине.
Dialogue: 0,0:38:23.05,0:38:28.05,Default,,0,0,0,,Ым, бұл судың үстінде жүгіру қандай да бір шеберліктің әсері болды ма?
Dialogue: 0,0:38:28.13,0:38:31.30,Default,,0,0,0,,Ал...
Dialogue: 0,0:38:31.39,0:38:34.81,Default,,0,0,0,,Мен әдетте ақпарат үшін ақы аламын, бірақ бұл жақсы.
Dialogue: 0,0:38:34.89,0:38:38.31,Default,,0,0,0,,Бұл шеберлік емес, жаттығудың нәтижесі.
Dialogue: 0,0:38:38.39,0:38:42.27,Default,,0,0,0,,Білесіз бе, сіз бала кезіңізде бассейнде жүзуге тырыспағансыз ба?
Dialogue: 0,0:38:42.36,0:38:47.36,Default,,0,0,0,,«Оң аяқ батпай тұрып, сол аяғыңызды алға қойсаңыз, су бетінде жүгіре аласыз» деген теория.
Dialogue: 0,0:38:47.45,0:38:49.91,Default,,0,0,0,,Ал... Мен мұны істеген сияқтымын.
Dialogue: 0,0:38:49.99,0:38:53.78,Default,,0,0,0,,Бәлкім, бұл дүниеде жасалуы мүмкін деп ойладым.
Dialogue: 0,0:38:53.87,0:38:57.79,Default,,0,0,0,,Сол күннен бастап мен күнде өзен жағасында немесе моншада жаттығатын болдым.
Dialogue: 0,0:38:57.87,0:39:01.50,Default,,0,0,0,,Мен 4 қадамға дейін жүгіре алдым.
Dialogue: 0,0:39:01.58,0:39:04.84,Default,,0,0,0,,Ал, жүйеден тыс дағдылар деп аталатындар бар.
Dialogue: 0,0:39:04.92,0:39:07.84,Default,,0,0,0,,Арго-сан соло барлаушы болады.
Dialogue: 0,0:39:07.92,0:39:10.47,Default,,0,0,0,,Сіз маған бұрын көрсеткен керемет жылдамдық
Dialogue: 0,0:39:10.55,0:39:11.47,Default,,0,0,0,,Өйткені ол бар, солай ма?
Dialogue: 0,0:39:12.14,0:39:15.47,Default,,0,0,0,,Дуэльде маған айтқың келгені осы емес пе?
Dialogue: 0,0:39:15.56,0:39:19.85,Default,,0,0,0,,Сіз бұлай айтқанда, мен өзімді тым тәкаппарлағандай сезінемін, бірақ...
Dialogue: 0,0:39:19.94,0:39:21.27,Default,,0,0,0,,Бірақ иә, әрине.
Dialogue: 0,0:39:21.35,0:39:24.57,Default,,0,0,0,,Төтенше жағдай орын алған жағдайда, қашып кетіңіз, сонда бәрі жақсы болады.
Dialogue: 0,0:39:24.65,0:39:26.53,Default,,0,0,0,,Менің бұл туралы ойлайтын бөліктерім бар.
Dialogue: 0,0:39:26.61,0:39:29.36,Default,,0,0,0,,Өзіңіздің қадамыңызды да қадағалаңыз.
Dialogue: 0,0:39:29.45,0:39:34.83,Default,,0,0,0,,Мені сәнді ваннаға шақырғаныңыз үшін алғыс білдіру үшін мен сізге тағы бір ақпаратты тегін беремін.
Dialogue: 0,0:39:34.91,0:39:37.04,Default,,0,0,0,,Иә?Иә
Dialogue: 0,0:39:37.12,0:39:38.62,Default,,0,0,0,,Ах-чан дәл қазір
Dialogue: 0,0:39:38.70,0:39:42.12,Default,,0,0,0,,Қауіпті барлауды жалғыз жүргізудің қажеті жоқ.
Dialogue: 0,0:39:42.21,0:39:44.67,Default,,0,0,0,,Тіпті Keybo, бұрынғы бета-тестер.
Dialogue: 0,0:39:44.75,0:39:47.84,Default,,0,0,0,,«Мен стратегиялық топқа қатысамын» дедіңіз бе?
Dialogue: 0,0:39:47.92,0:39:52.76,Default,,0,0,0,,Бірақ неге Keybo толық жеке ойыншы емес?
Dialogue: 0,0:39:52.84,0:39:55.30,Default,,0,0,0,,Бұл қауіп азайғандықтан емес деп ойлаймын.
Dialogue: 0,0:39:55.39,0:39:57.26,Default,,0,0,0,,Сонымен... не?
Dialogue: 0,0:39:57.35,0:39:58.39,Default,,0,0,0,,Шешілді.
Dialogue: 0,0:40:02.69,0:40:05.56,Default,,0,0,0,,Өйткені А-чан осында
Dialogue: 0,0:40:20.08,0:40:21.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:21.37,0:40:24.75,Default,,0,0,0,,Кирито-кун, мен шомылдым.
Dialogue: 0,0:40:24.83,0:40:27.00,Default,,0,0,0,,Арго ше?
Dialogue: 0,0:40:27.09,0:40:29.13,Default,,0,0,0,,Мен бір рет қайтамын
Dialogue: 0,0:40:29.21,0:40:31.22,Default,,0,0,0,,Ол: «Кей балаға сәлем айтыңыз» деді.
Dialogue: 0,0:40:31.30,0:40:32.84,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:40:33.34,0:40:36.72,Default,,0,0,0,,Бұл өте ұзақ ванна болды, сіз не туралы айттыңыз?
Dialogue: 0,0:40:36.80,0:40:38.76,Default,,0,0,0,,Ой... қыздар арасындағы әңгіме
Dialogue: 0,0:40:38.85,0:40:40.72,Default,,0,0,0,,Менің білгім келмейді.
Dialogue: 0,0:40:40.81,0:40:44.10,Default,,0,0,0,,Не? Бұл Арго мен мына Асуна дегенді білдіреді.
Dialogue: 0,0:40:44.19,0:40:46.27,Default,,0,0,0,,Қыздар сөйлейді?
Dialogue: 0,0:40:46.36,0:40:49.28,Default,,0,0,0,,Сол үшін мен саған қағып отырма деп айтып отырмын!
Dialogue: 0,0:40:49.36,0:40:51.90,Default,,0,0,0,,«Бұл Асуна» нені білдіреді?
Dialogue: 0,0:40:51.99,0:40:55.70,Default,,0,0,0,,Ой, жаман, жаман, бірақ күтпеген жағдай болды...
Dialogue: 0,0:40:55.78,0:40:56.95,Default,,0,0,0,,Сізге айтайын
Dialogue: 0,0:40:57.03,0:40:59.41,Default,,0,0,0,,Қыздар дегенді айтпаймыз!
Dialogue: 0,0:41:02.54,0:41:03.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:05.37,0:41:07.67,Default,,0,0,0,,- Неліктен? -иә?
Dialogue: 0,0:41:07.75,0:41:10.09,Default,,0,0,0,,Барлығымыз қолымыздан келгенше тырысайық
Dialogue: 0,0:41:10.17,0:41:14.09,Default,,0,0,0,,Мен сондай тамаша табиғатты көретін жерге келсем де.
Dialogue: 0,0:41:14.18,0:41:18.43,Default,,0,0,0,,Бұл екеуі екі үлкен гильдияны қайшылыққа түсіретін бірдеңе жасады...
Dialogue: 0,0:41:19.68,0:41:22.10,Default,,0,0,0,,Өйткені бұл 《SAO》 стратегиясы
Dialogue: 0,0:41:22.18,0:41:24.06,Default,,0,0,0,,Кедергі жасаумен бірдей емес
Dialogue: 0,0:41:24.14,0:41:27.02,Default,,0,0,0,,Оның үстіне адамдар Мортқа телефон соқты
Dialogue: 0,0:41:27.10,0:41:29.11,Default,,0,0,0,,Кибау мырза мен Линд мырзаға
Dialogue: 0,0:41:29.19,0:41:31.32,Default,,0,0,0,,Олар бір-бірімізді өлтіргенімізді қалайды...
Dialogue: 0,0:41:31.40,0:41:34.45,Default,,0,0,0,,Мұны істеудің мәні неде?
Dialogue: 0,0:41:36.61,0:41:38.41,Default,,0,0,0,,Сондықтан өзіңді де кінәлама
Dialogue: 0,0:41:38.49,0:41:41.04,Default,,0,0,0,,ПК тобы – осындай адамдар.
Dialogue: 0,0:41:41.12,0:41:42.70,Default,,0,0,0,,PK?
Dialogue: 0,0:41:42.79,0:41:44.62,Default,,0,0,0,,Ойыншы өлтіруші
Dialogue: 0,0:41:44.71,0:41:46.62,Default,,0,0,0,,Яғни, бұл дүниеде өлтіруші.
Dialogue: 0,0:41:46.71,0:41:47.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:41:47.63,0:41:50.63,Default,,0,0,0,,Асуна, есіңізде болсын.
Dialogue: 0,0:41:50.71,0:41:54.67,Default,,0,0,0,,Бұл қалқымалы құлып Айнкрадтың ойын стратегиясы бар.
Dialogue: 0,0:41:54.76,0:41:57.22,Default,,0,0,0,,П.Қ.-ға құмар топ бар.
Dialogue: 0,0:41:57.89,0:42:01.18,Default,,0,0,0,,Бұл... неге олай етесің?
Dialogue: 0,0:42:01.26,0:42:05.81,Default,,0,0,0,,Ойыншыны осы дүниеде өлтірсеңіз, шын әлемде өлесіз.
Dialogue: 0,0:42:05.89,0:42:09.69,Default,,0,0,0,,А, сондықтан олар мұнда айып добын ойнағысы келеді.
Dialogue: 0,0:42:09.77,0:42:13.36,Default,,0,0,0,,Жоқ... біреуді өлтіргісі келетін шығар.
Dialogue: 0,0:42:15.07,0:42:17.45,Default,,0,0,0,,Мен сенімен келесі жолы дұрыс сөйлесемін.
Dialogue: 0,0:42:17.53,0:42:20.45,Default,,0,0,0,,Дәл қазір ең алдымен Кибау мен оның достарының жабайы жүгіруін тоқтату керек.
Dialogue: 0,0:42:21.16,0:42:24.66,Default,,0,0,0,,Асуна, мен сенен бірдеңе сұрадым, бірақ сенің қолыңнан келеді деп ойлайсың ба?
Dialogue: 0,0:42:24.75,0:42:28.58,Default,,0,0,0,,А... Иә, мүмкін.
Dialogue: 0,0:42:28.67,0:42:30.38,Default,,0,0,0,,Неліктен екі гильдия да солай
Dialogue: 0,0:42:30.46,0:42:33.38,Default,,0,0,0,,Кері санақ оқиғасына жауапты адамды да шақырасыз ба?
Dialogue: 0,0:42:33.46,0:42:36.13,Default,,0,0,0,,Тіпті ``ALS'' мүшелерінен ғана сұрасаңыз да
Dialogue: 0,0:42:36.22,0:42:38.55,Default,,0,0,0,,Сіз алданып қалуыңыз мүмкін.
Dialogue: 0,0:42:38.63,0:42:42.43,Default,,0,0,0,,Бірақ оқиғаға жауапты адам алаяқтық туралы білмеуі мүмкін бе?
Dialogue: 0,0:42:43.06,0:42:44.64,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:42:45.35,0:42:47.77,Default,,0,0,0,,Сондықтан мен оны да шақырдым.
Dialogue: 0,0:42:47.85,0:42:50.73,Default,,0,0,0,,Барлығы асыға күтетін кеш.
Dialogue: 0,0:42:50.81,0:42:53.19,Default,,0,0,0,,Тым ақылсыз ештеңе жасама, жарай ма?
Dialogue: 0,0:42:54.11,0:42:55.73,Default,,0,0,0,,Кеш...
Dialogue: 0,0:42:55.82,0:42:58.70,Default,,0,0,0,,Кештерден ләззат алу жақсы деп ойлаймын.
Dialogue: 0,0:42:58.78,0:43:03.45,Default,,0,0,0,,Барлығы стратегияға үйреніп, бос уақыттары көбірек болды.
Dialogue: 0,0:43:03.53,0:43:07.66,Default,,0,0,0,,Шынымен, мен 1-қабатта болғаннан бері оны елестете де алмаймын.
Dialogue: 0,0:43:09.67,0:43:13.29,Default,,0,0,0,,Дегенмен, ПК топтары мұндай олқылықтарды пайдаланады...
Dialogue: 0,0:43:13.88,0:43:18.42,Default,,0,0,0,,Жоқ... Мен бұл ойын маған шабуыл жасайтындай сезіндім.
Dialogue: 0,0:43:24.18,0:43:26.31,Default,,0,0,0,,- (Хаффнер) Бұл не? -Онда.
Dialogue: 0,0:43:45.74,0:43:48.79,Default,,0,0,0,,Сізге кенет қоңырау шалғаным үшін кешіріңіз, Шивата-сан.
Dialogue: 0,0:43:48.87,0:43:51.04,Default,,0,0,0,,Жоқ, мен бұған қарсы емеспін.
Dialogue: 0,0:43:51.12,0:43:54.34,Default,,0,0,0,,Сосын... аа...
Dialogue: 0,0:44:04.47,0:44:06.51,Default,,0,0,0,,``ALS'' кешін жоспарлаушы
Dialogue: 0,0:44:06.60,0:44:07.43,Default,,0,0,0,,Ол Литен деп аталады.
Dialogue: 0,0:44:08.97,0:44:10.52,Default,,0,0,0,,Келгеніңізге рахмет.
Dialogue: 0,0:44:10.60,0:44:14.27,Default,,0,0,0,,Бұл... Иә, бұл... Сонымен...
Dialogue: 0,0:44:19.69,0:44:21.70,Default,,0,0,0,,Көшбасшы неліктен мұнда?
Dialogue: 0,0:44:21.78,0:44:23.82,Default,,0,0,0,,Иә, сен неге?
Dialogue: 0,0:44:23.91,0:44:26.24,Default,,0,0,0,,Мен оны естігім келеді!
Dialogue: 0,0:44:26.33,0:44:28.62,Default,,0,0,0,,Ол маған хабарлама арқылы қоңырау шалды.
Dialogue: 0,0:44:29.66,0:44:33.04,Default,,0,0,0,,Келе ме, келмей ме 50-50 деп ойладым.
Dialogue: 0,0:44:34.92,0:44:37.04,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:44:37.13,0:44:40.96,Default,,0,0,0,,Мен шынымен бос емеспін, сондықтан сізге бірдеңе керек болса, маған дереу хабарлаңыз.
Dialogue: 0,0:44:47.89,0:44:50.02,Default,,0,0,0,,Нақтырақ айтыңыз
Dialogue: 0,0:44:50.10,0:44:51.81,Default,,0,0,0,,Балалар (ALS)
Dialogue: 0,0:44:51.89,0:44:54.40,Default,,0,0,0,,Ертеңгі кері санақ кешін өткізіп жіберіңіз
Dialogue: 0,0:44:54.48,0:44:57.31,Default,,0,0,0,,Еден бастығын жалғыз бағындыруға тырысу
Dialogue: 0,0:44:57.40,0:44:58.23,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:44:58.32,0:45:00.69,Default,,0,0,0,,Жоқ! Не?
Dialogue: 0,0:45:02.57,0:45:06.57,Default,,0,0,0,,Не, сонша жалған материалды қайдан алдың?
Dialogue: 0,0:45:06.66,0:45:08.37,Default,,0,0,0,,Ақпарат көзін айта алмайды
Dialogue: 0,0:45:08.45,0:45:10.70,Default,,0,0,0,,Бірақ бұл ALS ішінен ағып кетсе де
Dialogue: 0,0:45:10.79,0:45:13.25,Default,,0,0,0,,Мен оны ақпарат берушіден сатып алған жоқпын.
Dialogue: 0,0:45:14.92,0:45:16.58,Default,,0,0,0,,Бұл тақырыптан тыс.
Dialogue: 0,0:45:16.67,0:45:18.75,Default,,0,0,0,,Бұл бос сөз. мен барамын.
Dialogue: 0,0:45:18.84,0:45:19.75,Default,,0,0,0,,Көшбасшы!
Dialogue: 0,0:45:19.84,0:45:22.84,Default,,0,0,0,,Мен бастықты асығыс жеңгім келеді.
Dialogue: 0,0:45:22.92,0:45:25.30,Default,,0,0,0,,Бүгін таңертең менің топ басшысы маған...
Dialogue: 0,0:45:25.38,0:45:28.18,Default,,0,0,0,,Әй, сен не айтып тұрсың!
Dialogue: 0,0:45:28.26,0:45:31.06,Default,,0,0,0,,Топ басшысы шешімнің атқарушы жиналыста асығыс қабылданғанын айтты.
Dialogue: 0,0:45:31.14,0:45:32.64,Default,,0,0,0,,Маған айтпа
Dialogue: 0,0:45:32.73,0:45:35.39,Default,,0,0,0,,Бірақ мен партияны дайындау үшін көп еңбек еттім
Dialogue: 0,0:45:35.48,0:45:37.15,Default,,0,0,0,,Мен оны бұзатын ештеңе істегім келмейді.
Dialogue: 0,0:45:37.23,0:45:41.07,Default,,0,0,0,,Бұл ``ALS'' және ''DKB'' арасындағы алғашқы бірлескен оқиға.
Dialogue: 0,0:45:41.15,0:45:42.32,Default,,0,0,0,,Риччан...
Dialogue: 0,0:45:42.40,0:45:45.32,Default,,0,0,0,,Шива, үнсіз қалғаным үшін кешіріңіз.
Dialogue: 0,0:45:46.16,0:45:48.37,Default,,0,0,0,,Айтыңызшы, Көшбасшы
Dialogue: 0,0:45:48.45,0:45:51.16,Default,,0,0,0,,Неліктен қашуға шешім қабылдадыңыз?
Dialogue: 0,0:45:51.24,0:45:52.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:45:52.79,0:45:54.75,Default,,0,0,0,,Мен әрқашан өзім қалаған нәрсені істеймін
Dialogue: 0,0:45:54.83,0:45:57.58,Default,,0,0,0,,Мен үлкен нәрсе айта алмайтынымды білемін.
Dialogue: 0,0:45:57.67,0:45:58.50,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:45:58.58,0:46:01.13,Default,,0,0,0,,Бұл асығыстық тым көп болды.
Dialogue: 0,0:46:01.21,0:46:04.97,Default,,0,0,0,,''ALS'' және ''DKB'' арасындағы қайшылық енді ешқашан шешілмейді.
Dialogue: 0,0:46:05.05,0:46:08.72,Default,,0,0,0,,Мен екі негізгі гильдиямыздың бұдан әрі ұрыс-керіс болғанын қаламаймын.
Dialogue: 0,0:46:08.80,0:46:10.10,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:46:13.02,0:46:14.27,Default,,0,0,0,,Иә
Dialogue: 0,0:46:14.77,0:46:16.81,Default,,0,0,0,,Маған айтпа.
Dialogue: 0,0:46:16.89,0:46:19.94,Default,,0,0,0,,Менің мүшелерім қорқынышты ақпарат әкелді.
Dialogue: 0,0:46:20.02,0:46:21.27,Default,,0,0,0,,Ақпарат?
Dialogue: 0,0:46:21.36,0:46:25.65,Default,,0,0,0,,5-қабаттағы бастық үлкен затты түсіреді дейді.
Dialogue: 0,0:46:25.74,0:46:29.03,Default,,0,0,0,,Бұрынғы бета-тестер ретінде сіз мұны білмейсіз бе?
Dialogue: 0,0:46:29.11,0:46:32.87,Default,,0,0,0,,Мм... бұл 5-қабаттың бастығы, солай ма?
Dialogue: 0,0:46:33.41,0:46:35.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:35.33,0:46:38.12,Default,,0,0,0,,Менің ойымша, бұл найза тәрізді қару болды.
Dialogue: 0,0:46:38.21,0:46:39.83,Default,,0,0,0,,Жоқ, күте тұрыңыз ба?
Dialogue: 0,0:46:40.33,0:46:45.30,Default,,0,0,0,,А... А, мен түсіндім! Бұл сөзсіз қауіпті
Dialogue: 0,0:46:45.38,0:46:46.34,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:46:47.05,0:46:48.34,Default,,0,0,0,,Гильдия туы
Dialogue: 0,0:46:48.43,0:46:53.06,Default,,0,0,0,,Гильдия туы жалау ма? Неліктен бұл соншалықты қауіпті?
Dialogue: 0,0:46:53.14,0:46:58.06,Default,,0,0,0,,Қару ретінде ол ең төмен шабуыл күші бар ұзын найза ғана.
Dialogue: 0,0:46:58.14,0:46:59.39,Default,,0,0,0,,Осылай орындаңыз...
Dialogue: 0,0:47:00.60,0:47:03.19,Default,,0,0,0,,Жабдықталған ойыншы оны жерге итергенде
Dialogue: 0,0:47:03.27,0:47:07.36,Default,,0,0,0,,Маңайдағы гильдия мүшелері барлық статистиканы арттыратын буфф алады.
Dialogue: 0,0:47:07.44,0:47:09.74,Default,,0,0,0,,Мм... Не...
Dialogue: 0,0:47:09.82,0:47:12.95,Default,,0,0,0,,Жалау ұстаған ойыншы қозғала ала ма?
Dialogue: 0,0:47:13.03,0:47:16.62,Default,,0,0,0,,Сондай-ақ, буфтың ұзақтығы қандай? Ең көп адам саны қанша?
Dialogue: 0,0:47:16.70,0:47:21.58,Default,,0,0,0,,Іске қосылған кезде қозғала алмайсыз, бірақ жалау тігілгенше әсер жалғаса береді.
Dialogue: 0,0:47:21.67,0:47:24.92,Default,,0,0,0,,Гильдия мүшелерінің санында жоғарғы шектеу жоқ.
Dialogue: 0,0:47:25.00,0:47:26.26,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:47:26.34,0:47:29.80,Default,,0,0,0,,Олай болса, ойыншының психикалық денсаулығына әсері қорқынышты болар еді.
Dialogue: 0,0:47:29.88,0:47:32.72,Default,,0,0,0,,Егер ``ALS'' жалаушасын алса
Dialogue: 0,0:47:32.80,0:47:35.06,Default,,0,0,0,,ALS мүшелерінің моральдық жағдайы көтерілуде.
Dialogue: 0,0:47:35.14,0:47:37.81,Default,,0,0,0,,《DKB》Мүшелер тез азайып келеді
Dialogue: 0,0:47:37.89,0:47:40.10,Default,,0,0,0,,Егер бұл орын алса, 《DKB》...
Dialogue: 0,0:47:40.19,0:47:44.23,Default,,0,0,0,,Гилменнің басқаруды жоғалтып, құлауы мүмкін.
Dialogue: 0,0:47:44.31,0:47:46.40,Default,,0,0,0,,Сондықтан мен бастықты бар күшіммен жеңдім.
Dialogue: 0,0:47:46.48,0:47:49.44,Default,,0,0,0,,Сіз ''ALS'' алуға бел байладыңыз ба?
Dialogue: 0,0:47:49.53,0:47:52.53,Default,,0,0,0,,Оны бірлесіп басқара алмаймыз ба?
Dialogue: 0,0:47:52.61,0:47:54.45,Default,,0,0,0,,Сіз қашуға тырысып жатырсыз ба?
Dialogue: 0,0:47:54.53,0:47:55.83,Default,,0,0,0,,《DKB》-ге гильдия жалауын қосу
Dialogue: 0,0:47:55.91,0:47:58.29,Default,,0,0,0,,Мүмкін бұл сіз оны алғыңыз келмегендіктен шығар.
Dialogue: 0,0:47:58.37,0:48:01.16,Default,,0,0,0,,Линд мырзамен кеңесіп, оны әділ пайдалансаңыз...
Dialogue: 0,0:48:01.25,0:48:05.17,Default,,0,0,0,,Мұндай пікір де айтылды, бірақ...
Dialogue: 0,0:48:05.88,0:48:08.63,Default,,0,0,0,,Бірлесіп пайдалану мүмкін емес.
Dialogue: 0,0:48:09.34,0:48:12.22,Default,,0,0,0,,Туда тек бір гильдия атауын тіркеуге болады.
Dialogue: 0,0:48:12.30,0:48:14.47,Default,,0,0,0,,Кейінірек өзгерту мүмкін емес
Dialogue: 0,0:48:14.55,0:48:18.47,Default,,0,0,0,,``ALS'' және ''DKB'' арасында таңдау керек.
Dialogue: 0,0:48:18.56,0:48:19.56,Default,,0,0,0,,Бұл...
Dialogue: 0,0:48:19.64,0:48:23.52,Default,,0,0,0,,Енді мен бұл әңгімені естіген соң, үнсіз қала алмаймын.
Dialogue: 0,0:48:23.60,0:48:25.15,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:48:25.23,0:48:26.40,Default,,0,0,0,,Ол қазірдің өзінде шешілді.
Dialogue: 0,0:48:26.48,0:48:29.48,Default,,0,0,0,,Линд мырзаға хабарлаңыз және алаяқтық әрекеттеріңізді тоқтатыңыз.
Dialogue: 0,0:48:29.57,0:48:32.90,Default,,0,0,0,,Егер сіз осындай әрекет жасасаңыз, гильдиялар арасында соғыс болуы мүмкін.
Dialogue: 0,0:48:32.99,0:48:34.49,Default,,0,0,0,,Even if...
Dialogue: 0,0:48:34.57,0:48:35.99,Default,,0,0,0,,Күте тұрыңыз, Шива!
Dialogue: 0,0:48:36.07,0:48:37.20,Default,,0,0,0,,Риччан...
Dialogue: 0,0:48:39.91,0:48:40.79,Default,,0,0,0,,Көшбасшы
Dialogue: 0,0:48:42.83,0:48:45.08,Default,,0,0,0,,Бұл стратегияны жақтаған адам болды
Dialogue: 0,0:48:45.17,0:48:48.13,Default,,0,0,0,,Қобалжыған кейбір мүшелер ғана емес пе?
Dialogue: 0,0:48:48.21,0:48:53.22,Default,,0,0,0,,Бірақ гильдия бөлінбес үшін жоспарды бекітуден басқа амалым қалмады.
Dialogue: 0,0:48:53.30,0:48:56.93,Default,,0,0,0,,Көшбасшының өзі жүгіргісі келмейтін шығар.
Dialogue: 0,0:48:57.01,0:48:58.47,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:48:58.56,0:49:01.93,Default,,0,0,0,,Басқа амал жоқ па...?
Dialogue: 0,0:49:02.02,0:49:03.52,Default,,0,0,0,,Литен мырза...
Dialogue: 0,0:49:21.04,0:49:22.91,Default,,0,0,0,,Бастықты жалғыз жеңейік
Dialogue: 0,0:49:23.00,0:49:24.00,Default,,0,0,0,,Не!
Dialogue: 0,0:49:25.67,0:49:28.21,Default,,0,0,0,,Біз жалаушаны алғаннан кейін
Dialogue: 0,0:49:28.29,0:49:30.17,Default,,0,0,0,,Екі негізгі гильдия арасындағы қақтығыстың алдын алуға болады.
Dialogue: 0,0:49:30.25,0:49:31.25,Default,,0,0,0,,Ha
Dialogue: 0,0:49:33.09,0:49:35.01,Default,,0,0,0,,Иә, бұл жалғыз нұсқа.
Dialogue: 0,0:49:35.09,0:49:37.80,Default,,0,0,0,,Шива I...
Dialogue: 0,0:49:37.89,0:49:39.76,Default,,0,0,0,,Мен білемін, Риччан.
Dialogue: 0,0:49:39.85,0:49:42.10,Default,,0,0,0,,Адал болғаныңыз үшін рахмет.
Dialogue: 0,0:49:43.18,0:49:44.73,Default,,0,0,0,,Мен де қызметтес боламын.
Dialogue: 0,0:49:45.69,0:49:47.73,Default,,0,0,0,,Мен де... Мен де істеймін!
Dialogue: 0,0:49:47.81,0:49:51.53,Default,,0,0,0,,Жарайды ма? Сіз гильдияға опасыздық жасайсыз.
Dialogue: 0,0:49:51.61,0:49:53.40,Default,,0,0,0,,Бұл ойынды қалай тазартуға болады
Dialogue: 0,0:49:53.49,0:49:55.36,Default,,0,0,0,,《DKB》 және 《ALS》 да қажет.
Dialogue: 0,0:49:55.45,0:49:58.49,Default,,0,0,0,,Біз кооперативтік қарым-қатынастың одан әрі бұзылуына жол бере алмаймыз.
Dialogue: 0,0:49:58.57,0:50:00.78,Default,,0,0,0,,Гильдияға опасыздық жасау болса да
Dialogue: 0,0:50:00.87,0:50:04.16,Default,,0,0,0,,Төменгі қабаттарда босатуды күткен мыңдаған адамдар
Dialogue: 0,0:50:04.25,0:50:05.83,Default,,0,0,0,,Мен саған опасыздық жасай алмаймын
Dialogue: 0,0:50:08.21,0:50:09.33,Default,,0,0,0,,Рахмет
Dialogue: 0,0:50:10.34,0:50:12.13,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:50:14.30,0:50:18.80,Default,,0,0,0,,Мен өз ісімді аяқтадым деп ойлаймын, сондықтан мен сені үйге жіберемін.
Dialogue: 0,0:50:18.89,0:50:21.10,Default,,0,0,0,,Мен бос емеспін.
Dialogue: 0,0:50:21.18,0:50:26.60,Default,,0,0,0,,Ертең мен таңдалған мүшелермен бірге кешкі сағат 6-да бастықты жеңу үшін кетуім керек.
Dialogue: 0,0:50:26.69,0:50:31.27,Default,,0,0,0,,Егер сіз кешігіп, біреу жұмысты қолға алса, бұл үлкен мәселе болады.
Dialogue: 0,0:50:32.23,0:50:36.61,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз, сіз таңдалған мүше емессіз.
Dialogue: 0,0:50:36.70,0:50:41.24,Default,,0,0,0,,Ал, ертең 18:00-де кетеміз.
Dialogue: 0,0:50:41.32,0:50:43.20,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:50:43.29,0:50:44.91,Default,,0,0,0,,Көшбасшы…
Dialogue: 0,0:50:45.00,0:50:46.91,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:50:47.00,0:50:49.29,Default,,0,0,0,,Рахмет Кибау-сан
Dialogue: 0,0:50:51.96,0:50:54.63,Default,,0,0,0,,Тамақтың ақшасын төлеген жоқ.
Dialogue: 0,0:50:54.71,0:50:56.84,Default,,0,0,0,,А... а...
Dialogue: 0,0:50:59.89,0:51:03.51,Default,,0,0,0,,Кибау-сан мен оның достары ертең кешкі сағат 6-да кетеді.
Dialogue: 0,0:51:03.60,0:51:06.39,Default,,0,0,0,,Тез дайындалсаң, алға шығуға болады.
Dialogue: 0,0:51:06.48,0:51:10.60,Default,,0,0,0,,Бірақ небәрі 4 адам болса, еден бастықтарының шайқасы қиын.
Dialogue: 0,0:51:10.69,0:51:13.02,Default,,0,0,0,,Сізге көбірек достар керек емес пе?
Dialogue: 0,0:51:13.11,0:51:15.07,Default,,0,0,0,,Дос...
Dialogue: 0,0:51:15.15,0:51:16.57,Default,,0,0,0,,Тек нәрсе
Dialogue: 0,0:51:16.65,0:51:19.03,Default,,0,0,0,,Мен өз мүшелеріммен сөйлесе алмаймын.
Dialogue: 0,0:51:19.11,0:51:20.53,Default,,0,0,0,,Мен де...
Dialogue: 0,0:51:20.61,0:51:23.83,Default,,0,0,0,,Егілдің партиясындағы төрт адам ынтымақтасады.
Dialogue: 0,0:51:23.91,0:51:25.29,Default,,0,0,0,,Арго туралы...
Dialogue: 0,0:51:25.37,0:51:27.08,Default,,0,0,0,,Сонда небәрі 9 адам бар ма?
Dialogue: 0,0:51:27.16,0:51:30.12,Default,,0,0,0,,Мен сенімді емеспін, бірақ мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:51:31.75,0:51:33.54,Default,,0,0,0,,барлығын бірге орналастырыңыз.
Dialogue: 0,0:51:36.76,0:51:37.76,Default,,0,0,0,,Ах
Dialogue: 0,0:51:38.55,0:51:41.22,Default,,0,0,0,,Менің ойымда тағы бір адам бар.
Dialogue: 0,0:52:21.72,0:52:23.22,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:52:31.18,0:52:32.56,Default,,0,0,0,,Асуна...
Dialogue: 0,0:52:32.64,0:52:34.60,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:52:35.23,0:52:37.48,Default,,0,0,0,,Мұны маған бір хабаршы айтты.
Dialogue: 0,0:52:37.57,0:52:39.03,Default,,0,0,0,,Митоның орналасқан жері
Dialogue: 0,0:52:39.11,0:52:42.20,Default,,0,0,0,,Ол осы орманда материалдық заттарды жинап жатыр.
Dialogue: 0,0:52:42.28,0:52:44.87,Default,,0,0,0,,Ол өте жақсы ақпарат беруші.
Dialogue: 0,0:52:45.41,0:52:48.87,Default,,0,0,0,,1-қабаттағы бастық шайқасынан бері. Содан бері...
Dialogue: 0,0:52:51.58,0:52:54.67,Default,,0,0,0,,Алдыңғы қатарда нені көрмеймін
Dialogue: 0,0:52:54.75,0:52:56.29,Default,,0,0,0,,Материалдарды жинау үшін?
Dialogue: 0,0:52:58.25,0:53:00.84,Default,,0,0,0,,Материалдарды жинау...
Dialogue: 0,0:53:00.92,0:53:04.01,Default,,0,0,0,,Мен үй бұйымдарын сататын дүкен ашқым келеді...
Dialogue: 0,0:53:04.09,0:53:07.10,Default,,0,0,0,,Мен қазір соған дайындалып жатырмын.
Dialogue: 0,0:53:07.18,0:53:08.31,Default,,0,0,0,,(Питбуль) Э? (Доберман) Э?
Dialogue: 0,0:53:08.39,0:53:11.06,Default,,0,0,0,,Құрыш дүкені деген не деп ойлаймын.
Dialogue: 0,0:53:11.14,0:53:14.23,Default,,0,0,0,,Сирек кездесетін жабдық төмен деңгейлерде сирек түседі.
Dialogue: 0,0:53:14.31,0:53:16.56,Default,,0,0,0,,Оны нығайту материалы ретінде пайдалануға болады
Dialogue: 0,0:53:16.65,0:53:17.98,Default,,0,0,0,,Мен...
Dialogue: 0,0:53:21.03,0:53:24.36,Default,,0,0,0,,Сонда практикалық заттар ғана емес, сәнді киімдер де.
Dialogue: 0,0:53:24.45,0:53:26.70,Default,,0,0,0,,Аксессуарларды да сатып алсаңыз жақсы болар еді.
Dialogue: 0,0:53:26.78,0:53:30.16,Default,,0,0,0,,Сонда мен сіздің тұрақты клиентіңіз боламын!
Dialogue: 0,0:53:30.24,0:53:32.25,Default,,0,0,0,,-Эй Асуна -А?
Dialogue: 0,0:53:33.79,0:53:36.67,Default,,0,0,0,,Сіз ``Жаулап алу тобынан'' мені көруге келдіңіз.
Dialogue: 0,0:53:36.75,0:53:39.09,Default,,0,0,0,,Сенің бір ісің бар болғандықтан емес пе?
Dialogue: 0,0:53:39.88,0:53:40.88,Default,,0,0,0,,Иә...
Dialogue: 0,0:53:41.42,0:53:43.72,Default,,0,0,0,,Негізі менің өтінішім бар.
Dialogue: 0,0:53:46.13,0:53:49.14,Default,,0,0,0,,Ертең мен шағын топ мүшелерімен бірге боламын.
Dialogue: 0,0:53:49.22,0:53:50.72,Default,,0,0,0,,5-ші қабаттағы еден бастығын шақырыңыз
Dialogue: 0,0:53:53.77,0:53:55.31,Default,,0,0,0,,Кейбір жағдайлар бар.
Dialogue: 0,0:53:55.39,0:53:57.77,Default,,0,0,0,,«Стратегиялық топтың» екі гильдиясының алдында
Dialogue: 0,0:53:57.85,0:54:00.02,Default,,0,0,0,,Бастықты жеңу қажет болды.
Dialogue: 0,0:54:00.11,0:54:03.69,Default,,0,0,0,,Сол себепті маған дәл қазір мықты ойыншылардың көмегі керек.
Dialogue: 0,0:54:05.03,0:54:06.66,Default,,0,0,0,,Осы ойынды тазарту үшін
Dialogue: 0,0:54:06.74,0:54:09.28,Default,,0,0,0,,Өтінемін, маған күшіңді берші Мито!
Dialogue: 0,0:54:11.91,0:54:13.50,Default,,0,0,0,,Бұл шұғыл, солай емес пе?
Dialogue: 0,0:54:13.58,0:54:15.87,Default,,0,0,0,,Иә, [Capture Group]...
Dialogue: 0,0:54:16.37,0:54:20.79,Default,,0,0,0,,Бұл ''SAO'' өлім ойынының болашағына әсер ету жеткілікті.
Dialogue: 0,0:54:24.34,0:54:27.05,Default,,0,0,0,,Асуна мен бармаймын.
Dialogue: 0,0:54:27.13,0:54:28.55,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:54:28.64,0:54:32.06,Default,,0,0,0,,Өзіңізді қорғауға ант берген адамдардан артықшылыққа ие болыңыз.
Dialogue: 0,0:54:34.22,0:54:36.23,Default,,0,0,0,,Мен осындай ойыншымын.
Dialogue: 0,0:54:36.31,0:54:40.56,Default,,0,0,0,,Ол достарын тастап, оқиға орнынан қашып кетуі де мүмкін.
Dialogue: 0,0:54:40.65,0:54:41.90,Default,,0,0,0,,Мит…
Dialogue: 0,0:54:43.36,0:54:46.86,Default,,0,0,0,,Кешіріңіз, мен енді ешкімді сатқым келмейді.
Dialogue: 0,0:54:46.95,0:54:48.15,Default,,0,0,0,,Ха…
Dialogue: 0,0:54:48.66,0:54:52.16,Default,,0,0,0,,Асуна, бүгін сені кездестіргеніме қуаныштымын.
Dialogue: 0,0:54:52.24,0:54:55.62,Default,,0,0,0,,Бірақ мен сізге көмектесе алмаймын
Dialogue: 0,0:54:55.70,0:54:56.54,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:55:00.92,0:55:03.67,Default,,0,0,0,,Мито, менімен жарыс!
Dialogue: 0,0:55:04.25,0:55:05.67,Default,,0,0,0,,А...
Dialogue: 0,0:55:05.76,0:55:09.55,Default,,0,0,0,,Мен енді мені қорғауға мұқтаж жаңадан бастаушы емеспін.
Dialogue: 0,0:55:10.64,0:55:12.51,Default,,0,0,0,,Сонымен... Сонымен!
Dialogue: 0,0:55:13.64,0:55:16.73,Default,,0,0,0,,Егер мен жекпе-жекте жеңсем, бастықпен бірге күресе аламыз.
Dialogue: 0,0:55:25.07,0:55:26.44,Default,,0,0,0,,Я...
Dialogue: 0,0:55:26.53,0:55:29.11,Default,,0,0,0,,Бұл біткен соң үйге келесіз, солай ма?
Dialogue: 0,0:55:43.96,0:55:44.84,Default,,0,0,0,,Ха!
Dialogue: 0,0:55:44.92,0:55:45.75,Default,,0,0,0,,Әй!
Dialogue: 0,0:55:56.93,0:55:58.31,Default,,0,0,0,,Не болды? Мито
Dialogue: 0,0:55:59.60,0:56:01.23,Default,,0,0,0,,Шабуыл жасамайсың ба?
Dialogue: 0,0:56:02.31,0:56:05.32,Default,,0,0,0,,Асуна өзін қорғауды тым көп ойлап отыр.
Dialogue: 0,0:56:05.40,0:56:06.40,Default,,0,0,0,,Бізге көбірек шабуыл жасау керек
Dialogue: 0,0:56:26.80,0:56:28.13,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:56:47.32,0:56:48.40,Default,,0,0,0,,Хмм!
Dialogue: 0,0:56:59.24,0:57:01.33,Default,,0,0,0,,-Ааа! -Ах!
Dialogue: 0,0:57:06.50,0:57:07.34,Default,,0,0,0,,Әй!
Dialogue: 0,0:57:07.42,0:57:09.67,Default,,0,0,0,,Иә? Усазава-сан
Dialogue: 0,0:57:09.75,0:57:12.22,Default,,0,0,0,,Бұл сіз ойын орталығында ойнаған ойын ба?
Dialogue: 0,0:57:12.30,0:57:15.93,Default,,0,0,0,,Иә... смартфон нұсқасы да шығарылды.
Dialogue: 0,0:57:16.97,0:57:18.89,Default,,0,0,0,,Мен әрқашан өкінетінмін.
Dialogue: 0,0:57:18.97,0:57:21.64,Default,,0,0,0,,Мен де Асунамен осы жерден танысқым келеді.
Dialogue: 0,0:57:21.72,0:57:24.81,Default,,0,0,0,,Егер мен бұлай айтпағанымда
Dialogue: 0,0:57:25.60,0:57:29.94,Default,,0,0,0,,Олар Асунаны мұндай қатыгез дүниеде тұзаққа түсіріп алмас еді.
Dialogue: 0,0:57:30.78,0:57:32.40,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:57:32.49,0:57:34.78,Default,,0,0,0,,Хааааа!
Dialogue: 0,0:57:37.53,0:57:39.74,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:57:40.54,0:57:42.66,Default,,0,0,0,,редактор ретінде,
Dialogue: 0,0:58:06.44,0:58:07.27,Default,,0,0,0,,Эй
Dialogue: 0,0:58:07.35,0:58:09.48,Default,,0,0,0,,Мен де сенімен ойнай аламын ба?
Dialogue: 0,0:58:23.58,0:58:25.96,Default,,0,0,0,,Мито күшті ғой...
Dialogue: 0,0:58:26.04,0:58:28.92,Default,,0,0,0,,Асуна да әлдеқайда күшті болды.
Dialogue: 0,0:58:29.00,0:58:31.96,Default,,0,0,0,,Мен оны шынымен қолданып көрдім...
Dialogue: 0,0:58:32.46,0:58:35.34,Default,,0,0,0,,Сондықтан мен байыпты жауап бердім.
Dialogue: 0,0:58:35.42,0:58:37.01,Default,,0,0,0,,Өйткені бұл менің жоғалтуым
Dialogue: 0,0:58:37.09,0:58:40.14,Default,,0,0,0,,Мен енді стратегияға қатысып жатырмын деп айта алмаймын.
Dialogue: 0,0:58:40.22,0:58:41.85,Default,,0,0,0,,Бірақ Мито...
Dialogue: 0,0:58:45.81,0:58:46.98,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:58:47.06,0:58:48.06,Default,,0,0,0,,Асуна
Dialogue: 0,0:58:51.44,0:58:52.32,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:58:54.86,0:58:58.28,Default,,0,0,0,,Алдыңғы шабуылда сындырған алқа үшін кешірім
Dialogue: 0,0:58:58.36,0:59:00.57,Default,,0,0,0,,Мүмкін оны Мито жасаған шығар?
Dialogue: 0,0:59:00.66,0:59:04.58,Default,,0,0,0,,Менің жасау дағдыларым әлі де төмен, сондықтан дизайн қарапайым болғанымен.
Dialogue: 0,0:59:04.66,0:59:07.29,Default,,0,0,0,,Жоқ! Өте әдемі
Dialogue: 0,0:59:07.37,0:59:10.12,Default,,0,0,0,,Сондай-ақ парализдік уға және зақымдаушы уға төзімді.
Dialogue: 0,0:59:10.21,0:59:11.88,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:59:14.38,0:59:17.92,Default,,0,0,0,,Мен енді майдан шебінде соғыса алмаймын...
Dialogue: 0,0:59:24.81,0:59:28.43,Default,,0,0,0,,Бүгінгі күн үшін рахмет. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:59:39.82,0:59:40.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:42.07,0:59:44.24,Default,,0,0,0,,-Кім? -Аа...
Dialogue: 0,0:59:46.54,0:59:50.79,Default,,0,0,0,,Өкінішті... Негізі жасырғым келмеді.
Dialogue: 0,0:59:55.00,0:59:57.59,Default,,0,0,0,,Асуна кешігіп қалды, мен оны тексеруге келдім.
Dialogue: 0,0:59:57.67,1:00:01.01,Default,,0,0,0,,Сенімен дуэль басталды, бірақ мен шыға алмадым...
Dialogue: 0,1:00:01.09,1:00:02.34,Default,,0,0,0,,Сіз сенімдісіз бе...
Dialogue: 0,1:00:02.43,1:00:05.81,Default,,0,0,0,,А-а-а... Мен ешқашан сәлем берген емеспін.
Dialogue: 0,1:00:05.89,1:00:08.85,Default,,0,0,0,,Мен Кирито мен Асунамын.
Dialogue: 0,1:00:08.93,1:00:11.60,Default,,0,0,0,,Мен атақты болғандықтан білемін.
Dialogue: 0,1:00:11.69,1:00:16.11,Default,,0,0,0,,Асунаны уайымдап тығылдыңыз ба? Бұл тым тым қорғаншылық емес пе?
Dialogue: 0,1:00:16.19,1:00:18.23,Default,,0,0,0,,Мен мұны жоққа шығара алмаймын.
Dialogue: 0,1:00:18.74,1:00:21.70,Default,,0,0,0,,Сіз мені осы жолы бастықты жеңуге шақыруды жоспарлап отырсыз ба?
Dialogue: 0,1:00:21.78,1:00:26.20,Default,,0,0,0,,Жоқ, олай емес... Мен білмеймін...
Dialogue: 0,1:00:26.28,1:00:29.04,Default,,0,0,0,,Мұны сіз де байқағаныңызға сенімдімін.
Dialogue: 0,1:00:29.12,1:00:32.79,Default,,0,0,0,,Асуна өсе берсе, одан да күшті болады.
Dialogue: 0,1:00:32.87,1:00:35.42,Default,,0,0,0,,''Жаулап алу тобы''дағы кез келген адамнан күшті
Dialogue: 0,1:00:35.50,1:00:36.71,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,1:00:36.79,1:00:38.67,Default,,0,0,0,,Ақырында мен үлкен гильдияға қосыламын.
Dialogue: 0,1:00:38.76,1:00:42.51,Default,,0,0,0,,Сіз өлімді жеңу ойындарында жетекшілік ететін үздік ойыншы боласыз.
Dialogue: 0,1:00:42.59,1:00:46.80,Default,,0,0,0,,Бірақ олай болмайынша, айналаңыздағы адамдар сізді қолдауы керек.
Dialogue: 0,1:00:46.89,1:00:48.77,Default,,0,0,0,,Мысалы, мен немесе сен
Dialogue: 0,1:00:48.85,1:00:51.27,Default,,0,0,0,,Қазіргі уақытта Асуна қолданып жүрген рапира is
Dialogue: 0,1:00:51.35,1:00:54.31,Default,,0,0,0,,Бұл бастапқыда мен сізден алған 《Жел ұшағы》 болды.
Dialogue: 0,1:00:54.40,1:00:55.52,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:55.61,1:00:57.65,Default,,0,0,0,,《Wind Fleuret》 спецификация бойынша 3 қабаттан тұрады
Dialogue: 0,1:00:57.73,1:00:59.78,Default,,0,0,0,,Мен өз шегіме жеттім.
Dialogue: 0,1:00:59.86,1:01:02.53,Default,,0,0,0,,Сонда да Асуна жібермейді.
Dialogue: 0,1:01:02.61,1:01:05.24,Default,,0,0,0,,Олай болса, фольганы металл материалдан жасаңыз.
Dialogue: 0,1:01:05.32,1:01:08.87,Default,,0,0,0,,Мен соның негізінде жаңа қару жасауды ұсындым.
Dialogue: 0,1:01:08.95,1:01:10.87,Default,,0,0,0,,Бұл рапир жасалған.
Dialogue: 0,1:01:10.95,1:01:13.29,Default,,0,0,0,,Ондай қиындықтан өтудің қажеті жоқ...
Dialogue: 0,1:01:13.79,1:01:15.38,Default,,0,0,0,,Қылышыңды маған бергенің сонша
Dialogue: 0,1:01:15.46,1:01:17.38,Default,,0,0,0,,Менің ойымша, бұл маңызды болды.
Dialogue: 0,1:01:20.42,1:01:25.64,Default,,0,0,0,,Сен әлі де Асуна үшін таптырмас доссың.
Dialogue: 0,1:01:31.85,1:01:33.69,Default,,0,0,0,,-Онда... -Мен...
Dialogue: 0,1:01:39.61,1:01:40.86,Default,,0,0,0,,Мен сені жек көремін
Dialogue: 0,1:01:40.94,1:01:42.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:42.90,1:01:43.99,Default,,0,0,0,,Иә
Dialogue: 0,1:02:06.09,1:02:08.26,Default,,0,0,0,,Иә?не?
Dialogue: 0,1:02:08.89,1:02:09.89,Default,,0,0,0,,Жоқ
Dialogue: 0,1:02:11.31,1:02:15.52,Default,,0,0,0,,Бұл тек 9 адамнан тұратын бастық шайқасы, бірақ сізде жеңіске жету мүмкіндігі жоғары.
Dialogue: 0,1:02:15.60,1:02:17.85,Default,,0,0,0,,Менің бір адам өліміне себепкер болу ниетім жоқ.
Dialogue: 0,1:02:17.94,1:02:20.73,Default,,0,0,0,,«Тұтқыншылар тобының» күйреуін болдырмау үшін
Dialogue: 0,1:02:20.82,1:02:23.19,Default,,0,0,0,,Ал Шивата мен Литен мұны жоспарлады...
Dialogue: 0,1:02:23.28,1:02:25.82,Default,,0,0,0,,Кері санақ партиясын сәтті өткізу үшін
Dialogue: 0,1:02:25.90,1:02:27.70,Default,,0,0,0,,Барлығымыз... қолымыздан келгеннің бәрін жасайық!
Dialogue: 0,1:02:27.78,1:02:30.66,Default,,0,0,0,,Жақсы! Қанекей мынаны істейік!
Dialogue: 0,1:02:30.74,1:02:32.37,Default,,0,0,0,,О!
Dialogue: 0,1:02:39.88,1:02:40.71,Default,,0,0,0,,Ха!
Dialogue: 0,1:02:42.75,1:02:44.63,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:02:48.55,1:02:49.72,Default,,0,0,0,,Хааааа!
Dialogue: 0,1:03:05.07,1:03:09.45,Default,,0,0,0,,Хм... Төбесінен басқа жол бар ма?
Dialogue: 0,1:03:09.53,1:03:12.03,Default,,0,0,0,,Әлде бұл кенеттен бастық бөлмесі ме?
Dialogue: 0,1:03:12.12,1:03:13.99,Default,,0,0,0,,Оның бета нұсқасынан айырмашылығы бар ма?
Dialogue: 0,1:03:14.08,1:03:19.08,Default,,0,0,0,,Аа, бұрын бұл жерде есік бар екен, оны ашсам, бастықтың бөлмесі екен.
Dialogue: 0,1:03:19.17,1:03:22.67,Default,,0,0,0,,Мм, сіз ол кезде қандай бастық едіңіз?
Dialogue: 0,1:03:22.75,1:03:26.51,Default,,0,0,0,,Ежелгі қирандыларды сақтаушы ретінде орнатылған өте үлкен голем.
Dialogue: 0,1:03:26.59,1:03:30.51,Default,,0,0,0,,Дегенмен, осы уақытқа дейін еден бастықтары сыртқы түрі бойынша Бетаға ұқсас болса да,
Dialogue: 0,1:03:30.59,1:03:33.35,Default,,0,0,0,,Әрқашан қандай да бір өзгерістер болды.
Dialogue: 0,1:03:33.43,1:03:36.72,Default,,0,0,0,,Иә, сіз бастық туралы бірдеңе білесіз бе?
Dialogue: 0,1:03:36.81,1:03:40.85,Default,,0,0,0,,Менің информатор екенімді ұмытып кеттің бе?
Dialogue: 0,1:03:40.94,1:03:42.10,Default,,0,0,0,,Мен... бұл жаман.
Dialogue: 0,1:03:43.02,1:03:44.69,Default,,0,0,0,,Кадрларымен
Dialogue: 0,1:03:44.77,1:03:48.82,Default,,0,0,0,,...Мен мұны айтқым келеді, бірақ бұл жолы мен сізге қызмет көрсетемін.
Dialogue: 0,1:03:49.49,1:03:50.91,Default,,0,0,0,,Қорытындыда
Dialogue: 0,1:03:50.99,1:03:54.37,Default,,0,0,0,,Бастық - голем, ол бетадағыдай болып көрінеді.
Dialogue: 0,1:03:54.45,1:03:57.58,Default,,0,0,0,,Маңдайда қыр бар, ол әлсіз жері.
Dialogue: 0,1:03:57.66,1:03:59.75,Default,,0,0,0,,Бұл сиқыр сияқты.
Dialogue: 0,1:03:59.83,1:04:04.71,Default,,0,0,0,,Ах, ал 5-қабаттағы бастық ерекше күшті жау болуы керек.
Dialogue: 0,1:04:05.59,1:04:07.67,Default,,0,0,0,,Қараудан басқа амалым жоқ.
Dialogue: 0,1:04:07.76,1:04:09.72,Default,,0,0,0,,Дұрыс...
Dialogue: 0,1:04:09.80,1:04:12.97,Default,,0,0,0,,Кенеттен бастық бөлмесінде не болғанын елестетіп көріңізші.
Dialogue: 0,1:04:13.05,1:04:14.89,Default,,0,0,0,,Мен алдымен барлау жасаймын.
Dialogue: 0,1:04:15.47,1:04:16.72,Default,,0,0,0,,Қазірше тек сен мен мен ғана оралдық.
Dialogue: 0,1:04:16.81,1:04:18.89,Default,,0,0,0,,Мұны маған қалдырыңыз және маған қалдырыңыз.
Dialogue: 0,1:04:18.98,1:04:19.93,Default,,0,0,0,,А...
Dialogue: 0,1:04:24.19,1:04:27.78,Default,,0,0,0,,Мүмкін бұл баспалдақтар еденнен көтеріледі.
Dialogue: 0,1:04:27.86,1:04:30.61,Default,,0,0,0,,Бұл кіреберісті жауып тұрған тұзақ болуы мүмкін.
Dialogue: 0,1:04:30.70,1:04:34.82,Default,,0,0,0,,Бұл орын алса да, ол толығымен жабылмай тұрып қашып кете аламын.
Dialogue: 0,1:04:35.83,1:04:38.62,Default,,0,0,0,,Олай болса, бірге барайық, бұл мәселеде ымыраға келе алмаймыз.
Dialogue: 0,1:04:38.70,1:04:42.21,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,1:04:42.71,1:04:44.33,Default,,0,0,0,,Аа, мен көмектесе алмаймын.
Dialogue: 0,1:04:45.08,1:04:48.05,Default,,0,0,0,,Барлығы, кешіріңіздер, бірақ мен баспалдақтарды қарауым керек.
Dialogue: 0,1:04:48.13,1:04:49.13,Default,,0,0,0,,О
Dialogue: 0,1:04:49.63,1:04:50.92,Default,,0,0,0,,Кирито-кун
Dialogue: 0,1:04:51.01,1:04:52.05,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:53.18,1:04:54.01,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,1:04:55.34,1:04:58.43,Default,,0,0,0,,Жарайды, мен қайтамын.
Dialogue: 0,1:05:10.57,1:05:13.61,Default,,0,0,0,,Иә? Бұл бастық бөлмесі, солай ма?
Dialogue: 0,1:05:13.70,1:05:16.41,Default,,0,0,0,,6-қабатқа көтерілу үшін баспалдақ жоқ.
Dialogue: 0,1:05:16.49,1:05:18.70,Default,,0,0,0,,Бастықтың келе жатқан белгісі жоқ.
Dialogue: 0,1:05:18.78,1:05:19.79,Default,,0,0,0,,О... Эй!
Dialogue: 0,1:05:19.87,1:05:21.66,Default,,0,0,0,,Мүмкін маған тағы біраз қозғалу керек шығар—
Dialogue: 0,1:05:21.75,1:05:23.54,Default,,0,0,0,,Оны баспаңыз
Dialogue: 0,1:05:33.84,1:05:34.72,Default,,0,0,0,,Арго!
Dialogue: 0,1:05:37.51,1:05:38.35,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:05:38.43,1:05:39.43,Default,,0,0,0,,Арго!
Dialogue: 0,1:05:39.51,1:05:40.51,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:05:43.35,1:05:46.19,Default,,0,0,0,,Өйткені сенің жеңісің – командаласыңның жеңісіне айналады.
Dialogue: 0,1:05:46.81,1:05:49.11,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:05:52.40,1:05:55.11,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:05:55.86,1:05:56.95,Default,,0,0,0,,Құт
Dialogue: 0,1:06:01.04,1:06:03.12,Default,,0,0,0,,Хааааа!
Dialogue: 0,1:06:11.34,1:06:12.84,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:06:12.92,1:06:14.59,Default,,0,0,0,,Бұл менің жолым!
Dialogue: 0,1:06:17.80,1:06:18.97,Default,,0,0,0,,Әзірге артқа оралайық.
Dialogue: 0,1:06:19.05,1:06:20.18,Default,,0,0,0,,Пернетақта төменірек!
Dialogue: 0,1:06:21.76,1:06:22.72,Default,,0,0,0,,Құт
Dialogue: 0,1:06:28.19,1:06:29.06,Default,,0,0,0,,Төмен!
Dialogue: 0,1:06:30.86,1:06:32.11,Default,,0,0,0,,Мен үшін алғаш рет!
Dialogue: 0,1:06:34.57,1:06:36.82,Default,,0,0,0,,Не? Олардың екеуі бар!
Dialogue: 0,1:06:36.90,1:06:39.78,Default,,0,0,0,,Менің ойымша, екі қолдың болуы қалыпты жағдай.
Dialogue: 0,1:06:42.16,1:06:43.24,Default,,0,0,0,,(шу)
Dialogue: 0,1:06:51.96,1:06:53.59,Default,,0,0,0,,С… Сендерге не күлкілі?!
Dialogue: 0,1:06:54.42,1:06:55.55,Default,,0,0,0,,Сәлем пернетақта
Dialogue: 0,1:06:55.63,1:06:58.26,Default,,0,0,0,,Екі қолың болса, аяғың да бар деген сөз...
Dialogue: 0,1:06:58.34,1:06:59.51,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:07:08.06,1:07:09.06,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,1:07:09.15,1:07:10.15,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:10.86,1:07:12.52,Default,,0,0,0,,Ақырын төмен қара.
Dialogue: 0,1:07:12.61,1:07:14.28,Default,,0,0,0,,А... а...
Dialogue: 0,1:07:14.36,1:07:16.99,Default,,0,0,0,,Сенің аяғың мен менің аяғым
Dialogue: 0,1:07:17.07,1:07:20.07,Default,,0,0,0,,Көк сызықты әрең басып кеткен жоқсың ба?
Dialogue: 0,1:07:20.16,1:07:23.53,Default,,0,0,0,,Сонымен, егер сіз осы сызыққа бассаңыз, сол мақсатты шеңбер құрылады.
Dialogue: 0,1:07:23.62,1:07:26.66,Default,,0,0,0,,Мына үлкен қолдар мен үлкен аяқтар сізге шабуыл жасап жатыр ма?\NМенің ойымша,
Dialogue: 0,1:07:26.75,1:07:28.00,Default,,0,0,0,,...
Dialogue: 0,1:07:28.08,1:07:30.92,Default,,0,0,0,,Бұл дегеніміз, егер сіз осы сызықты баспай қозғалсаңыз...
Dialogue: 0,1:07:31.00,1:07:32.04,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,1:07:34.25,1:07:36.96,Default,,0,0,0,,Не, бастық әлі келген жоқ па?
Dialogue: 0,1:07:37.05,1:07:39.30,Default,,0,0,0,,аулақ болу! аулақ болыңыз!
Dialogue: 0,1:07:42.55,1:07:44.93,Default,,0,0,0,,(Шивата мен Лоубэктің айқайы)
Dialogue: 0,1:07:53.56,1:07:54.44,Default,,0,0,0,,Асуна!
Dialogue: 0,1:07:57.69,1:07:59.57,Default,,0,0,0,,Хааааа!
Dialogue: 0,1:08:03.32,1:08:06.41,Default,,0,0,0,,- (Лобака) Уау - (Шивата) Уау!
Dialogue: 0,1:08:06.49,1:08:08.08,Default,,0,0,0,,- (Шивата) Уф - (Лобака) Уау
Dialogue: 0,1:08:29.68,1:08:33.60,Default,,0,0,0,,Бета және... олардың аттары мүлде басқа...
Dialogue: 0,1:08:36.82,1:08:38.07,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:08:44.16,1:08:46.03,Default,,0,0,0,,Мен ерекшелене аламын деп ойламаймын—
Dialogue: 0,1:08:46.12,1:08:49.45,Default,,0,0,0,,Бұрынғы қолдар мен аяқтар бастықтың шабуыл құралы сияқты.
Dialogue: 0,1:08:49.54,1:08:52.79,Default,,0,0,0,,Едендегі көк сызықты басып, нысана шеңбері пайда болады!
Dialogue: 0,1:08:52.87,1:08:56.75,Default,,0,0,0,,Мен сапқа әдейі шығамын, сондықтан қылыш шеберлігіңмен шабуылға дайындал!
Dialogue: 0,1:08:56.84,1:08:59.09,Default,,0,0,0,,-Сәлем! - Түсіндім!
Dialogue: 0,1:09:01.55,1:09:02.38,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:09:11.10,1:09:13.35,Default,,0,0,0,,Ааааа! Ха!
Dialogue: 0,1:09:13.44,1:09:16.11,Default,,0,0,0,,Ааааа! Эй!
Dialogue: 0,1:09:16.19,1:09:17.61,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,1:09:19.15,1:09:21.57,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:09:28.16,1:09:30.29,Default,,0,0,0,,Сол эмблема – оның әлсіздігі!
Dialogue: 0,1:09:30.37,1:09:32.41,Default,,0,0,0,,Мүмкіндік болса, қабылда!
Dialogue: 0,1:09:32.50,1:09:33.66,Default,,0,0,0,,О!
Dialogue: 0,1:09:43.30,1:09:44.13,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:09:44.22,1:09:45.72,Default,,0,0,0,,-Ди! -Ой!
Dialogue: 0,1:09:46.55,1:09:47.93,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,1:09:48.01,1:09:49.64,Default,,0,0,0,,Үшінші!
Dialogue: 0,1:09:54.10,1:09:56.69,Default,,0,0,0,,Барлығы қабырғаға қараңдар!
Dialogue: 0,1:10:06.53,1:10:11.91,Default,,0,0,0,,Ей, бұл бұрын-соңды болмаған үлгі. Бастықпен күресуді жалғастыру дұрыс па?
Dialogue: 0,1:10:11.99,1:10:14.71,Default,,0,0,0,,Менде бұл жаман нәрсе екені анық.
Dialogue: 0,1:10:15.37,1:10:17.92,Default,,0,0,0,,Барлығына! Баспалдақпен төменге эвакуациялаңыз!
Dialogue: 0,1:10:18.00,1:10:20.50,Default,,0,0,0,,Түсінікті! Барлығы осылай!
Dialogue: 0,1:10:22.88,1:10:24.22,Default,,0,0,0,,Ха... Кілт бала!
Dialogue: 0,1:10:28.51,1:10:31.60,Default,,0,0,0,,Бет... жоғалып кетті ме?
Dialogue: 0,1:10:32.14,1:10:33.22,Default,,0,0,0,,Шива!
Dialogue: 0,1:10:38.65,1:10:39.98,Default,,0,0,0,,Гуах
Dialogue: 0,1:10:42.48,1:10:43.48,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:10:43.57,1:10:45.44,Default,,0,0,0,,Баспалдақтар...
Dialogue: 0,1:10:45.53,1:10:47.91,Default,,0,0,0,,Бұл ауызға айналды!
Dialogue: 0,1:10:47.99,1:10:49.82,Default,,0,0,0,,Уф... уф!
Dialogue: 0,1:10:49.91,1:10:53.41,Default,,0,0,0,,Егіл! Маңдайымдағы елтаңбаны ұр!
Dialogue: 0,1:10:53.49,1:10:56.62,Default,,0,0,0,,Жоқ... бұл жігіттің төбесі жоқ!
Dialogue: 0,1:10:56.71,1:10:57.79,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:10:57.87,1:11:03.09,Default,,0,0,0,,Күте тұрыңыз! Түсіндім, мына бөлменің өзі бастық болды.
Dialogue: 0,1:11:03.67,1:11:05.26,Default,,0,0,0,,Хааааа!
Dialogue: 0,1:11:05.34,1:11:08.55,Default,,0,0,0,,Елтаңба да бөлменің бір жерінде қозғалып тұруы керек.
Dialogue: 0,1:11:09.18,1:11:11.76,Default,,0,0,0,,Соқпасаң, көмектесе алмайсың!
Dialogue: 0,1:11:11.85,1:11:13.22,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:11:16.23,1:11:20.06,Default,,0,0,0,,Қиямет! Маңдайымдағы елтаңба қайда кетті?
Dialogue: 0,1:11:21.98,1:11:25.65,Default,,0,0,0,,Бүкіл бөлме қанша големдерден тұрса да, бәрібір осылай...
Dialogue: 0,1:11:26.36,1:11:29.11,Default,,0,0,0,,Бұл қауіпті... Осылай жалғаса берсе, Ах-чан...
Dialogue: 0,1:11:32.16,1:11:34.03,Default,,0,0,0,,Хмм...
Dialogue: 0,1:11:35.91,1:11:37.41,Default,,0,0,0,,(Асунаның айқайы)
Dialogue: 0,1:11:46.17,1:11:48.88,Default,,0,0,0,,Асуна!
Dialogue: 0,1:12:01.98,1:12:03.11,Default,,0,0,0,,(Егілдің күшті дауысы)
Dialogue: 0,1:12:03.19,1:12:04.31,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,1:12:04.40,1:12:06.65,Default,,0,0,0,,О... басқа біреу бар ма еді?
Dialogue: 0,1:12:15.08,1:12:16.95,Default,,0,0,0,,Мит…
Dialogue: 0,1:12:20.46,1:12:21.42,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:12:21.50,1:12:23.13,Default,,0,0,0,,Қазір!
Dialogue: 0,1:12:30.01,1:12:33.30,Default,,0,0,0,,Барлығына! Сапқа шығып, қолдарыңызды және аяқтарыңызды көрсетіңіз!
Dialogue: 0,1:12:33.39,1:12:36.39,Default,,0,0,0,,Бір жерде әлсіздік эмблемасы болуы керек!
Dialogue: 0,1:12:36.47,1:12:38.31,Default,,0,0,0,,- (Шивата) Түсінікті! -(Литен) Мен жасап көремін!
Dialogue: 0,1:12:38.39,1:12:39.77,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:12:39.85,1:12:42.23,Default,,0,0,0,,(Митоның күшті дауысы)
Dialogue: 0,1:12:42.31,1:12:44.69,Default,,0,0,0,,Ах... Мито...
Dialogue: 0,1:12:44.77,1:12:50.15,Default,,0,0,0,,Мен... Мен өзімді әлі де кешіре алмаймын...
Dialogue: 0,1:12:50.24,1:12:51.49,Default,,0,0,0,,Кім шалбарын шылаған, сен, қанды шошқа!
Dialogue: 0,1:12:51.57,1:12:55.87,Default,,0,0,0,,Мен Асунаның өлуіне ешқашан жол бермеймін!
Dialogue: 0,1:12:57.24,1:12:58.87,Default,,0,0,0,,Жоқ, мен оны таба алмаймын!
Dialogue: 0,1:12:58.95,1:13:00.16,Default,,0,0,0,,Тағы да!
Dialogue: 0,1:13:06.25,1:13:08.55,Default,,0,0,0,,Міне!
Dialogue: 0,1:13:10.59,1:13:11.67,Default,,0,0,0,,Теня да батыр ма?
Dialogue: 0,1:13:14.22,1:13:15.59,Default,,0,0,0,,Қарғыс атсын! Жеткізу!
Dialogue: 0,1:13:15.68,1:13:17.47,Default,,0,0,0,,Басыңды еңкей, Кей-бо!
Dialogue: 0,1:13:26.44,1:13:28.48,Default,,0,0,0,,Жеңіңіз!
Dialogue: 0,1:13:37.95,1:13:39.33,Default,,0,0,0,,Асуна!
Dialogue: 0,1:13:41.12,1:13:42.83,Default,,0,0,0,,Я...
Dialogue: 0,1:13:48.00,1:13:49.75,Default,,0,0,0,,Зақым қандай?
Dialogue: 0,1:13:49.84,1:13:51.21,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:13:52.51,1:13:54.01,Default,,0,0,0,,Жарайды
Dialogue: 0,1:13:54.09,1:13:56.09,Default,,0,0,0,,Иә, бұл жақсы болды.
Dialogue: 0,1:13:59.22,1:14:02.35,Default,,0,0,0,,Сонда... әлі де күресуге болады, солай ма?
Dialogue: 0,1:14:02.43,1:14:04.94,Default,,0,0,0,,Ха... Әрине!
Dialogue: 0,1:14:05.89,1:14:08.06,Default,,0,0,0,,Енді бастықты жеңейік.
Dialogue: 0,1:14:08.56,1:14:09.40,Default,,0,0,0,,Иә!
Dialogue: 0,1:14:10.77,1:14:11.61,Default,,0,0,0,,Иә
Dialogue: 0,1:14:14.40,1:14:16.78,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:14:18.16,1:14:20.95,Default,,0,0,0,,Бета нұсқасынан қандай айырмашылығы бар?
Dialogue: 0,1:14:21.03,1:14:23.33,Default,,0,0,0,,Бетаның әлсіздігі маңдайына бекітілді.
Dialogue: 0,1:14:23.41,1:14:27.12,Default,,0,0,0,,Енді үлгі өзгерді және ол бүкіл денеде қозғалатын сияқты.
Dialogue: 0,1:14:27.21,1:14:28.25,Default,,0,0,0,,(шу)
Dialogue: 0,1:14:28.33,1:14:29.96,Default,,0,0,0,,Арх! Арх!
Dialogue: 0,1:14:38.39,1:14:39.51,Default,,0,0,0,,Міне!
Dialogue: 0,1:14:39.60,1:14:41.93,Default,,0,0,0,,Жоқ, бұл тым алыс!
Dialogue: 0,1:14:45.85,1:14:48.27,Default,,0,0,0,,Хааааа!
Dialogue: 0,1:14:57.07,1:14:59.28,Default,,0,0,0,,О, бақылау шабуылы ма?
Dialogue: 0,1:14:59.36,1:15:00.53,Default,,0,0,0,,Мүмкін мен бара аламын
Dialogue: 0,1:15:01.87,1:15:05.75,Default,,0,0,0,,Барлығына! Белгі бойынша сызыққа қадам жасаңыз
Dialogue: 0,1:15:06.25,1:15:09.63,Default,,0,0,0,,Елтаңбаны тапқан бойда құлатамын!
Dialogue: 0,1:15:09.71,1:15:11.46,Default,,0,0,0,,-Ой! - (Шивата) Саған қалдырамын!
Dialogue: 0,1:15:17.05,1:15:18.59,Default,,0,0,0,,Міне! өтінемін!
Dialogue: 0,1:15:18.68,1:15:20.72,Default,,0,0,0,,Хааааа!
Dialogue: 0,1:15:20.80,1:15:22.22,Default,,0,0,0,,Уау!
Dialogue: 0,1:15:22.30,1:15:23.64,Default,,0,0,0,,-Жасай берейік! -Сей!
Dialogue: 0,1:15:23.72,1:15:26.48,Default,,0,0,0,,- Урааа! -(Төмен қолдаушы) Эй!
Dialogue: 0,1:15:42.53,1:15:43.91,Default,,0,0,0,,What... what?
Dialogue: 0,1:15:48.71,1:15:51.04,Default,,0,0,0,,Бұл... Шегін!
Dialogue: 0,1:16:02.01,1:16:03.47,Default,,0,0,0,,Деке…
Dialogue: 0,1:16:03.55,1:16:04.93,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:05.01,1:16:07.89,Default,,0,0,0,,Бірақ қазір біз бастапқы стратегия бойынша күресе аламыз.
Dialogue: 0,1:16:07.98,1:16:10.85,Default,,0,0,0,,Соңғысын бар күшіммен кесемін!
Dialogue: 0,1:16:10.94,1:16:12.31,Default,,0,0,0,,О!
Dialogue: 0,1:16:34.17,1:16:35.71,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:16:36.92,1:16:38.92,Default,,0,0,0,,Енді асығыңыз!
Dialogue: 0,1:16:39.01,1:16:41.59,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,1:16:41.68,1:16:43.09,Default,,0,0,0,,Олар бізден озып кету үшін қиып өтті ме?
Dialogue: 0,1:16:45.76,1:16:47.51,Default,,0,0,0,,Хааааа!
Dialogue: 0,1:16:48.97,1:16:51.27,Default,,0,0,0,,Уау! Хмф!
Dialogue: 0,1:16:56.23,1:16:57.11,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,1:16:59.15,1:17:00.49,Default,,0,0,0,,-Ха... -Хехе!
Dialogue: 0,1:17:07.37,1:17:08.49,Default,,0,0,0,,Уау
Dialogue: 0,1:17:08.58,1:17:11.41,Default,,0,0,0,,Кілт бала: Елтаңба қозғалмайтын сияқты!
Dialogue: 0,1:17:11.50,1:17:13.42,Default,,0,0,0,,Түсіндім! Асуна
Dialogue: 0,1:17:13.50,1:17:14.50,Default,,0,0,0,,Иә!
Dialogue: 0,1:17:18.80,1:17:20.38,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,1:17:31.14,1:17:32.73,Default,,0,0,0,,Маңдайдағы эмблема!
Dialogue: 0,1:17:32.81,1:17:34.19,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:17:34.27,1:17:36.15,Default,,0,0,0,,Ахх! Ха!
Dialogue: 0,1:17:41.44,1:17:42.82,Default,,0,0,0,,Уф...
Dialogue: 0,1:17:42.90,1:17:43.78,Default,,0,0,0,,Мито!
Dialogue: 0,1:17:50.20,1:17:51.20,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,1:17:54.46,1:17:57.83,Default,,0,0,0,,Асуна! Кирито! Ақыр соңында, керемет шешім қабылдаңыз!
Dialogue: 0,1:17:57.92,1:17:59.21,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,1:18:00.09,1:18:01.96,Default,,0,0,0,,Оны қабылдаңыз!
Dialogue: 0,1:18:08.97,1:18:09.85,Default,,0,0,0,,О, жоқ!
Dialogue: 0,1:18:09.93,1:18:11.56,Default,,0,0,0,,Хааааа!
Dialogue: 0,1:18:12.93,1:18:14.43,Default,,0,0,0,,Әй!
Dialogue: 0,1:18:14.52,1:18:15.85,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,1:18:15.94,1:18:17.52,Default,,0,0,0,,Иә!
Dialogue: 0,1:18:17.60,1:18:18.98,Default,,0,0,0,,Қазір...
Dialogue: 0,1:18:19.98,1:18:23.24,Default,,0,0,0,,Бітті!
Dialogue: 0,1:18:24.61,1:18:26.11,Default,,0,0,0,,Хааааа!
Dialogue: 0,1:18:26.20,1:18:27.57,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:18:49.80,1:18:50.64,Default,,0,0,0,,Ах
Dialogue: 0,1:18:53.43,1:18:54.93,Default,,0,0,0,,Ах
Dialogue: 0,1:19:08.45,1:19:09.74,Default,,0,0,0,,Иә...
Dialogue: 0,1:19:10.49,1:19:13.37,Default,,0,0,0,,Иә! Жарайды!
Dialogue: 0,1:19:13.45,1:19:15.83,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,1:19:15.91,1:19:18.04,Default,,0,0,0,,- (Шивата) Ахаха! -(Тыңдау) Эй!
Dialogue: 0,1:19:19.88,1:19:20.88,Default,,0,0,0,,Фу…
Dialogue: 0,1:19:20.96,1:19:23.09,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Кирито-кун
Dialogue: 0,1:19:23.17,1:19:24.30,Default,,0,0,0,,О
Dialogue: 0,1:19:33.97,1:19:36.64,Default,,0,0,0,,Гильдия туы түсіп қалса, маған хабарлаңыз.
Dialogue: 0,1:19:36.73,1:19:39.10,Default,,0,0,0,,
Dialogue: 0,1:19:39.19,1:19:40.65,Default,,0,0,0,,Эй, біреу...
Dialogue: 0,1:19:40.73,1:19:42.02,Default,,0,0,0,,Кирито-кун...
Dialogue: 0,1:19:44.73,1:19:46.28,Default,,0,0,0,,Ондай жер жоқ
Dialogue: 0,1:20:02.96,1:20:04.80,Default,,0,0,0,,Жалау дегенді қалай түсінесіңдер?
Dialogue: 0,1:20:10.55,1:20:11.43,Default,,0,0,0,,Міне, солай!
Dialogue: 0,1:20:18.98,1:20:19.81,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:20:19.89,1:20:22.52,Default,,0,0,0,,Иә, бұл маған қажет емес.
Dialogue: 0,1:20:23.40,1:20:24.23,Default,,0,0,0,,Мито
Dialogue: 0,1:20:25.86,1:20:26.69,Default,,0,0,0,,Асуна
Dialogue: 0,1:20:27.69,1:20:29.65,Default,,0,0,0,,Келгеніңізге рахмет.
Dialogue: 0,1:20:29.74,1:20:30.74,Default,,0,0,0,,Ах
Dialogue: 0,1:20:32.28,1:20:33.11,Default,,0,0,0,,Иә
Dialogue: 0,1:20:36.08,1:20:38.45,Default,,0,0,0,,Қайтадан бірге ше?
Dialogue: 0,1:20:38.54,1:20:41.62,Default,,0,0,0,,Иә... бұл да өте тартымды.
Dialogue: 0,1:20:41.71,1:20:44.13,Default,,0,0,0,,Бірақ білесің бе, мен де тапқым келеді.
Dialogue: 0,1:20:48.34,1:20:49.80,Default,,0,0,0,,Бұл дүниеде қалай өмір сүру керек
Dialogue: 0,1:20:49.88,1:20:51.01,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:53.47,1:20:54.68,Default,,0,0,0,,Мито
Dialogue: 0,1:20:59.77,1:21:04.15,Default,,0,0,0,,Бұл дүниенің ең жақсы бөліктерінің бірі емес пе?
Dialogue: 0,1:21:04.23,1:21:05.98,Default,,0,0,0,,Шынында да солай емес пе?
Dialogue: 0,1:21:06.06,1:21:08.86,Default,,0,0,0,,Мито оны міндетті түрде табады.
Dialogue: 0,1:21:09.48,1:21:13.91,Default,,0,0,0,,Иә, мен бар күшімді саламын. Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,1:21:15.16,1:21:20.00,Default,,0,0,0,,Олай болса маған тағы хабарлас, мен міндетті түрде Асунаға асығамын.
Dialogue: 0,1:21:20.08,1:21:23.21,Default,,0,0,0,,Иә, мен сізге көп сенім артамын.
Dialogue: 0,1:21:25.54,1:21:27.79,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,1:21:27.88,1:21:30.05,Default,,0,0,0,,Мито кейін кездескенше
Dialogue: 0,1:21:36.05,1:21:39.01,Default,,0,0,0,,«ALS» келетін уақыт келді ме?
Dialogue: 0,1:21:39.10,1:21:39.93,Default,,0,0,0,,Иә...
Dialogue: 0,1:21:41.31,1:21:44.56,Default,,0,0,0,,Басқалармен бірге 6-қабатқа шықпағаныңызға қуаныштысыз ба?
Dialogue: 0,1:21:44.64,1:21:48.23,Default,,0,0,0,,Асықпаңыз, мен сізге еріп барамын.
Dialogue: 0,1:21:48.32,1:21:50.73,Default,,0,0,0,,О, аа... рахмет...
Dialogue: 0,1:22:02.83,1:22:03.66,Default,,0,0,0,,Хмф!
Dialogue: 0,1:22:08.17,1:22:09.63,Default,,0,0,0,,Хо-о
Dialogue: 0,1:22:09.71,1:22:14.01,Default,,0,0,0,,Қандай жағдай болмасын, бастықты жеңгеніңізге сенімдімін.
Dialogue: 0,1:22:14.09,1:22:15.34,Default,,0,0,0,,Еңбегіңе рахмет десем, мен кетемін.
Dialogue: 0,1:22:15.43,1:22:18.01,Default,,0,0,0,,Блэккидің бастық заттарын тастағанына не болды?
Dialogue: 0,1:22:18.09,1:22:19.51,Default,,0,0,0,,Иә! Гильдия туы -
Dialogue: 0,1:22:19.60,1:22:20.64,Default,,0,0,0,,Оны тастау керек еді.
Dialogue: 0,1:22:20.72,1:22:23.73,Default,,0,0,0,,А... Мен оны тастадым.
Dialogue: 0,1:22:23.81,1:22:25.23,Default,,0,0,0,,(Ойыншылардың шуы)
Dialogue: 0,1:22:25.31,1:22:29.31,Default,,0,0,0,,Бұл жалау. Оның аты 《Ерлік туы》
Dialogue: 0,1:22:29.40,1:22:31.69,Default,,0,0,0,,Әсері сіз білетін шығар...
Dialogue: 0,1:22:31.78,1:22:34.49,Default,,0,0,0,,Цк... Дүниенің ұрып-соғушысы күткендей
Dialogue: 0,1:22:34.57,1:22:36.53,Default,,0,0,0,,Сонымен, сіз дұрыс түсіндіңіз бе?
Dialogue: 0,1:22:36.61,1:22:41.03,Default,,0,0,0,,-да? Сіз гильдияда болмаған соң, онымен не істейсіз?
Dialogue: 0,1:22:41.95,1:22:44.50,Default,,0,0,0,,Мен мұны сендерге қалдырмаймын.
Dialogue: 0,1:22:44.58,1:22:47.58,Default,,0,0,0,,...бірақ екі шарт бар.
Dialogue: 0,1:22:47.67,1:22:49.50,Default,,0,0,0,,Шарттар туралы не деуге болады?
Dialogue: 0,1:22:50.34,1:22:51.71,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,1:22:51.80,1:22:56.01,Default,,0,0,0,,Екі болса да, біреуі тазаланған болса, жақсы.
Dialogue: 0,1:22:56.09,1:23:00.18,Default,,0,0,0,,Біріншіден, егер сол элемент болашақта басқа уақытта түссе.
Dialogue: 0,1:23:00.26,1:23:04.18,Default,,0,0,0,,Біреуі ``ALS'', екіншісі ''DKB'' иелігінде.
Dialogue: 0,1:23:04.27,1:23:08.48,Default,,0,0,0,,Сол кезде оны жоқ гильдияға тегін беріңіз.
Dialogue: 0,1:23:08.56,1:23:09.44,Default,,0,0,0,,Ал екіншісі ше?
Dialogue: 0,1:23:09.52,1:23:14.65,Default,,0,0,0,,«ALS» және «DKB» қосылып, жаңа гильдия құрылса.
Dialogue: 0,1:23:14.73,1:23:16.40,Default,,0,0,0,,Ондай жағдайда дереу беріңіз
Dialogue: 0,1:23:16.49,1:23:18.20,Default,,0,0,0,,
Dialogue: 0,1:23:18.28,1:23:20.87,Default,,0,0,0,,Және... мұны істеуге ешқандай мүмкіндік жоқ!
Dialogue: 0,1:23:20.95,1:23:24.20,Default,,0,0,0,,Мұндай таңдаулы жігіттермен қосылу әзіл емес!
Dialogue: 0,1:23:24.29,1:23:25.79,Default,,0,0,0,,Олардан да сұраңыз!
Dialogue: 0,1:23:25.87,1:23:27.96,Default,,0,0,0,,Олар маған жынды екенімді айтады!
Dialogue: 0,1:23:28.04,1:23:30.13,Default,,0,0,0,,Жалау қайтадан түсіп кетуі мүмкін.
Dialogue: 0,1:23:30.21,1:23:31.79,Default,,0,0,0,,Бұл қашан болады?
Dialogue: 0,1:23:31.88,1:23:33.13,Default,,0,0,0,,Кирито-кун...
Dialogue: 0,1:23:34.59,1:23:37.51,Default,,0,0,0,,Кешіріңіз, бірақ мен бұл шарттарды өзгерткім келмейді.
Dialogue: 0,1:23:37.59,1:23:40.43,Default,,0,0,0,,Цк... қарғыс атсын...
Dialogue: 0,1:23:40.93,1:23:43.97,Default,,0,0,0,,Мен... білемін!
Dialogue: 0,1:23:44.06,1:23:46.14,Default,,0,0,0,,Сол балалар туды көтерді.
Dialogue: 0,1:23:46.22,1:23:48.39,Default,,0,0,0,,Оны саған бергім келмейді.
Dialogue: 0,1:23:48.48,1:23:51.65,Default,,0,0,0,,Мүмкін емес мәселе, жалаушаны үрлеңіз, оны көшіріп алыңыз
Dialogue: 0,1:23:51.73,1:23:54.02,Default,,0,0,0,,Біз өз гильдиямызды құруды жоспарлап отырмыз!
Dialogue: 0,1:23:54.11,1:23:55.98,Default,,0,0,0,,-Жоқ! -біз!
Dialogue: 0,1:23:56.07,1:23:58.19,Default,,0,0,0,,...Бәрін өзіме сақтап жүрмін. Соңында мен де солай ойладым.
Dialogue: 0,1:23:58.28,1:24:00.91,Default,,0,0,0,,Бұл жігіттердің бос сөзіне құлақ асудың қажеті жоқ.
Dialogue: 0,1:24:00.99,1:24:03.83,Default,,0,0,0,,Киба-сан! Бұл жігіттердің екеуі ғана.
Dialogue: 0,1:24:03.91,1:24:06.66,Default,,0,0,0,,Туды қайтарудың көптеген жолдары бар!
Dialogue: 0,1:24:08.83,1:24:12.29,Default,,0,0,0,,Күш деп айтасыз ба? Джо
Dialogue: 0,1:24:12.38,1:24:15.00,Default,,0,0,0,,Дұрыс, мұнда адам көп.
Dialogue: 0,1:24:15.09,1:24:16.63,Default,,0,0,0,,Екеуміз ғана, бәрібір...
Dialogue: 0,1:24:16.71,1:24:17.55,Default,,0,0,0,,Уф!
Dialogue: 0,1:24:17.63,1:24:19.72,Default,,0,0,0,,Қандай ақымақ!
Dialogue: 0,1:24:19.80,1:24:23.68,Default,,0,0,0,,Зат қаншалықты маңызды болса да, оны алу үшін
Dialogue: 0,1:24:23.76,1:24:28.68,Default,,0,0,0,,Қылышымызды бір ойыншыға бағыттамасақ, біз жай ғана қылмыскерлер тобымыз!
Dialogue: 0,1:24:28.77,1:24:31.52,Default,,0,0,0,,ALS неліктен бар?
Dialogue: 0,1:24:31.60,1:24:33.61,Default,,0,0,0,,Ойлан!
Dialogue: 0,1:24:34.48,1:24:35.44,Default,,0,0,0,,Хмф!
Dialogue: 0,1:24:36.11,1:24:38.94,Default,,0,0,0,,Бұл бос сөзді естігеніме өкінемін.
Dialogue: 0,1:24:39.44,1:24:41.07,Default,,0,0,0,,Алдыңғы күй күйдіру
Dialogue: 0,1:24:41.15,1:24:42.82,Default,,0,0,0,,Бұл 《DKB》 үшін де қолданылады
Dialogue: 0,1:24:42.91,1:24:45.12,Default,,0,0,0,,Біз де солай ойлай аламыз ба?
Dialogue: 0,1:24:45.20,1:24:47.70,Default,,0,0,0,,А... аа, әрине.
Dialogue: 0,1:24:47.79,1:24:52.12,Default,,0,0,0,,Шынымды айтсам, жалауды әзірге сізге қалдырамын.
Dialogue: 0,1:24:52.21,1:24:56.34,Default,,0,0,0,,Шынымды айтсам, қосылудан көп үміт күтпеймін.
Dialogue: 0,1:24:56.42,1:24:57.30,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,1:24:57.38,1:25:00.30,Default,,0,0,0,,Ах... 6-қабаттың негізгі блогының телепортация қақпасы
Dialogue: 0,1:25:00.38,1:25:02.63,Default,,0,0,0,,Ол қазір іске қосылуы керек еді.
Dialogue: 0,1:25:02.72,1:25:05.26,Default,,0,0,0,,Егер сіз Карруинге қайтқыңыз келсе, ол осылай жылдамырақ болады.
Dialogue: 0,1:25:06.68,1:25:07.51,Default,,0,0,0,,Хоука
Dialogue: 0,1:25:12.89,1:25:15.06,Default,,0,0,0,,Үлкен Кирито
Dialogue: 0,1:25:15.15,1:25:16.69,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:25:16.77,1:25:19.44,Default,,0,0,0,,Сайып келгенде, бұл жай ғана Блэкидің үйреншікті ұсыныстары.
Dialogue: 0,1:25:19.53,1:25:21.11,Default,,0,0,0,,Мен гильдияда болмасам да
Dialogue: 0,1:25:21.19,1:25:23.20,Default,,0,0,0,,Сирек заттар кенет жұлып кетті
Dialogue: 0,1:25:23.28,1:25:24.11,Default,,0,0,0,,Құлақ па?
Dialogue: 0,1:25:24.20,1:25:26.70,Default,,0,0,0,,Біз де бар күшімізді саламыз.
Dialogue: 0,1:25:26.78,1:25:30.37,Default,,0,0,0,,Егер сен жалғыз өзің ғана сүйкімді болсаң, мұны өзің істеу керек.
Dialogue: 0,1:25:30.45,1:25:33.58,Default,,0,0,0,,- (Ойыншы) Шаршадым, шаршадым! -(Ойыншы) Дару
Dialogue: 0,1:25:42.59,1:25:43.93,Default,,0,0,0,,Я...
Dialogue: 0,1:25:45.30,1:25:49.10,Default,,0,0,0,,Жарайсың Асуна, демалайық, біз де...
Dialogue: 0,1:25:52.89,1:25:55.10,Default,,0,0,0,,А... Асуна?
Dialogue: 0,1:25:55.73,1:25:56.94,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,1:25:58.23,1:25:59.57,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,1:26:00.61,1:26:04.24,Default,,0,0,0,,Неліктен Кирито-кун осындай нәрсені басынан өткізуі керек?
Dialogue: 0,1:26:04.32,1:26:06.70,Default,,0,0,0,,«Стратегиялар тобына»...
Dialogue: 0,1:26:06.78,1:26:09.78,Default,,0,0,0,,Бұл дүниеде қамалғандардың барлығына
Dialogue: 0,1:26:09.87,1:26:11.54,Default,,0,0,0,,Өлімге дейін күресу...
Dialogue: 0,1:26:11.62,1:26:15.29,Default,,0,0,0,,Гильдияны ыдыратуға жол бермеген Кирито болды.
Dialogue: 0,1:26:15.37,1:26:20.00,Default,,0,0,0,,Бұл адамдар достарымен бірге тұрып, қалағанын жасайды.
Dialogue: 0,1:26:20.09,1:26:22.42,Default,,0,0,0,,Мен басқа адамдармен төбелескенім жақсы...
Dialogue: 0,1:26:23.01,1:26:24.88,Default,,0,0,0,,Сол адамдар үшін Кирито-кун...
Dialogue: 0,1:26:24.97,1:26:27.68,Default,,0,0,0,,Мен жыртылғанша қатты күрессем де,
Dialogue: 0,1:26:27.76,1:26:30.10,Default,,0,0,0,,Адамдардың мен туралы жай ғана жаман сөз айтқанын қаламаймын.
Dialogue: 0,1:26:30.60,1:26:34.27,Default,,0,0,0,,Бұл дұрыс емес... бұл дұрыс емес
Dialogue: 0,1:26:36.02,1:26:38.48,Default,,0,0,0,,Мүлдем қате
Dialogue: 0,1:26:43.61,1:26:46.95,Default,,0,0,0,,Асуна, бұл менің таңдауым.
Dialogue: 0,1:26:48.03,1:26:51.91,Default,,0,0,0,,Мен өзім топқа кірмеуді шештім.
Dialogue: 0,1:26:51.99,1:26:56.41,Default,,0,0,0,,Мен көпшілікке танылғым келеді.
Dialogue: 0,1:26:56.50,1:26:58.88,Default,,0,0,0,,Мен мақтауды қалаймын деп ұрыспаймын.
Dialogue: 0,1:26:59.58,1:27:03.46,Default,,0,0,0,,Егер сіз өзіңізді және жақын адамдарыңызды қорғай алсаңыз—
Dialogue: 0,1:27:03.55,1:27:05.72,Default,,0,0,0,,Басқа ештеңе маңызды емес...
Dialogue: 0,1:27:05.80,1:27:07.34,Default,,0,0,0,,Менде тағдырға сенуден басқа амал қалмады.
Dialogue: 0,1:27:08.51,1:27:11.55,Default,,0,0,0,,Бұл менің осы дүниеде аман қалуым үшін.
Dialogue: 0,1:27:13.43,1:27:17.27,Default,,0,0,0,,Сондықтан мен біреудің мені мойындағанын қалаймын
Dialogue: 0,1:27:17.35,1:27:20.61,Default,,0,0,0,,Мен мақтауға лайық емеспін.
Dialogue: 0,1:27:20.69,1:27:22.82,Default,,0,0,0,,Асунаның мен үшін жылаудың қажеті жоқ...
Dialogue: 0,1:27:22.90,1:27:23.90,Default,,0,0,0,,Ах
Dialogue: 0,1:27:24.53,1:27:27.90,Default,,0,0,0,,Кім үшін жылағанымды өзім шешем!
Dialogue: 0,1:27:37.91,1:27:41.79,Default,,0,0,0,,Онда мен Кирито-кунды мадақтаймын.
Dialogue: 0,1:27:42.92,1:27:45.71,Default,,0,0,0,,Мен сіз үшін не істей аламын ...
Dialogue: 0,1:27:46.34,1:27:47.88,Default,,0,0,0,,Кез келген нәрсені айтыңыз
Dialogue: 0,1:27:51.59,1:27:54.51,Default,,0,0,0,,Осыны айту жеткілікті.
Dialogue: 0,1:27:54.60,1:27:57.39,Default,,0,0,0,,Мен сенің басқа ештеңе істегеніңді қаламаймын...
Dialogue: 0,1:27:57.48,1:27:59.35,Default,,0,0,0,,Онда отырыңыз.
Dialogue: 0,1:28:24.59,1:28:25.88,Default,,0,0,0,,Маған көмектес~! Гү…
Dialogue: 0,1:28:29.38,1:28:32.05,Default,,0,0,0,,5! 4!
Dialogue: 0,1:28:32.68,1:28:37.02,Default,,0,0,0,,3! 2! 1!
Dialogue: 0,1:28:37.10,1:28:39.02,Default,,0,0,0,,Нөл~!
Dialogue: 0,1:28:39.10,1:28:41.77,Default,,0,0,0,,Жаңа жыл құтты болсын!
Dialogue: 0,1:28:43.73,1:28:47.11,Default,,0,0,0,,Жаңа жылыңызбен Кирито-кун
Dialogue: 0,1:28:47.19,1:28:48.69,Default,,0,0,0,,Жаңа жыл құтты болсын
Dialogue: 0,1:28:50.86,1:28:53.61,Default,,0,0,0,,Олай болса, отшашулар жиі болатын.
Dialogue: 0,1:28:53.70,1:28:55.45,Default,,0,0,0,,Қай жерде сатылды?
Dialogue: 0,1:28:55.53,1:28:59.54,Default,,0,0,0,,Оны бастаулар қалашығының бұрышындағы құрал-саймандар дүкенінен сатып алуға болады.
Dialogue: 0,1:28:59.62,1:29:01.46,Default,,0,0,0,,Оны Литен мырза тапты.
Dialogue: 0,1:29:01.54,1:29:04.42,Default,,0,0,0,,Ху~ Сонда бұл отшашулар құбыжық...
Dialogue: 0,1:29:04.50,1:29:06.84,Default,,0,0,0,,Өкінішке орай, оны тек ауқымда пайдалануға болады.
Dialogue: 0,1:29:06.92,1:29:09.05,Default,,0,0,0,,О, түсіндім...
Dialogue: 0,1:29:11.30,1:29:13.89,Default,,0,0,0,,2023 иә...
Dialogue: 0,1:29:14.55,1:29:18.93,Default,,0,0,0,,Екі ай өткеніне сене алар емеспін.
Dialogue: 0,1:29:19.02,1:29:20.02,Default,,0,0,0,,Иә
Dialogue: 0,1:29:20.10,1:29:23.02,Default,,0,0,0,,Мен бастаулар қаласындағы қонақүйде жатқан кезім
Dialogue: 0,1:29:23.10,1:29:25.52,Default,,0,0,0,,Бұл өте ұзақ күн болды
Dialogue: 0,1:29:26.02,1:29:28.65,Default,,0,0,0,,Енді әр күн көзді ашып-жұмғанша өтіп бара жатқандай сезіледі
Dialogue: 0,1:29:31.49,1:29:36.07,Default,,0,0,0,,Мен, бастаулар қаласын тастап, Кирито-кунды кездестірмес бұрын.
Dialogue: 0,1:29:36.16,1:29:39.16,Default,,0,0,0,,Мен қаруымды бір реттік деп ойладым.
Dialogue: 0,1:29:39.24,1:29:42.96,Default,,0,0,0,,Бір нәрсені нығайтпай, сақтамай, қайта-қайта сатып алу.
Dialogue: 0,1:29:43.04,1:29:46.46,Default,,0,0,0,,Өткірлігін жоғалтқанда мен оны зынданның еденіне лақтырдым.
Dialogue: 0,1:29:46.54,1:29:51.13,Default,,0,0,0,,Бірақ бұл да менің өткен өмірім еді, солай емес пе?
Dialogue: 0,1:29:51.21,1:29:54.38,Default,,0,0,0,,Бірақ мен Митодан 《Wind Fleuret》 алдым.
Dialogue: 0,1:29:54.47,1:29:58.14,Default,,0,0,0,,Кирито-кунның арқасында мен оны қазіргі қылышқа айналдыра алдым...
Dialogue: 0,1:29:58.22,1:30:03.10,Default,,0,0,0,,Осылай төбелескен сайын бірте-бірте өзімді жақсы сезіне бастадым.
Dialogue: 0,1:30:03.18,1:30:05.56,Default,,0,0,0,,Өзімізге жақсырақ қамқорлық жасайық
Dialogue: 0,1:30:05.65,1:30:10.48,Default,,0,0,0,,Сонымен Кирито-кун, өтінемін, өзіңді де күт.
Dialogue: 0,1:30:10.57,1:30:11.65,Default,,0,0,0,,О
Dialogue: 0,1:30:12.90,1:30:17.24,Default,,0,0,0,,А, мен төменге түсіп, жаңа бөтелке мен жейтін бірдеңе алып келейін.
Dialogue: 0,1:30:17.32,1:30:19.66,Default,,0,0,0,,А, мен де барамын.
Dialogue: 0,1:30:30.21,1:30:32.76,Default,,0,0,0,,Қадамыңызды бақылаңыз.
Dialogue: 0,1:30:33.67,1:30:34.59,Default,,0,0,0,,О
Dialogue: 0,1:30:35.26,1:30:36.09,Default,,0,0,0,,Не?
Dialogue: 0,1:30:36.18,1:30:38.51,Default,,0,0,0,,Е, жоқ, бұл ештеңе емес.
Dialogue: 0,1:30:46.69,1:30:47.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:48.56,1:30:49.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:53.73,1:30:54.94,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,1:30:55.03,1:30:57.57,Default,,0,0,0,,А, жоқ, ештеңе.
Dialogue: 0,1:30:57.66,1:30:58.87,Default,,0,0,0,,Олай болса, тезірек барайық.
Dialogue: 0,1:30:58.95,1:30:59.78,Default,,0,0,0,,Иә
Dialogue: 0,1:30:59.87,1:31:02.83,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:31:37.45,1:31:41.07,Default,,0,0,0,,Бұл Шоу Таайым
Dialogue: 0,1:31:41.91,1:31:44.74,Default,,0,0,0,,(Асунаның шошынған дауысы)
Dialogue: 0,1:31:45.33,1:31:46.16,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:31:46.25,1:31:49.12,Default,,0,0,0,,Уа, тыныш отыр.
Dialogue: 0,1:31:49.21,1:31:54.13,Default,,0,0,0,,Егер сіз қозғалсаңыз, пышақ мына жас ханымның ішіне кіреді, солай ма?
Dialogue: 0,1:31:55.51,1:31:57.22,Default,,0,0,0,,Бұл ауқымда.
Dialogue: 0,1:31:57.30,1:32:00.01,Default,,0,0,0,,Бұл ешқандай қауіп төндірмейді.
Dialogue: 0,1:32:00.09,1:32:01.34,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,1:32:01.43,1:32:03.93,Default,,0,0,0,,Мықты болыңыз, Блэки мырза.
Dialogue: 0,1:32:04.01,1:32:08.18,Default,,0,0,0,,Алдыңғы аула аумақта, ал бұл жер зындан ретінде қарастырылады, солай ма?
Dialogue: 0,1:32:08.27,1:32:09.10,Default,,0,0,0,,Не!
Dialogue: 0,1:32:11.77,1:32:13.81,Default,,0,0,0,,Бір ғана пышақпен не істеуге болады?
Dialogue: 0,1:32:13.90,1:32:17.28,Default,,0,0,0,,О~ Бұл өте күшті.
Dialogue: 0,1:32:17.78,1:32:20.86,Default,,0,0,0,,Бірақ бұл жігіттің жүзінде 5-деңгейдегі парализдік у бар.
Dialogue: 0,1:32:20.95,1:32:23.78,Default,,0,0,0,,Егер ол улы затпен қапталған болса ше?
Dialogue: 0,1:32:23.87,1:32:25.03,Default,,0,0,0,,Ха…
Dialogue: 0,1:32:29.16,1:32:31.21,Default,,0,0,0,,Неліктен мұны істейсің?
Dialogue: 0,1:32:31.29,1:32:32.75,Default,,0,0,0,,Алайда, біз оның қозғалысын тоқтата аламыз.
Dialogue: 0,1:32:34.21,1:32:37.96,Default,,0,0,0,,Көрініп тұр, аға, қызық болғандықтан.
Dialogue: 0,1:32:38.05,1:32:39.92,Default,,0,0,0,,Бет... ақ па?
Dialogue: 0,1:32:40.01,1:32:42.93,Default,,0,0,0,,О, мен көңіл көтергім келеді.
Dialogue: 0,1:32:43.01,1:32:45.47,Default,,0,0,0,,Бұл үлкен сахна, солай емес пе?
Dialogue: 0,1:32:45.56,1:32:48.52,Default,,0,0,0,,Мен әртүрлі заттарды дайындап, қызықты етіп жасағым келеді.
Dialogue: 0,1:32:48.60,1:32:53.31,Default,,0,0,0,,Қане, жолға түссең де қызықсыз. Орындарды ауыстырайық.
Dialogue: 0,1:32:53.40,1:32:55.31,Default,,0,0,0,,«Жертөле» туралы не деуге болады?
Dialogue: 0,1:32:58.19,1:32:59.61,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,1:32:59.69,1:33:00.53,Default,,0,0,0,,Асуна...
Dialogue: 0,1:33:11.54,1:33:13.25,Default,,0,0,0,,-Кирито-кун! -Оу!
Dialogue: 0,1:33:14.92,1:33:17.00,Default,,0,0,0,,Гррр!
Dialogue: 0,1:33:25.47,1:33:27.05,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:33:31.93,1:33:36.69,Default,,0,0,0,,Қайта кездескенше мистер Блэки, Фенсер мырза
Dialogue: 0,1:33:36.77,1:33:37.61,Default,,0,0,0,,Ha
Dialogue: 0,1:33:43.15,1:33:45.24,Default,,0,0,0,,Улар қолданылмаған
Dialogue: 0,1:33:45.91,1:33:48.12,Default,,0,0,0,,Бұл өтірік болды.
Dialogue: 0,1:33:48.91,1:33:50.79,Default,,0,0,0,,Неліктен бұлай істедің?
Dialogue: 0,1:33:50.87,1:33:53.50,Default,,0,0,0,,Егер бұл жер шынымен ауқымнан тыс болса
Dialogue: 0,1:33:53.58,1:33:55.75,Default,,0,0,0,,Жер астына ешнәрсені көшіру үшін қиындыққа бармаңыз.
Dialogue: 0,1:33:55.83,1:33:57.63,Default,,0,0,0,,Ешқандай сұрақ қоймастан мен сені пышақтап алуым керек еді.
Dialogue: 0,1:33:57.71,1:33:59.84,Default,,0,0,0,,Бірақ егер мен қате түсіндім...
Dialogue: 0,1:33:59.92,1:34:00.76,Default,,0,0,0,,Жарайды
Dialogue: 0,1:34:02.42,1:34:03.47,Default,,0,0,0,,Осыған байланысты
Dialogue: 0,1:34:05.51,1:34:06.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:34:07.80,1:34:08.80,Default,,0,0,0,,Не!
Dialogue: 0,1:34:08.89,1:34:11.27,Default,,0,0,0,,Уа! Уссо
Dialogue: 0,1:34:11.35,1:34:13.56,Default,,0,0,0,,Сен шын айтасың ба, Асуна-сан...
Dialogue: 0,1:34:13.64,1:34:14.73,Default,,0,0,0,,Хехе
Dialogue: 0,1:34:16.06,1:34:18.40,Default,,0,0,0,,Митоға рахмет
Dialogue: 0,1:34:22.90,1:34:26.86,Default,,0,0,0,,Әйтеуір, екеуміз де аман қалғанымызға қуаныштымын. Қауіпсіздік үшін бұл жерден тезірек кетейік...
Dialogue: 0,1:34:26.95,1:34:29.87,Default,,0,0,0,,Кирито-кун, бұрынғы адам шығар.
Dialogue: 0,1:34:29.95,1:34:32.24,Default,,0,0,0,,Гильдия туын бізден ұрлау ниетімен.
Dialogue: 0,1:34:32.33,1:34:33.66,Default,,0,0,0,,Менің ойымша, бұл маған шабуыл жасады.
Dialogue: 0,1:34:33.75,1:34:34.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:34:34.71,1:34:37.50,Default,,0,0,0,,«Үлкен сахна» деді
Dialogue: 0,1:34:37.58,1:34:39.75,Default,,0,0,0,,«Мен әртүрлі заттарды дайындап, оны жандандырғым келеді».
Dialogue: 0,1:34:39.84,1:34:43.09,Default,,0,0,0,,Екі негізгі гильдия ``ALS'' және ``DKB'' болса ше?
Dialogue: 0,1:34:43.17,1:34:45.22,Default,,0,0,0,,Әңгіме ұрыс туралы болса ше?
Dialogue: 0,1:34:45.30,1:34:49.43,Default,,0,0,0,,Олай болса, әлі ерте емес пе? Біз қазір не білеміз
Dialogue: 0,1:34:49.51,1:34:51.18,Default,,0,0,0,,Мүмкін емес мәселе: Бүріккіш...
Dialogue: 0,1:34:51.26,1:34:53.14,Default,,0,0,0,,Менің мүшем маған қорқынышты ақпарат берді...
Dialogue: 0,1:34:53.22,1:34:54.68,Default,,0,0,0,,Адамдар Морт деп атады
Dialogue: 0,1:34:54.77,1:34:56.69,Default,,0,0,0,,Кибау мырза мен Линд мырзаға
Dialogue: 0,1:34:56.77,1:34:58.23,Default,,0,0,0,,Олар бір-бірімізді өлтіргенімізді қалайды...
Dialogue: 0,1:34:58.90,1:35:01.23,Default,,0,0,0,,Амал жоқ... ПК тобы!
Dialogue: 0,1:35:01.32,1:35:02.48,Default,,0,0,0,,Морттың серіктері...
Dialogue: 0,1:35:02.57,1:35:05.11,Default,,0,0,0,,Иә, бұл өте ықтимал.
Dialogue: 0,1:35:06.40,1:35:09.20,Default,,0,0,0,,Біздің ақпараттың ағып жатқанына сенімдімін
Dialogue: 0,1:35:09.87,1:35:11.41,Default,,0,0,0,,Бұл дүние ақырында айналады
Dialogue: 0,1:35:11.49,1:35:13.66,Default,,0,0,0,,Ойыншылар бір-бірін өлтіре бастайды
Dialogue: 0,1:35:13.74,1:35:15.96,Default,,0,0,0,,Бұл енді ойын стратегиясы емес
Dialogue: 0,1:35:17.25,1:35:20.04,Default,,0,0,0,,Бұл, әрине, мүмкін.
Dialogue: 0,1:35:20.13,1:35:24.55,Default,,0,0,0,,Егер солай болса, біз олардың туды ұрлауына жол бере алмаймыз.
Dialogue: 0,1:35:24.63,1:35:26.30,Default,,0,0,0,,Егер күресу керек болса...
Dialogue: 0,1:35:26.38,1:35:29.39,Default,,0,0,0,,Мен ПҚ-ның кейбір әдістерін білемін.
Dialogue: 0,1:35:29.47,1:35:32.72,Default,,0,0,0,,Мен бета күндерінен бері көптеген дуэльдерді бастан өткердім.
Dialogue: 0,1:35:35.47,1:35:37.48,Default,,0,0,0,,Онда мен де төбелесемін.
Dialogue: 0,1:35:37.56,1:35:40.10,Default,,0,0,0,,Не? Жоқ, бұл менің ниетім емес...
Dialogue: 0,1:35:40.19,1:35:41.61,Default,,0,0,0,,Жоқ, мен шештім!
Dialogue: 0,1:35:41.69,1:35:44.94,Default,,0,0,0,,Бұдан былай мен Кирито-кунға қауіпті рөлдерді бермеймін.
Dialogue: 0,1:35:46.03,1:35:49.24,Default,,0,0,0,,Ал біз серіктеспіз, солай ма?
Dialogue: 0,1:35:49.32,1:35:54.20,Default,,0,0,0,,Сіз маған жер астында көмектескеніңіздей мен де сізді қолдаймын.
Dialogue: 0,1:35:56.66,1:36:00.42,Default,,0,0,0,,Аа, біз серіктеспіз. Біз сіздермен жұмыс істеуді асыға күтеміз.
Dialogue: 0,1:36:00.50,1:36:01.88,Default,,0,0,0,,Иә
Dialogue: 0,1:36:01.96,1:36:03.17,Default,,0,0,0,,Ах
Dialogue: 0,1:36:06.34,1:36:08.22,Default,,0,0,0,,Кеттік, Кирито-кун.
Dialogue: 0,1:36:08.72,1:36:10.72,Default,,0,0,0,,О, Асуна
Dialogue: 0,1:37:06.82,1:37:11.82,Default,,0,0,0,,♪~
Dialogue: 0,1:40:34.94,1:40:39.90,Default,,0,0,0,,~♪
Dialogue: 0,1:40:41.40,1:40:47.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory