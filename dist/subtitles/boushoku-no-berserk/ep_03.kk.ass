Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.55,0:00:13.38,Default,,0,0,0,,Бұл кім? (Рокси) Уау!
Dialogue: 0,0:00:13.47,0:00:14.39,Default,,0,0,0,,Қазірдің өзінде... иә!
Dialogue: 0,0:00:14.47,0:00:16.14,Default,,0,0,0,,Леди Рокси?
Dialogue: 0,0:00:16.93,0:00:19.14,Default,,0,0,0,,Сіз таң қалдыңыз, солай емес пе?
Dialogue: 0,0:00:19.22,0:00:20.81,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:20.89,0:00:24.02,Default,,0,0,0,,Бұл әдеттегіден мүлдем басқа, сондықтан мен түсінбеймін.
Dialogue: 0,0:00:24.10,0:00:27.02,Default,,0,0,0,,Мм... сен осылай киініп сарайға бардың ба?
Dialogue: 0,0:00:27.11,0:00:28.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:29.94,0:00:32.82,Default,,0,0,0,,Ол анықталғаннан бері көмектесу мүмкін емес.
Dialogue: 0,0:00:34.03,0:00:35.16,Default,,0,0,0,,Фуфу
Dialogue: 0,0:00:35.24,0:00:37.16,Default,,0,0,0,,Шындығында... мм...
Dialogue: 0,0:00:38.08,0:00:41.45,Default,,0,0,0,,Мен қаланы жасырын тексеруге барғалы жатырмын.
Dialogue: 0,0:00:41.54,0:00:43.66,Default,,0,0,0,,О, өзіңізді жасырыңыз.
Dialogue: 0,0:00:43.75,0:00:46.21,Default,,0,0,0,,Бұл әркімде бола бермейді.
Dialogue: 0,0:00:46.29,0:00:49.63,Default,,0,0,0,,Егер Хару бұл туралы білсе...
Dialogue: 0,0:00:49.71,0:00:54.34,Default,,0,0,0,,Жас ханым, өзіңізді Харт отбасының басшысы сияқты ұстаңыз.
Dialogue: 0,0:00:54.43,0:00:56.55,Default,,0,0,0,,Түсіндім! Уф...
Dialogue: 0,0:00:58.85,0:01:00.14,Default,,0,0,0,,Жақсы естіледі ме?
Dialogue: 0,0:01:00.22,0:01:01.72,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:01:04.98,0:01:09.02,Default,,0,0,0,,Сізді ұстап қалғаным үшін кешіріңіз. Мен де жұмысқа қайтамын.
Dialogue: 0,0:01:09.11,0:01:09.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:10.02,0:01:13.11,Default,,0,0,0,,Фэй, күте тұр, мен жақсы нәрсе ойладым.
Dialogue: 0,0:01:13.19,0:01:15.53,Default,,0,0,0,,Фэйге құпия тапсырма беріңіз
Dialogue: 0,0:01:15.61,0:01:16.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:16.78,0:01:20.33,Default,,0,0,0,,Тексеру кезінде менімен бірге жүруіңізді және мені алып жүруіңізді өтінемін.
Dialogue: 0,0:01:20.41,0:01:21.62,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:01:23.00,0:01:28.00,Default,,0,0,0,,♪～
Dialogue: 0,0:02:47.96,0:02:52.96,Default,,0,0,0,,～♪
Dialogue: 0,0:02:53.04,0:02:55.88,Default,,0,0,0,,Фэй, асығыңыз.
Dialogue: 0,0:02:55.96,0:02:58.17,Default,,0,0,0,,Хехе, міне, міне.
Dialogue: 0,0:02:59.34,0:03:01.34,Default,,0,0,0,,Күте тұрыңыз, Рокси-сама.
Dialogue: 0,0:03:01.43,0:03:02.51,Default,,0,0,0,,Cola Cola Cola
Dialogue: 0,0:03:02.60,0:03:04.81,Default,,0,0,0,,Мені Рокси деп атасаңыз, олар біледі.
Dialogue: 0,0:03:04.89,0:03:05.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:06.89,0:03:08.73,Default,,0,0,0,,Тоқта
Dialogue: 0,0:03:08.81,0:03:11.44,Default,,0,0,0,,Мені Рокси десеңіз, адамдар біледі.
Dialogue: 0,0:03:11.52,0:03:12.90,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:03:12.98,0:03:13.81,Default,,0,0,0,,Шу!
Dialogue: 0,0:03:13.90,0:03:15.44,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:03:15.52,0:03:16.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:16.44,0:03:19.24,Default,,0,0,0,,Е, жоқ, ештеңе.
Dialogue: 0,0:03:19.32,0:03:21.32,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:03:21.41,0:03:24.95,Default,,0,0,0,,А, өтінемін, мені Локи деп атаңыз.
Dialogue: 0,0:03:25.03,0:03:27.29,Default,,0,0,0,,Бүгін мен Локимін
Dialogue: 0,0:03:27.37,0:03:29.75,Default,,0,0,0,,Сіз көп өзгермейді деп ойладыңыз.
Dialogue: 0,0:03:29.83,0:03:30.96,Default,,0,0,0,,Шулы
Dialogue: 0,0:03:31.04,0:03:31.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:32.46,0:03:35.42,Default,,0,0,0,,Ха, кешіріңіз, тым қатты.
Dialogue: 0,0:03:35.50,0:03:37.63,Default,,0,0,0,,Не? Иә, бұл дұрыс емес.
Dialogue: 0,0:03:37.71,0:03:40.84,Default,,0,0,0,,Бірақ бұл шулы
Dialogue: 0,0:03:40.93,0:03:43.39,Default,,0,0,0,,Бұл мүлдем шулы емес.
Dialogue: 0,0:03:43.47,0:03:45.05,Default,,0,0,0,,жақсы болар еді
Dialogue: 0,0:03:45.64,0:03:49.27,Default,,0,0,0,,Мен Фэймен біргемін деп ойлағанда, біраз қобалжыдым.
Dialogue: 0,0:03:49.35,0:03:51.73,Default,,0,0,0,,Камадо!
Dialogue: 0,0:03:51.81,0:03:52.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:55.44,0:03:57.65,Default,,0,0,0,,Жастар, солай емес пе?
Dialogue: 0,0:03:57.73,0:03:59.40,Default,,0,0,0,,Шулы
Dialogue: 0,0:03:59.49,0:04:00.32,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:04:00.40,0:04:02.53,Default,,0,0,0,,Уа... (Рокси) Қылышты нашар ұстау...
Dialogue: 0,0:04:02.61,0:04:03.91,Default,,0,0,0,,Мен сені кешірмеймін
Dialogue: 0,0:04:03.99,0:04:06.87,Default,,0,0,0,,О, қасиетті рыцарь күткендей, сіз түсінесіз.
Dialogue: 0,0:04:07.87,0:04:09.58,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:09.66,0:04:13.29,Default,,0,0,0,,Енді ойлап қарасам, мен Фаэ қылышын бірінші рет көрдім.
Dialogue: 0,0:04:13.37,0:04:14.71,Default,,0,0,0,,А...
Dialogue: 0,0:04:14.79,0:04:15.96,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:04:16.04,0:04:17.84,Default,,0,0,0,,Мен сияқты жолы болмағандар
Dialogue: 0,0:04:17.92,0:04:21.47,Default,,0,0,0,,Әдетте мен қылыш ұстамаймын, сондықтан адамдар оны біртүрлі деп ойлауы мүмкін.
Dialogue: 0,0:04:21.55,0:04:23.26,Default,,0,0,0,,Және...
Dialogue: 0,0:04:23.34,0:04:28.31,Default,,0,0,0,,Ашкөздік шеберлігі жанның дәмін білген соң, тоқтай алмайсың.
Dialogue: 0,0:04:28.39,0:04:30.27,Default,,0,0,0,,Неғұрлым көп жесеңіз, соғұрлым күшті боласыз.
Dialogue: 0,0:04:30.35,0:04:33.31,Default,,0,0,0,,Неғұрлым көп жесеңіз, соғұрлым оны қалайсыз.
Dialogue: 0,0:04:33.39,0:04:34.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:33.39,0:04:34.23,Default,,0,0,0,,Мен мұны тоқтатсам ше?
Dialogue: 0,0:04:34.23,0:04:35.35,Default,,0,0,0,,Мен мұны тоқтатсам ше?
Dialogue: 0,0:04:35.44,0:04:36.98,Default,,0,0,0,,Аштан өлесің бе?
Dialogue: 0,0:04:35.44,0:04:36.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:36.98,0:04:37.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:37.06,0:04:38.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:37.06,0:04:38.48,Default,,0,0,0,,Сіз өзіңізді сезінбейсіз және кім болса да, кез келген адамға шабуыл жасай бастайсыз.
Dialogue: 0,0:04:38.48,0:04:38.57,Default,,0,0,0,,Сіз өзіңізді сезінбейсіз және кім болса да, кез келген адамға шабуыл жасай бастайсыз.
Dialogue: 0,0:04:38.57,0:04:41.03,Default,,0,0,0,,Сіз өзіңізді сезінбейсіз және кім болса да, кез келген адамға шабуыл жасай бастайсыз.
Dialogue: 0,0:04:38.57,0:04:41.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:41.03,0:04:41.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:42.32,0:04:46.66,Default,,0,0,0,,Мен ешкімнің ашкөздік шеберлігі туралы білгенін қаламаймын.
Dialogue: 0,0:04:48.12,0:04:48.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:49.79,0:04:51.70,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:52.25,0:04:53.75,Default,,0,0,0,,Маған қылышты көрсетіңізші.
Dialogue: 0,0:04:53.83,0:04:54.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:56.71,0:04:58.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:02.72,0:05:05.18,Default,,0,0,0,,Оған қамқорлық жасаған жөн.
Dialogue: 0,0:05:05.26,0:05:07.93,Default,,0,0,0,,Мен саған кейінірек Харт отбасының ұстаханасын көрсетемін.
Dialogue: 0,0:05:08.01,0:05:09.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:09.39,0:05:10.76,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:05:10.85,0:05:11.89,Default,,0,0,0,,Иә
Dialogue: 0,0:05:11.97,0:05:15.44,Default,,0,0,0,,Өте жақсы, біз техникалық қызмет көрсетуді жасай аламыз.
Dialogue: 0,0:05:16.40,0:05:17.60,Default,,0,0,0,,Ашкөздік, не болды?
Dialogue: 0,0:05:17.69,0:05:19.90,Default,,0,0,0,,Шу! Мен кейінгі нұрға батып кеттім
Dialogue: 0,0:05:19.98,0:05:21.07,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:05:21.15,0:05:21.98,Default,,0,0,0,,Ұзақ дыбыс?
Dialogue: 0,0:05:22.07,0:05:24.57,Default,,0,0,0,,Роксидің иісі жақсы.
Dialogue: 0,0:05:24.65,0:05:26.74,Default,,0,0,0,,Қарғыс атқыр, сен осылай істейсің!
Dialogue: 0,0:05:26.74,0:05:27.16,Default,,0,0,0,,Қарғыс атқыр, сен осылай істейсің!
Dialogue: 0,0:05:26.74,0:05:27.16,Default,,0,0,0,,Ахх...
Dialogue: 0,0:05:27.16,0:05:27.24,Default,,0,0,0,,Ахх...
Dialogue: 0,0:05:27.24,0:05:28.03,Default,,0,0,0,,Ахх...
Dialogue: 0,0:05:27.24,0:05:28.03,Default,,0,0,0,,Фэй...
Dialogue: 0,0:05:28.03,0:05:28.53,Default,,0,0,0,,Фэй...
Dialogue: 0,0:05:28.62,0:05:30.74,Default,,0,0,0,,Тез иә
Dialogue: 0,0:05:30.83,0:05:32.49,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:05:32.58,0:05:34.16,Default,,0,0,0,,Уау
Dialogue: 0,0:05:49.26,0:05:50.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:51.10,0:05:52.51,Default,,0,0,0,,Бұл жақсы жүзім.
Dialogue: 0,0:05:52.60,0:05:54.56,Default,,0,0,0,,Жас ханым, сіздің көзіңіз керемет.
Dialogue: 0,0:05:54.64,0:05:58.52,Default,,0,0,0,,Бұл Харт отбасында өсірілген жүзім.
Dialogue: 0,0:05:58.60,0:06:00.11,Default,,0,0,0,,Тамақтың сынамасын ала аламын ба?
Dialogue: 0,0:06:00.19,0:06:02.32,Default,,0,0,0,,Хехе, бұл болды.
Dialogue: 0,0:06:02.40,0:06:04.78,Default,,0,0,0,,Иә (Рокси) Рахмет.
Dialogue: 0,0:06:07.15,0:06:07.99,Default,,0,0,0,,Иә
Dialogue: 0,0:06:08.95,0:06:09.82,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:06:09.91,0:06:13.08,Default,,0,0,0,,Әрине, жүзім үйде өсірілетіндіктен.
Dialogue: 0,0:06:13.16,0:06:14.79,Default,,0,0,0,,Менің үйім? (Рокси) А...
Dialogue: 0,0:06:14.87,0:06:17.50,Default,,0,0,0,,Өкінішті, тіпті Рокси-сама да біледі.
Dialogue: 0,0:06:17.58,0:06:20.54,Default,,0,0,0,,Менің бір туысым Харт отбасында жұмыс істейді деп ойлаймын.
Dialogue: 0,0:06:20.63,0:06:21.46,Default,,0,0,0,,Зұлымдар Альянсы мен Шие Хачисай-кай арасында жақсы ынтымақтастық жоқ —
Dialogue: 0,0:06:22.09,0:06:25.01,Default,,0,0,0,,Оның туысы Харт отбасында жұмыс істейді.
Dialogue: 0,0:06:25.09,0:06:26.38,Default,,0,0,0,,О, солай.
Dialogue: 0,0:06:26.47,0:06:28.59,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:06:28.68,0:06:30.43,Default,,0,0,0,,Бұл қанша? (Дүкенші) Ой...
Dialogue: 0,0:06:30.51,0:06:32.35,Default,,0,0,0,,О, олай емес...
Dialogue: 0,0:06:32.43,0:06:33.31,Default,,0,0,0,,Я...
Dialogue: 0,0:06:35.31,0:06:36.85,Default,,0,0,0,,Ғажайып Фэй
Dialogue: 0,0:06:36.93,0:06:38.27,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:38.35,0:06:40.23,Default,,0,0,0,,Мен саған қарыздармын, Тағдыр.
Dialogue: 0,0:06:40.31,0:06:41.48,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:06:41.56,0:06:42.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:42.48,0:06:43.90,Default,,0,0,0,,Жоқ, бұл оқиға.
Dialogue: 0,0:06:43.98,0:06:46.69,Default,,0,0,0,,Фуфу оғаш Фэй
Dialogue: 0,0:06:47.28,0:06:49.03,Default,,0,0,0,,Қасиетті Рыцарь дұрыс айтады! (Рокси) А...
Dialogue: 0,0:06:49.11,0:06:52.07,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:06:55.37,0:06:57.37,Default,,0,0,0,,Тіпті осы нарықта
Dialogue: 0,0:06:57.45,0:06:59.58,Default,,0,0,0,,Сен не істеп жатырсың?
Dialogue: 0,0:06:59.67,0:07:02.00,Default,,0,0,0,,Мистер Мейсон қайтыс болғанда
Dialogue: 0,0:07:02.08,0:07:05.30,Default,,0,0,0,,Ол тіпті ең төменгі деңгейге дейін бастық болды.
Dialogue: 0,0:07:07.59,0:07:10.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:10.30,0:07:11.97,Default,,0,0,0,,Жақсы уақыт.
Dialogue: 0,0:07:12.05,0:07:13.64,Default,,0,0,0,,（）
Dialogue: 0,0:07:16.06,0:07:17.10,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:07:17.18,0:07:19.56,Default,,0,0,0,,Бұл ең нашар...
Dialogue: 0,0:07:23.31,0:07:24.48,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:07:25.57,0:07:27.65,Default,,0,0,0,,(Изуку) Ойланып көрсең, біз таңғаларлық іс жасаппыз, иә?
Dialogue: 0,0:07:28.40,0:07:30.28,Default,,0,0,0,,...
Dialogue: 0,0:07:30.36,0:07:32.49,Default,,0,0,0,,(Изуку) Ойланып көрсең, біз таңғаларлық іс жасаппыз, иә?
Dialogue: 0,0:07:33.07,0:07:35.66,Default,,0,0,0,,（）…
Dialogue: 0,0:07:36.70,0:07:38.04,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:39.25,0:07:40.58,Default,,0,0,0,,Сіз кешірім сұрадыңыз, солай ма?
Dialogue: 0,0:07:40.66,0:07:41.83,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:07:41.92,0:07:45.59,Default,,0,0,0,,Қасиетті Рыцарьды қорғайтын батыл
Dialogue: 0,0:07:46.34,0:07:47.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:47.55,0:07:49.59,Default,,0,0,0,,Бұл мен бұрын бір жерден көрген жүз.
Dialogue: 0,0:07:49.67,0:07:50.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:50.92,0:07:53.18,Default,,0,0,0,,Бұл Рокси-сама емес пе?
Dialogue: 0,0:07:53.26,0:07:54.47,Default,,0,0,0,,Иә... (Ер) Рокси-сама...
Dialogue: 0,0:07:54.55,0:07:56.22,Default,,0,0,0,,А... (Еркек) Әйтеуір...
Dialogue: 0,0:07:56.31,0:07:57.14,Default,,0,0,0,,...
Dialogue: 0,0:07:57.22,0:07:59.27,Default,,0,0,0,,Бұл жаман. Осылай жүре берсең, білесің.
Dialogue: 0,0:07:59.35,0:08:01.56,Default,,0,0,0,,Ғашық болып, жабысып қалу
Dialogue: 0,0:08:01.64,0:08:04.02,Default,,0,0,0,,Оны Рокси-сама деп ешкім ойламайды.
Dialogue: 0,0:08:04.10,0:08:05.61,Default,,0,0,0,,Сіз менің сүйіктім болып көрінесіз бе?
Dialogue: 0,0:08:05.69,0:08:07.19,Default,,0,0,0,,Міне, Фэй.
Dialogue: 0,0:08:09.03,0:08:11.57,Default,,0,0,0,,Ал... Мен таңғы ас дайындадым.
Dialogue: 0,0:08:11.65,0:08:13.28,Default,,0,0,0,,Өйткені мен оны жемеймін
Dialogue: 0,0:08:13.36,0:08:16.24,Default,,0,0,0,,Тамақ ішу ысырап сияқты.
Dialogue: 0,0:08:16.33,0:08:19.04,Default,,0,0,0,,А, сен не айтып тұрсың?
Dialogue: 0,0:08:19.12,0:08:20.41,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:20.95,0:08:24.25,Default,,0,0,0,,Жемесең, басқасын жасамаймын.
Dialogue: 0,0:08:24.33,0:08:25.96,Default,,0,0,0,,Е, же, же
Dialogue: 0,0:08:26.04,0:08:28.42,Default,,0,0,0,,Сондықтан оны қайталаңыз...
Dialogue: 0,0:08:29.09,0:08:30.34,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:30.42,0:08:32.55,Default,,0,0,0,,Мен қыши бастадым.
Dialogue: 0,0:08:35.09,0:08:37.01,Default,,0,0,0,,Мен сені келесі жолы дұрыс тамақтандырамын.
Dialogue: 0,0:08:37.10,0:08:39.06,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:08:39.14,0:08:40.81,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:08:40.89,0:08:41.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:42.64,0:08:45.06,Default,,0,0,0,,Бұл Рокси-сама емес.
Dialogue: 0,0:08:45.15,0:08:47.73,Default,,0,0,0,,Қасиетті Рыцарь тамақ жасамайды.
Dialogue: 0,0:08:47.81,0:08:50.94,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:08:53.70,0:08:55.36,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:08:56.91,0:08:58.87,Default,,0,0,0,,Алғаш рет ер адаммен қол ұстасу
Dialogue: 0,0:08:58.95,0:08:59.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.87,0:09:02.96,Default,,0,0,0,,Менің жүрегім әлі соғып тұр
Dialogue: 0,0:09:03.83,0:09:05.21,Default,,0,0,0,,Уф, кешіріңіз, мен...
Dialogue: 0,0:09:05.29,0:09:06.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:06.21,0:09:09.25,Default,,0,0,0,,...
Dialogue: 0,0:09:09.34,0:09:10.75,Default,,0,0,0,,Мен үйреніп қалдым.
Dialogue: 0,0:09:10.84,0:09:12.97,Default,,0,0,0,,… （）
Dialogue: 0,0:09:13.05,0:09:14.72,Default,,0,0,0,,Барайық Уху
Dialogue: 0,0:09:14.80,0:09:17.76,Default,,0,0,0,,Жастар бар, солай ма?
Dialogue: 0,0:09:14.80,0:09:17.76,Default,,0,0,0,,（）
Dialogue: 0,0:09:17.84,0:09:18.68,Default,,0,0,0,,Я...
Dialogue: 0,0:09:19.26,0:09:23.77,Default,,0,0,0,,...
Dialogue: 0,0:09:28.27,0:09:31.07,Default,,0,0,0,,...
Dialogue: 0,0:09:31.15,0:09:32.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:34.07,0:09:35.53,Default,,0,0,0,,Зергерлік бұйымдар?
Dialogue: 0,0:09:35.61,0:09:36.45,Default,,0,0,0,,Иә
Dialogue: 0,0:09:36.53,0:09:39.24,Default,,0,0,0,,Сонда да мен әйелмін.
Dialogue: 0,0:09:39.32,0:09:41.12,Default,,0,0,0,,Мені қызықтырады.
Dialogue: 0,0:09:41.20,0:09:42.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:43.58,0:09:45.00,Default,,0,0,0,,Бұл да асыл тас па?
Dialogue: 0,0:09:45.08,0:09:47.21,Default,,0,0,0,,Бұл өрескел тас.
Dialogue: 0,0:09:47.29,0:09:48.46,Default,,0,0,0,,Сіз оны бөлуге тырысқанша
Dialogue: 0,0:09:48.54,0:09:51.42,Default,,0,0,0,,...
Dialogue: 0,0:09:51.50,0:09:53.09,Default,,0,0,0,,Дөрекі тас
Dialogue: 0,0:09:51.50,0:09:53.09,Default,,0,0,0,,Иә
Dialogue: 0,0:09:53.17,0:09:56.38,Default,,0,0,0,,１ 10
Dialogue: 0,0:09:56.47,0:09:59.22,Default,,0,0,0,,Егер сіз оны бағалау арқылы іздесеңіз, сіз бір кадрда білесіз.
Dialogue: 0,0:10:03.35,0:10:05.48,Default,,0,0,0,,Өшірулі ме?
Dialogue: 0,0:10:05.56,0:10:06.77,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:10:06.85,0:10:10.44,Default,,0,0,0,,...
Dialogue: 0,0:10:13.15,0:10:14.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:15.61,0:10:17.36,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:10:17.45,0:10:19.03,Default,,0,0,0,,Осылай қарады
Dialogue: 0,0:10:19.11,0:10:23.33,Default,,0,0,0,,...
Dialogue: 0,0:10:23.41,0:10:26.00,Default,,0,0,0,,Егер сіз оған сыйлық бергіңіз келсе, мен оны сізге беремін.
Dialogue: 0,0:10:26.08,0:10:27.46,Default,,0,0,0,,Бір күміс монета ше?
Dialogue: 0,0:10:27.54,0:10:29.04,Default,,0,0,0,,Иә? Ол?
Dialogue: 0,0:10:29.96,0:10:31.84,Default,,0,0,0,,… （）
Dialogue: 0,0:10:32.59,0:10:34.71,Default,,0,0,0,,Жастар, солай емес пе?
Dialogue: 0,0:10:34.80,0:10:37.13,Default,,0,0,0,,...
Dialogue: 0,0:10:37.22,0:10:38.93,Default,,0,0,0,,...
Dialogue: 0,0:10:39.01,0:10:41.80,Default,,0,0,0,,...
Dialogue: 0,0:10:43.31,0:10:44.14,Default,,0,0,0,,Әке! Әке~!!
Dialogue: 0,0:10:45.10,0:10:46.77,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:10:46.85,0:10:47.68,Default,,0,0,0,,Иә
Dialogue: 0,0:10:47.77,0:10:51.23,Default,,0,0,0,,...
Dialogue: 0,0:10:51.31,0:10:55.48,Default,,0,0,0,,...
Dialogue: 0,0:10:55.57,0:11:00.11,Default,,0,0,0,,...
Dialogue: 0,0:11:00.20,0:11:01.37,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:11:01.45,0:11:04.45,Default,,0,0,0,,Сіз естідіңіз бе? Мен көптеген гоблиндердің өліп жатқанын естідім.
Dialogue: 0,0:11:04.53,0:11:05.41,Default,,0,0,0,,О
Dialogue: 0,0:11:05.49,0:11:08.71,Default,,0,0,0,,...
Dialogue: 0,0:11:08.79,0:11:11.63,Default,,0,0,0,,Осылай болды ма?
Dialogue: 0,0:11:12.58,0:11:13.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:14.13,0:11:15.46,Default,,0,0,0,,Қараңғы балалар үйінде
Dialogue: 0,0:11:15.55,0:11:18.88,Default,,0,0,0,,Гоблин Кингтің құлағын сыйлаған жауынгер туралы әңгіме бар ма?
Dialogue: 0,0:11:20.93,0:11:24.10,Default,,0,0,0,,...
Dialogue: 0,0:11:24.18,0:11:25.31,Default,,0,0,0,,… （）
Dialogue: 0,0:11:25.39,0:11:27.27,Default,,0,0,0,,...
Dialogue: 0,0:11:27.35,0:11:28.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:28.27,0:11:29.68,Default,,0,0,0,,...
Dialogue: 0,0:11:29.77,0:11:32.02,Default,,0,0,0,,Сіз тағы бірдеңе білесіз бе?
Dialogue: 0,0:11:32.10,0:11:32.98,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:11:33.06,0:11:35.82,Default,,0,0,0,,Бізден гөрі жауынгерлерден сұра.
Dialogue: 0,0:11:36.40,0:11:40.07,Default,,0,0,0,,Фей, мені жауынгер жатқан жерге апарыңызшы.
Dialogue: 0,0:11:40.15,0:11:44.53,Default,,0,0,0,,Мүмкін бұл тексеру анықтау үшін болған шығар?
Dialogue: 0,0:11:44.62,0:11:45.58,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:11:45.66,0:11:50.00,Default,,0,0,0,,Бұл жақында патша астанасының айналасында пайда болған қаңғыбас құбыжықтарға қатысты тергеу.
Dialogue: 0,0:11:50.08,0:11:54.00,Default,,0,0,0,,Мені айтасың ба, адасқан құбыжық?
Dialogue: 0,0:11:54.08,0:11:56.92,Default,,0,0,0,,Қазір қызық болып барады.
Dialogue: 0,0:12:02.72,0:12:03.59,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:12:05.39,0:12:07.72,Default,,0,0,0,,О, жоқ.
Dialogue: 0,0:12:07.81,0:12:09.93,Default,,0,0,0,,Өлген тұрақты...
Dialogue: 0,0:12:10.02,0:12:12.89,Default,,0,0,0,,Тағдыр тірі еді!
Dialogue: 0,0:12:12.98,0:12:14.10,Default,,0,0,0,,Мен тірімін
Dialogue: 0,0:12:14.81,0:12:15.86,Default,,0,0,0,,Бұл жерде жақсы ма?
Dialogue: 0,0:12:15.94,0:12:17.07,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:19.15,0:12:21.03,Default,,0,0,0,,...
Dialogue: 0,0:12:21.11,0:12:25.16,Default,,0,0,0,,Әй, мынау... Мен жаңа жұмыс орнымда ағамын.
Dialogue: 0,0:12:25.24,0:12:27.74,Default,,0,0,0,,Мен Локимін. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:12:28.45,0:12:31.04,Default,,0,0,0,,Тағдырға қатысты көмегіңіз үшін рахмет.
Dialogue: 0,0:12:31.12,0:12:34.25,Default,,0,0,0,,Соған қарамастан, мен сізді біраз уақыттан кейін бірінші рет көрдім деп ойладым.
Dialogue: 0,0:12:34.33,0:12:36.50,Default,,0,0,0,,Сен қызыңмен жасамайсың ба?
Dialogue: 0,0:12:36.59,0:12:38.21,Default,,0,0,0,,Цк... бұл дұрыс емес!
Dialogue: 0,0:12:38.30,0:12:39.96,Default,,0,0,0,,Бұл менің құрбым.
Dialogue: 0,0:12:40.05,0:12:42.92,Default,,0,0,0,,Рокси-сама ренжісе не істеуім керек?
Dialogue: 0,0:12:43.01,0:12:45.64,Default,,0,0,0,,Сіз lese majeste үшін өлім жазасын алуыңыз мүмкін.
Dialogue: 0,0:12:47.64,0:12:49.10,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:12:49.18,0:12:51.27,Default,,0,0,0,,Бірлесіп әрекет етіп жатыр ма?
Dialogue: 0,0:12:51.35,0:12:53.35,Default,,0,0,0,,Күйді бақылау мүмкін емес
Dialogue: 0,0:12:53.44,0:12:55.81,Default,,0,0,0,,Кеселерді қирататын жауынгерлер бар.
Dialogue: 0,0:12:55.90,0:12:59.23,Default,,0,0,0,,Жоқ, мен сізді тым жақсы сезінген сияқтымын.
Dialogue: 0,0:12:59.32,0:13:00.98,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:13:01.07,0:13:03.82,Default,,0,0,0,,Қуан, бұл мәртебеңнің артқанының дәлелі.
Dialogue: 0,0:13:03.90,0:13:06.20,Default,,0,0,0,,Ол әлдеқашан бұзылған.
Dialogue: 0,0:13:06.28,0:13:09.78,Default,,0,0,0,,Ах, ахахха, солай ма?
Dialogue: 0,0:13:11.58,0:13:14.75,Default,,0,0,0,,Мен гоблин мәйіттерінен ақша тапқан жауынгерді білемін.
Dialogue: 0,0:13:15.37,0:13:16.79,Default,,0,0,0,,Егер сіз гоблин аулауға барсаңыз
Dialogue: 0,0:13:16.88,0:13:19.84,Default,,0,0,0,,Екі құлағы бұзылмаған гоблин мәйіті.
Dialogue: 0,0:13:19.92,0:13:21.96,Default,,0,0,0,,Шамасы, олар жан-жаққа шашырап кеткен сияқты.
Dialogue: 0,0:13:22.05,0:13:25.34,Default,,0,0,0,,Егер сіз жауынгер болсаңыз, қолма-қол ақша іздеу керек.
Dialogue: 0,0:13:25.43,0:13:27.22,Default,,0,0,0,,Егер жоқ болса
Dialogue: 0,0:13:27.30,0:13:30.06,Default,,0,0,0,,Өйткені ол басқа аймақтардан ағылған.
Dialogue: 0,0:13:30.14,0:13:32.43,Default,,0,0,0,,Бұл адасқан құбыжықтың ісі болуы мүмкін.
Dialogue: 0,0:13:32.52,0:13:35.39,Default,,0,0,0,,Егер бұл орын алса, бизнес өседі.
Dialogue: 0,0:13:35.48,0:13:37.15,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:13:37.23,0:13:40.32,Default,,0,0,0,,Зат алуға барасың ба, әлде патша астанасына зат сатуға келесің бе.
Dialogue: 0,0:13:40.40,0:13:42.73,Default,,0,0,0,,Гоблин жазықтарын айналып өту мүмкін емес.
Dialogue: 0,0:13:42.82,0:13:45.45,Default,,0,0,0,,Бірақ жұмбақ құбыжық пайда болса...
Dialogue: 0,0:13:45.53,0:13:47.36,Default,,0,0,0,,Ешкім өткісі келмейді
Dialogue: 0,0:13:47.45,0:13:49.12,Default,,0,0,0,,Әркім өлгісі келмейді.
Dialogue: 0,0:13:49.95,0:13:53.08,Default,,0,0,0,,Түсіндім, бұл менің кінәм.
Dialogue: 0,0:13:54.58,0:13:56.29,Default,,0,0,0,,Йо (Мастер) Аддо ата
Dialogue: 0,0:13:56.37,0:13:58.25,Default,,0,0,0,,Көп уақыт өтті. Бұл Тағдыр.
Dialogue: 0,0:13:58.33,0:14:00.21,Default,,0,0,0,,Бұл... Шыққан!
Dialogue: 0,0:14:01.55,0:14:02.67,Default,,0,0,0,,Сіз байсыз ба?
Dialogue: 0,0:14:02.75,0:14:03.67,Default,,0,0,0,,О
Dialogue: 0,0:14:03.76,0:14:07.47,Default,,0,0,0,,Адасқан құбыжықтың шынайы болмысы өте бай.
Dialogue: 0,0:14:07.55,0:14:09.26,Default,,0,0,0,,Олай болса, қиын.
Dialogue: 0,0:14:09.34,0:14:10.18,Default,,0,0,0,,О
Dialogue: 0,0:14:10.26,0:14:14.22,Default,,0,0,0,,Сондықтан, жақын арада оны бағындыру үшін Қасиетті Рыцарьлар қозғалатын сияқты.
Dialogue: 0,0:14:14.31,0:14:15.93,Default,,0,0,0,,Иә! (Рокси) Бұл рас па?
Dialogue: 0,0:14:16.02,0:14:19.44,Default,,0,0,0,,Хмм, мен оны бір солдаттан естідім, сондықтан сенімдімін.
Dialogue: 0,0:14:19.52,0:14:22.73,Default,,0,0,0,,Эй, эй, эй, Қасиетті Рыцарь сенің қарсыласың ба?
Dialogue: 0,0:14:22.82,0:14:25.57,Default,,0,0,0,,Сіздің қазіргі күйіңіз мүлдем пайдасыз.
Dialogue: 0,0:14:26.57,0:14:27.90,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:14:30.03,0:14:30.87,Default,,0,0,0,,Пуха…
Dialogue: 0,0:14:30.95,0:14:34.12,Default,,0,0,0,,Сіз неге қаңғыбас құбыжықтарға сонша алаңдайсыз?
Dialogue: 0,0:14:34.20,0:14:38.16,Default,,0,0,0,,А-а-а-а-а-а... дұрыс.
Dialogue: 0,0:14:38.25,0:14:41.25,Default,,0,0,0,,Рокси-сама бағынуға көшсе
Dialogue: 0,0:14:41.33,0:14:42.88,Default,,0,0,0,,Мені көргенде...
Dialogue: 0,0:14:45.21,0:14:47.30,Default,,0,0,0,,Бұл керемет дүкен. (Ұстаз) Қош келдіңіз.
Dialogue: 0,0:14:47.38,0:14:48.26,Default,,0,0,0,,Иә, жарай ма?
Dialogue: 0,0:14:48.88,0:14:50.47,Default,,0,0,0,,Саяхатшы жауынгер?
Dialogue: 0,0:14:50.55,0:14:53.43,Default,,0,0,0,,Адам санына қарай ішімдік пен тамаққа тапсырыс беремін.
Dialogue: 0,0:14:53.51,0:14:54.43,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:14:54.51,0:14:57.39,Default,,0,0,0,,Ал... ана жақтағы жас ханым.
Dialogue: 0,0:14:57.48,0:14:59.35,Default,,0,0,0,,Мен бе? (Жауынгерлік өнер) Ах
Dialogue: 0,0:15:00.27,0:15:01.81,Default,,0,0,0,,Уа... (Такето) Бізбен бірге.
Dialogue: 0,0:15:01.90,0:15:03.90,Default,,0,0,0,,Көңілді болайық Тоқта!
Dialogue: 0,0:15:04.61,0:15:06.23,Default,,0,0,0,,Уа... (Рокси) Иә!
Dialogue: 0,0:15:06.32,0:15:08.15,Default,,0,0,0,,Керемет! Гррр...
Dialogue: 0,0:15:08.24,0:15:09.99,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:10.07,0:15:14.24,Default,,0,0,0,,Тоқта! Мұндай нәрсені тек Қасиетті Рыцарь ғана жасай алады.
Dialogue: 0,0:15:14.33,0:15:16.62,Default,,0,0,0,,Әй, қасиетті рыцарь!
Dialogue: 0,0:15:17.50,0:15:18.87,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:21.29,0:15:22.58,Default,,0,0,0,,Құрметті Рокси\NМен бұл
Dialogue: 0,0:15:22.67,0:15:24.54,Default,,0,0,0,,деп ойладым
Dialogue: 0,0:15:25.88,0:15:27.51,Default,,0,0,0,,Сізді алдағаным үшін кешіріңіз.
Dialogue: 0,0:15:27.59,0:15:28.80,Default,,0,0,0,,Рокси
Dialogue: 0,0:15:28.88,0:15:29.97,Default,,0,0,0,,Харт отбасы
Dialogue: 0,0:15:30.72,0:15:34.93,Default,,0,0,0,,Корольді қолдайтын бес ұлы отбасының сол Рокси жүрегі
Dialogue: 0,0:15:35.01,0:15:38.10,Default,,0,0,0,,Өте дөрекі болғаным үшін кешіріңіз!
Dialogue: 0,0:15:38.18,0:15:39.89,Default,,0,0,0,,Мен... жай ғана өмір.
Dialogue: 0,0:15:39.98,0:15:42.52,Default,,0,0,0,,Ақша алғыңыз келсе, осында жүріңіз.
Dialogue: 0,0:15:42.60,0:15:43.86,Default,,0,0,0,,Оны тастаңыз
Dialogue: 0,0:15:43.94,0:15:45.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:45.15,0:15:46.32,Default,,0,0,0,,Қорғау үшін халықтан
Dialogue: 0,0:15:46.40,0:15:49.44,Default,,0,0,0,,Мен қорқатын нәрсеге айналдым.
Dialogue: 0,0:15:49.53,0:15:51.61,Default,,0,0,0,,Мен қайғылы сезінемін
Dialogue: 0,0:15:51.70,0:15:54.78,Default,,0,0,0,,And I'm ashamed
Dialogue: 0,0:15:56.33,0:15:58.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:58.79,0:16:03.04,Default,,0,0,0,,Originally, holy knights were supposed to protect the people.
Dialogue: 0,0:16:03.12,0:16:05.88,Default,,0,0,0,,A world where we can laugh together with the people
Dialogue: 0,0:16:05.96,0:16:07.75,Default,,0,0,0,,Бұл әкемнің тілегі еді.
Dialogue: 0,0:16:08.63,0:16:11.22,Default,,0,0,0,,Бұл менің тілегім
Dialogue: 0,0:16:11.30,0:16:13.68,Default,,0,0,0,,тура Мейсон мырзаға ұқсайды
Dialogue: 0,0:16:15.72,0:16:18.22,Default,,0,0,0,,Сол тілек орындалатын күнге дейін
Dialogue: 0,0:16:20.77,0:16:23.52,Default,,0,0,0,,(Барлық мүшелер сөйлеседі)
Dialogue: 0,0:16:23.60,0:16:24.48,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:16:24.56,0:16:25.36,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:25.36,0:16:27.44,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:25.36,0:16:27.44,Default,,0,0,0,,Рокси-саманы орындаңыз
Dialogue: 0,0:16:27.52,0:16:28.90,Default,,0,0,0,,Сәлем! (Жауынгерлік өнер) Уф! Гах...
Dialogue: 0,0:16:28.98,0:16:30.99,Default,,0,0,0,,Не болды Не болды
Dialogue: 0,0:16:35.82,0:16:37.78,Default,,0,0,0,,Иә, сонда, сонда, сонда.
Dialogue: 0,0:16:37.87,0:16:38.70,Default,,0,0,0,,Иә Иә Иә
Dialogue: 0,0:16:39.29,0:16:40.91,Default,,0,0,0,,Бұл жақсы болуы керек.
Dialogue: 0,0:16:41.00,0:16:43.37,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:16:43.46,0:16:46.33,Default,,0,0,0,,Ах, бұл сергітетін болды.
Dialogue: 0,0:16:47.21,0:16:48.50,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:16:48.59,0:16:50.51,Default,,0,0,0,,Thanks to you, we were able to perform maintenance.
Dialogue: 0,0:16:50.59,0:16:52.80,Default,,0,0,0,,Рахмет айту керек адаммын.
Dialogue: 0,0:16:52.88,0:16:54.26,Default,,0,0,0,,Thanks to Fate
Dialogue: 0,0:16:54.34,0:16:57.05,Default,,0,0,0,,I was able to find out about the stray monster.
Dialogue: 0,0:16:57.14,0:16:59.31,Default,,0,0,0,,Ойланып қарашы, неге Рокси-сама?
Dialogue: 0,0:16:59.39,0:17:01.43,Default,,0,0,0,,Сіз бағыныштылық туралы білмедіңіз бе?
Dialogue: 0,0:17:01.52,0:17:02.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:02.85,0:17:07.23,Default,,0,0,0,,The Brelik family has the information and won't tell us.
Dialogue: 0,0:17:08.36,0:17:09.69,Default,,0,0,0,,Сол жігіттер
Dialogue: 0,0:17:09.77,0:17:11.53,Default,,0,0,0,,Оны лас қолмен ұстамаңыз!
Dialogue: 0,0:17:11.61,0:17:12.69,Default,,0,0,0,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,0:17:12.78,0:17:14.40,Default,,0,0,0,,Бұл дауыс Хадо.
Dialogue: 0,0:17:14.49,0:17:15.99,Default,,0,0,0,,Ауырды! Ол аурады!
Dialogue: 0,0:17:16.07,0:17:18.20,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:17:18.28,0:17:19.91,Default,,0,0,0,,Hud Stop it!
Dialogue: 0,0:17:19.99,0:17:21.54,Default,,0,0,0,,Тағы да сен бе?
Dialogue: 0,0:17:21.62,0:17:24.37,Default,,0,0,0,,Мен жоғалған баланы қорғадым.
Dialogue: 0,0:17:24.46,0:17:25.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:25.08,0:17:27.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:25.08,0:17:27.21,Default,,0,0,0,,Мемильге дейін бірге
Dialogue: 0,0:17:27.21,0:17:27.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:27.29,0:17:28.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:27.29,0:17:28.21,Default,,0,0,0,,Бұл қорғаныс қай жерде?
Dialogue: 0,0:17:28.21,0:17:29.84,Default,,0,0,0,,Бұл қорғаныс қай жерде?
Dialogue: 0,0:17:29.92,0:17:31.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:32.05,0:17:34.05,Default,,0,0,0,,Itte te mee ah uh...
Dialogue: 0,0:17:34.13,0:17:36.51,Default,,0,0,0,,Жақсы көрінесің, Тағдыр.
Dialogue: 0,0:17:40.81,0:17:43.27,Default,,0,0,0,,Қалғанын өз қолыма аламын.
Dialogue: 0,0:17:43.35,0:17:44.68,Default,,0,0,0,,From that Rafal
Dialogue: 0,0:17:44.77,0:17:48.90,Default,,0,0,0,,Why didn't you tell me about the subjugation of stray monsters?
Dialogue: 0,0:17:48.98,0:17:52.36,Default,,0,0,0,,Your father just passed away, so it must be tough.
Dialogue: 0,0:17:52.94,0:17:54.32,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:17:54.40,0:17:56.78,Default,,0,0,0,,Hmm, I see.
Dialogue: 0,0:17:56.86,0:17:58.53,Default,,0,0,0,,So Hun
Dialogue: 0,0:17:58.62,0:18:00.24,Default,,0,0,0,,Қоқыс қоқыс сияқты болсын.
Dialogue: 0,0:18:03.29,0:18:05.04,Default,,0,0,0,,Бұл қандай көздер?
Dialogue: 0,0:18:05.12,0:18:06.75,Default,,0,0,0,,Тоқташы, Худ, кеттік.
Dialogue: 0,0:18:06.83,0:18:07.67,Default,,0,0,0,,Чи…
Dialogue: 0,0:18:07.75,0:18:09.17,Default,,0,0,0,,Бая!
Dialogue: 0,0:18:09.25,0:18:10.88,Default,,0,0,0,,Мен қасиетті рыцарларды жек көремін.
Dialogue: 0,0:18:12.25,0:18:13.84,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:18:13.92,0:18:16.84,Default,,0,0,0,,Неліктен апаң кешірім сұрайды?
Dialogue: 0,0:18:16.93,0:18:19.93,Default,,0,0,0,,А, мен бұл киіммен айта алмаймын.
Dialogue: 0,0:18:20.01,0:18:21.22,Default,,0,0,0,,Сіз ажырасып кеттіңіз бе?
Dialogue: 0,0:18:21.30,0:18:22.85,Default,,0,0,0,,Иә, анаммен.
Dialogue: 0,0:18:22.93,0:18:24.14,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:24.22,0:18:26.56,Default,,0,0,0,,Олай болса, аға мен апа, оны іздеп көрейік.
Dialogue: 0,0:18:26.64,0:18:28.06,Default,,0,0,0,,Иә
Dialogue: 0,0:18:28.14,0:18:29.98,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:30.73,0:18:32.86,Default,,0,0,0,,О, мен бір қарап көрейін.
Dialogue: 0,0:18:34.19,0:18:36.99,Default,,0,0,0,,Мен де бір рет адасып қалдым.
Dialogue: 0,0:18:37.07,0:18:38.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:38.86,0:18:42.74,Default,,0,0,0,,Әкем өмірден өткен соң мен астанаға келдім.
Dialogue: 0,0:18:42.83,0:18:45.41,Default,,0,0,0,,5 жыл болды ма?
Dialogue: 0,0:18:50.12,0:18:53.42,Default,,0,0,0,,Сол кезде маған мейірімді болған Қасиетті Рыцарь
Dialogue: 0,0:18:53.50,0:18:55.71,Default,,0,0,0,,Қызық, не болып жатыр?
Dialogue: 0,0:18:55.80,0:18:57.34,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:19:01.85,0:19:04.43,Default,,0,0,0,,Одан әрі іздеу қиын.
Dialogue: 0,0:19:04.51,0:19:05.64,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:19:05.72,0:19:06.81,Default,,0,0,0,,Ей, жылама
Dialogue: 0,0:19:06.89,0:19:10.69,Default,,0,0,0,,Бүгін менің үйімде қалып, ертең тағы іздейік.
Dialogue: 0,0:19:10.77,0:19:11.60,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:11.69,0:19:12.77,Default,,0,0,0,,Лео! Ах!
Dialogue: 0,0:19:12.86,0:19:13.98,Default,,0,0,0,,Лео!
Dialogue: 0,0:19:14.07,0:19:15.94,Default,,0,0,0,,Анашым!
Dialogue: 0,0:19:22.57,0:19:25.33,Default,,0,0,0,,Оны тапқаныңызға қуаныштымын...
Dialogue: 0,0:19:40.55,0:19:42.05,Default,,0,0,0,,Ха! Сол 100 йендік тиынды таста! Ора!
Dialogue: 0,0:19:42.14,0:19:43.39,Default,,0,0,0,,Жоқ, шын мәнінде емес.
Dialogue: 0,0:19:43.47,0:19:46.89,Default,,0,0,0,,Тезірек үйге бармасаң, ұрыспа.
Dialogue: 0,0:19:46.97,0:19:48.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:49.02,0:19:50.35,Default,,0,0,0,,Фэй Иә?
Dialogue: 0,0:19:51.69,0:19:54.31,Default,,0,0,0,,Ұрысқанда біз біргеміз.
Dialogue: 0,0:19:54.40,0:19:57.32,Default,,0,0,0,,Жарайды, мен сенімен барамын.
Dialogue: 0,0:19:57.40,0:19:58.28,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:58.99,0:20:01.74,Default,,0,0,0,,Енді үйімізге қайтайық.
Dialogue: 0,0:20:03.07,0:20:04.95,Default,,0,0,0,,Біздің үй…
Dialogue: 0,0:20:05.78,0:20:08.12,Default,,0,0,0,,Иә, Рокси.
Dialogue: 0,0:20:13.29,0:20:15.84,Default,,0,0,0,,Осындай күндер мәңгілікке созылса екен
Dialogue: 0,0:20:17.25,0:20:18.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:19.67,0:20:20.97,Default,,0,0,0,,Не?
Dialogue: 0,0:20:21.05,0:20:23.97,Default,,0,0,0,,Рокси білместен құбыжықтарды қалай аулауға болады?
Dialogue: 0,0:20:24.05,0:20:26.22,Default,,0,0,0,,А, мен не істеуім керек?
Dialogue: 0,0:20:26.30,0:20:28.85,Default,,0,0,0,,Бір жол бар
Dialogue: 0,0:20:32.48,0:20:34.40,Default,,0,0,0,,Тануды блоктауға арналған сиқырлы құрал?
Dialogue: 0,0:20:34.48,0:20:35.48,Default,,0,0,0,,Басқа адамнан
Dialogue: 0,0:20:35.56,0:20:38.78,Default,,0,0,0,,Тағдыр екеумізді басқа адамдарға ұқсататын маска.
Dialogue: 0,0:20:38.86,0:20:41.74,Default,,0,0,0,,Бұл мен үшін өте қолайлы, жарай ма?
Dialogue: 0,0:20:41.82,0:20:42.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:44.86,0:20:46.16,Default,,0,0,0,,Мұны мен үшін жасайсыз ба?
Dialogue: 0,0:20:46.95,0:20:49.12,Default,,0,0,0,,Мені жұмысқа қабылдағаныңызға рахмет. (Рокси) Иә?
Dialogue: 0,0:20:49.20,0:20:52.83,Default,,0,0,0,,Роксиге рахмет, жаңа жұмыс және ыстық тамақ.
Dialogue: 0,0:20:53.62,0:20:57.09,Default,,0,0,0,,Мен өзім үшін отбасымдай болған адамдарды кездестіре алдым.
Dialogue: 0,0:20:57.17,0:20:59.09,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:21:00.88,0:21:01.92,Default,,0,0,0,,Фэй
Dialogue: 0,0:21:02.01,0:21:04.55,Default,,0,0,0,,Жарайды, мен аламын.
Dialogue: 0,0:21:04.63,0:21:06.97,Default,,0,0,0,,Негізі Рокси-сама қарап тұрған тас
Dialogue: 0,0:21:07.05,0:21:08.51,Default,,0,0,0,,Мен оны сатып алғым келеді.
Dialogue: 0,0:21:08.60,0:21:11.22,Default,,0,0,0,,Жоқ, мен бақыттымын.
Dialogue: 0,0:21:12.52,0:21:14.85,Default,,0,0,0,,Бұл керемет күш.
Dialogue: 0,0:21:14.94,0:21:17.06,Default,,0,0,0,,Fei Бұл хит!
Dialogue: 0,0:21:17.15,0:21:19.11,Default,,0,0,0,,Айласыз тағдыр
Dialogue: 0,0:21:19.19,0:21:20.36,Default,,0,0,0,,Шу!
Dialogue: 0,0:21:20.44,0:21:22.44,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:21:26.24,0:21:28.16,Default,,0,0,0,,Мен оны бағалаймын.
Dialogue: 0,0:21:28.24,0:21:30.41,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,0:21:30.49,0:21:31.87,Default,,0,0,0,,Оның орнына нені қалайсыз?
Dialogue: 0,0:21:31.95,0:21:32.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:32.87,0:21:35.00,Default,,0,0,0,,Өйткені Фэй етті жақсы көреді.
Dialogue: 0,0:21:35.08,0:21:36.71,Default,,0,0,0,,Бір жылға арналған ет?
Dialogue: 0,0:21:36.79,0:21:38.75,Default,,0,0,0,,Қылыш ұстауға арналған ілмек?
Dialogue: 0,0:21:38.84,0:21:40.34,Default,,0,0,0,,Whetstone Good
Dialogue: 0,0:21:38.84,0:21:40.34,Default,,0,0,0,,Бір нәрсені қайтару жақсы.
Dialogue: 0,0:21:40.34,0:21:40.96,Default,,0,0,0,,Бір нәрсені қайтару жақсы
Dialogue: 0,0:21:41.05,0:21:41.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:41.05,0:21:41.88,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:21:41.88,0:21:42.71,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:21:42.80,0:21:44.34,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,0:21:42.80,0:21:44.34,Default,,0,0,0,,Содан кейін ілмек таспен
Dialogue: 0,0:21:44.42,0:21:47.09,Default,,0,0,0,,Не айтып тұрсың, ақымақ? Маған ілмек тас беріңіз.
Dialogue: 0,0:21:47.18,0:21:48.64,Default,,0,0,0,,Маған қамқор бол!
Dialogue: 0,0:21:48.72,0:21:49.93,Default,,0,0,0,,Тек аузыңды жап!
Dialogue: 0,0:21:59.86,0:22:01.65,Default,,0,0,0,,Бұл оның ағасының қабылдау рәсімі ғой, иә?
Dialogue: 0,0:22:01.73,0:22:05.53,Default,,0,0,0,,Галлия экспедициясын талқылаңыз
Dialogue: 0,0:22:06.07,0:22:11.08,Default,,0,0,0,,♪～
Dialogue: 0,0:23:30.99,0:23:35.99,Default,,0,0,0,,～♪
