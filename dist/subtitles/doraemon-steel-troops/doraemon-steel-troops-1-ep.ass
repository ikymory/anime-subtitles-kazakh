Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.54,0:00:12.55,Default,,0,0,0,,♪〜
Dialogue: 0,0:00:13.76,0:00:17.93,Default,,0,0,0,,♪ Біріншісі - махаббат
Dialogue: 0,0:00:19.01,0:00:24.19,Default,,0,0,0,,♪ Сен екеуміз бірміз
Dialogue: 0,0:00:26.52,0:00:31.15,Default,,0,0,0,,♪ Екінші тілек
Dialogue: 0,0:00:31.69,0:00:38.66,Default,,0,0,0,,♪ Сен сенсің мен менмін
Dialogue: 0,0:00:40.79,0:00:45.96,Default,,0,0,0,,♪ Мен үшінші нәрсе туралы ойлаймын.
Dialogue: 0,0:00:46.08,0:00:49.88,Default,,0,0,0,,♪ Сіз кімсіз?
Dialogue: 0,0:00:50.00,0:00:55.63,Default,,0,0,0,,♪ Мен қандаймын?
Dialogue: 0,0:00:55.76,0:00:58.76,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:00.72,0:01:03.10,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:01:03.52,0:01:07.31,Default,,0,0,0,,Мехатопияның барлық жауынгерлері, қараңдар!
Dialogue: 0,0:01:09.73,0:01:13.65,Default,,0,0,0,,Бұл жер жақында біздікі болады.
Dialogue: 0,0:01:13.78,0:01:15.82,Default,,0,0,0,,Жер тұрғындарын ұстау
Dialogue: 0,0:01:15.95,0:01:18.82,Default,,0,0,0,,Біз робот-құл боламыз!
Dialogue: 0,0:01:19.12,0:01:20.78,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:20.91,0:01:21.70,Default,,0,0,0,,Лилулу!
Dialogue: 0,0:01:24.87,0:01:30.63,Default,,0,0,0,,Сіз Жерге бірінші болып барып, Темір адам корпусын басқарасыз.
Dialogue: 0,0:01:30.75,0:01:32.46,Default,,0,0,0,,Сәтсіздік опция емес
Dialogue: 0,0:01:33.59,0:01:36.38,Default,,0,0,0,,Сен сол үшін жаралғансың.
Dialogue: 0,0:01:37.26,0:01:38.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:39.59,0:01:42.39,Default,,0,0,0,,Мехатопия армиясы, барлық сарбаздар
Dialogue: 0,0:01:42.64,0:01:46.35,Default,,0,0,0,,Жерге түсіру операциясы басталады!
Dialogue: 0,0:01:46.48,0:01:48.60,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:52.94,0:01:55.32,Default,,0,0,0,,Ах! Нобита-сан аа...
Dialogue: 0,0:01:59.61,0:02:01.45,Default,,0,0,0,,Бұл жай ғана ойыншық.
Dialogue: 0,0:02:01.57,0:02:04.20,Default,,0,0,0,,Керемет, жарайсыңдар.
Dialogue: 0,0:02:04.54,0:02:07.29,Default,,0,0,0,,Сунеоның немере ағасы мұны бәрібір жасады, солай ма?
Dialogue: 0,0:02:07.41,0:02:09.42,Default,,0,0,0,,Өйткені ол мұндай нәрселерге келгенде данышпан (Сунео) Хэхе~
Dialogue: 0,0:02:09.54,0:02:11.13,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:02:11.25,0:02:13.17,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз қорқып кеткен болуыңыз керек.
Dialogue: 0,0:02:13.29,0:02:15.00,Default,,0,0,0,,Бөлек
Dialogue: 0,0:02:15.13,0:02:16.80,Default,,0,0,0,,Сіз шыншыл емессіз.
Dialogue: 0,0:02:16.92,0:02:18.76,Default,,0,0,0,,Таң қалсам, таң қалдым!
Dialogue: 0,0:02:18.88,0:02:20.84,Default,,0,0,0,,Қызғансаң, қызғандың!
Dialogue: 0,0:02:20.97,0:02:22.39,Default,,0,0,0,,Ашық сөйлеңіз!
Dialogue: 0,0:02:22.76,0:02:24.97,Default,,0,0,0,,Себебі мен сені қызғанбаймын.
Dialogue: 0,0:02:25.10,0:02:27.02,Default,,0,0,0,,Мен өте үлкенмін
Dialogue: 0,0:02:27.14,0:02:30.85,Default,,0,0,0,,Үйге ұқсас робот жасауға болады.
Dialogue: 0,0:02:30.98,0:02:32.52,Default,,0,0,0,,арсыз
Dialogue: 0,0:02:32.65,0:02:34.86,Default,,0,0,0,,Micros шабуыл!
Dialogue: 0,0:02:35.02,0:02:36.48,Default,,0,0,0,,Ой, ауырды, ауырады, ауырады, ауырады
Dialogue: 0,0:02:36.61,0:02:38.78,Default,,0,0,0,,Ол ауырады, ауырады, ауырады
Dialogue: 0,0:02:38.90,0:02:40.16,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:02:40.28,0:02:42.74,Default,,0,0,0,,Ku! Бұл не? Бұл не?
Dialogue: 0,0:02:43.07,0:02:45.16,Default,,0,0,0,,Қызғаншақ кішкентай робот
Dialogue: 0,0:02:45.29,0:02:48.00,Default,,0,0,0,,Жай ғана жаяу! Бұл не зымыран?
Dialogue: 0,0:02:48.12,0:02:49.46,Default,,0,0,0,,Бала!
Dialogue: 0,0:02:49.58,0:02:52.42,Default,,0,0,0,,Мен қызғанамын
Dialogue: 0,0:02:52.58,0:02:54.96,Default,,0,0,0,,Ыстық жерде
Dialogue: 0,0:02:55.09,0:02:57.63,Default,,0,0,0,,Бұл таңқаларлық, бұл үлкен.
Dialogue: 0,0:02:57.76,0:03:01.13,Default,,0,0,0,,Жүріңіз, тіпті зымырандарды ұшырыңыз.
Dialogue: 0,0:03:01.26,0:03:03.89,Default,,0,0,0,,Мен де соны қалаймын
Dialogue: 0,0:03:04.01,0:03:05.76,Default,,0,0,0,,Сізде бұл бар, солай ма?
Dialogue: 0,0:03:05.89,0:03:08.02,Default,,0,0,0,,Қайда? мұнда
Dialogue: 0,0:03:10.06,0:03:16.19,Default,,0,0,0,,Ол үлкен, жүреді және зымырандарды атады.
Dialogue: 0,0:03:20.03,0:03:25.07,Default,,0,0,0,,Мен мұны қаламаймын. Салқынырақ болғаны жақсы.
Dialogue: 0,0:03:25.37,0:03:28.62,Default,,0,0,0,,Ол күштірек көрінеді, аяғы ұзынырақ.
Dialogue: 0,0:03:28.75,0:03:33.58,Default,,0,0,0,,Үлкен ғимарат сияқты болмаса.
Dialogue: 0,0:03:33.71,0:03:38.34,Default,,0,0,0,,Мен оны қалаймын Мен оны қалаймын ...
Dialogue: 0,0:03:38.46,0:03:40.42,Default,,0,0,0,,Шулы!
Dialogue: 0,0:03:41.13,0:03:44.18,Default,,0,0,0,,Мен деген робот тұрғанда қандай сөздерді айтып тұрсың?
Dialogue: 0,0:03:44.30,0:03:48.10,Default,,0,0,0,,Мұндай үлкен робот қанша тұрады деп ойлайсыз?
Dialogue: 0,0:03:48.22,0:03:51.94,Default,,0,0,0,,Бұл ыстық болса да, мен өзімшілмін, Гя Гя Гя Гя
Dialogue: 0,0:03:52.06,0:03:53.44,Default,,0,0,0,,Күн ыстық!
Dialogue: 0,0:03:53.90,0:03:56.77,Default,,0,0,0,,Әй, ыстық! (Нобита) Ооооо...
Dialogue: 0,0:03:58.02,0:03:58.94,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:03:59.07,0:04:00.19,Default,,0,0,0,,Салқындатуға барыңыз
Dialogue: 0,0:04:00.32,0:04:02.78,Default,,0,0,0,,Бізге ондай робот бәрібір керек емес.
Dialogue: 0,0:04:04.32,0:04:08.62,Default,,0,0,0,,Міне... Дораемон
Dialogue: 0,0:04:17.59,0:04:23.59,Default,,0,0,0,,♪〜
Dialogue: 0,0:05:21.48,0:05:27.49,Default,,0,0,0,,〜♪
Dialogue: 0,0:05:30.20,0:05:33.12,Default,,0,0,0,,Мен қатты ашуландым
Dialogue: 0,0:05:33.24,0:05:35.87,Default,,0,0,0,,Мүмкін менде кальций жетіспейтін шығар?
Dialogue: 0,0:05:36.46,0:05:38.54,Default,,0,0,0,,Дораемон... Уф
Dialogue: 0,0:05:38.75,0:05:40.17,Default,,0,0,0,,Суық!
Dialogue: 0,0:05:40.67,0:05:44.51,Default,,0,0,0,,Бұл қай жер? Антарктида? Солтүстік полюс пе?
Dialogue: 0,0:05:47.43,0:05:52.64,Default,,0,0,0,,Дораемон, шық! Бұл өте жаман.
Dialogue: 0,0:05:54.22,0:05:58.81,Default,,0,0,0,,Мен Дораемонмен келісемін Эй!
Dialogue: 0,0:05:58.94,0:06:02.90,Default,,0,0,0,,Ах! Хехе, мен сол жерде болдым.
Dialogue: 0,0:06:03.57,0:06:06.82,Default,,0,0,0,,Дорэмон Микке
Dialogue: 0,0:06:07.20,0:06:10.16,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:06:10.28,0:06:13.87,Default,,0,0,0,,Тұрғындар балық аулау мен егіншілікпен күнкөреді—
Dialogue: 0,0:06:16.70,0:06:17.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:17.91,0:06:19.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:19.21,0:06:21.92,Default,,0,0,0,,Ааа... уау!
Dialogue: 0,0:06:23.09,0:06:25.55,Default,,0,0,0,,Өте…
Dialogue: 0,0:06:25.84,0:06:26.92,Default,,0,0,0,,Не?
Dialogue: 0,0:06:32.55,0:06:34.81,Default,,0,0,0,,(тон)
Dialogue: 0,0:06:35.10,0:06:37.98,Default,,0,0,0,,Ой, бұл не?
Dialogue: 0,0:06:38.10,0:06:39.19,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:06:40.69,0:06:43.06,Default,,0,0,0,,Неліктен мұндай нәрсе аспаннан келеді?
Dialogue: 0,0:06:43.19,0:06:45.98,Default,,0,0,0,,Иә? Уау...
Dialogue: 0,0:06:46.61,0:06:51.61,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:06:54.33,0:06:57.91,Default,,0,0,0,,Құлау Құлау Құлау
Dialogue: 0,0:06:58.04,0:06:59.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:59.29,0:07:01.37,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:07:01.92,0:07:03.33,Default,,0,0,0,,Өте…
Dialogue: 0,0:07:03.67,0:07:06.05,Default,,0,0,0,,Нобита, сен не істеп жатырсың?
Dialogue: 0,0:07:06.38,0:07:09.42,Default,,0,0,0,,Жоқ, уайымдамаңыз.
Dialogue: 0,0:07:10.47,0:07:13.09,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:07:13.22,0:07:15.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:15.89,0:07:18.02,Default,,0,0,0,,Иә? бұрынғыдан
Dialogue: 0,0:07:19.10,0:07:20.98,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:23.23,0:07:24.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.19,0:07:25.19,Default,,0,0,0,,Уау
Dialogue: 0,0:07:25.77,0:07:27.36,Default,,0,0,0,,Ах, уау!
Dialogue: 0,0:07:27.98,0:07:31.11,Default,,0,0,0,,Бұл тағы да осында. Бұрынғыдан басқаша.
Dialogue: 0,0:07:31.49,0:07:32.91,Default,,0,0,0,,Нобита?
Dialogue: 0,0:07:33.03,0:07:35.70,Default,,0,0,0,,Мен Архитектуралық дизайн бөлімінен Отомын; сіз маған қоңырау шалған едіңіз.
Dialogue: 0,0:07:35.83,0:07:38.87,Default,,0,0,0,,Хмм, мүмкін бұл...
Dialogue: 0,0:07:40.54,0:07:43.29,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:07:43.62,0:07:45.50,Default,,0,0,0,,Хмм!
Dialogue: 0,0:07:45.75,0:07:46.88,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:47.00,0:07:51.67,Default,,0,0,0,,Бұл бір жерге сигнал жіберетін және бөлшектерді жинайтын құрылғы.
Dialogue: 0,0:07:52.30,0:07:55.55,Default,,0,0,0,,Дораэмон, не болса да, бұл мен үшін
Dialogue: 0,0:07:55.68,0:07:58.22,Default,,0,0,0,,Ухуху ахаха хехехе
Dialogue: 0,0:07:58.35,0:08:01.02,Default,,0,0,0,,Ио... bash!
Dialogue: 0,0:08:01.52,0:08:03.02,Default,,0,0,0,,Дораемон
Dialogue: 0,0:08:04.52,0:08:05.98,Default,,0,0,0,,Дораемон?
Dialogue: 0,0:08:07.02,0:08:08.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:08.27,0:08:11.28,Default,,0,0,0,,Мен адасып қалдым, ақ аю қуып келеді.
Dialogue: 0,0:08:11.40,0:08:12.86,Default,,0,0,0,,тым кеш
Dialogue: 0,0:08:12.99,0:08:16.37,Default,,0,0,0,,Хакшун! Ах...
Dialogue: 0,0:08:16.49,0:08:18.28,Default,,0,0,0,,Рахмет сізге Дораемон
Dialogue: 0,0:08:18.41,0:08:19.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:19.58,0:08:22.00,Default,,0,0,0,,Мұны саған Дораемон берді, солай ма?
Dialogue: 0,0:08:22.12,0:08:23.08,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:23.46,0:08:26.50,Default,,0,0,0,,О! Бұл не? Оны қайдан алдың?
Dialogue: 0,0:08:26.63,0:08:27.79,Default,,0,0,0,,Бұл Дораемон емес пе?
Dialogue: 0,0:08:28.04,0:08:29.84,Default,,0,0,0,,Мен бұл туралы білмеймін!
Dialogue: 0,0:08:29.96,0:08:32.34,Default,,0,0,0,,Ал, ол кім?
Dialogue: 0,0:08:32.47,0:08:33.47,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:08:33.59,0:08:34.84,Default,,0,0,0,,Уф! иә?
Dialogue: 0,0:08:34.97,0:08:36.18,Default,,0,0,0,,Мен қайтадан келдім
Dialogue: 0,0:08:36.72,0:08:37.85,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:08:38.39,0:08:40.22,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:08:40.35,0:08:42.31,Default,,0,0,0,,Бұл қоңырау.
Dialogue: 0,0:08:42.43,0:08:43.31,Default,,0,0,0,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:08:43.43,0:08:44.98,Default,,0,0,0,,Мен оны Солтүстік полюстен алдым.
Dialogue: 0,0:08:45.10,0:08:46.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:46.44,0:08:48.90,Default,,0,0,0,,Маған көбірек бөліктер жіберілетініне сенімдімін.
Dialogue: 0,0:08:49.02,0:08:51.73,Default,,0,0,0,,Біз үлкен роботтарды жасай аламыз.
Dialogue: 0,0:08:51.86,0:08:53.15,Default,,0,0,0,,Ғажайып таңғажайып
Dialogue: 0,0:08:53.28,0:08:56.66,Default,,0,0,0,,Бірақ оны иесіне қайтарған дұрыс болар деп ойлаймын...
Dialogue: 0,0:08:56.78,0:08:58.03,Default,,0,0,0,,Меншік иесі кім?
Dialogue: 0,0:08:58.16,0:09:00.54,Default,,0,0,0,,Солтүстік полюстегі Аяз ата? Ақ аю?
Dialogue: 0,0:09:00.66,0:09:03.29,Default,,0,0,0,,Хмм, мен оны полиция жәшігіне жеткіземін.
Dialogue: 0,0:09:03.41,0:09:04.75,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:09:04.87,0:09:07.63,Default,,0,0,0,,«Мен Солтүстік полюстен алып робот таптым»?
Dialogue: 0,0:09:07.75,0:09:11.09,Default,,0,0,0,,Бұл менмін, Құдай берді.
Dialogue: 0,0:09:11.21,0:09:13.34,Default,,0,0,0,,Хмм (Нобита) Яда Яда Яда Яда
Dialogue: 0,0:09:13.46,0:09:16.26,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:09:18.30,0:09:19.14,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:09:19.26,0:09:21.93,Default,,0,0,0,,Сосын иесі келгенде, мен оны дұрыстап қайтарамын.
Dialogue: 0,0:09:22.06,0:09:25.02,Default,,0,0,0,,Әзірге оны жинаңыз, жарай ма? эй?
Dialogue: 0,0:09:25.14,0:09:29.40,Default,,0,0,0,,Хм, мен оны жинасам, жақсы.
Dialogue: 0,0:09:29.52,0:09:30.48,Default,,0,0,0,,Иә! Эххе
Dialogue: 0,0:09:30.82,0:09:32.90,Default,,0,0,0,,Бірақ оны қайда жинауым керек?
Dialogue: 0,0:09:33.03,0:09:34.53,Default,,0,0,0,,Бақшада жақсы.
Dialogue: 0,0:09:34.65,0:09:38.11,Default,,0,0,0,,Анам кір жуа алмағандықтан ашуланады.
Dialogue: 0,0:09:38.24,0:09:41.24,Default,,0,0,0,,Кір жуудың қажеті болмаса екен.
Dialogue: 0,0:09:41.37,0:09:45.12,Default,,0,0,0,,Ол тым үлкен, сондықтан кішкентай шаммен оны кішірейте алмайсыз...
Dialogue: 0,0:09:45.25,0:09:47.58,Default,,0,0,0,,Жоқ! Бұл жақсы, өйткені ол үлкен
Dialogue: 0,0:09:47.71,0:09:50.63,Default,,0,0,0,,Ах, бірақ ол аяқталған болса да,
Dialogue: 0,0:09:50.75,0:09:54.67,Default,,0,0,0,,Осындай нәрсе қаланы аралайтын болса, бұл маңайдағыларға кедергі болар еді.
Dialogue: 0,0:09:54.80,0:09:57.43,Default,,0,0,0,,Түрлі оғаш сөздерді айту
Dialogue: 0,0:09:57.76,0:09:59.55,Default,,0,0,0,,Аа, дұрыс!
Dialogue: 0,0:09:59.68,0:10:02.43,Default,,0,0,0,,Баяғыда мен айна ішіндегі әлемге бардым.
Dialogue: 0,0:10:02.56,0:10:06.56,Default,,0,0,0,,Адамдары жоқ қала, дәл осы дүние сияқты
Dialogue: 0,0:10:06.68,0:10:08.56,Default,,0,0,0,,Енетін айнаны пайдалану?
Dialogue: 0,0:10:08.69,0:10:09.60,Default,,0,0,0,,Оден дайын!
Dialogue: 0,0:10:09.73,0:10:13.65,Default,,0,0,0,,Ол жерде не істесең де ешкімнің мазасын алмайды.
Dialogue: 0,0:10:14.15,0:10:16.90,Default,,0,0,0,,Бірақ бұл өте үлкен...
Dialogue: 0,0:10:17.03,0:10:18.03,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:18.15,0:10:20.11,Default,,0,0,0,,Айнадан өте алмайды
Dialogue: 0,0:10:20.24,0:10:22.83,Default,,0,0,0,,Хаа... Бәрібір жақсы.
Dialogue: 0,0:10:22.95,0:10:26.62,Default,,0,0,0,,Мен үшін алып роботты қалағаным қате болды.
Dialogue: 0,0:10:26.75,0:10:30.12,Default,,0,0,0,,Амал жоқ, хехехе
Dialogue: 0,0:10:31.08,0:10:34.09,Default,,0,0,0,,Мұнайдың кері әлемге енуі
Dialogue: 0,0:10:34.46,0:10:35.59,Default,,0,0,0,,Айна болмаса да
Dialogue: 0,0:10:35.71,0:10:38.34,Default,,0,0,0,,Егер сіз мұны айна сияқты шағылысатын тегіс бетке боясаңыз
Dialogue: 0,0:10:38.47,0:10:40.89,Default,,0,0,0,,Сіз бұл әлемге кіре аласыз.
Dialogue: 0,0:10:41.01,0:10:43.55,Default,,0,0,0,,Иә! Тез кеттік Қазір кеттік Тез кеттік
Dialogue: 0,0:10:43.68,0:10:47.18,Default,,0,0,0,,Бірақ бұл жерден өтетін тегіс бет жоқ...
Dialogue: 0,0:10:47.31,0:10:48.85,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:49.52,0:10:51.69,Default,,0,0,0,,Сәлем! (Нобита) Иә?
Dialogue: 0,0:10:53.40,0:10:55.69,Default,,0,0,0,,Озашики балық аулау
Dialogue: 0,0:10:55.98,0:10:59.40,Default,,0,0,0,,Өйткені, Дораэмон сенімді.
Dialogue: 0,0:11:01.57,0:11:03.95,Default,,0,0,0,,Егер сіз осы су бетіне май тамызсаңыз,
Dialogue: 0,0:11:04.49,0:11:05.79,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:11:12.79,0:11:15.71,Default,,0,0,0,,Ой, айнаға айналды.
Dialogue: 0,0:11:16.13,0:11:17.88,Default,,0,0,0,,Хун жақсы
Dialogue: 0,0:11:18.21,0:11:19.34,Default,,0,0,0,,Уф
Dialogue: 0,0:11:19.55,0:11:20.67,Default,,0,0,0,,Өл! Мен сенің төменгі ерініңді тіліп өтемін!
Dialogue: 0,0:11:25.01,0:11:29.56,Default,,0,0,0,,(Нобитаның күлкісі)
Dialogue: 0,0:11:31.14,0:11:33.85,Default,,0,0,0,,Бұл айна әлем!
Dialogue: 0,0:11:37.07,0:11:39.32,Default,,0,0,0,,Каругару қолғаптары
Dialogue: 0,0:11:40.49,0:11:42.45,Default,,0,0,0,,Иә, о!
Dialogue: 0,0:11:42.57,0:11:46.08,Default,,0,0,0,,Жарық Жарық Мен оны өзім көтере аламын
Dialogue: 0,0:11:46.20,0:11:48.95,Default,,0,0,0,,Мұны істемеңіз, өйткені сіз оны барлық жерден ұрасыз.
Dialogue: 0,0:11:50.04,0:11:51.58,Default,,0,0,0,,(Нобитаның күлкісі)
Dialogue: 0,0:11:51.71,0:11:53.62,Default,,0,0,0,,Иә, жарай ма? (Теру дыбысы)
Dialogue: 0,0:11:53.75,0:11:54.96,Default,,0,0,0,,Иә
Dialogue: 0,0:11:55.08,0:11:56.50,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:56.63,0:11:58.63,Default,,0,0,0,,Субару-кун?
Dialogue: 0,0:12:00.21,0:12:02.05,Default,,0,0,0,,Ой
Dialogue: 0,0:12:02.17,0:12:05.01,Default,,0,0,0,,Дораемон, төбе төмен.
Dialogue: 0,0:12:05.14,0:12:07.85,Default,,0,0,0,,Тек айналаңыз.
Dialogue: 0,0:12:08.72,0:12:10.10,Default,,0,0,0,,Хаха иә иә
Dialogue: 0,0:12:10.22,0:12:11.98,Default,,0,0,0,,Уау... ау
Dialogue: 0,0:12:12.81,0:12:15.56,Default,,0,0,0,,Сәл күте тұрыңыз, мен терезені алып тастаймын.
Dialogue: 0,0:12:15.69,0:12:17.40,Default,,0,0,0,,Уау
Dialogue: 0,0:12:20.36,0:12:23.32,Default,,0,0,0,,Уау, бәрі төңкеріліп тұр.
Dialogue: 0,0:12:23.70,0:12:26.03,Default,,0,0,0,,Өйткені дүние айнада бейнеленген.
Dialogue: 0,0:12:26.16,0:12:29.03,Default,,0,0,0,,Жарайды, бұл үлкен мәселе емес, бұл туралы алаңдамаңыз.
Dialogue: 0,0:12:29.16,0:12:30.08,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:30.20,0:12:32.66,Default,,0,0,0,,Аа, алтын балық жоқ.
Dialogue: 0,0:12:33.00,0:12:36.21,Default,,0,0,0,,Айна әлемі тек пейзаж әлемі.
Dialogue: 0,0:12:36.33,0:12:40.13,Default,,0,0,0,,Бізден басқа адам, жануар, ештеңе жоқ.
Dialogue: 0,0:12:40.25,0:12:41.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:41.88,0:12:44.59,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:45.34,0:12:48.97,Default,,0,0,0,,Уау! Осындай үлкен жерде біз ғанамыз ба?
Dialogue: 0,0:12:49.10,0:12:52.85,Default,,0,0,0,,Иә, сіз бәрін өз қалауыңыз бойынша пайдалана аласыз.
Dialogue: 0,0:12:53.35,0:12:55.10,Default,,0,0,0,,Ол қанша қашықтыққа барады?
Dialogue: 0,0:12:55.23,0:12:56.27,Default,,0,0,0,,Ал дегенмен!
Dialogue: 0,0:12:56.40,0:13:01.07,Default,,0,0,0,,Ол нақты әлем сияқты болып қала береді.
Dialogue: 0,0:13:01.19,0:13:04.86,Default,,0,0,0,,Хахаха Жарайды, тез бітірейік.
Dialogue: 0,0:13:05.11,0:13:07.53,Default,,0,0,0,,Пуха!
Dialogue: 0,0:13:07.91,0:13:09.99,Default,,0,0,0,,Ах, жаңасы келе жатыр!
Dialogue: 0,0:13:10.12,0:13:11.66,Default,,0,0,0,,Ахх... (Нобита) Бұл қауіпті!
Dialogue: 0,0:13:12.16,0:13:13.91,Default,,0,0,0,,Ху... (Нобита) Бұл қол.
Dialogue: 0,0:13:14.04,0:13:16.46,Default,,0,0,0,,Хаха Көбірек көтеріп жүрейік
Dialogue: 0,0:13:17.08,0:13:22.05,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:13:27.43,0:13:29.51,Default,,0,0,0,,Хаа... Уау... Аа...
Dialogue: 0,0:13:29.64,0:13:32.52,Default,,0,0,0,,Не? Біраз уақыттан бері кім айтты?
Dialogue: 0,0:13:32.64,0:13:34.89,Default,,0,0,0,,Бұл жер сілкінісі болды ма? Сәлем, аа
Dialogue: 0,0:13:35.02,0:13:36.89,Default,,0,0,0,,Қайта толтырыңыз!
Dialogue: 0,0:13:39.44,0:13:41.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:41.82,0:13:43.73,Default,,0,0,0,,Мұнда бәрі бар сияқты.
Dialogue: 0,0:13:43.86,0:13:46.07,Default,,0,0,0,,Жарайды, барлығын бірден жинайық.
Dialogue: 0,0:13:46.20,0:13:47.07,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:47.15,0:13:53.20,Default,,0,0,0,,♪〜
Dialogue: 0,0:14:32.53,0:14:38.54,Default,,0,0,0,,〜♪
Dialogue: 0,0:14:38.83,0:14:40.46,Default,,0,0,0,,Коннектордың ауысуын болдырмаңыз
Dialogue: 0,0:14:40.58,0:14:42.71,Default,,0,0,0,,Ах, сәл артық оңға Қарама-қарсы
Dialogue: 0,0:14:43.34,0:14:45.00,Default,,0,0,0,,Бұл қол күшті көрінеді.
Dialogue: 0,0:14:45.13,0:14:47.42,Default,,0,0,0,,Сіз қанша тонна жүк көтере аласыз?
Dialogue: 0,0:14:47.88,0:14:50.93,Default,,0,0,0,,Ууууу, бітті хахаха
Dialogue: 0,0:14:51.26,0:14:54.47,Default,,0,0,0,,Менің ойымша, бұл компьютер кеңістігі...
Dialogue: 0,0:14:54.60,0:14:56.85,Default,,0,0,0,,Не? Мұндай бөліктер енді жоқ.
Dialogue: 0,0:14:57.14,0:14:58.60,Default,,0,0,0,,Бұл жұмыс істемейді
Dialogue: 0,0:14:58.73,0:15:01.02,Default,,0,0,0,,Осы уақытқа дейін жетсем де
Dialogue: 0,0:15:01.15,0:15:04.44,Default,,0,0,0,,Хмм, жарайды, мен оны сатып аламын.
Dialogue: 0,0:15:04.57,0:15:06.90,Default,,0,0,0,,Болашақ әмбебап дүкенде мәміле бар.
Dialogue: 0,0:15:07.03,0:15:08.57,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:15:10.45,0:15:12.11,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:15:12.24,0:15:14.49,Default,,0,0,0,,О, бұл керемет! Хехе
Dialogue: 0,0:15:17.75,0:15:18.95,Default,,0,0,0,,Уау
Dialogue: 0,0:15:19.41,0:15:22.08,Default,,0,0,0,,Керемет, мен кіре аламын, хехехе
Dialogue: 0,0:15:22.88,0:15:25.42,Default,,0,0,0,,Ууууу хахахаха
Dialogue: 0,0:15:25.54,0:15:29.38,Default,,0,0,0,,Мен мұндайды тек фильмдерден көрдім. Бұл шынайы!
Dialogue: 0,0:15:30.34,0:15:32.09,Default,,0,0,0,,А, ол жабылады, солай ма?
Dialogue: 0,0:15:32.22,0:15:33.64,Default,,0,0,0,,Ол жабық.
Dialogue: 0,0:15:33.76,0:15:35.10,Default,,0,0,0,,Уау
Dialogue: 0,0:15:39.02,0:15:43.19,Default,,0,0,0,,Уау Ахаха
Dialogue: 0,0:15:45.31,0:15:48.86,Default,,0,0,0,,(Нобитаның күлкісі)
Dialogue: 0,0:15:48.98,0:15:51.11,Default,,0,0,0,,Ей, оны жылжытайық.
Dialogue: 0,0:15:51.24,0:15:53.53,Default,,0,0,0,,Не, сіз оны жылжыттым дедіңіз бе?
Dialogue: 0,0:15:54.49,0:15:57.49,Default,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:15:57.83,0:15:59.50,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз
Dialogue: 0,0:15:59.62,0:16:01.21,Default,,0,0,0,,Бұл өте жауапсыздық.
Dialogue: 0,0:16:01.33,0:16:03.83,Default,,0,0,0,,Сіздің миыңыз мұны істей алмайтын шығар.
Dialogue: 0,0:16:03.96,0:16:05.83,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:07.17,0:16:10.92,Default,,0,0,0,,Жарайды, мен мұны өз қалауымша жасаймын.
Dialogue: 0,0:16:14.34,0:16:16.85,Default,,0,0,0,,Ой, көшті, көшті.
Dialogue: 0,0:16:23.60,0:16:24.77,Default,,0,0,0,,О! Хаха
Dialogue: 0,0:16:24.90,0:16:26.19,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:16:28.07,0:16:28.90,Default,,0,0,0,,О?
Dialogue: 0,0:16:29.61,0:16:30.86,Default,,0,0,0,,Иә, иә. Не болды? Сабыр, сабыр.
Dialogue: 0,0:16:31.36,0:16:33.49,Default,,0,0,0,,Ой және...
Dialogue: 0,0:16:33.61,0:16:35.66,Default,,0,0,0,,Ооооо
Dialogue: 0,0:16:36.45,0:16:39.03,Default,,0,0,0,,Я... Жарайды, Пуппу
Dialogue: 0,0:16:39.79,0:16:41.41,Default,,0,0,0,,Йоккорашио
Dialogue: 0,0:16:42.75,0:16:46.71,Default,,0,0,0,,Жақсы, алға! Хахаха хахаха
Dialogue: 0,0:16:47.96,0:16:53.51,Default,,0,0,0,,Керемет. Менің бақылауымда жүру хахаха
Dialogue: 0,0:16:54.43,0:16:57.14,Default,,0,0,0,,Мүмкін мен данышпан шығармын?
Dialogue: 0,0:16:57.26,0:16:58.55,Default,,0,0,0,,Пупупу (Нобита) Иә?
Dialogue: 0,0:16:58.68,0:17:02.60,Default,,0,0,0,,Кешіріңіз, мен жүгіріп жүргенім осы болды.
Dialogue: 0,0:17:02.89,0:17:06.06,Default,,0,0,0,,Мен болашақ әмбебап дүкеннен сатып алған Psy-контроллер.
Dialogue: 0,0:17:06.48,0:17:08.90,Default,,0,0,0,,Бұл компьютер ми толқынымен басқарылады.
Dialogue: 0,0:17:09.02,0:17:12.44,Default,,0,0,0,,Сіз роботты ойыңызда қалағаныңызша қозғалта аласыз.
Dialogue: 0,0:17:12.57,0:17:16.57,Default,,0,0,0,,Е! Сонымен, бұрын болған оқиғаның бәрі Дораемонға қатысты болды ма?
Dialogue: 0,0:17:16.70,0:17:17.53,Default,,0,0,0,,Гүлп
Dialogue: 0,0:17:18.45,0:17:20.24,Default,,0,0,0,,Көңіліңіз қалмасын.
Dialogue: 0,0:17:20.37,0:17:23.58,Default,,0,0,0,,Тіпті сіз оны бірден басқаруға болады.
Dialogue: 0,0:17:24.58,0:17:26.33,Default,,0,0,0,,(велосипед қоңырауы)
Dialogue: 0,0:17:27.33,0:17:28.75,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,0:17:29.00,0:17:30.42,Default,,0,0,0,,Не? робот?
Dialogue: 0,0:17:31.09,0:17:33.55,Default,,0,0,0,,Мен қазір бассейнге баруды ойладым.
Dialogue: 0,0:17:33.67,0:17:35.42,Default,,0,0,0,,Бассейннен де жақсырақ
Dialogue: 0,0:17:35.55,0:17:37.05,Default,,0,0,0,,Мен сені өзіммен бірге алып кетемін.
Dialogue: 0,0:17:37.47,0:17:38.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.80,0:17:45.81,Default,,0,0,0,,♪〜
Dialogue: 0,0:17:50.94,0:17:52.27,Default,,0,0,0,,Уау
Dialogue: 0,0:17:52.40,0:17:54.32,Default,,0,0,0,,Айна сияқты
Dialogue: 0,0:17:56.28,0:17:58.36,Default,,0,0,0,,Мұнда жүзейік! (Шидзука/Нобита) Иә!
Dialogue: 0,0:18:31.48,0:18:37.49,Default,,0,0,0,,〜♪
Dialogue: 0,0:18:37.69,0:18:40.70,Default,,0,0,0,,Ухуху үлкен теңіз құмырасына ұқсайды
Dialogue: 0,0:18:40.82,0:18:43.16,Default,,0,0,0,,Егер робот суда қалқып жүрсе ше?
Dialogue: 0,0:18:43.53,0:18:45.74,Default,,0,0,0,,Дораэмон робот емес пе?
Dialogue: 0,0:18:45.87,0:18:48.04,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:18:48.16,0:18:52.38,Default,,0,0,0,,Мен бұрын көрмеген қорытпадан жасалған, ол қайдан пайда болды?
Dialogue: 0,0:18:52.96,0:18:54.46,Default,,0,0,0,,Біртүрлі екен, солай емес пе?
Dialogue: 0,0:18:54.59,0:18:58.05,Default,,0,0,0,,Одан да, мен әлі ат қойған жоқпын.
Dialogue: 0,0:18:58.63,0:19:00.76,Default,,0,0,0,,Керемет атау бар ма?
Dialogue: 0,0:19:00.88,0:19:01.97,Default,,0,0,0,,Теңіз құмырасы ше?
Dialogue: 0,0:19:02.09,0:19:03.80,Default,,0,0,0,,Оттер-чан сәл...
Dialogue: 0,0:19:03.93,0:19:06.81,Default,,0,0,0,,Zanda Cross туралы не деуге болады?
Dialogue: 0,0:19:07.10,0:19:07.98,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:19:08.10,0:19:11.31,Default,,0,0,0,,Бұл Аяз ата туралы пьеса, өйткені ол Солтүстік полюсте дүниеге келген.
Dialogue: 0,0:19:11.65,0:19:15.15,Default,,0,0,0,,Жарайды, бүгіннен бастап бұл Занда Кросс.
Dialogue: 0,0:19:21.32,0:19:22.91,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:19:28.04,0:19:31.08,Default,,0,0,0,,(тон)
Dialogue: 0,0:19:32.25,0:19:33.42,Default,,0,0,0,,Юд
Dialogue: 0,0:19:34.75,0:19:37.05,Default,,0,0,0,,Қайдасың, дзюдо?
Dialogue: 0,0:19:37.38,0:19:39.42,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:19:39.59,0:19:41.09,Default,,0,0,0,,Лилулу…
Dialogue: 0,0:19:41.68,0:19:42.51,Default,,0,0,0,,Юд
Dialogue: 0,0:19:42.63,0:19:44.68,Default,,0,0,0,,Нобита...
Dialogue: 0,0:19:44.80,0:19:48.02,Default,,0,0,0,,«Новита» Бұл не? Яһуда
Dialogue: 0,0:19:48.14,0:19:49.06,Default,,0,0,0,,Га
Dialogue: 0,0:19:52.02,0:19:53.23,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:19:53.35,0:19:54.10,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:54.35,0:19:56.94,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:20:05.74,0:20:09.20,Default,,0,0,0,,№1 Нобита Ноби осында!
Dialogue: 0,0:20:23.01,0:20:25.09,Default,,0,0,0,,Уау! Уау керемет таңқаларлық
Dialogue: 0,0:20:25.22,0:20:27.47,Default,,0,0,0,,Олимпиадалық спортшы болғандай.
Dialogue: 0,0:20:27.60,0:20:28.85,Default,,0,0,0,,Бірақ бұл біртүрлі.
Dialogue: 0,0:20:28.97,0:20:30.64,Default,,0,0,0,,Қанша ұшып жүрсең де
Dialogue: 0,0:20:30.93,0:20:35.27,Default,,0,0,0,,Неліктен басымыз айналып кетпей, орнымыздан құлап кетпейміз?
Dialogue: 0,0:20:35.40,0:20:37.48,Default,,0,0,0,,Робот қай бағытта жүрсе де
Dialogue: 0,0:20:37.61,0:20:41.19,Default,,0,0,0,,Ішкі тартылыс өрісі әрқашан бір бағытта болады.
Dialogue: 0,0:20:41.32,0:20:43.11,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:20:43.32,0:20:46.82,Default,,0,0,0,,Хмм, Жердің қазіргі ғылыми күшімен бұл мүмкін емес.
Dialogue: 0,0:20:47.12,0:20:48.58,Default,,0,0,0,,Жерде бұл мүмкін емес пе?
Dialogue: 0,0:20:48.70,0:20:50.66,Default,,0,0,0,,Сонда бұл робот...
Dialogue: 0,0:20:50.79,0:20:53.83,Default,,0,0,0,,Ей, бұл соншалықты күрделі тақырып емес.
Dialogue: 0,0:20:53.96,0:20:55.83,Default,,0,0,0,,Шизука-чан, оны сынап көргіңіз келе ме?
Dialogue: 0,0:20:55.96,0:20:58.38,Default,,0,0,0,,Мен? Мен мұны істей аламын ба?
Dialogue: 0,0:20:58.50,0:20:59.80,Default,,0,0,0,,Оңай оңай
Dialogue: 0,0:21:00.50,0:21:04.88,Default,,0,0,0,,Мұны ұстап тұрып, «жүгір» немесе «тоқта» деп ойласаңыз болғаны.
Dialogue: 0,0:21:05.01,0:21:06.13,Default,,0,0,0,,Фуфу
Dialogue: 0,0:21:15.64,0:21:17.27,Default,,0,0,0,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:21:17.40,0:21:18.31,Default,,0,0,0,,Балет
Dialogue: 0,0:21:18.44,0:21:21.40,Default,,0,0,0,,Балет… Балет.
Dialogue: 0,0:21:22.53,0:21:24.82,Default,,0,0,0,,Аха ахах...
Dialogue: 0,0:21:24.95,0:21:26.57,Default,,0,0,0,,Эй, бұл не түйме?
Dialogue: 0,0:21:26.70,0:21:29.16,Default,,0,0,0,,А, бұл маңызды емес, хмм.
Dialogue: 0,0:21:32.95,0:21:35.21,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:22:23.92,0:22:26.51,Default,,0,0,0,,Сол зәулім ғимарат...
Dialogue: 0,0:22:26.63,0:22:28.88,Default,,0,0,0,,Әп-сәтте жарылып кетті...
Dialogue: 0,0:22:29.26,0:22:31.97,Default,,0,0,0,,Уау! мен білмедім
Dialogue: 0,0:22:32.10,0:22:33.89,Default,,0,0,0,,Мен мұның болғанына сене алар емеспін...
Dialogue: 0,0:22:34.01,0:22:36.64,Default,,0,0,0,,Бұл Шизуканың кінәсі емес.
Dialogue: 0,0:22:37.06,0:22:39.06,Default,,0,0,0,,А... бұл робот
Dialogue: 0,0:22:39.19,0:22:41.94,Default,,0,0,0,,Бұл керемет жойқын қару болды.
Dialogue: 0,0:22:42.06,0:22:44.90,Default,,0,0,0,,Бұл бос ғимарат болғанына қуаныштымын.
Dialogue: 0,0:22:45.03,0:22:48.07,Default,,0,0,0,,Нағыз қалада мұндай нәрсе жабайы болса...
Dialogue: 0,0:22:48.20,0:22:51.32,Default,,0,0,0,,Тоқта! Қорқынышты нәрселерді айтпаңыз
Dialogue: 0,0:22:51.78,0:22:54.33,Default,,0,0,0,,Менде жағымсыз сезім бар.
Dialogue: 0,0:22:54.45,0:22:57.41,Default,,0,0,0,,Xandacross және осы айна әлемі туралы
Dialogue: 0,0:22:57.54,0:23:02.38,Default,,0,0,0,,Оны үшеуміздің арамызда құпия сақта, енді бұл дүниеге келме.
Dialogue: 0,0:23:02.50,0:23:04.50,Default,,0,0,0,,Содан кейін, Zanda Cross...
Dialogue: 0,0:23:06.30,0:23:08.26,Default,,0,0,0,,Оны қазірдің өзінде ұмытыңыз
Dialogue: 0,0:23:13.39,0:23:15.14,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:23:18.23,0:23:19.52,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:23:19.77,0:23:24.27,Default,,0,0,0,,Барлық бөліктер «мидың» басшылығымен Солтүстік полюске жіберілген болуы керек еді.
Dialogue: 0,0:23:24.40,0:23:27.32,Default,,0,0,0,,Бір фрагмент табылмады
Dialogue: 0,0:23:28.19,0:23:31.40,Default,,0,0,0,,Мен осы уақытқа дейін «мидан» келген байланыстарға сүйеніп келдім.
Dialogue: 0,0:23:31.53,0:23:33.24,Default,,0,0,0,,Тоқтатылған
Dialogue: 0,0:23:33.53,0:23:36.54,Default,,0,0,0,,Мен осы жерде біраз уақыт іздеймін.
Dialogue: 0,0:23:41.83,0:23:43.54,Default,,0,0,0,,Тұратын садақ
Dialogue: 0,0:23:43.67,0:23:44.92,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:23:45.04,0:23:46.67,Default,,0,0,0,,Сонымен қатар актриса Эми де келеді. Ә? Шынымен бе!?
Dialogue: 0,0:23:47.05,0:23:48.51,Default,,0,0,0,,Ноби қалуы керек.
Dialogue: 0,0:23:48.84,0:23:52.22,Default,,0,0,0,,А? Неліктен неге?
Dialogue: 0,0:23:52.34,0:23:54.97,Default,,0,0,0,,«Неге»?
Dialogue: 0,0:23:55.10,0:23:58.97,Default,,0,0,0,,Мен кешігіп қалдым, үй тапсырмасын ұмытамын, ұйықтаймын
Dialogue: 0,0:23:59.10,0:24:01.56,Default,,0,0,0,,Басыңызды сәл салқындатыңыз!
Dialogue: 0,0:24:03.44,0:24:07.32,Default,,0,0,0,,Мен Зандакроссты жоғалтқаннан кейін өзімді мұғалімге айта алмаймын.
Dialogue: 0,0:24:07.44,0:24:09.07,Default,,0,0,0,,Сіз түсінуге мүмкіндік жоқ.
Dialogue: 0,0:24:09.44,0:24:10.90,Default,,0,0,0,,Бұл Масаки Фукуяма.
Dialogue: 0,0:24:11.03,0:24:13.57,Default,,0,0,0,,«Сакурамочи» тыңдаңыз
Dialogue: 0,0:24:16.03,0:24:20.08,Default,,0,0,0,,Оны мұндай кішкентай үйде жасыру мүмкін емес.
Dialogue: 0,0:24:20.75,0:24:23.29,Default,,0,0,0,,Өкініштісі, кішкентай үй болды.
Dialogue: 0,0:24:23.58,0:24:25.79,Default,,0,0,0,,Сәлеметсіз бе, аға?
Dialogue: 0,0:24:25.92,0:24:27.17,Default,,0,0,0,,Болашақ әмбебап дүкенінен
Dialogue: 0,0:24:27.29,0:24:30.51,Default,,0,0,0,,Биылғы өнімнің каталогы келді, оны сол жерге жібергіңіз келе ме?
Dialogue: 0,0:24:30.71,0:24:32.67,Default,,0,0,0,,Жоқ, оны сол жерде қалдырыңыз.
Dialogue: 0,0:24:33.30,0:24:35.47,Default,,0,0,0,,Біздің үй кішкентай.
Dialogue: 0,0:24:35.59,0:24:37.68,Default,,0,0,0,,Жаман болды, кішкентай болды.
Dialogue: 0,0:24:48.36,0:24:49.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:56.91,0:24:58.78,Default,,0,0,0,,Әдемі адам
Dialogue: 0,0:25:02.70,0:25:06.71,Default,,0,0,0,,Сенпай, тоқта!
Dialogue: 0,0:25:08.63,0:25:09.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:12.42,0:25:14.88,Default,,0,0,0,,Иә? Ол кім болуы мүмкін?
Dialogue: 0,0:25:15.51,0:25:17.55,Default,,0,0,0,,Ноби-кун! (Нобита) Иә.
Dialogue: 0,0:25:17.68,0:25:19.22,Default,,0,0,0,,Сіз диктант айта алдыңыз ба?
Dialogue: 0,0:25:19.55,0:25:24.14,Default,,0,0,0,,Иә, мен мұны істей алдым (мұғалім).
Dialogue: 0,0:25:26.14,0:25:28.69,Default,,0,0,0,,Иә? Ол енді жоқ
Dialogue: 0,0:25:29.02,0:25:33.61,Default,,0,0,0,,Жарайды, мұқият ойлан, үйге бара аласың.
Dialogue: 0,0:25:33.94,0:25:36.78,Default,,0,0,0,,Иә Қош бол!
Dialogue: 0,0:25:36.91,0:25:38.62,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:25:39.03,0:25:40.45,Default,,0,0,0,,(Нобитаның күрсінуі)
Dialogue: 0,0:25:47.92,0:25:51.80,Default,,0,0,0,,Хаа... менің Занда Крестім
Dialogue: 0,0:25:51.92,0:25:52.75,Default,,0,0,0,,Уау...
Dialogue: 0,0:25:53.63,0:25:55.47,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:25:56.42,0:25:57.26,Default,,0,0,0,,Коллек!
Dialogue: 0,0:25:57.68,0:25:59.68,Default,,0,0,0,,Бұл Сунеоның роботы, солай ма?
Dialogue: 0,0:25:59.80,0:26:00.64,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:26:02.89,0:26:04.39,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:26:07.27,0:26:11.27,Default,,0,0,0,,Ха ха ха ха... Қайда бардың?
Dialogue: 0,0:26:11.40,0:26:12.57,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:26:12.69,0:26:15.28,Default,,0,0,0,,Ах! Сен кешіктің Нобита
Dialogue: 0,0:26:15.40,0:26:16.53,Default,,0,0,0,,тым кеш
Dialogue: 0,0:26:16.82,0:26:19.49,Default,,0,0,0,,Корра, маған мектеп сөмкемді қайтар! мм...
Dialogue: 0,0:26:22.08,0:26:23.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:24.33,0:26:25.95,Default,,0,0,0,,Бұлбұлбұл
Dialogue: 0,0:26:26.58,0:26:27.83,Default,,0,0,0,,Сәлем Нобита!
Dialogue: 0,0:26:27.96,0:26:29.71,Default,,0,0,0,,Үйдегідей робот?
Dialogue: 0,0:26:29.83,0:26:30.88,Default,,0,0,0,,Сіз орындадыңыз ба?
Dialogue: 0,0:26:31.00,0:26:33.80,Default,,0,0,0,,Иә, робот? Не айтқың келеді?
Dialogue: 0,0:26:33.92,0:26:34.88,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,0:26:35.01,0:26:37.47,Default,,0,0,0,,Жетемін дедің, ұмытқан жоқпын.
Dialogue: 0,0:26:37.80,0:26:41.34,Default,,0,0,0,,А, бұл... өтірік.
Dialogue: 0,0:26:41.85,0:26:44.06,Default,,0,0,0,,Бұл өтірік пе?
Dialogue: 0,0:26:44.18,0:26:45.39,Default,,0,0,0,,Сунео, істе (Нобита), жібер, жібер!
Dialogue: 0,0:26:45.52,0:26:46.85,Default,,0,0,0,,Микро соққы!
Dialogue: 0,0:26:47.06,0:26:48.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:48.77,0:26:51.02,Default,,0,0,0,,Сунео! (Сунео) Нобита кінәлі!
Dialogue: 0,0:26:51.44,0:26:52.90,Default,,0,0,0,,Нобитаны күтіңіз!
Dialogue: 0,0:26:53.02,0:26:54.19,Default,,0,0,0,,Новита?
Dialogue: 0,0:26:54.73,0:26:57.74,Default,,0,0,0,,Уф! (Нобита) Жібер, жібер!
Dialogue: 0,0:26:57.86,0:26:59.45,Default,,0,0,0,,Сіз... (3 адам) Иә?
Dialogue: 0,0:27:02.41,0:27:04.78,Default,,0,0,0,,Сіз Новитасыз ба?
Dialogue: 0,0:27:07.75,0:27:11.29,Default,,0,0,0,,Иә, мен Нобитамын.
Dialogue: 0,0:27:11.42,0:27:12.67,Default,,0,0,0,,Мен Лилурумын
Dialogue: 0,0:27:12.79,0:27:15.21,Default,,0,0,0,,Лилулу? шетелдік?
Dialogue: 0,0:27:15.34,0:27:18.13,Default,,0,0,0,,Гайкокуджин... Бұл не?
Dialogue: 0,0:27:18.26,0:27:20.51,Default,,0,0,0,,Жапон тілін жақсы түсінбейтін шығарсыз?
Dialogue: 0,0:27:20.80,0:27:23.01,Default,,0,0,0,,Енді сенің үйіңе барайық.
Dialogue: 0,0:27:23.14,0:27:25.26,Default,,0,0,0,,Не? Менің арамызда?
Dialogue: 0,0:27:25.39,0:27:27.81,Default,,0,0,0,,Жоқ, мен қарсы емеспін.
Dialogue: 0,0:27:27.93,0:27:28.77,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:27:28.89,0:27:31.94,Default,,0,0,0,,Не...Кора (Сунео) Өзімшіл ештеңе істеме.
Dialogue: 0,0:27:32.06,0:27:34.61,Default,,0,0,0,,Нобитаның бізге қатысы бар.
Dialogue: 0,0:27:34.73,0:27:35.57,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:27:35.69,0:27:37.32,Default,,0,0,0,,Еленбейді!
Dialogue: 0,0:27:37.44,0:27:38.69,Default,,0,0,0,,Miklos Go!
Dialogue: 0,0:27:43.78,0:27:44.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:45.03,0:27:46.83,Default,,0,0,0,,О, ой, ой? Не, не, не?
Dialogue: 0,0:27:46.95,0:27:49.20,Default,,0,0,0,,(Екі адам айғайлайды)
Dialogue: 0,0:27:49.62,0:27:51.08,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:27:53.21,0:27:55.84,Default,,0,0,0,,Бұл ескі және лас, бірақ оған шыдаңыз.
Dialogue: 0,0:27:55.96,0:27:59.05,Default,,0,0,0,,Бұл жаман, ескі және кір болды.
Dialogue: 0,0:27:59.42,0:28:01.38,Default,,0,0,0,,Жоғарыдағы бөлмеде күтіңіз.
Dialogue: 0,0:28:02.01,0:28:05.35,Default,,0,0,0,,Бұдан жақсы торт жоқ па? Қауын немесе бір нәрсе
Dialogue: 0,0:28:05.47,0:28:08.35,Default,,0,0,0,,Бұл маған сәйкес келеді.
Dialogue: 0,0:28:10.35,0:28:12.35,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:28:13.10,0:28:15.15,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:28:15.27,0:28:16.40,Default,,0,0,0,,Робот қайда?
Dialogue: 0,0:28:16.52,0:28:18.78,Default,,0,0,0,,B роботы? Не айтқың келеді?
Dialogue: 0,0:28:19.03,0:28:21.03,Default,,0,0,0,,Сіз Нобита-сансыз ба?
Dialogue: 0,0:28:21.15,0:28:22.36,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:28:22.49,0:28:24.61,Default,,0,0,0,,Сіз роботтың қайда екенін білесіз бе?
Dialogue: 0,0:28:24.74,0:28:28.16,Default,,0,0,0,,Неге олай дейсің? Мен білмеймін
Dialogue: 0,0:28:28.28,0:28:29.54,Default,,0,0,0,,Иә
Dialogue: 0,0:28:34.71,0:28:36.58,Default,,0,0,0,,Сіз робот іздеп жүрсіз бе?
Dialogue: 0,0:28:36.71,0:28:38.75,Default,,0,0,0,,Бұл менің қымбат роботым.
Dialogue: 0,0:28:38.88,0:28:40.55,Default,,0,0,0,,Сіздің роботыңыз?
Dialogue: 0,0:28:40.67,0:28:43.13,Default,,0,0,0,,Неліктен мұндай қорқынышты жою қаруын қолдандың?
Dialogue: 0,0:28:43.26,0:28:44.34,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:28:44.55,0:28:45.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:45.80,0:28:47.14,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:28:47.64,0:28:49.81,Default,,0,0,0,,Бұл жою қаруы емес.
Dialogue: 0,0:28:49.93,0:28:53.02,Default,,0,0,0,,Бұл құрылыс роботы.
Dialogue: 0,0:28:53.14,0:28:56.06,Default,,0,0,0,,Неліктен бұл Солтүстік полюсте?
Dialogue: 0,0:28:56.60,0:28:58.57,Default,,0,0,0,,Одан әрі айта алмаймын.
Dialogue: 0,0:28:58.69,0:29:02.49,Default,,0,0,0,,...
Dialogue: 0,0:29:04.45,0:29:07.24,Default,,0,0,0,,Жарайды, мен роботты қайтарып беремін.
Dialogue: 0,0:29:09.53,0:29:13.62,Default,,0,0,0,,...
Dialogue: 0,0:29:18.33,0:29:20.80,Default,,0,0,0,,Жүр, менің артымнан жүр.
Dialogue: 0,0:29:21.17,0:29:22.51,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:29:26.51,0:29:29.64,Default,,0,0,0,,…
Dialogue: 0,0:29:30.68,0:29:33.48,Default,,0,0,0,,Әй, сен кімсің?
Dialogue: 0,0:29:33.60,0:29:34.81,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:29:34.93,0:29:36.48,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:29:36.60,0:29:39.52,Default,,0,0,0,,Менің роботымды неге рұқсатсыз әкелдің?
Dialogue: 0,0:29:39.65,0:29:43.61,Default,,0,0,0,,Ой... жоқ, бұл...
Dialogue: 0,0:29:43.74,0:29:44.82,Default,,0,0,0,,Міне болды! (Нобита) Иә?
Dialogue: 0,0:29:45.07,0:29:47.20,Default,,0,0,0,,Дзюдо! Ақыры сені кездестірдім
Dialogue: 0,0:29:47.49,0:29:50.20,Default,,0,0,0,,Дзюдо? оғаш атау
Dialogue: 0,0:29:50.62,0:29:53.24,Default,,0,0,0,,Джуде, не болды? маған жауап бер
Dialogue: 0,0:29:53.37,0:29:55.91,Default,,0,0,0,,Жоқ, тіпті оны ұшпаңыз.
Dialogue: 0,0:29:56.04,0:29:59.67,Default,,0,0,0,,Дзюдо өз пікірі бойынша әрекет етуге еркін.
Dialogue: 0,0:29:59.79,0:30:02.88,Default,,0,0,0,,Кез келген жағдайда, сіз оны жинаған кезде миды қоспадыңыз ба?
Dialogue: 0,0:30:03.21,0:30:05.97,Default,,0,0,0,,Ми? Дөңгелек доп сияқты
Dialogue: 0,0:30:06.09,0:30:08.38,Default,,0,0,0,,Ойланып көріңізші...
Dialogue: 0,0:30:08.51,0:30:10.68,Default,,0,0,0,,Бұл қайда кетті?
Dialogue: 0,0:30:11.10,0:30:12.22,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:30:12.35,0:30:15.06,Default,,0,0,0,,…
Dialogue: 0,0:30:15.18,0:30:16.89,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:30:17.39,0:30:20.19,Default,,0,0,0,,...
Dialogue: 0,0:30:20.31,0:30:22.86,Default,,0,0,0,,...
Dialogue: 0,0:30:23.27,0:30:25.49,Default,,0,0,0,,Джуд қозғалысы
Dialogue: 0,0:30:27.20,0:30:28.82,Default,,0,0,0,,Жақсы (Нобита) Көрдіңіз бе?
Dialogue: 0,0:30:28.95,0:30:30.20,Default,,0,0,0,,Қозғалыңыздар
Dialogue: 0,0:30:32.28,0:30:34.37,Default,,0,0,0,,Дұрыс? Ол жақсы жұмыс істейді, солай ма?
Dialogue: 0,0:30:34.49,0:30:38.25,Default,,0,0,0,,…
Dialogue: 0,0:30:38.83,0:30:40.92,Default,,0,0,0,,Жақсы, мен сені кешіремін.
Dialogue: 0,0:30:41.04,0:30:43.46,Default,,0,0,0,,Маған екі нәрсеге уәде бер.
Dialogue: 0,0:30:43.59,0:30:44.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:45.17,0:30:46.01,Default,,0,0,0,,Бір
Dialogue: 0,0:30:46.67,0:30:50.26,Default,,0,0,0,,...
Dialogue: 0,0:30:50.39,0:30:52.30,Default,,0,0,0,,Бүгінгі күн туралы бір нәрсе.
Dialogue: 0,0:30:52.43,0:30:55.18,Default,,0,0,0,,２
Dialogue: 0,0:30:55.56,0:30:58.39,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:30:59.02,0:31:00.31,Default,,0,0,0,,Рахмет
Dialogue: 0,0:31:07.28,0:31:08.49,Default,,0,0,0,,Міне, Жер
Dialogue: 0,0:31:08.61,0:31:10.41,Default,,0,0,0,,Лилурудан Бас штабқа дейін
Dialogue: 0,0:31:10.53,0:31:15.03,Default,,0,0,0,,...
Dialogue: 0,0:31:15.29,0:31:16.66,Default,,0,0,0,,Іздеу жалғасуда.
Dialogue: 0,0:31:16.79,0:31:19.12,Default,,0,0,0,,...
Dialogue: 0,0:31:20.25,0:31:22.08,Default,,0,0,0,,Сондай-ақ мол астық жиналды.
Dialogue: 0,0:31:22.21,0:31:25.59,Default,,0,0,0,,...
Dialogue: 0,0:31:25.71,0:31:27.92,Default,,0,0,0,,...
Dialogue: 0,0:31:28.05,0:31:29.13,Default,,0,0,0,,Жоспарлау кірісі
Dialogue: 0,0:31:30.01,0:31:33.55,Default,,0,0,0,,...
Dialogue: 0,0:31:33.97,0:31:36.60,Default,,0,0,0,,（）
Dialogue: 0,0:31:37.02,0:31:38.31,Default,,0,0,0,,Сот…
Dialogue: 0,0:31:48.82,0:31:52.07,Default,,0,0,0,,Ия, ия, бұл бейсбол, бұл бейсбол.
Dialogue: 0,0:31:52.20,0:31:54.03,Default,,0,0,0,,Нобитаны қоспаңыз.
Dialogue: 0,0:31:54.16,0:31:55.95,Default,,0,0,0,,Сәлем
Dialogue: 0,0:31:56.08,0:31:58.24,Default,,0,0,0,,Нобита-сан, бұл күндері қызық.
Dialogue: 0,0:31:58.37,0:31:59.20,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:31:59.75,0:32:02.21,Default,,0,0,0,,Сіз ауырып жатырсыз ба? Немесе...
Dialogue: 0,0:32:02.33,0:32:03.79,Default,,0,0,0,,Бөлек
Dialogue: 0,0:32:04.71,0:32:05.79,Default,,0,0,0,,Қайта толтырыңыз!
Dialogue: 0,0:32:05.92,0:32:08.17,Default,,0,0,0,,...
Dialogue: 0,0:32:08.30,0:32:10.30,Default,,0,0,0,,Балықты дұрыс жеңіз.
Dialogue: 0,0:32:10.42,0:32:11.38,Default,,0,0,0,,Иә
Dialogue: 0,0:32:11.51,0:32:14.14,Default,,0,0,0,,Балық туралы айтатын болсақ, бұл көрші үйдегі Ямада мырза.
Dialogue: 0,0:32:14.39,0:32:18.68,Default,,0,0,0,,Сізді жақында балық аулауға кіріскеніңізді естідім. Мен жақын маңдағы балық аулайтын тоғанға бардым.
Dialogue: 0,0:32:18.81,0:32:20.22,Default,,0,0,0,,Сағат бойы ұстаңыз
Dialogue: 0,0:32:20.35,0:32:22.39,Default,,0,0,0,,Балық аулайтын тоғандар туралы айтпа!
Dialogue: 0,0:32:22.52,0:32:24.90,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:32:25.19,0:32:26.61,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:32:26.73,0:32:28.23,Default,,0,0,0,,Ямада мырза туралы айту
Dialogue: 0,0:32:28.36,0:32:30.94,Default,,0,0,0,,Анау ана күн сайын таңертең айнаға қарап отыратын...
Dialogue: 0,0:32:31.07,0:32:32.82,Default,,0,0,0,,Айна туралы айтуды доғар!
Dialogue: 0,0:32:33.11,0:32:34.16,Default,,0,0,0,,Ас үшін рахмет!
Dialogue: 0,0:32:34.28,0:32:36.32,Default,,0,0,0,,Нобита? Нобита?
Dialogue: 0,0:32:36.45,0:32:39.12,Default,,0,0,0,,Балық аулайтын тоған айнасы...
Dialogue: 0,0:32:40.79,0:32:42.21,Default,,0,0,0,,Хаа…
Dialogue: 0,0:32:42.33,0:32:46.00,Default,,0,0,0,,Занда Кроссты қайтарғаным жақсы болды деп ойлаймын.
Dialogue: 0,0:32:46.13,0:32:49.30,Default,,0,0,0,,Мына бала не істеп жүр?
Dialogue: 0,0:32:49.42,0:32:52.05,Default,,0,0,0,,Иә? Бірдеңе жарқ етті
Dialogue: 0,0:32:53.26,0:32:54.72,Default,,0,0,0,,Аққан жұлдыз?
Dialogue: 0,0:32:54.84,0:32:55.93,Default,,0,0,0,,(Киришима & Сейро) Хахаха… Шынымен бе? Шынымен бе? Бакуго!
Dialogue: 0,0:32:56.26,0:32:59.76,Default,,0,0,0,,Не? Артқы тауда
Dialogue: 0,0:33:07.48,0:33:10.98,Default,,0,0,0,,Қайда? Осы жерде құлаған сияқты
Dialogue: 0,0:33:11.11,0:33:11.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:13.53,0:33:17.45,Default,,0,0,0,,Озашики балық аулау! Неге мұндасың?
Dialogue: 0,0:33:17.87,0:33:19.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:21.62,0:33:25.50,Default,,0,0,0,,Айна әлеміне бірдеңе жіберілуде!
Dialogue: 0,0:33:32.76,0:33:34.59,Default,,0,0,0,,Бұл аққан жұлдыз ма?
Dialogue: 0,0:33:34.72,0:33:38.05,Default,,0,0,0,,Не? Бұл бір нәрсенің бөлігі сияқты
Dialogue: 0,0:33:38.18,0:33:39.80,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:33:47.52,0:33:48.60,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:33:48.73,0:33:50.86,Default,,0,0,0,,Тыныш! Сіз оны табасыз.
Dialogue: 0,0:33:51.27,0:33:52.94,Default,,0,0,0,,Дораемон
Dialogue: 0,0:33:53.07,0:33:56.11,Default,,0,0,0,,Сіз біртүрлі әрекет еткеніңіз үшін артыңыздан келдім.
Dialogue: 0,0:33:56.24,0:33:59.16,Default,,0,0,0,,Енді бәрін айтып берейін.
Dialogue: 0,0:33:59.28,0:34:01.41,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:34:03.54,0:34:05.91,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,0:34:06.87,0:34:09.92,Default,,0,0,0,,Мм, жұмбақ қыз Лилуру?
Dialogue: 0,0:34:10.33,0:34:12.92,Default,,0,0,0,,Мүмкін бұл бөтен адам шығар.
Dialogue: 0,0:34:13.05,0:34:15.26,Default,,0,0,0,,Ол жаман бала сияқты көрінбеді.
Dialogue: 0,0:34:17.05,0:34:18.72,Default,,0,0,0,,Бір нәрсе жарқырап тұр
Dialogue: 0,0:34:18.84,0:34:22.81,Default,,0,0,0,,Онда жіберілгендер жиналды.
Dialogue: 0,0:34:25.85,0:34:26.98,Default,,0,0,0,,(Екі адам айғайлайды)
Dialogue: 0,0:34:27.31,0:34:29.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:34:29.31,0:34:31.48,Default,,0,0,0,,Қаланың бір бөлігі қиратылды...
Dialogue: 0,0:34:32.86,0:34:35.53,Default,,0,0,0,,Бұл фантастикалық фильмге ұқсайды.
Dialogue: 0,0:34:43.83,0:34:45.87,Default,,0,0,0,,Ах! Бұл Zanda Cross
Dialogue: 0,0:34:46.00,0:34:47.00,Default,,0,0,0,,Лилуру да бар
Dialogue: 0,0:34:47.91,0:34:50.08,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:34:50.21,0:34:52.71,Default,,0,0,0,,Ол бірдеңе айтып жатыр, бірақ мен оны естімеймін.
Dialogue: 0,0:34:53.09,0:34:56.71,Default,,0,0,0,,Қазір… Жіпсіз телефон
Dialogue: 0,0:34:57.26,0:34:58.17,Default,,0,0,0,,Ұш!
Dialogue: 0,0:35:02.10,0:35:04.85,Default,,0,0,0,,Қону алаңын аяқтауға басымдық беріңіз
Dialogue: 0,0:35:05.26,0:35:08.81,Default,,0,0,0,,Бас қолбасшының оны тезірек аяқтау туралы бұйрығы.
Dialogue: 0,0:35:09.64,0:35:12.15,Default,,0,0,0,,Корпус орналастыруға дайын.
Dialogue: 0,0:35:12.27,0:35:14.77,Default,,0,0,0,,Енді осы базаның аяқталуын күту керек.
Dialogue: 0,0:35:15.27,0:35:20.24,Default,,0,0,0,,Бұл база біз үшін Жердегі шайқаста маңызды база болып табылады.
Dialogue: 0,0:35:20.70,0:35:24.99,Default,,0,0,0,,Оны аяқтау және оны табысты ету үшін бар күшіңізді жұмсаңыз.
Dialogue: 0,0:35:25.49,0:35:27.66,Default,,0,0,0,,Жер тұрғындарын ұстауды жоспарлаңыз!
Dialogue: 0,0:35:28.00,0:35:30.16,Default,,0,0,0,,Жерге түсіру операциясы? Тынш!
Dialogue: 0,0:35:30.29,0:35:31.08,Default,,0,0,0,,(Нобита мен Дораемонның дауысы)
Dialogue: 0,0:35:32.63,0:35:34.13,Default,,0,0,0,,Нобита-кун?
Dialogue: 0,0:35:34.38,0:35:37.00,Default,,0,0,0,,Сіз келдіңіз, солай ма? Бұл дұрыс болды
Dialogue: 0,0:35:37.13,0:35:39.80,Default,,0,0,0,,Мен сені өзіммен бірге алып кетейін деп жатыр едім.
Dialogue: 0,0:35:40.34,0:35:43.68,Default,,0,0,0,,Айна әлемінің есігін кеңейтуіңді қалаймын.
Dialogue: 0,0:35:43.80,0:35:46.22,Default,,0,0,0,,Үлкен әскердің келуіне дайындал.
Dialogue: 0,0:35:46.47,0:35:49.93,Default,,0,0,0,,Маған көмектесіңізші. Сен маған ұнайсың.
Dialogue: 0,0:35:50.06,0:35:54.40,Default,,0,0,0,,Жердегілердің ішінен ерекше мейірімге бөленетін жалғыз сенсің.
Dialogue: 0,0:35:54.77,0:35:56.44,Default,,0,0,0,,Шық, Нобита-кун.
Dialogue: 0,0:35:57.86,0:35:58.69,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:35:58.82,0:35:59.74,Default,,0,0,0,,Қаш!
Dialogue: 0,0:36:00.99,0:36:02.24,Default,,0,0,0,,Мен қашып құтыла алмаймын
Dialogue: 0,0:36:02.91,0:36:06.20,Default,,0,0,0,,(Екі дүрбелең дауысы)
Dialogue: 0,0:36:06.66,0:36:08.91,Default,,0,0,0,,Нуо! Тааа! Хмф!
Dialogue: 0,0:36:09.04,0:36:11.58,Default,,0,0,0,,(Нобита мен Дораемонның айқайы)
Dialogue: 0,0:36:17.42,0:36:18.25,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:36:18.46,0:36:21.05,Default,,0,0,0,,Нобита-кун! (Нобита) Уау!
Dialogue: 0,0:36:21.34,0:36:22.76,Default,,0,0,0,,Әуе зеңбіректерінің бумы!
Dialogue: 0,0:36:24.80,0:36:27.81,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:36:29.89,0:36:30.77,Default,,0,0,0,,Уау
Dialogue: 0,0:36:33.60,0:36:34.44,Default,,0,0,0,,Не?
Dialogue: 0,0:36:35.44,0:36:36.98,Default,,0,0,0,,Zanda Cross!
Dialogue: 0,0:36:37.11,0:36:38.52,Default,,0,0,0,,Қош келдіңіз Нобита-кун
Dialogue: 0,0:36:38.65,0:36:41.40,Default,,0,0,0,,(Нобита мен Дораемонның айқайы)
Dialogue: 0,0:36:46.45,0:36:50.45,Default,,0,0,0,,(Нобита мен Дорэмонның айқайы)
Dialogue: 0,0:36:52.25,0:36:54.29,Default,,0,0,0,,Шығу!
Dialogue: 0,0:36:54.96,0:36:56.88,Default,,0,0,0,,Күте тұрыңыз! Гах!
Dialogue: 0,0:36:58.29,0:37:00.55,Default,,0,0,0,,Шыу!
Dialogue: 0,0:37:00.67,0:37:03.47,Default,,0,0,0,,Әуе зеңбірегі! Бум!
Dialogue: 0,0:37:09.26,0:37:10.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:10.56,0:37:14.10,Default,,0,0,0,,(Екі адам айғайлайды)
Dialogue: 0,0:37:14.69,0:37:16.98,Default,,0,0,0,,Қашып қалма, мен бұзып өтем
Dialogue: 0,0:37:17.48,0:37:20.48,Default,,0,0,0,,Екі әлем арасындағы үлкен байланыс порты бар
Dialogue: 0,0:37:21.28,0:37:22.74,Default,,0,0,0,,Ол бұзылады!
Dialogue: 0,0:37:22.86,0:37:24.95,Default,,0,0,0,,Ей, ақымақ, бұл мүмкін емес!
Dialogue: 0,0:37:25.57,0:37:28.45,Default,,0,0,0,,Күшпен араласу?
Dialogue: 0,0:37:28.57,0:37:30.53,Default,,0,0,0,,(Екі адам айғайлайды)
Dialogue: 0,0:37:30.66,0:37:31.37,Default,,0,0,0,,Ах
Dialogue: 0,0:37:42.09,0:37:45.72,Default,,0,0,0,,(Нобитаның жөтелі)
Dialogue: 0,0:37:46.88,0:37:48.59,Default,,0,0,0,,Әй, Дораемон!
Dialogue: 0,0:37:49.68,0:37:53.56,Default,,0,0,0,,Ууууууууууу!
Dialogue: 0,0:37:53.68,0:37:55.27,Default,,0,0,0,,Ауыр…
Dialogue: 0,0:37:55.39,0:37:58.44,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:37:58.65,0:38:00.69,Default,,0,0,0,,Дәл қазір қандай жарылыс болды?
Dialogue: 0,0:38:00.82,0:38:02.11,Default,,0,0,0,,Бұл өлшемді жер сілкінісі.
Dialogue: 0,0:38:02.73,0:38:04.49,Default,,0,0,0,,Себебі мен оны күштеп ашуға тырыстым.
Dialogue: 0,0:38:04.61,0:38:07.57,Default,,0,0,0,,Кеңістіктегі жанасу нүктесі бұрмаланған және жыртылған.
Dialogue: 0,0:38:07.91,0:38:11.83,Default,,0,0,0,,Кіру және шығу басқа әлемде де жабылған болуы керек.
Dialogue: 0,0:38:12.12,0:38:14.33,Default,,0,0,0,,Сосын сол қорқынышты роботтар
Dialogue: 0,0:38:14.45,0:38:15.87,Default,,0,0,0,,Менің ойымша, сіз қазір шыға алмайсыз.
Dialogue: 0,0:38:16.00,0:38:16.87,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:38:17.00,0:38:18.58,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:38:18.71,0:38:21.79,Default,,0,0,0,,Ах, бірақ Лилулу да...
Dialogue: 0,0:38:21.92,0:38:23.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:24.80,0:38:28.80,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:38:36.81,0:38:40.81,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:38:41.86,0:38:45.11,Default,,0,0,0,,Корра, тыныш бол.
Dialogue: 0,0:38:45.23,0:38:46.53,Default,,0,0,0,,О, мүлде
Dialogue: 0,0:38:46.65,0:38:49.11,Default,,0,0,0,,Өте шулы
Dialogue: 0,0:38:49.24,0:38:51.82,Default,,0,0,0,,Бұл дыбыс... Нобита-кун!
Dialogue: 0,0:38:52.20,0:38:53.78,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:38:54.12,0:38:56.25,Default,,0,0,0,,Кола! Алақай!
Dialogue: 0,0:38:56.58,0:38:58.79,Default,,0,0,0,,Бұл! Эй!
Dialogue: 0,0:38:59.29,0:39:01.29,Default,,0,0,0,,Мені ұстаңыз... Әй?
Dialogue: 0,0:39:01.58,0:39:02.42,Default,,0,0,0,,Басшы келді!
Dialogue: 0,0:39:03.38,0:39:06.59,Default,,0,0,0,,Ол бірдеңеге шағымданып тұрған сияқты.
Dialogue: 0,0:39:06.76,0:39:08.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:39:08.72,0:39:10.89,Default,,0,0,0,,Хоньяку Коньяку
Dialogue: 0,0:39:11.01,0:39:12.05,Default,,0,0,0,,Уау, суық екен.
Dialogue: 0,0:39:12.18,0:39:14.51,Default,,0,0,0,,Сәлем Корра! Мен сізді қорқынышты тәжірибемен өткіздім.
Dialogue: 0,0:39:14.64,0:39:17.14,Default,,0,0,0,,Қайтар маған денемді Қайда алып кеттің денемді!
Dialogue: 0,0:39:17.27,0:39:20.35,Default,,0,0,0,,Мм, сіздің денеңіз және достарыңыз.
Dialogue: 0,0:39:20.48,0:39:24.23,Default,,0,0,0,,Мен сені айна әлеміне құлыптап, шығуға мүмкіндік бермедім.
Dialogue: 0,0:39:24.36,0:39:27.86,Default,,0,0,0,,Не? Лилулу Лилулу!
Dialogue: 0,0:39:27.99,0:39:30.20,Default,,0,0,0,,Иә? Хабарласу мүмкін емес
Dialogue: 0,0:39:30.49,0:39:32.57,Default,,0,0,0,,Айна әлемі бұғатталған.
Dialogue: 0,0:39:32.70,0:39:35.33,Default,,0,0,0,,Мен енді әлемді бағындыра алмаймын.
Dialogue: 0,0:39:35.45,0:39:37.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:39:37.29,0:39:39.29,Default,,0,0,0,,Вахахаха
Dialogue: 0,0:39:39.41,0:39:42.17,Default,,0,0,0,,Адамдар, қанша тырыссаңдар да, қазір кеш.
Dialogue: 0,0:39:42.29,0:39:43.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:43.50,0:39:46.63,Default,,0,0,0,,Мен Мехатопия планетасымен жаңа ғана байланысқа түстім.
Dialogue: 0,0:39:46.75,0:39:52.09,Default,,0,0,0,,Темір адам корпусы базаның аяқталуын күте алмайды және бүкіл әскерін Жерге қарай аттандырды.
Dialogue: 0,0:39:52.22,0:39:53.55,Default,,0,0,0,,Не?!
Dialogue: 0,0:39:53.68,0:39:57.35,Default,,0,0,0,,Бұрмалауды қайталаңыз, сонда сіз жақында Жерге жетесіз.
Dialogue: 0,0:39:57.47,0:40:00.68,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз таң қалдыңыз ба? Вахахаха
Dialogue: 0,0:40:00.81,0:40:03.77,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:40:03.98,0:40:05.90,Default,,0,0,0,,Роботтар тобы! (Нобита) Жерді жаулап алу
Dialogue: 0,0:40:06.02,0:40:07.73,Default,,0,0,0,,Түсіру операциясы (Нобита) Abi Scream
Dialogue: 0,0:40:07.86,0:40:09.78,Default,,0,0,0,,Абайсыз жау (Нобита) Барлық манчжурлық орындар
Dialogue: 0,0:40:09.90,0:40:10.74,Default,,0,0,0,,Жеті мен сегіз құлады
Dialogue: 0,0:40:10.86,0:40:12.32,Default,,0,0,0,,Зат алмасу!
Dialogue: 0,0:40:12.57,0:40:15.62,Default,,0,0,0,,Сіз бұл туралы біраз уақыттан бері уайымдап жүрсіз ғой, солай емес пе?
Dialogue: 0,0:40:15.74,0:40:18.16,Default,,0,0,0,,Себебі мен теледидар мен мультфильмдерді көп көремін.
Dialogue: 0,0:40:18.66,0:40:22.00,Default,,0,0,0,,Бұл рас, офицер. Ғарыштан робот келді!
Dialogue: 0,0:40:22.12,0:40:23.21,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:40:23.33,0:40:24.46,Default,,0,0,0,,Кесіңіз!
Dialogue: 0,0:40:25.00,0:40:26.54,Default,,0,0,0,,Мүмкіндігінше қолданып көріңіз!
Dialogue: 0,0:40:26.67,0:40:30.38,Default,,0,0,0,,Өзін-өзі қорғау күштері Премьер-министр Метрополитен полиция департаментінің арнайы миссиясы бөлімі!
Dialogue: 0,0:40:32.80,0:40:35.39,Default,,0,0,0,,Маған ешкім сенбейді
Dialogue: 0,0:40:35.64,0:40:40.02,Default,,0,0,0,,Бұл орын алып жатқанда, Темір адам корпусы әлі де Жерге ұмтылуда...
Dialogue: 0,0:40:41.02,0:40:42.44,Default,,0,0,0,,Сол екеуіне...
Dialogue: 0,0:40:42.56,0:40:45.23,Default,,0,0,0,,Кеңес алғыңыз келе ме?
Dialogue: 0,0:40:45.35,0:40:47.86,Default,,0,0,0,,...
Dialogue: 0,0:40:48.82,0:40:50.23,Default,,0,0,0,,Темір адам корпусы?
Dialogue: 0,0:40:50.36,0:40:51.49,Default,,0,0,0,,Сіз шабуыл жасайсыз ба?
Dialogue: 0,0:40:51.74,0:40:53.99,Default,,0,0,0,,Қиын, қиын, қиын!
Dialogue: 0,0:40:54.99,0:40:57.12,Default,,0,0,0,,Маған сенесіз бе?
Dialogue: 0,0:40:57.41,0:40:59.37,Default,,0,0,0,,Біз доспыз ғой.
Dialogue: 0,0:40:59.49,0:41:00.87,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:41:01.41,0:41:06.00,Default,,0,0,0,,Дегенмен, осы төрт адам Жерді жалғыз қорғай ма деп ойлаймын.
Dialogue: 0,0:41:06.13,0:41:09.42,Default,,0,0,0,,Дұрыс, бізге басқа одақтастар керек.
Dialogue: 0,0:41:09.55,0:41:13.01,Default,,0,0,0,,Рас, бұл Zandacross миы
Dialogue: 0,0:41:13.13,0:41:14.84,Default,,0,0,0,,Мен оны одақтас ете алмаймын деп ойлаймын.
Dialogue: 0,0:41:15.55,0:41:19.39,Default,,0,0,0,,Егер сіз мұны жасасаңыз, сіз жау туралы ақпаратты ала аласыз.
Dialogue: 0,0:41:20.06,0:41:21.27,Default,,0,0,0,,Хо
Dialogue: 0,0:41:23.27,0:41:24.39,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,0:41:24.52,0:41:27.19,Default,,0,0,0,,Сол ми сізді одақтас етеді ме?
Dialogue: 0,0:41:27.31,0:41:29.40,Default,,0,0,0,,Неліктен оны өзгертпеске?
Dialogue: 0,0:41:29.73,0:41:31.86,Default,,0,0,0,,Өзгерістер қорқынышты
Dialogue: 0,0:41:31.98,0:41:34.32,Default,,0,0,0,,Мұқият сөйлессек, түсінетін шығар.
Dialogue: 0,0:41:34.45,0:41:37.20,Default,,0,0,0,,Жарайды, алдымен сөйлесейік.
Dialogue: 0,0:41:38.78,0:41:41.12,Default,,0,0,0,,Ал, отырыңыз.
Dialogue: 0,0:41:42.12,0:41:44.37,Default,,0,0,0,,Хоньяку Коньяку Йойшо
Dialogue: 0,0:41:44.50,0:41:45.37,Default,,0,0,0,,Уау, суық екен.
Dialogue: 0,0:41:45.79,0:41:48.63,Default,,0,0,0,,Эй, Корра, сен оны әдемілеп жинадың.
Dialogue: 0,0:41:48.75,0:41:51.13,Default,,0,0,0,,Темір сарбаздар келгенде (Нобита) Жарайды, тынышталыңыз.
Dialogue: 0,0:41:51.21,0:41:53.71,Default,,0,0,0,,Балалар сендер өте ыстық екенсіңдер
Dialogue: 0,0:41:53.84,0:41:56.01,Default,,0,0,0,,Бакин Бакиннің кейіпкері
Dialogue: 0,0:41:56.13,0:41:57.64,Default,,0,0,0,,Доттанба…
Dialogue: 0,0:41:58.68,0:42:00.64,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:42:00.76,0:42:04.35,Default,,0,0,0,,Барлық жердегілер біздің құлымызға айналады.
Dialogue: 0,0:42:04.48,0:42:07.65,Default,,0,0,0,,Балалар, сендер сондай бейберекетсіңдер...
Dialogue: 0,0:42:08.40,0:42:10.06,Default,,0,0,0,,Сол себепті!
Dialogue: 0,0:42:10.27,0:42:13.48,Default,,0,0,0,,Жердегілерді жыртып, лақтыр, жыртып, лақтыр
Dialogue: 0,0:42:13.61,0:42:15.53,Default,,0,0,0,,Соғу...
Dialogue: 0,0:42:16.40,0:42:17.24,Default,,0,0,0,,Хмм.
Dialogue: 0,0:42:17.36,0:42:18.45,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:42:18.82,0:42:21.24,Default,,0,0,0,,Мен саған тыныш бол дедім ғой!
Dialogue: 0,0:42:21.37,0:42:23.08,Default,,0,0,0,,Қандай ақымақ.
Dialogue: 0,0:42:23.20,0:42:26.04,Default,,0,0,0,,Жалпы айтқанда, ақымақ сияқты.
Dialogue: 0,0:42:26.16,0:42:29.42,Default,,0,0,0,,Боулинг допты осылай талқылай аласыз ба?
Dialogue: 0,0:42:29.54,0:42:31.34,Default,,0,0,0,,(барлық дүрбелең)
Dialogue: 0,0:42:31.54,0:42:33.21,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:42:33.34,0:42:35.76,Default,,0,0,0,,Әңгімелер қорапшасы
Dialogue: 0,0:42:36.84,0:42:40.80,Default,,0,0,0,,Осының ішіне бірдеңе салсаңыз, ол таныс пішінге айналады.
Dialogue: 0,0:42:40.93,0:42:43.72,Default,,0,0,0,,Еркін сөйлей білу
Dialogue: 0,0:42:43.85,0:42:46.10,Default,,0,0,0,,Не? Тез шығарыңыз.
Dialogue: 0,0:42:46.23,0:42:47.23,Default,,0,0,0,,Не істеу керек! Хехе
Dialogue: 0,0:42:48.02,0:42:49.73,Default,,0,0,0,,Қосу
Dialogue: 0,0:42:51.31,0:42:52.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:54.90,0:42:56.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:58.45,0:42:59.41,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:42:59.57,0:43:02.03,Default,,0,0,0,,(Барлығы жөтеледі)
Dialogue: 0,0:43:06.66,0:43:11.83,Default,,0,0,0,,(Ми күресі дауысы)
Dialogue: 0,0:43:12.33,0:43:13.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:15.50,0:43:16.80,Default,,0,0,0,,Пуи!
Dialogue: 0,0:43:16.92,0:43:19.51,Default,,0,0,0,,Пунью хаа...
Dialogue: 0,0:43:20.09,0:43:21.72,Default,,0,0,0,,Ах~
Dialogue: 0,0:43:22.14,0:43:23.72,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:43:23.85,0:43:25.89,Default,,0,0,0,,Ол қағып тұр
Dialogue: 0,0:43:26.02,0:43:28.39,Default,,0,0,0,,Сен тым сүйкімдісің, иә?
Dialogue: 0,0:43:28.52,0:43:30.69,Default,,0,0,0,,Балапанға ұқсайды
Dialogue: 0,0:43:31.02,0:43:33.06,Default,,0,0,0,,Мен сені Хио Чан деп атайын ба?
Dialogue: 0,0:43:33.19,0:43:35.19,Default,,0,0,0,,Хиё-чан қарапайым болуы керек.
Dialogue: 0,0:43:35.32,0:43:39.36,Default,,0,0,0,,Жарайды, сіз пипипипи попопопопо дедіңіз.
Dialogue: 0,0:43:39.49,0:43:40.86,Default,,0,0,0,,Пиппо жасайық
Dialogue: 0,0:43:45.45,0:43:46.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:47.04,0:43:49.04,Default,,0,0,0,,Қандай ақымақ есім.
Dialogue: 0,0:43:49.16,0:43:52.79,Default,,0,0,0,,Жер тұрғындары Пийоның ең нашар сезіміне ие
Dialogue: 0,0:43:53.13,0:43:54.38,Default,,0,0,0,,(Таңданған үш дауыс)
Dialogue: 0,0:43:54.50,0:43:58.26,Default,,0,0,0,,Ей! Біртүрлі есімдерді қолдануды доғарғаныңды қалаймын, Пиё.
Dialogue: 0,0:43:58.38,0:44:00.97,Default,,0,0,0,,Менің атым Дзюдо Пийо
Dialogue: 0,0:44:01.09,0:44:04.60,Default,,0,0,0,,Дзю... Дзюдода ауыр сезім жоқ.
Dialogue: 0,0:44:04.72,0:44:05.76,Default,,0,0,0,,Сіз осындайсыз...
Dialogue: 0,0:44:05.89,0:44:09.77,Default,,0,0,0,,Менің ойымша, Пиппо сүйкімді.
Dialogue: 0,0:44:09.98,0:44:12.69,Default,,0,0,0,,Қандай үмітсіз сезім.
Dialogue: 0,0:44:12.81,0:44:16.52,Default,,0,0,0,,Қуаты аз жердегілердің сезімталдығын түсіну қиын.
Dialogue: 0,0:44:16.65,0:44:19.03,Default,,0,0,0,,Құлдар осылай дейді ғой.
Dialogue: 0,0:44:19.32,0:44:21.82,Default,,0,0,0,,Пішіні сүйкімді болса да
Dialogue: 0,0:44:21.95,0:44:23.82,Default,,0,0,0,,Менің ойлау тәсілім мүлде өзгерген жоқ.
Dialogue: 0,0:44:23.95,0:44:26.28,Default,,0,0,0,,Сіз өзіңіздің мінезіңізді өзгерте алмайсыз.
Dialogue: 0,0:44:26.41,0:44:28.83,Default,,0,0,0,,Адамдар – пайдасыз жаратылыс.
Dialogue: 0,0:44:29.41,0:44:31.91,Default,,0,0,0,,Біреу сүйкімді жүзбен осылай айтса
Dialogue: 0,0:44:32.04,0:44:34.04,Default,,0,0,0,,Ашуланба, Конняроме
Dialogue: 0,0:44:34.17,0:44:37.34,Default,,0,0,0,,Сабырмен сөйлесейік, жарай ма?
Dialogue: 0,0:44:37.46,0:44:39.46,Default,,0,0,0,,Иә, жарай ма?
Dialogue: 0,0:44:39.96,0:44:42.68,Default,,0,0,0,,Адамдар мен роботтар дос.
Dialogue: 0,0:44:42.97,0:44:45.68,Default,,0,0,0,,Оларды құл ету дұрыс емес деп ойлайсың ба?
Dialogue: 0,0:44:45.80,0:44:50.39,Default,,0,0,0,,Роботтардан да төмен адамдардың құлға айналуы табиғи нәрсе, Пиё.
Dialogue: 0,0:44:50.52,0:44:51.64,Default,,0,0,0,,Ондай нәрсе жоқ...
Dialogue: 0,0:44:51.77,0:44:56.06,Default,,0,0,0,,Әсіресе Нобита - ең ақымақ және пайдасыз Пиё.
Dialogue: 0,0:44:56.23,0:44:58.40,Default,,0,0,0,,Тағы да айтыңыз!
Dialogue: 0,0:44:58.73,0:45:01.28,Default,,0,0,0,,Не, не, не?
Dialogue: 0,0:45:01.90,0:45:04.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:04.20,0:45:06.49,Default,,0,0,0,,Шулы!
Dialogue: 0,0:45:06.87,0:45:09.91,Default,,0,0,0,,Уау, сыртта ойна.
Dialogue: 0,0:45:10.79,0:45:14.50,Default,,0,0,0,,Бұл не? Сол жауыз жер
Dialogue: 0,0:45:14.62,0:45:16.71,Default,,0,0,0,,Оны Мама деп атайды
Dialogue: 0,0:45:16.83,0:45:19.92,Default,,0,0,0,,Бұл жер бетіндегі ең күшті тіршілік иесі.
Dialogue: 0,0:45:23.88,0:45:24.72,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:45:24.84,0:45:28.30,Default,,0,0,0,,Талқылауды жалғастырайық, бірақ оған дейін...
Dialogue: 0,0:45:28.80,0:45:32.39,Default,,0,0,0,,Менің әнімді тыңда, бұрын болған төбелесіңді жу.
Dialogue: 0,0:45:32.52,0:45:33.77,Default,,0,0,0,,Не?!
Dialogue: 0,0:45:34.56,0:45:37.69,Default,,0,0,0,,Тақырып «Махаббаттың жазғы арманы» (Үш дүрбелең дауысы)
Dialogue: 0,0:45:38.15,0:45:39.15,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:45:39.27,0:45:41.82,Default,,0,0,0,,♪ Джаджаяджаан (бәрі айғайлайды)
Dialogue: 0,0:45:41.94,0:45:44.11,Default,,0,0,0,,♪ Мен Джан
Dialogue: 0,0:45:44.70,0:45:49.07,Default,,0,0,0,,♪ Супержұлдыз және брат генерал
Dialogue: 0,0:45:49.83,0:45:53.79,Default,,0,0,0,,Ко Ко Мен мұндай қорқынышты әнді естімеппін!
Dialogue: 0,0:45:56.87,0:45:59.54,Default,,0,0,0,,Мен сендерді түгел жек көремін
Dialogue: 0,0:45:59.84,0:46:00.88,Default,,0,0,0,,Қорқынышты Пиё!
Dialogue: 0,0:46:01.00,0:46:03.71,Default,,0,0,0,,Бұл жай ғана шудың ластануы!
Dialogue: 0,0:46:04.38,0:46:06.18,Default,,0,0,0,,Жақсы айтылған.
Dialogue: 0,0:46:06.30,0:46:08.68,Default,,0,0,0,,Ән туралы не түсіндің?
Dialogue: 0,0:46:08.80,0:46:10.05,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:46:10.35,0:46:13.68,Default,,0,0,0,,Кем дегенде Пиё сенен жақсы ән айта алады!
Dialogue: 0,0:46:13.85,0:46:16.89,Default,,0,0,0,,Эй... бұл керемет емес пе? Ән айтып көріңіз.
Dialogue: 0,0:46:17.14,0:46:18.44,Default,,0,0,0,,Ән айту
Dialogue: 0,0:46:21.19,0:46:23.82,Default,,0,0,0,,Мен сияқты жақсы болмасаң, якиторимен жақсы болар едің.
Dialogue: 0,0:46:26.82,0:46:28.28,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:46:30.87,0:46:34.87,Default,,0,0,0,,♪ Біріншісі - махаббат
Dialogue: 0,0:46:35.00,0:46:36.04,Default,,0,0,0,,Уау...
Dialogue: 0,0:46:36.16,0:46:42.38,Default,,0,0,0,,♪ Сен екеуміз бірміз
Dialogue: 0,0:46:43.59,0:46:47.63,Default,,0,0,0,,♪ Екінші тілек
Dialogue: 0,0:46:48.80,0:46:54.81,Default,,0,0,0,,♪ Сен сенсің мен менмін
Dialogue: 0,0:46:54.93,0:46:56.89,Default,,0,0,0,,Уау
Dialogue: 0,0:46:57.94,0:47:02.02,Default,,0,0,0,,♪ Мен үшінші нәрсе туралы ойлаймын.
Dialogue: 0,0:47:03.23,0:47:06.99,Default,,0,0,0,,♪ Сіз кімсіз?
Dialogue: 0,0:47:07.11,0:47:13.49,Default,,0,0,0,,♪ Мен кіммін?
Dialogue: 0,0:47:13.62,0:47:16.25,Default,,0,0,0,,(Барлық қошемет)
Dialogue: 0,0:47:16.45,0:47:18.04,Default,,0,0,0,,Бұл таңқаларлық, Пиппо.
Dialogue: 0,0:47:18.16,0:47:19.46,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:47:19.75,0:47:21.67,Default,,0,0,0,,Бұл көңілсіз, бірақ дәмді.
Dialogue: 0,0:47:21.79,0:47:24.67,Default,,0,0,0,,Бұл жаман емес... бірақ...
Dialogue: 0,0:47:24.96,0:47:26.55,Default,,0,0,0,,Сіз кәсіби әнші болдыңыз ба?
Dialogue: 0,0:47:26.67,0:47:27.97,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:47:28.09,0:47:30.59,Default,,0,0,0,,Неліктен? Бұл өте жақсы болса да
Dialogue: 0,0:47:31.89,0:47:35.68,Default,,0,0,0,,Мехатопияда ән айту тек ақсүйектерге арналған.
Dialogue: 0,0:47:36.31,0:47:40.31,Default,,0,0,0,,Біз еңбек роботтарына ән айтуға болмайды.
Dialogue: 0,0:47:40.39,0:47:44.94,Default,,0,0,0,,♪Сен екеуміз бірміз
Dialogue: 0,0:47:46.61,0:47:47.53,Default,,0,0,0,,♪ Екі...
Dialogue: 0,0:47:47.65,0:47:49.40,Default,,0,0,0,,Бұл еңбек роботы болса да!
Dialogue: 0,0:47:49.53,0:47:51.99,Default,,0,0,0,,Ән айтпа!
Dialogue: 0,0:47:54.32,0:47:56.12,Default,,0,0,0,,Бұл жігіт енді жақсы емес.
Dialogue: 0,0:47:56.24,0:47:57.49,Default,,0,0,0,,Ол қоқыс жәшігіне түседі.
Dialogue: 0,0:47:57.62,0:47:59.12,Default,,0,0,0,,(асыл роботтардың күлкісі)
Dialogue: 0,0:48:07.84,0:48:09.67,Default,,0,0,0,,Лилулу…
Dialogue: 0,0:48:13.51,0:48:15.05,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:48:15.18,0:48:16.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:16.35,0:48:19.52,Default,,0,0,0,,Әнді еркін айта білу керек; бұл ән емес.
Dialogue: 0,0:48:19.64,0:48:20.73,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:48:20.85,0:48:23.77,Default,,0,0,0,,Сенің әніңді естісе, бәрі міндетті түрде қуанар еді.
Dialogue: 0,0:48:24.02,0:48:25.56,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:48:25.69,0:48:29.23,Default,,0,0,0,,Барлық еңбек роботтары қоқыс болып саналады...
Dialogue: 0,0:48:29.65,0:48:33.66,Default,,0,0,0,,Мұнда мұндай кемсітушілік жоқ, сондықтан сіз өзіңізге ұнайтын әнді айта аласыз.
Dialogue: 0,0:48:33.78,0:48:34.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:48:34.87,0:48:39.20,Default,,0,0,0,,Сен роботсың, неге адамдармен біргесің?
Dialogue: 0,0:48:39.62,0:48:40.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:48:40.87,0:48:44.04,Default,,0,0,0,,Оның адамға немесе роботқа қатысы жоқ.
Dialogue: 0,0:48:44.17,0:48:46.42,Default,,0,0,0,,Иә, біз доспыз.
Dialogue: 0,0:48:46.84,0:48:48.21,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:48:48.34,0:48:49.17,Default,,0,0,0,,Көптеген жылдар бойы дәрігер болып—
Dialogue: 0,0:48:49.30,0:48:51.76,Default,,0,0,0,,Мен өзімді біртүрлі сезінемін.
Dialogue: 0,0:48:51.88,0:48:55.34,Default,,0,0,0,,Мен бұл жігіттермен жүргенде Пиё біртүрлі болып қалады.
Dialogue: 0,0:48:55.47,0:48:58.18,Default,,0,0,0,,А, мен не істеп жатырмын?
Dialogue: 0,0:48:58.31,0:49:01.48,Default,,0,0,0,,Қалай болғанда да мен Лилулуға көмектесуім керек.
Dialogue: 0,0:49:02.68,0:49:03.69,Default,,0,0,0,,Пиппо?
Dialogue: 0,0:49:03.81,0:49:07.48,Default,,0,0,0,,Мен қателесіппін. Мен бәрінің жағындамын.
Dialogue: 0,0:49:07.61,0:49:08.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:08.86,0:49:10.78,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:49:10.90,0:49:12.65,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:49:12.78,0:49:15.11,Default,,0,0,0,,Мен айттым ғой, солай ма? Менімен сөйлессең түсінерсің
Dialogue: 0,0:49:15.24,0:49:17.37,Default,,0,0,0,,Әнім жүрегімді тебірентті
Dialogue: 0,0:49:17.49,0:49:18.70,Default,,0,0,0,,Хахахаха олай емес.
Dialogue: 0,0:49:18.83,0:49:22.87,Default,,0,0,0,,Қуаныштымын, Пиппо, сен бүгіннен бастап менің досымсың.
Dialogue: 0,0:49:25.29,0:49:29.25,Default,,0,0,0,,Мен сенің денеңе еніп, әркімнің күшіне айналамын.
Dialogue: 0,0:49:29.38,0:49:30.88,Default,,0,0,0,,Менің денем қайда?
Dialogue: 0,0:49:31.17,0:49:33.88,Default,,0,0,0,,Мен түсінемін, егер Пиппо оны жылжытса.
Dialogue: 0,0:49:34.01,0:49:36.72,Default,,0,0,0,,Сіз Zanda Cross-ты одақтас ете аласыз.
Dialogue: 0,0:49:36.84,0:49:38.35,Default,,0,0,0,,Бұл 100 адамнан тұрады.
Dialogue: 0,0:49:38.55,0:49:41.56,Default,,0,0,0,,Жарайды, ендеше сол айна әлеміне барайық.
Dialogue: 0,0:49:41.93,0:49:44.73,Default,,0,0,0,,Бірақ Озашики балық аулайтын қайық жоқ.
Dialogue: 0,0:49:44.85,0:49:48.27,Default,,0,0,0,,Бір жерде айна тәрізді кең жазықтық бар...
Dialogue: 0,0:49:48.40,0:49:50.02,Default,,0,0,0,,Иә (3 адам) Әй?
Dialogue: 0,0:49:50.32,0:49:52.48,Default,,0,0,0,,Яан Шизука-чанның моншасы
Dialogue: 0,0:49:52.61,0:49:54.44,Default,,0,0,0,,Зуко!
Dialogue: 0,0:49:54.57,0:49:58.37,Default,,0,0,0,,А, у... мен Шизука-чаннан бас тартуым керек пе?
Dialogue: 0,0:49:58.49,0:50:02.20,Default,,0,0,0,,Мен қыздың мұндай сұмдық оқиғаға қатысқанын қаламаймын.
Dialogue: 0,0:50:03.66,0:50:05.66,Default,,0,0,0,,Жақсы! барайық!
Dialogue: 0,0:50:05.79,0:50:06.92,Default,,0,0,0,,Оу!
Dialogue: 0,0:50:08.21,0:50:11.13,Default,,0,0,0,,Уау, сол мен оң жақ шынымен қарама-қарсы.
Dialogue: 0,0:50:11.25,0:50:14.88,Default,,0,0,0,,Оның не екенін білмеймін, ғажап.
Dialogue: 0,0:50:15.01,0:50:17.47,Default,,0,0,0,,Хахаха Зауыттық тақта да керісінше.
Dialogue: 0,0:50:17.59,0:50:18.68,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:50:19.30,0:50:20.80,Default,,0,0,0,,Лилуру
Dialogue: 0,0:50:21.14,0:50:22.89,Default,,0,0,0,,Лилулу!
Dialogue: 0,0:50:23.22,0:50:24.10,Default,,0,0,0,,Түсінбеген
Dialogue: 0,0:50:24.22,0:50:28.77,Default,,0,0,0,,Нобита, сенде бұл қызықты дүние бар ма?
Dialogue: 0,0:50:28.90,0:50:30.27,Default,,0,0,0,,Ауырды
Dialogue: 0,0:50:30.40,0:50:31.86,Default,,0,0,0,,Иә? пиппо
Dialogue: 0,0:50:32.15,0:50:34.28,Default,,0,0,0,,Осы дүниеге келсең болды
Dialogue: 0,0:50:34.48,0:50:37.28,Default,,0,0,0,,Енді саған пайда жоқ, Пиё.
Dialogue: 0,0:50:37.40,0:50:39.99,Default,,0,0,0,,Уау, анау жігіт! Мен сені алдадым ба?
Dialogue: 0,0:50:40.12,0:50:42.12,Default,,0,0,0,,Күте тұрыңыз! (Нобита) Міне!
Dialogue: 0,0:50:42.66,0:50:43.95,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:50:44.08,0:50:47.46,Default,,0,0,0,,Алданған жердегілер ақымақ, Пиё
Dialogue: 0,0:50:47.58,0:50:48.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:50:49.33,0:50:52.04,Default,,0,0,0,,Пиёоны жердегілер ұстамайды.
Dialogue: 0,0:50:52.17,0:50:53.92,Default,,0,0,0,,Бұл
Dialogue: 0,0:50:54.05,0:50:56.38,Default,,0,0,0,,Не?
Dialogue: 0,0:50:56.97,0:50:58.34,Default,,0,0,0,,Не?
Dialogue: 0,0:51:01.76,0:51:03.64,Default,,0,0,0,,(Барлығы айғайлайды)
Dialogue: 0,0:51:08.31,0:51:10.52,Default,,0,0,0,,Мені атпа, мен Дзюдомын.
Dialogue: 0,0:51:11.15,0:51:12.48,Default,,0,0,0,,Дзюдоның миы
Dialogue: 0,0:51:15.94,0:51:18.74,Default,,0,0,0,,Пішіні Дзюдоның миына ұқсамайды.
Dialogue: 0,0:51:19.57,0:51:20.61,Default,,0,0,0,,(Барлығы айғайлайды)
Dialogue: 0,0:51:21.99,0:51:23.07,Default,,0,0,0,,Пиппо! Уау
Dialogue: 0,0:51:23.70,0:51:26.24,Default,,0,0,0,,Әуе зеңбірегі Бум! Бум!
Dialogue: 0,0:51:28.00,0:51:29.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:31.46,0:51:32.92,Default,,0,0,0,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,0:51:33.50,0:51:34.63,Default,,0,0,0,,Нобита
Dialogue: 0,0:51:34.88,0:51:37.17,Default,,0,0,0,,Мені қате түсінбеңіз.
Dialogue: 0,0:51:37.30,0:51:40.38,Default,,0,0,0,,Мен құлаған кезде Пиппо сол жерде болды. Хамф!
Dialogue: 0,0:51:40.51,0:51:41.34,Default,,0,0,0,,Пиё!
Dialogue: 0,0:51:41.97,0:51:42.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:42.93,0:51:44.30,Default,,0,0,0,,Нобита-кун! қашу
Dialogue: 0,0:51:44.68,0:51:46.01,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:51:47.02,0:51:49.98,Default,,0,0,0,,Адамды өлтірме, тірідей ұста.
Dialogue: 0,0:51:53.86,0:51:54.90,Default,,0,0,0,,(Барлығы айғайлайды)
Dialogue: 0,0:52:00.36,0:52:01.32,Default,,0,0,0,,5 мәйіт ұсталды
Dialogue: 0,0:52:04.20,0:52:06.24,Default,,0,0,0,,Бұл адамды жойыңыз
Dialogue: 0,0:52:09.54,0:52:10.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:10.71,0:52:12.58,Default,,0,0,0,,Тоқта! Апыр-ай!
Dialogue: 0,0:52:12.92,0:52:14.00,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,0:52:14.13,0:52:15.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:17.21,0:52:18.88,Default,,0,0,0,,Нобита
Dialogue: 0,0:52:20.92,0:52:21.84,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:52:26.68,0:52:29.72,Default,,0,0,0,,Нобита-кун! (Джан Сунео) Нобита!
Dialogue: 0,0:52:32.31,0:52:34.23,Default,,0,0,0,,Ах... Қарғыс атсын...
Dialogue: 0,0:52:36.77,0:52:38.32,Default,,0,0,0,,2 денені жойыңыз
Dialogue: 0,0:52:38.73,0:52:40.74,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:52:40.86,0:52:42.32,Default,,0,0,0,,Мені базаға апарыңыз
Dialogue: 0,0:52:42.45,0:52:44.53,Default,,0,0,0,,Ол жерде әлі де басқа адамдар болуы мүмкін.
Dialogue: 0,0:52:44.66,0:52:46.66,Default,,0,0,0,,Негізгі қызметкерлерді барлауға жіберу
Dialogue: 0,0:52:46.78,0:52:47.87,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:52:48.37,0:52:49.91,Default,,0,0,0,,Эй-эй, эй-эй
Dialogue: 0,0:52:50.04,0:52:51.54,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:52:51.91,0:52:53.71,Default,,0,0,0,,(Нобитаның жөтелі)
Dialogue: 0,0:52:53.83,0:52:55.88,Default,,0,0,0,,Мен қорқынышты жағдайға тап болдым
Dialogue: 0,0:52:57.63,0:52:59.84,Default,,0,0,0,,Пиё Пиё… (Нобита) Хаа…
Dialogue: 0,0:53:00.34,0:53:01.84,Default,,0,0,0,,Буруру…
Dialogue: 0,0:53:03.68,0:53:05.51,Default,,0,0,0,,Барлығын алып кетеді
Dialogue: 0,0:53:05.97,0:53:08.81,Default,,0,0,0,,Мен не істеуім керек? Мен қандай да бір жолмен көмектесуім керек.
Dialogue: 0,0:53:08.93,0:53:12.23,Default,,0,0,0,,Құтқарылған болсаңыз да, қауіпті әрекетке бармаңыз.
Dialogue: 0,0:53:12.35,0:53:14.73,Default,,0,0,0,,Міне! Мені жалғыз қалдыр дейсің бе?
Dialogue: 0,0:53:14.98,0:53:17.23,Default,,0,0,0,,Көмектесудің мәні неде?
Dialogue: 0,0:53:17.36,0:53:19.98,Default,,0,0,0,,Мұның мағынасы жоқ...
Dialogue: 0,0:53:20.11,0:53:22.44,Default,,0,0,0,,Бірақ сен менің досымсың, мен саған көмектесуім керек.
Dialogue: 0,0:53:23.57,0:53:24.91,Default,,0,0,0,,Достар…
Dialogue: 0,0:53:25.53,0:53:28.37,Default,,0,0,0,,Біз қандай да бір жолмен көмектесуіміз керек.
Dialogue: 0,0:53:33.83,0:53:35.67,Default,,0,0,0,,(тон)
Dialogue: 0,0:53:36.50,0:53:39.79,Default,,0,0,0,,Уайымдама, мен саған міндетті түрде көмектесемін.
Dialogue: 0,0:53:49.80,0:53:52.81,Default,,0,0,0,,Сіз маған көмектесе аласыз... Пиё
Dialogue: 0,0:53:53.06,0:53:54.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:54.35,0:53:55.64,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:53:55.77,0:53:59.94,Default,,0,0,0,,Бұл кездейсоқтық болса да, мен құтқарылу қарызымды өтеп жатырмын, Пиё.
Dialogue: 0,0:54:00.07,0:54:01.73,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:54:01.86,0:54:04.32,Default,,0,0,0,,Рахмет Пиппо
Dialogue: 0,0:54:04.44,0:54:05.49,Default,,0,0,0,,Хмф!
Dialogue: 0,0:54:06.49,0:54:09.82,Default,,0,0,0,,Қайнап кете ме деп қалдым, хехе
Dialogue: 0,0:54:10.45,0:54:11.28,Default,,0,0,0,,Ах
Dialogue: 0,0:54:12.12,0:54:13.91,Default,,0,0,0,,Бұл...
Dialogue: 0,0:54:17.00,0:54:18.63,Default,,0,0,0,,Айна әлемі!
Dialogue: 0,0:54:24.42,0:54:26.13,Default,,0,0,0,,Әй, мына жақта, тезірек.
Dialogue: 0,0:54:26.26,0:54:27.97,Default,,0,0,0,,Асығыңыз Асығыңыз
Dialogue: 0,0:54:38.90,0:54:42.02,Default,,0,0,0,,Бұл заттарды қоқыс жәшігіне тастаңыз.
Dialogue: 0,0:54:42.15,0:54:43.82,Default,,0,0,0,,Оны қазып алу туралы бұйрық.
Dialogue: 0,0:54:43.94,0:54:46.03,Default,,0,0,0,,Бұл пайдасыз, ол жұмыс істемейді.
Dialogue: 0,0:54:46.15,0:54:47.95,Default,,0,0,0,,Бұл жігіт қоқыс.
Dialogue: 0,0:54:48.07,0:54:50.07,Default,,0,0,0,,(Мантидің күлкісі)
Dialogue: 0,0:54:50.20,0:54:53.95,Default,,0,0,0,,Жоқ! Мен қоқысқа айналмаймын!
Dialogue: 0,0:54:55.54,0:54:57.16,Default,,0,0,0,,(Мантылардың айқайы)
Dialogue: 0,0:54:59.71,0:55:01.71,Default,,0,0,0,,Ол қозғала бастады!
Dialogue: 0,0:55:06.59,0:55:11.72,Default,,0,0,0,,Мен тек Лилулудың айтқанын тыңдаймын! Пиё!
Dialogue: 0,0:55:14.06,0:55:15.39,Default,,0,0,0,,Уау
Dialogue: 0,0:55:15.52,0:55:16.98,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:55:20.35,0:55:21.65,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:55:21.77,0:55:24.40,Default,,0,0,0,,Бұл қиын (Манты 2) Не болып жатыр?
Dialogue: 0,0:55:24.52,0:55:26.78,Default,,0,0,0,,Дзю-дзюдо кенеттен зорлық-зомбылыққа айналды.
Dialogue: 0,0:55:26.90,0:55:29.40,Default,,0,0,0,,Не? кеттік
Dialogue: 0,0:55:34.28,0:55:36.20,Default,,0,0,0,,Барлығына! Нобита-кун!
Dialogue: 0,0:55:36.41,0:55:38.71,Default,,0,0,0,,Нобита! Ол тірі болды ма?
Dialogue: 0,0:55:38.83,0:55:41.21,Default,,0,0,0,,Сіз өзіңізді өлді деп ойладыңыз.
Dialogue: 0,0:55:41.33,0:55:42.17,Default,,0,0,0,,Хехехе
Dialogue: 0,0:55:42.29,0:55:43.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:44.13,0:55:45.92,Default,,0,0,0,,Пиппо Занда Кроссты жылжытады
Dialogue: 0,0:55:46.05,0:55:47.67,Default,,0,0,0,,Ол менің назарымды өзіне аударып отыр.
Dialogue: 0,0:55:47.80,0:55:50.22,Default,,0,0,0,,Пиппо? (Сунео) Тез қашайық.
Dialogue: 0,0:55:50.34,0:55:52.14,Default,,0,0,0,,Күзетші жоқ па? (Нобита) Иә
Dialogue: 0,0:55:52.76,0:55:54.89,Default,,0,0,0,,Құрсау арқылы өту
Dialogue: 0,0:55:55.10,0:55:57.64,Default,,0,0,0,,Йотто (Сунео) Йойшо
Dialogue: 0,0:55:58.02,0:55:59.89,Default,,0,0,0,,Нобита-сан!
Dialogue: 0,0:56:00.44,0:56:04.61,Default,,0,0,0,,Сізді уәдеңізден шығып, осында келуге мәжбүрлейтін бірдеңе болды ма?
Dialogue: 0,0:56:05.44,0:56:07.57,Default,,0,0,0,,Нобита-сан!
Dialogue: 0,0:56:08.32,0:56:10.78,Default,,0,0,0,,Не?
Dialogue: 0,0:56:13.03,0:56:14.78,Default,,0,0,0,,Дзюдо арғы тауда қимылдай бастаған сияқты.
Dialogue: 0,0:56:15.24,0:56:17.79,Default,,0,0,0,,Бұрынғы адамдармен туыссың ба?
Dialogue: 0,0:56:17.91,0:56:19.04,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:56:20.79,0:56:23.58,Default,,0,0,0,,Адам? Нобита-сан?
Dialogue: 0,0:56:32.68,0:56:33.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:33.84,0:56:35.89,Default,,0,0,0,,Рахмет, Занда Кросс
Dialogue: 0,0:56:36.01,0:56:38.77,Default,,0,0,0,,Уау (Сунео) Бұл Занда Кросс па?
Dialogue: 0,0:56:42.60,0:56:44.60,Default,,0,0,0,,Zanda Cross емес
Dialogue: 0,0:56:44.73,0:56:46.27,Default,,0,0,0,,Менің атым дзюдо
Dialogue: 0,0:56:47.57,0:56:50.94,Default,,0,0,0,,Пийо қарызын өтеді және енді жердегілермен жұмыс істемейді.
Dialogue: 0,0:56:51.57,0:56:53.95,Default,,0,0,0,,Мен Лилулуды іздеймін (барлығы) Иә!
Dialogue: 0,0:56:54.32,0:56:55.95,Default,,0,0,0,,Өйткені, ол жігіт өзін жаман сезінеді!
Dialogue: 0,0:56:56.07,0:56:57.83,Default,,0,0,0,,Пиппо Күтіңіз, о...
Dialogue: 0,0:56:57.95,0:57:02.12,Default,,0,0,0,,Жарайды, оны жайына қалдырайық! аздап!
Dialogue: 0,0:57:03.41,0:57:05.33,Default,,0,0,0,,Шағын жарық
Dialogue: 0,0:57:13.80,0:57:16.30,Default,,0,0,0,,Не болды?
Dialogue: 0,0:57:17.39,0:57:18.60,Default,,0,0,0,,Га
Dialogue: 0,0:57:19.39,0:57:21.98,Default,,0,0,0,,Цк, адам жоқ сияқты.
Dialogue: 0,0:57:22.10,0:57:23.85,Default,,0,0,0,,Дзюдомен айналысамыз ба? (Мантис 2)
Dialogue: 0,0:57:24.10,0:57:24.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:25.06,0:57:26.81,Default,,0,0,0,,Ах
Dialogue: 0,0:57:27.15,0:57:28.77,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:57:30.07,0:57:31.73,Default,,0,0,0,,Барайық (Мантис 2)
Dialogue: 0,0:57:36.74,0:57:38.99,Default,,0,0,0,,Онда біреу жерленген.
Dialogue: 0,0:57:39.28,0:57:40.66,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:57:42.66,0:57:48.33,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:57:52.63,0:57:53.59,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:57:53.72,0:57:57.51,Default,,0,0,0,,Әй, бұл адам өткен күні.
Dialogue: 0,0:57:58.85,0:57:59.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:02.93,0:58:04.35,Default,,0,0,0,,Робот
Dialogue: 0,0:58:06.06,0:58:08.10,Default,,0,0,0,,Лилулу!
Dialogue: 0,0:58:08.31,0:58:11.69,Default,,0,0,0,,Лилулу мен туралы білуі керек.
Dialogue: 0,0:58:11.98,0:58:13.49,Default,,0,0,0,,Пиппо!
Dialogue: 0,0:58:13.61,0:58:15.65,Default,,0,0,0,,Роботтар мүлде жоқ.
Dialogue: 0,0:58:16.28,0:58:19.66,Default,,0,0,0,,Ол барлау үшін баратынын айтты, сондықтан ол жақында оралады.
Dialogue: 0,0:58:19.78,0:58:21.08,Default,,0,0,0,,Тез қашайық
Dialogue: 0,0:58:21.20,0:58:23.87,Default,,0,0,0,,Лилулу, жауап бер. Бұл штаб.
Dialogue: 0,0:58:24.00,0:58:25.08,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:58:26.00,0:58:27.08,Default,,0,0,0,,Лилуру
Dialogue: 0,0:58:27.21,0:58:30.29,Default,,0,0,0,,Корпус Мехатопиядан ұшырылды.
Dialogue: 0,0:58:30.75,0:58:33.13,Default,,0,0,0,,Жерге ертең түнде келеді деп күтілуде
Dialogue: 0,0:58:33.25,0:58:34.76,Default,,0,0,0,,Лилулу, маған жол көрсет.
Dialogue: 0,0:58:34.92,0:58:36.55,Default,,0,0,0,,А, ертең түнде ме?
Dialogue: 0,0:58:36.67,0:58:38.26,Default,,0,0,0,,Не болса да, әлі ерте
Dialogue: 0,0:58:38.38,0:58:39.22,Default,,0,0,0,,Қашайық
Dialogue: 0,0:58:39.51,0:58:40.89,Default,,0,0,0,,О, Бас қолбасшы
Dialogue: 0,0:58:41.51,0:58:44.18,Default,,0,0,0,,Лилулу Неге жауап бермейсің?
Dialogue: 0,0:58:44.35,0:58:45.64,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:58:46.06,0:58:48.90,Default,,0,0,0,,Сіздің рөліңіз – Жерде база құру.
Dialogue: 0,0:58:49.02,0:58:51.81,Default,,0,0,0,,Теміршілер корпусына басшылық ету.
Dialogue: 0,0:58:52.15,0:58:53.86,Default,,0,0,0,,Өз миссияңызды орындаңыз
Dialogue: 0,0:58:56.32,0:58:58.32,Default,,0,0,0,,Бұл (3 адам) Иә?
Dialogue: 0,0:58:58.78,0:59:01.70,Default,,0,0,0,,Егер Лилуру Теміршілер корпусына басшылық етпесе
Dialogue: 0,0:59:01.82,0:59:05.08,Default,,0,0,0,,Олар не болып жатқанын білмейтін жер бетінде абдырап қалады.
Dialogue: 0,0:59:05.33,0:59:08.08,Default,,0,0,0,,Сол алшақтық біз үшін мүмкіндікке айналады.
Dialogue: 0,0:59:08.21,0:59:11.00,Default,,0,0,0,,Лилулу бұл жерге жақындауына жол берме.
Dialogue: 0,0:59:11.13,0:59:12.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:12.25,0:59:14.96,Default,,0,0,0,,Егер солай шешсек, тезірек бұл жерден кетейік.
Dialogue: 0,0:59:15.09,0:59:16.46,Default,,0,0,0,,Лилулу! (Барлығы) Ах!
Dialogue: 0,0:59:17.09,0:59:18.30,Default,,0,0,0,,Lil…
Dialogue: 0,0:59:18.97,0:59:20.18,Default,,0,0,0,,Лилулу!
Dialogue: 0,0:59:20.30,0:59:21.93,Default,,0,0,0,,Пиппо! (Сунео) Эй, сәл күте тұрыңыз.
Dialogue: 0,0:59:23.39,0:59:27.35,Default,,0,0,0,,Хмм, Лилулу, сен не істеп жатырсың?
Dialogue: 0,0:59:28.14,0:59:31.10,Default,,0,0,0,,Бас қолбасшы Қарсыласуға дайын
Dialogue: 0,0:59:31.23,0:59:32.06,Default,,0,0,0,,Иә
Dialogue: 0,0:59:32.44,0:59:35.69,Default,,0,0,0,,Мақсатты Жерді бұрмалауды бастау
Dialogue: 0,0:59:40.99,0:59:42.32,Default,,0,0,0,,Пиппо!
Dialogue: 0,0:59:43.32,0:59:45.49,Default,,0,0,0,,Лилулу Лилулу!
Dialogue: 0,0:59:45.62,0:59:46.45,Default,,0,0,0,,Сот…
Dialogue: 0,0:59:46.58,0:59:47.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:48.75,0:59:50.83,Default,,0,0,0,,Лилулу!
Dialogue: 0,0:59:51.46,0:59:52.83,Default,,0,0,0,,Сот…
Dialogue: 0,0:59:54.00,0:59:56.05,Default,,0,0,0,,Сіз кімге қоңырау шалып жатырсыз?
Dialogue: 0,0:59:56.30,0:59:58.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:58.17,1:00:00.76,Default,,0,0,0,,(шу)
Dialogue: 0,1:00:07.18,1:00:08.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:08.89,1:00:10.06,Default,,0,0,0,,Ха!
Dialogue: 0,1:00:11.39,1:00:13.48,Default,,0,0,0,,Жер тұрғындарының ашылуы Ха!
Dialogue: 0,1:00:13.61,1:00:16.44,Default,,0,0,0,,Ахх...
Dialogue: 0,1:00:16.57,1:00:17.90,Default,,0,0,0,,Уф...
Dialogue: 0,1:00:18.11,1:00:19.78,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,1:00:22.24,1:00:23.82,Default,,0,0,0,,Ха ха ха ха... Нобита-сан
Dialogue: 0,1:00:24.28,1:00:26.99,Default,,0,0,0,,Шизука-чан қорқынышты болды!
Dialogue: 0,1:00:28.24,1:00:30.00,Default,,0,0,0,,(Мейірбике 1) Ә? Неге бұл кішкентай ит тілім-шайыр шайнап отыр?
Dialogue: 0,1:00:30.12,1:00:33.17,Default,,0,0,0,,Лилулу! Лилулу!
Dialogue: 0,1:00:33.29,1:00:34.42,Default,,0,0,0,,Не?
Dialogue: 0,1:00:34.54,1:00:37.00,Default,,0,0,0,,Шизука-чан! барлығы!
Dialogue: 0,1:00:37.46,1:00:38.46,Default,,0,0,0,,Келдің бе?
Dialogue: 0,1:00:38.59,1:00:40.84,Default,,0,0,0,,Лилуру ше? Лилулу қайда?
Dialogue: 0,1:00:41.17,1:00:44.93,Default,,0,0,0,,Лилулу? Әй, бұл қыздың аты Лилулу.
Dialogue: 0,1:00:45.05,1:00:47.14,Default,,0,0,0,,Осы жолмен (Нобита) Рилу осында ма?
Dialogue: 0,1:00:47.26,1:00:49.06,Default,,0,0,0,,Қазір не болып жатыр?
Dialogue: 0,1:00:51.64,1:00:53.48,Default,,0,0,0,,Лилулу Лилуру
Dialogue: 0,1:00:53.65,1:00:55.48,Default,,0,0,0,,Бұл робот болды ма?
Dialogue: 0,1:00:55.61,1:00:58.94,Default,,0,0,0,,Ауыр жарақат алған... Жоқ, сынған сияқты.
Dialogue: 0,1:00:59.44,1:01:02.32,Default,,0,0,0,,Жауға жол көрсететін Рилур емес пе?
Dialogue: 0,1:01:02.45,1:01:04.41,Default,,0,0,0,,Бұл жағдайда оны толығымен жою керек.
Dialogue: 0,1:01:04.57,1:01:06.87,Default,,0,0,0,,Міне! қорқынышты нәрсе айтпа
Dialogue: 0,1:01:07.20,1:01:10.41,Default,,0,0,0,,Оны бұзу өкінішті болар еді.
Dialogue: 0,1:01:10.54,1:01:13.29,Default,,0,0,0,,Олар Жерді жаулап алуды жоспарлап отыр.
Dialogue: 0,1:01:13.41,1:01:14.58,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,1:01:15.04,1:01:16.83,Default,,0,0,0,,Бірақ егер сіз Lilulu түзетсеңіз
Dialogue: 0,1:01:16.96,1:01:20.55,Default,,0,0,0,,Мен Теміршілер корпусы туралы көп нәрсені біле аламын.
Dialogue: 0,1:01:21.30,1:01:22.38,Default,,0,0,0,,Жарайды, түзетейік!
Dialogue: 0,1:01:23.17,1:01:24.09,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,1:01:24.84,1:01:26.84,Default,,0,0,0,,Механикалық алғашқы көмек қобдишасы
Dialogue: 0,1:01:26.97,1:01:28.18,Default,,0,0,0,,Жай ғана дәрі қолданыңыз
Dialogue: 0,1:01:28.30,1:01:31.52,Default,,0,0,0,,Үзілген сымдарды және жетіспейтін бөлшектерді қалпына келтіріңіз.
Dialogue: 0,1:01:31.64,1:01:32.89,Default,,0,0,0,,Уақыт қажет, бірақ...
Dialogue: 0,1:01:33.02,1:01:34.06,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,1:01:34.31,1:01:35.73,Default,,0,0,0,,Барлығы бөлмеден шығады.
Dialogue: 0,1:01:35.85,1:01:38.69,Default,,0,0,0,,Робот болса да, қыз бала.
Dialogue: 0,1:01:38.90,1:01:41.44,Default,,0,0,0,,О? сен қызсың ба?
Dialogue: 0,1:01:41.57,1:01:42.82,Default,,0,0,0,,Бұл өте сүйкімді
Dialogue: 0,1:01:42.99,1:01:44.57,Default,,0,0,0,,Мені мазақ етпе
Dialogue: 0,1:01:44.70,1:01:46.78,Default,,0,0,0,,Мен Пиё адаммын
Dialogue: 0,1:01:47.32,1:01:48.20,Default,,0,0,0,,Содан кейін шығыңыз.
Dialogue: 0,1:01:48.32,1:01:49.74,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:01:49.87,1:01:51.91,Default,,0,0,0,,Сіз Лилулу үшін алаңдайсыз ба?
Dialogue: 0,1:01:52.37,1:01:55.08,Default,,0,0,0,,Уайымдама, мен саған міндетті түрде көмектесемін.
Dialogue: 0,1:01:55.75,1:01:56.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:57.83,1:01:59.84,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:01:59.96,1:02:01.92,Default,,0,0,0,,Мен сізге міндетті түрде көмектесемін
Dialogue: 0,1:02:04.22,1:02:07.01,Default,,0,0,0,,Біріншіден, мен денемдегі барлық балшықты алып тастауым керек.
Dialogue: 0,1:02:08.34,1:02:12.97,Default,,0,0,0,,Расында робот па? Ешқандай тыртық болмаса, сене алар емеспін
Dialogue: 0,1:02:13.43,1:02:17.31,Default,,0,0,0,,Бұл Жер тыңшысы ретінде күдік тудырмау үшін.
Dialogue: 0,1:02:26.82,1:02:29.57,Default,,0,0,0,,Менің қарным ашты хаха...
Dialogue: 0,1:02:29.70,1:02:31.20,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,1:02:31.33,1:02:33.33,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,1:02:33.45,1:02:34.62,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:02:34.75,1:02:37.54,Default,,0,0,0,,Ахахаха керемет
Dialogue: 0,1:02:37.67,1:02:39.63,Default,,0,0,0,,Супер?
Dialogue: 0,1:02:40.04,1:02:43.30,Default,,0,0,0,,Мен бірден тұтас ветчинаны жегім келді.
Dialogue: 0,1:02:43.50,1:02:47.26,Default,,0,0,0,,Мен сізге ең сапалы еттен стейк дайындаймын.
Dialogue: 0,1:02:47.47,1:02:51.22,Default,,0,0,0,,Рамен шыныаяқ рамен кесе рамен
Dialogue: 0,1:02:51.51,1:02:53.68,Default,,0,0,0,,Бәрі менікі!
Dialogue: 0,1:02:53.93,1:02:56.14,Default,,0,0,0,,Енді... енді жоқ…
Dialogue: 0,1:02:56.64,1:02:57.64,Default,,0,0,0,,Оқу мүмкін емес
Dialogue: 0,1:02:59.40,1:03:02.15,Default,,0,0,0,,Вахахаха Саған ұқсайды
Dialogue: 0,1:03:02.65,1:03:05.11,Default,,0,0,0,,Мен ондай ақымақ емеспін!
Dialogue: 0,1:03:05.40,1:03:07.32,Default,,0,0,0,,Көптеген жылдар бойы дәрігер болып—
Dialogue: 0,1:03:07.45,1:03:10.91,Default,,0,0,0,,Пиё салқынырақ құсқа айналды
Dialogue: 0,1:03:31.47,1:03:33.47,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:03:35.93,1:03:40.39,Default,,0,0,0,,Білмеймін, бұл жай ғана қыңырлық.
Dialogue: 0,1:03:46.69,1:03:47.90,Default,,0,0,0,,Мен... Уф
Dialogue: 0,1:03:48.03,1:03:49.99,Default,,0,0,0,,Жоқ, әлі оянба.
Dialogue: 0,1:03:50.11,1:03:51.36,Default,,0,0,0,,Менімен не істейсің?
Dialogue: 0,1:03:51.78,1:03:52.99,Default,,0,0,0,,Қорықпа.
Dialogue: 0,1:03:53.12,1:03:55.41,Default,,0,0,0,,Мен сені жақсы көремін, көмектесемін.
Dialogue: 0,1:03:55.54,1:03:57.70,Default,,0,0,0,,Анықтама? Неліктен?
Dialogue: 0,1:03:57.83,1:04:01.04,Default,,0,0,0,,Неге маған бәрібір, жалғыз қалдырсаң өлесің.
Dialogue: 0,1:04:01.17,1:04:04.17,Default,,0,0,0,,Сен өлесің бе? Бұл бұзылады дегенді білдіре ме?
Dialogue: 0,1:04:04.29,1:04:07.76,Default,,0,0,0,,Менің бұзылғанымның саған не қатысы бар?
Dialogue: 0,1:04:07.96,1:04:10.05,Default,,0,0,0,,Қатынасы жоқ...
Dialogue: 0,1:04:10.17,1:04:11.01,Default,,0,0,0,,Уф...
Dialogue: 0,1:04:11.13,1:04:12.55,Default,,0,0,0,,А, көп сөйлеме.
Dialogue: 0,1:04:12.68,1:04:15.26,Default,,0,0,0,,Қозғалсаң, жара жабылмайды.
Dialogue: 0,1:04:15.47,1:04:21.44,Default,,0,0,0,,Мен неге екенін түсінбеймін...
Dialogue: 0,1:04:25.40,1:04:27.23,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:04:27.94,1:04:30.82,Default,,0,0,0,,Ей, бұл тамақ!
Dialogue: 0,1:04:30.95,1:04:32.24,Default,,0,0,0,,Тамақ?
Dialogue: 0,1:04:32.66,1:04:34.49,Default,,0,0,0,,Итадакимасу
Dialogue: 0,1:04:34.78,1:04:36.41,Default,,0,0,0,,Әму!
Dialogue: 0,1:04:37.41,1:04:38.91,Default,,0,0,0,,дәмді дәмді
Dialogue: 0,1:04:39.04,1:04:40.66,Default,,0,0,0,,Керемет! (Нобита) Иә.
Dialogue: 0,1:04:40.83,1:04:43.17,Default,,0,0,0,,Хехехехе
Dialogue: 0,1:04:43.67,1:04:45.00,Default,,0,0,0,,А, музыка.
Dialogue: 0,1:04:45.13,1:04:49.09,Default,,0,0,0,,Ахаха
Dialogue: 0,1:04:49.21,1:04:55.22,Default,,0,0,0,,♪〜
Dialogue: 0,1:05:04.40,1:05:05.77,Default,,0,0,0,,Сот…
Dialogue: 0,1:05:10.36,1:05:11.74,Default,,0,0,0,,Сот…
Dialogue: 0,1:05:21.12,1:05:23.08,Default,,0,0,0,,Пиппо, не болды?
Dialogue: 0,1:05:23.21,1:05:24.04,Default,,0,0,0,,Ән айт
Dialogue: 0,1:05:24.17,1:05:25.37,Default,,0,0,0,,Сәлем Нобита
Dialogue: 0,1:05:25.50,1:05:28.29,Default,,0,0,0,,Менің іздегенім осы болды.
Dialogue: 0,1:05:29.17,1:05:33.17,Default,,0,0,0,,(Алпауыттардың шуы)
Dialogue: 0,1:05:37.97,1:05:43.98,Default,,0,0,0,,〜♪
Dialogue: 0,1:05:44.10,1:05:45.06,Default,,0,0,0,,Мен енді тамақ жей алмаймын
Dialogue: 0,1:05:45.56,1:05:48.52,Default,,0,0,0,,Жарайды, сенің дәріңнің уақыты келді, мен қайтайын.
Dialogue: 0,1:05:48.81,1:05:50.73,Default,,0,0,0,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,1:05:51.98,1:05:53.61,Default,,0,0,0,,Иә? Пиппо ше?
Dialogue: 0,1:05:53.74,1:05:55.36,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,1:05:55.49,1:05:57.87,Default,,0,0,0,,Пиппо да Лилулудың орнына бармады ма?
Dialogue: 0,1:05:57.99,1:06:00.58,Default,,0,0,0,,Лилулу бұзылды.
Dialogue: 0,1:06:00.70,1:06:02.91,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:06:03.04,1:06:04.66,Default,,0,0,0,,Бұл өте керемет (Нобита) Хаа…
Dialogue: 0,1:06:08.21,1:06:12.38,Default,,0,0,0,,Темір адам корпусы ертең түнде шабуыл жасайды.
Dialogue: 0,1:06:14.59,1:06:19.60,Default,,0,0,0,,Адамдар корпустың нағыз сұмдығын білмейді.
Dialogue: 0,1:06:21.72,1:06:24.56,Default,,0,0,0,,Өтінемін, оған жұмыстың барлық қырларын және басқа да барлық нәрсені үйретіңіз.
Dialogue: 0,1:06:25.18,1:06:27.65,Default,,0,0,0,,Дәріні ауыстырайық.
Dialogue: 0,1:06:29.77,1:06:34.07,Default,,0,0,0,,Керемет, жарада жұқа тері қабаты бар.
Dialogue: 0,1:06:34.19,1:06:37.03,Default,,0,0,0,,Маған көмектескеніңізге өкінесіз
Dialogue: 0,1:06:37.15,1:06:41.74,Default,,0,0,0,,Жақында Темір адам корпусы келеді және жердегі аң аулау басталады.
Dialogue: 0,1:06:41.87,1:06:44.91,Default,,0,0,0,,Жер тұрғындарын ұстау арқылы не істейміз?
Dialogue: 0,1:06:45.25,1:06:47.33,Default,,0,0,0,,Мен сені Мехатопияға апарамын.
Dialogue: 0,1:06:47.46,1:06:49.13,Default,,0,0,0,,Құл болып жұмыс істеу
Dialogue: 0,1:06:49.25,1:06:50.08,Default,,0,0,0,,Құл?
Dialogue: 0,1:06:50.50,1:06:52.71,Default,,0,0,0,,Адамдар сияқты төменгі тіршілік иелері
Dialogue: 0,1:06:52.84,1:06:56.42,Default,,0,0,0,,Бізді басқаратын роботтар үшін жұмыс істеу табиғи емес пе?
Dialogue: 0,1:06:56.55,1:06:59.68,Default,,0,0,0,,Бұл Құдайдың тағдыры.
Dialogue: 0,1:06:59.80,1:07:02.10,Default,,0,0,0,,Роботтарды адамдар жасайды, солай ма?
Dialogue: 0,1:07:02.22,1:07:03.60,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,1:07:05.64,1:07:09.98,Default,,0,0,0,,Ертеде, Жер тұрғындары дүниеге келмей тұрып
Dialogue: 0,1:07:10.10,1:07:13.73,Default,,0,0,0,,Галактикадан тыс өркендеген адамдар болды.
Dialogue: 0,1:07:13.86,1:07:17.53,Default,,0,0,0,,Бірақ Құдай бұл адамдарды тастап кетті.
Dialogue: 0,1:07:17.90,1:07:22.45,Default,,0,0,0,,Өзімшіл, сараң, бірін-бірі жек көріп, өлтіретін...
Dialogue: 0,1:07:23.28,1:07:25.62,Default,,0,0,0,,Құдай елсіз планетаға қонды
Dialogue: 0,1:07:25.75,1:07:29.08,Default,,0,0,0,,Олар Ам және Им деп аталатын роботтарды жасап, бұл туралы айтты.
Dialogue: 0,1:07:29.62,1:07:33.29,Default,,0,0,0,,«Өздеріңмен аспан сияқты әлемді жасаңдар».
Dialogue: 0,1:07:34.13,1:07:37.88,Default,,0,0,0,,Ам мен Им робот ұрпақтарын жасау үшін көп еңбек етті.
Dialogue: 0,1:07:38.01,1:07:41.64,Default,,0,0,0,,Содан кейін адамдар жойылып, роботтар өркендеді.
Dialogue: 0,1:07:41.76,1:07:47.14,Default,,0,0,0,,Уақыт өте келе қоғамда билеуші ​​саналған адам пайда болды.
Dialogue: 0,1:07:47.39,1:07:51.65,Default,,0,0,0,,Дворяндар мен бай роботтар құл роботтарын пайдалана бастады.
Dialogue: 0,1:07:52.10,1:07:53.56,Default,,0,0,0,,Бірақ қазіргі заманда
Dialogue: 0,1:07:53.69,1:07:56.65,Default,,0,0,0,,Барлық роботтар бірдей таралады деген идея
Dialogue: 0,1:07:56.78,1:07:59.53,Default,,0,0,0,,Құл роботтары ақыры босатылды.
Dialogue: 0,1:08:00.28,1:08:04.83,Default,,0,0,0,,-да біз адамдарды жаңа жұмыс күші ретінде пайдалануды шештік.
Dialogue: 0,1:08:05.20,1:08:06.08,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,1:08:06.24,1:08:08.00,Default,,0,0,0,,Роботтар – Құдайдың балалары
Dialogue: 0,1:08:08.12,1:08:10.58,Default,,0,0,0,,Әлем роботтарға арналған
Dialogue: 0,1:08:11.04,1:08:14.00,Default,,0,0,0,,Адамзат тарихы қайталанып жатқандай.
Dialogue: 0,1:08:14.75,1:08:17.21,Default,,0,0,0,,Құдайдың да көңілі қалған болуы керек.
Dialogue: 0,1:08:17.42,1:08:18.63,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,1:08:18.76,1:08:21.47,Default,,0,0,0,,Роботтар адамдарға еліктей ме?
Dialogue: 0,1:08:21.59,1:08:22.43,Default,,0,0,0,,Болдырмау
Dialogue: 0,1:08:22.55,1:08:24.85,Default,,0,0,0,,Жоқ, қазір қозғалсам, жараланып қаламын...
Dialogue: 0,1:08:25.18,1:08:26.14,Default,,0,0,0,,Бас тарту!
Dialogue: 0,1:08:26.35,1:08:27.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:28.10,1:08:28.97,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:29.14,1:08:30.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:30.48,1:08:31.85,Default,,0,0,0,,Қақпақ
Dialogue: 0,1:08:34.31,1:08:35.98,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:39.78,1:08:41.99,Default,,0,0,0,,Мен сені енді танымаймын да!
Dialogue: 0,1:08:42.45,1:08:45.41,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:08:51.16,1:08:53.92,Default,,0,0,0,,Өздігінен бұзылса жақсы.
Dialogue: 0,1:08:56.13,1:09:00.38,Default,,0,0,0,,Өйткені роботтар адамның сезімін түсіне алмайды, солай ма?
Dialogue: 0,1:09:05.09,1:09:06.35,Default,,0,0,0,,Ах
Dialogue: 0,1:09:17.06,1:09:18.65,Default,,0,0,0,,Жылама
Dialogue: 0,1:09:42.76,1:09:43.59,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:47.26,1:09:51.02,Default,,0,0,0,,Мен бұл нені білдіретінін түсінбеймін. Олар осындай нәрсе жасады ...
Dialogue: 0,1:09:51.77,1:09:53.52,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,1:09:53.64,1:09:57.65,Default,,0,0,0,,Адамдар тез қолға түсіп, құл болу керек.
Dialogue: 0,1:09:57.77,1:09:59.52,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,1:09:59.65,1:10:00.48,Default,,0,0,0,,Юд?
Dialogue: 0,1:10:00.77,1:10:05.86,Default,,0,0,0,,Не? Иә, менің атым дзюдо
Dialogue: 0,1:10:05.99,1:10:07.78,Default,,0,0,0,,Бұл Пиппо...
Dialogue: 0,1:10:08.45,1:10:10.12,Default,,0,0,0,,Сәлем Лилулу
Dialogue: 0,1:10:11.33,1:10:15.41,Default,,0,0,0,,Жерден көрінетін жұлдыздар сондай әдемі
Dialogue: 0,1:10:15.75,1:10:19.46,Default,,0,0,0,,Бұл Мехатопиядан көрінетін жұлдыздармен бірдей.
Dialogue: 0,1:10:20.04,1:10:21.80,Default,,0,0,0,,СМАШ АҚШ-ы!
Dialogue: 0,1:10:22.09,1:10:23.09,Default,,0,0,0,,Лилуру
Dialogue: 0,1:10:23.59,1:10:27.43,Default,,0,0,0,,Адамдар шынымен жаман жаратылыс па?
Dialogue: 0,1:10:27.64,1:10:30.80,Default,,0,0,0,,Мүмкін адамдар да біз сияқты шығар...
Dialogue: 0,1:10:30.93,1:10:32.56,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,1:10:32.68,1:10:35.27,Default,,0,0,0,,Өз миссияңызды ұмыттыңыз ба?
Dialogue: 0,1:10:35.85,1:10:39.65,Default,,0,0,0,,Бірақ... Бірақ мен оны түсіндім.
Dialogue: 0,1:10:39.77,1:10:42.27,Default,,0,0,0,,Лилулу маған көмектесті...
Dialogue: 0,1:10:42.40,1:10:43.40,Default,,0,0,0,,Тоқта
Dialogue: 0,1:10:43.53,1:10:46.65,Default,,0,0,0,,Бұл сізге көмектескен жай ғана қалау болды.
Dialogue: 0,1:10:46.78,1:10:48.95,Default,,0,0,0,,Мұның мағынасы жоқ
Dialogue: 0,1:10:52.24,1:10:53.54,Default,,0,0,0,,Бұл нені білдіреді...
Dialogue: 0,1:10:55.08,1:10:58.54,Default,,0,0,0,,Лилулу жауабы
Dialogue: 0,1:10:58.67,1:11:00.00,Default,,0,0,0,,Лилулу
Dialogue: 0,1:11:06.72,1:11:10.89,Default,,0,0,0,,Пиппоның жігіті қайтып келмеді.
Dialogue: 0,1:11:11.01,1:11:12.30,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:11:12.43,1:11:14.97,Default,,0,0,0,,Ол тіпті Лилулудың үйіне де барған жоқ.
Dialogue: 0,1:11:15.43,1:11:18.56,Default,,0,0,0,,Мен Пиппоны табуым керек. Маған бірнеше құралдар әкел.
Dialogue: 0,1:11:18.69,1:11:19.98,Default,,0,0,0,,А, бұл дұрыс...
Dialogue: 0,1:11:20.85,1:11:22.40,Default,,0,0,0,,Телефото магниті
Dialogue: 0,1:11:23.15,1:11:24.90,Default,,0,0,0,,Телефото магнит?
Dialogue: 0,1:11:25.23,1:11:29.24,Default,,0,0,0,,Бұл құрал сіз іздеген адамды немесе затты табу үшін телескопты пайдаланады.
Dialogue: 0,1:11:29.36,1:11:32.20,Default,,0,0,0,,Оны магнитпен тартуға болады.
Dialogue: 0,1:11:32.32,1:11:33.33,Default,,0,0,0,,Иә
Dialogue: 0,1:11:36.37,1:11:38.50,Default,,0,0,0,,Сіз магниттің солтүстік полюсісіз
Dialogue: 0,1:11:38.62,1:11:41.29,Default,,0,0,0,,ішінен осы телескоппен Pippo іздеңіз
Dialogue: 0,1:11:41.42,1:11:42.79,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,1:11:42.92,1:11:44.75,Default,,0,0,0,,Дәл осы кең әлемде
Dialogue: 0,1:11:44.88,1:11:47.80,Default,,0,0,0,,Пиппо табу жағажайда күнжіт тұқымын іздегеннен жақсы...
Dialogue: 0,1:11:47.92,1:11:49.80,Default,,0,0,0,,Не? сонда болды!
Dialogue: 0,1:11:49.93,1:11:52.26,Default,,0,0,0,,Е! Триггерді тартыңыз!
Dialogue: 0,1:11:55.47,1:11:56.89,Default,,0,0,0,,Пиё!
Dialogue: 0,1:11:57.27,1:11:58.60,Default,,0,0,0,,Иә!
Dialogue: 0,1:11:58.73,1:12:01.60,Default,,0,0,0,,Пиё... Иә? Не?
Dialogue: 0,1:12:01.73,1:12:02.56,Default,,0,0,0,,Пиё?
Dialogue: 0,1:12:02.86,1:12:04.02,Default,,0,0,0,,Ой!
Dialogue: 0,1:12:04.15,1:12:05.52,Default,,0,0,0,,(Пиппоның айқайы)
Dialogue: 0,1:12:05.82,1:12:07.28,Default,,0,0,0,,Тартылды!
Dialogue: 0,1:12:08.49,1:12:09.32,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:12:10.24,1:12:12.78,Default,,0,0,0,,Е! Апыр-ай!
Dialogue: 0,1:12:14.07,1:12:16.54,Default,,0,0,0,,Ittetete... Амансың ба?
Dialogue: 0,1:12:17.08,1:12:18.70,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:12:19.71,1:12:21.17,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:22.00,1:12:25.17,Default,,0,0,0,,Иә? Бұл не? Т...
Dialogue: 0,1:12:25.79,1:12:27.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:12:27.50,1:12:30.63,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,1:12:30.97,1:12:33.05,Default,,0,0,0,,Магнит күші мен ойлағаннан да күшті.
Dialogue: 0,1:12:33.18,1:12:36.89,Default,,0,0,0,,(Дораэмонның ауыр дауысы)
Dialogue: 0,1:12:37.01,1:12:38.60,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:38.89,1:12:40.02,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:12:40.14,1:12:41.19,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,1:12:41.31,1:12:45.40,Default,,0,0,0,,Әсері 10 сағатта жойылады, сондықтан оны біраз уақытқа қалдырыңыз.
Dialogue: 0,1:12:45.56,1:12:47.11,Default,,0,0,0,,Е! Пиё!
Dialogue: 0,1:12:47.44,1:12:50.74,Default,,0,0,0,,Дәл осы қажетсіз нәрсені не үшін істедің?
Dialogue: 0,1:12:50.86,1:12:53.32,Default,,0,0,0,,Себебі мен уайымдадым.
Dialogue: 0,1:12:53.61,1:12:59.16,Default,,0,0,0,,А... неге уайымдап тұрсың?
Dialogue: 0,1:12:59.79,1:13:01.37,Default,,0,0,0,,Төтенше жиналыс!
Dialogue: 0,1:13:01.96,1:13:04.00,Default,,0,0,0,,Иә? Пиппо, қайтып келдің бе?
Dialogue: 0,1:13:04.12,1:13:06.34,Default,,0,0,0,,Ахахха Бұл не басы?
Dialogue: 0,1:13:06.54,1:13:08.59,Default,,0,0,0,,Жоқ, өте сүйкімді
Dialogue: 0,1:13:08.88,1:13:10.59,Default,,0,0,0,,Эххе, кешіріңіз.
Dialogue: 0,1:13:11.47,1:13:13.97,Default,,0,0,0,,стратегияны түсіндіреді
Dialogue: 0,1:13:14.13,1:13:19.60,Default,,0,0,0,,Оған дейін... Пиппо, сен бізге жаусың ба? Одақтас па?
Dialogue: 0,1:13:19.85,1:13:22.64,Default,,0,0,0,,Ешқандай емес, мен Лилулу жағындамын.
Dialogue: 0,1:13:22.98,1:13:24.73,Default,,0,0,0,,Лилуру ше?
Dialogue: 0,1:13:25.27,1:13:28.07,Default,,0,0,0,,Ол мен жақта емес сияқты...
Dialogue: 0,1:13:28.19,1:13:29.44,Default,,0,0,0,,Құлақ таспасы
Dialogue: 0,1:13:29.90,1:13:33.15,Default,,0,0,0,,Лилулу жоспарды ұсынса, жаман болар еді.
Dialogue: 0,1:13:34.28,1:13:35.36,Default,,0,0,0,,Пиппоның ақымақ
Dialogue: 0,1:13:35.49,1:13:36.95,Default,,0,0,0,,Иә? Мен естімеймін
Dialogue: 0,1:13:37.57,1:13:38.95,Default,,0,0,0,,Пиппоның Чиби
Dialogue: 0,1:13:39.08,1:13:40.83,Default,,0,0,0,,Пиё жаман нәрсе айтып тұр.
Dialogue: 0,1:13:40.95,1:13:42.25,Default,,0,0,0,,Мен айтқан жоқпын, айтқан жоқпын
Dialogue: 0,1:13:42.37,1:13:44.08,Default,,0,0,0,,Оны Чинчукурин деп атама.
Dialogue: 0,1:13:44.21,1:13:45.37,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,1:13:45.50,1:13:47.38,Default,,0,0,0,,Мен қыз емеспін!
Dialogue: 0,1:13:47.50,1:13:49.25,Default,,0,0,0,,О, сен уайымдадың ба?
Dialogue: 0,1:13:49.59,1:13:51.34,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:13:52.21,1:13:53.76,Default,,0,0,0,,Сонымен стратегия дегеніміз не?
Dialogue: 0,1:13:53.88,1:13:56.72,Default,,0,0,0,,Иә, өткен күні барған үлкен көл.
Dialogue: 0,1:13:56.84,1:13:59.56,Default,,0,0,0,,Кері әлемге кіріп, сол жерге май құйыңыз.
Dialogue: 0,1:13:59.68,1:14:01.77,Default,,0,0,0,,Үлкен есік жасаңыз
Dialogue: 0,1:14:01.89,1:14:05.60,Default,,0,0,0,,Сол жерден Темір адам корпусын айна әлеміне тартыңыз.
Dialogue: 0,1:14:05.73,1:14:07.69,Default,,0,0,0,,Теміршілер корпусының барлығы?
Dialogue: 0,1:14:07.81,1:14:11.36,Default,,0,0,0,,Бұл дүниеде қанша қираса да, жарайды.
Dialogue: 0,1:14:11.48,1:14:13.86,Default,,0,0,0,,Олар жалғыз күрессін
Dialogue: 0,1:14:13.99,1:14:16.20,Default,,0,0,0,,Бірақ сіз оларды қалай тартасыз?
Dialogue: 0,1:14:16.32,1:14:18.70,Default,,0,0,0,,Пиппо бөлшектерді жинауға сигнал берді, солай ма?
Dialogue: 0,1:14:18.82,1:14:20.83,Default,,0,0,0,,Қандай ұят!
Dialogue: 0,1:14:20.95,1:14:23.29,Default,,0,0,0,,Сол сигналды көлден жібер
Dialogue: 0,1:14:23.41,1:14:24.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:14:24.75,1:14:27.71,Default,,0,0,0,,Бірақ Лилулу кедергі келтірсе жаман болар еді.
Dialogue: 0,1:14:27.83,1:14:29.29,Default,,0,0,0,,Қазір өзіңізді қалай сезінесіз?
Dialogue: 0,1:14:29.42,1:14:31.09,Default,,0,0,0,,Барған сайын жақсарып келеді.
Dialogue: 0,1:14:31.21,1:14:32.09,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:33.17,1:14:34.55,Default,,0,0,0,,Маған мұны ішуге рұқсат етіңіз
Dialogue: 0,1:14:34.67,1:14:36.97,Default,,0,0,0,,Маған 24 сағат ұйықтауға рұқсат етіңіз.
Dialogue: 0,1:14:37.09,1:14:38.26,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:14:38.39,1:14:41.51,Default,,0,0,0,,Мен сенің ұйықтағаныңды қалаймын, иә...
Dialogue: 0,1:14:41.68,1:14:44.31,Default,,0,0,0,,Джан мен Сунео қаланы бақылауды сұрайды.
Dialogue: 0,1:14:44.43,1:14:45.60,Default,,0,0,0,,О!
Dialogue: 0,1:14:48.44,1:14:49.73,Default,,0,0,0,,Уау, керемет
Dialogue: 0,1:14:50.06,1:14:52.11,Default,,0,0,0,,Жара толығымен жабылған.
Dialogue: 0,1:14:52.23,1:14:54.40,Default,,0,0,0,,Маған енді дәрі керек емес, хехе.
Dialogue: 0,1:14:54.53,1:14:57.20,Default,,0,0,0,,Менің кез келген киімімді өзіңе ұнаған киюге болады.
Dialogue: 0,1:14:57.74,1:15:00.49,Default,,0,0,0,,Қайсысы жақсы? Кез келген жақсы.
Dialogue: 0,1:15:01.07,1:15:02.83,Default,,0,0,0,,Мен қайсысын таңдауым керек?
Dialogue: 0,1:15:02.95,1:15:07.00,Default,,0,0,0,,Лилулу маған көмектесті...
Dialogue: 0,1:15:07.66,1:15:09.96,Default,,0,0,0,,Әдемі емес пе? Ол саған ұнады ма?
Dialogue: 0,1:15:10.08,1:15:12.38,Default,,0,0,0,,Маған қызық емес...
Dialogue: 0,1:15:12.88,1:15:16.34,Default,,0,0,0,,Эй, мынаны киіп көріңіз. Иә, сәттілік.
Dialogue: 0,1:15:16.47,1:15:18.88,Default,,0,0,0,,Хмм, мен оны өзім кие аламын.
Dialogue: 0,1:15:21.05,1:15:22.26,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,1:15:22.89,1:15:26.23,Default,,0,0,0,,Уау, сондай сүйкімді!
Dialogue: 0,1:15:27.14,1:15:29.35,Default,,0,0,0,,Бірақ әлі қозғалма.
Dialogue: 0,1:15:29.48,1:15:32.48,Default,,0,0,0,,Жазылғалы тұрған жара ашылады.
Dialogue: 0,1:15:32.86,1:15:35.48,Default,,0,0,0,,Мен адамдардың не істейтінін түсінбеймін
Dialogue: 0,1:15:35.61,1:15:37.24,Default,,0,0,0,,Неліктен жауға көмектесу керек?
Dialogue: 0,1:15:37.78,1:15:39.86,Default,,0,0,0,,Кейде біз мағынасы жоқ нәрселерді жасаймыз.
Dialogue: 0,1:15:39.99,1:15:41.49,Default,,0,0,0,,Ол адам.
Dialogue: 0,1:15:41.74,1:15:43.66,Default,,0,0,0,,Енді мынаны іш.
Dialogue: 0,1:15:43.78,1:15:46.79,Default,,0,0,0,,Егер демалсаңыз, өзіңізді әлдеқайда жақсы сезінесіз.
Dialogue: 0,1:15:49.33,1:15:51.00,Default,,0,0,0,,Лас қуыршақ
Dialogue: 0,1:15:51.12,1:15:55.46,Default,,0,0,0,,Уфуфу Бірақ мен өзімді жалғыз сезіндім.
Dialogue: 0,1:15:55.59,1:15:59.26,Default,,0,0,0,,Қуыршақ өзін жалғыз сезінуі мүмкін емес.
Dialogue: 0,1:15:59.55,1:16:01.22,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,1:16:01.34,1:16:05.22,Default,,0,0,0,,Қуыршақтардың да жүрегі бар екеніне сенімдімін.
Dialogue: 0,1:16:07.35,1:16:09.48,Default,,0,0,0,,Сіз әлі ұйықтап қалдыңыз ба?
Dialogue: 0,1:16:12.56,1:16:13.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:21.53,1:16:24.95,Default,,0,0,0,,Кешіріңіз, біраз ұйықтаңыз.
Dialogue: 0,1:16:29.12,1:16:32.21,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:16:37.17,1:16:40.63,Default,,0,0,0,,Ой, май тез тарап жатыр.
Dialogue: 0,1:16:40.76,1:16:42.38,Default,,0,0,0,,Сен не істеп жатырсың?
Dialogue: 0,1:16:42.51,1:16:44.30,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,1:16:44.47,1:16:45.76,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,1:16:46.39,1:16:48.02,Default,,0,0,0,,Иә? Уау
Dialogue: 0,1:16:48.14,1:16:51.69,Default,,0,0,0,,Дораэмон жылдам жабысатын тапаншасы өте тиімді
Dialogue: 0,1:16:51.81,1:16:53.94,Default,,0,0,0,,(тон)
Dialogue: 0,1:16:54.48,1:16:58.36,Default,,0,0,0,,Хмм... Менің шақыруымды қабылдай ма екен?
Dialogue: 0,1:16:58.98,1:17:01.40,Default,,0,0,0,,Мен қалаға бірдеңе істеуге бара жатырмын.
Dialogue: 0,1:17:01.53,1:17:02.86,Default,,0,0,0,,Көлге қарау
Dialogue: 0,1:17:02.99,1:17:03.82,Default,,0,0,0,,Иә
Dialogue: 0,1:17:03.95,1:17:05.99,Default,,0,0,0,,Пиппо да осында.
Dialogue: 0,1:17:06.12,1:17:10.41,Default,,0,0,0,,Кеткім келсе де, кете алмаймын!
Dialogue: 0,1:17:10.54,1:17:11.83,Default,,0,0,0,,Уау!
Dialogue: 0,1:17:12.66,1:17:15.46,Default,,0,0,0,,Күшінің мерзімі аяқталды.
Dialogue: 0,1:17:15.58,1:17:16.92,Default,,0,0,0,,Хмм...
Dialogue: 0,1:17:42.24,1:17:46.20,Default,,0,0,0,,Тірі заттарсыз әлем қорқынышты, солай емес пе?
Dialogue: 0,1:17:46.32,1:17:48.12,Default,,0,0,0,,Бұл көрініс
Dialogue: 0,1:17:48.24,1:17:49.58,Default,,0,0,0,,Нобита қорқады
Dialogue: 0,1:17:49.70,1:17:51.16,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,1:17:51.29,1:17:53.00,Default,,0,0,0,,Жоқ, мен қорқамын.
Dialogue: 0,1:17:53.12,1:17:57.13,Default,,0,0,0,,Мүлдем жоқ! Мен қорықпаймын!
Dialogue: 0,1:17:57.25,1:18:00.63,Default,,0,0,0,,Нобита қорқады Яй Яй
Dialogue: 0,1:18:00.75,1:18:02.05,Default,,0,0,0,,Не! Иә...
Dialogue: 0,1:18:02.34,1:18:03.55,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,1:18:03.67,1:18:05.84,Default,,0,0,0,,Не, не, не, не, не, не?
Dialogue: 0,1:18:05.97,1:18:07.84,Default,,0,0,0,,(Нобитаның күлкісі)
Dialogue: 0,1:18:07.97,1:18:11.10,Default,,0,0,0,,Пиппо әлдеқайда қорқады емес пе?
Dialogue: 0,1:18:11.22,1:18:13.73,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:18:13.85,1:18:16.56,Default,,0,0,0,,О, мен таң қалдым! Мен қорықпаймын!
Dialogue: 0,1:18:17.31,1:18:19.61,Default,,0,0,0,,Жоқ, мен қатты қорықтым.
Dialogue: 0,1:18:19.73,1:18:20.98,Default,,0,0,0,,Мүлдем жоқ!
Dialogue: 0,1:18:21.11,1:18:25.15,Default,,0,0,0,,Егер ол басқаша болмаса, ол басқаша емес. Пиппо қорқады.
Dialogue: 0,1:18:25.28,1:18:28.28,Default,,0,0,0,,Уау, енді күлетін кез.
Dialogue: 0,1:18:28.41,1:18:29.99,Default,,0,0,0,,Теміршілер корпусы келгенде
Dialogue: 0,1:18:30.12,1:18:33.54,Default,,0,0,0,,Балалар, тез жынды боласыңдар.
Dialogue: 0,1:18:33.66,1:18:37.92,Default,,0,0,0,,Мен бастапқы денеме оралсам да, сіз мета-мета боласыз.
Dialogue: 0,1:18:38.04,1:18:39.63,Default,,0,0,0,,Сен жыладың ба білмеймін
Dialogue: 0,1:18:39.75,1:18:43.76,Default,,0,0,0,,Әй, кешірім сұрасаң да, мен сені кешірмеймін!
Dialogue: 0,1:18:43.88,1:18:46.88,Default,,0,0,0,,(Пиппоның ауыр тыныс алуы)
Dialogue: 0,1:18:48.43,1:18:53.10,Default,,0,0,0,,Мен Пиппомен соғысқым келмейді.
Dialogue: 0,1:18:53.77,1:18:56.73,Default,,0,0,0,,Иә? Уф...
Dialogue: 0,1:19:02.77,1:19:04.36,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:05.74,1:19:10.28,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:19:10.41,1:19:11.53,Default,,0,0,0,,Пиппо…
Dialogue: 0,1:19:27.34,1:19:30.01,Default,,0,0,0,,Эй, роботтар енді пайда болмайды.
Dialogue: 0,1:19:30.39,1:19:32.30,Default,,0,0,0,,Мен оларды көп ұрдым.
Dialogue: 0,1:19:32.43,1:19:33.47,Default,,0,0,0,,Шизука-чан ше?
Dialogue: 0,1:19:33.81,1:19:36.43,Default,,0,0,0,,Мен кешкі асқа ингредиенттерді дайындау үшін супермаркетке бардым.
Dialogue: 0,1:19:42.15,1:19:45.90,Default,,0,0,0,,Мен де Нобитамен төбелескім келмейді.
Dialogue: 0,1:19:46.03,1:19:47.07,Default,,0,0,0,,Иә
Dialogue: 0,1:19:47.36,1:19:51.24,Default,,0,0,0,,Бұл сезімді Лилуруға да жеткізгім келеді.
Dialogue: 0,1:19:51.45,1:19:53.78,Default,,0,0,0,,Мен оларға қоңырау шалсам, олар жауап бермейді.
Dialogue: 0,1:19:53.91,1:19:55.95,Default,,0,0,0,,Бір-бірімізден алшақ болсақ та сөйлесе аламыз ба?
Dialogue: 0,1:19:56.37,1:20:01.21,Default,,0,0,0,,Иә, менің ішімде Лилурудың бір бөлігі бар.
Dialogue: 0,1:20:01.33,1:20:06.80,Default,,0,0,0,,Бірақ содан бері менің жүрегім жабық.
Dialogue: 0,1:20:08.01,1:20:13.14,Default,,0,0,0,,Мен Лилулу менің сезгенімді сезінгенін қалаймын.
Dialogue: 0,1:20:18.98,1:20:19.81,Default,,0,0,0,,Бұл жерде!
Dialogue: 0,1:20:23.36,1:20:24.98,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,1:20:33.45,1:20:35.08,Default,,0,0,0,,Жасыру! Апыр-ай!
Dialogue: 0,1:20:36.99,1:20:40.00,Default,,0,0,0,,Уау, бұл үлкен сан.
Dialogue: 0,1:20:40.37,1:20:42.46,Default,,0,0,0,,Бұл Жер ме?
Dialogue: 0,1:20:42.58,1:20:47.46,Default,,0,0,0,,Алдымен үлкен қаланы қиратып, жердегілерді дүр сілкіндір.
Dialogue: 0,1:20:47.59,1:20:49.84,Default,,0,0,0,,Содан кейін құл аулауды бастаңыз
Dialogue: 0,1:20:50.97,1:20:53.18,Default,,0,0,0,,Барлық әскерлер алға жылжиды!
Dialogue: 0,1:20:54.26,1:20:58.14,Default,,0,0,0,,Тыңда, тыңда... Келді, келді, келді!
Dialogue: 0,1:20:58.56,1:21:00.81,Default,,0,0,0,,Робоборобо... Робот!
Dialogue: 0,1:21:00.93,1:21:03.40,Default,,0,0,0,,Аспанды роботтар толтырады!
Dialogue: 0,1:21:03.56,1:21:05.48,Default,,0,0,0,,Көремін, Дораемон және т.б
Dialogue: 0,1:21:05.61,1:21:07.82,Default,,0,0,0,,Мен сені бұл дүниеге сәтті тарттым.
Dialogue: 0,1:21:07.94,1:21:11.86,Default,,0,0,0,,Дұрыс, бұл берекелі және қорқынышты...
Dialogue: 0,1:21:11.99,1:21:12.82,Default,,0,0,0,,Ах
Dialogue: 0,1:21:12.95,1:21:14.03,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:21:14.70,1:21:17.28,Default,,0,0,0,,Темір адам корпусы қала орталығына қарай бет алды.
Dialogue: 0,1:21:17.58,1:21:20.95,Default,,0,0,0,,Мен солай деп ойладым...
Dialogue: 0,1:21:30.88,1:21:33.30,Default,,0,0,0,,Жердегілер тойтарыс берді.
Dialogue: 0,1:21:34.09,1:21:34.93,Default,,0,0,0,,Сол ғимарат.
Dialogue: 0,1:21:47.15,1:21:49.57,Default,,0,0,0,,Ешкім жоқ па? Бұл ақымақ
Dialogue: 0,1:21:49.69,1:21:51.78,Default,,0,0,0,,Ол соншалықты зорлықпен қарсылық көрсеткен жоқ па?
Dialogue: 0,1:21:52.28,1:21:53.19,Default,,0,0,0,,Сіз баяусыз! (Командирдің орынбасары) Уау...
Dialogue: 0,1:21:53.57,1:21:54.40,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,1:21:55.24,1:21:58.24,Default,,0,0,0,,Адамдар дірілдеп, сыртқа секіргенше.
Dialogue: 0,1:21:58.37,1:22:02.04,Default,,0,0,0,,Оны толығымен жойыңыз!
Dialogue: 0,1:22:03.50,1:22:05.25,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,1:22:05.37,1:22:07.92,Default,,0,0,0,,Жер бетінде корпуспен кім соғысып жатыр?
Dialogue: 0,1:22:08.42,1:22:11.50,Default,,0,0,0,,Жарайды, механизмді ашайық.
Dialogue: 0,1:22:12.01,1:22:14.22,Default,,0,0,0,,Жақсартылған Ямабикояма
Dialogue: 0,1:22:14.63,1:22:16.43,Default,,0,0,0,,Бұл тек дыбысқа қатысты емес
Dialogue: 0,1:22:16.55,1:22:19.68,Default,,0,0,0,,Жарық пен жарылыс толқындарына жауап беріп, жаңғырық қайтарады.
Dialogue: 0,1:22:20.22,1:22:23.64,Default,,0,0,0,,Зорлық-зомбылық шабуылы зорлық-зомбылықты қайтара ма?
Dialogue: 0,1:22:24.18,1:22:28.98,Default,,0,0,0,,Темір адам корпусы ешкім болмаса да, қатты күресіп жатыр.
Dialogue: 0,1:22:29.44,1:22:33.19,Default,,0,0,0,,Әй, егер Пиппо менен сұраса жаман болар еді...
Dialogue: 0,1:22:33.32,1:22:36.45,Default,,0,0,0,,Жарайды, біз доспыз (Сунео/Джиан), иә?
Dialogue: 0,1:22:36.99,1:22:40.37,Default,,0,0,0,,Нобита мұны рұқсатсыз айтып тұр.
Dialogue: 0,1:22:40.49,1:22:41.41,Default,,0,0,0,,Джотаро, күте тұр, күте тұр!
Dialogue: 0,1:22:41.53,1:22:42.91,Default,,0,0,0,,Шизука-чан
Dialogue: 0,1:22:43.04,1:22:44.87,Default,,0,0,0,,Лилулу кетіп қалды.
Dialogue: 0,1:22:45.12,1:22:47.62,Default,,0,0,0,,Иә? (Нобита) Лилулу?
Dialogue: 0,1:22:48.79,1:22:50.13,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:50.71,1:22:52.13,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:22:53.13,1:22:54.71,Default,,0,0,0,,Лилулу!
Dialogue: 0,1:22:55.13,1:22:59.01,Default,,0,0,0,,Лилулу айна әлемінің сырын ашса, бітті!
Dialogue: 0,1:22:59.14,1:23:01.68,Default,,0,0,0,,Іздеуіңізді бөліңіз.
Dialogue: 0,1:23:07.64,1:23:09.90,Default,,0,0,0,,Балалар, не істеп жатырсыңдар?
Dialogue: 0,1:23:10.27,1:23:12.36,Default,,0,0,0,,Бір адам табылмас па?
Dialogue: 0,1:23:13.15,1:23:14.82,Default,,0,0,0,,Лилулуға не болды? (Командирдің орынбасары) А.
Dialogue: 0,1:23:15.65,1:23:18.28,Default,,0,0,0,,Әлі жауап жоқ...
Dialogue: 0,1:23:18.74,1:23:20.49,Default,,0,0,0,,Хмм...
Dialogue: 0,1:23:22.78,1:23:24.41,Default,,0,0,0,,Лилулу!
Dialogue: 0,1:23:24.54,1:23:25.62,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:23:25.75,1:23:26.75,Default,,0,0,0,,Лилулу!
Dialogue: 0,1:23:28.71,1:23:31.58,Default,,0,0,0,,Лилулу! Пиппо!
Dialogue: 0,1:23:31.71,1:23:34.84,Default,,0,0,0,,Лилулу! Пиппо!
Dialogue: 0,1:23:39.22,1:23:44.39,Default,,0,0,0,,Лилулу! Пиппо!
Dialogue: 0,1:23:47.98,1:23:48.94,Default,,0,0,0,,Ах
Dialogue: 0,1:23:50.02,1:23:51.52,Default,,0,0,0,,Лилулу!
Dialogue: 0,1:23:52.73,1:23:53.90,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:23:54.02,1:23:55.94,Default,,0,0,0,,Шизука-чан уайымдады.
Dialogue: 0,1:23:56.07,1:23:57.61,Default,,0,0,0,,Жүр, үйге бірге барайық.
Dialogue: 0,1:23:57.86,1:23:59.65,Default,,0,0,0,,Бұл болмайды.
Dialogue: 0,1:23:59.78,1:24:02.95,Default,,0,0,0,,Мен сіздің алаяқтығыңызды бас қолбасшыға хабарлаймын.
Dialogue: 0,1:24:03.16,1:24:06.91,Default,,0,0,0,,Егер сіз мұны істесеңіз, шынайы әлемдегі барлық адамдар...
Dialogue: 0,1:24:07.12,1:24:12.00,Default,,0,0,0,,Дұрыс, біз шынайы әлемге шабуыл жасап, адамдарды қолға түсіреміз.
Dialogue: 0,1:24:12.13,1:24:14.13,Default,,0,0,0,,Мен сол үшін келдім
Dialogue: 0,1:24:14.63,1:24:17.30,Default,,0,0,0,,Мен бұған жол бермеймін! Ух, мен түсіремін!
Dialogue: 0,1:24:17.46,1:24:18.30,Default,,0,0,0,,Ату!
Dialogue: 0,1:24:19.72,1:24:21.72,Default,,0,0,0,,Не болды? Түсіріңіз!
Dialogue: 0,1:24:21.93,1:24:22.93,Default,,0,0,0,,Атпа!
Dialogue: 0,1:24:23.26,1:24:24.14,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:24:24.76,1:24:28.31,Default,,0,0,0,,Сіз дзюдомен айналысасыз ба? Неге олай көрінесің...
Dialogue: 0,1:24:28.60,1:24:31.90,Default,,0,0,0,,Лилулу, адамдармен күресу жақсы емес.
Dialogue: 0,1:24:32.02,1:24:34.69,Default,,0,0,0,,Сіз еліңізге опасыздық жасауды жоспарлап отырсыз ба?
Dialogue: 0,1:24:34.81,1:24:37.36,Default,,0,0,0,,Лилулу, жүрегіңді жаппа
Dialogue: 0,1:24:37.61,1:24:39.74,Default,,0,0,0,,Менің жүрегімді тыңда
Dialogue: 0,1:24:39.94,1:24:43.07,Default,,0,0,0,,Жоқ, сіз бұрыннан білуіңіз керек.
Dialogue: 0,1:24:43.20,1:24:44.07,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,1:24:44.28,1:24:46.79,Default,,0,0,0,,Мен Мехатопиядан келген роботпын
Dialogue: 0,1:24:46.91,1:24:49.04,Default,,0,0,0,,Менің еліме қызмет ету міндетім бар ма?
Dialogue: 0,1:24:49.16,1:24:52.21,Default,,0,0,0,,Сондықтан мен шынымен баруым керек.
Dialogue: 0,1:24:52.33,1:24:55.00,Default,,0,0,0,,Тоқта! Егер тоқтамасаң, мен сені атып тастаймын.
Dialogue: 0,1:24:55.29,1:24:56.96,Default,,0,0,0,,Хо, мен байсалдымын.
Dialogue: 0,1:24:57.09,1:24:58.17,Default,,0,0,0,,Түсіру
Dialogue: 0,1:24:58.30,1:25:00.22,Default,,0,0,0,,Мені тоқтатудың жалғыз жолы – мені ату.
Dialogue: 0,1:25:00.97,1:25:02.18,Default,,0,0,0,,Тез ат!
Dialogue: 0,1:25:03.59,1:25:04.64,Default,,0,0,0,,Ату!
Dialogue: 0,1:25:09.89,1:25:10.68,Default,,0,0,0,,Қалаусыз!
Dialogue: 0,1:25:11.02,1:25:12.06,Default,,0,0,0,,Ха!
Dialogue: 0,1:25:12.60,1:25:15.27,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:16.06,1:25:16.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:18.32,1:25:19.86,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:20.74,1:25:21.82,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:25:22.24,1:25:24.03,Default,,0,0,0,,Ах... (Нобита) Пиппо, мықты бол!
Dialogue: 0,1:25:24.57,1:25:25.49,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:25:37.25,1:25:39.21,Default,,0,0,0,,Бас қолбасшы
Dialogue: 0,1:25:40.46,1:25:43.34,Default,,0,0,0,,Маған хабарласпай не істеп жүрсің?
Dialogue: 0,1:25:43.47,1:25:45.01,Default,,0,0,0,,Өз миссияңызды ұмыттыңыз ба?
Dialogue: 0,1:25:45.14,1:25:46.76,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:25:46.89,1:25:48.81,Default,,0,0,0,,Күтпеген мәселе туындады.
Dialogue: 0,1:25:49.47,1:25:51.39,Default,,0,0,0,,Жерлестермен уақыт өткізу
Dialogue: 0,1:25:51.52,1:25:54.69,Default,,0,0,0,,Маған адам болудың не екенін терең түсіну мүмкіндігі берілді.
Dialogue: 0,1:25:54.81,1:25:58.27,Default,,0,0,0,,көремін. Сонда бұл Жерлік қайда?
Dialogue: 0,1:25:58.40,1:25:59.23,Default,,0,0,0,,Га
Dialogue: 0,1:25:59.73,1:26:03.11,Default,,0,0,0,,Төбелессем де, төбелессем де, қарсыласымды көре алмаймын.
Dialogue: 0,1:26:03.24,1:26:05.07,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:26:05.20,1:26:06.95,Default,,0,0,0,,Жауап Лилулу
Dialogue: 0,1:26:10.03,1:26:12.16,Default,,0,0,0,,Мен жауап бергім келмейді...
Dialogue: 0,1:26:12.29,1:26:13.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:14.50,1:26:16.08,Default,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,1:26:17.96,1:26:21.38,Default,,0,0,0,,Адамды құл ету дұрыс емес.
Dialogue: 0,1:26:21.50,1:26:24.05,Default,,0,0,0,,Сіз аударылдыңыз ба?
Dialogue: 0,1:26:24.17,1:26:25.26,Default,,0,0,0,,Сатқын! Kya
Dialogue: 0,1:26:26.05,1:26:27.14,Default,,0,0,0,,Уф...
Dialogue: 0,1:26:27.34,1:26:28.18,Default,,0,0,0,,Ах
Dialogue: 0,1:26:28.47,1:26:31.31,Default,,0,0,0,,Енді маған не білетініңді айт!
Dialogue: 0,1:26:31.43,1:26:33.14,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:26:33.81,1:26:36.52,Default,,0,0,0,,Адамдар қоқыс сияқты
Dialogue: 0,1:26:36.64,1:26:38.61,Default,,0,0,0,,Қоқыс үшін аяушылық...
Dialogue: 0,1:26:39.31,1:26:40.65,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:26:40.77,1:26:46.24,Default,,0,0,0,,Нобита мен Шизука Лилулумен бірдей.
Dialogue: 0,1:26:49.28,1:26:50.99,Default,,0,0,0,,Бұл қоқыс емес
Dialogue: 0,1:26:51.12,1:26:53.58,Default,,0,0,0,,Адамдар да біз сияқты...
Dialogue: 0,1:26:53.70,1:26:56.75,Default,,0,0,0,,Жоқ, менде одан да күрделі ақыл бар.
Dialogue: 0,1:26:56.87,1:26:58.12,Default,,0,0,0,,Үніңді жап, Кя.
Dialogue: 0,1:26:58.33,1:26:59.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:00.50,1:27:01.84,Default,,0,0,0,,Дораемон тым-тырыс
Dialogue: 0,1:27:01.96,1:27:04.30,Default,,0,0,0,,Лилулу... және Пиппо да.
Dialogue: 0,1:27:04.67,1:27:07.43,Default,,0,0,0,,Осыншама адаммен қамауға алмақ болғандай.
Dialogue: 0,1:27:07.55,1:27:09.09,Default,,0,0,0,,Бірақ... (Бас қолбасшы) Сіз қателесесіз.
Dialogue: 0,1:27:09.22,1:27:12.81,Default,,0,0,0,,Құдай бізді ғаламның билеушісі етіп тағайындады.
Dialogue: 0,1:27:12.93,1:27:14.02,Default,,0,0,0,,Адамдар атынан
Dialogue: 0,1:27:14.14,1:27:17.27,Default,,0,0,0,,Себебі ол роботтар үшін жұмақ жасағысы келді.
Dialogue: 0,1:27:17.56,1:27:20.02,Default,,0,0,0,,Менің ойымша, бұл робот аспан емес.
Dialogue: 0,1:27:20.15,1:27:23.36,Default,,0,0,0,,Менің ойымша, бұл ғаламда өмір сүретін барлық адамдар үшін жұмақ.
Dialogue: 0,1:27:23.48,1:27:25.19,Default,,0,0,0,,Аузыңды жап! Ах!
Dialogue: 0,1:27:25.69,1:27:28.07,Default,,0,0,0,,Гу... біз...
Dialogue: 0,1:27:28.20,1:27:32.91,Default,,0,0,0,,Құдайдың еркіне қайшы келетін жолға түскен жоқсың ба?
Dialogue: 0,1:27:33.03,1:27:34.87,Default,,0,0,0,,Бұл жігіт те қоқыс.
Dialogue: 0,1:27:34.99,1:27:38.25,Default,,0,0,0,,Енді оны бөлшектеуден басқа амалымыз жоқ.
Dialogue: 0,1:27:49.97,1:27:52.26,Default,,0,0,0,,Орындауға дайындық аяқталды.
Dialogue: 0,1:27:52.89,1:27:56.22,Default,,0,0,0,,Лилулу Айтқыңыз келетін нәрсе бар ма?
Dialogue: 0,1:27:57.39,1:28:01.19,Default,,0,0,0,,Біз құлдарды аулауды тоқтатып, оларды алып кетуіміз керек.
Dialogue: 0,1:28:01.98,1:28:05.40,Default,,0,0,0,,Шаң қалмас үшін оны өртеп жіберіңіз!
Dialogue: 0,1:28:05.78,1:28:06.61,Default,,0,0,0,,Ах
Dialogue: 0,1:28:09.65,1:28:10.70,Default,,0,0,0,,Уф...
Dialogue: 0,1:28:12.37,1:28:13.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:13.57,1:28:15.95,Default,,0,0,0,,Не? (Солдат) Мына жақта.
Dialogue: 0,1:28:16.62,1:28:18.71,Default,,0,0,0,,Лилулу! Ах
Dialogue: 0,1:28:19.12,1:28:21.67,Default,,0,0,0,,Лилулу Мен көмектесуге келдім!
Dialogue: 0,1:28:21.96,1:28:24.04,Default,,0,0,0,,Дзюдо үшін (екінші команда), ол адам.
Dialogue: 0,1:28:24.38,1:28:25.30,Default,,0,0,0,,Кассарае!
Dialogue: 0,1:28:26.63,1:28:28.09,Default,,0,0,0,,Оны атып тастаңыз
Dialogue: 0,1:28:39.89,1:28:43.40,Default,,0,0,0,,Тіпті Дзю-дзюдо да бізді сатады...
Dialogue: 0,1:28:43.98,1:28:48.07,Default,,0,0,0,,Мен олардың бірдеңе білетініне сенімдімін.
Dialogue: 0,1:28:48.48,1:28:52.70,Default,,0,0,0,,Оларды табыңыз! Шөп тамырларын бөліп алсаң да, тауып ал!
Dialogue: 0,1:28:55.24,1:28:57.20,Default,,0,0,0,,Джуд Лилулу
Dialogue: 0,1:28:57.58,1:29:00.62,Default,,0,0,0,,Механикалық медициналық қобдиша қайтадан көмектесті.
Dialogue: 0,1:29:00.75,1:29:02.17,Default,,0,0,0,,Лилулу өз өміріне қауіп төндіреді
Dialogue: 0,1:29:02.29,1:29:04.71,Default,,0,0,0,,Айна әлемінің сырын қорғады.
Dialogue: 0,1:29:05.00,1:29:06.17,Default,,0,0,0,,Лилуру
Dialogue: 0,1:29:06.29,1:29:08.46,Default,,0,0,0,,Ол қазірдің өзінде біздің біріміз.
Dialogue: 0,1:29:08.59,1:29:10.67,Default,,0,0,0,,Мен саған шынымен сене аламын ба?
Dialogue: 0,1:29:12.09,1:29:13.59,Default,,0,0,0,,Сенбеу
Dialogue: 0,1:29:13.80,1:29:14.84,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:15.26,1:29:17.97,Default,,0,0,0,,Құл аулау жаман деп ойлаймын.
Dialogue: 0,1:29:18.18,1:29:21.43,Default,,0,0,0,,Бірақ мен Мехатопиядан келген роботпын.
Dialogue: 0,1:29:21.56,1:29:24.23,Default,,0,0,0,,Туған жерге қарсы тұра алмайсың.
Dialogue: 0,1:29:24.90,1:29:29.78,Default,,0,0,0,,Мен не істеуім керек? Мен өз жүрегімді де білмеймін.
Dialogue: 0,1:29:32.07,1:29:34.49,Default,,0,0,0,,Жалғыз қалдырсам жаман болар еді.
Dialogue: 0,1:29:34.61,1:29:37.66,Default,,0,0,0,,Мені бір жерге қамап қойыңыз
Dialogue: 0,1:29:37.78,1:29:40.95,Default,,0,0,0,,Оған көмектесу мүмкін емес, онда мен оны кішірейтемін.
Dialogue: 0,1:29:41.79,1:29:42.96,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,1:29:45.17,1:29:48.54,Default,,0,0,0,,Дүрбелең басылғанша осында бол.
Dialogue: 0,1:29:49.84,1:29:51.34,Default,,0,0,0,,Оны жабуға болады.
Dialogue: 0,1:29:58.97,1:30:01.43,Default,,0,0,0,,Күтілгендей, адамдар жоқ.
Dialogue: 0,1:30:01.72,1:30:04.10,Default,,0,0,0,,Сен не істеп жатырсың?
Dialogue: 0,1:30:04.23,1:30:05.44,Default,,0,0,0,,Бас қолбасшы (қолбасшының орынбасары) а?
Dialogue: 0,1:30:05.77,1:30:07.65,Default,,0,0,0,,Аспандағы әскерлердің байланысы.
Dialogue: 0,1:30:07.77,1:30:09.61,Default,,0,0,0,,Мынаны қара! (Бас қолбасшы) А?
Dialogue: 0,1:30:11.86,1:30:13.11,Default,,0,0,0,,(Абдул) Ағаңды еске алу үшін шайқас өткізуге ниеттенесің бе?
Dialogue: 0,1:30:13.24,1:30:17.57,Default,,0,0,0,,Мехатопиядан байқалған жер бедеріне мүлдем қарама-қарсы емес пе?
Dialogue: 0,1:30:17.87,1:30:21.87,Default,,0,0,0,,Бұл ақылмен жасалған жалған дүние ме?
Dialogue: 0,1:30:22.37,1:30:26.83,Default,,0,0,0,,Сіз заттарды көзбен көре аласыз!
Dialogue: 0,1:30:31.55,1:30:33.01,Default,,0,0,0,,Уау... уау!
Dialogue: 0,1:30:33.13,1:30:36.59,Default,,0,0,0,,Келді, келді, келді! Бұл Теміршілер корпусының үлкен қозғалысы.
Dialogue: 0,1:30:36.72,1:30:38.97,Default,,0,0,0,,Сол көлге ұмтылу
Dialogue: 0,1:30:39.10,1:30:40.72,Default,,0,0,0,,Мен бәрін білдім!
Dialogue: 0,1:30:41.18,1:30:43.68,Default,,0,0,0,,Шынайы дүние шатаспай тұрып
Dialogue: 0,1:30:43.81,1:30:45.18,Default,,0,0,0,,Біз оны қалай да тоқтатуымыз керек
Dialogue: 0,1:30:45.94,1:30:47.35,Default,,0,0,0,,Соңында күресетін кез келді.
Dialogue: 0,1:30:47.90,1:30:50.86,Default,,0,0,0,,Шизука-чан, өтінемін, Лилулудың қасында болшы.
Dialogue: 0,1:30:50.98,1:30:53.40,Default,,0,0,0,,Бірдеңе болса, осы қосалқы қалтаны пайдаланыңыз.
Dialogue: 0,1:30:53.53,1:30:54.36,Default,,0,0,0,,Рахмет
Dialogue: 0,1:30:55.24,1:30:57.49,Default,,0,0,0,,Лилулу I...
Dialogue: 0,1:30:57.95,1:31:00.32,Default,,0,0,0,,Мен барамын, абай бол.
Dialogue: 0,1:31:01.53,1:31:03.49,Default,,0,0,0,,Мен Нобитамен бірге күресемін
Dialogue: 0,1:31:04.62,1:31:07.33,Default,,0,0,0,,Мен Нобитаға көмектескім келеді
Dialogue: 0,1:31:07.46,1:31:08.96,Default,,0,0,0,,Нобита-кун, кеттік
Dialogue: 0,1:31:09.08,1:31:11.63,Default,,0,0,0,,Иә, Пиппо?
Dialogue: 0,1:31:20.09,1:31:21.60,Default,,0,0,0,,Пневматикалық зеңбіректер
Dialogue: 0,1:31:21.72,1:31:23.76,Default,,0,0,0,,Хирари плащына жылдам жабысатын тапанша
Dialogue: 0,1:31:24.06,1:31:25.77,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені алыңыз.
Dialogue: 0,1:31:25.89,1:31:26.73,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:31:27.14,1:31:30.35,Default,,0,0,0,,Мүмкіндігінше жақсартылған Ямабикояманы қалдырайық.
Dialogue: 0,1:31:30.48,1:31:33.57,Default,,0,0,0,,Әскери күшімізді ондаған есе арттырыңыз.
Dialogue: 0,1:31:34.86,1:31:36.15,Default,,0,0,0,,Тыныштал (Сунео) Ах!
Dialogue: 0,1:31:36.28,1:31:38.40,Default,,0,0,0,,Тынышталыңыз ба? Осындай уақытта?
Dialogue: 0,1:31:38.82,1:31:41.82,Default,,0,0,0,,Осындай үлкен армияның жан-жақты шабуылы басталғалы тұр!
Dialogue: 0,1:31:41.95,1:31:44.37,Default,,0,0,0,,Сіз не ойласаңыз да, нәтижесін көре аласыз.
Dialogue: 0,1:31:45.24,1:31:49.62,Default,,0,0,0,,Ер адам болсаң, мүмкін болмаса да бірдеңе істеуге тура келетін кездер болады!
Dialogue: 0,1:31:49.75,1:31:50.67,Default,,0,0,0,,Иә!
Dialogue: 0,1:31:50.79,1:31:54.09,Default,,0,0,0,,Біз оны тоқтатпасақ, бұл жерді кім сақтай алады?
Dialogue: 0,1:31:54.46,1:31:56.55,Default,,0,0,0,,Мен үшін де жаман, хаха
Dialogue: 0,1:31:59.59,1:32:01.80,Default,,0,0,0,,Біз ғана қалдық
Dialogue: 0,1:32:05.47,1:32:08.52,Default,,0,0,0,,Тек біз
Dialogue: 0,1:32:15.15,1:32:16.61,Default,,0,0,0,,Біз
Dialogue: 0,1:32:16.73,1:32:20.20,Default,,0,0,0,,Осы уақытқа дейін мен адам туралы мүлде ойлаған емеспін.
Dialogue: 0,1:32:20.66,1:32:22.62,Default,,0,0,0,,Адамды құл қылсаң
Dialogue: 0,1:32:22.74,1:32:26.91,Default,,0,0,0,,Отанымдағы еңбек роботтары бақытты болар деп ойладым.
Dialogue: 0,1:32:28.00,1:32:31.12,Default,,0,0,0,,Мен бір жерде дұрыс емес жолға түстім бе?
Dialogue: 0,1:32:31.25,1:32:35.54,Default,,0,0,0,,Немесе Құдай Ам мен Имді жаратқанда
Dialogue: 0,1:32:35.67,1:32:37.67,Default,,0,0,0,,Мен бірдеңені дұрыс істемедім бе?
Dialogue: 0,1:32:37.80,1:32:38.88,Default,,0,0,0,,Бұл...
Dialogue: 0,1:32:40.22,1:32:44.10,Default,,0,0,0,,Өткенге оралып, Құдайға шағым айтқым келеді.
Dialogue: 0,1:32:44.68,1:32:47.18,Default,,0,0,0,,Құдайға шағымдану...
Dialogue: 0,1:32:47.31,1:32:48.81,Default,,0,0,0,,Міне! сурет?
Dialogue: 0,1:32:49.06,1:32:51.39,Default,,0,0,0,,Бәлкім жаңа айтқаныңыз шығар
Dialogue: 0,1:32:51.52,1:32:54.02,Default,,0,0,0,,Бұл Жерді құтқарып қалуы мүмкін.
Dialogue: 0,1:32:54.40,1:32:57.07,Default,,0,0,0,,Шық! Құдаймен кездесуге барайық
Dialogue: 0,1:32:57.19,1:32:58.23,Default,,0,0,0,,Құдайға?
Dialogue: 0,1:32:58.48,1:33:02.53,Default,,0,0,0,,Иә, Ам мен Имді жаратқан ғалымға.
Dialogue: 0,1:33:03.53,1:33:04.41,Default,,0,0,0,,Өртеп жібер!
Dialogue: 0,1:33:13.62,1:33:17.34,Default,,0,0,0,,Жер жанып бара жатқандай.
Dialogue: 0,1:33:17.71,1:33:21.22,Default,,0,0,0,,Алдымен айнамен шынайы әлемге кіріңіз
Dialogue: 0,1:33:24.01,1:33:25.01,Default,,0,0,0,,О, сәлем
Dialogue: 0,1:33:25.14,1:33:26.18,Default,,0,0,0,,Сәлем... қош келдіңіз.
Dialogue: 0,1:33:26.30,1:33:28.60,Default,,0,0,0,,Мен асығыспын, кешіріңізші.
Dialogue: 0,1:33:30.35,1:33:31.77,Default,,0,0,0,,Иә?иә?
Dialogue: 0,1:33:32.18,1:33:34.40,Default,,0,0,0,,Мехатопияның негізі қашан қаланды?
Dialogue: 0,1:33:34.52,1:33:37.23,Default,,0,0,0,,Өткен жылы 30 000 жылдық мерейтойы тойланды.
Dialogue: 0,1:33:37.77,1:33:38.98,Default,,0,0,0,,Барсам болады ма?
Dialogue: 0,1:33:39.11,1:33:42.65,Default,,0,0,0,,Жарайды, Дора-чанның құралдары керемет.
Dialogue: 0,1:33:43.24,1:33:44.99,Default,,0,0,0,,Қандай үлкен тобыр.
Dialogue: 0,1:33:45.11,1:33:46.62,Default,,0,0,0,,Мұның бәрі емес
Dialogue: 0,1:33:46.74,1:33:49.62,Default,,0,0,0,,Қалған әскерлер шетелден оралғанда...
Dialogue: 0,1:33:49.74,1:33:51.12,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,1:33:51.37,1:33:55.54,Default,,0,0,0,,Яцура, бес адаммен төбелескіңіз келе ме?
Dialogue: 0,1:33:59.30,1:34:03.88,Default,,0,0,0,,Бұл 30 000 жыл бұрынғы Мехатопия ма?
Dialogue: 0,1:34:04.76,1:34:06.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:34:06.22,1:34:09.56,Default,,0,0,0,,Менің Ам мен Имнің ұрпақтары...
Dialogue: 0,1:34:09.93,1:34:11.14,Default,,0,0,0,,Егер сіз дәрігер болсаңыз
Dialogue: 0,1:34:11.27,1:34:14.02,Default,,0,0,0,,Мен бұл туралы бірдеңе істей аласыз ба деп ойладым.
Dialogue: 0,1:34:14.48,1:34:17.06,Default,,0,0,0,,Миға егілген бәсекелестік инстинкт
Dialogue: 0,1:34:17.19,1:34:19.77,Default,,0,0,0,,Бұл нашар нәтиже берді.
Dialogue: 0,1:34:19.90,1:34:21.40,Default,,0,0,0,,Бәсекелестік инстинкті?
Dialogue: 0,1:34:21.53,1:34:26.70,Default,,0,0,0,,Бұл басқалардан сәл де болса жақсырақ болуға ұмтылу.
Dialogue: 0,1:34:27.07,1:34:31.74,Default,,0,0,0,,Әр адам жарысса, қоғам соған сай дамиды.
Dialogue: 0,1:34:31.87,1:34:34.21,Default,,0,0,0,,Алайда, егер сіз бір қателік жіберсеңіз
Dialogue: 0,1:34:34.33,1:34:37.92,Default,,0,0,0,,Күштілер ғана әлсізді жаншып, гүлденеді.
Dialogue: 0,1:34:38.04,1:34:41.42,Default,,0,0,0,,Ол ең мықтыны жейтін әлемге айналады.
Dialogue: 0,1:34:41.92,1:34:46.09,Default,,0,0,0,,Мен көздеген аспаннан алыс.
Dialogue: 0,1:34:46.97,1:34:48.59,Default,,0,0,0,,Миыңызды өзгертіңіз
Dialogue: 0,1:34:48.72,1:34:49.85,Default,,0,0,0,,Ах... (2 адам) Ах!
Dialogue: 0,1:34:49.97,1:34:52.39,Default,,0,0,0,,Дәрігер, жақсысыз ба?
Dialogue: 0,1:34:52.89,1:34:56.73,Default,,0,0,0,,Менің аз ғана уақытым қалды.
Dialogue: 0,1:34:58.85,1:35:03.28,Default,,0,0,0,,Өзгелердің қамын ойлайтын жылы жүректі тәрбиелеу
Dialogue: 0,1:35:04.11,1:35:06.70,Default,,0,0,0,,Барлық күштер шабуылға кіріседі!
Dialogue: 0,1:35:07.07,1:35:08.95,Default,,0,0,0,,Үлкен жарық!
Dialogue: 0,1:35:09.28,1:35:10.95,Default,,0,0,0,,Майор аман-есен!
Dialogue: 0,1:35:15.08,1:35:18.25,Default,,0,0,0,,Осы модификациямен Мехатопия 30 000 жылдан кейін болады
Dialogue: 0,1:35:18.37,1:35:20.84,Default,,0,0,0,,Бұл Гарариден басқа әлем болуы керек.
Dialogue: 0,1:35:21.21,1:35:23.84,Default,,0,0,0,,Сонда сол Темір адам корпусы ше?
Dialogue: 0,1:35:23.96,1:35:25.51,Default,,0,0,0,,Тарих өзгереді
Dialogue: 0,1:35:25.63,1:35:28.30,Default,,0,0,0,,Сол сұмдық нәрселер жойылады.
Dialogue: 0,1:35:28.68,1:35:29.93,Default,,0,0,0,,(Екі қуанышты дауыс)
Dialogue: 0,1:35:30.05,1:35:34.35,Default,,0,0,0,,Ах, бірақ Лилуру туралы не деуге болады?
Dialogue: 0,1:35:34.97,1:35:37.52,Default,,0,0,0,,Мен де жоғалып кетемін...
Dialogue: 0,1:35:37.89,1:35:39.27,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,1:35:39.40,1:35:41.98,Default,,0,0,0,,Бұл сіздің басынан бері бұл дүниеде болмағаныңызды білдіреді.
Dialogue: 0,1:35:42.23,1:35:44.48,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,1:35:44.78,1:35:46.19,Default,,0,0,0,,Ах! Дәрігер!
Dialogue: 0,1:35:47.28,1:35:48.70,Default,,0,0,0,,Дәрігер?
Dialogue: 0,1:35:49.78,1:35:52.12,Default,,0,0,0,,Жоқ, менің денем әлдеқашан...
Dialogue: 0,1:35:52.24,1:35:53.41,Default,,0,0,0,,Дәрігер!
Dialogue: 0,1:35:54.16,1:35:57.25,Default,,0,0,0,,Мықты болыңыз, доктор!
Dialogue: 0,1:35:59.04,1:36:02.42,Default,,0,0,0,,Дәрігер, айтыңызшы, мен жалғастырамын.
Dialogue: 0,1:36:02.54,1:36:04.30,Default,,0,0,0,,Лилулу сен...
Dialogue: 0,1:36:04.42,1:36:05.59,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,1:36:06.46,1:36:09.84,Default,,0,0,0,,Нағыз аспан құруға көмектесу
Dialogue: 0,1:36:13.35,1:36:14.47,Default,,0,0,0,,Хмф! сәуле!
Dialogue: 0,1:36:14.60,1:36:16.22,Default,,0,0,0,,Нобита! (Нобита) Иә?
Dialogue: 0,1:36:17.31,1:36:18.77,Default,,0,0,0,,Рахмет
Dialogue: 0,1:36:21.23,1:36:23.06,Default,,0,0,0,,Уау! Нобита!
Dialogue: 0,1:36:25.65,1:36:26.94,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:37:00.31,1:37:01.69,Default,,0,0,0,,Дәрігер, ары қарай не болады?
Dialogue: 0,1:37:02.85,1:37:04.65,Default,,0,0,0,,Дәрігер? Дәрігер?
Dialogue: 0,1:37:04.98,1:37:08.32,Default,,0,0,0,,Мықты болыңыз! Ояныңыз, доктор!
Dialogue: 0,1:37:10.44,1:37:12.70,Default,,0,0,0,,Мен дзюдо
Dialogue: 0,1:37:12.82,1:37:13.99,Default,,0,0,0,,Сонымен, бас қолбасшы?
Dialogue: 0,1:37:14.11,1:37:14.95,Default,,0,0,0,,Доктор…
Dialogue: 0,1:37:15.07,1:37:18.20,Default,,0,0,0,,Дәрігер! Дәрігер! Не істеуім керек?
Dialogue: 0,1:37:18.87,1:37:22.46,Default,,0,0,0,,Басқаны ойлайтын жүрек... Мұны қалай істей аламыз?
Dialogue: 0,1:37:23.12,1:37:24.54,Default,,0,0,0,,Бас қолбасшы!
Dialogue: 0,1:37:25.04,1:37:28.25,Default,,0,0,0,,Джуде мен сені үрлеймін!
Dialogue: 0,1:37:31.47,1:37:33.30,Default,,0,0,0,,Бас қолбасшы! (Солдат) Уау!
Dialogue: 0,1:37:37.85,1:37:40.18,Default,,0,0,0,,Дәрігер, мен не істеуім керек?
Dialogue: 0,1:37:40.31,1:37:41.93,Default,,0,0,0,,Оян!
Dialogue: 0,1:37:42.14,1:37:43.44,Default,,0,0,0,,Dr.
Dialogue: 0,1:37:43.56,1:37:46.02,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:38:07.50,1:38:08.96,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,1:38:09.71,1:38:13.42,Default,,0,0,0,,Сезімімді айтсам
Dialogue: 0,1:38:13.55,1:38:16.01,Default,,0,0,0,,Сонда, әрине...
Dialogue: 0,1:38:16.72,1:38:20.43,Default,,0,0,0,,Джуд Сен менің қазір не істейтінімді білесің бе?
Dialogue: 0,1:38:20.56,1:38:22.60,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,1:38:22.73,1:38:26.23,Default,,0,0,0,,Өткенді өзгертсең, сен де жоқ боласың.
Dialogue: 0,1:38:27.48,1:38:29.11,Default,,0,0,0,,Ешқандай ойлануға болмайды
Dialogue: 0,1:38:30.23,1:38:33.57,Default,,0,0,0,,Егер бұл барлығын қорғау үшін болса, мен...
Dialogue: 0,1:38:35.20,1:38:36.07,Default,,0,0,0,,Иә
Dialogue: 0,1:38:51.00,1:38:52.13,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:38:53.01,1:38:55.09,Default,,0,0,0,,Бас қолбасшы, қараңызшы.
Dialogue: 0,1:38:58.26,1:39:01.14,Default,,0,0,0,,Ол қоқыстан артық емес.
Dialogue: 0,1:39:01.76,1:39:03.22,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:39:03.39,1:39:04.43,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:39:07.23,1:39:08.31,Default,,0,0,0,,Лилулу…
Dialogue: 0,1:39:08.81,1:39:11.77,Default,,0,0,0,,Жалғастырыңыз! Оны бұраңыз!
Dialogue: 0,1:39:19.99,1:39:21.08,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:39:21.83,1:39:22.83,Default,,0,0,0,,Нобита!
Dialogue: 0,1:39:26.46,1:39:27.67,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:39:27.79,1:39:30.46,Default,,0,0,0,,Нобита, жарайды... жарайды.
Dialogue: 0,1:39:31.13,1:39:33.92,Default,,0,0,0,,Жақында бәрі бітеді
Dialogue: 0,1:39:34.13,1:39:36.22,Default,,0,0,0,,Не? не?
Dialogue: 0,1:39:36.34,1:39:38.55,Default,,0,0,0,,Уау! Міне бітті!
Dialogue: 0,1:39:42.01,1:39:43.51,Default,,0,0,0,,Күшейткіштер!
Dialogue: 0,1:39:43.76,1:39:45.39,Default,,0,0,0,,Біздің жеңісіміз!
Dialogue: 0,1:39:45.77,1:39:48.52,Default,,0,0,0,,Қанша мыңдаған, он мыңдаған денелер жойылса да
Dialogue: 0,1:39:48.64,1:39:51.40,Default,,0,0,0,,Сансыз алмастыратын роботтар бар.
Dialogue: 0,1:39:51.52,1:39:53.07,Default,,0,0,0,,Демек, сен болған болашаққа қайта орала алмаймын дегің келе ме?
Dialogue: 0,1:39:53.57,1:39:54.61,Default,,0,0,0,,Енді жоқ
Dialogue: 0,1:39:54.73,1:39:56.07,Default,,0,0,0,,Куку…
Dialogue: 0,1:39:56.44,1:39:57.49,Default,,0,0,0,,Ах
Dialogue: 0,1:40:04.58,1:40:05.66,Default,,0,0,0,,Какаре!
Dialogue: 0,1:40:17.46,1:40:20.01,Default,,0,0,0,,(Абдул) Ағаңды еске алу үшін шайқас өткізуге ниеттенесің бе?
Dialogue: 0,1:40:20.13,1:40:21.80,Default,,0,0,0,,Жер бетінде не?
Dialogue: 0,1:40:22.14,1:40:25.72,Default,,0,0,0,,(Барлығының таңданған дауысы)
Dialogue: 0,1:40:26.27,1:40:29.52,Default,,0,0,0,,(Сарбаздардың ыңырануы)
Dialogue: 0,1:40:29.77,1:40:31.10,Default,,0,0,0,,Бұл не...
Dialogue: 0,1:40:31.23,1:40:33.98,Default,,0,0,0,,(Бас қолбасшының айқайы)
Dialogue: 0,1:40:35.36,1:40:38.53,Default,,0,0,0,,Неге екенін білмеймін, бірақ бұл маған көмектесті!
Dialogue: 0,1:40:38.69,1:40:42.03,Default,,0,0,0,,Оу!
Dialogue: 0,1:40:42.36,1:40:43.70,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:40:45.03,1:40:47.33,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:40:49.50,1:40:50.96,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:40:51.54,1:40:54.54,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,1:40:55.29,1:41:00.09,Default,,0,0,0,,Тарих өзгереді, Темір адам корпусы жоғалады.
Dialogue: 0,1:41:00.22,1:41:03.47,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Не болып жатыр?
Dialogue: 0,1:41:04.18,1:41:05.47,Default,,0,0,0,,Лилуру
Dialogue: 0,1:41:06.35,1:41:07.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:09.14,1:41:10.89,Default,,0,0,0,,Осымен, әрине
Dialogue: 0,1:41:11.35,1:41:16.11,Default,,0,0,0,,Мехатопия да Жер сияқты аспанға ұқсас дүние...
Dialogue: 0,1:41:16.36,1:41:18.82,Default,,0,0,0,,Жоғалып кетпеңіз Жоғалып кетпеңіз!
Dialogue: 0,1:41:19.11,1:41:20.49,Default,,0,0,0,,Шизука
Dialogue: 0,1:41:20.90,1:41:25.70,Default,,0,0,0,,Барлығымен танысу өте жақсы болды.
Dialogue: 0,1:41:25.82,1:41:27.37,Default,,0,0,0,,Егер мен қайта туылсам...
Dialogue: 0,1:41:27.49,1:41:30.04,Default,,0,0,0,,Періште тәрізді роботқа
Dialogue: 0,1:41:30.37,1:41:31.29,Default,,0,0,0,,Пиппо!
Dialogue: 0,1:41:31.41,1:41:36.29,Default,,0,0,0,,Хехе, мен бұл есімді жақсы көремін.
Dialogue: 0,1:41:37.29,1:41:40.17,Default,,0,0,0,,Дос болайық
Dialogue: 0,1:41:40.42,1:41:42.34,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:42:23.30,1:42:25.30,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,1:42:25.76,1:42:28.68,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,1:42:37.15,1:42:38.69,Default,,0,0,0,,Күтілгендей
Dialogue: 0,1:42:39.06,1:42:40.94,Default,,0,0,0,,Кеш болғандықтан көруге келдім.
Dialogue: 0,1:42:41.07,1:42:43.07,Default,,0,0,0,,Менің ойымша, ол тағы да артта қалды?
Dialogue: 0,1:42:43.19,1:42:46.57,Default,,0,0,0,,Иә, мен бұл күндері тым жалқаумын деп ойлаймын.
Dialogue: 0,1:42:46.70,1:42:47.74,Default,,0,0,0,,Иә...
Dialogue: 0,1:42:48.49,1:42:51.24,Default,,0,0,0,,Эй Дораемон, иә?
Dialogue: 0,1:42:51.37,1:42:56.46,Default,,0,0,0,,Мехатопия 30 000 жылдан кейін қандай жұлдызға айналды?
Dialogue: 0,1:42:56.58,1:43:01.25,Default,,0,0,0,,Жарайды, бұл керемет, аспанға ұқсас жұлдыз.
Dialogue: 0,1:43:02.00,1:43:05.72,Default,,0,0,0,,Рилу мен Пиппо реинкарнацияланды ма?
Dialogue: 0,1:43:05.84,1:43:07.01,Default,,0,0,0,,Мүмкін
Dialogue: 0,1:43:07.13,1:43:09.18,Default,,0,0,0,,Соған сенейік.
Dialogue: 0,1:43:10.39,1:43:13.43,Default,,0,0,0,,Келіңіздер! Барлығы бос жерге баратынын айтты.
Dialogue: 0,1:43:13.56,1:43:15.35,Default,,0,0,0,,Нобита-кун, сен де тез келші.
Dialogue: 0,1:43:15.48,1:43:16.35,Default,,0,0,0,,Иә
Dialogue: 0,1:43:16.48,1:43:18.81,Default,,0,0,0,,Мен сені күтемін.
Dialogue: 0,1:43:19.48,1:43:24.61,Default,,0,0,0,,Егер сен қайта туылсаң, Жерге қайта келер ме едің?
Dialogue: 0,1:43:24.86,1:43:27.15,Default,,0,0,0,,Бұл жолы мен шпион емеспін.
Dialogue: 0,1:43:29.24,1:43:34.12,Default,,0,0,0,,♪ Мен үшінші нәрсе туралы ойлаймын.
Dialogue: 0,1:43:34.33,1:43:38.08,Default,,0,0,0,,♪ Сен менсің
Dialogue: 0,1:43:38.33,1:43:44.09,Default,,0,0,0,,♪ Мен сенмін
Dialogue: 0,1:43:44.25,1:43:45.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:43:45.21,1:43:47.30,Default,,0,0,0,,Уф
Dialogue: 0,1:43:48.97,1:43:50.14,Default,,0,0,0,,Ах...
Dialogue: 0,1:43:54.89,1:43:55.81,Default,,0,0,0,,Ах!
Dialogue: 0,1:43:56.22,1:43:59.06,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:44:02.69,1:44:04.73,Default,,0,0,0,,Мен қайта туылдым!
Dialogue: 0,1:44:05.73,1:44:07.57,Default,,0,0,0,,Мен сенімдімін!
Dialogue: 0,1:44:08.15,1:44:13.12,Default,,0,0,0,,Барлығына! Эй! Эй!
Dialogue: 0,1:44:13.28,1:44:19.29,Default,,0,0,0,,♪〜
Dialogue: 0,1:47:58.72,1:48:04.72,Default,,0,0,0,,〜♪
Dialogue: 0,1:48:06.22,1:48:12.22,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory