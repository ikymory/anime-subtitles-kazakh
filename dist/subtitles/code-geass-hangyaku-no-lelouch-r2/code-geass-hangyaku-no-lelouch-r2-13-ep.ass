Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.31,0:00:04.69,Default,,0,0,0,,Эй, Лелуш не болып жатыр?
Dialogue: 0,0:00:04.81,0:00:05.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:05.60,0:00:07.69,Default,,0,0,0,,Біз мектеп рұқсаты бар жұппыз.
Dialogue: 0,0:00:07.82,0:00:08.82,Default,,0,0,0,,Сіз әлі сүйіп көрдіңіз бе?
Dialogue: 0,0:00:08.98,0:00:11.44,Default,,0,0,0,,А, бұл жай ғана оқиға болды.
Dialogue: 0,0:00:11.57,0:00:12.40,Default,,0,0,0,,Әлі ештеңе жоқ
Dialogue: 0,0:00:12.53,0:00:13.86,Default,,0,0,0,,Ұялып қалмаңыз
Dialogue: 0,0:00:14.03,0:00:16.82,Default,,0,0,0,,Сенің Лелушка ғашық екеніңді бәрі біледі.
Dialogue: 0,0:00:17.03,0:00:19.41,Default,,0,0,0,,Енді профессор Виллеттаға.
Dialogue: 0,0:00:19.54,0:00:22.00,Default,,0,0,0,,Сізге ұнайды, солай ма? мені атып кете жаздады
Dialogue: 0,0:00:22.12,0:00:22.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:23.87,0:00:26.92,Default,,0,0,0,,Мені атқан әйелге қиын болды...
Dialogue: 0,0:00:27.04,0:00:29.92,Default,,0,0,0,,Күн сайын күліп өмір сүру керек
Dialogue: 0,0:00:30.13,0:00:31.30,Default,,0,0,0,,Бірақ мен-
Dialogue: 0,0:00:31.42,0:00:34.43,Default,,0,0,0,,Маған мұғалімнің маскасын киюге тура келді.
Dialogue: 0,0:00:34.55,0:00:35.18,Default,,0,0,0,,Га
Dialogue: 0,0:00:40.64,0:00:42.14,Default,,0,0,0,,Ширли Фенетт
Dialogue: 0,0:00:42.27,0:00:44.10,Default,,0,0,0,,Мені түсірген жақсы жұмыс.
Dialogue: 0,0:01:00.03,0:01:00.66,Default,,0,0,0,,Ах
Dialogue: 0,0:01:02.87,0:01:03.50,Default,,0,0,0,,Лулу
Dialogue: 0,0:01:16.47,0:01:20.55,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:01:24.14,0:01:24.77,Default,,0,0,0,,Га
Dialogue: 0,0:01:31.27,0:01:36.65,Default,,0,0,0,,Дұрыс, Лулу - Нөл және оның әкесінің жауы.
Dialogue: 0,0:01:39.57,0:01:44.12,Default,,0,0,0,,♪Дүниенің ақырында туған нұр
Dialogue: 0,0:01:44.25,0:01:49.79,Default,,0,0,0,,♪ Енді желде
Dialogue: 0,0:02:05.68,0:02:10.65,Default,,0,0,0,,♪Сұлу болу арқылы өмір сүре алмайсың
Dialogue: 0,0:02:11.02,0:02:16.36,Default,,0,0,0,,♪Мейірімділік жалғыз емдей алмайды
Dialogue: 0,0:02:16.49,0:02:19.20,Default,,0,0,0,,♪Не ұрланды?
Dialogue: 0,0:02:19.32,0:02:21.45,Default,,0,0,0,,♪Өзгермейтін әлемде
Dialogue: 0,0:02:21.91,0:02:24.54,Default,,0,0,0,,♪Сіз не естідіңіз?
Dialogue: 0,0:02:24.66,0:02:27.79,Default,,0,0,0,,♪Түстер әні
Dialogue: 0,0:02:27.91,0:02:32.79,Default,,0,0,0,,♪Бәрі жарық
Dialogue: 0,0:02:33.63,0:02:36.26,Default,,0,0,0,,♪Тасылған армандар
Dialogue: 0,0:02:36.38,0:02:42.80,Default,,0,0,0,,♪Ертеңгі күннің соңында жаңғырық
Dialogue: 0,0:02:44.43,0:02:48.89,Default,,0,0,0,,♪Дүниенің ақырында туған нұр
Dialogue: 0,0:02:49.02,0:02:53.56,Default,,0,0,0,,♪Біз бірміз
Dialogue: 0,0:02:54.44,0:03:00.07,Default,,0,0,0,,♪ Қазір желде
Dialogue: 0,0:03:29.02,0:03:30.60,Default,,0,0,0,,Кенмон тосқауылы құлады ма?
Dialogue: 0,0:03:31.02,0:03:33.44,Default,,0,0,0,,Макаодағы әуе күштерінің нысандары да басып алынды.
Dialogue: 0,0:03:34.52,0:03:35.90,Default,,0,0,0,,Қазақстанды қорғау үшін -
Dialogue: 0,0:03:36.02,0:03:38.65,Default,,0,0,0,,Асахина мен Хон Гуды айналдыру керек деп есептейік.
Dialogue: 0,0:03:38.82,0:03:42.45,Default,,0,0,0,,Кенгионың ішкі істері Минасе мен Сугиямаға қалады ма?
Dialogue: 0,0:03:42.57,0:03:44.62,Default,,0,0,0,,Бәрі жақсы болып жатқан сияқты, аға.
Dialogue: 0,0:03:44.74,0:03:48.41,Default,,0,0,0,,Біздің жауымыз болса да бізді қабылдамайтын жергілікті қолбасшылар бар...
Dialogue: 0,0:03:48.54,0:03:50.79,Default,,0,0,0,,Олар жасақтарды бөлшектеп жинап жатыр.
Dialogue: 0,0:03:51.21,0:03:53.62,Default,,0,0,0,,Жергілікті қолбасшыларды біріктіре алатын ту...
Dialogue: 0,0:03:53.75,0:03:56.04,Default,,0,0,0,,Бірінші ағам алды.
Dialogue: 0,0:03:56.17,0:03:57.67,Default,,0,0,0,,Осымен
Dialogue: 0,0:03:57.80,0:03:58.46,Default,,0,0,0,,Қайда?
Dialogue: 0,0:03:58.80,0:04:00.67,Default,,0,0,0,,Икебукуроны тексеріңіз.
Dialogue: 0,0:04:00.80,0:04:03.18,Default,,0,0,0,,Үйге келген соң үй тапсырмасының қалған бөлігін қараймын.
Dialogue: 0,0:04:04.18,0:04:05.18,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:06.64,0:04:08.39,Default,,0,0,0,,Мияу
Dialogue: 0,0:04:12.94,0:04:16.98,Default,,0,0,0,,Лулу нөлге тең болды. Виллетта-сенсей - солдат.
Dialogue: 0,0:04:17.11,0:04:19.02,Default,,0,0,0,,Карен - Қара рыцарьлар тобының мүшесі
Dialogue: 0,0:04:19.86,0:04:21.03,Default,,0,0,0,,Сонымен, Нина ше?
Dialogue: 0,0:04:21.36,0:04:25.82,Default,,0,0,0,,Төраға кім? Ривал ше? Біртүрлі мектеп қана ма?
Dialogue: 0,0:04:27.32,0:04:29.33,Default,,0,0,0,,Неліктен Нана-чан губернатор?
Dialogue: 0,0:04:29.99,0:04:32.71,Default,,0,0,0,,Өтірік деген не, шын деген не?
Dialogue: 0,0:04:34.37,0:04:38.04,Default,,0,0,0,,Жартылай экспресс пойыз 3-платформаға 10 минут кешігіп келеді.
Dialogue: 0,0:04:38.17,0:04:39.21,Default,,0,0,0,,Окубо станциясына -
Dialogue: 0,0:04:39.34,0:04:42.59,Default,,0,0,0,,2-платформадан шығатын пойыздар бірінші келеді.
Dialogue: 0,0:04:42.72,0:04:45.97,Default,,0,0,0,,Жарайды, бастапқы кезең үшін жеткілікті.
Dialogue: 0,0:04:46.09,0:04:48.89,Default,,0,0,0,,Осы стильде жұмысты жалғастырайық
Dialogue: 0,0:04:49.01,0:04:52.22,Default,,0,0,0,,Тұтынушыларға науқан туралы хабарлама
Dialogue: 0,0:04:52.35,0:04:55.85,Default,,0,0,0,,Қазіргі уақытта шектеулі уақыт ішінде сауда карталары...
Dialogue: 0,0:04:55.98,0:04:57.15,Default,,0,0,0,,Ширли
Dialogue: 0,0:05:00.48,0:05:01.44,Default,,0,0,0,,Га
Dialogue: 0,0:05:01.57,0:05:02.32,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:05:02.57,0:05:03.44,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:05:04.82,0:05:07.28,Default,,0,0,0,,Не болды? кенеттен маған қоңырау шалыңыз
Dialogue: 0,0:05:07.49,0:05:09.07,Default,,0,0,0,,Иә
Dialogue: 0,0:05:11.37,0:05:12.54,Default,,0,0,0,,Ширли?
Dialogue: 0,0:05:14.00,0:05:15.08,Default,,0,0,0,,Лелуш
Dialogue: 0,0:05:18.75,0:05:20.92,Default,,0,0,0,,Лелуш туралы не деуге болады? Бұл кездесу ме?
Dialogue: 0,0:05:21.05,0:05:23.09,Default,,0,0,0,,Мен G пойызын сынауға бардым.
Dialogue: 0,0:05:23.21,0:05:25.05,Default,,0,0,0,,Нәжіс болса ыңғайлы.
Dialogue: 0,0:05:25.17,0:05:25.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:26.05,0:05:28.84,Default,,0,0,0,,Ролло, сен неге аударылды?
Dialogue: 0,0:05:29.01,0:05:31.72,Default,,0,0,0,,Мен сияқты емес, мен Риодан жіберілгендіктен...
Dialogue: 0,0:05:31.85,0:05:35.10,Default,,0,0,0,,Бұл не? Бұл сұрақ ағам екеуміздің арамызда...
Dialogue: 0,0:05:35.10,0:05:35.89,Default,,0,0,0,,Бұл не? Бұл сұрақ ағам екеуміздің арамызда...
Dialogue: 0,0:05:35.10,0:05:35.89,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:05:35.89,0:05:36.02,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:05:36.02,0:05:37.19,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:05:36.02,0:05:37.19,Default,,0,0,0,,В7-ден бас кеңсеге дейін
Dialogue: 0,0:05:37.85,0:05:39.94,Default,,0,0,0,,Шапелдің жанынан күдікті адам табылды
Dialogue: 0,0:05:40.06,0:05:42.27,Default,,0,0,0,,B5 B9 оны қамтамасыз ету үшін барды.
Dialogue: 0,0:05:42.40,0:05:43.23,Default,,0,0,0,,Уф
Dialogue: 0,0:05:43.36,0:05:44.19,Default,,0,0,0,,Гуах
Dialogue: 0,0:05:44.32,0:05:45.28,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:05:48.11,0:05:52.20,Default,,0,0,0,,Хм, мен Лелуштың қайда екенін жаңа ғана естідім. Бұл ма?
Dialogue: 0,0:05:52.74,0:05:54.79,Default,,0,0,0,,Еремия сэр? неге
Dialogue: 0,0:05:55.20,0:05:57.29,Default,,0,0,0,,Субъект клуб үйіне қарай бет алды.
Dialogue: 0,0:05:57.41,0:05:59.46,Default,,0,0,0,,B2 (екі) B8 де жойылды
Dialogue: 0,0:05:59.88,0:06:03.17,Default,,0,0,0,,Мақсатты аймақтан тыс басқа оқушыларға мектеп хабарландырулары
Dialogue: 0,0:06:04.21,0:06:06.97,Default,,0,0,0,,Мектептің барлық оқушыларға шұғыл хабарламасы.
Dialogue: 0,0:06:07.09,0:06:09.38,Default,,0,0,0,,Клуб ғимаратының жанында тоқтамаңыз
Dialogue: 0,0:06:09.51,0:06:12.55,Default,,0,0,0,,Күдікті адамды көргені туралы ақпаратты қамтиды Қайталау
Dialogue: 0,0:06:12.97,0:06:17.10,Default,,0,0,0,,Мүмкін болса, әйелдерді өлтіргім келмейді.
Dialogue: 0,0:06:17.23,0:06:18.14,Default,,0,0,0,,Мен де-
Dialogue: 0,0:06:18.27,0:06:21.19,Default,,0,0,0,,Мүмкін болса, қажетсіз өлтіруден аулақ болғым келді.
Dialogue: 0,0:06:21.81,0:06:22.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:22.61,0:06:23.61,Default,,0,0,0,,Қазір
Dialogue: 0,0:06:28.78,0:06:29.45,Default,,0,0,0,,Машина?
Dialogue: 0,0:06:29.61,0:06:31.03,Default,,0,0,0,,Нөлге рахмет
Dialogue: 0,0:06:31.87,0:06:33.99,Default,,0,0,0,,Олар Құдайды өлтіреді
Dialogue: 0,0:06:34.12,0:06:34.87,Default,,0,0,0,,Құдай?
Dialogue: 0,0:06:34.99,0:06:37.75,Default,,0,0,0,,Мен бұл сөздің бір түрі деп ойладым.
Dialogue: 0,0:06:38.00,0:06:40.71,Default,,0,0,0,,Кем дегенде, олар бұған сенеді
Dialogue: 0,0:06:40.87,0:06:44.21,Default,,0,0,0,,Идиот Құдай өмір сүре алмайды.
Dialogue: 0,0:06:44.34,0:06:45.42,Default,,0,0,0,,) Дұрыс. (Корнелия) Ха!
Dialogue: 0,0:06:45.55,0:06:46.38,Default,,0,0,0,,Га
Dialogue: 0,0:06:46.51,0:06:49.01,Default,,0,0,0,,Арқасында қанаты бар құдай...
Dialogue: 0,0:06:49.13,0:06:52.93,Default,,0,0,0,,Ұзын сақалды қарттай құдай жоқ.
Dialogue: 0,0:06:57.98,0:06:59.64,Default,,0,0,0,,Құрметті Корнелия
Dialogue: 0,0:06:59.77,0:07:02.02,Default,,0,0,0,,Мен қандай Geass түрін қолдану керектігін білмеймін.
Dialogue: 0,0:07:02.15,0:07:04.36,Default,,0,0,0,,Басқа адам бала болса да, сіз өз сақтығыңызды түсіре алмайсыз.
Dialogue: 0,0:07:04.48,0:07:06.40,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:07:06.82,0:07:10.11,Default,,0,0,0,,Мен күткендей дыбысты естідім, Корнелия ханшайым.
Dialogue: 0,0:07:11.28,0:07:13.66,Default,,0,0,0,,Мен де сенің ағаң болғанымды мақтан тұтамын.
Dialogue: 0,0:07:14.66,0:07:15.78,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:07:15.99,0:07:18.00,Default,,0,0,0,,Біз ант бердік
Dialogue: 0,0:07:18.25,0:07:22.96,Default,,0,0,0,,Егер құдай адамдарды төбелестірсе, мен оны өлтіремін.
Dialogue: 0,0:07:23.75,0:07:25.92,Default,,0,0,0,,Сіз өзгертілген адам болсаңыз да...
Dialogue: 0,0:07:26.04,0:07:27.84,Default,,0,0,0,,Ашық биологиялық бөліктерге арналған
Dialogue: 0,0:07:28.84,0:07:29.76,Default,,0,0,0,,Жақсы мақсат
Dialogue: 0,0:07:30.01,0:07:30.92,Default,,0,0,0,,Тоқта
Dialogue: 0,0:07:31.18,0:07:32.80,Default,,0,0,0,,Лелуш-сама үшін
Dialogue: 0,0:07:37.97,0:07:39.56,Default,,0,0,0,,Жақсы тайджуцу
Dialogue: 0,0:07:40.18,0:07:43.23,Default,,0,0,0,,Алайда, бұл Жеремия Готвальд
Dialogue: 0,0:07:43.35,0:07:44.48,Default,,0,0,0,,Құт
Dialogue: 0,0:07:44.61,0:07:45.52,Default,,0,0,0,,Сакиоко
Dialogue: 0,0:07:47.94,0:07:49.28,Default,,0,0,0,,Уақытты ұрлау
Dialogue: 0,0:07:50.69,0:07:53.32,Default,,0,0,0,,Сакиоко Мен бұл жігітті тоқтатып жатқанда
Dialogue: 0,0:07:53.53,0:07:54.82,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:57.41,0:07:58.37,Default,,0,0,0,,Га
Dialogue: 0,0:07:58.49,0:07:59.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:02.71,0:08:05.04,Default,,0,0,0,,Менің Геассим осылай
Dialogue: 0,0:08:05.17,0:08:06.79,Default,,0,0,0,,Абсолюттік тоқтау кедергісі
Dialogue: 0,0:08:06.92,0:08:08.34,Default,,0,0,0,,Ой, Лоло Ламперуж
Dialogue: 0,0:08:08.46,0:08:10.01,Default,,0,0,0,,Гуаааааааааааааааааааааааааааа
Dialogue: 0,0:08:10.13,0:08:12.13,Default,,0,0,0,,Ол әлі де тұзаққа түсті ме?
Dialogue: 0,0:08:12.26,0:08:14.01,Default,,0,0,0,,Неліктен Geass?
Dialogue: 0,0:08:14.13,0:08:16.30,Default,,0,0,0,,Сондықтан мені таңдады
Dialogue: 0,0:08:16.43,0:08:18.31,Default,,0,0,0,,Rage бандасының өлтірушісі ретінде
Dialogue: 0,0:08:18.43,0:08:20.35,Default,,0,0,0,,Ағамды өлтіруім керек еді ғой.
Dialogue: 0,0:08:20.47,0:08:21.52,Default,,0,0,0,,Еремия сэр
Dialogue: 0,0:08:21.64,0:08:22.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:23.27,0:08:24.44,Default,,0,0,0,,Виллетта
Dialogue: 0,0:08:24.65,0:08:26.56,Default,,0,0,0,,Сізді де Лелуш ұстап алды ма?
Dialogue: 0,0:08:26.73,0:08:29.27,Default,,0,0,0,,Лелуш қазір Икебукуро станциясының ғимаратында.
Dialogue: 0,0:08:29.40,0:08:30.11,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:30.23,0:08:33.57,Default,,0,0,0,,Өтінемін, Еремия мырза, мені босатыңыз.
Dialogue: 0,0:08:37.07,0:08:38.41,Default,,0,0,0,,Қабылданды
Dialogue: 0,0:08:45.79,0:08:47.04,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:08:47.17,0:08:50.50,Default,,0,0,0,,Мен Сузаку-кунға қоңырау шалып көрдім, бірақ не айтуым керек?
Dialogue: 0,0:08:51.09,0:08:52.13,Default,,0,0,0,,Лулу да сонда.
Dialogue: 0,0:08:52.42,0:08:54.59,Default,,0,0,0,,Ширли, сіз нені айтып тұрсыз?
Dialogue: 0,0:08:54.72,0:08:56.97,Default,,0,0,0,,Жоқ.Сізді шақырған Созаку болды ма?
Dialogue: 0,0:08:57.26,0:08:58.10,Default,,0,0,0,,Бәсекелес -
Dialogue: 0,0:08:58.22,0:09:00.97,Default,,0,0,0,,Лелух әрқашан Жапонияда болғанын айтты.
Dialogue: 0,0:09:01.10,0:09:03.89,Default,,0,0,0,,Шарт туралы есепте де оның Широ екені айтылғанымен.
Dialogue: 0,0:09:04.10,0:09:06.56,Default,,0,0,0,,Мен неге сене алмаймын?
Dialogue: 0,0:09:11.94,0:09:13.03,Default,,0,0,0,,Виллетта
Dialogue: 0,0:09:13.15,0:09:15.07,Default,,0,0,0,,Ағаңа опасыздық жасайсың ба?
Dialogue: 0,0:09:15.20,0:09:16.03,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:09:16.15,0:09:18.20,Default,,0,0,0,,Лелушпен байланысыңыз, иә?
Dialogue: 0,0:09:18.32,0:09:22.33,Default,,0,0,0,,Мен бұл жерді қорғаймын, сондықтан бәрің Икебукураға бет алыңдар.
Dialogue: 0,0:09:22.45,0:09:25.83,Default,,0,0,0,,Лелуш күтсе, ол сэр Жеремияны қысқыш шабуыл ретінде пайдалана алады.
Dialogue: 0,0:09:28.38,0:09:30.59,Default,,0,0,0,,Мен Созаку-кунға айтуым керек.
Dialogue: 0,0:09:30.96,0:09:33.71,Default,,0,0,0,,Лулу - Нөл және оның әкесінің жауы.
Dialogue: 0,0:09:37.97,0:09:39.80,Default,,0,0,0,,Бұл шекара сызығы.
Dialogue: 0,0:09:40.05,0:09:44.56,Default,,0,0,0,,Концессиялар мен геттолар бір күні жойылады
Dialogue: 0,0:09:44.68,0:09:48.44,Default,,0,0,0,,Ха, күте тұрыңыз, егер бұл екеуі сыбайлас болса?
Dialogue: 0,0:09:49.15,0:09:51.82,Default,,0,0,0,,11-ауданды Жапонияға қайтару
Dialogue: 0,0:09:51.94,0:09:55.11,Default,,0,0,0,,Иә, біз көптен бері жақын доспыз.
Dialogue: 0,0:09:57.28,0:09:58.11,Default,,0,0,0,,Га
Dialogue: 0,0:09:59.49,0:10:00.82,Default,,0,0,0,,Не болды? Ширли
Dialogue: 0,0:10:04.79,0:10:05.62,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:11.67,0:10:12.84,Default,,0,0,0,,Келме
Dialogue: 0,0:10:13.00,0:10:13.71,Default,,0,0,0,,Ширли?
Dialogue: 0,0:10:14.00,0:10:16.67,Default,,0,0,0,,Өтірікші, бәрі жалған
Dialogue: 0,0:10:17.51,0:10:18.43,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:10:18.55,0:10:19.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:21.39,0:10:22.22,Default,,0,0,0,,Құт
Dialogue: 0,0:10:24.26,0:10:25.68,Default,,0,0,0,,Ішек ішек
Dialogue: 0,0:10:29.02,0:10:29.77,Default,,0,0,0,,Құт
Dialogue: 0,0:10:30.10,0:10:31.19,Default,,0,0,0,,Уф
Dialogue: 0,0:10:36.69,0:10:37.53,Default,,0,0,0,,Га
Dialogue: 0,0:10:45.91,0:10:48.87,Default,,0,0,0,,Жоқ, жібер, жібер
Dialogue: 0,0:10:49.00,0:10:50.46,Default,,0,0,0,,Жоқ, мен сені жібермеймін.
Dialogue: 0,0:10:51.54,0:10:54.80,Default,,0,0,0,,Мен енді жеңілгім келмейді
Dialogue: 0,0:10:55.34,0:10:58.13,Default,,0,0,0,,Мен ештеңе жоғалтқым келмейді
Dialogue: 0,0:10:58.88,0:11:00.05,Default,,0,0,0,,Ширли
Dialogue: 0,0:11:01.39,0:11:02.59,Default,,0,0,0,,Иә
Dialogue: 0,0:11:07.14,0:11:08.56,Default,,0,0,0,,Созаку иә
Dialogue: 0,0:11:08.68,0:11:10.60,Default,,0,0,0,,Кууууууууу…
Dialogue: 0,0:11:10.73,0:11:11.56,Default,,0,0,0,,Уф
Dialogue: 0,0:11:17.65,0:11:20.82,Default,,0,0,0,,Эй, бұл бұрын да болған, солай ма?
Dialogue: 0,0:11:20.95,0:11:21.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:21.78,0:11:24.78,Default,,0,0,0,,Қараңдаршы, екі адам Артурды қолға түсірмек болып жатыр.
Dialogue: 0,0:11:25.24,0:11:26.45,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:11:29.58,0:11:32.33,Default,,0,0,0,,Мен мұндай нәрсе болғанына сенімдімін.
Dialogue: 0,0:11:32.83,0:11:35.04,Default,,0,0,0,,Созаку-кун әрқашан мені тартады.
Dialogue: 0,0:11:35.59,0:11:38.13,Default,,0,0,0,,Егер Лелуш жоғарыда болса, екеуі де құлап кетер еді.
Dialogue: 0,0:11:38.26,0:11:42.38,Default,,0,0,0,,Егер сіз шыдамды ақымақ болсаңыз және соншалықты көп айтқыңыз келсе, ол құлағанша оған көмектесіңіз.
Dialogue: 0,0:11:42.63,0:11:43.80,Default,,0,0,0,,Өзіңізді мәжбүрлемеңіз
Dialogue: 0,0:11:43.93,0:11:44.76,Default,,0,0,0,,Ах
Dialogue: 0,0:11:45.39,0:11:48.68,Default,,0,0,0,,Неге күлесің? Лелуч Юффиге күледі.
Dialogue: 0,0:11:52.31,0:11:55.94,Default,,0,0,0,,Жоқ, Лулу жалғыз.
Dialogue: 0,0:11:56.36,0:11:58.15,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:11:58.28,0:12:00.19,Default,,0,0,0,,Жаңадан шыққан батыр Mt. Lady –
Dialogue: 0,0:12:00.32,0:12:00.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:03.45,0:12:06.66,Default,,0,0,0,,Бауырым, абай бол, Еремия сол жаққа бара жатыр.
Dialogue: 0,0:12:07.24,0:12:10.87,Default,,0,0,0,,Мен Риодандық өлтірушімін. Менің Geass жұмыс істемеді.
Dialogue: 0,0:12:11.00,0:12:14.62,Default,,0,0,0,,Ол тірі болды ма? Ассасин болу деген нені білдіреді?
Dialogue: 0,0:12:14.75,0:12:15.67,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:12:15.79,0:12:18.84,Default,,0,0,0,,Біз жеткенше абайсызда ештеңе жасамаңыз.
Dialogue: 0,0:12:19.84,0:12:21.13,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:12:21.38,0:12:23.51,Default,,0,0,0,,Жаман, Созаку осында.
Dialogue: 0,0:12:23.88,0:12:26.68,Default,,0,0,0,,Бұл досымның қоңырауы емес сияқты.
Dialogue: 0,0:12:26.80,0:12:27.93,Default,,0,0,0,,...
Dialogue: 0,0:12:28.31,0:12:31.85,Default,,0,0,0,,Жоқ, Созаку-кун, менің ісім бірінші орында, солай ма?
Dialogue: 0,0:12:31.98,0:12:32.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:32.93,0:12:35.48,Default,,0,0,0,,Ойлап қарасам, екеуің кездесіп жатырсыңдар ғой?
Dialogue: 0,0:12:35.81,0:12:37.15,Default,,0,0,0,,Сіз оны қыздырдыңыз ба?
Dialogue: 0,0:12:37.27,0:12:38.11,Default,,0,0,0,,Хаха
Dialogue: 0,0:12:38.90,0:12:40.07,Default,,0,0,0,,Рахмет Лулу
Dialogue: 0,0:12:40.53,0:12:42.61,Default,,0,0,0,,Алдымен мені күте аласыз ба?
Dialogue: 0,0:12:42.74,0:12:44.28,Default,,0,0,0,,Кеттік, Созаку-кун.
Dialogue: 0,0:12:44.40,0:12:45.82,Default,,0,0,0,,Ой, эй, эй.
Dialogue: 0,0:12:46.45,0:12:49.99,Default,,0,0,0,,Бұл Ширлидің қауіпсіздігін ескере отырып, ұрыс алаңы болады.
Dialogue: 0,0:12:50.66,0:12:53.37,Default,,0,0,0,,Созакумен бірге болған дұрыс.
Dialogue: 0,0:13:04.22,0:13:05.55,Default,,0,0,0,,Жеремия Готвальд?
Dialogue: 0,0:13:05.68,0:13:06.68,Default,,0,0,0,,Дәптер
Dialogue: 0,0:13:08.14,0:13:08.76,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:13:08.76,0:13:10.18,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:13:08.76,0:13:10.18,Default,,0,0,0,,Не? Оқ өткізбейтін шаралар?
Dialogue: 0,0:13:11.18,0:13:12.22,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:12.35,0:13:14.98,Default,,0,0,0,,Оған Лелуш Геассы әсер етті ме?
Dialogue: 0,0:13:16.19,0:13:17.40,Default,,0,0,0,,Не? (Офицер 1) Иә?
Dialogue: 0,0:13:17.60,0:13:18.69,Default,,0,0,0,,Гуаааааааааааааааааааааааааааа
Dialogue: 0,0:13:20.98,0:13:21.98,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:13:22.23,0:13:26.24,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:13:28.03,0:13:30.03,Default,,0,0,0,,Бұл Геасстың жұмыс істемеуі ғана емес.
Dialogue: 0,0:13:30.16,0:13:32.33,Default,,0,0,0,,Оны босатуға да күш бар ма?
Dialogue: 0,0:13:33.12,0:13:35.00,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:13:35.12,0:13:37.00,Default,,0,0,0,,Бұл өрт пе? (2-ер адам) Бұл терроризм.
Dialogue: 0,0:13:38.67,0:13:39.29,Default,,0,0,0,,Га
Dialogue: 0,0:13:43.55,0:13:46.09,Default,,0,0,0,,Кел, қызғылт сары.
Dialogue: 0,0:13:46.97,0:13:49.26,Default,,0,0,0,,Не? Бұл маңызды оқиға
Dialogue: 0,0:13:50.97,0:13:51.97,Default,,0,0,0,,(Рион) Егер сұраса, олар әлемнің кез келген түкпіріне барады —
Dialogue: 0,0:13:52.60,0:13:54.22,Default,,0,0,0,,Маған Лулу ұнайды
Dialogue: 0,0:13:56.06,0:13:57.77,Default,,0,0,0,,Сіз Сузаку-кунды жек көресіз бе?
Dialogue: 0,0:13:58.77,0:13:59.77,Default,,0,0,0,,I-
Dialogue: 0,0:14:00.61,0:14:02.23,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:14:02.44,0:14:03.44,Default,,0,0,0,,Қазір ше?
Dialogue: 0,0:14:06.19,0:14:08.07,Default,,0,0,0,,Мен бұл біртүрлі деп ойладым.
Dialogue: 0,0:14:08.20,0:14:10.53,Default,,0,0,0,,Біз сондай жақсы достар едік.
Dialogue: 0,0:14:10.74,0:14:12.08,Default,,0,0,0,,Сіз ұрысып қалдыңыз ба?
Dialogue: 0,0:14:14.08,0:14:15.62,Default,,0,0,0,,Мен сені кешіре алмаймын.
Dialogue: 0,0:14:16.58,0:14:18.71,Default,,0,0,0,,Мен кешірмейтін ештеңе жоқ
Dialogue: 0,0:14:18.87,0:14:21.84,Default,,0,0,0,,Созаку-кун бұған жол бермейтініне сенімдімін.
Dialogue: 0,0:14:21.96,0:14:23.17,Default,,0,0,0,,Мен кешіргім келмейді
Dialogue: 0,0:14:24.38,0:14:26.51,Default,,0,0,0,,Мен сені баяғыда кешірдім.
Dialogue: 0,0:14:27.76,0:14:29.05,Default,,0,0,0,,Ширли, сен
Dialogue: 0,0:14:29.05,0:14:29.93,Default,,0,0,0,,Ширли, сен
Dialogue: 0,0:14:29.05,0:14:29.93,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:14:29.93,0:14:30.05,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:14:30.05,0:14:30.89,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:14:30.05,0:14:30.89,Default,,0,0,0,,Га
Dialogue: 0,0:14:31.01,0:14:34.22,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:14:34.35,0:14:35.35,Default,,0,0,0,,Өрт сөндіру бөліміне хабарласуым керек пе?
Dialogue: 0,0:14:35.47,0:14:38.44,Default,,0,0,0,,Әскерилер бірінші орында емес пе? Бұл жағдай
Dialogue: 0,0:14:38.94,0:14:41.15,Default,,0,0,0,,Бұл Жеті түндегі Сузаку Куруруги.
Dialogue: 0,0:14:41.27,0:14:43.06,Default,,0,0,0,,Аа, мынау.
Dialogue: 0,0:14:43.19,0:14:44.23,Default,,0,0,0,,Терроризмнің ықтималдығы
Dialogue: 0,0:14:44.73,0:14:48.65,Default,,0,0,0,,Бұдан былай мен айналадағы полиция мен өрт сөндіру бөлімдерін қадағалаймын.
Dialogue: 0,0:14:48.82,0:14:49.99,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:14:50.36,0:14:53.16,Default,,0,0,0,,Мен сенің оны қорғағаныңды қалаймын.
Dialogue: 0,0:14:57.16,0:14:58.96,Default,,0,0,0,,) Не? Мен жиналыстамын.
Dialogue: 0,0:14:59.08,0:15:03.17,Default,,0,0,0,,Білесіз бе, мені шақырмаған жиналыс бар ма?
Dialogue: 0,0:15:03.29,0:15:06.55,Default,,0,0,0,,Нөлден бастап апаттық байланыс. Бірдеңе дұрыс емес.
Dialogue: 0,0:15:06.67,0:15:07.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:10.84,0:15:12.05,Default,,0,0,0,,Нөлдік желдеткіш
Dialogue: 0,0:15:12.18,0:15:12.97,Default,,0,0,0,,Га
Dialogue: 0,0:15:13.35,0:15:15.39,Default,,0,0,0,,Бірдеңе болды ма? Бұл шұғыл
Dialogue: 0,0:15:15.97,0:15:16.89,Default,,0,0,0,,Егер сіз Тайваньдан болсаңыз, қазір
Dialogue: 0,0:15:17.02,0:15:17.64,Default,,0,0,0,,Желдеткіш
Dialogue: 0,0:15:18.64,0:15:19.60,Default,,0,0,0,,Ашсың ба? Міне, Майкл мен Принс
Dialogue: 0,0:15:26.61,0:15:27.69,Default,,0,0,0,,Күте тұрыңыз, ағайын.
Dialogue: 0,0:15:27.82,0:15:30.28,Default,,0,0,0,,Азаматтарды эвакуациялау бойынша нұсқаулық аяқталды
Dialogue: 0,0:15:30.40,0:15:31.45,Default,,0,0,0,,Мекемеде қалдырылды…
Dialogue: 0,0:15:31.57,0:15:32.41,Default,,0,0,0,,Лулу
Dialogue: 0,0:15:33.70,0:15:35.28,Default,,0,0,0,,Көлікке отырыңыз.
Dialogue: 0,0:15:35.41,0:15:37.70,Default,,0,0,0,,Бұл Жеті рыцарь лордының бұйрығы.
Dialogue: 0,0:15:40.00,0:15:42.00,Default,,0,0,0,,А, күте тұр, сен.
Dialogue: 0,0:15:42.83,0:15:46.25,Default,,0,0,0,,Тоқта, Лулу, мен сені жалғыз қалдырмаймын.
Dialogue: 0,0:15:50.63,0:15:51.97,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін
Dialogue: 0,0:15:55.60,0:15:57.06,Default,,0,0,0,,Лулу қайда?
Dialogue: 0,0:15:57.18,0:15:57.85,Default,,0,0,0,,Ах
Dialogue: 0,0:16:00.27,0:16:01.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:02.69,0:16:05.23,Default,,0,0,0,,Біз төбелесіп жатырмыз ғой.
Dialogue: 0,0:16:05.65,0:16:08.07,Default,,0,0,0,,Лулу жалғыз
Dialogue: 0,0:16:08.40,0:16:10.40,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:16:15.53,0:16:19.87,Default,,0,0,0,,Механикалық шанақтың берілістерін жою құралы
Dialogue: 0,0:16:19.99,0:16:22.66,Default,,0,0,0,,Сіздің табандылығыңыз жоғары деңгейде, Оранж-кун.
Dialogue: 0,0:16:22.96,0:16:25.88,Default,,0,0,0,,Бұл құмарлық емес, бұл адалдық
Dialogue: 0,0:16:26.17,0:16:27.71,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:16:27.84,0:16:31.13,Default,,0,0,0,,Бұл императорды адалдыққа не лайық етеді?
Dialogue: 0,0:16:36.59,0:16:37.97,Default,,0,0,0,,Не?
Dialogue: 0,0:16:38.22,0:16:41.85,Default,,0,0,0,,Оның орындалуы Сакурадит күткендей пайдаланылды ма?
Dialogue: 0,0:16:41.98,0:16:43.89,Default,,0,0,0,,Gefion Disturber
Dialogue: 0,0:16:44.23,0:16:46.94,Default,,0,0,0,,Әй, жақсы оқисың ғой, солай ма?
Dialogue: 0,0:16:47.06,0:16:48.27,Default,,0,0,0,,Сонда сіз түсінесіз, солай ма?
Dialogue: 0,0:16:48.40,0:16:51.57,Default,,0,0,0,,Сакурадитке кедергі жасау Бұл жүйе аяқталғаннан кейін...
Dialogue: 0,0:16:51.69,0:16:54.86,Default,,0,0,0,,Сақина сызығындағы барлық қалалық функциялар салданған.
Dialogue: 0,0:16:54.99,0:16:57.78,Default,,0,0,0,,Басқаша айтқанда, Токио орнында тұр.
Dialogue: 0,0:16:57.91,0:17:00.87,Default,,0,0,0,,Рахмет, сіз жақсы сынақ болдыңыз.
Dialogue: 0,0:17:07.21,0:17:08.04,Default,,0,0,0,,Лоло
Dialogue: 0,0:17:08.59,0:17:09.71,Default,,0,0,0,,Ширли
Dialogue: 0,0:17:11.30,0:17:12.80,Default,,0,0,0,,Lolo жауабы
Dialogue: 0,0:17:12.92,0:17:13.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:14.17,0:17:16.47,Default,,0,0,0,,Сізге Лулу ұнай ма?
Dialogue: 0,0:17:17.68,0:17:19.80,Default,,0,0,0,,Енді мен сізге бір нәрсе айтайын.
Dialogue: 0,0:17:19.93,0:17:22.64,Default,,0,0,0,,Труппаның орналасқан жері, В.В.
Dialogue: 0,0:17:22.77,0:17:25.73,Default,,0,0,0,,Сөйлейтін өзіңсің.
Dialogue: 0,0:17:25.85,0:17:26.64,Default,,0,0,0,,Не?
Dialogue: 0,0:17:26.77,0:17:29.31,Default,,0,0,0,,Менің себебім бар
Dialogue: 0,0:17:29.61,0:17:31.98,Default,,0,0,0,,Адал болуға бел байлады
Dialogue: 0,0:17:32.40,0:17:35.82,Default,,0,0,0,,Расталуы керек шындық
Dialogue: 0,0:17:36.07,0:17:37.82,Default,,0,0,0,,Ақымақ, қозғала алмайсың.
Dialogue: 0,0:17:37.99,0:17:41.74,Default,,0,0,0,,Лелуч, сен неге нөлді ойнайсың?
Dialogue: 0,0:17:41.87,0:17:46.33,Default,,0,0,0,,Отаның Британияны биологиялық әкеңе қарсы қою?
Dialogue: 0,0:17:48.88,0:17:51.38,Default,,0,0,0,,Өйткені мен Лелух ви Британиямын.
Dialogue: 0,0:17:51.63,0:17:52.59,Default,,0,0,0,,Га
Dialogue: 0,0:17:54.26,0:17:56.30,Default,,0,0,0,,Менің әкем, Британ императоры...
Dialogue: 0,0:17:56.42,0:17:58.30,Default,,0,0,0,,Мен анамды өлі қалдырдым
Dialogue: 0,0:17:58.43,0:18:01.64,Default,,0,0,0,,Нәтижесінде Нунналлидің көзі мен аяғын алып кетті...
Dialogue: 0,0:18:01.97,0:18:03.31,Default,,0,0,0,,Біздің болашағымызға дейін
Dialogue: 0,0:18:03.43,0:18:04.52,Default,,0,0,0,,Уау
Dialogue: 0,0:18:05.10,0:18:07.31,Default,,0,0,0,,Увааааааааааааааааааааааааааааааа
Dialogue: 0,0:18:08.44,0:18:12.36,Default,,0,0,0,,Білемін, мен де сонда болдым.
Dialogue: 0,0:18:12.48,0:18:13.11,Default,,0,0,0,,Ананың?
Dialogue: 0,0:18:13.48,0:18:15.15,Default,,0,0,0,,Бұл менің бірінші миссиям болды.
Dialogue: 0,0:18:15.99,0:18:18.99,Default,,0,0,0,,Сүйікті императрица Марианнаның эскорты
Dialogue: 0,0:18:20.45,0:18:23.45,Default,,0,0,0,,Бірақ мен қорғай алмадым
Dialogue: 0,0:18:23.58,0:18:25.58,Default,,0,0,0,,Мен адалдығымда сәтсіздікке ұшырадым.
Dialogue: 0,0:18:25.95,0:18:27.50,Default,,0,0,0,,Сонымен таза қандылар
Dialogue: 0,0:18:27.75,0:18:29.08,Default,,0,0,0,,Лорд Лелух
Dialogue: 0,0:18:29.46,0:18:31.54,Default,,0,0,0,,Сіз нөлге айналдыңыз...
Dialogue: 0,0:18:31.67,0:18:34.34,Default,,0,0,0,,Өйткені, бұл Марианна үшін болды.
Dialogue: 0,0:18:35.38,0:18:38.30,Default,,0,0,0,,Сен мені өлтіруге келмедің.
Dialogue: 0,0:18:38.63,0:18:42.05,Default,,0,0,0,,Менің мырзам В.В. емес-
Dialogue: 0,0:18:42.60,0:18:44.56,Default,,0,0,0,,Құрметті Марианна
Dialogue: 0,0:18:45.39,0:18:49.19,Default,,0,0,0,,Мен бұған еш өкінбеймін.
Dialogue: 0,0:18:49.31,0:18:49.94,Default,,0,0,0,,Еремия сэр
Dialogue: 0,0:18:54.90,0:18:57.44,Default,,0,0,0,,Не? Мәртебелі
Dialogue: 0,0:18:57.78,0:18:59.74,Default,,0,0,0,,Жеремия Готвальд
Dialogue: 0,0:18:59.86,0:19:02.53,Default,,0,0,0,,Сіздің адалдығыңыз әлі біткен жоқ.
Dialogue: 0,0:19:02.78,0:19:03.70,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:19:04.83,0:19:07.12,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:19:08.50,0:19:11.46,Default,,0,0,0,,Маған Лулу ұнайды, сіз ше?
Dialogue: 0,0:19:11.75,0:19:14.79,Default,,0,0,0,,Мен сені жақсы көремін, сен менің жалғыз бауырымсың.
Dialogue: 0,0:19:15.38,0:19:17.80,Default,,0,0,0,,Сен мен жағындасың, Лулу.
Dialogue: 0,0:19:17.92,0:19:18.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:18.84,0:19:21.59,Default,,0,0,0,,Маған да қосылуға рұқсат етіңіз.
Dialogue: 0,0:19:21.72,0:19:23.14,Default,,0,0,0,,Мен де Лулуды қорғағым келеді.
Dialogue: 0,0:19:24.51,0:19:27.35,Default,,0,0,0,,Мен Лулудың бақытын қайтарғым келеді.
Dialogue: 0,0:19:27.47,0:19:29.31,Default,,0,0,0,,Тіпті менің сіңілім Нана Чан қасымда болды.
Dialogue: 0,0:19:29.43,0:19:30.27,Default,,0,0,0,,Га
Dialogue: 0,0:19:33.69,0:19:35.77,Default,,0,0,0,,А, мен бірінші Еремияны жібердім.
Dialogue: 0,0:19:35.90,0:19:37.90,Default,,0,0,0,,Кез келген кедергіні жояды.
Dialogue: 0,0:19:39.36,0:19:41.36,Default,,0,0,0,,Ұрыспа, сен уже біз жақтасың.
Dialogue: 0,0:19:50.20,0:19:51.37,Default,,0,0,0,,Хошу қаласынан өтіп бара жатып
Dialogue: 0,0:19:58.71,0:19:59.88,Default,,0,0,0,,Ширли
Dialogue: 0,0:20:05.26,0:20:06.85,Default,,0,0,0,,Кім осындай?
Dialogue: 0,0:20:08.01,0:20:11.98,Default,,0,0,0,,Лулу? Ақыры сөйлескенім жақсы.
Dialogue: 0,0:20:12.23,0:20:15.27,Default,,0,0,0,,Бұл соңғы рет емес, қазір дәрігер шақырамын.
Dialogue: 0,0:20:17.11,0:20:20.86,Default,,0,0,0,,Мен, есте сақтау қабілетім қалпына келді және қатты қорықтым.
Dialogue: 0,0:20:21.78,0:20:26.91,Default,,0,0,0,,Жалған ұстаз, жады жоқ дос
Dialogue: 0,0:20:27.03,0:20:30.16,Default,,0,0,0,,Барлығы өтірік айтады
Dialogue: 0,0:20:30.29,0:20:34.25,Default,,0,0,0,,Мені бүкіл әлем бақылап тұрғандай сезінемін
Dialogue: 0,0:20:34.67,0:20:39.09,Default,,0,0,0,,Лулу мұндай әлемде жалғыз күрескен еді, солай ма?
Dialogue: 0,0:20:39.21,0:20:40.46,Default,,0,0,0,,Бір ғана адам
Dialogue: 0,0:20:41.13,0:20:46.22,Default,,0,0,0,,Міне, сондықтан мен Лулудың шынайы тұлғасы болғым келеді.
Dialogue: 0,0:20:46.84,0:20:47.89,Default,,0,0,0,,Ширли
Dialogue: 0,0:20:48.05,0:20:50.43,Default,,0,0,0,,Маған Лулу ұнайды
Dialogue: 0,0:20:50.97,0:20:53.81,Default,,0,0,0,,Мен әкемді араластырғанымды білсем де...
Dialogue: 0,0:20:53.94,0:20:55.81,Default,,0,0,0,,Мен оны жек көре алмадым
Dialogue: 0,0:20:56.94,0:20:59.86,Default,,0,0,0,,Лулу маған бәрін ұмыттырса да...
Dialogue: 0,0:20:59.98,0:21:03.99,Default,,0,0,0,,Сонда да Лулуға тағы да ғашық болдым.
Dialogue: 0,0:21:04.15,0:21:07.82,Default,,0,0,0,,Есім бұзылса да, қайта ғашық болдым.
Dialogue: 0,0:21:08.66,0:21:10.74,Default,,0,0,0,,Жоқ, өлме, Ширли.
Dialogue: 0,0:21:18.08,0:21:20.04,Default,,0,0,0,,Қанша рет қайта туылсаң да,
Dialogue: 0,0:21:20.80,0:21:24.17,Default,,0,0,0,,Мен Лулуға тағы да ғашық болатыныма сенімдімін
Dialogue: 0,0:21:24.67,0:21:27.26,Default,,0,0,0,,Бұл тағдыр ғой, солай ма?
Dialogue: 0,0:21:27.43,0:21:28.93,Default,,0,0,0,,Өлме Ширли
Dialogue: 0,0:21:29.26,0:21:31.35,Default,,0,0,0,,Өлме Өлме
Dialogue: 0,0:21:31.68,0:21:34.52,Default,,0,0,0,,Бұл жақсы, солай ма? Лулу
Dialogue: 0,0:21:35.56,0:21:40.31,Default,,0,0,0,,Қайта тусам да, Лулуға қайта ғашық болсам да
Dialogue: 0,0:21:41.02,0:21:43.82,Default,,0,0,0,,Қайта-қайта-
Dialogue: 0,0:21:43.94,0:21:47.03,Default,,0,0,0,,Ғашық болудан...
Dialogue: 0,0:21:48.45,0:21:49.45,Default,,0,0,0,,Га
Dialogue: 0,0:21:49.57,0:21:52.16,Default,,0,0,0,,Ширли? Ширли
Dialogue: 0,0:21:55.75,0:21:58.79,Default,,0,0,0,,Уф уф
Dialogue: 0,0:21:59.13,0:22:03.38,Default,,0,0,0,,Увааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:22:03.55,0:22:07.13,Default,,0,0,0,,♪～
Dialogue: 0,0:22:07.26,0:22:10.68,Default,,0,0,0,,♪Дүние жын, әділдік деген не?
Dialogue: 0,0:22:10.80,0:22:14.64,Default,,0,0,0,,♪Сұрамай тұрып, қарсылық көрсет, жамандық гүлі
Dialogue: 0,0:22:14.77,0:22:18.06,Default,,0,0,0,,♪Екіжүзділіктің армандаған көздерін бақылаңыз
Dialogue: 0,0:22:18.19,0:22:22.19,Default,,0,0,0,,♪Өмір мен зұлымдықтың арасы жоқ.
Dialogue: 0,0:22:25.61,0:22:29.11,Default,,0,0,0,,♪Жарық ұрық сияқты жоғалады
Dialogue: 0,0:22:29.24,0:22:33.08,Default,,0,0,0,,♪Ұйқыдағы қараңғылық құрсағынсың
Dialogue: 0,0:22:33.20,0:22:36.54,Default,,0,0,0,,♪Жалғыздық сүйкімді
Dialogue: 0,0:22:36.66,0:22:40.25,Default,,0,0,0,,♪Ол сенің жалғыз одақтасың болады
Dialogue: 0,0:22:40.37,0:22:43.92,Default,,0,0,0,,♪Бәрі қанға боялған
Dialogue: 0,0:22:44.05,0:22:47.84,Default,,0,0,0,,♪ Осы дәуірде дүниеге келген
Dialogue: 0,0:22:47.97,0:22:54.76,Default,,0,0,0,,♪Таңдаулы ханзадалар, шайқас – береке
Dialogue: 0,0:22:55.10,0:22:59.60,Default,,0,0,0,,♪Ах, мен сұлумын, бәрін білемін.
Dialogue: 0,0:22:59.73,0:23:03.31,Default,,0,0,0,,♪Сүйікті ана сені туады
Dialogue: 0,0:23:03.44,0:23:06.07,Default,,0,0,0,,♪Бұл сүт немен қоректенеді?
Dialogue: 0,0:23:06.19,0:23:09.86,Default,,0,0,0,,♪Тозақтағы бауырлар
Dialogue: 0,0:23:11.03,0:23:14.33,Default,,0,0,0,,♪Аянның белгісі Ақиқат дегеніміз не?
Dialogue: 0,0:23:14.45,0:23:18.33,Default,,0,0,0,,♪Белгісіз және көмілген, жасырылған тұқымдар
Dialogue: 0,0:23:18.45,0:23:21.79,Default,,0,0,0,,♪Қос жүзді қылыш, жүзді суырып алғаныңызға қаратыңыз
Dialogue: 0,0:23:21.92,0:23:25.50,Default,,0,0,0,,♪Қорғау керек нәрсеге ғана сеніңіз
Dialogue: 0,0:23:25.63,0:23:32.64,Default,,0,0,0,,♪Өзіңізді қандай болсаңыз, солай қалдырыңыз.
Dialogue: 0,0:23:37.47,0:23:39.43,Default,,0,0,0,,C.C. бірде маған айтты
Dialogue: 0,0:23:39.56,0:23:41.27,Default,,0,0,0,,Геасс – патшаның билігі.
Dialogue: 0,0:23:41.39,0:23:42.73,Default,,0,0,0,,Егер мен сені жалғыз қалдырсам
Dialogue: 0,0:23:43.15,0:23:44.11,Default,,0,0,0,,Сонда бұл...
Dialogue: 0,0:23:44.86,0:23:47.98,Default,,0,0,0,,Ширли, мен қалай түзетуге болады?
Dialogue: 0,0:23:48.36,0:23:50.90,Default,,0,0,0,,Айтшы, айт...
Dialogue: 0,0:23:52.40,0:23:58.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory