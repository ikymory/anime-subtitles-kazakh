Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.06,0:00:06.19,Default,,0,0,0,,Бұл сенің ағаң емес пе?
Dialogue: 0,0:00:06.61,0:00:08.19,Default,,0,0,0,,Бұл менмін, Нуналли.
Dialogue: 0,0:00:09.86,0:00:11.99,Default,,0,0,0,,Егер сіздің жадыңыз шынымен оралмаған болса...
Dialogue: 0,0:00:12.11,0:00:14.24,Default,,0,0,0,,Сіз Nunnally туралы білмеуіңіз мүмкін.
Dialogue: 0,0:00:14.36,0:00:17.03,Default,,0,0,0,,Жүр, Лелуч, мен саған жауап берейін.
Dialogue: 0,0:00:17.49,0:00:19.91,Default,,0,0,0,,Созаку, сен істедің.
Dialogue: 0,0:00:20.54,0:00:23.12,Default,,0,0,0,,Бұл сенің ағаң емес пе?
Dialogue: 0,0:00:24.21,0:00:26.50,Default,,0,0,0,,Жоқ, мен Нуннеллиге өтірік айта алмаймын.
Dialogue: 0,0:00:27.13,0:00:29.84,Default,,0,0,0,,I am I am
Dialogue: 0,0:00:32.09,0:00:33.26,Default,,0,0,0,,Роло?
Dialogue: 0,0:00:38.85,0:00:40.89,Default,,0,0,0,,Жақсы жұмыс, тек сұраңыз.
Dialogue: 0,0:00:41.64,0:00:43.14,Default,,0,0,0,,Уақыт шектеуін ұмытпаңыз
Dialogue: 0,0:00:43.43,0:00:44.44,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:00:44.56,0:00:45.44,Default,,0,0,0,,Тыңдаңыз, Нуннали.
Dialogue: 0,0:00:45.89,0:00:47.40,Default,,0,0,0,,Күткендей, ағайын.
Dialogue: 0,0:00:49.11,0:00:50.90,Default,,0,0,0,,Енді мен басқа біреу болып көрінуім керек
Dialogue: 0,0:00:51.03,0:00:51.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:51.86,0:00:52.82,Default,,0,0,0,,Маған керек
Dialogue: 0,0:00:52.94,0:00:54.45,Default,,0,0,0,,Менімен сөйлескеніңізді қалаймын.
Dialogue: 0,0:00:55.74,0:00:57.95,Default,,0,0,0,,Мен сені міндетті түрде алып кетемін.
Dialogue: 0,0:00:58.07,0:00:59.49,Default,,0,0,0,,Соған дейін...
Dialogue: 0,0:00:59.66,0:01:01.08,Default,,0,0,0,,Оған дейін-
Dialogue: 0,0:01:01.24,0:01:02.04,Default,,0,0,0,,Мен сені Нуннали жақсы көремін
Dialogue: 0,0:01:02.04,0:01:02.87,Default,,0,0,0,,Мен сені Нуннали жақсы көремін
Dialogue: 0,0:01:02.04,0:01:02.87,Default,,0,0,0,,Га
Dialogue: 0,0:01:05.83,0:01:08.50,Default,,0,0,0,,Менің ойымша, бұл дұрыс емес адам.
Dialogue: 0,0:01:08.75,0:01:11.00,Default,,0,0,0,,Иә, мен жай ғана студентпін.
Dialogue: 0,0:01:11.84,0:01:13.01,Default,,0,0,0,,Лелуш
Dialogue: 0,0:01:13.13,0:01:15.47,Default,,0,0,0,,Есте қалған жоқ па?
Dialogue: 0,0:01:15.72,0:01:17.30,Default,,0,0,0,,Біз оларды қашып құтылуға ешқашан жол бермейміз
Dialogue: 0,0:01:17.68,0:01:18.68,Default,,0,0,0,,Қош келдіңіз-
Dialogue: 0,0:01:18.80,0:01:21.60,Default,,0,0,0,,Мен сізді Созаку-санның аяулы досы екеніңізді естідім, сондықтан...
Dialogue: 0,0:01:21.72,0:01:25.10,Default,,0,0,0,,Мен тез құладым...
Dialogue: 0,0:01:25.31,0:01:28.44,Default,,0,0,0,,Жоқ, Мәртебелі ханшайыммен сөйлесу үлкен мәртебе.
Dialogue: 0,0:01:29.90,0:01:33.07,Default,,0,0,0,,Мен бұл телефонды қайтара аламын ба?
Dialogue: 0,0:01:33.19,0:01:35.36,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:01:37.24,0:01:40.78,Default,,0,0,0,,Кешіріңіз Нуннали, мен қате түсіндім.
Dialogue: 0,0:01:40.91,0:01:44.50,Default,,0,0,0,,Жоқ, мен таң қалдым, өйткені атмосфера ұқсас болды.
Dialogue: 0,0:01:44.91,0:01:48.92,Default,,0,0,0,,11-аймақта кездескенше.
Dialogue: 0,0:01:50.54,0:01:51.96,Default,,0,0,0,,Бағаламау
Dialogue: 0,0:01:52.09,0:01:54.34,Default,,0,0,0,,Қаншалықты тиімсіз болса да, ол нөлге тең.
Dialogue: 0,0:01:54.46,0:01:56.09,Default,,0,0,0,,Мен міндетті түрде бірдеңе істеймін.
Dialogue: 0,0:01:56.22,0:02:00.72,Default,,0,0,0,,Ол өте әлсіз. Десе де, ол империяның найза ұшы атанған адам.
Dialogue: 0,0:02:00.97,0:02:03.43,Default,,0,0,0,,Губернатор Наннелли мені алды.
Dialogue: 0,0:02:03.56,0:02:04.93,Default,,0,0,0,,Сіздің кезегіңіз емес.
Dialogue: 0,0:02:05.06,0:02:06.14,Default,,0,0,0,,Бірақ нөл
Dialogue: 0,0:02:06.27,0:02:07.14,Default,,0,0,0,,Лорд Гилдфорд
Dialogue: 0,0:02:07.27,0:02:07.94,Default,,0,0,0,,Уф
Dialogue: 0,0:02:08.06,0:02:09.60,Default,,0,0,0,,Нөл қазірдің өзінде өлді
Dialogue: 0,0:02:09.73,0:02:12.36,Default,,0,0,0,,Бүгінгі нөл өз атын айтып жатыр.
Dialogue: 0,0:02:12.61,0:02:13.98,Default,,0,0,0,,Жалған адамдардан қорқу, т.б.
Dialogue: 0,0:02:14.11,0:02:17.49,Default,,0,0,0,,Мәртебелі ханшайым Корнелияны аямайсыз ба?
Dialogue: 0,0:02:17.61,0:02:19.15,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:19.28,0:02:20.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:20.24,0:02:21.32,Default,,0,0,0,,Эрл Ллойд
Dialogue: 0,0:02:21.82,0:02:24.54,Default,,0,0,0,,Ланселот құрылғысын реттеуге біраз уақыт бөліңіз.
Dialogue: 0,0:02:24.66,0:02:26.12,Default,,0,0,0,,Мен кешігіп қалдым.
Dialogue: 0,0:02:26.41,0:02:28.54,Default,,0,0,0,,Көптен бері көрмегелі, доктор Ллойд
Dialogue: 0,0:02:28.66,0:02:31.38,Default,,0,0,0,,Жоқ, өйткені мен қазір императордың тікелей бақылауындамын.
Dialogue: 0,0:02:31.50,0:02:34.29,Default,,0,0,0,,Бұл ұлы мәртебелі императорға құрметсіздік болар еді.
Dialogue: 0,0:02:34.42,0:02:37.13,Default,,0,0,0,,Мен де кешіріңіз, Ллойд мырза.
Dialogue: 0,0:02:37.42,0:02:39.76,Default,,0,0,0,,Иә? Бірдеңе дұрыс болмады ма?
Dialogue: 0,0:02:39.88,0:02:43.05,Default,,0,0,0,,Бұл бұрынғысынша, бірақ мысал ретінде.
Dialogue: 0,0:02:43.30,0:02:45.81,Default,,0,0,0,,Иә Ханзада Шнайзелдің жолынан
Dialogue: 0,0:02:45.97,0:02:48.77,Default,,0,0,0,,Сізде екінші ханзада болуы керек.
Dialogue: 0,0:02:48.89,0:02:49.89,Default,,0,0,0,,«Біз "екінші Кира" бағыты бойынша тергеу жүргізіп жатырмыз» және олардың ынтымақтастығын сұраймыз.
Dialogue: 0,0:02:50.73,0:02:51.77,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:02:52.48,0:02:56.69,Default,,0,0,0,,Мен мұндай адасқан ақсүйектің лорд Куруругидің қамқоршысы болып қызмет ететінін білмедім.
Dialogue: 0,0:02:56.82,0:03:00.36,Default,,0,0,0,,Жаңа губернатордың біліміне де көңілім толмайды.
Dialogue: 0,0:03:01.61,0:03:04.66,Default,,0,0,0,,Созаку мырза өтірік айтып тұр ма деп ойлаймын.
Dialogue: 0,0:03:05.24,0:03:07.16,Default,,0,0,0,,Бірақ сен менің ағамсың.
Dialogue: 0,0:03:07.95,0:03:10.00,Default,,0,0,0,,Екеуіңнің араларыңда не болды?
Dialogue: 0,0:03:10.37,0:03:15.79,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:03:15.92,0:03:18.59,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:03:18.71,0:03:21.51,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:03:21.63,0:03:27.06,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:03:27.18,0:03:30.06,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:03:30.18,0:03:32.90,Default,,0,0,0,,♪Енді кеттік, мен аққан жұлдызмын
Dialogue: 0,0:03:38.69,0:03:44.16,Default,,0,0,0,,♪Дүние ыдыраса да, ешқашан өзгермейтін нәрселер бар.
Dialogue: 0,0:03:44.28,0:03:49.75,Default,,0,0,0,,♪Көз жасымызды тыйсақ та, қорғайтын нәрсе бар.
Dialogue: 0,0:03:49.87,0:03:52.62,Default,,0,0,0,,♪Он мыңдаған жылдар бұрынғы хабарлар дененің ішінде.
Dialogue: 0,0:03:52.75,0:03:55.17,Default,,0,0,0,,♪Сырылдап, ызылдай бастайды
Dialogue: 0,0:03:55.46,0:03:58.09,Default,,0,0,0,,♪Ертең қарлығаш дауыспен қоңырау шалыңыз
Dialogue: 0,0:03:58.25,0:04:01.22,Default,,0,0,0,,♪Мен сені тыртық қолыммен қорғаймын
Dialogue: 0,0:04:01.47,0:04:04.26,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:04:04.38,0:04:06.80,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:04:08.43,0:04:13.69,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:04:13.81,0:04:16.15,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:04:16.61,0:04:19.44,Default,,0,0,0,,♪Ұрыстың қай жерде екені белгісіз.
Dialogue: 0,0:04:19.57,0:04:24.95,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:04:25.07,0:04:27.57,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:04:27.70,0:04:32.16,Default,,0,0,0,,♪Тағдырды кесіп өткен аққан жұлдыз
Dialogue: 0,0:04:32.29,0:04:36.63,Default,,0,0,0,,♪Тасып жатқан көз жасыңды мен қазір алып кетемін
Dialogue: 0,0:04:45.72,0:04:47.85,Default,,0,0,0,,Жаңа генерал-губернатор жоспарланғандай ертең тағайындалады.
Dialogue: 0,0:04:47.97,0:04:49.35,Default,,0,0,0,,Сіз осы аймаққа тағайындаласыз 11.
Dialogue: 0,0:04:49.72,0:04:53.35,Default,,0,0,0,,Жаңа губернатордың аты-жөні жасырын қалады...
Dialogue: 0,0:04:53.48,0:04:56.69,Default,,0,0,0,,Мәселе Қытай Федерациясының бас консулдығында болады
Dialogue: 0,0:04:56.81,0:04:57.86,Default,,0,0,0,,Бұл шамамен нөл, солай ма?
Dialogue: 0,0:04:57.98,0:04:59.52,Default,,0,0,0,,Ресми хабарландыру болмағандықтан -
Dialogue: 0,0:04:59.65,0:05:03.15,Default,,0,0,0,,Кейбіреулер бұл тек Бас консул Такахидің қарауында дейді.
Dialogue: 0,0:05:03.40,0:05:06.41,Default,,0,0,0,,Елдегі бас консулдың қызметі күштердің арақатынасына байланысты...
Dialogue: 0,0:05:08.03,0:05:10.24,Default,,0,0,0,,11-аймақтағы жағдай қандай?
Dialogue: 0,0:05:10.37,0:05:12.66,Default,,0,0,0,,) Жақсы, мен де егжей-тегжейлі айта аламын.
Dialogue: 0,0:05:12.91,0:05:15.62,Default,,0,0,0,,Сыртқы әлемде не болып жатыр?
Dialogue: 0,0:05:15.75,0:05:18.63,Default,,0,0,0,,Өйткені мен бұл сарайдан ешқашан кеткен емеспін.
Dialogue: 0,0:05:18.75,0:05:23.51,Default,,0,0,0,,Аспан ұлы, бұл Лоян, Чжужин қаласы дүниенің орталығы.
Dialogue: 0,0:05:23.84,0:05:25.01,Default,,0,0,0,,Бірақ
Dialogue: 0,0:05:25.26,0:05:27.76,Default,,0,0,0,,Енді мен сыртқа қараймын.
Dialogue: 0,0:05:27.89,0:05:28.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.09,0:05:32.35,Default,,0,0,0,,Негізі мен бүгін сендермен қоштасуға келдім.
Dialogue: 0,0:05:32.81,0:05:33.93,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:05:34.06,0:05:37.10,Default,,0,0,0,,Алғаш достассам да
Dialogue: 0,0:05:37.52,0:05:41.73,Default,,0,0,0,,Кешіріңіз, бірақ мені күйеуім күтіп отыр.
Dialogue: 0,0:05:44.61,0:05:47.86,Default,,0,0,0,,) Ниигатадағы керек-жарақтардың түсуі жақсы өткен сияқты.
Dialogue: 0,0:05:47.99,0:05:49.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:49.28,0:05:53.08,Default,,0,0,0,,Бірақ бұл консулдыққа қайта оралудың жолы жоқ.
Dialogue: 0,0:05:53.33,0:05:54.45,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:05:56.12,0:06:00.17,Default,,0,0,0,,Жаңа губернатор Нуналли төбелесе ала ма? әпкеммен
Dialogue: 0,0:06:01.71,0:06:03.80,Default,,0,0,0,,Ұрыс? Nunnally-мен бе?
Dialogue: 0,0:06:04.21,0:06:05.67,Default,,0,0,0,,Бұл қандай әзіл?
Dialogue: 0,0:06:05.80,0:06:07.42,Default,,0,0,0,,Ендеше мен оны жалғыз қалдыруым керек пе?
Dialogue: 0,0:06:07.55,0:06:08.47,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:06:09.26,0:06:11.43,Default,,0,0,0,,Іс осылай жалғаса берсе, бұрынғыдай болады...
Dialogue: 0,0:06:11.55,0:06:13.51,Default,,0,0,0,,Nunnally қайтадан саяси құралға айналады
Dialogue: 0,0:06:13.64,0:06:16.73,Default,,0,0,0,,Жүре алмайтын, соқыр қыз...
Dialogue: 0,0:06:16.85,0:06:18.69,Default,,0,0,0,,Сіз оны бөлшек ретінде пайдалануды жоспарлап отырсыз ба?
Dialogue: 0,0:06:18.81,0:06:21.94,Default,,0,0,0,,Қарғыс атсын, мен мұның алдын алу үшін әрекет жасадым.
Dialogue: 0,0:06:22.06,0:06:23.69,Default,,0,0,0,,Қара рыцарьлар осы үшін.
Dialogue: 0,0:06:23.82,0:06:25.65,Default,,0,0,0,,Nunnally үшін нөл
Dialogue: 0,0:06:26.03,0:06:29.32,Default,,0,0,0,,Бұл сенің өмір сүру себебің екенін білемін.
Dialogue: 0,0:06:29.45,0:06:30.07,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:06:30.49,0:06:33.74,Default,,0,0,0,,Мен Нуналли бақытты өмір сүретін әлемді жасаймын.
Dialogue: 0,0:06:33.87,0:06:36.29,Default,,0,0,0,,Осы мақсатта Британияны жойыңыз.
Dialogue: 0,0:06:37.25,0:06:40.33,Default,,0,0,0,,В.В деген жігіт бар ма? Британияда?
Dialogue: 0,0:06:41.00,0:06:42.50,Default,,0,0,0,,Мен соншалықты көп білмеймін.
Dialogue: 0,0:06:42.96,0:06:45.46,Default,,0,0,0,,Бірақ В.В. сенің әкең-
Dialogue: 0,0:06:45.59,0:06:48.72,Default,,0,0,0,,Британ императоры Чарльздың бірінші жолдасы
Dialogue: 0,0:06:48.84,0:06:49.84,Default,,0,0,0,,Жолдас?
Dialogue: 0,0:06:49.97,0:06:52.22,Default,,0,0,0,,Ертеде екі адам ант беріпті
Dialogue: 0,0:06:53.14,0:06:54.76,Default,,0,0,0,,Құдайды өлтіру
Dialogue: 0,0:06:54.89,0:06:56.93,Default,,0,0,0,,Бұл біздің келісіміміз
Dialogue: 0,0:06:59.18,0:07:00.52,Default,,0,0,0,,Сәлем Чарльз
Dialogue: 0,0:07:00.64,0:07:03.15,Default,,0,0,0,,Неге Нунеллиге айтпадың?
Dialogue: 0,0:07:03.36,0:07:06.23,Default,,0,0,0,,Нөлдің шынайы тұлғасы және Геасс
Dialogue: 0,0:07:06.36,0:07:09.11,Default,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:07:10.36,0:07:13.24,Default,,0,0,0,,Чарльз, сен әлі жассың.
Dialogue: 0,0:07:13.70,0:07:16.79,Default,,0,0,0,,Солай ма, ағайын?
Dialogue: 0,0:07:23.25,0:07:24.67,Default,,0,0,0,,Губернатор Нуналли туралы не деуге болады?
Dialogue: 0,0:07:24.79,0:07:25.79,Default,,0,0,0,,Мен бақшадамын
Dialogue: 0,0:07:25.92,0:07:27.59,Default,,0,0,0,,Көпірге келсең де
Dialogue: 0,0:07:27.71,0:07:28.80,Default,,0,0,0,,Оның мағынасы жоқ.
Dialogue: 0,0:07:29.51,0:07:31.30,Default,,0,0,0,,Жоқ? қара рыцарьлар
Dialogue: 0,0:07:31.47,0:07:32.38,Default,,0,0,0,,) О
Dialogue: 0,0:07:32.51,0:07:34.93,Default,,0,0,0,,Біз де жаңа ғана тексердік.
Dialogue: 0,0:07:35.05,0:07:36.56,Default,,0,0,0,,Ақпаратпен бөлісу
Dialogue: 0,0:07:36.72,0:07:39.60,Default,,0,0,0,,Енді біздің еліміздің Британияға қарсы күресуге құқығы бар.
Dialogue: 0,0:07:39.73,0:07:42.02,Default,,0,0,0,,Ешқандай дұшпандық жоқ екенін түсінесіз деп үміттенемін.
Dialogue: 0,0:07:42.48,0:07:43.44,Default,,0,0,0,,Нөл де ме?
Dialogue: 0,0:07:43.81,0:07:45.06,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:07:45.19,0:07:47.19,Default,,0,0,0,,Бүкіл Nightmare жоғалып кетті.
Dialogue: 0,0:07:47.90,0:07:49.94,Default,,0,0,0,,Ол жер асты деңгейінен шығып кеткен сияқты.
Dialogue: 0,0:07:50.53,0:07:51.36,Default,,0,0,0,,Мінез-құлқы: Талғампаз
Dialogue: 0,0:07:51.49,0:07:53.07,Default,,0,0,0,,Осы уақытқа дейін.
Dialogue: 0,0:07:53.20,0:07:54.87,Default,,0,0,0,,Нуналли емес пе?
Dialogue: 0,0:07:54.99,0:07:55.99,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:07:56.41,0:07:58.54,Default,,0,0,0,,Қайтып оралғыңыз келе ме?
Dialogue: 0,0:07:58.66,0:08:02.37,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:02.62,0:08:03.79,Default,,0,0,0,,Қара рыцарьлар?
Dialogue: 0,0:08:04.12,0:08:07.92,Default,,0,0,0,,Операцияның мақсаты - жаңа губернаторды ұстау.
Dialogue: 0,0:08:08.05,0:08:10.71,Default,,0,0,0,,Ешбір жағдайда ешкімді ренжітпеңіз
Dialogue: 0,0:08:10.84,0:08:12.72,Default,,0,0,0,,Жақсы, мүлдем.
Dialogue: 0,0:08:12.92,0:08:14.01,Default,,0,0,0,,Растау
Dialogue: 0,0:08:18.10,0:08:19.26,Default,,0,0,0,,) Не істеп жатырсың, Тамаки?
Dialogue: 0,0:08:21.56,0:08:22.39,Default,,0,0,0,,Әуесқой
Dialogue: 0,0:08:22.93,0:08:24.81,Default,,0,0,0,,Құрлық қаруын аспанға көтерсең де
Dialogue: 0,0:08:24.94,0:08:26.15,Default,,0,0,0,,Ха...
Dialogue: 0,0:08:27.44,0:08:29.82,Default,,0,0,0,,Беткі жарқырау қолданылса да проблема жоқ
Dialogue: 0,0:08:29.94,0:08:31.03,Default,,0,0,0,,Қоршау және ұру
Dialogue: 0,0:08:32.69,0:08:34.74,Default,,0,0,0,,) Генерал Тодо, мен мұны сізге қалдырамын.
Dialogue: 0,0:08:34.95,0:08:37.12,Default,,0,0,0,,Әй, командирдің орынбасарлары да аман.
Dialogue: 0,0:08:42.87,0:08:44.21,Default,,0,0,0,,Кез келген жағдайда, мұның үстіне?
Dialogue: 0,0:08:47.58,0:08:48.42,Default,,0,0,0,,Дұшпандық түнгі түн
Dialogue: 0,0:08:48.54,0:08:50.75,Default,,0,0,0,,Кеменің негізгі қанаттарына тағы екі ұшақ бекітілді.
Dialogue: 0,0:08:50.88,0:08:52.30,Default,,0,0,0,,Ол да еріп жүретін кемеге қосылған сияқты.
Dialogue: 0,0:08:52.42,0:08:53.76,Default,,0,0,0,,Ауа қуаты
Dialogue: 0,0:08:55.72,0:08:57.30,Default,,0,0,0,,Сен ақымақ командир.
Dialogue: 0,0:08:57.43,0:09:00.01,Default,,0,0,0,,Тек ауа қуатын түтінге шоғырландыру.
Dialogue: 0,0:09:00.14,0:09:01.31,Default,,0,0,0,,Оқылған
Dialogue: 0,0:09:04.35,0:09:06.19,Default,,0,0,0,,Мен флагманнан басқа ешнәрсеге пайдасы жоқ.
Dialogue: 0,0:09:09.15,0:09:11.44,Default,,0,0,0,,Жарайды, біз кетеміз.
Dialogue: 0,0:09:11.94,0:09:15.11,Default,,0,0,0,,Қалған әуе-жауынгерлік әскерлерді жіберіңіз, сондай-ақ эскорт кемелерінен оқ жаудырыңыз.
Dialogue: 0,0:09:15.24,0:09:17.57,Default,,0,0,0,,Бірақ жау майданды нысанаға алып отыр.
Dialogue: 0,0:09:17.70,0:09:19.57,Default,,0,0,0,,Қалқан орналастырылғандықтан, мақсат
Dialogue: 0,0:09:19.83,0:09:21.91,Default,,0,0,0,,Осыны орындамасақ не істейміз?
Dialogue: 0,0:09:22.04,0:09:23.54,Default,,0,0,0,,Қарғыс атсын, егер солай болса...
Dialogue: 0,0:09:23.66,0:09:26.00,Default,,0,0,0,,Лорд Гилдфордты да өзіңізбен бірге алып келуіңіз керек еді.
Dialogue: 0,0:09:26.33,0:09:29.84,Default,,0,0,0,,Токио концессиясынан қосымша күштер келсе де, оған бір сағаттай уақыт кетеді.
Dialogue: 0,0:09:30.17,0:09:32.25,Default,,0,0,0,,Ішке Nightmare кірсе ше?
Dialogue: 0,0:09:32.38,0:09:35.05,Default,,0,0,0,,Бұл апат. Керісінше, біз тірі қалғандарды іздейміз.
Dialogue: 0,0:09:35.17,0:09:36.09,Default,,0,0,0,,Уау (солдат) Уау
Dialogue: 0,0:09:38.80,0:09:40.05,Default,,0,0,0,,А... мүмкін емес
Dialogue: 0,0:09:42.26,0:09:43.18,Default,,0,0,0,,Өл
Dialogue: 0,0:09:49.81,0:09:50.86,Default,,0,0,0,,О
Dialogue: 0,0:09:50.98,0:09:52.15,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:09:52.73,0:09:54.36,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:56.65,0:09:59.61,Default,,0,0,0,,Нуннал, мен қазір саған көмектесемін.
Dialogue: 0,0:10:07.00,0:10:07.62,Default,,0,0,0,,Құпия техника-
Dialogue: 0,0:10:08.50,0:10:10.67,Default,,0,0,0,,Сегіз қайықпен ұшу.
Dialogue: 0,0:10:11.63,0:10:13.09,Default,,0,0,0,,Тіпті қалқан орнатылған болса да-
Dialogue: 0,0:10:13.21,0:10:15.46,Default,,0,0,0,,Ішке кіргеннен кейін ол менікі.
Dialogue: 0,0:10:15.59,0:10:17.59,Default,,0,0,0,,Әуе күші бітетін сияқты.
Dialogue: 0,0:10:17.72,0:10:20.59,Default,,0,0,0,,Жүзіп жүрсең, Инабаның ақ қоянына айналасың.
Dialogue: 0,0:10:20.89,0:10:22.76,Default,,0,0,0,,Иә иә, негіздерге адал...
Dialogue: 0,0:10:22.89,0:10:23.51,Default,,0,0,0,,Уф
Dialogue: 0,0:10:25.97,0:10:28.06,Default,,0,0,0,,Токиодан келген күшейтулер? тым ерте
Dialogue: 0,0:10:28.39,0:10:30.73,Default,,0,0,0,,Жоқ, бағыт – тылға дайындалу.
Dialogue: 0,0:10:31.10,0:10:33.06,Default,,0,0,0,,Ал қалқымалы бірлік?
Dialogue: 0,0:10:33.32,0:10:34.23,Default,,0,0,0,,Қорқыныш
Dialogue: 0,0:10:34.36,0:10:35.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:35.40,0:10:37.74,Default,,0,0,0,,Бұл ұшақ
Dialogue: 0,0:10:37.90,0:10:39.99,Default,,0,0,0,,Енді шымылдықты түсірейік
Dialogue: 0,0:10:40.28,0:10:41.99,Default,,0,0,0,,Барлық машиналар шығысы қалыпты.
Dialogue: 0,0:10:42.16,0:10:44.20,Default,,0,0,0,,Жаппай өндіріс қызық.
Dialogue: 0,0:10:44.33,0:10:46.12,Default,,0,0,0,,Бұл шынымен де жақсы болды ма?
Dialogue: 0,0:10:46.24,0:10:47.83,Default,,0,0,0,,Жоғары мәртебелі Шнайзелге арналған шығындар
Dialogue: 0,0:10:48.08,0:10:50.54,Default,,0,0,0,,Бұл жақсы емес пе? Сіз оны ақырында түсінесіз
Dialogue: 0,0:10:50.79,0:10:53.71,Default,,0,0,0,,Иә? Сіз сөйлеген жоқсыз ба?
Dialogue: 0,0:10:53.92,0:10:55.30,Default,,0,0,0,,Мен ұша алмасам да
Dialogue: 0,0:10:57.51,0:10:58.67,Default,,0,0,0,,Менің түйсігім жаман емес.
Dialogue: 0,0:10:58.92,0:11:00.76,Default,,0,0,0,,Бірақ ұшақ сипаттамалары туралы не деуге болады?
Dialogue: 0,0:11:00.88,0:11:01.89,Default,,0,0,0,,Құт
Dialogue: 0,0:11:03.26,0:11:04.26,Default,,0,0,0,,Кешіріңіз, қалғаны солай
Dialogue: 0,0:11:05.51,0:11:07.56,Default,,0,0,0,,Гилфорд, қалағаныңды істе.
Dialogue: 0,0:11:07.68,0:11:08.89,Default,,0,0,0,,Бірақ бұл маған көмектесті.
Dialogue: 0,0:11:09.18,0:11:11.19,Default,,0,0,0,,Бұл оның еңбегі.
Dialogue: 0,0:11:11.90,0:11:14.15,Default,,0,0,0,,Шарт жойылды
Dialogue: 0,0:11:14.36,0:11:16.69,Default,,0,0,0,,Бұл соғыс толқынын өзгертеді.
Dialogue: 0,0:11:18.82,0:11:21.15,Default,,0,0,0,,На Нуналли
Dialogue: 0,0:11:28.58,0:11:30.00,Default,,0,0,0,,Эй, Нөл бортта.
Dialogue: 0,0:11:30.12,0:11:31.50,Default,,0,0,0,,Күзетші не істейді?
Dialogue: 0,0:11:31.62,0:11:32.83,Default,,0,0,0,,Губернатор Нуналли Нөл.
Dialogue: 0,0:11:32.96,0:11:33.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:33.71,0:11:35.00,Default,,0,0,0,,Енді генерал Апсонға.
Dialogue: 0,0:11:35.13,0:11:36.34,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:36.96,0:11:40.38,Default,,0,0,0,,Екі адамның кездесуіне кедергі жасамаңыз.
Dialogue: 0,0:11:41.93,0:11:44.26,Default,,0,0,0,,На Нуналли
Dialogue: 0,0:11:46.85,0:11:48.01,Default,,0,0,0,,Біз ақыры кездестік
Dialogue: 0,0:11:48.43,0:11:49.56,Default,,0,0,0,,Сол екі клонды бір-бірімен шайқастырып отыр—
Dialogue: 0,0:11:50.60,0:11:53.27,Default,,0,0,0,,Бұл жерде нөл.
Dialogue: 0,0:11:53.56,0:11:55.06,Default,,0,0,0,,Мені де өлтіресің бе?
Dialogue: 0,0:11:56.06,0:11:59.44,Default,,0,0,0,,Кловис аға мен Юффи апа сияқты.
Dialogue: 0,0:12:00.53,0:12:03.36,Default,,0,0,0,,Бірақ сәл күте аласыз ба?
Dialogue: 0,0:12:04.78,0:12:07.62,Default,,0,0,0,,Менің ойымша, сіз қателесесіз.
Dialogue: 0,0:12:09.79,0:12:11.04,Default,,0,0,0,,Қарғыс атсын Харкен.
Dialogue: 0,0:12:11.16,0:12:12.37,Default,,0,0,0,,Енді, Акацуки-кун
Dialogue: 0,0:12:12.58,0:12:13.46,Default,,0,0,0,,Иә
Dialogue: 0,0:12:13.58,0:12:14.75,Default,,0,0,0,,Ішек
Dialogue: 0,0:12:19.17,0:12:20.05,Default,,0,0,0,,Га
Dialogue: 0,0:12:21.51,0:12:23.22,Default,,0,0,0,,Енді жазалау уақыты.
Dialogue: 0,0:12:23.43,0:12:24.97,Default,,0,0,0,,Бұл біртүрлі жойғыш ұшақ.
Dialogue: 0,0:12:25.34,0:12:26.39,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:29.93,0:12:31.52,Default,,0,0,0,,Қорқыныш? Уф
Dialogue: 0,0:12:34.89,0:12:36.31,Default,,0,0,0,,Кешіріңіз, қалғандары
Dialogue: 0,0:12:37.15,0:12:38.69,Default,,0,0,0,,4 жау қалды.
Dialogue: 0,0:12:39.36,0:12:42.94,Default,,0,0,0,,Қоңыр түнге дейін Бұл менің рейтингім.
Dialogue: 0,0:12:43.07,0:12:43.99,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:12:44.11,0:12:44.82,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:45.41,0:12:47.20,Default,,0,0,0,,Оң қанатты сүйемелдеу кемесі рульді басқара алмайды
Dialogue: 0,0:12:47.32,0:12:47.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:48.24,0:12:49.24,Default,,0,0,0,,Осы жылдамдықпен негізгі кеме
Dialogue: 0,0:12:49.37,0:12:50.49,Default,,0,0,0,,Курсты өзгерту
Dialogue: 0,0:12:50.62,0:12:51.24,Default,,0,0,0,,Уақытында емес
Dialogue: 0,0:12:51.37,0:12:52.25,Default,,0,0,0,,Соқтығыс
Dialogue: 0,0:12:59.04,0:12:59.88,Default,,0,0,0,,Уау
Dialogue: 0,0:13:01.76,0:13:02.59,Default,,0,0,0,,Иә
Dialogue: 0,0:13:02.88,0:13:05.84,Default,,0,0,0,,Әдеттегідей, Мордред не істейді
Dialogue: 0,0:13:06.22,0:13:08.55,Default,,0,0,0,,Аня, енді оны қолданба.
Dialogue: 0,0:13:08.68,0:13:10.89,Default,,0,0,0,,Губернаторды өлтіру жаман болар еді, солай емес пе?
Dialogue: 0,0:13:11.26,0:13:12.47,Default,,0,0,0,,Мен оны сақтадым.
Dialogue: 0,0:13:14.64,0:13:16.14,Default,,0,0,0,,Ллойд мырза, Ланселот ше?
Dialogue: 0,0:13:16.35,0:13:19.23,Default,,0,0,0,,Мен дайынмын, тез кел.
Dialogue: 0,0:13:20.90,0:13:22.94,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз, генерал?
Dialogue: 0,0:13:23.74,0:13:25.53,Default,,0,0,0,,Бұлай жалғаса берсе, сіз төмендетесіз.
Dialogue: 0,0:13:25.65,0:13:29.28,Default,,0,0,0,,Өз қолыммен жеткен жетістіктер Қара рыцарьлар
Dialogue: 0,0:13:29.41,0:13:30.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:30.16,0:13:31.99,Default,,0,0,0,,Вахахахахахаха
Dialogue: 0,0:13:33.58,0:13:35.75,Default,,0,0,0,,Өз қозғалтқышын ақымақ
Dialogue: 0,0:13:36.58,0:13:37.21,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,0:13:41.38,0:13:44.09,Default,,0,0,0,,Дәл қазір менің алдымда Нөл тұр.
Dialogue: 0,0:13:44.76,0:13:48.38,Default,,0,0,0,,Бауырым, маған қайрат берші.
Dialogue: 0,0:13:49.22,0:13:51.55,Default,,0,0,0,,Британия қате.
Dialogue: 0,0:13:51.72,0:13:54.97,Default,,0,0,0,,Император күш – абсолютті шама деп есептейді.
Dialogue: 0,0:13:55.48,0:13:57.69,Default,,0,0,0,,Сіз де мұнымен келісесіз бе?
Dialogue: 0,0:13:57.81,0:13:58.98,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:13:59.31,0:14:02.94,Default,,0,0,0,,Губернатор Нуналли, сізді жаңа ғана пайдаланып жатырсыз.
Dialogue: 0,0:14:03.40,0:14:05.74,Default,,0,0,0,,Соқыр, ақсақ болсам...
Dialogue: 0,0:14:05.86,0:14:07.82,Default,,0,0,0,,Барлығының жанашырлығын ала алсаңыз ше?
Dialogue: 0,0:14:07.95,0:14:08.86,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:14:08.99,0:14:09.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:09.95,0:14:12.41,Default,,0,0,0,,Мен мұны өзім қаладым.
Dialogue: 0,0:14:12.53,0:14:13.33,Default,,0,0,0,,На
Dialogue: 0,0:14:15.54,0:14:16.66,Default,,0,0,0,,Нөл дегеніміз не?
Dialogue: 0,0:14:17.21,0:14:19.58,Default,,0,0,0,,ECCM себебінен сізбен байланыса алмаймын.
Dialogue: 0,0:14:19.71,0:14:23.29,Default,,0,0,0,,Мен Чиба Акацукимен тылда кездесіп, кемені іздегім келеді.
Dialogue: 0,0:14:23.42,0:14:26.17,Default,,0,0,0,,Бірақ бұл кеме апатқа ұшырағалы тұр.
Dialogue: 0,0:14:26.30,0:14:27.51,Default,,0,0,0,,Уақыт
Dialogue: 0,0:14:27.92,0:14:28.59,Default,,0,0,0,,Сенба
Dialogue: 0,0:14:30.64,0:14:33.05,Default,,0,0,0,,Мен әлсіздерді қорлағанды ұнатпаймын.
Dialogue: 0,0:14:33.47,0:14:35.77,Default,,0,0,0,,Мұндай жерде
Dialogue: 0,0:14:36.56,0:14:37.85,Default,,0,0,0,,Сенба!
Dialogue: 0,0:14:38.10,0:14:40.73,Default,,0,0,0,,Todo Құрлықтағы қаруды қолданып күтпеген шабуыл дегеніміз не?
Dialogue: 0,0:14:40.85,0:14:42.36,Default,,0,0,0,,Бұл сенің ұрысыңа ұқсамайтын шайқас.
Dialogue: 0,0:14:44.07,0:14:45.98,Default,,0,0,0,,Сіз не қаладыңыз?
Dialogue: 0,0:14:46.11,0:14:48.15,Default,,0,0,0,,Әлем тыныш болады.
Dialogue: 0,0:14:48.28,0:14:50.16,Default,,0,0,0,,Менің ойымша, біз ақырын өзгере аламыз.
Dialogue: 0,0:14:50.45,0:14:54.03,Default,,0,0,0,,Сондықтан мен Юффи апаның өсиетін орындаймын.
Dialogue: 0,0:14:54.16,0:14:55.91,Default,,0,0,0,,Жапониядағы тағы да арнайы әкімшілік аймақтар
Dialogue: 0,0:14:56.16,0:14:57.58,Default,,0,0,0,,Қайта тірілу туралы не деуге болады?
Dialogue: 0,0:14:58.16,0:15:02.46,Default,,0,0,0,,Нөл Сол жерде бізге қосыла аласыз ба?
Dialogue: 0,0:15:03.54,0:15:04.46,Default,,0,0,0,,Уф
Dialogue: 0,0:15:05.17,0:15:06.80,Default,,0,0,0,,Қайтадан бастауға мүмкіндігіңіз болуы керек
Dialogue: 0,0:15:06.92,0:15:07.80,Default,,0,0,0,,Адамдар
Dialogue: 0,0:15:10.63,0:15:12.47,Default,,0,0,0,,Нөл Нуналлиді ұрлауға келді
Dialogue: 0,0:15:12.72,0:15:15.43,Default,,0,0,0,,Бірақ Кишодан хабар жоқ.
Dialogue: 0,0:15:15.56,0:15:17.64,Default,,0,0,0,,Жау нөл ме, әлде Лелуш па?
Dialogue: 0,0:15:17.85,0:15:20.35,Default,,0,0,0,,Лорд Куруруги мен жағдайды тексеремін.
Dialogue: 0,0:15:21.02,0:15:24.27,Default,,0,0,0,,Губернатор Наннелли мінген ұшақтың екінші қалқымасы тоқтатылды.
Dialogue: 0,0:15:24.73,0:15:27.07,Default,,0,0,0,,No 3 қалқымалы және No 4 қалтқымен өзара байланыс
Dialogue: 0,0:15:27.19,0:15:28.49,Default,,0,0,0,,Тетаның пайда болуы
Dialogue: 0,0:15:32.86,0:15:34.28,Default,,0,0,0,,Ал, жылдам әңгіме...
Dialogue: 0,0:15:34.41,0:15:37.08,Default,,0,0,0,,Осылай жалғаса берсе, бәріміз теңізде жүзетін боламыз.
Dialogue: 0,0:15:37.20,0:15:40.66,Default,,0,0,0,,Сондай-ақ генерал Апсон соғыс кезінде қаза тапты деген мәліметтер бар ма?
Dialogue: 0,0:15:41.58,0:15:44.17,Default,,0,0,0,,Дәл қазір менің басымдылығым губернаторды құтқару.
Dialogue: 0,0:15:47.25,0:15:49.84,Default,,0,0,0,,Мүгедектер орындығын іздеу сигналын бастау
Dialogue: 0,0:15:49.96,0:15:52.72,Default,,0,0,0,,Шуды тазалауды ECM арқылы бастайды
Dialogue: 0,0:15:52.84,0:15:54.05,Default,,0,0,0,,Алдын ала орнатылған фаза
Dialogue: 0,0:15:54.18,0:15:55.93,Default,,0,0,0,,Алдын ала бортқа орналастыру Беріліс
Dialogue: 0,0:15:56.05,0:15:56.93,Default,,0,0,0,,Деректер сілтемесін растау
Dialogue: 0,0:15:57.06,0:15:57.81,Default,,0,0,0,,Толық
Dialogue: 0,0:15:58.14,0:16:00.77,Default,,0,0,0,,Губернатордың ағымдағы орнын растағаннан кейін жіберіңіз.
Dialogue: 0,0:16:00.89,0:16:02.60,Default,,0,0,0,,МБ Раджа арнасы
Dialogue: 0,0:16:03.85,0:16:05.27,Default,,0,0,0,,Ланселот жаулап алушы
Dialogue: 0,0:16:05.48,0:16:06.19,Default,,0,0,0,,Іске қосыңыз!
Dialogue: 0,0:16:06.48,0:16:07.11,Default,,0,0,0,,Іске қосыңыз!
Dialogue: 0,0:16:16.53,0:16:17.16,Default,,0,0,0,,Га
Dialogue: 0,0:16:19.45,0:16:22.46,Default,,0,0,0,,Карен Мен Наннеллиге көмектесуім керек.
Dialogue: 0,0:16:23.37,0:16:24.58,Default,,0,0,0,,Қазір кешірім...
Dialogue: 0,0:16:26.67,0:16:27.88,Default,,0,0,0,,Мен жалынбаймын
Dialogue: 0,0:16:28.46,0:16:30.80,Default,,0,0,0,,Жасырын, Акацуки, бір рет кеменің ішінде.
Dialogue: 0,0:16:30.92,0:16:32.84,Default,,0,0,0,,Бірақ бәрі қашып кеткенше
Dialogue: 0,0:16:37.14,0:16:37.85,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:16:40.18,0:16:40.93,Default,,0,0,0,,Акацуки!
Dialogue: 0,0:16:42.73,0:16:43.56,Default,,0,0,0,,Уф
Dialogue: 0,0:16:44.27,0:16:45.94,Default,,0,0,0,,Акацукиден құтылу тұтқасы
Dialogue: 0,0:16:46.60,0:16:48.23,Default,,0,0,0,,Жоқ, ол жұмыс істемейді.
Dialogue: 0,0:16:48.61,0:16:51.23,Default,,0,0,0,,Нашар техникалық қызмет көрсету? Осындай кездерде
Dialogue: 0,0:16:51.78,0:16:52.49,Default,,0,0,0,,Ішек
Dialogue: 0,0:16:52.78,0:16:55.11,Default,,0,0,0,,Соңы Жасырынбақ
Dialogue: 0,0:17:04.29,0:17:06.33,Default,,0,0,0,,Уф, мен құлап жатырмын.
Dialogue: 0,0:17:06.83,0:17:08.75,Default,,0,0,0,,Кешіріңіз, Гурен
Dialogue: 0,0:17:09.84,0:17:11.30,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:17:11.63,0:17:12.92,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:17:14.84,0:17:16.38,Default,,0,0,0,,Ең жақсы позиция емес
Dialogue: 0,0:17:16.68,0:17:18.18,Default,,0,0,0,,Не? Ракшата мырза?
Dialogue: 0,0:17:18.51,0:17:22.10,Default,,0,0,0,,Күткеніңізге рахмет. Қара рыцарьлардың арнайы ұшатын сырғанау қанаттары.
Dialogue: 0,0:17:22.22,0:17:24.23,Default,,0,0,0,,Оқулыққа дұрыс дайындалдың ба?
Dialogue: 0,0:17:24.35,0:17:26.06,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:17:26.48,0:17:28.35,Default,,0,0,0,,Олай болса нақты көрсетілімге көшейік.
Dialogue: 0,0:17:28.48,0:17:30.65,Default,,0,0,0,,Негізгі нұсқаулық осы жерде орындалады.
Dialogue: 0,0:17:31.11,0:17:33.03,Default,,0,0,0,,Мен Нөл-саманың құтқарылуын сұраймын.
Dialogue: 0,0:17:33.15,0:17:34.19,Default,,0,0,0,,Иә
Dialogue: 0,0:17:34.65,0:17:36.53,Default,,0,0,0,,№3 тік ұшыру түтігі ашық
Dialogue: 0,0:17:36.65,0:17:39.45,Default,,0,0,0,,Guren 2 типті негізгі корпуспен қосылу сигналын тексеру
Dialogue: 0,0:17:39.99,0:17:42.79,Default,,0,0,0,,Қалықтаған ұшатын сырғанау қанаттары
Dialogue: 0,0:17:45.16,0:17:46.00,Default,,0,0,0,,Иілу
Dialogue: 0,0:17:50.25,0:17:51.63,Default,,0,0,0,,Бағыттау сигналын растау
Dialogue: 0,0:17:51.75,0:17:53.21,Default,,0,0,0,,Баптау осі Метрикалық жақсы
Dialogue: 0,0:17:53.34,0:17:54.17,Default,,0,0,0,,Жалғау
Dialogue: 0,0:17:54.51,0:17:55.67,Default,,0,0,0,,Жалғау
Dialogue: 0,0:18:00.22,0:18:01.89,Default,,0,0,0,,Ұшу
Dialogue: 0,0:18:04.81,0:18:07.44,Default,,0,0,0,,Жалғасы Құрыш-тескіш оң қол
Dialogue: 0,0:18:08.02,0:18:10.56,Default,,0,0,0,,Оң қол қосылым жылдамдығына дейін баяулайды
Dialogue: 0,0:18:10.69,0:18:13.78,Default,,0,0,0,,Беріліс нейрондық үтір 5-тен үтір 8 MMP
Dialogue: 0,0:18:13.90,0:18:15.07,Default,,0,0,0,,Мүгедектік сезімі жоқ
Dialogue: 0,0:18:15.19,0:18:18.40,Default,,0,0,0,,1-ден 5-ке дейінгі бүгу-созғыш бұлшықеттер қалыпты жұмыс істейді
Dialogue: 0,0:18:18.86,0:18:22.53,Default,,0,0,0,,Соққыдан басқару стартты тексеру Қосуға болады
Dialogue: 0,0:18:23.62,0:18:25.33,Default,,0,0,0,,Карен, өтінемін
Dialogue: 0,0:18:32.50,0:18:33.96,Default,,0,0,0,,Қанша жау болса да
Dialogue: 0,0:18:38.17,0:18:39.59,Default,,0,0,0,,Біздің команда Тододы қуып келеді.
Dialogue: 0,0:18:39.72,0:18:41.59,Default,,0,0,0,,Әй, бұл губернатор.
Dialogue: 0,0:18:41.72,0:18:43.85,Default,,0,0,0,,Иә? Аспанда?
Dialogue: 0,0:18:43.97,0:18:45.72,Default,,0,0,0,,Қара рыцарьлардың да қалқымасы бар ма?
Dialogue: 0,0:18:46.18,0:18:47.68,Default,,0,0,0,,Акацуки-кун Нөл
Dialogue: 0,0:18:47.81,0:18:48.89,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:18:50.35,0:18:53.73,Default,,0,0,0,,Хо, сенде аспан мен қалқан бар, бірақ
Dialogue: 0,0:18:54.11,0:18:56.78,Default,,0,0,0,,Бұл гурен жұмыс істемесе, бітті.
Dialogue: 0,0:18:56.98,0:19:00.07,Default,,0,0,0,,Бірақ бізде оны сынаудан басқа амал жоқ.
Dialogue: 0,0:19:00.20,0:19:01.99,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:07.33,0:19:09.16,Default,,0,0,0,,А, алыс па?
Dialogue: 0,0:19:09.29,0:19:10.12,Default,,0,0,0,,Құт
Dialogue: 0,0:19:13.13,0:19:15.75,Default,,0,0,0,,Сіз мұны осы Гурен Кашо стилімен жасай аласыз.
Dialogue: 0,0:19:15.92,0:19:16.88,Default,,0,0,0,,Иә
Dialogue: 0,0:19:17.17,0:19:18.80,Default,,0,0,0,,Созаку, сен губернаторсың.
Dialogue: 0,0:19:18.92,0:19:19.88,Default,,0,0,0,,Сақтығыңызды түсірмеңіз
Dialogue: 0,0:19:20.01,0:19:22.76,Default,,0,0,0,,Менің қарсыласым – бір кездері сэр Еремияны жеңген ұшқыш.
Dialogue: 0,0:19:22.89,0:19:24.14,Default,,0,0,0,,Мына апельсин?
Dialogue: 0,0:19:25.30,0:19:26.06,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:19:30.35,0:19:32.73,Default,,0,0,0,,Ей, сен Раундтар сияқты шеберсің бе?
Dialogue: 0,0:19:32.94,0:19:34.44,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:19:37.73,0:19:39.82,Default,,0,0,0,,Гүренді жалама
Dialogue: 0,0:19:40.36,0:19:42.41,Default,,0,0,0,,Қарғыс атсын, аяқ киіммен
Dialogue: 0,0:19:46.03,0:19:47.66,Default,,0,0,0,,Кейінірек күте аласыз.
Dialogue: 0,0:19:52.67,0:19:54.96,Default,,0,0,0,,Иә? Одан да кең ауқым?
Dialogue: 0,0:19:55.08,0:19:56.25,Default,,0,0,0,,Энергияның жалпы мөлшері қанша?
Dialogue: 0,0:19:56.38,0:19:57.75,Default,,0,0,0,,Мен оны жай ғана таратып жібердім.
Dialogue: 0,0:19:58.25,0:20:01.55,Default,,0,0,0,,Дегенмен, ұшақтың зақымдануына байланысты біраз уақыт қозғала алмаймын деп ойлаймын.
Dialogue: 0,0:20:02.13,0:20:04.68,Default,,0,0,0,,Не? сол қорқынышты түс
Dialogue: 0,0:20:04.97,0:20:07.10,Default,,0,0,0,,Жоқ, бұл ұшқыш.
Dialogue: 0,0:20:07.43,0:20:08.97,Default,,0,0,0,,Мен байсалды болуым керек еді.
Dialogue: 0,0:20:09.68,0:20:12.52,Default,,0,0,0,,Карен, сенің бұл жағдайда тағы келетініңе сенбеймін.
Dialogue: 0,0:20:13.19,0:20:15.35,Default,,0,0,0,,Флагманның ішінде шынымен нөл бар ма?
Dialogue: 0,0:20:15.56,0:20:17.40,Default,,0,0,0,,Жолдан шығыңыз
Dialogue: 0,0:20:17.77,0:20:19.78,Default,,0,0,0,,Маған Gefionnet жеуге рұқсат етпе
Dialogue: 0,0:20:25.87,0:20:27.33,Default,,0,0,0,,Бұл қазірдің өзінде қарастырылған.
Dialogue: 0,0:20:28.45,0:20:30.33,Default,,0,0,0,,Бірақ аяғым тоқтап қалды.
Dialogue: 0,0:20:33.29,0:20:34.50,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:20:34.62,0:20:37.50,Default,,0,0,0,,Yggdrasil Drive қуаты да артуы керек еді.
Dialogue: 0,0:20:37.63,0:20:38.75,Default,,0,0,0,,Сузаку-кун
Dialogue: 0,0:20:39.21,0:20:41.13,Default,,0,0,0,,Мен губернатордың қазіргі орнын білемін.
Dialogue: 0,0:20:41.26,0:20:43.51,Default,,0,0,0,,Негізгі көпірдің артындағы бақша кеңістігі
Dialogue: 0,0:20:43.63,0:20:45.80,Default,,0,0,0,,Бірақ бұзылуға 47 секунд қалды.
Dialogue: 0,0:20:45.93,0:20:47.14,Default,,0,0,0,,Мен сізге міндетті түрде көмектесемін
Dialogue: 0,0:20:48.26,0:20:49.43,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:20:49.72,0:20:50.85,Default,,0,0,0,,Ол сонда болды
Dialogue: 0,0:20:52.98,0:20:54.56,Default,,0,0,0,,Карен Қазір Созакудан
Dialogue: 0,0:20:54.69,0:20:55.39,Default,,0,0,0,,Құрметті Нөл
Dialogue: 0,0:20:55.52,0:20:57.23,Default,,0,0,0,,Мен білемін, бірақ қайда?
Dialogue: 0,0:20:57.56,0:20:59.65,Default,,0,0,0,,Қарғыс атсын, менің енді уақытым жоқ.
Dialogue: 0,0:21:00.02,0:21:01.73,Default,,0,0,0,,Өзекті алюминий конусын пайдалану
Dialogue: 0,0:21:06.66,0:21:07.66,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:21:11.70,0:21:15.16,Default,,0,0,0,,Нөлдің шынайы тұлғасын ашу үшін не істеуім керек?
Dialogue: 0,0:21:15.29,0:21:17.88,Default,,0,0,0,,Бірақ біреуді күшпен тартып алу...
Dialogue: 0,0:21:18.00,0:21:19.92,Default,,0,0,0,,Нанналлидің еркін бұрмалау
Dialogue: 0,0:21:23.88,0:21:25.01,Default,,0,0,0,,Сузаку?
Dialogue: 0,0:21:25.26,0:21:26.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:26.51,0:21:27.84,Default,,0,0,0,,Менімен бірге қаш
Dialogue: 0,0:21:27.97,0:21:28.89,Default,,0,0,0,,Нуннальды
Dialogue: 0,0:21:29.55,0:21:32.01,Default,,0,0,0,,Созаку-сан
Dialogue: 0,0:21:32.60,0:21:35.77,Default,,0,0,0,,Жоқ, ол мені императорға сатты.
Dialogue: 0,0:21:36.06,0:21:37.31,Default,,0,0,0,,Сузаку мырза
Dialogue: 0,0:21:38.73,0:21:39.36,Default,,0,0,0,,Гуах
Dialogue: 0,0:21:39.90,0:21:43.23,Default,,0,0,0,,Сіз қорқып қалдыңыз ба? Кешіріңіз, қазір бәрі жақсы
Dialogue: 0,0:21:45.90,0:21:49.82,Default,,0,0,0,,Ха, Нунналли Созакумен бірге.
Dialogue: 0,0:21:50.16,0:21:52.08,Default,,0,0,0,,Қазір нөл
Dialogue: 0,0:21:58.25,0:22:01.42,Default,,0,0,0,,Нуннальды
Dialogue: 0,0:22:01.88,0:22:02.71,Default,,0,0,0,,Га
Dialogue: 0,0:22:03.38,0:22:08.13,Default,,0,0,0,,♪Мен оны бір күні кеудемнен таптым
Dialogue: 0,0:22:08.26,0:22:14.85,Default,,0,0,0,,♪Бақыт бөліктерін жинап алайық
Dialogue: 0,0:22:14.97,0:22:19.85,Default,,0,0,0,,♪Ұмытып қала жаздаған әуен
Dialogue: 0,0:22:19.98,0:22:26.94,Default,,0,0,0,,♪ Менің ортамда сөнбестен
Dialogue: 0,0:22:30.16,0:22:34.79,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:34.91,0:22:40.08,Default,,0,0,0,,♪Бүгін осында болғаным барлығына рахмет
Dialogue: 0,0:22:40.21,0:22:44.75,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:44.88,0:22:47.59,Default,,0,0,0,,♪Келесі мен бәріне айтамын
Dialogue: 0,0:22:47.72,0:22:51.05,Default,,0,0,0,,♪БАҚЫТТЫ Мен саған Уау беремін
Dialogue: 0,0:22:51.18,0:22:56.18,Default,,0,0,0,,♪Мен ештеңені ұмытпаймын
Dialogue: 0,0:22:56.31,0:23:02.77,Default,,0,0,0,,♪Себебі мен де сол күні менмін
Dialogue: 0,0:23:02.90,0:23:07.86,Default,,0,0,0,,♪Мен әрқашан сені сүйемін деп айтамын
Dialogue: 0,0:23:07.99,0:23:11.99,Default,,0,0,0,,♪Сіз маған айтуыңыз керек.
Dialogue: 0,0:23:12.11,0:23:16.37,Default,,0,0,0,,♪ Көз жасы ағып кете жаздады
Dialogue: 0,0:23:16.49,0:23:23.04,Default,,0,0,0,,♪Ұзақ түнде кенет артыма қарадым
Dialogue: 0,0:23:23.17,0:23:27.17,Default,,0,0,0,,♪Адамның ізімен жүру
Dialogue: 0,0:23:27.30,0:23:34.26,Default,,0,0,0,,♪Сол күнді ұмытпа
Dialogue: 0,0:23:38.64,0:23:40.27,Default,,0,0,0,,Нунеллидің де армандары бар
Dialogue: 0,0:23:40.77,0:23:43.23,Default,,0,0,0,,Нунналидің де таңдау жолы бар.
Dialogue: 0,0:23:43.44,0:23:45.02,Default,,0,0,0,,Бұл өте айқын
Dialogue: 0,0:23:45.15,0:23:47.44,Default,,0,0,0,,Бұл өте қарапайым, солай емес пе?
Dialogue: 0,0:23:48.07,0:23:50.24,Default,,0,0,0,,О, мен...
Dialogue: 0,0:23:51.74,0:23:57.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory