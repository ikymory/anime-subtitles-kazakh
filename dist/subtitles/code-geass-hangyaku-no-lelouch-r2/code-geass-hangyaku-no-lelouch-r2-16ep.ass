Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.95,0:00:03.86,Default,,0,0,0,,Дүние алға жылжуда
Dialogue: 0,0:00:03.99,0:00:06.49,Default,,0,0,0,,Нөл тудырған керемет арқылы
Dialogue: 0,0:00:06.66,0:00:08.24,Default,,0,0,0,,Дүние дүниеге келді
Dialogue: 0,0:00:08.37,0:00:11.04,Default,,0,0,0,,Нөл көрсеткен әрекеттер арқылы
Dialogue: 0,0:00:11.29,0:00:16.21,Default,,0,0,0,,Иә, әлем енді болмыстың келесі жолына өтуде.
Dialogue: 0,0:00:16.33,0:00:18.63,Default,,0,0,0,,Қалаулар мен сезімдер толқынымен...
Dialogue: 0,0:00:18.75,0:00:20.80,Default,,0,0,0,,Нөл алға жылжуы керек
Dialogue: 0,0:00:20.92,0:00:24.43,Default,,0,0,0,,Уақыттың тықылдаған қолдарын тоқтатпау үшін
Dialogue: 0,0:00:27.35,0:00:31.89,Default,,0,0,0,,♪Ақырзаманда туған нұр
Dialogue: 0,0:00:32.02,0:00:37.56,Default,,0,0,0,,♪ Қазір желде
Dialogue: 0,0:00:53.46,0:00:58.42,Default,,0,0,0,,♪Сұлу болу арқылы өмір сүре алмайсың
Dialogue: 0,0:00:58.79,0:01:04.13,Default,,0,0,0,,♪Мейірімділік жалғыз емдей алмайды
Dialogue: 0,0:01:04.26,0:01:06.97,Default,,0,0,0,,♪Не ұрланды?
Dialogue: 0,0:01:07.09,0:01:09.22,Default,,0,0,0,,♪Өзгермейтін әлемде
Dialogue: 0,0:01:09.68,0:01:12.31,Default,,0,0,0,,♪Сіз не естідіңіз?
Dialogue: 0,0:01:12.43,0:01:15.56,Default,,0,0,0,,♪Түстер әні
Dialogue: 0,0:01:15.69,0:01:20.57,Default,,0,0,0,,♪Бәрі жарық
Dialogue: 0,0:01:21.40,0:01:24.03,Default,,0,0,0,,♪Тасылған армандар
Dialogue: 0,0:01:24.15,0:01:30.58,Default,,0,0,0,,♪Ертеңгі күннің соңында жаңғырық
Dialogue: 0,0:01:32.20,0:01:36.66,Default,,0,0,0,,♪Дүниенің ақырында туған нұр
Dialogue: 0,0:01:36.79,0:01:41.34,Default,,0,0,0,,♪Біз бірміз
Dialogue: 0,0:01:42.21,0:01:47.84,Default,,0,0,0,,♪ Қазір желде
Dialogue: 0,0:02:02.15,0:02:03.15,Default,,0,0,0,,Мәртебелі император?
Dialogue: 0,0:02:03.65,0:02:04.69,Default,,0,0,0,,Жоқ па?
Dialogue: 0,0:02:05.03,0:02:05.86,Default,,0,0,0,,Иә
Dialogue: 0,0:02:06.07,0:02:08.32,Default,,0,0,0,,Бұрынғы канцлер Шнайзелден...
Dialogue: 0,0:02:08.45,0:02:10.37,Default,,0,0,0,,Бізбен хабарласты.
Dialogue: 0,0:02:10.49,0:02:14.37,Default,,0,0,0,,Әзірге бұл жерде адамдар туралы сөйлесейік.
Dialogue: 0,0:02:14.49,0:02:15.83,Default,,0,0,0,,Тіпті империяның материгінде -
Dialogue: 0,0:02:15.95,0:02:19.54,Default,,0,0,0,,Аз ғана адамдар хабардар болған сияқты.
Dialogue: 0,0:02:19.67,0:02:21.21,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:21.33,0:02:24.09,Default,,0,0,0,,Қазіргі уақытта тергеу жүріп жатыр
Dialogue: 0,0:02:24.38,0:02:25.63,Default,,0,0,0,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:02:25.76,0:02:28.72,Default,,0,0,0,,Қытай Федерациясына шабуылға қалай дайындаласыз?
Dialogue: 0,0:02:28.84,0:02:31.22,Default,,0,0,0,,Мәртебелі император соғыс жарияламаса...
Dialogue: 0,0:02:31.34,0:02:32.89,Default,,0,0,0,,Мен сізге бұл жерден көмектесе алмаймын.
Dialogue: 0,0:02:33.01,0:02:35.06,Default,,0,0,0,,Қауіпсіздік мәселелері де бар.
Dialogue: 0,0:02:35.18,0:02:37.10,Default,,0,0,0,,Егер сандар бұл туралы білсе...
Dialogue: 0,0:02:37.23,0:02:40.27,Default,,0,0,0,,Негізінде біз саясатты шешуіміз керек.
Dialogue: 0,0:02:40.40,0:02:41.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:41.23,0:02:42.81,Default,,0,0,0,,Губернатор - Нуналли.
Dialogue: 0,0:02:43.02,0:02:46.94,Default,,0,0,0,,Мисс Ломейер Бұл жауапкершілікті жүктеу ме?
Dialogue: 0,0:02:47.07,0:02:48.65,Default,,0,0,0,,А, жоқ, бұл дұрыс емес.
Dialogue: 0,0:02:49.70,0:02:50.82,Default,,0,0,0,,Мен бақытты болуым керек пе?
Dialogue: 0,0:02:51.70,0:02:53.62,Default,,0,0,0,,Мәртебелі мырзаның жоқтығы...
Dialogue: 0,0:02:53.74,0:02:56.54,Default,,0,0,0,,Бұл Нуналлидің өмірі сақталатынын білдіреді.
Dialogue: 0,0:02:56.91,0:02:57.75,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:02:58.33,0:03:01.50,Default,,0,0,0,,Британияның бұл қозғалысы императордың жоқтығын білдіреді.
Dialogue: 0,0:03:01.62,0:03:04.84,Default,,0,0,0,,Сол кезде мен о дүниеде қалып қойғандай болдым.
Dialogue: 0,0:03:05.50,0:03:07.92,Default,,0,0,0,,Оның не айтқаны маған қызық...
Dialogue: 0,0:03:08.05,0:03:10.84,Default,,0,0,0,,Мен Нуналлидің қазір қауіпсіз екеніне қуануым керек пе?
Dialogue: 0,0:03:10.97,0:03:11.80,Default,,0,0,0,,) Мм...
Dialogue: 0,0:03:11.93,0:03:13.34,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:03:13.47,0:03:16.01,Default,,0,0,0,,Дұрыс, киіміңді сыртынан киіп ал.
Dialogue: 0,0:03:16.14,0:03:18.06,Default,,0,0,0,,Ән айтып жатқанда бір аяқпен билеуіңді берейін бе?
Dialogue: 0,0:03:18.18,0:03:20.02,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:03:20.14,0:03:21.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:21.90,0:03:23.06,Default,,0,0,0,,Жарайды, бұл әзіл.
Dialogue: 0,0:03:23.19,0:03:24.15,Default,,0,0,0,,Уау
Dialogue: 0,0:03:24.27,0:03:27.73,Default,,0,0,0,,Кешіріңіз, сондықтан қорқынышты ештеңе жасамаңыз.
Dialogue: 0,0:03:28.07,0:03:30.07,Default,,0,0,0,,Толығымен артқа
Dialogue: 0,0:03:30.20,0:03:33.07,Default,,0,0,0,,Геаспен араласпас бұрын күңге
Dialogue: 0,0:03:33.70,0:03:36.99,Default,,0,0,0,,Уайымдама, мен саған жамандық жасамаймын.
Dialogue: 0,0:03:38.41,0:03:39.25,Default,,0,0,0,,Га
Dialogue: 0,0:03:39.37,0:03:41.37,Default,,0,0,0,,Мен бұл шындыққа уәде беремін.
Dialogue: 0,0:03:41.71,0:03:42.42,Default,,0,0,0,,(Коммуникатордың қоңырау үні)
Dialogue: 0,0:03:42.42,0:03:42.96,Default,,0,0,0,,(Коммуникатордың қоңырау үні)
Dialogue: 0,0:03:42.42,0:03:42.96,Default,,0,0,0,,Лорд Лелух
Dialogue: 0,0:03:42.96,0:03:43.67,Default,,0,0,0,,Лорд Лелух
Dialogue: 0,0:03:43.79,0:03:45.34,Default,,0,0,0,,Еремия, не болды?
Dialogue: 0,0:03:46.92,0:03:50.30,Default,,0,0,0,,Иә, оны Сазерлендтің кабинасына салыңыз.
Dialogue: 0,0:03:50.42,0:03:52.30,Default,,0,0,0,,Мені кешіріңіз, Лелуш-сама.
Dialogue: 0,0:03:52.43,0:03:54.51,Default,,0,0,0,,Сіздің бұйрығыңыз жойылу болды...
Dialogue: 0,0:03:54.93,0:03:57.31,Default,,0,0,0,,Британдық корольдік отбасын бақылау
Dialogue: 0,0:03:57.43,0:04:00.77,Default,,0,0,0,,Жақсы, жоқ, сен жақсы жұмыс жасадың.
Dialogue: 0,0:04:00.89,0:04:01.98,Default,,0,0,0,,Лелуш
Dialogue: 0,0:04:02.10,0:04:04.73,Default,,0,0,0,,Сол қарғыс атқан күшпен не іздейсің?
Dialogue: 0,0:04:04.94,0:04:09.19,Default,,0,0,0,,Әпке, мен тек апама көмектескім келеді.
Dialogue: 0,0:04:09.57,0:04:10.82,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:04:12.24,0:04:13.07,Default,,0,0,0,,Киношита
Dialogue: 0,0:04:13.20,0:04:15.07,Default,,0,0,0,,Уф Асахина-сан
Dialogue: 0,0:04:15.20,0:04:17.16,Default,,0,0,0,,Бұл қан ізі емес пе?
Dialogue: 0,0:04:17.49,0:04:20.04,Default,,0,0,0,,Бұл не болды? Нөлдің стратегиясы қандай?
Dialogue: 0,0:04:20.16,0:04:21.08,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:04:21.20,0:04:22.46,Default,,0,0,0,,(Батлер) Қош келдіңіз, Лорд Джоэстар. Біз сізді күтіп жүр едік.
Dialogue: 0,0:04:22.66,0:04:24.17,Default,,0,0,0,,Нөл командасы
Dialogue: 0,0:04:24.29,0:04:25.83,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:04:25.96,0:04:28.80,Default,,0,0,0,,Бұл генерал Тодо үшін өте құпия тапсырма.
Dialogue: 0,0:04:28.92,0:04:31.38,Default,,0,0,0,,Жаңадан келгендер аса бастық емес.
Dialogue: 0,0:04:31.80,0:04:34.18,Default,,0,0,0,,Қара рыцарлардағы жеке адамның құндылығы...
Dialogue: 0,0:04:34.30,0:04:37.05,Default,,0,0,0,,Бұл сіздің сеніміңіздің нөлдік деңгейіне байланысты.
Dialogue: 0,0:04:37.47,0:04:39.35,Default,,0,0,0,,Менің құндылықтарым менікінен өзгеше.
Dialogue: 0,0:04:40.47,0:04:41.39,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:41.52,0:04:43.48,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:04:43.60,0:04:44.64,Default,,0,0,0,,Сіз жасай алатын нәрселер...
Dialogue: 0,0:04:45.06,0:04:46.94,Default,,0,0,0,,Жаман нәрселер болады! Уф
Dialogue: 0,0:04:47.06,0:04:49.57,Default,,0,0,0,,Сіз жақсы адамсыз ба, жақсы адам болып көрініп, оны өзіңіз аяқтайсыз ба?
Dialogue: 0,0:04:49.69,0:04:54.07,Default,,0,0,0,,Бұл сәйкес емес! Карен Акацукиге арзанға қарамаңыз!
Dialogue: 0,0:04:54.53,0:04:55.66,Default,,0,0,0,,Әй
Dialogue: 0,0:04:55.78,0:04:57.74,Default,,0,0,0,,Қарсылық көрсетпегенің мені қатты ренжітті.
Dialogue: 0,0:04:58.16,0:04:59.12,Default,,0,0,0,,Уф
Dialogue: 0,0:04:59.24,0:05:01.83,Default,,0,0,0,,Енді мені өлтір.
Dialogue: 0,0:05:02.00,0:05:04.16,Default,,0,0,0,,Өйткені тұтқындар Қоңыр түнімен араласқан...
Dialogue: 0,0:05:04.29,0:05:05.54,Default,,0,0,0,,Мен дайынмын.
Dialogue: 0,0:05:05.67,0:05:08.84,Default,,0,0,0,,Амал жоқ, үлгере алмаған мен болдым.
Dialogue: 0,0:05:08.96,0:05:11.75,Default,,0,0,0,,Мен сені жек көремін!
Dialogue: 0,0:05:13.05,0:05:16.68,Default,,0,0,0,,Иә, Америка Құрама Штаттарының Жарғысын ратификациялау арқылы...
Dialogue: 0,0:05:16.80,0:05:19.18,Default,,0,0,0,,Қасиетті Британ империясымен салыстыруға болады.
Dialogue: 0,0:05:19.30,0:05:21.43,Default,,0,0,0,,Үлкен федеративті мемлекет дүниеге келді
Dialogue: 0,0:05:21.56,0:05:23.85,Default,,0,0,0,,Оның аты да супер-біріккен ел.
Dialogue: 0,0:05:23.98,0:05:25.73,Default,,0,0,0,,Ооо
Dialogue: 0,0:05:25.94,0:05:27.56,Default,,0,0,0,,) Керемет, ноль мырза.
Dialogue: 0,0:05:28.06,0:05:31.32,Default,,0,0,0,,) Британияның колония аймағына айналған жер аударылған үкіметтен...
Dialogue: 0,0:05:31.44,0:05:33.07,Default,,0,0,0,,Қатысу туралы декларация алынды.
Dialogue: 0,0:05:33.19,0:05:34.44,Default,,0,0,0,,Енді біз...
Dialogue: 0,0:05:34.57,0:05:37.41,Default,,0,0,0,,Азаттық соғысының себебін алды
Dialogue: 0,0:05:37.53,0:05:39.28,Default,,0,0,0,,Тек соғыс па?
Dialogue: 0,0:05:39.99,0:05:42.41,Default,,0,0,0,,) Жапонияны қайтарып алу бойынша алдағы операцияда -
Dialogue: 0,0:05:42.54,0:05:44.54,Default,,0,0,0,,Егер біз жеңсек...
Dialogue: 0,0:05:44.66,0:05:47.67,Default,,0,0,0,,Әлі күтіп тұрған және көріп тұрған күштер де тізбекті реакцияда жақтарын ауыстырады.
Dialogue: 0,0:05:47.79,0:05:48.71,Default,,0,0,0,,Иә
Dialogue: 0,0:05:49.00,0:05:51.79,Default,,0,0,0,,Бірақ бұл үшін, Британия көшпес бұрын...
Dialogue: 0,0:05:51.92,0:05:54.46,Default,,0,0,0,,Біз супер біртұтас ұлт құруымыз керек
Dialogue: 0,0:05:54.59,0:05:56.76,Default,,0,0,0,,Жеңісті немесе жеңілісті уақыт шешеді.
Dialogue: 0,0:05:56.88,0:06:00.09,Default,,0,0,0,,Әр елдің өкілдерінің өз ұпайлары бар екеніне сенімдімін, бірақ...
Dialogue: 0,0:06:00.22,0:06:03.81,Default,,0,0,0,,Мен сізден кеңірек перспективада ынтымақтастық туралы сұрағым келеді.
Dialogue: 0,0:06:03.93,0:06:07.35,Default,,0,0,0,,Барлығы әлемдік үрдісті реттеу үшін
Dialogue: 0,0:06:07.48,0:06:08.60,Default,,0,0,0,,(қатысқандардың алғысы)
Dialogue: 0,0:06:08.73,0:06:10.02,Default,,0,0,0,,Ах
Dialogue: 0,0:06:13.61,0:06:15.15,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:06:15.28,0:06:16.78,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:06:16.90,0:06:18.82,Default,,0,0,0,,Келе жатқан жеке фестиваль қызы
Dialogue: 0,0:06:18.95,0:06:20.45,Default,,0,0,0,,Менің атым Миллей Эшфорд.
Dialogue: 0,0:06:20.57,0:06:22.62,Default,,0,0,0,,Өзің айтпа, хехехе
Dialogue: 0,0:06:22.74,0:06:24.79,Default,,0,0,0,,Бүгінгі тақырыптар
Dialogue: 0,0:06:24.91,0:06:27.21,Default,,0,0,0,,Вокзал алдындағы аумақ кенет хайуанаттар бағына айналды.
Dialogue: 0,0:06:27.33,0:06:27.58,Default,,0,0,0,,Қазіргі уақытта Икебукюро станциясындағы адамдарды таң қалдыратын нәрсе...
Dialogue: 0,0:06:27.58,0:06:28.54,Default,,0,0,0,,Қазіргі уақытта Икебукуро станциясындағы адамдарды таң қалдыратын нәрсе...
Dialogue: 0,0:06:27.58,0:06:28.54,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:28.54,0:06:30.04,Default,,0,0,0,,Қазіргі уақытта Икебукуро станциясындағы адамдарды таң қалдыратын нәрсе...
Dialogue: 0,0:06:30.17,0:06:31.38,Default,,0,0,0,,Жануарлар өнері
Dialogue: 0,0:06:31.50,0:06:32.63,Default,,0,0,0,,Ооо
Dialogue: 0,0:06:32.75,0:06:34.63,Default,,0,0,0,,Мен саған тамақ әкелдім.
Dialogue: 0,0:06:41.47,0:06:42.60,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:06:43.26,0:06:44.14,Default,,0,0,0,,Ах
Dialogue: 0,0:06:46.18,0:06:47.06,Default,,0,0,0,,О
Dialogue: 0,0:06:47.18,0:06:48.69,Default,,0,0,0,,Бұл пицца деп аталады.
Dialogue: 0,0:06:48.98,0:06:50.69,Default,,0,0,0,,Сіз қарныңыз ашты.
Dialogue: 0,0:06:50.94,0:06:52.48,Default,,0,0,0,,Мен оны сізге беруді ойладым.
Dialogue: 0,0:06:52.61,0:06:54.61,Default,,0,0,0,,Мен оны Сугиямаға дайындадым.
Dialogue: 0,0:06:59.70,0:07:01.07,Default,,0,0,0,,Ах
Dialogue: 0,0:07:01.99,0:07:02.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:02.95,0:07:04.49,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:07:07.91,0:07:09.58,Default,,0,0,0,,Уф
Dialogue: 0,0:07:10.79,0:07:13.17,Default,,0,0,0,,Қараңызшы, сіз де.
Dialogue: 0,0:07:13.29,0:07:16.34,Default,,0,0,0,,Ха, аа
Dialogue: 0,0:07:16.46,0:07:18.01,Default,,0,0,0,,Жарайды, тамақтанып ал.
Dialogue: 0,0:07:18.13,0:07:24.47,Default,,0,0,0,,Иә хум ха ха ха ха ха хум хум
Dialogue: 0,0:07:24.89,0:07:25.93,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:07:26.06,0:07:27.85,Default,,0,0,0,,Иә, өте, өте
Dialogue: 0,0:07:27.97,0:07:31.10,Default,,0,0,0,,Түсіндім. Бұл жеңілдік
Dialogue: 0,0:07:32.15,0:07:35.94,Default,,0,0,0,,Төраға, сіз кейіпкерлеріңізді жасауда қателесіп отырсыз.
Dialogue: 0,0:07:36.07,0:07:36.69,Default,,0,0,0,,Ах
Dialogue: 0,0:07:36.82,0:07:39.44,Default,,0,0,0,,Иә? А, түсіндім
Dialogue: 0,0:07:40.07,0:07:41.95,Default,,0,0,0,,Сіз бұл туралы тіпті білмейсіз.
Dialogue: 0,0:07:45.53,0:07:47.37,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:07:47.49,0:07:49.16,Default,,0,0,0,,Мазасыз ба?
Dialogue: 0,0:07:49.66,0:07:51.21,Default,,0,0,0,,Мен жай ғана уайымдап тұрмын
Dialogue: 0,0:07:51.33,0:07:54.75,Default,,0,0,0,,Мен сегіз жыл бұрын өмірімді қалай өткізу керектігін шешуім керек еді.
Dialogue: 0,0:07:54.88,0:07:58.34,Default,,0,0,0,,Сенесің бе? Мен 8 жыл бұрын кім едім
Dialogue: 0,0:07:59.13,0:08:02.30,Default,,0,0,0,,Өткен шешімдерді ақымақ деп айтасыз ба?
Dialogue: 0,0:08:02.43,0:08:04.76,Default,,0,0,0,,Адамның есте сақтау қабілеті бұлыңғыр
Dialogue: 0,0:08:04.89,0:08:06.47,Default,,0,0,0,,Сенуге тұрарлық емес
Dialogue: 0,0:08:06.72,0:08:08.43,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:08:08.56,0:08:10.02,Default,,0,0,0,,Мән жоқ
Dialogue: 0,0:08:10.14,0:08:14.15,Default,,0,0,0,,Тоғыз жыл бұрын жазған күнделігім бар.
Dialogue: 0,0:08:14.27,0:08:16.56,Default,,0,0,0,,Бірақ менде бұл жады жоқ.
Dialogue: 0,0:08:16.73,0:08:17.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.77,0:08:19.23,Default,,0,0,0,,Тағы да көп
Dialogue: 0,0:08:19.36,0:08:23.49,Default,,0,0,0,,Менің жадым мен деректер ретіндегі жазбам әртүрлі.
Dialogue: 0,0:08:23.61,0:08:24.57,Default,,0,0,0,,Мүмкін емес—
Dialogue: 0,0:08:24.70,0:08:27.70,Default,,0,0,0,,Мәртебелі Император Геассы Неліктен Аня?
Dialogue: 0,0:08:27.83,0:08:29.49,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:08:29.62,0:08:31.75,Default,,0,0,0,,Қазірдің өзінде менің есте сақтау қабілетім кейде нашарлайды.
Dialogue: 0,0:08:32.21,0:08:33.75,Default,,0,0,0,,Біз Қытай Федерациясында соғысқанда, кенеттен
Dialogue: 0,0:08:33.75,0:08:34.92,Default,,0,0,0,,Біз Қытай Федерациясында соғысқанда, кенеттен
Dialogue: 0,0:08:33.75,0:08:34.92,Default,,0,0,0,,(Лақтыру дыбысы)
Dialogue: 0,0:08:35.12,0:08:35.75,Default,,0,0,0,,Уф
Dialogue: 0,0:08:36.50,0:08:37.67,Default,,0,0,0,,Уф
Dialogue: 0,0:08:37.79,0:08:39.71,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:08:39.84,0:08:42.09,Default,,0,0,0,,Сатқын кардинал
Dialogue: 0,0:08:42.22,0:08:44.13,Default,,0,0,0,,Бұл өмір
Dialogue: 0,0:08:44.26,0:08:46.14,Default,,0,0,0,,Беларусь майданынан бері.
Dialogue: 0,0:08:46.43,0:08:47.55,Default,,0,0,0,,Лорд Брэдли
Dialogue: 0,0:08:47.68,0:08:48.39,Default,,0,0,0,,Уф
Dialogue: 0,0:08:48.89,0:08:50.14,Default,,0,0,0,,Он түн
Dialogue: 0,0:08:50.56,0:08:53.94,Default,,0,0,0,,Ол әдеттегідей әйелдерді құлатуға шебер сияқты.
Dialogue: 0,0:08:54.06,0:08:55.65,Default,,0,0,0,,Ал қырғынға ұшыраған ханшайымға келсек...
Dialogue: 0,0:08:55.90,0:08:57.40,Default,,0,0,0,,Толығырақ...
Dialogue: 0,0:08:57.52,0:08:59.82,Default,,0,0,0,,Сізді намыс үшін жекпе-жекке шақырады.
Dialogue: 0,0:08:59.94,0:09:02.28,Default,,0,0,0,,О, мен ұмытып кеткен шығармын.
Dialogue: 0,0:09:02.40,0:09:04.95,Default,,0,0,0,,Мен адамдарды өлтіруде данышпанмын
Dialogue: 0,0:09:05.45,0:09:09.03,Default,,0,0,0,,Мен өзімнің қанымды түсінбеймін, саным көбейіп барады.
Dialogue: 0,0:09:09.16,0:09:10.16,Default,,0,0,0,,Уф
Dialogue: 0,0:09:10.54,0:09:11.95,Default,,0,0,0,,Бұл Галахад
Dialogue: 0,0:09:12.08,0:09:14.33,Default,,0,0,0,,Екеуің де басқа адамды жаңылтпаңдар!
Dialogue: 0,0:09:14.58,0:09:16.17,Default,,0,0,0,,Бір түн
Dialogue: 0,0:09:16.29,0:09:18.88,Default,,0,0,0,,Лорд Вальдштейн, сіз неге мұндасыз?
Dialogue: 0,0:09:19.00,0:09:20.96,Default,,0,0,0,,Бұл ақымақ сұрақ, Аня.
Dialogue: 0,0:09:21.09,0:09:24.76,Default,,0,0,0,,Қара рыцарлар шабуыл жасаса, бұл олардың жалғыз аймағы.
Dialogue: 0,0:09:24.88,0:09:25.59,Default,,0,0,0,,Лучано
Dialogue: 0,0:09:26.43,0:09:28.76,Default,,0,0,0,,Сондықтан біз Валькири отрядын әкелдік.
Dialogue: 0,0:09:29.43,0:09:31.47,Default,,0,0,0,,Гарет де осы мақсатқа дайындалды.
Dialogue: 0,0:09:31.60,0:09:34.02,Default,,0,0,0,,Ұрыс даласында ұлылығыңды көрсет
Dialogue: 0,0:09:34.48,0:09:36.81,Default,,0,0,0,,Қазіргі уақытта жоғары мәртебелі Шнайзелдің қолбасшылығында.
Dialogue: 0,0:09:36.94,0:09:38.94,Default,,0,0,0,,Біз күш біріктірген кезде
Dialogue: 0,0:09:39.11,0:09:43.11,Default,,0,0,0,,Ха, мен білемін, егер сен айтсаң.
Dialogue: 0,0:09:43.44,0:09:45.57,Default,,0,0,0,,(Карен мен Нанналлидің күлкісі)
Dialogue: 0,0:09:45.70,0:09:47.91,Default,,0,0,0,,Иә, Лелуш мұны істеді.
Dialogue: 0,0:09:48.03,0:09:50.16,Default,,0,0,0,,Менің ағам қыңыр.
Dialogue: 0,0:09:50.28,0:09:52.54,Default,,0,0,0,,Бірақ сіз өте мейірімдісіз.
Dialogue: 0,0:09:52.83,0:09:54.58,Default,,0,0,0,,Менің ағам да солай болды.
Dialogue: 0,0:09:54.75,0:09:57.17,Default,,0,0,0,,О, мен бұл туралы естідім ...
Dialogue: 0,0:09:57.29,0:10:00.71,Default,,0,0,0,,Мұндай қыздың Қара рыцарьлардың эйсе болуы мүмкін емес.
Dialogue: 0,0:10:00.84,0:10:03.30,Default,,0,0,0,,Маған кіруге рұқсат бермегеніңізге сенімдімін...
Dialogue: 0,0:10:03.42,0:10:04.46,Default,,0,0,0,,Лорд Брэдли
Dialogue: 0,0:10:04.59,0:10:05.38,Default,,0,0,0,,Ах
Dialogue: 0,0:10:05.51,0:10:07.80,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:08.43,0:10:11.39,Default,,0,0,0,,Иә, сіз Британияның вампирісіз.
Dialogue: 0,0:10:11.51,0:10:16.02,Default,,0,0,0,,Әй, бұл майдан даласы болса, қаныңды сорып алар едім, бірақ ұят.
Dialogue: 0,0:10:16.14,0:10:19.10,Default,,0,0,0,,Мені елге қайтарып жатыр деп ойлаймын.
Dialogue: 0,0:10:19.23,0:10:22.61,Default,,0,0,0,,Жоқ, мен осында біраз уақыт барымтада қаламын.
Dialogue: 0,0:10:23.57,0:10:25.99,Default,,0,0,0,,Кепілге алынғандарға не қажет?
Dialogue: 0,0:10:26.11,0:10:31.03,Default,,0,0,0,,Бұл өмір. Сізде өмір болғанша, сіздің денеңізге не болғанына қарамастан.
Dialogue: 0,0:10:31.28,0:10:33.91,Default,,0,0,0,,Сізде мақтаныш жоқ па, лорд Брэдли?
Dialogue: 0,0:10:34.66,0:10:37.00,Default,,0,0,0,,Қарусыз әйелге қарсы
Dialogue: 0,0:10:37.12,0:10:40.00,Default,,0,0,0,,Хаха, сен сондай тәттісің, тек отбасынан шыққан қария.
Dialogue: 0,0:10:41.00,0:10:42.00,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:42.25,0:10:46.21,Default,,0,0,0,,Фамилиямен ғана танылу оңай ма?
Dialogue: 0,0:10:46.34,0:10:47.63,Default,,0,0,0,,Қоңыр түні
Dialogue: 0,0:10:48.01,0:10:50.59,Default,,0,0,0,,Иә? Ланселот үшін Фрейя?
Dialogue: 0,0:10:50.72,0:10:52.01,Default,,0,0,0,,Сузаку-кун үшін қызыл
Dialogue: 0,0:10:52.14,0:10:53.97,Default,,0,0,0,,Мен оны пайдалануыңызды өтінетін болдым.
Dialogue: 0,0:10:54.31,0:10:55.43,Default,,0,0,0,,Эй, мен?
Dialogue: 0,0:10:55.56,0:10:58.77,Default,,0,0,0,,Кешіріңіз, мен де сенің соңынан еріп қалдым.
Dialogue: 0,0:10:58.89,0:11:02.23,Default,,0,0,0,,Ллойд мырзамен бірге мен өзімді хобби әлемінде таптым.
Dialogue: 0,0:11:02.36,0:11:02.98,Default,,0,0,0,,Хобби
Dialogue: 0,0:11:03.11,0:11:05.98,Default,,0,0,0,,Бұл Ракшата машинасы болғандықтан, оны өңдеу оңай.
Dialogue: 0,0:11:06.11,0:11:09.78,Default,,0,0,0,,Олай болса, ешкім міне алмайтын нәрсемен құттықтаймын.
Dialogue: 0,0:11:09.90,0:11:11.24,Default,,0,0,0,,Девайзердің кезегі.
Dialogue: 0,0:11:11.36,0:11:14.62,Default,,0,0,0,,Мм... Профессор Ллойд, бұл Ланселот туралы.
Dialogue: 0,0:11:15.28,0:11:18.29,Default,,0,0,0,,Сіз стратегиялық қаруды тактикалық қарудың үстіне қоюды жоспарлап отырсыз ба?
Dialogue: 0,0:11:18.70,0:11:20.71,Default,,0,0,0,,Оның себебі бар.
Dialogue: 0,0:11:20.83,0:11:23.25,Default,,0,0,0,,Негізгі бақылау аймағындағы заттар:
Dialogue: 0,0:11:23.38,0:11:26.92,Default,,0,0,0,,Ол Фрейяның коллапс эффектісімен толығымен жойылады.
Dialogue: 0,0:11:27.05,0:11:27.88,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:11:28.01,0:11:30.68,Default,,0,0,0,,Сіз Сузаку-кунға осындай нәрсені түсіруге рұқсат бересіз бе?
Dialogue: 0,0:11:30.80,0:11:33.05,Default,,0,0,0,,Бір адамдардың қырғынға ұшырауы
Dialogue: 0,0:11:33.18,0:11:36.68,Default,,0,0,0,,Созаку Сіз әлі де он бірмен туысқандық сезімін сезінесіз бе?
Dialogue: 0,0:11:36.81,0:11:39.10,Default,,0,0,0,,Мен сізге Фрейджаны сеніп тапсырғым келеді.
Dialogue: 0,0:11:40.06,0:11:42.73,Default,,0,0,0,,Оны алып жүргенімді қалайсың ба?
Dialogue: 0,0:11:42.85,0:11:45.94,Default,,0,0,0,,Сіз Эфемия-саманың рыцарысыз ба?
Dialogue: 0,0:11:47.27,0:11:49.11,Default,,0,0,0,,Аха Нина-кун
Dialogue: 0,0:11:49.36,0:11:52.20,Default,,0,0,0,,Бұл қайшылық тек Созаку-кунмен шектелмейді.
Dialogue: 0,0:11:52.32,0:11:54.28,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:12:11.84,0:12:15.39,Default,,0,0,0,,Иә, дүниежүзілік есеп беруге дайындық аяқталды.
Dialogue: 0,0:12:15.51,0:12:19.14,Default,,0,0,0,,Лорд Сейкоку мен генерал Тодо күту залында. Иә.
Dialogue: 0,0:12:19.64,0:12:20.85,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:20.98,0:12:25.15,Default,,0,0,0,,Үндістан мен Гвинея өкілдерімен кездескеннен кейін мен оларды өтетін жерде қарсы аламын.
Dialogue: 0,0:12:26.02,0:12:27.19,Default,,0,0,0,,Көшеге шықпаңыз
Dialogue: 0,0:12:27.31,0:12:30.11,Default,,0,0,0,,А, иә, және бұл
Dialogue: 0,0:12:30.23,0:12:31.07,Default,,0,0,0,,Не?
Dialogue: 0,0:12:31.19,0:12:32.57,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:12:32.70,0:12:37.95,Default,,0,0,0,,Иә? Ха, мен барамын\NАмерика Құрама Штаттары Жарғысының
Dialogue: 0,0:12:39.54,0:12:42.62,Default,,0,0,0,,—
Dialogue: 0,0:12:42.75,0:12:48.29,Default,,0,0,0,,Жоғарғы кеңес өкілі император Кагура-дононың түсіндірмесі.
Dialogue: 0,0:12:48.42,0:12:49.17,Default,,0,0,0,,Иә
Dialogue: 0,0:12:49.46,0:12:51.13,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:12:51.30,0:12:52.76,Default,,0,0,0,,Жоқ, бұл туралы көп.
Dialogue: 0,0:12:52.88,0:12:55.30,Default,,0,0,0,,Қолыңнан келеді, егер сен аспанның ұлы болсаң.
Dialogue: 0,0:12:55.59,0:12:57.22,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:12:57.47,0:12:58.10,Default,,0,0,0,,Нөлге ергеніңіз жақсы болды, солай ма?
Dialogue: 0,0:12:58.10,0:13:01.18,Default,,0,0,0,,Нөлге ергеніңіз жақсы болды, солай ма?
Dialogue: 0,0:12:58.10,0:13:01.18,Default,,0,0,0,,Ааа...
Dialogue: 0,0:13:01.56,0:13:02.93,Default,,0,0,0,,) Айтпақшы, C.C. ше?
Dialogue: 0,0:13:03.06,0:13:04.81,Default,,0,0,0,,Ол әлі де өзін жақсы сезінбейді.
Dialogue: 0,0:13:04.94,0:13:07.94,Default,,0,0,0,,О, бұл құттықтау емес хахахахахахаха
Dialogue: 0,0:13:08.06,0:13:10.40,Default,,0,0,0,,Тамаки мырза, көп ішпеңіз.
Dialogue: 0,0:13:12.44,0:13:14.95,Default,,0,0,0,,Мен түсінбеймін, неге еркектер боянады.
Dialogue: 0,0:13:15.07,0:13:16.57,Default,,0,0,0,,Бұл күн шуақты кезең
Dialogue: 0,0:13:16.70,0:13:21.83,Default,,0,0,0,,Мм... осы шайқас аяқталғаннан кейін мен...
Dialogue: 0,0:13:21.95,0:13:22.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:22.83,0:13:26.62,Default,,0,0,0,,Менің Кагасиро Тододан сұрайтыным бар.
Dialogue: 0,0:13:26.75,0:13:26.87,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:26.87,0:13:27.67,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:26.87,0:13:27.67,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:27.67,0:13:27.79,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:27.79,0:13:28.04,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:27.79,0:13:28.04,Default,,0,0,0,,О, ақыры келді.
Dialogue: 0,0:13:28.04,0:13:29.50,Default,,0,0,0,,О, ақыры келді.
Dialogue: 0,0:13:29.63,0:13:31.84,Default,,0,0,0,,Осындай уақытта кешігіп қалсаңыз ше?
Dialogue: 0,0:13:31.96,0:13:33.21,Default,,0,0,0,,) Жоқ, кешіріңіз.
Dialogue: 0,0:13:33.34,0:13:35.38,Default,,0,0,0,,Оуги Сіз ұйықтап қалдыңыз.
Dialogue: 0,0:13:35.51,0:13:36.38,Default,,0,0,0,,қашып кетті
Dialogue: 0,0:13:36.51,0:13:37.80,Default,,0,0,0,,Осы киімде ыстық емес пе?
Dialogue: 0,0:13:37.93,0:13:38.84,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:13:38.97,0:13:42.35,Default,,0,0,0,,Асығайық, өйткені бүгін тарихи күн.
Dialogue: 0,0:13:43.77,0:13:46.06,Default,,0,0,0,,Бұл Хорай аралының үстіндегі аспан
Dialogue: 0,0:13:46.19,0:13:48.48,Default,,0,0,0,,Америка Құрама Штаттарының Жарғысын ратификациялау рәсімі қазір...
Dialogue: 0,0:13:48.60,0:13:50.44,Default,,0,0,0,,Басталуға жақын
Dialogue: 0,0:13:50.94,0:13:54.11,Default,,0,0,0,,Яғни, Америка Құрама Штаттарының осы Жарғысын ратификациялау арқылы...
Dialogue: 0,0:13:54.24,0:13:57.61,Default,,0,0,0,,Біздікімен салыстыруға болатын алып федеративті мемлекет дүниеге келеді.
Dialogue: 0,0:13:57.74,0:13:58.74,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:13:59.57,0:14:02.45,Default,,0,0,0,,Бөлінген Е.У-нің бір бөлігі деп айтылады. да қамтылады.
Dialogue: 0,0:14:02.58,0:14:03.66,Default,,0,0,0,,Ұлттық билік күшті
Dialogue: 0,0:14:04.54,0:14:07.54,Default,,0,0,0,,ЕО-дан шыққан елдер. Польша, Италия және Румыния болды...
Dialogue: 0,0:14:07.67,0:14:09.63,Default,,0,0,0,,Созаку және басқалары түсінеді, бірақ-
Dialogue: 0,0:14:09.75,0:14:12.75,Default,,0,0,0,,Неліктен мен Лелуш пен Роломен байланыса алмаймын?
Dialogue: 0,0:14:13.05,0:14:15.21,Default,,0,0,0,,Бұл елдердің өкілдерін не көндірді...
Dialogue: 0,0:14:15.34,0:14:16.80,Default,,0,0,0,,Бұл Қара рыцарьлар.
Dialogue: 0,0:14:16.92,0:14:19.47,Default,,0,0,0,,Бұл коалицияның көшбасшылары нөлдік екенін білдіреді.
Dialogue: 0,0:14:19.59,0:14:22.68,Default,,0,0,0,,Басқаша айтқанда, оның Британияның жауына айналу ықтималдығы жоғары.
Dialogue: 0,0:14:22.81,0:14:24.52,Default,,0,0,0,,Қазіргі уақытта Кюсю Чугоку
Dialogue: 0,0:14:24.64,0:14:26.73,Default,,0,0,0,,Хокуликке бағытталған әскери орналастыру...
Dialogue: 0,0:14:29.19,0:14:30.73,Default,,0,0,0,,Трансляцияны көріп отырғандар үшін
Dialogue: 0,0:14:30.86,0:14:33.40,Default,,0,0,0,,Дәл қазір барлық 47 ел...
Dialogue: 0,0:14:33.52,0:14:35.73,Default,,0,0,0,,Америка Құрама Штаттарының Жарғысын ратификациялау аяқталды
Dialogue: 0,0:14:35.86,0:14:36.69,Default,,0,0,0,,Жалғасы...
Dialogue: 0,0:14:37.99,0:14:39.20,Default,,0,0,0,,Лорд Гилдфорд
Dialogue: 0,0:14:39.32,0:14:41.53,Default,,0,0,0,,Әскери парадқа дайындық аяқталды.
Dialogue: 0,0:14:41.66,0:14:43.41,Default,,0,0,0,,Аа, мен қазір келе жатырмын.
Dialogue: 0,0:14:43.53,0:14:44.95,Default,,0,0,0,,(Коммуникатордың қоңырау үні)
Dialogue: 0,0:14:45.08,0:14:47.54,Default,,0,0,0,,Не? Әскери парадқа келсек...
Dialogue: 0,0:14:47.66,0:14:48.66,Default,,0,0,0,,Лорд Гилдфорд
Dialogue: 0,0:14:49.12,0:14:51.38,Default,,0,0,0,,Уф Оранж-кун
Dialogue: 0,0:14:51.75,0:14:54.63,Default,,0,0,0,,Америка Құрама Штаттарының тұжырымдамасы Күтілгендей.
Dialogue: 0,0:14:54.75,0:14:55.42,Default,,0,0,0,,дәл қазір менің алдымда тұр!
Dialogue: 0,0:14:55.55,0:14:58.88,Default,,0,0,0,,Ел ұйымдастырған әскерлер міндетті түрде үйлестіре алмайды.
Dialogue: 0,0:14:59.01,0:15:00.89,Default,,0,0,0,,Біз бір топ қарғадан басқа ештеңе емеспіз.
Dialogue: 0,0:15:01.01,0:15:02.85,Default,,0,0,0,,Жоқ, бір ғана нұсқа бар.
Dialogue: 0,0:15:02.97,0:15:04.14,Default,,0,0,0,,...Қақтығыс болған жағдайда -
Dialogue: 0,0:15:04.26,0:15:06.89,Default,,0,0,0,,Осы Жарғы бойынша міндеттемелер басым болады.
Dialogue: 0,0:15:07.31,0:15:10.81,Default,,0,0,0,,Соңында, Америка Құрама Штаттарының Жарғысының 17-бабы
Dialogue: 0,0:15:10.94,0:15:13.31,Default,,0,0,0,,Америка Құрама Штаттарының Жарғысын ратификациялаған мемлекеттер...
Dialogue: 0,0:15:13.44,0:15:16.03,Default,,0,0,0,,Өзіне тән әскери биліктен біржола бас тарту
Dialogue: 0,0:15:16.15,0:15:17.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:17.15,0:15:18.44,Default,,0,0,0,,Әскери биліктен бас тарту?
Dialogue: 0,0:15:18.57,0:15:19.40,Default,,0,0,0,,Келесі, Наоми Минами ісіне қатысты:
Dialogue: 0,0:15:19.78,0:15:23.37,Default,,0,0,0,,Әр Америка Құрама Штаттарының қауіпсіздігіне келетін болсақ --
Dialogue: 0,0:15:23.49,0:15:26.20,Default,,0,0,0,,Ешбір ұлтқа жатпайтын жауынгерлік топ--
Dialogue: 0,0:15:26.33,0:15:28.58,Default,,0,0,0,,Қара рыцарлармен келісімшартқа отырыңыз
Dialogue: 0,0:15:29.00,0:15:30.87,Default,,0,0,0,,Келісімшарт қабылданды
Dialogue: 0,0:15:31.46,0:15:34.38,Default,,0,0,0,,Біз, Қара рыцарьлар, біртұтас ұлттанбыз.
Dialogue: 0,0:15:34.50,0:15:36.96,Default,,0,0,0,,Қаржы мен қамтамасыз етілген қызметкерлерді алыңыз
Dialogue: 0,0:15:37.09,0:15:38.17,Default,,0,0,0,,Оның орнына-
Dialogue: 0,0:15:38.30,0:15:41.34,Default,,0,0,0,,Біз бүкіл Америка Құрама Штаттарын қорғайтын қалқан боламыз.
Dialogue: 0,0:15:41.47,0:15:43.84,Default,,0,0,0,,Сыртқы жауларды басқару үшін қылыш бол
Dialogue: 0,0:15:43.97,0:15:45.51,Default,,0,0,0,,Күткендей ме?
Dialogue: 0,0:15:47.64,0:15:50.85,Default,,0,0,0,,Әр елдің қарулы күштері бар екендігі – аласапыранның көзі.
Dialogue: 0,0:15:51.48,0:15:55.61,Default,,0,0,0,,Біріккен елдерде тек Жоғарғы Кеңестің қаулысымен -
Dialogue: 0,0:15:55.73,0:15:57.98,Default,,0,0,0,,Әскери күш қолдану
Dialogue: 0,0:15:58.11,0:16:00.78,Default,,0,0,0,,Енді менің бірінші қимылым.
Dialogue: 0,0:16:01.15,0:16:05.28,Default,,0,0,0,,Біздің елдің жері Жапонияны басқа елдер басып алды.
Dialogue: 0,0:16:05.41,0:16:07.20,Default,,0,0,0,,Әділетсіз басқыншылыққа ұшырауын жалғастырады
Dialogue: 0,0:16:07.99,0:16:10.87,Default,,0,0,0,,Мен Қара Рыцарларды жөнелтуді сұрағым келеді.
Dialogue: 0,0:16:11.12,0:16:13.29,Default,,0,0,0,,Келіссеңіз, тұрыңыз.
Dialogue: 0,0:16:18.38,0:16:19.46,Default,,0,0,0,,Көпшілік қолдады
Dialogue: 0,0:16:19.59,0:16:23.05,Default,,0,0,0,,Сондықтан супербіріккен ұлттардың бірінші қарары ретінде...
Dialogue: 0,0:16:23.18,0:16:26.47,Default,,0,0,0,,Біз Қара рыцарьлардан Жапонияны азат етуді сұраймыз.
Dialogue: 0,0:16:26.60,0:16:27.76,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:16:27.89,0:16:32.52,Default,,0,0,0,,Біріккен Ұлттар Ұйымының №1 қарары Шерудің мақсаты -
Dialogue: 0,0:16:32.64,0:16:33.39,Default,,0,0,0,,Жапония
Dialogue: 0,0:16:33.52,0:16:35.81,Default,,0,0,0,,(қатысқандардың алғысы)
Dialogue: 0,0:16:35.94,0:16:36.94,Default,,0,0,0,,Қайтарыңыз
Dialogue: 0,0:16:37.06,0:16:38.48,Default,,0,0,0,,Біздің Жапония
Dialogue: 0,0:16:38.90,0:16:40.53,Default,,0,0,0,,Енді Карен-чан да
Dialogue: 0,0:16:40.65,0:16:42.90,Default,,0,0,0,,А-а, дұрыс.
Dialogue: 0,0:16:45.99,0:16:46.91,Default,,0,0,0,,Нөл
Dialogue: 0,0:16:47.03,0:16:48.87,Default,,0,0,0,,Не! ?
Dialogue: 0,0:16:48.99,0:16:49.95,Default,,0,0,0,,Бұзушылық?
Dialogue: 0,0:16:50.08,0:16:52.04,Default,,0,0,0,,14-тің түбірінен үзінді
Dialogue: 0,0:16:52.62,0:16:54.62,Default,,0,0,0,,Мәртебелі император...
Dialogue: 0,0:16:54.75,0:16:56.29,Default,,0,0,0,,Сіз оралдыңыз.
Dialogue: 0,0:16:56.42,0:16:59.80,Default,,0,0,0,,Сіз жалған театр ойнап жатырсыз ба, әке?
Dialogue: 0,0:16:59.96,0:17:01.26,Default,,0,0,0,,Сақтық көшірмелерді пайдаланыңыз!
Dialogue: 0,0:17:01.38,0:17:02.59,Default,,0,0,0,,Ажырату
Dialogue: 0,0:17:02.72,0:17:04.76,Default,,0,0,0,,Жоқ, қосалқы бөлшектер де сақталады.
Dialogue: 0,0:17:04.88,0:17:08.64,Default,,0,0,0,,Нөл, сен мені алдамақшысың ба?
Dialogue: 0,0:17:08.76,0:17:09.60,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:17:09.72,0:17:10.64,Default,,0,0,0,,Ол тірі еді! ?
Dialogue: 0,0:17:10.89,0:17:13.35,Default,,0,0,0,,Бірақ жаман емес
Dialogue: 0,0:17:13.73,0:17:16.90,Default,,0,0,0,,Үш станцияның бірі Е.У. қазірдің өзінде өлім аузында тұр.
Dialogue: 0,0:17:17.02,0:17:19.77,Default,,0,0,0,,Басқаша айтқанда, сіз жасаған шағын жарғы...
Dialogue: 0,0:17:19.90,0:17:24.03,Default,,0,0,0,,Әлемді Британия және Британдық емес деп түспен белгілеңіз
Dialogue: 0,0:17:24.36,0:17:27.11,Default,,0,0,0,,Қарапайым, сондықтан түсінікті
Dialogue: 0,0:17:27.24,0:17:30.20,Default,,0,0,0,,Соңында бұл шайқаста жеңген тарап...
Dialogue: 0,0:17:30.66,0:17:33.54,Default,,0,0,0,,Дүниені иемдену
Dialogue: 0,0:17:33.66,0:17:37.12,Default,,0,0,0,,Жарайды, Нөл, мені шақыр.
Dialogue: 0,0:17:37.25,0:17:41.38,Default,,0,0,0,,Барлығына ие болыңыз немесе бәрін жоғалтыңыз
Dialogue: 0,0:17:41.50,0:17:44.72,Default,,0,0,0,,Ұрыс деген осы.
Dialogue: 0,0:17:44.84,0:17:48.51,Default,,0,0,0,,Сәлем Британия!
Dialogue: 0,0:17:48.64,0:17:50.47,Default,,0,0,0,,Британияға сәлем!
Dialogue: 0,0:17:50.60,0:17:52.14,Default,,0,0,0,,Британияға сәлем!
Dialogue: 0,0:17:52.26,0:17:54.18,Default,,0,0,0,,Британияға сәлем!
Dialogue: 0,0:17:54.31,0:17:55.64,Default,,0,0,0,,Британға сәлем...
Dialogue: 0,0:17:55.77,0:17:57.81,Default,,0,0,0,,Жасасын Жапония!
Dialogue: 0,0:17:57.94,0:17:58.60,Default,,0,0,0,,Жапония…
Dialogue: 0,0:17:58.73,0:17:59.65,Default,,0,0,0,,Аман болсын!
Dialogue: 0,0:17:59.77,0:18:01.57,Default,,0,0,0,,Британияға сәлем!
Dialogue: 0,0:18:01.69,0:18:03.15,Default,,0,0,0,,Британияға сәлем!
Dialogue: 0,0:18:03.28,0:18:04.11,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:18:04.23,0:18:06.28,Default,,0,0,0,,Жасасын Жапония
Dialogue: 0,0:18:06.40,0:18:08.41,Default,,0,0,0,,Жасасын Жапония
Dialogue: 0,0:18:08.53,0:18:10.74,Default,,0,0,0,,Жапония аман болсын
Dialogue: 0,0:18:11.99,0:18:14.12,Default,,0,0,0,,Император тірі болды
Dialogue: 0,0:18:14.62,0:18:17.08,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:18:17.29,0:18:20.67,Default,,0,0,0,,Жоқ, мен бірден Наннеллиге көмектесуім керек.
Dialogue: 0,0:18:20.79,0:18:21.96,Default,,0,0,0,,Қазір
Dialogue: 0,0:18:25.80,0:18:27.80,Default,,0,0,0,,Корнелияның картасы мына жерде...
Dialogue: 0,0:18:27.93,0:18:30.18,Default,,0,0,0,,Жоқ, бұл кепілдегі адам сөйлесе алатын адам емес.
Dialogue: 0,0:18:30.30,0:18:32.81,Default,,0,0,0,,Еремия мен Ролоны пайдалану... Жақсы емес.
Dialogue: 0,0:18:32.93,0:18:34.68,Default,,0,0,0,,Геасс оған жұмыс істемейді.
Dialogue: 0,0:18:34.81,0:18:37.52,Default,,0,0,0,,Сіз әлемге Нөлдің Лелуш екенін ашқыңыз келе ме?
Dialogue: 0,0:18:37.64,0:18:40.23,Default,,0,0,0,,Бірақ көсем жау елдің ханзадасы болса...
Dialogue: 0,0:18:40.35,0:18:42.31,Default,,0,0,0,,Қара рыцарьлар күйреді
Dialogue: 0,0:18:42.44,0:18:43.90,Default,,0,0,0,,Мен Нунеллиге көмектессем де...
Dialogue: 0,0:18:44.02,0:18:46.32,Default,,0,0,0,,Ешбір ел қабылдамаса, бұл ештеңені білдірмейді
Dialogue: 0,0:18:46.44,0:18:48.40,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:18:49.78,0:18:53.41,Default,,0,0,0,,Мен мұны күйеуім үшін сақтап қойдым.
Dialogue: 0,0:18:53.53,0:18:56.75,Default,,0,0,0,,Ол таңғы ас ішпеген сияқты болды.
Dialogue: 0,0:18:57.16,0:18:58.25,Default,,0,0,0,,Бұл
Dialogue: 0,0:18:58.37,0:18:59.21,Default,,0,0,0,,Шулы!
Dialogue: 0,0:18:59.33,0:19:00.54,Default,,0,0,0,,Уау
Dialogue: 0,0:19:02.42,0:19:03.29,Default,,0,0,0,,Га
Dialogue: 0,0:19:08.76,0:19:09.59,Default,,0,0,0,,Эй
Dialogue: 0,0:19:09.72,0:19:12.72,Default,,0,0,0,,Уф, кешіріңіз, мен оны қазір тазалаймын.
Dialogue: 0,0:19:12.85,0:19:14.43,Default,,0,0,0,,Бұл дұрыс емес (C.C.) Уф.
Dialogue: 0,0:19:14.68,0:19:16.68,Default,,0,0,0,,Қан шығып жатыр, солай ма?
Dialogue: 0,0:19:16.81,0:19:19.56,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:19:19.69,0:19:22.48,Default,,0,0,0,,Мен өзімді әдеттегіден әлдеқайда жақсы сезінемін.
Dialogue: 0,0:19:23.36,0:19:25.23,Default,,0,0,0,,Әдеттегіден көп
Dialogue: 0,0:19:29.19,0:19:32.07,Default,,0,0,0,,Бірақ ол суықта көмектеседі.
Dialogue: 0,0:19:32.20,0:19:33.82,Default,,0,0,0,,Өйткені ол ыстық
Dialogue: 0,0:19:33.95,0:19:37.20,Default,,0,0,0,,Суық кезде аяқ-қолды қимылдату қиынға соғады, жұмыс істеуге болмайды.
Dialogue: 0,0:19:37.58,0:19:38.83,Default,,0,0,0,,Ендеше, жарайды.
Dialogue: 0,0:19:38.95,0:19:42.17,Default,,0,0,0,,Іштен гөрі сырттан көбірек ауырады.
Dialogue: 0,0:19:43.88,0:19:46.84,Default,,0,0,0,,Ұстаз, тоңып қалдыңыз ба?
Dialogue: 0,0:19:46.96,0:19:51.05,Default,,0,0,0,,Хмм, мүмкін солай шығар.
Dialogue: 0,0:19:55.43,0:19:58.56,Default,,0,0,0,,Іштен ауырғанда не істедің?
Dialogue: 0,0:19:58.93,0:20:00.35,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:03.44,0:20:04.35,Default,,0,0,0,,Жарай бер, жарай бер — сен ауаны тұншықтырып жатырсың, шетке жыл.
Dialogue: 0,0:20:04.48,0:20:05.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:05.73,0:20:08.44,Default,,0,0,0,,Достарым болса екен.
Dialogue: 0,0:20:08.57,0:20:10.28,Default,,0,0,0,,Ата-ана мен бауырлардан айырмашылығы...
Dialogue: 0,0:20:10.40,0:20:12.99,Default,,0,0,0,,Кейінірек достасуға болады.
Dialogue: 0,0:20:13.61,0:20:16.95,Default,,0,0,0,,Бірақ менің ондай одақтастарым жоқ.
Dialogue: 0,0:20:17.41,0:20:18.74,Default,,0,0,0,,Мен…
Dialogue: 0,0:20:18.87,0:20:22.25,Default,,0,0,0,,Мм, мен естідім, бірақ бұл дұрыс емес пе?
Dialogue: 0,0:20:22.46,0:20:24.17,Default,,0,0,0,,Жоқ, ол басқаша емес.
Dialogue: 0,0:20:24.63,0:20:26.04,Default,,0,0,0,,Бұл дос
Dialogue: 0,0:20:26.54,0:20:30.55,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:20:30.84,0:20:35.51,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:20:36.35,0:20:37.18,Default,,0,0,0,,Иә
Dialogue: 0,0:20:37.30,0:20:38.22,Default,,0,0,0,,Уф
Dialogue: 0,0:20:39.01,0:20:39.85,Default,,0,0,0,,Сузаку?
Dialogue: 0,0:20:40.35,0:20:41.68,Default,,0,0,0,,Лелуч?
Dialogue: 0,0:20:41.81,0:20:45.19,Default,,0,0,0,,Әй, бұл... жаңалықты білесің.
Dialogue: 0,0:20:45.31,0:20:49.15,Default,,0,0,0,,Иә, енді 11-аймақ қайтадан ұрыс алаңына айналады.
Dialogue: 0,0:20:49.32,0:20:51.49,Default,,0,0,0,,Токио концессиясы да қауіпті ме?
Dialogue: 0,0:20:51.61,0:20:54.20,Default,,0,0,0,,Мұны өзіңіз шешесіз.
Dialogue: 0,0:20:54.32,0:20:55.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:55.16,0:20:57.66,Default,,0,0,0,,Лелуш Сіз нөлсіз бе?
Dialogue: 0,0:20:57.78,0:20:59.91,Default,,0,0,0,,А, а, иә?
Dialogue: 0,0:21:02.29,0:21:03.12,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:03.79,0:21:05.04,Default,,0,0,0,,Мен нөлмін
Dialogue: 0,0:21:05.17,0:21:09.34,Default,,0,0,0,,Қарғыс атсын, Британияның жауларына менен не керек?
Dialogue: 0,0:21:09.46,0:21:11.34,Default,,0,0,0,,Нуналлиге көмектесіңізші.
Dialogue: 0,0:21:11.46,0:21:12.09,Default,,0,0,0,,Ах
Dialogue: 0,0:21:12.67,0:21:16.39,Default,,0,0,0,,Император мені бақылауда ұстау үшін Нунеллиді кепілде ұстап отыр.
Dialogue: 0,0:21:16.51,0:21:18.93,Default,,0,0,0,,Сондықтан менде тығылып, қозғалудан басқа амал қалмады.
Dialogue: 0,0:21:21.47,0:21:25.19,Default,,0,0,0,,Өтінемін, Созаку, сенен басқа сұрайтын ешкім жоқ.
Dialogue: 0,0:21:25.52,0:21:28.94,Default,,0,0,0,,Сіздің өтінішіңізді қабылдаймын деп ойлайсыз ба?
Dialogue: 0,0:21:29.65,0:21:32.61,Default,,0,0,0,,Мен олай ойламаймын, бірақ менде жалғыз сенсің
Dialogue: 0,0:21:32.86,0:21:33.86,Default,,0,0,0,,Бұл өзімшілдік.
Dialogue: 0,0:21:33.99,0:21:38.57,Default,,0,0,0,,Мен білемін! Бірақ сен жалғызсың
Dialogue: 0,0:21:38.78,0:21:39.45,Default,,0,0,0,,Иә
Dialogue: 0,0:21:39.78,0:21:43.04,Default,,0,0,0,,Өтінемін! Нуннальды ...
Dialogue: 0,0:21:44.66,0:21:46.21,Default,,0,0,0,,Қорғаңыз
Dialogue: 0,0:21:47.12,0:21:47.83,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:21:47.96,0:21:48.58,Default,,0,0,0,,Га
Dialogue: 0,0:21:49.08,0:21:51.04,Default,,0,0,0,,Дегенмен, шарттар бар.
Dialogue: 0,0:21:51.96,0:21:54.05,Default,,0,0,0,,Егер сіз Nunnally-ді қорғағыңыз келсе...
Dialogue: 0,0:21:54.17,0:21:56.09,Default,,0,0,0,,Бұл аймақта 11 Нуналли орналасқан...
Dialogue: 0,0:21:56.22,0:21:58.22,Default,,0,0,0,,Сіз жалғыз келуіңіз керек.
Dialogue: 0,0:21:58.34,0:22:00.35,Default,,0,0,0,,Орналасқан жері: Куруруги храмы
Dialogue: 0,0:22:00.72,0:22:02.14,Default,,0,0,0,,Э? Ах… жоқ, мен жай ғана…
Dialogue: 0,0:22:02.26,0:22:03.27,Default,,0,0,0,,Танысайық
Dialogue: 0,0:22:03.39,0:22:06.98,Default,,0,0,0,,♪～
Dialogue: 0,0:22:07.10,0:22:10.52,Default,,0,0,0,,♪Дүние жын, әділдік деген не?
Dialogue: 0,0:22:10.65,0:22:14.48,Default,,0,0,0,,♪Сұрамай тұрып, қарсылық көрсет, жамандық гүлі
Dialogue: 0,0:22:14.61,0:22:17.91,Default,,0,0,0,,♪ Екіжүзділікті армандау, Көзге қарау
Dialogue: 0,0:22:18.03,0:22:22.03,Default,,0,0,0,,♪Өмір мен зұлымдықтың арасы жоқ.
Dialogue: 0,0:22:25.45,0:22:28.96,Default,,0,0,0,,♪Жарық ұрық сияқты жоғалады
Dialogue: 0,0:22:29.08,0:22:32.92,Default,,0,0,0,,♪Ұйқыдағы қараңғылық құрсағынсың
Dialogue: 0,0:22:33.05,0:22:36.38,Default,,0,0,0,,♪Жалғыздық сүйкімді
Dialogue: 0,0:22:36.51,0:22:40.09,Default,,0,0,0,,♪Ол сенің жалғыз одақтасың болады
Dialogue: 0,0:22:40.22,0:22:43.76,Default,,0,0,0,,♪Бәрі қанға боялған
Dialogue: 0,0:22:43.89,0:22:47.68,Default,,0,0,0,,♪ Осы дәуірде дүниеге келген
Dialogue: 0,0:22:47.81,0:22:54.61,Default,,0,0,0,,♪Таңдаулы ханзадалар, шайқас – береке
Dialogue: 0,0:22:54.94,0:22:59.45,Default,,0,0,0,,♪Ах, мен сұлумын, бәрін білемін.
Dialogue: 0,0:22:59.57,0:23:03.16,Default,,0,0,0,,♪Сүйікті ана сені дүниеге әкеледі
Dialogue: 0,0:23:03.28,0:23:05.91,Default,,0,0,0,,♪Бұл сүт немен қоректенеді?
Dialogue: 0,0:23:06.04,0:23:09.71,Default,,0,0,0,,♪Тозақтағы бауырлар
Dialogue: 0,0:23:10.87,0:23:14.17,Default,,0,0,0,,♪Аянның белгісі Ақиқат дегеніміз не?
Dialogue: 0,0:23:14.29,0:23:18.17,Default,,0,0,0,,♪Белгісіз және көмілген, жасырылған тұқымдар
Dialogue: 0,0:23:18.30,0:23:21.64,Default,,0,0,0,,♪Қос жүзді қылыш, жүзді суырып алғаныңызға қаратыңыз
Dialogue: 0,0:23:21.76,0:23:25.35,Default,,0,0,0,,♪Қорғау керек нәрсеге ғана сеніңіз
Dialogue: 0,0:23:25.47,0:23:32.48,Default,,0,0,0,,♪Өзіңіз қандай болсаңыз, солай болыңыз.
Dialogue: 0,0:23:37.53,0:23:38.90,Default,,0,0,0,,Егер бұл орын алса...
Dialogue: 0,0:23:39.03,0:23:42.07,Default,,0,0,0,,Мен Нунеллиді құтқаруға мәжбүрлеуім керек пе еді?
Dialogue: 0,0:23:42.20,0:23:44.62,Default,,0,0,0,,Бірақ бұл өте қауіпті.
Dialogue: 0,0:23:44.74,0:23:49.41,Default,,0,0,0,,Қарғыс атсын, бұл дұрыс. Маған сеніңіз. Созақуға сенуден басқа амалым жоқ.
Dialogue: 0,0:23:49.54,0:23:51.12,Default,,0,0,0,,Мен Созаку...
Dialogue: 0,0:23:52.62,0:23:58.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory