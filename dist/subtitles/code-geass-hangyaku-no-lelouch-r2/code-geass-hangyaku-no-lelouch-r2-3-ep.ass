Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.10,0:00:03.06,Default,,0,0,0,,Императорлық күнтізбе 2017 жыл
Dialogue: 0,0:00:03.19,0:00:06.31,Default,,0,0,0,,11-аудан деп аталатын колония Жапония...
Dialogue: 0,0:00:06.48,0:00:09.90,Default,,0,0,0,,Сюзерен Қасиетті Британ империясына қарсы
Dialogue: 0,0:00:10.03,0:00:11.82,Default,,0,0,0,,тәуелсіздік үшін соғыс жүргізді
Dialogue: 0,0:00:12.65,0:00:15.57,Default,,0,0,0,,Қара көтеріліс деп аталатын бұл азаматтық соғыс...
Dialogue: 0,0:00:15.87,0:00:19.58,Default,,0,0,0,,Перде Жапонияның тарихтағы екінші жеңілісі ретінде аяқталады.
Dialogue: 0,0:00:20.83,0:00:24.42,Default,,0,0,0,,Бір жылдан кейін өлуі тиіс лаңкес...
Dialogue: 0,0:00:24.54,0:00:27.38,Default,,0,0,0,,11-аймақта өзін нөл деп атайтын адам пайда болды.
Dialogue: 0,0:00:28.34,0:00:31.38,Default,,0,0,0,,Қара рыцарьлар қарулы тобын басқаратын Нөл.
Dialogue: 0,0:00:31.51,0:00:35.80,Default,,0,0,0,,Оның шынайы тұлғасы - Британ империясының тасталған ханзадасы.
Dialogue: 0,0:00:35.93,0:00:38.01,Default,,0,0,0,,Лелуш Ламперуж
Dialogue: 0,0:00:38.22,0:00:43.64,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:00:43.77,0:00:46.44,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:00:46.56,0:00:49.36,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:00:49.48,0:00:54.95,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:00:55.07,0:00:57.87,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:00:57.99,0:01:00.74,Default,,0,0,0,,♪Енді кеттік, мен аққан жұлдызмын
Dialogue: 0,0:01:06.54,0:01:12.00,Default,,0,0,0,,♪Дүние ыдыраса да, ешқашан өзгермейтін нәрселер бар.
Dialogue: 0,0:01:12.13,0:01:17.59,Default,,0,0,0,,♪Көз жасымызды тыйсақ та, қорғайтын нәрсе бар.
Dialogue: 0,0:01:17.72,0:01:20.47,Default,,0,0,0,,♪Он мыңдаған жылдар бұрынғы хабарлар дененің ішінде.
Dialogue: 0,0:01:20.60,0:01:23.02,Default,,0,0,0,,♪Сырылдап, дыбыстай бастайды
Dialogue: 0,0:01:23.31,0:01:25.94,Default,,0,0,0,,♪Ертең қарлығаш дауыспен қоңырау шалыңыз
Dialogue: 0,0:01:26.10,0:01:29.06,Default,,0,0,0,,♪Мен сені тыртық қолыммен қорғаймын
Dialogue: 0,0:01:29.31,0:01:32.11,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:01:32.23,0:01:34.65,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:01:36.32,0:01:41.58,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:01:41.70,0:01:43.99,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:01:44.45,0:01:47.29,Default,,0,0,0,,♪Ұрыстың қайда екені белгісіз.
Dialogue: 0,0:01:47.42,0:01:52.80,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:01:52.92,0:01:55.42,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:01:55.55,0:02:00.01,Default,,0,0,0,,♪Тағдырды кесіп өткен аққан жұлдыз
Dialogue: 0,0:02:00.14,0:02:04.47,Default,,0,0,0,,♪Тасып жатқан көз жасыңды мен қазір алып кетемін
Dialogue: 0,0:02:14.90,0:02:18.45,Default,,0,0,0,,Осымен Америка Құрама Штаттары мен Жапонияның құрылғанын жариялаймын.
Dialogue: 0,0:02:18.57,0:02:20.11,Default,,0,0,0,,Қайтадан хабарлаңыз
Dialogue: 0,0:02:20.91,0:02:22.16,Default,,0,0,0,,Осы сәттен бастап-
Dialogue: 0,0:02:22.28,0:02:26.08,Default,,0,0,0,,Бұл бөлме Жапония Құрама Штаттарының бірінші аумағына айналады.
Dialogue: 0,0:02:26.20,0:02:29.92,Default,,0,0,0,,Нәсіліне, принципіне немесе дініне қарамастан
Dialogue: 0,0:02:30.04,0:02:33.29,Default,,0,0,0,,Азамат болу үшін бір ғана біліктілік бар.
Dialogue: 0,0:02:33.59,0:02:35.38,Default,,0,0,0,,Әділдік жасау
Dialogue: 0,0:02:37.09,0:02:40.09,Default,,0,0,0,,Мен Нөлді өлтіруге келдім.
Dialogue: 0,0:02:40.22,0:02:43.68,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:02:43.97,0:02:46.18,Default,,0,0,0,,Бұл жай ғана телефон қоңырауы.
Dialogue: 0,0:02:46.43,0:02:47.68,Default,,0,0,0,,Роло, жақсысың ба?
Dialogue: 0,0:02:47.81,0:02:49.39,Default,,0,0,0,,А, аға?
Dialogue: 0,0:02:49.56,0:02:50.69,Default,,0,0,0,,Жақсы
Dialogue: 0,0:02:50.81,0:02:52.98,Default,,0,0,0,,Мен сізбен байланыса алмағандықтан уайымдадым.
Dialogue: 0,0:02:53.48,0:02:56.23,Default,,0,0,0,,Сіз қауіпсізсіз бе? Сіз қауіпсіз жердесіз бе?
Dialogue: 0,0:02:56.61,0:02:57.90,Default,,0,0,0,,Біз, Арнайы операциялар бөлімшесі, осындамыз
Dialogue: 0,0:02:58.32,0:03:00.82,Default,,0,0,0,,Қазір сөйлеп тұрған Нөл басқа адам ма?
Dialogue: 0,0:03:01.32,0:03:03.24,Default,,0,0,0,,Бауырым, қазір қайдасың?
Dialogue: 0,0:03:03.41,0:03:06.33,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Қазір сенсің.
Dialogue: 0,0:03:06.45,0:03:07.91,Default,,0,0,0,,Лоло, бұл менмін.
Dialogue: 0,0:03:08.37,0:03:09.46,Default,,0,0,0,,Мұғалім Виллетта?
Dialogue: 0,0:03:09.62,0:03:13.38,Default,,0,0,0,,Лелуш мектепке қайтып келді. Ол қазір қосымша сабақтарға барады.
Dialogue: 0,0:03:13.50,0:03:14.84,Default,,0,0,0,,Сіз де тезірек оралуыңыз керек.
Dialogue: 0,0:03:16.00,0:03:18.01,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,0:03:19.51,0:03:21.59,Default,,0,0,0,,) Телефон қоңырауы аяқталды ма? бала
Dialogue: 0,0:03:22.93,0:03:25.80,Default,,0,0,0,,Бәрі біткен сияқты.
Dialogue: 0,0:03:28.18,0:03:29.60,Default,,0,0,0,,Қара рыцарьлардың қалдықтарымен...
Dialogue: 0,0:03:29.73,0:03:31.23,Default,,0,0,0,,Өзін Нөл деп атайтын адам...
Dialogue: 0,0:03:31.35,0:03:34.52,Default,,0,0,0,,Қытай Федералдық Бас консулдығының бір бөлігінде әлі де баррикада
Dialogue: 0,0:03:35.06,0:03:36.77,Default,,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,0:03:36.90,0:03:39.11,Default,,0,0,0,,Зардап шеккен губернатор Карралестің атынан...
Dialogue: 0,0:03:39.24,0:03:41.40,Default,,0,0,0,,Губернатор міндетін атқарушы Гилдфорд басқарған армия...
Dialogue: 0,0:03:41.53,0:03:43.36,Default,,0,0,0,,Консулдық толығымен қоршалған
Dialogue: 0,0:03:44.03,0:03:47.03,Default,,0,0,0,,Енді біз Концессияның қауіпсіздігі қамтамасыз етілген деп айта аламыз.
Dialogue: 0,0:03:47.16,0:03:48.83,Default,,0,0,0,,Қандай әбігер, Лелуч.
Dialogue: 0,0:03:48.95,0:03:50.45,Default,,0,0,0,,) Әрине, солай ма?
Dialogue: 0,0:03:50.58,0:03:54.29,Default,,0,0,0,,Кенеттен өз территориямызда ел құрылды.
Dialogue: 0,0:03:54.42,0:03:58.17,Default,,0,0,0,,Оның үстіне бұл ел соғыс жариялады.
Dialogue: 0,0:03:58.30,0:04:00.30,Default,,0,0,0,,Ah (C.C.) Не?
Dialogue: 0,0:04:00.71,0:04:02.42,Default,,0,0,0,,Ол қашан ауыстырылды?
Dialogue: 0,0:04:02.55,0:04:03.47,Default,,0,0,0,,Сөз алдында
Dialogue: 0,0:04:03.59,0:04:05.14,Default,,0,0,0,,Не? Өйткені
Dialogue: 0,0:04:05.26,0:04:09.22,Default,,0,0,0,,Дауыс — жазба. Ол пайда болған сәтте ол басқа адам.
Dialogue: 0,0:04:09.35,0:04:11.23,Default,,0,0,0,,Бұл сиқырлы шоумен бірдей.
Dialogue: 0,0:04:11.64,0:04:13.10,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:04:13.23,0:04:15.31,Default,,0,0,0,,Оны бізден құпия ұстауға қалай дәтің бар?
Dialogue: 0,0:04:15.44,0:04:18.86,Default,,0,0,0,,Біз? Маған, солай ма?
Dialogue: 0,0:04:19.02,0:04:19.94,Default,,0,0,0,,Құт
Dialogue: 0,0:04:25.32,0:04:26.70,Default,,0,0,0,,Лелуш пеші
Dialogue: 0,0:04:26.95,0:04:28.20,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:04:29.66,0:04:31.00,Default,,0,0,0,,Тұз
Dialogue: 0,0:04:31.16,0:04:32.58,Default,,0,0,0,,Қуыруға арналған таба
Dialogue: 0,0:04:32.79,0:04:34.50,Default,,0,0,0,,Жұмыртқа
Dialogue: 0,0:04:34.71,0:04:36.50,Default,,0,0,0,,Бехамель соусы
Dialogue: 0,0:04:36.63,0:04:37.46,Default,,0,0,0,,Жеке тәрелкедегі гелато
Dialogue: 0,0:04:37.59,0:04:39.25,Default,,0,0,0,,Әй, розмаринді шығарып, шербет жаса.
Dialogue: 0,0:04:39.38,0:04:41.34,Default,,0,0,0,,Ал ашытылған қырыққабат – аскөк тұқымы.
Dialogue: 0,0:04:41.46,0:04:42.63,Default,,0,0,0,,Шварцвердер Киршторте бұл...
Dialogue: 0,0:04:42.76,0:04:44.47,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:04:44.59,0:04:46.34,Default,,0,0,0,,Неліктен жалғыз мен осындаймын?
Dialogue: 0,0:04:46.47,0:04:47.85,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:04:47.97,0:04:50.51,Default,,0,0,0,,Қарсыластың дәмі жоқ, екіншісінің дәмі жоқ.
Dialogue: 0,0:04:50.72,0:04:54.14,Default,,0,0,0,,Уау Уау Уау Уау Уау
Dialogue: 0,0:04:54.27,0:04:57.48,Default,,0,0,0,,Сіз егжей-тегжейлі білмедіңіз, мен түсінемін.
Dialogue: 0,0:04:57.61,0:04:59.36,Default,,0,0,0,,Иә, шынымды айтсам болады.
Dialogue: 0,0:04:59.48,0:05:02.15,Default,,0,0,0,,Солай болса да, мінездің мұндай түрі өмір сүруге күші жетпейді...
Dialogue: 0,0:05:02.28,0:05:03.78,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:05:03.99,0:05:05.99,Default,,0,0,0,,Мен тіпті шаруашылық есеп кітабын жүргіземін.
Dialogue: 0,0:05:06.11,0:05:07.11,Default,,0,0,0,,Неліктен білесің?
Dialogue: 0,0:05:07.24,0:05:08.12,Default,,0,0,0,,Бұл рас болды ма?
Dialogue: 0,0:05:08.24,0:05:10.53,Default,,0,0,0,,Вааааааааааааааааааааааааа
Dialogue: 0,0:05:11.16,0:05:12.45,Default,,0,0,0,,Сізге орамал керек пе?
Dialogue: 0,0:05:12.58,0:05:14.75,Default,,0,0,0,,Өзіңіз жасаңыз
Dialogue: 0,0:05:16.08,0:05:18.17,Default,,0,0,0,,Төраға, сізден бірдеңе сұрасам болады ма?
Dialogue: 0,0:05:18.83,0:05:21.05,Default,,0,0,0,,Жауап бермеуіңіз мүмкін, бірақ бәрібір.
Dialogue: 0,0:05:21.25,0:05:25.05,Default,,0,0,0,,Бүгін Роло екеуміздің аман қалу кеші.
Dialogue: 0,0:05:25.17,0:05:28.43,Default,,0,0,0,,Иә, мен террорлық шабуылдан аман қалдым.
Dialogue: 0,0:05:28.55,0:05:31.35,Default,,0,0,0,,Ширли үшін қиын болды.
Dialogue: 0,0:05:31.47,0:05:33.81,Default,,0,0,0,,Егер Лулу өлсе (Ширли) Ааа аааа аа
Dialogue: 0,0:05:33.93,0:05:35.27,Default,,0,0,0,,Айтпақшы, Роло ше? (Ширли) Ааа аааа
Dialogue: 0,0:05:35.56,0:05:39.73,Default,,0,0,0,,Мен сені шақырдым, бірақ көрдің бе, менің ағама ұқсамай, аңғалмын.
Dialogue: 0,0:05:39.86,0:05:42.23,Default,,0,0,0,,Сондықтан сенің достарың жоқ емес пе?
Dialogue: 0,0:05:42.36,0:05:44.57,Default,,0,0,0,,Маған үндемеңіз
Dialogue: 0,0:05:44.69,0:05:47.66,Default,,0,0,0,,Қосылған, бірақ әртүрлі нәрселер бар.
Dialogue: 0,0:05:47.78,0:05:49.16,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:05:49.49,0:05:50.91,Default,,0,0,0,,Ей, қазір бәрі жабысып қалды.
Dialogue: 0,0:05:51.03,0:05:53.49,Default,,0,0,0,,Наннелли барлығының есінде жоқ.
Dialogue: 0,0:05:53.99,0:05:58.75,Default,,0,0,0,,Жоқ, менің сіңілім Нуналлидің орнына менің жалған інім келді.
Dialogue: 0,0:05:58.87,0:06:01.17,Default,,0,0,0,,Менің жадымды өзгертіп қана қойған жоқсың...
Dialogue: 0,0:06:01.29,0:06:03.55,Default,,0,0,0,,Тіпті бүкіл студенттік кеңес ойыншыққа айналады
Dialogue: 0,0:06:04.17,0:06:05.84,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:15.10,0:06:16.89,Default,,0,0,0,,Тіпті Вавилон мұнарасындағы оқиғадан кейін де...
Dialogue: 0,0:06:17.02,0:06:20.35,Default,,0,0,0,,Лелуш Ламперужде ерекше өзгерістер байқалған жоқ.
Dialogue: 0,0:06:21.44,0:06:24.23,Default,,0,0,0,,Мектептегі 180 жасырын камера
Dialogue: 0,0:06:24.36,0:06:27.03,Default,,0,0,0,,47 адам жалған бақылауда
Dialogue: 0,0:06:29.74,0:06:31.99,Default,,0,0,0,,Бақылау үшін 48 адам
Dialogue: 0,0:06:32.28,0:06:33.66,Default,,0,0,0,,Карфаген әскерлерінің жойылуы және...
Dialogue: 0,0:06:33.78,0:06:35.29,Default,,0,0,0,,Лелушты байланыстыратын ақпарат...
Dialogue: 0,0:06:35.41,0:06:36.79,Default,,0,0,0,,Қазіргі уақытта жоқ
Dialogue: 0,0:06:37.16,0:06:41.46,Default,,0,0,0,,Бақылау өте жақсы, Geass қолдану үшін бос орын жоқ.
Dialogue: 0,0:06:41.58,0:06:44.96,Default,,0,0,0,,Егер ол нөл болса, оның мектепке қайтып келуі біртүрлі болар еді.
Dialogue: 0,0:06:45.09,0:06:47.76,Default,,0,0,0,,Өйткені, С.С. қайда?
Dialogue: 0,0:06:47.88,0:06:50.88,Default,,0,0,0,,Егер сіз Лелушпен байланыспаған болсаңыз...
Dialogue: 0,0:06:51.01,0:06:53.39,Default,,0,0,0,,Консулдықта болу екіталай
Dialogue: 0,0:06:53.51,0:06:58.56,Default,,0,0,0,,Басқаша айтқанда, мен оқиғаға дейін болғандай, мен қайда екенімді білмеймін.
Dialogue: 0,0:07:00.85,0:07:05.02,Default,,0,0,0,,Біз, Құпия барлау қызметі, К.К. түсіру операциясы.
Dialogue: 0,0:07:05.57,0:07:08.40,Default,,0,0,0,,Барлығы, әдеттегідей жемді бақылауды жалғастырыңдар.
Dialogue: 0,0:07:08.53,0:07:10.36,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:07:10.90,0:07:14.32,Default,,0,0,0,,Қарсыластың өзегі - бұл бақылау деректері үшін тағайындалған орын
Dialogue: 0,0:07:14.45,0:07:15.74,Default,,0,0,0,,Немесе есім қате хабарланған болар.
Dialogue: 0,0:07:16.12,0:07:18.12,Default,,0,0,0,,Мәселе Нуннали.
Dialogue: 0,0:07:18.37,0:07:21.08,Default,,0,0,0,,Барлығының Нунелли туралы естеліктерін ұрлаған...
Dialogue: 0,0:07:21.21,0:07:23.58,Default,,0,0,0,,Өйткені мен Нанналлидің мектепке келмейтінін білемін.
Dialogue: 0,0:07:23.96,0:07:28.76,Default,,0,0,0,,Басқаша айтқанда, Британ императоры Нунеллиді басқару мүмкіндігі жоғары.
Dialogue: 0,0:07:29.09,0:07:32.51,Default,,0,0,0,,Өз балаларын да құрал ретінде пайдаланатын адам.
Dialogue: 0,0:07:33.09,0:07:37.01,Default,,0,0,0,,Егер олар менің жадымның нөлге оралғанын білсе...
Dialogue: 0,0:07:37.14,0:07:38.43,Default,,0,0,0,,Nunnally қауіп төніп тұр
Dialogue: 0,0:07:38.85,0:07:40.52,Default,,0,0,0,,Мен мүлде қозғала алмаймын
Dialogue: 0,0:07:40.89,0:07:44.10,Default,,0,0,0,,Мені аңдып тұрған адамдарды алдау.
Dialogue: 0,0:07:44.23,0:07:45.23,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:07:45.36,0:07:49.57,Default,,0,0,0,,Лелуш, ертеңгі сабақты да міндетті түрде қабылда.
Dialogue: 0,0:07:49.86,0:07:53.99,Default,,0,0,0,,Мен білемін, сен маған шынымен сенбейсің бе?
Dialogue: 0,0:07:54.74,0:07:58.70,Default,,0,0,0,,Виллетта Нуу Мен Геассты киетін әйел.
Dialogue: 0,0:08:03.92,0:08:07.50,Default,,0,0,0,,My Geass-ты бір адамға бір рет қана пайдалануға болады.
Dialogue: 0,0:08:07.88,0:08:11.80,Default,,0,0,0,,Басқаша айтқанда, Гисс енді бұл жігітте жұмыс істемейді.
Dialogue: 0,0:08:12.17,0:08:15.80,Default,,0,0,0,,Сонда іні болмау керек
Dialogue: 0,0:08:15.93,0:08:19.01,Default,,0,0,0,,Осы жігітті ақырын жеңуден бастайық.
Dialogue: 0,0:08:19.14,0:08:21.85,Default,,0,0,0,,Немістің сол қанаты шабуылға шықты.
Dialogue: 0,0:08:21.98,0:08:23.10,Default,,0,0,0,,Голландиялық инженерлер мина алаңын басып шығару
Dialogue: 0,0:08:23.23,0:08:26.73,Default,,0,0,0,,Оң қанат Италияның ұлттық армиясы үшін де жақсы тұр.
Dialogue: 0,0:08:26.86,0:08:30.28,Default,,0,0,0,,Бүгінгі түндегі Бордо жеңістің дәмді шарабы болатын сияқты.
Dialogue: 0,0:08:30.69,0:08:32.07,Default,,0,0,0,,Тікелей жоғарыдан Расталмаған 1
Dialogue: 0,0:08:32.19,0:08:32.82,Default,,0,0,0,,Не?
Dialogue: 0,0:08:36.78,0:08:37.66,Default,,0,0,0,,Ланселот
Dialogue: 0,0:08:37.78,0:08:39.79,Default,,0,0,0,,Британияның ақ өлім құдайы
Dialogue: 0,0:08:39.91,0:08:41.54,Default,,0,0,0,,Лаундес алдыңғы шепте?
Dialogue: 0,0:08:42.96,0:08:46.58,Default,,0,0,0,,Бағынуыңызды өтінемін. Жеңіс немесе жеңіліс шешіледі.
Dialogue: 0,0:08:47.08,0:08:49.50,Default,,0,0,0,,Қаруын қойған адамды атпаймын.
Dialogue: 0,0:08:49.63,0:08:50.80,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:08:50.92,0:08:53.22,Default,,0,0,0,,Оны түсіріңіз. Бір ғана жау бар.
Dialogue: 0,0:08:55.63,0:08:56.64,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:04.73,0:09:06.23,Default,,0,0,0,,Сіз әлі де жалғастыруды жоспарлап отырсыз ба?
Dialogue: 0,0:09:19.66,0:09:20.87,Default,,0,0,0,,"Бүгін түнде біз батырды құрметтейміз!!"
Dialogue: 0,0:09:20.99,0:09:22.83,Default,,0,0,0,,Жеке операциялар және т.б.
Dialogue: 0,0:09:22.95,0:09:25.00,Default,,0,0,0,,Куруруги бастапқыда Жоғары Мәртебеліге бағынышты болды.
Dialogue: 0,0:09:25.21,0:09:26.96,Default,,0,0,0,,Қазір Жеті түн
Dialogue: 0,0:09:27.08,0:09:28.88,Default,,0,0,0,,Мәртебелі императорға тікелей есеп береді.
Dialogue: 0,0:09:29.00,0:09:29.88,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:09:30.00,0:09:33.21,Default,,0,0,0,,Біз оның алға жылжуына қуануымыз керек.
Dialogue: 0,0:09:33.92,0:09:36.84,Default,,0,0,0,,Дүние әлі мұңға толы
Dialogue: 0,0:09:36.97,0:09:41.18,Default,,0,0,0,,Себебі оның бойында өзін-өзі тану және жол көрсетуші ретінде жауапкершілік бар.
Dialogue: 0,0:09:42.60,0:09:44.02,Default,,0,0,0,,Нина жоғалып кетті
Dialogue: 0,0:09:44.14,0:09:46.52,Default,,0,0,0,,Созаку Артурды алып кетті ме?
Dialogue: 0,0:09:46.64,0:09:47.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.85,0:09:51.44,Default,,0,0,0,,Не болды? Қандай альбом
Dialogue: 0,0:09:51.61,0:09:54.48,Default,,0,0,0,,Бұл студенттік кеңестің марафон би файлы емес пе?
Dialogue: 0,0:09:54.61,0:09:56.82,Default,,0,0,0,,Президенттің оқиғаларды жақсы көруі де мәселе.
Dialogue: 0,0:09:57.74,0:09:59.78,Default,,0,0,0,,Жарылған жүрек сайысы
Dialogue: 0,0:10:00.28,0:10:01.45,Default,,0,0,0,,Бұл мені жылатады
Dialogue: 0,0:10:01.58,0:10:04.91,Default,,0,0,0,,Төраға – жеңімпазға кубокты беретін адам.
Dialogue: 0,0:10:05.04,0:10:07.00,Default,,0,0,0,,Тс. Олардың қаншасы бар?
Dialogue: 0,0:10:07.12,0:10:08.42,Default,,0,0,0,,Сіз қашып кетуді жақсы орындадыңыз.
Dialogue: 0,0:10:08.54,0:10:09.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:10.46,0:10:12.13,Default,,0,0,0,,Жаңалықтарда айтқан жоқ па?
Dialogue: 0,0:10:12.46,0:10:15.51,Default,,0,0,0,,Бабыл мұнарасы толығымен әскерилермен қоршалған.
Dialogue: 0,0:10:15.63,0:10:18.22,Default,,0,0,0,,Қоршауды қалай бұздың?
Dialogue: 0,0:10:18.51,0:10:20.34,Default,,0,0,0,,Не айтып тұрсың, Лоло?
Dialogue: 0,0:10:20.47,0:10:21.51,Default,,0,0,0,,Олай десеңіз...
Dialogue: 0,0:10:21.64,0:10:24.06,Default,,0,0,0,,Сіз террористтерден қалай құтылдыңыз?
Dialogue: 0,0:10:24.18,0:10:24.93,Default,,0,0,0,,Ах
Dialogue: 0,0:10:25.77,0:10:27.48,Default,,0,0,0,,Төтенше жол бар.
Dialogue: 0,0:10:27.60,0:10:29.48,Default,,0,0,0,,Мен сізбен байланысуға тырыстым...
Dialogue: 0,0:10:29.60,0:10:31.73,Default,,0,0,0,,Бұл жағдайда маған ұялы телефон керек.
Dialogue: 0,0:10:31.98,0:10:32.81,Default,,0,0,0,,Иә
Dialogue: 0,0:10:34.11,0:10:36.24,Default,,0,0,0,,Иә, бұл ракета...
Dialogue: 0,0:10:36.49,0:10:38.61,Default,,0,0,0,,Мен оны саған туған күніңе сыйлық ретінде бердім.
Dialogue: 0,0:10:39.70,0:10:42.53,Default,,0,0,0,,Жоқ, жоқ, сол күні...
Dialogue: 0,0:10:42.66,0:10:46.25,Default,,0,0,0,,25 қазанда Нуналлидің туған күні
Dialogue: 0,0:10:48.66,0:10:50.08,Default,,0,0,0,,Бұл зымыранды көрсетіңіз
Dialogue: 0,0:10:50.21,0:10:50.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:51.08,0:10:54.04,Default,,0,0,0,,Ойланып қарасаң, адамға зымыран бар.
Dialogue: 0,0:10:54.34,0:10:55.21,Default,,0,0,0,,Тағы бір...
Dialogue: 0,0:10:55.46,0:10:57.67,Default,,0,0,0,,Жоқ, мен мұны түсіндім.
Dialogue: 0,0:10:58.88,0:11:01.18,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:11:01.30,0:11:04.51,Default,,0,0,0,,А-а, мен түсіндім, Роло.
Dialogue: 0,0:11:12.65,0:11:16.65,Default,,0,0,0,,Иә, Лелуштың бақылау мәртебесінде ешқандай өзгеріс жоқ.
Dialogue: 0,0:11:16.78,0:11:19.11,Default,,0,0,0,,Geass қолданбасын пайдалану туралы ешқандай дәлел жоқ.
Dialogue: 0,0:11:19.24,0:11:22.61,Default,,0,0,0,,Мен Геастың мәліметтерін білмеймін.
Dialogue: 0,0:11:22.95,0:11:25.45,Default,,0,0,0,,Әй, әлі сөйлесіп жатсаңыз, кездескенше.
Dialogue: 0,0:11:25.62,0:11:26.49,Default,,0,0,0,,Құт
Dialogue: 0,0:11:26.62,0:11:30.00,Default,,0,0,0,,Кел, Роло! Өйткені біз бір миссиядамыз.
Dialogue: 0,0:11:36.75,0:11:38.01,Default,,0,0,0,,Жоғарыдағы нұсқаулар...
Dialogue: 0,0:11:39.88,0:11:41.80,Default,,0,0,0,,сұралған болуы мүмкін
Dialogue: 0,0:11:41.93,0:11:44.43,Default,,0,0,0,,Сондай-ақ, Токио бөлімінде Геасс туралы оқуға болады.
Dialogue: 0,0:11:44.55,0:11:46.14,Default,,0,0,0,,Бұл бізге ғана құпия.
Dialogue: 0,0:11:46.26,0:11:49.81,Default,,0,0,0,,Бірақ бұл үшін қанша мүше қажет?
Dialogue: 0,0:11:50.23,0:11:53.23,Default,,0,0,0,,Бұл ең сенімді және жылдам әдіс болды.
Dialogue: 0,0:11:53.35,0:11:54.73,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:11:55.81,0:11:59.57,Default,,0,0,0,,Жапония Құрама Штаттарының құрылғанына үш күн өтті.
Dialogue: 0,0:12:00.03,0:12:01.07,Default,,0,0,0,,Британия мәңгілік...
Dialogue: 0,0:12:01.19,0:12:03.82,Default,,0,0,0,,Менің ойымша, олар қарсылықты жалғастыра бермейді.
Dialogue: 0,0:12:04.16,0:12:08.20,Default,,0,0,0,,Қытай Федерациясының материгіндегі бас консулды ауыстыру да бар.
Dialogue: 0,0:12:09.24,0:12:13.75,Default,,0,0,0,,Дегенмен, мен әлі Лелуштан қосымша нұсқаулар алған жоқпын.
Dialogue: 0,0:12:14.12,0:12:16.17,Default,,0,0,0,,Жер бетінде не бар?
Dialogue: 0,0:12:21.59,0:12:24.47,Default,,0,0,0,,Сіз нөлсіз, солай ма?
Dialogue: 0,0:12:24.59,0:12:27.72,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:12:27.97,0:12:30.31,Default,,0,0,0,,Британнан экстрадициялау келіссөздері...
Dialogue: 0,0:12:30.43,0:12:31.77,Default,,0,0,0,,Кешіктіру
Dialogue: 0,0:12:31.89,0:12:33.89,Default,,0,0,0,,Бұл шамамен бір аптаға созылады.
Dialogue: 0,0:12:34.10,0:12:35.77,Default,,0,0,0,,Нөлді айт
Dialogue: 0,0:12:35.90,0:12:37.48,Default,,0,0,0,,Оның үстіне Қытайдың федералды үкіметі... (есіктің ашылған дыбысы)
Dialogue: 0,0:12:37.61,0:12:38.61,Default,,0,0,0,,Ｃ.Ｃ.！
Dialogue: 0,0:12:38.73,0:12:40.53,Default,,0,0,0,,Енді ойлап қарасам, сен қоян болуың керек еді...
Dialogue: 0,0:12:40.65,0:12:42.32,Default,,0,0,0,,Әлі ерте емес пе еді?
Dialogue: 0,0:12:42.44,0:12:43.28,Default,,0,0,0,,Ах
Dialogue: 0,0:12:44.45,0:12:49.33,Default,,0,0,0,,Не? сурет? сурет? Уау Уау
Dialogue: 0,0:12:49.45,0:12:51.62,Default,,0,0,0,,Нөл әйел ме?
Dialogue: 0,0:12:51.75,0:12:52.58,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:52.83,0:12:53.87,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:12:54.00,0:12:57.58,Default,,0,0,0,,Босауға тым тез, Ойнамайтын әйел.
Dialogue: 0,0:12:57.71,0:12:58.92,Default,,0,0,0,,Нөлмен ойнамаңыз
Dialogue: 0,0:12:59.04,0:12:59.92,Default,,0,0,0,,Мен оны көремін.
Dialogue: 0,0:13:00.05,0:13:01.05,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:13:01.55,0:13:04.05,Default,,0,0,0,,Карен Акацуки танысқаныма қуаныштымын
Dialogue: 0,0:13:04.17,0:13:06.18,Default,,0,0,0,,Ол Гурен 2-нің ұшқышы, солай ма?
Dialogue: 0,0:13:06.30,0:13:07.89,Default,,0,0,0,,Не? неге
Dialogue: 0,0:13:08.39,0:13:10.47,Default,,0,0,0,,Балалар мен сендерге қызығамын.
Dialogue: 0,0:13:10.60,0:13:12.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:12.39,0:13:14.68,Default,,0,0,0,,Қатты, Оги-сан т.б.
Dialogue: 0,0:13:14.81,0:13:15.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:17.35,0:13:19.56,Default,,0,0,0,,Сен мені естисің бе, Нөл?
Dialogue: 0,0:13:20.36,0:13:23.28,Default,,0,0,0,,Мен Корнелия Лимін, Британ ханшайымы рыцарь.
Dialogue: 0,0:13:23.94,0:13:26.99,Default,,0,0,0,,Гилберт Г.П. Гилфорд
Dialogue: 0,0:13:27.36,0:13:32.79,Default,,0,0,0,,Ертең сағат 15.00-ден бастап мемлекетке опасыздық жасаған ерекше бірінші дәрежелі қылмыскерлер...
Dialogue: 0,0:13:33.08,0:13:33.91,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:13:34.04,0:13:37.25,Default,,0,0,0,,256 адам өлім жазасына кесілді
Dialogue: 0,0:13:40.38,0:13:43.80,Default,,0,0,0,,Нөл, егер қол астындағылардың өміріне өкінсеңіз...
Dialogue: 0,0:13:43.92,0:13:47.63,Default,,0,0,0,,Менімен әділ күрес.
Dialogue: 0,0:13:48.05,0:13:49.93,Default,,0,0,0,,Гилдфорд мұны жасайды.
Dialogue: 0,0:13:50.05,0:13:51.39,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:51.60,0:13:54.31,Default,,0,0,0,,Иә? Жалғыз Лулу
Dialogue: 0,0:13:54.60,0:13:57.23,Default,,0,0,0,,О, Ширли, жүзу үйірмесі ше?
Dialogue: 0,0:13:57.35,0:13:58.90,Default,,0,0,0,,Міне.
Dialogue: 0,0:13:59.02,0:14:02.15,Default,,0,0,0,,Мені туған күнге сыйлықтар сатып алуды тапсырды.
Dialogue: 0,0:14:02.27,0:14:03.61,Default,,0,0,0,,Туған күн?
Dialogue: 0,0:14:03.73,0:14:05.78,Default,,0,0,0,,Кеңесші Виллетта мырза
Dialogue: 0,0:14:05.90,0:14:09.61,Default,,0,0,0,,Үнемі айғайлайтын жалғыз адаммын, сондықтан бәрі жақсы дейді.
Dialogue: 0,0:14:09.74,0:14:12.53,Default,,0,0,0,,Бірақ мен сыйлық таңдауда шебер емеспін.
Dialogue: 0,0:14:13.08,0:14:15.66,Default,,0,0,0,,Менің ойымша, ол алкогольді жақсы көреді.
Dialogue: 0,0:14:15.79,0:14:17.41,Default,,0,0,0,,Бірақ бренд туралы не деуге болады?
Dialogue: 0,0:14:17.54,0:14:19.42,Default,,0,0,0,,Біз сыртқа шығамыз ба? (Шерли) Иә?
Dialogue: 0,0:14:19.71,0:14:21.71,Default,,0,0,0,,Сондықтан мен сыйлықты таңдаймын
Dialogue: 0,0:14:21.84,0:14:22.75,Default,,0,0,0,,Га
Dialogue: 0,0:14:23.46,0:14:25.96,Default,,0,0,0,,Жақсы ма? Шынымен бе?
Dialogue: 0,0:14:26.09,0:14:27.09,Default,,0,0,0,,Қазір барасың ба?
Dialogue: 0,0:14:27.22,0:14:28.55,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:14:28.68,0:14:31.85,Default,,0,0,0,,Материалды бергеніңіз үшін рахмет
Dialogue: 0,0:14:49.86,0:14:52.99,Default,,0,0,0,,Мен енді оны тоқтата алмаймын. Бұл сіздің Geass-қа жол бермейді.
Dialogue: 0,0:14:53.41,0:14:55.79,Default,,0,0,0,,Егер сізге оптикалық ақпаратты блоктау ғана қажет болса...
Dialogue: 0,0:14:55.91,0:14:57.33,Default,,0,0,0,,Тұрақты түсті контактілер туралы не деуге болады?
Dialogue: 0,0:14:57.66,0:14:59.66,Default,,0,0,0,,Сұхбаттасудан аулақ болыңыз
Dialogue: 0,0:14:59.79,0:15:02.42,Default,,0,0,0,,Сіз ойлағандай, бұл ерекше.
Dialogue: 0,0:15:02.54,0:15:06.00,Default,,0,0,0,,Бірақ егер сіздің Геассыңыз қазіргіден күштірек болса.
Dialogue: 0,0:15:06.46,0:15:08.76,Default,,0,0,0,,Мен оны сол уақытқа дейін бітіремін.
Dialogue: 0,0:15:09.05,0:15:10.51,Default,,0,0,0,,Осы ойынға
Dialogue: 0,0:15:12.59,0:15:13.51,Default,,0,0,0,,Сіз шығасыз ба?
Dialogue: 0,0:15:13.97,0:15:15.76,Default,,0,0,0,,Сыйлық таңдауға көмектесу
Dialogue: 0,0:15:15.89,0:15:17.68,Default,,0,0,0,,Бүгін Вилетта мырзаның туған күні.
Dialogue: 0,0:15:17.89,0:15:19.10,Default,,0,0,0,,Туған күн?
Dialogue: 0,0:15:19.73,0:15:23.73,Default,,0,0,0,,Иә, сіздің туған күніңіз маңызды.
Dialogue: 0,0:15:24.19,0:15:25.61,Default,,0,0,0,,Жарайды, мен барамын.
Dialogue: 0,0:15:25.73,0:15:26.69,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:15:30.45,0:15:32.07,Default,,0,0,0,,Ролло аа аа
Dialogue: 0,0:15:32.20,0:15:33.37,Default,,0,0,0,,Эхехе
Dialogue: 0,0:15:33.49,0:15:35.16,Default,,0,0,0,,Студенттік кеңес төрағасы?
Dialogue: 0,0:15:35.28,0:15:36.91,Default,,0,0,0,,Роло, сен де келуің керек, иә?
Dialogue: 0,0:15:37.16,0:15:38.58,Default,,0,0,0,,Қарым-қатынас
Dialogue: 0,0:15:39.37,0:15:41.92,Default,,0,0,0,,Иә, менде де тек білім бар.
Dialogue: 0,0:15:42.04,0:15:43.58,Default,,0,0,0,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:15:43.71,0:15:44.67,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:15:44.79,0:15:46.75,Default,,0,0,0,,Noble rot шарабы тым тәтті болуы мүмкін.
Dialogue: 0,0:15:47.13,0:15:48.17,Default,,0,0,0,,Сопронның айналасында?
Dialogue: 0,0:15:48.63,0:15:51.51,Default,,0,0,0,,Күні? Бұл кездесу ме?
Dialogue: 0,0:15:51.63,0:15:54.59,Default,,0,0,0,,Мүмкін кездесу.Жарайды, оны кездесуге айналдырайық.
Dialogue: 0,0:15:58.52,0:16:00.10,Default,,0,0,0,,Есептелгендей...
Dialogue: 0,0:16:00.48,0:16:02.56,Default,,0,0,0,,Мен оның Ролоны алып келеді деп ойламаппын...
Dialogue: 0,0:16:02.69,0:16:04.02,Default,,0,0,0,,Төрағаға ұқсайды.
Dialogue: 0,0:16:04.31,0:16:08.57,Default,,0,0,0,,Бұл Гендерлік алмасу экология қоғамы үшін жақсы таныстырылым материалы болатын сияқты.
Dialogue: 0,0:16:08.69,0:16:09.53,Default,,0,0,0,,...
Dialogue: 0,0:16:09.65,0:16:12.65,Default,,0,0,0,,Сол үшін мені өзіңе еруге шақырдың ба?
Dialogue: 0,0:16:12.78,0:16:14.28,Default,,0,0,0,,Тіпті Роло да қызықты, солай ма?
Dialogue: 0,0:16:14.61,0:16:16.16,Default,,0,0,0,,Мүмкін біз бір отбасы болып қалармыз
Dialogue: 0,0:16:16.28,0:16:17.03,Default,,0,0,0,,О
Dialogue: 0,0:16:18.08,0:16:19.08,Default,,0,0,0,,Екі қолым... сынғалы тұрғандай.
Dialogue: 0,0:16:25.63,0:16:28.17,Default,,0,0,0,,Нысана Зебра арқылы күтілетін маршрут арқылы өтеді
Dialogue: 0,0:16:28.30,0:16:32.22,Default,,0,0,0,,Жарайды, 7-топпен қол ауыстырыңыз. 2-топ С.С.-ның жанасуынан сақ болуы керек.
Dialogue: 0,0:16:32.34,0:16:35.72,Default,,0,0,0,,Иә, менің жолым. Мен аумақты тазалауға кірісемін.
Dialogue: 0,0:16:37.30,0:16:39.56,Default,,0,0,0,,Бұл шынымен нөл емес пе?
Dialogue: 0,0:16:40.35,0:16:42.98,Default,,0,0,0,,Мен әдейі Бабыл мұнарасына тұзақ қойдым.
Dialogue: 0,0:16:43.27,0:16:46.48,Default,,0,0,0,,Басқаша айтқанда, жау Концессияның Үкімет үйі емес.
Dialogue: 0,0:16:46.61,0:16:49.44,Default,,0,0,0,,Мен күткендей, монитордың кім екенін білмеймін...
Dialogue: 0,0:16:49.57,0:16:52.15,Default,,0,0,0,,Жүйенің өзінде олқылықтар бар
Dialogue: 0,0:16:52.49,0:16:56.49,Default,,0,0,0,,Нөл болса, ол ертеңгі бағыныштысының орындалуын назардан тыс қалдырмауы керек.
Dialogue: 0,0:16:56.62,0:16:58.83,Default,,0,0,0,,Есте қалған жоқ па?
Dialogue: 0,0:17:00.08,0:17:00.74,Default,,0,0,0,,Бұл
Dialogue: 0,0:17:01.24,0:17:03.16,Default,,0,0,0,,Мұнда қалай жазу керек? (Клерк) Иә?
Dialogue: 0,0:17:04.16,0:17:06.88,Default,,0,0,0,,Кешіріңіз, сізден бір жақсылық сұрасам болады ма?
Dialogue: 0,0:17:13.59,0:17:15.09,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,0:17:15.22,0:17:16.51,Default,,0,0,0,,Шындығында, қараңыз,
Dialogue: 0,0:17:26.73,0:17:27.35,Default,,0,0,0,,Ах
Dialogue: 0,0:17:31.32,0:17:32.28,Default,,0,0,0,,О
Dialogue: 0,0:17:32.82,0:17:34.24,Default,,0,0,0,,Күткеніңізге рахмет (Ширли) Уау.
Dialogue: 0,0:17:34.57,0:17:35.45,Default,,0,0,0,,Нені қарадыңыз?
Dialogue: 0,0:17:35.57,0:17:37.32,Default,,0,0,0,,Е, а, анау.
Dialogue: 0,0:17:39.28,0:17:42.54,Default,,0,0,0,,Мен бір рет аспалы жолға мінгім келеді.
Dialogue: 0,0:17:42.66,0:17:43.50,Default,,0,0,0,,Ахаха
Dialogue: 0,0:17:49.58,0:17:50.88,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:17:51.21,0:17:53.38,Default,,0,0,0,,Менің кесірімнен Ширли естеліктерін жоғалтты.
Dialogue: 0,0:17:53.76,0:17:57.09,Default,,0,0,0,,Төрағаның да, қарсыластың да естеліктері рұқсатсыз өзгертілді.
Dialogue: 0,0:17:57.84,0:18:00.14,Default,,0,0,0,,Бұл мәңгілік күйде қалуы мүмкін емес
Dialogue: 0,0:18:00.35,0:18:03.10,Default,,0,0,0,,Бәрі біткенде, мен сені міндетті түрде аламын
Dialogue: 0,0:18:03.22,0:18:03.89,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:04.02,0:18:07.06,Default,,0,0,0,,Ха, оны президенттер киіп жүр.
Dialogue: 0,0:18:07.19,0:18:08.65,Default,,0,0,0,,Өтірік пе?
Dialogue: 0,0:18:09.15,0:18:10.31,Default,,0,0,0,,Ширли (Ширли) Иә?
Dialogue: 0,0:18:11.19,0:18:12.69,Default,,0,0,0,,Менің жақсы ойым бар.
Dialogue: 0,0:18:12.82,0:18:13.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:14.73,0:18:16.53,Default,,0,0,0,,Тақырып дүкенге кіреді
Dialogue: 0,0:18:16.65,0:18:18.99,Default,,0,0,0,,Альфа он төрт Бұл шағын дүкен.
Dialogue: 0,0:18:19.28,0:18:21.53,Default,,0,0,0,,Дүкен ішінде табылу қаупі бар.
Dialogue: 0,0:18:21.66,0:18:24.74,Default,,0,0,0,,Дүкеннің алдында күтіңіз 3 адам артқа қарай айналады
Dialogue: 0,0:18:26.71,0:18:30.29,Default,,0,0,0,,Сіз осында қалып, мен біраз уақыт ішінде екенмін деп айта аласыз ба?
Dialogue: 0,0:18:30.88,0:18:31.84,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:18:32.46,0:18:35.38,Default,,0,0,0,,Дүкеннен жасырын шығып, президенттерді таң қалдырыңыз.
Dialogue: 0,0:18:35.67,0:18:37.42,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:18:43.10,0:18:45.39,Default,,0,0,0,,Мен әдетте пайдаланбайтын дүкендер
Dialogue: 0,0:18:45.52,0:18:48.14,Default,,0,0,0,,Бұл жерде бақылау камералары немесе тыңдау құрылғылары болмауы керек.
Dialogue: 0,0:18:48.35,0:18:51.27,Default,,0,0,0,,Ширли мұны ақылсыз еркелік деп санайды
Dialogue: 0,0:18:51.40,0:18:54.77,Default,,0,0,0,,Мен сәтсіздікке ұшырасам да, оны мазаламайды.
Dialogue: 0,0:18:54.90,0:18:57.53,Default,,0,0,0,,Геассты дайындағаннан кейін, тек қана істеу керек
Dialogue: 0,0:19:01.74,0:19:04.66,Default,,0,0,0,,Иә, Omotesando Mall қауіпсіздік кеңсесі.
Dialogue: 0,0:19:05.49,0:19:07.45,Default,,0,0,0,,Не? Қара рыцарьлар?
Dialogue: 0,0:19:07.75,0:19:10.04,Default,,0,0,0,,Келесі талаптарды орындамасаңыз:
Dialogue: 0,0:19:10.17,0:19:12.96,Default,,0,0,0,,Онда орнатылған бомбаны жарыңыз.
Dialogue: 0,0:19:13.08,0:19:14.92,Default,,0,0,0,,Жоқ, ол нөл болуы мүмкін емес.
Dialogue: 0,0:19:14.92,0:19:16.09,Default,,0,0,0,,Жоқ, ол нөл болуы мүмкін емес.
Dialogue: 0,0:19:14.92,0:19:16.09,Default,,0,0,0,,(ішкі хабар тарату қоңырауы)
Dialogue: 0,0:19:16.38,0:19:19.72,Default,,0,0,0,,Хакодате концессиясынан Максимилиан мырза.
Dialogue: 0,0:19:19.84,0:19:22.76,Default,,0,0,0,,Хакодате концессиясынан Максимилиан мырза.
Dialogue: 0,0:19:22.89,0:19:23.80,Default,,0,0,0,,Қоңырау келіп жатыр.
Dialogue: 0,0:19:22.89,0:19:23.80,Default,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:19:24.26,0:19:25.31,Default,,0,0,0,,Терроризм туралы ескерту?
Dialogue: 0,0:19:25.56,0:19:26.97,Default,,0,0,0,,Қара рыцарлар болуы керек.
Dialogue: 0,0:19:27.18,0:19:28.48,Default,,0,0,0,,Нөл қайтарылды
Dialogue: 0,0:19:28.60,0:19:31.27,Default,,0,0,0,,Қатты дауыс Тұтынушылар сізді байқайды
Dialogue: 0,0:19:31.39,0:19:32.35,Default,,0,0,0,,Өйткені
Dialogue: 0,0:19:39.03,0:19:41.78,Default,,0,0,0,,Омотесандо сауда орталығында қара рыцарлардан бомба қаупі бар.
Dialogue: 0,0:19:42.11,0:19:44.95,Default,,0,0,0,,Орналастыруды жылжытпаңыз. C.C. байланыс.
Dialogue: 0,0:19:51.21,0:19:52.54,Default,,0,0,0,,Шарт жойылды
Dialogue: 0,0:19:52.67,0:19:54.71,Default,,0,0,0,,Тек тұтану түймесі ғана қалды
Dialogue: 0,0:19:56.21,0:20:00.51,Default,,0,0,0,,10 ９ ８ ７―
Dialogue: 0,0:20:00.63,0:20:07.43,Default,,0,0,0,,６ ５ ４ ３ ２ １
Dialogue: 0,0:20:08.26,0:20:10.06,Default,,0,0,0,,(төтенше қоңырау)
Dialogue: 0,0:20:10.23,0:20:11.06,Default,,0,0,0,,Қара рыцарьлар?
Dialogue: 0,0:20:12.19,0:20:13.69,Default,,0,0,0,,Терроризм? (Әйел) Кяаа
Dialogue: 0,0:20:17.36,0:20:21.03,Default,,0,0,0,,О, бұл не? Мен оны қойдым
Dialogue: 0,0:20:21.74,0:20:23.66,Default,,0,0,0,,Не? Лоло
Dialogue: 0,0:20:23.78,0:20:24.82,Default,,0,0,0,,Мені тастама
Dialogue: 0,0:20:26.66,0:20:27.49,Default,,0,0,0,,Роло?
Dialogue: 0,0:20:28.20,0:20:29.70,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:20:30.66,0:20:32.25,Default,,0,0,0,,Жоғалған нысана
Dialogue: 0,0:20:32.37,0:20:34.17,Default,,0,0,0,,Скорпионның есебін не істеуім керек?
Dialogue: 0,0:20:34.29,0:20:34.96,Default,,0,0,0,,Роло туралы не деуге болады?
Dialogue: 0,0:20:35.08,0:20:37.59,Default,,0,0,0,,Қоғамдық тәртіпті сақтау үшін ұялы телефондарда апаттық кептеліс
Dialogue: 0,0:20:37.71,0:20:40.26,Default,,0,0,0,,Командир, Скорпионның баяндамасы бірінші орында.
Dialogue: 0,0:20:40.38,0:20:41.97,Default,,0,0,0,,Мен оқиға орнына барамын
Dialogue: 0,0:20:44.59,0:20:46.51,Default,,0,0,0,,Хахахахахахахаха
Dialogue: 0,0:20:46.64,0:20:49.81,Default,,0,0,0,,Дүрбелең осылай пайда болады.
Dialogue: 0,0:20:54.73,0:20:55.73,Default,,0,0,0,,Сенің ағаң қайда?
Dialogue: 0,0:20:55.85,0:20:56.48,Default,,0,0,0,,Ах
Dialogue: 0,0:20:59.11,0:21:01.36,Default,,0,0,0,,Ешкім жоқ па?
Dialogue: 0,0:21:03.44,0:21:05.74,Default,,0,0,0,,Мен С.С.-ны іздедім.
Dialogue: 0,0:21:05.86,0:21:08.37,Default,,0,0,0,,Сіз ояу болдыңыз ба?
Dialogue: 0,0:21:09.03,0:21:10.99,Default,,0,0,0,,Ізбасарды менің құлым ет.
Dialogue: 0,0:21:11.12,0:21:12.87,Default,,0,0,0,,Мен абсолютті бақылауға алындым.
Dialogue: 0,0:21:13.20,0:21:16.88,Default,,0,0,0,,Күтілгендей, сіздің басты басымдығыңыз C.C.
Dialogue: 0,0:21:17.00,0:21:18.63,Default,,0,0,0,,Ақпарат қате болса да
Dialogue: 0,0:21:18.96,0:21:20.30,Default,,0,0,0,,Ах-ах-ах
Dialogue: 0,0:21:22.13,0:21:27.55,Default,,0,0,0,,Бұл құс торындай мектеп бұдан былай менің еркіндік сарайыма айналады.
Dialogue: 0,0:21:27.68,0:21:28.97,Default,,0,0,0,,Ал сіз...
Dialogue: 0,0:21:29.35,0:21:32.18,Default,,0,0,0,,Nunnally іздеуде пешка болыңыз
Dialogue: 0,0:21:32.31,0:21:33.52,Default,,0,0,0,,Не?
Dialogue: 0,0:21:38.81,0:21:42.19,Default,,0,0,0,,Геасс? Уақытты тоқтаттыңыз ба?
Dialogue: 0,0:21:42.69,0:21:47.24,Default,,0,0,0,,Лелух, жынның көзімен өл.
Dialogue: 0,0:21:47.49,0:21:48.87,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:48.99,0:21:49.82,Default,,0,0,0,,Га
Dialogue: 0,0:21:51.12,0:21:52.08,Default,,0,0,0,,Бұл қиын нөл
Dialogue: 0,0:21:52.29,0:21:54.50,Default,,0,0,0,,Қытай Федерациясы кенеттен... (мүше) Гуаа!
Dialogue: 0,0:21:59.88,0:22:03.21,Default,,0,0,0,,Қара рыцарьлар осы жерде жойылады.
Dialogue: 0,0:22:03.42,0:22:08.13,Default,,0,0,0,,♪Мен оны бір күні кеудемнен таптым
Dialogue: 0,0:22:08.26,0:22:14.85,Default,,0,0,0,,♪Бақыт бөліктерін жинап алайық
Dialogue: 0,0:22:14.97,0:22:19.85,Default,,0,0,0,,♪Ұмытып қала жаздаған әуен
Dialogue: 0,0:22:19.98,0:22:26.94,Default,,0,0,0,,♪Ортада сөнбестен
Dialogue: 0,0:22:30.16,0:22:34.79,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:34.91,0:22:40.08,Default,,0,0,0,,♪Бүгін осында болғаным барлығына рахмет
Dialogue: 0,0:22:40.21,0:22:44.75,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:44.88,0:22:47.59,Default,,0,0,0,,♪Келесі мен бәріне айтамын
Dialogue: 0,0:22:47.72,0:22:51.05,Default,,0,0,0,,♪БАҚЫТТЫ Мен саған Уау беремін
Dialogue: 0,0:22:51.18,0:22:56.18,Default,,0,0,0,,♪Мен ештеңені ұмытпаймын
Dialogue: 0,0:22:56.31,0:23:02.77,Default,,0,0,0,,♪Себебі сол күні мен де өзіммін
Dialogue: 0,0:23:02.90,0:23:07.86,Default,,0,0,0,,♪Мен әрқашан сені сүйемін деп айтамын
Dialogue: 0,0:23:07.99,0:23:11.99,Default,,0,0,0,,♪Сіз маған айтуыңыз керек.
Dialogue: 0,0:23:12.12,0:23:16.37,Default,,0,0,0,,♪ Көз жасы ағып кете жаздады
Dialogue: 0,0:23:16.49,0:23:23.04,Default,,0,0,0,,♪Ұзақ түнде кенет артыма қарадым
Dialogue: 0,0:23:23.17,0:23:27.17,Default,,0,0,0,,♪Адамның ізімен жүру
Dialogue: 0,0:23:27.30,0:23:34.26,Default,,0,0,0,,♪Сол күнді ұмытпа
Dialogue: 0,0:23:37.68,0:23:38.85,Default,,0,0,0,,Қара рыцарьлардың өзегі...
Dialogue: 0,0:23:38.98,0:23:40.44,Default,,0,0,0,,Орындалатыны туралы
Dialogue: 0,0:23:40.64,0:23:42.48,Default,,0,0,0,,Мен оны не болса да құтқаруым керек...
Dialogue: 0,0:23:42.69,0:23:46.48,Default,,0,0,0,,Енді проблема - Роло. Жоқ, серпіліс болуы керек.
Dialogue: 0,0:23:46.98,0:23:49.40,Default,,0,0,0,,Естеліктері қайта жазылғандардың барлығына
Dialogue: 0,0:23:49.53,0:23:50.49,Default,,0,0,0,,Мен...
Dialogue: 0,0:23:51.99,0:23:57.99,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory