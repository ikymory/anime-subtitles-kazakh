Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.85,0:00:03.19,Default,,0,0,0,,Қытай Федерациясы
Dialogue: 0,0:00:03.31,0:00:06.52,Default,,0,0,0,,Әлемдегі халқы ең көп АҚШ
Dialogue: 0,0:00:06.65,0:00:09.90,Default,,0,0,0,,Әйтсе де, шындығында, ол қазірдің өзінде қарт адам деуге болады.
Dialogue: 0,0:00:10.65,0:00:13.15,Default,,0,0,0,,Аспан ұлы ұлттың белгісі ретінде
Dialogue: 0,0:00:13.28,0:00:18.08,Default,,0,0,0,,Сахна артында өз жағдайын бақылайтын үстем тап өте озбыр.
Dialogue: 0,0:00:18.20,0:00:22.91,Default,,0,0,0,,Халықты кедейлік пен тоқырау өмірлік күшінен айырды.
Dialogue: 0,0:00:23.29,0:00:26.38,Default,,0,0,0,,Жапониядан қашып келген қара рыцарьлар...
Dialogue: 0,0:00:26.50,0:00:28.50,Default,,0,0,0,,Осы Қытай Федерациясы
Dialogue: 0,0:00:28.88,0:00:33.88,Default,,0,0,0,,Сол кездегі құдіретті адам Ұлы Евнух жапондар үшін Цзянсу провинциясының жағалауында болды.
Dialogue: 0,0:00:34.01,0:00:37.26,Default,,0,0,0,,Сары теңізде жүзетін толқынды электр энергиясын өндіруге арналған жасанды арал
Dialogue: 0,0:00:37.39,0:00:39.35,Default,,0,0,0,,Жалға алынған Хорай аралы
Dialogue: 0,0:00:39.97,0:00:42.60,Default,,0,0,0,,Біз бұл туралы алдын ала сөйлескен болсақ та...
Dialogue: 0,0:00:42.73,0:00:46.02,Default,,0,0,0,,Бұл саяси тұрғыдан нені білдіреді?
Dialogue: 0,0:00:46.15,0:00:48.19,Default,,0,0,0,,Кейін көреміз.
Dialogue: 0,0:00:49.23,0:00:54.65,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:00:54.78,0:00:57.45,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:00:57.57,0:01:00.37,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:01:00.49,0:01:05.91,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:01:06.04,0:01:08.92,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:01:09.04,0:01:11.75,Default,,0,0,0,,♪Енді кеттік, мен аққан жұлдызмын
Dialogue: 0,0:01:17.55,0:01:23.02,Default,,0,0,0,,♪Дүние ыдыраса да, ешқашан өзгермейтін нәрселер бар.
Dialogue: 0,0:01:23.14,0:01:28.60,Default,,0,0,0,,♪Көз жасымызды тыйсақ та, қорғайтын нәрсе бар.
Dialogue: 0,0:01:28.73,0:01:31.48,Default,,0,0,0,,♪Он мыңдаған жылдар бұрынғы хабарлар дененің ішінде.
Dialogue: 0,0:01:31.61,0:01:34.03,Default,,0,0,0,,♪Сырылдап, ызылдай бастайды
Dialogue: 0,0:01:34.32,0:01:36.95,Default,,0,0,0,,♪Ертең қарлығаш дауыспен қоңырау шалыңыз
Dialogue: 0,0:01:37.11,0:01:40.07,Default,,0,0,0,,♪Мен сені тыртық қолыммен қорғаймын
Dialogue: 0,0:01:40.32,0:01:43.12,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:01:43.24,0:01:45.66,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:01:47.29,0:01:52.54,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:01:52.67,0:01:55.01,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:01:55.46,0:01:58.30,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:01:58.43,0:02:03.81,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:02:03.93,0:02:06.43,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:02:06.56,0:02:11.02,Default,,0,0,0,,♪Тағдырды кесіп өткен аққан жұлдыз
Dialogue: 0,0:02:11.15,0:02:15.48,Default,,0,0,0,,♪Тасып жатқан көз жасыңды мен қазір алып кетемін
Dialogue: 0,0:02:27.58,0:02:29.21,Default,,0,0,0,,) Сіз мұны жақсы мойындадыңыз.
Dialogue: 0,0:02:29.33,0:02:30.42,Default,,0,0,0,,Қытай Федерациясы
Dialogue: 0,0:02:30.54,0:02:33.59,Default,,0,0,0,,Савасаки оқиғасы да бар, олар жапоншыл емес пе?
Dialogue: 0,0:02:33.92,0:02:35.50,Default,,0,0,0,,Ұлы Евнух?
Dialogue: 0,0:02:36.55,0:02:38.30,Default,,0,0,0,,Асахина Сіз білесіз бе?
Dialogue: 0,0:02:38.42,0:02:41.51,Default,,0,0,0,,Евнух - адам, бірақ оған орын жоқ.
Dialogue: 0,0:02:41.68,0:02:44.60,Default,,0,0,0,,Тамаки, мұндай ақымақтық - бұл мәселе.
Dialogue: 0,0:02:44.76,0:02:46.01,Default,,0,0,0,,Өйткені
Dialogue: 0,0:02:46.14,0:02:48.43,Default,,0,0,0,,) Эй, маған Nightmare түсіруге көмектесші.
Dialogue: 0,0:02:48.77,0:02:50.02,Default,,0,0,0,,Ол әлі келді ме?
Dialogue: 0,0:02:50.60,0:02:54.31,Default,,0,0,0,,Үндістан соншалықты ынтымақтаса, перденің артында бір нәрсе бар сияқты.
Dialogue: 0,0:02:54.44,0:02:56.44,Default,,0,0,0,,Жоқ, ол сіз ойлағаннан да байсалды болуы мүмкін.
Dialogue: 0,0:02:57.11,0:02:59.57,Default,,0,0,0,,Олар Қытай Федерациясынан тәуелсіз болғысы келеді.
Dialogue: 0,0:02:59.70,0:03:02.11,Default,,0,0,0,,Ракшата да осылай деді.
Dialogue: 0,0:03:02.24,0:03:04.66,Default,,0,0,0,,Жапониядан тыс жер деп атауға болмайды.
Dialogue: 0,0:03:04.78,0:03:08.45,Default,,0,0,0,,Хехехе ахахха
Dialogue: 0,0:03:08.58,0:03:11.54,Default,,0,0,0,,Басшы лауазымға кандидаттарды іріктеу процесі аяқталды.
Dialogue: 0,0:03:11.67,0:03:13.13,Default,,0,0,0,,Әзірше Икаругада?
Dialogue: 0,0:03:13.25,0:03:16.04,Default,,0,0,0,,Дұрыс, қалғандары ішкі істерге жауапты адам.
Dialogue: 0,0:03:16.21,0:03:17.67,Default,,0,0,0,,Мен бұл туралы білемін.
Dialogue: 0,0:03:17.80,0:03:22.13,Default,,0,0,0,,Оны ақпаратты басқару бөлімімен бірге құрастырайық.
Dialogue: 0,0:03:25.76,0:03:28.10,Default,,0,0,0,,Диетардқа сенуге бола ма?
Dialogue: 0,0:03:28.22,0:03:30.43,Default,,0,0,0,,Сакиоко сияқты,
Dialogue: 0,0:03:30.56,0:03:31.94,Default,,0,0,0,,Керісінше оқу оңай болды.
Dialogue: 0,0:03:32.06,0:03:32.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:34.56,0:03:36.57,Default,,0,0,0,,Бұл адамның нөл таңбасы бар...
Dialogue: 0,0:03:36.69,0:03:38.07,Default,,0,0,0,,Құдайды жасауға тырысу
Dialogue: 0,0:03:38.90,0:03:42.36,Default,,0,0,0,,Осыдан іс-әрекеттерді шығаруға болады және...
Dialogue: 0,0:03:42.49,0:03:45.45,Default,,0,0,0,,Ақпараттық манипуляцияға келгенде сирек кездесетін талант.
Dialogue: 0,0:03:45.78,0:03:48.12,Default,,0,0,0,,Иә, мен үлкен өтірік айттым.
Dialogue: 0,0:03:48.24,0:03:50.16,Default,,0,0,0,,Әлде жауынгерлік ұшақ тасығыш па?
Dialogue: 0,0:03:50.45,0:03:53.37,Default,,0,0,0,,Гавайн жүйесі Икаругаға ауыстырылды.
Dialogue: 0,0:03:53.67,0:03:55.79,Default,,0,0,0,,Мен оны сағымға да қолдандым.
Dialogue: 0,0:03:56.34,0:03:58.75,Default,,0,0,0,,Өйткені, негізгі корпус теңізден шығарылғанда...
Dialogue: 0,0:03:58.88,0:04:00.46,Default,,0,0,0,,Өйткені ол тоз-тоз болып қалды
Dialogue: 0,0:04:00.67,0:04:02.72,Default,,0,0,0,,Онымен бірге қандай ұшақ құлады?
Dialogue: 0,0:04:02.84,0:04:04.97,Default,,0,0,0,,Түнгі Гига қамалы сияқты ма?
Dialogue: 0,0:04:05.39,0:04:07.60,Default,,0,0,0,,Мен де іздедім.
Dialogue: 0,0:04:09.26,0:04:12.10,Default,,0,0,0,,Сіз Қытай Федерациясының астанасын алуды шындап жоспарлап отырсыз ба?
Dialogue: 0,0:04:12.23,0:04:14.60,Default,,0,0,0,,Сізді агрессорға айналдырмайтындай.
Dialogue: 0,0:04:14.73,0:04:16.06,Default,,0,0,0,,Лоян құлағанша...
Dialogue: 0,0:04:16.19,0:04:18.77,Default,,0,0,0,,Британияны жеңу шарттары дерлік жойылды.
Dialogue: 0,0:04:21.24,0:04:22.78,Default,,0,0,0,,Қазір бәрі жақсы сияқты.
Dialogue: 0,0:04:23.36,0:04:25.78,Default,,0,0,0,,Сол кезде мен не болар екен деп ойладым.
Dialogue: 0,0:04:26.41,0:04:27.24,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:27.37,0:04:28.53,Default,,0,0,0,,Не? Уау
Dialogue: 0,0:04:28.66,0:04:29.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:29.41,0:04:31.08,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:04:37.67,0:04:39.21,Default,,0,0,0,,Лелушка айтып берші
Dialogue: 0,0:04:39.34,0:04:41.17,Default,,0,0,0,,Неге қайтып келдің?
Dialogue: 0,0:04:41.88,0:04:44.55,Default,,0,0,0,,Карен Бәрі біткен кезде...
Dialogue: 0,0:04:44.68,0:04:46.64,Default,,0,0,0,,Менімен бірге Эшфорд академиясына қайта барғыңыз келе ме?
Dialogue: 0,0:04:46.76,0:04:47.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:47.72,0:04:48.60,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:48.72,0:04:49.43,Default,,0,0,0,,) Табаско
Dialogue: 0,0:04:49.56,0:04:51.01,Default,,0,0,0,,Не?
Dialogue: 0,0:04:51.14,0:04:52.47,Default,,0,0,0,,Әй, қашаннан бері?
Dialogue: 0,0:04:52.60,0:04:54.02,Default,,0,0,0,,Бұл көбірек Табаско.
Dialogue: 0,0:04:54.14,0:04:56.44,Default,,0,0,0,,Мұнда тек чили майы бар, не істеуім керек?
Dialogue: 0,0:04:57.77,0:04:58.65,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:04:58.77,0:04:59.90,Default,,0,0,0,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:04:59.90,0:05:00.19,Default,,0,0,0,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:04:59.90,0:05:00.19,Default,,0,0,0,,(Кеме ішіндегі қоңырау)
Dialogue: 0,0:05:00.19,0:05:00.90,Default,,0,0,0,,(Кеме ішіндегі қоңырау)
Dialogue: 0,0:05:00.90,0:05:01.32,Default,,0,0,0,,(Кеме ішіндегі қоңырау)
Dialogue: 0,0:05:00.90,0:05:01.32,Default,,0,0,0,,) Нөл мырза, өтінемін, Икаругаға келіңіз. Қорқынышты нәрсе болады.
Dialogue: 0,0:05:01.32,0:05:04.19,Default,,0,0,0,,) Нөл мырза, өтінемін, Икаругаға келіңіз. Қорқынышты нәрсе болады.
Dialogue: 0,0:05:04.36,0:05:05.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:08.74,0:05:10.78,Default,,0,0,0,,Не? Саяси неке?
Dialogue: 0,0:05:11.03,0:05:13.62,Default,,0,0,0,,Иә, императорлық концерн арқылы...
Dialogue: 0,0:05:13.75,0:05:16.21,Default,,0,0,0,,Мен салтанатты шараға шақыру алдым...
Dialogue: 0,0:05:16.33,0:05:19.50,Default,,0,0,0,,Қалыңдық – Қытай Федерациясының символы, Аспан Ұлы.
Dialogue: 0,0:05:19.63,0:05:21.42,Default,,0,0,0,,Сіз мені дос ретінде шақырғыңыз келеді.
Dialogue: 0,0:05:21.55,0:05:24.51,Default,,0,0,0,,Ал күйеу жігіт Британияның бірінші ханзадасы.
Dialogue: 0,0:05:24.63,0:05:26.26,Default,,0,0,0,,Біреу Одиссей деп атады
Dialogue: 0,0:05:26.63,0:05:31.10,Default,,0,0,0,,Мен дайындаған жоспар уақытында дайын болмас еді.
Dialogue: 0,0:05:31.22,0:05:33.06,Default,,0,0,0,,Жоқ, бұл Британияның айласы шығар.
Dialogue: 0,0:05:33.39,0:05:34.93,Default,,0,0,0,,Олай болса, біз
Dialogue: 0,0:05:35.10,0:05:37.23,Default,,0,0,0,,Ең нашар жағдай.
Dialogue: 0,0:05:37.35,0:05:39.48,Default,,0,0,0,,Кут, мені соған дейін...
Dialogue: 0,0:05:39.61,0:05:41.44,Default,,0,0,0,,Мен көктің ұлын ұстауды жоспарладым.
Dialogue: 0,0:05:41.86,0:05:45.57,Default,,0,0,0,,Мен мұндай қарапайым адам мұншалықты тез келеді деп күтпедім.
Dialogue: 0,0:05:45.78,0:05:47.45,Default,,0,0,0,,Сізді не уайымдады?
Dialogue: 0,0:05:47.57,0:05:49.66,Default,,0,0,0,,Біздің Британияға қатысымыз жоқ, солай ма?
Dialogue: 0,0:05:49.78,0:05:50.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:50.74,0:05:52.78,Default,,0,0,0,,Себебі мені депортациялады.
Dialogue: 0,0:05:52.91,0:05:56.41,Default,,0,0,0,,Бұл күнә кешірілмеді.
Dialogue: 0,0:05:56.54,0:05:58.58,Default,,0,0,0,,Және бұл ыңғайлы неке.
Dialogue: 0,0:05:58.71,0:06:02.09,Default,,0,0,0,,Қытай Федерациясы бізге шабуыл жасауы мүмкін.
Dialogue: 0,0:06:02.21,0:06:03.38,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:06:03.50,0:06:06.17,Default,,0,0,0,,Қара рыцарьлар некелік сыйлықты алмастыра ма?
Dialogue: 0,0:06:06.47,0:06:08.22,Default,,0,0,0,,О, бұл жақсы сөз.
Dialogue: 0,0:06:08.34,0:06:10.76,Default,,0,0,0,,Қолдануға болмайтын таланттарға толы.
Dialogue: 0,0:06:10.89,0:06:14.10,Default,,0,0,0,,Қауіпсіз жүрсең, үлкен шымшусың.
Dialogue: 0,0:06:14.22,0:06:15.27,Default,,0,0,0,,бірақ манга суретшісінің үйіне алты минут ерте бару—
Dialogue: 0,0:06:15.39,0:06:17.81,Default,,0,0,0,,Менің қазір айтып отырғаным осы.
Dialogue: 0,0:06:18.27,0:06:20.15,Default,,0,0,0,,Нөл Мұның артында
Dialogue: 0,0:06:20.27,0:06:22.02,Default,,0,0,0,,А, тағы біреуі бар.
Dialogue: 0,0:06:22.48,0:06:25.94,Default,,0,0,0,,Қытай Федерациясымен бір кездегі қиын қарым-қатынас бірден...
Dialogue: 0,0:06:26.07,0:06:28.70,Default,,0,0,0,,Сондай шайтандық әрекет жасаған
Dialogue: 0,0:06:37.45,0:06:40.54,Default,,0,0,0,,) Аспан Ұлын Британияға сату
Dialogue: 0,0:06:55.14,0:06:56.47,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:06:56.68,0:06:59.39,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:06:59.69,0:07:02.52,Default,,0,0,0,,Император риза болды ма?
Dialogue: 0,0:07:02.65,0:07:05.57,Default,,0,0,0,,Қарсы жақ осылай деп отырғандықтан, сенуден басқа амалым жоқ.
Dialogue: 0,0:07:05.69,0:07:08.24,Default,,0,0,0,,Бұл бейбітшілікке апаратын бір жол.
Dialogue: 0,0:07:08.36,0:07:09.32,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:07:09.44,0:07:11.86,Default,,0,0,0,,Шақырылған қонақ ретінде осы жерді тамашалайық.
Dialogue: 0,0:07:11.99,0:07:15.37,Default,,0,0,0,,Созаку Бұл болды, солай ма?
Dialogue: 0,0:07:15.49,0:07:17.54,Default,,0,0,0,,Сіз айтып отырған қара түсті тритон.
Dialogue: 0,0:07:17.66,0:07:18.87,Default,,0,0,0,,Сіз оны қалай жейсіз?
Dialogue: 0,0:07:19.04,0:07:20.96,Default,,0,0,0,,Бұл тағамды безендіру.
Dialogue: 0,0:07:21.46,0:07:22.54,Default,,0,0,0,,Декорация?
Dialogue: 0,0:07:22.67,0:07:25.59,Default,,0,0,0,,Бірақ сіз бұрын ұқсас құсты жедіңіз, солай ма?
Dialogue: 0,0:07:25.71,0:07:27.13,Default,,0,0,0,,Құстар көңілді ме?
Dialogue: 0,0:07:27.46,0:07:30.34,Default,,0,0,0,,Мен оны ет деп ойладым, бірақ сәбіз болып шықты.
Dialogue: 0,0:07:30.34,0:07:32.09,Default,,0,0,0,,Мен оны ет деп ойладым, бірақ сәбіз болып шықты.
Dialogue: 0,0:07:30.34,0:07:32.09,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:07:33.22,0:07:35.76,Default,,0,0,0,,Бұл картоп па? Оны жеген дұрыс па?
Dialogue: 0,0:07:35.89,0:07:37.14,Default,,0,0,0,,Лорд Ахлстрем
Dialogue: 0,0:07:37.26,0:07:39.35,Default,,0,0,0,,Қонақ үй ішінде электрондық поштаны терсеңіз де,
Dialogue: 0,0:07:39.56,0:07:41.27,Default,,0,0,0,,Жоқ, бұл естелік.
Dialogue: 0,0:07:41.39,0:07:42.94,Default,,0,0,0,,Әй, бұл күнделік пе?
Dialogue: 0,0:07:43.23,0:07:45.48,Default,,0,0,0,,Сонда бұл рекорд.
Dialogue: 0,0:07:45.69,0:07:46.57,Default,,0,0,0,,Бұл
Dialogue: 0,0:07:46.69,0:07:49.48,Default,,0,0,0,,Мен әлі де Мистер Ллойдтың күйеубаласымын ба?
Dialogue: 0,0:07:49.65,0:07:52.11,Default,,0,0,0,,Иә? Сіз оны шешкен жоқсыз, солай ма?
Dialogue: 0,0:07:52.24,0:07:53.99,Default,,0,0,0,,Бұл сирек емес.
Dialogue: 0,0:07:54.11,0:07:57.41,Default,,0,0,0,,Мен ертеңгі салтанатқа ғана қатысамын, мерекеге келмеймін деп ойладым.
Dialogue: 0,0:07:57.83,0:08:00.41,Default,,0,0,0,,Анда-санда күйеу жігітке тән бірдеңе істеймін.
Dialogue: 0,0:08:00.54,0:08:02.66,Default,,0,0,0,,Себебі Созаку-кун маған ашуланды
Dialogue: 0,0:08:02.79,0:08:04.71,Default,,0,0,0,,осыны қамтиды
Dialogue: 0,0:08:04.83,0:08:07.21,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Миллей Эшфордпын.
Dialogue: 0,0:08:07.84,0:08:08.88,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:08:09.00,0:08:11.97,Default,,0,0,0,,Мен Ллойдтың адамдарға қызығатынына таң қалдым.
Dialogue: 0,0:08:12.09,0:08:14.34,Default,,0,0,0,,Жоқ, бұл өсу кезеңі.
Dialogue: 0,0:08:14.47,0:08:16.60,Default,,0,0,0,,Бұл граф Канон Малдини.
Dialogue: 0,0:08:16.72,0:08:18.35,Default,,0,0,0,,Ханзада Шнайзелдің қасындағылар
Dialogue: 0,0:08:18.68,0:08:19.93,Default,,0,0,0,,Қоғамдық және жеке.
Dialogue: 0,0:08:20.06,0:08:22.27,Default,,0,0,0,,Е-а-а
Dialogue: 0,0:08:22.39,0:08:23.69,Default,,0,0,0,,Жай әзіл.
Dialogue: 0,0:08:24.48,0:08:27.11,Default,,0,0,0,,Мәртебелі Шнайзел эксцентрик адамдарды жақсы көреді.
Dialogue: 0,0:08:27.23,0:08:28.65,Default,,0,0,0,,Соның ішінде мен.
Dialogue: 0,0:08:28.77,0:08:31.03,Default,,0,0,0,,Қасиетті Британ империясының канцлері
Dialogue: 0,0:08:31.28,0:08:34.20,Default,,0,0,0,,Екінші князь Шнайзелдің келуі
Dialogue: 0,0:08:35.82,0:08:37.57,Default,,0,0,0,,Шынымен де Нина?
Dialogue: 0,0:08:40.74,0:08:45.00,Default,,0,0,0,,Ағам нақты бір әйелді таппады.
Dialogue: 0,0:08:45.12,0:08:45.92,Default,,0,0,0,,Ах ха
Dialogue: 0,0:08:46.17,0:08:47.33,Default,,0,0,0,,Кім? Әлгі бала?
Dialogue: 0,0:08:47.46,0:08:49.17,Default,,0,0,0,,Бұл Invogue басшысы емес пе?
Dialogue: 0,0:08:49.29,0:08:51.55,Default,,0,0,0,,Ах, Жоғары мәртебелі зерттеу тобы.
Dialogue: 0,0:08:51.67,0:08:53.22,Default,,0,0,0,,Өте жас
Dialogue: 0,0:08:53.34,0:08:54.67,Default,,0,0,0,,Мен не істеп жатқанымды да білмеймін
Dialogue: 0,0:08:54.80,0:08:56.34,Default,,0,0,0,,Мықты
Dialogue: 0,0:08:56.47,0:08:58.43,Default,,0,0,0,,Юффи әрқашан құрметті болды.
Dialogue: 0,0:08:58.64,0:09:00.60,Default,,0,0,0,,Иә
Dialogue: 0,0:09:00.81,0:09:02.18,Default,,0,0,0,,Бұл не өзі…?>
Dialogue: 0,0:09:02.31,0:09:03.93,Default,,0,0,0,,Мәртебелі императордан: Бұл елде...
Dialogue: 0,0:09:04.06,0:09:06.35,Default,,0,0,0,,Жоғары мәртебелі Шнайзелдің қолбасшылығына тағайындалсын.
Dialogue: 0,0:09:06.77,0:09:10.65,Default,,0,0,0,,Үш раунд сенімді, солай ма?
Dialogue: 0,0:09:10.94,0:09:12.86,Default,,0,0,0,,А, бірдеңе ме?
Dialogue: 0,0:09:12.98,0:09:14.57,Default,,0,0,0,,Бұл мерекелік орын.
Dialogue: 0,0:09:14.69,0:09:16.57,Default,,0,0,0,,Жеңілдету үшін маған қажет.
Dialogue: 0,0:09:16.78,0:09:17.99,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:18.12,0:09:20.74,Default,,0,0,0,,Созаку Мектепте барлығы қалай?
Dialogue: 0,0:09:20.87,0:09:22.29,Default,,0,0,0,,Қараңдаршы
Dialogue: 0,0:09:22.66,0:09:23.54,Default,,0,0,0,,Иә
Dialogue: 0,0:09:25.29,0:09:26.21,Default,,0,0,0,,Мираи-чан
Dialogue: 0,0:09:27.46,0:09:29.42,Default,,0,0,0,,) Ұлы Евнух пен Шнейзелдің арасында...
Dialogue: 0,0:09:29.54,0:09:32.25,Default,,0,0,0,,Құпия келісім жасалып қойған
Dialogue: 0,0:09:32.38,0:09:34.55,Default,,0,0,0,,Неке және аумақты беру
Dialogue: 0,0:09:34.67,0:09:35.92,Default,,0,0,0,,Осылайша Ұлы Евнух —
Dialogue: 0,0:09:36.05,0:09:37.88,Default,,0,0,0,,Британия атағын алған кезде
Dialogue: 0,0:09:38.01,0:09:41.10,Default,,0,0,0,,Асылдық? Мәртебесіне айырбас ретінде еліңді сатар ма едің?
Dialogue: 0,0:09:41.43,0:09:42.47,Default,,0,0,0,,Халық не болады?
Dialogue: 0,0:09:42.60,0:09:43.89,Default,,0,0,0,,Ұлы Евнухты жеңу керек
Dialogue: 0,0:09:44.02,0:09:46.23,Default,,0,0,0,,Дұрыс, жоспарды алға жылжытсам да...
Dialogue: 0,0:09:46.35,0:09:47.60,Default,,0,0,0,,Некенің бұзылуы
Dialogue: 0,0:09:47.73,0:09:49.48,Default,,0,0,0,,Бірақ егер біз осы жерде төңкеріс жасасақ...
Dialogue: 0,0:09:49.60,0:09:50.90,Default,,0,0,0,,Британиямен соғысу
Dialogue: 0,0:09:51.27,0:09:53.65,Default,,0,0,0,,Татуласу керек пе, әлде
Dialogue: 0,0:09:57.28,0:09:58.57,Default,,0,0,0,,) Дегенмен, Аспан Ұлы
Dialogue: 0,0:09:58.95,0:10:01.49,Default,,0,0,0,,Бұл адам тұтқынға қажетсіз мейірімділік көрсетті.
Dialogue: 0,0:10:02.16,0:10:06.45,Default,,0,0,0,,Бірақ мен суық тигенде дәрі ішемін.
Dialogue: 0,0:10:06.58,0:10:08.79,Default,,0,0,0,,Жоқ, «Көк ұлы және тұтқын».
Dialogue: 0,0:10:08.92,0:10:11.08,Default,,0,0,0,,Жақында кеш басталады.
Dialogue: 0,0:10:11.21,0:10:12.84,Default,,0,0,0,,Бұл Көк Ұлының айтқанындай.
Dialogue: 0,0:10:12.96,0:10:15.76,Default,,0,0,0,,Бірақ заң бойынша бұл адам өлім жазасына кесіледі.
Dialogue: 0,0:10:17.09,0:10:17.92,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:10:18.09,0:10:18.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:19.09,0:10:22.51,Default,,0,0,0,,Бұл біртүрлі. Ол кісі жақсылық жасады.
Dialogue: 0,0:10:22.64,0:10:25.02,Default,,0,0,0,,О, жоқ
Dialogue: 0,0:10:26.81,0:10:28.35,Default,,0,0,0,,Әскери академия?
Dialogue: 0,0:10:28.48,0:10:31.48,Default,,0,0,0,,Иә, бұл маған Көктегі Ұлының берген өмірі.
Dialogue: 0,0:10:31.61,0:10:33.69,Default,,0,0,0,,Сізді кішкене болса да қорғау үшін
Dialogue: 0,0:10:33.82,0:10:36.69,Default,,0,0,0,,Менің де сыртқа шыққым келеді.
Dialogue: 0,0:10:36.82,0:10:37.44,Default,,0,0,0,,Сыртта?
Dialogue: 0,0:10:37.99,0:10:41.74,Default,,0,0,0,,Шукин қаласының сыртында теңіз, мектеп, т.б.
Dialogue: 0,0:10:41.87,0:10:45.66,Default,,0,0,0,,Ыстық тамақ, дос сияқты нәрселер бар.
Dialogue: 0,0:10:45.79,0:10:46.62,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:46.79,0:10:47.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:48.33,0:10:51.88,Default,,0,0,0,,Бір күні мен императорды сыртқа шығарамын.
Dialogue: 0,0:10:52.00,0:10:53.21,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:10:53.63,0:10:56.21,Default,,0,0,0,,Сақтаған өміріңіз үшін
Dialogue: 0,0:10:56.46,0:10:57.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:57.67,0:11:00.68,Default,,0,0,0,,Біз сыртта осылай уәде береміз.
Dialogue: 0,0:11:00.97,0:11:01.89,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:11:03.97,0:11:05.14,Default,,0,0,0,,Иә
Dialogue: 0,0:11:08.81,0:11:10.23,Default,,0,0,0,,тұрақты үйлесімділік
Dialogue: 0,0:11:10.77,0:11:12.15,Default,,0,0,0,,Келісім
Dialogue: 0,0:11:12.98,0:11:17.23,Default,,0,0,0,,Аспан Ұлын қорғауымыз керек пе? Бейбітшілік үшін одақ?
Dialogue: 0,0:11:17.94,0:11:20.07,Default,,0,0,0,,Жоқ, бұл өте жақсы болды.
Dialogue: 0,0:11:20.20,0:11:22.41,Default,,0,0,0,,Мен ұрысқа жақсы емеспін.
Dialogue: 0,0:11:22.74,0:11:25.87,Default,,0,0,0,,) Ұлы мәртебелі, Мәртебелі император тойға қатысады.
Dialogue: 0,0:11:25.99,0:11:28.83,Default,,0,0,0,,Ол өз еліндегі банкетке келетінін айтты.
Dialogue: 0,0:11:29.00,0:11:31.00,Default,,0,0,0,,Коконцерн өкілі
Dialogue: 0,0:11:31.12,0:11:31.83,Default,,0,0,0,,Га
Dialogue: 0,0:11:31.96,0:11:34.17,Default,,0,0,0,,Император Кагура-саманың келуі
Dialogue: 0,0:11:34.63,0:11:36.54,Default,,0,0,0,,Кагуя? не?
Dialogue: 0,0:11:36.67,0:11:39.76,Default,,0,0,0,,Шешуші соққы беру — әрқашан «Зе Ворлд»-тің шынайы күші.
Dialogue: 0,0:11:40.01,0:11:41.80,Default,,0,0,0,,Нөл мақтанышпен
Dialogue: 0,0:11:41.93,0:11:43.93,Default,,0,0,0,,Crimson ұшқыштары да бар, солай ма?
Dialogue: 0,0:11:44.22,0:11:46.39,Default,,0,0,0,,Сені осындай жерге кім шақырды?
Dialogue: 0,0:11:46.51,0:11:47.97,Default,,0,0,0,,Ол террорист.
Dialogue: 0,0:11:48.10,0:11:49.89,Default,,0,0,0,,Мынау
Dialogue: 0,0:11:50.39,0:11:54.19,Default,,0,0,0,,Шнайзель Сіз бастырмалағышсыз ба?
Dialogue: 0,0:12:00.74,0:12:02.61,Default,,0,0,0,,Аз ғана бірлік қалды, солай ма?
Dialogue: 0,0:12:02.74,0:12:04.95,Default,,0,0,0,,Иә, онда.
Dialogue: 0,0:12:05.41,0:12:06.45,Default,,0,0,0,,Бірақ бұл жақсы болды.
Dialogue: 0,0:12:06.57,0:12:10.04,Default,,0,0,0,,Нина да қолынан келгеннің бәрін істеп жатқан сияқты, бұл мені жеңілдетеді.
Dialogue: 0,0:12:10.16,0:12:10.83,Default,,0,0,0,,Жан тыныштығы?
Dialogue: 0,0:12:10.95,0:12:14.46,Default,,0,0,0,,Иә, егер қиналсаң, мен сенімен сөйлесемін.
Dialogue: 0,0:12:14.58,0:12:16.00,Default,,0,0,0,,Тоқта, иә?
Dialogue: 0,0:12:16.21,0:12:18.80,Default,,0,0,0,,Мен Мирэй-чанды жақсы көремін.
Dialogue: 0,0:12:18.92,0:12:21.97,Default,,0,0,0,,Бірақ маған үстірт әйелдер ұнамайды.
Dialogue: 0,0:12:23.26,0:12:25.18,Default,,0,0,0,,Евфемия ханым қашып кетпеді.
Dialogue: 0,0:12:26.22,0:12:28.68,Default,,0,0,0,,Мені құтқару үшін өміріңді қатерге тіктің.
Dialogue: 0,0:12:29.68,0:12:32.43,Default,,0,0,0,,Евфемия-сама ғана мені құтқарды.
Dialogue: 0,0:12:32.60,0:12:33.60,Default,,0,0,0,,Мен де
Dialogue: 0,0:12:34.98,0:12:36.98,Default,,0,0,0,,Егер бұл жай ғана ауызша жанашырлық болса, оны тоқтатыңыз.
Dialogue: 0,0:12:37.11,0:12:38.77,Default,,0,0,0,,Мирай-чан үнемі ойнақы күйде...
Dialogue: 0,0:12:38.90,0:12:41.40,Default,,0,0,0,,Қиындыққа тап болсаңыз, Эшфорд деп аталатын қалқанды пайдаланыңыз.
Dialogue: 0,0:12:41.53,0:12:44.65,Default,,0,0,0,,Профессор Ллойдпен келіскеніңізде солай болған жоқ па?
Dialogue: 0,0:12:44.78,0:12:48.03,Default,,0,0,0,,Үнемі маған төмен қарап, Қорғаушы болып, екіжүзділікке малынған.
Dialogue: 0,0:12:48.37,0:12:51.91,Default,,0,0,0,,Мен қазір басқамын, мені қабыл алыңыз.
Dialogue: 0,0:12:54.58,0:12:57.63,Default,,0,0,0,,Кагура га ха
Dialogue: 0,0:12:57.75,0:13:00.50,Default,,0,0,0,,Алым өз еркімен пайда болды.
Dialogue: 0,0:13:00.63,0:13:02.67,Default,,0,0,0,,Шынымен бақыттымын
Dialogue: 0,0:13:02.80,0:13:04.05,Default,,0,0,0,,Кагура да Британияға барады ма?
Dialogue: 0,0:13:04.17,0:13:07.59,Default,,0,0,0,,Ұмыт, ол өлім жазасына кесілуі керек әйел.
Dialogue: 0,0:13:07.72,0:13:10.35,Default,,0,0,0,,Бұл біртүрлі, бұл Британия емес.
Dialogue: 0,0:13:10.47,0:13:13.18,Default,,0,0,0,,Қара рыцарьлар Кохайды өлтіріп жатыр.
Dialogue: 0,0:13:13.77,0:13:17.02,Default,,0,0,0,,Саясатты бізге қалдырыңыз
Dialogue: 0,0:13:17.15,0:13:20.48,Default,,0,0,0,,Біз әрқашан осылай істедік емес пе?
Dialogue: 0,0:13:20.61,0:13:22.03,Default,,0,0,0,,Бірақ достар
Dialogue: 0,0:13:22.40,0:13:26.45,Default,,0,0,0,,Неге тоқтамайсың? Бүгін мереке.
Dialogue: 0,0:13:26.57,0:13:27.41,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:13:27.53,0:13:29.91,Default,,0,0,0,,Сумераги мырза, ертеңгі үйлену тойында...
Dialogue: 0,0:13:30.03,0:13:32.37,Default,,0,0,0,,Нөлді алып келмеуіңізді өтінемін?
Dialogue: 0,0:13:32.49,0:13:35.54,Default,,0,0,0,,Бұған көмектесу мүмкін емес.
Dialogue: 0,0:13:35.87,0:13:38.88,Default,,0,0,0,,Егер Ұлыбританияның жоғары мәртебелі премьер-министрі солай айтса.
Dialogue: 0,0:13:39.00,0:13:40.21,Default,,0,0,0,,Жабу
Dialogue: 0,0:13:43.42,0:13:47.22,Default,,0,0,0,,Шнайзел, сен менің көз алдымда өзіңді әшкереледің.
Dialogue: 0,0:13:47.63,0:13:50.22,Default,,0,0,0,,Хмм, сіз шынымен абайсыз ба?
Dialogue: 0,0:13:50.64,0:13:51.97,Default,,0,0,0,,Куруруги мырза
Dialogue: 0,0:13:52.26,0:13:55.06,Default,,0,0,0,,Есіңде ме? немере ағам мен
Dialogue: 0,0:13:55.43,0:13:56.77,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:13:56.89,0:14:00.48,Default,,0,0,0,,Біз қазір Киото алты отбасынан жалғыз аман қалғанбыз.
Dialogue: 0,0:14:00.61,0:14:03.36,Default,,0,0,0,,Кирихара мырза және басқалар терроризмді жақтаушылар болды.
Dialogue: 0,0:14:03.48,0:14:04.94,Default,,0,0,0,,Өлім жазасы сөзсіз болды
Dialogue: 0,0:14:05.19,0:14:09.24,Default,,0,0,0,,Сіз ұмыттыңыз ба? Әлгі Нөл-сама сізді баяғыда құтқарып қалды.
Dialogue: 0,0:14:09.24,0:14:09.61,Default,,0,0,0,,Сіз ұмыттыңыз ба? Әлгі Нөл-сама сізді баяғыда құтқарып қалды.
Dialogue: 0,0:14:09.24,0:14:09.61,Default,,0,0,0,,На
Dialogue: 0,0:14:09.61,0:14:09.74,Default,,0,0,0,,На
Dialogue: 0,0:14:09.74,0:14:10.24,Default,,0,0,0,,На
Dialogue: 0,0:14:09.74,0:14:10.24,Default,,0,0,0,,Сол қайырымды адамды да өліммен жазалауды жоспарлап отырсыз ба?
Dialogue: 0,0:14:10.24,0:14:12.45,Default,,0,0,0,,Сіз бұл қайырымды адамды өлім жазасына кесуді жоспарлап отырсыз ба?
Dialogue: 0,0:14:12.58,0:14:13.83,Default,,0,0,0,,Ал бұл не?
Dialogue: 0,0:14:14.29,0:14:15.66,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:14:15.79,0:14:18.75,Default,,0,0,0,,Адамдарды жай сөзбен өлтірсем ғой.
Dialogue: 0,0:14:18.87,0:14:19.79,Default,,0,0,0,,Мәртебелі Шнайзел
Dialogue: 0,0:14:19.92,0:14:20.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:20.71,0:14:23.25,Default,,0,0,0,,Шахмат ойнағың келе ме?
Dialogue: 0,0:14:23.38,0:14:24.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:24.30,0:14:27.05,Default,,0,0,0,,Егер мен жеңсем, кардиналды алғым келеді.
Dialogue: 0,0:14:27.17,0:14:28.59,Default,,0,0,0,,Не? тістері?
Dialogue: 0,0:14:28.72,0:14:30.55,Default,,0,0,0,,Мен оны Кагура-самаға беремін.
Dialogue: 0,0:14:30.68,0:14:33.01,Default,,0,0,0,,Бұл ең жақсы сыйлық.
Dialogue: 0,0:14:33.43,0:14:35.14,Default,,0,0,0,,Оны асыға күтіңіз.
Dialogue: 0,0:14:36.06,0:14:37.35,Default,,0,0,0,,Созаку кеткенше...
Dialogue: 0,0:14:37.48,0:14:39.89,Default,,0,0,0,,Geass осы жерде барлығына қолданылуы мүмкін.
Dialogue: 0,0:14:40.06,0:14:41.94,Default,,0,0,0,,Кері мат
Dialogue: 0,0:14:42.06,0:14:43.82,Default,,0,0,0,,Егер мен жеңсем...
Dialogue: 0,0:14:43.94,0:14:46.40,Default,,0,0,0,,Мен сенен сол масканы шешуіңді өтінемін бе?
Dialogue: 0,0:14:47.36,0:14:48.53,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:14:49.20,0:14:52.20,Default,,0,0,0,,Хаха Бұл көңілді сейд-шоу болатын сияқты.
Dialogue: 0,0:14:58.75,0:15:00.12,Default,,0,0,0,,Арнайы ойын-сауық
Dialogue: 0,0:15:00.25,0:15:02.04,Default,,0,0,0,,Бөлек бөлме қажет емес
Dialogue: 0,0:15:02.29,0:15:05.17,Default,,0,0,0,,Екінші тарап террорист. Мен бірдеңе болғанша күтемін.
Dialogue: 0,0:15:05.30,0:15:08.26,Default,,0,0,0,,Менің қорқынышым негізсіз. Күйеуім жеңеді.
Dialogue: 0,0:15:08.38,0:15:09.67,Default,,0,0,0,,Тс. Олардың қаншасы бар?
Dialogue: 0,0:15:10.26,0:15:11.59,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін, бірақ-
Dialogue: 0,0:15:11.72,0:15:14.39,Default,,0,0,0,,Мен інім Шнайзелдің жеңілгенін қаламаймын.
Dialogue: 0,0:15:14.51,0:15:16.35,Default,,0,0,0,,Мен елестете алмаймын
Dialogue: 0,0:15:21.44,0:15:23.40,Default,,0,0,0,,Бұл Қара рыцарьлардың шайбалары
Dialogue: 0,0:15:23.86,0:15:25.02,Default,,0,0,0,,Crimson Pilot
Dialogue: 0,0:15:25.15,0:15:28.49,Default,,0,0,0,,Бұрынғы емес пе? Орналастырылған кескіннен әлдеқайда жақсы
Dialogue: 0,0:15:28.61,0:15:30.03,Default,,0,0,0,,Мен сондай адаммын.
Dialogue: 0,0:15:30.28,0:15:31.99,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:34.45,0:15:36.87,Default,,0,0,0,,Күшті Мәртебелі итеріп жатыр.
Dialogue: 0,0:15:40.12,0:15:43.12,Default,,0,0,0,,О, мен оны ауыстырады деп ешқашан ойламадым.
Dialogue: 0,0:15:43.25,0:15:44.17,Default,,0,0,0,,Керемет
Dialogue: 0,0:15:44.29,0:15:48.21,Default,,0,0,0,,Ағам күткендей, мен жеңе алмаған жалғыз адам сенсің.
Dialogue: 0,0:15:48.34,0:15:51.67,Default,,0,0,0,,Бірақ бұл сегіз жыл бұрын болды.
Dialogue: 0,0:15:51.80,0:15:52.72,Default,,0,0,0,,Король? (аудитория) О
Dialogue: 0,0:15:52.84,0:15:55.76,Default,,0,0,0,,Патша қозғалмаса, оның қол астындағылар соңынан ермейді.
Dialogue: 0,0:15:56.68,0:16:00.06,Default,,0,0,0,,Бұл түсінік, содан кейін бұл да.
Dialogue: 0,0:16:01.73,0:16:04.52,Default,,0,0,0,,Шешуші соққы беру — әрқашан «Зе Ворлд»-тің шынайы күші.
Dialogue: 0,0:16:08.15,0:16:10.90,Default,,0,0,0,,Мұны кім ұтады?
Dialogue: 0,0:16:11.03,0:16:12.57,Default,,0,0,0,,Біз біркелкі сәйкестік.
Dialogue: 0,0:16:13.15,0:16:15.78,Default,,0,0,0,,Өсиеттердің жарысы
Dialogue: 0,0:16:17.03,0:16:20.41,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен ары қарай бара алмаймын
Dialogue: 0,0:16:20.66,0:16:22.54,Default,,0,0,0,,Хмм, осы жылдамдықпен...
Dialogue: 0,0:16:22.66,0:16:24.50,Default,,0,0,0,,Үш рет қайталау
Dialogue: 0,0:16:25.17,0:16:28.13,Default,,0,0,0,,Менің де айтайын дегенім жоқ, бірақ бұл тең нәтиже ме?
Dialogue: 0,0:16:28.59,0:16:30.05,Default,,0,0,0,,Жоқ? (Лелух) Иә?
Dialogue: 0,0:16:30.30,0:16:33.59,Default,,0,0,0,,Ақ патшаны кемітпе.
Dialogue: 0,0:16:33.84,0:16:35.05,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:16:35.55,0:16:36.68,Default,,0,0,0,,(Сора) Сол жақтағы қарт кітапханада мені бақылап тұрды—
Dialogue: 0,0:16:36.89,0:16:39.22,Default,,0,0,0,,Сонда, егер Нөл өз бөлігін жылжытса,
Dialogue: 0,0:16:39.51,0:16:40.39,Default,,0,0,0,,Шнайзелдікі
Dialogue: 0,0:16:40.64,0:16:42.14,Default,,0,0,0,,Король алынды
Dialogue: 0,0:16:42.35,0:16:44.23,Default,,0,0,0,,Сіз тым көп қалжыңдап жатырсыз.
Dialogue: 0,0:16:44.35,0:16:45.81,Default,,0,0,0,,Сіз әдейі жеңілгіңіз келе ме?
Dialogue: 0,0:16:47.98,0:16:49.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:50.07,0:16:52.44,Default,,0,0,0,,Маған оны алуымды айтасыз ба? Жеңіс!
Dialogue: 0,0:16:54.32,0:16:56.24,Default,,0,0,0,,Осы шақыруды қабылдау мынаны білдіреді...
Dialogue: 0,0:16:56.36,0:16:58.07,Default,,0,0,0,,тапсыру дегенді білдіреді
Dialogue: 0,0:16:58.20,0:17:02.04,Default,,0,0,0,,Мен өзімді мұндай қорлау үшін кешірмеуім керек.
Dialogue: 0,0:17:04.41,0:17:07.25,Default,,0,0,0,,Мәртебелі император оны еш ойланбастан алатын еді.
Dialogue: 0,0:17:07.38,0:17:08.21,Default,,0,0,0,,Уф
Dialogue: 0,0:17:08.33,0:17:12.01,Default,,0,0,0,,Мен сіздің қандай адам екеніңізді аздап білемін деп ойлаймын.
Dialogue: 0,0:17:12.13,0:17:16.18,Default,,0,0,0,,Шнайзел, сен маған солай қарайсың.
Dialogue: 0,0:17:17.18,0:17:19.64,Default,,0,0,0,,Нөлдік Эфемияның жауы
Dialogue: 0,0:17:22.68,0:17:24.35,Default,,0,0,0,,Тоқта, Нина.
Dialogue: 0,0:17:25.02,0:17:28.02,Default,,0,0,0,,Неге мені мазалайсың, Созаку?
Dialogue: 0,0:17:28.15,0:17:29.98,Default,,0,0,0,,Ол Эфемияның рыцарь болды, солай ма?
Dialogue: 0,0:17:30.23,0:17:32.73,Default,,0,0,0,,Иә, неге мен?
Dialogue: 0,0:17:32.86,0:17:35.07,Default,,0,0,0,,Сіз он бірдесіз.
Dialogue: 0,0:17:35.19,0:17:36.03,Default,,0,0,0,,Нина
Dialogue: 0,0:17:36.86,0:17:38.82,Default,,0,0,0,,Карен, сен де...
Dialogue: 0,0:17:38.95,0:17:41.24,Default,,0,0,0,,Менде жарты британдық қан болса да.
Dialogue: 0,0:17:41.41,0:17:44.25,Default,,0,0,0,,Жоқ, мен жапонмын.
Dialogue: 0,0:17:45.08,0:17:47.96,Default,,0,0,0,,жапон? Он бір, иә?
Dialogue: 0,0:17:48.08,0:17:50.88,Default,,0,0,0,,Он бір жаста болсаң да, дос сияқтысың
Dialogue: 0,0:17:51.21,0:17:53.76,Default,,0,0,0,,Маған қайтар, Эфемия-сама.
Dialogue: 0,0:17:53.88,0:17:57.26,Default,,0,0,0,,Маған керек еді, тәңірім.
Dialogue: 0,0:17:57.55,0:17:58.38,Default,,0,0,0,,Нина
Dialogue: 0,0:17:58.51,0:18:00.80,Default,,0,0,0,,Нөл оны өлтірсе де
Dialogue: 0,0:18:01.76,0:18:05.18,Default,,0,0,0,,Бұл да нөлден туындаған трагедия.
Dialogue: 0,0:18:07.06,0:18:08.02,Default,,0,0,0,,Нина
Dialogue: 0,0:18:16.74,0:18:20.24,Default,,0,0,0,,Кешіріңіз, тіпті осы уақытқа дейін.
Dialogue: 0,0:18:20.91,0:18:22.99,Default,,0,0,0,,Карен, сен өзгерген жоқсың.
Dialogue: 0,0:18:23.12,0:18:25.83,Default,,0,0,0,,Қара көтеріліске қатысқан кезде де...
Dialogue: 0,0:18:25.95,0:18:28.21,Default,,0,0,0,,Бізге қамқор бол
Dialogue: 0,0:18:28.58,0:18:30.58,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:18:31.75,0:18:34.21,Default,,0,0,0,,Мен қайтпаймын
Dialogue: 0,0:18:34.92,0:18:36.55,Default,,0,0,0,,Кешіріңіз, нөл.
Dialogue: 0,0:18:36.67,0:18:38.84,Default,,0,0,0,,Ойын-сауықты осы жерден аяқтаймыз.
Dialogue: 0,0:18:38.97,0:18:41.09,Default,,0,0,0,,Мұны растау үшін...
Dialogue: 0,0:18:41.22,0:18:43.01,Default,,0,0,0,,Ертең барудан аулақ болыңыз.
Dialogue: 0,0:18:43.14,0:18:45.60,Default,,0,0,0,,Келесі жолы мен шахмат немесе басқа да ойын ойнай алмаймын.
Dialogue: 0,0:18:48.48,0:18:49.69,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:18:50.81,0:18:53.15,Default,,0,0,0,,Иә, ертең мен...
Dialogue: 0,0:18:53.27,0:18:55.53,Default,,0,0,0,,Осы адаммен неке қию рәсімін аяқтағаннан кейін...
Dialogue: 0,0:18:55.65,0:18:59.40,Default,,0,0,0,,Тыйым салынған қаланың сыртында, Британияға кепіл ретінде
Dialogue: 0,0:19:00.70,0:19:03.57,Default,,0,0,0,,Мен осылай сыртқа шығатыныма сене алар емеспін.
Dialogue: 0,0:19:04.83,0:19:07.12,Default,,0,0,0,,Бірінші рет соңғы болады
Dialogue: 0,0:19:07.70,0:19:11.00,Default,,0,0,0,,Сіз ешқашан орала алмайсыз.
Dialogue: 0,0:19:11.33,0:19:14.42,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:19:14.63,0:19:15.46,Default,,0,0,0,,Га
Dialogue: 0,0:19:15.67,0:19:20.09,Default,,0,0,0,,Аспанның үнінен, жердің зарынан, адамның жүрегінен сұраймын.
Dialogue: 0,0:19:20.63,0:19:23.93,Default,,0,0,0,,Бұл некені Қытай Федерациясының ниеті не етеді?
Dialogue: 0,0:19:24.05,0:19:25.14,Default,,0,0,0,,Террорист?
Dialogue: 0,0:19:25.26,0:19:26.93,Default,,0,0,0,,Дұрысы, бұл төңкеріс емес пе?
Dialogue: 0,0:19:27.22,0:19:28.56,Default,,0,0,0,,Қанды жоғалтқан Утака Сейки
Dialogue: 0,0:19:28.89,0:19:32.06,Default,,0,0,0,,Жау Хао, бүкіл халықтың атынан үндеме.
Dialogue: 0,0:19:32.19,0:19:34.40,Default,,0,0,0,,Мен бұл некеге қарсымын
Dialogue: 0,0:19:34.52,0:19:35.40,Default,,0,0,0,,Ұстау
Dialogue: 0,0:19:36.86,0:19:37.98,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:19:39.82,0:19:42.41,Default,,0,0,0,,Мен аштықтан өлген адамдарды құтқарғым келсе де...
Dialogue: 0,0:19:42.53,0:19:44.87,Default,,0,0,0,,Мен Аспан Ұлы туралы ойлаймын.
Dialogue: 0,0:19:45.16,0:19:46.03,Default,,0,0,0,,Қазір уақыт...
Dialogue: 0,0:19:46.62,0:19:47.24,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:47.49,0:19:48.62,Default,,0,0,0,,Таратуды өшіріңіз
Dialogue: 0,0:19:49.16,0:19:50.16,Default,,0,0,0,,Бір қорқынышты нәрсе болды...
Dialogue: 0,0:19:51.16,0:19:52.87,Default,,0,0,0,,Ах (Бәсекелес) Әй, төраға кім?
Dialogue: 0,0:19:53.17,0:19:53.83,Default,,0,0,0,,Мияу?
Dialogue: 0,0:19:54.13,0:19:55.71,Default,,0,0,0,,Кагура-сама, төмен түсейік.
Dialogue: 0,0:19:55.84,0:19:56.79,Default,,0,0,0,,Не?
Dialogue: 0,0:19:56.92,0:19:57.71,Default,,0,0,0,,Сузаку-кун
Dialogue: 0,0:19:57.84,0:19:58.50,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:19:59.84,0:20:00.80,Default,,0,0,0,,Тоқта
Dialogue: 0,0:20:00.92,0:20:03.47,Default,,0,0,0,,Егер сіз Британиядан келген адамды ұрсаңыз, маңызды.
Dialogue: 0,0:20:03.59,0:20:04.64,Default,,0,0,0,,Оны ұстаңыз
Dialogue: 0,0:20:06.51,0:20:08.97,Default,,0,0,0,,Аспан Ұлын өзімдікі деп санауға тырысқан опасыздық.
Dialogue: 0,0:20:09.18,0:20:10.93,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:20:12.14,0:20:15.48,Default,,0,0,0,,Бұл әрекет Көк Ұлының еркіне сай келе ме, білмеймін.
Dialogue: 0,0:20:16.06,0:20:20.36,Default,,0,0,0,,Аспан Ұлы алты жыл бұрын болған оқиғаны есіне түсірмеуі мүмкін.
Dialogue: 0,0:20:20.49,0:20:24.36,Default,,0,0,0,,Сонда да менің өмірімді сақтап қалудың орнына...
Dialogue: 0,0:20:24.49,0:20:27.03,Default,,0,0,0,,Мәңгілік келісімге ант бердік.
Dialogue: 0,0:20:27.16,0:20:30.20,Default,,0,0,0,,Менің жүрегіммен
Dialogue: 0,0:20:30.33,0:20:33.46,Default,,0,0,0,,Аспан Ұлына, сыртқы әлемге
Dialogue: 0,0:20:33.62,0:20:35.17,Default,,0,0,0,,Жұлдызша белгі! (Басты рөлде) Ха!
Dialogue: 0,0:20:36.63,0:20:41.80,Default,,0,0,0,,Жұлдызша ою Жұлдызша ою Жұлдызша ою
Dialogue: 0,0:20:43.34,0:20:45.30,Default,,0,0,0,,Ол есіне алды
Dialogue: 0,0:20:47.18,0:20:49.97,Default,,0,0,0,,Жүрегімде күмән жоқ
Dialogue: 0,0:20:50.60,0:20:52.18,Default,,0,0,0,,Жұлдызша ою
Dialogue: 0,0:20:58.06,0:20:59.52,Default,,0,0,0,,Рахмет Жұлдыз
Dialogue: 0,0:21:00.11,0:21:03.40,Default,,0,0,0,,Сіздің арқаңызда мен оңай қозғала аламын.
Dialogue: 0,0:21:03.65,0:21:05.57,Default,,0,0,0,,О, тіпті бұл адам.
Dialogue: 0,0:21:05.91,0:21:07.95,Default,,0,0,0,,Нөл Бұл нені білдіреді?
Dialogue: 0,0:21:08.07,0:21:09.70,Default,,0,0,0,,Қозғалма (Тенши)
Dialogue: 0,0:21:09.83,0:21:11.49,Default,,0,0,0,,Ах, жексұрын
Dialogue: 0,0:21:11.83,0:21:14.50,Default,,0,0,0,,Нөл Мен сізге көп кеңес бердім.
Dialogue: 0,0:21:15.12,0:21:18.50,Default,,0,0,0,,Қара рыцарьлар 11-аймақта қарызға берілуі керек еді.
Dialogue: 0,0:21:18.75,0:21:20.96,Default,,0,0,0,,Ендеше мен бұл тойды құртамын.
Dialogue: 0,0:21:21.09,0:21:23.09,Default,,0,0,0,,Қалауыңызша
Dialogue: 0,0:21:23.21,0:21:26.51,Default,,0,0,0,,Алайда мен қалыңдықты аламын.
Dialogue: 0,0:21:26.63,0:21:27.93,Default,,0,0,0,,Жұлдызша ою
Dialogue: 0,0:21:28.05,0:21:29.22,Default,,0,0,0,,Аспан Ұлы
Dialogue: 0,0:21:29.68,0:21:32.10,Default,,0,0,0,,Бұл гейдо
Dialogue: 0,0:21:32.31,0:21:34.14,Default,,0,0,0,,О, шынымен бе?
Dialogue: 0,0:21:34.27,0:21:36.02,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:36.14,0:21:38.31,Default,,0,0,0,,Фухахахахахахахаха
Dialogue: 0,0:21:38.44,0:21:41.36,Default,,0,0,0,,Фухахахахахахахаха
Dialogue: 0,0:21:41.48,0:21:43.99,Default,,0,0,0,,) Иә, Нөлдің шынайы мақсаты
Dialogue: 0,0:21:44.69,0:21:46.70,Default,,0,0,0,,Бұл жерде орын алса, қиын болар еді.
Dialogue: 0,0:21:46.99,0:21:50.24,Default,,0,0,0,,О, сонда мен үшін ұйымдастырғың келе ме?
Dialogue: 0,0:21:50.37,0:21:51.41,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:51.53,0:21:53.12,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:53.24,0:21:54.79,Default,,0,0,0,,Түзетулер енгізілгеннен кейін...
Dialogue: 0,0:21:54.91,0:21:57.87,Default,,0,0,0,,Ешбір C.C. Лелух та жау емес.
Dialogue: 0,0:21:58.00,0:22:03.25,Default,,0,0,0,,Бұл Джеремиа Готвальд, мен сіздің үміттеріңізді ақтауға бар күшімді саламын.
Dialogue: 0,0:22:03.38,0:22:08.09,Default,,0,0,0,,♪Мен оны бір күні кеудемнен таптым
Dialogue: 0,0:22:08.22,0:22:14.81,Default,,0,0,0,,♪Бақыт бөліктерін жинап алайық
Dialogue: 0,0:22:14.93,0:22:19.81,Default,,0,0,0,,♪Ұмытып қала жаздаған әуен
Dialogue: 0,0:22:19.94,0:22:26.90,Default,,0,0,0,,♪ Менің ортамда сөнбестен
Dialogue: 0,0:22:30.11,0:22:34.74,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:34.87,0:22:40.04,Default,,0,0,0,,♪Қазіргі жерде болғаным барлығына рахмет.
Dialogue: 0,0:22:40.17,0:22:44.71,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:44.84,0:22:47.55,Default,,0,0,0,,♪Келесі мен бәріне айтамын
Dialogue: 0,0:22:47.67,0:22:51.01,Default,,0,0,0,,♪БАҚЫТТЫ Мен саған Уау беремін
Dialogue: 0,0:22:51.14,0:22:56.14,Default,,0,0,0,,♪Мен ештеңені ұмытпаймын
Dialogue: 0,0:22:56.27,0:23:02.73,Default,,0,0,0,,♪Себебі мен де сол күні менмін
Dialogue: 0,0:23:02.86,0:23:07.82,Default,,0,0,0,,♪Мен әрқашан сені сүйемін деп айтамын
Dialogue: 0,0:23:07.94,0:23:11.95,Default,,0,0,0,,♪Сен маған айтуың керек.
Dialogue: 0,0:23:12.07,0:23:16.33,Default,,0,0,0,,♪ Көз жасы ағып кете жаздады
Dialogue: 0,0:23:16.45,0:23:23.00,Default,,0,0,0,,♪Ұзақ түнде кенет артыма қарадым
Dialogue: 0,0:23:23.13,0:23:27.13,Default,,0,0,0,,♪Адамның ізімен жүру
Dialogue: 0,0:23:27.25,0:23:34.22,Default,,0,0,0,,♪Сол күнді ұмытпа
Dialogue: 0,0:23:37.68,0:23:39.23,Default,,0,0,0,,Аспан Ұлы менің қолыма түсті
Dialogue: 0,0:23:39.35,0:23:41.39,Default,,0,0,0,,Барлығың менің жоспарым бойынша билеңдер.
Dialogue: 0,0:23:41.52,0:23:42.69,Default,,0,0,0,,Қытай Федерациясы деп аталатын елде
Dialogue: 0,0:23:42.81,0:23:44.86,Default,,0,0,0,,Мен бірден мат жасаймын.
Dialogue: 0,0:23:44.98,0:23:45.82,Default,,0,0,0,,Содан кейін-
Dialogue: 0,0:23:45.94,0:23:48.23,Default,,0,0,0,,Сіз оған жақындай аласыз.
Dialogue: 0,0:23:48.36,0:23:50.61,Default,,0,0,0,,Сол себепті мен...
Dialogue: 0,0:23:52.11,0:23:58.11,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory