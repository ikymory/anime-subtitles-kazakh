Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.98,0:00:07.61,Default,,0,0,0,,Сонымен, Императорлық Капитал Пендрагон жоғалып кетті ме?
Dialogue: 0,0:00:07.73,0:00:08.78,Default,,0,0,0,,Бұл рас па? Яғни
Dialogue: 0,0:00:08.90,0:00:09.94,Default,,0,0,0,,Фрейжа оқтұмсығына ұқсайды
Dialogue: 0,0:00:10.07,0:00:12.15,Default,,0,0,0,,Токио концессиясын жойдыңыз ба?
Dialogue: 0,0:00:12.28,0:00:16.28,Default,,0,0,0,,Бұл жазатайым оқиға болды ма? Алайда, шығарылуы тиіс Freya жоғалып кетті.
Dialogue: 0,0:00:16.74,0:00:18.24,Default,,0,0,0,,Абайсыз әрекеттерден аулақ болыңыз
Dialogue: 0,0:00:18.37,0:00:19.04,Default,,0,0,0,,Ах
Dialogue: 0,0:00:19.16,0:00:22.87,Default,,0,0,0,,Императорлық капиталдың жоғалып кеткені туралы қауесет болса да, бұл арамдық.
Dialogue: 0,0:00:23.00,0:00:26.25,Default,,0,0,0,,Жоқ, бұл рас шығар.
Dialogue: 0,0:00:26.38,0:00:27.21,Default,,0,0,0,,Не?
Dialogue: 0,0:00:27.34,0:00:28.80,Default,,0,0,0,,О, сен
Dialogue: 0,0:00:28.92,0:00:32.72,Default,,0,0,0,,Өтінемін, менің шапағатымды Лелуш-самаға жеткізіңіз...
Dialogue: 0,0:00:34.30,0:00:38.85,Default,,0,0,0,,♪Дүниенің ақырында туған нұр
Dialogue: 0,0:00:38.97,0:00:44.52,Default,,0,0,0,,♪ Қазір желде
Dialogue: 0,0:01:00.41,0:01:05.37,Default,,0,0,0,,♪Сұлу болу арқылы өмір сүре алмайсың
Dialogue: 0,0:01:05.75,0:01:11.09,Default,,0,0,0,,♪Мейірімділік жалғыз емдей алмайды
Dialogue: 0,0:01:11.21,0:01:13.92,Default,,0,0,0,,♪Не ұрланды?
Dialogue: 0,0:01:14.05,0:01:16.18,Default,,0,0,0,,♪Өзгермейтін әлемде
Dialogue: 0,0:01:16.63,0:01:19.26,Default,,0,0,0,,♪Сіз не естідіңіз?
Dialogue: 0,0:01:19.39,0:01:22.52,Default,,0,0,0,,♪Түстер әні
Dialogue: 0,0:01:22.64,0:01:27.52,Default,,0,0,0,,♪Бәрі жарық
Dialogue: 0,0:01:28.35,0:01:30.98,Default,,0,0,0,,♪Тасылған армандар
Dialogue: 0,0:01:31.11,0:01:37.53,Default,,0,0,0,,♪Ертеңгі күннің соңында жаңғырық
Dialogue: 0,0:01:39.16,0:01:43.62,Default,,0,0,0,,♪Ақырзаманда туған нұр
Dialogue: 0,0:01:43.75,0:01:48.29,Default,,0,0,0,,♪Біз бірміз
Dialogue: 0,0:01:49.17,0:01:54.80,Default,,0,0,0,,♪ Енді желде
Dialogue: 0,0:02:10.81,0:02:11.56,Default,,0,0,0,,Ах аа
Dialogue: 0,0:02:12.27,0:02:14.69,Default,,0,0,0,,На… Нуннал
Dialogue: 0,0:02:14.94,0:02:16.78,Default,,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:02:16.90,0:02:19.86,Default,,0,0,0,,Иә, Шнайзел ағаға рахмет.
Dialogue: 0,0:02:19.99,0:02:21.20,Default,,0,0,0,,Шнайзел
Dialogue: 0,0:02:21.49,0:02:22.33,Default,,0,0,0,,Нуннальды
Dialogue: 0,0:02:22.62,0:02:25.70,Default,,0,0,0,,Сіз Шнайзелдің не істегенін білесіз бе?
Dialogue: 0,0:02:25.83,0:02:30.21,Default,,0,0,0,,Иә, біз император астанасы Пендрагонға Фрейджа оқтұмсығымен аттық.
Dialogue: 0,0:02:30.58,0:02:32.09,Default,,0,0,0,,Соны біле тұра, неге!
Dialogue: 0,0:02:32.21,0:02:34.92,Default,,0,0,0,,Сонымен, Геасс дұрыс па?
Dialogue: 0,0:02:35.05,0:02:36.09,Default,,0,0,0,,Ах
Dialogue: 0,0:02:36.96,0:02:41.55,Default,,0,0,0,,Сіз де, Созаку-сан да маған осы уақыт бойы өтірік айттыңыз.
Dialogue: 0,0:02:41.68,0:02:43.97,Default,,0,0,0,,Шындық туралы үндеме
Dialogue: 0,0:02:44.39,0:02:46.47,Default,,0,0,0,,Бірақ мен білдім
Dialogue: 0,0:02:48.60,0:02:50.48,Default,,0,0,0,,Сонда сіздің ағаңыз нөл болды ма?
Dialogue: 0,0:02:50.60,0:02:51.77,Default,,0,0,0,,Га
Dialogue: 0,0:02:52.40,0:02:57.03,Default,,0,0,0,,Неліктен... бұл мен үшін?
Dialogue: 0,0:02:57.15,0:02:58.90,Default,,0,0,0,,Олай болса, I
Dialogue: 0,0:02:59.03,0:03:00.28,Default,,0,0,0,,Хэхехаха
Dialogue: 0,0:03:00.57,0:03:04.49,Default,,0,0,0,,Сізге? Бұл менің кіші әпкемнің ұятсыздығы.
Dialogue: 0,0:03:04.62,0:03:05.49,Default,,0,0,0,,Га
Dialogue: 0,0:03:05.66,0:03:09.83,Default,,0,0,0,,Басқалардан бата алу қалыпты жағдай деп ойлайсың ба?
Dialogue: 0,0:03:09.96,0:03:13.29,Default,,0,0,0,,Қолыңызды кірлетпеңіз, тек басқаларды өз әрекеттеріне кінәлаңыз
Dialogue: 0,0:03:13.63,0:03:14.54,Default,,0,0,0,,Га
Dialogue: 0,0:03:14.96,0:03:18.71,Default,,0,0,0,,Сіз мен жоққа шығарған дәл сол ескі ақсүйектерсіз.
Dialogue: 0,0:03:19.22,0:03:20.72,Default,,0,0,0,,Мен...
Dialogue: 0,0:03:21.18,0:03:22.43,Default,,0,0,0,,Ешкім үшін емес
Dialogue: 0,0:03:22.97,0:03:25.76,Default,,0,0,0,,Дүниені өзім үшін аламын
Dialogue: 0,0:03:26.26,0:03:29.02,Default,,0,0,0,,Сен менің үстемдігімнен бұрын Шнайзелмен күш біріктірдің...
Dialogue: 0,0:03:29.14,0:03:31.81,Default,,0,0,0,,Жолыма бөгет болсаң, аямаймын.
Dialogue: 0,0:03:31.94,0:03:33.52,Default,,0,0,0,,Оны жай ғана ұсақтап тастаңыз.
Dialogue: 0,0:03:33.65,0:03:35.27,Default,,0,0,0,,Үлкен аға... ха
Dialogue: 0,0:03:37.65,0:03:38.74,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:03:39.90,0:03:41.24,Default,,0,0,0,,Амансың ба, Нуналли?
Dialogue: 0,0:03:41.36,0:03:43.41,Default,,0,0,0,,Сіз мені жаман сезіндіңіз.
Dialogue: 0,0:03:44.16,0:03:47.87,Default,,0,0,0,,Мен сізге Фрейяның күшін көрсетсем, ол беріледі деп ойладым.
Dialogue: 0,0:03:47.99,0:03:49.70,Default,,0,0,0,,Шнайзел аға
Dialogue: 0,0:03:49.83,0:03:53.33,Default,,0,0,0,,Пендрагон тұрғындары шынымен жақсы ма?
Dialogue: 0,0:03:53.46,0:03:55.13,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:03:55.25,0:03:57.84,Default,,0,0,0,,Біз эвакуация бойынша нұсқаулар бердік.
Dialogue: 0,0:03:57.96,0:03:58.63,Default,,0,0,0,,Ах
Dialogue: 0,0:03:58.76,0:04:01.76,Default,,0,0,0,,Әрине, зиян болмайды, бірақ...
Dialogue: 0,0:04:01.88,0:04:03.80,Default,,0,0,0,,Мен оны барынша азайтуға тырыстым.
Dialogue: 0,0:04:03.93,0:04:08.47,Default,,0,0,0,,Бірақ келесі жолы адамдарға қолданармын, ағайын.
Dialogue: 0,0:04:08.60,0:04:11.89,Default,,0,0,0,,Дүниедегі бейбітшілік жолында олар бөгет болса
Dialogue: 0,0:04:12.19,0:04:13.90,Default,,0,0,0,,Шнайзел аға
Dialogue: 0,0:04:14.40,0:04:17.52,Default,,0,0,0,,Маған Фрейяның сөндіргішін бере аласыз ба?
Dialogue: 0,0:04:17.65,0:04:18.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:18.61,0:04:22.28,Default,,0,0,0,,Мен күресе де, қорғай да алмаймын
Dialogue: 0,0:04:22.40,0:04:26.37,Default,,0,0,0,,Сондықтан мен кем дегенде өз кінәмді мойныма алғым келеді.
Dialogue: 0,0:04:26.49,0:04:27.49,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:29.62,0:04:31.87,Default,,0,0,0,,Бауырым, маған бір сәт болады ма?
Dialogue: 0,0:04:32.04,0:04:33.04,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:04:33.16,0:04:36.46,Default,,0,0,0,,C.C. Неге мен Nunnally туралы түсінбедім?
Dialogue: 0,0:04:36.58,0:04:38.34,Default,,0,0,0,,Мен Құдай емеспін
Dialogue: 0,0:04:38.46,0:04:41.17,Default,,0,0,0,,Геасс арқылы байланыспаған адамдарға келетін болсақ.
Dialogue: 0,0:04:41.55,0:04:43.72,Default,,0,0,0,,Қарғыс атсын Шнайзел.
Dialogue: 0,0:04:43.84,0:04:46.22,Default,,0,0,0,,Осы фактіні осы уақытқа дейін жасырып келдіңіз бе?
Dialogue: 0,0:04:46.34,0:04:49.26,Default,,0,0,0,,Оны карта ретінде тиімді пайдалану үшін!
Dialogue: 0,0:04:49.51,0:04:53.02,Default,,0,0,0,,Бұл жағдайда карталарды кесу тәсілі керемет болды.
Dialogue: 0,0:04:53.14,0:04:56.85,Default,,0,0,0,,Сонша, сонша!
Dialogue: 0,0:04:56.98,0:04:58.31,Default,,0,0,0,,Лелух (Лелух) Ах...
Dialogue: 0,0:04:58.44,0:04:59.57,Default,,0,0,0,,Га
Dialogue: 0,0:04:59.69,0:05:01.57,Default,,0,0,0,,Стратегиялық мақсаттар өзгеріссіз қалады
Dialogue: 0,0:05:01.69,0:05:02.40,Default,,0,0,0,,Уф
Dialogue: 0,0:05:02.69,0:05:06.45,Default,,0,0,0,,Мен Нанналли тірі болғандықтан тоқтай алмаймын.
Dialogue: 0,0:05:06.57,0:05:08.57,Default,,0,0,0,,Нөлдік реквием не үшін қажет?
Dialogue: 0,0:05:08.78,0:05:10.03,Default,,0,0,0,,Неміс армиясы Страиццомен және сол қарт Спидвагонмен байланысты ма—
Dialogue: 0,0:05:10.16,0:05:10.79,Default,,0,0,0,,Га
Dialogue: 0,0:05:10.95,0:05:13.04,Default,,0,0,0,,Өз уәдеңізді есте сақтаңыз
Dialogue: 0,0:05:13.16,0:05:14.33,Default,,0,0,0,,Созаку
Dialogue: 0,0:05:15.75,0:05:17.29,Default,,0,0,0,,Мен оның қылышымын
Dialogue: 0,0:05:17.42,0:05:21.00,Default,,0,0,0,,Оның жаулары мен әлсіз жақтарын жоямын.
Dialogue: 0,0:05:21.13,0:05:23.71,Default,,0,0,0,,Сондықтан, С.С., менің қалқаным болшы.
Dialogue: 0,0:05:23.84,0:05:25.01,Default,,0,0,0,,А...
Dialogue: 0,0:05:25.13,0:05:27.34,Default,,0,0,0,,Қорғау сіздің міндетіңіз
Dialogue: 0,0:05:27.47,0:05:28.80,Default,,0,0,0,,Бұл тек өзімшіл мәлімдеме.
Dialogue: 0,0:05:29.43,0:05:32.22,Default,,0,0,0,,Лелуш сіздің сыбайласыңыз, солай ма?
Dialogue: 0,0:05:33.56,0:05:36.06,Default,,0,0,0,,Сыбайлас… немесе…
Dialogue: 0,0:05:37.14,0:05:41.19,Default,,0,0,0,,Пендрагонда қолданылған Freya Токио концессиясындағыдан өзгеше болды.
Dialogue: 0,0:05:41.32,0:05:42.94,Default,,0,0,0,,Тиімді диапазон шамамен 10 есе үлкен
Dialogue: 0,0:05:43.07,0:05:44.86,Default,,0,0,0,,Ах... Аа Ах
Dialogue: 0,0:05:45.44,0:05:47.91,Default,,0,0,0,,Егер бұл жаңа өндіріс болмаса
Dialogue: 0,0:05:48.03,0:05:50.24,Default,,0,0,0,,Шектегішті алып тастадыңыз ба?
Dialogue: 0,0:05:50.37,0:05:51.28,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:05:51.95,0:05:55.50,Default,,0,0,0,,Тиімді диапазон мен жарылу уақытының шектеулерін қалай жоюға болады?
Dialogue: 0,0:05:55.71,0:05:57.42,Default,,0,0,0,,Мәртебелі Шнайзел...
Dialogue: 0,0:05:58.62,0:05:59.71,Default,,0,0,0,,Өте рахмет. Енді барамын.
Dialogue: 0,0:05:59.83,0:06:02.55,Default,,0,0,0,,Сонымен Пендрагон тұрғындары
Dialogue: 0,0:06:02.80,0:06:06.59,Default,,0,0,0,,Мен оның жоғалып кетуін сұрадым, бұл оны бақытты етпей ме?
Dialogue: 0,0:06:06.72,0:06:09.05,Default,,0,0,0,,Лелушқа адал өмір сүруден гөрі
Dialogue: 0,0:06:09.18,0:06:10.68,Default,,0,0,0,,Бірақ Nunnally үшін
Dialogue: 0,0:06:10.80,0:06:12.43,Default,,0,0,0,,Өтірік айту да ыңғайлы.
Dialogue: 0,0:06:12.89,0:06:14.64,Default,,0,0,0,,Нанналли Лелучпен бетпе-бет келгенде...
Dialogue: 0,0:06:14.77,0:06:16.31,Default,,0,0,0,,Оларды шешім қабылдауға мәжбүрлеу үшін--
Dialogue: 0,0:06:16.43,0:06:19.35,Default,,0,0,0,,Қажетсіз ақпаратты қоспаған дұрыс.
Dialogue: 0,0:06:19.48,0:06:22.11,Default,,0,0,0,,Адамдарды осылай манипуляциялайсың ба, ағайын?
Dialogue: 0,0:06:22.27,0:06:25.78,Default,,0,0,0,,Корнелия Адамдар нені қалайды?
Dialogue: 0,0:06:26.32,0:06:29.45,Default,,0,0,0,,Аштық пен кедейлік Кемсітушілік Сыбайлас жемқорлық
Dialogue: 0,0:06:29.91,0:06:31.82,Default,,0,0,0,,Соғыс және терроризм
Dialogue: 0,0:06:31.95,0:06:35.49,Default,,0,0,0,,Дүниеде толып жатқан проблемаларды жоюды қалаумен бірге...
Dialogue: 0,0:06:35.62,0:06:39.33,Default,,0,0,0,,Адамдар бір-бірін үмітсіз түсіне алмаса
Dialogue: 0,0:06:39.46,0:06:42.00,Default,,0,0,0,,Ең дұрысы, түсінемін, бейбіт тұрғындар.
Dialogue: 0,0:06:42.13,0:06:43.71,Default,,0,0,0,,Иә
Dialogue: 0,0:06:43.84,0:06:48.47,Default,,0,0,0,,Тіпті соғысты жоққа шығаратын бейбіт тұрғындарға да полиция сенеді.
Dialogue: 0,0:06:48.59,0:06:52.47,Default,,0,0,0,,Қылмысты тоқтату мүмкін емес екенін бәріміз білеміз.
Dialogue: 0,0:06:52.60,0:06:55.51,Default,,0,0,0,,Әр адамның қалауын жоққа шығаруға болмайды.
Dialogue: 0,0:06:56.10,0:06:59.31,Default,,0,0,0,,Олай болса, жүрек те, принцип те керек емес.
Dialogue: 0,0:06:59.44,0:07:02.44,Default,,0,0,0,,Біз бейбітшілікке жүйе мен билік арқылы жетуіміз керек емес пе?
Dialogue: 0,0:07:02.56,0:07:03.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:03.61,0:07:04.82,Default,,0,0,0,,Га
Dialogue: 0,0:07:05.02,0:07:09.45,Default,,0,0,0,,Бұл Дамокл 10 күннен кейін АҚШ-тың Қытай әуе кеңістігіне кіреді.
Dialogue: 0,0:07:09.57,0:07:11.41,Default,,0,0,0,,Екіншілік жеделдетуге ауысу
Dialogue: 0,0:07:11.53,0:07:15.28,Default,,0,0,0,,Осыдан кейін ол жерден 300 километрге дейін көтеріледі.
Dialogue: 0,0:07:15.41,0:07:19.21,Default,,0,0,0,,Осы позициядан соғыс жүргізіңіз Фрейяны барлық елдерге атыңыз
Dialogue: 0,0:07:19.41,0:07:23.17,Default,,0,0,0,,Күте тұрыңыз! Лелучты жеңу емес пе еді?
Dialogue: 0,0:07:23.29,0:07:24.46,Default,,0,0,0,,Қазір бүкіл әлем...
Dialogue: 0,0:07:25.17,0:07:27.80,Default,,0,0,0,,Сіз адамдарды қорқыныш арқылы бағындыруға тырысасыз ба?
Dialogue: 0,0:07:27.92,0:07:32.13,Default,,0,0,0,,Бейбітшілік – елес. Ұрыс – адамзат тарихы.
Dialogue: 0,0:07:32.26,0:07:36.14,Default,,0,0,0,,Қиялды шындыққа айналдыру үшін тәртіп қажет емес пе?
Dialogue: 0,0:07:36.26,0:07:38.68,Default,,0,0,0,,Сіз адамзатты тәрбиелеуді мақсат етесіз бе?
Dialogue: 0,0:07:38.81,0:07:41.85,Default,,0,0,0,,Мұндай нәрселерге Құдайдан басқа рұқсат етілмейді.
Dialogue: 0,0:07:41.98,0:07:43.31,Default,,0,0,0,,Содан кейін құдай бол
Dialogue: 0,0:07:43.44,0:07:44.19,Default,,0,0,0,,На
Dialogue: 0,0:07:44.31,0:07:47.53,Default,,0,0,0,,Адамдар меннен тыныштық қаласа
Dialogue: 0,0:07:47.65,0:07:48.61,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:07:48.73,0:07:49.44,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:49.57,0:07:50.19,Default,,0,0,0,,Ах
Dialogue: 0,0:07:50.32,0:07:53.41,Default,,0,0,0,,Ақыр соңында, мен сізге ергенім дұрыс болды.
Dialogue: 0,0:07:53.53,0:07:58.37,Default,,0,0,0,,Тіпті нөлдік хаостан да асып түсетін мінсіз бос орын, алуан түрлендірулер
Dialogue: 0,0:07:58.49,0:08:02.08,Default,,0,0,0,,Жоғары мәртебелі Шнайзел, біз Қара рыцарлармен байланысқа шықтық.
Dialogue: 0,0:08:02.21,0:08:04.79,Default,,0,0,0,,Лелушты жеңу болса, біз қол ұстасамыз.
Dialogue: 0,0:08:04.92,0:08:06.54,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:06.67,0:08:09.34,Default,,0,0,0,,Лелуштың озбырлығын басынан өткерген адамдар...
Dialogue: 0,0:08:09.46,0:08:11.92,Default,,0,0,0,,Жақсырақ идеяларға жабысудан басқа амалымыз жоқ.
Dialogue: 0,0:08:12.13,0:08:15.68,Default,,0,0,0,,Сол себепті Лелуштың әрекетін елемей қалдыңыз ба?
Dialogue: 0,0:08:15.80,0:08:18.31,Default,,0,0,0,,Бұл ең аз зиян келтіретін әдіс.
Dialogue: 0,0:08:18.43,0:08:22.10,Default,,0,0,0,,Тіпті 1 миллиард немесе 2 миллиард адам өлсе де...
Dialogue: 0,0:08:22.23,0:08:23.48,Default,,0,0,0,,Тұрақты бейбітшілік
Dialogue: 0,0:08:23.60,0:08:26.94,Default,,0,0,0,,Жоқ! Мәжбүрлі бейбітшілік және т.б.
Dialogue: 0,0:08:29.73,0:08:30.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:36.03,0:08:38.16,Default,,0,0,0,,Өкінішті, Корнелия.
Dialogue: 0,0:08:42.08,0:08:43.91,Default,,0,0,0,,Токиодағы шешуші шайқас кезінде-
Dialogue: 0,0:08:44.04,0:08:48.34,Default,,0,0,0,,Шнайзел басқа қашу қайығын азғын ретінде пайдаланады.
Dialogue: 0,0:08:48.59,0:08:49.63,Default,,0,0,0,,Сонымен
Dialogue: 0,0:08:49.84,0:08:52.92,Default,,0,0,0,,Фрейджада жоғалып кеткен алаяқ болды ма?
Dialogue: 0,0:08:53.13,0:08:57.47,Default,,0,0,0,,Лелуш-саманы манипуляциялау үшін Нуналли-саманы қолдануға тырысу.
Dialogue: 0,0:08:58.01,0:08:59.81,Default,,0,0,0,,Сіз жапон болуыңыз керек.
Dialogue: 0,0:08:59.93,0:09:02.60,Default,,0,0,0,,Неліктен қара рыцарлар емес, лорд Лелуч?
Dialogue: 0,0:09:02.73,0:09:03.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:05.52,0:09:08.36,Default,,0,0,0,,Рыцарьлыққа өзіңізді құрбан етесіз бе?
Dialogue: 0,0:09:09.57,0:09:11.53,Default,,0,0,0,,Мүмкін солай.
Dialogue: 0,0:09:13.74,0:09:14.45,Default,,0,0,0,,Ах
Dialogue: 0,0:09:20.83,0:09:22.37,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:22.75,0:09:26.75,Default,,0,0,0,,Сіз Нуналлидің алдында маскаңызды жақсы киіп жүрдіңіз.
Dialogue: 0,0:09:26.87,0:09:30.42,Default,,0,0,0,,Қанша маршрутты қолдансам да, жауап бірдей болды.
Dialogue: 0,0:09:31.25,0:09:33.38,Default,,0,0,0,,Қорытындыда ол кезде қате болған жоқ.
Dialogue: 0,0:09:34.05,0:09:37.64,Default,,0,0,0,,Лелуш, бұл жеткілікті емес пе?
Dialogue: 0,0:09:37.76,0:09:39.18,Default,,0,0,0,,Сіз жақсы орындадыңыз.
Dialogue: 0,0:09:39.76,0:09:42.93,Default,,0,0,0,,Мен неге зұлымдық жасауым керек екенін білесің.
Dialogue: 0,0:09:43.06,0:09:47.44,Default,,0,0,0,,Сонымен қатар, Дамокл ережесі адам туралы символ ретінде.
Dialogue: 0,0:09:47.56,0:09:50.61,Default,,0,0,0,,Бірақ Дамоклдың Нуналли бар.
Dialogue: 0,0:09:52.61,0:09:54.94,Default,,0,0,0,,Осы уақытқа дейін сіз мұны Nunnally үшін жасап келдіңіз.
Dialogue: 0,0:09:55.07,0:09:58.03,Default,,0,0,0,,Арнайы күтім жоқ
Dialogue: 0,0:09:58.16,0:10:00.49,Default,,0,0,0,,Жоғалған көп өмір үшін...
Dialogue: 0,0:10:00.62,0:10:03.20,Default,,0,0,0,,Біз тоқтай алмаймыз
Dialogue: 0,0:10:03.33,0:10:04.87,Default,,0,0,0,,Менің ойымша, C.C.
Dialogue: 0,0:10:09.08,0:10:10.08,Default,,0,0,0,,О
Dialogue: 0,0:10:10.21,0:10:12.88,Default,,0,0,0,,Дұрыс, Лелуч.
Dialogue: 0,0:10:13.09,0:10:19.09,Default,,0,0,0,,♪～
Dialogue: 0,0:11:30.96,0:11:33.83,Default,,0,0,0,,Жарайды ма? Бірге күресу үшін
Dialogue: 0,0:11:33.96,0:11:36.55,Default,,0,0,0,,Мен Британияны өзімнің жауыма айналдырамын.
Dialogue: 0,0:11:36.88,0:11:38.05,Default,,0,0,0,,Қазір
Dialogue: 0,0:11:38.17,0:11:39.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:39.17,0:11:42.93,Default,,0,0,0,,Енді мен сіздің сезімдеріңізді аздап түсінгендей болдым.
Dialogue: 0,0:11:43.05,0:11:44.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:44.55,0:11:45.47,Default,,0,0,0,,Э-э-э—
Dialogue: 0,0:11:47.77,0:11:48.85,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:11:48.97,0:11:50.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:56.61,0:11:58.82,Default,,0,0,0,,) Қасиетті Британ империясы -
Dialogue: 0,0:11:58.94,0:12:03.03,Default,,0,0,0,,Император астанасы Пендрагонның жоғалуымен ішкі істер салданды.
Dialogue: 0,0:12:03.16,0:12:04.53,Default,,0,0,0,,Әр аймақтағы әскерлер-
Dialogue: 0,0:12:05.20,0:12:09.16,Default,,0,0,0,,Біз қара рыцарлармен бетпе-бет келіп отырмыз және біз қателесе алмаймыз.
Dialogue: 0,0:12:09.29,0:12:11.62,Default,,0,0,0,,) Басқаша айтқанда, бізбен соғыса алатын Лелуш әскері...
Dialogue: 0,0:12:12.08,0:12:14.29,Default,,0,0,0,,Жапонияны қайта басып алған бірліктер үшін ғана
Dialogue: 0,0:12:14.42,0:12:18.46,Default,,0,0,0,,Алайда бұл қуат балансы кез келген уақытта бұзылуы мүмкін.
Dialogue: 0,0:12:18.59,0:12:22.51,Default,,0,0,0,,Зақымдануды азайту үшін қазір шешуші шайқастың уақыты келді.
Dialogue: 0,0:12:23.13,0:12:25.55,Default,,0,0,0,,Енді Шнайзел бізге қосылды...
Dialogue: 0,0:12:25.68,0:12:28.18,Default,,0,0,0,,Біздің әскери күшіміз салыстырмалы.
Dialogue: 0,0:12:28.31,0:12:30.72,Default,,0,0,0,,Мен Дамоклдың Фрейяны пайдаланғанын мойындағым келмейді, бірақ...
Dialogue: 0,0:12:31.27,0:12:34.19,Default,,0,0,0,,Бұл жерде мен әлемді біріктіруге басымдық бергім келеді.
Dialogue: 0,0:12:34.31,0:12:35.31,Default,,0,0,0,,Бұл шайқас...
Dialogue: 0,0:12:35.44,0:12:39.07,Default,,0,0,0,,Бұл шайқас әлем үшін шешуші шайқас болады.
Dialogue: 0,0:12:39.53,0:12:44.53,Default,,0,0,0,,Егер мен Шнайзел мен Қара рыцарьларды жеңсем, менің жолыма бөгет болғандар жойылады.
Dialogue: 0,0:12:44.95,0:12:48.99,Default,,0,0,0,,Әлемді Британияның жалғыз императоры Лелуч қиратты...
Dialogue: 0,0:12:49.12,0:12:51.20,Default,,0,0,0,,Содан кейін ол жасалады
Dialogue: 0,0:12:51.54,0:12:55.17,Default,,0,0,0,,Жауды құрт, Шнайзел.
Dialogue: 0,0:12:55.29,0:12:57.46,Default,,0,0,0,,Аспан қамалы Дамокл
Dialogue: 0,0:12:58.13,0:13:02.84,Default,,0,0,0,,Қорықпа, болашақ менің атыммен.
Dialogue: 0,0:13:02.97,0:13:05.55,Default,,0,0,0,,Барлық Хайл Лелуш
Dialogue: 0,0:13:06.47,0:13:10.51,Default,,0,0,0,,Лелуш – дүние жүзіне арамдық тарататын тіршілік иесі.
Dialogue: 0,0:13:10.64,0:13:13.18,Default,,0,0,0,,Бейбітшілік жауларын осы жерде жеңу керек.
Dialogue: 0,0:13:13.60,0:13:15.14,Default,,0,0,0,,Өткеннің байланысын тастаңыз.
Dialogue: 0,0:13:15.27,0:13:19.36,Default,,0,0,0,,Біз де, Қара рыцарлар да осы жерде қол ұстасқымыз келеді.
Dialogue: 0,0:13:20.27,0:13:22.82,Default,,0,0,0,,Дүние жүзіндегі адамдар күтуде
Dialogue: 0,0:13:22.94,0:13:24.28,Default,,0,0,0,,Біздің салтанатты ән
Dialogue: 0,0:13:25.82,0:13:27.32,Default,,0,0,0,,Және үміттенемін -
Dialogue: 0,0:13:27.45,0:13:31.79,Default,,0,0,0,,Бұл адамзат үшін соңғы соғыс деп үміттенемін.
Dialogue: 0,0:13:34.29,0:13:35.21,Default,,0,0,0,,Лелуш
Dialogue: 0,0:13:37.42,0:13:40.50,Default,,0,0,0,,Екеуіңді жазып аламын.
Dialogue: 0,0:13:41.05,0:13:43.05,Default,,0,0,0,,Аня жақсы ма?
Dialogue: 0,0:13:43.17,0:13:45.92,Default,,0,0,0,,Мәртебелі есте сақтау қабілетін қалпына келтіретінін айтты.
Dialogue: 0,0:13:46.05,0:13:49.01,Default,,0,0,0,,Дәл қазір бізге барынша күш қажет, сондықтан
Dialogue: 0,0:13:49.01,0:13:49.97,Default,,0,0,0,,Дәл қазір бізге барынша күш қажет, сондықтан
Dialogue: 0,0:13:49.01,0:13:49.97,Default,,0,0,0,,(Коммуникатордың қоңырау үні)
Dialogue: 0,0:13:49.97,0:13:51.01,Default,,0,0,0,,(Коммуникатордың қоңырау үні)
Dialogue: 0,0:13:51.01,0:13:51.72,Default,,0,0,0,,(Коммуникатордың қоңырау үні)
Dialogue: 0,0:13:51.01,0:13:51.72,Default,,0,0,0,,О, арнаны аш
Dialogue: 0,0:13:51.72,0:13:53.72,Default,,0,0,0,,О, арнаны аш
Dialogue: 0,0:13:54.35,0:13:56.14,Default,,0,0,0,,Қайырлы күн Шнайзел
Dialogue: 0,0:13:56.31,0:13:57.31,Default,,0,0,0,,Әй
Dialogue: 0,0:13:58.40,0:14:01.73,Default,,0,0,0,,Лелуш, егер сен берілмек болсаң, қазір.
Dialogue: 0,0:14:01.90,0:14:04.32,Default,,0,0,0,,Фрейя осында дайын.
Dialogue: 0,0:14:04.78,0:14:08.32,Default,,0,0,0,,Фрейя? Мен сені атып аламын ба?
Dialogue: 0,0:14:08.53,0:14:12.58,Default,,0,0,0,,Менің Avalon флагманында Америка Құрама Штаттарының өкілдері бар.
Dialogue: 0,0:14:12.87,0:14:14.79,Default,,0,0,0,,Сіз кепілді қалқан ретінде пайдаланғыңыз келе ме?
Dialogue: 0,0:14:16.58,0:14:18.04,Default,,0,0,0,,Сіз соншалықты алысқа қалай барасыз?
Dialogue: 0,0:14:18.25,0:14:22.84,Default,,0,0,0,,Шнайзел Олар сізге қатысы жоқ болса да.
Dialogue: 0,0:14:22.96,0:14:26.42,Default,,0,0,0,,Дұрыс, Лелух, әлемде тыныштық және аз ғана өмір.
Dialogue: 0,0:14:26.55,0:14:27.55,Default,,0,0,0,,Шнайзелді атпа
Dialogue: 0,0:14:28.30,0:14:32.47,Default,,0,0,0,,Мен әрбір Құрама Штаттарда сайланған балама өкіл бар деп естідім.
Dialogue: 0,0:14:32.72,0:14:34.72,Default,,0,0,0,,Төтенше жағдайға дайын болыңыз
Dialogue: 0,0:14:34.85,0:14:38.48,Default,,0,0,0,,Бірақ бұл босқа кететін өмір жоқ дегенді білдірмейді.
Dialogue: 0,0:14:38.98,0:14:40.06,Default,,0,0,0,,Фухахаха
Dialogue: 0,0:14:41.44,0:14:42.27,Default,,0,0,0,,Рейсейки
Dialogue: 0,0:14:42.40,0:14:43.69,Default,,0,0,0,,Біздің әскери күшіміз -
Dialogue: 0,0:14:43.82,0:14:47.24,Default,,0,0,0,,Осы Дамоклдан басқа Мордред бір ғана.
Dialogue: 0,0:14:47.36,0:14:48.99,Default,,0,0,0,,Егер сіз Freya қолданбасаңыз...
Dialogue: 0,0:14:49.11,0:14:52.45,Default,,0,0,0,,Жалпы пәрменді осы жерде маған қалдырғаныңызды қалаймын.
Dialogue: 0,0:14:52.57,0:14:53.74,Default,,0,0,0,,Қарсылас – Лелуш
Dialogue: 0,0:14:54.24,0:14:55.91,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:14:56.04,0:15:00.21,Default,,0,0,0,,Мен Лелушка бір рет те жеңілген емеспін.
Dialogue: 0,0:15:00.33,0:15:01.96,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:02.46,0:15:03.42,Default,,0,0,0,,) Ах...
Dialogue: 0,0:15:03.88,0:15:05.13,Default,,0,0,0,,Шенфуды шығарыңыз
Dialogue: 0,0:15:05.25,0:15:07.05,Default,,0,0,0,,Басқару тізбегін барлық әскерлерге хабарлаңыз.
Dialogue: 0,0:15:07.17,0:15:07.88,Default,,0,0,0,,Иә
Dialogue: 0,0:15:08.26,0:15:10.30,Default,,0,0,0,,Енді сәйкес келетін қолдарға көшейік.
Dialogue: 0,0:15:10.43,0:15:11.47,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:15:12.76,0:15:14.81,Default,,0,0,0,,Canon Сіз оқығанда
Dialogue: 0,0:15:14.93,0:15:18.14,Default,,0,0,0,,Иә, Қара рыцарьлар енді Мәртебелінің қолдары мен аяғы.
Dialogue: 0,0:15:18.27,0:15:21.35,Default,,0,0,0,,Ха, бүкіл армияға Sigma үлгісі туралы айтыңыз.
Dialogue: 0,0:15:23.69,0:15:27.36,Default,,0,0,0,,Жау әскерлері әуе күштерін кең аумаққа орналастыруды жоспарлап отыр.
Dialogue: 0,0:15:27.61,0:15:29.45,Default,,0,0,0,,Бұл қалыпты шайқаста келе ме?
Dialogue: 0,0:15:29.57,0:15:33.62,Default,,0,0,0,,Жарайды, сол қанатыңызды созып, жарты ай Архат лагерін орнатыңыз.
Dialogue: 0,0:15:33.74,0:15:35.20,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:15:38.37,0:15:39.91,Default,,0,0,0,,Жаудың негізгі базасы әлсіз.
Dialogue: 0,0:15:40.12,0:15:41.83,Default,,0,0,0,,Джино әскерлері алға жылжуда
Dialogue: 0,0:15:42.12,0:15:44.33,Default,,0,0,0,,Қарсыластың сол қанаты созылған жерді ұстаңыз.
Dialogue: 0,0:15:44.46,0:15:45.75,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:15:47.75,0:15:49.34,Default,,0,0,0,,Тексеру?
Dialogue: 0,0:15:49.47,0:15:51.01,Default,,0,0,0,,Сол қанатыңызды артқа жылжытыңыз.
Dialogue: 0,0:15:51.47,0:15:53.09,Default,,0,0,0,,Сонда түзілім құлайды.
Dialogue: 0,0:15:53.22,0:15:53.93,Default,,0,0,0,,Жақсы
Dialogue: 0,0:15:55.93,0:15:57.76,Default,,0,0,0,,Джино алдын ала тоқтайды
Dialogue: 0,0:15:58.06,0:16:00.64,Default,,0,0,0,,Неліктен? Енді формация құлады
Dialogue: 0,0:16:00.77,0:16:02.02,Default,,0,0,0,,Бұл шақыру.
Dialogue: 0,0:16:02.31,0:16:03.69,Default,,0,0,0,,Ешқашан мінбеңіз
Dialogue: 0,0:16:03.90,0:16:05.81,Default,,0,0,0,,Жалықтыңыз ба?
Dialogue: 0,0:16:05.94,0:16:08.11,Default,,0,0,0,,Құрылымды Үлкен Аю түзілуіне өзгерту
Dialogue: 0,0:16:11.32,0:16:14.82,Default,,0,0,0,,6-шы отряд солтүстік-шығысқа қарай Аняның ортасында, биіктік бұрышы 40 градус.
Dialogue: 0,0:16:16.49,0:16:18.54,Default,,0,0,0,,Артиллериялық бөлімше зениттік жауынгерлік дайындық
Dialogue: 0,0:16:18.79,0:16:21.71,Default,,0,0,0,,Аня Сол жерде тоқта, 200 метрге көтеріл.
Dialogue: 0,0:16:23.58,0:16:25.79,Default,,0,0,0,,Не? Бұл мүлдем ұрыс емес.
Dialogue: 0,0:16:25.92,0:16:29.84,Default,,0,0,0,,Жоқ, шеберлер арасындағы шайқас әп-сәтте шешілетіні сияқты...
Dialogue: 0,0:16:30.17,0:16:32.84,Default,,0,0,0,,Екеуміздің арамыздан көрінбейтін шабуыл өтіп жатыр.
Dialogue: 0,0:16:38.60,0:16:42.06,Default,,0,0,0,,Асықпасақ шайқас басталып кетті.
Dialogue: 0,0:16:44.44,0:16:45.73,Default,,0,0,0,,Қоршау
Dialogue: 0,0:16:45.85,0:16:46.56,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:16:46.69,0:16:49.94,Default,,0,0,0,,Қарсы шабуыл. Созаку Ланселотын алға қарай итеріңіз.
Dialogue: 0,0:16:50.44,0:16:53.36,Default,,0,0,0,,4-ші ұрыс жылдамдығы жақсы. Бөлімше отряды да жалғастыруда.
Dialogue: 0,0:16:53.99,0:16:58.70,Default,,0,0,0,,Бұл өзгерген жоқ, Лелуш. Сізге қорғаныстан гөрі шабуыл ұнады.
Dialogue: 0,0:16:59.08,0:17:00.79,Default,,0,0,0,,Сондықтан шамалы бос орын бар
Dialogue: 0,0:17:01.33,0:17:02.41,Default,,0,0,0,,Жұлдызша ою
Dialogue: 0,0:17:02.54,0:17:03.41,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:17:03.54,0:17:05.79,Default,,0,0,0,,Біздің шеберлік деңгейіміз қосылды ма?
Dialogue: 0,0:17:05.92,0:17:07.63,Default,,0,0,0,,Жаудың сол қанаты алға жылжуда
Dialogue: 0,0:17:09.75,0:17:12.38,Default,,0,0,0,,Ешқандай болмаңыз! Мен ұлы мәртебелі үмітті ақтаймын.
Dialogue: 0,0:17:16.89,0:17:20.31,Default,,0,0,0,,Лелучты жеңсек, бәрі бітеді!
Dialogue: 0,0:17:25.02,0:17:27.73,Default,,0,0,0,,Егер біз осы жерден өтіп, оны ұрысқа апарсақ
Dialogue: 0,0:17:33.15,0:17:34.70,Default,,0,0,0,,Уф, ол бұзылды.
Dialogue: 0,0:17:36.24,0:17:37.66,Default,,0,0,0,,Ол жыртыла ма?
Dialogue: 0,0:17:38.03,0:17:39.70,Default,,0,0,0,,Сузаку-кунды қайтарғыңыз келе ме?
Dialogue: 0,0:17:39.83,0:17:41.99,Default,,0,0,0,,Жоқ, бұл Шнайзелдің мақсаты.
Dialogue: 0,0:17:42.41,0:17:44.83,Default,,0,0,0,,Ұрыс шебін төмендетіңіз, құрамды қалпына келтіріңіз
Dialogue: 0,0:17:45.37,0:17:46.92,Default,,0,0,0,,Жау флоты шегініп жатыр.
Dialogue: 0,0:17:49.08,0:17:50.13,Default,,0,0,0,,Бұл мүмкіндікті жіберіп алмаңыз!
Dialogue: 0,0:17:50.25,0:17:51.09,Default,,0,0,0,,Іздеу!
Dialogue: 0,0:17:53.30,0:17:54.38,Default,,0,0,0,,(Өкілдердің айқайы)
Dialogue: 0,0:17:54.51,0:17:56.30,Default,,0,0,0,,) ха ха ха
Dialogue: 0,0:17:57.09,0:18:00.26,Default,,0,0,0,,Гурен тым алда. Сапқа тұрыңыз және оны қоршаңыз.
Dialogue: 0,0:18:00.55,0:18:02.60,Default,,0,0,0,,Мен білемін, бірақ!
Dialogue: 0,0:18:03.52,0:18:07.48,Default,,0,0,0,,Асықпаңыз. Егер сіз авангардты жеңсеңіз, Авалон оқшауланады.
Dialogue: 0,0:18:09.23,0:18:11.32,Default,,0,0,0,,Дреднота батып кету жеңіледі!
Dialogue: 0,0:18:11.57,0:18:15.82,Default,,0,0,0,,Қара рыцарьлар күресуге өте қиын қарсылас болды.
Dialogue: 0,0:18:15.94,0:18:18.24,Default,,0,0,0,,Бірақ біздің жауынгерлер
Dialogue: 0,0:18:18.41,0:18:20.70,Default,,0,0,0,,Мәртебелі императорға!
Dialogue: 0,0:18:24.62,0:18:28.62,Default,,0,0,0,,Қандай өкінішті, солдат Геастың бақылауында болды.
Dialogue: 0,0:18:28.75,0:18:29.37,Default,,0,0,0,,Сондықтан!
Dialogue: 0,0:18:32.46,0:18:34.76,Default,,0,0,0,,Бәлкім, дәл қазір, екі қанат сындырайық.
Dialogue: 0,0:18:35.17,0:18:37.13,Default,,0,0,0,,) Садақ диффузиялық адрон ауыр зеңбірек жинағы
Dialogue: 0,0:18:37.63,0:18:39.34,Default,,0,0,0,,7-бөлім Ату бұрышынан тыс жылжытыңыз
Dialogue: 0,0:18:39.47,0:18:41.93,Default,,0,0,0,,Gefion басқару синхрондауы OK (Minase) OK.
Dialogue: 0,0:18:42.18,0:18:44.60,Default,,0,0,0,,Жаудың екі қанатына қарай ату
Dialogue: 0,0:18:48.14,0:18:52.02,Default,,0,0,0,,Нөл Егер бәріміз күшімізді біріктірсек, біз сізді жеңе аламыз!
Dialogue: 0,0:18:53.65,0:18:57.49,Default,,0,0,0,,Лелуш Қара рыцарларды бағаламаған сияқты.
Dialogue: 0,0:18:57.78,0:18:58.49,Default,,0,0,0,,Лелуш
Dialogue: 0,0:18:58.61,0:19:02.70,Default,,0,0,0,,Аа, сіз күткендей, маған осы тактиканы қолдануға рұқсат етіңіз.
Dialogue: 0,0:19:08.58,0:19:09.21,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:09.33,0:19:11.00,Default,,0,0,0,,Энергетикалық реакция Төменнен!
Dialogue: 0,0:19:11.12,0:19:14.29,Default,,0,0,0,,Не! Бұл уақытта мүмкін емес
Dialogue: 0,0:19:15.80,0:19:18.92,Default,,0,0,0,,Барлық күштер сәулелік тосқауыл қояды!
Dialogue: 0,0:19:19.59,0:19:21.05,Default,,0,0,0,,Ахххххх
Dialogue: 0,0:19:21.18,0:19:21.84,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:19:26.72,0:19:31.19,Default,,0,0,0,,Мен бірінші болып Нөл мен Лелушты таныдым.
Dialogue: 0,0:19:31.31,0:19:33.44,Default,,0,0,0,,Сондықтан менің жауапкершілігім бар
Dialogue: 0,0:19:33.69,0:19:37.48,Default,,0,0,0,,Бірақ мен жаңа өмірге араласқым келмейді.
Dialogue: 0,0:19:37.61,0:19:40.24,Default,,0,0,0,,Мен бұл өзімшіл өтініш екенін білемін.
Dialogue: 0,0:19:40.36,0:19:43.62,Default,,0,0,0,,Бірақ мен сенің Хорай аралында қалғаныңды қалаймын.
Dialogue: 0,0:19:45.74,0:19:49.71,Default,,0,0,0,,Уги-сан! Өтінемін жауап беріңіз! Минами мырза! Ракшата мырза!
Dialogue: 0,0:19:53.25,0:19:54.92,Default,,0,0,0,,Сен әлі күнге дейін қылмыскерлердің өлтіріліп жатқанын Цукиге айтпағансың ба?
Dialogue: 0,0:19:55.04,0:19:57.25,Default,,0,0,0,,Сакурадит жер асты ресурсын пайдалану...
Dialogue: 0,0:19:58.26,0:19:59.17,Default,,0,0,0,,Енді...
Dialogue: 0,0:19:59.55,0:20:02.09,Default,,0,0,0,,Лелуштың құрлықтағы әскерлері жойылды.
Dialogue: 0,0:20:02.72,0:20:04.05,Default,,0,0,0,,Ұсқынсыз
Dialogue: 0,0:20:04.72,0:20:09.77,Default,,0,0,0,,Лелуштың негізгі стратегиясы өзінің одақтастарын құрбан ету болды.
Dialogue: 0,0:20:12.14,0:20:15.90,Default,,0,0,0,,Енді жаудың күші азайды, енді Дамоклға келді...
Dialogue: 0,0:20:16.15,0:20:17.02,Default,,0,0,0,,Жай түртіңіз!
Dialogue: 0,0:20:18.73,0:20:22.61,Default,,0,0,0,,Өкінішке орай, сіз тексерілген адам болдыңыз.
Dialogue: 0,0:20:23.36,0:20:25.70,Default,,0,0,0,,Нунналда көрікті жерлер белгіленді.
Dialogue: 0,0:20:25.82,0:20:29.54,Default,,0,0,0,,Енді Фрейяның күшімен Қара рыцарьлар келді
Dialogue: 0,0:20:29.70,0:20:31.58,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:20:32.91,0:20:34.37,Default,,0,0,0,,Уф
Dialogue: 0,0:20:34.50,0:20:38.38,Default,,0,0,0,,Мен сенің ағаңның күнәсі үшін кек аламын.
Dialogue: 0,0:20:40.46,0:20:41.97,Default,,0,0,0,,Міне, мен Фрейя!
Dialogue: 0,0:20:42.09,0:20:44.72,Default,,0,0,0,,Сіз осында аттыңыз ба? 3-ші арнайы дивизия
Dialogue: 0,0:20:45.01,0:20:46.64,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:20:47.76,0:20:49.68,Default,,0,0,0,,Пайдасы жоқ, мына Фрейя...
Dialogue: 0,0:20:49.81,0:20:53.06,Default,,0,0,0,,Дамоклдан шығарылған кезде ол критикалық күйде болады
Dialogue: 0,0:20:56.06,0:20:57.69,Default,,0,0,0,,Авалон шегінуді жалғастыруда
Dialogue: 0,0:20:57.81,0:21:01.44,Default,,0,0,0,,Әрбір бөлімше Дамоклді зарядтап, Фрейджаны атуды жалғастырады.
Dialogue: 0,0:21:01.57,0:21:02.90,Default,,0,0,0,,Оқ таусылды
Dialogue: 0,0:21:11.04,0:21:12.70,Default,,0,0,0,,Желдеткіш! Жанкүйер!
Dialogue: 0,0:21:12.83,0:21:14.33,Default,,0,0,0,,Оуги-сан!
Dialogue: 0,0:21:14.46,0:21:16.50,Default,,0,0,0,,Өлгендей кейіп танытсаңыз!
Dialogue: 0,0:21:16.63,0:21:19.63,Default,,0,0,0,,Жарайды, болмайды, балалар қалқан боласыңдар.
Dialogue: 0,0:21:19.92,0:21:23.47,Default,,0,0,0,,Хехехе, мен тек көпірді қорғай алдым.
Dialogue: 0,0:21:23.59,0:21:26.09,Default,,0,0,0,,Ал, қалғанын өз бетіңізше жасай аласыз.
Dialogue: 0,0:21:26.22,0:21:27.93,Default,,0,0,0,,Кеттік! Карен!
Dialogue: 0,0:21:28.05,0:21:30.51,Default,,0,0,0,,Сіз немен мақтанасыз?
Dialogue: 0,0:21:30.81,0:21:33.98,Default,,0,0,0,,Tch, енді мен Фудзидің стратегиясын қолдандым...
Dialogue: 0,0:21:34.10,0:21:38.10,Default,,0,0,0,,Егер сіз Фрейяның қалған оқтарынан есептесеңіз, сіз кемшілікте боласыз.
Dialogue: 0,0:21:38.23,0:21:39.23,Default,,0,0,0,,Егер...
Dialogue: 0,0:21:39.36,0:21:43.03,Default,,0,0,0,,Нинаға сенуден басқа амалым жоқ, бірақ мен оған сене аламын ба...
Dialogue: 0,0:21:43.15,0:21:45.24,Default,,0,0,0,,Сіз мені жек көруіңіз керек
Dialogue: 0,0:21:45.82,0:21:48.91,Default,,0,0,0,,Юффидің жауы, Нөл болған мен
Dialogue: 0,0:21:49.32,0:21:52.08,Default,,0,0,0,,Бірақ Шнайзелді жеңу үшін...
Dialogue: 0,0:21:52.95,0:21:57.04,Default,,0,0,0,,Лелуш Егер сіз мені жеңуді ойласаңыз...
Dialogue: 0,0:21:57.17,0:21:59.17,Default,,0,0,0,,Бұл сізге арналған.
Dialogue: 0,0:21:59.29,0:22:02.92,Default,,0,0,0,,Масканы меңгере алмағанның жеңісі жоқ.
Dialogue: 0,0:22:03.34,0:22:06.93,Default,,0,0,0,,♪～
Dialogue: 0,0:22:07.05,0:22:10.47,Default,,0,0,0,,♪Дүние жын, әділдік деген не?
Dialogue: 0,0:22:10.60,0:22:14.43,Default,,0,0,0,,♪Сұрамай тұрып, қарсылық көрсет, жамандық гүлі
Dialogue: 0,0:22:14.56,0:22:17.85,Default,,0,0,0,,♪Екіжүзділіктің арманшыл көздерін бақылаңыз
Dialogue: 0,0:22:17.98,0:22:21.98,Default,,0,0,0,,♪Өмір мен зұлымдықтың арасы жоқ.
Dialogue: 0,0:22:25.40,0:22:28.91,Default,,0,0,0,,♪Жарық ұрық сияқты жоғалады
Dialogue: 0,0:22:29.03,0:22:32.87,Default,,0,0,0,,♪Ұйқыдағы қараңғылық құрсағынсың
Dialogue: 0,0:22:32.99,0:22:36.33,Default,,0,0,0,,♪Жалғыздық сүйкімді
Dialogue: 0,0:22:36.45,0:22:40.04,Default,,0,0,0,,♪Ол сенің жалғыз одақтасың болады
Dialogue: 0,0:22:40.17,0:22:43.71,Default,,0,0,0,,♪Бәрі қанға боялған
Dialogue: 0,0:22:43.84,0:22:47.63,Default,,0,0,0,,♪ Осы дәуірде дүниеге келген
Dialogue: 0,0:22:47.76,0:22:54.56,Default,,0,0,0,,♪Таңдаулы ханзадалар, шайқас – береке
Dialogue: 0,0:22:54.89,0:22:59.39,Default,,0,0,0,,♪Ах, мен сұлумын, бәрін білемін.
Dialogue: 0,0:22:59.52,0:23:03.11,Default,,0,0,0,,♪Сүйікті ана сені дүниеге әкеледі
Dialogue: 0,0:23:03.23,0:23:05.86,Default,,0,0,0,,♪Бұл сүт немен қоректенеді?
Dialogue: 0,0:23:05.98,0:23:09.65,Default,,0,0,0,,♪Тозақтағы бауырлар
Dialogue: 0,0:23:10.82,0:23:14.12,Default,,0,0,0,,♪Аянның белгісі Ақиқат дегеніміз не?
Dialogue: 0,0:23:14.24,0:23:18.12,Default,,0,0,0,,♪Белгісіз және көмілген, жасырылған тұқымдар
Dialogue: 0,0:23:18.25,0:23:21.58,Default,,0,0,0,,♪Қос жүзді қылыш, жүзді суырып алғаныңызға қаратыңыз
Dialogue: 0,0:23:21.71,0:23:25.30,Default,,0,0,0,,♪Қорғау керек нәрсеге ғана сеніңіз
Dialogue: 0,0:23:25.42,0:23:32.43,Default,,0,0,0,,♪Өзіңіз қандай болсаңыз, солай болыңыз.
Dialogue: 0,0:23:37.68,0:23:38.85,Default,,0,0,0,,Мен және Созаку
Dialogue: 0,0:23:38.98,0:23:41.31,Default,,0,0,0,,Егер екі адам қол ұстасып отырса, мүмкін емес ештеңе жоқ.
Dialogue: 0,0:23:41.44,0:23:42.48,Default,,0,0,0,,Бұл болуы керек еді
Dialogue: 0,0:23:42.60,0:23:45.65,Default,,0,0,0,,Бірақ Фрейя басқаратын ұрыс даласында...
Dialogue: 0,0:23:45.77,0:23:48.28,Default,,0,0,0,,Тактика енді жұмыс істемейді ме?
Dialogue: 0,0:23:48.40,0:23:49.36,Default,,0,0,0,,Соңғы ставка –
Dialogue: 0,0:23:49.65,0:23:51.11,Default,,0,0,0,,Карточка...
Dialogue: 0,0:23:52.61,0:23:58.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory