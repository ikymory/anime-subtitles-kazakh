Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.02,0:00:04.65,Default,,0,0,0,,Ах
Dialogue: 0,0:00:04.77,0:00:05.65,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:00:05.77,0:00:06.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:06.61,0:00:08.69,Default,,0,0,0,,Тым ерте тұру
Dialogue: 0,0:00:08.82,0:00:09.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:10.48,0:00:11.40,Default,,0,0,0,,C.C.
Dialogue: 0,0:00:11.65,0:00:13.82,Default,,0,0,0,,Сіз не істеп жатырсыз? Осындай жерде
Dialogue: 0,0:00:13.95,0:00:16.41,Default,,0,0,0,,Ол Чарльзға көмектесетін сияқты емес.
Dialogue: 0,0:00:16.53,0:00:19.08,Default,,0,0,0,,А Аня? Сіз...
Dialogue: 0,0:00:19.24,0:00:20.70,Default,,0,0,0,,Марианна қазір
Dialogue: 0,0:00:20.83,0:00:22.75,Default,,0,0,0,,Лелуш пен Нанналлидің анасы.
Dialogue: 0,0:00:26.33,0:00:30.88,Default,,0,0,0,,♪Дүниенің ақырында туған нұр
Dialogue: 0,0:00:31.01,0:00:36.55,Default,,0,0,0,,♪ Қазір желде
Dialogue: 0,0:00:52.44,0:00:57.41,Default,,0,0,0,,♪Сұлу болу арқылы өмір сүре алмайсың
Dialogue: 0,0:00:57.78,0:01:03.12,Default,,0,0,0,,♪Мейірімділік жалғыз емдей алмайды
Dialogue: 0,0:01:03.25,0:01:05.96,Default,,0,0,0,,♪Не ұрланды?
Dialogue: 0,0:01:06.08,0:01:08.21,Default,,0,0,0,,♪Өзгермейтін әлемде
Dialogue: 0,0:01:08.67,0:01:11.30,Default,,0,0,0,,♪Сіз не естідіңіз?
Dialogue: 0,0:01:11.42,0:01:14.55,Default,,0,0,0,,♪Түстер әні
Dialogue: 0,0:01:14.67,0:01:19.55,Default,,0,0,0,,♪Бәрі жарық
Dialogue: 0,0:01:20.39,0:01:23.02,Default,,0,0,0,,♪Тасылған армандар
Dialogue: 0,0:01:23.14,0:01:29.56,Default,,0,0,0,,♪Ертеңгі күннің соңында жаңғырық
Dialogue: 0,0:01:31.19,0:01:35.65,Default,,0,0,0,,♪Дүниенің ақырында туған нұр
Dialogue: 0,0:01:35.78,0:01:40.32,Default,,0,0,0,,♪Біз бірміз
Dialogue: 0,0:01:41.20,0:01:46.83,Default,,0,0,0,,♪ Енді желде
Dialogue: 0,0:02:01.10,0:02:02.18,Default,,0,0,0,,) О
Dialogue: 0,0:02:02.60,0:02:06.48,Default,,0,0,0,,Мен Кагура-сама мен Синку бас қолбасшысына жағдайды түсіндіремін.
Dialogue: 0,0:02:06.60,0:02:09.10,Default,,0,0,0,,Түсінетіндеріңді білмеймін, бірақ
Dialogue: 0,0:02:09.52,0:02:11.11,Default,,0,0,0,,Бір нәрсе анық...
Dialogue: 0,0:02:11.31,0:02:13.69,Default,,0,0,0,,Мен білемін, Нөл...
Dialogue: 0,0:02:13.82,0:02:15.65,Default,,0,0,0,,Мен енді өмір сүре алмаймын деп ойлаймын.
Dialogue: 0,0:02:16.69,0:02:19.57,Default,,0,0,0,,Мен Лелушпен тексеруім керек.
Dialogue: 0,0:02:20.20,0:02:22.12,Default,,0,0,0,,Әйтпесе мен...
Dialogue: 0,0:02:22.70,0:02:24.54,Default,,0,0,0,,Мен енді алға жылжи алмаймын.
Dialogue: 0,0:02:25.12,0:02:27.71,Default,,0,0,0,,Келіңіздер, уақыт көп.
Dialogue: 0,0:02:28.25,0:02:32.00,Default,,0,0,0,,Маған жауап берші: Менің анамды кім өлтірді?
Dialogue: 0,0:02:32.13,0:02:34.25,Default,,0,0,0,,Анаңды неге қорғамадың?
Dialogue: 0,0:02:34.38,0:02:36.30,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:02:36.42,0:02:38.76,Default,,0,0,0,,Сіз шындықты басқалардан іздейсіз бе?
Dialogue: 0,0:02:38.88,0:02:41.43,Default,,0,0,0,,Сіз маған осы уақытқа дейін өтіріктен басқа ештеңе айтпадыңыз.
Dialogue: 0,0:02:41.55,0:02:42.89,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:02:43.01,0:02:45.26,Default,,0,0,0,,Мен өтірік айттым
Dialogue: 0,0:02:45.39,0:02:49.35,Default,,0,0,0,,Барлығын жасырыңыз, тек атыңыз бен мансабыңызды ғана емес, тіпті шынайы сезімдеріңізді де жасырыңыз.
Dialogue: 0,0:02:49.81,0:02:51.85,Default,,0,0,0,,Бірақ бұл анық
Dialogue: 0,0:02:51.98,0:02:54.15,Default,,0,0,0,,Басқалармен сөйлесу -
Dialogue: 0,0:02:54.27,0:02:55.52,Default,,0,0,0,,Сахнаға араласыңыз
Dialogue: 0,0:02:55.65,0:02:57.90,Default,,0,0,0,,Оларсыз ел де, ұлт та болмас еді.
Dialogue: 0,0:02:58.03,0:03:00.78,Default,,0,0,0,,Қауымдастық деген ұғым жоқ.
Dialogue: 0,0:03:00.90,0:03:03.24,Default,,0,0,0,,Өтірік айтуды бәрі біледі
Dialogue: 0,0:03:03.37,0:03:07.54,Default,,0,0,0,,Отбасы, достар, қоғам алдында...
Dialogue: 0,0:03:07.95,0:03:10.37,Default,,0,0,0,,Әркім әртүрлі көрінеді
Dialogue: 0,0:03:10.50,0:03:13.17,Default,,0,0,0,,Бірақ бұл күнә ма?
Dialogue: 0,0:03:13.29,0:03:15.13,Default,,0,0,0,,Нағыз бет дегеніміз не?
Dialogue: 0,0:03:15.25,0:03:18.80,Default,,0,0,0,,Тіпті сіз императордың маскасын киіп жүрсіз.
Dialogue: 0,0:03:18.92,0:03:21.80,Default,,0,0,0,,Біз енді тұлғаларсыз жүре алмаймыз.
Dialogue: 0,0:03:21.93,0:03:22.97,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:03:23.09,0:03:23.72,Default,,0,0,0,,Хмм?
Dialogue: 0,0:03:26.22,0:03:30.52,Default,,0,0,0,,Өтірік айтудың мәңгілік пайдасыз екенін түсінгенде...
Dialogue: 0,0:03:31.02,0:03:32.56,Default,,0,0,0,,Тұлға жоғалады
Dialogue: 0,0:03:32.69,0:03:36.98,Default,,0,0,0,,Бір-бірімізді түсінетін болсақ, ешқандай дау-дамай болмайды.
Dialogue: 0,0:03:37.11,0:03:39.61,Default,,0,0,0,,Бұл метафизикалық теория.
Dialogue: 0,0:03:39.74,0:03:41.24,Default,,0,0,0,,Жақында шындыққа айналады
Dialogue: 0,0:03:41.36,0:03:41.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:42.36,0:03:45.70,Default,,0,0,0,,Бұл менің Рагнарекімнің байланысы.
Dialogue: 0,0:03:45.82,0:03:50.66,Default,,0,0,0,,Дүние алдаудың бетпердесін шешіп, шындықты ашады.
Dialogue: 0,0:03:50.79,0:03:52.16,Default,,0,0,0,,（）
Dialogue: 0,0:03:52.29,0:03:53.50,Default,,0,0,0,,С әлемі?
Dialogue: 0,0:03:53.62,0:03:56.67,Default,,0,0,0,,Бар терминдермен айтқанда, ұжымдық бейсаналық
Dialogue: 0,0:03:56.79,0:03:59.25,Default,,0,0,0,,Адамның жүрегі мен естеліктерінің жинағы
Dialogue: 0,0:03:59.38,0:04:02.38,Default,,0,0,0,,Реинкарнация теңізі, Ұлы ерік
Dialogue: 0,0:04:02.51,0:04:04.01,Default,,0,0,0,,Кейбіреулер оны Құдай деп атайды
Dialogue: 0,0:04:04.93,0:04:06.43,Default,,0,0,0,,Мен сені Наритада кездестіргенімде
Dialogue: 0,0:04:06.64,0:04:09.18,Default,,0,0,0,,Яғни жеке санамен араласады.
Dialogue: 0,0:04:09.31,0:04:12.68,Default,,0,0,0,,Бірақ мен сенің не көргеніңді білмеймін.
Dialogue: 0,0:04:12.81,0:04:13.85,Default,,0,0,0,,Бұл жауапсыздық.
Dialogue: 0,0:04:13.98,0:04:15.94,Default,,0,0,0,,Сізге қарап тұрған ұнайды ма?
Dialogue: 0,0:04:16.06,0:04:16.73,Default,,0,0,0,,Ах кутсу
Dialogue: 0,0:04:16.86,0:04:20.07,Default,,0,0,0,,Адамдар - ұжымдық бейсаналық киетін маскалар.
Dialogue: 0,0:04:20.19,0:04:23.11,Default,,0,0,0,,Жүрек пен жад теңізіне ашылған терезе
Dialogue: 0,0:04:23.53,0:04:24.74,Default,,0,0,0,,Адамның жүрегі
Dialogue: 0,0:04:24.86,0:04:27.57,Default,,0,0,0,,Жоқ, егер бұл бұзылса.
Dialogue: 0,0:04:27.70,0:04:28.87,Default,,0,0,0,,Өтінемін, C.C.
Dialogue: 0,0:04:28.99,0:04:30.20,Default,,0,0,0,,Сіз шынымен барасыз ба?
Dialogue: 0,0:04:30.70,0:04:31.91,Default,,0,0,0,,Мені есіңде бар ғой, иә?
Dialogue: 0,0:04:32.04,0:04:34.46,Default,,0,0,0,,Чарльз бізді күтіп тұр.
Dialogue: 0,0:04:34.58,0:04:38.38,Default,,0,0,0,,Егер сіз оған кодты берсеңіз, оңайырақ болар еді.
Dialogue: 0,0:04:39.67,0:04:42.09,Default,,0,0,0,,Мен қазірдің өзінде бара жатырмын.
Dialogue: 0,0:04:46.26,0:04:46.93,Default,,0,0,0,,Ах
Dialogue: 0,0:04:49.43,0:04:51.27,Default,,0,0,0,,Қауіпке барма.
Dialogue: 0,0:04:55.35,0:04:57.15,Default,,0,0,0,,Сузаку Куруруги
Dialogue: 0,0:04:57.27,0:04:59.69,Default,,0,0,0,,Сен екеуміз ұқсаспыз.
Dialogue: 0,0:04:59.82,0:05:01.23,Default,,0,0,0,,Олар ұқсас па?
Dialogue: 0,0:05:01.36,0:05:04.15,Default,,0,0,0,,Менің өлгісі келетін, бірақ өле алмайтын бір бөлігім бар.
Dialogue: 0,0:05:05.78,0:05:06.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:06.78,0:05:08.20,Default,,0,0,0,,Жоғары мәртебелі Шнайзелмен-
Dialogue: 0,0:05:08.32,0:05:09.87,Default,,0,0,0,,Қара рыцарьлар?
Dialogue: 0,0:05:10.37,0:05:11.79,Default,,0,0,0,,Тірі бол, Лелуч.
Dialogue: 0,0:05:12.29,0:05:14.62,Default,,0,0,0,,Мен сізден әлі бір нәрсе сұрағым келеді.
Dialogue: 0,0:05:15.91,0:05:18.25,Default,,0,0,0,,Демек, сен болған болашаққа қайта орала алмаймын дегің келе ме?
Dialogue: 0,0:05:18.38,0:05:20.42,Default,,0,0,0,,Сен есейдің, Лелуч.
Dialogue: 0,0:05:20.63,0:05:22.80,Default,,0,0,0,,немесе анасы
Dialogue: 0,0:05:22.92,0:05:24.92,Default,,0,0,0,,Сен осындасың ба, Марианна?
Dialogue: 0,0:05:25.05,0:05:27.47,Default,,0,0,0,,Бұл да елес пе? Осындай нәрсе жасаңыз
Dialogue: 0,0:05:27.59,0:05:30.26,Default,,0,0,0,,Бұл шын болса да.
Dialogue: 0,0:05:30.39,0:05:34.68,Default,,0,0,0,,Осы жүйемен ғана бастапқы пішінге оралуға болады.
Dialogue: 0,0:05:34.81,0:05:35.93,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:05:36.06,0:05:39.27,Default,,0,0,0,,Лелуш, алдыңғы сұраққа жауап берейік.
Dialogue: 0,0:05:39.40,0:05:40.19,Default,,0,0,0,,Құт
Dialogue: 0,0:05:41.40,0:05:46.24,Default,,0,0,0,,Жарты ғасырдай бұрын ағам екеуміз тозақта болдық.
Dialogue: 0,0:05:46.36,0:05:49.57,Default,,0,0,0,,Барлық туыстар таққа таласатын бақталастар
Dialogue: 0,0:05:49.70,0:05:54.49,Default,,0,0,0,,Қастандық қалыпты жағдайға айналды; өтірік арқылы сатқындық күндері
Dialogue: 0,0:05:54.62,0:05:56.12,Default,,0,0,0,,Барлығы қайтыс болды.
Dialogue: 0,0:05:56.66,0:05:58.79,Default,,0,0,0,,Менің анам да соның құрбаны болды.
Dialogue: 0,0:05:59.46,0:06:02.46,Default,,0,0,0,,Ағам екеуміз дүниені жек көреміз, қайғымыз.
Dialogue: 0,0:06:02.59,0:06:04.71,Default,,0,0,0,,Және ант берді
Dialogue: 0,0:06:04.88,0:06:07.09,Default,,0,0,0,,Өтіріксіз әлем құруға тырысу
Dialogue: 0,0:06:07.22,0:06:10.34,Default,,0,0,0,,Екеуі де C.C. және мен ант беруге келістім.
Dialogue: 0,0:06:10.47,0:06:11.93,Default,,0,0,0,,Бірақ В.В.
Dialogue: 0,0:06:13.18,0:06:15.10,Default,,0,0,0,,Бұл не? Шұғыл бизнес үшін
Dialogue: 0,0:06:15.60,0:06:19.39,Default,,0,0,0,,Мен адамдарға төледім, Корнелияны да түсірдім.
Dialogue: 0,0:06:19.52,0:06:22.19,Default,,0,0,0,,Кешіріңіз, Чарльз бұл жерде емес.
Dialogue: 0,0:06:22.31,0:06:24.11,Default,,0,0,0,,Акашаның қылышына қатысты
Dialogue: 0,0:06:24.23,0:06:27.44,Default,,0,0,0,,Жоқ, мен Чарльз туралы айтып отырмын.
Dialogue: 0,0:06:28.20,0:06:31.74,Default,,0,0,0,,Чарльз мен сені кездестіргеннен кейін өзгерді.
Dialogue: 0,0:06:31.87,0:06:35.24,Default,,0,0,0,,Бір-бірін түсіну қызық болып бара жатқан сияқты.
Dialogue: 0,0:06:35.79,0:06:40.17,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, біздің келісім-шартымыз ешқашан болмайды.
Dialogue: 0,0:06:40.29,0:06:42.04,Default,,0,0,0,,Жалғыз мен қалдым, иә?
Dialogue: 0,0:06:42.17,0:06:44.04,Default,,0,0,0,,Мифтер дәуірінен
Dialogue: 0,0:06:44.17,0:06:46.92,Default,,0,0,0,,Ерлерді шатастыратын әйелдер дейді.
Dialogue: 0,0:06:47.05,0:06:47.67,Default,,0,0,0,,Уф
Dialogue: 0,0:06:47.80,0:06:49.01,Default,,0,0,0,,Құрметті Марианна
Dialogue: 0,0:06:49.13,0:06:50.68,Default,,0,0,0,,Балалар, түсіңдер.
Dialogue: 0,0:06:52.14,0:06:52.76,Default,,0,0,0,,Га
Dialogue: 0,0:06:52.89,0:06:54.05,Default,,0,0,0,,Охххх
Dialogue: 0,0:06:56.64,0:06:57.47,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:06:58.14,0:07:00.35,Default,,0,0,0,,Иә, сынауды бастаңыз.
Dialogue: 0,0:07:00.60,0:07:03.48,Default,,0,0,0,,Мен Нуналлидің куәгер болуына рұқсат беруім керек пе?
Dialogue: 0,0:07:03.61,0:07:06.61,Default,,0,0,0,,Біз кінәлі террорист деп есептейміз.
Dialogue: 0,0:07:06.73,0:07:08.86,Default,,0,0,0,,Аня Ахлстрем
Dialogue: 0,0:07:08.99,0:07:12.36,Default,,0,0,0,,Бір апта бұрын өзін ұстауды үйрену үшін келген қыз.
Dialogue: 0,0:07:19.00,0:07:23.04,Default,,0,0,0,,Менің Геасым адамдардың жүрегін жаулай алатын Геас болды.
Dialogue: 0,0:07:27.38,0:07:29.55,Default,,0,0,0,,Дене өлімге жеткенде-
Dialogue: 0,0:07:29.67,0:07:32.26,Default,,0,0,0,,Қуат бірінші рет іске қосылды
Dialogue: 0,0:07:32.38,0:07:36.22,Default,,0,0,0,,Мен Аняның ішіне тығылып, В.В.
Dialogue: 0,0:07:36.35,0:07:37.72,Default,,0,0,0,,Мен білдім
Dialogue: 0,0:07:37.85,0:07:40.27,Default,,0,0,0,,Мен санамды бетіне көтергенде -
Dialogue: 0,0:07:40.39,0:07:43.40,Default,,0,0,0,,Сіз С.С.-мен сөйлесе аласыз.
Dialogue: 0,0:07:43.52,0:07:46.94,Default,,0,0,0,,Қашан C.C. шындықты біліп, топты В.В.
Dialogue: 0,0:07:47.07,0:07:49.32,Default,,0,0,0,,Ол көзден ғайып болды.
Dialogue: 0,0:07:49.99,0:07:52.82,Default,,0,0,0,,Мен ағаммен сөйлестім, бірақ
Dialogue: 0,0:07:53.03,0:07:56.83,Default,,0,0,0,,Мен Марианнаның ұят екенін естідім.
Dialogue: 0,0:07:56.95,0:07:58.12,Default,,0,0,0,,Иә
Dialogue: 0,0:07:58.24,0:08:00.75,Default,,0,0,0,,Менің ағам өтірік айтады.
Dialogue: 0,0:08:00.87,0:08:03.42,Default,,0,0,0,,Өтіріксіз дүние жасауға ант етсем де.
Dialogue: 0,0:08:04.12,0:08:05.17,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:08:05.29,0:08:07.92,Default,,0,0,0,,Сіз бәрін өлі В.В.-ға таңуға тырысасыз ба?
Dialogue: 0,0:08:08.05,0:08:11.34,Default,,0,0,0,,Сіз мені және Нанналлиді Жапонияға кепілге жібергеніңізбен.
Dialogue: 0,0:08:11.47,0:08:12.47,Default,,0,0,0,,Бұл қажет болды!
Dialogue: 0,0:08:12.59,0:08:14.01,Default,,0,0,0,,Не керек!
Dialogue: 0,0:08:14.13,0:08:15.43,Default,,0,0,0,,Ата-ана баласын қалай шеттете алады?
Dialogue: 0,0:08:16.51,0:08:19.51,Default,,0,0,0,,Нағыз маңызды нәрсе - сіз аулақ жүретін нәрсе.
Dialogue: 0,0:08:19.64,0:08:20.35,Default,,0,0,0,,Уф
Dialogue: 0,0:08:22.27,0:08:24.06,Default,,0,0,0,,Мирай-чан, күн шыққанда...
Dialogue: 0,0:08:24.19,0:08:26.35,Default,,0,0,0,,Мен фонда нөлдік жері бар суретті ұстағым келеді.
Dialogue: 0,0:08:26.48,0:08:27.77,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:27.90,0:08:30.40,Default,,0,0,0,,Кешіріңіз, түстен кейін Ниигата мен Нагоядан.
Dialogue: 0,0:08:30.53,0:08:32.19,Default,,0,0,0,,Қолдау келеді, оған дейін.
Dialogue: 0,0:08:32.32,0:08:33.61,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:08:40.74,0:08:41.79,Default,,0,0,0,,Көтерілісшілер әскері –
Dialogue: 0,0:08:41.91,0:08:45.83,Default,,0,0,0,,Қара рыцарьлардың көмегімен ол басылып жатыр.
Dialogue: 0,0:08:45.96,0:08:47.71,Default,,0,0,0,,Иә? Тағы не?
Dialogue: 0,0:08:47.83,0:08:51.13,Default,,0,0,0,,Мәртебелі Шнайзел туралы қаншалықты білесіз?
Dialogue: 0,0:08:51.25,0:08:53.63,Default,,0,0,0,,Бұл қорқынышты. Сен не туралы айтып тұрсың?
Dialogue: 0,0:08:55.43,0:08:58.22,Default,,0,0,0,,Мен Лелучты қолдандым
Dialogue: 0,0:08:58.35,0:09:03.14,Default,,0,0,0,,Мен бәрін білсем де, өз өлімімнің жемісін алу үшін...
Dialogue: 0,0:09:03.27,0:09:06.48,Default,,0,0,0,,Тек оның аман қалуына басымдық беріңіз.
Dialogue: 0,0:09:06.60,0:09:07.65,Default,,0,0,0,,Өкінішті?
Dialogue: 0,0:09:07.77,0:09:08.69,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:08.81,0:09:11.98,Default,,0,0,0,,Мен мәңгілік өмір сүретін бақсымын.
Dialogue: 0,0:09:12.11,0:09:13.19,Default,,0,0,0,,Мен оны лақтырып жібердім
Dialogue: 0,0:09:13.32,0:09:15.03,Default,,0,0,0,,Адамгершілік
Dialogue: 0,0:09:15.61,0:09:17.41,Default,,0,0,0,,Сен екеуміз бірдей емеспіз.
Dialogue: 0,0:09:17.53,0:09:18.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:18.37,0:09:21.70,Default,,0,0,0,,C.C. Мені басқа әлемге жібер
Dialogue: 0,0:09:21.83,0:09:25.29,Default,,0,0,0,,Ақымақпын десең де, тоқтай алмайсың
Dialogue: 0,0:09:25.83,0:09:26.79,Default,,0,0,0,,Иә
Dialogue: 0,0:09:26.92,0:09:31.67,Default,,0,0,0,,Мен ағамның көзінен қашу үшін бәріңді Жапонияға жібердім.
Dialogue: 0,0:09:31.80,0:09:35.67,Default,,0,0,0,,Марианнаның денесін де жасырын түрде алып тастаңыз.
Dialogue: 0,0:09:35.80,0:09:40.39,Default,,0,0,0,,Менің денем қалғанша, мен ол жерге қайта оралуым мүмкін.
Dialogue: 0,0:09:40.51,0:09:42.85,Default,,0,0,0,,Барлығын қорғау үшін -
Dialogue: 0,0:09:42.97,0:09:45.77,Default,,0,0,0,,Куәгерлер Аня мен Нунналлидің естеліктері...
Dialogue: 0,0:09:45.89,0:09:47.56,Default,,0,0,0,,қайта жазуға тура келді
Dialogue: 0,0:09:47.69,0:09:49.10,Default,,0,0,0,,Нуннал?
Dialogue: 0,0:09:49.23,0:09:52.11,Default,,0,0,0,,Менің соқырлығым психикалық ауруға байланысты емес еді...
Dialogue: 0,0:09:52.23,0:09:54.23,Default,,0,0,0,,Жалған куәгер болса да...
Dialogue: 0,0:09:54.36,0:09:56.44,Default,,0,0,0,,Менің өмірімді нысанаға алу қаупі болды.
Dialogue: 0,0:09:56.90,0:10:01.87,Default,,0,0,0,,Нанналиді құтқару үшін маған шындыққа жақындай алмайтын дәлел керек болды.
Dialogue: 0,0:10:01.99,0:10:06.00,Default,,0,0,0,,Бастапқы жоспарда өлместіктің бір ғана коды болған.
Dialogue: 0,0:10:06.12,0:10:09.71,Default,,0,0,0,,Бірақ зерттеу барысында басқа код...
Dialogue: 0,0:10:09.83,0:10:11.46,Default,,0,0,0,,Басқаша айтқанда, С.С.
Dialogue: 0,0:10:11.59,0:10:14.00,Default,,0,0,0,,Мен 100% кепілдік жоқ екенін түсінемін.
Dialogue: 0,0:10:14.13,0:10:18.55,Default,,0,0,0,,Марианнаның С.С. жақсы жүрмейді...
Dialogue: 0,0:10:18.68,0:10:21.22,Default,,0,0,0,,Енді сені пайдаланудан басқа амалым жоқ...
Dialogue: 0,0:10:21.34,0:10:24.14,Default,,0,0,0,,Сонда мен не үшінмін?
Dialogue: 0,0:10:24.35,0:10:27.39,Default,,0,0,0,,Рагнарек қосылғаннан кейін -
Dialogue: 0,0:10:27.52,0:10:29.35,Default,,0,0,0,,Мұндай қайғылы оқиғалар жойылады
Dialogue: 0,0:10:29.52,0:10:31.15,Default,,0,0,0,,Маска жоғалады
Dialogue: 0,0:10:31.27,0:10:33.77,Default,,0,0,0,,Әркім өзінің кім екенін жақсы көреді.
Dialogue: 0,0:10:33.90,0:10:35.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:35.94,0:10:38.90,Default,,0,0,0,,Тіпті Британия мен Қара Рыцарлар арасындағы шайқас...
Dialogue: 0,0:10:39.03,0:10:41.57,Default,,0,0,0,,C.C.
Dialogue: 0,0:10:41.70,0:10:45.91,Default,,0,0,0,,Басқаша айтқанда, мен әу бастан дүниенің шуы болдым...
Dialogue: 0,0:10:46.33,0:10:47.87,Default,,0,0,0,,Кедергі ретінде...
Dialogue: 0,0:10:48.62,0:10:52.17,Default,,0,0,0,,Иә, сіз қалай ойлайсыз? сендер жігіттер
Dialogue: 0,0:10:52.29,0:10:55.25,Default,,0,0,0,,Менің пайда болғанымды байқадыңыз ба?
Dialogue: 0,0:10:55.38,0:10:57.38,Default,,0,0,0,,Ол бастапқы күйіне оралған болуы мүмкін.
Dialogue: 0,0:10:57.51,0:10:59.88,Default,,0,0,0,,Менің ойымша, бұл жоспар үшін қажет.
Dialogue: 0,0:11:00.01,0:11:01.38,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:11:01.51,0:11:05.60,Default,,0,0,0,,Сондықтан, Куруруги, осы уақытқа дейін менің соңынан ерудің еш мәні жоқ.
Dialogue: 0,0:11:05.72,0:11:06.97,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:11:07.10,0:11:09.77,Default,,0,0,0,,Мен сенің өлмейтінсің деп естідім.
Dialogue: 0,0:11:10.19,0:11:12.81,Default,,0,0,0,,Сондықтан мен бір нәрсені растағым келеді.
Dialogue: 0,0:11:12.94,0:11:15.11,Default,,0,0,0,,Бұл сіз жасамақшы болып отыр
Dialogue: 0,0:11:15.23,0:11:18.65,Default,,0,0,0,,Иә, Юффи де, Нанналли де мұны қалайды.
Dialogue: 0,0:11:18.86,0:11:21.32,Default,,0,0,0,,Бұл мейірімді дүние
Dialogue: 0,0:11:22.20,0:11:24.57,Default,,0,0,0,,Көрдім, білдім.
Dialogue: 0,0:11:24.70,0:11:25.99,Default,,0,0,0,,Ｃ.Ｃ.
Dialogue: 0,0:11:26.12,0:11:30.08,Default,,0,0,0,,Енді бәріміз біргеміз, жоспарды бастауға болады.
Dialogue: 0,0:11:30.21,0:11:33.75,Default,,0,0,0,,Тілегіңіз кейінірек орындалады.
Dialogue: 0,0:11:38.09,0:11:40.55,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:11:45.10,0:11:46.85,Default,,0,0,0,,Уау
Dialogue: 0,0:11:56.36,0:11:57.23,Default,,0,0,0,,Не?
Dialogue: 0,0:11:59.65,0:12:00.69,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:12:00.82,0:12:01.86,Default,,0,0,0,,Дүние жүзінде?
Dialogue: 0,0:12:01.99,0:12:02.86,Default,,0,0,0,,Иә
Dialogue: 0,0:12:02.99,0:12:03.66,Default,,0,0,0,,Бисмарк
Dialogue: 0,0:12:03.78,0:12:07.49,Default,,0,0,0,,Менің ойымша, Мәртебелі жоспары орындалып жатыр.
Dialogue: 0,0:12:07.62,0:12:09.37,Default,,0,0,0,,Мәртебелі тілегі орындалса...
Dialogue: 0,0:12:09.79,0:12:14.12,Default,,0,0,0,,Менің ойымша, осыдан кейін әлемді жоғары мәртебелі Шнайзел басқарса жақсы болар еді.
Dialogue: 0,0:12:14.33,0:12:15.50,Default,,0,0,0,,Алайда,
Dialogue: 0,0:12:15.63,0:12:19.21,Default,,0,0,0,,Саясаттың мәні өзгеретінін түсініңіз.
Dialogue: 0,0:12:31.85,0:12:33.77,Default,,0,0,0,,Аа, ол басталады.
Dialogue: 0,0:12:34.44,0:12:37.19,Default,,0,0,0,,Акашаның қылышы құдайларды өлтіреді
Dialogue: 0,0:12:38.69,0:12:39.69,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:12:39.82,0:12:43.07,Default,,0,0,0,,Одан кейін бағамыз бір болса...
Dialogue: 0,0:12:43.19,0:12:45.66,Default,,0,0,0,,Жаңа әлем басталады
Dialogue: 0,0:12:45.78,0:12:50.41,Default,,0,0,0,,Лелуш, сен неге әлемді жаулап алуға тырыстың?
Dialogue: 0,0:12:50.54,0:12:53.37,Default,,0,0,0,,Ақылсыз сұрақтар қоймаңыз. Мен Нуналлимін.
Dialogue: 0,0:12:53.50,0:12:55.08,Default,,0,0,0,,Сіз Nunnally-ді сылтау ретінде пайдаланасыз ба?
Dialogue: 0,0:12:55.21,0:12:56.04,Default,,0,0,0,,Уф
Dialogue: 0,0:12:56.17,0:12:58.46,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:12:58.59,0:13:02.26,Default,,0,0,0,,Мен қорғағым келгеннің бәрі үшін күрестім.
Dialogue: 0,0:13:03.17,0:13:06.38,Default,,0,0,0,,Нәтиже алғыңыз келсе, бірдеңе істеу керек
Dialogue: 0,0:13:06.51,0:13:10.35,Default,,0,0,0,,Осы мақсатқа жету құралдары да бір нәрсені жоққа шығаруға әкеледі
Dialogue: 0,0:13:10.47,0:13:11.18,Default,,0,0,0,,Өзің бар
Dialogue: 0,0:13:11.35,0:13:12.85,Default,,0,0,0,,О, мен
Dialogue: 0,0:13:12.97,0:13:13.77,Default,,0,0,0,,Жарайды, мен оны қазір суға толтырамын.
Dialogue: 0,0:13:14.18,0:13:17.44,Default,,0,0,0,,Мен сізді де, ойыңызды да құптамаймын.
Dialogue: 0,0:13:18.77,0:13:20.90,Default,,0,0,0,,Адамдар неліктен өтірік айтады?
Dialogue: 0,0:13:21.02,0:13:23.23,Default,,0,0,0,,Бұл жай ғана бір нәрсеге ұрысу емес.
Dialogue: 0,0:13:23.36,0:13:25.53,Default,,0,0,0,,Себебі сіз бірдеңені қалайсыз
Dialogue: 0,0:13:25.65,0:13:27.86,Default,,0,0,0,,Дүние қалай болса солай жақсы болады?
Dialogue: 0,0:13:27.99,0:13:31.03,Default,,0,0,0,,Өзгеріс жоқ, өмір сүреміз демейміз.
Dialogue: 0,0:13:31.49,0:13:35.87,Default,,0,0,0,,Естеліктер әлеміне тең толық және жабық дүние.
Dialogue: 0,0:13:36.21,0:13:37.67,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:13:37.79,0:13:39.08,Default,,0,0,0,,Лелуш
Dialogue: 0,0:13:39.21,0:13:41.34,Default,,0,0,0,,Бұл мен де оны жоққа шығарамын дегенді білдіре ме?
Dialogue: 0,0:13:41.63,0:13:45.01,Default,,0,0,0,,Анаңның тілегі императордың тілегімен бірдей ме?
Dialogue: 0,0:13:45.38,0:13:49.59,Default,,0,0,0,,Бөлінгендердің енді біріккені жақсы.
Dialogue: 0,0:13:49.72,0:13:53.01,Default,,0,0,0,,Сіз өлілермен, тіпті Эфемиямен де бола аласыз.
Dialogue: 0,0:13:53.14,0:13:53.77,Default,,0,0,0,,Ах
Dialogue: 0,0:13:56.06,0:13:57.44,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:58.27,0:14:00.81,Default,,0,0,0,,Балалар сендер мұны жақсы нәрсе деп ойлайсыңдар.
Dialogue: 0,0:14:00.94,0:14:03.27,Default,,0,0,0,,Бірақ бұл таңылған гудвилл.
Dialogue: 0,0:14:03.40,0:14:05.15,Default,,0,0,0,,Жамандықтан айырмашылығы жоқ
Dialogue: 0,0:14:05.28,0:14:07.57,Default,,0,0,0,,Әркім түсінетін уақыт келеді.
Dialogue: 0,0:14:07.70,0:14:09.28,Default,,0,0,0,,Ол уақыт ешқашан келмейді!
Dialogue: 0,0:14:09.99,0:14:12.28,Default,,0,0,0,,Бір нәрсе анық
Dialogue: 0,0:14:12.41,0:14:13.49,Default,,0,0,0,,Сіз...
Dialogue: 0,0:14:13.62,0:14:16.66,Default,,0,0,0,,Мүмкін ол маған және Нунналлиге жақсылық жасауға тырысқан шығар.
Dialogue: 0,0:14:16.79,0:14:21.13,Default,,0,0,0,,Бірақ сендер мені және Наннеллиді тастап кеттіңдер!
Dialogue: 0,0:14:21.25,0:14:22.46,Default,,0,0,0,,Бірақ оны қорғау әрекетінде
Dialogue: 0,0:14:22.59,0:14:26.26,Default,,0,0,0,,Неліктен Жапония мен Британия арасындағы соғысты тоқтатпадың?
Dialogue: 0,0:14:28.80,0:14:30.89,Default,,0,0,0,,Жоспарлауға басымдық бергендер...
Dialogue: 0,0:14:31.01,0:14:33.01,Default,,0,0,0,,Тіріміз бе, өлі ме...
Dialogue: 0,0:14:33.14,0:14:34.60,Default,,0,0,0,,Оған еш қатысы жоқ.
Dialogue: 0,0:14:34.72,0:14:35.89,Default,,0,0,0,,Сондықтан мен оны лақтырып жібердім
Dialogue: 0,0:14:36.02,0:14:37.98,Default,,0,0,0,,Өзін-өзі қанағаттандыру үшін тек сылтаулар қалдыру
Dialogue: 0,0:14:38.10,0:14:39.06,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:14:39.19,0:14:40.69,Default,,0,0,0,,Сіз жаңа ғана айттыңыз!
Dialogue: 0,0:14:40.81,0:14:42.86,Default,,0,0,0,,Біз өлгендермен бір бола аламыз
Dialogue: 0,0:14:42.98,0:14:44.36,Default,,0,0,0,,Мен болашақты көрмеймін
Dialogue: 0,0:14:44.48,0:14:47.24,Default,,0,0,0,,Болашақ Рагнарекпен байланысты.
Dialogue: 0,0:14:47.36,0:14:48.82,Default,,0,0,0,,Бұдан әрі
Dialogue: 0,0:14:48.95,0:14:51.49,Default,,0,0,0,,Нуннали айтқан мейірімді әлем
Dialogue: 0,0:14:51.61,0:14:52.66,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:52.78,0:14:55.83,Default,,0,0,0,,Балалар, сендер айтып отырған дүние сендерге мейірімді дүние.
Dialogue: 0,0:14:55.95,0:14:58.83,Default,,0,0,0,,Бірақ мен Наннелли қалаған нәрсе екеніне сенімдімін...
Dialogue: 0,0:14:58.96,0:15:01.25,Default,,0,0,0,,Өзгелерге мейірімді бола алатын дүние.
Dialogue: 0,0:15:01.92,0:15:03.33,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:15:03.46,0:15:05.46,Default,,0,0,0,,Ең болмағанда Юффи соңына дейін――
Dialogue: 0,0:15:05.59,0:15:07.63,Default,,0,0,0,,Лелуш өзінің нөл екенін айтқан жоқ.
Dialogue: 0,0:15:07.76,0:15:10.18,Default,,0,0,0,,Ширли, сондықтан мен
Dialogue: 0,0:15:10.34,0:15:12.55,Default,,0,0,0,,Бар болса да, ол не?
Dialogue: 0,0:15:12.68,0:15:15.93,Default,,0,0,0,,Рагнарек байланысы қазірдің өзінде басталды.
Dialogue: 0,0:15:16.06,0:15:17.68,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:15:17.81,0:15:21.02,Default,,0,0,0,,Мен нөлмін, ғажайыптар жасайтын адаммын.
Dialogue: 0,0:15:21.31,0:15:23.56,Default,,0,0,0,,Геасс маған мағынасы жоқ
Dialogue: 0,0:15:23.69,0:15:25.36,Default,,0,0,0,,Тіпті басқа адамдармен
Dialogue: 0,0:15:25.48,0:15:27.98,Default,,0,0,0,,Жоқ, басқасы бар.
Dialogue: 0,0:15:28.11,0:15:29.36,Default,,0,0,0,,Иә? Каа
Dialogue: 0,0:15:29.49,0:15:32.86,Default,,0,0,0,,Иә, С әлемі – адамзаттың еркі.
Dialogue: 0,0:15:32.99,0:15:35.24,Default,,0,0,0,,Ал адамдар тең емес
Dialogue: 0,0:15:35.66,0:15:37.41,Default,,0,0,0,,Екеуі де сенің сөзің.
Dialogue: 0,0:15:37.74,0:15:40.96,Default,,0,0,0,,Менің күшімді білесің, өйткені біз тең емеспіз.
Dialogue: 0,0:15:41.08,0:15:43.21,Default,,0,0,0,,Ақымақ Лелуч!
Dialogue: 0,0:15:43.33,0:15:45.84,Default,,0,0,0,,Патшаның күші Құдайды жеңе алмайды.
Dialogue: 0,0:15:45.96,0:15:48.67,Default,,0,0,0,,Бұл жеңу немесе жеңілу туралы емес, бұл тілек.
Dialogue: 0,0:15:48.80,0:15:51.76,Default,,0,0,0,,Иә, енді мен өзімді білемін
Dialogue: 0,0:15:52.13,0:15:54.43,Default,,0,0,0,,Құдай! Ұжымдық бейсаналық!
Dialogue: 0,0:15:54.55,0:15:55.64,Default,,0,0,0,,Га
Dialogue: 0,0:15:58.18,0:16:00.48,Default,,0,0,0,,Уақыт жүрісін тоқтатпа!
Dialogue: 0,0:16:00.64,0:16:03.06,Default,,0,0,0,,Лелуш, сен баласың.
Dialogue: 0,0:16:03.19,0:16:06.31,Default,,0,0,0,,Ешкім мұндай болғанын қаламады, тіпті Юффи де!
Dialogue: 0,0:16:06.44,0:16:09.15,Default,,0,0,0,,Мен саған Юффимен сөйлесуге көмектестім.
Dialogue: 0,0:16:09.28,0:16:10.86,Default,,0,0,0,,Бұл мәжбүрлеу деп аталады!
Dialogue: 0,0:16:10.99,0:16:15.62,Default,,0,0,0,,Оны Құдайға да, адамзатқа да жасауға болмайды.
Dialogue: 0,0:16:15.78,0:16:18.87,Default,,0,0,0,,Сонда да мен ертеңгі күнді қалаймын!
Dialogue: 0,0:16:18.99,0:16:19.83,Default,,0,0,0,,Құт
Dialogue: 0,0:16:25.29,0:16:25.96,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:16:28.92,0:16:30.76,Default,,0,0,0,,Ойлау лифті
Dialogue: 0,0:16:31.13,0:16:35.26,Default,,0,0,0,,Мен және Марианнаның ағасының арманы шіріп барады
Dialogue: 0,0:16:35.39,0:16:38.10,Default,,0,0,0,,Чарльз, енді тоқтайық.
Dialogue: 0,0:16:38.22,0:16:40.47,Default,,0,0,0,,Бұл менмендік болды.
Dialogue: 0,0:16:40.64,0:16:44.14,Default,,0,0,0,,C.C. Ол әлі де біздің таңбамызды алып жүрсе...
Dialogue: 0,0:16:44.27,0:16:45.44,Default,,0,0,0,,Уф
Dialogue: 0,0:16:46.35,0:16:48.73,Default,,0,0,0,,Бұл өтірік емес
Dialogue: 0,0:16:48.86,0:16:50.28,Default,,0,0,0,,Нақты жауап
Dialogue: 0,0:16:50.40,0:16:52.03,Default,,0,0,0,,Сіз аа
Dialogue: 0,0:16:52.19,0:16:53.61,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:16:53.74,0:16:55.82,Default,,0,0,0,,Мен өлмейтін болуым керек
Dialogue: 0,0:16:55.95,0:16:59.37,Default,,0,0,0,,Жұтылды ма? C әлеміне
Dialogue: 0,0:16:59.49,0:17:00.45,Default,,0,0,0,,Бірақ C.C.
Dialogue: 0,0:17:00.95,0:17:05.25,Default,,0,0,0,,Неліктен C.C. жоғалып кету? Сіз бұл жоспарды қолдадыңыз.
Dialogue: 0,0:17:05.37,0:17:08.38,Default,,0,0,0,,Кешіріңіз, мен жаңа ғана байқадым.
Dialogue: 0,0:17:08.50,0:17:11.09,Default,,0,0,0,,Сіз өзіңізге ұнайсыз
Dialogue: 0,0:17:11.21,0:17:13.80,Default,,0,0,0,,Жоқ, бұл Лелуш пен Нанналли туралы.
Dialogue: 0,0:17:13.92,0:17:17.47,Default,,0,0,0,,Балалар сендер Нанналлидің күлімсіреуінің мағынасын білесіңдер ме?
Dialogue: 0,0:17:18.60,0:17:19.39,Default,,0,0,0,,Күлімсіреу?
Dialogue: 0,0:17:19.60,0:17:21.85,Default,,0,0,0,,Неліктен білмейсің?
Dialogue: 0,0:17:21.97,0:17:25.85,Default,,0,0,0,,Нунналли көрмейтін және жүрмейтін.
Dialogue: 0,0:17:25.98,0:17:28.27,Default,,0,0,0,,Сондықтан мен бұл дүниеде жалғыз емеспін...
Dialogue: 0,0:17:28.40,0:17:30.86,Default,,0,0,0,,Мен істей алмайтын нәрселер бар екенін білдім.
Dialogue: 0,0:17:31.61,0:17:34.69,Default,,0,0,0,,Нуналли - Нанналлидің күлкісі...
Dialogue: 0,0:17:34.82,0:17:36.65,Default,,0,0,0,,Ең болмағанда мен ризамын.
Dialogue: 0,0:17:36.78,0:17:38.62,Default,,0,0,0,,Мұндай алдау...
Dialogue: 0,0:17:38.99,0:17:41.45,Default,,0,0,0,,Өтірік деп айтпа!
Dialogue: 0,0:17:41.66,0:17:43.04,Default,,0,0,0,,Сіз осылай айтып тұрсыз ба?
Dialogue: 0,0:17:43.87,0:17:45.33,Default,,0,0,0,,Шындықты көрмей...
Dialogue: 0,0:17:45.46,0:17:47.96,Default,,0,0,0,,Биікке тұрып, бізді қуана бақылаңыз
Dialogue: 0,0:17:48.63,0:17:49.92,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:17:50.08,0:17:51.71,Default,,0,0,0,,Бір ғана факт бар
Dialogue: 0,0:17:51.84,0:17:55.01,Default,,0,0,0,,Сіз ата-анаңыз мені және Наннеллиді тастап кеткенсіз!
Dialogue: 0,0:17:55.17,0:17:56.63,Default,,0,0,0,,Ах
Dialogue: 0,0:17:56.76,0:17:59.09,Default,,0,0,0,,Сен ақымақ ақымақ!
Dialogue: 0,0:17:59.97,0:18:02.76,Default,,0,0,0,,Ку (Лелуч) Сузаку, маған тиіспе.
Dialogue: 0,0:18:02.89,0:18:08.19,Default,,0,0,0,,Менен бас тартсаң, алда оның Шнайзел әлемі күтіп тұр.
Dialogue: 0,0:18:08.31,0:18:12.48,Default,,0,0,0,,Жақсы ниет пен жаман ниет бірін-бірі жоққа шығарады. Бір картаның екі жағы.
Dialogue: 0,0:18:12.61,0:18:13.90,Default,,0,0,0,,Әлі де сен!
Dialogue: 0,0:18:14.03,0:18:18.03,Default,,0,0,0,,Сонда да мен сенің дүниеңді жоққа шығарамын.
Dialogue: 0,0:18:18.15,0:18:19.20,Default,,0,0,0,,Жоғал!
Dialogue: 0,0:18:19.32,0:18:22.41,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:18:25.95,0:18:27.71,Default,,0,0,0,,Уф, солай.
Dialogue: 0,0:18:28.46,0:18:29.79,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:30.17,0:18:33.17,Default,,0,0,0,,Иә, Мәртебелі, Мәртебелі.
Dialogue: 0,0:18:35.84,0:18:38.97,Default,,0,0,0,,C.C. Сіз де барасыз ба?
Dialogue: 0,0:18:39.09,0:18:41.59,Default,,0,0,0,,Мен өлсем күлгенімді қалайсың, солай ма?
Dialogue: 0,0:18:41.80,0:18:43.22,Default,,0,0,0,,Уф
Dialogue: 0,0:18:43.35,0:18:46.06,Default,,0,0,0,,Балалар енді не істейсіңдер?
Dialogue: 0,0:18:46.18,0:18:46.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:47.10,0:18:49.52,Default,,0,0,0,,Чарльз мен оның достарының жоспарын жоққа шығару...
Dialogue: 0,0:18:49.64,0:18:53.52,Default,,0,0,0,,Мен шындықпен уақыт бойынша алға жылжуды таңдадым.
Dialogue: 0,0:18:53.65,0:18:54.27,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:54.94,0:18:56.23,Default,,0,0,0,,О
Dialogue: 0,0:18:56.36,0:18:58.19,Default,,0,0,0,,Лелуш - Юффидің жауы
Dialogue: 0,0:18:58.44,0:18:59.36,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:19:05.33,0:19:07.08,Default,,0,0,0,,Фрейджа оқтұмсықтарының зақымдануынан...
Dialogue: 0,0:19:07.20,0:19:08.83,Default,,0,0,0,,Бір ай өтті
Dialogue: 0,0:19:08.96,0:19:12.96,Default,,0,0,0,,Мен ұлы мәртебелі император Чарльздың бүгін маңызды хабарландыруы бар екенін естідім.
Dialogue: 0,0:19:13.42,0:19:14.75,Default,,0,0,0,,Пендрагон император сарайынан -
Dialogue: 0,0:19:14.88,0:19:17.67,Default,,0,0,0,,Біз сізге халықаралық тікелей эфир арқылы хабарлаймыз.
Dialogue: 0,0:19:17.80,0:19:19.47,Default,,0,0,0,,Бір ай бойы көпшілік алдында...
Dialogue: 0,0:19:19.59,0:19:22.09,Default,,0,0,0,,Мәртебелі император келмеді...
Dialogue: 0,0:19:22.22,0:19:25.01,Default,,0,0,0,,Мәртебелі оның жоғалып кеткенін айтты емес пе?
Dialogue: 0,0:19:25.14,0:19:27.93,Default,,0,0,0,,Менің ойымша, бұл туралы хабарлаған Бисмарктың өзі ол жерде жоқ...
Dialogue: 0,0:19:28.06,0:19:30.18,Default,,0,0,0,,Шнайзел және басқалары ше?
Dialogue: 0,0:19:30.31,0:19:33.02,Default,,0,0,0,,Келіңіздер ме? Камбоджада бізбен байланысыңыз
Dialogue: 0,0:19:33.27,0:19:35.19,Default,,0,0,0,,Мәртебелі император келді.
Dialogue: 0,0:19:40.45,0:19:41.82,Default,,0,0,0,,(қатысқандардың дауысы)
Dialogue: 0,0:19:41.95,0:19:43.95,Default,,0,0,0,,Иә (Гвиневера) Мәртебелі туралы не деуге болады?
Dialogue: 0,0:19:44.07,0:19:45.28,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:47.16,0:19:48.04,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:48.33,0:19:49.08,Default,,0,0,0,,Не!
Dialogue: 0,0:19:49.29,0:19:50.71,Default,,0,0,0,,Сен әлі күнге дейін қылмыскерлердің өлтіріліп жатқанын Цукиге айтпағансың ба?
Dialogue: 0,0:19:51.21,0:19:52.58,Default,,0,0,0,,Өтірікші...
Dialogue: 0,0:19:52.96,0:19:53.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:53.88,0:19:55.84,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:55.96,0:19:59.88,Default,,0,0,0,,Мен Британияның 99-шы императорымын
Dialogue: 0,0:20:00.01,0:20:01.67,Default,,0,0,0,,Бұл Лелух ви Британия.
Dialogue: 0,0:20:01.80,0:20:03.01,Default,,0,0,0,,Қалай
Dialogue: 0,0:20:03.43,0:20:04.80,Default,,0,0,0,,Лелуш
Dialogue: 0,0:20:04.93,0:20:06.47,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:20:06.60,0:20:07.43,Default,,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:20:07.56,0:20:11.60,Default,,0,0,0,,Дұрыс, апа, мен тозақтың тұңғиығынан оралдым.
Dialogue: 0,0:20:11.73,0:20:13.27,Default,,0,0,0,,Сізге жақсы Лелуч
Dialogue: 0,0:20:13.69,0:20:17.32,Default,,0,0,0,,Нуналли табылған кезде, мен ойладым...
Dialogue: 0,0:20:17.44,0:20:20.49,Default,,0,0,0,,Бірақ менің ойымша, бұл аздап артық әзіл.
Dialogue: 0,0:20:20.61,0:20:21.90,Default,,0,0,0,,Бұл менің әкем.
Dialogue: 0,0:20:22.03,0:20:25.57,Default,,0,0,0,,98-ші император Чарльз Британдық
Dialogue: 0,0:20:25.70,0:20:26.87,Default,,0,0,0,,(Сувенир дүкенінің иесі) Хмм… (Турист 1) Ә?
Dialogue: 0,0:20:27.28,0:20:28.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:29.83,0:20:32.50,Default,,0,0,0,,Сондықтан мен келесі император боламын.
Dialogue: 0,0:20:32.62,0:20:34.50,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл мүмкін емес!
Dialogue: 0,0:20:35.25,0:20:36.67,Default,,0,0,0,,Мына тентектен құтыл
Dialogue: 0,0:20:36.79,0:20:39.30,Default,,0,0,0,,Мен ұлы мәртебелі императорды өлтірген үлкен күнәкармын.
Dialogue: 0,0:20:41.05,0:20:42.51,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,0:20:44.38,0:20:45.01,Default,,0,0,0,,Не!
Dialogue: 0,0:20:47.47,0:20:49.35,Default,,0,0,0,,Сузаку неге?
Dialogue: 0,0:20:49.60,0:20:53.02,Default,,0,0,0,,Мен рыцарь Сузаку Куруругимен таныстыруға рұқсат етіңіздер
Dialogue: 0,0:20:53.48,0:20:56.15,Default,,0,0,0,,Оның Лоундестен де көп мөлшері бар, өйткені Лоундес...
Dialogue: 0,0:20:56.27,0:20:59.07,Default,,0,0,0,,Нөлдік рыцарь атағын беріңіз
Dialogue: 0,0:20:59.19,0:21:00.69,Default,,0,0,0,,Сол адаммен...
Dialogue: 0,0:21:00.82,0:21:01.86,Default,,0,0,0,,Созаку?
Dialogue: 0,0:21:01.98,0:21:04.99,Default,,0,0,0,,Жоқ, Лелух, Лорд Куруруги де.
Dialogue: 0,0:21:05.11,0:21:07.70,Default,,0,0,0,,Халықаралық хабар таратудағы мұндай еркелік
Dialogue: 0,0:21:07.82,0:21:09.24,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:09.37,0:21:12.12,Default,,0,0,0,,Мұны түсінікті түрде түсіндіруге рұқсат етіңіз.
Dialogue: 0,0:21:12.25,0:21:13.58,Default,,0,0,0,,Мені тану!
Dialogue: 0,0:21:13.70,0:21:16.92,Default,,0,0,0,,Сондықтан мұндай әзілдерді доғару керек.
Dialogue: 0,0:21:20.17,0:21:21.84,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:21:22.09,0:21:24.09,Default,,0,0,0,,Барлық Хайл Лелуш
Dialogue: 0,0:21:24.22,0:21:27.89,Default,,0,0,0,,Барлығы Лелучқа сәлем берді
Dialogue: 0,0:21:28.01,0:21:29.72,Default,,0,0,0,,Барлық Хайл Лелуш
Dialogue: 0,0:21:29.85,0:21:33.52,Default,,0,0,0,,Лелуш бәрінен бұршақ
Dialogue: 0,0:21:33.64,0:21:35.56,Default,,0,0,0,,Барлық Хайл Лелуш
Dialogue: 0,0:21:35.69,0:21:37.27,Default,,0,0,0,,Барлық Хайл Лелуш
Dialogue: 0,0:21:37.40,0:21:39.27,Default,,0,0,0,,Рахмет Лелуч
Dialogue: 0,0:21:39.40,0:21:43.32,Default,,0,0,0,,Сіз шыққанша, енді проблема болмайды.
Dialogue: 0,0:21:43.44,0:21:46.15,Default,,0,0,0,,Бірақ неге Куруруги?
Dialogue: 0,0:21:46.28,0:21:49.37,Default,,0,0,0,,Ол сатқындықпен атағы шыққан адам.
Dialogue: 0,0:21:49.70,0:21:53.62,Default,,0,0,0,,Ештеңе етпейді, мен бәрін Лелушка беремін.
Dialogue: 0,0:21:53.74,0:21:56.04,Default,,0,0,0,,Тіпті Британия деп аталатын ел.
Dialogue: 0,0:21:56.37,0:21:58.58,Default,,0,0,0,,Мәселе бұдан да жоғары.
Dialogue: 0,0:21:58.71,0:22:01.63,Default,,0,0,0,,Әлемді басқаратын Лелуш Геассы ма?
Dialogue: 0,0:22:01.75,0:22:03.00,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:22:03.38,0:22:06.97,Default,,0,0,0,,♪～
Dialogue: 0,0:22:07.09,0:22:10.51,Default,,0,0,0,,♪Дүние жын, әділдік деген не?
Dialogue: 0,0:22:10.64,0:22:14.47,Default,,0,0,0,,♪Сұрамай тұрып, қарсылық таныт, кемшілік гүлі.
Dialogue: 0,0:22:14.60,0:22:17.89,Default,,0,0,0,,♪Екіжүзділіктің армандаған көздерін бақылаңыз
Dialogue: 0,0:22:18.02,0:22:22.02,Default,,0,0,0,,♪Өмір мен зұлымдықтың арасы жоқ.
Dialogue: 0,0:22:25.44,0:22:28.95,Default,,0,0,0,,♪Жарық ұрық сияқты жоғалады
Dialogue: 0,0:22:29.07,0:22:32.91,Default,,0,0,0,,♪Ұйқыдағы қараңғылық құрсағынсың
Dialogue: 0,0:22:33.03,0:22:36.37,Default,,0,0,0,,♪Жалғыздық сүйкімді
Dialogue: 0,0:22:36.50,0:22:40.08,Default,,0,0,0,,♪Ол сенің жалғыз одақтасың болады
Dialogue: 0,0:22:40.21,0:22:43.75,Default,,0,0,0,,♪Бәрі қанға боялған
Dialogue: 0,0:22:43.88,0:22:47.67,Default,,0,0,0,,♪ Осы дәуірде дүниеге келген
Dialogue: 0,0:22:47.80,0:22:54.60,Default,,0,0,0,,♪Таңдаулы ханзадалар, шайқас – береке
Dialogue: 0,0:22:54.93,0:22:59.44,Default,,0,0,0,,♪Ах, мен сұлумын, бәрін білемін.
Dialogue: 0,0:22:59.56,0:23:03.15,Default,,0,0,0,,♪Сүйікті ана сені туады
Dialogue: 0,0:23:03.27,0:23:05.90,Default,,0,0,0,,♪Бұл сүт немен қоректенеді?
Dialogue: 0,0:23:06.03,0:23:09.70,Default,,0,0,0,,♪Тозақтағы бауырлар
Dialogue: 0,0:23:10.86,0:23:14.16,Default,,0,0,0,,♪Аянның белгісі Ақиқат дегеніміз не?
Dialogue: 0,0:23:14.28,0:23:18.16,Default,,0,0,0,,♪Белгісіз және көмілген, жасырылған тұқымдар
Dialogue: 0,0:23:18.29,0:23:21.62,Default,,0,0,0,,♪Қос жүзді қылыш, жүзді суырып алғаныңызға қаратыңыз
Dialogue: 0,0:23:21.75,0:23:25.34,Default,,0,0,0,,♪Қорғау керек нәрсеге ғана сеніңіз
Dialogue: 0,0:23:25.46,0:23:32.47,Default,,0,0,0,,♪Өзіңіз қандай болсаңыз, солай болыңыз.
Dialogue: 0,0:23:37.81,0:23:40.73,Default,,0,0,0,,Ио, бұл ирониялық.
Dialogue: 0,0:23:40.85,0:23:43.06,Default,,0,0,0,,Мен Британияны жоққа шығардым...
Dialogue: 0,0:23:43.19,0:23:46.11,Default,,0,0,0,,Менің Британ императоры болудан басқа амалым жоқ.
Dialogue: 0,0:23:46.44,0:23:48.53,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:23:48.65,0:23:49.40,Default,,0,0,0,,Немесе бұл сәл қатігездік пе?
Dialogue: 0,0:23:49.53,0:23:51.24,Default,,0,0,0,,Барлығы үшін...
Dialogue: 0,0:23:52.74,0:23:58.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory