Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.43,0:00:05.65,Default,,0,0,0,,Қара рыцарларға арналған уағыз
Dialogue: 0,0:00:05.77,0:00:08.48,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:00:10.23,0:00:11.82,Default,,0,0,0,,Нөлге қай кошмар көмектесті?
Dialogue: 0,0:00:11.94,0:00:14.32,Default,,0,0,0,,) Мен оны Шинкудің жақсы картасымен алып шықтым.
Dialogue: 0,0:00:14.45,0:00:15.07,Default,,0,0,0,,Жұлдызша ою?
Dialogue: 0,0:00:15.45,0:00:17.28,Default,,0,0,0,,Мен жоғарыда айтқан Қытай Федерациясынан келген адам
Dialogue: 0,0:00:17.41,0:00:20.74,Default,,0,0,0,,Олай болса, мен сізге де оны пайдалануға рұқсат етемін.
Dialogue: 0,0:00:20.87,0:00:23.29,Default,,0,0,0,,Ал бұл Бабыл мұнарасындағы ұшқыш па?
Dialogue: 0,0:00:23.50,0:00:25.25,Default,,0,0,0,,Урабенің ісіне байланысты.
Dialogue: 0,0:00:25.58,0:00:29.13,Default,,0,0,0,,Аты-жөніңізді айтпай-ақ қояйын, бірақ мені жақтаушы деп есептесеңіз болады.
Dialogue: 0,0:00:29.29,0:00:31.30,Default,,0,0,0,,Қарсыласыңызда Геассты қолдандыңыз ба?
Dialogue: 0,0:00:31.63,0:00:33.51,Default,,0,0,0,,Әзірге қажет емес
Dialogue: 0,0:00:33.88,0:00:35.47,Default,,0,0,0,,Керісінше, император C.C.
Dialogue: 0,0:00:35.59,0:00:36.63,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:00:36.76,0:00:38.55,Default,,0,0,0,,Ұшқыш маған да құпия ма?
Dialogue: 0,0:00:39.10,0:00:40.05,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:40.39,0:00:42.14,Default,,0,0,0,,Кейде мен жай ғана сыр сақтағым келеді
Dialogue: 0,0:00:42.47,0:00:44.10,Default,,0,0,0,,Ол нөлге тең бе?
Dialogue: 0,0:00:44.23,0:00:45.31,Default,,0,0,0,,Лелуш ретінде?
Dialogue: 0,0:00:45.77,0:00:48.48,Default,,0,0,0,,Менің ойымша, ол да сізбен қарым-қатынасы туралы ашық емес.
Dialogue: 0,0:00:48.60,0:00:50.69,Default,,0,0,0,,Бұны біртүрлі етіп айтуды доғар.
Dialogue: 0,0:00:50.94,0:00:52.73,Default,,0,0,0,,Нөлдің шынайы тұлғасы қандай?
Dialogue: 0,0:00:52.86,0:00:56.11,Default,,0,0,0,,Енді ұйымдағы жалғыз біз ғана білеміз.
Dialogue: 0,0:00:56.24,0:00:57.36,Default,,0,0,0,,Оны да жасырайық.
Dialogue: 0,0:00:57.49,0:01:00.03,Default,,0,0,0,,Лелуш Мен бұрынғыдаймын.
Dialogue: 0,0:01:00.16,0:01:02.62,Default,,0,0,0,,Нөлдік гвардияның капитаны болу дұрыс па?
Dialogue: 0,0:01:02.74,0:01:03.62,Default,,0,0,0,,О
Dialogue: 0,0:01:03.75,0:01:06.46,Default,,0,0,0,,Мен түсіндім. Мен түссіндім.
Dialogue: 0,0:01:06.87,0:01:07.75,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:01:07.87,0:01:10.75,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:01:10.88,0:01:14.01,Default,,0,0,0,,Геас туралы кейінірек айтамыз, бірақ әзірше.
Dialogue: 0,0:01:14.26,0:01:16.30,Default,,0,0,0,,А, мен білемін.
Dialogue: 0,0:01:18.43,0:01:20.60,Default,,0,0,0,,О, ностальгиялық клуб формасы
Dialogue: 0,0:01:20.72,0:01:21.51,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:01:21.64,0:01:23.64,Default,,0,0,0,,Мен осылай дайындайтынмын.
Dialogue: 0,0:01:23.77,0:01:26.06,Default,,0,0,0,,) Капитан Акацуки мен Урабе мырза дайындалуда.
Dialogue: 0,0:01:26.18,0:01:27.39,Default,,0,0,0,,Иә
Dialogue: 0,0:01:27.52,0:01:30.61,Default,,0,0,0,,Мен көремін. Урабе абыроймен өлді ме?
Dialogue: 0,0:01:30.73,0:01:31.90,Default,,0,0,0,,Иә
Dialogue: 0,0:01:33.32,0:01:34.90,Default,,0,0,0,,Мен мойындасам екен
Dialogue: 0,0:01:35.03,0:01:36.78,Default,,0,0,0,,Мен нені мойындауым керек?
Dialogue: 0,0:01:36.90,0:01:38.11,Default,,0,0,0,,Нөл (Асахина/Чиба) Иә?
Dialogue: 0,0:01:38.24,0:01:39.20,Default,,0,0,0,,) Нөл? (Оңтүстік) Нөл?
Dialogue: 0,0:01:40.70,0:01:41.78,Default,,0,0,0,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:01:44.16,0:01:46.62,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:01:46.75,0:01:50.08,Default,,0,0,0,,Бірақ сенің сатқындығың болмаса, біз ұсталмас едік.
Dialogue: 0,0:01:50.21,0:01:51.88,Default,,0,0,0,,Бірдеңе айту дұрыс емес пе?
Dialogue: 0,0:01:52.75,0:01:53.38,Default,,0,0,0,,Ах
Dialogue: 0,0:01:53.71,0:01:55.38,Default,,0,0,0,,Нөл Не болды?
Dialogue: 0,0:01:55.92,0:01:58.09,Default,,0,0,0,,Барлығы Британияны жеңу үшін.
Dialogue: 0,0:01:58.38,0:02:00.51,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:02:00.72,0:02:01.84,Default,,0,0,0,,Осымен
Dialogue: 0,0:02:02.55,0:02:05.26,Default,,0,0,0,,Басқалары бар ма? ақтау немесе кешірім сұрау
Dialogue: 0,0:02:05.39,0:02:06.10,Default,,0,0,0,,Тоқта
Dialogue: 0,0:02:07.68,0:02:11.06,Default,,0,0,0,,Нөл, сіз жеңу үшін бірдеңе жасауға тырыстыңыз.
Dialogue: 0,0:02:11.19,0:02:13.44,Default,,0,0,0,,Мен әрқашан нәтижеге ұмтыламын
Dialogue: 0,0:02:14.40,0:02:15.32,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:02:15.44,0:02:16.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:16.69,0:02:19.45,Default,,0,0,0,,Кейде стратегияның егжей-тегжейлерін жасыру керек.
Dialogue: 0,0:02:19.57,0:02:21.53,Default,,0,0,0,,Маған қазір оның көмегі керек.
Dialogue: 0,0:02:22.07,0:02:24.74,Default,,0,0,0,,Мен одан асқан дарынды адамды білмеймін.
Dialogue: 0,0:02:24.87,0:02:27.29,Default,,0,0,0,,Мен де солай.Нөлге сенейік бәріміз.
Dialogue: 0,0:02:27.66,0:02:30.33,Default,,0,0,0,,Бірақ Нөл сізге пешка сияқты қарайды.
Dialogue: 0,0:02:30.71,0:02:32.63,Default,,0,0,0,,Мұны одан басқа кім жасай алады?
Dialogue: 0,0:02:33.84,0:02:37.30,Default,,0,0,0,,Қытай Федерациясының Британиямен соғысуы мүмкін емес еді.
Dialogue: 0,0:02:37.42,0:02:38.84,Default,,0,0,0,,Е.У. ханзада Шнайзелдің алдында да...
Dialogue: 0,0:02:38.97,0:02:40.97,Default,,0,0,0,,Сіз ұтылып жатқан сияқтысыз, солай ма?
Dialogue: 0,0:02:41.22,0:02:44.97,Default,,0,0,0,,Біз барлық отарланған аймақтардың үмітіміз.
Dialogue: 0,0:02:45.10,0:02:46.60,Default,,0,0,0,,Тәуелсіздік соғысында жеңіске жету үшін...
Dialogue: 0,0:02:47.01,0:02:48.64,Default,,0,0,0,,Біздің жалғыз көшбасшымыз - Нөл.
Dialogue: 0,0:02:48.77,0:02:52.40,Default,,0,0,0,,Дұрыс, нөл нөл нөл нөл нөл
Dialogue: 0,0:02:52.52,0:02:59.49,Default,,0,0,0,,Нөл нөл нөл нөл нөл нөл нөл ...
Dialogue: 0,0:03:00.36,0:03:05.78,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:03:05.91,0:03:08.58,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:03:08.70,0:03:11.50,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:03:11.62,0:03:17.04,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:03:17.17,0:03:20.05,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:03:20.17,0:03:22.88,Default,,0,0,0,,♪Енді кеттік, мен аққан жұлдызмын
Dialogue: 0,0:03:28.68,0:03:34.15,Default,,0,0,0,,♪Дүние ыдыраса да, ешқашан өзгермейтін нәрселер бар.
Dialogue: 0,0:03:34.27,0:03:39.73,Default,,0,0,0,,♪Көз жасымызды тыйсақ та, қорғайтын нәрсе бар.
Dialogue: 0,0:03:39.86,0:03:42.61,Default,,0,0,0,,♪Он мыңдаған жылдар бұрынғы хабарлар дененің ішінде.
Dialogue: 0,0:03:42.74,0:03:45.16,Default,,0,0,0,,♪Сырылдап, ызылдай бастайды
Dialogue: 0,0:03:45.45,0:03:48.08,Default,,0,0,0,,♪Ертең қарлығаш дауыспен қоңырау шалыңыз
Dialogue: 0,0:03:48.24,0:03:51.20,Default,,0,0,0,,♪Мен сені тыртық қолыммен қорғаймын
Dialogue: 0,0:03:51.45,0:03:54.25,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:03:54.37,0:03:56.79,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:03:58.42,0:04:03.67,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:04:03.80,0:04:06.14,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:04:06.59,0:04:09.43,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:04:09.56,0:04:14.94,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:04:15.06,0:04:17.56,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:04:17.69,0:04:22.15,Default,,0,0,0,,♪Тағдырды кесіп өткен аққан жұлдыз
Dialogue: 0,0:04:22.28,0:04:26.61,Default,,0,0,0,,♪Тасып жатқан көз жасыңды мен қазір алып кетемін
Dialogue: 0,0:04:37.54,0:04:39.29,Default,,0,0,0,,Бүгінгі жағдай бойынша -
Dialogue: 0,0:04:39.42,0:04:42.17,Default,,0,0,0,,Мен Эшфорд академиясына оралуды шештім.
Dialogue: 0,0:04:42.30,0:04:43.34,Default,,0,0,0,,Бұл Сузаку Куруруги.
Dialogue: 0,0:04:44.01,0:04:45.38,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:04:45.72,0:04:48.30,Default,,0,0,0,,Сузаку Куруруги Нөлді басып алды ма?
Dialogue: 0,0:04:48.43,0:04:50.89,Default,,0,0,0,,Мектептегі Ақ өлімдегі Құдай?
Dialogue: 0,0:04:51.01,0:04:52.64,Default,,0,0,0,,Бұл жеті рыцарь
Dialogue: 0,0:04:52.77,0:04:53.81,Default,,0,0,0,,Бірақ сағат он бір.
Dialogue: 0,0:04:53.93,0:04:56.39,Default,,0,0,0,,Бұл маңызды емес. Ол тікелей ұлы мәртебелі императорға бағынады.
Dialogue: 0,0:04:56.52,0:04:58.19,Default,,0,0,0,,Иә, тыныш болыңыз
Dialogue: 0,0:04:58.31,0:05:02.69,Default,,0,0,0,,Лорд Куруруги 11-аймаққа тағайындалуына байланысты мектепке қайта оралуды шешті.
Dialogue: 0,0:05:02.94,0:05:05.19,Default,,0,0,0,,Әзірге Лелуштың жанына отырыңыз.
Dialogue: 0,0:05:05.32,0:05:05.95,Default,,0,0,0,,Иә
Dialogue: 0,0:05:08.87,0:05:14.20,Default,,0,0,0,,Созаку, сен менің бірінші досым болдың.
Dialogue: 0,0:05:14.45,0:05:17.67,Default,,0,0,0,,Бірақ соғыс бізді бөліп тастады
Dialogue: 0,0:05:19.38,0:05:21.79,Default,,0,0,0,,Екінші Тынық мұхит соғысы
Dialogue: 0,0:05:21.92,0:05:24.05,Default,,0,0,0,,Ұлыбританияның Жапонияны жаулап алуы
Dialogue: 0,0:05:24.67,0:05:28.59,Default,,0,0,0,,Жеңілген ел Жапония Британияның колония аймағына айналды.
Dialogue: 0,0:05:28.93,0:05:30.89,Default,,0,0,0,,Мені туған жерім тастап кетті
Dialogue: 0,0:05:31.55,0:05:33.81,Default,,0,0,0,,Мен туған жерімді тастап кетуге мәжбүр болдым
Dialogue: 0,0:05:34.39,0:05:36.98,Default,,0,0,0,,Қайта кездескенде жаулар мен одақтастар
Dialogue: 0,0:05:37.56,0:05:41.52,Default,,0,0,0,,Мен жапон болсам да, мен британдық әскеримін.
Dialogue: 0,0:05:42.52,0:05:46.07,Default,,0,0,0,,Мен нөлмін. Біз бір-бірімізден өзімізді жасырамыз.
Dialogue: 0,0:05:46.19,0:05:47.53,Default,,0,0,0,,Біз соғыстық
Dialogue: 0,0:05:48.28,0:05:51.12,Default,,0,0,0,,Бірақ бұл шынайы естелік
Dialogue: 0,0:05:51.82,0:05:54.24,Default,,0,0,0,,Үш естелікті ұлы мәртебелі император қайта жазды.
Dialogue: 0,0:05:54.70,0:05:56.12,Default,,0,0,0,,Nunnally туралы
Dialogue: 0,0:05:56.37,0:05:57.71,Default,,0,0,0,,Нөл туралы естеліктер
Dialogue: 0,0:05:57.96,0:06:02.04,Default,,0,0,0,,Мен Британияның ханзадасы болдым.
Dialogue: 0,0:06:03.25,0:06:05.55,Default,,0,0,0,,Басқаша айтқанда, біз қазірміз. Басқаша айтқанда, біз қазірміз.
Dialogue: 0,0:06:07.17,0:06:08.97,Default,,0,0,0,,Біраз болды, Созаку.
Dialogue: 0,0:06:09.22,0:06:10.84,Default,,0,0,0,,Мен сені сағындым Лелуч
Dialogue: 0,0:06:10.97,0:06:12.39,Default,,0,0,0,,Созаку-кун, көптен бері көрмедім
Dialogue: 0,0:06:12.51,0:06:14.01,Default,,0,0,0,,Сіз жоғарыладыңыз, Созаку.
Dialogue: 0,0:06:14.56,0:06:16.06,Default,,0,0,0,,Созаку-кун қайтып келді?
Dialogue: 0,0:06:16.47,0:06:19.10,Default,,0,0,0,,Төраға, мен сабақтамын.
Dialogue: 0,0:06:19.27,0:06:21.02,Default,,0,0,0,,Не, Лелуш, тек сен ғана маңызды ештеңе айтпайсың ба?
Dialogue: 0,0:06:21.02,0:06:23.11,Default,,0,0,0,,Не, Лелуш, тек сен ғана маңызды ештеңе айтпайсың ба?
Dialogue: 0,0:06:21.02,0:06:23.11,Default,,0,0,0,,Бұл сәтсіздік болды, Созаку.
Dialogue: 0,0:06:23.23,0:06:25.94,Default,,0,0,0,,Ол менің жағыма Лелуш деген атпен келді.
Dialogue: 0,0:06:26.07,0:06:30.15,Default,,0,0,0,,Басқаша айтқанда, сіз мені білетіндіктен әрекет етесіз.
Dialogue: 0,0:06:30.28,0:06:34.16,Default,,0,0,0,,Енді, егер Роло ақымақтық жасамаса.
Dialogue: 0,0:06:34.95,0:06:36.70,Default,,0,0,0,,Иә? (Лоло Ламперуж) Ах
Dialogue: 0,0:06:37.95,0:06:39.00,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:39.12,0:06:41.08,Default,,0,0,0,,Бізден басқа барлығы үйлеріне қайтты.
Dialogue: 0,0:06:41.21,0:06:42.38,Default,,0,0,0,,Мұғалім де?
Dialogue: 0,0:06:42.71,0:06:44.79,Default,,0,0,0,,Материктік Британияда? (Лелуш) О
Dialogue: 0,0:06:44.92,0:06:47.84,Default,,0,0,0,,Созақу туралы біз ғана білеміз.
Dialogue: 0,0:06:47.96,0:06:48.80,Default,,0,0,0,,Сәлем Роло
Dialogue: 0,0:06:48.92,0:06:50.05,Default,,0,0,0,,Иә
Dialogue: 0,0:06:50.30,0:06:53.01,Default,,0,0,0,,Байқадым, әйтеуір бейтаныс жүз бар
Dialogue: 0,0:06:53.14,0:06:55.18,Default,,0,0,0,,Эй, сен Нөлдің түрін көрдің ғой, солай ма?
Dialogue: 0,0:06:55.30,0:06:56.35,Default,,0,0,0,,Ол қандай болды?
Dialogue: 0,0:06:56.60,0:06:57.81,Default,,0,0,0,,Негізі қыз
Dialogue: 0,0:06:57.93,0:06:59.56,Default,,0,0,0,,Жоғары мәртебелі Хловис туралы қауесеттер бар ма?
Dialogue: 0,0:06:59.68,0:07:01.39,Default,,0,0,0,,Бір елдің ханзадасы?
Dialogue: 0,0:07:01.52,0:07:03.10,Default,,0,0,0,,О, бұл
Dialogue: 0,0:07:03.48,0:07:04.90,Default,,0,0,0,,Жарайсың ба? Бұл туралы
Dialogue: 0,0:07:05.44,0:07:07.15,Default,,0,0,0,,Кешіріңіз, айта алмаймын.
Dialogue: 0,0:07:07.27,0:07:10.49,Default,,0,0,0,,Сіз әскери қызметтесіз... Аргх.
Dialogue: 0,0:07:10.61,0:07:11.45,Default,,0,0,0,,Артур
Dialogue: 0,0:07:11.82,0:07:12.82,Default,,0,0,0,,Сен оны әкелдің бе?
Dialogue: 0,0:07:13.20,0:07:17.24,Default,,0,0,0,,Сізге мысықтар ұнайды, солай емес пе?
Dialogue: 0,0:07:18.91,0:07:21.75,Default,,0,0,0,,Бізбен байланысқаннан кейін не байқадыңыз?
Dialogue: 0,0:07:21.87,0:07:23.17,Default,,0,0,0,,Жоқ, әсіресе
Dialogue: 0,0:07:23.71,0:07:26.88,Default,,0,0,0,,-де зерттелушінің жадының қайтып келмегені анықталған.
Dialogue: 0,0:07:27.00,0:07:30.55,Default,,0,0,0,,Күте тұрыңыз, маған тағы біраз зерттеу керек.
Dialogue: 0,0:07:30.88,0:07:32.88,Default,,0,0,0,,Біздің бақылауымызға сенбесеңіз ше?
Dialogue: 0,0:07:33.38,0:07:35.26,Default,,0,0,0,,Сондай-ақ C.C.
Dialogue: 0,0:07:35.39,0:07:37.93,Default,,0,0,0,,Әдеттегідей, сізден іні рөлін ойнау сұралады.
Dialogue: 0,0:07:38.56,0:07:40.56,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:07:40.81,0:07:44.73,Default,,0,0,0,,Студенттік кеңес Лорд Куруругиді қарсы алу кешін өткізетін сияқты.
Dialogue: 0,0:07:44.85,0:07:46.36,Default,,0,0,0,,Сондықтан қайтадан тексеріңіз
Dialogue: 0,0:07:46.48,0:07:47.48,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:48.48,0:07:52.45,Default,,0,0,0,,Мен не істеуім керек? Лелушка сенуім керек пе?
Dialogue: 0,0:07:54.32,0:07:57.91,Default,,0,0,0,,Мұғалім, мен және Роло туралы барлық заңсыздықтар...
Dialogue: 0,0:07:58.03,0:07:59.62,Default,,0,0,0,,Сіз бұған назар аудара аласыз ба?
Dialogue: 0,0:08:07.38,0:08:09.21,Default,,0,0,0,,Жарайды, солай істейік.
Dialogue: 0,0:08:10.55,0:08:13.01,Default,,0,0,0,,Екеуің де көп шықпаңдар.
Dialogue: 0,0:08:13.13,0:08:14.22,Default,,0,0,0,,Иә
Dialogue: 0,0:08:14.43,0:08:16.80,Default,,0,0,0,,Жалғыз мүше профессор Виллетта қалды.
Dialogue: 0,0:08:16.93,0:08:19.68,Default,,0,0,0,,Иә, бірақ Сузаку Куруруги осында.
Dialogue: 0,0:08:19.81,0:08:20.64,Default,,0,0,0,,Өлтіру?
Dialogue: 0,0:08:21.18,0:08:22.81,Default,,0,0,0,,Мұны істеуді тоқтатыңыз.
Dialogue: 0,0:08:23.35,0:08:24.44,Default,,0,0,0,,О, және
Dialogue: 0,0:08:24.60,0:08:25.52,Default,,0,0,0,,Иә
Dialogue: 0,0:08:25.64,0:08:27.86,Default,,0,0,0,,Бөтен сөздерді қолданбаңыз
Dialogue: 0,0:08:28.77,0:08:30.23,Default,,0,0,0,,Біз ағайындымыз, солай ма?
Dialogue: 0,0:08:30.36,0:08:31.28,Default,,0,0,0,,Ах
Dialogue: 0,0:08:31.40,0:08:34.57,Default,,0,0,0,,Уайымдама, мен саған жоспарымды тездетемін.
Dialogue: 0,0:08:35.49,0:08:38.37,Default,,0,0,0,,Мен Жапонияның тәуелсіздігі сияқты бірдеңе жасаймын.
Dialogue: 0,0:08:38.99,0:08:40.49,Default,,0,0,0,,Тіпті осы мектептен
Dialogue: 0,0:08:42.58,0:08:43.62,Default,,0,0,0,,Ивате
Dialogue: 0,0:08:44.41,0:08:45.37,Default,,0,0,0,,Вакаяма
Dialogue: 0,0:08:46.25,0:08:47.33,Default,,0,0,0,,Токушима
Dialogue: 0,0:08:47.46,0:08:49.71,Default,,0,0,0,,Ямагучиден де хабарлар болды.
Dialogue: 0,0:08:49.84,0:08:53.42,Default,,0,0,0,,Ха, Нөл пайда бола салысымен солай болды.
Dialogue: 0,0:08:53.80,0:08:56.76,Default,,0,0,0,,Лорд Гилдфордтың болмауы да себеп болуы мүмкін.
Dialogue: 0,0:08:56.88,0:09:00.01,Default,,0,0,0,,Егер жағдай бұрынғыдай жалғаса берсе, онда сакурадит қоры болмайды.
Dialogue: 0,0:09:00.14,0:09:02.93,Default,,0,0,0,,Төтенше жағдайдағы анықталмаған MRF ішіндегі
Dialogue: 0,0:09:03.06,0:09:03.68,Default,,0,0,0,,Не?
Dialogue: 0,0:09:03.81,0:09:07.02,Default,,0,0,0,,Ақымақ, бұл 11-аймақты басқаратын үкімет кеңсесі.
Dialogue: 0,0:09:07.35,0:09:09.90,Default,,0,0,0,,Хахаха, мұның несі қарапайым?
Dialogue: 0,0:09:10.15,0:09:12.23,Default,,0,0,0,,Баяу болғаны сонша, мен шошып кеттім
Dialogue: 0,0:09:12.36,0:09:16.11,Default,,0,0,0,,11-аймақтың қорғаныс сызығы қандай? Бұл солай ма?
Dialogue: 0,0:09:19.32,0:09:21.91,Default,,0,0,0,,Иә, бұл шешім дұрыс.
Dialogue: 0,0:09:27.92,0:09:28.75,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,0:09:31.34,0:09:31.96,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:34.13,0:09:37.13,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін, бірақ бұл соңы.
Dialogue: 0,0:09:37.26,0:09:38.13,Default,,0,0,0,,Дисквалификация
Dialogue: 0,0:09:38.26,0:09:41.39,Default,,0,0,0,,Қару-жарақ ғимараттарды қорғауға басымдық береді.
Dialogue: 0,0:09:41.51,0:09:42.81,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:09:45.35,0:09:45.98,Default,,0,0,0,,Не?
Dialogue: 0,0:09:47.77,0:09:49.19,Default,,0,0,0,,Мен бұл ұшақ болады деп ойламадым
Dialogue: 0,0:09:57.95,0:09:59.49,Default,,0,0,0,,Осыны айтып тұрсың ба?
Dialogue: 0,0:10:00.36,0:10:03.28,Default,,0,0,0,,Айнымалы түнгі кадр Тристан
Dialogue: 0,0:10:03.41,0:10:04.16,Default,,0,0,0,,Оның аты Фантом Дуби.
Dialogue: 0,0:10:04.70,0:10:07.75,Default,,0,0,0,,Үш рыцарь сэр Джино Вайнберг, солай ма?
Dialogue: 0,0:10:07.87,0:10:10.17,Default,,0,0,0,,А, мен сендерді сынауға келдім.
Dialogue: 0,0:10:10.37,0:10:13.17,Default,,0,0,0,,Жүр, мені тоқтат.
Dialogue: 0,0:10:14.09,0:10:15.25,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:10:15.38,0:10:18.01,Default,,0,0,0,,Біз де қорланып өмір сүре алмаймыз.
Dialogue: 0,0:10:18.13,0:10:20.22,Default,,0,0,0,,Иә, мен байсалдымын.
Dialogue: 0,0:10:20.38,0:10:21.59,Default,,0,0,0,,Тіпті айтпай-ақ
Dialogue: 0,0:10:21.72,0:10:22.47,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:10:26.47,0:10:27.22,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:10:27.35,0:10:27.98,Default,,0,0,0,,Тоқта
Dialogue: 0,0:10:30.23,0:10:32.52,Default,,0,0,0,,Міне, бітті.
Dialogue: 0,0:10:33.11,0:10:34.23,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:34.36,0:10:36.40,Default,,0,0,0,,Бұл сіздің Жеті рыцарь ретіндегі үкіміңіз бе?
Dialogue: 0,0:10:36.40,0:10:37.03,Default,,0,0,0,,Бұл сіздің Жеті рыцарь ретіндегі үкіміңіз бе?
Dialogue: 0,0:10:36.40,0:10:37.03,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:37.15,0:10:38.65,Default,,0,0,0,,Куу Куу
Dialogue: 0,0:10:38.86,0:10:40.15,Default,,0,0,0,,О, Созаку
Dialogue: 0,0:10:40.45,0:10:41.28,Default,,0,0,0,,Джино
Dialogue: 0,0:10:41.41,0:10:43.62,Default,,0,0,0,,Мен сізден Ланселотты әкелуіңізді өтіндім.
Dialogue: 0,0:10:43.74,0:10:46.79,Default,,0,0,0,,А, мен келесі аптада Эрл Ллойдпен бірге келемін.
Dialogue: 0,0:10:46.91,0:10:48.58,Default,,0,0,0,,Тағы не бар? бұл киім
Dialogue: 0,0:10:48.83,0:10:51.29,Default,,0,0,0,,Мен мектептен үйге келе жатырмын, сондықтан мен формадамын.
Dialogue: 0,0:10:51.42,0:10:53.13,Default,,0,0,0,,Эй, міне, осы.
Dialogue: 0,0:10:53.25,0:10:57.05,Default,,0,0,0,,Джино Қанша мәртебелі болса да, бәрібір сәл қарапайым...
Dialogue: 0,0:10:57.17,0:10:59.13,Default,,0,0,0,,Бұл ауыр болса да.
Dialogue: 0,0:10:59.26,0:11:00.51,Default,,0,0,0,,Соңы?
Dialogue: 0,0:11:02.22,0:11:04.93,Default,,0,0,0,,Мордред? Аня келді ме?
Dialogue: 0,0:11:05.26,0:11:06.14,Default,,0,0,0,,Соңы?
Dialogue: 0,0:11:06.26,0:11:08.27,Default,,0,0,0,,Бітті, Созаку.
Dialogue: 0,0:11:08.72,0:11:10.56,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:12.27,0:11:13.19,Default,,0,0,0,,Жалықтырғыш
Dialogue: 0,0:11:14.27,0:11:17.23,Default,,0,0,0,,Қазір бізде әскери күш жеткілікті.
Dialogue: 0,0:11:17.90,0:11:18.86,Default,,0,0,0,,Лелуш
Dialogue: 0,0:11:18.98,0:11:22.32,Default,,0,0,0,,Үш күннен кейін сәлемдесу кешінде бәрін ашайық.
Dialogue: 0,0:11:29.08,0:11:30.66,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:11:30.79,0:11:34.29,Default,,0,0,0,,Жеті түнді қарсы алу кеші қазір басталады.
Dialogue: 0,0:11:34.42,0:11:35.96,Default,,0,0,0,,Құрметті қонақтың сәлемі
Dialogue: 0,0:11:36.09,0:11:38.59,Default,,0,0,0,,Мен мұны айтуым керек пе?
Dialogue: 0,0:11:38.88,0:11:41.13,Default,,0,0,0,,Әрине, бұл төрағаның бұйрығы.
Dialogue: 0,0:11:41.51,0:11:44.72,Default,,0,0,0,,Қой, бұл адам мектепте ереже.
Dialogue: 0,0:11:45.01,0:11:47.30,Default,,0,0,0,,Түсіндім, қиып алайын.
Dialogue: 0,0:11:47.55,0:11:48.72,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:11:49.52,0:11:51.89,Default,,0,0,0,,Тағы да оралып келдім
Dialogue: 0,0:11:55.56,0:11:56.27,Default,,0,0,0,,О
Dialogue: 0,0:11:56.40,0:11:57.56,Default,,0,0,0,,Уау
Dialogue: 0,0:11:57.86,0:11:59.90,Default,,0,0,0,,Атқа міну тәжірибесі курсы үшін осы жерді басыңыз
Dialogue: 0,0:12:00.19,0:12:02.95,Default,,0,0,0,,Бауырым, бірдеңе тақырыптан тыс қалған сияқты.
Dialogue: 0,0:12:03.07,0:12:05.74,Default,,0,0,0,,Ол Милленің президенті болғандықтан, ол оқиғаларды жақсы көреді.
Dialogue: 0,0:12:06.03,0:12:08.16,Default,,0,0,0,,Сондай-ақ өткен жылғы кек бар.
Dialogue: 0,0:12:08.49,0:12:09.66,Default,,0,0,0,,Иә
Dialogue: 0,0:12:11.29,0:12:14.12,Default,,0,0,0,,Не істеу керек? Өйткені, ағам
Dialogue: 0,0:12:14.25,0:12:15.46,Default,,0,0,0,,Rolo Huh?
Dialogue: 0,0:12:15.75,0:12:16.63,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:12:16.83,0:12:17.46,Default,,0,0,0,,Ах
Dialogue: 0,0:12:17.88,0:12:20.38,Default,,0,0,0,,Қараңдар, осылай ұстаңдар.
Dialogue: 0,0:12:20.50,0:12:21.76,Default,,0,0,0,,Коко?
Dialogue: 0,0:12:21.88,0:12:23.26,Default,,0,0,0,,Қолдарыңызбен абай болыңыз
Dialogue: 0,0:12:23.38,0:12:24.22,Default,,0,0,0,,Иә
Dialogue: 0,0:12:32.02,0:12:33.18,Default,,0,0,0,,Аға (Лелух) иә?
Dialogue: 0,0:12:33.73,0:12:34.85,Default,,0,0,0,,«Бұл менің махаббатымның хикаясы—»
Dialogue: 0,0:12:35.39,0:12:37.56,Default,,0,0,0,,Менің Геасымның әлсіз тұсы бар.
Dialogue: 0,0:12:39.36,0:12:42.28,Default,,0,0,0,,Қызық Аня, мынаны қара.
Dialogue: 0,0:12:42.44,0:12:43.74,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:12:43.86,0:12:44.49,Default,,0,0,0,,Жазбалар
Dialogue: 0,0:12:44.78,0:12:48.16,Default,,0,0,0,,Маған ұнайсың. Не істеуім керек?
Dialogue: 0,0:12:48.28,0:12:50.20,Default,,0,0,0,,Арнайы ештеңе істемейтін сияқты.
Dialogue: 0,0:12:50.33,0:12:52.95,Default,,0,0,0,,Қарапайым мектепті көргіңіз келе ме?
Dialogue: 0,0:12:53.20,0:12:56.00,Default,,0,0,0,,Иә, иә, қазір мектеп ғимаратының астындағы қойма.
Dialogue: 0,0:12:56.37,0:12:59.54,Default,,0,0,0,,Қосалқы қуат толтырғыш қайда?
Dialogue: 0,0:13:00.00,0:13:02.30,Default,,0,0,0,,Бұл Нинадікі ме? Бұл
Dialogue: 0,0:13:02.84,0:13:05.92,Default,,0,0,0,,Кюсюдің F жағы арқылы түсіндім-
Dialogue: 0,0:13:06.05,0:13:07.55,Default,,0,0,0,,Диетардпен байланысыңыз
Dialogue: 0,0:13:08.26,0:13:10.47,Default,,0,0,0,,Ал Ракшата осында.
Dialogue: 0,0:13:12.06,0:13:12.89,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:13:13.02,0:13:15.81,Default,,0,0,0,,Біз әлемдегі ең жақсы пиццаны жасаймыз
Dialogue: 0,0:13:15.93,0:13:17.35,Default,,0,0,0,,Маған мәліметтерді айтып беріңізші
Dialogue: 0,0:13:17.48,0:13:20.94,Default,,0,0,0,,Иә, танысқаныма қуаныштымын. Әлемдегі ең жақсы пицца.
Dialogue: 0,0:13:21.07,0:13:22.27,Default,,0,0,0,,Эй (С.С.) Иә?
Dialogue: 0,0:13:22.57,0:13:23.98,Default,,0,0,0,,Сен не істеп жүрсің?
Dialogue: 0,0:13:24.28,0:13:25.90,Default,,0,0,0,,Мен оны алуым керек.
Dialogue: 0,0:13:26.86,0:13:28.53,Default,,0,0,0,,Неліктен мұндай нәрселерге мән бересің?
Dialogue: 0,0:13:28.66,0:13:29.57,Default,,0,0,0,,Әйтеуір, осында кел.
Dialogue: 0,0:13:31.78,0:13:33.20,Default,,0,0,0,,Бұл итермелейді, балам.
Dialogue: 0,0:13:33.33,0:13:36.41,Default,,0,0,0,,Тыныш, бақсы, өз ұстанымыңды түсіндің бе?
Dialogue: 0,0:13:36.83,0:13:40.58,Default,,0,0,0,,Император сені жем ретінде пайдаланып, мені нысанаға алып отыр.
Dialogue: 0,0:13:40.71,0:13:44.21,Default,,0,0,0,,Иә, Созаку бар, тағы біреуі бар.
Dialogue: 0,0:13:44.51,0:13:46.47,Default,,0,0,0,,Геассы жұмыс істемейтін әйел
Dialogue: 0,0:13:48.80,0:13:49.80,Default,,0,0,0,,Сұлу қыздан
Dialogue: 0,0:13:50.01,0:13:51.80,Default,,0,0,0,,Ересек апаларға
Dialogue: 0,0:13:52.05,0:13:55.93,Default,,0,0,0,,Жүзу клубының кафесіне қош келдіңіз
Dialogue: 0,0:13:56.39,0:13:59.31,Default,,0,0,0,,О
Dialogue: 0,0:13:59.48,0:14:02.02,Default,,0,0,0,,Мұғалімнің маған жасағанына өте қуаныштымын.
Dialogue: 0,0:14:02.36,0:14:05.69,Default,,0,0,0,,Ширли 100 рет кейін өлтіреді
Dialogue: 0,0:14:05.82,0:14:07.95,Default,,0,0,0,,Миссия болмаса, мұғалімнің рөлі т.б.
Dialogue: 0,0:14:08.78,0:14:10.95,Default,,0,0,0,,Мен мектепте мұғалім болдым.
Dialogue: 0,0:14:12.49,0:14:14.70,Default,,0,0,0,,Гурен 2 стилі бекітілді
Dialogue: 0,0:14:14.83,0:14:16.75,Default,,0,0,0,,Карен консулдықта болса керек.
Dialogue: 0,0:14:17.00,0:14:19.58,Default,,0,0,0,,Иә, қиын.
Dialogue: 0,0:14:19.71,0:14:21.63,Default,,0,0,0,,Олар оны қарсылық деп атайды.
Dialogue: 0,0:14:23.21,0:14:27.26,Default,,0,0,0,,Нинаның жағдайы жақсы. Ол өткен күні конференцияда баяндама жасады.
Dialogue: 0,0:14:27.38,0:14:29.55,Default,,0,0,0,,Ганимед Сіз оны толық пішінге айналдыруды жоспарлап отырсыз ба?
Dialogue: 0,0:14:29.80,0:14:33.01,Default,,0,0,0,,Енді Ллойд мырзаға қарағанда Нинаның мамандығы...
Dialogue: 0,0:14:33.14,0:14:33.80,Default,,0,0,0,,Ах
Dialogue: 0,0:14:35.06,0:14:37.64,Default,,0,0,0,,Эрл Ллойд, бірдеңе дедіңіз бе?
Dialogue: 0,0:14:39.56,0:14:40.48,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:14:40.60,0:14:41.98,Default,,0,0,0,,Таң қалмайсың ба?
Dialogue: 0,0:14:42.52,0:14:44.52,Default,,0,0,0,,Сіз бағаны қайталап, үйленуіңізді кейінге қалдырасыз.
Dialogue: 0,0:14:44.65,0:14:45.69,Default,,0,0,0,,Жоқ, ол адам
Dialogue: 0,0:14:45.86,0:14:46.48,Default,,0,0,0,,Мияу
Dialogue: 0,0:14:46.61,0:14:48.32,Default,,0,0,0,,Адам болған соң, дұрыс емес нәрселер көп.
Dialogue: 0,0:14:48.32,0:14:49.15,Default,,0,0,0,,Адам болған соң, дұрыс емес нәрселер көп.
Dialogue: 0,0:14:48.32,0:14:49.15,Default,,0,0,0,,Мияу
Dialogue: 0,0:14:49.28,0:14:49.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.20,0:14:51.82,Default,,0,0,0,,Мяу Мияу Мияу Мияу
Dialogue: 0,0:14:51.95,0:14:54.28,Default,,0,0,0,,Артур Бұл Юффи.
Dialogue: 0,0:14:54.49,0:14:58.08,Default,,0,0,0,,Сузаку-кун, бас кейіпкер осында күтіп тұр
Dialogue: 0,0:14:58.79,0:14:59.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:00.37,0:15:02.96,Default,,0,0,0,,Nightmareдегі алып пицца?
Dialogue: 0,0:15:04.67,0:15:07.05,Default,,0,0,0,,-де? Геассты императорға беріңіз
Dialogue: 0,0:15:07.17,0:15:09.38,Default,,0,0,0,,Созақуға үйреткен сол кісі ме?
Dialogue: 0,0:15:11.18,0:15:13.72,Default,,0,0,0,,Иә, бірақ көбірек білсеңіз
Dialogue: 0,0:15:13.84,0:15:15.43,Default,,0,0,0,,Қатысқан
Dialogue: 0,0:15:19.10,0:15:20.27,Default,,0,0,0,,V.V.
Dialogue: 0,0:15:20.81,0:15:24.06,Default,,0,0,0,,V.V.? Созакуда да Геас бар ма?
Dialogue: 0,0:15:24.19,0:15:26.19,Default,,0,0,0,,Жоқ, олай емес сияқты.
Dialogue: 0,0:15:26.57,0:15:27.94,Default,,0,0,0,,Толығырақ сіздің тарапыңызда
Dialogue: 0,0:15:28.07,0:15:28.94,Default,,0,0,0,,Леру
Dialogue: 0,0:15:29.07,0:15:29.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:30.03,0:15:31.24,Default,,0,0,0,,Не? Ширли
Dialogue: 0,0:15:31.74,0:15:32.65,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:15:33.91,0:15:35.41,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:15:35.53,0:15:36.74,Default,,0,0,0,,Бұл бір нәрсе үшін бе?
Dialogue: 0,0:15:37.16,0:15:37.99,Default,,0,0,0,,Сіз білесіз...
Dialogue: 0,0:15:38.12,0:15:41.37,Default,,0,0,0,,Профессор Виллетта менен қашып жүрген сияқты.
Dialogue: 0,0:15:41.50,0:15:44.25,Default,,0,0,0,,Сонымен Лулу жағынан, иә? Бір адам?
Dialogue: 0,0:15:44.37,0:15:45.04,Default,,0,0,0,,О
Dialogue: 0,0:15:45.75,0:15:47.67,Default,,0,0,0,,Сіз қазір біреумен сөйлесіп тұрдыңыз ба?
Dialogue: 0,0:15:47.84,0:15:50.80,Default,,0,0,0,,Жоқ, мұнда тек сен екеуміз.
Dialogue: 0,0:15:50.96,0:15:51.97,Default,,0,0,0,,...
Dialogue: 0,0:15:52.09,0:15:52.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:53.13,0:15:56.01,Default,,0,0,0,,Екі адам ғана қауіпті
Dialogue: 0,0:15:56.14,0:15:58.22,Default,,0,0,0,,Бұл мүмкіндік ретінде сезіле бастады.
Dialogue: 0,0:15:58.35,0:16:00.31,Default,,0,0,0,,Білесің бе, Лулу, менімен бірге.
Dialogue: 0,0:16:00.43,0:16:01.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:03.81,0:16:06.36,Default,,0,0,0,,Кешіріңіз, есту сәл қиын.
Dialogue: 0,0:16:06.48,0:16:08.32,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:16:08.57,0:16:11.15,Default,,0,0,0,,Адамдар сізді де көрсе, не айтасыз?
Dialogue: 0,0:16:11.28,0:16:13.61,Default,,0,0,0,,Мен сол пицца қызды қайтаруға келдім.
Dialogue: 0,0:16:13.86,0:16:15.78,Default,,0,0,0,,Содан кейін ол қызанақтың ішінде.
Dialogue: 0,0:16:15.91,0:16:17.37,Default,,0,0,0,,Контейнерді толығымен алып жүру -
Dialogue: 0,0:16:17.49,0:16:18.66,Default,,0,0,0,,Тодо немесе Оги нұсқаулары...
Dialogue: 0,0:16:18.78,0:16:20.33,Default,,0,0,0,,Оо?
Dialogue: 0,0:16:21.16,0:16:22.75,Default,,0,0,0,,Сіз кімсіз? Кешіріңіз.
Dialogue: 0,0:16:22.87,0:16:25.37,Default,,0,0,0,,Уау, не деген ыңғайсыздық.
Dialogue: 0,0:16:25.58,0:16:28.04,Default,,0,0,0,,Үндеме, бірдеңе айт
Dialogue: 0,0:16:28.25,0:16:31.42,Default,,0,0,0,,Сөйлессем, мен де табылармын.
Dialogue: 0,0:16:31.55,0:16:33.76,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:16:34.01,0:16:35.80,Default,,0,0,0,,Ширли Бұл тіршілік иесі
Dialogue: 0,0:16:35.93,0:16:37.01,Default,,0,0,0,,Лелуш
Dialogue: 0,0:16:37.39,0:16:38.76,Default,,0,0,0,,Артур, сен көрмедің бе?
Dialogue: 0,0:16:38.89,0:16:40.26,Default,,0,0,0,,Мен абайлап қолданған қалам
Dialogue: 0,0:16:40.26,0:16:40.68,Default,,0,0,0,,Мен мұқият қолданған қалам
Dialogue: 0,0:16:40.26,0:16:40.68,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:40.68,0:16:41.27,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:41.27,0:16:41.93,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:41.27,0:16:41.93,Default,,0,0,0,,Га
Dialogue: 0,0:16:41.93,0:16:42.14,Default,,0,0,0,,Га
Dialogue: 0,0:16:42.27,0:16:43.43,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:16:43.73,0:16:45.10,Default,,0,0,0,,Бұл жерде ме?
Dialogue: 0,0:16:45.23,0:16:47.73,Default,,0,0,0,,Жоқ, мысық пен қызанақ жиынтық емес.
Dialogue: 0,0:16:47.85,0:16:48.77,Default,,0,0,0,,Га
Dialogue: 0,0:16:50.15,0:16:50.94,Default,,0,0,0,,Га
Dialogue: 0,0:16:51.19,0:16:53.32,Default,,0,0,0,,Бұл бастапқы нүкте, солай ма?
Dialogue: 0,0:16:53.44,0:16:54.78,Default,,0,0,0,,Шынымен, Джино?
Dialogue: 0,0:16:54.90,0:16:57.74,Default,,0,0,0,,Әй, қызық, қарапайым мектеп.
Dialogue: 0,0:16:59.03,0:16:59.78,Default,,0,0,0,,Эй, күте тұрыңыз
Dialogue: 0,0:17:00.83,0:17:01.87,Default,,0,0,0,,Ei
Dialogue: 0,0:17:01.99,0:17:02.66,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:17:02.79,0:17:06.29,Default,,0,0,0,,Ню мияу мияу
Dialogue: 0,0:17:07.21,0:17:07.87,Default,,0,0,0,,Нуун
Dialogue: 0,0:17:08.00,0:17:09.04,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:17:09.17,0:17:10.54,Default,,0,0,0,,Артур енді?
Dialogue: 0,0:17:10.67,0:17:12.46,Default,,0,0,0,,Маған қазір тәртіпті өзгерту керек.
Dialogue: 0,0:17:12.63,0:17:15.22,Default,,0,0,0,,Біз парад жолында жүрген сияқтымыз.
Dialogue: 0,0:17:15.47,0:17:16.72,Default,,0,0,0,,Мектеп ғимаратын аралап болған соң, осында келемін.
Dialogue: 0,0:17:16.72,0:17:18.55,Default,,0,0,0,,Ол мектеп ғимаратын аралаған соң осында келеді.
Dialogue: 0,0:17:16.72,0:17:18.55,Default,,0,0,0,,Мияу мияу мияу
Dialogue: 0,0:17:18.84,0:17:21.22,Default,,0,0,0,,Бұл классикалық түн, бірақ оның жағдайы жақсы.
Dialogue: 0,0:17:21.47,0:17:25.68,Default,,0,0,0,,Ал, маршрут та жақсы, уақытты шайқаңыз.
Dialogue: 0,0:17:25.81,0:17:27.64,Default,,0,0,0,,Уау Уау Уау
Dialogue: 0,0:17:28.02,0:17:30.31,Default,,0,0,0,,Қандай қателік, сахнадағы пицца әйел.
Dialogue: 0,0:17:30.56,0:17:31.69,Default,,0,0,0,,Маған бетіңді көрсетші.
Dialogue: 0,0:17:31.82,0:17:32.98,Default,,0,0,0,,Хаа ха ха
Dialogue: 0,0:17:33.86,0:17:35.11,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:17:36.03,0:17:36.86,Default,,0,0,0,,Құт
Dialogue: 0,0:17:37.70,0:17:38.53,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:17:38.66,0:17:42.20,Default,,0,0,0,,Бұл менің жанрым.
Dialogue: 0,0:17:42.33,0:17:43.66,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:17:43.79,0:17:44.62,Default,,0,0,0,,Құт
Dialogue: 0,0:17:47.79,0:17:51.38,Default,,0,0,0,,Жеті түн, Сузаку Куруруги келді...
Dialogue: 0,0:17:51.50,0:17:54.59,Default,,0,0,0,,Анд тауларынан алынған Ultimate Tomato қосылған.
Dialogue: 0,0:17:54.96,0:17:58.72,Default,,0,0,0,,Жүр, біз сені күттік.
Dialogue: 0,0:17:59.43,0:18:00.55,Default,,0,0,0,,...бірақ
Dialogue: 0,0:18:00.68,0:18:02.47,Default,,0,0,0,,Ішіндегі адам бөлек.
Dialogue: 0,0:18:03.47,0:18:05.35,Default,,0,0,0,,Ой ой довааааааааааааааааааа
Dialogue: 0,0:18:05.47,0:18:06.10,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:18:06.43,0:18:08.69,Default,,0,0,0,,17-топ Шатырдағы бақшаға қараңдар
Dialogue: 0,0:18:09.52,0:18:11.06,Default,,0,0,0,,Не? Төраға орынбасары?
Dialogue: 0,0:18:11.19,0:18:13.57,Default,,0,0,0,,Жүйе үлгісі Ruge
Dialogue: 0,0:18:17.61,0:18:18.45,Default,,0,0,0,,О
Dialogue: 0,0:18:19.03,0:18:20.61,Default,,0,0,0,,Жүйе үлгісі Ruge
Dialogue: 0,0:18:20.86,0:18:22.28,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:18:20.86,0:18:22.28,Default,,0,0,0,,Өрт сөндіргіш газ сөне бастайды
Dialogue: 0,0:18:22.28,0:18:23.16,Default,,0,0,0,,Өрт сөндіргіш газ сөне бастайды
Dialogue: 0,0:18:23.28,0:18:24.28,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:18:26.45,0:18:27.50,Default,,0,0,0,,Уау (оқушы қыз) Кя
Dialogue: 0,0:18:27.62,0:18:29.67,Default,,0,0,0,,Не? Уаау уау
Dialogue: 0,0:18:29.79,0:18:32.08,Default,,0,0,0,,Хахахахахахахахаха
Dialogue: 0,0:18:32.21,0:18:35.42,Default,,0,0,0,,Не, бұл таңқаларлық па?
Dialogue: 0,0:18:35.55,0:18:36.76,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:18:36.88,0:18:38.34,Default,,0,0,0,,Уф
Dialogue: 0,0:18:38.51,0:18:40.59,Default,,0,0,0,,Кешіріңіз, жақсысыз ба?
Dialogue: 0,0:18:40.72,0:18:42.97,Default,,0,0,0,,Бұл сенікі емес қой…
Dialogue: 0,0:18:43.10,0:18:44.05,Default,,0,0,0,,Ах
Dialogue: 0,0:18:44.47,0:18:45.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:45.43,0:18:46.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:46.39,0:18:47.18,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:18:47.31,0:18:49.52,Default,,0,0,0,,Жазу Рахмет
Dialogue: 0,0:18:49.73,0:18:51.35,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:18:51.52,0:18:52.77,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:18:53.69,0:18:56.69,Default,,0,0,0,,Бірақ мұндай мораторий де бар ма?
Dialogue: 0,0:18:57.11,0:18:58.15,Default,,0,0,0,,жеткілікті
Dialogue: 0,0:18:59.53,0:19:02.78,Default,,0,0,0,,Демек, Каренді көрген адам жүзу командасында болды ма?
Dialogue: 0,0:19:02.91,0:19:04.41,Default,,0,0,0,,Бұл сенің мұғалімің емес пе?
Dialogue: 0,0:19:04.53,0:19:05.37,Default,,0,0,0,,Виллетта?
Dialogue: 0,0:19:05.49,0:19:08.16,Default,,0,0,0,,Тіпті аты біртүрлі.
Dialogue: 0,0:19:08.45,0:19:11.79,Default,,0,0,0,,Алдыңғы мектеп фестивалінде Оги-санмен бірге болған адам сияқты.
Dialogue: 0,0:19:12.17,0:19:13.79,Default,,0,0,0,,Виллетта Угимен бірге?
Dialogue: 0,0:19:13.92,0:19:17.96,Default,,0,0,0,,Минами-сан оның тікелей Оги-санның астыртын серіктесі болуы мүмкін екенін айтты.
Dialogue: 0,0:19:18.09,0:19:20.97,Default,,0,0,0,,Жанкүйер? Менен сыр сақтайсың ба?
Dialogue: 0,0:19:21.09,0:19:23.72,Default,,0,0,0,,Сіз мұндай нәрселерге сезімталсыз.
Dialogue: 0,0:19:25.01,0:19:25.93,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:19:27.72,0:19:30.27,Default,,0,0,0,,Роло аударылды ма?
Dialogue: 0,0:19:30.77,0:19:32.10,Default,,0,0,0,,Виллетта Нуу
Dialogue: 0,0:19:32.23,0:19:36.06,Default,,0,0,0,,Нөлдің шынайы болмысын ашқаны үшін барон дәрежесіне ие болған әйел.
Dialogue: 0,0:19:36.52,0:19:39.19,Default,,0,0,0,,Бірақ сахнаның артында ол Қара рыцарлармен байланысты болды.
Dialogue: 0,0:19:39.32,0:19:40.53,Default,,0,0,0,,Мұндай жолдан таюшылық
Dialogue: 0,0:19:40.69,0:19:41.78,Default,,0,0,0,,Желдеткіш пернесі
Dialogue: 0,0:19:41.90,0:19:42.90,Default,,0,0,0,,Уф
Dialogue: 0,0:19:43.03,0:19:44.87,Default,,0,0,0,,Егер сіздің онымен қарым-қатынасыңыз белгілі болса...
Dialogue: 0,0:19:44.99,0:19:48.03,Default,,0,0,0,,Сіз алғаныңыздың бәрін жоғалтасыз.
Dialogue: 0,0:19:48.16,0:19:51.00,Default,,0,0,0,,Жаңа сіз болып қайта туғыңыз келе ме?
Dialogue: 0,0:19:51.29,0:19:54.04,Default,,0,0,0,,Мұны маған Ширли берді...
Dialogue: 0,0:19:54.17,0:19:55.42,Default,,0,0,0,,Бұл жақсы уақыт болды.
Dialogue: 0,0:19:57.88,0:20:01.01,Default,,0,0,0,,Виллетта мырзаны туған күнімен құттықтаймын
Dialogue: 0,0:20:05.34,0:20:07.18,Default,,0,0,0,,Мен сізге тағы да қарыздар сияқтымын.
Dialogue: 0,0:20:07.64,0:20:09.93,Default,,0,0,0,,Мен жай ғана дипломатиялық иммунитетті қолдандым.
Dialogue: 0,0:20:10.06,0:20:13.60,Default,,0,0,0,,Сонымен қатар, мен қарызымды тезірек өтегім келеді.
Dialogue: 0,0:20:13.81,0:20:16.27,Default,,0,0,0,,Олай болса, сізден тағы бір нәрсе сұрасам болады ма?
Dialogue: 0,0:20:16.77,0:20:18.86,Default,,0,0,0,,Менің танысуға ниетім жоқ, бірақ
Dialogue: 0,0:20:19.07,0:20:21.11,Default,,0,0,0,,Ұлы Евнухпен байланысқаныңызды қалаймын.
Dialogue: 0,0:20:21.23,0:20:21.86,Default,,0,0,0,,Га
Dialogue: 0,0:20:24.65,0:20:26.87,Default,,0,0,0,,Созақу ғана стратегия қалды
Dialogue: 0,0:20:26.99,0:20:28.45,Default,,0,0,0,,Лелуш (Лелуш)
Dialogue: 0,0:20:29.45,0:20:31.41,Default,,0,0,0,,Басты кейіпкер басты сахнада болуы керек.
Dialogue: 0,0:20:31.54,0:20:32.62,Default,,0,0,0,,Иә? Жоқ-
Dialogue: 0,0:20:33.21,0:20:35.37,Default,,0,0,0,,Барлығы көңіл көтеріп жатқан сияқты.
Dialogue: 0,0:20:35.50,0:20:41.51,Default,,0,0,0,,♪～
Dialogue: 0,0:20:47.43,0:20:49.81,Default,,0,0,0,,Сонымен қатар, мен бір нәрсе туралы айтқым келеді.
Dialogue: 0,0:20:49.93,0:20:51.14,Default,,0,0,0,,Не?
Dialogue: 0,0:20:52.02,0:20:55.06,Default,,0,0,0,,Мен Бірдің Рыцарь боламын.
Dialogue: 0,0:20:55.19,0:20:57.56,Default,,0,0,0,,Эй, эй, бұл империяның ең жақсы сері...
Dialogue: 0,0:20:57.69,0:20:59.40,Default,,0,0,0,,Бірлік Рыцарының артықшылығына -
Dialogue: 0,0:20:59.52,0:21:01.98,Default,,0,0,0,,Сіз өзіңіз таңдаған бір аймақты ала аласыз.
Dialogue: 0,0:21:02.73,0:21:06.03,Default,,0,0,0,,Мен бұл аймақты Жапониядан аламын.
Dialogue: 0,0:21:10.53,0:21:13.25,Default,,0,0,0,,Мен қымбатты досыммен...
Dialogue: 0,0:21:13.37,0:21:15.62,Default,,0,0,0,,Орны толмас әйелден айырылды
Dialogue: 0,0:21:15.87,0:21:18.42,Default,,0,0,0,,Адамдарды жоғалтпау үшін...
Dialogue: 0,0:21:18.54,0:21:20.34,Default,,0,0,0,,Күшке ие болу
Dialogue: 0,0:21:21.84,0:21:25.26,Default,,0,0,0,,Сондықтан жапондықтарға енді нөл қажет емес.
Dialogue: 0,0:21:25.38,0:21:29.47,Default,,0,0,0,,Хмм, жанама басқаруды немесе протекторатты мақсат ету ме?
Dialogue: 0,0:21:29.59,0:21:31.43,Default,,0,0,0,,Жауап осы адам
Dialogue: 0,0:21:31.56,0:21:32.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:32.56,0:21:35.64,Default,,0,0,0,,Мен келесі аптада 11-аймақтың жаңа губернаторымын.
Dialogue: 0,0:21:36.10,0:21:37.94,Default,,0,0,0,,Губернатормен жай ғана студент пе?
Dialogue: 0,0:21:38.23,0:21:39.48,Default,,0,0,0,,Бұл Куруруги
Dialogue: 0,0:21:40.15,0:21:43.53,Default,,0,0,0,,Иә Дәл қазір менің алдымда Иә
Dialogue: 0,0:21:44.78,0:21:48.28,Default,,0,0,0,,Мені осындай ұлы тұлға мазалайды.
Dialogue: 0,0:21:48.41,0:21:49.87,Default,,0,0,0,,Сәлеметсіз бе, аға?
Dialogue: 0,0:21:49.99,0:21:50.91,Default,,0,0,0,,На
Dialogue: 0,0:21:51.74,0:21:55.20,Default,,0,0,0,,Бұл сенің ағаң емес пе? Бұл менмін, Нанналли.
Dialogue: 0,0:21:55.33,0:21:56.96,Default,,0,0,0,,Генерал-губернатор ретінде
Dialogue: 0,0:21:58.21,0:22:00.17,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:22:00.29,0:22:02.96,Default,,0,0,0,,Аға? Мен Нуналлимін
Dialogue: 0,0:22:03.38,0:22:08.13,Default,,0,0,0,,♪Мен оны бір күні кеудемнен таптым
Dialogue: 0,0:22:08.26,0:22:14.85,Default,,0,0,0,,♪Бақыт бөліктерін жинап алайық
Dialogue: 0,0:22:14.97,0:22:19.85,Default,,0,0,0,,♪Ұмытып қала жаздаған әуен
Dialogue: 0,0:22:19.98,0:22:26.94,Default,,0,0,0,,♪Ортада сөнбестен
Dialogue: 0,0:22:30.16,0:22:34.78,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:34.91,0:22:40.08,Default,,0,0,0,,♪Қазіргі жерде болғаным барлығына рахмет.
Dialogue: 0,0:22:40.21,0:22:44.75,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:44.88,0:22:47.59,Default,,0,0,0,,♪Келесі мен бәріне айтамын
Dialogue: 0,0:22:47.71,0:22:51.05,Default,,0,0,0,,♪БАҚЫТТЫ Мен саған Уау беремін
Dialogue: 0,0:22:51.18,0:22:56.18,Default,,0,0,0,,♪Мен ештеңені ұмытпаймын
Dialogue: 0,0:22:56.31,0:23:02.77,Default,,0,0,0,,♪Себебі мен де сол күні менмін
Dialogue: 0,0:23:02.90,0:23:07.86,Default,,0,0,0,,♪Мен әрқашан сені сүйемін деп айтамын
Dialogue: 0,0:23:07.98,0:23:11.99,Default,,0,0,0,,♪Сен маған айтуың керек.
Dialogue: 0,0:23:12.11,0:23:16.37,Default,,0,0,0,,♪ Көз жасы ағып кете жаздады
Dialogue: 0,0:23:16.49,0:23:23.04,Default,,0,0,0,,♪Ұзақ түнде кенет артыма қарадым
Dialogue: 0,0:23:23.17,0:23:27.17,Default,,0,0,0,,♪Адамның ізімен жүру
Dialogue: 0,0:23:27.30,0:23:34.26,Default,,0,0,0,,♪Сол күнді ұмытпа
Dialogue: 0,0:23:38.52,0:23:40.64,Default,,0,0,0,,Созаку Нуналлиді тұзақ ретінде пайдаланады...
Dialogue: 0,0:23:41.06,0:23:43.14,Default,,0,0,0,,Tsk Nunnally
Dialogue: 0,0:23:43.27,0:23:44.90,Default,,0,0,0,,Қанша дос болып көрінсең де...
Dialogue: 0,0:23:45.02,0:23:48.65,Default,,0,0,0,,Сенің болмысың – мені императорға сатқан бейбақ.
Dialogue: 0,0:23:48.78,0:23:51.15,Default,,0,0,0,,Сіздің Нуналлидің жағында екеніңіз
Dialogue: 0,0:23:52.65,0:23:58.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory