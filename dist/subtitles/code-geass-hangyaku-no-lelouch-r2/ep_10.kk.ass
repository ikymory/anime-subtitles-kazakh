Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.10,0:00:03.73,Default,,0,0,0,,Әлемді билеуші үш ірі держава
Dialogue: 0,0:00:03.94,0:00:05.19,Default,,0,0,0,,Олардың екеуі -
Dialogue: 0,0:00:05.40,0:00:08.32,Default,,0,0,0,,Қасиетті Британ империясы мен Қытай Федерациясы...
Dialogue: 0,0:00:08.44,0:00:11.49,Default,,0,0,0,,Ыңғайлы неке арқылы бір болуға тырысу
Dialogue: 0,0:00:11.94,0:00:16.28,Default,,0,0,0,,Нөл АҚШ пен Жапониядағы ең үлкен дағдарысқа қарсы әрекет етеді.
Dialogue: 0,0:00:16.41,0:00:19.24,Default,,0,0,0,,Қытай Федерациясының символы: Мен Аспан Ұлын алып кетемін.
Dialogue: 0,0:00:21.12,0:00:23.79,Default,,0,0,0,,Армандар сіздің тағдырыңызды ашады ма?
Dialogue: 0,0:00:24.33,0:00:27.04,Default,,0,0,0,,Ой бәрінен асып түсе ала ма?
Dialogue: 0,0:00:27.96,0:00:28.88,Default,,0,0,0,,Эфемерлі гүлдер – бұл...
Dialogue: 0,0:00:29.30,0:00:31.67,Default,,0,0,0,,Әдетте желде билесе де
Dialogue: 0,0:00:32.21,0:00:37.64,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:00:37.76,0:00:40.43,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:00:40.56,0:00:43.35,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:00:43.48,0:00:48.90,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:00:49.02,0:00:51.90,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:00:52.03,0:00:54.74,Default,,0,0,0,,♪Енді кеттік, мен аққан жұлдызмын
Dialogue: 0,0:01:00.53,0:01:06.00,Default,,0,0,0,,♪Дүние ыдыраса да, ешқашан өзгермейтін нәрселер бар.
Dialogue: 0,0:01:06.12,0:01:11.59,Default,,0,0,0,,♪Көз жасымызды тыйсақ та, қорғайтын нәрсе бар.
Dialogue: 0,0:01:11.71,0:01:14.47,Default,,0,0,0,,♪Он мыңдаған жылдар бұрынғы хабарлар дененің ішінде.
Dialogue: 0,0:01:14.59,0:01:17.01,Default,,0,0,0,,♪Сырылдап, дыбыстай бастайды
Dialogue: 0,0:01:17.30,0:01:19.93,Default,,0,0,0,,♪Ертең қарлығаш дауыспен қоңырау шалыңыз
Dialogue: 0,0:01:20.10,0:01:23.06,Default,,0,0,0,,♪Мен сені тыртық қолыммен қорғаймын
Dialogue: 0,0:01:23.31,0:01:26.10,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:01:26.23,0:01:28.65,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:01:30.27,0:01:35.53,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:01:35.65,0:01:37.99,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:01:38.45,0:01:41.28,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:01:41.41,0:01:46.79,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:01:46.91,0:01:49.42,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:01:49.54,0:01:54.00,Default,,0,0,0,,♪Тағдырды кесіп өткен аққан жұлдыз
Dialogue: 0,0:01:54.13,0:01:58.47,Default,,0,0,0,,♪Тасып жатқан көз жасыңды мен қазір алып кетемін
Dialogue: 0,0:02:06.89,0:02:09.10,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:02:09.69,0:02:11.65,Default,,0,0,0,,Қарин-сама, күткендей, көрермен...
Dialogue: 0,0:02:11.77,0:02:13.48,Default,,0,0,0,,Мен алаңнан шықтым...
Dialogue: 0,0:02:13.61,0:02:14.90,Default,,0,0,0,,Нөлдің пайда болғаны туралы да есептер бар.
Dialogue: 0,0:02:15.32,0:02:16.90,Default,,0,0,0,,Нөл? 3 топ-
Dialogue: 0,0:02:17.32,0:02:19.11,Default,,0,0,0,,Кіру жағдайын хабарлау
Dialogue: 0,0:02:19.24,0:02:21.82,Default,,0,0,0,,3-команда Шинку-саманың қолдауы дайын ба?
Dialogue: 0,0:02:22.91,0:02:26.41,Default,,0,0,0,,Біздің стратегиямызды Zero пайдаланып жатқан болуы мүмкін бе?
Dialogue: 0,0:02:26.75,0:02:27.79,Default,,0,0,0,,Жұлдызша ою
Dialogue: 0,0:02:27.91,0:02:31.46,Default,,0,0,0,,Хошикоку) Нөл, императорды қайтару ойың жоқ па?
Dialogue: 0,0:02:32.00,0:02:33.17,Default,,0,0,0,,Жұлдызша ою
Dialogue: 0,0:02:33.29,0:02:36.09,Default,,0,0,0,,Аспан Ұлын азат ете аламын деп ойлайсың ба?
Dialogue: 0,0:02:36.21,0:02:36.84,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:02:39.13,0:02:43.18,Default,,0,0,0,,Қарғыс атқыр, сен Nightmare-ге дайындалдың ба?
Dialogue: 0,0:02:43.60,0:02:46.14,Default,,0,0,0,,Я, бұл Зангецудың бірінші жұмысы екеніне сене алар емеспін...
Dialogue: 0,0:02:46.27,0:02:48.52,Default,,0,0,0,,Қалыңдықты тонауда не көмектеседі?
Dialogue: 0,0:02:48.64,0:02:50.06,Default,,0,0,0,,Тодо Шнайзел
Dialogue: 0,0:02:50.19,0:02:50.81,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:50.94,0:02:51.98,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:02:52.94,0:02:53.81,Default,,0,0,0,,Сен әлі келдің бе?
Dialogue: 0,0:02:55.65,0:02:56.57,Default,,0,0,0,,Жоғары мәртебелі сізге оны бермейді.
Dialogue: 0,0:02:56.86,0:02:58.07,Default,,0,0,0,,Сузаку-кун
Dialogue: 0,0:02:58.36,0:03:00.28,Default,,0,0,0,,Сіз Тодо-сансыз ба?
Dialogue: 0,0:03:00.65,0:03:01.99,Default,,0,0,0,,Мәртебелі, қазір.
Dialogue: 0,0:03:02.11,0:03:04.03,Default,,0,0,0,,Оған көмектесу мүмкін емес, ағайын.
Dialogue: 0,0:03:04.16,0:03:05.41,Default,,0,0,0,,Иә
Dialogue: 0,0:03:05.70,0:03:07.66,Default,,0,0,0,,Га Шнайзел
Dialogue: 0,0:03:07.91,0:03:09.96,Default,,0,0,0,,) Қалғанын әскерилерге қалдыр.
Dialogue: 0,0:03:10.08,0:03:10.71,Default,,0,0,0,,Иә
Dialogue: 0,0:03:11.00,0:03:12.88,Default,,0,0,0,,Нөл Бұл жоспарланғандай.
Dialogue: 0,0:03:13.00,0:03:14.79,Default,,0,0,0,,Жарайды, үшінші кезеңге өтіңіз.
Dialogue: 0,0:03:15.13,0:03:16.00,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:20.01,0:03:21.13,Default,,0,0,0,,Жұлдызша ою
Dialogue: 0,0:03:21.34,0:03:22.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:23.01,0:03:24.18,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:03:30.64,0:03:31.85,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:34.94,0:03:36.11,Default,,0,0,0,,Гүрен сияқты жүйе?
Dialogue: 0,0:03:36.44,0:03:37.82,Default,,0,0,0,,Менің қолымнан келеді деп ойлаймын.
Dialogue: 0,0:03:38.28,0:03:41.20,Default,,0,0,0,,Осы Зангецумен қарсыласы Сузаку-кун болса да,
Dialogue: 0,0:03:41.57,0:03:43.91,Default,,0,0,0,,Бірақ егер бұл
Dialogue: 0,0:03:44.03,0:03:45.12,Default,,0,0,0,,Тәтті
Dialogue: 0,0:03:46.12,0:03:48.04,Default,,0,0,0,,Мен атуға бола ма? Осы ұстаныммен
Dialogue: 0,0:03:48.33,0:03:50.20,Default,,0,0,0,,Қарғыс атсын Шукин қаласы.
Dialogue: 0,0:03:50.33,0:03:53.29,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:54.04,0:03:55.92,Default,,0,0,0,,Сузаку Куруруги
Dialogue: 0,0:03:56.13,0:03:57.75,Default,,0,0,0,,Кагаширо Тодо әлі
Dialogue: 0,0:03:58.09,0:03:59.51,Default,,0,0,0,,Көлеңке қылыш
Dialogue: 0,0:04:00.38,0:04:01.97,Default,,0,0,0,,Қалқымалы зат туралы
Dialogue: 0,0:04:04.01,0:04:05.93,Default,,0,0,0,,Уф, бізде мұндай қару-жарақ әлі жоқ.
Dialogue: 0,0:04:06.39,0:04:08.43,Default,,0,0,0,,Орындау: Әзірге қалдырыңыз.
Dialogue: 0,0:04:08.56,0:04:11.43,Default,,0,0,0,,Ланселоттың қалтқысын жою жеткілікті.
Dialogue: 0,0:04:11.56,0:04:13.89,Default,,0,0,0,,Өйткені олар енді бізге ілесе алмайды.
Dialogue: 0,0:04:14.02,0:04:15.06,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:15.60,0:04:18.11,Default,,0,0,0,,) Жақында Аспан Ұлы Шукин қаласының сыртында болады.
Dialogue: 0,0:04:18.23,0:04:18.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:20.32,0:04:22.11,Default,,0,0,0,,Айдаһарларды айналдыр, көктің ұлы.
Dialogue: 0,0:04:22.24,0:04:25.70,Default,,0,0,0,,Ол жерден өзімізге байланысты.
Dialogue: 0,0:04:25.82,0:04:26.82,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:04:29.41,0:04:33.33,Default,,0,0,0,,Біздің радиолокациялық бақылау желісіндегі бос орынды пайдаланып қашуды жоспарлап отырсыз ба?
Dialogue: 0,0:04:33.66,0:04:35.75,Default,,0,0,0,,Мүмкін емес, білу мүмкін емес
Dialogue: 0,0:04:36.25,0:04:38.75,Default,,0,0,0,,Жапон халқы осында шайып кеткен соң...
Dialogue: 0,0:04:38.88,0:04:40.88,Default,,0,0,0,,10 күннен аз уақыт өтсе де
Dialogue: 0,0:04:42.55,0:04:45.68,Default,,0,0,0,,Жалпы Тодо Біз толықтыруды Чибаның таңында бастаймыз.
Dialogue: 0,0:04:45.93,0:04:47.01,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:47.14,0:04:49.47,Default,,0,0,0,,Зангецу мен Гурен Икаругаға қайтып келгенше күте алады.
Dialogue: 0,0:04:49.60,0:04:50.72,Default,,0,0,0,,Ендеше реттеліп көрейік.
Dialogue: 0,0:04:51.35,0:04:52.93,Default,,0,0,0,,Жарайды, келесі солға.
Dialogue: 0,0:04:53.18,0:04:54.10,Default,,0,0,0,,) Солай болды ма?
Dialogue: 0,0:04:54.23,0:04:55.64,Default,,0,0,0,,Ах, қате (C.C.) Бұл
Dialogue: 0,0:04:56.65,0:04:57.48,Default,,0,0,0,,Уау
Dialogue: 0,0:04:57.60,0:04:59.06,Default,,0,0,0,,Амансың ба? Император
Dialogue: 0,0:04:59.61,0:05:01.57,Default,,0,0,0,,Бұл сыртта ма?
Dialogue: 0,0:05:01.69,0:05:04.36,Default,,0,0,0,,Иә, сондай зорлық-зомбылықпен...
Dialogue: 0,0:05:04.49,0:05:07.16,Default,,0,0,0,,Аспан баласының арманы орындалады.
Dialogue: 0,0:05:07.28,0:05:10.66,Default,,0,0,0,,А, сен де есіңе түсірдің.
Dialogue: 0,0:05:15.25,0:05:17.37,Default,,0,0,0,,Бұл тым тұрақты.
Dialogue: 0,0:05:17.50,0:05:18.71,Default,,0,0,0,,Тек сол жаққа барыңыз.
Dialogue: 0,0:05:21.50,0:05:22.84,Default,,0,0,0,,OK Келесі оң жақ
Dialogue: 0,0:05:22.96,0:05:24.26,Default,,0,0,0,,Жоқ, ол түзу.
Dialogue: 0,0:05:24.38,0:05:25.59,Default,,0,0,0,,Сіз жолды білесіз бе?
Dialogue: 0,0:05:26.34,0:05:28.51,Default,,0,0,0,,Біраз уақыт бұрын
Dialogue: 0,0:05:30.30,0:05:32.76,Default,,0,0,0,,Біздің ел, АҚШ, Жапония...
Dialogue: 0,0:05:32.89,0:05:36.23,Default,,0,0,0,,Өзін Америка Құрама Штаттарының үлкен одағының бөлігі деп санайды
Dialogue: 0,0:05:36.52,0:05:37.81,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:05:37.94,0:05:41.23,Default,,0,0,0,,Америка Құрама Штаттары Қытай Сондықтан сіз бізге керексіз
Dialogue: 0,0:05:41.82,0:05:43.69,Default,,0,0,0,,Оңтүстік провинциядағы Үндістанның әскери аймағы қандай?
Dialogue: 0,0:05:43.82,0:05:45.40,Default,,0,0,0,,Бір әңгіме бар
Dialogue: 0,0:05:45.53,0:05:47.20,Default,,0,0,0,,Моңғолия мен Бирма да көшеді.
Dialogue: 0,0:05:47.32,0:05:48.82,Default,,0,0,0,,Америка Құрама Штаттарының Одағы —
Dialogue: 0,0:05:48.95,0:05:51.16,Default,,0,0,0,,Британияға қарсы тұратын ось болыңыз
Dialogue: 0,0:05:52.87,0:05:55.41,Default,,0,0,0,,Бірақ біздің еліміздің федеративтік жүйе екені рас.
Dialogue: 0,0:05:55.54,0:05:57.58,Default,,0,0,0,,Жүйелердің де қызмет ету мерзімі бар.
Dialogue: 0,0:05:57.71,0:05:59.75,Default,,0,0,0,,Ұлы евнух өзін қорғау үшін болды.
Dialogue: 0,0:05:59.88,0:06:02.17,Default,,0,0,0,,Сізді Британияға сатуға тырысты.
Dialogue: 0,0:06:02.29,0:06:04.30,Default,,0,0,0,,Қабылданбайды
Dialogue: 0,0:06:04.55,0:06:07.72,Default,,0,0,0,,Бұл қиын оқиға
Dialogue: 0,0:06:07.84,0:06:08.80,Default,,0,0,0,,Аспан Ұлы
Dialogue: 0,0:06:08.93,0:06:09.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:10.22,0:06:13.35,Default,,0,0,0,,Reiseiki Сіз болашақ туралы сөйлескен адамсыз ба?
Dialogue: 0,0:06:13.56,0:06:17.64,Default,,0,0,0,,Не? Тек осылай уәде беріңіз
Dialogue: 0,0:06:17.77,0:06:19.14,Default,,0,0,0,,Қалыңдық ретінде ме?
Dialogue: 0,0:06:19.27,0:06:23.27,Default,,0,0,0,,А, мен алты жыл бұрын далаға шыққым келген.
Dialogue: 0,0:06:23.40,0:06:26.94,Default,,0,0,0,,Баяғыда ма? Ол бақытты адам
Dialogue: 0,0:06:27.07,0:06:28.45,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:06:28.57,0:06:29.61,Default,,0,0,0,,Жақсы
Dialogue: 0,0:06:30.86,0:06:33.20,Default,,0,0,0,,Жарайды ма? Оны Кагураяға қалдырыңыз
Dialogue: 0,0:06:33.70,0:06:36.12,Default,,0,0,0,,Ол логикалық сөйлейтін типке ұқсамайды.
Dialogue: 0,0:06:36.62,0:06:37.33,Default,,0,0,0,,Сіз мұны жақсы емессіз бе?
Dialogue: 0,0:06:37.83,0:06:39.16,Default,,0,0,0,,Тек талдау қиын.
Dialogue: 0,0:06:39.58,0:06:42.79,Default,,0,0,0,,Эй, Нөл, менің орным әлі шешілген жоқ.
Dialogue: 0,0:06:43.92,0:06:45.42,Default,,0,0,0,,Қазір тым кеш...
Dialogue: 0,0:06:45.55,0:06:47.80,Default,,0,0,0,,Қаржы министрі немесе қаржы хатшысы лауазымы
Dialogue: 0,0:06:47.92,0:06:49.76,Default,,0,0,0,,Тамаки – банкеттер жөніндегі бас министр
Dialogue: 0,0:06:50.01,0:06:52.59,Default,,0,0,0,,Мен саған бұлай әзіл-қалжыңды доғар деп айтып жатырмын.
Dialogue: 0,0:06:52.80,0:06:54.60,Default,,0,0,0,,Ей, біз ең жақын дос емеспіз бе?
Dialogue: 0,0:06:54.72,0:06:57.10,Default,,0,0,0,,Біз бұл туралы осы тапсырманы орындағаннан кейін айтамыз.
Dialogue: 0,0:06:57.47,0:06:58.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:00.10,0:07:02.31,Default,,0,0,0,,Не? Көпір кетті ме?
Dialogue: 0,0:07:03.56,0:07:05.11,Default,,0,0,0,,Тыйым салынған армия 4-ші гарнизонды басыңыз
Dialogue: 0,0:07:05.23,0:07:08.07,Default,,0,0,0,,Нысан қазіргі уақытта Шэньчжэнде тоқтатылған.
Dialogue: 0,0:07:08.19,0:07:09.53,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:07:09.65,0:07:10.99,Default,,0,0,0,,Фуфу
Dialogue: 0,0:07:11.11,0:07:13.03,Default,,0,0,0,,Ол күткендей жұмыс істеді.
Dialogue: 0,0:07:13.16,0:07:14.12,Default,,0,0,0,,Асахина!
Dialogue: 0,0:07:14.24,0:07:16.58,Default,,0,0,0,,Иә, иә, барлық әскерлер шабуылға дайындалуда.
Dialogue: 0,0:07:19.37,0:07:20.46,Default,,0,0,0,,Фу тұтқыны?
Dialogue: 0,0:07:21.12,0:07:22.87,Default,,0,0,0,,Жау оң және сол жақтан қоршауға алынды.
Dialogue: 0,0:07:23.00,0:07:24.63,Default,,0,0,0,,Иә, тез атыңыз.
Dialogue: 0,0:07:24.75,0:07:26.29,Default,,0,0,0,,Күте тұрыңыз, император келді
Dialogue: 0,0:07:26.75,0:07:29.46,Default,,0,0,0,,Олай болса, жаңа үлгіні сынақтан түсіріп көрейік.
Dialogue: 0,0:07:35.22,0:07:36.97,Default,,0,0,0,,Қуғын-сүргін күші жеңілді, солай ма?
Dialogue: 0,0:07:37.56,0:07:38.97,Default,,0,0,0,,Акихабарадан кет, түсіндің бе?!
Dialogue: 0,0:07:39.10,0:07:40.81,Default,,0,0,0,,Орналасқан жері: Шэньчжэн алқабы
Dialogue: 0,0:07:40.93,0:07:43.98,Default,,0,0,0,,Мен болсам, сол жерде жатып, әскерді тоқтатар едім.
Dialogue: 0,0:07:44.10,0:07:45.27,Default,,0,0,0,,Сонда?
Dialogue: 0,0:07:45.40,0:07:47.48,Default,,0,0,0,,Сяо Пейде негізгі күшпен кездеседі.
Dialogue: 0,0:07:47.61,0:07:48.40,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:49.11,0:07:51.74,Default,,0,0,0,,Жұлдызды сағат Сіз күнәларыңызды кешіре аласыз
Dialogue: 0,0:07:51.86,0:07:54.03,Default,,0,0,0,,Аспан Ұлын қайтарып алсам ғой.
Dialogue: 0,0:07:54.16,0:07:55.91,Default,,0,0,0,,Оны сізге беруге рұқсат етіңіз.
Dialogue: 0,0:07:56.24,0:07:57.08,Default,,0,0,0,,Га
Dialogue: 0,0:07:59.49,0:08:01.00,Default,,0,0,0,,Одиссей князі ше?
Dialogue: 0,0:08:01.12,0:08:02.46,Default,,0,0,0,,Сіз тынышталған сияқтысыз.
Dialogue: 0,0:08:02.58,0:08:03.83,Default,,0,0,0,,Ол демалып жатыр.
Dialogue: 0,0:08:03.96,0:08:07.29,Default,,0,0,0,,Енді Ланселоттың бөлімшесі ауыстырылғаннан кейін мен императорды жіберемін.
Dialogue: 0,0:08:07.42,0:08:08.75,Default,,0,0,0,,Бұдан әрі әскери іс-қимылдар жоқ--
Dialogue: 0,0:08:08.88,0:08:10.84,Default,,0,0,0,,Қытай Федерациясының сұрауы қажет.
Dialogue: 0,0:08:11.09,0:08:13.09,Default,,0,0,0,,Бұл түсінікті, бірақ
Dialogue: 0,0:08:15.05,0:08:16.85,Default,,0,0,0,,Мен күткеннен де тегіс болды.
Dialogue: 0,0:08:17.43,0:08:20.27,Default,,0,0,0,,Мұның бәрі Сейки мен басқалардың арқасында.
Dialogue: 0,0:08:21.27,0:08:23.44,Default,,0,0,0,,Бұл жігіт өте жақсы.
Dialogue: 0,0:08:23.56,0:08:26.81,Default,,0,0,0,,Олардың төңкеріс жасамақ болғанын қайдан білдің?
Dialogue: 0,0:08:28.86,0:08:31.44,Default,,0,0,0,,Мен де солай істеуге тырыстым.
Dialogue: 0,0:08:31.78,0:08:33.45,Default,,0,0,0,,ECM және буксирлеу де?
Dialogue: 0,0:08:33.99,0:08:35.66,Default,,0,0,0,,Ах, бірақ-
Dialogue: 0,0:08:35.78,0:08:37.95,Default,,0,0,0,,Біреу ықтимал бағыттардың біріне жетекшілік етті...
Dialogue: 0,0:08:38.08,0:08:39.70,Default,,0,0,0,,трюк орнатуға тырысты
Dialogue: 0,0:08:39.83,0:08:40.74,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:40.87,0:08:44.46,Default,,0,0,0,,Сол жерде болған көтерілісші солдат ақиқат сарысуын қолданды ма?
Dialogue: 0,0:08:45.25,0:08:47.00,Default,,0,0,0,,Ол Геасс деп аталады
Dialogue: 0,0:08:47.21,0:08:47.92,Default,,0,0,0,,Иә
Dialogue: 0,0:08:50.09,0:08:51.46,Default,,0,0,0,,Хорай аралындағы жағдай қандай?
Dialogue: 0,0:08:51.59,0:08:52.67,Default,,0,0,0,,Үндістаннан келген күшейтулер -
Dialogue: 0,0:08:52.80,0:08:54.55,Default,,0,0,0,,Қазірдің өзінде келді
Dialogue: 0,0:08:54.67,0:08:56.72,Default,,0,0,0,,) Бар болғаны қайтып, кездесу...
Dialogue: 0,0:08:56.84,0:08:57.76,Default,,0,0,0,,Император туралы не деуге болады?
Dialogue: 0,0:08:57.89,0:08:58.51,Default,,0,0,0,,Уау
Dialogue: 0,0:08:58.60,0:08:59.10,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:59.10,0:08:59.93,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:59.10,0:08:59.93,Default,,0,0,0,,Жау шабуылы?
Dialogue: 0,0:08:59.93,0:09:00.51,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:09:00.51,0:09:02.93,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:09:00.51,0:09:02.93,Default,,0,0,0,,Жетекші Nightmare бөлімі жойылуда.
Dialogue: 0,0:09:03.31,0:09:04.85,Default,,0,0,0,,Тоқта, барлық әскерлер тоқтатылды.
Dialogue: 0,0:09:07.02,0:09:10.15,Default,,0,0,0,,Күлкілі Жау күштерімен кездессеңіз де...
Dialogue: 0,0:09:10.27,0:09:12.48,Default,,0,0,0,,Маған тағы бір сағат керек еді.
Dialogue: 0,0:09:12.98,0:09:15.86,Default,,0,0,0,,Оны оқыған адам бар ма? Бұл қозғалыс
Dialogue: 0,0:09:16.03,0:09:17.49,Default,,0,0,0,,Қорқыныш?
Dialogue: 0,0:09:17.61,0:09:18.53,Default,,0,0,0,,Масштабтау, жылдам.
Dialogue: 0,0:09:21.49,0:09:23.25,Default,,0,0,0,,Иә?сурет?
Dialogue: 0,0:09:23.75,0:09:24.37,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:09:25.21,0:09:28.33,Default,,0,0,0,,Неліктен оның ұшу қанаттары осымен бірдей?
Dialogue: 0,0:09:32.30,0:09:34.05,Default,,0,0,0,,Қошмар кадр/Шенфу
Dialogue: 0,0:09:34.71,0:09:37.43,Default,,0,0,0,,Енді өнім әлі де 40%
Dialogue: 0,0:09:37.55,0:09:39.59,Default,,0,0,0,,Ұлы уәзір, не істеп жатырсың?
Dialogue: 0,0:09:40.01,0:09:42.89,Default,,0,0,0,,Ұшатын түрі болса да, сіз бір жауды қоршап, шабуыл жасай аласыз.
Dialogue: 0,0:09:43.14,0:09:44.06,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:09:46.06,0:09:47.94,Default,,0,0,0,,Сіз бұл құдай жолбарысты бағаламадыңыз.
Dialogue: 0,0:09:48.98,0:09:49.98,Default,,0,0,0,,Уау уау
Dialogue: 0,0:09:54.11,0:09:55.03,Default,,0,0,0,,Гуааах
Dialogue: 0,0:09:57.99,0:09:59.20,Default,,0,0,0,,Наранция Гилго 1984 жылы, Арыстан белгісінің астында дүниеге келген
Dialogue: 0,0:09:59.32,0:09:59.95,Default,,0,0,0,,Хун
Dialogue: 0,0:10:00.57,0:10:02.66,Default,,0,0,0,,Ақылға сыймайтын нәрселерге алданба
Dialogue: 0,0:10:03.58,0:10:04.70,Default,,0,0,0,,Гуаааааааааааааааааааааааааааа
Dialogue: 0,0:10:07.08,0:10:08.46,Default,,0,0,0,,Сіз мені естисіз бе? Нөл
Dialogue: 0,0:10:08.75,0:10:10.67,Default,,0,0,0,,Бұл шынымен де жұлдызды ою ма?
Dialogue: 0,0:10:10.83,0:10:13.04,Default,,0,0,0,,Нөл Кокоха Тору-сан
Dialogue: 0,0:10:19.13,0:10:22.47,Default,,0,0,0,,Неліктен бұл жерде тоқтап тұр?
Dialogue: 0,0:10:22.60,0:10:26.60,Default,,0,0,0,,ше? Аа, солай ма?
Dialogue: 0,0:10:26.93,0:10:30.73,Default,,0,0,0,,Иә, бұл жер толығымен дыбыс өткізбейтін, бірақ
Dialogue: 0,0:10:31.27,0:10:33.61,Default,,0,0,0,,Енді Аспан Ұлын қайтарып алайық.
Dialogue: 0,0:10:35.19,0:10:36.69,Default,,0,0,0,,Енді менің өміріме дейін
Dialogue: 0,0:10:36.94,0:10:38.11,Default,,0,0,0,,Жұлдызша ою
Dialogue: 0,0:10:38.78,0:10:40.82,Default,,0,0,0,,Гурен Кашо стилі
Dialogue: 0,0:10:40.95,0:10:42.20,Default,,0,0,0,,Карен Акацуки?
Dialogue: 0,0:10:42.78,0:10:44.78,Default,,0,0,0,,Бірақ бұл құдай жолбарыс болса
Dialogue: 0,0:10:45.45,0:10:46.62,Default,,0,0,0,,Zangetsu қолдануға болады ма?
Dialogue: 0,0:10:46.75,0:10:49.00,Default,,0,0,0,,Себебі мен құрылғыны жаңа ғана алып тастадым.
Dialogue: 0,0:10:49.12,0:10:49.83,Default,,0,0,0,,Құт
Dialogue: 0,0:10:49.96,0:10:52.17,Default,,0,0,0,,Ооо, мұны Карен
Dialogue: 0,0:10:52.29,0:10:54.34,Default,,0,0,0,,Бұл ақылсыз. Бұл толықтыру алдында болды.
Dialogue: 0,0:10:54.46,0:10:56.55,Default,,0,0,0,,Ол Гурен үшін уайымдама...
Dialogue: 0,0:10:56.67,0:10:58.88,Default,,0,0,0,,Қоңыр рыцарымен тең дәрежеде шайқасты.
Dialogue: 0,0:11:00.26,0:11:01.13,Default,,0,0,0,,Шашыратыңыз
Dialogue: 0,0:11:04.43,0:11:06.51,Default,,0,0,0,,Мен мұны істеймін, бірақ-
Dialogue: 0,0:11:06.64,0:11:08.60,Default,,0,0,0,,Мен Қара рыцарьлардың эйсімін
Dialogue: 0,0:11:09.02,0:11:10.14,Default,,0,0,0,,Маған көрсетші, Құдай жолбарысы.
Dialogue: 0,0:11:10.73,0:11:12.44,Default,,0,0,0,,Сіздің күшіңіз
Dialogue: 0,0:11:12.56,0:11:13.86,Default,,0,0,0,,Олай етпе.
Dialogue: 0,0:11:13.98,0:11:15.11,Default,,0,0,0,,оны «Қызыл теңіз» деп атап кеткен.
Dialogue: 0,0:11:15.23,0:11:16.61,Default,,0,0,0,,Бұл
Dialogue: 0,0:11:16.73,0:11:19.11,Default,,0,0,0,,Өйткені оны менің ұжымым жасады.
Dialogue: 0,0:11:19.24,0:11:20.11,Default,,0,0,0,,Ракшата?
Dialogue: 0,0:11:20.57,0:11:22.74,Default,,0,0,0,,Гүренмен бір мезгілде әзірленді...
Dialogue: 0,0:11:22.86,0:11:24.66,Default,,0,0,0,,Жоғары сипаттамаларға тым көп ұмтылу
Dialogue: 0,0:11:25.24,0:11:28.37,Default,,0,0,0,,Ұшқышы жоқ жалғыз қорқынышты түс
Dialogue: 0,0:11:28.50,0:11:30.08,Default,,0,0,0,,Бұл Құдайдың жолбарысы
Dialogue: 0,0:11:30.25,0:11:32.21,Default,,0,0,0,,Оны жемеңіз
Dialogue: 0,0:11:32.33,0:11:33.33,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:11:38.80,0:11:39.51,Default,,0,0,0,,Кяах!
Dialogue: 0,0:11:39.63,0:11:41.59,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:11:41.72,0:11:45.97,Default,,0,0,0,,Теншоку Хау зарядталған бөлшектердің ауыр зеңбірегі
Dialogue: 0,0:11:46.26,0:11:48.47,Default,,0,0,0,,Бұл радиациялық толқынның зеңбірек оғы сияқты жойғыш күш пе?
Dialogue: 0,0:11:48.77,0:11:50.77,Default,,0,0,0,,Неліктен жау қолында?
Dialogue: 0,0:11:51.06,0:11:53.85,Default,,0,0,0,,Үндістан да монолит емес.
Dialogue: 0,0:11:53.98,0:11:55.48,Default,,0,0,0,,Махараджаның қарт адамы
Dialogue: 0,0:11:55.61,0:11:56.77,Default,,0,0,0,,Оның әлсіз жақтары бар ма?
Dialogue: 0,0:11:57.27,0:11:59.94,Default,,0,0,0,,Бұл басқа сериялардан өзгеше ұғым.
Dialogue: 0,0:12:00.07,0:12:01.82,Default,,0,0,0,,Сәулелену механизмі жоқ...
Dialogue: 0,0:12:02.15,0:12:04.45,Default,,0,0,0,,Жалғыз қалғаны – ұшқыш болмаған.
Dialogue: 0,0:12:04.99,0:12:06.03,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:12:06.16,0:12:08.66,Default,,0,0,0,,Бірақ дәл қазір мініп жүргендер бар.
Dialogue: 0,0:12:08.79,0:12:09.62,Default,,0,0,0,,Эй
Dialogue: 0,0:12:09.91,0:12:12.54,Default,,0,0,0,,Мен оны түсірдім, нәтижесі шешілді.
Dialogue: 0,0:12:12.75,0:12:14.50,Default,,0,0,0,,Иә, сіз жеңілдіңіз.
Dialogue: 0,0:12:16.21,0:12:16.84,Default,,0,0,0,,Не?
Dialogue: 0,0:12:17.46,0:12:19.59,Default,,0,0,0,,Енді қашып құтыла алмайсың
Dialogue: 0,0:12:19.84,0:12:22.30,Default,,0,0,0,,Енді оған бірінші кезекте кірісейік.
Dialogue: 0,0:12:22.42,0:12:24.80,Default,,0,0,0,,Мен түсіндім, онда оған көмектесу мүмкін емес.
Dialogue: 0,0:12:24.93,0:12:26.34,Default,,0,0,0,,Оларды өлтіру сөзсіз.
Dialogue: 0,0:12:26.93,0:12:29.06,Default,,0,0,0,,Егер қолыңнан келсе.
Dialogue: 0,0:12:30.10,0:12:30.93,Default,,0,0,0,,Энергия
Dialogue: 0,0:12:31.14,0:12:31.98,Default,,0,0,0,,Карен
Dialogue: 0,0:12:34.44,0:12:36.31,Default,,0,0,0,,Толықтай бер дедім сондықтан.
Dialogue: 0,0:12:36.81,0:12:38.82,Default,,0,0,0,,Кокпит блогы оралған
Dialogue: 0,0:12:38.94,0:12:40.03,Default,,0,0,0,,Сіз мұнымен қашып құтыла алмайсыз.
Dialogue: 0,0:12:40.32,0:12:42.44,Default,,0,0,0,,Қысқышпен шабуылда Құдайдың жолбарыс сымын түсінеді (Асахина)
Dialogue: 0,0:12:43.70,0:12:44.49,Default,,0,0,0,,Уф
Dialogue: 0,0:12:44.70,0:12:45.61,Default,,0,0,0,,Ах
Dialogue: 0,0:12:45.74,0:12:47.62,Default,,0,0,0,,Мен мұндай нәрсеге еліктегім келмейді, бірақ...
Dialogue: 0,0:12:47.74,0:12:49.08,Default,,0,0,0,,Менің мақсатым бар
Dialogue: 0,0:12:49.66,0:12:51.79,Default,,0,0,0,,Бұл Аспан Ұлы.
Dialogue: 0,0:12:51.91,0:12:53.50,Default,,0,0,0,,Уф! Tsk!
Dialogue: 0,0:12:54.96,0:12:56.04,Default,,0,0,0,,Осындай кездерде
Dialogue: 0,0:12:56.54,0:12:58.67,Default,,0,0,0,,Сіз толық жауап бере аласыз ба? қазір
Dialogue: 0,0:12:59.67,0:13:00.50,Default,,0,0,0,,Не?
Dialogue: 0,0:13:01.09,0:13:03.55,Default,,0,0,0,,Қытай федералды армиясының тылдағы ірі бөлімшесі.
Dialogue: 0,0:13:06.59,0:13:09.10,Default,,0,0,0,,Сейкоку-самаға қолдау көрсету үшін зениттік оқ атуды жалғастырыңыз.
Dialogue: 0,0:13:09.55,0:13:10.81,Default,,0,0,0,,Карин? Пайдалы
Dialogue: 0,0:13:10.93,0:13:13.14,Default,,0,0,0,,Не? Жоқ, сәл күте тұрыңыз
Dialogue: 0,0:13:13.60,0:13:14.85,Default,,0,0,0,,Иә
Dialogue: 0,0:13:16.90,0:13:18.15,Default,,0,0,0,,Ка Карен
Dialogue: 0,0:13:18.40,0:13:19.40,Default,,0,0,0,,Ұсталды ма?
Dialogue: 0,0:13:19.52,0:13:20.82,Default,,0,0,0,,Қытай федералды армиясына?
Dialogue: 0,0:13:21.27,0:13:23.82,Default,,0,0,0,,Соғыс тұтқыны болу? Солай
Dialogue: 0,0:13:24.36,0:13:26.28,Default,,0,0,0,,Карен Радио әлі тірі ме?
Dialogue: 0,0:13:26.57,0:13:28.45,Default,,0,0,0,,Мен қателігім үшін кешірім сұраймын.
Dialogue: 0,0:13:28.57,0:13:30.16,Default,,0,0,0,,Бұл жақсы. (C.C.) Га.
Dialogue: 0,0:13:30.28,0:13:30.91,Default,,0,0,0,,Ах
Dialogue: 0,0:13:31.03,0:13:33.58,Default,,0,0,0,,Берілме, мен саған міндетті түрде көмектесемін
Dialogue: 0,0:13:33.70,0:13:35.37,Default,,0,0,0,,Жақсы, көп қозғалма.
Dialogue: 0,0:13:35.50,0:13:36.37,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:13:36.71,0:13:39.71,Default,,0,0,0,,Білемін, мен одан бас тартпаймын...
Dialogue: 0,0:13:40.17,0:13:41.00,Default,,0,0,0,,Уф
Dialogue: 0,0:13:43.05,0:13:45.59,Default,,0,0,0,,Икаруганы қазір бұрыңыз.
Dialogue: 0,0:13:45.72,0:13:47.63,Default,,0,0,0,,Мен бас тартуға кеңес беремін
Dialogue: 0,0:13:47.76,0:13:49.84,Default,,0,0,0,,Неліктен? Мен Каренді қайтаруым керек.
Dialogue: 0,0:13:49.97,0:13:52.47,Default,,0,0,0,,Карен Акацуки жай ғана қатардағы жауынгер.
Dialogue: 0,0:13:52.60,0:13:53.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:53.35,0:13:54.64,Default,,0,0,0,,) Сен маған сені тастап кетейін дейсің бе?
Dialogue: 0,0:13:54.77,0:13:56.77,Default,,0,0,0,,Минами мырза, бұл таңдау.
Dialogue: 0,0:13:57.23,0:14:01.52,Default,,0,0,0,,Бір адамның өмірін Қытай Федерациясы деп аталатын елмен салыстырудың қажеті жоқ.
Dialogue: 0,0:14:02.19,0:14:06.53,Default,,0,0,0,,Біз әскерлерімізді осында сақтап, үнді әскерімен кездесуге дайындалуымыз керек.
Dialogue: 0,0:14:08.20,0:14:09.78,Default,,0,0,0,,Нөл Шешім қабылдаңыз
Dialogue: 0,0:14:10.78,0:14:12.16,Default,,0,0,0,,Капитан Акацукиге...
Dialogue: 0,0:14:12.28,0:14:14.74,Default,,0,0,0,,Сіздің айтқаныңыз жеткілікті.
Dialogue: 0,0:14:14.87,0:14:16.96,Default,,0,0,0,,Бұдан артық кез келген нәрсе фаворитизм болып саналады.
Dialogue: 0,0:14:17.08,0:14:18.87,Default,,0,0,0,,Ұйым құлдырады
Dialogue: 0,0:14:20.17,0:14:20.88,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:14:21.13,0:14:23.42,Default,,0,0,0,,Мейірімділік пен сотты бөлу керек емес пе?
Dialogue: 0,0:14:23.92,0:14:27.13,Default,,0,0,0,,Кейде амбицияларыңызға жету үшін құрбандық қажет.
Dialogue: 0,0:14:30.64,0:14:32.01,Default,,0,0,0,,Лелуш
Dialogue: 0,0:14:35.27,0:14:35.85,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:14:35.85,0:14:36.85,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:14:35.85,0:14:36.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:38.27,0:14:39.94,Default,,0,0,0,,О Лоундес
Dialogue: 0,0:14:40.31,0:14:42.69,Default,,0,0,0,,Жағдайды реттеңіз, бүкіл әскерді айналдырыңыз.
Dialogue: 0,0:14:42.81,0:14:44.90,Default,,0,0,0,,Неліктен? Ұйымның мүддесі үшін
Dialogue: 0,0:14:45.02,0:14:47.19,Default,,0,0,0,,Үндістандық әскерилер бізге опасыздық жасаған болуы мүмкін.
Dialogue: 0,0:14:47.32,0:14:47.94,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:14:48.28,0:14:48.99,Default,,0,0,0,,Иә
Dialogue: 0,0:14:49.45,0:14:51.74,Default,,0,0,0,,Чиба мен Асахинаға тырна қанаттарынан тұратын лагерь құруды тапсырыңыз.
Dialogue: 0,0:14:51.87,0:14:55.70,Default,,0,0,0,,Мен сізге стратегия мен тактиканың айырмашылығын үйретемін.
Dialogue: 0,0:14:55.83,0:14:56.87,Default,,0,0,0,,Ааа
Dialogue: 0,0:14:57.00,0:14:58.12,Default,,0,0,0,,Рахмет нөл
Dialogue: 0,0:14:58.87,0:15:00.92,Default,,0,0,0,,Бұл күту тәртібі болып қала береді.
Dialogue: 0,0:15:01.37,0:15:04.63,Default,,0,0,0,,Иә, Созаку-кун білді ме?
Dialogue: 0,0:15:05.04,0:15:07.51,Default,,0,0,0,,Лорд Ахлстремнің мобильді бейнесі
Dialogue: 0,0:15:08.21,0:15:09.51,Default,,0,0,0,,А, жақсы ма?
Dialogue: 0,0:15:09.72,0:15:10.63,Default,,0,0,0,,Иә
Dialogue: 0,0:15:11.26,0:15:14.18,Default,,0,0,0,,Ой, түсіндім, қарсы алу кешіне келдің.
Dialogue: 0,0:15:14.30,0:15:16.60,Default,,0,0,0,,О, жаман құпиялылық.
Dialogue: 0,0:15:16.72,0:15:17.81,Default,,0,0,0,,Лелуш
Dialogue: 0,0:15:18.35,0:15:19.27,Default,,0,0,0,,Лелуч?
Dialogue: 0,0:15:19.39,0:15:21.56,Default,,0,0,0,,Шерли мұнда болғанда не істеп жатырсың?
Dialogue: 0,0:15:21.69,0:15:22.35,Default,,0,0,0,,Эй?
Dialogue: 0,0:15:22.48,0:15:23.61,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:15:24.06,0:15:27.11,Default,,0,0,0,,Мен Эшфордпен байланысып жатырмын, бірақ қазір тексеріп жатырмын.
Dialogue: 0,0:15:27.23,0:15:29.44,Default,,0,0,0,,Иә, оған көмектесу мүмкін емес.
Dialogue: 0,0:15:29.57,0:15:31.82,Default,,0,0,0,,Лелуш және басқалары уайымдаса керек.
Dialogue: 0,0:15:32.24,0:15:34.41,Default,,0,0,0,,Бұл да Лелуш па?
Dialogue: 0,0:15:35.74,0:15:37.91,Default,,0,0,0,,Қара рыцарьлар Барлық әскерлер шайқасқа дайын
Dialogue: 0,0:15:38.91,0:15:41.83,Default,,0,0,0,,Жер бедерінің биіктік айырмашылығы аз және географиялық артықшылықты күтуге болмайды.
Dialogue: 0,0:15:42.21,0:15:44.08,Default,,0,0,0,,Сонымен қатар, жау әскері асығыс дайындалды
Dialogue: 0,0:15:44.46,0:15:46.96,Default,,0,0,0,,Бұйрық тізбегінің нөлге шоғырланудан басқа амалы жоқ.
Dialogue: 0,0:15:47.71,0:15:50.22,Default,,0,0,0,,Дегенмен, Nightmare кадрының өнімділігі жаудан жоғары.
Dialogue: 0,0:15:50.47,0:15:52.93,Default,,0,0,0,,Қытай федералды күштерінің нұсқалары
Dialogue: 0,0:15:53.05,0:15:54.93,Default,,0,0,0,,Тәңірлік жолбарыс алдыңғы қатарда...
Dialogue: 0,0:15:55.05,0:15:56.30,Default,,0,0,0,,Орталық (Лелуш) серпіліс
Dialogue: 0,0:16:01.14,0:16:02.19,Default,,0,0,0,,Шинтора -
Dialogue: 0,0:16:02.39,0:16:03.44,Default,,0,0,0,,Бұл Зангецу
Dialogue: 0,0:16:04.65,0:16:05.73,Default,,0,0,0,,3-ші айдаһарлар
Dialogue: 0,0:16:06.23,0:16:09.40,Default,,0,0,0,,Біз диапазонда басымдыққа ие болдық. Атыс кезінде зарядтаңыз.
Dialogue: 0,0:16:10.86,0:16:12.24,Default,,0,0,0,,Жау командирі тұтқынға алынды
Dialogue: 0,0:16:12.36,0:16:13.57,Default,,0,0,0,,Акацуки отряды, ат!
Dialogue: 0,0:16:17.20,0:16:20.54,Default,,0,0,0,,) Сейки қозғала алмаса да, ол Тодоны басып тұр.
Dialogue: 0,0:16:20.66,0:16:23.79,Default,,0,0,0,,Сонда сарбаздардың шеберлік деңгейі маңызды.
Dialogue: 0,0:16:24.25,0:16:26.50,Default,,0,0,0,,Жау кемесінің алдыңғы бөлігін басып алыңыз
Dialogue: 0,0:16:26.63,0:16:28.75,Default,,0,0,0,,Қарсыластың сол және оң қапталдарын елемеуге болады.
Dialogue: 0,0:16:28.88,0:16:31.71,Default,,0,0,0,,Күткендей, Акацукисіз біз бір қадам артта қаламыз.
Dialogue: 0,0:16:32.13,0:16:33.34,Default,,0,0,0,,Орталық бұзылды
Dialogue: 0,0:16:33.72,0:16:34.55,Default,,0,0,0,,Жаудың штабы қайда?
Dialogue: 0,0:16:34.68,0:16:35.97,Default,,0,0,0,,Әлі алда
Dialogue: 0,0:16:36.09,0:16:37.80,Default,,0,0,0,,Жарайды, шарттар жойылды.
Dialogue: 0,0:16:38.60,0:16:39.64,Default,,0,0,0,,Қарсы шабуыл басталады
Dialogue: 0,0:16:40.14,0:16:42.31,Default,,0,0,0,,Оң қанат Чиба армиясы Сол қанат Асахина армиясы
Dialogue: 0,0:16:42.89,0:16:44.44,Default,,0,0,0,,Сигма үлгісін қолдану
Dialogue: 0,0:16:44.56,0:16:47.27,Default,,0,0,0,,Тылдан атуға дайындалу және жаудың бас қосынына тосқауыл қою.
Dialogue: 0,0:16:47.40,0:16:48.73,Default,,0,0,0,,Алдыңғы әскерлерге шабуыл жасау
Dialogue: 0,0:16:48.94,0:16:50.98,Default,,0,0,0,,Синтораны қуат таусылуына шақырыңыз-
Dialogue: 0,0:16:51.11,0:16:52.90,Default,,0,0,0,,Жұлдызша белгісін ұстасаңыз, сіз жеңесіз.
Dialogue: 0,0:16:53.07,0:16:56.53,Default,,0,0,0,,Алға жүр, осы жерде тоқтасақ, жойыламыз.
Dialogue: 0,0:16:56.66,0:16:57.99,Default,,0,0,0,,Каренді қайтарыңыз
Dialogue: 0,0:17:00.12,0:17:00.95,Default,,0,0,0,,Ашу
Dialogue: 0,0:17:01.33,0:17:02.54,Default,,0,0,0,,Оны қоян-қолтық ұрысқа әкелу.
Dialogue: 0,0:17:02.91,0:17:03.96,Default,,0,0,0,,Тодо қайда?
Dialogue: 0,0:17:04.41,0:17:05.12,Default,,0,0,0,,Күшейткіштер?
Dialogue: 0,0:17:05.67,0:17:07.92,Default,,0,0,0,,Сіз оны бар күш-жігеріңізбен жоюға келдіңіз бе? Нөл
Dialogue: 0,0:17:08.04,0:17:09.38,Default,,0,0,0,,Қандай ақымақ
Dialogue: 0,0:17:09.50,0:17:11.63,Default,,0,0,0,,Біз құдай жолбарыстың күшіне тым көп сенеміз бе?
Dialogue: 0,0:17:11.75,0:17:13.88,Default,,0,0,0,,Бұл жай ғана жабайы қабан жауынгері
Dialogue: 0,0:17:14.01,0:17:16.93,Default,,0,0,0,,Жоқ Бұл нөлдің қалай шығатынын көруге арналған стратегия
Dialogue: 0,0:17:17.68,0:17:20.31,Default,,0,0,0,,Бұл орналасу, оның шынайы мағынасы
Dialogue: 0,0:17:24.68,0:17:26.10,Default,,0,0,0,,Фуфухахахахаха
Dialogue: 0,0:17:26.23,0:17:29.11,Default,,0,0,0,,Хошики Канал сіздің жоспарыңызды бұзып жатыр ма?
Dialogue: 0,0:17:29.23,0:17:31.90,Default,,0,0,0,,Бірақ судың мөлшері азайды.
Dialogue: 0,0:17:32.23,0:17:34.53,Default,,0,0,0,,Мен мұны елеусіз деп ойладым.
Dialogue: 0,0:17:34.65,0:17:37.03,Default,,0,0,0,,Демек, нөл, сіз жоғалтасыз.
Dialogue: 0,0:17:38.28,0:17:39.49,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:17:39.62,0:17:40.24,Default,,0,0,0,,На
Dialogue: 0,0:17:40.66,0:17:41.66,Default,,0,0,0,,Жер
Dialogue: 0,0:17:42.04,0:17:43.49,Default,,0,0,0,,Мен бұл жерде болады деп ойламадым.
Dialogue: 0,0:17:43.62,0:17:46.62,Default,,0,0,0,,Иә, бұл мысалдағы суармалы полдер.
Dialogue: 0,0:17:46.75,0:17:49.96,Default,,0,0,0,,Сөз байласу салдарынан сапасыз құрылыс жұмыстары және оның салдары ешкімге белгісіз.
Dialogue: 0,0:17:50.46,0:17:53.84,Default,,0,0,0,,Бұрынғы шабуыл жаудың негізгі күшін жылжыту болды.
Dialogue: 0,0:17:54.09,0:17:56.09,Default,,0,0,0,,Лорд Сейкоку жалғыз ұшақпен алға шықты...
Dialogue: 0,0:17:56.22,0:17:58.47,Default,,0,0,0,,Нөлді осы елде қалдыру үшін
Dialogue: 0,0:17:58.89,0:18:01.10,Default,,0,0,0,,Сіз оны шынымен оқыдыңыз ба?
Dialogue: 0,0:18:01.22,0:18:04.35,Default,,0,0,0,,Егер мен сізді шешуші шайқасқа шақырсам, егер мен осы құрамды алсам,
Dialogue: 0,0:18:06.98,0:18:10.90,Default,,0,0,0,,Жеңіс әкелген біздің жеріміз.
Dialogue: 0,0:18:11.02,0:18:13.48,Default,,0,0,0,,Нөл Сіз ұтыласыз.
Dialogue: 0,0:18:13.82,0:18:14.69,Default,,0,0,0,,Жұлдызша белгі!
Dialogue: 0,0:18:16.24,0:18:18.45,Default,,0,0,0,,Әлі реттелмеген
Dialogue: 0,0:18:20.24,0:18:21.99,Default,,0,0,0,,Ғажайып Тодо күткендей
Dialogue: 0,0:18:22.12,0:18:24.70,Default,,0,0,0,,Бірақ жаудың номинаты осында тоқтады.
Dialogue: 0,0:18:25.08,0:18:26.75,Default,,0,0,0,,Барлық әскерлер шеруге кіріседі
Dialogue: 0,0:18:26.87,0:18:28.00,Default,,0,0,0,,Субъектке бағыну (чензунци)
Dialogue: 0,0:18:30.25,0:18:32.29,Default,,0,0,0,,Жаудың түнгі әскерлері артта қалады.
Dialogue: 0,0:18:32.42,0:18:34.59,Default,,0,0,0,,Қарсылас кемесінің қуат бөліміне оқ жаудырыңыз
Dialogue: 0,0:18:34.71,0:18:36.92,Default,,0,0,0,,Антифизикалық кедергілер де сарқылмас емес.
Dialogue: 0,0:18:37.05,0:18:38.59,Default,,0,0,0,,Жеңіс менікі
Dialogue: 0,0:18:38.93,0:18:41.39,Default,,0,0,0,,Мен әрқайсысын жою үшін әкеліндім бе?
Dialogue: 0,0:18:41.64,0:18:43.26,Default,,0,0,0,,Қарғыс атсын, бұл жиіркенішті.
Dialogue: 0,0:18:43.47,0:18:46.52,Default,,0,0,0,,Нөл Мен сізге бас тартуға кеңес бердім.
Dialogue: 0,0:18:47.35,0:18:50.27,Default,,0,0,0,,Жарайды, қуат бөлігін қорғай отырып, шегініңіз.
Dialogue: 0,0:18:51.44,0:18:52.81,Default,,0,0,0,,Тіпті Хорай аралына оралғаннан кейін
Dialogue: 0,0:18:52.94,0:18:55.61,Default,,0,0,0,,Мен білемін Желдеткіш үлгісі қайда?
Dialogue: 0,0:18:55.73,0:18:59.57,Default,,0,0,0,,А-а, мен барлау мен маркшейдерлік жұмысты аяқтадым.
Dialogue: 0,0:18:59.70,0:19:00.53,Default,,0,0,0,,Уау (мүшелер) Уау!
Dialogue: 0,0:19:01.16,0:19:02.74,Default,,0,0,0,,Оны мойындайық
Dialogue: 0,0:19:02.87,0:19:04.91,Default,,0,0,0,,Мен сені бірінші түсіруім керек еді.
Dialogue: 0,0:19:05.03,0:19:06.33,Default,,0,0,0,,Менімен бөлісетін даналық...
Dialogue: 0,0:19:06.66,0:19:08.08,Default,,0,0,0,,Созаку таптарының ерлігі
Dialogue: 0,0:19:09.83,0:19:12.00,Default,,0,0,0,,Аспан саған екі нәрсе берді ме?
Dialogue: 0,0:19:12.33,0:19:15.46,Default,,0,0,0,,Бірақ сен маған уақыт бермедің.
Dialogue: 0,0:19:15.59,0:19:16.59,Default,,0,0,0,,Хун
Dialogue: 0,0:19:16.96,0:19:19.63,Default,,0,0,0,,Маған тағы біраз беріңізші.
Dialogue: 0,0:19:20.17,0:19:22.30,Default,,0,0,0,,Садақ диффузиялық адрон ауыр зеңбіректер жинағы
Dialogue: 0,0:19:22.43,0:19:24.14,Default,,0,0,0,,Gefion жақсы синхрондауды басқарады
Dialogue: 0,0:19:24.26,0:19:26.10,Default,,0,0,0,,Мақсат қою
Dialogue: 0,0:19:27.85,0:19:30.69,Default,,0,0,0,,Жарайды, жаудың екі қанатына да оқ.
Dialogue: 0,0:19:36.11,0:19:39.19,Default,,0,0,0,,Сіз күткендей, Нөл, сізде әлі біраз жұмыс бар.
Dialogue: 0,0:19:39.78,0:19:42.86,Default,,0,0,0,,Әрбір айдаһар корпусы таралады және олар қатып қалғанда, олар нысанаға алынады.
Dialogue: 0,0:19:43.41,0:19:44.91,Default,,0,0,0,,Тодо әскерлерді құтқарады және...
Dialogue: 0,0:19:45.03,0:19:46.12,Default,,0,0,0,,Қайта ұйымдастыруға басшылық ету
Dialogue: 0,0:19:46.58,0:19:49.04,Default,,0,0,0,,Икаруга айналма жолмен келе жатқанда жауларын тартады
Dialogue: 0,0:19:49.16,0:19:50.71,Default,,0,0,0,,Жоспарланған 4-ші пунктке өту
Dialogue: 0,0:19:51.08,0:19:52.58,Default,,0,0,0,,(айқай)
Dialogue: 0,0:19:54.75,0:19:56.21,Default,,0,0,0,,Қытай Федерациясының жаңалықтары
Dialogue: 0,0:19:56.34,0:19:58.00,Default,,0,0,0,,Ол еш жерде ағынмен жүрмейтін сияқты.
Dialogue: 0,0:20:05.30,0:20:07.85,Default,,0,0,0,,Барлық қалған түнгі армандар қамтылды.
Dialogue: 0,0:20:08.39,0:20:09.47,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:09.60,0:20:12.19,Default,,0,0,0,,Сонда сен Тентейдің 88 моласына тосқауыл қоясың ба?
Dialogue: 0,0:20:12.44,0:20:14.69,Default,,0,0,0,,Бірінен соң бірі көктің ұлдары ғибадат еткен жер
Dialogue: 0,0:20:14.94,0:20:17.19,Default,,0,0,0,,Бұл жерде жаудың шабуыл жасауы қиын екені рас.
Dialogue: 0,0:20:17.52,0:20:19.65,Default,,0,0,0,,Жаудың майданнан келгеннен басқа амалы жоқ.
Dialogue: 0,0:20:19.98,0:20:22.78,Default,,0,0,0,,Бұл жағдайда жай ғана садақ адронының ауыр зеңбірегімен атыңыз.
Dialogue: 0,0:20:22.90,0:20:24.53,Default,,0,0,0,,Сіз үздіксіз ату мүмкін емес.
Dialogue: 0,0:20:25.16,0:20:27.07,Default,,0,0,0,,Енді үнді әскерін күту керек пе?
Dialogue: 0,0:20:27.66,0:20:28.91,Default,,0,0,0,,Ол келмеуі керек.
Dialogue: 0,0:20:29.04,0:20:30.87,Default,,0,0,0,,Арматурасыз қоршау шайқасы дегеніміз не?
Dialogue: 0,0:20:31.37,0:20:34.25,Default,,0,0,0,,Егер солай болса, келіссөздер үшін әлі де орын бар еді.
Dialogue: 0,0:20:34.37,0:20:36.63,Default,,0,0,0,,Мен Ұлы Евнухтан мұндай нәрсе жасайды деп ешқашан күткен емеспін.
Dialogue: 0,0:20:38.67,0:20:39.30,Default,,0,0,0,,Құт
Dialogue: 0,0:20:39.42,0:20:41.05,Default,,0,0,0,,Мен саған қозғалма деп айтуым керек еді.
Dialogue: 0,0:20:41.59,0:20:44.01,Default,,0,0,0,,Бізге қарсы шыққандар...
Dialogue: 0,0:20:44.13,0:20:45.59,Default,,0,0,0,,Кешірме
Dialogue: 0,0:20:45.72,0:20:47.22,Default,,0,0,0,,Қазір уақыт емес
Dialogue: 0,0:20:47.55,0:20:50.60,Default,,0,0,0,,Оның үстіне, бұл Көк Ұлын қайтарып бермей ме?
Dialogue: 0,0:20:50.72,0:20:52.48,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:20:52.60,0:20:55.90,Default,,0,0,0,,Бізде күшті күшейткіштер де бар.
Dialogue: 0,0:20:57.06,0:20:58.02,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:20:58.15,0:21:00.69,Default,,0,0,0,,Мен оны Қоңыр түнге дейін есептемедім.
Dialogue: 0,0:21:01.23,0:21:02.15,Default,,0,0,0,,ақымақ
Dialogue: 0,0:21:02.74,0:21:07.07,Default,,0,0,0,,Бұл Қытай Федерациясы басқа елден, Британиядан не сұрайды?
Dialogue: 0,0:21:07.20,0:21:08.57,Default,,0,0,0,,Ал ол кеме Авалон.
Dialogue: 0,0:21:09.24,0:21:11.66,Default,,0,0,0,,Түсінесіз бе, ұлы уәзірлер?
Dialogue: 0,0:21:11.79,0:21:14.50,Default,,0,0,0,,Қарсылас – ЕО-ның жартысын ұрлаған адам.
Dialogue: 0,0:21:14.91,0:21:17.17,Default,,0,0,0,,Екінші князь Шнайзел.
Dialogue: 0,0:21:17.46,0:21:19.63,Default,,0,0,0,,Ұлы Евнух тек біз емес...
Dialogue: 0,0:21:19.75,0:21:22.63,Default,,0,0,0,,Мен тіпті Хошикиді де өшіруді жоспарлап отырмын.
Dialogue: 0,0:21:22.76,0:21:24.34,Default,,0,0,0,,Диетард Құрылғыны дайындаңыз
Dialogue: 0,0:21:24.47,0:21:26.30,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:21:26.76,0:21:29.89,Default,,0,0,0,,Бұл ең жақсы кезең емес пе?
Dialogue: 0,0:21:30.43,0:21:34.35,Default,,0,0,0,,Мен бұл үмітсіз жағдайда да жеңісті көрсетемін
Dialogue: 0,0:21:35.39,0:21:36.60,Default,,0,0,0,,Бақылау туралы есеп келді
Dialogue: 0,0:21:36.73,0:21:38.10,Default,,0,0,0,,Қытай Федерациясындағы жағдай
Dialogue: 0,0:21:38.44,0:21:40.82,Default,,0,0,0,,Мемлекеттік төңкерісті пайдаланып, Нөл пайда болады...
Dialogue: 0,0:21:40.94,0:21:42.65,Default,,0,0,0,,Аспан Ұлын талан-таражға салған сияқты.
Dialogue: 0,0:21:42.94,0:21:43.11,Default,,0,0,0,,Аспан Ұлының қауіпсіздігі туралы ақпарат...
Dialogue: 0,0:21:43.11,0:21:44.19,Default,,0,0,0,,Аспан Ұлының қауіпсіздігі туралы ақпарат...
Dialogue: 0,0:21:43.11,0:21:44.19,Default,,0,0,0,,Түсіндім, амансыз, төраға.
Dialogue: 0,0:21:44.19,0:21:45.53,Default,,0,0,0,,Түсіндім, амансыз, төраға.
Dialogue: 0,0:21:45.65,0:21:46.32,Default,,0,0,0,,Иә
Dialogue: 0,0:21:46.45,0:21:47.95,Default,,0,0,0,,Мен Сузаку-кунмен және басқалармен біргемін...
Dialogue: 0,0:21:48.07,0:21:48.95,Default,,0,0,0,,Мұнда қандай жаңалық бар?
Dialogue: 0,0:21:49.45,0:21:51.99,Default,,0,0,0,,Қазір теледидар мен радионың барлығы нөлге тең.
Dialogue: 0,0:21:52.12,0:21:54.75,Default,,0,0,0,,Рахмет, төраға, амансыз.
Dialogue: 0,0:21:55.29,0:21:56.62,Default,,0,0,0,,Ах ха
Dialogue: 0,0:21:56.75,0:21:59.38,Default,,0,0,0,,Қалай болғанда да, империялық бағыныштылардың жауы Нөл...
Dialogue: 0,0:21:59.50,0:22:03.25,Default,,0,0,0,,Ол теңіздің арғы жағында Қытай Федерациясында өзінің ақырын қарсы алатын сияқты.
Dialogue: 0,0:22:03.38,0:22:08.09,Default,,0,0,0,,♪Мен оны бір күні кеудемнен таптым
Dialogue: 0,0:22:08.22,0:22:14.81,Default,,0,0,0,,♪Бақыт бөліктерін жинап алайық
Dialogue: 0,0:22:14.93,0:22:19.81,Default,,0,0,0,,♪Ұмытып қала жаздаған әуен
Dialogue: 0,0:22:19.94,0:22:26.90,Default,,0,0,0,,♪Ортада сөнбестен
Dialogue: 0,0:22:30.11,0:22:34.74,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:34.87,0:22:40.04,Default,,0,0,0,,♪Бүгін осында болғаным барлығына рахмет
Dialogue: 0,0:22:40.17,0:22:44.71,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:44.84,0:22:47.55,Default,,0,0,0,,♪Келесі мен бәріне айтамын
Dialogue: 0,0:22:47.67,0:22:51.01,Default,,0,0,0,,♪БАҚЫТТЫ Мен саған Уау беремін
Dialogue: 0,0:22:51.14,0:22:56.14,Default,,0,0,0,,♪Мен ештеңені ұмытпаймын
Dialogue: 0,0:22:56.27,0:23:02.73,Default,,0,0,0,,♪Себебі сол күні мен де болдым
Dialogue: 0,0:23:02.86,0:23:07.82,Default,,0,0,0,,♪Мен әрқашан сені сүйемін деп айтамын
Dialogue: 0,0:23:07.94,0:23:11.95,Default,,0,0,0,,♪Сіз маған айтуыңыз керек.
Dialogue: 0,0:23:12.07,0:23:16.33,Default,,0,0,0,,♪ Көз жасы ағып кете жаздады
Dialogue: 0,0:23:16.45,0:23:23.00,Default,,0,0,0,,♪Ұзақ түнде кенет артыма қарадым
Dialogue: 0,0:23:23.13,0:23:27.13,Default,,0,0,0,,♪Адамның ізімен жүру
Dialogue: 0,0:23:27.25,0:23:34.22,Default,,0,0,0,,♪Сол күнді ұмытпа
Dialogue: 0,0:23:37.93,0:23:40.27,Default,,0,0,0,,Сіз мұны осы жағдайда жасадыңыз.
Dialogue: 0,0:23:40.39,0:23:41.98,Default,,0,0,0,,Біз жай ғана бұрышта қалдық.
Dialogue: 0,0:23:42.48,0:23:44.77,Default,,0,0,0,,Жеңіске жету ықтималдығы шексіз.
Dialogue: 0,0:23:44.90,0:23:45.90,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:23:46.02,0:23:48.23,Default,,0,0,0,,Мен бұл шайқасты іргетасынан жоямын.
Dialogue: 0,0:23:48.78,0:23:51.40,Default,,0,0,0,,Мен бұл жерде аяқтай алмаймын ...
Dialogue: 0,0:23:52.90,0:23:58.90,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory