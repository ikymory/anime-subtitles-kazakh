Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:06.00,Default,,0,0,0,,｟Шизука: аа... Куу...
Dialogue: 0,0:00:06.00,0:00:09.67,Default,,0,0,0,,А... Уф... Уф!
Dialogue: 0,0:00:09.67,0:00:14.18,Default,,0,0,0,,А... Арх... Аа...
Dialogue: 0,0:00:14.18,0:00:16.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:16.51,0:00:21.35,Default,,0,0,0,,Хахахаха….
Dialogue: 0,0:00:21.35,0:00:23.65,Default,,0,0,0,,《Мен жаман емеспін》｠
Dialogue: 0,0:00:26.02,0:00:31.36,Default,,0,0,0,,Ха! Хаха... Уф...
Dialogue: 0,0:00:31.36,0:00:35.03,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:00:35.03,0:00:37.20,Default,,0,0,0,,Не болды? Ах...
Dialogue: 0,0:00:37.20,0:00:43.21,Default,,0,0,0,,Тағы бір жаман арман? иә? А... иә.
Dialogue: 0,0:00:43.21,0:00:47.54,Default,,0,0,0,,<Шидзука: Менің үйімде бір робот бар.
Dialogue: 0,0:00:47.54,0:00:50.71,Default,,0,0,0,,Жалдау шарты 7 жылдан бері жасалған.
Dialogue: 0,0:00:50.71,0:00:54.72,Default,,0,0,0,,Бүгін үйге сағат нешеде барасың? Кеш болуы мүмкін.
Dialogue: 0,0:00:54.72,0:00:58.22,Default,,0,0,0,,Кешіріңіз, Джо. Ха….
Dialogue: 0,0:00:58.22,0:01:03.49,Default,,0,0,0,,<Шидзука: Ол кез келген адамға қарағанда адал және мейірімді➡
Dialogue: 0,0:01:03.49,0:01:07.66,Default,,0,0,0,,Ол менің ойым мен денемді толтырады. Онымен салыстырғанда...>
Dialogue: 0,0:01:07.66,0:01:10.67,Default,,0,0,0,,Күткеніңізге рахмет, Шизука! (аяқ дыбыстары)
Dialogue: 0,0:01:10.67,0:01:14.57,Default,,0,0,0,,Хмм... Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:01:17.67,0:01:20.08,Default,,0,0,0,,<Шидзука: Адам еркек...>
Dialogue: 0,0:01:28.18,0:01:30.19,Default,,0,0,0,,Иә! (есіктің ашылған дыбысы)
Dialogue: 0,0:01:30.19,0:01:33.36,Default,,0,0,0,,Дәл қазір. Ха!
Dialogue: 0,0:01:33.36,0:01:36.36,Default,,0,0,0,,Қош келдіңіз, Шизука. Кешкі ас дайын.
Dialogue: 0,0:01:36.36,0:01:38.36,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:01:40.70,0:01:43.03,Default,,0,0,0,,Хмм….
Dialogue: 0,0:01:43.03,0:01:45.20,Default,,0,0,0,,Менің әлі жұмысым бар...
Dialogue: 0,0:01:45.20,0:01:50.04,Default,,0,0,0,,Мен аздап артық жұмыс істедім, себебі ол өте жақсы аяқталмады.
Dialogue: 0,0:01:50.04,0:01:53.71,Default,,0,0,0,,Осыдан кейін мен вокзалды аралап шықтым...
Dialogue: 0,0:01:53.71,0:01:55.71,Default,,0,0,0,,Хмм….
Dialogue: 0,0:02:01.32,0:02:03.82,Default,,0,0,0,,Жеті жыл...? иә?
Dialogue: 0,0:02:03.82,0:02:09.99,Default,,0,0,0,,Мен Шизуканың неше түрлі түрлерін көрдім, кейбіреулері көңілсіз, ал кейбіреулері бақытты.
Dialogue: 0,0:02:09.99,0:02:12.10,Default,,0,0,0,,Бірақ жаңа өмір бастайтын уақыт келді➡
Dialogue: 0,0:02:12.10,0:02:15.00,Default,,0,0,0,,Менің ойымша, ол күтіп тұр. Хмм...
Dialogue: 0,0:02:15.00,0:02:18.67,Default,,0,0,0,,Жоқ? Уф...
Dialogue: 0,0:02:18.67,0:02:24.51,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:02:24.51,0:02:27.01,Default,,0,0,0,,Жылама, Шизука.
Dialogue: 0,0:02:27.01,0:02:29.01,Default,,0,0,0,,Кешіріңіз, Джо.
Dialogue: 0,0:02:29.01,0:02:34.02,Default,,0,0,0,,Менің өзіме ұнайтын адам бар.
Dialogue: 0,0:02:34.02,0:02:37.82,Default,,0,0,0,,Бұл тамаша. Менде кешірім сұрайтын ештеңе жоқ.
Dialogue: 0,0:02:39.86,0:02:42.36,Default,,0,0,0,,Сіз ашулы емессіз бе? аа.
Dialogue: 0,0:02:42.36,0:02:44.69,Default,,0,0,0,,Ашулану.
Dialogue: 0,0:02:44.69,0:02:46.70,Default,,0,0,0,,Ашуға болмайды.
Dialogue: 0,0:02:46.70,0:02:50.87,Default,,0,0,0,,Себебі Джо қыздардың көңілінен шығу үшін жаралған➡
Dialogue: 0,0:02:50.87,0:02:53.37,Default,,0,0,0,,Бұл жай ғана ғашық робот!
Dialogue: 0,0:02:53.37,0:02:56.37,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:02:56.37,0:02:59.98,Default,,0,0,0,,Кешіріңіз. Кешіріңіз.
Dialogue: 0,0:02:59.98,0:03:03.48,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:03:03.48,0:03:05.48,Default,,0,0,0,,<Жарық: Өнеркәсіптік АИ.
Dialogue: 0,0:03:05.48,0:03:09.32,Default,,0,0,0,,Ол адам өмірін қолдау үшін жасалған➡
Dialogue: 0,0:03:09.32,0:03:11.65,Default,,0,0,0,,Жасанды интеллект.
Dialogue: 0,0:03:11.65,0:03:16.32,Default,,0,0,0,,Ақыл қабілеті шектеулі өндірістік АИ-де тумайды.
Dialogue: 0,0:03:16.32,0:03:21.50,Default,,0,0,0,,Адамдар оларды осылай белгілеп, өнім ретінде пайдаланады.
Dialogue: 0,0:03:21.50,0:03:23.50,Default,,0,0,0,,Бірақ...＞
Dialogue: 0,0:04:56.69,0:04:58.69,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:04:58.69,0:05:01.30,Default,,0,0,0,,Бұл Sudo New Clinic беті Судо.
Dialogue: 0,0:05:01.30,0:05:04.13,Default,,0,0,0,,Мен Поппомын. Сәлем Поппо.
Dialogue: 0,0:05:04.13,0:05:06.30,Default,,0,0,0,,Сәлеметсіз бе, Судо мырза.
Dialogue: 0,0:05:06.30,0:05:09.81,Default,,0,0,0,,Біз қашан ойыншық жөндеу шеберханасы болдық?
Dialogue: 0,0:05:09.81,0:05:11.81,Default,,0,0,0,,Бекітілген сияқты.
Dialogue: 0,0:05:14.14,0:05:16.65,Default,,0,0,0,,Кен Чан. (есіктің ашылған дыбысы)
Dialogue: 0,0:05:16.65,0:05:20.65,Default,,0,0,0,,Поппо! Сенімен бәрі жақсы ма?
Dialogue: 0,0:05:20.65,0:05:25.82,Default,,0,0,0,,Менің есте сақтау қабілетім бұзылды. Өйткені ол өте ескі.
Dialogue: 0,0:05:25.82,0:05:28.99,Default,,0,0,0,,Мен қалпына келдім. Сізге Поппо жақсы!
Dialogue: 0,0:05:28.99,0:05:31.99,Default,,0,0,0,,А... Түзетілген шығар. Ха!
Dialogue: 0,0:05:31.99,0:05:34.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:34.00,0:05:37.67,Default,,0,0,0,,Оны түзетудің қажеті жоқ еді. Анашым!
Dialogue: 0,0:05:37.67,0:05:42.17,Default,,0,0,0,,Сен де ұл шығарсың! Тездетіп оқуды осылай бітір!
Dialogue: 0,0:05:42.17,0:05:46.17,Default,,0,0,0,,Мұндай сөздерді айту Поппоға зиян тигізеді! Поппо ауырды.
Dialogue: 0,0:05:46.17,0:05:48.84,Default,,0,0,0,,Зардап шеккен жоқ. Жай ғана машина!
Dialogue: 0,0:05:48.84,0:05:50.85,Default,,0,0,0,,Жоқ! менің досым!
Dialogue: 0,0:05:50.85,0:05:54.35,Default,,0,0,0,,Кен Чан, анам. Ұрыс жоқ. Ұрыс жоқ.
Dialogue: 0,0:05:54.35,0:05:56.85,Default,,0,0,0,,Поппоны жап! Анашым!
Dialogue: 0,0:05:56.85,0:05:58.85,Default,,0,0,0,,Уф….
Dialogue: 0,0:05:58.85,0:06:02.56,Default,,0,0,0,,Оны жөндегеніңізге қуаныштымын, солай ма? мінеки біз….
Dialogue: 0,0:06:04.79,0:06:06.80,Default,,0,0,0,,Уф….
Dialogue: 0,0:06:06.80,0:06:10.63,Default,,0,0,0,,Мен оны аламын! Мен ешқандай попо қабылдамаймын.
Dialogue: 0,0:06:10.63,0:06:13.97,Default,,0,0,0,,Бұл күнделікті өмір қайтадан басталды.
Dialogue: 0,0:06:13.97,0:06:18.81,Default,,0,0,0,,Жарайды... сіз бірінші кезекте Поппо сатып алдыңыз, солай ма?
Dialogue: 0,0:06:18.81,0:06:21.31,Default,,0,0,0,,Аа...
Dialogue: 0,0:06:21.31,0:06:25.98,Default,,0,0,0,,《Марико: Мен саған үйленбей тұрып》
Dialogue: 0,0:06:25.98,0:06:28.32,Default,,0,0,0,,｟Уау!
Dialogue: 0,0:06:28.32,0:06:32.82,Default,,0,0,0,,Хахахаха! Ахахха!
Dialogue: 0,0:06:32.82,0:06:35.32,Default,,0,0,0,,А... танысқаныма қуаныштымын.
Dialogue: 0,0:06:35.32,0:06:37.66,Default,,0,0,0,,Анашым! Аю қозғалды.
Dialogue: 0,0:06:37.66,0:06:40.16,Default,,0,0,0,,Хехе, бұл жақсы.
Dialogue: 0,0:06:40.16,0:06:42.83,Default,,0,0,0,,Сіз кімсіз? Кенджи!
Dialogue: 0,0:06:42.83,0:06:46.17,Default,,0,0,0,,Мен Поппомын. Сәлем Поппо.
Dialogue: 0,0:06:46.17,0:06:48.34,Default,,0,0,0,,Сәлем Кен Чан
Dialogue: 0,0:06:48.34,0:06:50.64,Default,,0,0,0,,《Марико: Бұл сәтсіздік болды...》
Dialogue: 0,0:06:54.68,0:06:56.68,Default,,0,0,0,,｟Фу…｠
Dialogue: 0,0:06:58.68,0:07:02.45,Default,,0,0,0,,<Марико: Жалғызбасты ата-ана болудың жалғыздығын аздап болса да жеңілдеткенімді қалаймын➡
Dialogue: 0,0:07:02.45,0:07:05.79,Default,,0,0,0,,Терең ойланбастан бердім>
Dialogue: 0,0:07:05.79,0:07:07.79,Default,,0,0,0,,｟Сіз таң қаласыз!
Dialogue: 0,0:07:10.29,0:07:12.79,Default,,0,0,0,,Анасыз бәрібір. иә?
Dialogue: 0,0:07:12.79,0:07:14.96,Default,,0,0,0,,Менде Поппо бар.
Dialogue: 0,0:07:14.96,0:07:19.80,Default,,0,0,0,,Мен әрқашан Кен Чанмен бірге болдым. Бұл уәде.
Dialogue: 0,0:07:19.80,0:07:24.14,Default,,0,0,0,,Мен жұмыс үшін жоғалмаймын.
Dialogue: 0,0:07:24.14,0:07:27.31,Default,,0,0,0,,Анам жоқ болса да, мен осында боламын.
Dialogue: 0,0:07:27.31,0:07:29.64,Default,,0,0,0,,Ах...｠
Dialogue: 0,0:07:29.64,0:07:31.65,Default,,0,0,0,,<Марико: Сол қонжық әп-сәтте келді➡
Dialogue: 0,0:07:31.65,0:07:36.32,Default,,0,0,0,,Бала отбасының бір мүшесі болды＞
Dialogue: 0,0:07:36.32,0:07:39.15,Default,,0,0,0,,Кенжи-кун енді бала емес.
Dialogue: 0,0:07:39.15,0:07:42.32,Default,,0,0,0,,Сіз Поппоның ойыншық екенін жақын арада білесіз.
Dialogue: 0,0:07:42.32,0:07:46.49,Default,,0,0,0,,Мен таң қалдым. Ол жай ғана бағдарламаны іске қосып жатса да ➡
Dialogue: 0,0:07:46.49,0:07:49.83,Default,,0,0,0,,Еркін сөйлеудің өзі қорқынышты. Хмм...
Dialogue: 0,0:07:49.83,0:07:55.50,Default,,0,0,0,,Анашым, Поппо емделсе де, біртүрлі болды.
Dialogue: 0,0:07:55.50,0:07:59.94,Default,,0,0,0,,Бірақ анамен ұрысу жақсы емес. Иә.
Dialogue: 0,0:07:59.94,0:08:02.61,Default,,0,0,0,,｟Бітіру! ｠
Dialogue: 0,0:08:02.61,0:08:07.62,Default,,0,0,0,,Попподы бітіруім керек пе?
Dialogue: 0,0:08:07.62,0:08:10.45,Default,,0,0,0,,Поппо маған мәңгі бірге боламыз десе де.
Dialogue: 0,0:08:10.45,0:08:12.45,Default,,0,0,0,,Сіз әрқашан біргесіз бе?
Dialogue: 0,0:08:15.29,0:08:17.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:19.29,0:08:23.30,Default,,0,0,0,,Сізбен кім бар? Сіз менімен біргесіз бе?
Dialogue: 0,0:08:23.30,0:08:25.30,Default,,0,0,0,,Не болды? Поппо.
Dialogue: 0,0:08:30.64,0:08:33.48,Default,,0,0,0,,Юки-чан. Поппо?
Dialogue: 0,0:08:33.48,0:08:36.81,Default,,0,0,0,,Юки-чан қайда?
Dialogue: 0,0:08:36.81,0:08:40.52,Default,,0,0,0,,Юки-чан. Ах...
Dialogue: 0,0:08:42.48,0:08:45.32,Default,,0,0,0,,А... тағы сынды ма?
Dialogue: 0,0:08:45.32,0:08:49.99,Default,,0,0,0,,Уф, у, у, у....
Dialogue: 0,0:08:49.99,0:08:52.66,Default,,0,0,0,,Сол күннен бастап біртүрлі болып кетті.
Dialogue: 0,0:08:52.66,0:08:55.16,Default,,0,0,0,,Мен танымайтын адамдар туралы сұрау...
Dialogue: 0,0:08:55.16,0:08:57.17,Default,,0,0,0,,Мен: Бұл таңқаларлық емес.
Dialogue: 0,0:08:57.17,0:09:00.94,Default,,0,0,0,,Онда маған айтыңыз. Юки Чан деген кім?
Dialogue: 0,0:09:00.94,0:09:05.44,Default,,0,0,0,,Танымайтын адамға айтпа.
Dialogue: 0,0:09:05.44,0:09:08.61,Default,,0,0,0,,Мен бейтаныс емеспін! ?
Dialogue: 0,0:09:08.61,0:09:12.28,Default,,0,0,0,,Не болды! Бұл вирус па?
Dialogue: 0,0:09:12.28,0:09:14.28,Default,,0,0,0,,Поппо…. Жоқ, бәлкім... Кенжи!
Dialogue: 0,0:09:14.28,0:09:16.95,Default,,0,0,0,,Хаха…. Ана…мама….
Dialogue: 0,0:09:16.95,0:09:22.62,Default,,0,0,0,,Хахаха... Менің ақшамды алдың ғой, солай ма?
Dialogue: 0,0:09:22.62,0:09:27.30,Default,,0,0,0,,Жарайды... Егер жағдай осылай жалғаса берсе, мен Поппоға қатты өкінемін, солай ма?
Dialogue: 0,0:09:27.30,0:09:31.13,Default,,0,0,0,,Уайымдамаңыз! Бұл робот тірі зат емес!
Dialogue: 0,0:09:31.13,0:09:33.47,Default,,0,0,0,,Жақсы жасалған ойыншық! Тоқта!
Dialogue: 0,0:09:33.47,0:09:36.30,Default,,0,0,0,,Кен-чан, мама, ұрыс, жоқ.
Dialogue: 0,0:09:36.30,0:09:38.31,Default,,0,0,0,,Ұрыс жоқ. Хмм...
Dialogue: 0,0:09:38.31,0:09:40.64,Default,,0,0,0,,Машина жылайды және күледі ➡
Dialogue: 0,0:09:40.64,0:09:42.64,Default,,0,0,0,,Мұның бәрі өтірік!
Dialogue: 0,0:09:42.64,0:09:44.65,Default,,0,0,0,,Жай ғана түсінікті түрде жауап беру➡
Dialogue: 0,0:09:44.65,0:09:47.48,Default,,0,0,0,,Оның ерік-жігері де, эмоциясы да жоқ!
Dialogue: 0,0:09:47.48,0:09:50.15,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:09:50.15,0:09:53.99,Default,,0,0,0,,Ондай нәрсе жоқ... Бұл дұрыс емес...
Dialogue: 0,0:09:53.99,0:09:55.99,Default,,0,0,0,,Бір сәт кешіріңіз.
Dialogue: 0,0:09:55.99,0:10:00.50,Default,,0,0,0,,Мен оны қалпына келтіруге болатынын білмеймін, бірақ көрейік. Ах!
Dialogue: 0,0:10:00.50,0:10:03.33,Default,,0,0,0,,Маған ақша керек емес. Ах!
Dialogue: 0,0:10:03.33,0:10:05.33,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:10:11.34,0:10:14.01,Default,,0,0,0,,🔊 Ішкі деректерді талдау аяқталды.
Dialogue: 0,0:10:14.01,0:10:17.81,Default,,0,0,0,,Есепті елестетіңіз. 🔊Мен түсіндім.
Dialogue: 0,0:10:23.02,0:10:25.02,Default,,0,0,0,,Тағы біраз күтіңіз.
Dialogue: 0,0:10:25.02,0:10:27.12,Default,,0,0,0,,Иә. Ха...
Dialogue: 0,0:10:31.03,0:10:34.20,Default,,0,0,0,,Директор роботтар туралы көп біледі, солай ма?
Dialogue: 0,0:10:34.20,0:10:36.53,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:10:36.53,0:10:39.20,Default,,0,0,0,,Поппоның жүрегі бар ма? сондықтан….
Dialogue: 0,0:10:39.20,0:10:41.20,Default,,0,0,0,,Мен білмеймін. (Марико/Кенджи) Иә?
Dialogue: 0,0:10:41.20,0:10:45.87,Default,,0,0,0,,Мидың көптеген құпиялары ғылыми прогресс арқылы ашылды➡
Dialogue: 0,0:10:45.87,0:10:50.38,Default,,0,0,0,,Жүректің не екендігі туралы әркімнің өз пікірі бар.
Dialogue: 0,0:10:50.38,0:10:55.38,Default,,0,0,0,,Біріншіден, ешкімде жүрек болмауы мүмкін.
Dialogue: 0,0:10:55.38,0:10:57.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:57.39,0:11:00.32,Default,,0,0,0,,Енді біз Юки-чанның шынайы тұлғасын білеміз.
Dialogue: 0,0:11:00.32,0:11:02.32,Default,,0,0,0,,Хмм….
Dialogue: 0,0:11:02.32,0:11:07.83,Default,,0,0,0,,Мен жад деректерін қарадым, бірақ 20 жылдан астам бұрынғы деректер әлі бар.
Dialogue: 0,0:11:07.83,0:11:10.83,Default,,0,0,0,,Бұл аю пайдаланылған аю немесе бірдеңе, солай ма?
Dialogue: 0,0:11:10.83,0:11:12.83,Default,,0,0,0,,Не? Иә….
Dialogue: 0,0:11:12.83,0:11:17.51,Default,,0,0,0,,Сонда Юки-чан осы аюдың бұрынғы иесі болуы керек.
Dialogue: 0,0:11:17.51,0:11:21.68,Default,,0,0,0,,Басқаша айтқанда, бұл ескі компьютерлерде жиі кездесетін жағдай➡
Dialogue: 0,0:11:21.68,0:11:24.68,Default,,0,0,0,,Тіпті жад бетінде қалпына келтірілсе де➡
Dialogue: 0,0:11:24.68,0:11:28.18,Default,,0,0,0,,Мәліметтердің өзі жадта қалады.
Dialogue: 0,0:11:28.18,0:11:31.02,Default,,0,0,0,,Деректерді соңғы рет құтқардым➡
Dialogue: 0,0:11:31.02,0:11:34.62,Default,,0,0,0,,Ескі және жаңа естеліктердің бәрі бірден қайта жаңғырғандай.
Dialogue: 0,0:11:36.69,0:11:40.86,Default,,0,0,0,,Егер сіз ескі деректерді жойсаңыз, аю дерлік қалыпты жағдайға оралады.
Dialogue: 0,0:11:40.86,0:11:42.86,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:11:48.87,0:11:50.87,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:11:50.87,0:11:52.87,Default,,0,0,0,,Юки-чанның естеліктерін өшірсем➡
Dialogue: 0,0:11:52.87,0:11:56.04,Default,,0,0,0,,Кэндзи Поппо мұңая ма деп таң қалады➡
Dialogue: 0,0:11:56.04,0:11:59.38,Default,,0,0,0,,Соңында мен оны үйге әкелдім.
Dialogue: 0,0:11:59.38,0:12:03.82,Default,,0,0,0,,А-а... Менің ойымша, бұл біздің қайта үйленгенімізге байланысты шығар.
Dialogue: 0,0:12:03.82,0:12:06.99,Default,,0,0,0,,Ол бала Поппоға қатты тәуелді.
Dialogue: 0,0:12:06.99,0:12:12.33,Default,,0,0,0,,Қалай болғанда да, мен ол роботты Кенджиден алыстатуым керек.
Dialogue: 0,0:12:12.33,0:12:15.83,Default,,0,0,0,,Ертең ол бала мектепте жүргенде➡
Dialogue: 0,0:12:15.83,0:12:17.83,Default,,0,0,0,,Мен алып тастау компаниясына хабарласамын.
Dialogue: 0,0:12:26.17,0:12:28.58,Default,,0,0,0,,Юки-чан қайда?
Dialogue: 0,0:12:36.18,0:12:38.52,Default,,0,0,0,,Кен Чан, үйге қайтайық?
Dialogue: 0,0:12:38.52,0:12:40.52,Default,,0,0,0,,Хмм….
Dialogue: 0,0:12:40.52,0:12:43.19,Default,,0,0,0,,Бүгін көңілді күн болды. иә?
Dialogue: 0,0:12:43.19,0:12:48.03,Default,,0,0,0,,Соңғы естеліктеріңіз үшін рахмет, Шизука.
Dialogue: 0,0:12:48.03,0:12:50.03,Default,,0,0,0,,Естеліктер.
Dialogue: 0,0:12:50.03,0:12:53.70,Default,,0,0,0,,Иә, бұл ескерткіш болды.
Dialogue: 0,0:12:53.70,0:12:56.20,Default,,0,0,0,,Жақында ұмытып кетесіз бе?
Dialogue: 0,0:12:56.20,0:12:58.21,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:58.21,0:13:00.91,Default,,0,0,0,,Ах... хмм...
Dialogue: 0,0:13:06.65,0:13:08.65,Default,,0,0,0,,Хмм….
Dialogue: 0,0:13:15.16,0:13:17.16,Default,,0,0,0,,Олай болса, қош бол.
Dialogue: 0,0:13:17.16,0:13:20.66,Default,,0,0,0,,Қош бол, Джо.
Dialogue: 0,0:13:20.66,0:13:25.50,Default,,0,0,0,,Біздің қызметті пайдаланғаныңыз үшін рахмет.
Dialogue: 0,0:13:25.50,0:13:31.34,Default,,0,0,0,,Бүгіннен бастап біз Робот Джо жалға алумен келісім-шартымызды бұзамыз.
Dialogue: 0,0:13:31.34,0:13:36.34,Default,,0,0,0,,Сізбен бірге деректер бас кеңсе серверінде 5 жыл бойы сақталады.
Dialogue: 0,0:13:36.34,0:13:39.35,Default,,0,0,0,,Сүйіктіңнің жағдайы жақсы болмаса➡
Dialogue: 0,0:13:39.35,0:13:41.35,Default,,0,0,0,,Қайта тірілу сиқырын қолданыңыз.
Dialogue: 0,0:13:43.69,0:13:46.19,Default,,0,0,0,,5 жылдан кейін не болады?
Dialogue: 0,0:13:46.19,0:13:51.69,Default,,0,0,0,,Барлық естеліктер бір күні жоғалады, Шизука.
Dialogue: 0,0:13:55.20,0:13:57.20,Default,,0,0,0,,Хмм….
Dialogue: 0,0:13:57.20,0:14:01.14,Default,,0,0,0,,Қашқын ба? Жоқ, ол менің үйіме келген жоқ.
Dialogue: 0,0:14:01.14,0:14:03.64,Default,,0,0,0,,Полицияға хабарласуым керек пе?
Dialogue: 0,0:14:06.47,0:14:09.48,Default,,0,0,0,,Аа... Кенжи.
Dialogue: 0,0:14:13.82,0:14:15.82,Default,,0,0,0,,Мм... Ах...
Dialogue: 0,0:14:19.49,0:14:22.49,Default,,0,0,0,,Менен бірдеңе керек пе?
Dialogue: 0,0:14:22.49,0:14:25.79,Default,,0,0,0,,Мм... мұңаймайсың ба?
Dialogue: 0,0:14:32.50,0:14:36.84,Default,,0,0,0,,Менің барлық мінез-құлқым алдын ала бағдарламаланған.
Dialogue: 0,0:14:36.84,0:14:39.84,Default,,0,0,0,,Хмм... Мен оны мектепте үйрендім.
Dialogue: 0,0:14:39.84,0:14:44.01,Default,,0,0,0,,Бұрын гуманоидтар да машина деп саналған.
Dialogue: 0,0:14:44.01,0:14:48.18,Default,,0,0,0,,Бірақ қазір бәрі басқаша. сондықтан….
Dialogue: 0,0:14:48.18,0:14:52.02,Default,,0,0,0,,Біз роботтар адамдар үшін жасалған бұйымдармыз.
Dialogue: 0,0:14:52.02,0:14:56.52,Default,,0,0,0,,Роботтар мен гуманоидтар әртүрлі. Мұны ұмытпа.
Dialogue: 0,0:14:56.52,0:15:00.63,Default,,0,0,0,,Бірақ... үлкен апа ертерек жылап тұрған жоқ па?
Dialogue: 0,0:15:00.63,0:15:04.13,Default,,0,0,0,,Тіс щеткасын лақтырғанда ешкім жыламайды.
Dialogue: 0,0:15:04.13,0:15:10.47,Default,,0,0,0,,Сондықтан сенің ағаң... роботтардың да жүрегі бар.
Dialogue: 0,0:15:10.47,0:15:12.47,Default,,0,0,0,,Бұл сөзсіз.
Dialogue: 0,0:15:14.48,0:15:20.98,Default,,0,0,0,,Дұрыс. Мүмкін оның ішінде жүрегім бар шығар.
Dialogue: 0,0:15:20.98,0:15:23.15,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:23.15,0:15:26.49,Default,,0,0,0,,Мен Поппомын. Сәлем Поппо.
Dialogue: 0,0:15:26.49,0:15:29.66,Default,,0,0,0,,Сіздің клиентіңіз жақсы адам.
Dialogue: 0,0:15:29.66,0:15:33.83,Default,,0,0,0,,Иә. Кен Чан өте мейірімді. Иә.
Dialogue: 0,0:15:33.83,0:15:38.00,Default,,0,0,0,,Поппо Кен Чанды жақсы көреді.
Dialogue: 0,0:15:38.00,0:15:40.00,Default,,0,0,0,,Хмм….
Dialogue: 0,0:15:48.51,0:15:54.02,Default,,0,0,0,,🔊Құпиялылық туралы келісімге сәйкес, біз енді Джоның жадын қалпына келтіреміз.
Dialogue: 0,0:15:54.02,0:16:06.63,Default,,0,0,0,,♬～
Dialogue: 0,0:16:06.63,0:16:09.96,Default,,0,0,0,,Кен Чан, үйге қайтайық?
Dialogue: 0,0:16:09.96,0:16:13.13,Default,,0,0,0,,Бұл мен үшін уайымдап жүргеніңді білдіре ме?
Dialogue: 0,0:16:13.13,0:16:16.14,Default,,0,0,0,,Әлде бағдарламада айтылған ба?
Dialogue: 0,0:16:22.98,0:16:25.65,Default,,0,0,0,,Кен-чан Кен-чан.
Dialogue: 0,0:16:25.65,0:16:29.15,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:16:29.15,0:16:32.15,Default,,0,0,0,,Кен-чан, мен суық тиіп алайын деп жатырмын.
Dialogue: 0,0:16:36.49,0:16:39.83,Default,,0,0,0,,Мұнда біреу бар ма? Біреу байқайды.
Dialogue: 0,0:16:39.83,0:16:42.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:42.00,0:16:44.33,Default,,0,0,0,,Біреу, Кен Чан...
Dialogue: 0,0:16:44.33,0:16:46.83,Default,,0,0,0,,Біреу… біреу….
Dialogue: 0,0:16:51.17,0:16:54.84,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:16:54.84,0:16:58.35,Default,,0,0,0,,Жақсы болды ма? Не? иә? Неліктен бұлай болды...?
Dialogue: 0,0:16:58.35,0:17:01.62,Default,,0,0,0,,Ах... А~? Бұл не?
Dialogue: 0,0:17:01.62,0:17:06.95,Default,,0,0,0,,Ха... мені қорқытпа! Бұл ойыншық. Мен таң қалдым.
Dialogue: 0,0:17:06.95,0:17:08.96,Default,,0,0,0,,Ах! Поппо!
Dialogue: 0,0:17:11.29,0:17:15.30,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:17:15.30,0:17:20.13,Default,,0,0,0,,Бұл менің кінәм. Поппо көрмегендіктен...
Dialogue: 0,0:17:20.13,0:17:24.31,Default,,0,0,0,,Уау! Ах~! Ах...
Dialogue: 0,0:17:24.31,0:17:28.31,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:17:31.48,0:17:33.48,Default,,0,0,0,,Аа... (аяқ дыбыстары)
Dialogue: 0,0:17:33.48,0:17:35.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:40.66,0:17:42.99,Default,,0,0,0,,Ол ақыры ұйықтап қалды.
Dialogue: 0,0:17:42.99,0:17:46.33,Default,,0,0,0,,Иә. сенімен бәрі жақсы ма?
Dialogue: 0,0:17:46.33,0:17:49.00,Default,,0,0,0,,Аа... Бұл керемет емес пе?
Dialogue: 0,0:17:49.00,0:17:52.67,Default,,0,0,0,,Кенжи аман-есен оралды... Кен-чан. иә?
Dialogue: 0,0:17:52.67,0:17:58.37,Default,,0,0,0,,Мен суық тигіземін. Біреу байқады... біреу...
Dialogue: 0,0:18:00.61,0:18:03.78,Default,,0,0,0,,Иә... Марико. иә?
Dialogue: 0,0:18:03.78,0:18:09.78,Default,,0,0,0,,Поппо көлікті тоқтату үшін өзін құрбан етті деп ойлайсың ба?
Dialogue: 0,0:18:09.78,0:18:12.12,Default,,0,0,0,,Менің ойымша, сіз бұл туралы артық ойланып жатырсыз.
Dialogue: 0,0:18:12.12,0:18:17.02,Default,,0,0,0,,О... бұл дұрыс. Иә, бұл сөзсіз.
Dialogue: 0,0:18:20.63,0:18:23.63,Default,,0,0,0,,Оны ауруханаға апарайық.
Dialogue: 0,0:18:23.63,0:18:26.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:26.80,0:18:28.80,Default,,0,0,0,,Біз оны сіз үшін сақтаймыз.
Dialogue: 0,0:18:36.14,0:18:39.15,Default,,0,0,0,,🔊Дайын.
Dialogue: 0,0:18:39.15,0:18:43.99,Default,,0,0,0,,Мүлдем... Біз қашан ойыншық жөндеу шеберханасы болдық?
Dialogue: 0,0:18:43.99,0:18:45.99,Default,,0,0,0,,Уф….
Dialogue: 0,0:18:49.66,0:18:51.66,Default,,0,0,0,,Процедураның басталуы.
Dialogue: 0,0:18:54.83,0:18:58.17,Default,,0,0,0,,Поппо…. Сенімен бәрі жақсы ма. Ах...
Dialogue: 0,0:18:58.17,0:19:01.37,Default,,0,0,0,,Бұл көмектесетініне сенімдімін. Сенімен бәрі жақсы ма.
Dialogue: 0,0:19:09.94,0:19:12.28,Default,,0,0,0,,Юки Чан осында ма?
Dialogue: 0,0:19:12.28,0:19:15.58,Default,,0,0,0,,Иә, бұл директор мен үшін зерттеді.
Dialogue: 0,0:19:22.96,0:19:25.63,Default,,0,0,0,,Поппо Бұл Юки Чан.
Dialogue: 0,0:19:25.63,0:19:28.96,Default,,0,0,0,,Поппо Юки Чанмен жақын болды ма?
Dialogue: 0,0:19:28.96,0:19:35.47,Default,,0,0,0,,Иә. Біз әрқашан бірге болдық, бірақ кенет бір-бірімізді енді көре алмадық.
Dialogue: 0,0:19:35.47,0:19:41.48,Default,,0,0,0,,Анам да, әкем де Юки Чанның қайда екенін айтқан жоқ.
Dialogue: 0,0:19:41.48,0:19:46.48,Default,,0,0,0,,Бірақ мен әрқашан Юки Чанмен кездескім келетін.
Dialogue: 0,0:19:46.48,0:19:49.98,Default,,0,0,0,,Өйткені біз мәңгі бірге боламыз деп уәде берген едік.
Dialogue: 0,0:19:49.98,0:19:54.49,Default,,0,0,0,,Юки-чан, біз ақыры таныстық.
Dialogue: 0,0:19:54.49,0:19:58.99,Default,,0,0,0,,А... Иә? аа….
Dialogue: 0,0:20:05.00,0:20:07.00,Default,,0,0,0,,Анашым….
Dialogue: 0,0:20:15.68,0:20:21.18,Default,,0,0,0,,А... роботтардың жүрегі жоқ па?
Dialogue: 0,0:20:21.18,0:20:23.18,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:20:26.35,0:20:31.36,Default,,0,0,0,,Мен білмеймін. Анам да түсінбеді.
Dialogue: 0,0:20:31.36,0:20:34.36,Default,,0,0,0,,Хмм….
Dialogue: 0,0:20:34.36,0:20:38.20,Default,,0,0,0,,Кен-чан, бұл теңіз бе? Бұл дұрыс.
Dialogue: 0,0:20:38.20,0:20:41.90,Default,,0,0,0,,Теңізді бірінші рет көріп тұрмын.
Dialogue: 0,0:20:44.04,0:20:46.04,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:20:54.38,0:20:56.38,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:20:56.38,0:21:00.65,Default,,0,0,0,,Мен мұны білмей тұрып Джо туралы ойладым.
Dialogue: 0,0:21:00.65,0:21:04.83,Default,,0,0,0,,Шынымды айтсам, бұл медициналық көмек көрсететін орын емес.
Dialogue: 0,0:21:04.83,0:21:07.33,Default,,0,0,0,,Менің қазіргі сүйіктіммен ажырасу➡
Dialogue: 0,0:21:07.33,0:21:11.50,Default,,0,0,0,,Қайта тірілу сиқыры деп аталатын қызметті пайдалану туралы не айтуға болады?
Dialogue: 0,0:21:11.50,0:21:15.34,Default,,0,0,0,,Бірақ Джоның сезімі...
Dialogue: 0,0:21:15.34,0:21:18.67,Default,,0,0,0,,Робот сізді кінәламайды.
Dialogue: 0,0:21:18.67,0:21:20.84,Default,,0,0,0,,Осылайша орындалады.
Dialogue: 0,0:21:20.84,0:21:24.68,Default,,0,0,0,,Сондықтан бұл маған оңай...
Dialogue: 0,0:21:24.68,0:21:27.68,Default,,0,0,0,,Джомен кездескенде қандай бет-әлпеті бар?
Dialogue: 0,0:21:33.69,0:21:38.36,Default,,0,0,0,,Профессор Судо роботтардың жүрегі бар деп есептейтін адам емес пе еді?
Dialogue: 0,0:21:38.36,0:21:40.53,Default,,0,0,0,,Мұны кім айтты?
Dialogue: 0,0:21:40.53,0:21:43.03,Default,,0,0,0,,Не? А, бірақ...
Dialogue: 0,0:21:43.03,0:21:46.37,Default,,0,0,0,,Мен өзім ғана жасай алатын емді қалаймын.
Dialogue: 0,0:21:46.37,0:21:50.37,Default,,0,0,0,,Міне. Өтінемін күте тұрыңыз.
Dialogue: 0,0:21:50.37,0:21:53.87,Default,,0,0,0,,Судо мырза, менімен кешкі асқа барғыңыз келе ме?
Dialogue: 0,0:21:53.87,0:21:56.54,Default,,0,0,0,,Бұл менің тағы да сыйлығым ба?
Dialogue: 0,0:21:56.54,0:21:58.88,Default,,0,0,0,,Мұны кім айтты?
Dialogue: 0,0:21:58.88,0:22:03.18,Default,,0,0,0,,Жарайды... егер мен үшін бірдеңе сатып алғыңыз келсе, мен оны сізге сатып аламын.
Dialogue: 0,0:22:06.82,0:22:09.82,Default,,0,0,0,,Ха... иә...
Dialogue: 0,0:22:12.16,0:22:15.50,Default,,0,0,0,,Біздің қызметті пайдаланғаныңыз үшін рахмет➡
Dialogue: 0,0:22:15.50,0:22:17.83,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:22:17.83,0:22:19.83,Default,,0,0,0,,Бұл Джо, жалға алушы робот.
Dialogue: 0,0:22:19.83,0:22:21.84,Default,,0,0,0,,Эй... танысқаныма қуаныштымын.
Dialogue: 0,0:22:23.84,0:22:25.84,Default,,0,0,0,,Аа...
Dialogue: 0,0:22:27.34,0:22:33.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
