Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:44.21,0:00:46.58,Default,,0,0,0,,Неге ештеңе айтпадың?
Dialogue: 0,0:01:20.74,0:01:22.16,Default,,0,0,0,,О
Dialogue: 0,0:01:26.25,0:01:27.21,Default,,0,0,0,,"Олар әңгімелесіп жатыр!"
Dialogue: 0,0:01:32.30,0:01:33.09,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:01:36.47,0:01:38.97,Default,,0,0,0,,(Сағат дабылының дыбысы)
Dialogue: 0,0:01:42.93,0:01:45.93,Default,,0,0,0,,Мен неге сол күндерді армандадым?
Dialogue: 0,0:01:46.73,0:01:48.65,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:01:52.86,0:01:54.53,Default,,0,0,0,,Қайырлы таң Хал
Dialogue: 0,0:01:54.61,0:01:55.61,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:01:56.28,0:01:57.99,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:02:00.12,0:02:03.70,Default,,0,0,0,,Сонымен, мен жағаға барғанда, одан кейін тамақты жалғастырдым.
Dialogue: 0,0:02:03.79,0:02:05.16,Default,,0,0,0,,Нағисаға ұқсайды
Dialogue: 0,0:02:05.25,0:02:08.50,Default,,0,0,0,,Иә, бірақ осылайша сіз өзіңіздің ең жақсыңызды орнатасыз.
Dialogue: 0,0:02:08.58,0:02:09.42,Default,,0,0,0,,О
Dialogue: 0,0:02:09.50,0:02:11.33,Default,,0,0,0,,Хал Суық па?
Dialogue: 0,0:02:11.42,0:02:13.13,Default,,0,0,0,,Жел салқын
Dialogue: 0,0:02:13.21,0:02:15.13,Default,,0,0,0,,Бүгін аздап салқын.
Dialogue: 0,0:02:17.72,0:02:19.38,Default,,0,0,0,,Көктем келді
Dialogue: 0,0:02:20.64,0:02:23.47,Default,,0,0,0,,Иә, бұл көктемнің иісі шығар.
Dialogue: 0,0:02:23.56,0:02:27.27,Default,,0,0,0,,Жылдың осы мезгілінде көп нәрсені есімде сақтаймын.
Dialogue: 0,0:02:28.06,0:02:31.31,Default,,0,0,0,,Эй Хал, есіңде ме? Біз кездескен кезде
Dialogue: 0,0:02:41.70,0:02:44.53,Default,,0,0,0,,(трек дыбысы)
Dialogue: 0,0:02:44.62,0:02:46.91,Default,,0,0,0,,Ах, самосвал
Dialogue: 0,0:02:47.00,0:02:48.16,Default,,0,0,0,,Қайда?
Dialogue: 0,0:02:48.25,0:02:49.91,Default,,0,0,0,,Бұл өте үлкен!
Dialogue: 0,0:02:50.00,0:02:50.92,Default,,0,0,0,,(Декү) Кешір мені (Каири) Ах…
Dialogue: 0,0:02:51.75,0:02:53.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:00.72,0:03:02.01,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:04:47.03,0:04:50.83,Default,,0,0,0,,Мен Харумен танысқаныма өте қуаныштымын.
Dialogue: 0,0:04:50.91,0:04:52.45,Default,,0,0,0,,Рахмет саған Хару-чан
Dialogue: 0,0:04:53.75,0:04:55.83,Default,,0,0,0,,- (Харука) Ендеше, дұрыстап алайық... - (Нагиса) Эй!
Dialogue: 0,0:04:55.92,0:04:58.33,Default,,0,0,0,,Хару-чан Мако-чан
Dialogue: 0,0:04:58.42,0:05:00.21,Default,,0,0,0,,Рей Нагиса
Dialogue: 0,0:05:00.30,0:05:01.71,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:05:02.30,0:05:03.97,Default,,0,0,0,,Екеуі де ерте
Dialogue: 0,0:05:04.05,0:05:06.55,Default,,0,0,0,,Көктемгі демалыс аяқталды.
Dialogue: 0,0:05:06.63,0:05:09.85,Default,,0,0,0,,Сәуір айынан бастап қайта туылғанымды көрсетемін деп ойладым.
Dialogue: 0,0:05:09.93,0:05:10.97,Default,,0,0,0,,Көңілді
Dialogue: 0,0:05:11.06,0:05:13.68,Default,,0,0,0,,Жай жатып ұйықтай алмаймын.
Dialogue: 0,0:05:13.77,0:05:16.31,Default,,0,0,0,,О, Рей-чан, мен қатты толқып тұрмын!
Dialogue: 0,0:05:16.39,0:05:19.73,Default,,0,0,0,,Мен осылай жүгіру арқылы күш-қуатымды арттырғандай сезінемін.
Dialogue: 0,0:05:19.81,0:05:22.73,Default,,0,0,0,,Хехе, екеуің де сенімді екенсіңдер.
Dialogue: 0,0:05:22.82,0:05:27.57,Default,,0,0,0,,Иә! Биыл осы төртеуі барғанша алысқа барса екен деймін.
Dialogue: 0,0:05:28.32,0:05:30.12,Default,,0,0,0,,Жарайды, Харука-сенпай.
Dialogue: 0,0:05:30.20,0:05:31.99,Default,,0,0,0,,Әдеттегі курс дұрыс па?
Dialogue: 0,0:05:32.08,0:05:34.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:34.62,0:05:37.75,Default,,0,0,0,,Олай болса, мен бүгін бірінші боламын.
Dialogue: 0,0:05:37.83,0:05:41.71,Default,,0,0,0,,А, күте тұр, Нағиса-күн.
Dialogue: 0,0:05:41.79,0:05:44.26,Default,,0,0,0,,Хару, біз де барайық.
Dialogue: 0,0:05:52.60,0:05:55.10,Default,,0,0,0,,♪~
Dialogue: 0,0:07:36.16,0:07:38.16,Default,,0,0,0,,~♪
Dialogue: 0,0:07:38.91,0:07:42.54,Default,,0,0,0,,Жоғарыда айтылғандар студенттерді тартудың жаңа стратегиясы.
Dialogue: 0,0:07:42.62,0:07:45.42,Default,,0,0,0,,Осы үндеу арқылы барлығының назарын аударыңыз
Dialogue: 0,0:07:45.50,0:07:49.67,Default,,0,0,0,,Біз керемет бұлшықеттері бар жаңа мүше аламыз~
Dialogue: 0,0:07:49.76,0:07:51.47,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:07:52.47,0:07:56.39,Default,,0,0,0,,Біз Иватоби жүзу клубының мүшелерін таныстырғымыз келеді.
Dialogue: 0,0:07:57.35,0:07:58.64,Default,,0,0,0,,- (Цзян) Бухгалтерлік есеп! -(Нағиса) Әй.
Dialogue: 0,0:08:00.98,0:08:02.94,Default,,0,0,0,,- Ал (жаңа студенттер) ше!? - (Нағиса) Ура!
Dialogue: 0,0:08:03.73,0:08:05.65,Default,,0,0,0,,2 курс Нагиса Хазуки
Dialogue: 0,0:08:05.73,0:08:08.86,Default,,0,0,0,,Оның мамандығы брасс әдісі, ал сүйкімділігі
Dialogue: 0,0:08:08.94,0:08:10.69,Default,,0,0,0,,Бұл табан бұлшықеті.
Dialogue: 0,0:08:11.40,0:08:12.45,Default,,0,0,0,,Директордың орынбасары!
Dialogue: 0,0:08:13.95,0:08:15.03,Default,,0,0,0,,Ах!?
Dialogue: 0,0:08:15.87,0:08:17.78,Default,,0,0,0,,3 курс Харука Нанасе
Dialogue: 0,0:08:17.87,0:08:20.75,Default,,0,0,0,,Мамандық тегін Шарм ұпайлары
Dialogue: 0,0:08:21.45,0:08:22.58,Default,,0,0,0,,Трицепс
Dialogue: 0,0:08:23.21,0:08:24.42,Default,,0,0,0,,- (Цзян) Хатшы! -(Рей) Эй!
Dialogue: 0,0:08:26.54,0:08:27.84,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:27.92,0:08:29.84,Default,,0,0,0,,2 курс Рей Рюгасаки
Dialogue: 0,0:08:29.92,0:08:32.80,Default,,0,0,0,,Мамандығым көбелек, сүйкімділігім
Dialogue: 0,0:08:32.88,0:08:35.72,Default,,0,0,0,,Дельта және бицепс!
Dialogue: 0,0:08:36.43,0:08:38.18,Default,,0,0,0,,Және менеджер!
Dialogue: 0,0:08:41.22,0:08:42.73,Default,,0,0,0,,3 курс Макото Тачибана
Dialogue: 0,0:08:42.81,0:08:45.69,Default,,0,0,0,,Оның мамандығы арқамен жүзу, ал сүйкімділігі
Dialogue: 0,0:08:46.81,0:08:47.90,Default,,0,0,0,,Трапеция бұлшықеті
Dialogue: 0,0:08:47.98,0:08:52.24,Default,,0,0,0,,Сізді бұлшық еттері жақсы жаңа студент күтуде.
Dialogue: 0,0:08:55.82,0:08:57.57,Default,,0,0,0,,Не?!
Dialogue: 0,0:08:57.66,0:09:00.28,Default,,0,0,0,,Барлығы қатты еңбек етті~
Dialogue: 0,0:09:00.37,0:09:04.71,Default,,0,0,0,,Негізі бұлшық еттерін көрсету туралы болды...
Dialogue: 0,0:09:06.25,0:09:09.13,Default,,0,0,0,,Әй, анау алыстан келген жігіт бар.
Dialogue: 0,0:09:09.21,0:09:11.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:11.13,0:09:13.71,Default,,0,0,0,,Бұл оның да есейгенін білдіре ме?
Dialogue: 0,0:09:13.80,0:09:14.63,Default,,0,0,0,,Иә
Dialogue: 0,0:09:14.72,0:09:18.39,Default,,0,0,0,,Шынымды айтсам, былтырғы жарыс мені де таң қалдырды.
Dialogue: 0,0:09:19.43,0:09:23.02,Default,,0,0,0,,Нанасе-кун мен басқалардың өз ойлары бар сияқты.
Dialogue: 0,0:09:25.60,0:09:29.02,Default,,0,0,0,,Мен кеңесші ретінде ол балаларға не істей аламын?
Dialogue: 0,0:09:29.11,0:09:31.52,Default,,0,0,0,,Осыны ойласам, абдырап қалдым.
Dialogue: 0,0:09:31.61,0:09:35.90,Default,,0,0,0,,Керісінше, Нанасе-кун мен басқалары мені жігерлендіріп жатқандай сезінемін.
Dialogue: 0,0:09:36.74,0:09:38.78,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:09:38.86,0:09:42.12,Default,,0,0,0,,Командамен бетпе-бет келіп, жүзуді өзінше білді.
Dialogue: 0,0:09:42.20,0:09:43.66,Default,,0,0,0,,Мен қуаныштымын.
Dialogue: 0,0:09:44.25,0:09:47.42,Default,,0,0,0,,Неліктен мен бала кезімнен еркін жүздім?
Dialogue: 0,0:09:47.50,0:09:50.00,Default,,0,0,0,,Ол қиын адам болған.
Dialogue: 0,0:10:35.38,0:10:39.88,Default,,0,0,0,,Сол жастағы балалар күннен күнге өсіп келеді.
Dialogue: 0,0:10:40.68,0:10:42.43,Default,,0,0,0,,Жастық шақ жақсы ғой, солай емес пе?
Dialogue: 0,0:10:42.51,0:10:46.72,Default,,0,0,0,,Хмм, Харука үшінші курс студенті емес пе?
Dialogue: 0,0:10:46.81,0:10:50.56,Default,,0,0,0,,Макото үшін де солай, бірақ сіз мансап жолыңыз туралы ойлайсыз ба?
Dialogue: 0,0:10:50.64,0:10:51.56,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:51.65,0:10:54.52,Default,,0,0,0,,Нанасе-кун және басқалары жақсы болатынына сенімдімін.
Dialogue: 0,0:10:54.61,0:10:58.57,Default,,0,0,0,,Өйткені ол жүзуге өте байыпты қарайды.
Dialogue: 0,0:11:00.28,0:11:02.49,Default,,0,0,0,,деп үміттенемін ...
Dialogue: 0,0:11:10.58,0:11:11.92,Default,,0,0,0,,Ойланып көріңізші.
Dialogue: 0,0:11:12.00,0:11:15.63,Default,,0,0,0,,Балалар, оқу бітірген соң не болатынын ойлап отырсыңдар ма?
Dialogue: 0,0:11:17.51,0:11:18.34,Default,,0,0,0,,Бөлек
Dialogue: 0,0:11:18.42,0:11:20.42,Default,,0,0,0,,Жоқ, бұл «арнайы» емес.
Dialogue: 0,0:11:20.51,0:11:24.18,Default,,0,0,0,,Ахаха Рин әлемді көздейді, солай ма?
Dialogue: 0,0:11:24.97,0:11:26.10,Default,,0,0,0,,О
Dialogue: 0,0:11:26.18,0:11:29.27,Default,,0,0,0,,Мен жол шөптерін көп жедім.
Dialogue: 0,0:11:29.35,0:11:32.31,Default,,0,0,0,,Биылғы жазғы ұлттық турнир сіздің соңғы мүмкіндігіңіз.
Dialogue: 0,0:11:32.40,0:11:34.77,Default,,0,0,0,,Республикалық турнирге барсаңыз, барлаушылар да келеді.
Dialogue: 0,0:11:34.86,0:11:35.94,Default,,0,0,0,,Онда жазыңыз
Dialogue: 0,0:11:36.61,0:11:37.94,Default,,0,0,0,,Мен арманымды орындаймын
Dialogue: 0,0:11:41.45,0:11:43.66,Default,,0,0,0,,Хару Макото
Dialogue: 0,0:11:43.74,0:11:46.28,Default,,0,0,0,,Балалар, не істеуді жоспарлап отырсыңдар?
Dialogue: 0,0:11:47.95,0:11:49.04,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:50.62,0:11:52.67,Default,,0,0,0,,Мен әлі шешкен жоқпын.
Dialogue: 0,0:12:00.67,0:12:02.68,Default,,0,0,0,,Сіз бұл туралы ойламайсыз ба?
Dialogue: 0,0:12:05.76,0:12:09.01,Default,,0,0,0,,А... бұл жолы азаматтардың құрылтайы.
Dialogue: 0,0:12:09.10,0:12:09.77,Default,,0,0,0,,Тек өтініш бергісі келетіндер қатыса алады...
Dialogue: 0,0:12:09.77,0:12:11.18,Default,,0,0,0,,Тек өтініш бергісі келетіндер ғана қатыса алады...
Dialogue: 0,0:12:09.77,0:12:11.18,Default,,0,0,0,,Рин-чан
Dialogue: 0,0:12:11.89,0:12:12.81,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:12:12.89,0:12:14.02,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:14.10,0:12:16.81,Default,,0,0,0,,Әйтеуір, турнирлерге үйренбегендер
Dialogue: 0,0:12:16.90,0:12:19.44,Default,,0,0,0,,Осы мүмкіндікті пайдаланып, атмосфераны сезініңіз.
Dialogue: 0,0:12:19.53,0:12:20.57,Default,,0,0,0,,- (Нитори) Иә! - (Акула үлгісіндегі жүзу клубының мүшелері) Иә!
Dialogue: 0,0:12:20.65,0:12:24.32,Default,,0,0,0,,Рин-сан таң қаларлықтай менеджер сияқты көрінді.
Dialogue: 0,0:12:24.41,0:12:27.49,Default,,0,0,0,,Өзіңді жақсы көрсетпесең, мен сені құртамын.\NСіз
Dialogue: 0,0:12:27.58,0:12:29.20,Default,,0,0,0,,сияқты бірдеңе айтты деп ойладым
Dialogue: 0,0:12:29.29,0:12:30.95,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:12:31.04,0:12:32.54,Default,,0,0,0,,Балалар, кешігіп қалдыңдар!
Dialogue: 0,0:12:32.62,0:12:34.67,Default,,0,0,0,,Горо-чан да жүзеді ме?
Dialogue: 0,0:12:34.75,0:12:37.33,Default,,0,0,0,,Кеттік! Сондай-ақ жалпы бөлім бар.
Dialogue: 0,0:12:37.92,0:12:40.59,Default,,0,0,0,,Префектуралық турнирден айырмашылығы, ол өзін еркін сезінді.
Dialogue: 0,0:12:40.67,0:12:42.21,Default,,0,0,0,,Мұндай нәрсе де жаман емес.
Dialogue: 0,0:12:42.30,0:12:45.51,Default,,0,0,0,,Бірақ бұлшық еттерім жеткіліксіз болуы мүмкін.
Dialogue: 0,0:12:45.59,0:12:48.26,Default,,0,0,0,,Оқиғада эстафета жоқ екені де ұят.
Dialogue: 0,0:12:48.35,0:12:49.89,Default,,0,0,0,,Мен де~
Dialogue: 0,0:12:49.97,0:12:52.22,Default,,0,0,0,,Бірақ мен префектуралық турнирде жүзе аламын.
Dialogue: 0,0:12:59.40,0:13:01.78,Default,,0,0,0,,Бұл тұтқындау ма? Рин
Dialogue: 0,0:13:01.86,0:13:04.03,Default,,0,0,0,,Мен сені күттім, Хару.
Dialogue: 0,0:13:05.03,0:13:07.03,Default,,0,0,0,,Басқа іргелес курс.
Dialogue: 0,0:13:07.11,0:13:08.03,Default,,0,0,0,,О
Dialogue: 0,0:13:08.12,0:13:12.41,Default,,0,0,0,,Балалар, сендер қыста дұрыс жүзе алмадыңдар, солай ма?
Dialogue: 0,0:13:12.50,0:13:14.83,Default,,0,0,0,,Қаласаңыз, өзіңізді мүгедек ете аласыз.
Dialogue: 0,0:13:16.46,0:13:18.04,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:13:18.13,0:13:20.42,Default,,0,0,0,,Мен жүзе алмасам да, жаттыға бердім.
Dialogue: 0,0:13:22.05,0:13:25.67,Default,,0,0,0,,Сіз шынымен мотивациясыз, солай емес пе? Хаха
Dialogue: 0,0:13:25.76,0:13:27.89,Default,,0,0,0,,Нәтижесін көрсетейін...
Dialogue: 0,0:13:27.97,0:13:29.30,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:13:29.39,0:13:32.10,Default,,0,0,0,,- (Бастауыш сынып оқушысы Б) Бұл менмін! -(Бастауыш сынып оқушысы А) Мен жеңілмеймін!
Dialogue: 0,0:13:32.18,0:13:35.35,Default,,0,0,0,,(А және В бастауыш сынып оқушыларының толқыған дауыстары)
Dialogue: 0,0:13:35.43,0:13:38.06,Default,,0,0,0,,Мен бүгін эстафетаға қатыса алмаймын.
Dialogue: 0,0:13:38.15,0:13:39.90,Default,,0,0,0,,Бұл сіз бен менің арамыздағы шайқас.
Dialogue: 0,0:13:39.98,0:13:42.53,Default,,0,0,0,,Маған жазбалар маңызды емес.
Dialogue: 0,0:13:43.15,0:13:45.36,Default,,0,0,0,,Сіз әлі де солай айтасыз ба?
Dialogue: 0,0:13:46.36,0:13:47.36,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:13:47.95,0:13:50.37,Default,,0,0,0,,Жеңістерге, жеңілістерге немесе рекордтарға қызығушылық танытпасаңыз да
Dialogue: 0,0:13:50.45,0:13:53.91,Default,,0,0,0,,Сіз өзіңізді суда біріншімін деп ойлайсыз, солай ма?
Dialogue: 0,0:13:54.50,0:13:56.08,Default,,0,0,0,,Сол суық цура
Dialogue: 0,0:13:56.71,0:13:58.37,Default,,0,0,0,,Мен оны қыздырамын
Dialogue: 0,0:13:59.96,0:14:02.88,Default,,0,0,0,,Ах, келесіде Хару-чан мен Рин-Чан.
Dialogue: 0,0:14:02.96,0:14:04.71,Default,,0,0,0,,Уууу~! Уф!
Dialogue: 0,0:14:04.80,0:14:06.72,Default,,0,0,0,,- (Макото) Хару~! -(Рей) Харука Сенпай!
Dialogue: 0,0:14:06.80,0:14:08.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:09.30,0:14:10.34,Default,,0,0,0,,
Dialogue: 0,0:14:12.68,0:14:13.85,Default,,0,0,0,,Екеуі де жылдам!
Dialogue: 0,0:14:25.86,0:14:27.57,Default,,0,0,0,,Рин екеуміздің арамыз барған сайын кеңейіп барады.
Dialogue: 0,0:14:27.65,0:14:30.28,Default,,0,0,0,,Жоғалтпа! Хару-чан!
Dialogue: 0,0:14:30.36,0:14:32.07,Default,,0,0,0,,- (Рей) Харука Сенпай! -(Макото) Хару~!
Dialogue: 0,0:14:44.42,0:14:50.68,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:14:58.60,0:15:01.15,Default,,0,0,0,,Сіз басқа ойыншыларға қарағанда мүлдем басқа деңгейдесіз
Dialogue: 0,0:15:01.23,0:15:04.52,Default,,0,0,0,,Бұл керемет, Хару-чан, сен бірте-бірте Рин-чанды қуып жетесің!
Dialogue: 0,0:15:11.53,0:15:12.45,Default,,0,0,0,,Пухат
Dialogue: 0,0:15:13.41,0:15:14.91,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:15:14.99,0:15:15.95,Default,,0,0,0,,Дәл осындай келу…
Dialogue: 0,0:15:16.04,0:15:19.16,Default,,0,0,0,,Мен жай ғана 4 және 5 курстарда жүздім.
Dialogue: 0,0:15:19.25,0:15:22.25,Default,,0,0,0,,Нанасе-кун Мацуока-кун Жаңа турнир рекорды
Dialogue: 0,0:15:22.33,0:15:23.25,Default,,0,0,0,,Корпус
Dialogue: 0,0:15:32.01,0:15:34.80,Default,,0,0,0,,«Ыстық» емес пе?
Dialogue: 0,0:15:36.10,0:15:37.43,Default,,0,0,0,,Бөлек
Dialogue: 0,0:15:46.69,0:15:48.90,Default,,0,0,0,,Бүгін біз жағалау бойымен курстан өтеміз бе?
Dialogue: 0,0:15:48.98,0:15:50.03,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:15:50.11,0:15:53.45,Default,,0,0,0,,Бүгін күн жылы, сондықтан турнирге дайындалу үшін қашықтықты сәл ұзартып көрейін деп ойладым.
Dialogue: 0,0:15:53.53,0:15:54.37,Default,,0,0,0,,О
Dialogue: 0,0:15:56.37,0:15:59.58,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:59.66,0:16:01.54,Default,,0,0,0,,- (Макото) Эй Хару - (Харука) Бұл не?
Dialogue: 0,0:16:01.62,0:16:04.29,Default,,0,0,0,,- (Макото) Хару не істемекші? -(Харука) Не?
Dialogue: 0,0:16:04.38,0:16:05.92,Default,,0,0,0,,Риннің айтқаны
Dialogue: 0,0:16:07.17,0:16:09.55,Default,,0,0,0,,Балалар, не істеуді жоспарлап отырсыңдар?
Dialogue: 0,0:16:11.09,0:16:12.80,Default,,0,0,0,,Мен жүзе алсам, кез келген жерге бара аламын.
Dialogue: 0,0:16:16.80,0:16:17.64,Default,,0,0,0,,Хехехе
Dialogue: 0,0:16:18.43,0:16:19.60,Default,,0,0,0,,Харуға ұқсайды.
Dialogue: 0,0:16:24.19,0:16:26.56,Default,,0,0,0,,Ертең префектуралық турнир өтеді!
Dialogue: 0,0:16:26.65,0:16:29.82,Default,,0,0,0,,Барлығыңыз, бүгін уақытыңызды бөліп, демалыңыз!
Dialogue: 0,0:16:29.90,0:16:34.07,Default,,0,0,0,,Ертең біз сағат 8-де өтетін орынның алдында кездесеміз. Кеш келуге қатаң тыйым салынады!
Dialogue: 0,0:16:34.15,0:16:35.78,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:16:35.86,0:16:38.33,Default,,0,0,0,,Жарайды! Менің көңіл-күйім тамаша
Dialogue: 0,0:16:38.41,0:16:39.28,Default,,0,0,0,,Бізде жаңа сәйкес келетін купальник алдық.
Dialogue: 0,0:16:39.28,0:16:40.29,Default,,0,0,0,,Бәрімізге де сәйкес келетін жаңа купальник алдық.
Dialogue: 0,0:16:39.28,0:16:40.29,Default,,0,0,0,,Биш
Dialogue: 0,0:16:40.29,0:16:41.08,Default,,0,0,0,,Бәрімізге де сәйкес келетін жаңа купальник алдық.
Dialogue: 0,0:16:41.16,0:16:43.46,Default,,0,0,0,,Хехе, дұрыс.
Dialogue: 0,0:16:43.54,0:16:46.58,Default,,0,0,0,,Ал, сенімді болу үшін бағдарламаны тексеріп көрейік.
Dialogue: 0,0:16:46.67,0:16:50.21,Default,,0,0,0,,Жарыстың бірінші күні жеке жарыс, ал екінші күні эстафеталық жарыс.
Dialogue: 0,0:16:50.30,0:16:53.09,Default,,0,0,0,,Жеке санаттың жазбасы Нағисаның бұлыңғырлығы үшін 100.
Dialogue: 0,0:16:53.17,0:16:54.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:54.09,0:16:56.59,Default,,0,0,0,,- (Макото) Рей шегірткенің 100-і - (Рей) Иә!
Dialogue: 0,0:16:56.68,0:16:59.10,Default,,0,0,0,,Корпуста бос 100 және 200 бар
Dialogue: 0,0:16:59.18,0:17:02.81,Default,,0,0,0,,Ал менде 100 кері және 200 бос.
Dialogue: 0,0:17:03.31,0:17:04.81,Default,,0,0,0,,Бірақ Тачибана-кун
Dialogue: 0,0:17:04.89,0:17:07.65,Default,,0,0,0,,Неліктен бос ұпайды 100 емес, 200 деп қойдыңыз?
Dialogue: 0,0:17:07.73,0:17:10.61,Default,,0,0,0,,100 Харуға мүлдем сәйкес келмейді.
Dialogue: 0,0:17:10.69,0:17:13.24,Default,,0,0,0,,Макото-сенпай Мақсатыңызды 200-ге дейін қысқартыңыз
Dialogue: 0,0:17:13.32,0:17:17.32,Default,,0,0,0,,Сіз күн сайын жаттығу көлемін арттырдыңыз және шын мәнінде көп жұмыс істедіңіз.
Dialogue: 0,0:17:18.03,0:17:22.37,Default,,0,0,0,,Егер сіз Харумен бірге жүзгіңіз келсе, сіз әлі ол жерде емессіз.
Dialogue: 0,0:17:37.09,0:17:38.39,Default,,0,0,0,,Сәлем Хару
Dialogue: 0,0:17:40.51,0:17:41.76,Default,,0,0,0,,Су Манасы, осы жанға ем бер.
Dialogue: 0,0:17:44.64,0:17:48.06,Default,,0,0,0,,Ерлер арасында брасс әдісімен 100м 3 топ
Dialogue: 0,0:17:48.15,0:17:50.36,Default,,0,0,0,,Ең алдымен, Нағиса-күннің бұлдырлығы.
Dialogue: 0,0:17:50.44,0:17:53.11,Default,,0,0,0,,Ммммммм... (Нитори терең дем алады)
Dialogue: 0,0:17:59.20,0:18:00.99,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:01.07,0:18:02.91,Default,,0,0,0,,Айт!
Dialogue: 0,0:18:03.79,0:18:06.62,Default,,0,0,0,,Бар, жүр, бар, жүр, Нағиса!
Dialogue: 0,0:18:06.71,0:18:09.46,Default,,0,0,0,,Бар, жүр, бар, жүр, Нағиса!
Dialogue: 0,0:18:09.54,0:18:12.17,Default,,0,0,0,,...
Dialogue: 0,0:18:12.25,0:18:15.01,Default,,0,0,0,,Оссе~ Осеоза, Осеоза, Нагиса!
Dialogue: 0,0:18:16.84,0:18:18.55,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:19.55,0:18:20.80,Default,,0,0,0,,Нагиса-кун, сен жоғарыдасың!
Dialogue: 0,0:18:23.97,0:18:25.64,Default,,0,0,0,,Артынан келе жатыр!
Dialogue: 0,0:18:25.72,0:18:28.35,Default,,0,0,0,,Жарайды! Нағиса әрқашан
Dialogue: 0,0:18:28.44,0:18:30.56,Default,,0,0,0,,Қолдар мақсатқа дейін созылады!
Dialogue: 0,0:18:34.53,0:18:35.40,Default,,0,0,0,,Пухат
Dialogue: 0,0:18:36.44,0:18:39.70,Default,,0,0,0,,Бұл бұлшықетті ақымақ па!?
Dialogue: 0,0:18:39.78,0:18:43.08,Default,,0,0,0,,Мен жасадым! Нагиса-кун іріктеу кезеңінен өтті!
Dialogue: 0,0:18:43.16,0:18:44.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:44.28,0:18:46.91,Default,,0,0,0,,Жарайсың Нағиса!
Dialogue: 0,0:18:47.00,0:18:49.25,Default,,0,0,0,,Келесі сөмке Макото!
Dialogue: 0,0:18:49.33,0:18:52.17,Default,,0,0,0,,Осы қарқынмен жүріңіз және жеңіңіз!
Dialogue: 0,0:18:52.25,0:18:53.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:55.67,0:18:59.34,Default,,0,0,0,,Ерлер арасында 100 метрге арқамен жүзу жарысы
Dialogue: 0,0:18:59.42,0:19:02.72,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:04.93,0:19:06.52,Default,,0,0,0,,Айт!
Dialogue: 0,0:19:10.77,0:19:13.73,Default,,0,0,0,,Бар, бар, бар, бар, Макото!
Dialogue: 0,0:19:13.81,0:19:16.57,Default,,0,0,0,,Бар, бар, бар, бар, Макото!
Dialogue: 0,0:19:16.65,0:19:19.44,Default,,0,0,0,,Осе-озе Макото!
Dialogue: 0,0:19:19.53,0:19:21.66,Default,,0,0,0,,Мако-чан жылдам!
Dialogue: 0,0:19:28.62,0:19:29.91,Default,,0,0,0,,Пуха!
Dialogue: 0,0:19:34.75,0:19:37.05,Default,,0,0,0,,Макото-сенпай алдын ала турдан өтті!
Dialogue: 0,0:19:37.13,0:19:39.80,Default,,0,0,0,,- (Е/Нагиса) Иә! -(Макото) Ахаха
Dialogue: 0,0:19:39.88,0:19:43.39,Default,,0,0,0,,Енді менің кезегім!
Dialogue: 0,0:19:44.51,0:19:48.81,Default,,0,0,0,,Барлығымыз көру үшін тамаша шегірткелерімізді көрсетейік!
Dialogue: 0,0:19:48.89,0:19:52.31,Default,,0,0,0,,Рей-чан, бұл сәтсіздік туы...
Dialogue: 0,0:19:52.39,0:19:54.44,Default,,0,0,0,,
Dialogue: 0,0:19:54.52,0:19:56.19,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:56.94,0:19:58.11,Default,,0,0,0,,Айт!
Dialogue: 0,0:20:00.78,0:20:02.36,Default,,0,0,0,,Пуах!
Dialogue: 0,0:20:03.53,0:20:06.99,Default,,0,0,0,,Мен бұл сәтсіздік жалауы деп ойладым, бірақ Рей де алдын ала сынақтан өтті!
Dialogue: 0,0:20:07.08,0:20:08.62,Default,,0,0,0,,Бұл керемет, Рей-чан!
Dialogue: 0,0:20:08.70,0:20:11.71,Default,,0,0,0,,(Көрермендер) Бұл Косей Арима ғой. (Көрермендер) Аизаның кішкентай қарындасымен бе?
Dialogue: 0,0:20:12.46,0:20:15.33,Default,,0,0,0,,Тачибана-кун Хазуки-кун Рюгасаки-кун
Dialogue: 0,0:20:15.42,0:20:16.84,Default,,0,0,0,,Барлығына керемет!
Dialogue: 0,0:20:16.92,0:20:20.59,Default,,0,0,0,,Олардың барлығы өз мамандықтары бойынша облыстық турнирге жолдама алды.
Dialogue: 0,0:20:20.67,0:20:22.97,Default,,0,0,0,,Бос уақыт түстен кейін басталады.
Dialogue: 0,0:20:23.05,0:20:26.47,Default,,0,0,0,,Егер бұл Хару-чан болса, сіз тырысып көрмей тұрып ұтқансыз!
Dialogue: 0,0:20:26.55,0:20:29.22,Default,,0,0,0,,Айтпақшы, Макото еркін жүзумен де айналысты.
Dialogue: 0,0:20:29.93,0:20:31.27,Default,,0,0,0,,- (Макото) Иә - (Нагиса) Оны асыға күтеміз!
Dialogue: 0,0:20:31.35,0:20:34.27,Default,,0,0,0,,Менің ағам мен Харука Сенпай арасындағы аздап төбелес.
Dialogue: 0,0:20:34.35,0:20:35.85,Default,,0,0,0,,Өтінемін, ұмытпаңыз~
Dialogue: 0,0:20:41.74,0:20:42.61,Default,,0,0,0,,Корпус
Dialogue: 0,0:20:46.41,0:20:47.53,Default,,0,0,0,,Кеше туралы...
Dialogue: 0,0:20:52.79,0:20:54.08,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:21:03.84,0:21:06.01,Default,,0,0,0,,Макото да бос бола ма?
Dialogue: 0,0:21:06.09,0:21:10.01,Default,,0,0,0,,
Dialogue: 0,0:21:11.31,0:21:12.81,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:14.69,0:21:16.48,Default,,0,0,0,,Айт!
Dialogue: 0,0:21:18.90,0:21:21.78,Default,,0,0,0,,Макото-сенпай Харука-сенпайдан асып түсті!?
Dialogue: 0,0:21:21.86,0:21:25.11,Default,,0,0,0,,Тачибана-кун, ол Нанасе-куннан жылдам болды ма?
Dialogue: 0,0:21:26.45,0:21:28.49,Default,,0,0,0,,Сен не істеп жатырсың, Макото?
Dialogue: 0,0:21:28.57,0:21:32.95,Default,,0,0,0,,100-ден айырмашылығы, 200-ге жылдамдықтың маңызды екенін білесіз бе?
Dialogue: 0,0:21:33.83,0:21:36.00,Default,,0,0,0,,Бірінші таймнан бұл өте ақымақ болып көрінді.
Dialogue: 0,0:21:36.08,0:21:37.79,Default,,0,0,0,,Соңына дейін ұстамаңыз
Dialogue: 0,0:21:41.63,0:21:44.09,Default,,0,0,0,,Эй Хару, сенен бір жақсылығым бар.
Dialogue: 0,0:21:47.47,0:21:49.39,Default,,0,0,0,,ертең 200 тегін матч
Dialogue: 0,0:21:49.47,0:21:52.14,Default,,0,0,0,,Менімен шындап жарысқаныңды қалаймын.
Dialogue: 0,0:21:54.77,0:21:55.85,Default,,0,0,0,,Неге...
Dialogue: 0,0:21:57.06,0:21:59.15,Default,,0,0,0,,Неліктен штаттан тыс жұмыс жасаймын деп айттыңыз?
Dialogue: 0,0:21:59.81,0:22:01.94,Default,,0,0,0,,Сіз шынымен менімен соншалықты жарысқыңыз келе ме?
Dialogue: 0,0:22:04.23,0:22:06.86,Default,,0,0,0,,Осы жазғы турнир аяқталды
Dialogue: 0,0:22:06.95,0:22:08.86,Default,,0,0,0,,Біз үш жылдан кейін зейнетке шығамыз, солай ма?
Dialogue: 0,0:22:09.61,0:22:11.24,Default,,0,0,0,,Сондықтан бұған дейін
Dialogue: 0,0:22:11.99,0:22:15.58,Default,,0,0,0,,Мен Харумен қатты ұрысқым келді.
Dialogue: 0,0:22:16.33,0:22:18.50,Default,,0,0,0,,Сіз не үшін жүзесіз?
Dialogue: 0,0:22:22.84,0:22:25.05,Default,,0,0,0,,Бұл Хал...
Dialogue: 0,0:22:26.67,0:22:28.26,Default,,0,0,0,,Достарыммен жүзу.
Dialogue: 0,0:22:29.18,0:22:30.01,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:22:31.60,0:22:33.76,Default,,0,0,0,,Ертең мен Харуды жеңу үшін жүземін.
Dialogue: 0,0:22:42.23,0:22:43.40,Default,,0,0,0,,Соңғы кезек!
Dialogue: 0,0:22:44.98,0:22:46.90,Default,,0,0,0,,Харука-сенпай жетті!
Dialogue: 0,0:22:46.99,0:22:50.24,Default,,0,0,0,,Бірақ бірте-бірте Мако-чанның жылдамдығы...
Dialogue: 0,0:22:50.32,0:22:51.32,Default,,0,0,0,,Құлау...
Dialogue: 0,0:23:12.01,0:23:12.97,Default,,0,0,0,,Пухат
Dialogue: 0,0:23:16.39,0:23:17.27,Default,,0,0,0,,Пухат
Dialogue: 0,0:23:17.35,0:23:22.48,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:23:22.56,0:23:27.61,Default,,0,0,0,,Хаха...
Dialogue: 0,0:23:28.49,0:23:29.32,Default,,0,0,0,,Макото...
Dialogue: 0,0:23:30.40,0:23:32.28,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:23:37.87,0:23:41.12,Default,,0,0,0,,Өйткені ол суда күшті.
Dialogue: 0,0:23:42.21,0:23:43.04,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:23:45.84,0:23:46.80,Default,,0,0,0,,Я...
Dialogue: 0,0:23:47.42,0:23:48.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:53.26,0:23:56.81,Default,,0,0,0,,Еркін 100 метрге жүгіру жарысы
Dialogue: 0,0:23:57.47,0:24:00.56,Default,,0,0,0,,Бұл Онии-чан мен Харука-сенпайдың матчы!
Dialogue: 0,0:24:00.64,0:24:05.31,Default,,0,0,0,,
Dialogue: 0,0:24:05.40,0:24:06.86,Default,,0,0,0,,Жарайды
Dialogue: 0,0:24:07.40,0:24:08.94,Default,,0,0,0,,Айт!
Dialogue: 0,0:24:13.28,0:24:15.95,Default,,0,0,0,,Бар, бар, бар, бар, алыс!
Dialogue: 0,0:24:16.03,0:24:19.20,Default,,0,0,0,,Бар, бар, бар, бар, алыс!
Dialogue: 0,0:24:19.70,0:24:22.37,Default,,0,0,0,,- (Минами) Ой, айт! Айт! - (Акула баспасы жүзу клубының мүшелері) Айт! Айт!
Dialogue: 0,0:24:22.46,0:24:24.25,Default,,0,0,0,,Жең, Рин
Dialogue: 0,0:24:29.50,0:24:32.76,Default,,0,0,0,,Бұл не? Бұл екі адамды бос ұстау ...
Dialogue: 0,0:24:32.84,0:24:34.22,Default,,0,0,0,,Ең үлкен жылдамдық...
Dialogue: 0,0:24:40.89,0:24:42.81,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:24:42.89,0:24:45.31,Default,,0,0,0,,Харука Сенпай жеңді...
Dialogue: 0,0:24:45.40,0:24:46.73,Default,,0,0,0,,Ағаңнан айырмашылығың
Dialogue: 0,0:24:46.81,0:24:49.23,Default,,0,0,0,,Бар болғаны 0,02 секунд!
Dialogue: 0,0:24:49.32,0:24:50.86,Default,,0,0,0,,Уау... керемет
Dialogue: 0,0:24:50.94,0:24:53.86,Default,,0,0,0,,Дегенмен, бұл тамаша матч болды.
Dialogue: 0,0:24:53.95,0:24:55.66,Default,,0,0,0,,Нанасе-кун күткендей!
Dialogue: 0,0:24:55.74,0:24:56.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:56.74,0:24:59.78,Default,,0,0,0,,Бірақ мен сәл күрделімін...
Dialogue: 0,0:24:59.87,0:25:01.62,Default,,0,0,0,,(Рей мен Амагатаның күлкісі)
Dialogue: 0,0:25:02.16,0:25:03.00,Default,,0,0,0,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:25:03.79,0:25:07.25,Default,,0,0,0,,Неліктен Мако-чан Хару-чанмен бірге жүзгісі келді?
Dialogue: 0,0:25:08.21,0:25:12.26,Default,,0,0,0,,Мен де Харумен ауыр ұрысқым келді.
Dialogue: 0,0:25:15.30,0:25:16.68,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:25:17.34,0:25:20.93,Default,,0,0,0,,Мүмкін мен Ринді қызғанған шығармын...
Dialogue: 0,0:25:25.69,0:25:26.77,Default,,0,0,0,,Мен...
Dialogue: 0,0:25:33.19,0:25:35.57,Default,,0,0,0,,Бүгінгі Хару керемет болды, солай емес пе?
Dialogue: 0,0:25:35.65,0:25:38.87,Default,,0,0,0,,Еліміздің түкпір-түкпірінен көптеген барлаушылар келетініне сенімдімін.
Dialogue: 0,0:25:44.20,0:25:48.21,Default,,0,0,0,,Хал барлау туралы естісе не істейді?
Dialogue: 0,0:25:52.67,0:25:54.13,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:25:54.21,0:25:55.72,Default,,0,0,0,,Сіз бас тартуды айтасыз ба?
Dialogue: 0,0:25:56.30,0:25:58.30,Default,,0,0,0,,Келсең де келмесең де бәрібір.
Dialogue: 0,0:26:01.22,0:26:03.14,Default,,0,0,0,,Мен жүземін, өйткені мен жүзгім келеді
Dialogue: 0,0:26:06.81,0:26:07.89,Default,,0,0,0,,Не?
Dialogue: 0,0:26:07.98,0:26:09.19,Default,,0,0,0,,Барабан ырғағымен бірге қозғалып, ол жыртқыш жануардың тырнақ іздерінің пішінін алды.
Dialogue: 0,0:26:09.27,0:26:10.90,Default,,0,0,0,,Қайырлы түн Хару
Dialogue: 0,0:26:19.91,0:26:22.24,Default,,0,0,0,,Кім жеңсе де, кек сақтама.
Dialogue: 0,0:26:22.33,0:26:25.62,Default,,0,0,0,,Дегенмен, сіз жергілікті турнирде жеңіске жетуіңіз керек.
Dialogue: 0,0:26:25.70,0:26:27.29,Default,,0,0,0,,Сізге айтудың қажеті жоқ
Dialogue: 0,0:26:27.37,0:26:28.33,Default,,0,0,0,,Хаха
Dialogue: 0,0:26:29.25,0:26:31.96,Default,,0,0,0,,Сізге кешегі тегін коньки берілді.
Dialogue: 0,0:26:32.04,0:26:33.88,Default,,0,0,0,,Бүгін емес.
Dialogue: 0,0:26:33.96,0:26:36.09,Default,,0,0,0,,Балалар жақсы.
Dialogue: 0,0:26:33.96,0:26:36.09,Default,,0,0,0,,(Ысқырық пен судың кіру дыбысы)
Dialogue: 0,0:26:36.09,0:26:38.59,Default,,0,0,0,,(Ысқырық пен судың кіру дыбысы)
Dialogue: 0,0:26:43.72,0:26:46.85,Default,,0,0,0,,Орналасқан жері туралы
Dialogue: 0,0:26:48.69,0:26:50.27,Default,,0,0,0,,Айт!
Dialogue: 0,0:26:51.06,0:26:52.15,Default,,0,0,0,,Реакция уақыты!
Dialogue: 0,0:26:52.81,0:26:55.48,Default,,0,0,0,,Жарайды, Тачибана-кун қайтып орала алады!
Dialogue: 0,0:26:55.57,0:26:56.65,Default,,0,0,0,,Жақсы, Момо!
Dialogue: 0,0:26:56.74,0:26:58.78,Default,,0,0,0,,Біз басқа мектептерден озып, алға шықтық!
Dialogue: 0,0:26:58.86,0:27:02.57,Default,,0,0,0,,- (Уозуми) Әй, айт! Айт! - (Shark print жүзу клубының мүшесі) Айт! Айт!
Dialogue: 0,0:27:05.24,0:27:07.50,Default,,0,0,0,,Макото жетіп келеді!
Dialogue: 0,0:27:11.00,0:27:12.63,Default,,0,0,0,,Бар, Нағиса!
Dialogue: 0,0:27:23.26,0:27:26.47,Default,,0,0,0,,Нағисаның ылғи екінші таймда созылып жүретін жүзуінен түк шықпайды!
Dialogue: 0,0:27:30.48,0:27:33.61,Default,,0,0,0,,Акула үлгісін жоғарғы жағында ұстап тұрып түртіңіз!
Dialogue: 0,0:27:35.11,0:27:36.90,Default,,0,0,0,,Рейкун қуып жетуге тырысады
Dialogue: 0,0:27:36.98,0:27:38.82,Default,,0,0,0,,Бірақ мен оған әлі жете алмаймын
Dialogue: 0,0:27:48.16,0:27:50.00,Default,,0,0,0,,Хару~!
Dialogue: 0,0:27:50.08,0:27:51.87,Default,,0,0,0,,Хару-чан!
Dialogue: 0,0:27:51.96,0:27:53.75,Default,,0,0,0,,Рин бірінші кезек алады!
Dialogue: 0,0:28:16.15,0:28:18.27,Default,,0,0,0,,Ой!
Dialogue: 0,0:28:19.11,0:28:20.78,Default,,0,0,0,,Жақсы, жақсы, акула баспасы!
Dialogue: 0,0:28:20.86,0:28:23.28,Default,,0,0,0,,- (Амаката) Мен жеңілдім... - (Сасабе) Иә...
Dialogue: 0,0:28:23.95,0:28:28.08,Default,,0,0,0,,Дегенмен, мен алдын ала турдан өтіп, жергілікті турнирге өтуді шештім!
Dialogue: 0,0:28:29.20,0:28:31.58,Default,,0,0,0,,- (Макото) Жақсы жұмыс - (Момотаро) Сен бірінші орындасың, сенпай!
Dialogue: 0,0:28:31.66,0:28:34.46,Default,,0,0,0,,- (Рин) О! -(Момотаро) Ия! Фу~!
Dialogue: 0,0:28:34.54,0:28:36.21,Default,,0,0,0,,(Рин мен Ивашимизу арасындағы күлкі)
Dialogue: 0,0:28:43.38,0:28:45.47,Default,,0,0,0,,Олар оны биыл дұрыс орындады.
Dialogue: 0,0:28:45.55,0:28:48.18,Default,,0,0,0,,Өткен жылы оны дзюдо үйірмесі пайдаланды.
Dialogue: 0,0:28:48.26,0:28:52.35,Default,,0,0,0,,Хмм... Бірақ бұл не? Мен өзімді сергек сезінбеймін.
Dialogue: 0,0:28:52.43,0:28:56.23,Default,,0,0,0,,Бұл мен Самегарадан жеңілгеннен бері шешілді!
Dialogue: 0,0:28:56.31,0:28:59.57,Default,,0,0,0,,Макото-сенпай мен Нағиса-күннің көңілі қалған жоқ па?!
Dialogue: 0,0:28:59.65,0:29:02.03,Default,,0,0,0,,Мен қатты ренжідім!
Dialogue: 0,0:29:03.15,0:29:07.78,Default,,0,0,0,,Облыстық турнирге шықсақ та, жеңіліп қалдық.
Dialogue: 0,0:29:07.87,0:29:09.41,Default,,0,0,0,,Эстафетамен акула басып шығару!
Dialogue: 0,0:29:12.87,0:29:14.75,Default,,0,0,0,,Жаттығу Кеттік
Dialogue: 0,0:29:14.83,0:29:15.67,Default,,0,0,0,,- (Нагиса/Макото) Иә! -(Рей) Иә.
Dialogue: 0,0:29:16.50,0:29:18.33,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,0:29:18.42,0:29:20.71,Default,,0,0,0,,Макото-сенпай, Рей-кун және Нагиса-кун да.
Dialogue: 0,0:29:20.80,0:29:24.34,Default,,0,0,0,,Біз әрбір жеке іс-шарада аймақтық турнирге шығуды шештік.
Dialogue: 0,0:29:24.42,0:29:25.97,Default,,0,0,0,,Бұл соңғы минут.
Dialogue: 0,0:29:26.89,0:29:29.26,Default,,0,0,0,,Жоғарғы жағында акула басып шығарылған ойыншылар.
Dialogue: 0,0:29:29.35,0:29:33.02,Default,,0,0,0,,Өйткені, тимьян акуланың баспасымен бәсекелесе алмайды...
Dialogue: 0,0:29:33.10,0:29:35.56,Default,,0,0,0,,Жоғары рейтингті сақтайтын жалғыз
Dialogue: 0,0:29:35.64,0:29:37.15,Default,,0,0,0,,Тек Харука Сенпай тегін
Dialogue: 0,0:29:37.23,0:29:41.44,Default,,0,0,0,,Иватоби әлі де Самегара сияқты жақсы емес.
Dialogue: 0,0:29:42.98,0:29:46.70,Default,,0,0,0,,Барлығы, бұл нәтижеге тоқмейілсуге болмайды.
Dialogue: 0,0:29:46.78,0:29:50.07,Default,,0,0,0,,- (Е) Қатты жаттығу... - (Амагата) Қатты! қиын!
Dialogue: 0,0:29:50.16,0:29:52.54,Default,,0,0,0,,Не болды? Ама-чан мұғалімі
Dialogue: 0,0:29:53.45,0:29:58.50,Default,,0,0,0,,Нанасе-кун барлау туралы хабарланды.
Dialogue: 0,0:29:58.58,0:29:59.63,Default,,0,0,0,,Не!
Dialogue: 0,0:30:00.92,0:30:04.80,Default,,0,0,0,,Ол кеше 100 тегін коньки тебу матчын көргенін айтты.
Dialogue: 0,0:30:04.88,0:30:07.18,Default,,0,0,0,,- (Харука) Шынымен бе? - (Нагиса) Хару-чан, сен істедің!
Dialogue: 0,0:30:07.84,0:30:10.55,Default,,0,0,0,,Енді сіз оқуды бітіргеннен кейін мансап жолыңызды көре аласыз, солай ма?
Dialogue: 0,0:30:10.64,0:30:15.35,Default,,0,0,0,,«Ертең жел соғады» деген атақты сөз бар.
Dialogue: 0,0:30:15.43,0:30:19.19,Default,,0,0,0,,«Дегенмен, желмен бірге жүру-болмауды өзіңіз шешесіз...»
Dialogue: 0,0:30:19.27,0:30:20.44,Default,,0,0,0,,(секіру дыбысы)
Dialogue: 0,0:30:20.52,0:30:21.81,Default,,0,0,0,,Корпус…
Dialogue: 0,0:30:27.82,0:30:30.57,Default,,0,0,0,,Харука-сенпай не істегісі келеді?
Dialogue: 0,0:30:30.66,0:30:32.20,Default,,0,0,0,,Айтпақшы, Хару-чан
Dialogue: 0,0:30:32.28,0:30:34.45,Default,,0,0,0,,Мансап сауалнамасы бланкісінде «Тегін» деп жазылған.
Dialogue: 0,0:30:34.54,0:30:37.12,Default,,0,0,0,,«Тегін»? бұл не
Dialogue: 0,0:30:37.21,0:30:39.54,Default,,0,0,0,,Сіз толық емес жұмыс уақытын айтып тұрғаныңызға сенімдісіз бе?
Dialogue: 0,0:30:39.62,0:30:42.34,Default,,0,0,0,,Хмм, мен олай ойламаймын.
Dialogue: 0,0:30:42.42,0:30:45.34,Default,,0,0,0,,Сонымен, сіз штаттан тыс жүзгішсіз бе?
Dialogue: 0,0:30:45.42,0:30:47.59,Default,,0,0,0,,Бұл да дұрыс емес деп ойлаймын...
Dialogue: 0,0:30:47.67,0:30:48.76,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:30:51.59,0:30:53.10,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:30:53.93,0:30:56.52,Default,,0,0,0,,Хару-чан үшін тегін тегін.
Dialogue: 0,0:30:58.18,0:30:59.94,Default,,0,0,0,,Ол Киригумо-суги деп аталатын өте жеңіл ағаш түрінен жасалған
Dialogue: 0,0:31:00.44,0:31:04.69,Default,,0,0,0,,Ха... Бірақ ол өте үлкен кісі сияқты.
Dialogue: 0,0:31:06.99,0:31:09.36,Default,,0,0,0,,Бүгін де бір сауал алдым.
Dialogue: 0,0:31:09.45,0:31:11.70,Default,,0,0,0,,Нанасе-кун бұрынғысынша...
Dialogue: 0,0:31:11.78,0:31:15.12,Default,,0,0,0,,Ағаң да көп келетін сияқты.
Dialogue: 0,0:31:15.20,0:31:18.00,Default,,0,0,0,,Міне, сондықтан Харука-сенпай жақсы болады!
Dialogue: 0,0:31:18.08,0:31:20.87,Default,,0,0,0,,Мен ақыр соңында міндетті түрде мотивация аламын
Dialogue: 0,0:31:21.62,0:31:23.42,Default,,0,0,0,,Менің ойымша, бұл Харудың қалайтыны ма...
Dialogue: 0,0:31:23.50,0:31:24.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:24.42,0:31:25.46,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:31:26.05,0:31:29.80,Default,,0,0,0,,Ойланып қарашы, Макото-сенпай, сен әлі мансап жолыңды шештің бе?
Dialogue: 0,0:31:30.84,0:31:35.56,Default,,0,0,0,,Мен әлі шешкен жоқпын, бірақ бұл жергілікті университет деп ойлаймын.
Dialogue: 0,0:31:35.64,0:31:37.22,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:31:37.31,0:31:39.43,Default,,0,0,0,,(Мизуон)
Dialogue: 0,0:31:40.89,0:31:43.31,Default,,0,0,0,,(батпырауық хорват)
Dialogue: 0,0:31:43.40,0:31:46.27,Default,,0,0,0,,(Дұға дыбысы)
Dialogue: 0,0:31:46.36,0:31:48.48,Default,,0,0,0,,Уау! Мако-чан Дайкичи!
Dialogue: 0,0:31:48.57,0:31:51.61,Default,,0,0,0,,«Күткен адам келеді, ойын жеңеді».
Dialogue: 0,0:31:51.70,0:31:56.33,Default,,0,0,0,,«Шығу, жақсы, бағыт солтүстік пен шығыс».
Dialogue: 0,0:31:59.91,0:32:03.12,Default,,0,0,0,,Кім не десе де, мен бәрібір.
Dialogue: 0,0:32:03.21,0:32:05.79,Default,,0,0,0,,Маған Харука Сенпайдың жүзуі ұнайды.
Dialogue: 0,0:32:05.88,0:32:09.63,Default,,0,0,0,,Бұл теория немесе есептеу туралы емес, бұл күшті нәрсені сезіну туралы.
Dialogue: 0,0:32:09.71,0:32:12.84,Default,,0,0,0,,Мен де осылай жүзе алғым келді.
Dialogue: 0,0:32:13.38,0:32:14.80,Default,,0,0,0,,еркін
Dialogue: 0,0:32:15.51,0:32:16.35,Default,,0,0,0,,...
Dialogue: 0,0:32:16.43,0:32:20.60,Default,,0,0,0,,Сондықтан менің ойымша, Харука-сенпай бостандықта қалуы керек.
Dialogue: 0,0:32:21.10,0:32:22.98,Default,,0,0,0,,Еркіннің әртүрлі мағыналары бар.
Dialogue: 0,0:32:23.06,0:32:27.36,Default,,0,0,0,,Бірақ шынайы еркіндік ештеңемен шектелмейді.
Dialogue: 0,0:32:27.44,0:32:30.23,Default,,0,0,0,,Менің ойымша, бұл еркін ақыл туралы.
Dialogue: 0,0:32:30.32,0:32:33.36,Default,,0,0,0,,Сондықтан қандай таңдау жасасаңыз да
Dialogue: 0,0:32:33.45,0:32:38.37,Default,,0,0,0,,Харука Сенпай Харука Сенпай болғанша, ол бос.
Dialogue: 0,0:32:38.45,0:32:40.62,Default,,0,0,0,,(батпырауық хорват)
Dialogue: 0,0:32:42.25,0:32:45.83,Default,,0,0,0,,Кешіріңіз! Керемет нәрсе...
Dialogue: 0,0:32:58.01,0:32:59.81,Default,,0,0,0,,Бұл мәзірді Хару-чан жасады ма?
Dialogue: 0,0:33:00.43,0:33:02.64,Default,,0,0,0,,Go мәзіріне кейбір өзгерістер енгізілді.
Dialogue: 0,0:33:03.52,0:33:06.06,Default,,0,0,0,,Эстафетаны тапсыру тәжірибесін қостыңыз ба?
Dialogue: 0,0:33:06.15,0:33:07.81,Default,,0,0,0,,Жылдамдықты жоғалту
Dialogue: 0,0:33:07.90,0:33:10.90,Default,,0,0,0,,Тапсырыс беру уақытын азайту арқылы
Dialogue: 0,0:33:10.98,0:33:12.78,Default,,0,0,0,,Сондықтан сіз оны жабуға тырысып жатырсыз.
Dialogue: 0,0:33:12.86,0:33:13.70,Default,,0,0,0,,Иә.
Dialogue: 0,0:33:13.78,0:33:15.91,Default,,0,0,0,,Егер бұл төртеуміздің бірлескен жұмысымыз болса
Dialogue: 0,0:33:15.99,0:33:19.03,Default,,0,0,0,,Сіз қазіргі акула үлгісінен көбірек уақыт ұта аласыз!
Dialogue: 0,0:33:21.54,0:33:24.16,Default,,0,0,0,,Балалар мен сендермен бірге жүзгім келеді
Dialogue: 0,0:33:24.75,0:33:27.13,Default,,0,0,0,,Дәл қазір мен сол сезімді бағалағым келеді.
Dialogue: 0,0:33:27.92,0:33:29.29,Default,,0,0,0,,Харука-сенпай...!
Dialogue: 0,0:33:30.00,0:33:32.05,Default,,0,0,0,,Кеттік, мына төртеуі!
Dialogue: 0,0:33:32.13,0:33:34.88,Default,,0,0,0,,Бұл жолы біз Shark Pattern-ді жеңіп, бүкіл елге шығамыз!
Dialogue: 0,0:33:34.97,0:33:36.26,Default,,0,0,0,,О
Dialogue: 0,0:33:42.10,0:33:44.35,Default,,0,0,0,,-Қайырлы кеш~ - (Макото) Қайырлы кеш
Dialogue: 0,0:33:49.36,0:33:50.44,Default,,0,0,0,,Жаттықтырушы Сасабе!
Dialogue: 0,0:33:50.52,0:33:52.94,Default,,0,0,0,,О, бұл Макото!
Dialogue: 0,0:33:53.03,0:33:55.95,Default,,0,0,0,,Жүзу үйірмесі қызып барады.
Dialogue: 0,0:33:56.03,0:34:00.66,Default,,0,0,0,,Аа, әрине бақыттымын, бірақ жұмыс күшінің жетіспеуіне байланысты мен өте бос емеспін.
Dialogue: 0,0:34:00.74,0:34:03.58,Default,,0,0,0,,Өкініштісі, мен сіздердің жаттығуларыңызды көре алмадым.
Dialogue: 0,0:34:03.66,0:34:07.17,Default,,0,0,0,,Жоқ, жаттықтырушы Сасабе
Dialogue: 0,0:34:07.25,0:34:09.79,Default,,0,0,0,,Бұл жақында өткен префектуралық турнирдегі матч рекорды...
Dialogue: 0,0:34:09.88,0:34:12.46,Default,,0,0,0,,Жаттықтырушы Сасабе! Асығыңыз~
Dialogue: 0,0:34:12.55,0:34:16.47,Default,,0,0,0,,А, күте тұрыңыз, мен қазір барамын!
Dialogue: 0,0:34:16.55,0:34:18.47,Default,,0,0,0,,- (Макото) Сасабе жаттықтырушы! - (Сасабе) Әй?
Dialogue: 0,0:34:18.55,0:34:21.64,Default,,0,0,0,,- (Макото) Саған бірдеңе көмектессем бола ма? -(Сасабе) Шынымен!?
Dialogue: 0,0:34:21.72,0:34:24.64,Default,,0,0,0,,Иә, егер бұл мен болсам.
Dialogue: 0,0:34:25.85,0:34:29.06,Default,,0,0,0,,Не? Мако-чан кешеден бері Горо-чанның үйінде.
Dialogue: 0,0:34:29.15,0:34:30.65,Default,,0,0,0,,Сіз көмектесе бастадыңыз ба?
Dialogue: 0,0:34:30.73,0:34:34.23,Default,,0,0,0,,Сасабе жаттықтырушысы маған көп көмектесті.
Dialogue: 0,0:34:34.32,0:34:36.11,Default,,0,0,0,,Мен бірдеңені қайтарсам деп едім
Dialogue: 0,0:34:36.19,0:34:40.16,Default,,0,0,0,,Бірақ мен оны жалғыз Мако-чанға жібере алмаймын!
Dialogue: 0,0:34:40.24,0:34:44.66,Default,,0,0,0,,Біз де жасаймыз! Эй, Рей Чан да солай ойлайды, солай ма?
Dialogue: 0,0:34:44.74,0:34:45.87,Default,,0,0,0,,Әрине!
Dialogue: 0,0:34:45.95,0:34:47.87,Default,,0,0,0,,(Бүкіл Құдірет-тың ауыр демі)
Dialogue: 0,0:34:47.96,0:34:51.88,Default,,0,0,0,,Бірақ Нагиса мен Рейдің де істейтін істері бар, солай ма?
Dialogue: 0,0:34:52.42,0:34:53.59,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:34:54.59,0:34:57.09,Default,,0,0,0,,Сіз де Харука-сенпайға алаңдамайсыз ба?
Dialogue: 0,0:34:57.92,0:34:59.68,Default,,0,0,0,,Мен тек жүзумен айналысамын
Dialogue: 0,0:34:59.76,0:35:02.09,Default,,0,0,0,,Макото не шешсе, соны істеу керек.
Dialogue: 0,0:35:02.18,0:35:04.51,Default,,0,0,0,,- (Нагиса) Хару-чан... - (Рей) Харука-сенпай...
Dialogue: 0,0:35:04.60,0:35:05.60,Default,,0,0,0,,Иә
Dialogue: 0,0:35:06.60,0:35:08.56,Default,,0,0,0,,Бірақ менің ең үлкен күнәм —
Dialogue: 0,0:35:08.64,0:35:10.10,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:35:10.19,0:35:13.44,Default,,0,0,0,,Жаттықтырушы Тачибана, бүгін не істеп жатырсыз?
Dialogue: 0,0:35:13.52,0:35:16.61,Default,,0,0,0,,Бүгін флаттер жаттығуынан бастайық па?
Dialogue: 0,0:35:16.69,0:35:18.11,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:35:20.24,0:35:22.87,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:35:23.53,0:35:25.74,Default,,0,0,0,,- (А бала) Қош бол жаттықтырушы Тачибана! -(Б бала) Жақында кездескенше!
Dialogue: 0,0:35:26.70,0:35:28.00,Default,,0,0,0,,Қош бол~
Dialogue: 0,0:35:28.08,0:35:29.91,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:35:34.09,0:35:35.17,Default,,0,0,0,,Соуто-кун
Dialogue: 0,0:35:35.92,0:35:36.92,Default,,0,0,0,,Не болды?
Dialogue: 0,0:35:37.55,0:35:39.63,Default,,0,0,0,,Бүгін көңілді болмадыңыз ба?
Dialogue: 0,0:35:41.88,0:35:44.35,Default,,0,0,0,,Мен жүзуді жек көремін
Dialogue: 0,0:35:45.76,0:35:46.76,Default,,0,0,0,,Хаято!
Dialogue: 0,0:35:46.85,0:35:49.89,Default,,0,0,0,,- (Саято) А, Такасуми-чан! -(Такасуми) Кешіріңіз кешігіп қалдым.
Dialogue: 0,0:35:49.98,0:35:52.10,Default,,0,0,0,,- (Макото) "Такасуми"... - (Такасуми) Иә?
Dialogue: 0,0:35:53.15,0:35:55.15,Default,,0,0,0,,Такасуми Шигино?
Dialogue: 0,0:35:55.90,0:35:58.86,Default,,0,0,0,,- (Такасуми) Мүмкін Макото шығар!? - (Макото) Иә!
Dialogue: 0,0:35:59.61,0:36:01.11,Default,,0,0,0,,Біраз уақыт болды, Такасуми.
Dialogue: 0,0:36:01.82,0:36:03.95,Default,,0,0,0,,Иә, біраз уақыт өтті.
Dialogue: 0,0:36:04.45,0:36:06.95,Default,,0,0,0,,Орта мектептен бері болды ма?
Dialogue: 0,0:36:08.41,0:36:10.96,Default,,0,0,0,,Мен Хаято-кунның жүзуді жек көретінін естідім.
Dialogue: 0,0:36:11.04,0:36:12.96,Default,,0,0,0,,Себебі бар ма?
Dialogue: 0,0:36:13.96,0:36:16.21,Default,,0,0,0,,Білсеңіз, маған хабарлаңыз.
Dialogue: 0,0:36:17.25,0:36:19.96,Default,,0,0,0,,Мүмкін бұл менің кінәм шығар
Dialogue: 0,0:36:20.05,0:36:21.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:21.67,0:36:26.60,Default,,0,0,0,,Біраз уақыт бұрын мен отбасымызбен жағажайға барып, қайықпен серуендедік.
Dialogue: 0,0:36:26.68,0:36:29.43,Default,,0,0,0,,Хаято толқып, тепе-теңдігін жоғалтты.
Dialogue: 0,0:36:29.52,0:36:31.06,Default,,0,0,0,,Мен қайықтан құладым.
Dialogue: 0,0:36:32.31,0:36:35.65,Default,,0,0,0,,Мен оған бірден көмектестім, сондықтан маңызды ештеңе болған жоқ.
Dialogue: 0,0:36:35.73,0:36:39.15,Default,,0,0,0,,Бірақ бұл шынымен қорқынышты болды деп ойлаймын.
Dialogue: 0,0:36:40.40,0:36:41.94,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:36:42.03,0:36:45.28,Default,,0,0,0,,Себебі мен мектепте жүзу сабағын ұнатпай бастадым.
Dialogue: 0,0:36:45.36,0:36:49.54,Default,,0,0,0,,Жүзу сабағында мен Хаятоның қарқынымен жүзе алғанша
Dialogue: 0,0:36:49.62,0:36:51.33,Default,,0,0,0,,Мен саған қамқор болғым келеді.
Dialogue: 0,0:36:51.87,0:36:53.62,Default,,0,0,0,,- (Макото) Такасуми... - (Такасуми) Бірақ
Dialogue: 0,0:36:53.71,0:36:56.50,Default,,0,0,0,,- (Такасуми) Хаято қиналып жатса... - (Макото) Мен...
Dialogue: 0,0:36:57.67,0:37:00.25,Default,,0,0,0,,Мен Хаятоға жүзуді үйренуге көмектескім келеді.
Dialogue: 0,0:37:00.34,0:37:02.01,Default,,0,0,0,,Макото?
Dialogue: 0,0:37:02.63,0:37:04.43,Default,,0,0,0,,Әйтеуір, Хаято-кун
Dialogue: 0,0:37:04.51,0:37:07.05,Default,,0,0,0,,Мен өзімді бұрынғы келбетіме ұқсайтындай сезінемін.
Dialogue: 0,0:37:07.85,0:37:11.68,Default,,0,0,0,,Сондықтан мен сенің бас тартқаныңды қаламаймын.
Dialogue: 0,0:37:11.77,0:37:14.14,Default,,0,0,0,,Такасуми мен Сатору-кунға
Dialogue: 0,0:37:17.52,0:37:20.27,Default,,0,0,0,,Макото жүзгенді жақсы көреді, солай ма?
Dialogue: 0,0:37:20.36,0:37:21.53,Default,,0,0,0,,Иә
Dialogue: 0,0:37:22.86,0:37:26.53,Default,,0,0,0,,Макото, Хаятоға қамқор болшы.
Dialogue: 0,0:37:26.61,0:37:29.78,Default,,0,0,0,,Егер менің қолымнан келетін нәрсе болса, маған хабарлаңыз
Dialogue: 0,0:37:29.87,0:37:31.79,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:37:31.87,0:37:32.87,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:37:32.95,0:37:35.96,Default,,0,0,0,,- (Макото) А, Хару - (Такасуми) А? Хару!?
Dialogue: 0,0:37:36.04,0:37:37.46,Default,,0,0,0,,Әй, біраз уақыт болды!
Dialogue: 0,0:37:37.54,0:37:41.34,Default,,0,0,0,,Ой, бұл маған орта мектепті еске түсіреді!
Dialogue: 0,0:37:41.42,0:37:43.88,Default,,0,0,0,,Бұл уақыт Рин шетелде оқығаннан кейін болатын.
Dialogue: 0,0:37:43.97,0:37:46.22,Default,,0,0,0,,Хару, сен өте жалғыз көріндің, солай ма?
Dialogue: 0,0:37:46.30,0:37:48.22,Default,,0,0,0,,Хехехе
Dialogue: 0,0:37:48.30,0:37:51.18,Default,,0,0,0,,Такасуми Ринмен бірдей бастауыш мектепте оқымады ма?
Dialogue: 0,0:37:51.26,0:37:53.93,Default,,0,0,0,,Иә, Соуске де.
Dialogue: 0,0:37:54.02,0:37:57.35,Default,,0,0,0,,- (Харука) Макото - (Макото) Аа, осыншама ұзақ па?
Dialogue: 0,0:37:57.44,0:38:00.56,Default,,0,0,0,,- (Харука) Мен үйге бара жатырмын - (Такасуми) Мен сені алып кете алмаймын, Хару.
Dialogue: 0,0:38:00.65,0:38:05.24,Default,,0,0,0,,- (Такасуми) Біз тағы кездескенімізге біраз болды - (Харука) Ха, мен сені тағы көремін.
Dialogue: 0,0:38:06.36,0:38:07.61,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:38:07.70,0:38:10.03,Default,,0,0,0,,- (Саято) Такасуми-чан! -(Такасуми) Хаято!
Dialogue: 0,0:38:10.12,0:38:13.41,Default,,0,0,0,,Макото мен Хару да кездескенше!
Dialogue: 0,0:38:14.50,0:38:15.54,Default,,0,0,0,,Я...
Dialogue: 0,0:38:15.62,0:38:18.29,Default,,0,0,0,,Хехе, тезірек үйге қайтайық.
Dialogue: 0,0:38:21.63,0:38:25.55,Default,,0,0,0,,Бірақ Хаято-кун қатты қорықты.
Dialogue: 0,0:38:25.63,0:38:28.30,Default,,0,0,0,,Оқытуды неден бастасам екен деп ойлап жүрмін.
Dialogue: 0,0:38:29.14,0:38:30.97,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:38:31.51,0:38:34.31,Default,,0,0,0,,Ойланып қарасаңыз, түсінесіз, солай ма?
Dialogue: 0,0:38:36.10,0:38:37.39,Default,,0,0,0,,Бетіңдегі бұл не?
Dialogue: 0,0:38:38.64,0:38:42.06,Default,,0,0,0,,Себебі мен арқамен жүзу кезінде аспанды көретінмін
Dialogue: 0,0:38:43.15,0:38:44.78,Default,,0,0,0,,Мен енді қорықпаймын
Dialogue: 0,0:38:46.15,0:38:49.49,Default,,0,0,0,,Бірақ кенет шалқасынан үйрету
Dialogue: 0,0:38:49.57,0:38:51.95,Default,,0,0,0,,Бұл әдеттегі тәжірибе емес...
Dialogue: 0,0:38:52.03,0:38:53.95,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:38:54.04,0:38:55.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:55.41,0:38:57.46,Default,,0,0,0,,Өз қалауыңыз бойынша жасаңыз
Dialogue: 0,0:38:57.54,0:38:59.00,Default,,0,0,0,,Корпус…
Dialogue: 0,0:39:02.25,0:39:05.84,Default,,0,0,0,,Иә, мен жасап көремін.
Dialogue: 0,0:39:11.80,0:39:15.81,Default,,0,0,0,,Хаято-кун, бүгін басқаша жүзіп көргің келе ме?
Dialogue: 0,0:39:15.89,0:39:16.93,Default,,0,0,0,,Е...
Dialogue: 0,0:39:17.02,0:39:21.35,Default,,0,0,0,,Суға түсудің қажеті жоқ; аспанға қарап жүзудің жолы бар.
Dialogue: 0,0:39:22.02,0:39:24.57,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:39:25.19,0:39:28.57,Default,,0,0,0,,Уайымдама, мен сені дұрыс қолдаймын.
Dialogue: 0,0:39:28.65,0:39:30.70,Default,,0,0,0,,Мен ешқашан суға батпаймын
Dialogue: 0,0:39:30.78,0:39:33.57,Default,,0,0,0,,Бұл мүмкін емес, өйткені...
Dialogue: 0,0:39:34.12,0:39:37.24,Default,,0,0,0,,Өйткені... бұл қорқынышты.
Dialogue: 0,0:39:37.33,0:39:38.54,Default,,0,0,0,,Жарайды
Dialogue: 0,0:39:38.62,0:39:42.04,Default,,0,0,0,,Мен Хаятоның қолын ешқашан жібермеймін.
Dialogue: 0,0:39:44.88,0:39:47.05,Default,,0,0,0,,Мүлдем қорқынышты емес пе?
Dialogue: 0,0:39:47.13,0:39:49.05,Default,,0,0,0,,Иә, мен уәде беремін.
Dialogue: 0,0:39:52.38,0:39:55.05,Default,,0,0,0,,- (А бала) Суто! -(Д бала) Сәттілік!
Dialogue: 0,0:39:55.14,0:39:59.77,Default,,0,0,0,,Жүр, суды теуіп, ақырын алға жылжайық.
Dialogue: 0,0:40:01.10,0:40:03.73,Default,,0,0,0,,Хаято, көзіңді аш.
Dialogue: 0,0:40:10.03,0:40:11.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:40:17.08,0:40:18.29,Default,,0,0,0,,Хехехе
Dialogue: 0,0:40:19.12,0:40:20.04,Default,,0,0,0,,Пуха!
Dialogue: 0,0:40:20.12,0:40:23.83,Default,,0,0,0,,- (Д бала) Керемет! Арқамен жүзу! -(Б бала) Хаято
Dialogue: 0,0:40:26.13,0:40:27.38,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:40:28.84,0:40:31.34,Default,,0,0,0,,Хаято!
Dialogue: 0,0:40:31.42,0:40:33.34,Default,,0,0,0,,Хаято!
Dialogue: 0,0:40:35.26,0:40:36.30,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:40:36.39,0:40:38.81,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:40:44.90,0:40:46.48,Default,,0,0,0,,Хаято?
Dialogue: 0,0:40:46.56,0:40:50.36,Default,,0,0,0,,Білесің бе, мен жүземін...
Dialogue: 0,0:40:51.44,0:40:54.70,Default,,0,0,0,,Мен енді қорықпаймын Көңілді болды!
Dialogue: 0,0:40:57.41,0:41:00.33,Default,,0,0,0,,Иә, Хаято көп жұмыс істегендіктен.
Dialogue: 0,0:41:02.66,0:41:05.33,Default,,0,0,0,,Жаттықтырушы Тачибанаға рахмет
Dialogue: 0,0:41:06.71,0:41:07.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:41:10.80,0:41:14.13,Default,,0,0,0,,-(Макото) Еңбегіңізге рахмет -Еңбегіңізге рахмет~
Dialogue: 0,0:41:14.88,0:41:16.47,Default,,0,0,0,,О ~ Макото
Dialogue: 0,0:41:16.55,0:41:20.47,Default,,0,0,0,,Мен жаңа ғана толық емес жұмысқа орналастым, сондықтан бәрі жақсы.
Dialogue: 0,0:41:20.56,0:41:21.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:21.56,0:41:24.60,Default,,0,0,0,,Сіз маған келесі аптада соңғы рет көмектесе аласыз.
Dialogue: 0,0:41:24.69,0:41:26.85,Default,,0,0,0,,Не, бақытты емессің бе?
Dialogue: 0,0:41:29.15,0:41:30.11,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:41:30.19,0:41:32.78,Default,,0,0,0,,Олай болса, үйге бара жатқанда абай бол.
Dialogue: 0,0:41:32.86,0:41:33.78,Default,,0,0,0,,Иә
Dialogue: 0,0:41:43.12,0:41:46.12,Default,,0,0,0,,Балалар, әлі жаттығу жасайсыңдар ма?
Dialogue: 0,0:41:46.21,0:41:48.21,Default,,0,0,0,,- (Макото) Ама-чан Сенсэй - (Амагата) да~
Dialogue: 0,0:41:48.29,0:41:52.17,Default,,0,0,0,,Егер мектептен кейін мектептен шықсаңыз, өмір салтын ұстанатын мұғалім сізге ұрысады.
Dialogue: 0,0:41:52.25,0:41:54.42,Default,,0,0,0,,Жергілікті турнир келесі аптада.
Dialogue: 0,0:41:54.51,0:41:56.88,Default,,0,0,0,,Сондықтан мен мұны соңғы минутқа дейін орындағым келді.
Dialogue: 0,0:41:56.97,0:42:00.18,Default,,0,0,0,,Неғұрлым көп тапсыруға машықтансаңыз, соғұрлым нәтиже аласыз.
Dialogue: 0,0:42:00.26,0:42:02.68,Default,,0,0,0,,-(Харука) Тағы бір рет өтінемін -(Рей) Иә.
Dialogue: 0,0:42:02.77,0:42:05.35,Default,,0,0,0,,- (Амагата) Беру тәжірибесі? -(Макото) Дұрыс.
Dialogue: 0,0:42:05.43,0:42:06.56,Default,,0,0,0,,Біз күшті мектептермен бәсекеге түсе аламыз ба?
Dialogue: 0,0:42:06.56,0:42:08.35,Default,,0,0,0,,Біз күшті мектептермен бәсекеге түсе аламыз ба?
Dialogue: 0,0:42:06.56,0:42:08.35,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:42:08.44,0:42:10.02,Default,,0,0,0,,Осы тапсыру арқылы
Dialogue: 0,0:42:10.11,0:42:12.65,Default,,0,0,0,,Барлығы қанша уақытты қысқарта алатыныңызға байланысты.
Dialogue: 0,0:42:14.99,0:42:18.11,Default,,0,0,0,,Жүзуші сізге қол тигізетін сәтті болжаңыз.
Dialogue: 0,0:42:18.20,0:42:21.41,Default,,0,0,0,,Қарсылас жанасу қозғалысына енгенде, денені бүгуді жалғастырыңыз
Dialogue: 0,0:42:22.08,0:42:23.79,Default,,0,0,0,,Бастапқы блокты түрткенде бір уақытта соғыңыз
Dialogue: 0,0:42:24.95,0:42:27.12,Default,,0,0,0,,Қабылдау үшін идеалды уақыт айырмашылығы 0 секунд
Dialogue: 0,0:42:27.21,0:42:29.79,Default,,0,0,0,,Бірақ мен соңғы минутта секіріп кеттім.
Dialogue: 0,0:42:29.88,0:42:31.59,Default,,0,0,0,,Егер мен ұшып кетсем...
Dialogue: 0,0:42:31.67,0:42:33.13,Default,,0,0,0,,Иә, сіз дисквалификациясыз.
Dialogue: 0,0:42:33.75,0:42:36.26,Default,,0,0,0,,Бірақ ұшудан қорықпа.
Dialogue: 0,0:42:36.34,0:42:38.13,Default,,0,0,0,,Егер сіз осы уақытты меңгерсеңіз
Dialogue: 0,0:42:38.22,0:42:41.35,Default,,0,0,0,,Біз уақытымызды одан да қысқарта аламыз.
Dialogue: 0,0:42:42.14,0:42:44.39,Default,,0,0,0,,Хо~ Осы уақытқа дейін...
Dialogue: 0,0:42:44.47,0:42:48.14,Default,,0,0,0,,- (Макото) Әй, өмірлік бағдар... - (Амаката) Тіпті директор да!
Dialogue: 0,0:42:48.23,0:42:52.19,Default,,0,0,0,,Кешіріңіз! Мен үйге қайтайын деп едім...
Dialogue: 0,0:42:52.27,0:42:54.78,Default,,0,0,0,,Жоқ, жоқ, бәрі жақсы.
Dialogue: 0,0:42:54.86,0:42:56.94,Default,,0,0,0,,Одан да Нанасе-кун
Dialogue: 0,0:42:57.03,0:42:59.91,Default,,0,0,0,,Сізге барлау туралы сұрау түскенін естідім.
Dialogue: 0,0:42:59.99,0:43:03.41,Default,,0,0,0,,Сіз керемет емессіз бе? Сіз мектебіміздің мақтанышысыз.
Dialogue: 0,0:43:04.12,0:43:06.41,Default,,0,0,0,,Барлығы жергілікті турнирге назар аударады.
Dialogue: 0,0:43:06.50,0:43:08.29,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:43:10.83,0:43:11.83,Default,,0,0,0,,Иә
Dialogue: 0,0:43:13.71,0:43:15.59,Default,,0,0,0,,Бұл үлкен қонақүй!
Dialogue: 0,0:43:15.67,0:43:18.09,Default,,0,0,0,,Дәреженің өткен жылғыдан айырмашылығы анық.
Dialogue: 0,0:43:18.17,0:43:21.14,Default,,0,0,0,,Мен мұнда тек Ечан мен мұғалім қалады деп ойламадым.
Dialogue: 0,0:43:21.22,0:43:23.05,Default,,0,0,0,,Біз шатырмыз...
Dialogue: 0,0:43:23.14,0:43:26.10,Default,,0,0,0,,Өткен жылғы оқу-жаттығу жиынындағыдай үлгі ме?
Dialogue: 0,0:43:26.18,0:43:28.98,Default,,0,0,0,,- (E) Сіз не туралы айтып тұрсыз? - (Амагата) Дұрыс.
Dialogue: 0,0:43:29.06,0:43:31.90,Default,,0,0,0,,Басты кейіпкерлер сізсіз ғой.
Dialogue: 0,0:43:31.98,0:43:33.98,Default,,0,0,0,,Әйтсе де, осындай атақты сөз бар.
Dialogue: 0,0:43:34.06,0:43:36.28,Default,,0,0,0,,«Тегіннен қымбат ештеңе жоқ»
Dialogue: 0,0:43:36.36,0:43:38.36,Default,,0,0,0,,«Алайда, баға баға жетпес»
Dialogue: 0,0:43:39.49,0:43:43.41,Default,,0,0,0,,Амаката мырза маған көптеген әскери қаражатты сеніп тапсырды.
Dialogue: 0,0:43:43.49,0:43:45.37,Default,,0,0,0,,Қалағаныңды же.
Dialogue: 0,0:43:45.45,0:43:48.29,Default,,0,0,0,,- (Нағиса) Саған не ұнайды? - (Харука) Бұл жақсы
Dialogue: 0,0:43:48.37,0:43:51.42,Default,,0,0,0,,-(Нагиса) Ах~ Өте сүйкімді~ -(Рей) Масаба...
Dialogue: 0,0:43:51.50,0:43:53.63,Default,,0,0,0,,- (Макото) Хару - (Микошиба) Хахахаха
Dialogue: 0,0:43:53.71,0:43:54.59,Default,,0,0,0,,Бұл менің халқым да естігенін қалаймын.
Dialogue: 0,0:43:54.59,0:43:56.55,Default,,0,0,0,,Бұл менің халқым да естігенін қалаймын.
Dialogue: 0,0:43:54.59,0:43:56.55,Default,,0,0,0,,- (E) Директор Микошиба? -(Рей) сен мұнда неге...
Dialogue: 0,0:43:56.55,0:43:56.63,Default,,0,0,0,,- (E) Директор Микошиба? -(Рей) сен мұнда неге...
Dialogue: 0,0:43:56.63,0:43:58.01,Default,,0,0,0,,- (E) Директор Микошиба? -(Рей) сен мұнда неге...
Dialogue: 0,0:43:56.63,0:43:58.01,Default,,0,0,0,,- (Todo), солай ма? -(Микошиба) А?
Dialogue: 0,0:43:58.09,0:44:02.01,Default,,0,0,0,,О! Қой-кун! Нанасе-кун және т.б
Dialogue: 0,0:44:02.09,0:44:04.89,Default,,0,0,0,,- (Нагиса/Рей/Е) Қайырлы кеш~ - (Макото) Ал сіз ше?
Dialogue: 0,0:44:05.64,0:44:09.02,Default,,0,0,0,,Бұл менің университетімде барлау жұмыстарын басқаратын Тодо мырза.
Dialogue: 0,0:44:09.10,0:44:10.73,Default,,0,0,0,,Скаут…
Dialogue: 0,0:44:10.81,0:44:12.69,Default,,0,0,0,,Түлектер ретінде акула үлгісіндегі ойыншылар
Dialogue: 0,0:44:12.77,0:44:14.90,Default,,0,0,0,,Мен сені таныстырғым келді.
Dialogue: 0,0:44:14.98,0:44:17.36,Default,,0,0,0,,«Нанасе-кун» Иватоби орта мектебінен бе?
Dialogue: 0,0:44:17.44,0:44:18.28,Default,,0,0,0,,Иә
Dialogue: 0,0:44:18.36,0:44:20.82,Default,,0,0,0,,Сіз Харука-сенпайды білесіз бе?
Dialogue: 0,0:44:20.90,0:44:25.53,Default,,0,0,0,,Әрине, мен білемін. О, сен Нанасе-кунсың.
Dialogue: 0,0:44:25.62,0:44:27.53,Default,,0,0,0,,Штаттан тыс қызметкер Харука Нанасе
Dialogue: 0,0:44:28.16,0:44:32.41,Default,,0,0,0,,Префектуралық турнирде мұндай жүзуді ешкім ұмыта алмайды.
Dialogue: 0,0:44:32.50,0:44:36.46,Default,,0,0,0,,Біздің университет қана емес, басқа университеттер де назар аударуда.
Dialogue: 0,0:44:37.54,0:44:42.05,Default,,0,0,0,,Мен сіздің талантыңыздан шексіз мүмкіндіктерді көремін.
Dialogue: 0,0:44:42.13,0:44:44.68,Default,,0,0,0,,Талантты босқа жіберме
Dialogue: 0,0:44:44.76,0:44:48.18,Default,,0,0,0,,Одан да биік белестерді бағындыру керек.
Dialogue: 0,0:44:48.26,0:44:50.31,Default,,0,0,0,,Мен ертеңгі ойынды асыға күтемін.
Dialogue: 0,0:44:55.69,0:44:56.61,Default,,0,0,0,,Біріншісі – сараймен байланысты адамдардың сеніміне ие болу.
Dialogue: 0,0:44:56.69,0:44:59.07,Default,,0,0,0,,Не, Хару мұнда жоқ па?
Dialogue: 0,0:44:59.15,0:45:01.57,Default,,0,0,0,,Мен душтан шықсам, ол жоқ екен.
Dialogue: 0,0:45:01.65,0:45:03.70,Default,,0,0,0,,Мүмкін ол өзі жүгіруге барған шығар?
Dialogue: 0,0:45:03.78,0:45:05.20,Default,,0,0,0,,Қорқамын, ол қайтып келмейді.
Dialogue: 0,0:45:05.28,0:45:08.49,Default,,0,0,0,,Ертең бұл маңызды ойын болса да, оны көруге көптеген барлаушылар келеді.
Dialogue: 0,0:45:09.16,0:45:10.62,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:45:10.70,0:45:12.50,Default,,0,0,0,,Сіз Харумен бірдеңе туралы сөйлестіңіз бе?
Dialogue: 0,0:45:13.08,0:45:17.08,Default,,0,0,0,,Мен жай ғана сіздің шешіміңізді қабылдағаныңызды білуге ​​тырысамын.
Dialogue: 0,0:45:17.17,0:45:19.88,Default,,0,0,0,,Бірақ ол әдеттегідей қашып бара жатқан сияқты.
Dialogue: 0,0:45:19.96,0:45:22.38,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:45:22.46,0:45:25.38,Default,,0,0,0,,Бірақ Хал - Хал.
Dialogue: 0,0:45:25.47,0:45:27.26,Default,,0,0,0,,Сіз көп нәрсе туралы ойлайтыныңызға сенімдімін.
Dialogue: 0,0:45:27.34,0:45:28.76,Default,,0,0,0,,Дауыстап айтпасаң да
Dialogue: 0,0:45:31.72,0:45:33.27,Default,,0,0,0,,Мен айтпасам түсінбейсің
Dialogue: 0,0:45:33.35,0:45:35.64,Default,,0,0,0,,Марлей әскері емес.
Dialogue: 0,0:45:36.81,0:45:39.90,Default,,0,0,0,,-(Рин) Сонда не істейсің?-(Макото) А?
Dialogue: 0,0:45:39.98,0:45:44.40,Default,,0,0,0,,Сіздің қабілетіңізбен бір немесе екі барлаушы келуі керек.
Dialogue: 0,0:45:50.45,0:45:52.33,Default,,0,0,0,,Мен...
Dialogue: 0,0:45:52.41,0:45:54.79,Default,,0,0,0,,Хару-чан, Мако-чан, тыңда!
Dialogue: 0,0:45:54.87,0:45:56.42,Default,,0,0,0,,- (Нагиса)... Рин-чан!? - (Рей) Рин-сан!?
Dialogue: 0,0:45:56.50,0:45:59.08,Default,,0,0,0,,Балалар, турнир басталмай тұрып кеш тұрмайсыңдар ма?
Dialogue: 0,0:45:59.17,0:45:59.96,Default,,0,0,0,,Атта
Dialogue: 0,0:46:00.04,0:46:03.67,Default,,0,0,0,,А... Хехехе... Сағат небәрі 11 болды~?
Dialogue: 0,0:46:03.76,0:46:05.34,Default,,0,0,0,,Не болды?
Dialogue: 0,0:46:05.42,0:46:07.80,Default,,0,0,0,,Менің Харумен бірдеңе болды.
Dialogue: 0,0:46:07.89,0:46:10.35,Default,,0,0,0,,Сізді көргеніме қуаныштымын, сондықтан мен үйге бара жатырмын. Сонда кездескенше.
Dialogue: 0,0:46:11.05,0:46:13.22,Default,,0,0,0,,- (Нагиса) Тоқта, Рин-чан - (Рин) А?
Dialogue: 0,0:46:13.31,0:46:15.23,Default,,0,0,0,,Мен ертең жеңілмеймін
Dialogue: 0,0:46:17.02,0:46:17.98,Default,,0,0,0,,Иә
Dialogue: 0,0:46:18.06,0:46:19.98,Default,,0,0,0,,Бұл менің жолым.
Dialogue: 0,0:46:20.06,0:46:23.73,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:46:24.69,0:46:28.11,Default,,0,0,0,,Мектебіміздің мақтанышысың. Іске сәт.
Dialogue: 0,0:46:28.20,0:46:30.57,Default,,0,0,0,,Бұл талантты босқа жібермеңіз
Dialogue: 0,0:46:30.66,0:46:31.49,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:46:31.58,0:46:36.79,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:46:37.87,0:46:39.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:46:39.83,0:46:42.25,Default,,0,0,0,,Ой... таң қалдырады...
Dialogue: 0,0:46:42.34,0:46:44.00,Default,,0,0,0,,Міне келді, Хару.
Dialogue: 0,0:46:44.09,0:46:45.38,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:46:45.46,0:46:47.01,Default,,0,0,0,,Бүгінгі ойын!
Dialogue: 0,0:46:47.63,0:46:50.64,Default,,0,0,0,,Оны көруге көптеген барлаушылар келетініне сенімдімін!
Dialogue: 0,0:46:50.72,0:46:52.18,Default,,0,0,0,,Сәйкес емес
Dialogue: 0,0:46:52.26,0:46:53.85,Default,,0,0,0,,Теориялық тұрғыдан ойлау
Dialogue: 0,0:46:53.93,0:46:56.98,Default,,0,0,0,,Менің ағамды барлаушылар байқамауы, т.б.
Dialogue: 0,0:46:57.06,0:46:58.35,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:46:59.27,0:47:00.73,Default,,0,0,0,,Жетеді, тоқтат.
Dialogue: 0,0:47:00.81,0:47:04.23,Default,,0,0,0,,Нанасе-кунның жүзуі керемет
Dialogue: 0,0:47:04.32,0:47:06.28,Default,,0,0,0,,(Харуканың ауыр тыныс алуы)
Dialogue: 0,0:47:06.36,0:47:08.86,Default,,0,0,0,,«Қашып кете алмайсың» деген атақты сөз бар.
Dialogue: 0,0:47:08.95,0:47:11.28,Default,,0,0,0,,«Мені тұйық жолға тап болдым».
Dialogue: 0,0:47:12.66,0:47:14.03,Default,,0,0,0,,Харука Сенпай
Dialogue: 0,0:47:14.12,0:47:17.04,Default,,0,0,0,,Қарағым, үлкен аға күтіп тұр!
Dialogue: 0,0:47:17.12,0:47:19.92,Default,,0,0,0,,Жүр, кеттік, Хару.
Dialogue: 0,0:47:24.92,0:47:27.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:47:27.46,0:47:31.97,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:47:32.05,0:47:32.89,Default,,0,0,0,,Жарайды
Dialogue: 0,0:47:41.10,0:47:42.10,Default,,0,0,0,,Нанасе-кун
Dialogue: 0,0:47:42.19,0:47:44.86,Default,,0,0,0,,Жүр, мен сенің жүзуіңді көрейін.
Dialogue: 0,0:47:44.94,0:47:48.19,Default,,0,0,0,,Сізге тегін!
Dialogue: 0,0:47:48.69,0:47:50.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:50.57,0:47:51.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:47:51.32,0:47:56.33,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:48:13.14,0:48:14.85,Default,,0,0,0,,Міне, осында!
Dialogue: 0,0:48:14.93,0:48:16.43,Default,,0,0,0,,Мен қобалжыдым.
Dialogue: 0,0:48:16.51,0:48:18.60,Default,,0,0,0,,Не болды? Халл
Dialogue: 0,0:48:18.68,0:48:19.56,Default,,0,0,0,,Бөлек
Dialogue: 0,0:48:19.64,0:48:22.85,Default,,0,0,0,,Эй, сен ол жақта колледждің барлаушысы емессің бе?
Dialogue: 0,0:48:22.94,0:48:25.11,Default,,0,0,0,,Сол жақтағыға да солай.
Dialogue: 0,0:48:25.19,0:48:27.23,Default,,0,0,0,,- (Басқа мектептің спортшысы А) Қаншама адам келді - (Басқа мектептің спортшысы В) Ой.
Dialogue: 0,0:48:27.32,0:48:29.23,Default,,0,0,0,,Егер сіз мұнда жақсы жүзуді көрсетсеңіз
Dialogue: 0,0:48:29.32,0:48:32.24,Default,,0,0,0,,Міне, біз қанша мектепті естиміз.
Dialogue: 0,0:48:32.32,0:48:33.66,Default,,0,0,0,,Корпус
Dialogue: 0,0:48:33.74,0:48:35.91,Default,,0,0,0,,Халл? Эй Хару!
Dialogue: 0,0:48:36.70,0:48:38.62,Default,,0,0,0,,Сол қол
Dialogue: 0,0:48:40.25,0:48:42.25,Default,,0,0,0,,А, ештеңе жоқ.
Dialogue: 0,0:48:43.04,0:48:44.29,Default,,0,0,0,,Бар, кемпірқосақ асынан асып шашыра.
Dialogue: 0,0:48:44.37,0:48:45.83,Default,,0,0,0,,Кеттік, Хару-чан!
Dialogue: 0,0:48:45.92,0:48:47.96,Default,,0,0,0,,Барлығыңыз, бар күшіңізді салыңыз!
Dialogue: 0,0:48:48.05,0:48:48.88,Default,,0,0,0,,- (Рей) Иә! -(Нағиса) Иә!
Dialogue: 0,0:48:48.96,0:48:51.51,Default,,0,0,0,,Олай болса, әрқайсымыз қолымыздан келгеннің бәрін жасайық.
Dialogue: 0,0:48:51.59,0:48:53.51,Default,,0,0,0,,Қане, өзімізді бекітіп алайық
Dialogue: 0,0:48:54.47,0:48:55.84,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:48:57.26,0:49:00.02,Default,,0,0,0,,Ерлер 100 метрге арқамен жүзу 3 жиынтық
Dialogue: 0,0:49:00.10,0:49:02.89,Default,,0,0,0,,- (Rei/E) Макото Сенпай! -(Нагиса) Мако-чан!
Dialogue: 0,0:49:02.98,0:49:05.77,Default,,0,0,0,,Жарайды
Dialogue: 0,0:49:05.85,0:49:07.40,Default,,0,0,0,,Айт!
Dialogue: 0,0:49:07.48,0:49:10.44,Default,,0,0,0,,Бар, бар, бар, бар, Макото!
Dialogue: 0,0:49:10.53,0:49:12.99,Default,,0,0,0,,Бар, бар, бар, бар, Макото!
Dialogue: 0,0:49:13.07,0:49:15.99,Default,,0,0,0,,Осе-озе Макото!
Dialogue: 0,0:49:16.07,0:49:19.12,Default,,0,0,0,,Осе-осе-осе-осе Макото!
Dialogue: 0,0:49:19.20,0:49:20.79,Default,,0,0,0,,Соңғы соңғы соңғы соңғы!
Dialogue: 0,0:49:20.87,0:49:22.41,Default,,0,0,0,,Соңғы соңғы соңғы соңғы!
Dialogue: 0,0:49:22.50,0:49:25.58,Default,,0,0,0,,(жалғасы қолдау)
Dialogue: 0,0:49:25.67,0:49:27.71,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:49:28.29,0:49:30.71,Default,,0,0,0,,Өйткені, деңгейі префектуралық турнирден бөлек.
Dialogue: 0,0:49:30.80,0:49:33.30,Default,,0,0,0,,Бұл жергілікті турнир...
Dialogue: 0,0:49:33.38,0:49:34.84,Default,,0,0,0,,Хаха...
Dialogue: 0,0:49:35.76,0:49:38.72,Default,,0,0,0,,Макото финалға өте алмаған сияқты.
Dialogue: 0,0:49:38.80,0:49:41.22,Default,,0,0,0,,- (Харука) Ах - (Рин) Хару Сіз шешім қабылдадыңыз ба?
Dialogue: 0,0:49:41.31,0:49:42.60,Default,,0,0,0,,Бөлек
Dialogue: 0,0:49:43.39,0:49:44.94,Default,,0,0,0,,Бұл «арнайы» емес, солай емес пе?
Dialogue: 0,0:49:45.02,0:49:49.23,Default,,0,0,0,,Префектуралық турнирден кейін мен де скауттық ұсыныстар алдым.
Dialogue: 0,0:49:49.82,0:49:51.61,Default,,0,0,0,,Сіз де осындасыз ба?
Dialogue: 0,0:49:54.32,0:49:55.24,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:49:56.11,0:49:58.74,Default,,0,0,0,,Бұл оқиға матч аяқталғаннан кейін орын алады.
Dialogue: 0,0:49:58.82,0:50:00.12,Default,,0,0,0,,Мен бірінші барамын.
Dialogue: 0,0:50:03.20,0:50:06.50,Default,,0,0,0,,Ерлер 100 метрге еркін стильде 6 жиынтық
Dialogue: 0,0:50:06.58,0:50:08.75,Default,,0,0,0,,Келесі Харука Сенпай!
Dialogue: 0,0:50:19.18,0:50:21.43,Default,,0,0,0,,
Dialogue: 0,0:50:23.68,0:50:25.18,Default,,0,0,0,,Жарайды
Dialogue: 0,0:50:27.81,0:50:29.31,Default,,0,0,0,,Айт!
Dialogue: 0,0:50:49.88,0:50:51.67,Default,,0,0,0,,(Харуканың ауыр демі)
Dialogue: 0,0:50:58.34,0:50:59.43,Default,,0,0,0,,Мен...
Dialogue: 0,0:51:05.22,0:51:06.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:08.98,0:51:10.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:25.41,0:51:27.20,Default,,0,0,0,,(аудитория шуы)
Dialogue: 0,0:51:27.29,0:51:28.71,Default,,0,0,0,,Хару-чан...
Dialogue: 0,0:51:34.84,0:51:36.09,Default,,0,0,0,,Хару!
Dialogue: 0,0:51:38.42,0:51:42.18,Default,,0,0,0,,Эй, сен не істеп жатырсың? Неге олай істедің!?
Dialogue: 0,0:51:42.26,0:51:43.68,Default,,0,0,0,,Оның сізге қатысы жоқ.
Dialogue: 0,0:51:43.76,0:51:45.18,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:51:45.26,0:51:47.72,Default,,0,0,0,,Бұл барлаушылар назар аударатын маңызды матч!
Dialogue: 0,0:51:47.81,0:51:49.23,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:51:50.44,0:51:52.19,Default,,0,0,0,,Себебі барлаушылар қарап отыр ма?
Dialogue: 0,0:51:52.69,0:51:54.86,Default,,0,0,0,,Көп адамдардың алдында рекорд орнатқыңыз келгендіктен бе?
Dialogue: 0,0:51:55.44,0:51:58.36,Default,,0,0,0,,Мен ол үшін жүзбеймін.
Dialogue: 0,0:52:01.07,0:52:03.53,Default,,0,0,0,,Сонымен, сен не үшін жүзіп жүрсің?
Dialogue: 0,0:52:04.57,0:52:07.29,Default,,0,0,0,,Өзіме және достарыма
Dialogue: 0,0:52:09.54,0:52:13.63,Default,,0,0,0,,Олай болса достарыңыз бен өзіңіз үшін суға түсіңіз.
Dialogue: 0,0:52:13.71,0:52:17.25,Default,,0,0,0,,Бұл сіздің болашағыңызға әкелетінін түсінбейсіз бе?
Dialogue: 0,0:52:17.84,0:52:19.88,Default,,0,0,0,,Сіздің арманыңыз жоқ па?
Dialogue: 0,0:52:19.97,0:52:22.93,Default,,0,0,0,,Оған байыптырақ соғып көріңіз! Бұл сіз екеніңізге сенімдімін...
Dialogue: 0,0:52:23.01,0:52:23.89,Default,,0,0,0,,(шкафты соғу дыбысы)
Dialogue: 0,0:52:25.26,0:52:27.01,Default,,0,0,0,,Түсінбейтін сенсің!
Dialogue: 0,0:52:27.10,0:52:29.89,Default,,0,0,0,,«Арман» дегеніміз не? «Болашақ» дегеніміз не?
Dialogue: 0,0:52:29.98,0:52:33.40,Default,,0,0,0,,Бұл сіздікі! Мен сенен басқашамын
Dialogue: 0,0:52:33.48,0:52:35.69,Default,,0,0,0,,Менде ондай ештеңе жоқ!
Dialogue: 0,0:52:46.12,0:52:48.41,Default,,0,0,0,,- (Макото) Хару - (Рей) Харука-сенпай
Dialogue: 0,0:52:48.49,0:52:51.00,Default,,0,0,0,,Балалар, келдіңдер ме?
Dialogue: 0,0:52:53.12,0:52:54.33,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:52:54.42,0:52:57.25,Default,,0,0,0,,Рей Нагиса Макото
Dialogue: 0,0:52:57.34,0:53:00.42,Default,,0,0,0,,Балалар мен сендермен эстафетада жүземін.
Dialogue: 0,0:53:00.51,0:53:02.55,Default,,0,0,0,,Сондықтан мен мұнда келдім
Dialogue: 0,0:53:12.10,0:53:15.77,Default,,0,0,0,,- (Рей) Жеке адамдар қала алмады - (Нағиса) Мен де
Dialogue: 0,0:53:15.85,0:53:16.90,Default,,0,0,0,,-(Рей) Ху... -(Нагиса) Бірақ бірақ
Dialogue: 0,0:53:16.98,0:53:19.73,Default,,0,0,0,,Рей-чанға да аз ғана уақыт қалды.
Dialogue: 0,0:53:19.82,0:53:21.99,Default,,0,0,0,,Мен жарысқа қабілетті жүзуге көңіл бөле бастадым.
Dialogue: 0,0:53:22.07,0:53:24.91,Default,,0,0,0,,Мен жүзгеніме бір жылдан сәл астам уақыт өткеніне сене алар емеспін.
Dialogue: 0,0:53:25.99,0:53:27.49,Default,,0,0,0,,Рахмет
Dialogue: 0,0:53:27.57,0:53:31.45,Default,,0,0,0,,Нагиса-кун финалға шыққанда таң қалмайтын уақыт болды.
Dialogue: 0,0:53:31.54,0:53:33.58,Default,,0,0,0,,Бұл керемет жүзу болды.
Dialogue: 0,0:53:33.66,0:53:35.75,Default,,0,0,0,,Иә, рахмет, Рей Чан.
Dialogue: 0,0:53:37.88,0:53:39.88,Default,,0,0,0,,Эстафета Қолымыздан келгенді жасайық
Dialogue: 0,0:53:41.17,0:53:43.72,Default,,0,0,0,,Харука-сенпай, жақсысың ба?
Dialogue: 0,0:53:43.80,0:53:46.93,Default,,0,0,0,,Жарайды, Хару-чан, сен маған айттың.
Dialogue: 0,0:53:47.01,0:53:48.55,Default,,0,0,0,,«Мен сендермен бірге жүзгім келеді»
Dialogue: 0,0:53:49.39,0:53:51.06,Default,,0,0,0,,Енді сол сөздерге сенейік
Dialogue: 0,0:53:53.23,0:53:54.56,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:53:54.64,0:53:57.31,Default,,0,0,0,,Мен өз бетімше жүзе алмаймын.
Dialogue: 0,0:53:57.40,0:53:58.40,Default,,0,0,0,,Жарысқа келгенде қобалжыймын дейсіз бе?
Dialogue: 0,0:53:58.40,0:54:00.32,Default,,0,0,0,,Жарысқа келгенде қобалжыймын дейсіз бе?
Dialogue: 0,0:53:58.40,0:54:00.32,Default,,0,0,0,,Орындайтын болсақ, міндетті түрде жеңіп, алға басайық.
Dialogue: 0,0:54:00.32,0:54:00.40,Default,,0,0,0,,Осылай жасайтын болсақ, міндетті түрде жеңіп, алға жылайық.
Dialogue: 0,0:54:00.40,0:54:01.32,Default,,0,0,0,,Бұны орындайтын болсақ, міндетті түрде жеңіп, алға жылайық.
Dialogue: 0,0:54:00.40,0:54:01.32,Default,,0,0,0,,Иә, мен бұрын...
Dialogue: 0,0:54:01.32,0:54:01.40,Default,,0,0,0,,Иә, мен бұрын...
Dialogue: 0,0:54:01.40,0:54:02.53,Default,,0,0,0,,Иә, мен бұрын...
Dialogue: 0,0:54:01.40,0:54:02.53,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:54:02.61,0:54:04.78,Default,,0,0,0,,Менде де осындай мәселе бар.
Dialogue: 0,0:54:02.61,0:54:04.78,Default,,0,0,0,,Жүзуді біз, яғни Иватоби командасы ғана жасай алады.
Dialogue: 0,0:54:04.78,0:54:04.90,Default,,0,0,0,,Жүзуді біз, яғни Иватоби командасы ғана жасай алады.
Dialogue: 0,0:54:04.90,0:54:05.45,Default,,0,0,0,,Жүзуді біз, яғни Иватоби командасы ғана жасай алады.
Dialogue: 0,0:54:04.90,0:54:05.45,Default,,0,0,0,,Көзілдірікті балаларға арналған ақыл-ой жаттығулары
Dialogue: 0,0:54:05.45,0:54:05.53,Default,,0,0,0,,Көзілдірікті балаларға арналған ақыл-ой жаттығулары
Dialogue: 0,0:54:05.53,0:54:06.82,Default,,0,0,0,,Көзілдірікті балаларға арналған ақыл-ой жаттығулары
Dialogue: 0,0:54:05.53,0:54:06.82,Default,,0,0,0,,Иә
Dialogue: 0,0:54:06.91,0:54:08.91,Default,,0,0,0,,Мен сізге бір рет ұсыныс жасадым.
Dialogue: 0,0:54:11.37,0:54:13.75,Default,,0,0,0,,Сол оқиға туралы көбірек айтып беріңізші.
Dialogue: 0,0:54:13.83,0:54:15.33,Default,,0,0,0,,Хэхехе~ Не істеуім керек~?
Dialogue: 0,0:54:15.41,0:54:17.29,Default,,0,0,0,,Иә? Жақсы емес пе?
Dialogue: 0,0:54:18.08,0:54:20.50,Default,,0,0,0,,Рей-чан, не болды?
Dialogue: 0,0:54:20.59,0:54:23.26,Default,,0,0,0,,Жоқ... ештеңе.
Dialogue: 0,0:54:26.97,0:54:30.14,Default,,0,0,0,,Ұлттық құрама эстафетаға қатысуыңызбен құттықтаймыз!
Dialogue: 0,0:54:30.22,0:54:31.81,Default,,0,0,0,,Рахмет
Dialogue: 0,0:54:31.89,0:54:35.73,Default,,0,0,0,,Хазуки-кун да, Рюгасаки-кун да барын салды, солай ма?
Dialogue: 0,0:54:35.81,0:54:40.11,Default,,0,0,0,,Иә, Харука-сенпай да, Макото-сенпай да керемет жүзушілер болған.
Dialogue: 0,0:54:40.19,0:54:43.69,Default,,0,0,0,,Осы қарқынмен біз бүкіл ел бойынша жақсы нәтижелерге қол жеткізе аламыз деп ойлаймын.
Dialogue: 0,0:54:43.78,0:54:45.15,Default,,0,0,0,,Әй...
Dialogue: 0,0:54:45.24,0:54:46.82,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:54:46.90,0:54:51.78,Default,,0,0,0,,Хмм, турнирден кейін төрт адамдық эстафета уақыты жақсарған жоқ.
Dialogue: 0,0:54:52.78,0:54:55.41,Default,,0,0,0,,- (Ханамура) Нанасе-сенпай жарай ма? -(E) Иә?
Dialogue: 0,0:54:55.50,0:54:59.25,Default,,0,0,0,,Бұл сәйкестік әдеттегідей көрінбеді.
Dialogue: 0,0:55:00.79,0:55:04.38,Default,,0,0,0,,Хару-чан, сен бүгін жалғыз қалып жаттығу жасайсың ба?
Dialogue: 0,0:55:04.46,0:55:09.38,Default,,0,0,0,,Харука-сенпай, сен ел чемпионатында еркін стильде жүзе алмайсың...
Dialogue: 0,0:55:09.47,0:55:10.30,Default,,0,0,0,,Иә
Dialogue: 0,0:55:10.39,0:55:13.14,Default,,0,0,0,,Бұл шынымен жақсы нәрсе болды ма?
Dialogue: 0,0:55:13.22,0:55:14.56,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:55:14.64,0:55:16.85,Default,,0,0,0,,«Мен тек еркін жүземін»
Dialogue: 0,0:55:16.93,0:55:19.23,Default,,0,0,0,,Бұл Харука Сенпайдың стилі болды.
Dialogue: 0,0:55:19.31,0:55:23.36,Default,,0,0,0,,Мені соншалықты алыс ағаның суға түсуі қызықтырды.
Dialogue: 0,0:55:23.44,0:55:26.15,Default,,0,0,0,,Менің де осылай жүзгім келді.
Dialogue: 0,0:55:26.23,0:55:30.24,Default,,0,0,0,,Бірақ Харука Сенпай еркін жүзбейді.
Dialogue: 0,0:55:30.32,0:55:32.12,Default,,0,0,0,,Тек реле...
Dialogue: 0,0:55:32.74,0:55:35.91,Default,,0,0,0,,Харука-сенпайды осылайша не өзгертті?
Dialogue: 0,0:55:35.99,0:55:37.66,Default,,0,0,0,,Бұл біз болуымыз мүмкін
Dialogue: 0,0:55:37.75,0:55:39.04,Default,,0,0,0,,Е!
Dialogue: 0,0:55:39.12,0:55:41.71,Default,,0,0,0,,Рей-чан мұны жаман нәрсе деп айта ма!?
Dialogue: 0,0:55:41.79,0:55:44.25,Default,,0,0,0,,Хару-чанмен эстафеталық жүзуді қаламайсыз ба?
Dialogue: 0,0:55:44.84,0:55:47.01,Default,,0,0,0,,Мен сіздің жүзгіңіз келетініне сенімдімін, солай ма?
Dialogue: 0,0:55:49.80,0:55:53.51,Default,,0,0,0,,Бірақ бәрібір, мен мәңгі бостан боламын
Dialogue: 0,0:55:53.60,0:55:56.51,Default,,0,0,0,,Мен сенің фрилансер болып қалуыңды қалаймын және мен үшін үлкенірек...
Dialogue: 0,0:55:58.02,0:56:01.10,Default,,0,0,0,,Хару-чан әлі бос па...
Dialogue: 0,0:56:02.69,0:56:05.48,Default,,0,0,0,,- (Макото) Обон жақында қалды - (Харука) О
Dialogue: 0,0:56:05.57,0:56:07.61,Default,,0,0,0,,Харунчидің ата-анасы қайтып келе ме?
Dialogue: 0,0:56:07.69,0:56:09.28,Default,,0,0,0,,Жаздың аяғында
Dialogue: 0,0:56:09.94,0:56:13.20,Default,,0,0,0,,Хехе, өзіңді бұрынғыдай еркін сезінесің.
Dialogue: 0,0:56:13.28,0:56:16.79,Default,,0,0,0,,Аа, дұрыс, бәріміз отшашуды тамашалайық.
Dialogue: 0,0:56:16.87,0:56:18.87,Default,,0,0,0,,Нагиса мен Рейді де шақыр
Dialogue: 0,0:56:18.95,0:56:20.54,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:56:24.29,0:56:25.54,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:56:25.63,0:56:26.38,Default,,0,0,0,,Әй, Хару!
Dialogue: 0,0:56:28.13,0:56:31.17,Default,,0,0,0,,Бұл... сіздің мансап жолыңыз туралы.
Dialogue: 0,0:56:32.68,0:56:33.68,Default,,0,0,0,,Бұл әңгіме жақсы.
Dialogue: 0,0:56:33.76,0:56:36.10,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:56:36.18,0:56:37.93,Default,,0,0,0,,Уууу~! Уф!
Dialogue: 0,0:56:38.01,0:56:39.22,Default,,0,0,0,,- (Макото) Уау! -(Лотос) Қайтадан қош келдіңіз
Dialogue: 0,0:56:39.31,0:56:40.68,Default,,0,0,0,,Тамақ дайын.
Dialogue: 0,0:56:40.77,0:56:44.35,Default,,0,0,0,,- (Рен) Хару-чан, сен де кел. - (Жүгіріп) Бірге тамақтанайық.
Dialogue: 0,0:56:45.02,0:56:47.36,Default,,0,0,0,,- (Харука) Мен бүгін тоқтаймын - (Жүгіріп) А?
Dialogue: 0,0:56:47.44,0:56:49.32,Default,,0,0,0,,Ал, келесі жолы тағы тамақтанайық.
Dialogue: 0,0:56:49.40,0:56:50.24,Default,,0,0,0,,О
Dialogue: 0,0:56:51.15,0:56:52.28,Default,,0,0,0,,Қайырлы түн~
Dialogue: 0,0:56:55.49,0:56:56.66,Default,,0,0,0,,(Саяма) Тыныш бол, бәрің!
Dialogue: 0,0:56:57.24,0:56:59.95,Default,,0,0,0,,Бұл сіздің уақыт кестесінің графигі.
Dialogue: 0,0:57:01.70,0:57:04.08,Default,,0,0,0,,Менің реле уақытым жақсармай жатыр...
Dialogue: 0,0:57:04.17,0:57:05.42,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:57:05.50,0:57:09.50,Default,,0,0,0,,Жергілікті жарыстан кейін менің жеке уақытым жақсарды.
Dialogue: 0,0:57:09.59,0:57:12.51,Default,,0,0,0,,Қандай да бір себептермен менің реле уақытым жақсармай жатыр.
Dialogue: 0,0:57:12.59,0:57:14.80,Default,,0,0,0,,Тапсырыс жақсы өтуі керек.
Dialogue: 0,0:57:14.88,0:57:17.14,Default,,0,0,0,,Бұл біз бірге жүзе алмаймыз дегенді білдіре ме?
Dialogue: 0,0:57:17.22,0:57:18.56,Default,,0,0,0,,Мен бұған сенбеймін...
Dialogue: 0,0:57:18.64,0:57:20.56,Default,,0,0,0,,Бұл күрделі мәселе
Dialogue: 0,0:57:20.64,0:57:24.48,Default,,0,0,0,,Жаттықтырушы Сасабе жаттығу мәзірін реттейді.
Dialogue: 0,0:57:24.56,0:57:27.77,Default,,0,0,0,,Барлығымыз, әйтеуір біз ұлттық құрылтайға дейін қазіргі жағдайымызды жақсарта аламыз.
Dialogue: 0,0:57:27.86,0:57:30.02,Default,,0,0,0,,Шығу үшін бар күшіңізді салыңыз.
Dialogue: 0,0:57:32.74,0:57:33.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:33.99,0:57:35.45,Default,,0,0,0,,Бұл!
Dialogue: 0,0:57:35.53,0:57:39.78,Default,,0,0,0,,Өткен жылы Харука Сенпай мұны жаңа мүшелерді тарту үшін жасады.
Dialogue: 0,0:57:39.87,0:57:42.25,Default,,0,0,0,,Ағаштан ою Иватоби-чан бау
Dialogue: 0,0:57:42.33,0:57:44.37,Default,,0,0,0,,Рей-чан, мен оны бағаладым~
Dialogue: 0,0:57:44.46,0:57:45.37,Default,,0,0,0,,Иә
Dialogue: 0,0:57:45.46,0:57:47.96,Default,,0,0,0,,Келесі жылы жаңа мүшелер болады ма деп ойлаймын...
Dialogue: 0,0:57:48.50,0:57:50.34,Default,,0,0,0,,Мен кіретініме сенімдімін.
Dialogue: 0,0:57:50.42,0:57:53.80,Default,,0,0,0,,Өйткені біз республикалық турнирге барамыз.
Dialogue: 0,0:57:53.88,0:57:55.63,Default,,0,0,0,,Осындай еңбек өтілі бар бөлімде
Dialogue: 0,0:57:55.72,0:57:58.30,Default,,0,0,0,,Жаңа мүшелерді тартуға мүмкіндік жоқ.
Dialogue: 0,0:57:58.39,0:58:01.39,Default,,0,0,0,,Бірақ ұлттық турнир аяқталғаннан кейін
Dialogue: 0,0:58:01.47,0:58:04.48,Default,,0,0,0,,Үшінші курс Харука-сенпай және Макото-сенпай
Dialogue: 0,0:58:04.56,0:58:06.02,Default,,0,0,0,,Мен зейнеткерлікке шығамын...
Dialogue: 0,0:58:08.56,0:58:10.82,Default,,0,0,0,,Қызық, Хару-чан не істейді?
Dialogue: 0,0:58:10.90,0:58:12.61,Default,,0,0,0,,Нагиса-кун...
Dialogue: 0,0:58:13.32,0:58:17.20,Default,,0,0,0,,Харука-сенпайдың не істегенін қалайсың?
Dialogue: 0,0:58:18.49,0:58:20.33,Default,,0,0,0,,Мен Рей Чанмен бірдеймін
Dialogue: 0,0:58:20.41,0:58:21.99,Default,,0,0,0,,Хару-чан үшін мәңгілік
Dialogue: 0,0:58:22.08,0:58:24.29,Default,,0,0,0,,Мен сенің Хару-чан сияқты болғаныңды қалаймын.
Dialogue: 0,0:58:25.33,0:58:28.25,Default,,0,0,0,,Сондықтан мен Хару-чанның жоғалғанын көргім келмейді.
Dialogue: 0,0:58:28.33,0:58:30.00,Default,,0,0,0,,Нагиса-кун...
Dialogue: 0,0:58:32.63,0:58:35.72,Default,,0,0,0,,Бұл төртеуміздің бірге жүзетін соңғы жарыс болса да.
Dialogue: 0,0:58:35.80,0:58:37.88,Default,,0,0,0,,Осылай тұрғанымыз дұрыс па?
Dialogue: 0,0:58:37.97,0:58:39.26,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:58:39.34,0:58:41.01,Default,,0,0,0,,Өйткені, бұл Хару-чан.
Dialogue: 0,0:58:41.10,0:58:44.39,Default,,0,0,0,,Біз өз сезімімізді дұрыс жеткізуіміз керек, солай ма?
Dialogue: 0,0:58:57.53,0:58:58.36,Default,,0,0,0,,Уау...
Dialogue: 0,0:58:59.03,0:59:00.62,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:59:00.70,0:59:01.57,Default,,0,0,0,,Иә
Dialogue: 0,0:59:05.66,0:59:07.96,Default,,0,0,0,,- (Нагиса) Эй Хару-чан - (Харука) Бұл не?
Dialogue: 0,0:59:08.83,0:59:11.13,Default,,0,0,0,,Республикалық жарыста жүзу алдында
Dialogue: 0,0:59:11.21,0:59:13.42,Default,,0,0,0,,Мен сізбен бір нәрсе туралы сөйлескім келеді.
Dialogue: 0,0:59:13.50,0:59:15.42,Default,,0,0,0,,Әйтпесе, біз
Dialogue: 0,0:59:15.51,0:59:18.26,Default,,0,0,0,,Өйткені мен өзімізді нағыз команданың бір бөлігі бола алмайтындай сезінемін.
Dialogue: 0,0:59:18.34,0:59:19.72,Default,,0,0,0,,Харука Сенпай
Dialogue: 0,0:59:19.80,0:59:24.43,Default,,0,0,0,,Нагиса-кун да, мен де ағаларымыздың жүзу тәсіліне тәнті болдық.
Dialogue: 0,0:59:25.06,0:59:28.14,Default,,0,0,0,,Еш нәрсеге кедергісіз еркін жүзуді қараңыз.
Dialogue: 0,0:59:28.23,0:59:31.35,Default,,0,0,0,,Менің де осылай жүзгім келді.
Dialogue: 0,0:59:31.44,0:59:34.77,Default,,0,0,0,,Бірақ мен енді еркін жүзе алмаймын.
Dialogue: 0,0:59:34.86,0:59:36.78,Default,,0,0,0,,Харука Сенпай қазір қалай жүзуде?
Dialogue: 0,0:59:37.49,0:59:39.49,Default,,0,0,0,,Үлкенге ұқсамайды.
Dialogue: 0,0:59:40.78,0:59:43.49,Default,,0,0,0,,Алыстағы сенпайыма, Дүние жүзіне
Dialogue: 0,0:59:43.57,0:59:46.37,Default,,0,0,0,,Мен сенің көбірек адамдардың алдында жүзгеніңді қалаймын.
Dialogue: 0,0:59:47.20,0:59:50.00,Default,,0,0,0,,Біз сияқты
Dialogue: 0,0:59:50.08,0:59:53.17,Default,,0,0,0,,Оның суда жүзуін көріп, көптеген адамдар әсер етті.
Dialogue: 0,0:59:53.25,0:59:56.42,Default,,0,0,0,,Егер сіз Харука Сенпай сияқты жүзгіңіз келсе
Dialogue: 0,0:59:56.50,0:59:59.76,Default,,0,0,0,,Менің ойымша, бұл жерде соншалықты керемет ештеңе жоқ ...
Dialogue: 0,0:59:59.84,1:00:02.84,Default,,0,0,0,,Рей… Нагиса…
Dialogue: 0,1:00:06.10,1:00:07.81,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:00:12.90,1:00:14.11,Default,,0,0,0,,Хару-чан...
Dialogue: 0,1:00:14.19,1:00:16.11,Default,,0,0,0,,Харука Сенпай...
Dialogue: 0,1:00:26.87,1:00:28.70,Default,,0,0,0,,Мен оны осында деп ойладым.
Dialogue: 0,1:00:32.42,1:00:34.96,Default,,0,0,0,,Мен де Хару...
Dialogue: 0,1:00:35.59,1:00:37.30,Default,,0,0,0,,Бұлай жалғаса береді деп ойламаймын.
Dialogue: 0,1:00:39.01,1:00:40.92,Default,,0,0,0,,Сен оны түсіндің ғой... иә?
Dialogue: 0,1:00:41.01,1:00:43.30,Default,,0,0,0,,Мен Хару жақсы болғанша жақсы болады деп ойладым.
Dialogue: 0,1:00:44.05,1:00:45.97,Default,,0,0,0,,Рин не айтса да
Dialogue: 0,1:00:46.05,1:00:49.06,Default,,0,0,0,,Себебі мен Харудың сезімін бағалағым келді.
Dialogue: 0,1:00:49.72,1:00:53.85,Default,,0,0,0,,Бірақ Хару мұны жергілікті турнирде Ринге айтты, солай ма?
Dialogue: 0,1:00:53.94,1:00:56.73,Default,,0,0,0,,«Арман» дегеніміз не? «Болашақ» дегеніміз не?
Dialogue: 0,1:00:56.81,1:01:00.23,Default,,0,0,0,,Бұл сенікі! Мен сенен басқашамын
Dialogue: 0,1:01:00.32,1:01:01.82,Default,,0,0,0,,Менде ондай ештеңе жоқ!
Dialogue: 0,1:01:01.90,1:01:03.86,Default,,0,0,0,,Егер Hal
Dialogue: 0,1:01:03.95,1:01:06.74,Default,,0,0,0,,Егер сіз шынымен де солай қалғыңыз келсе
Dialogue: 0,1:01:06.82,1:01:08.53,Default,,0,0,0,,Мен ештеңе айтпаймын
Dialogue: 0,1:01:08.62,1:01:12.58,Default,,0,0,0,,Бірақ мен өз арманымды таба алмасам ше?
Dialogue: 0,1:01:12.66,1:01:13.83,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,1:01:14.83,1:01:17.04,Default,,0,0,0,,Мен оны Халдың тапқанын қалаймын.
Dialogue: 0,1:01:19.50,1:01:22.13,Default,,0,0,0,,Ха «Мені тапқаныңды қалаймын»?
Dialogue: 0,1:01:23.05,1:01:26.93,Default,,0,0,0,,Бірдеңені табуға тырыссаң, оны табуға болады ма?
Dialogue: 0,1:01:27.01,1:01:28.60,Default,,0,0,0,,Бұл...
Dialogue: 0,1:01:28.68,1:01:31.56,Default,,0,0,0,,Жетер, осымен әңгіме бітті.
Dialogue: 0,1:01:32.10,1:01:33.48,Default,,0,0,0,,- (Макото) Күтіңіз - (Харука) Жіберіңіз.
Dialogue: 0,1:01:33.56,1:01:35.19,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,1:01:35.27,1:01:37.44,Default,,0,0,0,,Қанша сұрасаң да солай.
Dialogue: 0,1:01:37.52,1:01:39.73,Default,,0,0,0,,Сіз оны іздеп таба алмайсыз.
Dialogue: 0,1:01:39.82,1:01:41.78,Default,,0,0,0,,Мен қазіргідей жақсымын.
Dialogue: 0,1:01:41.86,1:01:42.69,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,1:01:42.78,1:01:45.45,Default,,0,0,0,,Негізі мен Харуды тапқым келеді!
Dialogue: 0,1:01:45.53,1:01:49.53,Default,,0,0,0,,Хал оны тауып, сыртқы әлемге ұшып кетуі керек.
Dialogue: 0,1:01:49.62,1:01:51.45,Default,,0,0,0,,Харуда мұндай күш бар!
Dialogue: 0,1:01:51.54,1:01:53.96,Default,,0,0,0,,Сіз тіпті солай айтасыз!
Dialogue: 0,1:01:54.04,1:01:56.67,Default,,0,0,0,,Қай жерде жүзсең де, кім үшін жүзсең де
Dialogue: 0,1:01:56.75,1:01:58.75,Default,,0,0,0,,Бұл менің еркіндігім!
Dialogue: 0,1:01:59.46,1:02:01.30,Default,,0,0,0,,Мен бәрі жақсы деп айтамын!
Dialogue: 0,1:02:01.38,1:02:03.05,Default,,0,0,0,,Бұл жақсы емес!
Dialogue: 0,1:02:03.92,1:02:06.38,Default,,0,0,0,,Олай емес, сондықтан бәрі айтып жатыр!
Dialogue: 0,1:02:06.47,1:02:08.30,Default,,0,0,0,,Нагиса да, Рей де
Dialogue: 0,1:02:08.39,1:02:10.35,Default,,0,0,0,,Рин және мен!
Dialogue: 0,1:02:10.93,1:02:13.14,Default,,0,0,0,,Себебі Хару барлығына ұнайды
Dialogue: 0,1:02:13.22,1:02:15.18,Default,,0,0,0,,Себебі мен саған қамқормын...
Dialogue: 0,1:02:16.44,1:02:18.06,Default,,0,0,0,,Неге түсінбейсің!
Dialogue: 0,1:02:18.65,1:02:20.48,Default,,0,0,0,,Біздің Харуға арманымыз бар
Dialogue: 0,1:02:20.57,1:02:22.78,Default,,0,0,0,,Болашаққа дұрыс қарауларыңызды қалаймын...
Dialogue: 0,1:02:23.44,1:02:25.40,Default,,0,0,0,,Тек адамдарға қамқорлық жасау
Dialogue: 0,1:02:25.49,1:02:27.66,Default,,0,0,0,,Тым араласпаңыз!
Dialogue: 0,1:02:28.66,1:02:30.99,Default,,0,0,0,,«Арман»? «болашақ»?
Dialogue: 0,1:02:31.08,1:02:32.95,Default,,0,0,0,,Сонда сіз ше?
Dialogue: 0,1:02:33.04,1:02:36.58,Default,,0,0,0,,Тіпті шешім қабылдамасаңыз да, өзіңіз қалаған нәрсені айтпаңыз.
Dialogue: 0,1:02:36.66,1:02:40.17,Default,,0,0,0,,Ха ха ха... бірдеңе айт.
Dialogue: 0,1:02:44.30,1:02:45.47,Default,,0,0,0,,Мен шештім
Dialogue: 0,1:02:47.43,1:02:48.38,Default,,0,0,0,,Мен...
Dialogue: 0,1:02:48.93,1:02:50.68,Default,,0,0,0,,Токиодағы университетке бару
Dialogue: 0,1:02:50.76,1:02:53.68,Default,,0,0,0,,(отшашудың дыбысы)
Dialogue: 0,1:02:57.89,1:02:59.27,Default,,0,0,0,,Мен бірдеңе айтайын деп жатыр едім.
Dialogue: 0,1:03:00.06,1:03:01.48,Default,,0,0,0,,Айтуға қиналамын...
Dialogue: 0,1:03:06.36,1:03:07.20,Default,,0,0,0,,Мен...
Dialogue: 0,1:03:07.28,1:03:08.91,Default,,0,0,0,,Қалағаныңды істе!
Dialogue: 0,1:03:10.07,1:03:10.95,Default,,0,0,0,,Хару!
Dialogue: 0,1:03:24.63,1:03:26.30,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,1:03:28.38,1:03:32.60,Default,,0,0,0,,(есік қоңырауының үздіксіз соғуы)
Dialogue: 0,1:03:33.39,1:03:34.43,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,1:03:35.89,1:03:37.02,Default,,0,0,0,,Рин…
Dialogue: 0,1:03:37.10,1:03:39.39,Default,,0,0,0,,Эй, Хару, сыртқа шығайық.
Dialogue: 0,1:03:40.56,1:03:42.86,Default,,0,0,0,,Дайын бол, кеттік.
Dialogue: 0,1:03:42.94,1:03:44.44,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:03:44.52,1:03:46.40,Default,,0,0,0,,Менің ойымша, бұл шешілді.
Dialogue: 0,1:03:48.32,1:03:49.95,Default,,0,0,0,,Австралия
Dialogue: 0,1:04:04.25,1:04:06.21,Default,,0,0,0,,Сіздің келуіңіздің мақсаты қандай?
Dialogue: 0,1:04:09.84,1:04:11.01,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,1:04:11.80,1:04:12.64,Default,,0,0,0,,Көрікті жерлерді аралау.
Dialogue: 0,1:04:16.39,1:04:17.68,Default,,0,0,0,,Эй
Dialogue: 0,1:04:22.85,1:04:24.86,Default,,0,0,0,,Эй, сен мені қайда апарып жатырсың?
Dialogue: 0,1:04:26.69,1:04:28.15,Default,,0,0,0,,Менің артымнан жүр, сонда түсінесің.
Dialogue: 0,1:04:28.23,1:04:30.15,Default,,0,0,0,,Бұл автобус. Мен оны аламын
Dialogue: 0,1:04:30.24,1:04:31.57,Default,,0,0,0,,Тездетіңіз
Dialogue: 0,1:04:31.65,1:04:33.41,Default,,0,0,0,,Күте тұрыңыз, эй
Dialogue: 0,1:04:45.25,1:04:46.75,Default,,0,0,0,,Иә!?
Dialogue: 0,1:04:46.84,1:04:49.30,Default,,0,0,0,,Хару-чан, Австралияға бардың ба!?
Dialogue: 0,1:04:49.38,1:04:51.47,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,1:04:51.55,1:04:54.05,Default,,0,0,0,,Рин неге кенеттен тағы да солай болды...
Dialogue: 0,1:04:54.14,1:04:57.39,Default,,0,0,0,,Мен Ринмен Хару туралы сөйлестім.
Dialogue: 0,1:04:57.97,1:05:01.60,Default,,0,0,0,,Мен де сені Австралияға апарамын деп ойламаппын.
Dialogue: 0,1:05:01.68,1:05:04.06,Default,,0,0,0,,Ол қандай мақсатқа қызмет етеді?
Dialogue: 0,1:05:04.15,1:05:05.56,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,1:05:07.27,1:05:09.19,Default,,0,0,0,,Мен оны да білмеймін.
Dialogue: 0,1:05:10.03,1:05:14.32,Default,,0,0,0,,Бірақ бұл Хал үшін ерекше сапар болатынына сенімдімін.
Dialogue: 0,1:05:15.24,1:05:16.41,Default,,0,0,0,,Мен сенемін
Dialogue: 0,1:05:19.33,1:05:22.46,Default,,0,0,0,,Хару-чан, сен сауығып, қайтасың деп үміттенемін.
Dialogue: 0,1:05:22.54,1:05:24.75,Default,,0,0,0,,(батпырауық хорват)
Dialogue: 0,1:05:25.88,1:05:28.50,Default,,0,0,0,,(батпырауық хорват)
Dialogue: 0,1:05:36.05,1:05:36.89,Default,,0,0,0,,Я...
Dialogue: 0,1:05:42.68,1:05:43.77,Default,,0,0,0,,Рин?
Dialogue: 0,1:05:46.15,1:05:46.98,Default,,0,0,0,,Эй
Dialogue: 0,1:05:47.56,1:05:48.40,Default,,0,0,0,,Рин!
Dialogue: 0,1:05:49.61,1:05:50.61,Default,,0,0,0,,Корпус
Dialogue: 0,1:05:53.32,1:05:54.82,Default,,0,0,0,,Мен ішуге бірдеңе сатып алдым.
Dialogue: 0,1:05:54.90,1:05:56.41,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,1:05:57.82,1:05:59.58,Default,,0,0,0,,Рұқсатсыз ешқайда шықпаңыз
Dialogue: 0,1:06:01.91,1:06:03.29,Default,,0,0,0,,Нашар
Dialogue: 0,1:06:12.63,1:06:14.84,Default,,0,0,0,,Соңғы турнирде де...
Dialogue: 0,1:06:15.42,1:06:17.34,Default,,0,0,0,,Сіздің арманыңыз жоқ па?
Dialogue: 0,1:06:18.43,1:06:20.05,Default,,0,0,0,,Түсінбейтін сенсің!
Dialogue: 0,1:06:21.01,1:06:23.47,Default,,0,0,0,,Өз сезімдеріңізді елемеу
Dialogue: 0,1:06:23.56,1:06:25.94,Default,,0,0,0,,Мен саған біржақты сезімімді мәжбүрледім.
Dialogue: 0,1:06:28.81,1:06:30.06,Default,,0,0,0,,Ято-сама!
Dialogue: 0,1:06:32.32,1:06:35.07,Default,,0,0,0,,Бірақ мен мұны түсінгеніңізді қалаймын.
Dialogue: 0,1:06:35.65,1:06:36.99,Default,,0,0,0,,Менде әрқашан...
Dialogue: 0,1:06:37.99,1:06:39.82,Default,,0,0,0,,Мен саған тәнті болдым
Dialogue: 0,1:06:39.91,1:06:41.16,Default,,0,0,0,,А...
Dialogue: 0,1:06:41.91,1:06:43.91,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:44.00,1:06:46.58,Default,,0,0,0,,Енді мен сергіп қалдым, барайын ба?
Dialogue: 0,1:06:47.21,1:06:48.04,Default,,0,0,0,,Қайда?
Dialogue: 0,1:06:50.71,1:06:53.55,Default,,0,0,0,,Бұлай уайымдама.
Dialogue: 0,1:06:56.34,1:06:57.34,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,1:06:58.05,1:07:01.43,Default,,0,0,0,,Теңіз болса, сен де тыныш боласың.
Dialogue: 0,1:07:08.27,1:07:09.19,Default,,0,0,0,,Кеттік
Dialogue: 0,1:07:10.65,1:07:12.19,Default,,0,0,0,,Мен олай сезінбеймін.
Dialogue: 0,1:07:13.52,1:07:15.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:07:15.28,1:07:18.24,Default,,0,0,0,,Кім әрқашан киімін бірден шеше бастайды?
Dialogue: 0,1:07:18.32,1:07:19.20,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,1:07:21.37,1:07:24.54,Default,,0,0,0,,Сіз мұнда келгенде, мен сіз міндетті түрде бас тартасыз деп ойладым.
Dialogue: 0,1:07:24.62,1:07:25.95,Default,,0,0,0,,Сіз менің артымнан жақсы жүрдіңіз.
Dialogue: 0,1:07:26.04,1:07:27.79,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,1:07:27.87,1:07:29.17,Default,,0,0,0,,Бөлек
Dialogue: 0,1:07:29.25,1:07:31.21,Default,,0,0,0,,Мен сонда болғым келмеді...
Dialogue: 0,1:07:32.88,1:07:34.59,Default,,0,0,0,,Макотомен ұрысып қалдыңыз ба?
Dialogue: 0,1:07:35.92,1:07:37.88,Default,,0,0,0,,Бұл жұлдыз ба...
Dialogue: 0,1:07:38.67,1:07:40.59,Default,,0,0,0,,Ұрыстың мәні неде?
Dialogue: 0,1:07:40.68,1:07:43.18,Default,,0,0,0,,Мен Сусукемен үнемі араласамын.
Dialogue: 0,1:07:43.26,1:07:44.10,Default,,0,0,0,,Суық
Dialogue: 0,1:07:45.01,1:07:46.02,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,1:07:48.23,1:07:49.52,Default,,0,0,0,,Бұл менің бірінші рет болды
Dialogue: 0,1:07:53.06,1:07:55.65,Default,,0,0,0,,Айтпақшы, Макотоның жігіті
Dialogue: 0,1:07:55.73,1:07:57.94,Default,,0,0,0,,Сіз өзіңіздің мансап жолыңызды шешкен сияқтысыз.
Dialogue: 0,1:07:59.82,1:08:02.74,Default,,0,0,0,,Ол сізге тезірек айтқысы келетінін айтты.
Dialogue: 0,1:08:05.41,1:08:09.96,Default,,0,0,0,,Теңізге осылай қарап отырып тыныштық сезінбейсіз бе?
Dialogue: 0,1:08:10.04,1:08:12.17,Default,,0,0,0,,Мен де бұл елге алғаш келгенде
Dialogue: 0,1:08:12.25,1:08:15.34,Default,,0,0,0,,Мына теңізді көргенде көңілім жеңілдеп қалды.
Dialogue: 0,1:08:20.47,1:08:21.76,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,1:08:21.84,1:08:23.30,Default,,0,0,0,,Қалайсың, балам?
Dialogue: 0,1:08:23.39,1:08:24.55,Default,,0,0,0,,Жапониядағы жағдай қалай?
Dialogue: 0,1:08:24.64,1:08:26.43,Default,,0,0,0,,Мен жақсы жүрдім Рассел!
Dialogue: 0,1:08:27.60,1:08:29.43,Default,,0,0,0,,Әй, сен қалай өстің!
Dialogue: 0,1:08:29.52,1:08:31.69,Default,,0,0,0,,Себебі мен күнде жүзетінмін.
Dialogue: 0,1:08:31.77,1:08:33.94,Default,,0,0,0,,Күн сайын? Сіз оны қатты жақсы көресіз!
Dialogue: 0,1:08:34.02,1:08:34.90,Default,,0,0,0,,(Тик-так, тик-так соғады сағат)
Dialogue: 0,1:08:36.44,1:08:38.40,Default,,0,0,0,,Әлі де ескі жолдасыңмен жүзіп жүрсің бе?
Dialogue: 0,1:08:38.48,1:08:41.03,Default,,0,0,0,,О, сен оның досы Харука туралы айтып тұрсың!
Dialogue: 0,1:08:41.11,1:08:41.95,Default,,0,0,0,,Хару?
Dialogue: 0,1:08:42.03,1:08:43.99,Default,,0,0,0,,Рин, бұл сенің досың Хару ма?
Dialogue: 0,1:08:44.07,1:08:44.95,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,1:08:45.49,1:08:48.16,Default,,0,0,0,,Халл! Онда тұрма, мұнда кел
Dialogue: 0,1:08:48.24,1:08:52.16,Default,,0,0,0,,Бұл менің үйде болғанымда маған қамқор болған Рассел мен Лори.
Dialogue: 0,1:08:52.25,1:08:53.79,Default,,0,0,0,,Бастаңыз!
Dialogue: 0,1:08:53.87,1:08:55.88,Default,,0,0,0,,Қалағаныңызша алыңыз!
Dialogue: 0,1:08:57.96,1:08:59.21,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,1:08:59.30,1:09:01.88,Default,,0,0,0,,Хару дәл сен оны Рин сипаттағандай.
Dialogue: 0,1:09:01.97,1:09:05.05,Default,,0,0,0,,Салқын мінез, судай мөлдір көздері.
Dialogue: 0,1:09:05.14,1:09:06.22,Default,,0,0,0,,Дұрыс айтасың, қымбаттым.
Dialogue: 0,1:09:06.97,1:09:10.06,Default,,0,0,0,,Көздерің судай мөлдір, салқын болсын деп үміттенемін.
Dialogue: 0,1:09:10.14,1:09:11.98,Default,,0,0,0,,Рин сіз тек еркін жүзесіз дейді.
Dialogue: 0,1:09:13.56,1:09:17.48,Default,,0,0,0,,Хару, сен тек еркін жүзесің бе?
Dialogue: 0,1:09:17.57,1:09:19.48,Default,,0,0,0,,- (Харука) Мен... Иса - (Рин) Хехе
Dialogue: 0,1:09:19.57,1:09:20.40,Default,,0,0,0,,Демек, бұл дұрыс.
Dialogue: 0,1:09:20.40,1:09:21.24,Default,,0,0,0,,Демек, бұл рас.
Dialogue: 0,1:09:20.40,1:09:21.24,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,1:09:21.24,1:09:21.32,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,1:09:21.32,1:09:22.70,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,1:09:21.32,1:09:22.70,Default,,0,0,0,,Уф.
Dialogue: 0,1:09:22.78,1:09:24.28,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,1:09:24.36,1:09:26.74,Default,,0,0,0,,Рин саған Хару қарайды!
Dialogue: 0,1:09:26.82,1:09:30.29,Default,,0,0,0,,Ол сен туралы айтқан сайын тамсанатын.
Dialogue: 0,1:09:31.12,1:09:32.83,Default,,0,0,0,,Эй, енді...
Dialogue: 0,1:09:32.91,1:09:35.46,Default,,0,0,0,,Эй, сен не айтып тұрсың?
Dialogue: 0,1:09:35.54,1:09:37.75,Default,,0,0,0,,-(Рин) Жақсы. -(Харука) Бұл жақсы емес.
Dialogue: 0,1:09:40.67,1:09:44.26,Default,,0,0,0,,Ал... Мен Хару туралы айтып едім.
Dialogue: 0,1:09:44.34,1:09:47.72,Default,,0,0,0,,Сонымен, құрбым, Жапонияда қызың бар ма?
Dialogue: 0,1:09:47.80,1:09:51.06,Default,,0,0,0,,Умм... яғни... Мм...
Dialogue: 0,1:09:51.14,1:09:52.47,Default,,0,0,0,,(Расселдің күлкісі)
Dialogue: 0,1:09:52.56,1:09:54.48,Default,,0,0,0,,Менің ойымша, бұл «жоқ».
Dialogue: 0,1:09:54.56,1:09:56.23,Default,,0,0,0,,Біздің бала Рин кеш гүлдейді.
Dialogue: 0,1:09:56.31,1:09:58.94,Default,,0,0,0,,Оң. Ол кезді есіңе түсір...
Dialogue: 0,1:09:59.02,1:10:01.48,Default,,0,0,0,,Бұл Лори туралы айтудың қажеті жоқ.
Dialogue: 0,1:10:01.57,1:10:03.11,Default,,0,0,0,,Хм
Dialogue: 0,1:10:03.19,1:10:04.95,Default,,0,0,0,,Қазір Жапонияда жаз мезгілі, солай ма?
Dialogue: 0,1:10:05.03,1:10:05.86,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,1:10:05.95,1:10:07.45,Default,,0,0,0,,Ол жақта жаз шынымен ыстық емес пе?
Dialogue: 0,1:10:07.53,1:10:10.24,Default,,0,0,0,,Иә, ол тозақтан да ыстық!
Dialogue: 0,1:10:13.08,1:10:16.79,Default,,0,0,0,,Рин, Хару. Балалар, бүгін кешке сендерді көргенімізге қуаныштымыз.
Dialogue: 0,1:10:16.87,1:10:19.00,Default,,0,0,0,,Бізге кез келген уақытта қайтып келіңіз!
Dialogue: 0,1:10:19.08,1:10:21.75,Default,,0,0,0,,-(Рин) Хабарласып тұрамын! - Жақсы тұрыңыз!
Dialogue: 0,1:10:21.84,1:10:24.22,Default,,0,0,0,,Рахмет! Рассел, Лори.
Dialogue: 0,1:10:24.30,1:10:25.22,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,1:10:30.55,1:10:32.85,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,1:10:32.93,1:10:35.23,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,1:10:35.31,1:10:37.73,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,1:10:53.45,1:10:54.87,Default,,0,0,0,,Иә!?
Dialogue: 0,1:10:56.00,1:10:59.04,Default,,0,0,0,,Бұл мүмкін емес... бұл!
Dialogue: 0,1:10:59.12,1:11:02.04,Default,,0,0,0,,Мұндай жағдай Австралияда бола ма?
Dialogue: 0,1:11:02.13,1:11:03.42,Default,,0,0,0,,Эй!
Dialogue: 0,1:11:03.92,1:11:07.51,Default,,0,0,0,,Бұл сенің кінәң шығар. Есімің қызға ұқсайды...
Dialogue: 0,1:11:07.59,1:11:09.47,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,1:11:09.55,1:11:11.64,Default,,0,0,0,,Иә? Бұл сенсің!
Dialogue: 0,1:11:11.72,1:11:13.51,Default,,0,0,0,,- (Харука) Бұл сенсің - (Рин) Бұл сенсің!
Dialogue: 0,1:11:13.60,1:11:15.68,Default,,0,0,0,,- (Харука) Бұл сенсің! -(Рин) Бұл сен...
Dialogue: 0,1:11:15.77,1:11:18.19,Default,,0,0,0,,Қазір мұндай нәрсені жасайтын уақыт емес.
Dialogue: 0,1:11:18.27,1:11:20.48,Default,,0,0,0,,Мен қабылдау бөлмесіне барамын!
Dialogue: 0,1:11:25.48,1:11:26.78,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:11:26.86,1:11:28.28,Default,,0,0,0,,Бірге жатсақ, бірге боламыз.
Dialogue: 0,1:11:28.36,1:11:30.36,Default,,0,0,0,,Тез ұйықтаңыз.
Dialogue: 0,1:11:30.45,1:11:31.28,Default,,0,0,0,,Уф
Dialogue: 0,1:11:31.37,1:11:33.45,Default,,0,0,0,,Бұл да рас.
Dialogue: 0,1:11:45.55,1:11:47.46,Default,,0,0,0,,Сәлем Хару
Dialogue: 0,1:11:48.97,1:11:52.26,Default,,0,0,0,,Мен саған әрқашан сүйсінемін деп айтпадым ба?
Dialogue: 0,1:11:53.89,1:11:56.10,Default,,0,0,0,,Есіңде жоқ шығар, бірақ мен олай ойламаймын.
Dialogue: 0,1:11:56.89,1:11:58.85,Default,,0,0,0,,Әлі есімде
Dialogue: 0,1:11:58.93,1:12:01.31,Default,,0,0,0,,Мен Харумен алғаш танысқанда
Dialogue: 0,1:12:03.02,1:12:06.82,Default,,0,0,0,,Шынымды айтсам, мен ешқашан басқа біреуден жеңілемін деп ойламадым.
Dialogue: 0,1:12:09.82,1:12:13.28,Default,,0,0,0,,Бірақ менің барлық өкінішім әп-сәтте жоғалып кетті.
Dialogue: 0,1:12:13.91,1:12:16.08,Default,,0,0,0,,«Менен жақсы адамдар бар».
Dialogue: 0,1:12:16.16,1:12:18.58,Default,,0,0,0,,«Мен де ол сияқты жүзуім керек»
Dialogue: 0,1:12:19.37,1:12:23.17,Default,,0,0,0,,Сондықтан менің алдымда жүзе беруіңді қалаймын.
Dialogue: 0,1:12:23.25,1:12:26.05,Default,,0,0,0,,Мен баратын жерде әрқашан сонда болуың керек.
Dialogue: 0,1:12:26.92,1:12:29.05,Default,,0,0,0,,Әйтпесе, бәсекелестік жоқ, солай ма?
Dialogue: 0,1:12:31.01,1:12:34.09,Default,,0,0,0,,Сол турнир менің де есімде.
Dialogue: 0,1:12:37.06,1:12:39.81,Default,,0,0,0,,Көктемгі кездесуде еркін жүзген коньки есіңде ме?
Dialogue: 0,1:12:40.73,1:12:43.19,Default,,0,0,0,,Тең есеппен рекорд жаңартқан жарыс.
Dialogue: 0,1:12:43.98,1:12:44.81,Default,,0,0,0,,О
Dialogue: 0,1:12:46.36,1:12:48.15,Default,,0,0,0,,Мен ол кезде болдым
Dialogue: 0,1:12:48.23,1:12:49.82,Default,,0,0,0,,Мен сені сынап көрдім
Dialogue: 0,1:12:50.86,1:12:53.20,Default,,0,0,0,,Бұл жігіт шынымен
Dialogue: 0,1:12:53.28,1:12:55.41,Default,,0,0,0,,Осымен аяқталады ма?
Dialogue: 0,1:12:56.49,1:12:57.79,Default,,0,0,0,,Содан кейін
Dialogue: 0,1:12:57.87,1:13:00.62,Default,,0,0,0,,Сенің қатысуың мені артымнан қуып жетті
Dialogue: 0,1:13:00.70,1:13:02.71,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,1:13:02.79,1:13:06.46,Default,,0,0,0,,«Ақырында, бұл жігіт менімен бір әлемге барады».
Dialogue: 0,1:13:07.75,1:13:08.88,Default,,0,0,0,,Сәлем Хару
Dialogue: 0,1:13:08.96,1:13:12.05,Default,,0,0,0,,Сол кезде ештеңе сезбедіңіз бе?
Dialogue: 0,1:13:35.41,1:13:39.24,Default,,0,0,0,,Арманыңды таба алмаймын дедің.
Dialogue: 0,1:13:39.33,1:13:41.66,Default,,0,0,0,,Бірақ егер ол табылса
Dialogue: 0,1:13:41.75,1:13:42.87,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:14:16.03,1:14:17.32,Default,,0,0,0,,Біз келдік
Dialogue: 0,1:14:18.03,1:14:21.95,Default,,0,0,0,,- (Алыс) Бұл қайда? -(Рин) Бұл жүзуден әлем чемпионатының өтетін орны.
Dialogue: 0,1:14:22.74,1:14:23.66,Default,,0,0,0,,Кеттік
Dialogue: 0,1:14:31.80,1:14:33.46,Default,,0,0,0,,Хал, осылай.
Dialogue: 0,1:14:36.88,1:14:41.05,Default,,0,0,0,,Мұнда әлемнің ең атақты спортшылары бақ сынады.
Dialogue: 0,1:14:42.14,1:14:44.22,Default,,0,0,0,,Мен саған мына жігітті көрсеткім келді.
Dialogue: 0,1:14:47.10,1:14:48.31,Default,,0,0,0,,Жүзейік, Хару
Dialogue: 0,1:14:48.40,1:14:50.23,Default,,0,0,0,,Сіз жүзе аласыз ба?
Dialogue: 0,1:14:50.31,1:14:53.23,Default,,0,0,0,,Әрине, кез келген адам жүзе алады.
Dialogue: 0,1:14:53.32,1:14:55.32,Default,,0,0,0,,Менде купальник жоқ
Dialogue: 0,1:14:55.40,1:14:57.82,Default,,0,0,0,,Мен мұны саған беремін.
Dialogue: 0,1:15:06.04,1:15:06.87,Default,,0,0,0,,О
Dialogue: 0,1:15:07.62,1:15:09.71,Default,,0,0,0,,Бұл ұлттық құрама!
Dialogue: 0,1:15:09.79,1:15:13.42,Default,,0,0,0,,-(Харука) Ұлттық құрама... -(Рин) Олар оны жаттығу үшін пайдаланып жатыр.
Dialogue: 0,1:15:13.50,1:15:15.80,Default,,0,0,0,,Мұндай жерде суға түсуге болады ма?
Dialogue: 0,1:15:15.88,1:15:17.97,Default,,0,0,0,,Ешкім жүзбейді
Dialogue: 0,1:15:18.68,1:15:21.39,Default,,0,0,0,,Мұнда демалыс бассейні де бар.
Dialogue: 0,1:15:21.47,1:15:25.47,Default,,0,0,0,,Ұлттық құраманың жанында жүзуге батылы жетпеген адам келмейді.
Dialogue: 0,1:15:26.35,1:15:27.56,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:15:39.78,1:15:43.16,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:15:48.58,1:15:49.41,Default,,0,0,0,,Сәлем, жолдасым!
Dialogue: 0,1:15:51.75,1:15:52.92,Default,,0,0,0,,Қалай болып жатыр?
Dialogue: 0,1:15:53.59,1:15:55.59,Default,,0,0,0,,Жер
Dialogue: 0,1:15:55.67,1:16:00.88,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:16:13.23,1:16:14.82,Default,,0,0,0,,Менің жүзгім келеді
Dialogue: 0,1:16:28.37,1:16:29.62,Default,,0,0,0,,Осы жерде
Dialogue: 0,1:16:29.71,1:16:31.37,Default,,0,0,0,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,1:16:33.25,1:16:34.79,Default,,0,0,0,,Мен жүзуді жалғастырғым келеді
Dialogue: 0,1:16:39.76,1:16:40.63,Default,,0,0,0,,Корпус
Dialogue: 0,1:16:41.76,1:16:43.39,Default,,0,0,0,,Біз де барайық
Dialogue: 0,1:16:49.27,1:16:50.27,Default,,0,0,0,,О
Dialogue: 0,1:16:57.32,1:16:58.78,Default,,0,0,0,,Хару! Рин!
Dialogue: 0,1:16:58.86,1:17:00.11,Default,,0,0,0,,Макото!
Dialogue: 0,1:17:00.74,1:17:02.65,Default,,0,0,0,,Сіз мені алып кетуге келдіңіз бе?
Dialogue: 0,1:17:03.24,1:17:04.78,Default,,0,0,0,,Екеуіңізге де еңбектеріңіз үшін рахмет.
Dialogue: 0,1:17:08.91,1:17:09.75,Default,,0,0,0,,Корпус
Dialogue: 0,1:17:12.46,1:17:13.79,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:17:19.84,1:17:21.17,Default,,0,0,0,,Дәл қазір...
Dialogue: 0,1:17:21.26,1:17:22.42,Default,,0,0,0,,Иә
Dialogue: 0,1:17:23.63,1:17:24.76,Default,,0,0,0,,Кеттік
Dialogue: 0,1:17:24.84,1:17:26.30,Default,,0,0,0,,Барлығы күтіп отыр
Dialogue: 0,1:17:31.14,1:17:34.14,Default,,0,0,0,,- (Рей) Пуха - (Нагиса) Пухаха...
Dialogue: 0,1:17:34.23,1:17:36.23,Default,,0,0,0,,Сіз бұл бассейнге ақырында үйреніп жатырсыз.
Dialogue: 0,1:17:36.31,1:17:37.15,Default,,0,0,0,,Иә
Dialogue: 0,1:17:37.23,1:17:41.86,Default,,0,0,0,,Келесі күні спектакль көрсету үшін көрермендер орындары толады.
Dialogue: 0,1:17:41.94,1:17:43.95,Default,,0,0,0,,Сіз қобалжыдыңыз ба? Рей-чан
Dialogue: 0,1:17:44.03,1:17:47.41,Default,,0,0,0,,Жоқ, мен осы күні көп еңбек еттім.
Dialogue: 0,1:17:47.49,1:17:49.74,Default,,0,0,0,,Бұл қобалжыйтын уақыт емес.
Dialogue: 0,1:17:49.83,1:17:52.66,Default,,0,0,0,,Жүрегіңде шаш өсті ме?
Dialogue: 0,1:17:52.75,1:17:54.41,Default,,0,0,0,,Ол өспейді.
Dialogue: 0,1:17:54.50,1:17:58.00,Default,,0,0,0,,Аа, Макото-сенпай мен басқалардың қайтып келетін уақыты аз қалды.
Dialogue: 0,1:17:58.09,1:18:00.67,Default,,0,0,0,,Бұл уақыт әлдеқашан ба? Тезірек барайық!
Dialogue: 0,1:18:00.75,1:18:01.92,Default,,0,0,0,,Рей-чан?
Dialogue: 0,1:18:02.01,1:18:03.84,Default,,0,0,0,,Харука Сенпай
Dialogue: 0,1:18:03.92,1:18:06.89,Default,,0,0,0,,Сіз сау болып ораласыз ба?
Dialogue: 0,1:18:06.97,1:18:07.89,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:18:07.97,1:18:10.22,Default,,0,0,0,,Мен сенің сауығып қайтатыныңа сенімдімін.
Dialogue: 0,1:18:10.31,1:18:11.60,Default,,0,0,0,,Кеттік
Dialogue: 0,1:18:13.10,1:18:14.02,Default,,0,0,0,,Иә!
Dialogue: 0,1:18:15.31,1:18:18.15,Default,,0,0,0,,Барлығыңыз, бүгін өтетін жерге кіріңіздер.
Dialogue: 0,1:18:18.23,1:18:19.86,Default,,0,0,0,,Матчқа дайындық
Dialogue: 0,1:18:24.40,1:18:25.40,Default,,0,0,0,,Иә
Dialogue: 0,1:18:26.86,1:18:29.41,Default,,0,0,0,,Мен өз командама қосыламын.
Dialogue: 0,1:18:29.49,1:18:30.49,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,1:18:32.20,1:18:33.37,Default,,0,0,0,,Рин
Dialogue: 0,1:18:34.37,1:18:35.75,Default,,0,0,0,,Рақмет.
Dialogue: 0,1:18:39.04,1:18:40.29,Default,,0,0,0,,О!
Dialogue: 0,1:18:42.75,1:18:44.34,Default,,0,0,0,,Эй!
Dialogue: 0,1:18:44.97,1:18:46.26,Default,,0,0,0,,Хару-чан!
Dialogue: 0,1:18:46.34,1:18:48.14,Default,,0,0,0,,Харука Сенпай!
Dialogue: 0,1:18:48.22,1:18:49.64,Default,,0,0,0,,Рей Нагиса
Dialogue: 0,1:18:49.72,1:18:54.27,Default,,0,0,0,,- (Нагиса) Қош келдіңіз, Хару-чан - (Рей) Үйге аман-есен оралғаныңызға рахмет.
Dialogue: 0,1:18:54.35,1:18:57.19,Default,,0,0,0,,Мен де уайымдадым.
Dialogue: 0,1:18:57.27,1:18:58.31,Default,,0,0,0,,Рей-чан ше...
Dialogue: 0,1:18:58.40,1:19:00.06,Default,,0,0,0,,Не... Нағиса-күн!
Dialogue: 0,1:19:00.86,1:19:02.90,Default,,0,0,0,,Сені уайымдағаныма мен кінәлімін.
Dialogue: 0,1:19:02.98,1:19:05.40,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,1:19:05.49,1:19:07.78,Default,,0,0,0,,Одан да ертеңгі ойынға
Dialogue: 0,1:19:07.86,1:19:09.87,Default,,0,0,0,,Денеңізді жайлап демалыңыз.
Dialogue: 0,1:19:09.95,1:19:12.74,Default,,0,0,0,,Осыдан кейін бұл нақты өндіріс үшін соңғы түзету.
Dialogue: 0,1:19:12.83,1:19:14.12,Default,,0,0,0,,Иә!
Dialogue: 0,1:19:14.20,1:19:15.20,Default,,0,0,0,,Макото
Dialogue: 0,1:19:15.29,1:19:17.00,Default,,0,0,0,,Рей Нагиса
Dialogue: 0,1:19:17.71,1:19:18.79,Default,,0,0,0,,Сізге
Dialogue: 0,1:19:19.88,1:19:21.63,Default,,0,0,0,,Менің саған айтар сөзім бар.
Dialogue: 0,1:19:24.25,1:19:25.55,Default,,0,0,0,,Сен оны түсіндің ғой... иә?
Dialogue: 0,1:19:25.63,1:19:29.01,Default,,0,0,0,,Уақыт немесе жеңу немесе жеңіліс туралы алаңдамаңыз.
Dialogue: 0,1:19:29.09,1:19:30.68,Default,,0,0,0,,Мен жүзгім келгендіктен жүздім.
Dialogue: 0,1:19:31.85,1:19:35.35,Default,,0,0,0,,Егер мен соған назар аударсам, мен жүзудің мағынасын жоғалтамын.
Dialogue: 0,1:19:35.89,1:19:37.06,Default,,0,0,0,,Мен осылай ойладым
Dialogue: 0,1:19:37.93,1:19:40.19,Default,,0,0,0,,Рин әлемді мақсат етуді армандайды
Dialogue: 0,1:19:40.77,1:19:44.32,Default,,0,0,0,,Мен сол арман үшін бәсекеге қабілетті жүзу әлеміне секірейін деп тұрмын.
Dialogue: 0,1:19:44.94,1:19:46.28,Default,,0,0,0,,Сонда мен ше?
Dialogue: 0,1:19:46.36,1:19:48.45,Default,,0,0,0,,Тек «жүзуге» деген ұмтылыс
Dialogue: 0,1:19:48.53,1:19:50.91,Default,,0,0,0,,Сіз бәсекеге қабілетті жүзу әлеміне барасыз ба?
Dialogue: 0,1:19:51.53,1:19:53.53,Default,,0,0,0,,Жеңіс пен жеңіліс әлеміне...
Dialogue: 0,1:19:53.62,1:19:55.66,Default,,0,0,0,,Иә, бұл Каваджири.
Dialogue: 0,1:19:55.74,1:19:57.62,Default,,0,0,0,,Мен Риннен өзгешемін
Dialogue: 0,1:19:58.79,1:20:01.96,Default,,0,0,0,,Менде ол сияқты күшті сезім жоқ.
Dialogue: 0,1:20:04.00,1:20:05.42,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:20:05.92,1:20:09.34,Default,,0,0,0,,Мен сенің сұрағаныңа да жауап бере алмадым.
Dialogue: 0,1:20:09.42,1:20:11.13,Default,,0,0,0,,Қандай арман
Dialogue: 0,1:20:11.22,1:20:13.72,Default,,0,0,0,,Мен оны іздеп табамын деп ойламадым.
Dialogue: 0,1:20:15.35,1:20:18.06,Default,,0,0,0,,Бірақ Рин мені алып кетті
Dialogue: 0,1:20:18.14,1:20:20.19,Default,,0,0,0,,Әртүрлі көріністерді көрсету
Dialogue: 0,1:20:21.23,1:20:22.81,Default,,0,0,0,,Әлемнің қаншалықты үлкен екенін білу...
Dialogue: 0,1:20:23.65,1:20:26.32,Default,,0,0,0,,Оны тапсаң не істейсің?
Dialogue: 0,1:20:27.61,1:20:30.74,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,1:20:30.82,1:20:32.36,Default,,0,0,0,,Менің жүзгім келеді
Dialogue: 0,1:20:33.07,1:20:34.45,Default,,0,0,0,,Сол дүниеде...
Dialogue: 0,1:20:37.79,1:20:39.37,Default,,0,0,0,,Мен жүзуді жалғастырғым келеді
Dialogue: 0,1:20:39.45,1:20:41.25,Default,,0,0,0,,Сонымен, I
Dialogue: 0,1:20:41.33,1:20:43.83,Default,,0,0,0,,Уақытқа, жеңіске және жеңіліске назар аударыңыз
Dialogue: 0,1:20:44.75,1:20:46.55,Default,,0,0,0,,Менің армандарым үшін
Dialogue: 0,1:20:48.63,1:20:50.59,Default,,0,0,0,,Өйткені, бұл сапар
Dialogue: 0,1:20:50.67,1:20:52.80,Default,,0,0,0,,Бұл Хал үшін ерекше сапар болса керек.
Dialogue: 0,1:20:52.88,1:20:54.64,Default,,0,0,0,,Саған жақсы, Хару-чан.
Dialogue: 0,1:20:54.72,1:20:57.68,Default,,0,0,0,,Егер бұл Харука Сенпай тапқан арман болса,
Dialogue: 0,1:20:57.76,1:21:01.02,Default,,0,0,0,,Біз сені бар күшімізбен ғана қолдаймыз!
Dialogue: 0,1:21:02.02,1:21:03.14,Default,,0,0,0,,Рахмет
Dialogue: 0,1:21:06.15,1:21:08.19,Default,,0,0,0,,Ұлттық турнир күткендей~
Dialogue: 0,1:21:08.28,1:21:10.03,Default,,0,0,0,,Барлығы жылдам
Dialogue: 0,1:21:10.61,1:21:11.82,Default,,0,0,0,,Макото
Dialogue: 0,1:21:13.45,1:21:16.20,Default,,0,0,0,,Мен... өткен күні саған
Dialogue: 0,1:21:17.20,1:21:18.91,Default,,0,0,0,,Мен қорқынышты нәрсе айттым...
Dialogue: 0,1:21:21.58,1:21:22.91,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:21:24.04,1:21:25.13,Default,,0,0,0,,Корпус…
Dialogue: 0,1:21:27.13,1:21:28.38,Default,,0,0,0,,Жоқ
Dialogue: 0,1:21:29.50,1:21:31.46,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:21:31.55,1:21:34.30,Default,,0,0,0,,Маған мансап жолым туралы айту қиын...
Dialogue: 0,1:21:35.55,1:21:40.10,Default,,0,0,0,,Мен бәсекеге қабілетті жүзу әлеміне қатыспаймын деп ойладым.
Dialogue: 0,1:21:40.18,1:21:42.77,Default,,0,0,0,,Жарыс әлемі маған жарамайды.
Dialogue: 0,1:21:43.44,1:21:45.10,Default,,0,0,0,,Сонымен
Dialogue: 0,1:21:45.19,1:21:48.40,Default,,0,0,0,,Мен жергілікті университетке барамын деп ойладым.
Dialogue: 0,1:21:49.02,1:21:51.32,Default,,0,0,0,,Менің басқа істегім келген нәрсем жоқ еді...
Dialogue: 0,1:21:53.03,1:21:57.49,Default,,0,0,0,,Сол кезде мен жаттықтырушы Сасабеге көмектесемін деп шештім.
Dialogue: 0,1:21:58.28,1:22:01.08,Default,,0,0,0,,Бастапқыда мен мұны тек көмектесу деп ойладым.
Dialogue: 0,1:22:01.66,1:22:04.25,Default,,0,0,0,,Балаларды жүзуге үйрету
Dialogue: 0,1:22:04.33,1:22:06.12,Default,,0,0,0,,Барған сайын қызық болып барады
Dialogue: 0,1:22:06.21,1:22:08.29,Default,,0,0,0,,Сол жерде мен Хаятомен таныстым.
Dialogue: 0,1:22:08.84,1:22:11.59,Default,,0,0,0,,Мен оған жүзуге көмектескім келді.
Dialogue: 0,1:22:12.13,1:22:16.51,Default,,0,0,0,,Мен абдырап қалғанда Хару маған кеңес берді.
Dialogue: 0,1:22:16.59,1:22:19.76,Default,,0,0,0,,-(Харука) Мен емес... -(Макото) Хехехе
Dialogue: 0,1:22:19.85,1:22:21.85,Default,,0,0,0,,Хаято арқамен жүзе алған кезде
Dialogue: 0,1:22:22.52,1:22:24.39,Default,,0,0,0,,«Мен енді жүзуден қорықпаймын»
Dialogue: 0,1:22:24.48,1:22:26.98,Default,,0,0,0,,Ол «қызықты болды» деді
Dialogue: 0,1:22:27.06,1:22:29.94,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,1:22:30.98,1:22:32.48,Default,,0,0,0,,Сонымен, I
Dialogue: 0,1:22:32.57,1:22:35.99,Default,,0,0,0,,Бұл туралы балалардың көбірек білуін қаладым.
Dialogue: 0,1:22:36.07,1:22:37.74,Default,,0,0,0,,Жүзуден ләззат алу
Dialogue: 0,1:22:40.74,1:22:44.50,Default,,0,0,0,,Мен жүзуді үйрететін адам болғым келеді.
Dialogue: 0,1:22:44.58,1:22:47.79,Default,,0,0,0,,Осы мақсатпен Токиодағы университетке оқуға түстім.
Dialogue: 0,1:22:47.87,1:22:51.17,Default,,0,0,0,,Бұл мен тапқан арманым
Dialogue: 0,1:22:53.46,1:22:54.30,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:22:55.09,1:22:57.30,Default,,0,0,0,,Мен сенің жақсы болатыныңа сенімдімін.
Dialogue: 0,1:22:58.13,1:22:59.43,Default,,0,0,0,,Рахмет
Dialogue: 0,1:22:59.51,1:23:03.60,Default,,0,0,0,,Бірақ бұдан былай оқу қиын болады...
Dialogue: 0,1:23:04.10,1:23:06.48,Default,,0,0,0,,- (Харука) Дұрыс - (Макото) Хахахаха
Dialogue: 0,1:23:18.07,1:23:21.62,Default,,0,0,0,,Сіз бұрын ешқашан көрмеген табиғатты көре аласыз ба?
Dialogue: 0,1:23:21.70,1:23:24.74,Default,,0,0,0,,Қараңдаршы, төртеуміз
Dialogue: 0,1:23:24.83,1:23:26.37,Default,,0,0,0,,Иә!
Dialogue: 0,1:23:26.45,1:23:27.75,Default,,0,0,0,,Кеттік
Dialogue: 0,1:23:27.83,1:23:31.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:23:31.79,1:23:34.34,Default,,0,0,0,,Уау... хахаха
Dialogue: 0,1:23:39.18,1:23:42.47,Default,,0,0,0,,Ерлер арасында 400 метрге жүгіру
Dialogue: 0,1:23:42.55,1:23:44.35,Default,,0,0,0,,Бір топ матч ойнайды.
Dialogue: 0,1:23:45.93,1:23:46.73,Default,,0,0,0,,
Dialogue: 0,1:23:46.73,1:23:50.10,Default,,0,0,0,,
Dialogue: 0,1:23:46.73,1:23:50.10,Default,,0,0,0,,- (Сасабе) Макото~! -(E) Макото Сенпай
Dialogue: 0,1:23:50.94,1:23:52.69,Default,,0,0,0,,
Dialogue: 0,1:23:53.61,1:23:55.19,Default,,0,0,0,,Жарайды
Dialogue: 0,1:23:56.82,1:23:58.86,Default,,0,0,0,,Айт!
Dialogue: 0,1:24:12.92,1:24:13.92,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:16.55,1:24:17.67,Default,,0,0,0,,Ха...
Dialogue: 0,1:24:20.05,1:24:21.55,Default,,0,0,0,,Бұл көрініс...
Dialogue: 0,1:24:22.59,1:24:24.64,Default,,0,0,0,,(Дельфин дыбысы)
Dialogue: 0,1:24:25.39,1:24:27.27,Default,,0,0,0,,Ахахаха
Dialogue: 0,1:24:36.48,1:24:37.69,Default,,0,0,0,,Нагиса!
Dialogue: 0,1:24:52.87,1:24:53.71,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:56.96,1:24:58.51,Default,,0,0,0,,Ахаха хехехе...
Dialogue: 0,1:25:04.51,1:25:05.47,Default,,0,0,0,,Уау...
Dialogue: 0,1:25:12.77,1:25:14.10,Default,,0,0,0,,Рей-чан!
Dialogue: 0,1:25:27.45,1:25:28.28,Default,,0,0,0,,Ах
Dialogue: 0,1:25:31.25,1:25:32.08,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:35.29,1:25:37.09,Default,,0,0,0,,Ах... хаха
Dialogue: 0,1:25:48.76,1:25:50.43,Default,,0,0,0,,Харука Сенпай!
Dialogue: 0,1:26:06.24,1:26:07.32,Default,,0,0,0,,Ха...
Dialogue: 0,1:26:15.75,1:26:16.58,Default,,0,0,0,,Корпус
Dialogue: 0,1:26:20.17,1:26:21.05,Default,,0,0,0,,Хару-чан
Dialogue: 0,1:26:21.13,1:26:22.67,Default,,0,0,0,,Харука Сенпай
Dialogue: 0,1:26:38.44,1:26:40.52,Default,,0,0,0,,- (Нагиса) Хару-чан! -(Рей) Харука Сенпай!
Dialogue: 0,1:26:38.44,1:26:40.52,Default,,0,0,0,,Хару!
Dialogue: 0,1:26:42.15,1:26:43.57,Default,,0,0,0,,- (E) Харука Сенпай! -(Сасабе) Харука!
Dialogue: 0,1:26:48.45,1:26:49.28,Default,,0,0,0,,Пуха!
Dialogue: 0,1:26:51.03,1:26:54.20,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,1:26:54.91,1:26:56.08,Default,,0,0,0,,- (Е) Мұғалім...! - (Сасабе) Ой!
Dialogue: 0,1:26:57.71,1:26:58.79,Default,,0,0,0,,Хаха
Dialogue: 0,1:27:02.30,1:27:05.63,Default,,0,0,0,,- (Нағиса) Уау! -(Рей) Уау!
Dialogue: 0,1:27:07.01,1:27:08.55,Default,,0,0,0,,Ахаха!
Dialogue: 0,1:27:08.64,1:27:10.26,Default,,0,0,0,,Қайда? Огимото-яда екен ғой.
Dialogue: 0,1:27:10.35,1:27:11.89,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,1:27:14.89,1:27:16.64,Default,,0,0,0,,Ахахаха
Dialogue: 0,1:27:16.73,1:27:20.40,Default,,0,0,0,,(4 адам жылап, күледі)
Dialogue: 0,1:27:29.95,1:27:31.95,Default,,0,0,0,,♪~
Dialogue: 0,1:28:01.69,1:28:03.77,Default,,0,0,0,,Бітті
Dialogue: 0,1:28:03.86,1:28:06.28,Default,,0,0,0,,Мен, бұл өте қызық болды.
Dialogue: 0,1:28:06.36,1:28:07.90,Default,,0,0,0,,баллоннан ауа ағады.
Dialogue: 0,1:28:08.49,1:28:11.53,Default,,0,0,0,,Сіздермен бірге осындай тамаша эстафетаны жүзіп өткеніме өте ризамын.
Dialogue: 0,1:28:11.61,1:28:12.66,Default,,0,0,0,,Мен мақтанамын
Dialogue: 0,1:28:13.32,1:28:14.78,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:28:14.87,1:28:17.37,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,1:28:17.45,1:28:20.16,Default,,0,0,0,,Бірақ бұл шынымен де соңы, солай емес пе?
Dialogue: 0,1:28:20.79,1:28:23.58,Default,,0,0,0,,Қарашы, Нағиса, сенің жүзің мұңайып тұр.
Dialogue: 0,1:28:23.67,1:28:25.84,Default,,0,0,0,,Бітіруге әлі уақыт бар.
Dialogue: 0,1:28:25.92,1:28:27.17,Default,,0,0,0,,Кешіріңіз, Мако-чан
Dialogue: 0,1:28:27.76,1:28:29.17,Default,,0,0,0,,Хи хи ахах...
Dialogue: 0,1:28:29.26,1:28:30.43,Default,,0,0,0,,Нағиса
Dialogue: 0,1:28:31.51,1:28:34.68,Default,,0,0,0,,Мені және Макотоны жүзу үйірмесіне шақырғаныңызға рахмет.
Dialogue: 0,1:28:35.26,1:28:36.56,Default,,0,0,0,,Рахмет
Dialogue: 0,1:28:36.64,1:28:37.56,Default,,0,0,0,,Иә!
Dialogue: 0,1:28:39.02,1:28:41.69,Default,,0,0,0,,Рей де осы уақытқа дейін үлкен жұмыс атқарды.
Dialogue: 0,1:28:41.77,1:28:43.06,Default,,0,0,0,,Харука Сенпай
Dialogue: 0,1:28:43.15,1:28:47.15,Default,,0,0,0,,Бұл аяқталса да, біз әрқашан дос боламыз.
Dialogue: 0,1:28:48.36,1:28:49.82,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,1:28:50.49,1:28:51.32,Default,,0,0,0,,Иә
Dialogue: 0,1:28:52.74,1:28:53.70,Default,,0,0,0,,Макото
Dialogue: 0,1:28:54.62,1:28:56.83,Default,,0,0,0,,Сіз бізді қолдадыңыз
Dialogue: 0,1:28:58.16,1:28:59.08,Default,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,1:29:00.87,1:29:01.71,Default,,0,0,0,,Иә
Dialogue: 0,1:29:11.55,1:29:12.84,Default,,0,0,0,,Ахахаха
Dialogue: 0,1:29:14.72,1:29:15.72,Default,,0,0,0,,- (Харука) Фуфу - (Рей) Фуфуфу
Dialogue: 0,1:29:19.81,1:29:21.98,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:29:22.56,1:29:25.27,Default,,0,0,0,,Уау, қара!
Dialogue: 0,1:29:25.35,1:29:28.36,Default,,0,0,0,,Уау! Қанаттарға ұқсайды!
Dialogue: 0,1:29:28.44,1:29:30.65,Default,,0,0,0,,- (Нағиса) Ахаха - (Рей) Әдемі
Dialogue: 0,1:29:30.74,1:29:32.90,Default,,0,0,0,,Ей, бәріміз суретке түсейік!
Dialogue: 0,1:29:32.99,1:29:36.12,Default,,0,0,0,,Мо~ Нагиса-кун, сен осылай жүгірсең қауіпті.
Dialogue: 0,1:29:36.20,1:29:37.99,Default,,0,0,0,,Жүріңдер, екеуің, асығыңдар~
Dialogue: 0,1:29:38.08,1:29:39.62,Default,,0,0,0,,Иә, Хару, біз де.
Dialogue: 0,1:32:32.08,1:32:34.09,Default,,0,0,0,,~♪
Dialogue: 0,1:32:38.76,1:32:39.92,Default,,0,0,0,,Пухат
Dialogue: 0,1:32:40.01,1:32:41.05,Default,,0,0,0,,Уф
Dialogue: 0,1:32:43.34,1:32:45.47,Default,,0,0,0,,Ол қайда?мұнда
Dialogue: 0,1:32:50.69,1:32:53.19,Default,,0,0,0,,Эй, Соускеге не болды?
Dialogue: 0,1:32:53.27,1:32:56.11,Default,,0,0,0,,Мен біраз бұрын сусын алуға бардым.
Dialogue: 0,1:32:56.19,1:32:59.49,Default,,0,0,0,,Сіз тағы да адасып қалдыңыз ба?
Dialogue: 0,1:32:59.57,1:33:01.74,Default,,0,0,0,,Мен сені іздеймін.
Dialogue: 0,1:33:04.95,1:33:06.24,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:08.08,1:33:11.25,Default,,0,0,0,,- (Жоғары сынып оқушысы А) Икуя, жүр! - (Мектеп оқушысы) Киришима!
Dialogue: 0,1:33:11.33,1:33:14.71,Default,,0,0,0,,- (Жоғары сынып оқушысы В) Икуя~! -(Жоғары сынып оқушысы С) Киришима~!
Dialogue: 0,1:33:23.47,1:33:26.35,Default,,0,0,0,,Не? Ол жігіт
Dialogue: 0,1:33:29.93,1:33:31.60,Default,,0,0,0,,(Жел қоңырауының дыбысы)
Dialogue: 0,1:33:34.15,1:33:36.23,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,1:33:36.31,1:33:39.36,Default,,0,0,0,,Уақытыңыз қалай өтті? Қабырғаға соғылып жатыр ма?
Dialogue: 0,1:33:39.44,1:33:40.61,Default,,0,0,0,,Жоқ
Dialogue: 0,1:33:40.69,1:33:42.99,Default,,0,0,0,,Жарайды, проблема жоқ.
Dialogue: 0,1:33:44.11,1:33:48.62,Default,,0,0,0,,Менің инсультім ұзарып барады, бұл шын мәнінде қорқынышты, өйткені мен қабырғаны сезе алмаймын.
Dialogue: 0,1:33:48.70,1:33:51.25,Default,,0,0,0,,Хаха, бұл сенімді.
Dialogue: 0,1:33:51.33,1:33:56.00,Default,,0,0,0,,Алайда Хигаши Судадағы Кинджо және Омори Гакуиндегі Терашима да
Dialogue: 0,1:33:56.08,1:33:57.71,Default,,0,0,0,,Уақыт азайып барады, солай емес пе?
Dialogue: 0,1:33:57.79,1:33:59.88,Default,,0,0,0,,Қиын шайқас болған жоқ па?
Dialogue: 0,1:34:00.42,1:34:02.13,Default,,0,0,0,,Жарайды, ағайын.
