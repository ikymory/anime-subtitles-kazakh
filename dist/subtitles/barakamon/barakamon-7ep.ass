Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Аудармасы: жоғары класты балық
Dialogue: 0,0:00:07.01,0:00:10.03,Default,,0,0,0,,Балық аулау
Dialogue: 0,0:00:11.01,0:00:13.01,Default,,0,0,0,,Мен сенбеймін, Ханда-кун.
Dialogue: 0,0:00:13.09,0:00:14.05,Default,,0,0,0,,Не
Dialogue: 0,0:00:14.09,0:00:18.02,Default,,0,0,0,,Аралға бес күн демалсам да.
Dialogue: 0,0:00:18.06,0:00:19.09,Default,,0,0,0,,Мен не істегенімді айтсам
Dialogue: 0,0:00:20.00,0:00:21.06,Default,,0,0,0,,Үйіңізді іздеңіз
Dialogue: 0,0:00:21.07,0:00:25.00,Default,,0,0,0,,Белгісіз адамдар ішуге мәжбүр еткен асқақтау
Dialogue: 0,0:00:28.00,0:00:30.00,Default,,0,0,0,,Демалысқа оралу Оған өзің кінәлісің.
Dialogue: 0,0:00:30.04,0:00:33.01,Default,,0,0,0,,Маған соңғы күн өте ұнады.
Dialogue: 0,0:00:33.01,0:00:34.03,Default,,0,0,0,,Мен мұнда балық аулауға келдім.
Dialogue: 0,0:00:34.05,0:00:35.09,Default,,0,0,0,,Білесің бе, кіші мектеп оқушысы
Dialogue: 0,0:00:36.04,0:00:40.06,Default,,0,0,0,,Мен ләззат алғым келеді десем, мен көрікті жерлерге барғым келеді. Мен түссіндім.
Dialogue: 0,0:00:40.07,0:00:44.00,Default,,0,0,0,,Мен туристік орындар туралы ештеңе білмеймін.
Dialogue: 0,0:00:44.01,0:00:45.07,Default,,0,0,0,,Мен де сенбеймін.
Dialogue: 0,0:00:45.09,0:00:49.02,Default,,0,0,0,,Мұғалімнің жазуын жақыннан көрудің сәті түсті.
Dialogue: 0,0:00:49.03,0:00:50.09,Default,,0,0,0,,Сыртта жүру мүмкін емес
Dialogue: 0,0:00:51.07,0:00:53.05,Default,,0,0,0,,Баратын жер үй ішінде ме?
Dialogue: 0,0:00:55.05,0:00:57.05,Default,,0,0,0,,Не болды, Хиро, өзіңді жақсы сезінбейсің бе?
Dialogue: 0,0:00:57.07,0:01:00.09,Default,,0,0,0,,Мен түні бойы оның каллиграфия теориясын тыңдауға мәжбүр болдым.
Dialogue: 0,0:01:01.01,0:01:05.09,Default,,0,0,0,,Мен оны бастауыш сыныпта оқып жүргенімде бастадым. 23 жасқа дейінгі балаларға арналған көрме бар, мен негізінен сондамын.
Dialogue: 0,0:01:04.03,0:01:05.09,Default,,0,0,0,,Мен мүлдем ұйықтамадым.
Dialogue: 0,0:01:06.05,0:01:07.07,Default,,0,0,0,,Мен өзімді жауып тастағым келеді
Dialogue: 0,0:01:10.00,0:01:11.04,Default,,0,0,0,,Иә, бұл қулық.
Dialogue: 0,0:01:11.08,0:01:13.05,Default,,0,0,0,,Сіз мұнымен не аласыз?
Dialogue: 0,0:01:13.08,0:01:14.02,Default,,0,0,0,,Скумбрия
Dialogue: 0,0:01:16.02,0:01:18.05,Default,,0,0,0,,Балық аулау тек жем беру ғана емес.
Dialogue: 0,0:01:18.05,0:01:20.01,Default,,0,0,0,,Мен де бірінші рет көрдім.
Dialogue: 0,0:01:20.08,0:01:22.03,Default,,0,0,0,,Мүмкін сіз балық аулауды бастаған шығарсыз?
Dialogue: 0,0:01:21.08,0:01:23.02,Default,,0,0,0,,Бұл бамбук
Dialogue: 0,0:01:23.07,0:01:24.05,Default,,0,0,0,,Кава мырза
Dialogue: 0,0:01:26.01,0:01:28.09,Default,,0,0,0,,Мені сол қаланың жігіттерімен қатарластырмаңыз.
Dialogue: 0,0:01:29.07,0:01:30.08,Default,,0,0,0,,Автобусты көздеңіз
Dialogue: 0,0:01:31.01,0:01:33.01,Default,,0,0,0,,Жоқ, ол біліммен скумбрия ұстай алмайсың.
Dialogue: 0,0:01:33.05,0:01:35.03,Default,,0,0,0,,Үлкен кіші ретінде де қызмет етеді.
Dialogue: 0,0:01:35.03,0:01:36.07,Default,,0,0,0,,Теңіз екі есе өзендей бола алмайды.
Dialogue: 0,0:01:39.01,0:01:40.09,Default,,0,0,0,,Оны алыңыз.
Dialogue: 0,0:01:43.03,0:01:43.53,Default,,0,0,0,,Болу
Dialogue: 0,0:01:45.00,0:01:47.06,Default,,0,0,0,,Мынаны тамақтандыр, мен оған тимеймін.
Dialogue: 0,0:01:48.00,0:01:48.50,Default,,0,0,0,,Ой
Dialogue: 0,0:01:49.01,0:01:53.04,Default,,0,0,0,,Инеге жем бар, ол жалған.
Dialogue: 0,0:01:52.02,0:01:56.06,Default,,0,0,0,,Бұл таяқшадан балықтың иісі шығады. Маған бұл енді ұнамайды.
Dialogue: 0,0:01:53.06,0:01:55.04,Default,,0,0,0,,Эй, мықтап ұста.
Dialogue: 0,0:01:55.05,0:01:57.05,Default,,0,0,0,,Тым жоғары, төмен түсіңіз
Dialogue: 0,0:01:56.06,0:01:58.05,Default,,0,0,0,,Толқып кетпеңіз
Dialogue: 0,0:01:58.05,0:02:00.04,Default,,0,0,0,,Жапон тілінде дұрыс сөйлеңіз
Dialogue: 0,0:01:59.04,0:02:02.06,Default,,0,0,0,,Қаланың адамдары бізбен балық аулауға келмеуі керек.
Dialogue: 0,0:02:03.01,0:02:04.05,Default,,0,0,0,,Онда мен жоғарыға көтерілемін.
Dialogue: 0,0:02:04.09,0:02:05.09,Default,,0,0,0,,Мива, қолыңнан келгеннің бәрін істе
Dialogue: 0,0:02:06.03,0:02:07.09,Default,,0,0,0,,Хиро-нидің қашқысы келеді
Dialogue: 0,0:02:09.00,0:02:10.05,Default,,0,0,0,,Мен теңіз адамымын
Dialogue: 0,0:02:11.01,0:02:13.01,Default,,0,0,0,,Скумбрия ондай деңгейде емес.
Dialogue: 0,0:02:13.09,0:02:16.06,Default,,0,0,0,,Жақсылыққа ұмтылыңыз
Dialogue: 0,0:02:17.02,0:02:19.04,Default,,0,0,0,,Хисаниво
Dialogue: 0,0:02:19.04,0:02:23.07,Default,,0,0,0,,Хисани o Хисани o Хисани o Хисани o
Dialogue: 0,0:02:22.04,0:02:24.02,Default,,0,0,0,,Бұл керемет Хиро-ни
Dialogue: 0,0:02:24.02,0:02:26.04,Default,,0,0,0,,Гибарейо, мен оны ұстап алсам ғой.
Dialogue: 0,0:02:26.09,0:02:28.02,Default,,0,0,0,,Хисаниво дегеніміз не?
Dialogue: 0,0:02:28.07,0:02:29.04,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:02:30.01,0:02:31.07,Default,,0,0,0,,Қандай бақытсыз балық
Dialogue: 0,0:02:41.03,0:02:43.06,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:02:44.04,0:02:46.08,Default,,0,0,0,,«Басқалардан ерекшелену» арқылы өзіңізді ерекшелендіріңіз
Dialogue: 0,0:02:47.01,0:02:49.03,Default,,0,0,0,,Дүкен журналының бұрышы
Dialogue: 0,0:02:49.08,0:02:52.07,Default,,0,0,0,,Мұқабаға кездейсоқ жазылған.
Dialogue: 0,0:02:52.08,0:02:55.01,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:02:55.05,0:02:58.01,Default,,0,0,0,,Кішкентай кезімде түк көрмедім.
Dialogue: 0,0:02:58.06,0:03:01.00,Default,,0,0,0,,Ұнамаса, ашулан.
Dialogue: 0,0:03:01.01,0:03:04.00,Default,,0,0,0,,Сізге ұнайтын нәрсені айтыңыз
Dialogue: 0,0:03:04.00,0:03:07.01,Default,,0,0,0,,Біз өзгереміз
Dialogue: 0,0:03:07.01,0:03:10.00,Default,,0,0,0,,Нені қорғағыңыз келетін өзгерістер
Dialogue: 0,0:03:10.00,0:03:12.07,Default,,0,0,0,,Түсінбеген қазынадан
Dialogue: 0,0:03:12.08,0:03:15.05,Default,,0,0,0,,Түсіну керек
Dialogue: 0,0:03:15.05,0:03:21.00,Default,,0,0,0,,Өскен сайын өкінесің.
Dialogue: 0,0:03:21.00,0:03:23.06,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:03:24.00,0:03:28.00,Default,,0,0,0,,Сіз бір нәрсе көре аласыз
Dialogue: 0,0:03:29.06,0:03:35.01,Default,,0,0,0,,Сондықтан мен өзіммін, ал сен өзіңсің.
Dialogue: 0,0:03:35.01,0:03:41.00,Default,,0,0,0,,Менің ойымша, бұл басынан бастап іздейтін нәрсе емес.
Dialogue: 0,0:03:41.00,0:03:46.03,Default,,0,0,0,,Мен сен емеспін, сен де мен емессің
Dialogue: 0,0:03:46.03,0:03:49.02,Default,,0,0,0,,Бір-бірінен өту, қол ұстасу
Dialogue: 0,0:03:49.02,0:03:53.08,Default,,0,0,0,,Махаббаттың туатын жері.
Dialogue: 0,0:03:55.00,0:03:57.07,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:03:57.08,0:04:03.08,Default,,0,0,0,,Мен оны өзгерте алмаймын, себебі бұл маңызды.
Dialogue: 0,0:04:04.02,0:04:07.06,Default,,0,0,0,,Өзгеретін өмір дұрыс
Dialogue: 0,0:04:16.09,0:04:19.00,Default,,0,0,0,,Алдымен жемді лақтыр.
Dialogue: 0,0:04:17.09,0:04:22.09,Default,,0,0,0,,: :& :&lucifer : :
Dialogue: 0,0:04:20.00,0:04:20.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:21.04,0:04:24.04,Default,,0,0,0,,Жем тараған жерге жіптерді тастаңыз
Dialogue: 0,0:04:25.07,0:04:28.09,Default,,0,0,0,,Таяқтың ұшы дірілдеп тұрса, осылай болады.
Dialogue: 0,0:04:29.09,0:04:31.01,Default,,0,0,0,,Мені тезірек үйге жіберші.
Dialogue: 0,0:04:31.02,0:04:33.03,Default,,0,0,0,,Әжем бүгін балық аулауға болатынын айтты.
Dialogue: 0,0:04:33.05,0:04:34.05,Default,,0,0,0,,Жарайды, балық аулауға барайық.
Dialogue: 0,0:04:34.06,0:04:36.03,Default,,0,0,0,,Жоспар Бүгін қуырылған скумбрия
Dialogue: 0,0:04:37.06,0:04:39.02,Default,,0,0,0,,Уау, бірдеңе келген сияқты.
Dialogue: 0,0:04:39.04,0:04:40.02,Default,,0,0,0,,Көтеру және көтеру
Dialogue: 0,0:04:42.00,0:04:45.01,Default,,0,0,0,,Мен екі балық ұстадым, бұл үлкен балық.
Dialogue: 0,0:04:48.03,0:04:48.53,Default,,0,0,0,,Болу
Dialogue: 0,0:04:49.00,0:04:49.50,Default,,0,0,0,,...
Dialogue: 0,0:04:50.00,0:04:51.06,Default,,0,0,0,,Әдетте керісінше орындаңыз.
Dialogue: 0,0:04:52.09,0:04:54.09,Default,,0,0,0,,Қарашы, Ханда, менде үшеу бар.
Dialogue: 0,0:04:55.02,0:04:56.05,Default,,0,0,0,,Не, мен ұтыла алмаймын
Dialogue: 0,0:04:56.08,0:04:57.08,Default,,0,0,0,,Менікі де келді.
Dialogue: 0,0:04:58.07,0:05:00.06,Default,,0,0,0,,Күшті Қандай күшті тарту.
Dialogue: 0,0:05:00.06,0:05:01.09,Default,,0,0,0,,Ол үлкен адам болуы керек.
Dialogue: 0,0:05:02.01,0:05:05.02,Default,,0,0,0,,Мен каллиграфияда ғана емес, балық аулауда да данышпанмын.
Dialogue: 0,0:05:05.04,0:05:08.05,Default,,0,0,0,,Қараңдар, ақымақтар, мен сендерге дәреже айырмашылығын көрсетемін.
Dialogue: 0,0:05:08.06,0:05:09.09,Default,,0,0,0,,Ян
Dialogue: 0,0:05:12.01,0:05:12.51,Default,,0,0,0,,Рапидтер
Dialogue: 0,0:05:20.04,0:05:23.05,Default,,0,0,0,,Чикюба Цури Агучи Күтілгендей
Dialogue: 0,0:05:24.07,0:05:26.08,Default,,0,0,0,,Амама құлады Ой, сен неткен ақымақсың.
Dialogue: 0,0:05:28.08,0:05:30.02,Default,,0,0,0,,Жерленген
Dialogue: 0,0:05:38.03,0:05:39.01,Default,,0,0,0,,Қорғалған
Dialogue: 0,0:05:39.09,0:05:41.07,Default,,0,0,0,,Хина, қолыңды шығар
Dialogue: 0,0:05:41.07,0:05:42.02,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:05:42.04,0:05:43.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:43.06,0:05:48.01,Default,,0,0,0,,Жоқ, жоқ, мен тәтті бұршақты шайнап жатырмын.
Dialogue: 0,0:05:52.08,0:05:57.03,Default,,0,0,0,,Мен енді барғым келмейді. Сасық, балық ұстай алмаймын, ыстық. Мен үйге барғым келеді.
Dialogue: 0,0:05:57.03,0:06:00.01,Default,,0,0,0,,Сіз үлкен аулап алсаңыз да, қазір үйге қайтпайсыз.
Dialogue: 0,0:06:00.03,0:06:03.05,Default,,0,0,0,,Мен мұғаліммен бірге жазғым келеді.
Dialogue: 0,0:06:02.07,0:06:04.02,Default,,0,0,0,,Чокчууи
Dialogue: 0,0:06:04.03,0:06:08.06,Default,,0,0,0,,Мұндай қосымша әрекетті тіпті мұғалім де ұнатпайды. Үйге қайтайық.
Dialogue: 0,0:06:08.07,0:06:11.04,Default,,0,0,0,,Жоқ, мен сенімен жаза алмаймын.
Dialogue: 0,0:06:11.06,0:06:14.00,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:06:14.02,0:06:16.03,Default,,0,0,0,,Неге мені тағы да жаман дейсің?
Dialogue: 0,0:06:18.00,0:06:20.00,Default,,0,0,0,,Қосуке, сен солай айттың ба?
Dialogue: 0,0:06:20.08,0:06:24.09,Default,,0,0,0,,Өйткені бұл шындық.
Dialogue: 0,0:06:28.01,0:06:31.04,Default,,0,0,0,,Сіз бәрін тек өз көзқарасыңыздан көре алмайсыз ба?
Dialogue: 0,0:06:31.08,0:06:33.08,Default,,0,0,0,,Сол себепті сен құлдырайсың.
Dialogue: 0,0:06:34.05,0:06:37.01,Default,,0,0,0,,Сіз құлдырау туралы жаза алмайсыз ба?
Dialogue: 0,0:06:37.04,0:06:40.00,Default,,0,0,0,,Өткен күні қолжазбаңызға қараған соң.
Dialogue: 0,0:06:40.05,0:06:45.00,Default,,0,0,0,,Сіз дәнекерлеуде жаман болған жоқсыз. Жаман болсаң, екінші орын да, жүлде де алмайсың.
Dialogue: 0,0:06:45.08,0:06:48.05,Default,,0,0,0,,Осы уақытқа дейін Қосуке сіздің қолжазбаңызды ескеріп жазып келген.
Dialogue: 0,0:06:49.01,0:06:50.09,Default,,0,0,0,,Осылайша сіздің жазуыңыз өзгерді
Dialogue: 0,0:06:51.04,0:06:53.09,Default,,0,0,0,,Менің ойымша, сізде үлгі алатын ешкім болмағандықтан уайымдаған боларсыз.
Dialogue: 0,0:06:54.08,0:06:55.08,Default,,0,0,0,,Оларға қараңыз.
Dialogue: 0,0:06:56.03,0:06:57.07,Default,,0,0,0,,Менің айтқым келгені осы.
Dialogue: 0,0:06:58.00,0:06:59.05,Default,,0,0,0,,Не, кенеттен?
Dialogue: 0,0:07:00.00,0:07:02.03,Default,,0,0,0,,Балалар үлкендерге еліктейді.
Dialogue: 0,0:07:03.00,0:07:05.05,Default,,0,0,0,,Қосуке жазған Ханданы көрдіңіз бе?
Dialogue: 0,0:07:06.00,0:07:08.00,Default,,0,0,0,,Жоқ, мен оны көрмеймін.
Dialogue: 0,0:07:08.01,0:07:08.51,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:07:09.05,0:07:12.02,Default,,0,0,0,,Оның қолжазбасы дәл сенікі сияқты.
Dialogue: 0,0:07:12.09,0:07:14.08,Default,,0,0,0,,Ханда дәл әкемнің жазуына ұқсайды.
Dialogue: 0,0:07:15.03,0:07:17.07,Default,,0,0,0,,Екеуі де негіздерге адал.
Dialogue: 0,0:07:18.02,0:07:21.04,Default,,0,0,0,,Сондықтан мен бірінші орынды жеңіп алдым, сондықтан негізгілер ең жақсы.
Dialogue: 0,0:07:21.06,0:07:24.00,Default,,0,0,0,,Әкемді жоққа шығарып тұрсың ба?
Dialogue: 0,0:07:25.07,0:07:31.07,Default,,0,0,0,,Жастардың рөлі – сәтсіздіктерден қорықпай жаңа белестерді бағындыру.
Dialogue: 0,0:07:32.03,0:07:33.03,Default,,0,0,0,,Директор…
Dialogue: 0,0:07:33.03,0:07:35.05,Default,,0,0,0,,Жазылғаннан гөрі есте қалатындай болыңыз
Dialogue: 0,0:07:35.07,0:07:37.07,Default,,0,0,0,,Ойында жеңілу және ойында жеңіске жету
Dialogue: 0,0:07:37.07,0:07:39.06,Default,,0,0,0,,Бірінші нөмірден гөрі бір ғана
Dialogue: 0,0:07:39.09,0:07:42.00,Default,,0,0,0,,Марапаттаудан гөрі не жақсы сатылады
Dialogue: 0,0:07:42.00,0:07:44.00,Default,,0,0,0,,Сайып келгенде, бұл сіздің қалауыңыз.
Dialogue: 0,0:07:44.00,0:07:46.02,Default,,0,0,0,,Маған ақша беріңіз
Dialogue: 0,0:07:46.02,0:07:48.00,Default,,0,0,0,,Ол қабылданды.
Dialogue: 0,0:07:48.04,0:07:49.04,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:07:50.01,0:07:51.07,Default,,0,0,0,,Мен оны Мива-ниден үйрендім.
Dialogue: 0,0:07:52.02,0:07:53.02,Default,,0,0,0,,Мұны пайдаланыңыз
Dialogue: 0,0:07:54.05,0:07:55.08,Default,,0,0,0,,Хина оны байлады ма?
Dialogue: 0,0:07:56.07,0:07:58.02,Default,,0,0,0,,Сенсей наруноны да пайдаланады
Dialogue: 0,0:07:58.07,0:07:59.07,Default,,0,0,0,,Сіз де жасадыңыз ба?
Dialogue: 0,0:08:00.00,0:08:02.02,Default,,0,0,0,,Бұл өте ультра
Dialogue: 0,0:08:02.05,0:08:03.08,Default,,0,0,0,,Балықты оңай ұстайтындар
Dialogue: 0,0:08:05.05,0:08:07.06,Default,,0,0,0,,Бұлай балықты ұстауға мүмкіндік жоқ.
Dialogue: 0,0:08:07.07,0:08:09.06,Default,,0,0,0,,Бұл жаңа шекара ма?
Dialogue: 0,0:08:09.07,0:08:11.04,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:08:11.09,0:08:14.03,Default,,0,0,0,,Бұл сәтсіздіктің көрінісі сияқты.
Dialogue: 0,0:08:14.07,0:08:17.05,Default,,0,0,0,,Көп күлме, бала солай істеген.
Dialogue: 0,0:08:17.05,0:08:19.08,Default,,0,0,0,,Өйткені бұл өте қарапайым
Dialogue: 0,0:08:30.02,0:08:32.09,Default,,0,0,0,,Бұл бала
Dialogue: 0,0:08:35.09,0:08:38.03,Default,,0,0,0,,Мен оны бүгінге қалдырамын.
Dialogue: 0,0:08:38.09,0:08:40.08,Default,,0,0,0,,Төменгі жағы көңілді көрінеді.
Dialogue: 0,0:08:41.01,0:08:43.03,Default,,0,0,0,,Хиро-ни, жемді алып жүр.
Dialogue: 0,0:08:43.03,0:08:45.03,Default,,0,0,0,,Бұл не жоғалып кетті?
Dialogue: 0,0:08:45.03,0:08:46.08,Default,,0,0,0,,Хинаның соққысы
Dialogue: 0,0:08:47.00,0:08:48.09,Default,,0,0,0,,Мұғалімдер, балықты дұрыс ұстайық.
Dialogue: 0,0:08:49.02,0:08:51.09,Default,,0,0,0,,Өйткені, мұнда да каллиграфия туралы айтуға болады.
Dialogue: 0,0:08:52.03,0:08:53.08,Default,,0,0,0,,Білікті емес немесе біліктілігі жоқ
Dialogue: 0,0:08:54.05,0:08:57.01,Default,,0,0,0,,Дәмді тағам дәмді және көңілді
Dialogue: 0,0:08:57.07,0:09:00.01,Default,,0,0,0,,Оны меңгерсең, болашақ болмайды.
Dialogue: 0,0:09:05.03,0:09:07.06,Default,,0,0,0,,Қызық, мен бүгін балық аулай аламын ба?
Dialogue: 0,0:09:08.03,0:09:10.02,Default,,0,0,0,,Өйткені, Коганның маңайында бұл мүмкін емес.
Dialogue: 0,0:09:10.05,0:09:14.00,Default,,0,0,0,,Директордың осы жерде қанша адамды ұстағанын көру өте жақсы болды.
Dialogue: 0,0:09:14.06,0:09:17.02,Default,,0,0,0,,Эй Хироши, сен балық алдың ба?
Dialogue: 0,0:09:17.05,0:09:20.00,Default,,0,0,0,,Мен ешқандай балық ұстай алмаймын. Мен оны тезірек шығарып алуым керек пе?
Dialogue: 0,0:09:20.04,0:09:22.02,Default,,0,0,0,,Хироши Егер сіз мұны қолдансаңыз
Dialogue: 0,0:09:22.06,0:09:24.08,Default,,0,0,0,,Бұл не? Ол қарғыс атқан құралға ұқсайды.
Dialogue: 0,0:09:26.07,0:09:27.02,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:27.08,0:09:30.06,Default,,0,0,0,,Жарайды, бұл соңғы түсірілім, сондықтан мен оны пайдаланып көремін.
Dialogue: 0,0:09:30.09,0:09:32.06,Default,,0,0,0,,Эбису-цчи де дұрыс айту керек.
Dialogue: 0,0:09:32.08,0:09:33.09,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:09:34.07,0:09:36.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:36.03,0:09:37.01,Default,,0,0,0,,Қарғыс
Dialogue: 0,0:09:37.08,0:09:42.03,Default,,0,0,0,,Таяқшаны соққанда, Ебісу: «Хисанион» ұсталды.
Dialogue: 0,0:09:43.04,0:09:45.01,Default,,0,0,0,,Эбису жеті бақытты құдайдың бірі, солай ма?
Dialogue: 0,0:09:45.03,0:09:48.00,Default,,0,0,0,,Қараңызшы, Эбису мырзада бар.
Dialogue: 0,0:09:48.03,0:09:50.00,Default,,0,0,0,,Бұл теңіз басы ма?
Dialogue: 0,0:09:50.03,0:09:52.04,Default,,0,0,0,,Дәлірек айтсақ, бұл тас теңіз балдыры.
Dialogue: 0,0:09:52.07,0:09:54.08,Default,,0,0,0,,Теңізге теңізге шығасыз, солай ма?
Dialogue: 0,0:09:55.01,0:09:57.09,Default,,0,0,0,,Осындай жерден балық аулай алсаң, бәрі де балықшы болар еді.
Dialogue: 0,0:09:58.02,0:09:59.06,Default,,0,0,0,,Сіз оны үзілді-кесілді жоққа шығарасыз.
Dialogue: 0,0:10:00.02,0:10:03.07,Default,,0,0,0,,Бірақ егер мен біреуін ұстап алсам, кешкі асқа теңіз балдыры сашими жеймін.
Dialogue: 0,0:10:04.01,0:10:04.51,Default,,0,0,0,,Не істейсің?
Dialogue: 0,0:10:05.00,0:10:06.02,Default,,0,0,0,,Кенеттен мотивация
Dialogue: 0,0:10:06.04,0:10:10.01,Default,,0,0,0,,Әрине, аралға келіп, ең болмаса бір дәмді тағамды жемей-ақ үйге қайтуға болады ма?
Dialogue: 0,0:10:20.02,0:10:21.03,Default,,0,0,0,,Келмейді.
Dialogue: 0,0:10:22.06,0:10:26.05,Default,,0,0,0,,Барлығы бірінші кезекте сол қармақпен балық ауламақ болғанын ұмытып кетті.
Dialogue: 0,0:10:26.07,0:10:28.00,Default,,0,0,0,,OK Шығу
Dialogue: 0,0:10:29.08,0:10:32.00,Default,,0,0,0,,Күте тұрыңыз, мен біраз тазалаймын.
Dialogue: 0,0:10:32.09,0:10:33.05,Default,,0,0,0,,I
Dialogue: 0,0:10:33.07,0:10:35.04,Default,,0,0,0,,Сіз бәрібір бір де балық ұстаған жоқсыз.
Dialogue: 0,0:10:35.02,0:10:36.04,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:10:57.08,0:10:59.07,Default,,0,0,0,,Бұл келе жатыр, келе жатыр
Dialogue: 0,0:10:59.08,0:11:01.07,Default,,0,0,0,,Қандай Мива Тамо
Dialogue: 0,0:11:02.00,0:11:04.00,Default,,0,0,0,,Маған қалдырыңыз Ебисуға рахмет? Жарайды, біз де көмектесеміз.
Dialogue: 0,0:11:05.05,0:11:06.04,Default,,0,0,0,,Кедергі
Dialogue: 0,0:11:06.04,0:11:09.00,Default,,0,0,0,,Ей, ақымақ, мұндай үлкен нәрсені өзің көтере аласың ба?
Dialogue: 0,0:11:09.00,0:11:12.05,Default,,0,0,0,,Мен оны көтере аламын. Сіз несиені ұрлауға тырысып жатырсыз, солай ма?
Dialogue: 0,0:11:12.05,0:11:15.00,Default,,0,0,0,,Иә, маған қалдыр.
Dialogue: 0,0:11:14.03,0:11:15.05,Default,,0,0,0,,Шулы айқай
Dialogue: 0,0:11:16.03,0:11:16.53,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:17.08,0:11:19.07,Default,,0,0,0,,келді
Dialogue: 0,0:11:20.01,0:11:21.09,Default,,0,0,0,,Үлкен
Dialogue: 0,0:11:34.09,0:11:37.00,Default,,0,0,0,,Енді не үлкен?
Dialogue: 0,0:11:37.00,0:11:39.04,Default,,0,0,0,,Бұл шынымен ойсыз, жалғастырыңыз.
Dialogue: 0,0:11:39.04,0:11:42.04,Default,,0,0,0,,Дәлірек айтсақ, дірілдеп жатыр. Үлкен жігіт шығып жатыр.
Dialogue: 0,0:11:42.04,0:11:43.05,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:11:43.05,0:11:45.04,Default,,0,0,0,,Ине ауада ыдырап кетті.
Dialogue: 0,0:11:55.07,0:11:56.04,Default,,0,0,0,,Үйге барасыз ба?
Dialogue: 0,0:12:03.01,0:12:05.08,Default,,0,0,0,,Ал, скумбрия үлкен балық болды.
Dialogue: 0,0:12:06.01,0:12:07.04,Default,,0,0,0,,Мен оны үйде қуырамын.
Dialogue: 0,0:12:07.07,0:12:09.00,Default,,0,0,0,,Сірке суына тұздалған жақсы.
Dialogue: 0,0:12:15.04,0:12:17.01,Default,,0,0,0,,Мұғалім, кеттік.
Dialogue: 0,0:12:18.08,0:12:19.08,Default,,0,0,0,,Бір нәрсе
Dialogue: 0,0:12:21.03,0:12:24.09,Default,,0,0,0,,Аралға келгелі бері жазғым келетін кездер болады.
Dialogue: 0,0:12:28.05,0:12:32.09,Default,,0,0,0,,Бірдеңе шығып, қолым дірілдеп кетті.
Dialogue: 0,0:12:37.07,0:12:40.01,Default,,0,0,0,,Мен де дәл қазір сондай сезімдемін.
Dialogue: 0,0:12:54.01,0:12:55.09,Default,,0,0,0,,Мұғалім мұны ұстады!
Dialogue: 0,0:12:58.08,0:13:01.00,Default,,0,0,0,,Бүгін біз өз аралымызды тойлаймыз...
Dialogue: 0,0:13:01.00,0:13:02.05,Default,,0,0,0,,(Виолет) Енді біз майордан бұйрық алмаймыз ба?
Dialogue: 0,0:13:02.05,0:13:03.03,Default,,0,0,0,,Оны елемеңіз
Dialogue: 0,0:13:03.09,0:13:05.04,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:13:07.01,0:13:09.09,Default,,0,0,0,,Балықтың сиясы бар, бірақ ол біраз күйіп кеткен.
Dialogue: 0,0:13:10.01,0:13:12.00,Default,,0,0,0,,Бұл жаңа шекараның қалдықтары.
Dialogue: 0,0:13:12.01,0:13:14.03,Default,,0,0,0,,Негізінде теңіз қарашыры жақсырақ болды.
Dialogue: 0,0:13:14.05,0:13:16.05,Default,,0,0,0,,Қолыңнан келгеннің бәрін жасап, өс
Dialogue: 0,0:13:16.08,0:13:18.06,Default,,0,0,0,,Мені бай қыл
Dialogue: 0,0:13:18.08,0:13:20.06,Default,,0,0,0,,Сіз сондайсыз, солай емес пе?
Dialogue: 0,0:13:20.09,0:13:24.01,Default,,0,0,0,,Кавафуджи мырза үшін біз жай ғана өнімміз.
Dialogue: 0,0:13:24.04,0:13:26.06,Default,,0,0,0,,Жаңа шекара, мен не болып жатқанын білемін
Dialogue: 0,0:13:26.09,0:13:27.05,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:13:30.01,0:13:31.02,Default,,0,0,0,,Көрші бөлме
Dialogue: 0,0:13:36.00,0:13:37.07,Default,,0,0,0,,Рұқсатсыз қайта қараңыз
Dialogue: 0,0:13:37.08,0:13:38.05,Default,,0,0,0,,Мен де көріп тұрмын
Dialogue: 0,0:13:39.03,0:13:40.06,Default,,0,0,0,,Йокаян
Dialogue: 0,0:13:40.08,0:13:43.03,Default,,0,0,0,,Маған мұғалімнің мінезі әрқашан ұнайтын.
Dialogue: 0,0:13:43.09,0:13:45.06,Default,,0,0,0,,Бұл ең жақсысы
Dialogue: 0,0:13:56.00,0:14:02.00,Default,,0,0,0,,Фукуокаға 635 рейске отырғызу рәсімдері 10:20 басталады.
Dialogue: 0,0:14:00.09,0:14:04.03,Default,,0,0,0,,Мен сені шығарып салудың қажеті жоқ еді.
Dialogue: 0,0:14:02.00,0:14:03.09,Default,,0,0,0,,Асығыңыздар, отырғызу қақпасына келіңіздер.
Dialogue: 0,0:14:04.07,0:14:07.06,Default,,0,0,0,,Токиоға жету үшін шамамен 3 сағат кетеді.
Dialogue: 0,0:14:08.00,0:14:10.03,Default,,0,0,0,,Жарайды, оны тастап кету ұят екенін білемін. Бұл не?
Dialogue: 0,0:14:09.04,0:14:10.05,Default,,0,0,0,,Канкоро мочи
Dialogue: 0,0:14:10.05,0:14:13.01,Default,,0,0,0,,Тіпті сізге бәрібір... Тостерде пісіріп жеу керек пе?
Dialogue: 0,0:14:13.07,0:14:14.09,Default,,0,0,0,,Қараңызшы, Кавафуджи
Dialogue: 0,0:14:15.04,0:14:18.07,Default,,0,0,0,,Ол ''Хачиканкан'' деп жазылып, ''Хачиканкан'' деп оқылған сияқты.
Dialogue: 0,0:14:18.07,0:14:21.01,Default,,0,0,0,,Теледидар - бұл революция емес пе?
Dialogue: 0,0:14:19.08,0:14:21.01,Default,,0,0,0,,Сен мұнда шынымен не үшін келдің?
Dialogue: 0,0:14:21.08,0:14:22.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:22.05,0:14:25.05,Default,,0,0,0,,Жергілікті тұрғындар неліктен толқуда?
Dialogue: 0,0:14:26.00,0:14:30.01,Default,,0,0,0,,Бізде кетуге біраз уақыт бар, сондықтан Кавафуджи-кун да кәдесыйлар сатып алуы керек.
Dialogue: 0,0:14:32.04,0:14:34.01,Default,,0,0,0,,Іс күрделене түсті.
Dialogue: 0,0:14:34.08,0:14:39.01,Default,,0,0,0,,Мұғаліммен дос болсаң, жақсысың.
Dialogue: 0,0:14:40.00,0:14:43.04,Default,,0,0,0,,Ауыл балалары әдетте тек жақын маңдағы адамдармен ғана араласады.
Dialogue: 0,0:14:43.09,0:14:46.03,Default,,0,0,0,,Қаланың адамдарымен ойнап көңілді болған сияқтысың.
Dialogue: 0,0:14:46.05,0:14:48.03,Default,,0,0,0,,Қараңызшы, бұл жаман емес.
Dialogue: 0,0:14:47.06,0:14:53.02,Default,,0,0,0,,Мұнда бір нәрсе бар. Ойыншықтар көп. Әуежай керемет емес пе?
Dialogue: 0,0:14:53.04,0:14:55.07,Default,,0,0,0,,Аяз атаның үйіне ұқсайды
Dialogue: 0,0:14:56.02,0:14:57.05,Default,,0,0,0,,Олардың біреуін әкеліңіз.
Dialogue: 0,0:14:57.08,0:14:59.08,Default,,0,0,0,,Жоқ, мен тартынамын.
Dialogue: 0,0:15:00.03,0:15:03.00,Default,,0,0,0,,Нене Бұл аралдың ерекшелігі неде?
Dialogue: 0,0:15:03.03,0:15:11.03,Default,,0,0,0,,Дұрыс, Канкоро мочи, камелия кәмпит, су кальмары, теңіз өті, Гото удон, Гото сиыр еті
Dialogue: 0,0:15:11.04,0:15:15.01,Default,,0,0,0,,Мен үйге онша көп әкеле алмаймын. Менде тамақтан басқа ештеңе жоқ.
Dialogue: 0,0:15:15.03,0:15:17.04,Default,,0,0,0,,Ұялы телефон бауы туралы не айтасыз?
Dialogue: 0,0:15:17.08,0:15:18.06,Default,,0,0,0,,Стандартты қор
Dialogue: 0,0:15:19.08,0:15:21.01,Default,,0,0,0,,Мүлдем сүйкімді емес
Dialogue: 0,0:15:21.02,0:15:24.04,Default,,0,0,0,,Барамон-кун, көп сатып алып, Токиоға тарат.
Dialogue: 0,0:15:27.07,0:15:29.08,Default,,0,0,0,,Менің достарым жоқ, сондықтан мен өзім үшін сатып аламын
Dialogue: 0,0:15:31.08,0:15:34.00,Default,,0,0,0,,Бір нәрсе үшін кешіріңіз
Dialogue: 0,0:15:34.01,0:15:34.51,Default,,0,0,0,,Не
Dialogue: 0,0:15:35.07,0:15:36.09,Default,,0,0,0,,Мен де сатып аламын
Dialogue: 0,0:15:38.01,0:15:40.02,Default,,0,0,0,,Мұны Наруха сатып алады
Dialogue: 0,0:15:40.03,0:15:42.08,Default,,0,0,0,,Егер сіз оны сатып алсаңыз, мені сатып алуға мәжбүрледіңіз бе?
Dialogue: 0,0:15:45.00,0:15:50.07,Default,,0,0,0,,Өтінемін, мұғалім, мен кіші сыныппын.
Dialogue: 0,0:15:50.07,0:15:52.03,Default,,0,0,0,,Келесі өміріңді жастық шағың үшін тәуекел етпе.
Dialogue: 0,0:15:52.05,0:15:57.01,Default,,0,0,0,,Сіз қанша тырыссаңыз да Кобба Кавафуджиге сыйлық бердіңіз бе?
Dialogue: 0,0:15:57.01,0:15:59.04,Default,,0,0,0,,Сіз өте жақсысыз
Dialogue: 0,0:16:00.00,0:16:02.04,Default,,0,0,0,,Мен оның нені жақсы көретінін білемін.
Dialogue: 0,0:16:02.04,0:16:03.07,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:16:05.06,0:16:07.03,Default,,0,0,0,,Мен көптеген сувенирлер сатып алдым.
Dialogue: 0,0:16:07.05,0:16:12.01,Default,,0,0,0,,Мен жұмыстағы әріптестеріме «Готоға барамын» деп мақтанатынмын, тіпті сыртқы түрі үшін де.
Dialogue: 0,0:16:12.01,0:16:18.00,Default,,0,0,0,,Фукуокаға 635 рейске отырғызу процедуралары қазір басталады.
Dialogue: 0,0:16:17.00,0:16:17.50,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:16:18.01,0:16:21.02,Default,,0,0,0,,Өкініштісі, мен бұл туралы ештеңе істей алмадым. Бірінші қақпадан отырыңыз.
Dialogue: 0,0:16:20.09,0:16:23.01,Default,,0,0,0,,Мен сіздің немқұрайлы екеніңізді білемін.
Dialogue: 0,0:16:24.05,0:16:27.04,Default,,0,0,0,,Жарайды, мен сенің жақсы болғаныңды көргеніме қуаныштымын.
Dialogue: 0,0:16:28.01,0:16:30.03,Default,,0,0,0,,Мен Ханда мырзаға да жақсы есеп бере аламын.
Dialogue: 0,0:16:30.07,0:16:32.09,Default,,0,0,0,,Сіз әкеңізбен кездесесіз бе?
Dialogue: 0,0:16:33.02,0:16:34.09,Default,,0,0,0,,Кейде жұмысқа байланысты
Dialogue: 0,0:16:35.05,0:16:38.01,Default,,0,0,0,,Мен оны өзім шығарып жіберсем де уайымдадым.
Dialogue: 0,0:16:40.08,0:16:41.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:43.07,0:16:45.02,Default,,0,0,0,,Не болды? Сіз таң қалған сияқтысыз.
Dialogue: 0,0:16:45.07,0:16:49.02,Default,,0,0,0,,Жоқ, бұл сіз туралы, сондықтан алаңдаудың қажеті жоқ.
Dialogue: 0,0:16:49.02,0:16:51.06,Default,,0,0,0,,Мен мәңгілік көтеріліс кезеңі сияқты нәрселерді айта беремін.
Dialogue: 0,0:16:55.00,0:16:59.08,Default,,0,0,0,,Соңғы кездері осыны ойлап жүрмін, бірақ әкем мені жек көрмейтін шығар.
Dialogue: 0,0:17:01.06,0:17:07.03,Default,,0,0,0,,Сіз мұны қазірге дейін түсіндіңіз бе? Қатал болу мен бір нәрсені жек көрудің арасында айырмашылық бар.
Dialogue: 0,0:17:07.07,0:17:11.00,Default,,0,0,0,,Басқа біреудің көзқарасы бойынша, мен сізді өте ақымақ деп ойлаймын.
Dialogue: 0,0:17:11.09,0:17:12.09,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:17:16.09,0:17:18.03,Default,,0,0,0,,Мүмкін болса, маған қоңырау шалыңыз.
Dialogue: 0,0:17:18.08,0:17:19.06,Default,,0,0,0,,Кавафуджи
Dialogue: 0,0:17:21.03,0:17:23.03,Default,,0,0,0,,Кава мырза отырғызу процедураларын аяқтады.
Dialogue: 0,0:17:23.05,0:17:25.04,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:17:28.04,0:17:31.01,Default,,0,0,0,,Бұл менің көзілдірігім. Көзілдірігім жабысып қалды.
Dialogue: 0,0:17:31.01,0:17:33.04,Default,,0,0,0,,Мен бұл міндетті түрде жетеді деп ойладым.
Dialogue: 0,0:17:33.06,0:17:35.02,Default,,0,0,0,,Бұл үшін балалар
Dialogue: 0,0:17:35.04,0:17:37.00,Default,,0,0,0,,Бұл көзілдірік емес, белдік.
Dialogue: 0,0:17:41.05,0:17:43.07,Default,,0,0,0,,Қызықты Бұл нені білдіреді?
Dialogue: 0,0:17:43.08,0:17:46.09,Default,,0,0,0,,Бұл көзілдіріктің ішінде шын мәнінде пышақ бар.
Dialogue: 0,0:17:46.09,0:17:49.09,Default,,0,0,0,,Кавафуджи: Мен сенің досың болуға ұяламын.
Dialogue: 0,0:17:50.00,0:17:58.03,Default,,0,0,0,,Көп дөрекі іс жасасам да, рахмет, ұстаз.
Dialogue: 0,0:17:59.03,0:18:03.08,Default,,0,0,0,,Сізбен танысқаныма өте қуаныштымын. Мен сізден көп нәрсені үйрендім.
Dialogue: 0,0:18:04.08,0:18:08.06,Default,,0,0,0,,Маған оқуға рұқсат етсеңіз де, бұл мектептегі саяхат емес.
Dialogue: 0,0:18:14.03,0:18:17.07,Default,,0,0,0,,Егер біз сол жолмен жүрсек, тағы да кездесуіміз мүмкін.
Dialogue: 0,0:18:18.08,0:18:23.02,Default,,0,0,0,,Мен де танымайтын адамды қызғанғанша, сенімен танысқаныма қуаныштымын.
Dialogue: 0,0:18:23.08,0:18:28.03,Default,,0,0,0,,Кейде бетпе-бет кездескен жақсы сезінеді. Бізге тағы қонаққа келіңіз.
Dialogue: 0,0:18:35.07,0:18:39.01,Default,,0,0,0,,Иә, міндетті түрде қайта келемін
Dialogue: 0,0:18:45.06,0:18:48.07,Default,,0,0,0,,Бұл қазірдің өзінде ауырады, олар мені өлтірмекші
Dialogue: 0,0:18:48.07,0:18:51.04,Default,,0,0,0,,Металл детекторларының түсіру күші керемет.
Dialogue: 0,0:18:51.04,0:18:53.01,Default,,0,0,0,,Менде ұят нәрсе бар.
Dialogue: 0,0:18:54.07,0:18:58.05,Default,,0,0,0,,Мен саған атам сыйлаған сувенирді беруді ұмытып кетіппін.
Dialogue: 0,0:18:58.06,0:19:00.04,Default,,0,0,0,,Әлі уақыт бар.
Dialogue: 0,0:19:00.05,0:19:01.07,Default,,0,0,0,,Ой
Dialogue: 0,0:19:04.03,0:19:07.07,Default,,0,0,0,,Жоқ, күте тұрыңыз, оның металл заттары жоқ.
Dialogue: 0,0:19:15.07,0:19:16.02,Default,,0,0,0,,шықты
Dialogue: 0,0:19:16.05,0:19:19.03,Default,,0,0,0,,Байқадым, Кава-сан, ымдап.
Dialogue: 0,0:19:22.00,0:19:23.08,Default,,0,0,0,,Мен өзімді жалғыз сезінемін.
Dialogue: 0,0:19:24.01,0:19:27.06,Default,,0,0,0,,Жаңа кездессек те, өзімді жалғыз сезінемін, ұстаз.
Dialogue: 0,0:19:28.00,0:19:30.08,Default,,0,0,0,,Маған шырын беріңізші
Dialogue: 0,0:19:31.05,0:19:32.08,Default,,0,0,0,,Сіз қызғанасыз ба?
Dialogue: 0,0:19:32.08,0:19:35.03,Default,,0,0,0,,Бұл адамның бейімделу қабілеті керемет.
Dialogue: 0,0:19:33.03,0:19:34.07,Default,,0,0,0,,Маған беріңіз
Dialogue: 0,0:19:36.09,0:19:38.00,Default,,0,0,0,,Токио?
Dialogue: 0,0:19:38.08,0:19:41.09,Default,,0,0,0,,Доганшита Хиро-нии де Токиоға барғысы келді ме?
Dialogue: 0,0:19:42.02,0:19:44.00,Default,,0,0,0,,Токиоға барғыңыз келе ме?
Dialogue: 0,0:19:44.07,0:19:48.08,Default,,0,0,0,,Менің ойымша, бәріміз бір күні аралдан кетуіміз керек.
Dialogue: 0,0:19:51.06,0:19:56.02,Default,,0,0,0,,Мен де жоғары сынып оқушысымын, сондықтан бұл сөздерді шынайы түрде ойластырған дұрыс деп ойлаймын.
Dialogue: 0,0:20:04.04,0:20:07.03,Default,,0,0,0,,Менің байсалды көрініс болса да.
Dialogue: 0,0:20:16.06,0:20:17.03,Default,,0,0,0,,Ал, қалай ойлайсың, Армин?
Dialogue: 0,0:20:17.05,0:20:25.00,Default,,0,0,0,,Қош бол-сау-сау бол
Dialogue: 0,0:20:28.01,0:20:29.04,Default,,0,0,0,,Сыйымдылық асып кеткендіктен
Dialogue: 0,0:20:29.08,0:20:33.06,Default,,0,0,0,,Мен Кавафуджи-кунның жалға алған көлігін қайтардым, сондықтан үйге автобуспен барыңыз.
Dialogue: 0,0:20:36.01,0:20:37.07,Default,,0,0,0,,Қош бол
Dialogue: 0,0:20:39.08,0:20:40.04,Default,,0,0,0,,Эй
Dialogue: 0,0:20:40.04,0:20:41.03,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:20:41.00,0:20:42.04,Default,,0,0,0,,Мен қайда мінсем болады?
Dialogue: 0,0:20:43.00,0:20:45.09,Default,,0,0,0,,Достарым үйге барғанда мен өзімді жалғыз сезінемін.
Dialogue: 0,0:20:46.04,0:20:50.02,Default,,0,0,0,,Жоқ, мен сізді келесі жолы күтемін.
Dialogue: 0,0:20:53.01,0:20:55.05,Default,,0,0,0,,Сіз кішкентай қолыңызды создыңыз
Dialogue: 0,0:20:55.07,0:21:01.04,Default,,0,0,0,,Саған ұқсап күлу табиғи болды
Dialogue: 0,0:21:04.00,0:21:06.06,Default,,0,0,0,,Оның мағынасы болмауы мүмкін
Dialogue: 0,0:21:06.08,0:21:12.04,Default,,0,0,0,,бірақ бұл мен істей алмайтын нәрсе
Dialogue: 0,0:21:14.07,0:21:18.04,Default,,0,0,0,,Сен ойланбастан қолыма тидің
Dialogue: 0,0:21:18.04,0:21:22.02,Default,,0,0,0,,бірақ бұл мен үшін жақсы болды
Dialogue: 0,0:21:25.02,0:21:30.06,Default,,0,0,0,,Біз сенген барлық уақытта
Dialogue: 0,0:21:30.07,0:21:36.00,Default,,0,0,0,,дүние біздің қолымызда болды
Dialogue: 0,0:21:36.02,0:21:38.09,Default,,0,0,0,,Біз қателестік
Dialogue: 0,0:21:38.09,0:21:47.00,Default,,0,0,0,,мүмкін бұл сен менің қолымды ұстап тұрғандықтан емес шығар
Dialogue: 0,0:21:47.00,0:21:52.06,Default,,0,0,0,,Әр сәтте
Dialogue: 0,0:21:52.07,0:21:58.02,Default,,0,0,0,,Барлық жерде
Dialogue: 0,0:21:58.03,0:22:03.05,Default,,0,0,0,,Мен сене аламын, сене аламын
Dialogue: 0,0:22:03.08,0:22:08.07,Default,,0,0,0,,Жылы алақаныңды ұстағанда
Dialogue: 0,0:22:08.07,0:22:16.00,Default,,0,0,0,,сіздің жылы қолыңыз
Dialogue: 0,0:22:25.09,0:22:28.01,Default,,0,0,0,,Нарудан сувенир Бұл не болды?
Dialogue: 0,0:22:29.09,0:22:31.09,Default,,0,0,0,,Бұл дәл қазір әрекет етті ме?
Dialogue: 0,0:22:34.04,0:22:35.05,Default,,0,0,0,,Мен тағы да келемін деп үміттенемін
Dialogue: 0,0:22:36.00,0:22:36.50,Default,,0,0,0,,Иә
Dialogue: 0,0:22:37.08,0:22:38.03,Default,,0,0,0,,На
Dialogue: 0,0:22:45.09,0:22:48.01,Default,,0,0,0,,Келесі жолы мен жалғыз келемін
Dialogue: 0,0:22:49.51,0:22:54.51,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
