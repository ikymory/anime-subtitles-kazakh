Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.00,0:00:36.00,Default,,0,0,0,,Ғашық болған кездегі келешегі бар жазғы демалыс
Dialogue: 0,0:00:36.00,0:00:39.00,Default,,0,0,0,,Бар күшіңмен тыныштық
Dialogue: 0,0:00:39.00,0:00:42.00,Default,,0,0,0,,Марусама еңбегіңіз үшін рахмет
Dialogue: 0,0:00:42.00,0:00:47.00,Default,,0,0,0,,Қызықты соңғы тегін
Dialogue: 0,0:00:47.00,0:00:50.00,Default,,0,0,0,,Дарлинг Хирабибу
Dialogue: 0,0:00:51.00,0:00:54.00,Default,,0,0,0,,Басталғалы тұрған таң қалдыратын аниме кездейсоқ ең таң қалдыратын аниме болып табылады.
Dialogue: 0,0:00:54.00,0:01:00.00,Default,,0,0,0,,Манана – жабайы тағам
Dialogue: 0,0:01:24.00,0:01:25.00,Default,,0,0,0,,Арулар үйі
Dialogue: 0,0:01:25.00,0:01:27.00,Default,,0,0,0,,Мен мұны істегім келеді
Dialogue: 0,0:01:27.00,0:01:30.00,Default,,0,0,0,,Олай болса жасап көріңіз, егер қолыңыздан келсе.
Dialogue: 0,0:01:30.00,0:01:31.00,Default,,0,0,0,,Жасаңыз
Dialogue: 0,0:01:31.00,0:01:32.00,Default,,0,0,0,,Эй
Dialogue: 0,0:01:32.00,0:01:33.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:33.00,0:01:37.00,Default,,0,0,0,,Ондай ақымаққа бұлай істеуге рұқсат етсең, сыныпқа қиындық түседі.
Dialogue: 0,0:01:37.00,0:01:39.00,Default,,0,0,0,,Мектеп мерекесі тек ойын ғана емес пе?
Dialogue: 0,0:01:39.00,0:01:40.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:40.00,0:01:44.00,Default,,0,0,0,,Бұл Йошиконың сәтсіздікке ұшырауына және оған не болып жатқанын білуге ​​мүмкіндік беретін жақсы мүмкіндік.
Dialogue: 0,0:01:44.00,0:01:46.00,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,0:01:46.00,0:01:47.00,Default,,0,0,0,,Бұл мәдени мереке!
Dialogue: 0,0:01:47.00,0:01:50.00,Default,,0,0,0,,Көп нәрсе жасап, оның табысқа жетуі үшін бірге жұмыс жасайық
Dialogue: 0,0:01:50.00,0:01:52.00,Default,,0,0,0,,Сондай-ақ ұшыру рәсімі өтті
Dialogue: 0,0:01:52.00,0:01:55.00,Default,,0,0,0,,Мен оны асыға күттім!
Dialogue: 0,0:01:55.00,0:01:56.00,Default,,0,0,0,,Емдеу?
Dialogue: 0,0:01:56.00,0:01:59.00,Default,,0,0,0,,Мм, мен қазір үй бөлмесіндемін.
Dialogue: 0,0:01:59.00,0:02:00.00,Default,,0,0,0,,Бірінші орында
Dialogue: 0,0:02:00.00,0:02:03.00,Default,,0,0,0,,Мен әдетте сабақта шу шығарамын және сабақты жақсы оқымаймын.
Dialogue: 0,0:02:03.00,0:02:08.00,Default,,0,0,0,,Тіпті дұрыс студенттік мәтіні жоқ Антроның мектеп фестивалінен ләззат алуға құқығы бар ма?
Dialogue: 0,0:02:09.00,0:02:14.00,Default,,0,0,0,,А, мінеки! Менің айтайын дегенім, қарашы, мінекей!
Dialogue: 0,0:02:14.00,0:02:18.00,Default,,0,0,0,,Мен әдетте оқымайтын нәрсе – ойлау жылдамдығы.
Dialogue: 0,0:02:18.00,0:02:22.00,Default,,0,0,0,,Ку, ку, ку, ку, уф, сонда сен өзіңді ақылдымын деп ойлайсың ба?
Dialogue: 0,0:02:22.00,0:02:25.00,Default,,0,0,0,,Иә, Антроға қарағанда көбірек.
Dialogue: 0,0:02:25.00,0:02:28.00,Default,,0,0,0,,Уау, Кимо, бұл жігіттің досы жоқ па?
Dialogue: 0,0:02:28.00,0:02:31.00,Default,,0,0,0,,А, сондықтан мектептегі мерекелерді жек көресің бе?
Dialogue: 0,0:02:31.00,0:02:33.00,Default,,0,0,0,,Бейшара Маршу, ал!
Dialogue: 0,0:02:33.00,0:02:35.00,Default,,0,0,0,,Менде зұлымдық бар!
Dialogue: 0,0:02:35.00,0:02:36.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:36.00,0:02:37.00,Default,,0,0,0,,Маршуды алыңыз!
Dialogue: 0,0:02:37.00,0:02:41.00,Default,,0,0,0,,Хахахаха, хахахаха, сәйкес шкафпен!
Dialogue: 0,0:02:41.00,0:02:42.00,Default,,0,0,0,,рикулярдың қосындысы емес пе?
Dialogue: 0,0:02:42.00,0:02:43.00,Default,,0,0,0,,Жалғыз ақымақ
Dialogue: 0,0:02:43.00,0:02:45.00,Default,,0,0,0,,Маған үнемі қамқорлық жасаңыз.
Dialogue: 0,0:02:45.00,0:02:47.00,Default,,0,0,0,,Бұл өте қатты
Dialogue: 0,0:02:47.00,0:02:48.00,Default,,0,0,0,,Мынау ұсқынсыз
Dialogue: 0,0:02:48.00,0:02:50.00,Default,,0,0,0,,О, қандай жалғыз жер
Dialogue: 0,0:02:50.00,0:02:52.00,Default,,0,0,0,,Ұсқынсыз, шіркін әйел.
Dialogue: 0,0:02:52.00,0:02:55.00,Default,,0,0,0,,Ой, шіркін кім?
Dialogue: 0,0:02:55.00,0:02:59.00,Default,,0,0,0,,Не, сен сүйкімдімін деп ойлайсың ба?
Dialogue: 0,0:02:59.00,0:03:02.00,Default,,0,0,0,,Мен-мен не айтқым келгенін айтпадым.
Dialogue: 0,0:03:02.00,0:03:04.00,Default,,0,0,0,,Олай болса, шіркін ғой.
Dialogue: 0,0:03:04.00,0:03:07.00,Default,,0,0,0,,Бірақ, тіпті мен
Dialogue: 0,0:03:07.00,0:03:08.00,Default,,0,0,0,,О
Dialogue: 0,0:03:08.00,0:03:13.00,Default,,0,0,0,,Ей, мұндай сұмдық сөздерді айтуды доғар.
Dialogue: 0,0:03:13.00,0:03:14.00,Default,,0,0,0,,Ue, Ue
Dialogue: 0,0:03:14.00,0:03:16.00,Default,,0,0,0,,Ей, мені неге жылатып тұрсың!
Dialogue: 0,0:03:16.00,0:03:17.00,Default,,0,0,0,,Мүлдем мүмкін емес
Dialogue: 0,0:03:17.00,0:03:19.00,Default,,0,0,0,,Эй, жоқ, күте тұрыңыз.
Dialogue: 0,0:03:19.00,0:03:24.00,Default,,0,0,0,,Бұл ренжітеді, мен ол адамға өз қалауын орындауға рұқсат бергім келмейді.
Dialogue: 0,0:03:24.00,0:03:25.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:25.00,0:03:27.00,Default,,0,0,0,,Га
Dialogue: 0,0:03:28.00,0:03:31.00,Default,,0,0,0,,Сонымен, соңында атқару комитеті кім?
Dialogue: 0,0:03:31.00,0:03:32.00,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:03:32.00,0:03:33.00,Default,,0,0,0,,Ах
Dialogue: 0,0:03:34.00,0:03:36.00,Default,,0,0,0,,Күшімізді біріктірейік
Dialogue: 0,0:03:36.00,0:03:38.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:46.00,0:03:48.00,Default,,0,0,0,,Дайындықтан сәл артта қалған сияқтымын.
Dialogue: 0,0:03:48.00,0:03:50.00,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:03:50.00,0:03:51.00,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:03:51.00,0:03:54.00,Default,,0,0,0,,Сонда мектепте қалып, жұмыс істеуге болады.
Dialogue: 0,0:03:54.00,0:03:55.00,Default,,0,0,0,,Хмм, қалай?
Dialogue: 0,0:03:55.00,0:03:56.00,Default,,0,0,0,,Жасырын, пар!
Dialogue: 0,0:03:56.00,0:03:58.00,Default,,0,0,0,,Сөйлеңіз!
Dialogue: 0,0:04:03.00,0:04:05.00,Default,,0,0,0,,Жарайды, бәрі үйлеріне кеткен сияқты.
Dialogue: 0,0:04:05.00,0:04:07.00,Default,,0,0,0,,Мен көп нәрсе дайындадым!
Dialogue: 0,0:04:07.00,0:04:11.00,Default,,0,0,0,,Бұл түнгі мектепті зерттеуге арналған құбыжық, Тони!
Dialogue: 0,0:04:11.00,0:04:13.00,Default,,0,0,0,,Барлығы ойнай алатын карталарды ойнау!
Dialogue: 0,0:04:13.00,0:04:15.00,Default,,0,0,0,,Эй, сен мұнда не істеп жүрсің?
Dialogue: 0,0:04:15.00,0:04:18.00,Default,,0,0,0,,Теледидардан Тефоға бата беріңіз!
Dialogue: 0,0:04:18.00,0:04:20.00,Default,,0,0,0,,Ол шындап ойнауға келеді!
Dialogue: 0,0:04:20.00,0:04:25.00,Default,,0,0,0,,Бірақ түнгі мектеп өте қызықты.
Dialogue: 0,0:04:25.00,0:04:28.00,Default,,0,0,0,,Қуып жетсең, аздап көңіл көтеруге болады
Dialogue: 0,0:04:28.00,0:04:31.00,Default,,0,0,0,,Бүгін таңға дейін жұмыс істеймін!
Dialogue: 0,0:04:31.00,0:04:32.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:32.00,0:04:37.00,Default,,0,0,0,,Дұрыс, менің ойнауға уақытым жоқ.
Dialogue: 0,0:04:37.00,0:04:38.00,Default,,0,0,0,,О, не?
Dialogue: 0,0:04:38.00,0:04:40.00,Default,,0,0,0,,Алдымен зерттеп алайық!
Dialogue: 0,0:04:40.00,0:04:42.00,Default,,0,0,0,,Ой, ау, мұнда ешкім жоқ!
Dialogue: 0,0:04:42.00,0:04:44.00,Default,,0,0,0,,Бұл дүниедегі барлық нәрсе
Dialogue: 0,0:04:44.00,0:04:45.00,Default,,0,0,0,,Эй, күте тұрыңыз!
Dialogue: 0,0:04:45.00,0:04:47.00,Default,,0,0,0,,Мен сені алып кетейін.
Dialogue: 0,0:04:47.00,0:04:48.00,Default,,0,0,0,,О, ой
Dialogue: 0,0:04:48.00,0:04:50.00,Default,,0,0,0,,Менің де барғым келмейді!
Dialogue: 0,0:04:50.00,0:04:52.00,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:04:54.00,0:04:56.00,Default,,0,0,0,,Ал, күте тұрыңыз!
Dialogue: 0,0:04:56.00,0:04:58.00,Default,,0,0,0,,Эй, мында кір!
Dialogue: 0,0:04:59.00,0:05:01.00,Default,,0,0,0,,Бұл билейтін дәретхана!
Dialogue: 0,0:05:01.00,0:05:03.00,Default,,0,0,0,,О, бұл Ошикобенки!
Dialogue: 0,0:05:03.00,0:05:04.00,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:05:04.00,0:05:06.00,Default,,0,0,0,,Бұл керемет, бір қараңызшы!
Dialogue: 0,0:05:06.00,0:05:09.00,Default,,0,0,0,,Иә? Осындай уақытта болмаса, көре алмаймын!
Dialogue: 0,0:05:09.00,0:05:12.00,Default,,0,0,0,,Бұл қазірдің өзінде...
Dialogue: 0,0:05:14.00,0:05:16.00,Default,,0,0,0,,Қасыңдағы жігітті көрмейсің бе?
Dialogue: 0,0:05:16.00,0:05:18.00,Default,,0,0,0,,Өзін көрсеткісі келетін ұлдар керемет!
Dialogue: 0,0:05:18.00,0:05:20.00,Default,,0,0,0,,Мен- солай ма?
Dialogue: 0,0:05:20.00,0:05:21.00,Default,,0,0,0,,Ей, эй, эй, эй, дереу жасайық!
Dialogue: 0,0:05:21.00,0:05:23.00,Default,,0,0,0,,Ал, жұмысқа кірісейік.
Dialogue: 0,0:05:23.00,0:05:25.00,Default,,0,0,0,,Жоқ, дұрыс.
Dialogue: 0,0:05:25.00,0:05:27.00,Default,,0,0,0,,Олай болса ойын уақыты келді!
Dialogue: 0,0:05:27.00,0:05:29.00,Default,,0,0,0,,Мектеп мерекесіне дайындық!
Dialogue: 0,0:05:29.00,0:05:31.00,Default,,0,0,0,,Мен ойын ойнағым келмейді!
Dialogue: 0,0:05:31.00,0:05:34.00,Default,,0,0,0,,Мен-бұлай айтқан жоқпын, бірақ түсінікті болсын!
Dialogue: 0,0:05:34.00,0:05:36.00,Default,,0,0,0,,Жаса!
Dialogue: 0,0:05:37.00,0:05:40.00,Default,,0,0,0,,Жарайды, түн ұзақ.
Dialogue: 0,0:05:40.00,0:05:42.00,Default,,0,0,0,,Біраз әрекет етесіз бе?
Dialogue: 0,0:05:42.00,0:05:43.00,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:05:45.00,0:05:47.00,Default,,0,0,0,,Күрделі теңіз хош иісі
Dialogue: 0,0:05:53.00,0:05:55.00,Default,,0,0,0,,Бұл өте қызықты.
Dialogue: 0,0:05:57.00,0:06:00.00,Default,,0,0,0,,Жұмысты бастау уақыты келді деп ойлаймын.
Dialogue: 0,0:06:01.00,0:06:03.00,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:06:03.00,0:06:06.00,Default,,0,0,0,,Шынымен!? Бұл жерден қызық болады!?
Dialogue: 0,0:06:06.00,0:06:08.00,Default,,0,0,0,,Мен мұны кейінірек міндетті түрде жасаймын!
Dialogue: 0,0:06:08.00,0:06:10.00,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:06:12.00,0:06:14.00,Default,,0,0,0,,Таң атуға жақын
Dialogue: 0,0:06:14.00,0:06:16.00,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:06:16.00,0:06:18.00,Default,,0,0,0,,Бұл соңғы бастық дерлік.
Dialogue: 0,0:06:20.00,0:06:22.00,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:06:23.00,0:06:25.00,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:06:26.00,0:06:29.00,Default,,0,0,0,,Ертең де тоқтап жұмыс істе.
Dialogue: 0,0:06:29.00,0:06:31.00,Default,,0,0,0,,Бұл қулық болды!
Dialogue: 0,0:06:31.00,0:06:33.00,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:06:33.00,0:06:35.00,Default,,0,0,0,,Тазаланды!
Dialogue: 0,0:06:35.00,0:06:38.00,Default,,0,0,0,,Мектепте достармен бірге ұйықтау өте қызықты!
Dialogue: 0,0:06:38.00,0:06:39.00,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:06:39.00,0:06:42.00,Default,,0,0,0,,Ендеше, Темемен кім дос?!
Dialogue: 0,0:06:54.00,0:06:56.00,Default,,0,0,0,,Мәдени фестиваль!
Dialogue: 0,0:06:56.00,0:06:57.00,Default,,0,0,0,,Барымызды салайық!
Dialogue: 0,0:06:57.00,0:06:59.00,Default,,0,0,0,,Байқамаңыз! Рождестволық қызметші!
Dialogue: 0,0:06:59.00,0:07:03.00,Default,,0,0,0,,Эй ақымақ! Ойнамаңыз! Басталғалы жатыр!
Dialogue: 0,0:07:03.00,0:07:05.00,Default,,0,0,0,,Мен көптен күттім!
Dialogue: 0,0:07:05.00,0:07:07.00,Default,,0,0,0,,Мәдени мереке енді басталады.
Dialogue: 0,0:07:07.00,0:07:09.00,Default,,0,0,0,,Қош келдіңіз, ұстаз!
Dialogue: 0,0:07:09.00,0:07:11.00,Default,,0,0,0,,Мұнда бананнан жасалған креп бар!
Dialogue: 0,0:07:11.00,0:07:13.00,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:07:13.00,0:07:15.00,Default,,0,0,0,,Мен сатуға үлес қосамын!
Dialogue: 0,0:07:15.00,0:07:17.00,Default,,0,0,0,,О! Рақмет сізге!
Dialogue: 0,0:07:19.00,0:07:21.00,Default,,0,0,0,,Талон!
Dialogue: 0,0:07:21.00,0:07:23.00,Default,,0,0,0,,Талон!
Dialogue: 0,0:07:23.00,0:07:25.00,Default,,0,0,0,,Талон!
Dialogue: 0,0:07:25.00,0:07:27.00,Default,,0,0,0,,Талон!
Dialogue: 0,0:07:28.00,0:07:29.00,Default,,0,0,0,,Талон!
Dialogue: 0,0:07:29.00,0:07:31.00,Default,,0,0,0,,Бұл Руичи!
Dialogue: 0,0:07:31.00,0:07:32.00,Default,,0,0,0,,Талон!
Dialogue: 0,0:07:32.00,0:07:34.00,Default,,0,0,0,,Рахмет! Мен Руичимін!
Dialogue: 0,0:07:39.00,0:07:42.00,Default,,0,0,0,,Мәдени мереке көңілді!
Dialogue: 0,0:07:44.00,0:07:45.00,Default,,0,0,0,,≪(Дэннидің үрген дауысы) (Джонатан) Дұрыс~, жақсы бала!
Dialogue: 0,0:07:45.00,0:07:47.00,Default,,0,0,0,,Маған ұнады!
Dialogue: 0,0:07:47.00,0:07:48.00,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Өте өкінішті!
Dialogue: 0,0:07:50.00,0:07:53.00,Default,,0,0,0,,Ханабатаке-сан, сен мұнда не үшін келдің?
Dialogue: 0,0:07:53.00,0:07:55.00,Default,,0,0,0,,Сіз бар батылдығыңызды жинадыңыз, солай ма?
Dialogue: 0,0:07:55.00,0:07:56.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:56.00,0:07:57.00,Default,,0,0,0,,Мені қашаннан бері ұнатасың?
Dialogue: 0,0:07:57.00,0:07:58.00,Default,,0,0,0,,Үш жылға
Dialogue: 0,0:07:58.00,0:07:59.00,Default,,0,0,0,,Мен де сол кеуделерді көргім келді.
Dialogue: 0,0:07:59.00,0:08:00.00,Default,,0,0,0,,Менің ішкім келді
Dialogue: 0,0:08:00.00,0:08:01.00,Default,,0,0,0,,Ішейін.
Dialogue: 0,0:08:01.00,0:08:02.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:02.00,0:08:03.00,Default,,0,0,0,,Мысалы, егер сіз өзіңізге ұнайтын адамыңызды мойындасаңыз және ол сізді тастап кетсе, не істер едіңіз?
Dialogue: 0,0:08:03.00,0:08:04.00,Default,,0,0,0,,Мен Акутсу-кунмын
Dialogue: 0,0:08:04.00,0:08:05.00,Default,,0,0,0,,Мен сені қызықтырмаймын.
Dialogue: 0,0:08:05.00,0:08:06.00,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:08:06.00,0:08:07.00,Default,,0,0,0,,Сонымен қатар, адам
Dialogue: 0,0:08:07.00,0:08:08.00,Default,,0,0,0,,Мен сізге ұнайсыз
Dialogue: 0,0:08:08.00,0:08:09.00,Default,,0,0,0,,Вегетариандық деген нәрсе бар емес пе?
Dialogue: 0,0:08:09.00,0:08:10.00,Default,,0,0,0,,Бұл өте ауыр
Dialogue: 0,0:08:10.00,0:08:11.00,Default,,0,0,0,,Мұндай жағдайда не қалайсыз?
Dialogue: 0,0:08:11.00,0:08:12.00,Default,,0,0,0,,Ең болмағанда естеліктеріңізді нақтылаңыз
Dialogue: 0,0:08:12.00,0:08:19.00,Default,,0,0,0,,Естеліктер
Dialogue: 0,0:08:19.00,0:08:23.00,Default,,0,0,0,,Ал ол кісі маған ұнайды!
Dialogue: 0,0:08:23.00,0:08:25.00,Default,,0,0,0,,Ноаааааааааааааа!
Dialogue: 0,0:08:25.00,0:08:29.00,Default,,0,0,0,,О, бұл өте оңай!
Dialogue: 0,0:08:29.00,0:08:32.00,Default,,0,0,0,,Мұндай жағдайда не қалайсыз?
Dialogue: 0,0:08:32.00,0:08:40.00,Default,,0,0,0,,Тым болмаса, естеліктер, естеліктер, сүйісулер келеді.
Dialogue: 0,0:08:40.00,0:08:46.00,Default,,0,0,0,,Түсіндің бе? Сосын кеуделеріңді ішсін.
Dialogue: 0,0:08:46.00,0:08:50.00,Default,,0,0,0,,Бұл естелік пе? Бірақ сүйіспеншілік пен кеуде өте әртүрлі.
Dialogue: 0,0:08:50.00,0:08:56.00,Default,,0,0,0,,Ақымақ! Әйелдер естеліктер үшін сүйіспеншілікті қалайды, ерлер естеліктер үшін кеудені қалайды!
Dialogue: 0,0:08:56.00,0:09:06.00,Default,,0,0,0,,Ешбір естелік алмай тастап кетудің азабын түсінсеңіз, осы қайғылы жарысқа көмектесіңізші!
Dialogue: 0,0:09:06.00,0:09:09.00,Default,,0,0,0,,Хитомимоми, хитомимоми жақсы!
Dialogue: 0,0:09:09.00,0:09:10.00,Default,,0,0,0,,О, қазірдің өзінде!
Dialogue: 0,0:09:10.00,0:09:12.00,Default,,0,0,0,,Kuyoiyo!
Dialogue: 0,0:09:12.00,0:09:15.00,Default,,0,0,0,,Жарайсың! Ендеше, сен істе!
Dialogue: 0,0:09:15.00,0:09:17.00,Default,,0,0,0,,Иә! Itadadakimasu!
Dialogue: 0,0:09:23.00,0:09:25.00,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:40.00,0:09:42.00,Default,,0,0,0,,Жоқ, бұл ештеңе емес!
Dialogue: 0,0:09:42.00,0:09:44.00,Default,,0,0,0,,Амансың ба? Мықты болыңыз!
Dialogue: 0,0:09:44.00,0:09:47.00,Default,,0,0,0,,Міне, міне...
Dialogue: 0,0:09:47.00,0:09:49.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:55.00,0:09:58.00,Default,,0,0,0,,Мектеп фестивалі сәтті өтті! Құттықтаймыз!
Dialogue: 0,0:09:59.00,0:10:02.00,Default,,0,0,0,,Бұл жігіттің өмір сүруі ең нашар.
Dialogue: 0,0:10:02.00,0:10:03.00,Default,,0,0,0,,Бұл сызық.
Dialogue: 0,0:10:03.00,0:10:06.00,Default,,0,0,0,,Көңілді болайық!
Dialogue: 0,0:10:08.00,0:10:09.00,Default,,0,0,0,,Идиот!
Dialogue: 0,0:10:09.00,0:10:10.00,Default,,0,0,0,,Уайымдама, ақымақ.
Dialogue: 0,0:10:10.00,0:10:12.00,Default,,0,0,0,,Тым болмаса жарасып кетіңіз!
Dialogue: 0,0:10:15.00,0:10:17.00,Default,,0,0,0,,Ой, мен оқуды бастадым.
Dialogue: 0,0:10:17.00,0:10:19.00,Default,,0,0,0,,Расында да, Гокчи атмосфераны оқи алмайды.
Dialogue: 0,0:10:19.00,0:10:21.00,Default,,0,0,0,,Аузыңды жап, Бут.
Dialogue: 0,0:10:21.00,0:10:23.00,Default,,0,0,0,,Ха! Тағы айт!
Dialogue: 0,0:10:23.00,0:10:25.00,Default,,0,0,0,,Екеуіңіз де жақсы емессіздер!
Dialogue: 0,0:10:25.00,0:10:32.00,Default,,0,0,0,,Мен жай ғана барлығымен тіл табысқым келді, бірақ бұл солай.
Dialogue: 0,0:10:33.00,0:10:35.00,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:10:40.00,0:10:41.00,Default,,0,0,0,,Бұл алкоголь!
Dialogue: 0,0:10:41.00,0:10:43.00,Default,,0,0,0,,Барлығы қате түсінді.
Dialogue: 0,0:10:43.00,0:10:45.00,Default,,0,0,0,,Бірақ сіз әлі ішпеген сияқтысыз.
Dialogue: 0,0:10:45.00,0:10:46.00,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:10:46.00,0:10:47.00,Default,,0,0,0,,Тек иіс...
Dialogue: 0,0:10:47.00,0:10:51.00,Default,,0,0,0,,Екеуміздің ұрысып қалғанымыз сонша, жылағым келеді!
Dialogue: 0,0:10:51.00,0:10:54.00,Default,,0,0,0,,Менің қолдарым жылап жатыр! Мені дұрыстап кіргіз!
Dialogue: 0,0:10:54.00,0:10:56.00,Default,,0,0,0,,Бұл түсініксіз.
Dialogue: 0,0:10:56.00,0:11:01.00,Default,,0,0,0,,Чусаймен төбелессем де, оны көрмей қояды, бәрі мен туралы ғана айтып жатыр!
Dialogue: 0,0:11:01.00,0:11:05.00,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:11:05.00,0:11:06.00,Default,,0,0,0,,Йошико-чан.
Dialogue: 0,0:11:06.00,0:11:09.00,Default,,0,0,0,,Сіз сүйкімді және мейірімдісіз!
Dialogue: 0,0:11:09.00,0:11:13.00,Default,,0,0,0,,Кеудесі кішкентай қыз!
Dialogue: 0,0:11:15.00,0:11:23.00,Default,,0,0,0,,Ақырында бұл менің әкем бе, әлде менің әкем ғана жылайды ма? Мен жылағым келеді!
Dialogue: 0,0:11:23.00,0:11:25.00,Default,,0,0,0,,Мен де жылап жатырмын.
Dialogue: 0,0:11:25.00,0:11:27.00,Default,,0,0,0,,Міне, мен секіремін!
Dialogue: 0,0:11:27.00,0:11:29.00,Default,,0,0,0,,Мен не істеуім керек!
Dialogue: 0,0:11:29.00,0:11:31.00,Default,,0,0,0,,Ал, бұл туралы уайымдамаңыз.
Dialogue: 0,0:11:31.00,0:11:33.00,Default,,0,0,0,,Бұл күлкілі!
Dialogue: 0,0:11:33.00,0:11:36.00,Default,,0,0,0,,Дұрыс, әкеме қарап күле беруге болады!
Dialogue: 0,0:11:36.00,0:11:38.00,Default,,0,0,0,,Мен қатты күлдім!
Dialogue: 0,0:11:38.00,0:11:40.00,Default,,0,0,0,,Кәне, бәріміз күлейік!
Dialogue: 0,0:11:40.00,0:11:45.00,Default,,0,0,0,,Бұл атмосфера тынышталып, біз татуласып аламыз!
Dialogue: 0,0:11:45.00,0:11:48.00,Default,,0,0,0,,Бұл жалпы емес пе?
Dialogue: 0,0:11:49.00,0:11:52.00,Default,,0,0,0,,Мен саған мұның бәрін беремін!
Dialogue: 0,0:11:54.00,0:11:55.00,Default,,0,0,0,,Бұл күлкілі емес.
Dialogue: 0,0:11:55.00,0:11:57.00,Default,,0,0,0,,Қараңызшы, бұл керемет!
Dialogue: 0,0:11:57.00,0:12:00.00,Default,,0,0,0,,Түсіндім, қаншалықты ыңғайлы екенін түсіндім!
Dialogue: 0,0:12:00.00,0:12:02.00,Default,,0,0,0,,Өте әдемі!
Dialogue: 0,0:12:02.00,0:12:04.00,Default,,0,0,0,,Атын айту керек болса, ол Канто Саяка тұрақты болар еді!
Dialogue: 0,0:12:04.00,0:12:06.00,Default,,0,0,0,,Мәңгілік жалпақ!
Dialogue: 0,0:12:06.00,0:12:08.00,Default,,0,0,0,,Дұрыс, дұрыс!
Dialogue: 0,0:12:14.00,0:12:16.00,Default,,0,0,0,,Менің жылағым келеді.
Dialogue: 0,0:12:17.00,0:12:20.00,Default,,0,0,0,,Әсіресе жылау!
Dialogue: 0,0:12:20.00,0:12:22.00,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:12:26.00,0:12:29.00,Default,,0,0,0,,Келесі жолы, Drive! Идиот қыз!
Dialogue: 0,0:12:30.50,0:12:36.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory