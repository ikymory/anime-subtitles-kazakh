Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.00,Default,,0,0,0,,Күнге күйіп қалу қорқынышты
Dialogue: 0,0:00:02.00,0:00:04.00,Default,,0,0,0,,Күнге күйіп қалу қорқынышты
Dialogue: 0,0:00:04.00,0:00:06.00,Default,,0,0,0,,Бүгінгі ауа-райы мен үшін ғана
Dialogue: 0,0:00:06.00,0:00:08.00,Default,,0,0,0,,Жер айналады
Dialogue: 0,0:00:08.00,0:00:10.00,Default,,0,0,0,,Йоккола қатты оқымайды.
Dialogue: 0,0:00:10.00,0:00:12.00,Default,,0,0,0,,Мен көрмейтін махаббатқа шебермін.
Dialogue: 0,0:00:12.00,0:00:14.00,Default,,0,0,0,,Осы жазда бәрінен де жағажайға барғым келеді.
Dialogue: 0,0:00:14.00,0:00:16.00,Default,,0,0,0,,Мен сені сүйемін, сені қалаймын
Dialogue: 0,0:00:16.00,0:00:18.00,Default,,0,0,0,,Ғашық болып, лопуха сезін
Dialogue: 0,0:00:18.00,0:00:20.00,Default,,0,0,0,,Shametsu Love Me Tender
Dialogue: 0,0:00:20.00,0:00:22.00,Default,,0,0,0,,Қырылған мұз Ақкерахан
Dialogue: 0,0:00:22.00,0:00:24.00,Default,,0,0,0,,Дұрыс, данышпан
Dialogue: 0,0:00:24.00,0:00:26.00,Default,,0,0,0,,Құдай - ең жақсы, теңіз - ең жақсы
Dialogue: 0,0:00:26.00,0:00:28.00,Default,,0,0,0,,Ах. Күндізгі бөлімде оқитындар туралы айтсақ, балаларды ұрлау да жиі кездесетін жайт сияқты.
Dialogue: 0,0:00:28.00,0:00:30.00,Default,,0,0,0,,Өткен жаз келді
Dialogue: 0,0:00:30.00,0:00:32.00,Default,,0,0,0,,Жылы үмітпен жазғы демалыс
Dialogue: 0,0:00:32.00,0:00:34.00,Default,,0,0,0,,Ғашық болсаң
Dialogue: 0,0:00:34.00,0:00:36.00,Default,,0,0,0,,Ғашық болсаң
Dialogue: 0,0:00:36.00,0:00:38.00,Default,,0,0,0,,Толық күшке жүгіну
Dialogue: 0,0:00:38.00,0:00:40.00,Default,,0,0,0,,Толық күшке жүгіну
Dialogue: 0,0:00:40.00,0:00:42.00,Default,,0,0,0,,Наносама, еңбегіңіз үшін рахмет
Dialogue: 0,0:00:42.00,0:00:44.00,Default,,0,0,0,,Салқын және сиқырлы
Dialogue: 0,0:00:44.00,0:00:46.00,Default,,0,0,0,,Соңғы тегін
Dialogue: 0,0:00:46.00,0:00:48.00,Default,,0,0,0,,Кім?
Dialogue: 0,0:00:48.00,0:00:50.00,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:00:52.00,0:00:54.00,Default,,0,0,0,,Басталғалы тұрған таң қалдыратын аниме
Dialogue: 0,0:00:54.00,0:00:56.00,Default,,0,0,0,,Менің беттерім мінсіз болып қалады.
Dialogue: 0,0:00:56.00,0:00:58.00,Default,,0,0,0,,Савайашуку
Dialogue: 0,0:01:26.00,0:01:28.00,Default,,0,0,0,,Айтпақшы, жазғы демалыс аяқталды.
Dialogue: 0,0:01:28.00,0:01:30.00,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:01:30.00,0:01:32.00,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:01:32.00,0:01:34.00,Default,,0,0,0,,Көшеде өтіп бара жатқан адамдармен сөйлесуге болмайды.
Dialogue: 0,0:01:34.00,0:01:36.00,Default,,0,0,0,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,0:01:36.00,0:01:38.00,Default,,0,0,0,,Олай болса Ақкүнмен жаттығу жасайық.
Dialogue: 0,0:01:40.00,0:01:42.00,Default,,0,0,0,,Әпкеңмен шай ішкің келе ме?
Dialogue: 0,0:01:42.00,0:01:44.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:01:44.00,0:01:46.00,Default,,0,0,0,,Сіз әлі 28 жаста үлкен әпкесіз бе?
Dialogue: 0,0:01:46.00,0:01:48.00,Default,,0,0,0,,Мен ойламаған жерлерімде жарақат болды.
Dialogue: 0,0:01:50.00,0:01:52.00,Default,,0,0,0,,Қазір жақсы емес
Dialogue: 0,0:01:52.00,0:01:54.00,Default,,0,0,0,,О, зұлымдық жоқ.
Dialogue: 0,0:01:54.00,0:01:56.00,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:01:56.00,0:01:58.00,Default,,0,0,0,,Мұғалімнің көңілін көтерейін бе?
Dialogue: 0,0:01:58.00,0:02:00.00,Default,,0,0,0,,Сіз жағдайды нашарлатқыңыз келмейді ме?
Dialogue: 0,0:02:00.00,0:02:02.00,Default,,0,0,0,,Мен бұған ешқашан жол бере алмаймын.
Dialogue: 0,0:02:02.00,0:02:04.00,Default,,0,0,0,,Бұл зұлымдық емес.
Dialogue: 0,0:02:04.00,0:02:06.00,Default,,0,0,0,,Сіз мұндай сөздерді айта алмайсыз.
Dialogue: 0,0:02:06.00,0:02:08.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:08.00,0:02:10.00,Default,,0,0,0,,Бұрынғы Аккун тым керексіз еді ғой?
Dialogue: 0,0:02:10.00,0:02:12.00,Default,,0,0,0,,Шулы
Dialogue: 0,0:02:16.00,0:02:18.00,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:02:18.00,0:02:20.00,Default,,0,0,0,,Ойлап қарасам, менің өмірім оқу мен еңбектен өтті.
Dialogue: 0,0:02:20.00,0:02:22.00,Default,,0,0,0,,Күлсінгенде бақыт қашады.
Dialogue: 0,0:02:22.00,0:02:24.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:02:24.00,0:02:26.00,Default,,0,0,0,,Кім?
Dialogue: 0,0:02:26.00,0:02:28.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:28.00,0:02:30.00,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:02:30.00,0:02:32.00,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:02:32.00,0:02:34.00,Default,,0,0,0,,Сүйкімді ханшайым
Dialogue: 0,0:02:34.00,0:02:36.00,Default,,0,0,0,,Сүйкімді ханшайым
Dialogue: 0,0:02:36.00,0:02:38.00,Default,,0,0,0,,Бүгін мен профессорды өлтіремін.
Dialogue: 0,0:02:38.00,0:02:40.00,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:02:46.00,0:02:48.00,Default,,0,0,0,,Мен
Dialogue: 0,0:02:48.00,0:02:50.00,Default,,0,0,0,,Маджи
Dialogue: 0,0:02:50.00,0:02:52.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:02:52.00,0:02:54.00,Default,,0,0,0,,Гюн
Dialogue: 0,0:02:54.00,0:02:56.00,Default,,0,0,0,,Тым көп жасамаңыз
Dialogue: 0,0:02:56.00,0:02:58.00,Default,,0,0,0,,Мына кемпірмен
Dialogue: 0,0:02:58.00,0:03:00.00,Default,,0,0,0,,Мұғалім кемпір емес.
Dialogue: 0,0:03:00.00,0:03:02.00,Default,,0,0,0,,Егер сіз 28 жаста болсаңыз, бұл қауіпсіз емес.
Dialogue: 0,0:03:02.00,0:03:04.00,Default,,0,0,0,,Бұл жай ғана ма?
Dialogue: 0,0:03:04.00,0:03:06.00,Default,,0,0,0,,Бакьяро
Dialogue: 0,0:03:06.00,0:03:08.00,Default,,0,0,0,,Бұл жақсы нәрсе, солай ма?
Dialogue: 0,0:03:08.00,0:03:10.00,Default,,0,0,0,,Тіпті банандар
Dialogue: 0,0:03:10.00,0:03:12.00,Default,,0,0,0,,Дәмі бұзылмай тұрып жақсы болады.
Dialogue: 0,0:03:12.00,0:03:14.00,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:03:14.00,0:03:16.00,Default,,0,0,0,,Мұғалімнің батылдығы болса
Dialogue: 0,0:03:16.00,0:03:18.00,Default,,0,0,0,,Олай болса, сен де.
Dialogue: 0,0:03:18.00,0:03:20.00,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:03:20.00,0:03:22.00,Default,,0,0,0,,Қойшы.
Dialogue: 0,0:03:22.00,0:03:24.00,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:03:24.00,0:03:26.00,Default,,0,0,0,,Өйткені, бұл менмін
Dialogue: 0,0:03:26.00,0:03:28.00,Default,,0,0,0,,Мені енді жынды қылма
Dialogue: 0,0:03:28.00,0:03:30.00,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:03:30.00,0:03:32.00,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:03:32.00,0:03:34.00,Default,,0,0,0,,Бакака Бакака
Dialogue: 0,0:03:34.00,0:03:36.00,Default,,0,0,0,,Мен
Dialogue: 0,0:03:36.00,0:03:38.00,Default,,0,0,0,,Мүмкін мен біраз сенімдірек болуым керек шығар.
Dialogue: 0,0:03:38.00,0:03:40.00,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:40.00,0:03:42.00,Default,,0,0,0,,Өйткені ол өте сүйкімді
Dialogue: 0,0:03:42.00,0:03:44.00,Default,,0,0,0,,Толығырақ айтыңыз
Dialogue: 0,0:03:44.00,0:03:46.00,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:03:46.00,0:03:48.00,Default,,0,0,0,,Қосымша
Dialogue: 0,0:03:48.00,0:03:50.00,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:03:50.00,0:03:52.00,Default,,0,0,0,,Егер мұқият қарасаңыз, бұл қалыпты жағдай болуы мүмкін.
Dialogue: 0,0:03:52.00,0:03:54.00,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:03:54.00,0:03:56.00,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:03:56.00,0:03:58.00,Default,,0,0,0,,Жарайсың, сен
Dialogue: 0,0:03:58.00,0:04:00.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:00.00,0:04:02.00,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:04:02.00,0:04:04.00,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:04:04.00,0:04:06.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:04:06.00,0:04:08.00,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:04:10.00,0:04:12.00,Default,,0,0,0,,Менің ең жақсы
Dialogue: 0,0:04:12.00,0:04:14.00,Default,,0,0,0,,Мүмкін, өз-өзімді қабылдауымда сәл айырмашылық бар шығар
Dialogue: 0,0:04:16.00,0:04:18.00,Default,,0,0,0,,Ұстаз сүйген адам болу қиын.
Dialogue: 0,0:04:20.00,0:04:22.00,Default,,0,0,0,,Күнде осындай тәтті сүйіспеншіліктер болса ғой
Dialogue: 0,0:04:22.00,0:04:24.00,Default,,0,0,0,,Қант диабетімен ауыру
Dialogue: 0,0:04:26.00,0:04:28.00,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:30.00,0:04:32.00,Default,,0,0,0,,Яну, мұғалім
Dialogue: 0,0:04:32.00,0:04:34.00,Default,,0,0,0,,Сізде туған күніңізді растайтын құжат бар ма?
Dialogue: 0,0:04:34.00,0:04:36.00,Default,,0,0,0,,Қашан кездесе аламыз?
Dialogue: 0,0:04:38.00,0:04:40.00,Default,,0,0,0,,Әр түнде түсіңізге кіріңіз
Dialogue: 0,0:04:40.00,0:04:42.00,Default,,0,0,0,,Мен сені көруге барамын.
Dialogue: 0,0:04:44.00,0:04:46.00,Default,,0,0,0,,Иә
Dialogue: 0,0:04:50.00,0:04:52.00,Default,,0,0,0,,Қалай
Dialogue: 0,0:04:52.00,0:04:54.00,Default,,0,0,0,,Оның орнына не істеуім керек?
Dialogue: 0,0:05:00.00,0:05:02.00,Default,,0,0,0,,Бүгін де бұталы.
Dialogue: 0,0:05:02.00,0:05:04.00,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:05:04.00,0:05:06.00,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:05:06.00,0:05:08.00,Default,,0,0,0,,Мен және менің итім өте жақынбыз
Dialogue: 0,0:05:08.00,0:05:10.00,Default,,0,0,0,,Сәлем, Йошико-чан
Dialogue: 0,0:05:10.00,0:05:12.00,Default,,0,0,0,,Оны неге ит дейсің?
Dialogue: 0,0:05:12.00,0:05:14.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:05:14.00,0:05:16.00,Default,,0,0,0,,«Уан» деп айқайлайтын мысық па?
Dialogue: 0,0:05:16.00,0:05:18.00,Default,,0,0,0,,Бұл ит болса да
Dialogue: 0,0:05:18.00,0:05:20.00,Default,,0,0,0,,Мм, иттің аты жоқ па екен?
Dialogue: 0,0:05:22.00,0:05:24.00,Default,,0,0,0,,Ой, сен не айтып тұрсың?
Dialogue: 0,0:05:24.00,0:05:26.00,Default,,0,0,0,,Сонымен, иттікі
Dialogue: 0,0:05:26.00,0:05:28.00,Default,,0,0,0,,Сонымен қытай деген кім?
Dialogue: 0,0:05:28.00,0:05:30.00,Default,,0,0,0,,Ван, Чан
Dialogue: 0,0:05:30.00,0:05:32.00,Default,,0,0,0,,Ол иттің аты жоқ па?
Dialogue: 0,0:05:34.00,0:05:36.00,Default,,0,0,0,,Әй, Ақкун.
Dialogue: 0,0:05:36.00,0:05:38.00,Default,,0,0,0,,Аккун
Dialogue: 0,0:05:38.00,0:05:40.00,Default,,0,0,0,,Міне, мұндай иттер көп емес.
Dialogue: 0,0:05:40.00,0:05:42.00,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:05:42.00,0:05:44.00,Default,,0,0,0,,Жақсы бала
Dialogue: 0,0:05:44.00,0:05:46.00,Default,,0,0,0,,Ақкун мырза сондай мейірімді.
Dialogue: 0,0:05:46.00,0:05:48.00,Default,,0,0,0,,Соңғы кезде жақсы дос болып кеткен сияқтымыз.
Dialogue: 0,0:05:50.00,0:05:52.00,Default,,0,0,0,,Егер адамдар сол мейірімділіктен құтылса
Dialogue: 0,0:05:54.00,0:05:56.00,Default,,0,0,0,,Бұл қандай көздер?
Dialogue: 0,0:05:56.00,0:05:58.00,Default,,0,0,0,,Оған иттен басқа атау беріңіз.
Dialogue: 0,0:05:58.00,0:06:00.00,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:06:00.00,0:06:02.00,Default,,0,0,0,,Бұл ит болса да?
Dialogue: 0,0:06:02.00,0:06:04.00,Default,,0,0,0,,Сосын мысық
Dialogue: 0,0:06:04.00,0:06:06.00,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:06:06.00,0:06:08.00,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:06:08.00,0:06:10.00,Default,,0,0,0,,Маған осы итке лайық есім беріңіз.
Dialogue: 0,0:06:10.00,0:06:12.00,Default,,0,0,0,,Неліктен бұлай айттыңыз?
Dialogue: 0,0:06:12.00,0:06:14.00,Default,,0,0,0,,Сіз айтасыз
Dialogue: 0,0:06:14.00,0:06:16.00,Default,,0,0,0,,Ей, тыңда—
Dialogue: 0,0:06:16.00,0:06:18.00,Default,,0,0,0,,Үлкен
Dialogue: 0,0:06:18.00,0:06:20.00,Default,,0,0,0,,ылғалды
Dialogue: 0,0:06:20.00,0:06:22.00,Default,,0,0,0,,Автокөлік
Dialogue: 0,0:06:22.00,0:06:24.00,Default,,0,0,0,,Бірақ ит пе?
Dialogue: 0,0:06:24.00,0:06:26.00,Default,,0,0,0,,Эй, мен оны киемін.
Dialogue: 0,0:06:26.00,0:06:28.00,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:06:28.00,0:06:30.00,Default,,0,0,0,,Жарайды, бүгіннен бастап сен Джорджсың.
Dialogue: 0,0:06:30.00,0:06:32.00,Default,,0,0,0,,Ол американдық.
Dialogue: 0,0:06:32.00,0:06:34.00,Default,,0,0,0,,Мұндай әзіл
Dialogue: 0,0:06:34.00,0:06:36.00,Default,,0,0,0,,Итті ит шақырғаннан жақсы.
Dialogue: 0,0:06:36.00,0:06:38.00,Default,,0,0,0,,Жоқ, мен әзіл мен Джордж ойнаймын.
Dialogue: 0,0:06:38.00,0:06:40.00,Default,,0,0,0,,Тек деңгей
Dialogue: 0,0:06:40.00,0:06:42.00,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:06:42.00,0:06:44.00,Default,,0,0,0,,Осы жігіттің таңдауына рұқсат етемін бе?
Dialogue: 0,0:06:44.00,0:06:46.00,Default,,0,0,0,,Iitomosa
Dialogue: 0,0:06:46.00,0:06:48.00,Default,,0,0,0,,Бірақ иттер мені жақсы көреді
Dialogue: 0,0:06:48.00,0:06:50.00,Default,,0,0,0,,Менің артықшылығым бар
Dialogue: 0,0:06:50.00,0:06:52.00,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:06:52.00,0:06:54.00,Default,,0,0,0,,Мына жігіт екеуміздің достығымыз одан да күшті.
Dialogue: 0,0:06:54.00,0:06:56.00,Default,,0,0,0,,Не?
Dialogue: 0,0:06:56.00,0:06:58.00,Default,,0,0,0,,Қысым
Dialogue: 0,0:06:58.00,0:07:00.00,Default,,0,0,0,,Джордж
Dialogue: 0,0:07:00.00,0:07:02.00,Default,,0,0,0,,Джордж
Dialogue: 0,0:07:02.00,0:07:04.00,Default,,0,0,0,,Маған сен!
Dialogue: 0,0:07:04.00,0:07:06.00,Default,,0,0,0,,Джордж
Dialogue: 0,0:07:06.00,0:07:08.00,Default,,0,0,0,,Джордж
Dialogue: 0,0:07:08.00,0:07:10.00,Default,,0,0,0,,Маған сен!
Dialogue: 0,0:07:10.00,0:07:12.00,Default,,0,0,0,,Неге қашу керек?
Dialogue: 0,0:07:12.00,0:07:14.00,Default,,0,0,0,,Өзіңізге ұнағанын таңдаңыз
Dialogue: 0,0:07:14.00,0:07:16.00,Default,,0,0,0,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:07:16.00,0:07:18.00,Default,,0,0,0,,W-түсінбедің бе?
Dialogue: 0,0:07:18.00,0:07:20.00,Default,,0,0,0,,Өйткені біз де маңыздымыз
Dialogue: 0,0:07:20.00,0:07:22.00,Default,,0,0,0,,Мен екеуінің бірін таңдай алмаймын.
Dialogue: 0,0:07:22.00,0:07:24.00,Default,,0,0,0,,W-түсінбедің бе?
Dialogue: 0,0:07:24.00,0:07:26.00,Default,,0,0,0,,W-түсінбедің бе?
Dialogue: 0,0:07:26.00,0:07:28.00,Default,,0,0,0,,Джордж
Dialogue: 0,0:07:28.00,0:07:30.00,Default,,0,0,0,,Джордж
Dialogue: 0,0:07:30.00,0:07:32.00,Default,,0,0,0,,Джордж
Dialogue: 0,0:07:32.00,0:07:34.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:07:34.00,0:07:36.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:07:36.00,0:07:38.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:38.00,0:07:40.00,Default,,0,0,0,,Мен сізді ат қою үшін алаңдатудың қажеті жоқ.
Dialogue: 0,0:07:40.00,0:07:42.00,Default,,0,0,0,,Сізді ұятқа қалдыру менің шешімім емес.
Dialogue: 0,0:07:42.00,0:07:44.00,Default,,0,0,0,,Дұрыс, Ах-кун.
Dialogue: 0,0:07:44.00,0:07:46.00,Default,,0,0,0,,Сізге тек білу қажет
Dialogue: 0,0:07:46.00,0:07:48.00,Default,,0,0,0,,О
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Ой, сен мені біртүрлі деп атадың.
Dialogue: 0,0:07:50.00,0:07:52.00,Default,,0,0,0,,Бұл таңқаларлық емес
Dialogue: 0,0:07:52.00,0:07:54.00,Default,,0,0,0,,Өзіңізді басқа біреуге айнала алатын иттің орнына қойыңыз.
Dialogue: 0,0:07:54.00,0:07:56.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:56.00,0:07:58.00,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:07:58.00,0:08:00.00,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:08:10.00,0:08:12.00,Default,,0,0,0,,Бұл өте қауіпті.
Dialogue: 0,0:08:12.00,0:08:14.00,Default,,0,0,0,,Гал
Dialogue: 0,0:08:14.00,0:08:16.00,Default,,0,0,0,,Трусики көп көрінетін сияқты.
Dialogue: 0,0:08:16.00,0:08:18.00,Default,,0,0,0,,1-сыныптағы ақымақ әйел
Dialogue: 0,0:08:18.00,0:08:20.00,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:08:20.00,0:08:22.00,Default,,0,0,0,,Оны жайына қалдырайық
Dialogue: 0,0:08:22.00,0:08:24.00,Default,,0,0,0,,Иә
Dialogue: 0,0:08:24.00,0:08:26.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:26.00,0:08:28.00,Default,,0,0,0,,Қараңдар, мен көрдім.
Dialogue: 0,0:08:28.00,0:08:30.00,Default,,0,0,0,,Төңкерілмеңіз
Dialogue: 0,0:08:30.00,0:08:32.00,Default,,0,0,0,,Сіз ұрысып жатырсыз ба?
Dialogue: 0,0:08:32.00,0:08:34.00,Default,,0,0,0,,Маған ондай ақымақ болғаны бәрібір.
Dialogue: 0,0:08:34.00,0:08:36.00,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:36.00,0:08:38.00,Default,,0,0,0,,Оның орнына көңіл көтерейік
Dialogue: 0,0:08:38.00,0:08:40.00,Default,,0,0,0,,That's right.
Dialogue: 0,0:08:40.00,0:08:42.00,Default,,0,0,0,,Шынымды айтсам, мен де ойнағым келеді.
Dialogue: 0,0:08:42.00,0:08:44.00,Default,,0,0,0,,Тестке оқуға болады ма?
Dialogue: 0,0:08:44.00,0:08:46.00,Default,,0,0,0,,That's right.
Dialogue: 0,0:08:46.00,0:08:48.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:08:48.00,0:08:50.00,Default,,0,0,0,,Қыздар оқымайды.
Dialogue: 0,0:08:50.00,0:08:52.00,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:08:52.00,0:08:54.00,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:08:54.00,0:08:56.00,Default,,0,0,0,,Сіз сынақтардан әрқашан 0 ұпай аласыз, солай ма?
Dialogue: 0,0:08:56.00,0:08:58.00,Default,,0,0,0,,Неге ол маған ашулана қарады?
Dialogue: 0,0:08:58.00,0:09:00.00,Default,,0,0,0,,10-ға жуық ұпай жеткілікті.
Dialogue: 0,0:09:00.00,0:09:02.00,Default,,0,0,0,,Идиот
Dialogue: 0,0:09:02.00,0:09:04.00,Default,,0,0,0,,Оқудың азабы ғана
Dialogue: 0,0:09:04.00,0:09:06.00,Default,,0,0,0,,Бұл сәл алыс.
Dialogue: 0,0:09:06.00,0:09:08.00,Default,,0,0,0,,Маған бұл енді ұнамайды.
Dialogue: 0,0:09:08.00,0:09:10.00,Default,,0,0,0,,Маған ермеңіз
Dialogue: 0,0:09:22.00,0:09:24.00,Default,,0,0,0,,Менің артымнан ерме
Dialogue: 0,0:09:24.00,0:09:26.00,Default,,0,0,0,,Тегті ойнау қызықты.
Dialogue: 0,0:09:26.00,0:09:28.00,Default,,0,0,0,,Орындаңыз
Dialogue: 0,0:09:28.00,0:09:30.00,Default,,0,0,0,,Армандар мен тег - мәңгілік қуатын нәрсе
Dialogue: 0,0:09:30.00,0:09:32.00,Default,,0,0,0,,Күнна
Dialogue: 0,0:09:32.00,0:09:34.00,Default,,0,0,0,,Қалағаныңды істе.
Dialogue: 0,0:09:34.00,0:09:36.00,Default,,0,0,0,,Келесі Крамбо
Dialogue: 0,0:09:36.00,0:09:38.00,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:09:38.00,0:09:40.00,Default,,0,0,0,,Бұл туралы емес.
Dialogue: 0,0:09:40.00,0:09:42.00,Default,,0,0,0,,Олай болса, жасырынуымыз нашар.
Dialogue: 0,0:09:42.00,0:09:44.00,Default,,0,0,0,,Маған мысал көрсетіңіз
Dialogue: 0,0:09:44.00,0:09:46.00,Default,,0,0,0,,Шынайы
Dialogue: 0,0:09:46.00,0:09:48.00,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:48.00,0:09:50.00,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:09:50.00,0:09:52.00,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:09:52.00,0:09:54.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:54.00,0:09:56.00,Default,,0,0,0,,Мен бұған көмектесе алмаймын.
Dialogue: 0,0:09:56.00,0:09:58.00,Default,,0,0,0,,Олай болса, мен қысқаша жасырайын, сондықтан оны табуға тырысамын.
Dialogue: 0,0:10:00.00,0:10:02.00,Default,,0,0,0,,Ол жай ғана ақымақ.
Dialogue: 0,0:10:02.00,0:10:04.00,Default,,0,0,0,,Жақында көңіл көтеруге барайық
Dialogue: 0,0:10:08.00,0:10:10.00,Default,,0,0,0,,Иә? Ханабатаке мырза бүгін жабық па?
Dialogue: 0,0:10:12.00,0:10:14.00,Default,,0,0,0,,Бізге алданғандықтан шошып ұйықтап қалды.
Dialogue: 0,0:10:14.00,0:10:16.00,Default,,0,0,0,,Эй, Ханабатаке-сан, тағы да кеттің бе?
Dialogue: 0,0:10:20.00,0:10:22.00,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:10:22.00,0:10:24.00,Default,,0,0,0,,Мен Йошико-чанға электрондық хат жіберген кезде
Dialogue: 0,0:10:24.00,0:10:26.00,Default,,0,0,0,,Біз қазір жасырынбақ ойнап жатырмыз.
Dialogue: 0,0:10:26.00,0:10:28.00,Default,,0,0,0,,Ол сондай ақымақ.
Dialogue: 0,0:10:28.00,0:10:30.00,Default,,0,0,0,,Мен бұған сене алмаймын
Dialogue: 0,0:10:30.00,0:10:32.00,Default,,0,0,0,,Біз анықтағанша
Dialogue: 0,0:10:32.00,0:10:34.00,Default,,0,0,0,,Сондықтан ол көпке дейін жасырылды
Dialogue: 0,0:10:34.00,0:10:36.00,Default,,0,0,0,,Мен үш күннен бері тамақ ішпеймін.
Dialogue: 0,0:10:36.00,0:10:38.00,Default,,0,0,0,,Біздің кінәміз
Dialogue: 0,0:10:38.00,0:10:40.00,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:10:40.00,0:10:42.00,Default,,0,0,0,,Қашаннан бері тығылып жүрсің, ақымақ?
Dialogue: 0,0:10:42.00,0:10:44.00,Default,,0,0,0,,Бұл біздің кінәміз.
Dialogue: 0,0:10:44.00,0:10:46.00,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:10:46.00,0:10:48.00,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:10:48.00,0:10:50.00,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:10:50.00,0:10:52.00,Default,,0,0,0,,Айнадан алыста!
Dialogue: 0,0:10:52.00,0:10:54.00,Default,,0,0,0,,Мен жеткізу қызметін таба алмаймын.
Dialogue: 0,0:10:54.00,0:10:56.00,Default,,0,0,0,,шындап
Dialogue: 0,0:10:56.00,0:10:58.00,Default,,0,0,0,,Бұл тым жасырын, солай емес пе?
Dialogue: 0,0:10:58.00,0:11:00.00,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:11:00.00,0:11:02.00,Default,,0,0,0,,Анау ақымақ сондай жиіркенішті.
Dialogue: 0,0:11:02.00,0:11:04.00,Default,,0,0,0,,Ах
Dialogue: 0,0:11:06.00,0:11:08.00,Default,,0,0,0,,А?
Dialogue: 0,0:11:08.00,0:11:10.00,Default,,0,0,0,,Табылды
Dialogue: 0,0:11:10.00,0:11:12.00,Default,,0,0,0,,Ниндзя Катемеха
Dialogue: 0,0:11:12.00,0:11:13.00,Default,,0,0,0,,Иә
Dialogue: 0,0:11:13.00,0:11:15.00,Default,,0,0,0,,Мен мұны істемеймін
Dialogue: 0,0:11:15.00,0:11:17.00,Default,,0,0,0,,Жарайды, келесіде мен жын боламын.
Dialogue: 0,0:11:17.00,0:11:19.00,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:11:19.00,0:11:21.00,Default,,0,0,0,,Келген жоқпын, үйге барып ұйықтау керек.
Dialogue: 0,0:11:23.00,0:11:25.00,Default,,0,0,0,,Жарайды, қарным ашты.
Dialogue: 0,0:11:25.00,0:11:27.00,Default,,0,0,0,,Жынды деп тым көп жасырсаң, өлесің.
Dialogue: 0,0:11:29.00,0:11:31.00,Default,,0,0,0,,Бұл өте қызық болды
Dialogue: 0,0:11:31.00,0:11:33.00,Default,,0,0,0,,Қайтадан ойнайық
Dialogue: 0,0:11:33.00,0:11:35.00,Default,,0,0,0,,Ешқашан қайта ойнамаңыз
Dialogue: 0,0:11:39.00,0:11:41.00,Default,,0,0,0,,Мен оларды соншалықты ұнатпаймын...
Dialogue: 0,0:11:41.00,0:11:43.00,Default,,0,0,0,,Рури-чан
Dialogue: 0,0:11:43.00,0:11:45.00,Default,,0,0,0,,Иә бар
Dialogue: 0,0:11:45.00,0:11:46.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:46.00,0:11:48.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:48.00,0:11:50.00,Default,,0,0,0,,Құттықтаймыз Рури
Dialogue: 0,0:11:50.00,0:11:52.00,Default,,0,0,0,,Бұл меннен
Dialogue: 0,0:11:52.00,0:11:54.00,Default,,0,0,0,,Түсінуге оңай оқуды ұнататындар
Dialogue: 0,0:11:54.00,0:11:56.00,Default,,0,0,0,,Үлкен ағаның шынайы талдауы
Dialogue: 0,0:11:56.00,0:11:58.00,Default,,0,0,0,,Академиялық білімді қажет етпейтін өмір салтын енгізу Қара
Dialogue: 0,0:12:00.00,0:12:02.00,Default,,0,0,0,,Ыңғайлы болғаны дұрыс.
Dialogue: 0,0:12:02.00,0:12:04.00,Default,,0,0,0,,Маған қолдау көрсетуіңізді өтінемін
Dialogue: 0,0:12:04.00,0:12:06.00,Default,,0,0,0,,Сіз не нәрсеге қанағаттанбайсыз?
Dialogue: 0,0:12:06.00,0:12:08.00,Default,,0,0,0,,Егер сізде бұл болса, оқуға өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:12:08.00,0:12:10.00,Default,,0,0,0,,Мен жалыққым келмейді
Dialogue: 0,0:12:10.00,0:12:12.00,Default,,0,0,0,,Сонымен, сізге не керек еді?
Dialogue: 0,0:12:14.00,0:12:16.00,Default,,0,0,0,,Одан да керемет аға
Dialogue: 0,0:12:20.00,0:12:22.00,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:12:26.00,0:12:30.00,Default,,0,0,0,,Келесі жолы періште ақымақ қыз
Dialogue: 0,0:12:31.50,0:12:37.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory