Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.27,0:00:06.84,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:00:06.84,0:00:08.80,Default,,0,0,0,,（📱）
Dialogue: 0,0:00:09.77,0:00:11.77,Default,,0,0,0,,Кюма, не болды?
Dialogue: 0,0:00:12.77,0:00:16.28,Default,,0,0,0,,Меніңше...бұл шешуші сәт➡
Dialogue: 0,0:00:16.28,0:00:18.81,Default,,0,0,0,,Мен сәтсіздікке жол бере алмаймын.
Dialogue: 0,0:00:18.81,0:00:21.28,Default,,0,0,0,,Презентация материалдарымен де танысамын➡
Dialogue: 0,0:00:21.28,0:00:23.25,Default,,0,0,0,,Кейінірек қайта тексеріңіз.
Dialogue: 0,0:00:25.25,0:00:27.26,Default,,0,0,0,,Ха~….
Dialogue: 0,0:00:39.33,0:00:41.34,Default,,0,0,0,,｟Бұл оңай жол емес➡
Dialogue: 0,0:00:41.34,0:00:43.81,Default,,0,0,0,,Сондықтан тырысып көру керек. ｠
Dialogue: 0,0:00:44.77,0:00:48.28,Default,,0,0,0,,Сол себепті мені таңдағаныңызға сенімдімін➡
Dialogue: 0,0:00:48.28,0:00:50.38,Default,,0,0,0,,Сәлем, Велстра.
Dialogue: 0,0:00:50.38,0:00:54.28,Default,,0,0,0,,｟Тағдыр соғысына қатысуға рұқсат алдыңыз.
Dialogue: 0,0:00:54.28,0:00:56.75,Default,,0,0,0,,Жеңіске жетсең, қалаған тағдырыңды орындай аласың➡
Dialogue: 0,0:00:56.75,0:00:59.79,Default,,0,0,0,,Бұл тамаша шақыру, бірақ мен одан бас тартуым керек.
Dialogue: 0,0:00:59.79,0:01:03.76,Default,,0,0,0,,Не...! Сіздің орындағыңыз келетін тілегіңіз жоқ па?
Dialogue: 0,0:01:03.76,0:01:05.86,Default,,0,0,0,,Әрине бар, бірақ➡
Dialogue: 0,0:01:05.86,0:01:07.76,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:01:07.76,0:01:10.30,Default,,0,0,0,,Қызық емес пе? Мен➡
Dialogue: 0,0:01:10.30,0:01:13.30,Default,,0,0,0,,Бизнес үшін де, авангард үшін де егжей-тегжейлі жоспар жасаңыз➡
Dialogue: 0,0:01:13.30,0:01:16.27,Default,,0,0,0,,Маған заттарды бірте-бірте біріктіру процесі ұнайды➡
Dialogue: 0,0:01:16.27,0:01:18.77,Default,,0,0,0,,Оны өткізіп жіберіп, нәтижелерді алыңыз➡
Dialogue: 0,0:01:18.77,0:01:21.31,Default,,0,0,0,,Бұл мен үшін түкке тұрғысыз.
Dialogue: 0,0:01:21.31,0:01:23.78,Default,,0,0,0,,Сондықтан мен Тағдыр соғысынан бас тартамын.
Dialogue: 0,0:01:27.78,0:01:31.29,Default,,0,0,0,,Сейзо Тайзо➡
Dialogue: 0,0:01:31.29,0:01:34.32,Default,,0,0,0,,Мен сенің тағдыр соғысына қатысқаныңды қалаймын.
Dialogue: 0,0:01:34.32,0:01:36.29,Default,,0,0,0,,Сіз...?
Dialogue: 0,0:01:36.29,0:01:38.26,Default,,0,0,0,,Ұлы Тағдыр соғысынан кейін трагедия күтіп тұр➡
Dialogue: 0,0:01:38.26,0:01:41.26,Default,,0,0,0,,Қатысушы Өлім тағдыры.
Dialogue: 0,0:01:41.26,0:01:43.80,Default,,0,0,0,,Өлім...?
Dialogue: 0,0:01:43.80,0:01:46.27,Default,,0,0,0,,Сіз Тағдыр соғысындағы жалғыз ретсіз адамсыз➡
Dialogue: 0,0:01:46.27,0:01:49.30,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:01:49.30,0:01:53.28,Default,,0,0,0,,Маяк тағдырымен өлім тағдырын өзгерткеніңізді қалаймын.
Dialogue: 0,0:01:53.28,0:01:55.31,Default,,0,0,0,,Бұл оқиға...➡
Dialogue: 0,0:01:55.31,0:01:58.78,Default,,0,0,0,,Бірақ...ол өтірік айтып тұрған жоқ деп ойлаймын.
Dialogue: 0,0:01:59.82,0:02:02.75,Default,,0,0,0,,Сенесің бе...? Бұл сіз туралы➡
Dialogue: 0,0:02:02.75,0:02:04.79,Default,,0,0,0,,Егжей-тегжейлі тыңдағаннан кейін➡
Dialogue: 0,0:02:04.79,0:02:07.76,Default,,0,0,0,,Бірақ алдымен бетпердеңізді шешіп жібере аласыз ба? ➡
Dialogue: 0,0:02:07.76,0:02:10.86,Default,,0,0,0,,Сенім бизнестегі ең маңызды нәрсе➡
Dialogue: 0,0:02:10.86,0:02:13.83,Default,,0,0,0,,Өзінің шынайы болмысын аша алмайтын адаммен жұмыс істеуге болмайды. ｠
Dialogue: 0,0:02:22.27,0:02:25.27,Default,,0,0,0,,Мен бұлай араласамын деп ешқашан ойламадым➡
Dialogue: 0,0:02:25.27,0:02:27.24,Default,,0,0,0,,Бұл да тағдыр.
Dialogue: 0,0:04:00.27,0:04:02.24,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:04:03.27,0:04:05.27,Default,,0,0,0,,Нао-сенпай!
Dialogue: 0,0:04:05.27,0:04:07.41,Default,,0,0,0,,Сәлем, Акитакомачи кіші➡
Dialogue: 0,0:04:07.41,0:04:10.25,Default,,0,0,0,,Не болды? Сіздің бетіңізде әдеттен тыс байсалды көрініспен.
Dialogue: 0,0:04:10.25,0:04:13.25,Default,,0,0,0,,Өтінемін! Өтінемін, араласыңыз!
Dialogue: 0,0:04:13.25,0:04:15.25,Default,,0,0,0,,Әй, бұл бір көргеннен махаббат па?
Dialogue: 0,0:04:15.25,0:04:17.75,Default,,0,0,0,,Сәлем Күрішке бір көргеннен ғашық болыңыз➡
Dialogue: 0,0:04:17.75,0:04:20.29,Default,,0,0,0,,...Бұл емес!
Dialogue: 0,0:04:20.29,0:04:24.26,Default,,0,0,0,,Маған Сейзо Тайзумен шайқаста арнайы дайындыққа көмектесіңізші, солай ма?
Dialogue: 0,0:04:24.26,0:04:26.26,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:04:26.26,0:04:28.80,Default,,0,0,0,,А... ауырады! Сен не істеп жатырсың?
Dialogue: 0,0:04:28.80,0:04:31.27,Default,,0,0,0,,Шатасып жатқан нәрселерді айтқаныңыз үшін.
Dialogue: 0,0:04:32.27,0:04:34.30,Default,,0,0,0,,Мен кешегі төбелесті көрдім➡
Dialogue: 0,0:04:34.30,0:04:36.27,Default,,0,0,0,,Қабілеттің айырмашылығын жақсы түсіндім.
Dialogue: 0,0:04:38.77,0:04:40.74,Default,,0,0,0,,Бұлай жалғаса берсе, мен жеңе алмаймын.
Dialogue: 0,0:04:43.75,0:04:46.25,Default,,0,0,0,,Дұрыс, қазіргі Аки-кун➡
Dialogue: 0,0:04:46.25,0:04:48.28,Default,,0,0,0,,Менің ойымша, жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,0:04:48.28,0:04:50.32,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:50.32,0:04:53.76,Default,,0,0,0,,Тайзо Кийозу тіпті люкс жарысында екінші орынды жеңіп алды➡
Dialogue: 0,0:04:53.76,0:04:55.82,Default,,0,0,0,,Ең жақсы мамандардың жоғарғы жағы.
Dialogue: 0,0:04:55.82,0:04:57.76,Default,,0,0,0,,Тіпті Тағдыр соғысына қатысқан жауынгерлер➡
Dialogue: 0,0:04:57.76,0:04:59.80,Default,,0,0,0,,Бұл ең күшті шығар.
Dialogue: 0,0:04:59.80,0:05:02.76,Default,,0,0,0,,Сәлем... Мен сияқты жаңадан бастаушы үшін қабырға тым биік.
Dialogue: 0,0:05:02.76,0:05:05.23,Default,,0,0,0,,Бірақ мен жеңгім келеді!
Dialogue: 0,0:05:06.27,0:05:08.30,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым➡
Dialogue: 0,0:05:08.30,0:05:10.77,Default,,0,0,0,,Жарайды, апа, киімдеріңізді шешейік!
Dialogue: 0,0:05:37.33,0:05:40.27,Default,,0,0,0,,｟Сәлеметсіз бе, Хикари Мейдо.
Dialogue: 0,0:05:40.27,0:05:42.77,Default,,0,0,0,,Ки… Тайзо Сейзо? ➡
Dialogue: 0,0:05:42.77,0:05:45.24,Default,,0,0,0,,Шын... неге?
Dialogue: 0,0:05:46.78,0:05:48.78,Default,,0,0,0,,Мен қатты таң қалдым➡
Dialogue: 0,0:05:48.78,0:05:51.25,Default,,0,0,0,,Менің ағам Тайзо-санды біледі!
Dialogue: 0,0:05:51.25,0:05:53.28,Default,,0,0,0,,Акина-кун, сен бүгін келмейсің бе?
Dialogue: 0,0:05:53.28,0:05:57.25,Default,,0,0,0,,Мүмкін келер. Мен сұрамасам да күнде келеді.
Dialogue: 0,0:05:57.25,0:05:59.25,Default,,0,0,0,,Ол жақсы аға.
Dialogue: 0,0:05:59.25,0:06:01.26,Default,,0,0,0,,Бұл жай ғана араласу➡
Dialogue: 0,0:06:01.26,0:06:04.26,Default,,0,0,0,,Үнемі біреуді іздеп жүгіру...
Dialogue: 0,0:06:04.26,0:06:06.29,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:06:06.29,0:06:09.80,Default,,0,0,0,,Қиындық көрген адамды жалғыз қалдырмайтын адам түрі менің ағам.
Dialogue: 0,0:06:09.80,0:06:12.77,Default,,0,0,0,,Бірден мойныңды қағып алсаң, көп қиындыққа тап боласың...
Dialogue: 0,0:06:12.77,0:06:15.27,Default,,0,0,0,,Хе, бұл таңданарлық емес пе?
Dialogue: 0,0:06:15.27,0:06:17.31,Default,,0,0,0,,Бұл тамаша ма?➡
Dialogue: 0,0:06:17.31,0:06:20.31,Default,,0,0,0,,Біреу үшін көп жұмыс істеуге болады➡
Dialogue: 0,0:06:20.31,0:06:23.28,Default,,0,0,0,,Менің ойымша, бұл жаман нәрсе емес, бірақ...
Dialogue: 0,0:06:24.28,0:06:26.25,Default,,0,0,0,,Тайзо-сан? Жоқ ➡
Dialogue: 0,0:06:26.25,0:06:28.28,Default,,0,0,0,,Сондай сүйкімді әпкеге➡
Dialogue: 0,0:06:28.28,0:06:30.75,Default,,0,0,0,,Мен сенің ағаңның неліктен барын салып жатқанын түсіндім.
Dialogue: 0,0:06:30.75,0:06:33.32,Default,,0,0,0,,Мені мазақ етпе!
Dialogue: 0,0:06:33.32,0:06:35.76,Default,,0,0,0,,Дұрыс, бұл жанашырлық пудингі➡
Dialogue: 0,0:06:35.76,0:06:37.83,Default,,0,0,0,,Біз іскер серіктестер арасында жақсы беделге ие болдық.
Dialogue: 0,0:06:37.83,0:06:39.83,Default,,0,0,0,,Рахмет! ｠
Dialogue: 0,0:06:43.77,0:06:46.23,Default,,0,0,0,,Біреу үшін...?
Dialogue: 0,0:06:50.34,0:06:52.27,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:06:52.27,0:06:54.28,Default,,0,0,0,,Жасайық~Аки-кун➡
Dialogue: 0,0:06:54.28,0:06:56.78,Default,,0,0,0,,Бұл басынан бастап үлкен айырмашылық.
Dialogue: 0,0:06:56.78,0:06:59.28,Default,,0,0,0,,Сіздің жеңіске жету мүмкіндігіңіз бар деп ойлайсыз ба?
Dialogue: 0,0:06:59.28,0:07:03.29,Default,,0,0,0,,А... Меніңше, шындық сәл қатал.
Dialogue: 0,0:07:05.29,0:07:08.79,Default,,0,0,0,,Бірақ он мыңнан бір адам жүзден бір болған шығар?
Dialogue: 0,0:07:08.79,0:07:11.76,Default,,0,0,0,,Демек, бұрынғыдан да жақсы, солай ма?
Dialogue: 0,0:07:11.76,0:07:14.30,Default,,0,0,0,,Ah...un. Жақсы!
Dialogue: 0,0:07:14.30,0:07:18.27,Default,,0,0,0,,Егер сіз аз болса да прогреске қол жеткізсеңіз, мүмкіндік нөлге тең емес➡
Dialogue: 0,0:07:18.27,0:07:21.27,Default,,0,0,0,,Егер ол нөл болмаса, ол сізге жетуі мүмкін➡
Dialogue: 0,0:07:21.27,0:07:23.24,Default,,0,0,0,,, солай ма?
Dialogue: 0,0:07:25.77,0:07:27.81,Default,,0,0,0,,Бұл сіздің ниетіңіз!
Dialogue: 0,0:07:27.81,0:07:29.81,Default,,0,0,0,,Олай болса мен сенімен бірге боламын!
Dialogue: 0,0:07:29.81,0:07:33.28,Default,,0,0,0,,Менің үйіме кел! жоғары! жұмысшы...?
Dialogue: 0,0:07:39.85,0:07:42.26,Default,,0,0,0,,О! Жоғары сынып оқушыларына ➡
Dialogue: 0,0:07:42.26,0:07:44.26,Default,,0,0,0,,Бұл аздап ынталандырды ма?
Dialogue: 0,0:07:44.26,0:07:46.26,Default,,0,0,0,,Сәлем! Мен карталарды жақсы көретін сияқтымын➡
Dialogue: 0,0:07:46.26,0:07:48.30,Default,,0,0,0,,Бұл өтіп жатыр!
Dialogue: 0,0:07:48.30,0:07:51.77,Default,,0,0,0,,Дұрыс? Ендеше бірден жасайық.
Dialogue: 0,0:07:55.84,0:07:57.81,Default,,0,0,0,,｟Тайзомен қабілет айырмашылығы...➡
Dialogue: 0,0:07:57.81,0:08:01.34,Default,,0,0,0,,Оны толтыру үшін, жүзден бір керемет ➡
Dialogue: 0,0:08:01.34,0:08:03.31,Default,,0,0,0,,Сені оятудан басқа амалым жоқ. ｠
Dialogue: 0,0:08:07.28,0:08:10.25,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:08:11.25,0:08:13.76,Default,,0,0,0,,Тағы да мәлімдеймін➡
Dialogue: 0,0:08:13.76,0:08:15.76,Default,,0,0,0,,Мен Акина Мейдоны жеңемін.
Dialogue: 0,0:08:18.29,0:08:20.26,Default,,0,0,0,,Мен осындай нәрсемен барамын деп ойлаймын➡
Dialogue: 0,0:08:20.26,0:08:23.26,Default,,0,0,0,,Бұл әлі де жақсы емес пе?
Dialogue: 0,0:08:23.26,0:08:25.30,Default,,0,0,0,,Сіз өте ыстықсыз!
Dialogue: 0,0:08:25.30,0:08:28.77,Default,,0,0,0,,E? Әділдік пен зұлымдық бір тиынның екі жағы➡
Dialogue: 0,0:08:28.77,0:08:31.31,Default,,0,0,0,,Дұрыс жауапты ешкім білмейді.
Dialogue: 0,0:08:31.31,0:08:33.78,Default,,0,0,0,,Сондықтан таңдау еркі өте маңызды.
Dialogue: 0,0:08:33.78,0:08:36.24,Default,,0,0,0,,Дәл қазір Акикун сияқты.
Dialogue: 0,0:08:37.25,0:08:39.25,Default,,0,0,0,,Олай болса...!
Dialogue: 0,0:08:39.25,0:08:41.25,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:08:43.75,0:08:46.25,Default,,0,0,0,,Иә, мен көптен күттім.
Dialogue: 0,0:08:49.76,0:08:51.76,Default,,0,0,0,,Сен де келдің.
Dialogue: 0,0:08:51.76,0:08:53.76,Default,,0,0,0,,Өйткені... мен қызықпын.
Dialogue: 0,0:08:53.76,0:08:55.76,Default,,0,0,0,,Бұл ұрыс па? Немесе...
Dialogue: 0,0:08:55.76,0:08:58.23,Default,,0,0,0,,Бұл жекпе-жек болуды шешті!
Dialogue: 0,0:08:59.40,0:09:02.90,Default,,0,0,0,,Акина Мейдо! Сейзо Тайзо! ➡
Dialogue: 0,0:09:02.90,0:09:05.41,Default,,0,0,0,,Енді тағдыр картасын көтеріңіз!
Dialogue: 0,0:09:09.28,0:09:11.75,Default,,0,0,0,,Тағдыр. Осы қолында.
Dialogue: 0,0:09:11.75,0:09:13.75,Default,,0,0,0,,Құдай!
Dialogue: 0,0:09:15.75,0:09:17.79,Default,,0,0,0,,Уақыттың толықтығы!
Dialogue: 0,0:09:17.79,0:09:20.79,Default,,0,0,0,,Тағдырымызды өзгертетін үшінші шайқасқа кірісейік!
Dialogue: 0,0:09:21.79,0:09:23.76,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:09:23.76,0:09:26.26,Default,,0,0,0,,Мен бар күшімді саламын.
Dialogue: 0,0:09:27.33,0:09:29.76,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:09:29.76,0:09:32.27,Default,,0,0,0,,Блиц бойынша бас механик Бартон.
Dialogue: 0,0:09:32.27,0:09:34.77,Default,,0,0,0,,Амбиция қанаттары Соел.
Dialogue: 0,0:09:34.77,0:09:37.77,Default,,0,0,0,,Менің кезегім: Стразаға бару➡
Dialogue: 0,0:09:37.77,0:09:40.78,Default,,0,0,0,,Энергия генераторын орнатыңыз және бұрылысты аяқтаңыз.
Dialogue: 0,0:09:40.78,0:09:43.75,Default,,0,0,0,,Менің кезегім: Бентестаға мініңіз➡
Dialogue: 0,0:09:43.75,0:09:45.75,Default,,0,0,0,,Шеберлікпен 1 картаны сал.
Dialogue: 0,0:09:45.75,0:09:47.78,Default,,0,0,0,,Энергия генераторын орнатыңыз➡
Dialogue: 0,0:09:47.78,0:09:49.78,Default,,0,0,0,,Энергия заряды!
Dialogue: 0,0:09:49.78,0:09:51.75,Default,,0,0,0,,Антеннаға қоңырау шалыңыз!
Dialogue: 0,0:09:51.75,0:09:53.76,Default,,0,0,0,,Бентестамен шабуыл!
Dialogue: 0,0:09:53.76,0:09:56.26,Default,,0,0,0,,Күзетші жоқ. Жақсы! ➡
Dialogue: 0,0:09:56.26,0:09:58.76,Default,,0,0,0,,Антеннамен шабуылды жалғастырыңыз!
Dialogue: 0,0:09:58.76,0:10:00.76,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:10:00.76,0:10:03.80,Default,,0,0,0,,Менің кезегім Юбаға мінемін.
Dialogue: 0,0:10:03.80,0:10:07.90,Default,,0,0,0,,Эйнгартенді қолыңызға қосып, оны Стразаның шеберлігімен орнатыңыз!
Dialogue: 0,0:10:07.90,0:10:10.77,Default,,0,0,0,,｟Келіңіз... өнім картасы. ｠
Dialogue: 0,0:10:10.77,0:10:13.27,Default,,0,0,0,,Юбамен➡ шабуыл жасау шеберлігі бойынша
Dialogue: 0,0:10:13.27,0:10:15.28,Default,,0,0,0,,Эйнгартен жұмыс істейді.
Dialogue: 0,0:10:15.28,0:10:18.25,Default,,0,0,0,,Бірлік ретінде қоңырау шалыңыз! күзетші!
Dialogue: 0,0:10:18.25,0:10:20.25,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:10:20.25,0:10:23.79,Default,,0,0,0,,Эйнгартеннің күші плюс 10000➡ триггерін сызыңыз
Dialogue: 0,0:10:23.79,0:10:26.75,Default,,0,0,0,,Біздің питомнигіміз жаудан кек алады!
Dialogue: 0,0:10:26.75,0:10:29.79,Default,,0,0,0,,Эйнгартенмен шабуыл! күзетші!
Dialogue: 0,0:10:29.79,0:10:33.29,Default,,0,0,0,,Эйнгартенді тапсырыс аймағына қайтарып, бұрылысты аяқтаңыз.
Dialogue: 0,0:10:34.33,0:10:36.33,Default,,0,0,0,,｟Өнімдерге шабуыл➡
Dialogue: 0,0:10:36.33,0:10:39.30,Default,,0,0,0,,Сіз карталарыңызды сақтап жатырсыз ба? Олай болса... ｠
Dialogue: 0,0:10:39.30,0:10:42.77,Default,,0,0,0,,Менің кезегім! Азенсиорға барыңыз!
Dialogue: 0,0:10:42.77,0:10:44.77,Default,,0,0,0,,Бентестаға шеберлікпен қоңырау шалыңыз!
Dialogue: 0,0:10:44.77,0:10:47.81,Default,,0,0,0,,Пентаглема сиқыршыға қоңырау шалыңыз!
Dialogue: 0,0:10:47.81,0:10:51.78,Default,,0,0,0,,Палубаның жоғарғы картасын көру үшін өзіңіздің дағдыларыңызды пайдаланыңыз...
Dialogue: 0,0:10:51.78,0:10:53.75,Default,,0,0,0,,Үстіне қойыңыз.
Dialogue: 0,0:10:54.75,0:10:56.75,Default,,0,0,0,,Call Plus Paras!
Dialogue: 0,0:10:56.75,0:10:58.79,Default,,0,0,0,,Азеншиормен шабуыл!
Dialogue: 0,0:10:58.79,0:11:00.76,Default,,0,0,0,,Күзет. Көлікті тексеру!
Dialogue: 0,0:11:01.79,0:11:05.76,Default,,0,0,0,,Алдыңғы триггер! Алдыңғы қатардағы барлық адамдар үшін қуат плюс 10 000!
Dialogue: 0,0:11:05.76,0:11:07.76,Default,,0,0,0,,Plus Paras көмегімен шабуыл!
Dialogue: 0,0:11:07.76,0:11:09.76,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:11:09.76,0:11:11.77,Default,,0,0,0,,Пентаглеммен шабуыл!
Dialogue: 0,0:11:11.77,0:11:13.77,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:11:13.77,0:11:15.77,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:11:15.77,0:11:17.77,Default,,0,0,0,,Ей, басынан шабуыл жасайық.
Dialogue: 0,0:11:17.77,0:11:19.81,Default,,0,0,0,,Бірінші қадам – жеңіске кепілдік беріледі!
Dialogue: 0,0:11:19.81,0:11:23.75,Default,,0,0,0,,Керемет! Жұмыста да, төбелесте де бастаманың маңызы зор.
Dialogue: 0,0:11:23.75,0:11:26.75,Default,,0,0,0,,Онда мен байыпты жауап беруім керек.
Dialogue: 0,0:11:28.35,0:11:31.25,Default,,0,0,0,,Сізге бас директорымыздың қаһармандық қырын көрсетуге рұқсат етіңіз!
Dialogue: 0,0:11:31.25,0:11:33.29,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:11:33.29,0:11:37.79,Default,,0,0,0,,Менің зерттелмегенді ашу туралы шешімім ➡
Dialogue: 0,0:11:37.79,0:11:42.26,Default,,0,0,0,,Destiny Velstra Blitz Arms шамшырағы➡
Dialogue: 0,0:11:42.26,0:11:44.23,Default,,0,0,0,,Жүр!
Dialogue: 0,0:11:51.77,0:11:54.28,Default,,0,0,0,,Юбаның шеберлігі Палубадан➡
Dialogue: 0,0:11:54.28,0:11:57.31,Default,,0,0,0,,Жылжымалы бекініс Фрайшуц Максим және ➡
Dialogue: 0,0:11:57.31,0:12:00.78,Default,,0,0,0,,Қолыңызға максималды спутниктік Euryante қаруын қосыңыз!
Dialogue: 0,0:12:00.78,0:12:02.92,Default,,0,0,0,,Бас директордың арнайы артықшылықтары!
Dialogue: 0,0:12:02.92,0:12:04.79,Default,,0,0,0,,｟Келіңіз...! ｠
Dialogue: 0,0:12:04.79,0:12:08.29,Default,,0,0,0,,Liberation белгісі! Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:12:10.29,0:12:13.76,Default,,0,0,0,,Фрейшуц Максим мен Евриантты қолыңызға қойыңыз➡
Dialogue: 0,0:12:13.76,0:12:15.80,Default,,0,0,0,,Максим жұмыс істеп жатыр!
Dialogue: 0,0:12:15.80,0:12:19.77,Default,,0,0,0,,Паллас плюс шегініп, қарсыластың авангардының күшін -5000-ға дейін азайтыңыз!
Dialogue: 0,0:12:20.77,0:12:23.77,Default,,0,0,0,,Сонымен қатар, Euryante➡ орнату арқылы
Dialogue: 0,0:12:23.77,0:12:25.74,Default,,0,0,0,,Бір картаны тартып, энергияны зарядтаңыз!
Dialogue: 0,0:12:25.74,0:12:27.78,Default,,0,0,0,,Любезарды орнатыңыз!
Dialogue: 0,0:12:27.78,0:12:30.75,Default,,0,0,0,,Осы уақытта шеберлікпен комбайнды шақырыңыз!
Dialogue: 0,0:12:30.75,0:12:33.25,Default,,0,0,0,,Биіктікке көбірек ұшуға шақырулар!
Dialogue: 0,0:12:33.25,0:12:35.75,Default,,0,0,0,,Жүр, кеттік!
Dialogue: 0,0:12:35.75,0:12:37.75,Default,,0,0,0,,Fly Heights шабуылы!
Dialogue: 0,0:12:37.75,0:12:40.26,Default,,0,0,0,,Максимді осы дағдымен қайта іске қосыңыз!
Dialogue: 0,0:12:40.26,0:12:43.76,Default,,0,0,0,,Әуеден шегініңіз! күзетші!
Dialogue: 0,0:12:43.76,0:12:46.83,Default,,0,0,0,,Авангардқа Велстрамен шабуыл жасаңыз!
Dialogue: 0,0:12:46.83,0:12:49.76,Default,,0,0,0,,Дағды іске қосылды! Қуатыңызға 10 000 қосыңыз➡
Dialogue: 0,0:12:49.76,0:12:51.80,Default,,0,0,0,,Максим қайтадан жұмысқа кірісті!
Dialogue: 0,0:12:51.80,0:12:54.77,Default,,0,0,0,,Бентеста мен Фрайшуц Максимді шегіндіріңіз➡
Dialogue: 0,0:12:54.77,0:12:57.27,Default,,0,0,0,,Бірлік ретінде қоңырау шалыңыз!
Dialogue: 0,0:12:57.27,0:12:59.41,Default,,0,0,0,,Сорти!
Dialogue: 0,0:12:59.41,0:13:01.28,Default,,0,0,0,,｟Ол осында...ол үлкен... ｠
Dialogue: 0,0:13:01.28,0:13:03.28,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:13:03.28,0:13:05.78,Default,,0,0,0,,Бірінші тексеру.
Dialogue: 0,0:13:05.78,0:13:08.25,Default,,0,0,0,,Екінші тексеру... триггер жоқ.
Dialogue: 0,0:13:11.29,0:13:15.26,Default,,0,0,0,,Ой, жеңілдеп қалуға әлі ерте➡
Dialogue: 0,0:13:15.26,0:13:17.26,Default,,0,0,0,,Комбайнмен шабуылды жалғастырыңыз!
Dialogue: 0,0:13:17.26,0:13:19.79,Default,,0,0,0,,Күзетші! Жеңдер➡
Dialogue: 0,0:13:19.79,0:13:23.30,Default,,0,0,0,,Максиммен бірге бекінісіме шабуыл жасаңыз!
Dialogue: 0,0:13:25.27,0:13:27.27,Default,,0,0,0,,Тазалау!
Dialogue: 0,0:13:29.27,0:13:31.24,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:13:34.28,0:13:36.78,Default,,0,0,0,,Максималды тапсырыс аймағына қайтару➡
Dialogue: 0,0:13:36.78,0:13:38.85,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:13:38.85,0:13:40.75,Default,,0,0,0,,｜Қанша шабуыл жасап, бар күшіммен қорғандым➡
Dialogue: 0,0:13:40.75,0:13:42.82,Default,,0,0,0,,Зақымдану айырмашылығы қолайлы.
Dialogue: 0,0:13:42.82,0:13:44.79,Default,,0,0,0,,Бірақ... ｠
Dialogue: 0,0:13:44.79,0:13:48.82,Default,,0,0,0,,Қолым, тақтайым, жүрегім әлсірей бастады.
Dialogue: 0,0:13:48.82,0:13:51.26,Default,,0,0,0,,Дегенмен, мен қазір не істей аламын➡
Dialogue: 0,0:13:51.26,0:13:53.26,Default,,0,0,0,,Бар күшіңізді салыңыз!
Dialogue: 0,0:13:56.73,0:13:59.23,Default,,0,0,0,,Кеттік... менің кезегім!
Dialogue: 0,0:13:59.23,0:14:01.77,Default,,0,0,0,,Құтқару қанаттары Міне, көктен!
Dialogue: 0,0:14:01.77,0:14:04.77,Default,,0,0,0,,Резаэльдің ғажайып тағдырына мініңіз!
Dialogue: 0,0:14:10.75,0:14:13.75,Default,,0,0,0,,Садиге шеберлікпен қоңырау шалыңыз!
Dialogue: 0,0:14:13.75,0:14:15.75,Default,,0,0,0,,Осы дағдымен бір картаны сал!
Dialogue: 0,0:14:15.75,0:14:17.82,Default,,0,0,0,,Фуфупури мен Гаругаонға қоңырау шалыңыз!
Dialogue: 0,0:14:17.82,0:14:19.79,Default,,0,0,0,,Мен де осында барамын.
Dialogue: 0,0:14:19.79,0:14:23.29,Default,,0,0,0,,Ғажайып келу Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:14:24.76,0:14:27.73,Default,,0,0,0,,Критикалық триггерді түсіру Барлығын палубаға қайтару➡
Dialogue: 0,0:14:27.73,0:14:29.73,Default,,0,0,0,,Rezael's Drive Plus 1!
Dialogue: 0,0:14:30.73,0:14:33.23,Default,,0,0,0,,Сынины ерте кезеңде сақшы ретінде қолданыңыз➡
Dialogue: 0,0:14:33.23,0:14:35.24,Default,,0,0,0,,Мұны Резаелдің құдай шеберлігімен жасаңыз➡
Dialogue: 0,0:14:35.24,0:14:38.27,Default,,0,0,0,,Оны палубаға қайтарып, шабуылға өтіңіз.
Dialogue: 0,0:14:38.27,0:14:41.24,Default,,0,0,0,,Бұл карталардың сипаттамаларын анық түсінетін стратегия.
Dialogue: 0,0:14:41.24,0:14:44.38,Default,,0,0,0,,Осы уақытқа дейін жақсы оқығаныңызды көріп тұрмын.
Dialogue: 0,0:14:44.38,0:14:47.88,Default,,0,0,0,,Менде ең жақсы мұғалім бар!
Dialogue: 0,0:14:49.28,0:14:51.25,Default,,0,0,0,,Садимен шабуыл!
Dialogue: 0,0:14:51.25,0:14:53.25,Default,,0,0,0,,Кесу.
Dialogue: 0,0:14:53.25,0:14:56.22,Default,,0,0,0,,Шабуыл жасау дағдысы Резаэльмен бірге Авангардта белсендіріледі!
Dialogue: 0,0:14:56.22,0:14:59.73,Default,,0,0,0,,...
Dialogue: 0,0:14:59.73,0:15:01.76,Default,,0,0,0,,...
Dialogue: 0,0:15:01.76,0:15:03.73,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:15:04.73,0:15:06.73,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:15:07.74,0:15:09.77,Default,,0,0,0,,Үшінші тексеру….
Dialogue: 0,0:15:09.77,0:15:13.24,Default,,0,0,0,,１００００
Dialogue: 0,0:15:13.24,0:15:15.24,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:15:15.24,0:15:17.25,Default,,0,0,0,,Plus Paras көмегімен шабуыл!
Dialogue: 0,0:15:17.25,0:15:19.28,Default,,0,0,0,,...
Dialogue: 0,0:15:19.28,0:15:21.25,Default,,0,0,0,,Пентаглеммен шабуыл! Күзетші жоқ.
Dialogue: 0,0:15:21.25,0:15:23.22,Default,,0,0,0,,Зақымдануды тексеру 1-тармақ….
Dialogue: 0,0:15:24.75,0:15:28.22,Default,,0,0,0,,Екінші нүкте... емдік триггер!
Dialogue: 0,0:15:28.22,0:15:30.22,Default,,0,0,0,,1 залал қалпына келтірілді.
Dialogue: 0,0:15:30.22,0:15:34.26,Default,,0,0,0,,Осымен... кезек аяқталды.
Dialogue: 0,0:15:34.26,0:15:36.26,Default,,0,0,0,,Ахх.
Dialogue: 0,0:15:36.26,0:15:38.27,Default,,0,0,0,,➡
Dialogue: 0,0:15:38.27,0:15:42.24,Default,,0,0,0,,Ол сізге жетпейтін сияқты. Шынымды айтсам, мен де солай ойлаймын.
Dialogue: 0,0:15:42.24,0:15:44.27,Default,,0,0,0,,Ал... онда не істеуіміз керек?
Dialogue: 0,0:15:44.27,0:15:46.74,Default,,0,0,0,,Тек жеңіске ұмтылыңыз.
Dialogue: 0,0:15:46.74,0:15:49.78,Default,,0,0,0,,Саған жете алмасам да, күшім жетпесе де➡
Dialogue: 0,0:15:49.78,0:15:52.75,Default,,0,0,0,,Бұл бас тартуға себеп емес!
Dialogue: 0,0:15:52.75,0:15:55.25,Default,,0,0,0,,Бұл ынта керемет!
Dialogue: 0,0:15:55.25,0:15:59.25,Default,,0,0,0,,Олай болса, шамшырағымның жарығын алуға тырыс!
Dialogue: 0,0:15:59.25,0:16:02.72,Default,,0,0,0,,Менің кезегім Persona Ride!
Dialogue: 0,0:16:02.72,0:16:06.73,Default,,0,0,0,,Velstra комбайнына қоңырау шалыңыз және тур!
Dialogue: 0,0:16:06.73,0:16:08.73,Default,,0,0,0,,Авангардқа Велстрамен шабуыл жасаңыз!
Dialogue: 0,0:16:08.73,0:16:11.23,Default,,0,0,0,,Euryante-ді дағдылармен басқарыңыз!
Dialogue: 0,0:16:11.23,0:16:13.73,Default,,0,0,0,,Оны арнайы орындардан тамашалау керек.
Dialogue: 0,0:16:14.77,0:16:18.77,Default,,0,0,0,,Аспанның арғы жағында, біздің компанияға жол көрсететін шамшырақ жұлдыз!
Dialogue: 0,0:16:21.74,0:16:23.74,Default,,0,0,0,,Eurianthe іске қосылғанда➡
Dialogue: 0,0:16:23.74,0:16:25.75,Default,,0,0,0,,Бір тыл сақшысын шығарып тастаңыз➡
Dialogue: 0,0:16:25.75,0:16:28.25,Default,,0,0,0,,Авангард күші минус 10000➡
Dialogue: 0,0:16:28.25,0:16:30.25,Default,,0,0,0,,Тағы 1 зиян келтіріңіз!
Dialogue: 0,0:16:30.25,0:16:33.25,Default,,0,0,0,,Жасай бер, тағдырды өзгертетін зеңбіректер!
Dialogue: 0,0:16:33.25,0:16:35.22,Default,,0,0,0,,Іске қосу~!
Dialogue: 0,0:16:38.23,0:16:40.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:42.23,0:16:45.23,Default,,0,0,0,,Белстраның шабуылы әлі қалды!
Dialogue: 0,0:16:47.74,0:16:49.74,Default,,0,0,0,,...
Dialogue: 0,0:16:50.74,0:16:52.74,Default,,0,0,0,,Мм...Мында күзетші бар ма?
Dialogue: 0,0:16:53.74,0:16:55.71,Default,,0,0,0,,Бірінші тексеру.
Dialogue: 0,0:16:56.74,0:17:00.25,Default,,0,0,0,,Екінші тексеру…Триггерді тартыңыз!
Dialogue: 0,0:17:00.25,0:17:02.38,Default,,0,0,0,,1 картаны сал.
Dialogue: 0,0:17:02.38,0:17:05.12,Default,,0,0,0,,｟Қолында 4 карта бар күзет…. ｠
Dialogue: 0,0:17:05.12,0:17:06.89,Default,,0,0,0,,｟Сыни хиттерден қорқасыз ба? ｠
Dialogue: 0,0:17:06.89,0:17:09.86,Default,,0,0,0,,｟Акинаның қолында бір карта қалды. ｠
Dialogue: 0,0:17:09.86,0:17:13.39,Default,,0,0,0,,｟Осы уақытқа дейін бірде-бір тамаша күзетшіні көрмегенім... ｠
Dialogue: 0,0:17:13.39,0:17:16.90,Default,,0,0,0,,｟Бұл толық күзет болу мүмкіндігі жоғары. ｠
Dialogue: 0,0:17:16.90,0:17:19.87,Default,,0,0,0,,｟Құдайдың шеберлігін қалпына келтіру де қиын. ｠
Dialogue: 0,0:17:21.57,0:17:23.24,Default,,0,0,0,,｟Міне... ｠
Dialogue: 0,0:17:23.24,0:17:25.24,Default,,0,0,0,,Комбайнмен шабуыл плюс парас!
Dialogue: 0,0:17:25.24,0:17:27.24,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:17:27.24,0:17:29.24,Default,,0,0,0,,Мен тыл сақшысын жоюға келдім➡
Dialogue: 0,0:17:29.24,0:17:32.28,Default,,0,0,0,,Мен Ақина-сенпайдың күшін кемітейін деп жатырмын.
Dialogue: 0,0:17:32.28,0:17:35.75,Default,,0,0,0,,Турда шабуыл шеберлігімен Максимді белсендіріңіз!
Dialogue: 0,0:17:35.75,0:17:37.75,Default,,0,0,0,,Фуфупуриден шегіну➡
Dialogue: 0,0:17:37.75,0:17:39.72,Default,,0,0,0,,Фрайшуц Максимге де қоңырау шалыңыз!
Dialogue: 0,0:17:40.72,0:17:42.72,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:17:42.72,0:17:45.23,Default,,0,0,0,,Максим ретінде Пентаглеммен шабуыл жасаңыз!
Dialogue: 0,0:17:45.23,0:17:47.23,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:17:47.23,0:17:49.23,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:17:50.26,0:17:53.73,Default,,0,0,0,,Резаэлдің құдайлық шеберлігі тек бір рет қалпына келеді.
Dialogue: 0,0:17:53.73,0:17:55.77,Default,,0,0,0,,Келесі менің кезегім➡
Dialogue: 0,0:17:55.77,0:17:59.24,Default,,0,0,0,,Шабуылмен жағдайды реттеу үшін бір рет қалпына келтіру жеткіліксіз болады.
Dialogue: 0,0:17:59.24,0:18:01.74,Default,,0,0,0,,Мен тіпті қорғаныс туралы ойламаймын.
Dialogue: 0,0:18:01.74,0:18:03.74,Default,,0,0,0,,Бар күшіңізбен шабуыл жасаңыз!
Dialogue: 0,0:18:03.74,0:18:05.75,Default,,0,0,0,,Бұл жалғыз жол.
Dialogue: 0,0:18:05.75,0:18:09.28,Default,,0,0,0,,Бірақ... тақта жойқын➡
Dialogue: 0,0:18:09.28,0:18:12.29,Default,,0,0,0,,Сіздің қолыңызда қалғаны толық күзетші болуы мүмкін.
Dialogue: 0,0:18:12.29,0:18:14.72,Default,,0,0,0,,Егер солай болса, онда шабуыл күші тек белгілі болады.
Dialogue: 0,0:18:14.72,0:18:16.76,Default,,0,0,0,,Ал...
Dialogue: 0,0:18:16.76,0:18:19.23,Default,,0,0,0,,Егер бұл толық күзетші болса!
Dialogue: 0,0:18:19.23,0:18:22.26,Default,,0,0,0,,Не? Менің палубамда➡
Dialogue: 0,0:18:22.26,0:18:25.73,Default,,0,0,0,,Толық қорғаныс немесе емдеу триггері жоқ!
Dialogue: 0,0:18:25.73,0:18:28.27,Default,,0,0,0,,Жоқ...! Ха?
Dialogue: 0,0:18:28.27,0:18:31.27,Default,,0,0,0,,Сонымен бірінші қарауыл блеф пе?
Dialogue: 0,0:18:32.74,0:18:35.24,Default,,0,0,0,,Бұл құмар ойын болды.
Dialogue: 0,0:18:35.24,0:18:37.24,Default,,0,0,0,,Бұл не, ақымақ?
Dialogue: 0,0:18:37.24,0:18:39.25,Default,,0,0,0,,Тежегіштер толығымен бұзылған.
Dialogue: 0,0:18:39.25,0:18:41.78,Default,,0,0,0,,Бұл тіпті тиімді шара емес.
Dialogue: 0,0:18:41.78,0:18:44.75,Default,,0,0,0,,Қалыпты құрылыспен жоғары жаққа ұмтылған дұрыс...!
Dialogue: 0,0:18:44.75,0:18:46.79,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,0:18:46.79,0:18:48.76,Default,,0,0,0,,Бірақ маңыздысы Акидің жеңуі➡
Dialogue: 0,0:18:48.76,0:18:50.73,Default,,0,0,0,,Өзіңіз ойланғаннан кейін қабылданған шешім.
Dialogue: 0,0:18:50.73,0:18:53.79,Default,,0,0,0,,Сынақ пен қатені қажет ететін карта ойыны.
Dialogue: 0,0:18:53.79,0:18:56.23,Default,,0,0,0,,Сәтсіздіктен қорықпай қол созу батылдығы➡
Dialogue: 0,0:18:56.23,0:18:58.23,Default,,0,0,0,,Бұл керемет деп ойламайсыз ба?
Dialogue: 0,0:18:58.23,0:19:00.23,Default,,0,0,0,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:19:01.30,0:19:04.24,Default,,0,0,0,,Уау... бұл әдеттен тыс сызба, солай емес пе?
Dialogue: 0,0:19:04.24,0:19:06.27,Default,,0,0,0,,Мен қорғанысты лақтырып тастадым.
Dialogue: 0,0:19:06.27,0:19:09.24,Default,,0,0,0,,100-ден біреуін ұстау үшін!
Dialogue: 0,0:19:09.24,0:19:11.75,Default,,0,0,0,,100 реттен 1?
Dialogue: 0,0:19:11.75,0:19:13.75,Default,,0,0,0,,Мен және Тайзо-сан үшін аспан мен жердей➡
Dialogue: 0,0:19:13.75,0:19:15.78,Default,,0,0,0,,Қабілеттің айырмашылығы бар екенін білемін.
Dialogue: 0,0:19:15.78,0:19:18.75,Default,,0,0,0,,100 рет ұрыссаң, 99 рет ұтыласың.
Dialogue: 0,0:19:18.75,0:19:21.76,Default,,0,0,0,,Бірақ сіз бір рет жеңе аласыз.
Dialogue: 0,0:19:21.76,0:19:24.73,Default,,0,0,0,,Бір рет қайталанатын үлкен соққы.
Dialogue: 0,0:19:24.73,0:19:28.23,Default,,0,0,0,,Бұл менің жеңіске деген ерік-жігерім!
Dialogue: 0,0:19:28.23,0:19:31.87,Default,,0,0,0,,Хахаха...не деген жігіт➡
Dialogue: 0,0:19:31.87,0:19:35.74,Default,,0,0,0,,Жарайды, мен салған аспан шамына қарап тұрсың ба➡
Dialogue: 0,0:19:35.74,0:19:37.74,Default,,0,0,0,,Байқап көріңіз!
Dialogue: 0,0:19:37.74,0:19:39.74,Default,,0,0,0,,Міне кеттік, менің кезегім!
Dialogue: 0,0:19:39.74,0:19:41.74,Default,,0,0,0,,Ұтыс!
Dialogue: 0,0:19:41.74,0:19:44.78,Default,,0,0,0,,Новия мен Садиге қоңырау шалыңыз!
Dialogue: 0,0:19:44.78,0:19:47.25,Default,,0,0,0,,Шеберлікке байланысты палубаның жоғарғы 3 картасынан➡
Dialogue: 0,0:19:47.25,0:19:49.25,Default,,0,0,0,,Ридиге қоңырау шалыңыз!
Dialogue: 0,0:19:49.25,0:19:51.29,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:19:51.29,0:19:54.26,Default,,0,0,0,,Бұл айналым кезінде триггер қуаты +5000-ға артады!
Dialogue: 0,0:19:55.22,0:19:57.22,Default,,0,0,0,,Садимен шабуылға саяхат!
Dialogue: 0,0:19:57.22,0:19:59.23,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:19:59.23,0:20:01.23,Default,,0,0,0,,Авангардқа Novia-мен шабуыл жасаңыз!
Dialogue: 0,0:20:01.23,0:20:03.23,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:20:03.23,0:20:05.73,Default,,0,0,0,,Резаэльмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:20:05.73,0:20:07.74,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:20:07.74,0:20:09.77,Default,,0,0,0,,Пентаглим мен Гаругаонға қоңырау шалыңыз!
Dialogue: 0,0:20:09.77,0:20:12.71,Default,,0,0,0,,Шеберлікпен палубаның жоғарғы картасына қараңыз...
Dialogue: 0,0:20:12.71,0:20:14.74,Default,,0,0,0,,Палуба астында.
Dialogue: 0,0:20:14.74,0:20:16.71,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:20:19.88,0:20:23.75,Default,,0,0,0,,｜Мен бір критикалық картаға төтеп бере аламын немесе триггер картасын тарта аламын, бірақ... ｠
Dialogue: 0,0:20:23.75,0:20:25.75,Default,,0,0,0,,Heal Trigger➡ орнына
Dialogue: 0,0:20:25.75,0:20:28.26,Default,,0,0,0,,Оның триггері де жоқ, солай ма?
Dialogue: 0,0:20:28.26,0:20:31.73,Default,,0,0,0,,Құрамында 7 жоғары алдыңғы триггер бар!
Dialogue: 0,0:20:31.73,0:20:33.73,Default,,0,0,0,,Ха, қызық!
Dialogue: 0,0:20:33.73,0:20:35.73,Default,,0,0,0,,Содан кейін таңдаған тағдырыңызды таңдаңыз➡
Dialogue: 0,0:20:35.73,0:20:37.77,Default,,0,0,0,,Маған көрсет!
Dialogue: 0,0:20:37.77,0:20:40.23,Default,,0,0,0,,Тағдырымның баратын жеріне ұшамын!
Dialogue: 0,0:20:40.23,0:20:42.24,Default,,0,0,0,,Қос жетек!
Dialogue: 0,0:20:42.24,0:20:44.24,Default,,0,0,0,,Бірінші тексеру!
Dialogue: 0,0:20:44.24,0:20:46.21,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:20:53.25,0:20:55.75,Default,,0,0,0,,Екінші тексеру!
Dialogue: 0,0:20:55.75,0:20:57.79,Default,,0,0,0,,Алдыңғы триггерді алыңыз!
Dialogue: 0,0:20:57.79,0:21:00.75,Default,,0,0,0,,Барлық алдыңғы қатарлар үшін қуат плюс 15 000!
Dialogue: 0,0:21:13.73,0:21:16.24,Default,,0,0,0,,Гаругаон және Авангард...
Dialogue: 0,0:21:17.74,0:21:19.71,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:21:24.75,0:21:26.71,Default,,0,0,0,,Күзетсіз….
Dialogue: 0,0:21:35.86,0:21:38.86,Default,,0,0,0,,Жеңімпаз Ғажайып тағдыр!
Dialogue: 0,0:21:39.73,0:21:42.26,Default,,0,0,0,,Немесе... мен жеңдім.
Dialogue: 0,0:21:42.26,0:21:44.23,Default,,0,0,0,,Йоша~! Мен жеңдім...
Dialogue: 0,0:21:44.23,0:21:47.23,Default,,0,0,0,,Акикун, сен мені ұрдың.
Dialogue: 0,0:21:50.84,0:21:52.74,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:21:52.74,0:21:54.74,Default,,0,0,0,,Мен оны жек көремін...!
Dialogue: 0,0:21:55.74,0:21:57.75,Default,,0,0,0,,Тайзо-сан?
Dialogue: 0,0:21:57.75,0:21:59.78,Default,,0,0,0,,Мен сені ешқашан төмендеткен емеспін, бірақ➡
Dialogue: 0,0:21:59.78,0:22:01.75,Default,,0,0,0,,Бұл жерде сіз шектен шыққан нәрсе туралы ойлайсыз.
Dialogue: 0,0:22:02.78,0:22:05.25,Default,,0,0,0,,100 реттен 1... бұл шынымен де керемет болды!
Dialogue: 0,0:22:06.75,0:22:08.76,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:22:10.72,0:22:13.73,Default,,0,0,0,,Не болды? Жоқ, ештеңе.
Dialogue: 0,0:22:13.73,0:22:15.73,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған хабарласыңыз.
Dialogue: 0,0:22:18.23,0:22:20.23,Default,,0,0,0,,Күшке айналу.
Dialogue: 0,0:22:30.24,0:22:32.25,Default,,0,0,0,,Сенің жеңілгеніңе сенбеймін...
Dialogue: 0,0:22:32.25,0:22:34.25,Default,,0,0,0,,Келесі қадамды дереу орындаңыз.
Dialogue: 0,0:22:34.25,0:22:37.25,Default,,0,0,0,,Бұл қажет емес деп ойлаймын.
Dialogue: 0,0:22:37.25,0:22:39.22,Default,,0,0,0,,Сіз де онымен соқтығысуға тырысыңыз.
Dialogue: 0,0:22:40.25,0:22:43.22,Default,,0,0,0,,Онымен тіпті өлім тағдырын өзгертуге болады.
Dialogue: 0,0:22:43.22,0:22:45.23,Default,,0,0,0,,Сені осылай сезіндіретін ол жігіт.
Dialogue: 0,0:22:46.23,0:22:48.23,Default,,0,0,0,,Акина Мейдо.
Dialogue: 0,0:23:02.74,0:23:04.75,Default,,0,0,0,,Тек 3 жауынгер қалды!
Dialogue: 0,0:23:04.75,0:23:06.88,Default,,0,0,0,,Хмм.
Dialogue: 0,0:23:06.88,0:23:08.88,Default,,0,0,0,,Болашақты ойламайсың ба?
Dialogue: 0,0:23:10.28,0:23:12.25,Default,,0,0,0,,Сізді қазір басқа нәрселер қызықтырады, солай емес пе?
Dialogue: 0,0:23:12.25,0:23:14.29,Default,,0,0,0,,Тағы бірдеңе?
Dialogue: 0,0:23:14.29,0:23:17.22,Default,,0,0,0,,Мен де сахнаның артында көп нәрсені жасайтын адаммын➡
Dialogue: 0,0:23:17.22,0:23:20.23,Default,,0,0,0,,Иісінен білуге болады, солай ма?
Dialogue: 0,0:23:20.23,0:23:22.23,Default,,0,0,0,,Не болды?
Dialogue: 0,0:23:22.23,0:23:25.23,Default,,0,0,0,,Мен тағы да абдырап қалдым~ Айтыңызшы!
Dialogue: 0,0:23:25.23,0:23:28.24,Default,,0,0,0,,Тағдыр соғысының сыры...
Dialogue: 0,0:23:29.74,0:23:35.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory