Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.20,0:00:07.20,Default,,0,0,0,,｟Стандап авангард! ｠
Dialogue: 0,0:00:07.20,0:00:09.20,Default,,0,0,0,,｟Авангард әрқашан➡
Dialogue: 0,0:00:09.20,0:00:12.71,Default,,0,0,0,,Сіз мені жаңа әлемнің басты кейіпкеріне айналдырдыңыз. ｠
Dialogue: 0,0:00:13.71,0:00:16.21,Default,,0,0,0,,｟Ол мені белгісіз әлемге апарды. ｠
Dialogue: 0,0:00:19.21,0:00:22.72,Default,,0,0,0,,｟Маған Vanguard ұнады. ｠
Dialogue: 0,0:00:22.72,0:00:24.72,Default,,0,0,0,,｟Айналаңыздағылардан күту➡
Dialogue: 0,0:00:24.72,0:00:27.22,Default,,0,0,0,,Мені тіпті вундеркинд бала деп те атайтын➡
Dialogue: 0,0:00:27.22,0:00:29.73,Default,,0,0,0,,Жекпе-жек қызық болды. ｠
Dialogue: 0,0:00:30.73,0:00:32.73,Default,,0,0,0,,｟Сіз кәсіпқойсыз ба? ｠
Dialogue: 0,0:00:32.73,0:00:34.73,Default,,0,0,0,,｟(Жаттықтырушы) Жасөспірім кезіңізде нәтиже алуыңыз керек ➡
Dialogue: 0,0:00:34.73,0:00:36.73,Default,,0,0,0,,Бұл қатал әлем➡
Dialogue: 0,0:00:36.73,0:00:39.23,Default,,0,0,0,,Сіздің қабілетіңізбен сіз мұны міндетті түрде жасай аласыз!
Dialogue: 0,0:00:39.23,0:00:41.74,Default,,0,0,0,,Маман болу үшін емтихандардың көптеген кезеңдері бар➡
Dialogue: 0,0:00:41.74,0:00:43.74,Default,,0,0,0,,Жарып өту керек➡
Dialogue: 0,0:00:43.74,0:00:46.24,Default,,0,0,0,,Ресми турнирлерде жақсы нәтижеге қол жеткізсеңіз➡
Dialogue: 0,0:00:46.24,0:00:48.74,Default,,0,0,0,,Кейбір сынақтардан босатылған.
Dialogue: 0,0:00:48.74,0:00:51.75,Default,,0,0,0,,Турнирде жақсы нәтиже көрсететіндеріңізге сенімдімін➡
Dialogue: 0,0:00:51.75,0:00:54.25,Default,,0,0,0,,Емтиханды да тапсыра аласыз. ｠
Dialogue: 0,0:00:55.25,0:00:58.25,Default,,0,0,0,,｟Алғаш рет карта төбелесінің мақсаты бар. ｠
Dialogue: 0,0:00:59.25,0:01:01.26,Default,,0,0,0,,｟Алдын ала рахмет. ｠
Dialogue: 0,0:01:02.69,0:01:04.69,Default,,0,0,0,,｟(Жаттықтырушының дауысы) Егер сіз Vanguard ойынын мәңгі ойнауды жалғастырғыңыз келсе➡
Dialogue: 0,0:01:04.69,0:01:06.70,Default,,0,0,0,,Маман болу керек. ｠
Dialogue: 0,0:01:07.70,0:01:09.70,Default,,0,0,0,,｟Сосын➡
Dialogue: 0,0:01:09.70,0:01:11.70,Default,,0,0,0,,Кенеттен бәрі дұрыс болмады... ｠
Dialogue: 0,0:01:34.12,0:01:36.63,Default,,0,0,0,,Акина~! Сізде бүгін толық емес жұмыс жоқ, солай ма? ➡
Dialogue: 0,0:01:36.63,0:01:38.63,Default,,0,0,0,,Боулингке бірге барайық.
Dialogue: 0,0:01:38.63,0:01:41.63,Default,,0,0,0,,Кешіріңіз, бірақ менде бүгін маңызды іс бар.
Dialogue: 0,0:01:41.63,0:01:44.13,Default,,0,0,0,,Бизнес? Енді маған не айтасыз?
Dialogue: 0,0:01:44.13,0:01:47.64,Default,,0,0,0,,Менің өмірімдегі ең үлкен шайқас.
Dialogue: 0,0:01:47.64,0:01:50.11,Default,,0,0,0,,Ех! Сіз шынымен мойындадыңыз ба?
Dialogue: 0,0:01:53.14,0:01:56.65,Default,,0,0,0,,Жекпе-жек өтетін жер - тау.
Dialogue: 0,0:01:56.65,0:01:58.61,Default,,0,0,0,,Тауға шығыңыз!
Dialogue: 0,0:02:00.15,0:02:02.15,Default,,0,0,0,,｟Тағдыр соғысы?
Dialogue: 0,0:02:02.15,0:02:06.15,Default,,0,0,0,,Соңына дейін аман болсаң, тілегің орындалады.
Dialogue: 0,0:02:06.15,0:02:08.66,Default,,0,0,0,,Егер сіз теңдесі жоқ тағдыр болып таңдалсаңыз➡
Dialogue: 0,0:02:08.66,0:02:12.16,Default,,0,0,0,,Мүмкін сіз теңдесі жоқ күш аласыз.
Dialogue: 0,0:02:12.16,0:02:15.66,Default,,0,0,0,,Карточка сіз жасағыңыз келетін болашақты жүзеге асыра алады➡
Dialogue: 0,0:02:15.66,0:02:18.67,Default,,0,0,0,,Бұл да тағдырдың кездейсоқтығы ма деп ойлаймын.
Dialogue: 0,0:02:18.67,0:02:22.17,Default,,0,0,0,,Бұл Тағдыр соғысы.
Dialogue: 0,0:02:22.17,0:02:24.17,Default,,0,0,0,,Авангард - мен үшін бәрі.
Dialogue: 0,0:02:24.17,0:02:26.17,Default,,0,0,0,,Сол себепті➡
Dialogue: 0,0:02:26.17,0:02:28.14,Default,,0,0,0,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,0:02:34.62,0:02:38.09,Default,,0,0,0,,Иә, мен сенімен болсам...
Dialogue: 0,0:02:41.12,0:02:43.59,Default,,0,0,0,,Мен теңдесі жоқ күрескер бола аламын. ｠
Dialogue: 0,0:02:52.63,0:02:55.64,Default,,0,0,0,,｟Кәсіби маман болуға жол тар. ｠
Dialogue: 0,0:02:55.64,0:02:57.64,Default,,0,0,0,,｟Мен ➡ бола алсам да
Dialogue: 0,0:02:57.64,0:03:00.61,Default,,0,0,0,,Маман болып қалу қаншалықты қиын? ｠
Dialogue: 0,0:03:01.64,0:03:04.15,Default,,0,0,0,,｟Олардың ішінде үздік мамандар деп аталатындар➡
Dialogue: 0,0:03:04.15,0:03:06.65,Default,,0,0,0,,Барлығының пайызы ғана. ｠
Dialogue: 0,0:03:06.65,0:03:10.62,Default,,0,0,0,,｟Сөйтсе де мен Vanguard-пен мәңгі байланыста болғым келеді. ｠
Dialogue: 0,0:03:11.65,0:03:15.12,Default,,0,0,0,,｟Ол үшін... Мен кәсіпқой болуым керек. ｠
Dialogue: 0,0:03:21.16,0:03:23.63,Default,,0,0,0,,Тауда...
Dialogue: 0,0:03:26.67,0:03:29.17,Default,,0,0,0,,｟Тағдырыңызды өзгертетін карта ұрысы. ｠
Dialogue: 0,0:03:29.17,0:03:31.11,Default,,0,0,0,,｟Міндетті түрде жеңеміз➡
Dialogue: 0,0:03:31.11,0:03:33.08,Default,,0,0,0,,Хикаридің тағдырын мен шешемін...! ｠
Dialogue: 0,0:03:36.11,0:03:38.08,Default,,0,0,0,,Міне...
Dialogue: 0,0:03:43.62,0:03:45.62,Default,,0,0,0,,E….
Dialogue: 0,0:03:45.62,0:03:47.62,Default,,0,0,0,,Нао-сенпай?
Dialogue: 0,0:03:47.62,0:03:50.09,Default,,0,0,0,,Аки-кун? Неге….
Dialogue: 0,0:03:51.63,0:03:53.60,Default,,0,0,0,,Бұл Акикун болатын...
Dialogue: 0,0:03:55.13,0:03:57.63,Default,,0,0,0,,Құдай – қасақана➡
Dialogue: 0,0:03:57.63,0:04:00.10,Default,,0,0,0,,Мен мұндай тағдырға дайындалғаныма сене алар емеспін.
Dialogue: 0,0:04:01.14,0:04:03.61,Default,,0,0,0,,Сіздің қарсыласыңыз үлкен ме?
Dialogue: 0,0:04:06.14,0:04:09.14,Default,,0,0,0,,Нао-сенпайдың тілегі – кәсіпқой болу...
Dialogue: 0,0:04:09.14,0:04:11.65,Default,,0,0,0,,Хмм….
Dialogue: 0,0:04:11.65,0:04:14.65,Default,,0,0,0,,Акидің тілегі...
Dialogue: 0,0:04:14.65,0:04:17.12,Default,,0,0,0,,Мен ешқашан жеңілмеймін!
Dialogue: 0,0:04:18.15,0:04:20.16,Default,,0,0,0,,Әділ және шаршы алаңда күресейік➡
Dialogue: 0,0:04:20.16,0:04:22.12,Default,,0,0,0,,Тілегіңді орындау үшін!
Dialogue: 0,0:04:25.66,0:04:27.66,Default,,0,0,0,,Күресейік.
Dialogue: 0,0:04:27.66,0:04:31.60,Default,,0,0,0,,Акина Мейду Нао Инабе Барлығы дайын сияқты.
Dialogue: 0,0:04:31.60,0:04:35.10,Default,,0,0,0,,Кел, тағдыр картасын көтер!
Dialogue: 0,0:04:35.10,0:04:38.11,Default,,0,0,0,,Соғыс қарғысын айт!
Dialogue: 0,0:04:38.11,0:04:40.58,Default,,0,0,0,,Тағдыр! Осы қолында!
Dialogue: 0,0:04:42.11,0:04:44.08,Default,,0,0,0,,Құдай!
Dialogue: 0,0:04:45.61,0:04:47.62,Default,,0,0,0,,Бұл Тағдыр соғысының кезеңі.
Dialogue: 0,0:04:47.62,0:04:49.62,Default,,0,0,0,,Уақыт толы ➡
Dialogue: 0,0:04:49.62,0:04:53.62,Default,,0,0,0,,Тағдырымызды өзгертетін бірінші шайқасқа кірісейік!
Dialogue: 0,0:04:53.62,0:04:56.09,Default,,0,0,0,,Кеттік. Сәлем кез келген уақытта!
Dialogue: 0,0:04:57.13,0:04:59.63,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:04:59.63,0:05:01.63,Default,,0,0,0,,Ыстық ауаның жүзі Алдато.
Dialogue: 0,0:05:01.63,0:05:03.63,Default,,0,0,0,,Амбицияның қанаттары Соел!
Dialogue: 0,0:05:03.63,0:05:06.13,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:05:06.13,0:05:08.64,Default,,0,0,0,,Блеззанбар айдаһарына мініңіз.
Dialogue: 0,0:05:08.64,0:05:11.64,Default,,0,0,0,,Осы уақытта энергия генераторын орнатыңыз.
Dialogue: 0,0:05:11.64,0:05:13.64,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:05:13.64,0:05:17.11,Default,,0,0,0,,｟Алдыңғы жекпе-жекте де мен оны бір сәт сезіндім... ｠
Dialogue: 0,0:05:18.15,0:05:20.15,Default,,0,0,0,,｟Бұл Нао-сенпай, жауынгер... ｠
Dialogue: 0,0:05:20.15,0:05:22.15,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:05:22.15,0:05:24.15,Default,,0,0,0,,Вентестаға мініңіз, жел шиыршықтарының маркизасы!
Dialogue: 0,0:05:24.15,0:05:27.16,Default,,0,0,0,,Соэлдің шеберлігімен бір картаны сал.
Dialogue: 0,0:05:27.16,0:05:29.66,Default,,0,0,0,,Және энергия генераторын орнатыңыз.
Dialogue: 0,0:05:29.66,0:05:31.59,Default,,0,0,0,,3 энергия заряды.
Dialogue: 0,0:05:31.59,0:05:33.60,Default,,0,0,0,,Ауырсынуды басатын дәрі шақырыңыз!
Dialogue: 0,0:05:33.60,0:05:35.60,Default,,0,0,0,,Бентестамен шабуыл!
Dialogue: 0,0:05:35.60,0:05:37.60,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:05:37.60,0:05:40.10,Default,,0,0,0,,Ауырсынуды басатын шабуыл! күзетші!
Dialogue: 0,0:05:40.10,0:05:42.10,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:05:42.10,0:05:45.11,Default,,0,0,0,,Менің кезегім Энергия заряды.
Dialogue: 0,0:05:45.11,0:05:47.11,Default,,0,0,0,,Боулдер балта айдаһарына мініңіз!
Dialogue: 0,0:05:47.11,0:05:49.11,Default,,0,0,0,,Блэйз Занбардың шеберлігін белсендіру.
Dialogue: 0,0:05:49.11,0:05:51.11,Default,,0,0,0,,Жаннан өзіңді шақыр!
Dialogue: 0,0:05:51.11,0:05:53.11,Default,,0,0,0,,Боулдер балтасын шақыр!
Dialogue: 0,0:05:53.11,0:05:55.12,Default,,0,0,0,,｟Олар кенет шабуылға шықты! ｠
Dialogue: 0,0:05:55.12,0:05:58.12,Default,,0,0,0,,Боулдер балтасымен шабуыл! Күзетші жоқ.
Dialogue: 0,0:05:58.12,0:06:00.12,Default,,0,0,0,,Блэз Занбармен шабуыл!
Dialogue: 0,0:06:00.12,0:06:03.12,Default,,0,0,0,,Күзетші жоқ! Зақымдануды тексеру...
Dialogue: 0,0:06:03.12,0:06:05.13,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:06:05.13,0:06:07.10,Default,,0,0,0,,Бентестаға 10 000 қуат қосыңыз!
Dialogue: 0,0:06:08.13,0:06:10.63,Default,,0,0,0,,Боулдер балтасымен ауыруды басатын дәріге шабуыл жасаңыз!
Dialogue: 0,0:06:10.63,0:06:12.63,Default,,0,0,0,,A... күзетші жоқ!
Dialogue: 0,0:06:12.63,0:06:14.64,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:06:14.64,0:06:16.64,Default,,0,0,0,,｟Өйткені авангардтың күші артты➡
Dialogue: 0,0:06:16.64,0:06:19.14,Default,,0,0,0,,Шабуылдың нысанасын тылдағы күзетшіге ауыстырдыңыз ба? ｠
Dialogue: 0,0:06:19.14,0:06:21.64,Default,,0,0,0,,｟Осындай нәрсені жасауға болады ма? ｠
Dialogue: 0,0:06:21.64,0:06:24.65,Default,,0,0,0,,Менің кезегім, қуат заряды!
Dialogue: 0,0:06:24.65,0:06:27.65,Default,,0,0,0,,Жетістік рыцарына міну, Азенсиор!
Dialogue: 0,0:06:27.65,0:06:30.59,Default,,0,0,0,,Бентеста шеберлігін белсендіру Өзін шақырады.
Dialogue: 0,0:06:30.59,0:06:32.59,Default,,0,0,0,,Калбрге қоңырау шалыңыз.
Dialogue: 0,0:06:32.59,0:06:35.09,Default,,0,0,0,,Плюспарас айдаһарына шеберлікпен қоңырау шалыңыз.
Dialogue: 0,0:06:35.09,0:06:37.09,Default,,0,0,0,,Гаругаонға қоңырау шалыңыз.
Dialogue: 0,0:06:37.09,0:06:39.09,Default,,0,0,0,,Азеншиормен шабуыл!
Dialogue: 0,0:06:39.09,0:06:41.06,Default,,0,0,0,,Күзетші жоқ. Драйверді тексеру.
Dialogue: 0,0:06:42.10,0:06:44.57,Default,,0,0,0,,Heal Trigger 1 зақымдануды қалпына келтіру!
Dialogue: 0,0:06:46.60,0:06:48.60,Default,,0,0,0,,Plus Paras көмегімен шабуыл!
Dialogue: 0,0:06:48.60,0:06:52.61,Default,,0,0,0,,Дағдыны белсендіру: 4 картаны қуаттандырыңыз және 1 картаны тартыңыз!
Dialogue: 0,0:06:52.61,0:06:55.11,Default,,0,0,0,,Күзетші. Калбремен шабуыл жасаңыз!
Dialogue: 0,0:06:55.11,0:06:57.08,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:06:58.11,0:07:00.12,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:07:00.12,0:07:02.12,Default,,0,0,0,,Сіз де басынан шабуыл жасайсыз.
Dialogue: 0,0:07:02.12,0:07:05.12,Default,,0,0,0,,Алдымен 6 зиян келтіріңіз.
Dialogue: 0,0:07:05.12,0:07:07.12,Default,,0,0,0,,Шабуыл жеңеді.
Dialogue: 0,0:07:07.12,0:07:10.13,Default,,0,0,0,,Жеңіске жетудің сенімді жолы жоқ. жұмысшы...?
Dialogue: 0,0:07:10.13,0:07:13.63,Default,,0,0,0,,Сондықтан жағдайға байланысты тактикаңызды өзгертіңіз➡
Dialogue: 0,0:07:13.63,0:07:16.13,Default,,0,0,0,,Бір сәтке де ойлауды тоқтатпа.
Dialogue: 0,0:07:16.13,0:07:19.10,Default,,0,0,0,,Күндердің ұзақтығы қысқа және ұзақ, ал айда өмір мен өлім бар...
Dialogue: 0,0:07:20.14,0:07:22.14,Default,,0,0,0,,Бұл да Сун Цзы ма?
Dialogue: 0,0:07:22.14,0:07:24.64,Default,,0,0,0,,Соғыс өнері бізге маңызды нәрселерді үйретеді.
Dialogue: 0,0:07:24.64,0:07:28.61,Default,,0,0,0,,Өйткені біз күресетін қарсыластар әрқашан адамдар.
Dialogue: 0,0:07:29.64,0:07:31.58,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:07:31.58,0:07:33.58,Default,,0,0,0,,Ақ жарқыл, қара реверберация➡
Dialogue: 0,0:07:33.58,0:07:37.09,Default,,0,0,0,,Дүниенің жеңілмейтін екі жақты қылыштары тартылады!
Dialogue: 0,0:07:37.09,0:07:39.09,Default,,0,0,0,,Жүр!
Dialogue: 0,0:07:39.09,0:07:41.59,Default,,0,0,0,,Вальга Драгрестің теңдесі жоқ тағдыры!
Dialogue: 0,0:07:41.59,0:07:43.56,Default,,0,0,0,,Ах...!
Dialogue: 0,0:07:47.10,0:07:50.57,Default,,0,0,0,,Бұл теңдесі жоқ тағдыр...!
Dialogue: 0,0:07:51.60,0:07:55.10,Default,,0,0,0,,Boulder Axe шеберлігін белсендіру Өзіңізге қоңырау шалыңыз.
Dialogue: 0,0:07:55.10,0:07:57.11,Default,,0,0,0,,Терра Кофууға қоңырау шалыңыз!
Dialogue: 0,0:07:57.11,0:07:59.11,Default,,0,0,0,,Толық қоңырау!
Dialogue: 0,0:07:59.11,0:08:01.11,Default,,0,0,0,,Осыдан кейін жұдырықтай төбелес болады.
Dialogue: 0,0:08:01.11,0:08:03.11,Default,,0,0,0,,Мм...бұл қылыш ұрыс.
Dialogue: 0,0:08:03.11,0:08:05.61,Default,,0,0,0,,Жалғыз қылыш өмірді кеседі, бұл өмір үшін күрес!
Dialogue: 0,0:08:05.61,0:08:07.62,Default,,0,0,0,,Боулдер балтасымен шабуыл!
Dialogue: 0,0:08:07.62,0:08:10.12,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:10.12,0:08:13.12,Default,,0,0,0,,Ұрыс соңында Боулдер балта шеберлігі іске қосылады.
Dialogue: 0,0:08:13.12,0:08:16.62,Default,,0,0,0,,Зейнетке шығып, 1 картаны тартыңыз.
Dialogue: 0,0:08:16.62,0:08:18.63,Default,,0,0,0,,Боулдер балтасымен шабуыл!
Dialogue: 0,0:08:18.63,0:08:20.63,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:08:20.63,0:08:24.13,Default,,0,0,0,,Ұрыс аяқталғаннан кейін демалысқа шығып, 1 картаны тартыңыз.
Dialogue: 0,0:08:24.13,0:08:26.13,Default,,0,0,0,,Pass Amp Terra күшейту.
Dialogue: 0,0:08:26.13,0:08:28.60,Default,,0,0,0,,Вальга Драгреспен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:08:29.64,0:08:32.61,Default,,0,0,0,,Пышақ диапазонға кіретін барлық нәрсені қысқартады.
Dialogue: 0,0:08:34.64,0:08:39.15,Default,,0,0,0,,Дағдыны белсендіру: екі ойыншының алдыңғы қатарындағы барлық артқы қорғаушыларды шегіндіріңіз➡
Dialogue: 0,0:08:39.15,0:08:41.62,Default,,0,0,0,,Валга Драглесстің күші плюс 10 000!
Dialogue: 0,0:08:44.65,0:08:48.66,Default,,0,0,0,,Бұл... бірақ біз де Нао-сенпайдың ба?
Dialogue: 0,0:08:48.66,0:08:52.66,Default,,0,0,0,,Түсіндім! Сондықтан тыл сақшыларыңызды дағдылармен алдын ала шегініңіз➡
Dialogue: 0,0:08:52.66,0:08:54.66,Default,,0,0,0,,Сіз оны ұтыс ойынына айналдырдыңыз ба?
Dialogue: 0,0:08:54.66,0:08:58.63,Default,,0,0,0,,Дұрыс... Дәл қазір бұл шеберліктен тек Аки ғана жеңіледі.
Dialogue: 0,0:09:00.17,0:09:02.17,Default,,0,0,0,,Сонымен қатар, Pass Amp Terra ➡ шеберлігімен
Dialogue: 0,0:09:02.17,0:09:04.17,Default,,0,0,0,,Шабуыл соққанда➡
Dialogue: 0,0:09:04.17,0:09:06.17,Default,,0,0,0,,Артқы қорғаушыны шегіндіріңіз!
Dialogue: 0,0:09:06.17,0:09:08.18,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:09:08.18,0:09:10.68,Default,,0,0,0,,Бірінші тексеру... триггер жоқ.
Dialogue: 0,0:09:10.68,0:09:12.68,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:09:12.68,0:09:14.68,Default,,0,0,0,,Триггерді тартыңыз!
Dialogue: 0,0:09:14.68,0:09:16.68,Default,,0,0,0,,Гаругаон соққы алған кезде шегінеді.
Dialogue: 0,0:09:16.68,0:09:18.65,Default,,0,0,0,,Мені өлтірме!
Dialogue: 0,0:09:20.19,0:09:22.69,Default,,0,0,0,,Нао-сенпай күткендей... ол аяусыз.
Dialogue: 0,0:09:22.69,0:09:24.69,Default,,0,0,0,,Бірақ енді менің кезегім!
Dialogue: 0,0:09:24.69,0:09:26.69,Default,,0,0,0,,Әлі жоқ. жұмысшы...?
Dialogue: 0,0:09:26.69,0:09:29.70,Default,,0,0,0,,Вальга Драгрес шайқастың соңында➡
Dialogue: 0,0:09:29.70,0:09:32.13,Default,,0,0,0,,Минус 2 жүріңіз және тұрыңыз.
Dialogue: 0,0:09:32.13,0:09:34.14,Default,,0,0,0,,Қосымша шабуыл?
Dialogue: 0,0:09:34.14,0:09:38.14,Default,,0,0,0,,Вальга Драгреспен шабуыл!
Dialogue: 0,0:09:38.14,0:09:40.11,Default,,0,0,0,,Енді жоқ... Күзетші!
Dialogue: 0,0:09:41.64,0:09:43.65,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:43.65,0:09:46.15,Default,,0,0,0,,｟Теңдесі жоқ тағдыр...Мықты. ｠
Dialogue: 0,0:09:46.15,0:09:48.62,Default,,0,0,0,,｟Бәрі де...Мен жеңемін! ｠
Dialogue: 0,0:09:49.65,0:09:53.15,Default,,0,0,0,,Менің кезегім! Құтқару қанаттары көктен осында!
Dialogue: 0,0:09:53.15,0:09:56.12,Default,,0,0,0,,Резаэльдің ғажайып тағдырына мініңіз!
Dialogue: 0,0:10:05.20,0:10:07.70,Default,,0,0,0,,Азенсиордың шеберлігі іске қосылды!
Dialogue: 0,0:10:07.70,0:10:10.21,Default,,0,0,0,,Дроптың талғампаз рыцарь Новияға қоңырау шалыңыз.
Dialogue: 0,0:10:10.21,0:10:13.21,Default,,0,0,0,,Novia шеберлігі бар палубаның жоғарғы 3 картасынан➡
Dialogue: 0,0:10:13.21,0:10:15.21,Default,,0,0,0,,Гаругаонға қоңырау шалыңыз!
Dialogue: 0,0:10:15.21,0:10:17.71,Default,,0,0,0,,Антенна мен Фуфупуриге қоңырау шалыңыз!
Dialogue: 0,0:10:17.71,0:10:21.22,Default,,0,0,0,,Тағдырға ғана ие болатын және жекпе-жек кезінде бір рет қана қолдануға болатын дағды➡
Dialogue: 0,0:10:21.22,0:10:23.22,Default,,0,0,0,,Оны осында пайдаланыңыз!
Dialogue: 0,0:10:23.22,0:10:27.19,Default,,0,0,0,,Ғажайып келу құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:10:29.22,0:10:32.23,Default,,0,0,0,,Барлық түсірілген маңызды триггерлерді палубаға қайтарыңыз➡
Dialogue: 0,0:10:32.23,0:10:34.73,Default,,0,0,0,,Резаэльдің дискісіне 1 қосыңыз.
Dialogue: 0,0:10:34.73,0:10:37.23,Default,,0,0,0,,Қайтарылатын 4 маңызды триггер бар.
Dialogue: 0,0:10:37.23,0:10:39.23,Default,,0,0,0,,Триггерді тарту қуаты➡
Dialogue: 0,0:10:39.23,0:10:41.74,Default,,0,0,0,,Бұл Резаелдің құдайлық шеберлігі!
Dialogue: 0,0:10:41.74,0:10:43.74,Default,,0,0,0,,Гаргаонмен шабуыл!
Dialogue: 0,0:10:43.74,0:10:47.24,Default,,0,0,0,,Күзетші! Резаэльмен бірге Авангардқа шабуыл жасаңыз.
Dialogue: 0,0:10:47.24,0:10:50.25,Default,,0,0,0,,Оның күші одақтастарын алған азабы арқылы емдейді➡
Dialogue: 0,0:10:50.25,0:10:52.25,Default,,0,0,0,,Оны қайтарыңыз!
Dialogue: 0,0:10:52.25,0:10:56.25,Default,,0,0,0,,Дағды іске қосылды! Баға сіздің зияныңыздан төмен болады➡
Dialogue: 0,0:10:56.25,0:10:58.25,Default,,0,0,0,,2 картаға қоңырау шалыңыз!
Dialogue: 0,0:10:58.25,0:11:01.19,Default,,0,0,0,,2-сынып плюс және минус➡ арқылы қоңырау шалыңыз
Dialogue: 0,0:11:01.19,0:11:03.16,Default,,0,0,0,,1 дәрежелі ауруды басатын дәрі.
Dialogue: 0,0:11:04.19,0:11:06.69,Default,,0,0,0,,｟Шабуыл жасауды аяқтаған бөлімшеге кезекпен қоңырау шалыңыз➡
Dialogue: 0,0:11:06.69,0:11:09.20,Default,,0,0,0,,Бұрынғы қателікті жасамаңыз... ｠
Dialogue: 0,0:11:09.20,0:11:11.20,Default,,0,0,0,,Енді, үштік жетек.
Dialogue: 0,0:11:11.20,0:11:13.70,Default,,0,0,0,,Сіз не істейсіз? Нао-сенпай!
Dialogue: 0,0:11:13.70,0:11:15.70,Default,,0,0,0,,Критикалық көрсеткіш те өсті➡
Dialogue: 0,0:11:15.70,0:11:18.71,Default,,0,0,0,,...
Dialogue: 0,0:11:18.71,0:11:21.71,Default,,0,0,0,,Бірінші тексеру... триггер жоқ!
Dialogue: 0,0:11:21.71,0:11:24.68,Default,,0,0,0,,Екінші тексеру... триггер жоқ!
Dialogue: 0,0:11:26.21,0:11:29.22,Default,,0,0,0,,Үшінші тексеру….
Dialogue: 0,0:11:29.22,0:11:31.22,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:11:31.22,0:11:33.22,Default,,0,0,0,,Plus Pallas Plus 10000➡ қуаты
Dialogue: 0,0:11:33.22,0:11:36.22,Default,,0,0,0,,Novia's Critical Plus 1➡
Dialogue: 0,0:11:36.22,0:11:38.23,Default,,0,0,0,,Plus Paras көмегімен шабуыл!
Dialogue: 0,0:11:38.23,0:11:40.23,Default,,0,0,0,,１
Dialogue: 0,0:11:40.23,0:11:42.23,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:11:42.23,0:11:44.23,Default,,0,0,0,,➡
Dialogue: 0,0:11:44.23,0:11:46.23,Default,,0,0,0,,Зейнетке шығып, бір картаны тарт!
Dialogue: 0,0:11:46.23,0:11:48.24,Default,,0,0,0,,...
Dialogue: 0,0:11:48.24,0:11:51.21,Default,,0,0,0,,Дағдыны белсендіру қуаты плюс 10000!
Dialogue: 0,0:11:52.74,0:11:54.74,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:11:54.74,0:11:56.74,Default,,0,0,0,,...
Dialogue: 0,0:11:56.74,0:11:58.75,Default,,0,0,0,,｟Құдайлық шеберлікті қолдансам да жеңе алмадым➡
Dialogue: 0,0:11:58.75,0:12:01.68,Default,,0,0,0,,１…｠
Dialogue: 0,0:12:01.68,0:12:04.69,Default,,0,0,0,,…
Dialogue: 0,0:12:04.69,0:12:06.69,Default,,0,0,0,,Е…. Бұл керісінше.
Dialogue: 0,0:12:06.69,0:12:09.19,Default,,0,0,0,,Бұрышта тұрған Аки.
Dialogue: 0,0:12:09.19,0:12:11.19,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:12:11.19,0:12:14.70,Default,,0,0,0,,Persona Ride... Вальга Драгрес!
Dialogue: 0,0:12:14.70,0:12:16.70,Default,,0,0,0,,...
Dialogue: 0,0:12:16.70,0:12:20.20,Default,,0,0,0,,Бір құрылғыны қайта айдаған кезде іске қосылатын күшті дағды!
Dialogue: 0,0:12:20.20,0:12:22.20,Default,,0,0,0,,１➡
Dialogue: 0,0:12:22.20,0:12:25.71,Default,,0,0,0,,Бұл айналым, алдыңғы қатардағы бірліктердің қуаты +10 000.
Dialogue: 0,0:12:25.71,0:12:28.21,Default,,0,0,0,,Энергия генераторын іске қосу.
Dialogue: 0,0:12:28.21,0:12:32.21,Default,,0,0,0,,7 картаны энергиямен жару арқылы 1 картаны сал.
Dialogue: 0,0:12:32.21,0:12:34.22,Default,,0,0,0,,Обдрасглейв пен Шуураны шақыр.
Dialogue: 0,0:12:34.22,0:12:36.22,Default,,0,0,0,,Шуурамен шабуыл!
Dialogue: 0,0:12:36.22,0:12:38.72,Default,,0,0,0,,｟Бір жолды баспаңыз➡
Dialogue: 0,0:12:38.72,0:12:40.72,Default,,0,0,0,,Соққыға ұрынбай тұрып, оны сақтыққа қойыңыз! ｠
Dialogue: 0,0:12:40.72,0:12:43.22,Default,,0,0,0,,Күзетші! Және тосқауыл!
Dialogue: 0,0:12:43.22,0:12:45.23,Default,,0,0,0,,Pass Amp Terra Boost➡
Dialogue: 0,0:12:45.23,0:12:48.23,Default,,0,0,0,,Вальга Драгреспен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:12:48.23,0:12:51.73,Default,,0,0,0,,Дағдыны белсендіру: алдыңғы қатардағы барлық артқы қорғаушыларды шегіндіріңіз➡
Dialogue: 0,0:12:51.73,0:12:53.74,Default,,0,0,0,,Қуат плюс 10000!
Dialogue: 0,0:12:53.74,0:12:57.74,Default,,0,0,0,,Бірақ бұл жолы тек Нао-сенпайдың тыл сақшысы ғана шегінді.
Dialogue: 0,0:12:57.74,0:12:59.74,Default,,0,0,0,,Сіз қалай ойлайсыз? жұмысшы...?
Dialogue: 0,0:12:59.74,0:13:02.68,Default,,0,0,0,,Обдрасглейвті әсерлер арқылы қайтару мүмкін емес.
Dialogue: 0,0:13:02.68,0:13:05.68,Default,,0,0,0,,Сосын Шуура шегініп, шеберлігін іске қосты.
Dialogue: 0,0:13:05.68,0:13:09.18,Default,,0,0,0,,Төменнен қайта тіріліңіз және қуат пен 10 000 алыңыз!
Dialogue: 0,0:13:09.18,0:13:12.69,Default,,0,0,0,,Бұл шын мәнінде шабуылдар санын арттырады...!
Dialogue: 0,0:13:12.69,0:13:14.69,Default,,0,0,0,,Бір қарағанда қолайсыз болып көрінетін дағдылар➡
Dialogue: 0,0:13:14.69,0:13:17.69,Default,,0,0,0,,Артықшылықтар оны қалай пайдалануыңызға байланысты өзгереді.
Dialogue: 0,0:13:17.69,0:13:20.19,Default,,0,0,0,,Бұл карталарды біріктіру дегенді білдіреді.
Dialogue: 0,0:13:20.19,0:13:23.20,Default,,0,0,0,,Қарғыс атсын... Толық күзетші!
Dialogue: 0,0:13:23.20,0:13:26.20,Default,,0,0,0,,Бірінші тексеру.
Dialogue: 0,0:13:26.20,0:13:28.20,Default,,0,0,0,,Екінші тексеру.
Dialogue: 0,0:13:28.20,0:13:30.67,Default,,0,0,0,,Heal Trigger зақымын қалпына келтіру.
Dialogue: 0,0:13:31.71,0:13:34.21,Default,,0,0,0,,Ұрыс соңында Вальга Драгрес тұрады.
Dialogue: 0,0:13:34.21,0:13:36.21,Default,,0,0,0,,Тағы да шабуыл!
Dialogue: 0,0:13:36.21,0:13:38.71,Default,,0,0,0,,Күзетсіз….
Dialogue: 0,0:13:38.71,0:13:41.72,Default,,0,0,0,,Фуфупуриден шегіну үшін дағдыларды қолданыңыз.
Dialogue: 0,0:13:41.72,0:13:43.72,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:13:43.72,0:13:45.72,Default,,0,0,0,,Менің қалауым үшін!
Dialogue: 0,0:13:45.72,0:13:48.69,Default,,0,0,0,,Теңдесі жоқ! Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:13:50.22,0:13:52.23,Default,,0,0,0,,Қайда...?
Dialogue: 0,0:13:52.23,0:13:54.23,Default,,0,0,0,,Қарсыластың зияны 4 немесе одан көп болса➡
Dialogue: 0,0:13:54.23,0:13:57.23,Default,,0,0,0,,Valga Dragless тіректер мен жетектер плюс 2.
Dialogue: 0,0:13:57.23,0:13:59.23,Default,,0,0,0,,Үшінші шабуыл?
Dialogue: 0,0:13:59.23,0:14:01.67,Default,,0,0,0,,Бұл менің қолымнан келеді.
Dialogue: 0,0:14:01.67,0:14:03.67,Default,,0,0,0,,Кел! Вальга Драгресте➡
Dialogue: 0,0:14:03.67,0:14:06.14,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:14:07.68,0:14:09.68,Default,,0,0,0,,Күзетсіз….
Dialogue: 0,0:14:09.68,0:14:11.68,Default,,0,0,0,,Бірінші тексеру.
Dialogue: 0,0:14:11.68,0:14:13.68,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:14:13.68,0:14:15.68,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:14:15.68,0:14:17.65,Default,,0,0,0,,Мен... ұтыс триггерін алдым!
Dialogue: 0,0:14:23.69,0:14:25.69,Default,,0,0,0,,Бітті.
Dialogue: 0,0:14:25.69,0:14:27.70,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:14:27.70,0:14:30.20,Default,,0,0,0,,Мен оны Нао-сенпайдан үйрендім➡
Dialogue: 0,0:14:30.20,0:14:32.20,Default,,0,0,0,,Соңына дейін авангард➡
Dialogue: 0,0:14:32.20,0:14:34.67,Default,,0,0,0,,Сіз ешқашан сенуді тоқтатпауыңыз керек.
Dialogue: 0,0:14:38.21,0:14:41.71,Default,,0,0,0,,Мен мына бір картаны аударғанша ұтылған жоқпын!
Dialogue: 0,0:14:41.71,0:14:45.21,Default,,0,0,0,,Аки-кун, қорықпайсың ба? ➡
Dialogue: 0,0:14:45.21,0:14:47.68,Default,,0,0,0,,Тілектеріңіз орындалмауы үшін.
Dialogue: 0,0:14:48.72,0:14:50.72,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:14:50.72,0:14:54.22,Default,,0,0,0,,Бірақ... бұл жақсы емес!
Dialogue: 0,0:14:54.22,0:14:58.23,Default,,0,0,0,,Тірі болсам, бас тартамын деген ойым жоқ.
Dialogue: 0,0:14:58.23,0:15:01.66,Default,,0,0,0,,Ал... Тағдыр соғысы жақсы болмаса да➡
Dialogue: 0,0:15:01.66,0:15:03.66,Default,,0,0,0,,Дәрігер қасық лақтырса да➡
Dialogue: 0,0:15:03.66,0:15:07.17,Default,,0,0,0,,Мен қол созған сайын үміт бар деп ойлаймын.
Dialogue: 0,0:15:07.17,0:15:10.67,Default,,0,0,0,,Тілегім бітпейді!
Dialogue: 0,0:15:10.67,0:15:13.67,Default,,0,0,0,,Бұл ешқашан бітпейді... немесе солай.
Dialogue: 0,0:15:13.67,0:15:15.68,Default,,0,0,0,,Сәлем, бұл бітпейді!
Dialogue: 0,0:15:15.68,0:15:18.18,Default,,0,0,0,,Мен оны аяқтамаймын!
Dialogue: 0,0:15:18.18,0:15:20.18,Default,,0,0,0,,Бұл бітпейді...
Dialogue: 0,0:15:20.18,0:15:22.15,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:23.68,0:15:25.65,Default,,0,0,0,,Мүмкін солай шығар...
Dialogue: 0,0:15:27.19,0:15:30.69,Default,,0,0,0,,Өзіңіз шешесіз...
Dialogue: 0,0:15:30.69,0:15:33.69,Default,,0,0,0,,Сәлем, жарысайық➡
Dialogue: 0,0:15:33.69,0:15:35.66,Default,,0,0,0,,Зақымдануды тексеру!
Dialogue: 0,0:15:38.20,0:15:40.17,Default,,0,0,0,,Критикалық триггер.
Dialogue: 0,0:15:42.20,0:15:44.71,Default,,0,0,0,,Менің жеңісім.
Dialogue: 0,0:15:44.71,0:15:48.18,Default,,0,0,0,,Ғажайыптар оңай емес...
Dialogue: 0,0:15:49.71,0:15:51.71,Default,,0,0,0,,Аз да болса жарық➡
Dialogue: 0,0:15:51.71,0:15:55.22,Default,,0,0,0,,Тек қол ұшын созатындарға ➡
Dialogue: 0,0:15:55.22,0:15:57.19,Default,,0,0,0,,Ғажайыптар келе жатыр!
Dialogue: 0,0:16:03.16,0:16:06.63,Default,,0,0,0,,Е...не болып жатыр?
Dialogue: 0,0:16:10.67,0:16:12.63,Default,,0,0,0,,Ғажайып екінші келеді!
Dialogue: 0,0:16:14.17,0:16:16.17,Default,,0,0,0,,Е...!
Dialogue: 0,0:16:16.17,0:16:19.67,Default,,0,0,0,,Резаэльдің құдайлық шеберлігі іске қосылған сәттен бастап жалғасады.
Dialogue: 0,0:16:19.67,0:16:22.68,Default,,0,0,0,,6-зақымнан триггер блогы шыққанда➡
Dialogue: 0,0:16:22.68,0:16:24.65,Default,,0,0,0,,Бір зиянды қалпына келтіріңіз!
Dialogue: 0,0:16:26.18,0:16:28.18,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:16:28.18,0:16:30.18,Default,,0,0,0,,Сәлем! Резаэльдің...
Dialogue: 0,0:16:30.18,0:16:32.65,Default,,0,0,0,,Бұл Резаелдің арқасында ғана болатын керемет.
Dialogue: 0,0:16:34.19,0:16:37.19,Default,,0,0,0,,Олай болса, мен ол кереметті өлтіремін!
Dialogue: 0,0:16:37.19,0:16:39.19,Default,,0,0,0,,Дағдылары бар шегінетін антенналар➡
Dialogue: 0,0:16:39.19,0:16:42.20,Default,,0,0,0,,Обдрас Глейвпен шабуыл!
Dialogue: 0,0:16:42.20,0:16:44.20,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:16:44.20,0:16:46.20,Default,,0,0,0,,Шуурамен шабуыл!
Dialogue: 0,0:16:46.20,0:16:48.70,Default,,0,0,0,,Қуат плюс 5000 дағдылары бар!
Dialogue: 0,0:16:48.70,0:16:50.71,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:16:50.71,0:16:52.71,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:16:52.71,0:16:54.71,Default,,0,0,0,,Жарайды, мен шыдай алдым!
Dialogue: 0,0:16:54.71,0:16:57.21,Default,,0,0,0,,Құдайдың шеберлігі жақсы өтті!
Dialogue: 0,0:16:57.21,0:16:59.18,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:17:00.72,0:17:03.22,Default,,0,0,0,,｟Иә...Авангард➡
Dialogue: 0,0:17:03.22,0:17:05.19,Default,,0,0,0,,Қуаныштымын... ｠
Dialogue: 0,0:17:10.22,0:17:13.23,Default,,0,0,0,,｟Көңілді және көңілді➡
Dialogue: 0,0:17:13.23,0:17:17.20,Default,,0,0,0,,Оның кәсіпқой болғаны шынымен де маңызды болмауы керек еді. ｠
Dialogue: 0,0:17:18.73,0:17:21.70,Default,,0,0,0,,｟Егер сізге Vanguard ұнаса, бұл сізге қажет... ｠
Dialogue: 0,0:17:22.74,0:17:26.24,Default,,0,0,0,,Хахаха...Мен жеңілдім.
Dialogue: 0,0:17:26.24,0:17:28.24,Default,,0,0,0,,Бірақ келесі бұрылыстан аман өте алсаңыз➡
Dialogue: 0,0:17:28.24,0:17:31.25,Default,,0,0,0,,Мен сені бұл жолы кесіп тастаймын!
Dialogue: 0,0:17:31.25,0:17:33.75,Default,,0,0,0,,Қорқынышты... олай істемейді, солай ма?
Dialogue: 0,0:17:33.75,0:17:35.75,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:17:35.75,0:17:38.75,Default,,0,0,0,,Персона Рид Резаэль!
Dialogue: 0,0:17:38.75,0:17:40.76,Default,,0,0,0,,Барлығын осында жазамын➡
Dialogue: 0,0:17:40.76,0:17:43.76,Default,,0,0,0,,Калбрге қоңырау шалу антеннасына шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:17:43.76,0:17:45.76,Default,,0,0,0,,Палладий құлшынысын шақырыңыз!
Dialogue: 0,0:17:45.76,0:17:48.76,Default,,0,0,0,,Міне! Оны қабылдаңыз және тұрыңыз!
Dialogue: 0,0:17:48.76,0:17:50.77,Default,,0,0,0,,Кальбрмен шабуыл!
Dialogue: 0,0:17:50.77,0:17:52.77,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:17:52.77,0:17:54.77,Default,,0,0,0,,Резаэльмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:54.77,0:17:56.77,Default,,0,0,0,,Дағдыны белсендіру.
Dialogue: 0,0:17:56.77,0:18:00.24,Default,,0,0,0,,Тамшыны Gigantech Masher және Garugaon деп атаңыз.
Dialogue: 0,0:18:00.24,0:18:03.71,Default,,0,0,0,,Gigantech шеберлігі 15 000 қуат қосады!
Dialogue: 0,0:18:03.71,0:18:07.21,Default,,0,0,0,,Кез келген жағдайда, егер сыни триггер орын алса, оның алдын алу мүмкін емес.
Dialogue: 0,0:18:07.21,0:18:09.22,Default,,0,0,0,,Бұл жерде күзетші жоқ.
Dialogue: 0,0:18:09.22,0:18:12.72,Default,,0,0,0,,Кеттік, Нао-сенпай! Сәлем, кіші Акина!
Dialogue: 0,0:18:12.72,0:18:14.69,Default,,0,0,0,,Енді байыппен қарайық... (2 адам) Шайқас!
Dialogue: 0,0:18:15.72,0:18:17.69,Default,,0,0,0,,Бірінші тексеру!
Dialogue: 0,0:18:19.23,0:18:21.23,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:18:21.23,0:18:23.20,Default,,0,0,0,,Екінші тексеру!
Dialogue: 0,0:18:26.23,0:18:28.20,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:18:31.24,0:18:34.24,Default,,0,0,0,,Бірінші зақымдануды тексеру.
Dialogue: 0,0:18:34.24,0:18:36.21,Default,,0,0,0,,Екінші тармақ….
Dialogue: 0,0:18:40.75,0:18:42.75,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:18:42.75,0:18:44.72,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:18:47.25,0:18:50.22,Default,,0,0,0,,Жеңімпаз... ғажайып өлімші!
Dialogue: 0,0:18:51.26,0:18:54.23,Default,,0,0,0,,Иә... иә!
Dialogue: 0,0:18:55.26,0:18:57.77,Default,,0,0,0,,Хе...
Dialogue: 0,0:18:57.77,0:19:00.74,Default,,0,0,0,,Жарайды, тағдыр соғысы.
Dialogue: 0,0:19:01.70,0:19:04.67,Default,,0,0,0,,Сіз жеңдіңіз... Ғажайып-кун.
Dialogue: 0,0:19:15.72,0:19:17.72,Default,,0,0,0,,Ум...Нао-сенпай➡
Dialogue: 0,0:19:17.72,0:19:19.72,Default,,0,0,0,,Ал, мен….
Dialogue: 0,0:19:19.72,0:19:21.72,Default,,0,0,0,,Атча~! Мен шәкіртімнен жеңілемін➡
Dialogue: 0,0:19:21.72,0:19:24.23,Default,,0,0,0,,Менің қожайыным тұра алмайды!
Dialogue: 0,0:19:24.23,0:19:26.73,Default,,0,0,0,,Хмм...бірақ➡
Dialogue: 0,0:19:26.73,0:19:28.70,Default,,0,0,0,,Бұл жақсы жекпе-жек болды!
Dialogue: 0,0:19:29.73,0:19:31.73,Default,,0,0,0,,Ха, рұқсатсыз не істеп жүрсің➡
Dialogue: 0,0:19:31.73,0:19:34.24,Default,,0,0,0,,Менің ойымша, ол қорқақ болып кетті.
Dialogue: 0,0:19:34.24,0:19:37.24,Default,,0,0,0,,Егер кәсіпқой болмасаңыз, Vanguard қолданбасымен байланыста бола алмайсыз➡
Dialogue: 0,0:19:37.24,0:19:39.74,Default,,0,0,0,,Сіз жай ғана болжап отырсыз...
Dialogue: 0,0:19:39.74,0:19:42.74,Default,,0,0,0,,Маған кәсіпқой ма, жоқ па бәрібір...
Dialogue: 0,0:19:42.74,0:19:44.75,Default,,0,0,0,,Мен өзім болғанша➡
Dialogue: 0,0:19:44.75,0:19:46.75,Default,,0,0,0,,Мен Авангардпен біргемін.
Dialogue: 0,0:19:46.75,0:19:48.75,Default,,0,0,0,,Сонда маман ретіндегі арманыңыз қандай?
Dialogue: 0,0:19:48.75,0:19:50.75,Default,,0,0,0,,Міне!
Dialogue: 0,0:19:50.75,0:19:52.75,Default,,0,0,0,,Әрине мен берілмеймін!
Dialogue: 0,0:19:52.75,0:19:54.76,Default,,0,0,0,,Бұл жай ғана көңілсіз, сондықтан мен мұны істей алмаймын!
Dialogue: 0,0:19:54.76,0:19:58.26,Default,,0,0,0,,Мен жеңілгенді ұнатпаймын, сондықтан тағдыр мені сәтсіздікке ұшыратты деп айтпаймын➡
Dialogue: 0,0:19:58.26,0:20:00.23,Default,,0,0,0,,Мен сені қуамын! Бұл дұрыс.
Dialogue: 0,0:20:00.23,0:20:02.20,Default,,0,0,0,,Сәлем, мен сені қолдаймын!
Dialogue: 0,0:20:03.70,0:20:05.70,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:20:05.70,0:20:07.70,Default,,0,0,0,,Бұл туралы айтатын болсақ...
Dialogue: 0,0:20:07.70,0:20:10.20,Default,,0,0,0,,Кішкене жарықтың өзі қолын созғандарға ғана➡
Dialogue: 0,0:20:10.20,0:20:12.21,Default,,0,0,0,,Ғажайыптар түседі.
Dialogue: 0,0:20:12.21,0:20:14.71,Default,,0,0,0,,Мен де бұл сөзді білемін.
Dialogue: 0,0:20:14.71,0:20:16.68,Default,,0,0,0,,Мен оны қайта тыңдаған кезде үйренетін тәжірибе.
Dialogue: 0,0:20:17.71,0:20:19.71,Default,,0,0,0,,Бұл туралы қалай естідің?
Dialogue: 0,0:20:19.71,0:20:21.68,Default,,0,0,0,,Мен ұмытып қалдым.
Dialogue: 0,0:20:25.72,0:20:27.72,Default,,0,0,0,,Жекпе-жек қызықты өтті.
Dialogue: 0,0:20:27.72,0:20:29.69,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,0:20:33.23,0:20:35.20,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:40.23,0:20:42.24,Default,,0,0,0,,Рас! Бірдеңе~➡
Dialogue: 0,0:20:42.24,0:20:44.21,Default,,0,0,0,,Мен өзімді жақсы сезінемін!
Dialogue: 0,0:20:45.24,0:20:47.74,Default,,0,0,0,,Ой! Оны асыра алмаңыз.
Dialogue: 0,0:20:47.74,0:20:50.24,Default,,0,0,0,,Бұл мүмкін емес ~ Дәрігерлер де➡
Dialogue: 0,0:20:50.24,0:20:52.71,Default,,0,0,0,,Ол жақсарып келе жатқанын айтты!
Dialogue: 0,0:20:53.75,0:20:55.75,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:20:55.75,0:20:58.72,Default,,0,0,0,,Бұл шынымен де жақсарып келеді...
Dialogue: 0,0:20:59.75,0:21:01.69,Default,,0,0,0,,Осыны айтып тұрсыз.
Dialogue: 0,0:21:01.69,0:21:03.69,Default,,0,0,0,,Бүгін картамен төбелесейік!
Dialogue: 0,0:21:03.69,0:21:05.66,Default,,0,0,0,,Мен сені ұрамын!
Dialogue: 0,0:21:06.69,0:21:10.16,Default,,0,0,0,,Мен сізге айтамын, мен таңқаларлық күштімін, солай ма?
Dialogue: 0,0:21:12.70,0:21:16.70,Default,,0,0,0,,Кеше жекпе-жекті көруге келмеген жалғыз сенсің.
Dialogue: 0,0:21:16.70,0:21:18.71,Default,,0,0,0,,Мені қызықтырмайды.
Dialogue: 0,0:21:18.71,0:21:20.67,Default,,0,0,0,,Бұл біртүрлі нәрсе.
Dialogue: 0,0:21:21.71,0:21:24.21,Default,,0,0,0,,Тағдыр соғысында қандай тілегіңізді орындағыңыз келеді?➡
Dialogue: 0,0:21:24.21,0:21:26.71,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:21:26.71,0:21:29.18,Default,,0,0,0,,Менің тілегім жоқ.
Dialogue: 0,0:21:36.72,0:21:38.69,Default,,0,0,0,,Акина Акина.
Dialogue: 0,0:21:42.73,0:21:45.20,Default,,0,0,0,,Неге менің атым... Сіз кімсіз?
Dialogue: 0,0:21:46.23,0:21:48.24,Default,,0,0,0,,Мен сізге кеңес беруге келдім.
Dialogue: 0,0:21:48.24,0:21:50.24,Default,,0,0,0,,Кеңес?
Dialogue: 0,0:21:50.24,0:21:52.24,Default,,0,0,0,,Сіздің тілегіңіз ешқашан орындалмайды.
Dialogue: 0,0:21:52.24,0:21:55.24,Default,,0,0,0,,Ғажайып тағдырды қолданып жүрсеңіз➡
Dialogue: 0,0:21:55.24,0:21:58.71,Default,,0,0,0,,Бұдан кейін де өлім күтіп тұр.
