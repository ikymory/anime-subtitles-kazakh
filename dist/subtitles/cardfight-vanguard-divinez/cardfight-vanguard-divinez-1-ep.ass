Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.20,0:00:05.20,Default,,0,0,0,,<Авангард>
Dialogue: 0,0:00:05.20,0:00:09.71,Default,,0,0,0,,<Көне заманнан бері адамдар жақсы көріп келе жатқан карта ойыны>
Dialogue: 0,0:00:09.71,0:00:11.71,Default,,0,0,0,,<Адам мен картаның арасында➡
Dialogue: 0,0:00:11.71,0:00:14.21,Default,,0,0,0,,Қанша жұлдыз болса, сонша кездесу бар➡
Dialogue: 0,0:00:14.21,0:00:17.21,Default,,0,0,0,,Жұлдыздар қанша болса, сонша дұға болды.
Dialogue: 0,0:00:18.21,0:00:20.22,Default,,0,0,0,,<Карталар арқылы байланысқан сезімдер➡
Dialogue: 0,0:00:20.22,0:00:22.72,Default,,0,0,0,,Дүние логикасынан да асып түседі＞
Dialogue: 0,0:00:35.73,0:00:38.23,Default,,0,0,0,,＜Шынайы тілектер арқылы көрінеді➡
Dialogue: 0,0:00:38.23,0:00:40.24,Default,,0,0,0,,Тағдырлар>
Dialogue: 0,0:00:40.24,0:00:42.24,Default,,0,0,0,,<Ғажайып іздеу➡
Dialogue: 0,0:00:42.24,0:00:44.24,Default,,0,0,0,,Бақталассыз болуды армандау➡
Dialogue: 0,0:00:44.24,0:00:46.24,Default,,0,0,0,,Тыйымға қол созу➡
Dialogue: 0,0:00:46.24,0:00:48.74,Default,,0,0,0,,Әмбебаптандыру жолымен жүру➡
Dialogue: 0,0:00:48.74,0:00:50.75,Default,,0,0,0,,Мақсатқа айналма➡
Dialogue: 0,0:00:50.75,0:00:53.25,Default,,0,0,0,,Нөлдік шындықты іздеу＞
Dialogue: 0,0:00:53.25,0:00:55.75,Default,,0,0,0,,<Оны бәрінен де қатты тілегендер үшін➡
Dialogue: 0,0:00:55.75,0:00:58.25,Default,,0,0,0,,Тағдыр жауап береді＞
Dialogue: 0,0:00:58.25,0:01:01.19,Default,,0,0,0,,<Біз қосылған осы өлкеде➡
Dialogue: 0,0:01:01.19,0:01:03.69,Default,,0,0,0,,Оны кім ұстайды?＞
Dialogue: 0,0:01:03.69,0:01:06.70,Default,,0,0,0,,<Тағдырыңды өзгертетін сол карта...>
Dialogue: 0,0:01:12.17,0:01:14.14,Default,,0,0,0,,Үлкен аға! Басталып жатыр.
Dialogue: 0,0:01:15.67,0:01:18.17,Default,,0,0,0,,Тұрақты авангард.
Dialogue: 0,0:01:18.17,0:01:20.18,Default,,0,0,0,,Қараңдар, қараңдар, басталды!
Dialogue: 0,0:01:20.18,0:01:22.18,Default,,0,0,0,,Мен оны көріп тұрмын.
Dialogue: 0,0:01:22.18,0:01:24.18,Default,,0,0,0,,Төмен кернеу! ➡
Dialogue: 0,0:01:24.18,0:01:26.18,Default,,0,0,0,,Бұл люкс. Бұл финал, солай ма?
Dialogue: 0,0:01:26.18,0:01:28.68,Default,,0,0,0,,Хикари...Жақында бұқтыратын боламын➡
Dialogue: 0,0:01:28.68,0:01:30.62,Default,,0,0,0,,Үстелде бос орын қалдырыңыз.
Dialogue: 0,0:01:30.62,0:01:33.59,Default,,0,0,0,,Ммм... міне! Сіз мені ести аласыз.
Dialogue: 0,0:01:36.12,0:01:38.13,Default,,0,0,0,,2-ші люкс! ➡
Dialogue: 0,0:01:38.13,0:01:41.13,Default,,0,0,0,,Жеңімпаз... Кошиба Райка~!
Dialogue: 0,0:01:41.13,0:01:44.13,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:44.13,0:01:46.64,Default,,0,0,0,,Ол қайтадан келмеді.
Dialogue: 0,0:01:46.64,0:01:48.64,Default,,0,0,0,,Шайқас Сізге көп рахмет.
Dialogue: 0,0:01:48.64,0:01:51.11,Default,,0,0,0,,A…. Бұл тамаша жекпе-жек болды.
Dialogue: 0,0:01:53.14,0:01:55.14,Default,,0,0,0,,Ах➡
Dialogue: 0,0:01:55.14,0:01:57.11,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:01:59.15,0:02:02.15,Default,,0,0,0,,Уу…уу~➡
Dialogue: 0,0:02:02.15,0:02:04.65,Default,,0,0,0,,Бұл керемет жекпе-жек болды...
Dialogue: 0,0:02:04.65,0:02:07.16,Default,,0,0,0,,Не жыла, не тамақ іш.
Dialogue: 0,0:02:07.16,0:02:09.66,Default,,0,0,0,,Мм...бұқтырылған тағам дәмді.
Dialogue: 0,0:02:09.66,0:02:12.16,Default,,0,0,0,,Бұқтырылған тағам шынымен жақсы болды ма?
Dialogue: 0,0:02:12.16,0:02:14.66,Default,,0,0,0,,Егер сіз бір жыл бойы денсаулықты тойлап жатсаңыз, онда толығырақ...
Dialogue: 0,0:02:14.66,0:02:18.17,Default,,0,0,0,,Мен саған мені біртүрлі ерекше сезінбе деп айттым ғой, солай ма?
Dialogue: 0,0:02:18.17,0:02:21.17,Default,,0,0,0,,Бұл шын мәнінде мерейтой немесе басқа нәрсе емес.
Dialogue: 0,0:02:21.17,0:02:24.14,Default,,0,0,0,,Оның үстіне...Мен бұқтырылғанды ​​жақсы көремін.
Dialogue: 0,0:02:25.17,0:02:27.14,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:02:56.64,0:02:58.64,Default,,0,0,0,,Е...?
Dialogue: 0,0:02:58.64,0:03:01.14,Default,,0,0,0,,Қайда? Мұнда….
Dialogue: 0,0:03:01.14,0:03:03.61,Default,,0,0,0,,Әлде айтайын ба... Е!
Dialogue: 0,0:03:05.65,0:03:08.15,Default,,0,0,0,,Не...не болып жатыр?
Dialogue: 0,0:03:08.15,0:03:10.12,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:03:12.65,0:03:15.16,Default,,0,0,0,,Не...?
Dialogue: 0,0:03:15.16,0:03:17.13,Default,,0,0,0,,Ол….
Dialogue: 0,0:03:20.16,0:03:22.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:23.17,0:03:25.17,Default,,0,0,0,,Амансың ба? үлкен аға.
Dialogue: 0,0:03:25.17,0:03:27.14,Default,,0,0,0,,А...О, бұл жаман.
Dialogue: 0,0:03:29.17,0:03:33.11,Default,,0,0,0,,Мм...біртүрлі түс болса керек.
Dialogue: 0,0:03:33.11,0:03:36.11,Default,,0,0,0,,E~? Бұл жасөспірімдікке тән нәрсе ме?
Dialogue: 0,0:03:36.11,0:03:40.12,Default,,0,0,0,,Бұл не? Сіздің ағаңыз туралы не ойлайсыз?
Dialogue: 0,0:03:40.12,0:03:43.12,Default,,0,0,0,,Мен де қызық түс көргендей болдым.
Dialogue: 0,0:03:43.12,0:03:45.62,Default,,0,0,0,,Мен есімде жоқ.
Dialogue: 0,0:03:45.62,0:03:47.62,Default,,0,0,0,,Мен абдырап қалдым...
Dialogue: 0,0:03:47.62,0:03:49.62,Default,,0,0,0,,Мм... сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:03:49.62,0:03:51.63,Default,,0,0,0,,Сәлем! өтінемін.
Dialogue: 0,0:03:51.63,0:03:54.13,Default,,0,0,0,,Бұл...қала аспанда қалқып тұрғандай➡
Dialogue: 0,0:03:54.13,0:03:57.10,Default,,0,0,0,,Бұл мен бұрын-соңды көрмеген жер...
Dialogue: 0,0:03:58.13,0:04:01.14,Default,,0,0,0,,Менің басымнан бірдеңе ұшып кетті➡
Dialogue: 0,0:04:01.14,0:04:04.64,Default,,0,0,0,,Біртүрлі тыныштандыратын...
Dialogue: 0,0:04:04.64,0:04:07.14,Default,,0,0,0,,Әйтеуір... мазмұны тым үлпілдек➡
Dialogue: 0,0:04:07.14,0:04:10.11,Default,,0,0,0,,Ол мүлде кірмейді. Мм... әрине.
Dialogue: 0,0:04:12.65,0:04:15.15,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:04:15.15,0:04:18.15,Default,,0,0,0,,Кешегі Deluxe ақылсыз болды!
Dialogue: 0,0:04:18.15,0:04:20.66,Default,,0,0,0,,Мен Тайзо Сейзо жеңеді деп ойладым!
Dialogue: 0,0:04:20.66,0:04:22.66,Default,,0,0,0,,Бұл ұят болды.
Dialogue: 0,0:04:22.66,0:04:26.16,Default,,0,0,0,,Жеңімпаз Бұл жолы да олар біз сияқты жоғары сынып оқушылары➡
Dialogue: 0,0:04:26.16,0:04:28.16,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:28.16,0:04:30.60,Default,,0,0,0,,A~Kina! Сатып алу Сіз барасыз ба?
Dialogue: 0,0:04:30.60,0:04:33.10,Default,,0,0,0,,Жоқ, мен бүгін түскі ас ішемін.
Dialogue: 0,0:04:33.10,0:04:35.10,Default,,0,0,0,,Тағы да кешегі күннің қалдықтары?
Dialogue: 0,0:04:35.10,0:04:37.07,Default,,0,0,0,,Бұл күріш шары.
Dialogue: 0,0:04:38.61,0:04:40.61,Default,,0,0,0,,Соңғы кезде Хикари-чанның жағдайы қалай?
Dialogue: 0,0:04:40.61,0:04:43.61,Default,,0,0,0,,А... Соңғы кездері өзімді әлдеқайда жақсы сезініп жүрмін.
Dialogue: 0,0:04:43.61,0:04:47.12,Default,,0,0,0,,Мен қуанып тұрмын, себебі келесі аптада мектепке саяхатым бар.
Dialogue: 0,0:04:47.12,0:04:49.62,Default,,0,0,0,,Мен түсіндім~ бұл жақсы~➡
Dialogue: 0,0:04:49.62,0:04:51.59,Default,,0,0,0,,О!
Dialogue: 0,0:04:53.62,0:04:55.62,Default,,0,0,0,,Микото-сама~! ДДСҰ?
Dialogue: 0,0:04:55.62,0:04:57.63,Default,,0,0,0,,Бақа! Ол кумир➡
Dialogue: 0,0:04:57.63,0:05:01.63,Default,,0,0,0,,Дәл қазір мен сабаққа көңіл бөлу үшін күнде келемін! ➡
Dialogue: 0,0:05:01.63,0:05:05.13,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:05:05.13,0:05:08.64,Default,,0,0,0,,Жақында кездескенше! Микото-чан. (Сайто Микото) Кейін кездескенше.
Dialogue: 0,0:05:08.64,0:05:10.61,Default,,0,0,0,,Бұл сөзсіз сүйкімді.
Dialogue: 0,0:05:12.14,0:05:14.14,Default,,0,0,0,,Хэхе...аа!
Dialogue: 0,0:05:14.14,0:05:16.14,Default,,0,0,0,,Фугия~!
Dialogue: 0,0:05:16.14,0:05:18.15,Default,,0,0,0,,Ой...
Dialogue: 0,0:05:18.15,0:05:20.15,Default,,0,0,0,,Мм... жақсысың ба?
Dialogue: 0,0:05:20.15,0:05:23.15,Default,,0,0,0,,Ах! Бұл... бәрібір.
Dialogue: 0,0:05:23.15,0:05:25.65,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:05:25.65,0:05:28.66,Default,,0,0,0,,Оның ебедейсіз жағы да сүйкімді.
Dialogue: 0,0:05:28.66,0:05:31.09,Default,,0,0,0,,U….
Dialogue: 0,0:05:31.09,0:05:33.60,Default,,0,0,0,,Келіңіздер! Мен нан сатып аламын.
Dialogue: 0,0:05:33.60,0:05:35.56,Default,,0,0,0,,Мен орынды тауып беремін.
Dialogue: 0,0:05:37.10,0:05:39.57,Default,,0,0,0,,Теми Мені қалжыңдап тұрсың ба? A...un?
Dialogue: 0,0:05:41.10,0:05:43.10,Default,,0,0,0,,Ол бұл жайсыздық деп айтты! ➡
Dialogue: 0,0:05:43.10,0:05:45.61,Default,,0,0,0,,Бұл біздің кездесу орны.
Dialogue: 0,0:05:45.61,0:05:47.61,Default,,0,0,0,,Ой! Сіз тыңдайсыз ба? ➡
Dialogue: 0,0:05:47.61,0:05:49.61,Default,,0,0,0,,Тез жоғалыңыз!
Dialogue: 0,0:05:49.61,0:05:52.11,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:52.11,0:05:54.08,Default,,0,0,0,,Бұл...!
Dialogue: 0,0:05:56.62,0:05:58.62,Default,,0,0,0,,Гу….
Dialogue: 0,0:05:58.62,0:06:00.59,Default,,0,0,0,,｟(жоғары сынып оқушысы) Бұл не? Бұл жігіт... ｠
Dialogue: 0,0:06:01.62,0:06:03.63,Default,,0,0,0,,Эй, не болды? а….
Dialogue: 0,0:06:03.63,0:06:05.59,Default,,0,0,0,,Боқ... кешіріңіз! аға.
Dialogue: 0,0:06:06.63,0:06:10.13,Default,,0,0,0,,Бұл онигири үшін мені кешіріңіз!
Dialogue: 0,0:06:10.13,0:06:12.63,Default,,0,0,0,,Га? А~Және Сенпай➡
Dialogue: 0,0:06:12.63,0:06:15.14,Default,,0,0,0,,Хиромичи-сенпай сізді кафеге шақырды ма? ➡
Dialogue: 0,0:06:15.14,0:06:17.14,Default,,0,0,0,,Менің ойымша, сіз дереу баруыңыз керек.
Dialogue: 0,0:06:17.14,0:06:19.64,Default,,0,0,0,,Не... Таку!
Dialogue: 0,0:06:19.64,0:06:22.61,Default,,0,0,0,,Мына жігітке сөйлеуді үйретші, Ақина!
Dialogue: 0,0:06:29.15,0:06:31.09,Default,,0,0,0,,Ха~….
Dialogue: 0,0:06:31.09,0:06:33.59,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:06:33.59,0:06:37.09,Default,,0,0,0,,Аа...мен Хиромичи-сенпай шақырып жатыр деп шештім➡
Dialogue: 0,0:06:37.09,0:06:39.59,Default,,0,0,0,,Әңгіме Мен оны жинауым керек.
Dialogue: 0,0:06:39.59,0:06:42.10,Default,,0,0,0,,Ах! Менде күріш шарлары таусылды.
Dialogue: 0,0:06:42.10,0:06:44.10,Default,,0,0,0,,Түскі ас жоғалып кетті!
Dialogue: 0,0:06:44.10,0:06:46.60,Default,,0,0,0,,Олай болса маған неге бердіңіз? Міне бітті! ➡
Dialogue: 0,0:06:46.60,0:06:49.10,Default,,0,0,0,,Сыныптас ретінде шағымдануға батылым бар➡
Dialogue: 0,0:06:49.10,0:06:52.11,Default,,0,0,0,,Кішкене түсінікке ие болыңыз!
Dialogue: 0,0:06:52.11,0:06:54.58,Default,,0,0,0,,Міндетті емес. Мен мұны қажет болғандықтан айтып отырмын!
Dialogue: 0,0:06:57.61,0:06:59.61,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:06:59.61,0:07:01.62,Default,,0,0,0,,Нан...сенде қалды ма?
Dialogue: 0,0:07:01.62,0:07:04.09,Default,,0,0,0,,Жоқ. Бұл сіз...
Dialogue: 0,0:07:11.13,0:07:13.13,Default,,0,0,0,,Күткеніңізге рахмет! ➡
Dialogue: 0,0:07:13.13,0:07:15.13,Default,,0,0,0,,Қауын нан...жегіңіз келе ме?
Dialogue: 0,0:07:15.13,0:07:17.10,Default,,0,0,0,,Құдай... данышпан!
Dialogue: 0,0:07:18.13,0:07:20.14,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:07:20.14,0:07:23.14,Default,,0,0,0,,Сіз шынымен жақсы адамсыз ба, әлде көңілсіз адамсыз ба?
Dialogue: 0,0:07:23.14,0:07:25.61,Default,,0,0,0,,Сууға тек сен ғана қамқорлық жасайсың.
Dialogue: 0,0:07:27.64,0:07:30.11,Default,,0,0,0,,Мен оны жалғыз қалдыра алмаймын деп ойлаймын.
Dialogue: 0,0:07:30.11,0:07:32.08,Default,,0,0,0,,Ол.
Dialogue: 0,0:07:32.08,0:07:34.08,Default,,0,0,0,,Жоқ, сіз кіммен болса да солай болар едіңіз.
Dialogue: 0,0:07:34.08,0:07:36.58,Default,,0,0,0,,Иә? Оны білмеу...
Dialogue: 0,0:07:36.58,0:07:39.59,Default,,0,0,0,,Иә, сабақтан кейін боссың ба? Караокеге барайық.
Dialogue: 0,0:07:39.59,0:07:42.56,Default,,0,0,0,,Өкінішті...Бүгін менің де толық емес жұмысым бар. Мм...гамба.
Dialogue: 0,0:07:46.09,0:07:48.10,Default,,0,0,0,,Үшінші айналымдағы шығынды қалай қысқартуға болады➡
Dialogue: 0,0:07:48.10,0:07:50.10,Default,,0,0,0,,Бұл қате болды ма? ➡
Dialogue: 0,0:07:50.10,0:07:52.60,Default,,0,0,0,,Зиянды есептеу бірінші кезекте қате болған кезде➡
Dialogue: 0,0:07:52.60,0:07:54.60,Default,,0,0,0,,Ойыныңызды өзгерту керек болды ма➡
Dialogue: 0,0:07:54.60,0:07:57.11,Default,,0,0,0,,Күзетші аздап кеткен болуы мүмкін.
Dialogue: 0,0:07:57.11,0:07:59.11,Default,,0,0,0,,А...Нао-сенпай? Un?
Dialogue: 0,0:07:59.11,0:08:02.61,Default,,0,0,0,,Тағы да? иә! Алдыңғы турнирде жеңілгенім.
Dialogue: 0,0:08:02.61,0:08:05.11,Default,,0,0,0,,Бірінші бұрылыстан артыма қарадым.
Dialogue: 0,0:08:05.11,0:08:08.62,Default,,0,0,0,,Бұл керемет, солай емес пе? Сіз шайқастың бүкіл ағынын есте сақтайсыз.
Dialogue: 0,0:08:08.62,0:08:11.62,Default,,0,0,0,,Мен Vanguard кәсіпқойы болуды мақсат етіп отырмын.
Dialogue: 0,0:08:11.62,0:08:14.62,Default,,0,0,0,,Менің бүгін істейтін көп шаруам жоқ➡
Dialogue: 0,0:08:14.62,0:08:17.13,Default,,0,0,0,,Сіз бұрынғыдан да скучносыз ба? Акки.
Dialogue: 0,0:08:17.13,0:08:19.63,Default,,0,0,0,,Осы аптада мен сені Акки деп атаймын.
Dialogue: 0,0:08:19.63,0:08:22.13,Default,,0,0,0,,Иә? Өткен аптада не болды?
Dialogue: 0,0:08:22.13,0:08:24.13,Default,,0,0,0,,Бұл Кинако болды.
Dialogue: 0,0:08:24.13,0:08:26.13,Default,,0,0,0,,Кинако… Кинако?➡
Dialogue: 0,0:08:26.13,0:08:28.14,Default,,0,0,0,,Өткен аптада дәмім жақсырақ болды.
Dialogue: 0,0:08:28.14,0:08:31.64,Default,,0,0,0,,Хаха...Сенпай сен бүгін 4 күн қатарынан жұмыс істейсің➡
Dialogue: 0,0:08:31.64,0:08:34.14,Default,,0,0,0,,Жақында келесі турнир болады деп айтпадың ба?
Dialogue: 0,0:08:34.14,0:08:37.15,Default,,0,0,0,,Қауіпті дерлік! Келесі Нәтиже алмасаңыз➡
Dialogue: 0,0:08:37.15,0:08:39.15,Default,,0,0,0,,Сіз ешқашан кәсіпқой болмайсыз.
Dialogue: 0,0:08:39.15,0:08:41.15,Default,,0,0,0,,Ех! Сіз шымшып тұрған жоқсыз ба?
Dialogue: 0,0:08:41.15,0:08:44.15,Default,,0,0,0,,Ахх! Нао-сан, сіздің әмияныңыз да қысылып қалды➡
Dialogue: 0,0:08:44.15,0:08:46.15,Default,,0,0,0,,Университет кредиттері де аздап қалды~➡
Dialogue: 0,0:08:46.15,0:08:48.16,Default,,0,0,0,,Сіз қиындыққа тап болдыңыз.
Dialogue: 0,0:08:48.16,0:08:50.16,Default,,0,0,0,,(Қоңырау үнін енгізу)
Dialogue: 0,0:08:50.16,0:08:52.16,Default,,0,0,0,,Келіңіздер! Жұмыс...
Dialogue: 0,0:08:52.16,0:08:54.16,Default,,0,0,0,,Қош келдіңіз~➡
Dialogue: 0,0:08:54.16,0:08:56.16,Default,,0,0,0,,Cock Million-ға қош келдіңіз!
Dialogue: 0,0:08:56.16,0:08:58.13,Default,,0,0,0,,Тез ауысыңыз!
Dialogue: 0,0:09:12.18,0:09:14.15,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:09:15.68,0:09:18.69,Default,,0,0,0,,Аа, кешіріңіз. (Масанори Исеги) Жоқ, жоқ….
Dialogue: 0,0:09:18.69,0:09:21.69,Default,,0,0,0,,Сіз екеуміздің байланысымыз бар сияқты. Un?
Dialogue: 0,0:09:21.69,0:09:24.16,Default,,0,0,0,,А...рахмет.
Dialogue: 0,0:09:25.69,0:09:28.20,Default,,0,0,0,,Құдайға арқа сүйеу оңай~➡
Dialogue: 0,0:09:28.20,0:09:31.13,Default,,0,0,0,,Тек қолдарыңызды біріктіріп, дұға етіңіз.
Dialogue: 0,0:09:31.13,0:09:34.60,Default,,0,0,0,,Адам болсаң, күресуге тура келеді.
Dialogue: 0,0:09:37.64,0:09:39.61,Default,,0,0,0,,Қараңғы болса да күннен қорғайтын көзілдірік.
Dialogue: 0,0:09:41.14,0:09:43.11,Default,,0,0,0,,Түнде келуді доғарайық.
Dialogue: 0,0:09:45.15,0:09:47.12,Default,,0,0,0,,(Кашива қолы)
Dialogue: 0,0:09:50.15,0:09:52.12,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:09:55.16,0:09:57.66,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:09:57.66,0:10:00.13,Default,,0,0,0,,Ах! Кешегі қайнатпа.
Dialogue: 0,0:10:01.16,0:10:03.67,Default,,0,0,0,,А... иә?
Dialogue: 0,0:10:03.67,0:10:05.63,Default,,0,0,0,,​​Бұл….
Dialogue: 0,0:10:09.67,0:10:11.64,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:10:19.68,0:10:21.68,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:10:21.68,0:10:23.69,Default,,0,0,0,,Хикари? а.
Dialogue: 0,0:10:23.69,0:10:25.69,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:25.69,0:10:27.69,Default,,0,0,0,,Сіз ояндыңыз ба? Әкең ше?
Dialogue: 0,0:10:27.69,0:10:30.63,Default,,0,0,0,,Ол әлі келген жоқ. Мен көремін...
Dialogue: 0,0:10:30.63,0:10:33.13,Default,,0,0,0,,Сіздің ағаңыз жедел жәрдем шақырды ма?
Dialogue: 0,0:10:33.13,0:10:36.13,Default,,0,0,0,,А...мейірбике, мені шақырма.
Dialogue: 0,0:10:36.13,0:10:38.63,Default,,0,0,0,,А, мен жасадым.
Dialogue: 0,0:10:38.63,0:10:41.14,Default,,0,0,0,,Мектепке саяхат Мен барғым келді.
Dialogue: 0,0:10:41.14,0:10:43.61,Default,,0,0,0,,Сіз әлі білмейсіз. Бұл мүмкін емес.
Dialogue: 0,0:10:46.14,0:10:49.64,Default,,0,0,0,,Жарайды, көмектесуге болмайды, өмір солай.
Dialogue: 0,0:10:49.64,0:10:53.15,Default,,0,0,0,,Бұл дұрыс емес...! Мейдо мырза, көңіл күйіңіз қалай?
Dialogue: 0,0:10:53.15,0:10:55.62,Default,,0,0,0,,Қазір жағдай тынышталған сияқты.
Dialogue: 0,0:10:58.65,0:11:00.62,Default,,0,0,0,,｟Мен ештеңе айта алмадым. ｠
Dialogue: 0,0:11:03.16,0:11:06.66,Default,,0,0,0,,｟Хикари кішкентай кезінен бері әлсіз болды➡
Dialogue: 0,0:11:06.66,0:11:09.16,Default,,0,0,0,,Ауруханаға жиі кіріп-шығатын. ｠
Dialogue: 0,0:11:09.16,0:11:11.63,Default,,0,0,0,,｟Үлкен аға, әкеңіз ше? ｠
Dialogue: 0,0:11:12.67,0:11:14.67,Default,,0,0,0,,｟Ата-анасы ажырасқан➡
Dialogue: 0,0:11:14.67,0:11:17.67,Default,,0,0,0,,Менің әкем полиция қызметкері үнемі жұмыстан қолы босамайтын. ｠
Dialogue: 0,0:11:17.67,0:11:20.68,Default,,0,0,0,,｟Әке – әділдіктің батыры➡
Dialogue: 0,0:11:20.68,0:11:23.65,Default,,0,0,0,,Мен олардың қылмыскерді ұстайтынына сенімдімін. ｠
Dialogue: 0,0:11:27.68,0:11:30.65,Default,,0,0,0,,｟Мен әрқашан ештеңе істей алмаймын. ｠
Dialogue: 0,0:11:39.13,0:11:41.60,Default,,0,0,0,,｟Егер менің қолымнан бірдеңе келсе...! ｠
Dialogue: 0,0:11:49.64,0:11:51.64,Default,,0,0,0,,Ым?
Dialogue: 0,0:11:51.64,0:11:53.64,Default,,0,0,0,,О...
Dialogue: 0,0:11:53.64,0:11:55.64,Default,,0,0,0,,Мұнда….
Dialogue: 0,0:11:55.64,0:11:57.65,Default,,0,0,0,,Түсімде көрдім...аа!
Dialogue: 0,0:12:03.15,0:12:05.15,Default,,0,0,0,,Сіз….
Dialogue: 0,0:12:05.15,0:12:07.12,Default,,0,0,0,,Сен несің...?
Dialogue: 0,0:12:15.66,0:12:24.67,Default,,0,0,0,,♬～
Dialogue: 0,0:12:24.67,0:12:26.67,Default,,0,0,0,,U….
Dialogue: 0,0:12:26.67,0:12:28.68,Default,,0,0,0,,Карточка?
Dialogue: 0,0:12:28.68,0:12:30.61,Default,,0,0,0,,Неліктен менде мұндай нәрсе бар ...
Dialogue: 0,0:12:30.61,0:12:33.11,Default,,0,0,0,,...Е!
Dialogue: 0,0:12:33.11,0:12:35.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:35.62,0:12:38.62,Default,,0,0,0,,Бұл тағдыр картасы. Un?
Dialogue: 0,0:12:38.62,0:12:40.62,Default,,0,0,0,,E?
Dialogue: 0,0:12:40.62,0:12:43.63,Default,,0,0,0,,Акина Мейдо! Сіз таңдадыңыз➡
Dialogue: 0,0:12:43.63,0:12:46.63,Default,,0,0,0,,Сіздің тағдырыңызды өзгертетін шайқас! Аты да...
Dialogue: 0,0:12:46.63,0:12:49.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:49.63,0:12:52.13,Default,,0,0,0,,Елес~!
Dialogue: 0,0:12:52.13,0:12:55.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:55.14,0:12:57.11,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:12:59.11,0:13:01.61,Default,,0,0,0,,Хаа….
Dialogue: 0,0:13:04.08,0:13:07.08,Default,,0,0,0,,Ха~...бұл не болды? ертерек.
Dialogue: 0,0:13:07.08,0:13:09.58,Default,,0,0,0,,Мен болған оқиға.
Dialogue: 0,0:13:09.58,0:13:11.55,Default,,0,0,0,,E?
Dialogue: 0,0:13:14.09,0:13:16.09,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:16.09,0:13:18.09,Default,,0,0,0,,Теңіз балдырларының елесі!
Dialogue: 0,0:13:18.09,0:13:21.60,Default,,0,0,0,,Елес кім? Тыныштанып, жақынырақ қараңыз.
Dialogue: 0,0:13:21.60,0:13:24.10,Default,,0,0,0,,Ым? толтырылған ойыншық!
Dialogue: 0,0:13:24.10,0:13:26.10,Default,,0,0,0,,Иә. Бегемот толтырылған ойыншық!
Dialogue: 0,0:13:26.10,0:13:28.10,Default,,0,0,0,,Айдаһарлар ақымақ!
Dialogue: 0,0:13:28.10,0:13:30.61,Default,,0,0,0,,Иә? Тұлыптар сөйлей алады ма?
Dialogue: 0,0:13:30.61,0:13:33.61,Default,,0,0,0,,Негізі тұлыптар ұша алады ма?
Dialogue: 0,0:13:33.61,0:13:36.11,Default,,0,0,0,,Мм...! Сондықтан сабыр етіңіз➡
Dialogue: 0,0:13:36.11,0:13:39.11,Default,,0,0,0,,Бұл тұлыпқа ұқсайды, бірақ бұл оның шынайы түрі емес! ➡
Dialogue: 0,0:13:39.11,0:13:41.62,Default,,0,0,0,,Менің атым Габриэлиус➡
Dialogue: 0,0:13:41.62,0:13:44.12,Default,,0,0,0,,Бұл тек рухани денені бекітіп, оны басқару.
Dialogue: 0,0:13:44.12,0:13:46.12,Default,,0,0,0,,Габ? Рухани дене...
Dialogue: 0,0:13:46.12,0:13:48.12,Default,,0,0,0,,Бұл елес ғой...
Dialogue: 0,0:13:48.12,0:13:50.63,Default,,0,0,0,,Мұқият тыңдаңыз! Мен сізге айтайын деп келдім➡
Dialogue: 0,0:13:50.63,0:13:53.63,Default,,0,0,0,,Тағдырыңды сынауға мүмкіндік берсін.
Dialogue: 0,0:13:53.63,0:13:55.63,Default,,0,0,0,,E?
Dialogue: 0,0:13:55.63,0:13:58.63,Default,,0,0,0,,Тағдыр картасын алған 6 таңдалған адам➡
Dialogue: 0,0:13:58.63,0:14:00.57,Default,,0,0,0,,Тағдырыңды өзгерту күші➡
Dialogue: 0,0:14:00.57,0:14:04.07,Default,,0,0,0,,Авангардтық шайқаста жеңіс немесе жеңіліс үшін шайқас➡
Dialogue: 0,0:14:04.07,0:14:06.54,Default,,0,0,0,,Оның аты Тағдыр соғысы.
Dialogue: 0,0:14:08.08,0:14:11.58,Default,,0,0,0,,Ұрыс соңында тек бір адам соңына дейін аман қалады➡
Dialogue: 0,0:14:11.58,0:14:15.05,Default,,0,0,0,,Сіз өз тағдырыңызды өзгертіп, тілектеріңізді орындай аласыз.
Dialogue: 0,0:14:16.58,0:14:19.59,Default,,0,0,0,,Қолыңда ұстағаның – тағдырдың ғажайып картасы.
Dialogue: 0,0:14:19.59,0:14:22.09,Default,,0,0,0,,Меншік иесі болған сізге➡
Dialogue: 0,0:14:22.09,0:14:24.59,Default,,0,0,0,,Тағдыр соғысына қатысуға құқылы.
Dialogue: 0,0:14:24.59,0:14:28.60,Default,,0,0,0,,Сол сұрапыл соғыста бір адам аман қалса➡
Dialogue: 0,0:14:28.60,0:14:31.10,Default,,0,0,0,,Кез келген тілек орындалады дейді...?
Dialogue: 0,0:14:31.10,0:14:34.10,Default,,0,0,0,,Дәлірек айтсақ, кез келген тілек орындала бермейді.
Dialogue: 0,0:14:34.10,0:14:38.61,Default,,0,0,0,,Бірақ сіздің тілегіңіз ғажайып тағдырды өзіне тартты➡
Dialogue: 0,0:14:38.61,0:14:41.11,Default,,0,0,0,,Сонда ол ғажайып ➡ болады
Dialogue: 0,0:14:41.11,0:14:43.11,Default,,0,0,0,,Бұл сіздің тілектеріңізге жауап деп ойлаймын.
Dialogue: 0,0:14:43.11,0:14:46.11,Default,,0,0,0,,Қалау? Ғажайып тағдыр қолында➡
Dialogue: 0,0:14:46.11,0:14:48.62,Default,,0,0,0,,Бұл емдік күш. Емдеу?
Dialogue: 0,0:14:48.62,0:14:50.62,Default,,0,0,0,,Бірақ мен бұған сене алар емеспін ➡
Dialogue: 0,0:14:50.62,0:14:52.62,Default,,0,0,0,,Карталар сіздің тілектеріңізді орындай алады...
Dialogue: 0,0:14:52.62,0:14:56.62,Default,,0,0,0,,Сіз тұлыптың ауада қалқып, сөйлеп тұрғанын көргіңіз келе ме?
Dialogue: 0,0:14:56.62,0:14:59.13,Default,,0,0,0,,Жоқ, бірақ...!
Dialogue: 0,0:14:59.13,0:15:01.06,Default,,0,0,0,,Оның үстіне...Менің ойымша, біз кездестірдік.
Dialogue: 0,0:15:01.06,0:15:03.03,Default,,0,0,0,,E….
Dialogue: 0,0:15:06.57,0:15:08.57,Default,,0,0,0,,Сізде де бар ма? ➡
Dialogue: 0,0:15:08.57,0:15:10.54,Default,,0,0,0,,Мен шынымен өзгерткім келетін тағдыр бар.
Dialogue: 0,0:15:12.07,0:15:14.08,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:14.08,0:15:17.08,Default,,0,0,0,,Жауабын тыңдау үшін оралайық.
Dialogue: 0,0:15:17.08,0:15:20.58,Default,,0,0,0,,Бірақ сақ болыңыз! Тағдыр соғысы басталғанға дейін➡
Dialogue: 0,0:15:20.58,0:15:23.08,Default,,0,0,0,,Күндер жоқ!
Dialogue: 0,0:15:23.08,0:15:25.05,Default,,0,0,0,,Уау...!
Dialogue: 0,0:15:29.09,0:15:31.06,Default,,0,0,0,,E?
Dialogue: 0,0:15:33.59,0:15:36.06,Default,,0,0,0,,｟Мен шынымен өзгерткім келетін тағдыр... ｠
Dialogue: 0,0:15:40.60,0:15:43.10,Default,,0,0,0,,Уау. Кеше маған соны талап етті.
Dialogue: 0,0:15:43.10,0:15:45.11,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:15:45.11,0:15:48.11,Default,,0,0,0,,Енді уақытым бар, мен палубаны қалпына келтіремін.
Dialogue: 0,0:15:48.11,0:15:50.11,Default,,0,0,0,,Маған Vanguard өте ұнайды.
Dialogue: 0,0:15:50.11,0:15:52.11,Default,,0,0,0,,Ум!
Dialogue: 0,0:15:52.11,0:15:54.62,Default,,0,0,0,,Ағаң да жасап көрсе екен.
Dialogue: 0,0:15:54.62,0:15:57.62,Default,,0,0,0,,Дұрыс... Un?
Dialogue: 0,0:15:57.62,0:15:59.62,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:15:59.62,0:16:01.56,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:16:01.56,0:16:04.06,Default,,0,0,0,,Бірақ мен біраз уақытқа ауруханада емделетін шығармын.
Dialogue: 0,0:16:04.06,0:16:06.56,Default,,0,0,0,,Un.
Dialogue: 0,0:16:06.56,0:16:09.06,Default,,0,0,0,,Сәлем! Неліктен сен менен гөрі депрессиядасың?
Dialogue: 0,0:16:09.06,0:16:11.57,Default,,0,0,0,,A...Кешіріңіз! Кешірім сұрауға да тыйым салынады! ➡
Dialogue: 0,0:16:11.57,0:16:13.57,Default,,0,0,0,,Тек айту үшін➡
Dialogue: 0,0:16:13.57,0:16:15.57,Default,,0,0,0,,Мен аянышты емеспін!
Dialogue: 0,0:16:15.57,0:16:18.57,Default,,0,0,0,,Мен өмірден ләззат аламын!
Dialogue: 0,0:16:18.57,0:16:21.58,Default,,0,0,0,,Келесі жолы мұңайып көрінсең, мен сені үрлеймін!
Dialogue: 0,0:16:21.58,0:16:24.58,Default,,0,0,0,,Бұл қорқынышты... Мен абай боламын.
Dialogue: 0,0:16:24.58,0:16:27.08,Default,,0,0,0,,Түсінгенше!
Dialogue: 0,0:16:27.08,0:16:29.08,Default,,0,0,0,,Хикари күшті.
Dialogue: 0,0:16:29.08,0:16:31.09,Default,,0,0,0,,Хмм...не?
Dialogue: 0,0:16:31.09,0:16:33.09,Default,,0,0,0,,Ештеңе!
Dialogue: 0,0:16:33.09,0:16:35.09,Default,,0,0,0,,Мен толық емес жұмыс күнім болады, сондықтан кететін уақыт болды.
Dialogue: 0,0:16:35.09,0:16:37.06,Default,,0,0,0,,Ум! қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:16:40.60,0:16:43.10,Default,,0,0,0,,｟Кімнен сұрағаным есімде жоқ ➡
Dialogue: 0,0:16:43.10,0:16:47.10,Default,,0,0,0,,Кішкентай кезімнен жүрегімде сақталған сөздер бар. ｠
Dialogue: 0,0:16:47.10,0:16:51.11,Default,,0,0,0,,Аз ғана жарықтың өзі қолын созғандарға ғана➡
Dialogue: 0,0:16:51.11,0:16:53.07,Default,,0,0,0,,Ғажайыптар түседі.
Dialogue: 0,0:16:54.11,0:16:56.61,Default,,0,0,0,,｟Тілегіңіздің орындалғанын қаласаңыз➡
Dialogue: 0,0:16:56.61,0:16:58.61,Default,,0,0,0,,Тағдырыңды өзгерткің келсе➡
Dialogue: 0,0:16:58.61,0:17:00.58,Default,,0,0,0,,Мен...! ｠
Dialogue: 0,0:17:03.62,0:17:05.62,Default,,0,0,0,,Нао-сенпай, өтінемін!
Dialogue: 0,0:17:05.62,0:17:08.62,Default,,0,0,0,,Е! не болды? Кенеттен.
Dialogue: 0,0:17:08.62,0:17:11.09,Default,,0,0,0,,Айтыңызшы... Авангард!
Dialogue: 0,0:17:12.63,0:17:16.13,Default,,0,0,0,,Менің жеңгім келетін карта төбелесім бар.
Dialogue: 0,0:17:16.13,0:17:19.10,Default,,0,0,0,,Бірақ мен Авангард туралы бұлыңғыр ғана білемін...
Dialogue: 0,0:17:20.13,0:17:22.60,Default,,0,0,0,,Мен басқалардан күшті болғым келеді.
Dialogue: 0,0:17:24.64,0:17:27.14,Default,,0,0,0,,Хмм... мінекей➡
Dialogue: 0,0:17:27.14,0:17:30.14,Default,,0,0,0,,Менен артық па? Жоқ, бұл...
Dialogue: 0,0:17:30.14,0:17:32.65,Default,,0,0,0,,Ахаха...Мен қалжыңдап тұрмын!
Dialogue: 0,0:17:32.65,0:17:35.15,Default,,0,0,0,,Бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:17:35.15,0:17:37.15,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:37.15,0:17:40.66,Default,,0,0,0,,Ойлап қарасам, Акиге гамбургер жасауды да үйреттім➡
Dialogue: 0,0:17:40.66,0:17:43.16,Default,,0,0,0,,Бұл менмін. Эх...сәлем.
Dialogue: 0,0:17:43.16,0:17:47.66,Default,,0,0,0,,Парфетті қалай ұсынуға болады және тас грильде пісірілген бибибапты қалай қыздыру керек ➡
Dialogue: 0,0:17:47.66,0:17:50.16,Default,,0,0,0,,Бізде қызметкерлер көп емес.
Dialogue: 0,0:17:50.16,0:17:52.67,Default,,0,0,0,,Әй, Сенпай?
Dialogue: 0,0:17:52.67,0:17:54.67,Default,,0,0,0,,Ум! Түсіндім.
Dialogue: 0,0:17:54.67,0:17:57.67,Default,,0,0,0,,Сіз аға ретінде киіміңізді шешіп бере аласыз ба?
Dialogue: 0,0:17:57.67,0:18:00.14,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:18:00.14,0:18:02.61,Default,,0,0,0,,Палуба туралы не деуге болады? Қазір бастағыңыз келсе➡
Dialogue: 0,0:18:02.61,0:18:04.61,Default,,0,0,0,,Сізде ол әлі жоқ.
Dialogue: 0,0:18:04.61,0:18:06.61,Default,,0,0,0,,А...сәлем, жоқ.
Dialogue: 0,0:18:06.61,0:18:08.58,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:18:10.12,0:18:12.12,Default,,0,0,0,,Meg-chan Yahoo!
Dialogue: 0,0:18:12.12,0:18:14.62,Default,,0,0,0,,Ах! Нао-сан, қош келдіңіз.
Dialogue: 0,0:18:14.62,0:18:17.12,Default,,0,0,0,,Сәлеметсіз бе. Артқы жағындағы кеңістікпен күресу➡
Dialogue: 0,0:18:17.12,0:18:19.13,Default,,0,0,0,,Мен оны пайдалана аламын ба?
Dialogue: 0,0:18:19.13,0:18:21.13,Default,,0,0,0,,Мен де оқу тақтасын алғым келеді.
Dialogue: 0,0:18:21.13,0:18:23.63,Default,,0,0,0,,Жарайды, ел болып не істеуіміз керек?
Dialogue: 0,0:18:23.63,0:18:25.60,Default,,0,0,0,,Е...ұлт?
Dialogue: 0,0:18:27.13,0:18:29.64,Default,,0,0,0,,Авангард әлемінде алты ұлт бар➡
Dialogue: 0,0:18:29.64,0:18:32.61,Default,,0,0,0,,Сол ұлтқа тиесілі карталарды пайдаланып күрес.
Dialogue: 0,0:18:33.64,0:18:37.14,Default,,0,0,0,,Айдаһарлар империясы, айдаһарлар аспан арқылы ұшатын үлкен ел.
Dialogue: 0,0:18:37.14,0:18:40.62,Default,,0,0,0,,Қараңғы мемлекеттер, мәңгілік қараңғылыққа оранған сиқырлы халық.
Dialogue: 0,0:18:41.65,0:18:45.62,Default,,0,0,0,,Стойкея, аспан, теңіз және жасыл желектермен қоршалған утопиялық ел.
Dialogue: 0,0:18:46.65,0:18:50.63,Default,,0,0,0,,Academy City Лирикалық Монастрио алып киттің арқасына мінеді.
Dialogue: 0,0:18:51.66,0:18:54.66,Default,,0,0,0,,Жетілдірілген ғылым мен технологияға ие Грант қақпасы.
Dialogue: 0,0:18:54.66,0:18:58.13,Default,,0,0,0,,Кетер киелі орны, аспанда қалықтаған киелі астана.
Dialogue: 0,0:18:59.17,0:19:01.10,Default,,0,0,0,,A…. Un? ➡
Dialogue: 0,0:19:01.10,0:19:03.10,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:19:03.10,0:19:06.11,Default,,0,0,0,,Кетер киелі орны….
Dialogue: 0,0:19:06.11,0:19:09.11,Default,,0,0,0,,Сіз қорқып қалдыңыз ба?
Dialogue: 0,0:19:09.11,0:19:11.61,Default,,0,0,0,,Ал... сәлем!
Dialogue: 0,0:19:11.61,0:19:15.08,Default,,0,0,0,,Мен...Мен осы Кетел киелі жерін таңдаймын!
Dialogue: 0,0:19:17.62,0:19:19.62,Default,,0,0,0,,Сәлеметсіз бе. Рахмет➡
Dialogue: 0,0:19:19.62,0:19:22.62,Default,,0,0,0,,Мейірімді болыңыз. Мег Чан жақсы қыз➡
Dialogue: 0,0:19:22.62,0:19:24.63,Default,,0,0,0,,Ол шын мәнінде жас ханым➡
Dialogue: 0,0:19:24.63,0:19:28.63,Default,,0,0,0,,Сіз өзіңіздің картаңызды сатып алуды шештіңіз және толық емес жұмыс күнімен жұмыс істеп жатырсыз, солай ма? ➡
Dialogue: 0,0:19:28.63,0:19:31.13,Default,,0,0,0,,Мен оны болжай аламын. Эй...!
Dialogue: 0,0:19:31.13,0:19:34.60,Default,,0,0,0,,Олай болса, мен дүкенге қараймын, егер сізге бірдеңе керек болса, маған хабарласыңыз!
Dialogue: 0,0:19:37.14,0:19:40.14,Default,,0,0,0,,Ал, бастайық. өтінемін!
Dialogue: 0,0:19:40.14,0:19:42.64,Default,,0,0,0,,Алдымен жекпе-жекті дайындаңыз.
Dialogue: 0,0:19:42.64,0:19:44.65,Default,,0,0,0,,Палубаны дайындаңыз және ➡
Dialogue: 0,0:19:44.65,0:19:46.65,Default,,0,0,0,,Атпен жүру алаңы.
Dialogue: 0,0:19:46.65,0:19:50.62,Default,,0,0,0,,0-дәрежелі бірлік картасын палубадан бетін төмен қаратып ортаға салыңыз.
Dialogue: 0,0:19:53.65,0:19:56.16,Default,,0,0,0,,Оны елестетіп көріңіз. сурет?
Dialogue: 0,0:19:56.16,0:19:58.16,Default,,0,0,0,,Сонымен сурет.
Dialogue: 0,0:19:58.16,0:20:02.10,Default,,0,0,0,,Біз қонатын жерде жекпе-жек кезеңі болады➡
Dialogue: 0,0:20:02.10,0:20:05.10,Default,,0,0,0,,Крей, Жерге ұқсас планета.
Dialogue: 0,0:20:05.10,0:20:07.10,Default,,0,0,0,,Ол жер алыс➡
Dialogue: 0,0:20:07.10,0:20:10.07,Default,,0,0,0,,Авангардта бейнеленген бірліктер тұратын планета.
Dialogue: 0,0:20:12.11,0:20:14.08,Default,,0,0,0,,Бөлім ... тұратын жер.
Dialogue: 0,0:20:15.11,0:20:17.61,Default,,0,0,0,,Крэйге қонған біз елеспіз.
Dialogue: 0,0:20:17.61,0:20:19.58,Default,,0,0,0,,Бұл әлсіз рухтан басқа ештеңе емес.
Dialogue: 0,0:20:20.61,0:20:22.62,Default,,0,0,0,,Дегенмен, біз рухани денеміз➡
Dialogue: 0,0:20:22.62,0:20:24.62,Default,,0,0,0,,Хёори Клэй бірлігіне.
Dialogue: 0,0:20:24.62,0:20:27.62,Default,,0,0,0,,Басқаша айтқанда, атқа міну күресуге мүмкіндік береді.
Dialogue: 0,0:20:27.62,0:20:31.13,Default,,0,0,0,,Ал біз ➡ міндік
Dialogue: 0,0:20:31.13,0:20:33.13,Default,,0,0,0,,Ол Авангард деп аталады.
Dialogue: 0,0:20:33.13,0:20:35.13,Default,,0,0,0,,... алыс планетадағы біреуге бару➡
Dialogue: 0,0:20:35.13,0:20:37.13,Default,,0,0,0,,Біздің жанымыз➡
Dialogue: 0,0:20:37.13,0:20:39.13,Default,,0,0,0,,Сіз қабаттасуды айтасыз ба?
Dialogue: 0,0:20:39.13,0:20:41.14,Default,,0,0,0,,О! поэтикалық образ.
Dialogue: 0,0:20:41.14,0:20:43.14,Default,,0,0,0,,Аки-кун, сізде Авангард үшін талант болуы мүмкін!
Dialogue: 0,0:20:43.14,0:20:45.14,Default,,0,0,0,,Бұл рас па? Un!
Dialogue: 0,0:20:45.14,0:20:47.14,Default,,0,0,0,,Өзіңнің бейнесімен күрес➡
Dialogue: 0,0:20:47.14,0:20:49.14,Default,,0,0,0,,Өйткені бұл ойын Авангард.
Dialogue: 0,0:20:49.14,0:20:51.15,Default,,0,0,0,,Керемет! Аз ғана➡
Dialogue: 0,0:20:51.15,0:20:53.15,Default,,0,0,0,,Мен қатты толқып тұрмын!
Dialogue: 0,0:20:53.15,0:20:55.15,Default,,0,0,0,,Дұрыс...! Енді палубадан➡
Dialogue: 0,0:20:55.15,0:20:57.15,Default,,0,0,0,,5 картаны тартқаннан кейін, сіз дайынсыз.
Dialogue: 0,0:20:57.15,0:20:59.65,Default,,0,0,0,,Негізінде, әрбір картаның шеберлігі бар➡
Dialogue: 0,0:20:59.65,0:21:01.59,Default,,0,0,0,,Оны күресу үшін пайдаланыңыз➡
Dialogue: 0,0:21:01.59,0:21:04.09,Default,,0,0,0,,Бұл Vanguard➡ нағыз толқуы
Dialogue: 0,0:21:04.09,0:21:06.09,Default,,0,0,0,,Бұл жолы ережелерді түсіндіремін➡
Dialogue: 0,0:21:06.09,0:21:08.60,Default,,0,0,0,,Дағдысыз орындайық. жоғары.
Dialogue: 0,0:21:08.60,0:21:11.10,Default,,0,0,0,,Алдымен мен бастайын.
Dialogue: 0,0:21:11.10,0:21:13.60,Default,,0,0,0,,Мен сізге ережелерді үйрете отырып, жалғастыруым керек.
Dialogue: 0,0:21:13.60,0:21:16.60,Default,,0,0,0,,Stand Up Vanguard➡ айқайымен шайқас
Dialogue: 0,0:21:16.60,0:21:19.11,Default,,0,0,0,,Картаны аударып, бастаңыз.
Dialogue: 0,0:21:19.11,0:21:22.61,Default,,0,0,0,,Осы сәттен бастап біз бірлікке сүйенеміз➡
Dialogue: 0,0:21:22.61,0:21:24.61,Default,,0,0,0,,Авангард болыңыз.
Dialogue: 0,0:21:24.61,0:21:26.61,Default,,0,0,0,,Дайынсың ба? Бұл тамаша! ➡
Dialogue: 0,0:21:26.61,0:21:28.62,Default,,0,0,0,,Рухың болса, ұтылмайсың!
Dialogue: 0,0:21:28.62,0:21:30.62,Default,,0,0,0,,О... мен айттым ғой!
Dialogue: 0,0:21:30.62,0:21:32.62,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:21:32.62,0:21:35.59,Default,,0,0,0,,Сәлем! (Акина/Нао) Авангард тұр!
Dialogue: 0,0:21:50.64,0:21:53.11,Default,,0,0,0,,Мен міндетті түрде... өзгертемін.
Dialogue: 0,0:21:54.14,0:21:56.11,Default,,0,0,0,,Тағдыр.
Dialogue: 0,0:21:57.61,0:22:03.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory