Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.10,0:00:04.60,Default,,0,0,0,,<2011 жылы карта ойынының шығуынан бастап➡
Dialogue: 0,0:00:04.60,0:00:07.60,Default,,0,0,0,,Содан бері аниме, смартфон қолданбалары, комикс, т.б.➡
Dialogue: 0,0:00:07.60,0:00:10.11,Default,,0,0,0,,Экстенсивті даму...>
Dialogue: 0,0:00:13.61,0:00:15.61,Default,,0,0,0,,<…тек жапондық емес…>
Dialogue: 0,0:00:19.62,0:00:21.62,Default,,0,0,0,,＜…Ләззат＞
Dialogue: 0,0:00:22.62,0:00:25.12,Default,,0,0,0,,<Және 2024 жылдың қаңтары➡
Dialogue: 0,0:00:25.12,0:00:27.62,Default,,0,0,0,,Жаңа аниме сериясы...>
Dialogue: 0,0:00:28.62,0:00:30.63,Default,,0,0,0,,<…Бастау>
Dialogue: 0,0:00:31.63,0:00:34.63,Default,,0,0,0,,<Бүгін...>
Dialogue: 0,0:00:48.64,0:00:51.65,Default,,0,0,0,,<Әлі көрмегендер мынаны қарап үлгереді>
Dialogue: 0,0:00:51.65,0:00:55.15,Default,,0,0,0,,<Жаңа серияны бірге қарастырайық! ＞
Dialogue: 0,0:01:08.10,0:01:11.60,Default,,0,0,0,,Карточка жекпе-жегі басталды! ! Авангард Дивинес➡
Dialogue: 0,0:01:11.60,0:01:14.10,Default,,0,0,0,,Бұл ерекше Доманка!
Dialogue: 0,0:01:21.11,0:01:23.11,Default,,0,0,0,,Бәріңе сәлем! ➡
Dialogue: 0,0:01:26.62,0:01:28.62,Default,,0,0,0,,Бәріңе сәлем...
Dialogue: 0,0:01:30.12,0:01:32.12,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:01:35.12,0:01:37.13,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:01:39.13,0:01:41.13,Default,,0,0,0,,Сонымен, қаңтар айында бастадық➡
Dialogue: 0,0:01:41.13,0:01:44.13,Default,,0,0,0,,Карточка күресі! ! Бұл Vanguard Divinez➡
Dialogue: 0,0:01:44.13,0:01:46.13,Default,,0,0,0,,6 серияға дейін трансляцияланды.
Dialogue: 0,0:01:47.14,0:01:49.14,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:01:49.14,0:01:52.14,Default,,0,0,0,,Тағдыр соғысы басталды...
Dialogue: 0,0:01:52.14,0:01:55.14,Default,,0,0,0,,Біз біршама прогреске қол жеткіздік. Көп.
Dialogue: 0,0:01:55.14,0:01:57.15,Default,,0,0,0,,Акина-кун жеңе береді.
Dialogue: 0,0:02:10.09,0:02:13.10,Default,,0,0,0,,Тайзо да... Дұрыс.
Dialogue: 0,0:02:13.10,0:02:15.60,Default,,0,0,0,,Мақсат басқа болса да, күрес.
Dialogue: 0,0:02:15.60,0:02:17.60,Default,,0,0,0,,Мен жеңе алмадым...
Dialogue: 0,0:02:17.60,0:02:21.60,Default,,0,0,0,,Бүгін келген екеуің...
Dialogue: 0,0:02:22.60,0:02:24.61,Default,,0,0,0,,Ал...
Dialogue: 0,0:02:26.61,0:02:28.61,Default,,0,0,0,,Кешіріңіз...деді.
Dialogue: 0,0:02:29.61,0:02:31.61,Default,,0,0,0,,Сонымен 1-бөлімнен 6-бөлімге дейін➡
Dialogue: 0,0:02:31.61,0:02:33.62,Default,,0,0,0,,Көп нәрсе болды➡
Dialogue: 0,0:02:36.12,0:02:38.12,Default,,0,0,0,,Барлығына...
Dialogue: 0,0:02:40.62,0:02:42.62,Default,,0,0,0,,Сонымен аниме көруді жоспарлап жүргендер үшін➡
Dialogue: 0,0:02:42.62,0:02:44.63,Default,,0,0,0,,Мен осы жерден жетемін➡
Dialogue: 0,0:02:44.63,0:02:47.13,Default,,0,0,0,,Бүгінгі хабарды тамашалаңыздар.
Dialogue: 0,0:02:59.07,0:03:01.58,Default,,0,0,0,,Осы жерден...
Dialogue: 0,0:03:08.12,0:03:10.12,Default,,0,0,0,,Бұл жолы үш адамның әрқайсысы➡
Dialogue: 0,0:03:10.12,0:03:13.62,Default,,0,0,0,,Сіз ойнап жатқан кейіпкерден басқа біреу➡
Dialogue: 0,0:03:13.62,0:03:17.13,Default,,0,0,0,,Сіз өзіңізге ұнайтын көріністі таңдадыңыз➡
Dialogue: 0,0:03:17.13,0:03:19.13,Default,,0,0,0,,Сіз қандай көріністі таңдадыңыз?➡
Dialogue: 0,0:03:24.13,0:03:26.13,Default,,0,0,0,,Инабе Наоның итеру сахнасы➡
Dialogue: 0,0:03:26.13,0:03:28.14,Default,,0,0,0,,Мен артқа қарағым келеді➡
Dialogue: 0,0:03:28.14,0:03:31.11,Default,,0,0,0,,Нишио мырза, Нао Инабені таныстыруыңызды өтінемін бе?
Dialogue: 0,0:03:43.09,0:03:45.59,Default,,0,0,0,,Маған Vanguard туралы айтып беріңізші! Маған ➡ деп сұрады
Dialogue: 0,0:03:45.59,0:03:49.56,Default,,0,0,0,,Сондай-ақ ол өзінің қожайыны ретінде Авангардпен қарым-қатынаста...
Dialogue: 0,0:03:52.09,0:03:56.60,Default,,0,0,0,,Нао-сенпай мен Акинаның арасында қаншама қарым-қатынас бар➡
Dialogue: 0,0:03:56.60,0:04:00.07,Default,,0,0,0,,Сіз маған өте мейірімді болдыңыз...
Dialogue: 0,0:04:01.60,0:04:03.61,Default,,0,0,0,,Бұл қиын, солай емес пе? Маған бұл қиын болды.
Dialogue: 0,0:04:03.61,0:04:06.07,Default,,0,0,0,,Маған қайсысы таңдалғаны қатты қызық.
Dialogue: 0,0:04:07.11,0:04:10.11,Default,,0,0,0,,Енді, Мията-сан, осындай көріністі ұсынсаң, қарсы боласың ба?
Dialogue: 0,0:04:10.11,0:04:13.58,Default,,0,0,0,,Міне, Нао-сенпайдың сүйікті көрінісі...
Dialogue: 0,0:04:19.12,0:04:21.09,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:04:22.12,0:04:24.13,Default,,0,0,0,,Бірінші кезекте Нао-сенпай Акинаға➡ қарсы
Dialogue: 0,0:04:24.13,0:04:27.63,Default,,0,0,0,,Сондай жарқын және мейірімді➡
Dialogue: 0,0:04:27.63,0:04:31.57,Default,,0,0,0,,Ол керемет аға➡
Dialogue: 0,0:04:41.08,0:04:45.58,Default,,0,0,0,,...Нао-сенпай осылай деді➡
Dialogue: 0,0:04:45.58,0:04:49.55,Default,,0,0,0,,Жарықтық Бұл көңіл көтеруде емес, бұл ... туралы.
Dialogue: 0,0:04:53.09,0:04:56.09,Default,,0,0,0,,Дубляж жасау кезінде➡
Dialogue: 0,0:05:03.10,0:05:05.60,Default,,0,0,0,,Нао-сенпай, оның шын айтып отырғаны осы шығар➡
Dialogue: 0,0:05:05.60,0:05:08.60,Default,,0,0,0,,Сезім...➡
Dialogue: 0,0:05:08.60,0:05:11.57,Default,,0,0,0,,1 эпизодтың дубляжында...
Dialogue: 0,0:05:16.11,0:05:18.08,Default,,0,0,0,,Саған қалай ұнады, Мано-сан?
Dialogue: 0,0:05:20.12,0:05:22.62,Default,,0,0,0,,Барлығына мән беретін нәрсе. Бұл...
Dialogue: 0,0:05:22.62,0:05:24.59,Default,,0,0,0,,Мен бұған көптен бері қызық болдым.
Dialogue: 0,0:05:27.12,0:05:29.12,Default,,0,0,0,,Біраз таң қалдыратын жеке киімдер...
Dialogue: 0,0:05:29.12,0:05:31.09,Default,,0,0,0,,Терінің түсі көп сияқты.
Dialogue: 0,0:05:59.09,0:06:01.09,Default,,0,0,0,,Жақсы Әнбайды іздеңіз➡
Dialogue: 0,0:06:01.09,0:06:03.59,Default,,0,0,0,,Сол жолды айтқаным есімде.
Dialogue: 0,0:06:03.59,0:06:05.59,Default,,0,0,0,,Айтпақшы, жеке киімдер ше?
Dialogue: 0,0:06:15.10,0:06:18.07,Default,,0,0,0,,Ерлерге мұндай әйел ұнайды, солай ма?
Dialogue: 0,0:06:23.11,0:06:25.11,Default,,0,0,0,,Енді Мано-санның орындауына көшейік➡
Dialogue: 0,0:06:25.11,0:06:27.62,Default,,0,0,0,,Seizo Taizo➡ туралы
Dialogue: 0,0:06:27.62,0:06:29.62,Default,,0,0,0,,Мано мырза, Тайзоны таныстырыңыз.
Dialogue: 0,0:06:29.62,0:06:31.59,Default,,0,0,0,,Мен орындаймын...
Dialogue: 0,0:06:40.56,0:06:42.56,Default,,0,0,0,,Жұмыс және Авангард➡
Dialogue: 0,0:06:42.56,0:06:45.07,Default,,0,0,0,,Байыпты және ынтамен жұмыс жасаңыз➡
Dialogue: 0,0:06:45.07,0:06:47.04,Default,,0,0,0,,Ол өте қызық жігіт.
Dialogue: 0,0:06:48.07,0:06:52.07,Default,,0,0,0,,Ол өзін өте мейірімді ұстады➡
Dialogue: 0,0:06:52.07,0:06:55.08,Default,,0,0,0,,Мен адам ретінде өте қабілеттімін➡
Dialogue: 0,0:06:55.08,0:06:57.05,Default,,0,0,0,,Өкінішке орай...
Dialogue: 0,0:06:58.58,0:07:01.58,Default,,0,0,0,,Анимеде көрсетілген бөліктерде...одан басқа, ол жеңеді.
Dialogue: 0,0:07:01.58,0:07:03.55,Default,,0,0,0,,Бұл жолы да сол жерден басталды.
Dialogue: 0,0:07:07.09,0:07:09.09,Default,,0,0,0,,Бірінші.
Dialogue: 0,0:07:13.09,0:07:15.06,Default,,0,0,0,,Мен бәріңізден сұрайын деп едім, сіз қалай ойлайсыз?
Dialogue: 0,0:07:16.10,0:07:20.57,Default,,0,0,0,,Міне, мен таңдаған Тайзо сахнасы...
Dialogue: 0,0:07:23.61,0:07:25.61,Default,,0,0,0,,Менің ойымша, Тайзо ханзада.
Dialogue: 0,0:07:25.61,0:07:27.61,Default,,0,0,0,,Сіз ханзадасыз ба? Неліктен?
Dialogue: 0,0:07:27.61,0:07:30.55,Default,,0,0,0,,Хикари-чанның ауруханаға түскен жері➡
Dialogue: 0,0:07:30.55,0:07:33.01,Default,,0,0,0,,Бірде қолында пудингпен кенет пайда болғандай...
Dialogue: 0,0:07:39.55,0:07:42.06,Default,,0,0,0,,Сіз мұны білмедіңіз деп ойлаймын.
Dialogue: 0,0:07:42.06,0:07:44.53,Default,,0,0,0,,Мен Авангардты ойнаған жоқпын.
Dialogue: 0,0:07:50.57,0:07:52.53,Default,,0,0,0,,Күдікті ханзада келгендей...
Dialogue: 0,0:07:55.57,0:07:58.04,Default,,0,0,0,,Мен сені ол туралы көп білмейсің деп ойладым, бірақ...
Dialogue: 0,0:08:02.58,0:08:04.55,Default,,0,0,0,,Біраз қатал жолдар бар.
Dialogue: 0,0:08:11.59,0:08:14.09,Default,,0,0,0,,Мен бұл керемет деп ойладым.
Dialogue: 0,0:08:14.09,0:08:18.09,Default,,0,0,0,,Тайзо аздап мазасызданады➡
Dialogue: 0,0:08:18.09,0:08:21.06,Default,,0,0,0,,Себебі бұл әзілге ұқсамайды...
Dialogue: 0,0:08:24.10,0:08:26.07,Default,,0,0,0,,Маған көптеген мақтау сөздер айтылды...
Dialogue: 0,0:08:44.12,0:08:46.12,Default,,0,0,0,,Басқалар үшін➡
Dialogue: 0,0:08:46.12,0:08:50.63,Default,,0,0,0,,Бұл үлкен істі бітіре алатын адам.➡
Dialogue: 0,0:08:50.63,0:08:53.09,Default,,0,0,0,,Күтілгендей, бұл шынымен де...
Dialogue: 0,0:09:14.65,0:09:16.62,Default,,0,0,0,,Мен көп нәрсеге қызық болдым...
Dialogue: 0,0:09:17.65,0:09:20.66,Default,,0,0,0,,Соңында Мията мырза әрекет етуде➡
Dialogue: 0,0:09:20.66,0:09:22.66,Default,,0,0,0,,Басты кейіпкер Акина Мейдо➡ туралы
Dialogue: 0,0:09:22.66,0:09:25.66,Default,,0,0,0,,Мен сізден әртүрлі нәрселер туралы сұрағым келеді.
Dialogue: 0,0:09:25.66,0:09:27.63,Default,,0,0,0,,Алдымен, Мията мырза, сізден Акинаны таныстыруыңызды өтінемін бе?
Dialogue: 0,0:09:28.66,0:09:30.63,Default,,0,0,0,,Мен орындаймын...
Dialogue: 0,0:09:42.11,0:09:44.61,Default,,0,0,0,,Шешуші болыңыз және әрекет жасаңыз➡
Dialogue: 0,0:09:44.61,0:09:46.61,Default,,0,0,0,,Дереу әрекет етіңіз➡
Dialogue: 0,0:09:46.61,0:09:48.62,Default,,0,0,0,,Көңілсіз болғанымен ➡
Dialogue: 0,0:09:48.62,0:09:50.62,Default,,0,0,0,,Достар сияқты отбасына деген сезімдер➡
Dialogue: 0,0:09:50.62,0:09:52.59,Default,,0,0,0,,Ол тамаша бала.
Dialogue: 0,0:09:53.62,0:09:57.63,Default,,0,0,0,,Екеуіңізден Акинаның жұмсақ мінезі туралы сұрағым келеді➡
Dialogue: 0,0:09:57.63,0:10:01.13,Default,,0,0,0,,Алдымен Мано мырзадан сұрасам болады ма?
Dialogue: 0,0:10:01.13,0:10:05.13,Default,,0,0,0,,Міне, мен таңдаған Акина сахнасы➡
Dialogue: 0,0:10:05.13,0:10:07.10,Default,,0,0,0,,Ден! …
Dialogue: 0,0:10:16.14,0:10:19.15,Default,,0,0,0,,Олар тез дос болып кететіндей әсер алдым➡
Dialogue: 0,0:10:19.15,0:10:22.15,Default,,0,0,0,,Микото-чан – ақжарқын адам➡
Dialogue: 0,0:10:22.15,0:10:24.15,Default,,0,0,0,,Таизо➡ үшін де солай\NЕгер бұл
Dialogue: 0,0:10:24.15,0:10:27.12,Default,,0,0,0,,болса, мен әлі де түсінемін ...
Dialogue: 0,0:10:49.11,0:10:51.08,Default,,0,0,0,,Мұндай нәрсе...
Dialogue: 0,0:10:53.11,0:10:57.09,Default,,0,0,0,,...Менің ойымша, бұл Акинаның өте тартымдылығы.
Dialogue: 0,0:10:58.12,0:11:00.12,Default,,0,0,0,,Енді, Нишио мырза, сізге сұрақ қоюға бола ма?
Dialogue: 0,0:11:00.12,0:11:03.59,Default,,0,0,0,,Міне, менің сүйікті Акина сахнасы...
Dialogue: 0,0:11:06.63,0:11:08.63,Default,,0,0,0,,Оны көптеген жерлерде кездестіруге болады➡
Dialogue: 0,0:11:08.63,0:11:11.13,Default,,0,0,0,,Ең алдымен, естеліктеріңізге➡
Dialogue: 0,0:11:11.13,0:11:13.64,Default,,0,0,0,,Күшті болып қалатын сияқты➡
Dialogue: 0,0:11:13.64,0:11:16.60,Default,,0,0,0,,1 эпизод...
Dialogue: 0,0:11:19.14,0:11:21.11,Default,,0,0,0,,Ой, бұл не, елес? Сонымен...
Dialogue: 0,0:11:23.14,0:11:27.12,Default,,0,0,0,,Мен сенің таң қалатыныңды білемін, бірақ...
Dialogue: 0,0:11:28.15,0:11:30.12,Default,,0,0,0,,Толық қуатта.
Dialogue: 0,0:11:30.12,0:11:32.59,Default,,0,0,0,,Ол сізді өлтіргенше ұшыңыз.
Dialogue: 0,0:11:44.10,0:11:48.10,Default,,0,0,0,,Сондықтан жаңадан бастаған Акина барын салады➡
Dialogue: 0,0:11:48.10,0:11:51.61,Default,,0,0,0,,Өте... ұту ықтималдығы төмен.
Dialogue: 0,0:11:51.61,0:11:54.11,Default,,0,0,0,,Бірақ мүмкіндікті арттыру үшін➡
Dialogue: 0,0:11:54.11,0:11:57.58,Default,,0,0,0,,Не істеріңізді білмесеңіз...
Dialogue: 0,0:12:02.12,0:12:05.09,Default,,0,0,0,,Қарапайым адамдар бұлай жасамас еді...
Dialogue: 0,0:12:06.12,0:12:09.09,Default,,0,0,0,,Оны сілкіп тастағанын көру өте әсерлі болды.
Dialogue: 0,0:12:16.63,0:12:18.60,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:12:23.64,0:12:26.11,Default,,0,0,0,,Суо қатысқан кезде...
Dialogue: 0,0:12:33.08,0:12:35.08,Default,,0,0,0,,Бұл үлкен сенім болды➡
Dialogue: 0,0:12:35.08,0:12:37.09,Default,,0,0,0,,Сондай-ақ, сенпайым күріш шарларын жақсы көреді➡
Dialogue: 0,0:12:37.09,0:12:39.05,Default,,0,0,0,,Білмесең істей алмайсың.
Dialogue: 0,0:12:47.10,0:12:50.60,Default,,0,0,0,,Сондай-ақ, Нишио мырзаның маған берген батылдығы ➡
Dialogue: 0,0:12:50.60,0:12:53.10,Default,,0,0,0,,Акина Менің ойымша, бұл өте керемет.
Dialogue: 0,0:12:53.10,0:12:57.61,Default,,0,0,0,,Маңызды нүкте 0:100➡ емес
Dialogue: 0,0:12:57.61,0:12:59.61,Default,,0,0,0,,Ықтималдылықты ➡ есептегеніңізге көз жеткізіңіз
Dialogue: 0,0:13:03.61,0:13:05.58,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:14.62,0:13:16.62,Default,,0,0,0,,Авангардқа қатысты ➡
Dialogue: 0,0:13:16.62,0:13:20.09,Default,,0,0,0,,Мен әлі күнге дейін емдік триггерді немесе бірдеңені шығарып, жеңетінімді сезінбеймін.
Dialogue: 0,0:13:22.63,0:13:25.10,Default,,0,0,0,,Маған кем дегенде емдеу триггерін қосу керек...
Dialogue: 0,0:13:28.14,0:13:31.11,Default,,0,0,0,,Ақырында Мията мырза да қасында болмайды...
Dialogue: 0,0:13:34.08,0:13:36.04,Default,,0,0,0,,Көңілді сияқты.
Dialogue: 0,0:13:37.08,0:13:39.58,Default,,0,0,0,,Айтпақшы, Мията мырзаның өзі көрді➡
Dialogue: 0,0:13:41.58,0:13:44.59,Default,,0,0,0,,Акинаның сүйікті сахнасы...
Dialogue: 0,0:13:47.59,0:13:49.59,Default,,0,0,0,,Жоғары коммуникативті дағдыларға да қатысты➡
Dialogue: 0,0:14:01.10,0:14:04.61,Default,,0,0,0,,Мен әпкемді қатты жақсы көремін➡
Dialogue: 0,0:14:04.61,0:14:06.57,Default,,0,0,0,,Менің ойымша, бұл итеру сахнасы.
Dialogue: 0,0:14:14.12,0:14:17.09,Default,,0,0,0,,Ғабқа тура оңды көргенде...
Dialogue: 0,0:14:21.62,0:14:23.59,Default,,0,0,0,,Жоқ…. А, жоқ па?
Dialogue: 0,0:14:28.13,0:14:30.10,Default,,0,0,0,,Бірақ бұл таңқаларлық, жоғары сипаттама.
Dialogue: 0,0:14:31.07,0:14:34.07,Default,,0,0,0,,1-ден 6-ға дейінгі эпизодтардағы кейіпкерлердің сүйкімділігі ➡
Dialogue: 0,0:14:34.07,0:14:37.07,Default,,0,0,0,,Сіз бұл туралы түрткі сахнасында айттыңыз...
Dialogue: 0,0:14:37.07,0:14:40.07,Default,,0,0,0,,...және одан әрі, әрине, сіз оны жіберіп алмайсыз.
Dialogue: 0,0:14:40.07,0:14:42.08,Default,,0,0,0,,Барлығы осылай істей береді деп сенемін➡
Dialogue: 0,0:14:42.08,0:14:44.05,Default,,0,0,0,,...
Dialogue: 0,0:14:46.58,0:14:50.08,Default,,0,0,0,,...
Dialogue: 0,0:15:05.10,0:15:07.57,Default,,0,0,0,,Карточка дүкендері туралы айтатын болсақ...
Dialogue: 0,0:15:12.61,0:15:14.61,Default,,0,0,0,,➡
Dialogue: 0,0:15:14.61,0:15:17.58,Default,,0,0,0,,…
Dialogue: 0,0:15:22.62,0:15:25.12,Default,,0,0,0,,ＶＴＲ
Dialogue: 0,0:15:27.62,0:15:29.62,Default,,0,0,0,,Se~no➡
Dialogue: 0,0:15:29.62,0:15:32.09,Default,,0,0,0,,VTR... өтінемін!
Dialogue: 0,0:15:33.56,0:15:37.57,Default,,0,0,0,,...
Dialogue: 0,0:15:37.57,0:15:41.04,Default,,0,0,0,,...
Dialogue: 0,0:15:43.04,0:15:45.04,Default,,0,0,0,,Иә, Мията-сан! иә!
Dialogue: 0,0:15:55.08,0:15:58.09,Default,,0,0,0,,…
Dialogue: 0,0:16:03.02,0:16:06.49,Default,,0,0,0,,…
Dialogue: 0,0:16:09.03,0:16:11.03,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:16:13.53,0:16:17.00,Default,,0,0,0,,…
Dialogue: 0,0:16:19.04,0:16:21.04,Default,,0,0,0,,➡
Dialogue: 0,0:16:21.04,0:16:23.04,Default,,0,0,0,,...
Dialogue: 0,0:16:23.04,0:16:25.05,Default,,0,0,0,,Жарайды, бірақ осындай жерде➡
Dialogue: 0,0:16:25.05,0:16:27.05,Default,,0,0,0,,…
Dialogue: 0,0:16:27.05,0:16:29.55,Default,,0,0,0,,…  ➡
Dialogue: 0,0:16:29.55,0:16:31.55,Default,,0,0,0,,ішке кірейік!
Dialogue: 0,0:16:50.07,0:16:52.04,Default,,0,0,0,,Рахмет! Бұл...
Dialogue: 0,0:17:15.60,0:17:18.10,Default,,0,0,0,,Мен ойнайтын кейіпкер Акина...
Dialogue: 0,0:17:18.10,0:17:20.60,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:17:20.60,0:17:22.57,Default,,0,0,0,,…
Dialogue: 0,0:17:26.11,0:17:28.11,Default,,0,0,0,,…
Dialogue: 0,0:17:28.11,0:17:30.61,Default,,0,0,0,,Керемет! эй! Бұл дұрыс.
Dialogue: 0,0:17:30.61,0:17:32.58,Default,,0,0,0,,～…
Dialogue: 0,0:17:41.12,0:17:43.12,Default,,0,0,0,,...
Dialogue: 0,0:17:55.64,0:17:57.64,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:17:57.64,0:17:59.61,Default,,0,0,0,,Бұрынғы өнімді дереу пайдаланыңыз.
Dialogue: 0,0:18:05.58,0:18:07.55,Default,,0,0,0,,Се-жоқ...
Dialogue: 0,0:18:17.59,0:18:19.56,Default,,0,0,0,,Бірінші шабуыл Итадакамасу. өтінемін!
Dialogue: 0,0:18:23.60,0:18:26.07,Default,,0,0,0,,～
Dialogue: 0,0:18:28.10,0:18:30.07,Default,,0,0,0,,...
Dialogue: 0,0:18:31.11,0:18:33.07,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:18:49.12,0:18:51.09,Default,,0,0,0,,…～
Dialogue: 0,0:18:54.63,0:18:56.63,Default,,0,0,0,,１ ２ ３ …➡
Dialogue: 0,0:18:56.63,0:18:59.10,Default,,0,0,0,,4...48000! келді!
Dialogue: 0,0:19:07.58,0:19:09.58,Default,,0,0,0,,О, жоқ... кеттік!
Dialogue: 0,0:19:09.58,0:19:11.58,Default,,0,0,0,,Емдеңіз және сұраңыз!
Dialogue: 0,0:19:11.58,0:19:13.55,Default,,0,0,0,,Иә... Триггерді сызыңыз!
Dialogue: 0,0:19:14.58,0:19:16.58,Default,,0,0,0,,...
Dialogue: 0,0:19:16.58,0:19:18.59,Default,,0,0,0,,～
Dialogue: 0,0:19:18.59,0:19:21.06,Default,,0,0,0,,Заревсаэль мықты! күшті!
Dialogue: 0,0:19:25.09,0:19:27.06,Default,,0,0,0,,Бұл қызық болды! Ол жылытылды!
Dialogue: 0,0:19:29.10,0:19:31.07,Default,,0,0,0,,Бұл карта дүкенінің есебі қалай болды?
Dialogue: 0,0:19:36.60,0:19:38.61,Default,,0,0,0,,...Әртүрлі карталар болғанымен қызықты болды➡
Dialogue: 0,0:19:38.61,0:19:42.11,Default,,0,0,0,,Ең бастысы, бастапқы палуба мен күткеннен де күшті болды!
Dialogue: 0,0:19:42.11,0:19:45.11,Default,,0,0,0,,Жоқ, дұрыс! Бұл шынымен жақсы.
Dialogue: 0,0:19:47.62,0:19:49.62,Default,,0,0,0,,Олай болса, ол күшейгеннен кейін, оны күшейту керек.➡
Dialogue: 0,0:19:49.62,0:19:52.62,Default,,0,0,0,,Мен бұл өте қызық болар деп ойладым.
Dialogue: 0,0:19:59.13,0:20:01.56,Default,,0,0,0,,...Міне, карта дүкені туралы есеп➡
Dialogue: 0,0:20:01.56,0:20:03.53,Default,,0,0,0,,Мен оны студияға қайтарамын!
Dialogue: 0,0:20:05.57,0:20:07.54,Default,,0,0,0,,Сонымен, жеңімпаз Тошия Мията!
Dialogue: 0,0:20:09.07,0:20:11.04,Default,,0,0,0,,Біз жеңдік!
Dialogue: 0,0:20:15.58,0:20:17.55,Default,,0,0,0,,Иә, жеке өзім жеңгім келді!
Dialogue: 0,0:20:22.08,0:20:24.05,Default,,0,0,0,,Жоқ, кез келген уақытта...
Dialogue: 0,0:20:25.09,0:20:27.05,Default,,0,0,0,,Бұл рас...
Dialogue: 0,0:20:28.09,0:20:30.06,Default,,0,0,0,,Жоқ... бұл дұрыс емес...
Dialogue: 0,0:20:33.09,0:20:35.10,Default,,0,0,0,,Жасағым келеді... Жасағым келеді!
Dialogue: 0,0:20:38.60,0:20:40.57,Default,,0,0,0,,Мен бұл шынымен күшті деген қауесет естідім.
Dialogue: 0,0:20:42.10,0:20:44.07,Default,,0,0,0,,Мен ләззат алушымын, бірақ...
Dialogue: 0,0:20:49.61,0:20:51.61,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:20:51.61,0:20:54.62,Default,,0,0,0,,Қоштасатын уақыт та қалды.
Dialogue: 0,0:20:54.62,0:20:56.62,Default,,0,0,0,,Енді әрқайсыңыздан соңғы сөз➡
Dialogue: 0,0:20:56.62,0:20:58.62,Default,,0,0,0,,Мен оны алғым келеді.
Dialogue: 0,0:20:58.62,0:21:00.55,Default,,0,0,0,,Енді, Мано мырза, өтінемін! иә!
Dialogue: 0,0:21:00.55,0:21:03.56,Default,,0,0,0,,Карточка күресі! ! Авангард Дивинес 6-бөлімге дейін➡
Dialogue: 0,0:21:03.56,0:21:07.03,Default,,0,0,0,,Менің ойымша, мұны бәрі көрді...
Dialogue: 0,0:21:17.07,0:21:19.04,Default,,0,0,0,,Алдын ала рахмет.
Dialogue: 0,0:21:20.07,0:21:22.58,Default,,0,0,0,,6-серияға дейін трансляцияланды➡
Dialogue: 0,0:21:22.58,0:21:26.05,Default,,0,0,0,,7 және одан кейінгі эпизодтар басталады...
Dialogue: 0,0:21:29.58,0:21:31.55,Default,,0,0,0,,...Барған сайын түсінесің деп ойлаймын...
Dialogue: 0,0:21:40.59,0:21:45.57,Default,,0,0,0,,7-ші бөлімнен не болады...
Dialogue: 0,0:21:47.60,0:21:49.57,Default,,0,0,0,,Және…
Dialogue: 0,0:21:51.11,0:21:53.11,Default,,0,0,0,,Әр бөлімде солай болады...➡
Dialogue: 0,0:21:53.11,0:21:55.61,Default,,0,0,0,,Бірте-бірте түсінесің деп ойлаймын.
Dialogue: 0,0:21:55.61,0:21:58.58,Default,,0,0,0,,Менің ойымша, көретін нәрселер көп...
Dialogue: 0,0:22:01.55,0:22:03.55,Default,,0,0,0,,Қазір! Соңында ➡
Dialogue: 0,0:22:03.55,0:22:06.55,Default,,0,0,0,,Мен бұл арнайы бағдарламаны әдеттегідей орындағым келеді.
Dialogue: 0,0:22:06.55,0:22:08.52,Default,,0,0,0,,Тағдыр соғысы~!
Dialogue: 0,0:22:09.56,0:22:11.56,Default,,0,0,0,,Міне! ➡
Dialogue: 0,0:22:11.56,0:22:13.53,Default,,0,0,0,,Көп қысым!
Dialogue: 0,0:22:16.56,0:22:20.07,Default,,0,0,0,,Тағдыр соғысында не болатынын ешқашан білмейсіз.
Dialogue: 0,0:22:20.07,0:22:23.54,Default,,0,0,0,,Мен неден қорқамын? Бәлкім, анау-мынау...
Dialogue: 0,0:22:24.57,0:22:26.54,Default,,0,0,0,,Иә! Бұл үлкен жауапкершілік!
Dialogue: 0,0:22:30.08,0:22:33.05,Default,,0,0,0,,Сондықтан мен өзімді қалай сезінемін деп ойладым...
Dialogue: 0,0:22:38.09,0:22:40.59,Default,,0,0,0,,Келесі аптадағы анимеге дейін...➡
Dialogue: 0,0:22:40.59,0:22:42.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:22:45.59,0:22:47.60,Default,,0,0,0,,Келесі аптада кездескенше!
Dialogue: 0,0:22:47.60,0:22:49.56,Default,,0,0,0,,Жақында кездескенше.
Dialogue: 0,0:22:50.60,0:22:53.60,Default,,0,0,0,,Сондықтан бүгін қандай болатынын білмеймін➡
Dialogue: 0,0:22:53.60,0:22:56.07,Default,,0,0,0,,Бұл Нишио-санның бірінші рет қатысуы... иә.
Dialogue: 0,0:23:24.57,0:23:26.57,Default,,0,0,0,,Олай болса, барлығына➡
Dialogue: 0,0:23:26.57,0:23:28.54,Default,,0,0,0,,Мен оны ашуыңызды қалаймын.
Dialogue: 0,0:23:30.07,0:23:32.07,Default,,0,0,0,,Сіз сенімдісіз бе? Се~жоқ…➡
Dialogue: 0,0:23:32.07,0:23:34.04,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:23:37.58,0:23:39.58,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:23:39.58,0:23:41.58,Default,,0,0,0,,Сіз жеңдіңіз!
Dialogue: 0,0:23:41.58,0:23:43.58,Default,,0,0,0,,Ах! Сіз жеңдіңіз!
Dialogue: 0,0:23:43.58,0:23:45.59,Default,,0,0,0,,Сіз жеңдіңіз!
Dialogue: 0,0:23:45.59,0:23:48.06,Default,,0,0,0,,Жоқ, бірақ мен өз тілектерімді орындай аламын...
Dialogue: 0,0:23:50.09,0:23:52.09,Default,,0,0,0,,Кездескенше➡
Dialogue: 0,0:23:52.09,0:23:54.09,Default,,0,0,0,,Қорытынды пікірлеріңіз үшін рахмет➡
Dialogue: 0,0:23:56.10,0:23:58.60,Default,,0,0,0,,Енді, Мано мырза, өтінемін!
Dialogue: 0,0:23:58.60,0:24:01.54,Default,,0,0,0,,Ван! Карточка! ! Авангард Дивинес➡
Dialogue: 0,0:24:01.54,0:24:03.50,Default,,0,0,0,,Қазір эфирде! …
Dialogue: 0,0:24:04.54,0:24:06.51,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:24:08.54,0:24:10.54,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:24:10.54,0:24:12.51,Default,,0,0,0,,Баршаңыз, 7 және одан кейінгі эпизодты күтіңіздер!
Dialogue: 0,0:24:14.01,0:24:20.01,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory