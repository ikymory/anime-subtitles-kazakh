Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.20,0:00:03.20,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:00:05.20,0:00:07.20,Default,,0,0,0,,Ыстық ауаның жүзі Алдато!
Dialogue: 0,0:00:11.21,0:00:13.71,Default,,0,0,0,,Амбицияның қанаттары Соел!
Dialogue: 0,0:00:16.75,0:00:18.71,Default,,0,0,0,,О!
Dialogue: 0,0:00:31.23,0:00:33.23,Default,,0,0,0,,Ал, енді менің кезегімнен бастайық.
Dialogue: 0,0:02:06.22,0:02:09.22,Default,,0,0,0,,Кезек басталғанда алдымен бір картаны салыңыз.
Dialogue: 0,0:02:16.23,0:02:19.23,Default,,0,0,0,,Бірақ сіз бұрылыс сайын бірте-бірте күшке ие боласыз➡
Dialogue: 0,0:02:25.24,0:02:27.24,Default,,0,0,0,,Көріңіз➡
Dialogue: 0,0:02:27.24,0:02:29.75,Default,,0,0,0,,Қолыңыздан бір картаны тастау аймағына тастау арқылы➡
Dialogue: 0,0:02:29.75,0:02:33.68,Default,,0,0,0,,0-сынып алдартодан 1-ші палубаға дейін➡
Dialogue: 0,0:02:33.68,0:02:36.18,Default,,0,0,0,,Гүрілдеген жалын аңы Қарареолға мін.
Dialogue: 0,0:02:36.18,0:02:38.19,Default,,0,0,0,,О!
Dialogue: 0,0:02:38.19,0:02:40.69,Default,,0,0,0,,Біз авангардтар ғана күресе алмаймыз➡
Dialogue: 0,0:02:40.69,0:02:42.69,Default,,0,0,0,,Қолдағы бірліктерді шақыру➡
Dialogue: 0,0:02:42.69,0:02:45.69,Default,,0,0,0,,Басқаша айтқанда, одақтастарыңызды шақыру арқылы олар сізбен бірге соғысады.
Dialogue: 0,0:02:45.69,0:02:48.20,Default,,0,0,0,,Күден Мүсубиге➡ қоңырау шалыңыз
Dialogue: 0,0:02:51.20,0:02:54.70,Default,,0,0,0,,Оны тыл сақшысы деп атайды. Артқы қорғаушы...
Dialogue: 0,0:03:00.71,0:03:03.21,Default,,0,0,0,,E! Кенеттен бе? Не?
Dialogue: 0,0:03:03.21,0:03:06.21,Default,,0,0,0,,Себебі бірінші жүргенде бірінші бұрылыста шабуыл жасай алмайсыз➡
Dialogue: 0,0:03:06.21,0:03:09.22,Default,,0,0,0,,Енді менің кезегім аяқталды.
Dialogue: 0,0:03:09.22,0:03:11.22,Default,,0,0,0,,Өтінемін, мені қорқытпа.
Dialogue: 0,0:03:11.22,0:03:14.72,Default,,0,0,0,,Келесі кезек Акиде! Дәл солай істеп көріңіз.
Dialogue: 0,0:03:14.72,0:03:16.73,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:03:16.73,0:03:18.73,Default,,0,0,0,,Алдымен сурет салыңыз➡
Dialogue: 0,0:03:18.73,0:03:21.23,Default,,0,0,0,,Қолыңыздан бір картаны тастаңыз➡
Dialogue: 0,0:03:21.23,0:03:23.23,Default,,0,0,0,,Қамқор шалға мініңіз!
Dialogue: 0,0:03:25.23,0:03:27.74,Default,,0,0,0,,Медициналық періштеге қоңырау шалыңыз!
Dialogue: 0,0:03:27.74,0:03:29.74,Default,,0,0,0,,Мм...! Жақсы сезінеді.
Dialogue: 0,0:03:34.68,0:03:36.68,Default,,0,0,0,,Демалу? иә!
Dialogue: 0,0:03:36.68,0:03:38.68,Default,,0,0,0,,Сіз оны артқы күзетшіге шабуыл жасау арқылы жеңе аласыз➡
Dialogue: 0,0:03:46.19,0:03:49.19,Default,,0,0,0,,Жарайды...! Олай болса, дискіні тексерейік.
Dialogue: 0,0:03:49.19,0:03:51.19,Default,,0,0,0,,Дискіні тексеру?
Dialogue: 0,0:03:53.70,0:03:56.20,Default,,0,0,0,,Палубада ұйықтап жатқан достарыңыздың күші➡
Dialogue: 0,0:03:56.20,0:03:58.20,Default,,0,0,0,,Триггерді ояту мүмкіндігі бар.
Dialogue: 0,0:03:58.20,0:04:00.20,Default,,0,0,0,,Палубаның жоғарғы бөлігін аударыңыз.
Dialogue: 0,0:04:00.20,0:04:03.21,Default,,0,0,0,,Сәлем...дискіні тексеру!
Dialogue: 0,0:04:03.21,0:04:05.71,Default,,0,0,0,,Өте өкінішті, бұл триггер емес.
Dialogue: 0,0:04:11.21,0:04:13.72,Default,,0,0,0,,Егер шабуылдаушы бөлімшенің күші қарсыластың күшіне тең немесе одан жоғары болса➡
Dialogue: 0,0:04:13.72,0:04:15.72,Default,,0,0,0,,Шабуыл – соққы➡
Dialogue: 0,0:04:18.72,0:04:20.72,Default,,0,0,0,,Менің Қарареолымның да күші бар...
Dialogue: 0,0:04:20.72,0:04:22.72,Default,,0,0,0,,...Аки жеңді! Соқ!
Dialogue: 0,0:04:22.72,0:04:24.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:24.73,0:04:26.73,Default,,0,0,0,,Менің зақымдануымды тексеру➡
Dialogue: 0,0:04:26.73,0:04:29.23,Default,,0,0,0,,Зақымға палубаның жоғарғы жағынан бір картаны қойыңыз.
Dialogue: 0,0:04:29.23,0:04:31.17,Default,,0,0,0,,Бұл 1 бүліну нүктесі.
Dialogue: 0,0:04:31.17,0:04:33.17,Default,,0,0,0,,Ум!
Dialogue: 0,0:04:33.17,0:04:35.17,Default,,0,0,0,,Триггер осы жерде аударылса да➡
Dialogue: 0,0:04:35.17,0:04:37.14,Default,,0,0,0,,Бұл маған күш береді.
Dialogue: 0,0:04:38.17,0:04:41.18,Default,,0,0,0,,Бірінші рет осылай 6 зиян келтірген адам жеңеді.
Dialogue: 0,0:04:41.18,0:04:43.18,Default,,0,0,0,,Олай болса, мен міндетті түрде барамын!
Dialogue: 0,0:04:45.18,0:04:47.18,Default,,0,0,0,,Фуфуфуфу~!
Dialogue: 0,0:04:47.18,0:04:50.19,Default,,0,0,0,,Егер шабуылға ұшыраған адам жай қарап тұрса➡
Dialogue: 0,0:04:50.19,0:04:52.19,Default,,0,0,0,,Мен олай ойламаймын. жұмысшы?
Dialogue: 0,0:04:52.19,0:04:54.19,Default,,0,0,0,,Қолыңыздағы құрылғы сізді қорғайтын болса➡
Dialogue: 0,0:04:54.19,0:04:56.69,Default,,0,0,0,,Ол сондай-ақ шабуылдардың алдын алады.
Dialogue: 0,0:04:59.69,0:05:01.70,Default,,0,0,0,,Бірдеңе болды.
Dialogue: 0,0:05:01.70,0:05:04.70,Default,,0,0,0,,Қуат сіз жіберген құрылғының экрандық мәніне қарай артады.
Dialogue: 0,0:05:04.70,0:05:06.67,Default,,0,0,0,,Бұл жалпы...
Dialogue: 0,0:05:07.70,0:05:09.70,Default,,0,0,0,,Ge! Бұл күш...
Dialogue: 0,0:05:09.70,0:05:11.71,Default,,0,0,0,,Күзет сәтті өтті!
Dialogue: 0,0:05:11.71,0:05:14.21,Default,,0,0,0,,Ku~! Мен олардың барлығына шабуыл жасауды аяқтадым➡
Dialogue: 0,0:05:14.21,0:05:16.21,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:05:16.21,0:05:18.21,Default,,0,0,0,,Ал... менің кезегім.
Dialogue: 0,0:05:18.21,0:05:21.22,Default,,0,0,0,,2-сынып Горайджу Китенриседе серуендеу➡
Dialogue: 0,0:05:21.22,0:05:23.22,Default,,0,0,0,,Енді міне, мәселе➡
Dialogue: 0,0:05:23.22,0:05:25.72,Default,,0,0,0,,Алдыңғы қатарда шабуылдаушы бөлімшелер орналасады➡
Dialogue: 0,0:05:28.22,0:05:30.19,Default,,0,0,0,,Кенеттен викторина пішімі шықты ма?
Dialogue: 0,0:05:30.19,0:05:33.66,Default,,0,0,0,,Жарайды, артыңыздан шабуыл жасай алмасаңыз➡
Dialogue: 0,0:05:52.18,0:05:54.18,Default,,0,0,0,,Ал бос алдыңғы қатарда➡
Dialogue: 0,0:05:54.18,0:05:56.18,Default,,0,0,0,,Spinoasaulter➡ қоңырау шалыңыз
Dialogue: 0,0:05:56.18,0:05:58.65,Default,,0,0,0,,Котенка көтерілуімен авангардқа шабуыл жасаңыз.
Dialogue: 0,0:06:15.20,0:06:17.21,Default,,0,0,0,,E~?
Dialogue: 0,0:06:17.21,0:06:20.71,Default,,0,0,0,,Бұл маңызды триггер сүйікті құрылғыңыздың қуатына плюс 10 000➡ береді
Dialogue: 0,0:06:20.71,0:06:23.71,Default,,0,0,0,,Критикалық плюс 1 үлестірілуі мүмкін.
Dialogue: 0,0:06:23.71,0:06:26.68,Default,,0,0,0,,Сіздің сыни соққыңыз артқан сайын, сіз келтіретін зиян да артады.
Dialogue: 0,0:06:31.15,0:06:33.15,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:33.15,0:06:35.66,Default,,0,0,0,,Күзетшіге еніп, 2 зиян келтіреді!
Dialogue: 0,0:06:35.66,0:06:38.13,Default,,0,0,0,,Шынымен! Зақымдануды тексеру.
Dialogue: 0,0:06:42.66,0:06:46.17,Default,,0,0,0,,О... бұл маңызды триггер!
Dialogue: 0,0:06:48.67,0:06:51.14,Default,,0,0,0,,Қамқор шалфейдің күшіне 10 000 қосыңыз!
Dialogue: 0,0:06:57.18,0:06:59.18,Default,,0,0,0,,Бұл жолы сақ болыңыз!
Dialogue: 0,0:06:59.18,0:07:01.68,Default,,0,0,0,,Бұрылыстың соңы Hmph….
Dialogue: 0,0:07:01.68,0:07:04.19,Default,,0,0,0,,жұтылу оңай. Эххе….
Dialogue: 0,0:07:04.19,0:07:06.19,Default,,0,0,0,,Барған сайын қызық болып барады.
Dialogue: 0,0:07:06.19,0:07:08.19,Default,,0,0,0,,О! Мен мұны істеуім керек.
Dialogue: 0,0:07:10.69,0:07:13.70,Default,,0,0,0,,Қалған картаны айналымның басына қойыңыз.
Dialogue: 0,0:07:13.70,0:07:17.20,Default,,0,0,0,,көремін. Осылайша сіз қайтадан шабуыл жасай аласыз.
Dialogue: 0,0:07:17.20,0:07:19.20,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:07:24.21,0:07:26.71,Default,,0,0,0,,Silent Knight Swizz Helm-ге мініңіз!
Dialogue: 0,0:07:26.71,0:07:28.71,Default,,0,0,0,,Біз осында шабуыл жасаймыз!
Dialogue: 0,0:07:28.71,0:07:30.65,Default,,0,0,0,,2 толеранттылық картасына және Лисаннаға қоңырау шалыңыз!
Dialogue: 0,0:07:33.65,0:07:35.65,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:07:35.65,0:07:37.65,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:07:37.65,0:07:40.66,Default,,0,0,0,,Иә! Триггер шықты. Бұл ұтыс триггері.
Dialogue: 0,0:07:48.66,0:07:50.67,Default,,0,0,0,,Төзімділікпен шабуыл!
Dialogue: 0,0:07:50.67,0:07:52.63,Default,,0,0,0,,Мұнда күзетші жоқ.
Dialogue: 0,0:07:53.67,0:07:55.67,Default,,0,0,0,,Шабуыл! Бұл күзетші.
Dialogue: 0,0:07:55.67,0:07:57.67,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:07:57.67,0:07:59.67,Default,,0,0,0,,Ал... менің кезегім.
Dialogue: 0,0:07:59.67,0:08:01.68,Default,,0,0,0,,Міне, палубаның соңғысы➡
Dialogue: 0,0:08:01.68,0:08:03.68,Default,,0,0,0,,Басқаша айтқанда, басты кейіпкер пайда болады!
Dialogue: 0,0:08:03.68,0:08:07.18,Default,,0,0,0,,3-сынып найзағай айдаһар Триумф айдаһар➡
Dialogue: 0,0:08:07.18,0:08:09.18,Default,,0,0,0,,Жүр!
Dialogue: 0,0:08:09.18,0:08:11.19,Default,,0,0,0,,Spinoasaulter-ге қоңырау шалыңыз!
Dialogue: 0,0:08:11.19,0:08:14.69,Default,,0,0,0,,Триумф айдаһарымен авангардқа шабуыл жасаңыз!
Dialogue: 0,0:08:14.69,0:08:18.19,Default,,0,0,0,,3-сынып бірліктерінің ерекше өкілеттіктері бар➡
Dialogue: 0,0:08:18.19,0:08:21.20,Default,,0,0,0,,Демек, триггерді тарту күші екі есе артады!
Dialogue: 0,0:08:21.20,0:08:23.20,Default,,0,0,0,,Қос жетек!
Dialogue: 0,0:08:23.20,0:08:26.20,Default,,0,0,0,,Көлікті екі рет тексеру керек пе? Жоқ... күзетші жоқ!
Dialogue: 0,0:08:28.70,0:08:31.71,Default,,0,0,0,,Триггер жоқ…Екінші тексеру➡
Dialogue: 0,0:08:33.71,0:08:36.71,Default,,0,0,0,,1 зақымдарды және Spinoasaulter қуатын +10000 қалпына келтіріңіз.
Dialogue: 0,0:08:36.71,0:08:38.68,Default,,0,0,0,,Қалпына келтіру триггері?
Dialogue: 0,0:08:44.72,0:08:46.69,Default,,0,0,0,,Шабуыл. Күзетші жоқ.
Dialogue: 0,0:08:48.22,0:08:50.23,Default,,0,0,0,,Шабуыл! күзетші!
Dialogue: 0,0:08:58.23,0:09:01.24,Default,,0,0,0,,Мен... бәрінен де артық көремін.
Dialogue: 0,0:09:01.24,0:09:03.24,Default,,0,0,0,,Мен аздап түсіне бастадым➡
Dialogue: 0,0:09:03.24,0:09:07.24,Default,,0,0,0,,Карточка жекпе-жегінде қарсыласыңыздың және өзіңіздің күшіңізді бағалау маңызды.
Dialogue: 0,0:09:07.24,0:09:10.75,Default,,0,0,0,,Дұрыс! Оны білсеңіз және өзіңізді білсеңіз➡
Dialogue: 0,0:09:10.75,0:09:13.75,Default,,0,0,0,,Ешқандай қауіпсіз 100 шайқас... Сунь Цзы.
Dialogue: 0,0:09:18.25,0:09:20.76,Default,,0,0,0,,Әй, не...?
Dialogue: 0,0:09:20.76,0:09:23.76,Default,,0,0,0,,Бастапқыда айтқаным – Vanguard Fight➡ ойынының нағыз ләззаты
Dialogue: 0,0:09:25.76,0:09:28.76,Default,,0,0,0,,Әй, сен әбден асығып тұрсың.
Dialogue: 0,0:09:28.76,0:09:31.73,Default,,0,0,0,,｟Тағдыр соғысы қашан басталатынын білмейміз. ｠
Dialogue: 0,0:09:43.21,0:09:45.21,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:09:45.21,0:09:47.22,Default,,0,0,0,,Сиыр! Кәне, мынаны қолданайық.
Dialogue: 0,0:09:52.22,0:09:54.22,Default,,0,0,0,,Негізі бірінші бұрылысқа қойыңыз➡
Dialogue: 0,0:09:54.22,0:09:56.22,Default,,0,0,0,,Ол әрбір айналымда жинақталады.
Dialogue: 0,0:09:56.22,0:09:58.19,Default,,0,0,0,,Енді оны қояйық.
Dialogue: 0,0:10:05.23,0:10:08.24,Default,,0,0,0,,Бұл қарастыру бар дегенді білдіреді. Бұл солай.
Dialogue: 0,0:10:08.24,0:10:11.24,Default,,0,0,0,,Әртүрлі шығындар бар, бірақ олардың бірі ➡
Dialogue: 0,0:10:11.24,0:10:14.24,Default,,0,0,0,,Жиналған энергияны пайдаланатын энергия жарылысы.
Dialogue: 0,0:10:14.24,0:10:16.24,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:16.24,0:10:18.75,Default,,0,0,0,,Міне, бұдан былай сізге дағдылар қажет болады.
Dialogue: 0,0:10:18.75,0:10:20.75,Default,,0,0,0,,Нао-сенпай, мұны да шындап істеңіз!
Dialogue: 0,0:10:32.69,0:10:35.70,Default,,0,0,0,,Тұрыңыз және сурет салыңыз! Энергия заряды➡
Dialogue: 0,0:10:35.70,0:10:37.70,Default,,0,0,0,,Бұл да 3-сынып➡
Dialogue: 0,0:10:37.70,0:10:39.70,Default,,0,0,0,,Қанатты періште Заревсаэльге➡
Dialogue: 0,0:10:39.70,0:10:43.20,Default,,0,0,0,,Жүр! мінеки біз…! Заревсаэльдің шеберлігі➡
Dialogue: 0,0:10:48.21,0:10:51.71,Default,,0,0,0,,Егер сізде шеберлік болса, жекпе-жек қызып, шиеленісе түседі!
Dialogue: 0,0:10:51.71,0:10:53.72,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:10:53.72,0:10:57.22,Default,,0,0,0,,Үлкен бомбалаушыға қоңырау шалыңыз! Және көтеріңіз ➡
Dialogue: 0,0:10:57.22,0:11:00.22,Default,,0,0,0,,Заревсаэльмен бірге авангардқа шабуыл жасаңыз!
Dialogue: 0,0:11:02.22,0:11:06.23,Default,,0,0,0,,Энергетикалық жарылыс 4 карта және құлаудан қайта тірілу айдаһарына қоңырау шалыңыз!
Dialogue: 0,0:11:08.23,0:11:11.23,Default,,0,0,0,,Бастапқы төзімділік тамшымен ауыстырылады!
Dialogue: 0,0:11:37.19,0:11:39.69,Default,,0,0,0,,Ғажайып...бұл менің ойымда бар➡
Dialogue: 0,0:11:39.69,0:11:42.20,Default,,0,0,0,,Біз кенеттен қосылған сәт➡
Dialogue: 0,0:11:42.20,0:11:45.70,Default,,0,0,0,,Толқып тұрғаным сонша, бүкіл денем қайнап жатыр!
Dialogue: 0,0:11:45.70,0:11:47.70,Default,,0,0,0,,Сәтсіздік пен сәттіліктің мәңгілік қозғалыс машинасы➡
Dialogue: 0,0:11:47.70,0:11:50.17,Default,,0,0,0,,Сондықтан мен карта ойынын тоқтата алмаймын!
Dialogue: 0,0:11:51.71,0:11:54.71,Default,,0,0,0,,Кешіріңіз...Мен айттым.
Dialogue: 0,0:11:54.71,0:11:56.71,Default,,0,0,0,,Бұл... жақсы!
Dialogue: 0,0:11:56.71,0:11:58.71,Default,,0,0,0,,Нао-сенпайдың Авангард махаббаты➡
Dialogue: 0,0:11:58.71,0:12:00.68,Default,,0,0,0,,Мен де соны сезгім келеді!
Dialogue: 0,0:12:02.22,0:12:04.22,Default,,0,0,0,,О! Маған жазыл.
Dialogue: 0,0:12:04.22,0:12:06.72,Default,,0,0,0,,А...Онда мені күзетпейді.
Dialogue: 0,0:12:06.72,0:12:09.22,Default,,0,0,0,,Сәлем, Twin Drive келе жатыр!
Dialogue: 0,0:12:09.22,0:12:11.23,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:12:18.23,0:12:20.24,Default,,0,0,0,,Заревсаэлге критикалық +1➡
Dialogue: 0,0:12:20.24,0:12:22.20,Default,,0,0,0,,Қуат плюс 10000 Қайта тірілушілерге жіберіледі.
Dialogue: 0,0:12:23.74,0:12:26.21,Default,,0,0,0,,Төзімділікпен шабуыл! Күзетші жоқ.
Dialogue: 0,0:12:27.24,0:12:29.24,Default,,0,0,0,,Тағы бір нүкте! Resurgents-те➡
Dialogue: 0,0:12:29.24,0:12:31.18,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:12:31.18,0:12:34.68,Default,,0,0,0,,Сіз қалай ойлайсыз? Қуаты 48 000!
Dialogue: 0,0:12:41.69,0:12:44.69,Default,,0,0,0,,Толық күзет! Толық күзетші?
Dialogue: 0,0:12:48.20,0:12:50.70,Default,,0,0,0,,Шабуылдарды өтпейтін дағдыға ие.
Dialogue: 0,0:12:50.70,0:12:52.70,Default,,0,0,0,,Ой... бұл өтірік!
Dialogue: 0,0:12:52.70,0:12:55.20,Default,,0,0,0,,Ахаха! Уайымдама...
Dialogue: 0,0:13:05.21,0:13:08.22,Default,,0,0,0,,Триумф Айдаһар шеберлігінің қуаты +10000.
Dialogue: 0,0:13:08.22,0:13:10.22,Default,,0,0,0,,Аки-кун... елестетіп көріңізші.
Dialogue: 0,0:13:10.22,0:13:12.22,Default,,0,0,0,,E?
Dialogue: 0,0:13:12.22,0:13:14.72,Default,,0,0,0,,Мініп жүргенің – киелі садақ ұстау➡
Dialogue: 0,0:13:14.72,0:13:16.72,Default,,0,0,0,,Архангел Заревсаэль.
Dialogue: 0,0:13:16.72,0:13:18.73,Default,,0,0,0,,Ал екіншісі менің мінгенім➡
Dialogue: 0,0:13:18.73,0:13:21.73,Default,,0,0,0,,Триумф Айдаһар, найзағай жарқылдаған супер айдаһар.
Dialogue: 0,0:13:21.73,0:13:24.23,Default,,0,0,0,,Ұрыс - бұл оқиға➡
Dialogue: 0,0:13:26.23,0:13:28.74,Default,,0,0,0,,Достарыңызбен кездесіп, бірге күресіңіз➡
Dialogue: 0,0:13:28.74,0:13:30.67,Default,,0,0,0,,Өтінемін, мені анда-санда қорғаңыз.
Dialogue: 0,0:13:32.67,0:13:35.68,Default,,0,0,0,,Әңгіменің кейіпкері бол.
Dialogue: 0,0:13:35.68,0:13:40.18,Default,,0,0,0,,Мен Vanguard Fight ойынын жақсы көремін, онда мен бұл тәжірибені қайта-қайта сезіне аламын!
Dialogue: 0,0:13:40.18,0:13:43.18,Default,,0,0,0,,Енді... жарысатын кез келді!
Dialogue: 0,0:13:43.18,0:13:46.19,Default,,0,0,0,,Заревсаэльге Триумф Айдаһарымен шабуыл жасаңыз.
Dialogue: 0,0:13:53.19,0:13:56.70,Default,,0,0,0,,Сын плюс 1. жұмысшы! Сыни ма?
Dialogue: 0,0:13:59.70,0:14:01.70,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:14:03.71,0:14:05.71,Default,,0,0,0,,Мұны қабылдасаңыз, ұтыласыз. ｠
Dialogue: 0,0:14:15.72,0:14:18.72,Default,,0,0,0,,Жақсы шешім, бірінші тексеру...
Dialogue: 0,0:14:18.72,0:14:22.22,Default,,0,0,0,,Триггер жоқ…Екінші тексеру➡
Dialogue: 0,0:14:25.23,0:14:27.73,Default,,0,0,0,,Жақсы! Мен бәсті ұтып алдым.
Dialogue: 0,0:14:31.67,0:14:34.17,Default,,0,0,0,,А…. Spino Assaulter көмегімен шабуыл.
Dialogue: 0,0:14:34.17,0:14:36.14,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:14:45.68,0:14:47.68,Default,,0,0,0,,Бас тартуға әлі ерте.
Dialogue: 0,0:14:47.68,0:14:50.18,Default,,0,0,0,,Бірақ бұл 6-шы нүкте, солай емес пе?
Dialogue: 0,0:14:53.19,0:14:55.19,Default,,0,0,0,,1 ұпай Сіз қалпына келтіре аласыз және өмір сүре аласыз.
Dialogue: 0,0:14:55.19,0:14:57.69,Default,,0,0,0,,Ах! Бірде Нао-сенпай тартып жатқан еді...
Dialogue: 0,0:14:57.69,0:15:00.19,Default,,0,0,0,,Иә! Соңына дейін➡
Dialogue: 0,0:15:00.19,0:15:02.70,Default,,0,0,0,,Ғажайыптарға сенуді тоқтатпа!
Dialogue: 0,0:15:02.70,0:15:04.70,Default,,0,0,0,,Ғажайып….
Dialogue: 0,0:15:08.70,0:15:10.71,Default,,0,0,0,,Критикалық триггер….
Dialogue: 0,0:15:19.21,0:15:22.72,Default,,0,0,0,,Бірақ қызық болды! Бұл шынымен көңілді болды!
Dialogue: 0,0:15:22.72,0:15:26.22,Default,,0,0,0,,Шынымен бе? жоғары! көп рахмет.
Dialogue: 0,0:15:26.22,0:15:29.22,Default,,0,0,0,,Жарайды! Сондықтан мұны жүйелі түрде жалғастырайық.
Dialogue: 0,0:15:29.22,0:15:31.19,Default,,0,0,0,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:15:34.70,0:15:36.70,Default,,0,0,0,,Аки-кунның дәмі жақсы➡
Dialogue: 0,0:15:36.70,0:15:39.70,Default,,0,0,0,,Менің ойымша, сен жақында күшейесің. Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:15:39.70,0:15:42.70,Default,,0,0,0,,Нао-сенпайға келесі турнирде сәттілік тілейміз.
Dialogue: 0,0:15:42.70,0:15:45.21,Default,,0,0,0,,Бұл кәсіби маман болу үшін маңызды турнир, солай емес пе?
Dialogue: 0,0:15:45.21,0:15:48.21,Default,,0,0,0,,О, дұрыс, маңызды!
Dialogue: 0,0:15:48.21,0:15:51.21,Default,,0,0,0,,Мен сені қолдаймын! рақмет сізге!
Dialogue: 0,0:15:51.21,0:15:53.68,Default,,0,0,0,,Олай болса, толық емес жұмыс күніңде кездескенше. жоғары!
Dialogue: 0,0:15:56.72,0:16:01.16,Default,,0,0,0,,Иә...Келесі турнирде міндетті түрде нәтиже көрсетемін➡
Dialogue: 0,0:16:01.16,0:16:05.16,Default,,0,0,0,,Бұл жыл менің соңғы мүмкіндігім екенін білемін➡
Dialogue: 0,0:16:05.16,0:16:09.16,Default,,0,0,0,,Сәлем...келесі турнирде нәтиже шықпаса➡
Dialogue: 0,0:16:09.16,0:16:11.67,Default,,0,0,0,,Кәсіби мамандарға...
Dialogue: 0,0:16:11.67,0:16:13.63,Default,,0,0,0,,Сәлем... Олай болса.
Dialogue: 0,0:16:16.67,0:16:18.64,Default,,0,0,0,,Хаа….
Dialogue: 0,0:16:20.68,0:16:22.64,Default,,0,0,0,,Соңғысы... иә?
Dialogue: 0,0:16:27.68,0:16:30.18,Default,,0,0,0,,Күшті болыңыз.
Dialogue: 0,0:16:30.18,0:16:32.69,Default,,0,0,0,,｟Сонымен соңына дейін➡
Dialogue: 0,0:16:32.69,0:16:34.66,Default,,0,0,0,,Ғажайыптарға сенуді тоқтатпа! ｠
Dialogue: 0,0:16:36.19,0:16:39.16,Default,,0,0,0,,Мен мұны істеймін! …Un?
Dialogue: 0,0:16:40.19,0:16:42.16,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:16:44.70,0:16:46.67,Default,,0,0,0,,Қауырсын?
Dialogue: 0,0:17:04.72,0:17:07.22,Default,,0,0,0,,Ым?
Dialogue: 0,0:17:07.22,0:17:09.72,Default,,0,0,0,,Әке? Бүгін үйдесің бе?
Dialogue: 0,0:17:09.72,0:17:11.69,Default,,0,0,0,,Неліктен электр...?
Dialogue: 0,0:17:13.73,0:17:16.23,Default,,0,0,0,,Акина Мейдо ақыры оралды.
Dialogue: 0,0:17:32.75,0:17:37.25,Default,,0,0,0,,Тағдыр соғысында қатысушылардың арасынан таңдалған екі адам бір-бірімен жарысады➡
Dialogue: 0,0:17:39.75,0:17:42.76,Default,,0,0,0,,Келесі жекпе-жекке қалғандардың арасынан екі адам таңдалады➡
Dialogue: 0,0:17:42.76,0:17:44.76,Default,,0,0,0,,Оларды қайтадан ұрыстырып көріңіз.
Dialogue: 0,0:17:44.76,0:17:47.26,Default,,0,0,0,,Осыны соңғы адамға дейін қайталаңыз.
Dialogue: 0,0:17:50.26,0:17:52.27,Default,,0,0,0,,Кім кіммен күреседі?➡
Dialogue: 0,0:17:52.27,0:17:55.27,Default,,0,0,0,,Барлығы тағдырдың нұсқауымен жүреді.
Dialogue: 0,0:17:55.27,0:17:57.27,Default,,0,0,0,,Жоқ... сәл күте тұрыңыз.
Dialogue: 0,0:17:57.27,0:17:59.27,Default,,0,0,0,,Демек, бұл мүлдем кездейсоқ?
Dialogue: 0,0:17:59.27,0:18:01.71,Default,,0,0,0,,Бір адам қатарынан бес рет төбелесу мүмкіндігі бар➡
Dialogue: 0,0:18:06.21,0:18:08.22,Default,,0,0,0,,Тағдыр қатал➡
Dialogue: 0,0:18:08.22,0:18:11.72,Default,,0,0,0,,Сондықтан оны өзіңіз қолға алудан басқа амалыңыз жоқ.
Dialogue: 0,0:18:11.72,0:18:14.69,Default,,0,0,0,,Сол тағдырды да өзгертуге тырысайық.
Dialogue: 0,0:18:15.72,0:18:18.23,Default,,0,0,0,,Ұрыс қай жерде және қашан басталады?
Dialogue: 0,0:18:51.76,0:18:53.76,Default,,0,0,0,,Хмм…. Оған қалай қарсы тұру керек➡
Dialogue: 0,0:18:53.76,0:18:55.73,Default,,0,0,0,,Балалар сендерге байланысты.
Dialogue: 0,0:18:58.77,0:19:01.70,Default,,0,0,0,,Мен сізге тағы бір маңызды сұрақ қойғым келеді.
Dialogue: 0,0:19:01.70,0:19:05.17,Default,,0,0,0,,Сіздің шынымен өзгерткіңіз келетін тағдырыңыз бар ма?
Dialogue: 0,0:19:07.21,0:19:10.21,Default,,0,0,0,,Аз ғана жарық қолын созғандарға ғана➡
Dialogue: 0,0:19:12.21,0:19:14.72,Default,,0,0,0,,Мм? Мен үшін➡
Dialogue: 0,0:19:14.72,0:19:17.22,Default,,0,0,0,,Мен түбегейлі өзгерткім келетін белгілі бір тағдыр бар.
Dialogue: 0,0:19:17.22,0:19:20.19,Default,,0,0,0,,Тағдыр соғысына қосылыңыз!
Dialogue: 0,0:19:25.23,0:19:27.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:33.73,0:19:35.74,Default,,0,0,0,,Енді барлығы осында!
Dialogue: 0,0:19:35.74,0:19:38.21,Default,,0,0,0,,Тағдыр соғысы басталды!
Dialogue: 0,0:19:39.74,0:19:42.24,Default,,0,0,0,,Тағдыр соғысында келесі жолы кездескенше.
Dialogue: 0,0:19:42.24,0:19:44.25,Default,,0,0,0,,А... Соңғы бір нәрсе.
Dialogue: 0,0:19:44.25,0:19:46.25,Default,,0,0,0,,Не?
Dialogue: 0,0:19:46.25,0:19:48.25,Default,,0,0,0,,Бананды қалай жеу керектігін айтайын ба?
Dialogue: 0,0:19:48.25,0:19:50.22,Default,,0,0,0,,Ха?
Dialogue: 0,0:19:52.75,0:19:54.76,Default,,0,0,0,,Хмм….
Dialogue: 0,0:19:54.76,0:19:57.26,Default,,0,0,0,,Маған палубалар туралы ойлау қиын...
Dialogue: 0,0:19:57.26,0:19:59.26,Default,,0,0,0,,Мм...авангардты ойнадың ба?
Dialogue: 0,0:19:59.26,0:20:01.20,Default,,0,0,0,,Енді бастайық.
Dialogue: 0,0:20:06.70,0:20:09.20,Default,,0,0,0,,Мен Нииниді жақсы көремін~! Да~! Қазірдің өзінде... шулы!
Dialogue: 0,0:20:09.20,0:20:11.21,Default,,0,0,0,,Назар аударыңыз!
Dialogue: 0,0:20:11.21,0:20:13.71,Default,,0,0,0,,Жақсы! Оны көру өте сүйкімді.
Dialogue: 0,0:20:13.71,0:20:16.68,Default,,0,0,0,,Ниини…. Сондықтан!
Dialogue: 0,0:20:47.24,0:20:49.74,Default,,0,0,0,,Мен сізге айтамын, мен өте күштімін!
Dialogue: 0,0:20:49.74,0:20:53.25,Default,,0,0,0,,Мен тіпті Deluxe көмегімен жақсы нәтижелерге қол жеткізе алатыныма сенімдімін.
Dialogue: 0,0:20:53.25,0:20:55.25,Default,,0,0,0,,«Әскери полиция корпусы билікке деген құмарлығынан
Dialogue: 0,0:20:55.25,0:20:57.72,Default,,0,0,0,,Әй...көп қызықпа!
Dialogue: 0,0:21:00.69,0:21:03.16,Default,,0,0,0,,｟Мен өз тілегімді міндетті түрде орындаймын. ｠
Dialogue: 0,0:21:08.20,0:21:11.20,Default,,0,0,0,,Сол Мегуми-сан! Сәлем, бұл не?
Dialogue: 0,0:21:11.20,0:21:13.67,Default,,0,0,0,,Маған қажет карта бар.
Dialogue: 0,0:21:18.21,0:21:20.17,Default,,0,0,0,,Жақсы! Мен палуба саламын.
Dialogue: 0,0:21:28.72,0:21:31.19,Default,,0,0,0,,Ақырында... ол басталады.
Dialogue: 0,0:21:36.22,0:21:38.23,Default,,0,0,0,,（📱）
Dialogue: 0,0:21:38.23,0:21:40.19,Default,,0,0,0,,Ым?
Dialogue: 0,0:21:41.23,0:21:43.23,Default,,0,0,0,,U….
