Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:54.05,0:00:59.05,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:34.80,0:01:36.26,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:02:34.36,0:02:35.28,Default,,0,0,0,,Гухаа
Dialogue: 0,0:02:43.74,0:02:44.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:56.00,0:02:56.84,Default,,0,0,0,,Ах
Dialogue: 0,0:03:46.85,0:03:48.43,Default,,0,0,0,,Шамамен Эдо кезеңінің соңында
Dialogue: 0,0:03:48.72,0:03:53.23,Default,,0,0,0,,Қорқынышты және Хитокири Баттоусай деп аталатын бір адам болды.
Dialogue: 0,0:03:54.23,0:04:00.24,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:05:58.85,0:06:04.86,Default,,0,0,0,,~♪
Dialogue: 0,0:06:06.40,0:06:08.65,Default,,0,0,0,,Батыс үлгісіндегі ғимаратта газ шамы бар ма?
Dialogue: 0,0:06:08.78,0:06:10.28,Default,,0,0,0,,Жолдасың (Кеншин) Оро
Dialogue: 0,0:06:10.36,0:06:12.62,Default,,0,0,0,,Уау, кешіріңіз.
Dialogue: 0,0:06:12.87,0:06:14.29,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:06:14.37,0:06:17.37,Default,,0,0,0,,Келесі жолы жүргенде алға қара, Самурай бала.
Dialogue: 0,0:06:19.08,0:06:20.21,Default,,0,0,0,,Ұл деген не?
Dialogue: 0,0:06:20.29,0:06:23.38,Default,,0,0,0,,Кеншин! Осы жолмен
Dialogue: 0,0:06:23.88,0:06:24.92,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:06:25.00,0:06:27.30,Default,,0,0,0,,Қаңғып жүрсең, адасып кетесің.
Dialogue: 0,0:06:28.26,0:06:30.09,Default,,0,0,0,,Жарайды, ашуланба, Яхико.
Dialogue: 0,0:06:30.18,0:06:32.55,Default,,0,0,0,,Кеншин құрлықтағы буға мініп, алып кетті.
Dialogue: 0,0:06:32.89,0:06:33.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:37.06,0:06:40.85,Default,,0,0,0,,
Dialogue: 0,0:06:41.15,0:06:44.02,Default,,0,0,0,,Ху (Каору) Бұл керемет.
Dialogue: 0,0:06:44.11,0:06:46.36,Default,,0,0,0,,Мұндай ғимаратты көру
Dialogue: 0,0:06:46.48,0:06:49.82,Default,,0,0,0,,Неге Йокогамаға дейін келмейсің?
Dialogue: 0,0:06:50.15,0:06:51.95,Default,,0,0,0,,Сонымен қатар, құрлық буында
Dialogue: 0,0:06:52.07,0:06:54.49,Default,,0,0,0,,Сіз ең толқып тұрсаңыз да
Dialogue: 0,0:06:54.62,0:06:58.00,Default,,0,0,0,,Олай десеңіз, мен төлеген жер пар ақшасын қайтарыңыз.
Dialogue: 0,0:06:58.08,0:06:58.91,Default,,0,0,0,,Хотпот дәмді болды ма?
Dialogue: 0,0:06:59.33,0:07:02.21,Default,,0,0,0,,Жоқ... жарайды, бұл туралы.
Dialogue: 0,0:07:02.33,0:07:05.55,Default,,0,0,0,,Қазіргі кездегі барлық ғимараттар осындай.
Dialogue: 0,0:07:06.30,0:07:08.46,Default,,0,0,0,,Аа, солай деп ойлаймын.
Dialogue: 0,0:07:10.63,0:07:12.59,Default,,0,0,0,,Жапония да өзгеруде
Dialogue: 0,0:07:13.93,0:07:15.18,Default,,0,0,0,,Бұл жақсы нәрсе.
Dialogue: 0,0:07:18.93,0:07:20.60,Default,,0,0,0,,(Нәрсені қатты жерге ұрған дыбыс)
Dialogue: 0,0:07:21.60,0:07:26.19,Default,,0,0,0,,Хахахаха! Сіз қалай ойлайсыз? менің күшім
Dialogue: 0,0:07:26.27,0:07:28.69,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мұның бәрі билікке байланысты.
Dialogue: 0,0:07:28.82,0:07:29.65,Default,,0,0,0,,Не?
Dialogue: 0,0:07:30.32,0:07:34.78,Default,,0,0,0,,Біз маймыл емеспіз, біз құралдарды пайдалана аламыз.
Dialogue: 0,0:07:35.16,0:07:36.83,Default,,0,0,0,,Қарғыс атсын! (Теңізшілер) Ахаха
Dialogue: 0,0:07:37.99,0:07:40.20,Default,,0,0,0,,Сізге қауіп төніп тұр. Аман болыңыз.
Dialogue: 0,0:07:40.58,0:07:41.87,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:42.00,0:07:44.13,Default,,0,0,0,,Көрмей тұрсың ба, бәрі бір қиындық тудырып жатыр?
Dialogue: 0,0:07:44.71,0:07:45.63,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:45.79,0:07:49.51,Default,,0,0,0,,Хехе, біз осы елде ізгі ниетті насихаттау үшін келдік.
Dialogue: 0,0:07:49.67,0:07:50.63,Default,,0,0,0,,Әсіресе
Dialogue: 0,0:07:51.63,0:07:54.18,Default,,0,0,0,,Қыздармен тіл табысу керек
Dialogue: 0,0:07:54.26,0:07:55.72,Default,,0,0,0,,Иә, сүйкімді
Dialogue: 0,0:07:55.80,0:07:59.68,Default,,0,0,0,,Жапония Сёгун Фудзи Гейша тауы Мен ше?
Dialogue: 0,0:08:00.02,0:08:00.98,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:08:01.27,0:08:03.44,Default,,0,0,0,,Бізбен бірге ойнайық
Dialogue: 0,0:08:05.48,0:08:07.65,Default,,0,0,0,,Татуласайық, Беппин-сан
Dialogue: 0,0:08:07.73,0:08:08.73,Default,,0,0,0,,Жоқ, жібер!
Dialogue: 0,0:08:09.11,0:08:11.40,Default,,0,0,0,,Қарғыс атсын! Бірдеңе істе! Сәлем!
Dialogue: 0,0:08:11.78,0:08:12.90,Default,,0,0,0,,Хэхехе (Токи) Жоқ!
Dialogue: 0,0:08:15.99,0:08:18.95,Default,,0,0,0,,Егер сіз еркеліктерді байыппен қабылдамасаңыз, сізге зиян тигізеді.
Dialogue: 0,0:08:19.24,0:08:20.24,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:08:20.33,0:08:21.25,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:08:21.33,0:08:24.79,Default,,0,0,0,,Мына жігіт біздің жолымызға бөгет болып жатқан сияқты.
Dialogue: 0,0:08:27.29,0:08:29.38,Default,,0,0,0,,Токи, сен артта қал.
Dialogue: 0,0:08:29.50,0:08:30.38,Default,,0,0,0,,Иә
Dialogue: 0,0:08:31.01,0:08:33.47,Default,,0,0,0,,Ей, мен қаша алмаймын.
Dialogue: 0,0:08:33.80,0:08:34.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:36.09,0:08:38.89,Default,,0,0,0,,Ой, әзіл ғой. Бұл әзіл.
Dialogue: 0,0:08:39.18,0:08:40.64,Default,,0,0,0,,Айтсаңыз, түсінесіз.
Dialogue: 0,0:08:41.97,0:08:43.02,Default,,0,0,0,,Әңгімелеу!
Dialogue: 0,0:08:44.48,0:08:45.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:45.98,0:08:48.61,Default,,0,0,0,,Эй, сен оны жаңа ғана кесіп алдың ба? Жоқ, ол соншалықты жылдам болды, мен оны көре алмадым
Dialogue: 0,0:08:50.02,0:08:51.48,Default,,0,0,0,,Иә, аздап
Dialogue: 0,0:08:52.99,0:08:53.95,Default,,0,0,0,,Иә
Dialogue: 0,0:08:54.82,0:08:55.66,Default,,0,0,0,,Уау
Dialogue: 0,0:08:56.16,0:08:57.91,Default,,0,0,0,,Зама Миягаре
Dialogue: 0,0:08:58.12,0:09:00.49,Default,,0,0,0,,Бейбақ! Бәрің, мына жігітті ұрыңдар!
Dialogue: 0,0:09:00.62,0:09:01.45,Default,,0,0,0,,О!
Dialogue: 0,0:09:05.62,0:09:07.54,Default,,0,0,0,,О!
Dialogue: 0,0:09:08.75,0:09:09.96,Default,,0,0,0,,Не деген сұмдық күш
Dialogue: 0,0:09:10.04,0:09:12.13,Default,,0,0,0,,Яхико, мына бамбук қылышын маған берші. (Яхико) Иә?
Dialogue: 0,0:09:12.21,0:09:13.63,Default,,0,0,0,,Сукедачи, Сукедачи
Dialogue: 0,0:09:13.76,0:09:15.88,Default,,0,0,0,,Мұның қажеті жоқ. (Каору) А?
Dialogue: 0,0:09:16.97,0:09:19.30,Default,,0,0,0,,Бұл шет ел болғандықтан, олар оны шешіп алғысы келуі мүмкін, бірақ
Dialogue: 0,0:09:19.43,0:09:21.60,Default,,0,0,0,,Әйелдер мен қыздарға қатысты зорлық-зомбылыққа жол берілмейді.
Dialogue: 0,0:09:23.47,0:09:24.31,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:25.23,0:09:26.69,Default,,0,0,0,,Бұл тәртіпсіз және шулы.
Dialogue: 0,0:09:29.65,0:09:31.11,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:09:34.24,0:09:35.07,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:36.15,0:09:37.49,Default,,0,0,0,,Бұл жігіт! (Теңізші 1) Арсыз!
Dialogue: 0,0:09:43.74,0:09:44.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:45.62,0:09:46.83,Default,,0,0,0,,Сәлем! Барлығы келеді
Dialogue: 0,0:09:47.21,0:09:49.50,Default,,0,0,0,,Бәрі жақсы, алған нәрсені ойлап табыңыз.
Dialogue: 0,0:09:56.42,0:09:57.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:59.01,0:10:00.68,Default,,0,0,0,,Самурай Абайлаңыз! Бұл жаңа!
Dialogue: 0,0:10:01.05,0:10:01.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:06.02,0:10:06.85,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:10:06.98,0:10:08.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:11.52,0:10:13.94,Default,,0,0,0,,Жекпе-жек кезінде снарядтарды қолданудың пайдасы жоқ.
Dialogue: 0,0:10:16.28,0:10:17.36,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:17.78,0:10:18.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:20.74,0:10:22.58,Default,,0,0,0,,Кеншин Кеншин ше?
Dialogue: 0,0:10:23.95,0:10:26.04,Default,,0,0,0,,Кеншин! Сіз оны кесіп тастадыңыз ба?
Dialogue: 0,0:10:27.00,0:10:27.87,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:30.12,0:10:31.79,Default,,0,0,0,,Сасаюки де білетін шығар.
Dialogue: 0,0:10:31.88,0:10:34.63,Default,,0,0,0,,Бұл қылыш ешкімді кесіп тастай алмайды.
Dialogue: 0,0:10:34.71,0:10:35.71,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:10:40.13,0:10:41.89,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:10:42.01,0:10:42.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:43.01,0:10:44.64,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:10:45.51,0:10:46.39,Default,,0,0,0,,Кеншин
Dialogue: 0,0:10:46.47,0:10:48.52,Default,,0,0,0,,Қылыш алып жүру аздап әбігерге түседі.
Dialogue: 0,0:10:48.60,0:10:49.44,Default,,0,0,0,,Қате
Dialogue: 0,0:10:49.52,0:10:50.35,Default,,0,0,0,,О
Dialogue: 0,0:10:50.44,0:10:52.90,Default,,0,0,0,,О! Анау самурай да қаш.
Dialogue: 0,0:10:53.65,0:10:56.23,Default,,0,0,0,,Токи, сен де жасыр. Кейін кездесейік.
Dialogue: 0,0:10:57.36,0:10:59.65,Default,,0,0,0,,Кел (Каору) міне, міне
Dialogue: 0,0:11:00.86,0:11:02.45,Default,,0,0,0,,Бейбақ, қашып кетсін!
Dialogue: 0,0:11:02.57,0:11:05.62,Default,,0,0,0,,Балалар мен сендерге қамқор боламын.
Dialogue: 0,0:11:06.29,0:11:07.33,Default,,0,0,0,,Уау
Dialogue: 0,0:11:09.16,0:11:10.79,Default,,0,0,0,,Міне! Балалар, не істеп жатырсыңдар?
Dialogue: 0,0:11:10.87,0:11:12.54,Default,,0,0,0,,Цк, шулы.
Dialogue: 0,0:11:12.63,0:11:14.63,Default,,0,0,0,,Тағы біраз ойнайық, жарай ма?
Dialogue: 0,0:11:14.75,0:11:15.67,Default,,0,0,0,,Урия
Dialogue: 0,0:11:18.26,0:11:22.76,Default,,0,0,0,,Ал, алдыңғы қақпадағы қасқыр және артқы қақпа туралы бірдеңе ше?
Dialogue: 0,0:11:22.89,0:11:23.72,Default,,0,0,0,,Мен шештім!
Dialogue: 0,0:11:24.01,0:11:26.35,Default,,0,0,0,,Эй, кел! Бұл үлкен
Dialogue: 0,0:11:26.51,0:11:27.68,Default,,0,0,0,,Ха… Жылдам ашып көр.
Dialogue: 0,0:11:28.68,0:11:29.60,Default,,0,0,0,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,0:11:30.52,0:11:33.02,Default,,0,0,0,,Не! Сіз (1-матрос) Бұл менің кінәм емес.
Dialogue: 0,0:11:33.73,0:11:35.90,Default,,0,0,0,,Шулы! (Теңізші 1) Сіз мұны істейсіз бе?
Dialogue: 0,0:11:37.61,0:11:40.32,Default,,0,0,0,,Хе хи хи білмеймін
Dialogue: 0,0:11:44.07,0:11:45.66,Default,,0,0,0,,Алыңыз! (Офицер) Уау!
Dialogue: 0,0:11:51.62,0:11:53.17,Default,,0,0,0,,Достарыңыз жақсы ма?
Dialogue: 0,0:11:53.42,0:11:56.71,Default,,0,0,0,,Ах, Сасаюки туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:11:57.29,0:11:59.88,Default,,0,0,0,,Солай болса да, Мырза, сіз өте жақсы істеп жатырсыз.
Dialogue: 0,0:12:00.01,0:12:01.76,Default,,0,0,0,,Жоқ, мен ештеңе емеспін.
Dialogue: 0,0:12:01.97,0:12:03.51,Default,,0,0,0,,Кішіпейілділік? Әбден жеткілікті.
Dialogue: 0,0:12:03.68,0:12:05.89,Default,,0,0,0,,Оның орнына, Ием, неге кері жүзді қылыш қолданасыз?
Dialogue: 0,0:12:06.60,0:12:08.72,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:12:09.72,0:12:13.56,Default,,0,0,0,,Мен енді ешкімді қимаймын деп ант бердім.
Dialogue: 0,0:12:14.19,0:12:15.44,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:15.90,0:12:19.23,Default,,0,0,0,,Қазір ойлап қарасам, адамдарды қысқартқанды ұнатпаймын.
Dialogue: 0,0:12:30.95,0:12:36.25,Default,,0,0,0,,Бірақ Эдо кезеңінің соңында қайтыс болғандар ешқашан бүгінгі шірік Мэйдзи үкіметін көруге мәжбүр болмады.
Dialogue: 0,0:12:39.21,0:12:42.72,Default,,0,0,0,,Дүниені осылай көрсе, ренжігеннен көздеріне жас алар ма еді?
Dialogue: 0,0:12:43.17,0:12:46.93,Default,,0,0,0,,Жоқ, сіз жай ғана күле бастайсыз, иә?
Dialogue: 0,0:12:48.64,0:12:51.72,Default,,0,0,0,,Ол кезде мен көрген аспан көгілдір еді.
Dialogue: 0,0:12:55.90,0:12:59.40,Default,,0,0,0,,Көк аспан мәңгілік биік, ашық болуы керек.
Dialogue: 0,0:12:59.82,0:13:00.69,Default,,0,0,0,,О
Dialogue: 0,0:13:01.61,0:13:04.61,Default,,0,0,0,,Біз Токиді жалғыз қалдыра алмаймыз.
Dialogue: 0,0:13:04.82,0:13:05.74,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:13:05.86,0:13:08.12,Default,,0,0,0,,Кеншин Химура Кеншин
Dialogue: 0,0:13:08.20,0:13:10.33,Default,,0,0,0,,Мен Шигурэ Такимимін
Dialogue: 0,0:13:11.41,0:13:13.16,Default,,0,0,0,,Шигурэ Такими
Dialogue: 0,0:13:13.91,0:13:15.71,Default,,0,0,0,,Мен сені бір күні қайта көремін деп үміттенемін.
Dialogue: 0,0:13:15.79,0:13:17.54,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:13:28.55,0:13:30.39,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:13:32.81,0:13:35.73,Default,,0,0,0,,Хмф, ол әлі де сүйкімді жігіт.
Dialogue: 0,0:13:36.35,0:13:38.48,Default,,0,0,0,,Бұл өзара.
Dialogue: 0,0:13:38.69,0:13:41.77,Default,,0,0,0,,Мен сізді демалу және Йокогаманың көрікті жерлерін көру үшін келдіңіз деп ойламаймын.
Dialogue: 0,0:13:42.48,0:13:44.49,Default,,0,0,0,,Бірақ кейін сені Хол Хорсты өлтіргендей өлтіремін.
Dialogue: 0,0:13:44.99,0:13:47.57,Default,,0,0,0,,Ол кісіден аулақ болғаныңыз жөн.
Dialogue: 0,0:13:47.99,0:13:48.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:48.99,0:13:52.49,Default,,0,0,0,,Шигурэ Такими Ол тым қауіпті
Dialogue: 0,0:13:58.62,0:14:02.42,Default,,0,0,0,,Ол әдемі адам еді. Ол басқа адамдардан өте ерекшеленетін.
Dialogue: 0,0:14:02.55,0:14:04.21,Default,,0,0,0,,Сіз кім туралы айтып отырсыз?
Dialogue: 0,0:14:04.30,0:14:07.34,Default,,0,0,0,,Сонымен, сіз Беппин-санның атын сұрадыңыз ба?
Dialogue: 0,0:14:07.42,0:14:08.84,Default,,0,0,0,,Сөзсіз (Саносуке) О!
Dialogue: 0,0:14:08.93,0:14:10.34,Default,,0,0,0,,Қазірдің өзінде! сендер жігіттер
Dialogue: 0,0:14:10.72,0:14:12.85,Default,,0,0,0,,Бұрынғы Айзу феодалының қызы Токи
Dialogue: 0,0:14:13.14,0:14:14.89,Default,,0,0,0,,Тіпті Токи Такацуки
Dialogue: 0,0:14:14.97,0:14:16.18,Default,,0,0,0,,Айзу?
Dialogue: 0,0:14:16.35,0:14:18.35,Default,,0,0,0,,Мен сенің көп қиындықтан өтіп жатқаныңа сенімдімін.
Dialogue: 0,0:14:18.81,0:14:21.06,Default,,0,0,0,,Оны басқа мағынада қабылдауға болады.
Dialogue: 0,0:14:21.19,0:14:22.11,Default,,0,0,0,,Айзу?
Dialogue: 0,0:14:22.19,0:14:24.32,Default,,0,0,0,,Сіз не айтып тұрсыз? Мен шынымен күрестім...
Dialogue: 0,0:14:24.40,0:14:27.15,Default,,0,0,0,,Жоқ! Ол әдемі, сондықтан мен оның қиын болғанын естідім.
Dialogue: 0,0:14:27.24,0:14:29.45,Default,,0,0,0,,Иә, солай болуы мүмкін.
Dialogue: 0,0:14:31.78,0:14:33.45,Default,,0,0,0,,Айзудағы Такацуки…
Dialogue: 0,0:14:46.21,0:14:47.63,Default,,0,0,0,,(қылыштың айқасатын дыбысы)
Dialogue: 0,0:14:54.10,0:14:56.47,Default,,0,0,0,,Менің қарным ашты (Яхико) Ах, қарным ашты.
Dialogue: 0,0:14:56.56,0:14:59.02,Default,,0,0,0,,Жарайсыңдар! Йокогаманы ойлағанда, шетелдіктер елестейді.
Dialogue: 0,0:14:59.10,0:15:01.15,Default,,0,0,0,,Шетелдіктер туралы айтсам, бұл сиыр еті!
Dialogue: 0,0:15:01.23,0:15:02.10,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:02.19,0:15:05.23,Default,,0,0,0,,Сол себепті Саносуке Йокогамаға келді, солай ма?
Dialogue: 0,0:15:05.32,0:15:07.19,Default,,0,0,0,,Бұл қиын, солай емес пе? (Яхико) Хмм.
Dialogue: 0,0:15:07.28,0:15:10.24,Default,,0,0,0,,Бірақ Йокогамадағы «Акабекодан» айырмашылығы, сіз оны төлей алмайсыз.
Dialogue: 0,0:15:10.32,0:15:11.24,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:11.32,0:15:12.32,Default,,0,0,0,,Хаха, бұл...
Dialogue: 0,0:15:12.41,0:15:13.70,Default,,0,0,0,,Куфуфуфу…
Dialogue: 0,0:15:13.82,0:15:15.03,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:15:15.12,0:15:17.33,Default,,0,0,0,,Қызықсыз ештеңе айтпа. Үйге келгенде қайтарып беремін.
Dialogue: 0,0:15:17.41,0:15:18.41,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:18.50,0:15:19.79,Default,,0,0,0,,Эй, Яхико, сен де!
Dialogue: 0,0:15:19.87,0:15:22.12,Default,,0,0,0,,Не? Оған менің еш қатысым жоқ.
Dialogue: 0,0:15:22.21,0:15:23.50,Default,,0,0,0,,Шулы!
Dialogue: 0,0:15:27.50,0:15:28.38,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:31.80,0:15:33.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:33.93,0:15:35.10,Default,,0,0,0,,Әрі қарай жалғастырыңыздар!
Dialogue: 0,0:15:37.77,0:15:38.60,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:15:40.10,0:15:40.94,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:54.99,0:15:56.28,Default,,0,0,0,,Кеншин (Кеншин) Ах
Dialogue: 0,0:15:58.87,0:16:01.46,Default,,0,0,0,,Әй, бұл не? Өлді ме?
Dialogue: 0,0:16:01.54,0:16:02.58,Default,,0,0,0,,Минаға тиген сияқты.
Dialogue: 0,0:16:06.54,0:16:07.63,Default,,0,0,0,,Жолдан кет! Жолдан кет!
Dialogue: 0,0:16:11.22,0:16:13.18,Default,,0,0,0,,Додо Додо
Dialogue: 0,0:16:14.68,0:16:16.39,Default,,0,0,0,,Барон Тамано (Тамано) Оу
Dialogue: 0,0:16:16.55,0:16:18.06,Default,,0,0,0,,Кавай, дереу штабқа хабарлаңыз.
Dialogue: 0,0:16:18.14,0:16:18.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:19.06,0:16:20.77,Default,,0,0,0,,Сакашита жақын маңдағы полицияға барады! (Сакашита) Ха!
Dialogue: 0,0:16:21.81,0:16:22.73,Default,,0,0,0,,Бірінші жасақ алға!
Dialogue: 0,0:16:23.52,0:16:27.27,Default,,0,0,0,,Тезірек кіріңіз! Рұқсат бермейінше атуға болмайды. Бар!
Dialogue: 0,0:16:29.57,0:16:31.32,Default,,0,0,0,,Екінші бөлімді қоршайды
Dialogue: 0,0:16:31.94,0:16:34.70,Default,,0,0,0,,Қалғандарың бұл жерді күзетіңдер, азаматтар зардап шекпесін!
Dialogue: 0,0:16:34.78,0:16:35.61,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:36.45,0:16:38.33,Default,,0,0,0,,Бұл қауіпті, артқа тұрыңыз.
Dialogue: 0,0:16:41.29,0:16:42.41,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:16:42.91,0:16:44.92,Default,,0,0,0,,Екі қатарға тұрыңдар!
Dialogue: 0,0:16:47.17,0:16:49.04,Default,,0,0,0,,Жақсы! Бұрын жоспарланғандай жабыңыз.
Dialogue: 0,0:16:53.13,0:16:55.97,Default,,0,0,0,,Маған қашып кетуіме жол берме! Қуда, қу!
Dialogue: 0,0:16:58.30,0:16:59.39,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:03.23,0:17:05.64,Default,,0,0,0,,Мені қу, қашып кетуіме жол берме!
Dialogue: 0,0:17:06.56,0:17:07.77,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:19.28,0:17:22.41,Default,,0,0,0,,Бірақ бүгін көп нәрсе болды.
Dialogue: 0,0:17:22.79,0:17:25.79,Default,,0,0,0,,Йокогама өте қызықты жер.
Dialogue: 0,0:17:25.91,0:17:29.63,Default,,0,0,0,,Дұрыс, Токи Такацуки мырза, Riku Бу, сиыр етінің ыстық нүктесінің ақысын өтеу
Dialogue: 0,0:17:31.00,0:17:33.96,Default,,0,0,0,,Әлгі солдат керемет еді.
Dialogue: 0,0:17:34.09,0:17:37.34,Default,,0,0,0,,Иә? Яхико: Сен осыны аңсайтынсың ба?
Dialogue: 0,0:17:37.59,0:17:40.10,Default,,0,0,0,,Жоқ, мен әскерилерді айтып тұрған жоқпын.
Dialogue: 0,0:17:40.30,0:17:42.01,Default,,0,0,0,,Қараңызшы.
Dialogue: 0,0:17:42.14,0:17:43.81,Default,,0,0,0,,Ал, алдымен атқа міну керек.
Dialogue: 0,0:17:43.89,0:17:44.73,Default,,0,0,0,,Иә, жүр!
Dialogue: 0,0:17:45.14,0:17:47.73,Default,,0,0,0,,Бірақ аттар адамдарға қарайды.
Dialogue: 0,0:17:47.81,0:17:49.52,Default,,0,0,0,,Ең болмаса аттан құлап қалмауға тырыс.
Dialogue: 0,0:17:49.61,0:17:50.44,Default,,0,0,0,,Дұрыс па? Кеншин
Dialogue: 0,0:17:50.52,0:17:52.69,Default,,0,0,0,,Хаха, дұрыс (Яхико) Қандай тітіркендіргіш!
Dialogue: 0,0:17:57.91,0:17:58.74,Default,,0,0,0,,Ах
Dialogue: 0,0:18:00.78,0:18:02.16,Default,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,0:18:02.33,0:18:04.08,Default,,0,0,0,,Ал... Мен солай ойлаймын.
Dialogue: 0,0:18:18.80,0:18:21.18,Default,,0,0,0,,Рахмет, мұғалім.
Dialogue: 0,0:18:21.26,0:18:22.93,Default,,0,0,0,,Көп рахмет Сау болыңыз
Dialogue: 0,0:18:23.01,0:18:24.26,Default,,0,0,0,,Тез кел!
Dialogue: 0,0:18:24.35,0:18:25.93,Default,,0,0,0,,Күте тұрыңыз, эй!
Dialogue: 0,0:18:27.10,0:18:28.56,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:18:28.64,0:18:30.90,Default,,0,0,0,,Бәріңе сау болыңдар, абай болыңдар.
Dialogue: 0,0:18:31.02,0:18:32.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:04.14,0:19:05.81,Default,,0,0,0,,Балалар үйге қайтты ма?
Dialogue: 0,0:19:05.97,0:19:06.81,Default,,0,0,0,,Иә
Dialogue: 0,0:19:09.39,0:19:10.27,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:19:10.35,0:19:13.11,Default,,0,0,0,,Гендацудың қайтыс болғанына 14 жыл болды ма?
Dialogue: 0,0:19:13.73,0:19:14.57,Default,,0,0,0,,Иә
Dialogue: 0,0:19:14.73,0:19:17.15,Default,,0,0,0,,Мен төрт жасымда ағам қайтыс болды.
Dialogue: 0,0:19:17.53,0:19:21.03,Default,,0,0,0,,Содан бері мен мұнда 14 жыл болдым.
Dialogue: 0,0:19:22.16,0:19:23.99,Default,,0,0,0,,Бұл жылдам.
Dialogue: 0,0:19:24.74,0:19:28.83,Default,,0,0,0,,Бұрын қорқынышты көрінгенде не ойладыңыз?
Dialogue: 0,0:19:29.16,0:19:30.91,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:19:31.50,0:19:33.88,Default,,0,0,0,,Әй, Шигуре! Сен ондасың ба?
Dialogue: 0,0:19:34.25,0:19:35.88,Default,,0,0,0,,Кокока (Сигуре) Каджики
Dialogue: 0,0:19:39.72,0:19:40.55,Default,,0,0,0,,О
Dialogue: 0,0:19:46.01,0:19:47.14,Default,,0,0,0,,(Шодзи жабылған дыбыс)
Dialogue: 0,0:19:52.85,0:19:53.77,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:53.85,0:19:56.77,Default,,0,0,0,,Шигуре, сіздің жоспарыңыз дәл жоспарланғандай болды.
Dialogue: 0,0:19:57.27,0:19:58.78,Default,,0,0,0,,Егерестен келген мемлекеттік қонақ
Dialogue: 0,0:19:58.86,0:20:01.15,Default,,0,0,0,,Менің Йокогамадан Киотоға бару жоспарларым өзгерді.
Dialogue: 0,0:20:01.24,0:20:02.57,Default,,0,0,0,,Мен Токиоға 6 күннен кейін келемін.
Dialogue: 0,0:20:02.78,0:20:03.61,Default,,0,0,0,,Иә
Dialogue: 0,0:20:04.11,0:20:07.37,Default,,0,0,0,,Мен тағы бір зеңбіректі алу үшін келісім жасадым.
Dialogue: 0,0:20:07.49,0:20:09.04,Default,,0,0,0,,Бұл сендіреді.
Dialogue: 0,0:20:09.29,0:20:12.54,Default,,0,0,0,,Шигуре, соңғы аяқтау, сіз команданы қабылдайсыз.
Dialogue: 0,0:20:12.92,0:20:14.21,Default,,0,0,0,,А, мен білемін.
Dialogue: 0,0:20:14.96,0:20:16.63,Default,,0,0,0,,Енді артқа жол жоқ
Dialogue: 0,0:20:16.92,0:20:18.71,Default,,0,0,0,,Және де қатаңдық үшін.
Dialogue: 0,0:20:18.80,0:20:19.71,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:20.63,0:20:23.51,Default,,0,0,0,,Мен бұл түнді ешқашан ұмытпаймын
Dialogue: 0,0:20:29.89,0:20:31.02,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:20:36.86,0:20:38.15,Default,,0,0,0,,Сацума мен Чошу
Dialogue: 0,0:20:38.23,0:20:40.61,Default,,0,0,0,,Қол ұстасып жатқаны рас па? Қатаң қол жеткізілді
Dialogue: 0,0:20:41.53,0:20:42.86,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:20:42.95,0:20:45.24,Default,,0,0,0,,Бұл жасырын жиналыс бүгін кешке өтеді.
Dialogue: 0,0:20:46.03,0:20:48.74,Default,,0,0,0,,Олар сегунатты құлату үшін қолдан келгеннің бәрін жасайды.
Dialogue: 0,0:20:49.74,0:20:53.29,Default,,0,0,0,,Сатсумадан Такамори Сайго, Чошудан Когоро Катсура
Dialogue: 0,0:20:54.54,0:20:56.12,Default,,0,0,0,,Катсурадан Сайгоға
Dialogue: 0,0:20:56.79,0:20:58.13,Default,,0,0,0,,Қандай керемет құрам.
Dialogue: 0,0:20:58.63,0:21:01.55,Default,,0,0,0,,Сондай-ақ делдал болған Риома Сакамото болуы мүмкін.
Dialogue: 0,0:21:01.71,0:21:03.88,Default,,0,0,0,,Бұл құлататын фракцияның барлық үлкен басшылары осында дегенді білдіре ме?
Dialogue: 0,0:21:04.72,0:21:07.51,Default,,0,0,0,,Онда шабуыл жасасақ, заман ағымы сөзсіз өзгереді.
Dialogue: 0,0:21:07.84,0:21:09.64,Default,,0,0,0,,Менің Айзум мақтанады.
Dialogue: 0,0:21:09.72,0:21:11.56,Default,,0,0,0,,Айзу сегунатты басқарады!
Dialogue: 0,0:21:11.68,0:21:13.27,Default,,0,0,0,,Шигурэ-сан (Самурай 4) Шигурэ-сан
Dialogue: 0,0:21:15.10,0:21:16.06,Default,,0,0,0,,Ал қайда?
Dialogue: 0,0:21:16.27,0:21:18.77,Default,,0,0,0,,Біз барлығымыз әртүрлі нәрселерді қарастырдық.
Dialogue: 0,0:21:19.11,0:21:22.28,Default,,0,0,0,,Сацуманың келіп-кететін жері Масудая деп ойладым.
Dialogue: 0,0:21:22.57,0:21:25.57,Default,,0,0,0,,Шинсенгуми сонда тұрып қалды, сондықтан бұл мүмкін емес.
Dialogue: 0,0:21:26.11,0:21:27.95,Default,,0,0,0,,Сузуя күдіктене ме?
Dialogue: 0,0:21:28.28,0:21:29.95,Default,,0,0,0,,Ағаш материалдарын көтерме сатушы Minota
Dialogue: 0,0:21:30.20,0:21:31.29,Default,,0,0,0,,Арақашықтық бар.
Dialogue: 0,0:21:31.49,0:21:33.79,Default,,0,0,0,,Біздің де уайымымыз осы.
Dialogue: 0,0:21:34.37,0:21:35.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:36.08,0:21:37.54,Default,,0,0,0,,Менің ойымша, бұл Сузуя.
Dialogue: 0,0:21:37.67,0:21:40.38,Default,,0,0,0,,Жоқ, Сузуя тығылып, қашып құтыла алмайды.
Dialogue: 0,0:21:41.80,0:21:44.76,Default,,0,0,0,,Ондай жерде маңызды кездесу өткізуге мүмкіндік жоқ.
Dialogue: 0,0:21:44.97,0:21:46.43,Default,,0,0,0,,
Dialogue: 0,0:21:47.59,0:21:48.97,Default,,0,0,0,,Минота - болатын жер
Dialogue: 0,0:21:49.30,0:21:52.22,Default,,0,0,0,,Егер сіз осындай мүмкіндікті жіберіп алсаңыз, өміріңіздің соңына дейін өкінесіз.
Dialogue: 0,0:21:52.39,0:21:54.52,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:55.81,0:21:57.02,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:22:05.15,0:22:06.32,Default,,0,0,0,,Не болды? Қатаң қол жеткізілді
Dialogue: 0,0:22:07.20,0:22:09.16,Default,,0,0,0,,А, мен бір нәрсеге қызықпын.
Dialogue: 0,0:22:09.28,0:22:10.32,Default,,0,0,0,,Мен Сузуяға барамын
Dialogue: 0,0:22:10.74,0:22:11.58,Default,,0,0,0,,Гендацу
Dialogue: 0,0:22:12.08,0:22:13.29,Default,,0,0,0,,Бұл менің болжамым.
Dialogue: 0,0:22:13.37,0:22:16.04,Default,,0,0,0,,Әрине, басқа ештеңе болмаса, мен сізге бірден келемін.
Dialogue: 0,0:22:18.21,0:22:20.83,Default,,0,0,0,,Жарайды, егер көп айтсаң.
Dialogue: 0,0:22:21.79,0:22:23.71,Default,,0,0,0,,Асами, Йокота және басқалары Сакурайдың соңынан ереді!
Dialogue: 0,0:22:23.80,0:22:24.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:25.01,0:22:26.26,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:55.95,0:22:58.00,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:23:09.26,0:23:10.22,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:23:25.07,0:23:26.23,Default,,0,0,0,,Гендацу!
Dialogue: 0,0:23:36.12,0:23:37.45,Default,,0,0,0,,Гендацу!
Dialogue: 0,0:23:48.42,0:23:50.42,Default,,0,0,0,,Кешіріңіз, Гэндацу
Dialogue: 0,0:23:51.09,0:23:53.26,Default,,0,0,0,,Мен...
Dialogue: 0,0:23:54.09,0:23:55.72,Default,,0,0,0,,Бұл менің қателігім болды!
Dialogue: 0,0:23:56.64,0:23:59.22,Default,,0,0,0,,Мені кешіріңіз! Қатаң қол жеткізілді
Dialogue: 0,0:23:59.85,0:24:03.98,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:24:11.53,0:24:14.45,Default,,0,0,0,,Сол кезде мен Гендацудың пікірін ұстансам,
Dialogue: 0,0:24:14.53,0:24:16.24,Default,,0,0,0,,Гендацу өлген жоқ.
Dialogue: 0,0:24:16.53,0:24:17.37,Default,,0,0,0,,Хмм
Dialogue: 0,0:24:17.45,0:24:20.58,Default,,0,0,0,,Сонымен қатар, егер олар сол кездегі Сацума-Чошу одағын талқандаса.
Dialogue: 0,0:24:20.83,0:24:24.29,Default,,0,0,0,,Одан кейін Айзу мұндай сұмдық жағдайды бастан кешірмеді.
Dialogue: 0,0:24:25.08,0:24:28.55,Default,,0,0,0,,Айзу соғысындағы Бяккотай сияқты трагедия болмас еді.
Dialogue: 0,0:24:29.05,0:24:32.13,Default,,0,0,0,,Мұның бәрі сол түні менің қате пікірімнен.
Dialogue: 0,0:24:33.09,0:24:34.93,Default,,0,0,0,,Бұл менің жауапкершілігім.
Dialogue: 0,0:24:36.05,0:24:38.81,Default,,0,0,0,,Мені әрқашан кінәлі сезім қинады.
Dialogue: 0,0:24:39.56,0:24:41.77,Default,,0,0,0,,Дос бақытсыздыққа тап болған сайын,
Dialogue: 0,0:24:42.35,0:24:45.15,Default,,0,0,0,,Гендацудың өкініштері үшін кек алатын уақыт келді.
Dialogue: 0,0:24:46.15,0:24:49.98,Default,,0,0,0,,Егер мен жайбарақат өмір сүретін болсам, Гендацуды аямас едім.
Dialogue: 0,0:24:55.91,0:24:56.74,Default,,0,0,0,,Ах
Dialogue: 0,0:24:58.95,0:24:59.91,Default,,0,0,0,,Сыртқа шығу
Dialogue: 0,0:25:00.08,0:25:02.50,Default,,0,0,0,,Не... қай жолмен? (Сигуре) Сізге білудің қажеті жоқ.
Dialogue: 0,0:25:03.25,0:25:04.46,Default,,0,0,0,,Баяулатыңыз
Dialogue: 0,0:25:15.43,0:25:17.22,Default,,0,0,0,,(Аяме мен Торғайдың күлкісі)
Dialogue: 0,0:25:17.39,0:25:19.14,Default,,0,0,0,,Тоқта, күт! Мұнда!
Dialogue: 0,0:25:20.43,0:25:22.81,Default,,0,0,0,,Көшеге шықпаңыз (2 адам) Иә.
Dialogue: 0,0:25:25.23,0:25:26.52,Default,,0,0,0,,Каору-ни-тан!
Dialogue: 0,0:25:28.48,0:25:29.40,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,0:25:29.52,0:25:32.78,Default,,0,0,0,,Доджоны айналып жүрген біреу бар.
Dialogue: 0,0:25:33.44,0:25:37.20,Default,,0,0,0,,Қазірдің өзінде! Егер сен біртүрлі итермелеуші ​​болсаң, мен сені ұрамын.
Dialogue: 0,0:25:47.71,0:25:49.38,Default,,0,0,0,,О? Токи мырза
Dialogue: 0,0:25:50.92,0:25:52.75,Default,,0,0,0,,Ах! Қош келдіңіз
Dialogue: 0,0:25:52.84,0:25:53.76,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:25:55.09,0:25:55.97,Default,,0,0,0,,Сәлем
Dialogue: 0,0:25:56.13,0:25:57.97,Default,,0,0,0,,А... білесің бе, бұл дохжо.
Dialogue: 0,0:25:58.05,0:26:00.72,Default,,0,0,0,,Алдыңғы есік екінші жағында, тұтынушы алдыңғы есікте.
Dialogue: 0,0:26:08.14,0:26:09.23,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,0:26:09.44,0:26:11.73,Default,,0,0,0,,Кешіріңіз. Өтінемін, уайымдамаңыз.
Dialogue: 0,0:26:11.86,0:26:13.86,Default,,0,0,0,,Химура-сан ше?
Dialogue: 0,0:26:13.94,0:26:15.28,Default,,0,0,0,,Кеншин? (Токи) Иә.
Dialogue: 0,0:26:15.36,0:26:17.24,Default,,0,0,0,,Гимура мырза маған...
Dialogue: 0,0:26:17.49,0:26:19.82,Default,,0,0,0,,Не, мен емес пе?
Dialogue: 0,0:26:19.91,0:26:22.20,Default,,0,0,0,,Кеншинді барлық дәмді жерлерге апарма.
Dialogue: 0,0:26:22.87,0:26:25.37,Default,,0,0,0,,Кеншин тофу сатып алуға шықты.
Dialogue: 0,0:26:25.58,0:26:26.54,Default,,0,0,0,,Тофу?
Dialogue: 0,0:26:26.91,0:26:28.79,Default,,0,0,0,,Өйткені шоппинг Кеншиннің рөлі.
Dialogue: 0,0:26:28.87,0:26:30.83,Default,,0,0,0,,Жақсы! Бұл
Dialogue: 0,0:26:31.75,0:26:33.80,Default,,0,0,0,,Барлығына ләззат алыңыз.
Dialogue: 0,0:26:34.25,0:26:36.34,Default,,0,0,0,,Керемет! Бұл дәмді көрінеді
Dialogue: 0,0:26:36.42,0:26:39.47,Default,,0,0,0,,Бірақ бұл ысырап, тіпті жанды болса да.
Dialogue: 0,0:26:39.55,0:26:41.39,Default,,0,0,0,,Аспаздың шеберлігі
Dialogue: 0,0:26:41.47,0:26:43.05,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:26:46.89,0:26:48.14,Default,,0,0,0,,Бұл өте жаман, Токи-сан.
Dialogue: 0,0:26:48.23,0:26:50.31,Default,,0,0,0,,Жоқ, маған мұндай нәрсе ұнайды.
Dialogue: 0,0:26:53.52,0:26:55.07,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:26:55.32,0:26:57.07,Default,,0,0,0,,Өтінемін, көп тамақтаныңыз.
Dialogue: 0,0:26:57.40,0:26:58.99,Default,,0,0,0,,Ас болсын!
Dialogue: 0,0:27:02.12,0:27:03.33,Default,,0,0,0,,Уми!
Dialogue: 0,0:27:03.87,0:27:04.70,Default,,0,0,0,,Дәмді
Dialogue: 0,0:27:04.78,0:27:07.70,Default,,0,0,0,,Өйткені, ол біреудің пісірген тағамынан бөлек.
Dialogue: 0,0:27:08.62,0:27:10.00,Default,,0,0,0,,Материалдар әртүрлі!
Dialogue: 0,0:27:11.71,0:27:14.00,Default,,0,0,0,,Материалды тиімді пайдалану сіздің шеберлігіңізге байланысты.
Dialogue: 0,0:27:14.09,0:27:16.42,Default,,0,0,0,,Балалар, ертеңнен бастап күріш болмайды!
Dialogue: 0,0:27:16.80,0:27:20.01,Default,,0,0,0,,Жоқ, солай... Бұл материал! Материал! Эй? Яхико
Dialogue: 0,0:27:20.09,0:27:22.39,Default,,0,0,0,,Ух~ (Каору) Неге алаңдайсың?
Dialogue: 0,0:27:23.18,0:27:24.89,Default,,0,0,0,,Жақсы иіс шығады.
Dialogue: 0,0:27:24.97,0:27:26.47,Default,,0,0,0,,О, Кеншин, қош келдің.
Dialogue: 0,0:27:28.06,0:27:29.14,Default,,0,0,0,,Токиден
Dialogue: 0,0:27:31.77,0:27:33.56,Default,,0,0,0,,Каорудо Тофу де Гозару
Dialogue: 0,0:27:33.65,0:27:36.86,Default,,0,0,0,,Ах, кешіріңіз! Маған енді тофу керек емес
Dialogue: 0,0:27:36.94,0:27:37.82,Default,,0,0,0,,Оро?
Dialogue: 0,0:27:38.19,0:27:39.49,Default,,0,0,0,,Кеншин
Dialogue: 0,0:27:39.65,0:27:42.41,Default,,0,0,0,,Токи мырза, мен сізді көруге келдім, өйткені Кеншиннің бір шаруасы бар еді.
Dialogue: 0,0:27:42.49,0:27:43.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:51.87,0:27:52.87,Default,,0,0,0,,Бұл факт
Dialogue: 0,0:27:53.29,0:27:54.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:27:55.04,0:27:56.92,Default,,0,0,0,,Менің Шигуреге қатысты сұрағым бар.
Dialogue: 0,0:27:57.00,0:27:58.34,Default,,0,0,0,,Шигурэ-доно?
Dialogue: 0,0:27:58.92,0:27:59.88,Default,,0,0,0,,Токи-доно дегеніміз не?
Dialogue: 0,0:28:00.30,0:28:03.59,Default,,0,0,0,,Шигуре менің өлген ағамның жолдасы болатын.
Dialogue: 0,0:28:03.68,0:28:04.84,Default,,0,0,0,,Шамамен Эдо кезеңінің соңында
Dialogue: 0,0:28:05.22,0:28:07.18,Default,,0,0,0,,Қайтыс болған ағаңмен? (Токи) Иә.
Dialogue: 0,0:28:07.47,0:28:10.31,Default,,0,0,0,,Менің ағам менің жалғыз отбасым болатын.
Dialogue: 0,0:28:10.73,0:28:13.14,Default,,0,0,0,,Токи-дононың ағасы кім?
Dialogue: 0,0:28:13.81,0:28:14.81,Default,,0,0,0,,Айзу самурай
Dialogue: 0,0:28:16.86,0:28:18.02,Default,,0,0,0,,Гентацу Такацуки
Dialogue: 0,0:28:18.61,0:28:19.65,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:28:20.94,0:28:22.57,Default,,0,0,0,,Мына Канума үш панельді шыны?
Dialogue: 0,0:28:22.95,0:28:23.78,Default,,0,0,0,,Иә
Dialogue: 0,0:28:31.25,0:28:33.54,Default,,0,0,0,,Мен мүлде таң қалдым.
Dialogue: 0,0:28:33.62,0:28:35.88,Default,,0,0,0,,Қашанға дейін менің артыма қарап отыра бересің?
Dialogue: 0,0:28:35.96,0:28:37.67,Default,,0,0,0,,Катсура мырза Сайго мырза
Dialogue: 0,0:28:40.76,0:28:42.72,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:28:42.80,0:28:44.76,Default,,0,0,0,,Сацума мен Чошу Қоғайға шабуыл жасағанда
Dialogue: 0,0:28:44.93,0:28:47.72,Default,,0,0,0,,Қанша уақыт өтсе де Жапонияның таңы атпайды
Dialogue: 0,0:28:51.68,0:28:52.73,Default,,0,0,0,,Шинсенгуми? Бұл Мимаваригуми ме?
Dialogue: 0,0:28:52.81,0:28:54.56,Default,,0,0,0,,Катсура-сан, Сайго-санды қорға.
Dialogue: 0,0:28:54.69,0:28:55.52,Default,,0,0,0,,Біз осындамыз!
Dialogue: 0,0:28:55.60,0:28:57.11,Default,,0,0,0,,Енді түсіндім! өтініш жасау
Dialogue: 0,0:28:59.65,0:29:01.19,Default,,0,0,0,,Айзу Хитокири Гендацу!
Dialogue: 0,0:29:01.40,0:29:02.44,Default,,0,0,0,,Оларды ішке кіргізбе!
Dialogue: 0,0:29:02.82,0:29:04.78,Default,,0,0,0,,Катсура ше? Сайго: Сакамото ше?
Dialogue: 0,0:30:02.67,0:30:06.63,Default,,0,0,0,,Айдзу Гентацу Такацуки Оның лақап аты Гентацу Хитокири ме?
Dialogue: 0,0:30:06.76,0:30:10.80,Default,,0,0,0,,Канума үш қарғаның бірі, ол ғажайып жігіт еді.
Dialogue: 0,0:30:11.97,0:30:15.10,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:30:15.18,0:30:16.31,Default,,0,0,0,,Жоқ
Dialogue: 0,0:30:17.14,0:30:19.10,Default,,0,0,0,,Шигуре туралы.
Dialogue: 0,0:30:19.65,0:30:22.19,Default,,0,0,0,,Соңғы уақытта бірдеңе дұрыс болмады.
Dialogue: 0,0:30:22.32,0:30:24.78,Default,,0,0,0,,Қараңғыланып, ойға шоматын кездерім болады.
Dialogue: 0,0:30:25.32,0:30:26.82,Default,,0,0,0,,Йокогамадан оралғаннан бері
Dialogue: 0,0:30:26.90,0:30:29.49,Default,,0,0,0,,Шигурэ Химура-санды жоғары бағалады.
Dialogue: 0,0:30:29.86,0:30:30.78,Default,,0,0,0,,Мен?
Dialogue: 0,0:30:31.62,0:30:33.99,Default,,0,0,0,,Бұл заманда да сондай адам болды ма?
Dialogue: 0,0:30:34.08,0:30:36.87,Default,,0,0,0,,Біраз уақыттан кейін самураймен алғаш рет кездескенін айтты.
Dialogue: 0,0:30:37.00,0:30:39.71,Default,,0,0,0,,Мен де солай сезінемін.
Dialogue: 0,0:30:40.00,0:30:41.04,Default,,0,0,0,,Жарайды, мен кеттім. Қош бол.
Dialogue: 0,0:30:41.50,0:30:44.21,Default,,0,0,0,,Мен олардан сұрасам да ештеңеге жауап бермейді.
Dialogue: 0,0:30:44.46,0:30:45.96,Default,,0,0,0,,Бірақ Гимура мырза
Dialogue: 0,0:30:46.59,0:30:50.05,Default,,0,0,0,,Бірдеңе мені ыңғайсыз сезініп тұр!
Dialogue: 0,0:30:51.18,0:30:52.05,Default,,0,0,0,,Токиден
Dialogue: 0,0:31:02.65,0:31:05.90,Default,,0,0,0,,Кешіріңіз, Яхико мырза, оны маған жіберуге қиындық туғызғаныңыз үшін.
Dialogue: 0,0:31:06.03,0:31:09.07,Default,,0,0,0,,Жоқ, ер адамның мұны істеуі табиғи нәрсе.
Dialogue: 0,0:31:09.15,0:31:10.41,Default,,0,0,0,,Жарайды хехехе
Dialogue: 0,0:31:11.49,0:31:13.87,Default,,0,0,0,,Уау, бұл керемет сарай.
Dialogue: 0,0:31:14.95,0:31:16.24,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,0:31:17.25,0:31:18.58,Default,,0,0,0,,Сиқыршы культішілер.
Dialogue: 0,0:31:23.63,0:31:24.92,Default,,0,0,0,,Қайтып келдіңіз бе? Токи
Dialogue: 0,0:31:25.63,0:31:26.55,Default,,0,0,0,,Сәлем
Dialogue: 0,0:31:26.63,0:31:30.26,Default,,0,0,0,,Яхико мырза оны Химура мырзаның орнына жіберді.
Dialogue: 0,0:31:30.72,0:31:32.55,Default,,0,0,0,,О, Химура-дононың орны?
Dialogue: 0,0:31:32.97,0:31:33.89,Default,,0,0,0,,Иә
Dialogue: 0,0:31:34.43,0:31:36.56,Default,,0,0,0,,Хмм, сіз әдемі көрінесіз.
Dialogue: 0,0:31:36.97,0:31:38.06,Default,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,0:31:38.35,0:31:40.52,Default,,0,0,0,,Токио префектурасы Самурай Миджин Яхико
Dialogue: 0,0:31:41.02,0:31:43.48,Default,,0,0,0,,Самурай? Яхиконың әкесі...
Dialogue: 0,0:31:43.81,0:31:46.73,Default,,0,0,0,,Әкем Шоғытайға қосылып, әділдік үшін өлді.
Dialogue: 0,0:31:47.07,0:31:48.53,Default,,0,0,0,,Шоғытай?
Dialogue: 0,0:31:48.69,0:31:51.11,Default,,0,0,0,,Бұл керемет әке болса керек.
Dialogue: 0,0:31:51.74,0:31:52.74,Default,,0,0,0,,Иә
Dialogue: 0,0:31:53.28,0:31:56.03,Default,,0,0,0,,Бірдеңе керек болса, маған кел.
Dialogue: 0,0:31:56.20,0:31:57.83,Default,,0,0,0,,Мен сенімен кез келген нәрсені талқылаймын.
Dialogue: 0,0:31:57.95,0:31:59.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:32:00.00,0:32:00.91,Default,,0,0,0,,Шигуре мырза
Dialogue: 0,0:32:01.46,0:32:03.75,Default,,0,0,0,,Эй, Мусашино, сен жақсы жерге келдің.
Dialogue: 0,0:32:05.17,0:32:08.46,Default,,0,0,0,,Бұл мен бұрын айтқан Химура-дононың кеңсесіндегі Яхико-кун.
Dialogue: 0,0:32:08.63,0:32:10.09,Default,,0,0,0,,Қандай кездейсоқтық, Мусашино
Dialogue: 0,0:32:10.17,0:32:11.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:11.26,0:32:14.55,Default,,0,0,0,,Яхиконың әкесі де Шоғытай құрамында өлген көрінеді.
Dialogue: 0,0:32:14.84,0:32:16.18,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:32:16.51,0:32:19.89,Default,,0,0,0,,Мұсашиноның әкесі де Шоғытай құрамында қайтыс болды.
Dialogue: 0,0:32:20.10,0:32:20.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:21.64,0:32:23.31,Default,,0,0,0,,Бұл көп қиындық туғызса керек.
Dialogue: 0,0:32:23.90,0:32:25.10,Default,,0,0,0,,Біраздан соң—
Dialogue: 0,0:32:25.19,0:32:26.69,Default,,0,0,0,,Бірге қолдан келгеннің бәрін жасайық
Dialogue: 0,0:32:26.94,0:32:27.77,Default,,0,0,0,,Иә
Dialogue: 0,0:32:28.44,0:32:30.57,Default,,0,0,0,,Яхико Тамақты жеу жақсы.
Dialogue: 0,0:32:30.69,0:32:32.28,Default,,0,0,0,,Дұрыс, сен де шомыл.
Dialogue: 0,0:32:33.03,0:32:35.11,Default,,0,0,0,,Бұны өз үйің деп ойлауға болмайды.
Dialogue: 0,0:32:35.20,0:32:36.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:47.34,0:32:49.46,Default,,0,0,0,,Гентацу Такацуки
Dialogue: 0,0:33:02.60,0:33:05.69,Default,,0,0,0,,Сізге Шигуре деген қызық болуы керек.
Dialogue: 0,0:33:07.06,0:33:09.40,Default,,0,0,0,,Шигурэ Такими?
Dialogue: 0,0:33:15.15,0:33:19.12,Default,,0,0,0,,Сәлем! Яхико:қайда бара жатырсың? Сіз әлі жаттығуды аяқтаған жоқсыз, солай ма?
Dialogue: 0,0:33:19.20,0:33:22.25,Default,,0,0,0,,Хехе, бір сәт Сигурэ-санның орнына барайық.
Dialogue: 0,0:33:22.33,0:33:23.16,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:33:23.25,0:33:25.83,Default,,0,0,0,,Небір сымбатты, әдемі әйелдер бар, хехе.
Dialogue: 0,0:33:26.25,0:33:27.08,Default,,0,0,0,,Жолдан кет! Эй!
Dialogue: 0,0:33:27.63,0:33:29.59,Default,,0,0,0,,Қазірдің өзінде! Нақты не?
Dialogue: 0,0:33:30.84,0:33:32.17,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:33:33.42,0:33:34.84,Default,,0,0,0,,Сәлем! (Мусашино) Әй!
Dialogue: 0,0:33:35.76,0:33:37.55,Default,,0,0,0,,Менің жамбасым орнында емес (Яхико) Иә!
Dialogue: 0,0:33:38.68,0:33:39.85,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:33:40.10,0:33:40.93,Default,,0,0,0,,Ха!
Dialogue: 0,0:33:41.18,0:33:42.52,Default,,0,0,0,,Ауырды
Dialogue: 0,0:33:43.18,0:33:44.23,Default,,0,0,0,,Не болды?
Dialogue: 0,0:33:45.18,0:33:46.31,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:33:47.15,0:33:48.81,Default,,0,0,0,,Щетканы дұрыстап орнына қойыңыз.
Dialogue: 0,0:33:49.27,0:33:50.52,Default,,0,0,0,,Иә
Dialogue: 0,0:33:51.86,0:33:53.74,Default,,0,0,0,,Ах, Химура-сан
Dialogue: 0,0:33:55.36,0:33:56.90,Default,,0,0,0,,Өткен күн қалай болды?
Dialogue: 0,0:33:57.11,0:33:58.41,Default,,0,0,0,,Сіз крам мектебіндесіз бе?
Dialogue: 0,0:33:58.53,0:34:01.03,Default,,0,0,0,,Иә, бұл жай көшіру.
Dialogue: 0,0:34:01.45,0:34:02.54,Default,,0,0,0,,Шигурэ-доно ше?
Dialogue: 0,0:34:02.74,0:34:04.04,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:34:04.66,0:34:07.21,Default,,0,0,0,,Негізі мен кешеден бері үйге келген жоқпын.
Dialogue: 0,0:34:07.37,0:34:08.62,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:34:09.33,0:34:10.92,Default,,0,0,0,,Енді маған хабарлаңыз.
Dialogue: 0,0:34:11.04,0:34:14.88,Default,,0,0,0,,Ертең кешкі сағат 18:00-де ғибадатхананың жанындағы көпірде күтемін.
Dialogue: 0,0:34:16.38,0:34:18.55,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:34:19.68,0:34:20.60,Default,,0,0,0,,Сонымен
Dialogue: 0,0:34:21.68,0:34:23.89,Default,,0,0,0,,Мен де енді көбірек тырысуым керек сияқты!
Dialogue: 0,0:34:31.02,0:34:33.32,Default,,0,0,0,,Жоғары мәртебелі Ямагата, Армия лорд және
Dialogue: 0,0:34:33.40,0:34:36.40,Default,,0,0,0,,Мен өз пікірімді жоғары мәртебелі Каваджиге, полицияның бас супертендентіге бердім.
Dialogue: 0,0:34:37.03,0:34:38.53,Default,,0,0,0,,Тамано Не?
Dialogue: 0,0:34:39.07,0:34:39.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:34:40.16,0:34:42.78,Default,,0,0,0,,Мұны айту мен үшін емес, бірақ
Dialogue: 0,0:34:42.87,0:34:46.66,Default,,0,0,0,,Йокогамадағы Эгерес елшілігіне жақында жасалған шабуылға байланысты.
Dialogue: 0,0:34:46.83,0:34:49.37,Default,,0,0,0,,Токиодағы парад ертеңіне жақындап қалды
Dialogue: 0,0:34:49.58,0:34:52.13,Default,,0,0,0,,Қауіпсіздікті күшейту керек пе?
Dialogue: 0,0:34:55.30,0:34:56.80,Default,,0,0,0,,Сен де солай ойлайсың ба, Тамано?
Dialogue: 0,0:34:57.17,0:34:58.93,Default,,0,0,0,,Мазалайтын қозғалыстар болуы мүмкін.
Dialogue: 0,0:34:59.01,0:35:00.84,Default,,0,0,0,,Егер бұл орын алса, бұл Жапония үшін ұят болады.
Dialogue: 0,0:35:00.97,0:35:03.47,Default,,0,0,0,,Қауіпсіздікті күшейтіп, қызметкерлерді көбейтіңіз.
Dialogue: 0,0:35:03.55,0:35:06.85,Default,,0,0,0,,Осы мақсатта Армия лордтың тез арада бұйрықты өз қолына алса, мен риза болар едім.
Dialogue: 0,0:35:06.93,0:35:08.81,Default,,0,0,0,,Бұл жауынгерлердің рухын көтереді деп ойлаймын.
Dialogue: 0,0:35:09.19,0:35:10.10,Default,,0,0,0,,Хмм
Dialogue: 0,0:35:10.19,0:35:12.44,Default,,0,0,0,,Таманоның айтқанында шындық бар.
Dialogue: 0,0:35:12.56,0:35:13.44,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:35:13.52,0:35:16.32,Default,,0,0,0,,Тамано: Сіз де сол күні қауіпсіздікке жауапты боласыз.
Dialogue: 0,0:35:16.57,0:35:17.40,Default,,0,0,0,,Ха!
Dialogue: 0,0:35:24.53,0:35:26.29,Default,,0,0,0,,Асығыңыз! Мазасыз болмаңыз
Dialogue: 0,0:35:26.58,0:35:28.75,Default,,0,0,0,,Бүгін кешке бәрін әкел!
Dialogue: 0,0:35:30.79,0:35:32.04,Default,,0,0,0,,Каджики ше?
Dialogue: 0,0:35:32.17,0:35:33.42,Default,,0,0,0,,Іс жақсы жүріп жатыр.
Dialogue: 0,0:35:38.59,0:35:41.30,Default,,0,0,0,,Жарайды, Каджики, біз де ғибадатханаға барамыз.
Dialogue: 0,0:35:54.81,0:35:57.07,Default,,0,0,0,,Қазір барлық дайындық жұмыстары аяқталды.
Dialogue: 0,0:35:57.15,0:35:57.98,Default,,0,0,0,,О
Dialogue: 0,0:35:58.07,0:35:59.11,Default,,0,0,0,,Шигуре мырза
Dialogue: 0,0:36:00.32,0:36:01.78,Default,,0,0,0,,Барлығы орындалды
Dialogue: 0,0:36:01.86,0:36:03.41,Default,,0,0,0,,Түсіндім, бұл қиын жұмыс.
Dialogue: 0,0:36:06.45,0:36:07.29,Default,,0,0,0,,Полковник!
Dialogue: 0,0:36:12.96,0:36:14.21,Default,,0,0,0,,Барлығына сәттілік
Dialogue: 0,0:36:14.67,0:36:17.88,Default,,0,0,0,,Дайындық аяқталды, орындау ғана қалды.
Dialogue: 0,0:36:18.34,0:36:21.80,Default,,0,0,0,,Барлығымыз қоштасатын адамдар бар.
Dialogue: 0,0:36:23.09,0:36:26.01,Default,,0,0,0,,Ертең... Ертеңге дейін аяқтаңыз.
Dialogue: 0,0:36:30.81,0:36:32.02,Default,,0,0,0,,Сіз ояу болдыңыз ба?
Dialogue: 0,0:36:32.44,0:36:33.39,Default,,0,0,0,,Иә
Dialogue: 0,0:36:35.31,0:36:37.15,Default,,0,0,0,,Бұл тамақ ше?
Dialogue: 0,0:36:37.73,0:36:38.65,Default,,0,0,0,,Хмм
Dialogue: 0,0:36:39.57,0:36:43.24,Default,,0,0,0,,Токи ше? Менімен тамақтанғыңыз келе ме?
Dialogue: 0,0:36:51.70,0:36:53.41,Default,,0,0,0,,Мен біраз уақытқа саяхатқа шығамын.
Dialogue: 0,0:36:53.54,0:36:54.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:55.42,0:36:57.63,Default,,0,0,0,,Киото және Айзу
Dialogue: 0,0:36:57.71,0:36:59.17,Default,,0,0,0,,Мен де... (Сигур) Жоқ.
Dialogue: 0,0:37:00.80,0:37:02.42,Default,,0,0,0,,Үйде қалуыңызды өтінемін.
Dialogue: 0,0:37:02.55,0:37:04.22,Default,,0,0,0,,Бірақ... (Сигур) Хат жаз
Dialogue: 0,0:37:07.01,0:37:07.85,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:37:08.47,0:37:10.06,Default,,0,0,0,,Ауыстыруды сұрау (Токи) Иә
Dialogue: 0,0:37:13.56,0:37:16.65,Default,,0,0,0,,Мен сіздің үйдегі тағамды біраз уақыт жей алмаймын.
Dialogue: 0,0:37:29.99,0:37:30.83,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:37:31.20,0:37:34.04,Default,,0,0,0,,Соңғы бірнеше күнде олар жиі жиналатын сияқты.
Dialogue: 0,0:37:34.16,0:37:36.62,Default,,0,0,0,,Хмф, қозғалатын кез келді ме?
Dialogue: 0,0:37:41.88,0:37:43.42,Default,,0,0,0,,Сіз, Басшының орынбасары, қазір тергеу штабында қанша адам қалғанын білесіз ғой.
Dialogue: 0,0:37:44.72,0:37:46.01,Default,,0,0,0,,Ах Яхико
Dialogue: 0,0:37:46.84,0:37:47.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:48.93,0:37:50.51,Default,,0,0,0,,Сіз жақсы ересек адам болуыңыз керек.
Dialogue: 0,0:37:50.72,0:37:51.89,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:37:58.85,0:37:59.77,Default,,0,0,0,,Мен… мен жай…—
Dialogue: 0,0:38:00.65,0:38:04.15,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:38:04.94,0:38:06.20,Default,,0,0,0,,...
Dialogue: 0,0:38:06.86,0:38:07.86,Default,,0,0,0,,Кешіктіргеніміз үшін кешірім сұраймыз
Dialogue: 0,0:38:07.99,0:38:08.91,Default,,0,0,0,,Жоқ
Dialogue: 0,0:38:09.87,0:38:11.20,Default,,0,0,0,,Бұл дұрыс болды
Dialogue: 0,0:38:11.28,0:38:13.29,Default,,0,0,0,,Мен сені қайта көргім келді.
Dialogue: 0,0:38:13.95,0:38:17.83,Default,,0,0,0,,Токи-доно Шигурэ-доно үшін уайымдады.
Dialogue: 0,0:38:18.75,0:38:20.79,Default,,0,0,0,,Мырза, сіз не ойлап отырсыз?
Dialogue: 0,0:38:21.29,0:38:22.30,Default,,0,0,0,,Шигурэ-доно
Dialogue: 0,0:38:23.25,0:38:26.34,Default,,0,0,0,,Маған бірдеңе болса, Токи...
Dialogue: 0,0:38:28.09,0:38:30.14,Default,,0,0,0,,Бұл ұрыс! Бұл ұрыс!
Dialogue: 0,0:38:32.10,0:38:32.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:37.77,0:38:40.35,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе? Шигуре туралы
Dialogue: 0,0:38:40.60,0:38:43.52,Default,,0,0,0,,А, ол аздап қауіпті адам.
Dialogue: 0,0:38:43.65,0:38:44.53,Default,,0,0,0,,Мәміле қандай?
Dialogue: 0,0:38:46.11,0:38:48.90,Default,,0,0,0,,Шигуренің төңірегіне түрлі адамдар жиналды.
Dialogue: 0,0:38:51.20,0:38:53.49,Default,,0,0,0,,Шоғытайдың тірі қалғандары және туыстары
Dialogue: 0,0:38:55.91,0:38:57.46,Default,,0,0,0,,Айзу соғысынан аман қалғандар
Dialogue: 0,0:38:58.54,0:39:00.50,Default,,0,0,0,,Хакодате соғысынан аман қалғандар
Dialogue: 0,0:39:01.08,0:39:04.17,Default,,0,0,0,,Жарайды, қазіргі билікке наразы адамдар.
Dialogue: 0,0:39:08.59,0:39:09.51,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:39:09.68,0:39:11.26,Default,,0,0,0,,Шигуренің танымалдығы болса керек
Dialogue: 0,0:39:11.34,0:39:12.30,Default,,0,0,0,,Танымалдығы?
Dialogue: 0,0:39:13.10,0:39:15.85,Default,,0,0,0,,Кез келген нәрсе Шигурэ Эдо кезеңінің соңында болды.
Dialogue: 0,0:39:15.93,0:39:18.85,Default,,0,0,0,,Жас және бақытсыз қайтыс болғандардың отбасына бару.
Dialogue: 0,0:39:18.93,0:39:20.81,Default,,0,0,0,,Ол кеңесіп жатқан сияқты.
Dialogue: 0,0:39:20.98,0:39:23.48,Default,,0,0,0,,Әрине, оның ішінде ақша мен ақша мәселесі.
Dialogue: 0,0:39:23.56,0:39:24.44,Default,,0,0,0,,Хо
Dialogue: 0,0:39:24.94,0:39:27.44,Default,,0,0,0,,Қалай болғанда да, әлдебір мазасыз қимылдар бар деген қауесет бар.
Dialogue: 0,0:39:28.57,0:39:32.37,Default,,0,0,0,,Алайда мұның өзі Шигуренің күнәсі деп айтатындар да болды.
Dialogue: 0,0:39:32.49,0:39:33.99,Default,,0,0,0,,Бұл ұят
Dialogue: 0,0:39:34.41,0:39:36.83,Default,,0,0,0,,Шынында да қауіпті жаңбыр емес.
Dialogue: 0,0:39:36.95,0:39:39.33,Default,,0,0,0,,Айналасында адамдар бар сияқты.
Dialogue: 0,0:39:47.30,0:39:50.01,Default,,0,0,0,,Яхико, сен жақсы ересек адам болуың керек.
Dialogue: 0,0:39:51.34,0:39:54.55,Default,,0,0,0,,Үлкенге сыйлы болу деген нені білдіреді?
Dialogue: 0,0:39:56.01,0:39:56.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:56.93,0:39:57.77,Default,,0,0,0,,Керемет?
Dialogue: 0,0:39:57.97,0:39:58.81,Default,,0,0,0,,Оро?
Dialogue: 0,0:39:58.89,0:40:00.23,Default,,0,0,0,,Сіз ересексіз бе?
Dialogue: 0,0:40:00.85,0:40:02.52,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:40:06.32,0:40:07.94,Default,,0,0,0,,Мусашино мырза?
Dialogue: 0,0:40:09.03,0:40:10.07,Default,,0,0,0,,Не?
Dialogue: 0,0:40:26.54,0:40:28.96,Default,,0,0,0,,Ақырында оянатын уақыт келді
Dialogue: 0,0:40:29.55,0:40:31.97,Default,,0,0,0,,Сіздің тілектеріңізді орындайтын уақыт келді.
Dialogue: 0,0:40:32.51,0:40:36.68,Default,,0,0,0,,Біздің қарақшы әскеріміз деп стигматизациялану, достарымыздан айырылып, ұятқа қалу.
Dialogue: 0,0:40:37.14,0:40:39.77,Default,,0,0,0,,Жаңа үкімет оны жау ретінде қарастырды
Dialogue: 0,0:40:44.69,0:40:46.94,Default,,0,0,0,,Айзу Шикари Шогитай Шикари!
Dialogue: 0,0:40:47.27,0:40:48.77,Default,,0,0,0,,О!
Dialogue: 0,0:40:55.95,0:40:56.91,Default,,0,0,0,,Саносуке
Dialogue: 0,0:40:58.91,0:41:00.12,Default,,0,0,0,,Оу Кеншин
Dialogue: 0,0:41:00.41,0:41:01.66,Default,,0,0,0,,Сасаюки, сен мұнда не үшін келдің?
Dialogue: 0,0:41:01.75,0:41:04.71,Default,,0,0,0,,Шигуреге қатысты қызықты мәліметтер болды.
Dialogue: 0,0:41:05.12,0:41:06.71,Default,,0,0,0,,Тек көз жеткізу үшін
Dialogue: 0,0:41:07.08,0:41:10.84,Default,,0,0,0,,Дегенмен, қазіргі Мэйдзи үкіметі саясат пен бизнеске байланысты.
Dialogue: 0,0:41:11.05,0:41:13.92,Default,,0,0,0,,Пара дегеннің бәрі бар!
Dialogue: 0,0:41:14.97,0:41:17.47,Default,,0,0,0,,Менің марқұм жолдасым Гентацу Такацуки айтқандай,
Dialogue: 0,0:41:17.93,0:41:20.76,Default,,0,0,0,,Көк аспан мәңгілік биік, ашық болуы керек.
Dialogue: 0,0:41:21.14,0:41:23.68,Default,,0,0,0,,Ал оның астында халық тең
Dialogue: 0,0:41:23.81,0:41:25.44,Default,,0,0,0,,Осындай әлемді жасаңыз!
Dialogue: 0,0:41:25.77,0:41:27.06,Default,,0,0,0,,О!
Dialogue: 0,0:41:27.15,0:41:30.94,Default,,0,0,0,,Туымызды көтерсек, Жапонияның түкпір-түкпірінен қанағаттанбаған элементтер жиналады.
Dialogue: 0,0:41:31.15,0:41:33.44,Default,,0,0,0,,Мэйдзи қалпына келтіруді қайтадан бастаңыз.
Dialogue: 0,0:41:34.11,0:41:35.95,Default,,0,0,0,,Жаңа қалпына келтіру!
Dialogue: 0,0:41:37.91,0:41:38.74,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:41:42.08,0:41:43.70,Default,,0,0,0,,Сіз мұны естідіңіз!
Dialogue: 0,0:41:44.50,0:41:46.83,Default,,0,0,0,,Мен сенің әңгімеңді естігеннен кейін, мен сені тірі қалдыра алмаймын!
Dialogue: 0,0:41:47.58,0:41:48.42,Default,,0,0,0,,Яхико
Dialogue: 0,0:41:48.63,0:41:50.09,Default,,0,0,0,,Кесу! (Сигур) Күте тұрыңыз.
Dialogue: 0,0:41:50.46,0:41:53.51,Default,,0,0,0,,Шигурэ-сан, мені де қосшы.
Dialogue: 0,0:41:53.80,0:41:55.72,Default,,0,0,0,,Не? (Яхико) Өтінемін!
Dialogue: 0,0:41:56.38,0:41:59.80,Default,,0,0,0,,Шоғытай болып өлген әкемнің жауын түсіруге рұқсат етіңізші.
Dialogue: 0,0:41:59.97,0:42:01.01,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:42:01.10,0:42:02.18,Default,,0,0,0,,Яхико
Dialogue: 0,0:42:03.14,0:42:06.02,Default,,0,0,0,,Шигуре мырза, мен де бір жақсылық сұрайын деп едім.
Dialogue: 0,0:42:06.14,0:42:07.14,Default,,0,0,0,,Мусашино мырза
Dialogue: 0,0:42:08.94,0:42:10.65,Default,,0,0,0,,Айзу соғысынан аман қалғандар
Dialogue: 0,0:42:10.94,0:42:12.65,Default,,0,0,0,,Шоғытайдан аман қалғандар?
Dialogue: 0,0:42:13.11,0:42:15.57,Default,,0,0,0,,А, адамдар аз сияқты.
Dialogue: 0,0:42:15.69,0:42:16.70,Default,,0,0,0,,О... эй! Кеншин
Dialogue: 0,0:42:19.41,0:42:20.49,Default,,0,0,0,,Ах, Химура-сан.
Dialogue: 0,0:42:20.87,0:42:23.49,Default,,0,0,0,,Химура мырза, Шигурэ ше? Шигуре қайда?
Dialogue: 0,0:42:24.45,0:42:26.00,Default,,0,0,0,,Бар емес пе? (Кеншин) А?
Dialogue: 0,0:42:26.50,0:42:28.58,Default,,0,0,0,,Ертерек байқасам
Dialogue: 0,0:42:29.04,0:42:31.13,Default,,0,0,0,,Гендацу мемориалдық тақтасының көлеңкесінде бұл
Dialogue: 0,0:42:31.25,0:42:32.84,Default,,0,0,0,,Мен оны көре аламын ба?
Dialogue: 0,0:42:33.25,0:42:34.21,Default,,0,0,0,,Иә
Dialogue: 0,0:42:36.47,0:42:38.97,Default,,0,0,0,,Гэндацуға берген уәдемді орындайтын кез келді.
Dialogue: 0,0:42:39.13,0:42:41.35,Default,,0,0,0,,Қош бол, бақытты бол
Dialogue: 0,0:42:41.60,0:42:44.22,Default,,0,0,0,,Егер сізге бірдеңе керек болса, Химура-донодан сұраңыз.
Dialogue: 0,0:42:45.18,0:42:46.48,Default,,0,0,0,,Сәлем! Сонымен...
Dialogue: 0,0:42:46.56,0:42:48.14,Default,,0,0,0,,Барлығы, сен неге мұндасың?
Dialogue: 0,0:42:48.56,0:42:50.98,Default,,0,0,0,,Каору-доно, мүмкін Яхико шығар?
Dialogue: 0,0:42:53.36,0:42:55.65,Default,,0,0,0,,Яхико, Яхико қайтып келген жоқ.
Dialogue: 0,0:42:55.73,0:42:57.61,Default,,0,0,0,,Менің ойымша, сіз осындасыз.
Dialogue: 0,0:42:58.24,0:43:03.20,Default,,0,0,0,,Яхиконы табу Шигурені табу дегенге ұқсайды.
Dialogue: 0,0:43:10.83,0:43:12.04,Default,,0,0,0,,(Бенедикт) Бұл миссияның қаншалықты маңызды екенін көрсетеді.
Dialogue: 0,0:43:13.38,0:43:14.42,Default,,0,0,0,,Бірақ
Dialogue: 0,0:43:16.88,0:43:18.63,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:43:41.74,0:43:44.12,Default,,0,0,0,,Алдыңғы әскерлер қазірдің өзінде әртүрлі жерлерде жасырынып жатыр.
Dialogue: 0,0:43:44.33,0:43:46.04,Default,,0,0,0,,Мен сіздің жұмысыңызды асыға күтемін.
Dialogue: 0,0:43:47.16,0:43:48.04,Default,,0,0,0,,Яхико
Dialogue: 0,0:43:48.79,0:43:49.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:50.96,0:43:52.12,Default,,0,0,0,,Не ол?
Dialogue: 0,0:43:52.46,0:43:55.63,Default,,0,0,0,,Яхико, мен сенің рухыңа қуаныштымын.
Dialogue: 0,0:43:56.50,0:43:57.67,Default,,0,0,0,,Рахмет
Dialogue: 0,0:43:59.26,0:44:00.30,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:44:01.55,0:44:02.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:07.56,0:44:08.64,Default,,0,0,0,,Шигуре мырза!
Dialogue: 0,0:44:09.18,0:44:10.68,Default,,0,0,0,,Яхико әлі бала.
Dialogue: 0,0:44:11.23,0:44:12.90,Default,,0,0,0,,Ал егер Яхикоға бірдеңе болса ше?
Dialogue: 0,0:44:13.48,0:44:16.07,Default,,0,0,0,,Мен Химура мырзадан кешірім сұрай алмаймын.
Dialogue: 0,0:44:16.77,0:44:18.03,Default,,0,0,0,,Шигуре мырза
Dialogue: 0,0:44:22.11,0:44:23.45,Default,,0,0,0,,Кешіріңіз, Яхико
Dialogue: 0,0:44:24.62,0:44:26.20,Default,,0,0,0,,Мен алдын ала дайындаламын.
Dialogue: 0,0:44:26.28,0:44:27.58,Default,,0,0,0,,Түсіндіңіз
Dialogue: 0,0:44:27.74,0:44:29.04,Default,,0,0,0,,Біз де барайық (Мусашино) Иә
Dialogue: 0,0:45:00.32,0:45:01.74,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Каджики.
Dialogue: 0,0:45:06.07,0:45:07.24,Default,,0,0,0,,Ха! Кешіріңіз
Dialogue: 0,0:45:07.49,0:45:09.74,Default,,0,0,0,,Бірақ сіздің арқаңызда бәрі жақсы.
Dialogue: 0,0:45:09.99,0:45:13.29,Default,,0,0,0,,Әскердің қару-жарағын ұрлау үшін көп күш жұмсалды.
Dialogue: 0,0:45:14.87,0:45:15.71,Default,,0,0,0,,Сәлем
Dialogue: 0,0:45:16.21,0:45:19.25,Default,,0,0,0,,Бұл ертеңгі парадтың маршруты мен қауіпсіздік схемасы.
Dialogue: 0,0:45:19.80,0:45:21.00,Default,,0,0,0,,Шигуре ше?
Dialogue: 0,0:45:21.13,0:45:23.97,Default,,0,0,0,,Олар біз туралы ештеңе байқамайтын сияқты.
Dialogue: 0,0:45:24.80,0:45:26.43,Default,,0,0,0,,Соңына дейін байқамау
Dialogue: 0,0:45:26.51,0:45:27.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:45:27.76,0:45:29.97,Default,,0,0,0,,Шабуылдың орны туралы не айтасыз?
Dialogue: 0,0:45:30.43,0:45:33.98,Default,,0,0,0,,Иә, мен жай ғана қатысы жоқ адамдарды тартқым келмейді.
Dialogue: 0,0:45:34.35,0:45:37.60,Default,,0,0,0,,Ха, осындай тазалық тек көзге түседі.
Dialogue: 0,0:45:37.69,0:45:39.65,Default,,0,0,0,,Бұл заманда жұмыс істемейді.
Dialogue: 0,0:45:40.82,0:45:43.99,Default,,0,0,0,,Жақсы, жақсы. Мен қауіпсіздік қызметкерлерін бөлемін.
Dialogue: 0,0:45:44.28,0:45:45.74,Default,,0,0,0,,Мен мұны бағалаймын.
Dialogue: 0,0:45:45.90,0:45:50.16,Default,,0,0,0,,сәйкес, қауіпсіздікке жауапты адам мен күткендей Ямагата болды.
Dialogue: 0,0:45:50.33,0:45:52.95,Default,,0,0,0,,Ендеше, мұндай жерде мемлекеттік қонақ өлтірілсе ше?
Dialogue: 0,0:45:53.33,0:45:55.75,Default,,0,0,0,,Сонымен қатар, армия қарулары қолданылды.
Dialogue: 0,0:45:56.25,0:45:58.17,Default,,0,0,0,,Ямагата статусы т.б. желге ұшып кетті
Dialogue: 0,0:45:58.33,0:46:00.71,Default,,0,0,0,,Егер бұл орын алса, келесі әскер басшысы болады
Dialogue: 0,0:46:01.21,0:46:02.67,Default,,0,0,0,,Барон Таманода
Dialogue: 0,0:46:04.13,0:46:06.68,Default,,0,0,0,,Ескі қарияларды тақтан түсіру.
Dialogue: 0,0:46:06.76,0:46:08.59,Default,,0,0,0,,Бірден менің уақытым
Dialogue: 0,0:46:09.01,0:46:10.60,Default,,0,0,0,,Не болды?
Dialogue: 0,0:46:11.05,0:46:13.93,Default,,0,0,0,,Егерестен келген мемлекет қонағын міндетті түрде өлтіріңіз.
Dialogue: 0,0:46:14.68,0:46:16.44,Default,,0,0,0,,Ха! Барон Тамано
Dialogue: 0,0:46:16.94,0:46:19.61,Default,,0,0,0,,Егер бұл жұмыс істесе, мен ше?
Dialogue: 0,0:46:20.19,0:46:22.69,Default,,0,0,0,,Әрине, ол үкіметтің жоғары лауазымды мүшесі.
Dialogue: 0,0:46:22.98,0:46:24.86,Default,,0,0,0,,Мен бұл жолы жеңімпаз атқа мінгім келеді.
Dialogue: 0,0:46:24.94,0:46:25.78,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:46:26.57,0:46:29.70,Default,,0,0,0,,Фухахахаха...
Dialogue: 0,0:46:40.17,0:46:43.71,Default,,0,0,0,,Ха, әлгі бейбақ қайда кетті?
Dialogue: 0,0:46:44.13,0:46:47.09,Default,,0,0,0,,Түні бойы ештеңе білмей серуендейсің бе?
Dialogue: 0,0:46:48.68,0:46:50.97,Default,,0,0,0,,Токи-сан, жақсысың ба? (Токи) Иә.
Dialogue: 0,0:46:52.14,0:46:52.97,Default,,0,0,0,,Яхико
Dialogue: 0,0:46:53.72,0:46:55.02,Default,,0,0,0,,Ах (Каору) Токи-сан!
Dialogue: 0,0:46:56.31,0:46:57.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:58.35,0:46:59.44,Default,,0,0,0,,Яхико
Dialogue: 0,0:47:00.27,0:47:02.52,Default,,0,0,0,,Яхико... Яхико!
Dialogue: 0,0:47:03.69,0:47:06.15,Default,,0,0,0,,Әй, қайда болдың!
Dialogue: 0,0:47:07.03,0:47:09.74,Default,,0,0,0,,Барлығы уайымдады.
Dialogue: 0,0:47:16.50,0:47:17.37,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:47:19.29,0:47:20.87,Default,,0,0,0,,Өзімшіл ештеңе жасамаңыз.
Dialogue: 0,0:47:26.42,0:47:29.01,Default,,0,0,0,,Өйткені мен қатты уайымдадым.
Dialogue: 0,0:47:29.42,0:47:31.80,Default,,0,0,0,,Біз бәріміз сені іздедік.
Dialogue: 0,0:47:32.47,0:47:34.93,Default,,0,0,0,,Сен өлсең мен не істеуім керек?
Dialogue: 0,0:47:35.18,0:47:36.31,Default,,0,0,0,,Яхико…
Dialogue: 0,0:47:38.35,0:47:39.43,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,0:47:39.85,0:47:41.98,Default,,0,0,0,,Егер ханым мені ұрмаған болса
Dialogue: 0,0:47:42.19,0:47:44.02,Default,,0,0,0,,Міне, мен сені жұдырықтаймын.
Dialogue: 0,0:47:44.31,0:47:46.44,Default,,0,0,0,,Менің де қолымнан келеді, Яхико.
Dialogue: 0,0:47:47.11,0:47:48.36,Default,,0,0,0,,Штаб оның шамамен төрт айда сегіз «Стелла» жинайтынын болжайды, бірақ
Dialogue: 0,0:47:48.99,0:47:50.70,Default,,0,0,0,,Шигуре қайда кетті?
Dialogue: 0,0:47:51.03,0:47:51.99,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:47:53.62,0:47:56.54,Default,,0,0,0,,Бұл маңызды. Жердің қай жерінде?
Dialogue: 0,0:47:56.66,0:47:59.25,Default,,0,0,0,,Рас, артта қалдым.
Dialogue: 0,0:47:59.71,0:48:02.87,Default,,0,0,0,,Эй, Яхико, Шигурэ және басқалары бірдеңе деді ме?
Dialogue: 0,0:48:03.88,0:48:05.17,Default,,0,0,0,,Тіпті егер солай десең де
Dialogue: 0,0:48:05.25,0:48:06.38,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:48:06.75,0:48:07.92,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:48:08.01,0:48:10.47,Default,,0,0,0,,Егер сіз бірдеңе білсеңіз, маған хабарлаңыз.
Dialogue: 0,0:48:10.97,0:48:13.80,Default,,0,0,0,,Яхико-сан Каору-сан, Химура-сан және т.б
Dialogue: 0,0:48:13.89,0:48:15.68,Default,,0,0,0,,Өте маңызды адам сияқты
Dialogue: 0,0:48:15.80,0:48:16.89,Default,,0,0,0,,Шигуре
Dialogue: 0,0:48:17.01,0:48:20.52,Default,,0,0,0,,Шигуре мен үшін ең маңызды адам!
Dialogue: 0,0:48:21.18,0:48:23.02,Default,,0,0,0,,Өтінемін! Яхико мырза
Dialogue: 0,0:48:23.73,0:48:25.81,Default,,0,0,0,,Яхико, есіңде бірдеңе жоқ па?
Dialogue: 0,0:48:25.90,0:48:26.90,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:48:27.11,0:48:27.94,Default,,0,0,0,,Яхико
Dialogue: 0,0:48:29.36,0:48:31.28,Default,,0,0,0,,Әй, мемлекеттік қонаққа не болды?
Dialogue: 0,0:48:31.65,0:48:32.65,Default,,0,0,0,,Мемлекеттік қонақ?
Dialogue: 0,0:48:32.82,0:48:33.82,Default,,0,0,0,,Мемлекеттік қонақ?
Dialogue: 0,0:48:33.91,0:48:36.91,Default,,0,0,0,,Бүгін Токиоға Егерестен мемлекеттік қонақ келеді.
Dialogue: 0,0:48:38.08,0:48:41.54,Default,,0,0,0,,Иә, үлкен шеру болады деген арнайы басылым болды.
Dialogue: 0,0:48:42.33,0:48:43.87,Default,,0,0,0,,Сіз мемлекеттік қонақсыз ба?
Dialogue: 0,0:48:44.25,0:48:45.29,Default,,0,0,0,,Химура-сан!
Dialogue: 0,0:48:45.50,0:48:47.04,Default,,0,0,0,,Жаңбырды тоқтатыңызшы
Dialogue: 0,0:48:48.21,0:48:49.30,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:48:50.17,0:48:51.30,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:48:52.63,0:48:54.59,Default,,0,0,0,,Ух... өтінемін...
Dialogue: 0,0:48:59.31,0:49:04.31,Default,,0,0,0,,(Наурыздағы қойылым)
Dialogue: 0,0:49:20.91,0:49:23.71,Default,,0,0,0,,Сонда да керемет.
Dialogue: 0,0:49:24.16,0:49:28.54,Default,,0,0,0,,Бұл үкіметтің ел астанасы Токиоға мемлекеттік қонақты алғаш рет қарсы алуы.
Dialogue: 0,0:49:28.84,0:49:31.59,Default,,0,0,0,,Оқиғасыз бітпесе, қиналамын.
Dialogue: 0,0:49:42.52,0:49:45.19,Default,,0,0,0,,Олар қозғалғанда, бұл олардың жалғыз мақсаты.
Dialogue: 0,0:49:45.31,0:49:46.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:49:55.90,0:49:58.82,Default,,0,0,0,,Армия мырзасы, сіз оны аман-есен жеткізген сияқтысыз.
Dialogue: 0,0:49:59.41,0:50:00.41,Default,,0,0,0,,О
Dialogue: 0,0:50:03.25,0:50:07.29,Default,,0,0,0,,Я, сен енді армия лорд бола аласың.
Dialogue: 0,0:50:07.92,0:50:11.21,Default,,0,0,0,,Өз миссияңызды орындауға тым жалқау болғаныңыз үшін өзіңізді кінәлаңыз.
Dialogue: 0,0:50:18.01,0:50:18.84,Default,,0,0,0,,Жарайды
Dialogue: 0,0:50:19.30,0:50:20.85,Default,,0,0,0,,Иә
Dialogue: 0,0:50:30.94,0:50:31.82,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:50:47.00,0:50:49.04,Default,,0,0,0,,Асығыңыз! (Ямагата) Мемлекеттік қонақты қорғаңыз!
Dialogue: 0,0:50:52.21,0:50:54.21,Default,,0,0,0,,Не? Бұл түтін қонақ үйден шыққан.
Dialogue: 0,0:50:54.30,0:50:55.13,Default,,0,0,0,,Цк
Dialogue: 0,0:50:56.21,0:50:57.97,Default,,0,0,0,,Бірақ бұл демондарға да қатысты.
Dialogue: 0,0:51:05.47,0:51:06.60,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:51:14.15,0:51:15.03,Default,,0,0,0,,Майор аман-есен!
Dialogue: 0,0:51:19.40,0:51:20.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:26.04,0:51:27.62,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:51:32.96,0:51:34.04,Default,,0,0,0,,Жолдан кет! Жолдан кет!
Dialogue: 0,0:51:36.51,0:51:38.84,Default,,0,0,0,,Осы арқылы біз қалпына келтіруді жариялаймыз!
Dialogue: 0,0:51:39.38,0:51:41.09,Default,,0,0,0,,Шигуре мырза! Шигуре-сан!
Dialogue: 0,0:51:41.43,0:51:42.76,Default,,0,0,0,,Шигуре мырза! Шигуре-сан!
Dialogue: 0,0:51:48.93,0:51:49.77,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:51:52.69,0:51:54.19,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:51:55.73,0:51:57.28,Default,,0,0,0,,Ең дұрысы, бір-біріңді өлтіріңдер.
Dialogue: 0,0:52:03.53,0:52:05.24,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:52:10.66,0:52:12.04,Default,,0,0,0,,Жарайды, мен саған тағы бір оқ беремін.
Dialogue: 0,0:52:12.12,0:52:13.38,Default,,0,0,0,,Уедди.
Dialogue: 0,0:52:16.25,0:52:17.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:25.51,0:52:26.85,Default,,0,0,0,,Мемлекеттік қонаққа не болды?
Dialogue: 0,0:52:28.56,0:52:30.27,Default,,0,0,0,,Мемлекеттік қонақ сонда!
Dialogue: 0,0:52:39.69,0:52:40.90,Default,,0,0,0,,Біреу өлсін
Dialogue: 0,0:52:41.40,0:52:42.65,Default,,0,0,0,,О!
Dialogue: 0,0:52:45.70,0:52:46.58,Default,,0,0,0,,Не?
Dialogue: 0,0:52:52.71,0:52:53.79,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:52:54.46,0:52:55.63,Default,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,0:52:55.75,0:52:57.54,Default,,0,0,0,,Мен дереу әскерлерімді шығаруым керек.
Dialogue: 0,0:52:57.63,0:52:58.55,Default,,0,0,0,,Жолдан кет! Гимура
Dialogue: 0,0:52:59.09,0:53:01.17,Default,,0,0,0,,Оның кетуі мүмкін емес.
Dialogue: 0,0:53:01.46,0:53:02.72,Default,,0,0,0,,Онда өлтір!
Dialogue: 0,0:53:07.72,0:53:09.01,Default,,0,0,0,,Бұл кері жүзді қылыш па?
Dialogue: 0,0:53:09.18,0:53:12.02,Default,,0,0,0,,Мен сенімен қылыш айқастырғым келмеді.
Dialogue: 0,0:53:12.89,0:53:14.94,Default,,0,0,0,,Мен үшін де солай.
Dialogue: 0,0:53:15.35,0:53:17.40,Default,,0,0,0,,Бірақ бұл енді маңызды емес!
Dialogue: 0,0:53:19.86,0:53:20.69,Default,,0,0,0,,Уф!
Dialogue: 0,0:53:28.83,0:53:29.66,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:53:31.79,0:53:32.95,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:53:36.83,0:53:39.67,Default,,0,0,0,,Бұлай істеудің мәні неде?
Dialogue: 0,0:53:39.92,0:53:41.76,Default,,0,0,0,,Читтаа, басыңды пайдалан!
Dialogue: 0,0:54:03.03,0:54:03.86,Default,,0,0,0,,Ахх!
Dialogue: 0,0:54:04.44,0:54:05.95,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:54:15.83,0:54:16.92,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:54:25.38,0:54:26.93,Default,,0,0,0,,Гендацу Гэндацу ше?
Dialogue: 0,0:54:34.98,0:54:36.69,Default,,0,0,0,,Гендацу!
Dialogue: 0,0:54:48.57,0:54:51.07,Default,,0,0,0,,Гендацу!
Dialogue: 0,0:54:55.25,0:54:56.16,Default,,0,0,0,,Бұл сен бе!
Dialogue: 0,0:55:00.88,0:55:02.42,Default,,0,0,0,,Сайки Канума стилі?
Dialogue: 0,0:55:03.29,0:55:04.30,Default,,0,0,0,,Мені кешір!
Dialogue: 0,0:55:05.88,0:55:07.05,Default,,0,0,0,,Хааах!
Dialogue: 0,0:55:09.38,0:55:10.34,Default,,0,0,0,,Даа!
Dialogue: 0,0:55:11.85,0:55:13.10,Default,,0,0,0,,Мемлекет қонақ ішке кірсін!
Dialogue: 0,0:55:13.22,0:55:14.47,Default,,0,0,0,,Асығыңыз! Асықшы!
Dialogue: 0,0:55:14.85,0:55:16.14,Default,,0,0,0,,Ат, ат!
Dialogue: 0,0:55:33.07,0:55:34.28,Default,,0,0,0,,(Балға ату дыбысы)
Dialogue: 0,0:55:34.83,0:55:35.66,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:55:42.46,0:55:43.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:46.34,0:55:47.17,Default,,0,0,0,,Мусашино!
Dialogue: 0,0:55:48.17,0:55:49.92,Default,,0,0,0,,Шигуре мырза
Dialogue: 0,0:55:50.68,0:55:53.18,Default,,0,0,0,,Мен... өтінемін.
Dialogue: 0,0:55:53.68,0:55:54.85,Default,,0,0,0,,Мусашино!
Dialogue: 0,0:55:57.35,0:55:58.60,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:56:01.14,0:56:03.44,Default,,0,0,0,,Қанаттарыңызды қатайтыңыз. Бір адамның да қашып кетуіне жол бермеңіз!
Dialogue: 0,0:56:04.40,0:56:06.23,Default,,0,0,0,,Шигурэ-сан, тезірек!
Dialogue: 0,0:56:08.36,0:56:10.65,Default,,0,0,0,,Мен оны міндетті түрде шешемін!
Dialogue: 0,0:56:19.62,0:56:20.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:32.13,0:56:33.89,Default,,0,0,0,,Не...не?
Dialogue: 0,0:56:37.22,0:56:40.14,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:56:40.35,0:56:41.23,Default,,0,0,0,,Яхико?
Dialogue: 0,0:56:48.48,0:56:49.32,Default,,0,0,0,,Ах
Dialogue: 0,0:56:56.03,0:56:57.24,Default,,0,0,0,,Мусашино мырза
Dialogue: 0,0:56:58.28,0:56:59.70,Default,,0,0,0,,Мусашино мырза!
Dialogue: 0,0:57:00.04,0:57:02.29,Default,,0,0,0,,Мусашино мырза! Мусашино мырза!
Dialogue: 0,0:57:02.66,0:57:04.08,Default,,0,0,0,,Мусашино мырза!
Dialogue: 0,0:57:06.17,0:57:08.09,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,0:57:08.71,0:57:10.63,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:57:11.13,0:57:14.22,Default,,0,0,0,,Мусашино мырза! Мусашино мырза!
Dialogue: 0,0:57:35.07,0:57:36.20,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:57:37.95,0:57:39.33,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:58:17.57,0:58:19.03,Default,,0,0,0,,Хитокири Гендацу!
Dialogue: 0,0:58:19.16,0:58:22.70,Default,,0,0,0,,Біз сол кезде өмірімізді қатерге тігіп, қылыш айқастырдық.
Dialogue: 0,0:58:26.04,0:58:28.75,Default,,0,0,0,,Бұл, бәлкім, мұндай жағдайдың қайталанбауы үшін.
Dialogue: 0,0:58:29.67,0:58:32.96,Default,,0,0,0,,Енді қайғы жоқ.
Dialogue: 0,0:58:34.96,0:58:35.88,Default,,0,0,0,,Кеншин
Dialogue: 0,0:58:52.40,0:58:53.73,Default,,0,0,0,,Гендацуден
Dialogue: 0,0:58:55.94,0:58:59.61,Default,,0,0,0,,Қандай жағдай болмасын, мен ол адамды тоқтата аламын.
Dialogue: 0,0:59:08.00,0:59:12.00,Default,,0,0,0,,
Dialogue: 0,0:59:13.71,0:59:17.05,Default,,0,0,0,,Әскер мырзасы, бұл біздің әскердің қаруы.
Dialogue: 0,0:59:17.13,0:59:18.05,Default,,0,0,0,,О
Dialogue: 0,0:59:18.13,0:59:20.47,Default,,0,0,0,,Көтерілісшілер неліктен әскер қаруын қолданды?
Dialogue: 0,0:59:20.89,0:59:21.72,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:59:22.35,0:59:24.26,Default,,0,0,0,,Қат! Олар сәтсіздікке ұшырады.
Dialogue: 0,0:59:28.18,0:59:30.90,Default,,0,0,0,,Көтерілісшілер Уэно тауларында тосқауыл қойды.
Dialogue: 0,0:59:31.23,0:59:32.23,Default,,0,0,0,,Не?
Dialogue: 0,0:59:32.31,0:59:34.86,Default,,0,0,0,,Сіз Уэнодасыз ба? Шоғытай сияқты
Dialogue: 0,0:59:34.94,0:59:35.78,Default,,0,0,0,,Хмм
Dialogue: 0,0:59:36.44,0:59:39.20,Default,,0,0,0,,Олар қазір аймақты қоршап, бақылауда.
Dialogue: 0,0:59:39.28,0:59:40.28,Default,,0,0,0,,Әскерлердің мырзасы!
Dialogue: 0,0:59:41.20,0:59:45.95,Default,,0,0,0,,Әскер мырзасы, мен көтерілісшілер әскерін бір соққымен талқандаймын.
Dialogue: 0,0:59:46.12,0:59:47.33,Default,,0,0,0,,Хмм
Dialogue: 0,0:59:47.50,0:59:48.41,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:59:49.54,0:59:50.83,Default,,0,0,0,,Күтейік
Dialogue: 0,0:59:51.54,0:59:52.54,Default,,0,0,0,,Не? Сіз
Dialogue: 0,0:59:53.38,0:59:55.13,Default,,0,0,0,,Мені кім деп ойлайсың?
Dialogue: 0,0:59:56.00,0:59:58.63,Default,,0,0,0,,Мен Тамано, гвардиялық армияның баронымын.
Dialogue: 0,0:59:58.72,1:00:00.80,Default,,0,0,0,,Оның үстіне бұл әскер қожасының алдында.
Dialogue: 0,1:00:03.22,1:00:05.76,Default,,0,0,0,,Тамано, қолыңды менен ал.
Dialogue: 0,1:00:10.23,1:00:11.27,Default,,0,0,0,,Ямагата мырза
Dialogue: 0,1:00:11.60,1:00:14.31,Default,,0,0,0,,Гимура: Сіз не көріп тұрсыз.
Dialogue: 0,1:00:14.44,1:00:16.48,Default,,0,0,0,,Егер бұл шұғыл емес болса, кейінірек істей аламын ба?
Dialogue: 0,1:00:16.90,1:00:18.82,Default,,0,0,0,,Мен жан-жақты шабуылды күткім келеді.
Dialogue: 0,1:00:18.90,1:00:19.74,Default,,0,0,0,,Не?
Dialogue: 0,1:00:19.94,1:00:23.99,Default,,0,0,0,,Көтерілісшілер отрядын басқаратын адам, мен туралы аздап білетін адам.
Dialogue: 0,1:00:24.45,1:00:25.37,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:25.45,1:00:27.74,Default,,0,0,0,,Ал... Мен жалғыз отырғаныма сене алар емеспін.
Dialogue: 0,1:00:30.00,1:00:31.25,Default,,0,0,0,,Бұл күлкілі!
Dialogue: 0,1:00:31.37,1:00:33.33,Default,,0,0,0,,Мен өз отбасымды ұятқа қалдыратын сияқтымын.
Dialogue: 0,1:00:33.46,1:00:36.29,Default,,0,0,0,,Армия қаруын көтерілісшілер қолданады.
Dialogue: 0,1:00:36.96,1:00:38.96,Default,,0,0,0,,Бұл аласапыранның тамыры тереңде жатыр
Dialogue: 0,1:00:39.42,1:00:42.93,Default,,0,0,0,,Химура Қалай болғанда да, бұл оқиғалардың барлығы болды.
Dialogue: 0,1:00:43.01,1:00:44.64,Default,,0,0,0,,Сіз тек біраз уақыт күте аласыз
Dialogue: 0,1:00:45.64,1:00:46.93,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:00:50.02,1:00:52.14,Default,,0,0,0,,Ал... Күтуім керек шығар?
Dialogue: 0,1:00:52.52,1:00:55.48,Default,,0,0,0,,Армия мырзасы, толық ауқымды шабуылға тапсырыс беріңіз.
Dialogue: 0,1:00:55.77,1:00:57.73,Default,,0,0,0,,Мен ол жігітке бәс тігкім келеді.
Dialogue: 0,1:00:58.27,1:01:01.94,Default,,0,0,0,,Осы жағдайды реттей алатын адам болса
Dialogue: 0,1:01:02.03,1:01:03.45,Default,,0,0,0,,Ол жалғыз
Dialogue: 0,1:01:03.74,1:01:05.24,Default,,0,0,0,,Гимура өтінемін
Dialogue: 0,1:01:07.37,1:01:08.70,Default,,0,0,0,,Токи-сан, күте тұр.
Dialogue: 0,1:01:09.99,1:01:11.62,Default,,0,0,0,,Токи-сан, сабыр ет.
Dialogue: 0,1:01:11.70,1:01:14.29,Default,,0,0,0,,Мен... Мен Шигуреге барамын!
Dialogue: 0,1:01:15.63,1:01:16.67,Default,,0,0,0,,Химура-сан!
Dialogue: 0,1:01:18.96,1:01:20.17,Default,,0,0,0,,Шигуре
Dialogue: 0,1:01:21.38,1:01:22.88,Default,,0,0,0,,Шигуре өлуге дайын!
Dialogue: 0,1:01:23.63,1:01:25.97,Default,,0,0,0,,Ол кісі ағасының кесілгенін білген.
Dialogue: 0,1:01:26.05,1:01:28.01,Default,,0,0,0,,Олар мұны өздерінің кінәсі деп санайды.
Dialogue: 0,1:01:28.55,1:01:29.89,Default,,0,0,0,,Егер сол адам өлсе
Dialogue: 0,1:01:32.43,1:01:36.31,Default,,0,0,0,,Токи-доно, мен міндетті түрде Шигурэ-дононы үйге алып келемін.
Dialogue: 0,1:01:38.15,1:01:39.23,Default,,0,0,0,,Жарайды
Dialogue: 0,1:01:39.52,1:01:42.57,Default,,0,0,0,,Кеншин маған күш-қуат беремін деді, солай ма?
Dialogue: 0,1:01:43.24,1:01:44.28,Default,,0,0,0,,Каору-сан!
Dialogue: 0,1:01:47.91,1:01:48.87,Default,,0,0,0,,Кеншин?
Dialogue: 0,1:01:52.95,1:01:54.91,Default,,0,0,0,,Кеншин жалғыз барасың ба?
Dialogue: 0,1:01:56.17,1:01:57.00,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:01:57.08,1:02:00.80,Default,,0,0,0,,Токи-дононың үлкен ағасын Эдо кезеңінің соңында біреу өлтірді.
Dialogue: 0,1:02:00.88,1:02:01.80,Default,,0,0,0,,Мен естідім.
Dialogue: 0,1:02:02.21,1:02:04.72,Default,,0,0,0,,Гендацу-дононы өлтірген кім?
Dialogue: 0,1:02:06.22,1:02:07.76,Default,,0,0,0,,Хитокири Баттосай
Dialogue: 0,1:02:08.09,1:02:08.93,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:10.47,1:02:11.76,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,1:02:13.35,1:02:14.52,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,1:02:15.18,1:02:19.06,Default,,0,0,0,,Шигуренің бұл сияқты әрекеттері де осыдан туындаған.
Dialogue: 0,1:02:19.44,1:02:22.44,Default,,0,0,0,,Жауапкершіліктің бір бөлігі де маған жүктеледі.
Dialogue: 0,1:02:24.11,1:02:25.19,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:02:27.20,1:02:28.45,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:02:47.72,1:02:49.76,Default,,0,0,0,,Кеншин…
Dialogue: 0,1:02:58.77,1:03:01.65,Default,,0,0,0,,Асығыңыз! Тезірек қамал тұрғызыңыз!
Dialogue: 0,1:03:01.94,1:03:05.03,Default,,0,0,0,,Асықпасаң, үкімет әскері асығады!
Dialogue: 0,1:03:05.23,1:03:08.49,Default,,0,0,0,,Қат! Неге сендерді мұндай жерде тосқауыл қоясыңдар?
Dialogue: 0,1:03:08.61,1:03:11.70,Default,,0,0,0,,Шигуре жігіт, Шоғытай болып жүр ме?
Dialogue: 0,1:03:14.87,1:03:15.91,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:03:16.08,1:03:17.91,Default,,0,0,0,,Төтенше жағдайда бұл жерден кетіңіз.
Dialogue: 0,1:03:18.00,1:03:20.50,Default,,0,0,0,,Таманоның орнына айналдырыңыз.
Dialogue: 0,1:03:20.75,1:03:21.83,Default,,0,0,0,,Таманодағы да
Dialogue: 0,1:03:21.92,1:03:24.38,Default,,0,0,0,,Мен қорқамын деп шағымдансам, бітті.
Dialogue: 0,1:03:24.92,1:03:27.09,Default,,0,0,0,,Ол маған опасыздық жасайды деп ойламаймын.
Dialogue: 0,1:03:40.02,1:03:41.23,Default,,0,0,0,,Кешігіп қалдың, Кеншин.
Dialogue: 0,1:03:41.94,1:03:45.15,Default,,0,0,0,,Олар бекініс тұрғызып, осында ішке тосқауыл қойды.
Dialogue: 0,1:03:45.78,1:03:48.49,Default,,0,0,0,,Мен өзімнің штабымды сол қақпаға орнаттым және қозғалуға әрекет жасамадым.
Dialogue: 0,1:03:49.28,1:03:52.70,Default,,0,0,0,,Сол Шигуре деген жігіт, Кеншин шығар...
Dialogue: 0,1:03:54.78,1:03:55.79,Default,,0,0,0,,Тамано
Dialogue: 0,1:03:57.12,1:03:58.54,Default,,0,0,0,,Ол өтсін. (Солдат) Ха!
Dialogue: 0,1:04:06.63,1:04:08.30,Default,,0,0,0,,Үйге тірі ораламын деп үміттенемін.
Dialogue: 0,1:04:08.76,1:04:10.88,Default,,0,0,0,,Иә? Бұл не сұмдық?
Dialogue: 0,1:04:22.40,1:04:23.69,Default,,0,0,0,,Иә? Біреу келе жатыр!
Dialogue: 0,1:04:24.31,1:04:25.82,Default,,0,0,0,,Не? Солдат?
Dialogue: 0,1:04:31.45,1:04:33.74,Default,,0,0,0,,Әй, мұндайды маған қалдыр.
Dialogue: 0,1:04:33.82,1:04:35.20,Default,,0,0,0,,Әй, бұл қауіпті, кет ол жерден.
Dialogue: 0,1:04:35.58,1:04:36.74,Default,,0,0,0,,Иә? не?
Dialogue: 0,1:04:38.29,1:04:39.12,Default,,0,0,0,,Эй!
Dialogue: 0,1:04:41.91,1:04:42.87,Default,,0,0,0,,Уау!
Dialogue: 0,1:04:48.00,1:04:49.46,Default,,0,0,0,,Мен саған айттым ба? Бұл қауіпті
Dialogue: 0,1:04:50.01,1:04:52.88,Default,,0,0,0,,
Dialogue: 0,1:04:57.05,1:04:59.64,Default,,0,0,0,,Кеншин жай ғана бала.
Dialogue: 0,1:05:03.64,1:05:06.27,Default,,0,0,0,,Сәлем! Не істеп жатырсыңдар!
Dialogue: 0,1:05:06.40,1:05:09.28,Default,,0,0,0,,Бұл үкіметтің иттері. Оларды кесіңіз! Оларды кесіңіз!
Dialogue: 0,1:05:11.49,1:05:13.49,Default,,0,0,0,,Цк, мен құлықсызмын.
Dialogue: 0,1:05:13.57,1:05:16.28,Default,,0,0,0,,Кеншин Мен бұл жігіттерге қамқор боламын.
Dialogue: 0,1:05:16.37,1:05:17.78,Default,,0,0,0,,Сасаюки өтінемін
Dialogue: 0,1:05:19.41,1:05:21.00,Default,,0,0,0,,О! Маған қалдырыңыз
Dialogue: 0,1:05:22.83,1:05:25.29,Default,,0,0,0,,Жарайсыңдар! Бауырлар, келіңдер!
Dialogue: 0,1:05:25.50,1:05:27.25,Default,,0,0,0,,Мен саған қалай күресуді үйретемін.
Dialogue: 0,1:05:27.38,1:05:29.59,Default,,0,0,0,,Сәлем! Аяғымның астында саңылаулар бар
Dialogue: 0,1:05:29.84,1:05:31.34,Default,,0,0,0,,Сіздің иегіңіз бос.
Dialogue: 0,1:05:31.55,1:05:32.47,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:05:33.05,1:05:35.30,Default,,0,0,0,,Пышақты сермеуге қатты қуанба!
Dialogue: 0,1:05:35.68,1:05:37.22,Default,,0,0,0,,Кеншин асығыңыз!
Dialogue: 0,1:05:42.22,1:05:44.89,Default,,0,0,0,,Цк, мылтық бұл қашықтықта аздап қатты.
Dialogue: 0,1:05:45.27,1:05:48.27,Default,,0,0,0,,Жарайды, жарайды, жарайды, мені тез атып таста!
Dialogue: 0,1:05:48.40,1:05:49.57,Default,,0,0,0,,Қол тигізбеңіз
Dialogue: 0,1:05:51.36,1:05:52.28,Default,,0,0,0,,Шигуре
Dialogue: 0,1:05:54.49,1:05:56.32,Default,,0,0,0,,Ол кісінің маған қатысы бар.
Dialogue: 0,1:06:00.70,1:06:02.75,Default,,0,0,0,,Кеншин Қалғанын саған қалдырамын.
Dialogue: 0,1:06:02.95,1:06:04.75,Default,,0,0,0,,Әй, қайта түс! Бұл қауіпті
Dialogue: 0,1:06:04.91,1:06:06.29,Default,,0,0,0,,Ораора, сен де.
Dialogue: 0,1:06:07.08,1:06:09.04,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,1:06:10.13,1:06:11.80,Default,,0,0,0,,Шайқас шешілуі керек
Dialogue: 0,1:06:14.80,1:06:17.13,Default,,0,0,0,,Бір айта кететін жайт бар.
Dialogue: 0,1:06:18.18,1:06:20.14,Default,,0,0,0,,Гендацу-доно Такацукиді кім өлтірді?
Dialogue: 0,1:06:20.60,1:06:22.81,Default,,0,0,0,,Сіз Хитокири Баттоусай болуыңыз керек!
Dialogue: 0,1:06:25.14,1:06:27.19,Default,,0,0,0,,Мен бұрын бір-бірімізді шауып алғанымызды білдім.
Dialogue: 0,1:06:29.19,1:06:30.56,Default,,0,0,0,,Маған деген кек...
Dialogue: 0,1:06:30.90,1:06:34.07,Default,,0,0,0,,Жоқ, дәл осылай Гендацу өз өмірін қатерге тігіп, шайқасқа шықты.
Dialogue: 0,1:06:34.24,1:06:36.61,Default,,0,0,0,,Сіз өз өміріңізбен күрескен болуыңыз керек.
Dialogue: 0,1:06:36.78,1:06:38.66,Default,,0,0,0,,Бұл бәсекелестік мәселесі.
Dialogue: 0,1:06:41.24,1:06:44.54,Default,,0,0,0,,Бірақ Химура, үкімет әскері жасаған бұл дүние не?
Dialogue: 0,1:06:45.33,1:06:47.58,Default,,0,0,0,,Ол кезде бәріміз өз өмірімізді қатерге тігіп, күрескен едік.
Dialogue: 0,1:06:47.83,1:06:49.54,Default,,0,0,0,,Мен, шебер және Гендацу да.
Dialogue: 0,1:06:50.25,1:06:52.42,Default,,0,0,0,,Бірақ олар әлемді басып алған бойда,
Dialogue: 0,1:06:52.50,1:06:54.38,Default,,0,0,0,,Атақ-даңққа деген лас құмарлыққа бой алдырған
Dialogue: 0,1:06:54.46,1:06:57.05,Default,,0,0,0,,Билікті асыра пайдалану және ақшаға ашкөздік
Dialogue: 0,1:06:57.80,1:06:59.59,Default,,0,0,0,,Олар қатал ғана емес
Dialogue: 0,1:06:59.68,1:07:01.76,Default,,0,0,0,,Таза өлген ерлер
Dialogue: 0,1:07:01.85,1:07:03.81,Default,,0,0,0,,Сіз оны аяқ киіміңізбен таптап жатырсыз.
Dialogue: 0,1:07:04.27,1:07:07.60,Default,,0,0,0,,Гимура: Сіз мұндай мемлекеттік қызметкерді кешіре аласыз ба?
Dialogue: 0,1:07:08.14,1:07:08.98,Default,,0,0,0,,Бұл...
Dialogue: 0,1:07:09.31,1:07:11.11,Default,,0,0,0,,Ием, сол адамдар үшін
Dialogue: 0,1:07:11.19,1:07:12.73,Default,,0,0,0,,Сіз адамдарды кесіп көрдіңіз бе?
Dialogue: 0,1:07:17.82,1:07:20.95,Default,,0,0,0,,Содан кейін, Жаратқан Ие өлтірген адам
Dialogue: 0,1:07:21.24,1:07:22.41,Default,,0,0,0,,Сыйақы болмайды.
Dialogue: 0,1:07:23.91,1:07:25.08,Default,,0,0,0,,Хитокири Баттосай
Dialogue: 0,1:07:26.95,1:07:30.92,Default,,0,0,0,,Химура Мейдзи қалпына келтіруді қайтадан бастайық.
Dialogue: 0,1:07:32.13,1:07:33.09,Default,,0,0,0,,Шығып бара жатырсың ба?
Dialogue: 0,1:07:34.13,1:07:37.38,Default,,0,0,0,,Жақсылық деген не, жамандық деген не?
Dialogue: 0,1:07:39.47,1:07:41.76,Default,,0,0,0,,Қайта сұрыптау керек
Dialogue: 0,1:07:43.30,1:07:45.93,Default,,0,0,0,,Бұл жас қайтыс болғандарға арналған.
Dialogue: 0,1:07:46.02,1:07:47.14,Default,,0,0,0,,Кем дегенде, бұл өтемақы.
Dialogue: 0,1:07:48.27,1:07:52.61,Default,,0,0,0,,Оны көп жастардың қанымен өтеуге ниетіңіз бар ма?
Dialogue: 0,1:07:56.28,1:07:58.82,Default,,0,0,0,,Сіз көбірек қан төгесіз,
Dialogue: 0,1:07:59.03,1:08:02.95,Default,,0,0,0,,Сол қанның үстінен басып, жаңа дүние жасамақсың ба?
Dialogue: 0,1:08:09.21,1:08:12.37,Default,,0,0,0,,Дәл сол кезде қайтыс болғандардың басынан өткен оқиға.
Dialogue: 0,1:08:13.33,1:08:14.71,Default,,0,0,0,,Бұл сатқындық
Dialogue: 0,1:08:19.67,1:08:22.72,Default,,0,0,0,,Бұрынғы Айзу кланының самурайы Сайки Канума стилі
Dialogue: 0,1:08:23.39,1:08:24.60,Default,,0,0,0,,Шигурэ Такими
Dialogue: 0,1:08:25.72,1:08:26.56,Default,,0,0,0,,Қасиетті орындарым қалайша күйреді.
Dialogue: 0,1:08:27.52,1:08:29.98,Default,,0,0,0,,Хитен Митсворд стилі Кеншин Химура
Dialogue: 0,1:08:34.36,1:08:35.19,Default,,0,0,0,,Кеншин
Dialogue: 0,1:08:41.49,1:08:43.28,Default,,0,0,0,,Эдо кезеңінің соңында
Dialogue: 0,1:08:43.41,1:08:47.66,Default,,0,0,0,,Сайки Канума стилі үй ішіндегі ұрысқа маманданған
Dialogue: 0,1:08:47.83,1:08:48.91,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:08:52.41,1:08:54.00,Default,,0,0,0,,Канума Цугецукен
Dialogue: 0,1:09:02.68,1:09:04.39,Default,,0,0,0,,Қаптамаға алданба
Dialogue: 0,1:09:05.05,1:09:06.14,Default,,0,0,0,,Сол жақтан келе жатыр ма?
Dialogue: 0,1:09:06.72,1:09:07.81,Default,,0,0,0,,Дұрыс?
Dialogue: 0,1:09:08.01,1:09:10.18,Default,,0,0,0,,Жоғары немесе төмен?
Dialogue: 0,1:09:26.70,1:09:27.78,Default,,0,0,0,,Кеншин
Dialogue: 0,1:09:31.12,1:09:31.95,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,1:09:34.33,1:09:35.83,Default,,0,0,0,,Тааа!
Dialogue: 0,1:09:37.79,1:09:38.63,Default,,0,0,0,,Төменнен!
Dialogue: 0,1:09:44.63,1:09:48.18,Default,,0,0,0,,Хитен Мицворд стиліндегі Ряцучи жарқылы!
Dialogue: 0,1:09:53.64,1:09:55.69,Default,,0,0,0,,Мен сенің семсеріңнен бас тарттым.
Dialogue: 0,1:09:56.31,1:09:57.69,Default,,0,0,0,,Сол ұзын қылыш
Dialogue: 0,1:09:58.81,1:09:59.98,Default,,0,0,0,,Мен оны ешқашан ұмытпаймын!
Dialogue: 0,1:10:08.12,1:10:10.74,Default,,0,0,0,,Хитен Митсворд стилі Рюшосен!
Dialogue: 0,1:10:14.71,1:10:18.17,Default,,0,0,0,,Қылыш жылдамдығы мен қашықтығы Бәрінен бас тарттым!
Dialogue: 0,1:10:18.29,1:10:21.25,Default,,0,0,0,,Соңғы он жыл бойы ол менің жадымда күйіп, мені ешқашан тастамады.
Dialogue: 0,1:10:24.92,1:10:27.22,Default,,0,0,0,,Канума Кенёкен
Dialogue: 0,1:10:29.30,1:10:30.22,Default,,0,0,0,,Темірді дайындау?
Dialogue: 0,1:10:34.14,1:10:35.14,Default,,0,0,0,,Кеншин!
Dialogue: 0,1:10:35.77,1:10:36.85,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:39.36,1:10:40.77,Default,,0,0,0,,Сөндіргіш қылыш!
Dialogue: 0,1:10:41.52,1:10:44.69,Default,,0,0,0,,Сөндіргіш қылыш – шеңбер бойымен екі сатылы шабуыл!
Dialogue: 0,1:10:46.32,1:10:47.15,Default,,0,0,0,,Ха!
Dialogue: 0,1:10:57.62,1:10:59.54,Default,,0,0,0,,Мен Гендацудан күштімін
Dialogue: 0,1:11:02.46,1:11:03.38,Default,,0,0,0,,Кеншин!
Dialogue: 0,1:11:06.30,1:11:07.22,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:11.55,1:11:13.76,Default,,0,0,0,,Жарайды, Кеншин.
Dialogue: 0,1:11:14.14,1:11:15.77,Default,,0,0,0,,Мен де Шигурэ-санға сенімдімін.
Dialogue: 0,1:11:16.48,1:11:17.69,Default,,0,0,0,,Дұрыс? Токи мырза
Dialogue: 0,1:11:18.85,1:11:20.56,Default,,0,0,0,,Токи мырза? Ха!
Dialogue: 0,1:11:23.07,1:11:25.28,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:27.36,1:11:29.78,Default,,0,0,0,,Әрең қозғалып жатырсыз ба?
Dialogue: 0,1:11:30.53,1:11:31.49,Default,,0,0,0,,Гимура
Dialogue: 0,1:11:32.99,1:11:35.91,Default,,0,0,0,,Кері жүзді қылышты қайтарып, оны байыппен орындау керек.
Dialogue: 0,1:11:36.20,1:11:38.50,Default,,0,0,0,,Өміріңді жоғалтасың.
Dialogue: 0,1:11:39.42,1:11:41.42,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:11:45.63,1:11:47.59,Default,,0,0,0,,Енді оны қайтарыңыз.
Dialogue: 0,1:11:50.59,1:11:54.81,Default,,0,0,0,,Қанымның кез келген мөлшерін төгемін
Dialogue: 0,1:12:01.90,1:12:05.98,Default,,0,0,0,,Бірақ мен саған бұдан былай жас қанды төгуге жол бермеймін!
Dialogue: 0,1:12:07.32,1:12:09.65,Default,,0,0,0,,Онда сен осы жерде өлуің керек!
Dialogue: 0,1:12:19.37,1:12:21.04,Default,,0,0,0,,Соққыға ұмтылу
Dialogue: 0,1:12:21.79,1:12:24.17,Default,,0,0,0,,Бір ғана соққы
Dialogue: 0,1:12:25.29,1:12:28.67,Default,,0,0,0,,Бұл Хитен Мицуруги стиліндегі құпия техника Теншурюсен
Dialogue: 0,1:12:30.05,1:12:32.09,Default,,0,0,0,,Канума отқа қарсы қылыш!
Dialogue: 0,1:12:36.76,1:12:37.60,Default,,0,0,0,,Ол ұшты ма?
Dialogue: 0,1:12:41.10,1:12:42.81,Default,,0,0,0,,Бұл бұрынғы әдістеме ме?
Dialogue: 0,1:12:44.90,1:12:45.98,Default,,0,0,0,,Қандай ысырап!
Dialogue: 0,1:12:47.82,1:12:52.40,Default,,0,0,0,,Жоқ! Тіпті Ряцучи Сен емес, одан да аз Теншо Рюсен.
Dialogue: 0,1:12:53.99,1:12:54.78,Default,,0,0,0,,Бұл...
Dialogue: 0,1:12:57.45,1:12:59.45,Default,,0,0,0,,Табансыз ауада
Dialogue: 0,1:13:00.37,1:13:02.92,Default,,0,0,0,,Канума стиліндегі құпия қылыш қос басты қылыш!
Dialogue: 0,1:13:08.50,1:13:09.34,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:12.05,1:13:14.39,Default,,0,0,0,,Денені айналдыру арқылы Баттоудзюцу
Dialogue: 0,1:13:19.60,1:13:22.68,Default,,0,0,0,,О~ (Саносуке) Керемет! Керемет!
Dialogue: 0,1:13:23.56,1:13:25.85,Default,,0,0,0,,Былайша айтқанда, Кеншин-рю батудзюцу иіру!
Dialogue: 0,1:13:36.87,1:13:39.12,Default,,0,0,0,,Неліктен оны өлтірмеске? Гимура
Dialogue: 0,1:13:39.24,1:13:41.83,Default,,0,0,0,,Мен өлтірген адамдар үшін
Dialogue: 0,1:13:41.95,1:13:44.25,Default,,0,0,0,,Мен енді ешқашан басқа адамды өлтірмеймін.
Dialogue: 0,1:13:45.21,1:13:48.84,Default,,0,0,0,,Бұл мен бере алатын жалғыз өтемақы.
Dialogue: 0,1:13:56.01,1:13:57.22,Default,,0,0,0,,Гендацу
Dialogue: 0,1:13:59.14,1:14:02.77,Default,,0,0,0,,Шигуре Маған Бандай тауының үстіндегі көк аспан ұнайды
Dialogue: 0,1:14:05.39,1:14:06.77,Default,,0,0,0,,О, мен де.
Dialogue: 0,1:14:09.44,1:14:13.40,Default,,0,0,0,,Көк аспан мәңгілік биік, ашық болуы керек.
Dialogue: 0,1:14:13.61,1:14:14.45,Default,,0,0,0,,О
Dialogue: 0,1:14:14.53,1:14:17.61,Default,,0,0,0,,Менің ойымша, бұл дүние де солай болуы керек.
Dialogue: 0,1:14:22.87,1:14:24.08,Default,,0,0,0,,Гендацу
Dialogue: 0,1:14:24.50,1:14:27.17,Default,,0,0,0,,Мен де Гендацуды жақтаймын
Dialogue: 0,1:14:28.50,1:14:31.25,Default,,0,0,0,,Мен жеңілуге шыдай алмаймын.
Dialogue: 0,1:14:35.76,1:14:38.80,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:14:41.89,1:14:42.72,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,1:14:44.06,1:14:45.06,Default,,0,0,0,,Тоқта
Dialogue: 0,1:14:50.31,1:14:53.07,Default,,0,0,0,,Тоқта, тоқта!
Dialogue: 0,1:14:58.24,1:14:59.36,Default,,0,0,0,,Токи
Dialogue: 0,1:14:59.70,1:15:00.66,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,1:15:02.53,1:15:04.66,Default,,0,0,0,,Сенің арқасында тіпті трусигім де суға малып кетті. О, Құдай-ай…
Dialogue: 0,1:15:05.91,1:15:07.37,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,1:15:18.84,1:15:19.76,Default,,0,0,0,,Токи
Dialogue: 0,1:15:20.09,1:15:21.18,Default,,0,0,0,,Гэндацу-доно
Dialogue: 0,1:15:24.39,1:15:28.23,Default,,0,0,0,,Қалай ойлайсың, Гэндацу-доно Токи-дононың осылай жылағанын көргісі келеді ме?
Dialogue: 0,1:15:38.65,1:15:40.16,Default,,0,0,0,,Не болды? Қатаң қол жеткізілді
Dialogue: 0,1:15:41.24,1:15:43.20,Default,,0,0,0,,Түнде ұйықтай алмаймын
Dialogue: 0,1:15:44.45,1:15:49.67,Default,,0,0,0,,Мен өлтірген адамдар ата-аналарын немесе бауырларын жақсы көрген болуы мүмкін.
Dialogue: 0,1:15:51.25,1:15:53.17,Default,,0,0,0,,Осыны ескере отырып
Dialogue: 0,1:15:55.00,1:15:56.05,Default,,0,0,0,,Гендацу
Dialogue: 0,1:15:58.55,1:15:59.51,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,1:16:00.55,1:16:03.10,Default,,0,0,0,,Үйден келген хабар не дейді?
Dialogue: 0,1:16:03.43,1:16:05.81,Default,,0,0,0,,Әкем еденге құлап кеткен сияқты.
Dialogue: 0,1:16:06.93,1:16:08.89,Default,,0,0,0,,Менің созылмалы ауруым қайта оралды деп ойлаймын.
Dialogue: 0,1:16:09.31,1:16:12.02,Default,,0,0,0,,Бірақ олай емес; Чошу қалдықтары қайтадан ...
Dialogue: 0,1:16:12.10,1:16:13.86,Default,,0,0,0,,Жоқ, Шигуре
Dialogue: 0,1:16:15.23,1:16:19.57,Default,,0,0,0,,Менде тек Токи бар, сондықтан мен бұл туралы тым көп ойлап жүрген шығармын.
Dialogue: 0,1:16:20.28,1:16:21.78,Default,,0,0,0,,Ата-аналар мен бауырлар
Dialogue: 0,1:16:21.91,1:16:24.62,Default,,0,0,0,,Жақындарды жақсы көру ұят емес.
Dialogue: 0,1:16:25.33,1:16:29.08,Default,,0,0,0,,Ол мұндай адам болмаса, ол дүниенің жай-күйі туралы айтуға жарамайды.
Dialogue: 0,1:16:29.87,1:16:33.67,Default,,0,0,0,,Неліктен мен хитокири деп аталып, қылыш сермеп жүрмін?
Dialogue: 0,1:16:34.54,1:16:38.42,Default,,0,0,0,,Достар, сіздің отбасыңыз және Токи
Dialogue: 0,1:16:39.34,1:16:42.72,Default,,0,0,0,,Өйткені мен айналамдағы адамдардың бақытты болғанын қалаймын.
Dialogue: 0,1:16:49.10,1:16:50.10,Default,,0,0,0,,Гендацу
Dialogue: 0,1:17:03.70,1:17:05.78,Default,,0,0,0,,Гэндацу Гэндацу
Dialogue: 0,1:17:06.74,1:17:11.12,Default,,0,0,0,,Сенің өліміңді менен артық санаған адам болды.
Dialogue: 0,1:17:15.67,1:17:16.63,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,1:17:19.71,1:17:20.92,Default,,0,0,0,,Телеграф бағанасына не болды… Ха!
Dialogue: 0,1:17:31.43,1:17:33.56,Default,,0,0,0,,Ұйымдастырушы - барон Тамано
Dialogue: 0,1:17:34.10,1:17:35.31,Default,,0,0,0,,Не...?
Dialogue: 0,1:17:37.69,1:17:39.73,Default,,0,0,0,,Мына кісі бәрін қуып жіберді.
Dialogue: 0,1:17:39.94,1:17:40.90,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:17:40.98,1:17:42.82,Default,,0,0,0,,Әскери қару дүкенінің сатушысы
Dialogue: 0,1:17:43.36,1:17:47.95,Default,,0,0,0,,Көтерілісшілер тобы қолданатын қаруларды барон Тамано ұрлап кеткен.
Dialogue: 0,1:17:48.49,1:17:49.74,Default,,0,0,0,,Не?
Dialogue: 0,1:17:50.70,1:17:54.58,Default,,0,0,0,,Сондай-ақ бүлікшілер тобына қатысы бар адам бар екені анықталды.
Dialogue: 0,1:17:58.54,1:18:00.71,Default,,0,0,0,,Мен... Мен дереу қолбасшыға хабарлауым керек!
Dialogue: 0,1:18:08.39,1:18:09.64,Default,,0,0,0,,Шигуре мырза
Dialogue: 0,1:18:09.93,1:18:11.97,Default,,0,0,0,,Шигуре мырза, амансыз ба?
Dialogue: 0,1:18:12.18,1:18:14.94,Default,,0,0,0,,Аа, жарайды, бәрі уайымдады.
Dialogue: 0,1:18:15.06,1:18:16.35,Default,,0,0,0,,Шигуре мырза! Шигуре-сан!
Dialogue: 0,1:18:22.94,1:18:25.11,Default,,0,0,0,,Токи, мұнда кел.
Dialogue: 0,1:18:26.03,1:18:26.86,Default,,0,0,0,,Иә
Dialogue: 0,1:18:32.95,1:18:35.29,Default,,0,0,0,,Токи Мен өзімді тапсырғалы жатырмын.
Dialogue: 0,1:18:35.37,1:18:36.21,Default,,0,0,0,,Иә
Dialogue: 0,1:18:38.38,1:18:39.38,Default,,0,0,0,,Токи
Dialogue: 0,1:18:39.58,1:18:43.38,Default,,0,0,0,,Мен сені үнемі жылататынмын.
Dialogue: 0,1:18:52.01,1:18:54.47,Default,,0,0,0,,Кеншин: Сіздің жараңыз жақсы ма? (Кеншин) А
Dialogue: 0,1:18:55.77,1:18:58.44,Default,,0,0,0,,Сол екеуіне қарасам, мына тыртықтарды көремін.
Dialogue: 0,1:18:58.60,1:19:01.15,Default,,0,0,0,,Әй, сен де ауырғанды ​​ұмыттың ба?
Dialogue: 0,1:19:01.52,1:19:02.90,Default,,0,0,0,,Кеншинге ұқсайды
Dialogue: 0,1:19:05.28,1:19:06.11,Default,,0,0,0,,Цк
Dialogue: 0,1:19:16.08,1:19:17.33,Default,,0,0,0,,Жақсы мақсат қойыңыз!
Dialogue: 0,1:19:21.54,1:19:23.25,Default,,0,0,0,,Ату! Ату, ату
Dialogue: 0,1:19:25.30,1:19:26.63,Default,,0,0,0,,Не! Мынау
Dialogue: 0,1:19:34.43,1:19:35.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:19:38.73,1:19:40.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:19:47.74,1:19:48.95,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:57.95,1:20:00.08,Default,,0,0,0,,Кеншин Ол ішінде ме?
Dialogue: 0,1:20:03.50,1:20:04.34,Default,,0,0,0,,Кеншин
Dialogue: 0,1:20:05.50,1:20:07.09,Default,,0,0,0,,Шигуре Шигуре!
Dialogue: 0,1:20:08.17,1:20:09.09,Default,,0,0,0,,Лорд Шигуре!
Dialogue: 0,1:20:10.68,1:20:11.89,Default,,0,0,0,,Лорд Шигуре!
Dialogue: 0,1:20:12.18,1:20:13.26,Default,,0,0,0,,Шигуре!
Dialogue: 0,1:20:16.60,1:20:19.48,Default,,0,0,0,,Токи Бар ма?
Dialogue: 0,1:20:19.94,1:20:21.31,Default,,0,0,0,,Жақын болыңыз
Dialogue: 0,1:20:21.94,1:20:23.77,Default,,0,0,0,,Мен осындамын
Dialogue: 0,1:20:25.32,1:20:26.61,Default,,0,0,0,,Гендацу
Dialogue: 0,1:20:27.15,1:20:32.91,Default,,0,0,0,,Көк аспан мәңгілік биік, ашық болуы керек.
Dialogue: 0,1:20:35.66,1:20:36.83,Default,,0,0,0,,Шигуре
Dialogue: 0,1:20:40.41,1:20:42.37,Default,,0,0,0,,Шигуре!
Dialogue: 0,1:20:52.88,1:20:55.35,Default,,0,0,0,,Келесі волейбол олардың бәрін өлтіреді.
Dialogue: 0,1:20:55.76,1:20:59.64,Default,,0,0,0,,Бастапқыда дос болғым келмеді, бірақ Каджики де аянышты жігіт.
Dialogue: 0,1:21:04.94,1:21:05.94,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,1:21:06.98,1:21:08.69,Default,,0,0,0,,Неге аттың?
Dialogue: 0,1:21:09.32,1:21:10.90,Default,,0,0,0,,Бірақ негізгі денені табуымыз керек дейді… оны қалайша тауып алуымыз керек?
Dialogue: 0,1:21:12.86,1:21:15.66,Default,,0,0,0,,Мен бәріңді өлтіремін.
Dialogue: 0,1:21:16.37,1:21:17.53,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,1:21:25.42,1:21:27.88,Default,,0,0,0,,Ату! Олардың бәрін өлтір!
Dialogue: 0,1:21:28.50,1:21:29.38,Default,,0,0,0,,Яби
Dialogue: 0,1:21:29.46,1:21:31.84,Default,,0,0,0,,Балалар, не қаласаңдар, соны істеңдер, жасырыныңдар.
Dialogue: 0,1:21:31.97,1:21:32.80,Default,,0,0,0,,Кеншин!
Dialogue: 0,1:21:37.01,1:21:38.47,Default,,0,0,0,,Қаш, оны көзде!
Dialogue: 0,1:21:40.31,1:21:41.77,Default,,0,0,0,,Ахх!
Dialogue: 0,1:21:47.15,1:21:47.98,Default,,0,0,0,,Не!
Dialogue: 0,1:21:51.32,1:21:53.07,Default,,0,0,0,,Не істеп жатырсың! Тез ат!
Dialogue: 0,1:21:57.53,1:21:58.37,Default,,0,0,0,,Кеншин!
Dialogue: 0,1:22:22.10,1:22:23.06,Default,,0,0,0,,Кеншин!
Dialogue: 0,1:22:27.19,1:22:28.77,Default,,0,0,0,,Түсіруді тоқтатыңыз!
Dialogue: 0,1:22:29.69,1:22:33.07,Default,,0,0,0,,Соғыс аяқталды. Мылтықтарыңызды тартыңыз, қылыштарыңызды тартыңыз!
Dialogue: 0,1:22:40.83,1:22:44.50,Default,,0,0,0,,Ауыр жарақат алғандарды зембілмен алып жүру керек, жеңіл жарақат алғандарға дәрі-дәрмек және таңғыш беру керек.
Dialogue: 0,1:22:44.79,1:22:45.87,Default,,0,0,0,,Таманоны алып кетіңіз.
Dialogue: 0,1:22:45.96,1:22:49.17,Default,,0,0,0,,Ей, балалар, сендердің тірі екендеріңе қуаныштымын.
Dialogue: 0,1:22:49.63,1:22:53.63,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:22:58.43,1:23:01.35,Default,,0,0,0,,Қат! Таманоның әлгі бейбақ маған опасыздық жасады.
Dialogue: 0,1:23:01.47,1:23:03.35,Default,,0,0,0,,Сіз сатқын болуыңыз керек
Dialogue: 0,1:23:04.02,1:23:08.10,Default,,0,0,0,,Эдо кезеңінің соңындағы досы Шигурені алдап, Таманоға кіреді.
Dialogue: 0,1:23:08.19,1:23:10.02,Default,,0,0,0,,Жарқанаттай әлемді кезіп жүрсің бе?
Dialogue: 0,1:23:12.48,1:23:15.11,Default,,0,0,0,,Бұлай айту жарқанатқа құрметсіздік.
Dialogue: 0,1:23:15.44,1:23:16.57,Default,,0,0,0,,Бағана жанындағы сол адам, Сантана—
Dialogue: 0,1:23:16.90,1:23:18.28,Default,,0,0,0,,Кез келген уақыт жақсы.
Dialogue: 0,1:23:19.20,1:23:22.37,Default,,0,0,0,,Мен саған өлетін жер беремін, кез келген уақытта кет.
Dialogue: 0,1:23:22.87,1:23:24.33,Default,,0,0,0,,Ал... күте тұрыңыз.
Dialogue: 0,1:23:24.41,1:23:26.96,Default,,0,0,0,,Мен бұл оқиғаның тірі куәгерімін.
Dialogue: 0,1:23:27.08,1:23:30.88,Default,,0,0,0,,Тамано туралы барлығына куәлік бересіз бе? Келісім жасайық
Dialogue: 0,1:23:31.04,1:23:31.88,Default,,0,0,0,,Хун
Dialogue: 0,1:23:33.21,1:23:35.76,Default,,0,0,0,,Жалған әділеттілік танытқан қылышшы полицей сияқты.
Dialogue: 0,1:23:35.84,1:23:37.47,Default,,0,0,0,,Мені кесіп тастайды ма?
Dialogue: 0,1:23:40.01,1:23:43.22,Default,,0,0,0,,Менің әділдігім біреу екенін айтуды ұмытып кетіппін.
Dialogue: 0,1:23:44.10,1:23:45.27,Default,,0,0,0,,Зұлымдық, дереу кесу (Аку Соку Зан)!
Dialogue: 0,1:23:47.89,1:23:52.27,Default,,0,0,0,,Шинсенгуми Хаджиме Сайто...
Dialogue: 0,1:24:06.29,1:24:08.37,Default,,0,0,0,,Өлгендердің сүйегін көшіру
Dialogue: 0,1:24:11.37,1:24:13.00,Default,,0,0,0,,«Мен… мен адаммын.»
Dialogue: 0,1:24:13.38,1:24:16.25,Default,,0,0,0,,Маған осылай тағы біраз тұруға рұқсат етіңіз.
Dialogue: 0,1:24:16.34,1:24:17.17,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:24:44.99,1:24:47.99,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,1:24:48.20,1:24:50.79,Default,,0,0,0,,Сәлем, қош бол
Dialogue: 0,1:24:50.96,1:24:52.42,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,1:24:54.46,1:24:55.50,Default,,0,0,0,,Гимура мырза?
Dialogue: 0,1:25:02.34,1:25:03.34,Default,,0,0,0,,Бүгін ше?
Dialogue: 0,1:25:04.14,1:25:07.51,Default,,0,0,0,,Токи-доноға айтарым бар.
Dialogue: 0,1:25:09.85,1:25:13.44,Default,,0,0,0,,Гендацу-дононы өлтірген мен болдым.
Dialogue: 0,1:25:14.94,1:25:17.11,Default,,0,0,0,,Мен Эдо кезеңінің соңында болдым.
Dialogue: 0,1:25:17.27,1:25:20.19,Default,,0,0,0,,Хитокири Баттосай деп аталды.
Dialogue: 0,1:25:24.78,1:25:26.70,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,1:25:33.04,1:25:34.87,Default,,0,0,0,,Солай ма...?
Dialogue: 0,1:25:37.04,1:25:39.38,Default,,0,0,0,,Шигуре үнемі айтатын
Dialogue: 0,1:25:39.80,1:25:41.13,Default,,0,0,0,,Эдо кезеңінің соңында
Dialogue: 0,1:25:41.26,1:25:45.30,Default,,0,0,0,,Ненің дұрыс, ненің бұрыс екені ретсіз болды.
Dialogue: 0,1:25:46.59,1:25:49.68,Default,,0,0,0,,Әрқайсымыз сенген жол үшін
Dialogue: 0,1:25:50.06,1:25:52.23,Default,,0,0,0,,Ол таза күресіп жатқанын айтты.
Dialogue: 0,1:25:53.69,1:25:56.65,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,1:26:04.70,1:26:05.99,Default,,0,0,0,,Шигуренің заттары
Dialogue: 0,1:26:06.16,1:26:09.53,Default,,0,0,0,,Мен ағам мен бұрынғы жолдастарымды туған жерімнің төбесінде олар демалатын жерге жерлеймін.
Dialogue: 0,1:26:09.95,1:26:11.66,Default,,0,0,0,,Барлық көмектеріңіз үшін рахмет.
Dialogue: 0,1:26:11.74,1:26:13.25,Default,,0,0,0,,Көңіліңді көтер, Токи-сан да.
Dialogue: 0,1:26:13.33,1:26:14.54,Default,,0,0,0,,Тезірек оралыңыз.
Dialogue: 0,1:26:14.79,1:26:17.21,Default,,0,0,0,,Иә, балалар күтіп тұр.
Dialogue: 0,1:26:17.29,1:26:18.71,Default,,0,0,0,,Әй, мектепті қысып қалдың ба?
Dialogue: 0,1:26:18.79,1:26:21.55,Default,,0,0,0,,Мен бір күні сол балалармен сөйлескім келеді.
Dialogue: 0,1:26:21.96,1:26:25.05,Default,,0,0,0,,Эдо кезеңінің соңы барлығыңыз қалай өтті?
Dialogue: 0,1:26:26.13,1:26:28.09,Default,,0,0,0,,Сол балалар есейгенде
Dialogue: 0,1:26:28.18,1:26:30.97,Default,,0,0,0,,Шигуре айтып отырған дүние сол күйге айналуы мүмкін.
Dialogue: 0,1:26:31.22,1:26:33.02,Default,,0,0,0,,Ешкімнің қаны төгілмейді
Dialogue: 0,1:26:34.39,1:26:37.85,Default,,0,0,0,,Бір күні ағаммен бірге Шигуренің бейітіне баруыңызды өтінемін.
Dialogue: 0,1:26:38.02,1:26:40.23,Default,,0,0,0,,Біз мұны қуана жасар едік.
Dialogue: 0,1:26:40.86,1:26:43.74,Default,,0,0,0,,Гүлдің ашылу мезгілі келгенде, бәріміз бірге барайық.
Dialogue: 0,1:26:43.82,1:26:45.07,Default,,0,0,0,,Иә (Саносуке) Дұрыс.
Dialogue: 0,1:26:45.65,1:26:47.07,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,1:27:01.71,1:27:05.92,Default,,0,0,0,,Көк аспан мәңгілік биік, ашық болуы керек.
Dialogue: 0,1:27:06.47,1:27:07.84,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,1:27:13.06,1:27:19.06,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:30:29.42,1:30:35.42,Default,,0,0,0,,~♪
