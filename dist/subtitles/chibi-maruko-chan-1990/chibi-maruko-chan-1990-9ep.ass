Dialogue: 0,0:25:37.09,0:25:39.99,Default,,0000,0000,0000,,Не болды? Мару-чан
Dialogue: 0,0:25:39.99,0:25:43.99,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:25:39.99,0:25:43.99,Rubi,,0000,0000,0000,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:25:39.99,0:25:43.99,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:25:39.99,0:25:43.99,Default,,0000,0000,0000,,Маған қар сувенирін әкел.
