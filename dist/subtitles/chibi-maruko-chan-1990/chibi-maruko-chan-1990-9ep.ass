Dialogue: 0,0:11:30.07,0:11:33.58,Default,,0000,0000,0000,,Шынымен де балалар
Dialogue: 0,0:11:30.07,0:11:33.58,Rubi,,0000,0000,0000,,Ганба
Dialogue: 0,0:11:30.07,0:11:33.58,Rubi,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:11:30.07,0:11:33.58,Default,,0000,0000,0000,,Сіз еңбекқорсыз.
Dialogue: 0,0:11:33.58,0:11:36.48,Rubi,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:11:33.58,0:11:36.48,Default,,0000,0000,0000,,Мен ескі ингредистік овчаркамын.
Dialogue: 0,0:11:33.58,0:11:36.48,Default,,0000,0000,0000,,Виктория ханыммен
Dialogue: 0,0:11:36.48,0:11:38.45,Rubi,,0000,0000,0000,,Серуендеу
