Dialogue: 0,0:08:58.42,0:09:02.06,Default,,0000,0000,0000,,Екеуіңіз де жақсы боласыздар.
Dialogue: 0,0:09:02.06,0:09:07.56,Default,,0000,0000,0000,,《Тама-чан!
Dialogue: 0,0:09:02.06,0:09:07.56,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:09:02.06,0:09:07.56,Rubi,,0000,0000,0000,,Достар
Dialogue: 0,0:09:02.06,0:09:07.56,Default,,0000,0000,0000,,Достар - сізде болуы керек нәрсе》
Dialogue: 0,0:09:07.56,0:09:09.07,Default,,0000,0000,0000,,Жоқ?
Dialogue: 0,0:09:09.07,0:09:12.57,Default,,0000,0000,0000,,Жоқ, мен істеймін!
Dialogue: 0,0:09:09.07,0:09:12.57,Default,,0000,0000,0000,,Мен мұны істеймін, мен істеймін!
Dialogue: 0,0:09:12.57,0:09:13.54,Default,,0000,0000,0000,,Ахаха
Dialogue: 0,0:09:13.54,0:09:16.07,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:09:13.54,0:09:16.07,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:13.54,0:09:16.07,Default,,0000,0000,0000,,Сіз не істейсіз?
Dialogue: 0,0:09:16.07,0:09:19.94,Rubi,,0000,0000,0000,,Тазалау
Dialogue: 0,0:09:16.07,0:09:19.94,Rubi,,0000,0000,0000,,Уақыт кезеңі
Dialogue: 0,0:09:16.07,0:09:19.94,Rubi,,0000,0000,0000,,Мудабанаши
Dialogue: 0,0:09:16.07,0:09:19.94,Default,,0000,0000,0000,,Тазалау уақытында бос сөйлеуге болмайды
Dialogue: 0,0:09:16.07,0:09:19.94,Rubi,,0000,0000,0000,,Құлпынай
Dialogue: 0,0:09:16.07,0:09:19.94,Rubi,,0000,0000,0000,,Жылқы құйрығы
Dialogue: 0,0:09:16.07,0:09:19.94,Default,,0000,0000,0000,,Бір сөзді айтудан аулақ болу керек.
Dialogue: 0,0:09:19.94,0:09:22.95,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:09:19.94,0:09:22.95,Rubi,,0000,0000,0000,,Айка
Dialogue: 0,0:09:19.94,0:09:22.95,Rubi,,0000,0000,0000,,Дженмицу
Dialogue: 0,0:09:19.94,0:09:22.95,Default,,0000,0000,0000,,Маруо-кун, сен бұрынғыдай қаталсың.
Dialogue: 0,0:09:22.95,0:09:27.52,Rubi,,0000,0000,0000,,Хоукаго
Dialogue: 0,0:09:22.95,0:09:27.52,Default,,0000,0000,0000,,Мектептен кейін
Dialogue: 0,0:09:22.95,0:09:27.52,Rubi,,0000,0000,0000,,Фью
Dialogue: 0,0:09:22.95,0:09:27.52,Rubi,,0000,0000,0000,,Тренинг
Dialogue: 0,0:09:22.95,0:09:27.52,Default,,0000,0000,0000,,Мен флейтада ойнауды үйренуім керек деп ойлаймын...
Dialogue: 0,0:09:27.52,0:09:29.02,Default,,0000,0000,0000,,Штаб оның шамамен төрт айда сегіз «Стелла» жинайтынын болжайды, бірақ
Dialogue: 0,0:09:29.02,0:09:32.52,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:09:29.02,0:09:32.52,Rubi,,0000,0000,0000,,Гата
Dialogue: 0,0:09:29.02,0:09:32.52,Default,,0000,0000,0000,,А, сен...
Dialogue: 0,0:09:32.52,0:09:35.03,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:09:32.52,0:09:35.03,Default,,0000,0000,0000,,Бұл тамаша!
Dialogue: 0,0:09:35.03,0:09:36.96,Rubi,,0000,0000,0000,,Сары
Dialogue: 0,0:09:35.03,0:09:36.96,Default,,0000,0000,0000,,Жай сөйлесу
Dialogue: 0,0:09:35.03,0:09:36.96,Default,,0000,0000,0000,,Егер бар болса
Dialogue: 0,0:09:36.96,0:09:41.90,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:09:36.96,0:09:41.90,Rubi,,0000,0000,0000,,Маруо Суео
Dialogue: 0,0:09:36.96,0:09:41.90,Default,,0000,0000,0000,,Сынып өкілі Коно Маруо Суео
Dialogue: 0,0:09:36.96,0:09:41.90,Rubi,,0000,0000,0000,,Данко Кюдан
Dialogue: 0,0:09:36.96,0:09:41.90,Default,,0000,0000,0000,,Біз үзілді-кесілді айыптаймыз
Dialogue: 0,0:09:41.90,0:09:46.54,Rubi,,0000,0000,0000,,Иноко
Dialogue: 0,0:09:41.90,0:09:46.54,Rubi,,0000,0000,0000,,Фью
Dialogue: 0,0:09:41.90,0:09:46.54,Rubi,,0000,0000,0000,,Тренинг
Dialogue: 0,0:09:41.90,0:09:46.54,Default,,0000,0000,0000,,Бірақ мен артта қалып, флейтамен айналыстым.
Dialogue: 0,0:09:41.90,0:09:46.54,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:09:41.90,0:09:46.54,Rubi,,0000,0000,0000,,Соңында
Dialogue: 0,0:09:41.90,0:09:46.54,Default,,0000,0000,0000,,Байқауға деген құштарлық!
Dialogue: 0,0:09:46.54,0:09:50.04,Rubi,,0000,0000,0000,,Кандо
Dialogue: 0,0:09:46.54,0:09:50.04,Rubi,,0000,0000,0000,,Дауыл
Dialogue: 0,0:09:46.54,0:09:50.04,Default,,0000,0000,0000,,Бұл эмоцияның дауылы болуы керек.
Dialogue: 0,0:09:50.04,0:09:53.54,Default,,0000,0000,0000,,Түсіндім... Эй.
Dialogue: 0,0:09:50.04,0:09:53.54,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:09:53.54,0:09:55.05,Rubi,,0000,0000,0000,,О
Dialogue: 0,0:09:53.54,0:09:55.05,Default,,0000,0000,0000,,Бұл асыра сілтеу.
Dialogue: 0,0:09:55.05,0:09:58.55,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:09:55.05,0:09:58.55,Default,,0000,0000,0000,,Иә, мен де.
Dialogue: 0,0:09:55.05,0:09:58.55,Default,,0000,0000,0000,,Келіңіздер!
Dialogue: 0,0:09:58.55,0:09:59.52,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:58.55,0:09:59.52,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:59.52,0:10:02.42,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:09:59.52,0:10:02.42,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:09:59.52,0:10:02.42,Default,,0000,0000,0000,,Өте мұқият
Dialogue: 0,0:09:59.52,0:10:02.42,Default,,0000,0000,0000,,Оны алудың қажеті жоқ.
Dialogue: 0,0:10:02.42,0:10:06.06,Default,,0000,0000,0000,,Жоқ, бұл да
Dialogue: 0,0:10:02.42,0:10:06.06,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:10:02.42,0:10:06.06,Rubi,,0000,0000,0000,,Цуто
Dialogue: 0,0:10:02.42,0:10:06.06,Default,,0000,0000,0000,,Сынып өкілі ретіндегі міндеттерім
Dialogue: 0,0:10:06.06,0:10:09.56,Default,,0000,0000,0000,,Иә, басқалары да.
Dialogue: 0,0:10:06.06,0:10:09.56,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:10:06.06,0:10:09.56,Default,,0000,0000,0000,,Шақырайық
Dialogue: 0,0:10:09.56,0:10:10.53,Rubi,,0000,0000,0000,,Оқиға
Dialogue: 0,0:10:09.56,0:10:10.53,Rubi,,0000,0000,0000,,Ол жай ғана біреудің оны кешіруін қалады ғой, иә?
Dialogue: 0,0:10:09.56,0:10:10.53,Default,,0000,0000,0000,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:10:09.56,0:10:10.53,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:10:09.56,0:10:10.53,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:10:10.53,0:10:12.46,Rubi,,0000,0000,0000,,О
Dialogue: 0,0:10:10.53,0:10:12.46,Default,,0000,0000,0000,,Иә, бұл асыра сілтеу~
Dialogue: 0,0:10:12.46,0:10:14.43,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:10:12.46,0:10:14.43,Rubi,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:10:12.46,0:10:14.43,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:10:12.46,0:10:14.43,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:10:12.46,0:10:14.43,Default,,0000,0000,0000,,()
Dialogue: 0,0:10:12.46,0:10:14.43,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:10:12.46,0:10:14.43,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:10:12.46,0:10:14.43,Default,,0000,0000,0000,,()
Dialogue: 0,0:10:14.43,0:10:18.57,Rubi,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:10:14.43,0:10:18.57,Rubi,,0000,0000,0000,,Тренинг
Dialogue: 0,0:10:14.43,0:10:18.57,Default,,0000,0000,0000,,Барлығы бірге қалып, жаттығу жасайды.
Dialogue: 0,0:10:14.43,0:10:18.57,Rubi,,0000,0000,0000,,Оши
Dialogue: 0,0:10:14.43,0:10:18.57,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:10:14.43,0:10:18.57,Rubi,,0000,0000,0000,,Мана
Dialogue: 0,0:10:14.43,0:10:18.57,Default,,0000,0000,0000,,Бірін-бірі оқыт, бірге үйрен
Dialogue: 0,0:10:18.57,0:10:24.07,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:10:18.57,0:10:24.07,Rubi,,0000,0000,0000,,Ақпарат
Dialogue: 0,0:10:18.57,0:10:24.07,Default,,0000,0000,0000,,Сіз міндетті түрде өтесіз.
Dialogue: 0,0:10:24.07,0:10:26.01,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:10:24.07,0:10:26.01,Default,,0000,0000,0000,,Шынымды айтсам, ауырады, солай ма?
