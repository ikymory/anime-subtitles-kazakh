Dialogue: 0,0:25:27.04,0:25:30.61,Rubi,,0000,0000,0000,,Нему
Dialogue: 0,0:25:27.04,0:25:30.61,Default,,0000,0000,0000,,Мен ұйықтап қалдым
Dialogue: 0,0:25:30.61,0:25:35.11,Rubi,,0000,0000,0000,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:25:30.61,0:25:35.11,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:25:30.61,0:25:35.11,Default,,0000,0000,0000,,Ақшақармен
Dialogue: 0,0:25:30.61,0:25:35.11,Rubi,,0000,0000,0000,,Мұз
Dialogue: 0,0:25:30.61,0:25:35.11,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:25:30.61,0:25:35.11,Rubi,,0000,0000,0000,,Арман
Dialogue: 0,0:25:30.61,0:25:35.11,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:25:30.61,0:25:35.11,Default,,0000,0000,0000,,Мен мұздатылған құлпынай жеуді армандадым＞
