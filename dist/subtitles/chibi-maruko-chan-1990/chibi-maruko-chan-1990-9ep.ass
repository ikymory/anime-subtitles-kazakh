Dialogue: 0,0:10:33.02,0:10:37.89,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:10:33.02,0:10:37.89,Rubi,,0000,0000,0000,,Буши
Dialogue: 0,0:10:33.02,0:10:37.89,Default,,0000,0000,0000,,(『』)
Dialogue: 0,0:10:37.89,0:10:45.03,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:45.03,0:10:48.90,Default,,0000,0000,0000,,Уау! Мару-чан
Dialogue: 0,0:10:45.03,0:10:48.90,Rubi,,0000,0000,0000,,Буши
Dialogue: 0,0:10:45.03,0:10:48.90,Default,,0000,0000,0000,,Судара буши шынымен жақсы.
Dialogue: 0,0:10:48.90,0:10:53.54,Rubi,,0000,0000,0000,,Буши
Dialogue: 0,0:10:48.90,0:10:53.54,Default,,0000,0000,0000,,Ахаха Бірақ Судара аяты
Dialogue: 0,0:10:48.90,0:10:53.54,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:10:48.90,0:10:53.54,Default,,0000,0000,0000,,Өйткені ол сынақта көрсетілмейді.
Dialogue: 0,0:10:53.54,0:10:57.04,Rubi,,0000,0000,0000,,Тофуя
Dialogue: 0,0:10:53.54,0:10:57.04,Default,,0000,0000,0000,,Ах, тофу дүкені және Чарумера.
