Dialogue: 0,0:23:00.60,0:23:04.10,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:23:00.60,0:23:04.10,Rubi,,0000,0000,0000,,Бақытты
Dialogue: 0,0:23:00.60,0:23:04.10,Default,,0000,0000,0000,,Сіз балалық нәрсеге ризасыз ба?
Dialogue: 0,0:23:04.10,0:23:06.04,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:23:04.10,0:23:06.04,Default,,0000,0000,0000,,Себебі бұл қызық.
Dialogue: 0,0:23:06.04,0:23:09.97,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:23:06.04,0:23:09.97,Default,,0000,0000,0000,,Көңілді
Dialogue: 0,0:23:06.04,0:23:09.97,Rubi,,0000,0000,0000,,Оши
Dialogue: 0,0:23:06.04,0:23:09.97,Default,,0000,0000,0000,,Мен саған айтамын, артымнан жүр.
Dialogue: 0,0:23:09.97,0:23:13.61,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:23:09.97,0:23:13.61,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:23:09.97,0:23:13.61,Default,,0000,0000,0000,,Не? Не қызық?
Dialogue: 0,0:23:13.61,0:23:17.11,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:23:13.61,0:23:17.11,Default,,0000,0000,0000,,Менің ойымша, бұл дұрыс.
Dialogue: 0,0:23:13.61,0:23:17.11,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:23:13.61,0:23:17.11,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:23:13.61,0:23:17.11,Default,,0000,0000,0000,,Не? Не?
Dialogue: 0,0:23:17.11,0:23:18.61,Default,,0000,0000,0000,,Нфуфу
Dialogue: 0,0:23:18.61,0:23:22.49,Default,,0000,0000,0000,,Мен саған мынаны беремін.
Dialogue: 0,0:23:22.49,0:23:24.49,Default,,0000,0000,0000,,Бұл құлпынай кәмпит емес
Dialogue: 0,0:23:24.49,0:23:28.62,Rubi,,0000,0000,0000,,Қайдан бастарын білмеймін.
Dialogue: 0,0:23:24.49,0:23:28.62,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:23:24.49,0:23:28.62,Default,,0000,0000,0000,,Ал, аузыңды жап, бір нәрсені айт.
Dialogue: 0,0:23:24.49,0:23:28.62,Rubi,,0000,0000,0000,,Қазір
Dialogue: 0,0:23:24.49,0:23:28.62,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:23:24.49,0:23:28.62,Default,,0000,0000,0000,,Оны аузыңа сал
Dialogue: 0,0:23:28.62,0:23:29.59,Default,,0000,0000,0000,,Бұл дәмді.
Dialogue: 0,0:23:29.59,0:23:33.09,Default,,0000,0000,0000,,Иә, дәмді, бірақ...
Dialogue: 0,0:23:36.13,0:23:38.63,Default,,0000,0000,0000,,Мммм дәмді!
Dialogue: 0,0:23:43.64,0:23:46.14,Default,,0000,0000,0000,,Мүмкін бұл
Dialogue: 0,0:23:43.64,0:23:46.14,Rubi,,0000,0000,0000,,Мұз
Dialogue: 0,0:23:43.64,0:23:46.14,Default,,0000,0000,0000,,Мұзды құлпынай
Dialogue: 0,0:23:46.14,0:23:47.64,Default,,0000,0000,0000,,Түсіндіңіз бе?
Dialogue: 0,0:23:47.64,0:23:50.55,Rubi,,0000,0000,0000,,Мұз
Dialogue: 0,0:23:47.64,0:23:50.55,Rubi,,0000,0000,0000,,Мұз
Dialogue: 0,0:23:47.64,0:23:50.55,Default,,0000,0000,0000,,Бұл мұзды құлпынай. Бұл мұзды құлпынай.
Dialogue: 0,0:23:50.55,0:23:54.05,Rubi,,0000,0000,0000,,Юкими Энсоку
Dialogue: 0,0:23:50.55,0:23:54.05,Default,,0000,0000,0000,,Бұл қарды тамашалау экскурсиясы
Dialogue: 0,0:23:50.55,0:23:54.05,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:23:50.55,0:23:54.05,Default,,0000,0000,0000,,Бұл қызық.
Dialogue: 0,0:23:55.52,0:23:59.16,Rubi,,0000,0000,0000,,Юкияма
Dialogue: 0,0:23:55.52,0:23:59.16,Default,,0000,0000,0000,,Осы қарлы таулардың бәрі
Dialogue: 0,0:23:55.52,0:23:59.16,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:23:55.52,0:23:59.16,Default,,0000,0000,0000,,Жеуге болатын сияқты.
Dialogue: 0,0:23:59.16,0:24:01.66,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:23:59.16,0:24:01.66,Rubi,,0000,0000,0000,,Хитояма
Dialogue: 0,0:23:59.16,0:24:01.66,Default,,0000,0000,0000,,<Соңында бір тау
Dialogue: 0,0:23:59.16,0:24:01.66,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:23:59.16,0:24:01.66,Default,,0000,0000,0000,,Мен оны жей алмадым
Dialogue: 0,0:24:01.66,0:24:05.16,Rubi,,0000,0000,0000,,Рио
Dialogue: 0,0:24:01.66,0:24:05.16,Rubi,,0000,0000,0000,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:24:01.66,0:24:05.16,Default,,0000,0000,0000,,Қардың едәуір мөлшері
Dialogue: 0,0:24:01.66,0:24:05.16,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:24:01.66,0:24:05.16,Rubi,,0000,0000,0000,,Мен қалаймын
Dialogue: 0,0:24:01.66,0:24:05.16,Default,,0000,0000,0000,,Оны екі адам жеді>
Dialogue: 0,0:24:05.16,0:24:07.10,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:24:05.16,0:24:07.10,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:24:05.16,0:24:07.10,Default,,0000,0000,0000,,Үйге кететін уақыт келді!
Dialogue: 0,0:24:07.10,0:24:09.67,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:24:07.10,0:24:09.67,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:24:07.10,0:24:09.67,Default,,0000,0000,0000,,Уау, күт, күт
Dialogue: 0,0:24:09.67,0:24:11.60,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:24:09.67,0:24:11.60,Default,,0000,0000,0000,,Қайда болдың, Сакура?
Dialogue: 0,0:24:11.60,0:24:13.54,Default,,0000,0000,0000,,Ах... эй, эй
Dialogue: 0,0:24:11.60,0:24:13.54,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:24:11.60,0:24:13.54,Default,,0000,0000,0000,,Бір минут күтіңіз
Dialogue: 0,0:24:13.54,0:24:15.54,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:24:13.54,0:24:15.54,Default,,0000,0000,0000,,Қайда бара жатырсың? Мару-чан
Dialogue: 0,0:24:15.54,0:24:17.54,Default,,0000,0000,0000,,Дәретхана~!
Dialogue: 0,0:24:22.11,0:24:24.61,Rubi,,0000,0000,0000,,Осана
Dialogue: 0,0:24:22.11,0:24:24.61,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:22.11,0:24:24.61,Default,,0000,0000,0000,,()～
Dialogue: 0,0:24:24.61,0:24:28.48,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:24:24.61,0:24:28.48,Rubi,,0000,0000,0000,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:24:24.61,0:24:28.48,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:24:24.61,0:24:28.48,Default,,0000,0000,0000,,Мен қардан кәдесый әкелдім.
Dialogue: 0,0:24:24.61,0:24:28.48,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:24:24.61,0:24:28.48,Default,,0000,0000,0000,,Ішіне қара!
Dialogue: 0,0:24:28.48,0:24:33.12,Rubi,,0000,0000,0000,,Юкай
Dialogue: 0,0:24:28.48,0:24:33.12,Default,,0000,0000,0000,,Хахаха Бұл қызық нәрсе.
Dialogue: 0,0:24:28.48,0:24:33.12,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:24:28.48,0:24:33.12,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:24:28.48,0:24:33.12,Default,,0000,0000,0000,,Сіз бұл туралы ойладыңыз. Бұл тамаша.
Dialogue: 0,0:24:33.12,0:24:36.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:24:33.12,0:24:36.12,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:24:33.12,0:24:36.12,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:24:33.12,0:24:36.12,Default,,0000,0000,0000,,Мақтаған әке болды>
Dialogue: 0,0:24:37.63,0:24:39.13,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:24:37.63,0:24:39.13,Default,,0000,0000,0000,,А, ол еріп жатыр.
Dialogue: 0,0:24:39.13,0:24:42.03,Default,,0000,0000,0000,,Аа, мен көмектесе алмаймын.
Dialogue: 0,0:24:42.03,0:24:43.63,Rubi,,0000,0000,0000,,Осана
Dialogue: 0,0:24:42.03,0:24:43.63,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:42.03,0:24:43.63,Default,,0000,0000,0000,,Ей Эй!
Dialogue: 0,0:24:43.63,0:24:46.14,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:43.63,0:24:46.14,Default,,0000,0000,0000,,Ей, Маруко, жетеді.
Dialogue: 0,0:24:46.14,0:24:50.64,Default,,0000,0000,0000,,Ei Ei
Dialogue: 0,0:24:46.14,0:24:50.64,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:24:46.14,0:24:50.64,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:24:46.14,0:24:50.64,Default,,0000,0000,0000,,Шық! Шығу!
Dialogue: 0,0:24:52.64,0:24:57.51,Rubi,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:24:52.64,0:24:57.51,Default,,0000,0000,0000,,Иә! Аз ғана қалды
Dialogue: 0,0:24:52.64,0:24:57.51,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:24:57.51,0:25:00.52,Default,,0000,0000,0000,,Эй, бұл дәмді көрінеді.
Dialogue: 0,0:24:57.51,0:25:00.52,Default,,0000,0000,0000,,(Ходжинс) Бүгіннен бастап мен Автоматты жазу қуыршағының шәкірті болып жұмыс істеймін.
Dialogue: 0,0:25:00.52,0:25:02.65,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:25:02.65,0:25:03.65,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:25:04.59,0:25:09.16,Rubi,,0000,0000,0000,,Ханбун
Dialogue: 0,0:25:04.59,0:25:09.16,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:25:04.59,0:25:09.16,Default,,0000,0000,0000,,А... жартысы анама.
Dialogue: 0,0:25:04.59,0:25:09.16,Default,,0000,0000,0000,,Оны саған беруім керек еді!
Dialogue: 0,0:25:09.16,0:25:11.66,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:25:09.16,0:25:11.66,Default,,0000,0000,0000,,Ақымақ!
Dialogue: 0,0:25:11.66,0:25:15.16,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:25:11.66,0:25:15.16,Rubi,,0000,0000,0000,,Кира
Dialogue: 0,0:25:11.66,0:25:15.16,Default,,0000,0000,0000,,Мен әкемді жек көремін.
Dialogue: 0,0:25:11.66,0:25:15.16,Default,,0000,0000,0000,,Ақымақ
Dialogue: 0,0:25:15.16,0:25:18.07,Default,,0000,0000,0000,,Жетеді, келіңдер.
Dialogue: 0,0:25:18.07,0:25:20.67,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:25:18.07,0:25:20.67,Default,,0000,0000,0000,,Кешіріңіз, Маруко
Dialogue: 0,0:25:20.67,0:25:25.11,Default,,0000,0000,0000,,Вааан Вааан
