Dialogue: 0,00:03:18.42,00:03:20.36,Default,,0000,0000,0000,,Терема
Dialogue: 0,00:03:18.42,00:03:20.36,Default,,0000,0000,0000,,Сіз де әмияныңызды түсірдіңіз бе? ➡
Dialogue: 0,00:03:20.36,00:03:23.93,Rubi,,0000,0000,0000,,Цюю
Dialogue: 0,00:03:20.36,00:03:23.93,Default,,0000,0000,0000,,Жаңбырлы маусым біткен кезде
Dialogue: 0,00:03:20.36,00:03:23.93,Rubi,,0000,0000,0000,,Жазғы демалыс
Dialogue: 0,00:03:20.36,00:03:23.93,Default,,0000,0000,0000,,Жазғы демалыс жақындап қалса да
Dialogue: 0,00:03:20.36,00:03:23.93,Half,,0000,0000,0000,,。
Dialogue: 0,00:03:23.93,00:03:24.90,Default,,0000,0000,0000,,Егер солай болса➡
Dialogue: 0,00:03:24.90,00:03:28.80,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,00:03:24.90,00:03:28.80,Rubi,,0000,0000,0000,,Азу
Dialogue: 0,00:03:24.90,00:03:28.80,Default,,0000,0000,0000,,Марукоға қалдырыңыз.
Dialogue: 0,00:03:24.90,00:03:28.80,Default,,0000,0000,0000,,Жақсы болар еді
Dialogue: 0,00:03:24.90,00:03:28.80,Default,,0000,0000,0000,,Бұл ақымақтық
Dialogue: 0,00:03:24.90,00:03:28.80,Half,,0000,0000,0000,,。
Dialogue: 0,00:03:28.80,00:03:31.80,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,00:03:28.80,00:03:31.80,Rubi,,0000,0000,0000,,болды
Dialogue: 0,00:03:28.80,00:03:31.80,Default,,0000,0000,0000,,Менің тісім ауырады!
Dialogue: 0,00:03:28.80,00:03:31.80,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,00:03:28.80,00:03:31.80,Rubi,,0000,0000,0000,,болды
Dialogue: 0,00:03:28.80,00:03:31.80,Default,,0000,0000,0000,,А...
Dialogue: 0,00:03:28.80,00:03:31.80,Default,,0000,0000,0000,,Сіздің тісіңіз ауырады ма?
Dialogue: 0,00:03:31.80,00:03:34.44,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,00:03:31.80,00:03:34.44,Default,,0000,0000,0000,,Сіз
Dialogue: 0,00:03:31.80,00:03:34.44,Default,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,00:03:31.80,00:03:34.44,Half,,0000,0000,0000,,。
Dialogue: 0,00:03:34.44,00:03:36.94,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,00:03:34.44,00:03:36.94,Rubi,,0000,0000,0000,,Мига
Dialogue: 0,00:03:34.44,00:03:36.94,Half,,0000,0000,0000,,「
Dialogue: 0,00:03:34.44,00:03:36.94,Default,,0000,0000,0000,,Тістеріңізді тазалаңыз
Dialogue: 0,00:03:34.44,00:03:36.94,Half,,0000,0000,0000,,」
Dialogue: 0,00:03:34.44,00:03:36.94,Default,,0000,0000,0000,,Жарайды, екеу болсын.
Dialogue: 0,00:03:34.44,00:03:36.94,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,00:03:34.44,00:03:36.94,Default,,0000,0000,0000,,Като-чан да айтты!
Dialogue: 0,00:03:36.94,00:03:38.88,Default,,0000,0000,0000,,Ах~
Dialogue: 0,00:03:36.94,00:03:38.88,Default,,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,00:03:36.94,00:03:38.88,Half,,0000,0000,0000,,。
Dialogue: 0,00:03:38.88,00:03:40.81,Rubi,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,00:03:38.88,00:03:40.81,Default,,0000,0000,0000,,Мен оны сіздермен бөліскім келеді.
Dialogue: 0,00:03:38.88,00:03:40.81,Rubi,,0000,0000,0000,,болды
Dialogue: 0,00:03:38.88,00:03:40.81,Default,,0000,0000,0000,,Бұл ауырсыну
Dialogue: 0,00:03:38.88,00:03:40.81,Half,,0000,0000,0000,,。
Dialogue: 0,00:03:40.81,00:03:42.81,Default,,0000,0000,0000,,Хэхе~
Dialogue: 0,00:03:40.81,00:03:42.81,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,00:03:40.81,00:03:42.81,Default,,0000,0000,0000,,Өзің бар
Dialogue: 0,00:03:40.81,00:03:42.81,Default,,0000,0000,0000,,Маруко бұл➡
Dialogue: 0,00:03:42.81,00:03:45.45,Default,,0000,0000,0000,,Хэчарапи~
Dialogue: 0,00:03:42.81,00:03:45.45,Rubi,,0000,0000,0000,,Мига
Dialogue: 0,00:03:42.81,00:03:45.45,Default,,0000,0000,0000,,Әрқашан жылтыратылған және жылтыр~
Dialogue: 0,00:03:42.81,00:03:45.45,Half,,0000,0000,0000,,。
Dialogue: 0,00:03:45.45,00:03:47.95,Rubi,,0000,0000,0000,,Широ
Dialogue: 0,00:03:45.45,00:03:47.95,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,00:03:45.45,00:03:47.95,Default,,0000,0000,0000,,Ақ тістер
Dialogue: 0,00:03:45.45,00:03:47.95,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,00:03:47.95,00:03:50.86,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,00:03:47.95,00:03:50.86,Half,,0000,0000,0000,,（
Dialogue: 0,00:03:47.95,00:03:50.86,Default,,0000,0000,0000,,Күлгін
Dialogue: 0,00:03:47.95,00:03:50.86,Half,,0000,0000,0000,,）
Dialogue: 0,00:03:47.95,00:03:50.86,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,00:03:47.95,00:03:50.86,Default,,0000,0000,0000,,Қараңыз
Dialogue: 0,00:03:47.95,00:03:50.86,Rubi,,0000,0000,0000,,Сақтандыру
Dialogue: 0,00:03:47.95,00:03:50.86,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,00:03:47.95,00:03:50.86,Default,,0000,0000,0000,,Сақтандыру картасы
Dialogue: 0,00:03:47.95,00:03:50.86,Default,,0000,0000,0000,,Мен оны шығарып алдым.
Dialogue: 0,00:03:47.95,00:03:50.86,Half,,0000,0000,0000,,。
Dialogue: 0,00:03:47.95,00:03:50.86,Default,,0000,0000,0000,,➡
Dialogue: 0,00:03:50.86,00:03:53.46,Rubi,,0000,0000,0000,,Хиша
Dialogue: 0,00:03:50.86,00:03:53.46,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,00:03:50.86,00:03:53.46,Default,,0000,0000,0000,,Тіс дәрігері
Dialogue: 0,00:03:50.86,00:03:53.46,Default,,0000,0000,0000,,Толып кетпес бұрын
Dialogue: 0,00:03:50.86,00:03:53.46,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,00:03:50.86,00:03:53.46,Default,,0000,0000,0000,,Барғаныңыз жөн.
Dialogue: 0,00:03:50.86,00:03:53.46,Half,,0000,0000,0000,,。
Dialogue: 0,00:03:53.46,00:03:55.99,Half,,0000,0000,0000,,（
