Dialogue: 0,00:03:53.46,00:03:55.99,Half,,0000,0000,0000,,）
Dialogue: 0,00:03:53.46,00:03:55.99,Default,,0000,0000,0000,,Ах~
Dialogue: 0,00:03:53.46,00:03:55.99,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,00:03:53.46,00:03:55.99,Half,,0000,0000,0000,,。
Dialogue: 0,00:03:55.99,00:03:59.46,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,00:03:55.99,00:03:59.46,Rubi,,0000,0000,0000,,Сен Елдияны қалпына келтірушілердің қалдығының бірісің бе?
Dialogue: 0,00:03:55.99,00:03:59.46,Default,,0000,0000,0000,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,00:03:55.99,00:03:59.46,Default,,0000,0000,0000,,Маған қуыстарыңызды көрсетіңіз
Dialogue: 0,00:03:55.99,00:03:59.46,Half,,0000,0000,0000,,。
Dialogue: 0,00:03:55.99,00:03:59.46,Default,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,00:03:59.46,00:04:02.37,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,00:03:59.46,00:04:02.37,Default,,0000,0000,0000,,Мынаны қараңыз.
Dialogue: 0,00:03:59.46,00:04:02.37,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,00:03:59.46,00:04:02.37,Half,,0000,0000,0000,,。
Dialogue: 0,00:04:02.37,00:04:04.97,Rubi,,0000,0000,0000,,Көресіңдер әлі
Dialogue: 0,00:04:02.37,00:04:04.97,Default,,0000,0000,0000,,(Каишо) Қорықпа—ағамның қаны менікімен бірдей қасиетке ие емес.
Dialogue: 0,00:04:02.37,00:04:04.97,Default,,0000,0000,0000,,Ол азаймайды.
Dialogue: 0,00:04:02.37,00:04:04.97,Half,,0000,0000,0000,,。
Dialogue: 0,00:04:04.97,00:04:05.94,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,00:04:05.94,00:04:08.47,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,00:04:05.94,00:04:08.47,Default,,0000,0000,0000,,Эй, эй
Dialogue: 0,00:04:05.94,00:04:08.47,Default,,0000,0000,0000,,Маған көрсет.
Dialogue: 0,00:04:05.94,00:04:08.47,Half,,0000,0000,0000,,。
Dialogue: 0,00:04:08.47,00:04:10.41,Default,,0000,0000,0000,,Ах~
Dialogue: 0,00:04:08.47,00:04:10.41,Default,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,00:04:08.47,00:04:10.41,Default,,0000,0000,0000,,О? Біреуге ғашық болдың ба?
Dialogue: 0,00:04:10.41,00:04:13.38,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,00:04:10.41,00:04:13.38,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,00:04:10.41,00:04:13.38,Default,,0000,0000,0000,,Көбірек айту
Dialogue: 0,00:04:10.41,00:04:13.38,Default,,0000,0000,0000,,Соқ!
Dialogue: 0,00:04:10.41,00:04:13.38,Rubi,,0000,0000,0000,,О, құдай!
Dialogue: 0,00:04:10.41,00:04:13.38,Rubi,,0000,0000,0000,,Ол жай ғана біреудің оны кешіруін қалады ғой, иә?
Dialogue: 0,00:04:10.41,00:04:13.38,Half,,0000,0000,0000,,（
Dialogue: 0,00:04:10.41,00:04:13.38,Default,,0000,0000,0000,,Дөрекі аяқ дыбыстары
Dialogue: 0,00:04:10.41,00:04:13.38,Half,,0000,0000,0000,,）
Dialogue: 0,00:04:13.38,00:04:16.31,Rubi,,0000,0000,0000,,болды
Dialogue: 0,00:04:13.38,00:04:16.31,Default,,0000,0000,0000,,Міне, осы
Dialogue: 0,00:04:13.38,00:04:16.31,Default,,0000,0000,0000,,Бұл өте ауыр көрінеді.
Dialogue: 0,00:04:13.38,00:04:16.31,Half,,0000,0000,0000,,。
Dialogue: 0,00:04:13.38,00:04:16.31,Default,,0000,0000,0000,,Иә!
Dialogue: 0,00:04:16.31,00:04:18.28,Rubi,,0000,0000,0000,,О-
Dialogue: 0,00:04:16.31,00:04:18.28,Rubi,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,00:04:16.31,00:04:18.28,Rubi,,0000,0000,0000,,Хира
Dialogue: 0,00:04:16.31,00:04:18.28,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,00:04:16.31,00:04:18.28,Half,,0000,0000,0000,,（
Dialogue: 0,00:04:16.31,00:04:18.28,Default,,0000,0000,0000,,Жылжымалы есіктің ашылу дыбысы
Dialogue: 0,00:04:16.31,00:04:18.28,Half,,0000,0000,0000,,）
Dialogue: 0,00:04:16.31,00:04:18.28,Default,,0000,0000,0000,,Секір!!
Dialogue: 0,00:04:16.31,00:04:18.28,Default,,0000,0000,0000,,Келіңіздер...
Dialogue: 0,00:04:16.31,00:04:18.28,Half,,0000,0000,0000,,。
Dialogue: 0,00:04:18.28,00:04:20.92,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,00:04:18.28,00:04:20.92,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,00:04:18.28,00:04:20.92,Default,,0000,0000,0000,,Сәттілік!
Dialogue: 0,00:04:18.28,00:04:20.92,Default,,0000,0000,0000,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,00:04:20.92,00:04:22.85,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,00:04:20.92,00:04:22.85,Default,,0000,0000,0000,,Мені қорқытпа
Dialogue: 0,00:04:20.92,00:04:22.85,Default,,0000,0000,0000,,Бака Маруко
Dialogue: 0,00:04:20.92,00:04:22.85,Half,,0000,0000,0000,,。
Dialogue: 0,00:04:22.85,00:04:24.42,Rubi,,0000,0000,0000,,Ikio
Dialogue: 0,00:04:22.85,00:04:24.42,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,00:04:22.85,00:04:24.42,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,00:04:22.85,00:04:24.42,Half,,0000,0000,0000,,（
Dialogue: 0,00:04:22.85,00:04:24.42,Default,,0000,0000,0000,,Күшті жабылу дыбысы
Dialogue: 0,00:04:22.85,00:04:24.42,Half,,0000,0000,0000,,）
Dialogue: 0,00:04:24.42,00:04:26.93,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,00:04:24.42,00:04:26.93,Default,,0000,0000,0000,,Не?
Dialogue: 0,00:04:24.42,00:04:26.93,Rubi,,0000,0000,0000,,Оуен
Dialogue: 0,00:04:24.42,00:04:26.93,Default,,0000,0000,0000,,Мен сені қолдаймын деп барын салып кетсем де.
