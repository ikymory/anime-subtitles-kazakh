Dialogue: 0,0:23:28.30,0:23:31.80,Default,,0000,0000,0000,,Мен сынып өкілі болдым
Dialogue: 0,0:23:28.30,0:23:31.80,Rubi,,0000,0000,0000,,Тосен
Dialogue: 0,0:23:28.30,0:23:31.80,Default,,0000,0000,0000,,Жеңіске жеткен Акацуки үшін
Dialogue: 0,0:23:31.80,0:23:37.31,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:23:31.80,0:23:37.31,Rubi,,0000,0000,0000,,Тазалау
Dialogue: 0,0:23:31.80,0:23:37.31,Rubi,,0000,0000,0000,,Кокубан
Dialogue: 0,0:23:31.80,0:23:37.31,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
