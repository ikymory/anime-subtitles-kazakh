Dialogue: 0,0:08:58.73,0:09:00.66,Default,,0000,0000,0000,,《Гесори…》
Dialogue: 0,0:09:00.66,0:09:02.60,Default,,0000,0000,0000,,Иә, онда
Dialogue: 0,0:09:02.60,0:09:05.24,Default,,0000,0000,0000,,Ол басқаларға да пайдалы болуы мүмкін.
Dialogue: 0,0:09:02.60,0:09:05.24,Default,,0000,0000,0000,,Мен көбірек істеуім керек~
Dialogue: 0,0:09:05.24,0:09:08.14,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:09:05.24,0:09:08.14,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:09:05.24,0:09:08.14,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:09:05.24,0:09:08.14,Default,,0000,0000,0000,,Анаң сенен бірдеңе сұраса
Dialogue: 0,0:09:05.24,0:09:08.14,Default,,0000,0000,0000,,Оны тез орындаңыз
Dialogue: 0,0:09:08.14,0:09:09.74,Default,,0000,0000,0000,,《Жіренішті...》
Dialogue: 0,0:09:09.74,0:09:13.61,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:09:09.74,0:09:13.61,Default,,0000,0000,0000,,Дұрыс, сынып өкілі
Dialogue: 0,0:09:09.74,0:09:13.61,Rubi,,0000,0000,0000,,Күн сайын
Dialogue: 0,0:09:09.74,0:09:13.61,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:09:09.74,0:09:13.61,Default,,0000,0000,0000,,Күн сайын күрес!
Dialogue: 0,0:09:13.61,0:09:16.61,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:09:13.61,0:09:16.61,Default,,0000,0000,0000,,<Енді «сынып» емес
Dialogue: 0,0:09:13.61,0:09:16.61,Rubi,,0000,0000,0000,,Жақсы
Dialogue: 0,0:09:13.61,0:09:16.61,Default,,0000,0000,0000,,«Комитет мүшесі» емес＞
Dialogue: 0,0:09:16.61,0:09:21.11,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:09:16.61,0:09:21.11,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:09:16.61,0:09:21.11,Default,,0000,0000,0000,,Ә... Әке-ана
Dialogue: 0,0:09:16.61,0:09:21.11,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:09:16.61,0:09:21.11,Default,,0000,0000,0000,,Болды, мен өлдім.
Dialogue: 0,0:09:25.22,0:09:27.69,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:09:27.69,0:09:29.63,Default,,0000,0000,0000,,Әй, жүрегім лүпілдеп тұр
Dialogue: 0,0:09:29.63,0:09:33.20,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:09:29.63,0:09:33.20,Default,,0000,0000,0000,,Сынып өкілі дегеніміз не?
Dialogue: 0,0:09:29.63,0:09:33.20,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:29.63,0:09:33.20,Rubi,,0000,0000,0000,,Цуто
Dialogue: 0,0:09:29.63,0:09:33.20,Default,,0000,0000,0000,,Қызық, Маруко мен үшін жұмыс істей ме?
Dialogue: 0,0:09:33.20,0:09:35.13,Rubi,,0000,0000,0000,,Китей
Dialogue: 0,0:09:33.20,0:09:35.13,Rubi,,0000,0000,0000,,Шинпай
Dialogue: 0,0:09:33.20,0:09:35.13,Default,,0000,0000,0000,,Шешім қабылдағаннан кейін уайымдауым керек пе?
Dialogue: 0,0:09:35.13,0:09:37.70,Rubi,,0000,0000,0000,,Кенмей
Dialogue: 0,0:09:35.13,0:09:37.70,Rubi,,0000,0000,0000,,Go
Dialogue: 0,0:09:35.13,0:09:37.70,Default,,0000,0000,0000,,<Бұл өте дана пікір>
Dialogue: 0,0:09:37.70,0:09:39.70,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:09:37.70,0:09:39.70,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:09:37.70,0:09:39.70,Default,,0000,0000,0000,,Енді жат, жат.
Dialogue: 0,0:09:44.21,0:09:47.71,Default,,0000,0000,0000,,бұл...
Dialogue: 0,0:09:47.71,0:09:52.21,Rubi,,0000,0000,0000,,Конго
Dialogue: 0,0:09:47.71,0:09:52.21,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:09:47.71,0:09:52.21,Default,,0000,0000,0000,,Болашақ туралы ойлау
Dialogue: 0,0:09:47.71,0:09:52.21,Rubi,,0000,0000,0000,,Нему
Dialogue: 0,0:09:47.71,0:09:52.21,Default,,0000,0000,0000,,Мен ұйықтай алмаймын... ха...
Dialogue: 0,0:09:55.22,0:09:57.72,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:09:55.22,0:09:57.72,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:09:55.22,0:09:57.72,Default,,0000,0000,0000,,《Сіз
Dialogue: 0,0:09:55.22,0:09:57.72,Rubi,,0000,0000,0000,,Жақсы
Dialogue: 0,0:09:55.22,0:09:57.72,Rubi,,0000,0000,0000,,Яквари
Dialogue: 0,0:09:55.22,0:09:57.72,Default,,0000,0000,0000,,Сынып мүшесі ретіндегі рөл
Dialogue: 0,0:09:57.72,0:10:00.62,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,0:09:57.72,0:10:00.62,Default,,0000,0000,0000,,Өйткені олар өз міндеттерін дұрыс орындамайды
Dialogue: 0,0:09:57.72,0:10:00.62,Default,,0000,0000,0000,,Сыныптың бәрі тәртіпсіз! 》
Dialogue: 0,0:10:00.62,0:10:03.23,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:10:00.62,0:10:03.23,Default,,0000,0000,0000,,《Мұны қалай жоюға болады
Dialogue: 0,0:10:00.62,0:10:03.23,Default,,0000,0000,0000,,Не істеуіміз керек, Сакура?
Dialogue: 0,0:10:03.23,0:10:05.16,Default,,0000,0000,0000,,《Кешіріңіз...》
Dialogue: 0,0:10:05.16,0:10:11.10,Default,,0000,0000,0000,,《Уау~ Не істеуім керек? Ах...》
Dialogue: 0,0:10:11.10,0:10:13.74,Rubi,,0000,0000,0000,,Джитай
Dialogue: 0,0:10:11.10,0:10:13.74,Default,,0000,0000,0000,,Сіз бас тартуыңыз керек пе?
Dialogue: 0,0:10:13.74,0:10:15.24,Default,,0000,0000,0000,,Бірақ солай
Dialogue: 0,0:10:15.24,0:10:19.74,Rubi,,0000,0000,0000,,Нарғызгүл
Dialogue: 0,0:10:15.24,0:10:19.74,Default,,0000,0000,0000,,Маған кеңес беруге қиналдың.
Dialogue: 0,0:10:15.24,0:10:19.74,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:10:15.24,0:10:19.74,Default,,0000,0000,0000,,Мен Юмико-чанға ренжідім...
Dialogue: 0,0:10:19.74,0:10:23.61,Default,,0000,0000,0000,,Ах~ Эй
Dialogue: 0,0:10:19.74,0:10:23.61,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:10:19.74,0:10:23.61,Default,,0000,0000,0000,,Не істейміз, апа!
Dialogue: 0,0:10:23.61,0:10:28.18,Rubi,,0000,0000,0000,,Бір рет
Dialogue: 0,0:10:23.61,0:10:28.18,Rubi,,0000,0000,0000,,Ная
Dialogue: 0,0:10:23.61,0:10:28.18,Default,,0000,0000,0000,,Өзіңізді уайымдамаңыз...
Dialogue: 0,0:10:23.61,0:10:28.18,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:10:23.61,0:10:28.18,Rubi,,0000,0000,0000,,Нему
Dialogue: 0,0:10:23.61,0:10:28.18,Default,,0000,0000,0000,,Мен ұйықтап жатырмын
Dialogue: 0,0:10:28.18,0:10:32.68,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:10:28.18,0:10:32.68,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:10:28.18,0:10:32.68,Default,,0000,0000,0000,,Әпкеңнің жүрексіздігі!
Dialogue: 0,0:10:28.18,0:10:32.68,Default,,0000,0000,0000,,Бұл осар
Dialogue: 0,0:10:36.69,0:10:39.20,Rubi,,0000,0000,0000,,Iso
Dialogue: 0,0:10:36.69,0:10:39.20,Default,,0000,0000,0000,,...
Dialogue: 0,0:10:36.69,0:10:39.20,Rubi,,0000,0000,0000,,Чикоку
Dialogue: 0,0:10:36.69,0:10:39.20,Default,,0000,0000,0000,,Сіз кешігіп қаласыз!
Dialogue: 0,0:10:39.20,0:10:41.70,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:10:39.20,0:10:41.70,Default,,0000,0000,0000,,(Маруко/Сакико)
Dialogue: 0,0:10:39.20,0:10:41.70,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:10:45.07,0:10:49.21,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:10:45.07,0:10:49.21,Default,,0000,0000,0000,,Хмм, әпке
Dialogue: 0,0:10:45.07,0:10:49.21,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:49.21,0:10:52.71,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:10:49.21,0:10:52.71,Rubi,,0000,0000,0000,,Фуку
Dialogue: 0,0:10:49.21,0:10:52.71,Default,,0000,0000,0000,,Бүгін осы киімде
Dialogue: 0,0:10:49.21,0:10:52.71,Rubi,,0000,0000,0000,,Шинрай
Dialogue: 0,0:10:49.21,0:10:52.71,Rubi,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:10:49.21,0:10:52.71,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:10:49.21,0:10:52.71,Default,,0000,0000,0000,,Сіз барлық адамдардың сенімін ақтай аламын деп ойлайсыз ба?
Dialogue: 0,0:10:52.71,0:10:55.61,Rubi,,0000,0000,0000,,Жалаңаш
Dialogue: 0,0:10:52.71,0:10:55.61,Default,,0000,0000,0000,,Неғұрлым жарқыраған болса, соғұрлым жақсы
Dialogue: 0,0:10:52.71,0:10:55.61,Default,,0000,0000,0000,,Жақсы болды ма?
Dialogue: 0,0:10:55.61,0:10:59.22,Rubi,,0000,0000,0000,,Ая
Dialogue: 0,0:10:55.61,0:10:59.22,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:10:55.61,0:10:59.22,Default,,0000,0000,0000,,Себебі ол күдікті сезінбейді.
Dialogue: 0,0:10:55.61,0:10:59.22,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:10:55.61,0:10:59.22,Default,,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:10:59.22,0:11:02.72,Default,,0000,0000,0000,,Әй, жүрегім лүпілдеп тұр
Dialogue: 0,0:10:59.22,0:11:02.72,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:10:59.22,0:11:02.72,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:10:59.22,0:11:02.72,Default,,0000,0000,0000,,Жақында мектепті көресіз
Dialogue: 0,0:11:02.72,0:11:05.22,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:11:02.72,0:11:05.22,Default,,0000,0000,0000,,Егер Маруко
Dialogue: 0,0:11:02.72,0:11:05.22,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:11:02.72,0:11:05.22,Default,,0000,0000,0000,,Сынып өкілі болған кезде
Dialogue: 0,0:11:05.22,0:11:11.09,Rubi,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:11:05.22,0:11:11.09,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:11:05.22,0:11:11.09,Rubi,,0000,0000,0000,,Ұзын
Dialogue: 0,0:11:05.22,0:11:11.09,Default,,0000,0000,0000,,Үзіліс уақытын ұзартыңыз
Dialogue: 0,0:11:05.22,0:11:11.09,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:11:05.22,0:11:11.09,Rubi,,0000,0000,0000,,Көресіңдер әлі
Dialogue: 0,0:11:05.22,0:11:11.09,Rubi,,0000,0000,0000,,Дорёку
Dialogue: 0,0:11:05.22,0:11:11.09,Default,,0000,0000,0000,,Үйге тапсырма Мен оны қысқартуға тырысамын.
Dialogue: 0,0:11:11.09,0:11:15.73,Default,,0000,0000,0000,,Егер мұны істегіңіз келсе.
Dialogue: 0,0:11:11.09,0:11:15.73,Rubi,,0000,0000,0000,,Бүгін барасың ба?
Dialogue: 0,0:11:11.09,0:11:15.73,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:11:11.09,0:11:15.73,Rubi,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:11:11.09,0:11:15.73,Default,,0000,0000,0000,,Білім кеңесіне кірмейінше, істей алмайсың.
Dialogue: 0,0:11:15.73,0:11:17.23,Default,,0000,0000,0000,,Сәлем, қайырлы таң
Dialogue: 0,0:11:17.23,0:11:19.73,Rubi,,0000,0000,0000,,Кун
Dialogue: 0,0:11:17.23,0:11:19.73,Default,,0000,0000,0000,,Қайырлы таң, Эбису-кун.
Dialogue: 0,0:11:17.23,0:11:19.73,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:11:23.74,0:11:25.24,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:11:23.74,0:11:25.24,Rubi,,0000,0000,0000,,Сенкио
Dialogue: 0,0:11:23.74,0:11:25.24,Default,,0000,0000,0000,,Бүгін сайлау.
Dialogue: 0,0:11:25.24,0:11:28.14,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:11:25.24,0:11:28.14,Default,,0000,0000,0000,,Сәлем, Маруко?
Dialogue: 0,0:11:25.24,0:11:28.14,Rubi,,0000,0000,0000,,Фуру
Dialogue: 0,0:11:25.24,0:11:28.14,Default,,0000,0000,0000,,Мен дірілдеп жатырмын~
Dialogue: 0,0:11:28.14,0:11:30.75,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:11:28.14,0:11:30.75,Default,,0000,0000,0000,,Ах! Бұл не?
Dialogue: 0,0:11:30.75,0:11:31.75,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:11:37.62,0:11:39.76,Rubi,,0000,0000,0000,,Сенкио
Dialogue: 0,0:11:37.62,0:11:39.76,Default,,0000,0000,0000,,Бұл сайлау плакаты емес пе?
Dialogue: 0,0:11:37.62,0:11:39.76,Default,,0000,0000,0000,,Хаха… бұл қызық екен.
Dialogue: 0,0:11:39.76,0:11:43.26,Rubi,,0000,0000,0000,,Маруо-кун
Dialogue: 0,0:11:39.76,0:11:43.26,Default,,0000,0000,0000,,Маруо-кун
Dialogue: 0,0:11:39.76,0:11:43.26,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:11:39.76,0:11:43.26,Default,,0000,0000,0000,,Сіз постер жасадыңыз ба?
Dialogue: 0,0:11:43.26,0:11:48.13,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:43.26,0:11:48.13,Rubi,,0000,0000,0000,,Денчу
Dialogue: 0,0:11:43.26,0:11:48.13,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,0:11:43.26,0:11:48.13,Default,,0000,0000,0000,,Ол телефон бағандарына да ілінген...
Dialogue: 0,0:11:48.13,0:11:50.13,Default,,0000,0000,0000,,Онда да!
Dialogue: 0,0:11:50.13,0:11:52.27,Default,,0000,0000,0000,,А, мұнда да...
Dialogue: 0,0:11:52.27,0:11:54.77,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:11:52.27,0:11:54.77,Default,,0000,0000,0000,,Эй, мен оны білдім.
Dialogue: 0,0:11:54.77,0:11:57.67,Rubi,,0000,0000,0000,,Кокороики
Dialogue: 0,0:11:54.77,0:11:57.67,Default,,0000,0000,0000,,Сізде осындай шешімділік деңгейі болуы керек.
Dialogue: 0,0:11:54.77,0:11:57.67,Default,,0000,0000,0000,,Мүмкін емес пе?
Dialogue: 0,0:11:57.67,0:12:00.64,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:11:57.67,0:12:00.64,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:11:57.67,0:12:00.64,Default,,0000,0000,0000,,Мұндай адамның қалыптан тыс мінез-құлқы
Dialogue: 0,0:11:57.67,0:12:00.64,Default,,0000,0000,0000,,Оған еліктеу үшін не істеуім керек?
Dialogue: 0,0:12:00.64,0:12:03.78,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:12:00.64,0:12:03.78,Default,,0000,0000,0000,,Дұрыс, мен жай ғана сынып өкілі емеспін.
Dialogue: 0,0:12:03.78,0:12:06.28,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:12:03.78,0:12:06.28,Default,,0000,0000,0000,,Уау, мынаны қара!
Dialogue: 0,0:12:06.28,0:12:12.16,Rubi,,0000,0000,0000,,Маруо-кун
Dialogue: 0,0:12:06.28,0:12:12.16,Rubi,,0000,0000,0000,,Тохьюши
Dialogue: 0,0:12:06.28,0:12:12.16,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:12:06.28,0:12:12.16,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:12:06.28,0:12:12.16,Default,,0000,0000,0000,,Маруо-кун Сайлау бюллетенін қалай толтырады
Dialogue: 0,0:12:06.28,0:12:12.16,Rubi,,0000,0000,0000,,Сецумэй
Dialogue: 0,0:12:06.28,0:12:12.16,Default,,0000,0000,0000,,Мен түсіндіремін.
Dialogue: 0,0:12:12.16,0:12:15.79,Rubi,,0000,0000,0000,,Аздап
Dialogue: 0,0:12:12.16,0:12:15.79,Default,,0000,0000,0000,,Бұл жігіт жақсы.
Dialogue: 0,0:12:12.16,0:12:15.79,Rubi,,0000,0000,0000,,Ақаулық
Dialogue: 0,0:12:12.16,0:12:15.79,Default,,0000,0000,0000,,Сен маған жақсы қарайсың.
Dialogue: 0,0:12:15.79,0:12:18.29,Rubi,,0000,0000,0000,,Құдайлар
