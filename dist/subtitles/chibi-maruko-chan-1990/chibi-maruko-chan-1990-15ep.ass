Dialogue: 0,0:24:42.30,0:24:46.81,Default,,0000,0000,0000,,Мен де Маруо-кун сияқтымын.
Dialogue: 0,0:24:42.30,0:24:46.81,Rubi,,0000,0000,0000,,Шұңқыр
Dialogue: 0,0:24:42.30,0:24:46.81,Rubi,,0000,0000,0000,,Джитай
Dialogue: 0,0:24:42.30,0:24:46.81,Default,,0000,0000,0000,,Менде құмарлық жоқ, сондықтан мен бас тартамын.
Dialogue: 0,0:24:46.81,0:24:49.71,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:24:46.81,0:24:49.71,Default,,0000,0000,0000,,《Анық
Dialogue: 0,0:24:46.81,0:24:49.71,Default,,0000,0000,0000,,Бұл Таларан болар еді! 》
Dialogue: 0,0:24:49.71,0:24:52.31,Default,,0000,0000,0000,,《Rulurun Rulurun》
Dialogue: 0,0:24:52.31,0:24:55.82,Rubi,,0000,0000,0000,,«және күн сайын күрсінемін.»
Dialogue: 0,0:24:52.31,0:24:55.82,Default,,0000,0000,0000,,Менің бір ісім бар.
Dialogue: 0,0:24:52.31,0:24:55.82,Rubi,,0000,0000,0000,,Бұл қызықсыз болды
Dialogue: 0,0:24:52.31,0:24:55.82,Default,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:24:55.82,0:24:57.32,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:24:57.32,0:25:00.22,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:24:57.32,0:25:00.22,Rubi,,0000,0000,0000,,Маруо-кун
Dialogue: 0,0:24:57.32,0:25:00.22,Default,,0000,0000,0000,,Әй, Маруо-кун!
