Dialogue: 0,0:22:30.14,0:22:34.74,Rubi,,0000,0000,0000,,Орын
Dialogue: 0,0:22:30.14,0:22:34.74,Default,,0000,0000,0000,,Ханава деп аталатын адам
Dialogue: 0,0:22:30.14,0:22:34.74,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:22:30.14,0:22:34.74,Rubi,,0000,0000,0000,,қою
Dialogue: 0,0:22:30.14,0:22:34.74,Rubi,,0000,0000,0000,,Үрлемелі
Dialogue: 0,0:22:30.14,0:22:34.74,Rubi,,0000,0000,0000,,Джинбутсу
Dialogue: 0,0:22:30.14,0:22:34.74,Default,,0000,0000,0000,,Ол біршама терең адам.
Dialogue: 0,0:22:34.74,0:22:40.25,Rubi,,0000,0000,0000,,Сіз
Dialogue: 0,0:22:34.74,0:22:40.25,Rubi,,0000,0000,0000,,Қоңқай
Dialogue: 0,0:22:34.74,0:22:40.25,Default,,0000,0000,0000,,Бұл жолы сен менің қарсыласым емессің
Dialogue: 0,0:22:34.74,0:22:40.25,Default,,0000,0000,0000,,Бұл жақсы болды хахаха...
Dialogue: 0,0:22:40.25,0:22:43.75,Default,,0000,0000,0000,,<Соңында
Dialogue: 0,0:22:40.25,0:22:43.75,Rubi,,0000,0000,0000,,Кезең
Dialogue: 0,0:22:40.25,0:22:43.75,Default,,0000,0000,0000,,Бесінші сағат келді>
Dialogue: 0,0:22:43.75,0:22:46.26,Default,,0000,0000,0000,,Ах~ Міне, осында.
Dialogue: 0,0:22:46.26,0:22:48.76,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:46.26,0:22:48.76,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:46.26,0:22:48.76,Default,,0000,0000,0000,,Маруко Марукомен не істеуіміз керек...
Dialogue: 0,0:22:50.13,0:22:54.13,Default,,0000,0000,0000,,Енді
Dialogue: 0,0:22:50.13,0:22:54.13,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:22:50.13,0:22:54.13,Rubi,,0000,0000,0000,,Сенкио
Dialogue: 0,0:22:50.13,0:22:54.13,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:22:50.13,0:22:54.13,Default,,0000,0000,0000,,Сынып комиссиясын сайлау басталады
Dialogue: 0,0:22:54.13,0:22:56.77,Rubi,,0000,0000,0000,,Кохо
Dialogue: 0,0:22:54.13,0:22:56.77,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:22:54.13,0:22:56.77,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:22:54.13,0:22:56.77,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:22:54.13,0:22:56.77,Default,,0000,0000,0000,,Үміткерлер келіңіздер.
Dialogue: 0,0:22:56.77,0:22:59.67,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:22:56.77,0:22:59.67,Default,,0000,0000,0000,,Мару-чан Мару-чан!
Dialogue: 0,0:22:59.67,0:23:01.64,Default,,0000,0000,0000,,Ха…
Dialogue: 0,0:23:01.64,0:23:03.64,Rubi,,0000,0000,0000,,Ганба
Dialogue: 0,0:23:01.64,0:23:03.64,Default,,0000,0000,0000,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:23:07.78,0:23:11.78,Rubi,,0000,0000,0000,,Сото
Dialogue: 0,0:23:07.78,0:23:11.78,Default,,0000,0000,0000,,Мару-чан, сен қатты толқыдың...
Dialogue: 0,0:23:07.78,0:23:11.78,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:23:07.78,0:23:11.78,Default,,0000,0000,0000,,Мен оны шынымен көрмеймін.
Dialogue: 0,0:23:17.29,0:23:21.16,Rubi,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
