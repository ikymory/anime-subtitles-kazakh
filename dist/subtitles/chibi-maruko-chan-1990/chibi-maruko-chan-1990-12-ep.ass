Dialogue: 0,0:07:45.49,0:07:46.99,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:45.49,0:07:46.99,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:07:45.49,0:07:46.99,Rubi,,0000,0000,0000,,Хаккен
Dialogue: 0,0:07:45.49,0:07:46.99,Rubi,,0000,0000,0000,,Жағдайда
Dialogue: 0,0:07:45.49,0:07:46.99,Default,,0000,0000,0000,,Егер тіршілік иесінің жаңа түрі ашылса
Dialogue: 0,0:07:46.99,0:07:50.50,Rubi,,0000,0000,0000,,Гаккай
Dialogue: 0,0:07:46.99,0:07:50.50,Default,,0000,0000,0000,,Академияға қалай келдіңіз?
Dialogue: 0,0:07:46.99,0:07:50.50,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:07:46.99,0:07:50.50,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:07:46.99,0:07:50.50,Default,,0000,0000,0000,,Мен бұл туралы хабарлауым керек деп ойлайсыз ба?
Dialogue: 0,0:07:50.50,0:07:52.00,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:07:50.50,0:07:52.00,Default,,0000,0000,0000,,Және
Dialogue: 0,0:07:52.00,0:07:55.50,Rubi,,0000,0000,0000,,Орын
Dialogue: 0,0:07:52.00,0:07:55.50,Rubi,,0000,0000,0000,,Шобай
Dialogue: 0,0:07:52.00,0:07:55.50,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:07:52.00,0:07:55.50,Default,,0000,0000,0000,,Жаңа бизнесті бастау үшін
Dialogue: 0,0:07:52.00,0:07:55.50,Rubi,,0000,0000,0000,,Токио
Dialogue: 0,0:07:52.00,0:07:55.50,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:07:52.00,0:07:55.50,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:07:52.00,0:07:55.50,Default,,0000,0000,0000,,Патентті қалай алуға болады?
Dialogue: 0,0:07:55.50,0:07:56.47,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:56.47,0:07:58.41,Rubi,,0000,0000,0000,,Шакайка
Dialogue: 0,0:07:56.47,0:07:58.41,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:07:56.47,0:07:58.41,Default,,0000,0000,0000,,Бұл не, қоғамтану үй тапсырмасы?
Dialogue: 0,0:07:58.41,0:08:00.37,Rubi,,0000,0000,0000,,Чикагоро
Dialogue: 0,0:07:58.41,0:08:00.37,Rubi,,0000,0000,0000,,Күрделі
Dialogue: 0,0:07:58.41,0:08:00.37,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:07:58.41,0:08:00.37,Default,,0000,0000,0000,,Соңғы кездері мен қиын нәрселерді алып жүрмін.
Dialogue: 0,0:08:00.37,0:08:03.38,Default,,0000,0000,0000,,Сіз түсінбейсіз бе?
Dialogue: 0,0:08:00.37,0:08:03.38,Default,,0000,0000,0000,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:08:03.38,0:08:06.01,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:08:03.38,0:08:06.01,Rubi,,0000,0000,0000,,Қуат
Dialogue: 0,0:08:03.38,0:08:06.01,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:08:03.38,0:08:06.01,Default,,0000,0000,0000,,Мен өз күшіммен бірдеңе істеймін.
Dialogue: 0,0:08:06.01,0:08:09.52,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:08:06.01,0:08:09.52,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:08:06.01,0:08:09.52,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:08:06.01,0:08:09.52,Rubi,,0000,0000,0000,,Қуат
Dialogue: 0,0:08:06.01,0:08:09.52,Default,,0000,0000,0000,,Үй тапсырмасы – өз бетінше орындайтын іс.
Dialogue: 0,0:08:09.52,0:08:11.45,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:08:09.52,0:08:11.45,Default,,0000,0000,0000,,Әке
Dialogue: 0,0:08:09.52,0:08:11.45,Default,,0000,0000,0000,,Сондай күндердің бірінде, менің
Dialogue: 0,0:08:11.45,0:08:15.02,Rubi,,0000,0000,0000,,Кака
Dialogue: 0,0:08:11.45,0:08:15.02,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:08:11.45,0:08:15.02,Default,,0000,0000,0000,,Мен сенің жүргізушің боламын.
Dialogue: 0,0:08:11.45,0:08:15.02,Default,,0000,0000,0000,,Хохохохохо
Dialogue: 0,0:08:15.02,0:08:16.52,Rubi,,0000,0000,0000,,Кару
Dialogue: 0,0:08:15.02,0:08:16.52,Rubi,,0000,0000,0000,,Куцуджокукан
Dialogue: 0,0:08:15.02,0:08:16.52,Default,,0000,0000,0000,,＜Жеңіл қорлау және
Dialogue: 0,0:08:16.52,0:08:20.03,Rubi,,0000,0000,0000,,Кака
Dialogue: 0,0:08:16.52,0:08:20.03,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:08:16.52,0:08:20.03,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:08:16.52,0:08:20.03,Default,,0000,0000,0000,,Жүргізуші де жаман емес.
Dialogue: 0,0:08:16.52,0:08:20.03,Rubi,,0000,0000,0000,,Кимо
Dialogue: 0,0:08:16.52,0:08:20.03,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:16.52,0:08:20.03,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:08:16.52,0:08:20.03,Default,,0000,0000,0000,,Аралас сезімдер
Dialogue: 0,0:08:20.03,0:08:22.03,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
