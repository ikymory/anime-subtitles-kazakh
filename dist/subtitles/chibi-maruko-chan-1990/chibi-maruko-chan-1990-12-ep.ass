Dialogue: 0,0:21:00.92,0:21:02.92,Rubi,,0000,0000,0000,,Игай
Dialogue: 0,0:21:00.92,0:21:02.92,Default,,0000,0000,0000,,Таңқаларлық қызықты>
Dialogue: 0,0:21:00.92,0:21:02.92,Rubi,,0000,0000,0000,,Данши
Dialogue: 0,0:21:00.92,0:21:02.92,Default,,0000,0000,0000,,Ей, жолдан кет!
Dialogue: 0,0:21:02.92,0:21:05.42,Rubi,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:21:02.92,0:21:05.42,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:02.92,0:21:05.42,Default,,0000,0000,0000,,Бөлмеңіз!
Dialogue: 0,0:21:02.92,0:21:05.42,Default,,0000,0000,0000,,Өте тітіркендіргіш
Dialogue: 0,0:21:07.06,0:21:09.00,Rubi,,0000,0000,0000,,Тенин
Dialogue: 0,0:21:07.06,0:21:09.00,Rubi,,0000,0000,0000,,En
Dialogue: 0,0:21:07.06,0:21:09.00,Default,,0000,0000,0000,,760 иен
Dialogue: 0,0:21:09.00,0:21:12.93,Rubi,,0000,0000,0000,,Данши
Dialogue: 0,0:21:09.00,0:21:12.93,Default,,0000,0000,0000,,Иә! Мұндай нәрсе
Dialogue: 0,0:21:09.00,0:21:12.93,Rubi,,0000,0000,0000,,En
Dialogue: 0,0:21:09.00,0:21:12.93,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:21:09.00,0:21:12.93,Default,,0000,0000,0000,,Мен бұл бар болғаны 200 иен деп ойладым.
Dialogue: 0,0:21:12.93,0:21:17.07,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:21:12.93,0:21:17.07,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:21:12.93,0:21:17.07,Rubi,,0000,0000,0000,,Кейсан
Dialogue: 0,0:21:12.93,0:21:17.07,Default,,0000,0000,0000,,<мылқаулар есептей алмайды
Dialogue: 0,0:21:12.93,0:21:17.07,Default,,0000,0000,0000,,Өте көп мөлшерде артық болды＞
Dialogue: 0,0:21:17.07,0:21:18.04,Rubi,,0000,0000,0000,,Тенин
Dialogue: 0,0:21:17.07,0:21:18.04,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:21:17.07,0:21:18.04,Rubi,,0000,0000,0000,,Қақпақ
Dialogue: 0,0:21:17.07,0:21:18.04,Default,,0000,0000,0000,,Бір, екі…
Dialogue: 0,0:21:18.04,0:21:20.57,Rubi,,0000,0000,0000,,Жоғарғы
Dialogue: 0,0:21:18.04,0:21:20.57,Rubi,,0000,0000,0000,,Емен
Dialogue: 0,0:21:18.04,0:21:20.57,Default,,0000,0000,0000,,<Тек кішкентай тәттілер
Dialogue: 0,0:21:18.04,0:21:20.57,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:21:18.04,0:21:20.57,Default,,0000,0000,0000,,Көп бөліктерді сатып алыңыз
Dialogue: 0,0:21:20.57,0:21:23.48,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:21:20.57,0:21:23.48,Default,,0000,0000,0000,,Кассадағы ханым
Dialogue: 0,0:21:20.57,0:21:23.48,Rubi,,0000,0000,0000,,Жоғарғы
Dialogue: 0,0:21:20.57,0:21:23.48,Default,,0000,0000,0000,,Кейбір адамдар қиындық тудырады>
Dialogue: 0,0:21:23.48,0:21:24.98,Rubi,,0000,0000,0000,,Тенин
Dialogue: 0,0:21:23.48,0:21:24.98,Rubi,,0000,0000,0000,,Ал егер Цуки Кира болса, онда Цуки Нианы өлтіреді
Dialogue: 0,0:21:23.48,0:21:24.98,Rubi,,0000,0000,0000,,Мұнда
Dialogue: 0,0:21:23.48,0:21:24.98,Default,,0000,0000,0000,,Сегіз тоғыз...
Dialogue: 0,0:21:27.01,0:21:29.51,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:27.01,0:21:29.51,Rubi,,0000,0000,0000,,En
Dialogue: 0,0:21:27.01,0:21:29.51,Default,,0000,0000,0000,,Барлығы 200 иен.
Dialogue: 0,0:21:30.52,0:21:32.02,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:34.02,0:21:37.52,Default,,0000,0000,0000,,Уау! Маған
Dialogue: 0,0:21:34.02,0:21:37.52,Default,,0000,0000,0000,,Олар маған қосымша салат күріш крекерлерін берді.
Dialogue: 0,0:21:37.52,0:21:41.39,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:21:37.52,0:21:41.39,Default,,0000,0000,0000,,Сіздің әпкеңіз ше?
Dialogue: 0,0:21:37.52,0:21:41.39,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:21:37.52,0:21:41.39,Default,,0000,0000,0000,,Хмм, бұл менікі...
Dialogue: 0,0:21:41.39,0:21:43.03,Default,,0000,0000,0000,,Ах! Бұл шоколадты орам
Dialogue: 0,0:21:43.03,0:21:44.53,Default,,0000,0000,0000,,Уау, олар керемет көрінеді!
Dialogue: 0,0:21:43.03,0:21:44.53,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:21:44.53,0:21:46.47,Rubi,,0000,0000,0000,,Емен
Dialogue: 0,0:21:44.53,0:21:46.47,Default,,0000,0000,0000,,<Бұл кәмпит
Dialogue: 0,0:21:44.53,0:21:46.47,Rubi,,0000,0000,0000,,Тоджи
Dialogue: 0,0:21:44.53,0:21:46.47,Rubi,,0000,0000,0000,,Ники
Dialogue: 0,0:21:44.53,0:21:46.47,Default,,0000,0000,0000,,Сол кездегі танымал>
Dialogue: 0,0:21:46.47,0:21:49.40,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:21:46.47,0:21:49.40,Default,,0000,0000,0000,,Жай ғана үлкен әпке
Dialogue: 0,0:21:46.47,0:21:49.40,Default,,0000,0000,0000,,Неліктен шоколадты ролл?
Dialogue: 0,0:21:49.40,0:21:51.04,Default,,0000,0000,0000,,Бұл жасырын!
Dialogue: 0,0:21:51.04,0:21:53.54,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:51.04,0:21:53.54,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:21:51.04,0:21:53.54,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:21:51.04,0:21:53.54,Default,,0000,0000,0000,,Мен ұсталдым ұсталдым!
Dialogue: 0,0:21:53.54,0:21:56.44,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:21:53.54,0:21:56.44,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:21:53.54,0:21:56.44,Default,,0000,0000,0000,,Мен мұны сатып алдым.
Dialogue: 0,0:21:53.54,0:21:56.44,Default,,0000,0000,0000,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:21:56.44,0:21:59.44,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:21:56.44,0:21:59.44,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:21:56.44,0:21:59.44,Default,,0000,0000,0000,,Таку Үлкен әпкенің алдауы!
Dialogue: 0,0:22:03.05,0:22:05.55,Default,,0000,0000,0000,,Үйдемін!
Dialogue: 0,0:22:03.05,0:22:05.55,Default,,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,0:22:05.55,0:22:09.42,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:05.55,0:22:09.42,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:05.55,0:22:09.42,Default,,0000,0000,0000,,Ана ана. Эй.
Dialogue: 0,0:22:05.55,0:22:09.42,Rubi,,0000,0000,0000,,Тамагоя
Dialogue: 0,0:22:05.55,0:22:09.42,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:22:05.55,0:22:09.42,Default,,0000,0000,0000,,Ертең қуырылған жұмыртқа қосыңыз.
Dialogue: 0,0:22:09.42,0:22:12.43,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:22:09.42,0:22:12.43,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:09.42,0:22:12.43,Rubi,,0000,0000,0000,,Жұмыртқа
Dialogue: 0,0:22:09.42,0:22:12.43,Default,,0000,0000,0000,,Маруко жұмыртқаға айналды
Dialogue: 0,0:22:12.43,0:22:15.06,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:22:12.43,0:22:15.06,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:22:12.43,0:22:15.06,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:22:12.43,0:22:15.06,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:12.43,0:22:15.06,Default,,0000,0000,0000,,<Қарттар тұратын үйлерде тұратын балаларға
Dialogue: 0,0:22:15.06,0:22:18.56,Rubi,,0000,0000,0000,,Жұмыртқа
Dialogue: 0,0:22:15.06,0:22:18.56,Rubi,,0000,0000,0000,,Жұмыртқа
Dialogue: 0,0:22:15.06,0:22:18.56,Default,,0000,0000,0000,,«Пісірілген жұмыртқа» «Удетамаго» деп аталады.
Dialogue: 0,0:22:15.06,0:22:18.56,Rubi,,0000,0000,0000,,Кейкоу
Dialogue: 0,0:22:15.06,0:22:18.56,Default,,0000,0000,0000,,Тренд бар>
Dialogue: 0,0:22:19.57,0:22:21.50,Default,,0000,0000,0000,,Вена шұжығы
Dialogue: 0,0:22:19.57,0:22:21.50,Default,,0000,0000,0000,,Оны сегізаяққа айналдыр, солай ма?
Dialogue: 0,0:22:21.50,0:22:23.00,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:22:23.00,0:22:25.51,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:23.00,0:22:25.51,Default,,0000,0000,0000,,Маруко винер крабына айналды
Dialogue: 0,0:22:23.00,0:22:25.51,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:22:25.51,0:22:28.51,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:25.51,0:22:28.51,Rubi,,0000,0000,0000,,Ханаута
Dialogue: 0,0:22:25.51,0:22:28.51,Default,,0000,0000,0000,,(Сакико/Маруконың гуілдеуі)
Dialogue: 0,0:22:31.38,0:22:34.51,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:31.38,0:22:34.51,Default,,0000,0000,0000,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:22:31.38,0:22:34.51,Default,,0000,0000,0000,,Мына сөмке жарай ма?
Dialogue: 0,0:22:34.51,0:22:37.02,Rubi,,0000,0000,0000,,Джото
Dialogue: 0,0:22:34.51,0:22:37.02,Default,,0000,0000,0000,,Иә, жақсы.
Dialogue: 0,0:22:37.02,0:22:38.95,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:37.02,0:22:38.95,Default,,0000,0000,0000,,Анашым!
Dialogue: 0,0:22:38.95,0:22:40.52,Default,,0000,0000,0000,,Эй, эй
Dialogue: 0,0:22:38.95,0:22:40.52,Rubi,,0000,0000,0000,,Сары
Dialogue: 0,0:22:38.95,0:22:40.52,Default,,0000,0000,0000,,Мына шорт жарай ма?
Dialogue: 0,0:22:40.52,0:22:43.02,Default,,0000,0000,0000,,Әй, сүйкімді, сүйкімді...
Dialogue: 0,0:22:44.02,0:22:47.53,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:44.02,0:22:47.53,Rubi,,0000,0000,0000,,Қалпақ
Dialogue: 0,0:22:44.02,0:22:47.53,Default,,0000,0000,0000,,Анашым, мына қалпақ жарай ма?
Dialogue: 0,0:22:44.02,0:22:47.53,Default,,0000,0000,0000,,Иә иә
Dialogue: 0,0:22:47.53,0:22:49.03,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:47.53,0:22:49.03,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:47.53,0:22:49.03,Default,,0000,0000,0000,,Сәлем анашым анашым
Dialogue: 0,0:22:49.03,0:22:51.03,Rubi,,0000,0000,0000,,Аяқ киім
Dialogue: 0,0:22:49.03,0:22:51.03,Default,,0000,0000,0000,,Мына аяқ киім жақсы ма?
Dialogue: 0,0:22:49.03,0:22:51.03,Default,,0000,0000,0000,,Иә, иә, иә
Dialogue: 0,0:22:51.93,0:22:55.54,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:51.93,0:22:55.54,Default,,0000,0000,0000,,Мама, күте тұрыңыз.
Dialogue: 0,0:22:51.93,0:22:55.54,Rubi,,0000,0000,0000,,Уау
Dialogue: 0,0:22:51.93,0:22:55.54,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:22:51.93,0:22:55.54,Default,,0000,0000,0000,,Мына күртешеге қараңдар!
Dialogue: 0,0:22:55.54,0:22:59.04,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:55.54,0:22:59.04,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:55.54,0:22:59.04,Default,,0000,0000,0000,,Сәлем анашым анашым
Dialogue: 0,0:22:55.54,0:22:59.04,Default,,0000,0000,0000,,Сізге қай орамал ұнайды?
Dialogue: 0,0:23:01.04,0:23:02.54,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:23:01.04,0:23:02.54,Default,,0000,0000,0000,,Сәлем анашым!
Dialogue: 0,0:23:01.04,0:23:02.54,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:23:01.04,0:23:02.54,Default,,0000,0000,0000,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:23:02.54,0:23:05.04,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:23:02.54,0:23:05.04,Default,,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:23:02.54,0:23:05.04,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:23:02.54,0:23:05.04,Default,,0000,0000,0000,,Анашым!
Dialogue: 0,0:23:05.04,0:23:07.55,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:05.04,0:23:07.55,Default,,0000,0000,0000,,Балалар сендер шулы екенсіңдер.
Dialogue: 0,0:23:07.55,0:23:09.05,Default,,0000,0000,0000,,<Мұндай жағдайларда
Dialogue: 0,0:23:09.05,0:23:12.55,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:23:09.05,0:23:12.55,Default,,0000,0000,0000,,Мен қателескен жоқпын
Dialogue: 0,0:23:09.05,0:23:12.55,Rubi,,0000,0000,0000,,Око
Dialogue: 0,0:23:09.05,0:23:12.55,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:23:09.05,0:23:12.55,Default,,0000,0000,0000,,Неге ашуландың >
Dialogue: 0,0:23:15.92,0:23:19.06,Default,,0000,0000,0000,,Уау, бұл Кальпис!
Dialogue: 0,0:23:15.92,0:23:19.06,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:23:15.92,0:23:19.06,Default,,0000,0000,0000,,Иә, ертең әкелемін.
Dialogue: 0,0:23:19.06,0:23:22.93,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:23:19.06,0:23:22.93,Default,,0000,0000,0000,,Маруко да Кальпис болады!
Dialogue: 0,0:23:19.06,0:23:22.93,Default,,0000,0000,0000,,Ия, еліктеу, еліктеу!
Dialogue: 0,0:23:22.93,0:23:24.43,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,0:23:25.57,0:23:27.50,Rubi,,0000,0000,0000,,Емен
Dialogue: 0,0:23:25.57,0:23:27.50,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:23:25.57,0:23:27.50,Default,,0000,0000,0000,,Бұл тәттілер, солай ма? Бұл су бөтелкесі.
Dialogue: 0,0:23:27.50,0:23:30.44,Rubi,,0000,0000,0000,,Қалпақ
Dialogue: 0,0:23:27.50,0:23:30.44,Rubi,,0000,0000,0000,,Сары
Dialogue: 0,0:23:27.50,0:23:30.44,Default,,0000,0000,0000,,Бұл қалпақ. Бұл шорт.
Dialogue: 0,0:23:27.50,0:23:30.44,Rubi,,0000,0000,0000,,Уваги
Dialogue: 0,0:23:27.50,0:23:30.44,Default,,0000,0000,0000,,Бұл куртка, солай ма?
Dialogue: 0,0:23:30.44,0:23:36.08,Rubi,,0000,0000,0000,,Бенто
Dialogue: 0,0:23:30.44,0:23:36.08,Default,,0000,0000,0000,,Ал, түскі ас ше?
Dialogue: 0,0:23:30.44,0:23:36.08,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:23:30.44,0:23:36.08,Rubi,,0000,0000,0000,,Мака
Dialogue: 0,0:23:30.44,0:23:36.08,Default,,0000,0000,0000,,Ха~ Анама қалдырдым.
Dialogue: 0,0:23:36.08,0:23:38.98,Rubi,,0000,0000,0000,,Энсуку
Dialogue: 0,0:23:36.08,0:23:38.98,Rubi,,0000,0000,0000,,Джунби
Dialogue: 0,0:23:36.08,0:23:38.98,Default,,0000,0000,0000,,《Аа, экскурсияға да дайындық.
Dialogue: 0,0:23:36.08,0:23:38.98,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:23:36.08,0:23:38.98,Default,,0000,0000,0000,,Аяқталды ма?
Dialogue: 0,0:23:38.98,0:23:42.58,Default,,0000,0000,0000,,Бұл қызықсыз...》
Dialogue: 0,0:23:42.58,0:23:44.52,Rubi,,0000,0000,0000,,Энсуку
Dialogue: 0,0:23:42.58,0:23:44.52,Default,,0000,0000,0000,,<Мару-чан үшін экскурсия
Dialogue: 0,0:23:44.52,0:23:48.52,Rubi,,0000,0000,0000,,Энсуку
Dialogue: 0,0:23:44.52,0:23:48.52,Rubi,,0000,0000,0000,,Джунби
Dialogue: 0,0:23:44.52,0:23:48.52,Default,,0000,0000,0000,,Экскурсияға дайындықпен келіңіз.
Dialogue: 0,0:23:44.52,0:23:48.52,Default,,0000,0000,0000,,Бұл бонус сияқты болды>
Dialogue: 0,0:23:52.59,0:23:54.53,Rubi,,0000,0000,0000,,Эй
