Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:08.03,0:01:18.53,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:14.05,0:03:16.56,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:14.05,0:03:16.56,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:03:14.05,0:03:16.56,Rubi,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:03:14.05,0:03:16.56,Default,,0000,0000,0000,,Сөзсіз Цучиноко бар
Dialogue: 0,0:03:16.56,0:03:20.06,Rubi,,0000,0000,0000,,Бөтелке
Dialogue: 0,0:03:16.56,0:03:20.06,Rubi,,0000,0000,0000,,О
Dialogue: 0,0:03:16.56,0:03:20.06,Default,,0000,0000,0000,,Сыра бөтелкесінің көлемі туралы
Dialogue: 0,0:03:16.56,0:03:20.06,Default,,0000,0000,0000,,Мен сенің не айтқың келетінін білемін.
Dialogue: 0,0:03:20.06,0:03:22.00,Default,,0000,0000,0000,,Бәрінен бұрын
Dialogue: 0,0:03:20.06,0:03:22.00,Rubi,,0000,0000,0000,,Нугё
Dialogue: 0,0:03:20.06,0:03:22.00,Rubi,,0000,0000,0000,,Танака
Dialogue: 0,0:03:20.06,0:03:22.00,Default,,0000,0000,0000,,Фермер Танака мырза.
Dialogue: 0,0:03:22.00,0:03:24.93,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:03:22.00,0:03:24.93,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:22.00,0:03:24.93,Default,,0000,0000,0000,,Ол көргенін айтты.
Dialogue: 0,0:03:22.00,0:03:24.93,Rubi,,0000,0000,0000,,Бу
Dialogue: 0,0:03:22.00,0:03:24.93,Default,,0000,0000,0000,,Не, «Белгілі бір әмбебап дүкенде ме?
Dialogue: 0,0:03:24.93,0:03:28.50,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:03:24.93,0:03:28.50,Default,,0000,0000,0000,,Цучиноконы ұстаған адамға
Dialogue: 0,0:03:24.93,0:03:28.50,Rubi,,0000,0000,0000,,Шокин
Dialogue: 0,0:03:24.93,0:03:28.50,Rubi,,0000,0000,0000,,Манен
Dialogue: 0,0:03:24.93,0:03:28.50,Default,,0000,0000,0000,,Жүлде ақшасы 1 миллион иен»
Dialogue: 0,0:03:28.50,0:03:31.01,Rubi,,0000,0000,0000,,Манен
Dialogue: 0,0:03:28.50,0:03:31.01,Default,,0000,0000,0000,,100
Dialogue: 0,0:03:31.01,0:03:35.51,Rubi,,0000,0000,0000,,Жазғы демалыс
Dialogue: 0,0:03:31.01,0:03:35.51,Rubi,,0000,0000,0000,,Мукка
Dialogue: 0,0:03:31.01,0:03:35.51,Default,,0000,0000,0000,,Жазғы демалыс басталғалы жатыр.
Dialogue: 0,0:03:31.01,0:03:35.51,Rubi,,0000,0000,0000,,Манен
Dialogue: 0,0:03:31.01,0:03:35.51,Default,,0000,0000,0000,,Егер менде 1 миллион иен болса...
Dialogue: 0,0:03:37.88,0:03:41.02,Default,,0000,0000,0000,,《Сәлем
Dialogue: 0,0:03:37.88,0:03:41.02,Default,,0000,0000,0000,,Кел, Джордж》
Dialogue: 0,0:03:41.02,0:03:42.52,Rubi,,0000,0000,0000,,Манен
Dialogue: 0,0:03:41.02,0:03:42.52,Default,,0000,0000,0000,,Жақсы! Бұл 1 миллион иен
Dialogue: 0,0:03:42.52,0:03:45.42,Default,,0000,0000,0000,,Оны саған берейін.
Dialogue: 0,0:03:42.52,0:03:45.42,Default,,0000,0000,0000,,Алайық
Dialogue: 0,0:03:45.42,0:03:47.92,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:03:45.42,0:03:47.92,Default,,0000,0000,0000,,Сәлем әке
Dialogue: 0,0:03:49.39,0:03:51.53,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:03:49.39,0:03:51.53,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:03:49.39,0:03:51.53,Default,,0000,0000,0000,,Сізге қажет нәрсе бар ма?
Dialogue: 0,0:03:49.39,0:03:51.53,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:51.53,0:03:54.43,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:51.53,0:03:54.43,Default,,0000,0000,0000,,Маған бірдеңе айтыңыз
Dialogue: 0,0:03:51.53,0:03:54.43,Rubi,,0000,0000,0000,,Энрио
Dialogue: 0,0:03:51.53,0:03:54.43,Default,,0000,0000,0000,,Ұялшақ болу дөрекі.
Dialogue: 0,0:03:54.43,0:03:57.43,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:54.43,0:03:57.43,Default,,0000,0000,0000,,Дұрыс, Марукодікі
Dialogue: 0,0:03:54.43,0:03:57.43,Rubi,,0000,0000,0000,,Цуушинбо
Dialogue: 0,0:03:54.43,0:03:57.43,Default,,0000,0000,0000,,Бұл барлығы 5 есеп картасы.
Dialogue: 0,0:03:58.40,0:04:01.54,Default,,0000,0000,0000,,Хмм, солай.
Dialogue: 0,0:03:58.40,0:04:01.54,Rubi,,0000,0000,0000,,Мұрт
Dialogue: 0,0:03:58.40,0:04:01.54,Default,,0000,0000,0000,,Бұл шындыққа жанаспайды.
Dialogue: 0,0:04:01.54,0:04:04.44,Rubi,,0000,0000,0000,,Ақша
Dialogue: 0,0:04:01.54,0:04:04.44,Rubi,,0000,0000,0000,,Кайкецу
Dialogue: 0,0:04:01.54,0:04:04.44,Default,,0000,0000,0000,,Оны ақшамен шешуге болатындай етіп жасаңыз
Dialogue: 0,0:04:04.44,0:04:06.94,Rubi,,0000,0000,0000,,Мұрт
Dialogue: 0,0:04:04.44,0:04:06.94,Default,,0000,0000,0000,,Қайсысы шындыққа жанаспайды?
Dialogue: 0,0:04:08.41,0:04:12.55,Default,,0000,0000,0000,,Айтпақшы, Цучиноко дегеніміз не?
Dialogue: 0,0:04:08.41,0:04:12.55,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:04:08.41,0:04:12.55,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:04:08.41,0:04:12.55,Default,,0000,0000,0000,,Өзіңді қайдамын деп ойлайсың?
Dialogue: 0,0:04:12.55,0:04:15.45,Default,,0000,0000,0000,,Себебі мен мұны түсінбеймін
Dialogue: 0,0:04:12.55,0:04:15.45,Rubi,,0000,0000,0000,,Иллюзия
Dialogue: 0,0:04:12.55,0:04:15.45,Default,,0000,0000,0000,,Бұл елес жылан болуы керек.
Dialogue: 0,0:04:15.45,0:04:17.42,Rubi,,0000,0000,0000,,Go
Dialogue: 0,0:04:15.45,0:04:17.42,Default,,0000,0000,0000,,<Бұл орынды пікір>
Dialogue: 0,0:04:17.42,0:04:19.42,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:17.42,0:04:19.42,Default,,0000,0000,0000,,Жай ғана өрескел идея жақсы.
Dialogue: 0,0:04:19.42,0:04:21.56,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:04:19.42,0:04:21.56,Default,,0000,0000,0000,,Ойлан.
Dialogue: 0,0:04:19.42,0:04:21.56,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:04:19.42,0:04:21.56,Default,,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:04:21.56,0:04:24.06,Default,,0000,0000,0000,,Осымен
Dialogue: 0,0:04:21.56,0:04:24.06,Default,,0000,0000,0000,,Біреу жоқ па?
Dialogue: 0,0:04:24.06,0:04:27.49,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:04:24.06,0:04:27.49,Default,,0000,0000,0000,,Қазірдің өзінде каппа мен Несси сияқты нәрселер
Dialogue: 0,0:04:24.06,0:04:27.49,Default,,0000,0000,0000,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:04:27.49,0:04:31.00,Default,,0000,0000,0000,,Жақсы, бірақ
Dialogue: 0,0:04:27.49,0:04:31.00,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:27.49,0:04:31.00,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:04:27.49,0:04:31.00,Default,,0000,0000,0000,,Кейбіреулер көрдім дейді
Dialogue: 0,0:04:31.00,0:04:33.90,Default,,0000,0000,0000,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:04:33.90,0:04:35.87,Default,,0000,0000,0000,,Қараңдар!
Dialogue: 0,0:04:35.87,0:04:38.51,Rubi,,0000,0000,0000,,Құрметті.
Dialogue: 0,0:04:35.87,0:04:38.51,Rubi,,0000,0000,0000,,Танака
Dialogue: 0,0:04:35.87,0:04:38.51,Default,,0000,0000,0000,,Бұл кітапта Танака мырза да бар.
Dialogue: 0,0:04:35.87,0:04:38.51,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:35.87,0:04:38.51,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:35.87,0:04:38.51,Default,,0000,0000,0000,,Сіз оны көргеніңізді айттыңыз.
Dialogue: 0,0:04:38.51,0:04:40.44,Rubi,,0000,0000,0000,,Танака
Dialogue: 0,0:04:38.51,0:04:40.44,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:38.51,0:04:40.44,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:38.51,0:04:40.44,Default,,0000,0000,0000,,Танака мырза, сіз не көрдіңіз...
Dialogue: 0,0:04:40.44,0:04:43.38,Rubi,,0000,0000,0000,,Орындалды
Dialogue: 0,0:04:40.44,0:04:43.38,Default,,0000,0000,0000,,Мен бәрібір сабанның астында қалдым.
Dialogue: 0,0:04:40.44,0:04:43.38,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:40.44,0:04:43.38,Default,,0000,0000,0000,,Менің ойымша, сен де жыланды көргенсің.
Dialogue: 0,0:04:43.38,0:04:45.38,Default,,0000,0000,0000,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:04:43.38,0:04:45.38,Default,,0000,0000,0000,,Дұрыс, хехехе
Dialogue: 0,0:04:45.38,0:04:48.02,Default,,0000,0000,0000,,Уф... неге бәрі?
Dialogue: 0,0:04:45.38,0:04:48.02,Rubi,,0000,0000,0000,,Танака
Dialogue: 0,0:04:45.38,0:04:48.02,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:45.38,0:04:48.02,Default,,0000,0000,0000,,Танака мырзаның айтқаны
Dialogue: 0,0:04:48.02,0:04:49.52,Rubi,,0000,0000,0000,,Шин
Dialogue: 0,0:04:48.02,0:04:49.52,Default,,0000,0000,0000,,Маған сенбеңіз!
Dialogue: 0,0:04:49.52,0:04:51.02,Default,,0000,0000,0000,,<Неге сонша?
Dialogue: 0,0:04:51.02,0:04:53.92,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:51.02,0:04:53.92,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:04:51.02,0:04:53.92,Rubi,,0000,0000,0000,,Танака
Dialogue: 0,0:04:51.02,0:04:53.92,Default,,0000,0000,0000,,Танака мырза, бейтаныс адам
Dialogue: 0,0:04:51.02,0:04:53.92,Default,,0000,0000,0000,,Оны қорғаңыз>
Dialogue: 0,0:04:53.92,0:04:57.42,Default,,0000,0000,0000,,Балалар, енді сендер үшін жоқ.
Dialogue: 0,0:04:53.92,0:04:57.42,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:53.92,0:04:57.42,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:53.92,0:04:57.42,Default,,0000,0000,0000,,Мен саған ештеңе сатып алмаймын.
Dialogue: 0,0:04:58.53,0:05:01.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:58.53,0:05:01.03,Rubi,,0000,0000,0000,,Не?
Dialogue: 0,0:04:58.53,0:05:01.03,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:05:01.03,0:05:02.53,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:05:01.03,0:05:02.53,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:02.53,0:05:04.47,Default,,0000,0000,0000,,Сәлем, ата
Dialogue: 0,0:05:02.53,0:05:04.47,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:02.53,0:05:04.47,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:05:02.53,0:05:04.47,Default,,0000,0000,0000,,Сізге қажет нәрсе бар ма?
Dialogue: 0,0:05:04.47,0:05:07.03,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:04.47,0:05:07.03,Default,,0000,0000,0000,,Маған бірдеңе айтыңыз
Dialogue: 0,0:05:04.47,0:05:07.03,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:05:04.47,0:05:07.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:07.03,0:05:09.54,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:07.03,0:05:09.54,Default,,0000,0000,0000,,Сондай күндердің бірінде, Маруко
Dialogue: 0,0:05:07.03,0:05:09.54,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:05:07.03,0:05:09.54,Default,,0000,0000,0000,,Мен оны саған сатып аламын.
Dialogue: 0,0:05:09.54,0:05:12.04,Default,,0000,0000,0000,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:05:09.54,0:05:12.04,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:05:09.54,0:05:12.04,Default,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:05:12.04,0:05:14.54,Rubi,,0000,0000,0000,,О
Dialogue: 0,0:05:12.04,0:05:14.54,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:05:12.04,0:05:14.54,Default,,0000,0000,0000,,Өскенде сатып ал.
Dialogue: 0,0:05:14.54,0:05:17.04,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:05:14.54,0:05:17.04,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:05:14.54,0:05:17.04,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:05:14.54,0:05:17.04,Default,,0000,0000,0000,,Мен оны тезірек сатып аламын.
Dialogue: 0,0:05:17.04,0:05:20.55,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:05:17.04,0:05:20.55,Default,,0000,0000,0000,,Тағы бір аптадан кейін
Dialogue: 0,0:05:17.04,0:05:20.55,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:05:17.04,0:05:20.55,Default,,0000,0000,0000,,Мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:05:20.55,0:05:23.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:20.55,0:05:23.05,Rubi,,0000,0000,0000,,Риюу
Dialogue: 0,0:05:20.55,0:05:23.05,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:05:20.55,0:05:23.05,Default,,0000,0000,0000,,Менен неге деп сұрамаңыз.
Dialogue: 0,0:05:23.05,0:05:25.95,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:23.05,0:05:25.95,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:05:23.05,0:05:25.95,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
