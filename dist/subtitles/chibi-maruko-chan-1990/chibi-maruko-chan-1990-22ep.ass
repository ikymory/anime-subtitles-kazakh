Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.26,0:01:13.76,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:08.32,0:03:10.82,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:08.32,0:03:10.82,Default,,0000,0000,0000,,Хаа һаа һаа…
Dialogue: 0,0:03:11.82,0:03:12.82,Default,,0000,0000,0000,,Ах~
Dialogue: 0,0:03:14.32,0:03:15.82,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:14.32,0:03:15.82,Default,,0000,0000,0000,,Ана, мен үйдемін!
Dialogue: 0,0:03:16.83,0:03:18.76,Rubi,,0000,0000,0000,,Мане
Dialogue: 0,0:03:16.83,0:03:18.76,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:03:16.83,0:03:18.76,Default,,0000,0000,0000,,Сіз хат алдыңыз ба?
Dialogue: 0,0:03:18.76,0:03:21.33,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:03:18.76,0:03:21.33,Default,,0000,0000,0000,,Ол келді.
Dialogue: 0,0:03:18.76,0:03:21.33,Rubi,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:03:18.76,0:03:21.33,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:03:18.76,0:03:21.33,Default,,0000,0000,0000,,Қараңдар, үстелге.
Dialogue: 0,0:03:21.33,0:03:23.27,Default,,0000,0000,0000,,Әй, иә!
Dialogue: 0,0:03:23.27,0:03:26.17,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:03:23.27,0:03:26.17,Default,,0000,0000,0000,,<Қазір Мару-чанның сыныбында
Dialogue: 0,0:03:23.27,0:03:26.17,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:03:23.27,0:03:26.17,Rubi,,0000,0000,0000,,Босдық
Dialogue: 0,0:03:23.27,0:03:26.17,Default,,0000,0000,0000,,Әйелдер арасында
Dialogue: 0,0:03:26.17,0:03:29.67,Rubi,,0000,0000,0000,,алынды
Dialogue: 0,0:03:26.17,0:03:29.67,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:26.17,0:03:29.67,Rubi,,0000,0000,0000,,Бунцуу
Dialogue: 0,0:03:26.17,0:03:29.67,Default,,0000,0000,0000,,Басқа префектуралардың балаларымен хат алмасу
Dialogue: 0,0:03:26.17,0:03:29.67,Default,,0000,0000,0000,,орындалуда＞
Dialogue: 0,0:03:30.77,0:03:32.27,Default,,0000,0000,0000,,Эххе
Dialogue: 0,0:03:33.68,0:03:36.28,Default,,0000,0000,0000,,«Танысқаныма қуаныштымын, Момоко Сакура».
Dialogue: 0,0:03:36.28,0:03:40.78,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:03:36.28,0:03:40.78,Rubi,,0000,0000,0000,,Казуэ Танабе
Dialogue: 0,0:03:36.28,0:03:40.78,Default,,0000,0000,0000,,«Мен Казуэ Танабемін»!
Dialogue: 0,0:03:40.78,0:03:42.28,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:03:40.78,0:03:42.28,Default,,0000,0000,0000,,Қайсысы? Қараңызшы
Dialogue: 0,0:03:42.28,0:03:46.79,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:42.28,0:03:46.79,Default,,0000,0000,0000,,А, жоқ! Марукодан
Dialogue: 0,0:03:42.28,0:03:46.79,Rubi,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:03:42.28,0:03:46.79,Rubi,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:03:42.28,0:03:46.79,Default,,0000,0000,0000,,Алдымен оқымаңыз
Dialogue: 0,0:03:46.79,0:03:51.29,Default,,0000,0000,0000,,О!
Dialogue: 0,0:03:46.79,0:03:51.29,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:03:46.79,0:03:51.29,Rubi,,0000,0000,0000,,Математика
Dialogue: 0,0:03:46.79,0:03:51.29,Rubi,,0000,0000,0000,,Ұрланған
Dialogue: 0,0:03:46.79,0:03:51.29,Default,,0000,0000,0000,,«Мен математиканы жақсы көремін»
Dialogue: 0,0:03:51.29,0:03:54.80,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:51.29,0:03:54.80,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:03:51.29,0:03:54.80,Default,,0000,0000,0000,,Екеуміз жақсы араласпаймыз деп ойлаймын.
Dialogue: 0,0:03:51.29,0:03:54.80,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:03:54.80,0:03:59.30,Rubi,,0000,0000,0000,,Шашин
Dialogue: 0,0:03:54.80,0:03:59.30,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:03:54.80,0:03:59.30,Default,,0000,0000,0000,,Ах! Фотосы бар
Dialogue: 0,0:03:59.30,0:04:01.80,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:03:59.30,0:04:01.80,Default,,0000,0000,0000,,Эй, сен мынаған ұқсайсың.
Dialogue: 0,0:04:01.80,0:04:03.74,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:01.80,0:04:03.74,Default,,0000,0000,0000,,Жақсы! Сүйкімді қыз емес
Dialogue: 0,0:04:03.74,0:04:05.31,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:05.31,0:04:08.81,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:04:05.31,0:04:08.81,Rubi,,0000,0000,0000,,Хендзи
Dialogue: 0,0:04:05.31,0:04:08.81,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:05.31,0:04:08.81,Default,,0000,0000,0000,,Ал, жауап ретінде не жазуым керек?
Dialogue: 0,0:04:08.81,0:04:12.68,Rubi,,0000,0000,0000,,Мане
Dialogue: 0,0:04:08.81,0:04:12.68,Default,,0000,0000,0000,,Ең алдымен «Хатыңызға рахмет».
Dialogue: 0,0:04:08.81,0:04:12.68,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:04:12.68,0:04:15.68,Rubi,,0000,0000,0000,,Шими-зуши
Dialogue: 0,0:04:12.68,0:04:15.68,Default,,0000,0000,0000,,«Бұл Шимизу қаласы
Dialogue: 0,0:04:12.68,0:04:15.68,Rubi,,0000,0000,0000,,Ча
Dialogue: 0,0:04:12.68,0:04:15.68,Default,,0000,0000,0000,,Шай және апельсиндер
Dialogue: 0,0:04:15.68,0:04:18.32,Rubi,,0000,0000,0000,,Шимизу но Джирочо
Dialogue: 0,0:04:15.68,0:04:18.32,Rubi,,0000,0000,0000,,Токусанбутсу
Dialogue: 0,0:04:15.68,0:04:18.32,Default,,0000,0000,0000,,Шимизу Джирочо – бұл мамандық».
Dialogue: 0,0:04:18.32,0:04:21.82,Rubi,,0000,0000,0000,,Шимизу но Джирочо
Dialogue: 0,0:04:18.32,0:04:21.82,Rubi,,0000,0000,0000,,Токусанбутсу
Dialogue: 0,0:04:18.32,0:04:21.82,Default,,0000,0000,0000,,<Шимизу Джирочо арнайы өнім емес>
Dialogue: 0,0:04:21.82,0:04:27.26,Rubi,,0000,0000,0000,,Жасайық
Dialogue: 0,0:04:21.82,0:04:27.26,Default,,0000,0000,0000,,Мен өзімді қартайғандай сезінемін.
Dialogue: 0,0:04:21.82,0:04:27.26,Rubi,,0000,0000,0000,,Шимизу
Dialogue: 0,0:04:21.82,0:04:27.26,Default,,0000,0000,0000,,Менде Шимизу бейнесі бар...
Dialogue: 0,0:04:27.26,0:04:28.76,Default,,0000,0000,0000,,Ммм... Ах.
Dialogue: 0,0:04:28.76,0:04:31.67,Rubi,,0000,0000,0000,,Канагавакен
Dialogue: 0,0:04:28.76,0:04:31.67,Rubi,,0000,0000,0000,,Мейбутсу
Dialogue: 0,0:04:28.76,0:04:31.67,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:04:28.76,0:04:31.67,Default,,0000,0000,0000,,«Канагава префектурасының мамандығы қандай?»
Dialogue: 0,0:04:28.76,0:04:31.67,Default,,0000,0000,0000,,Куфуфуфу…
Dialogue: 0,0:04:31.67,0:04:35.64,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:31.67,0:04:35.64,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:31.67,0:04:35.64,Default,,0000,0000,0000,,Осылай жазсаңыз, дәмді нәрсе болады.
Dialogue: 0,0:04:31.67,0:04:35.64,Rubi,,0000,0000,0000,,қою
Dialogue: 0,0:04:31.67,0:04:35.64,Default,,0000,0000,0000,,Мүмкін сіз оны маған жібере аласыз.
Dialogue: 0,0:04:35.64,0:04:36.64,Default,,0000,0000,0000,,Ах, дұрыс
Dialogue: 0,0:04:36.64,0:04:41.28,Rubi,,0000,0000,0000,,Мейсон
Dialogue: 0,0:04:36.64,0:04:41.28,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:36.64,0:04:41.28,Default,,0000,0000,0000,,Дрифтті апта сайын көру
Dialogue: 0,0:04:36.64,0:04:41.28,Rubi,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:04:36.64,0:04:41.28,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:36.64,0:04:41.28,Default,,0000,0000,0000,,Міндетті түрде жазу керек
Dialogue: 0,0:04:41.28,0:04:44.78,Rubi,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:04:41.28,0:04:44.78,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:41.28,0:04:44.78,Default,,0000,0000,0000,,<Көп болғаны сонша, мен жазуым керек
Dialogue: 0,0:04:41.28,0:04:44.78,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:04:41.28,0:04:44.78,Default,,0000,0000,0000,,Ақпарат емес＞
Dialogue: 0,0:04:44.78,0:04:46.28,Default,,0000,0000,0000,,...
Dialogue: 0,0:04:46.28,0:04:47.25,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:47.25,0:04:50.79,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:04:47.25,0:04:50.79,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:04:47.25,0:04:50.79,Default,,0000,0000,0000,,Үлкен апа Үлкен апа
Dialogue: 0,0:04:47.25,0:04:50.79,Rubi,,0000,0000,0000,,Шашин және
Dialogue: 0,0:04:47.25,0:04:50.79,Default,,0000,0000,0000,,Эй, суретке түсер ме едің?
Dialogue: 0,0:04:50.79,0:04:52.72,Rubi,,0000,0000,0000,,Шашин
Dialogue: 0,0:04:50.79,0:04:52.72,Default,,0000,0000,0000,,Фотосурет? Жарайды, бірақ неге?
Dialogue: 0,0:04:52.72,0:04:55.29,Rubi,,0000,0000,0000,,Ауаны ашыңыз
Dialogue: 0,0:04:52.72,0:04:55.29,Rubi,,0000,0000,0000,,қою
Dialogue: 0,0:04:52.72,0:04:55.29,Default,,0000,0000,0000,,Оны қаламдасыңызға жіберіңіз.
Dialogue: 0,0:04:55.29,0:04:56.79,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:04:55.29,0:04:56.79,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:04:55.29,0:04:56.79,Default,,0000,0000,0000,,Эй, эй, сыртқа шық!
Dialogue: 0,0:04:56.79,0:04:58.29,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:04:56.79,0:04:58.29,Default,,0000,0000,0000,,Фотосуретті қайда түсіруім керек?
Dialogue: 0,0:04:58.29,0:05:00.80,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:04:58.29,0:05:00.80,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:04:58.29,0:05:00.80,Default,,0000,0000,0000,,Гүл шоқының алдында
Dialogue: 0,0:05:00.80,0:05:04.67,Default,,0000,0000,0000,,Ақымақ! Оған дейін
Dialogue: 0,0:05:00.80,0:05:04.67,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:05:00.80,0:05:04.67,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,0:05:00.80,0:05:04.67,Default,,0000,0000,0000,,Мөлдір болудың қажеті жоқ, солай ма?
Dialogue: 0,0:05:04.67,0:05:06.67,Default,,0000,0000,0000,,Иә, үзіліс
Dialogue: 0,0:05:06.67,0:05:08.67,Default,,0000,0000,0000,,Олай!
Dialogue: 0,0:05:08.67,0:05:10.81,Default,,0000,0000,0000,,Сіз бұл позаны орындайсыз ба?
Dialogue: 0,0:05:10.81,0:05:13.71,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:05:10.81,0:05:13.71,Default,,0000,0000,0000,,Осыған ұқсас нәрсе
Dialogue: 0,0:05:10.81,0:05:13.71,Rubi,,0000,0000,0000,,Джонецутеги
Dialogue: 0,0:05:10.81,0:05:13.71,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:05:10.81,0:05:13.71,Default,,0000,0000,0000,,Бұл құмарлықты сезінеді, солай ма?
Dialogue: 0,0:05:13.71,0:05:16.68,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:13.71,0:05:16.68,Rubi,,0000,0000,0000,,Джонецутеги
Dialogue: 0,0:05:13.71,0:05:16.68,Default,,0000,0000,0000,,Еш нәрсеге құмар болмасаңыз да
Dialogue: 0,0:05:13.71,0:05:16.68,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:05:16.68,0:05:21.32,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:16.68,0:05:21.32,Rubi,,0000,0000,0000,,Бунцуу
Dialogue: 0,0:05:16.68,0:05:21.32,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:05:16.68,0:05:21.32,Default,,0000,0000,0000,,Маруконың хат алмасуға құмарлығы
Dialogue: 0,0:05:16.68,0:05:21.32,Rubi,,0000,0000,0000,,Шырмауық
Dialogue: 0,0:05:16.68,0:05:21.32,Default,,0000,0000,0000,,Мен сізге айтқым келеді
Dialogue: 0,0:05:21.32,0:05:22.82,Default,,0000,0000,0000,,Мен үйдемін!
Dialogue: 0,0:05:24.75,0:05:26.69,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:24.75,0:05:26.69,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:05:24.75,0:05:26.69,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:05:24.75,0:05:26.69,Default,,0000,0000,0000,,Ах, Маруко, мен де бүгін келемін.
Dialogue: 0,0:05:26.69,0:05:30.26,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:05:26.69,0:05:30.26,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:05:26.69,0:05:30.26,Rubi,,0000,0000,0000,,Окинава
Dialogue: 0,0:05:26.69,0:05:30.26,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:26.69,0:05:30.26,Default,,0000,0000,0000,,Бүгін бұл Окинавадан келген баладан.
Dialogue: 0,0:05:30.26,0:05:33.16,Default,,0000,0000,0000,,О, менің!
