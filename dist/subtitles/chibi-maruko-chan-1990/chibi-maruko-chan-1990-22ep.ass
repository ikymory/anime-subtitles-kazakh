Dialogue: 0,0:09:43.68,0:09:45.61,Default,,0000,0000,0000,,«Төзгісіз» Бұл жақсы.
Dialogue: 0,0:09:45.61,0:09:51.25,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:45.61,0:09:51.25,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:09:45.61,0:09:51.25,Default,,0000,0000,0000,,Мм, онда бармаудың орнына.
Dialogue: 0,0:09:45.61,0:09:51.25,Rubi,,0000,0000,0000,,Телефон
Dialogue: 0,0:09:45.61,0:09:51.25,Default,,0000,0000,0000,,Сізге телефон соғуға болады ма?
Dialogue: 0,0:09:51.25,0:09:54.16,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:09:51.25,0:09:54.16,Rubi,,0000,0000,0000,,Рёкин
Dialogue: 0,0:09:51.25,0:09:54.16,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:09:51.25,0:09:54.16,Default,,0000,0000,0000,,Алымдар Қанша тұрады деп ойлайсыз?
Dialogue: 0,0:09:54.16,0:09:58.13,Rubi,,0000,0000,0000,,Рёхи
Dialogue: 0,0:09:54.16,0:09:58.13,Rubi,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:09:54.16,0:09:58.13,Default,,0000,0000,0000,,Бұл жол жүру шығындарынан арзан!
Dialogue: 0,0:09:54.16,0:09:58.13,Default,,0000,0000,0000,,Сәлем иттебаа
Dialogue: 0,0:09:58.13,0:10:00.76,Default,,0000,0000,0000,,Менің таңдауым жоқ.
Dialogue: 0,0:09:58.13,0:10:00.76,Rubi,,0000,0000,0000,,Пун
Dialogue: 0,0:09:58.13,0:10:00.76,Default,,0000,0000,0000,,Бар болғаны 3 минут.
Dialogue: 0,0:10:00.76,0:10:04.27,Rubi,,0000,0000,0000,,Пун
Dialogue: 0,0:10:00.76,0:10:04.27,Default,,0000,0000,0000,,3 минут...
Dialogue: 0,0:10:00.76,0:10:04.27,Rubi,,0000,0000,0000,,Дайхон
Dialogue: 0,0:10:00.76,0:10:04.27,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:10:00.76,0:10:04.27,Default,,0000,0000,0000,,Содан кейін мен сценарий жазуым керек.
Dialogue: 0,0:10:04.27,0:10:05.23,Rubi,,0000,0000,0000,,Оқу құралы
Dialogue: 0,0:10:04.27,0:10:05.23,Default,,0000,0000,0000,,<Оқудан басқа нәрселер үшін
Dialogue: 0,0:10:05.23,0:10:08.73,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:10:05.23,0:10:08.73,Rubi,,0000,0000,0000,,Ол кенеттен қарсылық көрсете бастады!!
Dialogue: 0,0:10:05.23,0:10:08.73,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:10:05.23,0:10:08.73,Default,,0000,0000,0000,,Шынымен күш-жігеріңізді аямаңыз
Dialogue: 0,0:10:05.23,0:10:08.73,Default,,0000,0000,0000,,Бұл Мару-чан>
Dialogue: 0,0:10:11.77,0:10:13.71,Rubi,,0000,0000,0000,,Йонамин
Dialogue: 0,0:10:11.77,0:10:13.71,Default,,0000,0000,0000,,Йонамин мырза, сіз сондасыз ба?
Dialogue: 0,0:10:13.71,0:10:16.64,Rubi,,0000,0000,0000,,Қате
Dialogue: 0,0:10:13.71,0:10:16.64,Default,,0000,0000,0000,,Ей, қателеспе.
Dialogue: 0,0:10:13.71,0:10:16.64,Rubi,,0000,0000,0000,,Мауах
Dialogue: 0,0:10:13.71,0:10:16.64,Default,,0000,0000,0000,,Оны бұраңыз
Dialogue: 0,0:10:16.64,0:10:19.28,Rubi,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:10:16.64,0:10:19.28,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:10:16.64,0:10:19.28,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:10:16.64,0:10:19.28,Default,,0000,0000,0000,,()
Dialogue: 0,0:10:19.28,0:10:22.18,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:19.28,0:10:22.18,Rubi,,0000,0000,0000,,Йонамин
Dialogue: 0,0:10:19.28,0:10:22.18,Rubi,,0000,0000,0000,,Таку
Dialogue: 0,0:10:19.28,0:10:22.18,Default,,0000,0000,0000,,Ио, бұл Йонамин-санның үйі ме?
Dialogue: 0,0:10:22.18,0:10:25.09,Default,,0000,0000,0000,,Чи чи сәл
Dialogue: 0,0:10:22.18,0:10:25.09,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:10:22.18,0:10:25.09,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:10:22.18,0:10:25.09,Default,,0000,0000,0000,,Ананың орнын басады
Dialogue: 0,0:10:25.09,0:10:27.72,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:10:25.09,0:10:27.72,Default,,0000,0000,0000,,Е, иә, иә, күте тұрыңыз.
Dialogue: 0,0:10:25.09,0:10:27.72,Default,,0000,0000,0000,,Дәл солай...
Dialogue: 0,0:10:27.72,0:10:32.23,Default,,0000,0000,0000,,Сәлем, сәлем
Dialogue: 0,0:10:27.72,0:10:32.23,Rubi,,0000,0000,0000,,Шизуокакен
Dialogue: 0,0:10:27.72,0:10:32.23,Rubi,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:10:27.72,0:10:32.23,Default,,0000,0000,0000,,Менің атым Сидзуока префектурасынан Сакура.
Dialogue: 0,0:10:32.23,0:10:36.10,Rubi,,0000,0000,0000,,Бунцуу
Dialogue: 0,0:10:32.23,0:10:36.10,Default,,0000,0000,0000,,Иә, қаламдас... иә.
Dialogue: 0,0:10:32.23,0:10:36.10,Rubi,,0000,0000,0000,,Утако
Dialogue: 0,0:10:32.23,0:10:36.10,Default,,0000,0000,0000,,Утако-сан, сен осындасың ба?
Dialogue: 0,0:10:36.10,0:10:38.73,Rubi,,0000,0000,0000,,Утако
Dialogue: 0,0:10:36.10,0:10:38.73,Default,,0000,0000,0000,,Ах, Утако-сан.
Dialogue: 0,0:10:36.10,0:10:38.73,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:10:38.73,0:10:40.24,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:10:38.73,0:10:40.24,Rubi,,0000,0000,0000,,Утако
Dialogue: 0,0:10:38.73,0:10:40.24,Default,,0000,0000,0000,,Қараңызшы, Маруко, Утако-сан.
Dialogue: 0,0:10:40.24,0:10:47.11,Default,,0000,0000,0000,,Хаа… Сәлем сәлем
Dialogue: 0,0:10:40.24,0:10:47.11,Default,,0000,0000,0000,,Сәлем, мен Момоко Сакурамын.
Dialogue: 0,0:10:47.11,0:10:49.74,Rubi,,0000,0000,0000,,Утако
Dialogue: 0,0:10:47.11,0:10:49.74,Rubi,,0000,0000,0000,,Утако
Dialogue: 0,0:10:47.11,0:10:49.74,Default,,0000,0000,0000,,()
Dialogue: 0,0:10:47.11,0:10:49.74,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:10:49.74,0:10:53.25,Default,,0000,0000,0000,,<«Сәлем, сәлем»
Dialogue: 0,0:10:49.74,0:10:53.25,Rubi,,0000,0000,0000,,Банпаку
Dialogue: 0,0:10:49.74,0:10:53.25,Default,,0000,0000,0000,,Expo? Сіз...>
Dialogue: 0,0:10:53.25,0:10:55.75,Rubi,,0000,0000,0000,,Утако
Dialogue: 0,0:10:53.25,0:10:55.75,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:10:53.25,0:10:55.75,Rubi,,0000,0000,0000,,Рейшу
Dialogue: 0,0:10:53.25,0:10:55.75,Rubi,,0000,0000,0000,,Сай
Dialogue: 0,0:10:53.25,0:10:55.75,Default,,0000,0000,0000,,() ９
Dialogue: 0,0:10:55.75,0:10:57.69,Default,,0000,0000,0000,,Құттықтаймын
Dialogue: 0,0:10:57.69,0:11:00.62,Rubi,,0000,0000,0000,,Утако
Dialogue: 0,0:10:57.69,0:11:00.62,Rubi,,0000,0000,0000,,Қандай түс?
Dialogue: 0,0:10:57.69,0:11:00.62,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:10:57.69,0:11:00.62,Default,,0000,0000,0000,,Утако қандай түсті ұнатады?
Dialogue: 0,0:11:00.62,0:11:01.62,Rubi,,0000,0000,0000,,Утако
Dialogue: 0,0:11:00.62,0:11:01.62,Default,,0000,0000,0000,,()
Dialogue: 0,0:11:01.62,0:11:03.63,Default,,0000,0000,0000,,А... Түсіндім.
Dialogue: 0,0:11:03.63,0:11:06.26,Rubi,,0000,0000,0000,,Когое
Dialogue: 0,0:11:03.63,0:11:06.26,Default,,0000,0000,0000,,Сәлем, жақында
Dialogue: 0,0:11:03.63,0:11:06.26,Rubi,,0000,0000,0000,,Пун
Dialogue: 0,0:11:03.63,0:11:06.26,Default,,0000,0000,0000,,3 минут болды.
Dialogue: 0,0:11:06.26,0:11:09.76,Default,,0000,0000,0000,,Ах... Онда кездескенше.
Dialogue: 0,0:11:06.26,0:11:09.76,Rubi,,0000,0000,0000,,Тегами?
Dialogue: 0,0:11:06.26,0:11:09.76,Default,,0000,0000,0000,,Мен саған хат жазамын. Сау бол!
Dialogue: 0,0:11:09.76,0:11:11.27,Rubi,,0000,0000,0000,,Пун
Dialogue: 0,0:11:09.76,0:11:11.27,Default,,0000,0000,0000,,3 минут қана қауіпсіз
Dialogue: 0,0:11:11.27,0:11:15.14,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:11:11.27,0:11:15.14,Rubi,,0000,0000,0000,,Бір көршім айтып еді…
Dialogue: 0,0:11:11.27,0:11:15.14,Rubi,,0000,0000,0000,,Телефон
Dialogue: 0,0:11:11.27,0:11:15.14,Default,,0000,0000,0000,,<Қоңыраудың мақсаты не болды?
Dialogue: 0,0:11:11.27,0:11:15.14,Default,,0000,0000,0000,,Мен мүлде түсінбеймін>
Dialogue: 0,0:11:15.14,0:11:17.77,Rubi,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:11:15.14,0:11:17.77,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:11:15.14,0:11:17.77,Default,,0000,0000,0000,,А, мен сенің дауысыңды естігеніме қуаныштымын.
Dialogue: 0,0:11:17.77,0:11:21.64,Rubi,,0000,0000,0000,,Утако
Dialogue: 0,0:11:17.77,0:11:21.64,Default,,0000,0000,0000,,Иә! Утако
Dialogue: 0,0:11:17.77,0:11:21.64,Rubi,,0000,0000,0000,,Керемет жұмыс
Dialogue: 0,0:11:17.77,0:11:21.64,Rubi,,0000,0000,0000,,қою
Dialogue: 0,0:11:17.77,0:11:21.64,Default,,0000,0000,0000,,Туған күнге сыйлық жіберейік
Dialogue: 0,0:11:21.64,0:11:25.65,Default,,0000,0000,0000,,Сосын менің жағдайымда да.
Dialogue: 0,0:11:21.64,0:11:25.65,Rubi,,0000,0000,0000,,қою
Dialogue: 0,0:11:21.64,0:11:25.65,Default,,0000,0000,0000,,Сіз оны маған жібере аласыз.
Dialogue: 0,0:11:25.65,0:11:27.78,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:11:25.65,0:11:27.78,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:25.65,0:11:27.78,Default,,0000,0000,0000,,Анашым, сізге не керек?
Dialogue: 0,0:11:27.78,0:11:30.29,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:11:27.78,0:11:30.29,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:27.78,0:11:30.29,Rubi,,0000,0000,0000,,Шимизу
Dialogue: 0,0:11:27.78,0:11:30.29,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:11:27.78,0:11:30.29,Default,,0000,0000,0000,,Мен Шимизуге тән нәрсе алғым келеді.
Dialogue: 0,0:11:30.29,0:11:32.79,Default,,0000,0000,0000,,Олай болса, ата
Dialogue: 0,0:11:30.29,0:11:32.79,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:11:30.29,0:11:32.79,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:11:30.29,0:11:32.79,Default,,0000,0000,0000,,Біраз сатып ал.
Dialogue: 0,0:11:33.79,0:11:36.29,Rubi,,0000,0000,0000,,Шимизу
Dialogue: 0,0:11:33.79,0:11:36.29,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:11:33.79,0:11:36.29,Default,,0000,0000,0000,,Шимизуге тән заттар: Атамдікі
Dialogue: 0,0:11:33.79,0:11:36.29,Rubi,,0000,0000,0000,,Аралау
Dialogue: 0,0:11:33.79,0:11:36.29,Default,,0000,0000,0000,,Жақсы сезіммен көріну
Dialogue: 0,0:11:36.29,0:11:38.79,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:11:36.29,0:11:38.79,Default,,0000,0000,0000,,(Томозо)
Dialogue: 0,0:11:36.29,0:11:38.79,Default,,0000,0000,0000,,Иә? Атаның сезімі?
Dialogue: 0,0:11:38.79,0:11:41.30,Default,,0000,0000,0000,,О, бұл туралы не деуге болады?
Dialogue: 0,0:11:41.30,0:11:42.80,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:41.30,0:11:42.80,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:11:42.80,0:11:46.67,Rubi,,0000,0000,0000,,Джирочо
Dialogue: 0,0:11:42.80,0:11:46.67,Default,,0000,0000,0000,,Джирочодікі
Dialogue: 0,0:11:42.80,0:11:46.67,Rubi,,0000,0000,0000,,Сандгаса
Dialogue: 0,0:11:42.80,0:11:46.67,Default,,0000,0000,0000,,Сандогаса және Каппа.
Dialogue: 0,0:11:46.67,0:11:50.31,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:11:46.67,0:11:50.31,Rubi,,0000,0000,0000,,Риппа
Dialogue: 0,0:11:46.67,0:11:50.31,Default,,0000,0000,0000,,Бұл әдемі және жабыны бар.
Dialogue: 0,0:11:50.31,0:11:51.81,Rubi,,0000,0000,0000,,Така
Dialogue: 0,0:11:50.31,0:11:51.81,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:11:50.31,0:11:51.81,Default,,0000,0000,0000,,Қымбат көрінеді!
Dialogue: 0,0:11:51.81,0:11:53.74,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:11:51.81,0:11:53.74,Default,,0000,0000,0000,,Жақсы, мен шештім. Мұны істейік!
Dialogue: 0,0:11:53.74,0:11:56.68,Default,,0000,0000,0000,,Уау ата
Dialogue: 0,0:11:53.74,0:11:56.68,Default,,0000,0000,0000,,Өте керемет!
Dialogue: 0,0:11:56.68,0:12:00.82,Rubi,,0000,0000,0000,,Тенин
Dialogue: 0,0:11:56.68,0:12:00.82,Default,,0000,0000,0000,,...
Dialogue: 0,0:11:56.68,0:12:00.82,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:11:56.68,0:12:00.82,Rubi,,0000,0000,0000,,Жоғарғы
Dialogue: 0,0:11:56.68,0:12:00.82,Default,,0000,0000,0000,,Ах~ Тұтынушы, оны кию қиын.
Dialogue: 0,0:12:00.82,0:12:03.32,Default,,0000,0000,0000,,Үйдемін!
Dialogue: 0,0:12:03.32,0:12:06.82,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:12:03.32,0:12:06.82,Rubi,,0000,0000,0000,,Канагава
Dialogue: 0,0:12:03.32,0:12:06.82,Rubi,,0000,0000,0000,,Окинава
Dialogue: 0,0:12:03.32,0:12:06.82,Default,,0000,0000,0000,,Бүгін біз Канагава мен Окинава туралы сөйлесеміз.
Dialogue: 0,0:12:03.32,0:12:06.82,Rubi,,0000,0000,0000,,Рихо
Dialogue: 0,0:12:03.32,0:12:06.82,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:12:03.32,0:12:06.82,Default,,0000,0000,0000,,Екі жақтан келе жатыр, иә.
Dialogue: 0,0:12:06.82,0:12:10.33,Rubi,,0000,0000,0000,,Рихо
Dialogue: 0,0:12:06.82,0:12:10.33,Default,,0000,0000,0000,,Не, екеуінен де?
