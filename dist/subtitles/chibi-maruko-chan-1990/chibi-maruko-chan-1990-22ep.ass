Dialogue: 0,0:25:16.34,0:25:17.78,Default,,0000,0000,0000,,Ах Мару-чан
Dialogue: 0,0:25:17.78,0:25:20.68,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:25:17.78,0:25:20.68,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:25:17.78,0:25:20.68,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:25:17.78,0:25:20.68,Default,,0000,0000,0000,,Үйге барар алдында Үй тапсырмасын конспектілеу
Dialogue: 0,0:25:17.78,0:25:20.68,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:25:17.78,0:25:20.68,Default,,0000,0000,0000,,Оны жіберіңіз.
Dialogue: 0,0:25:20.68,0:25:24.65,Rubi,,0000,0000,0000,,Сансу
Dialogue: 0,0:25:20.68,0:25:24.65,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:25:20.68,0:25:24.65,Default,,0000,0000,0000,,Иә! математикадан үй тапсырмасына конспект
Dialogue: 0,0:25:24.65,0:25:28.29,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:25:24.65,0:25:28.29,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:25:24.65,0:25:28.29,Rubi,,0000,0000,0000,,Иноко
Dialogue: 0,0:25:24.65,0:25:28.29,Default,,0000,0000,0000,,Иә, ұмытқандар артта қалады.
Dialogue: 0,0:25:24.65,0:25:28.29,Default,,0000,0000,0000,,Енді әрі қарай жалғастырайық
Dialogue: 0,0:25:28.29,0:25:31.19,Rubi,,0000,0000,0000,,Тогавасенсей
Dialogue: 0,0:25:28.29,0:25:31.19,Default,,0000,0000,0000,,Тогава мырзадан
Dialogue: 0,0:25:28.29,0:25:31.19,Rubi,,0000,0000,0000,,Телефон
Dialogue: 0,0:25:28.29,0:25:31.19,Default,,0000,0000,0000,,Мен телефон соғып жатқанын естідім.
Dialogue: 0,0:25:31.19,0:25:35.16,Rubi,,0000,0000,0000,,Секигучи-кун
Dialogue: 0,0:25:31.19,0:25:35.16,Default,,0000,0000,0000,,Ал, Секигучи-кун және т.б.
Dialogue: 0,0:25:31.19,0:25:35.16,Rubi,,0000,0000,0000,,Математика
Dialogue: 0,0:25:31.19,0:25:35.16,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:25:31.19,0:25:35.16,Default,,0000,0000,0000,,Математикадан үй тапсырмасын орындайсыз ба?
Dialogue: 0,0:25:35.16,0:25:38.80,Default,,0000,0000,0000,,Оған не болды?
Dialogue: 0,0:25:35.16,0:25:38.80,Rubi,,0000,0000,0000,,Секигучи
Dialogue: 0,0:25:35.16,0:25:38.80,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:25:35.16,0:25:38.80,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:25:35.16,0:25:38.80,Default,,0000,0000,0000,,Сіз өте тітіркендіргішсіз! Тезірек үйге қайт!
Dialogue: 0,0:25:38.80,0:25:43.30,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:25:38.80,0:25:43.30,Default,,0000,0000,0000,,Тезірек жүр, Мару-чан!
Dialogue: 0,0:25:38.80,0:25:43.30,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:25:38.80,0:25:43.30,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:25:38.80,0:25:43.30,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:25:38.80,0:25:43.30,Default,,0000,0000,0000,,Үйге тапсырма дәптеріңді алып, үйге қайтайық!
Dialogue: 0,0:25:43.30,0:25:45.24,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:25:45.24,0:25:46.21,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:25:45.24,0:25:46.21,Default,,0000,0000,0000,,<Соңында Мару-чан
Dialogue: 0,0:25:46.21,0:25:49.81,Rubi,,0000,0000,0000,,Шинпай
Dialogue: 0,0:25:46.21,0:25:49.81,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:25:46.21,0:25:49.81,Default,,0000,0000,0000,,Ол мені уайымдап күтті.
Dialogue: 0,0:25:46.21,0:25:49.81,Rubi,,0000,0000,0000,,Миоку
Dialogue: 0,0:25:46.21,0:25:49.81,Default,,0000,0000,0000,,Тама-чанды шығарып салу
Dialogue: 0,0:25:49.81,0:25:52.31,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:25:49.81,0:25:52.31,Default,,0000,0000,0000,,Мен үй тапсырмасын жалғыз орындауды шештім.
Dialogue: 0,0:25:49.81,0:25:52.31,Default,,0000,0000,0000,,Бұл> айналды
Dialogue: 0,0:25:52.31,0:25:54.81,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:25:52.31,0:25:54.81,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:25:52.31,0:25:54.81,Default,,0000,0000,0000,,Бонд! Бүгін кешкі асқа не берілетінін болжа!
Dialogue: 0,0:25:52.31,0:25:54.81,Default,,0000,0000,0000,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:26:38.29,0:26:40.79,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:26:38.29,0:26:40.79,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:26:38.29,0:26:40.79,Rubi,,0000,0000,0000,,Қала
Dialogue: 0,0:26:38.29,0:26:40.79,Default,,0000,0000,0000,,Барлығыңыз келесі жолы Маруко қаласына келіңіздер.
Dialogue: 0,0:26:38.29,0:26:40.79,Rubi,,0000,0000,0000,,Оам
Dialogue: 0,0:26:38.29,0:26:40.79,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:26:38.29,0:26:40.79,Default,,0000,0000,0000,,Жаңбыр қатты жауып тұр
Dialogue: 0,0:26:40.79,0:26:42.23,Rubi,,0000,0000,0000,,Дайкозуи
Dialogue: 0,0:26:40.79,0:26:42.23,Default,,0000,0000,0000,,Үлкен су тасқыны болады.
Dialogue: 0,0:26:42.23,0:26:46.10,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:26:42.23,0:26:46.10,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:26:42.23,0:26:46.10,Rubi,,0000,0000,0000,,Жаңа
Dialogue: 0,0:26:42.23,0:26:46.10,Default,,0000,0000,0000,,Шатырдың басына су келді
Dialogue: 0,0:26:42.23,0:26:46.10,Rubi,,0000,0000,0000,,Ято өледі
Dialogue: 0,0:26:42.23,0:26:46.10,Rubi,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:26:42.23,0:26:46.10,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:26:42.23,0:26:46.10,Default,,0000,0000,0000,,Тоғандағы үйректер мен сазандар да қашып кетті.
Dialogue: 0,0:26:46.10,0:26:48.10,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,0:26:46.10,0:26:48.10,Default,,0000,0000,0000,,Бұл қазірдің өзінде қиын.
Dialogue: 0,0:26:48.10,0:26:50.10,Rubi,,0000,0000,0000,,Айнала
Dialogue: 0,0:26:48.10,0:26:50.10,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:26:48.10,0:26:50.10,Default,,0000,0000,0000,,Келесі «Чиби Маруко-чан»...
Dialogue: 0,0:26:56.24,0:27:10.24,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:11.74,0:27:17.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory