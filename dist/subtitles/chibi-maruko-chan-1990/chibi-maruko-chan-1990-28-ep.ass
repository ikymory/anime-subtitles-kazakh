Dialogue: 0,0:01:07.81,0:01:18.31,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:13.23,0:03:14.83,Rubi,,0000,0000,0000,,Кәмпит
Dialogue: 0,0:03:13.23,0:03:14.83,Default,,0000,0000,0000,,<Соңғы кездері жаңбыр көп жауды.
Dialogue: 0,0:03:14.83,0:03:18.34,Default,,0000,0000,0000,,Мару-чан үшін
Dialogue: 0,0:03:14.83,0:03:18.34,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:03:14.83,0:03:18.34,Rubi,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:03:14.83,0:03:18.34,Default,,0000,0000,0000,,Мазасыз күндер жалғасуда>
Dialogue: 0,0:03:18.34,0:03:20.27,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:18.34,0:03:20.27,Rubi,,0000,0000,0000,,Чикоку
Dialogue: 0,0:03:18.34,0:03:20.27,Default,,0000,0000,0000,,Ах~ Сіз кешігіп қалдыңыз~
Dialogue: 0,0:03:20.27,0:03:22.21,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:20.27,0:03:22.21,Rubi,,0000,0000,0000,,Қолшатыр
Dialogue: 0,0:03:20.27,0:03:22.21,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:22.21,0:03:24.84,Default,,0000,0000,0000,,Жоқ, маған керегі жоқ.
Dialogue: 0,0:03:24.84,0:03:29.28,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:03:24.84,0:03:29.28,Rubi,,0000,0000,0000,,Кәмпит
Dialogue: 0,0:03:24.84,0:03:29.28,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:03:24.84,0:03:29.28,Default,,0000,0000,0000,,Жоқ, бүгін жаңбыр жауады.
Dialogue: 0,0:03:24.84,0:03:29.28,Rubi,,0000,0000,0000,,Тенкиохоу
Dialogue: 0,0:03:24.84,0:03:29.28,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:24.84,0:03:29.28,Default,,0000,0000,0000,,Өйткені ауа райы болжамы солай айтқан.
Dialogue: 0,0:03:29.28,0:03:30.78,Default,,0000,0000,0000,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:03:29.28,0:03:30.78,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:03:30.78,0:03:33.29,Rubi,,0000,0000,0000,,Қолшатыр
Dialogue: 0,0:03:30.78,0:03:33.29,Rubi,,0000,0000,0000,,Негізінен
Dialogue: 0,0:03:30.78,0:03:33.29,Default,,0000,0000,0000,,<Қолшатыр - бұл өте ауыр жүк>
Dialogue: 0,0:03:33.29,0:03:35.22,Rubi,,0000,0000,0000,,Чикоку
Dialogue: 0,0:03:33.29,0:03:35.22,Default,,0000,0000,0000,,Қараңдар, мен кешігіп барамын.
Dialogue: 0,0:03:35.22,0:03:48.77,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:48.77,0:03:51.30,Default,,0000,0000,0000,,Қайырлы таң, Мару-чан
Dialogue: 0,0:03:51.30,0:03:54.81,Default,,0000,0000,0000,,Қайырлы таң Тама-чан...
Dialogue: 0,0:03:54.81,0:03:57.71,Rubi,,0000,0000,0000,,Тенки
Dialogue: 0,0:03:54.81,0:03:57.71,Default,,0000,0000,0000,,Ауа-райы қандай.
Dialogue: 0,0:03:57.71,0:03:59.68,Rubi,,0000,0000,0000,,Күнделікті
Dialogue: 0,0:03:57.71,0:03:59.68,Rubi,,0000,0000,0000,,Қолшатыр
Dialogue: 0,0:03:57.71,0:03:59.68,Default,,0000,0000,0000,,Haunt Күнде осындай қолшатыр
Dialogue: 0,0:03:59.68,0:04:02.31,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:03:59.68,0:04:02.31,Default,,0000,0000,0000,,Мен оны әкелуім керек.
Dialogue: 0,0:03:59.68,0:04:02.31,Default,,0000,0000,0000,,Ондай ештеңе жоқ.
Dialogue: 0,0:04:02.31,0:04:04.82,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:04:02.31,0:04:04.82,Default,,0000,0000,0000,,()
Dialogue: 0,0:04:02.31,0:04:04.82,Default,,0000,0000,0000,,Ханымдар
Dialogue: 0,0:04:04.82,0:04:06.82,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:04:04.82,0:04:06.82,Default,,0000,0000,0000,,Сергіту таңы.
Dialogue: 0,0:04:07.72,0:04:11.69,Rubi,,0000,0000,0000,,Тенки
Dialogue: 0,0:04:07.72,0:04:11.69,Default,,0000,0000,0000,,Бұл ауа райы қай жерде?
Dialogue: 0,0:04:07.72,0:04:11.69,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:04:07.72,0:04:11.69,Default,,0000,0000,0000,,Сергіту таңы, солай емес пе?
Dialogue: 0,0:04:11.69,0:04:16.83,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:04:11.69,0:04:16.83,Rubi,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:04:11.69,0:04:16.83,Default,,0000,0000,0000,,Кешіріңіз, мен бүгінмін
Dialogue: 0,0:04:11.69,0:04:16.83,Rubi,,0000,0000,0000,,Кәмпит
Dialogue: 0,0:04:11.69,0:04:16.83,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:04:11.69,0:04:16.83,Rubi,,0000,0000,0000,,Ду
Dialogue: 0,0:04:11.69,0:04:16.83,Default,,0000,0000,0000,,Жаңбырды күте алмаймын.
Dialogue: 0,0:04:16.83,0:04:18.33,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:04:18.33,0:04:20.83,Default,,0000,0000,0000,,(Жеу дыбысы)
Dialogue: 0,0:04:20.83,0:04:21.80,Default,,0000,0000,0000,,Міне
Dialogue: 0,0:04:21.80,0:04:23.80,Rubi,,0000,0000,0000,,Қолшатыр
Dialogue: 0,0:04:21.80,0:04:23.80,Default,,0000,0000,0000,,Бұл жай ғана қолшатыр
Dialogue: 0,0:04:25.34,0:04:27.34,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:25.34,0:04:27.34,Default,,0000,0000,0000,,Өтінемін, мені бақылаңыз.
Dialogue: 0,0:04:30.18,0:04:34.78,Default,,0000,0000,0000,,Уау! таңғажайып теледидар
Dialogue: 0,0:04:30.18,0:04:34.78,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:30.18,0:04:34.78,Default,,0000,0000,0000,,Мен оны жарнамадан көрдім.
Dialogue: 0,0:04:34.78,0:04:38.65,Default,,0000,0000,0000,,Бұл менің Франциядағы анам.
Dialogue: 0,0:04:34.78,0:04:38.65,Rubi,,0000,0000,0000,,қою
Dialogue: 0,0:04:34.78,0:04:38.65,Default,,0000,0000,0000,,Оны маған жіберді.
Dialogue: 0,0:04:38.65,0:04:40.29,Default,,0000,0000,0000,,Бұл тамаша~
Dialogue: 0,0:04:40.29,0:04:41.79,Rubi,,0000,0000,0000,,Ересек
Dialogue: 0,0:04:40.29,0:04:41.79,Default,,0000,0000,0000,,Ересек адам сияқты
Dialogue: 0,0:04:41.79,0:04:45.79,Default,,0000,0000,0000,,Хмф, бұл дандиизм.
Dialogue: 0,0:04:41.79,0:04:45.79,Default,,0000,0000,0000,,Соны айтамын, балақай
Dialogue: 0,0:04:47.66,0:04:50.30,Default,,0000,0000,0000,,Күрсін...
Dialogue: 0,0:04:47.66,0:04:50.30,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:04:50.30,0:04:54.80,Rubi,,0000,0000,0000,,Кәмпит
Dialogue: 0,0:04:50.30,0:04:54.80,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:04:50.30,0:04:54.80,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:04:50.30,0:04:54.80,Default,,0000,0000,0000,,(жаңбыр дыбысы)
Dialogue: 0,0:04:56.17,0:04:58.17,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:04:56.17,0:04:58.17,Default,,0000,0000,0000,,Жаңбыр жауып тұр.
Dialogue: 0,0:04:58.17,0:05:00.81,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:04:58.17,0:05:00.81,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:04:58.17,0:05:00.81,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:04:58.17,0:05:00.81,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:04:58.17,0:05:00.81,Default,,0000,0000,0000,,Мен де бүгін далада ойнай алмаймын.
Dialogue: 0,0:05:00.81,0:05:02.31,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:11.82,0:05:13.32,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:11.82,0:05:13.32,Default,,0000,0000,0000,,Кеттік
Dialogue: 0,0:05:11.82,0:05:13.32,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:15.69,0:05:19.19,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:05:15.69,0:05:19.19,Default,,0000,0000,0000,,Сәлем ханымдар
Dialogue: 0,0:05:15.69,0:05:19.19,Rubi,,0000,0000,0000,,Кәмпит
Dialogue: 0,0:05:15.69,0:05:19.19,Default,,0000,0000,0000,,Бұл көңілсіз жаңбыр.
Dialogue: 0,0:05:21.83,0:05:23.83,Rubi,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:05:21.83,0:05:23.83,Default,,0000,0000,0000,,Бірінші
Dialogue: 0,0:05:21.83,0:05:23.83,Default,,0000,0000,0000,,Тағы кездескенше!
Dialogue: 0,0:05:24.73,0:05:28.63,Rubi,,0000,0000,0000,,Қолшатыр
Dialogue: 0,0:05:24.73,0:05:28.63,Default,,0000,0000,0000,,Керемет~ Мынау қолшатыр...
Dialogue: 0,0:05:28.63,0:05:32.27,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:05:28.63,0:05:32.27,Rubi,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:05:28.63,0:05:32.27,Rubi,,0000,0000,0000,,Хира
Dialogue: 0,0:05:28.63,0:05:32.27,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:05:28.63,0:05:32.27,Default,,0000,0000,0000,,()
Dialogue: 0,0:05:28.63,0:05:32.27,Default,,0000,0000,0000,,…
Dialogue: 0,0:05:32.27,0:05:34.77,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:32.27,0:05:34.77,Default,,0000,0000,0000,,Маруко қош келдіңіз
Dialogue: 0,0:05:32.27,0:05:34.77,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:05:34.77,0:05:37.27,Default,,0000,0000,0000,,Ұрланып әкетілген адамдардың кимонолары мен заттары ма?
Dialogue: 0,0:05:34.77,0:05:37.27,Rubi,,0000,0000,0000,,Генки
Dialogue: 0,0:05:34.77,0:05:37.27,Default,,0000,0000,0000,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:05:38.28,0:05:40.78,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:05:38.28,0:05:40.78,Rubi,,0000,0000,0000,,Кәмпит
Dialogue: 0,0:05:38.28,0:05:40.78,Default,,0000,0000,0000,,Өйткені бүгін де жаңбыр жауып тұр.\NЕгер бұл
Dialogue: 0,0:05:40.78,0:05:44.28,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:05:40.78,0:05:44.28,Default,,0000,0000,0000,,болса, онда жақсы нәрсе бар.
Dialogue: 0,0:05:44.28,0:05:45.28,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:48.15,0:05:50.15,Default,,0000,0000,0000,,Ах, уау!
Dialogue: 0,0:05:51.16,0:05:54.29,Rubi,,0000,0000,0000,,Қолшатыр
Dialogue: 0,0:05:51.16,0:05:54.29,Default,,0000,0000,0000,,Бұл жаңа қолшатыр!
Dialogue: 0,0:05:54.29,0:05:55.80,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:05:54.29,0:05:55.80,Default,,0000,0000,0000,,Бұл сіздің әпкеңізге сәйкес келеді.
Dialogue: 0,0:05:55.80,0:05:56.76,Default,,0000,0000,0000,,Эй, мен саған көмектесе аламын ба?
Dialogue: 0,0:05:56.76,0:05:59.67,Default,,0000,0000,0000,,О, керемет
Dialogue: 0,0:05:56.76,0:05:59.67,Rubi,,0000,0000,0000,,Қолшатыр
Dialogue: 0,0:05:56.76,0:05:59.67,Default,,0000,0000,0000,,Бұл «Бұл не?» қолшатыры.
Dialogue: 0,0:05:59.67,0:06:01.67,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,0:06:01.67,0:06:03.30,Default,,0000,0000,0000,,О~хохохохо
Dialogue: 0,0:06:01.67,0:06:03.30,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,0:06:03.30,0:06:04.80,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:03.30,0:06:04.80,Default,,0000,0000,0000,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:06:04.80,0:06:06.74,Default,,0000,0000,0000,,Уау~ Ухухуфу
Dialogue: 0,0:06:04.80,0:06:06.74,Default,,0000,0000,0000,,Ахахха.
Dialogue: 0,0:06:06.74,0:06:09.24,Default,,0000,0000,0000,,Ухухуху Ухухуху
Dialogue: 0,0:06:11.31,0:06:12.81,Default,,0000,0000,0000,,«Бұл не?»
Dialogue: 0,0:06:12.81,0:06:14.31,Default,,0000,0000,0000,,«Идеал»
Dialogue: 0,0:06:15.31,0:06:17.25,Default,,0000,0000,0000,,Хэхе…
Dialogue: 0,0:06:17.25,0:06:18.82,Rubi,,0000,0000,0000,,Джошики
Dialogue: 0,0:06:17.25,0:06:18.82,Default,,0000,0000,0000,,«Бұл қарапайым ақыл»
Dialogue: 0,0:06:18.82,0:06:20.75,Default,,0000,0000,0000,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,0:06:20.75,0:06:26.33,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:06:20.75,0:06:26.33,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:20.75,0:06:26.33,Default,,0000,0000,0000,,Жарайды, қазір Маруко.
Dialogue: 0,0:06:20.75,0:06:26.33,Rubi,,0000,0000,0000,,Коуфуку
Dialogue: 0,0:06:20.75,0:06:26.33,Rubi,,0000,0000,0000,,Гекчо
Dialogue: 0,0:06:20.75,0:06:26.33,Default,,0000,0000,0000,,Бақыттың шыңындамын.
Dialogue: 0,0:06:26.33,0:06:30.76,Rubi,,0000,0000,0000,,Джошики
Dialogue: 0,0:06:26.33,0:06:30.76,Default,,0000,0000,0000,,«Бұл ақылдылық» Ертең
Dialogue: 0,0:06:26.33,0:06:30.76,Rubi,,0000,0000,0000,,Қолшатыр
Dialogue: 0,0:06:26.33,0:06:30.76,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:06:26.33,0:06:30.76,Default,,0000,0000,0000,,Мен мына қолшатырды әкелуім керек.
Dialogue: 0,0:06:30.76,0:06:34.27,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,0:06:30.76,0:06:34.27,Default,,0000,0000,0000,,Бірақ ертең күн ашық болады
Dialogue: 0,0:06:30.76,0:06:34.27,Rubi,,0000,0000,0000,,Тенкиёхоу
Dialogue: 0,0:06:30.76,0:06:34.27,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:06:30.76,0:06:34.27,Default,,0000,0000,0000,,Ауа райы болжамында айтылды.
Dialogue: 0,0:06:34.27,0:06:38.14,Rubi,,0000,0000,0000,,Қанкей
Dialogue: 0,0:06:34.27,0:06:38.14,Default,,0000,0000,0000,,Хехе, маңызды емес.
Dialogue: 0,0:06:34.27,0:06:38.14,Rubi,,0000,0000,0000,,Кисецу
Dialogue: 0,0:06:34.27,0:06:38.14,Rubi,,0000,0000,0000,,Қолшатыр
Dialogue: 0,0:06:34.27,0:06:38.14,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:06:34.27,0:06:38.14,Default,,0000,0000,0000,,Осы маусымда өзіңізбен бірге не алу керек:
Dialogue: 0,0:06:38.14,0:06:39.77,Rubi,,0000,0000,0000,,Джошики
Dialogue: 0,0:06:38.14,0:06:39.77,Default,,0000,0000,0000,,«Бұл қарапайым ақыл»
Dialogue: 0,0:06:39.77,0:06:43.27,Rubi,,0000,0000,0000,,Ақаулық
Dialogue: 0,0:06:39.77,0:06:43.27,Default,,0000,0000,0000,,<Оны мазалаған адам болды
