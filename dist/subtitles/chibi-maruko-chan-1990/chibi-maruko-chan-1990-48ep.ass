Dialogue: 0,0:06:57.87,0:07:01.48,Default,,0000,0000,0000,,Хаха... Сәлем.
Dialogue: 0,0:07:01.48,0:07:05.35,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:01.48,0:07:05.35,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:07:01.48,0:07:05.35,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:07:01.48,0:07:05.35,Default,,0000,0000,0000,,Маруко! Бүгін бірінші күн
Dialogue: 0,0:07:01.48,0:07:05.35,Rubi,,0000,0000,0000,,Бөлме
Dialogue: 0,0:07:01.48,0:07:05.35,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:01.48,0:07:05.35,Rubi,,0000,0000,0000,,Якусоку
Dialogue: 0,0:07:01.48,0:07:05.35,Default,,0000,0000,0000,,Сіз бұл бөлмеге келмеуге уәде бергенсіз!
Dialogue: 0,0:07:05.35,0:07:07.35,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:07:05.35,0:07:07.35,Default,,0000,0000,0000,,Бұл қосылмаған.
Dialogue: 0,0:07:07.35,0:07:11.99,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:07.35,0:07:11.99,Rubi,,0000,0000,0000,,Кедергі
Dialogue: 0,0:07:07.35,0:07:11.99,Default,,0000,0000,0000,,Ана Маруко кедергі жасайды
Dialogue: 0,0:07:07.35,0:07:11.99,Default,,0000,0000,0000,,Бірдеңе істе!
Dialogue: 0,0:07:11.99,0:07:14.49,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:11.99,0:07:14.49,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:11.99,0:07:14.49,Default,,0000,0000,0000,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:07:14.49,0:07:16.99,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:07:14.49,0:07:16.99,Default,,0000,0000,0000,,Мен кетемін
Dialogue: 0,0:07:14.49,0:07:16.99,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:07:14.49,0:07:16.99,Default,,0000,0000,0000,,Тек шығу керек!
Dialogue: 0,0:07:16.99,0:07:18.93,Default,,0000,0000,0000,,Жоқ. Сенің мақсатың не екенін білмеймін, бірақ бұл күмәнді.
Dialogue: 0,0:07:16.99,0:07:18.93,Default,,0000,0000,0000,,Джоу…
Dialogue: 0,0:07:18.93,0:07:21.50,Rubi,,0000,0000,0000,,Око
Dialogue: 0,0:07:18.93,0:07:21.50,Default,,0000,0000,0000,,А, мен ашуландым.
Dialogue: 0,0:07:21.50,0:07:25.00,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:21.50,0:07:25.00,Default,,0000,0000,0000,,Жақсы емес Маруко
Dialogue: 0,0:07:21.50,0:07:25.00,Rubi,,0000,0000,0000,,Генки
Dialogue: 0,0:07:21.50,0:07:25.00,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:07:21.50,0:07:25.00,Default,,0000,0000,0000,,Көңіл көтер, күрес!
Dialogue: 0,0:07:25.00,0:07:27.50,Default,,0000,0000,0000,,На-чат
Dialogue: 0,0:07:25.00,0:07:27.50,Default,,0000,0000,0000,,Сен оны бірнеше күн бұрын ертіп келгенде маған айтсаң ғой.
Dialogue: 0,0:07:27.50,0:07:29.44,Default,,0000,0000,0000,,<Шын ақиқат>
Dialogue: 0,0:07:29.44,0:07:32.01,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:07:29.44,0:07:32.01,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:29.44,0:07:32.01,Default,,0000,0000,0000,,Ах Маруко
Dialogue: 0,0:07:32.01,0:07:33.51,Default,,0000,0000,0000,,Аа, ата
Dialogue: 0,0:07:33.51,0:07:35.44,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:07:33.51,0:07:35.44,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:33.51,0:07:35.44,Default,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:07:35.44,0:07:37.38,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:35.44,0:07:37.38,Default,,0000,0000,0000,,Қане, Маруко...
Dialogue: 0,0:07:37.38,0:07:39.38,Rubi,,0000,0000,0000,,Бөлме
Dialogue: 0,0:07:37.38,0:07:39.38,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:07:37.38,0:07:39.38,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:07:37.38,0:07:39.38,Default,,0000,0000,0000,,Мені бөлмеден қуып жіберді.
Dialogue: 0,0:07:37.38,0:07:39.38,Default,,0000,0000,0000,,Хаха…
Dialogue: 0,0:07:39.38,0:07:42.02,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:07:39.38,0:07:42.02,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:07:39.38,0:07:42.02,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:07:39.38,0:07:42.02,Default,,0000,0000,0000,,Бірақ бәрібір
