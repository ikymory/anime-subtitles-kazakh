Dialogue: 0,0:21:08.99,0:21:13.86,Default,,0000,0000,0000,,Біртүрлі нәрселерді сұрама.
Dialogue: 0,0:21:13.86,0:21:16.86,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:21:13.86,0:21:16.86,Default,,0000,0000,0000,,Біртүрлі нәрсе
Dialogue: 0,0:21:13.86,0:21:16.86,Default,,0000,0000,0000,,Мен қайыр сұрамаймын.
Dialogue: 0,0:21:16.86,0:21:19.50,Default,,0000,0000,0000,,Сәлем, ата!
Dialogue: 0,0:21:19.50,0:21:22.40,Default,,0000,0000,0000,,О, дұрыс.
Dialogue: 0,0:21:19.50,0:21:22.40,Default,,0000,0000,0000,,Дұрыс Ахаха
Dialogue: 0,0:21:22.40,0:21:25.37,Default,,0000,0000,0000,,D. Бұл экзотикалық.
Dialogue: 0,0:21:22.40,0:21:25.37,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:25.37,0:21:28.01,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:21:25.37,0:21:28.01,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:21:25.37,0:21:28.01,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:21:25.37,0:21:28.01,Default,,0000,0000,0000,,Қазір жасайық Жасайық
Dialogue: 0,0:21:25.37,0:21:28.01,Default,,0000,0000,0000,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:21:28.01,0:21:31.51,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:28.01,0:21:31.51,Default,,0000,0000,0000,,Маруко, сен қалай ойлайсың?
Dialogue: 0,0:21:28.01,0:21:31.51,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:21:28.01,0:21:31.51,Default,,0000,0000,0000,,Төсегіңді осында қойсаң
Dialogue: 0,0:21:31.51,0:21:35.02,Default,,0000,0000,0000,,Иә, жарайды.
Dialogue: 0,0:21:31.51,0:21:35.02,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:31.51,0:21:35.02,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:21:31.51,0:21:35.02,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:21:31.51,0:21:35.02,Default,,0000,0000,0000,,Маруко Маған ұнады
Dialogue: 0,0:21:35.02,0:21:37.52,Default,,0000,0000,0000,,Бірақ кереует ше?
Dialogue: 0,0:21:37.52,0:21:41.39,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:21:37.52,0:21:41.39,Rubi,,0000,0000,0000,,Бако
Dialogue: 0,0:21:37.52,0:21:41.39,Rubi,,0000,0000,0000,,Засши
Dialogue: 0,0:21:37.52,0:21:41.39,Rubi,,0000,0000,0000,,Рио
Dialogue: 0,0:21:37.52,0:21:41.39,Default,,0000,0000,0000,,Иә, бос жәшіктер мен журналдарды пайдалану.
Dialogue: 0,0:21:37.52,0:21:41.39,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:21:37.52,0:21:41.39,Default,,0000,0000,0000,,Жасаңыз
Dialogue: 0,0:21:41.39,0:21:43.39,Default,,0000,0000,0000,,Иә, иә!
Dialogue: 0,0:21:43.39,0:21:46.03,Rubi,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:21:43.39,0:21:46.03,Default,,0000,0000,0000,,Олай болса әрекетті бастайық!
Dialogue: 0,0:21:43.39,0:21:46.03,Default,,0000,0000,0000,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:21:46.03,0:21:48.53,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:46.03,0:21:48.53,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:21:46.03,0:21:48.53,Default,,0000,0000,0000,,Маруконың төсегін қалай жасауға болады!
Dialogue: 0,0:21:46.03,0:21:48.53,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:21:46.03,0:21:48.53,Default,,0000,0000,0000,,Ооооооооо!
Dialogue: 0,0:21:48.53,0:21:49.96,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:21:48.53,0:21:49.96,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:21:49.96,0:21:53.47,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:21:49.96,0:21:53.47,Default,,0000,0000,0000,,Хаха О! Тотто
Dialogue: 0,0:21:49.96,0:21:53.47,Default,,0000,0000,0000,,Ол… ол тұрып кетті!
Dialogue: 0,0:21:53.47,0:21:55.40,Default,,0000,0000,0000,,(Хироши, Сакико, әже)
Dialogue: 0,0:21:53.47,0:21:55.40,Default,,0000,0000,0000,,А?
Dialogue: 0,0:21:55.40,0:21:58.34,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:55.40,0:21:58.34,Default,,0000,0000,0000,,Сәлем Маруко
Dialogue: 0,0:21:55.40,0:21:58.34,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:21:55.40,0:21:58.34,Default,,0000,0000,0000,,Жерде не бар?
Dialogue: 0,0:21:58.34,0:22:00.98,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:21:58.34,0:22:00.98,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:21:58.34,0:22:00.98,Default,,0000,0000,0000,,Хехехехе Қарау қызық
Dialogue: 0,0:22:00.98,0:22:04.48,Default,,0000,0000,0000,,Әй, ата, хехехе
Dialogue: 0,0:22:00.98,0:22:04.48,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:22:00.98,0:22:04.48,Default,,0000,0000,0000,,О, хехехе
Dialogue: 0,0:22:04.48,0:22:06.41,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:22:04.48,0:22:06.41,Rubi,,0000,0000,0000,,Бако
Dialogue: 0,0:22:04.48,0:22:06.41,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:22:04.48,0:22:06.41,Rubi,,0000,0000,0000,,Бако
Dialogue: 0,0:22:04.48,0:22:06.41,Default,,0000,0000,0000,,Енді бос жәшік, бос қорап...
Dialogue: 0,0:22:04.48,0:22:06.41,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:22:06.41,0:22:10.99,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:06.41,0:22:10.99,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:22:06.41,0:22:10.99,Default,,0000,0000,0000,,Хой хой хой хой
Dialogue: 0,0:22:06.41,0:22:10.99,Default,,0000,0000,0000,,Уа, ау, ау
Dialogue: 0,0:22:10.99,0:22:13.99,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:22:10.99,0:22:13.99,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:22:10.99,0:22:13.99,Default,,0000,0000,0000,,Қызық, неден басталады?
Dialogue: 0,0:22:15.49,0:22:16.99,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:22:15.49,0:22:16.99,Default,,0000,0000,0000,,Мен сен осы тасты жарып өте алмайсың деп ойладым…
Dialogue: 0,0:22:16.99,0:22:19.49,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:16.99,0:22:19.49,Default,,0000,0000,0000,,О, Маруко
Dialogue: 0,0:22:16.99,0:22:19.49,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:22:16.99,0:22:19.49,Default,,0000,0000,0000,,Осы жерге қойыңыз
Dialogue: 0,0:22:19.49,0:22:22.99,Default,,0000,0000,0000,,Иә! Жақсы соққы
Dialogue: 0,0:22:19.49,0:22:22.99,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:22:19.49,0:22:22.99,Default,,0000,0000,0000,,А, жарайды.
Dialogue: 0,0:22:24.37,0:22:27.37,Default,,0000,0000,0000,,Бұл жерде тағы біраз
Dialogue: 0,0:22:24.37,0:22:27.37,Rubi,,0000,0000,0000,,Құрметті.
Dialogue: 0,0:22:24.37,0:22:27.37,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:22:24.37,0:22:27.37,Default,,0000,0000,0000,,Кітапты қою керек шығар.
Dialogue: 0,0:22:27.37,0:22:30.00,Default,,0000,0000,0000,,О, түсіндім.
Dialogue: 0,0:22:30.00,0:22:32.00,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:30.00,0:22:32.00,Rubi,,0000,0000,0000,,Құрметті.
Dialogue: 0,0:22:30.00,0:22:32.00,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:22:30.00,0:22:32.00,Default,,0000,0000,0000,,Маруко, мен кітапты алып келейін.
Dialogue: 0,0:22:30.00,0:22:32.00,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:22:30.00,0:22:32.00,Default,,0000,0000,0000,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:22:32.91,0:22:35.91,Default,,0000,0000,0000,,Жақсы жұмыс Уфуфу
Dialogue: 0,0:22:32.91,0:22:35.91,Rubi,,0000,0000,0000,,Оқиға
Dialogue: 0,0:22:32.91,0:22:35.91,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:22:37.88,0:22:39.01,Rubi,,0000,0000,0000,,Құрметті.
Dialogue: 0,0:22:37.88,0:22:39.01,Rubi,,0000,0000,0000,,Құрметті.
Dialogue: 0,0:22:37.88,0:22:39.01,Default,,0000,0000,0000,,Кітап… Кітап…
Dialogue: 0,0:22:39.01,0:22:41.92,Rubi,,0000,0000,0000,,Мезура
Dialogue: 0,0:22:39.01,0:22:41.92,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:22:39.01,0:22:41.92,Default,,0000,0000,0000,,Бұл әдеттен тыс. Тазалау?
Dialogue: 0,0:22:41.92,0:22:45.52,Default,,0000,0000,0000,,Жақсы, жақсы...
Dialogue: 0,0:22:41.92,0:22:45.52,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:22:45.52,0:22:48.02,Default,,0000,0000,0000,,Қызық, не болды?
Dialogue: 0,0:22:48.02,0:22:49.52,Default,,0000,0000,0000,,Иә, ата
Dialogue: 0,0:22:48.02,0:22:49.52,Rubi,,0000,0000,0000,,Құрметті.
Dialogue: 0,0:22:48.02,0:22:49.52,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:22:48.02,0:22:49.52,Default,,0000,0000,0000,,Мен кітап әкелдім
Dialogue: 0,0:22:49.52,0:22:50.96,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:22:49.52,0:22:50.96,Default,,0000,0000,0000,,Жарайды, жарайды, сол жерде қалдырыңыз.
Dialogue: 0,0:22:50.96,0:22:53.46,Default,,0000,0000,0000,,Жақсы кадрлар
Dialogue: 0,0:22:50.96,0:22:53.46,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:22:50.96,0:22:53.46,Default,,0000,0000,0000,,Хэ-хэ~ Жарайды, жарайды.
Dialogue: 0,0:22:53.46,0:22:56.36,Rubi,,0000,0000,0000,,Така
Dialogue: 0,0:22:53.46,0:22:56.36,Default,,0000,0000,0000,,Хмм, биіктіктер енді бірдей.
Dialogue: 0,0:22:53.46,0:22:56.36,Default,,0000,0000,0000,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:22:56.36,0:22:58.97,Default,,0000,0000,0000,,Ахаха
Dialogue: 0,0:22:56.36,0:22:58.97,Rubi,,0000,0000,0000,,Кансей
Dialogue: 0,0:22:56.36,0:22:58.97,Default,,0000,0000,0000,,Төсек жақын арада аяқталады.
Dialogue: 0,0:22:58.97,0:22:59.93,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:22:58.97,0:22:59.93,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:22:59.93,0:23:02.84,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:59.93,0:23:02.84,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:59.93,0:23:02.84,Default,,0000,0000,0000,,Ана Маруко және
Dialogue: 0,0:22:59.93,0:23:02.84,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:22:59.93,0:23:02.84,Default,,0000,0000,0000,,Атам тағы бірдеңе істеп жатыр.
Dialogue: 0,0:23:02.84,0:23:04.84,Default,,0000,0000,0000,,Сіз ақымақтық істеп жатырсыз.
Dialogue: 0,0:23:02.84,0:23:04.84,Default,,0000,0000,0000,,Йойшо Йойшо
Dialogue: 0,0:23:04.84,0:23:06.84,Default,,0000,0000,0000,,Мен оны тоқтатайын ба?
Dialogue: 0,0:23:04.84,0:23:06.84,Default,,0000,0000,0000,,Иә? Сол комбинацияда
Dialogue: 0,0:23:06.84,0:23:09.48,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:23:06.84,0:23:09.48,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:23:06.84,0:23:09.48,Default,,0000,0000,0000,,Ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:23:06.84,0:23:09.48,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:23:09.48,0:23:11.41,Default,,0000,0000,0000,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:23:09.48,0:23:11.41,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:23:09.48,0:23:11.41,Default,,0000,0000,0000,,Мм. Ах, Маруко.
Dialogue: 0,0:23:11.41,0:23:14.35,Rubi,,0000,0000,0000,,Забутон
Dialogue: 0,0:23:11.41,0:23:14.35,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:23:11.41,0:23:14.35,Default,,0000,0000,0000,,Тағы екі жастық
Dialogue: 0,0:23:11.41,0:23:14.35,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:23:14.35,0:23:15.98,Rubi,,0000,0000,0000,,Забутон
Dialogue: 0,0:23:14.35,0:23:15.98,Default,,0000,0000,0000,,Забутон... Жарайды.
Dialogue: 0,0:23:15.98,0:23:16.95,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:23:15.98,0:23:16.95,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:23:16.95,0:23:18.89,Default,,0000,0000,0000,,Оишо Оишо
Dialogue: 0,0:23:16.95,0:23:18.89,Default,,0000,0000,0000,,Күрсін...
Dialogue: 0,0:23:18.89,0:23:20.39,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:23:18.89,0:23:20.39,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:23:18.89,0:23:20.39,Default,,0000,0000,0000,,Маруко, сен оны қайда апарасың?
Dialogue: 0,0:23:21.49,0:23:23.42,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:23:21.49,0:23:23.42,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:23:21.49,0:23:23.42,Default,,0000,0000,0000,,Орындалды!
Dialogue: 0,0:23:23.42,0:23:25.99,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:23:23.42,0:23:25.99,Default,,0000,0000,0000,,Вахаха
Dialogue: 0,0:23:23.42,0:23:25.99,Default,,0000,0000,0000,,А, уф.
Dialogue: 0,0:23:25.99,0:23:29.86,Rubi,,0000,0000,0000,,Негокочи
Dialogue: 0,0:23:25.99,0:23:29.86,Default,,0000,0000,0000,,А, ұйықтауға өте ыңғайлы.
Dialogue: 0,0:23:25.99,0:23:29.86,Default,,0000,0000,0000,,көремін. Жақсы. Жақсы.
Dialogue: 0,0:23:29.86,0:23:32.87,Default,,0000,0000,0000,,А, рахмет, ата.
Dialogue: 0,0:23:29.86,0:23:32.87,Default,,0000,0000,0000,,Ухухуху.
Dialogue: 0,0:23:32.87,0:23:35.50,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:23:32.87,0:23:35.50,Default,,0000,0000,0000,,Хмм, қазір Ханава-кун.
Dialogue: 0,0:23:32.87,0:23:35.50,Default,,0000,0000,0000,,Төсек сияқты
Dialogue: 0,0:23:35.50,0:23:38.00,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:23:35.50,0:23:38.00,Default,,0000,0000,0000,,Төбесі болса ғой~
Dialogue: 0,0:23:43.38,0:23:47.01,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:23:43.38,0:23:47.01,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:43.38,0:23:47.01,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:23:43.38,0:23:47.01,Default,,0000,0000,0000,,Не істеп жатырсың?!
Dialogue: 0,0:23:47.01,0:23:49.51,Default,,0000,0000,0000,,Қараңызшы, бұл экзотикалық, солай ма?
Dialogue: 0,0:23:50.88,0:23:53.52,Default,,0000,0000,0000,,А... хмм...
Dialogue: 0,0:23:53.52,0:23:56.02,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:23:53.52,0:23:56.02,Default,,0000,0000,0000,,Мені қалдыршы, тез жалығып кетесің...
