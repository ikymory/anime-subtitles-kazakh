Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:05.99,0:01:16.49,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:44.05,0:03:46.55,Default,,0000,0000,0000,,Ха ха ха... ха ха...
Dialogue: 0,0:03:47.92,0:03:49.55,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:03:47.92,0:03:49.55,Rubi,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:03:47.92,0:03:49.55,Rubi,,0000,0000,0000,,Хира
Dialogue: 0,0:03:47.92,0:03:49.55,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:03:47.92,0:03:49.55,Default,,0000,0000,0000,,()
Dialogue: 0,0:03:47.92,0:03:49.55,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:49.55,0:03:52.05,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:49.55,0:03:52.05,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:03:49.55,0:03:52.05,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:03:49.55,0:03:52.05,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:03:49.55,0:03:52.05,Default,,0000,0000,0000,,Әпкең қайтып келді.
Dialogue: 0,0:03:53.06,0:03:55.49,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:53.06,0:03:55.49,Default,,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:03:53.06,0:03:55.49,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:03:53.06,0:03:55.49,Rubi,,0000,0000,0000,,Достар
Dialogue: 0,0:03:53.06,0:03:55.49,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:03:53.06,0:03:55.49,Rubi,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:03:53.06,0:03:55.49,Default,,0000,0000,0000,,Бүгін екі дос келеді.
Dialogue: 0,0:03:55.49,0:03:56.99,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:03:56.99,0:03:58.93,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:03:56.99,0:03:58.93,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:03:56.99,0:03:58.93,Default,,0000,0000,0000,,«Үй тапсырмасын бірге орындайық»
Dialogue: 0,0:03:56.99,0:03:58.93,Rubi,,0000,0000,0000,,Якусоку
Dialogue: 0,0:03:56.99,0:03:58.93,Default,,0000,0000,0000,,Мен уәде бердім
Dialogue: 0,0:03:58.93,0:04:01.86,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:03:58.93,0:04:01.86,Default,,0000,0000,0000,,Сонымен, тағамдарды ұсынғаннан кейін
Dialogue: 0,0:03:58.93,0:04:01.86,Rubi,,0000,0000,0000,,Кедергі
Dialogue: 0,0:03:58.93,0:04:01.86,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:58.93,0:04:01.86,Default,,0000,0000,0000,,Келіп, маған кедергі жасама.
Dialogue: 0,0:04:01.86,0:04:04.50,Default,,0000,0000,0000,,Иә, иә, түсіндім.
Dialogue: 0,0:04:04.50,0:04:06.50,Rubi,,0000,0000,0000,,Теріс
Dialogue: 0,0:04:04.50,0:04:06.50,Default,,0000,0000,0000,,Өтінемін. Хехе
Dialogue: 0,0:04:08.37,0:04:12.01,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:08.37,0:04:12.01,Default,,0000,0000,0000,,...
Dialogue: 0,0:04:08.37,0:04:12.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:12.01,0:04:15.51,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:04:12.01,0:04:15.51,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:04:12.01,0:04:15.51,Rubi,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:04:12.01,0:04:15.51,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:04:12.01,0:04:15.51,Default,,0000,0000,0000,,Үйге бара жатқанда қорқасың
Dialogue: 0,0:04:15.51,0:04:17.01,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:15.51,0:04:17.01,Default,,0000,0000,0000,,Маруко қазірдің өзінде!
Dialogue: 0,0:04:17.01,0:04:20.52,Default,,0000,0000,0000,,Бұл олай емес.
Dialogue: 0,0:04:17.01,0:04:20.52,Rubi,,0000,0000,0000,,Бөлме
Dialogue: 0,0:04:17.01,0:04:20.52,Rubi,,0000,0000,0000,,Чи
Dialogue: 0,0:04:17.01,0:04:20.52,Default,,0000,0000,0000,,Бөлмені қайтадан ластаңыз!
Dialogue: 0,0:04:20.52,0:04:23.02,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:04:20.52,0:04:23.02,Default,,0000,0000,0000,,Оны тез тазалаңыз!
Dialogue: 0,0:04:23.02,0:04:26.52,Default,,0000,0000,0000,,Ах, шыдай алмаймын—аузым суы ағып тұр, ззззз
Dialogue: 0,0:04:23.02,0:04:26.52,Rubi,,0000,0000,0000,,Чи
Dialogue: 0,0:04:23.02,0:04:26.52,Rubi,,0000,0000,0000,,Бенри
Dialogue: 0,0:04:23.02,0:04:26.52,Default,,0000,0000,0000,,Ыңғайлырақ, иә?
Dialogue: 0,0:04:26.52,0:04:28.46,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:26.52,0:04:28.46,Default,,0000,0000,0000,,Маруко үшін бұл жеткілікті ме?
Dialogue: 0,0:04:28.46,0:04:30.39,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:04:30.39,0:04:34.03,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:04:30.39,0:04:34.03,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:04:30.39,0:04:34.03,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:04:30.39,0:04:34.03,Default,,0000,0000,0000,,Мен тазалағым келетін адамдарды ғана тазаласам ше?
Dialogue: 0,0:04:34.03,0:04:36.53,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:04:34.03,0:04:36.53,Rubi,,0000,0000,0000,,Достар
Dialogue: 0,0:04:34.03,0:04:36.53,Rubi,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:04:34.03,0:04:36.53,Default,,0000,0000,0000,,Бүгін бір дос келеді!
Dialogue: 0,0:04:36.53,0:04:39.43,Rubi,,0000,0000,0000,,Бөлме
Dialogue: 0,0:04:36.53,0:04:39.43,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:04:36.53,0:04:39.43,Default,,0000,0000,0000,,Мен бұл бөлмені пайдаланғалы жатырмын.
Dialogue: 0,0:04:36.53,0:04:39.43,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:04:36.53,0:04:39.43,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:04:36.53,0:04:39.43,Default,,0000,0000,0000,,Тазалаңыз! тез!
Dialogue: 0,0:04:39.43,0:04:41.93,Default,,0000,0000,0000,,Бууууууууууу
Dialogue: 0,0:04:39.43,0:04:41.93,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:04:48.54,0:04:49.54,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:04:51.45,0:04:54.05,Default,,0000,0000,0000,,Осылай болғанша
Dialogue: 0,0:04:51.45,0:04:54.05,Default,,0000,0000,0000,,Мені жалғыз қалдырыңыз~
Dialogue: 0,0:04:54.05,0:04:56.95,Default,,0000,0000,0000,,Әй, бұл өте қиын.
Dialogue: 0,0:04:56.95,0:04:59.86,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:04:56.95,0:04:59.86,Rubi,,0000,0000,0000,,Чи
Dialogue: 0,0:04:56.95,0:04:59.86,Default,,0000,0000,0000,,Менің ойымша, сіз тәртіпсіздік жасадыңыз.
Dialogue: 0,0:04:59.86,0:05:01.86,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:04:59.86,0:05:01.86,Default,,0000,0000,0000,,Мен бұны лақтырып жіберемін.
Dialogue: 0,0:04:59.86,0:05:01.86,Default,,0000,0000,0000,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:05:01.86,0:05:04.99,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:01.86,0:05:04.99,Default,,0000,0000,0000,,Бұл Марукодікі
Dialogue: 0,0:05:01.86,0:05:04.99,Default,,0000,0000,0000,,Аяқталмаған басқатырғыш!
Dialogue: 0,0:05:04.99,0:05:08.86,Rubi,,0000,0000,0000,,Даидзи
Dialogue: 0,0:05:04.99,0:05:08.86,Default,,0000,0000,0000,,Маңызды болса, оны жай қалдырыңыз
Dialogue: 0,0:05:04.99,0:05:08.86,Default,,0000,0000,0000,,Оны тастамаңыз
Dialogue: 0,0:05:08.86,0:05:12.87,Default,,0000,0000,0000,,Хмм, бұл жақсырақ
Dialogue: 0,0:05:08.86,0:05:12.87,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:05:08.86,0:05:12.87,Default,,0000,0000,0000,,Сіз бірден ойнай аласыз.
Dialogue: 0,0:05:12.87,0:05:16.00,Default,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:05:12.87,0:05:16.00,Default,,0000,0000,0000,,Өйткені ол сүйкімді емес
Dialogue: 0,0:05:16.00,0:05:18.00,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:05:16.00,0:05:18.00,Default,,0000,0000,0000,,Сен оны тазала!
Dialogue: 0,0:05:18.91,0:05:22.51,Default,,0000,0000,0000,,Қазірдің өзінде! Сонша... сонша!
Dialogue: 0,0:05:22.51,0:05:23.51,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:25.01,0:05:26.95,Default,,0000,0000,0000,,Қазірдің өзінде...
Dialogue: 0,0:05:26.95,0:05:29.89,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:26.95,0:05:29.89,Default,,0000,0000,0000,,Ах! Не істеп жатырсың, ақымақ?
Dialogue: 0,0:05:29.89,0:05:31.89,Rubi,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:05:29.89,0:05:31.89,Rubi,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:05:29.89,0:05:31.89,Default,,0000,0000,0000,,Мұрын шұқылау Мұрын боқ
Dialogue: 0,0:05:31.89,0:05:34.52,Default,,0000,0000,0000,,Хмм, қазірдің өзінде!
Dialogue: 0,0:05:34.52,0:05:36.46,Default,,0000,0000,0000,,Ах... хмм...
Dialogue: 0,0:05:36.46,0:05:39.03,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:36.46,0:05:39.03,Default,,0000,0000,0000,,Анашым, анашым!
Dialogue: 0,0:05:36.46,0:05:39.03,Default,,0000,0000,0000,,Агагага...
Dialogue: 0,0:05:39.03,0:05:41.53,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:39.03,0:05:41.53,Default,,0000,0000,0000,,Сәлем анашым
Dialogue: 0,0:05:39.03,0:05:41.53,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:39.03,0:05:41.53,Default,,0000,0000,0000,,Маруко туралы бірдеңе жасаңыз!
Dialogue: 0,0:05:41.53,0:05:43.03,Default,,0000,0000,0000,,Агагага...
Dialogue: 0,0:05:43.03,0:05:46.90,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:43.03,0:05:46.90,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:43.03,0:05:46.90,Rubi,,0000,0000,0000,,Бея
Dialogue: 0,0:05:43.03,0:05:46.90,Default,,0000,0000,0000,,Маруко! Сен балалар бөлмесісің
Dialogue: 0,0:05:43.03,0:05:46.90,Rubi,,0000,0000,0000,,Чи
Dialogue: 0,0:05:43.03,0:05:46.90,Default,,0000,0000,0000,,Сіз тәртіпсіздік жасадыңыз, солай ма?
Dialogue: 0,0:05:46.90,0:05:48.54,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:05:46.90,0:05:48.54,Default,,0000,0000,0000,,Тазалаңыз!
Dialogue: 0,0:05:48.54,0:05:51.44,Default,,0000,0000,0000,,Гагага... Гугекё...
Dialogue: 0,0:05:48.54,0:05:51.44,Default,,0000,0000,0000,,Курушиджо…
Dialogue: 0,0:05:51.44,0:05:54.41,Rubi,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:05:51.44,0:05:54.41,Default,,0000,0000,0000,,Хмф, сен жалғызсың.
Dialogue: 0,0:05:51.44,0:05:54.41,Rubi,,0000,0000,0000,,Бөлме
Dialogue: 0,0:05:51.44,0:05:54.41,Default,,0000,0000,0000,,Бұл бөлме емес.
Dialogue: 0,0:05:54.41,0:05:56.34,Rubi,,0000,0000,0000,,Бір рет
Dialogue: 0,0:05:54.41,0:05:56.34,Rubi,,0000,0000,0000,,Чи
Dialogue: 0,0:05:54.41,0:05:56.34,Default,,0000,0000,0000,,Рұқсатсыз тәртіпсіздік жасама.
Dialogue: 0,0:05:56.34,0:05:58.98,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:05:56.34,0:05:58.98,Default,,0000,0000,0000,,Хмм. Сондай бастық.
Dialogue: 0,0:05:58.98,0:06:01.48,Default,,0000,0000,0000,,Эбаринбо истериясы
Dialogue: 0,0:06:01.48,0:06:03.99,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:01.48,0:06:03.99,Rubi,,0000,0000,0000,,Мару
Dialogue: 0,0:06:01.48,0:06:03.99,Default,,0000,0000,0000,,Бұл не, Бакамару? Мені ұр!
Dialogue: 0,0:06:03.99,0:06:07.86,Default,,0000,0000,0000,,О, қорқынышты
Dialogue: 0,0:06:03.99,0:06:07.86,Rubi,,0000,0000,0000,,Шорай
Dialogue: 0,0:06:03.99,0:06:07.86,Default,,0000,0000,0000,,Сенің болашағың – сукебан.
Dialogue: 0,0:06:07.86,0:06:10.86,Default,,0000,0000,0000,,Хмф! Қазірдің өзінде~
Dialogue: 0,0:06:07.86,0:06:10.86,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:06:07.86,0:06:10.86,Default,,0000,0000,0000,,Шығуыңызды өтінемін!
Dialogue: 0,0:06:10.86,0:06:13.50,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:06:10.86,0:06:13.50,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:06:10.86,0:06:13.50,Rubi,,0000,0000,0000,,Бөлме
Dialogue: 0,0:06:10.86,0:06:13.50,Default,,0000,0000,0000,,Бүгін осы бөлмеде
Dialogue: 0,0:06:10.86,0:06:13.50,Rubi,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:06:10.86,0:06:13.50,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:06:10.86,0:06:13.50,Default,,0000,0000,0000,,Кірме!
Dialogue: 0,0:06:13.50,0:06:17.00,Default,,0000,0000,0000,,...
Dialogue: 0,0:06:13.50,0:06:17.00,Default,,0000,0000,0000,,Паппапара»
Dialogue: 0,0:06:21.37,0:06:26.01,Rubi,,0000,0000,0000,,Юджин
Dialogue: 0,0:06:21.37,0:06:26.01,Rubi,,0000,0000,0000,,Даншо
Dialogue: 0,0:06:21.37,0:06:26.01,Rubi,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:06:21.37,0:06:26.01,Default,,0000,0000,0000,,(Сакико мен достары сөйлеседі)
Dialogue: 0,0:06:26.01,0:06:28.51,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:06:26.01,0:06:28.51,Rubi,,0000,0000,0000,,Накайо
Dialogue: 0,0:06:26.01,0:06:28.51,Default,,0000,0000,0000,,Бәріңе сәлем, біз бәріміз жақсы доспыз...
Dialogue: 0,0:06:29.88,0:06:31.88,Rubi,,0000,0000,0000,,Юджин
Dialogue: 0,0:06:29.88,0:06:31.88,Default,,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:06:29.88,0:06:31.88,Default,,0000,0000,0000,,Өтінемін...
Dialogue: 0,0:06:31.88,0:06:34.52,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:06:31.88,0:06:34.52,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:06:31.88,0:06:34.52,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
