Dialogue: 0,0:18:33.44,0:18:36.34,Default,,0000,0000,0000,,Өйткені, бұл менмін.
Dialogue: 0,0:18:33.44,0:18:36.34,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:18:33.44,0:18:36.34,Default,,0000,0000,0000,,Мен рөлді ойнаймын.
Dialogue: 0,0:18:36.34,0:18:40.34,Default,,0000,0000,0000,,түзу
Dialogue: 0,0:18:41.98,0:18:43.91,Default,,0000,0000,0000,,(Ллойд) Бүгінгі серуен — немесе дұрысы, «Үккі» операциясы
Dialogue: 0,0:18:43.91,0:18:48.48,Default,,0000,0000,0000,,Жоқ, I
Dialogue: 0,0:18:43.91,0:18:48.48,Default,,0000,0000,0000,,Екеуі де жақсы болды.
Dialogue: 0,0:18:48.48,0:18:49.99,Default,,0000,0000,0000,,Зуба… Қайта…
Dialogue: 0,0:18:49.99,0:18:53.86,Default,,0000,0000,0000,,《Мен де солай жасағым келеді
Dialogue: 0,0:18:49.99,0:18:53.86,Default,,0000,0000,0000,,Мен мұны істемеймін.》
Dialogue: 0,0:18:53.86,0:18:57.43,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:18:53.86,0:18:57.43,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:18:53.86,0:18:57.43,Default,,0000,0000,0000,,Ол әлі де рөл ойнап жатыр.
Dialogue: 0,0:18:53.86,0:18:57.43,Default,,0000,0000,0000,,Сіз мұны істегіңіз келді ме?
Dialogue: 0,0:18:57.43,0:18:59.93,Default,,0000,0000,0000,,Иә?Не айтқың келеді?
Dialogue: 0,0:18:59.93,0:19:04.43,Rubi,,0000,0000,0000,,Кеше
Dialogue: 0,0:18:59.93,0:19:04.43,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:18:59.93,0:19:04.43,Default,,0000,0000,0000,,Кеше болды, білмеймін.
Dialogue: 0,0:18:59.93,0:19:04.43,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:18:59.93,0:19:04.43,Rubi,,0000,0000,0000,,Мауах
Dialogue: 0,0:18:59.93,0:19:04.43,Default,,0000,0000,0000,,Олар менің айналамды кезіп жүрді...
Dialogue: 0,0:19:04.43,0:19:07.34,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:19:04.43,0:19:07.34,Default,,0000,0000,0000,,«Мені алмастыра алатыныңызға сенімдімін».
Dialogue: 0,0:19:04.43,0:19:07.34,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:19:04.43,0:19:07.34,Default,,0000,0000,0000,,Менің айтқым келгені осы еді.
Dialogue: 0,0:19:07.34,0:19:10.31,Rubi,,0000,0000,0000,,Секигучи-кун
Dialogue: 0,0:19:07.34,0:19:10.31,Default,,0000,0000,0000,,Эй, мен де Секигучи-кунға бардым.
Dialogue: 0,0:19:10.31,0:19:14.44,Rubi,,0000,0000,0000,,Секигучи-кун
Dialogue: 0,0:19:10.31,0:19:14.44,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:19:10.31,0:19:14.44,Default,,0000,0000,0000,,《Түсіндім, бұл шынымен Секигучи-кунның рөлі.
Dialogue: 0,0:19:10.31,0:19:14.44,Default,,0000,0000,0000,,Мен мұны істегім келді.
Dialogue: 0,0:19:14.44,0:19:17.35,Default,,0000,0000,0000,,Маған келуден басқа амалың жоқ...》
Dialogue: 0,0:19:17.35,0:19:21.35,Rubi,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:19:17.35,0:19:21.35,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:19:17.35,0:19:21.35,Default,,0000,0000,0000,,《Әлем
Dialogue: 0,0:19:17.35,0:19:21.35,Default,,0000,0000,0000,,Бұл жұмыс істемейді.
Dialogue: 0,0:19:24.95,0:19:27.46,Rubi,,0000,0000,0000,,Ән
Dialogue: 0,0:19:24.95,0:19:27.46,Rubi,,0000,0000,0000,,Одо
Dialogue: 0,0:19:24.95,0:19:27.46,Default,,0000,0000,0000,,Жарайды, мен ән айтып, биледім.
Dialogue: 0,0:19:27.46,0:19:30.36,Rubi,,0000,0000,0000,,Они
Dialogue: 0,0:19:27.46,0:19:30.36,Default,,0000,0000,0000,,Барлық жындар
Dialogue: 0,0:19:27.46,0:19:30.36,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:19:27.46,0:19:30.36,Default,,0000,0000,0000,,Сіз оны аласыз ба?
Dialogue: 0,0:19:30.36,0:19:32.33,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:19:30.36,0:19:32.33,Rubi,,0000,0000,0000,,Одо
Dialogue: 0,0:19:30.36,0:19:32.33,Default,,0000,0000,0000,,Бірақ мен жақсы билеуім керек
Dialogue: 0,0:19:32.33,0:19:34.33,Rubi,,0000,0000,0000,,Маруя
Dialogue: 0,0:19:32.33,0:19:34.33,Rubi,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:19:32.33,0:19:34.33,Default,,0000,0000,0000,,Мен қуырып жеймін!
Dialogue: 0,0:19:34.33,0:19:35.33,Rubi,,0000,0000,0000,,Секигучи
Dialogue: 0,0:19:34.33,0:19:35.33,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:35.33,0:19:38.97,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:35.33,0:19:38.97,Default,,0000,0000,0000,,Помпокорин билеу»
Dialogue: 0,0:19:38.97,0:19:40.90,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:40.90,0:19:43.84,Default,,0000,0000,0000,,«Мен... сенімдімін
Dialogue: 0,0:19:40.90,0:19:43.84,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:19:40.90,0:19:43.84,Default,,0000,0000,0000,,Сіз менің соққыларымды кетіре аласыз.
Dialogue: 0,0:19:43.84,0:19:45.84,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:19:43.84,0:19:45.84,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:19:43.84,0:19:45.84,Default,,0000,0000,0000,,Ал, кеттік, мама».
Dialogue: 0,0:19:45.84,0:19:48.98,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:19:45.84,0:19:48.98,Default,,0000,0000,0000,,А, бұл дұрыс емес...
Dialogue: 0,0:19:45.84,0:19:48.98,Default,,0000,0000,0000,,«Әже»
Dialogue: 0,0:19:48.98,0:19:51.48,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:19:51.48,0:19:53.98,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:19:51.48,0:19:53.98,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:19:51.48,0:19:53.98,Default,,0000,0000,0000,,() ～
Dialogue: 0,0:19:53.98,0:19:57.42,Default,,0000,0000,0000,,Сакура-сан
Dialogue: 0,0:19:53.98,0:19:57.42,Rubi,,0000,0000,0000,,Жалғыз бала
Dialogue: 0,0:19:53.98,0:19:57.42,Rubi,,0000,0000,0000,,Тренинг
Dialogue: 0,0:19:53.98,0:19:57.42,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,0:19:53.98,0:19:57.42,Default,,0000,0000,0000,,Бір ғана адам қалғанда жаттығу қиын.
Dialogue: 0,0:19:57.42,0:19:59.36,Rubi,,0000,0000,0000,,Ганба
Dialogue: 0,0:19:57.42,0:19:59.36,Default,,0000,0000,0000,,Мен Учидамын.
Dialogue: 0,0:19:59.36,0:20:02.93,Rubi,,0000,0000,0000,,Қақпақ
Dialogue: 0,0:19:59.36,0:20:02.93,Default,,0000,0000,0000,,Әй, екі өркеш.
Dialogue: 0,0:19:59.36,0:20:02.93,Default,,0000,0000,0000,,Бұл айналды!
Dialogue: 0,0:20:02.93,0:20:04.43,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:20:02.93,0:20:04.43,Default,,0000,0000,0000,,О...
Dialogue: 0,0:20:04.43,0:20:08.30,Rubi,,0000,0000,0000,,Қақпақ
Dialogue: 0,0:20:04.43,0:20:08.30,Default,,0000,0000,0000,,Аа, екі соққы бар...
Dialogue: 0,0:20:04.43,0:20:08.30,Rubi,,0000,0000,0000,,Қақпақ
Dialogue: 0,0:20:04.43,0:20:08.30,Default,,0000,0000,0000,,Екі болып кеткен сияқты.
Dialogue: 0,0:20:08.30,0:20:13.44,Rubi,,0000,0000,0000,,Қақпақ
Dialogue: 0,0:20:08.30,0:20:13.44,Default,,0000,0000,0000,,２
Dialogue: 0,0:20:08.30,0:20:13.44,Default,,0000,0000,0000,,Бұл болды... Айналып кеткен сияқты».
Dialogue: 0,0:20:13.44,0:20:15.37,Default,,0000,0000,0000,,«О, соқпақ... соққы...»
Dialogue: 0,0:20:15.37,0:20:17.31,Rubi,,0000,0000,0000,,Тренинг
Dialogue: 0,0:20:15.37,0:20:17.31,Default,,0000,0000,0000,,<Қалаусыз тәжірибе
Dialogue: 0,0:20:17.31,0:20:21.31,Rubi,,0000,0000,0000,,Гакугейкай
Dialogue: 0,0:20:17.31,0:20:21.31,Rubi,,0000,0000,0000,,Миккамае
Dialogue: 0,0:20:17.31,0:20:21.31,Default,,0000,0000,0000,,Соңында, мектептегі қойылымға 3 күн қалғанда＞
Dialogue: 0,0:20:21.31,0:20:25.45,Rubi,,0000,0000,0000,,Они
Dialogue: 0,0:20:21.31,0:20:25.45,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:20:21.31,0:20:25.45,Default,,0000,0000,0000,,Жын соқтығысты ала ма?
Dialogue: 0,0:20:21.31,0:20:25.45,Default,,0000,0000,0000,,Сен сондай ақымақсың...
Dialogue: 0,0:20:25.45,0:20:28.35,Rubi,,0000,0000,0000,,Ән
Dialogue: 0,0:20:25.45,0:20:28.35,Rubi,,0000,0000,0000,,Одо
Dialogue: 0,0:20:25.45,0:20:28.35,Default,,0000,0000,0000,,Ән айт және би...
Dialogue: 0,0:20:25.45,0:20:28.35,Rubi,,0000,0000,0000,,Ән
Dialogue: 0,0:20:25.45,0:20:28.35,Rubi,,0000,0000,0000,,Одо
Dialogue: 0,0:20:25.45,0:20:28.35,Default,,0000,0000,0000,,Ән айт және би...
Dialogue: 0,0:20:28.35,0:20:30.95,Default,,0000,0000,0000,,Ем, м...
Dialogue: 0,0:20:30.95,0:20:32.89,Default,,0000,0000,0000,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:20:32.89,0:20:36.46,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:20:32.89,0:20:36.46,Default,,0000,0000,0000,,Ендеше, бірге көңіл көтерейік
Dialogue: 0,0:20:32.89,0:20:36.46,Rubi,,0000,0000,0000,,Сава
Dialogue: 0,0:20:32.89,0:20:36.46,Default,,0000,0000,0000,,Сіз жай ғана шу шығарып жатырсыз ба?
Dialogue: 0,0:20:36.46,0:20:39.36,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:20:36.46,0:20:39.36,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:20:36.46,0:20:39.36,Default,,0000,0000,0000,,Жоқ, бұл қызық.
Dialogue: 0,0:20:39.36,0:20:40.96,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,0:20:40.96,0:20:43.87,Default,,0000,0000,0000,,Одан бөлек, Дарүдің бәрі — футболкасынан іш киіміне дейін —
Dialogue: 0,0:20:43.87,0:20:47.47,Default,,0000,0000,0000,,Неліктен мен мұны істеуім керек?
Dialogue: 0,0:20:43.87,0:20:47.47,Default,,0000,0000,0000,,Ондай нәрсе жоқ...
Dialogue: 0,0:20:47.47,0:20:51.34,Rubi,,0000,0000,0000,,Токай Дайжишин
Dialogue: 0,0:20:47.47,0:20:51.34,Default,,0000,0000,0000,,Ах, тіпті Токай жер сілкінісі
Dialogue: 0,0:20:47.47,0:20:51.34,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:20:47.47,0:20:51.34,Default,,0000,0000,0000,,Болмайды ма деп ойлаймын
Dialogue: 0,0:20:51.34,0:20:53.98,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:20:51.34,0:20:53.98,Default,,0000,0000,0000,,...
Dialogue: 0,0:20:51.34,0:20:53.98,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:20:53.98,0:20:56.88,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:20:53.98,0:20:56.88,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:20:53.98,0:20:56.88,Default,,0000,0000,0000,,Сіз бұрын болдыңыз ба?
Dialogue: 0,0:20:56.88,0:21:00.42,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:20:56.88,0:21:00.42,Rubi,,0000,0000,0000,,Токай Дайжишин
Dialogue: 0,0:20:56.88,0:21:00.42,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:20:56.88,0:21:00.42,Default,,0000,0000,0000,,«Токай жер сілкінісі» болғанға дейін?
Dialogue: 0,0:21:00.42,0:21:03.92,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:21:00.42,0:21:03.92,Default,,0000,0000,0000,,Иә, ұзақ уақыт бойы.
Dialogue: 0,0:21:03.92,0:21:04.89,Default,,0000,0000,0000,,Хаа…
Dialogue: 0,0:21:04.89,0:21:09.43,Rubi,,0000,0000,0000,,Мурабито
Dialogue: 0,0:21:04.89,0:21:09.43,Default,,0000,0000,0000,,Ауыл тұрғындарына 2-бөлім
Dialogue: 0,0:21:04.89,0:21:09.43,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:21:04.89,0:21:09.43,Default,,0000,0000,0000,,Бұл біраз оғаш жол болды.
Dialogue: 0,0:21:09.43,0:21:12.93,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:21:09.43,0:21:12.93,Default,,0000,0000,0000,,Сонымен, бұл...
Dialogue: 0,0:21:12.93,0:21:14.43,Rubi,,0000,0000,0000,,Хакуджо
Dialogue: 0,0:21:12.93,0:21:14.43,Default,,0000,0000,0000,,Мойындау
Dialogue: 0,0:21:14.43,0:21:16.37,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:21:14.43,0:21:16.37,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:21:14.43,0:21:16.37,Default,,0000,0000,0000,,Қарттың рөлі емес пе?
Dialogue: 0,0:21:16.37,0:21:19.87,Rubi,,0000,0000,0000,,Гакугейкай
Dialogue: 0,0:21:16.37,0:21:19.87,Default,,0000,0000,0000,,Егер ол мектеп қойылымына айналса
Dialogue: 0,0:21:16.37,0:21:19.87,Default,,0000,0000,0000,,Олар бәрібір біледі
Dialogue: 0,0:21:20.94,0:21:23.84,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:20.94,0:21:23.84,Rubi,,0000,0000,0000,,Гакугейкай
Dialogue: 0,0:21:20.94,0:21:23.84,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:21:20.94,0:21:23.84,Default,,0000,0000,0000,,Маруконың мектептегі өнер күні
Dialogue: 0,0:21:20.94,0:21:23.84,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:21:20.94,0:21:23.84,Rubi,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:21:20.94,0:21:23.84,Default,,0000,0000,0000,,Ішім ауырып, үзіліс жасаймын.
Dialogue: 0,0:21:23.84,0:21:25.44,Rubi,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:21:23.84,0:21:25.44,Default,,0000,0000,0000,,Мен міндетті түрде аламын.
Dialogue: 0,0:21:25.44,0:21:27.94,Default,,0000,0000,0000,,Идиот!
Dialogue: 0,0:21:25.44,0:21:27.94,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:21:25.44,0:21:27.94,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:21:25.44,0:21:27.94,Default,,0000,0000,0000,,Сіз нені жек көресіз?
Dialogue: 0,0:21:27.94,0:21:30.45,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:21:27.94,0:21:30.45,Default,,0000,0000,0000,,Ол қарттың рөлін ойнайды.
Dialogue: 0,0:21:27.94,0:21:30.45,Default,,0000,0000,0000,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:21:30.45,0:21:32.38,Default,,0000,0000,0000,,Керемет ештеңе жоқ!
Dialogue: 0,0:21:32.38,0:21:35.38,Default,,0000,0000,0000,,Аан мен мұны істегім келмейді!
Dialogue: 0,0:21:36.95,0:21:39.86,Default,,0000,0000,0000,,Бірақ неге?
Dialogue: 0,0:21:36.95,0:21:39.86,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:21:36.95,0:21:39.86,Default,,0000,0000,0000,,Сіз оны шынымен сонша жек көресіз бе?
Dialogue: 0,0:21:39.86,0:21:42.83,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:21:39.86,0:21:42.83,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:21:39.86,0:21:42.83,Default,,0000,0000,0000,,Мен қарттың рөлін ойнамаймын деп ойлаймын.
Dialogue: 0,0:21:39.86,0:21:42.83,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:21:39.86,0:21:42.83,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:21:39.86,0:21:42.83,Default,,0000,0000,0000,,Мен бұл жақсы емес деп айттым ба?
Dialogue: 0,0:21:42.83,0:21:46.96,Default,,0000,0000,0000,,Бұл да дұрыс.
Dialogue: 0,0:21:42.83,0:21:46.96,Default,,0000,0000,0000,,Мен осылай төмпешікті саламын.
Dialogue: 0,0:21:46.96,0:21:48.46,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:21:46.96,0:21:48.46,Default,,0000,0000,0000,,Ол не нәрсеге ұқсайды?
Dialogue: 0,0:21:48.46,0:21:50.97,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
