Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:42.47,0:00:52.97,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:48.49,0:02:50.43,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:02:48.49,0:02:50.43,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:02:48.49,0:02:50.43,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:02:48.49,0:02:50.43,Default,,0000,0000,0000,,Ал, бүгінгі сынып жиналысы
Dialogue: 0,0:02:50.43,0:02:54.00,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:02:50.43,0:02:54.00,Rubi,,0000,0000,0000,,Гакугейкай
Dialogue: 0,0:02:50.43,0:02:54.00,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:02:50.43,0:02:54.00,Default,,0000,0000,0000,,Алдағы мектеп қойылымы туралы
Dialogue: 0,0:02:50.43,0:02:54.00,Rubi,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:02:50.43,0:02:54.00,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:02:50.43,0:02:54.00,Default,,0000,0000,0000,,Талқылаңыз
Dialogue: 0,0:02:54.00,0:02:57.87,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:02:54.00,0:02:57.87,Rubi,,0000,0000,0000,,Маруо-кун
Dialogue: 0,0:02:54.00,0:02:57.87,Default,,0000,0000,0000,,Енді, сынып өкілі Маруо-кун.
Dialogue: 0,0:02:54.00,0:02:57.87,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:02:54.00,0:02:57.87,Default,,0000,0000,0000,,Мигива мырза, бастаңыз.
Dialogue: 0,0:02:57.87,0:02:59.87,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:02:57.87,0:02:59.87,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:02:59.87,0:03:02.81,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:02:59.87,0:03:02.81,Default,,0000,0000,0000,,(Маруко)
Dialogue: 0,0:02:59.87,0:03:02.81,Rubi,,0000,0000,0000,,Гакугейкай
Dialogue: 0,0:02:59.87,0:03:02.81,Default,,0000,0000,0000,,《Мектеп ойыны өте керемет》
Dialogue: 0,0:03:02.81,0:03:07.44,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:03:02.81,0:03:07.44,Default,,0000,0000,0000,,Ал, менің сыныбымда
Dialogue: 0,0:03:02.81,0:03:07.44,Rubi,,0000,0000,0000,,жүгірді
Dialogue: 0,0:03:02.81,0:03:07.44,Default,,0000,0000,0000,,Көріп отырғаныңыздай, бұл өте орынды!
Dialogue: 0,0:03:07.44,0:03:10.95,Rubi,,0000,0000,0000,,Геки
Dialogue: 0,0:03:07.44,0:03:10.95,Default,,0000,0000,0000,,«Кішкентай қарт құс» пьесасы
Dialogue: 0,0:03:07.44,0:03:10.95,Default,,0000,0000,0000,,Мен мұны істеуге шешім қабылдадым.
Dialogue: 0,0:03:10.95,0:03:13.85,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:03:10.95,0:03:13.85,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:03:10.95,0:03:13.85,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:03:10.95,0:03:13.85,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:03:10.95,0:03:13.85,Default,,0000,0000,0000,,Бұдан былай
Dialogue: 0,0:03:13.85,0:03:16.82,Default,,0000,0000,0000,,Тікелей!
Dialogue: 0,0:03:13.85,0:03:16.82,Rubi,,0000,0000,0000,,Иә, тез
Dialogue: 0,0:03:13.85,0:03:16.82,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:13.85,0:03:16.82,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:03:13.85,0:03:16.82,Default,,0000,0000,0000,,Мен актерлік құрамды шешкім келеді.
Dialogue: 0,0:03:16.82,0:03:19.46,Rubi,,0000,0000,0000,,Секигучи
Dialogue: 0,0:03:16.82,0:03:19.46,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:03:16.82,0:03:19.46,Default,,0000,0000,0000,,Бұл ''Кобуторижисан''!
Dialogue: 0,0:03:19.46,0:03:21.39,Rubi,,0000,0000,0000,,Данши
Dialogue: 0,0:03:19.46,0:03:21.39,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:03:19.46,0:03:21.39,Default,,0000,0000,0000,,Басқа ештеңе жоқ па?
Dialogue: 0,0:03:21.39,0:03:24.33,Default,,0000,0000,0000,,``Золушка'' және т.б.
Dialogue: 0,0:03:21.39,0:03:24.33,Rubi,,0000,0000,0000,,Шираюкихиме
Dialogue: 0,0:03:21.39,0:03:24.33,Default,,0000,0000,0000,,«Ақшақар» болғанын қалаймын
Dialogue: 0,0:03:24.33,0:03:25.33,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:24.33,0:03:25.33,Default,,0000,0000,0000,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:03:25.33,0:03:28.47,Rubi,,0000,0000,0000,,Фуку
Dialogue: 0,0:03:25.33,0:03:28.47,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:25.33,0:03:28.47,Default,,0000,0000,0000,,Мен таза киім кие аламын.
Dialogue: 0,0:03:25.33,0:03:28.47,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:03:28.47,0:03:30.97,Rubi,,0000,0000,0000,,Сейшуку
Dialogue: 0,0:03:28.47,0:03:30.97,Default,,0000,0000,0000,,Өтінемін, тыныш болыңыз!
Dialogue: 0,0:03:30.97,0:03:33.47,Rubi,,0000,0000,0000,,Шизу
Dialogue: 0,0:03:30.97,0:03:33.47,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,0:03:30.97,0:03:33.47,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:03:30.97,0:03:33.47,Rubi,,0000,0000,0000,,Сейшуку
Dialogue: 0,0:03:30.97,0:03:33.47,Default,,0000,0000,0000,,Барлығыңыз тыныш болыңыздар.
Dialogue: 0,0:03:33.47,0:03:35.41,Rubi,,0000,0000,0000,,Шизу
Dialogue: 0,0:03:33.47,0:03:35.41,Default,,0000,0000,0000,,Барлығыңыз тыныш болыңыздар!
Dialogue: 0,0:03:35.41,0:03:37.34,Default,,0000,0000,0000,,«Обутори-сан»
Dialogue: 0,0:03:35.41,0:03:37.34,Default,,0000,0000,0000,,Не істеу керектігі туралы
Dialogue: 0,0:03:37.34,0:03:39.98,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:03:37.34,0:03:39.98,Default,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:03:37.34,0:03:39.98,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:03:37.34,0:03:39.98,Default,,0000,0000,0000,,Басқа сынып мұғалімдерімен
Dialogue: 0,0:03:39.98,0:03:42.98,Rubi,,0000,0000,0000,,Судан
Dialogue: 0,0:03:39.98,0:03:42.98,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:39.98,0:03:42.98,Rubi,,0000,0000,0000,,Кекка
Dialogue: 0,0:03:39.98,0:03:42.98,Default,,0000,0000,0000,,Бұл кеңестер мен шешімдердің нәтижесі.
Dialogue: 0,0:03:44.85,0:03:47.85,Default,,0000,0000,0000,,Бұл дәл солай.
Dialogue: 0,0:03:47.85,0:03:52.49,Default,,0000,0000,0000,,Сонда сен кімсің?
Dialogue: 0,0:03:47.85,0:03:52.49,Rubi,,0000,0000,0000,,Риккахо
Dialogue: 0,0:03:47.85,0:03:52.49,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:03:47.85,0:03:52.49,Default,,0000,0000,0000,,Үміткерлер бар ма?
Dialogue: 0,0:03:52.49,0:03:53.46,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:52.49,0:03:53.46,Default,,0000,0000,0000,,＜Осылай деді
Dialogue: 0,0:03:53.46,0:03:57.36,Rubi,,0000,0000,0000,,Риккахо
Dialogue: 0,0:03:53.46,0:03:57.36,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:03:53.46,0:03:57.36,Default,,0000,0000,0000,,Кандидат
Dialogue: 0,0:03:53.46,0:03:57.36,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:03:53.46,0:03:57.36,Default,,0000,0000,0000,,Мен оны неге көрмедім?＞
Dialogue: 0,0:03:57.36,0:03:59.00,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:03:59.00,0:04:01.90,Default,,0000,0000,0000,,Олай болса
Dialogue: 0,0:03:59.00,0:04:01.90,Rubi,,0000,0000,0000,,Нарғызгүл
Dialogue: 0,0:03:59.00,0:04:01.90,Rubi,,0000,0000,0000,,Аздап
Dialogue: 0,0:03:59.00,0:04:01.90,Default,,0000,0000,0000,,Ұсыныс жақсы болар еді.
Dialogue: 0,0:04:01.90,0:04:03.83,Default,,0000,0000,0000,,Мұнда біреу бар ма?
Dialogue: 0,0:04:01.90,0:04:03.83,Default,,0000,0000,0000,,Кез келген...
Dialogue: 0,0:04:03.83,0:04:05.80,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:04:03.83,0:04:05.80,Default,,0000,0000,0000,,Маруо
Dialogue: 0,0:04:03.83,0:04:05.80,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:04:03.83,0:04:05.80,Default,,0000,0000,0000,,Мұны істеу керек!
Dialogue: 0,0:04:05.80,0:04:08.81,Default,,0000,0000,0000,,Иә! Мен бе?
Dialogue: 0,0:04:08.81,0:04:12.44,Rubi,,0000,0000,0000,,Жоғарғы
Dialogue: 0,0:04:08.81,0:04:12.44,Default,,0000,0000,0000,,Ал, мен қиналып қалдым.
Dialogue: 0,0:04:08.81,0:04:12.44,Rubi,,0000,0000,0000,,Шуяку
Dialogue: 0,0:04:08.81,0:04:12.44,Default,,0000,0000,0000,,Мен басты кейіпкер екеніме сене алар емеспін...
Dialogue: 0,0:04:12.44,0:04:14.94,Rubi,,0000,0000,0000,,Қазір
Dialogue: 0,0:04:12.44,0:04:14.94,Rubi,,0000,0000,0000,,Шуяку
Dialogue: 0,0:04:12.44,0:04:14.94,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:12.44,0:04:14.94,Default,,0000,0000,0000,,<Оны басты кейіпкер деп ешкім айтқан жоқ>
Dialogue: 0,0:04:14.94,0:04:17.45,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:04:14.94,0:04:17.45,Default,,0000,0000,0000,,Бірақ оны жасайтын ешкім болмаса
Dialogue: 0,0:04:17.45,0:04:20.35,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:04:17.45,0:04:20.35,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:04:17.45,0:04:20.35,Default,,0000,0000,0000,,Біз, сыныптық комиссия мүшелері, мұны істеуден басқа амалымыз жоқ.
Dialogue: 0,0:04:17.45,0:04:20.35,Default,,0000,0000,0000,,Жоқ деп ойлаймын.
Dialogue: 0,0:04:20.35,0:04:22.32,Rubi,,0000,0000,0000,,Қазір
Dialogue: 0,0:04:20.35,0:04:22.32,Default,,0000,0000,0000,,<«Сен де» дегенде нені білдіреді?
Dialogue: 0,0:04:20.35,0:04:22.32,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:20.35,0:04:22.32,Default,,0000,0000,0000,,Мен айтқан жоқпын>
Dialogue: 0,0:04:22.32,0:04:25.96,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:22.32,0:04:25.96,Default,,0000,0000,0000,,Не болса да
Dialogue: 0,0:04:22.32,0:04:25.96,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:04:22.32,0:04:25.96,Default,,0000,0000,0000,,Ұнамаса жақсы.
Dialogue: 0,0:04:25.96,0:04:27.89,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:04:25.96,0:04:27.89,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:25.96,0:04:27.89,Default,,0000,0000,0000,,Мен оны ұнатпаймын деп айтқан жоқпын!
Dialogue: 0,0:04:27.89,0:04:31.83,Default,,0000,0000,0000,,Иә! Соны айтсаң
Dialogue: 0,0:04:27.89,0:04:31.83,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:04:27.89,0:04:31.83,Rubi,,0000,0000,0000,,Жабу
Dialogue: 0,0:04:27.89,0:04:31.83,Default,,0000,0000,0000,,Сынып комитеті мүшесінің миссиясы ретінде
Dialogue: 0,0:04:31.83,0:04:33.83,Default,,0000,0000,0000,,Мен мұны жақсы көргім келеді!
Dialogue: 0,0:04:33.83,0:04:38.47,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:04:33.83,0:04:38.47,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:33.83,0:04:38.47,Default,,0000,0000,0000,,《Ол екеуі, мұқият қарасаң,
Dialogue: 0,0:04:33.83,0:04:38.47,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:33.83,0:04:38.47,Default,,0000,0000,0000,,Сіз бірге жақсы көрінесіз, солай емес пе?
Dialogue: 0,0:04:38.47,0:04:42.47,Rubi,,0000,0000,0000,,Кекконшики
Dialogue: 0,0:04:38.47,0:04:42.47,Rubi,,0000,0000,0000,,Санрецуша
Dialogue: 0,0:04:38.47,0:04:42.47,Default,,0000,0000,0000,,(үйлену тойына қатысушылар)
Dialogue: 0,0:04:38.47,0:04:42.47,Rubi,,0000,0000,0000,,Рионин
Dialogue: 0,0:04:38.47,0:04:42.47,Default,,0000,0000,0000,,《Ой, екеуің! 》
Dialogue: 0,0:04:43.34,0:04:47.48,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:04:43.34,0:04:47.48,Default,,0000,0000,0000,,<Мару-чан зеріккенде,
Dialogue: 0,0:04:43.34,0:04:47.48,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:04:43.34,0:04:47.48,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:04:43.34,0:04:47.48,Default,,0000,0000,0000,,Біртүрлі нәрселер туралы ойлау＞
Dialogue: 0,0:04:47.48,0:04:49.41,Rubi,,0000,0000,0000,,Кимо
Dialogue: 0,0:04:47.48,0:04:49.41,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:04:47.48,0:04:49.41,Default,,0000,0000,0000,,《Бұл біраз жиіркенішті болды...》
Dialogue: 0,0:04:49.41,0:04:51.35,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:04:49.41,0:04:51.35,Default,,0000,0000,0000,,Бірақ егер бұл Маруо болса
Dialogue: 0,0:04:51.35,0:04:54.35,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:04:51.35,0:04:54.35,Default,,0000,0000,0000,,Көрші атаның рөлі жақсырақ.
Dialogue: 0,0:04:51.35,0:04:54.35,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:51.35,0:04:54.35,Default,,0000,0000,0000,,Бұл сізге сәйкес емес пе?
Dialogue: 0,0:04:54.35,0:04:57.99,Rubi,,0000,0000,0000,,Одо
Dialogue: 0,0:04:54.35,0:04:57.99,Rubi,,0000,0000,0000,,Они
Dialogue: 0,0:04:54.35,0:04:57.99,Rubi,,0000,0000,0000,,Қақпақ
Dialogue: 0,0:04:54.35,0:04:57.99,Default,,0000,0000,0000,,Мен билегенім сонша, жыннан екі соққы алдым.
Dialogue: 0,0:04:54.35,0:04:57.99,Default,,0000,0000,0000,,Мен ұсталдым!
Dialogue: 0,0:04:57.99,0:04:59.92,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:04:57.99,0:04:59.92,Rubi,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:04:57.99,0:04:59.92,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:04:57.99,0:04:59.92,Default,,0000,0000,0000,,(Оқушылар күледі)
Dialogue: 0,0:04:59.92,0:05:01.42,Rubi,,0000,0000,0000,,Данши
Dialogue: 0,0:04:59.92,0:05:01.42,Default,,0000,0000,0000,,Иә, иә!
Dialogue: 0,0:05:01.42,0:05:02.93,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:05:01.42,0:05:02.93,Default,,0000,0000,0000,,Мигива ше?
Dialogue: 0,0:05:02.93,0:05:05.43,Rubi,,0000,0000,0000,,Секигучи
Dialogue: 0,0:05:02.93,0:05:05.43,Default,,0000,0000,0000,,(Секигучи)
Dialogue: 0,0:05:02.93,0:05:05.43,Rubi,,0000,0000,0000,,қою
Dialogue: 0,0:05:02.93,0:05:05.43,Default,,0000,0000,0000,,Қарияның әйелі көрші!
Dialogue: 0,0:05:05.43,0:05:07.93,Rubi,,0000,0000,0000,,Секигучи-кун
Dialogue: 0,0:05:05.43,0:05:07.93,Default,,0000,0000,0000,,Се Се Се Се Се... Секигучи-кун!
Dialogue: 0,0:05:07.93,0:05:10.43,Rubi,,0000,0000,0000,,Сіз
Dialogue: 0,0:05:07.93,0:05:10.43,Default,,0000,0000,0000,,Сен менікісің
Dialogue: 0,0:05:07.93,0:05:10.43,Rubi,,0000,0000,0000,,Акуй
Dialogue: 0,0:05:07.93,0:05:10.43,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:05:07.93,0:05:10.43,Default,,0000,0000,0000,,Сізде зиянды ниет бар ма?
Dialogue: 0,0:05:10.43,0:05:12.37,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:05:12.37,0:05:15.94,Rubi,,0000,0000,0000,,Секигучи-кун
Dialogue: 0,0:05:12.37,0:05:15.94,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:05:12.37,0:05:15.94,Default,,0000,0000,0000,,Секигучи мырза, бұл шынымен менмін.
Dialogue: 0,0:05:12.37,0:05:15.94,Rubi,,0000,0000,0000,,Шуяку
Dialogue: 0,0:05:12.37,0:05:15.94,Default,,0000,0000,0000,,Басты рөлді ойнағың келмей ме?
Dialogue: 0,0:05:15.94,0:05:17.44,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:05:15.94,0:05:17.44,Default,,0000,0000,0000,,Серігің бір нәрсені қайтарып алуды бірінші орынға қойып, сені тастап кетпекші ме?
Dialogue: 0,0:05:17.44,0:05:19.38,Default,,0000,0000,0000,,Сіз мұны істедіңіз!
Dialogue: 0,0:05:17.44,0:05:19.38,Default,,0000,0000,0000,,Мазасыздық!
Dialogue: 0,0:05:19.38,0:05:21.95,Default,,0000,0000,0000,,Уунуну…
Dialogue: 0,0:05:21.95,0:05:26.45,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:05:21.95,0:05:26.45,Default,,0000,0000,0000,,(гүл шоқтары)
Dialogue: 0,0:05:21.95,0:05:26.45,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:05:21.95,0:05:26.45,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:05:21.95,0:05:26.45,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:05:21.95,0:05:26.45,Default,,0000,0000,0000,,Жарайды, екеуміз де тынышталамыз.
Dialogue: 0,0:05:21.95,0:05:26.45,Default,,0000,0000,0000,,Мұндай жағдайларда, мысалы
Dialogue: 0,0:05:26.45,0:05:29.35,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:05:26.45,0:05:29.35,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:05:26.45,0:05:29.35,Default,,0000,0000,0000,,Шешім қабылдаудың осындай тамаша тәсілі бар ма?
Dialogue: 0,0:05:26.45,0:05:29.35,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:05:26.45,0:05:29.35,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:05:29.35,0:05:31.32,Rubi,,0000,0000,0000,,Би
Dialogue: 0,0:05:29.35,0:05:31.32,Default,,0000,0000,0000,,Иә, бұл лотерея!
Dialogue: 0,0:05:31.32,0:05:34.82,Rubi,,0000,0000,0000,,Асығыңыз
Dialogue: 0,0:05:31.32,0:05:34.82,Rubi,,0000,0000,0000,,Би
Dialogue: 0,0:05:31.32,0:05:34.82,Default,,0000,0000,0000,,<Соңында жеребе тарту арқылы кастинг жүргізілді.
Dialogue: 0,0:05:31.32,0:05:34.82,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:05:31.32,0:05:34.82,Default,,0000,0000,0000,,Шешім қабылданды>
Dialogue: 0,0:05:43.47,0:05:44.97,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:05:43.47,0:05:44.97,Default,,0000,0000,0000,,Оны алу мүмкін емес.
Dialogue: 0,0:05:44.97,0:05:48.47,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:05:44.97,0:05:48.47,Default,,0000,0000,0000,,Көбінесе бұл хит болды.
Dialogue: 0,0:05:44.97,0:05:48.47,Rubi,,0000,0000,0000,,Мурабито
Dialogue: 0,0:05:44.97,0:05:48.47,Default,,0000,0000,0000,,Ауыл тұрғыны 2, т.б.
Dialogue: 0,0:05:48.47,0:05:49.97,Default,,0000,0000,0000,,Дұрыс па, солай емес пе?
Dialogue: 0,0:05:49.97,0:05:52.48,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:05:49.97,0:05:52.48,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:05:49.97,0:05:52.48,Default,,0000,0000,0000,,А, онда ештеңе жазылмаған.
Dialogue: 0,0:05:52.48,0:05:55.98,Default,,0000,0000,0000,,Не істерімді білмеймін.
Dialogue: 0,0:05:52.48,0:05:55.98,Default,,0000,0000,0000,,Мен де, мен сенімдімін...
Dialogue: 0,0:05:57.98,0:05:59.98,Default,,0000,0000,0000,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:06:01.85,0:06:04.79,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:06:01.85,0:06:04.79,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:06:01.85,0:06:04.79,Default,,0000,0000,0000,,Көрші атаның рөлі
Dialogue: 0,0:06:04.79,0:06:06.42,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:06:04.79,0:06:06.42,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:06:06.42,0:06:08.92,Default,,0000,0000,0000,,《
Dialogue: 0,0:06:06.42,0:06:08.92,Default,,0000,0000,0000,,Орындалу…”》
Dialogue: 0,0:06:10.29,0:06:12.29,Default,,0000,0000,0000,,《О...》
Dialogue: 0,0:06:13.93,0:06:17.43,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:06:13.93,0:06:17.43,Rubi,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:06:13.93,0:06:17.43,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:06:13.93,0:06:17.43,Default,,0000,0000,0000,,(Оқушылар күледі)
Dialogue: 0,0:06:17.43,0:06:21.43,Default,,0000,0000,0000,,《Неге мен?
Dialogue: 0,0:06:17.43,0:06:21.43,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:06:17.43,0:06:21.43,Default,,0000,0000,0000,,Ол көрші қарттың рөлін ойнап жатыр! 》
Dialogue: 0,0:06:22.94,0:06:24.44,Default,,0000,0000,0000,,Иә? О!
Dialogue: 0,0:06:24.44,0:06:26.94,Default,,0000,0000,0000,,Сакура-сан
Dialogue: 0,0:06:24.44,0:06:26.94,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:06:24.44,0:06:26.94,Default,,0000,0000,0000,,Көрші атаны ойнайсың ба?
Dialogue: 0,0:06:26.94,0:06:29.45,Rubi,,0000,0000,0000,,Ганба
Dialogue: 0,0:06:26.94,0:06:29.45,Default,,0000,0000,0000,,Сәттілік!
Dialogue: 0,0:06:29.45,0:06:30.95,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:06:30.95,0:06:32.45,Rubi,,0000,0000,0000,,Хакушю
Dialogue: 0,0:06:30.95,0:06:32.45,Default,,0000,0000,0000,,Мен хат жібергім келеді…
Dialogue: 0,0:06:37.82,0:06:42.96,Rubi,,0000,0000,0000,,Тренинг
Dialogue: 0,0:06:37.82,0:06:42.96,Default,,0000,0000,0000,,Содан кейін қатты жаттығу жасаңыз.
Dialogue: 0,0:06:37.82,0:06:42.96,Rubi,,0000,0000,0000,,Гакугейкай
Dialogue: 0,0:06:37.82,0:06:42.96,Rubi,,0000,0000,0000,,Геки
Dialogue: 0,0:06:37.82,0:06:42.96,Rubi,,0000,0000,0000,,Сейкоу
Dialogue: 0,0:06:37.82,0:06:42.96,Default,,0000,0000,0000,,Мектеп ойынын сәтті өткізейік.
Dialogue: 0,0:06:42.96,0:06:45.46,Rubi,,0000,0000,0000,,Оқиға
Dialogue: 0,0:06:42.96,0:06:45.46,Default,,0000,0000,0000,,Уа!
Dialogue: 0,0:06:48.83,0:06:50.83,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:06:48.83,0:06:50.83,Rubi,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:06:48.83,0:06:50.83,Rubi,,0000,0000,0000,,Хира
Dialogue: 0,0:06:48.83,0:06:50.83,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:06:48.83,0:06:50.83,Default,,0000,0000,0000,,(жылжымалы есіктің ашылу дыбысы)
Dialogue: 0,0:06:48.83,0:06:50.83,Default,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:06:50.83,0:06:52.97,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:06:50.83,0:06:52.97,Default,,0000,0000,0000,,《Бұл тамаша емес》
Dialogue: 0,0:06:52.97,0:06:56.84,Rubi,,0000,0000,0000,,Джинсей
Dialogue: 0,0:06:52.97,0:06:56.84,Default,,0000,0000,0000,,《Ааа, бұл өмір ғой
Dialogue: 0,0:06:52.97,0:06:56.84,Rubi,,0000,0000,0000,,Иссунсаки
Dialogue: 0,0:06:52.97,0:06:56.84,Rubi,,0000,0000,0000,,Қараңғылық
Dialogue: 0,0:06:52.97,0:06:56.84,Default,,0000,0000,0000,,Бір дюйм алда қараңғылық.
Dialogue: 0,0:06:56.84,0:06:58.47,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:56.84,0:06:58.47,Default,,0000,0000,0000,,Әй, Маруко!
Dialogue: 0,0:06:58.47,0:07:01.91,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:06:58.47,0:07:01.91,Rubi,,0000,0000,0000,,Гакугейкай
Dialogue: 0,0:06:58.47,0:07:01.91,Default,,0000,0000,0000,,Ей, алда мектеп ойыны.
Dialogue: 0,0:06:58.47,0:07:01.91,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:58.47,0:07:01.91,Default,,0000,0000,0000,,Сіздің сыныбыңыз қандай?
Dialogue: 0,0:07:01.91,0:07:03.85,Rubi,,0000,0000,0000,,Геки
Dialogue: 0,0:07:01.91,0:07:03.85,Default,,0000,0000,0000,,Ой... бұл пьеса.
Dialogue: 0,0:07:01.91,0:07:03.85,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:07:01.91,0:07:03.85,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:07:03.85,0:07:07.42,Default,,0000,0000,0000,,О, бұл...
Dialogue: 0,0:07:03.85,0:07:07.42,Default,,0000,0000,0000,,«Обуторижисан» бірақ…
Dialogue: 0,0:07:07.42,0:07:10.32,Default,,0000,0000,0000,,Хун
Dialogue: 0,0:07:07.42,0:07:10.32,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:07.42,0:07:10.32,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:07:07.42,0:07:10.32,Default,,0000,0000,0000,,Сонымен, сіз қандай да бір рөлді ойнайсыз ба?
Dialogue: 0,0:07:10.32,0:07:12.29,Rubi,,0000,0000,0000,,Мен қалаймын
Dialogue: 0,0:07:10.32,0:07:12.29,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:07:10.32,0:07:12.29,Default,,0000,0000,0000,,Бұл... үлкен рөл емес.
Dialogue: 0,0:07:12.29,0:07:14.92,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:07:12.29,0:07:14.92,Default,,0000,0000,0000,,Мен қарттың рөлін ойнамаймын!
Dialogue: 0,0:07:14.92,0:07:18.80,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:07:14.92,0:07:18.80,Default,,0000,0000,0000,,Ахаха мен қарттың рөлін ойнадым.
Dialogue: 0,0:07:14.92,0:07:18.80,Rubi,,0000,0000,0000,,Сақал
Dialogue: 0,0:07:14.92,0:07:18.80,Default,,0000,0000,0000,,Бұлай болса, қайғылы оқиға болар еді.
Dialogue: 0,0:07:18.80,0:07:21.80,Default,,0000,0000,0000,,Мен оған бірнеше соққы қойдым
Dialogue: 0,0:07:18.80,0:07:21.80,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:07:18.80,0:07:21.80,Default,,0000,0000,0000,,Керемет емес!
Dialogue: 0,0:07:21.80,0:07:24.93,Rubi,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:07:21.80,0:07:24.93,Default,,0000,0000,0000,,Мен мұны істегім келмейді.
Dialogue: 0,0:07:24.93,0:07:26.87,Default,,0000,0000,0000,,Ахаха жақсы...
Dialogue: 0,0:07:26.87,0:07:28.81,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:07:26.87,0:07:28.81,Rubi,,0000,0000,0000,,Вадай
Dialogue: 0,0:07:26.87,0:07:28.81,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:07:26.87,0:07:28.81,Default,,0000,0000,0000,,<Тақырыпты тез өзгерткім келеді.
Dialogue: 0,0:07:26.87,0:07:28.81,Default,,0000,0000,0000,,Мару-чан
Dialogue: 0,0:07:28.81,0:07:32.44,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:07:28.81,0:07:32.44,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:28.81,0:07:32.44,Default,,0000,0000,0000,,Әпкең не дейді
Dialogue: 0,0:07:28.81,0:07:32.44,Rubi,,0000,0000,0000,,Мими
Dialogue: 0,0:07:28.81,0:07:32.44,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:07:28.81,0:07:32.44,Default,,0000,0000,0000,,Мен оны Roku-да естіген жоқпын＞
Dialogue: 0,0:07:32.44,0:07:34.38,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:07:32.44,0:07:34.38,Rubi,,0000,0000,0000,,Гассо
Dialogue: 0,0:07:32.44,0:07:34.38,Default,,0000,0000,0000,,Менің сыныбымда ансамбльдік қойылым бар.
Dialogue: 0,0:07:34.38,0:07:36.31,Default,,0000,0000,0000,,Ахаха жақсы...
Dialogue: 0,0:07:36.31,0:07:39.32,Default,,0000,0000,0000,,Хо
Dialogue: 0,0:07:36.31,0:07:39.32,Rubi,,0000,0000,0000,,Гассо
Dialogue: 0,0:07:36.31,0:07:39.32,Rubi,,0000,0000,0000,,Bue
Dialogue: 0,0:07:36.31,0:07:39.32,Rubi,,0000,0000,0000,,Улы
Dialogue: 0,0:07:36.31,0:07:39.32,Default,,0000,0000,0000,,Ансамбльдегі жеке флейта
Dialogue: 0,0:07:39.32,0:07:40.32,Default,,0000,0000,0000,,Бұл керемет!
Dialogue: 0,0:07:39.32,0:07:40.32,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:07:40.32,0:07:41.95,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:07:40.32,0:07:41.95,Rubi,,0000,0000,0000,,Жабу
Dialogue: 0,0:07:40.32,0:07:41.95,Default,,0000,0000,0000,,Мұғалім ұсынған
Dialogue: 0,0:07:41.95,0:07:44.45,Rubi,,0000,0000,0000,,Энсу
Dialogue: 0,0:07:41.95,0:07:44.45,Rubi,,0000,0000,0000,,Точу
Dialogue: 0,0:07:41.95,0:07:44.45,Default,,0000,0000,0000,,Барлығының орындауының ортасында
Dialogue: 0,0:07:41.95,0:07:44.45,Default,,0000,0000,0000,,Мен мұны істеуді шештім.
Dialogue: 0,0:07:44.45,0:07:45.96,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:07:44.45,0:07:45.96,Default,,0000,0000,0000,,Иә, бұл таңқаларлық.
Dialogue: 0,0:07:45.96,0:07:47.89,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:07:45.96,0:07:47.89,Default,,0000,0000,0000,,Күткендей, әпке
Dialogue: 0,0:07:47.89,0:07:50.46,Default,,0000,0000,0000,,Сонымен, барлығы
Dialogue: 0,0:07:47.89,0:07:50.46,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:07:47.89,0:07:50.46,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:47.89,0:07:50.46,Default,,0000,0000,0000,,Мен оны көруім керек.
Dialogue: 0,0:07:50.46,0:07:53.96,Default,,0000,0000,0000,,Сабыр сақта.
Dialogue: 0,0:07:50.46,0:07:53.96,Rubi,,0000,0000,0000,,Бенто
Dialogue: 0,0:07:50.46,0:07:53.96,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:07:50.46,0:07:53.96,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:07:50.46,0:07:53.96,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:50.46,0:07:53.96,Default,,0000,0000,0000,,Мен түскі асымды әкеліп, көруге баруым керек.
Dialogue: 0,0:07:55.97,0:07:56.93,Default,,0000,0000,0000,,Қазір...
Dialogue: 0,0:07:56.93,0:07:59.84,Default,,0000,0000,0000,,Ах, дұрыс
Dialogue: 0,0:07:56.93,0:07:59.84,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:56.93,0:07:59.84,Rubi,,0000,0000,0000,,Геки
Dialogue: 0,0:07:56.93,0:07:59.84,Default,,0000,0000,0000,,Маруко да ойнайды, солай ма?
Dialogue: 0,0:07:59.84,0:08:01.77,Default,,0000,0000,0000,,«Кобутори қарт»
Dialogue: 0,0:08:01.77,0:08:03.41,Default,,0000,0000,0000,,Ух... иә
Dialogue: 0,0:08:03.41,0:08:06.31,Rubi,,0000,0000,0000,,Мен қалаймын
Dialogue: 0,0:08:03.41,0:08:06.31,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:08:03.41,0:08:06.31,Default,,0000,0000,0000,,Бірақ бұл үлкен рөл атқармайды.
Dialogue: 0,0:08:03.41,0:08:06.31,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:08:06.31,0:08:07.91,Rubi,,0000,0000,0000,,Мурабито
Dialogue: 0,0:08:06.31,0:08:07.91,Default,,0000,0000,0000,,Ауыл тұрғыны 2-бөлім
Dialogue: 0,0:08:07.91,0:08:09.85,Default,,0000,0000,0000,,басқаша
Dialogue: 0,0:08:07.91,0:08:09.85,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:08:07.91,0:08:09.85,Default,,0000,0000,0000,,Бұл мен көруге келетін нәрсе емес.
Dialogue: 0,0:08:09.85,0:08:11.78,Default,,0000,0000,0000,,Олай болса.
Dialogue: 0,0:08:09.85,0:08:11.78,Default,,0000,0000,0000,,Жолдар бар ма?
Dialogue: 0,0:08:11.78,0:08:13.78,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:11.78,0:08:13.78,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:08:11.78,0:08:13.78,Default,,0000,0000,0000,,А... бұл анық.
Dialogue: 0,0:08:13.78,0:08:16.42,Default,,0000,0000,0000,,Жолдар жоқ
Dialogue: 0,0:08:13.78,0:08:16.42,Rubi,,0000,0000,0000,,Геки
Dialogue: 0,0:08:13.78,0:08:16.42,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:08:13.78,0:08:16.42,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:13.78,0:08:16.42,Default,,0000,0000,0000,,Мен спектакльде боламын деп айта алмаймын.
Dialogue: 0,0:08:16.42,0:08:18.35,Rubi,,0000,0000,0000,,О
Dialogue: 0,0:08:16.42,0:08:18.35,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:08:16.42,0:08:18.35,Default,,0000,0000,0000,,О, үлкен болып шықты.
Dialogue: 0,0:08:18.35,0:08:21.93,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:08:18.35,0:08:21.93,Default,,0000,0000,0000,,Иә, әке де.
Dialogue: 0,0:08:18.35,0:08:21.93,Rubi,,0000,0000,0000,,Ушивакамару
Dialogue: 0,0:08:18.35,0:08:21.93,Rubi,,0000,0000,0000,,Тренинг
Dialogue: 0,0:08:18.35,0:08:21.93,Default,,0000,0000,0000,,«Ушивакамару мен Бенкейде»
Dialogue: 0,0:08:21.93,0:08:27.43,Rubi,,0000,0000,0000,,Тренинг
Dialogue: 0,0:08:21.93,0:08:27.43,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:21.93,0:08:27.43,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:08:21.93,0:08:27.43,Default,,0000,0000,0000,,«Әй, Беңкей!» деген рөл.
Dialogue: 0,0:08:21.93,0:08:27.43,Default,,0000,0000,0000,,Мен мұны бұрын жасағанмын.
Dialogue: 0,0:08:27.43,0:08:28.40,Default,,0000,0000,0000,,Хироши керемет!
Dialogue: 0,0:08:28.40,0:08:31.94,Rubi,,0000,0000,0000,,Конджикияша
Dialogue: 0,0:08:28.40,0:08:31.94,Default,,0000,0000,0000,,Мен «Алтын Яша» сияқтымын
Dialogue: 0,0:08:28.40,0:08:31.94,Rubi,,0000,0000,0000,,Каничи
Dialogue: 0,0:08:28.40,0:08:31.94,Default,,0000,0000,0000,,Каничи жасады
Dialogue: 0,0:08:31.94,0:08:33.87,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:08:31.94,0:08:33.87,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:08:31.94,0:08:33.87,Default,,0000,0000,0000,,Не? Бұл қандай рөл?
Dialogue: 0,0:08:33.87,0:08:36.44,Rubi,,0000,0000,0000,,Таши
Dialogue: 0,0:08:33.87,0:08:36.44,Default,,0000,0000,0000,,Мен сенімдімін...
Dialogue: 0,0:08:36.44,0:08:41.95,Rubi,,0000,0000,0000,,Акаги
Dialogue: 0,0:08:36.44,0:08:41.95,Rubi,,0000,0000,0000,,Яма
Dialogue: 0,0:08:36.44,0:08:41.95,Rubi,,0000,0000,0000,,Койой кілті
Dialogue: 0,0:08:36.44,0:08:41.95,Default,,0000,0000,0000,,«Акаги таулары тек бүгін түнге жарамды»
Dialogue: 0,0:08:36.44,0:08:41.95,Rubi,,0000,0000,0000,,Мэй
Dialogue: 0,0:08:36.44,0:08:41.95,Default,,0000,0000,0000,,Әйгілі желі болса ғой.
Dialogue: 0,0:08:41.95,0:08:43.88,Default,,0000,0000,0000,,Я~
Dialogue: 0,0:08:41.95,0:08:43.88,Default,,0000,0000,0000,,«Иә?» емес
Dialogue: 0,0:08:43.88,0:08:46.82,Default,,0000,0000,0000,,Ата, болды.
Dialogue: 0,0:08:43.88,0:08:46.82,Rubi,,0000,0000,0000,,Ippongata т.б.
Dialogue: 0,0:08:43.88,0:08:46.82,Default,,0000,0000,0000,,Бұл ``Иппонто Дохио-ири'' емес пе?
Dialogue: 0,0:08:46.82,0:08:48.82,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:08:46.82,0:08:48.82,Rubi,,0000,0000,0000,,Құрама теңге
Dialogue: 0,0:08:46.82,0:08:48.82,Default,,0000,0000,0000,,Жоқ, бұл Курама Тенгу.
Dialogue: 0,0:08:48.82,0:08:50.45,Rubi,,0000,0000,0000,,Мито Комон
Dialogue: 0,0:08:48.82,0:08:50.45,Default,,0000,0000,0000,,Е, бұл «Мито Комон» емес пе?
Dialogue: 0,0:08:50.45,0:08:52.96,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:08:50.45,0:08:52.96,Rubi,,0000,0000,0000,,Танге
Dialogue: 0,0:08:50.45,0:08:52.96,Rubi,,0000,0000,0000,,Сазен
Dialogue: 0,0:08:50.45,0:08:52.96,Default,,0000,0000,0000,,Жоқ, мүмкін «Таңге Сазен» шығар?
Dialogue: 0,0:08:50.45,0:08:52.96,Default,,0000,0000,0000,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:08:52.96,0:08:57.83,Rubi,,0000,0000,0000,,Фью
Dialogue: 0,0:08:52.96,0:08:57.83,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:08:52.96,0:08:57.83,Default,,0000,0000,0000,,()
Dialogue: 0,0:08:57.83,0:09:04.40,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:04.40,0:09:06.90,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:09:04.40,0:09:06.90,Default,,0000,0000,0000,,Пихьяра Пихьяра!
Dialogue: 0,0:09:06.90,0:09:08.84,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:09:06.90,0:09:08.84,Rubi,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:09:06.90,0:09:08.84,Rubi,,0000,0000,0000,,Бөлме
Dialogue: 0,0:09:06.90,0:09:08.84,Default,,0000,0000,0000,,Бір ғана әпкесі бар бөлмеде
Dialogue: 0,0:09:06.90,0:09:08.84,Default,,0000,0000,0000,,Өйткені ондай жоқ!
Dialogue: 0,0:09:08.84,0:09:11.41,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:09:08.84,0:09:11.41,Rubi,,0000,0000,0000,,Мейвакку
Dialogue: 0,0:09:08.84,0:09:11.41,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:09:08.84,0:09:11.41,Default,,0000,0000,0000,,Басқаларға қолайсыздықты ескеріңіз!
Dialogue: 0,0:09:11.41,0:09:12.91,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:11.41,0:09:12.91,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:11.41,0:09:12.91,Default,,0000,0000,0000,,Не айтып тұрсың!
Dialogue: 0,0:09:12.91,0:09:14.41,Default,,0000,0000,0000,,Шулы болса
Dialogue: 0,0:09:12.91,0:09:14.41,Rubi,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:09:12.91,0:09:14.41,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:12.91,0:09:14.41,Default,,0000,0000,0000,,Кет!
Dialogue: 0,0:09:14.41,0:09:17.31,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:14.41,0:09:17.31,Default,,0000,0000,0000,,Не, манга?
Dialogue: 0,0:09:14.41,0:09:17.31,Rubi,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:09:14.41,0:09:17.31,Default,,0000,0000,0000,,Оқыңыз Hmph!
Dialogue: 0,0:09:17.31,0:09:21.31,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:17.31,0:09:21.31,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:09:17.31,0:09:21.31,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:09:17.31,0:09:21.31,Rubi,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:09:17.31,0:09:21.31,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:17.31,0:09:21.31,Default,,0000,0000,0000,,Сен сол жаққа бару керексің!
Dialogue: 0,0:09:22.29,0:09:25.92,Rubi,,0000,0000,0000,,Фью
Dialogue: 0,0:09:22.29,0:09:25.92,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:09:22.29,0:09:25.92,Default,,0000,0000,0000,,()
Dialogue: 0,0:09:25.92,0:09:28.42,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:25.92,0:09:28.42,Default,,0000,0000,0000,,Сондай-ақ~ Бұл әрқашан Маруко...
Dialogue: 0,0:09:28.42,0:09:29.93,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:09:33.43,0:09:34.40,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:09:33.43,0:09:34.40,Default,,0000,0000,0000,,()
Dialogue: 0,0:09:34.40,0:09:36.93,Rubi,,0000,0000,0000,,Геки
Dialogue: 0,0:09:34.40,0:09:36.93,Rubi,,0000,0000,0000,,Шуцуэн
Dialogue: 0,0:09:34.40,0:09:36.93,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:09:34.40,0:09:36.93,Default,,0000,0000,0000,,Спектакльде пайда болғандар
Dialogue: 0,0:09:34.40,0:09:36.93,Rubi,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:09:34.40,0:09:36.93,Default,,0000,0000,0000,,Қалыңыз
Dialogue: 0,0:09:36.93,0:09:38.43,Default,,0000,0000,0000,,Қош бол
Dialogue: 0,0:09:38.43,0:09:40.93,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:09:38.43,0:09:40.93,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:09:38.43,0:09:40.93,Default,,0000,0000,0000,,()
Dialogue: 0,0:09:42.31,0:09:43.94,Rubi,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:09:42.31,0:09:43.94,Default,,0000,0000,0000,,Олай болса, Мару-чан, бірінші бар.
Dialogue: 0,0:09:43.94,0:09:46.84,Rubi,,0000,0000,0000,,Ганба
Dialogue: 0,0:09:43.94,0:09:46.84,Default,,0000,0000,0000,,Сәттілік. Сау бол!
Dialogue: 0,0:09:46.84,0:09:48.81,Default,,0000,0000,0000,,Қош бол…
Dialogue: 0,0:09:48.81,0:09:50.45,Default,,0000,0000,0000,,Маған жеңіл қарама
Dialogue: 0,0:09:50.45,0:09:53.95,Default,,0000,0000,0000,,《Бәрі жақсы.
Dialogue: 0,0:09:50.45,0:09:53.95,Rubi,,0000,0000,0000,,Ата-аналар
Dialogue: 0,0:09:50.45,0:09:53.95,Rubi,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:09:50.45,0:09:53.95,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:09:50.45,0:09:53.95,Default,,0000,0000,0000,,Бұл тіпті ата-анаңызбен және бауырларыңызбен де сөйлесуге болатын рөл.
Dialogue: 0,0:09:53.95,0:09:56.85,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:53.95,0:09:56.85,Default,,0000,0000,0000,,Маруко!
Dialogue: 0,0:09:53.95,0:09:56.85,Rubi,,0000,0000,0000,,Негіздер
Dialogue: 0,0:09:53.95,0:09:56.85,Default,,0000,0000,0000,,Сценарийді оқыдыңыз ба?
Dialogue: 0,0:09:56.85,0:09:59.82,Default,,0000,0000,0000,,Иә, шамамен...
Dialogue: 0,0:09:59.82,0:10:01.39,Default,,0000,0000,0000,,《Бұл жігіт
Dialogue: 0,0:09:59.82,0:10:01.39,Default,,0000,0000,0000,,Сіз мені мазақ етіп жатқан шығарсыз.
Dialogue: 0,0:10:01.39,0:10:03.89,Default,,0000,0000,0000,,Ақымақ қарт
Dialogue: 0,0:10:01.39,0:10:03.89,Default,,0000,0000,0000,,Мен туралы...》
Dialogue: 0,0:10:03.89,0:10:05.83,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:10:03.89,0:10:05.83,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:10:03.89,0:10:05.83,Default,,0000,0000,0000,,Біздің рөліміз қандай?
Dialogue: 0,0:10:05.83,0:10:07.76,Rubi,,0000,0000,0000,,О
Dialogue: 0,0:10:05.83,0:10:07.76,Default,,0000,0000,0000,,Жолдар өте көп
Dialogue: 0,0:10:05.83,0:10:07.76,Default,,0000,0000,0000,,Сіз мұны істейсіз.
Dialogue: 0,0:10:07.76,0:10:09.77,Default,,0000,0000,0000,,《Бәрібір сенде бәрі жақсы.
Dialogue: 0,0:10:09.77,0:10:12.40,Rubi,,0000,0000,0000,,Шуяку
Dialogue: 0,0:10:09.77,0:10:12.40,Default,,0000,0000,0000,,Өйткені ол басты кейіпкер.
Dialogue: 0,0:10:09.77,0:10:12.40,Rubi,,0000,0000,0000,,Яку
Dialogue: 0,0:10:09.77,0:10:12.40,Default,,0000,0000,0000,,Бұл жақсы рөл》
Dialogue: 0,0:10:12.40,0:10:14.34,Rubi,,0000,0000,0000,,Мейвакку
Dialogue: 0,0:10:12.40,0:10:14.34,Default,,0000,0000,0000,,Бұл өте мазасыз.
Dialogue: 0,0:10:14.34,0:10:16.27,Rubi,,0000,0000,0000,,Геки
Dialogue: 0,0:10:14.34,0:10:16.27,Default,,0000,0000,0000,,Мен спектакль қойғым келмейді!
Dialogue: 0,0:10:16.27,0:10:20.28,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:10:16.27,0:10:20.28,Rubi,,0000,0000,0000,,Гакугейкай
Dialogue: 0,0:10:16.27,0:10:20.28,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:10:16.27,0:10:20.28,Default,,0000,0000,0000,,《Мектеп ойыны болатын күні айттым.
Dialogue: 0,0:10:16.27,0:10:20.28,Rubi,,0000,0000,0000,,Отбасы
Dialogue: 0,0:10:16.27,0:10:20.28,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:10:16.27,0:10:20.28,Default,,0000,0000,0000,,Оны көруге бүкіл отбасы келеді, солай ма?
