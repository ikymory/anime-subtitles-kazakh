Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.84,0:01:14.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:10.30,0:03:13.30,Rubi,,0000,0000,0000,,Kotori
Dialogue: 0,0:03:10.30,0:03:13.30,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:03:15.91,0:03:16.91,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:15.91,0:03:16.91,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:03:17.84,0:03:20.41,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:03:17.84,0:03:20.41,Default,,0000,0000,0000,,А, мен жақсы ұйықтадым.
Dialogue: 0,0:03:20.41,0:03:23.31,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:03:20.41,0:03:23.31,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:03:20.41,0:03:23.31,Default,,0000,0000,0000,,Әй, әпкем әлі ұйықтап жатыр.
Dialogue: 0,0:03:20.41,0:03:23.31,Rubi,,0000,0000,0000,,Небу
Dialogue: 0,0:03:20.41,0:03:23.31,Default,,0000,0000,0000,,Сіз ұйықтап қалдыңыз.
Dialogue: 0,0:03:23.31,0:03:29.22,Rubi,,0000,0000,0000,,Джи
Dialogue: 0,0:03:23.31,0:03:29.22,Default,,0000,0000,0000,,Ой! Хе~ Сағат небәрі 6 болды!
Dialogue: 0,0:03:23.31,0:03:29.22,Rubi,,0000,0000,0000,,Шин
Dialogue: 0,0:03:23.31,0:03:29.22,Default,,0000,0000,0000,,Мен бұған сенбеймін
Dialogue: 0,0:03:29.22,0:03:31.86,Rubi,,0000,0000,0000,,Хаяо
Dialogue: 0,0:03:29.22,0:03:31.86,Default,,0000,0000,0000,,Қандай ерте тұру!
Dialogue: 0,0:03:31.86,0:03:34.36,Default,,0000,0000,0000,,<Осындай нәрсе
Dialogue: 0,0:03:31.86,0:03:34.36,Rubi,,0000,0000,0000,,Сонымен қатар мен сол күзетшіні таспен ұрып-соғып, ет-бауырын шығарғанмын…
Dialogue: 0,0:03:31.86,0:03:34.36,Default,,0000,0000,0000,,Сирек болады>
Dialogue: 0,0:03:34.36,0:03:35.86,Default,,0000,0000,0000,,<Егер бұл кәдімгі Мару-чан болса
Dialogue: 0,0:03:35.86,0:03:39.36,Rubi,,0000,0000,0000,,Дұрыс
Dialogue: 0,0:03:35.86,0:03:39.36,Rubi,,0000,0000,0000,,Футон
Dialogue: 0,0:03:35.86,0:03:39.36,Default,,0000,0000,0000,,Футонда тағы бір рет
Dialogue: 0,0:03:35.86,0:03:39.36,Rubi,,0000,0000,0000,,Могу
Dialogue: 0,0:03:35.86,0:03:39.36,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:35.86,0:03:39.36,Default,,0000,0000,0000,,Мен суға түсейін деп жатырмын...>
Dialogue: 0,0:03:41.73,0:03:47.37,Rubi,,0000,0000,0000,,Кимо
Dialogue: 0,0:03:41.73,0:03:47.37,Default,,0000,0000,0000,,Хмм, бұл жақсы!
Dialogue: 0,0:03:41.73,0:03:47.37,Rubi,,0000,0000,0000,,Хаяо
Dialogue: 0,0:03:41.73,0:03:47.37,Default,,0000,0000,0000,,Кейде ерте тұру жақсы.
Dialogue: 0,0:03:47.37,0:03:49.37,Default,,0000,0000,0000,,Ичи ни сан ён!
Dialogue: 0,0:03:51.88,0:03:55.38,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:03:51.88,0:03:55.38,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:03:51.88,0:03:55.38,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:51.88,0:03:55.38,Default,,0000,0000,0000,,Бүгін де барымызды салайық, мама.
Dialogue: 0,0:03:55.38,0:03:58.88,Default,,0000,0000,0000,,Бір минут күтіңіз
Dialogue: 0,0:03:55.38,0:03:58.88,Rubi,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:03:55.38,0:03:58.88,Default,,0000,0000,0000,,Саған не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:03:59.88,0:04:02.39,Rubi,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:03:59.88,0:04:02.39,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:03:59.88,0:04:02.39,Default,,0000,0000,0000,,«Жарайды» нені білдіреді?
Dialogue: 0,0:04:02.39,0:04:05.29,Rubi,,0000,0000,0000,,Хаяо
Dialogue: 0,0:04:02.39,0:04:05.29,Default,,0000,0000,0000,,Себебі мен ерте ояндым.
Dialogue: 0,0:04:05.29,0:04:06.89,Rubi,,0000,0000,0000,,Тобан
Dialogue: 0,0:04:05.29,0:04:06.89,Default,,0000,0000,0000,,Сіз кезекшіліктесіз бе?
Dialogue: 0,0:04:06.89,0:04:13.40,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:06.89,0:04:13.40,Default,,0000,0000,0000,,Эй, кейде бұл Маруко.
Dialogue: 0,0:04:06.89,0:04:13.40,Rubi,,0000,0000,0000,,Хаяо
Dialogue: 0,0:04:06.89,0:04:13.40,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:06.89,0:04:13.40,Rubi,,0000,0000,0000,,Тазалау
Dialogue: 0,0:04:06.89,0:04:13.40,Default,,0000,0000,0000,,Ерте тұруға қабілетіңізді көрсетіңіз
Dialogue: 0,0:04:13.40,0:04:16.90,Default,,0000,0000,0000,,О, құдай!
Dialogue: 0,0:04:13.40,0:04:16.90,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,0:04:13.40,0:04:16.90,Rubi,,0000,0000,0000,,Шицурей
Dialogue: 0,0:04:13.40,0:04:16.90,Default,,0000,0000,0000,,Мен бұл үшін қатты өкінемін.
Dialogue: 0,0:04:17.90,0:04:22.41,Default,,0000,0000,0000,,Қалай болғанда да, бұл не?
Dialogue: 0,0:04:17.90,0:04:22.41,Default,,0000,0000,0000,,Маған жеңіл қарама
Dialogue: 0,0:04:22.41,0:04:26.28,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:04:22.41,0:04:26.28,Rubi,,0000,0000,0000,,Джи
Dialogue: 0,0:04:22.41,0:04:26.28,Rubi,,0000,0000,0000,,Дүние
Dialogue: 0,0:04:22.41,0:04:26.28,Default,,0000,0000,0000,,Таңғы сағат 6-да дүние қандай?
Dialogue: 0,0:04:22.41,0:04:26.28,Default,,0000,0000,0000,,Бос уақытыңыз көп пе?
Dialogue: 0,0:04:26.28,0:04:27.85,Default,,0000,0000,0000,,Теледидар да қызықсыз
Dialogue: 0,0:04:27.85,0:04:31.35,Rubi,,0000,0000,0000,,Джудан
Dialogue: 0,0:04:27.85,0:04:31.35,Default,,0000,0000,0000,,Мен қалжыңдамаймын.
Dialogue: 0,0:04:27.85,0:04:31.35,Rubi,,0000,0000,0000,,Изога
Dialogue: 0,0:04:27.85,0:04:31.35,Default,,0000,0000,0000,,Мен шыдай алмаймын.
Dialogue: 0,0:04:31.35,0:04:34.25,Rubi,,0000,0000,0000,,Тецуда
Dialogue: 0,0:04:31.35,0:04:34.25,Default,,0000,0000,0000,,Уақытыңыз болса көмектесіңізші.
Dialogue: 0,0:04:31.35,0:04:34.25,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:04:34.25,0:04:36.85,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:34.25,0:04:36.85,Rubi,,0000,0000,0000,,Аджимигакари
Dialogue: 0,0:04:34.25,0:04:36.85,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:04:34.25,0:04:36.85,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:04:34.25,0:04:36.85,Default,,0000,0000,0000,,Жарайды, Маруко дәм татушы рөлін қабылдады.
Dialogue: 0,0:04:36.85,0:04:39.36,Rubi,,0000,0000,0000,,Мака
Dialogue: 0,0:04:36.85,0:04:39.36,Default,,0000,0000,0000,,Оны маған қалдырыңыз.
Dialogue: 0,0:04:39.36,0:04:42.86,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:04:39.36,0:04:42.86,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:04:39.36,0:04:42.86,Default,,0000,0000,0000,,Бұл жақсы идея.
Dialogue: 0,0:04:42.86,0:04:44.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:42.86,0:04:44.86,Default,,0000,0000,0000,,Ой
Dialogue: 0,0:04:46.36,0:04:51.87,Rubi,,0000,0000,0000,,Кеше
Dialogue: 0,0:04:46.36,0:04:51.87,Default,,0000,0000,0000,,Ах! Иә, менің ойымша, бұл кеше болды
Dialogue: 0,0:04:46.36,0:04:51.87,Rubi,,0000,0000,0000,,Ханбун
Dialogue: 0,0:04:46.36,0:04:51.87,Rubi,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:04:46.36,0:04:51.87,Default,,0000,0000,0000,,Апельсин шырынын жартысы қалды.
Dialogue: 0,0:04:51.87,0:04:56.74,Default,,0000,0000,0000,,Хаха, мінекей болды.
Dialogue: 0,0:04:51.87,0:04:56.74,Default,,0000,0000,0000,,Сонымен қатар йогурт...
Dialogue: 0,0:04:56.74,0:05:00.38,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:04:56.74,0:05:00.38,Default,,0000,0000,0000,,Таңертең жаңа піскен витаминдер
Dialogue: 0,0:04:56.74,0:05:00.38,Default,,0000,0000,0000,,Мен оны алуым керек.
Dialogue: 0,0:05:00.38,0:05:04.38,Default,,0000,0000,0000,,～ ～
Dialogue: 0,0:05:00.38,0:05:04.38,Default,,0000,0000,0000,,Рейхо~”
Dialogue: 0,0:05:10.39,0:05:14.26,Default,,0000,0000,0000,,Әй, дәмді!
Dialogue: 0,0:05:10.39,0:05:14.26,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:05:10.39,0:05:14.26,Rubi,,0000,0000,0000,,Какубецу
Dialogue: 0,0:05:10.39,0:05:14.26,Default,,0000,0000,0000,,Таңертеңгілік шырын ерекше
Dialogue: 0,0:05:14.26,0:05:16.26,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:05:14.26,0:05:16.26,Default,,0000,0000,0000,,Йогуртты да жеңіз
Dialogue: 0,0:05:16.26,0:05:19.76,Default,,0000,0000,0000,,Абайлаңыз
Dialogue: 0,0:05:16.26,0:05:19.76,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:05:16.26,0:05:19.76,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:05:16.26,0:05:19.76,Default,,0000,0000,0000,,Мен таңғы ас іше алмаймын.
Dialogue: 0,0:05:22.90,0:05:27.74,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:05:22.90,0:05:27.74,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:05:22.90,0:05:27.74,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені қайда қоюға болады
Dialogue: 0,0:05:22.90,0:05:27.74,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:05:22.90,0:05:27.74,Default,,0000,0000,0000,,Менің ішім басқа.
Dialogue: 0,0:05:27.74,0:05:30.74,Rubi,,0000,0000,0000,,Бенри
Dialogue: 0,0:05:27.74,0:05:30.74,Default,,0000,0000,0000,,Бұл өте ыңғайлы.
Dialogue: 0,0:05:27.74,0:05:30.74,Default,,0000,0000,0000,,Бұл сіздің асқазаныңыз
Dialogue: 0,0:05:33.84,0:05:37.84,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:05:33.84,0:05:37.84,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:33.84,0:05:37.84,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:05:33.84,0:05:37.84,Default,,0000,0000,0000,,О, Маруко, сен ертесің.
Dialogue: 0,0:05:39.35,0:05:41.85,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:05:39.35,0:05:41.85,Default,,0000,0000,0000,,Қайырлы таң әке
Dialogue: 0,0:05:39.35,0:05:41.85,Rubi,,0000,0000,0000,,Тістеу
Dialogue: 0,0:05:39.35,0:05:41.85,Default,,0000,0000,0000,,Бір тістеуге ше?
Dialogue: 0,0:05:42.85,0:05:45.36,Rubi,,0000,0000,0000,,Нео
Dialogue: 0,0:05:42.85,0:05:45.36,Rubi,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:05:42.85,0:05:45.36,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:05:42.85,0:05:45.36,Default,,0000,0000,0000,,Оянғанда жақсы тамақ ішесің.
Dialogue: 0,0:05:45.36,0:05:48.86,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:45.36,0:05:48.86,Default,,0000,0000,0000,,Маруконың асқазаны
Dialogue: 0,0:05:45.36,0:05:48.86,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:05:45.36,0:05:48.86,Rubi,,0000,0000,0000,,Джунби
Dialogue: 0,0:05:45.36,0:05:48.86,Default,,0000,0000,0000,,24 сағат дайындық жақсы.
Dialogue: 0,0:05:48.86,0:05:51.36,Default,,0000,0000,0000,,<Яна іш>
Dialogue: 0,0:05:51.36,0:05:53.30,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:51.36,0:05:53.30,Default,,0000,0000,0000,,Иә Маруко
Dialogue: 0,0:05:53.30,0:05:58.24,Default,,0000,0000,0000,,Уау, бұл омлет!
Dialogue: 0,0:05:53.30,0:05:58.24,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:05:53.30,0:05:58.24,Rubi,,0000,0000,0000,,Engi
Dialogue: 0,0:05:53.30,0:05:58.24,Default,,0000,0000,0000,,Таң сәтті болсын
Dialogue: 0,0:05:58.24,0:06:01.37,Rubi,,0000,0000,0000,,Engi
Dialogue: 0,0:05:58.24,0:06:01.37,Default,,0000,0000,0000,,Қайырлы шыққан тегі маңызды емес.
Dialogue: 0,0:05:58.24,0:06:01.37,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:06:01.37,0:06:02.87,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:06:01.37,0:06:02.87,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:06:02.87,0:06:06.38,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:06:02.87,0:06:06.38,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:02.87,0:06:06.38,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:06:02.87,0:06:06.38,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:02.87,0:06:06.38,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:06:02.87,0:06:06.38,Default,,0000,0000,0000,,Маруко, ерте емес пе?
Dialogue: 0,0:06:06.38,0:06:08.31,Default,,0000,0000,0000,,Әже әже
Dialogue: 0,0:06:06.38,0:06:08.31,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:06:08.31,0:06:09.88,Default,,0000,0000,0000,,Хаха~
Dialogue: 0,0:06:09.88,0:06:14.75,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:09.88,0:06:14.75,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:06:09.88,0:06:14.75,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:06:09.88,0:06:14.75,Default,,0000,0000,0000,,Маруко оянғанша
Dialogue: 0,0:06:09.88,0:06:14.75,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:06:09.88,0:06:14.75,Default,,0000,0000,0000,,Оян, Кувабара, Кувабара
Dialogue: 0,0:06:14.75,0:06:17.25,Default,,0000,0000,0000,,Яна, бұл ата.
Dialogue: 0,0:06:18.39,0:06:20.89,Default,,0000,0000,0000,,<Әдеттегі Мару-чаннан
Dialogue: 0,0:06:18.39,0:06:20.89,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:06:18.39,0:06:20.89,Default,,0000,0000,0000,,Ойламау
Dialogue: 0,0:06:20.89,0:06:23.39,Rubi,,0000,0000,0000,,Юга
Dialogue: 0,0:06:20.89,0:06:23.39,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:06:20.89,0:06:23.39,Rubi,,0000,0000,0000,,Фукэй
Dialogue: 0,0:06:20.89,0:06:23.39,Default,,0000,0000,0000,,Таңертеңгілік әсем көрініс＞
