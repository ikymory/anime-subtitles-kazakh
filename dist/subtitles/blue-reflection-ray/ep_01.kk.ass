Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:28.58,0:00:30.21,Default,,0,0,0,,Ойлары біртүрлі
Dialogue: 0,0:00:31.92,0:00:33.42,Default,,0,0,0,,Бұйраланған
Dialogue: 0,0:00:35.09,0:00:36.30,Default,,0,0,0,,Нүкте
Dialogue: 0,0:00:38.30,0:00:40.51,Default,,0,0,0,,Жүрегімде болса да
Dialogue: 0,0:00:41.18,0:00:43.05,Default,,0,0,0,,Мен оған тиісе алмаймын
Dialogue: 0,0:00:49.85,0:00:52.06,Default,,0,0,0,,Ол соңғы түпнұсқа түр
Dialogue: 0,0:00:58.44,0:00:59.32,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:00:59.53,0:01:01.61,Default,,0,0,0,,Жоқ, мен уақытында үлгермеймін.
Dialogue: 0,0:01:01.82,0:01:02.66,Default,,0,0,0,,біздің орнымыз ба?
Dialogue: 0,0:01:03.16,0:01:05.45,Default,,0,0,0,,Сол балаларға сенейік
Dialogue: 0,0:01:06.16,0:01:10.28,Default,,0,0,0,,Менен гөрі мен туралы көбірек ойлайтыныңызға сенімдімін
Dialogue: 0,0:01:10.91,0:01:12.41,Default,,0,0,0,,Мен солай сезінемін
Dialogue: 0,0:01:14.17,0:01:16.75,Default,,0,0,0,,Сөзбен жеткізу қиын
Dialogue: 0,0:01:17.25,0:01:18.25,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:01:19.34,0:01:21.42,Default,,0,0,0,,Мен өзім бола алдым
Dialogue: 0,0:01:24.51,0:01:25.93,Default,,0,0,0,,Кеш болды
Dialogue: 0,0:01:28.89,0:01:30.98,Default,,0,0,0,,Себебі менің әпкем сонда болды
Dialogue: 0,0:01:33.77,0:01:34.81,Default,,0,0,0,,Олай емес сияқты.
Dialogue: 0,0:01:34.94,0:01:35.81,Default,,0,0,0,,Не болды?
Dialogue: 0,0:01:36.36,0:01:38.86,Default,,0,0,0,,Мен қателестім
Dialogue: 0,0:01:40.47,0:01:45.36,Default,,0,0,0,,Мен енді не істерімді білмеймін
Dialogue: 0,0:01:56.88,0:02:01.30,Default,,0,0,0,,Өйткені сен менің ойымды бағаладың
Dialogue: 0,0:02:02.17,0:02:03.72,Default,,0,0,0,,Сәлем әпке
Dialogue: 0,0:02:04.68,0:02:06.18,Default,,0,0,0,,Мен де...
Dialogue: 0,0:03:04.49,0:03:05.44,Default,,0,0,0,,Қар
Dialogue: 0,0:03:07.11,0:03:10.57,Default,,0,0,0,,Келесіде Цукиномия Цукиномия
Dialogue: 0,0:03:12.03,0:03:13.62,Default,,0,0,0,,Бұл қалай болуы мүмкін?
Dialogue: 0,0:03:23.92,0:03:25.01,Default,,0,0,0,,Студентті ауыстыру
Dialogue: 0,0:03:25.71,0:03:27.26,Default,,0,0,0,,Осындай уақытта?
Dialogue: 0,0:03:27.72,0:03:30.34,Default,,0,0,0,,Сіздің ата-анаңыз күтпеген жерден шетелге жіберілетін сияқты.
Dialogue: 0,0:03:31.14,0:03:33.18,Default,,0,0,0,,Сакурай Йо ақыры серіктес тапты
Dialogue: 0,0:03:33.35,0:03:36.89,Default,,0,0,0,,Егер есімде дұрыс болса, Хирахара мырза үйіне кетті.
Dialogue: 0,0:03:35.93,0:03:36.85,Default,,0,0,0,,Ал...
Dialogue: 0,0:03:37.43,0:03:39.06,Default,,0,0,0,,Эй, бұл Ханари-сан, солай ма?
Dialogue: 0,0:03:39.27,0:03:40.44,Default,,0,0,0,,Рука Ханари
Dialogue: 0,0:03:42.48,0:03:43.27,Default,,0,0,0,,Иә
Dialogue: 0,0:03:46.07,0:03:49.15,Default,,0,0,0,,Біріншіден, бұл А ғимараты және тағы екі ғимарат бар.
Dialogue: 0,0:03:49.15,0:03:51.03,Default,,0,0,0,,Әрқайсысының ортасында
Dialogue: 0,0:03:51.87,0:03:53.20,Default,,0,0,0,,Бірінші қабаттағы асхана
Dialogue: 0,0:03:54.54,0:03:56.07,Default,,0,0,0,,Екінші қабаттағы үлкен қоғамдық монша
Dialogue: 0,0:03:56.41,0:03:58.29,Default,,0,0,0,,22.00-ге дейін шомылуға рұқсат етіледі.
Dialogue: 0,0:03:59.57,0:04:01.08,Default,,0,0,0,,Бірінші келген, бірінші қызмет етеді.
Dialogue: 0,0:04:03.29,0:04:04.63,Default,,0,0,0,,Бұл жалпы бөлме
Dialogue: 0,0:04:04.80,0:04:06.96,Default,,0,0,0,,Теледидар әрқашан дау-дамай.
Dialogue: 0,0:04:07.05,0:04:10.09,Default,,0,0,0,,Сондай-ақ, жалпы ереже бойынша, коменданттық сағат кешкі 19.00.
Dialogue: 0,0:04:10.30,0:04:13.26,Default,,0,0,0,,Кешігіп қалсаңыз, жатақхана меңгерушісі жын шығады.
Dialogue: 0,0:04:14.56,0:04:17.01,Default,,0,0,0,,Дұрыс, сенің бұрынғы мектебің қайда болды?
Dialogue: 0,0:04:16.56,0:04:17.18,Default,,0,0,0,,Біз кесіп өтетін нәрсе – ақымақтық сызығы
Dialogue: 0,0:04:18.73,0:04:20.23,Default,,0,0,0,,Менің бөлмем қандай?
Dialogue: 0,0:04:47.09,0:04:48.30,Default,,0,0,0,,Сәтсіз аяқталды.
Dialogue: 0,0:04:57.43,0:04:58.72,Default,,0,0,0,,Бұл Рука Ханари.
Dialogue: 0,0:05:01.69,0:05:03.15,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:05:04.81,0:05:06.61,Default,,0,0,0,,Танысқаныма қуаныштымын, Ханари мырза
Dialogue: 0,0:05:06.61,0:05:07.52,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:05:08.44,0:05:09.40,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:05:09.53,0:05:11.65,Default,,0,0,0,,Түсінбеген нәрсені сұраңыз.
Dialogue: 0,0:05:13.36,0:05:14.03,Default,,0,0,0,,Иә
Dialogue: 0,0:05:14.03,0:05:15.53,Default,,0,0,0,,Эй, мен үйірме жұмысын шештім.
Dialogue: 0,0:05:18.83,0:05:20.25,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:20.79,0:05:23.04,Default,,0,0,0,,Сіз бұрынғы мектебіңізде қандай бөлімде оқыдыңыз?
Dialogue: 0,0:05:26.50,0:05:29.42,Default,,0,0,0,,Мен Канамен байланысу мүмкін емес деп естідім.
Dialogue: 0,0:05:30.42,0:05:32.22,Default,,0,0,0,,Ол көрші сыныптан.
Dialogue: 0,0:05:32.26,0:05:34.13,Default,,0,0,0,,Ол тіпті үйге де кеткен жоқ.
Dialogue: 0,0:05:34.38,0:05:36.35,Default,,0,0,0,,Сен бәрібір үйден қашып жүрген жоқсың ба?
Dialogue: 0,0:05:37.30,0:05:39.43,Default,,0,0,0,,Менің де бір жерге қашып кеткім келеді.
Dialogue: 0,0:05:39.56,0:05:42.60,Default,,0,0,0,,Менің ата-анам да өте жақсы оқиды.
Dialogue: 0,0:05:42.94,0:05:43.85,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:46.36,0:05:46.98,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:05:47.44,0:05:49.73,Default,,0,0,0,,Тағы да.
Dialogue: 0,0:05:49.73,0:05:51.61,Default,,0,0,0,,Елорда білмейді.
Dialogue: 0,0:05:51.65,0:05:52.69,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:05:53.86,0:05:56.15,Default,,0,0,0,,Айтайын дегенім, біз басқа деңгейдеміз.
Dialogue: 0,0:05:56.15,0:05:57.65,Default,,0,0,0,,Осы және т.б
Dialogue: 0,0:05:57.65,0:05:58.12,Default,,0,0,0,,Жер
Dialogue: 0,0:05:58.24,0:06:00.37,Default,,0,0,0,,Жақсы, қымбат емес пе?
Dialogue: 0,0:06:00.62,0:06:01.58,Default,,0,0,0,,Мақсат ақыл-есі бар сияқты,
Dialogue: 0,0:06:01.79,0:06:06.17,Default,,0,0,0,,Егер мен қалаған нәрсені сатып алсам, ата-ананы тітіркендіретін шығармын.
Dialogue: 0,0:06:06.25,0:06:09.17,Default,,0,0,0,,Мен де астанада дүниеге келсем ғой.
Dialogue: 0,0:06:12.42,0:06:15.93,Default,,0,0,0,,Эй, мен саған қарап тұрмын.
Dialogue: 0,0:06:20.01,0:06:20.85,Default,,0,0,0,,Не?
Dialogue: 0,0:06:26.31,0:06:28.52,Default,,0,0,0,,Өтірік Мен ашуланбаймын.
Dialogue: 0,0:06:28.69,0:06:29.82,Default,,0,0,0,,Бұл таң қалдырады
Dialogue: 0,0:06:32.07,0:06:33.19,Default,,0,0,0,,Бұл жаман болды.
Dialogue: 0,0:06:41.54,0:06:42.87,Default,,0,0,0,,Сондай-ақ сәтсіз аяқталды
Dialogue: 0,0:07:17.53,0:07:18.82,Default,,0,0,0,,Не өзгерді
Dialogue: 0,0:07:20.82,0:07:22.74,Default,,0,0,0,,Досың үйден қашып кетті ме?
Dialogue: 0,0:07:22.91,0:07:24.54,Default,,0,0,0,,Бұл жиі болады.
Dialogue: 0,0:07:24.87,0:07:25.79,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:07:26.96,0:07:28.08,Default,,0,0,0,,Сонымен қатар...
Dialogue: 0,0:07:28.42,0:07:30.25,Default,,0,0,0,,Кешіріңіз, бұл менің жігітімнен.
Dialogue: 0,0:07:31.34,0:07:32.79,Default,,0,0,0,,Ма-кун қазір
Dialogue: 0,0:07:32.79,0:07:33.30,Default,,0,0,0,,Жер
Dialogue: 0,0:07:33.30,0:07:34.59,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:07:39.13,0:07:42.51,Default,,0,0,0,,Менің толық емес жұмыс уақытым ғана қысқартылды.
Dialogue: 0,0:07:46.73,0:07:50.06,Default,,0,0,0,,Мен фрагментте біртүрлі нәрсе бар екенін түсіндім.
Dialogue: 0,0:07:50.40,0:07:52.65,Default,,0,0,0,,Оны табу тым мүмкін емес...
Dialogue: 0,0:07:53.32,0:07:54.73,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:07:59.45,0:08:01.99,Default,,0,0,0,,Әлі де жанашырлар бар
Dialogue: 0,0:08:10.46,0:08:11.63,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:12.13,0:08:14.17,Default,,0,0,0,,Егер бірдеңе болса, мен сізге дереу хабарласамын.
Dialogue: 0,0:08:18.42,0:08:21.22,Default,,0,0,0,,Мен толық емес жұмыс күнін қабылдадым, өйткені бұл жақсы келісім болды.
Dialogue: 0,0:08:21.47,0:08:23.93,Default,,0,0,0,,Бұл бір нәрсе ме?
Dialogue: 0,0:08:24.43,0:08:26.60,Default,,0,0,0,,Біртүрлі нәрсе болып жатыр.
Dialogue: 0,0:08:35.48,0:08:38.32,Default,,0,0,0,,Бұл әлі де өмір сүру қиын дүние.
Dialogue: 0,0:08:43.90,0:08:45.28,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:51.16,0:08:52.67,Default,,0,0,0,,Иә? Сіз...
Dialogue: 0,0:08:58.96,0:09:02.13,Default,,0,0,0,,Не? Тағы бірдеңе болып жатыр
Dialogue: 0,0:09:03.64,0:09:04.85,Default,,0,0,0,,Оны ауыстыруым керек пе?
Dialogue: 0,0:09:06.76,0:09:09.31,Default,,0,0,0,,...сол жағдай
Dialogue: 0,0:09:10.06,0:09:12.02,Default,,0,0,0,,Досың жақсы
Dialogue: 0,0:09:15.19,0:09:19.99,Default,,0,0,0,,Қымбат заттарды сатып алатынымды мақтады.
Dialogue: 0,0:09:21.61,0:09:23.74,Default,,0,0,0,,Мен таңдаған сүйкімділік емес
Dialogue: 0,0:09:25.74,0:09:27.49,Default,,0,0,0,,Менде де көп нәрсе бар.
Dialogue: 0,0:09:31.66,0:09:33.25,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:09:40.92,0:09:42.55,Default,,0,0,0,,Дәл сол жерден
Dialogue: 0,0:09:45.76,0:09:46.76,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:48.47,0:09:49.06,Default,,0,0,0,,Иә
Dialogue: 0,0:09:49.35,0:09:50.27,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:51.43,0:09:53.81,Default,,0,0,0,,Өкінішті, асығыңыз.
Dialogue: 0,0:09:55.90,0:09:57.81,Default,,0,0,0,,Мм... жоғалған зат
Dialogue: 0,0:10:00.23,0:10:01.69,Default,,0,0,0,,Сол сақина...
Dialogue: 0,0:10:26.18,0:10:28.18,Default,,0,0,0,,｢Көк рефлексия｣
Dialogue: 0,0:10:39.77,0:10:40.86,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:10:41.07,0:10:43.03,Default,,0,0,0,,Маған кубокты қайтадан көрсету керек.
Dialogue: 0,0:10:43.86,0:10:47.74,Default,,0,0,0,,Сен шынымен менің мақтаныш ұлымсың.
Dialogue: 0,0:10:53.70,0:10:55.46,Default,,0,0,0,,Қайғылы түс
Dialogue: 0,0:11:01.67,0:11:02.34,Default,,0,0,0,,Кеттік
Dialogue: 0,0:11:02.67,0:11:03.84,Default,,0,0,0,,Иә
Dialogue: 0,0:11:04.92,0:11:06.38,Default,,0,0,0,,Әй, эй, Сенпай
Dialogue: 0,0:11:06.76,0:11:10.43,Default,,0,0,0,,Келесі гүл маған қалмайды.
Dialogue: 0,0:11:10.89,0:11:14.89,Default,,0,0,0,,Мен сізге көп көңіл бөлемін.
Dialogue: 0,0:11:30.82,0:11:32.41,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:11:33.91,0:11:35.91,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:11:40.13,0:11:41.96,Default,,0,0,0,,Мен әлі де...
Dialogue: 0,0:11:46.21,0:11:48.88,Default,,0,0,0,,Иә? Бұл бөлме.
Dialogue: 0,0:11:58.35,0:12:00.06,Default,,0,0,0,,Бір жерде кездескен
Dialogue: 0,0:12:04.52,0:12:05.69,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:12:06.15,0:12:06.99,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:18.00,0:12:19.58,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:12:29.80,0:12:31.59,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:32.80,0:12:33.76,Default,,0,0,0,,Йо Сакурай
Dialogue: 0,0:12:33.76,0:12:34.80,Default,,0,0,0,,Хирахара мырза
Dialogue: 0,0:12:35.14,0:12:38.31,Default,,0,0,0,,Жоқ, алаңдаушылық үшін кешіріңіз.
Dialogue: 0,0:12:39.10,0:12:41.94,Default,,0,0,0,,Мен кенет үзіліс жасаймын.
Dialogue: 0,0:12:41.98,0:12:43.31,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:12:43.52,0:12:45.32,Default,,0,0,0,,Қазір үй жақсы ма?
Dialogue: 0,0:12:47.03,0:12:48.07,Default,,0,0,0,,Иә, менде бәрі жақсы.
Dialogue: 0,0:12:48.28,0:12:50.95,Default,,0,0,0,,Бірақ жатақхана меңгерушісі маған қатты ашуланды.
Dialogue: 0,0:12:51.28,0:12:54.41,Default,,0,0,0,,Жатақхана ережелері Сыртқа шығуға қатысты 4-бөлім
Dialogue: 0,0:12:55.95,0:12:59.45,Default,,0,0,0,,19:00 коменданттық сағатқа дейін жатақханаға оралуды ұмытпаңыз.
Dialogue: 0,0:13:00.25,0:13:02.33,Default,,0,0,0,,Кіреберістен
Dialogue: 0,0:13:02.87,0:13:05.42,Default,,0,0,0,,Жоқ, сіз терезе арқылы кері өтуіңіз керек.
Dialogue: 0,0:13:05.42,0:13:06.63,Default,,0,0,0,,Мен біраз қобалжып барамын.
Dialogue: 0,0:13:08.09,0:13:08.71,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:08.88,0:13:10.67,Default,,0,0,0,,Демалу кезіндегі ескертпелер
Dialogue: 0,0:13:11.42,0:13:12.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:12.51,0:13:15.35,Default,,0,0,0,,Жатақхана туралы айтатын болсам, онда бәрі жақсы.
Dialogue: 0,0:13:16.18,0:13:17.18,Default,,0,0,0,,Сол жерде ме?
Dialogue: 0,0:13:17.68,0:13:19.81,Default,,0,0,0,,Тапсырыс беру уақыты келді емес пе?
Dialogue: 0,0:13:20.06,0:13:21.43,Default,,0,0,0,,Жіберу?
Dialogue: 0,0:13:23.73,0:13:24.69,Default,,0,0,0,,Рука-чан
Dialogue: 0,0:13:25.36,0:13:26.06,Default,,0,0,0,,Жер
Dialogue: 0,0:13:27.69,0:13:28.98,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:13:29.19,0:13:31.36,Default,,0,0,0,,I Хирахара Йосакури
Dialogue: 0,0:13:32.99,0:13:33.95,Default,,0,0,0,,Соңғы үш күнде, әдеттегідей, әр түнде түн ортасынан кейін бір бет.
Dialogue: 0,0:13:34.41,0:13:35.57,Default,,0,0,0,,Рука-чан
Dialogue: 0,0:13:36.49,0:13:38.41,Default,,0,0,0,,Біз білмей тұрып, дос болып кеттік.
Dialogue: 0,0:13:38.54,0:13:40.75,Default,,0,0,0,,Менің ойымша, біз оны тек екеуміз уақытында жасай аламыз.
Dialogue: 0,0:13:40.83,0:13:41.54,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:41.54,0:13:42.21,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:44.17,0:13:45.08,Default,,0,0,0,,Рука-чан
Dialogue: 0,0:13:45.46,0:13:47.96,Default,,0,0,0,,Менімен постерде жұмыс
Dialogue: 0,0:13:49.13,0:13:49.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:52.84,0:13:54.55,Default,,0,0,0,,Танабата фестивалі?
Dialogue: 0,0:13:55.05,0:13:57.51,Default,,0,0,0,,Қыздар жатақханасында жыл сайын өтетін шара.
Dialogue: 0,0:13:58.10,0:13:59.06,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:13:59.56,0:14:00.68,Default,,0,0,0,,Постер ұсынысы
Dialogue: 0,0:14:01.14,0:14:04.81,Default,,0,0,0,,Мен бұл туралы ойлануға тырыстым, бірақ мен ештеңе таба алмадым.
Dialogue: 0,0:14:07.06,0:14:07.77,Default,,0,0,0,,...
Dialogue: 0,0:14:20.54,0:14:22.33,Default,,0,0,0,,Мм, Рука-чан...
Dialogue: 0,0:14:23.37,0:14:25.46,Default,,0,0,0,,Өтірік Мен ашуланбаймын.
Dialogue: 0,0:14:25.79,0:14:27.42,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:14:29.88,0:14:31.76,Default,,0,0,0,,Рука-чан керемет
Dialogue: 0,0:14:32.13,0:14:33.67,Default,,0,0,0,,Сіз мұндай нәрсеге жақсысыз ба?
Dialogue: 0,0:14:36.18,0:14:39.18,Default,,0,0,0,,Содан кейін мен қандай сурет саламын деп ойланамын.
Dialogue: 0,0:14:40.35,0:14:41.01,Default,,0,0,0,,Иә
Dialogue: 0,0:14:42.02,0:14:43.60,Default,,0,0,0,,Өйткені бұл Танабата...
Dialogue: 0,0:14:48.77,0:14:50.61,Default,,0,0,0,,Бүгінгі күннің бәрі осы.
Dialogue: 0,0:14:50.73,0:14:51.90,Default,,0,0,0,,Менің асқазаным азайып кетті.
Dialogue: 0,0:14:52.23,0:14:53.15,Default,,0,0,0,,Олай болса
Dialogue: 0,0:14:53.23,0:14:55.15,Default,,0,0,0,,Иә, жатақханаға қайтайық.
Dialogue: 0,0:14:56.28,0:14:58.24,Default,,0,0,0,,Мен бүгін кешкі асқа не ішеміз деп ойлаймын.
Dialogue: 0,0:14:58.57,0:15:00.91,Default,,0,0,0,,Иә, бірге болжам жасайық.
Dialogue: 0,0:15:01.74,0:15:04.08,Default,,0,0,0,,Өйткені кеше менде балық болды...
Dialogue: 0,0:15:07.42,0:15:09.50,Default,,0,0,0,,Эй, Рука-чанның болжамы қандай?
Dialogue: 0,0:15:20.10,0:15:21.30,Default,,0,0,0,,Рука-чан
Dialogue: 0,0:15:21.93,0:15:23.89,Default,,0,0,0,,Көзіне кір кіргенін айтты.
Dialogue: 0,0:15:24.14,0:15:25.60,Default,,0,0,0,,Менде айна бар
Dialogue: 0,0:15:31.61,0:15:33.07,Default,,0,0,0,,Бұл дәмді
Dialogue: 0,0:15:33.57,0:15:34.90,Default,,0,0,0,,Сол себепті Рука-чан
Dialogue: 0,0:15:34.90,0:15:35.53,Default,,0,0,0,,Бұрынғы...
Dialogue: 0,0:15:36.90,0:15:38.24,Default,,0,0,0,,Мен үшін бөтен адамсың, солай ма?
Dialogue: 0,0:15:38.82,0:15:39.82,Default,,0,0,0,,Дегенмен...
Dialogue: 0,0:15:39.91,0:15:41.24,Default,,0,0,0,,Неге мені шақырдың?
Dialogue: 0,0:15:43.41,0:15:44.91,Default,,0,0,0,,Мен ештеңе білмесем де
Dialogue: 0,0:15:46.20,0:15:47.96,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:15:48.58,0:15:49.58,Default,,0,0,0,,Рука-чан...
Dialogue: 0,0:15:50.83,0:15:54.38,Default,,0,0,0,,Иә...Иә~ білмеймін.
Dialogue: 0,0:15:55.42,0:15:58.80,Default,,0,0,0,,Өйткені ол баланың сезімі сол балаға ғана тән.
Dialogue: 0,0:16:02.05,0:16:02.93,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:03.39,0:16:05.68,Default,,0,0,0,,Өйткені біз бірге ойлай аламыз
Dialogue: 0,0:16:06.39,0:16:08.02,Default,,0,0,0,,Мен мұны істегім келеді
Dialogue: 0,0:16:09.44,0:16:12.90,Default,,0,0,0,,Өйткені мен көптен бері осылай істеп келемін.
Dialogue: 0,0:16:13.98,0:16:14.73,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:16.44,0:16:17.61,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:16:23.07,0:16:24.95,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:16:29.12,0:16:31.21,Default,,0,0,0,,Оны таптым
Dialogue: 0,0:16:32.08,0:16:32.79,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:37.59,0:16:38.46,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:16:41.93,0:16:42.59,Default,,0,0,0,,Біраз
Dialogue: 0,0:16:45.31,0:16:47.02,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:16:50.60,0:16:51.31,Default,,0,0,0,,Бұл көп уақытты алады
Dialogue: 0,0:16:53.48,0:16:55.69,Default,,0,0,0,,Маған бұл ұнайды.
Dialogue: 0,0:16:58.53,0:16:59.69,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:00.36,0:17:04.53,Default,,0,0,0,,Мен сіздің барлық қорқыныштарыңызды ақырын алып тастаймын.
Dialogue: 0,0:17:09.07,0:17:10.86,Default,,0,0,0,,Біраз уақыттан бері...
Dialogue: 0,0:17:11.04,0:17:12.21,Default,,0,0,0,,Рука-чан бұл
Dialogue: 0,0:17:27.31,0:17:28.60,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:17:31.56,0:17:32.98,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:17:33.60,0:17:35.69,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:17:36.44,0:17:38.52,Default,,0,0,0,,Бұл мүмкіндік болса да, мен ақырында ұстап алдым
Dialogue: 0,0:17:45.28,0:17:47.03,Default,,0,0,0,,Секіру ауқымы іске қосылды
Dialogue: 0,0:17:48.37,0:17:49.04,Default,,0,0,0,,Орналасқан жері...
Dialogue: 0,0:17:53.75,0:17:54.54,Default,,0,0,0,,Жабу
Dialogue: 0,0:18:06.09,0:18:07.22,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:07.72,0:18:09.51,Default,,0,0,0,,Неге біз ғана?
Dialogue: 0,0:18:10.85,0:18:12.10,Default,,0,0,0,,Жоқ, вокзалдың алдында түсіріп кетсеңіз жеткілікті.
Dialogue: 0,0:18:13.56,0:18:14.44,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:18:20.48,0:18:21.61,Default,,0,0,0,,Сақина?
Dialogue: 0,0:18:25.82,0:18:27.57,Default,,0,0,0,,Сіздікі не?
Dialogue: 0,0:18:28.91,0:18:29.58,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:30.20,0:18:33.62,Default,,0,0,0,,Одан асып кету жақсы емес.
Dialogue: 0,0:18:34.29,0:18:35.50,Default,,0,0,0,,Біреуге қоңырау шалыңыз
Dialogue: 0,0:18:35.96,0:18:37.79,Default,,0,0,0,,Жоқ, мен кетуім керек.
Dialogue: 0,0:18:38.00,0:18:40.30,Default,,0,0,0,,Мен сізді естимін, маған көмектесіңізші.
Dialogue: 0,0:18:41.00,0:18:42.76,Default,,0,0,0,,Мен ештеңе естімеймін
Dialogue: 0,0:18:43.17,0:18:45.43,Default,,0,0,0,,Мен де солай сезінемін
Dialogue: 0,0:18:47.51,0:18:49.43,Default,,0,0,0,,Мұң жетерлік
Dialogue: 0,0:18:51.51,0:18:52.89,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын
Dialogue: 0,0:18:59.06,0:18:59.73,Default,,0,0,0,,Дегенмен, сол бір қадам біз, адамзат үшін, үлкен ілгерілеу болар еді.
Dialogue: 0,0:19:11.66,0:19:13.95,Default,,0,0,0,,Сіз өте адал және сүйкімдісіз.
Dialogue: 0,0:19:28.55,0:19:31.18,Default,,0,0,0,,Адам қалай қозғала алады?
Dialogue: 0,0:19:44.61,0:19:46.24,Default,,0,0,0,,Жаңа рефлектор?
Dialogue: 0,0:19:47.99,0:19:48.95,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:19:49.61,0:19:52.08,Default,,0,0,0,,Үлкендерің саған ұрысады.
Dialogue: 0,0:20:00.58,0:20:01.17,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:15.52,0:20:16.35,Default,,0,0,0,,Боқ...
Dialogue: 0,0:20:23.36,0:20:24.36,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:20:27.74,0:20:29.32,Default,,0,0,0,,Менің ойым
Dialogue: 0,0:20:30.20,0:20:34.37,Default,,0,0,0,,Сіз көмектесе алатыныңызға сенімдімін.
Dialogue: 0,0:20:36.83,0:20:38.91,Default,,0,0,0,,Кім? Дауыс...
Dialogue: 0,0:20:45.80,0:20:46.50,Default,,0,0,0,,Пайдасы жоқ. Бәрі бітті.
Dialogue: 0,0:20:49.34,0:20:50.22,Default,,0,0,0,,Мен көмектескім келеді
Dialogue: 0,0:20:51.59,0:20:53.01,Default,,0,0,0,,Өз ойларыңызға сеніңіз
Dialogue: 0,0:20:55.51,0:20:56.35,Default,,0,0,0,,Бұл жарық ше?
Dialogue: 0,0:21:22.00,0:21:23.25,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:34.59,0:21:36.18,Default,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,0:21:48.61,0:21:50.19,Default,,0,0,0,,Ойлары біртүрлі
Dialogue: 0,0:21:51.19,0:21:52.61,Default,,0,0,0,,Бүктелген
Dialogue: 0,0:21:52.99,0:21:54.07,Default,,0,0,0,,Нүкте
Dialogue: 0,0:21:54.99,0:21:57.20,Default,,0,0,0,,Жүрегімде болса да
Dialogue: 0,0:21:57.95,0:21:59.62,Default,,0,0,0,,Сіз оны ұстай алмайсыз
Dialogue: 0,0:22:00.33,0:22:01.20,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:24:00.20,0:24:01.82,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:24:11.54,0:24:13.38,Default,,0,0,0,,Менің жалғыз әпкем
Dialogue: 0,0:24:21.09,0:24:22.18,Default,,0,0,0,,Рефлектор?
Dialogue: 0,0:24:22.18,0:24:25.43,Default,,0,0,0,,Ойлар, кез келген ойлар күшке айнала алады ма?
Dialogue: 0,0:24:25.43,0:24:26.72,Default,,0,0,0,,Қалыптырақ ойлаңыз
Dialogue: 0,0:24:26.72,0:24:28.68,Default,,0,0,0,,Сіздің ойыңызға біртүрлі нәрсе болды ма?
Dialogue: 0,0:24:28.68,0:24:29.39,Default,,0,0,0,,Бұл...
Dialogue: 0,0:24:29.48,0:24:31.06,Default,,0,0,0,,Маңызды емес заттар
Dialogue: 0,0:24:31.60,0:24:33.44,Default,,0,0,0,,Тіпті менде де бар.
Dialogue: 0,0:24:34.94,0:24:40.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
