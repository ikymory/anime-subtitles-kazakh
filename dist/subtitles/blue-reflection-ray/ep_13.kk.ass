Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.53,0:01:39.27,Default,,0,0,0,,≪Ойыңызға қалай қол тигізе аласыз?➡
Dialogue: 0,0:01:39.27,0:01:41.30,Default,,0,0,0,,Менің ойымша, бұл мүмкін емес≫
Dialogue: 0,0:01:41.30,0:01:43.90,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:43.90,0:01:48.91,Default,,0,0,0,,≪Неге мен оны жоғалтқаннан кейін байқаймын?≫
Dialogue: 0,0:01:48.91,0:01:51.91,Default,,0,0,0,,≪Егер ол уақыт...≫ (Шино) ≪Сол күні...≫
Dialogue: 0,0:01:51.91,0:01:54.38,Default,,0,0,0,,≪Егер мен сол дауысты байқасам≫
Dialogue: 0,0:01:54.38,0:01:57.22,Default,,0,0,0,,≪Егер мен сізге айтқан болсам≫
Dialogue: 0,0:01:57.22,0:01:59.42,Default,,0,0,0,,≪Бір нәрсе басқаша ма? ≫
Dialogue: 0,0:02:03.06,0:02:23.08,Default,,0,0,0,,♬～
Dialogue: 0,0:02:23.08,0:02:41.50,Default,,0,0,0,,♬～
Dialogue: 0,0:02:41.50,0:02:44.90,Default,,0,0,0,,♬～
Dialogue: 0,0:02:44.90,0:03:03.95,Default,,0,0,0,,♬～
Dialogue: 0,0:03:03.95,0:03:15.75,Default,,0,0,0,,♬～
Dialogue: 0,0:03:17.23,0:03:20.73,Default,,0,0,0,,♬～
Dialogue: 0,0:03:20.73,0:03:31.73,Default,,0,0,0,,♬～
Dialogue: 0,0:03:32.91,0:03:36.91,Default,,0,0,0,,Орташа мин....(цикаданың айқайы)
Dialogue: 0,0:03:40.12,0:03:42.69,Default,,0,0,0,,Жарайды, мен барайын...
Dialogue: 0,0:03:42.69,0:03:45.66,Default,,0,0,0,,Жатақхана директоры?
Dialogue: 0,0:03:45.66,0:03:47.70,Default,,0,0,0,,Есікті құлыптаңыз. Өрттен кейін тазалаңыз.➡
Dialogue: 0,0:03:47.70,0:03:51.70,Default,,0,0,0,,Жатақханадағы ананы мазаламау. Тәттілерді қалыпты мөлшерде жеңіз.
Dialogue: 0,0:03:51.70,0:03:54.30,Default,,0,0,0,,Сондай-ақ, айтуды ұмытып кетіппін... Ах~ Иә, иә!
Dialogue: 0,0:03:54.30,0:03:57.27,Default,,0,0,0,,Мен түсіндім. (Рука Ханари) Өтінемін тез кет.
Dialogue: 0,0:03:57.27,0:04:00.64,Default,,0,0,0,,Тәу-тәу! (Шырылдау)
Dialogue: 0,0:04:00.64,0:04:04.18,Default,,0,0,0,,Жарайды, Ширакаба мырза келді, жарайды.
Dialogue: 0,0:04:04.18,0:04:06.21,Default,,0,0,0,,Иә
Dialogue: 0,0:04:06.21,0:04:09.95,Default,,0,0,0,,♬～
Dialogue: 0,0:04:09.95,0:04:13.35,Default,,0,0,0,,Екеуі жатақхана директоры мен сенің анаң бір-біріне ұқсайды.
Dialogue: 0,0:04:13.35,0:04:15.35,Default,,0,0,0,,Көзілдірік сияқты
Dialogue: 0,0:04:16.89,0:04:18.93,Default,,0,0,0,,Иә! Хехехе!
Dialogue: 0,0:04:18.93,0:04:22.86,Default,,0,0,0,,♬～
Dialogue: 0,0:04:22.86,0:04:25.40,Default,,0,0,0,,Дұрыс, бүгін кешкі асқа не жеу керек?
Dialogue: 0,0:04:25.40,0:04:27.74,Default,,0,0,0,,Банк…
Dialogue: 0,0:04:27.74,0:04:31.17,Default,,0,0,0,,Кешкі асқа не жеу керек? иә? Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:04:31.17,0:04:33.24,Default,,0,0,0,,Уау! Апыр-ай! Ах~!
Dialogue: 0,0:04:33.24,0:04:37.64,Default,,0,0,0,,Рука-чан, кешіріңіз! Не істеу керек? Мен орамалды бірден аламын!
Dialogue: 0,0:04:39.05,0:04:42.45,Default,,0,0,0,,Хирахара мырза. иә? Уф!
Dialogue: 0,0:04:42.45,0:04:45.19,Default,,0,0,0,,Фу. Иә...
Dialogue: 0,0:04:45.19,0:04:49.62,Default,,0,0,0,,Рука-чан, сен істедің! Ах! Тек тоқтаңыз...
Dialogue: 0,0:04:49.62,0:04:51.73,Default,,0,0,0,,Ахахха! Уф... Уау!
Dialogue: 0,0:04:51.73,0:04:55.53,Default,,0,0,0,,Канакана кана...(Үлкен арыстанның жорғалауы)
Dialogue: 0,0:05:01.34,0:05:03.40,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:05:03.40,0:05:05.41,Default,,0,0,0,,Кішкене жалғыздық
Dialogue: 0,0:05:05.41,0:05:07.51,Default,,0,0,0,,Бірақ бұл дұрыс болды.
Dialogue: 0,0:05:07.51,0:05:11.11,Default,,0,0,0,,үшін жазғы демалысқа үйлеріне қайтты.
Dialogue: 0,0:05:11.11,0:05:15.88,Default,,0,0,0,,Мен осында болсам, менің ойым кез келген уақытта бақылаудан шығып кетуі мүмкін.
Dialogue: 0,0:05:15.88,0:05:17.88,Default,,0,0,0,,Иә
Dialogue: 0,0:05:19.59,0:05:24.02,Default,,0,0,0,,≪Сол күннен бастап күнделікті өміріміз өзгерді≫
Dialogue: 0,0:05:24.02,0:05:26.59,Default,,0,0,0,,)
Dialogue: 0,0:05:26.59,0:05:29.96,Default,,0,0,0,,((Олардың арқасында ортақ ашудың кілті➡
Dialogue: 0,0:05:29.96,0:05:32.00,Default,,0,0,0,,Жақында аяқталады))
Dialogue: 0,0:05:32.00,0:05:35.80,Default,,0,0,0,,)
Dialogue: 0,0:05:35.80,0:05:38.94,Default,,0,0,0,,((Уф... Неге Йо Сакурайды көздеп отырсыз?))
Dialogue: 0,0:05:38.94,0:05:40.97,Default,,0,0,0,,)
Dialogue: 0,0:05:40.97,0:05:43.68,Default,,0,0,0,,((Егер мен дұрыс емес бұрылсам➡
Dialogue: 0,0:05:43.68,0:05:46.25,Default,,0,0,0,,Қайталанады.➡
Dialogue: 0,0:05:46.25,0:05:50.22,Default,,0,0,0,,Мен Йосакуриді өлтіремін... сол сезім! ))
Dialogue: 0,0:05:50.22,0:05:53.65,Default,,0,0,0,,) (Миген)((Кешіріңіз, Сакурай｡➡
Dialogue: 0,0:05:53.65,0:05:57.19,Default,,0,0,0,,Кешір мені)) (100)((Тоқта!))
Dialogue: 0,0:05:57.19,0:06:01.90,Default,,0,0,0,,♬～
Dialogue: 0,0:06:01.90,0:06:04.36,Default,,0,0,0,,)
Dialogue: 0,0:06:04.36,0:06:10.56,Default,,0,0,0,,)
Dialogue: 0,0:06:11.91,0:06:14.01,Default,,0,0,0,,((Мен әпкемді осылайша бұрышқа тығып алдым➡
Dialogue: 0,0:06:14.01,0:06:16.04,Default,,0,0,0,,Қиналған адам –➡
Dialogue: 0,0:06:16.04,0:06:18.91,Default,,0,0,0,,Йосакури Хирахара Бұл тек сенсің! )) ((Бишу!))
Dialogue: 0,0:06:18.91,0:06:22.38,Default,,0,0,0,,)
Dialogue: 0,0:06:22.38,0:06:25.29,Default,,0,0,0,,((білмеймін.➡
Dialogue: 0,0:06:25.29,0:06:28.72,Default,,0,0,0,,Нина-чанды қорғау туралы не ойлаймын?
Dialogue: 0,0:06:28.72,0:06:30.82,Default,,0,0,0,,Мені қорғамайсың ба? ))
Dialogue: 0,0:06:32.16,0:06:36.23,Default,,0,0,0,,≪Әркім өз сезімін қорғау үшін күресті≫
Dialogue: 0,0:06:36.23,0:06:39.33,Default,,0,0,0,,≪Ал сенің әпкең...➡
Dialogue: 0,0:06:39.33,0:06:41.33,Default,,0,0,0,,Әпкелер...≫
Dialogue: 0,0:06:43.94,0:06:45.97,Default,,0,0,0,,≪ Жоғалып кетті≫
Dialogue: 0,0:06:45.97,0:06:51.85,Default,,0,0,0,,♬～
Dialogue: 0,0:06:51.85,0:06:54.01,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:06:54.01,0:06:57.21,Default,,0,0,0,,Күлсін... Екі адам бүгін жалғыз.
Dialogue: 0,0:06:59.02,0:07:02.99,Default,,0,0,0,,≪Содан бері кеңістік-уақыттың бұрмалануы кеңейе берді➡
Dialogue: 0,0:07:02.99,0:07:06.36,Default,,0,0,0,,үшінның ойлары бақылаудан шығып жатты≫
Dialogue: 0,0:07:06.36,0:07:09.43,Default,,0,0,0,,♬～
Dialogue: 0,0:07:09.43,0:07:12.33,Default,,0,0,0,,≪Сәлем әпке➡
Dialogue: 0,0:07:12.33,0:07:14.33,Default,,0,0,0,,Қазір қайдасың? ≫
Dialogue: 0,0:07:15.74,0:07:17.77,Default,,0,0,0,,≫Сырылдау...(есік дыбысы)
Dialogue: 0,0:07:17.77,0:07:21.71,Default,,0,0,0,,Ичибан! Эй, бүгін жүзбе.
Dialogue: 0,0:07:21.71,0:07:25.71,Default,,0,0,0,,Олай болса, Синхро! Забун! (ваннаға малынған дыбыс)
Dialogue: 0,0:07:27.35,0:07:31.18,Default,,0,0,0,,Күрсін...｡ Шынымен ақымақ
Dialogue: 0,0:07:31.18,0:07:34.09,Default,,0,0,0,,Пуха! Хехе
Dialogue: 0,0:07:34.09,0:07:38.39,Default,,0,0,0,,≫Рука-чан, сен де кел~｡ ≫Тоқта... А, уже...
Dialogue: 0,0:07:38.39,0:07:40.39,Default,,0,0,0,,[TEL] (Мәнер режимі) (Мияко) Ах
Dialogue: 0,0:07:41.90,0:07:44.87,Default,,0,0,0,,[ТЕЛ] (Мияко) Ақыры қайта қоңырау шалдыңыз.➡
Dialogue: 0,0:07:44.87,0:07:47.67,Default,,0,0,0,,Мектептен кетіп қалудың себебі неде?
Dialogue: 0,0:07:47.67,0:07:49.84,Default,,0,0,0,,Мұнда да көп нәрсе болып жатыр.
Dialogue: 0,0:07:49.84,0:07:52.41,Default,,0,0,0,,[ТЕЛ] (Мияко) Ха... Жарайды.➡
Dialogue: 0,0:07:52.41,0:07:56.28,Default,,0,0,0,,Мен сізге электрондық пошта арқылы айттым.
Dialogue: 0,0:07:56.28,0:07:58.35,Default,,0,0,0,,Шино Мизусаки
Dialogue: 0,0:07:58.35,0:08:03.32,Default,,0,0,0,,Сент-Инес академиясының директорының қызы және орта мектептің үшінші курс студенті.➡
Dialogue: 0,0:08:03.32,0:08:06.72,Default,,0,0,0,,Қазіргі уақытта отбасымен байланысу мүмкін емес.➡
Dialogue: 0,0:08:06.72,0:08:10.02,Default,,0,0,0,,Қосымша ақпарат жоқ
Dialogue: 0,0:08:10.02,0:08:12.49,Default,,0,0,0,,[TEL] (рационалды) Жойылған шығар.
Dialogue: 0,0:08:12.49,0:08:16.20,Default,,0,0,0,,Бірақ қазір маңыздысы оның күші.
Dialogue: 0,0:08:16.20,0:08:21.03,Default,,0,0,0,,Сыртқы түрінің өзгеруі. Бұл қуаттың ілеспе өсуі ме?
Dialogue: 0,0:08:21.03,0:08:24.07,Default,,0,0,0,,Әңгімені тыңдағанша біз және Көк рефлексия➡
Dialogue: 0,0:08:24.07,0:08:26.67,Default,,0,0,0,,Олардың шығу тегі бір сияқты➡
Dialogue: 0,0:08:26.67,0:08:30.28,Default,,0,0,0,,[ТЕЛ] Біріншіден, оларды қоректендіретін күш әртүрлі.➡
Dialogue: 0,0:08:30.28,0:08:33.91,Default,,0,0,0,,Бұл жай ғана қатенің пайда болуына байланысты болса жақсы болар еді➡
Dialogue: 0,0:08:33.91,0:08:38.49,Default,,0,0,0,,Мен олардағы сақиналардың бар екенін түсіндіре алмаймын.
Dialogue: 0,0:08:38.49,0:08:40.79,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:08:40.79,0:08:44.12,Default,,0,0,0,,[TEL] (Рационалды) Бұл не? Мутация белгілері жоқ
Dialogue: 0,0:08:44.12,0:08:46.83,Default,,0,0,0,,Күрсіну... Бұл дұрыс емес➡
Dialogue: 0,0:08:46.83,0:08:50.40,Default,,0,0,0,,[TEL] Ақпарат. AASA айтқандай сіздің рөліңіз қандай?➡
Dialogue: 0,0:08:50.40,0:08:53.77,Default,,0,0,0,,Тек бақылау. Ақпаратты өз қалауыңыз бойынша тарату➡
Dialogue: 0,0:08:53.77,0:08:55.87,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:08:57.47,0:08:59.57,Default,,0,0,0,,Бұл менің шешімім болды.
Dialogue: 0,0:08:59.57,0:09:02.94,Default,,0,0,0,,Олай десеңіз, "Мен сені жалғыз қалдыра алмаймын"➡
Dialogue: 0,0:09:02.94,0:09:04.98,Default,,0,0,0,,Міне
Dialogue: 0,0:09:04.98,0:09:10.08,Default,,0,0,0,,Дұрыс. Өзіңізді мәжбүрлемеңіз. түртіңіз (телефон жұмысының дыбысы)
Dialogue: 0,0:09:10.08,0:09:12.45,Default,,0,0,0,,≪Сіз Сайки мырзамен тағы да телефон арқылы сөйлесіп тұрсыз ба? Ха! ➡
Dialogue: 0,0:09:12.45,0:09:15.96,Default,,0,0,0,,Таң қалмаңыз. Не? не?
Dialogue: 0,0:09:15.96,0:09:18.93,Default,,0,0,0,,Сіз мұны өзіңізге ұнайтын адаммен жасай аласыз ба? (Мияко) Сондықтан! ➡
Dialogue: 0,0:09:18.93,0:09:22.93,Default,,0,0,0,,Неліктен бұлай? Айтыңызшы!
Dialogue: 0,0:09:22.93,0:09:26.33,Default,,0,0,0,,Чун Чун…(Құстар әні)
Dialogue: 0,0:09:27.70,0:09:29.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:31.77,0:09:35.14,Default,,0,0,0,,Иә? Рука-чан?
Dialogue: 0,0:09:35.14,0:09:39.15,Default,,0,0,0,,♬～
Dialogue: 0,0:09:39.15,0:09:41.18,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:09:41.18,0:09:46.32,Default,,0,0,0,,♬～
Dialogue: 0,0:09:46.32,0:09:49.06,Default,,0,0,0,,Мен мұның рас екеніне сенімдімін...➡
Dialogue: 0,0:09:49.06,0:09:51.16,Default,,0,0,0,,Дұрыс істемесең, жаман болады...
Dialogue: 0,0:09:53.49,0:09:55.53,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:09:55.53,0:10:07.51,Default,,0,0,0,,♬～
Dialogue: 0,0:10:07.51,0:10:09.81,Default,,0,0,0,,≪Ахахаха! Ха!
Dialogue: 0,0:10:11.34,0:10:13.84,Default,,0,0,0,,А, Мияко-чан?
Dialogue: 0,0:10:16.35,0:10:19.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:19.35,0:10:21.35,Default,,0,0,0,,Сусындар Шай ішуге болады ма?
Dialogue: 0,0:10:24.02,0:10:27.39,Default,,0,0,0,,Бұл жерде сіздің ойларыңыз ұшады.➡
Dialogue: 0,0:10:27.39,0:10:31.40,Default,,0,0,0,,Бұл Мизуру-сан бір кездері қорғаған аймақта ғана орын алады.➡
Dialogue: 0,0:10:31.40,0:10:34.33,Default,,0,0,0,,Кеңістік-уақыттың бұрмалануына да солай. Олай болса➡
Dialogue: 0,0:10:34.33,0:10:38.31,Default,,0,0,0,,Әпкелер әлі де осы қалада болуы керек... (Мияко).➡
Dialogue: 0,0:10:38.31,0:10:41.14,Default,,0,0,0,,Жиналған үзінділер де шығар. Хмм...
Dialogue: 0,0:10:41.14,0:10:45.14,Default,,0,0,0,,Ешбір жағдайда біз ортақ есікті ашпауымыз керек.
Dialogue: 0,0:10:46.48,0:10:48.48,Default,,0,0,0,,Ал Момо-сандікі...➡
Dialogue: 0,0:10:48.48,0:10:51.18,Default,,0,0,0,,үшінның фрагменттерін қалпына келтіріңіз➡
Dialogue: 0,0:10:51.18,0:10:53.22,Default,,0,0,0,,Болдырмау
Dialogue: 0,0:10:53.22,0:10:56.72,Default,,0,0,0,,♬～
Dialogue: 0,0:10:56.72,0:10:59.73,Default,,0,0,0,,А... Ханари мырза ше? ➡
Dialogue: 0,0:10:59.73,0:11:01.76,Default,,0,0,0,,Момо-санның жүктерін алмақшымын деді➡
Dialogue: 0,0:11:01.76,0:11:04.73,Default,,0,0,0,,Жердің шетіне баратынымыз жоқ.
Dialogue: 0,0:11:04.73,0:11:07.80,Default,,0,0,0,,Рука-чан Момо-санның күріш кебегін әкелетінін айтты.
Dialogue: 0,0:11:07.80,0:11:12.10,Default,,0,0,0,,Ну... Нукадоко!? Жарайды, оны жалғыз қалдыру жақсы идея емес ...
Dialogue: 0,0:11:13.91,0:11:21.82,Default,,0,0,0,,♬～
Dialogue: 0,0:11:21.82,0:11:24.82,Default,,0,0,0,,≪Кеңестер... Кеңестер...(аяқ дыбыстары) ≪Ах...
Dialogue: 0,0:11:24.82,0:11:29.32,Default,,0,0,0,,Күрсін... Күрсін... Күрсін...
Dialogue: 0,0:11:29.32,0:11:32.02,Default,,0,0,0,,Мен дұрыс емес соманы әкелдім.
Dialogue: 0,0:11:34.13,0:11:36.13,Default,,0,0,0,,Ах
Dialogue: 0,0:11:38.30,0:11:41.03,Default,,0,0,0,,Маған көмектесесіңдер ме?
Dialogue: 0,0:11:41.03,0:11:43.37,Default,,0,0,0,,Иә? мм...
Dialogue: 0,0:11:43.37,0:11:45.84,Default,,0,0,0,,Иә. иә?
Dialogue: 0,0:11:45.84,0:11:48.84,Default,,0,0,0,,Кешіріңіз, кешіріңіз. Аяғың дірілдеп келе жатырсың.
Dialogue: 0,0:11:48.84,0:11:52.68,Default,,0,0,0,,Жаңа туған лақ балаға ұқсайды. Мынау... аққұба!?
Dialogue: 0,0:11:52.68,0:11:56.65,Default,,0,0,0,,Кешіріңіз! Ашуланба, Фаун Чан
Dialogue: 0,0:11:56.65,0:11:59.05,Default,,0,0,0,,Мм... багаж! (Рё Каэде) Оны қайда әкелуім керек?
Dialogue: 0,0:12:01.12,0:12:03.16,Default,,0,0,0,,Бұл үлкен сома.
Dialogue: 0,0:12:03.16,0:12:06.76,Default,,0,0,0,,Маған не керек екенін білмеймін
Dialogue: 0,0:12:06.76,0:12:09.56,Default,,0,0,0,,Біреуге қонаққа барасыз ба?
Dialogue: 0,0:12:09.56,0:12:12.57,Default,,0,0,0,,Менің досым... (Рё Каэде) Түсіндім.
Dialogue: 0,0:12:12.57,0:12:22.38,Default,,0,0,0,,♬～
Dialogue: 0,0:12:22.38,0:12:24.44,Default,,0,0,0,,Мм... сен ше?
Dialogue: 0,0:12:24.44,0:12:26.51,Default,,0,0,0,,≫(Ами Рю) Рио Каэде! (Рё Каэде) Ами Рю
Dialogue: 0,0:12:26.51,0:12:29.38,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз. Хахаха...
Dialogue: 0,0:12:29.38,0:12:31.42,Default,,0,0,0,,Уау! Бас!
Dialogue: 0,0:12:31.42,0:12:34.69,Default,,0,0,0,,Уау...｡ (Рё Каэде) Такуку
Dialogue: 0,0:12:34.69,0:12:38.19,Default,,0,0,0,,Сіз жарақат алдыңыз ба? (Ами Рю) Жоқ, бұл ештеңе емес.
Dialogue: 0,0:12:38.19,0:12:40.59,Default,,0,0,0,,Иә. (Ами Рю) Рахмет.
Dialogue: 0,0:12:41.90,0:12:44.20,Default,,0,0,0,,Уфуфу. Ах.
Dialogue: 0,0:12:46.77,0:12:50.17,Default,,0,0,0,,Сіз ше? Мм... бұл
Dialogue: 0,0:12:52.14,0:12:55.64,Default,,0,0,0,,А...｡ Иә? бірдеңе?
Dialogue: 0,0:12:55.64,0:12:58.18,Default,,0,0,0,,Жоқ рахмет
Dialogue: 0,0:12:58.18,0:13:00.75,Default,,0,0,0,,Рио Каэде. иә?
Dialogue: 0,0:13:00.75,0:13:02.75,Default,,0,0,0,,Менің атым
Dialogue: 0,0:13:05.49,0:13:07.49,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:11.32,0:13:16.90,Default,,0,0,0,,♬～(Иахонның музыкасы «Сайшин»)
Dialogue: 0,0:13:16.90,0:13:19.27,Default,,0,0,0,,Ами-Рю, саған бүгін ұнамады ма?
Dialogue: 0,0:13:19.27,0:13:24.00,Default,,0,0,0,,А... жоқ! Біраз ойланып қалдым
Dialogue: 0,0:13:24.00,0:13:28.41,Default,,0,0,0,,Дұрыс. Бұл қыз Рио Кэденің досы ма? Қоян? ➡
Dialogue: 0,0:13:28.41,0:13:31.95,Default,,0,0,0,,Біз бүгін бірінші рет кездестік. Бұл досымның қонаққа келуі еді.
Dialogue: 0,0:13:31.95,0:13:35.05,Default,,0,0,0,,Жанашырлық...
Dialogue: 0,0:13:35.05,0:13:38.62,Default,,0,0,0,,Сонымен, қалай өткенін сұрасам болады ма?
Dialogue: 0,0:13:38.62,0:13:40.62,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:13:42.02,0:13:45.16,Default,,0,0,0,,Көрдіңіз бе, нәтиже денсаулықтың өзі.
Dialogue: 0,0:13:45.16,0:13:47.73,Default,,0,0,0,,Барлық жерде проблема жоқ.➡
Dialogue: 0,0:13:47.73,0:13:50.53,Default,,0,0,0,,Мен салмақ қосып жатырмын.➡
Dialogue: 0,0:13:50.53,0:13:54.33,Default,,0,0,0,,Мен қатты таң қалдым. Иә...
Dialogue: 0,0:13:56.00,0:13:58.10,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:03.74,0:14:06.04,Default,,0,0,0,,Рио Каэде Кешіріңіз.
Dialogue: 0,0:14:07.71,0:14:11.79,Default,,0,0,0,,♬～
Dialogue: 0,0:14:11.79,0:14:13.82,Default,,0,0,0,,♬~
Dialogue: 0,0:14:13.82,0:14:17.42,Default,,0,0,0,,♬～
Dialogue: 0,0:14:17.42,0:14:22.12,Default,,0,0,0,,Куун Куун… Куун…
Dialogue: 0,0:14:26.23,0:14:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:14:33.87,0:14:37.34,Default,,0,0,0,,Сіз өзіңізді салқындатуға тырыспайсыз.
Dialogue: 0,0:14:37.34,0:14:42.95,Default,,0,0,0,,♬～
Dialogue: 0,0:14:42.95,0:14:45.65,Default,,0,0,0,,Бүгінгі кешкі ас тәтті және қышқыл шошқа еті!
Dialogue: 0,0:14:45.65,0:14:48.02,Default,,0,0,0,,Қарапайымырақ нәрсе жақсырақ емес пе?
Dialogue: 0,0:14:48.02,0:14:51.56,Default,,0,0,0,,Бір оғаш нәрсе жасасам, Ширакаба мырза маған ашуланады.
Dialogue: 0,0:14:51.56,0:14:54.43,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:54.43,0:14:56.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:56.50,0:15:00.20,Default,,0,0,0,,Мияко-чан, сен Момо-санның қасында болғың келеді.
Dialogue: 0,0:15:01.77,0:15:05.67,Default,,0,0,0,,Ширакаба мырза бірде есінен танып бара жатқандай сезінді.
Dialogue: 0,0:15:09.24,0:15:13.18,Default,,0,0,0,,Мен енді артыма қарамаймын
Dialogue: 0,0:15:13.18,0:15:17.02,Default,,0,0,0,,Әпкеңнің түсінбейтін тұстары бар➡
Dialogue: 0,0:15:17.02,0:15:21.65,Default,,0,0,0,,Тоқтасам, өкінішім көбейер еді деп ойлаймын.
Dialogue: 0,0:15:21.65,0:15:24.62,Default,,0,0,0,,Хирахара мырза…
Dialogue: 0,0:15:24.62,0:15:27.63,Default,,0,0,0,,Эй, сенің әпкең мен Шино Чан айтты➡
Dialogue: 0,0:15:27.63,0:15:30.06,Default,,0,0,0,,Дүние туралы
Dialogue: 0,0:15:30.06,0:15:33.10,Default,,0,0,0,,Әділ және мейірімді әлем
Dialogue: 0,0:15:33.10,0:15:37.44,Default,,0,0,0,,Бір адамға мейірімді дүние міндетті түрде бәріне мейірімді бола бермейді.
Dialogue: 0,0:15:37.44,0:15:39.84,Default,,0,0,0,,Бірақ...｡ Мен түсіндім.
Dialogue: 0,0:15:39.84,0:15:43.91,Default,,0,0,0,,Сіз мені жалғыз қалдыра алмайсыз, солай ма? Иә
Dialogue: 0,0:15:43.91,0:15:47.85,Default,,0,0,0,,Мен сізге айтамын, бұл міндетті түрде қиын болады.
Dialogue: 0,0:15:47.85,0:15:50.88,Default,,0,0,0,,Мен не істерімді де білмеймін
Dialogue: 0,0:15:50.88,0:15:54.49,Default,,0,0,0,,Иә. Мен қатты тырысуым керек.
Dialogue: 0,0:15:54.49,0:15:56.59,Default,,0,0,0,,Көп нәрсе істеу керек.
Dialogue: 0,0:15:59.06,0:16:01.09,Default,,0,0,0,,Ах
Dialogue: 0,0:16:01.09,0:16:04.03,Default,,0,0,0,,Бүгін кешкі асқа хияши чука туралы не айтасыз?
Dialogue: 0,0:16:04.03,0:16:06.33,Default,,0,0,0,,Кешіріңіз, мен қышқыл тамақты ұнатпаймын.
Dialogue: 0,0:18:12.69,0:18:15.76,Default,,0,0,0,,♬～
Dialogue: 0,0:18:15.76,0:18:17.80,Default,,0,0,0,,[Сөйлеуші] (Нина) Өлең Ей, түсіндің бе!
Dialogue: 0,0:18:17.80,0:18:20.07,Default,,0,0,0,,Маған ұнамайды! Тоқта! [Спикер] (Нина) Қашпа.➡
Dialogue: 0,0:18:20.07,0:18:23.24,Default,,0,0,0,,Мен сені бүгін кешірмеймін. (Поэзия) Жоқ! Одан да көп➡
Dialogue: 0,0:18:23.24,0:18:26.11,Default,,0,0,0,,Мен өлемін! [Спикер] (Нина) Менің ойымша, бұл "Нина-сан" деп аталады➡
Dialogue: 0,0:18:26.11,0:18:29.38,Default,,0,0,0,,Неге қашып кетсең де, пианинода алаңсыз ойнайсың?
Dialogue: 0,0:18:29.38,0:18:31.41,Default,,0,0,0,,Күрсін... [Сөйлеуші] (Нина) Маған қалдырыңыз...
Dialogue: 0,0:18:31.41,0:18:33.41,Default,,0,0,0,,Жетпейді...｡➡
Dialogue: 0,0:18:35.28,0:18:37.35,Default,,0,0,0,,Мен сәтсіздікке ұшырадым➡
Dialogue: 0,0:18:37.35,0:18:40.82,Default,,0,0,0,,Үйден қашу тым жаман, Сенпай.
Dialogue: 0,0:18:40.82,0:18:53.90,Default,,0,0,0,,♬～
Dialogue: 0,0:18:53.90,0:18:58.61,Default,,0,0,0,,Шино-тан, мен өте жалықтым, мен өлетін сияқтымын.
Dialogue: 0,0:18:58.61,0:19:02.91,Default,,0,0,0,,Поэзия Мен жаңа ынталандыруды қалаймын~
Dialogue: 0,0:19:02.91,0:19:05.21,Default,,0,0,0,,Қандай түрткі?
Dialogue: 0,0:19:05.21,0:19:09.02,Default,,0,0,0,,Жақсы~ Бұл аяусыз және ауыр➡
Dialogue: 0,0:19:09.02,0:19:12.05,Default,,0,0,0,,Мұндай нәрсе мені мәңгілікке үмітсіз етеді...
Dialogue: 0,0:19:12.05,0:19:15.69,Default,,0,0,0,,Ах! А-а... Бұл не...
Dialogue: 0,0:19:15.69,0:19:17.72,Default,,0,0,0,,Аха!
Dialogue: 0,0:19:17.72,0:19:21.39,Default,,0,0,0,,Сіз өз күштеріңізге үйреніп қалған сияқтысыз➡
Dialogue: 0,0:19:21.39,0:19:23.43,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:19:23.43,0:19:26.13,Default,,0,0,0,,Бұл жолы әділетті әлем
Dialogue: 0,0:19:26.13,0:19:29.14,Default,,0,0,0,,Иә, бастайық.
Dialogue: 0,0:19:29.14,0:19:32.21,Default,,0,0,0,,Гүрілдеу...(Гүркіреу)
Dialogue: 0,0:19:32.21,0:19:34.84,Default,,0,0,0,,Ауа райы бұзылатын сияқты.
Dialogue: 0,0:19:34.84,0:19:37.81,Default,,0,0,0,,Оның керемет болғаны жақсы. Бұл дұрыс.
Dialogue: 0,0:19:37.81,0:19:40.58,Default,,0,0,0,,Тыныш! Сәлем жігіттер➡
Dialogue: 0,0:19:40.58,0:19:42.58,Default,,0,0,0,,Біраз уақыттан бері қолдарыңыз жұмысын тоқтатқан сияқты.
Dialogue: 0,0:19:42.58,0:19:44.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:44.62,0:19:47.99,Default,,0,0,0,,Күрсін... тынығып алайық.
Dialogue: 0,0:19:47.99,0:19:51.09,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:19:53.13,0:19:57.96,Default,,0,0,0,,Эй, мен Йо Сакурай туралы айтып отырмын, сондықтан сен оны бақылап тұруың керек.
Dialogue: 0,0:19:57.96,0:20:02.30,Default,,0,0,0,,Иә? мен уайымдап отырмын. Сакурай бұл➡
Dialogue: 0,0:20:02.30,0:20:06.01,Default,,0,0,0,,Мені бейтаныс адам ретіндегі ойларым да құтқарды.
Dialogue: 0,0:20:06.01,0:20:09.78,Default,,0,0,0,,Маған ойымды сақтау құдіреті көмектесті.➡
Dialogue: 0,0:20:09.78,0:20:11.84,Default,,0,0,0,,Бірақ...｡➡
Dialogue: 0,0:20:11.84,0:20:15.52,Default,,0,0,0,,Мен болсам, мен әр түрлі заттарды бөле алар едім➡
Dialogue: 0,0:20:15.52,0:20:18.55,Default,,0,0,0,,Мен ол жерлерде суық екенін білемін.
Dialogue: 0,0:20:18.55,0:20:22.46,Default,,0,0,0,,Бірақ Йо Сакурай... Мен тым абдырап қалдым!
Dialogue: 0,0:20:22.46,0:20:24.49,Default,,0,0,0,,Мен барамын. Ах.
Dialogue: 0,0:20:24.49,0:20:28.19,Default,,0,0,0,,♬～
Dialogue: 0,0:20:28.19,0:20:31.93,Default,,0,0,0,,Huh…｡ [TEL] (Алынған электрондық пошта/Үнсіз режим)
Dialogue: 0,0:20:31.93,0:20:33.97,Default,,0,0,0,,Ах
Dialogue: 0,0:20:33.97,0:20:37.84,Default,,0,0,0,,Тез шешім қабылдамаңыз. Хм... Тағы біраз.
Dialogue: 0,0:20:37.84,0:20:40.54,Default,,0,0,0,,≪(Мияко) Йо Сакура Ханари-сан! Мияко-чан?
Dialogue: 0,0:20:40.54,0:20:43.14,Default,,0,0,0,,Ақпарат. Күшті нүкте кеңістік-уақыттың бұрмалануында кездеседі...
Dialogue: 0,0:20:43.14,0:20:47.98,Default,,0,0,0,,Қалаан Қалаан…(қоңырау дыбысы)
Dialogue: 0,0:20:47.98,0:20:50.58,Default,,0,0,0,,Секіру диапазоны. Рука-чан
Dialogue: 0,0:20:51.98,0:21:12.00,Default,,0,0,0,,♬～
Dialogue: 0,0:21:12.00,0:21:15.64,Default,,0,0,0,,♬～
Dialogue: 0,0:21:15.64,0:21:17.84,Default,,0,0,0,,Сақина екі реакцияны көрсетеді.
Dialogue: 0,0:21:19.78,0:21:21.88,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:23.68,0:21:25.72,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:21:25.72,0:21:28.35,Default,,0,0,0,,≪Мен саған басқа ойды алып тастауға рұқсат бермеймін≫
Dialogue: 0,0:21:28.35,0:21:34.43,Default,,0,0,0,,♬～
Dialogue: 0,0:21:34.43,0:21:37.33,Default,,0,0,0,,А... А?
Dialogue: 0,0:21:38.83,0:21:40.87,Default,,0,0,0,,Йо Сакурай
Dialogue: 0,0:21:40.87,0:21:44.64,Default,,0,0,0,,♬～
Dialogue: 0,0:21:44.64,0:21:46.64,Default,,0,0,0,,Ах
Dialogue: 0,0:21:48.78,0:21:50.81,Default,,0,0,0,,Гакин! Қарғыс атсын!
Dialogue: 0,0:21:50.81,0:21:59.42,Default,,0,0,0,,♬～
Dialogue: 0,0:21:59.42,0:22:01.45,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:22:01.45,0:22:04.46,Default,,0,0,0,,♬～
Dialogue: 0,0:22:04.46,0:22:08.53,Default,,0,0,0,,Хехехе. Енді бүгінгі тақырып ➡
Dialogue: 0,0:22:08.53,0:22:13.90,Default,,0,0,0,,«Үлкен гүлдер әсерлі кездесуде» Не?
Dialogue: 0,0:22:13.90,0:22:16.94,Default,,0,0,0,,Мұңдан дірілдеген қыздар➡
Dialogue: 0,0:22:16.94,0:22:19.54,Default,,0,0,0,,Бұл өтеу қазір
Dialogue: 0,0:22:21.54,0:22:23.74,Default,,0,0,0,,Бұл менің сатып алуым
Dialogue: 0,0:22:26.31,0:22:28.61,Default,,0,0,0,,Гакин! Гакин! Қарғыс атсын! Гррр...
Dialogue: 0,0:22:28.61,0:22:30.61,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:22:32.02,0:22:34.05,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:22:34.05,0:22:36.09,Default,,0,0,0,,Ол меннен қанша есе мықты. (Очако) Ах…
Dialogue: 0,0:22:36.09,0:22:43.40,Default,,0,0,0,,♬～
Dialogue: 0,0:22:43.40,0:22:45.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:47.70,0:22:49.74,Default,,0,0,0,,Га
Dialogue: 0,0:22:49.74,0:22:56.44,Default,,0,0,0,,♬～
Dialogue: 0,0:22:56.44,0:22:59.48,Default,,0,0,0,,Ха. Уф...
Dialogue: 0,0:22:59.48,0:23:02.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:02.25,0:23:04.58,Default,,0,0,0,,Гакин! Апыр-ай!
Dialogue: 0,0:23:04.58,0:23:08.75,Default,,0,0,0,,Бұл өзін күнәға бағыштаған апаның құдіреті.
Dialogue: 0,0:23:08.75,0:23:10.95,Default,,0,0,0,,Қандай ауыртпалық!
Dialogue: 0,0:23:12.69,0:23:14.99,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:14.99,0:23:17.03,Default,,0,0,0,,Әй!
Dialogue: 0,0:23:17.03,0:23:24.50,Default,,0,0,0,,♬～
Dialogue: 0,0:23:24.50,0:23:28.57,Default,,0,0,0,,≪Бұл не? Мен біраз уақыттан бері біртүрлі болып жүрмін≫
Dialogue: 0,0:23:28.57,0:23:31.31,Default,,0,0,0,,≪Ол менің алдымда болуы керек➡
Dialogue: 0,0:23:31.31,0:23:35.28,Default,,0,0,0,,Менің әпкем өте алыс≫
Dialogue: 0,0:23:35.28,0:23:39.58,Default,,0,0,0,,≪Шабуыл жетпейді. Ойлар резонанс тудырмайды≫
Dialogue: 0,0:23:41.02,0:23:43.82,Default,,0,0,0,,Жасау-істеу-істеу... Ммм!
Dialogue: 0,0:23:45.49,0:23:49.06,Default,,0,0,0,,≪Тоқтатқым келсе де... Мен сенің әпкеңмін≫
Dialogue: 0,0:23:49.06,0:23:51.06,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:52.47,0:23:54.47,Default,,0,0,0,,Бишун!
Dialogue: 0,0:23:56.34,0:23:58.74,Default,,0,0,0,,Бассейн!
Dialogue: 0,0:23:58.74,0:24:00.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:00.77,0:24:04.67,Default,,0,0,0,,♬～
Dialogue: 0,0:24:06.05,0:24:10.55,Default,,0,0,0,,♬～
Dialogue: 0,0:24:10.55,0:24:12.85,Default,,0,0,0,,Иә! мылтық!
Dialogue: 0,0:24:12.85,0:24:14.89,Default,,0,0,0,,Ах! (Мизуру) Иә!
Dialogue: 0,0:24:14.89,0:24:18.26,Default,,0,0,0,,♬～
Dialogue: 0,0:24:18.26,0:24:21.06,Default,,0,0,0,,Өтірік! Жаңа рефлектор!?
Dialogue: 0,0:24:21.06,0:24:26.07,Default,,0,0,0,,♬～
Dialogue: 0,0:24:26.07,0:24:28.17,Default,,0,0,0,,Сакурай! Хахаха...
Dialogue: 0,0:24:28.17,0:24:30.74,Default,,0,0,0,,Рука-чан, қылыш! иә!
Dialogue: 0,0:24:30.74,0:24:37.88,Default,,0,0,0,,♬～
Dialogue: 0,0:24:37.88,0:24:40.75,Default,,0,0,0,,Мен ешқашан өз ойымды алып кетуге жол бермеймін
Dialogue: 0,0:24:40.75,0:24:42.95,Default,,0,0,0,,Біз оны тоқтатамыз
Dialogue: 0,0:24:45.25,0:24:47.69,Default,,0,0,0,,Күрсін! Бишу!
Dialogue: 0,0:24:47.69,0:24:59.23,Default,,0,0,0,,♬～
Dialogue: 0,0:24:59.23,0:25:02.23,Default,,0,0,0,,Өртен! (2 адам) А
Dialogue: 0,0:25:02.23,0:25:04.23,Default,,0,0,0,,Қарғыс атсын...｡ Ах.
Dialogue: 0,0:25:06.01,0:25:08.11,Default,,0,0,0,,А...
Dialogue: 0,0:25:10.34,0:25:13.11,Default,,0,0,0,,Шино-танның саған айтқаны есіңде ме?
Dialogue: 0,0:25:13.11,0:25:16.18,Default,,0,0,0,,Бүгін өз күшіңізді сынайтын уақыт.
Dialogue: 0,0:25:16.18,0:25:18.18,Default,,0,0,0,,Оны асыра пайдаланбаңыз.➡
Dialogue: 0,0:25:18.18,0:25:21.05,Default,,0,0,0,,Келесі жолы гүл теру
Dialogue: 0,0:25:21.05,0:25:24.09,Default,,0,0,0,,♬～
Dialogue: 0,0:25:24.09,0:25:28.86,Default,,0,0,0,,Әпке...｡ Мен сізге міндетті түрде дұрыс дүние беремін.
Dialogue: 0,0:25:28.86,0:25:32.87,Default,,0,0,0,,Уууу. Жақында көріскенше, гүлдер.➡
Dialogue: 0,0:25:32.87,0:25:34.97,Default,,0,0,0,,Бұл жаңа тұлғалар да.
Dialogue: 0,0:25:38.30,0:25:41.80,Default,,0,0,0,,Рука-чан фрагменті. Иә.
Dialogue: 0,0:25:43.31,0:25:47.35,Default,,0,0,0,,Мен Йосакуридің әпкесі бар екеніне сенімдімін... Ах...➡
Dialogue: 0,0:25:47.35,0:25:51.25,Default,,0,0,0,,Сіз Сакурайсыз ба? Ханари мырза?
Dialogue: 0,0:25:51.25,0:25:54.02,Default,,0,0,0,,Күте тұрыңыз! Tsk!
Dialogue: 0,0:25:54.02,0:25:56.06,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:25:56.06,0:26:00.43,Default,,0,0,0,,♬～
Dialogue: 0,0:26:00.43,0:26:02.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:02.73,0:26:04.76,Default,,0,0,0,,Ах
Dialogue: 0,0:26:04.76,0:26:08.47,Default,,0,0,0,,♬～
Dialogue: 0,0:26:08.47,0:26:10.50,Default,,0,0,0,,Нина-чан!
Dialogue: 0,0:26:10.50,0:26:14.70,Default,,0,0,0,,♬～
Dialogue: 0,0:26:16.04,0:26:35.09,Default,,0,0,0,,♬～
Dialogue: 0,0:26:35.09,0:26:49.41,Default,,0,0,0,,♬～
Dialogue: 0,0:26:49.41,0:26:56.95,Default,,0,0,0,,♬～
Dialogue: 0,0:26:56.95,0:27:10.03,Default,,0,0,0,,♬～
Dialogue: 0,0:27:10.03,0:27:26.08,Default,,0,0,0,,♬～
Dialogue: 0,0:27:26.08,0:27:30.58,Default,,0,0,0,,♬～
Dialogue: 0,0:27:30.58,0:27:45.08,Default,,0,0,0,,♬～
Dialogue: 0,0:29:17.69,0:29:19.73,Default,,0,0,0,,Мен сенің не ойлағаныңды айтпасаң да айта аламын.
Dialogue: 0,0:29:19.73,0:29:21.73,Default,,0,0,0,,Мен Нина-чанмен тағы кездескім келеді.
Dialogue: 0,0:29:21.73,0:29:25.06,Default,,0,0,0,,Ортақ есікті тезірек ашу үшін
Dialogue: 0,0:29:25.06,0:29:27.53,Default,,0,0,0,,Мен мұның бәрін аяқтаймын
Dialogue: 0,0:29:27.53,0:29:29.53,Default,,0,0,0,,Ами Рю…
Dialogue: 0,0:29:31.03,0:29:37.03,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
