Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.85,0:01:38.88,Default,,0,0,0,,Момо…｡➡
Dialogue: 0,0:01:38.88,0:01:40.92,Default,,0,0,0,,Момо!
Dialogue: 0,0:01:40.92,0:01:43.86,Default,,0,0,0,,Қалаан Қалаан…(қоңырау дыбысы)
Dialogue: 0,0:01:43.86,0:01:46.96,Default,,0,0,0,,Жаңа дәуір шымылдығы ашылды➡
Dialogue: 0,0:01:46.96,0:01:49.96,Default,,0,0,0,,Әпкемнің күнәлары гүлдейді
Dialogue: 0,0:01:49.96,0:01:54.77,Default,,0,0,0,,Енді гүлдене берсін!
Dialogue: 0,0:01:54.77,0:02:00.67,Default,,0,0,0,,Жоқ~~~!!
Dialogue: 0,0:02:01.94,0:02:04.94,Default,,0,0,0,,Момо-сан! Әпке! Гррр...
Dialogue: 0,0:02:04.94,0:02:16.29,Default,,0,0,0,,♬～
Dialogue: 0,0:02:16.29,0:02:18.32,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:02:18.32,0:02:21.29,Default,,0,0,0,,Неге ертерек айтпадың! ➡
Dialogue: 0,0:02:21.29,0:02:23.70,Default,,0,0,0,,Неліктен бұл соншалықты маңызды?
Dialogue: 0,0:02:23.70,0:02:26.40,Default,,0,0,0,,Біздің қазіргі жағдайымызда... Ах.➡
Dialogue: 0,0:02:28.07,0:02:30.54,Default,,0,0,0,,Жаңа фрагмент ұрланды ма?
Dialogue: 0,0:02:30.54,0:02:32.57,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:02:32.57,0:02:35.47,Default,,0,0,0,,♬～
Dialogue: 0,0:02:35.47,0:02:37.51,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:02:37.51,0:02:45.55,Default,,0,0,0,,♬～
Dialogue: 0,0:02:45.55,0:02:49.59,Default,,0,0,0,,Уф... (Рука Ханари) Қарғыс атсын!
Dialogue: 0,0:02:49.59,0:02:52.12,Default,,0,0,0,,Әпке... Ах｡➡
Dialogue: 0,0:02:52.12,0:02:55.26,Default,,0,0,0,,Үлкен әпке, әпке! Ах...
Dialogue: 0,0:02:55.26,0:02:58.53,Default,,0,0,0,,♬～
Dialogue: 0,0:02:58.53,0:03:01.03,Default,,0,0,0,,Рефлектордың ойы болса да➡
Dialogue: 0,0:03:01.03,0:03:03.37,Default,,0,0,0,,Бұл кілтті аяқтамайды.
Dialogue: 0,0:03:03.37,0:03:07.54,Default,,0,0,0,,Хехехе. Шино-тан бақытты көрінеді.
Dialogue: 0,0:03:07.54,0:03:11.84,Default,,0,0,0,,Уфуфу.Шино Эй! Барлығын түсіну➡
Dialogue: 0,0:03:11.84,0:03:14.85,Default,,0,0,0,,Әпкеңді бұрышқа апарып тастадың!?
Dialogue: 0,0:03:14.85,0:03:19.28,Default,,0,0,0,,Менің әпкемде маңызды нәрселер тым көп.
Dialogue: 0,0:03:19.28,0:03:21.59,Default,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,0:03:21.59,0:03:24.69,Default,,0,0,0,,Мен тек мүмкіндік бердім
Dialogue: 0,0:03:24.69,0:03:27.49,Default,,0,0,0,,Үлкен апа өз ойымен бетпе-бет келеді➡
Dialogue: 0,0:03:27.49,0:03:30.80,Default,,0,0,0,,Біз шынымен маңызды нәрсені таңдаймыз.
Dialogue: 0,0:03:30.80,0:03:33.80,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:03:33.80,0:03:37.34,Default,,0,0,0,,Уф! Арх... аа!
Dialogue: 0,0:03:37.34,0:03:41.51,Default,,0,0,0,,♬～
Dialogue: 0,0:03:41.51,0:03:43.88,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:03:43.88,0:03:45.91,Default,,0,0,0,,)
Dialogue: 0,0:03:45.91,0:03:49.18,Default,,0,0,0,,((Мен қателесіппін...)) ((Әпке...))
Dialogue: 0,0:03:49.18,0:03:52.32,Default,,0,0,0,,((Енді не істеуім керек...➡
Dialogue: 0,0:03:52.32,0:03:55.15,Default,,0,0,0,,білмеймін))
Dialogue: 0,0:03:55.15,0:03:57.99,Default,,0,0,0,,Уф! Әпке...
Dialogue: 0,0:03:57.99,0:04:00.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:00.56,0:04:03.60,Default,,0,0,0,,А... уф!
Dialogue: 0,0:04:03.60,0:04:05.93,Default,,0,0,0,,≪ауыр жүрек≫
Dialogue: 0,0:04:05.93,0:04:09.03,Default,,0,0,0,,Уф... Хирахара мырза
Dialogue: 0,0:04:10.84,0:04:15.24,Default,,0,0,0,,≪Мен жалғыз алға жылжи алмаймын≫
Dialogue: 0,0:04:15.24,0:04:18.28,Default,,0,0,0,,≪Сенің әпкең осылай ойлай ма? ≫
Dialogue: 0,0:04:18.28,0:04:23.05,Default,,0,0,0,,♬～
Dialogue: 0,0:04:23.05,0:04:28.35,Default,,0,0,0,,♬～
Dialogue: 0,0:04:28.35,0:04:32.52,Default,,0,0,0,,Ута-чан, қалғанын сұрадым.
Dialogue: 0,0:04:32.52,0:04:36.06,Default,,0,0,0,,Уфуфу. Түсінді.
Dialogue: 0,0:04:36.06,0:04:39.36,Default,,0,0,0,,Кілт біраз уақыттан кейін аяқталады➡
Dialogue: 0,0:04:39.36,0:04:42.17,Default,,0,0,0,,Жалған дүние қурап қалады.
Dialogue: 0,0:04:42.17,0:04:49.61,Default,,0,0,0,,♬～
Dialogue: 0,0:04:49.61,0:04:52.81,Default,,0,0,0,,Енді бүршіктену уақыты келді
Dialogue: 0,0:04:55.48,0:04:58.18,Default,,0,0,0,,Ах! Уф!
Dialogue: 0,0:04:59.62,0:05:01.65,Default,,0,0,0,,Ах... Ах.
Dialogue: 0,0:05:01.65,0:05:16.84,Default,,0,0,0,,♬～
Dialogue: 0,0:05:16.84,0:05:19.20,Default,,0,0,0,,Әпкеңнің ой әлемі
Dialogue: 0,0:05:19.20,0:05:21.37,Default,,0,0,0,,≪Tattatatta… (аяқ дыбысы) ≪Mr. Хирахара!
Dialogue: 0,0:05:21.37,0:05:25.21,Default,,0,0,0,,Не болып жатыр? Мен білмеймін. Мен не істеуім керек...
Dialogue: 0,0:05:25.21,0:05:27.71,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:27.71,0:05:29.81,Default,,0,0,0,,Нина-чан!
Dialogue: 0,0:05:31.28,0:05:34.78,Default,,0,0,0,,Мен саған әпкемді бермеймін.
Dialogue: 0,0:05:36.32,0:05:39.09,Default,,0,0,0,,Егер бұрмалау тарала берсе ➡
Dialogue: 0,0:05:39.09,0:05:43.20,Default,,0,0,0,,Шындық пен ортақ тоғысқан, Еріксіз есік ашылады
Dialogue: 0,0:05:43.20,0:05:45.20,Default,,0,0,0,,Не? Ха!
Dialogue: 0,0:05:46.73,0:05:50.44,Default,,0,0,0,,Күтіңіз. Сіз әлі түсінбейсіз бе?
Dialogue: 0,0:05:50.44,0:05:54.57,Default,,0,0,0,,Не? Түсінбейтін сенсің.
Dialogue: 0,0:05:54.57,0:05:57.98,Default,,0,0,0,,Сабырлы болыңыз. Рефлектор емес біздер үшін ➡
Dialogue: 0,0:05:57.98,0:06:00.38,Default,,0,0,0,,Сіз не істей аласыз? (Токио) Бұл мүмкін бе➡
Dialogue: 0,0:06:00.38,0:06:02.38,Default,,0,0,0,,Сіз мұны істей алмайсыз! ➡
Dialogue: 0,0:06:02.38,0:06:05.42,Default,,0,0,0,,Мен барлығын жалғыз қалдыра алмаймын
Dialogue: 0,0:06:05.42,0:06:08.02,Default,,0,0,0,,Уф…｡ Гачаның тарылуы (есік дыбысы)
Dialogue: 0,0:06:09.42,0:06:11.52,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:11.52,0:06:15.86,Default,,0,0,0,,Мүмкін мен ештеңе түсінбеймін.
Dialogue: 0,0:06:15.86,0:06:19.36,Default,,0,0,0,,♬～
Dialogue: 0,0:06:21.30,0:06:24.47,Default,,0,0,0,,Ол жерден кет. (Нина) Әй!
Dialogue: 0,0:06:24.47,0:06:26.61,Default,,0,0,0,,Нина-чанды өтінемін
Dialogue: 0,0:06:26.61,0:06:29.31,Default,,0,0,0,,Мен Момо-сан мен оның әпкесіне көмектескім келеді.
Dialogue: 0,0:06:29.31,0:06:32.68,Default,,0,0,0,,Көмек бергіңіз келе ме? Оны қай ауыз айтады?➡
Dialogue: 0,0:06:32.68,0:06:35.68,Default,,0,0,0,,Осымен бірдей. Әпкеңнің құрбысымен➡
Dialogue: 0,0:06:35.68,0:06:39.18,Default,,0,0,0,,Тек талап қоятын әйел. Момо-сан ондай емес...
Dialogue: 0,0:06:39.18,0:06:43.56,Default,,0,0,0,,Не болды!? Әпкеңді қатты қинадың...
Dialogue: 0,0:06:43.56,0:06:47.66,Default,,0,0,0,,Йосакури Хирахара Сіз де! Хмм...
Dialogue: 0,0:06:47.66,0:06:53.10,Default,,0,0,0,,Мен мойындаймын. Сіз менің әпкемнің барлық ойларында болдыңыз.
Dialogue: 0,0:06:53.10,0:06:57.57,Default,,0,0,0,,Апамның мен білмейтін барлық ыстық сезімдеріне.
Dialogue: 0,0:06:57.57,0:07:00.94,Default,,0,0,0,,Бірақ азап үшін де солай.
Dialogue: 0,0:07:00.94,0:07:04.88,Default,,0,0,0,,Әпкеңді қатты қинап, қинап жүрген ол➡
Dialogue: 0,0:07:04.88,0:07:07.68,Default,,0,0,0,,Йосакури Хирахара Бұл тек сенсің! Бишу!
Dialogue: 0,0:07:08.95,0:07:10.98,Default,,0,0,0,,Мен сенің әпкеңе қамқор боламын...
Dialogue: 0,0:07:10.98,0:07:13.02,Default,,0,0,0,,)
Dialogue: 0,0:07:13.02,0:07:15.05,Default,,0,0,0,,Ха...
Dialogue: 0,0:07:15.05,0:07:17.49,Default,,0,0,0,,Бассейн!
Dialogue: 0,0:07:17.49,0:07:20.83,Default,,0,0,0,,Рука-чан! Әпкеңе не ауыр тиді?
Dialogue: 0,0:07:20.83,0:07:23.70,Default,,0,0,0,,Өйткені Йо Сакурайдың маңызы зор!
Dialogue: 0,0:07:23.70,0:07:26.53,Default,,0,0,0,,Сондықтан да солай... Қарғыс атсын!
Dialogue: 0,0:07:26.53,0:07:28.60,Default,,0,0,0,,Әпкең туралы не білесің?
Dialogue: 0,0:07:28.60,0:07:30.97,Default,,0,0,0,,Buri biri biri... (Нина) Қарғыс атсын!
Dialogue: 0,0:07:30.97,0:07:33.37,Default,,0,0,0,,Мен көптен бері білмедім
Dialogue: 0,0:07:33.37,0:07:36.74,Default,,0,0,0,,Маңызды нәрсені қабылдау, қобалжу және азап
Dialogue: 0,0:07:36.74,0:07:39.81,Default,,0,0,0,,Бірақ менің ойымда бұл ғана емес!
Dialogue: 0,0:07:39.81,0:07:43.35,Default,,0,0,0,,Сондықтан бұл өте қиын! Уф!
Dialogue: 0,0:07:43.35,0:07:45.42,Default,,0,0,0,,Поэзия Менімен араласпа!
Dialogue: 0,0:07:45.42,0:07:49.42,Default,,0,0,0,,Әй, қолыңмен осылай айта аласың ба? Қарғыс атсын!
Dialogue: 0,0:07:49.42,0:07:52.82,Default,,0,0,0,,Хехехе. Ерінбей еңбек етіп жүрген гүл-чандарға➡
Dialogue: 0,0:07:52.82,0:07:57.53,Default,,0,0,0,,Мен саған әпкеңнің көңілін көтеру жолын көрсетемін.
Dialogue: 0,0:07:57.53,0:08:00.13,Default,,0,0,0,,Тек қосылымды үзіңіз. Ах!
Dialogue: 0,0:08:00.13,0:08:02.27,Default,,0,0,0,,Ах. Байланыс па?
Dialogue: 0,0:08:02.27,0:08:04.87,Default,,0,0,0,,Біреу туралы ойласаң, байланыс туады➡
Dialogue: 0,0:08:04.87,0:08:08.44,Default,,0,0,0,,Қажетсіз эмоцияларға байланып қаласыз.➡
Dialogue: 0,0:08:08.44,0:08:13.28,Default,,0,0,0,,Сол үшін апаң екеуің қиналып жатырсыңдар.
Dialogue: 0,0:08:13.28,0:08:17.38,Default,,0,0,0,,Хехехе. Тек оны тастаңыз.
Dialogue: 0,0:08:17.38,0:08:20.65,Default,,0,0,0,,Мен саған көмектесемін.
Dialogue: 0,0:08:20.65,0:08:23.69,Default,,0,0,0,,Сіз не туралы айтып отырсыз? (Поэзия) Осымен➡
Dialogue: 0,0:08:23.69,0:08:27.13,Default,,0,0,0,,Бұл шынымен де әпкеңді құтқару деген сөз.➡
Dialogue: 0,0:08:27.13,0:08:30.73,Default,,0,0,0,,, солай ма? Сенпай. Хмм...
Dialogue: 0,0:08:30.73,0:08:33.26,Default,,0,0,0,,Хехе. Сенпай?
Dialogue: 0,0:08:33.26,0:08:36.26,Default,,0,0,0,,Ах...｡ Жоқ!
Dialogue: 0,0:08:38.74,0:08:42.77,Default,,0,0,0,,((Егер сіз мұны кисеңіз, Нина-чанның көзі болу туралы ойларыңыз артады➡
Dialogue: 0,0:08:42.77,0:08:45.97,Default,,0,0,0,,Күш те күшейе түседі. Бірақ...)))
Dialogue: 0,0:08:47.55,0:08:50.28,Default,,0,0,0,,≪Неден қорқасыз? ➡
Dialogue: 0,0:08:50.28,0:08:53.35,Default,,0,0,0,,Ол қалыпты жағдайға оралады.➡
Dialogue: 0,0:08:53.35,0:08:57.66,Default,,0,0,0,,Сол күні әпкем мені сұрады≫
Dialogue: 0,0:08:57.66,0:09:01.39,Default,,0,0,0,,♬～
Dialogue: 0,0:09:01.39,0:09:04.70,Default,,0,0,0,,«Махаббат, үміт, қуаныш➡
Dialogue: 0,0:09:04.70,0:09:07.00,Default,,0,0,0,,Қоштасу №➡
Dialogue: 0,0:09:07.00,0:09:09.93,Default,,0,0,0,,Естеліктеріңізбен қоштаспаңыз.''
Dialogue: 0,0:09:09.93,0:09:13.83,Default,,0,0,0,,Апаңды қинайтын мен болмаймын!
Dialogue: 0,0:09:16.67,0:09:20.75,Default,,0,0,0,,Ха... Уау!!
Dialogue: 0,0:09:20.75,0:09:23.68,Default,,0,0,0,,Нина-чан! Жер бетінде не ...
Dialogue: 0,0:09:23.68,0:09:26.45,Default,,0,0,0,,Хааааааа... аа~! Ахх!
Dialogue: 0,0:09:26.45,0:09:31.29,Default,,0,0,0,,Өлімнің азабына төзе білуден артық рахат жоқ.
Dialogue: 0,0:09:31.29,0:09:36.09,Default,,0,0,0,,Ах... Ах! Міне, жақындап қалды.➡
Dialogue: 0,0:09:36.09,0:09:41.80,Default,,0,0,0,,Апамның көп күнәлары әділ дүние есігін ашады.
Dialogue: 0,0:09:41.80,0:09:45.67,Default,,0,0,0,,♬～
Dialogue: 0,0:09:45.67,0:09:49.54,Default,,0,0,0,,Уф! Ах... Ах! Хаа…｡➡
Dialogue: 0,0:09:49.54,0:09:51.54,Default,,0,0,0,,Және... ➡
Dialogue: 0,0:09:51.54,0:09:56.21,Default,,0,0,0,,Менің бастауымның күші...｡➡
Dialogue: 0,0:09:56.21,0:09:58.92,Default,,0,0,0,,А... а...
Dialogue: 0,0:09:58.92,0:10:02.95,Default,,0,0,0,,Уф! Хахаха...
Dialogue: 0,0:10:02.95,0:10:06.59,Default,,0,0,0,,Куфу… Куфуфу…
Dialogue: 0,0:10:06.59,0:10:09.59,Default,,0,0,0,,Мен сондай сағыныш пен жүрек айнуды сезінемін
Dialogue: 0,0:10:12.03,0:10:15.63,Default,,0,0,0,,Уф! Арх! Уф... уф!
Dialogue: 0,0:10:17.67,0:10:22.51,Default,,0,0,0,,Күлсін... Күш бұрынғыдан мүлде бөлек. Қарғыс атсын!
Dialogue: 0,0:10:22.51,0:10:26.11,Default,,0,0,0,,А... Нина-чан, тамаша!
Dialogue: 0,0:10:28.25,0:10:30.65,Default,,0,0,0,,Арх! Хирахара мырза!
Dialogue: 0,0:10:30.65,0:10:33.55,Default,,0,0,0,,Сіз менімен ойнай аласыз!
Dialogue: 0,0:10:33.55,0:10:35.59,Default,,0,0,0,,Уф! Рука-чан!
Dialogue: 0,0:10:35.59,0:10:39.62,Default,,0,0,0,,Қарғыс атсын! Гах...хааааааааааааа...
Dialogue: 0,0:10:39.62,0:10:42.59,Default,,0,0,0,,♬～
Dialogue: 0,0:10:42.59,0:10:47.49,Default,,0,0,0,,Иә, мен осыған лайықпын.
Dialogue: 0,0:10:48.97,0:10:54.67,Default,,0,0,0,,♬～
Dialogue: 0,0:10:54.67,0:10:57.64,Default,,0,0,0,,≪Мен қашан қорқа бастадым?≫
Dialogue: 0,0:10:57.64,0:11:04.72,Default,,0,0,0,,♬～
Dialogue: 0,0:11:04.72,0:11:07.22,Default,,0,0,0,,≪Бірінші орын➡
Dialogue: 0,0:11:07.22,0:11:10.32,Default,,0,0,0,,Мен алғаш білген сезімді жоғалту≫
Dialogue: 0,0:11:12.62,0:11:17.33,Default,,0,0,0,,≪Бірақ ол басқаша болды. Бұл жалғыздық немесе қайғылы емес еді.➡
Dialogue: 0,0:11:17.33,0:11:21.17,Default,,0,0,0,,Иә, басынан ештеңе болған жоқ.➡
Dialogue: 0,0:11:21.17,0:11:23.87,Default,,0,0,0,,Мен үшін ештеңе жоқ≫
Dialogue: 0,0:11:25.17,0:11:27.84,Default,,0,0,0,,Қарғыс атсын... хахаха
Dialogue: 0,0:11:27.84,0:11:30.84,Default,,0,0,0,,Жоғалтатын ештеңе жоқ
Dialogue: 0,0:11:30.84,0:11:34.71,Default,,0,0,0,,Бұл менің күшім
Dialogue: 0,0:11:34.71,0:11:36.75,Default,,0,0,0,,Нина-чан...
Dialogue: 0,0:11:36.75,0:11:40.18,Default,,0,0,0,,Уау! Бишу!
Dialogue: 0,0:11:40.18,0:11:42.89,Default,,0,0,0,,Гррр... Ааа! Хирахара мырза!
Dialogue: 0,0:11:42.89,0:11:45.92,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:11:45.92,0:11:48.36,Default,,0,0,0,,≪Қауіпсіз болыңыз≫
Dialogue: 0,0:11:48.36,0:11:54.70,Default,,0,0,0,,♬～
Dialogue: 0,0:11:54.70,0:11:57.20,Default,,0,0,0,,Ах! Қарғыс атқыр...
Dialogue: 0,0:11:57.20,0:12:02.57,Default,,0,0,0,,♬～
Dialogue: 0,0:12:02.57,0:12:04.57,Default,,0,0,0,,Бітті
Dialogue: 0,0:12:05.98,0:12:08.68,Default,,0,0,0,,Tsk! Дәл солай
Dialogue: 0,0:12:08.68,0:12:13.69,Default,,0,0,0,,Ах, мен де Нина-чан сияқты➡
Dialogue: 0,0:12:13.69,0:12:16.99,Default,,0,0,0,,Мен сенің әпкеңді ойлап отырмын. (Нина) Ах!
Dialogue: 0,0:12:16.99,0:12:20.76,Default,,0,0,0,,Мен сені күлдіргім келеді. Әпкеме➡
Dialogue: 0,0:12:20.76,0:12:24.36,Default,,0,0,0,,Мен сенің басқалардан бақытты болғаныңды қалаймын
Dialogue: 0,0:12:24.36,0:12:28.30,Default,,0,0,0,,Әпкең ауырса немесе мұңайса ➡
Dialogue: 0,0:12:28.30,0:12:32.34,Default,,0,0,0,,Мен де сенімен бірге алып жүргім келеді. Тоқта...
Dialogue: 0,0:12:32.34,0:12:35.37,Default,,0,0,0,,Уф! аға?
Dialogue: 0,0:12:35.37,0:12:38.34,Default,,0,0,0,,Жалғыз болған дұрыс➡
Dialogue: 0,0:12:38.34,0:12:41.38,Default,,0,0,0,,Әпкең солай деуі мүмкін.
Dialogue: 0,0:12:41.38,0:12:44.18,Default,,0,0,0,,Сонда да мен сенің жаныңда болғым келеді
Dialogue: 0,0:12:44.18,0:12:47.48,Default,,0,0,0,,Мүмкін болса, мәңгілік. Артық ештеңе айтпа!
Dialogue: 0,0:12:48.82,0:12:51.72,Default,,0,0,0,,Мен үнемі ойланып отырамын
Dialogue: 0,0:12:51.72,0:12:53.72,Default,,0,0,0,,Үлкен әпке маңызды
Dialogue: 0,0:12:55.39,0:12:57.73,Default,,0,0,0,,Мен сені жақсы көремін. Ах!
Dialogue: 0,0:12:57.73,0:13:00.33,Default,,0,0,0,,Жоқ! Мен сенің әпкеңмін...
Dialogue: 0,0:13:01.70,0:13:05.10,Default,,0,0,0,,Ах! Сіздің әпкеңіз?
Dialogue: 0,0:13:07.17,0:13:12.28,Default,,0,0,0,,Мен неге... ұрысамын? ➡
Dialogue: 0,0:13:12.28,0:13:15.91,Default,,0,0,0,,Не үшін? Хирахара мырза!
Dialogue: 0,0:13:15.91,0:13:19.58,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба? аға
Dialogue: 0,0:13:19.58,0:13:21.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:21.62,0:13:24.29,Default,,0,0,0,,күрсіну…｡ Рука-чан➡
Dialogue: 0,0:13:24.29,0:13:27.86,Default,,0,0,0,,Маған күш бере аласыз ба? иә?
Dialogue: 0,0:13:27.86,0:13:30.83,Default,,0,0,0,,Мен Нина-чанның сезімін қорғағым келеді
Dialogue: 0,0:13:30.83,0:13:33.43,Default,,0,0,0,,Мен енді ешкімге сенің сезіміңді тартып алуына жол бермеймін
Dialogue: 0,0:15:37.66,0:15:44.30,Default,,0,0,0,,♬～
Dialogue: 0,0:15:44.30,0:15:46.66,Default,,0,0,0,,Бұл қандай бостық?
Dialogue: 0,0:15:46.66,0:16:03.15,Default,,0,0,0,,♬～
Dialogue: 0,0:16:03.15,0:16:07.19,Default,,0,0,0,,Хмм... Мен ештеңе сезбеймін.
Dialogue: 0,0:16:07.19,0:16:09.52,Default,,0,0,0,,Менің жүрегім қозғалмайды
Dialogue: 0,0:16:09.52,0:16:14.13,Default,,0,0,0,,♬～
Dialogue: 0,0:16:14.13,0:16:16.13,Default,,0,0,0,,Мен қандаймын...
Dialogue: 0,0:16:16.13,0:16:18.13,Default,,0,0,0,,Әжесінің қалта сағатын — естелік ретінде — қолына ұстап,
Dialogue: 0,0:16:19.63,0:16:21.63,Default,,0,0,0,,Хирахара мырза!
Dialogue: 0,0:16:23.07,0:16:27.07,Default,,0,0,0,,Нина-чанның сезімін қорғаңызшы!
Dialogue: 0,0:16:27.07,0:16:30.14,Default,,0,0,0,,Ах! Тоқта...
Dialogue: 0,0:16:30.14,0:16:34.68,Default,,0,0,0,,Менің ойыма рұқсатсыз тиіспе!
Dialogue: 0,0:16:34.68,0:16:38.22,Default,,0,0,0,,Ойларыңызды тастамаңыз!
Dialogue: 0,0:16:38.22,0:16:42.09,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен оны қиып алдым.➡
Dialogue: 0,0:16:42.09,0:16:44.12,Default,,0,0,0,,Әпкеңе!
Dialogue: 0,0:16:44.12,0:16:51.10,Default,,0,0,0,,♬～
Dialogue: 0,0:16:51.10,0:16:53.13,Default,,0,0,0,,Әпкеңе...
Dialogue: 0,0:16:53.13,0:16:55.50,Default,,0,0,0,,Нина-чанға ғана тән сезімдер!
Dialogue: 0,0:16:55.50,0:16:58.84,Default,,0,0,0,,♬～
Dialogue: 0,0:16:58.84,0:17:01.14,Default,,0,0,0,,Тек менің ойым...｡➡
Dialogue: 0,0:17:02.47,0:17:04.57,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:17:05.91,0:17:09.91,Default,,0,0,0,,≪Дұрыс... Мен сіздің әпкеңізбен таныстым➡
Dialogue: 0,0:17:09.91,0:17:12.98,Default,,0,0,0,,Мен өзімді білдім≫
Dialogue: 0,0:17:12.98,0:17:14.92,Default,,0,0,0,,Ах
Dialogue: 0,0:17:14.92,0:17:19.56,Default,,0,0,0,,≪Мен білемін. Білгеннен кейін➡
Dialogue: 0,0:17:19.56,0:17:22.36,Default,,0,0,0,,Мен енді орала алмаймын≫
Dialogue: 0,0:17:22.36,0:17:25.03,Default,,0,0,0,,≪Сонда да, мен...≫
Dialogue: 0,0:17:25.03,0:17:32.00,Default,,0,0,0,,♬～
Dialogue: 0,0:17:32.00,0:17:35.54,Default,,0,0,0,,«Мен дүниені сүймедім.➡
Dialogue: 0,0:17:35.54,0:17:39.34,Default,,0,0,0,,Әлем де мені қалайды...»｡ Хмм.
Dialogue: 0,0:17:39.34,0:17:43.51,Default,,0,0,0,,≫(Миген) «Бірақ мен сенгім келеді». Ах... Ах.
Dialogue: 0,0:17:43.51,0:17:46.35,Default,,0,0,0,,«Жақсылық тек атымен ғана емес;
Dialogue: 0,0:17:46.35,0:17:48.99,Default,,0,0,0,,Бақыт арман емес».
Dialogue: 0,0:17:48.99,0:17:54.39,Default,,0,0,0,,♬～
Dialogue: 0,0:17:54.39,0:17:56.83,Default,,0,0,0,,Қандай тамаша өлең. Хехе
Dialogue: 0,0:17:56.83,0:18:01.33,Default,,0,0,0,,≪Мен ештеңе білмейтін адамға қайта оралғым келмейді≫
Dialogue: 0,0:18:01.33,0:18:08.24,Default,,0,0,0,,♬～
Dialogue: 0,0:18:08.24,0:18:11.04,Default,,0,0,0,,Әпке...｡ Ах.
Dialogue: 0,0:18:11.04,0:18:13.41,Default,,0,0,0,,Уф...Мырза. Хирахара
Dialogue: 0,0:18:13.41,0:18:17.18,Default,,0,0,0,,Мен ағамнан көңілім қалды! (2 адам) Уф!
Dialogue: 0,0:18:17.18,0:18:20.79,Default,,0,0,0,,Ой маңызды ма? мені күлдіреді
Dialogue: 0,0:18:20.79,0:18:25.46,Default,,0,0,0,,Менен соншалықты көп нәрсені ұрлаған аға оның қаншалықты маңызды екенін түсінуі мүмкін емес!
Dialogue: 0,0:18:25.46,0:18:28.53,Default,,0,0,0,,Саған не болды!? Сіз біреуді ойлап жүрсеңіз де➡
Dialogue: 0,0:18:28.53,0:18:30.90,Default,,0,0,0,,Мұнда таңқаларлық ештеңе жоқ!
Dialogue: 0,0:18:30.90,0:18:33.36,Default,,0,0,0,,Ха... болмайды!
Dialogue: 0,0:18:33.36,0:18:35.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:35.40,0:18:37.44,Default,,0,0,0,,Бакин! (2 адам) Уф!
Dialogue: 0,0:18:37.44,0:18:40.77,Default,,0,0,0,,Қарғыс атсын...｡ Менің аяғым...
Dialogue: 0,0:18:40.77,0:18:43.07,Default,,0,0,0,,Хана-чан және басқалары жеңіледі.
Dialogue: 0,0:18:48.58,0:18:51.88,Default,,0,0,0,,Ха! Неліктен?
Dialogue: 0,0:18:51.88,0:18:54.75,Default,,0,0,0,,Бұл мені шынымен күлдіреді.➡
Dialogue: 0,0:18:54.75,0:18:58.49,Default,,0,0,0,,Неліктен үлкен апа үлкеніне қол созды➡
Dialogue: 0,0:18:58.49,0:19:01.26,Default,,0,0,0,,Айтайын ба?
Dialogue: 0,0:19:01.26,0:19:04.26,Default,,0,0,0,,Барлығы есікті ашу үшін
Dialogue: 0,0:19:04.26,0:19:07.33,Default,,0,0,0,,Үлкен апа өзінің үлкенін ешқашан көрмеген.
Dialogue: 0,0:19:07.33,0:19:11.30,Default,,0,0,0,,Менде үлкен ағам тілейтін сезім жоқ.
Dialogue: 0,0:19:11.30,0:19:15.67,Default,,0,0,0,,Бұл маңызды емес. Әпкең не ойласа да➡
Dialogue: 0,0:19:15.67,0:19:17.71,Default,,0,0,0,,Менің сезімдерім шынайы
Dialogue: 0,0:19:17.71,0:19:19.81,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:19:22.38,0:19:25.38,Default,,0,0,0,,Ах! Ах... уф...
Dialogue: 0,0:19:26.82,0:19:28.82,Default,,0,0,0,,Нина-чан!
Dialogue: 0,0:19:31.62,0:19:35.49,Default,,0,0,0,,Сіз нені айтасыз? (2 адам) Уф!
Dialogue: 0,0:19:35.49,0:19:38.53,Default,,0,0,0,,Мен білмеймін.➡
Dialogue: 0,0:19:38.53,0:19:43.23,Default,,0,0,0,,Сіз ханымдар сезімдеріңізді қорғау үшін қандай стандарттарды қолданасыз?
Dialogue: 0,0:19:43.23,0:19:46.57,Default,,0,0,0,,Нина-чанды қорғау туралы не ойлаймын?
Dialogue: 0,0:19:46.57,0:19:48.57,Default,,0,0,0,,Мені қорғамайсың ба?
Dialogue: 0,0:19:50.64,0:19:55.11,Default,,0,0,0,,Шино-чанның ойлары... Ха
Dialogue: 0,0:19:55.11,0:19:57.72,Default,,0,0,0,,Ой тек сол адамға ғана тән
Dialogue: 0,0:19:57.72,0:20:00.75,Default,,0,0,0,,Басқа ешкім білмейді. (2 адам) А.
Dialogue: 0,0:20:00.75,0:20:02.79,Default,,0,0,0,,Сонда да, әпкелер➡
Dialogue: 0,0:20:02.79,0:20:05.26,Default,,0,0,0,,Сызық сызу.➡
Dialogue: 0,0:20:05.26,0:20:08.23,Default,,0,0,0,,Сіз өз шешіміңізді жасайсыз.➡
Dialogue: 0,0:20:08.23,0:20:10.80,Default,,0,0,0,,Басқару деген осы емес пе?
Dialogue: 0,0:20:10.80,0:20:13.70,Default,,0,0,0,,Жоқ! Бұл дұрыс
Dialogue: 0,0:20:13.70,0:20:18.07,Default,,0,0,0,,Бір нәрсені рұқсатсыз алу мен оны қорғау мүлдем басқа нәрсе.
Dialogue: 0,0:20:18.07,0:20:21.07,Default,,0,0,0,,Солай ма? Мен үшін үлкен әпкелер➡
Dialogue: 0,0:20:21.07,0:20:24.61,Default,,0,0,0,,Бұл өте қарама-қайшы көрінеді➡
Dialogue: 0,0:20:24.61,0:20:28.61,Default,,0,0,0,,Бұл жиіркенішті. (2 адам) Уф!
Dialogue: 0,0:20:28.61,0:20:31.52,Default,,0,0,0,,Ойдың мәні жоқ➡
Dialogue: 0,0:20:31.52,0:20:33.95,Default,,0,0,0,,Басқаларды былай қойғанда, тіпті адамның өзін➡
Dialogue: 0,0:20:33.95,0:20:37.92,Default,,0,0,0,,Түсінесіз бе, білмеймін.
Dialogue: 0,0:20:37.92,0:20:40.49,Default,,0,0,0,,Уф...｡ Қарғыс атсын!
Dialogue: 0,0:20:40.49,0:20:44.20,Default,,0,0,0,,Солай бола тұра, ол сізді ақымақ істерге мәжбүрлейді.
Dialogue: 0,0:20:44.20,0:20:49.03,Default,,0,0,0,,Ойлар адам кейпіне енген қорқынышты нәрселер.
Dialogue: 0,0:20:49.03,0:20:52.37,Default,,0,0,0,,Уф... уф! (Шино) Осындай бірдеңе➡
Dialogue: 0,0:20:52.37,0:20:56.91,Default,,0,0,0,,Оларды бақылаусыз қалдыруға болмайды. Түсінесің, иә?
Dialogue: 0,0:20:56.91,0:20:59.21,Default,,0,0,0,,Бассейн!
Dialogue: 0,0:20:59.21,0:21:02.08,Default,,0,0,0,,Аа...｡ Ах.
Dialogue: 0,0:21:02.08,0:21:06.42,Default,,0,0,0,,Мен білмеймін. Менде бір сезім бар➡
Dialogue: 0,0:21:06.42,0:21:09.32,Default,,0,0,0,,Менің ойымша, бұл қорқынышты емес.
Dialogue: 0,0:21:09.32,0:21:13.36,Default,,0,0,0,,Әрбір ойды түсіну мүмкін болмауы мүмкін
Dialogue: 0,0:21:13.36,0:21:18.16,Default,,0,0,0,,Сонда да сіз оны ұрлай алмайсыз.
Dialogue: 0,0:21:18.16,0:21:21.06,Default,,0,0,0,,Өйткені ой тек сол адамға ғана тиесілі.
Dialogue: 0,0:21:23.73,0:21:26.64,Default,,0,0,0,,Ойлары біртүрлі.
Dialogue: 0,0:21:26.64,0:21:31.28,Default,,0,0,0,,Мен ұстай алмасам да, ол міндетті түрде осында➡
Dialogue: 0,0:21:31.28,0:21:35.38,Default,,0,0,0,,Маған күш береді. Біздің ойларымыз байланысты.
Dialogue: 0,0:21:35.38,0:21:38.85,Default,,0,0,0,,Біреу туралы аз да болса ойласаңыз, сөзсіз
Dialogue: 0,0:21:38.85,0:21:41.85,Default,,0,0,0,,♬～
Dialogue: 0,0:21:41.85,0:21:44.66,Default,,0,0,0,,Мен алға жылжыған кезде➡
Dialogue: 0,0:21:44.66,0:21:47.16,Default,,0,0,0,,Мен өзім болуым үшін
Dialogue: 0,0:21:47.16,0:21:49.86,Default,,0,0,0,,Қарғыс атсын! Қажетсіз еліктеу
Dialogue: 0,0:21:51.23,0:21:53.93,Default,,0,0,0,,Мен өз ойыма сенемін
Dialogue: 0,0:21:53.93,0:21:57.03,Default,,0,0,0,,Өйткені бәріміз осындамыз!
Dialogue: 0,0:21:59.50,0:22:02.97,Default,,0,0,0,,Рефлектор – үзінді... Ойлар➡
Dialogue: 0,0:22:02.97,0:22:05.71,Default,,0,0,0,,Сіз біреуді қорғай аласыз!
Dialogue: 0,0:22:05.71,0:22:08.18,Default,,0,0,0,,Иә. Әлі емес➡
Dialogue: 0,0:22:08.18,0:22:11.78,Default,,0,0,0,,Мен Шино-чанның сезіміне қалай жауап берерімді білмеймін.
Dialogue: 0,0:22:11.78,0:22:15.35,Default,,0,0,0,,Біз әлемді мейірімді орынға айналдыру үшін не істей аламыз?
Dialogue: 0,0:22:15.35,0:22:19.76,Default,,0,0,0,,Бірақ егер мен сіздің ойларыңызбен байланыстырсам...
Dialogue: 0,0:22:19.76,0:22:23.23,Default,,0,0,0,,Шино-чан, біз сен туралы көбірек білгіміз келеді!
Dialogue: 0,0:22:23.23,0:22:25.26,Default,,0,0,0,,Уф! Бассейн!
Dialogue: 0,0:22:25.26,0:22:30.30,Default,,0,0,0,,♬～
Dialogue: 0,0:22:30.30,0:22:32.70,Default,,0,0,0,,Бір күні естігенім...
Dialogue: 0,0:22:34.84,0:22:38.54,Default,,0,0,0,,Ха! Мені тоқтатуға құқығың жоқ!
Dialogue: 0,0:22:40.14,0:22:43.84,Default,,0,0,0,,Юдзу-чан Лайм-чан! (2 адам) Уф!
Dialogue: 0,0:22:47.62,0:22:50.62,Default,,0,0,0,,Рефлектор ешкімді құтқара алмайды➡
Dialogue: 0,0:22:50.62,0:22:53.02,Default,,0,0,0,,Ойлар қателеседі
Dialogue: 0,0:22:53.02,0:23:00.53,Default,,0,0,0,,♬～
Dialogue: 0,0:23:00.53,0:23:03.27,Default,,0,0,0,,Қателіктерімді мен ғана білемін➡
Dialogue: 0,0:23:03.27,0:23:06.37,Default,,0,0,0,,Әділ дүниеге жетелей алады
Dialogue: 0,0:23:08.27,0:23:13.31,Default,,0,0,0,,Ең болмағанда, Йо Сакурай, пайдалы бол және жоғал.
Dialogue: 0,0:23:13.31,0:23:15.31,Default,,0,0,0,,Аһ!
Dialogue: 0,0:23:15.31,0:23:18.05,Default,,0,0,0,,Қарғыс атсын... уф!
Dialogue: 0,0:23:18.05,0:23:23.42,Default,,0,0,0,,♬～
Dialogue: 0,0:23:23.42,0:23:25.62,Default,,0,0,0,,Қоштасу. Ах...
Dialogue: 0,0:23:26.99,0:23:29.19,Default,,0,0,0,,Ах. Ха.
Dialogue: 0,0:23:30.56,0:23:32.66,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:23:34.40,0:23:38.47,Default,,0,0,0,,Сіз мені тоқтатқыңыз келе ме? Мені әпкем де жақсы көреді...
Dialogue: 0,0:23:38.47,0:23:41.81,Default,,0,0,0,,Мен сені жалғыз қалдырмаймын. Ах.
Dialogue: 0,0:23:41.81,0:23:46.58,Default,,0,0,0,,Мен таңдаймын... сені күнә
Dialogue: 0,0:23:46.58,0:23:49.18,Default,,0,0,0,,А...
Dialogue: 0,0:23:49.18,0:23:51.72,Default,,0,0,0,,Мен барымды беремін
Dialogue: 0,0:23:51.72,0:23:53.75,Default,,0,0,0,,Үлкен әпке?
Dialogue: 0,0:23:53.75,0:23:57.95,Default,,0,0,0,,Сондықтан сен менің жалғыз әпкемсің.
Dialogue: 0,0:24:01.86,0:24:06.20,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:24:06.20,0:24:16.84,Default,,0,0,0,,♬～
Dialogue: 0,0:24:16.84,0:24:20.64,Default,,0,0,0,,Үлкен әпке! Уф... Ах!
Dialogue: 0,0:24:20.64,0:24:24.21,Default,,0,0,0,,Әпкем үмітсіздіктің шетінде мені таңдады.
Dialogue: 0,0:24:24.21,0:24:29.22,Default,,0,0,0,,Қажетсіз ойларды тастап, әділ дүние құрудың жолын табыңыз.➡
Dialogue: 0,0:24:29.22,0:24:31.62,Default,,0,0,0,,Келіңіз, әпке.
Dialogue: 0,0:24:33.66,0:24:35.83,Default,,0,0,0,,Амон, ол жігіт қауіпті.
Dialogue: 0,0:24:35.83,0:24:40.10,Default,,0,0,0,,Есік ақырында ашылады. Қайта кездескенше.
Dialogue: 0,0:24:40.10,0:24:42.50,Default,,0,0,0,,Бики Бики Бики...
Dialogue: 0,0:24:42.50,0:24:49.37,Default,,0,0,0,,♬～
Dialogue: 0,0:24:49.37,0:24:51.41,Default,,0,0,0,,Момо-сан!
Dialogue: 0,0:24:51.41,0:24:57.18,Default,,0,0,0,,♬～
Dialogue: 0,0:24:57.18,0:24:59.28,Default,,0,0,0,,Әпке, бармаңыз!
Dialogue: 0,0:25:00.58,0:25:02.99,Default,,0,0,0,,≪Ой жұмбақ.➡
Dialogue: 0,0:25:02.99,0:25:05.62,Default,,0,0,0,,Бұйра немесе сүйір.➡
Dialogue: 0,0:25:05.62,0:25:08.43,Default,,0,0,0,,Ол әрқашан менің жүрегімде➡
Dialogue: 0,0:25:08.43,0:25:10.46,Default,,0,0,0,,Ұстауға болмайды≫
Dialogue: 0,0:25:10.46,0:25:14.30,Default,,0,0,0,,Өтінемін, үйге бірге барайық!
Dialogue: 0,0:25:14.30,0:25:16.43,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:25:16.43,0:25:25.38,Default,,0,0,0,,♬～
Dialogue: 0,0:25:25.38,0:25:27.41,Default,,0,0,0,,Хмм.
Dialogue: 0,0:25:27.41,0:25:31.45,Default,,0,0,0,,≪Сіздердің ойларыңыз менікі екеніне сенімдімін➡
Dialogue: 0,0:25:31.45,0:25:33.55,Default,,0,0,0,,Мен солай сезінсем де...≫
Dialogue: 0,0:25:36.39,0:25:39.36,Default,,0,0,0,,≪Сөзбен жеткізу қиын≫
Dialogue: 0,0:25:39.36,0:25:43.49,Default,,0,0,0,,≪Соған қарамастан, мен өз-өзім бола алдым...≫
Dialogue: 0,0:25:43.49,0:25:48.43,Default,,0,0,0,,Өзгеріс жоқ! Ол ештеңеге қарамастан өзгермейді
Dialogue: 0,0:25:48.43,0:25:51.63,Default,,0,0,0,,Мен сені әрқашан ойладым!
Dialogue: 0,0:25:53.10,0:25:55.81,Default,,0,0,0,,≪Себебі сол жерде Йо Сакурай болды≫
Dialogue: 0,0:25:55.81,0:26:00.61,Default,,0,0,0,,≪Себебі сен мені қадірледің...≫
Dialogue: 0,0:26:00.61,0:26:03.91,Default,,0,0,0,,Ха! Уф...
Dialogue: 0,0:26:03.91,0:26:06.61,Default,,0,0,0,,Сәлем, Сакурай➡
Dialogue: 0,0:26:08.25,0:26:10.85,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:26:10.85,0:26:14.19,Default,,0,0,0,,Күрсін... Қайдасың!?➡
Dialogue: 0,0:26:14.19,0:26:17.29,Default,,0,0,0,,Сакурай! Ханари мырза! Момо-сан!
Dialogue: 0,0:26:17.29,0:26:19.56,Default,,0,0,0,,Ах! Ауырды...
Dialogue: 0,0:26:19.56,0:26:21.60,Default,,0,0,0,,Гррр…
Dialogue: 0,0:26:21.60,0:26:25.37,Default,,0,0,0,,Өтінемін, жауап беріңіз➡
Dialogue: 0,0:26:25.37,0:26:27.37,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:26:29.24,0:26:31.38,Default,,0,0,0,,≪Мияко-чан. Ах.
Dialogue: 0,0:26:31.38,0:26:35.88,Default,,0,0,0,,♬～
Dialogue: 0,0:26:37.28,0:26:39.88,Default,,0,0,0,,Ах…｡ Уф…｡➡
Dialogue: 0,0:26:41.39,0:26:43.42,Default,,0,0,0,,Уф! ➡
Dialogue: 0,0:26:43.42,0:26:46.16,Default,,0,0,0,,Қайтадан қош келдіңіз. Иә...
Dialogue: 0,0:26:46.16,0:27:04.71,Default,,0,0,0,,♬～
Dialogue: 0,0:27:04.71,0:27:16.35,Default,,0,0,0,,♬～
Dialogue: 0,0:27:16.35,0:27:25.70,Default,,0,0,0,,♬～
Dialogue: 0,0:27:25.70,0:27:33.10,Default,,0,0,0,,♬～
Dialogue: 0,0:27:33.10,0:27:42.98,Default,,0,0,0,,♬～
Dialogue: 0,0:27:42.98,0:27:54.98,Default,,0,0,0,,♬～
