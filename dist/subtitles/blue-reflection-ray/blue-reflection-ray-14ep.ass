Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:35.92,0:01:38.22,Default,,0,0,0,,Нина-чан! Ха!
Dialogue: 0,0:01:38.22,0:01:41.96,Default,,0,0,0,,♬～
Dialogue: 0,0:01:41.96,0:01:44.73,Default,,0,0,0,,≪Боо... (машина моторының дыбысы) Ах!
Dialogue: 0,0:01:44.73,0:01:48.17,Default,,0,0,0,,♬～
Dialogue: 0,0:01:48.17,0:01:50.20,Default,,0,0,0,,Нина-чан...
Dialogue: 0,0:01:50.20,0:02:09.92,Default,,0,0,0,,♬～
Dialogue: 0,0:02:09.92,0:02:29.34,Default,,0,0,0,,♬～
Dialogue: 0,0:02:29.34,0:02:32.74,Default,,0,0,0,,♬～
Dialogue: 0,0:02:32.74,0:02:51.80,Default,,0,0,0,,♬～
Dialogue: 0,0:02:51.80,0:03:03.60,Default,,0,0,0,,♬～
Dialogue: 0,0:03:05.08,0:03:08.58,Default,,0,0,0,,♬～
Dialogue: 0,0:03:08.58,0:03:19.98,Default,,0,0,0,,♬～
Dialogue: 0,0:03:22.59,0:03:24.69,Default,,0,0,0,,Нина Ямада!?
Dialogue: 0,0:03:26.00,0:03:29.07,Default,,0,0,0,,Бұл дұрыс емес…｡ Жоқ ➡
Dialogue: 0,0:03:29.07,0:03:32.04,Default,,0,0,0,,Ол сізге көмектесе алмайды.➡
Dialogue: 0,0:03:32.04,0:03:35.44,Default,,0,0,0,,Эй Ханари-сан, бұл қалай өтті?
Dialogue: 0,0:03:36.91,0:03:40.44,Default,,0,0,0,,Нина-чан, сен өзгердің деп ойлаймын. иә?
Dialogue: 0,0:03:40.44,0:03:42.51,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:03:42.51,0:03:45.52,Default,,0,0,0,,((Нина-чанның сезімін қорғаңыз!))
Dialogue: 0,0:03:45.52,0:03:49.89,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:03:49.89,0:03:54.96,Default,,0,0,0,,♬～
Dialogue: 0,0:03:54.96,0:03:56.99,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:03:56.99,0:04:00.97,Default,,0,0,0,,Мен Нина-чанмен тағы кездескім келеді.
Dialogue: 0,0:04:00.97,0:04:05.44,Default,,0,0,0,,Ізде, тап, қазір не ойлап отырсың...
Dialogue: 0,0:04:05.44,0:04:07.77,Default,,0,0,0,,Ал мүмкін болса... Мен рұқсат бермеймін.
Dialogue: 0,0:04:07.77,0:04:10.51,Default,,0,0,0,,А... Мен әлі ештеңе айтқан жоқпын.
Dialogue: 0,0:04:10.51,0:04:13.88,Default,,0,0,0,,Мен сенің не ойлағаныңды айтпасаң да айта аламын.
Dialogue: 0,0:04:13.88,0:04:17.58,Default,,0,0,0,,Мен дос болғым келеді. Мен бірге күрескім келеді.
Dialogue: 0,0:04:17.58,0:04:22.22,Default,,0,0,0,,Мен бұған ешқашан жол бермеймін! Мияко-чан...
Dialogue: 0,0:04:22.22,0:04:25.39,Default,,0,0,0,,Ол мені алдамақ болды.
Dialogue: 0,0:04:25.39,0:04:28.23,Default,,0,0,0,,Мен мұны қабылдай аламын деп ойлайсыз ба?
Dialogue: 0,0:04:28.23,0:04:31.56,Default,,0,0,0,,А... (Мияко) Ханари мырза! ➡
Dialogue: 0,0:04:31.56,0:04:33.60,Default,,0,0,0,,Сіз де бірдеңе айтуыңыз керек! ➡
Dialogue: 0,0:04:33.60,0:04:36.73,Default,,0,0,0,,Дәл қазірден бастап күріш кебегін араластырмаңыз.
Dialogue: 0,0:04:36.73,0:04:39.47,Default,,0,0,0,,Оны үнемі араластырып тұру керек сияқты.
Dialogue: 0,0:04:39.47,0:04:41.67,Default,,0,0,0,,Және...｡ (Кімге) Және?
Dialogue: 0,0:04:43.94,0:04:46.38,Default,,0,0,0,,Момо не ойлайды екен.
Dialogue: 0,0:04:46.38,0:04:49.21,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:04:49.21,0:04:56.82,Default,,0,0,0,,♬～
Dialogue: 0,0:04:56.82,0:04:58.96,Default,,0,0,0,,Ерекше үлгі A｡➡
Dialogue: 0,0:04:58.96,0:05:01.86,Default,,0,0,0,,Фрагменттің зақымдалуы. Ішінара жоқ.
Dialogue: 0,0:05:05.16,0:05:08.23,Default,,0,0,0,,Сіз немен демалып жатырсыз? Тез кел!
Dialogue: 0,0:05:08.23,0:05:11.60,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:05:11.60,0:05:15.47,Default,,0,0,0,,Не? Бұл Шоуа дәуірі арнайы дайындық... Шоу дәуірі қашан болды?
Dialogue: 0,0:05:15.47,0:05:18.88,Default,,0,0,0,,Саған соғысуды үйретуімді өтінген сен едің.
Dialogue: 0,0:05:18.88,0:05:21.58,Default,,0,0,0,,Бірақ бұл қалай күресу туралы емес...
Dialogue: 0,0:05:21.58,0:05:24.62,Default,,0,0,0,,үшін рух, рух туралы. Және...
Dialogue: 0,0:05:24.62,0:05:26.92,Default,,0,0,0,,Гуд (қолдардың кіргізілген дыбысы) Ха!
Dialogue: 0,0:05:26.92,0:05:30.79,Default,,0,0,0,,♬～
Dialogue: 0,0:05:30.79,0:05:32.89,Default,,0,0,0,,Мен саған айттым ба?
Dialogue: 0,0:05:32.89,0:05:38.33,Default,,0,0,0,,Мен сенің асыл заттарыңды қорғаймын.
Dialogue: 0,0:05:38.33,0:05:40.36,Default,,0,0,0,,Момо-сан!
Dialogue: 0,0:05:40.36,0:05:44.37,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:05:44.37,0:05:46.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:46.40,0:05:48.71,Default,,0,0,0,,Хирахара мырза. Ах.
Dialogue: 0,0:05:48.71,0:05:52.18,Default,,0,0,0,,Рука-чан... Ояусың ба?
Dialogue: 0,0:05:52.18,0:05:55.21,Default,,0,0,0,,Мен ойлаған кезде...
Dialogue: 0,0:05:55.21,0:06:00.28,Default,,0,0,0,,Алдында айтқандарыңызға келсек, мен Хирахара мырзаның айтып тұрғанын түсіндім.
Dialogue: 0,0:06:00.28,0:06:02.99,Default,,0,0,0,,Ширакаба мырзаның айтқаны
Dialogue: 0,0:06:02.99,0:06:07.06,Default,,0,0,0,,Момо-сан да, Нина Ямада да➡
Dialogue: 0,0:06:07.06,0:06:10.36,Default,,0,0,0,,Хирахара мырзаның әпкесіне деген сезімі күшті.
Dialogue: 0,0:06:10.36,0:06:13.73,Default,,0,0,0,,Менің ойымша, бұл бәрібір жұмыс істемейді?
Dialogue: 0,0:06:13.73,0:06:17.27,Default,,0,0,0,,Бірақ бұл оны қалыпты жағдайға қайтарады.➡
Dialogue: 0,0:06:17.27,0:06:19.34,Default,,0,0,0,,Бір мақсатқа жинала алсақ...
Dialogue: 0,0:06:19.34,0:06:21.67,Default,,0,0,0,,Біз бірге күресе аламыз ба?
Dialogue: 0,0:06:21.67,0:06:24.64,Default,,0,0,0,,Мен Момо-саннан тікелей сұрауым керек. Иә.
Dialogue: 0,0:06:24.64,0:06:27.65,Default,,0,0,0,,Момоның үзіндісін қайтарайық.
Dialogue: 0,0:06:27.65,0:06:30.55,Default,,0,0,0,,Иә! әркімнің ойы
Dialogue: 0,0:06:30.55,0:06:32.65,Default,,0,0,0,,Иә
Dialogue: 0,0:06:34.59,0:06:37.62,Default,,0,0,0,,Welcome. (Рё Каэде) Өтінемін
Dialogue: 0,0:06:37.62,0:06:39.56,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:06:39.56,0:06:48.07,Default,,0,0,0,,♬～
Dialogue: 0,0:06:48.07,0:06:50.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:50.77,0:06:52.80,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.➡
Dialogue: 0,0:06:52.80,0:06:56.77,Default,,0,0,0,,Мен алдымен маған сақтаған деректерді қайтарамын.
Dialogue: 0,0:06:56.77,0:07:00.08,Default,,0,0,0,,Сонда бұл тармақ.➡
Dialogue: 0,0:07:00.08,0:07:03.18,Default,,0,0,0,,Сенімді болу үшін мазмұнын тексере аласыз ба?
Dialogue: 0,0:07:07.38,0:07:10.12,Default,,0,0,0,,А, мектеп саяхатының уақыты келді.
Dialogue: 0,0:07:10.12,0:07:13.09,Default,,0,0,0,,Көңілді болды. Сенің есіңде ме? ➡
Dialogue: 0,0:07:13.09,0:07:16.69,Default,,0,0,0,,Маған бұл фотоны жақсы етіп көрсету қиын болды.
Dialogue: 0,0:07:16.69,0:07:19.23,Default,,0,0,0,,Иә. Мен оны бірнеше рет қайта түсірдім.➡\NБұл
Dialogue: 0,0:07:19.23,0:07:22.27,Default,,0,0,0,,-дегі ең жақсы кадр!
Dialogue: 0,0:07:22.27,0:07:24.37,Default,,0,0,0,,Ойланып қарасам, бұл не болды екен?
Dialogue: 0,0:07:24.37,0:07:27.00,Default,,0,0,0,,Сол кезде біз тыңдап жүрген ән
Dialogue: 0,0:07:27.00,0:07:30.07,Default,,0,0,0,,Қазірдің өзінде~ Рио Каэде есіне түсірмей ме?
Dialogue: 0,0:07:30.07,0:07:32.01,Default,,0,0,0,,Тат тат (ұялы телефон жұмысының дыбысы) Міне, осы.
Dialogue: 0,0:07:32.01,0:07:34.04,Default,,0,0,0,,[ｽﾋﾟｰｶ] ♬～(｢түнде болу｣)
Dialogue: 0,0:07:34.04,0:07:38.02,Default,,0,0,0,,А, міне, солай. Ами Рю күткендей.
Dialogue: 0,0:07:38.02,0:07:40.52,Default,,0,0,0,,Бұл екеумізге арналған ойнату тізімі болса, оны бізге қалдырыңыз.
Dialogue: 0,0:07:40.52,0:07:43.35,Default,,0,0,0,,[ｽﾋﾟｰｶ] ♬～(｢түнде болу｣)
Dialogue: 0,0:07:43.35,0:07:46.19,Default,,0,0,0,,Мәдениет мерекесі! ➡
Dialogue: 0,0:07:46.19,0:07:50.86,Default,,0,0,0,,«Шыңғырған биіктер». Хитклифф Өте керемет!
Dialogue: 0,0:07:50.86,0:07:53.86,Default,,0,0,0,,Себебі Ами Рю суретті мен үшін түсірді. Erm➡
Dialogue: 0,0:07:53.86,0:07:56.87,Default,,0,0,0,,Сол кезде менің тыңдап отырғаным... мынау еді
Dialogue: 0,0:07:56.87,0:07:59.94,Default,,0,0,0,,[ｽﾋﾟｰｶ] ♬～(｢ﾀﾞｲﾊﾞｰｼﾃｨ｣)
Dialogue: 0,0:07:59.94,0:08:02.14,Default,,0,0,0,,Міне. Хехе.
Dialogue: 0,0:08:04.31,0:08:07.65,Default,,0,0,0,,Аа, бұл менің былтырғы туған күнім еді.
Dialogue: 0,0:08:07.65,0:08:10.55,Default,,0,0,0,,Менің тыңдап отырғаным мынау
Dialogue: 0,0:08:12.65,0:08:14.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:16.05,0:08:18.15,Default,,0,0,0,,Маған қарызға беріңізші.
Dialogue: 0,0:08:20.56,0:08:23.59,Default,,0,0,0,,Та та та та та
Dialogue: 0,0:08:23.59,0:08:25.63,Default,,0,0,0,,Иә. Ах!
Dialogue: 0,0:08:25.63,0:08:29.63,Default,,0,0,0,,♬～
Dialogue: 0,0:08:29.63,0:08:34.00,Default,,0,0,0,,Ами Ryu? Ами Рю!
Dialogue: 0,0:08:34.00,0:08:36.14,Default,,0,0,0,,Ах
Dialogue: 0,0:08:36.14,0:08:39.14,Default,,0,0,0,,Мен... Мені кесіп тастады ма?
Dialogue: 0,0:08:39.14,0:08:41.14,Default,,0,0,0,,Ами Ryu…｡➡
Dialogue: 0,0:08:42.65,0:08:44.65,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:47.22,0:08:50.25,Default,,0,0,0,,Жаңа рефлектор
Dialogue: 0,0:08:50.25,0:08:52.76,Default,,0,0,0,,Неге сонша толқып тұрсың?➡
Dialogue: 0,0:08:52.76,0:08:56.66,Default,,0,0,0,,Оны есіме алсам, есеңгіреп қалдым...
Dialogue: 0,0:08:58.76,0:09:01.63,Default,,0,0,0,,Әрине апаң туралы айтып отырмын➡
Dialogue: 0,0:09:01.63,0:09:04.64,Default,,0,0,0,,Мен ондай адамнан тіпті селт етпедім.
Dialogue: 0,0:09:04.64,0:09:07.61,Default,,0,0,0,,➡ шымырлап, қиналсаң жақсы болар еді
Dialogue: 0,0:09:07.61,0:09:11.04,Default,,0,0,0,,Өз басым бұл жүрек соғысы болды. О!
Dialogue: 0,0:09:11.04,0:09:15.11,Default,,0,0,0,,♬～
Dialogue: 0,0:09:15.11,0:09:17.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:17.15,0:09:20.82,Default,,0,0,0,,♬～
Dialogue: 0,0:09:20.82,0:09:23.79,Default,,0,0,0,,Мен жаңа гүлдер алғым келеді. (Поэзия) А?
Dialogue: 0,0:09:23.79,0:09:28.59,Default,,0,0,0,,Қайғылы және аянышты дыбыс барлық жерде жаңғырық➡
Dialogue: 0,0:09:28.59,0:09:32.00,Default,,0,0,0,,Мұндай гүл. Эй... Эй Шино-тан➡
Dialogue: 0,0:09:32.00,0:09:34.80,Default,,0,0,0,,Бізге Йосакури Хирахараның фрагменті керек...
Dialogue: 0,0:09:34.80,0:09:38.70,Default,,0,0,0,,Дұрыс. Ортақ есікті тезірек ашу үшін.
Dialogue: 0,0:09:38.70,0:09:42.41,Default,,0,0,0,,Тіпті сенің әпкең де! Не айтқың келеді? ➡
Dialogue: 0,0:09:42.41,0:09:45.58,Default,,0,0,0,,Маған мән бермеген ұнайды ➡
Dialogue: 0,0:09:45.58,0:09:49.45,Default,,0,0,0,,Йосакури Хирахарадан бас тарту туралы айту...
Dialogue: 0,0:09:49.45,0:09:53.45,Default,,0,0,0,,Жақсырақ екі. Жаңа гүлдер.
Dialogue: 0,0:09:55.09,0:09:57.25,Default,,0,0,0,,Бұл керемет! ➡
Dialogue: 0,0:09:57.25,0:10:00.26,Default,,0,0,0,,Мен шыдай алмаймын!
Dialogue: 0,0:10:00.26,0:10:03.49,Default,,0,0,0,,Патрульдер маңызды, бірақ абай болыңыз.➡
Dialogue: 0,0:10:03.49,0:10:06.00,Default,,0,0,0,,Өйткені, ол жақтағы басты нысана Хосакури➡
Dialogue: 0,0:10:06.00,0:10:08.90,Default,,0,0,0,,Өйткені бұл сенсің. Иә, түсінемін.
Dialogue: 0,0:10:08.90,0:10:12.94,Default,,0,0,0,,Мен ешқашан бұрынғы күні жасағандай диверсиялық операция жасамас едім.
Dialogue: 0,0:10:12.94,0:10:16.04,Default,,0,0,0,,Бірдеңе болып қалса, мен дереу Хирахара мырзаға барамын.
Dialogue: 0,0:10:18.51,0:10:20.54,Default,,0,0,0,,Бұл былай деді...
Dialogue: 0,0:10:20.54,0:10:23.54,Default,,0,0,0,,Ху~ Дұрыс. иә? Эх...
Dialogue: 0,0:10:25.68,0:10:29.32,Default,,0,0,0,,Кюн... (2 адам) Эххех. Ахаха.
Dialogue: 0,0:10:29.32,0:10:32.79,Default,,0,0,0,,<<Нәзік. Және тым көп>>
Dialogue: 0,0:10:32.79,0:10:35.49,Default,,0,0,0,,≪Кеңістік-уақыттың бұрмалануы әркімнің ойын өзгертеді...≫
Dialogue: 0,0:10:36.83,0:10:38.86,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:10:38.86,0:10:41.46,Default,,0,0,0,,Кун! Ах!
Dialogue: 0,0:10:43.60,0:10:45.77,Default,,0,0,0,,Иә! Хаха
Dialogue: 0,0:10:45.77,0:10:47.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:47.91,0:10:51.04,Default,,0,0,0,,Несі жаман?➡
Dialogue: 0,0:10:51.04,0:10:53.91,Default,,0,0,0,,Консенсуалдық деген не?➡
Dialogue: 0,0:10:53.91,0:10:58.92,Default,,0,0,0,,Неге жалғыз мен кінәлі болуым керек?➡
Dialogue: 0,0:10:58.92,0:11:01.65,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:11:01.65,0:11:03.69,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:03.69,0:11:08.89,Default,,0,0,0,,♬～
Dialogue: 0,0:11:10.83,0:11:12.93,Default,,0,0,0,,≫(Аюму) Сиқырлы қыз. Ах
Dialogue: 0,0:11:15.27,0:11:18.47,Default,,0,0,0,,, солай ма? таныс сияқтысың
Dialogue: 0,0:11:20.34,0:11:22.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:24.04,0:11:27.54,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:11:27.54,0:11:29.58,Default,,0,0,0,,)
Dialogue: 0,0:11:29.58,0:11:32.52,Default,,0,0,0,,Сен...｡ (Аюму) Менің ойымнан да асып түстің➡
Dialogue: 0,0:11:32.52,0:11:35.42,Default,,0,0,0,,Сіз? Сіз жігіттер? ➡
Dialogue: 0,0:11:35.42,0:11:38.39,Default,,0,0,0,,Жоқ, маңызды емес.➡
Dialogue: 0,0:11:38.39,0:11:42.06,Default,,0,0,0,,Мен жоғалтқан сезімдерімді қайтара аласың ба деп ойлаймын.
Dialogue: 0,0:11:42.06,0:11:44.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:44.09,0:11:46.70,Default,,0,0,0,,Біз ұйықтағымыз келмейді, солай ма?
Dialogue: 0,0:11:46.70,0:11:50.50,Default,,0,0,0,,Бір амал жоқ па? Сіз білесіз бе? ➡
Dialogue: 0,0:11:50.50,0:11:52.50,Default,,0,0,0,,Оны суырып алған адам.
Dialogue: 0,0:11:54.10,0:11:56.14,Default,,0,0,0,,Ах
Dialogue: 0,0:11:56.14,0:12:00.14,Default,,0,0,0,,Кешіріңіз, бірақ сіз осындай оғаш айыптауларды қоя аласыз ба?➡
Dialogue: 0,0:12:00.14,0:12:02.91,Default,,0,0,0,,Біз доспыз. Райо Каэде-сан
Dialogue: 0,0:12:02.91,0:12:05.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.78,0:12:07.82,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:12:07.82,0:12:11.56,Default,,0,0,0,,♬～
Dialogue: 0,0:12:11.56,0:12:13.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:16.16,0:12:20.53,Default,,0,0,0,,Жоқ... не! Сіз де оның достарының бірісіз бе?
Dialogue: 0,0:12:20.53,0:12:23.30,Default,,0,0,0,,Сіздің атыңыз кім? (Жүру) Ммм...｡➡
Dialogue: 0,0:12:23.30,0:12:25.60,Default,,0,0,0,,Аю... Аюму Фудзи
Dialogue: 0,0:12:25.60,0:12:29.11,Default,,0,0,0,,Мен оны есімде сақтаймын. Келесіде дос болайық.
Dialogue: 0,0:12:29.11,0:12:32.98,Default,,0,0,0,,♬～
Dialogue: 0,0:12:32.98,0:12:35.98,Default,,0,0,0,,Немесе…｡ Салқын
Dialogue: 0,0:12:35.98,0:12:40.78,Default,,0,0,0,,Кланк...(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:12:44.76,0:12:47.06,Default,,0,0,0,,≪Ооооо...
Dialogue: 0,0:12:50.69,0:12:53.49,Default,,0,0,0,,Кун Кун…
Dialogue: 0,0:13:01.34,0:13:03.34,Default,,0,0,0,,≪Нина-чан!
Dialogue: 0,0:13:06.34,0:13:12.84,Default,,0,0,0,,Гатанготон Гатанготон…
Dialogue: 0,0:15:15.54,0:15:17.87,Default,,0,0,0,,Гатанготон…
Dialogue: 0,0:15:17.87,0:15:20.24,Default,,0,0,0,,Нина-чан
Dialogue: 0,0:15:20.24,0:15:23.55,Default,,0,0,0,,Менің айтатын нәрсем бар. (Нина) Менің сенімен сөйлесетін ештеңем жоқ.
Dialogue: 0,0:15:23.55,0:15:26.22,Default,,0,0,0,,Қараңызшы, бұл Нина-чан ғой.
Dialogue: 0,0:15:26.22,0:15:28.69,Default,,0,0,0,,Иә! Менімен жай сөйлеспе! ➡
Dialogue: 0,0:15:28.69,0:15:30.72,Default,,0,0,0,,Хмм! Ах!
Dialogue: 0,0:15:30.72,0:15:33.59,Default,,0,0,0,,Мен сені кешірмеймін.➡
Dialogue: 0,0:15:33.59,0:15:36.39,Default,,0,0,0,,Әпкеңді қинап, бұрышқа сал➡
Dialogue: 0,0:15:36.39,0:15:40.26,Default,,0,0,0,,Артқа қайтару жоқ!
Dialogue: 0,0:15:40.26,0:15:42.70,Default,,0,0,0,,Сонда да сен маған көмектестің
Dialogue: 0,0:15:42.70,0:15:45.67,Default,,0,0,0,,Қазір де сол бала туралы ойлаймын...
Dialogue: 0,0:15:45.67,0:15:47.70,Default,,0,0,0,,Міне...
Dialogue: 0,0:15:47.70,0:15:49.84,Default,,0,0,0,,≪(Қыз) Мая! Ах
Dialogue: 0,0:15:49.84,0:15:53.74,Default,,0,0,0,,Мая, мықты бол! жедел жәрдем! Иә
Dialogue: 0,0:15:53.74,0:15:57.01,Default,,0,0,0,,Цк…｡ Қарақарақара…(Сөмкенің тартылған дыбысы)
Dialogue: 0,0:15:57.01,0:15:59.32,Default,,0,0,0,,Гее
Dialogue: 0,0:15:59.32,0:16:02.22,Default,,0,0,0,,Алдын ала рахмет.
Dialogue: 0,0:16:02.22,0:16:04.79,Default,,0,0,0,,Рё... Рё Каэде. (Рё Каэде) Тачибана
Dialogue: 0,0:16:04.79,0:16:08.96,Default,,0,0,0,,Не? Риокае Тачибана. Толық аты-жөні
Dialogue: 0,0:16:08.96,0:16:12.83,Default,,0,0,0,,Сіз ше? Ах... мен Рука Ханаримін.
Dialogue: 0,0:16:12.83,0:16:16.87,Default,,0,0,0,,Фу. Рука Ханари... Керемет есім екен.
Dialogue: 0,0:16:16.87,0:16:20.80,Default,,0,0,0,,Танысқаныма қуаныштымын, Кожика-чан. Хмм...
Dialogue: 0,0:16:20.80,0:16:23.34,Default,,0,0,0,,Айтпақшы, сен Ами-Рюді көрмедің бе?
Dialogue: 0,0:16:23.34,0:16:25.38,Default,,0,0,0,,Ами Рю?
Dialogue: 0,0:16:25.38,0:16:28.11,Default,,0,0,0,,) ((Бас!))
Dialogue: 0,0:16:28.11,0:16:30.15,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:16:30.15,0:16:33.68,Default,,0,0,0,,Ах. Ол әрқашан солай.
Dialogue: 0,0:16:33.68,0:16:37.25,Default,,0,0,0,,Бүгін бүгін, мен білмей тұрып ол кетіп қалды.
Dialogue: 0,0:16:37.25,0:16:39.29,Default,,0,0,0,,Сіз мені іздеп жүрсіз бе?
Dialogue: 0,0:16:39.29,0:16:41.89,Default,,0,0,0,,Ах. Барлық уақытта. иә?
Dialogue: 0,0:16:43.59,0:16:45.69,Default,,0,0,0,,Мен сені іздедім
Dialogue: 0,0:16:48.13,0:16:51.27,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мен әдеттегі жерде күтуім керек пе?
Dialogue: 0,0:16:51.27,0:16:54.27,Default,,0,0,0,,Кешіріңіз, бірақ менімен біраз уақыт араласа аласыз ба?
Dialogue: 0,0:16:55.84,0:17:15.86,Default,,0,0,0,,♬～
Dialogue: 0,0:17:15.86,0:17:18.86,Default,,0,0,0,,♬～
Dialogue: 0,0:17:18.86,0:17:21.87,Default,,0,0,0,,А... білесің бе? — Дарума-сан құлап қалды.
Dialogue: 0,0:17:21.87,0:17:24.90,Default,,0,0,0,,Жын «Дарума-сан осында» деп жатқанда...
Dialogue: 0,0:17:24.90,0:17:27.10,Default,,0,0,0,,Тыңдамаңыз! жоғал әрі!
Dialogue: 0,0:17:28.71,0:17:30.71,Default,,0,0,0,,А...
Dialogue: 0,0:17:33.51,0:17:35.58,Default,,0,0,0,,Мылтық! (Нина) А... Хм! ➡
Dialogue: 0,0:17:35.58,0:17:37.61,Default,,0,0,0,,Уф... Уф! ➡
Dialogue: 0,0:17:37.61,0:17:40.52,Default,,0,0,0,,Уф... Иә? Жаңа көрдім➡
Dialogue: 0,0:17:40.52,0:17:42.69,Default,,0,0,0,,Өйткені мен оны айналдырамын
Dialogue: 0,0:17:42.69,0:17:45.09,Default,,0,0,0,,Хмм...｡ Мм!
Dialogue: 0,0:17:48.33,0:17:50.96,Default,,0,0,0,,Онда маңызды нәрсе бар, солай ма?
Dialogue: 0,0:17:50.96,0:17:54.16,Default,,0,0,0,,Нина-чан мұны әрқашан өзімен бірге алып жүреді.
Dialogue: 0,0:17:56.73,0:17:58.90,Default,,0,0,0,,Ах
Dialogue: 0,0:17:58.90,0:18:02.57,Default,,0,0,0,,Білесің бе, Нина-чан... Мен сендермен ұрысамын➡
Dialogue: 0,0:18:02.57,0:18:05.74,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын. Хм... Қайдан білдің?
Dialogue: 0,0:18:05.74,0:18:09.41,Default,,0,0,0,,Сіз ойлаған нәрсе - болжам.
Dialogue: 0,0:18:09.41,0:18:12.91,Default,,0,0,0,,Мияко-чан да маған соны айтты. (Нина) Сіз білесіз бе?
Dialogue: 0,0:18:15.05,0:18:17.05,Default,,0,0,0,,Әпкеңе көмектесейік
Dialogue: 0,0:18:19.12,0:18:22.83,Default,,0,0,0,,Мен көмектескім келеді. Ей, ынтымақтасайық.
Dialogue: 0,0:18:22.83,0:18:26.30,Default,,0,0,0,,Бір адамнан екі адам артық, екі адамнан үш адам артық.
Dialogue: 0,0:18:26.30,0:18:29.60,Default,,0,0,0,,үшінмыз апамыздың сезімін қайтарайық.
Dialogue: 0,0:18:29.60,0:18:32.24,Default,,0,0,0,,Қайтып алайын деген ниетім болса ғой
Dialogue: 0,0:18:32.24,0:18:36.61,Default,,0,0,0,,Не? Нина Чан, бұл нені білдіреді?
Dialogue: 0,0:18:36.61,0:18:40.74,Default,,0,0,0,,Сіздің апаңыз енді сіз екеуміз білетін қарындас емес.
Dialogue: 0,0:18:40.74,0:18:43.65,Default,,0,0,0,,Га
Dialogue: 0,0:18:43.65,0:18:45.98,Default,,0,0,0,,Мен оның қандай сиқыр екенін білмеймін, бірақ➡
Dialogue: 0,0:18:45.98,0:18:48.92,Default,,0,0,0,,Сіздің әпкеңіз Шино сияқты болып қалды.➡
Dialogue: 0,0:18:48.92,0:18:50.95,Default,,0,0,0,,Мен мұны кешегі шайқастан білдім.
Dialogue: 0,0:18:50.95,0:18:53.56,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:18:53.56,0:18:57.29,Default,,0,0,0,,Үлкен апаның әлі де өз ойлары бар...
Dialogue: 0,0:18:57.29,0:19:00.83,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз. Мен сені тоқтатпаймын.
Dialogue: 0,0:19:00.83,0:19:05.27,Default,,0,0,0,,Ах. (Нина) Бірақ мен оны сезбедім➡
Dialogue: 0,0:19:05.27,0:19:08.97,Default,,0,0,0,,Әпкең сіз бен біз туралы не ойлайды?
Dialogue: 0,0:19:08.97,0:19:12.64,Default,,0,0,0,,Бұл да... Тіпті кішкентай саусағымның ұшы.➡
Dialogue: 0,0:19:12.64,0:19:14.64,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:14.64,0:19:16.78,Default,,0,0,0,,Кашан
Dialogue: 0,0:19:16.78,0:19:21.45,Default,,0,0,0,,Уақыты келгенде мен мұның бәрін аяқтауға ниеттемін.
Dialogue: 0,0:19:21.45,0:19:26.02,Default,,0,0,0,,Мен сені дұрыс емес жерден пышақтап алсам да, апаңды осы қолдарыммен ұстаймын...
Dialogue: 0,0:19:26.02,0:19:28.33,Default,,0,0,0,,Нина-чан...
Dialogue: 0,0:19:28.33,0:19:31.86,Default,,0,0,0,,Жоқ, бұл дұрыс емес. Мен әпкемді қорғаймын.
Dialogue: 0,0:19:31.86,0:19:34.93,Default,,0,0,0,,Анықтама. Әпкеңізді ойлаңыз➡
Dialogue: 0,0:19:34.93,0:19:37.83,Default,,0,0,0,,Момо-сан... бәрінің сезімін қайтарады!
Dialogue: 0,0:19:39.40,0:19:41.57,Default,,0,0,0,,Сіз білмедіңіз бе?
Dialogue: 0,0:19:41.57,0:19:43.97,Default,,0,0,0,,Ах
Dialogue: 0,0:19:43.97,0:19:47.74,Default,,0,0,0,,Фрагментті алып тастағаннан кейін оны қайтадан біріктіру мүмкін емес.
Dialogue: 0,0:19:47.74,0:19:49.78,Default,,0,0,0,,Не!
Dialogue: 0,0:19:49.78,0:20:05.23,Default,,0,0,0,,♬～
Dialogue: 0,0:20:05.23,0:20:07.26,Default,,0,0,0,,Тамақтану керек пе?
Dialogue: 0,0:20:07.26,0:20:11.27,Default,,0,0,0,,♬～
Dialogue: 0,0:20:11.27,0:20:13.47,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:20:15.61,0:20:17.91,Default,,0,0,0,,Кари кари кари (күріш кебегі тұздалған қиярды жеу дыбысы)
Dialogue: 0,0:20:19.51,0:20:21.54,Default,,0,0,0,,Мм... бұл қай жер?
Dialogue: 0,0:20:21.54,0:20:24.31,Default,,0,0,0,,Ами мен Идің кездесу орны.➡
Dialogue: 0,0:20:24.31,0:20:27.95,Default,,0,0,0,,Ал... естеліктер орны
Dialogue: 0,0:20:27.95,0:20:30.45,Default,,0,0,0,,Мен саған не үшін көмектескенімді білесің бе?
Dialogue: 0,0:20:30.45,0:20:33.49,Default,,0,0,0,,Не? Неге...
Dialogue: 0,0:20:33.49,0:20:36.63,Default,,0,0,0,,Өйткені сен сиқырлы қызсың. иә?
Dialogue: 0,0:20:36.63,0:20:40.06,Default,,0,0,0,,Бұрынғы қыздар қателеспеген.➡
Dialogue: 0,0:20:40.06,0:20:44.46,Default,,0,0,0,,Бұл сақина, солай ма? Мен оны Амирудан естідім.
Dialogue: 0,0:20:45.90,0:20:48.27,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:48.27,0:20:51.64,Default,,0,0,0,,Жоқ... неге Амиру олай жасайды...
Dialogue: 0,0:20:51.64,0:20:56.71,Default,,0,0,0,,Ойымды алып кетті Ами Рю да.
Dialogue: 0,0:20:56.71,0:20:59.91,Default,,0,0,0,,Сен сияқты сиқырлы қызға. Ах...
Dialogue: 0,0:21:01.62,0:21:04.79,Default,,0,0,0,,Фрагменттер қайтымсыз ма?
Dialogue: 0,0:21:04.79,0:21:07.99,Default,,0,0,0,,Маған бір рет жын шабуыл жасады.
Dialogue: 0,0:21:07.99,0:21:10.03,Default,,0,0,0,,Маған қызық, не нәрсеге сонша абдырап қалдың?
Dialogue: 0,0:21:10.03,0:21:13.93,Default,,0,0,0,,))
Dialogue: 0,0:21:13.93,0:21:16.57,Default,,0,0,0,,)
Dialogue: 0,0:21:16.57,0:21:18.74,Default,,0,0,0,,)
Dialogue: 0,0:21:18.74,0:21:22.61,Default,,0,0,0,,♬～
Dialogue: 0,0:21:22.61,0:21:27.04,Default,,0,0,0,,Алайда оның апама деген сезімі➡
Dialogue: 0,0:21:27.04,0:21:29.61,Default,,0,0,0,,Мүмкін олар ұқсас болғандықтан
Dialogue: 0,0:21:29.61,0:21:33.48,Default,,0,0,0,,Бірақ оның пайдасы болмады. Бірде ойымнан шығып кетті➡
Dialogue: 0,0:21:33.48,0:21:36.45,Default,,0,0,0,,Бұл оның енді ол адам емес екенін білдіреді.➡
Dialogue: 0,0:21:36.45,0:21:41.12,Default,,0,0,0,,Сіз азап пен азаптан басқа ештеңені сезбейсіз.➡
Dialogue: 0,0:21:41.12,0:21:44.42,Default,,0,0,0,,Ақырында терең ұйқыға кетеді
Dialogue: 0,0:21:46.13,0:21:49.80,Default,,0,0,0,,Бұл болғанға дейін... Жоқ, оның алдын алу үшін➡
Dialogue: 0,0:21:49.80,0:21:52.80,Default,,0,0,0,,Мен қолымнан келгеннің бәрін істеп жатырмын. Бірақ...
Dialogue: 0,0:21:52.80,0:21:56.11,Default,,0,0,0,,Мм... қалай ойлайсың, Амиру-сан?
Dialogue: 0,0:21:56.11,0:21:59.88,Default,,0,0,0,,Менің іздегенім осы еді.
Dialogue: 0,0:21:59.88,0:22:03.75,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:22:03.75,0:22:07.22,Default,,0,0,0,,Біз кішкентай кезімізден бірге болдық➡
Dialogue: 0,0:22:07.22,0:22:09.75,Default,,0,0,0,,Қарапайым тілмен айтқанда, біз бала кезден доспыз.➡
Dialogue: 0,0:22:09.75,0:22:11.79,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:22:11.79,0:22:15.46,Default,,0,0,0,,♬～
Dialogue: 0,0:22:15.46,0:22:20.26,Default,,0,0,0,,((Ах! Хэхехе. Ахахахахахахах!))
Dialogue: 0,0:22:20.26,0:22:24.07,Default,,0,0,0,,Ең жақын дос, әпке... Жоқ, олай емес.➡
Dialogue: 0,0:22:24.07,0:22:29.14,Default,,0,0,0,,Мен үшін Ами-Рю сөзбен айтып жеткізу мүмкін емес қатысуға айналды.
Dialogue: 0,0:22:29.14,0:22:32.21,Default,,0,0,0,,♬～
Dialogue: 0,0:22:32.21,0:22:36.41,Default,,0,0,0,,)
Dialogue: 0,0:22:36.41,0:22:38.51,Default,,0,0,0,,)
Dialogue: 0,0:22:40.08,0:22:42.62,Default,,0,0,0,,)
Dialogue: 0,0:22:42.62,0:22:44.65,Default,,0,0,0,,)
Dialogue: 0,0:22:44.65,0:22:48.96,Default,,0,0,0,,♬～
Dialogue: 0,0:22:48.96,0:22:52.36,Default,,0,0,0,,) ((А... иә))
Dialogue: 0,0:22:52.36,0:23:00.17,Default,,0,0,0,,♬～
Dialogue: 0,0:23:00.17,0:23:02.17,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:23:04.11,0:23:06.44,Default,,0,0,0,,((Кяа~! Саған бердім! Саған бердім!))
Dialogue: 0,0:23:06.44,0:23:08.84,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:23:10.15,0:23:12.78,Default,,0,0,0,,)
Dialogue: 0,0:23:12.78,0:23:14.82,Default,,0,0,0,,((Биылғы Валентин күні шоколады ➡
Dialogue: 0,0:23:14.82,0:23:18.96,Default,,0,0,0,,үшін неше? )) ((маған үзіліс беріңізші))
Dialogue: 0,0:23:18.96,0:23:23.26,Default,,0,0,0,,)
Dialogue: 0,0:23:23.26,0:23:26.26,Default,,0,0,0,,) (Ами-Рю)((Не? Кеттік))
Dialogue: 0,0:23:26.26,0:23:28.66,Default,,0,0,0,,)
Dialogue: 0,0:23:31.23,0:23:35.54,Default,,0,0,0,,Мен тым кінәсіз болдым. Мен бізді мәңгілік деп ойладым.➡
Dialogue: 0,0:23:35.54,0:23:40.58,Default,,0,0,0,,Ами Рюдің көңіл-күйіне мұқият болсам ғой.➡
Dialogue: 0,0:23:40.58,0:23:43.88,Default,,0,0,0,,Саған тезірек хабарлассам ғой...
Dialogue: 0,0:23:43.88,0:23:48.69,Default,,0,0,0,,)
Dialogue: 0,0:23:48.69,0:23:50.72,Default,,0,0,0,,)) ((≫(Рё Каэде) Ами Рю!➡
Dialogue: 0,0:23:50.72,0:23:54.12,Default,,0,0,0,,Хмм хаа... Хмм хаа ха...))
Dialogue: 0,0:23:54.12,0:23:57.46,Default,,0,0,0,,((Ами-Рю! Ами-Рю!➡
Dialogue: 0,0:23:57.46,0:23:59.46,Default,,0,0,0,,Ами Рю~! ))
Dialogue: 0,0:24:01.20,0:24:06.04,Default,,0,0,0,,Енді түсіндің бе? Момо болсын, басқа қыздар болсын➡
Dialogue: 0,0:24:06.04,0:24:08.24,Default,,0,0,0,,Мен енді ешқашан оянбаймын
Dialogue: 0,0:24:10.21,0:24:13.91,Default,,0,0,0,,Сізге тек әпкеңізді құтқару туралы ойлау керек.
Dialogue: 0,0:24:15.68,0:24:18.11,Default,,0,0,0,,Тек бір рет, солай ма? (Нина) А
Dialogue: 0,0:24:18.11,0:24:20.78,Default,,0,0,0,,Мен үзіндіні қайта біріктіруге тырыстым➡
Dialogue: 0,0:24:20.78,0:24:23.79,Default,,0,0,0,,Бұл бір рет қана болады, солай емес пе? (Нина) Бір рет жеткілікті.
Dialogue: 0,0:24:23.79,0:24:28.79,Default,,0,0,0,,Жоқ, бас тарт! Мен де әпкемнен бас тартпаймын.
Dialogue: 0,0:24:28.79,0:24:30.79,Default,,0,0,0,,Сонымен... иә?
Dialogue: 0,0:24:33.10,0:24:37.13,Default,,0,0,0,,Сізге жағатын дәрі жоқ. Қалағаныңды істе.➡
Dialogue: 0,0:24:37.13,0:24:39.60,Default,,0,0,0,,Ах... уф! Нина-чан!
Dialogue: 0,0:24:39.60,0:24:41.64,Default,,0,0,0,,Не болды? Сіздің асқазаныңыз ауырады ма?
Dialogue: 0,0:24:41.64,0:24:44.34,Default,,0,0,0,,Гррр...(асқазан дыбыстары)
Dialogue: 0,0:24:44.34,0:24:46.44,Default,,0,0,0,,«Жақсы~»? (Нина) Хмм... уф...
Dialogue: 0,0:24:47.88,0:24:52.18,Default,,0,0,0,,Ақырында мен сен үшін ештеңе істей алмадым.
Dialogue: 0,0:24:52.18,0:25:01.19,Default,,0,0,0,,♬～
Dialogue: 0,0:25:01.19,0:25:04.33,Default,,0,0,0,,Оны шағылыстырғыш деп атайды. (Рё Каэде) Иә?
Dialogue: 0,0:25:04.33,0:25:07.53,Default,,0,0,0,,Сиқырлы қыз емес. Және➡
Dialogue: 0,0:25:07.53,0:25:11.33,Default,,0,0,0,,Біздің рефлектор ретіндегі міндетіміз – ойымызды қорғау.
Dialogue: 0,0:25:11.33,0:25:14.34,Default,,0,0,0,,Бұл ешқашан алып кету туралы емес.
Dialogue: 0,0:25:14.34,0:25:16.37,Default,,0,0,0,,Рефлектор
Dialogue: 0,0:25:16.37,0:25:19.04,Default,,0,0,0,,≫(Ами Рю) Рё Каэде~! Ах
Dialogue: 0,0:25:19.04,0:25:21.08,Default,,0,0,0,,Хехе
Dialogue: 0,0:25:21.08,0:25:25.92,Default,,0,0,0,,Эй, сен қайтып келдің, солай ма? Арамыз қанша алыс болсада➡
Dialogue: 0,0:25:25.92,0:25:28.85,Default,,0,0,0,,Міне, біз кездестіреміз.
Dialogue: 0,0:25:28.85,0:25:31.25,Default,,0,0,0,,Райо Каэде! Хехе!
Dialogue: 0,0:25:33.72,0:25:36.36,Default,,0,0,0,,Мен уайымдадым, Амиру.
Dialogue: 0,0:25:36.36,0:25:39.66,Default,,0,0,0,,Кешіріңіз, мені кешіріңіз. Ах.
Dialogue: 0,0:25:42.40,0:25:45.84,Default,,0,0,0,,Бұл Рука Ханари.
Dialogue: 0,0:25:45.84,0:25:50.64,Default,,0,0,0,,Ами-санның ойларын қайтаратыныма сенімдімін
Dialogue: 0,0:25:50.64,0:25:53.51,Default,,0,0,0,,Менің ойым?
Dialogue: 0,0:25:53.51,0:26:00.22,Default,,0,0,0,,♬～
Dialogue: 0,0:26:00.22,0:26:05.19,Default,,0,0,0,,((мүмкіндігінше екі)) (Миген)((Жаңа гүлдер))
Dialogue: 0,0:26:05.19,0:26:09.53,Default,,0,0,0,,Жалпы есікті мүмкіндігінше тез ашу
Dialogue: 0,0:26:09.53,0:26:15.53,Default,,0,0,0,,♬～
Dialogue: 0,0:26:16.87,0:26:35.92,Default,,0,0,0,,♬～
Dialogue: 0,0:26:35.92,0:26:50.23,Default,,0,0,0,,♬～
Dialogue: 0,0:26:50.23,0:26:57.77,Default,,0,0,0,,♬～
Dialogue: 0,0:26:57.77,0:27:10.85,Default,,0,0,0,,♬～
Dialogue: 0,0:27:10.85,0:27:26.90,Default,,0,0,0,,♬～
Dialogue: 0,0:27:26.90,0:27:31.41,Default,,0,0,0,,♬～
Dialogue: 0,0:27:31.41,0:27:45.91,Default,,0,0,0,,♬～
Dialogue: 0,0:29:18.55,0:29:21.35,Default,,0,0,0,,Әр адамның жасыратын нәрсесі бар.
Dialogue: 0,0:29:21.35,0:29:24.19,Default,,0,0,0,,Дұрыс, мұның бәрі тек батылдық
Dialogue: 0,0:29:24.19,0:29:26.82,Default,,0,0,0,,Мм... Ямада мырза туралы.
Dialogue: 0,0:29:26.82,0:29:28.86,Default,,0,0,0,,Менің жоғалған сезімдерім туралы➡
Dialogue: 0,0:29:28.86,0:29:30.96,Default,,0,0,0,,Түсіндің бе? ешқашан берілме
Dialogue: 0,0:29:32.46,0:29:38.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
