Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.71,0:01:38.38,Default,,0,0,0,,♬～
Dialogue: 0,0:01:38.38,0:01:41.21,Default,,0,0,0,,Шино…｡ (2 адам) Ах.
Dialogue: 0,0:01:41.21,0:01:58.31,Default,,0,0,0,,♬～
Dialogue: 0,0:01:59.73,0:02:19.75,Default,,0,0,0,,♬～
Dialogue: 0,0:02:19.75,0:02:38.17,Default,,0,0,0,,♬～
Dialogue: 0,0:02:38.17,0:02:41.57,Default,,0,0,0,,♬～
Dialogue: 0,0:02:41.57,0:03:00.63,Default,,0,0,0,,♬～
Dialogue: 0,0:03:00.63,0:03:12.43,Default,,0,0,0,,♬～
Dialogue: 0,0:03:13.91,0:03:17.41,Default,,0,0,0,,♬～
Dialogue: 0,0:03:17.41,0:03:28.81,Default,,0,0,0,,♬～
Dialogue: 0,0:03:31.92,0:03:34.93,Default,,0,0,0,,Ах. (Хирахара Йосакури) Шино-чан...
Dialogue: 0,0:03:34.93,0:03:37.70,Default,,0,0,0,,Бұл ирониялық.➡
Dialogue: 0,0:03:37.70,0:03:41.30,Default,,0,0,0,,Барлықтарыңызбен жаңа әлемді қарсы алатыныма сене алар емеспін.
Dialogue: 0,0:03:41.30,0:03:43.33,Default,,0,0,0,,Жаңа әлем?
Dialogue: 0,0:03:43.33,0:03:56.71,Default,,0,0,0,,♬～
Dialogue: 0,0:03:56.71,0:04:00.42,Default,,0,0,0,,♬～
Dialogue: 0,0:04:00.42,0:04:03.99,Default,,0,0,0,,Фрагмент!? Қыздардың сезімі әлі де бар!
Dialogue: 0,0:04:03.99,0:04:06.89,Default,,0,0,0,,Жоқ Бұл сезім...
Dialogue: 0,0:04:06.89,0:04:09.83,Default,,0,0,0,,Иә, барлық ойлар кетті.
Dialogue: 0,0:04:09.83,0:04:12.90,Default,,0,0,0,,Иә! Бум!
Dialogue: 0,0:04:12.90,0:04:15.60,Default,,0,0,0,,Мынау... Не деген...
Dialogue: 0,0:04:20.84,0:04:24.24,Default,,0,0,0,,Ортақ - адам жүрегінің өзі.➡
Dialogue: 0,0:04:24.24,0:04:27.85,Default,,0,0,0,,Бұл дұрыс дүниені аяқтайды.➡
Dialogue: 0,0:04:27.85,0:04:30.31,Default,,0,0,0,,Жаңа принцип дүниеге келді➡
Dialogue: 0,0:04:30.31,0:04:33.35,Default,,0,0,0,,Сіздің рефлектор ретіндегі рөліңіз аяқталды.
Dialogue: 0,0:04:33.35,0:04:35.45,Default,,0,0,0,,Солай... (Мизуру) Қарғыс атсын!
Dialogue: 0,0:04:38.82,0:04:41.32,Default,,0,0,0,,Қайғыланудың қажеті жоқ
Dialogue: 0,0:04:47.70,0:04:50.30,Default,,0,0,0,,Ойсыз әлем➡
Dialogue: 0,0:04:50.30,0:04:53.00,Default,,0,0,0,,Бұл шынымен де тыныш және тыныш.➡
Dialogue: 0,0:04:54.31,0:04:58.34,Default,,0,0,0,,Онда түк те қорқыныштылық жоқ.
Dialogue: 0,0:04:58.34,0:05:00.31,Default,,0,0,0,,А...
Dialogue: 0,0:05:00.31,0:05:02.61,Default,,0,0,0,,Сіз де білуіңіз керек еді➡
Dialogue: 0,0:05:02.61,0:05:05.65,Default,,0,0,0,,Бұл қаншалықты жиіркенішті?
Dialogue: 0,0:05:05.65,0:05:08.59,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:05:08.59,0:05:11.99,Default,,0,0,0,,Уф! Шино-чан, тоқта!
Dialogue: 0,0:05:11.99,0:05:15.13,Default,,0,0,0,,Қарғыс атсын... бұл мен!
Dialogue: 0,0:05:15.13,0:05:18.00,Default,,0,0,0,,Ах. Сакурай!
Dialogue: 0,0:05:18.00,0:05:20.03,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:20.03,0:05:25.77,Default,,0,0,0,,♬～
Dialogue: 0,0:05:25.77,0:05:28.87,Default,,0,0,0,,Сен маған көмектесуге келмедің ғой?
Dialogue: 0,0:05:30.64,0:05:32.71,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:32.71,0:05:36.68,Default,,0,0,0,,Бассейн! Уф!
Dialogue: 0,0:05:36.68,0:05:40.98,Default,,0,0,0,,Уф! Ой... ааа...
Dialogue: 0,0:05:43.42,0:05:45.79,Default,,0,0,0,,Рука-чан! Иә
Dialogue: 0,0:05:45.79,0:05:47.79,Default,,0,0,0,,Бассейн!
Dialogue: 0,0:05:49.93,0:05:51.96,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:05:51.96,0:05:54.10,Default,,0,0,0,,Уф... аа
Dialogue: 0,0:05:54.10,0:05:57.13,Default,,0,0,0,,Бекер күресуді доғаршы.
Dialogue: 0,0:05:57.13,0:06:00.54,Default,,0,0,0,,Рефлектордың өмір сүруі аяқталды.
Dialogue: 0,0:06:00.54,0:06:03.34,Default,,0,0,0,,Мен ешқашан берілмеймін.
Dialogue: 0,0:06:04.61,0:06:09.31,Default,,0,0,0,,Осы уақытқа дейін бәрімізбен бірге келдік.
Dialogue: 0,0:06:09.31,0:06:11.35,Default,,0,0,0,,≪Міне, солай! ≫
Dialogue: 0,0:06:11.35,0:06:28.03,Default,,0,0,0,,♬～
Dialogue: 0,0:06:28.03,0:06:30.07,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:30.07,0:06:35.61,Default,,0,0,0,,♬～
Dialogue: 0,0:06:35.61,0:06:38.01,Default,,0,0,0,,Ах! Ах~!
Dialogue: 0,0:06:38.01,0:06:40.34,Default,,0,0,0,,Сұмдық көру мүмкін емес.➡
Dialogue: 0,0:06:40.34,0:06:43.34,Default,,0,0,0,,Мен дұрыс айттым.
Dialogue: 0,0:06:46.42,0:06:51.36,Default,,0,0,0,,Мидзусаки Шиноның шындығы қайғылы және оны құтқарудың жолы жоқ.➡
Dialogue: 0,0:06:51.36,0:06:56.76,Default,,0,0,0,,Қанша тырыссам да, баратын жерім үмітсіздіктен басқа ештеңе болмады.
Dialogue: 0,0:06:56.76,0:07:01.30,Default,,0,0,0,,((Хаа ха... хаа хаа...))
Dialogue: 0,0:07:01.30,0:07:03.33,Default,,0,0,0,,()
Dialogue: 0,0:07:03.33,0:07:08.77,Default,,0,0,0,,♬～
Dialogue: 0,0:07:08.77,0:07:12.08,Default,,0,0,0,,Бірақ мен біле алдым.➡
Dialogue: 0,0:07:12.08,0:07:15.38,Default,,0,0,0,,Өзгермейтін ақиқат... бұлтартпас тағдыр➡
Dialogue: 0,0:07:15.38,0:07:17.42,Default,,0,0,0,,өз өлімі
Dialogue: 0,0:07:17.42,0:07:19.45,Default,,0,0,0,,)
Dialogue: 0,0:07:19.45,0:07:26.19,Default,,0,0,0,,♬～
Dialogue: 0,0:07:26.19,0:07:28.29,Default,,0,0,0,,()
Dialogue: 0,0:07:28.29,0:07:31.30,Default,,0,0,0,,Ал құтқарудың жалғыз жолы –➡
Dialogue: 0,0:07:31.30,0:07:35.20,Default,,0,0,0,,Осы күш мені жетелеп тұрғанын түсінемін
Dialogue: 0,0:07:36.53,0:07:38.57,Default,,0,0,0,,)
Dialogue: 0,0:07:38.57,0:07:42.51,Default,,0,0,0,,♬～
Dialogue: 0,0:07:42.51,0:07:44.54,Default,,0,0,0,,)
Dialogue: 0,0:07:44.54,0:07:55.62,Default,,0,0,0,,♬～
Dialogue: 0,0:07:55.62,0:07:58.46,Default,,0,0,0,,((А...｡➡
Dialogue: 0,0:07:58.46,0:08:00.56,Default,,0,0,0,,Ах))
Dialogue: 0,0:08:02.13,0:08:05.23,Default,,0,0,0,,Мен жаңа жол таптым.➡
Dialogue: 0,0:08:06.73,0:08:09.50,Default,,0,0,0,,Сіз қажетсізсіз.
Dialogue: 0,0:08:09.50,0:08:12.60,Default,,0,0,0,,Ахх!
Dialogue: 0,0:08:12.60,0:08:16.54,Default,,0,0,0,,Маған қажет емес...
Dialogue: 0,0:08:16.54,0:08:18.61,Default,,0,0,0,,Бұл дұрыс емес, Шино!
Dialogue: 0,0:08:18.61,0:08:22.08,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:08:22.08,0:08:24.12,Default,,0,0,0,,Ах. Жоқ!
Dialogue: 0,0:08:24.12,0:08:26.32,Default,,0,0,0,,Жоғалыңыз. Башу!
Dialogue: 0,0:08:28.09,0:08:30.12,Default,,0,0,0,,Ах! Гррр...
Dialogue: 0,0:08:30.12,0:08:32.16,Default,,0,0,0,,Мизуру-сан! Әпке!
Dialogue: 0,0:08:32.16,0:08:35.59,Default,,0,0,0,,Ақымақ нәрсе. Әпке...
Dialogue: 0,0:08:35.59,0:08:39.09,Default,,0,0,0,,Уф... Шино, кешіріңіз.
Dialogue: 0,0:08:40.50,0:08:42.50,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:08:44.47,0:08:46.60,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:08:46.60,0:08:48.64,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:08:48.64,0:08:53.48,Default,,0,0,0,,♬～
Dialogue: 0,0:08:53.48,0:08:56.38,Default,,0,0,0,,Ол кезде мен сізге көмектесе алмадым➡
Dialogue: 0,0:08:56.38,0:09:00.35,Default,,0,0,0,,Кешіріңіз. Сізбен танысқаннан бері➡
Dialogue: 0,0:09:00.35,0:09:03.35,Default,,0,0,0,,Сіздің қасіретіңіз әрқашан менің ішімде болды.
Dialogue: 0,0:09:03.35,0:09:06.79,Default,,0,0,0,,♬～
Dialogue: 0,0:09:06.79,0:09:09.59,Default,,0,0,0,,Мен де сенің көптен бері күресіп жүргеніңді білемін.➡
Dialogue: 0,0:09:10.93,0:09:14.27,Default,,0,0,0,,Бұл бәрі емес. Сен де менің әлсіздігімсің➡
Dialogue: 0,0:09:14.27,0:09:16.97,Default,,0,0,0,,Ол маған қарсы тұрды. Ах.
Dialogue: 0,0:09:16.97,0:09:19.87,Default,,0,0,0,,Мен енді қашпаймын.➡
Dialogue: 0,0:09:19.87,0:09:22.87,Default,,0,0,0,,Мен сені ренжітетін барлық нәрседен қорғағым келеді➡
Dialogue: 0,0:09:22.87,0:09:24.91,Default,,0,0,0,,Бұл жолы. Кюн...
Dialogue: 0,0:09:24.91,0:09:28.28,Default,,0,0,0,,♬～
Dialogue: 0,0:09:28.28,0:09:31.45,Default,,0,0,0,,Га. (Мизуру) Бұл сезім өзгерген жоқ.
Dialogue: 0,0:09:31.45,0:09:35.15,Default,,0,0,0,,Бұдан былай да. Әпке...
Dialogue: 0,0:09:35.15,0:09:39.89,Default,,0,0,0,,♬～
Dialogue: 0,0:09:39.89,0:09:42.79,Default,,0,0,0,,Ах. Шино Чанның сезімі...
Dialogue: 0,0:09:44.43,0:09:47.20,Default,,0,0,0,,Мен адамдардың өмірін сақтайтын жұмыста істедім
Dialogue: 0,0:09:47.20,0:09:49.30,Default,,0,0,0,,Уф...｡ Әпке!
Dialogue: 0,0:09:50.63,0:09:54.41,Default,,0,0,0,,Сакурай, өтінемін
Dialogue: 0,0:09:54.41,0:09:56.44,Default,,0,0,0,,Не? Хмм...
Dialogue: 0,0:09:56.44,0:10:04.14,Default,,0,0,0,,♬～
Dialogue: 0,0:10:05.42,0:10:08.49,Default,,0,0,0,,♬～
Dialogue: 0,0:10:08.49,0:10:10.49,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:11.99,0:10:14.36,Default,,0,0,0,,Бұл көп уақытты алады
Dialogue: 0,0:10:14.36,0:10:17.70,Default,,0,0,0,,Үлкен әпке! (Мизуру)Шино➡
Dialogue: 0,0:10:17.70,0:10:20.20,Default,,0,0,0,,Сіз маңыздысыз!
Dialogue: 0,0:10:20.20,0:10:22.67,Default,,0,0,0,,Маған кірме!
Dialogue: 0,0:10:22.67,0:10:24.77,Default,,0,0,0,,Парин!
Dialogue: 0,0:10:26.77,0:10:29.47,Default,,0,0,0,,Оны құтқарудың жолы бар ма?
Dialogue: 0,0:10:35.15,0:10:37.15,Default,,0,0,0,,Рука-чан!
Dialogue: 0,0:10:39.45,0:10:42.05,Default,,0,0,0,,Маған ұнамайды... келме.
Dialogue: 0,0:10:42.05,0:10:44.05,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:45.92,0:10:48.69,Default,,0,0,0,,Лақтырсаңыз да➡
Dialogue: 0,0:10:48.69,0:10:51.10,Default,,0,0,0,,Мен бұл сезімді қабылдадым және ол кетпейді.
Dialogue: 0,0:10:51.10,0:10:54.43,Default,,0,0,0,,Дұрыс. Ол әрқашан осында болды.
Dialogue: 0,0:10:54.43,0:10:57.00,Default,,0,0,0,,Ол Шино-чанға көмектесемін деді!
Dialogue: 0,0:10:57.00,0:11:01.71,Default,,0,0,0,,♬～
Dialogue: 0,0:11:01.71,0:11:05.74,Default,,0,0,0,,Бишу! Башу!
Dialogue: 0,0:11:05.74,0:11:08.75,Default,,0,0,0,,Башун! Ах...ха!
Dialogue: 0,0:11:08.75,0:11:11.35,Default,,0,0,0,,Өтінемін! Келді!
Dialogue: 0,0:11:11.35,0:11:18.85,Default,,0,0,0,,♬～
Dialogue: 0,0:11:28.37,0:11:32.40,Default,,0,0,0,,Бұл...Шиноның ой әлемі ме?
Dialogue: 0,0:11:32.40,0:11:35.10,Default,,0,0,0,,Бұл саябақ...Сакурай
Dialogue: 0,0:11:36.97,0:11:39.04,Default,,0,0,0,,Ах
Dialogue: 0,0:11:39.04,0:11:41.85,Default,,0,0,0,,((Әпке? Үлкен әпке?➡
Dialogue: 0,0:11:41.85,0:11:44.55,Default,,0,0,0,,Қайда? Әпке! ))
Dialogue: 0,0:11:47.25,0:11:49.29,Default,,0,0,0,,()
Dialogue: 0,0:11:49.29,0:11:51.32,Default,,0,0,0,,)
Dialogue: 0,0:11:51.32,0:11:54.56,Default,,0,0,0,,♬～
Dialogue: 0,0:11:54.56,0:11:57.90,Default,,0,0,0,,Сол балалар... Ха.
Dialogue: 0,0:11:57.90,0:12:00.36,Default,,0,0,0,,деді Шино-чан
Dialogue: 0,0:12:00.36,0:12:03.36,Default,,0,0,0,,≪Шино-чан айтқысы келген адам...≫
Dialogue: 0,0:12:05.40,0:12:08.07,Default,,0,0,0,,≪Қолымды созғанда не бар еді...≫
Dialogue: 0,0:12:08.07,0:12:11.48,Default,,0,0,0,,♬～
Dialogue: 0,0:12:11.48,0:12:13.51,Default,,0,0,0,,)
Dialogue: 0,0:12:13.51,0:12:17.55,Default,,0,0,0,,♬～
Dialogue: 0,0:12:17.55,0:12:19.75,Default,,0,0,0,,≪Мен... болды ма? ≫
Dialogue: 0,0:14:23.04,0:14:26.08,Default,,0,0,0,,)
Dialogue: 0,0:14:26.08,0:14:28.11,Default,,0,0,0,,)
Dialogue: 0,0:14:28.11,0:14:31.82,Default,,0,0,0,,♬～
Dialogue: 0,0:14:31.82,0:14:34.32,Default,,0,0,0,,Ах...｡ Йо Сакурай
Dialogue: 0,0:14:34.32,0:14:38.26,Default,,0,0,0,,♬～
Dialogue: 0,0:14:38.26,0:14:41.36,Default,,0,0,0,,)
Dialogue: 0,0:14:41.36,0:14:45.10,Default,,0,0,0,,) ((Анашым, мен сізді іздеп жүрмін➡
Dialogue: 0,0:14:45.10,0:14:48.20,Default,,0,0,0,,Мен адасып қалдым...)) ((Хм...))
Dialogue: 0,0:14:52.67,0:14:56.17,Default,,0,0,0,,)
Dialogue: 0,0:14:56.17,0:14:58.67,Default,,0,0,0,,() ()
Dialogue: 0,0:15:00.88,0:15:03.51,Default,,0,0,0,,)
Dialogue: 0,0:15:03.51,0:15:07.68,Default,,0,0,0,,♬～
Dialogue: 0,0:15:07.68,0:15:09.82,Default,,0,0,0,,Менің кетуім керек. Иә.
Dialogue: 0,0:15:09.82,0:15:14.56,Default,,0,0,0,,♬～
Dialogue: 0,0:15:14.56,0:15:17.13,Default,,0,0,0,,≪Сәлем әпке➡
Dialogue: 0,0:15:17.13,0:15:20.93,Default,,0,0,0,,Мені таптың ба? ≫
Dialogue: 0,0:15:20.93,0:15:25.54,Default,,0,0,0,,≪Қолымды жібергің келмейді, солай ма?≫
Dialogue: 0,0:15:25.54,0:15:29.61,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:15:29.61,0:15:33.61,Default,,0,0,0,,<<Сол күннен бастап Шино Чанның ойын естіп тұрмын>>
Dialogue: 0,0:15:35.15,0:15:38.98,Default,,0,0,0,,≪Осылай алысқа кеткім келеді≫
Dialogue: 0,0:15:38.98,0:15:42.95,Default,,0,0,0,,≪Олай жасасам, апам екеуміз міндетті түрде жасаймыз➡
Dialogue: 0,0:15:42.95,0:15:47.49,Default,,0,0,0,,Біз жай ғана жақын егіз апа бола аламыз.➡
Dialogue: 0,0:15:47.49,0:15:51.69,Default,,0,0,0,,Неге сонша қорқасың? ≫
Dialogue: 0,0:15:53.53,0:15:58.20,Default,,0,0,0,,≪Мен оны бағалағым келеді, бірақ қолымнан келмейді ме? ≫
Dialogue: 0,0:15:58.20,0:16:01.74,Default,,0,0,0,,≪Сенгім келеді, бірақ қорқамын≫
Dialogue: 0,0:16:01.74,0:16:06.04,Default,,0,0,0,,≪Қара көлеңке барлық жерде мені аңдып жүр➡
Dialogue: 0,0:16:06.04,0:16:08.08,Default,,0,0,0,,Қашу мүмкін емес≫
Dialogue: 0,0:16:08.08,0:16:12.15,Default,,0,0,0,,♬～
Dialogue: 0,0:16:12.15,0:16:17.49,Default,,0,0,0,,≪Түсіндім... қаша алмаймын≫
Dialogue: 0,0:16:17.49,0:16:19.49,Default,,0,0,0,,()
Dialogue: 0,0:16:20.96,0:16:23.06,Default,,0,0,0,,)
Dialogue: 0,0:16:25.46,0:16:30.50,Default,,0,0,0,,Шино-чан, сен маған айтқың келген нәрсе көп еді.
Dialogue: 0,0:16:30.50,0:16:33.40,Default,,0,0,0,,Байқамай қалмаймын...
Dialogue: 0,0:16:34.84,0:16:38.01,Default,,0,0,0,,Біздің сезімдер қазір де жалғасуда.
Dialogue: 0,0:16:38.01,0:16:41.55,Default,,0,0,0,,Сіз әлі де байланыса аласыз
Dialogue: 0,0:16:41.55,0:16:44.72,Default,,0,0,0,,Дұрыс па? Рука-чан...
Dialogue: 0,0:16:44.72,0:16:47.08,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:47.08,0:16:50.48,Default,,0,0,0,,≪Иә, мен қаша алмаймын≫
Dialogue: 0,0:16:52.52,0:16:54.86,Default,,0,0,0,,≪Бірақ...≫ ≪Неге➡
Dialogue: 0,0:16:54.86,0:16:57.66,Default,,0,0,0,,Менің сезіміме қол тигізе алмайсың деп ойлаймын≫
Dialogue: 0,0:16:57.66,0:17:01.10,Default,,0,0,0,,♬～
Dialogue: 0,0:17:01.10,0:17:05.20,Default,,0,0,0,,≪Оны жоғалтқаннан кейін неге байқадың деп ойлаймын≫
Dialogue: 0,0:17:06.84,0:17:08.87,Default,,0,0,0,,≪Шино-чан! ≫
Dialogue: 0,0:17:08.87,0:17:11.77,Default,,0,0,0,,≪Неге көбірек сөйлеспедің?≫
Dialogue: 0,0:17:13.28,0:17:15.28,Default,,0,0,0,,≪Егер сол уақытта...≫
Dialogue: 0,0:17:18.22,0:17:20.68,Default,,0,0,0,,≪Сол күні...≫
Dialogue: 0,0:17:20.68,0:17:24.82,Default,,0,0,0,,≪Егер мен бұл дауысты байқасам≫
Dialogue: 0,0:17:24.82,0:17:29.19,Default,,0,0,0,,)
Dialogue: 0,0:17:29.19,0:17:33.53,Default,,0,0,0,,♬～
Dialogue: 0,0:17:33.53,0:17:35.53,Default,,0,0,0,,≪Біз сөйлескен кезде...➡
Dialogue: 0,0:17:37.10,0:17:39.14,Default,,0,0,0,,Егер ол хабарланған болса≫
Dialogue: 0,0:17:39.14,0:17:41.17,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:17:41.17,0:17:49.87,Default,,0,0,0,,♬～
Dialogue: 0,0:17:51.28,0:17:56.19,Default,,0,0,0,,Шино-чан, мен сені жібермеймін. Ах.
Dialogue: 0,0:17:56.19,0:17:58.19,Default,,0,0,0,,Ешқашан жіберме!
Dialogue: 0,0:18:00.46,0:18:03.16,Default,,0,0,0,,… …
Dialogue: 0,0:18:07.30,0:18:10.00,Default,,0,0,0,,Әрқашан ауыратын.➡
Dialogue: 0,0:18:10.00,0:18:14.07,Default,,0,0,0,,Күте тұрыңыз, менің тиесілі жерім жоқ➡
Dialogue: 0,0:18:14.07,0:18:16.97,Default,,0,0,0,,Әпкең де өлсін...
Dialogue: 0,0:18:16.97,0:18:20.64,Default,,0,0,0,,Мен ақымақ ойларды жек көретінмін. Мен олардан құтылуға тырыстым.
Dialogue: 0,0:18:20.64,0:18:25.74,Default,,0,0,0,,Менде бар болғаны осы болды. Мен... Мен қаша алмаймын.➡
Dialogue: 0,0:18:27.15,0:18:29.82,Default,,0,0,0,,Бір жолмен қайта-қайта жүріңіз.➡
Dialogue: 0,0:18:29.82,0:18:33.22,Default,,0,0,0,,Әйтпесе... өйткені мен...
Dialogue: 0,0:18:34.96,0:18:36.96,Default,,0,0,0,,Менің ойларым қорқынышты
Dialogue: 0,0:18:38.80,0:18:42.83,Default,,0,0,0,,♬～
Dialogue: 0,0:18:42.83,0:18:45.87,Default,,0,0,0,,Шино-чан сол жолмен жүрмейді
Dialogue: 0,0:18:45.87,0:18:48.91,Default,,0,0,0,,♬～
Dialogue: 0,0:18:48.91,0:18:53.34,Default,,0,0,0,,Шино-чан қорқатын болса, мен әрқашан оның жанында боламын.
Dialogue: 0,0:18:53.34,0:18:56.05,Default,,0,0,0,,Қолыңды қайта-қайта ұстаймын
Dialogue: 0,0:18:56.05,0:18:59.15,Default,,0,0,0,,Біреу мені тартып алмақ болса да➡
Dialogue: 0,0:18:59.15,0:19:01.15,Default,,0,0,0,,Ешқашан жібермеңіз
Dialogue: 0,0:19:03.69,0:19:07.42,Default,,0,0,0,,Тіпті бұл дүние де сенікі...➡
Dialogue: 0,0:19:07.42,0:19:11.56,Default,,0,0,0,,Біз қаласақ өзгерте аламыз
Dialogue: 0,0:19:11.56,0:19:15.17,Default,,0,0,0,,Иә. Эй, үйге бірге барамыз ба?
Dialogue: 0,0:19:15.17,0:19:21.34,Default,,0,0,0,,♬～
Dialogue: 0,0:19:21.34,0:19:23.47,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:23.47,0:19:28.85,Default,,0,0,0,,♬～
Dialogue: 0,0:19:28.85,0:19:32.45,Default,,0,0,0,,Мен жай ғана өзім болғым келеді
Dialogue: 0,0:19:32.45,0:19:41.46,Default,,0,0,0,,♬～
Dialogue: 0,0:19:41.46,0:19:45.26,Default,,0,0,0,,Аспанға қарап, көк деп айт➡
Dialogue: 0,0:19:45.26,0:19:47.56,Default,,0,0,0,,Мен терең тыныс алғым келеді.➡
Dialogue: 0,0:19:48.97,0:19:51.74,Default,,0,0,0,,Біреумен бірге болу қызық➡
Dialogue: 0,0:19:51.74,0:19:54.94,Default,,0,0,0,,Жүректен күліп, жыла...
Dialogue: 0,0:19:57.74,0:20:00.34,Default,,0,0,0,,Сіздің ойыңызды ешкім жоққа шығармайды➡
Dialogue: 0,0:20:00.34,0:20:04.31,Default,,0,0,0,,Мен өзімді жақсы көретін сияқтымын...
Dialogue: 0,0:20:04.31,0:20:08.32,Default,,0,0,0,,♬～
Dialogue: 0,0:20:08.32,0:20:12.69,Default,,0,0,0,,Мен сондай дүниеде өмір сүргім келеді
Dialogue: 0,0:20:12.69,0:20:15.49,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:15.49,0:20:17.53,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:20:17.53,0:20:36.51,Default,,0,0,0,,♬～
Dialogue: 0,0:20:36.51,0:20:45.96,Default,,0,0,0,,♬～
Dialogue: 0,0:20:45.96,0:20:48.29,Default,,0,0,0,,Рука-чан. Иә.
Dialogue: 0,0:20:48.29,0:21:08.31,Default,,0,0,0,,♬～
Dialogue: 0,0:21:08.31,0:21:11.98,Default,,0,0,0,,Ха... апа
Dialogue: 0,0:21:11.98,0:21:18.48,Default,,0,0,0,,♬～
Dialogue: 0,0:21:31.00,0:21:50.69,Default,,0,0,0,,♬～
Dialogue: 0,0:21:50.69,0:21:59.26,Default,,0,0,0,,♬～
Dialogue: 0,0:21:59.26,0:22:01.30,Default,,0,0,0,,Ах
Dialogue: 0,0:22:01.30,0:22:20.72,Default,,0,0,0,,♬～
Dialogue: 0,0:22:20.72,0:22:30.19,Default,,0,0,0,,♬～
Dialogue: 0,0:22:30.19,0:22:33.23,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:22:33.23,0:22:37.23,Default,,0,0,0,,Қараңдар, мен сендер мұны істей аласыңдар дедім.
Dialogue: 0,0:22:39.20,0:22:43.27,Default,,0,0,0,,Уф… уф…｡➡
Dialogue: 0,0:22:43.27,0:22:45.67,Default,,0,0,0,,Берілмегеніме қуаныштымын...
Dialogue: 0,0:22:48.01,0:22:50.05,Default,,0,0,0,,Ах... хмм
Dialogue: 0,0:22:50.05,0:23:01.56,Default,,0,0,0,,♬～
Dialogue: 0,0:23:01.56,0:23:03.59,Default,,0,0,0,,Ах
Dialogue: 0,0:23:03.59,0:23:09.23,Default,,0,0,0,,♬～
Dialogue: 0,0:23:09.23,0:23:12.94,Default,,0,0,0,,Рахмет, әпке.
Dialogue: 0,0:23:12.94,0:23:17.11,Default,,0,0,0,,Мен дұрыстап алға жылжимын.
Dialogue: 0,0:23:17.11,0:23:21.54,Default,,0,0,0,,Өз ойларыңызды бағалаңыз және оны жалғастырыңыз...➡
Dialogue: 0,0:23:21.54,0:23:23.58,Default,,0,0,0,,Мәңгі!
Dialogue: 0,0:23:23.58,0:23:27.45,Default,,0,0,0,,♬～
Dialogue: 0,0:23:27.45,0:23:30.12,Default,,0,0,0,,≪Менің ойларым...≫
Dialogue: 0,0:23:30.12,0:23:33.46,Default,,0,0,0,,≪Ойларыңыз қазір...≫
Dialogue: 0,0:23:33.46,0:23:35.49,Default,,0,0,0,,≪Мұнда≫
Dialogue: 0,0:23:35.49,0:23:38.56,Default,,0,0,0,,♬～
Dialogue: 0,0:23:38.56,0:23:41.30,Default,,0,0,0,,≪Менің ойларым...≫
Dialogue: 0,0:23:41.30,0:23:43.67,Default,,0,0,0,,≪Біз...≫
Dialogue: 0,0:23:43.67,0:23:45.70,Default,,0,0,0,,≪Қосылу≫
Dialogue: 0,0:23:45.70,0:23:53.00,Default,,0,0,0,,♬～
Dialogue: 0,0:23:54.34,0:24:11.84,Default,,0,0,0,,♬～(Орголдан «Жабайы раушан» музыкасы)
Dialogue: 0,0:24:14.20,0:24:16.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:16.23,0:24:19.57,Default,,0,0,0,,♬～
Dialogue: 0,0:24:19.57,0:24:21.60,Default,,0,0,0,,≪Ойлар біртүрлі≫
Dialogue: 0,0:24:21.60,0:24:28.28,Default,,0,0,0,,♬～
Dialogue: 0,0:24:28.28,0:24:31.88,Default,,0,0,0,,≪Дөңгелек немесе үшкір болады≫
Dialogue: 0,0:24:34.02,0:24:38.99,Default,,0,0,0,,≪Әрдайым жүрегімде, бірақ қолым тимейді≫
Dialogue: 0,0:24:38.99,0:24:47.33,Default,,0,0,0,,♬～
Dialogue: 0,0:24:47.33,0:24:51.94,Default,,0,0,0,,≪Мен туралы көбірек ойлайтыныңызға сенімдімін➡
Dialogue: 0,0:24:51.94,0:24:54.04,Default,,0,0,0,,Мен өзімді солай сезінемін➡
Dialogue: 0,0:24:55.71,0:24:58.51,Default,,0,0,0,,Сөзбен жеткізу қиын≫
Dialogue: 0,0:25:00.68,0:25:05.18,Default,,0,0,0,,≪Соған қарамастан, мен өзім бола алдым...≫
Dialogue: 0,0:25:05.18,0:25:12.89,Default,,0,0,0,,♬～
Dialogue: 0,0:25:12.89,0:25:14.92,Default,,0,0,0,,Ахаха
Dialogue: 0,0:25:14.92,0:25:23.40,Default,,0,0,0,,♬～
Dialogue: 0,0:25:23.40,0:25:26.04,Default,,0,0,0,,≪Себебі бәрі сонда болды≫
Dialogue: 0,0:25:26.04,0:25:30.54,Default,,0,0,0,,≪Себебі мен өз сезімімді бағалай білдім≫
Dialogue: 0,0:25:32.11,0:25:35.78,Default,,0,0,0,,Момо-сан да содан бері өзгере алмады.
Dialogue: 0,0:25:35.78,0:25:38.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:25:38.15,0:25:40.75,Default,,0,0,0,,Сен оны қорғай аласың ба?
Dialogue: 0,0:25:40.75,0:25:43.25,Default,,0,0,0,,Менің ойым өзгерген жоқ.
Dialogue: 0,0:25:43.25,0:25:45.76,Default,,0,0,0,,Жарайды
Dialogue: 0,0:25:45.76,0:25:48.16,Default,,0,0,0,,Ойлар байланысады
Dialogue: 0,0:25:48.16,0:25:58.57,Default,,0,0,0,,♬～
Dialogue: 0,0:25:58.57,0:26:00.57,Default,,0,0,0,,Кеттік! Иә
Dialogue: 0,0:26:02.54,0:26:04.57,Default,,0,0,0,,Банг (есік дыбысы)
Dialogue: 0,0:26:04.57,0:26:15.27,Default,,0,0,0,,♬～
Dialogue: 0,0:26:16.59,0:26:36.64,Default,,0,0,0,,♬～
Dialogue: 0,0:26:36.64,0:26:56.66,Default,,0,0,0,,♬～
Dialogue: 0,0:26:56.66,0:27:16.68,Default,,0,0,0,,♬～
Dialogue: 0,0:27:16.68,0:27:36.63,Default,,0,0,0,,♬～
Dialogue: 0,0:27:36.63,0:27:45.63,Default,,0,0,0,,♬～
