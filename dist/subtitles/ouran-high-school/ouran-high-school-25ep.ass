Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Жапония Маки
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Syura
Dialogue: 0,0:00:00.00,0:00:03.17,staff-ja,,0,0,0,,аударма күміс алма
Dialogue: 0,0:00:02.61,0:00:05.41,staff-ja,,0,0,0,,Mam
Dialogue: 0,0:00:03.08,0:00:06.75,Style2,,0,0,0,,«Мектеп жәрмеңкесі (43-ші Уран жәрмеңкесі)»
Dialogue: 0,0:00:06.75,0:00:10.26,Style2,,0,0,0,,«Жәрмеңке алдындағы таң»
Dialogue: 0,0:00:07.54,0:00:10.79,staff-ja,,0,0,0,,Сабақ кестесі Қара мысық пен сиыр қыз
Dialogue: 0,0:00:07.54,0:00:10.79,staff-ja,,0,0,0,,Наксияның әкімшілік жүйесі
Dialogue: 0,0:00:10.26,0:00:14.09,Style2,,0,0,0,,«Ашылу салтанатына дайындық»
Dialogue: 0,0:00:12.26,0:00:14.09,Style1,,0,0,0,,Барлық үстелдерді орталық ғимараттағы салонға апарыңыз.
Dialogue: 0,0:00:12.54,0:00:15.50,jp.sub-ja,,0,0,0,,Барлық үстелдер орталық ғимараттағы салонға апарылды.
Dialogue: 0,0:00:12.54,0:00:16.17,staff-ja,,0,0,0,,OP&ED Hagakure
Dialogue: 0,0:00:12.54,0:00:16.17,staff-ja,,0,0,0,,Сюра
Dialogue: 0,0:00:12.54,0:00:16.42,Default11-ja,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:00:14.09,0:00:15.76,Style1,,0,0,0,,Барлық үстелдерді орталық ғимараттағы салонға апарыңыз.
Dialogue: 0,0:00:15.76,0:00:18.26,Style1,,0,0,0,,- Оң. -Аа, абай болыңыз.
Dialogue: 0,0:00:16.50,0:00:17.93,jp.sub-ja,,0,0,0,,О, абай бол.
Dialogue: 0,0:00:18.26,0:00:21.60,Style1,,0,0,0,,Мм... мектеп жәрмеңкелері көп болуы керек емес пе, мен білмеймін,
Dialogue: 0,0:00:18.31,0:00:23.12,jp.sub-ja,,0,0,0,,Мектептегі фестивальдер оларға қолмен жасалған сезімді береді...
Dialogue: 0,0:00:21.60,0:00:26.61,Style1,,0,0,0,,үйдегідей, біз бәрін өз күшімізбен жасаған сияқтымыз ба?
Dialogue: 0,0:00:23.53,0:00:26.51,jp.sub-ja,,0,0,0,,Сіз бәрін өзіңіз жасайсыз ба?
Dialogue: 0,0:00:26.61,0:00:29.94,Style1,,0,0,0,,Сіз жалпы мектептер туралы айтып отырсыз.
Dialogue: 0,0:00:26.71,0:00:28.70,jp.sub-ja,,0,0,0,,Бұл жалпы мектептегі әңгіме болар еді.
Dialogue: 0,0:00:29.94,0:00:34.28,Style1,,0,0,0,,Оуран жәрмеңкесінде баса назар аударылатын нәрсе - жоспарлау және көшбасшылық.
Dialogue: 0,0:00:30.14,0:00:33.67,jp.sub-ja,,0,0,0,,Бұл Уран фестивалінің басты назары жоспарлау мен көшбасшылық дағдыларға бағытталған.
Dialogue: 0,0:00:34.28,0:00:38.42,Style1,,0,0,0,,Мұндағы студенттердің көпшілігі табиғатынан болашақ көшбасшы болады деп күтілуде,
Dialogue: 0,0:00:34.40,0:00:38.35,jp.sub-ja,,0,0,0,,Мұндағы студенттердің көпшілігі болашақ көшбасшылардың қасиеттеріне ие болады деп күтілуде.
Dialogue: 0,0:00:38.42,0:00:41.95,Style1,,0,0,0,,сондықтан олар өздерінің күшті жақтарымен барлығын таң қалдыруы керек.
Dialogue: 0,0:00:38.66,0:00:41.31,jp.sub-ja,,0,0,0,,Өзінің күшін көрсету үшін қажет
Dialogue: 0,0:00:47.39,0:00:50.40,Style1,,0,0,0,,Уа, ау!
Dialogue: 0,0:00:50.40,0:00:53.13,Style1,,0,0,0,,Бұл жақсы болды. Біз оларды қазір сізге тапсыра аламыз.
Dialogue: 0,0:00:50.52,0:00:52.70,jp.sub-ja,,0,0,0,,Бұл жақсы, мен оны енді саған қалдыра алмаймын.
Dialogue: 0,0:00:53.13,0:00:54.96,Style1,,0,0,0,,Хару-чан!
Dialogue: 0,0:00:53.26,0:00:54.43,jp.sub-ja,,0,0,0,,Хару-чан
Dialogue: 0,0:00:57.24,0:00:58.57,Style1,,0,0,0,,Кемеге шық, Харухи!
Dialogue: 0,0:00:57.26,0:00:58.29,jp.sub-ja,,0,0,0,,Харухиге мініңіз
Dialogue: 0,0:00:58.57,0:01:01.90,Style1,,0,0,0,,Біз Уран жәрмеңкесінің арнайы шеруіне дайындық үстіндеміз!
Dialogue: 0,0:00:58.67,0:01:01.42,jp.sub-ja,,0,0,0,,Бұл Уран фестивалінің арнайы шеруіне дайындық.
Dialogue: 0,0:01:02.24,0:01:04.04,Style2,,0,0,0,,«Ат арбасы?»
Dialogue: 0,0:01:04.24,0:01:06.91,Style1,,0,0,0,,Қараңдаршы, бұл Хост клубының балалары!
Dialogue: 0,0:01:04.47,0:01:06.86,jp.sub-ja,,0,0,0,,Қараңдар, қараңдаршы, барлығы қабылдаушы клубта.
Dialogue: 0,0:01:06.91,0:01:08.58,Style1,,0,0,0,,- Қандай керемет! - Қандай керемет!
Dialogue: 0,0:01:06.98,0:01:08.05,jp.sub-ja,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:01:08.58,0:01:10.57,Style1,,0,0,0,,Менің де солармен бірге мінгім келеді!
Dialogue: 0,0:01:08.93,0:01:10.26,jp.sub-ja,,0,0,0,,Менің де атқа мінгім келеді
Dialogue: 0,0:01:20.26,0:01:22.93,Style1,,0,0,0,,Эй, сен мұны жеңе алатындай алдың, иә?
Dialogue: 0,0:01:21.19,0:01:22.35,jp.sub-ja,,0,0,0,,Мен мұны істей бастадым.
Dialogue: 0,0:01:22.93,0:01:25.93,Style1,,0,0,0,,Каору, менімен бірге жаттығуға келуің керек еді.
Dialogue: 0,0:01:23.25,0:01:25.59,jp.sub-ja,,0,0,0,,Мен де Каорумен жаттығуым керек еді.
Dialogue: 0,0:01:25.93,0:01:29.60,Style1,,0,0,0,,Жақсы, тіпті егіздер де әртүрлі қызығушылықтар мен күшті костюмдерге ие болады.
Dialogue: 0,0:01:25.98,0:01:29.12,jp.sub-ja,,0,0,0,,Жақсы, тіпті егіздердің де хоббилері мен ерекше дағдылары әртүрлі.
Dialogue: 0,0:01:29.60,0:01:33.44,Style1,,0,0,0,,Бәріміздің осылай арбаға мінгеніміз қандай қызық, иә?
Dialogue: 0,0:01:29.78,0:01:33.29,jp.sub-ja,,0,0,0,,Осылай бірге арбаға міну қызық.
Dialogue: 0,0:01:33.44,0:01:34.94,Style1,,0,0,0,,Бұл?
Dialogue: 0,0:01:33.59,0:01:34.50,jp.sub-ja,,0,0,0,,Солай ма?
Dialogue: 0,0:01:34.94,0:01:36.94,Style1,,0,0,0,,Ертеңгі шеруде,
Dialogue: 0,0:01:35.06,0:01:39.27,jp.sub-ja,,0,0,0,,Ертеңгі шеру ортағасырлық француз стилінде безендіріледі.
Dialogue: 0,0:01:36.94,0:01:40.28,Style1,,0,0,0,,біз оларды ортағасырлық француз киімдерімен таң қалдырамыз.
Dialogue: 0,0:01:40.28,0:01:43.55,Style1,,0,0,0,,Бізде тіпті сен үшін нағыз жарқыраған костюм бар, Харухи.
Dialogue: 0,0:01:40.55,0:01:43.14,jp.sub-ja,,0,0,0,,Харухидің жарқыраған костюмі де бар.
Dialogue: 0,0:01:43.55,0:01:45.11,Style1,,0,0,0,,Жарқыраған, айтасыз ба?
Dialogue: 0,0:01:43.56,0:01:44.85,jp.sub-ja,,0,0,0,,Қандай жарқыраған...
Dialogue: 0,0:01:49.22,0:01:53.22,Style1,,0,0,0,,Міне, ашылу салтанаты басталып жатыр.
Dialogue: 0,0:01:49.30,0:01:52.64,jp.sub-ja,,0,0,0,,Енді ашылу салтанаты басталады.
Dialogue: 0,0:01:54.66,0:01:57.86,Style1,,0,0,0,,Осы Уран жәрмеңкесін мектеп тарих кітаптары үшін өткізейік.
Dialogue: 0,0:01:54.76,0:01:57.32,jp.sub-ja,,0,0,0,,Біз Уран фестивалін мектеп тарихында есте қалатын мерекеге айналдырамыз.
Dialogue: 0,0:01:59.90,0:02:01.23,Style1,,0,0,0,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:01:59.97,0:02:00.77,jp.sub-ja,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:02:10.98,0:02:14.91,Style2,,0,0,0,,«Оран жәрмеңкесінің ашылу салтанаты»
Dialogue: 0,0:02:33.90,0:02:37.10,Style2,,0,0,0,,«Орталық ғимарат салоны»
Dialogue: 0,0:02:39.01,0:02:42.37,Style2,,0,0,0,,«Хост клубы көпшілік үшін ашық»
Dialogue: 0,0:02:43.71,0:02:44.78,Style1,,0,0,0,,Есіңізде болсын,
Dialogue: 0,0:02:43.91,0:02:46.52,jp.sub-ja,,0,0,0,,Жарайды, мектеп фестивалі ретінде ерекше оқиға.
Dialogue: 0,0:02:44.78,0:02:46.88,Style1,,0,0,0,,мектеп жәрмеңкесі кезіндегі ерекше оқиға ретінде,
Dialogue: 0,0:02:46.88,0:02:49.88,Style1,,0,0,0,,Хост клубы барлық ата-аналар мен келушілер үшін ашық болады,
Dialogue: 0,0:02:46.97,0:02:48.41,jp.sub-ja,,0,0,0,,Барлық ата-аналар мен қонақтарға
Dialogue: 0,0:02:48.70,0:02:51.53,jp.sub-ja,,0,0,0,,Бүгін және ертең екі күн, менің қабылдаушы бөлімім жұртшылық үшін ашық болады.
Dialogue: 0,0:02:49.88,0:02:51.72,Style1,,0,0,0,,бүгін және ертең үшін,
Dialogue: 0,0:02:51.72,0:02:54.22,Style1,,0,0,0,,біз оларды одан да экстравагантты түрде қызықтырамыз,
Dialogue: 0,0:02:52.02,0:02:55.85,jp.sub-ja,,0,0,0,,Тұтынушыларға әдеттегіден әдемірек және гүлденген түрде қызмет көрсетіңіз.
Dialogue: 0,0:02:54.22,0:02:56.56,Style1,,0,0,0,,және әдеттегіден толық гүлдейді.
Dialogue: 0,0:02:56.56,0:03:00.89,Style1,,0,0,0,,Қараңызшы, анашым, бұл мен сізге үнемі айтып жүретін Хост клубы.
Dialogue: 0,0:02:56.88,0:03:00.57,jp.sub-ja,,0,0,0,,Қараңызшы, ана, бұл біз үнемі айтатын клуб.
Dialogue: 0,0:03:00.89,0:03:02.23,Style1,,0,0,0,,Бұл керемет емес пе?
Dialogue: 0,0:03:00.91,0:03:01.76,jp.sub-ja,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:03:02.23,0:03:05.57,Style1,,0,0,0,,Мен онша сенімді емеспін. Оларды барлық қыздар әбігерге салу үшін,
Dialogue: 0,0:03:02.25,0:03:03.29,jp.sub-ja,,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,0:03:03.60,0:03:05.39,jp.sub-ja,,0,0,0,,Бұл сәл әдемі болғандықтан
Dialogue: 0,0:03:05.57,0:03:09.40,Style1,,0,0,0,,олар біршама жақсы көрінетіндіктен...
Dialogue: 0,0:03:05.84,0:03:08.86,jp.sub-ja,,0,0,0,,Қалайша мұрныңызға тағып, әйелдердің көзайымына айналуға болады?
Dialogue: 0,0:03:09.29,0:03:10.52,jp.sub-ja,,0,0,0,,Иә, ханым.
Dialogue: 0,0:03:09.40,0:03:14.34,Style1,,0,0,0,,Расында да, ханым. Рас, бұл қорғалмайтын болуы мүмкін.
Dialogue: 0,0:03:11.28,0:03:13.46,jp.sub-ja,,0,0,0,,Сіз мені кешіре алмауыңыз мүмкін.
Dialogue: 0,0:03:14.34,0:03:17.24,Style1,,0,0,0,,Өйткені, бұл клубтың шын мақсаты бұдан артық емес
Dialogue: 0,0:03:14.53,0:03:16.66,jp.sub-ja,,0,0,0,,Өйткені бұл бөлімнің нақты мақсаты
Dialogue: 0,0:03:14.74,0:03:16.57,Style2,,0,0,0,,«Ақырын...»
Dialogue: 0,0:03:17.24,0:03:20.91,Style1,,0,0,0,,тіпті ең кішкентай сәтті өткізуге деген өзімшілдік қалауларымызды қанағаттандырудан гөрі
Dialogue: 0,0:03:17.33,0:03:20.51,jp.sub-ja,,0,0,0,,Ол ханым сияқты әдемі гүлмен біраз уақыт өткізгісі келеді.
Dialogue: 0,0:03:20.91,0:03:23.58,Style1,,0,0,0,,өзіңіз сияқты әдемі гүлдермен, ханым.
Dialogue: 0,0:03:20.98,0:03:23.11,jp.sub-ja,,0,0,0,,Бұл менің өзімшілдігім...
Dialogue: 0,0:03:23.58,0:03:25.25,Style1,,0,0,0,,О, менің...
Dialogue: 0,0:03:23.78,0:03:26.90,jp.sub-ja,,0,0,0,,Бұл қазірдің өзінде керемет.
Dialogue: 0,0:03:25.25,0:03:26.92,Style1,,0,0,0,,W-бұл жерде қандай керемет клуб бар!
Dialogue: 0,0:03:25.52,0:03:29.35,Style2,,0,0,0,,«Контр-мадам тактикасын қолдана отырып, бизнеске ашық»
Dialogue: 0,0:03:26.92,0:03:27.92,Style1,,0,0,0,,Иә, айтасыз!
Dialogue: 0,0:03:27.12,0:03:27.81,jp.sub-ja,,0,0,0,,...
Dialogue: 0,0:03:27.92,0:03:29.92,Style1,,0,0,0,,Сізге көп рахмет, ханым.
Dialogue: 0,0:03:28.05,0:03:29.74,jp.sub-ja,,0,0,0,,Рахмет, ханым.
Dialogue: 0,0:03:29.92,0:03:31.26,Style1,,0,0,0,,Жақсы қайғы.
Dialogue: 0,0:03:31.26,0:03:34.26,Style1,,0,0,0,,Түймеңіз қайтарылды, Мицукуни.
Dialogue: 0,0:03:31.35,0:03:33.50,jp.sub-ja,,0,0,0,,Түйме өшірулі, Мицукуни.
Dialogue: 0,0:03:34.06,0:03:35.46,jp.sub-ja,,0,0,0,,Хехе, рахмет
Dialogue: 0,0:03:34.26,0:03:35.60,Style1,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:03:35.60,0:03:37.26,Style1,,0,0,0,,Жаным, қандай жүрек жылытады!
Dialogue: 0,0:03:35.77,0:03:36.96,jp.sub-ja,,0,0,0,,Бұл мені күлдіреді
Dialogue: 0,0:03:37.17,0:03:40.41,jp.sub-ja,,0,0,0,,Мен сенің аға екеніңді білемін. Ініне көп көңіл бөлетін аға.
Dialogue: 0,0:03:37.26,0:03:40.60,Style1,,0,0,0,,Мен олардың ағайынды екеніне сенімдімін. Қандай ойшыл аға.
Dialogue: 0,0:03:40.58,0:03:41.70,jp.sub-ja,,0,0,0,,Әртүрлі
Dialogue: 0,0:03:40.60,0:03:41.94,Style1,,0,0,0,,Қыңқылдауды қой.
Dialogue: 0,0:03:41.94,0:03:44.20,Style1,,0,0,0,,Әкесі де, анасы да үнемі бос емес,
Dialogue: 0,0:03:42.24,0:03:43.67,jp.sub-ja,,0,0,0,,Әкем де, шешем де бос емес.
Dialogue: 0,0:03:44.20,0:03:48.04,Style1,,0,0,0,,сондықтан біз уақытымыздың көп бөлігін жалғыз өткізетінбіз, тек екеуміз ғана.
Dialogue: 0,0:03:44.39,0:03:47.71,jp.sub-ja,,0,0,0,,Уақытымыздың көп бөлігін бірге өткізетінбіз.
Dialogue: 0,0:03:48.04,0:03:51.88,Style1,,0,0,0,,Сондықтан екеуміз де үмітсіз жалғыздыққа айналдық.
Dialogue: 0,0:03:48.10,0:03:51.58,jp.sub-ja,,0,0,0,,Сондықтан біз үмітсіз жалғызбыз.
Dialogue: 0,0:03:51.88,0:03:54.21,Style1,,0,0,0,,- Әй, бейшара балалар! - Әй, бейшара балалар!
Dialogue: 0,0:03:52.02,0:03:53.93,jp.sub-ja,,0,0,0,,А...кедей...
Dialogue: 0,0:03:52.05,0:03:56.61,Style2,,0,0,0,,«Жылау...»
Dialogue: 0,0:03:54.21,0:03:56.82,Style1,,0,0,0,,Олар қай ауыздан сөйлеп тұр?
Dialogue: 0,0:03:54.46,0:03:56.19,jp.sub-ja,,0,0,0,,Қай ауыз сөйлейді?
Dialogue: 0,0:03:56.82,0:04:01.22,Style1,,0,0,0,,Бұл клубта біздің тақырыптарымыздың бірі – қоғамдық мәдениетті меңгеру,
Dialogue: 0,0:03:56.97,0:04:00.82,jp.sub-ja,,0,0,0,,Бұл бөлімнің тақырыбы әлеуметтік мәдениетті меңгеру, сондықтан
Dialogue: 0,0:04:01.22,0:04:04.22,Style1,,0,0,0,,сондықтан біз әртүрлі әдет-ғұрыптарды, ойын-сауықтарды,
Dialogue: 0,0:04:01.30,0:04:03.41,jp.sub-ja,,0,0,0,,Әр елдегі күнделікті оқиғалар мен ойындар
Dialogue: 0,0:04:03.71,0:04:07.23,jp.sub-ja,,0,0,0,,Біз тарихи этникалық киімдерді де кеңінен зерттейміз.
Dialogue: 0,0:04:04.22,0:04:07.23,Style1,,0,0,0,,және барлық елдерден күнделікті, тарихи дәстүрлі киім.
Dialogue: 0,0:04:07.23,0:04:09.23,Style1,,0,0,0,,О, бұл керемет.
Dialogue: 0,0:04:07.41,0:04:08.54,jp.sub-ja,,0,0,0,,Керемет
Dialogue: 0,0:04:09.23,0:04:12.43,Style1,,0,0,0,,Не деген ұятсыз саяси сөз.
Dialogue: 0,0:04:09.40,0:04:11.91,jp.sub-ja,,0,0,0,,Осыдан кейін, қолайлы нәрсені жасаңыз...
Dialogue: 0,0:04:17.64,0:04:20.91,Style1,,0,0,0,,Айта кету керек, бұл керемет оқиға.
Dialogue: 0,0:04:17.75,0:04:20.48,jp.sub-ja,,0,0,0,,Дегенмен, бұл сәнді оқиға.
Dialogue: 0,0:04:20.91,0:04:23.91,Style1,,0,0,0,,Жай мектеп жәрмеңкесіне жұмсалатын ақша тым көп.
Dialogue: 0,0:04:21.07,0:04:23.65,jp.sub-ja,,0,0,0,,Сіз мектеп мерекесіне тым көп ақша жұмсап жатырсыз.
Dialogue: 0,0:04:23.78,0:04:24.79,jp.sub-ja,,0,0,0,,Не айту керек
Dialogue: 0,0:04:23.91,0:04:27.58,Style1,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл үлкен науқан стратегиясы мүмкіндік
Dialogue: 0,0:04:25.09,0:04:25.84,jp.sub-ja,,0,0,0,,Осы орайда
Dialogue: 0,0:04:25.96,0:04:29.81,jp.sub-ja,,0,0,0,,Біз Ouran Host Club-тың үндеуін жұртшылыққа таратуды мақсат етеміз.
Dialogue: 0,0:04:27.58,0:04:29.92,Style1,,0,0,0,,Ouran Host Club-тың сүйкімділігін көрсету
Dialogue: 0,0:04:29.92,0:04:32.19,Style1,,0,0,0,,алыс және кең, бүкіл әлемде!
Dialogue: 0,0:04:30.13,0:04:32.94,jp.sub-ja,,0,0,0,,Бұл үлкен науқан операциясы...а
Dialogue: 0,0:04:32.19,0:04:32.84,Style2,,0,0,0,,«Шымшыңыз!»
Dialogue: 0,0:04:33.59,0:04:36.59,Style1,,0,0,0,,Дұрыс айтасыз, бұл үшін бюджетті артық жұмсадық.
Dialogue: 0,0:04:33.71,0:04:36.04,jp.sub-ja,,0,0,0,,Бұл жолы бюджетке тым көп жұмсағанымыз рас.
Dialogue: 0,0:04:36.59,0:04:37.92,Style1,,0,0,0,,Киоя...
Dialogue: 0,0:04:36.85,0:04:37.34,jp.sub-ja,,0,0,0,,Кагамия?
Dialogue: 0,0:04:37.92,0:04:39.93,Style1,,0,0,0,,Осы салонды пайдалануына қарамастан,
Dialogue: 0,0:04:38.23,0:04:39.55,jp.sub-ja,,0,0,0,,Бұл салон жақсы.
Dialogue: 0,0:04:39.93,0:04:43.26,Style1,,0,0,0,,Бізде Франциядан барлық жолмен ұшатын классикалық вагон бар еді.
Dialogue: 0,0:04:39.94,0:04:42.73,jp.sub-ja,,0,0,0,,Классикалық вагон Франциядан ұшақпен жеткізілді.
Dialogue: 0,0:04:43.26,0:04:45.20,Style1,,0,0,0,,Әдеттегідей,
Dialogue: 0,0:04:43.53,0:04:47.58,jp.sub-ja,,0,0,0,,Әдеттегідей, сіздің өзімшіл жоспарларыңыз ауыртпалық болып табылады.
Dialogue: 0,0:04:45.20,0:04:47.87,Style1,,0,0,0,,Мен сіздің барлық капризді жоспарларыңызбен қалай күресуге болатынын білмеймін.
Dialogue: 0,0:04:47.87,0:04:48.87,Style1,,0,0,0,,Бұл шындық емес пе?
Dialogue: 0,0:04:48.09,0:04:48.84,jp.sub-ja,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:48.87,0:04:51.54,Style1,,0,0,0,,Харухи! Эй, сен тыныш бол!
Dialogue: 0,0:04:48.98,0:04:49.51,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:04:50.09,0:04:51.53,jp.sub-ja,,0,0,0,,Иә, үндеме, үндеме.
Dialogue: 0,0:04:51.54,0:04:56.10,Style1,,0,0,0,,Қожайын патшаның қыңырлығы – баршаны қуантатын қыңырлығы!
Dialogue: 0,0:04:51.71,0:04:55.82,jp.sub-ja,,0,0,0,,Бұл Қожайын Патшаның өзімшілдігінің өзі – барлығын бақытты ететін өзімшілдік.
Dialogue: 0,0:05:01.05,0:05:01.90,jp.sub-ja,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:05:01.05,0:05:03.22,Style1,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:05:03.22,0:05:06.38,Style1,,0,0,0,,Саған жейтін тәтті нәрсе әкелсем бола ма?
Dialogue: 0,0:05:03.39,0:05:05.88,jp.sub-ja,,0,0,0,,Сізге тәтті нәрсе әкелгенімді қалайсыз ба?
Dialogue: 0,0:05:09.22,0:05:10.89,Style1,,0,0,0,,Сіз Хост клубының мүшесісіз бе?
Dialogue: 0,0:05:09.43,0:05:10.77,jp.sub-ja,,0,0,0,,Сіз де қабылдаушылар клубының мүшесісіз бе?
Dialogue: 0,0:05:10.89,0:05:12.23,Style1,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:05:12.23,0:05:13.82,Style1,,0,0,0,,Әке!
Dialogue: 0,0:05:12.42,0:05:12.92,jp.sub-ja,,0,0,0,,Әкем
Dialogue: 0,0:05:15.40,0:05:20.90,Style1,,0,0,0,,«Әке» тым таныс. Мектепте жүргенде маған «Бастық» деп хабарласыңыз.
Dialogue: 0,0:05:15.49,0:05:17.45,jp.sub-ja,,0,0,0,,Мен әкеммен таныспын.
Dialogue: 0,0:05:17.83,0:05:21.00,Style2,,0,0,0,,«Мектеп кеңесінің төрағасы Юдзуру Суу»
Dialogue: 0,0:05:18.37,0:05:20.07,jp.sub-ja,,0,0,0,,Академияда мені президент деп атауға болады.
Dialogue: 0,0:05:20.90,0:05:24.90,Style1,,0,0,0,,Оның үстіне мен бүгін қонақ болып отырмын.
Dialogue: 0,0:05:20.97,0:05:23.27,jp.sub-ja,,0,0,0,,Оның үстіне мен бүгін қонақ болып келдім.
Dialogue: 0,0:05:21.00,0:05:23.37,Style2,,0,0,0,,«...Тамакидің әкесі...»
Dialogue: 0,0:05:24.90,0:05:27.07,Style1,,0,0,0,,Қош келдіңіз, басшы.
Dialogue: 0,0:05:25.09,0:05:26.40,jp.sub-ja,,0,0,0,,Қош келдіңіз, төраға
Dialogue: 0,0:05:27.07,0:05:29.24,Style1,,0,0,0,,Келіңіз, мына жерге отырыңыз.
Dialogue: 0,0:05:27.20,0:05:28.98,jp.sub-ja,,0,0,0,,Мына орынға отырыңыз.
Dialogue: 0,0:05:29.24,0:05:31.07,Style1,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:05:29.38,0:05:29.93,jp.sub-ja,,0,0,0,,Рахмет
Dialogue: 0,0:05:32.25,0:05:36.92,Style1,,0,0,0,,Кёя-кун, бұл клуб сенің басшылығыңа қарыздар емес пе?
Dialogue: 0,0:05:32.32,0:05:36.23,jp.sub-ja,,0,0,0,,Кёуя-кун, сен де осы клубты басқарсаң жақсы болар еді.
Dialogue: 0,0:05:36.92,0:05:38.70,jp.sub-ja,,0,0,0,,Жаман ұл қиындық туғызуда.
Dialogue: 0,0:05:36.92,0:05:38.92,Style1,,0,0,0,,Менің ұлым саған қиындық тудырмауы керек.
Dialogue: 0,0:05:38.92,0:05:42.92,Style1,,0,0,0,,Мүлде жоқ. Хост клубы соның арқасында осында.
Dialogue: 0,0:05:39.12,0:05:42.10,jp.sub-ja,,0,0,0,,Жоқ, ол қабылдаушы клубты жасайды.
Dialogue: 0,0:05:42.92,0:05:45.19,Style1,,0,0,0,,Мен сізге бірдеңе ала аламын ба?
Dialogue: 0,0:05:43.01,0:05:44.11,jp.sub-ja,,0,0,0,,Бір нәрсеге тапсырыс бергіңіз келе ме?
Dialogue: 0,0:05:46.59,0:05:49.56,Style2,,0,0,0,,«Сыбырлау»
Dialogue: 0,0:05:46.59,0:05:49.86,Style1,,0,0,0,,Иә... иә... қалағаныңызша.
Dialogue: 0,0:05:46.68,0:05:49.37,jp.sub-ja,,0,0,0,,Иә Иә мен ақылдымын
Dialogue: 0,0:05:49.86,0:05:51.20,Style1,,0,0,0,,Харухи, сенің өтінішің бар.
Dialogue: 0,0:05:50.12,0:05:51.28,jp.sub-ja,,0,0,0,,Харухи, сіз ұсынылып отырсыз.
Dialogue: 0,0:05:51.20,0:05:52.53,Style1,,0,0,0,,Не!?
Dialogue: 0,0:05:51.28,0:05:51.90,jp.sub-ja,,0,0,0,,Не? !
Dialogue: 0,0:05:57.20,0:05:59.54,Style1,,0,0,0,,Сонымен, сіз Фудзиока Харухи-кунсыз, солай ма?
Dialogue: 0,0:05:57.46,0:05:59.43,jp.sub-ja,,0,0,0,,Эй, мен Харухи Фудзиокамын.
Dialogue: 0,0:05:59.54,0:06:01.71,Style1,,0,0,0,,Келіңіздер, отырыңыздар.
Dialogue: 0,0:05:59.80,0:06:01.15,jp.sub-ja,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:06:01.71,0:06:03.37,Style1,,0,0,0,,Сіздің рұқсатыңыз бойынша.
Dialogue: 0,0:06:01.85,0:06:02.69,jp.sub-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:04.88,0:06:08.21,Style1,,0,0,0,,Бұл кісі Тамаки-сенпайдың әкесі ме?
Dialogue: 0,0:06:05.02,0:06:07.60,jp.sub-ja,,0,0,0,,Бұл кісі Тамаки-сенпайдың әкесі.
Dialogue: 0,0:06:08.21,0:06:11.05,Style1,,0,0,0,,Олар онша ұқсамайды...
Dialogue: 0,0:06:08.36,0:06:10.25,jp.sub-ja,,0,0,0,,Бір-біріне ұқсамайды... Менің ойымша
Dialogue: 0,0:06:11.05,0:06:13.89,Style1,,0,0,0,,Танысқаныма қуаныштымын. Мен ойладым
Dialogue: 0,0:06:11.26,0:06:12.09,jp.sub-ja,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:06:12.92,0:06:17.15,jp.sub-ja,,0,0,0,,Мен төрағамен тезірек амандасу керек деп ойладым.
Dialogue: 0,0:06:13.89,0:06:17.56,Style1,,0,0,0,,, мен сізге тезірек құрмет көрсетуім керек еді, басшы.
Dialogue: 0,0:06:17.56,0:06:23.05,Style1,,0,0,0,,«Суперинтендент» өте тұнық. Сіз... иә...
Dialogue: 0,0:06:17.67,0:06:19.67,jp.sub-ja,,0,0,0,,Оның төраға болғаны жиіркенішті.
Dialogue: 0,0:06:20.38,0:06:22.54,jp.sub-ja,,0,0,0,,Мен болсам...
Dialogue: 0,0:06:24.56,0:06:29.73,Style1,,0,0,0,,Сіз мені... «Ағай» деп атасаңыз болады.
Dialogue: 0,0:06:24.88,0:06:29.35,jp.sub-ja,,0,0,0,,Маған «О-джи-са-ма» деп қоңырау шалыңыз.
Dialogue: 0,0:06:31.50,0:06:35.24,Style1,,0,0,0,,Ол Тамаки-сенпайдың әкесі, жарайды.
Dialogue: 0,0:06:31.56,0:06:33.85,jp.sub-ja,,0,0,0,,Ол Тамаки-сенпайдың әкесі ғой.
Dialogue: 0,0:06:35.24,0:06:39.41,Style1,,0,0,0,,Мен өте бос емеспін, мен кампусты көп аралай алмадым,
Dialogue: 0,0:06:35.36,0:06:38.99,jp.sub-ja,,0,0,0,,Менің бос еместігім сонша, мектепке бара алмаймын.
Dialogue: 0,0:06:39.41,0:06:42.92,Style1,,0,0,0,,бірақ мен сіздің ерекше екеніңізді үнемі естимін.
Dialogue: 0,0:06:39.53,0:06:42.31,jp.sub-ja,,0,0,0,,Мен сенің жақсылығыңды естіп келемін.
Dialogue: 0,0:06:42.87,0:06:44.31,jp.sub-ja,,0,0,0,,Ха...сәлеметсіз бе
Dialogue: 0,0:06:42.92,0:06:44.85,Style1,,0,0,0,,Неге, рахмет.
Dialogue: 0,0:06:46.52,0:06:48.19,Style1,,0,0,0,,Егер сізде қандай да бір қиындық туындаса,
Dialogue: 0,0:06:46.58,0:06:47.84,jp.sub-ja,,0,0,0,,Егер сізде қандай да бір қиындық болса
Dialogue: 0,0:06:48.19,0:06:51.52,Style1,,0,0,0,,Ағаңа кез келген уақытта келіп айт.
Dialogue: 0,0:06:48.23,0:06:51.07,jp.sub-ja,,0,0,0,,Бұл қартқа кез келген уақытта айта аласыз.
Dialogue: 0,0:06:51.52,0:06:52.19,Style1,,0,0,0,,Әрине...
Dialogue: 0,0:06:52.19,0:06:53.86,Style1,,0,0,0,,Әке!
Dialogue: 0,0:06:52.34,0:06:53.35,jp.sub-ja,,0,0,0,,Әкем…
Dialogue: 0,0:06:53.86,0:06:55.52,Style1,,0,0,0,,Мені «Басқарушы» деп атаңыз!
Dialogue: 0,0:06:53.99,0:06:54.89,jp.sub-ja,,0,0,0,,Мені төраға деп атаңыз
Dialogue: 0,0:06:57.20,0:06:58.87,Style1,,0,0,0,,Сіз не істеп жатырсыз!?
Dialogue: 0,0:06:57.39,0:06:58.62,jp.sub-ja,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:58.87,0:07:01.20,Style1,,0,0,0,,Қолдарыңызды бірден алыңыз, өтінемін!
Dialogue: 0,0:06:58.99,0:07:00.90,jp.sub-ja,,0,0,0,,Өтінемін, бұл қолды дереу жіберіңіз.
Dialogue: 0,0:07:06.54,0:07:07.87,Style1,,0,0,0,,Кёя-сенпай!
Dialogue: 0,0:07:06.55,0:07:07.50,jp.sub-ja,,0,0,0,,Кёуя Сенпай
Dialogue: 0,0:07:09.21,0:07:12.87,Style1,,0,0,0,,Бұл сіз болған күлкілі клуб па?
Dialogue: 0,0:07:09.33,0:07:12.05,jp.sub-ja,,0,0,0,,Сіз осындай ақымақ үйірмелерге қатыстыңыз ба?
Dialogue: 0,0:07:14.55,0:07:16.88,Style1,,0,0,0,,Бұл Кио Чанның әкесі, солай ма?
Dialogue: 0,0:07:14.72,0:07:16.73,jp.sub-ja,,0,0,0,,Кагами-чанның әкесі... солай ма?
Dialogue: 0,0:07:16.88,0:07:18.22,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:07:18.15,0:07:20.12,Style2,,0,0,0,,«Ёшио Отори»
Dialogue: 0,0:07:18.22,0:07:22.14,Style1,,0,0,0,,Сіз мені ұятқа қалдырғыңыз келе ме?
Dialogue: 0,0:07:18.44,0:07:20.49,jp.sub-ja,,0,0,0,,Сіз мені ұятқа қалдырғыңыз келе ме?
Dialogue: 0,0:07:20.12,0:07:22.14,Style2,,0,0,0,,«Киёяның әкесі»
Dialogue: 0,0:07:24.56,0:07:27.89,Style1,,0,0,0,,Егер ол Суу-сан болмаса. Мұны көргеніңізге өкінемін.
Dialogue: 0,0:07:24.64,0:07:27.45,jp.sub-ja,,0,0,0,,Бұл жағымсыз нәрсе, Суо мырза.
Dialogue: 0,0:07:27.89,0:07:31.56,Style1,,0,0,0,,Бұл Киоя-кун сияқты өте қатал болды.
Dialogue: 0,0:07:28.09,0:07:31.38,jp.sub-ja,,0,0,0,,Кьюя-кун керемет болса да, бұл өте қиын.
Dialogue: 0,0:07:31.56,0:07:34.23,Style1,,0,0,0,,Осындай төрт баласы бар адам үшін,
Dialogue: 0,0:07:31.79,0:07:33.99,jp.sub-ja,,0,0,0,,Төрт баласы жақсы болған
Dialogue: 0,0:07:34.23,0:07:38.24,Style1,,0,0,0,,Сіздің ашкөздігіңіз шынымен де тереңде жатыр.
Dialogue: 0,0:07:34.47,0:07:36.63,jp.sub-ja,,0,0,0,,Сен өте сараңсың.
Dialogue: 0,0:07:38.24,0:07:40.57,Style1,,0,0,0,,Мен жаңалықты естідім.
Dialogue: 0,0:07:38.47,0:07:39.88,jp.sub-ja,,0,0,0,,Мен сізді тыңдаймын.
Dialogue: 0,0:07:40.57,0:07:44.34,Style1,,0,0,0,,Баспасөз шу шығара бастағанға дейін уақыт мәселесі.
Dialogue: 0,0:07:40.74,0:07:43.62,jp.sub-ja,,0,0,0,,Бұқаралық ақпарат құралдарының шу шығаруы уақыт мәселесі шығар.
Dialogue: 0,0:07:44.34,0:07:48.18,Style1,,0,0,0,,Маған айтыңызшы, сіз онымен айналысқан жоқсыз.
Dialogue: 0,0:07:44.54,0:07:47.01,jp.sub-ja,,0,0,0,,Менің ойымша, бұл хит емес.
Dialogue: 0,0:07:49.85,0:07:51.85,Style1,,0,0,0,,Кёя, жақсысың ба?
Dialogue: 0,0:07:49.99,0:07:51.15,jp.sub-ja,,0,0,0,,Кёуя, жақсысың ба?
Dialogue: 0,0:07:51.85,0:07:53.85,Style1,,0,0,0,,Не деген сұмдық папа!
Dialogue: 0,0:07:52.06,0:07:53.41,jp.sub-ja,,0,0,0,,Қандай әке
Dialogue: 0,0:07:53.85,0:07:56.52,Style1,,0,0,0,,Иә, көзілдірік киген адамды осылай ұру.
Dialogue: 0,0:07:53.94,0:07:56.19,jp.sub-ja,,0,0,0,,Көзілдірік киген адамды ұру.
Dialogue: 0,0:07:56.52,0:07:58.86,Style1,,0,0,0,,Жоқ, ол бұлай айтқысы келген жоқ.
Dialogue: 0,0:07:56.60,0:07:58.27,jp.sub-ja,,0,0,0,,Жоқ, бұл сіз айтып тұрған жоқсыз.
Dialogue: 0,0:07:58.86,0:08:02.53,Style1,,0,0,0,,Ол сізді Хост клубында болғаныңыз үшін ұрды ма?
Dialogue: 0,0:07:59.01,0:08:01.82,jp.sub-ja,,0,0,0,,Сізді қабылдаушы клубтың мүшесі болғаныңыз үшін ұрып-соқтыңыз ба?
Dialogue: 0,0:08:02.53,0:08:04.86,Style1,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:08:02.71,0:08:03.68,jp.sub-ja,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:08:04.86,0:08:07.20,Style1,,0,0,0,,Мен мұны күттім.
Dialogue: 0,0:08:04.92,0:08:06.38,jp.sub-ja,,0,0,0,,Мен мұны күттім.
Dialogue: 0,0:08:11.14,0:08:14.60,Style1,,0,0,0,,Бұл... Хост клубының себебі болды ма?
Dialogue: 0,0:08:11.28,0:08:13.70,jp.sub-ja,,0,0,0,,Бұл қабылдаушы бөлімнің кінәсі ме?
Dialogue: 0,0:08:16.61,0:08:19.88,Style1,,0,0,0,,Сіздің құмарлығыңыз қымбатқа түседі.
Dialogue: 0,0:08:16.86,0:08:19.05,jp.sub-ja,,0,0,0,,Өзімшілдік қымбат
Dialogue: 0,0:08:19.88,0:08:24.22,Style1,,0,0,0,,Қарапайым адамдарға қарағанда үлкен жауапкершілікті қызметте тұру
Dialogue: 0,0:08:20.10,0:08:23.75,jp.sub-ja,,0,0,0,,Қарапайым адамға қарағанда жауапты қызметте болу нені білдіреді?
Dialogue: 0,0:08:24.22,0:08:26.55,Style1,,0,0,0,,сонымен қатар сіздің бұдан былай қудалай алмайтыныңызды білдіреді
Dialogue: 0,0:08:24.26,0:08:26.07,jp.sub-ja,,0,0,0,,Маған ұнайтын нәрсе Маған ұнайтын нәрсе
Dialogue: 0,0:08:26.55,0:08:31.56,Style1,,0,0,0,,сізге ұнайтын нәрселер, сізге ұнайтын заттар немесе сізге ұнайтын адамдар.
Dialogue: 0,0:08:26.76,0:08:30.36,jp.sub-ja,,0,0,0,,Сондай-ақ бұл сізге ұнайтын адаммен еркін айналыса алмайтыныңызды білдіреді.
Dialogue: 0,0:08:31.56,0:08:33.33,Style1,,0,0,0,,Харухи-кун!
Dialogue: 0,0:08:31.68,0:08:32.73,jp.sub-ja,,0,0,0,,Харухи-кун
Dialogue: 0,0:08:33.33,0:08:34.99,Style1,,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:08:36.23,0:08:38.97,Style1,,0,0,0,,Бос емес кестеңізден уақыт бөлгеніңіз үшін көп рахмет
Dialogue: 0,0:08:36.27,0:08:39.14,jp.sub-ja,,0,0,0,,Жұмыс кестесінің тығыздығына қарамастан қабылдау бөліміне келгеніңіз үшін рахмет.
Dialogue: 0,0:08:38.97,0:08:41.63,Style1,,0,0,0,,бүгін бізге Хост клубына келіңіз.
Dialogue: 0,0:08:39.24,0:08:40.24,jp.sub-ja,,0,0,0,,Рахмет
Dialogue: 0,0:08:43.24,0:08:47.24,Style1,,0,0,0,,Бұдан былай не істегіңіз келеді?
Dialogue: 0,0:08:43.28,0:08:44.93,jp.sub-ja,,0,0,0,,Қазір не істегіңіз келеді?
Dialogue: 0,0:08:47.24,0:08:50.58,Style1,,0,0,0,,Суо отбасын басқарғыңыз келе ме?
Dialogue: 0,0:08:47.48,0:08:49.21,jp.sub-ja,,0,0,0,,Суо отбасын мұрагер болғыңыз келе ме?
Dialogue: 0,0:08:50.58,0:08:53.75,Style1,,0,0,0,,Бұл қиын таңдау болар еді.
Dialogue: 0,0:08:50.68,0:08:52.50,jp.sub-ja,,0,0,0,,Бұл қиын таңдау.
Dialogue: 0,0:08:53.75,0:08:58.42,Style1,,0,0,0,,Мен әлі де жауап таба алмадым.
Dialogue: 0,0:08:53.99,0:08:56.95,jp.sub-ja,,0,0,0,,Мен әлі де жауабын таппадым.
Dialogue: 0,0:08:58.42,0:09:04.25,Style1,,0,0,0,,Сіз шынымен нені қалайтыныңызды білесіз бе?
Dialogue: 0,0:08:58.63,0:09:03.18,jp.sub-ja,,0,0,0,,Сіз шынымен нені қалайтыныңызды білесіз бе?
Dialogue: 0,0:09:07.26,0:09:08.36,Style1,,0,0,0,,Қарау.
Dialogue: 0,0:09:07.32,0:09:10.04,jp.sub-ja,,0,0,0,,О, сенің әжең осында.
Dialogue: 0,0:09:08.36,0:09:10.92,Style1,,0,0,0,,Сенің әжең келді.
Dialogue: 0,0:09:12.93,0:09:16.27,Style1,,0,0,0,,Әже! Сіз келуге жеткілікті болдыңыз!
Dialogue: 0,0:09:12.99,0:09:15.82,jp.sub-ja,,0,0,0,,Әже, келдің.
Dialogue: 0,0:09:16.27,0:09:20.61,Style1,,0,0,0,,Әй, анау әйел Тамәкісенпайдың әжесі ме?
Dialogue: 0,0:09:16.42,0:09:20.16,jp.sub-ja,,0,0,0,,Әй, анау Тамаки-сенпайдың әжесі ме?
Dialogue: 0,0:09:20.61,0:09:23.94,Style1,,0,0,0,,Мен ол әйелді жек көремін.
Dialogue: 0,0:09:20.74,0:09:22.27,jp.sub-ja,,0,0,0,,Мен ол адамды жек көремін
Dialogue: 0,0:09:23.94,0:09:25.95,Style1,,0,0,0,,Келіңдер, ішке отырыңдар.
Dialogue: 0,0:09:24.23,0:09:25.78,jp.sub-ja,,0,0,0,,Артқы орындыққа өтіңіз.
Dialogue: 0,0:09:25.95,0:09:27.94,Style1,,0,0,0,,Маған тиіспе.
Dialogue: 0,0:09:26.08,0:09:27.38,jp.sub-ja,,0,0,0,,Өтінемін, ұстамаңыз
Dialogue: 0,0:09:29.95,0:09:31.78,Style1,,0,0,0,,Мені жиіркенішті.
Dialogue: 0,0:09:30.23,0:09:31.07,jp.sub-ja,,0,0,0,,Ал мен үшін ол аса маңызды емес.
Dialogue: 0,0:09:33.55,0:09:36.89,Style1,,0,0,0,,Эклэр-сан, осында кел.
Dialogue: 0,0:09:33.61,0:09:36.16,jp.sub-ja,,0,0,0,,Эклэр мырза, осында келіңіз.
Dialogue: 0,0:09:42.80,0:09:44.56,Style1,,0,0,0,,О, мен жай ғана...
Dialogue: 0,0:09:42.96,0:09:44.17,jp.sub-ja,,0,0,0,,Аа, бұрын не болды...
Dialogue: 0,0:09:44.56,0:09:46.05,Style1,,0,0,0,,Ол кім?
Dialogue: 0,0:09:44.77,0:09:45.41,jp.sub-ja,,0,0,0,,Who?
Dialogue: 0,0:09:49.24,0:09:51.90,Style1,,0,0,0,,Бүгінгі және ертеңгі мектеп жәрмеңкесінің ұзақтығына,
Dialogue: 0,0:09:49.41,0:09:54.15,jp.sub-ja,,0,0,0,,Осы Мисс Эклэрді бүгінгі және ертеңгі мектеп фестивалінің арасында алып жүріңіз.
Dialogue: 0,0:09:51.90,0:09:54.93,Style1,,0,0,0,,Сіз Леди Эклэрді осында алып жүруіңіз керек.
Dialogue: 0,0:09:55.81,0:09:57.90,Style2,,0,0,0,,«Эклэр Тоннер»
Dialogue: 0,0:09:59.91,0:10:03.92,Style1,,0,0,0,,Бірдеңе дұрыс емес пе? Мен саған айтып тұрмын.
Dialogue: 0,0:10:00.10,0:10:02.77,jp.sub-ja,,0,0,0,,Не болды? Мен айтып тұрмын.
Dialogue: 0,0:10:03.92,0:10:06.75,Style1,,0,0,0,,Мен сенің қолыңдамын, Тамаки.
Dialogue: 0,0:10:03.99,0:10:05.93,jp.sub-ja,,0,0,0,,Құрметпен, Тамаки
Dialogue: 0,0:10:12.26,0:10:14.76,Style1,,0,0,0,,Өте жақсы, әже.
Dialogue: 0,0:10:12.33,0:10:14.13,jp.sub-ja,,0,0,0,,Түсіндім, әже.
Dialogue: 0,0:10:14.76,0:10:16.93,Style1,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:10:14.95,0:10:18.23,jp.sub-ja,,0,0,0,,Мен оның көңілінен шығу үшін бар күшімді саламын.
Dialogue: 0,0:10:16.93,0:10:19.12,Style1,,0,0,0,,оның бақытты болатынын көру.
Dialogue: 0,0:10:25.10,0:10:28.04,Style1,,0,0,0,,Тама-чан қайтып келмейді, иә?
Dialogue: 0,0:10:25.22,0:10:27.51,jp.sub-ja,,0,0,0,,Тама-чан, сен қайтып келмейсің.
Dialogue: 0,0:10:28.04,0:10:29.71,Style1,,0,0,0,,Ол алып жүруді шындап жоспарлап отыр ма...
Dialogue: 0,0:10:28.25,0:10:29.70,jp.sub-ja,,0,0,0,,Мектептегі мереке кезінде байыпты түрде
Dialogue: 0,0:10:29.71,0:10:32.94,Style1,,0,0,0,,...ол қыз мектеп жәрмеңкесі кезінде?
Dialogue: 0,0:10:29.82,0:10:32.36,jp.sub-ja,,0,0,0,,Сіз бұл қызды мәңгілікке алып жүруді жоспарлап отырсыз ба?
Dialogue: 0,0:10:33.95,0:10:35.28,Style1,,0,0,0,,Кел, менің ханшайымым,
Dialogue: 0,0:10:34.11,0:10:36.13,jp.sub-ja,,0,0,0,,Жүр, ханшайым, кеттік.
Dialogue: 0,0:10:35.28,0:10:36.94,Style1,,0,0,0,,кеттік.
Dialogue: 0,0:10:38.72,0:10:41.45,Style1,,0,0,0,,Оның есімі Эклэр немесе сол сияқты...
Dialogue: 0,0:10:38.96,0:10:40.99,jp.sub-ja,,0,0,0,,Ол эклер сияқты бірдеңе айтты.
Dialogue: 0,0:10:41.45,0:10:44.56,Style1,,0,0,0,,...бірақ бұл қыз кім?
Dialogue: 0,0:10:41.62,0:10:43.52,jp.sub-ja,,0,0,0,,Бұл қыз кім?
Dialogue: 0,0:10:44.56,0:10:46.56,Style1,,0,0,0,,Мен ол қызды білемін.
Dialogue: 0,0:10:44.67,0:10:45.82,jp.sub-ja,,0,0,0,,Мен ол қызды білемін.
Dialogue: 0,0:10:46.56,0:10:47.89,Style1,,0,0,0,,Ренге-чан...
Dialogue: 0,0:10:46.72,0:10:47.51,jp.sub-ja,,0,0,0,,Ренге-чан
Dialogue: 0,0:10:47.89,0:10:50.90,Style1,,0,0,0,,Эклэр Тоннер, атақтының үшінші қызы
Dialogue: 0,0:10:48.01,0:10:49.26,jp.sub-ja,,0,0,0,,Эклэр Тоннер
Dialogue: 0,0:10:50.27,0:10:55.02,jp.sub-ja,,0,0,0,,Тоннер отбасының үшінші қызы, атақты француз отбасы, ол да граф.
Dialogue: 0,0:10:50.90,0:10:55.57,Style1,,0,0,0,,Корольдік отбасынан шыққан француз Тоннер отбасы.
Dialogue: 0,0:10:55.57,0:10:58.90,Style1,,0,0,0,,Ренге-кун, сен де Францияда өскенсің.
Dialogue: 0,0:10:55.72,0:10:57.90,jp.sub-ja,,0,0,0,,Ренге-кун да Францияда өскен.
Dialogue: 0,0:10:58.90,0:11:02.30,jp.sub-ja,,0,0,0,,Иә, Тоннер отбасы жай ғана жақсы отбасы емес.
Dialogue: 0,0:10:58.90,0:11:02.58,Style1,,0,0,0,,Иә, Тоннер отбасы жай ғана жоғары әлеуметтік мәртебеге ие емес,
Dialogue: 0,0:11:02.58,0:11:05.58,Style1,,0,0,0,,олар сонымен қатар Grand Tonnerre компаниясының иелері
Dialogue: 0,0:11:02.70,0:11:06.81,jp.sub-ja,,0,0,0,,Соңғы кездері жапондық компанияларды бірінен соң бірін алып жатқан шетелдік компания ретінде.
Dialogue: 0,0:11:05.58,0:11:07.91,Style1,,0,0,0,,қаржы әлемінің соңғы уақытта шулап жатқаны,
Dialogue: 0,0:11:07.15,0:11:10.71,jp.sub-ja,,0,0,0,,Ол сонымен қатар бизнес әлемінде шу шығарып жатқан Grant Nail компаниясының иесі.
Dialogue: 0,0:11:07.91,0:11:12.25,Style1,,0,0,0,,шетелден қаржыландырылатын, біздің елдегі бизнесті тез сатып алатын фирма болғаны үшін.
Dialogue: 0,0:11:12.25,0:11:13.25,Style1,,0,0,0,,Әрине,
Dialogue: 0,0:11:12.46,0:11:15.98,jp.sub-ja,,0,0,0,,Дегенмен, жас ханым Тамакиге неліктен келді?
Dialogue: 0,0:11:13.25,0:11:18.45,Style1,,0,0,0,,олардың қызының Тамакиге не үшін келгенін білмейміз...
Dialogue: 0,0:11:16.60,0:11:17.32,jp.sub-ja,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:11:32.61,0:11:34.51,Style1,,0,0,0,,Қараңыз, қаншама Ято-ра бар
Dialogue: 0,0:11:32.77,0:11:33.53,jp.sub-ja,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:11:34.51,0:11:37.71,Style1,,0,0,0,,Идеясы - жартылай жартылай круизден ләззат алу,
Dialogue: 0,0:11:34.72,0:11:37.18,jp.sub-ja,,0,0,0,,жартылай гондолда круизден ләззат алу
Dialogue: 0,0:11:37.71,0:11:41.95,Style1,,0,0,0,,Көркемсурет үйірмесі мүшелерінің жұмыстарын тамашалай отырып.
Dialogue: 0,0:11:37.90,0:11:41.32,jp.sub-ja,,0,0,0,,Идеясы көркемөнер үйірмесі мүшелерінің жұмыстарын бағалай білу.
Dialogue: 0,0:11:41.95,0:11:46.62,Style1,,0,0,0,,Бұл қызықсыз. Студенттердің ешбір жұмысына мән бермеймін.
Dialogue: 0,0:11:42.03,0:11:42.91,jp.sub-ja,,0,0,0,,Жалқаулық
Dialogue: 0,0:11:43.86,0:11:46.11,jp.sub-ja,,0,0,0,,Мен оқушының жұмысына мән бермеймін.
Dialogue: 0,0:11:46.62,0:11:50.62,Style1,,0,0,0,,Бұл өте қатал. Бірақ мен не істей алатынымды білмеймін.
Dialogue: 0,0:11:46.83,0:11:47.96,jp.sub-ja,,0,0,0,,Бұл қиын
Dialogue: 0,0:11:49.42,0:11:50.21,jp.sub-ja,,0,0,0,,Бірақ мен қиындыққа тап болдым.
Dialogue: 0,0:11:50.62,0:11:54.06,Style1,,0,0,0,,Оуран жәрмеңкесі студенттерге арналған жәрмеңке.
Dialogue: 0,0:11:50.82,0:11:53.19,jp.sub-ja,,0,0,0,,Бұл Уран фестивалі студенттерге арналған фестиваль.
Dialogue: 0,0:11:54.06,0:11:57.39,Style1,,0,0,0,,Сізге ұнайтын қай жерде көрсетуге болады?
Dialogue: 0,0:11:54.22,0:11:56.66,jp.sub-ja,,0,0,0,,Сені бақытты ету үшін мен сені қайда бағыттасам болады?
Dialogue: 0,0:11:58.90,0:12:02.89,Style1,,0,0,0,,Мен сенің пианинода ойнағаныңды естігім келеді, Тамаки.
Dialogue: 0,0:11:58.97,0:12:02.25,jp.sub-ja,,0,0,0,,Мен Тамакидің пианинода ойнағанын естігім келеді.
Dialogue: 0,0:12:06.57,0:12:08.23,Style1,,0,0,0,,Өтіріктер, мен оларды жек көремін, құлдырау, әр күн сайын лақтыру
Dialogue: 0,0:12:06.58,0:12:07.15,jp.sub-ja,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:12:10.41,0:12:15.24,Style1,,0,0,0,,Қыздарының Тамакиге не үшін келгенін білмейміз...
Dialogue: 0,0:12:10.56,0:12:14.17,jp.sub-ja,,0,0,0,,Әлгі жас келіншек Тамакиге не үшін келгенін білмеймін.
Dialogue: 0,0:12:18.92,0:12:20.59,Style1,,0,0,0,,Мұнда?
Dialogue: 0,0:12:19.00,0:12:20.04,jp.sub-ja,,0,0,0,,Осындай жерде?
Dialogue: 0,0:12:20.59,0:12:22.53,jp.sub-ja,,0,0,0,,Бұл киім ауыстыратын бөлме.
Dialogue: 0,0:12:20.59,0:12:23.25,Style1,,0,0,0,,Бұл музыка бөлмесі ғой.
Dialogue: 0,0:13:07.57,0:13:12.64,Style1,,0,0,0,,Бұл сіз әрқашан Хост клубының жұмысын жүргізетін бөлме ме?
Dialogue: 0,0:13:07.81,0:13:09.82,jp.sub-ja,,0,0,0,,Бұл жерде сіз әрқашан боласыз
Dialogue: 0,0:13:09.82,0:13:12.44,jp.sub-ja,,0,0,0,,Менің ойымша, бұл үйірме өтетін бөлме.
Dialogue: 0,0:13:12.64,0:13:18.24,Style1,,0,0,0,,Мен сізді салонда бақылап отырдым, бәріңіз жақсы араласатын сияқтысыздар.
Dialogue: 0,0:13:12.90,0:13:14.93,jp.sub-ja,,0,0,0,,Маған оны салонда көруге рұқсат етті.
Dialogue: 0,0:13:15.26,0:13:17.32,jp.sub-ja,,0,0,0,,Барлығы өте жақсы араласады.
Dialogue: 0,0:13:18.24,0:13:22.92,Style1,,0,0,0,,Себебі, Хост клубы отбасының бірігуі сияқты.
Dialogue: 0,0:13:18.34,0:13:22.45,jp.sub-ja,,0,0,0,,Себебі біздің қабылдаушы клубымыз бір отбасы сияқты.
Dialogue: 0,0:13:22.92,0:13:25.92,Style1,,0,0,0,,Жапонияда олар нағыз отбасы бар болып көрінуді,
Dialogue: 0,0:13:23.19,0:13:27.36,jp.sub-ja,,0,0,0,,Жапонияда адамдар нағыз отбасы болмаса да, өздерін отбасы ретінде көрсетеді.
Dialogue: 0,0:13:25.92,0:13:30.25,Style1,,0,0,0,,Бір емес болса да, «үй ойнау» емес пе?
Dialogue: 0,0:13:27.70,0:13:29.26,jp.sub-ja,,0,0,0,,Менің ойымша, бұл ойын үйі деп аталады.
Dialogue: 0,0:13:34.26,0:13:36.26,Style1,,0,0,0,,Тамаки, сен басқалардың бәрін жасап жатырсың
Dialogue: 0,0:13:34.41,0:13:38.97,jp.sub-ja,,0,0,0,,Тамакидің өзімшілдігінен бәрі қиналып жатқан жоқ па?
Dialogue: 0,0:13:36.26,0:13:40.27,Style1,,0,0,0,,ептілігіңнің кесірінен қиналып жүрсің, солай емес пе?
Dialogue: 0,0:13:40.26,0:13:44.04,jp.sub-ja,,0,0,0,,Көзілдірікті үй иесі әкесінен ұрып-соғатын.
Dialogue: 0,0:13:40.27,0:13:44.86,Style1,,0,0,0,,Менің айтайын дегенім, әлгі көзілдірік киген үй иесін тіпті папасы таң қалдырды, солай ма?
Dialogue: 0,0:13:48.54,0:13:53.21,Style1,,0,0,0,,Мен сіздің барлық капризді жоспарларыңызбен қалай күресуге болатынын білмеймін.
Dialogue: 0,0:13:48.69,0:13:52.71,jp.sub-ja,,0,0,0,,Әдеттегідей, сенің өзімшіл жоспарларың мені үнемі мазалайды.
Dialogue: 0,0:13:54.55,0:13:57.32,Style1,,0,0,0,,Барлығы шын мәнінде болуы мүмкін бе?
Dialogue: 0,0:13:54.74,0:13:55.51,jp.sub-ja,,0,0,0,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:13:56.18,0:13:59.46,jp.sub-ja,,0,0,0,,Біз бәріміз сахнаның ар жағындағы нәрселерді құрбан етіп жатырмыз ба?
Dialogue: 0,0:13:57.32,0:14:00.55,Style1,,0,0,0,,Әртүрлі басқа нәрселерден жасырын бас тарту керек пе?
Dialogue: 0,0:14:00.55,0:14:04.56,Style1,,0,0,0,,Рас, Харухи, қолында бар әрбір минутты өткізгісі келеді
Dialogue: 0,0:14:00.71,0:14:02.73,jp.sub-ja,,0,0,0,,Мен міндетті түрде заңгер болғым келеді.
Dialogue: 0,0:14:02.95,0:14:05.55,jp.sub-ja,,0,0,0,,Тіпті Харухи мүмкіндігінше көп оқығысы келеді.
Dialogue: 0,0:14:04.56,0:14:08.23,Style1,,0,0,0,,заңгер болуды оқып, қымбат уақытын беруге мәжбүр болды,
Dialogue: 0,0:14:06.04,0:14:10.45,jp.sub-ja,,0,0,0,,Адамдарды күн сайын клуб іс-шараларына қатысуға мәжбүрлеу және олардың қымбат уақытын құрбан ету.
Dialogue: 0,0:14:08.23,0:14:11.22,Style1,,0,0,0,,күні-түні клубтық іс-шараларға қатысуға мәжбүр болды.
Dialogue: 0,0:14:14.23,0:14:15.72,Style1,,0,0,0,,Бұл кім?
Dialogue: 0,0:14:14.27,0:14:14.74,jp.sub-ja,,0,0,0,,Who?
Dialogue: 0,0:14:18.40,0:14:20.57,Style1,,0,0,0,,Харухи? Сен не істеп жатырсың?
Dialogue: 0,0:14:18.59,0:14:20.35,jp.sub-ja,,0,0,0,,Харухи, сен не істеп жатырсың?
Dialogue: 0,0:14:20.55,0:14:22.14,jp.sub-ja,,0,0,0,,Мен киім ауыстырып қайттым.
Dialogue: 0,0:14:20.57,0:14:22.91,Style1,,0,0,0,,Мен мұнда киім ауыстыру үшін келдім.
Dialogue: 0,0:14:22.91,0:14:26.74,Style1,,0,0,0,,Сенпай, күніне үш рет ауыстырып тұр деген сен едің ғой?
Dialogue: 0,0:14:23.07,0:14:26.16,jp.sub-ja,,0,0,0,,Күніне үш реттен артық ауыстырамын деген адам менің ағам болуы керек.
Dialogue: 0,0:14:28.08,0:14:31.42,Style1,,0,0,0,,Салонға қазір немқұрайлы қарау, бізге айтқаннан кейін,
Dialogue: 0,0:14:28.25,0:14:30.62,jp.sub-ja,,0,0,0,,Оны айтқан адам салонға немқұрайлы қараған.
Dialogue: 0,0:14:31.42,0:14:33.59,Style1,,0,0,0,,бәрі саған ренжіді.
Dialogue: 0,0:14:31.66,0:14:32.73,jp.sub-ja,,0,0,0,,Барлығы ашулы.
Dialogue: 0,0:14:33.59,0:14:38.92,Style1,,0,0,0,,О, кешірім сұраймын. Тамаки дәл қазір маған тиесілі.
Dialogue: 0,0:14:33.76,0:14:34.93,jp.sub-ja,,0,0,0,,О, бұл өте жаман.
Dialogue: 0,0:14:35.95,0:14:38.11,jp.sub-ja,,0,0,0,,Сақина енді менікі
Dialogue: 0,0:14:40.43,0:14:45.70,Style1,,0,0,0,,Бірақ, әйтеуір, сіз қызғанышпен қарайтын сияқтысыз.
Dialogue: 0,0:14:40.56,0:14:44.22,jp.sub-ja,,0,0,0,,Бірақ әйтеуір ашуланып тұрған сияқтысың.
Dialogue: 0,0:14:45.70,0:14:47.20,Style1,,0,0,0,,Қызғаншақ!?
Dialogue: 0,0:14:45.73,0:14:47.08,jp.sub-ja,,0,0,0,,Якимочи?
Dialogue: 0,0:14:47.14,0:14:51.37,jp.sub-ja,,0,0,0,,Солай ма? Солай ма? Солай ма? Харухи~
Dialogue: 0,0:14:47.20,0:14:51.69,Style1,,0,0,0,,Бұл рас па? Бұл рас па? Бұл рас па, Харухи?
Dialogue: 0,0:14:54.37,0:14:58.88,Style1,,0,0,0,,Жоқ, олай емес. Жарайды, сізді мазалағаным үшін өте кешірім сұраймын.
Dialogue: 0,0:14:54.48,0:14:55.43,jp.sub-ja,,0,0,0,,Бұл – тұзақ.
Dialogue: 0,0:14:56.02,0:14:58.85,jp.sub-ja,,0,0,0,,Иә, иә, сізді мазалағаным үшін кешіріңіз.
Dialogue: 0,0:14:58.85,0:15:00.76,jp.sub-ja,,0,0,0,,Сәлем, Харухи.
Dialogue: 0,0:14:58.88,0:15:01.04,Style1,,0,0,0,,Бізді мазалады ма? Эй, Харухи-
Dialogue: 0,0:15:07.05,0:15:10.03,jp.sub-ja,,0,0,0,,Не, Тамакиге анау кішкентай енот ит ұнай ма?
Dialogue: 0,0:15:07.05,0:15:10.89,Style1,,0,0,0,,Бұл не? Тамаки, сен әлгі кішкентай пысық болғанын қалайсың ба?
Dialogue: 0,0:15:10.79,0:15:11.53,jp.sub-ja,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:15:10.89,0:15:16.23,Style1,,0,0,0,,Қандай дөрекі! Кішкентай қызымды ақымақ демеңізші.
Dialogue: 0,0:15:12.17,0:15:15.25,jp.sub-ja,,0,0,0,,Өтінемін, менің қызымды енот ит деп айтуды доғар.
Dialogue: 0,0:15:16.23,0:15:18.23,Style1,,0,0,0,,Сіздің кішкентай қызыңыз...
Dialogue: 0,0:15:16.26,0:15:17.17,jp.sub-ja,,0,0,0,,Менің қызым
Dialogue: 0,0:15:18.23,0:15:21.90,Style1,,0,0,0,,Сіздің ойдан шығарылған отбасыңыз, сайып келгенде, жай ғана сену.
Dialogue: 0,0:15:18.34,0:15:23.05,jp.sub-ja,,0,0,0,,Отбасылық ойын үйі ойын үйінің орнына келеді.
Dialogue: 0,0:15:21.90,0:15:23.73,Style1,,0,0,0,,Суррогат.
Dialogue: 0,0:15:27.91,0:15:29.24,Style1,,0,0,0,,Сіз не істеп жатырсыз!?
Dialogue: 0,0:15:27.94,0:15:28.81,jp.sub-ja,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:15:31.08,0:15:34.41,Style1,,0,0,0,,Тамаки, мен саған бере аламын
Dialogue: 0,0:15:31.24,0:15:33.16,jp.sub-ja,,0,0,0,,Тамаки нені көбірек қалайды
Dialogue: 0,0:15:34.41,0:15:37.58,Style1,,0,0,0,,ең қажет нәрсе.
Dialogue: 0,0:15:34.56,0:15:36.40,jp.sub-ja,,0,0,0,,Мен бере аламын
Dialogue: 0,0:15:37.58,0:15:38.92,Style1,,0,0,0,,- Менің! - Қандай сүйкімді!
Dialogue: 0,0:15:38.18,0:15:39.01,jp.sub-ja,,0,0,0,,Сүйкімді
Dialogue: 0,0:15:38.92,0:15:40.41,Style1,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:15:39.01,0:15:39.94,jp.sub-ja,,0,0,0,,Жақсы
Dialogue: 0,0:15:43.86,0:15:45.86,Style1,,0,0,0,,Хару-чан өте сүйкімді!
Dialogue: 0,0:15:44.15,0:15:45.47,jp.sub-ja,,0,0,0,,Хару-чан сүйкімді
Dialogue: 0,0:15:45.86,0:15:46.85,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:15:49.53,0:15:51.09,Style1,,0,0,0,,Жақсы.
Dialogue: 0,0:15:49.70,0:15:50.82,jp.sub-ja,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:15:52.53,0:15:53.87,Style1,,0,0,0,,Жоғары мәртебелі қайда кетті?
Dialogue: 0,0:15:52.63,0:15:53.74,jp.sub-ja,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:15:53.84,0:15:55.58,jp.sub-ja,,0,0,0,,Мен оны қатты асыға күтсем де.
Dialogue: 0,0:15:53.87,0:15:55.53,Style1,,0,0,0,,Ол мұны бәрінен де асыға күтті.
Dialogue: 0,0:15:55.53,0:16:00.04,Style1,,0,0,0,,Сенпай №3 музыкалық бөлмеде болды. Ол Леди Эклэрмен бірге болды.
Dialogue: 0,0:15:55.69,0:15:57.95,jp.sub-ja,,0,0,0,,Мен киім ауыстыратын бөлмеде болдым.
Dialogue: 0,0:15:58.38,0:15:59.94,jp.sub-ja,,0,0,0,,Мен Эклэр ханыммен бірге болдым.
Dialogue: 0,0:16:00.04,0:16:01.04,Style1,,0,0,0,,О, бұл не?
Dialogue: 0,0:16:00.21,0:16:01.06,jp.sub-ja,,0,0,0,,Не?
Dialogue: 0,0:16:01.04,0:16:03.37,Style1,,0,0,0,,Бұл қызғаныш сияқты көрінді.
Dialogue: 0,0:16:01.29,0:16:02.81,jp.sub-ja,,0,0,0,,Бұл өте тентек сияқты.
Dialogue: 0,0:16:04.71,0:16:07.21,Style1,,0,0,0,,Мен айтқанымдай, олай емес!
Dialogue: 0,0:16:04.84,0:16:06.46,jp.sub-ja,,0,0,0,,Сондықтан ол басқаша.
Dialogue: 0,0:16:07.21,0:16:08.11,jp.sub-ja,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:16:07.21,0:16:08.65,Style2,,0,0,0,,«Айтқаныңыздай?»
Dialogue: 0,0:16:07.21,0:16:08.88,Style1,,0,0,0,,Сіз айтқандай?
Dialogue: 0,0:16:08.88,0:16:14.55,Style1,,0,0,0,,Сонда да Тамаки-сенпай бұл жолы біраз жауапсыз.
Dialogue: 0,0:16:09.00,0:16:09.64,jp.sub-ja,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:16:10.33,0:16:13.77,jp.sub-ja,,0,0,0,,Тамаки-сенпай бұл жолы сәл жауапсыз.
Dialogue: 0,0:16:14.55,0:16:18.39,Style1,,0,0,0,,Әдетте, сіз оны каприз деп атай аласыз, және бұл ...
Dialogue: 0,0:16:14.76,0:16:17.43,jp.sub-ja,,0,0,0,,Мен әдетте өзімшіл дегенде өзімшілді айтамын.
Dialogue: 0,0:16:18.39,0:16:20.56,Style1,,0,0,0,,Қане, оған рұқсат берейік.
Dialogue: 0,0:16:18.53,0:16:20.08,jp.sub-ja,,0,0,0,,Мұны байыппен қабылдаңыз.
Dialogue: 0,0:16:20.56,0:16:24.15,Style1,,0,0,0,,Оған әжесі ғана бұйырған ғой.
Dialogue: 0,0:16:20.73,0:16:23.18,jp.sub-ja,,0,0,0,,Бұл әжеңнің бұйрығынан басқа ештеңе емес.
Dialogue: 0,0:16:26.23,0:16:28.23,Style1,,0,0,0,,Келіңдер, ішке отырыңдар.
Dialogue: 0,0:16:26.43,0:16:28.04,jp.sub-ja,,0,0,0,,Артқы орындыққа өтіңіз.
Dialogue: 0,0:16:28.23,0:16:30.22,Style1,,0,0,0,,Маған тиіспе.
Dialogue: 0,0:16:28.32,0:16:29.52,jp.sub-ja,,0,0,0,,Ұстамаңыз
Dialogue: 0,0:16:32.07,0:16:34.24,Style1,,0,0,0,,Менен жиіркеніп тұрсың.
Dialogue: 0,0:16:32.27,0:16:33.08,jp.sub-ja,,0,0,0,,Ал мен үшін ол аса маңызды емес.
Dialogue: 0,0:16:34.24,0:16:40.41,Style1,,0,0,0,,Рас, Тамәкісенпайдың әжесі оған өте суық болып көрінді.
Dialogue: 0,0:16:34.45,0:16:39.65,jp.sub-ja,,0,0,0,,Тамаки-сенпайдың әжесі Тамаки-сенпайға суық қарағаны рас.
Dialogue: 0,0:16:40.41,0:16:43.25,Style1,,0,0,0,,Бұған себеп бар ма?
Dialogue: 0,0:16:40.50,0:16:42.26,jp.sub-ja,,0,0,0,,Себебі бар ма?
Dialogue: 0,0:16:45.52,0:16:48.52,Style1,,0,0,0,,Бұл туралы бәрі біледі...
Dialogue: 0,0:16:45.72,0:16:48.08,jp.sub-ja,,0,0,0,,Мұны бәрі біледі.
Dialogue: 0,0:16:48.52,0:16:51.51,Style1,,0,0,0,,Бір сөзбен айтқанда, оның бойы – заңсыз махаббат перзенті.
Dialogue: 0,0:16:48.55,0:16:50.88,jp.sub-ja,,0,0,0,,Қысқасы, сен күң баласысың.
Dialogue: 0,0:16:53.86,0:16:57.20,Style1,,0,0,0,,Жиырма бірнеше жыл бұрын, сол кездегі Суо отбасының басшысы
Dialogue: 0,0:16:54.15,0:16:58.50,jp.sub-ja,,0,0,0,,Жиырма жыл бұрын Суо отбасының алдыңғы ұрпағы жас кезінде өмірден өтті.
Dialogue: 0,0:16:57.20,0:16:59.53,Style1,,0,0,0,,Жас кезінде өмірден өтті.
Dialogue: 0,0:16:59.53,0:17:02.53,Style1,,0,0,0,,Осы мектептің бастығы Юдзуру мырза кірді
Dialogue: 0,0:16:59.71,0:17:04.34,jp.sub-ja,,0,0,0,,Осы академияның қазіргі президенті Юдзуру мырза анасы таңдаған адаммен бірге.
Dialogue: 0,0:17:02.53,0:17:05.54,Style1,,0,0,0,,саяси қолайлы неке деп атауға болады
Dialogue: 0,0:17:05.00,0:17:06.61,jp.sub-ja,,0,0,0,,Саяси неке деп аталатын
Dialogue: 0,0:17:05.54,0:17:09.54,Style1,,0,0,0,,анасының таңдауы бойынша әйелмен және отбасын жалғастырды.
Dialogue: 0,0:17:07.22,0:17:08.46,jp.sub-ja,,0,0,0,,орындалды
Dialogue: 0,0:17:09.54,0:17:13.88,Style1,,0,0,0,,Алайда бірнеше жылдан кейін басшы шынайы махаббатын тапты
Dialogue: 0,0:17:09.70,0:17:11.00,jp.sub-ja,,0,0,0,,Алайда бірнеше жылдан кейін
Dialogue: 0,0:17:11.43,0:17:16.00,jp.sub-ja,,0,0,0,,Төраға Францияда танысқан әйелге ғашық болып қалады.
Dialogue: 0,0:17:13.88,0:17:17.22,Style1,,0,0,0,,Францияда кездескен әйелмен.
Dialogue: 0,0:17:17.22,0:17:20.88,Style1,,0,0,0,,Содан кейін Тама-чан дүниеге келді.
Dialogue: 0,0:17:17.62,0:17:19.89,jp.sub-ja,,0,0,0,,Тама-чан осылай дүниеге келді, солай ма?
Dialogue: 0,0:17:21.89,0:17:27.23,Style1,,0,0,0,,Анашым, мен әйелімді тастап, оған үйленемін.
Dialogue: 0,0:17:22.14,0:17:24.43,jp.sub-ja,,0,0,0,,Анашым, мен әйеліммен ажырастым.
Dialogue: 0,0:17:25.13,0:17:26.19,jp.sub-ja,,0,0,0,,оған үйлен
Dialogue: 0,0:17:27.23,0:17:30.23,Style1,,0,0,0,,Алайда оның әжесі үзілді-кесілді қарсы болды.
Dialogue: 0,0:17:27.57,0:17:29.33,jp.sub-ja,,0,0,0,,Бірақ әжем бұған қатты қарсы.
Dialogue: 0,0:17:30.23,0:17:32.23,Style1,,0,0,0,,Жоғары мәртебелі анасы ауырып жатыр,
Dialogue: 0,0:17:30.49,0:17:34.83,jp.sub-ja,,0,0,0,,Сіздің анаңыз ауырып, Жапонияда тұру қиынға соқты.
Dialogue: 0,0:17:32.23,0:17:35.23,Style1,,0,0,0,,және оның Жапонияда тұруына басқа да кедергілер болды,
Dialogue: 0,0:17:35.23,0:17:39.24,Style1,,0,0,0,,сондықтан оның мәртебелі 14 жасына дейін Францияда өсті.
Dialogue: 0,0:17:35.45,0:17:38.31,jp.sub-ja,,0,0,0,,Сіз он төрт жасқа дейін Францияда өстіңіз.
Dialogue: 0,0:17:39.24,0:17:43.24,Style1,,0,0,0,,Мәртебелі балалық шағы өзінше бақытты болған сияқты.
Dialogue: 0,0:17:39.61,0:17:42.85,jp.sub-ja,,0,0,0,,Сіздің балалық шағыңыз өте бақытты болған сияқты.
Dialogue: 0,0:17:43.24,0:17:47.18,Style1,,0,0,0,,бірақ уақыт өте келе анасының отбасылық бизнесі сәтсіздікке ұшырады,
Dialogue: 0,0:17:43.44,0:17:47.03,jp.sub-ja,,0,0,0,,Бірақ ақыры анамның отбасы бизнесте сәтсіздікке ұшырады.
Dialogue: 0,0:17:47.18,0:17:49.52,Style1,,0,0,0,,және олар үлкен қарызға батқаннан кейін ...
Dialogue: 0,0:17:47.39,0:17:49.26,jp.sub-ja,,0,0,0,,Сізге үлкен көлемдегі қарыз болған кезде
Dialogue: 0,0:17:49.52,0:17:51.85,Style1,,0,0,0,,...оның жоқтығына алаңдай бастаған әжесі
Dialogue: 0,0:17:49.83,0:17:53.89,jp.sub-ja,,0,0,0,,Суо әулетінің мұрагері жоқ деп уайымдай бастаған әжем ұсыныс жасады.
Dialogue: 0,0:17:51.85,0:17:55.19,Style1,,0,0,0,,Суо отбасының кез келген мұрагерлері ұсыныс жасады.
Dialogue: 0,0:17:55.19,0:17:57.19,Style1,,0,0,0,,Мен сізге жеткілікті ақша беремін
Dialogue: 0,0:17:55.28,0:17:59.33,jp.sub-ja,,0,0,0,,Қазірден бастап жайлы өмір сүру үшін жеткілікті ақша жинайық.
Dialogue: 0,0:17:57.19,0:18:00.19,Style1,,0,0,0,,бұдан былай жайлы өмір сүру үшін.
Dialogue: 0,0:18:00.19,0:18:04.20,Style1,,0,0,0,,Оның орнына Тамакиді Жапонияға жалғыз жібер.
Dialogue: 0,0:18:00.24,0:18:03.37,jp.sub-ja,,0,0,0,,Оның орнына Жапонияға тек сақинаны жіберіңіз.
Dialogue: 0,0:18:04.20,0:18:10.20,Style1,,0,0,0,,Сонда Тамаки екеуің бір-біріңді бұдан былай ешқашан көрмейтін боласыңдар.
Dialogue: 0,0:18:04.64,0:18:09.06,jp.sub-ja,,0,0,0,,Ал мен Тамаки екеуіңнің кездесуіне рұқсат бермеймін.
Dialogue: 0,0:18:10.20,0:18:13.04,Style1,,0,0,0,,Бұл менің көмегімнің шарты.
Dialogue: 0,0:18:10.25,0:18:12.21,jp.sub-ja,,0,0,0,,Бұл көмек көрсету шарты
Dialogue: 0,0:18:15.37,0:18:16.88,Style1,,0,0,0,,Қате айтасың!
Dialogue: 0,0:18:15.48,0:18:16.15,jp.sub-ja,,0,0,0,,Бұл...
Dialogue: 0,0:18:16.88,0:18:19.88,Style1,,0,0,0,,Суо отбасының қазіргі басшысы Юдзуру мырза болуы мүмкін.
Dialogue: 0,0:18:17.00,0:18:19.48,jp.sub-ja,,0,0,0,,Суо отбасының басшысы — басқарма төрағасы Юдзуру мырза.
Dialogue: 0,0:18:19.88,0:18:21.88,Style1,,0,0,0,,бірақ іс жүзінде ең жоғары қуат әлі де тиесілі
Dialogue: 0,0:18:20.06,0:18:24.27,jp.sub-ja,,0,0,0,,Де-факто жоғары беделге ие адам әлі де төраға қызметін атқаратын әже болып табылады.
Dialogue: 0,0:18:21.88,0:18:24.88,Style1,,0,0,0,,оның директоры, әжеге.
Dialogue: 0,0:18:24.88,0:18:28.22,Style1,,0,0,0,,Тамакидің анасының денсаулығы нашар,
Dialogue: 0,0:18:24.99,0:18:27.43,jp.sub-ja,,0,0,0,,Ең сорақысы, Тамакидің анасы физикалық тұрғыдан әлсіз.
Dialogue: 0,0:18:28.22,0:18:30.89,Style1,,0,0,0,,егер ол жоқ болса не болатынын білді
Dialogue: 0,0:18:28.36,0:18:32.23,jp.sub-ja,,0,0,0,,Судың көмегінсіз көшеде адасып қалсам не болатынын білдім.
Dialogue: 0,0:18:30.89,0:18:33.06,Style1,,0,0,0,,Суустың көмегінсіз.
Dialogue: 0,0:18:33.06,0:18:34.39,Style1,,0,0,0,,Сонымен...
Dialogue: 0,0:18:33.20,0:18:33.81,jp.sub-ja,,0,0,0,,Сонымен...
Dialogue: 0,0:18:35.73,0:18:40.23,Style1,,0,0,0,,Мен барамын. Мен Жапонияға жалғыз барамын.
Dialogue: 0,0:18:35.85,0:18:36.95,jp.sub-ja,,0,0,0,,Мен барамын
Dialogue: 0,0:18:37.87,0:18:39.15,jp.sub-ja,,0,0,0,,Жапонияға жалғыз бару
Dialogue: 0,0:18:40.23,0:18:44.24,Style1,,0,0,0,,Бәрі жақсы болады. Өтінемін, анашым,
Dialogue: 0,0:18:40.48,0:18:41.27,jp.sub-ja,,0,0,0,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,0:18:42.64,0:18:44.96,jp.sub-ja,,0,0,0,,Өтінемін, анашым, сау болыңыз.
Dialogue: 0,0:18:44.24,0:18:45.90,Style1,,0,0,0,,қамқорлық жасаңыз.
Dialogue: 0,0:18:47.57,0:18:50.58,Style1,,0,0,0,,Сосын қайғыдан ба,
Dialogue: 0,0:18:47.87,0:18:48.98,jp.sub-ja,,0,0,0,,Жалғыздықтан ба?
Dialogue: 0,0:18:50.16,0:18:54.17,jp.sub-ja,,0,0,0,,Әлде ол Тамакиді ақшаға саудалағаны үшін өзін кінәлі сезінгендіктен бе?
Dialogue: 0,0:18:50.58,0:18:54.58,Style1,,0,0,0,,немесе Тамакиді ақшаға сатқаны үшін кінәлі болу,
Dialogue: 0,0:18:54.58,0:18:59.42,Style1,,0,0,0,,анасы бір жаққа көшіп кетіп, тығылып кеткен көрінеді.
Dialogue: 0,0:18:54.80,0:18:55.88,jp.sub-ja,,0,0,0,,Сонда анасы
Dialogue: 0,0:18:56.28,0:18:58.46,jp.sub-ja,,0,0,0,,Ол жасырыну үшін бір жерге көшіп кеткен көрінеді.
Dialogue: 0,0:18:59.42,0:19:02.59,Style1,,0,0,0,,Қазіргі уақытта оның қайда екені белгісіз.
Dialogue: 0,0:18:59.63,0:19:01.25,jp.sub-ja,,0,0,0,,Ол қазір хабарсыз кеткен.
Dialogue: 0,0:19:02.59,0:19:06.96,Style1,,0,0,0,,Міне, содан бері Тамаки анасын бір рет те көрмеді.
Dialogue: 0,0:19:02.84,0:19:04.27,jp.sub-ja,,0,0,0,,Сондықтан сақина содан бері
Dialogue: 0,0:19:05.04,0:19:06.47,jp.sub-ja,,0,0,0,,Мен анамды ешқашан кездестірмедім.
Dialogue: 0,0:19:15.60,0:19:18.87,Style1,,0,0,0,,Мен анамды енді ешқашан көре алмаймын ба?
Dialogue: 0,0:19:15.79,0:19:18.28,jp.sub-ja,,0,0,0,,Мен анамды енді көре алмаймын.
Dialogue: 0,0:19:23.94,0:19:29.62,Style1,,0,0,0,,Мен ешқашан білмедім. Ол әрқашан көңілді,
Dialogue: 0,0:19:24.08,0:19:25.07,jp.sub-ja,,0,0,0,,Мен білмедім
Dialogue: 0,0:19:26.44,0:19:28.42,jp.sub-ja,,0,0,0,,Әдетте бұл өте жарқын
Dialogue: 0,0:19:29.62,0:19:33.52,Style1,,0,0,0,,Оның мұндай азапты тәрбие алғанын білмедім.
Dialogue: 0,0:19:29.89,0:19:31.41,jp.sub-ja,,0,0,0,,Осындай қиын тәрбиемен
Dialogue: 0,0:19:33.52,0:19:36.29,Style1,,0,0,0,,Тамаки-сенпай болсам,
Dialogue: 0,0:19:33.63,0:19:35.60,jp.sub-ja,,0,0,0,,Тамаки-сенпай болсам
Dialogue: 0,0:19:36.29,0:19:39.62,Style1,,0,0,0,,Әжемді ренжітпей қоя аламын ба деп ойлаймын.
Dialogue: 0,0:19:36.60,0:19:38.97,jp.sub-ja,,0,0,0,,Қызық, мен сол әжені жек көруді қоя аламын ба?
Dialogue: 0,0:19:42.96,0:19:45.56,Style1,,0,0,0,,Оны аяу оңай,
Dialogue: 0,0:19:43.21,0:19:44.81,jp.sub-ja,,0,0,0,,Оған жанашырлық таныту оңай
Dialogue: 0,0:19:45.56,0:19:49.90,Style1,,0,0,0,,бірақ мен Тамакидің қазір кім екеніне қуаныштымын.
Dialogue: 0,0:19:45.86,0:19:49.50,jp.sub-ja,,0,0,0,,Бірақ мен Тамакидің қазір сол болғанына қуаныштымын.
Dialogue: 0,0:19:52.24,0:19:54.57,Style1,,0,0,0,,Ол жақсы болады.
Dialogue: 0,0:19:52.45,0:19:53.55,jp.sub-ja,,0,0,0,,Оның жағдайы жақсы.
Dialogue: 0,0:19:54.57,0:20:00.08,Style1,,0,0,0,,Басынан өткеннің бәрін мойындап, ол қазір осында,
Dialogue: 0,0:19:54.77,0:19:58.00,jp.sub-ja,,0,0,0,,Барлығын қабылдап, ол қазір осында.
Dialogue: 0,0:20:00.08,0:20:02.14,Style1,,0,0,0,,Хост клубында.
Dialogue: 0,0:20:00.32,0:20:01.28,jp.sub-ja,,0,0,0,,Осы хост бөлімінде
Dialogue: 0,0:20:15.59,0:20:17.76,Style1,,0,0,0,,Әй, Тама-чан!
Dialogue: 0,0:20:16.36,0:20:17.15,jp.sub-ja,,0,0,0,,Тама-чан
Dialogue: 0,0:20:22.27,0:20:24.93,Style1,,0,0,0,,Менің барлығына маңызды хабарландыруым бар.
Dialogue: 0,0:20:22.40,0:20:24.30,jp.sub-ja,,0,0,0,,Менде барлығына маңызды есеп бар.
Dialogue: 0,0:20:27.44,0:20:32.61,Style1,,0,0,0,,Мен осында Леди Эклэр Тоннермен құда түсуді шештім.
Dialogue: 0,0:20:27.67,0:20:31.27,jp.sub-ja,,0,0,0,,Мен осы Эклэр Тоннер ханыммен құда болуды шештім.
Dialogue: 0,0:20:32.61,0:20:38.62,Style1,,0,0,0,,Одан әрі Хост клубы Оуран жәрмеңкесінен кейін таратылады.
Dialogue: 0,0:20:32.70,0:20:35.94,jp.sub-ja,,0,0,0,,Одан кейін осы Оуран фестивалі аяқталғаннан кейін қабылдаушы клуб жауапты болады.
Dialogue: 0,0:20:36.31,0:20:36.87,jp.sub-ja,,0,0,0,,Тарту
Dialogue: 0,0:20:38.62,0:20:40.16,Style1,,0,0,0,,Барлығы осы.
Dialogue: 0,0:20:38.66,0:20:39.07,jp.sub-ja,,0,0,0,,Осымен
Dialogue: 0,0:20:41.24,0:20:46.58,Style1,,0,0,0,,Шынымды айтсам, мен сіздердің барлығыңызды ең біртүрлі адамдар деп ойладым.
Dialogue: 0,0:20:42.06,0:20:44.20,jp.sub-ja,,0,0,0,,Шынымды айтсам, мен барлығын ойлаймын.
Dialogue: 0,0:20:44.52,0:20:46.74,jp.sub-ja,,0,0,0,,Мен ойладым, неткен оғаш адамдар.
Dialogue: 0,0:20:46.58,0:20:49.68,Style1,,0,0,0,,Менің айтайын дегенім, үйірмеде, сабақтан кейін жүргізуші болып қызмет ету?
Dialogue: 0,0:20:47.33,0:20:49.59,jp.sub-ja,,0,0,0,,Мектептен кейінгі үйірменің қожайыны болу?
Dialogue: 0,0:20:49.68,0:20:52.75,Style1,,0,0,0,,«Бұл Оуран жәрмеңкесі» соңғы эпизод
Dialogue: 0,0:20:52.75,0:20:55.58,Style1,,0,0,0,,Бәріңіз, мен...
Dialogue: 0,0:20:53.67,0:20:55.58,jp.sub-ja,,0,0,0,,Мен бәрімін...
Dialogue: 0,0:20:57.08,0:21:03.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
