Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.80,staff-ja,,0,0,0,,Mam
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Жапония
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Syura
Dialogue: 0,0:00:00.00,0:00:03.17,staff-ja,,0,0,0,,Хагакуре аудармасы
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Уақыт картасы
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Наксияның әкімшілік жүйесі
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,OP&ED Hagakure
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,Сюра
Dialogue: 0,0:00:00.00,0:00:03.88,Default11-ja,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:00:12.89,0:00:15.07,jp.sub-ja,,0,0,0,,Кешігіп қалсаңыз, шу болады.
Dialogue: 0,0:00:12.93,0:00:15.06,Style1,,0,0,0,,Егер мен кешігіп қалсам, олар мені қуады.
Dialogue: 0,0:00:15.75,0:00:17.45,Style2,,0,0,0,,«№3 музыкалық бөлме»
Dialogue: 0,0:00:23.60,0:00:25.27,Style1,,0,0,0,,Қайда...
Dialogue: 0,0:00:25.27,0:00:26.76,Style1,,0,0,0,,...бұл ма?
Dialogue: 0,0:00:28.94,0:00:31.28,Style1,,0,0,0,,- Қош келдіңіз! - Қош келдіңіз!
Dialogue: 0,0:00:28.97,0:00:30.85,jp.sub-ja,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:00:31.19,0:00:34.99,jp.sub-ja,,0,0,0,,Есікті ашсам, тропиктік елде болдым.
Dialogue: 0,0:00:31.28,0:00:35.95,Style1,,0,0,0,,Есікті ашсам, оңтүстік тропиктер екен.
Dialogue: 0,0:00:35.95,0:00:39.62,Style1,,0,0,0,,Анашым, аспанда, бұл мен өткен аптада қосылуға мәжбүр болған клуб,
Dialogue: 0,0:00:36.10,0:00:41.27,jp.sub-ja,,0,0,0,,Аспандағы Ана Бұл мен өткен аптада қосылатын Ouran хост клубы.
Dialogue: 0,0:00:39.62,0:00:41.78,Style1,,0,0,0,,Ouran Host Club.
Dialogue: 0,0:00:45.23,0:00:48.22,Style1,,0,0,0,,«Орта мектеп жүргізушісінің жұмысы!»
Dialogue: 0,0:00:48.56,0:00:51.23,Style1,,0,0,0,,О, бұл сенсің, Харухи. Сіз кешіктіңіз.
Dialogue: 0,0:00:48.75,0:00:51.22,jp.sub-ja,,0,0,0,,Бұл не, Харухи? Сіз кешіктіңіз.
Dialogue: 0,0:00:51.23,0:00:55.57,Style1,,0,0,0,,Менің күнтізбеме сәйкес, бұл әлі сәуірдің басы.
Dialogue: 0,0:00:51.42,0:00:55.54,jp.sub-ja,,0,0,0,,Күнтізбе бойынша қазір сәуірдің басы шығар.
Dialogue: 0,0:00:57.90,0:01:01.57,Style1,,0,0,0,,Суықтан қорқып, котацу үстелінің астына жиналу бос сөз!
Dialogue: 0,0:00:57.95,0:01:01.34,jp.sub-ja,,0,0,0,,Суық ауадан қорқудан котацуда қорқу сияқты қарапайым адамдардың сезімдері
Dialogue: 0,0:01:01.57,0:01:05.24,Style1,,0,0,0,,Неліктен бізде бұл тамаша жылыту және салқындату жүйесі бар?
Dialogue: 0,0:01:01.67,0:01:04.89,jp.sub-ja,,0,0,0,,Бұл тамаша кондиционер жүйесі не үшін қажет?
Dialogue: 0,0:01:06.25,0:01:09.58,Style1,,0,0,0,,Біздің клубтың саясатына қандай да бір сындарыңыз бар ма?
Dialogue: 0,0:01:06.47,0:01:09.54,jp.sub-ja,,0,0,0,,Бұл біздің бөлімнің саясатына сын ба?
Dialogue: 0,0:01:09.58,0:01:12.85,Style1,,0,0,0,,Харухи-кун, сен бізге 8 миллион иен қарызсың.
Dialogue: 0,0:01:09.72,0:01:12.51,jp.sub-ja,,0,0,0,,Харухи 8 миллион иен қарызға батады.
Dialogue: 0,0:01:16.05,0:01:17.38,Style2,,0,0,0,,«Сегіз миллион иен»
Dialogue: 0,0:01:17.92,0:01:20.93,Style1,,0,0,0,,Жақсы адамдар үлкен киім кимейді.
Dialogue: 0,0:01:17.96,0:01:20.48,jp.sub-ja,,0,0,0,,Жақсы адам артық киім кимейді.
Dialogue: 0,0:01:20.93,0:01:24.93,Style1,,0,0,0,,Бұл әлемде ерте көктем салқын болуы мүмкін, бірақ біздің клубта,
Dialogue: 0,0:01:21.18,0:01:23.70,jp.sub-ja,,0,0,0,,Дүние суытып тұрғанда ерте көктем болса да
Dialogue: 0,0:01:23.89,0:01:29.43,jp.sub-ja,,0,0,0,,Бұл бөлімде біз жылы тропикалық аурасы бар мұздатылған котяттарды қарсы аламыз.
Dialogue: 0,0:01:24.93,0:01:29.27,Style1,,0,0,0,,біз суық котяттарды жылы, оңтүстік тропикалық аураға қарсы аламыз!
Dialogue: 0,0:01:29.27,0:01:32.27,Style1,,0,0,0,,Иә! Бүгінде бұл жер ең жоғарғы жұмақ,
Dialogue: 0,0:01:29.57,0:01:35.72,jp.sub-ja,,0,0,0,,Дұрыс, бүгін біз мәңгілік жазы бар ыстық аралда болдық.
Dialogue: 0,0:01:32.27,0:01:35.94,Style1,,0,0,0,,Мәңгілік жаздың ыстық, ыстық аралы!
Dialogue: 0,0:01:35.92,0:01:38.65,jp.sub-ja,,0,0,0,,Сөздің барлық мағынасында өте суық.
Dialogue: 0,0:01:35.94,0:01:39.28,Style1,,0,0,0,,Мен, керісінше, сөздің барлық мағынасында салқындағанды ​​сезінемін.
Dialogue: 0,0:01:40.25,0:01:44.78,jp.sub-ja,,0,0,0,,Бұл жеке компания, Оуран Гакуиннің отбасы және ақшасы бар.
Dialogue: 0,0:01:40.28,0:01:43.55,Style1,,0,0,0,,Әлеуметтік жағдайы бойынша бірінші кезекте мүмкіндігі барлар,
Dialogue: 0,0:01:43.55,0:01:47.55,Style1,,0,0,0,,және ақша бойынша екінші – уақыттарын осында, жеке Уран академиясында өткізеді.
Dialogue: 0,0:01:44.93,0:01:47.26,jp.sub-ja,,0,0,0,,Байлығы барлардың бос уақыты болады.
Dialogue: 0,0:01:47.55,0:01:50.56,Style1,,0,0,0,,Осылайша, Ouran Host Club - әдемі ұлдар
Dialogue: 0,0:01:47.68,0:01:49.54,jp.sub-ja,,0,0,0,,Сонымен, Ouran Host Club дегеніміз не?
Dialogue: 0,0:01:49.75,0:01:52.17,jp.sub-ja,,0,0,0,,Бос уақыты тым көп әдемі ұлдар
Dialogue: 0,0:01:50.56,0:01:53.56,Style1,,0,0,0,,тым көп уақытпен қыздардың көңілін көтереді,
Dialogue: 0,0:01:52.47,0:01:55.35,jp.sub-ja,,0,0,0,,Студент қыздар бар, олар да бос.
Dialogue: 0,0:01:53.56,0:01:55.56,Style1,,0,0,0,,кімнің де қолында тым көп уақыты бар.
Dialogue: 0,0:01:55.56,0:02:01.00,Style1,,0,0,0,,Бұл өте байлар үшін мектептің жеке, талғампаз ойын алаңы.
Dialogue: 0,0:01:55.69,0:02:00.35,jp.sub-ja,,0,0,0,,Бұл өте бай мектепке ғана тән тамаша ойын.
Dialogue: 0,0:02:01.69,0:02:04.32,Style2,,0,0,0,,«Хост клубы енді бизнес үшін ашық»
Dialogue: 0,0:02:02.23,0:02:04.10,jp.sub-ja,,0,0,0,,Қандай жүрексіз
Dialogue: 0,0:02:02.24,0:02:03.90,Style1,,0,0,0,,Қандай жүрексіздік!
Dialogue: 0,0:02:03.90,0:02:07.24,Style1,,0,0,0,,Тіпті піл сүйегі сияқты жылтыр теріммен,
Dialogue: 0,0:02:04.23,0:02:06.69,jp.sub-ja,,0,0,0,,Бұл тері піл сүйегіндей жылтыр
Dialogue: 0,0:02:07.24,0:02:10.58,Style1,,0,0,0,,және менің киімім, бали патшасының киімдері сияқты, маған өте жарасады,
Dialogue: 0,0:02:07.39,0:02:10.06,jp.sub-ja,,0,0,0,,Бали королінің киімі саған тым жарасады.
Dialogue: 0,0:02:10.58,0:02:13.25,Style1,,0,0,0,,Мен құдайымның алдында құлмын,
Dialogue: 0,0:02:10.60,0:02:15.42,jp.sub-ja,,0,0,0,,Тек құдайдың алдында тізе бүгіп, адалдыққа ант беретін қызметші.
Dialogue: 0,0:02:13.25,0:02:15.58,Style1,,0,0,0,,тізе бүгіп, адалдығыма ант берді.
Dialogue: 0,0:02:15.55,0:02:16.66,jp.sub-ja,,0,0,0,,Тамаки-кун
Dialogue: 0,0:02:15.58,0:02:16.58,Style1,,0,0,0,,Тамаки-кун...
Dialogue: 0,0:02:16.58,0:02:17.92,Style1,,0,0,0,,Тамаки-сама...
Dialogue: 0,0:02:16.81,0:02:17.98,jp.sub-ja,,0,0,0,,Тамаки-сама
Dialogue: 0,0:02:17.92,0:02:19.25,Style1,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:02:18.09,0:02:19.24,jp.sub-ja,,0,0,0,,Керемет
Dialogue: 0,0:02:19.25,0:02:25.59,Style1,,0,0,0,,Иә, келесі аптада Ouran Host Club би кешіне демеушілік жасайды.
Dialogue: 0,0:02:19.39,0:02:22.64,jp.sub-ja,,0,0,0,,Дұрыс, келесі аптада Ouran Host Club өтеді.
Dialogue: 0,0:02:22.77,0:02:24.99,jp.sub-ja,,0,0,0,,Біз би кешін өткізіп жатырмыз.
Dialogue: 0,0:02:25.54,0:02:27.12,jp.sub-ja,,0,0,0,,Би кеші?
Dialogue: 0,0:02:25.59,0:02:27.26,Style1,,0,0,0,,Би кеші?
Dialogue: 0,0:02:27.26,0:02:30.60,Style1,,0,0,0,,Сіз бұл би кешінде не істейсіз?
Dialogue: 0,0:02:27.51,0:02:30.54,jp.sub-ja,,0,0,0,,Би кешінде не істейсің?
Dialogue: 0,0:02:30.60,0:02:33.33,Style1,,0,0,0,,Біз орталық ғимараттағы үлкен залды жалға алып жатырмыз...
Dialogue: 0,0:02:30.97,0:02:33.30,jp.sub-ja,,0,0,0,,Орталық ғимараттағы үлкен залды жалға алуға болады.
Dialogue: 0,0:02:31.29,0:02:34.02,Style2,,0,0,0,,«Хикару Хитачиин, орта мектеп 1-курс»
Dialogue: 0,0:02:33.53,0:02:35.39,jp.sub-ja,,0,0,0,,Мен оны ең жақсы етіп жасаймын!
Dialogue: 0,0:02:33.60,0:02:35.94,Style1,,0,0,0,,...және сол жерде үлкен басты оқиғаны өткізу.
Dialogue: 0,0:02:34.02,0:02:35.99,Style2,,0,0,0,,«Каору Хитачиин, орта мектеп 1-курс»
Dialogue: 0,0:02:35.94,0:02:39.61,Style1,,0,0,0,,Дегенмен, мен сенімен жалғыз өткізгім келді, Каору.
Dialogue: 0,0:02:36.07,0:02:39.62,jp.sub-ja,,0,0,0,,Негізі мен екеуіңмен уақыт өткізгім келді, Каору.
Dialogue: 0,0:02:39.61,0:02:42.88,Style1,,0,0,0,,Олай айтпа, Хикару. Мен оны шынымен қалаған адаммын ...
Dialogue: 0,0:02:39.72,0:02:42.82,jp.sub-ja,,0,0,0,,Айтпа, Хикари, бұл менмін...
Dialogue: 0,0:02:42.88,0:02:43.88,Style1,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:02:43.12,0:02:46.24,jp.sub-ja,,0,0,0,,Ғажайып, ағайындық махаббаттың оңтүстік махаббаты.
Dialogue: 0,0:02:43.88,0:02:46.55,Style1,,0,0,0,,Оңтүстік тропикалық хош иісі бар ағайындық махаббат!
Dialogue: 0,0:02:46.55,0:02:50.22,Style1,,0,0,0,,Қонақтар әдеттегіден бетер дайын болып көрінеді, иә?
Dialogue: 0,0:02:46.81,0:02:50.21,jp.sub-ja,,0,0,0,,Клиенттер әдеттегіден гөрі қуанған сияқты.
Dialogue: 0,0:02:50.22,0:02:52.89,Style1,,0,0,0,,Аздап орташа әсер ету танымал.
Dialogue: 0,0:02:50.49,0:02:52.79,jp.sub-ja,,0,0,0,,Орташа әсер жақсы қабылданады
Dialogue: 0,0:02:52.89,0:02:55.89,Style1,,0,0,0,,Сіз бұл тропикалық жобаны ойлап таптыңыз ба, Кёя-сенпай?
Dialogue: 0,0:02:53.11,0:02:55.97,jp.sub-ja,,0,0,0,,Бұл тропикалық жобаны Кёуя-сенпай жасаған.
Dialogue: 0,0:02:55.89,0:02:57.89,Style1,,0,0,0,,Менің шешім қабылдау құқығым жоқ.
Dialogue: 0,0:02:56.10,0:02:58.02,jp.sub-ja,,0,0,0,,Менің шешім қабылдауға құқығым жоқ.
Dialogue: 0,0:02:57.89,0:03:01.56,Style1,,0,0,0,,Бұл клубтың барлық саясатын Тамаки патша бекітеді.
Dialogue: 0,0:02:58.17,0:03:01.44,jp.sub-ja,,0,0,0,,Осы бөлімнің барлық саясатын King Ring басқарады.
Dialogue: 0,0:03:01.56,0:03:03.90,Style1,,0,0,0,,Дегенмен, мен бұл күш салуға тұрарлық деп таптым
Dialogue: 0,0:03:01.63,0:03:06.57,jp.sub-ja,,0,0,0,,Менің ойымша, оның үстеліне кездейсоқ Бали фотокітапшасын қою керек болды.
Dialogue: 0,0:03:03.90,0:03:06.89,Style1,,0,0,0,,Балидің фотокітапшасын үстеліне кездейсоқ сырғыту.
Dialogue: 0,0:03:08.23,0:03:11.24,Style1,,0,0,0,,Бұл жігіт көлеңкелі патша.
Dialogue: 0,0:03:08.34,0:03:10.79,jp.sub-ja,,0,0,0,,Бұл адам көлеңкелердің патшасы.
Dialogue: 0,0:03:11.24,0:03:12.91,Style1,,0,0,0,,Та-да!!
Dialogue: 0,0:03:12.89,0:03:14.74,jp.sub-ja,,0,0,0,,Бал-кун сүйкімді
Dialogue: 0,0:03:12.91,0:03:14.57,Style1,,0,0,0,,Бал-кун, сен сондай сүйкімдісің!
Dialogue: 0,0:03:14.57,0:03:19.25,Style1,,0,0,0,,Хи хи, бұл бали гүлдері. Біз оларды ұшып әкелдік.
Dialogue: 0,0:03:15.68,0:03:19.02,jp.sub-ja,,0,0,0,,Бұл гүлдер Балиден әкелінді.
Dialogue: 0,0:03:19.14,0:03:20.21,jp.sub-ja,,0,0,0,,Ах Такаши
Dialogue: 0,0:03:19.25,0:03:20.91,Style1,,0,0,0,,Әй, Такаши!
Dialogue: 0,0:03:25.59,0:03:27.78,Style1,,0,0,0,,Қараңдар! Енді біз сәйкестік!
Dialogue: 0,0:03:25.66,0:03:27.60,jp.sub-ja,,0,0,0,,Сәлеметсіңдер ме
Dialogue: 0,0:03:26.28,0:03:28.47,Style2,,0,0,0,,"Такаши Моринозука (қысқаша "Мори") 3-ші орта мектеп" "Мицукуни Ханинозука (қысқаша "Бал") 3-ші орта мектеп"
Dialogue: 0,0:03:28.59,0:03:30.59,Style1,,0,0,0,,Барлығыңыз камеллиядасыз!
Dialogue: 0,0:03:28.71,0:03:30.38,jp.sub-ja,,0,0,0,,Цубакиин но Кими
Dialogue: 0,0:03:30.59,0:03:33.59,Style1,,0,0,0,,Әдеттегідей, мен бұл екеуінің не істеп жатқанын білмеймін.
Dialogue: 0,0:03:30.80,0:03:33.66,jp.sub-ja,,0,0,0,,Бұл екеуінің әлі мағынасы жоқ.
Dialogue: 0,0:03:33.59,0:03:35.26,Style1,,0,0,0,,Харухи-кун...
Dialogue: 0,0:03:33.86,0:03:34.84,jp.sub-ja,,0,0,0,,Харухи-кун
Dialogue: 0,0:03:35.26,0:03:37.93,Style1,,0,0,0,,Харухи-кун, сен оңтүстік тропикалық киім кимейсің бе?
Dialogue: 0,0:03:35.50,0:03:38.11,jp.sub-ja,,0,0,0,,Харухи-кун тропикалық костюмдер кимейді.
Dialogue: 0,0:03:37.93,0:03:39.27,Style1,,0,0,0,,Мен мұны көргім келеді.
Dialogue: 0,0:03:38.40,0:03:39.39,jp.sub-ja,,0,0,0,,Мен оны көргім келеді
Dialogue: 0,0:03:39.27,0:03:40.93,Style1,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:03:39.52,0:03:40.95,jp.sub-ja,,0,0,0,,Жоқ мен...
Dialogue: 0,0:03:40.93,0:03:45.87,Style1,,0,0,0,,Менің ойымша, ерте көктемде ерте көктемгі киім кию табиғи нәрсе.
Dialogue: 0,0:03:41.16,0:03:45.79,jp.sub-ja,,0,0,0,,Өйткені, ерте көктемде ерте көктем сияқты киіну табиғи нәрсе деп ойлаймын.
Dialogue: 0,0:03:45.87,0:03:50.21,Style1,,0,0,0,,Харухи, бізде саған бір дайын бар. Не керек, ол менімен жұптастырылған.
Dialogue: 0,0:03:46.24,0:03:50.28,jp.sub-ja,,0,0,0,,Мен Харухиге де дайындап қойдым, ол менімен жұптасып кетті.
Dialogue: 0,0:03:50.21,0:03:51.54,Style1,,0,0,0,,Жоқ рахмет.
Dialogue: 0,0:03:50.41,0:03:51.17,jp.sub-ja,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:03:52.55,0:03:56.22,Style1,,0,0,0,,Харухи-кун, сенде жыл мезгілдерін жақсы сезінесің, иә?
Dialogue: 0,0:03:52.80,0:03:56.26,jp.sub-ja,,0,0,0,,Харухи-кун, сен жыл мезгілдері сезімін бағалайсың, солай емес пе?
Dialogue: 0,0:03:56.22,0:04:01.55,Style1,,0,0,0,,Олай болса, би кешіне шие гүлдері құлпырып тұр деп сенемін.
Dialogue: 0,0:03:56.41,0:03:58.63,jp.sub-ja,,0,0,0,,Содан кейін би кешінде
Dialogue: 0,0:03:58.76,0:04:01.40,jp.sub-ja,,0,0,0,,Шие гүлдесе жақсы болар еді.
Dialogue: 0,0:04:01.55,0:04:04.22,Style1,,0,0,0,,Екеуміз тербелген шие гүлдерінің арасында билейміз...
Dialogue: 0,0:04:01.55,0:04:05.74,jp.sub-ja,,0,0,0,,Құлаған шие гүлдерінде билеген екі адам, бұл арман емес пе?
Dialogue: 0,0:04:04.22,0:04:05.89,Style1,,0,0,0,,Бұл соншалықты арманшыл ...
Dialogue: 0,0:04:05.89,0:04:07.89,Style1,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:04:05.99,0:04:07.96,jp.sub-ja,,0,0,0,,Солай ма?
Dialogue: 0,0:04:07.89,0:04:11.59,Style1,,0,0,0,,Ханымдар, сіз осындай армандар көретіндей сүйкімдісіз.
Dialogue: 0,0:04:08.05,0:04:12.28,Style2,,0,0,0,,"Харухи Фудзиока, 1-ші орта мектеп"
Dialogue: 0,0:04:08.13,0:04:11.82,jp.sub-ja,,0,0,0,,Әр адамның арманы бар, сүйкімді.
Dialogue: 0,0:04:15.29,0:04:18.82,Style2,,0,0,0,,«Хост клубының болашағы зор табиғи жаңа ойыншысы»
Dialogue: 0,0:04:17.44,0:04:22.93,jp.sub-ja,,0,0,0,,Кешіріңіз, номинацияларды ауыстыру уақыты жақындап қалды деп ойлаймын.
Dialogue: 0,0:04:17.57,0:04:19.24,Style1,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:04:19.24,0:04:22.91,Style1,,0,0,0,,Менің ойымша, тағайындалған өзгерістердің уақыты жақындап қалды.
Dialogue: 0,0:04:22.91,0:04:27.25,Style1,,0,0,0,,Ой, кешіріңіз. Сіз менің келесі кездесуім болуыңыз керек, ханым...
Dialogue: 0,0:04:23.82,0:04:26.64,jp.sub-ja,,0,0,0,,Кешіріңіз, келесі брондау...
Dialogue: 0,0:04:27.25,0:04:30.58,Style1,,0,0,0,,Касугазаки Канако, 2-курс В сыныбы.
Dialogue: 0,0:04:27.33,0:04:30.21,jp.sub-ja,,0,0,0,,2 В сыныбы, Канаде Касугазаки
Dialogue: 0,0:04:30.58,0:04:33.25,Style1,,0,0,0,,Сен өсектен де сүйкімдісің.
Dialogue: 0,0:04:30.83,0:04:33.18,jp.sub-ja,,0,0,0,,Сіз өсек-аяңнан да сүйкімдісіз.
Dialogue: 0,0:04:34.22,0:04:38.50,jp.sub-ja,,0,0,0,,Мен шештім. Келесі жолы мен сені сүйікті етемін.
Dialogue: 0,0:04:34.25,0:04:35.42,Style1,,0,0,0,,Мен шешім қабылдадым.
Dialogue: 0,0:04:35.42,0:04:38.91,Style1,,0,0,0,,Мен сені жаңа сүйіктім етемін.
Dialogue: 0,0:04:42.86,0:04:44.20,Style1,,0,0,0,,Мен мұны қабылдай алмаймын.
Dialogue: 0,0:04:42.99,0:04:44.89,Style2,,0,0,0,,«Рамен»
Dialogue: 0,0:04:43.13,0:04:44.41,jp.sub-ja,,0,0,0,,Мен келіспеймін.
Dialogue: 0,0:04:44.20,0:04:47.20,Style1,,0,0,0,,Мырза, мына қарапайым адамның раменін жеуді доғарыңыз,
Dialogue: 0,0:04:44.58,0:04:47.27,jp.sub-ja,,0,0,0,,Мырза, қарапайым раменді жемеңіз.
Dialogue: 0,0:04:47.20,0:04:49.87,Style1,,0,0,0,,және би кешін жоспарлауға көмектесіңіз.
Dialogue: 0,0:04:47.38,0:04:49.73,jp.sub-ja,,0,0,0,,Маған би кешін жоспарлауға көмектесіңіз.
Dialogue: 0,0:04:49.87,0:04:52.21,Style1,,0,0,0,,Ханшайым Касуга Харухиді ұнатады ма?
Dialogue: 0,0:04:50.05,0:04:54.25,jp.sub-ja,,0,0,0,,Сізге Харухи ханшайым Касуга ұнағанын ұнатпайсыз ба?
Dialogue: 0,0:04:52.21,0:04:54.21,Style1,,0,0,0,,шынымен сізді сонша мазалайды ма?
Dialogue: 0,0:04:54.21,0:04:57.54,Style1,,0,0,0,,Оның ауруы жаңадан басталған нәрсе емес пе?
Dialogue: 0,0:04:54.49,0:04:57.78,jp.sub-ja,,0,0,0,,Оның ауруы жаңа емес шығар.
Dialogue: 0,0:04:57.54,0:04:58.88,Style1,,0,0,0,,Ауру?
Dialogue: 0,0:04:57.88,0:04:58.57,jp.sub-ja,,0,0,0,,Ауру?
Dialogue: 0,0:04:58.88,0:05:01.21,Style1,,0,0,0,,Кезбе-секіру ауруы.
Dialogue: 0,0:04:58.97,0:05:00.87,jp.sub-ja,,0,0,0,,ығыстырылған хост секіргіш ауруы
Dialogue: 0,0:05:01.21,0:05:03.88,Style1,,0,0,0,,Әйтпесе, ешқашан бірдей бала-екі рет ауру ретінде белгілі.
Dialogue: 0,0:05:01.39,0:05:03.91,jp.sub-ja,,0,0,0,,Басқаша айтқанда, бұл адам алмасу ауруы.
Dialogue: 0,0:05:03.88,0:05:08.55,Style1,,0,0,0,,Әдетте біздің тұрақты тұтынушыларымыз бір хостты мәңгілікке белгілейді,
Dialogue: 0,0:05:04.18,0:05:08.28,jp.sub-ja,,0,0,0,,Әдетте тұрақты тұтынушылар серіктесті тұрақты түрде белгілейді.
Dialogue: 0,0:05:08.48,0:05:11.81,jp.sub-ja,,0,0,0,,Ол өзінің таңдаулыларын үнемі өзгертуге бейім.
Dialogue: 0,0:05:08.55,0:05:12.23,Style1,,0,0,0,,бірақ ол өзінің сүйіктісін тұрақты түрде ауыстырады.
Dialogue: 0,0:05:12.23,0:05:15.66,Style1,,0,0,0,,Соңғы уақытқа дейін ол Тама-чанмен бірге болды, солай ма?
Dialogue: 0,0:05:12.45,0:05:15.52,jp.sub-ja,,0,0,0,,Соңғы уақытқа дейін бұл Тама-чан болатын, солай ма?
Dialogue: 0,0:05:16.35,0:05:18.91,Style2,,0,0,0,,«Өткен күндердегі жұп (бір апта бұрын)»
Dialogue: 0,0:05:18.92,0:05:21.89,jp.sub-ja,,0,0,0,,А, менің клиентімді алып кетті.
Dialogue: 0,0:05:19.03,0:05:21.90,Style1,,0,0,0,,Әй, бұл оның қонағын тартып алғаны үшін.
Dialogue: 0,0:05:19.72,0:05:22.59,Style2,,0,0,0,,«Қазір түсінеді»
Dialogue: 0,0:05:21.90,0:05:24.57,Style1,,0,0,0,,Бұлай емес! Сондықтан емес!
Dialogue: 0,0:05:22.02,0:05:24.28,jp.sub-ja,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:05:24.49,0:05:29.00,jp.sub-ja,,0,0,0,,Шыдамның шегіне жеттім. Харухи, әйел сияқты киін.
Dialogue: 0,0:05:24.57,0:05:30.24,Style1,,0,0,0,,Мен шыдамның шегіндемін! Харухи, қыз сияқты киінуді баста!
Dialogue: 0,0:05:30.24,0:05:32.91,Style1,,0,0,0,,Неліктен қыздар арасында соншалықты танымал болу керек?
Dialogue: 0,0:05:30.30,0:05:34.81,jp.sub-ja,,0,0,0,,Әйелдер арасында танымал болу үшін әйел болудың несі өкінішті?
Dialogue: 0,0:05:32.91,0:05:35.25,Style1,,0,0,0,,Өзің қыз болғанда!?
Dialogue: 0,0:05:35.25,0:05:38.58,Style1,,0,0,0,,Ашығын айтқанда, сенің қыз екеніңді осы клубта білетіндер ғана!
Dialogue: 0,0:05:35.25,0:05:38.59,jp.sub-ja,,0,0,0,,Шынымды айтсам, сіздің әйел екеніңізді тек клуб мүшелері біледі.
Dialogue: 0,0:05:38.58,0:05:40.59,Style1,,0,0,0,,Ол дене шынықтыру сабағына қатысудан бас тартты.
Dialogue: 0,0:05:38.69,0:05:40.87,jp.sub-ja,,0,0,0,,Дене шынықтыру міндетті емес, мен оны қабылдамаймын.
Dialogue: 0,0:05:40.59,0:05:44.32,Style1,,0,0,0,,Сабаққа қатысу саны ұлдар мен қыздар арасында аралас, сондықтан ешкім айта алмайды.
Dialogue: 0,0:05:41.04,0:05:43.69,jp.sub-ja,,0,0,0,,Қатысу саны да аралас, сондықтан ешкім білмейді.
Dialogue: 0,0:05:45.21,0:05:49.78,Style2,,0,0,0,,«Патшаның жеке меншігі»
Dialogue: 0,0:05:45.86,0:05:49.53,Style1,,0,0,0,,Әке... Әке...
Dialogue: 0,0:05:46.21,0:05:48.45,jp.sub-ja,,0,0,0,,Менің әкем менің әкем.
Dialogue: 0,0:05:49.53,0:05:51.53,Style1,,0,0,0,,...сені сол кездегідей көргісі келеді!
Dialogue: 0,0:05:49.56,0:05:51.83,jp.sub-ja,,0,0,0,,Мен сені осы күндері көргім келеді.
Dialogue: 0,0:05:51.53,0:05:54.53,Style1,,0,0,0,,Менен сұрамай фотоларымды жарып жібермеңіздерші!
Dialogue: 0,0:05:51.95,0:05:54.43,jp.sub-ja,,0,0,0,,Адамдардың суреттерін рұқсатсыз созбаңыз
Dialogue: 0,0:05:54.53,0:05:56.97,Style1,,0,0,0,,Бұған қараған сайын таңғаламын.
Dialogue: 0,0:05:54.60,0:05:56.89,jp.sub-ja,,0,0,0,,Қараған сайын жұмбақ бола түседі.
Dialogue: 0,0:05:57.20,0:05:59.87,Style1,,0,0,0,,Бұл қалайша солай бола алады?
Dialogue: 0,0:05:57.38,0:06:00.11,jp.sub-ja,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:05:57.66,0:06:00.32,Style2,,0,0,0,,«Бұл» «Бұл»
Dialogue: 0,0:05:59.87,0:06:01.54,Style1,,0,0,0,,Қабылдау рәсімінен бір күн бұрын,
Dialogue: 0,0:06:00.26,0:06:04.57,jp.sub-ja,,0,0,0,,Мектептен бір күн бұрын көршінің баласы шашыма сағыз жабыстырып алды.
Dialogue: 0,0:06:01.54,0:06:05.03,Style1,,0,0,0,,Маңайдағы балалардың бірінен шашыма сағыз жабысты.
Dialogue: 0,0:06:06.88,0:06:09.22,Style1,,0,0,0,,Шығудың азапты болғаны сонша, мен оны кесіп тастадым.
Dialogue: 0,0:06:06.97,0:06:08.93,jp.sub-ja,,0,0,0,,Мазасыздық болды, мен оны үздім.
Dialogue: 0,0:06:09.22,0:06:13.55,Style1,,0,0,0,,``Кен''[ore-l] менің ұл балаға ұқсайтыныма мүлдем мән бермеді.
Dialogue: 0,0:06:09.27,0:06:12.52,jp.sub-ja,,0,0,0,,Мен үшін еркектердің маған қарағанына бәрібір.
Dialogue: 0,0:06:13.55,0:06:16.22,Style1,,0,0,0,,Қыздар өздерін «кен» деп атамауы керек!
Dialogue: 0,0:06:13.76,0:06:16.00,jp.sub-ja,,0,0,0,,Қыз «мен» бола алмайды
Dialogue: 0,0:06:16.19,0:06:20.55,jp.sub-ja,,0,0,0,,Харухи анасы лас сөздерді қолданады~
Dialogue: 0,0:06:16.22,0:06:20.56,Style1,,0,0,0,,Анашым! Харухи лас сөздер айтып жатыр!
Dialogue: 0,0:06:20.56,0:06:21.89,Style1,,0,0,0,,«Ана» деген кім?
Dialogue: 0,0:06:20.67,0:06:21.83,jp.sub-ja,,0,0,0,,Ана
Dialogue: 0,0:06:21.89,0:06:24.23,Style1,,0,0,0,,Клуб позициясы тұрғысынан, мен солай деп ойлаймын.
Dialogue: 0,0:06:22.13,0:06:24.16,jp.sub-ja,,0,0,0,,Лауазымы бойынша бұл мен шығармын.
Dialogue: 0,0:06:24.23,0:06:27.23,Style1,,0,0,0,,Ақыр соңында, мен оқуды бітіргенше қарызымды өтей аламын
Dialogue: 0,0:06:24.28,0:06:27.23,jp.sub-ja,,0,0,0,,Себебі мен оқуымды бітіргенше аула сыпырушы болғанды жөн көремін.
Dialogue: 0,0:06:27.23,0:06:30.90,Style1,,0,0,0,,тағайындалған үй иесі болу арқылы, мен жұмысшы ретінде істей аламын.
Dialogue: 0,0:06:27.44,0:06:30.63,jp.sub-ja,,0,0,0,,Жүргізуші болып, номинацияларды алу арқылы қарызыңызды өтейтін сияқтысыз.
Dialogue: 0,0:06:30.90,0:06:33.91,Style1,,0,0,0,,Айтпақшы, сізде әлеуметтік биден тәжірибе бар ма?
Dialogue: 0,0:06:30.95,0:06:33.49,jp.sub-ja,,0,0,0,,Айтпақшы, бал биінен тәжірибеңіз бар ма?
Dialogue: 0,0:06:33.91,0:06:35.58,Style1,,0,0,0,,Бұл партия үшін өте маңызды.
Dialogue: 0,0:06:34.00,0:06:35.52,jp.sub-ja,,0,0,0,,Бұл кештер үшін қажет.
Dialogue: 0,0:06:35.58,0:06:40.25,Style1,,0,0,0,,Иә? Жоқ, бірақ партияның менің квотаға қатысы жоқ, солай ма?
Dialogue: 0,0:06:36.35,0:06:40.19,jp.sub-ja,,0,0,0,,Жоқ, бірақ партияның квотаға еш қатысы жоқ.
Dialogue: 0,0:06:40.25,0:06:44.52,Style1,,0,0,0,,Мен іс-шараларға баруға онша қызықпаймын, сондықтан кешірім болса...
Dialogue: 0,0:06:40.34,0:06:43.33,jp.sub-ja,,0,0,0,,Оқиғалар мені қызықтырмайды, сондықтан мүмкін болса, келмеймін...
Dialogue: 0,0:06:44.52,0:06:48.52,Style1,,0,0,0,,Жоқ, әлеуметтiк билер джентльменге тән кәдiм.
Dialogue: 0,0:06:44.72,0:06:48.33,jp.sub-ja,,0,0,0,,Жоқ. Бал биі мырзалар үшін қарапайым ұғым.
Dialogue: 0,0:06:48.52,0:06:51.52,Style1,,0,0,0,,Егер сіз үй иесінің жолымен өте нашар жүргіңіз келсе,
Dialogue: 0,0:06:48.63,0:06:51.23,jp.sub-ja,,0,0,0,,Егер сіз хост ретінде алысқа барғыңыз келсе
Dialogue: 0,0:06:51.49,0:06:54.16,jp.sub-ja,,0,0,0,,Харухи-кун, сенің қаншалықты шешімді екеніңді көрсетейін.
Dialogue: 0,0:06:51.52,0:06:54.53,Style1,,0,0,0,,онда сен бізге қаншалықты алысқа баруға дайын екеніңді көрсетуің керек, Харухи-кун.
Dialogue: 0,0:06:54.53,0:06:57.20,Style1,,0,0,0,,Егер сіз бір аптада вальсты меңгере алмасаңыз,
Dialogue: 0,0:06:54.56,0:06:57.36,jp.sub-ja,,0,0,0,,Вальсті бір аптада меңгерді
Dialogue: 0,0:06:57.20,0:07:00.53,Style1,,0,0,0,,және оны келесі аптадағы кеште бізге көрсетіңіз,
Dialogue: 0,0:06:57.53,0:06:59.88,jp.sub-ja,,0,0,0,,Келесі аптада кеште көрсете алмасаңыз
Dialogue: 0,0:07:00.53,0:07:02.54,Style1,,0,0,0,,сонда мен сенің қыз екеніңді ашамын,
Dialogue: 0,0:07:00.54,0:07:04.45,jp.sub-ja,,0,0,0,,Қыз екеніңді айтып, жұмыстан төмендейсің.
Dialogue: 0,0:07:02.54,0:07:04.60,Style1,,0,0,0,,және сені тапсырманы орындауға жіберемін!
Dialogue: 0,0:07:05.29,0:07:07.36,Style2,,0,0,0,,«Борышкер студент»
Dialogue: 0,0:07:07.36,0:07:10.35,Style2,,0,0,0,,«Келесі күні»
Dialogue: 0,0:07:07.54,0:07:12.21,Style1,,0,0,0,,Жылдам, жылдам, баяу...
Dialogue: 0,0:07:07.55,0:07:11.97,jp.sub-ja,,0,0,0,,Жылдам лақтыру Жылдам лақтыру
Dialogue: 0,0:07:12.21,0:07:16.22,Style1,,0,0,0,,Жақсы, Харухикун. «Баяу» күйде аяқтарыңызды біріктіріңіз.
Dialogue: 0,0:07:12.25,0:07:15.66,jp.sub-ja,,0,0,0,,Ал, Харухи-кун, жылдамдықты бәсеңдетіп, аяғыңды теңестір.
Dialogue: 0,0:07:16.22,0:07:18.72,Style1,,0,0,0,,Джентльмен әрқашан жетекшілік етеді.
Dialogue: 0,0:07:16.52,0:07:20.89,jp.sub-ja,,0,0,0,,Джентельмен жетекші әйел серіктесіне жақсы қарауы керек.
Dialogue: 0,0:07:18.72,0:07:21.22,Style1,,0,0,0,,Билеп жатқан қызға міндетті түрде қараңыз.
Dialogue: 0,0:07:21.22,0:07:22.55,Style1,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:26.89,0:07:29.23,Style1,,0,0,0,,Кешіріңіз, Касугазаки-сан!
Dialogue: 0,0:07:26.94,0:07:28.84,jp.sub-ja,,0,0,0,,Кешіріңіз, Касугазаки-сан.
Dialogue: 0,0:07:29.23,0:07:31.22,Style1,,0,0,0,,Жарайды, Харухи-кун.
Dialogue: 0,0:07:29.37,0:07:30.89,jp.sub-ja,,0,0,0,,Жарайды, Харухи-кун.
Dialogue: 0,0:07:32.23,0:07:34.57,Style1,,0,0,0,,Сіз мұңайып тұрсыз, сэр.
Dialogue: 0,0:07:32.25,0:07:34.52,jp.sub-ja,,0,0,0,,Ымырт болды, сэр.
Dialogue: 0,0:07:34.57,0:07:37.57,Style1,,0,0,0,,Ол өзімен бірге жаттыққан адам болғысы келетінін айтты.
Dialogue: 0,0:07:34.71,0:07:37.27,jp.sub-ja,,0,0,0,,Ол өзінің жаттығу серіктесі болғысы келетінін айтты.
Dialogue: 0,0:07:37.57,0:07:41.91,Style1,,0,0,0,,Ол Харухи-кун үшін әйел ретінде тұру үшін тым ұзын.
Dialogue: 0,0:07:37.68,0:07:40.84,jp.sub-ja,,0,0,0,,Бойыма байланысты Харухидің әйел рөлін ойнау мүмкін емес.
Dialogue: 0,0:07:41.88,0:07:45.45,jp.sub-ja,,0,0,0,,Кешіріңіз, Касугазаки мырза, менің жаттығудағы серіктесім...
Dialogue: 0,0:07:41.91,0:07:43.84,Style1,,0,0,0,,Сізге көп рахмет, Касугазаки-сан,
Dialogue: 0,0:07:43.84,0:07:45.51,Style1,,0,0,0,,маған сізбен жаттығуға рұқсат бергеніңіз үшін.
Dialogue: 0,0:07:45.51,0:07:47.51,Style1,,0,0,0,,О, жарайды.
Dialogue: 0,0:07:45.73,0:07:51.73,jp.sub-ja,,0,0,0,,Жарайды. Бұйыртса, арнайы дайындықтың арқасында біраз уақытқа дейін тұтынушыларға қызмет көрсетуден бас тартады деп естідім.
Dialogue: 0,0:07:47.51,0:07:49.18,Style1,,0,0,0,,Сіз кез келген тұтынушыларды қызықтырмай жатқаныңызды естідім,
Dialogue: 0,0:07:49.18,0:07:51.85,Style1,,0,0,0,,арнайы дайындықтан өту үшін, солай емес пе?
Dialogue: 0,0:07:51.85,0:07:55.19,Style1,,0,0,0,,Мен бәріңнің қасымда болғаныма әлдеқайда бақыттымын.
Dialogue: 0,0:07:51.92,0:07:54.46,jp.sub-ja,,0,0,0,,Шындығында, мен оны тек қана алғаныма қуаныштымын.
Dialogue: 0,0:07:55.19,0:07:56.52,Style1,,0,0,0,,Иә...
Dialogue: 0,0:07:56.49,0:08:00.48,jp.sub-ja,,0,0,0,,О, мен теңіз балдырынан жаңа кесе алдым.
Dialogue: 0,0:07:56.52,0:08:00.69,Style1,,0,0,0,,О, менің! Сізде жаңа шыныаяқтар бар ма? Джинори, солай ма?
Dialogue: 0,0:08:00.69,0:08:02.20,Style1,,0,0,0,,Джинори? [жерде өсірілген теңіз балдыры]
Dialogue: 0,0:08:00.93,0:08:02.04,jp.sub-ja,,0,0,0,,Ұнтақталған теңіз балдыры?
Dialogue: 0,0:08:02.20,0:08:06.87,Style1,,0,0,0,,Сізде шынымен де өткір көз бар. Олар кеше ғана келді.
Dialogue: 0,0:08:02.30,0:08:06.63,jp.sub-ja,,0,0,0,,Күткендей, сізде керемет дәм бар. Бұл зат кеше ғана келді.
Dialogue: 0,0:08:06.87,0:08:11.20,Style1,,0,0,0,,Соңғы уақытта біздің клуб шай жиынтықтарын жақсартуға ұмтылуда.
Dialogue: 0,0:08:06.93,0:08:10.80,jp.sub-ja,,0,0,0,,Соңғы уақытта біздің клуб шай жиынтықтарын жақсартуға көп күш салуда.
Dialogue: 0,0:08:11.20,0:08:15.87,Style1,,0,0,0,,Мен көремін. Бұл жақсы түс. Өте сүйкімді.
Dialogue: 0,0:08:11.27,0:08:15.13,jp.sub-ja,,0,0,0,,Иә, жақсы түс, әдемі.
Dialogue: 0,0:08:16.86,0:08:18.46,jp.sub-ja,,0,0,0,,Сонда сізге ыдыс-аяқ ұнайды ма?
Dialogue: 0,0:08:16.88,0:08:19.21,Style1,,0,0,0,,Ыдыс-аяқтарды жақсы көретін шығарсыз, иә?
Dialogue: 0,0:08:19.17,0:08:23.57,jp.sub-ja,,0,0,0,,Бол Бол Бол Бол Маған қатты ұнамайсың Эй, сен не айтып тұрсың?
Dialogue: 0,0:08:19.21,0:08:21.71,Style1,,0,0,0,,N-n-жоқ, жоқ, жоқ.
Dialogue: 0,0:08:21.71,0:08:23.88,Style1,,0,0,0,,Менің сөзім, сен не айтып тұрсың?
Dialogue: 0,0:08:23.80,0:08:25.36,jp.sub-ja,,0,0,0,,♪ Дан, дан-тан…
Dialogue: 0,0:08:23.88,0:08:27.88,Style1,,0,0,0,,Оған ұнайды. Бірақ ол неге жасырады?
Dialogue: 0,0:08:25.70,0:08:27.99,jp.sub-ja,,0,0,0,,Бірақ оны неге жасырасың?
Dialogue: 0,0:08:28.89,0:08:32.56,Style1,,0,0,0,,Сәлеметсіз бе, мен сіз тапсырыс берген шыныаяқтарды әкелдім.
Dialogue: 0,0:08:29.08,0:08:32.58,jp.sub-ja,,0,0,0,,Сәлеметсіз бе, мен сіз тапсырыс берген шыныаяқты әкелдім.
Dialogue: 0,0:08:32.56,0:08:35.23,Style1,,0,0,0,,Ах, рахмет.
Dialogue: 0,0:08:32.69,0:08:34.84,jp.sub-ja,,0,0,0,,Аа, еңбегіңіз үшін рахмет.
Dialogue: 0,0:08:35.23,0:08:39.23,Style1,,0,0,0,,Бізге таңдаған әрбір бұйым қыздарға ұнайды.
Dialogue: 0,0:08:35.46,0:08:39.43,jp.sub-ja,,0,0,0,,Сіз таңдаған заттардың барлығы қыздар арасында танымал.
Dialogue: 0,0:08:39.23,0:08:40.57,Style1,,0,0,0,,Бұл өте әсерлі.
Dialogue: 0,0:08:39.61,0:08:40.57,jp.sub-ja,,0,0,0,,Өйткені есіктің арғы жағында жалаңаш қыз тұр.
Dialogue: 0,0:08:40.57,0:08:42.90,Style1,,0,0,0,,Бұл тыңдау жақсы.
Dialogue: 0,0:08:40.84,0:08:42.25,jp.sub-ja,,0,0,0,,Бұл жақсы болды
Dialogue: 0,0:08:42.87,0:08:44.28,jp.sub-ja,,0,0,0,,Сіз трейдерсіз бе?
Dialogue: 0,0:08:42.90,0:08:44.90,Style1,,0,0,0,,Сіз дилерсіз бе?
Dialogue: 0,0:08:44.86,0:08:47.87,jp.sub-ja,,0,0,0,,Олар қарапайым студенттер. Олар форма киеді.
Dialogue: 0,0:08:44.90,0:08:48.57,Style1,,0,0,0,,Мен қарапайым студентпін. Мен форма кидім, көрдің бе?
Dialogue: 0,0:08:50.24,0:08:52.58,Style1,,0,0,0,,Харухи-кун, сен сондай күлкілісің.
Dialogue: 0,0:08:50.52,0:08:52.29,jp.sub-ja,,0,0,0,,Харухи-кун қызық болар еді
Dialogue: 0,0:08:53.58,0:08:55.25,Style1,,0,0,0,,Сонда да мен сені кінәлай алмаймын.
Dialogue: 0,0:08:53.68,0:08:55.17,jp.sub-ja,,0,0,0,,Бірақ бұл мүмкін емес.
Dialogue: 0,0:08:55.25,0:08:59.92,Style1,,0,0,0,,Ол бірінші дәрежелі корпорацияның мұрагеріне ұқсамайды.
Dialogue: 0,0:08:55.41,0:08:58.78,jp.sub-ja,,0,0,0,,Сіз беделді компанияның баласына ұқсамайсыз.
Dialogue: 0,0:08:59.92,0:09:01.72,Style1,,0,0,0,,Мұрагер?
Dialogue: 0,0:09:00.04,0:09:01.26,jp.sub-ja,,0,0,0,,Мұрагер?
Dialogue: 0,0:09:03.26,0:09:05.59,Style1,,0,0,0,,Оның отбасылық бизнесі, Suzushima Trading,
Dialogue: 0,0:09:03.27,0:09:08.43,jp.sub-ja,,0,0,0,,Оның үйі Suzujima Tsusho – флагмандық бизнесі ыдыс-аяқтарды импорттаумен айналысатын компания.
Dialogue: 0,0:09:05.59,0:09:08.26,Style1,,0,0,0,,– бизнесі ыдыс-аяқтарды импорттаумен айналысатын компания.
Dialogue: 0,0:09:08.26,0:09:11.60,Style1,,0,0,0,,Қазіргі уақытта ол елдегі ең жоғары нарық үлесіне ие.
Dialogue: 0,0:09:08.54,0:09:11.47,jp.sub-ja,,0,0,0,,Қазіргі уақытта оның үлесі Жапонияда бірінші орында.
Dialogue: 0,0:09:11.60,0:09:13.27,Style1,,0,0,0,,О, иә?
Dialogue: 0,0:09:13.27,0:09:17.94,Style1,,0,0,0,,Сондықтан, кез келген ерекше нәрсе түскенде, біз оны өз жолымызбен жіберуін сұрадық.
Dialogue: 0,0:09:13.32,0:09:16.89,jp.sub-ja,,0,0,0,,Сондықтан мен олардан арнайы затты алған кезде мені кіргізулерін өтіндім.
Dialogue: 0,0:09:17.94,0:09:22.61,Style1,,0,0,0,,Себебі, біз сіздің көзіңізге сенеміз, Сузусима-кун.
Dialogue: 0,0:09:17.96,0:09:21.42,jp.sub-ja,,0,0,0,,Сенің көзің сенімді, Судзима-кун.
Dialogue: 0,0:09:22.61,0:09:26.95,Style1,,0,0,0,,Әй, жоқ, менің көзім әлі алда.
Dialogue: 0,0:09:22.78,0:09:26.71,jp.sub-ja,,0,0,0,,Жоқ, менің көзім әлі алыс.
Dialogue: 0,0:09:26.95,0:09:30.62,Style1,,0,0,0,,Сіздің Англиядағы шетелде оқуыңыз келесі айда басталады, солай ма?
Dialogue: 0,0:09:27.01,0:09:29.60,jp.sub-ja,,0,0,0,,Ұлыбританияда шетелде оқу келесі айда басталады.
Dialogue: 0,0:09:30.62,0:09:33.95,Style1,,0,0,0,,Иә. Жарайды, мен кетемін.
Dialogue: 0,0:09:30.81,0:09:33.29,jp.sub-ja,,0,0,0,,Иә, онда мен...
Dialogue: 0,0:09:42.30,0:09:44.20,jp.sub-ja,,0,0,0,,Үйірме клубы көңілді ме?
Dialogue: 0,0:09:42.30,0:09:44.89,Style1,,0,0,0,,Сізге Хост клубы ұнай ма?
Dialogue: 0,0:09:45.90,0:09:48.23,Style1,,0,0,0,,Сіз дәл осы жерде болған адаммен жақынсыз ба?
Dialogue: 0,0:09:45.97,0:09:47.58,jp.sub-ja,,0,0,0,,Сіз қазіргі адамыңызбен жақынсыз ба?
Dialogue: 0,0:09:48.23,0:09:51.24,Style1,,0,0,0,,Иә!? Н-н-жоқ, жоқ, мен олай емеспін!
Dialogue: 0,0:09:48.66,0:09:53.43,jp.sub-ja,,0,0,0,,Be Be Be Біз онша жақын емеспіз. Сәлем, не сұрап тұрсың, Харухи-кун?
Dialogue: 0,0:09:51.24,0:09:53.24,Style1,,0,0,0,,М-менің сөзім, не айтып тұрсың, Харухи-кун?
Dialogue: 0,0:09:53.24,0:09:57.07,Style1,,0,0,0,,N-қазір кешіріңіз... Сау болыңыз.
Dialogue: 0,0:09:53.55,0:09:57.01,jp.sub-ja,,0,0,0,,Бүгін Кешіріңіз. Жақсы көңіл-күй.
Dialogue: 0,0:09:59.25,0:10:00.91,Style1,,0,0,0,,Хару-чан!
Dialogue: 0,0:09:59.34,0:10:05.24,jp.sub-ja,,0,0,0,,Харл-чан, көріп тұрсың ба, Судзима-кун Касуга-чанның күйеу жігіті.
Dialogue: 0,0:10:00.91,0:10:06.25,Style1,,0,0,0,,Сіз не білесіз? Сузусима-кун - Касуга-чанның күйеу жігіті.
Dialogue: 0,0:10:06.25,0:10:09.26,Style1,,0,0,0,,Киёя, сен қашаннан бері білесің?
Dialogue: 0,0:10:06.28,0:10:08.91,jp.sub-ja,,0,0,0,,Кёуя, мен сені қашан білдім?
Dialogue: 0,0:10:09.26,0:10:10.92,Style1,,0,0,0,,Оның күйеу жігіт болғаны туралы?
Dialogue: 0,0:10:09.38,0:10:10.87,jp.sub-ja,,0,0,0,,Бұл неке туралы ма?
Dialogue: 0,0:10:10.92,0:10:14.93,Style1,,0,0,0,,Мен, әрине, тұтынушыларымызға жалпы зерттеу жүргіземін.
Dialogue: 0,0:10:11.24,0:10:14.76,jp.sub-ja,,0,0,0,,Әрине, біз өз тұтынушыларымыз туралы бәрін зерттедік.
Dialogue: 0,0:10:14.93,0:10:16.60,Style1,,0,0,0,,Екеуі бала кезден дос.
Dialogue: 0,0:10:15.08,0:10:19.22,jp.sub-ja,,0,0,0,,Екеуі бала кезден дос, ал құда түсуді ата-анасы шешкен сияқты.
Dialogue: 0,0:10:16.60,0:10:19.27,Style1,,0,0,0,,Олардың келісімін ата-аналары ұйымдастырған сияқты.
Dialogue: 0,0:10:19.27,0:10:21.93,Style1,,0,0,0,,Бұл біз пайдалана алатын ақпарат емес сияқты,
Dialogue: 0,0:10:19.48,0:10:22.98,jp.sub-ja,,0,0,0,,Мен оны жалғыз қалдырдым, себебі бұл өте пайдалы ақпарат емес еді.
Dialogue: 0,0:10:21.93,0:10:23.27,Style1,,0,0,0,,сондықтан мен оны жай ғана қалдырдым.
Dialogue: 0,0:10:23.19,0:10:24.58,jp.sub-ja,,0,0,0,,Сіз...
Dialogue: 0,0:10:23.27,0:10:24.60,Style1,,0,0,0,,Неге, сен...
Dialogue: 0,0:10:24.60,0:10:28.61,Style1,,0,0,0,,Сузусима Тору: Өте жақсы бағалар, әділ әлеуметтік мәртебе,
Dialogue: 0,0:10:24.75,0:10:29.94,jp.sub-ja,,0,0,0,,Сузудзима Тору Өте жақсы бағалар, лайықты отбасылық орта, орташа көрініс
Dialogue: 0,0:10:28.61,0:10:31.28,Style1,,0,0,0,,кәдімгі көрініс, сенімділік күшті нүкте ретінде.
Dialogue: 0,0:10:30.13,0:10:32.57,jp.sub-ja,,0,0,0,,Байыптылық сауап болса, қиын болады.
Dialogue: 0,0:10:31.28,0:10:32.61,Style1,,0,0,0,,Егер мен оны бірдеңе үшін кінәлауым керек болса...
Dialogue: 0,0:10:32.61,0:10:33.61,Style1,,0,0,0,,Көп қатысу емес.
Dialogue: 0,0:10:32.70,0:10:33.79,jp.sub-ja,,0,0,0,,Жіңішке көлеңке
Dialogue: 0,0:10:33.61,0:10:34.61,Style1,,0,0,0,,Оның жүрегі әлсіз.
Dialogue: 0,0:10:33.89,0:10:34.66,jp.sub-ja,,0,0,0,,ақыл-ойы әлсіз
Dialogue: 0,0:10:34.61,0:10:37.28,Style1,,0,0,0,,Басқаша айтқанда, ол қарапайым. Міне бітті.
Dialogue: 0,0:10:34.81,0:10:36.43,jp.sub-ja,,0,0,0,,Басқаша айтқанда, бұл қарапайым.
Dialogue: 0,0:10:37.28,0:10:40.29,Style1,,0,0,0,,Олардың барлығы басқа ұлдарға аяусыз.
Dialogue: 0,0:10:37.52,0:10:40.04,jp.sub-ja,,0,0,0,,Сенің ер адамдарға мейірімің жоқ.
Dialogue: 0,0:10:40.29,0:10:43.22,Style1,,0,0,0,,Тору-кун жақсы бала. Дұрыс па?
Dialogue: 0,0:10:40.60,0:10:42.97,jp.sub-ja,,0,0,0,,Сен жақсы баласың, солай ма?
Dialogue: 0,0:10:43.22,0:10:44.56,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:10:44.48,0:10:47.62,jp.sub-ja,,0,0,0,,Енді қарсы шараларды қарастырайық.
Dialogue: 0,0:10:44.56,0:10:45.89,Style1,,0,0,0,,Жарайды, онда...
Dialogue: 0,0:10:45.89,0:10:47.89,Style1,,0,0,0,,Стратегиямызды қарастырайық.
Dialogue: 0,0:10:47.89,0:10:49.23,Style1,,0,0,0,,Қайсысы?
Dialogue: 0,0:10:47.97,0:10:48.97,jp.sub-ja,,0,0,0,,Не?
Dialogue: 0,0:10:49.23,0:10:51.23,Style1,,0,0,0,,Ouran Host Club
Dialogue: 0,0:10:49.31,0:10:54.95,jp.sub-ja,,0,0,0,,Біздің Ouran Host Club қыздарды бақытты ету үшін жұмыс істейді.
Dialogue: 0,0:10:51.23,0:10:53.57,Style1,,0,0,0,,бақыт әкелу үшін бар
Dialogue: 0,0:10:53.57,0:10:54.90,Style1,,0,0,0,,қыздарға!
Dialogue: 0,0:11:00.91,0:11:03.91,Style1,,0,0,0,,Бүгін кешке жиналған қозыларым,
Dialogue: 0,0:11:00.96,0:11:04.19,Style2,,0,0,0,,«Бір аптадан кейін»
Dialogue: 0,0:11:00.99,0:11:06.24,jp.sub-ja,,0,0,0,,Бүгін түнде барлық қозылар Ouran Host Club би кешіне жиналып жатыр.
Dialogue: 0,0:11:03.91,0:11:07.58,Style1,,0,0,0,,Ouran Host Club сізді жақсы қарсы алады...
Dialogue: 0,0:11:07.58,0:11:09.31,Style1,,0,0,0,,...осы би кешіне.
Dialogue: 0,0:11:07.85,0:11:09.34,jp.sub-ja,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:11:20.26,0:11:23.26,Style1,,0,0,0,,Біз сізді рахаттануға шақырамыз,
Dialogue: 0,0:11:20.32,0:11:23.48,jp.sub-ja,,0,0,0,,Бүгін мен уақытымды қабылдаушы топтың барлық мүшелерімен өткізгім келеді.
Dialogue: 0,0:11:23.26,0:11:26.93,Style1,,0,0,0,,Хост клубының мүшелерімен билегенде.
Dialogue: 0,0:11:23.58,0:11:26.64,jp.sub-ja,,0,0,0,,Сізге билеу ұнайды деп үміттенемін.
Dialogue: 0,0:11:26.93,0:11:29.60,Style1,,0,0,0,,Сонымен қатар, үздік биші деп танылған қонақ,
Dialogue: 0,0:11:27.00,0:11:32.00,jp.sub-ja,,0,0,0,,Сонымен қатар, ең үздік биші деп танылған және бүгінгі кештің ханшайымы болып таңдалған тапсырыс беруші
Dialogue: 0,0:11:29.60,0:11:31.94,Style1,,0,0,0,,және бүгінгі түннің ханшайымы болып таңдалды
Dialogue: 0,0:11:31.94,0:11:36.94,Style1,,0,0,0,,патшаның бетінен сүйіп алады.
Dialogue: 0,0:11:32.15,0:11:36.10,jp.sub-ja,,0,0,0,,Король бетінен құмарта сүйді.
Dialogue: 0,0:11:36.94,0:11:38.61,Style1,,0,0,0,,Сізге сәттілік,
Dialogue: 0,0:11:37.10,0:11:40.01,jp.sub-ja,,0,0,0,,Сәттілік балақай
Dialogue: 0,0:11:38.61,0:11:40.27,Style1,,0,0,0,,сәби.
Dialogue: 0,0:11:42.88,0:11:45.22,Style1,,0,0,0,,Харухи, сенің ынтаң төмен.
Dialogue: 0,0:11:42.91,0:11:45.41,jp.sub-ja,,0,0,0,,Харухи, сенің кернеуің төмен.
Dialogue: 0,0:11:45.22,0:11:47.72,Style1,,0,0,0,,Мен мұндай нәрсеге үйренбегенмін.
Dialogue: 0,0:11:45.66,0:11:49.42,jp.sub-ja,,0,0,0,,Мен мұндай би кешіне үйренбегенмін.
Dialogue: 0,0:11:47.72,0:11:49.56,Style1,,0,0,0,,Мен барған жалғыз би кеші
Dialogue: 0,0:11:49.56,0:11:52.89,Style1,,0,0,0,,- маңайдағы саябақта бон-одори фестивалі.
Dialogue: 0,0:11:49.59,0:11:52.43,jp.sub-ja,,0,0,0,,Мен жақын маңдағы саябаққа Bon биіне бардым.
Dialogue: 0,0:11:54.56,0:11:57.90,Style1,,0,0,0,,Сіз мұны би кеші деп атай алмайтын шығарсыз.
Dialogue: 0,0:11:54.57,0:11:57.69,jp.sub-ja,,0,0,0,,Бұл би кеші емес шығар.
Dialogue: 0,0:11:57.90,0:11:59.40,Style1,,0,0,0,,Сіз бәрібір осындасыз,
Dialogue: 0,0:11:57.92,0:12:02.75,jp.sub-ja,,0,0,0,,Жарайды, сен осында болғандықтан, тым болмаса тамақ жемейсің бе? Бұл мереке.
Dialogue: 0,0:11:59.40,0:12:01.57,Style1,,0,0,0,,неге ең болмағанда асханадан дәм татпайсың?
Dialogue: 0,0:12:01.57,0:12:03.57,Style1,,0,0,0,,Нағыз таралу бар.
Dialogue: 0,0:12:03.57,0:12:05.57,Style1,,0,0,0,,Спрэд?
Dialogue: 0,0:12:03.69,0:12:04.71,jp.sub-ja,,0,0,0,,Мереке
Dialogue: 0,0:12:05.57,0:12:08.57,Style1,,0,0,0,,Әдемі тунец қосылған L тәрізді?
Dialogue: 0,0:12:06.78,0:12:07.89,jp.sub-ja,,0,0,0,,Ооторо және т.б.
Dialogue: 0,0:12:08.57,0:12:09.08,Style1,,0,0,0,,Желдеткіш-
Dialogue: 0,0:12:08.75,0:12:10.58,jp.sub-ja,,0,0,0,,О-о-торо
Dialogue: 0,0:12:09.08,0:12:09.58,Style1,,0,0,0,,- cy
Dialogue: 0,0:12:09.58,0:12:10.56,Style1,,0,0,0,,тунец!?
Dialogue: 0,0:12:13.19,0:12:15.09,jp.sub-ja,,0,0,0,,Мүмкіндігінше тезірек үлкен тороны осы жерден алыңыз.
Dialogue: 0,0:12:13.25,0:12:14.91,Style1,,0,0,0,,- Мұнда әдемі тунец алыңыз, стат! - Бейшара... Әй, бейшара...
Dialogue: 0,0:12:13.38,0:12:16.73,jp.sub-ja,,0,0,0,,Бейшара жігіт...
Dialogue: 0,0:12:14.91,0:12:16.58,Style1,,0,0,0,,- люкс суши қосыңыз. - Бейшара... Әй, бейшара...
Dialogue: 0,0:12:15.13,0:12:16.48,jp.sub-ja,,0,0,0,,Арнайы суши қосылды
Dialogue: 0,0:12:16.58,0:12:19.88,Style1,,0,0,0,,Қарғыс атсын мына байларға...
Dialogue: 0,0:12:16.86,0:12:19.72,jp.sub-ja,,0,0,0,,Қарғыс атсын сендерге байлар.
Dialogue: 0,0:12:38.60,0:12:39.61,Style1,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 0,0:12:38.84,0:12:39.75,jp.sub-ja,,0,0,0,,(Узуи) Онда мен оның басын керемет шоумендей кесіп тастаймын.
Dialogue: 0,0:12:39.61,0:12:41.04,Style1,,0,0,0,,Харухи-кун...
Dialogue: 0,0:12:39.97,0:12:41.33,jp.sub-ja,,0,0,0,,Харухи-кун
Dialogue: 0,0:12:42.27,0:12:45.88,Style1,,0,0,0,,Мен сені іздедім. Сіз менімен билейсіз, солай емес пе?
Dialogue: 0,0:12:42.30,0:12:45.88,jp.sub-ja,,0,0,0,,Мен сені менімен билеу үшін іздедім.
Dialogue: 0,0:12:45.88,0:12:48.71,Style1,,0,0,0,,Иә, әрине.
Dialogue: 0,0:12:46.03,0:12:48.38,jp.sub-ja,,0,0,0,,Иә, әрине.
Dialogue: 0,0:12:50.47,0:12:52.20,jp.sub-ja,,0,0,0,,Касуга-чан келді
Dialogue: 0,0:12:50.55,0:12:52.22,Style1,,0,0,0,,Касуга-чан осында.
Dialogue: 0,0:12:52.22,0:12:53.22,Style1,,0,0,0,,Олай болса...
Dialogue: 0,0:12:52.42,0:12:55.32,jp.sub-ja,,0,0,0,,Сонымен, операция басталады.
Dialogue: 0,0:12:53.22,0:12:55.55,Style1,,0,0,0,,...бұл миссия орындалып жатқанын білдіреді.
Dialogue: 0,0:12:55.55,0:12:57.22,Style1,,0,0,0,,Роджер!
Dialogue: 0,0:12:55.68,0:12:56.60,jp.sub-ja,,0,0,0,,Түсінікті
Dialogue: 0,0:13:00.36,0:13:02.58,jp.sub-ja,,0,0,0,,Қандай адам ұрлау?
Dialogue: 0,0:13:00.56,0:13:03.22,Style1,,0,0,0,,Бұл не? Ұрлау ма?
Dialogue: 0,0:13:05.90,0:13:09.24,Style1,,0,0,0,,Олар осында!
Dialogue: 0,0:13:06.00,0:13:07.69,jp.sub-ja,,0,0,0,,Кел, кел, кел
Dialogue: 0,0:13:09.24,0:13:11.24,Style1,,0,0,0,,Сізге соншалықты биік болудың қажеті жоқ еді.
Dialogue: 0,0:13:09.33,0:13:11.34,jp.sub-ja,,0,0,0,,Еш нәрсе соншалықты күшті емес
Dialogue: 0,0:13:11.24,0:13:13.47,Style1,,0,0,0,,Қарсы болма, жай ғана өзгер.
Dialogue: 0,0:13:11.44,0:13:12.92,jp.sub-ja,,0,0,0,,Жарайды, мен тез киімімді ауыстырайын.
Dialogue: 0,0:13:20.25,0:13:23.58,Style1,,0,0,0,,Соңында «апаттың» орын алуы қызықтырақ болар еді.
Dialogue: 0,0:13:20.31,0:13:23.81,jp.sub-ja,,0,0,0,,Соңында оқыс оқиға болса, қызықтырақ болар еді.
Dialogue: 0,0:13:23.58,0:13:29.26,Style1,,0,0,0,,Есіңізде болсын, Харухи, сіздің уақытыңыз кештің шарықтау шегіне дейін 20 минут.
Dialogue: 0,0:13:23.98,0:13:24.92,jp.sub-ja,,0,0,0,,Тыңда, Харухи.
Dialogue: 0,0:13:25.15,0:13:28.51,jp.sub-ja,,0,0,0,,Шектеу - партияның шарықтау шегіне дейін 20 минут
Dialogue: 0,0:13:28.95,0:13:32.50,jp.sub-ja,,0,0,0,,Мен Судзима мырзаны көшенің арғы бетіндегі сыныпқа шақырдым.
Dialogue: 0,0:13:29.26,0:13:34.26,Style1,,0,0,0,,Біз Сузусиманы көрші сыныпқа шақырдық.
Dialogue: 0,0:13:34.26,0:13:36.93,Style1,,0,0,0,,Оның сезімін сыпайы түрде сұраңыз.
Dialogue: 0,0:13:34.40,0:13:36.36,jp.sub-ja,,0,0,0,,Менің сезімімді мұқият тыңда.
Dialogue: 0,0:13:36.93,0:13:38.60,Style1,,0,0,0,,Бұл оның жоғары мәртебелі стратегиясы болғандықтан,
Dialogue: 0,0:13:37.07,0:13:40.42,jp.sub-ja,,0,0,0,,Жарайды, бұл сіздің жоспарыңыз, сондықтан мен біраз уайымдап тұрмын.
Dialogue: 0,0:13:38.60,0:13:40.93,Style1,,0,0,0,,бұл туралы алаңдататын нәрсе бар.
Dialogue: 0,0:13:40.93,0:13:43.54,Style1,,0,0,0,,Сәлем! Барлығының осында болуының басты идеясы қандай?
Dialogue: 0,0:13:41.04,0:13:45.06,jp.sub-ja,,0,0,0,,Әй, енді бәрі осында болған соң не істейміз? Тұтынушы...
Dialogue: 0,0:13:43.54,0:13:46.20,Style1,,0,0,0,,Қонақтарымызға кім қарайды?
Dialogue: 0,0:13:59.55,0:14:00.55,Style1,,0,0,0,,Сіз қалай ойлайсыз, сэр?
Dialogue: 0,0:13:59.58,0:14:00.75,jp.sub-ja,,0,0,0,,Қалайсың, сэр?
Dialogue: 0,0:14:00.55,0:14:02.89,Style1,,0,0,0,,Хару-чан, сен сүйкімдісің!
Dialogue: 0,0:14:00.92,0:14:02.72,jp.sub-ja,,0,0,0,,Хару-чан сүйкімді
Dialogue: 0,0:14:02.89,0:14:05.89,Style1,,0,0,0,,Менің бетім ауыр, бұл аяқ киіммен жүру қиын.
Dialogue: 0,0:14:02.93,0:14:05.81,jp.sub-ja,,0,0,0,,Ауыр аяқ киім жүруді қиындатады
Dialogue: 0,0:14:05.89,0:14:08.49,Style1,,0,0,0,,Онда сәттілік!
Dialogue: 0,0:14:05.96,0:14:07.61,jp.sub-ja,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:14:08.40,0:14:10.57,jp.sub-ja,,0,0,0,,Какака тым сүйкімді
Dialogue: 0,0:14:08.49,0:14:10.55,Style1,,0,0,0,,С-с-ол өте сүйкімді...
Dialogue: 0,0:14:16.53,0:14:20.20,jp.sub-ja,,0,0,0,,Бұл хат сіз елестеткеннен мүлде басқаша.
Dialogue: 0,0:14:16.57,0:14:18.24,Style1,,0,0,0,,Бұл хатты сіз жаздыңыз ба?
Dialogue: 0,0:14:18.24,0:14:20.57,Style1,,0,0,0,,Сіз мен елестеткеннен мүлдем басқасыз.
Dialogue: 0,0:14:21.55,0:14:22.28,jp.sub-ja,,0,0,0,,Хат?
Dialogue: 0,0:14:21.57,0:14:22.58,Style1,,0,0,0,,Хат?
Dialogue: 0,0:14:22.58,0:14:24.08,Style1,,0,0,0,,Мен ғашықпын-ғашықпын!
Dialogue: 0,0:14:22.79,0:14:24.18,jp.sub-ja,,0,0,0,,Махаббатты сүй
Dialogue: 0,0:14:23.27,0:14:26.39,Style2,,0,0,0,,«Махаббат-махаббат»
Dialogue: 0,0:14:24.08,0:14:25.91,Style1,,0,0,0,,Мен сені алғаш көрген кезден бастап,
Dialogue: 0,0:14:24.37,0:14:29.17,jp.sub-ja,,0,0,0,,Саған көзім түскеннен бері жүрегім саған ғашық болды.
Dialogue: 0,0:14:25.91,0:14:29.25,Style1,,0,0,0,,менің жүрегім супер махаббат-махаббатқа түсті! Ти-хи!
Dialogue: 0,0:14:29.25,0:14:33.25,Style1,,0,0,0,,Мен тайфунға ұқсамайтын, бітпейтін тропикалық циклонда жүрген сияқтымын,
Dialogue: 0,0:14:29.34,0:14:33.42,jp.sub-ja,,0,0,0,,Тропикалық циклонға ешқашан ауыспайтын тайфун сияқты.
Dialogue: 0,0:14:33.25,0:14:37.59,Style1,,0,0,0,,Жүрегімдегі махаббат қайнап жатыр,
Dialogue: 0,0:14:33.53,0:14:37.42,jp.sub-ja,,0,0,0,,Жүрегімде махаббат желбіреді
Dialogue: 0,0:14:37.59,0:14:43.20,Style1,,0,0,0,,және мен сендермен Нұхтың кемесіне кездесу өткізгім келеді! Мен істеймін, істеймін!»
Dialogue: 0,0:14:37.63,0:14:42.60,jp.sub-ja,,0,0,0,,Мен сендермен Нұхтың кемесінде кездескім келеді.
Dialogue: 0,0:14:43.20,0:14:45.86,Style1,,0,0,0,,Бұл хатты кім жазды?
Dialogue: 0,0:14:43.33,0:14:45.87,jp.sub-ja,,0,0,0,,Бұл хатты кім жазды?
Dialogue: 0,0:14:47.42,0:14:48.39,Style2,,0,0,0,,«Бірлескен жұмыс»
Dialogue: 0,0:14:48.20,0:14:50.20,Style1,,0,0,0,,Иә? Біз бір жерде кездестік пе?
Dialogue: 0,0:14:48.46,0:14:50.55,jp.sub-ja,,0,0,0,,Қайдасың?
Dialogue: 0,0:14:50.54,0:14:53.66,Style1,,0,0,0,,Жоқ! Біз бұрын ешқашан сөйлескен емеспіз!
Dialogue: 0,0:14:50.66,0:14:53.47,jp.sub-ja,,0,0,0,,Жоқ, мен сенімен бірінші рет сөйлесіп тұрмын.
Dialogue: 0,0:14:50.89,0:14:51.79,Style2,,0,0,0,,"Иә!"
Dialogue: 0,0:14:55.54,0:14:56.87,Style1,,0,0,0,,Мұнда.
Dialogue: 0,0:14:55.57,0:14:56.72,jp.sub-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:58.88,0:15:03.22,Style1,,0,0,0,,Мен сіздің айтқаныңызды бағалаймын, бірақ мен сіздің хатыңызға жауап бере алмаймын.
Dialogue: 0,0:14:59.05,0:15:02.68,jp.sub-ja,,0,0,0,,Кешіріңіз, бірақ мен бұл хатқа жауап бере алмаймын.
Dialogue: 0,0:15:03.22,0:15:07.55,Style1,,0,0,0,,Менің жаныма жақын тағы бір қызым бар.
Dialogue: 0,0:15:03.45,0:15:06.16,jp.sub-ja,,0,0,0,,Өйткені менің өзіме қатты көңіл бөлетін балам бар.
Dialogue: 0,0:15:07.55,0:15:10.22,Style1,,0,0,0,,Сузусима-сан, ол сенің...
Dialogue: 0,0:15:07.67,0:15:09.75,jp.sub-ja,,0,0,0,,Бұл адам Сузудзимадан...
Dialogue: 0,0:15:10.22,0:15:12.56,Style1,,0,0,0,,Өкінішке орай, ол менің құрбым емес.
Dialogue: 0,0:15:10.26,0:15:12.42,jp.sub-ja,,0,0,0,,Өкінішке орай, біз ғашық емеспіз.
Dialogue: 0,0:15:12.56,0:15:15.56,Style1,,0,0,0,,Немесе ол менімен бітті деп айтуым керек.
Dialogue: 0,0:15:12.63,0:15:14.98,jp.sub-ja,,0,0,0,,Дәлірек айтсақ, мен еркелікке үйреніп қалғанмын.
Dialogue: 0,0:15:15.53,0:15:19.50,jp.sub-ja,,0,0,0,,Оған әдемі және сенімді жігіт жарасады.
Dialogue: 0,0:15:15.56,0:15:20.73,Style1,,0,0,0,,Ол өзіне сенімдірек ер адам болса жақсырақ болар еді.
Dialogue: 0,0:15:22.22,0:15:25.06,jp.sub-ja,,0,0,0,,Мені қайда апара жатырсың?
Dialogue: 0,0:15:22.23,0:15:26.57,Style1,,0,0,0,,Сіз мені дәл қайда апарып жатырсыз?
Dialogue: 0,0:15:26.57,0:15:28.91,Style1,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:15:26.77,0:15:32.59,jp.sub-ja,,0,0,0,,Менің ойымша, сіз тактикаға бейім емес шығарсыз.
Dialogue: 0,0:15:28.91,0:15:33.25,Style1,,0,0,0,,Сіз басқаларды манипуляциялауға бейім адам емес шығарсыз.
Dialogue: 0,0:15:33.25,0:15:35.58,Style1,,0,0,0,,Мен нені меңзеп тұрғаныңызды білмеймін.
Dialogue: 0,0:15:33.26,0:15:34.75,jp.sub-ja,,0,0,0,,Не айтпақшысың өзің?
Dialogue: 0,0:15:35.58,0:15:39.75,Style1,,0,0,0,,Қанша хостқа барсаңыз да,
Dialogue: 0,0:15:35.80,0:15:40.62,jp.sub-ja,,0,0,0,,Қанша рет оның назарын аударуға тырыссам да, басқа хосттарға баруға тырысамын.
Dialogue: 0,0:15:39.75,0:15:40.92,Style1,,0,0,0,,оның назарын аудару үшін,
Dialogue: 0,0:15:40.92,0:15:45.36,Style1,,0,0,0,,сіз шай шыныаяқтарына қарасаңыз, әрқашан бақытты болып көрінесіз.
Dialogue: 0,0:15:41.16,0:15:44.89,jp.sub-ja,,0,0,0,,Сіз шыныаяққа қарап әлдеқайда бақытты көрінесіз.
Dialogue: 0,0:15:51.19,0:15:53.16,jp.sub-ja,,0,0,0,,Қарашы, қарашы, Канаде
Dialogue: 0,0:15:51.20,0:15:53.53,Style1,,0,0,0,,Мыналарды қарашы, Канако.
Dialogue: 0,0:15:53.53,0:15:54.87,Style1,,0,0,0,,Қандай әдемі!
Dialogue: 0,0:15:53.59,0:15:54.76,jp.sub-ja,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:15:54.87,0:15:58.87,Style1,,0,0,0,,Веджвуд... Фоли... Вустер...
Dialogue: 0,0:15:55.10,0:15:58.73,jp.sub-ja,,0,0,0,,Уэдгвуд Фолли Вустер
Dialogue: 0,0:15:58.87,0:16:01.54,Style1,,0,0,0,,Мұнда Джинори мен Мейсен бар.
Dialogue: 0,0:15:58.90,0:16:01.32,jp.sub-ja,,0,0,0,,Бұл жергілікті теңіз балдыры Мейсен
Dialogue: 0,0:16:01.54,0:16:04.54,Style1,,0,0,0,,Канако, сен менің әйелім боласың,
Dialogue: 0,0:16:01.59,0:16:07.32,jp.sub-ja,,0,0,0,,Канаде менің әйелім, мен саған бәрін айтамын.
Dialogue: 0,0:16:04.54,0:16:07.21,Style1,,0,0,0,,сондықтан мен олардың барлығы туралы айтып беремін, жарай ма?
Dialogue: 0,0:16:08.55,0:16:09.54,Style1,,0,0,0,,мм-мм!
Dialogue: 0,0:16:10.55,0:16:12.38,Style1,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:16:10.58,0:16:11.93,jp.sub-ja,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:16:12.38,0:16:16.89,Style1,,0,0,0,,Мен не істесем де ол мені байқамайды.
Dialogue: 0,0:16:12.44,0:16:16.09,jp.sub-ja,,0,0,0,,Мен не істесем де, оған мүлдем мән бермейді.
Dialogue: 0,0:16:16.84,0:16:20.79,jp.sub-ja,,0,0,0,,Ол маған хабарсыз шетелде оқуға бел буды.
Dialogue: 0,0:16:16.89,0:16:21.05,Style1,,0,0,0,,Тіпті мені білмей шетелде оқуды шешті.
Dialogue: 0,0:16:22.56,0:16:26.90,Style1,,0,0,0,,Сондықтан мен де өзгергім келеді. Дүниеге қарап,
Dialogue: 0,0:16:22.63,0:16:25.38,jp.sub-ja,,0,0,0,,Сондықтан мен де өзгергім келеді.
Dialogue: 0,0:16:25.60,0:16:28.99,jp.sub-ja,,0,0,0,,Дүниені көр, Мен үлкен адам болғым келеді
Dialogue: 0,0:16:26.90,0:16:29.23,Style1,,0,0,0,,Мен одан да үлкен адам болғым келеді.
Dialogue: 0,0:16:29.23,0:16:33.23,Style1,,0,0,0,,Мен өзімшіл екенін білемін, бірақ мені күтетін болсаң ше?
Dialogue: 0,0:16:29.29,0:16:32.60,jp.sub-ja,,0,0,0,,Бұл өзімшілдік, бірақ сен мені күте алсаңшы...
Dialogue: 0,0:16:34.91,0:16:38.24,Style1,,0,0,0,,Бұл шынымен өзімшіл, иә?
Dialogue: 0,0:16:35.10,0:16:37.00,jp.sub-ja,,0,0,0,,Бұл шынымен ерікті.
Dialogue: 0,0:16:38.24,0:16:42.85,Style1,,0,0,0,,Сен оған айтпасаң, ол сені түсінеді деп ойлаудың өзі ақымақтық.
Dialogue: 0,0:16:38.52,0:16:42.23,jp.sub-ja,,0,0,0,,Оларға айтпай-ақ түсінуге тырысу ақымақтық болар еді.
Dialogue: 0,0:16:42.85,0:16:47.52,Style1,,0,0,0,,Сенің оған деген сезімің анық, оны кейінге қалдырудың керегі қайда?
Dialogue: 0,0:16:42.98,0:16:47.16,jp.sub-ja,,0,0,0,,Егер сізде нақты идея болса, оны неге кейінге қалдыру керек?
Dialogue: 0,0:16:47.52,0:16:49.86,Style1,,0,0,0,,Менің ойымша, адамдар өзгере бастайды
Dialogue: 0,0:16:47.68,0:16:52.29,jp.sub-ja,,0,0,0,,Мен адамдар өзгергісі келгенде өзгере алатынына сенемін.
Dialogue: 0,0:16:49.86,0:16:53.19,Style1,,0,0,0,,олар қалайтыны туралы шешім қабылдаған сәттен бастап.
Dialogue: 0,0:17:00.53,0:17:01.53,Style1,,0,0,0,,Канако...
Dialogue: 0,0:17:00.60,0:17:01.41,jp.sub-ja,,0,0,0,,Канаде
Dialogue: 0,0:17:01.53,0:17:05.54,Style1,,0,0,0,,Ой, кешіріңіз. Мен бір нәрсені бұзып тұрған сияқтымын.
Dialogue: 0,0:17:01.60,0:17:06.94,jp.sub-ja,,0,0,0,,Ой, кешіріңіз. Мен сізге әйтеуір кедергі жасаған сияқтымын. мен...
Dialogue: 0,0:17:05.54,0:17:06.87,Style1,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:17:11.88,0:17:13.55,Style1,,0,0,0,,Канако!
Dialogue: 0,0:17:11.98,0:17:15.76,jp.sub-ja,,0,0,0,,Канаде Канаде
Dialogue: 0,0:17:13.55,0:17:15.10,Style1,,0,0,0,,Канако!!
Dialogue: 0,0:17:18.22,0:17:20.89,Style1,,0,0,0,,Біз жай ғана қиындатқан жоқпыз ба?
Dialogue: 0,0:17:18.34,0:17:20.18,jp.sub-ja,,0,0,0,,Керісінше мен жалықпаймын.
Dialogue: 0,0:17:20.86,0:17:22.91,jp.sub-ja,,0,0,0,,Ол менің артымнан жүгірді
Dialogue: 0,0:17:20.89,0:17:24.29,Style1,,0,0,0,,Ол оның артынан жүгірді.
Dialogue: 0,0:17:26.56,0:17:28.56,Style1,,0,0,0,,Ouran Host Club...
Dialogue: 0,0:17:26.60,0:17:32.48,jp.sub-ja,,0,0,0,,Қыздардың бақыты үшін Ouran Host Club бар ма?
Dialogue: 0,0:17:28.56,0:17:33.02,Style1,,0,0,0,,... қыздарға бақыт әкелу үшін бар, иә?
Dialogue: 0,0:17:48.85,0:17:51.85,Style1,,0,0,0,,Ал енді, ханымдар мен мырзалар,
Dialogue: 0,0:17:48.88,0:17:50.03,jp.sub-ja,,0,0,0,,Олай болса, бәріңе.
Dialogue: 0,0:17:51.85,0:17:57.19,Style1,,0,0,0,,Осы бір көңілді кешіміз ақыры өзінің соңғы әніне жетті.
Dialogue: 0,0:17:51.99,0:17:57.03,jp.sub-ja,,0,0,0,,Бұл көңілді кештің соңғы әні болды.
Dialogue: 0,0:17:57.19,0:18:02.53,Style1,,0,0,0,,Хост клубының соңғы вальсі осы жұпқа түседі.
Dialogue: 0,0:17:57.46,0:18:02.10,jp.sub-ja,,0,0,0,,Біздің клубтың соңғы вальсі осы екеуіне...
Dialogue: 0,0:18:11.20,0:18:12.97,Style1,,0,0,0,,Ханшайым Касуга,
Dialogue: 0,0:18:11.32,0:18:16.92,jp.sub-ja,,0,0,0,,Касуга Химе, менімен билей аласыз ба?
Dialogue: 0,0:18:15.21,0:18:17.70,Style1,,0,0,0,,мына биді алуға бола ма?
Dialogue: 0,0:18:30.56,0:18:31.89,Style1,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:18:51.91,0:18:54.91,Style1,,0,0,0,,Мен сені жақсы көремін.
Dialogue: 0,0:18:52.11,0:18:56.70,jp.sub-ja,,0,0,0,,Мен сені сүйемін, мен сені әрқашан сүйдім
Dialogue: 0,0:18:54.91,0:18:56.92,Style1,,0,0,0,,Мен сені әрқашан жақсы көрдім.
Dialogue: 0,0:18:56.92,0:18:59.91,Style1,,0,0,0,,Мен сізге тағы да ұсыныс жасаймын.
Dialogue: 0,0:18:57.10,0:18:58.79,jp.sub-ja,,0,0,0,,Қайтадан ұсыныңыз
Dialogue: 0,0:19:13.60,0:19:18.27,Style1,,0,0,0,,Бүгін түнде менің әртүрлі хосттарды аралау аяқталды.
Dialogue: 0,0:19:13.61,0:19:17.37,jp.sub-ja,,0,0,0,,Бүгін түнде жер аударылғандарды іздеу аяқталады.
Dialogue: 0,0:19:18.27,0:19:20.94,Style1,,0,0,0,,Бұл ыңғайсыз жұп берекелі болсын!
Dialogue: 0,0:19:18.37,0:19:20.59,jp.sub-ja,,0,0,0,,Елеусіз жұпқа бата
Dialogue: 0,0:19:20.94,0:19:23.61,Style1,,0,0,0,,Бүгінгі кештің би ханшайымы...
Dialogue: 0,0:19:21.30,0:19:23.37,jp.sub-ja,,0,0,0,,Бүгінгі би ханшайымы...
Dialogue: 0,0:19:23.60,0:19:26.70,jp.sub-ja,,0,0,0,,Бұл ханшайым Канаде Касугазаки болады деп шешілді.
Dialogue: 0,0:19:23.61,0:19:27.27,Style1,,0,0,0,,...осы арқылы Касугазаки Канако ханшайымы деп жарияланды.
Dialogue: 0,0:19:33.43,0:19:36.20,jp.sub-ja,,0,0,0,,Енді патшадан бата сүйісі...
Dialogue: 0,0:19:33.62,0:19:35.95,Style1,,0,0,0,,Ендеше, патшаның мүбәрәк сүйісі...
Dialogue: 0,0:19:35.95,0:19:36.96,Style1,,0,0,0,,Мен қостым.
Dialogue: 0,0:19:36.33,0:19:36.78,jp.sub-ja,,0,0,0,,Сіздің кезегіңіз бе?
Dialogue: 0,0:19:36.96,0:19:39.96,Style1,,0,0,0,,...Фудзиока Харухиге ауыстырылды!
Dialogue: 0,0:19:37.01,0:19:39.36,jp.sub-ja,,0,0,0,,тармағын Харухи Фудзиокадан өзгерту...
Dialogue: 0,0:19:39.96,0:19:40.63,Style1,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:19:40.63,0:19:42.56,Style1,,0,0,0,,Өйткені, Кёя-сенпай «апатқа ұшырағанын» айтты.
Dialogue: 0,0:19:40.69,0:19:42.84,jp.sub-ja,,0,0,0,,Себебі соңында апат болды...
Dialogue: 0,0:19:42.56,0:19:46.57,Style1,,0,0,0,,дәл соңында орын алуы қызықтырақ болар еді.
Dialogue: 0,0:19:42.99,0:19:45.41,jp.sub-ja,,0,0,0,,Кёуя-сенпай бар болса, қызықтырақ болар еді деді
Dialogue: 0,0:19:46.57,0:19:49.57,Style1,,0,0,0,,Бұл жай ғана бетте, солай ма? Алға және оны қабылдаңыз,
Dialogue: 0,0:19:46.65,0:19:49.66,jp.sub-ja,,0,0,0,,Бұл бәрібір щек, сондықтан оны алыңыз.
Dialogue: 0,0:19:49.57,0:19:52.91,Style1,,0,0,0,,хост-хопингті бітіргеніңізді еске алу үшін.
Dialogue: 0,0:19:49.91,0:19:52.62,jp.sub-ja,,0,0,0,,Бұл менің қуғынға жіберілген гастрольдік сапарымды аяқтағанымды еске алу күні.
Dialogue: 0,0:19:52.80,0:19:54.99,jp.sub-ja,,0,0,0,,Қанша екені маңызды емес...
Dialogue: 0,0:19:52.91,0:19:54.91,Style1,,0,0,0,,Мені бастан өткеретін барлық нәрселер туралы ...
Dialogue: 0,0:19:54.91,0:19:57.58,Style1,,0,0,0,,Біз сіздің қарызыңызды үштен біріне қысқартамыз.
Dialogue: 0,0:19:55.17,0:19:56.68,jp.sub-ja,,0,0,0,,Қарыздың үштен біріне қысқарту
Dialogue: 0,0:19:57.58,0:19:59.91,Style1,,0,0,0,,Ендеше, бұл тек бір шеке болғанша...
Dialogue: 0,0:19:57.77,0:19:59.48,jp.sub-ja,,0,0,0,,Жақсы, егер бұл тек щек болса.
Dialogue: 0,0:20:04.25,0:20:07.92,Style1,,0,0,0,,Айтыңызшы, бұл Хару-чанның алғашқы сүйісі болуы мүмкін бе?
Dialogue: 0,0:20:04.39,0:20:08.06,jp.sub-ja,,0,0,0,,Нене, мүмкін бұл Хару-чанның алғашқы сүйісі шығар...
Dialogue: 0,0:20:07.92,0:20:08.91,Style1,,0,0,0,,Не!?
Dialogue: 0,0:20:11.86,0:20:14.15,jp.sub-ja,,0,0,0,,Сол сүйісті күтіңіз
Dialogue: 0,0:20:12.61,0:20:14.45,Style1,,0,0,0,,Осы сүйісті ұстаңыз!
Dialogue: 0,0:20:25.04,0:20:29.87,jp.sub-ja,,0,0,0,,Мен байқаусызда бір қызға алғашқы сүйісімді бердім.
Dialogue: 0,0:20:25.63,0:20:30.97,Style1,,0,0,0,,Оқиғалардың барысы менің алғашқы сүйісім қызға тиетіндей болды,
Dialogue: 0,0:20:30.36,0:20:32.81,jp.sub-ja,,0,0,0,,Бұл жақсы түн.
Dialogue: 0,0:20:30.97,0:20:33.63,Style1,,0,0,0,,бірақ өте жағымды кеш болды...
Dialogue: 0,0:20:33.92,0:20:35.99,jp.sub-ja,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:20:34.64,0:20:37.33,Style1,,0,0,0,,... сондықтан бұл мен үшін жеткілікті деп ойлаймын.
Dialogue: 0,0:20:40.56,0:20:44.10,jp.sub-ja,,0,0,0,,Егер сіздің қыз екеніңіз шықса, сіз хост клубына кіре алмайсыз.
Dialogue: 0,0:20:42.18,0:20:43.78,Style1,,0,0,0,,Егер менің қызбын деген сөз шықса,
Dialogue: 0,0:20:43.01,0:20:45.18,Style2,,0,0,0,,«Физикалық емтихандар»
Dialogue: 0,0:20:43.78,0:20:45.85,Style1,,0,0,0,,Мен Хост клубында өте жақсы қала алмадым.
Dialogue: 0,0:20:44.23,0:20:47.69,jp.sub-ja,,0,0,0,,Уайымдама, Харухи, мен сенің сырыңды қорғаймын.
Dialogue: 0,0:20:45.18,0:20:47.15,Style2,,0,0,0,,«Жалаңаш»
Dialogue: 0,0:20:45.85,0:20:47.18,Style1,,0,0,0,,Уайымдама, Харухи.
Dialogue: 0,0:20:47.18,0:20:49.52,Style1,,0,0,0,,Не болса да мен сенің сырыңды қорғаймын!
Dialogue: 0,0:20:49.52,0:20:51.85,Style1,,0,0,0,,Келесі жолы «Физикалық емтиханнан сақ болыңыз»
Dialogue: 0,0:20:50.13,0:20:52.60,jp.sub-ja,,0,0,0,,Келесі аптада Оуран орта мектебінің хост клубы
Dialogue: 0,0:20:51.85,0:20:54.35,Style1,,0,0,0,,Сізді келесі аптада Оуран орта мектебінің хост клубы күтеді!
Dialogue: 0,0:20:52.73,0:20:54.35,jp.sub-ja,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:20:55.85,0:21:01.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
