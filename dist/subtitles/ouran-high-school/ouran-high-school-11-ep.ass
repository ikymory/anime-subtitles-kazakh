Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.63,logo-ja,,0,0,0,,Бөлім
Dialogue: 0,0:00:00.00,0:00:02.80,staff-ja,,0,0,0,,Mam
Dialogue: 0,0:00:00.00,0:00:02.84,logo-ja,,0,0,0,,...
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Жапония Маки
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Syura
Dialogue: 0,0:00:00.00,0:00:03.17,staff-ja,,0,0,0,,Аударма күміс алма
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Уақыт көлігі жын куна
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Наксияның әкімшілік жүйесі
Dialogue: 0,0:00:00.00,0:00:03.26,logo-ja,,0,0,0,,Кофуку, біраз уақытқа мұнда менің орныма келші?
Dialogue: 0,0:00:00.00,0:00:03.47,logo-ja,,0,0,0,,өзі құдаймын деп айтқан адаммен кездескеннен бері.
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,OP&ED Hagakure
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,Сюра
Dialogue: 0,0:00:00.00,0:00:03.68,logo-ja,,0,0,0,,Мектеп
Dialogue: 0,0:00:00.00,0:00:03.88,Default11-ja,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:00:00.00,0:00:03.89,logo-ja,,0,0,0,,Жоғары
Dialogue: 0,0:00:00.00,0:00:04.09,logo-ja,,0,0,0,,өзі құдаймын деп айтқан адаммен кездескеннен бері.
Dialogue: 0,0:00:00.00,0:00:04.30,logo-ja,,0,0,0,,...
Dialogue: 0,0:00:16.40,0:00:19.41,Style1,,0,0,0,,Бір құбыжық шығып кетуі мүмкін.
Dialogue: 0,0:00:16.57,0:00:19.01,jp.sub-ja,NTP,0,0,0,,Құбыжық пайда болуы мүмкін.
Dialogue: 0,0:00:19.41,0:00:23.34,Style1,,0,0,0,,Сондықтан мен Үлкен ағаны тез табуға тырысуым керек.
Dialogue: 0,0:00:19.52,0:00:22.76,jp.sub-ja,NTP,0,0,0,,Сондықтан мен ағамды тез табуым керек.
Dialogue: 0,0:00:24.75,0:00:27.08,Style1,,0,0,0,,Үлкен аға - әдемі ханзада,
Dialogue: 0,0:00:24.81,0:00:26.97,jp.sub-ja,NTP,0,0,0,,Менің ағам керемет ханзада
Dialogue: 0,0:00:27.08,0:00:31.31,Style1,,0,0,0,,сондықтан ол мен үшін құбыжықты жеңетініне сенімді болады.
Dialogue: 0,0:00:27.48,0:00:30.72,jp.sub-ja,NTP,0,0,0,,Сондықтан мен оның құбыжықты жоятынына сенімдімін.
Dialogue: 0,0:00:49.40,0:00:51.34,Style2,,0,0,0,,«№3 музыкалық бөлме»
Dialogue: 0,0:01:06.39,0:01:08.36,Style1,,0,0,0,,- Қош келдіңіз! - Қош келдіңіз!
Dialogue: 0,0:01:06.45,0:01:08.07,jp.sub-ja,NTP,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:10.06,0:01:13.40,Style1,,0,0,0,,Менің мұнда қандай ерекше қонақ келді, иә?
Dialogue: 0,0:01:10.08,0:01:12.80,jp.sub-ja,NTP,0,0,0,,Эй, бұл ерекше тұтынушы.
Dialogue: 0,0:01:13.40,0:01:17.09,Style1,,0,0,0,,Қош келдіңіз, менің кішкентай жоғалған мысық мысық.
Dialogue: 0,0:01:13.67,0:01:16.60,jp.sub-ja,NTP,0,0,0,,Қош келдің, жоғалған котенка
Dialogue: 0,0:01:19.07,0:01:23.66,Style1,,0,0,0,,Есікті ашсам, полицейлер екен.
Dialogue: 0,0:01:19.22,0:01:20.47,jp.sub-ja,NTP,0,0,0,,Есікті ашқанда
Dialogue: 0,0:01:21.20,0:01:22.96,jp.sub-ja,NTP,0,0,0,,Ол жерде полиция болды.
Dialogue: 0,0:01:26.58,0:01:29.17,Style1,,0,0,0,,"Үлкен аға - ханзада!"
Dialogue: 0,0:01:31.75,0:01:35.55,Style1,,0,0,0,,Китти-мысық, сен қайдан келдің?
Dialogue: 0,0:01:32.08,0:01:34.84,jp.sub-ja,NTP,0,0,0,,Котенка, ол қайдан пайда болды?
Dialogue: 0,0:01:38.75,0:01:41.09,Style1,,0,0,0,,Кері гарем!
Dialogue: 0,0:01:38.95,0:01:40.24,jp.sub-ja,NTP,0,0,0,,Кері гарем
Dialogue: 0,0:01:41.09,0:01:42.99,Style1,,0,0,0,,Бұл кері гарем!
Dialogue: 0,0:01:41.13,0:01:42.58,jp.sub-ja,NTP,0,0,0,,Бұл кері гарем.
Dialogue: 0,0:01:45.36,0:01:48.36,Style1,,0,0,0,,Бұл дұрыс емес. Әлі де су бар сияқты
Dialogue: 0,0:01:45.54,0:01:50.67,jp.sub-ja,NTP,0,0,0,,Бассейнде жүзген су әлі құлағымда тұрған сияқты.
Dialogue: 0,0:01:48.36,0:01:51.20,Style1,,0,0,0,,бассейнде жүзген кездегі құлағымда қалды.
Dialogue: 0,0:01:52.35,0:01:54.69,jp.sub-ja,NTP,0,0,0,,Бас инспектор, дұрыс.
Dialogue: 0,0:01:52.37,0:01:55.04,Style1,,0,0,0,,Солай болуы керек, комиссар.
Dialogue: 0,0:01:55.04,0:01:58.37,Style1,,0,0,0,,Бұл кішкентай қыздың "кері гарем" дегені сияқты естілуінің себебі
Dialogue: 0,0:01:55.24,0:01:58.88,jp.sub-ja,NTP,0,0,0,,Мен сондай кішкентай баланың «кері гарем» деп айтқанын сезіндім.
Dialogue: 0,0:01:58.37,0:02:02.71,Style1,,0,0,0,,болуы керек, өйткені біздің құлағымызда күлкілі нәрсе болып жатыр.
Dialogue: 0,0:01:58.88,0:02:01.52,jp.sub-ja,NTP,0,0,0,,Біздің құлағымызда бірдеңе болды, солай ма?
Dialogue: 0,0:02:02.71,0:02:04.25,Style1,,0,0,0,,Азғындық.
Dialogue: 0,0:02:03.11,0:02:04.10,jp.sub-ja,NTP,0,0,0,,Саке тоғанының ет орманы
Dialogue: 0,0:02:04.25,0:02:06.18,Style2,,0,0,0,,«Азғындық»
Dialogue: 0,0:02:06.72,0:02:10.01,Style1,,0,0,0,,Иә! Бұл жерде азғындық бар!
Dialogue: 0,0:02:06.83,0:02:10.04,jp.sub-ja,NTP,0,0,0,,Ой, бұл Саке тоғанының ет орманы.
Dialogue: 0,0:02:11.02,0:02:12.61,Style2,,0,0,0,,«Көзілдірік кейіпкері»
Dialogue: 0,0:02:11.54,0:02:12.70,jp.sub-ja,NTP,0,0,0,,Көзілдіріктің сипаты
Dialogue: 0,0:02:13.49,0:02:14.66,Style2,,0,0,0,,«Бала Лолита»
Dialogue: 0,0:02:13.56,0:02:14.71,jp.sub-ja,NTP,0,0,0,,Лоли шота
Dialogue: 0,0:02:14.66,0:02:15.82,Style2,,0,0,0,,«Стоикалық тип»
Dialogue: 0,0:02:14.71,0:02:16.05,jp.sub-ja,NTP,0,0,0,,Стоикалық тип
Dialogue: 0,0:02:16.69,0:02:18.32,Style2,,0,0,0,,«Егіз»
Dialogue: 0,0:02:16.75,0:02:18.36,jp.sub-ja,NTP,0,0,0,,Инцест
Dialogue: 0,0:02:18.86,0:02:20.56,Style2,,0,0,0,,«Кітап құрты»
Dialogue: 0,0:02:18.95,0:02:19.69,jp.sub-ja,NTP,0,0,0,,Гари Цутому
Dialogue: 0,0:02:28.07,0:02:30.13,Style1,,0,0,0,,Үлкен аға...
Dialogue: 0,0:02:28.20,0:02:29.32,jp.sub-ja,NTP,0,0,0,,Үлкен аға...
Dialogue: 0,0:02:32.41,0:02:35.08,Style1,,0,0,0,,Сіз аққұбасыз, демек сіз Үлкен ағасыз!
Dialogue: 0,0:02:32.68,0:02:34.68,jp.sub-ja,NTP,0,0,0,,Сенің шашың ақшыл болғандықтан, аға.
Dialogue: 0,0:02:35.08,0:02:36.41,Style1,,0,0,0,,Біз бұл туралы ешқашан естіген емеспіз.
Dialogue: 0,0:02:35.09,0:02:36.35,jp.sub-ja,NTP,0,0,0,,Мен тыңдамаймын.
Dialogue: 0,0:02:36.41,0:02:38.08,Style1,,0,0,0,,Сенің қарындасың бар ма?
Dialogue: 0,0:02:36.56,0:02:37.93,jp.sub-ja,NTP,0,0,0,,Сіздің әпкеңіз болды ма?
Dialogue: 0,0:02:37.93,0:02:39.70,jp.sub-ja,NTP,0,0,0,,Жоқ, мен жалғыз бала екеніме сенімдімін.
Dialogue: 0,0:02:38.08,0:02:41.75,Style1,,0,0,0,,Жоқ, мен жалғыз баламын. Ең болмаса жалғыз баламын деп ойлаймын...
Dialogue: 0,0:02:39.70,0:02:41.56,jp.sub-ja,NTP,0,0,0,,Менің ойымша, ол жалғыз бала еді...
Dialogue: 0,0:02:41.75,0:02:44.69,Style1,,0,0,0,,Енді сіз бұл туралы айтқаныңызда, сіз бір-біріне ұқсайтын шығарсыз.
Dialogue: 0,0:02:41.93,0:02:44.60,jp.sub-ja,NTP,0,0,0,,Менен сұрасаңыз, олар ұқсас болуы мүмкін.
Dialogue: 0,0:02:44.68,0:02:46.60,jp.sub-ja,NTP,0,0,0,,Екеуі аққұба.
Dialogue: 0,0:02:44.69,0:02:47.02,Style1,,0,0,0,,Екеуің аққұбасың, бәрің де.
Dialogue: 0,0:02:47.02,0:02:50.36,Style1,,0,0,0,,Осыған байланысты «көзілдірік сипаты» мен «Үлкен аға» бір деңгейде ме?
Dialogue: 0,0:02:47.04,0:02:50.42,jp.sub-ja,NTP,0,0,0,,Біріншіден, «көзілдірік сипаты» мен «аға» бірдей сөздер ме?
Dialogue: 0,0:02:50.36,0:02:54.36,Style1,,0,0,0,,Бұл маңызды емес, солай ма? Ол мені «оқушы» деп атады.
Dialogue: 0,0:02:50.51,0:02:51.92,jp.sub-ja,NTP,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:02:52.20,0:02:53.95,jp.sub-ja,NTP,0,0,0,,Мен өзім еңбекқормын.
Dialogue: 0,0:02:54.36,0:02:57.70,Style1,,0,0,0,,Мм... Ханым, сіздің атыңыз кім?
Dialogue: 0,0:02:54.43,0:02:57.45,jp.sub-ja,NTP,0,0,0,,Ал, қыз, сенің атың кім?
Dialogue: 0,0:02:57.70,0:02:58.70,Style1,,0,0,0,,Кирими.
Dialogue: 0,0:02:57.78,0:02:58.57,jp.sub-ja,NTP,0,0,0,,Кирими
Dialogue: 0,0:02:58.70,0:03:00.04,Style1,,0,0,0,,Кирими?
Dialogue: 0,0:02:58.70,0:03:00.08,jp.sub-ja,NTP,0,0,0,,Филе?
Dialogue: 0,0:03:00.04,0:03:01.50,Style2,,0,0,0,,``кирими: филе''
Dialogue: 0,0:03:02.04,0:03:05.37,Style1,,0,0,0,,Кирими-чан, сен қандай да бір қателік жібердің, солай емес пе?
Dialogue: 0,0:03:02.20,0:03:04.65,jp.sub-ja,NTP,0,0,0,,Кирими-чан, менің ойымша, қандай да бір қателік болуы керек.
Dialogue: 0,0:03:05.37,0:03:08.83,Style1,,0,0,0,,Менен сіңілім бар деп ойламаймын.
Dialogue: 0,0:03:05.45,0:03:08.08,jp.sub-ja,NTP,0,0,0,,Менің әпкем жоқ шығар.
Dialogue: 0,0:03:10.38,0:03:13.35,Style1,,0,0,0,,Сіз аққұба болсаңыз да, менің Үлкен ағам емессіз бе?
Dialogue: 0,0:03:10.61,0:03:13.52,jp.sub-ja,NTP,0,0,0,,Аққұба болса да, аға емес.
Dialogue: 0,0:03:13.35,0:03:14.44,Style2,,0,0,0,,«Қыңсылау»
Dialogue: 0,0:03:16.38,0:03:18.49,Style1,,0,0,0,,М-мен?
Dialogue: 0,0:03:16.48,0:03:17.73,jp.sub-ja,NTP,0,0,0,,О...мен...
Dialogue: 0,0:03:18.49,0:03:19.25,Style2,,0,0,0,,«Қыңсылау»
Dialogue: 0,0:03:19.25,0:03:20.22,Style2,,0,0,0,,«Сезімтал...»
Dialogue: 0,0:03:22.06,0:03:27.06,Style1,,0,0,0,,Жарайды. Бүгіннен бастап мен сенің Үлкен ағаң, Үлкен ағаң боламын!
Dialogue: 0,0:03:22.32,0:03:26.80,jp.sub-ja,NTP,0,0,0,,Жарайды, бүгіннен бастап мен сенің ағаңмын. Мен әлі сенің ағаңмын.
Dialogue: 0,0:03:26.80,0:03:28.44,jp.sub-ja,NTP,0,0,0,,сүйкімді сүйкімді
Dialogue: 0,0:03:27.06,0:03:28.40,Style1,,0,0,0,,Сен сондай сүйкімдісің, сен сондай сүйкімдісің...
Dialogue: 0,0:03:28.40,0:03:31.07,Style1,,0,0,0,,Сезіміңізге қаншалықты оңай берілсеңіз де,
Dialogue: 0,0:03:28.44,0:03:30.88,jp.sub-ja,NTP,0,0,0,,Сезімдер қаншалықты оңай болса да,
Dialogue: 0,0:03:30.88,0:03:34.44,jp.sub-ja,NTP,0,0,0,,Кішкентай балаларға мұндай жауапсыз сөздерді айту дұрыс деп ойлайсыз ба?
Dialogue: 0,0:03:31.07,0:03:33.07,Style1,,0,0,0,,сіз шынымен де осындай жауапсыз мәлімдеме жасау керек деп ойлайсыз ба?
Dialogue: 0,0:03:33.07,0:03:34.40,Style1,,0,0,0,,жас балаға?
Dialogue: 0,0:03:34.23,0:03:35.70,jp.sub-ja,NTP,0,0,0,,Жауапкершіліксіз емес
Dialogue: 0,0:03:34.40,0:03:37.07,Style1,,0,0,0,,Мен жауапсыз емеспін! Мен саған қарайтыныма сенімді боламын!
Dialogue: 0,0:03:35.86,0:03:37.24,jp.sub-ja,NTP,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:03:37.07,0:03:39.41,Style1,,0,0,0,,Ендеше менімен үйге кел!
Dialogue: 0,0:03:37.24,0:03:39.60,jp.sub-ja,NTP,0,0,0,,Сондықтан мен сені үйге апардым.
Dialogue: 0,0:03:39.41,0:03:41.74,Style1,,0,0,0,,Не істеуіміз керек, Кёя-сенпай?
Dialogue: 0,0:03:39.60,0:03:41.60,jp.sub-ja,NTP,0,0,0,,Не істеуіміз керек, Кёуя-сенпай?
Dialogue: 0,0:03:41.64,0:03:45.61,jp.sub-ja,NTP,0,0,0,,Мүмкін орта мектепте аққұба жігіт бар шығар?
Dialogue: 0,0:03:41.74,0:03:43.34,Style1,,0,0,0,,Оның бар болуы мүмкін
Dialogue: 0,0:03:43.34,0:03:46.01,Style1,,0,0,0,,орта мектепте оқитын аққұба аға, солай емес пе?
Dialogue: 0,0:03:47.02,0:03:50.35,Style1,,0,0,0,,Кирими...
Dialogue: 0,0:03:47.47,0:03:51.90,jp.sub-ja,NTP,0,0,0,,Кирими Кирими
Dialogue: 0,0:03:50.35,0:03:52.25,Style1,,0,0,0,,Кирими...
Dialogue: 0,0:03:57.03,0:04:00.03,Style1,,0,0,0,,- Мм, сен кімсің? -Мм, сен кімсің?
Dialogue: 0,0:03:57.35,0:03:59.47,jp.sub-ja,NTP,0,0,0,,Қайсысы?
Dialogue: 0,0:03:59.86,0:04:01.42,jp.sub-ja,NTP,0,0,0,,Шетелдік
Dialogue: 0,0:04:00.03,0:04:01.70,Style1,,0,0,0,,Ол шетелдік!
Dialogue: 0,0:04:01.68,0:04:04.92,jp.sub-ja,NTP,0,0,0,,Дәлірек айтқанда, есіктің пішіні өзгерген жоқ па?
Dialogue: 0,0:04:01.70,0:04:05.10,Style1,,0,0,0,,Есік басқаша емес пе?
Dialogue: 0,0:04:06.03,0:04:06.88,jp.sub-ja,NTP,0,0,0,,Кирими
Dialogue: 0,0:04:06.03,0:04:08.37,Style1,,0,0,0,,Кирими...
Dialogue: 0,0:04:08.37,0:04:09.37,Style1,,0,0,0,,Мастер...
Dialogue: 0,0:04:08.45,0:04:09.16,jp.sub-ja,NTP,0,0,0,,Обочама
Dialogue: 0,0:04:09.37,0:04:11.24,Style1,,0,0,0,,...сен киіміңді ұмыттың.
Dialogue: 0,0:04:09.44,0:04:10.94,jp.sub-ja,NTP,0,0,0,,Сен киіміңді ұмыттың.
Dialogue: 0,0:04:16.81,0:04:18.18,Style2,,0,0,0,,«Қара магия клубының президенті, Некозава Умехито»
Dialogue: 0,0:04:18.38,0:04:20.07,Style1,,0,0,0,,- Некозава-сенпай? - Некозава-сенпай? - Некозава-сенпай?
Dialogue: 0,0:04:18.41,0:04:19.74,jp.sub-ja,NTP,0,0,0,,Некозава-сенпай? !
Dialogue: 0,0:04:20.58,0:04:21.91,Style1,,0,0,0,,«Бұл не болды!?»
Dialogue: 0,0:04:20.58,0:04:21.91,Style2,,0,0,0,,«Бұл не болды!?»
Dialogue: 0,0:04:22.38,0:04:26.72,Style1,,0,0,0,,Мастер Умехито жарқыраған жарыққа өте осал.
Dialogue: 0,0:04:22.60,0:04:26.19,jp.sub-ja,NTP,0,0,0,,Умеджин Бочама жарқын жарықты жек көреді.
Dialogue: 0,0:04:25.95,0:04:39.20,Style2,,0,0,0,,«Некозава отбасылық қызметшісі, Куретаке»
Dialogue: 0,0:04:26.68,0:04:29.85,jp.sub-ja,NTP,0,0,0,,Сондықтан, егер сіз қара киінбесеңіз,
Dialogue: 0,0:04:26.72,0:04:29.72,Style1,,0,0,0,,Осылайша, егер ол қара киінбесе,
Dialogue: 0,0:04:29.72,0:04:33.39,Style1,,0,0,0,,ол жарыққа шыдамайды, құлап қалады.
Dialogue: 0,0:04:29.85,0:04:33.20,jp.sub-ja,NTP,0,0,0,,Жарықтыққа шыдай алмай, құлап қалады.
Dialogue: 0,0:04:33.30,0:04:35.40,jp.sub-ja,NTP,0,0,0,,Тіпті өзіңіздің ашық шашыңыздың түсі
Dialogue: 0,0:04:33.39,0:04:38.70,Style1,,0,0,0,,Ол тіпті шашының түсінің ашықтығын қара парикпен жабуы керек!
Dialogue: 0,0:04:35.51,0:04:38.16,jp.sub-ja,NTP,0,0,0,,Оны қара шашпен жасыру керек.
Dialogue: 0,0:04:40.20,0:04:45.90,Style2,,0,0,0,,«Некозава отбасы хатшысы, Кадомацу»
Dialogue: 0,0:04:40.20,0:04:46.01,Style1,,0,0,0,,Екінші жағынан, оның әпкесі Кирими ханым жарықсыз жерлерді жек көреді.
Dialogue: 0,0:04:40.24,0:04:45.16,jp.sub-ja,NTP,0,0,0,,Керісінше, Кирими әпкем қараңғы жерлерді жек көреді.
Dialogue: 0,0:04:46.01,0:04:50.35,Style1,,0,0,0,,Сонда ол Некозава-сенпайдың қарындасы ма?
Dialogue: 0,0:04:46.14,0:04:49.41,jp.sub-ja,NTP,0,0,0,,Бұл қыз Некозава-сенпайдың сіңлісі еді ғой?
Dialogue: 0,0:04:50.35,0:04:54.15,Style1,,0,0,0,,Шындықты айтсақ, бұл дұрыс.
Dialogue: 0,0:04:50.43,0:04:54.09,jp.sub-ja,NTP,0,0,0,,Нені жасыруым керек? Бұл дұрыс.
Dialogue: 0,0:04:57.02,0:04:59.21,Style2,,0,0,0,,«Некозава Кирими»
Dialogue: 0,0:05:00.22,0:05:01.95,jp.sub-ja,NTP,0,0,0,,Ки…ки…Кирими…
Dialogue: 0,0:05:00.36,0:05:02.36,Style1,,0,0,0,,Қ-Қ-Кірімі...
Dialogue: 0,0:05:02.11,0:05:04.72,jp.sub-ja,NTP,0,0,0,,Сіз осында болдыңыз ба?
Dialogue: 0,0:05:02.36,0:05:05.09,Style1,,0,0,0,,...сондықтан сіз осы жердесіз...
Dialogue: 0,0:05:07.26,0:05:10.20,Style2,,0,0,0,,«Құбыжық!»
Dialogue: 0,0:05:07.64,0:05:10.25,jp.sub-ja,NTP,0,0,0,,О, елес
Dialogue: 0,0:05:07.70,0:05:10.23,Style1,,0,0,0,,Уа! Құбыжық!
Dialogue: 0,0:05:10.23,0:05:12.30,Style1,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:05:10.43,0:05:16.16,jp.sub-ja,NTP,0,0,0,,Жарайды, мына қарғыс атқан қуыршақ Белзенев мүлде қорқынышты емес.
Dialogue: 0,0:05:12.30,0:05:16.70,Style1,,0,0,0,,Мұндағы қарғыс атқан қуыршақ Белзенеф аз да болса қорқынышты емес.
Dialogue: 0,0:05:16.68,0:05:20.70,jp.sub-ja,NTP,0,0,0,,Некозава отбасы ұрпақтар бойы мысыққа ұқсас заттарға табынған.
Dialogue: 0,0:05:16.70,0:05:20.71,Style1,,0,0,0,,Некозава отбасы ұрпақтар бойы мысық тәрізді заттарға табынған.
Dialogue: 0,0:05:20.71,0:05:23.55,Style1,,0,0,0,,Жоқ, ол қорқатын қуыршақ емес,
Dialogue: 0,0:05:20.95,0:05:23.46,jp.sub-ja,NTP,0,0,0,,Жоқ, қорқынышты қуыршақ емес.
Dialogue: 0,0:05:23.46,0:05:25.46,jp.sub-ja,NTP,0,0,0,,Некозава-сенпайдың өзі болуы мүмкін бе?
Dialogue: 0,0:05:23.55,0:05:25.71,Style1,,0,0,0,,Бұл сіз, өзіңізсіз.
Dialogue: 0,0:05:26.71,0:05:29.38,Style1,,0,0,0,,Бұл сіздің киінуіңізге байланысты, солай емес пе?
Dialogue: 0,0:05:26.80,0:05:28.84,jp.sub-ja,NTP,0,0,0,,Бұлай киінгендіктен емес.
Dialogue: 0,0:05:28.75,0:05:32.31,Style2,,0,0,0,,«Көмектесуге тырысу»
Dialogue: 0,0:05:29.38,0:05:32.32,Style1,,0,0,0,,Олай етпе! Бұл өте жарқын, мен өлемін!
Dialogue: 0,0:05:29.40,0:05:31.72,jp.sub-ja,NTP,0,0,0,,Тоқта, бұл жарық, мен өлемін
Dialogue: 0,0:05:32.32,0:05:35.39,Style1,,0,0,0,,Ал, бөлмені қараңғылатсақ болды!
Dialogue: 0,0:05:32.49,0:05:35.16,jp.sub-ja,NTP,0,0,0,,Ал, бөлмені қараңғы ет.
Dialogue: 0,0:05:35.38,0:05:37.44,jp.sub-ja,NTP,0,0,0,,Жоқ, қараңғы.
Dialogue: 0,0:05:35.39,0:05:37.73,Style1,,0,0,0,,Уа! Мен қараңғылықты жек көремін!
Dialogue: 0,0:05:37.73,0:05:38.73,Style1,,0,0,0,,О, ана жерде.
Dialogue: 0,0:05:38.73,0:05:41.06,Style1,,0,0,0,,Енді ол оны көтере алмайды.
Dialogue: 0,0:05:38.92,0:05:40.72,jp.sub-ja,NTP,0,0,0,,Бұл жолы дұрыс емес пе?
Dialogue: 0,0:05:41.06,0:05:44.33,Style1,,0,0,0,,Осы екі қарама-қарсы тұлғаны тудырған трагедия
Dialogue: 0,0:05:41.15,0:05:44.60,jp.sub-ja,NTP,0,0,0,,Бұл қарама-қарсы конституциялардың қайғылы табиғаты неде
Dialogue: 0,0:05:44.33,0:05:49.27,Style1,,0,0,0,,бұл екеуінің Некозава отбасының Ромео мен Джульетта деп аталу себебі.
Dialogue: 0,0:05:44.60,0:05:48.94,jp.sub-ja,NTP,0,0,0,,Екеуіңізді Некозава жанұясының Ромидурилері деп атағаныңыздың себебі осы.
Dialogue: 0,0:05:50.60,0:05:53.27,jp.sub-ja,NTP,0,0,0,,Ромео мен Джульетта ағайынды емес.
Dialogue: 0,0:05:50.67,0:05:53.34,Style1,,0,0,0,,Ромео мен Джульетта аға-әпке емес еді,
Dialogue: 0,0:05:53.34,0:05:56.01,Style1,,0,0,0,,және жағдай мүлдем басқаша.
Dialogue: 0,0:05:53.47,0:05:55.48,jp.sub-ja,NTP,0,0,0,,Жағдай мүлде басқа...
Dialogue: 0,0:05:56.01,0:05:57.68,Style1,,0,0,0,,Мен бұл туралы білемін.
Dialogue: 0,0:05:56.09,0:05:57.61,jp.sub-ja,NTP,0,0,0,,(Екі рет) Қорықпа. Іштегілердің бәрі де ауырып жатыр.
Dialogue: 0,0:05:57.68,0:06:01.68,Style1,,0,0,0,,Бұл мен дәл қазір ойлап таптым.
Dialogue: 0,0:05:57.82,0:06:01.55,jp.sub-ja,NTP,0,0,0,,Бұл мен ойлап тапқан тамаша фраза.
Dialogue: 0,0:06:01.68,0:06:04.35,Style1,,0,0,0,,Мен оны драмалық етеді деп ойладым.
Dialogue: 0,0:06:01.76,0:06:04.16,jp.sub-ja,NTP,0,0,0,,Мен бұл драмалық болады деп ойладым...
Dialogue: 0,0:06:01.88,0:06:05.94,Style2,,0,0,0,,«Некозава отбасының Ромео мен Джульетта»
Dialogue: 0,0:06:04.35,0:06:06.35,Style1,,0,0,0,,О, түсіндім.
Dialogue: 0,0:06:04.46,0:06:05.40,jp.sub-ja,NTP,0,0,0,,Иә?
Dialogue: 0,0:06:06.24,0:06:11.32,jp.sub-ja,NTP,0,0,0,,Айтпақшы, Кирими-саманы қарсы алу бізде.
Dialogue: 0,0:06:06.35,0:06:11.36,Style1,,0,0,0,,Айтпақшы, бізді Кирими-саманы алып кетуге жіберді.
Dialogue: 0,0:06:11.32,0:06:12.91,jp.sub-ja,NTP,0,0,0,,Некозава отбасы кім?
Dialogue: 0,0:06:11.36,0:06:12.69,Style1,,0,0,0,,Бүкіл Некозава отбасы ма...
Dialogue: 0,0:06:12.69,0:06:15.70,Style1,,0,0,0,,...осының бәрі сияқты біртүрлі?
Dialogue: 0,0:06:12.91,0:06:14.70,jp.sub-ja,NTP,0,0,0,,Бәрі де осыншама күдіктене ме деп ойлаймын.
Dialogue: 0,0:06:15.68,0:06:17.40,jp.sub-ja,NTP,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:15.70,0:06:19.37,Style1,,0,0,0,,Сіз не туралы айтып отырсыз!? Некозавалар – көрнекті,
Dialogue: 0,0:06:17.40,0:06:20.61,jp.sub-ja,NTP,0,0,0,,Некозава отбасы Ресейдің Токаревтар әулетіне жатады.
Dialogue: 0,0:06:19.37,0:06:22.70,Style1,,0,0,0,,Ресейдің Токаревтер әулетінен шыққан лайықты отбасы!
Dialogue: 0,0:06:20.61,0:06:22.61,jp.sub-ja,NTP,0,0,0,,Мәртебелі отбасынан шыққан
Dialogue: 0,0:06:23.71,0:06:25.87,Style1,,0,0,0,,Токарев?
Dialogue: 0,0:06:23.72,0:06:24.77,jp.sub-ja,NTP,0,0,0,,Токарев
Dialogue: 0,0:06:25.87,0:06:26.70,Style2,,0,0,0,,«Токарев»
Dialogue: 0,0:06:26.85,0:06:29.38,jp.sub-ja,NTP,0,0,0,,Романовтар әулетінде?
Dialogue: 0,0:06:27.04,0:06:29.71,Style1,,0,0,0,,D-Романовтар әулетін айтып тұрған жоқсыз ба?
Dialogue: 0,0:06:29.71,0:06:33.05,Style1,,0,0,0,,Бірақ қандай себеппен болса да, бұл туралы аңыз бар.
Dialogue: 0,0:06:30.04,0:06:32.63,jp.sub-ja,NTP,0,0,0,,Ал Некозава отбасы үшін қандай салдары бар?
Dialogue: 0,0:06:31.31,0:06:31.87,Style2,,0,0,0,,«Елденбей ме?»
Dialogue: 0,0:06:33.00,0:06:36.12,jp.sub-ja,NTP,0,0,0,,Жүздеген жылда бір рет, Умеджин-сама сияқты
Dialogue: 0,0:06:33.05,0:06:36.05,Style1,,0,0,0,,бірнеше жүз жылда бір рет Некозава отбасында адам дүниеге келеді,
Dialogue: 0,0:06:36.05,0:06:40.32,Style1,,0,0,0,,, Умехито-сама сияқты, қараңғылыққа ие болу тағдыры ...
Dialogue: 0,0:06:36.12,0:06:40.32,jp.sub-ja,NTP,0,0,0,,Тағдырдың баласы қараңғылықтан сиқырланып туады деген аңыз бар...
Dialogue: 0,0:06:41.72,0:06:44.33,Style1,,0,0,0,,...бұл шындық болуы мүмкін немесе болмауы мүмкін.
Dialogue: 0,0:06:42.02,0:06:44.40,jp.sub-ja,NTP,0,0,0,,Ол жерде болуы немесе болмауы мүмкін.
Dialogue: 0,0:06:44.33,0:06:46.33,Style1,,0,0,0,,Бұл дұрыс болуы мүмкін бе, жоқ па?
Dialogue: 0,0:06:44.40,0:06:46.40,jp.sub-ja,NTP,0,0,0,,Бұл болуы мүмкін немесе болмауы мүмкін ...
Dialogue: 0,0:06:46.33,0:06:48.66,Style1,,0,0,0,,Сонымен бұл қайсысы?
Dialogue: 0,0:06:46.53,0:06:48.02,jp.sub-ja,NTP,0,0,0,,​​Қайсысы?
Dialogue: 0,0:06:48.33,0:06:51.99,Style2,,0,0,0,,«Некозава отбасылық альбомы»
Dialogue: 0,0:06:48.66,0:06:52.00,Style1,,0,0,0,,Мастер жағдайының нәтижесінде мүмкін емес
Dialogue: 0,0:06:48.78,0:06:51.23,jp.sub-ja,NTP,0,0,0,,Оның конституциясына байланысты Бочама
Dialogue: 0,0:06:51.23,0:06:54.71,jp.sub-ja,NTP,0,0,0,,Қара киімсіз апама жақындай алмаймын.
Dialogue: 0,0:06:52.00,0:06:55.00,Style1,,0,0,0,,қара киімсіз әпкесінің қасына бару,
Dialogue: 0,0:06:54.97,0:06:57.93,jp.sub-ja,NTP,0,0,0,,Киримиді тек оның портретінен білуге болады.
Dialogue: 0,0:06:55.00,0:06:58.01,Style1,,0,0,0,,және Кирими ханым ертегідегі ханзадаға ғашық болды
Dialogue: 0,0:06:58.01,0:07:01.68,Style1,,0,0,0,,ағаның портретінен ғана білетін.
Dialogue: 0,0:06:58.02,0:07:01.49,jp.sub-ja,NTP,0,0,0,,Ертегідегі ханзадаға ұқсаған ағама ғашық болу.
Dialogue: 0,0:07:01.68,0:07:04.68,Style1,,0,0,0,,Ол ағасының орта мектепке қабылданғанын білгеннен кейін,
Dialogue: 0,0:07:01.90,0:07:04.65,jp.sub-ja,NTP,0,0,0,,Мен ағамның орта мектепке қабылданғанын білгеннен кейін.
Dialogue: 0,0:07:04.65,0:07:09.80,jp.sub-ja,NTP,0,0,0,,Осылайша мен Умеджинді анда-санда іздей бастадым.
Dialogue: 0,0:07:04.68,0:07:10.35,Style1,,0,0,0,,ол Умехито-саманы осылай іздеп келеді деп алды.
Dialogue: 0,0:07:10.35,0:07:14.36,Style1,,0,0,0,,Әрине, біз Ханшайымды бірнеше рет жұбатуға тырыстық
Dialogue: 0,0:07:10.58,0:07:14.50,jp.sub-ja,NTP,0,0,0,,Әрине, біз ханзадалар туралы ертегілерді де оқимыз.
Dialogue: 0,0:07:14.36,0:07:17.36,Style1,,0,0,0,,князь кейіпкерлерінің ұйқы алдындағы әңгімелерімен,
Dialogue: 0,0:07:14.50,0:07:17.36,jp.sub-ja,NTP,0,0,0,,Мен жас ханымды жұбатуды жалғастырдым.
Dialogue: 0,0:07:17.36,0:07:20.70,Style1,,0,0,0,,және айтатын әңгімелер таусылғандықтан, біз жақында қостық
Dialogue: 0,0:07:17.51,0:07:19.16,jp.sub-ja,NTP,0,0,0,,Мен күткендей ойым таусылды.
Dialogue: 0,0:07:19.16,0:07:21.87,jp.sub-ja,NTP,0,0,0,,Соңғы кезде тіпті ханзада кейіпкерлері бар қыздардың мангасы да пайда болды.
Dialogue: 0,0:07:20.70,0:07:24.03,Style1,,0,0,0,,репертуарында пайда болатын ханзада кейіпкерлері бар шоджо мангасы,
Dialogue: 0,0:07:21.87,0:07:23.73,jp.sub-ja,NTP,0,0,0,,Репертуарыңызды кеңейту
Dialogue: 0,0:07:24.03,0:07:26.24,jp.sub-ja,NTP,0,0,0,,Мен бұған әбден әуестеніп кеттім...
Dialogue: 0,0:07:24.03,0:07:26.70,Style1,,0,0,0,,және ол оларға әбден сіңіп кетті.
Dialogue: 0,0:07:26.70,0:07:28.37,Style1,,0,0,0,,Шоджо мангасы?
Dialogue: 0,0:07:26.76,0:07:28.12,jp.sub-ja,NTP,0,0,0,,Қыздар мангасы?
Dialogue: 0,0:07:28.37,0:07:30.04,Style1,,0,0,0,,Кері гарем!
Dialogue: 0,0:07:28.41,0:07:30.00,jp.sub-ja,NTP,0,0,0,,Бұл кері гарем.
Dialogue: 0,0:07:30.04,0:07:31.37,Style1,,0,0,0,,Азғындық.
Dialogue: 0,0:07:30.24,0:07:31.31,jp.sub-ja,NTP,0,0,0,,Саке тоғанының ет орманы
Dialogue: 0,0:07:31.37,0:07:35.71,Style1,,0,0,0,,Иә! Бұл жерде азғындық бар!
Dialogue: 0,0:07:31.52,0:07:34.46,jp.sub-ja,NTP,0,0,0,,Ия, бұл Саке тоғанының ет орманы.
Dialogue: 0,0:07:35.71,0:07:38.38,Style1,,0,0,0,,Мұның көзі осы қызметші болды ма?
Dialogue: 0,0:07:35.95,0:07:37.74,jp.sub-ja,NTP,0,0,0,,Осы қызметші себепкер ме?
Dialogue: 0,0:07:38.38,0:07:43.65,Style1,,0,0,0,,Шоджо мангасындағы азғындық? Сонымен, Сашими-чан олай емес...
Dialogue: 0,0:07:38.47,0:07:40.88,jp.sub-ja,NTP,0,0,0,,Қыздар мангасындағы Саке тоғанының ет орманы...
Dialogue: 0,0:07:41.30,0:07:43.55,jp.sub-ja,NTP,0,0,0,,Олай болса, Сашими-чан...
Dialogue: 0,0:07:42.25,0:07:43.99,Style2,,0,0,0,,«Сашими»
Dialogue: 0,0:07:43.65,0:07:46.92,Style1,,0,0,0,,- Бұл кирими. - Бұл "Кирими"!
Dialogue: 0,0:07:43.87,0:07:44.56,jp.sub-ja,NTP,0,0,0,,Бұл филе.
Dialogue: 0,0:07:43.99,0:07:44.92,Style2,,0,0,0,,"кирими (филе)"
Dialogue: 0,0:07:44.75,0:07:45.92,jp.sub-ja,NTP,0,0,0,,Киримису
Dialogue: 0,0:07:44.92,0:07:46.91,Style2,,0,0,0,,«Кирими»
Dialogue: 0,0:07:46.92,0:07:50.33,Style1,,0,0,0,,...Кирими-чан оның ағасы екеніңді білмейді,
Dialogue: 0,0:07:47.06,0:07:51.20,jp.sub-ja,NTP,0,0,0,,Кирими-чан Некозава-сенпайдың үлкен ағаң екенін білмей ме?
Dialogue: 0,0:07:50.33,0:07:51.76,Style1,,0,0,0,,Некозава-сенпай?
Dialogue: 0,0:07:53.24,0:07:56.90,jp.sub-ja,NTP,0,0,0,,Иә, қанша айтсам да сенбейсің.
Dialogue: 0,0:07:53.33,0:07:57.03,Style1,,0,0,0,,Иә. Біз оған бірнеше рет айттық, бірақ ол бізге сенбейді.
Dialogue: 0,0:07:58.00,0:08:01.34,Style1,,0,0,0,,Неко-чан бұған қайғырса керек.
Dialogue: 0,0:07:58.17,0:08:00.86,jp.sub-ja,NTP,0,0,0,,Бұл мысықты қайғырады
Dialogue: 0,0:08:01.34,0:08:02.34,Style1,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:08:01.49,0:08:03.83,jp.sub-ja,NTP,0,0,0,,Иә, солай
Dialogue: 0,0:08:02.34,0:08:04.67,Style1,,0,0,0,,Сол себепті...
Dialogue: 0,0:08:04.66,0:08:07.39,jp.sub-ja,NTP,0,0,0,,Кирими қараңғылықты осылай жақсы көрсе екен.
Dialogue: 0,0:08:04.67,0:08:06.51,Style1,,0,0,0,,...Мен осылай дұға жасаймын, әр түнде,
Dialogue: 0,0:08:06.51,0:08:10.01,Style1,,0,0,0,,Кирими қараңғылықты жақсы көреді.
Dialogue: 0,0:08:07.39,0:08:09.51,jp.sub-ja,NTP,0,0,0,,Мен әр түнде намаз оқимын.
Dialogue: 0,0:08:10.01,0:08:11.68,Style1,,0,0,0,,Жоқ, сіз оны кері түсіндіңіз.
Dialogue: 0,0:08:10.28,0:08:11.69,jp.sub-ja,NTP,0,0,0,,Жоқ, керісінше.
Dialogue: 0,0:08:11.68,0:08:14.02,Style1,,0,0,0,,Жарық жерлерге дағдылану керек.
Dialogue: 0,0:08:11.84,0:08:14.02,jp.sub-ja,NTP,0,0,0,,Көңілді болсаң, уайымдама.
Dialogue: 0,0:08:14.02,0:08:15.57,jp.sub-ja,NTP,0,0,0,,Менің әпкемді не істейсің?
Dialogue: 0,0:08:14.02,0:08:16.02,Style1,,0,0,0,,Әпкеңе не істемексің?
Dialogue: 0,0:08:16.02,0:08:17.69,Style1,,0,0,0,,Кел, Кирими-сама.
Dialogue: 0,0:08:16.09,0:08:17.55,jp.sub-ja,NTP,0,0,0,,Кирими-сама
Dialogue: 0,0:08:17.67,0:08:18.53,jp.sub-ja,NTP,0,0,0,,Үйге қайтайық
Dialogue: 0,0:08:17.69,0:08:18.69,Style1,,0,0,0,,Үйге қайтайық.
Dialogue: 0,0:08:18.61,0:08:21.91,jp.sub-ja,NTP,0,0,0,,Жоқ, мен ағаммен барамын.
Dialogue: 0,0:08:18.69,0:08:20.02,Style1,,0,0,0,,Жоқ!!
Dialogue: 0,0:08:20.02,0:08:24.32,Style1,,0,0,0,,Мен Үлкен ағамен бірге тұрамын! Мен Үлкен ағамен бірге болғаным жөн!
Dialogue: 0,0:08:21.91,0:08:24.20,jp.sub-ja,NTP,0,0,0,,Ағаңның жанында болғаны жақсы.
Dialogue: 0,0:08:25.69,0:08:28.03,Style1,,0,0,0,,Некозава-сенпай...
Dialogue: 0,0:08:25.80,0:08:27.25,jp.sub-ja,NTP,0,0,0,,Некозава-сенпай...
Dialogue: 0,0:08:28.03,0:08:30.70,Style1,,0,0,0,,Жарайды, Сукун.
Dialogue: 0,0:08:28.24,0:08:29.90,jp.sub-ja,NTP,0,0,0,,Жарайды, Сукун.
Dialogue: 0,0:08:30.70,0:08:33.94,Style1,,0,0,0,,Маған не болғаны маңызды емес.
Dialogue: 0,0:08:30.92,0:08:33.62,jp.sub-ja,NTP,0,0,0,,Сен маған бәрібір.
Dialogue: 0,0:08:33.94,0:08:37.71,Style1,,0,0,0,,Өтінемін, Киримиге керек махаббатты бер!
Dialogue: 0,0:08:34.09,0:08:37.85,jp.sub-ja,NTP,0,0,0,,Өтінемін... Киримиге мейірімді болыңыз.
Dialogue: 0,0:08:37.71,0:08:39.57,Style1,,0,0,0,,Некозава-сенпай!
Dialogue: 0,0:08:37.85,0:08:39.13,jp.sub-ja,NTP,0,0,0,,Некозава Сенпай
Dialogue: 0,0:08:43.38,0:08:47.41,Style1,,0,0,0,,Ағайындылар сондай, олар кез келген отбасында мәселенің көзі болып табылады.
Dialogue: 0,0:08:43.52,0:08:47.11,jp.sub-ja,NTP,0,0,0,,Ағайындылар кез келген отбасындағы мәселе.
Dialogue: 0,0:08:48.72,0:08:50.78,Style1,,0,0,0,,Мен оларды қызғанамын.
Dialogue: 0,0:08:48.89,0:08:50.22,jp.sub-ja,NTP,0,0,0,,Мен қызғанамын
Dialogue: 0,0:08:52.05,0:08:55.72,Style1,,0,0,0,,Мен өмір бойы жалғыз бала болдым.
Dialogue: 0,0:08:52.12,0:08:54.36,jp.sub-ja,NTP,0,0,0,,Өйткені мен әрқашан жалғыз бала болдым.
Dialogue: 0,0:08:55.72,0:08:58.73,Style1,,0,0,0,,Дегенмен, шын мәнінде ағасы бар,
Dialogue: 0,0:08:55.87,0:09:00.12,jp.sub-ja,NTP,0,0,0,,Бірақ ағаларым болса да, олармен тіл табыса алмаймын.
Dialogue: 0,0:08:58.73,0:09:02.63,Style1,,0,0,0,,бірақ онымен тіл табыса алмау өте өкінішті, иә?
Dialogue: 0,0:09:00.39,0:09:02.01,jp.sub-ja,NTP,0,0,0,,Бұл бір қайғылы, солай емес пе?
Dialogue: 0,0:09:08.07,0:09:11.07,Style1,,0,0,0,,Не болды, Үлкен аға?
Dialogue: 0,0:09:08.30,0:09:10.44,jp.sub-ja,NTP,0,0,0,,Не болды, ағайын?
Dialogue: 0,0:09:11.07,0:09:17.07,Style1,,0,0,0,,Кешіріңіз, Кирими-чан. Мен шынымен сенің ағаң емеспін.
Dialogue: 0,0:09:11.28,0:09:12.92,jp.sub-ja,NTP,0,0,0,,Кешіріңіз, Кирими-чан.
Dialogue: 0,0:09:14.00,0:09:16.52,jp.sub-ja,NTP,0,0,0,,Мен тіпті сенің ағаң да емеспін.
Dialogue: 0,0:09:18.08,0:09:21.75,Style1,,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,0:09:18.24,0:09:20.72,jp.sub-ja,NTP,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,0:09:21.75,0:09:26.09,Style1,,0,0,0,,Кирими-чан, сенде менен де әдемі ханзада бар,
Dialogue: 0,0:09:21.79,0:09:25.74,jp.sub-ja,NTP,0,0,0,,Кирими-чанның менен қарағанда әлдеқайда керемет ханзадасы бар.
Dialogue: 0,0:09:26.09,0:09:29.76,Style1,,0,0,0,,және ол сіздің нағыз Үлкен ағаңыз.
Dialogue: 0,0:09:26.15,0:09:28.11,jp.sub-ja,NTP,0,0,0,,Өйткені менің нағыз ағам бар
Dialogue: 0,0:09:29.76,0:09:31.76,Style1,,0,0,0,,Сенпай...
Dialogue: 0,0:09:29.95,0:09:31.08,jp.sub-ja,NTP,0,0,0,,Ол ешқашан да болмайды!
Dialogue: 0,0:09:31.76,0:09:37.10,Style1,,0,0,0,,Ол осында келген кезде Кирими-чан Хост клубының қонағы болды.
Dialogue: 0,0:09:31.94,0:09:33.48,jp.sub-ja,NTP,0,0,0,,Сіз осында болғаныңыздан бері
Dialogue: 0,0:09:33.74,0:09:36.34,jp.sub-ja,NTP,0,0,0,,Кирими-чан біздің қабылдаушы клубымыздың тұтынушысы.
Dialogue: 0,0:09:37.10,0:09:42.44,Style1,,0,0,0,,Ouran Host Club қыздарға бақыт сыйлау үшін жұмыс істейді.
Dialogue: 0,0:09:37.20,0:09:38.77,jp.sub-ja,NTP,0,0,0,,Менің Оурандағы хост клубым
Dialogue: 0,0:09:39.39,0:09:42.11,jp.sub-ja,NTP,0,0,0,,Қыздардың бақыты үшін бар
Dialogue: 0,0:09:42.44,0:09:44.71,Style1,,0,0,0,,Бірін-бірі менсінбейтін іні-қарындасы бар,
Dialogue: 0,0:09:42.80,0:09:46.16,jp.sub-ja,NTP,0,0,0,,Бірін-бірі ұнататын ағайындар бірге бола алмайды, т.б.
Dialogue: 0,0:09:44.71,0:09:49.04,Style1,,0,0,0,,және кім бір-бірімен бола алмайды, бұл болмауы керек күрделі мәселе!
Dialogue: 0,0:09:46.28,0:09:48.16,jp.sub-ja,NTP,0,0,0,,Болмауы керек үлкен мәселе
Dialogue: 0,0:09:49.04,0:09:52.71,Style1,,0,0,0,,Қазіргі уақытта, «Операция Некозава-сенпайды жарыққа айналдыру,
Dialogue: 0,0:09:49.07,0:09:53.50,jp.sub-ja,NTP,0,0,0,,Бұдан былай Некозава-сенпай Кирими-чанның сүйікті жарқын ханзада кейіпкеріне айналады.
Dialogue: 0,0:09:52.71,0:09:56.55,Style1,,0,0,0,,Кирими-чан ұнататын ханзада кейіпкері» фильмі жүріп жатыр!
Dialogue: 0,0:09:53.50,0:09:55.92,jp.sub-ja,NTP,0,0,0,,Негізгі реформа стратегиясын бастаңыз
Dialogue: 0,0:09:55.25,0:09:56.55,Style2,,0,0,0,,«Немесе қысқаша»
Dialogue: 0,0:09:56.55,0:09:59.95,Style2,,0,0,0,,«Операция сипатын өзгерту»
Dialogue: 0,0:09:58.39,0:09:59.95,Style1,,0,0,0,,- Тағы да? - Тағы?
Dialogue: 0,0:09:59.95,0:10:01.39,Style1,,0,0,0,,B-бірақ...
Dialogue: 0,0:10:00.12,0:10:01.52,jp.sub-ja,NTP,0,0,0,,Бірақ... бірақ...
Dialogue: 0,0:10:01.39,0:10:05.39,Style1,,0,0,0,,...Умехито-саманың қараңғы мінезін реформалау?
Dialogue: 0,0:10:01.57,0:10:05.24,jp.sub-ja,NTP,0,0,0,,Умехитоның қараңғылығына тәнті болған кейіпкерді реформалау...
Dialogue: 0,0:10:05.37,0:10:07.32,jp.sub-ja,NTP,0,0,0,,Бұл мүмкін деп ойлайсыз ба?
Dialogue: 0,0:10:05.39,0:10:08.06,Style1,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:10:07.88,0:10:11.14,jp.sub-ja,NTP,0,0,0,,Сондықтан да, эмоцияға берілу қаншалықты оңай болса да,
Dialogue: 0,0:10:08.06,0:10:11.40,Style1,,0,0,0,,Мен айтқанымдай, сізді сезімдер қаншалықты оңай алып кетсе де,
Dialogue: 0,0:10:11.40,0:10:14.40,Style1,,0,0,0,,Бұл жауапсыз мәлімдемелер...
Dialogue: 0,0:10:11.52,0:10:13.36,jp.sub-ja,NTP,0,0,0,,Мұндай жауапсыз мәлімдеме...
Dialogue: 0,0:10:14.40,0:10:16.07,Style1,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:10:14.48,0:10:15.53,jp.sub-ja,NTP,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:10:16.07,0:10:19.07,Style1,,0,0,0,,Біздің жағымызда басқалардан гөрі көңілді біреу бар
Dialogue: 0,0:10:16.10,0:10:19.00,jp.sub-ja,NTP,0,0,0,,Кейіпкерлер параметрлерін реформалауға қатысты бізде бар
Dialogue: 0,0:10:19.07,0:10:22.41,Style1,,0,0,0,,адамның мінезін өзгертуге келгенде, солай емес пе?
Dialogue: 0,0:10:19.16,0:10:22.04,jp.sub-ja,NTP,0,0,0,,Сенің басқалардан күшті одақтасың жоқ па?
Dialogue: 0,0:10:22.41,0:10:23.38,Style1,,0,0,0,,Кез келген жағдайда...
Dialogue: 0,0:10:22.51,0:10:23.48,jp.sub-ja,NTP,0,0,0,,Бұл не?
Dialogue: 0,0:10:23.38,0:10:24.37,Style1,,0,0,0,,...ол ме?
Dialogue: 0,0:10:23.50,0:10:24.53,jp.sub-ja,NTP,0,0,0,,Мүмкін?
Dialogue: 0,0:10:26.91,0:10:28.31,Style2,,0,0,0,,«Қуатты қозғалтқыш»
Dialogue: 0,0:10:30.42,0:10:32.91,Style1,,0,0,0,,Әрине жеткілікті.
Dialogue: 0,0:10:30.57,0:10:31.74,jp.sub-ja,NTP,0,0,0,,Күтілгендей
Dialogue: 0,0:10:47.47,0:10:50.07,Style2,,0,0,0,,«№3 ғылыми кабинет»
Dialogue: 0,0:10:50.07,0:10:51.06,Style2,,0,0,0,,«қараңғы бөлме мүмкіндіктері бар»
Dialogue: 0,0:10:55.71,0:10:59.38,Style1,,0,0,0,,Шам жарығында жыпылықтайтын алтын шашың...
Dialogue: 0,0:10:55.96,0:10:58.82,jp.sub-ja,NTP,0,0,0,,Шам жарығында тербелген алтын шашың
Dialogue: 0,0:10:59.38,0:11:01.72,Style1,,0,0,0,,Жылтыр, піл сүйегінен жасалған теріңіз...
Dialogue: 0,0:10:59.56,0:11:01.18,jp.sub-ja,NTP,0,0,0,,Жарқыраған піл сүйегі терісі
Dialogue: 0,0:11:01.72,0:11:06.39,Style1,,0,0,0,,Сенің күлкің, Гүлден де жұмбақ, Ай сәулесімен нұрланған...
Dialogue: 0,0:11:01.92,0:11:06.25,jp.sub-ja,NTP,0,0,0,,Ол күлімсіреу ай сәулесімен нұрланған жалғыз гүлден де жұмбақ.
Dialogue: 0,0:11:06.32,0:11:08.44,jp.sub-ja,NTP,0,0,0,,Иә, дәл солай...
Dialogue: 0,0:11:06.39,0:11:09.22,Style1,,0,0,0,,Иә, дерлік...
Dialogue: 0,0:11:12.39,0:11:16.28,jp.sub-ja,NTP,0,0,0,,Қарғыс атқан балауыз фигурасындай сұмдық түрмен
Dialogue: 0,0:11:12.39,0:11:16.73,Style1,,0,0,0,,...қарғыс атқан балауыз мүсін сияқты, зұлымдығыңмен-
Dialogue: 0,0:11:16.73,0:11:18.73,Style1,,0,0,0,,Қыңқылдауды қой.
Dialogue: 0,0:11:16.99,0:11:18.65,jp.sub-ja,NTP,0,0,0,,Басқа!
Dialogue: 0,0:11:18.65,0:11:22.59,jp.sub-ja,NTP,0,0,0,,Тонкура Бұл жолды саған кім үйретті?
Dialogue: 0,0:11:18.73,0:11:20.40,Style1,,0,0,0,,Сен ессіз!
Dialogue: 0,0:11:20.40,0:11:22.40,Style1,,0,0,0,,Ол жолды айт деп кім айтты!?
Dialogue: 0,0:11:22.40,0:11:26.74,Style1,,0,0,0,,Мен сізге қанша рет айтуым керек, оккульттік терминдерді қолдануға тыйым салынады!?
Dialogue: 0,0:11:22.59,0:11:26.45,jp.sub-ja,NTP,0,0,0,,Оккульттік терминдерге тыйым салынғанын неше рет айту керек?
Dialogue: 0,0:11:26.72,0:11:31.59,jp.sub-ja,NTP,0,0,0,,Дегенмен, менің сөздік қорым осы тектес нәрселермен шектеледі...
Dialogue: 0,0:11:26.74,0:11:31.47,Style1,,0,0,0,,B-бірақ менің сөздік қорым осы сөздермен шектелген.
Dialogue: 0,0:11:32.48,0:11:34.42,Style1,,0,0,0,,Менімен сөйлесуге де тыйым салынады!
Dialogue: 0,0:11:32.48,0:11:38.18,Style2,,0,0,0,,«Спартандық білім!»
Dialogue: 0,0:11:32.79,0:11:34.28,jp.sub-ja,NTP,0,0,0,,Кері сөйлесуге тыйым салынады.
Dialogue: 0,0:11:34.28,0:11:38.31,jp.sub-ja,NTP,0,0,0,,Князь кейіпкері ретінде мен әйелдікке оңайлықпен сылтау айта алмаймын.
Dialogue: 0,0:11:34.42,0:11:38.42,Style1,,0,0,0,,Князь кейіпкері мұндай сылтауды оңай ойлап таппайды!
Dialogue: 0,0:11:38.31,0:11:41.85,jp.sub-ja,NTP,0,0,0,,Жақсы. Көлеңкенің болғаны жақсы. Көлеңкенің болғаны жақсы.
Dialogue: 0,0:11:38.42,0:11:41.86,Style1,,0,0,0,,Есіңізде болсын, қара жағының болғаны жақсы.
Dialogue: 0,0:11:39.05,0:11:41.86,Style2,,0,0,0,,"Хмф!" «Троб!»
Dialogue: 0,0:11:41.86,0:11:44.99,Style2,,0,0,0,,«Демек, сен де жалғызсың ба? «Троб!»
Dialogue: 0,0:11:41.86,0:11:45.03,Style1,,0,0,0,,Жалғыз кейіпкерлер жас қыздармен де жақсы жұмыс істейді.
Dialogue: 0,0:11:41.92,0:11:44.90,jp.sub-ja,NTP,0,0,0,,Жалғыз кейіпкерлер жас қыздарға да айтарлықтай әсер етеді.
Dialogue: 0,0:11:44.92,0:11:48.92,jp.sub-ja,NTP,0,0,0,,Бірақ бұл күндері оккультизм мен қорқыныш туралы сөз жоқ.
Dialogue: 0,0:11:44.99,0:11:48.52,Style2,,0,0,0,,"*жөтел жөтел*"
Dialogue: 0,0:11:45.03,0:11:49.03,Style1,,0,0,0,,Бірақ бұл күндері оккультизм, сұмдық және сол сияқтылар сөзсіз!
Dialogue: 0,0:11:49.03,0:11:51.70,Style1,,0,0,0,,Мори-сенпай, тағы бір жаман сөзді қос!
Dialogue: 0,0:11:49.05,0:11:51.40,jp.sub-ja,NTP,0,0,0,,Мори-сенпай НГ сөздері қосылды
Dialogue: 0,0:11:51.70,0:11:54.04,Style1,,0,0,0,,Балауыз мүсін, солай ма?
Dialogue: 0,0:11:51.82,0:11:53.86,jp.sub-ja,NTP,0,0,0,,Балауыз фигурасы...
Dialogue: 0,0:11:54.04,0:11:56.04,Style1,,0,0,0,,Ренгекун шынымен оны жыртып жатыр, иә?
Dialogue: 0,0:11:54.16,0:11:55.86,jp.sub-ja,NTP,0,0,0,,Ренге-кун, сен ұшып бара жатырсың.
Dialogue: 0,0:11:56.01,0:11:57.60,jp.sub-ja,NTP,0,0,0,,Норинори, солай ма?
Dialogue: 0,0:11:56.04,0:11:57.37,Style1,,0,0,0,,Ол орамда.
Dialogue: 0,0:11:57.37,0:12:02.04,Style1,,0,0,0,,Мен бұл жолдар оның әпкесі үшін пайдалы болатынына сенімді емеспін.
Dialogue: 0,0:11:57.60,0:12:01.36,jp.sub-ja,NTP,0,0,0,,Әпкеңізге бұлай айту тиімді ме, білмеймін.
Dialogue: 0,0:12:02.04,0:12:04.05,Style1,,0,0,0,,Мырза, сіз жай ғана қарайсыз ба?
Dialogue: 0,0:12:02.11,0:12:03.63,jp.sub-ja,NTP,0,0,0,,Сіз жай қарап отырсыз.
Dialogue: 0,0:12:04.05,0:12:06.38,Style1,,0,0,0,,Жарайды, мен кейін қарғысқа ұшырағым келмейді.
Dialogue: 0,0:12:04.07,0:12:06.42,jp.sub-ja,NTP,0,0,0,,Өйткені кейін қарғысқа ұшырағым келмейді.
Dialogue: 0,0:12:06.38,0:12:10.72,Style1,,0,0,0,,Жарайды, сіз кейіпкерді өзгертетін жолдардың көпшілігін үйренген сияқтысыз.
Dialogue: 0,0:12:06.52,0:12:10.50,jp.sub-ja,NTP,0,0,0,,Міне, сіз таңба параметрлерін өзгертуге арналған көптеген жолдарды жаттап алған сияқтысыз.
Dialogue: 0,0:12:10.72,0:12:14.72,Style1,,0,0,0,,Менің ойымша, біз оған көшетін уақыт келді.
Dialogue: 0,0:12:10.81,0:12:13.88,jp.sub-ja,NTP,0,0,0,,Бүгін тағы барамын, жарай ма?
Dialogue: 0,0:12:14.08,0:12:15.90,jp.sub-ja,NTP,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:12:14.72,0:12:18.79,Style1,,0,0,0,,Күте тұрыңыз! Мен мұны істеуге әлі ерте!
Dialogue: 0,0:12:16.40,0:12:18.36,jp.sub-ja,NTP,0,0,0,,Бұл әлі де өте...
Dialogue: 0,0:12:18.79,0:12:21.82,Style1,,0,0,0,,Жаман сәуле!!
Dialogue: 0,0:12:18.93,0:12:22.89,jp.sub-ja,NTP,0,0,0,,Зұлым сәуле
Dialogue: 0,0:12:22.83,0:12:25.07,Style1,,0,0,0,,Жай фонарь сізді ренжітпесін!
Dialogue: 0,0:12:22.83,0:12:30.57,Style2,,0,0,0,,«Кәдімгі фонарь»
Dialogue: 0,0:12:22.89,0:12:25.12,jp.sub-ja,NTP,0,0,0,,Жай ғана фонарьмен үрейленбеңіз
Dialogue: 0,0:12:25.07,0:12:28.74,Style1,,0,0,0,,Жүйкеңізді жұлып алыңыз! Бұл сіз үшін физикалық проблема емес,
Dialogue: 0,0:12:25.36,0:12:26.68,jp.sub-ja,NTP,0,0,0,,Қызу
Dialogue: 0,0:12:26.76,0:12:31.03,jp.sub-ja,NTP,0,0,0,,Физикалық проблема жоқ, сондықтан бұл ішектің мәселесі.
Dialogue: 0,0:12:28.74,0:12:31.07,Style1,,0,0,0,,бұл ішектің проблемасы екенін білдіреді!
Dialogue: 0,0:12:31.07,0:12:35.10,Style1,,0,0,0,,Эдгар крестке жүйкесі мен ішегімен күресе алды, солай емес пе!?
Dialogue: 0,0:12:31.26,0:12:34.73,jp.sub-ja,NTP,0,0,0,,Тіпті Эдгар айқышты батылдықпен және батылдықпен безендірер еді.
Dialogue: 0,0:12:36.20,0:12:38.06,jp.sub-ja,NTP,0,0,0,,Менің ойымша, ол оккультизмді жоққа шығарды ...
Dialogue: 0,0:12:36.41,0:12:38.41,Style1,,0,0,0,,Мен сізді оккультизмнен бас тартты деп ойладым.
Dialogue: 0,0:12:38.18,0:12:39.78,jp.sub-ja,NTP,0,0,0,,Көркем әдебиет жақсы ма?
Dialogue: 0,0:12:38.41,0:12:41.42,Style1,,0,0,0,,Көркем әдебиет жақсы. Сән емес.
Dialogue: 0,0:12:39.78,0:12:41.07,jp.sub-ja,NTP,0,0,0,,Сән жоқ
Dialogue: 0,0:12:41.42,0:12:42.42,Style1,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:12:41.56,0:12:42.60,jp.sub-ja,NTP,0,0,0,,Бұл дұрыс
Dialogue: 0,0:12:42.42,0:12:44.02,Style1,,0,0,0,,Ал сен...
Dialogue: 0,0:12:42.72,0:12:43.87,jp.sub-ja,NTP,0,0,0,,Мен әрқашан
Dialogue: 0,0:12:44.02,0:12:45.98,jp.sub-ja,NTP,0,0,0,,Біртүрлі косплей киіп жүрсеңіз де.
Dialogue: 0,0:12:44.02,0:12:46.02,Style1,,0,0,0,,...ол әрқашан біртүрлі косплеймен айналысады.
Dialogue: 0,0:12:46.02,0:12:49.02,Style1,,0,0,0,,Бұл жолдарды айтуға сіз де бар жүрегіңізді салмайсыз.
Dialogue: 0,0:12:46.17,0:12:49.04,jp.sub-ja,NTP,0,0,0,,Жалпы айтқанда, менің жолдарымда көп жүрек жоқ.
Dialogue: 0,0:12:49.02,0:12:52.03,Style1,,0,0,0,,Тәжірибедегі серіктесіңізді Кирими-чан деп ойлаңыз.
Dialogue: 0,0:12:49.04,0:12:51.89,jp.sub-ja,NTP,0,0,0,,Мен Киримиді өзімнің жаттығу серіктесім деп санадым.
Dialogue: 0,0:12:52.03,0:12:56.86,Style1,,0,0,0,,Т-айтуға оңай, бірақ Киримидің беті ондай күл емес.
Dialogue: 0,0:12:52.11,0:12:54.12,jp.sub-ja,NTP,0,0,0,,Бұл туралы ...
Dialogue: 0,0:12:55.08,0:12:57.76,jp.sub-ja,NTP,0,0,0,,Кирими сондай жер бетінде...
Dialogue: 0,0:12:56.86,0:12:58.06,Style2,,0,0,0,,«Бұл шын мәнінде қоңыр түсті...»
Dialogue: 0,0:12:56.86,0:12:58.07,Style1,,0,0,0,,Т-айтуға оңай, бірақ Киримидің беті ондай күл емес.
Dialogue: 0,0:12:58.07,0:13:00.37,Style1,,0,0,0,,Менің оны естігім келмейді!
Dialogue: 0,0:12:58.12,0:12:59.80,jp.sub-ja,NTP,0,0,0,,Сұрақтар қойылмаған
Dialogue: 0,0:13:00.37,0:13:04.71,Style1,,0,0,0,,Жүрегіңнің көзімен қара. Жүрегіңнің көзі!
Dialogue: 0,0:13:00.48,0:13:02.36,jp.sub-ja,NTP,0,0,0,,Жүрек көзімен қараңыз
Dialogue: 0,0:13:02.77,0:13:04.24,jp.sub-ja,NTP,0,0,0,,Ақыл көзінде
Dialogue: 0,0:13:04.71,0:13:07.71,Style1,,0,0,0,,Иә! Мұның бәрі Кирими-чан үшін!
Dialogue: 0,0:13:04.83,0:13:07.32,jp.sub-ja,NTP,0,0,0,,Иә, бәрі Кирими-чан үшін.
Dialogue: 0,0:13:07.65,0:13:09.32,jp.sub-ja,NTP,0,0,0,,Егер сіз өз ойыңызды іске қоссаңыз
Dialogue: 0,0:13:07.71,0:13:09.38,Style1,,0,0,0,,Егер сіз өз ойыңызды іске асыра алсаңыз,
Dialogue: 0,0:13:09.38,0:13:13.71,Style1,,0,0,0,,Қуыршақ Кирими-чанға ұқсайтынына сенімдімін!
Dialogue: 0,0:13:09.61,0:13:13.36,jp.sub-ja,NTP,0,0,0,,Қуыршақтың нағыз Кирими-чанға ұқсайтынына сенімдімін.
Dialogue: 0,0:13:19.72,0:13:21.38,Style1,,0,0,0,,Міне, сэр!
Dialogue: 0,0:13:19.90,0:13:21.44,jp.sub-ja,NTP,0,0,0,,Иә мырза
Dialogue: 0,0:13:22.39,0:13:24.73,Style1,,0,0,0,,Мұны да дайындап қойдық.
Dialogue: 0,0:13:22.73,0:13:24.57,jp.sub-ja,NTP,0,0,0,,Мен де осындай нәрсе дайындадым
Dialogue: 0,0:13:24.46,0:13:28.40,Style2,,0,0,0,,«Жай ғана манекен»
Dialogue: 0,0:13:24.73,0:13:28.40,Style1,,0,0,0,,Өтінемін, осы Харухи қуыршағына махаббат сөздерін айтып көріңіз.
Dialogue: 0,0:13:24.94,0:13:28.23,jp.sub-ja,NTP,0,0,0,,Содан кейін осы Харухи қуыршаққа деген сүйіспеншілігіңіз туралы айтып көріңіз.
Dialogue: 0,0:13:28.40,0:13:30.66,Style2,,0,0,0,,«Өрнексіз»
Dialogue: 0,0:13:30.06,0:13:34.07,Style1,,0,0,0,,Т-бұл Харухи ме?
Dialogue: 0,0:13:30.29,0:13:33.68,jp.sub-ja,NTP,0,0,0,,Бұл...бұл...Харухи ме?
Dialogue: 0,0:13:33.98,0:13:36.12,jp.sub-ja,NTP,0,0,0,,Барлығы үлгі бойынша бірінші орында.
Dialogue: 0,0:13:34.07,0:13:36.56,Style1,,0,0,0,,Сіз әрқашан алдымен мысалмен көрсетуіңіз керек.
Dialogue: 0,0:13:45.68,0:13:50.21,Style1,,0,0,0,,Х-Харухи... Мен...
Dialogue: 0,0:13:45.72,0:13:49.64,jp.sub-ja,NTP,0,0,0,,Ха...Харухи I...
Dialogue: 0,0:13:52.85,0:13:54.05,Style2,,0,0,0,,«Ақылдың көзін белсендіру»
Dialogue: 0,0:13:56.84,0:13:57.85,jp.sub-ja,NTP,0,0,0,,Ол ешқашан да болмайды!
Dialogue: 0,0:13:57.02,0:13:58.75,Style1,,0,0,0,,Сенпай...
Dialogue: 0,0:14:00.36,0:14:02.70,Style1,,0,0,0,,Ахем...
Dialogue: 0,0:14:00.60,0:14:01.58,jp.sub-ja,NTP,0,0,0,,(Узуи) Онда мен оның басын керемет шоумендей кесіп тастаймын.
Dialogue: 0,0:14:02.19,0:14:05.37,jp.sub-ja,NTP,0,0,0,,Ах Харухи, шынымен... рас па?
Dialogue: 0,0:14:02.70,0:14:07.03,Style1,,0,0,0,,Х-Харухи!? Т-шын ба? Б-сен мұнда қашан келдің?
Dialogue: 0,0:14:05.48,0:14:07.26,jp.sub-ja,NTP,0,0,0,,Мен...мен...білмедім...
Dialogue: 0,0:14:07.03,0:14:10.71,Style1,,0,0,0,,Кирими-чан бүгін тағы клуб бөлмесіне келді.
Dialogue: 0,0:14:07.26,0:14:10.52,jp.sub-ja,NTP,0,0,0,,Кирими-чан бүгін тағы клуб бөлмесіне келді...
Dialogue: 0,0:14:10.71,0:14:13.71,Style1,,0,0,0,,Егер сізде осындай жиіркенішті істермен айналысуға уақытыңыз болса,
Dialogue: 0,0:14:10.88,0:14:13.44,jp.sub-ja,NTP,0,0,0,,Егер қорқынышты ойнауға уақытыңыз болса
Dialogue: 0,0:14:13.71,0:14:17.37,Style1,,0,0,0,,онда Кирими-чанмен біраз уақыт араласуға болады ма?
Dialogue: 0,0:14:13.95,0:14:17.13,jp.sub-ja,NTP,0,0,0,,Кирими-чанға жұмыс жасай аласыз ба?
Dialogue: 0,0:14:17.88,0:14:20.51,Style2,,0,0,0,,«Жеркенішті»
Dialogue: 0,0:14:18.30,0:14:20.51,jp.sub-ja,NTP,0,0,0,,К...қорқынышты!?
Dialogue: 0,0:14:18.38,0:14:20.98,Style1,,0,0,0,,R-итеруші?
Dialogue: 0,0:14:25.39,0:14:27.46,Style1,,0,0,0,,- Жібітуші... жексұрын... жексұрын... - Не болды, Харухи?
Dialogue: 0,0:14:25.52,0:14:26.80,jp.sub-ja,NTP,0,0,0,,Сені қашып құтылуға жібермеймін!
Dialogue: 0,0:14:26.48,0:14:29.10,jp.sub-ja,NTP,0,0,0,,Не, Харухи, сен балалармен жақсы емессің бе?
Dialogue: 0,0:14:27.46,0:14:29.72,Style1,,0,0,0,,- Жиренішті... ренжітетін... жиренішті... - Балалармен жақсы емессің бе?
Dialogue: 0,0:14:29.72,0:14:32.53,Style1,,0,0,0,,- Жиреншін... жиренішті... жиренішті... - Жоқ, мен балаларды да, ештеңені де ұнатпаймын,
Dialogue: 0,0:14:29.86,0:14:33.14,jp.sub-ja,NTP,0,0,0,,Жоқ, мен балаларды жек көрмеймін, бірақ...
Dialogue: 0,0:14:32.53,0:14:33.86,Style1,,0,0,0,,бірақ...
Dialogue: 0,0:14:33.74,0:14:35.86,jp.sub-ja,NTP,0,0,0,,Гари Цутому Көбірек
Dialogue: 0,0:14:33.86,0:14:35.90,Style1,,0,0,0,,Studyhound, көбірек!
Dialogue: 0,0:14:33.86,0:14:35.90,Style2,,0,0,0,,«Флешбэк»
Dialogue: 0,0:14:35.90,0:14:37.03,Style2,,0,0,0,,"Троб! Троб! Троб!" «Флешбэк»
Dialogue: 0,0:14:35.90,0:14:39.40,Style1,,0,0,0,,«Олардың бәрі қазір менің махаббат құлдарым.
Dialogue: 0,0:14:36.20,0:14:39.54,jp.sub-ja,NTP,0,0,0,,Олардың бәрі енді менің махаббаттың құлдарым.
Dialogue: 0,0:14:37.03,0:14:43.06,Style2,,0,0,0,,«Троб! Троб! Троб!" "Музыка бөлмесі №3"
Dialogue: 0,0:14:39.40,0:14:44.00,Style1,,0,0,0,,Енді мен бүгін кешке кімнің көңілін көтерейін?»
Dialogue: 0,0:14:39.78,0:14:43.57,jp.sub-ja,NTP,0,0,0,,Мені бүгін кешке кім шақыруы керек?
Dialogue: 0,0:14:44.00,0:14:46.01,Style1,,0,0,0,,Ол маған шамамен 50 томды оқытты
Dialogue: 0,0:14:44.23,0:14:48.20,jp.sub-ja,NTP,0,0,0,,Соңғы үш күнде мені 50-ге жуық қыздың мангасын дауыстап оқуға мәжбүр етті.
Шоджо мангасының
Dialogue: 0,0:14:46.01,0:14:49.01,Style1,,0,0,0,,соңғы үш күніне дейін.
Dialogue: 0,0:14:49.01,0:14:54.01,Style1,,0,0,0,,Ең бастысы, бұл заттар шынымен кері гаремдер мен азғындыққа толы.
Dialogue: 0,0:14:49.06,0:14:53.54,jp.sub-ja,NTP,0,0,0,,Кейбір жағдайларда бұл шынымен кері гарем және шарап пен ет орманы.
Dialogue: 0,0:14:54.01,0:14:56.11,Style1,,0,0,0,,Үлкен аға?
Dialogue: 0,0:14:54.08,0:14:55.28,jp.sub-ja,NTP,0,0,0,,Үлкен аға?
Dialogue: 0,0:15:00.30,0:15:02.44,jp.sub-ja,NTP,0,0,0,,Бұл бөлме қараңғы.
Dialogue: 0,0:15:00.35,0:15:02.95,Style1,,0,0,0,,Бұл бөлме тым қараңғы!
Dialogue: 0,0:15:04.31,0:15:08.52,jp.sub-ja,NTP,0,0,0,,Ах, Кирими-чан, мен саған бөлмеде күт дедім...
Dialogue: 0,0:15:04.36,0:15:08.70,Style1,,0,0,0,,Әй, Кирими-чан! Мен саған басқа бөлмеде күт дедім.
Dialogue: 0,0:15:08.70,0:15:11.37,Style1,,0,0,0,,Ой, не болды, не болды?
Dialogue: 0,0:15:08.72,0:15:10.92,jp.sub-ja,NTP,0,0,0,,Иә, не болды?
Dialogue: 0,0:15:11.28,0:15:15.46,jp.sub-ja,NTP,0,0,0,,Йо-чиёчи, қарашы, мен енді қорықпаймын.
Dialogue: 0,0:15:11.37,0:15:13.70,Style1,,0,0,0,,Міне, сонда, көрдіңіз бе?
Dialogue: 0,0:15:13.70,0:15:16.03,Style1,,0,0,0,,Қорқатын ештеңе жоқ.
Dialogue: 0,0:15:20.00,0:15:20.68,jp.sub-ja,NTP,0,0,0,,Міне
Dialogue: 0,0:15:29.05,0:15:31.05,Style1,,0,0,0,,Сенпай?
Dialogue: 0,0:15:29.23,0:15:30.00,jp.sub-ja,NTP,0,0,0,,Сенпай?
Dialogue: 0,0:15:31.05,0:15:33.39,Style1,,0,0,0,,Мен сымбатты, ханзадалық ағамын...
Dialogue: 0,0:15:31.06,0:15:43.79,jp.sub-ja,NTP,0,0,0,,Мен тамаша ханзаданың ағасымын.
Dialogue: 0,0:15:33.39,0:15:36.06,Style1,,0,0,0,,Мен сымбатты, князьдік ағамын...
Dialogue: 0,0:15:36.06,0:15:44.00,Style1,,0,0,0,,Мен сымбатты, ханзадалық ағамын...
Dialogue: 0,0:15:44.00,0:15:45.67,Style1,,0,0,0,,Мен жарықтан қорықпаймын!
Dialogue: 0,0:15:44.03,0:15:45.86,jp.sub-ja,NTP,0,0,0,,Мен жарықтан қорықпаймын
Dialogue: 0,0:15:45.67,0:15:48.00,Style1,,0,0,0,,Өз-өзіне зұлымдық сәулесі!!
Dialogue: 0,0:15:45.86,0:15:48.08,jp.sub-ja,NTP,0,0,0,,Өз-өзіне зұлымдық сәулесі
Dialogue: 0,0:15:49.00,0:15:51.34,Style1,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:15:49.04,0:15:50.01,jp.sub-ja,NTP,0,0,0,,Мен мұны істедім
Dialogue: 0,0:15:51.34,0:15:56.68,Style1,,0,0,0,,Некозава-сенпай ақыры өзіне қол шамын жаға алды!
Dialogue: 0,0:15:51.55,0:15:56.23,jp.sub-ja,NTP,0,0,0,,Некозава-сенпай ақыры өзіне қол шамын жарқырата алады
Dialogue: 0,0:15:56.55,0:15:58.35,jp.sub-ja,NTP,0,0,0,,Браво Браво
Dialogue: 0,0:15:56.68,0:15:58.35,Style1,,0,0,0,,Браво, браво.
Dialogue: 0,0:15:58.35,0:16:00.01,Style1,,0,0,0,,Некозава-сенпай...
Dialogue: 0,0:15:58.40,0:15:59.95,jp.sub-ja,NTP,0,0,0,,Некозава Сенпай
Dialogue: 0,0:16:00.01,0:16:03.68,Style1,,0,0,0,,Сіз мұны жасадыңыз! Кирими-чанның да қатты қуанатынына сенімдімін!
Dialogue: 0,0:16:00.17,0:16:03.36,jp.sub-ja,NTP,0,0,0,,Сіз мұны істедіңіз. Кирими-чанның да бақытты болатынына сенімдімін.
Dialogue: 0,0:16:03.68,0:16:08.55,Style1,,0,0,0,,Қарашы, Кирими-чан. Бұл сіздің нағыз Үлкен ағаңыз.
Dialogue: 0,0:16:03.92,0:16:05.48,jp.sub-ja,NTP,0,0,0,,Қарашы, Кирими-чан
Dialogue: 0,0:16:06.20,0:16:08.20,jp.sub-ja,NTP,0,0,0,,Бұл менің нағыз ағам.
Dialogue: 0,0:16:06.49,0:16:07.82,Style2,,0,0,0,,«Бұл»
Dialogue: 0,0:16:12.97,0:16:14.56,jp.sub-ja,NTP,0,0,0,,Үлкен аға
Dialogue: 0,0:16:13.03,0:16:14.70,Style1,,0,0,0,,Үлкен аға!
Dialogue: 0,0:16:14.69,0:16:15.75,jp.sub-ja,NTP,0,0,0,,Кирими
Dialogue: 0,0:16:14.70,0:16:16.39,Style1,,0,0,0,,Кирими!
Dialogue: 0,0:16:18.03,0:16:22.70,Style1,,0,0,0,,Мм, сіз жай ғана мәселені қиындатып жатырсыз, сондықтан мұны тоқтата аласыз ба?
Dialogue: 0,0:16:18.23,0:16:22.62,jp.sub-ja,NTP,0,0,0,,Мм, мұндай нәрсе күрделене түседі, сондықтан сіз оны тоқтата аласыз.
Dialogue: 0,0:16:22.70,0:16:24.71,Style1,,0,0,0,,Иә? Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:16:22.95,0:16:24.77,jp.sub-ja,NTP,0,0,0,,Не? бірдеңе дедіңіз бе
Dialogue: 0,0:16:24.71,0:16:27.37,Style1,,0,0,0,,Бұл ештеңе болмады.
Dialogue: 0,0:16:24.88,0:16:26.47,jp.sub-ja,NTP,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:16:27.37,0:16:29.14,Style1,,0,0,0,,Кирими...
Dialogue: 0,0:16:27.42,0:16:28.26,jp.sub-ja,NTP,0,0,0,,Кирими
Dialogue: 0,0:16:33.31,0:16:36.68,Style2,,0,0,0,,«Айтылмайтын террор»
Dialogue: 0,0:16:39.72,0:16:41.45,Style1,,0,0,0,,Кирими!
Dialogue: 0,0:16:39.94,0:16:40.60,jp.sub-ja,NTP,0,0,0,,Кирими
Dialogue: 0,0:16:44.99,0:16:46.66,Style1,,0,0,0,,Сол зұлым сәуле дәл қазір...
Dialogue: 0,0:16:44.99,0:16:46.71,jp.sub-ja,NTP,0,0,0,,Қазіргі зұлым сәуле
Dialogue: 0,0:16:46.66,0:16:49.33,Style1,,0,0,0,,...өте қорқынышты болған шығар, иә?
Dialogue: 0,0:16:46.96,0:16:48.71,jp.sub-ja,NTP,0,0,0,,Бұл қорқынышты болса керек.
Dialogue: 0,0:16:49.33,0:16:51.13,Style1,,0,0,0,,Кирими...
Dialogue: 0,0:16:49.49,0:16:50.36,jp.sub-ja,NTP,0,0,0,,Кирими…
Dialogue: 0,0:16:53.67,0:16:56.00,Style1,,0,0,0,,Некозава-сенпай...
Dialogue: 0,0:16:53.76,0:16:55.22,jp.sub-ja,NTP,0,0,0,,Некозава Сенпай
Dialogue: 0,0:16:58.67,0:17:00.34,Style1,,0,0,0,,Жеткілікті.
Dialogue: 0,0:16:58.74,0:17:00.27,jp.sub-ja,NTP,0,0,0,,Жетеді.
Dialogue: 0,0:17:00.34,0:17:02.68,Style1,,0,0,0,,Мен арнайы дайындықтан өтсем де,
Dialogue: 0,0:17:00.64,0:17:02.88,jp.sub-ja,NTP,0,0,0,,Арнайы дайындық жоқ
Dialogue: 0,0:17:02.68,0:17:07.68,Style1,,0,0,0,,Кирими мені қабылдайтынына кепілдік жоқ...
Dialogue: 0,0:17:02.88,0:17:06.16,jp.sub-ja,NTP,0,0,0,,Кирими мені қабылдайтынына кепілдік жоқ.
Dialogue: 0,0:17:07.68,0:17:10.02,Style1,,0,0,0,,Кирими мені үлкен ағасы етіп қойғаннан гөрі,
Dialogue: 0,0:17:07.99,0:17:09.81,jp.sub-ja,NTP,0,0,0,,Осындай ағадан Кирими де артық.
Dialogue: 0,0:17:09.95,0:17:12.88,jp.sub-ja,NTP,0,0,0,,Аға ретінде сіздің орныңызды Су Кун басса жақсы болар еді...
Dialogue: 0,0:17:10.02,0:17:13.48,Style1,,0,0,0,,Суукун, сен оның орнына ағасы болуың керек.
Dialogue: 0,0:17:16.02,0:17:20.69,Style1,,0,0,0,,Сен қыздың көргісі келетін адамсың, солай ма?
Dialogue: 0,0:17:16.10,0:17:18.77,jp.sub-ja,NTP,0,0,0,,Қыз шынымен көргісі келетін сенсің.
Dialogue: 0,0:17:20.69,0:17:25.32,Style1,,0,0,0,,Әпкеңді жақсы көрсең, өлтіріп кетсе де, жігеріңді көрсет!
Dialogue: 0,0:17:20.84,0:17:22.03,jp.sub-ja,NTP,0,0,0,,Егер сіздің әпкеңіз маңызды болса
Dialogue: 0,0:17:22.61,0:17:24.74,jp.sub-ja,NTP,0,0,0,,Көбірек өлуге дайын болу арқылы өзіңізді көрсетіңіз.
Dialogue: 0,0:17:31.04,0:17:34.71,Style1,,0,0,0,,Иә? Әпкең әлі аулада.
Dialogue: 0,0:17:31.14,0:17:34.36,jp.sub-ja,NTP,0,0,0,,Әй, әпке, ол әлі аулада.
Dialogue: 0,0:17:34.70,0:17:36.20,jp.sub-ja,NTP,0,0,0,,Менің жанымда бірдеңе бар ма деп ойлаймын.
Dialogue: 0,0:17:34.71,0:17:36.71,Style1,,0,0,0,,Оның жанында бір нәрсе бар...
Dialogue: 0,0:17:36.71,0:17:39.71,Style1,,0,0,0,,Ой, бұл мысық.
Dialogue: 0,0:17:36.75,0:17:38.00,jp.sub-ja,NTP,0,0,0,,А, мысық?
Dialogue: 0,0:17:39.71,0:17:41.72,Style1,,0,0,0,,Сіздің отбасыңыз мысықтарды жақсы көреді.
Dialogue: 0,0:17:39.72,0:17:41.57,jp.sub-ja,NTP,0,0,0,,Мысық сүйетін отбасынан күткендей
Dialogue: 0,0:17:41.72,0:17:44.32,Style1,,0,0,0,,Сіз тіпті қаңғыбас мысықтарды да жылытасыз.
Dialogue: 0,0:17:41.78,0:17:43.84,jp.sub-ja,NTP,0,0,0,,Тіпті қаңғыбас мысықтар да маған оңай жабысады.
Dialogue: 0,0:17:44.07,0:17:45.21,jp.sub-ja,NTP,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:17:44.32,0:17:45.65,Style1,,0,0,0,,Эбису
Dialogue: 0,0:17:45.48,0:17:47.99,jp.sub-ja,NTP,0,0,0,,Некозава отбасы мысықтарға қанша табынса да,
Dialogue: 0,0:17:45.65,0:17:48.66,Style1,,0,0,0,,Некозава отбасы мысықтарды қалай құрметтейтініне қарамастан,
Dialogue: 0,0:17:48.66,0:17:51.33,Style1,,0,0,0,,оккультизм сияқты нәрсе жоқ
Dialogue: 0,0:17:48.69,0:17:51.44,jp.sub-ja,NTP,0,0,0,,Сондықтан қаңғыбас мысықтармен достасуға болады.
Dialogue: 0,0:17:51.33,0:17:54.66,Style1,,0,0,0,,оның қаңғыбас мысықпен сыпайы болуы мүмкін емес пе?
Dialogue: 0,0:17:51.48,0:17:54.08,jp.sub-ja,NTP,0,0,0,,Мұндай оккультизмнің болуы мүмкін емес, солай ма?
Dialogue: 0,0:17:54.66,0:17:57.67,Style1,,0,0,0,,Кирими жануарлардан қорқады!
Dialogue: 0,0:17:55.00,0:17:57.05,jp.sub-ja,NTP,0,0,0,,Кирими жануарларды ұнатпайды.
Dialogue: 0,0:17:57.67,0:18:01.69,Style1,,0,0,0,,Оның ең қорқатыны - тірі мысықтар!
Dialogue: 0,0:17:57.84,0:18:01.28,jp.sub-ja,NTP,0,0,0,,Олардың ішіндегі ең қорқыныштысы тірі мысықтар.
Dialogue: 0,0:18:06.93,0:18:08.40,jp.sub-ja,NTP,0,0,0,,Кирими
Dialogue: 0,0:18:07.01,0:18:08.34,Style1,,0,0,0,,Кирими!!
Dialogue: 0,0:18:08.34,0:18:09.34,Style1,,0,0,0,,Некозава-сенпай!
Dialogue: 0,0:18:08.43,0:18:09.38,jp.sub-ja,NTP,0,0,0,,Некозава Сенпай
Dialogue: 0,0:18:09.34,0:18:11.54,Style1,,0,0,0,,О, жоқ! Ол тіпті капюшон киген жоқ!
Dialogue: 0,0:18:09.59,0:18:11.50,jp.sub-ja,NTP,0,0,0,,Тіпті капюшонсыз...
Dialogue: 0,0:18:16.68,0:18:18.35,Style1,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:18:16.81,0:18:17.93,jp.sub-ja,NTP,0,0,0,,Маған көмектесіңіз...
Dialogue: 0,0:18:19.35,0:18:21.08,Style1,,0,0,0,,Кирими!
Dialogue: 0,0:18:19.42,0:18:20.78,jp.sub-ja,NTP,0,0,0,,Кирими
Dialogue: 0,0:18:23.69,0:18:25.89,Style1,,0,0,0,,Кирими!!
Dialogue: 0,0:18:23.83,0:18:25.59,jp.sub-ja,NTP,0,0,0,,Кирими
Dialogue: 0,0:18:35.61,0:18:37.85,jp.sub-ja,NTP,0,0,0,,Үлкен аға
Dialogue: 0,0:18:35.70,0:18:38.10,Style1,,0,0,0,,Үлкен аға!
Dialogue: 0,0:18:43.71,0:18:46.05,Style1,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:18:43.91,0:18:45.37,jp.sub-ja,NTP,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,0:18:46.05,0:18:48.88,Style1,,0,0,0,,Бұл менің арнайы дайындығымның нәтижесі.
Dialogue: 0,0:18:46.18,0:18:48.48,jp.sub-ja,NTP,0,0,0,,Бұл менің арнайы дайындығымның нәтижесі.
Dialogue: 0,0:18:50.05,0:18:54.58,Style1,,0,0,0,,Көрдің бе, Кирими? Енді бұл жаман мысықтан қорқудың қажеті жоқ.
Dialogue: 0,0:18:50.25,0:18:52.23,jp.sub-ja,NTP,0,0,0,,Қарашы, Кирими, мен енді қорықпаймын.
Dialogue: 0,0:18:52.72,0:18:54.13,jp.sub-ja,NTP,0,0,0,,Мына жаман мысық
Dialogue: 0,0:18:56.39,0:19:03.16,Style1,,0,0,0,,Осы қарғыс қуыршақтың күшімен Белзенеф... қарғыс айтамын... қарғыс...
Dialogue: 0,0:18:56.47,0:18:59.68,jp.sub-ja,NTP,0,0,0,,Осы қарғыс атқан қуыршақ Белзеневтің күшімен...
Dialogue: 0,0:19:00.00,0:19:02.31,jp.sub-ja,NTP,0,0,0,,Қарғыс... қарғыс...
Dialogue: 0,0:19:22.02,0:19:23.95,Style2,,0,0,0,,«№3 музыкалық кабинет» «Бірнеше күннен кейін»
Dialogue: 0,0:19:30.76,0:19:32.76,Style1,,0,0,0,,Некозава-сенпай...
Dialogue: 0,0:19:31.02,0:19:32.47,jp.sub-ja,NTP,0,0,0,,Некозава Сенпай
Dialogue: 0,0:19:32.68,0:19:35.91,jp.sub-ja,NTP,0,0,0,,Мен сол кезде өмір бойы күн сәулесін алған шығармын.
Dialogue: 0,0:19:32.76,0:19:36.10,Style1,,0,0,0,,Ол сол күні өмір бойы күн сәулесін алған шығар.
Dialogue: 0,0:19:36.10,0:19:40.43,Style1,,0,0,0,,Және ол жаттығу алдындағы жағдайына қайта оралу арқылы жауап берді.
Dialogue: 0,0:19:36.34,0:19:40.21,jp.sub-ja,NTP,0,0,0,,Реакция арнайы дайындықтан бұрын мемлекетке оралу болды.
Dialogue: 0,0:19:40.43,0:19:41.77,Style1,,0,0,0,,Ал, жақсы,
Dialogue: 0,0:19:40.52,0:19:45.64,jp.sub-ja,NTP,0,0,0,,Ақыр соңында, сіз тағы да тітіркендіргіш қара киім киіп жүрсіз.
Dialogue: 0,0:19:41.77,0:19:46.17,Style1,,0,0,0,,бұл оның неге сол күңгірт қара киімді қайтадан кигенін түсіндіреді.
Dialogue: 0,0:19:48.04,0:19:49.70,Style1,,0,0,0,,Бірақ бәрібір...
Dialogue: 0,0:19:48.32,0:19:49.04,jp.sub-ja,NTP,0,0,0,,Бірақ…
Dialogue: 0,0:20:25.65,0:20:29.28,jp.sub-ja,NTP,0,0,0,,Құбыжық көрінсе де, жарайды
Dialogue: 0,0:20:25.75,0:20:29.42,Style1,,0,0,0,,Енді, тіпті құбыжықтар пайда болса да, менде бәрі жақсы болады.
Dialogue: 0,0:20:29.42,0:20:32.99,Style1,,0,0,0,,Енді Киримидің үлкен ағасы бар,
Dialogue: 0,0:20:29.64,0:20:34.07,jp.sub-ja,NTP,0,0,0,,Өйткені Кирими күн астында секірсе де ұнатпайды.
Dialogue: 0,0:20:32.99,0:20:34.42,Style1,,0,0,0,,оны қорғау үшін кім күреседі,
Dialogue: 0,0:20:34.42,0:20:39.62,Style1,,0,0,0,,ол соншалықты қорқатын күннің астында серуендеуді білдірсе де.
Dialogue: 0,0:20:34.46,0:20:39.34,jp.sub-ja,NTP,0,0,0,,Киримиді қорғайтын және ол үшін күресетін ханзада бар.
Dialogue: 0,0:20:40.89,0:20:42.55,jp.sub-ja,NTP,0,0,0,,Мен тәттілерді жақсы көремін
Dialogue: 0,0:20:40.93,0:20:42.59,Style1,,0,0,0,,Мен тәттілерді жақсы көремін!
Dialogue: 0,0:20:42.55,0:20:44.93,jp.sub-ja,NTP,0,0,0,,Бал-сенпай, қуыс болса да, білмейсің.
Dialogue: 0,0:20:42.59,0:20:44.93,Style1,,0,0,0,,Жаным, сенде қуыстар болуы мүмкін.
Dialogue: 0,0:20:44.93,0:20:45.60,Style1,,0,0,0,,Ой!
Dialogue: 0,0:20:44.93,0:20:45.63,jp.sub-ja,NTP,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:20:45.60,0:20:46.93,Style1,,0,0,0,,Мен не айтып бітірдім?
Dialogue: 0,0:20:45.63,0:20:46.77,jp.sub-ja,NTP,0,0,0,,Мен барған жақтан
Dialogue: 0,0:20:46.77,0:20:47.92,jp.sub-ja,NTP,0,0,0,,Бұл менің жауапкершілігім.
Dialogue: 0,0:20:46.93,0:20:48.27,Style1,,0,0,0,,Мен жауаптымын.
Dialogue: 0,0:20:48.27,0:20:50.94,Style1,,0,0,0,,Келесі жолы «Бал сенпайдың үш ащы күні»
Dialogue: 0,0:20:50.63,0:20:52.92,jp.sub-ja,NTP,0,0,0,,Оуран орта мектебінің жүргізуші клубы Келесі аптада да
Dialogue: 0,0:20:50.94,0:20:54.89,Style1,,0,0,0,,Сізді келесі аптада Оуран орта мектебінің хост клубы күтеді!
Dialogue: 0,0:20:52.92,0:20:54.57,jp.sub-ja,NTP,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:20:56.39,0:21:02.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
