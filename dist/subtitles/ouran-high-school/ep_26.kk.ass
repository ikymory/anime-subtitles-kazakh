Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.14,0:00:10.14,staff-ja,,0,0,0,,Жапония Маки
Dialogue: 0,0:00:09.92,0:00:11.25,Style1,,0,0,0,,Шекара сызықтары?
Dialogue: 0,0:00:12.98,0:00:15.98,staff-ja,,0,0,0,,Syura
Dialogue: 0,0:00:13.76,0:00:15.93,Style1,,0,0,0,,Сіз таңғы ас ішпейсіз бе?
Dialogue: 0,0:00:15.93,0:00:17.26,Style1,,0,0,0,,мм-мм.
Dialogue: 0,0:00:16.40,0:00:19.57,staff-ja,,0,0,0,,Хагакуре аудармасы
Dialogue: 0,0:00:18.43,0:00:21.73,Style1,,0,0,0,,Жарайды, мен кеттім.
Dialogue: 0,0:00:19.98,0:00:22.78,staff-ja,,0,0,0,,Mam
Dialogue: 0,0:00:24.04,0:00:26.70,Style2,,0,0,0,,«Мектеп жәрмеңкесі 2-күн - негізгі жәрмеңке»
Dialogue: 0,0:00:24.91,0:00:28.16,staff-ja,,0,0,0,,Сабақ кестесі Қара мысық пен сиыр қыз
Dialogue: 0,0:00:24.91,0:00:28.16,staff-ja,,0,0,0,,Наксияның әкімшілік жүйесі
Dialogue: 0,0:00:27.37,0:00:29.54,Style2,,0,0,0,,«Орталық ғимарат салоны»
Dialogue: 0,0:00:29.91,0:00:31.24,jp.sub-ja,,0,0,0,,Мен таңғы ас ішпеймін.
Dialogue: 0,0:00:29.91,0:00:33.54,staff-ja,,0,0,0,,OP&ED Hagakure
Dialogue: 0,0:00:29.91,0:00:33.54,staff-ja,,0,0,0,,Сюра
Dialogue: 0,0:00:29.91,0:00:33.68,Style2,,0,0,0,,«Хост клубы көпшілікке бизнес үшін ашық»
Dialogue: 0,0:00:29.91,0:00:33.79,Default11-ja,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:00:34.35,0:00:36.88,Style1,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:00:34.58,0:00:37.23,jp.sub-ja,,0,0,0,,Мен барамын.
Dialogue: 0,0:00:34.62,0:00:35.34,jp.sub-ja,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:00:36.88,0:00:40.95,Style1,,0,0,0,,Сіз Отори отбасының ұлдарының бірісіз, солай ма?
Dialogue: 0,0:00:37.11,0:00:40.35,jp.sub-ja,,0,0,0,,Сіз Отори отбасының ұлысыз.
Dialogue: 0,0:00:40.95,0:00:43.29,Style1,,0,0,0,,Бірақ үшінші ұл ретінде қанша күрессең де,
Dialogue: 0,0:00:41.28,0:00:44.75,jp.sub-ja,,0,0,0,,Бірақ үшінші ұл қанша тырысса да отбасын мұра ете алмайды.
Dialogue: 0,0:00:43.29,0:00:45.66,Style1,,0,0,0,,сіз ешқашан отбасының мұрагері бола алмайсыз.
Dialogue: 0,0:00:45.66,0:00:48.15,Style1,,0,0,0,,Бүгін нені қалайсыз?
Dialogue: 0,0:00:45.99,0:00:47.43,jp.sub-ja,,0,0,0,,Бүгін ше?
Dialogue: 0,0:00:51.56,0:00:55.90,Style1,,0,0,0,,Харухи Фудзиоканың қарызының қанша бөлігі қалды?
Dialogue: 0,0:00:51.89,0:00:55.25,jp.sub-ja,,0,0,0,,Харухи Фудзиоканың қанша қарызы қалды?
Dialogue: 0,0:00:59.07,0:01:00.40,Style1,,0,0,0,,Харухи...
Dialogue: 0,0:00:59.30,0:00:59.76,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:01:01.91,0:01:03.74,Style1,,0,0,0,,Сізге сұрау жіберілді.
Dialogue: 0,0:01:02.25,0:01:02.90,jp.sub-ja,,0,0,0,,Сіздің кандидатураңыз.
Dialogue: 0,0:01:06.91,0:01:08.75,Style1,,0,0,0,,Сіздің рұқсатыңыз бойынша.
Dialogue: 0,0:01:07.06,0:01:08.03,jp.sub-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:08.75,0:01:13.25,Style1,,0,0,0,,Тамаки сіз үшін өте жұмсақ болып көрінді.
Dialogue: 0,0:01:09.09,0:01:12.41,jp.sub-ja,,0,0,0,,Тамаки сізді қатты жақсы көретін сияқты.
Dialogue: 0,0:01:13.25,0:01:17.59,Style1,,0,0,0,,Сіз қызғанышпен айтасыз ба?
Dialogue: 0,0:01:13.40,0:01:16.44,jp.sub-ja,,0,0,0,,Бұл сіздің қызғанышыңызды білдіре ме?
Dialogue: 0,0:01:17.59,0:01:20.26,Style1,,0,0,0,,Ал, тыңдаңдар.
Dialogue: 0,0:01:17.84,0:01:19.18,jp.sub-ja,,0,0,0,,О, мен айтайын.
Dialogue: 0,0:01:20.26,0:01:22.76,Style1,,0,0,0,,Тамаки келмейді.
Dialogue: 0,0:01:20.59,0:01:21.99,jp.sub-ja,,0,0,0,,Тамаки келмейді.
Dialogue: 0,0:01:22.76,0:01:27.10,Style1,,0,0,0,,Мен оған Хост клубында енді бетін көрсетпеуді бұйырдым.
Dialogue: 0,0:01:23.03,0:01:26.58,jp.sub-ja,,0,0,0,,Мен саған енді үй иесінің клубына бетіңді көрсетпеуді бұйырдым.
Dialogue: 0,0:01:28.94,0:01:32.27,Style1,,0,0,0,,Тама-чанға не болды деп ойлаймын.
Dialogue: 0,0:01:29.21,0:01:31.02,jp.sub-ja,,0,0,0,,Тама-чан, не болды?
Dialogue: 0,0:01:32.27,0:01:36.61,Style1,,0,0,0,,Мен оның кешегі жоғары мәртебелі мәлімдемесіне сенбеймін.
Dialogue: 0,0:01:32.68,0:01:34.22,jp.sub-ja,,0,0,0,,Сіздің кешегі сөздеріңіз бен іс-әрекеттеріңізге қатысты...
Dialogue: 0,0:01:35.02,0:01:36.22,jp.sub-ja,,0,0,0,,Мен оны қабылдай алмаймын.
Dialogue: 0,0:01:39.45,0:01:44.22,Style1,,0,0,0,,Мен осында Леди Эклэр Тоннермен құда түсуді шештім.
Dialogue: 0,0:01:39.72,0:01:43.33,jp.sub-ja,,0,0,0,,Мен осы Мисс Эклэр Тоннермен құда түсуді шештім.
Dialogue: 0,0:01:44.22,0:01:50.05,Style1,,0,0,0,,Одан әрі Хост клубы Оуран жәрмеңкесінен кейін таратылады.
Dialogue: 0,0:01:44.51,0:01:47.90,jp.sub-ja,,0,0,0,,Содан кейін, осы Уран фестивалі аяқтала салысымен, қабылдаушы клуб өтеді
Dialogue: 0,0:01:48.78,0:01:49.40,jp.sub-ja,,0,0,0,,Тарту
Dialogue: 0,0:01:54.23,0:01:57.23,Style1,,0,0,0,,Келіңіздер, енді бос әңгіме болмаңыз.
Dialogue: 0,0:01:54.43,0:01:56.84,jp.sub-ja,,0,0,0,,Қараңызшы, мен бос сөз айтып тұрғаным жоқ.
Dialogue: 0,0:01:57.23,0:01:59.57,Style1,,0,0,0,,Біздің қонақтар күтіп тұр.
Dialogue: 0,0:01:57.46,0:01:59.00,jp.sub-ja,,0,0,0,,Біздің тұтынушылар сізді күтуде.
Dialogue: 0,0:01:59.57,0:02:02.34,Style1,,0,0,0,,Қандай кереметсің, Кёя-сенпай.
Dialogue: 0,0:01:59.85,0:02:01.79,jp.sub-ja,,0,0,0,,Керемет, Кёуя-сенпай.
Dialogue: 0,0:02:02.34,0:02:05.91,Style1,,0,0,0,,Қонақтарды мүмкіндігінше қуантамыз
Dialogue: 0,0:02:02.71,0:02:05.49,jp.sub-ja,,0,0,0,,Осы қабылдаушы клубты тамашалауға келген тұтынушыларға
Dialogue: 0,0:02:05.91,0:02:08.58,Style1,,0,0,0,,Хост клубына көңіл көтеру үшін келгендер.
Dialogue: 0,0:02:06.15,0:02:07.99,jp.sub-ja,,0,0,0,,Мүмкіндігінше көп беріңіз
Dialogue: 0,0:02:08.58,0:02:12.35,Style1,,0,0,0,,Дәл қазір бұл ең маңызды нәрсе.
Dialogue: 0,0:02:08.91,0:02:10.70,jp.sub-ja,,0,0,0,,Дәл қазір бұл ең маңызды нәрсе
Dialogue: 0,0:02:12.35,0:02:13.58,Style1,,0,0,0,,Ол дұрыс, Као Чан.
Dialogue: 0,0:02:12.74,0:02:13.76,jp.sub-ja,,0,0,0,,Дұрыс айтасың, Каору-чан.
Dialogue: 0,0:02:13.58,0:02:14.91,Style1,,0,0,0,,Не істеп жатырсың, Бал-сенпай!?
Dialogue: 0,0:02:13.85,0:02:15.21,jp.sub-ja,,0,0,0,,Не істеп жатырсың, Бал-сенпай?
Dialogue: 0,0:02:14.91,0:02:15.92,Style1,,0,0,0,,Кеттік, Хикару.
Dialogue: 0,0:02:15.21,0:02:16.00,jp.sub-ja,,0,0,0,,Кеттік, Хикари
Dialogue: 0,0:02:15.92,0:02:17.75,Style1,,0,0,0,,Тоқта, Мори-сенпай...
Dialogue: 0,0:02:16.00,0:02:17.33,jp.sub-ja,,0,0,0,,Эй, Мори-сенпай
Dialogue: 0,0:02:26.26,0:02:29.25,Style1,,0,0,0,,Ұзақ уақыт бойы жасаған жұмысыңыз үшін рахмет, Харухи.
Dialogue: 0,0:02:26.63,0:02:28.71,jp.sub-ja,,0,0,0,,Сіз ұзақ уақыт бойы көп жұмыс істедіңіз, Харухи.
Dialogue: 0,0:02:30.76,0:02:35.10,Style1,,0,0,0,,Леди Эклэрдің өтінішімен сіздің квотаңыз орындалды.
Dialogue: 0,0:02:31.10,0:02:34.23,jp.sub-ja,,0,0,0,,Мисс Эклэрдің ағымдағы тағайындалуымен квотаға қол жеткізілді.
Dialogue: 0,0:02:35.10,0:02:38.94,Style1,,0,0,0,,Сіз сындырған Ренессанс вазасының қарызы енді жойылды.
Dialogue: 0,0:02:35.34,0:02:38.02,jp.sub-ja,,0,0,0,,Рененің вазасын сындырғаны үшін барлық қарыздар жойылды.
Dialogue: 0,0:02:38.94,0:02:42.27,Style1,,0,0,0,,Сіз кез келген уақытта хост болудан бас тарта аласыз.
Dialogue: 0,0:02:39.28,0:02:41.31,jp.sub-ja,,0,0,0,,Сіз кез келген уақытта хост болудан бас тарта аласыз.
Dialogue: 0,0:03:08.07,0:03:11.24,Style1,,0,0,0,,Жас кезіңізде сол жерде деген елес болуы мүмкін
Dialogue: 0,0:03:08.36,0:03:11.77,jp.sub-ja,,0,0,0,,Жас кезіңізде сізде уақыт көп деген елес пайда болады.
Dialogue: 0,0:03:11.24,0:03:14.24,Style1,,0,0,0,,әлемде барлық уақытта, бірақ шын мәнінде олай емес.
Dialogue: 0,0:03:12.40,0:03:13.65,jp.sub-ja,,0,0,0,,Іс жүзінде жоқ.
Dialogue: 0,0:03:14.24,0:03:17.73,Style1,,0,0,0,,Құнды емес нәрселерге уақытыңызды босқа өткізбеңіз!
Dialogue: 0,0:03:14.47,0:03:17.25,jp.sub-ja,,0,0,0,,Уақытыңызды түкке тұрғысыз нәрселерге жұмсамаңыз
Dialogue: 0,0:03:19.91,0:03:22.92,Style1,,0,0,0,,Осы хост клубында...
Dialogue: 0,0:03:20.23,0:03:21.16,jp.sub-ja,,0,0,0,,Бұл хост бөлігі
Dialogue: 0,0:03:22.92,0:03:27.52,Style1,,0,0,0,,Кёя-сенпай барлығының ләззат алуы үшін қолынан келгенше еңбек етеді.
Dialogue: 0,0:03:23.16,0:03:27.08,jp.sub-ja,,0,0,0,,Кёуя-сенпай барлығының көңілін көтеруге тырысады.
Dialogue: 0,0:03:27.52,0:03:32.26,Style1,,0,0,0,,Барлығының көңілін көтеру арқылы біз де өзімізді толыққанды сезінеміз.
Dialogue: 0,0:03:27.78,0:03:31.70,jp.sub-ja,,0,0,0,,Барлығының көңілін көтеру арқылы біз де байығанымызды сезінеміз.
Dialogue: 0,0:03:32.26,0:03:36.93,Style1,,0,0,0,,Барлығын қызықтыру соншалықты түкке тұрғысыз ба?
Dialogue: 0,0:03:32.41,0:03:35.61,jp.sub-ja,,0,0,0,,Бәрінің көңілін көтеру соншалықты түкке тұрғысыз ба?
Dialogue: 0,0:03:36.93,0:03:41.42,Style1,,0,0,0,,Менің ойымша, Кёя-сенпай көрнекті.
Dialogue: 0,0:03:37.20,0:03:40.44,jp.sub-ja,,0,0,0,,Менің ойымша, Кёуя-сенпай тамаша.
Dialogue: 0,0:03:46.87,0:03:48.37,Style1,,0,0,0,,Сонымен,
Dialogue: 0,0:03:47.20,0:03:51.21,jp.sub-ja,,0,0,0,,Мен көремін. Бұл стипендиат Кьюя айтып тұрған ба?
Dialogue: 0,0:03:48.37,0:03:52.21,Style1,,0,0,0,,бұл Киойя айтып отырған құрметті студент, солай ма?
Dialogue: 0,0:03:55.21,0:03:58.22,Style1,,0,0,0,,Гранд Тоннер - жақында әкелген қауіпті жау
Dialogue: 0,0:03:55.41,0:03:56.62,jp.sub-ja,,0,0,0,,Грантнер
Dialogue: 0,0:03:56.78,0:04:01.51,jp.sub-ja,,0,0,0,,Бұл біраз уақыттан бері жапондық компанияларды бірінен соң бірін бақылап отырған қауіпті компания.
Dialogue: 0,0:03:58.22,0:04:02.22,Style1,,0,0,0,,Жапон кәсіпорындары бірінен соң бірі қолшатыр астында.
Dialogue: 0,0:04:02.22,0:04:05.22,Style1,,0,0,0,,Бұл маңызды емес. Мұрагер болған соң,
Dialogue: 0,0:04:02.43,0:04:03.34,jp.sub-ja,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:04:04.03,0:04:08.35,jp.sub-ja,,0,0,0,,Байланыс болса, Суоу отбасының берекесі арта түседі.
Dialogue: 0,0:04:05.22,0:04:09.23,Style1,,0,0,0,,Суо отбасы одан да гүлденеді.
Dialogue: 0,0:04:09.23,0:04:13.23,Style1,,0,0,0,,Өйткені, бала Суо отбасына қарсы шыға алмайды.
Dialogue: 0,0:04:09.59,0:04:12.71,jp.sub-ja,,0,0,0,,Ол бала бәрібір Суо отбасына қарсы шыға алмайды.
Dialogue: 0,0:04:13.23,0:04:16.90,Style1,,0,0,0,,Тамаки Суо отбасына онша қызығушылық танытпайды.
Dialogue: 0,0:04:13.56,0:04:16.28,jp.sub-ja,,0,0,0,,Тамаки Суудың үйіне қызығушылық танытпайды.
Dialogue: 0,0:04:16.90,0:04:19.91,Style1,,0,0,0,,Сіз қандай шаралар қолдандыңыз?
Dialogue: 0,0:04:17.07,0:04:18.39,jp.sub-ja,,0,0,0,,Сіз қандай әдісті қолдандыңыз?
Dialogue: 0,0:04:19.91,0:04:22.24,Style1,,0,0,0,,Мен оған егер ол Леди Эклэрмен құда болса,
Dialogue: 0,0:04:20.15,0:04:22.24,jp.sub-ja,,0,0,0,,Егер сіз Леди Эклэрмен күйеуге шыққан болсаңыз
Dialogue: 0,0:04:22.24,0:04:26.58,Style1,,0,0,0,,Мен оған анасын көруге рұқсат берер едім.
Dialogue: 0,0:04:22.48,0:04:25.25,jp.sub-ja,,0,0,0,,Мен оған анасымен кездесуге рұқсат бере аламын дедім.
Dialogue: 0,0:04:26.58,0:04:28.92,Style1,,0,0,0,,Сіз әлі де...
Dialogue: 0,0:04:26.88,0:04:28.25,jp.sub-ja,,0,0,0,,Сіз әлі...
Dialogue: 0,0:04:28.92,0:04:31.25,Style1,,0,0,0,,Мен тек сіздің ұлыңыздың орнын толтыруды сұраймын
Dialogue: 0,0:04:29.24,0:04:30.97,jp.sub-ja,,0,0,0,,Сіздің өміріңізді дұрыс басқармау
Dialogue: 0,0:04:31.25,0:04:35.08,Style1,,0,0,0,,өміріңізді дұрыс басқармағаныңыз үшін.
Dialogue: 0,0:04:31.62,0:04:34.02,jp.sub-ja,,0,0,0,,Мен сіздің ұлыңызға ақша төлеп жатырмын.
Dialogue: 0,0:05:20.73,0:05:23.30,Style1,,0,0,0,,Тамаки келмейді.
Dialogue: 0,0:05:20.97,0:05:22.55,jp.sub-ja,,0,0,0,,Тамаки келмейді
Dialogue: 0,0:05:23.30,0:05:27.97,Style1,,0,0,0,,Мен оған Хост клубында енді бетін көрсетпеуді бұйырдым.
Dialogue: 0,0:05:23.63,0:05:26.93,jp.sub-ja,,0,0,0,,Мен саған енді үй иесінің клубына бетіңді көрсетпеуді бұйырдым.
Dialogue: 0,0:05:27.97,0:05:30.24,Style1,,0,0,0,,Сіз Тамакидің сүйіктісісіз бе?
Dialogue: 0,0:05:28.37,0:05:29.86,jp.sub-ja,,0,0,0,,Сіз Тамакидің сүйіктісісіз бе?
Dialogue: 0,0:05:30.24,0:05:32.25,Style1,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:05:30.53,0:05:31.26,jp.sub-ja,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:05:32.25,0:05:37.75,Style1,,0,0,0,,Мен көремін. Жақсы. Сонда сен ол үшін ештеңе емессің.
Dialogue: 0,0:05:32.65,0:05:34.21,jp.sub-ja,,0,0,0,,Иә, бұл жақсы болды.
Dialogue: 0,0:05:35.11,0:05:37.03,jp.sub-ja,,0,0,0,,Сіз маңызды емессіз.
Dialogue: 0,0:05:37.75,0:05:42.41,Style1,,0,0,0,,Мен оның сүйіктісі емеспін, бірақ мен ол үшін ештеңе емеспін.
Dialogue: 0,0:05:38.01,0:05:41.89,jp.sub-ja,,0,0,0,,Біз ғашық емеспіз, бірақ туыс емеспіз.
Dialogue: 0,0:05:55.20,0:05:59.31,Style1,,0,0,0,,Достарыңызбен біраз уақыт байланыста болмағаныңыз жөн.
Dialogue: 0,0:05:55.51,0:05:58.88,jp.sub-ja,,0,0,0,,Достарыңызбен біраз уақыт байланыспағаныңыз жөн.
Dialogue: 0,0:05:59.31,0:06:02.21,Style1,,0,0,0,,Бұл сізді олардан кеткіңіз келмейді, солай ма?
Dialogue: 0,0:05:59.60,0:06:00.87,jp.sub-ja,,0,0,0,,Біраз өкініш болады
Dialogue: 0,0:06:04.54,0:06:06.03,Style1,,0,0,0,,Кіріңіз.
Dialogue: 0,0:06:04.71,0:06:05.30,jp.sub-ja,,0,0,0,,Өтінемін
Dialogue: 0,0:06:08.21,0:06:10.38,Style1,,0,0,0,,Мұнда сізді көруге келген қонақ бар.
Dialogue: 0,0:06:08.49,0:06:09.98,jp.sub-ja,,0,0,0,,Тұтынушы осында
Dialogue: 0,0:06:10.38,0:06:12.37,Style1,,0,0,0,,Оларды кіргізіңіз.
Dialogue: 0,0:06:10.60,0:06:11.64,jp.sub-ja,,0,0,0,,Кіріңіз.
Dialogue: 0,0:06:17.22,0:06:18.55,Style1,,0,0,0,,Ағай...
Dialogue: 0,0:06:17.51,0:06:18.17,jp.sub-ja,,0,0,0,,Ағай
Dialogue: 0,0:06:20.23,0:06:22.23,Style1,,0,0,0,,Тамаки-кун неліктен мұнда?
Dialogue: 0,0:06:20.42,0:06:22.17,jp.sub-ja,,0,0,0,,Тамаки неге мұнда?
Dialogue: 0,0:06:22.23,0:06:24.23,Style1,,0,0,0,,Оған қарсы болмаңыз.
Dialogue: 0,0:06:22.66,0:06:23.77,jp.sub-ja,,0,0,0,,Жарайды, ол
Dialogue: 0,0:06:24.23,0:06:26.90,Style1,,0,0,0,,Сізді тағы көргеніме қуаныштымын, ағай.
Dialogue: 0,0:06:24.47,0:06:25.96,jp.sub-ja,,0,0,0,,Көптен бері көрмегелі, ағай.
Dialogue: 0,0:06:26.90,0:06:33.57,Style1,,0,0,0,,Мен Киояны Хост клубына шақырған адаммын. Кешіріңіз. Бірақ содан кейін,
Dialogue: 0,0:06:27.11,0:06:29.17,jp.sub-ja,,0,0,0,,Кюяны қабылдаушы клубқа шақырған мен болдым.
Dialogue: 0,0:06:29.99,0:06:30.86,jp.sub-ja,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:33.57,0:06:36.58,Style1,,0,0,0,,Ағай, мұнда не істеп жүрсіз?
Dialogue: 0,0:06:33.86,0:06:35.48,jp.sub-ja,,0,0,0,,Ағай, мұнда неге келдің?
Dialogue: 0,0:06:36.58,0:06:42.25,Style1,,0,0,0,,Сізден осында келуіңізді сұрағанымыз үшін өте өкінішті.
Dialogue: 0,0:06:36.75,0:06:39.56,jp.sub-ja,,0,0,0,,Осы жерге бару үшін қиналғаныңыз үшін рахмет.
Dialogue: 0,0:06:39.94,0:06:41.30,jp.sub-ja,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:06:42.25,0:06:47.69,Style1,,0,0,0,,Керісінше, баспасөзден аулақ болу маған қызмет етеді.
Dialogue: 0,0:06:42.57,0:06:46.28,jp.sub-ja,,0,0,0,,Жоқ, бұқаралық ақпарат құралдарынан аулақ болу өте ыңғайлы.
Dialogue: 0,0:06:47.69,0:06:50.19,Style1,,0,0,0,,Менің медициналық құрал-жабдық шығаратын компаниям
Dialogue: 0,0:06:48.15,0:06:49.85,jp.sub-ja,,0,0,0,,Менің медициналық құрылғылар компаниям
Dialogue: 0,0:06:50.19,0:06:55.53,Style1,,0,0,0,,осы жерден Гранд Тоннер сатып алады.
Dialogue: 0,0:06:50.32,0:06:54.03,jp.sub-ja,,0,0,0,,Жақында оны осы Grantaire компаниясы сатып алатын сияқты.
Dialogue: 0,0:06:55.53,0:06:59.53,Style1,,0,0,0,,Бұл Киойяға дұрыс қызмет ететін шығар.
Dialogue: 0,0:06:55.87,0:06:58.35,jp.sub-ja,,0,0,0,,Бәлкім, Кюяның жақсы жағы бар шығар.
Dialogue: 0,0:06:59.53,0:07:02.54,Style1,,0,0,0,,Мен оған ауыстыруды ойлаған компания
Dialogue: 0,0:06:59.67,0:07:02.12,jp.sub-ja,,0,0,0,,Мен оған тапсырамын деп жүрген компания
Dialogue: 0,0:07:02.54,0:07:06.03,Style1,,0,0,0,,енді оның қолынан шығады.
Dialogue: 0,0:07:02.86,0:07:05.25,jp.sub-ja,,0,0,0,,Бұл енді оның қолында емес.
Dialogue: 0,0:07:12.55,0:07:14.88,Style1,,0,0,0,,Ағай,
Dialogue: 0,0:07:12.78,0:07:17.62,jp.sub-ja,,0,0,0,,Ағай, бірден бір өтінішім бар.
Dialogue: 0,0:07:14.88,0:07:18.21,Style1,,0,0,0,,Менің бір өтінішім бар.
Dialogue: 0,0:07:24.29,0:07:27.28,Style1,,0,0,0,,Бұл киімде не бар?
Dialogue: 0,0:07:24.59,0:07:26.74,jp.sub-ja,,0,0,0,,Бұл қандай костюм?
Dialogue: 0,0:07:28.49,0:07:31.23,Style1,,0,0,0,,Біз айттық, бұл арнайы шеруге арналған костюм.
Dialogue: 0,0:07:28.70,0:07:31.12,jp.sub-ja,,0,0,0,,Демек, бұл ерекше парадтық костюм.
Dialogue: 0,0:07:31.23,0:07:32.90,Style1,,0,0,0,,Хару-чан, сен сүйкімдісің!
Dialogue: 0,0:07:31.53,0:07:32.58,jp.sub-ja,,0,0,0,,Хару-чан сүйкімді
Dialogue: 0,0:07:32.90,0:07:37.24,Style1,,0,0,0,,Бұл емес. Неге мен жалғыз қыз болып киінемін?
Dialogue: 0,0:07:33.31,0:07:34.34,jp.sub-ja,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:07:35.08,0:07:37.04,jp.sub-ja,,0,0,0,,Неге мен жалғыз қызбын?
Dialogue: 0,0:07:37.24,0:07:39.24,Style1,,0,0,0,,Кімге бәрібір? Бұл косплей,
Dialogue: 0,0:07:37.52,0:07:39.34,jp.sub-ja,,0,0,0,,Жақсы, бұл косплей.
Dialogue: 0,0:07:39.24,0:07:41.24,Style1,,0,0,0,,қыз сияқты киіну мүлдем дұрыс!
Dialogue: 0,0:07:39.57,0:07:41.16,jp.sub-ja,,0,0,0,,Әйел болып киіну мүлдем дұрыс емес
Dialogue: 0,0:07:41.24,0:07:43.51,Style1,,0,0,0,,«Ұнады» Мен қызбын ба?
Dialogue: 0,0:07:41.48,0:07:42.55,jp.sub-ja,,0,0,0,,Әйел киіну.
Dialogue: 0,0:07:43.51,0:07:44.84,Style1,,0,0,0,,Жақсы ма?
Dialogue: 0,0:07:44.84,0:07:47.18,Style1,,0,0,0,,Жақсы емес. Ол жауап бермей жатыр.
Dialogue: 0,0:07:45.03,0:07:46.33,jp.sub-ja,,0,0,0,,Жоқ, ол шықпайды.
Dialogue: 0,0:07:49.52,0:07:51.85,Style1,,0,0,0,,Тамаки-сенпай шынымен де жасады
Dialogue: 0,0:07:49.83,0:07:54.80,jp.sub-ja,,0,0,0,,Әйтеуір, Тамаки-сенпай, сен бүгін бірде-бір рет салонға келмедің.
Dialogue: 0,0:07:51.85,0:07:55.18,Style1,,0,0,0,,бүгін салонда бір рет бетін көрсетпейді.
Dialogue: 0,0:08:09.54,0:08:14.14,Style1,,0,0,0,,А, Шима-сан? Тым ұзақ болды. Бұл Киёя.
Dialogue: 0,0:08:09.67,0:08:10.84,jp.sub-ja,,0,0,0,,О, Шима-сан
Dialogue: 0,0:08:10.54,0:08:13.53,Style2,,0,0,0,,«Суоның екінші мүлкі»
Dialogue: 0,0:08:11.47,0:08:13.18,jp.sub-ja,,0,0,0,,Көп уақыт өтті. Бұл Кюя.
Dialogue: 0,0:08:14.14,0:08:17.38,Style1,,0,0,0,,Бұл Тамаки шебері туралы, солай емес пе?
Dialogue: 0,0:08:14.40,0:08:16.06,jp.sub-ja,,0,0,0,,Сіз Бочама Тамакиді айтып отырсыз.
Dialogue: 0,0:08:17.38,0:08:22.62,Style1,,0,0,0,,Мастер Францияға аттанады.
Dialogue: 0,0:08:17.73,0:08:21.03,jp.sub-ja,,0,0,0,,Ботчама Францияға кетіп бара жатыр.
Dialogue: 0,0:08:22.62,0:08:25.08,Style1,,0,0,0,,Мен оны тоқтатуға тырыстым,
Dialogue: 0,0:08:23.03,0:08:24.45,jp.sub-ja,,0,0,0,,Мен оны тоқтаттым.
Dialogue: 0,0:08:25.08,0:08:28.55,Style1,,0,0,0,,бірақ ол Суо отбасы оның анасын кешіргенін айтты,
Dialogue: 0,0:08:25.32,0:08:28.35,jp.sub-ja,,0,0,0,,Суо отбасы анаңды кешіреді.
Dialogue: 0,0:08:28.55,0:08:32.23,Style1,,0,0,0,,және ол ақыры анасын бақытты ете алатынын айтты.
Dialogue: 0,0:08:28.87,0:08:31.37,jp.sub-ja,,0,0,0,,Мен анамды бақытты ете аламын деп үміттенемін.
Dialogue: 0,0:08:32.23,0:08:35.23,Style1,,0,0,0,,Сондай-ақ, егер ол Оуранда бұдан былай қалса,
Dialogue: 0,0:08:32.55,0:08:36.66,jp.sub-ja,,0,0,0,,Сондай-ақ, мен Оуранда бұдан былай тұрсам да, өзімшілмін.
Dialogue: 0,0:08:35.23,0:08:39.23,Style1,,0,0,0,,оның құдіреттілігі саған қиындық туғызады, Кёя-сама,
Dialogue: 0,0:08:37.05,0:08:40.43,jp.sub-ja,,0,0,0,,Өйткені ол тек Киоя-самаға және барлығына қиындық тудырады.
Dialogue: 0,0:08:39.23,0:08:41.23,Style1,,0,0,0,,және басқалары.
Dialogue: 0,0:08:41.23,0:08:43.23,Style1,,0,0,0,,Әлгі ақымақ.
Dialogue: 0,0:08:41.45,0:08:42.63,jp.sub-ja,,0,0,0,,Әлгі ақымақ...
Dialogue: 0,0:08:44.24,0:08:48.24,Style1,,0,0,0,,Тамаки Францияға оралуды жоспарлап отыр.
Dialogue: 0,0:08:44.49,0:08:47.39,jp.sub-ja,,0,0,0,,Тамаки Францияға қайтады.
Dialogue: 0,0:08:48.24,0:08:51.08,Style1,,0,0,0,,Тама-чан кетіп бара жатыр!?
Dialogue: 0,0:08:48.62,0:08:50.20,jp.sub-ja,,0,0,0,,Тама-чан жоқ болады.
Dialogue: 0,0:08:51.08,0:08:52.78,Style1,,0,0,0,,Сіз қалжыңдап тұрған шығарсыз!
Dialogue: 0,0:08:51.29,0:08:52.27,jp.sub-ja,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:08:52.78,0:08:55.58,Style1,,0,0,0,,Мен мұның кенеттен аяқталуына жол бермеймін!
Dialogue: 0,0:08:53.04,0:08:54.88,jp.sub-ja,,0,0,0,,Оның кенеттен аяқталуы шыдамсыз ба?
Dialogue: 0,0:08:55.58,0:08:57.92,Style1,,0,0,0,,Хикару...
Dialogue: 0,0:08:55.83,0:08:56.43,jp.sub-ja,,0,0,0,,Жарық
Dialogue: 0,0:08:57.92,0:08:59.65,Style1,,0,0,0,,Кёя-сама...
Dialogue: 0,0:08:58.19,0:08:58.91,jp.sub-ja,,0,0,0,,Кёуя-сама
Dialogue: 0,0:08:59.65,0:09:00.92,Style1,,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:09:00.92,0:09:03.59,Style1,,0,0,0,,Мен, Шима, ойладым,
Dialogue: 0,0:09:01.19,0:09:02.52,jp.sub-ja,,0,0,0,,Шима ойлайды
Dialogue: 0,0:09:03.59,0:09:07.26,Style1,,0,0,0,,Шебердің анасы шынымен де осындай ханым болса
Dialogue: 0,0:09:03.80,0:09:05.22,jp.sub-ja,,0,0,0,,Бочаманың анасы
Dialogue: 0,0:09:05.67,0:09:09.61,jp.sub-ja,,0,0,0,,Ботчама туралы үнемі айтатын адам болсаңыз.
Dialogue: 0,0:09:07.26,0:09:09.93,Style1,,0,0,0,,ұстаз үнемі айтқан,
Dialogue: 0,0:09:09.93,0:09:13.27,Style1,,0,0,0,,Сонда мен оның бұл мінезіне риза болмайтынына сенімдімін
Dialogue: 0,0:09:10.54,0:09:13.77,jp.sub-ja,,0,0,0,,Бочаманың Оураннан осылай кететініне сенімдімін.
Dialogue: 0,0:09:13.27,0:09:17.04,Style1,,0,0,0,,, онда Ұстаз Оураннан кетіп бара жатыр.
Dialogue: 0,0:09:14.12,0:09:15.95,jp.sub-ja,,0,0,0,,Мен сені бақытты болмас деп ойладым.
Dialogue: 0,0:09:17.04,0:09:19.27,Style1,,0,0,0,,Ол Францияға қашан кетеді?
Dialogue: 0,0:09:17.42,0:09:18.63,jp.sub-ja,,0,0,0,,Францияға қашан барды?
Dialogue: 0,0:09:19.27,0:09:21.61,Style1,,0,0,0,,Оның ұшағы бүгін кеште.
Dialogue: 0,0:09:19.61,0:09:21.39,jp.sub-ja,,0,0,0,,Бүгін кешке ұшақта
Dialogue: 0,0:09:21.61,0:09:23.94,Style1,,0,0,0,,Жақында?
Dialogue: 0,0:09:22.05,0:09:23.09,jp.sub-ja,,0,0,0,,Кенеттен
Dialogue: 0,0:09:23.94,0:09:28.28,Style1,,0,0,0,,Ол Уран жәрмеңкесі аяқталып жатқанда, бүгін түнде Жапониядан кететінін айтты.
Dialogue: 0,0:09:24.25,0:09:27.88,jp.sub-ja,,0,0,0,,Бүгін Уран фестивалі аяқтала салысымен мен Жапониядан кетемін.
Dialogue: 0,0:09:29.95,0:09:31.95,Style1,,0,0,0,,Тамаки!
Dialogue: 0,0:09:30.18,0:09:30.69,jp.sub-ja,,0,0,0,,Сақина
Dialogue: 0,0:09:31.95,0:09:32.95,Style1,,0,0,0,,Тама-чан!
Dialogue: 0,0:09:32.26,0:09:32.98,jp.sub-ja,,0,0,0,,Тама-чан
Dialogue: 0,0:09:32.95,0:09:33.95,Style1,,0,0,0,,Мырза!
Dialogue: 0,0:09:33.23,0:09:33.58,jp.sub-ja,,0,0,0,,Мырза
Dialogue: 0,0:09:33.95,0:09:36.29,Style1,,0,0,0,,Уран жәрмеңкесі әлі аяқталған жоқ!
Dialogue: 0,0:09:34.32,0:09:36.20,jp.sub-ja,,0,0,0,,Уран фестивалі әлі аяқталмаған шығар.
Dialogue: 0,0:09:36.29,0:09:38.96,Style1,,0,0,0,,Менің отбасымның көлігі тұрақта болуы керек!
Dialogue: 0,0:09:36.70,0:09:38.54,jp.sub-ja,,0,0,0,,Менің көлігім тұрақта болуы керек.
Dialogue: 0,0:09:38.96,0:09:40.45,Style1,,0,0,0,,Кеттік, Харухи!
Dialogue: 0,0:09:39.35,0:09:40.06,jp.sub-ja,,0,0,0,,Барайық Харухи
Dialogue: 0,0:09:54.07,0:09:57.08,Style1,,0,0,0,,Біз асығамыз. Бірден шығыңыз.
Dialogue: 0,0:09:54.41,0:09:55.99,jp.sub-ja,,0,0,0,,Мен асығып тұрмын, мені бірден шығарып жіберіңізші.
Dialogue: 0,0:09:56.62,0:09:58.08,jp.sub-ja,,0,0,0,,Кёу... Кёуя-сама
Dialogue: 0,0:09:57.08,0:09:58.41,Style1,,0,0,0,,Кёя-сама...
Dialogue: 0,0:09:58.41,0:10:00.25,Style1,,0,0,0,,Не болды?
Dialogue: 0,0:09:58.69,0:09:59.22,jp.sub-ja,,0,0,0,,Не болды?
Dialogue: 0,0:10:00.25,0:10:02.24,Style1,,0,0,0,,Т-бұл ...
Dialogue: 0,0:10:00.43,0:10:01.51,jp.sub-ja,,0,0,0,,Міне...
Dialogue: 0,0:10:05.92,0:10:07.92,Style1,,0,0,0,,Сіздің тапсырыстарыңыз қандай?
Dialogue: 0,0:10:06.17,0:10:07.47,jp.sub-ja,,0,0,0,,Не бұйырылды?
Dialogue: 0,0:10:07.92,0:10:11.59,Style1,,0,0,0,,Сізге Леди Эклэрді қорғау бұйырылды ма?
Dialogue: 0,0:10:08.28,0:10:10.36,jp.sub-ja,,0,0,0,,Оған да леди Эклэрді алып жүру бұйырылды ма?
Dialogue: 0,0:10:11.59,0:10:15.26,Style1,,0,0,0,,Осы жағдайға жеткеніме өкінемін,
Dialogue: 0,0:10:11.82,0:10:14.60,jp.sub-ja,,0,0,0,,Мен бұл жағдайға қатты өкінемін.
Dialogue: 0,0:10:15.26,0:10:20.26,Style1,,0,0,0,,бірақ біз, жеке полиция, сіздің әкеңізге жауап береміз.
Dialogue: 0,0:10:15.66,0:10:19.43,jp.sub-ja,,0,0,0,,Әкеміз біздің жеке полицияның шебері.
Dialogue: 0,0:10:22.60,0:10:24.60,Style1,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:10:24.60,0:10:28.61,Style1,,0,0,0,,Мені қатты кешіріңіз, бірақ біз ешкімнің кетуіне рұқсат ете алмаймыз.
Dialogue: 0,0:10:24.78,0:10:28.44,jp.sub-ja,,0,0,0,,Кешіріңіз, бірақ мен ешкімді жібере алмаймын.
Dialogue: 0,0:10:28.61,0:10:31.60,Style1,,0,0,0,,Тіпті күшпен істеу керек болса да.
Dialogue: 0,0:10:29.09,0:10:31.14,jp.sub-ja,,0,0,0,,Күшпен болса да.
Dialogue: 0,0:10:45.73,0:10:47.06,Style1,,0,0,0,,Арбаны пайдаланыңыз.
Dialogue: 0,0:10:46.06,0:10:46.83,jp.sub-ja,,0,0,0,,Осы каретканы пайдаланыңыз.
Dialogue: 0,0:10:47.06,0:10:50.22,Style1,,0,0,0,,Артқы төбелерді айналып өтсеңіз, оларды кесіп тастауға болады.
Dialogue: 0,0:10:47.38,0:10:49.74,jp.sub-ja,,0,0,0,,Таудың арғы жағындағы айналма жол арқылы өтіп, жағдайды алдын ала аласыз.
Dialogue: 0,0:10:51.90,0:10:55.06,Style1,,0,0,0,,Бұл Ханинозука мен Моринозука...
Dialogue: 0,0:10:52.36,0:10:54.59,jp.sub-ja,,0,0,0,,Хани жоқ қорған және гарпун қорғаны
Dialogue: 0,0:10:59.41,0:11:00.74,Style1,,0,0,0,,Харухи!
Dialogue: 0,0:10:59.68,0:11:00.19,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:11:03.24,0:11:04.58,Style1,,0,0,0,,Харухи,
Dialogue: 0,0:11:03.70,0:11:04.19,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:11:04.58,0:11:07.24,Style1,,0,0,0,,барып мына ақымақты ал.
Dialogue: 0,0:11:04.95,0:11:06.60,jp.sub-ja,,0,0,0,,Мына ақымақтан сұра
Dialogue: 0,0:11:08.25,0:11:10.24,Style1,,0,0,0,,Жүр, Хикару!
Dialogue: 0,0:11:08.67,0:11:09.96,jp.sub-ja,,0,0,0,,Хикариге барыңыз
Dialogue: 0,0:11:15.92,0:11:18.58,Style1,,0,0,0,,Сіз не істеп жатырсыз!? Мына вагоны тоқтат!
Dialogue: 0,0:11:16.26,0:11:18.18,jp.sub-ja,,0,0,0,,Сіз не істемексіз? Тоқта мына вагон...
Dialogue: 0,0:11:22.09,0:11:23.93,Style1,,0,0,0,,Такаши,
Dialogue: 0,0:11:22.32,0:11:22.96,jp.sub-ja,,0,0,0,,Такаши
Dialogue: 0,0:11:23.93,0:11:26.10,Style1,,0,0,0,,соққыларыңызды тартыңыз!
Dialogue: 0,0:11:24.31,0:11:26.00,jp.sub-ja,,0,0,0,,Тек абай болыңыз
Dialogue: 0,0:11:26.10,0:11:27.76,Style1,,0,0,0,,Мұнда.
Dialogue: 0,0:11:26.39,0:11:27.32,jp.sub-ja,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:11:45.72,0:11:49.39,Style1,,0,0,0,,Мен саған айттым ғой, менің достарымды таңдау - жоқ-жоқ!
Dialogue: 0,0:11:46.00,0:11:49.06,jp.sub-ja,,0,0,0,,Досымды қорласаң, «мех» деуші едің.
Dialogue: 0,0:11:49.39,0:11:52.72,Style1,,0,0,0,,Сіз Ouran Host Club-тың ең жақсысын ала аласыз деп ойламаңыз.
Dialogue: 0,0:11:49.63,0:11:52.28,jp.sub-ja,,0,0,0,,Ouran Host Club-ты сынамаңыздар, балалар.
Dialogue: 0,0:11:53.56,0:11:56.90,Style1,,0,0,0,,Хикару, Каору, Харухи,
Dialogue: 0,0:11:53.91,0:11:56.10,jp.sub-ja,,0,0,0,,Хикари Каору Харухи
Dialogue: 0,0:11:56.90,0:11:58.89,Style1,,0,0,0,,Тамакиді қайтарыңыз.
Dialogue: 0,0:11:57.20,0:11:58.25,jp.sub-ja,,0,0,0,,Мен Тамакиді сұрадым.
Dialogue: 0,0:12:04.57,0:12:08.57,Style1,,0,0,0,,Хикару! Бұл үлкен жылдамдық, аз дегенде, абайсызда!
Dialogue: 0,0:12:04.94,0:12:08.24,jp.sub-ja,,0,0,0,,Хикари, қанша жылдам жүрсең де, бұл абсурд.
Dialogue: 0,0:12:08.57,0:12:11.58,Style1,,0,0,0,,Біз оның биіктігін қайтарып жатырмыз, бәрібір!
Dialogue: 0,0:12:08.84,0:12:10.25,jp.sub-ja,,0,0,0,,Мен сені міндетті түрде қайтарамын.
Dialogue: 0,0:12:11.58,0:12:13.25,Style1,,0,0,0,,Хикару...
Dialogue: 0,0:12:12.00,0:12:12.69,jp.sub-ja,,0,0,0,,Жарық…
Dialogue: 0,0:12:13.25,0:12:18.85,Style1,,0,0,0,,Егер оның ұлылығы болмаса, біз бәрібір бұл дүниеден тыс қалар едік!
Dialogue: 0,0:12:13.49,0:12:14.81,jp.sub-ja,,0,0,0,,Егер лорд болмаса
Dialogue: 0,0:12:15.53,0:12:18.08,jp.sub-ja,,0,0,0,,Дүниеден артта қалдық
Dialogue: 0,0:12:18.85,0:12:21.35,Style1,,0,0,0,,Хост клубының арқасында біз Харухимен кездестік,
Dialogue: 0,0:12:19.03,0:12:21.32,jp.sub-ja,,0,0,0,,Қабылдаушы клубтың арқасында мен Харухимен де кездестім.
Dialogue: 0,0:12:21.35,0:12:24.26,Style1,,0,0,0,,және басқалармен де жақын болыңыз!
Dialogue: 0,0:12:21.66,0:12:23.01,jp.sub-ja,,0,0,0,,Барлығымен дос болдым.
Dialogue: 0,0:12:24.26,0:12:28.03,Style1,,0,0,0,,Хост клубы кенеттен осылай аяқталды...
Dialogue: 0,0:12:24.46,0:12:27.38,jp.sub-ja,,0,0,0,,Мен қабылдау бөлімінің кенеттен аяқталғанына сене алмаймын.
Dialogue: 0,0:12:28.03,0:12:30.15,Style1,,0,0,0,,...мен көтере алмаған нәрсе!
Dialogue: 0,0:12:28.49,0:12:29.81,jp.sub-ja,,0,0,0,,Маған мүлдем ұнамайды.
Dialogue: 0,0:12:40.27,0:12:41.27,Style1,,0,0,0,,Хикару!
Dialogue: 0,0:12:40.57,0:12:41.15,jp.sub-ja,,0,0,0,,Жарық
Dialogue: 0,0:12:41.27,0:12:43.71,Style1,,0,0,0,,Хикару... Хикару...
Dialogue: 0,0:12:41.75,0:12:43.28,jp.sub-ja,,0,0,0,,Жарық Жарық
Dialogue: 0,0:12:44.88,0:12:48.55,Style1,,0,0,0,,Хикару, жақсысың ба? Қолыңыз ауырады ма?
Dialogue: 0,0:12:45.03,0:12:47.70,jp.sub-ja,,0,0,0,,Жарық жарай ма? Қолыңыз ауырады ма?
Dialogue: 0,0:12:48.55,0:12:50.55,Style1,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:12:48.99,0:12:49.87,jp.sub-ja,,0,0,0,,(Киришима) Сенпай Амагири жақсы жүр ме екен?
Dialogue: 0,0:12:50.55,0:12:57.22,Style1,,0,0,0,,Біз шынымен осылай аяқтаймыз ба, сэр?
Dialogue: 0,0:12:50.95,0:12:54.68,jp.sub-ja,,0,0,0,,Біз...шынымен біз осылай боламыз ба?
Dialogue: 0,0:12:55.42,0:12:55.82,jp.sub-ja,,0,0,0,,Мырза...
Dialogue: 0,0:12:57.22,0:12:59.25,Style1,,0,0,0,,Хикару...
Dialogue: 0,0:12:57.38,0:12:57.98,jp.sub-ja,,0,0,0,,Жарық…
Dialogue: 0,0:13:01.06,0:13:03.90,Style1,,0,0,0,,Жарайды, мен кеттім.
Dialogue: 0,0:13:01.35,0:13:03.11,jp.sub-ja,,0,0,0,,Мен барамын.
Dialogue: 0,0:13:03.90,0:13:09.50,Style1,,0,0,0,,Әкеңмен сөйлесу көмектеспейді ме?
Dialogue: 0,0:13:04.10,0:13:07.55,jp.sub-ja,,0,0,0,,Әкеңмен сөйлессең де көмектесе алмайтын нәрсе бар ма?
Dialogue: 0,0:13:08.39,0:13:10.28,jp.sub-ja,,0,0,0,,Не? Неліктен?
Dialogue: 0,0:13:09.50,0:13:11.13,Style1,,0,0,0,,Жұмыс жақсы бітіргеннен кейінгі бір кесе сакэ – ерекше нәрсе
Dialogue: 0,0:13:15.57,0:13:18.91,Style1,,0,0,0,,Шынымен, мен бүгін таңертең тамақ жегім келмейді, болды.
Dialogue: 0,0:13:15.85,0:13:17.68,jp.sub-ja,,0,0,0,,Бүгін таңертең тамақ жегім келмейді.
Dialogue: 0,0:13:18.91,0:13:22.25,Style1,,0,0,0,,Анаңның жерлеуінен кейін біраз уақыт өтті
Dialogue: 0,0:13:19.29,0:13:21.95,jp.sub-ja,,0,0,0,,Сен анаңның жерлеуінен кейін де.
Dialogue: 0,0:13:22.25,0:13:26.24,Style1,,0,0,0,,сіз таңғы асты қайтадан іше алмас бұрын, солай емес пе?
Dialogue: 0,0:13:22.51,0:13:25.62,jp.sub-ja,,0,0,0,,Таңғы ас ішуге біраз уақыт кетті.
Dialogue: 0,0:13:30.26,0:13:33.92,Style1,,0,0,0,,Мен анамды енді ешқашан көре алмаймын ба?
Dialogue: 0,0:13:30.42,0:13:33.46,jp.sub-ja,,0,0,0,,Мен анамды енді көре алмаймын
Dialogue: 0,0:13:36.93,0:13:40.63,Style1,,0,0,0,,Бұл дүниеде әрине көп нәрсе бар
Dialogue: 0,0:13:37.35,0:13:42.02,jp.sub-ja,,0,0,0,,Бұл дүниеде қанша тырыссаңыз да көмектесе алмайтын көптеген нәрселер бар.
Dialogue: 0,0:13:40.63,0:13:44.23,Style1,,0,0,0,,сіз ештеңе істей алмайсыз, мүмкін болса да көріңіз.
Dialogue: 0,0:13:46.21,0:13:48.54,Style1,,0,0,0,,Есіңізде болсын, Харухи,
Dialogue: 0,0:13:46.44,0:13:47.52,jp.sub-ja,,0,0,0,,Жақсы болды, Харухи
Dialogue: 0,0:13:48.54,0:13:54.38,Style1,,0,0,0,,Дәл осы себепті сіз заттарды сыртқа шығару уақыты келгенде тартынуға болмайды.
Dialogue: 0,0:13:48.86,0:13:49.50,jp.sub-ja,,0,0,0,,Саған үйрететін кез келді
Dialogue: 0,0:13:50.31,0:13:53.52,jp.sub-ja,,0,0,0,,Қолыңнан келгеннің бәрін істеу керек болса, тартынба.
Dialogue: 0,0:14:12.90,0:14:14.06,Style1,,0,0,0,,Харухи?
Dialogue: 0,0:14:13.15,0:14:13.70,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:14:24.40,0:14:30.89,jizou-ja,,0,0,0,,Қайталап жыпылықтайтын ескі және өңсіз
Dialogue: 0,0:14:24.58,0:14:26.25,Style1,,0,0,0,,Үйге бұрынғыдай жолмен бару,
Dialogue: 0,0:14:26.25,0:14:29.52,Style1,,0,0,0,,Үйге бұрынғыдай жолмен, Не болды? Сіз ештеңе айтқан жоқсыз.
Dialogue: 0,0:14:26.43,0:14:28.78,jp.sub-ja,,0,0,0,,Не болды? Ауызыңды жап.
Dialogue: 0,0:14:29.52,0:14:30.92,Style1,,0,0,0,,Үйге баратын жолды бұрынғыдай, Үй иесі екенсің ғой? Мені көңіл көтер.
Dialogue: 0,0:14:29.79,0:14:31.16,jp.sub-ja,,0,0,0,,Сіз жүргізушісіз бе?
Dialogue: 0,0:14:30.89,0:14:38.30,jizou-ja,,0,0,0,,Көше шамдарының жетегіне еріп, мен әдеттегідей үйге барамын.
Dialogue: 0,0:14:30.92,0:14:33.59,Style1,,0,0,0,,көне, өшіп қалған көше шамдарының үнемі жыпылықтауымен басқарылады. Сіз үй иесісіз, солай емес пе? Мені көңіл көтер.
Dialogue: 0,0:14:31.54,0:14:32.88,jp.sub-ja,,0,0,0,,Маған көбірек көңіл көтеруге рұқсат етіңіз
Dialogue: 0,0:14:33.59,0:14:37.26,Style1,,0,0,0,,ескі, сөнген көше шамдарының үнемі жыпылықтауымен басқарылады. Сіз ше? Сен шынымен құдасың ба?
Dialogue: 0,0:14:34.07,0:14:34.66,jp.sub-ja,,0,0,0,,Сіз солсыз
Dialogue: 0,0:14:35.22,0:14:39.05,jp.sub-ja,,0,0,0,,Менің отбасым жаңа кездескен адаммен құда түсуімді бұйырды.
Dialogue: 0,0:14:37.26,0:14:38.26,Style1,,0,0,0,,сіздің отбасыңыздың тапсырысы бойынша сіз жаңа кездескен адамға ескі, сөнген көше шамдарының үнемі жыпылықтауымен байланысты ма?
Dialogue: 0,0:14:38.26,0:14:41.26,Style1,,0,0,0,,Осы тот басқан ескі қала арқылы отбасыңыздың бұйрығымен жаңа ғана танысқан адамға таныс жел соғады ма?
Dialogue: 0,0:14:38.30,0:14:43.54,jizou-ja,,0,0,0,,Тот басқан қалада сағыныш жел соғады
Dialogue: 0,0:14:39.81,0:14:40.81,jp.sub-ja,,0,0,0,,Сіз шынымен жақсысыз ба?
Dialogue: 0,0:14:41.26,0:14:43.53,Style1,,0,0,0,,Осы тот басқан ескі қалада таныс жел соғады
Dialogue: 0,0:14:43.53,0:14:49.20,Style1,,0,0,0,,Қолайлы желге айналады, арқамнан итермелейді
Dialogue: 0,0:14:44.07,0:14:49.56,jizou-ja,,0,0,0,,Артқы жел мені артқа итеріп жіберді
Dialogue: 0,0:14:49.20,0:14:52.87,Style1,,0,0,0,,Мен бұл үмітсіздікті жүрегімде сақтаймын
Dialogue: 0,0:14:49.62,0:14:56.20,jizou-ja,,0,0,0,,Көз жасым құрғағанша, Мен отставкамды ұстап, ТОҚТАймын!
Dialogue: 0,0:14:52.87,0:14:56.54,Style1,,0,0,0,,'Көз жасы құрғап, тоқтағанша!
Dialogue: 0,0:14:56.54,0:14:59.68,Style1,,0,0,0,,Мақсат жоқ!
Dialogue: 0,0:14:56.84,0:15:03.01,jizou-ja,,0,0,0,,Мақсат жоқ, кері қайтару жоқ
Dialogue: 0,0:14:59.68,0:15:03.22,Style1,,0,0,0,,Артқа қайту да жоқ!
Dialogue: 0,0:15:03.22,0:15:06.39,Style1,,0,0,0,,Мен желді жарып, шексіз сызықпен жүгіремін
Dialogue: 0,0:15:03.71,0:15:09.44,jizou-ja,,0,0,0,,Желмен шексіз жүгіру
Dialogue: 0,0:15:06.39,0:15:08.05,Style1,,0,0,0,,Мен желді жұлып алып, Харухидің шексіз сызығымен жүгіремін!
Dialogue: 0,0:15:06.59,0:15:07.09,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:15:08.05,0:15:09.22,Style1,,0,0,0,,Мен желді жарып, шексіз сызықпен жүгіремін
Dialogue: 0,0:15:09.22,0:15:10.89,Style1,,0,0,0,,Мен желді жұлып алып, Харухи Фудзёкамен шексіз жүгіріп келемін бе?
Dialogue: 0,0:15:09.58,0:15:11.89,jp.sub-ja,,0,0,0,,Харухи Фудзиока…
Dialogue: 0,0:15:10.89,0:15:12.72,Style1,,0,0,0,,Харухи Фудзиока?
Dialogue: 0,0:15:14.16,0:15:15.56,Style1,,0,0,0,,Не істеп жатырсың, Харухи!?
Dialogue: 0,0:15:14.42,0:15:15.40,jp.sub-ja,,0,0,0,,Не істеп жатырсың, Харухи?
Dialogue: 0,0:15:15.56,0:15:17.56,Style1,,0,0,0,,Бұл өте қауіпті! Қазір вагонды тоқтат!
Dialogue: 0,0:15:15.82,0:15:17.52,jp.sub-ja,,0,0,0,,Бұл қауіпті, сондықтан вагонды тез тоқтатыңыз.
Dialogue: 0,0:15:17.56,0:15:20.23,Style1,,0,0,0,,Сенпай! Қайтып оралуыңызды өтінемін!
Dialogue: 0,0:15:17.96,0:15:20.02,jp.sub-ja,,0,0,0,,Сенпай, қайтып келші.
Dialogue: 0,0:15:20.23,0:15:22.23,Style1,,0,0,0,,Қараңыз, вагонды тоқтатыңыз!
Dialogue: 0,0:15:20.42,0:15:22.00,jp.sub-ja,,0,0,0,,Жарайды, вагонды тоқтат.
Dialogue: 0,0:15:22.23,0:15:25.40,Style1,,0,0,0,,Ешкім сенің кеткеніңді қаламайды, Сенпай!
Dialogue: 0,0:15:22.57,0:15:24.98,jp.sub-ja,,0,0,0,,Әркім өзінің үлкендерінің барғанын қаламайды.
Dialogue: 0,0:15:26.91,0:15:31.41,Style1,,0,0,0,,Бірақ бәрі оларды Хост клубы шығарғанын айтады...
Dialogue: 0,0:15:27.22,0:15:30.60,jp.sub-ja,,0,0,0,,Бірақ... барлығы қабылдаушы клубта қиындық тудырып жатыр.
Dialogue: 0,0:15:31.41,0:15:35.75,Style1,,0,0,0,,Сенпай, сен шынымен ақымақсың. Қатты ақымақ!
Dialogue: 0,0:15:31.64,0:15:35.06,jp.sub-ja,,0,0,0,,Сенпай шынымен ақымақ екен. Ол үлкен ақымақ.
Dialogue: 0,0:15:35.75,0:15:38.25,Style1,,0,0,0,,Біз бірге болғаннан кейін,
Dialogue: 0,0:15:36.11,0:15:37.80,jp.sub-ja,,0,0,0,,Біз көптен бері бірге болдық
Dialogue: 0,0:15:38.25,0:15:41.92,Style1,,0,0,0,,Сол ащы күндерді қайтарайық, әзілдесіп, байсалды болып жатқанымызды да айта алмайсың ба!?
Dialogue: 0,0:15:38.42,0:15:44.25,jizou-ja,,0,0,0,,Сол ащы күндерді қайтарайық Неге ашпайсың?
Dialogue: 0,0:15:38.43,0:15:40.86,jp.sub-ja,,0,0,0,,Сіз қалжыңдап жатқаныңызды немесе байсалды екеніңізді білмейсіз бе?
Dialogue: 0,0:15:41.92,0:15:43.26,Style1,,0,0,0,,Сіз ашқыңыз келмейді ме?
Dialogue: 0,0:15:43.26,0:15:45.19,Style1,,0,0,0,,Ашқыңыз келмей ме? Барлығымызға Хост клубында болған ұнайды!
Dialogue: 0,0:15:43.54,0:15:45.52,jp.sub-ja,,0,0,0,,Барлығына қабылдаушы клуб ұнайды.
Dialogue: 0,0:15:45.19,0:15:46.19,Style1,,0,0,0,,бұл Пандора қорабы ішінде біздің армандарымыз құлыптаулы? Барлығымызға Хост клубында болған ұнайды!
Dialogue: 0,0:15:45.50,0:15:54.30,jizou-ja,,0,0,0,,Пандораның армандар қорабы
Dialogue: 0,0:15:46.19,0:15:49.53,Style1,,0,0,0,,бұл Пандора қорабы ішінде біздің армандарымыз құлыптаулы? Бізге өте ұнайды!
Dialogue: 0,0:15:46.66,0:15:48.05,jp.sub-ja,,0,0,0,,Маған өте ұнайды
Dialogue: 0,0:15:49.53,0:15:51.86,Style1,,0,0,0,,бұл Пандора қорабы ішінде біздің армандарымыз құлыптаулы? Тіпті мен...
Dialogue: 0,0:15:49.79,0:15:54.36,jp.sub-ja,,0,0,0,,Мен де...Мен де үйірме клубын ұнатамын.
Dialogue: 0,0:15:51.86,0:15:54.67,Style1,,0,0,0,,бұл Пандора қорабы ішінде біздің армандарымыз құлыптаулы? Тіпті маған Хост клубында болған ұнайды!
Dialogue: 0,0:15:54.67,0:15:55.87,Style1,,0,0,0,,Бұл Пандора қорабы ішінде біздің армандарымыз құлыптаулы ма?
Dialogue: 0,0:15:55.87,0:15:59.87,Style1,,0,0,0,,Бірінші жүріңіз немесе екінші жүріңіз, кез келген жолмен,
Dialogue: 0,0:15:56.27,0:16:03.21,jizou-ja,,0,0,0,,Сіз бірінші немесе екінші ойнайсыз ба, фигураларды алға жылжытсаңыз, бәрі жақсы болады!
Dialogue: 0,0:15:59.87,0:16:03.21,Style1,,0,0,0,,Қозғалсаңыз, бәрі жақсы!
Dialogue: 0,0:16:03.21,0:16:06.55,Style1,,0,0,0,,Сіз тіпті үзіліс жасай аласыз!
Dialogue: 0,0:16:03.68,0:16:10.36,jizou-ja,,0,0,0,,Демалуға болады, мен білемін.
Dialogue: 0,0:16:06.55,0:16:10.22,Style1,,0,0,0,,Мен оның қалай екенін білемін!
Dialogue: 0,0:16:10.22,0:16:12.55,Style1,,0,0,0,,Осы уақытқа дейінгі бүкіл процесс сіздің куәгеріңіз.
Dialogue: 0,0:16:10.36,0:16:16.43,jizou-ja,,0,0,0,,Осы уақытқа дейінгі процесс сіздің дәлеліңіз.
Dialogue: 0,0:16:12.55,0:16:13.55,Style1,,0,0,0,,Осы уақытқа дейінгі бүкіл процесс сіздің куәгеріңіз. Харухи!
Dialogue: 0,0:16:12.88,0:16:13.38,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:16:13.55,0:16:16.62,Style1,,0,0,0,,Осы уақытқа дейінгі бүкіл процесс сіздің куәгеріңіз.
Dialogue: 0,0:16:16.62,0:16:20.23,Style1,,0,0,0,,Оң қолыммен және сол қолыммен басымды ұстадым,
Dialogue: 0,0:16:17.47,0:16:23.64,jizou-ja,,0,0,0,,Қараңғылықты кесіп өту үшін оң және сол қолдарыңызды көтеріп, ЖЕТ!
Dialogue: 0,0:16:20.23,0:16:24.22,Style1,,0,0,0,,Қараңғылықты жарып, барамын!
Dialogue: 0,0:16:34.24,0:16:36.58,Style1,,0,0,0,,Харухи!
Dialogue: 0,0:16:34.52,0:16:35.69,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:16:36.58,0:16:38.27,Style1,,0,0,0,,Сенпай!
Dialogue: 0,0:16:36.85,0:16:37.76,jp.sub-ja,,0,0,0,,Аға
Dialogue: 0,0:17:03.20,0:17:07.87,Style1,,0,0,0,,Не деген ойсыз әрекет. Қараңызшы, сіз соның кесірінен дымқылданып жатырсыз.
Dialogue: 0,0:17:03.55,0:17:04.65,jp.sub-ja,,0,0,0,,Не деген ақымақтық.
Dialogue: 0,0:17:05.14,0:17:06.83,jp.sub-ja,,0,0,0,,Қарашы, мен саған шүкір етемін.
Dialogue: 0,0:17:07.87,0:17:09.88,Style1,,0,0,0,,Бұл маңызды емес, солай ма?
Dialogue: 0,0:17:08.12,0:17:09.20,jp.sub-ja,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:17:09.88,0:17:13.87,Style1,,0,0,0,,«Сүйікті адам тамшылайды» дегендей, солай емес пе?
Dialogue: 0,0:17:10.34,0:17:13.29,jp.sub-ja,,0,0,0,,Су тамызатын жақсы адам дейсің.
Dialogue: 0,0:17:19.05,0:17:22.32,Style1,,0,0,0,,Тама-чан! Хару-чан!
Dialogue: 0,0:17:19.33,0:17:21.64,jp.sub-ja,,0,0,0,,Тама-чан Хару-чан
Dialogue: 0,0:17:22.32,0:17:24.31,Style1,,0,0,0,,Мырза!
Dialogue: 0,0:17:22.63,0:17:24.11,jp.sub-ja,,0,0,0,,Мырза!
Dialogue: 0,0:17:25.89,0:17:28.92,Style1,,0,0,0,,Уа, неткен ақымақ.
Dialogue: 0,0:17:26.29,0:17:28.37,jp.sub-ja,,0,0,0,,Әлгі ақымақ
Dialogue: 0,0:17:30.90,0:17:32.73,Style1,,0,0,0,,Көлікті қосыңыз.
Dialogue: 0,0:17:31.09,0:17:32.08,jp.sub-ja,,0,0,0,,Маған беріңізші.
Dialogue: 0,0:17:35.90,0:17:41.07,Style1,,0,0,0,,Эклэр-сама, сен бұл әңгімелердің барлығын сол бір үй қызметкерінен естідің, солай ма?
Dialogue: 0,0:17:36.25,0:17:40.16,jp.sub-ja,,0,0,0,,Бұл туралы Эклэр мырза әлгі үй қызметкерінен естіп жүр.
Dialogue: 0,0:17:41.07,0:17:46.01,Style1,,0,0,0,,Үнемі пианинода ойнайтын ұлы туралы?
Dialogue: 0,0:17:41.40,0:17:45.08,jp.sub-ja,,0,0,0,,Маған әрқашан пианинода ойнайтын ұлым туралы.
Dialogue: 0,0:17:49.01,0:17:53.02,Style1,,0,0,0,,Ол шынымен де сүйкімді бала ма?
Dialogue: 0,0:17:49.38,0:17:51.84,jp.sub-ja,,0,0,0,,Ол сондай мейірімді бала.
Dialogue: 0,0:17:53.02,0:17:55.52,Style1,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:17:53.34,0:17:54.30,jp.sub-ja,,0,0,0,,Рахмет
Dialogue: 0,0:17:55.52,0:17:59.53,Style1,,0,0,0,,Міне, мен оған анасын қайтадан көруге рұқсат етемін.
Dialogue: 0,0:17:55.77,0:17:58.86,jp.sub-ja,,0,0,0,,Мен сені анаммен кездесуге рұқсат етемін деп ойладым.
Dialogue: 0,0:17:59.53,0:18:01.36,Style1,,0,0,0,,Ақымақ...
Dialogue: 0,0:17:59.86,0:18:00.89,jp.sub-ja,,0,0,0,,Ақымақ жігіт
Dialogue: 0,0:18:03.36,0:18:07.20,Style1,,0,0,0,,Дегенмен, тек мен үшін,
Dialogue: 0,0:18:03.62,0:18:06.14,jp.sub-ja,,0,0,0,,Бірақ мен үшін солай
Dialogue: 0,0:18:07.20,0:18:10.69,Style1,,0,0,0,,ол күлді.
Dialogue: 0,0:18:07.47,0:18:10.02,jp.sub-ja,,0,0,0,,Ол... күлді.
Dialogue: 0,0:18:30.62,0:18:33.56,Style1,,0,0,0,,Сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:18:31.02,0:18:32.70,jp.sub-ja,,0,0,0,,Мазасыздық тудырғанымыз үшін кешірім сұраймыз.
Dialogue: 0,0:18:33.56,0:18:37.96,Style1,,0,0,0,,Гранд Тоннер менің компаниямнан бас тартты.
Dialogue: 0,0:18:33.83,0:18:37.34,jp.sub-ja,,0,0,0,,Грант Найл компаниямыздан шығып кетті.
Dialogue: 0,0:18:37.96,0:18:40.57,Style1,,0,0,0,,Күтпеген қолдаушы пайда болды,
Dialogue: 0,0:18:38.38,0:18:40.20,jp.sub-ja,,0,0,0,,Күтпеген көмекші пайда болады
Dialogue: 0,0:18:40.57,0:18:42.90,Style1,,0,0,0,,компанияны Тоннерден бұрын сатып алды,
Dialogue: 0,0:18:40.80,0:18:42.92,jp.sub-ja,,0,0,0,,Тонерден бұрын сатып алынған
Dialogue: 0,0:18:42.90,0:18:47.24,Style1,,0,0,0,,, содан кейін ол барлық басқару құқықтарын маған тапсыратынын айтты.
Dialogue: 0,0:18:43.34,0:18:46.94,jp.sub-ja,,0,0,0,,Содан кейін ол маған барлық басқару құқығын беруді ұсынды.
Dialogue: 0,0:18:47.24,0:18:52.24,Style1,,0,0,0,,Бұл өте батыл болды. Ол қай қордың басшысы болды?
Dialogue: 0,0:18:47.55,0:18:49.32,jp.sub-ja,,0,0,0,,Бұл да батыл
Dialogue: 0,0:18:49.75,0:18:51.62,jp.sub-ja,,0,0,0,,Қай қор менеджері?
Dialogue: 0,0:18:52.24,0:18:54.91,Style1,,0,0,0,,«Қ.О.» атты студенттік инвестор.
Dialogue: 0,0:18:52.40,0:18:54.50,jp.sub-ja,,0,0,0,,Мен КО есімді студенттік инвестормын.
Dialogue: 0,0:18:54.91,0:19:00.25,Style1,,0,0,0,,Ол ақылды түрде оның атын жасырды, бірақ мен оның кім екенін ақырында білдім.
Dialogue: 0,0:18:55.34,0:18:57.28,jp.sub-ja,,0,0,0,,Аты-жөнімді құпия ұстасам да.
Dialogue: 0,0:18:57.67,0:18:59.55,jp.sub-ja,,0,0,0,,Мен оның не екенін білдім.
Dialogue: 0,0:19:00.25,0:19:02.25,Style1,,0,0,0,,"Қ.О."
Dialogue: 0,0:19:00.38,0:19:03.58,jp.sub-ja,,0,0,0,,КО…Қағамия Отори
Dialogue: 0,0:19:02.25,0:19:04.26,Style1,,0,0,0,,«Киёя Отори».
Dialogue: 0,0:19:04.26,0:19:08.26,Style1,,0,0,0,,Бұл менің өз ұлым емес еді.
Dialogue: 0,0:19:04.70,0:19:07.54,jp.sub-ja,,0,0,0,,Бұл ештеңе емес, бұл менің ұлым.
Dialogue: 0,0:19:08.26,0:19:11.60,Style1,,0,0,0,,Бұл болашақтан қорқу дегенді білдіреді.
Dialogue: 0,0:19:08.52,0:19:10.96,jp.sub-ja,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:19:11.60,0:19:15.60,Style1,,0,0,0,,Мен Киоякунның қандай керемет екенін білемін деп ойладым, бірақ...
Dialogue: 0,0:19:11.88,0:19:14.63,jp.sub-ja,,0,0,0,,Мен Кёуя-кунның дарынды екенін білемін деп ойладым, бірақ
Dialogue: 0,0:19:15.60,0:19:20.10,Style1,,0,0,0,,Жоқ, сіздің ұлыңыз нағыз ғажап.
Dialogue: 0,0:19:15.83,0:19:19.62,jp.sub-ja,,0,0,0,,Жоқ, шынымен таң қалдырғаны – сіздің ұлыңыз.
Dialogue: 0,0:19:21.77,0:19:26.28,Style1,,0,0,0,,Кёяға білім берген менмін.
Dialogue: 0,0:19:22.08,0:19:24.79,jp.sub-ja,,0,0,0,,Мен Кюяға білім беріп келе жатқан адаммын.
Dialogue: 0,0:19:26.28,0:19:30.62,Style1,,0,0,0,,Мен оның ағаларынан да тамаша екенін білдім.
Dialogue: 0,0:19:26.43,0:19:29.36,jp.sub-ja,,0,0,0,,Мен оның ағаларынан артық екенін білдім.
Dialogue: 0,0:19:30.62,0:19:35.29,Style1,,0,0,0,,Дегенмен, мен білетін Kyoya компанияны басып алуы мүмкін болса да,
Dialogue: 0,0:19:30.95,0:19:35.25,jp.sub-ja,,0,0,0,,Бірақ мен білетін Киойя басып алу сияқты бірдеңе жасайды.
Dialogue: 0,0:19:35.29,0:19:38.79,Style1,,0,0,0,,ол маған бәрін қайтару сияқты ештеңе жасамас еді.
Dialogue: 0,0:19:35.55,0:19:38.02,jp.sub-ja,,0,0,0,,Мен оны толығымен қайталамаймын.
Dialogue: 0,0:19:38.79,0:19:43.30,Style1,,0,0,0,,Мен Киёяны осы уақыт бойы басып алудың сәбізін салбыратып тұрып алып келдім
Dialogue: 0,0:19:39.05,0:19:40.23,jp.sub-ja,,0,0,0,,Мен Киёямын
Dialogue: 0,0:19:40.73,0:19:44.16,jp.sub-ja,,0,0,0,,Отори отбасы басқаратын компанияның мұрагері болудың жемі.
Dialogue: 0,0:19:43.30,0:19:46.89,Style1,,0,0,0,,оның алдында Отори отбасы басқаратын компаниялар.
Dialogue: 0,0:19:44.35,0:19:46.34,jp.sub-ja,,0,0,0,,Мен көптен бері жыпылықтап өстім
Dialogue: 0,0:19:48.23,0:19:53.41,Style1,,0,0,0,,Бірақ ол оны менен күштеп алып қана қойған жоқ,
Dialogue: 0,0:19:48.59,0:19:49.69,jp.sub-ja,,0,0,0,,Бірақ ол...
Dialogue: 0,0:19:50.61,0:19:52.86,jp.sub-ja,,0,0,0,,Оны өз қабілетімен ұстаған соң,
Dialogue: 0,0:19:53.41,0:19:58.41,Style1,,0,0,0,,ол мұны қаламайтынын айтты да, бетіме итеріп жіберді.
Dialogue: 0,0:19:53.80,0:19:57.44,jp.sub-ja,,0,0,0,,Ол мұны қаламайтынын айтып, дәл мұрныма тықты.
Dialogue: 0,0:19:58.41,0:20:01.40,Style1,,0,0,0,,Мұның нені білдіретінін түсінесіз бе?
Dialogue: 0,0:19:58.70,0:20:00.56,jp.sub-ja,,0,0,0,,Бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:20:02.92,0:20:05.75,Style1,,0,0,0,,Ол тапты.
Dialogue: 0,0:20:03.24,0:20:04.88,jp.sub-ja,,0,0,0,,Ол оны тапты.
Dialogue: 0,0:20:05.75,0:20:09.25,Style1,,0,0,0,,Ол үшін одан да құнды нәрсе.
Dialogue: 0,0:20:06.04,0:20:08.15,jp.sub-ja,,0,0,0,,Құндырақ нәрсе
Dialogue: 0,0:20:09.25,0:20:12.25,Style1,,0,0,0,,Бұл Тамаки-кунның арқасы болса керек.
Dialogue: 0,0:20:09.61,0:20:11.60,jp.sub-ja,,0,0,0,,Тамаки-кунның арқасында шығар
Dialogue: 0,0:20:23.60,0:20:26.94,Style1,,0,0,0,,Біз бір-бірімізбен біршама бәсекеге қабілетті болдық,
Dialogue: 0,0:20:23.87,0:20:26.59,jp.sub-ja,,0,0,0,,Мен сендермен қандай да бір жолмен жарысып жүрмін.
Dialogue: 0,0:20:26.94,0:20:29.61,Style1,,0,0,0,,бірақ бұдан былай біз жақсы араласатын шығармыз.
Dialogue: 0,0:20:27.15,0:20:29.02,jp.sub-ja,,0,0,0,,Менің ойымша, біз қазірден бастап жақсы араласамыз.
Dialogue: 0,0:20:29.61,0:20:35.61,Style1,,0,0,0,,Иә. Екеуміздің араласқанымызды қалаймын. Біздің ұлдарымыз сияқты.
Dialogue: 0,0:20:30.00,0:20:32.34,jp.sub-ja,,0,0,0,,Иә, мен тіл табысқым келеді.
Dialogue: 0,0:20:33.13,0:20:34.23,jp.sub-ja,,0,0,0,,Менің ұлдарым сияқты.
Dialogue: 0,0:20:35.61,0:20:39.62,Style1,,0,0,0,,О, дұрыс, мен сізбен бір нәрсені білгім келді.
Dialogue: 0,0:20:37.11,0:20:38.98,jp.sub-ja,,0,0,0,,Мен бір нәрсені растағым келді.
Dialogue: 0,0:20:39.62,0:20:45.22,Style1,,0,0,0,,Сол құрметті студент қыз Фудзиока Харухи, солай ма?
Dialogue: 0,0:20:40.03,0:20:44.00,jp.sub-ja,,0,0,0,,Стипендия студентінің қызы, менің ойымша, ол Харухи Фудзиока.
Dialogue: 0,0:20:45.22,0:20:48.89,Style1,,0,0,0,,Мен оны болашақта Кёяға үйлендіруді ойлап жүрмін.
Dialogue: 0,0:20:45.40,0:20:48.39,jp.sub-ja,,0,0,0,,Менің ойымша, ол қыз болашақта Кёяның әйелі болады.
Dialogue: 0,0:20:48.89,0:20:51.56,Style1,,0,0,0,,Осыны есте сақтаңыз.
Dialogue: 0,0:20:49.10,0:20:50.85,jp.sub-ja,,0,0,0,,Есіңізде болсын
Dialogue: 0,0:20:51.56,0:20:54.57,Style1,,0,0,0,,Мен сенімен тіл табыса алмайтын шығармын.
Dialogue: 0,0:20:51.73,0:20:54.21,jp.sub-ja,,0,0,0,,Өйткені, мен сенімен тіл табыса алмаймын.
Dialogue: 0,0:20:54.57,0:20:59.73,Style1,,0,0,0,,Барлық басқа нәрселерді былай қойғанда, бұл мен мойындамайтын нәрсе.
Dialogue: 0,0:20:54.94,0:20:58.93,jp.sub-ja,,0,0,0,,Басқа нәрселерге қарамастан, мен бұл бір нәрседе ымыраға келе алмаймын.
Dialogue: 0,0:21:01.41,0:21:04.74,Style1,,0,0,0,,Ең алдымен әлеуметтік жағдайы барлар,
Dialogue: 0,0:21:01.62,0:21:03.48,jp.sub-ja,,0,0,0,,Бұл жеке Уран академиясы
Dialogue: 0,0:21:03.92,0:21:05.98,jp.sub-ja,,0,0,0,,Біріншіден, отбасы жағдайы, екіншіден, ақша.
Dialogue: 0,0:21:04.74,0:21:08.91,Style1,,0,0,0,,және екіншіден, ақшамен- өз уақыттарын осында, жеке Уран академиясында өткізеді.
Dialogue: 0,0:21:06.54,0:21:08.22,jp.sub-ja,,0,0,0,,Байлығы барлардың бос уақыты болады.
Dialogue: 0,0:21:08.91,0:21:10.92,Style1,,0,0,0,,Осылайша, Ouran Host Club - әдемі ұлдар
Dialogue: 0,0:21:09.30,0:21:10.89,jp.sub-ja,,0,0,0,,Сонымен, Ouran Host Club дегеніміз не?
Dialogue: 0,0:21:10.92,0:21:13.59,Style1,,0,0,0,,тым көп уақыт жұмсап, қыздардың көңілін көтереді,
Dialogue: 0,0:21:11.37,0:21:13.40,jp.sub-ja,,0,0,0,,Бос уақыты тым көп әдемі ұлдар
Dialogue: 0,0:21:13.59,0:21:18.26,Style1,,0,0,0,,кімнің де қолында тым көп уақыты бар.
Dialogue: 0,0:21:13.81,0:21:17.41,jp.sub-ja,,0,0,0,,Бос студент қыздарды байыту.
Dialogue: 0,0:21:18.26,0:21:23.09,Style1,,0,0,0,,Бұл өте байлар үшін мектептің жеке, талғампаз ойын алаңы.
Dialogue: 0,0:21:18.62,0:21:20.50,jp.sub-ja,,0,0,0,,Өте бай мектеп бірегей
Dialogue: 0,0:21:21.07,0:21:22.56,jp.sub-ja,,0,0,0,,Бұл тамаша ойын.
Dialogue: 0,0:21:30.60,0:21:33.27,Style1,,0,0,0,,Егер сіздің қиялыңыз сізді жетелейтін болса, бізге келіңіз
Dialogue: 0,0:21:31.03,0:21:31.70,jp.sub-ja,,0,0,0,,Егер сізге ұнаса
Dialogue: 0,0:21:32.01,0:21:34.94,jp.sub-ja,,0,0,0,,Киім бөлмесіне келіңіз.
Dialogue: 0,0:21:33.27,0:21:35.44,Style1,,0,0,0,,№3 музыкалық залда, кез келген уақытта.
Dialogue: 0,0:21:35.44,0:21:38.28,Style1,,0,0,0,,- Барлығымыз осында, Хост клубында... - Барлығымыз осында, Хост клубында...
Dialogue: 0,0:21:35.86,0:21:37.80,jp.sub-ja,,0,0,0,,Барлығымыз қабылдау бөлімінде
Dialogue: 0,0:21:38.28,0:21:42.45,Style1,,0,0,0,,...шын жүректен...
Dialogue: 0,0:21:38.62,0:21:41.33,jp.sub-ja,,0,0,0,,Біз сізді шын жүректен қарсы аламыз
Dialogue: 0,0:21:42.05,0:21:47.64,Style2,,0,0,0,,«Біз сені күтеміз».
Dialogue: 0,0:21:42.45,0:21:44.72,Style1,,0,0,0,,...сізді күтеді.
Dialogue: 0,0:21:42.90,0:21:44.19,jp.sub-ja,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:21:48.44,0:21:50.62,MATA-JP-ja,,0,0,0,,Есікті ашқанда, бар
Dialogue: 0,0:21:59.69,0:22:07.10,MATA-JP-ja,,0,0,0,,Біз сізді әрқашан осында күтеміз.
Dialogue: 0,0:22:08.45,0:22:15.84,MATA-JP-ja,,0,0,0,,Егер бірдеңе орын алса, ол туралы айтыңыз.
Dialogue: 0,0:22:16.28,0:22:20.71,MATA-JP-ja,,0,0,0,,Мен осы уақытқа дейін жылап келдім (жылама)
Dialogue: 0,0:22:20.71,0:22:24.75,MATA-JP-ja,,0,0,0,,Сенің де мұңды жүзің
Dialogue: 0,0:22:24.85,0:22:33.55,MATA-JP-ja,,0,0,0,,Қараңызшы, сіз оны білмей тұрып, біз оны күлімсіреуге айналдырамыз (күлімсіреу ~)
Dialogue: 0,0:22:33.55,0:22:37.98,MATA-JP-ja,,0,0,0,,Мен сені ертең тағы да күлімдегеніңді көремін деп үміттенемін
Dialogue: 0,0:22:38.89,0:22:43.34,MATA-JP-ja,,0,0,0,,Ашық көк аспанда қалықтаған бұлт сияқты
Dialogue: 0,0:22:43.34,0:22:46.63,MATA-JP-ja,,0,0,0,,Жүрегім күн нұрына шомылды
Dialogue: 0,0:22:47.18,0:22:52.83,MATA-JP-ja,,0,0,0,,Менімен бірге жүруді бастайық
Dialogue: 0,0:22:52.90,0:22:53.64,MATA-JP-ja,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:22:53.73,0:22:55.09,MATA-JP-ja,,0,0,0,,Бұл қызық.
Dialogue: 0,0:22:57.81,0:22:59.39,MATA-JP-ja,,0,0,0,,Бұл қарапайым халықтың әні ме?
Dialogue: 0,0:23:00.65,0:23:08.46,MATA-JP-ja,,0,0,0,,Сіз ақымақ әзілге күлуіңіз мүмкін, бірақ
Dialogue: 0,0:23:09.54,0:23:16.92,MATA-JP-ja,,0,0,0,,Біз сіздің бақытты жүзіңізді әрқашан көргіміз келеді.
Dialogue: 0,0:23:17.38,0:23:21.19,MATA-JP-ja,,0,0,0,,Жол бойы жаңбыр жауды (жарайды)
Dialogue: 0,0:23:21.80,0:23:24.98,MATA-JP-ja,,0,0,0,,Тіпті жаңбырлы бұлттар да
Dialogue: 0,0:23:25.93,0:23:30.72,MATA-JP-ja,,0,0,0,,Қараңызшы, егер бұл біз болсақ (не болды, Мицукуни), күліп жіберіңізші?
Dialogue: 0,0:23:31.07,0:23:34.58,MATA-JP-ja,,0,0,0,,Сіз сонда жүре аласыз (сол жерде жүре аласыз~)
Dialogue: 0,0:23:34.60,0:23:38.73,MATA-JP-ja,,0,0,0,,Мен сені ертең тағы да күлімдегеніңді көремін деп үміттенемін
Dialogue: 0,0:23:40.04,0:23:44.39,MATA-JP-ja,,0,0,0,,Шеңбер бойымен қосылған қолдарымыздың жылуы
Dialogue: 0,0:23:44.44,0:23:47.41,MATA-JP-ja,,0,0,0,,Мәңгілікке ұмытпа
Dialogue: 0,0:23:48.19,0:23:53.69,MATA-JP-ja,,0,0,0,,Менімен бірге жүруді бастайық
Dialogue: 0,0:23:53.69,0:24:02.46,MATA-JP-ja,,0,0,0,,Тіпті біз ұрысып, бір-бірімізден өтіп кеткен кезде де (қандай жағдай болса да)
Dialogue: 0,0:24:02.46,0:24:09.36,MATA-JP-ja,,0,0,0,,Сізбен кездескеніме өкінбеймін (кеттік)
Dialogue: 0,0:24:09.36,0:24:13.93,MATA-JP-ja,,0,0,0,,Мен сені ертең тағы да күлімдегеніңді көремін деп үміттенемін
Dialogue: 0,0:24:14.85,0:24:19.24,MATA-JP-ja,,0,0,0,,Ашық көк аспанда қалықтаған бұлт сияқты
Dialogue: 0,0:24:19.24,0:24:22.68,MATA-JP-ja,,0,0,0,,Жүрегім күн сәулесіне шомылды
Dialogue: 0,0:24:23.17,0:24:26.73,MATA-JP-ja,,0,0,0,,Жүруді бастайық
Dialogue: 0,0:24:26.73,0:24:31.28,MATA-JP-ja,,0,0,0,,Мен сені ертең тағы да күлімдегеніңді көремін деп үміттенемін
Dialogue: 0,0:24:32.40,0:24:36.84,MATA-JP-ja,,0,0,0,,Шеңбер бойымен қосылған қолдарымыздың жылуы
Dialogue: 0,0:24:36.84,0:24:39.84,MATA-JP-ja,,0,0,0,,Мәңгі ұмытпа (сенпай~)
Dialogue: 0,0:24:40.52,0:24:44.39,MATA-JP-ja,,0,0,0,,Жүруді бастайық (Ей, балалар, Харухиден аулақ болыңдар)
Dialogue: 0,0:24:44.39,0:24:49.54,MATA-JP-ja,,0,0,0,,Мен сені ертең күлімдегеніңді көремін деп үміттенемін (бұл қызық)
Dialogue: 0,0:24:49.81,0:24:54.20,MATA-JP-ja,,0,0,0,,Ашық көк аспанда қалқып бара жатқан бұлттар сияқты (балалар)
Dialogue: 0,0:24:54.20,0:24:57.60,MATA-JP-ja,,0,0,0,,Күн сәулесіне толық шомылу
Dialogue: 0,0:24:58.07,0:25:03.79,MATA-JP-ja,,0,0,0,,Менімен серуендеуді бастайық (жақсы, жарайды)
Dialogue: 0,0:25:03.36,0:25:08.36,staff-ja,,0,0,0,,Білім бөлімі
Dialogue: 0,0:25:03.66,0:25:08.66,staff-ja,,0,0,0,,Маки қоян
Dialogue: 0,0:25:03.96,0:25:08.96,staff-ja,,0,0,0,,Хагакуре Ариса Гинка
Dialogue: 0,0:25:04.26,0:25:09.26,staff-ja,,0,0,0,,Косодэ Суми Суми гүлінің түсіндірмесі
Dialogue: 0,0:25:04.56,0:25:09.56,staff-ja,,0,0,0,,Қара мысық Йогюджи Онишина
Dialogue: 0,0:25:04.86,0:25:09.86,staff-ja,,0,0,0,,...
Dialogue: 0,0:25:05.16,0:25:10.16,staff-ja,,0,0,0,,Сюра Мам
Dialogue: 0,0:25:08.10,0:25:08.99,MATA-JP-ja,,0,0,0,,Харухи
Dialogue: 0,0:25:09.53,0:25:10.29,MATA-JP-ja,,0,0,0,,Ертең кездескенше~
