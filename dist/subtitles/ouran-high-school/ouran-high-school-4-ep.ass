Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.80,staff-ja,,0,0,0,,Mam
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Жапония
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Syura
Dialogue: 0,0:00:00.00,0:00:03.17,staff-ja,,0,0,0,,Хагакуре аудармасы
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Уақыт көлігі жын куна
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Наксияның әкімшілік жүйесі
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,OP&ED Hagakure
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,Сюра
Dialogue: 0,0:00:00.00,0:00:03.88,Default11-ja,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:00:08.98,0:00:12.31,Style2,,0,0,0,,"Мен сені жақсы көремін. Мен тек сенсің".
Dialogue: 0,0:00:09.08,0:00:09.78,jp.sub-ja,NTP,0,0,0,,Маған ұнайды
Dialogue: 0,0:00:10.34,0:00:11.94,jp.sub-ja,NTP,0,0,0,,Мен тек сені ойлап отырмын
Dialogue: 0,0:00:12.31,0:00:14.98,Style2,,0,0,0,,«Қалған өмірімізді бірге өткізейік, тек екеуміз».
Dialogue: 0,0:00:12.52,0:00:15.32,jp.sub-ja,NTP,0,0,0,,Бұдан былай сен барлық уақытыңды менімен жалғыз өткізесің.
Dialogue: 0,0:00:14.98,0:00:16.54,Style2,,0,0,0,,«Мен бақыттымын, Мияби- кун'' «Қазір алмаймын...»
Dialogue: 0,0:00:17.32,0:00:20.35,Style1,,0,0,0,,Мен бақыттымын, Мияби-кун.
Dialogue: 0,0:00:17.38,0:00:19.58,jp.sub-ja,NTP,0,0,0,,Мен бақыттымын, Маса-кун.
Dialogue: 0,0:00:22.99,0:00:26.98,Style1,,0,0,0,,ханым? Ұстаз үйіне қайтты.
Dialogue: 0,0:00:23.19,0:00:26.36,jp.sub-ja,NTP,0,0,0,,Ханым, сіздің күйеуіңіз үйге оралды.
Dialogue: 0,0:00:28.66,0:00:30.19,Style1,,0,0,0,,ханым?
Dialogue: 0,0:00:28.73,0:00:29.56,jp.sub-ja,NTP,0,0,0,,Ол келді.
Dialogue: 0,0:00:31.32,0:00:32.00,jp.sub-ja,NTP,0,0,0,,Лотос
Dialogue: 0,0:00:31.33,0:00:32.86,Style1,,0,0,0,,Ауқым...
Dialogue: 0,0:00:34.67,0:00:37.36,jp.sub-ja,NTP,0,0,0,,Ренге ойындарды жақсы көреді.
Dialogue: 0,0:00:34.67,0:00:38.34,Style1,,0,0,0,,Ренге, сен бұл ойындарды шынымен жақсы көресің, иә?
Dialogue: 0,0:00:38.34,0:00:39.34,Style1,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:00:38.52,0:00:39.29,jp.sub-ja,NTP,0,0,0,,Менде «B» рейтингі бар!
Dialogue: 0,0:00:39.34,0:00:40.68,Style1,,0,0,0,,Жоқ, жоқ,
Dialogue: 0,0:00:40.68,0:00:43.95,Style1,,0,0,0,,сенің әкең сенің өміріңді еркін әрі еркін өткізгеніңді қалайды, Ренге,
Dialogue: 0,0:00:40.90,0:00:45.24,jp.sub-ja,NTP,0,0,0,,Әкем Ренгенің еркін және өз қалауынша өмір сүргенін қалайды.
Dialogue: 0,0:00:43.95,0:00:45.61,Style1,,0,0,0,,Қалай болса да өмір сүргіңіз келеді.
Dialogue: 0,0:00:45.61,0:00:50.29,Style1,,0,0,0,,Егер бірдеңе істегіңіз келсе, мен сізге рұқсат етемін. Мен уәде беремін.
Dialogue: 0,0:00:45.89,0:00:49.33,jp.sub-ja,NTP,0,0,0,,Мен сенің қалағаныңды істеймін, уәде беремін.
Dialogue: 0,0:00:50.29,0:00:51.88,Style1,,0,0,0,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:00:52.29,0:00:56.12,Style2,,0,0,0,,«Франция»
Dialogue: 0,0:00:53.96,0:00:56.63,Style1,,0,0,0,,Сіздің Жапониядағы бизнесіңіз қалай болды?
Dialogue: 0,0:00:54.02,0:00:56.22,jp.sub-ja,NTP,0,0,0,,Жапониядағы жұмысыңыз қалай өтті?
Dialogue: 0,0:00:56.63,0:00:59.29,Style1,,0,0,0,,Бұл жақсы шығуы керек. О, дұрыс,
Dialogue: 0,0:00:56.81,0:00:58.23,jp.sub-ja,NTP,0,0,0,,Бұл жұмыс істейтін сияқты.
Dialogue: 0,0:00:58.62,0:01:02.30,jp.sub-ja,NTP,0,0,0,,Дұрыс, мен өткен аптада бір іскер серіктестің отбасымен кешкі ас іштім.
Dialogue: 0,0:00:59.29,0:01:02.63,Style1,,0,0,0,,Өткен аптада мен өз клиенттерімнің бірінің үйінде кешкі ас іштім.
Dialogue: 0,0:01:02.63,0:01:04.94,jp.sub-ja,NTP,0,0,0,,Қараңызшы, бұл сол кездегі фото.
Dialogue: 0,0:01:02.63,0:01:05.46,Style1,,0,0,0,,Мұнда. Бұл одан алынған фотосурет.
Dialogue: 0,0:01:07.97,0:01:11.24,Style1,,0,0,0,,Олардың да орта мектепте баласы болған.
Dialogue: 0,0:01:08.12,0:01:10.81,jp.sub-ja,NTP,0,0,0,,Ол жерде де жоғары сынып оқушысы болды.
Dialogue: 0,0:01:12.98,0:01:15.03,Style1,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:01:13.10,0:01:14.18,jp.sub-ja,NTP,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:01:16.98,0:01:19.65,Style1,,0,0,0,,Мен оған үйленемін!
Dialogue: 0,0:01:17.00,0:01:18.99,jp.sub-ja,NTP,0,0,0,,Мен оған үйленемін
Dialogue: 0,0:01:19.65,0:01:23.32,Style1,,0,0,0,,Маған бұрын берген уәдеңде тұршы, әке!
Dialogue: 0,0:01:19.84,0:01:23.09,jp.sub-ja,NTP,0,0,0,,Әке, бұрын берген уәдеңізді міндетті түрде орындаңыз.
Dialogue: 0,0:01:23.32,0:01:25.32,Style1,,0,0,0,,H-эй, Ренге...
Dialogue: 0,0:01:23.48,0:01:25.14,jp.sub-ja,NTP,0,0,0,,Ой Ренге
Dialogue: 0,0:01:25.32,0:01:28.22,Style1,,0,0,0,,Күте тұрыңыз, ханзада!
Dialogue: 0,0:01:25.53,0:01:27.72,jp.sub-ja,NTP,0,0,0,,Мені күт, ханзада
Dialogue: 0,0:01:34.66,0:01:36.33,Style1,,0,0,0,,Ренге!
Dialogue: 0,0:01:34.79,0:01:38.36,jp.sub-ja,NTP,0,0,0,,Lotus Lotus ~
Dialogue: 0,0:01:36.33,0:01:38.49,Style1,,0,0,0,,Ренге!!
Dialogue: 0,0:01:44.54,0:01:46.47,Style2,,0,0,0,,«Хост клубы енді бизнес үшін ашық»
Dialogue: 0,0:01:44.94,0:01:46.61,Style1,,0,0,0,,Тамаки-кун...
Dialogue: 0,0:01:45.22,0:01:49.48,jp.sub-ja,NTP,0,0,0,,Тамаки-кун Тамаки-кун неге сонша әдемі?
Dialogue: 0,0:01:46.61,0:01:49.61,Style1,,0,0,0,,Тамаки-кун, сен неге әдемісің?
Dialogue: 0,0:01:49.61,0:01:53.07,jp.sub-ja,NTP,0,0,0,,Себебі мен сенің көзіңде бір секунд болса да қалғым келеді
Dialogue: 0,0:01:49.61,0:01:53.28,Style1,,0,0,0,,Себебі мен сенің көзіңді алғым келеді, бір секунд болса да.
Dialogue: 0,0:01:53.28,0:01:55.95,Style1,,0,0,0,,Даусыңыз неге жұмсақ?
Dialogue: 0,0:01:55.95,0:01:59.96,Style1,,0,0,0,,Менің сезімім сенің жүрегіңе жетуі үшін.
Dialogue: 0,0:01:56.04,0:01:59.62,jp.sub-ja,NTP,0,0,0,,Ойларым жүрегіңе жетсін
Dialogue: 0,0:01:59.96,0:02:02.81,jp.sub-ja,NTP,0,0,0,,Неге маған дымқыл көздеріңмен қарап тұрсың?
Dialogue: 0,0:01:59.96,0:02:03.63,Style1,,0,0,0,,Неге маған дымқыл көзбен қарайсың?
Dialogue: 0,0:02:03.63,0:02:05.64,jp.sub-ja,NTP,0,0,0,,Сіздің күлкіңіз
Dialogue: 0,0:02:03.63,0:02:09.30,Style1,,0,0,0,,Өйткені сенің балғын, жас күлкің менің жүрегімдегі көктемді тасып жібереді.
Dialogue: 0,0:02:06.10,0:02:08.96,jp.sub-ja,NTP,0,0,0,,Жүрегімнің бұлағын төгеді.
Dialogue: 0,0:02:09.30,0:02:11.30,Style1,,0,0,0,,- Тамаки- кун... - Тамаки- кун... - Тамаки- кун...
Dialogue: 0,0:02:09.42,0:02:10.52,jp.sub-ja,NTP,0,0,0,,Тамаки-кун
Dialogue: 0,0:02:11.30,0:02:14.30,Style1,,0,0,0,,Екеуің бір-біріне сәйкес келетін кимоно киетін едіңдер, иә?
Dialogue: 0,0:02:11.37,0:02:14.08,jp.sub-ja,NTP,0,0,0,,Екеуі бір-біріне сай кимоно киіп алған.
Dialogue: 0,0:02:14.28,0:02:17.32,jp.sub-ja,NTP,0,0,0,,Бүгінгінің барлығын анам жасаған.
Dialogue: 0,0:02:14.30,0:02:17.64,Style1,,0,0,0,,Бүгінгі күні барлығының киетін киімдерін анамыз құрастырған.
Dialogue: 0,0:02:16.17,0:02:21.77,Style2,,0,0,0,,«Сұлулық»
Dialogue: 0,0:02:17.61,0:02:20.07,jp.sub-ja,NTP,0,0,0,,Қаласаңыз, тапсырысыңызды қабылдаймын.
Dialogue: 0,0:02:17.64,0:02:19.98,Style1,,0,0,0,,Қаласаңыз, тапсырысыңызды қабылдай аламыз.
Dialogue: 0,0:02:19.98,0:02:22.31,Style1,,0,0,0,,Бізді киіндірген әжеміз еді.
Dialogue: 0,0:02:20.23,0:02:21.92,jp.sub-ja,NTP,0,0,0,,Оны кигізген әжем.
Dialogue: 0,0:02:22.31,0:02:26.65,Style1,,0,0,0,,Әрине, сені шешіндіру менің міндетім, Каору.
Dialogue: 0,0:02:22.48,0:02:26.45,jp.sub-ja,NTP,0,0,0,,Әрине, сенің киіміңді шешіп беру менің міндетім, Каору.
Dialogue: 0,0:02:26.65,0:02:28.32,Style1,,0,0,0,,Хикару...
Dialogue: 0,0:02:26.96,0:02:30.60,jp.sub-ja,NTP,0,0,0,,Хикари Мен бәрінің алдында ұяламын
Dialogue: 0,0:02:28.32,0:02:31.38,Style1,,0,0,0,,Мені басқалардың алдында ұятқа қалдырдың...
Dialogue: 0,0:02:31.07,0:02:34.24,jp.sub-ja,NTP,0,0,0,,Ах, мен сені қазір киіміңді шешіп беремін деп сенбеймін.
Dialogue: 0,0:02:32.99,0:02:34.99,Style1,,0,0,0,,- Қандай нәзік құшақ! -Олар тағы да ақымақтықтарына көнді.
Dialogue: 0,0:02:33.28,0:02:34.82,jp.sub-ja,NTP,0,0,0,,Сен тағы да ақымақсың.
Dialogue: 0,0:02:34.32,0:02:35.71,jp.sub-ja,NTP,0,0,0,,Жоқ~
Dialogue: 0,0:02:34.99,0:02:36.33,Style1,,0,0,0,,Харухи-кун!
Dialogue: 0,0:02:35.09,0:02:38.14,jp.sub-ja,NTP,0,0,0,,Харухи, сен де кимоно киген сүйкімді көрінесің.
Dialogue: 0,0:02:36.33,0:02:37.99,Style1,,0,0,0,,Сіз кимоно киген өте сүйкімді көрінесіз.
Dialogue: 0,0:02:37.99,0:02:40.00,Style1,,0,0,0,,Сіз ондағы қызға ұқсайсыз.
Dialogue: 0,0:02:38.20,0:02:39.79,jp.sub-ja,NTP,0,0,0,,Дәл қыз сияқты
Dialogue: 0,0:02:40.00,0:02:41.00,Style1,,0,0,0,,Иә...
Dialogue: 0,0:02:40.96,0:02:42.57,jp.sub-ja,NTP,0,0,0,,Харухи, сіз ұсынылып отырсыз.
Dialogue: 0,0:02:41.00,0:02:43.00,Style1,,0,0,0,,Харухи, сені сұрады.
Dialogue: 0,0:02:43.00,0:02:46.27,Style1,,0,0,0,,Сіздің клиенттеріңіз соңғы уақытта жақсы тұрақтанды, солай емес пе?
Dialogue: 0,0:02:43.10,0:02:45.99,jp.sub-ja,NTP,0,0,0,,Соңғы уақытта тұтынушыларға қызмет көрсету әлдеқайда тұрақты болды, солай емес пе?
Dialogue: 0,0:02:46.27,0:02:47.60,Style1,,0,0,0,,Оны жалғастырыңыз.
Dialogue: 0,0:02:46.29,0:02:47.27,jp.sub-ja,NTP,0,0,0,,Міне осылай.
Dialogue: 0,0:02:47.60,0:02:51.27,Style1,,0,0,0,,Біз сіз бастаған бастапқы қарыз бойынша пайыздарды есептеуді жоспарламаймыз,
Dialogue: 0,0:02:47.77,0:02:51.24,jp.sub-ja,NTP,0,0,0,,Менің төленуі тиіс қарыз бойынша өсім алайын деген ниетім жоқ.
Dialogue: 0,0:02:51.27,0:02:53.28,Style1,,0,0,0,,сондықтан тынбай жұмыс істеп, оны төлеңіз.
Dialogue: 0,0:02:51.28,0:02:52.77,jp.sub-ja,NTP,0,0,0,,Қолыңыздан келгеннің бәрін жасап, ақша табыңыз.
Dialogue: 0,0:02:53.28,0:02:56.95,Style1,,0,0,0,,Бұл кимононың жалдау ақысы түшкіретін ештеңе емес.
Dialogue: 0,0:02:53.41,0:02:56.78,jp.sub-ja,NTP,0,0,0,,Бұл кимононың жалға алу ақысы да ақылға сыймайды.
Dialogue: 0,0:02:56.95,0:02:59.62,Style1,,0,0,0,,Мына жігіт, қисық судья кім?
Dialogue: 0,0:02:57.11,0:02:59.24,jp.sub-ja,NTP,0,0,0,,Бұл адам зұлым судья ма?
Dialogue: 0,0:02:59.62,0:03:00.62,Style1,,0,0,0,,Кёя-сама...
Dialogue: 0,0:02:59.72,0:03:00.67,jp.sub-ja,NTP,0,0,0,,Кёуя-сама
Dialogue: 0,0:03:00.62,0:03:02.95,Style1,,0,0,0,,Сен тым көпсің, анау кимонода.
Dialogue: 0,0:03:00.72,0:03:02.91,jp.sub-ja,NTP,0,0,0,,Мен ол кимоноға шыдай алмаймын.
Dialogue: 0,0:03:02.95,0:03:06.29,Style1,,0,0,0,,Хост клубының жаңа фото жинақтары шығып жатыр ма?
Dialogue: 0,0:03:03.20,0:03:06.20,jp.sub-ja,NTP,0,0,0,,Хост клубының жаңа фотокітабы әлі шыққан жоқ.
Dialogue: 0,0:03:06.29,0:03:08.96,Style1,,0,0,0,,Өкінішке орай, қазір ештеңе жоспарланбаған.
Dialogue: 0,0:03:06.39,0:03:08.85,jp.sub-ja,NTP,0,0,0,,Өкінішке орай, қазіргі жоспарлар
Dialogue: 0,0:03:08.96,0:03:10.96,Style1,,0,0,0,,Клуб ақшаның көп бөлігін табады...
Dialogue: 0,0:03:09.12,0:03:11.09,jp.sub-ja,NTP,0,0,0,,Біздің бөлім тауарларды сатады.
Dialogue: 0,0:03:10.96,0:03:13.30,Style1,,0,0,0,,...жарнамалық заттарды сатудан, солай ма?
Dialogue: 0,0:03:11.16,0:03:12.81,jp.sub-ja,NTP,0,0,0,,Мен сіз көп ақша табасыз деп ойлаймын.
Dialogue: 0,0:03:13.20,0:03:15.40,jp.sub-ja,NTP,0,0,0,,Тауардың өзі әлсіз.
Dialogue: 0,0:03:13.30,0:03:15.96,Style1,,0,0,0,,Жарнамалық заттардың өзі нашар.
Dialogue: 0,0:03:15.96,0:03:19.97,Style1,,0,0,0,,Фото жинақтар - бұл жасырын камерадан түсірілген әуесқойлар.
Dialogue: 0,0:03:16.18,0:03:20.00,jp.sub-ja,NTP,0,0,0,,Фотокітап деп аталса да, оны әуесқой жасырын түсірген.
Dialogue: 0,0:03:19.97,0:03:23.64,Style1,,0,0,0,,Үйірме шығындарын мектеп бюджетінен бұдан да көбірек алу үшін,
Dialogue: 0,0:03:20.24,0:03:23.23,jp.sub-ja,NTP,0,0,0,,Мектеп бюджетінен ведомстволық шығындарды көбірек алу үшін
Dialogue: 0,0:03:23.59,0:03:26.53,jp.sub-ja,NTP,0,0,0,,Біз жақсырақ өнімдерді әзірлеуіміз керек
Dialogue: 0,0:03:23.64,0:03:26.98,Style1,,0,0,0,,біз жоғары сапалы өнімдер шығаруды бастауымыз керек.
Dialogue: 0,0:03:26.96,0:03:28.41,jp.sub-ja,NTP,0,0,0,,Өйткені бұл адам
Dialogue: 0,0:03:26.98,0:03:31.64,Style1,,0,0,0,,Оның арқасында ғана бұл клуб банкротқа ұшырамай жұмыс істей алады.
Dialogue: 0,0:03:28.53,0:03:31.38,jp.sub-ja,NTP,0,0,0,,Менің ойымша, олар бұл бөлімді банкротқа ұшыратпай басқара алады.
Dialogue: 0,0:03:32.65,0:03:34.98,Style1,,0,0,0,,Хару-чан, Хару-чан...
Dialogue: 0,0:03:32.76,0:03:34.64,jp.sub-ja,NTP,0,0,0,,Хару-чан Хару-чан
Dialogue: 0,0:03:34.98,0:03:38.38,Style1,,0,0,0,,Мен бір сандалымды жоғалтып алдым.
Dialogue: 0,0:03:35.13,0:03:37.85,jp.sub-ja,NTP,0,0,0,,Сандалдың біреуі жоқ.
Dialogue: 0,0:03:39.66,0:03:41.99,Style1,,0,0,0,,Сіз оларды біраз уақыт бұрын ғана кигенсіз, солай емес пе?
Dialogue: 0,0:03:39.72,0:03:41.76,jp.sub-ja,NTP,0,0,0,,Сіз оларды дәл қазір киіп жүрдіңіз ғой, солай ма?
Dialogue: 0,0:03:41.99,0:03:43.62,Style1,,0,0,0,,Мицукуни...
Dialogue: 0,0:03:42.00,0:03:42.74,jp.sub-ja,NTP,0,0,0,,Мицукуни
Dialogue: 0,0:03:49.26,0:03:50.93,Style1,,0,0,0,,Такаши...
Dialogue: 0,0:03:49.46,0:03:50.35,jp.sub-ja,NTP,0,0,0,,Такаши
Dialogue: 0,0:03:50.93,0:03:52.60,Style1,,0,0,0,,Ол сол жерде жатты.
Dialogue: 0,0:03:50.97,0:03:52.41,jp.sub-ja,NTP,0,0,0,,Ол сол жерге құлады.
Dialogue: 0,0:03:52.58,0:03:54.31,jp.sub-ja,NTP,0,0,0,,Такаши~
Dialogue: 0,0:03:52.60,0:03:54.94,Style1,,0,0,0,,Такаши!
Dialogue: 0,0:03:54.85,0:03:56.02,jp.sub-ja,NTP,0,0,0,,Жақсы
Dialogue: 0,0:03:54.94,0:03:55.94,Style1,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:03:55.94,0:03:57.27,Style1,,0,0,0,,Бұл керемет!
Dialogue: 0,0:03:56.06,0:03:57.00,jp.sub-ja,NTP,0,0,0,,Бұл жақсы.
Dialogue: 0,0:03:57.27,0:03:59.94,Style1,,0,0,0,,Бұл көз жасын төгетін көріністер жайылып бара жатқандай.
Dialogue: 0,0:03:57.37,0:03:59.96,jp.sub-ja,NTP,0,0,0,,Көз жасын төгетін нәрсе трендте.
Dialogue: 0,0:03:59.94,0:04:02.94,Style1,,0,0,0,,Қалайша бәрі кенет дымқыл болады?
Dialogue: 0,0:03:59.99,0:04:02.35,jp.sub-ja,NTP,0,0,0,,Неге бәрі оңай жылайды деп ойлаймын
Dialogue: 0,0:04:02.94,0:04:03.93,Style1,,0,0,0,,Ой...
Dialogue: 0,0:04:06.11,0:04:07.38,Style2,,0,0,0,,«Жоғары сынып»
Dialogue: 0,0:04:08.28,0:04:09.28,Style1,,0,0,0,,Бұл?
Dialogue: 0,0:04:09.28,0:04:12.29,Style1,,0,0,0,,Мен сізге хабарлауым керек, бұл хост үшін әдеттегі тәжірибе.
Dialogue: 0,0:04:09.52,0:04:12.24,jp.sub-ja,NTP,0,0,0,,Мен сізге айтайын, бұл хосттар үшін жалпы білім.
Dialogue: 0,0:04:12.29,0:04:15.29,Style1,,0,0,0,,Ылғал көзге селт етпейтін қыз жоқ.
Dialogue: 0,0:04:12.35,0:04:15.12,jp.sub-ja,NTP,0,0,0,,Ылғал көзден сүрінбейтін әйел жоқ.
Dialogue: 0,0:04:15.29,0:04:16.29,Style1,,0,0,0,,Бұл алдау.
Dialogue: 0,0:04:15.39,0:04:16.36,jp.sub-ja,NTP,0,0,0,,Қулық
Dialogue: 0,0:04:16.29,0:04:18.29,Style1,,0,0,0,,Әй, қатал болма.
Dialogue: 0,0:04:16.46,0:04:18.27,jp.sub-ja,NTP,0,0,0,,Ауыр сөз айтпа.
Dialogue: 0,0:04:18.28,0:04:20.74,jp.sub-ja,NTP,0,0,0,,Қарашы, Харухи, мен мұны істеймін.
Dialogue: 0,0:04:18.29,0:04:19.63,Style1,,0,0,0,,Міне, Харухи.
Dialogue: 0,0:04:19.63,0:04:21.26,Style1,,0,0,0,,Бұл сізге арналған.
Dialogue: 0,0:04:22.96,0:04:23.97,Style1,,0,0,0,,Мен мұны ала аламын ба?
Dialogue: 0,0:04:23.02,0:04:24.05,jp.sub-ja,NTP,0,0,0,,Маған бере аласыз ба?
Dialogue: 0,0:04:23.97,0:04:25.97,Style1,,0,0,0,,Қандай сүйкімді!
Dialogue: 0,0:04:24.11,0:04:25.49,jp.sub-ja,NTP,0,0,0,,Өте сүйкімді
Dialogue: 0,0:04:25.97,0:04:27.97,Style1,,0,0,0,,Харухи-кун, сен кондитерлерді ұнатасың ба?
Dialogue: 0,0:04:26.01,0:04:27.76,jp.sub-ja,NTP,0,0,0,,Харухи, сен жапон тәттілерін ұнатасың.
Dialogue: 0,0:04:27.97,0:04:30.97,Style1,,0,0,0,,Жоқ, мен тәттіге көп құмар емеспін.
Dialogue: 0,0:04:28.02,0:04:30.30,jp.sub-ja,NTP,0,0,0,,Жоқ, мен тәттілерді көп жемеймін.
Dialogue: 0,0:04:30.97,0:04:35.17,Style1,,0,0,0,,Дегенмен, бұл менің анама арналған естелік тарту ретінде жақсы болар еді.
Dialogue: 0,0:04:31.04,0:04:34.67,jp.sub-ja,NTP,0,0,0,,Бірақ мен оны анамның құрбандық үстеліне ұсынсам, жақсы болар еді деп ойладым.
Dialogue: 0,0:04:38.31,0:04:40.32,Style1,,0,0,0,,Сіз қандай тамаша!
Dialogue: 0,0:04:38.40,0:04:40.06,jp.sub-ja,NTP,0,0,0,,Сіз қандай батылсыз!
Dialogue: 0,0:04:40.32,0:04:45.59,Style1,,0,0,0,,Анаңа деген осындай адалдық! Міне, Харухи, қанша қаласаң, сонша ал!
Dialogue: 0,0:04:40.56,0:04:42.44,jp.sub-ja,NTP,0,0,0,,Ата-анаға осындай қамқорлықпен қарау қандай жақсы.
Dialogue: 0,0:04:42.82,0:04:45.54,jp.sub-ja,NTP,0,0,0,,Харухи, қанша қаласаң, сонша ал.
Dialogue: 0,0:04:45.59,0:04:47.92,Style1,,0,0,0,,Бұл да жасанды көз жас па?
Dialogue: 0,0:04:45.76,0:04:47.42,jp.sub-ja,NTP,0,0,0,,Ол көз жасы да жалған
Dialogue: 0,0:04:47.92,0:04:49.26,Style1,,0,0,0,,Мұны қалай айта аласыз!?
Dialogue: 0,0:04:48.07,0:04:48.99,jp.sub-ja,NTP,0,0,0,,Не айту керек
Dialogue: 0,0:04:49.26,0:04:51.93,Style1,,0,0,0,,Менің көз жасым әрқашан шынайы.
Dialogue: 0,0:04:49.29,0:04:51.65,jp.sub-ja,NTP,0,0,0,,Менің көз жасым әрқашан шынайы
Dialogue: 0,0:04:51.93,0:04:54.60,jp.sub-ja,NTP,0,0,0,,Көз тамшыларын қолданбай жылай алатын кезде ғана
Dialogue: 0,0:04:51.93,0:04:57.27,Style1,,0,0,0,,Көз тамшысын қолданбай жылай білу – нағыз үй иесінің белгісі.
Dialogue: 0,0:04:54.74,0:04:56.32,jp.sub-ja,NTP,0,0,0,,Нағыз хост
Dialogue: 0,0:04:57.27,0:04:59.20,jp.sub-ja,NTP,0,0,0,,Сізге қандай әсер қалдырды?
Dialogue: 0,0:04:57.27,0:05:00.94,Style1,,0,0,0,,Жақсы ма? Сізге әсер қалдырды ма? Маған қайтадан ғашық болдыңыз ба?
Dialogue: 0,0:04:59.53,0:05:01.09,jp.sub-ja,NTP,0,0,0,,Сіз қайтадан ғашық болдыңыз ба?
Dialogue: 0,0:05:00.94,0:05:01.94,Style1,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:05:01.19,0:05:01.93,jp.sub-ja,NTP,0,0,0,,Бөлек
Dialogue: 0,0:05:01.94,0:05:05.61,Style1,,0,0,0,,Менің увертюраларым сізге жетпеген сияқты, иә Харухи?
Dialogue: 0,0:05:02.12,0:05:05.16,jp.sub-ja,NTP,0,0,0,,Менің өтінішім Харухиге жетпеген сияқты.
Dialogue: 0,0:05:05.61,0:05:08.80,Style1,,0,0,0,,Мүмкін мен мінезімді өзгертуім керек шығар.
Dialogue: 0,0:05:05.75,0:05:08.56,jp.sub-ja,NTP,0,0,0,,Кейіпкерді сәл өзгертуім керек пе?
Dialogue: 0,0:05:15.62,0:05:18.42,Style1,,0,0,0,,Иә? Бізге жаңа қонақ келді.
Dialogue: 0,0:05:15.67,0:05:17.81,jp.sub-ja,NTP,0,0,0,,Бұл жаңа тұтынушы.
Dialogue: 0,0:05:19.87,0:05:22.09,jp.sub-ja,NTP,0,0,0,,Не болды? Кіріңіз.
Dialogue: 0,0:05:19.96,0:05:21.96,Style1,,0,0,0,,Сіз не күтіп тұрсыз? Кіріңіз.
Dialogue: 0,0:05:21.96,0:05:24.29,Style1,,0,0,0,,Қарап тұру қызық емес.
Dialogue: 0,0:05:22.12,0:05:23.88,jp.sub-ja,NTP,0,0,0,,Қарау қызықсыз
Dialogue: 0,0:05:24.29,0:05:25.96,Style1,,0,0,0,,- Келіңіздер. - У-мм...
Dialogue: 0,0:05:25.96,0:05:28.30,Style1,,0,0,0,,Әй, мен саған әрқашан әдепті бол деп айтамын
Dialogue: 0,0:05:26.88,0:05:28.40,jp.sub-ja,NTP,0,0,0,,Бірінші рет тұтынушылар үшін
Dialogue: 0,0:05:28.30,0:05:31.97,Style1,,0,0,0,,бірінші рет келген қонақтарға, солай емес пе?
Dialogue: 0,0:05:28.44,0:05:30.72,jp.sub-ja,NTP,0,0,0,,Сіз маған әрқашан әдепті болуды айтасыз.
Dialogue: 0,0:05:31.97,0:05:35.30,Style1,,0,0,0,,Міне, қорықпа, ханшайымым.
Dialogue: 0,0:05:32.12,0:05:34.69,jp.sub-ja,NTP,0,0,0,,Енді қорықпа, ханшайым.
Dialogue: 0,0:05:35.29,0:05:37.85,jp.sub-ja,NTP,0,0,0,,Ouran Host Club-қа қош келдіңіз
Dialogue: 0,0:05:35.30,0:05:38.30,Style1,,0,0,0,,Ouran Host Club-қа қош келдіңіз.
Dialogue: 0,0:05:39.31,0:05:40.98,Style1,,0,0,0,,N-
Dialogue: 0,0:05:40.98,0:05:42.38,Style1,,0,0,0,,N-?
Dialogue: 0,0:05:43.54,0:05:46.92,jp.sub-ja,NTP,0,0,0,,Жоқ, маған тиіспе, жалған.
Dialogue: 0,0:05:43.58,0:05:47.34,Style1,,0,0,0,,Жоқ! Маған тиіспе, ақымақ!
Dialogue: 0,0:05:50.59,0:05:52.92,Style1,,0,0,0,,Мен... жалған ба?
Dialogue: 0,0:05:50.60,0:05:52.88,jp.sub-ja,NTP,0,0,0,,Мен фейкпін бе?
Dialogue: 0,0:05:52.92,0:05:54.59,Style1,,0,0,0,,Иә! Сіз өтіріксіз!
Dialogue: 0,0:05:53.00,0:05:54.71,jp.sub-ja,NTP,0,0,0,,Иә, сіз жалғансыз.
Dialogue: 0,0:05:54.59,0:05:58.59,Style1,,0,0,0,,Сенің бұл клубта ханзада болғаныңа сене алар емеспін!
Dialogue: 0,0:05:54.82,0:05:58.52,jp.sub-ja,NTP,0,0,0,,Сіздің осы клубтың ханзадасы екеніңізге сене алар емеспін.
Dialogue: 0,0:05:58.59,0:06:02.60,Style1,,0,0,0,,Князь кейіпкері сүйіспеншілігін тез таратпайды!
Dialogue: 0,0:05:58.77,0:06:02.61,jp.sub-ja,NTP,0,0,0,,Ханзада кейіпкері махаббатты оңай таратпайды.
Dialogue: 0,0:06:02.60,0:06:07.27,Style1,,0,0,0,,Қалайша ақымақ боласың!? Ақылсыз нарциссист сияқтысың!
Dialogue: 0,0:06:02.80,0:06:04.82,jp.sub-ja,NTP,0,0,0,,Неге сонша ақымақсың?
Dialogue: 0,0:06:03.43,0:06:05.93,Style2,,0,0,0,,«Ақымақ»
Dialogue: 0,0:06:04.84,0:06:07.12,jp.sub-ja,NTP,0,0,0,,Мылқау нарцист сияқты емес.
Dialogue: 0,0:06:05.93,0:06:07.27,Style2,,0,0,0,,«Нарциссист»
Dialogue: 0,0:06:07.27,0:06:08.04,Style2,,0,0,0,,«қабілетсіз»
Dialogue: 0,0:06:07.27,0:06:10.10,Style1,,0,0,0,,Біліксіз! Орташа! Шұңқырлар!
Dialogue: 0,0:06:07.31,0:06:10.07,jp.sub-ja,NTP,0,0,0,,Қабілетсіз Қарапайым Ең нашар
Dialogue: 0,0:06:08.04,0:06:09.00,Style2,,0,0,0,,«Жалпы»
Dialogue: 0,0:06:09.00,0:06:10.10,Style2,,0,0,0,,«Жеркенішті»
Dialogue: 0,0:06:14.94,0:06:16.28,Style1,,0,0,0,,О, бұл жаңа техника!
Dialogue: 0,0:06:15.27,0:06:16.20,jp.sub-ja,NTP,0,0,0,,Жаңа техника
Dialogue: 0,0:06:16.28,0:06:18.51,Style1,,0,0,0,,Бір адамның баяу қозғалысы!
Dialogue: 0,0:06:16.37,0:06:18.01,jp.sub-ja,NTP,0,0,0,,Бір адамның баяу қозғалысы
Dialogue: 0,0:06:20.95,0:06:23.47,Style1,,0,0,0,,Кез келген жағдайда, сіз...
Dialogue: 0,0:06:21.16,0:06:23.06,jp.sub-ja,NTP,0,0,0,,Сіз ше?
Dialogue: 0,0:06:24.45,0:06:26.16,jp.sub-ja,NTP,0,0,0,,Кёуя-сама
Dialogue: 0,0:06:24.62,0:06:26.52,Style1,,0,0,0,,Киёя-сама!
Dialogue: 0,0:06:28.96,0:06:31.29,Style1,,0,0,0,,Мен сенімен танысқым келді.
Dialogue: 0,0:06:29.20,0:06:33.62,jp.sub-ja,NTP,0,0,0,,Мен сенімен танысқым келді, өзімнің ханзадам.
Dialogue: 0,0:06:31.29,0:06:34.20,Style1,,0,0,0,,Менің өз ханзадам.
Dialogue: 0,0:06:34.20,0:06:34.63,Style1,,0,0,0,,«№3 музыкалық бөлме»
Dialogue: 0,0:06:34.20,0:06:37.17,Style2,,0,0,0,,«№3 музыкалық бөлме»
Dialogue: 0,0:06:34.63,0:06:35.96,Style1,,0,0,0,,«№3 музыкалық бөлме» Қалыңдық?
Dialogue: 0,0:06:35.02,0:06:35.89,jp.sub-ja,NTP,0,0,0,,Неке
Dialogue: 0,0:06:35.96,0:06:37.17,Style1,,0,0,0,,«№3 музыкалық бөлме» Кёя-сенпайдікі?
Dialogue: 0,0:06:36.04,0:06:37.18,jp.sub-ja,NTP,0,0,0,,Кёуя-сенпайдікі
Dialogue: 0,0:06:37.17,0:06:37.30,Style1,,0,0,0,,Кёя-сенпайдікі?
Dialogue: 0,0:06:37.30,0:06:39.97,Style1,,0,0,0,,Иә. Менің атым Хошикудзи Ренге.
Dialogue: 0,0:06:37.48,0:06:40.05,jp.sub-ja,NTP,0,0,0,,Иә, менің атым Хошакудзи Ренге.
Dialogue: 0,0:06:39.97,0:06:44.57,Style1,,0,0,0,,Мен ертең 1-курс, А сыныбына ауысамын.
Dialogue: 0,0:06:40.24,0:06:43.11,jp.sub-ja,NTP,0,0,0,,Мен ертеңнен бастап 1 А сыныбына ауысамын.
Dialogue: 0,0:06:44.57,0:06:45.91,Style1,,0,0,0,,Қараңызшы, ол жынды.
Dialogue: 0,0:06:44.81,0:06:45.91,jp.sub-ja,NTP,0,0,0,,Қараңызшы, мен ашуланып тұрмын.
Dialogue: 0,0:06:45.91,0:06:48.54,Style1,,0,0,0,,Себебі анам әкемнен бірдеңе жасырған.
Dialogue: 0,0:06:46.16,0:06:48.58,jp.sub-ja,NTP,0,0,0,,Өйткені анам әкемнен бірдеңені жасырып жүрген.
Dialogue: 0,0:06:48.54,0:06:52.48,Style2,,0,0,0,,«Әке» «Анашым»
Dialogue: 0,0:06:48.91,0:06:52.91,Style1,,0,0,0,,Не болса да. Сіз бұл ерлі-зайыптылар мәселесін ұстануға тырысасыз ба?
Dialogue: 0,0:06:49.00,0:06:52.41,jp.sub-ja,NTP,0,0,0,,Маған бәрібір, бірақ сіз бұл неке жағдайын орнатуды қалайсыз ба?
Dialogue: 0,0:06:52.91,0:06:55.58,Style1,,0,0,0,,Бұл шынында да бір көргеннен махаббат.
Dialogue: 0,0:06:53.06,0:06:55.19,jp.sub-ja,NTP,0,0,0,,Бұл бір көргеннен махаббат еді.
Dialogue: 0,0:06:55.58,0:06:58.59,Style1,,0,0,0,,Артқы аулада сол гүлдерді қалай жақсы көретінсің,
Dialogue: 0,0:06:55.78,0:07:00.36,jp.sub-ja,NTP,0,0,0,,Ауладағы ешкім мән бермейтін гүлдерді жалғыз бағып отырған адамды көргенде.
Dialogue: 0,0:06:58.59,0:07:00.92,Style1,,0,0,0,,тіпті ешкім қарамаса да...
Dialogue: 0,0:07:00.85,0:07:04.68,jp.sub-ja,NTP,0,0,0,,Ал жараланған котенкаға ақырын созылған қол
Dialogue: 0,0:07:00.92,0:07:04.59,Style1,,0,0,0,,Сіз жараланған кішкентай мысыққа мейірімділікпен қол созғаныңыз...
Dialogue: 0,0:07:04.59,0:07:05.59,Style1,,0,0,0,,Біз кім туралы айтып отырмыз?
Dialogue: 0,0:07:04.81,0:07:05.66,jp.sub-ja,NTP,0,0,0,,Бұл кім?
Dialogue: 0,0:07:05.59,0:07:06.93,Style1,,0,0,0,,Сізде қате адам болуы мүмкін бе?
Dialogue: 0,0:07:05.66,0:07:06.95,jp.sub-ja,NTP,0,0,0,,Қате адам болған жағдайда
Dialogue: 0,0:07:06.93,0:07:09.26,Style1,,0,0,0,,Жоқ! Сіз бұл көздерді алдай алмайсыз!
Dialogue: 0,0:07:06.95,0:07:09.32,jp.sub-ja,NTP,0,0,0,,Жоқ, менің көзімде ештеңе жоқ.
Dialogue: 0,0:07:09.26,0:07:11.27,Style1,,0,0,0,,Ол бәріне мейірімді,
Dialogue: 0,0:07:09.26,0:07:16.23,Style2,,0,0,0,,"Кім? Кім? Кім?"
Dialogue: 0,0:07:09.58,0:07:10.89,jp.sub-ja,NTP,0,0,0,,Барлығына мейірімді бол
Dialogue: 0,0:07:10.91,0:07:13.65,jp.sub-ja,NTP,0,0,0,,Ешқашан қайтарымын сұрамайтындар
Dialogue: 0,0:07:11.27,0:07:13.94,Style1,,0,0,0,,, бірақ ешкімнің оған назар аударуын талап етпейді.
Dialogue: 0,0:07:13.72,0:07:16.89,jp.sub-ja,NTP,0,0,0,,Мен жалғыздықты жақсы көремін, бірақ мен шын мәнінде жалғызбын
Dialogue: 0,0:07:13.94,0:07:17.61,Style1,,0,0,0,,Ол жалғыздықты жақсы көреді, бірақ шын мәнінде жалғыз.
Dialogue: 0,0:07:17.61,0:07:19.61,Style1,,0,0,0,,Қазіргі танымал жұлдызға ұқсайтын адам
Dialogue: 0,0:07:17.79,0:07:20.18,jp.sub-ja,NTP,0,0,0,,Қызықты махаббат симуляциясы ойыны
Dialogue: 0,0:07:19.61,0:07:21.61,Style1,,0,0,0,,махаббат симуляциясы ойыны, «Уки-доки мемориалы»,
Dialogue: 0,0:07:19.98,0:07:21.27,Style2,,0,0,0,,«Уки-Доки мемориалы»
Dialogue: 0,0:07:20.20,0:07:24.11,jp.sub-ja,NTP,0,0,0,,Сіз "Uki❤Doki★Memorial" фильміндегі Маса Ичиджоға ұқсайсыз
Dialogue: 0,0:07:21.61,0:07:24.55,Style1,,0,0,0,,Ичиджо Мияби-кун, бұл сенсің!
Dialogue: 0,0:07:25.95,0:07:26.62,Style1,,0,0,0,,Uki? (Уки - рухы жоғары)
Dialogue: 0,0:07:26.62,0:07:27.28,Style1,,0,0,0,,Доки? (Доки - жүрек соғысы)
Dialogue: 0,0:07:27.28,0:07:27.95,Style1,,0,0,0,,Отаку!
Dialogue: 0,0:07:27.39,0:07:28.25,jp.sub-ja,NTP,0,0,0,,Отаку
Dialogue: 0,0:07:27.95,0:07:29.28,Style1,,0,0,0,,Ол отаку!
Dialogue: 0,0:07:28.26,0:07:28.83,jp.sub-ja,NTP,0,0,0,,Мен отакумын
Dialogue: 0,0:07:29.24,0:07:30.59,jp.sub-ja,NTP,0,0,0,,Бірінші рет көрдім
Dialogue: 0,0:07:29.28,0:07:30.95,Style1,,0,0,0,,Мен бұрын ешқашан көрген емеспін!
Dialogue: 0,0:07:30.92,0:07:33.23,jp.sub-ja,NTP,0,0,0,,көремін. Бұл кейіпкердің түрі ме?
Dialogue: 0,0:07:30.95,0:07:33.62,Style1,,0,0,0,,Мен қазір көріп тұрмын. Сіз кейіпкерге ғашықсыз.
Dialogue: 0,0:07:33.60,0:07:35.38,jp.sub-ja,NTP,0,0,0,,Мені кейіпкерге тағайындаңыз
Dialogue: 0,0:07:33.62,0:07:35.62,Style1,,0,0,0,,Сіз маған кейіпкердің ғашықтығын бейнелейсіз,
Dialogue: 0,0:07:35.62,0:07:38.29,Style1,,0,0,0,,біз айналысамыз деп өзімізді алдауға дейін барамыз.
Dialogue: 0,0:07:35.64,0:07:37.98,jp.sub-ja,NTP,0,0,0,,Бұл тіпті қалыңдықтың адасуына дейін созылды.
Dialogue: 0,0:07:38.29,0:07:41.63,Style1,,0,0,0,,Мына Миябикун кейіпкері де көзілдірік киетін шығар, солай ма?
Dialogue: 0,0:07:38.56,0:07:41.72,jp.sub-ja,NTP,0,0,0,,Мияби көзілдірік киген кейіпкер шығар.
Dialogue: 0,0:07:41.63,0:07:46.23,Style1,,0,0,0,,Әй, алданған, айтасың ба? Сосын оның сіздің қалыңдық болғаны туралы әңгіме...
Dialogue: 0,0:07:41.79,0:07:43.17,jp.sub-ja,NTP,0,0,0,,Әлде адасушылық па?
Dialogue: 0,0:07:43.32,0:07:45.78,jp.sub-ja,NTP,0,0,0,,Сонымен, сіздің күйеуіңіз ше?
Dialogue: 0,0:07:46.14,0:07:48.62,jp.sub-ja,NTP,0,0,0,,Мен оны растағаным есімде жоқ.
Dialogue: 0,0:07:46.23,0:07:49.24,Style1,,0,0,0,,Мен мұны ешқашан мойындағаным есімде жоқ.
Dialogue: 0,0:07:49.24,0:07:52.74,Style1,,0,0,0,,Біріншіден, мен оны бүгінге дейін кездестірген емеспін.
Dialogue: 0,0:07:49.39,0:07:51.98,jp.sub-ja,NTP,0,0,0,,Бірінші Бүгін мен қызымды бірінші рет кездестірдім.
Dialogue: 0,0:07:52.74,0:07:54.33,Style2,,0,0,0,,«Сіз ертерек айта алар едіңіз»
Dialogue: 0,0:07:54.58,0:07:55.91,Style1,,0,0,0,,Менің мәліметім бойынша,
Dialogue: 0,0:07:54.66,0:07:55.84,jp.sub-ja,NTP,0,0,0,,Жазба бойынша
Dialogue: 0,0:07:55.91,0:07:59.25,Style1,,0,0,0,,Кёйя-сама, мен сен бұл клубтың бәрін басқаратыныңды түсінемін.
Dialogue: 0,0:07:55.96,0:07:59.34,jp.sub-ja,NTP,0,0,0,,Кёуя-сама бұл бөлімдегі барлық істерге жауапты.
Dialogue: 0,0:07:59.25,0:08:01.25,Style1,,0,0,0,,Дұрыс. Кио Чан біздің директор.
Dialogue: 0,0:07:59.40,0:08:01.51,jp.sub-ja,NTP,0,0,0,,Дұрыс, Кагами-чан, менеджер.
Dialogue: 0,0:08:01.25,0:08:03.92,Style1,,0,0,0,,Директор? Бұл тамаша!
Dialogue: 0,0:08:01.53,0:08:03.80,jp.sub-ja,NTP,0,0,0,,Менеджер мырза, бұл өте жақсы.
Dialogue: 0,0:08:03.92,0:08:07.59,Style1,,0,0,0,,Мен әрқашан біреудің бизнесі үшін карта болуды армандадым.
Dialogue: 0,0:08:03.94,0:08:07.64,jp.sub-ja,NTP,0,0,0,,Менің арманым дүкеннің постер қызы болу еді.
Dialogue: 0,0:08:07.59,0:08:09.59,Style1,,0,0,0,,Бізге керегі жоқ. Өйткені, біз қабылдаушы клубпыз.
Dialogue: 0,0:08:07.68,0:08:09.70,jp.sub-ja,NTP,0,0,0,,Қажет емес, бұл қабылдаушы клуб.
Dialogue: 0,0:08:09.59,0:08:13.76,Style1,,0,0,0,,Мен шешім қабылдадым. Мен осы қабылдаушы клубтың менеджері боламын!
Dialogue: 0,0:08:09.76,0:08:10.90,jp.sub-ja,NTP,0,0,0,,Мен шештім
Dialogue: 0,0:08:10.92,0:08:13.82,jp.sub-ja,NTP,0,0,0,,Мен осы қабылдау бөлімінің менеджері боламын.
Dialogue: 0,0:08:13.76,0:08:15.20,Style2,,0,0,0,,«Ол тыңдамайды»
Dialogue: 0,0:08:15.77,0:08:17.06,jp.sub-ja,NTP,0,0,0,,Сәлем Кьюя
Dialogue: 0,0:08:15.93,0:08:17.27,Style1,,0,0,0,,Сәлем, Кёя...
Dialogue: 0,0:08:17.27,0:08:21.60,Style1,,0,0,0,,Ол Отори отбасы үшін маңызды клиенттің қызы.
Dialogue: 0,0:08:17.48,0:08:21.22,jp.sub-ja,NTP,0,0,0,,Ол біздің Отори отбасымыздың маңызды іскер серіктесінің қызы.
Dialogue: 0,0:08:21.60,0:08:25.31,Style1,,0,0,0,,Мен сізден әдепсіздікке жол бермеуіңізді сұраймын.
Dialogue: 0,0:08:21.89,0:08:24.00,jp.sub-ja,NTP,0,0,0,,Дөрекі болмаңыз.
Dialogue: 0,0:08:25.31,0:08:28.61,Style1,,0,0,0,,Барлығына, бұл рахат болады.
Dialogue: 0,0:08:25.31,0:08:29.27,Style2,,0,0,0,,«Қандай себеп болса да, бұл менеджер ханымның дүниеге келуі»
Dialogue: 0,0:08:25.56,0:08:28.32,jp.sub-ja,NTP,0,0,0,,Барлығыңызға рахмет.
Dialogue: 0,0:08:29.31,0:08:32.37,Style2,,0,0,0,,«Келесі күн»
Dialogue: 0,0:08:29.95,0:08:32.61,Style1,,0,0,0,,Мен бұл туралы кеше түнде ойладым,
Dialogue: 0,0:08:30.25,0:08:32.34,jp.sub-ja,NTP,0,0,0,,Кеше түні бойы осыны ойладым.
Dialogue: 0,0:08:32.61,0:08:35.28,Style1,,0,0,0,,және менеджер ханымның болуы соншалықты жаман болмауы мүмкін.
Dialogue: 0,0:08:32.65,0:08:35.26,jp.sub-ja,NTP,0,0,0,,Әйел менеджер де жаман болмауы мүмкін.
Dialogue: 0,0:08:35.28,0:08:36.95,Style1,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:08:35.59,0:08:36.94,jp.sub-ja,NTP,0,0,0,,Неліктен тағы?
Dialogue: 0,0:08:36.95,0:08:42.29,Style1,,0,0,0,,Көрмейсіз бе? Ол Харухимен бір сыныпқа ауысты.
Dialogue: 0,0:08:37.00,0:08:37.71,jp.sub-ja,NTP,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:08:38.12,0:08:41.28,jp.sub-ja,NTP,0,0,0,,Оны Харухимен бір сыныпқа орналастырды.
Dialogue: 0,0:08:42.29,0:08:47.96,Style1,,0,0,0,,Екеуі қыз сияқты дос болса, Харухи қызға ұқсап кетуі мүмкін.
Dialogue: 0,0:08:42.53,0:08:44.58,jp.sub-ja,NTP,0,0,0,,Әйелдермен дос бола алсаңыз
Dialogue: 0,0:08:44.68,0:08:47.81,jp.sub-ja,NTP,0,0,0,,Харухи қызға ұқсауы мүмкін.
Dialogue: 0,0:08:47.96,0:08:50.63,Style1,,0,0,0,,Өзіне тән нәзіктіктің қызға тән әуені
Dialogue: 0,0:08:48.21,0:08:50.49,jp.sub-ja,NTP,0,0,0,,Қыздарға ғана тән жұмсақ атмосфера
Dialogue: 0,0:08:50.63,0:08:53.30,Style1,,0,0,0,,Харухидің әйелдік сезімін оята алады.
Dialogue: 0,0:08:50.77,0:08:53.27,jp.sub-ja,NTP,0,0,0,,Харухиді өзін әйел ретінде тануға ынталандыру
Dialogue: 0,0:08:53.30,0:08:54.30,Style1,,0,0,0,,Не болды?
Dialogue: 0,0:08:54.30,0:08:59.64,Style1,,0,0,0,,Бұл Харухиді қызға айналдыруға арналған ауқымды жоба!
Dialogue: 0,0:08:54.66,0:08:57.43,jp.sub-ja,NTP,0,0,0,,Бұл Харухиді қыздырақ етіп оятады.
Dialogue: 0,0:08:57.77,0:08:59.39,jp.sub-ja,NTP,0,0,0,,Бұл үлкен жоба.
Dialogue: 0,0:08:59.64,0:09:03.65,Style1,,0,0,0,,Тек осы екі беделсіз егіздердің жақын сыныптастары болуы,
Dialogue: 0,0:08:59.87,0:09:03.43,jp.sub-ja,NTP,0,0,0,,Сыныптастарыммен жалғыз достарым – мына көлеңкелі егіздер.
Dialogue: 0,0:09:03.62,0:09:05.14,jp.sub-ja,NTP,0,0,0,,Харухи үшін емес
Dialogue: 0,0:09:03.65,0:09:05.31,Style1,,0,0,0,,Харухи үшін жақсы емес.
Dialogue: 0,0:09:05.31,0:09:06.98,Style1,,0,0,0,,Бұл бізге айтып тұр, жарайды.
Dialogue: 0,0:09:05.38,0:09:06.73,jp.sub-ja,NTP,0,0,0,,Сіз маған айтасыз.
Dialogue: 0,0:09:06.96,0:09:07.80,jp.sub-ja,NTP,0,0,0,,Барлығы
Dialogue: 0,0:09:06.98,0:09:08.32,Style1,,0,0,0,,Адамдар...
Dialogue: 0,0:09:08.32,0:09:12.32,Style1,,0,0,0,,Ренге, Хост клубының сызу картасы бірнеше печенье пісірді.
Dialogue: 0,0:09:08.44,0:09:12.24,jp.sub-ja,NTP,0,0,0,,Жүргізуші клубтың постер қызы Ренге печенье пісіруге келді.
Dialogue: 0,0:09:12.32,0:09:15.99,Style1,,0,0,0,,О... қандай ханым! Мен қатты қозғалдым!
Dialogue: 0,0:09:12.38,0:09:16.57,jp.sub-ja,NTP,0,0,0,,О, сондай қыз маған қатты әсер етті.
Dialogue: 0,0:09:15.99,0:09:19.02,Style1,,0,0,0,,Мен оларды саған пісірген жоқпын, жалған ханзада.
Dialogue: 0,0:09:16.32,0:09:18.87,jp.sub-ja,NTP,0,0,0,,Мен саған пісірген жоқпын, жалған ханзада.
Dialogue: 0,0:09:18.33,0:09:19.02,Style2,,0,0,0,,«Жалған ханзада»
Dialogue: 0,0:09:20.33,0:09:26.00,Style1,,0,0,0,,Олар аздап күйіп кеткен, бірақ мен сенің не айтарыңды білемін, Кёя-сама.
Dialogue: 0,0:09:20.40,0:09:22.36,jp.sub-ja,NTP,0,0,0,,Аздап күйіп қалды.
Dialogue: 0,0:09:22.63,0:09:25.96,jp.sub-ja,NTP,0,0,0,,Бірақ мен Кёя-саманың не айтатынын білемін.
Dialogue: 0,0:09:26.00,0:09:29.53,Style2,,0,0,0,,«Сіз жасаған кез келген нәрсе дәмді болады, әрине».
Dialogue: 0,0:09:26.31,0:09:29.53,jp.sub-ja,NTP,0,0,0,,Егер бұл сіз жасаған нәрсе болса, мен оның дәмді болатынына сенімдімін.
Dialogue: 0,0:09:29.82,0:09:32.30,jp.sub-ja,NTP,0,0,0,,Жоқ, енді, Кёя-сама
Dialogue: 0,0:09:30.34,0:09:32.34,Style1,,0,0,0,,О, Кёя-сама...
Dialogue: 0,0:09:32.34,0:09:34.34,Style1,,0,0,0,,Дұрыс айтасың, бұлар күйіп кеткен.
Dialogue: 0,0:09:32.37,0:09:34.39,jp.sub-ja,NTP,0,0,0,,Ол тым күйіп кеткені сөзсіз.
Dialogue: 0,0:09:34.34,0:09:37.11,Style1,,0,0,0,,Мицукуни, тоқта. Олар саған жаман.
Dialogue: 0,0:09:34.43,0:09:36.29,jp.sub-ja,NTP,0,0,0,,Мицукуниді тоқтатыңыз, бұл сізге жаман
Dialogue: 0,0:09:37.95,0:09:42.67,jp.sub-ja,NTP,0,0,0,,Қорқынышты, қорқынышты~
Dialogue: 0,0:09:39.68,0:09:42.71,Style1,,0,0,0,,Ол мені қорқытады!
Dialogue: 0,0:09:48.29,0:09:51.28,Style1,,0,0,0,,Олар дәмді, бірақ бәрі жаман емес.
Dialogue: 0,0:09:48.35,0:09:50.66,jp.sub-ja,NTP,0,0,0,,Хош иісті, бірақ онша жаман емес.
Dialogue: 0,0:09:52.96,0:09:54.09,Style1,,0,0,0,,Адам, ол қандай ұлт болуы керек еді?
Dialogue: 0,0:09:57.97,0:10:01.56,Style1,,0,0,0,,О, Харухи, сенің бетіңде печенье үгіндісі бар.
Dialogue: 0,0:09:58.01,0:10:01.04,jp.sub-ja,NTP,0,0,0,,Міне, Харухи, оның үстінде печенье үгіндісі бар.
Dialogue: 0,0:10:04.34,0:10:06.92,jp.sub-ja,NTP,0,0,0,,Эй, мына балалар.
Dialogue: 0,0:10:05.64,0:10:09.64,Style1,,0,0,0,,Мұны ешкім түсінбес бұрын, олар бір сыныптас үштікке айналды.
Dialogue: 0,0:10:05.92,0:10:09.31,jp.sub-ja,NTP,0,0,0,,Мен білмей тұрып, үш жақын сыныптас едік.
Dialogue: 0,0:10:09.55,0:10:13.39,jp.sub-ja,NTP,0,0,0,,Аналар Аналар
Dialogue: 0,0:10:09.64,0:10:12.31,Style1,,0,0,0,,Білесің бе, егер сен солай айтсаң, мен оларды өзім алып тастай аламын.
Dialogue: 0,0:10:09.73,0:10:12.59,jp.sub-ja,NTP,0,0,0,,Білесің бе, айтсаң, өзім аламын.
Dialogue: 0,0:10:12.31,0:10:14.98,Style1,,0,0,0,,Ал егер сіз қаласаңыз, олар дәл осында.
Dialogue: 0,0:10:12.60,0:10:14.45,jp.sub-ja,NTP,0,0,0,,Қаласаңыз, осында.
Dialogue: 0,0:10:14.69,0:10:17.49,jp.sub-ja,NTP,0,0,0,,О, ой, сіздің реакцияңыз дұрыс емес.
Dialogue: 0,0:10:14.98,0:10:17.65,Style1,,0,0,0,,Y-y-реакцияңыз дұрыс емес!
Dialogue: 0,0:10:17.65,0:10:19.52,Style1,,0,0,0,,Міне, сіз оларға қарсы тұруыңыз керек,
Dialogue: 0,0:10:17.70,0:10:19.28,jp.sub-ja,NTP,0,0,0,,Бұл қабылданбауы керек.
Dialogue: 0,0:10:19.31,0:10:21.11,jp.sub-ja,NTP,0,0,0,,Жеңіл жуылған жер
Dialogue: 0,0:10:19.52,0:10:20.99,Style1,,0,0,0,,және оларды абайсызда бір жаққа тартыңыз!
Dialogue: 0,0:10:20.99,0:10:23.12,Style1,,0,0,0,,Өтінемін, мені жыныстық қудалауды доғаршы, Сенпай.
Dialogue: 0,0:10:21.17,0:10:23.35,jp.sub-ja,NTP,0,0,0,,Жыныстық қудалауды доғаршы, Сенпай.
Dialogue: 0,0:10:22.26,0:10:23.12,Style2,,0,0,0,,«Тоқтату»
Dialogue: 0,0:10:23.32,0:10:26.66,Style1,,0,0,0,,Сізді мазалайды!? Егер мен сені мазалап жүрсем, онда олар екі есе кінәлі!
Dialogue: 0,0:10:23.60,0:10:24.37,jp.sub-ja,NTP,0,0,0,,Жыныстық қудалау?
Dialogue: 0,0:10:24.38,0:10:26.62,jp.sub-ja,NTP,0,0,0,,Егер мен жыныстық қудалаушы болсам, олар содырлар.
Dialogue: 0,0:10:26.63,0:10:28.34,jp.sub-ja,NTP,0,0,0,,Полицей~
Dialogue: 0,0:10:26.66,0:10:28.33,Style1,,0,0,0,,Ааа! Полиция!
Dialogue: 0,0:10:28.33,0:10:30.33,Style1,,0,0,0,,Жарайды, жарайды, сэр, кешіріңіз.
Dialogue: 0,0:10:28.49,0:10:30.38,jp.sub-ja,NTP,0,0,0,,Иә, иә, сэр, кешіріңіз.
Dialogue: 0,0:10:30.33,0:10:32.67,Style1,,0,0,0,,Ренге-чан, Ренге-чан...
Dialogue: 0,0:10:30.41,0:10:31.97,jp.sub-ja,NTP,0,0,0,,Ренге-чан Ренге-чан
Dialogue: 0,0:10:32.56,0:10:34.28,jp.sub-ja,NTP,0,0,0,,Сүт ішу
Dialogue: 0,0:10:32.67,0:10:35.00,Style1,,0,0,0,,Сүт алғыңыз келе ме?
Dialogue: 0,0:10:34.80,0:10:36.14,jp.sub-ja,NTP,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:10:35.62,0:10:37.02,jp.sub-ja,NTP,0,0,0,,Мен патшамын
Dialogue: 0,0:10:36.00,0:10:38.34,Style1,,0,0,0,,Тым жылы...
Dialogue: 0,0:10:36.32,0:10:36.92,jp.sub-ja,NTP,0,0,0,,Жылы
Dialogue: 0,0:10:37.16,0:10:38.48,jp.sub-ja,NTP,0,0,0,,Иә, сэр
Dialogue: 0,0:10:38.16,0:10:39.41,jp.sub-ja,NTP,0,0,0,,Жылы
Dialogue: 0,0:10:38.34,0:10:40.01,Style1,,0,0,0,,Барлығы тым жылы!
Dialogue: 0,0:10:40.01,0:10:43.01,Style1,,0,0,0,,Киоя-самадан басқа кейіпкерлеріңіздің бәрі тым әлсіз!
Dialogue: 0,0:10:40.02,0:10:42.72,jp.sub-ja,NTP,0,0,0,,Кёуя-самадан басқа кейіпкерлер әдетте жылы.
Dialogue: 0,0:10:43.01,0:10:46.28,Style1,,0,0,0,,Барлық жүргізушілерге «қараңғы» жағы жетіспейді!
Dialogue: 0,0:10:43.01,0:10:46.30,jp.sub-ja,NTP,0,0,0,,Мұндағы үй иесінің көлеңкесі жоқ.
Dialogue: 0,0:10:46.28,0:10:48.95,Style1,,0,0,0,,Қыздар жарақаттан өткен әдемі жігіттерге осал!
Dialogue: 0,0:10:46.44,0:10:48.94,jp.sub-ja,NTP,0,0,0,,Қыздар сұлу ұлдардың жарақатынан осал
Dialogue: 0,0:10:48.95,0:10:50.95,Style1,,0,0,0,,Егер сіз осылай күлкілі түрде жүре берсеңіз,
Dialogue: 0,0:10:49.00,0:10:50.87,jp.sub-ja,NTP,0,0,0,,Дәл осы ақымақ көзқараспен
Dialogue: 0,0:10:50.89,0:10:52.96,jp.sub-ja,NTP,0,0,0,,Жалыққанша уақыт қана
Dialogue: 0,0:10:50.95,0:10:52.95,Style1,,0,0,0,,бәрінен шаршағанша уақыт мәселесі!
Dialogue: 0,0:10:52.95,0:10:56.62,Style1,,0,0,0,,Кёя-саманың асыл ісін құртпақшысың ба!?
Dialogue: 0,0:10:53.04,0:10:56.44,jp.sub-ja,NTP,0,0,0,,Сіз Кёя-саманың маңызды дүкенін жойғыңыз келе ме?
Dialogue: 0,0:10:56.48,0:10:59.64,jp.sub-ja,NTP,0,0,0,,Менеджер ретінде бүгіннен бастап кейіпкерлердің параметрлерін өзгертемін.
Dialogue: 0,0:10:56.62,0:10:59.63,Style1,,0,0,0,,Менеджер ретінде бүгіннен бастап мен сіздің барлық кейіпкерлеріңіздің фонын өзгертемін.
Dialogue: 0,0:10:59.63,0:11:00.96,Style1,,0,0,0,,Сізден басталады!
Dialogue: 0,0:10:59.72,0:11:00.65,jp.sub-ja,NTP,0,0,0,,Алдымен сіз
Dialogue: 0,0:11:00.96,0:11:04.30,Style1,,0,0,0,,Ішің-сырттың бәрі сүйкімді болсаң, сәби сияқтысың.
Dialogue: 0,0:11:01.19,0:11:04.25,jp.sub-ja,NTP,0,0,0,,Сырты да, іші де сүйкімді болса, сәбилермен бірдей.
Dialogue: 0,0:11:04.30,0:11:08.64,Style1,,0,0,0,,Осылайша сіз қазірсіз
Dialogue: 0,0:11:04.46,0:11:07.53,jp.sub-ja,NTP,0,0,0,,Сондықтан ол сүйкімді көрінгенімен, шын мәнінде ол шайтан.
Dialogue: 0,0:11:06.47,0:11:08.44,Style2,,0,0,0,,«Сүйкімді жүз, шын мәнінде бұзақы кім!»
Dialogue: 0,0:11:08.64,0:11:11.64,Style1,,0,0,0,,Моринозука-сенпай, сен
Dialogue: 0,0:11:08.80,0:11:11.47,jp.sub-ja,NTP,0,0,0,,Харунозука-сенпай – менің бала күнгі досымның қолбасшысы.
Dialogue: 0,0:11:09.94,0:11:11.30,Style2,,0,0,0,,«Балалық шақтағы дос фланки!»
Dialogue: 0,0:11:11.64,0:11:14.98,Style1,,0,0,0,,Егіздер баскетболшы болады,
Dialogue: 0,0:11:11.71,0:11:14.81,jp.sub-ja,NTP,0,0,0,,Егіздер тек екеуінің әлемінде қамалған баскетболшылар.
Dialogue: 0,0:11:13.24,0:11:14.73,Style2,,0,0,0,,«Өз әлемінде үндеме!»
Dialogue: 0,0:11:14.98,0:11:18.65,Style1,,0,0,0,,Харухи-кун, сіз құрметті студентсіз, бетпе-бет келдіңіз
Dialogue: 0,0:11:15.01,0:11:18.53,jp.sub-ja,NTP,0,0,0,,Харухи құрметті студент, бірақ қатты қорқытудан зардап шегеді.
Dialogue: 0,0:11:17.05,0:11:18.48,Style2,,0,0,0,,«Қарқынды қорқыту!»
Dialogue: 0,0:11:18.65,0:11:22.32,Style1,,0,0,0,,Ал Тамаки-сан, сен мектеп кумирісің, келбетіңмен қадірлісің,
Dialogue: 0,0:11:18.71,0:11:19.88,jp.sub-ja,NTP,0,0,0,,Және Тамаки мырза
Dialogue: 0,0:11:20.13,0:11:22.48,jp.sub-ja,NTP,0,0,0,,Сіз тек сыртқы келбетіңізге қарай бағаланасыз.
Dialogue: 0,0:11:22.32,0:11:25.65,Style1,,0,0,0,,бірақ шын мәнінде сізде кемшілік комплексі бар...
Dialogue: 0,0:11:22.55,0:11:25.36,jp.sub-ja,NTP,0,0,0,,Шын мәнінде кешені бар мектеп кумирі
Dialogue: 0,0:11:25.65,0:11:27.11,jp.sub-ja,NTP,0,0,0,,Жалғыз ханзада
Dialogue: 0,0:11:27.56,0:11:29.49,Style2,,0,0,0,,"Жалғыз ханзада!!"
Dialogue: 0,0:11:29.66,0:11:32.33,Style1,,0,0,0,,О, Кёя-сама, сен мінсізсің.
Dialogue: 0,0:11:30.36,0:11:32.10,jp.sub-ja,NTP,0,0,0,,Кёуя-сама тамаша.
Dialogue: 0,0:11:32.31,0:11:35.35,jp.sub-ja,NTP,0,0,0,,Әрқашан мейірім мен мейірімге толы болсын.
Dialogue: 0,0:11:32.33,0:11:35.83,Style1,,0,0,0,,Сіз әдеттегідей мейірімді, мейірімді боласыз.
Dialogue: 0,0:11:35.83,0:11:37.33,Style1,,0,0,0,,Маған құрмет көрсетілді.
Dialogue: 0,0:11:35.92,0:11:36.93,jp.sub-ja,NTP,0,0,0,,Бұл құрмет
Dialogue: 0,0:11:37.33,0:11:41.67,Style1,,0,0,0,,«Жалғыз ханзада». Шынында да, бұл мен үшін тамаша!
Dialogue: 0,0:11:37.39,0:11:38.31,jp.sub-ja,NTP,0,0,0,,Жалғыз ханзада
Dialogue: 0,0:11:39.11,0:11:41.36,jp.sub-ja,NTP,0,0,0,,Бұл мен үшін өте қолайлы.
Dialogue: 0,0:11:41.67,0:11:44.94,Style1,,0,0,0,,Бұл оның ең қателескені шығар.
Dialogue: 0,0:11:41.83,0:11:43.96,jp.sub-ja,NTP,0,0,0,,Ең қатесі шығар
Dialogue: 0,0:11:44.94,0:11:46.27,Style1,,0,0,0,,Кёя-сенпай...
Dialogue: 0,0:11:44.95,0:11:46.28,jp.sub-ja,NTP,0,0,0,,Кёуя-сенпай
Dialogue: 0,0:11:46.27,0:11:47.61,Style1,,0,0,0,,Бірдеңе істе!
Dialogue: 0,0:11:46.33,0:11:47.69,jp.sub-ja,NTP,0,0,0,,Бұл туралы бірдеңе жасаңыз
Dialogue: 0,0:11:47.61,0:11:49.94,Style1,,0,0,0,,Бірақ оның бойы осыған сай көрінеді.
Dialogue: 0,0:11:47.85,0:11:49.68,jp.sub-ja,NTP,0,0,0,,Бірақ менеджер бұған ынталы.
Dialogue: 0,0:11:49.94,0:11:51.61,Style1,,0,0,0,,Ренге-күн, Ренге-күн...
Dialogue: 0,0:11:49.96,0:11:51.44,jp.sub-ja,NTP,0,0,0,,Ренге-кун Ренге-кун
Dialogue: 0,0:11:51.59,0:11:54.34,jp.sub-ja,NTP,0,0,0,,Жалғыздық осылай көрінеді ме?
Dialogue: 0,0:11:51.61,0:11:54.28,Style1,,0,0,0,,Жалғыз поза осылай көрінеді ме?
Dialogue: 0,0:11:54.28,0:11:56.62,Style1,,0,0,0,,Менің, бұл өте жақсы, Тамаки-сан.
Dialogue: 0,0:11:54.39,0:11:56.73,jp.sub-ja,NTP,0,0,0,,Өте жақсы, Тамаки-сан.
Dialogue: 0,0:11:56.62,0:12:00.62,Style1,,0,0,0,,Жаңбыр жауса бұдан да тиімдірек болатынына сенімдімін.
Dialogue: 0,0:11:56.79,0:11:59.63,jp.sub-ja,NTP,0,0,0,,Жаңбыр жауған кезде тиімдірек, мен сенімдімін.
Dialogue: 0,0:12:00.60,0:12:02.71,jp.sub-ja,NTP,0,0,0,,Ал, күтейік, көрейік.
Dialogue: 0,0:12:00.62,0:12:02.96,Style1,,0,0,0,,Ал, қалай болғанын көрейік, неге көрмейміз?
Dialogue: 0,0:12:02.96,0:12:05.89,Style1,,0,0,0,,Бір қызық болады, бәс тігемін.
Dialogue: 0,0:12:03.06,0:12:05.71,jp.sub-ja,NTP,0,0,0,,Қызық болады деп ойлаймын.
Dialogue: 0,0:12:24.98,0:12:28.32,Style1,,0,0,0,,Зембіл алыңыз! Оны тез арада ауруханаға апарыңыз!
Dialogue: 0,0:12:25.17,0:12:27.93,jp.sub-ja,NTP,0,0,0,,Бұл зембіл. Дереу емханаға апарыңыз.
Dialogue: 0,0:12:28.32,0:12:29.65,Style1,,0,0,0,,Каору!
Dialogue: 0,0:12:28.53,0:12:31.20,jp.sub-ja,NTP,0,0,0,,Каору Каору Каору
Dialogue: 0,0:12:29.65,0:12:31.32,Style1,,0,0,0,,Каору! Каору!
Dialogue: 0,0:12:31.32,0:12:33.66,Style1,,0,0,0,,Хикару-кун, сен алмайсың. Ойынға қайта оралыңыз.
Dialogue: 0,0:12:31.49,0:12:33.70,jp.sub-ja,NTP,0,0,0,,Лайт-кун, сен жақсы емессің. Ойынға оралыңыз.
Dialogue: 0,0:12:33.66,0:12:34.99,Style1,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:12:33.76,0:12:34.65,jp.sub-ja,NTP,0,0,0,,Үндетпе
Dialogue: 0,0:12:34.99,0:12:36.99,Style1,,0,0,0,,Хикару...
Dialogue: 0,0:12:35.13,0:12:36.02,jp.sub-ja,NTP,0,0,0,,Жарық
Dialogue: 0,0:12:36.99,0:12:39.83,Style1,,0,0,0,,Хикару, сабыр ет.
Dialogue: 0,0:12:37.26,0:12:39.80,jp.sub-ja,NTP,0,0,0,,Жарық тыныштандырады
Dialogue: 0,0:12:39.83,0:12:43.26,Style1,,0,0,0,,Менің ауырғанымды сезінуге баруға болмайды.
Dialogue: 0,0:12:40.03,0:12:42.55,jp.sub-ja,NTP,0,0,0,,Менің ауырғанымды сезбе
Dialogue: 0,0:12:43.26,0:12:48.27,Style1,,0,0,0,,Түсіндің бе? Жарақат алған сен емессің.
Dialogue: 0,0:12:43.48,0:12:47.08,jp.sub-ja,NTP,0,0,0,,Жақсы, сен жараланған адам емессің.
Dialogue: 0,0:12:48.27,0:12:53.94,Style1,,0,0,0,,Оның пайдасы жоқ. Ол аурады. Ауырды, Каору!
Dialogue: 0,0:12:48.33,0:12:49.12,jp.sub-ja,NTP,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:12:49.94,0:12:52.64,jp.sub-ja,NTP,0,0,0,,Ауырды, Каору ауырады
Dialogue: 0,0:12:53.94,0:12:58.95,Style1,,0,0,0,,Сенің дертің – менің азабым. Басқа ешкім түсінбесе маңызды емес.
Dialogue: 0,0:12:54.13,0:12:56.25,jp.sub-ja,NTP,0,0,0,,Сенің дертің – менің азабым
Dialogue: 0,0:12:56.51,0:12:58.39,jp.sub-ja,NTP,0,0,0,,Ешкімнің түсінуі қажет емес
Dialogue: 0,0:12:58.95,0:13:03.62,Style1,,0,0,0,,Екеуміз бір-біріміз үшін бар болсақ, өмір сүруді жалғастыра аламыз.
Dialogue: 0,0:12:59.14,0:13:02.22,jp.sub-ja,NTP,0,0,0,,Біз бір-біріміз болғанша өмір сүре аламыз.
Dialogue: 0,0:13:03.62,0:13:06.96,Style1,,0,0,0,,Мен екеуіңе қызғанышпен қараймын.
Dialogue: 0,0:13:03.65,0:13:06.05,jp.sub-ja,NTP,0,0,0,,Мен сендерді қызғанамын.
Dialogue: 0,0:13:06.96,0:13:10.29,Style1,,0,0,0,,Бір-бірін осылай сүйе білу...
Dialogue: 0,0:13:07.05,0:13:09.99,jp.sub-ja,NTP,0,0,0,,Бір-бірін осылай қолдайтын біреудің болуы
Dialogue: 0,0:13:10.29,0:13:11.96,Style1,,0,0,0,,Суоусенпай...
Dialogue: 0,0:13:10.39,0:13:11.78,jp.sub-ja,NTP,0,0,0,,Суо Сенпай
Dialogue: 0,0:13:11.88,0:13:15.00,jp.sub-ja,NTP,0,0,0,,Бірақ Суо-сенпай мектептің кумирі.
Dialogue: 0,0:13:11.96,0:13:15.30,Style1,,0,0,0,,Бірақ сіз академияның кумирісіз.
Dialogue: 0,0:13:15.30,0:13:17.99,Style1,,0,0,0,,Мен пұтпын ба?
Dialogue: 0,0:13:15.44,0:13:17.32,jp.sub-ja,NTP,0,0,0,,Пұт?
Dialogue: 0,0:13:19.97,0:13:24.31,Style1,,0,0,0,,Егер адамдар мені осындай үстірт атаумен атап өткісі келсе,
Dialogue: 0,0:13:20.00,0:13:24.01,jp.sub-ja,NTP,0,0,0,,Мен мұндай үстірт атпен қорланғаным дұрыс.
Dialogue: 0,0:13:24.31,0:13:27.74,Style1,,0,0,0,,онда мен жалғыз болғаным жақсы болатынына сенімдімін.
Dialogue: 0,0:13:24.59,0:13:26.98,jp.sub-ja,NTP,0,0,0,,Жалғыз болған жақсы екеніне сенімдімін.
Dialogue: 0,0:13:28.98,0:13:31.98,Style1,,0,0,0,,Бір жарақаттанған жүрек екіншісімен қиылысады.
Dialogue: 0,0:13:29.03,0:13:34.25,jp.sub-ja,NTP,0,0,0,,Жаралы жүректер тоғысады, түсініспеушілік бірін-бірі жаралайды
Dialogue: 0,0:13:31.98,0:13:34.65,Style1,,0,0,0,,Бір-бірінің жанынан өтіп, бірін-бірі жаралайды.
Dialogue: 0,0:13:34.61,0:13:36.44,jp.sub-ja,NTP,0,0,0,,Ұлдардың жүрегі қандай?
Dialogue: 0,0:13:34.65,0:13:36.91,Style1,,0,0,0,,Бұл жігіттердің жүректері неден жасалған?
Dialogue: 0,0:13:38.65,0:13:40.95,Style1,,0,0,0,,Енді қаша алмайсың.
Dialogue: 0,0:13:38.80,0:13:40.48,jp.sub-ja,NTP,0,0,0,,Мен енді қаша алмаймын
Dialogue: 0,0:13:43.93,0:13:47.60,Style1,,0,0,0,,Сен маған қарсы шыққанда не болатынын білесің.
Dialogue: 0,0:13:43.96,0:13:47.67,jp.sub-ja,NTP,0,0,0,,Маған бағынбасаң не болатынын есіңе түсір.
Dialogue: 0,0:13:47.60,0:13:49.26,Style1,,0,0,0,,Болма, Мицукуни.
Dialogue: 0,0:13:47.80,0:13:48.83,jp.sub-ja,NTP,0,0,0,,Мицукуниді тоқтатыңыз
Dialogue: 0,0:13:49.20,0:13:53.81,jp.sub-ja,NTP,0,0,0,,Біреуді ренжіткен сайын, ең соңында ренжітетін де, қинайтын да өзіңсің.
Dialogue: 0,0:13:49.26,0:13:53.94,Style1,,0,0,0,,Сіз басқаларды ренжіткен сайын, сіз ренжітетін адамсыз.
Dialogue: 0,0:13:53.90,0:13:55.72,jp.sub-ja,NTP,0,0,0,,Маған пікір айтпа Такаши
Dialogue: 0,0:13:53.94,0:13:55.94,Style1,,0,0,0,,Маған кеңес беруге тырыспа, Такаши.
Dialogue: 0,0:13:55.94,0:13:58.94,Style1,,0,0,0,,Сені тағы да тіземе отырғызғанымды қалайсың ба?
Dialogue: 0,0:13:56.03,0:13:58.01,jp.sub-ja,NTP,0,0,0,,Тағы да жазаланғың келе ме?
Dialogue: 0,0:13:58.94,0:14:02.94,Style1,,0,0,0,,Ақырында оларды күтіп тұрған құтқарылу нұры бола ма?
Dialogue: 0,0:13:58.95,0:14:03.82,jp.sub-ja,NTP,0,0,0,,Оларды қандай соңы күтіп тұр? Бұл құтқарудың нұры бола ма? Немесе
Dialogue: 0,0:14:02.94,0:14:04.61,Style1,,0,0,0,,Әлде басқа нәрсе ме?
Dialogue: 0,0:14:04.53,0:14:08.12,jp.sub-ja,NTP,0,0,0,,Мен өз мәртебесіне лайық емес адамдарды жек көремін.
Dialogue: 0,0:14:04.61,0:14:08.45,Style1,,0,0,0,,Мен адамдардың өмірде өз деңгейінен жоғары көтерілуге ​​тырысқанын жек көремін.
Dialogue: 0,0:14:13.50,0:14:17.43,jp.sub-ja,NTP,0,0,0,,Хару-чан, кешіріңіз. Бұл бәрінен кейін солай.
Dialogue: 0,0:14:13.62,0:14:17.29,Style1,,0,0,0,,Хару-чан, кешіріңіз! Мен мұны шынымен істей алмаймын!
Dialogue: 0,0:14:17.29,0:14:18.29,Style1,,0,0,0,,Кесу!!
Dialogue: 0,0:14:17.43,0:14:20.58,jp.sub-ja,NTP,0,0,0,,Cut Cut Cut Cut
Dialogue: 0,0:14:18.29,0:14:20.96,Style1,,0,0,0,,Кесу! Кесу! Кесу!
Dialogue: 0,0:14:20.92,0:14:23.13,jp.sub-ja,NTP,0,0,0,,Онда сценарийді орындаңыз.
Dialogue: 0,0:14:20.96,0:14:22.96,Style1,,0,0,0,,Сен сонда! Сценарийді ұстаныңыз!
Dialogue: 0,0:14:22.96,0:14:24.63,Style1,,0,0,0,,Бірақ мен...
Dialogue: 0,0:14:23.13,0:14:24.79,jp.sub-ja,NTP,0,0,0,,Өйткені
Dialogue: 0,0:14:24.63,0:14:25.97,Style1,,0,0,0,,Оператор, әзірше күте тұрыңыз!
Dialogue: 0,0:14:24.85,0:14:26.24,jp.sub-ja,NTP,0,0,0,,Камера, бір сәтке тоқтаңыз.
Dialogue: 0,0:14:25.97,0:14:26.97,Style1,,0,0,0,,Иә, бастық.
Dialogue: 0,0:14:26.24,0:14:27.12,jp.sub-ja,NTP,0,0,0,,Иса Босе
Dialogue: 0,0:14:26.97,0:14:28.64,Style1,,0,0,0,,Жаңбырды жүректі ауыртыңыз!
Dialogue: 0,0:14:27.12,0:14:28.78,jp.sub-ja,NTP,0,0,0,,Жаңбыр мұңдырақ болады
Dialogue: 0,0:14:28.64,0:14:30.97,Style1,,0,0,0,,Неліктен біз кейіпкерлерімізді өзгерту туралы әңгімеден шығып кеттік?
Dialogue: 0,0:14:28.78,0:14:29.78,jp.sub-ja,NTP,0,0,0,,Иса Босе
Dialogue: 0,0:14:28.89,0:14:32.40,jp.sub-ja,NTP,0,0,0,,Неліктен біз кенеттен кейіпкерлердің өзгеруі туралы әңгімелесуден фильм түсіруге көштік?
Dialogue: 0,0:14:30.97,0:14:32.64,Style1,,0,0,0,,фильмді түсіру керек пе?
Dialogue: 0,0:14:32.57,0:14:35.54,jp.sub-ja,NTP,0,0,0,,Дегенмен, бұл тым асыра түсірілген түсірілім тобы.
Dialogue: 0,0:14:32.64,0:14:35.64,Style1,,0,0,0,,Айтайын дегенім, бұл түсірілім тобының шамадан тыс жұмысы, иә?
Dialogue: 0,0:14:35.61,0:14:37.62,jp.sub-ja,NTP,0,0,0,,Оны Голливудтан қысқа мерзімде шақырған сияқты.
Dialogue: 0,0:14:35.64,0:14:37.98,Style1,,0,0,0,,Ол оларды Голливудтан осында жеткізген сияқты.
Dialogue: 0,0:14:37.98,0:14:39.31,Style1,,0,0,0,,Сіз оларды ешқашан көрмедіңіз бе?
Dialogue: 0,0:14:38.06,0:14:39.20,jp.sub-ja,NTP,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:14:39.31,0:14:42.65,Style1,,0,0,0,,Бұл адам «Мыңжылдық қар» вампир фильмінің режиссері
Dialogue: 0,0:14:39.48,0:14:43.95,jp.sub-ja,NTP,0,0,0,,Өткен жылы АҚШ кассасында бірінші орын алған «Вампир» фильмі
Dialogue: 0,0:14:42.65,0:14:46.25,Style1,,0,0,0,,бұл өткен жылы Америкадағы кассадағы бірінші орын болды.
Dialogue: 0,0:14:44.05,0:14:45.68,jp.sub-ja,NTP,0,0,0,,Мыңжылдық қардың директоры
Dialogue: 0,0:14:46.16,0:14:48.18,jp.sub-ja,NTP,0,0,0,,Қарғыс атсын сендерге байлар.
Dialogue: 0,0:14:46.25,0:14:48.26,Style1,,0,0,0,,Қарғыс атсын мына байларға...
Dialogue: 0,0:14:48.26,0:14:52.26,Style1,,0,0,0,,Тағы бір нәрсе, бұл сценарий қалай Каору құмыра болды?
Dialogue: 0,0:14:48.36,0:14:52.07,jp.sub-ja,NTP,0,0,0,,Негізінде бұл сценарийде Каору неге агрессивті?
Dialogue: 0,0:14:52.26,0:14:53.26,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:14:52.28,0:14:53.12,jp.sub-ja,NTP,0,0,0,,Сәлем~
Dialogue: 0,0:14:53.26,0:14:54.26,Style1,,0,0,0,,Құмыраны?
Dialogue: 0,0:14:53.27,0:14:54.33,jp.sub-ja,NTP,0,0,0,,Шабуыл
Dialogue: 0,0:14:54.26,0:14:56.93,Style1,,0,0,0,,Білмесеңіз, қарсы болмаңыз.
Dialogue: 0,0:14:54.45,0:14:56.31,jp.sub-ja,NTP,0,0,0,,Түсінбейтін балаларға жарай ма?
Dialogue: 0,0:14:56.93,0:14:58.27,Style1,,0,0,0,,Құмыраны?
Dialogue: 0,0:14:57.08,0:14:57.85,jp.sub-ja,NTP,0,0,0,,Шабуыл
Dialogue: 0,0:14:57.27,0:14:58.76,Style2,,0,0,0,,«Құмыра?»
Dialogue: 0,0:14:59.60,0:15:00.97,Style1,,0,0,0,,Харухи...
Dialogue: 0,0:14:59.67,0:15:00.23,jp.sub-ja,NTP,0,0,0,,Харухи
Dialogue: 0,0:15:01.94,0:15:04.27,Style1,,0,0,0,,Менің орындауым қалай болды?
Dialogue: 0,0:15:02.25,0:15:04.28,jp.sub-ja,NTP,0,0,0,,Менің актерлік қабілетім қалай болды?
Dialogue: 0,0:15:04.27,0:15:06.61,Style1,,0,0,0,,Бұл сөздің бір мағынасында керемет болды.
Dialogue: 0,0:15:04.59,0:15:06.52,jp.sub-ja,NTP,0,0,0,,Бұл бір жағынан таңқаларлық болды.
Dialogue: 0,0:15:06.61,0:15:09.94,Style1,,0,0,0,,, ең болмағанда, сіз мұны қалай таң қалдыра аласыз.
Dialogue: 0,0:15:06.64,0:15:10.00,jp.sub-ja,NTP,0,0,0,,Бір жағынан, бұл неге соншалықты мас?
Dialogue: 0,0:15:09.94,0:15:12.95,Style1,,0,0,0,,Мен өзімнің жаңа қырымды аштым.
Dialogue: 0,0:15:10.08,0:15:12.80,jp.sub-ja,NTP,0,0,0,,Мен өзімнің жаңа қырымды аштым.
Dialogue: 0,0:15:12.95,0:15:16.62,Style1,,0,0,0,,Осы жолмен біраз уақыт жүру жаман идея емес.
Dialogue: 0,0:15:13.10,0:15:15.80,jp.sub-ja,NTP,0,0,0,,Бұл жолмен біраз уақыт жүру жаман емес.
Dialogue: 0,0:15:16.56,0:15:17.53,jp.sub-ja,NTP,0,0,0,,Солай ма?
Dialogue: 0,0:15:16.62,0:15:18.29,Style1,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:15:18.29,0:15:21.52,Style1,,0,0,0,,Сенпай, сен қалай болсаң жақсысың деп ойлаймын.
Dialogue: 0,0:15:18.35,0:15:20.92,jp.sub-ja,NTP,0,0,0,,Менің ойымша, үлкендер қазіргідей қалуы керек.
Dialogue: 0,0:15:22.79,0:15:24.71,jp.sub-ja,NTP,0,0,0,,Мен көремін.
Dialogue: 0,0:15:22.96,0:15:25.63,Style1,,0,0,0,,R-шынымен бе?
Dialogue: 0,0:15:25.63,0:15:28.30,Style1,,0,0,0,,Хмм, егер солай десеңіз...
Dialogue: 0,0:15:25.80,0:15:28.02,jp.sub-ja,NTP,0,0,0,,Иә, егер солай десеңіз.
Dialogue: 0,0:15:28.30,0:15:32.00,jp.sub-ja,NTP,0,0,0,,Көлеңке немесе бір нәрсе болса, бұл адам одан да қиын көрінеді.
Dialogue: 0,0:15:28.30,0:15:32.30,Style1,,0,0,0,,Егер бұл жігіттің қараңғы жағы болса, ол әлдеқайда қиын болады.
Dialogue: 0,0:15:32.25,0:15:34.67,jp.sub-ja,NTP,0,0,0,,Харухи-кун, сенің кезегің.
Dialogue: 0,0:15:32.30,0:15:34.64,Style1,,0,0,0,,Харухи-кун! Сіз қостыңыз!
Dialogue: 0,0:15:34.64,0:15:36.64,Style1,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:15:36.56,0:15:37.94,jp.sub-ja,NTP,0,0,0,,Осы жолмен.
Dialogue: 0,0:15:36.64,0:15:38.30,Style1,,0,0,0,,Қайырымдылық қорабы
Dialogue: 0,0:15:39.31,0:15:43.24,Style1,,0,0,0,,Мен жаңа ғана осы екі мырзадан ерекше көрінуін сұрадым.
Dialogue: 0,0:15:39.44,0:15:42.97,jp.sub-ja,NTP,0,0,0,,Мен бұл кісілерден ерекше көрініс беруді сұрадым.
Dialogue: 0,0:15:43.24,0:15:43.91,Style1,,0,0,0,,Сыртқы түрі?
Dialogue: 0,0:15:43.30,0:15:44.05,jp.sub-ja,NTP,0,0,0,,Сыртқы түрі
Dialogue: 0,0:15:43.91,0:15:45.25,Style1,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:15:44.12,0:15:45.06,jp.sub-ja,NTP,0,0,0,,Тіпті араластырсам да—
Dialogue: 0,0:15:45.22,0:15:48.31,jp.sub-ja,NTP,0,0,0,,Бізге шарықтау шегі үшін жауыз керек.
Dialogue: 0,0:15:45.25,0:15:48.15,Style1,,0,0,0,,Үлкен шарықтау үшін бізге зұлым адамдар керек болады.
Dialogue: 0,0:15:48.15,0:15:50.25,Style1,,0,0,0,,Клуб мүшелерінің бірігуі,
Dialogue: 0,0:15:48.15,0:15:52.92,Style2,,0,0,0,,"Ақыры, соңғы қарсыласу уақыты келді. Академияны бұдан да үлкен зұлымдық басып алды"
Dialogue: 0,0:15:48.42,0:15:49.96,jp.sub-ja,NTP,0,0,0,,Бөлінген мүшелер
Dialogue: 0,0:15:50.10,0:15:52.87,jp.sub-ja,NTP,0,0,0,,Нағыз зұлым кейіпкермен күресу арқылы бір болыңыз
Dialogue: 0,0:15:50.25,0:15:53.25,Style1,,0,0,0,,кейбір нағыз жаман кейіпкерлермен күресу.
Dialogue: 0,0:15:52.92,0:16:04.16,Style2,,0,0,0,,«Жапондық мафияның ұлдары - ағайынды Акутаро мен Акудзиро!!»
Dialogue: 0,0:15:52.99,0:15:56.16,jp.sub-ja,NTP,0,0,0,,Жазбаларға қарағанда, бұл екеуі ауқатты адамдар болса да,
Dialogue: 0,0:15:53.25,0:15:56.26,Style1,,0,0,0,,Менің жазбаларыма сәйкес, бұл екеуі ауқатты отбасынан болуы мүмкін,
Dialogue: 0,0:15:56.25,0:15:58.34,jp.sub-ja,NTP,0,0,0,,Негізі жапон мафиясының ұлы
Dialogue: 0,0:15:56.26,0:15:58.59,Style1,,0,0,0,,олар шын мәнінде жапондық мафия мүшелерінің ұлдары.
Dialogue: 0,0:15:58.59,0:16:00.60,Style1,,0,0,0,,Бұл шынымен де сіз үшін тамаша бөліктер.
Dialogue: 0,0:15:58.60,0:16:00.67,jp.sub-ja,NTP,0,0,0,,Бұл тамаша актерлік құрам.
Dialogue: 0,0:16:00.60,0:16:01.93,Style1,,0,0,0,,Мына қызда не бар?
Dialogue: 0,0:16:00.76,0:16:02.05,jp.sub-ja,NTP,0,0,0,,Бұл әйел кім?
Dialogue: 0,0:16:01.93,0:16:04.17,Style1,,0,0,0,,Менің әкем қандай болса да, оның маған қатысы жоқ!
Dialogue: 0,0:16:02.08,0:16:04.44,jp.sub-ja,NTP,0,0,0,,Мен үшін ата-анамның қандай екені маңызды емес.
Dialogue: 0,0:16:04.17,0:16:05.60,Style1,,0,0,0,,Күте тұрыңыз, Ренге-чан...
Dialogue: 0,0:16:04.52,0:16:05.95,jp.sub-ja,NTP,0,0,0,,Эй, Ренге-чан
Dialogue: 0,0:16:05.60,0:16:08.27,Style1,,0,0,0,,- Жарайды, осы жерде тұр. - Мұнда бір минут...
Dialogue: 0,0:16:05.95,0:16:08.21,jp.sub-ja,NTP,0,0,0,,Қалай болғанда да, осы жерде күту режимі.
Dialogue: 0,0:16:06.54,0:16:08.09,jp.sub-ja,NTP,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:16:08.25,0:16:11.81,jp.sub-ja,NTP,0,0,0,,Не қаласаңыз, соны айтып, бортқа отырмаңыз.
Dialogue: 0,0:16:08.27,0:16:11.94,Style1,,0,0,0,,Сіз бізді қалағаныңызша итермелей аласыз деп ойлайсыз ба? Одан шығыңыз!
Dialogue: 0,0:16:11.94,0:16:13.30,Style1,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:16:12.10,0:16:12.88,jp.sub-ja,NTP,0,0,0,,Қауіпті
Dialogue: 0,0:16:20.92,0:16:21.42,jp.sub-ja,NTP,0,0,0,,Осы жерден айналып өтейік…
Dialogue: 0,0:16:20.95,0:16:23.62,Style1,,0,0,0,,- Ой... - Харухи-кун! Сенімен бәрі жақсы ма!?
Dialogue: 0,0:16:21.63,0:16:23.16,jp.sub-ja,NTP,0,0,0,,Харухи-кун, жақсысың ба?
Dialogue: 0,0:16:23.61,0:16:25.95,jp.sub-ja,NTP,0,0,0,,Бұл адамдар дұрыс айтады.
Dialogue: 0,0:16:23.62,0:16:26.62,Style1,,0,0,0,,Бұл балалар дұрыс айтады.
Dialogue: 0,0:16:26.62,0:16:29.96,Style1,,0,0,0,,Ренге-чан, егер сіз адамдарды стереотиптер бойынша бағаласаңыз,
Dialogue: 0,0:16:26.76,0:16:29.80,jp.sub-ja,NTP,0,0,0,,Ренге-чан: Мен кадрлармен адамдарды жоспарладым.
Dialogue: 0,0:16:29.96,0:16:33.96,Style1,,0,0,0,,сіз шынымен маңызды нәрсені көре алмайсыз.
Dialogue: 0,0:16:30.03,0:16:33.24,jp.sub-ja,NTP,0,0,0,,Сіз шынымен маңызды ештеңені көре алмайсыз.
Dialogue: 0,0:16:33.96,0:16:36.63,Style1,,0,0,0,,Нені меңзеп тұрғаныңызды түсінбеймін.
Dialogue: 0,0:16:33.99,0:16:36.32,jp.sub-ja,NTP,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:16:36.52,0:16:37.84,jp.sub-ja,NTP,0,0,0,,Харухи, не болды?
Dialogue: 0,0:16:36.63,0:16:38.29,Style1,,0,0,0,,Харухи! Не болды!?
Dialogue: 0,0:16:46.24,0:16:48.91,Style1,,0,0,0,,Мұны қайсыларың бастады?
Dialogue: 0,0:16:46.33,0:16:48.12,jp.sub-ja,NTP,0,0,0,,Қайсысы істеді?
Dialogue: 0,0:16:48.91,0:16:53.25,Style1,,0,0,0,,Күте тұр, Суо! Ол бізге қиын уақытты бастады!
Dialogue: 0,0:16:49.08,0:16:52.35,jp.sub-ja,NTP,0,0,0,,Тоқта, Суо, сен бірінші араластың.
Dialogue: 0,0:16:53.25,0:16:55.25,Style1,,0,0,0,,Бұл рас, Сенпай.
Dialogue: 0,0:16:53.34,0:16:55.31,jp.sub-ja,NTP,0,0,0,,Бұл рас, Сенпай.
Dialogue: 0,0:16:55.25,0:16:57.84,Style1,,0,0,0,,Бұл балалардың кінәсі жоқ.
Dialogue: 0,0:16:55.46,0:16:57.40,jp.sub-ja,NTP,0,0,0,,Бұл адамдар жаман емес.
Dialogue: 0,0:17:00.59,0:17:02.06,Style1,,0,0,0,,- Қаш! - Жүгіріп кету!
Dialogue: 0,0:17:00.62,0:17:01.78,jp.sub-ja,NTP,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:17:06.93,0:17:10.26,Style1,,0,0,0,,Харухи... ауырады ма?
Dialogue: 0,0:17:07.18,0:17:09.64,jp.sub-ja,NTP,0,0,0,,Харухи, ауырып жатыр ма?
Dialogue: 0,0:17:11.27,0:17:12.93,Style1,,0,0,0,,Иә...
Dialogue: 0,0:17:11.33,0:17:13.98,jp.sub-ja,NTP,0,0,0,,Иә, хабарласыңыз
Dialogue: 0,0:17:12.93,0:17:13.94,Style1,,0,0,0,,Бұл менің контактім.
Dialogue: 0,0:17:13.94,0:17:17.27,Style1,,0,0,0,,Иә? Сіздің байланысыңыз?
Dialogue: 0,0:17:14.05,0:17:16.93,jp.sub-ja,NTP,0,0,0,,Байланыс
Dialogue: 0,0:17:17.26,0:17:19.59,jp.sub-ja,NTP,0,0,0,,Иә, аздап қалды.
Dialogue: 0,0:17:17.27,0:17:20.00,Style1,,0,0,0,,Иә. Сыртқа шығып кетті.
Dialogue: 0,0:17:23.95,0:17:25.61,Style1,,0,0,0,,О, солай болды!
Dialogue: 0,0:17:24.34,0:17:25.66,jp.sub-ja,NTP,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:17:25.61,0:17:29.61,Style1,,0,0,0,,Көз тамшыларын қолданбай жылай алсаң, сен толыққанды иесісің!
Dialogue: 0,0:17:25.72,0:17:29.12,jp.sub-ja,NTP,0,0,0,,Көз тамшысын қолданбай жыласаңыз, сіз толыққанды иесісіз.
Dialogue: 0,0:17:34.16,0:17:36.92,jp.sub-ja,NTP,0,0,0,,Ka Ka камерасы қазір!
Dialogue: 0,0:17:34.96,0:17:36.96,Style1,,0,0,0,,Оператор, ұстадың ба!?
Dialogue: 0,0:17:36.96,0:17:37.96,Style1,,0,0,0,,Иә, бастық!
Dialogue: 0,0:17:37.03,0:17:38.02,jp.sub-ja,NTP,0,0,0,,Иса Босс
Dialogue: 0,0:17:37.96,0:17:41.30,Style1,,0,0,0,,Контакттың үзілуін қоспағанда, бұл тамаша соңғы көрініс болды!
Dialogue: 0,0:17:38.12,0:17:41.56,jp.sub-ja,NTP,0,0,0,,Контактіні түсіруден басқа, бұл тамаша соңғы көрініс.
Dialogue: 0,0:17:41.30,0:17:44.75,Style1,,0,0,0,,Кёйя-саманың әсерлі баяндауы ғана қажет.
Dialogue: 0,0:17:41.62,0:17:44.56,jp.sub-ja,NTP,0,0,0,,Кёя-самаға әсерлі баяндау ғана қалды.
Dialogue: 0,0:17:47.17,0:17:49.29,jp.sub-ja,NTP,0,0,0,,Менің камерам жоқ
Dialogue: 0,0:17:47.24,0:17:49.90,Style1,,0,0,0,,Жоқ! Менің камерам!
Dialogue: 0,0:17:49.90,0:17:52.24,Style1,,0,0,0,,К-Кёя-сама?
Dialogue: 0,0:17:49.99,0:17:51.66,jp.sub-ja,NTP,0,0,0,,Айна Кёя-сама
Dialogue: 0,0:17:52.24,0:17:54.91,Style1,,0,0,0,,Кешіріңіз, бірақ мен ешқандай жазба болуына жол бере алмаймын
Dialogue: 0,0:17:52.42,0:17:53.68,jp.sub-ja,NTP,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:17:53.68,0:17:57.18,jp.sub-ja,NTP,0,0,0,,Клуб мүшелерінің зорлық-зомбылық әрекеттерін жазу мүмкін емес.
Dialogue: 0,0:17:54.91,0:17:57.91,Style1,,0,0,0,,клуб мүшесінің зорлық-зомбылық көрсетуі.
Dialogue: 0,0:17:57.91,0:18:02.37,Style1,,0,0,0,,Мен сіздің осындай зиянкес сияқты әрекет еткеніңізге қатты наразымын.
Dialogue: 0,0:17:57.94,0:18:01.75,jp.sub-ja,NTP,0,0,0,,Мұндай ыңғайсыздық өте жағымсыз.
Dialogue: 0,0:18:03.55,0:18:04.38,jp.sub-ja,NTP,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:18:03.58,0:18:05.14,Style1,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:18:07.26,0:18:09.92,Style1,,0,0,0,,Кёя-сама, сен маған бұл туралы уайымдама деп айтуың керек,
Dialogue: 0,0:18:07.42,0:18:09.90,jp.sub-ja,NTP,0,0,0,,Кёйя-сама: «Ол үшін уайымдаудың қажеті жоқ» деп айтатын.
Dialogue: 0,0:18:09.92,0:18:13.38,Style1,,0,0,0,,, сосын басымнан ақырын сипап қойыңыз!
Dialogue: 0,0:18:10.03,0:18:12.68,jp.sub-ja,NTP,0,0,0,,Ол менің басымнан ақырын сипау керек еді.
Dialogue: 0,0:18:14.60,0:18:18.60,Style1,,0,0,0,,Неліктен сіз сияқты мейірімді және мейірімді адам...
Dialogue: 0,0:18:14.81,0:18:18.28,jp.sub-ja,NTP,0,0,0,,Сен неге сонша мейірімді, жанашырсың?
Dialogue: 0,0:18:18.60,0:18:21.26,Style1,,0,0,0,,Бұл Киойя емес.
Dialogue: 0,0:18:18.84,0:18:20.65,jp.sub-ja,NTP,0,0,0,,Бұл Киоя емес.
Dialogue: 0,0:18:32.95,0:18:34.92,Style1,,0,0,0,,Бұл маңызды емес, солай ма?
Dialogue: 0,0:18:33.05,0:18:34.32,jp.sub-ja,NTP,0,0,0,,Жарайды.
Dialogue: 0,0:18:36.28,0:18:41.29,Style1,,0,0,0,,Кёя-сенпай сіз күткеннен сәл өзгеше болса да, Ренге-чан,
Dialogue: 0,0:18:36.29,0:18:40.49,jp.sub-ja,NTP,0,0,0,,Кьюя-сенпай Ренге-чан ойлаған адамнан сәл өзгеше болса да.
Dialogue: 0,0:18:41.29,0:18:42.79,Style1,,0,0,0,,Менің ойымша, адамдарды қарау,
Dialogue: 0,0:18:41.35,0:18:44.80,jp.sub-ja,NTP,0,0,0,,Адамдарға мұқият қарап, оларды бірте-бірте танып біл.
Dialogue: 0,0:18:42.79,0:18:44.96,Style1,,0,0,0,,және баяу, бірте-бірте, олармен танысу,
Dialogue: 0,0:18:44.94,0:18:46.28,jp.sub-ja,NTP,0,0,0,,Менің ойымша, бұл қызық
Dialogue: 0,0:18:44.96,0:18:46.93,Style1,,0,0,0,,қызықты болуы мүмкін.
Dialogue: 0,0:18:50.97,0:18:52.97,Style1,,0,0,0,,Эй, Ренге-чан, көптен бері көрмегелі.
Dialogue: 0,0:18:51.10,0:18:52.95,jp.sub-ja,NTP,0,0,0,,Я Ренге-чан, біраз уақыт болды.
Dialogue: 0,0:18:52.97,0:18:55.30,Style1,,0,0,0,,Сіз төмен қарайсыз, иә? Жүр, мен үшін күл.
Dialogue: 0,0:18:53.08,0:18:54.03,jp.sub-ja,NTP,0,0,0,,Сіз өзіңізді жақсы сезінбейсіз.
Dialogue: 0,0:18:54.25,0:18:57.37,jp.sub-ja,NTP,0,0,0,,Кел, күл, бүгін өте жақсы күн.
Dialogue: 0,0:18:55.30,0:18:57.97,Style1,,0,0,0,,Бүгін өте жақсы күн.
Dialogue: 0,0:18:57.97,0:19:00.98,Style1,,0,0,0,,Өйткені, Ренге-чан, сен бірдеңе үйрендің
Dialogue: 0,0:18:58.08,0:18:58.80,jp.sub-ja,NTP,0,0,0,,Өйткені
Dialogue: 0,0:18:58.89,0:19:02.31,jp.sub-ja,NTP,0,0,0,,Ренге-чанның бақытты өмір сүруіне көмектесуге тырысады.
Dialogue: 0,0:19:00.98,0:19:04.98,Style1,,0,0,0,,бұл сіз үшін бақытты өмір сүру үшін өте маңызды.
Dialogue: 0,0:19:02.50,0:19:04.44,jp.sub-ja,NTP,0,0,0,,Мен өте маңызды нәрсені білдім.
Dialogue: 0,0:19:04.98,0:19:08.01,Style1,,0,0,0,,Сіз шынымен де деңгейге көтерілдіңіз.
Dialogue: 0,0:19:05.15,0:19:07.93,jp.sub-ja,NTP,0,0,0,,Сіз шынымен де деңгейге көтерілдіңіз.
Dialogue: 0,0:19:10.89,0:19:13.35,Style2,,0,0,0,,«Бірнеше күннен кейін»
Dialogue: 0,0:19:11.58,0:19:13.32,jp.sub-ja,NTP,0,0,0,,қош келдіңіз
Dialogue: 0,0:19:11.65,0:19:13.65,Style1,,0,0,0,,Сәлем, кіріңіз.
Dialogue: 0,0:19:13.47,0:19:15.64,jp.sub-ja,NTP,0,0,0,,Мен мысал бейнені сатып алдым.
Dialogue: 0,0:19:13.65,0:19:15.32,Style1,,0,0,0,,Мен бұл бейнені сатып алдым!
Dialogue: 0,0:19:15.32,0:19:16.32,Style1,,0,0,0,,Мен де!
Dialogue: 0,0:19:15.64,0:19:17.15,jp.sub-ja,NTP,0,0,0,,Мен де
Dialogue: 0,0:19:16.32,0:19:17.66,Style1,,0,0,0,,Мен де!
Dialogue: 0,0:19:18.66,0:19:21.00,Style1,,0,0,0,,Жаңбырдағы бұл көрініс ең керемет болды!
Dialogue: 0,0:19:18.77,0:19:21.04,jp.sub-ja,NTP,0,0,0,,Жаңбырдың ең жақсы көрінісі болды
Dialogue: 0,0:19:21.00,0:19:22.33,Style1,,0,0,0,,Жалғыз ханзада!
Dialogue: 0,0:19:21.04,0:19:22.44,jp.sub-ja,NTP,0,0,0,,Жалғыз ханзада
Dialogue: 0,0:19:22.33,0:19:23.66,Style1,,0,0,0,,Хикару-сама арасындағы терең қарым-қатынас
Dialogue: 0,0:19:22.44,0:19:25.94,jp.sub-ja,NTP,0,0,0,,Хикару-сама мен Каору-сама арасындағы терең қарым-қатынасқа шыдай алмадым.
Dialogue: 0,0:19:23.66,0:19:26.00,Style1,,0,0,0,,және Каору-сама тым көп болды!
Dialogue: 0,0:19:25.94,0:19:28.88,jp.sub-ja,NTP,0,0,0,,Бал-кунның қатыгездігі Мен оны қайта көргім келеді
Dialogue: 0,0:19:26.00,0:19:29.00,Style1,,0,0,0,,Мен Балкунның бұзақы сияқты әрекет еткенін тағы көргім келеді!
Dialogue: 0,0:19:28.88,0:19:31.56,jp.sub-ja,NTP,0,0,0,,Харухидің мұңды жүзі
Dialogue: 0,0:19:29.00,0:19:31.67,Style1,,0,0,0,,Ал Харухи-кунның өткір өрнектері!
Dialogue: 0,0:19:31.67,0:19:33.67,Style1,,0,0,0,,- Морикун, әрине, мазохист болған, иә? - Кёя...
Dialogue: 0,0:19:31.69,0:19:35.20,jp.sub-ja,NTP,0,0,0,,Мори-кунның мазохист екені сөзсіз.
Dialogue: 0,0:19:32.67,0:19:33.58,jp.sub-ja,NTP,0,0,0,,Кагами түні
Dialogue: 0,0:19:33.67,0:19:35.34,Style1,,0,0,0,,Мен линзаны сындырған шығармын,
Dialogue: 0,0:19:33.76,0:19:35.29,jp.sub-ja,NTP,0,0,0,,Сіз линзаны сындырсаңыз да
Dialogue: 0,0:19:35.30,0:19:37.94,jp.sub-ja,NTP,0,0,0,,Әрине, түсірілген кадрлар әлі де бар.
Dialogue: 0,0:19:35.34,0:19:38.01,Style1,,0,0,0,,, бірақ, әрине, түсірілген кадрлар әлі де қалады.
Dialogue: 0,0:19:38.01,0:19:41.02,Style1,,0,0,0,,Әрине, зорлық-зомбылықтың бір көрінісі кесілген.
Dialogue: 0,0:19:38.08,0:19:40.70,jp.sub-ja,NTP,0,0,0,,Әрине, зорлық-зомбылық көріністері кесілген.
Dialogue: 0,0:19:41.02,0:19:43.28,Style1,,0,0,0,,Сатылым өте әділ болды.
Dialogue: 0,0:19:41.28,0:19:42.92,jp.sub-ja,NTP,0,0,0,,Сатылым жақсы.
Dialogue: 0,0:19:43.28,0:19:47.29,Style1,,0,0,0,,Голливудтың бірінші дәрежелі қызметкерлері сіз ойлағандай жақсы жұмыс жасады.
Dialogue: 0,0:19:43.29,0:19:47.41,jp.sub-ja,NTP,0,0,0,,Голливудтың жоғарғы қызметкерлері күткендей, олар тамаша жұмыс жасады.
Dialogue: 0,0:19:47.29,0:19:49.96,Style1,,0,0,0,,«Қызықты» дегеніңіз осы ма?
Dialogue: 0,0:19:47.52,0:19:49.53,jp.sub-ja,NTP,0,0,0,,Бұл қызықты
Dialogue: 0,0:19:49.90,0:19:52.11,jp.sub-ja,NTP,0,0,0,,Бөлім шығындары көбірек болғаны дұрыс.
Dialogue: 0,0:19:49.96,0:19:52.29,Style1,,0,0,0,,Клуб бюджетінде мүмкіндігінше көп болғаны дұрыс емес пе?
Dialogue: 0,0:19:52.29,0:19:56.63,Style1,,0,0,0,,Бұл жігіт осының барлығын қай кезде есептей бастады?
Dialogue: 0,0:19:52.58,0:19:55.60,jp.sub-ja,NTP,0,0,0,,Бұл адам есептей бастайды?
Dialogue: 0,0:19:56.63,0:19:57.97,Style1,,0,0,0,,Абайлаңыз.
Dialogue: 0,0:19:56.81,0:19:57.84,jp.sub-ja,NTP,0,0,0,,Жақсы көңіл-күй
Dialogue: 0,0:19:57.97,0:20:01.30,Style1,,0,0,0,,Иә? Мен сені Францияға үйіңе бардың деп ойладым.
Dialogue: 0,0:19:58.12,0:20:01.00,jp.sub-ja,NTP,0,0,0,,Ол Францияға қайтып оралмады ма?
Dialogue: 0,0:20:01.30,0:20:04.64,Style1,,0,0,0,,Мен бір нәрсені түсіндім. Бұрынғы мейірімділігің,
Dialogue: 0,0:20:01.43,0:20:03.49,jp.sub-ja,NTP,0,0,0,,Мен мұны түсіндім
Dialogue: 0,0:20:03.64,0:20:06.35,jp.sub-ja,NTP,0,0,0,,Сол кезде мені қорғау үшін өзіңді ұсынған мейірімділігің.
Dialogue: 0,0:20:04.64,0:20:06.97,Style1,,0,0,0,,сен мені қорғау үшін өміріңді қатерге тігіп,
Dialogue: 0,0:20:06.81,0:20:09.84,jp.sub-ja,NTP,0,0,0,,Маған кейде қатал кеңес беретін терең махаббат
Dialogue: 0,0:20:06.97,0:20:10.65,Style1,,0,0,0,,және кейде қатаң ескертулер бергеніңіз үшін терең сүйіспеншілігіңіз.
Dialogue: 0,0:20:10.65,0:20:12.65,Style1,,0,0,0,,Адамдарды бақылап отырғаныңыз осы,
Dialogue: 0,0:20:10.75,0:20:14.68,jp.sub-ja,NTP,0,0,0,,Біреуді көргенде ғашық болу деген осы, Харухи-кун.
Dialogue: 0,0:20:12.65,0:20:15.32,Style1,,0,0,0,,және оларға ғашық болу, солай ма Харухи-кун?
Dialogue: 0,0:20:15.32,0:20:16.32,Style1,,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:20:16.32,0:20:19.32,Style1,,0,0,0,,Кел, менің үйіме барайық, бірге ойын ойнайық.
Dialogue: 0,0:20:16.35,0:20:19.34,jp.sub-ja,NTP,0,0,0,,Жүр, менің үйімде бірге ойын ойнайық.
Dialogue: 0,0:20:19.32,0:20:21.66,Style1,,0,0,0,,Сіз де мен туралы көбірек білуіңіз керек.
Dialogue: 0,0:20:19.34,0:20:21.49,jp.sub-ja,NTP,0,0,0,,Сіз де мен туралы білуіңіз керек.
Dialogue: 0,0:20:21.66,0:20:22.66,Style1,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:20:22.61,0:20:23.80,jp.sub-ja,NTP,0,0,0,,Кёуя Сенпай
Dialogue: 0,0:20:22.66,0:20:23.66,Style1,,0,0,0,,Кёя-сенпай...
Dialogue: 0,0:20:23.66,0:20:24.99,Style1,,0,0,0,,Мұның дұрыс екеніне сенімдісіз бе?
Dialogue: 0,0:20:23.86,0:20:24.91,jp.sub-ja,NTP,0,0,0,,Жарайды.
Dialogue: 0,0:20:24.99,0:20:28.00,Style1,,0,0,0,,Неліктен олай емес? Ол айтқанында қателеспейді.
Dialogue: 0,0:20:25.12,0:20:28.04,jp.sub-ja,NTP,0,0,0,,Жарайсың, айтып тұрғаның қате емес.
Dialogue: 0,0:20:28.00,0:20:29.33,Style1,,0,0,0,,Жоқ, дұрыс емес!
Dialogue: 0,0:20:28.04,0:20:29.28,jp.sub-ja,NTP,0,0,0,,Жоқ, бұл жақсы емес.
Dialogue: 0,0:20:29.33,0:20:32.67,Style1,,0,0,0,,Екеуі де сіз қалағандай қыз болып бір-бірімен дос болып жатыр.
Dialogue: 0,0:20:29.40,0:20:32.60,jp.sub-ja,NTP,0,0,0,,Қалағаныңызша, қыздармен доспыз.
Dialogue: 0,0:20:32.67,0:20:35.16,jp.sub-ja,NTP,0,0,0,,Бұл қыздар арасында болуы мүмкін емес.
Dialogue: 0,0:20:32.67,0:20:35.34,Style1,,0,0,0,,Бірақ екеуі де қыз емес!
Dialogue: 0,0:20:35.27,0:20:37.56,jp.sub-ja,NTP,0,0,0,,Жүр, Харухи-кун, кеттік.
Dialogue: 0,0:20:35.34,0:20:37.34,Style1,,0,0,0,,Кел, Харухи-кун! Барайық!
Dialogue: 0,0:20:37.34,0:20:39.78,Style1,,0,0,0,,Күте тұрыңыз! Харухиді алып кетпе!
Dialogue: 0,0:20:37.56,0:20:39.85,jp.sub-ja,NTP,0,0,0,,Күте тұрыңыз, Харухиді өзіңізбен бірге алып кетпеңіз.
Dialogue: 0,0:20:41.50,0:20:42.50,Style1,,0,0,0,,Ұсқынсыз көрінесің!
Dialogue: 0,0:20:41.50,0:20:42.71,jp.sub-ja,NTP,0,0,0,,Сіз нашар көрінесіз.
Dialogue: 0,0:20:42.50,0:20:43.50,Style1,,0,0,0,,Сіздің шаш үлгісіңіз біртүрлі екен!
Dialogue: 0,0:20:42.71,0:20:43.71,jp.sub-ja,NTP,0,0,0,,Шаш үлгісі біртүрлі
Dialogue: 0,0:20:43.50,0:20:44.84,Style1,,0,0,0,,- Секс пикси! - Науқас!
Dialogue: 0,0:20:43.71,0:20:44.43,jp.sub-ja,NTP,0,0,0,,Эротикалық каппа
Dialogue: 0,0:20:44.43,0:20:45.03,jp.sub-ja,NTP,0,0,0,,Оған не болды?
Dialogue: 0,0:20:44.84,0:20:47.17,Style1,,0,0,0,,Бұл қалай болуы мүмкін? Хикару мен Каору...
Dialogue: 0,0:20:45.03,0:20:47.03,jp.sub-ja,NTP,0,0,0,,О, Құдайым, нұр мен от
Dialogue: 0,0:20:47.17,0:20:49.17,Style1,,0,0,0,,Келесі жолы «Егіздер төбелеседі»
Dialogue: 0,0:20:49.17,0:20:54.34,Style1,,0,0,0,,Сізді келесі аптада Оуран орта мектебінің хост клубы күтеді!
Dialogue: 0,0:20:49.31,0:20:52.11,jp.sub-ja,NTP,0,0,0,,Келесі аптада Оуран орта мектебінің хост клубы
Dialogue: 0,0:20:50.41,0:20:52.34,Style2,,0,0,0,,"Бум! Соққы! Жарылыс!"
Dialogue: 0,0:20:52.28,0:20:53.95,jp.sub-ja,NTP,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:20:55.84,0:21:01.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
