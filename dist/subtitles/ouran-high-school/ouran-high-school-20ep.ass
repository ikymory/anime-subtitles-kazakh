Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.80,staff-ja,,0,0,0,,Mam
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Жапония
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Syura
Dialogue: 0,0:00:00.00,0:00:03.17,staff-ja,,0,0,0,,Аударма сиясы
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Сабақ кестесі Қара мысық пен сиыр қыз
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Наксияның әкімшілік жүйесі
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,OP&ED Hagakure
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,Сюра
Dialogue: 0,0:00:00.00,0:00:03.88,Default11-ja,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:00:08.76,0:00:11.26,Style1,,0,0,0,,Жарайды,
Dialogue: 0,0:00:08.91,0:00:09.75,jp.sub-ja,,0,0,0,,Келіңіздер
Dialogue: 0,0:00:11.26,0:00:15.42,Style1,,0,0,0,,Қайсымыз Хикару, қайсысымыз Каору? Сіз айта аласыз ба?
Dialogue: 0,0:00:11.40,0:00:14.51,jp.sub-ja,,0,0,0,,Қайсысы жеңіл, қайсысы жеңіл екенін білесің бе?
Dialogue: 0,0:00:18.10,0:00:20.93,Style1,,0,0,0,,Сіз Хикару-кунсыз.
Dialogue: 0,0:00:18.52,0:00:20.05,jp.sub-ja,,0,0,0,,Бұл Жарық
Dialogue: 0,0:00:25.77,0:00:28.78,Style1,,0,0,0,,Біз әрқашан екі, бірақ бір болғанбыз.
Dialogue: 0,0:00:25.87,0:00:28.14,jp.sub-ja,,0,0,0,,Біз әрқашан бірге боламыз
Dialogue: 0,0:00:28.78,0:00:31.71,Style1,,0,0,0,,Екеуміз біртұтас, бірегей болдық.
Dialogue: 0,0:00:28.99,0:00:30.99,jp.sub-ja,,0,0,0,,Біз екеуміз ғанамыз
Dialogue: 0,0:00:31.71,0:00:34.91,Style1,,0,0,0,,Бұл өте маңызды болды.
Dialogue: 0,0:00:31.74,0:00:32.19,jp.sub-ja,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:00:32.55,0:00:34.91,Style2,,0,0,0,,«Сегіз жылдан кейін...»
Dialogue: 0,0:00:32.81,0:00:34.21,jp.sub-ja,,0,0,0,,Өте маңызды нәрсе
Dialogue: 0,0:00:35.01,0:00:37.38,Style2,,0,0,0,,«Хикару мен Каору орта мектептің 2 курсы»
Dialogue: 0,0:00:40.62,0:00:45.56,Style1,,0,0,0,,Бірақ біз бөлек болдық. Мен емес еді
Dialogue: 0,0:00:40.78,0:00:43.35,jp.sub-ja,,0,0,0,,Бірақ біз бөлек жаратылыстармыз
Dialogue: 0,0:00:44.35,0:00:46.23,jp.sub-ja,,0,0,0,,Менен жеңіл болған жақсы
Dialogue: 0,0:00:45.56,0:00:49.23,Style1,,0,0,0,,Хикару болды, ал Хикару емес мен болдым.
Dialogue: 0,0:00:46.79,0:00:48.30,jp.sub-ja,,0,0,0,,Жарықсыз болғанды жөн көремін
Dialogue: 0,0:00:49.23,0:00:51.89,Style1,,0,0,0,,Біз үшін бұл...
Dialogue: 0,0:00:49.28,0:00:50.43,jp.sub-ja,,0,0,0,,Бұл біз үшін...
Dialogue: 0,0:00:53.23,0:00:55.30,Style1,,0,0,0,,Ол осында.
Dialogue: 0,0:00:53.52,0:00:53.88,jp.sub-ja,,0,0,0,,Мен осындамын
Dialogue: 0,0:00:55.30,0:00:58.10,Style1,,0,0,0,,Иә, дұрыс айтасыз.
Dialogue: 0,0:00:55.49,0:00:56.96,jp.sub-ja,,0,0,0,,Иә, иә. Не болды? Сабыр, сабыр.
Dialogue: 0,0:00:59.57,0:01:02.74,Style1,,0,0,0,,Кешіріңіз, мен сізді күттім.
Dialogue: 0,0:00:59.72,0:01:01.40,jp.sub-ja,,0,0,0,,Кешіріңіз, мен күткен болуым керек.
Dialogue: 0,0:01:02.74,0:01:03.91,Style1,,0,0,0,,Мен сіздің хатыңызды оқыдым.
Dialogue: 0,0:01:02.84,0:01:03.75,jp.sub-ja,,0,0,0,,Мен хатты оқыдым.
Dialogue: 0,0:01:03.91,0:01:04.91,Style1,,0,0,0,,Хикару-кун...
Dialogue: 0,0:01:04.21,0:01:04.94,jp.sub-ja,,0,0,0,,Лайт-кун
Dialogue: 0,0:01:04.91,0:01:07.25,Style1,,0,0,0,,Жоқ, кешіріңіз, бірақ мен
Dialogue: 0,0:01:05.13,0:01:08.05,jp.sub-ja,,0,0,0,,Жоқ, кешіріңіз, бірақ мен Каорумын.
Dialogue: 0,0:01:07.25,0:01:08.92,Style1,,0,0,0,,мен Каору.
Dialogue: 0,0:01:08.35,0:01:12.90,jp.sub-ja,,0,0,0,,Сіз хатты қателесіп жарық үстеліне қойған шығарсыз.
Dialogue: 0,0:01:08.92,0:01:11.25,Style1,,0,0,0,,Сіз менің үстелімді Хикарудыкі деп қателескен боларсыз
Dialogue: 0,0:01:11.25,0:01:13.58,Style1,,0,0,0,,әріпті оған салғанда.
Dialogue: 0,0:01:15.59,0:01:18.93,Style1,,0,0,0,,Сонда да мен болсам, қарсы болмас па едің?
Dialogue: 0,0:01:15.80,0:01:17.71,jp.sub-ja,,0,0,0,,Бірақ, мен мұны істей алмаймын деп ойлаймын.
Dialogue: 0,0:01:18.93,0:01:23.60,Style1,,0,0,0,,Шындық, мен сені әрқашан сүйкімді деп ойлайтынмын.
Dialogue: 0,0:01:19.07,0:01:22.89,jp.sub-ja,,0,0,0,,Негізі мен сені сүйкімді деп ойлайтынмын.
Dialogue: 0,0:01:23.60,0:01:27.93,Style1,,0,0,0,,Ал Хикарудың өзіне ұнайтын басқа қызы бар сияқты.
Dialogue: 0,0:01:23.85,0:01:25.91,jp.sub-ja,,0,0,0,,Хикарудың өзіне ұнайтын басқа қызы бар сияқты.
Dialogue: 0,0:01:27.93,0:01:30.60,Style1,,0,0,0,,Ал, қарсы боласың ба?
Dialogue: 0,0:01:30.60,0:01:32.61,Style1,,0,0,0,,Ум, мен...
Dialogue: 0,0:01:30.64,0:01:35.23,jp.sub-ja,,0,0,0,,Мен де, мен де, егер Каору-кун менімен жақсы болса...
Dialogue: 0,0:01:32.61,0:01:37.10,Style1,,0,0,0,,егер мен саған жақсы болсам, Каору-кун...
Dialogue: 0,0:01:39.28,0:01:40.78,Style1,,0,0,0,,Сәлем, Каору!
Dialogue: 0,0:01:39.32,0:01:42.81,jp.sub-ja,,0,0,0,,Эй, Каору, бұл қыз саған да жарасады.
Dialogue: 0,0:01:40.78,0:01:43.72,Style1,,0,0,0,,Ол сенімен жақсы болатынын айтады.
Dialogue: 0,0:01:50.22,0:01:52.23,Style1,,0,0,0,,Сіз шынымен Хикару-кунсыз ба?
Dialogue: 0,0:01:50.34,0:01:51.96,jp.sub-ja,,0,0,0,,Сіз нағыз Хикару-кунсыз ба?
Dialogue: 0,0:01:52.23,0:01:55.56,Style1,,0,0,0,,Бұл қызық емес еді. Мен баяғы ескі үлгіден шаршадым.
Dialogue: 0,0:01:52.42,0:01:55.61,jp.sub-ja,,0,0,0,,Бұл қызықсыз. Мен бұл үлгіден шаршадым.
Dialogue: 0,0:01:55.56,0:01:58.90,Style1,,0,0,0,,Сіз қалайсыз! Сені қалай жамандайсың!
Dialogue: 0,0:01:55.73,0:01:57.43,jp.sub-ja,,0,0,0,,Қорқынышты қорқынышты
Dialogue: 0,0:01:58.90,0:02:02.24,Style1,,0,0,0,,Сіз дөрекі адамсыз, солай емес пе?
Dialogue: 0,0:01:59.10,0:02:00.66,jp.sub-ja,,0,0,0,,Бұл ең сорақысы шығар.
Dialogue: 0,0:02:02.24,0:02:06.91,Style1,,0,0,0,,Екеуімізбен де жақсысың ба? Сіз өзіңізді кім деп ойлайсыз?
Dialogue: 0,0:02:02.40,0:02:03.28,jp.sub-ja,,0,0,0,,Қайсысы маңызды емес.
Dialogue: 0,0:02:03.93,0:02:05.64,jp.sub-ja,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:02:06.91,0:02:10.24,Style1,,0,0,0,,Тағы бір нәрсе, бұл шаш үлгісі сізге ұнамайды.
Dialogue: 0,0:02:07.05,0:02:09.73,jp.sub-ja,,0,0,0,,Ал сен, бұл шаш үлгісі саған жараспайды.
Dialogue: 0,0:02:10.24,0:02:13.51,Style1,,0,0,0,,Егер сізбен бірге қыдырғымыз келсе, сәнге көңіл бөліңіз.
Dialogue: 0,0:02:10.51,0:02:13.15,jp.sub-ja,,0,0,0,,Бізбен танысқыңыз келсе, сезіміңізді жақсартыңыз.
Dialogue: 0,0:02:13.51,0:02:15.98,jp.sub-ja,,0,0,0,,Келесі жолы қызықтырақ мойындауыңызды өтінемін.
Dialogue: 0,0:02:13.51,0:02:16.31,Style1,,0,0,0,,Келесі жолы махаббат туралы мәлімдемеңізді қызықтырақ етіңіз.
Dialogue: 0,0:02:29.86,0:02:32.43,Style1,,0,0,0,,Бұл ақымақтық болды, иә?
Dialogue: 0,0:02:29.97,0:02:30.91,jp.sub-ja,,0,0,0,,Сіз қорқынышты нәрсе жасайсыз.
Dialogue: 0,0:02:32.43,0:02:35.83,Style1,,0,0,0,,Амансың ба, сүйкімді жас ханым?
Dialogue: 0,0:02:32.67,0:02:34.89,jp.sub-ja,,0,0,0,,Жарайды, сүйкімді қыз.
Dialogue: 0,0:02:37.27,0:02:38.94,Style1,,0,0,0,,Ойын ойнағың келе ме?
Dialogue: 0,0:02:37.29,0:02:38.49,jp.sub-ja,,0,0,0,,Каору Сіз ойын ойнайсыз ба?
Dialogue: 0,0:02:38.84,0:02:43.04,Style2,,0,0,0,,«5 кезең, оқу залы»
Dialogue: 0,0:02:38.94,0:02:41.04,Style1,,0,0,0,,Мен қызықты сайт таптым.
Dialogue: 0,0:02:39.22,0:02:40.60,jp.sub-ja,,0,0,0,,Мен қызықты сайт таптым
Dialogue: 0,0:02:41.04,0:02:43.28,Style1,,0,0,0,,Бұрынғы таза ойын туралы не деуге болады?
Dialogue: 0,0:02:41.26,0:02:42.72,jp.sub-ja,,0,0,0,,Осы уақыт ішінде онлайн ойындар туралы не деуге болады?
Dialogue: 0,0:02:43.28,0:02:46.55,Style1,,0,0,0,,Мен одан шаршадым. Олардың бәрі бір топ әлсіздер.
Dialogue: 0,0:02:43.37,0:02:46.16,jp.sub-ja,,0,0,0,,Мен барлық әлсіз жігіттерден шаршадым.
Dialogue: 0,0:02:46.55,0:02:47.71,Style1,,0,0,0,,Бұл қызық емес, солай ма?
Dialogue: 0,0:02:46.61,0:02:47.34,jp.sub-ja,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:02:47.71,0:02:51.22,Style1,,0,0,0,,Иә, дұрыс айтасыз. Қарсы емес.
Dialogue: 0,0:02:47.83,0:02:50.18,jp.sub-ja,,0,0,0,,Дұрыс, жеткілікті.
Dialogue: 0,0:02:51.22,0:02:54.22,Style1,,0,0,0,,Кез келген нәрсе қызық болмаса, біз одан бірден құтылатын едік.
Dialogue: 0,0:02:51.25,0:02:53.72,jp.sub-ja,,0,0,0,,Қызықты нәрселерді тез жою
Dialogue: 0,0:02:54.22,0:02:56.22,Style1,,0,0,0,,Бұл біздің ұранымыз болды.
Dialogue: 0,0:02:54.33,0:02:55.74,jp.sub-ja,,0,0,0,,Бұл біздің ұранымыз
Dialogue: 0,0:02:56.22,0:02:58.96,Style1,,0,0,0,,Хитачиин егіздері қорқынышты ғой, иә?
Dialogue: 0,0:02:56.42,0:02:58.80,jp.sub-ja,,0,0,0,,Хитачиин егіздері қорқынышты, солай емес пе?
Dialogue: 0,0:02:58.96,0:03:01.90,Style1,,0,0,0,,Олар әрқашан бәріне төмен қарайды.
Dialogue: 0,0:02:59.17,0:03:00.87,jp.sub-ja,,0,0,0,,Сіз әрқашан адамдарға төмен қарайсыз.
Dialogue: 0,0:03:01.90,0:03:05.57,Style1,,0,0,0,,Бірақ әкем маған олармен тіл табысуымды айтты.
Dialogue: 0,0:03:01.93,0:03:04.13,jp.sub-ja,,0,0,0,,Бірақ әкем тіл табыса бер деді.
Dialogue: 0,0:03:05.57,0:03:08.23,Style1,,0,0,0,,Иә, менікі де.
Dialogue: 0,0:03:05.83,0:03:06.61,jp.sub-ja,,0,0,0,,Ухимоза
Dialogue: 0,0:03:08.23,0:03:11.07,Style1,,0,0,0,,Менікі де.
Dialogue: 0,0:03:08.56,0:03:08.96,jp.sub-ja,,0,0,0,,Учимо
Dialogue: 0,0:03:11.07,0:03:15.40,Style1,,0,0,0,,Мен олардың өздерінен басқа ешкімді ұнатпағанына сенімдімін.
Dialogue: 0,0:03:11.36,0:03:14.83,jp.sub-ja,,0,0,0,,Менің ойымша, олар өздерінен басқа ешкімді жақсы көрмеген.
Dialogue: 0,0:03:16.58,0:03:21.41,Style1,,0,0,0,,Бұл дұрыс емес еді. Осы уақытқа дейін бір ғана адам болды,
Dialogue: 0,0:03:16.85,0:03:17.66,jp.sub-ja,,0,0,0,,Иә, бұл Каваджири.
Dialogue: 0,0:03:18.51,0:03:21.00,jp.sub-ja,,0,0,0,,Бізде бір ғана адам болған
Dialogue: 0,0:03:21.41,0:03:25.55,Style1,,0,0,0,,біз жақсы көретін қызметші әйел.
Dialogue: 0,0:03:21.47,0:03:24.33,jp.sub-ja,,0,0,0,,Бізді жақсы көретін бір үлкен апа бар еді.
Dialogue: 0,0:03:25.55,0:03:28.02,Style2,,0,0,0,,«10 жыл бұрын»
Dialogue: 0,0:03:25.55,0:03:29.59,Style1,,0,0,0,,Бұл біраз уақыт бұрын болды.
Dialogue: 0,0:03:25.68,0:03:27.84,jp.sub-ja,,0,0,0,,Бұл баяғыда болды
Dialogue: 0,0:03:28.02,0:03:30.39,Style2,,0,0,0,,«Хитачиин сарайы, аула»
Dialogue: 0,0:03:29.59,0:03:33.26,Style1,,0,0,0,,О, менің, сен бүгін қандай сүйкімді көрінесің!
Dialogue: 0,0:03:29.63,0:03:33.02,jp.sub-ja,,0,0,0,,Ал, бүгін сен де сүйкімдісің.
Dialogue: 0,0:03:33.26,0:03:35.76,Style1,,0,0,0,,Кішкентай қуыршақтар сияқты.
Dialogue: 0,0:03:33.27,0:03:34.99,jp.sub-ja,,0,0,0,,Қуыршақ сияқты
Dialogue: 0,0:03:35.76,0:03:40.10,Style1,,0,0,0,,Көк шашты - Хикару-кун, ал қызғылт, Каору-кун, солай ма?
Dialogue: 0,0:03:35.92,0:03:39.76,jp.sub-ja,,0,0,0,,Қызық, көк шашты Хикари-кун, ал қызғылт шаш Каору-кун ба?
Dialogue: 0,0:03:40.10,0:03:43.87,Style1,,0,0,0,,Дұрыс емес, апа. Көк - Каору, ал қызғылт - Хикару.
Dialogue: 0,0:03:40.24,0:03:41.37,jp.sub-ja,,0,0,0,,Жоқ, апай.
Dialogue: 0,0:03:41.83,0:03:43.71,jp.sub-ja,,0,0,0,,Көк – ашық, ал қызғылт – ашық
Dialogue: 0,0:03:43.87,0:03:47.21,Style1,,0,0,0,,Сіз әрқашан қателесесіз. Сіз ақымақ болуыңыз керек.
Dialogue: 0,0:03:43.93,0:03:45.74,jp.sub-ja,,0,0,0,,Мен үнемі қателесіп, ақымақ болып көрінемін.
Dialogue: 0,0:03:47.21,0:03:50.88,Style1,,0,0,0,,Кешіріңіз. Екеуің шынымен де бір-біріне ұқсайсыңдар.
Dialogue: 0,0:03:47.34,0:03:50.69,jp.sub-ja,,0,0,0,,Кешіріңіз, екеуміз де бір-біріне ұқсаймыз.
Dialogue: 0,0:03:50.88,0:03:54.54,Style1,,0,0,0,,Апай, сіз дәл бақаға ұқсайсыз. Көрдіңіз бе?
Dialogue: 0,0:03:50.97,0:03:53.91,jp.sub-ja,,0,0,0,,Кемпір бақаға ұқсайды, көрдің бе?
Dialogue: 0,0:03:57.22,0:03:59.22,Style1,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:03:57.45,0:04:00.28,jp.sub-ja,,0,0,0,,Корааа Обочамаката
Dialogue: 0,0:03:59.22,0:04:00.55,Style1,,0,0,0,,О, балалар!
Dialogue: 0,0:04:00.55,0:04:02.38,Style1,,0,0,0,,Ханым, кешіріңіз.
Dialogue: 0,0:04:00.78,0:04:01.95,jp.sub-ja,,0,0,0,,Кешіріңіз, ханым.
Dialogue: 0,0:04:06.06,0:04:09.23,Style1,,0,0,0,,Бізге сол қызметші ұнады.
Dialogue: 0,0:04:06.16,0:04:07.73,jp.sub-ja,,0,0,0,,Маған қамқоршы ұнады.
Dialogue: 0,0:04:09.23,0:04:11.23,Style1,,0,0,0,,Ол сикофанттардан сәл өзгеше болды,
Dialogue: 0,0:04:09.42,0:04:13.77,jp.sub-ja,,0,0,0,,Өйткені олар бұрынғы тәкаппар, сүйкімді күлкілерден сәл ерекшеленетін.
Dialogue: 0,0:04:11.23,0:04:15.06,Style1,,0,0,0,,және осы уақытқа дейін бізде болған қызықты түрлер.
Dialogue: 0,0:04:17.90,0:04:19.41,Style1,,0,0,0,,Сіз не істеп жатырсыз!?
Dialogue: 0,0:04:18.10,0:04:18.82,jp.sub-ja,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:19.41,0:04:21.24,Style1,,0,0,0,,Түнгі барлау.
Dialogue: 0,0:04:19.60,0:04:20.64,jp.sub-ja,,0,0,0,,Түнгі барлау
Dialogue: 0,0:04:21.24,0:04:23.41,Style1,,0,0,0,,Сіз мені тапқандықтан, менде басқа амал жоқ.
Dialogue: 0,0:04:21.56,0:04:22.53,jp.sub-ja,,0,0,0,,Табылған жағдайда көмектесу мүмкін емес
Dialogue: 0,0:04:23.41,0:04:26.91,Style1,,0,0,0,,Екеуің үндемей тұрасыңдар.
Dialogue: 0,0:04:23.63,0:04:26.20,jp.sub-ja,,0,0,0,,Екеуіңе үндемеулеріңді сұраймын.
Dialogue: 0,0:04:26.91,0:04:28.58,Style1,,0,0,0,,Егер біз осы түймені бассақ,
Dialogue: 0,0:04:26.99,0:04:30.57,jp.sub-ja,,0,0,0,,Осы қосқышты бассаңыз, күзетші асығыс кіріп келеді.
Dialogue: 0,0:04:28.58,0:04:31.92,Style1,,0,0,0,,күзетшілер жүгіріп келеді. Көріп көрейік.
Dialogue: 0,0:04:31.07,0:04:31.87,jp.sub-ja,,0,0,0,,Оны басайық
Dialogue: 0,0:04:31.92,0:04:33.59,Style1,,0,0,0,,3... 2...
Dialogue: 0,0:04:32.18,0:04:33.36,jp.sub-ja,,0,0,0,,3 2…
Dialogue: 0,0:04:33.53,0:04:34.77,jp.sub-ja,,0,0,0,,Ей, тоқтат.
Dialogue: 0,0:04:33.59,0:04:35.08,Style1,,0,0,0,,Ой, тоқта!
Dialogue: 0,0:04:36.92,0:04:38.93,Style1,,0,0,0,,Бұл сейфтің комбинациясы.
Dialogue: 0,0:04:37.07,0:04:38.77,jp.sub-ja,,0,0,0,,Бұл сейфтің нөмірі.
Dialogue: 0,0:04:38.93,0:04:40.93,Style1,,0,0,0,,Егер сіз бізбен ойнайтын болсаңыз...
Dialogue: 0,0:04:39.21,0:04:40.60,jp.sub-ja,,0,0,0,,Егер сіз бізбен ойнасаңыз
Dialogue: 0,0:04:40.93,0:04:43.52,Style1,,0,0,0,,...біз сізге бұл қағазды беруге дайынбыз.
Dialogue: 0,0:04:41.02,0:04:42.66,jp.sub-ja,,0,0,0,,Мен сізге бұл қағазды бере аламын.
Dialogue: 0,0:04:45.53,0:04:48.20,Style1,,0,0,0,,W-не ойнағың келеді?
Dialogue: 0,0:04:45.58,0:04:47.94,jp.sub-ja,,0,0,0,,Сіз не ойнайсыз?
Dialogue: 0,0:04:48.20,0:04:51.03,Style1,,0,0,0,,«Қайсысы Хикару-кун ойыны»!
Dialogue: 0,0:04:48.39,0:04:50.75,jp.sub-ja,,0,0,0,,Хикари-кун қайсысы? Ойын
Dialogue: 0,0:04:54.04,0:04:57.21,Style1,,0,0,0,,Хикару, сізде комбинациясы бар қағаз бар екеніне сенімдісіз бе?
Dialogue: 0,0:04:54.25,0:04:56.70,jp.sub-ja,,0,0,0,,Хикари: Сізде сандар жазылған қағаз бар ма?
Dialogue: 0,0:04:57.21,0:04:58.71,Style1,,0,0,0,,Жарайды.
Dialogue: 0,0:04:57.30,0:05:00.58,jp.sub-ja,,0,0,0,,Уайымдамаңыз, ол шошқада жасырылған.
Dialogue: 0,0:04:58.71,0:05:03.88,Style1,,0,0,0,,Мен оны тиын банкасына тығып қойдым. Ол оны бұзбай шығара алмайды.
Dialogue: 0,0:05:01.09,0:05:02.37,jp.sub-ja,,0,0,0,,Бұзбай алып тастау мүмкін емес
Dialogue: 0,0:05:03.88,0:05:09.22,Style1,,0,0,0,,Мен ол ханымның бізді ажырата алатынын қалағанымызға сенімдімін.
Dialogue: 0,0:05:03.93,0:05:08.18,jp.sub-ja,,0,0,0,,Менің ойымша, біз үлкен апаның бізді танығанын қалаған шығармыз.
Dialogue: 0,0:05:09.22,0:05:12.06,Style1,,0,0,0,,Ол ханым бізге ұнады.
Dialogue: 0,0:05:09.32,0:05:11.57,jp.sub-ja,,0,0,0,,Себебі сенің апаң маған ұнады
Dialogue: 0,0:05:32.58,0:05:34.91,Style1,,0,0,0,,Сіз уәдеңізді бұздыңыз.
Dialogue: 0,0:05:32.83,0:05:34.21,jp.sub-ja,,0,0,0,,Сіз уәдеңізді бұздыңыз.
Dialogue: 0,0:05:37.25,0:05:43.36,Style1,,0,0,0,,Менің таңдауым болмады, солай ма? Екеуіңді ажырата алмаймын.
Dialogue: 0,0:05:37.50,0:05:38.68,jp.sub-ja,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:05:39.32,0:05:41.72,jp.sub-ja,,0,0,0,,Мен сізді ажырата алмаймын
Dialogue: 0,0:05:43.36,0:05:47.19,Style1,,0,0,0,,Сіздің өміріңізде ешкім ешқашан келмеуі мүмкін
Dialogue: 0,0:05:43.62,0:05:44.39,jp.sub-ja,,0,0,0,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:05:44.87,0:05:48.68,jp.sub-ja,,0,0,0,,Сізді шынымен ажырата алатын адам ешқашан болмауы мүмкін.
Dialogue: 0,0:05:47.19,0:05:50.03,Style1,,0,0,0,,бұл екеуіңді бір-бірінен ажырата алады.
Dialogue: 0,0:05:50.03,0:05:53.37,Style1,,0,0,0,,Қызметші ханым, бізге ұнайтын жалғыз және жалғыз,
Dialogue: 0,0:05:50.20,0:05:53.17,jp.sub-ja,,0,0,0,,Бізге ұнайтын жалғыз қамқоршы апа болды
Dialogue: 0,0:05:53.35,0:05:56.61,jp.sub-ja,,0,0,0,,Осыны айтып, түн қараңғысына сіңіп кетті.
Dialogue: 0,0:05:53.37,0:05:57.70,Style1,,0,0,0,,бізге соны айтты да, түннің қараңғылығына сіңіп кетті.
Dialogue: 0,0:05:57.70,0:06:01.20,Style1,,0,0,0,,Біз өскен сайын бірте-бірте бұрмаланатын болдық.
Dialogue: 0,0:05:57.83,0:06:00.40,jp.sub-ja,,0,0,0,,Біз тұрақты түрде бұралып, өстік.
Dialogue: 0,0:06:07.05,0:06:09.88,Style1,,0,0,0,,Осылайша, біз достық тосқауыл қоюды жалғастырдық,
Dialogue: 0,0:06:07.21,0:06:11.34,jp.sub-ja,,0,0,0,,Ал мен адамдарды өзімнен алыстату үшін тосқауыл қоюды жалғастырдым.
Dialogue: 0,0:06:09.88,0:06:13.39,Style1,,0,0,0,,басқалардың тым жақындауын болдырмау. Бірақ сонда да,
Dialogue: 0,0:06:12.16,0:06:15.94,jp.sub-ja,,0,0,0,,Десе де тосқауылды байқамайтын өңсіз адамдар бар.
Dialogue: 0,0:06:13.39,0:06:16.22,Style1,,0,0,0,,бөгетті байқамайтын адам тым тығыз
Dialogue: 0,0:06:16.22,0:06:19.06,Style1,,0,0,0,,анда-санда келіп тұратын.
Dialogue: 0,0:06:16.49,0:06:18.32,jp.sub-ja,,0,0,0,,Полюске жұп жақындау
Dialogue: 0,0:06:19.06,0:06:21.23,Style1,,0,0,0,,Екеуің көп жұмыс істемейтін сияқтысыңдар.
Dialogue: 0,0:06:19.15,0:06:20.42,jp.sub-ja,,0,0,0,,Балалар, сендер зеріккен сияқтысыңдар.
Dialogue: 0,0:06:21.23,0:06:24.90,Style1,,0,0,0,,Уақытыңыз болса, не айтасыз? Бірге клуб құрайық!
Dialogue: 0,0:06:21.49,0:06:24.71,jp.sub-ja,,0,0,0,,Бос уақытыңыз болса, менімен неге үйірме ашпасқа?
Dialogue: 0,0:06:24.90,0:06:26.23,Style1,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:06:25.05,0:06:25.95,jp.sub-ja,,0,0,0,,Бұл кім?
Dialogue: 0,0:06:26.23,0:06:30.90,Style1,,0,0,0,,А, мен білемін. Сыныптағы қыздардың бәрі ол туралы шулап жатыр.
Dialogue: 0,0:06:27.30,0:06:30.38,jp.sub-ja,,0,0,0,,Білемін, менің сыныбымдағы бір қыз шу шығарып жатқан шығар.
Dialogue: 0,0:06:30.90,0:06:34.57,Style1,,0,0,0,,Білесіз бе, былтыр көктемде қабылданған Суу жігіті.
Dialogue: 0,0:06:31.23,0:06:33.97,jp.sub-ja,,0,0,0,,Қарашы, Суо, өткен көктемде ауысқан...
Dialogue: 0,0:06:34.57,0:06:37.08,Style1,,0,0,0,,А, бұл жігіт, иә?
Dialogue: 0,0:06:35.60,0:06:36.71,jp.sub-ja,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:06:37.03,0:06:40.93,jp.sub-ja,,0,0,0,,Көрдім, түсіндім, мен шынымен де соншалықты атақтымын ба?
Dialogue: 0,0:06:37.08,0:06:41.08,Style1,,0,0,0,,Шынымен бе? Шынымен бе? Мен сондай атақтымын ба?
Dialogue: 0,0:06:41.08,0:06:43.85,Style1,,0,0,0,,Мен өзімді сондай... кінәлі сезінемін.
Dialogue: 0,0:06:41.14,0:06:43.78,jp.sub-ja,,0,0,0,,Мен қандай күнәкармын
Dialogue: 0,0:06:43.85,0:06:46.19,Style1,,0,0,0,,Менің жарқырауым, ішінде де, сыртында да,
Dialogue: 0,0:06:44.03,0:06:46.83,jp.sub-ja,,0,0,0,,Сыртынан да, ішінен де ұшатын нұр
Dialogue: 0,0:06:46.19,0:06:50.19,Style1,,0,0,0,,барлығының көзіне түсті, солай ма?
Dialogue: 0,0:06:47.28,0:06:49.12,jp.sub-ja,,0,0,0,,Оны біреу байқайды ма?
Dialogue: 0,0:06:49.12,0:06:50.92,Style2,,0,0,0,,"Тамаки Суоу (орта мектеп 3-курс)"
Dialogue: 0,0:06:51.19,0:06:56.53,Style1,,0,0,0,,А, мен-адамның бақыты деген осы ма,
Dialogue: 0,0:06:51.30,0:06:53.93,jp.sub-ja,,0,0,0,,A~ko бұл
Dialogue: 0,0:06:54.12,0:06:57.88,jp.sub-ja,,0,0,0,,Бұл Құдайдың арбауына түскен адамның тағдыры дейсіз бе?
Dialogue: 0,0:06:56.53,0:06:58.53,Style1,,0,0,0,,Құдайдың иелігінде ме?
Dialogue: 0,0:06:58.53,0:07:01.06,Style2,,0,0,0,,«Тамаки Суоу, орта мектеп 3-курс (қиялдың ортасы)»
Dialogue: 0,0:07:01.87,0:07:03.80,Style1,,0,0,0,,Мұны ешкім ешқашан айтқан емес.
Dialogue: 0,0:07:01.94,0:07:03.51,jp.sub-ja,,0,0,0,,Мен олай айтқан жоқпын.
Dialogue: 0,0:07:03.80,0:07:07.87,Style1,,0,0,0,,Ах, бірақ бәрібір, алаңдаудың қажеті жоқ. Менікіндей керемет болмаса да,
Dialogue: 0,0:07:04.05,0:07:05.67,jp.sub-ja,,0,0,0,,Жоқ, бірақ уайымдамаңыз.
Dialogue: 0,0:07:06.22,0:07:07.72,jp.sub-ja,,0,0,0,,Бұл мен сияқты жақсы болмауы мүмкін.
Dialogue: 0,0:07:07.87,0:07:10.38,Style1,,0,0,0,,екеуің біраз уәде бересіңдер.
Dialogue: 0,0:07:08.05,0:07:10.04,jp.sub-ja,,0,0,0,,Балалар, сендердің де көретіндерің көп.
Dialogue: 0,0:07:10.38,0:07:12.21,Style1,,0,0,0,,Қараңдаршы, сен не айтып тұрсың?
Dialogue: 0,0:07:10.51,0:07:11.95,jp.sub-ja,,0,0,0,,Мм, сен не айтып тұрсың?
Dialogue: 0,0:07:12.21,0:07:15.98,Style1,,0,0,0,,Мен екі айдан кейін сәуір айында жаңа клуб ашамын.
Dialogue: 0,0:07:12.31,0:07:14.68,jp.sub-ja,,0,0,0,,Кафедра екі айдан кейін сәуір айында басталады.
Dialogue: 0,0:07:15.98,0:07:20.22,Style1,,0,0,0,,Мен ойланып отырмын, жоғары сыныпқа ауысқан бойда.
Dialogue: 0,0:07:16.08,0:07:19.39,jp.sub-ja,,0,0,0,,Мен орта мектепті бітірген бойда мұны істеуді ойлап жүрмін.
Dialogue: 0,0:07:20.22,0:07:24.39,Style1,,0,0,0,,Біз сізді орта мектептен бір жыл бойы аяқтауыңыз керек еді,
Dialogue: 0,0:07:20.42,0:07:24.07,jp.sub-ja,,0,0,0,,Сіз орта мектепте бір жыл оқисыз.
Dialogue: 0,0:07:24.39,0:07:27.56,Style1,,0,0,0,,бірақ мен сізге бұл туралы қамқорлық жасау үшін сөз беремін.
Dialogue: 0,0:07:24.58,0:07:26.94,jp.sub-ja,,0,0,0,,Мен сол бөлім туралы айтайын.
Dialogue: 0,0:07:27.56,0:07:33.23,Style1,,0,0,0,,Бұл өте қызықты болады! Менің сыныбымнан Отори Кёя да бар.
Dialogue: 0,0:07:27.74,0:07:28.73,jp.sub-ja,,0,0,0,,Бұл қызық
Dialogue: 0,0:07:29.18,0:07:31.97,jp.sub-ja,,0,0,0,,Екіншісі менің сыныбымнан Кёя Отори болар еді.
Dialogue: 0,0:07:29.66,0:07:31.13,Style2,,0,0,0,,«Дазай Осамудың «Бататын күн»
Dialogue: 0,0:07:33.23,0:07:36.90,Style1,,0,0,0,,қосымша, орта мектеп 1-курс Ханинозука-сенпай
Dialogue: 0,0:07:33.33,0:07:38.81,jp.sub-ja,,0,0,0,,Сонымен қатар, біз орта мектептің бірінші курс студенттері Ханинозука-сенпай мен Харунозука-сенпайды жұмысқа аламыз.
Dialogue: 0,0:07:36.90,0:07:39.57,Style1,,0,0,0,,және Моринозука-сенпай шақырылды.
Dialogue: 0,0:07:39.57,0:07:40.91,Style1,,0,0,0,,Міне, екеуің-
Dialogue: 0,0:07:39.73,0:07:41.03,jp.sub-ja,,0,0,0,,Міне, сіз...
Dialogue: 0,0:07:40.91,0:07:44.18,Style1,,0,0,0,,Сіз бізді алаңдатып отырсыз. Кетіңіз.
Dialogue: 0,0:07:41.03,0:07:43.03,jp.sub-ja,,0,0,0,,Шулы екен, кет.
Dialogue: 0,0:07:44.18,0:07:46.35,Style1,,0,0,0,,Біз ешкіммен араласпаймыз.
Dialogue: 0,0:07:44.24,0:07:45.89,jp.sub-ja,,0,0,0,,Біз ешкіммен араласпаймыз.
Dialogue: 0,0:07:46.35,0:07:49.18,Style1,,0,0,0,,Бізге сізді қызықтырмайды.
Dialogue: 0,0:07:46.50,0:07:47.96,jp.sub-ja,,0,0,0,,Мен саған қызық емеспін.
Dialogue: 0,0:07:49.18,0:07:52.19,Style1,,0,0,0,,Егер бізге жақындау керек болса...
Dialogue: 0,0:07:49.21,0:07:51.88,jp.sub-ja,,0,0,0,,Егер сіз шынымен бізге жақындағыңыз келсе
Dialogue: 0,0:07:52.19,0:07:53.52,Style1,,0,0,0,,...ойнайсың ба?
Dialogue: 0,0:07:52.26,0:07:53.24,jp.sub-ja,,0,0,0,,Сынақ
Dialogue: 0,0:07:53.52,0:07:56.51,Style1,,0,0,0,,«Қайсысы Хикару-кун ойыны»!
Dialogue: 0,0:07:53.72,0:07:55.95,jp.sub-ja,,0,0,0,,Хикари-кун қайсысы? Ойын
Dialogue: 0,0:07:58.19,0:08:00.19,Style1,,0,0,0,,Ойынның мағынасын түсіндің, солай ма?
Dialogue: 0,0:07:58.29,0:07:59.70,jp.sub-ja,,0,0,0,,Ойынның мағынасын түсіндің, солай ма?
Dialogue: 0,0:08:00.19,0:08:03.53,Style1,,0,0,0,,Сізге тек біздің қайсысымыз Хикару екенін таңдау керек.
Dialogue: 0,0:08:00.27,0:08:02.69,jp.sub-ja,,0,0,0,,Қайсымыз жарық екенін тап
Dialogue: 0,0:08:03.31,0:08:04.76,jp.sub-ja,,0,0,0,,Мерзімі бір ай.
Dialogue: 0,0:08:03.53,0:08:05.53,Style1,,0,0,0,,Сізде бір айлық уақыт шектеуі бар.
Dialogue: 0,0:08:05.53,0:08:07.87,Style1,,0,0,0,,Осы уақыт ішінде сіз қалағаныңызша көп рет көре аласыз,
Dialogue: 0,0:08:05.69,0:08:07.77,jp.sub-ja,,0,0,0,,Осы уақыт ішінде қанша рет қаласаңыз, сонша рет көріңіз.
Dialogue: 0,0:08:07.87,0:08:10.20,Style1,,0,0,0,,бірақ біз сізден дәлелдеріңізді сұраймыз.
Dialogue: 0,0:08:08.02,0:08:09.57,jp.sub-ja,,0,0,0,,Мен сенен себебін сұраймын.
Dialogue: 0,0:08:10.20,0:08:11.87,Style1,,0,0,0,,Кездейсоқ болжау жоқ.
Dialogue: 0,0:08:10.25,0:08:11.53,jp.sub-ja,,0,0,0,,Болжауға болмайды
Dialogue: 0,0:08:11.87,0:08:13.21,Style1,,0,0,0,,Біз сізге ескертуіміз керек,
Dialogue: 0,0:08:12.01,0:08:15.81,jp.sub-ja,,0,0,0,,Мен сізге айтамын, бұл ойында ешкім дұрыс жауап алған жоқ.
Dialogue: 0,0:08:13.21,0:08:16.21,Style1,,0,0,0,,Бұл ойында бұрын ешкім дұрыс жауап бермеген.
Dialogue: 0,0:08:16.18,0:08:18.69,jp.sub-ja,,0,0,0,,Егер бұл жақсы болса, бар күшіңізді салыңыз.
Dialogue: 0,0:08:16.21,0:08:19.20,Style1,,0,0,0,,Егер сізде бәрі жақсы болса, бар күшіңізді салып көріңіз.
Dialogue: 0,0:08:22.22,0:08:24.22,Style1,,0,0,0,,Ол еріксіз, дірілдеп жатыр.
Dialogue: 0,0:08:22.39,0:08:23.88,jp.sub-ja,,0,0,0,,Мен қорқамын мен қорқамын
Dialogue: 0,0:08:24.22,0:08:26.89,Style1,,0,0,0,,Оған қарсы болмаңыз, оның құрамын естідіңіз бе?
Dialogue: 0,0:08:24.38,0:08:26.73,jp.sub-ja,,0,0,0,,Сіз бұл туралы бұрын естідіңіз бе?
Dialogue: 0,0:08:26.89,0:08:30.22,Style1,,0,0,0,,Мен оның Хитачи атын неге қосқысы келетінін түсінемін.
Dialogue: 0,0:08:27.07,0:08:29.41,jp.sub-ja,,0,0,0,,Неліктен Хитачииннің атын сонда қосқыңыз келеді?
Dialogue: 0,0:08:30.22,0:08:32.89,Style1,,0,0,0,,Ол тек жоғарыдан шыққан фракция құруға тырысып жатыр ма?
Dialogue: 0,0:08:30.33,0:08:32.68,jp.sub-ja,,0,0,0,,Отбасы жағдайына ерекше мән беретін фракция құрайық.
Dialogue: 0,0:08:32.89,0:08:34.38,Style1,,0,0,0,,Бір ай, солай емес пе!?
Dialogue: 0,0:08:33.04,0:08:33.92,jp.sub-ja,,0,0,0,,Бір ай.
Dialogue: 0,0:08:36.23,0:08:41.07,Style1,,0,0,0,,Өте жақсы. Керісінше, мен жеңсем, сен менің клубыма қосылуың керек.
Dialogue: 0,0:08:36.32,0:08:38.10,jp.sub-ja,,0,0,0,,Жарайды, орнына.
Dialogue: 0,0:08:38.46,0:08:40.35,jp.sub-ja,,0,0,0,,Мен жеңсем, сен менің клубыма қосыла аласың.
Dialogue: 0,0:08:41.07,0:08:43.50,Style1,,0,0,0,,Бірақ мен болжам жасап жатырмын.
Dialogue: 0,0:08:41.15,0:08:42.34,jp.sub-ja,,0,0,0,,Бірақ мен пайғамбарлық етемін
Dialogue: 0,0:08:43.22,0:08:49.33,jp.sub-ja,,0,0,0,,Киінетін бөлменің есігі ашылатынына сенімдімін.
Dialogue: 0,0:08:43.50,0:08:45.24,Style1,,0,0,0,,Сәуір келіңіз,
Dialogue: 0,0:08:45.24,0:08:48.31,Style1,,0,0,0,,Екеуің есікті ашатыныңа сенімдімін
Dialogue: 0,0:08:48.31,0:08:51.24,Style1,,0,0,0,,№3 орта мектептің музыкалық кабинетіне.
Dialogue: 0,0:08:51.24,0:08:55.92,Style1,,0,0,0,,Сонымен, біздің уақытты шектеу ойынымыз басталды.
Dialogue: 0,0:08:51.33,0:08:54.10,jp.sub-ja,,0,0,0,,Осылайша, біздің уақыт шектеулі ойынымыз
Dialogue: 0,0:08:53.98,0:08:56.35,Style2,,0,0,0,,«Ойынның басталуы»
Dialogue: 0,0:08:54.13,0:08:55.20,jp.sub-ja,,0,0,0,,Басталды
Dialogue: 0,0:08:56.85,0:08:59.59,Style1,,0,0,0,,Ум, Хикару-кун, Каору-кун,
Dialogue: 0,0:08:56.92,0:08:59.32,jp.sub-ja,,0,0,0,,Ум, Хикару-кун, Каору-кун
Dialogue: 0,0:08:59.59,0:09:03.92,Style1,,0,0,0,,біз жабылу салтанатынан кейін сыныптық іс-шара өткізуді жоспарлап отырмыз.
Dialogue: 0,0:08:59.75,0:09:03.35,jp.sub-ja,,0,0,0,,Біз жабылу салтанатынан кейін сыныптық іс-шараны жоспарлап отырмыз.
Dialogue: 0,0:09:03.92,0:09:05.59,Style1,,0,0,0,,Иә, біз өтеміз.
Dialogue: 0,0:09:04.01,0:09:05.49,jp.sub-ja,,0,0,0,,А, біз өтеміз
Dialogue: 0,0:09:05.59,0:09:09.33,Style1,,0,0,0,,Бірақ бұл екінші жылдағы соңғы оқиға болғалы тұр.
Dialogue: 0,0:09:05.72,0:09:08.78,jp.sub-ja,,0,0,0,,Бірақ бұл екінші курс студенттері үшін соңғы оқиға.
Dialogue: 0,0:09:09.33,0:09:10.93,Style1,,0,0,0,,Біз бұл туралы соншалықты ойланбаймыз.
Dialogue: 0,0:09:09.39,0:09:10.76,jp.sub-ja,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:09:10.93,0:09:13.93,Style1,,0,0,0,,Кітапты дәл қазір оқып жатқан адам - ​​Хикару!
Dialogue: 0,0:09:10.95,0:09:12.55,jp.sub-ja,,0,0,0,,Кітапты қазір оқып жатқан жарық
Dialogue: 0,0:09:13.93,0:09:16.60,Style1,,0,0,0,,Бұл не, біздің сыныпқа осылай кіріп жатыр ма?
Dialogue: 0,0:09:14.17,0:09:16.69,jp.sub-ja,,0,0,0,,Не, біреудің сабағына келдің бе?
Dialogue: 0,0:09:16.60,0:09:18.60,Style1,,0,0,0,,Мен дұрыс айтамын ба? Мен оны дұрыс түсіндім бе?
Dialogue: 0,0:09:16.69,0:09:18.50,jp.sub-ja,,0,0,0,,Бұл хит болды ма? Бұл хит болды ма?
Dialogue: 0,0:09:18.60,0:09:20.94,Style1,,0,0,0,,Жоқ, болмады.
Dialogue: 0,0:09:18.85,0:09:19.84,jp.sub-ja,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:09:20.82,0:09:22.03,jp.sub-ja,,0,0,0,,Мен оны таптым.
Dialogue: 0,0:09:20.94,0:09:23.61,Style1,,0,0,0,,Мен бір нәрсе таптым! Хикару, сен оң қолсың!
Dialogue: 0,0:09:22.34,0:09:23.68,jp.sub-ja,,0,0,0,,Жарық оң жақ
Dialogue: 0,0:09:23.61,0:09:25.28,Style1,,0,0,0,,Иә, бірақ екеуміз де оң қолымыз.
Dialogue: 0,0:09:23.77,0:09:25.40,jp.sub-ja,,0,0,0,,Жоқ, екеуі де оң қолды.
Dialogue: 0,0:09:25.28,0:09:27.95,Style1,,0,0,0,,Сондай-ақ, Каору, шашыңды оң жақтан таратасың.
Dialogue: 0,0:09:25.46,0:09:27.93,jp.sub-ja,,0,0,0,,Сондай-ақ, Каору оң жағында шаштары бар.
Dialogue: 0,0:09:27.95,0:09:29.95,Style1,,0,0,0,,Біз әрқашан шаш үлгісін ауыстырамыз.
Dialogue: 0,0:09:28.20,0:09:29.68,jp.sub-ja,,0,0,0,,Мен шаш үлгісін үнемі өзгертемін.
Dialogue: 0,0:09:29.93,0:09:32.71,jp.sub-ja,,0,0,0,,Бөлімге жауапты адам
Dialogue: 0,0:09:29.95,0:09:32.62,Style1,,0,0,0,,Гармония жасағанда, төменгі тонды қабылдайтын адам-
Dialogue: 0,0:09:32.62,0:09:34.29,Style1,,0,0,0,,Біз неміз, хормыз!?
Dialogue: 0,0:09:32.71,0:09:33.57,jp.sub-ja,,0,0,0,,Хор?
Dialogue: 0,0:09:34.29,0:09:37.46,Style1,,0,0,0,,Мм... Сіз Суоусенпайсыз, солай ма?
Dialogue: 0,0:09:34.48,0:09:37.23,jp.sub-ja,,0,0,0,,Ум, Суоу-сенпай, солай ма?
Dialogue: 0,0:09:37.46,0:09:40.46,Style1,,0,0,0,,Иә, кешіріңіз. Сізге бұл екеуімен бірдеңе керек болды ма?
Dialogue: 0,0:09:37.59,0:09:40.31,jp.sub-ja,,0,0,0,,Ой, кешіріңіз, екеуіңізге бірдеңе бар еді.
Dialogue: 0,0:09:40.46,0:09:46.90,Style1,,0,0,0,,Иә, мен оларды сыныптық іс-шараға қатысуға шақырдым.
Dialogue: 0,0:09:40.55,0:09:45.20,jp.sub-ja,,0,0,0,,Е, мен сыныптағы іс-шараға қатысуды сұрадым.
Dialogue: 0,0:09:46.90,0:09:49.90,Style1,,0,0,0,,Хмм, кинофестиваль? Бұл жақсы болады.
Dialogue: 0,0:09:47.62,0:09:49.74,jp.sub-ja,,0,0,0,,Кино түні? Жақсы.
Dialogue: 0,0:09:49.90,0:09:52.91,Style1,,0,0,0,,Мен жай ғана Хикару мен Каоруды қатысып жатырмын.
Dialogue: 0,0:09:50.17,0:09:52.68,jp.sub-ja,,0,0,0,,Хикари мен Каору да Марутоға қатысты
Dialogue: 0,0:09:52.91,0:09:53.97,jp.sub-ja,,0,0,0,,Өз еркімен шешім қабылдамаңыз
Dialogue: 0,0:09:52.91,0:09:54.91,Style1,,0,0,0,,Сіз біз үшін шешім қабылдамаңыз!
Dialogue: 0,0:09:54.91,0:09:56.58,Style1,,0,0,0,,Эй, барасың ба!?
Dialogue: 0,0:09:54.96,0:09:56.35,jp.sub-ja,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:09:56.52,0:09:58.18,jp.sub-ja,,0,0,0,,Үйіңе бар, сен қатты шулап тұрсың.
Dialogue: 0,0:09:56.58,0:09:58.58,Style1,,0,0,0,,Біз кетеміз. Сіз ренжітетінсіз.
Dialogue: 0,0:09:58.58,0:10:00.75,Style1,,0,0,0,,Біздің ойын ше!?
Dialogue: 0,0:09:58.71,0:10:00.07,jp.sub-ja,,0,0,0,,Ойын туралы не деуге болады?
Dialogue: 0,0:10:00.75,0:10:02.58,Style1,,0,0,0,,Мен сізге айттық деп ойладым.
Dialogue: 0,0:10:00.86,0:10:02.38,jp.sub-ja,,0,0,0,,Сондықтан айтып отырмын.
Dialogue: 0,0:10:02.58,0:10:04.42,Style1,,0,0,0,,Бар күшіңізді салып көріңіз.
Dialogue: 0,0:10:02.82,0:10:04.10,jp.sub-ja,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:10:04.42,0:10:05.85,Style2,,0,0,0,,««Енді адам емес» авторы Дазай Осаму»
Dialogue: 0,0:10:16.26,0:10:18.60,Style1,,0,0,0,,Мен сені егіздерді көруге барды деп ойладым.
Dialogue: 0,0:10:16.56,0:10:18.14,jp.sub-ja,,0,0,0,,Егіздерді көруге бармадың ба?
Dialogue: 0,0:10:18.60,0:10:21.27,Style1,,0,0,0,,Жоқ, олар маған қашып кетті.
Dialogue: 0,0:10:18.76,0:10:19.91,jp.sub-ja,,0,0,0,,Жоқ, ол қашып кетті.
Dialogue: 0,0:10:21.27,0:10:24.54,Style1,,0,0,0,,Маған көмектесіңізші. Бұл клуб үшін, солай ма?
Dialogue: 0,0:10:21.39,0:10:24.05,jp.sub-ja,,0,0,0,,Сіз де ынтымақтасуыңыз керек. Бұл клубтың мүддесі үшін.
Dialogue: 0,0:10:24.54,0:10:28.44,Style1,,0,0,0,,Еш маңызды емес. Біз оларсыз клубты құра аламыз, солай ма?
Dialogue: 0,0:10:24.61,0:10:28.13,jp.sub-ja,,0,0,0,,Бұл екі адам болмаса да, клубты ашуға болады.
Dialogue: 0,0:10:28.44,0:10:31.93,Style1,,0,0,0,,Жоқ, мен бұл екеуіне қызығамын.
Dialogue: 0,0:10:28.86,0:10:31.54,jp.sub-ja,,0,0,0,,Жоқ, мен бұл екеуіне қызығамын.
Dialogue: 0,0:10:34.45,0:10:40.78,Style1,,0,0,0,,Олар сіз айтып отырған тағы бірнеше «біздің достарымыз» ма?
Dialogue: 0,0:10:34.57,0:10:39.81,jp.sub-ja,,0,0,0,,Олар да сіз айтқандай «біздің достарымыз» ма?
Dialogue: 0,0:10:42.29,0:10:45.73,Style1,,0,0,0,,О... мм-мм.
Dialogue: 0,0:10:45.73,0:10:50.23,Style1,,0,0,0,,Сонда олар не ойлап отыр? Егер олар бөлек айтқысы келсе,
Dialogue: 0,0:10:45.83,0:10:48.12,jp.sub-ja,,0,0,0,,Бірақ олар не ойлады?
Dialogue: 0,0:10:49.17,0:10:50.17,jp.sub-ja,,0,0,0,,Егер сіз ажыратқыңыз келсе
Dialogue: 0,0:10:50.23,0:10:53.23,Style1,,0,0,0,,олар жай ғана шаш үлгісін немесе бір нәрсені өзгерте алады.
Dialogue: 0,0:10:50.48,0:10:52.26,jp.sub-ja,,0,0,0,,Мен шаш үлгісін өзгерткенімді қалаймын.
Dialogue: 0,0:10:53.23,0:10:55.57,Style1,,0,0,0,,Сосын оларды ажыратқысы келмейді.
Dialogue: 0,0:10:53.40,0:10:54.77,jp.sub-ja,,0,0,0,,Сізді ажыратқанымды қаламайсыз.
Dialogue: 0,0:10:55.57,0:10:58.40,Style1,,0,0,0,,Бірақ ойын оларды ажырату болып табылады.
Dialogue: 0,0:10:55.76,0:10:57.94,jp.sub-ja,,0,0,0,,Бірақ бұл көре білу ойыны.
Dialogue: 0,0:10:58.40,0:11:01.07,Style1,,0,0,0,,Сосын оларды бір-бірінен ажыратқысы келеді.
Dialogue: 0,0:10:58.59,0:11:00.03,jp.sub-ja,,0,0,0,,Ендеше, сіздерді ажыратуымды қалайсыз деп ойлаймын.
Dialogue: 0,0:11:01.07,0:11:03.29,jp.sub-ja,,0,0,0,,Сіз мұқият сөйлеп, тыңдайсыз.
Dialogue: 0,0:11:01.07,0:11:03.91,Style1,,0,0,0,,Менің айтқанымды тыңдап тұрсың ба?
Dialogue: 0,0:11:03.91,0:11:05.90,Style1,,0,0,0,,Оның жартысына жуығы.
Dialogue: 0,0:11:04.13,0:11:05.13,jp.sub-ja,,0,0,0,,Жартысына жуық
Dialogue: 0,0:11:10.62,0:11:14.02,Style2,,0,0,0,,«Келесі күні таңертең Хитачиин маноры, алдыңғы есік»
Dialogue: 0,0:11:12.32,0:11:14.25,Style1,,0,0,0,,Бүгін таңертең оң жақта бөлінген Каору,
Dialogue: 0,0:11:12.51,0:11:15.45,jp.sub-ja,,0,0,0,,Бүгін таңертең оң жағы жарық, сол жағы жарық.
Dialogue: 0,0:11:14.25,0:11:15.91,Style1,,0,0,0,,және сол жақта бөлінген - Хикару!
Dialogue: 0,0:11:16.92,0:11:19.26,Style1,,0,0,0,,Сәлем, қайырлы таң!
Dialogue: 0,0:11:17.06,0:11:18.26,jp.sub-ja,,0,0,0,,Сәлем, қайырлы таң
Dialogue: 0,0:11:19.26,0:11:21.93,Style1,,0,0,0,,Мынау не, біздің үйге осылай келе жатыр?
Dialogue: 0,0:11:19.42,0:11:21.91,jp.sub-ja,,0,0,0,,Не, біреудің үйіне келдің бе?
Dialogue: 0,0:11:21.93,0:11:23.93,Style1,,0,0,0,,Мен дұрыс айтамын ба? Мен оны дұрыс түсіндім бе?
Dialogue: 0,0:11:22.03,0:11:23.56,jp.sub-ja,,0,0,0,,Бұл хит болды ма? Бұл хит болды ма?
Dialogue: 0,0:11:23.93,0:11:26.43,Style1,,0,0,0,,Жоқ, болмадыңыз.
Dialogue: 0,0:11:24.01,0:11:25.29,jp.sub-ja,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:11:26.43,0:11:28.10,Style1,,0,0,0,,Мен бірдеңе таптым!
Dialogue: 0,0:11:26.64,0:11:30.02,jp.sub-ja,,0,0,0,,Мен Каорудың ұялшақ екенін білдім.
Dialogue: 0,0:11:28.10,0:11:30.60,Style1,,0,0,0,,Каору, сен сәл көгершін сияқтысың, солай емес пе?
Dialogue: 0,0:11:30.60,0:11:31.60,Style1,,0,0,0,,Мұны түзетуіңіз керек.
Dialogue: 0,0:11:30.77,0:11:31.66,jp.sub-ja,,0,0,0,,Оны жөндеген дұрыс
Dialogue: 0,0:11:31.60,0:11:33.60,Style1,,0,0,0,,Қандай дөрекі! Бұл дұрыс емес!
Dialogue: 0,0:11:31.66,0:11:33.21,jp.sub-ja,,0,0,0,,Дөрекі, жоқ.
Dialogue: 0,0:11:34.61,0:11:36.61,Style1,,0,0,0,,Мен кеше түнде бір нәрсе ойладым.
Dialogue: 0,0:11:34.88,0:11:36.31,jp.sub-ja,,0,0,0,,Мен жай ғана ойладым.
Dialogue: 0,0:11:36.61,0:11:39.61,Style1,,0,0,0,,Сенің бауырластық сүйіспеншілігіңе жол берсек ше?
Dialogue: 0,0:11:36.70,0:11:39.22,jp.sub-ja,,0,0,0,,Ағайындық сүйіспеншілікті сатсаңыз ше?
Dialogue: 0,0:11:39.61,0:11:40.95,Style1,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:11:40.95,0:11:44.12,Style1,,0,0,0,,Біршама тәуекелді, симметриялы, бауырластық махаббат.
Dialogue: 0,0:11:40.99,0:11:43.30,jp.sub-ja,,0,0,0,,Аздап қауіпті симметриялы бауырластық махаббат
Dialogue: 0,0:11:44.12,0:11:46.89,Style1,,0,0,0,,Ағайынды Хитачииндер!
Dialogue: 0,0:11:44.20,0:11:46.18,jp.sub-ja,,0,0,0,,Ағайынды Хитачиин
Dialogue: 0,0:11:46.82,0:11:48.05,jp.sub-ja,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:11:46.89,0:11:48.22,Style1,,0,0,0,,Ал ше!?
Dialogue: 0,0:11:48.22,0:11:50.56,Style1,,0,0,0,,Нені меңзеп тұрғаныңызды білмейміз.
Dialogue: 0,0:11:48.32,0:11:49.42,jp.sub-ja,,0,0,0,,Мен оны түсінбеймін
Dialogue: 0,0:11:50.56,0:11:54.05,Style1,,0,0,0,,Сәлем! Қашпа! Ұстаңыз!
Dialogue: 0,0:11:50.64,0:11:53.86,jp.sub-ja,,0,0,0,,Ей, қашпа. Күте тұрыңыз.
Dialogue: 0,0:11:55.23,0:11:56.61,jp.sub-ja,,0,0,0,,Бұл кім?
Dialogue: 0,0:11:55.23,0:11:56.90,Style1,,0,0,0,,Ол жігітте не бар?
Dialogue: 0,0:11:56.90,0:11:58.90,Style1,,0,0,0,,Таңертең біріншіден...
Dialogue: 0,0:11:57.02,0:11:58.59,jp.sub-ja,,0,0,0,,Таңертең ерте
Dialogue: 0,0:11:58.90,0:12:00.90,Style1,,0,0,0,,Білесіз бе, ол бұл үнді қабылдайды ...
Dialogue: 0,0:11:59.09,0:12:00.45,jp.sub-ja,,0,0,0,,Дәлірек айтқанда, бұл тон.
Dialogue: 0,0:12:00.90,0:12:03.40,Style1,,0,0,0,,Иә, иә, мен де солай ойладым.
Dialogue: 0,0:12:00.99,0:12:02.89,jp.sub-ja,,0,0,0,,Дұрыс, мен де солай ойладым.
Dialogue: 0,0:12:03.29,0:12:04.93,jp.sub-ja,,0,0,0,,Мырза сөйлеп тұр, солай ма?
Dialogue: 0,0:12:03.40,0:12:05.56,Style1,,0,0,0,,Ол қандай да бір феодал сияқты сөйлейді, иә?
Dialogue: 0,0:12:07.57,0:12:10.91,Style1,,0,0,0,,Неліктен оның мұндай князьдік жүзі болса, ол тонды қабылдайды!?
Dialogue: 0,0:12:07.64,0:12:09.41,jp.sub-ja,,0,0,0,,Неліктен ол ханзадаға ұқсайды?
Dialogue: 0,0:12:09.41,0:12:10.75,jp.sub-ja,,0,0,0,,Сол үн.
Dialogue: 0,0:12:10.91,0:12:13.25,Style1,,0,0,0,,«Ұстаңыз!» деді ол! «Ұстаңыз!»
Dialogue: 0,0:12:11.05,0:12:13.06,jp.sub-ja,,0,0,0,,Күте тұр деді. Күте тұр деді.
Dialogue: 0,0:12:13.25,0:12:16.58,Style1,,0,0,0,,гозару: біршама архаикалық жапондық копула етістігі Ол көп ұзамай «гозару» сөзін қолдана бастайтын сияқты, солай емес пе?
Dialogue: 0,0:12:13.39,0:12:16.22,jp.sub-ja,,0,0,0,,Жақында "гозару" деп бастайсыз деп ойлаймын.
Dialogue: 0,0:12:16.58,0:12:18.91,Style1,,0,0,0,,Ол ақымақ. Ақымақ мырза.
Dialogue: 0,0:12:16.65,0:12:18.47,jp.sub-ja,,0,0,0,,Сен ақымақсың. Сен ақымақсың.
Dialogue: 0,0:12:26.93,0:12:28.59,Style1,,0,0,0,,Содан кейін тағы да...
Dialogue: 0,0:12:27.12,0:12:27.84,jp.sub-ja,,0,0,0,,Бірақ келіңіз.
Dialogue: 0,0:12:28.59,0:12:31.22,Style1,,0,0,0,,...біз одан шаршай бастадық, иә?
Dialogue: 0,0:12:28.65,0:12:31.24,jp.sub-ja,,0,0,0,,Сен енді шаршадың, солай емес пе?
Dialogue: 0,0:12:37.44,0:12:38.44,Style1,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:12:38.44,0:12:40.27,Style1,,0,0,0,,Біз айтқандай, біз аяқтадық.
Dialogue: 0,0:12:38.61,0:12:40.07,jp.sub-ja,,0,0,0,,Сондықтан да бітті
Dialogue: 0,0:12:40.27,0:12:41.61,Style1,,0,0,0,,Ойын аяқталды.
Dialogue: 0,0:12:40.47,0:12:41.36,jp.sub-ja,,0,0,0,,Ойын аяқталды
Dialogue: 0,0:12:41.61,0:12:43.88,Style1,,0,0,0,,Сіз не туралы айтып отырсыз? Қандай өз-өзіне қызмет ету!
Dialogue: 0,0:12:41.74,0:12:43.83,jp.sub-ja,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл өзімшілдік...
Dialogue: 0,0:12:43.83,0:12:45.72,jp.sub-ja,,0,0,0,,Дұрыс, өзімізге байланысты.
Dialogue: 0,0:12:43.88,0:12:46.55,Style1,,0,0,0,,Дұрыс. Біз өзімізге қызмет етеміз.
Dialogue: 0,0:12:46.55,0:12:48.38,Style1,,0,0,0,,Немесе айтамыз ба...
Dialogue: 0,0:12:46.75,0:12:47.53,jp.sub-ja,,0,0,0,,Менің айтайын дегенім, келіңіз.
Dialogue: 0,0:12:48.38,0:12:52.89,Style1,,0,0,0,,Біз сізді басшының заңсыз ұлы деп естідік, иә?
Dialogue: 0,0:12:48.54,0:12:51.86,jp.sub-ja,,0,0,0,,Сіз төрағаның заңды әйелінің баласы емессіз.
Dialogue: 0,0:12:52.89,0:12:55.65,Style1,,0,0,0,,Бізді кешіріңіз, бірақ біз сізге аздап қарадық.
Dialogue: 0,0:12:52.96,0:12:55.30,jp.sub-ja,,0,0,0,,Кешіріңіз, мен жай ғана зерттеу жүргіздім.
Dialogue: 0,0:12:55.65,0:12:58.89,Style1,,0,0,0,,Менің, сенде өте қайғылы өмір оқиғасы бар, солай емес пе?
Dialogue: 0,0:12:55.85,0:12:58.63,jp.sub-ja,,0,0,0,,Жоқ, бұл өте аянышты тәрбие.
Dialogue: 0,0:12:58.89,0:13:02.56,Style1,,0,0,0,,Сіз мұны мектеп бойынша таратқанымызды қаламайсыз, солай ма?
Dialogue: 0,0:12:58.97,0:13:02.12,jp.sub-ja,,0,0,0,,Мен мектептегі адамдардың бұл туралы айтқанын қаламаймын.
Dialogue: 0,0:13:02.56,0:13:07.57,Style1,,0,0,0,,Оның үстіне анаң әлі жоқ, тіпті қазір де.
Dialogue: 0,0:13:02.73,0:13:05.83,jp.sub-ja,,0,0,0,,Оның үстіне оның биологиялық анасы әлі із-түзсіз жоғалған.
Dialogue: 0,0:13:07.57,0:13:10.90,Style1,,0,0,0,,Сайып келгенде, сен жалғызсың, солай емес пе?
Dialogue: 0,0:13:07.66,0:13:10.81,jp.sub-ja,,0,0,0,,Менің ойымша, сіз жалғыз және жалғызсыз.
Dialogue: 0,0:13:10.90,0:13:15.41,Style1,,0,0,0,,Олай болса, сен бізді өз еркіңмен дос қылуға тырыспадың ба?
Dialogue: 0,0:13:11.15,0:13:14.24,jp.sub-ja,,0,0,0,,Сондықтан біздің сізге қосылғанымызды қаламайсыз.
Dialogue: 0,0:13:15.41,0:13:21.91,Style1,,0,0,0,,Екеуміздің жағдайымыз бәрібір сендерден жақсырақ.
Dialogue: 0,0:13:15.44,0:13:19.70,jp.sub-ja,,0,0,0,,Екеуміз жалғыз сенен үлкенбіз.
Dialogue: 0,0:13:21.91,0:13:23.58,Style1,,0,0,0,,Кеттік, Хикару.
Dialogue: 0,0:13:22.12,0:13:23.23,jp.sub-ja,,0,0,0,,Кеттік, жарық
Dialogue: 0,0:13:23.58,0:13:25.57,Style1,,0,0,0,,Жарайды.
Dialogue: 0,0:13:35.59,0:13:39.00,Style1,,0,0,0,,Ол енді біздің ісімізге мұрнын тықпайды.
Dialogue: 0,0:13:35.70,0:13:37.88,jp.sub-ja,,0,0,0,,Енді олар енді шықпайды.
Dialogue: 0,0:13:39.00,0:13:41.37,Style1,,0,0,0,,Дегенмен, бұл ұят.
Dialogue: 0,0:13:39.22,0:13:41.05,jp.sub-ja,,0,0,0,,Бірақ бұл біраз ұят болды деп ойлаймын.
Dialogue: 0,0:13:41.37,0:13:44.87,Style1,,0,0,0,,Мүмкін біз онымен ұзағырақ ойнаған болар едік. Сосын тағы да,
Dialogue: 0,0:13:41.55,0:13:43.05,jp.sub-ja,,0,0,0,,Мен біраз ойнасам болар еді
Dialogue: 0,0:13:43.95,0:13:47.93,jp.sub-ja,,0,0,0,,Бірақ мен енді сіздің көңіліңізді қалдырғым келмейді.
Dialogue: 0,0:13:44.87,0:13:48.87,Style1,,0,0,0,,Мен қайтадан көңілім қалдырмаймын.
Dialogue: 0,0:13:48.87,0:13:51.27,Style1,,0,0,0,,Біз әрқашан сәйкес келмейтін болдық.
Dialogue: 0,0:13:49.05,0:13:50.82,jp.sub-ja,,0,0,0,,Біз әрқашан бір-бірімізге қайшы келеміз
Dialogue: 0,0:13:53.65,0:13:57.38,Style1,,0,0,0,,Бізді ажыратқысы келді. Бізді бөлек айтқымыз келмеді.
Dialogue: 0,0:13:53.85,0:13:56.75,jp.sub-ja,,0,0,0,,Мен сенің бізді ажыратуыңды қалаймын, мен сенің мені ажыратуыңды қаламаймын
Dialogue: 0,0:13:57.38,0:14:01.72,Style1,,0,0,0,,Біз адамдардың бізді білгенін қаладық. Біз танылғымыз келмеді.
Dialogue: 0,0:13:57.41,0:14:00.37,jp.sub-ja,,0,0,0,,Мен сенің біз туралы білгеніңді қалаймын, біз туралы білгеніңді қаламаймын
Dialogue: 0,0:14:03.96,0:14:09.22,Style1,,0,0,0,,Біз әрқашан бізді қабылдайтын адамды іздейтінбіз...
Dialogue: 0,0:14:04.12,0:14:07.64,jp.sub-ja,,0,0,0,,Біз әрқашан бізді қабылдайтын біреуді іздейміз
Dialogue: 0,0:14:10.56,0:14:15.23,Style1,,0,0,0,,Бірақ ешкім ешкімді ешқашан қабылдай алмайды
Dialogue: 0,0:14:10.69,0:14:14.54,jp.sub-ja,,0,0,0,,Бірақ біз соншалықты бұрмаланған болсақ та, бізді қабылдайтын ешкім жоқ.
Dialogue: 0,0:14:15.23,0:14:17.23,Style1,,0,0,0,,біз сияқты ашулы.
Dialogue: 0,0:14:15.42,0:14:16.35,jp.sub-ja,,0,0,0,,Ешқандай болуы мүмкін емес.
Dialogue: 0,0:14:20.07,0:14:25.24,Style1,,0,0,0,,Біз ешкімнің болмайтынына көз жеткізу үшін өте, өте қауіпсіз құлыпты ұстадық
Dialogue: 0,0:14:20.19,0:14:22.12,jp.sub-ja,,0,0,0,,Біз әрқашан жалғыз болатын әлемде
Dialogue: 0,0:14:22.59,0:14:24.02,jp.sub-ja,,0,0,0,,Сізге зиян тигізбеу үшін
Dialogue: 0,0:14:25.24,0:14:28.91,Style1,,0,0,0,,екі адамдық әлемде бізге зиян тигізуі мүмкін.
Dialogue: 0,0:14:25.38,0:14:27.69,jp.sub-ja,,0,0,0,,Өте күшті құлыпы бар
Dialogue: 0,0:14:30.25,0:14:32.25,Style1,,0,0,0,,Каору...
Dialogue: 0,0:14:30.40,0:14:30.90,jp.sub-ja,,0,0,0,,Каору
Dialogue: 0,0:14:32.25,0:14:34.59,Style1,,0,0,0,,Ол осында.
Dialogue: 0,0:14:32.50,0:14:32.93,jp.sub-ja,,0,0,0,,Мен осындамын
Dialogue: 0,0:14:34.57,0:14:35.95,jp.sub-ja,,0,0,0,,Иә, иә. Не болды? Сабыр, сабыр.
Dialogue: 0,0:14:34.59,0:14:37.25,Style1,,0,0,0,,Иә, дұрыс айтасыз.
Dialogue: 0,0:14:38.71,0:14:40.80,jp.sub-ja,,0,0,0,,Эй, эй, жарық
Dialogue: 0,0:14:39.93,0:14:41.49,Style1,,0,0,0,,Сәлем, Хикару!
Dialogue: 0,0:14:41.49,0:14:43.70,Style1,,0,0,0,,Ол сенімен жақсы болатынын айтады.
Dialogue: 0,0:14:41.61,0:14:43.23,jp.sub-ja,,0,0,0,,Мына бала саған да жарасады.
Dialogue: 0,0:14:43.70,0:14:44.86,Style1,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:14:50.54,0:14:53.21,Style1,,0,0,0,,Әй, қайта емес.
Dialogue: 0,0:14:50.62,0:14:52.19,jp.sub-ja,,0,0,0,,Тағы да?
Dialogue: 0,0:14:53.21,0:14:55.21,Style1,,0,0,0,,Жүзің қандай тәтті болса,
Dialogue: 0,0:14:53.37,0:14:56.88,jp.sub-ja,,0,0,0,,Сіз байсалды және тамаша мінездісіз.
Dialogue: 0,0:14:55.21,0:14:57.88,Style1,,0,0,0,,сізде қорқынышты мінез бар, иә?
Dialogue: 0,0:14:57.88,0:15:00.21,Style1,,0,0,0,,Біреуіміз жақсы болар едік...
Dialogue: 0,0:14:58.12,0:14:59.79,jp.sub-ja,,0,0,0,,Қайсысы маңызды емес.
Dialogue: 0,0:15:00.21,0:15:02.55,Style1,,0,0,0,,...шынымен екеумізді де қаламайсыз дегенді білдіреді, солай емес пе?
Dialogue: 0,0:15:00.30,0:15:02.50,jp.sub-ja,,0,0,0,,Шындық мынада, сізге де керек емес.
Dialogue: 0,0:15:02.55,0:15:05.71,Style1,,0,0,0,,Сіз қалайсыз! Сені қалай жамандайсың!
Dialogue: 0,0:15:02.85,0:15:05.06,jp.sub-ja,,0,0,0,,Қорқынышты қорқынышты
Dialogue: 0,0:15:10.06,0:15:12.56,Style1,,0,0,0,,Қайсысымыз шынымен жаманбыз?
Dialogue: 0,0:15:10.13,0:15:12.24,jp.sub-ja,,0,0,0,,Қайсысы шынымен нашар?
Dialogue: 0,0:15:12.56,0:15:15.22,Style1,,0,0,0,,Хатты жұлып алмақшы - Хикару!
Dialogue: 0,0:15:12.64,0:15:14.77,jp.sub-ja,,0,0,0,,Қазір хатты жыртып алмақ болған – жарық.
Dialogue: 0,0:15:21.57,0:15:23.24,Style1,,0,0,0,,Н-қалай болдыңыз...
Dialogue: 0,0:15:21.70,0:15:22.86,jp.sub-ja,,0,0,0,,Неліктен?
Dialogue: 0,0:15:23.24,0:15:25.74,Style1,,0,0,0,,Мен дұрыс айтамын ба? Мен оны дұрыс түсіндім бе?
Dialogue: 0,0:15:23.32,0:15:25.16,jp.sub-ja,,0,0,0,,Бұл хит болды ма? Бұл хит болды ма?
Dialogue: 0,0:15:25.74,0:15:26.67,Style1,,0,0,0,,Сіздің ойыңыз қандай?
Dialogue: 0,0:15:25.87,0:15:26.61,jp.sub-ja,,0,0,0,,Себебі
Dialogue: 0,0:15:26.67,0:15:28.00,Style1,,0,0,0,,Интуиция!
Dialogue: 0,0:15:26.84,0:15:27.33,jp.sub-ja,,0,0,0,,Бұл болжам.
Dialogue: 0,0:15:30.51,0:15:33.25,Style1,,0,0,0,,Білесіз бе... Мен сізге басында айттық деп ойладым
Dialogue: 0,0:15:30.66,0:15:34.73,jp.sub-ja,,0,0,0,,Мен басында айттым деп ойладым, болжау жақсы емес.
Dialogue: 0,0:15:33.25,0:15:35.91,Style1,,0,0,0,,, сіз жай ғана кездейсоқ болжауға болмайды.
Dialogue: 0,0:15:36.92,0:15:40.92,Style1,,0,0,0,,Иә, кешіріңіз. Әзірге айта алмаймын.
Dialogue: 0,0:15:37.10,0:15:38.15,jp.sub-ja,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:15:38.71,0:15:40.28,jp.sub-ja,,0,0,0,,Бұл мен үшін қазір мүмкін емес.
Dialogue: 0,0:15:40.92,0:15:43.06,jp.sub-ja,,0,0,0,,Өйткені сендер тым ұқсассыңдар.
Dialogue: 0,0:15:40.92,0:15:43.52,Style1,,0,0,0,,Менің айтайын дегенім, сіз тым ұқсассыз.
Dialogue: 0,0:15:43.51,0:15:45.34,jp.sub-ja,,0,0,0,,Бірақ, мен бұл туралы ойланатын шығармын.
Dialogue: 0,0:15:43.52,0:15:45.92,Style1,,0,0,0,,Бірақ сонда бәрі сіздің қалай қарағаныңызға байланысты.
Dialogue: 0,0:15:45.92,0:15:50.03,Style1,,0,0,0,,Екеуің қандай болсаңдар, талантың бар сияқты.
Dialogue: 0,0:15:46.12,0:15:48.69,jp.sub-ja,,0,0,0,,Ұқсас болу – талант.
Dialogue: 0,0:15:50.03,0:15:55.37,Style1,,0,0,0,,Ендеше, бұдан былай екі бірде-бір Хитачиин ағайындыларын жетілдіруге тырысыңыз.
Dialogue: 0,0:15:50.16,0:15:51.08,jp.sub-ja,,0,0,0,,Бұдан былай
Dialogue: 0,0:15:51.85,0:15:54.30,jp.sub-ja,,0,0,0,,Бірге Хитачиин бауырларын меңгерейік.
Dialogue: 0,0:15:57.20,0:16:03.21,Style1,,0,0,0,,Бірақ, әрине, сіз де тәуелсіз жандар екеніңізді ұмытпауыңыз керек.
Dialogue: 0,0:15:57.40,0:16:02.10,jp.sub-ja,,0,0,0,,Бірақ, әрине, сіз жеке тұлғалар екеніңізді ұмыта алмайсыз.
Dialogue: 0,0:16:03.21,0:16:07.21,Style1,,0,0,0,,Сондықтан мен екеуіңді ажырата білу үшін жұмыс істеймін.
Dialogue: 0,0:16:03.44,0:16:06.94,jp.sub-ja,,0,0,0,,Сондықтан мен екеуін ажырата білу үшін бар күшімді саламын.
Dialogue: 0,0:16:07.21,0:16:08.55,Style1,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:16:07.29,0:16:08.43,jp.sub-ja,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:16:08.55,0:16:10.38,Style1,,0,0,0,,Ол сәйкес емес.
Dialogue: 0,0:16:08.63,0:16:09.70,jp.sub-ja,,0,0,0,,Бұл қарама-қайшы.
Dialogue: 0,0:16:10.38,0:16:12.38,Style1,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:16:10.55,0:16:11.54,jp.sub-ja,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:12.38,0:16:16.22,Style1,,0,0,0,,Бұл сәйкес келмеуі мүмкін, бірақ бұл сіздің кім екеніңіз.
Dialogue: 0,0:16:12.57,0:16:15.46,jp.sub-ja,,0,0,0,,Қарама-қайшылық болса да, сендерсіңдер.
Dialogue: 0,0:16:16.22,0:16:18.88,Style1,,0,0,0,,Мұны біз даралық деп атаймыз.
Dialogue: 0,0:16:16.42,0:16:18.05,jp.sub-ja,,0,0,0,,Оны даралық деп атайды.
Dialogue: 0,0:16:20.56,0:16:22.23,Style1,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:16:20.87,0:16:21.76,jp.sub-ja,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:22.23,0:16:26.23,Style1,,0,0,0,,Егер біз сіз айтқандай «Hitachiin Brothers» стилімен жүре бастасақ,
Dialogue: 0,0:16:22.39,0:16:25.86,jp.sub-ja,,0,0,0,,Айтқаныңызды жасай бастасаңыз, Хитачиин ағайынды стилі.
Dialogue: 0,0:16:26.23,0:16:28.97,Style1,,0,0,0,,сонда біз мәңгілік жинақ боламыз!
Dialogue: 0,0:16:26.25,0:16:28.73,jp.sub-ja,,0,0,0,,Сондықтан біз әрқашан жиынтықтарды сататын боламыз.
Dialogue: 0,0:16:28.97,0:16:33.74,Style1,,0,0,0,,Сіз қанша тырыссаңыз да, бізді ешқашан ажырата алмайсыз!
Dialogue: 0,0:16:29.14,0:16:30.57,jp.sub-ja,,0,0,0,,Қанша тырыссаң да
Dialogue: 0,0:16:30.98,0:16:33.45,jp.sub-ja,,0,0,0,,Сіз бізді ешқашан ажырата алмайсыз
Dialogue: 0,0:16:33.74,0:16:37.58,Style1,,0,0,0,,Біз өзімізді бір-бірінен ажырата алатын жалғыз адамдармыз.
Dialogue: 0,0:16:33.94,0:16:35.50,jp.sub-ja,,0,0,0,,Бізді кім ажырата алады?
Dialogue: 0,0:16:35.86,0:16:36.69,jp.sub-ja,,0,0,0,,Біз жалғызбыз
Dialogue: 0,0:16:37.58,0:16:41.58,Style1,,0,0,0,,«Қайсысы Хикару-кун ойынында» жеңетін ешкім жоқ.
Dialogue: 0,0:16:37.67,0:16:40.23,jp.sub-ja,,0,0,0,,Хикару-кун деген кім? Ойынды кім болжай алады?
Dialogue: 0,0:16:40.27,0:16:41.04,jp.sub-ja,,0,0,0,,Мен сені емдемеймін
Dialogue: 0,0:16:41.58,0:16:44.17,Style1,,0,0,0,,Біз мұны басынан бері білеміз!
Dialogue: 0,0:16:41.86,0:16:43.70,jp.sub-ja,,0,0,0,,Мен мұны әу бастан білдім.
Dialogue: 0,0:16:47.69,0:16:49.52,Style1,,0,0,0,,Сонда кез келген адам қате болжаса,
Dialogue: 0,0:16:47.80,0:16:49.06,jp.sub-ja,,0,0,0,,Олай болса, жойылған кезде
Dialogue: 0,0:16:49.52,0:16:52.79,Style1,,0,0,0,,неге үнемі мұңды көрінесің?
Dialogue: 0,0:16:49.73,0:16:52.21,jp.sub-ja,,0,0,0,,Неліктен сен үнемі жалғыз болып көрінесің?
Dialogue: 0,0:16:54.53,0:16:58.02,Style1,,0,0,0,,Дұрыс. есімде.
Dialogue: 0,0:16:54.63,0:16:56.77,jp.sub-ja,,0,0,0,,Ішек-қарынды жұлып алып, оның өшін алғым келеді.
Dialogue: 0,0:16:59.70,0:17:02.69,Style1,,0,0,0,,Сіз Хикару-кунсыз.
Dialogue: 0,0:16:59.76,0:17:01.98,jp.sub-ja,,0,0,0,,Бұл Хикару-кун
Dialogue: 0,0:17:07.21,0:17:08.54,Style1,,0,0,0,,Сіз қате ойладыңыз.
Dialogue: 0,0:17:07.29,0:17:08.16,jp.sub-ja,,0,0,0,,Өшірілген.
Dialogue: 0,0:17:08.54,0:17:12.20,Style1,,0,0,0,,Осыдан кейін қыз...
Dialogue: 0,0:17:08.64,0:17:11.29,jp.sub-ja,,0,0,0,,Сонда әлгі қыз айтты
Dialogue: 0,0:17:13.28,0:17:14.88,Style1,,0,0,0,,Мұнда.
Dialogue: 0,0:17:13.49,0:17:16.22,jp.sub-ja,,0,0,0,,Кешіріңіз, жыламаңыз.
Dialogue: 0,0:17:14.88,0:17:17.22,Style1,,0,0,0,,Жылама, жарай ма?
Dialogue: 0,0:17:17.22,0:17:21.55,Style1,,0,0,0,,Бұл сөздерді естігенде таң қалғаным есімде.
Dialogue: 0,0:17:17.45,0:17:18.69,jp.sub-ja,,0,0,0,,Сөздерді тыңда
Dialogue: 0,0:17:19.27,0:17:20.83,jp.sub-ja,,0,0,0,,Мен таң қалғаным есімде.
Dialogue: 0,0:17:21.55,0:17:27.22,Style1,,0,0,0,,Біз сол кезде жылайтын сияқтымыз.
Dialogue: 0,0:17:21.78,0:17:23.89,jp.sub-ja,,0,0,0,,Мүмкін біз сол кезде болған шығармыз
Dialogue: 0,0:17:24.50,0:17:26.52,jp.sub-ja,,0,0,0,,Ол жылайтындай көрінсе керек.
Dialogue: 0,0:17:30.30,0:17:33.63,Style1,,0,0,0,,Қолымнан келмесе де, бір күні, бір жерде,
Dialogue: 0,0:17:30.46,0:17:32.21,jp.sub-ja,,0,0,0,,Менің қолымнан келмесе де
Dialogue: 0,0:17:32.68,0:17:33.50,jp.sub-ja,,0,0,0,,Бір күні, бір жерде
Dialogue: 0,0:17:33.63,0:17:37.50,Style1,,0,0,0,,Сізді ажырата алатын біреу көрінуі мүмкін.
Dialogue: 0,0:17:33.90,0:17:36.76,jp.sub-ja,,0,0,0,,Сізді танитын біреу пайда болуы мүмкін.
Dialogue: 0,0:17:38.57,0:17:40.91,Style1,,0,0,0,,Дегенмен, бұл көп нәрсе анық.
Dialogue: 0,0:17:38.86,0:17:40.12,jp.sub-ja,,0,0,0,,Бірақ бұл анық
Dialogue: 0,0:17:40.91,0:17:44.68,Style1,,0,0,0,,Егер сіз бұдан былай өз кішкентай әлеміңізде қала берсеңіз,
Dialogue: 0,0:17:40.96,0:17:43.54,jp.sub-ja,,0,0,0,,Бұдан былай әлемде екеуміз ғана болатын болсақ
Dialogue: 0,0:17:44.68,0:17:49.17,Style1,,0,0,0,,Сізді ажырата алатын адамдарды ешқашан кездестірмейсіз.
Dialogue: 0,0:17:44.87,0:17:48.42,jp.sub-ja,,0,0,0,,Сізді ажырата алатын адамдарды ешқашан кездестірмейсіз
Dialogue: 0,0:17:52.02,0:17:56.35,Style1,,0,0,0,,Олай болса, неге біз Хост клубының есігін бірге ашпасқа?
Dialogue: 0,0:17:52.11,0:17:53.04,jp.sub-ja,,0,0,0,,содан кейін бірге
Dialogue: 0,0:17:53.82,0:17:55.62,jp.sub-ja,,0,0,0,,Қабылдаушы бөлімінің есігін ашайық.
Dialogue: 0,0:18:01.69,0:18:05.63,Style1,,0,0,0,,Сіздің әлеміңізді бірге кеңейтуге тырысайық.
Dialogue: 0,0:18:01.82,0:18:03.85,jp.sub-ja,,0,0,0,,Дүниені бірге кеңейтейік
Dialogue: 0,0:18:05.63,0:18:09.20,Style1,,0,0,0,,Бірінші кездесуіміз ашылу салтанатынан кейін, сабақтан кейін болады.
Dialogue: 0,0:18:05.85,0:18:08.68,jp.sub-ja,,0,0,0,,Бірінші кездесу мектептен кейін ашылу салтанатында өтеді.
Dialogue: 0,0:18:09.20,0:18:12.87,Style1,,0,0,0,,Біз оны №3 орта мектептің музыкалық кабинетінде өткіземіз.
Dialogue: 0,0:18:09.34,0:18:11.63,jp.sub-ja,,0,0,0,,Біз оны киім ауыстыратын бөлмеде жасаймыз.
Dialogue: 0,0:18:12.87,0:18:17.21,Style1,,0,0,0,,Сол күні жоғары мәртебелі мырза өте дұрыс жауап бергеннен кейін,
Dialogue: 0,0:18:12.99,0:18:16.68,jp.sub-ja,,0,0,0,,Сол күні дұрыс жауап берген мырзаға.
Dialogue: 0,0:18:17.21,0:18:20.21,Style1,,0,0,0,,бейсаналық, біз сәл болды
Dialogue: 0,0:18:17.36,0:18:19.12,jp.sub-ja,,0,0,0,,Ес-түссіз аз ғана болдық
Dialogue: 0,0:18:20.20,0:18:21.38,jp.sub-ja,,0,0,0,,Кішкене ғана
Dialogue: 0,0:18:20.21,0:18:22.38,Style1,,0,0,0,,- сәл ғана -
Dialogue: 0,0:18:22.38,0:18:25.04,Style1,,0,0,0,,оған әсер қалдырды.
Dialogue: 0,0:18:22.51,0:18:24.09,jp.sub-ja,,0,0,0,,Мен қозғалдым.
Dialogue: 0,0:18:28.03,0:18:31.12,jp.sub-ja,,0,0,0,,Уау, қандай тамаша мектеп
Dialogue: 0,0:18:28.22,0:18:31.55,Style1,,0,0,0,,Уау, бұл мектеп керемет.
Dialogue: 0,0:18:32.99,0:18:35.12,Style2,,0,0,0,,«Қабылдау жөніндегі нұсқаулық»
Dialogue: 0,0:18:33.23,0:18:35.56,Style1,,0,0,0,,Мен мұнда кірсем де,
Dialogue: 0,0:18:33.40,0:18:37.75,jp.sub-ja,,0,0,0,,Мен осылай қабылдансам да жақсы жұмыс істей аламын ба деп ойлаймын?
Dialogue: 0,0:18:35.56,0:18:38.22,Style1,,0,0,0,,Мен шынымен өте аламын ба?
Dialogue: 0,0:18:46.24,0:18:50.24,Style1,,0,0,0,,Бұл дұрыс па? Такаши, сені де Сукун шақырды ма?
Dialogue: 0,0:18:46.52,0:18:50.00,jp.sub-ja,,0,0,0,,Түсіндім, Такашины да Суокун шақырған.
Dialogue: 0,0:18:50.24,0:18:51.58,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:18:51.58,0:18:56.08,Style1,,0,0,0,,Сіз не білесіз? Ол маған сүйкімді нәрселерді ұнатқаным дұрыс екенін айтты.
Dialogue: 0,0:18:51.80,0:18:55.84,jp.sub-ja,,0,0,0,,Білесің бе, мен үшін сүйкімді нәрселерді ұнатқан дұрыс.
Dialogue: 0,0:18:56.08,0:18:58.65,Style1,,0,0,0,,Ол маған тортты ұнатқаным дұрыс деді.
Dialogue: 0,0:18:56.19,0:18:58.00,jp.sub-ja,,0,0,0,,Тортты ұнатқан дұрыс
Dialogue: 0,0:18:58.65,0:19:01.25,Style1,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:18:58.88,0:19:00.63,jp.sub-ja,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:19:01.25,0:19:04.25,Style1,,0,0,0,,Мицукуни, сен қалағаныңды істей аласың.
Dialogue: 0,0:19:01.43,0:19:03.97,jp.sub-ja,,0,0,0,,Мицукуни қалағандай жасаңыз.
Dialogue: 0,0:19:05.26,0:19:07.25,Style1,,0,0,0,,Мм-мм, дұрыс айтасыз.
Dialogue: 0,0:19:05.42,0:19:06.91,jp.sub-ja,,0,0,0,,Yes, that's right.
Dialogue: 0,0:19:28.01,0:19:31.12,Style1,,0,0,0,,Бірдеңе болады деп ойлаймын.
Dialogue: 0,0:19:28.10,0:19:30.43,jp.sub-ja,,0,0,0,,Жақсы, менің ойымша, бұл қалай болады.
Dialogue: 0,0:19:31.12,0:19:34.11,Style1,,0,0,0,,Енді келесі жылы қабылдау емтихандарын тапсыру үшін жұмыс істеу.
Dialogue: 0,0:19:31.34,0:19:33.26,jp.sub-ja,,0,0,0,,Келесі жылы емтиханға бар күшімізді салайық
Dialogue: 0,0:19:36.92,0:19:39.29,Style2,,0,0,0,,«Осылайша, бір айдан кейін»
Dialogue: 0,0:19:39.39,0:19:41.72,Style2,,0,0,0,,«сабақтан кейін, ашылу салтанатынан кейін»
Dialogue: 0,0:19:45.23,0:19:46.90,Style1,,0,0,0,,Есіңізде болсын, Каору,
Dialogue: 0,0:19:45.30,0:19:46.37,jp.sub-ja,,0,0,0,,Тыңда, Каору.
Dialogue: 0,0:19:46.90,0:19:51.24,Style1,,0,0,0,,әлгі ақымақ мырзаның айтқаны бізге әсер еткендей емес.
Dialogue: 0,0:19:46.99,0:19:49.97,jp.sub-ja,,0,0,0,,Маған әлгі тентектің айтқаны әсер еткен жоқ.
Dialogue: 0,0:19:51.24,0:19:54.24,Style1,,0,0,0,,Мен білемін. Біз жай ғана уақытты өлтіру үшін келдік.
Dialogue: 0,0:19:51.34,0:19:52.01,jp.sub-ja,,0,0,0,,Мен білемін.
Dialogue: 0,0:19:52.65,0:19:53.79,jp.sub-ja,,0,0,0,,Уақытты өлтіру
Dialogue: 0,0:19:54.23,0:19:56.94,jp.sub-ja,,0,0,0,,Иә, бірақ бұл бос уақыт.
Dialogue: 0,0:19:54.24,0:19:55.91,Style1,,0,0,0,,Иә, дәл.
Dialogue: 0,0:19:55.91,0:19:57.57,Style1,,0,0,0,,Біз уақытты өлтіріп жатырмыз.
Dialogue: 0,0:19:59.24,0:20:03.25,Style1,,0,0,0,,Сіздің өміріңізде ешкім ешқашан келмеуі мүмкін
Dialogue: 0,0:19:59.43,0:20:03.09,jp.sub-ja,,0,0,0,,Мүмкін сізді шынымен ажырата алатын ешкім жоқ шығар.
Dialogue: 0,0:20:03.25,0:20:05.25,Style1,,0,0,0,,бұл екеуіңді бір-бірінен ажырата алады.
Dialogue: 0,0:20:03.48,0:20:04.77,jp.sub-ja,,0,0,0,,Ол ешқашан пайда болмауы мүмкін.
Dialogue: 0,0:20:05.25,0:20:07.09,Style1,,0,0,0,,Дұрыс айтасыз, ханым.
Dialogue: 0,0:20:05.40,0:20:06.41,jp.sub-ja,,0,0,0,,Иә, әпке.
Dialogue: 0,0:20:07.09,0:20:11.42,Style1,,0,0,0,,Бүкіл әлемде бізді ажырата алатын ешкім жоқ.
Dialogue: 0,0:20:07.27,0:20:09.05,jp.sub-ja,,0,0,0,,Бізді кім ажырата алады?
Dialogue: 0,0:20:09.70,0:20:10.86,jp.sub-ja,,0,0,0,,Бұл дүниеде жоқ
Dialogue: 0,0:20:11.42,0:20:13.09,Style1,,0,0,0,,Ешкім жоқ екеніне сенімдімін.
Dialogue: 0,0:20:11.55,0:20:12.50,jp.sub-ja,,0,0,0,,Мен олардың жоқтығына сенімдімін.
Dialogue: 0,0:20:13.09,0:20:16.60,Style1,,0,0,0,,Мен мұны түсінемін. Сонда да...
Dialogue: 0,0:20:13.21,0:20:15.40,jp.sub-ja,,0,0,0,,Мен мұны білемін, бірақ...
Dialogue: 0,0:20:16.60,0:20:19.60,Style1,,0,0,0,,Ендеше, бірге ашайық.
Dialogue: 0,0:20:16.61,0:20:18.03,jp.sub-ja,,0,0,0,,Олай болса бірге ашайық.
Dialogue: 0,0:20:19.60,0:20:20.79,Style1,,0,0,0,,мм-мм.
Dialogue: 0,0:20:23.60,0:20:25.43,Style1,,0,0,0,,Дайын, орнату...
Dialogue: 0,0:20:23.76,0:20:25.00,jp.sub-ja,,0,0,0,,Сено
Dialogue: 0,0:20:26.77,0:20:30.80,Style1,,0,0,0,,Сонымен біз есікті аштық.
Dialogue: 0,0:20:26.86,0:20:30.08,jp.sub-ja,,0,0,0,,Ал біз есікті аштық
Dialogue: 0,0:20:40.99,0:20:43.97,jp.sub-ja,,0,0,0,,Бүгіннен бастап біздің қабылдаушы клубымызда Хэллоуинге арналған ерекше апта болады.
Dialogue: 0,0:20:41.03,0:20:43.97,Style1,,0,0,0,,Бүгіннен бастап Хост-клуб ерекше Хэллоуин апталығын өткізеді!
Dialogue: 0,0:20:43.97,0:20:44.87,Style1,,0,0,0,,О, біз барамыз...
Dialogue: 0,0:20:44.08,0:20:44.87,jp.sub-ja,,0,0,0,,А, біз
Dialogue: 0,0:20:44.87,0:20:46.54,Style1,,0,0,0,,... сыныптағы іс-шараға байланысты үйірме жұмыстарын сағындық.
Dialogue: 0,0:20:44.96,0:20:46.51,jp.sub-ja,,0,0,0,,Сыныптағы іс-шараға байланысты үйірме жұмыстарына қатыспаймын.
Dialogue: 0,0:20:46.51,0:20:48.60,jp.sub-ja,,0,0,0,,Тоқта, күт, сен неге Харухиді өзіңмен алып жүрсің?
Dialogue: 0,0:20:46.54,0:20:48.87,Style1,,0,0,0,,Тоқта, күт, сен неге Харухиді өзіңмен алып жүрсің!?
Dialogue: 0,0:20:48.87,0:20:51.04,Style1,,0,0,0,,Келесі жолы «Асқабақ болған күнге дейін»
Dialogue: 0,0:20:51.04,0:20:55.20,Style1,,0,0,0,,Сізді келесі аптада Оуран орта мектебінің хост клубы күтеді!
Dialogue: 0,0:20:51.14,0:20:53.18,jp.sub-ja,,0,0,0,,Келесі аптада Оуран орта мектебінің хост клубы
Dialogue: 0,0:20:53.50,0:20:54.84,jp.sub-ja,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:20:56.70,0:21:02.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
