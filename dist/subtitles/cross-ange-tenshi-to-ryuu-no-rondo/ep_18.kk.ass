Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.12,0:00:10.79,Default,,0,0,0,,Бірінші ескерту жолын бұзу
Dialogue: 0,0:00:12.04,0:00:13.83,Default,,0,0,0,,Мен оны тірі деп ойламаппын.
Dialogue: 0,0:00:14.75,0:00:18.54,Default,,0,0,0,,Мен Вивиан мен Андж анық жоғалып кетті деп ойладым.
Dialogue: 0,0:00:18.87,0:00:20.41,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:00:20.91,0:00:23.70,Default,,0,0,0,,Дарадан тыс... Өйткені
Dialogue: 0,0:00:23.95,0:00:24.83,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:00:25.41,0:00:28.16,Default,,0,0,0,,Параллель ғалам және басқа Жер
Dialogue: 0,0:00:28.79,0:00:32.83,Default,,0,0,0,,Айдаһар... Жоқ, генетикалық түрлендірілген адамдар әлемі...
Dialogue: 0,0:00:34.75,0:00:37.08,Default,,0,0,0,,Олар сіз сөйлесе алатын адамдар.
Dialogue: 0,0:00:37.62,0:00:38.91,Default,,0,0,0,,Адамдардан айырмашылығы.
Dialogue: 0,0:00:39.79,0:00:42.75,Default,,0,0,0,,Айдаһармен күш біріктіру керек шығар.
Dialogue: 0,0:00:45.75,0:00:58.91,Default,,0,0,0,,Қараңғылық үшін дұға ет...
Dialogue: 0,0:01:00.29,0:01:05.75,Default,,0,0,0,,Бұл дүние – елес
Dialogue: 0,0:01:05.87,0:01:11.50,Default,,0,0,0,,Білсең де, болашақты нұрландыр
Dialogue: 0,0:01:11.62,0:01:16.45,Default,,0,0,0,,Кейінгі кескіндер жоқ
Dialogue: 0,0:01:16.58,0:01:23.00,Default,,0,0,0,,Мен саған күш пен батылдық бергім келеді.
Dialogue: 0,0:01:23.41,0:01:26.12,Default,,0,0,0,,Күресу
Dialogue: 0,0:01:26.20,0:01:28.75,Default,,0,0,0,,Кек сақтама
Dialogue: 0,0:01:28.87,0:01:31.75,Default,,0,0,0,,Тағдырдан тыс
Dialogue: 0,0:01:31.87,0:01:33.79,Default,,0,0,0,,Тұр
Dialogue: 0,0:01:33.87,0:01:40.25,Default,,0,0,0,,Үмітсіздік сіздің арғы желіңіз болсын...
Dialogue: 0,0:01:41.41,0:01:47.33,Default,,0,0,0,,Оян, әлі ауырады
Dialogue: 0,0:01:47.45,0:01:52.95,Default,,0,0,0,,Шынайы Аян
Dialogue: 0,0:01:53.12,0:02:00.62,Default,,0,0,0,,Мәңгілік басы мен соңы
Dialogue: 0,0:02:00.75,0:02:10.95,Default,,0,0,0,,Мифтен де әдемі...
Dialogue: 0,0:02:13.58,0:02:16.41,Default,,0,0,0,,Айдаһардың мақсаты – Аураны қайтарып алу.
Dialogue: 0,0:02:17.20,0:02:20.12,Default,,0,0,0,,Барлық энергия өшіріледі деп үміттенеміз.
Dialogue: 0,0:02:20.29,0:02:24.25,Default,,0,0,0,,Адамның манасы мен дүниесі тоқтайтын сияқты.
Dialogue: 0,0:02:24.37,0:02:25.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:25.41,0:02:29.54,Default,,0,0,0,,Singular қолданбасын аша алмайсыз және жақын арада Paramail қажет болмайды.
Dialogue: 0,0:02:30.16,0:02:34.37,Default,,0,0,0,,Ең бастысы, Норма мана энергиясын алу үшін айдаһарларды аулайды.
Dialogue: 0,0:02:34.87,0:02:37.70,Default,,0,0,0,,Біз бұл ақымақ шайқасты аяқтай аламыз.
Dialogue: 0,0:02:38.20,0:02:41.50,Default,,0,0,0,,Бірақ Сараконың шабуыл жоспары сәтсіз аяқталды.
Dialogue: 0,0:02:42.08,0:02:44.08,Default,,0,0,0,,Зақым әдеттен тыс болуы керек...
Dialogue: 0,0:02:44.83,0:02:49.25,Default,,0,0,0,,Менің ойымша, ең қысқа жол - өзара мақсаттар үшін ынтымақтастық.
Dialogue: 0,0:02:50.04,0:02:53.16,Default,,0,0,0,,Жауымның дұшпаны досым ба... Көрдім.
Dialogue: 0,0:02:53.25,0:02:53.91,Default,,0,0,0,,Не!
Dialogue: 0,0:02:54.12,0:02:59.79,Default,,0,0,0,,Джо, сіз қалжыңдап тұрсыз! Ол жігіттер менің көптеген достарымды өлтірген құбыжықтар.
Dialogue: 0,0:03:00.08,0:03:03.12,Default,,0,0,0,,Айдаһарлармен ынтымақтасу? Бұл мүмкін емес
Dialogue: 0,0:03:03.70,0:03:04.29,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:04.37,0:03:05.87,Default,,0,0,0,,Менімен сөйлессең, түсінесің.
Dialogue: 0,0:03:06.20,0:03:09.62,Default,,0,0,0,,Бұл бекер... Оларға сенуге тұрарлық емес.
Dialogue: 0,0:03:10.95,0:03:12.79,Default,,0,0,0,,Аура ма, әлде не екенін білмеймін.
Dialogue: 0,0:03:13.37,0:03:17.16,Default,,0,0,0,,Бір айдаһарды құтқару арқылы Либертас бітеді деп ойлайсыз ба?
Dialogue: 0,0:03:18.08,0:03:22.37,Default,,0,0,0,,Құдайдың билеушісі Эмбрионды жойып, бұл әлемді жойыңыз.
Dialogue: 0,0:03:23.00,0:03:25.29,Default,,0,0,0,,Норманы босатудың басқа жолы жоқ.
Dialogue: 0,0:03:26.87,0:03:29.12,Default,,0,0,0,,Мен ұмытқан сияқты емеспін, Андж.
Dialogue: 0,0:03:29.45,0:03:33.58,Default,,0,0,0,,Туған жерім, бауырларым, елім опасыздық еткен өткен.
Dialogue: 0,0:03:34.08,0:03:35.75,Default,,0,0,0,,Адамдарға деген ашу-ыза
Dialogue: 0,0:03:36.16,0:03:36.87,Default,,0,0,0,,Ах
Dialogue: 0,0:03:36.95,0:03:39.75,Default,,0,0,0,,Бұл кемсітушілік пен алалаушылыққа толы әлемді жойыңыз
Dialogue: 0,0:03:40.08,0:03:42.00,Default,,0,0,0,,Бұл сіздің еркіңіз емес пе?
Dialogue: 0,0:03:42.91,0:03:43.54,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:44.25,0:03:45.66,Default,,0,0,0,,Мұның мағынасы жоқ.
Dialogue: 0,0:03:46.29,0:03:49.45,Default,,0,0,0,,Сізді айдаһар қабылдап, миыңызды шайып жіберді ме?
Dialogue: 0,0:03:49.91,0:03:52.33,Default,,0,0,0,,Әлде сен әйел болып кеттің бе?
Dialogue: 0,0:03:52.45,0:03:52.95,Default,,0,0,0,,Ах
Dialogue: 0,0:03:53.29,0:03:57.79,Default,,0,0,0,,Егер сіз қызғылт бақшада еркекпен жыныстық қатынасқа түскіңіз келсе, мұны бәрі аяқталғаннан кейін жасаңыз!
Dialogue: 0,0:03:58.08,0:03:59.00,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:00.04,0:04:04.95,Default,,0,0,0,,Дегенмен, Джилл, біздің әскери күшіміз жеткіліксіз екені рас.
Dialogue: 0,0:04:05.41,0:04:07.79,Default,,0,0,0,,Өйткені Сария мен басқалары аударылды.
Dialogue: 0,0:04:07.87,0:04:08.66,Default,,0,0,0,,Ах
Dialogue: 0,0:04:09.20,0:04:12.95,Default,,0,0,0,,Анге: Айдаһармен байланысуға болады ма?
Dialogue: 0,0:04:13.41,0:04:17.79,Default,,0,0,0,,Егер сіз Виркис болсаңыз, Singular қолданбасын ашпай-ақ сонша секіре аласыз.
Dialogue: 0,0:04:18.16,0:04:19.20,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:04:20.16,0:04:24.37,Default,,0,0,0,,Айдаһармен жұмыс Бұл ойлануға тұрарлық емес пе?
Dialogue: 0,0:04:24.50,0:04:25.50,Default,,0,0,0,,Охо!
Dialogue: 0,0:04:28.00,0:04:28.70,Default,,0,0,0,,Джилл
Dialogue: 0,0:04:29.91,0:04:31.37,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:04:36.00,0:04:40.54,Default,,0,0,0,,Ақпаратты зерттегеннен кейін біз сізге болашақ операциялар туралы хабарлаймыз. Міне бітті.
Dialogue: 0,0:04:43.75,0:04:44.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:45.58,0:04:49.91,Default,,0,0,0,,Сонда да аман-есен оралғаныңызға қуаныштымын.
Dialogue: 0,0:04:50.50,0:04:52.37,Default,,0,0,0,,Бүгін кешке демалыңыз.
Dialogue: 0,0:04:55.62,0:04:57.54,Default,,0,0,0,,иә иә
Dialogue: 0,0:04:57.83,0:04:59.04,Default,,0,0,0,,Мен аш емеспін. Хүү…
Dialogue: 0,0:04:59.33,0:05:04.29,Default,,0,0,0,,Момока күрішінен күткендей, мен жаман Норма күрішін сағындым!
Dialogue: 0,0:05:06.29,0:05:08.58,Default,,0,0,0,,Of? Уууу...
Dialogue: 0,0:05:08.66,0:05:12.41,Default,,0,0,0,,Шынымен... кәмпитсіз де енді айдаһарға айналмайсың ба?
Dialogue: 0,0:05:12.79,0:05:14.04,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:05:14.54,0:05:16.58,Default,,0,0,0,,Үлкен ғылыми қабілет.
Dialogue: 0,0:05:16.75,0:05:21.12,Default,,0,0,0,,О, солай! Ондағылардың бәрінің қанаттары мен құйрықтары болды.
Dialogue: 0,0:05:21.58,0:05:23.04,Default,,0,0,0,,Мен не емеспін?
Dialogue: 0,0:05:23.20,0:05:24.62,Default,,0,0,0,,Мен оны кесіп тастадым, өйткені ол анықталатын болды.
Dialogue: 0,0:05:24.66,0:05:26.20,Default,,0,0,0,,Уау, Хиди!
Dialogue: 0,0:05:27.33,0:05:30.50,Default,,0,0,0,,Аврора әлі қозғалып жатты.
Dialogue: 0,0:05:30.79,0:05:31.75,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:05:32.12,0:05:35.08,Default,,0,0,0,,Ежелгі адамдар салған Либертастың флагманы
Dialogue: 0,0:05:35.91,0:05:39.12,Default,,0,0,0,,Біз бұл кемеде Эмбрионмен күрестік.
Dialogue: 0,0:05:40.12,0:05:44.41,Default,,0,0,0,,Төсек сәл тар, бірақ өте ыңғайлы, уайымдамаңыз.
Dialogue: 0,0:05:44.66,0:05:46.29,Default,,0,0,0,,Шындығында мен Хори ханымға біраз уақыттан бері ғашықпын.
Dialogue: 0,0:05:46.37,0:05:47.83,Default,,0,0,0,,Еш нәрсеге жақсы емес
Dialogue: 0,0:05:48.16,0:05:51.16,Default,,0,0,0,,Майданнан адасып, адаммен оралды
Dialogue: 0,0:05:51.54,0:05:54.91,Default,,0,0,0,,Оның үстіне еркек нормасы дегеніміз не?
Dialogue: 0,0:05:55.08,0:05:57.29,Default,,0,0,0,,А... қатаң айтқанда, бұл Норма...
Dialogue: 0,0:05:57.75,0:06:00.37,Default,,0,0,0,,Сіз қаншалықты өзімшілсіз?
Dialogue: 0,0:06:00.41,0:06:02.66,Default,,0,0,0,,Хехе кешіріңіз Хилда
Dialogue: 0,0:06:02.83,0:06:03.25,Default,,0,0,0,,Ах
Dialogue: 0,0:06:04.41,0:06:05.12,Default,,0,0,0,,…
Dialogue: 0,0:06:05.25,0:06:06.91,Default,,0,0,0,,Why are you so irritated?
Dialogue: 0,0:06:07.70,0:06:08.41,Default,,0,0,0,,Бөлек
Dialogue: 0,0:06:09.16,0:06:12.04,Default,,0,0,0,,It's been tough since you left.
Dialogue: 0,0:06:12.33,0:06:13.29,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:06:13.58,0:06:17.45,Default,,0,0,0,,Арзенал жойылады, менің көптеген достарым өлтіріледі.
Dialogue: 0,0:06:18.45,0:06:20.29,Default,,0,0,0,,Chris and the others will become enemies.
Dialogue: 0,0:06:20.41,0:06:21.04,Default,,0,0,0,,Ах
Dialogue: 0,0:06:21.33,0:06:24.70,Default,,0,0,0,,…
Dialogue: 0,0:06:25.37,0:06:26.83,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:06:27.16,0:06:29.20,Default,,0,0,0,,Ол мені аяусыз ұра бастады.
Dialogue: 0,0:06:29.91,0:06:32.16,Default,,0,0,0,,Біз енді дос емеспіз.
Dialogue: 0,0:06:32.58,0:06:35.45,Default,,0,0,0,,Енді сен ғана күресе аласың ба?
Dialogue: 0,0:06:35.70,0:06:37.45,Default,,0,0,0,,А? Иә, бірақ
Dialogue: 0,0:06:37.91,0:06:40.58,Default,,0,0,0,,Бұл кеме жақсы суға батқан жоқ.
Dialogue: 0,0:06:40.83,0:06:42.58,Default,,0,0,0,,Сіз ұрыс таңдауға тырысып жатырсыз ба?
Dialogue: 0,0:06:43.66,0:06:45.70,Default,,0,0,0,,Because these guys worked hard.
Dialogue: 0,0:06:46.20,0:06:48.58,Default,,0,0,0,,Нонна Марика Мэри
Dialogue: 0,0:06:48.79,0:06:51.91,Default,,0,0,0,,Күш жетіспегендіктен шабандоздыққа көтерілген жаңадан келгендер.
Dialogue: 0,0:06:52.41,0:06:56.41,Default,,0,0,0,,Мен жасаған тынымсыз еңбектің арқасында біз бірге болдық...
Dialogue: 0,0:06:57.04,0:06:57.62,Default,,0,0,0,,Ах
Dialogue: 0,0:06:57.87,0:07:00.12,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын!
Dialogue: 0,0:07:00.25,0:07:01.70,Default,,0,0,0,,Не? мен?
Dialogue: 0,0:07:02.00,0:07:05.16,Default,,0,0,0,,Сіз бірінші компанияның ойыншысысыз, Вивиан-оне-сама, солай ма?
Dialogue: 0,0:07:05.41,0:07:07.00,Default,,0,0,0,,I've always wanted to
Dialogue: 0,0:07:07.08,0:07:07.95,Default,,0,0,0,,Жұмсақ батут!
Dialogue: 0,0:07:08.37,0:07:11.33,Default,,0,0,0,,...
Dialogue: 0,0:07:11.37,0:07:14.75,Default,,0,0,0,,Сәлем! Менде ондай сөз жоқ!
Dialogue: 0,0:07:15.04,0:07:15.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:16.16,0:07:17.12,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:17.33,0:07:22.62,Default,,0,0,0,,No, it wasn't Alektra. I was worried about Jill's condition.
Dialogue: 0,0:07:23.70,0:07:26.16,Default,,0,0,0,,Alektra Maria von Lebenhertz
Dialogue: 0,0:07:26.41,0:07:27.33,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:07:27.41,0:07:27.95,Default,,0,0,0,,Ах
Dialogue: 0,0:07:28.41,0:07:31.91,Default,,0,0,0,,Мұны барлығы біледі, өйткені командир бәрін берді.
Dialogue: 0,0:07:32.45,0:07:36.12,Default,,0,0,0,,Менің шынайы болмысым және Либертастың себебі.
Dialogue: 0,0:07:36.83,0:07:41.79,Default,,0,0,0,,Мырзалар, сіз адамдардың қатыгездігі мен мейірімсіздігін аңғарған боларсыз.
Dialogue: 0,0:07:42.45,0:07:45.50,Default,,0,0,0,,I will definitely defeat Embryo.
Dialogue: 0,0:07:46.04,0:07:48.70,Default,,0,0,0,,Free Norma from this cursed fate
Dialogue: 0,0:07:49.25,0:07:53.87,Default,,0,0,0,,Сол күнге дейін сенің өмірің менің қарауымда.
Dialogue: 0,0:07:55.41,0:07:57.58,Default,,0,0,0,,Alektra did that...
Dialogue: 0,0:07:58.08,0:08:01.95,Default,,0,0,0,,Мен сіздің ынтаңызды түсінемін, бірақ бұл тым байсалды және менің көңілім қалды.
Dialogue: 0,0:08:02.33,0:08:05.62,Default,,0,0,0,,What do you know about him?
Dialogue: 0,0:08:05.70,0:08:06.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:10.75,0:08:12.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:12.16,0:08:13.58,Default,,0,0,0,,...
Dialogue: 0,0:08:13.91,0:08:17.83,Default,,0,0,0,,Эмма жақсы. Эмма жақсы.
Dialogue: 0,0:08:17.95,0:08:19.16,Default,,0,0,0,,Саке сорғыш
Dialogue: 0,0:08:19.41,0:08:22.79,Default,,0,0,0,,Мен бұл кемеге мінгеннен бері солай болды.
Dialogue: 0,0:08:23.00,0:08:24.87,Default,,0,0,0,,It can't be helped!
Dialogue: 0,0:08:25.25,0:08:27.91,Default,,0,0,0,,Мені өлтіре жаздады! мен…
Dialogue: 0,0:08:28.37,0:08:30.12,Default,,0,0,0,,Бір адамға...
Dialogue: 0,0:08:30.91,0:08:38.62,Default,,0,0,0,,Сонда да командир мені осы кемеге отырғызды.
Dialogue: 0,0:08:39.08,0:08:42.45,Default,,0,0,0,,Мен Нормаға осы уақытқа дейін қорқынышты істер жасадым.
Dialogue: 0,0:08:42.75,0:08:43.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:43.54,0:08:47.04,Default,,0,0,0,,Тек сол адам! Бұл дүниеде сенуге болатын нәрсе
Dialogue: 0,0:08:47.58,0:08:50.29,Default,,0,0,0,,Менің ойымша, Перолина!
Dialogue: 0,0:08:50.50,0:08:53.08,Default,,0,0,0,,Иә, иә, бұл туралы.
Dialogue: 0,0:08:53.20,0:08:57.37,Default,,0,0,0,,Ааа...
Dialogue: 0,0:08:58.95,0:09:01.62,Default,,0,0,0,,Бірақ инспектор дұрыс айтады.
Dialogue: 0,0:09:01.79,0:09:02.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:02.66,0:09:08.41,Default,,0,0,0,,Бұл дүниеде сенетін жалғыз адам – командир....
Dialogue: 0,0:09:08.66,0:09:09.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:18.12,0:09:20.33,Default,,0,0,0,,Мен бір нәрсені сезіп тұрмын
Dialogue: 0,0:09:20.54,0:09:22.91,Default,,0,0,0,,Өйткені ол теңіз суымен араласқан.
Dialogue: 0,0:09:23.08,0:09:24.50,Default,,0,0,0,,Хилда? Ах!
Dialogue: 0,0:09:25.54,0:09:27.95,Default,,0,0,0,,Сіз аздап салмақ қостыңыз ба?
Dialogue: 0,0:09:28.04,0:09:30.70,Default,,0,0,0,,Не? шын? Қайда?
Dialogue: 0,0:09:32.37,0:09:33.45,Default,,0,0,0,,Мұнда немесе мұнда
Dialogue: 0,0:09:34.00,0:09:35.66,Default,,0,0,0,,А, сәл күте тұрыңыз...
Dialogue: 0,0:09:35.87,0:09:38.95,Default,,0,0,0,,Менімен мүлдем хабарласпа.
Dialogue: 0,0:09:39.37,0:09:41.58,Default,,0,0,0,,Иә, оған көмектесу мүмкін емес.
Dialogue: 0,0:09:41.95,0:09:47.37,Default,,0,0,0,,Маған үнемі уайымдауға рұқсат етіңіз, бірақ сіз ер адамсыз
Dialogue: 0,0:09:48.08,0:09:48.83,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:51.54,0:09:53.04,Default,,0,0,0,,Эй, сен не істедің?
Dialogue: 0,0:09:53.12,0:09:54.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:54.75,0:09:55.87,Default,,0,0,0,,Сол адаммен
Dialogue: 0,0:09:55.95,0:09:58.70,Default,,0,0,0,,Иә? Мен істеген жоқпын!
Dialogue: 0,0:09:59.29,0:10:00.37,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:10:00.50,0:10:05.04,Default,,0,0,0,,Шынымен! Қазірдің өзінде... бұл не?
Dialogue: 0,0:10:05.54,0:10:06.62,Default,,0,0,0,,Шак
Dialogue: 0,0:10:06.87,0:10:07.37,Default,,0,0,0,,Ах
Dialogue: 0,0:10:07.95,0:10:09.62,Default,,0,0,0,,Андж қайта қош келдіңіз
Dialogue: 0,0:10:11.91,0:10:12.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:21.95,0:10:26.33,Default,,0,0,0,,Мен бұл бұрмаланған дүние мен еркін Норманы түзетемін.
Dialogue: 0,0:10:27.33,0:10:32.54,Default,,0,0,0,,Мен ешкімді кемсітпей күлетін, тең болатын дүние жасаймын.
Dialogue: 0,0:10:33.20,0:10:33.91,Default,,0,0,0,,Тапсырма
Dialogue: 0,0:10:36.04,0:10:37.12,Default,,0,0,0,,Алектра
Dialogue: 0,0:10:37.58,0:10:38.20,Default,,0,0,0,,Кім?
Dialogue: 0,0:10:39.04,0:10:39.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:40.12,0:10:45.58,Default,,0,0,0,,А, жоқ, бұл кеме қыздарға толы, қояр жер жоқ.
Dialogue: 0,0:10:46.25,0:10:48.91,Default,,0,0,0,,Мүмкін мен машинада ұйықтауым керек шығар.
Dialogue: 0,0:10:49.16,0:10:49.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:50.20,0:10:53.16,Default,,0,0,0,,Осы уақытқа дейін техникалық қызмет көрсетуде жұмыс істеп жатырсыз ба?
Dialogue: 0,0:10:53.54,0:10:56.20,Default,,0,0,0,,Сен қайтып келдің, Вилкис.
Dialogue: 0,0:10:57.08,0:11:02.12,Default,,0,0,0,,Біз Libertas дайындаған кезде өте мұқият болуымыз керек, сондықтан оны кез келген уақытта бастай аламыз.
Dialogue: 0,0:11:03.00,0:11:03.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:04.50,0:11:06.12,Default,,0,0,0,,Жарайды, дайын!
Dialogue: 0,0:11:09.16,0:11:10.37,Default,,0,0,0,,Ал, мен барамын.
Dialogue: 0,0:11:10.70,0:11:12.16,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:11:13.62,0:11:18.50,Default,,0,0,0,,Андж құлаған кезде Виркисті жөндеген сен едің ғой?
Dialogue: 0,0:11:19.00,0:11:21.29,Default,,0,0,0,,А, бұл да болды.
Dialogue: 0,0:11:21.62,0:11:23.91,Default,,0,0,0,,Мен саған бір күні рахмет айтуды ойладым.
Dialogue: 0,0:11:24.62,0:11:27.08,Default,,0,0,0,,Рахмет, Вилькис рыцары!
Dialogue: 0,0:11:31.12,0:11:32.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:41.58,0:11:44.04,Default,,0,0,0,,Тек жағдайда...?
Dialogue: 0,0:11:46.50,0:11:50.75,Default,,0,0,0,,Иә, біртүрлі болған дұрыс, Алектра.
Dialogue: 0,0:11:52.00,0:11:53.37,Default,,0,0,0,,Эмбрион
Dialogue: 0,0:11:56.95,0:11:58.16,Default,,0,0,0,,Жақсы ұйықтадың ба?
Dialogue: 0,0:11:58.79,0:11:59.50,Default,,0,0,0,,Иә
Dialogue: 0,0:11:59.75,0:12:01.16,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:12:02.04,0:12:04.25,Default,,0,0,0,,Енді мен сендерге тапсырма беремін.
Dialogue: 0,0:12:04.66,0:12:05.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:05.75,0:12:10.91,Default,,0,0,0,,Айдаһармен байланысыңыз, келіссөздер жүргізіңіз және біріккен майданды сұраңыз.
Dialogue: 0,0:12:11.33,0:12:12.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:18.75,0:12:19.66,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:20.20,0:12:25.08,Default,,0,0,0,,Сіз ұсынғандай, мен айдаһарлармен бірге соғысамыз деп жатырмын.
Dialogue: 0,0:12:26.75,0:12:27.04,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:12:27.70,0:12:29.91,Default,,0,0,0,,Либертасты қалай тоқтатуға болады
Dialogue: 0,0:12:30.08,0:12:35.16,Default,,0,0,0,,Мен айдаһармен бірге күресуді ең ұтымды және тиімді нұсқа деп шештім.
Dialogue: 0,0:12:35.25,0:12:35.91,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:12:36.00,0:12:36.83,Default,,0,0,0,,Уф
Dialogue: 0,0:12:37.70,0:12:38.25,Default,,0,0,0,,Анге
Dialogue: 0,0:12:38.58,0:12:39.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:39.79,0:12:42.62,Default,,0,0,0,,стратегияға шолу жасайды.
Dialogue: 0,0:12:44.75,0:12:45.66,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:46.00,0:12:50.00,Default,,0,0,0,,Бұл Сариямен және басқалармен байланысқан кезде ұшаққа қойылған маркердің реакциясы.
Dialogue: 0,0:12:50.62,0:12:52.08,Default,,0,0,0,,Мен жасадым.
Dialogue: 0,0:12:52.29,0:12:52.87,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:12:53.20,0:12:57.41,Default,,0,0,0,,Бұл жігіттердің қайтып оралу орны маркердің реакциясын бақылау арқылы анықталды.
Dialogue: 0,0:12:57.66,0:12:58.54,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:12:59.29,0:13:02.45,Default,,0,0,0,,Мисуруги империясы Акацуки тірегі
Dialogue: 0,0:13:02.62,0:13:03.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:03.70,0:13:06.37,Default,,0,0,0,,Мүмкін эмбрион да осында болуы мүмкін.
Dialogue: 0,0:13:07.08,0:13:11.16,Default,,0,0,0,,Басқаша айтқанда, Акацуки но Онбашира соңғы түсіру нүктесі болып табылады.
Dialogue: 0,0:13:12.08,0:13:13.54,Default,,0,0,0,,Аура да сонда болуы керек.
Dialogue: 0,0:13:14.25,0:13:16.33,Default,,0,0,0,,Бұл сенімді ақпарат.
Dialogue: 0,0:13:17.37,0:13:19.87,Default,,0,0,0,,Алдымен жаудың күшін азайтамыз.
Dialogue: 0,0:13:20.54,0:13:25.33,Default,,0,0,0,,Андж айдаһарлары Мисуруги империясына оңтүстік-батыс жағынан басып кірсін.
Dialogue: 0,0:13:25.66,0:13:27.37,Default,,0,0,0,,Рагнамейлді еліктіріңіз
Dialogue: 0,0:13:28.33,0:13:32.62,Default,,0,0,0,,Аврора бұл мүмкіндікті пайдаланып, Ragna Mail анықталмайтын тереңдіктерді кесіп өтті.
Dialogue: 0,0:13:33.20,0:13:36.41,Default,,0,0,0,,Айдаһарлардың артына шығып, қысқышпен шабуыл жасау.
Dialogue: 0,0:13:37.62,0:13:39.41,Default,,0,0,0,,Жау күштерін жойғаннан кейін
Dialogue: 0,0:13:39.62,0:13:42.45,Default,,0,0,0,,Барлық әскерлеріңізбен Акацуки но Онбашираға шабуыл жасаңыз.
Dialogue: 0,0:13:43.04,0:13:44.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:44.54,0:13:48.04,Default,,0,0,0,,Бірақ бұл айдаһарға үлкен салмақ түсіреді.
Dialogue: 0,0:13:48.54,0:13:50.16,Default,,0,0,0,,Диверсия деген осы.
Dialogue: 0,0:13:50.75,0:13:52.12,Default,,0,0,0,,Сария мен басқалары не істейді?
Dialogue: 0,0:13:53.79,0:13:54.83,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:13:55.50,0:13:56.58,Default,,0,0,0,,Маған көмектеспейсіз бе?
Dialogue: 0,0:13:56.83,0:14:00.58,Default,,0,0,0,,Ия, маған иесіне опасыздық жасайтын құрал керек емес.
Dialogue: 0,0:14:00.91,0:14:03.58,Default,,0,0,0,,Құрал - Талия.
Dialogue: 0,0:14:04.08,0:14:06.70,Default,,0,0,0,,Барлығы Либертас үшін құрал ғана
Dialogue: 0,0:14:07.37,0:14:10.45,Default,,0,0,0,,Айдаһарлар, сен, мен де.
Dialogue: 0,0:14:10.87,0:14:12.45,Default,,0,0,0,,А, айдаһарлар да?
Dialogue: 0,0:14:13.25,0:14:18.12,Default,,0,0,0,,Эй, сен не жоспарлап отырсың? Сіз айдаһардың не істегенін қалайсыз?
Dialogue: 0,0:14:18.54,0:14:19.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:19.79,0:14:21.83,Default,,0,0,0,,Жауап бермесең, бұйрықтарыңды тыңдамаймын!
Dialogue: 0,0:14:22.08,0:14:27.20,Default,,0,0,0,,Га, айдаһарлармен қысқыш шабуыл? Ах ха ха...
Dialogue: 0,0:14:28.41,0:14:30.91,Default,,0,0,0,,Аврораның шынайы көтерілу нүктесі осында.
Dialogue: 0,0:14:32.20,0:14:35.08,Default,,0,0,0,,Айдаһарлар Рагнамайлмен соғысып жатқанда
Dialogue: 0,0:14:35.41,0:14:39.54,Default,,0,0,0,,Андж, сіз және Парамейл тобы Акацуки бағанасына кіресіз.
Dialogue: 0,0:14:39.91,0:14:41.37,Default,,0,0,0,,Эмбрионды жою
Dialogue: 0,0:14:41.66,0:14:42.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:42.79,0:14:43.95,Default,,0,0,0,,Айдаһар тасталған кесек пе?
Dialogue: 0,0:14:44.66,0:14:48.37,Default,,0,0,0,,Мен Виркиске, менің козиріме қауіп төндіретін ештеңе істей алмаймын.
Dialogue: 0,0:14:48.87,0:14:50.16,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:14:50.91,0:14:54.79,Default,,0,0,0,,Мұндай қорқынышты стратегиямен ынтымақтасуға ешқандай мүмкіндік жоқ!
Dialogue: 0,0:14:55.41,0:14:57.91,Default,,0,0,0,,Олай болса мен сені ынтымақтастыққа шақырамын.
Dialogue: 0,0:15:00.54,0:15:02.58,Default,,0,0,0,,Ммм...
Dialogue: 0,0:15:02.66,0:15:03.41,Default,,0,0,0,,Момока!
Dialogue: 0,0:15:04.12,0:15:08.87,Default,,0,0,0,,Декомпрессиялық камераның люкін ашсаңыз, қызметші су қысымынан әп-сәтте жаншып қалады.
Dialogue: 0,0:15:09.29,0:15:11.41,Default,,0,0,0,,Джил Бұл сенің істеп жатырсың ба?
Dialogue: 0,0:15:11.58,0:15:13.20,Default,,0,0,0,,Мен бұл туралы естіген жоқпын!
Dialogue: 0,0:15:13.79,0:15:15.95,Default,,0,0,0,,Анге - әдеттегі тәртіпті бұзушы.
Dialogue: 0,0:15:16.83,0:15:18.62,Default,,0,0,0,,Сақтық шаралары қабылданғанға дейін
Dialogue: 0,0:15:19.58,0:15:20.62,Default,,0,0,0,,Алектра…
Dialogue: 0,0:15:20.79,0:15:24.29,Default,,0,0,0,,Құтқарғыңыз келсе, барлық жоспарларды қабылдап, әрекет жасаңыз.
Dialogue: 0,0:15:24.83,0:15:27.29,Default,,0,0,0,,Сіз не істеп жатқаныңызды білесіз бе?
Dialogue: 0,0:15:28.08,0:15:31.25,Default,,0,0,0,,Либертастың алдында бәрі пешке мен құрал.
Dialogue: 0,0:15:31.83,0:15:34.08,Default,,0,0,0,,Сол қызметші сізді қозғалтатын құрал
Dialogue: 0,0:15:34.50,0:15:36.54,Default,,0,0,0,,Сіз Виркисті жылжытатын құралсыз
Dialogue: 0,0:15:36.91,0:15:40.58,Default,,0,0,0,,Ал Виркис - эмбрионды өлтіретін ең жақсы қару.
Dialogue: 0,0:15:41.16,0:15:42.04,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:15:42.45,0:15:44.45,Default,,0,0,0,,Тегін Момока! Қазір!
Dialogue: 0,0:15:45.54,0:15:47.12,Default,,0,0,0,,А-а-а-уф
Dialogue: 0,0:15:47.41,0:15:48.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:48.95,0:15:50.87,Default,,0,0,0,,Бұл басшыға қарсы шығу қылмысы.
Dialogue: 0,0:15:51.87,0:15:53.33,Default,,0,0,0,,Тоқта, Алектра!
Dialogue: 0,0:15:54.37,0:15:56.37,Default,,0,0,0,,Гуаааааааааа...
Dialogue: 0,0:15:57.04,0:15:57.79,Default,,0,0,0,,Ах
Dialogue: 0,0:15:58.25,0:15:59.95,Default,,0,0,0,,(2-қыз) О, өтінемін, өзіңізді міндетті сезінбеңіз, ханым
Dialogue: 0,0:16:00.16,0:16:03.08,Default,,0,0,0,,Ендеше, жауабыңызды тыңдайық.
Dialogue: 0,0:16:03.25,0:16:04.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:05.70,0:16:07.58,Default,,0,0,0,,Сен өзгердің, Алектра.
Dialogue: 0,0:16:11.37,0:16:11.83,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:12.91,0:16:14.62,Default,,0,0,0,,Енді жауабы қандай?
Dialogue: 0,0:16:14.83,0:16:17.20,Default,,0,0,0,,...
Dialogue: 0,0:16:20.12,0:16:22.50,Default,,0,0,0,,Ауыртпасаңыз, түсінбейсіз бе?
Dialogue: 0,0:16:25.12,0:16:26.20,Default,,0,0,0,,Ах
Dialogue: 0,0:16:27.08,0:16:28.04,Default,,0,0,0,,Уф
Dialogue: 0,0:16:28.20,0:16:30.16,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:16:31.87,0:16:34.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:34.29,0:16:34.91,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:16:35.00,0:16:35.54,Default,,0,0,0,,Анж!
Dialogue: 0,0:16:35.62,0:16:36.20,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:36.45,0:16:37.25,Default,,0,0,0,,Бұл!
Dialogue: 0,0:16:39.04,0:16:41.16,Default,,0,0,0,,Хмм... газ?
Dialogue: 0,0:16:44.95,0:16:46.54,Default,,0,0,0,,Не деген...
Dialogue: 0,0:16:47.29,0:16:49.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:49.33,0:16:53.08,Default,,0,0,0,,Міне! Тасуку айтқан В жоспары!
Dialogue: 0,0:16:53.87,0:16:55.04,Default,,0,0,0,,Қап!
Dialogue: 0,0:16:57.66,0:16:58.37,Default,,0,0,0,,Йоттотто
Dialogue: 0,0:16:58.45,0:17:03.62,Default,,0,0,0,,Бұл адамда қызықты нәрсе болды, Энн... Джу...
Dialogue: 0,0:17:04.37,0:17:06.16,Default,,0,0,0,,Сізге тапсырма
Dialogue: 0,0:17:06.54,0:17:08.58,Default,,0,0,0,,Мүмкін болса пайдаланғым келмеді.
Dialogue: 0,0:17:09.08,0:17:12.95,Default,,0,0,0,,Вилькис рыцарлары Либертастың жолына түсе ме?
Dialogue: 0,0:17:13.41,0:17:16.87,Default,,0,0,0,,Мен Вилькистің рыцарьсы емеспін, мен Андждың рыцарімін.
Dialogue: 0,0:17:21.95,0:17:24.58,Default,,0,0,0,,Түсті байқадың ба... бала?
Dialogue: 0,0:17:25.66,0:17:29.87,Default,,0,0,0,,Хмм... иә...
Dialogue: 0,0:17:30.83,0:17:31.54,Default,,0,0,0,,Момока!
Dialogue: 0,0:17:31.87,0:17:33.16,Default,,0,0,0,,Құрметті Ангелиза!
Dialogue: 0,0:17:35.54,0:17:38.08,Default,,0,0,0,,Кешіріңіз, мен жақында оянамын.
Dialogue: 0,0:17:41.79,0:17:43.79,Default,,0,0,0,,Аврора пайда бола бастайды
Dialogue: 0,0:17:49.62,0:17:50.91,Default,,0,0,0,,Сонардың жауабы
Dialogue: 0,0:17:51.20,0:17:52.16,Default,,0,0,0,,Мүмкін бұл кеме
Dialogue: 0,0:17:52.58,0:17:54.54,Default,,0,0,0,,Түсіндім, асығыңыз
Dialogue: 0,0:18:01.79,0:18:05.58,Default,,0,0,0,,Біз жер бетіне жеткенде, қашу үшін парамельді қолданамыз. Дайын бол!
Dialogue: 0,0:18:05.95,0:18:06.83,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:18:09.83,0:18:11.66,Default,,0,0,0,,Жаудың алдынан тағы қашу?
Dialogue: 0,0:18:11.83,0:18:12.95,Default,,0,0,0,,Ах
Dialogue: 0,0:18:14.12,0:18:14.66,Default,,0,0,0,,Джилл
Dialogue: 0,0:18:15.29,0:18:20.00,Default,,0,0,0,,Андж Либертаста табысқа жеткенше қашпаңыз.
Dialogue: 0,0:18:20.79,0:18:22.70,Default,,0,0,0,,Ммм.
Dialogue: 0,0:18:23.00,0:18:25.62,Default,,0,0,0,,Либертас менсіз істей алмайды, солай ма?
Dialogue: 0,0:18:26.08,0:18:28.20,Default,,0,0,0,,Сонда да менің еркімді елемейсің бе?
Dialogue: 0,0:18:28.66,0:18:30.58,Default,,0,0,0,,Құралдар ерік күшін қажет етпейді
Dialogue: 0,0:18:30.75,0:18:33.91,Default,,0,0,0,,Мені өз еркіммен күресуге мәжбүрлеу
Dialogue: 0,0:18:34.25,0:18:37.33,Default,,0,0,0,,Бұл адамдар Норманы жасайтын нәрсемен бірдей емес!
Dialogue: 0,0:18:37.83,0:18:41.70,Default,,0,0,0,,Бұйрықтарды орындаңыз. Мен командирмін.
Dialogue: 0,0:18:42.41,0:18:44.54,Default,,0,0,0,,Адам ретінде сен қоқыссың.
Dialogue: 0,0:18:51.50,0:18:52.33,Default,,0,0,0,,Жарысайық
Dialogue: 0,0:18:52.87,0:18:53.37,Default,,0,0,0,,Не?
Dialogue: 0,0:18:53.66,0:18:57.45,Default,,0,0,0,,Сарако қорқақ кепіл сияқты әрекет етпеді.
Dialogue: 0,0:18:58.16,0:19:00.37,Default,,0,0,0,,Егер жеңсең, мен сені тыңдаймын.
Dialogue: 0,0:19:00.50,0:19:01.75,Default,,0,0,0,,Құрметті Ангелиза!
Dialogue: 0,0:19:02.08,0:19:04.08,Default,,0,0,0,,Момока мен Сатте тапсырмасы
Dialogue: 0,0:19:04.41,0:19:06.04,Default,,0,0,0,,Сау бол, Андж
Dialogue: 0,0:19:07.37,0:19:09.75,Default,,0,0,0,,Сәттілік, Анжелиза!
Dialogue: 0,0:19:10.00,0:19:12.62,Default,,0,0,0,,Осы кезең өтсе де мен өзімшілмін!
Dialogue: 0,0:19:13.04,0:19:15.41,Default,,0,0,0,,Сіз менмен болуыңыз керек!
Dialogue: 0,0:19:15.87,0:19:19.41,Default,,0,0,0,,Эмбрион жеңілмейінше Либертас аяқталмайды!
Dialogue: 0,0:19:19.75,0:19:23.33,Default,,0,0,0,,Уф, сіз бұл мақсат үшін кез келген құрбандық қабылданады дейсіз бе?
Dialogue: 0,0:19:23.66,0:19:24.83,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:25.16,0:19:27.66,Default,,0,0,0,,Мұндай шайқастың мәні неде?
Dialogue: 0,0:19:28.00,0:19:31.29,Default,,0,0,0,,Түсіну керек, Ангелиза ханшайым.
Dialogue: 0,0:19:32.91,0:19:36.66,Default,,0,0,0,,Дүниенің бәрін алып кетіп, жер түбіне құлатса,
Dialogue: 0,0:19:37.29,0:19:38.45,Default,,0,0,0,,Менің ашуым!
Dialogue: 0,0:19:38.75,0:19:39.50,Default,,0,0,0,,Уф
Dialogue: 0,0:19:41.91,0:19:43.00,Default,,0,0,0,,Сен менсің
Dialogue: 0,0:19:43.95,0:19:47.62,Default,,0,0,0,,Сіз Эмбрионды өлтіріп, Либертасты сәтті етесіз.
Dialogue: 0,0:19:48.58,0:19:50.29,Default,,0,0,0,,Барлығын қайтару үшін!
Dialogue: 0,0:19:51.20,0:19:53.37,Default,,0,0,0,,Мен... Бұл менмін!
Dialogue: 0,0:19:56.70,0:20:00.41,Default,,0,0,0,,Өзіңді біреуге сеніп тапсыру бос нәрсе емес пе?
Dialogue: 0,0:20:02.08,0:20:04.87,Default,,0,0,0,,Ненің дұрыс екенін ешкім білмейді
Dialogue: 0,0:20:05.37,0:20:08.12,Default,,0,0,0,,Бірақ мен сенің бұл әрекетіңді жек көремін!
Dialogue: 0,0:20:08.62,0:20:10.70,Default,,0,0,0,,Алектра Мария фон Лебенгерц!
Dialogue: 0,0:20:11.08,0:20:12.62,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:20:19.29,0:20:19.91,Default,,0,0,0,,Уф
Dialogue: 0,0:20:20.37,0:20:23.29,Default,,0,0,0,,Ах ха ха...
Dialogue: 0,0:20:23.41,0:20:27.37,Default,,0,0,0,,Уф... неге, неге екенін білмеймін
Dialogue: 0,0:20:28.25,0:20:32.12,Default,,0,0,0,,Кафе Анджды өзіңіз жасағандай жасай алмайсыз.
Dialogue: 0,0:20:32.62,0:20:33.41,Default,,0,0,0,,Не?
Dialogue: 0,0:20:34.08,0:20:36.16,Default,,0,0,0,,Тоқта, Джил.
Dialogue: 0,0:20:36.83,0:20:38.66,Default,,0,0,0,,Бұл сіздің жоғалтыңыз.
Dialogue: 0,0:20:39.75,0:20:42.50,Default,,0,0,0,,А... уф
Dialogue: 0,0:20:49.83,0:20:51.83,Default,,0,0,0,,Біз не істеуіміз керек? Бұдан былай
Dialogue: 0,0:20:52.37,0:20:53.33,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:20:53.70,0:20:54.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:54.58,0:20:56.91,Default,,0,0,0,,Ол кісінің әдісі қате болды, бірақ
Dialogue: 0,0:20:57.50,0:21:00.08,Default,,0,0,0,,Өйткені, Норманы босату керек.
Dialogue: 0,0:21:01.08,0:21:03.70,Default,,0,0,0,,Мен Либертас жасаймын.
Dialogue: 0,0:21:04.41,0:21:05.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:05.33,0:21:09.66,Default,,0,0,0,,Маған сенетіндермен және мен сенетіндермен
Dialogue: 0,0:21:26.20,0:21:28.91,Default,,0,0,0,,Уау, әдемі аспан
Dialogue: 0,0:21:31.08,0:21:34.87,Default,,0,0,0,,Енді, Тасуку, мен атып, Саракоға баруым керек.
Dialogue: 0,0:21:34.95,0:21:35.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:35.79,0:21:39.66,Default,,0,0,0,,Вилкис шымшып қалмаса секіре алмайды! Асықшы!
Dialogue: 0,0:21:39.91,0:21:41.33,Default,,0,0,0,,CRT шеберханасының жартылай жұмысшысы…
Dialogue: 0,0:21:41.54,0:21:43.12,Default,,0,0,0,,Онда мен істеймін!
Dialogue: 0,0:21:43.66,0:21:44.29,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:44.54,0:21:44.95,Default,,0,0,0,,Ах
Dialogue: 0,0:21:46.91,0:21:48.58,Default,,0,0,0,,Енді ше? Ахх
Dialogue: 0,0:22:00.87,0:22:02.91,Default,,0,0,0,,Сен осында болдың, Андж.
Dialogue: 0,0:22:03.16,0:22:08.95,Default,,0,0,0,,Түннің сары шымылдығында адасқан
Dialogue: 0,0:22:09.12,0:22:14.58,Default,,0,0,0,,Мен ренжіп қалатын сияқтымын
Dialogue: 0,0:22:14.91,0:22:20.70,Default,,0,0,0,,Жүрексіздіктің қайта-қайта толқыны жұтылды
Dialogue: 0,0:22:20.87,0:22:26.20,Default,,0,0,0,,Мен қайшылықты тыныштық іздедім.
Dialogue: 0,0:22:26.33,0:22:31.95,Default,,0,0,0,,Дем ала алмайтындай мені қинайтын шындық
Dialogue: 0,0:22:32.04,0:22:38.04,Default,,0,0,0,,Шындық әрқашан қатып қалады
Dialogue: 0,0:22:38.12,0:22:43.87,Default,,0,0,0,,Жалындаған ғашықтықтай арман болт
Dialogue: 0,0:22:44.12,0:22:49.95,Default,,0,0,0,,Бұл денені күйдіріп, аспанды шуылдатыңыз
Dialogue: 0,0:22:50.04,0:22:53.00,Default,,0,0,0,,Ешкім білмейтін қараңғылықтың арғы жағында
Dialogue: 0,0:22:53.08,0:23:00.16,Default,,0,0,0,,Басын іздеп, Айқайлай берем
Dialogue: 0,0:23:00.29,0:23:01.29,Default,,0,0,0,,Ол келгенше...
Dialogue: 0,0:23:01.37,0:23:07.50,Default,,0,0,0,,Жұмбақ жарқыраған – аты жоқ жұлдыз
Dialogue: 0,0:23:07.58,0:23:13.66,Default,,0,0,0,,Уақыт лабиринтіндегі орнымды жоғалтып алсам да
Dialogue: 0,0:23:13.75,0:23:16.54,Default,,0,0,0,,Көңілсіз есте қалды
Dialogue: 0,0:23:16.62,0:23:23.58,Default,,0,0,0,,Сүйкімді күлкі сені мәңгілікке жетелейді
Dialogue: 0,0:23:23.66,0:23:32.58,Default,,0,0,0,,Жаңа әлемге
Dialogue: 0,0:23:34.00,0:23:35.62,Default,,0,0,0,,Мен семіз емеспін!
Dialogue: 0,0:23:35.75,0:23:37.66,Default,,0,0,0,,Тоқта, осыған ашуланып қашып кеттің бе?
Dialogue: 0,0:23:38.08,0:23:40.12,Default,,0,0,0,,Мен ешқашан қайта шыға алмаймын ба?
Dialogue: 0,0:23:40.41,0:23:41.91,Default,,0,0,0,,Ей, мені де ал!
Dialogue: 0,0:23:42.00,0:23:44.70,Default,,0,0,0,,Семіз десең солай болады, бақа бақа бақа!
Dialogue: 0,0:23:44.83,0:23:46.20,Default,,0,0,0,,Хилда Мен жылап жатырмын...
Dialogue: 0,0:23:47.70,0:23:53.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory