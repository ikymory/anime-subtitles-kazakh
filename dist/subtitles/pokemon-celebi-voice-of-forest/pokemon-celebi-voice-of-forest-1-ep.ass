Dialogue: 0,0:48:38.45,0:48:39.66,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:48:39.75,0:48:40.91,Default,,0,0,0,,Ол тірі
Dialogue: 0,0:48:41.00,0:48:42.04,Default,,0,0,0,,Мен де
Dialogue: 0,0:48:42.12,0:48:44.04,Default,,0,0,0,,Me too Pika
Dialogue: 0,0:48:44.92,0:48:46.04,Default,,0,0,0,,Әже
Dialogue: 0,0:48:46.13,0:48:48.80,Default,,0,0,0,,Сіз қарттарға қамқорлық жасайсыз ба?
Dialogue: 0,0:48:51.09,0:48:53.38,Default,,0,0,0,,Кез келген жағдайда тоқтатылуы керек
Dialogue: 0,0:48:57.01,0:49:00.10,Default,,0,0,0,,Мияулардың қолында мен оны басқара алмаймын.
Dialogue: 0,0:49:00.18,0:49:02.77,Default,,0,0,0,,Тохохо… Мусаши…
Dialogue: 0,0:49:08.82,0:49:10.90,Default,,0,0,0,,Пикачу 10 адам болттары
Dialogue: 0,0:49:10.99,0:49:12.99,Default,,0,0,0,,Пикачу!
Dialogue: 0,0:49:13.74,0:49:14.74,Default,,0,0,0,,Ha
Dialogue: 0,0:49:16.03,0:49:18.62,Default,,0,0,0,,Челеби, олардың аузын жап.
Dialogue: 0,0:49:20.50,0:49:22.50,Default,,0,0,0,,Ооо
Dialogue: 0,0:49:25.83,0:49:27.50,Default,,0,0,0,,Ах пип пика
Dialogue: 0,0:49:28.38,0:49:29.92,Default,,0,0,0,,Do it, Селеби
Dialogue: 0,0:49:35.34,0:49:36.76,Default,,0,0,0,,Сатоси!
Dialogue: 0,0:49:50.94,0:49:53.65,Default,,0,0,0,,Бұл солтүстік желдің бейнесі
Dialogue: 0,0:49:53.74,0:49:54.74,Default,,0,0,0,,Суйкун
Dialogue: 0,0:50:00.58,0:50:01.58,Default,,0,0,0,,Га
Dialogue: 0,0:50:06.12,0:50:08.29,Default,,0,0,0,,Сен маған күшіңді бересің бе?
Dialogue: 0,0:50:08.38,0:50:09.67,Default,,0,0,0,,Ау
Dialogue: 0,0:50:10.09,0:50:12.59,Default,,0,0,0,,Бізді Челебиге апарыңыз.
Dialogue: 0,0:50:12.67,0:50:14.09,Default,,0,0,0,,Ау~
Dialogue: 0,0:50:15.55,0:50:16.55,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:50:16.63,0:50:19.68,Default,,0,0,0,,Мен де сол Суикюнді өзімдікі етемін!
Dialogue: 0,0:50:22.10,0:50:23.18,Default,,0,0,0,,Ах... Пика
Dialogue: 0,0:50:24.48,0:50:27.98,Default,,0,0,0,,(Бангираның күркіреуі)
Dialogue: 0,0:50:28.06,0:50:30.86,Default,,0,0,0,,Баңгиралар жасайды
Dialogue: 0,0:50:31.90,0:50:34.19,Default,,0,0,0,,Мені жіберіңіз, мен жұмыс істеймін!
Dialogue: 0,0:50:38.99,0:50:42.20,Default,,0,0,0,,Ива~
Dialogue: 0,0:50:48.96,0:50:50.84,Default,,0,0,0,,Iwa…
Dialogue: 0,0:50:56.26,0:50:57.26,Default,,0,0,0,,Ha
Dialogue: 0,0:51:00.68,0:51:03.47,Default,,0,0,0,,Челеби... Челеби!
Dialogue: 0,0:51:17.45,0:51:19.16,Default,,0,0,0,,Ива~
Dialogue: 0,0:51:26.75,0:51:29.08,Default,,0,0,0,,Ива~
Dialogue: 0,0:51:31.75,0:51:33.84,Default,,0,0,0,,Ива~
Dialogue: 0,0:51:45.01,0:51:47.81,Default,,0,0,0,,Ива~!
Dialogue: 0,0:51:53.56,0:51:56.36,Default,,0,0,0,,Ива~
Dialogue: 0,0:51:57.78,0:51:59.70,Default,,0,0,0,,Жақсы орындадым
Dialogue: 0,0:52:01.91,0:52:05.16,Default,,0,0,0,,Хмф, ебедейсіз бәйбішелер.
Dialogue: 0,0:52:05.45,0:52:06.66,Default,,0,0,0,,Челеби
Dialogue: 0,0:52:08.20,0:52:10.62,Default,,0,0,0,,Абайлаңыз, Сатоши-кун, Юкинари-кун
Dialogue: 0,0:52:10.71,0:52:12.08,Default,,0,0,0,,Кимоноым шаңмен кірленді.
Dialogue: 0,0:52:12.17,0:52:14.09,Default,,0,0,0,,Суикун Au
Dialogue: 0,0:52:14.17,0:52:16.92,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:52:23.80,0:52:24.80,Default,,0,0,0,,Гау
Dialogue: 0,0:52:29.48,0:52:31.10,Default,,0,0,0,,(Суйкуненің ыңырсыуы)
Dialogue: 0,0:52:31.64,0:52:33.69,Default,,0,0,0,,Жақсы, жаса, Челеби.
Dialogue: 0,0:52:37.11,0:52:38.32,Default,,0,0,0,,(Суйкуненің айқайы)
Dialogue: 0,0:52:38.40,0:52:40.19,Default,,0,0,0,,Уау, жылтыр
Dialogue: 0,0:52:41.11,0:52:43.78,Default,,0,0,0,,Хахахахахахахаха
Dialogue: 0,0:52:43.87,0:52:46.24,Default,,0,0,0,,Маған бағынбағандар осылай болады.
Dialogue: 0,0:52:46.33,0:52:48.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:48.58,0:52:50.87,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,0:52:51.16,0:52:53.67,Default,,0,0,0,,Хмм
Dialogue: 0,0:52:54.67,0:52:57.96,Default,,0,0,0,,Мықты бол, Челеби бұдан артық.
Dialogue: 0,0:52:58.05,0:53:00.34,Default,,0,0,0,,Кешіріңіз, рахмет
Dialogue: 0,0:53:00.42,0:53:01.72,Default,,0,0,0,,Пика
Dialogue: 0,0:53:04.01,0:53:08.26,Default,,0,0,0,,Ах, Кодзиро мен Миов, сен не істеп жатырсың?
Dialogue: 0,0:53:13.44,0:53:15.19,Default,,0,0,0,,Тоқта, Челеби!
Dialogue: 0,0:53:15.27,0:53:17.73,Default,,0,0,0,,Сіз мұндай нәрсені жасайтын адам емессіз!
Dialogue: 0,0:53:17.82,0:53:19.86,Default,,0,0,0,,Челеби!
Dialogue: 0,0:53:24.24,0:53:25.87,Default,,0,0,0,,Ара~
Dialogue: 0,0:53:33.87,0:53:36.92,Default,,0,0,0,,Би... Би!
Dialogue: 0,0:53:37.59,0:53:40.25,Default,,0,0,0,,Челеби, не істеп жатырсың? Оны орындаңыз
Dialogue: 0,0:53:40.59,0:53:42.80,Default,,0,0,0,,Би...
Dialogue: 0,0:53:44.80,0:53:47.09,Default,,0,0,0,,(Суйкуненің ыңырсыуы)
Dialogue: 0,0:53:47.76,0:53:49.43,Default,,0,0,0,,Уф
Dialogue: 0,0:53:49.51,0:53:52.73,Default,,0,0,0,,Челеби: Біз доспыз ғой?
Dialogue: 0,0:53:52.81,0:53:54.27,Default,,0,0,0,,Біз дос емеспіз бе?
Dialogue: 0,0:53:54.35,0:53:55.85,Default,,0,0,0,,Пика!
Dialogue: 0,0:53:58.44,0:54:01.48,Default,,0,0,0,,Bi~! B...
Dialogue: 0,0:54:01.69,0:54:03.24,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:54:03.32,0:54:06.41,Default,,0,0,0,,Челеби, өзіңді есіңе ал!
Dialogue: 0,0:54:06.78,0:54:08.53,Default,,0,0,0,,(Мусашидің ырылдауы)
Dialogue: 0,0:54:08.62,0:54:09.83,Default,,0,0,0,,Не болды? Челеби
Dialogue: 0,0:54:13.54,0:54:16.75,Default,,0,0,0,,Би... Би!
Dialogue: 0,0:54:21.59,0:54:23.01,Default,,0,0,0,,Челеби...
Dialogue: 0,0:54:24.01,0:54:30.01,Default,,0,0,0,,(Покемон айқайлары)
Dialogue: 0,0:54:31.22,0:54:35.98,Default,,0,0,0,,(Покемон айқайлары)
Dialogue: 0,0:54:37.90,0:54:39.73,Default,,0,0,0,,(Челебидің ыңырануы)
Dialogue: 0,0:54:39.98,0:54:45.36,Default,,0,0,0,,(Юкинари Сатошидің ырылдауы)
Dialogue: 0,0:54:45.44,0:54:50.32,Default,,0,0,0,,(Покемон айқайлары)
Dialogue: 0,0:54:52.16,0:54:55.08,Default,,0,0,0,,Челеби, бұл менмін, есіңде болсын.
Dialogue: 0,0:54:56.75,0:54:59.21,Default,,0,0,0,,Bi…bi?
Dialogue: 0,0:54:59.58,0:55:00.58,Default,,0,0,0,,Бит
Dialogue: 0,0:55:00.79,0:55:04.05,Default,,0,0,0,,Уау, пи~ка
Dialogue: 0,0:55:08.80,0:55:11.35,Default,,0,0,0,,Уау, пи~ка...
Dialogue: 0,0:55:11.43,0:55:13.68,Default,,0,0,0,,Уау! Пи~ка~!
Dialogue: 0,0:55:16.06,0:55:17.48,Default,,0,0,0,,Мен сенемін
Dialogue: 0,0:55:23.69,0:55:25.86,Default,,0,0,0,,Челеби Пика
Dialogue: 0,0:55:25.94,0:55:29.11,Default,,0,0,0,,Челеби, өзіңе қайта оралшы.
Dialogue: 0,0:55:29.20,0:55:30.24,Default,,0,0,0,,Уау
Dialogue: 0,0:55:32.20,0:55:34.12,Default,,0,0,0,,Челеби
Dialogue: 0,0:55:40.50,0:55:44.34,Default,,0,0,0,,(Сатоши мен оның достары ыңылайды)
Dialogue: 0,0:55:44.88,0:55:49.26,Default,,0,0,0,,(Сатоши мен оның достарының күлкісі)
Dialogue: 0,0:55:52.18,0:55:53.18,Default,,0,0,0,,Би…
Dialogue: 0,0:55:56.72,0:55:57.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:59.10,0:56:00.27,Default,,0,0,0,,Не?
Dialogue: 0,0:56:02.44,0:56:04.61,Default,,0,0,0,,Бұл ақымақ, олай болуы мүмкін емес...
Dialogue: 0,0:56:04.69,0:56:05.69,Default,,0,0,0,,Ах
Dialogue: 0,0:56:06.65,0:56:08.03,Default,,0,0,0,,Би...
Dialogue: 0,0:56:09.82,0:56:11.11,Default,,0,0,0,,Bi~?
Dialogue: 0,0:56:11.32,0:56:13.16,Default,,0,0,0,,Челеби Пика
Dialogue: 0,0:56:13.24,0:56:14.49,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:56:16.12,0:56:17.12,Default,,0,0,0,,Уау
Dialogue: 0,0:56:22.29,0:56:25.17,Default,,0,0,0,,Увааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:56:25.38,0:56:26.50,Default,,0,0,0,,Ах
Dialogue: 0,0:56:27.88,0:56:29.09,Default,,0,0,0,,Мусаши
Dialogue: 0,0:56:29.17,0:56:30.47,Default,,0,0,0,,Аня ня~
Dialogue: 0,0:56:41.23,0:56:42.27,Default,,0,0,0,,Би…
Dialogue: 0,0:56:53.20,0:56:54.24,Default,,0,0,0,,О
Dialogue: 0,0:56:54.32,0:56:55.37,Default,,0,0,0,,Уау
Dialogue: 0,0:56:55.45,0:56:58.24,Default,,0,0,0,,Би~ (2 адам) Уф
Dialogue: 0,0:57:04.42,0:57:07.75,Default,,0,0,0,,(Тәкеши мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:57:11.38,0:57:14.72,Default,,0,0,0,,(Тәкеши мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:57:16.30,0:57:17.85,Default,,0,0,0,,Жақсы
Dialogue: 0,0:57:17.93,0:57:19.43,Default,,0,0,0,,Жарайсыңдар
Dialogue: 0,0:57:19.52,0:57:21.60,Default,,0,0,0,,Өте жақсы орындалған
Dialogue: 0,0:57:27.06,0:57:28.44,Default,,0,0,0,,Не болды?
Dialogue: 0,0:57:28.73,0:57:31.40,Default,,0,0,0,,Челеби... Челеби...
Dialogue: 0,0:57:37.58,0:57:38.95,Default,,0,0,0,,Ах
Dialogue: 0,0:57:39.03,0:57:41.04,Default,,0,0,0,,Су. Егер сіз оны суға салсаңыз.
Dialogue: 0,0:57:47.79,0:57:49.13,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:57:49.21,0:57:50.59,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:57:50.92,0:57:55.68,Default,,0,0,0,,Орманды жойғандықтан, Өмір көлі де өліп жатыр.
Dialogue: 0,0:57:55.76,0:57:57.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:57:57.55,0:57:59.01,Default,,0,0,0,,Суикун туралы не деуге болады?
Dialogue: 0,0:57:59.22,0:58:02.60,Default,,0,0,0,,Эй, Суйкуненің суды тазартатын күші бар, солай ма?
Dialogue: 0,0:58:02.68,0:58:06.19,Default,,0,0,0,,Суйкуне, өтінемін, көл суын тазалаңыз.
Dialogue: 0,0:58:07.31,0:58:11.28,Default,,0,0,0,,(Суйкуненің айқайы)
Dialogue: 0,0:58:41.89,0:58:43.93,Default,,0,0,0,,Уау... мен жасадым.
Dialogue: 0,0:58:44.02,0:58:46.31,Default,,0,0,0,,Бұл Суйкуненің күші
Dialogue: 0,0:58:51.52,0:58:54.49,Default,,0,0,0,,Челеби Бұл таза су.
Dialogue: 0,0:58:55.61,0:58:56.78,Default,,0,0,0,,Пика? (2 адам) А
Dialogue: 0,0:59:01.41,0:59:02.62,Default,,0,0,0,,Бұл жақсы емес пе...
Dialogue: 0,0:59:05.41,0:59:07.96,Default,,0,0,0,,Челеби, сен өле алмайсың.
Dialogue: 0,0:59:14.34,0:59:19.76,Default,,0,0,0,,Ей, міне сенің сүйікті ағашыңның жемісі. Жеңдер.
Dialogue: 0,0:59:28.35,0:59:30.90,Default,,0,0,0,,Тамақ ал, а...
Dialogue: 0,0:59:34.98,0:59:36.36,Default,,0,0,0,,Челеби...
Dialogue: 0,0:59:42.49,0:59:44.20,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:59:55.30,0:59:56.80,Default,,0,0,0,,Пикер…
Dialogue: 0,1:00:00.55,1:00:02.76,Default,,0,0,0,,Челеби жаман емес.
Dialogue: 0,1:00:03.55,1:00:07.27,Default,,0,0,0,,Челебиді қолдан жасап, орманды жойған адамдар.
Dialogue: 0,1:00:07.98,1:00:10.02,Default,,0,0,0,,Кінәлі Челеби емес.
Dialogue: 0,1:00:10.94,1:00:14.44,Default,,0,0,0,,Бірақ... Бірақ неге...
Dialogue: 0,1:00:15.36,1:00:18.53,Default,,0,0,0,,Неліктен Челеби өлуі керек!
Dialogue: 0,1:00:22.32,1:00:25.70,Default,,0,0,0,,Уф уф...
Dialogue: 0,1:00:29.62,1:00:36.55,Default,,0,0,0,,(Мику жылайды)
Dialogue: 0,1:00:36.63,1:00:42.38,Default,,0,0,0,,(Покемон айқайлары)
Dialogue: 0,1:00:42.93,1:00:44.47,Default,,0,0,0,,(Суйкуненің айқайы)
Dialogue: 0,1:00:44.55,1:00:51.56,Default,,0,0,0,,(Покемон айқайлары)
Dialogue: 0,1:01:09.37,1:01:10.37,Default,,0,0,0,,Ах (Төгепі) Тұншыға?
Dialogue: 0,1:01:10.87,1:01:11.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:12.16,1:01:13.17,Default,,0,0,0,,Пика? иә?
Dialogue: 0,1:01:13.67,1:01:19.25,Default,,0,0,0,,(ағаш резонансы)
Dialogue: 0,1:01:25.68,1:01:26.72,Default,,0,0,0,,Бұл...
Dialogue: 0,1:01:26.80,1:01:29.93,Default,,0,0,0,,Токиватари… Токиватари дыбысы
Dialogue: 0,1:02:50.89,1:02:53.43,Default,,0,0,0,,Бит? B~
Dialogue: 0,1:02:53.52,1:02:55.81,Default,,0,0,0,,Би… Би?
Dialogue: 0,1:03:02.77,1:03:05.53,Default,,0,0,0,,Би... Би!
Dialogue: 0,1:03:06.36,1:03:08.32,Default,,0,0,0,,Шокепи~
Dialogue: 0,1:03:08.57,1:03:14.20,Default,,0,0,0,,Орманның қамқоршы құдайы орманға өмір сыйлап, уақытты кесіп өтеді.
Dialogue: 0,1:03:14.91,1:03:17.41,Default,,0,0,0,,Челебидің достары болған, солай ма?
Dialogue: 0,1:03:17.50,1:03:18.87,Default,,0,0,0,,Пика
Dialogue: 0,1:03:18.96,1:03:21.46,Default,,0,0,0,,Біз үшін де (Такеши Касуми) Иә.
Dialogue: 0,1:03:21.96,1:03:22.96,Default,,0,0,0,,Хэхе хаха
Dialogue: 0,1:03:23.88,1:03:25.88,Default,,0,0,0,,Би… Би~
Dialogue: 0,1:03:26.17,1:03:27.30,Default,,0,0,0,,Би~
Dialogue: 0,1:03:35.18,1:03:38.23,Default,,0,0,0,,Bi~!
Dialogue: 0,1:03:51.82,1:03:54.83,Default,,0,0,0,,Би~ Би~
Dialogue: 0,1:03:55.37,1:03:56.83,Default,,0,0,0,,Леви~
Dialogue: 0,1:03:57.66,1:03:58.91,Default,,0,0,0,,Би~
Dialogue: 0,1:04:04.13,1:04:07.63,Default,,0,0,0,,Сәлем! Пика
Dialogue: 0,1:04:11.22,1:04:12.72,Default,,0,0,0,,Би~
Dialogue: 0,1:04:14.30,1:04:17.14,Default,,0,0,0,,Пи~ка~! Эй!
Dialogue: 0,1:04:22.02,1:04:24.52,Default,,0,0,0,,Би~
Dialogue: 0,1:04:27.03,1:04:29.28,Default,,0,0,0,,Уааа би… би…
Dialogue: 0,1:04:29.36,1:04:30.49,Default,,0,0,0,,Әй, Челеби!
Dialogue: 0,1:04:31.82,1:04:35.12,Default,,0,0,0,,Бұл менікі. Мен оны ешкімге бермеймін.
Dialogue: 0,1:04:35.66,1:04:37.37,Default,,0,0,0,,Сіз бұған жол бересіз бе?
Dialogue: 0,1:04:38.95,1:04:40.62,Default,,0,0,0,,(Челебидің ыңырануы)
Dialogue: 0,1:04:40.71,1:04:41.79,Default,,0,0,0,,Уф
Dialogue: 0,1:04:46.38,1:04:47.92,Default,,0,0,0,,Сатоси!
Dialogue: 0,1:04:48.71,1:04:51.05,Default,,0,0,0,,Уф...
Dialogue: 0,1:04:51.38,1:04:52.68,Default,,0,0,0,,Босатыңыз
Dialogue: 0,1:04:52.76,1:04:54.76,Default,,0,0,0,,Мен жіберуім керек пе?
Dialogue: 0,1:04:55.64,1:04:57.64,Default,,0,0,0,,Пикачу 10 адам болттары
Dialogue: 0,1:04:57.72,1:05:00.23,Default,,0,0,0,,Пикапика... Сіз не істейсіз?
Dialogue: 0,1:05:00.31,1:05:02.56,Default,,0,0,0,,Шайнаңыз! Апыр-ай!
Dialogue: 0,1:05:06.19,1:05:09.03,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,1:05:09.40,1:05:10.86,Default,,0,0,0,,Пикапи!
Dialogue: 0,1:05:10.94,1:05:12.28,Default,,0,0,0,,Пикачу
Dialogue: 0,1:05:12.36,1:05:13.95,Default,,0,0,0,,Ой...
Dialogue: 0,1:05:16.62,1:05:18.79,Default,,0,0,0,,Уау! Пика!
Dialogue: 0,1:05:20.79,1:05:21.79,Default,,0,0,0,,Иә? Pi?
Dialogue: 0,1:05:22.29,1:05:23.37,Default,,0,0,0,,Пика?
Dialogue: 0,1:05:24.42,1:05:26.29,Default,,0,0,0,,Би~ Челеби
Dialogue: 0,1:05:26.38,1:05:29.55,Default,,0,0,0,,Егер біз оған қалағанын істеуге мүмкіндік берсек —
Dialogue: 0,1:05:31.09,1:05:33.51,Default,,0,0,0,,Әй, эй!
Dialogue: 0,1:05:34.34,1:05:36.68,Default,,0,0,0,,Пикачу! Сатоши!
Dialogue: 0,1:05:37.01,1:05:38.22,Default,,0,0,0,,Эй
Dialogue: 0,1:05:38.97,1:05:41.27,Default,,0,0,0,,Уф аа
Dialogue: 0,1:05:42.14,1:05:44.14,Default,,0,0,0,,Уф ааа... уф
Dialogue: 0,1:05:44.23,1:05:46.81,Default,,0,0,0,,Уф, Атта, Ах, Уау.
Dialogue: 0,1:05:46.90,1:05:49.90,Default,,0,0,0,,Ах, а, а...
Dialogue: 0,1:05:50.65,1:05:52.82,Default,,0,0,0,,(Китамура) Жарайды, Сатору, енді уақыты келген сияқты.
Dialogue: 0,1:05:53.03,1:05:54.03,Default,,0,0,0,,Уф
Dialogue: 0,1:05:54.32,1:05:55.32,Default,,0,0,0,,Уау
Dialogue: 0,1:05:55.70,1:06:00.33,Default,,0,0,0,,Сен сияқты ақымақтарға мен сенің өзегіңді қайта оқытамын.
Dialogue: 0,1:06:00.41,1:06:04.16,Default,,0,0,0,,(Покемонның айқайы)
Dialogue: 0,1:06:04.25,1:06:06.50,Default,,0,0,0,,Нейра Хассам
Dialogue: 0,1:06:06.96,1:06:10.00,Default,,0,0,0,,Иә? Ах, у... а? Жоқ
Dialogue: 0,1:06:10.30,1:06:11.55,Default,,0,0,0,,Уф...
Dialogue: 0,1:06:11.80,1:06:13.38,Default,,0,0,0,,Эмма! Рэй!
Dialogue: 0,1:06:13.67,1:06:14.93,Default,,0,0,0,,Бірақ Рух толқыны — жанның көрінісі
Dialogue: 0,1:06:16.64,1:06:17.93,Default,,0,0,0,,(Зұлымның ыңырсыуы)
Dialogue: 0,1:06:18.18,1:06:20.85,Default,,0,0,0,,Уаааааааааааааааааааааааааа
Dialogue: 0,1:06:21.35,1:06:26.27,Default,,0,0,0,,Орман мені кешірмейтін сияқты Ахахахаха
Dialogue: 0,1:06:29.90,1:06:32.19,Default,,0,0,0,,Рахмет Суйкуне
Dialogue: 0,1:06:32.69,1:06:34.74,Default,,0,0,0,,Бір күні тағы кездесейік
Dialogue: 0,1:06:34.82,1:06:36.61,Default,,0,0,0,,Пика~
Dialogue: 0,1:06:51.25,1:06:53.21,Default,,0,0,0,,Бит?
Dialogue: 0,1:07:00.35,1:07:01.39,Default,,0,0,0,,Би~
Dialogue: 0,1:07:01.47,1:07:01.76,Default,,0,0,0,,(Ағаш резонансы)
Dialogue: 0,1:07:01.76,1:07:04.31,Default,,0,0,0,,Өзгеріс жасауға тырысу
Dialogue: 0,1:07:04.31,1:07:04.77,Default,,0,0,0,,(ағаш резонансы)
Dialogue: 0,1:07:04.77,1:07:07.48,Default,,0,0,0,,Бәлкім, сізді бұрынғы дәуіріңізге қайтару үшін.
Dialogue: 0,1:07:07.48,1:07:08.06,Default,,0,0,0,,Бәлкім, сізді бұрынғы дәуіріңізге қайтарады.
Dialogue: 0,1:07:08.77,1:07:11.44,Default,,0,0,0,,Мені өзіңізбен бірге алып кетесіз бе?
Dialogue: 0,1:07:11.52,1:07:12.61,Default,,0,0,0,,Би
Dialogue: 0,1:07:15.49,1:07:17.15,Default,,0,0,0,,Бар, Юкинари
Dialogue: 0,1:07:17.78,1:07:19.07,Default,,0,0,0,,Сатоси
Dialogue: 0,1:07:19.74,1:07:23.87,Default,,0,0,0,,Қай жерде болсақ та, қай дәуірде болсақ та—
Dialogue: 0,1:07:23.95,1:07:27.41,Default,,0,0,0,,Біз мәңгі дос болдық
Dialogue: 0,1:07:28.54,1:07:29.54,Default,,0,0,0,,Иә
Dialogue: 0,1:07:38.13,1:07:40.84,Default,,0,0,0,,Сатосиге рахмет
Dialogue: 0,1:07:41.14,1:07:42.76,Default,,0,0,0,,Және барлығы
Dialogue: 0,1:07:43.14,1:07:46.27,Default,,0,0,0,,Біз мәңгілік...
Dialogue: 0,1:07:47.23,1:07:48.31,Default,,0,0,0,,Юкинари!
Dialogue: 0,1:07:55.86,1:07:59.15,Default,,0,0,0,,Чип! Чип, чип, чип, чип!
Dialogue: 0,1:07:59.78,1:08:02.66,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:08:16.51,1:08:18.67,Default,,0,0,0,,Пикапи?
Dialogue: 0,1:08:41.20,1:08:47.20,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,1:08:52.75,1:08:53.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:55.59,1:08:56.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:57.21,1:08:58.26,Default,,0,0,0,,Ах
Dialogue: 0,1:08:59.80,1:09:01.55,Default,,0,0,0,,Не болды? бала
Dialogue: 0,1:09:03.72,1:09:05.01,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:09:13.31,1:09:15.11,Default,,0,0,0,,Мен түс көрдім
Dialogue: 0,1:09:16.48,1:09:18.48,Default,,0,0,0,,Өте жақсы түс көр
Dialogue: 0,1:09:25.12,1:09:26.99,Default,,0,0,0,,Ах~
Dialogue: 0,1:09:27.83,1:09:29.45,Default,,0,0,0,,Менің жинақтағы ақшамнан тек 285 йен ғана қалды!
Dialogue: 0,1:09:29.91,1:09:33.75,Default,,0,0,0,,Денемдегі барлық дерт басылды.
Dialogue: 0,1:09:33.83,1:09:37.00,Default,,0,0,0,,Бұл көл денеге пайдалы, солай ма?
Dialogue: 0,1:09:37.09,1:09:38.34,Default,,0,0,0,,Сәлем?
Dialogue: 0,1:09:39.13,1:09:41.26,Default,,0,0,0,,Мусаши, мен көмектесуге келдім.
Dialogue: 0,1:09:41.34,1:09:43.05,Default,,0,0,0,,Мынаны айдаңыз
Dialogue: 0,1:09:43.13,1:09:45.64,Default,,0,0,0,,Балалар, тым кеш.
Dialogue: 0,1:09:45.72,1:09:48.64,Default,,0,0,0,,Мен олар кеткенше тығылдым, ня.
Dialogue: 0,1:09:48.72,1:09:49.76,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:09:49.85,1:09:51.43,Default,,0,0,0,,(Бангираның күркіреуі)
Dialogue: 0,1:09:51.52,1:09:53.60,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,1:10:08.24,1:10:10.24,Default,,0,0,0,,Ня? Бұл су...
Dialogue: 0,1:10:10.33,1:10:11.49,Default,,0,0,0,,Бұл рас.
Dialogue: 0,1:10:11.58,1:10:13.79,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,1:10:16.21,1:10:19.67,Default,,0,0,0,,Бірдеңе...
Dialogue: 0,1:10:19.75,1:10:23.88,Default,,0,0,0,,Жақсы көрінеді!
Dialogue: 0,1:10:32.81,1:10:38.44,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:15:00.37,1:15:06.37,Default,,0,0,0,,~♪
Dialogue: 0,1:15:07.87,1:15:13.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory