Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.46,0:00:15.09,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:00:29.02,0:00:30.03,Default,,0,0,0,,Бит
Dialogue: 0,0:00:36.66,0:00:38.91,Default,,0,0,0,,Bippi Bippi
Dialogue: 0,0:00:44.62,0:00:45.62,Default,,0,0,0,,Тозақ
Dialogue: 0,0:00:45.92,0:00:46.92,Default,,0,0,0,,Бит
Dialogue: 0,0:00:49.84,0:00:51.30,Default,,0,0,0,,(Ереуіл)
Dialogue: 0,0:00:51.38,0:00:54.13,Default,,0,0,0,,Б-б-б-б... шуш шуш
Dialogue: 0,0:00:55.68,0:00:57.64,Default,,0,0,0,,Bippi Bippi
Dialogue: 0,0:01:09.94,0:01:11.40,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:01:19.07,0:01:21.70,Default,,0,0,0,,Сен орманға барасың ба? иә?
Dialogue: 0,0:01:22.37,0:01:25.33,Default,,0,0,0,,Хо хо хо хо ха
Dialogue: 0,0:01:27.42,0:01:30.13,Default,,0,0,0,,Орманның даусын естісең, қозғалма.
Dialogue: 0,0:01:30.21,0:01:31.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:31.30,0:01:33.01,Default,,0,0,0,,Бұл ауыл туралы аңыз.
Dialogue: 0,0:01:33.59,0:01:35.63,Default,,0,0,0,,Орманның дауыстары қандай?
Dialogue: 0,0:01:35.72,0:01:39.39,Default,,0,0,0,,Кейде мен біртүрлі дыбыстарды естимін.
Dialogue: 0,0:01:39.68,0:01:41.76,Default,,0,0,0,,Бұл орманның қамқоршысы.
Dialogue: 0,0:01:41.85,0:01:44.39,Default,,0,0,0,,Оны кесіп өткенде шығатын дыбыс дейді.
Dialogue: 0,0:01:44.89,0:01:47.14,Default,,0,0,0,,Токиватари? Иә
Dialogue: 0,0:01:47.23,0:01:51.02,Default,,0,0,0,,Орманды қорғаушы тәңірінің уақыттан асып түсетін құдіреті бар сияқты.
Dialogue: 0,0:01:51.36,0:01:52.44,Default,,0,0,0,,А...
Dialogue: 0,0:01:52.90,0:01:55.78,Default,,0,0,0,,Ұстап қалмау және басқа дәуірге апару.
Dialogue: 0,0:01:55.86,0:01:59.95,Default,,0,0,0,,Орманның даусын естісең, қимыл жасама, жарай ма?
Dialogue: 0,0:02:00.32,0:02:03.04,Default,,0,0,0,,Иә мен абай боламын Иә
Dialogue: 0,0:02:03.41,0:02:05.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:05.70,0:02:07.29,Default,,0,0,0,,О, сен бе?
Dialogue: 0,0:02:07.37,0:02:08.71,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:02:10.63,0:02:13.96,Default,,0,0,0,,Мынаны же, мен жасаған нан.
Dialogue: 0,0:02:14.05,0:02:16.55,Default,,0,0,0,,Ол орман жаңғақтарына толы.
Dialogue: 0,0:02:18.05,0:02:19.05,Default,,0,0,0,,Иә
Dialogue: 0,0:02:19.55,0:02:21.39,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:36.82,0:02:37.90,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:39.28,0:02:40.57,Default,,0,0,0,,Отачи…
Dialogue: 0,0:02:42.20,0:02:43.28,Default,,0,0,0,,Бит
Dialogue: 0,0:02:45.16,0:02:46.54,Default,,0,0,0,,Шайя
Dialogue: 0,0:02:47.37,0:02:48.37,Default,,0,0,0,,Тозақ
Dialogue: 0,0:02:51.08,0:02:52.88,Default,,0,0,0,,Б… Бибі… Шайя
Dialogue: 0,0:02:53.88,0:02:54.88,Default,,0,0,0,,Бит
Dialogue: 0,0:02:55.30,0:03:01.30,Default,,0,0,0,,(Мотоцикл қозғалтқышының дыбысы)
Dialogue: 0,0:03:05.22,0:03:08.18,Default,,0,0,0,,Мен оны Убаме орманында сағындым, бірақ...
Dialogue: 0,0:03:08.64,0:03:10.10,Default,,0,0,0,,Бүгін емес.
Dialogue: 0,0:03:12.35,0:03:13.36,Default,,0,0,0,,Бит
Dialogue: 0,0:03:13.69,0:03:16.19,Default,,0,0,0,,Менің қашып кетуіме жол берме. Мені қу!
Dialogue: 0,0:03:24.20,0:03:26.54,Default,,0,0,0,,Леви~!
Dialogue: 0,0:03:27.83,0:03:31.08,Default,,0,0,0,,Хана? Хана
Dialogue: 0,0:03:33.50,0:03:39.26,Default,,0,0,0,,(Покемон айқайлары)
Dialogue: 0,0:03:39.34,0:03:40.34,Default,,0,0,0,,Ах
Dialogue: 0,0:03:44.55,0:03:45.64,Default,,0,0,0,,Уау
Dialogue: 0,0:03:47.77,0:03:48.77,Default,,0,0,0,,Тозақ
Dialogue: 0,0:03:49.98,0:03:51.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:59.28,0:04:00.28,Default,,0,0,0,,Ах
Dialogue: 0,0:04:04.95,0:04:08.12,Default,,0,0,0,,Тоқта, 1-ге 2 деген қорқақтық.
Dialogue: 0,0:04:08.20,0:04:09.66,Default,,0,0,0,,Вау
Dialogue: 0,0:04:10.20,0:04:11.21,Default,,0,0,0,,Бит
Dialogue: 0,0:04:12.75,0:04:15.50,Default,,0,0,0,,(Гельгардың ырылдауын ұру)
Dialogue: 0,0:04:15.58,0:04:16.79,Default,,0,0,0,,Би…
Dialogue: 0,0:04:21.38,0:04:23.72,Default,,0,0,0,,Би~
Dialogue: 0,0:04:27.10,0:04:28.56,Default,,0,0,0,,Маған сол Челебиді беріңіз
Dialogue: 0,0:04:29.14,0:04:31.52,Default,,0,0,0,,Челеби Бұл...
Dialogue: 0,0:04:31.85,0:04:33.56,Default,,0,0,0,,Неліктен мұндай қорқынышты әрекетке барар едің?
Dialogue: 0,0:04:34.02,0:04:35.73,Default,,0,0,0,,Мен аңшымын
Dialogue: 0,0:04:35.81,0:04:40.99,Default,,0,0,0,,Менің бизнесім – сирек кездесетін Покемондарды ұстап, оларды жоғары бағаға сату.
Dialogue: 0,0:04:41.32,0:04:43.40,Default,,0,0,0,,Покемон сатып алуға немесе сатуға арналған нәрсе емес.
Dialogue: 0,0:04:43.82,0:04:46.45,Default,,0,0,0,,Оны маған беріңіз. Сіз оны маған бересіз бе?
Dialogue: 0,0:04:59.67,0:05:02.34,Default,,0,0,0,,Bi~! (ағаштардың резонансты дыбысы)
Dialogue: 0,0:05:10.93,0:05:12.31,Default,,0,0,0,,Бұл дыбыс...
Dialogue: 0,0:05:12.77,0:05:14.10,Default,,0,0,0,,Кетчуппен бүтіндей бүркелген—
Dialogue: 0,0:05:17.40,0:05:19.19,Default,,0,0,0,,Bi~!
Dialogue: 0,0:06:12.24,0:06:13.54,Default,,0,0,0,,Уф
Dialogue: 0,0:06:14.54,0:06:15.54,Default,,0,0,0,,Уф
Dialogue: 0,0:06:15.62,0:06:17.37,Default,,0,0,0,,Сіз 40 жыл бұрын
Dialogue: 0,0:06:17.46,0:06:22.00,Default,,0,0,0,,Маған Челеби қолға түскен орманның орнын айтыңызшы.
Dialogue: 0,0:06:22.09,0:06:26.01,Default,,0,0,0,,Бұл менің олжам. Басқа ешкімге айтпаймын.
Dialogue: 0,0:06:26.30,0:06:28.84,Default,,0,0,0,,Я, бұл қыңыр.
Dialogue: 0,0:06:28.93,0:06:33.85,Default,,0,0,0,,(Покемон айқайлары)
Dialogue: 0,0:06:37.35,0:06:38.98,Default,,0,0,0,,Ху (Аңшы) Ах.
Dialogue: 0,0:06:39.39,0:06:40.90,Default,,0,0,0,,Ньяра
Dialogue: 0,0:06:41.65,0:06:42.86,Default,,0,0,0,,Нейра
Dialogue: 0,0:06:51.99,0:06:53.12,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:53.20,0:06:54.95,Default,,0,0,0,,Қараңғы шар (Аңшы) Не?
Dialogue: 0,0:06:55.20,0:06:57.58,Default,,0,0,0,,Қараңғы допқа барыңыз
Dialogue: 0,0:07:04.13,0:07:07.76,Default,,0,0,0,,Бұл зұлымдықты ұстаған барлық Покемонды бояйды.
Dialogue: 0,0:07:07.84,0:07:11.30,Default,,0,0,0,,Қуатты барынша арттыруға болады
Dialogue: 0,0:07:11.55,0:07:14.60,Default,,0,0,0,,Шықыңдар, зұлым Бангиралар!
Dialogue: 0,0:07:21.31,0:07:23.52,Default,,0,0,0,,(Бангираның күркіреуі)
Dialogue: 0,0:07:23.94,0:07:25.19,Default,,0,0,0,,Жою
Dialogue: 0,0:07:40.79,0:07:44.00,Default,,0,0,0,,(Бангираның күркіреуі)
Dialogue: 0,0:07:44.46,0:07:47.38,Default,,0,0,0,,Міне... менің Баңғирасым...
Dialogue: 0,0:07:47.46,0:07:51.13,Default,,0,0,0,,Эй, о... тоқташы өтінемін.
Dialogue: 0,0:07:51.68,0:07:55.39,Default,,0,0,0,,Айтшы... Мен орманның қайда екенін айтайын.
Dialogue: 0,0:07:55.47,0:07:56.85,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,0:07:56.93,0:08:02.94,Default,,0,0,0,,(Жауыздың күлкісі)
Dialogue: 0,0:08:52.15,0:08:55.49,Default,,0,0,0,,(кеме ысқырығы)
Dialogue: 0,0:08:55.57,0:08:59.28,Default,,0,0,0,,Сатоси және оның достары Джохто лигасына қатысу мақсатымен саяхаттарын жалғастыруда.
Dialogue: 0,0:08:59.37,0:09:03.41,Default,,0,0,0,,Мен келесі қалаға бет алған лайнердің айлағында болдым.
Dialogue: 0,0:09:04.33,0:09:07.29,Default,,0,0,0,,Дегенмен, кеменің кететін уақыты аз қалды...
Dialogue: 0,0:09:07.38,0:09:08.75,Default,,0,0,0,,Сатоси мен Пикачу —
Dialogue: 0,0:09:08.84,0:09:12.01,Default,,0,0,0,,Қанша уақыт өтсе де, қайтып оралмады.
Dialogue: 0,0:09:12.21,0:09:14.93,Default,,0,0,0,,Енді Сатоши, сен қайда ойнайсың?
Dialogue: 0,0:09:15.01,0:09:16.64,Default,,0,0,0,,Чогепи~
Dialogue: 0,0:09:16.72,0:09:17.89,Default,,0,0,0,,Кробатқа өтіңіз
Dialogue: 0,0:09:20.93,0:09:22.93,Default,,0,0,0,,Кробат…
Dialogue: 0,0:09:28.11,0:09:30.73,Default,,0,0,0,,Жарайды, мен Масала қаласынан Сатошимін.
Dialogue: 0,0:09:30.82,0:09:32.23,Default,,0,0,0,,Шайқасқа келгенде мұны істеу керек.
Dialogue: 0,0:09:32.78,0:09:34.82,Default,,0,0,0,,Қарсылас кім болса да, мен қашпаймын.
Dialogue: 0,0:09:34.90,0:09:35.90,Default,,0,0,0,,Пика
Dialogue: 0,0:09:36.45,0:09:37.61,Default,,0,0,0,,Ято өледі
Dialogue: 0,0:09:39.20,0:09:40.87,Default,,0,0,0,,Аллигатор
Dialogue: 0,0:09:42.58,0:09:45.58,Default,,0,0,0,,Аллигаттар? Қарсыластың кемшілігі жоқ.
Dialogue: 0,0:09:45.66,0:09:47.54,Default,,0,0,0,,Жарайды, Пикачу.
Dialogue: 0,0:09:47.62,0:09:49.00,Default,,0,0,0,,Жүр! Пика
Dialogue: 0,0:09:49.08,0:09:55.09,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:10:59.65,0:11:01.49,Default,,0,0,0,,(кеме ысқырығы)
Dialogue: 0,0:12:01.09,0:12:07.10,Default,,0,0,0,,~♪
Dialogue: 0,0:12:07.18,0:12:12.27,Default,,0,0,0,,(кеме ысқырығы)
Dialogue: 0,0:12:12.73,0:12:16.19,Default,,0,0,0,,Эй, Сатоши Покемон шебері болуды мақсат етеді.
Dialogue: 0,0:12:16.48,0:12:17.57,Default,,0,0,0,,Иә
Dialogue: 0,0:12:17.65,0:12:20.49,Default,,0,0,0,,Осы өзеннің жоғары жағындағы менің ауылымның орманында...
Dialogue: 0,0:12:20.57,0:12:22.32,Default,,0,0,0,,Покемон көп.
Dialogue: 0,0:12:22.40,0:12:25.53,Default,,0,0,0,,Уайт мырза, мені сол орманға апарыңызшы.
Dialogue: 0,0:12:25.62,0:12:26.62,Default,,0,0,0,,...
Dialogue: 0,0:12:26.87,0:12:27.53,Default,,0,0,0,,Мен осы жерден қайығыма ауысамын, менің артымнан жүріңіз.
Dialogue: 0,0:12:27.53,0:12:28.54,Default,,0,0,0,,Осыдан кейін біз менің қайығыма ауысамыз. Менімен жүр, Пи?
Dialogue: 0,0:12:28.54,0:12:29.83,Default,,0,0,0,,Мен қазірден бастап қайығыма ауысамын. Маған жазыл.
Dialogue: 0,0:12:29.91,0:12:31.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:32.04,0:12:34.12,Default,,0,0,0,,Пика иә?
Dialogue: 0,0:12:37.46,0:12:39.80,Default,,0,0,0,,Бұл Покемон ба?
Dialogue: 0,0:12:39.88,0:12:41.30,Default,,0,0,0,,Сіз твит жазып жатырсыз.
Dialogue: 0,0:12:41.38,0:12:44.09,Default,,0,0,0,,Покемонды бірінші рет көріп тұрғаныма сене алар емеспін.
Dialogue: 0,0:12:47.30,0:12:50.64,Default,,0,0,0,,Бұл Сатоси көрген Покемон ба?
Dialogue: 0,0:12:50.72,0:12:52.85,Default,,0,0,0,,Иә, солай болды.
Dialogue: 0,0:12:53.19,0:12:54.48,Default,,0,0,0,,Бұл Суикун
Dialogue: 0,0:12:54.94,0:12:56.31,Default,,0,0,0,,Суйкуне?
Dialogue: 0,0:12:56.40,0:12:57.90,Default,,0,0,0,,Бұл қандай Покемон?
Dialogue: 0,0:12:58.52,0:13:02.07,Default,,0,0,0,,Бұл аңызға айналған Покемон болғандықтан, біз бұл туралы көп білмейміз.
Dialogue: 0,0:13:02.49,0:13:03.49,Default,,0,0,0,,Бірақ Суйкуне...
Dialogue: 0,0:13:03.57,0:13:05.91,Default,,0,0,0,,Бұл «солтүстік желдің реинкарнациясы» деп айтылады—
Dialogue: 0,0:13:05.99,0:13:08.95,Default,,0,0,0,,Оның лас суды тазартатын күші бар сияқты.
Dialogue: 0,0:13:09.41,0:13:11.62,Default,,0,0,0,,«Солтүстік желдің реинкарнациясы»?
Dialogue: 0,0:13:11.70,0:13:14.46,Default,,0,0,0,,Мен сені тағы көргім келеді, Пика~
Dialogue: 0,0:13:14.54,0:13:18.75,Default,,0,0,0,,«Солтүстік жел соққанда, мен Суикюнені кездестіремін».
Dialogue: 0,0:13:18.84,0:13:20.38,Default,,0,0,0,,Ал ше? Бұл фраза
Dialogue: 0,0:13:20.46,0:13:23.01,Default,,0,0,0,,Жабысқақ~ (Окидо) Уау
Dialogue: 0,0:13:23.22,0:13:24.97,Default,,0,0,0,,Бето~ (Окидо) Тоқтатыңыз Бетобетон
Dialogue: 0,0:13:25.05,0:13:29.18,Default,,0,0,0,,Олай болса, барлығыңыз сақ болыңыздар.
Dialogue: 0,0:13:30.81,0:13:32.89,Default,,0,0,0,,Ахахаха Онда кездескенше
Dialogue: 0,0:13:37.10,0:13:38.69,Default,,0,0,0,,Суикюнден басқа —
Dialogue: 0,0:13:38.77,0:13:41.11,Default,,0,0,0,,Сирек кездесетіндері көбірек болуы мүмкін.
Dialogue: 0,0:13:41.19,0:13:42.69,Default,,0,0,0,,Көңілім көтеріліп барады.
Dialogue: 0,0:13:46.82,0:13:49.62,Default,,0,0,0,,Джарибойлар қайда барса да...
Dialogue: 0,0:13:49.70,0:13:51.66,Default,,0,0,0,,Зымыран командасы соңынан ереді.
Dialogue: 0,0:13:51.74,0:13:54.87,Default,,0,0,0,,Пикачу, мен оны ұстамайынша берілмеймін, ня
Dialogue: 0,0:13:54.96,0:13:56.08,Default,,0,0,0,,Бірақ мен педальді тым қатты басқанмын...
Dialogue: 0,0:13:56.16,0:13:58.75,Default,,0,0,0,,Аяғыңыз қалыңдап кетсе не істеу керек?
Dialogue: 0,0:13:58.83,0:14:01.92,Default,,0,0,0,,Енді жоқ, мен тоқтай алмаймын.
Dialogue: 0,0:14:02.13,0:14:06.30,Default,,0,0,0,,(Мусашидің айқайы)
Dialogue: 0,0:14:06.38,0:14:10.76,Default,,0,0,0,,(Мусашидің айқайы)
Dialogue: 0,0:14:21.73,0:14:23.28,Default,,0,0,0,,Уайт мырза
Dialogue: 0,0:14:23.61,0:14:25.49,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:14:27.53,0:14:29.11,Default,,0,0,0,,Ах, Пика
Dialogue: 0,0:14:44.59,0:14:46.30,Default,,0,0,0,,Уау...
Dialogue: 0,0:14:50.89,0:14:53.39,Default,,0,0,0,,Міне, келдік. Қайда?
Dialogue: 0,0:14:54.26,0:14:55.93,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:14:58.06,0:14:59.69,Default,,0,0,0,,Бұл ағаш үй.
Dialogue: 0,0:14:59.77,0:15:00.85,Default,,0,0,0,,Kepi~
Dialogue: 0,0:15:00.94,0:15:02.77,Default,,0,0,0,,Біздің ауыл – Хатено ауылы.
Dialogue: 0,0:15:23.08,0:15:25.63,Default,,0,0,0,,Күте тұрыңыз, иә?
Dialogue: 0,0:15:26.67,0:15:29.92,Default,,0,0,0,,Сіз бейкүнә көрінесіз, бірақ орманға барасыз ба?
Dialogue: 0,0:15:30.22,0:15:31.93,Default,,0,0,0,,Иә
Dialogue: 0,0:15:32.01,0:15:33.97,Default,,0,0,0,,Әжеңіздің әңгімесін тыңдаңыз
Dialogue: 0,0:15:34.05,0:15:35.81,Default,,0,0,0,,Әрине
Dialogue: 0,0:15:35.89,0:15:38.18,Default,,0,0,0,,Мен әлемдегі ең жақсы покемон өсірушісімін.
Dialogue: 0,0:15:38.27,0:15:40.10,Default,,0,0,0,,Бұл көздеген Такеши
Dialogue: 0,0:15:40.19,0:15:42.73,Default,,0,0,0,,Күрсіну... Атыңызды айтыңызшы.
Dialogue: 0,0:15:42.81,0:15:44.02,Default,,0,0,0,,Мен Микумын
Dialogue: 0,0:15:44.11,0:15:45.15,Default,,0,0,0,,Әже
Dialogue: 0,0:15:45.23,0:15:47.86,Default,,0,0,0,,Мен әрқашан осы орманның кіреберісін күзететінмін.
Dialogue: 0,0:15:48.19,0:15:50.45,Default,,0,0,0,,Егер сіз орманның дауысын естісеңіз,
Dialogue: 0,0:15:50.53,0:15:54.28,Default,,0,0,0,,Ол кезде ешқашан орнынан қозғалмаңыз.
Dialogue: 0,0:15:54.78,0:15:57.45,Default,,0,0,0,,Орман дауысы? Бұл ауыл аңыз
Dialogue: 0,0:15:57.95,0:16:01.87,Default,,0,0,0,,Орманда адасып қалғың келмесе, аңыз бойынша жүр.
Dialogue: 0,0:16:02.29,0:16:05.09,Default,,0,0,0,,Жарайды, онда тезірек барайық.
Dialogue: 0,0:16:05.17,0:16:06.67,Default,,0,0,0,,Кеттік, Пикачу, Пика
Dialogue: 0,0:16:06.75,0:16:09.26,Default,,0,0,0,,Мику-сан, кешкі асты бірге ішейік...
Dialogue: 0,0:16:09.34,0:16:09.76,Default,,0,0,0,,Иә, иә, асығайық.
Dialogue: 0,0:16:09.76,0:16:11.51,Default,,0,0,0,,Иә, иә, асығайық. А, а, атта, атататата...
Dialogue: 0,0:16:20.89,0:16:23.60,Default,,0,0,0,,Орманда көп дауыс бар
Dialogue: 0,0:16:23.69,0:16:27.15,Default,,0,0,0,,Желдің дыбысы, ағаштың дыбысы, судың дыбысы
Dialogue: 0,0:16:27.69,0:16:30.07,Default,,0,0,0,,Және Покемонның айқайы
Dialogue: 0,0:16:30.15,0:16:35.41,Default,,0,0,0,,(ағаштар резонансы)
Dialogue: 0,0:16:35.49,0:16:38.58,Default,,0,0,0,,Бұл... орманның дауысы ма?
Dialogue: 0,0:16:38.66,0:16:39.70,Default,,0,0,0,,Міне, Пика
Dialogue: 0,0:16:39.79,0:16:40.79,Default,,0,0,0,,Сатоси
Dialogue: 0,0:16:40.87,0:16:43.25,Default,,0,0,0,,Ей, қозғалмағаның дұрыс...
Dialogue: 0,0:16:55.59,0:16:56.85,Default,,0,0,0,,Ах
Dialogue: 0,0:17:04.77,0:17:09.40,Default,,0,0,0,,B… B… B…
Dialogue: 0,0:17:14.36,0:17:15.57,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,0:17:16.32,0:17:18.16,Default,,0,0,0,,Мен тірімін, о
Dialogue: 0,0:17:18.45,0:17:20.37,Default,,0,0,0,,Мику мен басқаларға апарайық.
Dialogue: 0,0:17:20.45,0:17:21.58,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:22.00,0:17:23.33,Default,,0,0,0,,Би…
Dialogue: 0,0:17:23.62,0:17:26.17,Default,,0,0,0,,Дәл қазір бұл жарық қандай болды?
Dialogue: 0,0:17:27.71,0:17:33.05,Default,,0,0,0,,Мику-сан! Мику-сан, сен осындасың ба?
Dialogue: 0,0:17:33.51,0:17:35.43,Default,,0,0,0,,Мику-сан!
Dialogue: 0,0:17:36.38,0:17:37.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:37.80,0:17:39.51,Default,,0,0,0,,Сіз байқаған сияқтысыз.
Dialogue: 0,0:17:42.31,0:17:45.44,Default,,0,0,0,,Мықты бол, жақсысың ба? Пика?
Dialogue: 0,0:17:45.89,0:17:48.94,Default,,0,0,0,,Ах у... аа уаа
Dialogue: 0,0:17:49.02,0:17:50.11,Default,,0,0,0,,Уау
Dialogue: 0,0:17:50.19,0:17:52.36,Default,,0,0,0,,Се... Челеби саған бермек пе?
Dialogue: 0,0:17:52.44,0:17:53.86,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:17:53.94,0:17:55.45,Default,,0,0,0,,Тоқта, тыныштал.
Dialogue: 0,0:17:55.53,0:17:57.16,Default,,0,0,0,,Екеуің де тынышталыңдар.
Dialogue: 0,0:17:57.24,0:17:59.03,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:18:00.49,0:18:03.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:03.33,0:18:05.66,Default,,0,0,0,,Міне, мен естігім келеді.
Dialogue: 0,0:18:05.75,0:18:06.75,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:06.83,0:18:09.63,Default,,0,0,0,,Бұл бала орманда жатқан.
Dialogue: 0,0:18:09.71,0:18:12.30,Default,,0,0,0,,Пами
Dialogue: 0,0:18:13.55,0:18:15.84,Default,,0,0,0,,Сіз...
Dialogue: 0,0:18:15.92,0:18:18.38,Default,,0,0,0,,Не? Жақсы
Dialogue: 0,0:18:18.59,0:18:20.18,Default,,0,0,0,,Жақсы
Dialogue: 0,0:18:20.85,0:18:23.43,Default,,0,0,0,,Әже, сіз бұл баланы танисыз ба?
Dialogue: 0,0:18:24.14,0:18:27.73,Default,,0,0,0,,Осыдан 40 жыл бұрын осы орманда жоғалып кеткен бала туралы...
Dialogue: 0,0:18:27.81,0:18:29.85,Default,,0,0,0,,Мен саған айттым ба?
Dialogue: 0,0:18:29.94,0:18:32.07,Default,,0,0,0,,Бұл бала болуы мүмкін бе?
Dialogue: 0,0:18:32.32,0:18:35.49,Default,,0,0,0,,Аа, сөзсіз.
Dialogue: 0,0:18:39.78,0:18:40.78,Default,,0,0,0,,Ах
Dialogue: 0,0:18:40.99,0:18:43.49,Default,,0,0,0,,Саған нан берген үлкен апа?
Dialogue: 0,0:18:47.62,0:18:52.09,Default,,0,0,0,,Бұл сіздің түсіргеніңіз емес пе?
Dialogue: 0,0:18:58.09,0:18:59.38,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:19:00.39,0:19:03.39,Default,,0,0,0,,Сіз апатқа ұшыраған болуыңыз керек.
Dialogue: 0,0:19:03.89,0:19:06.02,Default,,0,0,0,,Токиватари? не? ол
Dialogue: 0,0:19:06.10,0:19:10.48,Default,,0,0,0,,Бұл бала мұнда 40 жылдан астам уақыттан кейін пайда болды.
Dialogue: 0,0:19:10.56,0:19:11.98,Default,,0,0,0,,Өтірік? (Такеши Касуми) Иә?
Dialogue: 0,0:19:20.15,0:19:21.95,Default,,0,0,0,,Одо Одо
Dialogue: 0,0:19:31.46,0:19:33.84,Default,,0,0,0,,Челеби ше? Челеби қайда?
Dialogue: 0,0:19:33.92,0:19:35.00,Default,,0,0,0,,Челеби?
Dialogue: 0,0:19:35.09,0:19:37.13,Default,,0,0,0,,Менімен Покемон болды, солай ма?
Dialogue: 0,0:19:37.21,0:19:38.34,Default,,0,0,0,,Мен оны көрмедім...
Dialogue: 0,0:19:38.42,0:19:41.63,Default,,0,0,0,,Әй, сен Челебиді кездестірдің бе?
Dialogue: 0,0:19:41.72,0:19:42.80,Default,,0,0,0,,Иә
Dialogue: 0,0:19:43.18,0:19:45.64,Default,,0,0,0,,«Орман құдайы» деп атайтынымыз —
Dialogue: 0,0:19:45.72,0:19:47.39,Default,,0,0,0,,Сол туралы Челеби.
Dialogue: 0,0:19:47.97,0:19:51.52,Default,,0,0,0,,Орманды қорғаушы құдай Челеби орманға өмір береді.
Dialogue: 0,0:19:51.60,0:19:53.98,Default,,0,0,0,,Уақыт бойынша саяхаттау күші бар дейді.
Dialogue: 0,0:19:54.06,0:19:56.90,Default,,0,0,0,,Сіз бұл Покемонның күші уақыттан асып түседі дейсіз бе?
Dialogue: 0,0:19:56.98,0:19:57.98,Default,,0,0,0,,(Изуку) Урарака ханым. (Урарака) Иә!
Dialogue: 0,0:19:58.36,0:20:01.49,Default,,0,0,0,,Челеби орманның тереңіндегі «Өмір көлінде» жатыр.
Dialogue: 0,0:20:01.57,0:20:03.53,Default,,0,0,0,,Оның... өмір сүргені айтылды.
Dialogue: 0,0:20:03.62,0:20:06.66,Default,,0,0,0,,Токивакиді ешкім көрмеген.
Dialogue: 0,0:20:07.16,0:20:09.25,Default,,0,0,0,,Челеби ауыр жарақат алды.
Dialogue: 0,0:20:09.33,0:20:10.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:10.41,0:20:12.92,Default,,0,0,0,,Мен баруым керек, Челебиге көмектесуім керек.
Dialogue: 0,0:20:13.00,0:20:14.00,Default,,0,0,0,,Ат-ай!
Dialogue: 0,0:20:14.54,0:20:16.09,Default,,0,0,0,,Мен де Мен де
Dialogue: 0,0:20:16.17,0:20:17.63,Default,,0,0,0,,Шокепи~
Dialogue: 0,0:20:17.71,0:20:20.88,Default,,0,0,0,,Мен Такешимін, тамаша покемон өсірушімін
Dialogue: 0,0:20:20.97,0:20:24.09,Default,,0,0,0,,Мен Касуми, «әлемнің сұлу қызы» екенімді есте сақтаңыз.
Dialogue: 0,0:20:24.51,0:20:27.68,Default,,0,0,0,,Мен Сатошимін және мен Покемон шебері болуды мақсат етіп отырмын.
Dialogue: 0,0:20:27.76,0:20:28.97,Default,,0,0,0,,Пика
Dialogue: 0,0:20:29.06,0:20:30.73,Default,,0,0,0,,Бұл менің серіктесім
Dialogue: 0,0:20:30.81,0:20:31.85,Default,,0,0,0,,Пикачу
Dialogue: 0,0:20:32.81,0:20:34.60,Default,,0,0,0,,Мен Юкинаримін
Dialogue: 0,0:20:35.69,0:20:38.19,Default,,0,0,0,,Жоқ, сен бүгін де жақсы ұштың.
Dialogue: 0,0:20:38.27,0:20:40.57,Default,,0,0,0,,Ня, бұл әрқашан осылай болады, ня
Dialogue: 0,0:20:40.65,0:20:42.74,Default,,0,0,0,,Одан гөрі бұл қайда?
Dialogue: 0,0:20:42.82,0:20:44.82,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:20:44.91,0:20:45.91,Default,,0,0,0,,Ня? иә?
Dialogue: 0,0:20:47.12,0:20:48.45,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:48.87,0:20:50.62,Default,,0,0,0,,Жай Джарибой
Dialogue: 0,0:20:50.70,0:20:53.33,Default,,0,0,0,,Қай жерде құласаң, арғы жақтан келеді.
Dialogue: 0,0:20:53.41,0:20:55.63,Default,,0,0,0,,Мияулар әлі де твиттер жазуда.
Dialogue: 0,0:20:57.88,0:20:58.96,Default,,0,0,0,,Пика
Dialogue: 0,0:20:59.30,0:21:00.55,Default,,0,0,0,,Пикачу
Dialogue: 0,0:21:04.47,0:21:06.01,Default,,0,0,0,,Пика сол жерде
Dialogue: 0,0:21:12.23,0:21:13.89,Default,,0,0,0,,Покемондар жиналып жатыр
Dialogue: 0,0:21:17.36,0:21:18.44,Default,,0,0,0,,Мен де
Dialogue: 0,0:21:21.03,0:21:24.03,Default,,0,0,0,,Ууууууууууууууууууууууууууууууу...
Dialogue: 0,0:21:24.61,0:21:27.16,Default,,0,0,0,,Мәңкей сені ұятқа қалдырады (Төгепі) Шокепі~
Dialogue: 0,0:21:31.29,0:21:32.54,Default,,0,0,0,,Ах, Пика
Dialogue: 0,0:21:35.96,0:21:38.29,Default,,0,0,0,,Төменгі қабатта күткен дұрыс емес пе?
Dialogue: 0,0:21:38.38,0:21:40.29,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:21:40.38,0:21:43.92,Default,,0,0,0,,Челебиді қорғай алмағаным үшін жауаптымын.
Dialogue: 0,0:21:47.01,0:21:50.30,Default,,0,0,0,,Сен жақсы жігітсің, бірақ өзіңді қатты итерме.
Dialogue: 0,0:21:58.31,0:21:59.73,Default,,0,0,0,,(Покемон айқайлары)
Dialogue: 0,0:22:01.86,0:22:02.86,Default,,0,0,0,,Ах
Dialogue: 0,0:22:08.91,0:22:11.37,Default,,0,0,0,,Бұл Челеби ме? Иә
Dialogue: 0,0:22:11.45,0:22:12.45,Default,,0,0,0,,(Кристи) Ах! (Нат) Ах…
Dialogue: 0,0:22:12.54,0:22:13.62,Default,,0,0,0,,Би…
Dialogue: 0,0:22:14.41,0:22:15.79,Default,,0,0,0,,Уау
Dialogue: 0,0:22:16.33,0:22:18.04,Default,,0,0,0,,Уау...
Dialogue: 0,0:22:18.58,0:22:22.96,Default,,0,0,0,,Бұл оның әрекеті ме? Кууууууу!
Dialogue: 0,0:22:23.34,0:22:25.63,Default,,0,0,0,,Бұл еркектен гөрі окоризал.
Dialogue: 0,0:22:26.34,0:22:27.38,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:22:27.47,0:22:29.47,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,0:22:30.39,0:22:32.14,Default,,0,0,0,,Ой, неге?
Dialogue: 0,0:22:32.22,0:22:34.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:34.77,0:22:35.89,Default,,0,0,0,,Пикап
Dialogue: 0,0:22:35.98,0:22:37.60,Default,,0,0,0,,Жоқ, Пикачу, Пика?
Dialogue: 0,0:22:39.27,0:22:43.48,Default,,0,0,0,,Челебиге аңшы шабуыл жасап, жараланған...
Dialogue: 0,0:22:43.57,0:22:46.15,Default,,0,0,0,,Біз адамдардан қорқамыз.
Dialogue: 0,0:22:46.49,0:22:48.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:52.62,0:22:54.54,Default,,0,0,0,,Челеби жарайды
Dialogue: 0,0:22:55.37,0:22:57.33,Default,,0,0,0,,Өйткені біз сенің жаныңдамыз
Dialogue: 0,0:22:57.41,0:22:58.46,Default,,0,0,0,,Би...
Dialogue: 0,0:23:00.29,0:23:01.88,Default,,0,0,0,,Түсінбесеңіз жақсы.
Dialogue: 0,0:23:01.96,0:23:05.46,Default,,0,0,0,,Біз тек сенімен дос болғымыз келеді.
Dialogue: 0,0:23:05.55,0:23:06.55,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:23:07.59,0:23:08.59,Default,,0,0,0,,Бит?
Dialogue: 0,0:23:10.64,0:23:12.30,Default,,0,0,0,,Дос болайық
Dialogue: 0,0:23:12.76,0:23:13.93,Default,,0,0,0,,Челеби
Dialogue: 0,0:23:17.10,0:23:18.18,Default,,0,0,0,,Би…
Dialogue: 0,0:23:19.81,0:23:20.81,Default,,0,0,0,,Bi?
Dialogue: 0,0:23:30.70,0:23:33.07,Default,,0,0,0,,(Покемонның айқайы)
Dialogue: 0,0:23:35.91,0:23:37.41,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:23:37.70,0:23:38.70,Default,,0,0,0,,Бит
Dialogue: 0,0:23:40.33,0:23:41.71,Default,,0,0,0,,Би…
Dialogue: 0,0:23:47.30,0:23:48.88,Default,,0,0,0,,Өте әлсіз
Dialogue: 0,0:23:48.97,0:23:50.17,Default,,0,0,0,,Бұл Покемон орталығы.
Dialogue: 0,0:23:51.80,0:23:52.80,Default,,0,0,0,,Пика! Ах
Dialogue: 0,0:23:53.34,0:23:54.35,Default,,0,0,0,,Не?
Dialogue: 0,0:23:54.93,0:23:57.31,Default,,0,0,0,,Бұл не екенін сұрағанда
Dialogue: 0,0:23:57.39,0:23:59.81,Default,,0,0,0,,Мен саған жауап беремін, бірақ дүниенің рақымы
Dialogue: 0,0:23:59.89,0:24:02.23,Default,,0,0,0,,Дүниенің жойылуына жол бермеу
Dialogue: 0,0:24:02.31,0:24:04.65,Default,,0,0,0,,Дүние жүзіндегі бейбітшілікті қорғау
Dialogue: 0,0:24:04.73,0:24:07.23,Default,,0,0,0,,Махаббат пен шындық зұлымдықты тесіп өтеді
Dialogue: 0,0:24:07.32,0:24:09.69,Default,,0,0,0,,Керемет сүйкімді жауды қолдаушы
Dialogue: 0,0:24:09.78,0:24:11.78,Default,,0,0,0,,Кодзиро Мусаши
Dialogue: 0,0:24:12.28,0:24:15.32,Default,,0,0,0,,Зымыран командасының екі мүшесі галактика арқылы жүгіреді...
Dialogue: 0,0:24:15.41,0:24:18.62,Default,,0,0,0,,Ақ зал Аппақ ертең күтіп тұр
Dialogue: 0,0:24:18.70,0:24:20.50,Default,,0,0,0,,А... Мияу, мияу.
Dialogue: 0,0:24:20.58,0:24:22.71,Default,,0,0,0,,Сонанс
Dialogue: 0,0:24:22.92,0:24:24.75,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:24:26.67,0:24:27.84,Default,,0,0,0,,Біз асығып жатырмыз...
Dialogue: 0,0:24:27.92,0:24:30.80,Default,,0,0,0,,Ой, жарайды, жарайды.
Dialogue: 0,0:24:30.88,0:24:33.13,Default,,0,0,0,,Сәл күте тұрыңыз, Джарибой.
Dialogue: 0,0:24:33.22,0:24:34.97,Default,,0,0,0,,Оны елемеңіз
Dialogue: 0,0:24:35.05,0:24:37.51,Default,,0,0,0,,Сонанс
Dialogue: 0,0:24:38.06,0:24:39.93,Default,,0,0,0,,Сіз бас тартасыз.
Dialogue: 0,0:24:40.60,0:24:42.56,Default,,0,0,0,,Пиппипи Челеби, қолыңнан келгеннің бәрін істе
Dialogue: 0,0:24:42.64,0:24:43.64,Default,,0,0,0,,Ах
Dialogue: 0,0:24:44.15,0:24:45.31,Default,,0,0,0,,Тырнақтарыңды қадалама.
Dialogue: 0,0:24:47.61,0:24:48.65,Default,,0,0,0,,Не?
Dialogue: 0,0:24:50.28,0:24:52.32,Default,,0,0,0,,Сол Челебиді қалдыр.
Dialogue: 0,0:24:52.65,0:24:53.65,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:24:53.74,0:24:55.28,Default,,0,0,0,,Білудің қажеті жоқ
Dialogue: 0,0:24:55.36,0:24:56.45,Default,,0,0,0,,Ол жерден кет
Dialogue: 0,0:24:58.12,0:24:59.37,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:24:59.70,0:25:02.00,Default,,0,0,0,,Ньястың олжасын ұрлауды қалау.
Dialogue: 0,0:25:02.08,0:25:04.00,Default,,0,0,0,,Мен үшін уайымдама — тез арада көліктен шық
Dialogue: 0,0:25:05.79,0:25:07.79,Default,,0,0,0,,Муртадогас
Dialogue: 0,0:25:10.50,0:25:11.51,Default,,0,0,0,,Иә
Dialogue: 0,0:25:12.30,0:25:13.30,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:25:16.09,0:25:17.14,Default,,0,0,0,,(Бангираның күркіреуі)
Dialogue: 0,0:25:17.43,0:25:18.55,Default,,0,0,0,,Ах
Dialogue: 0,0:25:18.64,0:25:21.06,Default,,0,0,0,,Бангиралар... бірақ қалыпты емес
Dialogue: 0,0:25:21.35,0:25:22.89,Default,,0,0,0,,Жою
Dialogue: 0,0:25:26.06,0:25:27.27,Default,,0,0,0,,Уау
Dialogue: 0,0:25:27.65,0:25:31.03,Default,,0,0,0,,(Бангираның күркіреуі)
Dialogue: 0,0:25:31.28,0:25:32.36,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:25:32.74,0:25:34.03,Default,,0,0,0,,Касумиді таңдаңыз
Dialogue: 0,0:25:36.20,0:25:37.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:38.53,0:25:40.99,Default,,0,0,0,,Біз ұрлауға жол бермейміз.
Dialogue: 0,0:25:43.16,0:25:44.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:51.42,0:25:52.42,Default,,0,0,0,,Ал сендер ше?
Dialogue: 0,0:25:52.76,0:25:55.34,Default,,0,0,0,,Мына маска, сен...
Dialogue: 0,0:25:55.42,0:25:57.84,Default,,0,0,0,,Зұлым Покемон пайдаланушысы
Dialogue: 0,0:25:57.93,0:25:59.97,Default,,0,0,0,,Team Rocket тобының бас директоры...
Dialogue: 0,0:26:00.05,0:26:01.93,Default,,0,0,0,,Бетперде киген зұлым-сама!
Dialogue: 0,0:26:02.64,0:26:04.39,Default,,0,0,0,,Сіз де Team Rocketсыз ба?
Dialogue: 0,0:26:04.48,0:26:07.06,Default,,0,0,0,,А... Мен өте өкінемін.
Dialogue: 0,0:26:07.48,0:26:10.44,Default,,0,0,0,,Көптен бері сен туралы өсек естіп жүрмін.
Dialogue: 0,0:26:10.52,0:26:12.53,Default,,0,0,0,,Сізбен танысқаным мақтаныш
Dialogue: 0,0:26:12.98,0:26:13.99,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:26:15.11,0:26:16.11,Default,,0,0,0,,Ято өледі
Dialogue: 0,0:26:20.45,0:26:22.58,Default,,0,0,0,,Хассам (Невра) жүйкесі
Dialogue: 0,0:26:23.37,0:26:26.75,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:26:27.29,0:26:28.83,Default,,0,0,0,,Ах
Dialogue: 0,0:26:28.92,0:26:31.50,Default,,0,0,0,,Сатоши күт, Касуми-сан, менің аяғым...
Dialogue: 0,0:26:31.96,0:26:33.59,Default,,0,0,0,,Кешіріңіз, мен мұны ертерек жасадым.
Dialogue: 0,0:26:33.67,0:26:34.67,Default,,0,0,0,,Тұншығу?
Dialogue: 0,0:26:35.21,0:26:36.42,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:26:36.51,0:26:38.22,Default,,0,0,0,,Пипика, иә?
Dialogue: 0,0:26:38.30,0:26:39.34,Default,,0,0,0,,Бірдеңе келе жатыр
Dialogue: 0,0:26:43.26,0:26:45.56,Default,,0,0,0,,Жаңа қалпақ
Dialogue: 0,0:26:47.27,0:26:48.89,Default,,0,0,0,,Не?Бұл жігіттер
Dialogue: 0,0:26:48.98,0:26:50.06,Default,,0,0,0,,Сіз қуғыншы сияқтысыз.
Dialogue: 0,0:26:50.15,0:26:52.11,Default,,0,0,0,,Хассам (Невра) жүйкесі
Dialogue: 0,0:26:52.52,0:26:54.69,Default,,0,0,0,,Жарайды, мен шешемін.
Dialogue: 0,0:26:54.78,0:26:55.94,Default,,0,0,0,,Такеши-сан, өтінемін
Dialogue: 0,0:26:56.03,0:26:57.32,Default,,0,0,0,,А?
Dialogue: 0,0:26:58.49,0:26:59.86,Default,,0,0,0,,Мен де істеймін
Dialogue: 0,0:27:04.12,0:27:05.12,Default,,0,0,0,,Ha
Dialogue: 0,0:27:07.58,0:27:09.46,Default,,0,0,0,,кесіртке
Dialogue: 0,0:27:12.29,0:27:13.42,Default,,0,0,0,,шығанақ
Dialogue: 0,0:27:15.34,0:27:17.21,Default,,0,0,0,,Риза Риза Риза До
Dialogue: 0,0:27:18.59,0:27:20.89,Default,,0,0,0,,шығанақ... Га
Dialogue: 0,0:27:21.18,0:27:22.89,Default,,0,0,0,,Бауыр жапырағы кескіш
Dialogue: 0,0:27:23.22,0:27:24.22,Default,,0,0,0,,шығанақ
Dialogue: 0,0:27:24.31,0:27:25.31,Default,,0,0,0,,Ha
Dialogue: 0,0:27:27.35,0:27:29.81,Default,,0,0,0,,Бей шығанағы
Dialogue: 0,0:27:30.31,0:27:31.56,Default,,0,0,0,,Хассам
Dialogue: 0,0:27:33.19,0:27:34.27,Default,,0,0,0,,шығанақ
Dialogue: 0,0:27:35.98,0:27:37.82,Default,,0,0,0,,Ризза Ризза (Нейра) Мяу
Dialogue: 0,0:27:38.19,0:27:39.78,Default,,0,0,0,,Лизард!
Dialogue: 0,0:27:41.24,0:27:43.24,Default,,0,0,0,,Ха (Байлеф) Бей Бей
Dialogue: 0,0:27:43.66,0:27:44.66,Default,,0,0,0,,Бейлеф!
Dialogue: 0,0:27:44.74,0:27:48.00,Default,,0,0,0,,Сатоси Бір ғана нақты нәрсе бар. Алданбаңыз.
Dialogue: 0,0:27:48.25,0:27:49.25,Default,,0,0,0,,Иә
Dialogue: 0,0:27:49.87,0:27:53.42,Default,,0,0,0,,Бейлеф, зейінді шоғырландырыңыз, сонда сіз оны міндетті түрде көресіз.
Dialogue: 0,0:27:54.34,0:27:55.34,Default,,0,0,0,,шығанақ
Dialogue: 0,0:28:01.13,0:28:02.13,Default,,0,0,0,,Бей!
Dialogue: 0,0:28:04.35,0:28:07.39,Default,,0,0,0,,Бей Хассам
Dialogue: 0,0:28:08.68,0:28:10.35,Default,,0,0,0,,Жақсы, Бейлиф.
Dialogue: 0,0:28:10.43,0:28:11.81,Default,,0,0,0,,Жарайсың Сатоси
Dialogue: 0,0:28:11.89,0:28:14.44,Default,,0,0,0,,Жарайды, олардың тәрбиесі жақсы.
Dialogue: 0,0:28:14.81,0:28:16.27,Default,,0,0,0,,Мен келе жатырмын Юкинари, иә?
Dialogue: 0,0:28:16.36,0:28:18.11,Default,,0,0,0,,Жаңа, жаңа, жаңа!
Dialogue: 0,0:28:19.19,0:28:20.90,Default,,0,0,0,,кесіртке Цуцуки
Dialogue: 0,0:28:20.99,0:28:23.28,Default,,0,0,0,,Ризза нүктесі! (Невра) Жаңа
Dialogue: 0,0:28:25.12,0:28:27.37,Default,,0,0,0,,Сіздің кесірткеңіз де әдемі көрінеді.
Dialogue: 0,0:28:27.45,0:28:28.91,Default,,0,0,0,,Сатосиге рахмет
Dialogue: 0,0:28:41.59,0:28:44.93,Default,,0,0,0,,(Хассам Нейраның ыңырсыуы)
Dialogue: 0,0:28:45.01,0:28:46.55,Default,,0,0,0,,Раббым!
Dialogue: 0,0:28:46.64,0:28:48.39,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:28:48.47,0:28:50.60,Default,,0,0,0,,Бұлай болмаса қызық емес
Dialogue: 0,0:28:52.23,0:28:54.10,Default,,0,0,0,,Жақсы аулау.
Dialogue: 0,0:29:00.32,0:29:02.32,Default,,0,0,0,,(Челебидің ауыр тыныс алуы)
Dialogue: 0,0:29:02.90,0:29:04.74,Default,,0,0,0,,Бұл қай ауыл?
Dialogue: 0,0:29:06.62,0:29:07.74,Default,,0,0,0,,Пика?
Dialogue: 0,0:29:08.66,0:29:09.87,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:29:09.95,0:29:11.33,Default,,0,0,0,,Pi~
Dialogue: 0,0:29:13.71,0:29:16.33,Default,,0,0,0,,(Челебидің ауыр тыныс алуы)
Dialogue: 0,0:29:17.04,0:29:20.21,Default,,0,0,0,,Бір орнында тұрудың қажеті жоқ, тек алға ұмтылайық.
Dialogue: 0,0:29:20.30,0:29:21.42,Default,,0,0,0,,Пика
Dialogue: 0,0:29:25.93,0:29:28.10,Default,,0,0,0,,Рингма?
Dialogue: 0,0:29:28.18,0:29:31.18,Default,,0,0,0,,Химегума
Dialogue: 0,0:29:32.68,0:29:33.98,Default,,0,0,0,,Ол
Dialogue: 0,0:29:34.73,0:29:35.73,Default,,0,0,0,,Не?
Dialogue: 0,0:29:35.81,0:29:38.11,Default,,0,0,0,,«Мені артымнан жүр» деп тұрғандай сезінемін
Dialogue: 0,0:29:38.19,0:29:39.23,Default,,0,0,0,,Пика
Dialogue: 0,0:29:40.61,0:29:42.15,Default,,0,0,0,,Барайық
Dialogue: 0,0:29:56.62,0:29:57.63,Default,,0,0,0,,Одо
Dialogue: 0,0:29:58.83,0:29:59.84,Default,,0,0,0,,Одо
Dialogue: 0,0:29:59.92,0:30:01.17,Default,,0,0,0,,Аю
Dialogue: 0,0:30:01.88,0:30:02.88,Default,,0,0,0,,Тақ
Dialogue: 0,0:30:13.72,0:30:14.73,Default,,0,0,0,,О
Dialogue: 0,0:30:15.56,0:30:16.85,Default,,0,0,0,,О
Dialogue: 0,0:30:21.27,0:30:23.32,Default,,0,0,0,,Одо о
Dialogue: 0,0:30:23.57,0:30:24.65,Default,,0,0,0,,Тақ
Dialogue: 0,0:30:24.74,0:30:25.78,Default,,0,0,0,,Тати
Dialogue: 0,0:30:40.71,0:30:41.71,Default,,0,0,0,,Перфальді сызық
Dialogue: 0,0:30:51.60,0:30:55.18,Default,,0,0,0,,Бұл Това-сан айтып отырған «Өмір көлі» болуы мүмкін бе?
Dialogue: 0,0:30:55.27,0:30:56.27,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:30:56.89,0:30:59.69,Default,,0,0,0,,(Челебидің ауыр тыныс алуы)
Dialogue: 0,0:31:03.23,0:31:08.36,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:31:30.22,0:31:34.10,Default,,0,0,0,,Би~ Би~
Dialogue: 0,0:31:35.26,0:31:36.27,Default,,0,0,0,,Ах
Dialogue: 0,0:31:36.81,0:31:38.98,Default,,0,0,0,,Юкинари? Ах
Dialogue: 0,0:31:50.20,0:31:51.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:30.61,0:32:31.99,Default,,0,0,0,,Уау...
Dialogue: 0,0:32:32.70,0:32:33.82,Default,,0,0,0,,Уау...
Dialogue: 0,0:32:34.11,0:32:36.41,Default,,0,0,0,,Челеби жақсы көрінеді
Dialogue: 0,0:32:36.49,0:32:38.54,Default,,0,0,0,,Бұл рас, Пика~
Dialogue: 0,0:32:38.62,0:32:40.41,Default,,0,0,0,,Өмір көлі…
Dialogue: 0,0:32:40.50,0:32:41.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:32:41.71,0:32:44.71,Default,,0,0,0,,Бұл су Челебидің денесін емдейді.
Dialogue: 0,0:32:50.63,0:32:51.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:55.47,0:32:56.60,Default,,0,0,0,,Би~
Dialogue: 0,0:32:56.80,0:32:58.72,Default,,0,0,0,,Мұны Челеби жасады
Dialogue: 0,0:32:58.81,0:33:00.89,Default,,0,0,0,,Пикачу биті
Dialogue: 0,0:33:01.10,0:33:02.31,Default,,0,0,0,,Bi~
Dialogue: 0,0:33:02.39,0:33:06.06,Default,,0,0,0,,Биппи биппи~ Уау
Dialogue: 0,0:33:06.65,0:33:08.19,Default,,0,0,0,,Леви ~ Пика
Dialogue: 0,0:33:08.27,0:33:09.27,Default,,0,0,0,,Бит
Dialogue: 0,0:33:09.36,0:33:11.24,Default,,0,0,0,,Ахаха бип бип
Dialogue: 0,0:33:11.49,0:33:13.24,Default,,0,0,0,,Би~ (Касуми күлді)
Dialogue: 0,0:33:13.32,0:33:14.32,Default,,0,0,0,,Уау
Dialogue: 0,0:33:15.20,0:33:16.32,Default,,0,0,0,,B~
Dialogue: 0,0:33:20.87,0:33:22.08,Default,,0,0,0,,Үлкен уау
Dialogue: 0,0:33:22.16,0:33:24.12,Default,,0,0,0,,Би-би-би~
Dialogue: 0,0:33:24.21,0:33:25.62,Default,,0,0,0,,Уау
Dialogue: 0,0:33:26.17,0:33:27.17,Default,,0,0,0,,Жарайды
Dialogue: 0,0:33:33.42,0:33:38.35,Default,,0,0,0,,(Покемон айқайлары)
Dialogue: 0,0:33:55.03,0:33:58.91,Default,,0,0,0,,Хааааааааааааааааааааааааа
Dialogue: 0,0:33:58.99,0:34:00.95,Default,,0,0,0,,Би~ Би~ (Сатоши Юкинари) Уау
Dialogue: 0,0:34:05.08,0:34:06.08,Default,,0,0,0,,Сәлем! Сатоши!
Dialogue: 0,0:34:06.08,0:34:07.12,Default,,0,0,0,,Сәлем! Сатоши! Таңдаушы!
Dialogue: 0,0:34:07.12,0:34:07.21,Default,,0,0,0,,Таңдаушы!
Dialogue: 0,0:34:07.21,0:34:07.58,Default,,0,0,0,,Таңдаушы! Юкинари!
Dialogue: 0,0:34:07.58,0:34:09.67,Default,,0,0,0,,Юкинари!
Dialogue: 0,0:34:15.59,0:34:18.51,Default,,0,0,0,,Уау (Тогепидің айқайы)
Dialogue: 0,0:34:20.60,0:34:23.56,Default,,0,0,0,,Емделген Челеби
Dialogue: 0,0:34:23.64,0:34:25.14,Default,,0,0,0,,Леви~
Dialogue: 0,0:34:25.23,0:34:27.77,Default,,0,0,0,,Би~ (2 адам) Хахахаха...
Dialogue: 0,0:34:44.91,0:34:46.54,Default,,0,0,0,,Ауыл ана жақта.
Dialogue: 0,0:34:49.67,0:34:52.25,Default,,0,0,0,,Не…
Dialogue: 0,0:34:52.50,0:34:55.63,Default,,0,0,0,,Би~ Би~
Dialogue: 0,0:34:55.71,0:34:57.80,Default,,0,0,0,,Бит? Леви~
Dialogue: 0,0:35:02.51,0:35:03.51,Default,,0,0,0,,Бит?
Dialogue: 0,0:35:06.52,0:35:08.69,Default,,0,0,0,,Levy Levy Levy ~
Dialogue: 0,0:35:09.56,0:35:10.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:13.11,0:35:15.86,Default,,0,0,0,,Бұл өте жақсы!
Dialogue: 0,0:35:17.53,0:35:19.32,Default,,0,0,0,,Пика Иә
Dialogue: 0,0:35:19.78,0:35:21.11,Default,,0,0,0,,Жылтыр~
Dialogue: 0,0:35:23.45,0:35:26.12,Default,,0,0,0,,Иә, керемет дәмді
