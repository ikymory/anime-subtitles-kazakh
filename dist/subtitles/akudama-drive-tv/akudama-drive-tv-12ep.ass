Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.88,0:00:12.13,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:00:12.22,0:00:14.43,Default,,0,0,0,,Үлкен әпке Үлкен әпке!
Dialogue: 0,0:00:14.51,0:00:16.55,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:00:16.64,0:00:17.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:20.47,0:00:23.89,Default,,0,0,0,,Әпке, аға...
Dialogue: 0,0:00:23.98,0:00:26.44,Default,,0,0,0,,Ах... менің аяғым...
Dialogue: 0,0:00:26.52,0:00:29.77,Default,,0,0,0,,Ха...! Ол бұзылды, әпке. Не істеуім керек?
Dialogue: 0,0:00:30.86,0:00:33.74,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:00:33.82,0:00:37.91,Default,,0,0,0,,Бұл дұрыс емес! Әпкемнің аяғы тез жазылмайды.
Dialogue: 0,0:00:38.58,0:00:40.70,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,0:00:41.20,0:00:44.37,Default,,0,0,0,,Менің әпкем бұл қарқынмен өлмейді.
Dialogue: 0,0:00:47.96,0:00:51.21,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:01:00.10,0:01:02.22,Default,,0,0,0,,Шинкансен...
Dialogue: 0,0:01:02.31,0:01:05.06,Default,,0,0,0,,Ах, курьер.
Dialogue: 0,0:01:05.85,0:01:08.56,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:01:08.65,0:01:10.98,Default,,0,0,0,,Ах... (жалпы адам) Менің қолым...
Dialogue: 0,0:01:11.07,0:01:12.48,Default,,0,0,0,,Велосипед қауіпсіз.
Dialogue: 0,0:01:12.57,0:01:16.49,Default,,0,0,0,,Осындай уақытта велосипедке алаңдау қаншалықты ақымақтық?
Dialogue: 0,0:01:16.57,0:01:18.70,Default,,0,0,0,,Аузың жаман екен, қарғыс атқан әйел.
Dialogue: 0,0:01:18.78,0:01:22.41,Default,,0,0,0,,Иә, бұл өзара.
Dialogue: 0,0:01:22.49,0:01:27.46,Default,,0,0,0,,♪~
Dialogue: 0,0:02:47.45,0:02:52.46,Default,,0,0,0,,~♪
Dialogue: 0,0:02:56.59,0:02:59.34,Default,,0,0,0,,Ах... Шинкансен...
Dialogue: 0,0:02:59.42,0:03:02.22,Default,,0,0,0,,Сенпай, қанша тырыссаң да, бұл стратегия тым көп...
Dialogue: 0,0:03:02.30,0:03:04.39,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:03:04.47,0:03:05.81,Default,,0,0,0,,Тым көп емес
Dialogue: 0,0:03:05.89,0:03:06.72,Default,,0,0,0,,Босс
Dialogue: 0,0:03:06.81,0:03:08.56,Default,,0,0,0,,Енді біз⸺
Dialogue: 0,0:03:08.64,0:03:10.98,Default,,0,0,0,,Мына жерде көріп тұрған Акудама емес.
Dialogue: 0,0:03:11.73,0:03:16.15,Default,,0,0,0,,Олар Канто мен Кансайды шатасудың құйынына батырған зұлымдықтың бейнесі.
Dialogue: 0,0:03:16.23,0:03:20.32,Default,,0,0,0,,Бірақ, менің ойымша, жалпы Синкансенді мақсат ету тым қорқынышты...
Dialogue: 0,0:03:20.40,0:03:24.99,Default,,0,0,0,,Ху... Шинкансен – жасанды артефакт.
Dialogue: 0,0:03:25.07,0:03:28.33,Default,,0,0,0,,Мұны надандар ғана бағалайды.
Dialogue: 0,0:03:28.41,0:03:33.92,Default,,0,0,0,,Бастылық - Акудаманы өлтіру және балаларды құрбандық ретінде қорғау.
Dialogue: 0,0:03:34.00,0:03:36.00,Default,,0,0,0,,Балалар бізге қосылыңдар.
Dialogue: 0,0:03:36.09,0:03:39.34,Default,,0,0,0,,Сақтықпен қателесу ешқашан жақсы емес.
Dialogue: 0,0:03:39.88,0:03:41.01,Default,,0,0,0,,Иә
Dialogue: 0,0:03:43.80,0:03:45.76,Default,,0,0,0,,Сәлеметсіз бе, мен Қоян-чанмын.
Dialogue: 0,0:03:45.85,0:03:47.76,Default,,0,0,0,,Усу, бұл акула-кун.
Dialogue: 0,0:03:47.85,0:03:49.18,Default,,0,0,0,,Эй, акула-кун
Dialogue: 0,0:03:49.27,0:03:52.35,Default,,0,0,0,,Бұл неліктен болып жатқанын білесіз бе?
Dialogue: 0,0:03:52.44,0:03:55.56,Default,,0,0,0,,Қантоға тура қарсы шыққандар кінәлі.
Dialogue: 0,0:03:55.65,0:03:56.69,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:03:56.77,0:03:59.61,Default,,0,0,0,,Мен Кантоның жойылып кетпеуі үшін дайындаған ұсыныстарым⸺
Dialogue: 0,0:03:59.69,0:04:03.49,Default,,0,0,0,,Күткендей ол Кантоға мініп, оны ұрлап кетті.
Dialogue: 0,0:04:03.57,0:04:05.82,Default,,0,0,0,,Осы дүниенің үйлесімділігін сақтайтын Кантоға⸺
Dialogue: 0,0:04:05.91,0:04:07.70,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:07.78,0:04:11.20,Default,,0,0,0,,Супер S-класс Акудама осылай жасайды.
Dialogue: 0,0:04:11.29,0:04:15.08,Default,,0,0,0,,Канто жойылса, Қансай ғана жетпейді.
Dialogue: 0,0:04:15.17,0:04:18.96,Default,,0,0,0,,Кансайдағы барлық адамдар, Кансай полициясының жазалау бөлімі қазір жауапты.
Dialogue: 0,0:04:19.05,0:04:22.47,Default,,0,0,0,,Олар осы Акудаманы орындау үшін көп жұмыс істейді.
Dialogue: 0,0:04:22.55,0:04:26.22,Default,,0,0,0,,Барлығын қорғайтын Орындау бөлімін қолдаңыз!
Dialogue: 0,0:04:39.57,0:04:40.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:43.28,0:04:44.86,Default,,0,0,0,,Қолыңнан келгенін істе, апа.
Dialogue: 0,0:04:50.45,0:04:51.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:51.74,0:04:52.95,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:04:53.91,0:04:58.04,Default,,0,0,0,,Мен енді қаша алмаймын. Менің табылғаным аз ғана.
Dialogue: 0,0:04:58.71,0:05:02.76,Default,,0,0,0,,Олай болса, орындау бөлімі келіп, сені өлім жазасына кеседі.
Dialogue: 0,0:05:03.42,0:05:07.55,Default,,0,0,0,,Ал біз қайтадан әкелініп, Кантоның контейнеріне айналамыз.
Dialogue: 0,0:05:07.64,0:05:08.51,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,0:05:08.59,0:05:11.22,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сіз уәде бердіңіз.
Dialogue: 0,0:05:11.31,0:05:13.89,Default,,0,0,0,,Мен сендерге міндетті түрде қашып кетуге рұқсат етемін.
Dialogue: 0,0:05:14.39,0:05:18.06,Default,,0,0,0,,Рахмет, бірақ бұл жеткілікті.
Dialogue: 0,0:05:18.65,0:05:22.44,Default,,0,0,0,,Ол мені Бангпаку саябағына апарып, әпкеммен кездесуге рұқсат етті.
Dialogue: 0,0:05:22.53,0:05:26.03,Default,,0,0,0,,Бұл дұрыс емес, мен оны осы уақытқа дейін қорғадым.
Dialogue: 0,0:05:26.11,0:05:27.82,Default,,0,0,0,,Осы уәдені орындауыма рұқсат етіңіз.
Dialogue: 0,0:05:27.91,0:05:29.66,Default,,0,0,0,,Сіз орындай алмайтын уәделер бар.
Dialogue: 0,0:05:29.74,0:05:31.62,Default,,0,0,0,,Ондай уәде жоқ!
Dialogue: 0,0:05:31.70,0:05:33.91,Default,,0,0,0,,Мен орындай алмайтын ешқандай уәде берген жоқпын!
Dialogue: 0,0:05:34.00,0:05:36.62,Default,,0,0,0,,Мені ағам қорғады
Dialogue: 0,0:05:36.71,0:05:39.29,Default,,0,0,0,,Әпкем ағаммен кездесуге рұқсат етті.
Dialogue: 0,0:05:39.38,0:05:41.88,Default,,0,0,0,,Бермесең, уәдеңде тұра аласың!
Dialogue: 0,0:05:43.09,0:05:45.05,Default,,0,0,0,,Кешіріңіз, басқа амал жоқ...
Dialogue: 0,0:05:45.13,0:05:47.13,Default,,0,0,0,,Шулы! Неге бас тартасың!
Dialogue: 0,0:05:47.22,0:05:49.14,Default,,0,0,0,,Әлі ештеңе болған жоқ
Dialogue: 0,0:05:49.22,0:05:51.64,Default,,0,0,0,,Әпкелер, сендер әлі бас тартқан жоқсыңдар!
Dialogue: 0,0:05:51.72,0:05:55.22,Default,,0,0,0,,Біз әлі Кантоның контейнеріне айналған жоқпыз!
Dialogue: 0,0:05:55.31,0:05:56.14,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:05.90,0:06:07.45,Default,,0,0,0,,(Әпкенің жылағаны)
Dialogue: 0,0:06:19.50,0:06:21.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:21.08,0:06:23.46,Default,,0,0,0,,Жолдан кет, қарғыс атқыр әйел (қарапайым адам) Шабарман
Dialogue: 0,0:06:25.30,0:06:30.09,Default,,0,0,0,,Осы 500 иенді дәл осы жерден алыңыз.
Dialogue: 0,0:06:30.18,0:06:31.34,Default,,0,0,0,,Оны ұмытып қалдың ба?
Dialogue: 0,0:06:31.43,0:06:34.43,Default,,0,0,0,,Менде қазір бар ақша осы.
Dialogue: 0,0:06:34.51,0:06:36.68,Default,,0,0,0,,Енді сол балалар... (Курьер) Мен мұны талай рет айттым.
Dialogue: 0,0:06:36.77,0:06:38.23,Default,,0,0,0,,Алтынның түсуі – бақытсыздық деген...
Dialogue: 0,0:06:38.31,0:06:40.10,Default,,0,0,0,,Бұл сәтсіздік. Бұл тәртіпсіздік.
Dialogue: 0,0:06:40.98,0:06:46.36,Default,,0,0,0,,Мен осы 500 иенді алған бойда мен Акудама болдым.
Dialogue: 0,0:06:46.86,0:06:50.11,Default,,0,0,0,,Жаман адамдармен уақыт өткізіп, тіпті адамдарды өлтіру⸺
Dialogue: 0,0:06:50.20,0:06:53.07,Default,,0,0,0,,Қанша рет өлетінімді білмеймін⸺
Dialogue: 0,0:06:53.16,0:06:55.41,Default,,0,0,0,,Сіздің арқаңызда мен енді қалыпты өмір сүре алмаймын.
Dialogue: 0,0:06:55.49,0:06:57.66,Default,,0,0,0,,Құлаған алтынды терген адам.
Dialogue: 0,0:06:58.16,0:07:02.21,Default,,0,0,0,,Бұл бақытсыздық емес.
Dialogue: 0,0:07:02.29,0:07:06.42,Default,,0,0,0,,Бұл менің қалыпты өмірімді ең нашарға өзгерткен 500 иен.
Dialogue: 0,0:07:07.59,0:07:12.05,Default,,0,0,0,,Бірақ 500 иен менің өмірімді онша өзгерткен жоқ.
Dialogue: 0,0:07:12.14,0:07:13.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:13.64,0:07:15.47,Default,,0,0,0,,Осы 500 иен⸺
Dialogue: 0,0:07:15.56,0:07:18.89,Default,,0,0,0,,Оның адамдардың өмірін түбегейлі өзгертуге күші бар.
Dialogue: 0,0:07:18.98,0:07:22.27,Default,,0,0,0,,Сіз оны кез келген ақшадан қымбат деп ойламайсыз ба?
Dialogue: 0,0:07:22.35,0:07:26.27,Default,,0,0,0,,Бұл Курьер мен сол балалардың өмірін өзгертетініне сенімдімін.
Dialogue: 0,0:07:26.36,0:07:29.74,Default,,0,0,0,,Сонымен... Мен осы 500 иенге жұмыс сұраймын.
Dialogue: 0,0:07:30.61,0:07:34.24,Default,,0,0,0,,Курьер, ол балаларды Сикокуға апарыңыз.
Dialogue: 0,0:07:39.29,0:07:40.62,Default,,0,0,0,,Ол өзімшіл әйел.
Dialogue: 0,0:07:40.71,0:07:42.87,Default,,0,0,0,,Өзімшіл болған дұрыс.
Dialogue: 0,0:07:42.96,0:07:45.79,Default,,0,0,0,,Өйткені мен солай шештім.
Dialogue: 0,0:07:47.63,0:07:48.80,Default,,0,0,0,,Акудамаме
Dialogue: 0,0:07:51.59,0:07:53.30,Default,,0,0,0,,Мен көтере алмайтын ештеңе жоқ
Dialogue: 0,0:07:53.38,0:07:56.26,Default,,0,0,0,,Шабарман... (шабарман) Ендеше кет мына жерден, қарғыс атқыр әйел.
Dialogue: 0,0:07:57.10,0:08:00.14,Default,,0,0,0,,Мінуге қабілетті әйел соңында жеңеді.
Dialogue: 0,0:08:00.68,0:08:02.14,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:03.14,0:08:06.06,Default,,0,0,0,,Айналада қаншама шаң ұшып жатыр.
Dialogue: 0,0:08:06.15,0:08:08.32,Default,,0,0,0,,Бронхитпен ауырсам ше?
Dialogue: 0,0:08:08.40,0:08:10.03,Default,,0,0,0,,Бұл орын алса, қызметкерлерге өтемақы төленеді.
Dialogue: 0,0:08:10.11,0:08:12.70,Default,,0,0,0,,Біріншіден, сіз бомбадан кейін әлі тірісіз бе?
Dialogue: 0,0:08:12.78,0:08:15.91,Default,,0,0,0,,Сондай-ақ~ Оны тез өлтіріп, үйге қайтайық~
Dialogue: 0,0:08:15.99,0:08:18.62,Default,,0,0,0,,Жылжымалы нысанды растау Жылжымалы нысанды растау
Dialogue: 0,0:08:24.12,0:08:25.88,Default,,0,0,0,,Мына балалар, өтінемін.
Dialogue: 0,0:08:25.96,0:08:27.38,Default,,0,0,0,,Менің әпкем қасымда...
Dialogue: 0,0:08:27.46,0:08:29.50,Default,,0,0,0,,Мен сенімен барсам болады ма?
Dialogue: 0,0:08:30.05,0:08:32.26,Default,,0,0,0,,Мен мұнда орындау бөлімі келетініне сенімдімін.
Dialogue: 0,0:08:32.34,0:08:34.68,Default,,0,0,0,,Мен оларды тоқтатамын
Dialogue: 0,0:08:34.76,0:08:37.09,Default,,0,0,0,,Мұндай денемен мұны қалай жасауға болады...
Dialogue: 0,0:08:38.26,0:08:41.35,Default,,0,0,0,,Әпке... Ақыр аяғында мен тұрамын.
Dialogue: 0,0:08:41.43,0:08:42.68,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:42.77,0:08:45.10,Default,,0,0,0,,Сіз қашуыңыз керек
Dialogue: 0,0:08:46.06,0:08:49.90,Default,,0,0,0,,Өйткені бұл сіздің шешіміңіз.
Dialogue: 0,0:08:52.28,0:08:55.95,Default,,0,0,0,,Маған көмектесіңізші, мен қарапайым адаммын!
Dialogue: 0,0:08:56.03,0:08:57.24,Default,,0,0,0,,Қарапайым адамдар?
Dialogue: 0,0:08:57.32,0:08:59.74,Default,,0,0,0,,Мен мұны бұрын көрмегеніме сенімдімін.
Dialogue: 0,0:09:00.49,0:09:02.91,Default,,0,0,0,,Біз... шештік пе?
Dialogue: 0,0:09:03.96,0:09:07.42,Default,,0,0,0,,Дұрыс, оны соңына дейін ұстаныңыз
Dialogue: 0,0:09:08.08,0:09:11.46,Default,,0,0,0,,Не болса да, қандай құрбан болса да
Dialogue: 0,0:09:11.55,0:09:12.55,Default,,0,0,0,,Иә
Dialogue: 0,0:09:13.05,0:09:14.42,Default,,0,0,0,,Дәл Акудама сияқты
Dialogue: 0,0:09:14.51,0:09:17.80,Default,,0,0,0,,Осы уақытқа дейін жеткендеріңіз - ең жақсы Акудама.
Dialogue: 0,0:09:17.89,0:09:20.55,Default,,0,0,0,,Ах... (апа) Акудама...
Dialogue: 0,0:09:23.64,0:09:26.56,Default,,0,0,0,,Ол сізді міндетті түрде тартады. Мүмкіндікті пайдаланыңыз.
Dialogue: 0,0:09:26.64,0:09:28.23,Default,,0,0,0,,Сіз мені кім деп ойлайсыз?
Dialogue: 0,0:09:28.31,0:09:32.94,Default,,0,0,0,,745 жыл түрмеде отырудың болжамды мерзімі. Курьер...
Dialogue: 0,0:09:34.19,0:09:35.53,Default,,0,0,0,,Әпке, өлмеңіз!
Dialogue: 0,0:09:37.78,0:09:40.03,Default,,0,0,0,,Сіз мені кім деп ойлайсыз?
Dialogue: 0,0:09:40.12,0:09:42.70,Default,,0,0,0,,Мен оған жаңа ғана түсіп қалдым!
Dialogue: 0,0:09:42.79,0:09:45.75,Default,,0,0,0,,Мен осында тұрамын, кенет жарылыс болды...
Dialogue: 0,0:09:45.83,0:09:49.79,Default,,0,0,0,,Қараңдар! Сондықтан бейбіт тұрғындарды эвакуациялаған дұрыс деп айттым.
Dialogue: 0,0:09:49.88,0:09:51.84,Default,,0,0,0,,Расталған Акудама тізімі.
Dialogue: 0,0:09:51.92,0:09:54.17,Default,,0,0,0,,Оның келбеті біршама өзгерді, бірақ бұған күмән жоқ.
Dialogue: 0,0:09:54.26,0:09:55.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:56.01,0:09:59.47,Default,,0,0,0,,Шинкансеннен сейфтің ішіндегісін тонап алды⸺
Dialogue: 0,0:09:59.55,0:10:04.31,Default,,0,0,0,,Күннің соңында Кансайды абдырап қалдырған супер S класындағы Акудама.
Dialogue: 0,0:10:04.39,0:10:07.77,Default,,0,0,0,,Менің басқа баратын жерім жоқ!
Dialogue: 0,0:10:07.85,0:10:11.31,Default,,0,0,0,,Әкем де, шешем де күтпеген жерден Ақудамаға айналып, өлтірілді.
Dialogue: 0,0:10:11.40,0:10:13.90,Default,,0,0,0,,Бірақ мен акудама емеспін!
Dialogue: 0,0:10:14.90,0:10:15.90,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:15.99,0:10:18.11,Default,,0,0,0,,Мен қарапайым адаммын!
Dialogue: 0,0:10:18.82,0:10:21.12,Default,,0,0,0,,Мен алаяқпын!
Dialogue: 0,0:10:31.67,0:10:33.25,Default,,0,0,0,,Сіз қанша уақыттан бері айқайлайсыз?
Dialogue: 0,0:10:33.34,0:10:37.05,Default,,0,0,0,,Ақыры ең ақымақ өтірік айттың, алаяқ.
Dialogue: 0,0:10:37.13,0:10:39.88,Default,,0,0,0,,Өлім жазасын орындау!
Dialogue: 0,0:11:26.56,0:11:28.27,Default,,0,0,0,,Замамиро
Dialogue: 0,0:11:44.12,0:11:48.37,Default,,0,0,0,,Күл... Бұл шынымен жиіркенішті
Dialogue: 0,0:11:51.87,0:11:53.50,Default,,0,0,0,,Алаяқты орындау аяқталды
Dialogue: 0,0:11:53.58,0:11:54.88,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:11:55.71,0:11:57.59,Default,,0,0,0,,Дәл қазір екінші команданың ұшқышсыз ұшағы
Dialogue: 0,0:11:57.67,0:11:59.92,Default,,0,0,0,,Тұтқынға алынған курьер және ұсыныстар
Dialogue: 0,0:12:00.01,0:12:01.63,Default,,0,0,0,,Батысқа қарай жылжу.
Dialogue: 0,0:12:01.72,0:12:03.63,Default,,0,0,0,,Түсіндім, мен оны қадағалаймын.
Dialogue: 0,0:12:03.72,0:12:06.60,Default,,0,0,0,,Мұнда да жолдар тез жабылады.
Dialogue: 0,0:12:07.14,0:12:11.73,Default,,0,0,0,,Соңында біз, Орындау бөлімі, Акудаманы бұрышқа саламыз.
Dialogue: 0,0:12:20.99,0:12:25.78,Default,,0,0,0,,Сіз күткендей келдіңіз, Супер S-класты Акудама курьері.
Dialogue: 0,0:12:26.41,0:12:28.33,Default,,0,0,0,,Сыйлық қайтарылады.
Dialogue: 0,0:12:28.41,0:12:30.70,Default,,0,0,0,,Сізді осы жерде орындаңыз.
Dialogue: 0,0:12:41.46,0:12:42.42,Default,,0,0,0,,Өлім жазасы…
Dialogue: 0,0:12:43.67,0:12:45.26,Default,,0,0,0,,Орындау
Dialogue: 0,0:12:46.51,0:12:47.64,Default,,0,0,0,,А... (Ағай) Уау!
Dialogue: 0,0:12:50.51,0:12:51.97,Default,,0,0,0,,Ұсыныстар!
Dialogue: 0,0:12:52.06,0:12:54.06,Default,,0,0,0,,Аргх (Орындау бөлімі) Эй!
Dialogue: 0,0:12:57.06,0:12:58.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:59.27,0:13:01.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:01.82,0:13:04.20,Default,,0,0,0,,Сол балалардың қашып кетуіне не жетсін?
Dialogue: 0,0:13:04.28,0:13:05.70,Default,,0,0,0,,Жұмыс істеуге кедергі.
Dialogue: 0,0:13:08.24,0:13:09.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:14.83,0:13:15.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:15.87,0:13:16.75,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:13:19.29,0:13:20.59,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:25.47,0:13:27.05,Default,,0,0,0,,Ах... (Курьер) Цк.
Dialogue: 0,0:13:27.13,0:13:29.22,Default,,0,0,0,,Менің несием!
Dialogue: 0,0:13:29.30,0:13:31.18,Default,,0,0,0,,Уф... ұсыныс!?
Dialogue: 0,0:13:31.26,0:13:32.39,Default,,0,0,0,,Уф... (шабарман) Жақсы жұмыс.
Dialogue: 0,0:13:34.23,0:13:35.98,Default,,0,0,0,,Үлкен аға! Қарғыс атқыр адамдар!
Dialogue: 0,0:13:38.48,0:13:40.06,Default,,0,0,0,,Гррр…
Dialogue: 0,0:13:41.19,0:13:45.03,Default,,0,0,0,,Мен өкінішке орай осы деңгейге жету үшін көптеген құрбандықтар жасадым.
Dialogue: 0,0:13:45.11,0:13:47.66,Default,,0,0,0,,Соңында мат
Dialogue: 0,0:13:48.45,0:13:49.78,Default,,0,0,0,,Акудама
Dialogue: 0,0:13:52.41,0:13:53.49,Default,,0,0,0,,Чи…
Dialogue: 0,0:13:59.42,0:14:00.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:02.96,0:14:04.21,Default,,0,0,0,,Неге мұндасың!?
Dialogue: 0,0:14:04.30,0:14:06.47,Default,,0,0,0,,Сіз нені елемейсіз? Оны қорғаңыз.
Dialogue: 0,0:14:06.55,0:14:07.38,Default,,0,0,0,,Иә
Dialogue: 0,0:14:08.38,0:14:10.34,Default,,0,0,0,,Сіз не істеп жатырсыз? Ондай жерде қалмаңыз...
Dialogue: 0,0:14:10.43,0:14:11.51,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:15.60,0:14:16.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:17.69,0:14:20.10,Default,,0,0,0,,Уф! (Қыз) Ах! Уф...
Dialogue: 0,0:14:20.19,0:14:21.86,Default,,0,0,0,,Мылтықты босат! Ол жарылып кетеді!
Dialogue: 0,0:14:23.48,0:14:27.11,Default,,0,0,0,,Неге әкеңді өлтірдің...
Dialogue: 0,0:14:27.70,0:14:30.20,Default,,0,0,0,,Анаңды не үшін өлтірдің?
Dialogue: 0,0:14:30.28,0:14:31.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:32.78,0:14:34.16,Default,,0,0,0,,(кіші жөтел)
Dialogue: 0,0:14:34.24,0:14:35.20,Default,,0,0,0,,Біреу көмектессін!
Dialogue: 0,0:14:40.29,0:14:41.67,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:42.21,0:14:43.17,Default,,0,0,0,,Құдай-ай!
Dialogue: 0,0:14:47.80,0:14:49.30,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:14:49.38,0:14:53.05,Default,,0,0,0,,(айқай)
Dialogue: 0,0:15:01.40,0:15:04.02,Default,,0,0,0,,Ақымақ, мұндағылар неге тағы...
Dialogue: 0,0:15:04.11,0:15:06.90,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:15:06.98,0:15:11.78,Default,,0,0,0,,Әкем де, шешем де өте мейірімді еді.
Dialogue: 0,0:15:11.86,0:15:15.16,Default,,0,0,0,,Мен жылағанда құшақтап алдың.
Dialogue: 0,0:15:16.24,0:15:19.54,Default,,0,0,0,,Неге... оны неге өлтірдің?
Dialogue: 0,0:15:20.04,0:15:24.46,Default,,0,0,0,,Тіпті анау әпкеміз өзін қарапайым адам деп айтты⸺
Dialogue: 0,0:15:25.13,0:15:26.84,Default,,0,0,0,,Мені неге өлтірдің?
Dialogue: 0,0:15:27.46,0:15:28.46,Default,,0,0,0,,Не?
Dialogue: 0,0:15:28.55,0:15:30.67,Default,,0,0,0,,Мұндай жағдайдың болуы шыдамсыз ба? (Ұялы телефон қоңырау үні)
Dialogue: 0,0:15:31.30,0:15:33.59,Default,,0,0,0,,Не! Бізге тез қосылыңыз!
Dialogue: 0,0:15:33.68,0:15:36.22,Default,,0,0,0,,Бастық Қалада көп қиындық бар.
Dialogue: 0,0:15:36.31,0:15:37.14,Default,,0,0,0,,Қалада!?
Dialogue: 0,0:15:37.60,0:15:39.43,Default,,0,0,0,,Сіз қашаннан бері айқайлайсыз?
Dialogue: 0,0:15:39.52,0:15:42.35,Default,,0,0,0,,Өлім жазасын орындау!
Dialogue: 0,0:15:44.61,0:15:46.23,Default,,0,0,0,,Сіз қашаннан бері айқайлайсыз?
Dialogue: 0,0:15:46.32,0:15:47.73,Default,,0,0,0,,Орындау бөлімі өз қалауы бойынша⸺
Dialogue: 0,0:15:47.82,0:15:51.07,Default,,0,0,0,,Мен акудама емес азаматты өлтірдім.
Dialogue: 0,0:15:51.15,0:15:53.16,Default,,0,0,0,,Бұл жабайы қуат.
Dialogue: 0,0:15:53.74,0:15:58.29,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, барлығы өлім жазасына кесу бөлімінің кеудесінен үш дюймге дейін өледі!
Dialogue: 0,0:15:58.37,0:16:00.54,Default,,0,0,0,,Біз қазір орындау бөлімі туралы бірдеңе істеуіміз керек⸺
Dialogue: 0,0:16:00.62,0:16:03.75,Default,,0,0,0,,Қансай азаматтарының адам құқықтары мен бостандықтары жойылады.
Dialogue: 0,0:16:03.83,0:16:07.17,Default,,0,0,0,,Расында да барлығының күш біріктіретін уақыты келді.
Dialogue: 0,0:16:07.25,0:16:09.13,Default,,0,0,0,,Қаладағы голограммаларды былай қойғанда⸺
Dialogue: 0,0:16:09.21,0:16:12.09,Default,,0,0,0,,Бұл бейне барлығында, тіпті мобильді құрылғыларда ойнатылады.
Dialogue: 0,0:16:12.17,0:16:13.01,Default,,0,0,0,,Тез тоқтатыңыз!
Dialogue: 0,0:16:13.09,0:16:14.01,Default,,0,0,0,,Жоқ, қолымнан келгенше істеймін.
Dialogue: 0,0:16:14.09,0:16:17.22,Default,,0,0,0,,Бұл өте тітіркендіргіш. Бұл не?
Dialogue: 0,0:16:17.30,0:16:20.64,Default,,0,0,0,,Бұл бізді Акудамаға ұқсатпайды.
Dialogue: 0,0:16:21.18,0:16:23.44,Default,,0,0,0,,Кім осындай нәрсені жасай алады ...
Dialogue: 0,0:16:24.65,0:16:26.06,Default,,0,0,0,,Бұл сенің әпкең.
Dialogue: 0,0:16:34.41,0:16:37.20,Default,,0,0,0,,Мұндай ауқымды бұзудың орын алуы шыдамсыз ба?
Dialogue: 0,0:16:38.62,0:16:43.04,Default,,0,0,0,,Бос ақпаратқа алданған ақымақтар.
Dialogue: 0,0:16:44.29,0:16:46.58,Default,,0,0,0,,Басшы дұрыс.
Dialogue: 0,0:16:46.67,0:16:48.79,Default,,0,0,0,,Бұл ақымақтарды Акудама деп тану.
Dialogue: 0,0:16:48.88,0:16:51.17,Default,,0,0,0,,Сонда мен олардың бәрін өлім жазасына кесемін.
Dialogue: 0,0:16:51.26,0:16:52.72,Default,,0,0,0,,Міне!
Dialogue: 0,0:16:54.09,0:16:57.89,Default,,0,0,0,,Иә, өлім жазасы. Не...
Dialogue: 0,0:16:57.97,0:16:59.26,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:17:00.72,0:17:01.64,Default,,0,0,0,,Стейннен алған жарақаттарым әлі толық жазылмағандықтан—
Dialogue: 0,0:17:01.72,0:17:02.98,Default,,0,0,0,,Үкім!
Dialogue: 0,0:17:03.06,0:17:06.35,Default,,0,0,0,,Орындау департаменті туралы үкім! (Азаматтар) Сот!
Dialogue: 0,0:17:06.44,0:17:10.11,Default,,0,0,0,,Орындау бөлімін кешірмеңіз! (Азаматтар) Кешірмеңдер!
Dialogue: 0,0:17:10.19,0:17:13.61,Default,,0,0,0,,Атқару бөлімін қуыңыз! (Азаматтар) Оларды қуып жіберіңіздер!
Dialogue: 0,0:17:13.69,0:17:17.53,Default,,0,0,0,,Орындау департаменті туралы үкім! (Азаматтар) Сот!
Dialogue: 0,0:17:18.74,0:17:24.75,Default,,0,0,0,,(Шәкірттің тыныс алуы)
Dialogue: 0,0:17:31.55,0:17:37.55,Default,,0,0,0,,(Шәкірттің тыныс алуы)
Dialogue: 0,0:17:46.89,0:17:49.69,Default,,0,0,0,,№ Орындау бөлімі...
Dialogue: 0,0:17:50.44,0:17:53.07,Default,,0,0,0,,Бұл олай емес!
Dialogue: 0,0:17:53.15,0:17:55.57,Default,,0,0,0,,Кеттік, бейбақтар.
Dialogue: 0,0:18:00.78,0:18:03.41,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:18:18.55,0:18:22.01,Default,,0,0,0,,
Dialogue: 0,0:18:24.26,0:18:25.10,Default,,0,0,0,,Уау
Dialogue: 0,0:18:26.89,0:18:30.02,Default,,0,0,0,,Акудама сияқты нәрсе!
Dialogue: 0,0:18:30.52,0:18:31.36,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:20.70,0:19:21.78,Default,,0,0,0,,Гах...
Dialogue: 0,0:19:21.86,0:19:25.03,Default,,0,0,0,,Сіздің басыңызда құрттар өсіп жатыр ма?
Dialogue: 0,0:19:25.58,0:19:28.25,Default,,0,0,0,,Курьерді қуыңыз, не істегеніңіз маңызды емес.
Dialogue: 0,0:19:28.33,0:19:30.66,Default,,0,0,0,,Оны өлтіру үшін бар күшіңізді салыңыз!
Dialogue: 0,0:19:30.75,0:19:31.83,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:19:36.38,0:19:39.46,Default,,0,0,0,,Сіз бұл туралы не істейсіз?
Dialogue: 0,0:19:39.55,0:19:42.30,Default,,0,0,0,,Басыңның ұшып кетуіне жетпейді!
Dialogue: 0,0:19:42.38,0:19:45.01,Default,,0,0,0,,Бастық Бұл...
Dialogue: 0,0:19:45.10,0:19:48.68,Default,,0,0,0,,Өлім бөлімі бұлай болмауы керек!
Dialogue: 0,0:19:48.77,0:19:49.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:50.64,0:19:52.98,Default,,0,0,0,,Қазірдің өзінде қожайыным неге жалғыз екен деп ойлаймын.
Dialogue: 0,0:19:53.06,0:19:55.31,Default,,0,0,0,,Ол Акудаманы өлтіруге барды ма, білмеймін.
Dialogue: 0,0:19:55.40,0:19:59.19,Default,,0,0,0,,Бірақ мен сенімге ие болып, әділдікті орындадым!
Dialogue: 0,0:19:59.28,0:20:00.78,Default,,0,0,0,,Сондықтан күліп өлдім!
Dialogue: 0,0:20:00.86,0:20:03.70,Default,,0,0,0,,Бұған не болды! Мен үшін де солай
Dialogue: 0,0:20:03.78,0:20:06.78,Default,,0,0,0,,Бұл бірдей болуы мүмкін емес! Қарап тұрып айта алмайсың ба?
Dialogue: 0,0:20:08.87,0:20:13.87,Default,,0,0,0,,(Азаматтардың айқайы мен ыңылауы)
Dialogue: 0,0:20:17.88,0:20:21.05,Default,,0,0,0,,Бүгін Атқару бөлімі осылай істеді.
Dialogue: 0,0:20:22.09,0:20:24.93,Default,,0,0,0,,Ол бала Акудама ма?
Dialogue: 0,0:20:26.01,0:20:27.26,Default,,0,0,0,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,0:20:31.14,0:20:32.27,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:20:33.23,0:20:36.90,Default,,0,0,0,,Сені осылай жасауға мәжбүрлегенім үшін кешірім сұраймын...
Dialogue: 0,0:20:42.32,0:20:47.66,Default,,0,0,0,,Жарай бер, сол баланы оқпен тесіп өт!
Dialogue: 0,0:20:47.74,0:20:51.41,Default,,0,0,0,,(қыз жылап жатыр)
Dialogue: 0,0:20:52.62,0:20:54.54,Default,,0,0,0,,Онда оқ жоқ.
Dialogue: 0,0:20:54.62,0:20:56.67,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:20:57.17,0:21:00.42,Default,,0,0,0,,Балаға қаруды қайта ұстауға ешқашан рұқсат бермеңіз
Dialogue: 0,0:21:02.46,0:21:05.34,Default,,0,0,0,,Саған жақсы жұмыс, ақымақ шәкірт.
Dialogue: 0,0:21:05.43,0:21:08.05,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:21:08.64,0:21:12.77,Default,,0,0,0,,Өлме, әлі көп жұмыс бар.
Dialogue: 0,0:21:14.35,0:21:17.77,Default,,0,0,0,,Иә... Ұстаз
Dialogue: 0,0:21:17.85,0:21:19.02,Default,,0,0,0,,Я...
Dialogue: 0,0:21:21.73,0:21:25.57,Default,,0,0,0,,Сіз өмір сүруіңіз керек... немесе...
Dialogue: 0,0:22:39.23,0:22:40.40,Default,,0,0,0,,Курьер?
Dialogue: 0,0:22:40.48,0:22:41.94,Default,,0,0,0,,Не болды?
Dialogue: 0,0:22:42.77,0:22:45.15,Default,,0,0,0,,Түсіңіз. (аға) Неге? Әлі емес...
Dialogue: 0,0:22:45.23,0:22:46.07,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:22:50.36,0:22:52.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:02.54,0:23:03.92,Default,,0,0,0,,Егер координаталар дұрыс болса⸺
Dialogue: 0,0:23:04.59,0:23:08.17,Default,,0,0,0,,Егер сіз сол тау жотасын кесіп өтсеңіз, сіз Шикокуды көре аласыз.
Dialogue: 0,0:23:12.26,0:23:14.14,Default,,0,0,0,,Курьерге рахмет
Dialogue: 0,0:23:14.97,0:23:18.31,Default,,0,0,0,,Уау... бұл...
Dialogue: 0,0:23:18.39,0:23:21.23,Default,,0,0,0,,500 иен, ол сіздің өміріңізді өзгертеді
Dialogue: 0,0:23:21.31,0:23:24.19,Default,,0,0,0,,Анау сұмдық әйел айтады... бірақ...
Dialogue: 0,0:23:24.98,0:23:25.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:34.28,0:23:38.83,Default,,0,0,0,,Ақудаманың бәрі өзімшіл екені рас.
Dialogue: 0,0:23:40.66,0:23:41.71,Default,,0,0,0,,Иә
Dialogue: 0,0:23:51.17,0:23:52.34,Default,,0,0,0,,Қош бол
Dialogue: 0,0:25:49.25,0:25:50.54,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:26:01.10,0:26:03.31,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:26:18.57,0:26:19.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:02.99,0:27:03.83,Default,,0,0,0,,Чи…
Dialogue: 0,0:27:04.37,0:27:05.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:11.12,0:27:12.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:15.46,0:27:16.30,Default,,0,0,0,,Гррр…
Dialogue: 0,0:27:17.09,0:27:18.05,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:27:20.72,0:27:22.51,Default,,0,0,0,,Сіз қашып кете аласыз!
Dialogue: 0,0:27:39.57,0:27:41.07,Default,,0,0,0,,Жоқ... Уф...
Dialogue: 0,0:27:56.63,0:27:58.59,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:27:58.67,0:27:59.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:12.31,0:28:14.52,Default,,0,0,0,,Жоғары... Дайын...
Dialogue: 0,0:28:45.43,0:28:47.22,Default,,0,0,0,,Фу…
Dialogue: 0,0:30:35.54,0:30:40.54,Default,,0,0,0,,♪~
Dialogue: 0,0:32:00.33,0:32:05.34,Default,,0,0,0,,~♪
