Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.96,0:00:14.00,Default,,0000,0000,0000,,<Гоку өлім аузында болды. →
Dialogue: 0,0:00:14.00,0:00:19.05,Default,,0000,0000,0000,,Бір қызығы, бұл күнді құтқарған Яджиробе болды. →
Dialogue: 0,0:00:19.05,0:00:21.07,Default,,0000,0000,0000,,Гоханның қарсылығының артында→
Dialogue: 0,0:00:21.07,0:00:26.07,Default,,0000,0000,0000,,Соңғы үміт криллинге сеніп тапсырылды>
Dialogue: 0,0:00:28.14,0:00:30.16,Default,,0000,0000,0000,,Криллин, бұл...
Dialogue: 0,0:00:30.16,0:00:34.16,Default,,0000,0000,0000,,Уау, түсіндім. Мен тырысамын.
Dialogue: 0,0:00:36.22,0:00:41.27,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:41.27,0:01:01.47,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:01.47,0:01:21.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:21.00,0:01:41.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:41.20,0:01:58.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:20.12,0:04:22.14,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:04:22.14,0:04:27.19,Default,,0000,0000,0000,,Хахаха... Қандай күшті.
Dialogue: 0,0:04:27.19,0:04:32.24,Default,,0000,0000,0000,,Әкеңмен соғысудан әбден шаршаған шығарсың.
Dialogue: 0,0:04:32.24,0:04:49.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:49.41,0:04:54.41,Default,,0000,0000,0000,,《Ол үлкен бала, бірақ оның шегіне жететін сияқты》
Dialogue: 0,0:05:04.56,0:05:08.60,Default,,0000,0000,0000,,Сиқырлы жарқыл!
Dialogue: 0,0:05:08.60,0:05:11.60,Default,,0000,0000,0000,,Хмф! Соңғы күрес?
Dialogue: 0,0:05:13.98,0:05:15.98,Default,,0000,0000,0000,,Уаа...
Dialogue: 0,0:05:18.03,0:05:21.06,Default,,0000,0000,0000,,Тағы бір нәрсе! Та~!
Dialogue: 0,0:05:21.06,0:05:23.06,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:05:28.13,0:05:35.20,Default,,0000,0000,0000,,Шүкір... Қолыммен олай қозғала алмаймын.
Dialogue: 0,0:05:35.20,0:05:38.23,Default,,0000,0000,0000,,《Энергия шарларына қарап, оларды таппайсыз. →
Dialogue: 0,0:05:38.23,0:05:42.27,Default,,0000,0000,0000,,Зұлым рухты сезініп, оны босатыңыз.
Dialogue: 0,0:05:42.27,0:05:44.29,Default,,0000,0000,0000,,Бұл кім!?
Dialogue: 0,0:05:44.29,0:05:49.34,Default,,0000,0000,0000,,《Бұл Сон Гокуға Генкидамды үйреткен Кай патша》
Dialogue: 0,0:05:49.34,0:05:52.37,Default,,0000,0000,0000,,Кайо-сама.
Dialogue: 0,0:05:52.37,0:05:55.40,Default,,0000,0000,0000,,《Бәрі сенің бір соққыңмен шешіледі. →
Dialogue: 0,0:05:55.40,0:06:01.46,Default,,0000,0000,0000,,Рух шары бүкіл жердің тілектерін қамтитын шар екенін біл.
Dialogue: 0,0:06:01.46,0:06:06.46,Default,,0000,0000,0000,,Иә? Жер шарының түкпір-түкпірінен тілектер жазылған шар...
Dialogue: 0,0:06:08.53,0:06:12.91,Default,,0000,0000,0000,,Ааа аааааа...
Dialogue: 0,0:06:12.91,0:06:17.96,Default,,0000,0000,0000,,Хехехе... Қанша сұмдық бірге жүрсе де→
Dialogue: 0,0:06:17.96,0:06:21.96,Default,,0000,0000,0000,,Бұл элитаға сәйкес келмейді.
Dialogue: 0,0:06:23.02,0:06:27.06,Default,,0000,0000,0000,,Мен мұны түсінген кезде бәрі кеш болған сияқты.
Dialogue: 0,0:06:27.06,0:06:29.06,Default,,0000,0000,0000,,Хахахаха.
Dialogue: 0,0:06:32.11,0:06:38.17,Default,,0000,0000,0000,,《Мен зұлымдықтың энергиясын сезініп, оны босататыным сонша》
Dialogue: 0,0:06:38.17,0:06:40.19,Default,,0000,0000,0000,,《Криллин сұрады》
Dialogue: 0,0:06:40.19,0:06:43.19,Default,,0000,0000,0000,,《Сізге бір ғана мүмкіндік беріледі》
Dialogue: 0,0:06:47.26,0:06:51.30,Default,,0000,0000,0000,,Мұның бәрі көңіл көтеру үшін.
Dialogue: 0,0:06:51.30,0:06:53.32,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:06:53.32,0:06:56.32,Default,,0000,0000,0000,,Та-та-та-та-та-та-та!
Dialogue: 0,0:06:58.37,0:07:00.39,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:00.39,0:07:05.39,Default,,0000,0000,0000,,Атататата...!
Dialogue: 0,0:07:07.46,0:07:10.46,Default,,0000,0000,0000,,Ууа уа уа уа уа уа уа уа уа...!
Dialogue: 0,0:07:13.85,0:07:15.87,Default,,0000,0000,0000,,Сіз қашып құтыла аласыз ба!?
Dialogue: 0,0:07:15.87,0:07:20.87,Default,,0000,0000,0000,,《Оны сезін! Мен оның зұлым рухын сеземін》
Dialogue: 0,0:07:22.94,0:07:24.94,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:31.03,0:07:34.06,Default,,0000,0000,0000,,《Ол бірдеңе істеуді жоспарлап отыр. →
Dialogue: 0,0:07:34.06,0:07:38.06,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Егер сіз мұны жасағыңыз келсе, оны дереу жасаңыз! 》
Dialogue: 0,0:07:46.18,0:07:51.23,Default,,0000,0000,0000,,Хахахаха! Мұқият қара, Какарот.
Dialogue: 0,0:07:51.23,0:07:55.27,Default,,0000,0000,0000,,Бұл сіздің ақымақ ұлыңыздың ақыры!
Dialogue: 0,0:07:55.27,0:07:57.29,Default,,0000,0000,0000,,Ұстадым!
Dialogue: 0,0:07:57.29,0:08:00.32,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Ақымақ, тез істе!
Dialogue: 0,0:08:00.32,0:08:03.35,Default,,0000,0000,0000,,Не!? Тск, анау ақымақ...
Dialogue: 0,0:08:03.35,0:08:05.35,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:08:08.40,0:08:10.59,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:10.59,0:08:14.79,Default,,0000,0000,0000,,А, бұл не!
Dialogue: 0,0:08:14.79,0:08:16.81,Default,,0000,0000,0000,,Жеңіс!
Dialogue: 0,0:08:16.81,0:08:20.85,Default,,0000,0000,0000,,Ха! О, жойылды!
Dialogue: 0,0:08:20.85,0:08:22.85,Default,,0000,0000,0000,,О!? Ой!?
Dialogue: 0,0:08:24.89,0:08:28.89,Default,,0000,0000,0000,,Ах~ Бұл енді жақсы емес.
Dialogue: 0,0:08:30.95,0:08:32.97,Default,,0000,0000,0000,,《Гоханды қайтару》
Dialogue: 0,0:08:32.97,0:08:36.01,Default,,0000,0000,0000,,Уау? 《Гохан: Ол жігіт мен жақта. →
Dialogue: 0,0:08:36.01,0:08:40.01,Default,,0000,0000,0000,,Егер сізде зұлым рух болмаса, оны тойтару керек.
Dialogue: 0,0:08:42.07,0:08:47.12,Default,,0000,0000,0000,,Уау... Уау.
Dialogue: 0,0:08:47.12,0:08:50.15,Default,,0000,0000,0000,,Уау! О...
Dialogue: 0,0:08:50.15,0:08:52.15,Default,,0000,0000,0000,,A~.
Dialogue: 0,0:08:54.19,0:08:57.22,Default,,0000,0000,0000,,Уау! →
Dialogue: 0,0:08:57.22,0:09:03.28,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:03.28,0:09:15.73,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:15.73,0:09:19.73,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:24.82,0:09:27.85,Default,,0000,0000,0000,,Мен жасадым!
Dialogue: 0,0:09:27.85,0:09:31.89,Default,,0000,0000,0000,,Хияхо~! Алақай! →
Dialogue: 0,0:09:31.89,0:09:35.93,Default,,0000,0000,0000,,Мен жасадым, мен жасадым, Гоку хахахаха! →
Dialogue: 0,0:09:35.93,0:09:39.97,Default,,0000,0000,0000,,Керемет, Гоку, сен мұны істедің! Ия, иә!
Dialogue: 0,0:09:39.97,0:09:44.02,Default,,0000,0000,0000,,Хаха ха ха....
Dialogue: 0,0:09:44.02,0:09:46.02,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:09:50.08,0:09:53.11,Default,,0000,0000,0000,,Балалар, ақырында орындадыңдар. Иә.
Dialogue: 0,0:09:53.11,0:09:57.15,Default,,0000,0000,0000,,Ахаха мен бұл сәтсіздікке ұшырайды деп талай рет ойладым.
Dialogue: 0,0:09:57.15,0:10:02.15,Default,,0000,0000,0000,,Екеуі де тоз-тоз. Сіз сияқты жақсы емес.
Dialogue: 0,0:10:05.23,0:10:07.23,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:15.67,0:10:18.67,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:10:22.74,0:10:25.77,Default,,0000,0000,0000,,Сайандар...
Dialogue: 0,0:10:25.77,0:10:28.77,Default,,0000,0000,0000,,Жарайды, өлді.
Dialogue: 0,0:10:32.84,0:10:37.89,Default,,0000,0000,0000,,А... қарғыс атсын, тозақтың ісі болды→
Dialogue: 0,0:10:37.89,0:10:40.89,Default,,0000,0000,0000,,Мүмкін мен қабір жасаймын...
Dialogue: 0,0:10:42.94,0:10:44.96,Default,,0000,0000,0000,,Сіздің қабірлеріңіз?
Dialogue: 0,0:10:44.96,0:10:46.98,Default,,0000,0000,0000,,Nu~!? Ува~!?
Dialogue: 0,0:10:46.98,0:10:48.00,Default,,0000,0000,0000,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:10:48.00,0:10:57.09,Default,,0000,0000,0000,,Ой, сен неткен ақымақсың. Сіз жаңа ғана Генкидам алған болсаңыз да...
Dialogue: 0,0:10:57.09,0:11:02.14,Default,,0000,0000,0000,,Ммммммм... →
Dialogue: 0,0:11:02.14,0:11:06.18,Default,,0000,0000,0000,,Сіз менің басымнан көп қиындық көрдіңіз. →
Dialogue: 0,0:11:06.18,0:11:10.38,Default,,0000,0000,0000,,Мен дәл қазір өлемін деп ойладым.
Dialogue: 0,0:11:10.38,0:11:13.58,Default,,0000,0000,0000,,I~.
Dialogue: 0,0:11:13.58,0:11:17.62,Default,,0000,0000,0000,,Жарайды, мен көп зиян алдым, бірақ→
Dialogue: 0,0:11:17.62,0:11:21.62,Default,,0000,0000,0000,,Қоқыс жинауға әлі күшім жетеді.
Dialogue: 0,0:11:28.73,0:11:32.77,Default,,0000,0000,0000,,Балалар, сендерді өлтіргеннен кейін денсаулығыңның қалпына келуін күтіңдер →
Dialogue: 0,0:11:32.77,0:11:37.77,Default,,0000,0000,0000,,Мен бұл планетаны толығымен жоямын. Хахахаха.
Dialogue: 0,0:11:39.84,0:11:43.88,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:11:43.88,0:11:45.90,Default,,0000,0000,0000,,Балалар→
Dialogue: 0,0:11:45.90,0:11:52.97,Default,,0000,0000,0000,,Вегета-сама өз күшін шегіне жақындатуға мүмкіндік беріңіз.
Dialogue: 0,0:11:52.97,0:11:55.00,Default,,0000,0000,0000,,Ааа аа….
Dialogue: 0,0:11:55.00,0:11:57.02,Default,,0000,0000,0000,,Бірнеше адам қажет болса да→
Dialogue: 0,0:11:57.02,0:12:01.06,Default,,0000,0000,0000,,Қоқыспен күресу Бұл менің мақтанышымды жаралады.
Dialogue: 0,0:12:01.06,0:12:05.10,Default,,0000,0000,0000,,Балалар, кетіңдер!
Dialogue: 0,0:12:05.10,0:12:07.12,Default,,0000,0000,0000,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:12:07.12,0:12:13.51,Default,,0000,0000,0000,,Чич чикушо чикусо.
Dialogue: 0,0:12:13.51,0:12:17.55,Default,,0000,0000,0000,,Кум Гоку….
Dialogue: 0,0:12:17.55,0:12:19.57,Default,,0000,0000,0000,,Уау! →
Dialogue: 0,0:12:19.57,0:12:23.61,Default,,0000,0000,0000,,Ах! →
Dialogue: 0,0:12:23.61,0:12:29.67,Default,,0000,0000,0000,,Ta~!
Dialogue: 0,0:12:29.67,0:12:31.67,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:38.76,0:12:43.81,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:43.81,0:12:45.83,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:45.83,0:12:48.86,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:48.86,0:12:52.86,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:14:08.00,0:14:10.00,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:14:12.04,0:14:16.08,Default,,0000,0000,0000,,Хаха ха ха....
Dialogue: 0,0:14:16.08,0:14:30.22,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:30.22,0:14:35.27,Default,,0000,0000,0000,,Бля, бұл сондай аянышты жойқын күш. →
Dialogue: 0,0:14:35.27,0:14:40.32,Default,,0000,0000,0000,,Үшеуі де әлі әрең тірі.
Dialogue: 0,0:14:40.32,0:14:45.32,Default,,0000,0000,0000,,Ух, иә....
Dialogue: 0,0:14:47.39,0:14:49.39,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:14:53.45,0:14:56.48,Default,,0000,0000,0000,,Уа, зиян мен күткеннен де көп.
Dialogue: 0,0:14:56.48,0:15:02.48,Default,,0000,0000,0000,,Мен оларды тез аяқтап, біраз демалуым керек...
Dialogue: 0,0:15:07.92,0:15:10.92,Default,,0000,0000,0000,,Ааааааа….
Dialogue: 0,0:15:13.98,0:15:15.98,Default,,0000,0000,0000,,Ах... Ах!?
Dialogue: 0,0:15:19.04,0:15:23.08,Default,,0000,0000,0000,,Бұл бала→
Dialogue: 0,0:15:23.08,0:15:27.12,Default,,0000,0000,0000,,Құйрық қалпына келеді.
Dialogue: 0,0:15:27.12,0:15:30.15,Default,,0000,0000,0000,,Құйрық Құйрық….
Dialogue: 0,0:15:30.15,0:15:34.19,Default,,0000,0000,0000,,Байқадым, Гоку да баяғыда кенеттен құйрығы шығыпты. Сондай-ақ….
Dialogue: 0,0:15:34.19,0:15:36.19,Default,,0000,0000,0000,,Гу~.
Dialogue: 0,0:15:41.26,0:15:45.26,Default,,0000,0000,0000,,Әй, кетті!
Dialogue: 0,0:15:50.35,0:15:54.35,Default,,0000,0000,0000,,Егер сіз өзгеретін болсаңыз, сіз қиындыққа тап боласыз.
Dialogue: 0,0:15:57.42,0:16:03.81,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:16:03.81,0:16:07.85,Default,,0000,0000,0000,,Дория~! (Вегета) Не!?
Dialogue: 0,0:16:07.85,0:16:09.85,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:11.89,0:16:15.93,Default,,0000,0000,0000,,Гуа…. →
Dialogue: 0,0:16:15.93,0:16:17.93,Default,,0000,0000,0000,,A~.
Dialogue: 0,0:16:25.03,0:16:28.06,Default,,0000,0000,0000,,Ха...хахаха.
Dialogue: 0,0:16:28.06,0:16:32.10,Default,,0000,0000,0000,,Мен мұны істедім. Мен оны істедім. Хахаха! →
Dialogue: 0,0:16:32.10,0:16:37.15,Default,,0000,0000,0000,,Zamaa-samasase Buckyaro Heh Heh Heh Heh. →
Dialogue: 0,0:16:37.15,0:16:41.19,Default,,0000,0000,0000,,Ахахаха! Сіз қалай ойлайсыз? →
Dialogue: 0,0:16:41.19,0:16:44.22,Default,,0000,0000,0000,,Мен Яджиробе-самамен тең келе алмаймын.
Dialogue: 0,0:16:44.22,0:16:46.22,Default,,0000,0000,0000,,Хэхехе~.
Dialogue: 0,0:16:48.26,0:16:51.29,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:51.29,0:16:56.29,Default,,0000,0000,0000,,Өзің... бейбақ!
Dialogue: 0,0:17:00.71,0:17:04.71,Default,,0000,0000,0000,,Доля Доля Доля Доля...!
Dialogue: 0,0:17:08.79,0:17:11.82,Default,,0000,0000,0000,,Жоқ, кешіріңіз, ауырды ма?
Dialogue: 0,0:17:11.82,0:17:15.86,Default,,0000,0000,0000,,Бұл әзіл болды, бірақ үзіліп қалды. Ахах...
Dialogue: 0,0:17:15.86,0:17:18.89,Default,,0000,0000,0000,,Иә, мен сізді құрметтедім.
Dialogue: 0,0:17:18.89,0:17:21.92,Default,,0000,0000,0000,,Эй, маған қосылшы...? (Вегета) О, жоқ!
Dialogue: 0,0:17:21.92,0:17:23.92,Default,,0000,0000,0000,,A~.
Dialogue: 0,0:17:31.02,0:17:33.04,Default,,0000,0000,0000,,Дея~. →
Dialogue: 0,0:17:33.04,0:17:35.04,Default,,0000,0000,0000,,Дея!
Dialogue: 0,0:17:41.12,0:17:45.16,Default,,0000,0000,0000,,Яяджироби.
Dialogue: 0,0:17:45.16,0:17:49.20,Default,,0000,0000,0000,,Денемді жаралаған адам→
Dialogue: 0,0:17:49.20,0:17:52.23,Default,,0000,0000,0000,,Мен ешқашан... Мен сені ешқашан кешірмеймін.
Dialogue: 0,0:17:52.23,0:17:56.27,Default,,0000,0000,0000,,Читчикушо.
Dialogue: 0,0:17:56.27,0:18:00.65,Default,,0000,0000,0000,,《Гохан! →
Dialogue: 0,0:18:00.65,0:18:02.67,Default,,0000,0000,0000,,Гохан~! 》
Dialogue: 0,0:18:02.67,0:18:07.67,Default,,0000,0000,0000,,Уууууууууууууууууууууууу әкемнің дауысы.
Dialogue: 0,0:18:09.74,0:18:14.79,Default,,0000,0000,0000,,《Гохан, менің дауысымды тыңда》
Dialogue: 0,0:18:14.79,0:18:16.81,Default,,0000,0000,0000,,Ой-оу.
Dialogue: 0,0:18:16.81,0:18:20.85,Default,,0000,0000,0000,,《Аспандағы жарық шарына қара》
Dialogue: 0,0:18:20.85,0:18:27.92,Default,,0000,0000,0000,,Жарық шары? Жарық шары?
Dialogue: 0,0:18:27.92,0:18:29.92,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:36.01,0:18:38.03,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:38.03,0:18:41.06,Default,,0000,0000,0000,,Сен, қара нәсілді жексұрын!
Dialogue: 0,0:18:41.06,0:18:44.09,Default,,0000,0000,0000,,Аузыңды жап! Саған мұны істеуге рұқсат етемін бе? →
Dialogue: 0,0:18:44.09,0:18:46.11,Default,,0000,0000,0000,,Өл!
Dialogue: 0,0:18:46.11,0:18:51.11,Default,,0000,0000,0000,,О! Ол кетті.
Dialogue: 0,0:18:55.20,0:18:59.20,Default,,0000,0000,0000,,Эй, бұл бала, мен оны үлкен етіп көрсетуге қарсы тұра алмаймын!
Dialogue: 0,0:19:02.60,0:19:05.63,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:19:05.63,0:19:07.65,Default,,0000,0000,0000,,Мен сені қазір өлтіруім керек!
Dialogue: 0,0:19:07.65,0:19:10.68,Default,,0000,0000,0000,,《Гохан, өтінемін! 》
Dialogue: 0,0:19:10.68,0:19:15.73,Default,,0000,0000,0000,,Гохан ұлы маймылға айналады. Бұл хит немесе қате ставка.
Dialogue: 0,0:19:15.73,0:19:20.78,Default,,0000,0000,0000,,Иә, бұл құйрық. Мен асығыс болдым және маңызды нәрсені ұмытып кеттім! →
Dialogue: 0,0:19:20.78,0:19:22.80,Default,,0000,0000,0000,,Құйрықты кескенше!
Dialogue: 0,0:19:22.80,0:19:24.82,Default,,0000,0000,0000,,Нуо~!
Dialogue: 0,0:19:24.82,0:19:32.90,Default,,0000,0000,0000,,(үру)
Dialogue: 0,0:19:32.90,0:19:34.90,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:45.03,0:19:48.03,Default,,0000,0000,0000,,(үру)
Dialogue: 0,0:19:51.09,0:19:53.09,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:19:57.15,0:19:59.34,Default,,0000,0000,0000,,Гохан….
Dialogue: 0,0:19:59.34,0:20:01.52,Default,,0000,0000,0000,,Алайда Гоку ұлы маймылға айналғанда→
Dialogue: 0,0:20:01.52,0:20:06.52,Default,,0000,0000,0000,,Ешқандай себеп болған жоқ. Ал Гохан ше?
Dialogue: 0,0:20:08.59,0:20:11.62,Default,,0000,0000,0000,,(үру)
Dialogue: 0,0:20:11.62,0:20:13.64,Default,,0000,0000,0000,,Гохан да солай.
Dialogue: 0,0:20:13.64,0:20:16.67,Default,,0000,0000,0000,,Түсіндім, бұл Гоку мен Гоханның ақылын жоғалтқаны емес→
Dialogue: 0,0:20:16.67,0:20:21.67,Default,,0000,0000,0000,,Ұлы маймыл болған кезде ғана қатыгез Сайян болып қайтасың.
Dialogue: 0,0:20:24.75,0:20:26.75,Default,,0000,0000,0000,,(үру)
Dialogue: 0,0:20:28.79,0:20:30.81,Default,,0000,0000,0000,,(үру)
Dialogue: 0,0:20:30.81,0:20:32.83,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:32.83,0:20:36.87,Default,,0000,0000,0000,,Гохан~!
Dialogue: 0,0:20:36.87,0:20:38.87,Default,,0000,0000,0000,,《Гохан! 》
Dialogue: 0,0:20:40.91,0:20:46.97,Default,,0000,0000,0000,,《Гохан~! 》
Dialogue: 0,0:20:46.97,0:20:48.99,Default,,0000,0000,0000,,Гохан….
Dialogue: 0,0:20:48.99,0:20:53.99,Default,,0000,0000,0000,,Бұл Сайян. Сайян бол!
Dialogue: 0,0:21:00.44,0:21:03.47,Default,,0000,0000,0000,,А, анау жігіт...
Dialogue: 0,0:21:03.47,0:21:06.50,Default,,0000,0000,0000,,《Гохан~! 》
Dialogue: 0,0:21:06.50,0:21:08.52,Default,,0000,0000,0000,,(үру)
Dialogue: 0,0:21:08.52,0:21:10.52,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:12.56,0:21:16.60,Default,,0000,0000,0000,,Жақсы, Гоханның жүрегінің кішкене бөлігі ғана қалды.
Dialogue: 0,0:21:16.60,0:21:21.60,Default,,0000,0000,0000,,Дұрыс, ол жартылай жерлік.
Dialogue: 0,0:21:28.72,0:21:32.76,Default,,0000,0000,0000,,Мен жасаған ай тағы бір сағатта жоғалмайды.
Dialogue: 0,0:21:32.76,0:21:34.78,Default,,0000,0000,0000,,Құйрықты кесуден басқа амалым жоқ.
Dialogue: 0,0:21:34.78,0:21:37.81,Default,,0000,0000,0000,,(үру)
Dialogue: 0,0:21:37.81,0:21:39.83,Default,,0000,0000,0000,,Иә! →
Dialogue: 0,0:21:39.83,0:21:43.87,Default,,0000,0000,0000,,Дея~ Тат!
Dialogue: 0,0:21:43.87,0:21:45.89,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:21:45.89,0:21:48.89,Default,,0000,0000,0000,,Ta~!
Dialogue: 0,0:21:50.94,0:21:54.94,Default,,0000,0000,0000,,Дея~!
Dialogue: 0,0:21:58.02,0:22:00.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:06.44,0:22:12.50,Default,,0000,0000,0000,,Гу~! Қарғыс атсын! Қуат...
Dialogue: 0,0:22:12.50,0:22:16.50,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:22:23.61,0:22:26.64,Default,,0000,0000,0000,,Ой, менің денем қозғалмайды. →
Dialogue: 0,0:22:26.64,0:22:32.64,Default,,0000,0000,0000,,Ааааааааа~!
Dialogue: 0,0:22:40.78,0:22:43.78,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:22:51.89,0:22:55.93,Default,,0000,0000,0000,,А, сен мұны істедің бе?
Dialogue: 0,0:22:55.93,0:22:57.93,Default,,0000,0000,0000,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:23:08.39,0:23:12.43,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:23:12.43,0:23:14.43,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:23:19.50,0:23:22.53,Default,,0000,0000,0000,,Тоқта, сен әлі тірісің бе...? →
Dialogue: 0,0:23:22.53,0:23:24.55,Default,,0000,0000,0000,,Не? Міне бітті.
Dialogue: 0,0:23:24.55,0:23:26.55,Default,,0000,0000,0000,,Келдің бе?
Dialogue: 0,0:23:30.61,0:23:35.61,Default,,0000,0000,0000,,Ууууууууууууууу….
Dialogue: 0,0:23:39.70,0:23:44.70,Default,,0000,0000,0000,,Мен ешқашан артқа бұрыламын деп ойламадым...
Dialogue: 0,0:23:47.78,0:23:49.80,Default,,0000,0000,0000,,Ааааа….
Dialogue: 0,0:23:49.80,0:23:53.84,Default,,0000,0000,0000,,Чичи Чикусо өзін әлемдегі ең күшті жауынгер деп айтқан→
Dialogue: 0,0:23:53.84,0:23:58.89,Default,,0000,0000,0000,,Бұл көкөніс...
Dialogue: 0,0:23:58.89,0:24:04.95,Default,,0000,0000,0000,,Бұл оның ғарыш кемесі. Оның қашып кетуін күту мүмкін емес.
Dialogue: 0,0:24:04.95,0:24:17.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:17.08,0:24:23.08,Default,,0000,0000,0000,,Енді сіз осы уақытқа дейін жеттіңіз, мен сізге соңғы соққыны беремін.
Dialogue: 0,0:24:25.16,0:24:29.20,Default,,0000,0000,0000,,Гугугугу….
Dialogue: 0,0:24:29.20,0:24:31.20,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:24:35.26,0:24:40.31,Default,,0000,0000,0000,,Өлгеннің бәрінің кегі.
Dialogue: 0,0:24:40.31,0:24:42.33,Default,,0000,0000,0000,,Өзіңізді дайындаңыз!
Dialogue: 0,0:24:42.33,0:24:46.37,Default,,0000,0000,0000,,Сіздің денеңіз сізге не айтады...
Dialogue: 0,0:24:46.37,0:24:48.37,Default,,0000,0000,0000,,Дея~!
Dialogue: 0,0:24:51.42,0:24:56.47,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:56.47,0:25:16.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:16.00,0:25:36.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:36.20,0:25:49.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:53.37,0:25:58.42,Default,,0000,0000,0000,,Сәлем, Гоку. Криллин Гохан, сіз осы уақытқа дейін жеттіңіз.
Dialogue: 0,0:25:58.42,0:26:00.77,Default,,0000,0000,0000,,Бәрі де жеңілді.
Dialogue: 0,0:26:00.77,0:26:04.81,Default,,0000,0000,0000,,Пикколо мырза қайтыс болды, Құдай да жоғалып кетті.
Dialogue: 0,0:26:04.81,0:26:07.84,Default,,0000,0000,0000,,Бірақ мен дұрыс болсам →
Dialogue: 0,0:26:07.84,0:26:09.86,Default,,0000,0000,0000,,Айдаһар допты алуыңыз мүмкін.
Dialogue: 0,0:26:09.86,0:26:12.86,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:15.92,0:26:18.92,Default,,0000,0000,0000,,Намек планетасы қайда орналасқан?
Dialogue: 0,0:26:20.42,0:26:26.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory