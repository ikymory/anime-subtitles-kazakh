Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.68,0:00:16.72,Default,,0000,0000,0000,,<Гоку мен Криллин Вегетаны өткізіп алды. →
Dialogue: 0,0:00:16.72,0:00:19.72,Default,,0000,0000,0000,,Шайқас аяқталды>
Dialogue: 0,0:00:21.77,0:00:25.81,Default,,0000,0000,0000,,<Достарыңызды сақтаңыз, Айдаһар шарын іздеңіз→
Dialogue: 0,0:00:25.81,0:00:30.86,Default,,0000,0000,0000,,Барлығы жаңа мақсатқа оянады, бірақ...>
Dialogue: 0,0:00:30.86,0:00:35.86,Default,,0000,0000,0000,,Хахахаха! Нәмек планетасына ұмтылыңыз! Хахахаха!
Dialogue: 0,0:00:37.93,0:00:42.98,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:42.98,0:01:02.18,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:02.18,0:01:22.71,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:22.71,0:01:42.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:42.91,0:01:59.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:22.84,0:04:25.87,Default,,0000,0000,0000,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:04:25.87,0:04:29.91,Default,,0000,0000,0000,,Менің жолым болды. Гохан екеуміз үш күн ауруханада жатсақ →
Dialogue: 0,0:04:29.91,0:04:32.94,Default,,0000,0000,0000,,Бұл тамаша. (Сон Гоку), кешіріңіз.
Dialogue: 0,0:04:32.94,0:04:35.97,Default,,0000,0000,0000,,Менің жарақатымның жазылуы үшін төрт ай қажет.
Dialogue: 0,0:04:35.97,0:04:39.01,Default,,0000,0000,0000,,Тіпті бұл қалыпты жағдайға оралмауы мүмкін.
Dialogue: 0,0:04:39.01,0:04:41.03,Default,,0000,0000,0000,,Мен уайымдап тұрмын.
Dialogue: 0,0:04:41.03,0:04:45.07,Default,,0000,0000,0000,,Бір айдан кейін жаңа сензу бұршақтары дайын болады.
Dialogue: 0,0:04:45.07,0:04:49.11,Default,,0000,0000,0000,,Хехе~ Бірақ сіз міндетті түрде мумиясыз.
Dialogue: 0,0:04:49.11,0:04:53.15,Default,,0000,0000,0000,,Мен осындай қатыгез жағдайға тап болсам да, ауруханаға түскен жоқпын.
Dialogue: 0,0:04:53.15,0:04:56.18,Default,,0000,0000,0000,,Маған сайян шабуылдағалы тұрғанда →
Dialogue: 0,0:04:56.18,0:05:00.22,Default,,0000,0000,0000,,«Кешіріңіз~ мен сізді құрметтеймін.→
Dialogue: 0,0:05:00.22,0:05:03.25,Default,,0000,0000,0000,,Сені дос қылайық!'' Ол не деді?
Dialogue: 0,0:05:03.25,0:05:08.30,Default,,0000,0000,0000,,Мен сені үрлеймін! Бұл оны абайсызда ұстау үшін!
Dialogue: 0,0:05:08.30,0:05:10.32,Default,,0000,0000,0000,,Хахаха!
Dialogue: 0,0:05:10.32,0:05:13.69,Default,,0000,0000,0000,,Сіз не істесеңіз де, барлығы жақсы жұмыс жасады.
Dialogue: 0,0:05:13.69,0:05:15.71,Default,,0000,0000,0000,,Мен ешқашан мұндай бақытты болған емеспін.
Dialogue: 0,0:05:15.71,0:05:19.75,Default,,0000,0000,0000,,Қайтыс болғандардың бәрі қайта тірілетін сияқты.
Dialogue: 0,0:05:19.75,0:05:22.78,Default,,0000,0000,0000,,Әй, бәрі, бәрі, теледидар көріңдер! Теледидар!
Dialogue: 0,0:05:22.78,0:05:26.82,Default,,0000,0000,0000,,Не, гүлденушілер? Мен оны қорқынышты медбике деп ойладым.
Dialogue: 0,0:05:26.82,0:05:30.86,Default,,0000,0000,0000,,Шулы. Қараңыз, теледидар қараңыз.
Dialogue: 0,0:05:30.86,0:05:34.90,Default,,0000,0000,0000,,Бұл нысан қираған шығыс астанадан табылды→
Dialogue: 0,0:05:34.90,0:05:36.92,Default,,0000,0000,0000,,Растау мүмкін болмаса да →
Dialogue: 0,0:05:36.92,0:05:38.94,Default,,0000,0000,0000,,Ол ғарыштан келген көлікке ұқсайды.
Dialogue: 0,0:05:38.94,0:05:40.96,Default,,0000,0000,0000,,Бұл Сайян!
Dialogue: 0,0:05:40.96,0:05:43.99,Default,,0000,0000,0000,,Дұрыс? Мен оны көре алмаймын.
Dialogue: 0,0:05:43.99,0:05:46.02,Default,,0000,0000,0000,,Бұл нысан ашылғанда, екеуі бар сияқты болды.
Dialogue: 0,0:05:46.02,0:05:50.06,Default,,0000,0000,0000,,Соның бірі – оның оқиға орнынан кенет ұшып кетуі.
Dialogue: 0,0:05:50.06,0:05:54.10,Default,,0000,0000,0000,,Бұл жаман. Ғалымдар қазірдің өзінде оны жүзеге асыруда.
Dialogue: 0,0:05:54.10,0:05:58.14,Default,,0000,0000,0000,,Бұл қызық емес. Криллин әкелген осы қашықтан басқару пульті арқылы →
Dialogue: 0,0:05:58.14,0:06:01.17,Default,,0000,0000,0000,,Мына нәрсені атайық. →
Dialogue: 0,0:06:01.17,0:06:05.21,Default,,0000,0000,0000,,Сіз таң қаласыз~ Мен сенімдімін. Жақсы өтеді деп үміттенемін.
Dialogue: 0,0:06:05.21,0:06:08.24,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Мен данышпанмын.
Dialogue: 0,0:06:08.24,0:06:12.61,Default,,0000,0000,0000,,Мен біраз зерттеу жүргіздім. Маған қара~
Dialogue: 0,0:06:12.61,0:06:14.63,Default,,0000,0000,0000,,Иә дыбыстық сигнал. →
Dialogue: 0,0:06:14.63,0:06:16.65,Default,,0000,0000,0000,,Жарайсың ба? Ол қозғалады.
Dialogue: 0,0:06:16.65,0:06:20.69,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:06:20.69,0:06:24.73,Default,,0000,0000,0000,,Олаға да қараңыз. (электронды дыбыс)
Dialogue: 0,0:06:24.73,0:06:26.75,Default,,0000,0000,0000,,Уау! →
Dialogue: 0,0:06:26.75,0:06:29.78,Default,,0000,0000,0000,,Кенет сол зат жарылып кетті! →
Dialogue: 0,0:06:29.78,0:06:33.82,Default,,0000,0000,0000,,Не болды!? Заттардың қалдықтары барлық жерде шашылып жатыр!
Dialogue: 0,0:06:33.82,0:06:39.88,Default,,0000,0000,0000,,Неліктен? Бұл қазіргі өзін-өзі жою қосқышы болды ма деп ойлаймын.
Dialogue: 0,0:06:39.88,0:06:43.92,Default,,0000,0000,0000,,Біз не істеуіміз керек? Егер бізде ол ғарыш кемесі болмаса, біз Намекте боламыз →
Dialogue: 0,0:06:43.92,0:06:46.95,Default,,0000,0000,0000,,Мен бара алмаймын! Менің соңғы үмітім...
Dialogue: 0,0:06:46.95,0:06:50.95,Default,,0000,0000,0000,,Ол толығымен кесілді. Бұл енді жақсы емес.
Dialogue: 0,0:06:52.01,0:06:55.04,Default,,0000,0000,0000,,Себебі сіз біртүрлі қашықтан басқару құралын аласыз.
Dialogue: 0,0:06:55.04,0:06:59.08,Default,,0000,0000,0000,,Бұлма-сан, сен қосқышты абайсыз басқансың.
Dialogue: 0,0:06:59.08,0:07:03.12,Default,,0000,0000,0000,,Сәлем. иә? Апыр-ай!
Dialogue: 0,0:07:03.12,0:07:05.14,Default,,0000,0000,0000,,Ой~сс.
Dialogue: 0,0:07:05.14,0:07:08.14,Default,,0000,0000,0000,,Ахаха! Попо мырза.
Dialogue: 0,0:07:10.19,0:07:14.56,Default,,0000,0000,0000,,Менің артымнан біреу келе жатыр. Ғарыш кемесі бар. (Барлығы) Иә!?
Dialogue: 0,0:07:14.56,0:07:17.59,Default,,0000,0000,0000,,Ғарыш кемесі? Ол шынымен бар ма? Попо мырза.
Dialogue: 0,0:07:17.59,0:07:19.61,Default,,0000,0000,0000,,Мүмкін.
Dialogue: 0,0:07:19.61,0:07:21.63,Default,,0000,0000,0000,,О, бұл не? Бұл Попо мырза.
Dialogue: 0,0:07:21.63,0:07:23.65,Default,,0000,0000,0000,,Попо мырза?
Dialogue: 0,0:07:23.65,0:07:27.69,Default,,0000,0000,0000,,Біз Құдаймен біргеміз. Бірақ қазіргі Құдайға қарағанда →
Dialogue: 0,0:07:27.69,0:07:31.73,Default,,0000,0000,0000,,Ол ұзақ уақыт бойы құдайдың сарайында болды.
Dialogue: 0,0:07:31.73,0:07:33.75,Default,,0000,0000,0000,,Хоо~.
Dialogue: 0,0:07:33.75,0:07:35.77,Default,,0000,0000,0000,,Эй, эй, бұл «мүмкін» нені білдіреді?
Dialogue: 0,0:07:35.77,0:07:39.81,Default,,0000,0000,0000,,Мүмкін бұл ғарыш кемесі шығар.
Dialogue: 0,0:07:39.81,0:07:42.84,Default,,0000,0000,0000,,Бірақ Попо мырза, мен шынымен түсінбеймін. →
Dialogue: 0,0:07:42.84,0:07:46.88,Default,,0000,0000,0000,,Біреу менімен бірге келіп, білуін өтінемін. Попо мырза сізге айналаңызды көрсетеді.
Dialogue: 0,0:07:46.88,0:07:48.90,Default,,0000,0000,0000,,Аха, Бұлма мырза.
Dialogue: 0,0:07:48.90,0:07:51.93,Default,,0000,0000,0000,,Не... мен!?
Dialogue: 0,0:07:51.93,0:07:53.95,Default,,0000,0000,0000,,Өйткені ол Бұлма-сан→ болуы керек
Dialogue: 0,0:07:53.95,0:07:57.99,Default,,0000,0000,0000,,Мен ғарыш кемелері туралы ештеңе білмеймін.
Dialogue: 0,0:07:57.99,0:08:00.02,Default,,0000,0000,0000,,Бұлма мырза?
Dialogue: 0,0:08:00.02,0:08:04.06,Default,,0000,0000,0000,,Жақсысың ба? Әй, ол кісінің көзінде қауіпті нәрсе бар емес пе?
Dialogue: 0,0:08:04.06,0:08:06.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:06.08,0:08:11.30,Default,,0000,0000,0000,,
Dialogue: 0,0:08:11.30,0:08:13.49,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:08:13.49,0:08:27.63,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:27.63,0:08:29.65,Default,,0000,0000,0000,,Сен сұрадың, Бұлма.
Dialogue: 0,0:08:29.65,0:08:31.67,Default,,0000,0000,0000,,Мұқият жүріңіз.
Dialogue: 0,0:08:31.67,0:08:36.67,Default,,0000,0000,0000,,Кеттік. Ақырын, ақырын.
Dialogue: 0,0:08:45.81,0:08:48.81,Default,,0000,0000,0000,,келді. иә? Қазірдің өзінде?
Dialogue: 0,0:08:57.93,0:08:59.95,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:08:59.95,0:09:01.97,Default,,0000,0000,0000,,Түсіңіз.
Dialogue: 0,0:09:01.97,0:09:06.02,Default,,0000,0000,0000,,Қайда? Мұнда. Әйтеуір салқын.
Dialogue: 0,0:09:06.02,0:09:10.06,Default,,0000,0000,0000,,Юнзавит таулары. Юн аз!?
Dialogue: 0,0:09:10.06,0:09:14.43,Default,,0000,0000,0000,,Жердің шеттері емес! Бұл жерге әп-сәтте қалай келдіңіз?
Dialogue: 0,0:09:14.43,0:09:16.45,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:09:16.45,0:09:20.49,Default,,0000,0000,0000,,Ол қайда болды? Менің ойымша, бұл осы болды.
Dialogue: 0,0:09:20.49,0:09:22.49,Default,,0000,0000,0000,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:09:27.56,0:09:31.60,Default,,0000,0000,0000,,Әй, мұндай жерде ғарыш кемесіне ұқсайтын нәрсе бар ма?
Dialogue: 0,0:09:31.60,0:09:34.60,Default,,0000,0000,0000,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:09:42.71,0:09:45.74,Default,,0000,0000,0000,,Уф... Мен сенен бұзақылық жасайды деп күтпедім →
Dialogue: 0,0:09:45.74,0:09:50.74,Default,,0000,0000,0000,,Мені мұндай шалғай жерге апармағаныңызға сенімдімін.
Dialogue: 0,0:09:52.81,0:09:55.84,Default,,0000,0000,0000,,А... Әй, эй! Тез кел.
Dialogue: 0,0:09:55.84,0:09:59.84,Default,,0000,0000,0000,,Эй, сен қалжыңдап тұрсың. Бұл менмін...
Dialogue: 0,0:10:01.90,0:10:03.90,Default,,0000,0000,0000,,Қазірдің өзінде...
Dialogue: 0,0:10:09.98,0:10:11.16,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:10:11.16,0:10:13.16,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:10:22.44,0:10:25.44,Default,,0000,0000,0000,,Ғарыш кемесі? Мен оны қарауым керек ...
Dialogue: 0,0:10:32.54,0:10:37.59,Default,,0000,0000,0000,,Не? Бұл тіпті металл емес, және бұл сияқты ...
Dialogue: 0,0:10:37.59,0:10:39.61,Default,,0000,0000,0000,,Эй, сен не айтып тұрсың?
Dialogue: 0,0:10:39.61,0:10:43.65,Default,,0000,0000,0000,,Бұл не екенін түсіндіріңіз.
Dialogue: 0,0:10:43.65,0:10:48.70,Default,,0000,0000,0000,,Шамамен 100 жыл бұрын, Құдай, мен Попо мырзамен көп уақыт бұрын сөйлескенмін. →
Dialogue: 0,0:10:48.70,0:10:53.75,Default,,0000,0000,0000,,Құдай Бала кезімде Юнзабитте тұрдым. →
Dialogue: 0,0:10:53.75,0:10:55.77,Default,,0000,0000,0000,,Попо мырза сұрады.
Dialogue: 0,0:10:55.77,0:10:58.80,Default,,0000,0000,0000,,Юнзабит – шалғай жер. Онда адамдар тұра алмаса да →
Dialogue: 0,0:10:58.80,0:11:00.82,Default,,0000,0000,0000,,Неліктен мұндай жерде болдың?
Dialogue: 0,0:11:00.82,0:11:04.86,Default,,0000,0000,0000,,《Неге болғаныңды түсінбедім. →
Dialogue: 0,0:11:04.86,0:11:06.88,Default,,0000,0000,0000,,Басыңды ұрған сияқтысың →
Dialogue: 0,0:11:06.88,0:11:09.91,Default,,0000,0000,0000,,Осы уақытқа дейінгі барлық естеліктер жоғалып кетті.
Dialogue: 0,0:11:09.91,0:11:12.27,Default,,0000,0000,0000,,《Ата-анаң сонда болмады ма? 》 (Құдай) 《Ол жоқ еді. →
Dialogue: 0,0:11:12.27,0:11:17.32,Default,,0000,0000,0000,,Мен алған жалғыз нәрсе: ''Мен сонда келемін, күте тұрыңыз'' деген хат болды.
Dialogue: 0,0:11:17.32,0:11:20.35,Default,,0000,0000,0000,,Сіз нені айтасыз? Мен оқиғаны көре алмаймын.
Dialogue: 0,0:11:20.35,0:11:25.40,Default,,0000,0000,0000,,Бала кезімде Алла тағала әке-шешемді күтетін.
Dialogue: 0,0:11:25.40,0:11:28.43,Default,,0000,0000,0000,,《Юнзабиттің лайықты үйі болды. →
Dialogue: 0,0:11:28.43,0:11:32.47,Default,,0000,0000,0000,,Мен ата-анам міндетті түрде ол жерге оралады деп сендім. →
Dialogue: 0,0:11:32.47,0:11:37.52,Default,,0000,0000,0000,,Алайда қанша күтсек те, ешкім келмеді. →
Dialogue: 0,0:11:37.52,0:11:40.55,Default,,0000,0000,0000,,Біз қанша уақыт күттік? →
Dialogue: 0,0:11:40.55,0:11:44.59,Default,,0000,0000,0000,,20 жыл... А, жоқ, жоқ, мүмкін 30 жыл. →
Dialogue: 0,0:11:44.59,0:11:49.64,Default,,0000,0000,0000,,Ақырында бас тарттым, үйімді тастап, Юнзабитті тастадым. →
Dialogue: 0,0:11:49.64,0:11:54.69,Default,,0000,0000,0000,,Кейде мен не болып жатқанын көру үшін қайта оралдым, бірақ ештеңе өзгермеді.
Dialogue: 0,0:11:54.69,0:11:57.72,Default,,0000,0000,0000,,Эй, мұның бұған не қатысы бар?
Dialogue: 0,0:11:57.72,0:12:01.76,Default,,0000,0000,0000,,Сіз шыдамсызсыз. Мәселе қазір.
Dialogue: 0,0:12:01.76,0:12:05.80,Default,,0000,0000,0000,,《Хехе, бәрібір қазір есіме түссем, біртүрлі үй екен. →
Dialogue: 0,0:12:05.80,0:12:08.83,Default,,0000,0000,0000,,Дүниемен танысқаннан кейін мен → екенін түсіндім
Dialogue: 0,0:12:08.83,0:12:11.03,Default,,0000,0000,0000,,Бұл үй шынымен басқаша болды. →
Dialogue: 0,0:12:11.03,0:12:15.24,Default,,0000,0000,0000,,Дөңгелек, жәндік сияқты төрт аяғы бар. →
Dialogue: 0,0:12:15.24,0:12:19.28,Default,,0000,0000,0000,,Есіктің тұтқасы немесе құлпы жоқ; бір сөз айтқан кезде ашылады.
Dialogue: 0,0:12:19.28,0:12:23.28,Default,,0000,0000,0000,,«Пиколо». Пи….
Dialogue: 0,0:12:25.34,0:12:27.34,Default,,0000,0000,0000,,Кіреберіс...
Dialogue: 0,0:12:30.39,0:12:34.39,Default,,0000,0000,0000,,Осыған көтеріліп көріңіз. иә?
Dialogue: 0,0:12:38.47,0:12:42.51,Default,,0000,0000,0000,,Бұл Алланың үйі... Қайта айт, жабылады.
Dialogue: 0,0:12:42.51,0:12:44.51,Default,,0000,0000,0000,,«Пиколо»
Dialogue: 0,0:12:51.60,0:12:56.65,Default,,0000,0000,0000,,Мұқият қараңыз. Бұл үй емес, ғарыш кемесі ме?
Dialogue: 0,0:12:56.65,0:13:00.69,Default,,0000,0000,0000,,Иә, түсінемін! Құдай - Намекиан.
Dialogue: 0,0:13:00.69,0:13:02.71,Default,,0000,0000,0000,,Мұны Кай патша деген біреу айтты.
Dialogue: 0,0:13:02.71,0:13:05.74,Default,,0000,0000,0000,,Ұзақ уақыт бұрын Намек планетасы әдеттен тыс ауа райына байланысты жойылу алдында тұрған...
Dialogue: 0,0:13:05.74,0:13:09.78,Default,,0000,0000,0000,,Попо мырза да Кай патшаның сөйлегенін естіді.
Dialogue: 0,0:13:09.78,0:13:13.15,Default,,0000,0000,0000,,Мен осында келдім, осылай болды.
Dialogue: 0,0:13:13.15,0:13:16.18,Default,,0000,0000,0000,,Шынында да, егер бұл ғарыш кемесі болса →
Dialogue: 0,0:13:16.18,0:13:18.20,Default,,0000,0000,0000,,Бұл мағынасы бар.
Dialogue: 0,0:13:18.20,0:13:21.23,Default,,0000,0000,0000,,Намек планетасы: қорқынышты нәрсе болған кезде Құдайдың ата-анасы →
Dialogue: 0,0:13:21.23,0:13:25.27,Default,,0000,0000,0000,,Бала құдайды көтеріп, Жерге ұштым.
Dialogue: 0,0:13:25.27,0:13:28.30,Default,,0000,0000,0000,,Менің ата-анам кейінірек қашуды жоспарлаған, бірақ →
Dialogue: 0,0:13:28.30,0:13:32.34,Default,,0000,0000,0000,,Апат болды... Дұрыс, өйткені →
Dialogue: 0,0:13:32.34,0:13:35.37,Default,,0000,0000,0000,,Қалай қарасаңыз да, бұл үй сияқты емес.
Dialogue: 0,0:13:35.37,0:13:40.42,Default,,0000,0000,0000,,Мен бұл ғарыш кемесі екеніне сенімдімін!
Dialogue: 0,0:13:40.42,0:13:43.45,Default,,0000,0000,0000,,Бірақ солай болса да, оны қолдануға болады ма деп ойлаймын... →
Dialogue: 0,0:13:43.45,0:13:46.48,Default,,0000,0000,0000,,Кіреберіс қозғалды, сондықтан қуат болуы керек.
Dialogue: 0,0:13:46.48,0:13:48.50,Default,,0000,0000,0000,,Бұл негізгі қосқыш па?
Dialogue: 0,0:13:48.50,0:13:52.54,Default,,0000,0000,0000,,Жоқ. Бұл...
Dialogue: 0,0:13:52.54,0:13:55.57,Default,,0000,0000,0000,,Мм... Уау!
Dialogue: 0,0:13:55.57,0:13:57.59,Default,,0000,0000,0000,,Бұл да басқа.
Dialogue: 0,0:13:57.59,0:14:02.64,Default,,0000,0000,0000,,Бұл біртүрлі. Бұл да кодтық нөмір ме деп ойлаймын.
Dialogue: 0,0:14:02.64,0:14:05.67,Default,,0000,0000,0000,,Бұл қосқышпен немесе басқа нәрсемен жұмыс істемейтін сияқты. →
Dialogue: 0,0:14:05.67,0:14:09.71,Default,,0000,0000,0000,,Мен білмеймін. Бұл сенсордың бір түрі ма деп ойлаймын.
Dialogue: 0,0:14:09.71,0:14:11.73,Default,,0000,0000,0000,,Иә? Бұл дауыс па?
Dialogue: 0,0:14:11.73,0:14:14.76,Default,,0000,0000,0000,,Дұрыс, сол кіреберіс сияқты сөздер!
Dialogue: 0,0:14:14.76,0:14:16.78,Default,,0000,0000,0000,,Сіз нені айтасыз? «Пиколо»?
Dialogue: 0,0:14:16.78,0:14:21.83,Default,,0000,0000,0000,,Жоқ, себебі бұл кіру және шығу кезіндегі құпия сөз.
Dialogue: 0,0:14:21.83,0:14:26.88,Default,,0000,0000,0000,,Қозғал, мені естисің бе? Сенің ұшып бара жатқаныңды көрейін.
Dialogue: 0,0:14:26.88,0:14:31.93,Default,,0000,0000,0000,,Жақсы емес...сөздері басқа. Мен оны Намекиан тілінде айтуым керек.
Dialogue: 0,0:14:31.93,0:14:34.96,Default,,0000,0000,0000,,Өйткені баяғыда Немересі Пикколоға қарсы кездескен кезде→
Dialogue: 0,0:14:34.96,0:14:38.00,Default,,0000,0000,0000,,Мен сіздің біртүрлі сөздер айтып жатқаныңызды естідім.
Dialogue: 0,0:14:38.00,0:14:41.03,Default,,0000,0000,0000,,Мен бұл Намекян екеніне сенімдімін.
Dialogue: 0,0:14:41.03,0:14:44.06,Default,,0000,0000,0000,,Егер бұл Намекян болса, Попо мырза, мен түсінемін.
Dialogue: 0,0:14:44.06,0:14:46.08,Default,,0000,0000,0000,,Шынымен!? Шынымен.
Dialogue: 0,0:14:46.08,0:14:49.11,Default,,0000,0000,0000,,«Пиколо» сөзі «басқа әлем» дегенді білдіреді.
Dialogue: 0,0:14:49.11,0:14:52.14,Default,,0000,0000,0000,,Сондықтан кіру және шығу үшін құпия сөз.
Dialogue: 0,0:14:52.14,0:14:57.19,Default,,0000,0000,0000,,Маған тезірек айтыңызшы. «Пиколо Даймау» →
Dialogue: 0,0:14:57.19,0:15:00.22,Default,,0000,0000,0000,,Бұл `` Басқа әлемнің ұлы жын патшасы '' →
Dialogue: 0,0:15:00.22,0:15:04.26,Default,,0000,0000,0000,,Эй, "ұшу" деп айтып көріңіз. Қайда ұшасыз?
Dialogue: 0,0:15:04.26,0:15:09.31,Default,,0000,0000,0000,,Хмм, кез келген жерде жақсы. Әзірге Юпитер айналасында.
Dialogue: 0,0:15:09.31,0:15:12.31,Default,,0000,0000,0000,,Тофур Баузер Голопунго.
Dialogue: 0,0:15:19.74,0:15:21.76,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:15:21.76,0:15:32.87,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:15:32.87,0:15:35.90,Default,,0000,0000,0000,,Уау~ Өте керемет. →
Dialogue: 0,0:15:35.90,0:15:38.93,Default,,0000,0000,0000,,Юпитер! Бұл таңғажайып ғарыш кемесі!
Dialogue: 0,0:15:38.93,0:15:41.96,Default,,0000,0000,0000,,Иә, иә! Алақай! →
Dialogue: 0,0:15:41.96,0:15:43.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:15:43.98,0:15:48.98,Default,,0000,0000,0000,,Жақсы, Құдай мұнымен міндетті түрде қайта тіріледі.
Dialogue: 0,0:17:09.84,0:17:11.86,Default,,0000,0000,0000,,Ғарыш кемесі дұрыс.
Dialogue: 0,0:17:11.86,0:17:15.90,Default,,0000,0000,0000,,Бұл кеме Намекке бір айда жетеді.
Dialogue: 0,0:17:15.90,0:17:18.93,Default,,0000,0000,0000,,Осыдан кейін ішін аздап өзгерттім →
Dialogue: 0,0:17:18.93,0:17:22.97,Default,,0000,0000,0000,,Хмм, иә, мен бес күннен кейін кете аламын.
Dialogue: 0,0:17:22.97,0:17:24.99,Default,,0000,0000,0000,,Құдайдың ғарыш кемесі Намек планетасы?
Dialogue: 0,0:17:24.99,0:17:27.02,Default,,0000,0000,0000,,Кішкене жарық шындыққа айналады.
Dialogue: 0,0:17:27.02,0:17:31.06,Default,,0000,0000,0000,,Сондықтан Попо-сан, мен Намек планетасына барамын, өтінемін.
Dialogue: 0,0:17:31.06,0:17:34.09,Default,,0000,0000,0000,,Айқай? Попо мырза мен бармаймын. иә?
Dialogue: 0,0:17:34.09,0:17:36.11,Default,,0000,0000,0000,,Попо мырза мен бармаймын.
Dialogue: 0,0:17:36.11,0:17:40.15,Default,,0000,0000,0000,,Құдай сарайы екі ай бойы жоғалып кетті Жақсылық жоқ.
Dialogue: 0,0:17:40.15,0:17:45.20,Default,,0000,0000,0000,,Міне! Өйткені Намекянды түсінетін жалғыз сенсің.
Dialogue: 0,0:17:45.20,0:17:48.23,Default,,0000,0000,0000,,Бұл қиын сияқты, сондықтан мен Попо-санға баруын сұрауым керек.
Dialogue: 0,0:17:48.23,0:17:51.26,Default,,0000,0000,0000,,Уайымдама, мен саған Намекянды үйретемін. Ууууу….
Dialogue: 0,0:17:51.26,0:17:54.29,Default,,0000,0000,0000,,Сонда Бұлма-санның барудан басқа амалы жоқ.
Dialogue: 0,0:17:54.29,0:17:58.33,Default,,0000,0000,0000,,Бірдеңе болып қалса, механика туралы ештеңе білетін жалғыз адам Бұлма-сан.
Dialogue: 0,0:17:58.33,0:18:02.37,Default,,0000,0000,0000,,Жарайды. Бұл аса қауіпті емес сияқты.
Dialogue: 0,0:18:02.37,0:18:06.74,Default,,0000,0000,0000,,Бірақ мен жалғыз барғым келмейді. Менің артымнан біреу жүр.
Dialogue: 0,0:18:06.74,0:18:09.77,Default,,0000,0000,0000,,Мен сізге айтамын, мен ол жаққа бармаймын.
Dialogue: 0,0:18:09.77,0:18:14.82,Default,,0000,0000,0000,,Немерең осындай болғандықтан, Криллин сенің соңынан ереді, солай ма?
Dialogue: 0,0:18:14.82,0:18:19.87,Default,,0000,0000,0000,,Иә!? О, мен бе? Жарайды бірақ.
Dialogue: 0,0:18:19.87,0:18:21.89,Default,,0000,0000,0000,,Жақсы, сенің де баруың керек.
Dialogue: 0,0:18:21.89,0:18:26.94,Default,,0000,0000,0000,,Мен Намек планетасында қандай Шенрон пайда болатынын көргім келді.
Dialogue: 0,0:18:26.94,0:18:30.98,Default,,0000,0000,0000,,Жарайды, Гоку, жақсылап демалып, Сайяндарға қарсы әрекет жасауды өтінемін.
Dialogue: 0,0:18:30.98,0:18:33.01,Default,,0000,0000,0000,,Дұрыс, мен екеуіңе де сұрадым.
Dialogue: 0,0:18:33.01,0:18:37.05,Default,,0000,0000,0000,,А, бұл... (Булма Криллин) Иә?
Dialogue: 0,0:18:37.05,0:18:40.08,Default,,0000,0000,0000,,Мені де алып кетіңізші!
Dialogue: 0,0:18:40.08,0:18:43.11,Default,,0000,0000,0000,,Не!? Иә?
Dialogue: 0,0:18:43.11,0:18:46.14,Default,,0000,0000,0000,,Уф…. Гохан, Гохан.
Dialogue: 0,0:18:46.14,0:18:49.17,Default,,0000,0000,0000,,Жоқ, бұл не қызықсыз әзіл?
Dialogue: 0,0:18:49.17,0:18:54.22,Default,,0000,0000,0000,,Бұл әзіл емес! Мен шындап барғым келеді.
Dialogue: 0,0:18:54.22,0:18:58.26,Default,,0000,0000,0000,,Ақымақ болма. Бұл екі айдан астам уақыт бойы жалғасуда.
Dialogue: 0,0:18:58.26,0:19:01.29,Default,,0000,0000,0000,,Кешіріңіз. Мен шынымен барғым келеді.
Dialogue: 0,0:19:01.29,0:19:04.66,Default,,0000,0000,0000,,Мен Пикколо мырзаны өз қолыммен өмірге қайтарғым келеді.
Dialogue: 0,0:19:04.66,0:19:07.69,Default,,0000,0000,0000,,Қандай бос сөз айтып тұрсың! →
Dialogue: 0,0:19:07.69,0:19:10.72,Default,,0000,0000,0000,,...Денем әлі толық жазылмаса да.
Dialogue: 0,0:19:10.72,0:19:14.76,Default,,0000,0000,0000,,Егер бұл сіздің денеңіз болса, бұл жақсы. Сен не істеп жатырсың?
Dialogue: 0,0:19:14.76,0:19:17.79,Default,,0000,0000,0000,,Кух…. Ия, тоқта! Гохан-чан.
Dialogue: 0,0:19:17.79,0:19:20.82,Default,,0000,0000,0000,,Өтінемін, мені алыңыз!
Dialogue: 0,0:19:20.82,0:19:24.86,Default,,0000,0000,0000,,Егер солай болса, мен сені кешірмеймін, мен сені ешқашан кешірмеймін!
Dialogue: 0,0:19:24.86,0:19:27.89,Default,,0000,0000,0000,,Екі ай! Крам мектебі туралы не деуге болады? Ал тәжірибе ше?
Dialogue: 0,0:19:27.89,0:19:31.93,Default,,0000,0000,0000,,Пикколо маңызды емес, сен кішкентай баласың.
Dialogue: 0,0:19:31.93,0:19:33.95,Default,,0000,0000,0000,,Балалар бала сияқты әрекет етуі керек, иә!
Dialogue: 0,0:19:33.95,0:19:35.97,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:19:35.97,0:19:38.00,Default,,0000,0000,0000,,Ааа….
Dialogue: 0,0:19:38.00,0:19:43.05,Default,,0000,0000,0000,,Гого Гохан-чан құқық бұзушыға айналды.
Dialogue: 0,0:19:43.05,0:19:45.07,Default,,0000,0000,0000,,Сәлем анашым.
Dialogue: 0,0:19:45.07,0:19:50.12,Default,,0000,0000,0000,,Дәл қазір... Қазір олай айтатын уақыт емес.
Dialogue: 0,0:19:50.12,0:19:53.15,Default,,0000,0000,0000,,Жер үшін жан аямай күресу→
Dialogue: 0,0:19:53.15,0:19:55.17,Default,,0000,0000,0000,,Қайтыс болғандардың барлығын қайтару →
Dialogue: 0,0:19:55.17,0:19:58.20,Default,,0000,0000,0000,,Сайяндармен тағы да соғысуым керек.
Dialogue: 0,0:19:58.20,0:20:01.23,Default,,0000,0000,0000,,Тіпті мен де күресе аламын.
Dialogue: 0,0:20:01.23,0:20:05.60,Default,,0000,0000,0000,,Бірдеңе... бірдеңе істеу керек.
Dialogue: 0,0:20:05.60,0:20:09.64,Default,,0000,0000,0000,,Түсіндім, анашым. кешіріңіз.
Dialogue: 0,0:20:09.64,0:20:12.67,Default,,0000,0000,0000,,Бұл сенің шығының, Чичи. →
Dialogue: 0,0:20:12.67,0:20:17.72,Default,,0000,0000,0000,,Өзіңізді жақсы сезініңіз және Гоханға ғарышқа ұшуға рұқсат етіңіз.
Dialogue: 0,0:20:17.72,0:20:21.76,Default,,0000,0000,0000,,《Гохан, сен кереметсің, шынында да күшті болып кеттің》
Dialogue: 0,0:20:21.76,0:20:26.81,Default,,0000,0000,0000,,Жарайды. Бұл мүлдем жақсы. Бізге қалдырыңыз. →
Dialogue: 0,0:20:26.81,0:20:29.84,Default,,0000,0000,0000,,Бұл жолы қауіпті ештеңе жоқ.
Dialogue: 0,0:20:29.84,0:20:32.87,Default,,0000,0000,0000,,Намекян тілін 5 күнде үйрене аласыз ба?
Dialogue: 0,0:20:32.87,0:20:35.90,Default,,0000,0000,0000,,Дұрыс... Мен оны аудармашыға енгіземін →
Dialogue: 0,0:20:35.90,0:20:40.95,Default,,0000,0000,0000,,10 күн қажет. Жарайды, 10 күннен кейін Каме үйінде.
Dialogue: 0,0:20:40.95,0:20:42.95,Default,,0000,0000,0000,,Ах... Иә!
Dialogue: 0,0:20:44.99,0:20:48.03,Default,,0000,0000,0000,,<Осылайша, көзді ашып-жұмғанша 10 күн өтті→
Dialogue: 0,0:20:48.03,0:20:52.07,Default,,0000,0000,0000,,Кететін күн де келді>
Dialogue: 0,0:20:52.07,0:20:54.09,Default,,0000,0000,0000,,Сәлем~! Шынында →
Dialogue: 0,0:20:54.09,0:20:57.12,Default,,0000,0000,0000,,Намек планетасына осылай бара аласың ба?
Dialogue: 0,0:20:57.12,0:21:02.17,Default,,0000,0000,0000,,Сіз өте жақсы көрінесіз, Криллин. →
Dialogue: 0,0:21:02.17,0:21:05.53,Default,,0000,0000,0000,,Сіз ғаламды жалап жатқан шығарсыз? →
Dialogue: 0,0:21:05.53,0:21:08.56,Default,,0000,0000,0000,,Костюмдар маған кедергі келтіреді→
Dialogue: 0,0:21:08.56,0:21:10.58,Default,,0000,0000,0000,,Ол тіпті шашын қиып тастады!
Dialogue: 0,0:21:10.58,0:21:12.58,Default,,0000,0000,0000,,Эхехехе….
Dialogue: 0,0:21:20.68,0:21:22.68,Default,,0000,0000,0000,,Уау!?
Dialogue: 0,0:21:25.73,0:21:28.76,Default,,0000,0000,0000,,Ахахаха! Сіз шынымен Гохансыз ба?
Dialogue: 0,0:21:28.76,0:21:30.78,Default,,0000,0000,0000,,Мына бас не болды?
Dialogue: 0,0:21:30.78,0:21:34.82,Default,,0000,0000,0000,,Әй, әкем де маған күлді.
Dialogue: 0,0:21:34.82,0:21:37.85,Default,,0000,0000,0000,,Өйткені, бұл адамдар бірінші рет ғарышқа барады.
Dialogue: 0,0:21:37.85,0:21:39.87,Default,,0000,0000,0000,,Дөрекі болмаңыз.
Dialogue: 0,0:21:39.87,0:21:43.91,Default,,0000,0000,0000,,Мен мұны сұрадым. Айдаһар допты табыңыз.
Dialogue: 0,0:21:43.91,0:21:45.91,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:47.95,0:21:49.95,Default,,0000,0000,0000,,Пикколо.
Dialogue: 0,0:21:54.02,0:21:56.04,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:21:56.04,0:21:58.06,Default,,0000,0000,0000,,Йотто. Уф….
Dialogue: 0,0:21:58.06,0:22:01.09,Default,,0000,0000,0000,,А... Уф.
Dialogue: 0,0:22:01.09,0:22:05.46,Default,,0000,0000,0000,,Ата, ана, Мастер Роши және тасбақа →
Dialogue: 0,0:22:05.46,0:22:07.48,Default,,0000,0000,0000,,Мен кетемін. Жақсысың деп үміттенемін.
Dialogue: 0,0:22:07.48,0:22:09.50,Default,,0000,0000,0000,,Пикколо.
Dialogue: 0,0:22:09.50,0:22:11.52,Default,,0000,0000,0000,,Дұрыс тамақтаныңыз.
Dialogue: 0,0:22:11.52,0:22:15.56,Default,,0000,0000,0000,,Мен саған күнде хат жіберемін. (Каме Эрмит)...Олай болса.
Dialogue: 0,0:22:15.56,0:22:17.56,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:22:21.62,0:22:26.67,Default,,0000,0000,0000,,Ах... Уау! Кішкене қобалжымаңыз.
Dialogue: 0,0:22:26.67,0:22:28.69,Default,,0000,0000,0000,,Иә? Ах...
Dialogue: 0,0:22:28.69,0:22:31.72,Default,,0000,0000,0000,,Эй, Булма-сан, сөмкемді қайда қоюым керек?
Dialogue: 0,0:22:31.72,0:22:35.76,Default,,0000,0000,0000,,Оны бір жерге қойыңыз. Тезірек отырыңыз!
Dialogue: 0,0:22:35.76,0:22:37.78,Default,,0000,0000,0000,,Маған бірдеңе дұрыс емес. (электронды дыбыс)
Dialogue: 0,0:22:37.78,0:22:42.83,Default,,0000,0000,0000,,Ұшудан 5 секунд бұрын Тағайындалған жер: Намек планетасы.
Dialogue: 0,0:22:42.83,0:22:45.86,Default,,0000,0000,0000,,Эй... Эй... Сәл күте тұрыңыз.
Dialogue: 0,0:22:45.86,0:22:50.86,Default,,0000,0000,0000,,4 3 2 1.
Dialogue: 0,0:22:52.93,0:22:54.95,Default,,0000,0000,0000,,Боо Бу... Булма мырза. Күте тұрыңыз... Әлі жоқ →
Dialogue: 0,0:22:54.95,0:22:58.99,Default,,0000,0000,0000,,Мен белбеуімді де байлаған жоқпын. Апыр-ай!
Dialogue: 0,0:22:58.99,0:23:01.02,Default,,0000,0000,0000,,Бұл, әрине, керемет жылдамдық. →
Dialogue: 0,0:23:01.02,0:23:03.21,Default,,0000,0000,0000,,Мен оны енді көре алмадым.
Dialogue: 0,0:23:03.21,0:23:07.21,Default,,0000,0000,0000,,Гохан-чан, мен де шайып жіберемін!
Dialogue: 0,0:23:14.49,0:23:16.51,Default,,0000,0000,0000,,Хмф! Сіз қазір бос бола аласыз.
Dialogue: 0,0:23:16.51,0:23:19.54,Default,,0000,0000,0000,,Атмосферадан шыққаннан кейін бәрі тыныш болады.
Dialogue: 0,0:23:19.54,0:23:21.56,Default,,0000,0000,0000,,Иә? Қазірдің өзінде? →
Dialogue: 0,0:23:21.56,0:23:23.58,Default,,0000,0000,0000,,О, не? Не істеп жатырсың, Булма-сан?
Dialogue: 0,0:23:23.58,0:23:26.61,Default,,0000,0000,0000,,Шулы! Мен киімімді ауыстырайын деп жатырмын.
Dialogue: 0,0:23:26.61,0:23:28.61,Default,,0000,0000,0000,,Сіз пижама киесіз бе?
Dialogue: 0,0:23:30.65,0:23:34.69,Default,,0000,0000,0000,,Жоқ. Мен пижамаларымды ұмытып қалдым.
Dialogue: 0,0:23:34.69,0:23:39.74,Default,,0000,0000,0000,,Гохан ше? Мен оны дұрыстап әкелдім.
Dialogue: 0,0:23:39.74,0:23:41.76,Default,,0000,0000,0000,,Көмек көрсеткеніңіз үшін рахмет →
Dialogue: 0,0:23:41.76,0:23:44.79,Default,,0000,0000,0000,,Шичи-Го-Сан стиліндегі көйлектің еш кінәсі жоқ.
Dialogue: 0,0:23:44.79,0:23:46.81,Default,,0000,0000,0000,,Тек басында.
Dialogue: 0,0:23:46.81,0:23:50.85,Default,,0000,0000,0000,,Негізі менің анама айтпай тіккен киімдерім бар.
Dialogue: 0,0:23:50.85,0:23:53.88,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:53.88,0:23:55.90,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:23:55.90,0:23:57.92,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:23:57.92,0:24:00.95,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Хехе.
Dialogue: 0,0:24:00.95,0:24:03.64,Default,,0000,0000,0000,,Сіз Пикколоны шынымен құрметтейсіз.
Dialogue: 0,0:24:03.64,0:24:05.33,Default,,0000,0000,0000,,Иә, менің әкем сияқты.
Dialogue: 0,0:24:05.33,0:24:08.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:24:12.40,0:24:16.44,Default,,0000,0000,0000,,А, бұл сирек кездесетін пижамалар. Менің ұйықтай алмай қалатын сияқтымын.
Dialogue: 0,0:24:16.44,0:24:19.47,Default,,0000,0000,0000,,Олардың пижама болуы мүмкін емес. Мен саған қарап тұрғанда →
Dialogue: 0,0:24:19.47,0:24:23.51,Default,,0000,0000,0000,,Ғарышқа дайындалуға тырысқаным үшін өзімді ақымақ сезіндім.
Dialogue: 0,0:24:23.51,0:24:25.53,Default,,0000,0000,0000,,Хехехехе.
Dialogue: 0,0:24:25.53,0:24:29.57,Default,,0000,0000,0000,,Әй, эй, біз бірдеңені дұрыс істемедік пе?
Dialogue: 0,0:24:29.57,0:24:31.57,Default,,0000,0000,0000,,Келіңіздер.
Dialogue: 0,0:24:33.61,0:24:36.64,Default,,0000,0000,0000,,<Гоку мен оның достарының тілектерін жеткізіңіз→
Dialogue: 0,0:24:36.64,0:24:40.68,Default,,0000,0000,0000,,Үшеуі Намек планетасына жол тартты. →
Dialogue: 0,0:24:40.68,0:24:42.70,Default,,0000,0000,0000,,Керемет қорқыныш→
Dialogue: 0,0:24:42.70,0:24:46.70,Default,,0000,0000,0000,,Сізді не күтіп тұрғанын білу мүмкін емес>
Dialogue: 0,0:24:52.80,0:24:57.85,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:57.85,0:25:17.38,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:17.38,0:25:37.58,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:37.58,0:25:50.58,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:54.75,0:25:57.78,Default,,0000,0000,0000,,Оссу ола чичи. Құрметті Гохан Чан. →
Dialogue: 0,0:25:57.78,0:25:59.80,Default,,0000,0000,0000,,Сіз тістеріңізді тазалап жатырсыз ба? Үй тапсырмасын орындап жатырсың ба? →
Dialogue: 0,0:25:59.80,0:26:01.82,Default,,0000,0000,0000,,Ой, уайымнан ішім өртеніп бара жатқандай.
Dialogue: 0,0:26:01.82,0:26:03.67,Default,,0000,0000,0000,,Namek планетасында өте күшті жігіт бар→
Dialogue: 0,0:26:03.67,0:26:05.19,Default,,0000,0000,0000,,Гохан жақсы болады.
Dialogue: 0,0:26:05.19,0:26:07.21,Default,,0000,0000,0000,,Барлық ауырсынуды криллинге қалдыр→
Dialogue: 0,0:26:07.21,0:26:10.24,Default,,0000,0000,0000,,Мен жақсы оқимын, анашым.
Dialogue: 0,0:26:10.24,0:26:12.24,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:15.29,0:26:19.29,Default,,0000,0000,0000,,Әке, жаман адамдар көп.
Dialogue: 0,0:26:20.79,0:26:26.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory