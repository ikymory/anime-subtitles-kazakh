Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.91,0:00:15.98,Default,,0000,0000,0000,,<Гоку Сайян ағасы Радицтің күшіне қарсы дәрменсіз болды>
Dialogue: 0,0:00:15.98,0:00:18.01,Default,,0000,0000,0000,,Әке! Ой. →
Dialogue: 0,0:00:18.01,0:00:21.04,Default,,0000,0000,0000,,Какарот, баланы өз қамқорлығыңызда ұстауыңызды өтінемін. →
Dialogue: 0,0:00:21.04,0:00:26.09,Default,,0000,0000,0000,,Тірі қайтсын десең, мына ағаның өсиетін тыңда.
Dialogue: 0,0:00:26.09,0:00:29.09,Default,,0000,0000,0000,,<Гоханды қайтара аламыз ба? ＞
Dialogue: 0,0:00:31.14,0:00:36.19,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:36.19,0:00:56.39,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:56.39,0:01:16.92,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:16.92,0:01:36.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:36.12,0:01:53.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:15.04,0:04:19.08,Default,,0000,0000,0000,,Сайяндардың сұмдығы туралы қазірдің өзінде білсеңіз де, қазірдің өзінде кеш.
Dialogue: 0,0:04:19.08,0:04:23.12,Default,,0000,0000,0000,,Менің кеңесімді тыңдамай қарсы тұруға ақымақ болғандарға→
Dialogue: 0,0:04:23.12,0:04:25.14,Default,,0000,0000,0000,,Тек өлім бар.
Dialogue: 0,0:04:25.14,0:04:30.19,Default,,0000,0000,0000,,Куха~ Қандай ұят. Одан да күштілері бар ма?
Dialogue: 0,0:04:30.19,0:04:33.22,Default,,0000,0000,0000,,Эй, бұл өте қызықты, Сон Гоку.
Dialogue: 0,0:04:33.22,0:04:38.27,Default,,0000,0000,0000,,Хехе, бұл өте жаман. Мен бұл жолы қызықпаймын.
Dialogue: 0,0:04:38.27,0:04:41.30,Default,,0000,0000,0000,,Қорыққаным сонша, дірілдеп тұрмын.
Dialogue: 0,0:04:41.30,0:04:47.36,Default,,0000,0000,0000,,Иә, әрине. Бірақ бұл қорқыныш көп ұзамай үмітсіздікке айналады.
Dialogue: 0,0:04:47.36,0:04:51.40,Default,,0000,0000,0000,,Оланың ұлы қайда? Оны қайда жасырдың?
Dialogue: 0,0:04:51.40,0:04:53.42,Default,,0000,0000,0000,,Мен мұны жасырмадым. →
Dialogue: 0,0:04:53.42,0:04:56.45,Default,,0000,0000,0000,,Гяаааааааааааааааааааааааа … Мен оны жай ғана қамап қойдым, себебі өте шулы болды. →
Dialogue: 0,0:04:56.45,0:04:59.45,Default,,0000,0000,0000,,Балалар, дәл сол жерде, артыңда тесік бар.
Dialogue: 0,0:05:06.89,0:05:08.91,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:05:08.91,0:05:10.93,Default,,0000,0000,0000,,Гохан.
Dialogue: 0,0:05:10.93,0:05:15.98,Default,,0000,0000,0000,,Әке, көмектесіңізші, әке!
Dialogue: 0,0:05:15.98,0:05:20.03,Default,,0000,0000,0000,,Күте тұрыңыз, Гохан. Әке сізге бірден көмектеседі.
Dialogue: 0,0:05:20.03,0:05:24.07,Default,,0000,0000,0000,,Хахахаха! Боқтама. →
Dialogue: 0,0:05:24.07,0:05:28.11,Default,,0000,0000,0000,,Мен сізге көмектесе алмаймын.
Dialogue: 0,0:05:28.11,0:05:31.11,Default,,0000,0000,0000,,Мен бәрің бұлай болмай тұрып өлесіңдер деп үміттенемін.
Dialogue: 0,0:05:33.16,0:05:36.19,Default,,0000,0000,0000,,Жарайды, жасайық.
Dialogue: 0,0:05:36.19,0:05:38.21,Default,,0000,0000,0000,,Бұл жалғыз жол.
Dialogue: 0,0:05:38.21,0:05:42.25,Default,,0000,0000,0000,,Хехехехехехе.
Dialogue: 0,0:05:42.25,0:05:45.28,Default,,0000,0000,0000,,Ха~! Ха~!
Dialogue: 0,0:05:45.28,0:06:01.44,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:06:01.44,0:06:04.47,Default,,0000,0000,0000,,Артқа. (Гоку/Пиколо) Гуо!
Dialogue: 0,0:06:04.47,0:06:15.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:06:15.91,0:06:17.93,Default,,0000,0000,0000,,Хмф! →
Dialogue: 0,0:06:17.93,0:06:19.93,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:06:22.98,0:06:24.00,Default,,0000,0000,0000,,О, жоқ!
Dialogue: 0,0:06:24.00,0:06:27.03,Default,,0000,0000,0000,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:06:27.03,0:06:33.09,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:06:33.09,0:06:35.11,Default,,0000,0000,0000,,Сен қайда бардың?
Dialogue: 0,0:06:35.11,0:06:38.14,Default,,0000,0000,0000,,Міне. Даа!
Dialogue: 0,0:06:38.14,0:06:40.14,Default,,0000,0000,0000,,Вуги!
Dialogue: 0,0:06:43.19,0:06:46.22,Default,,0000,0000,0000,,Кукукуку….
Dialogue: 0,0:06:46.22,0:06:51.27,Default,,0000,0000,0000,,Гугу Гугу... Чикушо.
Dialogue: 0,0:06:51.27,0:06:54.30,Default,,0000,0000,0000,,Амансың ба? Пикколо.
Dialogue: 0,0:06:54.30,0:06:58.34,Default,,0000,0000,0000,,Гуу... Аа, уайымдама.
Dialogue: 0,0:06:58.34,0:07:01.37,Default,,0000,0000,0000,,Бір қолың болмаса да, күресуге болады.
Dialogue: 0,0:07:01.37,0:07:06.75,Default,,0000,0000,0000,,Хахахаха! Сіздің өліміңіз жақындап қалған сияқты.
Dialogue: 0,0:07:06.75,0:07:09.78,Default,,0000,0000,0000,,Салқын…. Қарғыс атсын.
Dialogue: 0,0:07:09.78,0:07:11.80,Default,,0000,0000,0000,,Ке! Эй Сон Гоку.
Dialogue: 0,0:07:11.80,0:07:14.83,Default,,0000,0000,0000,,Сізде қандай да бір жаңа арнайы техника бар ма?
Dialogue: 0,0:07:14.83,0:07:18.87,Default,,0000,0000,0000,,Хехе, кешіріңіз. Шынымды айтсам, олай емес.
Dialogue: 0,0:07:18.87,0:07:21.90,Default,,0000,0000,0000,,Цк, кесілген бұрыштар.
Dialogue: 0,0:07:21.90,0:07:24.93,Default,,0000,0000,0000,,Мен шындап жаттығып, жаңалық дамыттым.
Dialogue: 0,0:07:24.93,0:07:28.97,Default,,0000,0000,0000,,Сіз не айтып тұрсыз? Мен қандай стратегия ойлап тапсам да, пайдасы жоқ!
Dialogue: 0,0:07:28.97,0:07:33.02,Default,,0000,0000,0000,,Тез шықсаң оңай болар еді.
Dialogue: 0,0:07:33.02,0:07:37.06,Default,,0000,0000,0000,,Сіз мұны бір қолмен жасай аласыз ба? О, жарайды. →
Dialogue: 0,0:07:37.06,0:07:41.06,Default,,0000,0000,0000,,Дегенмен, бұл әдіс киді көтеру үшін көп уақытты алады.
Dialogue: 0,0:07:43.12,0:07:47.16,Default,,0000,0000,0000,,Осы уақытта назарын аудару үшін онымен жалғыз күресіңіз.
Dialogue: 0,0:07:47.16,0:07:50.19,Default,,0000,0000,0000,,​​Түсіндім.
Dialogue: 0,0:07:50.19,0:07:54.23,Default,,0000,0000,0000,,Цк, бұл сені өлтіру үшін болды.
Dialogue: 0,0:07:54.23,0:07:57.26,Default,,0000,0000,0000,,Оның орнына мен сізге көмектесемін бе?
Dialogue: 0,0:07:57.26,0:08:01.30,Default,,0000,0000,0000,,Ей, мен оны жеңе алсам→
Dialogue: 0,0:08:01.30,0:08:03.32,Default,,0000,0000,0000,,Енді сіздің кезегіңіз.
Dialogue: 0,0:08:03.32,0:08:07.69,Default,,0000,0000,0000,,Жарайды, мен оны асыға күтемін. Егер солай болса, неге оны тоқтатпайсыз?
Dialogue: 0,0:08:07.69,0:08:11.73,Default,,0000,0000,0000,,Ха! Оля~!
Dialogue: 0,0:08:11.73,0:08:14.76,Default,,0000,0000,0000,,Atta~! Оля~!
Dialogue: 0,0:08:14.76,0:08:16.78,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:08:16.78,0:08:18.80,Default,,0000,0000,0000,,Атататата!
Dialogue: 0,0:08:18.80,0:08:20.82,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:08:20.82,0:08:22.84,Default,,0000,0000,0000,,Уф! Гуха!
Dialogue: 0,0:08:22.84,0:08:27.89,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:08:27.89,0:08:30.92,Default,,0000,0000,0000,,Уау! Хаа~!
Dialogue: 0,0:08:30.92,0:08:32.94,Default,,0000,0000,0000,,Иә! Таа!
Dialogue: 0,0:08:32.94,0:08:34.96,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:34.96,0:08:36.98,Default,,0000,0000,0000,,Иә. Ха!
Dialogue: 0,0:08:36.98,0:08:39.01,Default,,0000,0000,0000,,Тұрақты бейбақ.
Dialogue: 0,0:08:39.01,0:08:42.04,Default,,0000,0000,0000,,Ка~ ме~.
Dialogue: 0,0:08:42.04,0:08:45.07,Default,,0000,0000,0000,,Иә? Соғыс күші артады.
Dialogue: 0,0:08:45.07,0:08:50.12,Default,,0000,0000,0000,,Ха~ме~.
Dialogue: 0,0:08:50.12,0:08:53.15,Default,,0000,0000,0000,,Ах! (электронды дыбыс)
Dialogue: 0,0:08:53.15,0:08:56.18,Default,,0000,0000,0000,,Бұның жауынгерлік күші 1020.
Dialogue: 0,0:08:56.18,0:08:59.18,Default,,0000,0000,0000,,Мен сене алар емеспін. Әлі көтеріліп жатыр.
Dialogue: 0,0:09:01.23,0:09:03.25,Default,,0000,0000,0000,,Толқын~!
Dialogue: 0,0:09:03.25,0:09:05.25,Default,,0000,0000,0000,,Оля!
Dialogue: 0,0:09:12.68,0:09:14.68,Default,,0000,0000,0000,,Босат... техниканы іске қос!
Dialogue: 0,0:09:18.74,0:09:20.76,Default,,0000,0000,0000,,Гва….
Dialogue: 0,0:09:20.76,0:09:23.76,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:09:31.87,0:09:33.87,Default,,0000,0000,0000,,Уф, мен оны қабылдадым.
Dialogue: 0,0:09:35.91,0:09:39.95,Default,,0000,0000,0000,,Бұл жолы мен саған сыйлық беремін.
Dialogue: 0,0:09:39.95,0:09:42.98,Default,,0000,0000,0000,,Оля!
Dialogue: 0,0:09:42.98,0:09:44.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:50.06,0:09:53.09,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:53.09,0:09:55.09,Default,,0000,0000,0000,,Өл!
Dialogue: 0,0:10:00.16,0:10:03.19,Default,,0000,0000,0000,,Жауынгерлік қуат 1330!?→
Dialogue: 0,0:10:03.19,0:10:09.58,Default,,0000,0000,0000,,Барлық жауынгерлік күшіңізді саусақ ұшына жинаңыз...
Dialogue: 0,0:10:09.58,0:10:13.62,Default,,0000,0000,0000,,Қарғыс атсын! Бұл жігіттер билікті еркін басқара алады.
Dialogue: 0,0:10:13.62,0:10:17.62,Default,,0000,0000,0000,,Ал, Маканкосацухо!
Dialogue: 0,0:10:23.72,0:10:27.72,Default,,0000,0000,0000,,Қарғыс атсын! Нуоооо~.
Dialogue: 0,0:10:29.78,0:10:31.80,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:10:31.80,0:10:35.84,Default,,0000,0000,0000,,Уф…. Апыр-ай.
Dialogue: 0,0:10:35.84,0:10:39.84,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:10:49.98,0:10:52.01,Default,,0000,0000,0000,,Эй, мен мұны істедім.
Dialogue: 0,0:10:52.01,0:10:56.05,Default,,0000,0000,0000,,Менің денемді жаралайсың деп ойлау...
Dialogue: 0,0:10:56.05,0:10:59.08,Default,,0000,0000,0000,,Мені кешіріңіз.
Dialogue: 0,0:10:59.08,0:11:04.08,Default,,0000,0000,0000,,Муо~!
Dialogue: 0,0:11:07.49,0:11:09.51,Default,,0000,0000,0000,,Блять!
Dialogue: 0,0:11:09.51,0:11:12.54,Default,,0000,0000,0000,,Уау. Оля~!
Dialogue: 0,0:11:12.54,0:11:14.56,Default,,0000,0000,0000,,Яаааааааааааааааааааааааааааааааа!
Dialogue: 0,0:11:14.56,0:11:16.58,Default,,0000,0000,0000,,Иә? Жақсы...
Dialogue: 0,0:11:16.58,0:11:21.58,Default,,0000,0000,0000,,Хахаха, сақтықты түсірдің. Құйрығымнан ұстап алдың.
Dialogue: 0,0:11:25.67,0:11:28.70,Default,,0000,0000,0000,,Білмес бұрын...
Dialogue: 0,0:11:28.70,0:11:31.73,Default,,0000,0000,0000,,Пикколо Енді, тағы бір рет.
Dialogue: 0,0:11:31.73,0:11:35.77,Default,,0000,0000,0000,,Үлкен ғой, Гоку, құйрығыңнан мықтап ұста.
Dialogue: 0,0:11:35.77,0:11:38.80,Default,,0000,0000,0000,,Бұл әдісті тағы бір рет қана қолдануға болады.
Dialogue: 0,0:11:38.80,0:11:43.85,Default,,0000,0000,0000,,Какакакарот, сен жалғыз ағаңды өлтірмексің бе!?
Dialogue: 0,0:11:43.85,0:11:45.87,Default,,0000,0000,0000,,Шу!
Dialogue: 0,0:11:45.87,0:11:49.91,Default,,0000,0000,0000,,Мен саған айттым ғой, сен сияқты сұмдық менің ағам емес.
Dialogue: 0,0:11:49.91,0:11:53.95,Default,,0000,0000,0000,,Оланы да өлтірмек болғанмен, өзімшіл ештеңе айтпа.
Dialogue: 0,0:11:53.95,0:11:57.99,Default,,0000,0000,0000,,Енді жоқ, мен ойымды өзгерттім. →
Dialogue: 0,0:11:57.99,0:12:00.02,Default,,0000,0000,0000,,Тыныш бол, мен сені бұл планетадан алып кетемін.
Dialogue: 0,0:12:00.02,0:12:04.06,Default,,0000,0000,0000,,Алданба, Сон Гоку, мен саған оны маған қалдыр деймін. →
Dialogue: 0,0:12:04.06,0:12:08.43,Default,,0000,0000,0000,,Оның мұндай әрекетке баруы мүмкін емес.
Dialogue: 0,0:12:08.43,0:12:11.46,Default,,0000,0000,0000,,Өтінемін, ағайын. →
Dialogue: 0,0:12:11.46,0:12:15.50,Default,,0000,0000,0000,,О, мен осы уақытқа дейін қорқынышты нәрселер жасадым. →
Dialogue: 0,0:12:15.50,0:12:21.56,Default,,0000,0000,0000,,Әй, сен де... Бірақ, мен уәдемді орындаймын.
Dialogue: 0,0:12:21.56,0:12:23.58,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:12:23.58,0:12:27.62,Default,,0000,0000,0000,,О, бұл рас.
Dialogue: 0,0:12:27.62,0:12:31.66,Default,,0000,0000,0000,,Менің құйрығымды жіберме! Бұл оның стратегиясы!
Dialogue: 0,0:12:31.66,0:12:33.68,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:12:33.68,0:12:37.68,Default,,0000,0000,0000,,Өтінемін, Какарот, маған сеніңіз.
Dialogue: 0,0:12:42.77,0:12:45.77,Default,,0000,0000,0000,,Сон Гоку! Хехе.
Dialogue: 0,0:12:48.83,0:12:53.88,Default,,0000,0000,0000,,Тея! Апыр-ай! Ааа!
Dialogue: 0,0:12:53.88,0:12:56.91,Default,,0000,0000,0000,,Таа! Уау!
Dialogue: 0,0:12:56.91,0:13:04.99,Default,,0000,0000,0000,,Хахахаха сен ақымақсың. Сен сияқты ақымақтар сирек.
Dialogue: 0,0:13:04.99,0:13:08.37,Default,,0000,0000,0000,,Ол лас.
Dialogue: 0,0:13:08.37,0:13:11.40,Default,,0000,0000,0000,,Бірақ мен басқашамын. Мен бірінші дәрежелі жауынгермін.
Dialogue: 0,0:13:11.40,0:13:16.45,Default,,0000,0000,0000,,Менің інім болса да, ешкімді өлтіруден тартынбаймын.
Dialogue: 0,0:13:16.45,0:13:19.48,Default,,0000,0000,0000,,Сізге үлгі көрсетейін бе?
Dialogue: 0,0:13:19.48,0:13:21.50,Default,,0000,0000,0000,,Сора! →
Dialogue: 0,0:13:21.50,0:13:24.53,Default,,0000,0000,0000,,Олай болса, одан да көп қиналайық. Өлім жақын.
Dialogue: 0,0:13:24.53,0:13:27.56,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:13:27.56,0:13:31.60,Default,,0000,0000,0000,,Не болды? Бұрынғысын қолданып көріңіз.
Dialogue: 0,0:13:31.60,0:13:35.60,Default,,0000,0000,0000,,Қарғыс атқыр... Мен бұл жерден тағы да айналып өте аламын.
Dialogue: 0,0:13:42.71,0:13:44.71,Default,,0000,0000,0000,,Жоқ! Не!?
Dialogue: 0,0:13:46.75,0:13:49.75,Default,,0000,0000,0000,,Кукуку!
Dialogue: 0,0:15:03.85,0:15:07.89,Default,,0000,0000,0000,,Не?!
Dialogue: 0,0:15:07.89,0:15:09.91,Default,,0000,0000,0000,,Бұл ақымақ...
Dialogue: 0,0:15:09.91,0:15:12.94,Default,,0000,0000,0000,,Гохан?
Dialogue: 0,0:15:12.94,0:15:17.94,Default,,0000,0000,0000,,Ни, қаш, Гохан, қаш!
Dialogue: 0,0:15:19.01,0:15:21.03,Default,,0000,0000,0000,,Иә? →
Dialogue: 0,0:15:21.03,0:15:27.09,Default,,0000,0000,0000,,Жауынгерлік күш... 1,307!?
Dialogue: 0,0:15:27.09,0:15:31.13,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:15:31.13,0:15:33.15,Default,,0000,0000,0000,,Әке→
Dialogue: 0,0:15:33.15,0:15:37.19,Default,,0000,0000,0000,,Қорқытпа!
Dialogue: 0,0:15:37.19,0:15:39.21,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:15:39.21,0:15:42.24,Default,,0000,0000,0000,,Гва! Ууууу….
Dialogue: 0,0:15:42.24,0:15:44.26,Default,,0000,0000,0000,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:15:44.26,0:15:48.30,Default,,0000,0000,0000,,Гуа….
Dialogue: 0,0:15:48.30,0:15:50.32,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:15:50.32,0:15:54.36,Default,,0000,0000,0000,,Ауырады. Гохан, Гохан...
Dialogue: 0,0:15:54.36,0:15:57.72,Default,,0000,0000,0000,,Әй, әке!
Dialogue: 0,0:15:57.72,0:16:01.76,Default,,0000,0000,0000,,Ой, сен...
Dialogue: 0,0:16:01.76,0:16:04.79,Default,,0000,0000,0000,,Әке.
Dialogue: 0,0:16:04.79,0:16:07.82,Default,,0000,0000,0000,,Әй, балақай!
Dialogue: 0,0:16:07.82,0:16:11.86,Default,,0000,0000,0000,,Қаш! Қарғыс атқыр...
Dialogue: 0,0:16:11.86,0:16:14.89,Default,,0000,0000,0000,,Гохан, қаш!
Dialogue: 0,0:16:14.89,0:16:18.93,Default,,0000,0000,0000,,Мидория, сәл күте тұр.
Dialogue: 0,0:16:18.93,0:16:22.97,Default,,0000,0000,0000,,Эй, бұл жолы жауынгерлік қуат тек 1?
Dialogue: 0,0:16:22.97,0:16:24.99,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:16:24.99,0:16:29.04,Default,,0000,0000,0000,,Ол менің эмоцияларыма байланысты күрт өзгереді.
Dialogue: 0,0:16:29.04,0:16:33.08,Default,,0000,0000,0000,,Қаш!
Dialogue: 0,0:16:33.08,0:16:36.11,Default,,0000,0000,0000,,Уау! Гохан!
Dialogue: 0,0:16:36.11,0:16:39.11,Default,,0000,0000,0000,,Гохан!
Dialogue: 0,0:16:43.18,0:16:47.22,Default,,0000,0000,0000,,Ей, тоқта, тоқта, анау жігіт...
Dialogue: 0,0:16:47.22,0:16:50.25,Default,,0000,0000,0000,,Мен әлі баламын дегің келе ме?
Dialogue: 0,0:16:50.25,0:16:52.27,Default,,0000,0000,0000,,Бұл әзіл емес.
Dialogue: 0,0:16:52.27,0:16:56.65,Default,,0000,0000,0000,,Мына жігіттің жауынгерлік күші сендерден әлдеқайда жоғары. →
Dialogue: 0,0:16:56.65,0:17:01.70,Default,,0000,0000,0000,,Мен өз күшімді дұрыс пайдалана алмаймын. Мен оны қазір өлтіремін.
Dialogue: 0,0:17:01.70,0:17:05.74,Default,,0000,0000,0000,,Уайымдама, мен сені жақын арада көремін.
Dialogue: 0,0:17:05.74,0:17:08.77,Default,,0000,0000,0000,,О дүниеде хахахаха.
Dialogue: 0,0:17:08.77,0:17:11.77,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:17:18.87,0:17:20.87,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:17:22.91,0:17:28.91,Default,,0000,0000,0000,,《Сіз маған осыншама зиян келтірген бірінші адамсыз.》
Dialogue: 0,0:17:31.00,0:17:34.00,Default,,0000,0000,0000,,《Бірақ бұл бәрі》
Dialogue: 0,0:17:39.08,0:17:41.10,Default,,0000,0000,0000,,Толық кауль!
Dialogue: 0,0:17:41.10,0:17:43.12,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:17:43.12,0:17:46.15,Default,,0000,0000,0000,,Сіз! Nuo….
Dialogue: 0,0:17:46.15,0:17:51.20,Default,,0000,0000,0000,,Пикколо, асығыңыз және ертеректегі трюкті орындаңыз!
Dialogue: 0,0:17:51.20,0:17:55.40,Default,,0000,0000,0000,,Мен бұған дайындалдым.
Dialogue: 0,0:17:55.40,0:17:59.61,Default,,0000,0000,0000,,Бірақ бұл біраз уақытты алады.
Dialogue: 0,0:17:59.61,0:18:01.63,Default,,0000,0000,0000,,Қарғыс атсын! Жақсы!
Dialogue: 0,0:18:01.63,0:18:06.68,Default,,0000,0000,0000,,Пиппи Пикколо, асығыңыз, асығыңыз!
Dialogue: 0,0:18:06.68,0:18:09.71,Default,,0000,0000,0000,,Какаротты босат! Ақымақ.
Dialogue: 0,0:18:09.71,0:18:13.75,Default,,0000,0000,0000,,Бірігіп жүрсеңдер, ештеңеден құтыла алмайсыңдар.
Dialogue: 0,0:18:13.75,0:18:17.79,Default,,0000,0000,0000,,Хехе... Мен де сенімен бірге өлемін!
Dialogue: 0,0:18:17.79,0:18:21.83,Default,,0000,0000,0000,,Не?! Жындысың ба?
Dialogue: 0,0:18:21.83,0:18:26.88,Default,,0000,0000,0000,,Бұл сізді жеңудің жалғыз жолы.
Dialogue: 0,0:18:26.88,0:18:32.94,Default,,0000,0000,0000,,Уф! Сон Гоку, мен өзімді ұстамаймын.
Dialogue: 0,0:18:32.94,0:18:37.99,Default,,0000,0000,0000,,Менімен бірге жоғалып кетсеңіз, мен үшін тамаша болар еді.
Dialogue: 0,0:18:37.99,0:18:42.04,Default,,0000,0000,0000,,Ух...ха, жібер! О, менің кінәм болды.
Dialogue: 0,0:18:42.04,0:18:45.07,Default,,0000,0000,0000,,Мен бұл планетаға енді ешқашан келмеймін.
Dialogue: 0,0:18:45.07,0:18:48.10,Default,,0000,0000,0000,,Мен енді алданбаймын!
Dialogue: 0,0:18:48.10,0:18:53.15,Default,,0000,0000,0000,,Бұл өтірік емес. Ағамның сөзіне сене алмайсың!
Dialogue: 0,0:18:53.15,0:18:57.52,Default,,0000,0000,0000,,Пикколо Асығыңыз!
Dialogue: 0,0:18:57.52,0:19:01.56,Default,,0000,0000,0000,,Уау! →
Dialogue: 0,0:19:01.56,0:19:04.59,Default,,0000,0000,0000,,Мен сені күттім. Дайынсыз ба?
Dialogue: 0,0:19:04.59,0:19:07.62,Default,,0000,0000,0000,,Жаса!
Dialogue: 0,0:19:07.62,0:19:09.64,Default,,0000,0000,0000,,Жеңдер!
Dialogue: 0,0:19:09.64,0:19:11.66,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:19:11.66,0:19:14.66,Default,,0000,0000,0000,,Сиқырлы жеңіл өлтіретін мылтық!
Dialogue: 0,0:19:18.73,0:19:21.76,Default,,0000,0000,0000,,Незуко! Мен төмен түсемін
Dialogue: 0,0:19:21.76,0:19:23.78,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:23.78,0:19:25.80,Default,,0000,0000,0000,,Торя~!
Dialogue: 0,0:19:25.80,0:19:29.84,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:29.84,0:19:33.88,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:19:33.88,0:19:38.93,Default,,0000,0000,0000,,Гуа… tsk tsk шоуы!
Dialogue: 0,0:19:38.93,0:19:41.93,Default,,0000,0000,0000,,Хехехе….
Dialogue: 0,0:19:48.03,0:19:52.03,Default,,0000,0000,0000,,Хаха ха ха....
Dialogue: 0,0:20:01.49,0:20:04.52,Default,,0000,0000,0000,,Қарғыс атсын... бұл мен→
Dialogue: 0,0:20:04.52,0:20:10.58,Default,,0000,0000,0000,,Мен бұл жігіттерден жеңілгеніме сене алар емеспін... →
Dialogue: 0,0:20:10.58,0:20:15.63,Default,,0000,0000,0000,,Жоқ, бұл Какароттың жігіті→
Dialogue: 0,0:20:15.63,0:20:20.68,Default,,0000,0000,0000,,О, тіпті өз өмірімнің құнына...
Dialogue: 0,0:20:20.68,0:20:23.71,Default,,0000,0000,0000,,Сон Гоку бірден өмірге оралуы мүмкін.
Dialogue: 0,0:20:23.71,0:20:26.74,Default,,0000,0000,0000,,Не!? Бұл планетада→
Dialogue: 0,0:20:26.74,0:20:29.77,Default,,0000,0000,0000,,Айдаһар добы деген жақсы нәрсе бар. →
Dialogue: 0,0:20:29.77,0:20:33.81,Default,,0000,0000,0000,,Одан сұрасаң, қалағанның бәрі орындалады.
Dialogue: 0,0:20:33.81,0:20:37.85,Default,,0000,0000,0000,,Тіпті өлгендерді тірілту.
Dialogue: 0,0:20:37.85,0:20:41.89,Default,,0000,0000,0000,,Бля саған.
Dialogue: 0,0:20:41.89,0:20:47.95,Default,,0000,0000,0000,,Бірақ мен жақсы нәрсе естідім.
Dialogue: 0,0:20:47.95,0:20:52.00,Default,,0000,0000,0000,,Фуфуфуфуфу… Әзірге жағдайдың бәрі →
Dialogue: 0,0:20:52.00,0:20:59.41,Default,,0000,0000,0000,,Ха, бұл менің алыстағы екі досыма хабарланып жатыр.
Dialogue: 0,0:20:59.41,0:21:01.43,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:21:01.43,0:21:04.46,Default,,0000,0000,0000,,Маған шабуыл жасалғанын білгенде...
Dialogue: 0,0:21:04.46,0:21:07.49,Default,,0000,0000,0000,,Гуф.
Dialogue: 0,0:21:07.49,0:21:11.53,Default,,0000,0000,0000,,Ол әрқашан осында келеді. →
Dialogue: 0,0:21:11.53,0:21:15.57,Default,,0000,0000,0000,,Балалар сендерді былай қойғанда→
Dialogue: 0,0:21:15.57,0:21:18.60,Default,,0000,0000,0000,,Осы планетадағы барлық адамдар→
Dialogue: 0,0:21:18.60,0:21:23.65,Default,,0000,0000,0000,,Аа, мен оны тез тазаладым.
Dialogue: 0,0:21:23.65,0:21:29.71,Default,,0000,0000,0000,,Ендеше, бұл екеуі мұнда қашан келеді?
Dialogue: 0,0:21:29.71,0:21:33.75,Default,,0000,0000,0000,,Бір жыл... Тек бір жылдан кейін.
Dialogue: 0,0:21:33.75,0:21:37.79,Default,,0000,0000,0000,,Хехехехе.
Dialogue: 0,0:21:37.79,0:21:43.85,Default,,0000,0000,0000,,1 жыл... 2 адам одан да күшті.
Dialogue: 0,0:21:43.85,0:21:46.88,Default,,0000,0000,0000,,Бұл көп ұзамай қуаныш болды.
Dialogue: 0,0:21:46.88,0:21:48.88,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:21:50.92,0:21:55.13,Default,,0000,0000,0000,,Балалар сендер жәндіктерден басқа ештеңесіңдер.
Dialogue: 0,0:21:55.13,0:21:57.32,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:21:57.32,0:21:59.32,Default,,0000,0000,0000,,Зуаааа!
Dialogue: 0,0:22:06.41,0:22:09.44,Default,,0000,0000,0000,,Бұл оңайырақ, солай емес пе?
Dialogue: 0,0:22:09.44,0:22:14.49,Default,,0000,0000,0000,,Сіз қажетсіз нәрселерді тастадыңыз.
Dialogue: 0,0:22:14.49,0:22:19.54,Default,,0000,0000,0000,,Сон Гоку қайтыс болды.
Dialogue: 0,0:22:19.54,0:22:22.57,Default,,0000,0000,0000,,Әй, кейбіреулер құлап жатыр!
Dialogue: 0,0:22:22.57,0:22:26.57,Default,,0000,0000,0000,,Бір тұрған... (Каме Эрмит) Пикколо!
Dialogue: 0,0:22:29.64,0:22:32.67,Default,,0000,0000,0000,,Радиц, сен өлдің.
Dialogue: 0,0:22:32.67,0:22:36.71,Default,,0000,0000,0000,,Ол аянышты, мүлде... Пеп.
Dialogue: 0,0:22:36.71,0:22:40.75,Default,,0000,0000,0000,,Мен 1000-нан сәл астам жауынгерлік күші бар жігіттердің мені өлтіретініне сене алмаймын.
Dialogue: 0,0:22:40.75,0:22:45.80,Default,,0000,0000,0000,,Не істеу керек? Мен бұл планетаны тастап, кетуім керек пе?
Dialogue: 0,0:22:45.80,0:22:49.84,Default,,0000,0000,0000,,Қызық нәрсе... Пех. Сіз осылай дедіңіз.
Dialogue: 0,0:22:49.84,0:22:52.87,Default,,0000,0000,0000,,Айдаһар добы т.б.
Dialogue: 0,0:22:52.87,0:22:55.57,Default,,0000,0000,0000,,Аа, кез келген тілек орындалатын сияқты.
Dialogue: 0,0:22:55.57,0:22:57.25,Default,,0000,0000,0000,,Жарайды, кеттік.
Dialogue: 0,0:22:57.25,0:22:59.27,Default,,0000,0000,0000,,Радицті өмірге қайтару.
Dialogue: 0,0:22:59.27,0:23:06.34,Default,,0000,0000,0000,,Қалжыңдама. Маған енді соншалықты көмекші адам керек емес. →
Dialogue: 0,0:23:06.34,0:23:13.41,Default,,0000,0000,0000,,«Біз ешқашан қартаймаймыз және мәңгі өмір сүрмейміз...» ше?
Dialogue: 0,0:23:13.41,0:23:16.44,Default,,0000,0000,0000,,Егер сіз мұны жасасаңыз, сіз шайқастан мәңгілікке ләззат ала аласыз.
Dialogue: 0,0:23:16.44,0:23:21.44,Default,,0000,0000,0000,,Түсіндім, бұл жақсы. Хахахаха!
Dialogue: 0,0:23:23.51,0:23:27.55,Default,,0000,0000,0000,,...Сондықтан. (Кәме-сеннин) Түсінемін.
Dialogue: 0,0:23:27.55,0:23:30.58,Default,,0000,0000,0000,,Гоку Гоку! →
Dialogue: 0,0:23:30.58,0:23:33.61,Default,,0000,0000,0000,,Ей, Гоку, өзіңді дайында!
Dialogue: 0,0:23:33.61,0:23:39.67,Default,,0000,0000,0000,,Гоханның жағдайы жақсы, есінен танып қалды.
Dialogue: 0,0:23:39.67,0:23:41.69,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:23:41.69,0:23:44.72,Default,,0000,0000,0000,,Мен байқадым! (Каме Эрмит) Гоку!
Dialogue: 0,0:23:44.72,0:23:48.76,Default,,0000,0000,0000,,Сізге Чи-Чи соғудың қажеті жоқ.
Dialogue: 0,0:23:48.76,0:23:51.76,Default,,0000,0000,0000,,Немересі….
Dialogue: 0,0:23:54.82,0:23:57.18,Default,,0000,0000,0000,,Хахаха. Криллин.
Dialogue: 0,0:23:57.18,0:23:59.20,Default,,0000,0000,0000,,А, а.
Dialogue: 0,0:23:59.20,0:24:05.26,Default,,0000,0000,0000,,Өлу өте жағымсыз.
Dialogue: 0,0:24:05.26,0:24:11.32,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Гоку, өзіңді қолға ал. Бұл сен сияқты емес.
Dialogue: 0,0:24:11.32,0:24:17.38,Default,,0000,0000,0000,,Эй, бұл жолы жіберме.
Dialogue: 0,0:24:17.38,0:24:21.42,Default,,0000,0000,0000,,А, уайымдама, мен сені бірден өмірге қайтарамын.
Dialogue: 0,0:24:21.42,0:24:23.44,Default,,0000,0000,0000,,Хе хе хе.
Dialogue: 0,0:24:23.44,0:24:26.44,Default,,0000,0000,0000,,Өтінемін….
Dialogue: 0,0:24:31.52,0:24:33.54,Default,,0000,0000,0000,,Гоку….
Dialogue: 0,0:24:33.54,0:24:35.56,Default,,0000,0000,0000,,Гоку~!
Dialogue: 0,0:24:35.56,0:24:39.60,Default,,0000,0000,0000,,<Гоку өзін құрбан ету арқылы Радицті жеңді. →
Dialogue: 0,0:24:39.60,0:24:44.60,Default,,0000,0000,0000,,Бірақ Жерге жаңа жау жақындап келеді>
Dialogue: 0,0:24:46.67,0:24:51.72,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:51.72,0:25:11.92,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:11.92,0:25:31.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.12,0:25:44.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:48.29,0:25:51.32,Default,,0000,0000,0000,,Сәлем, Гоку! Құдай-ау, тез өлдің.
Dialogue: 0,0:25:51.32,0:25:54.35,Default,,0000,0000,0000,,Не? Сіз жұмаққа барғыңыз келмейді ме?
Dialogue: 0,0:25:54.35,0:25:56.71,Default,,0000,0000,0000,,Ху, Энма патша.
Dialogue: 0,0:25:56.71,0:25:59.74,Default,,0000,0000,0000,,Хмм, Кай патшаның қол астындағы жаттығулар туралы не деуге болады? →
Dialogue: 0,0:25:59.74,0:26:02.77,Default,,0000,0000,0000,,Жыланның жолына түсіп қалсаң, білмейсің.
Dialogue: 0,0:26:02.77,0:26:05.77,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»….
Dialogue: 0,0:26:08.83,0:26:13.83,Default,,0000,0000,0000,,Әке, жасыл бала қорқынышты!
Dialogue: 0,0:26:15.33,0:26:21.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory