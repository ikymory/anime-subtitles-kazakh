Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.73,0:00:15.77,Default,,0000,0000,0000,,<Бұл соңғы ставка болды. →
Dialogue: 0,0:00:15.77,0:00:18.80,Default,,0000,0000,0000,,Гохан ұлы маймылға айналды →
Dialogue: 0,0:00:18.80,0:00:22.84,Default,,0000,0000,0000,,Мен қатты соққы бердім. →
Dialogue: 0,0:00:22.84,0:00:26.88,Default,,0000,0000,0000,,Вегета артқа бұрылуға тырысады. →
Dialogue: 0,0:00:26.88,0:00:30.92,Default,,0000,0000,0000,,Содан тағдырлы сәт келеді>
Dialogue: 0,0:00:30.92,0:00:33.95,Default,,0000,0000,0000,,Өлгеннің бәрінің кегі. →
Dialogue: 0,0:00:33.95,0:00:35.95,Default,,0000,0000,0000,,Өзіңізді дайындаңыз!
Dialogue: 0,0:00:37.99,0:00:42.04,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:42.04,0:01:02.24,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:02.24,0:01:22.77,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:22.77,0:01:42.97,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:42.97,0:01:59.97,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:21.90,0:04:25.94,Default,,0000,0000,0000,,Фу~ Міне, мен осы уақытқа дейін жеттім. →
Dialogue: 0,0:04:25.94,0:04:27.96,Default,,0000,0000,0000,,Не болар екен деп ойладым.
Dialogue: 0,0:04:27.96,0:04:30.99,Default,,0000,0000,0000,,Мен сізге артықшылық көрсеткім келмейді. →
Dialogue: 0,0:04:30.99,0:04:35.04,Default,,0000,0000,0000,,Сайян бүкіл ғаламды дүр сілкіндірген бейбақ еді.
Dialogue: 0,0:04:35.04,0:04:38.07,Default,,0000,0000,0000,,Бұл сөзсіз болуы керек.
Dialogue: 0,0:04:38.07,0:04:43.12,Default,,0000,0000,0000,,Бұл зұлымдықтың тамыры толығымен жойылды дегенді білдірмесе де. →
Dialogue: 0,0:04:43.12,0:04:47.16,Default,,0000,0000,0000,,Жамандықтың тамыры... (Вегета) Аспаз...
Dialogue: 0,0:04:47.16,0:04:50.19,Default,,0000,0000,0000,,Өл! (Вегета) Уууу.
Dialogue: 0,0:04:50.19,0:04:53.22,Default,,0000,0000,0000,,《Күте~! 》
Dialogue: 0,0:04:53.22,0:04:55.24,Default,,0000,0000,0000,,Гоку?
Dialogue: 0,0:04:55.24,0:05:00.29,Default,,0000,0000,0000,,Дәл қазір менің жүрегіммен сөйлеген адам →
Dialogue: 0,0:05:00.29,0:05:03.32,Default,,0000,0000,0000,,Гоку Бұл сен бе?
Dialogue: 0,0:05:03.32,0:05:07.36,Default,,0000,0000,0000,,《Аа, дұрыс. Өйткені мен қатты сөйлей алмаймын. →
Dialogue: 0,0:05:07.36,0:05:14.76,Default,,0000,0000,0000,,Көкек Куририн, кешіріңіз, оны жіберіңізші.
Dialogue: 0,0:05:14.76,0:05:16.78,Default,,0000,0000,0000,,Әй, есі дұрыс па? Гоку.
Dialogue: 0,0:05:16.78,0:05:18.80,Default,,0000,0000,0000,,Бұл жігіт біздің достарымызды өлтірді→
Dialogue: 0,0:05:18.80,0:05:21.83,Default,,0000,0000,0000,,Дүниедегі барлық адамды өлтірмек болған.
Dialogue: 0,0:05:21.83,0:05:27.89,Default,,0000,0000,0000,,Егер сіз оны қазір өткізіп алсаңыз, шыдамдылығыңызды қалпына келтіріп, қайта оралыңыз.
Dialogue: 0,0:05:27.89,0:05:29.91,Default,,0000,0000,0000,,《Мен солай ойлаймын》
Dialogue: 0,0:05:29.91,0:05:32.94,Default,,0000,0000,0000,,Сіз дәл Пикколо → сияқтысыз
Dialogue: 0,0:05:32.94,0:05:36.98,Default,,0000,0000,0000,,Егер сіз өз ойыңызды өзгерте аламын деп ойласаңыз →
Dialogue: 0,0:05:36.98,0:05:41.03,Default,,0000,0000,0000,,Бұл үлкен қателік! Бұл жігіт ондай емес.
Dialogue: 0,0:05:41.03,0:05:45.07,Default,,0000,0000,0000,,《Уау, мен білемін. Дұрыс, бұл Вегета.
Dialogue: 0,0:05:45.07,0:05:48.10,Default,,0000,0000,0000,,Ол сондай-ақ керемет күшті. →
Dialogue: 0,0:05:48.10,0:05:51.13,Default,,0000,0000,0000,,Бірақ эй, мен оны жақсы айта алмаймын →
Dialogue: 0,0:05:51.13,0:05:55.17,Default,,0000,0000,0000,,Енді сол жігіттің өлетінін көріп тұрмын→
Dialogue: 0,0:05:55.17,0:05:58.20,Default,,0000,0000,0000,,Мен солай ойладым. →
Dialogue: 0,0:05:58.20,0:06:01.23,Default,,0000,0000,0000,,«Бұл ысырап»》
Dialogue: 0,0:06:01.23,0:06:04.26,Default,,0000,0000,0000,,Қандай қалдық?
Dialogue: 0,0:06:04.26,0:06:08.30,Default,,0000,0000,0000,,《Ой, Кай корольде жаттығу →
Dialogue: 0,0:06:08.30,0:06:11.50,Default,,0000,0000,0000,,Мен шыңға жеттім деп ойладым. →
Dialogue: 0,0:06:11.50,0:06:15.70,Default,,0000,0000,0000,,Бірақ, бұл Вегета - →
Dialogue: 0,0:06:15.70,0:06:19.74,Default,,0000,0000,0000,,Ол Орадан әлдеқайда жақсы болды. →
Dialogue: 0,0:06:19.74,0:06:24.79,Default,,0000,0000,0000,,Шынымды айтсам, шошып кеттім. →
Dialogue: 0,0:06:24.79,0:06:30.85,Default,,0000,0000,0000,,Бірақ жүрегімнің бір жерінде қуаныштан жүрегім лүпілдеп кетті. →
Dialogue: 0,0:06:30.85,0:06:33.88,Default,,0000,0000,0000,,Өйткені, Ола да сайян. →
Dialogue: 0,0:06:33.88,0:06:37.88,Default,,0000,0000,0000,,Күшті адамды көрсем, көңілім көтеріледі.
Dialogue: 0,0:06:39.94,0:06:43.98,Default,,0000,0000,0000,,《Мен оның дұрыс емес екенін білемін, бірақ өтінемін →
Dialogue: 0,0:06:43.98,0:06:49.04,Default,,0000,0000,0000,,Маған онымен күресуге тағы бір мүмкіндік беріңіз! 》
Dialogue: 0,0:06:49.04,0:07:06.21,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:06.21,0:07:09.24,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:07:09.24,0:07:14.62,Default,,0000,0000,0000,,Түсіндім, сенің өзімшіл болуға құқығың бар. →
Dialogue: 0,0:07:14.62,0:07:18.66,Default,,0000,0000,0000,,Бүгінгі Жердің бар болуы Гокудың арқасында. →
Dialogue: 0,0:07:18.66,0:07:20.68,Default,,0000,0000,0000,,Бірақ бұл керемет, Гоку!
Dialogue: 0,0:07:20.68,0:07:24.72,Default,,0000,0000,0000,,Келесі жолы оны жеңу үшін өзіңіздің соңғы күшіңізді пайдаланыңыз!
Dialogue: 0,0:07:24.72,0:07:27.75,Default,,0000,0000,0000,,О, мен сенімдімін.
Dialogue: 0,0:07:27.75,0:07:29.77,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:29.77,0:07:34.82,Default,,0000,0000,0000,,Есіңізде болсын, қоқыс тастаңыз, бұдан былай ғажайыптар болмайды.
Dialogue: 0,0:07:34.82,0:07:37.85,Default,,0000,0000,0000,,Келесі жолы кездескенімде бәріңді өлтіремін.
Dialogue: 0,0:07:37.85,0:07:41.89,Default,,0000,0000,0000,,Ең болмаса көңіл көтеріңіз.
Dialogue: 0,0:07:41.89,0:08:01.09,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:01.09,0:08:04.12,Default,,0000,0000,0000,,Чикшоу.
Dialogue: 0,0:08:04.12,0:08:12.54,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:12.54,0:08:14.54,Default,,0000,0000,0000,,Я~.
Dialogue: 0,0:08:24.66,0:08:29.66,Default,,0000,0000,0000,,Амансың ба? Сен енді қауіпсізсің.
Dialogue: 0,0:08:31.73,0:08:35.77,Default,,0000,0000,0000,,А, мен кеттім. →
Dialogue: 0,0:08:35.77,0:08:38.80,Default,,0000,0000,0000,,...Олай болса да, ақымақ. →
Dialogue: 0,0:08:38.80,0:08:42.84,Default,,0000,0000,0000,,Соңғы соққыны берудің қажеті жоқ. Сен қайдасың?
Dialogue: 0,0:08:42.84,0:08:46.88,Default,,0000,0000,0000,,Кешіріңіз, Криллин.
Dialogue: 0,0:08:46.88,0:08:48.90,Default,,0000,0000,0000,,Хехе, ол үшін уайымдама.
Dialogue: 0,0:08:48.90,0:08:51.93,Default,,0000,0000,0000,,Қайтыс болғандардың бәріне ренжідім. →
Dialogue: 0,0:08:51.93,0:08:55.97,Default,,0000,0000,0000,,Бірақ оны қайта тірілтуге болатын шығар...
Dialogue: 0,0:08:55.97,0:08:57.99,Default,,0000,0000,0000,,(Ұшу дыбысы)
Dialogue: 0,0:08:57.99,0:08:59.99,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:09:03.05,0:09:05.07,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:05.07,0:09:10.07,Default,,0000,0000,0000,,Сәлем! Эй!
Dialogue: 0,0:09:12.47,0:09:14.47,Default,,0000,0000,0000,,Хахаха.
Dialogue: 0,0:09:18.53,0:09:20.55,Default,,0000,0000,0000,,Гохан-чан!
Dialogue: 0,0:09:20.55,0:09:23.58,Default,,0000,0000,0000,,Чи чи чи?
Dialogue: 0,0:09:23.58,0:09:27.62,Default,,0000,0000,0000,,Гохан-чан Гохан-чан! →
Dialogue: 0,0:09:27.62,0:09:30.65,Default,,0000,0000,0000,,Гохан-чан! (Тасбақа гермит) О, ау!
Dialogue: 0,0:09:30.65,0:09:32.65,Default,,0000,0000,0000,,Чи-чи-чи.
Dialogue: 0,0:09:34.69,0:09:37.72,Default,,0000,0000,0000,,Гохан-чан! →
Dialogue: 0,0:09:37.72,0:09:41.76,Default,,0000,0000,0000,,Куу~! Жақсы!?
Dialogue: 0,0:09:41.76,0:09:43.78,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:43.78,0:09:48.83,Default,,0000,0000,0000,,Гохан-чан! Гохан Чан, жақсысың ба!? Мықты болыңыз! →
Dialogue: 0,0:09:48.83,0:09:50.85,Default,,0000,0000,0000,,Анам осында!
Dialogue: 0,0:09:50.85,0:09:54.89,Default,,0000,0000,0000,,Гохан-чан, қандай ұят...
Dialogue: 0,0:09:54.89,0:09:57.92,Default,,0000,0000,0000,,Гохан, бәрі жақсы. →
Dialogue: 0,0:09:57.92,0:10:01.96,Default,,0000,0000,0000,,Дәлірек айтсақ, Гокудың жағдайы әлдеқайда нашар... →
Dialogue: 0,0:10:01.96,0:10:04.99,Default,,0000,0000,0000,,Қара, қара, ана жаққа қара...
Dialogue: 0,0:10:04.99,0:10:08.03,Default,,0000,0000,0000,,Бейшара. Мен мұны бастан кешіруге мәжбүр болдым!
Dialogue: 0,0:10:08.03,0:10:11.23,Default,,0000,0000,0000,,Мен сені енді ешқашан анамның қасынан тастамаймын! →
Dialogue: 0,0:10:11.23,0:10:16.44,Default,,0000,0000,0000,,Бейшара. Гохан-чан Гохан-чан.
Dialogue: 0,0:10:16.44,0:10:20.48,Default,,0000,0000,0000,,《Бұл дұрыс емес. Гоку да қиын болды.
Dialogue: 0,0:10:20.48,0:10:23.51,Default,,0000,0000,0000,,Иә, немерем. (Каме гермит) Гоку.
Dialogue: 0,0:10:23.51,0:10:25.53,Default,,0000,0000,0000,,Немересі. Хаха….
Dialogue: 0,0:10:25.53,0:10:30.58,Default,,0000,0000,0000,,Амансың ба? Немересі. (Роши Роши) Эй, бұл жігіт қорқынышты.
Dialogue: 0,0:10:30.58,0:10:34.62,Default,,0000,0000,0000,,Уау, бұл жаман. Сайян қашып кетті.
Dialogue: 0,0:10:34.62,0:10:38.66,Default,,0000,0000,0000,,Жоқ, жоқ, оларды кері айдау үлкен мәселе болды.
Dialogue: 0,0:10:38.66,0:10:40.68,Default,,0000,0000,0000,,Әй, Қарин-сама.
Dialogue: 0,0:10:40.68,0:10:44.72,Default,,0000,0000,0000,,А, ол соншалықты күшті емес. →
Dialogue: 0,0:10:44.72,0:10:46.74,Default,,0000,0000,0000,,Бұлма мырза. →
Dialogue: 0,0:10:46.74,0:10:51.79,Default,,0000,0000,0000,,Ямча мен төртеумізден басқаның бәрі жеңілді.
Dialogue: 0,0:10:51.79,0:10:53.81,Default,,0000,0000,0000,,Иә, себебі мен оны теледидардан көрдім.
Dialogue: 0,0:10:53.81,0:10:56.84,Default,,0000,0000,0000,,Әй, бірақ Пикколо өлді, Құдай да өлді...
Dialogue: 0,0:10:56.84,0:11:01.89,Default,,0000,0000,0000,,Дұрыс. Енді Dragon Ball бар ...
Dialogue: 0,0:11:01.89,0:11:03.91,Default,,0000,0000,0000,,Кух…. →
Dialogue: 0,0:11:03.91,0:11:06.91,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:11:09.97,0:11:14.35,Default,,0000,0000,0000,,Сіз мұны білдіңіз. (Кәме-сеннин) Бұл рас.
Dialogue: 0,0:11:14.35,0:11:18.39,Default,,0000,0000,0000,,Егер Пикколо аман қалса.
Dialogue: 0,0:11:18.39,0:11:21.39,Default,,0000,0000,0000,,Бұл менің кінәм болды.
Dialogue: 0,0:11:23.44,0:11:26.47,Default,,0000,0000,0000,,Иә! Тек қаша бересің →
Dialogue: 0,0:11:26.47,0:11:29.50,Default,,0000,0000,0000,,Біз мүлде ұрыспадық!
Dialogue: 0,0:11:29.50,0:11:32.53,Default,,0000,0000,0000,,Қарғыс атсын... Мен не айтуым керек?
Dialogue: 0,0:11:32.53,0:11:35.56,Default,,0000,0000,0000,,Пикколоның орнына сен сияқты пайдасыз адам→
Dialogue: 0,0:11:35.56,0:11:40.61,Default,,0000,0000,0000,,Өлгенің жақсы еді, ақымақ!
Dialogue: 0,0:11:40.61,0:11:48.69,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,0:11:48.69,0:11:52.73,Default,,0000,0000,0000,,Мен болмасам, бұл жігіттер аман қалмас еді!
Dialogue: 0,0:11:52.73,0:11:55.76,Default,,0000,0000,0000,,Бас-күн! Мен абдырап қалдым!
Dialogue: 0,0:11:55.76,0:12:00.81,Default,,0000,0000,0000,,Түсіндім, түсіндім. Жарақат алған адамды тезірек ауруханаға жеткізуіміз керек.
Dialogue: 0,0:12:00.81,0:12:03.81,Default,,0000,0000,0000,,Сензу бұршақтары енді жоқ. (Яджиробе) Ке!
Dialogue: 0,0:12:05.86,0:12:08.89,Default,,0000,0000,0000,,So~tto so~tto so~tto na.
Dialogue: 0,0:12:08.89,0:12:19.34,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:12:19.34,0:12:23.34,Default,,0000,0000,0000,,(қозғалтқыштың іске қосу дыбысы)
Dialogue: 0,0:13:43.84,0:13:45.84,Default,,0000,0000,0000,,Гохан-чан….
Dialogue: 0,0:13:48.89,0:13:51.92,Default,,0000,0000,0000,,Меніңше, барлығының денесі осы жерде.
Dialogue: 0,0:13:51.92,0:13:56.97,Default,,0000,0000,0000,,Олай болса, тағы біраз жүрейік.
Dialogue: 0,0:13:56.97,0:14:00.01,Default,,0000,0000,0000,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:14:00.01,0:14:03.04,Default,,0000,0000,0000,,Бұлма-сан, жылама.
Dialogue: 0,0:14:03.04,0:14:07.08,Default,,0000,0000,0000,,Бұл өте екіталай, дегенмен→
Dialogue: 0,0:14:07.08,0:14:11.12,Default,,0000,0000,0000,,Бұл аздап шектен шығуы мүмкін, бірақ→
Dialogue: 0,0:14:11.12,0:14:13.14,Default,,0000,0000,0000,,Үмітсіз тыңдаңыз.
Dialogue: 0,0:14:13.14,0:14:17.18,Default,,0000,0000,0000,,Сайяндар өлтіргеннің бәрі→
Dialogue: 0,0:14:17.18,0:14:20.21,Default,,0000,0000,0000,,Оны қайта тірілтуге болатын шығар.
Dialogue: 0,0:14:20.21,0:14:22.23,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:14:22.23,0:14:25.26,Default,,0000,0000,0000,,Сіз нені айтасыз? (Каме Эрмит) Бұл рас па?
Dialogue: 0,0:14:25.26,0:14:28.29,Default,,0000,0000,0000,,Бұлтты ұстағандай...
Dialogue: 0,0:14:28.29,0:14:33.34,Default,,0000,0000,0000,,Кукуририн Айтпақшы, Ола да солай деді.
Dialogue: 0,0:14:33.34,0:14:37.55,Default,,0000,0000,0000,,Сіз нені айтасыз? Әңгімелесейік.
Dialogue: 0,0:14:37.55,0:14:43.78,Default,,0000,0000,0000,,Негізі... сәл күте тұрыңыз, кейін сөйлесемін. →
Dialogue: 0,0:14:43.78,0:14:47.82,Default,,0000,0000,0000,,Мастер Мутен Роши, осы жерден түсіңіз. Біз әркімнің денесін алып жүруіміз керек.
Dialogue: 0,0:14:47.82,0:14:49.84,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:14:49.84,0:15:05.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:15:05.00,0:15:11.06,Default,,0000,0000,0000,,Гиозаның мәйіті не қалды, иә?
Dialogue: 0,0:15:11.06,0:15:16.11,Default,,0000,0000,0000,,Жоқ.Ол жігіт ағашты өздігінен қиратып, ұсақтайды.
Dialogue: 0,0:15:16.11,0:15:20.15,Default,,0000,0000,0000,,О, құдайым, бұл сұмдық. →
Dialogue: 0,0:15:20.15,0:15:25.20,Default,,0000,0000,0000,,Мен олардың барлығын өмірге қайтарғым келеді.
Dialogue: 0,0:15:25.20,0:15:29.24,Default,,0000,0000,0000,,Егер жағдай бұрынғыдай жалғаса берсе, бұл жігіттер жасайтын құрбандықтар тым үлкен болады.
Dialogue: 0,0:15:29.24,0:15:36.24,Default,,0000,0000,0000,,Қарин-сама, мен өзімнің дәрменсіздігіме де ашуланамын.
Dialogue: 0,0:15:42.70,0:15:44.72,Default,,0000,0000,0000,,Қазір.
Dialogue: 0,0:15:44.72,0:15:48.76,Default,,0000,0000,0000,,Жарайды, мен оны басқарамын.
Dialogue: 0,0:15:48.76,0:15:52.76,Default,,0000,0000,0000,,Мен біраз тынышталдым. (Каме Эрмит) Түсінемін.
Dialogue: 0,0:15:56.84,0:16:00.88,Default,,0000,0000,0000,,U…. Гохан-чан, байқадың ба!?
Dialogue: 0,0:16:00.88,0:16:02.90,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:02.90,0:16:05.93,Default,,0000,0000,0000,,Уайымдама, бұл ана. Бұл ана.
Dialogue: 0,0:16:05.93,0:16:08.96,Default,,0000,0000,0000,,Әй, ой, анашым.
Dialogue: 0,0:16:08.96,0:16:12.00,Default,,0000,0000,0000,,Уау! Бейшара жігіт, ол сондай қорқынышты көрінеді!
Dialogue: 0,0:16:12.00,0:16:14.02,Default,,0000,0000,0000,,Бірақ қазір бәрі жақсы!
Dialogue: 0,0:16:14.02,0:16:18.06,Default,,0000,0000,0000,,Жоқ, жоқ, бұл үлкен мәселе.
Dialogue: 0,0:16:18.06,0:16:21.09,Default,,0000,0000,0000,,Сіз құтқарылды. Қалай? Саяндар ше?
Dialogue: 0,0:16:21.09,0:16:27.15,Default,,0000,0000,0000,,А, ол қашып кетті. Ол қашып кетті.
Dialogue: 0,0:16:27.15,0:16:31.19,Default,,0000,0000,0000,,Біз бәріміз оны қатты ренжіттік.
Dialogue: 0,0:16:31.19,0:16:35.19,Default,,0000,0000,0000,,Мен енді ешқашан келмейтін шығармын.
Dialogue: 0,0:16:37.42,0:16:41.62,Default,,0000,0000,0000,,Әкеңіз ше? Мен сенің артыңдамын, Гохан.
Dialogue: 0,0:16:41.62,0:16:45.66,Default,,0000,0000,0000,,Балалар, сендерге рахмет, мен аман қалдым.
Dialogue: 0,0:16:45.66,0:16:48.69,Default,,0000,0000,0000,,Ах, аха. Хахаха.
Dialogue: 0,0:16:48.69,0:16:50.71,Default,,0000,0000,0000,,Хахахаха. Хахахаха.
Dialogue: 0,0:16:50.71,0:16:52.73,Default,,0000,0000,0000,,Эй, маған бәрібір →
Dialogue: 0,0:16:52.73,0:16:57.78,Default,,0000,0000,0000,,Сіз Гокудың әйелісіз, солай ма? Балаларды үнемі уайымдамаңыз →
Dialogue: 0,0:16:57.78,0:16:59.80,Default,,0000,0000,0000,,Күйеуіңізге аздап қамқорлық жасау керек.
Dialogue: 0,0:16:59.80,0:17:02.83,Default,,0000,0000,0000,,Тш, бұл дөрекі! Жарайды!
Dialogue: 0,0:17:02.83,0:17:05.86,Default,,0000,0000,0000,,Гоку-санның кесірінен Гохан-чан осы сұмдық жағдайға тап болды.
Dialogue: 0,0:17:05.86,0:17:08.89,Default,,0000,0000,0000,,Бұл баланың араласуына жол бермеңіз!
Dialogue: 0,0:17:08.89,0:17:10.91,Default,,0000,0000,0000,,Жоқ, мама. Менің әкем...
Dialogue: 0,0:17:10.91,0:17:13.94,Default,,0000,0000,0000,,Ола жерді уайымдаудан гөрі →
Dialogue: 0,0:17:13.94,0:17:18.99,Default,,0000,0000,0000,,Мен Гоханның болашағына көбірек алаңдаймын!
Dialogue: 0,0:17:18.99,0:17:21.02,Default,,0000,0000,0000,,Гоку: Мен бұл жігітті жұдырықтай аламын ба?
Dialogue: 0,0:17:21.02,0:17:25.06,Default,,0000,0000,0000,,Криллин, менімен сөйлесе аласыз ба? Бұрын болған оқиға туралы.
Dialogue: 0,0:17:25.06,0:17:29.10,Default,,0000,0000,0000,,А, түсіндім.
Dialogue: 0,0:17:29.10,0:17:34.15,Default,,0000,0000,0000,,Сайяндар Гокудың үлкен ағасынан радиохабарлама алған шығар →
Dialogue: 0,0:17:34.15,0:17:38.52,Default,,0000,0000,0000,,Олар жер бетінде Айдаһар шарлары бар екенін білсе керек. →
Dialogue: 0,0:17:38.52,0:17:41.55,Default,,0000,0000,0000,,Тілегіңіз орындалуы мүмкін. Сонымен, мен осында болғанда, →
Dialogue: 0,0:17:41.55,0:17:44.58,Default,,0000,0000,0000,,Ол да Айдаһар допты алуға тырысты.
Dialogue: 0,0:17:44.58,0:17:46.60,Default,,0000,0000,0000,,Шынымен бе? аа.
Dialogue: 0,0:17:46.60,0:17:50.64,Default,,0000,0000,0000,,Бірақ олар Пикколоның бетіне қарап, біртүрлі нәрсе айтты.
Dialogue: 0,0:17:50.64,0:17:53.67,Default,,0000,0000,0000,,«Мен Намекянмын».
Dialogue: 0,0:17:53.67,0:17:55.69,Default,,0000,0000,0000,,Ә!?
Dialogue: 0,0:17:55.69,0:18:00.74,Default,,0000,0000,0000,,Пикколо... Ол да құдай, бірақ ол бастапқыда бөтен адам болғанға ұқсайды.
Dialogue: 0,0:18:00.74,0:18:04.78,Default,,0000,0000,0000,,Егер сізде бұл бет болса, біртүрлі болар еді.
Dialogue: 0,0:18:04.78,0:18:07.81,Default,,0000,0000,0000,,Бұдан кейін айтқан сөздеріңіз маңызды.
Dialogue: 0,0:18:07.81,0:18:10.84,Default,,0000,0000,0000,,《Наппа, оларды өлтір》
Dialogue: 0,0:18:10.84,0:18:13.87,Default,,0000,0000,0000,,《Т, бірақ Айдаһар доп ше? 》
Dialogue: 0,0:18:13.87,0:18:15.89,Default,,0000,0000,0000,,《Маған бәрібір. Менде бір идея бар. →
Dialogue: 0,0:18:15.89,0:18:18.92,Default,,0000,0000,0000,,Намекиялықтардың туған қаласы Намек планетасына барсаңыз→
Dialogue: 0,0:18:18.92,0:18:23.97,Default,,0000,0000,0000,,Мен одан да күшті Айдаһар шарлары бар екеніне сенімдімін.
Dialogue: 0,0:18:23.97,0:18:26.00,Default,,0000,0000,0000,,Сәлем! Сосын сөйлесейік. Бұл қызықсыз.
Dialogue: 0,0:18:26.00,0:18:28.02,Default,,0000,0000,0000,,Мен де естідім!
Dialogue: 0,0:18:28.02,0:18:33.07,Default,,0000,0000,0000,,Намекиандықтардың жұмбақ шарлар жасау күші бар.
Dialogue: 0,0:18:33.07,0:18:36.10,Default,,0000,0000,0000,,Ал егер… шынымен не болса, →
Dialogue: 0,0:18:36.10,0:18:39.47,Default,,0000,0000,0000,,Намек деген жерге бара алсам→
Dialogue: 0,0:18:39.47,0:18:41.49,Default,,0000,0000,0000,,Айдаһар допты алуыңыз мүмкін.
Dialogue: 0,0:18:41.49,0:18:43.51,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:18:43.51,0:18:47.55,Default,,0000,0000,0000,,Сонда өлтірілгендер қайта тіріле алады.
Dialogue: 0,0:18:47.55,0:18:51.59,Default,,0000,0000,0000,,Пикколо мырза да қайта тіріледі! Гохан, не істеп жатырсың?
Dialogue: 0,0:18:51.59,0:18:54.62,Default,,0000,0000,0000,,Дұрыс. Егер Пикколо қайта тірілсе, Құдай да қайта тіріледі...
Dialogue: 0,0:18:54.62,0:18:57.62,Default,,0000,0000,0000,,Бұл жерде Айдаһар шарларын да қайта жандандыруға болады дегенді білдіреді.
Dialogue: 0,0:18:59.67,0:19:01.69,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:19:01.69,0:19:05.73,Default,,0000,0000,0000,,Әй, бұл жігіт болар.
Dialogue: 0,0:19:05.73,0:19:08.76,Default,,0000,0000,0000,,Дұрыс, дұрыс, дұрыс! (Каме Эрмит) Ахахаха!
Dialogue: 0,0:19:08.76,0:19:13.81,Default,,0000,0000,0000,,Ахх. Әуесқойлар үшін бұл қарапайым.
Dialogue: 0,0:19:13.81,0:19:16.84,Default,,0000,0000,0000,,Мұндай нәрсе ешқашан болуы мүмкін емес.
Dialogue: 0,0:19:16.84,0:19:18.86,Default,,0000,0000,0000,,Менің көңілім қалды.
Dialogue: 0,0:19:18.86,0:19:20.88,Default,,0000,0000,0000,,Бұл мүмкін емес пе? Тіпті Бұлма-сан.
Dialogue: 0,0:19:20.88,0:19:24.92,Default,,0000,0000,0000,,Криллин, жұлдыз сол жерде.→
Dialogue: 0,0:19:24.92,0:19:27.95,Default,,0000,0000,0000,,Біз қайдан білеміз? (Криллин, Мастер Роши) Ах, ах...
Dialogue: 0,0:19:27.95,0:19:30.98,Default,,0000,0000,0000,,Маған қалдырыңыз. (Криллин, Мастер Роши) Иә?
Dialogue: 0,0:19:30.98,0:19:32.00,Default,,0000,0000,0000,,《Кай-сама, сен оны естідің. →
Dialogue: 0,0:19:32.00,0:19:36.04,Default,,0000,0000,0000,,Сіз білесіз бе? Сол Намек планетасы жұлдыздың орны.
Dialogue: 0,0:19:36.04,0:19:40.41,Default,,0000,0000,0000,,《Намек планетасы? Әрине білемін. →
Dialogue: 0,0:19:40.41,0:19:44.45,Default,,0000,0000,0000,,Өйткені мен Кай патшасымын.
Dialogue: 0,0:19:44.45,0:19:47.48,Default,,0000,0000,0000,,Бұл керемет. Мен де естимін.
Dialogue: 0,0:19:47.48,0:19:50.51,Default,,0000,0000,0000,,Эй, бұл адам Кай патша ма?
Dialogue: 0,0:19:50.51,0:19:53.54,Default,,0000,0000,0000,,Кай мырза, бәрі де тыңдап тұрған сияқты→
Dialogue: 0,0:19:53.54,0:19:55.56,Default,,0000,0000,0000,,Айтыңызшы.
Dialogue: 0,0:19:55.56,0:19:58.59,Default,,0000,0000,0000,,Хмм, Намектің орны →
Dialogue: 0,0:19:58.59,0:20:02.63,Default,,0000,0000,0000,,Балалар, егер сіз Жер туралы айтатын болсаңыз, онда...
Dialogue: 0,0:20:02.63,0:20:05.66,Default,,0000,0000,0000,,Хмм, SW66 бағыты... →
Dialogue: 0,0:20:05.66,0:20:08.69,Default,,0000,0000,0000,,Жоқ, жоқ, erm →
Dialogue: 0,0:20:08.69,0:20:11.72,Default,,0000,0000,0000,,Дұрыс, SU83 бағыты →
Dialogue: 0,0:20:11.72,0:20:16.77,Default,,0000,0000,0000,,Хмм, 9045YX?
Dialogue: 0,0:20:16.77,0:20:19.80,Default,,0000,0000,0000,,Кю! Бұл 9045YX!?
Dialogue: 0,0:20:19.80,0:20:22.83,Default,,0000,0000,0000,,Бұлма-сан, түсіндің бе? Қазір.
Dialogue: 0,0:20:22.83,0:20:26.87,Default,,0000,0000,0000,,Эй, Каме-чан, басқаруды қолға ал. Мен математиканы жасаймын.
Dialogue: 0,0:20:26.87,0:20:28.89,Default,,0000,0000,0000,,Каме-чан?
Dialogue: 0,0:20:28.89,0:20:34.95,Default,,0000,0000,0000,,Дегенмен, Намек өте әдемі жұлдыз болды→
Dialogue: 0,0:20:34.95,0:20:37.15,Default,,0000,0000,0000,,Ауа райының күрт ауытқуына байланысты көп уақыт бұрын болғанына сенімдімін→
Dialogue: 0,0:20:37.15,0:20:41.35,Default,,0000,0000,0000,,Сол кезде мен Намекилер өлді деп ойладым.
Dialogue: 0,0:20:41.35,0:20:45.39,Default,,0000,0000,0000,,Шынымен, жоқ. Айдаһар добы сияқты ештеңе жоқ.
Dialogue: 0,0:20:45.39,0:20:47.41,Default,,0000,0000,0000,,Келіңіздер!
Dialogue: 0,0:20:47.41,0:20:51.45,Default,,0000,0000,0000,,Ал, үрейленбеңіз. Мұны Namek планетасын зерттеу арқылы көруге болады.
Dialogue: 0,0:20:51.45,0:20:55.49,Default,,0000,0000,0000,,Хмм, қай жерде болды екен...
Dialogue: 0,0:20:55.49,0:20:59.53,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:20:59.53,0:21:01.55,Default,,0000,0000,0000,,Эй, осылай ма?
Dialogue: 0,0:21:01.55,0:21:05.59,Default,,0000,0000,0000,,Түсіндім, сондықтан ол құдай болды... Жоқ, ол ақырында құдай болды→
Dialogue: 0,0:21:05.59,0:21:09.63,Default,,0000,0000,0000,,Сонымен бір Намекиан Жерге қашып кетті ме?
Dialogue: 0,0:21:09.63,0:21:12.66,Default,,0000,0000,0000,,Мұны тіпті Құдайдың өзі де ұмытқан →
Dialogue: 0,0:21:12.66,0:21:15.69,Default,,0000,0000,0000,,Ол есте сақтау қабілетін жоғалтты ма? Ол шынымен бала болды ма? →
Dialogue: 0,0:21:15.69,0:21:18.72,Default,,0000,0000,0000,,Қалай болғанда да, бұл қайғылы өткен.
Dialogue: 0,0:21:18.72,0:21:22.76,Default,,0000,0000,0000,,Дегенмен, Айдаһар шары дегеніміз не?→
Dialogue: 0,0:21:22.76,0:21:26.80,Default,,0000,0000,0000,,Кез келген тілек орындалады, солай ма? Егер сіз осындай нәрсені жасай алсаңыз →
Dialogue: 0,0:21:26.80,0:21:30.84,Default,,0000,0000,0000,,Олардан әдеттен тыс ауа-райын тоқтатуды сұраңыз.
Dialogue: 0,0:21:30.84,0:21:34.88,Default,,0000,0000,0000,,Бұл мүмкін емес. Шенрон айтты.
Dialogue: 0,0:21:34.88,0:21:40.28,Default,,0000,0000,0000,,Айдаһар шарларын жасаған адамның күшінен асатын тілек орындалмайды.
Dialogue: 0,0:21:40.28,0:21:43.31,Default,,0000,0000,0000,,Керемет қуатты басу мүмкін емес.
Dialogue: 0,0:21:43.31,0:21:47.35,Default,,0000,0000,0000,,Сонымен Шенрон да Сайяндар туралы ештеңе істей алмады.
Dialogue: 0,0:21:47.35,0:21:51.39,Default,,0000,0000,0000,,Дұрыс. Dragon Ball - бұл үлкен мәселе емес.
Dialogue: 0,0:21:51.39,0:21:53.41,Default,,0000,0000,0000,,Ке.
Dialogue: 0,0:21:53.41,0:21:57.45,Default,,0000,0000,0000,,Няаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа ocogebessssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss''
Dialogue: 0,0:21:57.45,0:22:00.48,Default,,0000,0000,0000,,Не болды! Alien Namek осында!
Dialogue: 0,0:22:00.48,0:22:04.52,Default,,0000,0000,0000,,Тек 100-ден аз адам аман қалды және қайтадан гүлденуде!
Dialogue: 0,0:22:04.52,0:22:06.54,Default,,0000,0000,0000,,О! (Яджиробе) Түсініңіз!
Dialogue: 0,0:22:06.54,0:22:09.54,Default,,0000,0000,0000,,Ондай 100 адам бар.
Dialogue: 0,0:22:14.62,0:22:18.66,Default,,0000,0000,0000,,Уайымдамаңыз. Бастапқыда намекиялықтар → болды
Dialogue: 0,0:22:18.66,0:22:21.69,Default,,0000,0000,0000,,Олар өте жұмсақ нәсіл. →
Dialogue: 0,0:22:21.69,0:22:25.73,Default,,0000,0000,0000,,Сен де ол сияқты жердің құдайы едің. →
Dialogue: 0,0:22:25.73,0:22:28.76,Default,,0000,0000,0000,,Пикколо Даймау, бәлкім, →
Dialogue: 0,0:22:28.76,0:22:33.81,Default,,0000,0000,0000,,Тәңір болмай тұрып кездескен жердегілердің зұлымдығы әсерінен→
Dialogue: 0,0:22:33.81,0:22:37.81,Default,,0000,0000,0000,,Ол жасалған болуы керек.
Dialogue: 0,0:22:40.21,0:22:44.25,Default,,0000,0000,0000,,көремін. Әлемде адамдар бар→
Dialogue: 0,0:22:44.25,0:22:47.28,Default,,0000,0000,0000,,Сонда сен кішкентай адамсың. Босс.
Dialogue: 0,0:22:47.28,0:22:50.31,Default,,0000,0000,0000,,Бірақ мұнымен, Құдайды былай қойғанда, Ямча мен Теншинхан→
Dialogue: 0,0:22:50.31,0:22:53.34,Default,,0000,0000,0000,,Енді қайта тірілу мүмкіндігі бар!
Dialogue: 0,0:22:53.34,0:22:56.37,Default,,0000,0000,0000,,Иә, иә. тәтті! Бұл мүлдем тәтті. →
Dialogue: 0,0:22:56.37,0:22:59.40,Default,,0000,0000,0000,,Мен Намек планетасының қайда екенін білемін. →
Dialogue: 0,0:22:59.40,0:23:01.42,Default,,0000,0000,0000,,Бірақ ол жерге қалай жетуге болады?
Dialogue: 0,0:23:01.42,0:23:05.46,Default,,0000,0000,0000,,Қалай дегенге келсек, әрине бұл ғарыш кемесі болды.
Dialogue: 0,0:23:05.46,0:23:08.49,Default,,0000,0000,0000,,Мүлдем тәтті деп отырмын. →
Dialogue: 0,0:23:08.49,0:23:12.53,Default,,0000,0000,0000,,Сынақ жүргізу кезінде мен әкем жасаған әлемдегі ең жақсы қозғалтқышпен жабдықталған ғарыш кемесін пайдаландым→
Dialogue: 0,0:23:12.53,0:23:16.57,Default,,0000,0000,0000,,Мен Намек планетасына жетуге кететін уақытты есептедім.
Dialogue: 0,0:23:16.57,0:23:21.62,Default,,0000,0000,0000,,Бұл өте жақсы сан.
Dialogue: 0,0:23:21.62,0:23:26.67,Default,,0000,0000,0000,,4339 жыл 3 ай. Мен ұзақ өмір сүруім керек.
Dialogue: 0,0:23:26.67,0:23:28.69,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:28.69,0:23:32.73,Default,,0000,0000,0000,,Хе-хэ, менің ойымша, бұл жағдайда жақсы.
Dialogue: 0,0:23:32.73,0:23:36.77,Default,,0000,0000,0000,,Мен сізге Сайяндар мінген ғарыш кемесін пайдалануға рұқсат беруді ойлаймын. →
Dialogue: 0,0:23:36.77,0:23:40.81,Default,,0000,0000,0000,,Мен Вегетаның ғарыш кемесін көрдім, бірақ ол өте кішкентай→
Dialogue: 0,0:23:40.81,0:23:43.84,Default,,0000,0000,0000,,Қалай қарасаң да бір орындық. Бұл → дегенді білдіреді
Dialogue: 0,0:23:43.84,0:23:46.87,Default,,0000,0000,0000,,Бір жерде тағы бір өлі ғарыш кемесі болуы керек.
Dialogue: 0,0:23:46.87,0:23:51.92,Default,,0000,0000,0000,,Дұрыс, Оланың үлкен ағасы келген жер.
Dialogue: 0,0:23:51.92,0:23:54.95,Default,,0000,0000,0000,,А, мен оны бұздым деп ойлаймын.
Dialogue: 0,0:23:54.95,0:23:56.97,Default,,0000,0000,0000,,《Гохан》
Dialogue: 0,0:23:56.97,0:23:58.99,Default,,0000,0000,0000,,Бірақ бәрібір, біреуі бар.
Dialogue: 0,0:23:58.99,0:24:01.02,Default,,0000,0000,0000,,Егер сіз оны іздеп, талдасаңыз, сіз бұл туралы бірдеңе жасай аласыз.
Dialogue: 0,0:24:01.02,0:24:07.08,Default,,0000,0000,0000,,Бұл шығыс астанада болса керек. Сайяндардың ең алғаш қирататын жері болды.
Dialogue: 0,0:24:07.08,0:24:09.10,Default,,0000,0000,0000,,Мен оны кейінірек іздеуім керек.
Dialogue: 0,0:24:09.10,0:24:13.14,Default,,0000,0000,0000,,Хехехе мен де солай ойлап, жақсы нәрселерді жинадым.
Dialogue: 0,0:24:13.14,0:24:17.18,Default,,0000,0000,0000,,Бұл Вегета. Мен оның мұны қатты соққымен жасайтынына сенімдімін→
Dialogue: 0,0:24:17.18,0:24:21.18,Default,,0000,0000,0000,,Менің ойымша, олар ғарыш кемесін шақырды. Бұл қашықтан басқару құралы, мен сенімдімін.
Dialogue: 0,0:24:23.24,0:24:26.27,Default,,0000,0000,0000,,Муф, муф, шуф.
Dialogue: 0,0:24:26.27,0:24:29.30,Default,,0000,0000,0000,,Мен мұны істей алатыныма сенімдімін.
Dialogue: 0,0:24:29.30,0:24:34.35,Default,,0000,0000,0000,,Хе хехе мен жасадым мен жасадым! Үміт бар! →
Dialogue: 0,0:24:34.35,0:24:36.37,Default,,0000,0000,0000,,Хахаха! →
Dialogue: 0,0:24:36.37,0:24:39.73,Default,,0000,0000,0000,,Намек планетасына мақсат қойыңыз! →
Dialogue: 0,0:24:39.73,0:24:42.76,Default,,0000,0000,0000,,Не болды! Хахаха.
Dialogue: 0,0:24:42.76,0:24:44.78,Default,,0000,0000,0000,,<Біз көздейтін жұлдыз анықталды. →
Dialogue: 0,0:24:44.78,0:24:50.78,Default,,0000,0000,0000,,Бірақ бұған дейін әлі де қиын мәселе бар сияқты...＞
Dialogue: 0,0:24:52.86,0:24:57.91,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:57.91,0:25:17.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:17.11,0:25:37.48,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:37.48,0:25:50.48,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:53.80,0:25:56.83,Default,,0000,0000,0000,,Сәлем, мен Гоханмын.
Dialogue: 0,0:25:56.83,0:25:59.86,Default,,0000,0000,0000,,Уау! Булма-сан, ғарыш кемесі бөлшектелді!
Dialogue: 0,0:25:59.86,0:26:01.88,Default,,0000,0000,0000,,Бұл маңызды емес. →
Dialogue: 0,0:26:01.88,0:26:04.91,Default,,0000,0000,0000,,Крам мектебі, фортепиано, сабақтар, каллиграфия, абакус, ағылшынша әңгіме...
Dialogue: 0,0:26:04.91,0:26:07.94,Default,,0000,0000,0000,,Шулы! Қазір олай айтатын уақыт емес!
Dialogue: 0,0:26:07.94,0:26:10.97,Default,,0000,0000,0000,,Гого Гохан қылмыскерге айналды!
Dialogue: 0,0:26:10.97,0:26:13.97,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:16.03,0:26:19.03,Default,,0000,0000,0000,,Нағыз Шенронды көруге де бару керек.
Dialogue: 0,0:26:20.53,0:26:26.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory