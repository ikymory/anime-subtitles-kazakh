Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.33,0:00:03.27,Default,,0,0,0,,｟(Балалар) Мұғалім Жақында кездескенше! ➡
Dialogue: 0,0:00:03.27,0:00:05.27,Default,,0,0,0,,Келесі жолы мен жеңемін!
Dialogue: 0,0:00:05.27,0:00:07.30,Default,,0,0,0,,Сені қалай жеңетінін айт!
Dialogue: 0,0:00:07.30,0:00:09.77,Default,,0,0,0,,Уау! 100 жыл тез.
Dialogue: 0,0:00:12.81,0:00:14.78,Default,,0,0,0,,Әдеттегідей. О?
Dialogue: 0,0:00:17.78,0:00:19.75,Default,,0,0,0,,Нао-чан!
Dialogue: 0,0:00:19.75,0:00:22.25,Default,,0,0,0,,Мен сені көруге келдім, Каге-кун.
Dialogue: 0,0:00:22.25,0:00:24.79,Default,,0,0,0,,Сонымен➡
Dialogue: 0,0:00:24.79,0:00:28.26,Default,,0,0,0,,Нао Инабе, тілегім орындалып, наразылық сынағынан өттім!
Dialogue: 0,0:00:28.26,0:00:30.26,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:30.26,0:00:32.26,Default,,0,0,0,,Мен білемін. Бұл не~➡
Dialogue: 0,0:00:32.26,0:00:34.26,Default,,0,0,0,,Мен сізді таң қалдырамын деп ойладым.
Dialogue: 0,0:00:34.26,0:00:36.27,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:00:36.27,0:00:38.27,Default,,0,0,0,,Бұл менің басымнан өтіп жатыр.
Dialogue: 0,0:00:38.27,0:00:42.27,Default,,0,0,0,,Әй, саған біраз уақыт аю жіберген жігіт пе?
Dialogue: 0,0:00:42.27,0:00:44.77,Default,,0,0,0,,Ей...бұл ескі әңгіме!
Dialogue: 0,0:00:44.77,0:00:46.78,Default,,0,0,0,,Бұл баяғыда ма?
Dialogue: 0,0:00:46.78,0:00:48.78,Default,,0,0,0,,Бұл көп уақыт бұрын болды.
Dialogue: 0,0:00:48.78,0:00:50.81,Default,,0,0,0,,А...О, иә! ➡
Dialogue: 0,0:00:50.81,0:00:53.78,Default,,0,0,0,,Менің шәкіртім бар. Мм...шәкірт?
Dialogue: 0,0:00:53.78,0:00:57.29,Default,,0,0,0,,Ум! Мен Vanguard қолданбасын қолдана бастағаныма бір жылдай ғана болды.
Dialogue: 0,0:00:57.29,0:01:02.26,Default,,0,0,0,,Ол тез үйренеді, өзегі күшті➡
Dialogue: 0,0:01:02.26,0:01:04.76,Default,,0,0,0,,Егер сіз мұны шешсеңіз, газ педальын толық дроссельмен ашыңыз! ➡
Dialogue: 0,0:01:04.76,0:01:06.83,Default,,0,0,0,,ұнайды ма?
Dialogue: 0,0:01:06.83,0:01:09.80,Default,,0,0,0,,Бұл қауіпті, бірақ сенімді➡
Dialogue: 0,0:01:09.80,0:01:11.80,Default,,0,0,0,,Әрқашан ғажайыптарға сеніп, қолыңызды созыңыз➡
Dialogue: 0,0:01:11.80,0:01:15.27,Default,,0,0,0,,Мен сондай баламын. Бұл... ұл ба?
Dialogue: 0,0:01:36.73,0:01:38.73,Default,,0,0,0,,Кагецу Якумо…сан.
Dialogue: 0,0:01:38.73,0:01:41.73,Default,,0,0,0,,Иә, жас кезімде➡
Dialogue: 0,0:01:41.73,0:01:44.73,Default,,0,0,0,,Сол маңда тұратын Каге-кун маған Авангард туралы айтып берді.
Dialogue: 0,0:01:44.73,0:01:46.74,Default,,0,0,0,,Сонымен, шебер.
Dialogue: 0,0:01:46.74,0:01:48.77,Default,,0,0,0,,Ал... міне, солай.
Dialogue: 0,0:01:48.77,0:01:51.24,Default,,0,0,0,,Ештеңе артық, кем емес.
Dialogue: 0,0:01:51.24,0:01:53.21,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:01:53.21,0:01:55.21,Default,,0,0,0,,А...енді жеңілдіңіз бе?
Dialogue: 0,0:01:55.21,0:01:57.21,Default,,0,0,0,,Жарайды, мен олай айтып тұрған жоқпын.
Dialogue: 0,0:01:57.21,0:01:59.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:59.25,0:02:02.28,Default,,0,0,0,,Бала! Негізі мен сені көруге келдім.
Dialogue: 0,0:02:02.28,0:02:04.72,Default,,0,0,0,,E? Нао Чанның шәкірті➡
Dialogue: 0,0:02:04.72,0:02:06.72,Default,,0,0,0,,Оның қандай адам екенін көргім келді.
Dialogue: 0,0:02:08.22,0:02:10.23,Default,,0,0,0,,Менімен күресейік.
Dialogue: 0,0:02:14.23,0:02:17.70,Default,,0,0,0,,Хафф...дәмді!
Dialogue: 0,0:02:18.73,0:02:20.74,Default,,0,0,0,,Хикари-чан, сенің тәбетің зор.
Dialogue: 0,0:02:20.74,0:02:23.74,Default,,0,0,0,,Маған дәл қазір дәмді нәрсе жеу керек➡
Dialogue: 0,0:02:23.74,0:02:27.21,Default,,0,0,0,,Көкөністер... балдыркөк тозағы!
Dialogue: 0,0:02:27.21,0:02:29.21,Default,,0,0,0,,Балдыркөк тозағы?
Dialogue: 0,0:02:29.21,0:02:31.21,Default,,0,0,0,,Жарайды! ➡
Dialogue: 0,0:02:31.21,0:02:33.72,Default,,0,0,0,,Келесі жолы шоколадты бананды көріңіз!
Dialogue: 0,0:02:33.72,0:02:35.72,Default,,0,0,0,,A...? а….
Dialogue: 0,0:02:37.32,0:02:39.76,Default,,0,0,0,,Ол келе жатыр еді. Жақсы.
Dialogue: 0,0:02:39.76,0:02:43.26,Default,,0,0,0,,Ағаңызбен танысқыңыз келе ме? Өйткені сізді шақырды.
Dialogue: 0,0:02:44.73,0:02:47.76,Default,,0,0,0,,Мм... жақсысың ба?
Dialogue: 0,0:02:47.76,0:02:50.73,Default,,0,0,0,,Мен туралы бәрін білетін адам➡
Dialogue: 0,0:02:50.73,0:02:53.27,Default,,0,0,0,,Бұл тіпті ыңғайсыз емес...
Dialogue: 0,0:02:53.27,0:02:56.24,Default,,0,0,0,,Олар үзіліс кезінде де сахнада төбелесетін сияқты.
Dialogue: 0,0:02:56.24,0:02:58.27,Default,,0,0,0,,А...?
Dialogue: 0,0:02:58.27,0:03:00.71,Default,,0,0,0,,Кім және кім? Олардың бірі үшінші курста оқитын Мэйду еді.
Dialogue: 0,0:03:00.71,0:03:03.21,Default,,0,0,0,,А...у! ➡
Dialogue: 0,0:03:03.21,0:03:05.21,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:03:05.21,0:03:07.22,Default,,0,0,0,,Біз бірге дем аламыз.
Dialogue: 0,0:03:09.75,0:03:12.72,Default,,0,0,0,,Маған осындай әдемі сахнаны сыйлағаның өкінішті.
Dialogue: 0,0:03:12.72,0:03:14.76,Default,,0,0,0,,Жарайды➡
Dialogue: 0,0:03:14.76,0:03:18.23,Default,,0,0,0,,Менің сыныбым мені шымшып ұрушы болуды өтінді, сондықтан уайымдамаңыз! Акина.
Dialogue: 0,0:03:18.23,0:03:20.70,Default,,0,0,0,,Рахмет. Ендеше... жасайық.
Dialogue: 0,0:03:20.70,0:03:22.73,Default,,0,0,0,,Сәлем! Өйткені біз жарысып жатырмыз ➡
Dialogue: 0,0:03:22.73,0:03:24.73,Default,,0,0,0,,Мен сізге жеңіске жетуге рұқсат етемін!
Dialogue: 0,0:03:24.73,0:03:26.74,Default,,0,0,0,,Фу….
Dialogue: 0,0:03:26.74,0:03:28.74,Default,,0,0,0,,Сіз Кагецу Якумоны білесіз бе?
Dialogue: 0,0:03:28.74,0:03:31.71,Default,,0,0,0,,Мен білемін, бірақ ол жігітке не болды?
Dialogue: 0,0:03:31.71,0:03:33.71,Default,,0,0,0,,Сіз мені бұл жолы люкс бөлмесіне шақырдыңыз➡
Dialogue: 0,0:03:33.71,0:03:35.71,Default,,0,0,0,,Джинки осылай деді.
Dialogue: 0,0:03:35.71,0:03:38.21,Default,,0,0,0,,Эй, солай ма?
Dialogue: 0,0:03:38.21,0:03:40.22,Default,,0,0,0,,Әлі есімде жақсы➡
Dialogue: 0,0:03:40.22,0:03:42.22,Default,,0,0,0,,Егер мен онымен жарыса алсам➡
Dialogue: 0,0:03:42.22,0:03:44.72,Default,,0,0,0,,Бұл қаншалықты қызық болды!
Dialogue: 0,0:03:44.72,0:03:46.72,Default,,0,0,0,,Бұл керемет болды ма?
Dialogue: 0,0:03:46.72,0:03:48.76,Default,,0,0,0,,Ах! Адалдық➡
Dialogue: 0,0:03:48.76,0:03:51.73,Default,,0,0,0,,Ол кезде менен күшті еді.
Dialogue: 0,0:03:51.73,0:03:54.73,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:03:54.73,0:03:57.23,Default,,0,0,0,,Сол кезде...бірақ➡
Dialogue: 0,0:03:57.23,0:03:59.23,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:03:59.23,0:04:03.74,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:03.74,0:04:06.21,Default,,0,0,0,,Тағы бір нәрсе басталып жатыр.
Dialogue: 0,0:04:06.21,0:04:08.21,Default,,0,0,0,,Акина... жасырын.
Dialogue: 0,0:04:08.21,0:04:15.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:15.22,0:04:17.22,Default,,0,0,0,,Олай болса! ➡
Dialogue: 0,0:04:17.22,0:04:19.72,Default,,0,0,0,,Келіңіздер... күресейік!
Dialogue: 0,0:04:19.72,0:04:22.22,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:04:22.22,0:04:24.76,Default,,0,0,0,,Амбиция қанаттары Соел!
Dialogue: 0,0:04:24.76,0:04:27.23,Default,,0,0,0,,Lunar Messenger Repsolt. Менің кезегім➡
Dialogue: 0,0:04:27.23,0:04:29.23,Default,,0,0,0,,Вентестаға бару.
Dialogue: 0,0:04:29.23,0:04:31.73,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім➡
Dialogue: 0,0:04:31.73,0:04:33.74,Default,,0,0,0,,Френельде Ай Сквайрының жүруі.
Dialogue: 0,0:04:33.74,0:04:35.77,Default,,0,0,0,,Френель дағдылары➡
Dialogue: 0,0:04:35.77,0:04:39.21,Default,,0,0,0,,Ай қақпасын палубадан тапсырыс аймағына орнатыңыз.
Dialogue: 0,0:04:39.21,0:04:41.21,Default,,0,0,0,,Бала Оны елестетіп көріңіз.
Dialogue: 0,0:04:41.21,0:04:43.25,Default,,0,0,0,,Е...?
Dialogue: 0,0:04:43.25,0:04:45.71,Default,,0,0,0,,Айда қалқып тұрған басқа әлемге ашылатын қақпа➡
Dialogue: 0,0:04:45.71,0:04:47.88,Default,,0,0,0,,Арғы жағында жасырынған нәрсе➡
Dialogue: 0,0:04:47.88,0:04:50.35,Default,,0,0,0,,Шындықты анықтайтын ай туралы миф.
Dialogue: 0,0:04:51.72,0:04:54.22,Default,,0,0,0,,Оның аты...Елес Синдзю.
Dialogue: 0,0:04:54.22,0:04:56.22,Default,,0,0,0,,Геншинжу….
Dialogue: 0,0:04:56.22,0:04:58.23,Default,,0,0,0,,Френельмен шабуыл.
Dialogue: 0,0:04:58.23,0:05:00.23,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:05:00.23,0:05:02.26,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:05:02.26,0:05:05.27,Default,,0,0,0,,Azensior Call Bentesta-ға шеберлікпен барыңыз➡
Dialogue: 0,0:05:05.27,0:05:08.74,Default,,0,0,0,,Содан кейін Nilberis Novia Aerial телефонына қоңырау шалыңыз.
Dialogue: 0,0:05:08.74,0:05:10.74,Default,,0,0,0,,Новиямен шабуыл.
Dialogue: 0,0:05:10.74,0:05:12.71,Default,,0,0,0,,Күзетші. шабуыл.
Dialogue: 0,0:05:12.71,0:05:14.71,Default,,0,0,0,,Күзетші жоқ. шабуыл!
Dialogue: 0,0:05:14.71,0:05:17.71,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:05:17.71,0:05:20.22,Default,,0,0,0,,Ал... менің кезегім.
Dialogue: 0,0:05:20.22,0:05:22.72,Default,,0,0,0,,Лумсденге айға адал сапар.
Dialogue: 0,0:05:22.72,0:05:24.72,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:05:24.72,0:05:26.76,Default,,0,0,0,,Палубаның жоғарғы 7 картасынан➡
Dialogue: 0,0:05:26.76,0:05:29.22,Default,,0,0,0,,Қолыңызға бір Karasuwa Phantom Beast Levnologue қосыңыз➡
Dialogue: 0,0:05:29.22,0:05:31.73,Default,,0,0,0,,Бір картаны тапсырыс аймағына қойыңыз.
Dialogue: 0,0:05:31.73,0:05:33.73,Default,,0,0,0,,Ай қақпасы...Бастаңыз!
Dialogue: 0,0:05:33.73,0:05:35.76,Default,,0,0,0,,Палубаның жоғарғы 7 картасынан➡
Dialogue: 0,0:05:35.76,0:05:38.73,Default,,0,0,0,,Левнологқа қоңырау шалыңыз Левнологқа қолыңыздан да қоңырау шалыңыз.
Dialogue: 0,0:05:38.73,0:05:41.27,Default,,0,0,0,,Бір бірліктер бірінен соң бірі...
Dialogue: 0,0:05:41.27,0:05:45.71,Default,,0,0,0,,Revnologue – палубасында 16 бөлік болуы мүмкін бірлік.
Dialogue: 0,0:05:45.71,0:05:48.71,Default,,0,0,0,,Керемет! Осындай бірліктер бар.
Dialogue: 0,0:05:48.71,0:05:50.71,Default,,0,0,0,,Дұрыс➡
Dialogue: 0,0:05:50.71,0:05:53.22,Default,,0,0,0,,Авангард әлемі кең.
Dialogue: 0,0:05:53.22,0:05:55.22,Default,,0,0,0,,Лумсдендегі шабуыл.
Dialogue: 0,0:05:55.22,0:05:57.75,Default,,0,0,0,,Күзетші жоқ. Көлікті тексеру➡
Dialogue: 0,0:05:57.75,0:06:01.22,Default,,0,0,0,,Critical Trigger Revnologue Пауэр Plus 10000➡
Dialogue: 0,0:06:01.22,0:06:03.23,Default,,0,0,0,,Ramsden Critical Plus 1.
Dialogue: 0,0:06:03.23,0:06:05.23,Default,,0,0,0,,U….
Dialogue: 0,0:06:05.23,0:06:07.23,Default,,0,0,0,,Revnologue көмегімен шабуыл.
Dialogue: 0,0:06:07.23,0:06:09.23,Default,,0,0,0,,Кесу!
Dialogue: 0,0:06:09.23,0:06:11.23,Default,,0,0,0,,Шабуыл. күзетші.
Dialogue: 0,0:06:11.23,0:06:13.74,Default,,0,0,0,,Бұрылыс соңы... Толығырақ көрсету➡
Dialogue: 0,0:06:13.74,0:06:15.74,Default,,0,0,0,,Сіз өзіңіз.
Dialogue: 0,0:06:15.74,0:06:17.74,Default,,0,0,0,,Оның альтер-эгосына айналатын Авангард.
Dialogue: 0,0:06:17.74,0:06:19.74,Default,,0,0,0,,Әрине➡
Dialogue: 0,0:06:19.74,0:06:22.24,Default,,0,0,0,,Құтқару қанаттары Міне, көктен! ➡
Dialogue: 0,0:06:22.24,0:06:25.25,Default,,0,0,0,,Резаелдің ғажайып тағдырына мініңіз!
Dialogue: 0,0:06:32.75,0:06:35.22,Default,,0,0,0,,Новияға шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:06:35.22,0:06:38.23,Default,,0,0,0,,Сонымен қатар, Гаругаонға қоңырау шалу үшін осы дағдыны пайдаланыңыз!
Dialogue: 0,0:06:38.23,0:06:40.26,Default,,0,0,0,,Нилбериспен шабуыл!
Dialogue: 0,0:06:40.26,0:06:43.73,Default,,0,0,0,,Күзетші. Нилберистің шеберлігімен бір картаны салыңыз.
Dialogue: 0,0:06:43.73,0:06:46.23,Default,,0,0,0,,Резаэльмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:06:46.23,0:06:48.24,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:06:48.24,0:06:50.74,Default,,0,0,0,,Тамшыдан Нилберис пен Антенаны шақырыңыз.
Dialogue: 0,0:06:50.74,0:06:52.71,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:06:52.71,0:06:54.71,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:06:54.71,0:06:56.75,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:06:56.75,0:06:59.71,Default,,0,0,0,,Критикалық триггер! Novia қуаты плюс 10 000.
Dialogue: 0,0:06:59.71,0:07:01.72,Default,,0,0,0,,Резаэльдің сыни плюс 1!
Dialogue: 0,0:07:02.72,0:07:05.72,Default,,0,0,0,,Новиямен шабуыл! Күзетші жоқ➡
Dialogue: 0,0:07:05.72,0:07:07.76,Default,,0,0,0,,Зақымдануды тексеру➡
Dialogue: 0,0:07:07.76,0:07:10.73,Default,,0,0,0,,Емдеу триггері Лумсденнің қуаты +10000.
Dialogue: 0,0:07:10.73,0:07:13.73,Default,,0,0,0,,Әлі жоқ! Нилбериспен шабуыл.
Dialogue: 0,0:07:13.73,0:07:15.73,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:07:15.73,0:07:18.77,Default,,0,0,0,,Резаэль? Жақсы!
Dialogue: 0,0:07:18.77,0:07:21.77,Default,,0,0,0,,Мен сіздің ойыныңызға белгілі бір сенімді сезінемін.
Dialogue: 0,0:07:21.77,0:07:25.24,Default,,0,0,0,,Сәлем! Резаэль бір керемет әкелді➡
Dialogue: 0,0:07:25.24,0:07:28.24,Default,,0,0,0,,Ол маған аяғына дейін қолын созды...
Dialogue: 0,0:07:28.24,0:07:31.25,Default,,0,0,0,,Менің жалғыз және жалғыз өзгертуші эго!
Dialogue: 0,0:07:31.25,0:07:33.75,Default,,0,0,0,,Хмм….
Dialogue: 0,0:07:33.75,0:07:36.72,Default,,0,0,0,,Бірге біраз қиындықты бастан өткерген сияқтысыз.
Dialogue: 0,0:07:36.72,0:07:39.22,Default,,0,0,0,,Жақсы, көп нәрсе болды.
Dialogue: 0,0:07:40.22,0:07:43.22,Default,,0,0,0,,Көп нәрсе болды... иә?
Dialogue: 0,0:07:43.22,0:07:45.76,Default,,0,0,0,,Енді ше? жұмысшы?
Dialogue: 0,0:07:45.76,0:07:48.73,Default,,0,0,0,,Сіз қазір бір нәрсеге қол созып жатырсыз ба?
Dialogue: 0,0:07:48.73,0:07:50.73,Default,,0,0,0,,Қазір….
Dialogue: 0,0:07:50.73,0:07:52.77,Default,,0,0,0,,Не?
Dialogue: 0,0:07:52.77,0:07:56.74,Default,,0,0,0,,Кешіріңіз...! Әйтеуір, менің екінші өзімді ауыртып жатырмын.
Dialogue: 0,0:07:56.74,0:07:59.71,Default,,0,0,0,,Ғажайып періштені сынап көріңіз.
Dialogue: 0,0:07:59.71,0:08:01.71,Default,,0,0,0,,Е...?
Dialogue: 0,0:08:05.71,0:08:07.72,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:08:09.22,0:08:11.22,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:08:11.22,0:08:13.22,Default,,0,0,0,,Менің сот ісім кезеңіне.
Dialogue: 0,0:08:16.19,0:08:18.19,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:08:18.19,0:08:20.73,Default,,0,0,0,,Жолда тұрған алтын жұлдыз➡
Dialogue: 0,0:08:20.73,0:08:23.20,Default,,0,0,0,,Геншин басқа әлемнің ізбасары➡
Dialogue: 0,0:08:23.20,0:08:25.20,Default,,0,0,0,,Абайлаңыз➡
Dialogue: 0,0:08:25.20,0:08:27.70,Default,,0,0,0,,Айдың сынағы... Қазірден бастап!
Dialogue: 0,0:08:27.70,0:08:30.21,Default,,0,0,0,,Жүр!
Dialogue: 0,0:08:30.21,0:08:33.17,Default,,0,0,0,,Айдың қақпашысы Вейсруг!
Dialogue: 0,0:08:34.71,0:08:36.75,Default,,0,0,0,,Ай қақпасы іске қосылды!
Dialogue: 0,0:08:36.75,0:08:40.22,Default,,0,0,0,,Бұл карта Вазеругтың қатысуымен өзінің шынайы күшін көрсетеді.
Dialogue: 0,0:08:40.22,0:08:42.22,Default,,0,0,0,,U….
Dialogue: 0,0:08:42.22,0:08:44.69,Default,,0,0,0,,Палубаның жоғарғы 7 картасынан 1 Ревнологқа қоңырау шалыңыз➡
Dialogue: 0,0:08:44.69,0:08:46.69,Default,,0,0,0,,Тапсырыс аймағына 2 картаны орналастырыңыз.
Dialogue: 0,0:08:46.69,0:08:49.72,Default,,0,0,0,,Және Вазелуг шеберлігін белсендіру➡
Dialogue: 0,0:08:49.72,0:08:53.23,Default,,0,0,0,,Ай қақпасын қайта іске қосыңыз.
Dialogue: 0,0:08:53.23,0:08:56.73,Default,,0,0,0,,Даусымды естісеңіз, ➡ жауап беріңіз
Dialogue: 0,0:08:56.73,0:09:01.20,Default,,0,0,0,,Алғашқы ата, өсиет азу, қиял...
Dialogue: 0,0:09:01.20,0:09:03.67,Default,,0,0,0,,Аспанда ілулі тұрған нағыз аң...
Dialogue: 0,0:09:04.71,0:09:07.68,Default,,0,0,0,,Қоңырау шалыңыз! Алғашқы фантом шынайы аң➡
Dialogue: 0,0:09:07.68,0:09:10.18,Default,,0,0,0,,Тенкай Гаро Розтонир!
Dialogue: 0,0:09:14.72,0:09:16.68,Default,,0,0,0,,Бірінші...Фантом Синджу.
Dialogue: 0,0:09:16.68,0:09:19.69,Default,,0,0,0,,Бұл жігіт басқаларға қарағанда басқа деңгейде емес пе?
Dialogue: 0,0:09:19.69,0:09:23.73,Default,,0,0,0,,Ревно Рогтың Розтонир күшейтуімен шабуыл.
Dialogue: 0,0:09:23.73,0:09:27.70,Default,,0,0,0,,Қарсыласыңыздың авангардын және алдыңғы қатардағы бір артқы қорғаушыны жою үшін шеберлігіңізді пайдаланыңыз.
Dialogue: 0,0:09:27.70,0:09:30.20,Default,,0,0,0,,Бір уақытта шабуыл.
Dialogue: 0,0:09:30.20,0:09:32.20,Default,,0,0,0,,Бір мезгілде шабуыл?
Dialogue: 0,0:09:32.20,0:09:34.70,Default,,0,0,0,,Өзіңіздің қуатыңыз +5000➡
Dialogue: 0,0:09:34.70,0:09:36.70,Default,,0,0,0,,1 картаны сал.
Dialogue: 0,0:09:36.70,0:09:39.21,Default,,0,0,0,,Олай болса тек Резаелге шабуылды қорғаңыз!
Dialogue: 0,0:09:39.21,0:09:41.71,Default,,0,0,0,,Олай болса, Новия шегінуі керек.
Dialogue: 0,0:09:41.71,0:09:43.71,Default,,0,0,0,,U….
Dialogue: 0,0:09:43.71,0:09:45.71,Default,,0,0,0,,Сіз әлі барасыз ба?
Dialogue: 0,0:09:45.71,0:09:47.72,Default,,0,0,0,,Вазеругпен авангардқа шабуыл жасаңыз.
Dialogue: 0,0:09:47.72,0:09:49.75,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:09:49.75,0:09:53.19,Default,,0,0,0,,Бір бағанға реттік аймақтан екі елес аңды шақырыңыз➡
Dialogue: 0,0:09:53.19,0:09:55.69,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 5000.
Dialogue: 0,0:09:55.69,0:09:57.73,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:57.73,0:10:00.70,Default,,0,0,0,,Ревнологпен шабуыл. Күзетші жоқ.
Dialogue: 0,0:10:00.70,0:10:04.20,Default,,0,0,0,,Басқа ревнологпен шабуыл.
Dialogue: 0,0:10:04.20,0:10:06.70,Default,,0,0,0,,Күзетші! Соңына бұрылу.
Dialogue: 0,0:10:08.70,0:10:10.71,Default,,0,0,0,,Күшті...бірақ➡
Dialogue: 0,0:10:10.71,0:10:13.71,Default,,0,0,0,,Мен және Резаэль арасындағы ұрыс осы жерден басталады.
Dialogue: 0,0:10:13.71,0:10:16.74,Default,,0,0,0,,Мм...бар күшіңізбен келіңіз!
Dialogue: 0,0:10:16.74,0:10:19.71,Default,,0,0,0,,Шарасыз жағдайды төңкеретін ғажайып➡
Dialogue: 0,0:10:19.71,0:10:22.18,Default,,0,0,0,,Кеттік! Менің кезегім.
Dialogue: 0,0:10:24.22,0:10:26.72,Default,,0,0,0,,Тағдыр тілегі О, байлаушы патша...
Dialogue: 0,0:10:28.69,0:10:31.69,Default,,0,0,0,,Өміріңді ақ қанатпен басқар!
Dialogue: 0,0:10:31.69,0:10:34.70,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:10:34.70,0:10:36.70,Default,,0,0,0,,Ғажайып тағдыр патшасы...
Dialogue: 0,0:10:47.21,0:10:49.21,Default,,0,0,0,,Резаэль Вита!
Dialogue: 0,0:10:49.21,0:10:51.25,Default,,0,0,0,,Novia➡ телефонына қоңырау шалыңыз
Dialogue: 0,0:10:51.25,0:10:54.22,Default,,0,0,0,,Осы дағдымен басқа Новианы шақырыңыз.
Dialogue: 0,0:10:54.22,0:10:56.18,Default,,0,0,0,,Ғажайып келу!
Dialogue: 0,0:10:56.18,0:10:58.19,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:10:58.19,0:11:00.22,Default,,0,0,0,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:11:00.22,0:11:02.69,Default,,0,0,0,,Барлық түсірілген маңызды триггерлерді палубаға қайтарыңыз➡
Dialogue: 0,0:11:02.69,0:11:04.69,Default,,0,0,0,,Drive Plus 1.
Dialogue: 0,0:11:04.69,0:11:06.69,Default,,0,0,0,,О….
Dialogue: 0,0:11:06.69,0:11:08.70,Default,,0,0,0,,Новиямен шабуыл. Күзетші жоқ.
Dialogue: 0,0:11:08.70,0:11:11.70,Default,,0,0,0,,Басқа Новиямен шабуыл.
Dialogue: 0,0:11:11.70,0:11:13.70,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:11:13.70,0:11:15.70,Default,,0,0,0,,Тағдыр патшасының қанаттары!
Dialogue: 0,0:11:15.70,0:11:17.71,Default,,0,0,0,,Резаэль Вита➡
Dialogue: 0,0:11:17.71,0:11:19.71,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:11:19.71,0:11:21.71,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:11:21.71,0:11:23.75,Default,,0,0,0,,Резаелді қолыңыздан жаныңызға салу арқылы➡
Dialogue: 0,0:11:23.75,0:11:26.71,Default,,0,0,0,,Тамшыны Nilberis Gigantech Gargaon деп атаңыз.
Dialogue: 0,0:11:26.71,0:11:28.68,Default,,0,0,0,,Олардың қуаты плюс 5000.
Dialogue: 0,0:11:30.18,0:11:32.69,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:11:32.69,0:11:34.69,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:11:34.69,0:11:36.69,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:11:36.69,0:11:38.73,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:11:38.73,0:11:41.70,Default,,0,0,0,,Gigantech қуаты плюс 10000 критикалық плюс 1.
Dialogue: 0,0:11:41.70,0:11:43.73,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:11:43.73,0:11:45.73,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:11:45.73,0:11:49.70,Default,,0,0,0,,Гигантехтің күші +10000 Нилберистің критикалық +1!
Dialogue: 0,0:11:49.70,0:11:51.71,Default,,0,0,0,,Gigantech-пен шабуыл!
Dialogue: 0,0:11:51.71,0:11:54.71,Default,,0,0,0,,Тағы бір толық күзет...
Dialogue: 0,0:11:54.71,0:11:56.71,Default,,0,0,0,,Нилбериспен шабуыл.
Dialogue: 0,0:11:56.71,0:11:59.25,Default,,0,0,0,,Күзетшілерді ұстау.
Dialogue: 0,0:11:59.25,0:12:02.72,Default,,0,0,0,,Ал осы уақытта Вазелугтың шеберлігі іске қосылады➡
Dialogue: 0,0:12:02.72,0:12:05.22,Default,,0,0,0,,Күзетшіге фантом Синджу жібергенде➡
Dialogue: 0,0:12:05.22,0:12:08.22,Default,,0,0,0,,Палубаның төменгі жағына бір тамшы жұмбақ аң қою арқылы➡
Dialogue: 0,0:12:08.22,0:12:10.23,Default,,0,0,0,,Shield Plus 5000➡
Dialogue: 0,0:12:10.23,0:12:14.23,Default,,0,0,0,,Күзетке жіберілген 3 ревнологты пайдаланыңыз.
Dialogue: 0,0:12:15.70,0:12:17.70,Default,,0,0,0,,Ол келмей ме?
Dialogue: 0,0:12:17.70,0:12:19.83,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:12:19.83,0:12:22.20,Default,,0,0,0,,Триггер жылдамдығы жоғарылайтын үздіксіз шабуылдар.
Dialogue: 0,0:12:22.20,0:12:24.21,Default,,0,0,0,,Хмм... бұл жақсы.
Dialogue: 0,0:12:24.21,0:12:26.71,Default,,0,0,0,,Резаэльдің әлі де айласы бар!
Dialogue: 0,0:12:26.71,0:12:29.24,Default,,0,0,0,,Сіз жеңдім деп ойлауға әлі ерте.
Dialogue: 0,0:12:29.24,0:12:33.25,Default,,0,0,0,,Дұрыс... төбелес дегенді соңына дейін түсінбейтін нәрсе.
Dialogue: 0,0:12:33.25,0:12:36.68,Default,,0,0,0,,Бірақ мұнда да бір құпия қулық бар.
Dialogue: 0,0:12:36.68,0:12:39.19,Default,,0,0,0,,U…. Менің кезегім.
Dialogue: 0,0:12:39.19,0:12:41.22,Default,,0,0,0,,Persona Ride➡
Dialogue: 0,0:12:41.22,0:12:43.19,Default,,0,0,0,,Веизруг!
Dialogue: 0,0:12:43.19,0:12:45.23,Default,,0,0,0,,Ай қақпасын іске қосу.
Dialogue: 0,0:12:45.23,0:12:49.23,Default,,0,0,0,,Палубадан Розтонирге қоңырау шалыңыз және тапсырыс аймағына 2 картаны салыңыз.
Dialogue: 0,0:12:49.23,0:12:52.73,Default,,0,0,0,,Вазеругтың шеберлігімен Ай қақпасын қайтадан іске қосыңыз.
Dialogue: 0,0:12:52.73,0:12:56.20,Default,,0,0,0,,Revnologue-ге қоңырау шалыңыз және тапсырыс аймағына 2 картаны салыңыз.
Dialogue: 0,0:12:56.20,0:12:58.71,Default,,0,0,0,,Сондай-ақ Revnologue деп атаңыз.
Dialogue: 0,0:12:58.71,0:13:01.21,Default,,0,0,0,,Маған көрсетейін... а….
Dialogue: 0,0:13:01.21,0:13:03.71,Default,,0,0,0,,Күн сәулесін көрсететін жұлдыздар➡
Dialogue: 0,0:13:03.71,0:13:05.71,Default,,0,0,0,,Фантомдық аңға жетекшілік ету➡
Dialogue: 0,0:13:05.71,0:13:08.22,Default,,0,0,0,,Айдың жарықтығы!
Dialogue: 0,0:13:08.22,0:13:12.22,Default,,0,0,0,,Eilift Gurmani тапсырыс картасын пайдаланыңыз.
Dialogue: 0,0:13:12.22,0:13:16.72,Default,,0,0,0,,Бұл айналым кезінде барлық елес аңдардың күші +5000.
Dialogue: 0,0:13:16.72,0:13:20.19,Default,,0,0,0,,Егер ол қабілет ретінде көрінсе, сіз қосымша қуат пен 5000 аласыз.
Dialogue: 0,0:13:20.19,0:13:22.23,Default,,0,0,0,,Не...! Барамыз ба?
Dialogue: 0,0:13:22.23,0:13:25.73,Default,,0,0,0,,Розтонирмен бір уақытта Резаэль мен Гигантехке шабуыл жасаңыз.
Dialogue: 0,0:13:26.77,0:13:28.77,Default,,0,0,0,,｟Алдын алу мүмкін емес➡
Dialogue: 0,0:13:28.77,0:13:31.71,Default,,0,0,0,,Бұл жерде ғажайыптарға сенуден басқа амалымыз жоқ! ｠
Dialogue: 0,0:13:31.71,0:13:33.68,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:13:33.68,0:13:35.68,Default,,0,0,0,,Зақымдануды тексеру….
Dialogue: 0,0:13:36.71,0:13:38.71,Default,,0,0,0,,Жарайды….
Dialogue: 0,0:13:38.71,0:13:40.68,Default,,0,0,0,,Ғажайыптың екінші келуі!
Dialogue: 0,0:13:43.22,0:13:46.19,Default,,0,0,0,,Триггер 6-зақымда пайда болған кезде➡
Dialogue: 0,0:13:46.19,0:13:49.72,Default,,0,0,0,,Зақымдануды қалпына келтіру.
Dialogue: 0,0:13:49.72,0:13:53.23,Default,,0,0,0,,Ал триггерлік әсердің арқасында Резаэлдің күші 10 000-ға артады.
Dialogue: 0,0:13:54.20,0:13:56.23,Default,,0,0,0,,Тіпті қалпына келтіру дағдысы бар ма?
Dialogue: 0,0:13:56.23,0:13:59.70,Default,,0,0,0,,Бірақ менің шабуылдарым осыдан кейін де ауырады, солай ма?
Dialogue: 0,0:13:59.70,0:14:02.70,Default,,0,0,0,,Мен мұның алдын алу жолын көрсетемін!
Dialogue: 0,0:14:02.70,0:14:05.67,Default,,0,0,0,,Ғажайыптарға сенетін көздер...
Dialogue: 0,0:14:05.67,0:14:07.71,Default,,0,0,0,,Керемет...!
Dialogue: 0,0:14:07.71,0:14:10.75,Default,,0,0,0,,Вазеругпен авангардқа шабуыл жасаңыз.
Dialogue: 0,0:14:10.75,0:14:14.22,Default,,0,0,0,,Тапсырыс аймағынан Розтонир мен Ревнологқа қоңырау шалу дағдыларын пайдаланыңыз➡
Dialogue: 0,0:14:14.22,0:14:16.68,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 5000.
Dialogue: 0,0:14:16.68,0:14:18.69,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:14:22.69,0:14:24.73,Default,,0,0,0,,Жасөспірім.
Dialogue: 0,0:14:24.73,0:14:27.73,Default,,0,0,0,,Қалай ойлайсыңдар Авангардта қандай керемет?
Dialogue: 0,0:14:28.70,0:14:31.20,Default,,0,0,0,,Бұл уақыттың триггері ме...?
Dialogue: 0,0:14:31.20,0:14:33.23,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:14:33.23,0:14:36.70,Default,,0,0,0,,Резаэл триггерді палубаға қайтару арқылы пайда болу жылдамдығын арттырады➡
Dialogue: 0,0:14:36.70,0:14:39.74,Default,,0,0,0,,Оны шабуылда және қорғаныста қолданыңыз.
Dialogue: 0,0:14:39.74,0:14:43.21,Default,,0,0,0,,Бұл дағды ғажайып деп атауға лайық болуы мүмкін.
Dialogue: 0,0:14:43.21,0:14:46.21,Default,,0,0,0,,Бірақ... ғажайып шақыру - ➡
Dialogue: 0,0:14:46.21,0:14:48.25,Default,,0,0,0,,Егер сіз іске қосу жылдамдығын арттырғыңыз келсе➡
Dialogue: 0,0:14:48.25,0:14:50.18,Default,,0,0,0,,Триггерді қалпына келтіруден басқа жолдар бар.
Dialogue: 0,0:14:50.18,0:14:52.22,Default,,0,0,0,,E?
Dialogue: 0,0:14:52.22,0:14:55.19,Default,,0,0,0,,Мысалы... Палубадан ➡ триггер емес картаны салыңыз
Dialogue: 0,0:14:55.19,0:14:57.19,Default,,0,0,0,,Осылайша тартып алуды жалғастыру керек.
Dialogue: 0,0:14:57.19,0:14:59.23,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:14:59.23,0:15:01.26,Default,,0,0,0,,Ай қақпасын қосуды жалғастыру арқылы➡
Dialogue: 0,0:15:01.26,0:15:03.70,Default,,0,0,0,,Палубадағы жұмбақ нағыз аңдар дерлік жоғалып кетті.
Dialogue: 0,0:15:03.70,0:15:05.73,Default,,0,0,0,,Қазір➡
Dialogue: 0,0:15:05.73,0:15:09.20,Default,,0,0,0,,Менің палубамдағы қалған карталар үшін триггер жылдамдығы қандай?
Dialogue: 0,0:15:10.71,0:15:14.21,Default,,0,0,0,,Ғажайыптар жасауға болады.
Dialogue: 0,0:15:14.21,0:15:16.21,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:15:16.21,0:15:18.25,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:15:18.25,0:15:20.72,Default,,0,0,0,,Revnologue қуаты плюс 10 000 және сыни соққы плюс 1.
Dialogue: 0,0:15:20.72,0:15:22.68,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:15:22.68,0:15:24.69,Default,,0,0,0,,Триггерді салу.
Dialogue: 0,0:15:24.69,0:15:26.69,Default,,0,0,0,,Ревнологтың күші плюс 10 000.
Dialogue: 0,0:15:26.69,0:15:28.72,Default,,0,0,0,,Қос триггер….
Dialogue: 0,0:15:28.72,0:15:31.73,Default,,0,0,0,,Тағы екі шабуылға төтеп бере аласыз ба?
Dialogue: 0,0:15:31.73,0:15:33.69,Default,,0,0,0,,Ревнологпен шабуыл.
Dialogue: 0,0:15:35.20,0:15:37.23,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:15:37.23,0:15:40.23,Default,,0,0,0,,Тенкай Гаро Розтонирмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:15:47.71,0:15:49.68,Default,,0,0,0,,Күзетсіз….
Dialogue: 0,0:15:56.22,0:15:59.22,Default,,0,0,0,,Бұл менің елес нағыз аң, ең күштілердің бірі...
Dialogue: 0,0:16:02.69,0:16:05.19,Default,,0,0,0,,Алғашқы ата➡
Dialogue: 0,0:16:05.19,0:16:07.20,Default,,0,0,0,,Көктегі қасқыр.
Dialogue: 0,0:16:13.20,0:16:16.20,Default,,0,0,0,,Айдың сынағы Осымен сот процесі аяқталады.
Dialogue: 0,0:16:20.71,0:16:23.71,Default,,0,0,0,,Жеңімпаз Кагецу Якумо!
Dialogue: 0,0:16:23.71,0:16:31.32,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:31.32,0:16:34.32,Default,,0,0,0,,｟Бұл Якумо Кагецу жекпе-жегі... ｠
Dialogue: 0,0:16:37.69,0:16:39.73,Default,,0,0,0,,Аа...
Dialogue: 0,0:16:39.73,0:16:43.23,Default,,0,0,0,,Тек жекпе-жек қорқынышты дәрежеге дейін нашарлаған жоқ.
Dialogue: 0,0:16:47.74,0:16:50.77,Default,,0,0,0,,Кагецу мырза, шайқасыңыз үшін рахмет.
Dialogue: 0,0:16:50.77,0:16:52.71,Default,,0,0,0,,Мен әлі де білмейтін нәрселер бар.
Dialogue: 0,0:16:52.71,0:16:55.18,Default,,0,0,0,,Авангард өте терең!
Dialogue: 0,0:16:57.71,0:16:59.71,Default,,0,0,0,,Эй... мен сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:16:59.71,0:17:01.75,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:01.75,0:17:05.19,Default,,0,0,0,,Сіз неге Vanguard ойнайсыз?
Dialogue: 0,0:17:05.19,0:17:07.69,Default,,0,0,0,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:17:07.69,0:17:10.22,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:17:10.22,0:17:12.19,Default,,0,0,0,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:17:14.80,0:17:18.20,Default,,0,0,0,,｟Мен Тағдыр соғысында Хикаридің денесін сауықтыру үшін соғыстым➡
Dialogue: 0,0:17:18.20,0:17:20.20,Default,,0,0,0,,Vanguard ойнай бастады.
Dialogue: 0,0:17:20.20,0:17:22.74,Default,,0,0,0,,Тіпті тағдырлы шайқаста➡
Dialogue: 0,0:17:22.74,0:17:27.21,Default,,0,0,0,,Ол Хикари мен Нао-сенпайды қайтару үшін Авангардпен шайқасты.
Dialogue: 0,0:17:28.71,0:17:30.68,Default,,0,0,0,,Бірақ бәрі бітті.
Dialogue: 0,0:17:32.21,0:17:34.28,Default,,0,0,0,,Онда неге қазір➡
Dialogue: 0,0:17:34.28,0:17:36.25,Default,,0,0,0,,Авангард... ｠
Dialogue: 0,0:17:42.69,0:17:45.19,Default,,0,0,0,,Бұл керемет шайқас болды.
Dialogue: 0,0:17:45.19,0:17:47.19,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:17:49.20,0:17:51.20,Default,,0,0,0,,Мукае мырза!
Dialogue: 0,0:17:51.20,0:17:53.20,Default,,0,0,0,,Сәлем! Акина Мейдо.
Dialogue: 0,0:17:53.20,0:17:55.70,Default,,0,0,0,,Мен сізге бір нәрсе бергім келеді.
Dialogue: 0,0:17:55.70,0:17:57.71,Default,,0,0,0,,Мен үшін?
Dialogue: 0,0:17:57.71,0:18:01.21,Default,,0,0,0,,Тегін сыйлық! ➡
Dialogue: 0,0:18:01.21,0:18:04.68,Default,,0,0,0,,Сізге.
Dialogue: 0,0:18:06.71,0:18:08.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:08.75,0:18:11.69,Default,,0,0,0,,3-ші люкс Бұл шақыру.
Dialogue: 0,0:18:11.69,0:18:14.69,Default,,0,0,0,,Теледидарда Deluxe болды... иә?
Dialogue: 0,0:18:14.69,0:18:16.72,Default,,0,0,0,,Ах.
Dialogue: 0,0:18:16.72,0:18:20.23,Default,,0,0,0,,Ресми матчтарда үстемдік үшін таласатын майдан жауынгерлері.
Dialogue: 0,0:18:20.23,0:18:25.23,Default,,0,0,0,,Сондай-ақ көпшілікке шықпайтын жасырын қуатты қарсы ұшқыш.
Dialogue: 0,0:18:25.23,0:18:28.70,Default,,0,0,0,,Әдетте ешқашан кездеспейтін күшті адамдарды жинаңыз➡
Dialogue: 0,0:18:28.70,0:18:31.17,Default,,0,0,0,,Нағыз мықтыны анықтауға арналған турнир.
Dialogue: 0,0:18:31.17,0:18:33.21,Default,,0,0,0,,Бұл люкс.
Dialogue: 0,0:18:33.21,0:18:35.21,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:18:35.21,0:18:38.25,Default,,0,0,0,,Сіз оған лайықсыз.
Dialogue: 0,0:18:38.25,0:18:41.72,Default,,0,0,0,,Сол шайқасты сол кезде көрген адам➡
Dialogue: 0,0:18:41.72,0:18:44.69,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:18:44.69,0:18:47.19,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:47.19,0:18:49.19,Default,,0,0,0,,I...люкс.
Dialogue: 0,0:18:50.22,0:18:53.19,Default,,0,0,0,,Бұл жақсы мүмкіндік емес пе? жұмысшы?
Dialogue: 0,0:18:53.19,0:18:55.20,Default,,0,0,0,,Әртүрлі ойлар бар➡
Dialogue: 0,0:18:55.20,0:18:57.20,Default,,0,0,0,,Авангардты ойнайтын жігіттер жиналады.
Dialogue: 0,0:18:57.20,0:18:59.70,Default,,0,0,0,,Жауап алғыңыз келсе➡
Dialogue: 0,0:18:59.70,0:19:02.20,Default,,0,0,0,,Сіз одан бірдеңе алатыныңызға сенімдімін.
Dialogue: 0,0:19:02.20,0:19:04.74,Default,,0,0,0,,Бірақ... бұл жақсы ма?
Dialogue: 0,0:19:04.74,0:19:07.21,Default,,0,0,0,,Осындай кездейсоқ түрде қатысу...
Dialogue: 0,0:19:09.21,0:19:11.71,Default,,0,0,0,,Мен жауапкершілікті алуым керек.
Dialogue: 0,0:19:11.71,0:19:14.25,Default,,0,0,0,,Шешім! Мен де барамын.
Dialogue: 0,0:19:14.25,0:19:18.22,Default,,0,0,0,,Бүгінгі жеңіліс Көңілің қалса, кек ал.
Dialogue: 0,0:19:19.19,0:19:21.69,Default,,0,0,0,,Фу…. Сыртқа шыққыңыз келе ме?
Dialogue: 0,0:19:23.19,0:19:25.19,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:25.19,0:19:27.70,Default,,0,0,0,,Жарайды! Сосын мынаны ал.
Dialogue: 0,0:19:27.70,0:19:29.70,Default,,0,0,0,,Карточка...?
Dialogue: 0,0:19:39.21,0:19:41.18,Default,,0,0,0,,Сіз...
Dialogue: 0,0:19:44.18,0:19:46.75,Default,,0,0,0,,Бұл карта сәл ерекше➡
Dialogue: 0,0:19:46.75,0:19:49.68,Default,,0,0,0,,Елес аң иесінің жүрегін сынайды.
Dialogue: 0,0:19:49.68,0:19:52.19,Default,,0,0,0,,Жауабын тапсаңыз➡
Dialogue: 0,0:19:52.19,0:19:54.69,Default,,0,0,0,,Мен олардың жауап беретініне сенімдімін.
Dialogue: 0,0:19:54.69,0:19:56.69,Default,,0,0,0,,Неліктен мұндай әрекетке барар едіңіз?
Dialogue: 0,0:19:56.69,0:19:59.19,Default,,0,0,0,,Енді... неге?
Dialogue: 0,0:20:01.20,0:20:03.16,Default,,0,0,0,,Жақында кездескенше!
Dialogue: 0,0:20:10.77,0:20:13.27,Default,,0,0,0,,｟Мен оған➡
Dialogue: 0,0:20:13.27,0:20:15.24,Default,,0,0,0,,Неге олай істедің...? ｠
Dialogue: 0,0:20:16.34,0:20:18.81,Default,,0,0,0,,｟Неге сіз Vanguard ойнайсыз? ｠
Dialogue: 0,0:20:20.28,0:20:23.28,Default,,0,0,0,,｟Осындай өлтіретін сөздер...
Dialogue: 0,0:20:23.28,0:20:25.69,Default,,0,0,0,,Мен оған не істедім? ｠
Dialogue: 0,0:20:25.69,0:20:28.19,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:30.72,0:20:33.73,Default,,0,0,0,,Сіз мұны естідіңіз бе? Турнирге Каге-кун қатысады➡
Dialogue: 0,0:20:33.73,0:20:36.20,Default,,0,0,0,,Қандай жел соғады?
Dialogue: 0,0:20:36.20,0:20:38.20,Default,,0,0,0,,Негізі мен шығуды жоспарлаған жоқпын.
Dialogue: 0,0:20:38.20,0:20:40.20,Default,,0,0,0,,Бірақ ол шығады, солай ма?
Dialogue: 0,0:20:40.20,0:20:43.20,Default,,0,0,0,,Менің ішімнен шыққан тат сияқты...
Dialogue: 0,0:20:43.20,0:20:45.24,Default,,0,0,0,,Хмм….
Dialogue: 0,0:20:45.24,0:20:47.74,Default,,0,0,0,,Айтпақшы, мен де сонда боламын. Un?
Dialogue: 0,0:20:47.74,0:20:51.21,Default,,0,0,0,,Соққыға түссем де, мен саған жеңіл жүрмеймін, жарай ма?
Dialogue: 0,0:20:51.21,0:20:53.71,Default,,0,0,0,,Уау ~ 100 жыл. Бұл тез.
Dialogue: 0,0:20:53.71,0:20:56.22,Default,,0,0,0,,Дәлірек айтқанда, Нао-чан Deluxe ➡ ішінде пайда болады
Dialogue: 0,0:20:56.22,0:20:58.19,Default,,0,0,0,,Сіз Акина-кунға айттыңыз ба?
Dialogue: 0,0:20:58.19,0:21:00.19,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:21:00.19,0:21:03.19,Default,,0,0,0,,Ахх! Мен ұмыттым.
Dialogue: 0,0:21:03.19,0:21:05.19,Default,,0,0,0,,Айтқыңыз келген нәрсені мүмкіндігінше айтыңыз.
Dialogue: 0,0:21:05.19,0:21:07.70,Default,,0,0,0,,Ха...Біраздан соң хабарласамын.
Dialogue: 0,0:21:07.70,0:21:09.73,Default,,0,0,0,,Фу….
Dialogue: 0,0:21:09.73,0:21:12.73,Default,,0,0,0,,Әрине... өте қамқор балалар.
Dialogue: 0,0:21:18.21,0:21:20.21,Default,,0,0,0,,Сәлем, Хикари.
Dialogue: 0,0:21:20.21,0:21:22.24,Default,,0,0,0,,Не?
Dialogue: 0,0:21:22.24,0:21:25.71,Default,,0,0,0,,Хикари неге Авангардты ойнайды?
Dialogue: 0,0:21:25.71,0:21:28.72,Default,,0,0,0,,Бұл қызық болғандықтан солай.
Dialogue: 0,0:21:28.72,0:21:31.19,Default,,0,0,0,,Иә...дұрыс.
Dialogue: 0,0:21:32.25,0:21:34.19,Default,,0,0,0,,｟Мен мұны жасаймын, себебі бұл көңілді.
Dialogue: 0,0:21:34.19,0:21:37.26,Default,,0,0,0,,Бұл жақсы болуы керек...
Dialogue: 0,0:21:37.26,0:21:39.76,Default,,0,0,0,,Бұл не? Бұл сезім... ｠
Dialogue: 0,0:21:43.70,0:21:45.70,Default,,0,0,0,,Кеттік...!
Dialogue: 0,0:21:52.27,0:21:54.28,Default,,0,0,0,,｟Мен...
Dialogue: 0,0:21:55.78,0:21:57.78,Default,,0,0,0,,Мен Авангардпен бетпе-бет келгім келеді! ｠
Dialogue: 0,0:21:59.28,0:22:05.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory