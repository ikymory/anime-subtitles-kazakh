Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.30,0:00:07.30,Default,,0,0,0,,2-ші Deluxe жеңімпазы➡
Dialogue: 0,0:00:07.30,0:00:09.27,Default,,0,0,0,,Лейка Китсунешиба үшін үлкен қошемет!
Dialogue: 0,0:00:25.25,0:00:28.26,Default,,0,0,0,,Тирнаног күшті! ➡
Dialogue: 0,0:00:28.26,0:00:30.76,Default,,0,0,0,,Әсіресе осы маусымда жастардан➡
Dialogue: 0,0:00:30.76,0:00:34.26,Default,,0,0,0,,Кәсіби командаға қосылған жас эйс➡
Dialogue: 0,0:00:34.26,0:00:37.23,Default,,0,0,0,,Кицуне Шиба Лейканың серпіні тоқтаусыз!
Dialogue: 0,0:00:38.77,0:00:41.80,Default,,0,0,0,,Сондықтан мен 3-ші Deluxe➡ қатысуға шешім қабылдадым
Dialogue: 0,0:00:41.80,0:00:45.74,Default,,0,0,0,,Мен Лейка Китсунешибадан оның ынта-жігері туралы сұрағым келеді➡
Dialogue: 0,0:00:45.74,0:00:48.28,Default,,0,0,0,,Кәсіби деңгейге көтерілгеннен кейінгі сәтті прогресс➡
Dialogue: 0,0:00:48.28,0:00:52.25,Default,,0,0,0,,Кейбіреулер мұны Мичиру Кайманың екінші рет келуі деп атайды...
Dialogue: 0,0:00:52.25,0:00:55.32,Default,,0,0,0,,Бұл туралы айтудың қажеті жоқ. жұмысшы...?
Dialogue: 0,0:00:55.32,0:00:58.75,Default,,0,0,0,,Алдымдағы белдесуде бірінен соң бірі нәтижеге жетемін➡
Dialogue: 0,0:00:58.75,0:01:00.76,Default,,0,0,0,,Міне.
Dialogue: 0,0:01:00.76,0:01:02.76,Default,,0,0,0,,Тіпті осы люксте➡
Dialogue: 0,0:01:02.76,0:01:05.26,Default,,0,0,0,,Мен тапсырманы дауласушы ойымен қабылдаймын.
Dialogue: 0,0:02:50.23,0:02:54.20,Default,,0,0,0,,Жеңімпаз Кагецу Якумо!
Dialogue: 0,0:02:56.71,0:03:00.21,Default,,0,0,0,,Шайқас Сізге көп рахмет.
Dialogue: 0,0:03:00.21,0:03:02.21,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:03:07.22,0:03:09.69,Default,,0,0,0,,Кагецу мырза! Un?
Dialogue: 0,0:03:13.19,0:03:16.22,Default,,0,0,0,,Бар күшіммен соғып, жеңіліп қалдым➡
Dialogue: 0,0:03:16.22,0:03:18.69,Default,,0,0,0,,Күресу абырой болды.
Dialogue: 0,0:03:18.69,0:03:20.76,Default,,0,0,0,,Құрметті?
Dialogue: 0,0:03:20.76,0:03:24.73,Default,,0,0,0,,Мичирудың жеңісті сериясын аяқтаған матч➡
Dialogue: 0,0:03:24.73,0:03:29.24,Default,,0,0,0,,Мен оны ойын орнында көрдім және оны керемет күрескер деп ойладым.
Dialogue: 0,0:03:31.21,0:03:33.21,Default,,0,0,0,,Қандай керемет күрескер...
Dialogue: 0,0:03:33.21,0:03:35.21,Default,,0,0,0,,Бірақ. Un?
Dialogue: 0,0:03:35.21,0:03:38.25,Default,,0,0,0,,Дүние үлкен➡
Dialogue: 0,0:03:38.25,0:03:41.72,Default,,0,0,0,,Керемет құбыжық жасырынып жүр, себебі ол белгісіз.
Dialogue: 0,0:03:41.72,0:03:44.22,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:03:44.22,0:03:47.69,Default,,0,0,0,,Сондықтан Авангард өте қиын.
Dialogue: 0,0:03:49.22,0:03:51.23,Default,,0,0,0,,Аа...
Dialogue: 0,0:03:51.23,0:03:54.26,Default,,0,0,0,,Сіз қорқыныштысыз.
Dialogue: 0,0:03:54.26,0:03:56.73,Default,,0,0,0,,Әлі де күшейетін сияқты. а….
Dialogue: 0,0:04:04.84,0:04:06.84,Default,,0,0,0,,)
Dialogue: 0,0:04:09.88,0:04:13.85,Default,,0,0,0,,)
Dialogue: 0,0:04:23.23,0:04:25.23,Default,,0,0,0,,Сіз маған жауап беріңіз➡
Dialogue: 0,0:04:25.23,0:04:27.73,Default,,0,0,0,,Сіз мені күтіп отырсыз, солай ма?
Dialogue: 0,0:04:27.73,0:04:30.70,Default,,0,0,0,,Кешіріңіз, мен әлі іздеп жатырмын.
Dialogue: 0,0:04:31.70,0:04:33.67,Default,,0,0,0,,Жасөспірім. Un?
Dialogue: 0,0:04:34.70,0:04:36.71,Default,,0,0,0,,Кагецу-сан!
Dialogue: 0,0:04:36.71,0:04:38.71,Default,,0,0,0,,Осы жолы ішеміз бе?
Dialogue: 0,0:04:38.71,0:04:41.21,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:04:41.21,0:04:43.21,Default,,0,0,0,,Мен саған бірдеңе сыйлаймын деп айтпас бұрын.
Dialogue: 0,0:04:46.72,0:04:49.22,Default,,0,0,0,,Сонымен... таптыңыз ба? а….
Dialogue: 0,0:04:49.22,0:04:51.69,Default,,0,0,0,,Сіз неге Авангардты ойнайсыз?
Dialogue: 0,0:04:53.22,0:04:55.69,Default,,0,0,0,,Әлі жоқ. Мен түсінемін.
Dialogue: 0,0:04:57.73,0:05:00.20,Default,,0,0,0,,Сонымен...бұл жекпе-жек те➡
Dialogue: 0,0:05:00.20,0:05:02.23,Default,,0,0,0,,Мен сені бар күшіммен ұрамын!
Dialogue: 0,0:05:02.23,0:05:04.20,Default,,0,0,0,,Аа...
Dialogue: 0,0:05:04.20,0:05:06.20,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:05:12.71,0:05:16.21,Default,,0,0,0,,Алдын ала C тобының 3-ші матчы➡
Dialogue: 0,0:05:16.21,0:05:19.21,Default,,0,0,0,,Кицүнэ Шиба Лейка қарсы➡
Dialogue: 0,0:05:19.21,0:05:21.22,Default,,0,0,0,,Акина Мейдо!
Dialogue: 0,0:05:28.72,0:05:30.76,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:05:30.76,0:05:34.23,Default,,0,0,0,,Мен Акинаға шырын сатып алдым. Ха?
Dialogue: 0,0:05:35.23,0:05:37.70,Default,,0,0,0,,Түлкі Шиба-сан керемет!
Dialogue: 0,0:05:37.70,0:05:40.20,Default,,0,0,0,,Лайка-сан шайқасы~!
Dialogue: 0,0:05:40.20,0:05:43.21,Default,,0,0,0,,Ух...Мен жеңіле алмаймын!
Dialogue: 0,0:05:43.21,0:05:46.21,Default,,0,0,0,,Біз де жасаймыз! (Хикари/Юна) Сәлем!
Dialogue: 0,0:05:46.21,0:05:49.21,Default,,0,0,0,,Мен осындай нәрсе болуы мүмкін бе деп ойлаймын➡
Dialogue: 0,0:05:49.21,0:05:51.21,Default,,0,0,0,,Мен әкелдім!
Dialogue: 0,0:05:51.21,0:05:53.72,Default,,0,0,0,,О! Керемет!
Dialogue: 0,0:05:53.72,0:05:56.22,Default,,0,0,0,,Уау! ➡
Dialogue: 0,0:05:56.22,0:05:59.22,Default,,0,0,0,,Акина Вангармен жекпе-жек!
Dialogue: 0,0:05:59.22,0:06:01.76,Default,,0,0,0,,Уау! О...
Dialogue: 0,0:06:01.76,0:06:05.73,Default,,0,0,0,,Мектеп мерекесі үшін Кицүнэ Шиба-санға рахмет.
Dialogue: 0,0:06:05.73,0:06:09.23,Default,,0,0,0,,Кәсіпқой жекпе-жек керемет болды!
Dialogue: 0,0:06:09.23,0:06:11.73,Default,,0,0,0,,Кез келген уақытта, кез келген адаммен➡
Dialogue: 0,0:06:11.73,0:06:14.74,Default,,0,0,0,,Мен тек жекпе-жекке ең жақсы өнерімді көрсетуім керек.
Dialogue: 0,0:06:16.20,0:06:19.71,Default,,0,0,0,,Әрине, қазір де.
Dialogue: 0,0:06:19.71,0:06:22.71,Default,,0,0,0,,Қазір…Алдын ала C тобы
Dialogue: 0,0:06:22.71,0:06:24.71,Default,,0,0,0,,Үшінші сәйкестік➡
Dialogue: 0,0:06:24.71,0:06:26.72,Default,,0,0,0,,Фай!
Dialogue: 0,0:06:31.22,0:06:34.22,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:06:34.22,0:06:36.73,Default,,0,0,0,,Дақсыз көздер Жастар.
Dialogue: 0,0:06:36.73,0:06:39.23,Default,,0,0,0,,Амбиция қанаттары Соел!
Dialogue: 0,0:06:39.23,0:06:41.73,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:06:41.73,0:06:44.23,Default,,0,0,0,,Жастарға жылдам найза рыцарь мінуі➡
Dialogue: 0,0:06:44.23,0:06:47.20,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім➡
Dialogue: 0,0:06:47.20,0:06:51.24,Default,,0,0,0,,Ride Sables-ті Ventesta➡-ге шақырыңыз
Dialogue: 0,0:06:51.24,0:06:54.71,Default,,0,0,0,,Бентестамен шабуыл! Күзетші жоқ➡
Dialogue: 0,0:06:54.71,0:06:57.71,Default,,0,0,0,,Зақымдануды тексеріңіз... триггер жоқ.
Dialogue: 0,0:06:59.71,0:07:02.72,Default,,0,0,0,,Саблдармен шабуыл! күзетші.
Dialogue: 0,0:07:02.72,0:07:06.22,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім➡
Dialogue: 0,0:07:06.22,0:07:08.72,Default,,0,0,0,,Rikou no Rikou Ride to Youth➡
Dialogue: 0,0:07:08.72,0:07:12.23,Default,,0,0,0,,Шеберлігі бар палубаның жоғарғы 5 картасынан➡
Dialogue: 0,0:07:12.23,0:07:14.26,Default,,0,0,0,,Даудрикке қоңырау шалыңыз➡
Dialogue: 0,0:07:14.26,0:07:18.20,Default,,0,0,0,,Даудриктің шеберлігі Палубаның жоғарғы 5 картасынан➡
Dialogue: 0,0:07:18.20,0:07:21.70,Default,,0,0,0,,Қолыңызға Revolform Exist қосыңыз➡
Dialogue: 0,0:07:21.70,0:07:23.71,Default,,0,0,0,,Sfilt➡ қоңырау шалыңыз
Dialogue: 0,0:07:23.71,0:07:27.31,Default,,0,0,0,,Жастармен шабуыл. Күзетші жоқ.
Dialogue: 0,0:07:27.31,0:07:30.21,Default,,0,0,0,,Даудрикпен шабуыл. күзетші!
Dialogue: 0,0:07:30.21,0:07:32.71,Default,,0,0,0,,Бұрылыстың соңы. Мистер Фокс Шиба➡
Dialogue: 0,0:07:32.71,0:07:35.22,Default,,0,0,0,,Мен үшін де солай. Un?
Dialogue: 0,0:07:35.22,0:07:38.22,Default,,0,0,0,,Кез келген уақытта, кез келген адаммен➡
Dialogue: 0,0:07:38.22,0:07:41.22,Default,,0,0,0,,Жеңіске жету үшін бар күшімді саламын!
Dialogue: 0,0:07:41.22,0:07:44.73,Default,,0,0,0,,Менің кезегім: Азенсиорға мініңіз➡
Dialogue: 0,0:07:44.73,0:07:47.23,Default,,0,0,0,,Бентестаға шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:07:47.23,0:07:50.27,Default,,0,0,0,,Нилберис Кадваллаға➡ қоңырау шалыңыз
Dialogue: 0,0:07:50.27,0:07:52.70,Default,,0,0,0,,Азеншиормен шабуыл! Күзетші жоқ.
Dialogue: 0,0:07:52.70,0:07:54.74,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:07:54.74,0:07:58.24,Default,,0,0,0,,Триггер Кадвалланың қуатын сызыңыз, плюс 10000!
Dialogue: 0,0:08:00.21,0:08:03.71,Default,,0,0,0,,Нилбериспен шабуыл! күзетші.
Dialogue: 0,0:08:03.71,0:08:06.72,Default,,0,0,0,,Кадвалламен шабуыл! Күзетші жоқ.
Dialogue: 0,0:08:06.72,0:08:08.72,Default,,0,0,0,,Кадвалланың шеберлігімен➡
Dialogue: 0,0:08:08.72,0:08:10.72,Default,,0,0,0,,Нилберисті қолыңызға қосыңыз➡
Dialogue: 0,0:08:10.72,0:08:12.72,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:08:12.72,0:08:16.22,Default,,0,0,0,,Сен мені ұрамын дедің ғой... Ун?
Dialogue: 0,0:08:16.22,0:08:18.19,Default,,0,0,0,,Бір нәрсені сұрайық➡
Dialogue: 0,0:08:18.19,0:08:20.73,Default,,0,0,0,,Бүгінге дейін менімен күресіңіз➡
Dialogue: 0,0:08:20.73,0:08:23.23,Default,,0,0,0,,Сіз не істедіңіз? жұмысшы….
Dialogue: 0,0:08:23.23,0:08:26.20,Default,,0,0,0,,Мен сіздің жекпе-жектеріңізді талдаймын➡
Dialogue: 0,0:08:26.20,0:08:28.70,Default,,0,0,0,,Мен барынша дайындалдым➡
Dialogue: 0,0:08:28.70,0:08:31.21,Default,,0,0,0,,Сіз ше? бұл….
Dialogue: 0,0:08:33.21,0:08:35.21,Default,,0,0,0,,Ұрысқа қалай қарсы тұрсаңыз да➡
Dialogue: 0,0:08:35.21,0:08:37.71,Default,,0,0,0,,Менің мұны жоққа шығару ниетім жоқ, бірақ➡
Dialogue: 0,0:08:37.71,0:08:40.72,Default,,0,0,0,,Мен үшін жеңіс деген осы.
Dialogue: 0,0:08:42.25,0:08:46.22,Default,,0,0,0,,Жартылай бекініп алдымда тұрсаң➡
Dialogue: 0,0:08:46.22,0:08:48.72,Default,,0,0,0,,Мен сені аямай құртамын! а...!
Dialogue: 0,0:08:48.72,0:08:50.73,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:08:50.73,0:08:54.23,Default,,0,0,0,,Аспанды түсіретін қара рыцарь➡
Dialogue: 0,0:08:54.23,0:08:57.73,Default,,0,0,0,,Youthberg Skyfall Arms Rebuild➡
Dialogue: 0,0:08:57.73,0:08:59.70,Default,,0,0,0,,Жүр!
Dialogue: 0,0:09:08.71,0:09:11.21,Default,,0,0,0,,Даудрикті шеберлікпен тастаңыз➡
Dialogue: 0,0:09:11.21,0:09:14.22,Default,,0,0,0,,Қолға қосу және қоңырау шалу➡
Dialogue: 0,0:09:14.22,0:09:18.22,Default,,0,0,0,,Юсбергті қолыңызға қосу үшін сол дағдыны пайдаланыңыз➡
Dialogue: 0,0:09:18.22,0:09:21.22,Default,,0,0,0,,Осы бұрылыс кезінде Даудрикпен шабуыл➡
Dialogue: 0,0:09:21.22,0:09:24.23,Default,,0,0,0,,Қуат плюс 5000. күзет!
Dialogue: 0,0:09:24.23,0:09:27.73,Default,,0,0,0,,Жастбергпен шабуыл. Күзет жоқ!
Dialogue: 0,0:09:27.73,0:09:29.73,Default,,0,0,0,,Дискіні➡ тексеріңіз
Dialogue: 0,0:09:29.73,0:09:32.80,Default,,0,0,0,,1-диск триггер жоқ➡
Dialogue: 0,0:09:32.80,0:09:35.70,Default,,0,0,0,,2-жүргізуші➡
Dialogue: 0,0:09:35.70,0:09:38.71,Default,,0,0,0,,Алдыңғы триггер➡ алыңыз
Dialogue: 0,0:09:38.71,0:09:40.71,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 10 000.
Dialogue: 0,0:09:40.71,0:09:42.88,Default,,0,0,0,,Кух….
Dialogue: 0,0:09:42.88,0:09:45.85,Default,,0,0,0,,Бұл чемпионның рухы...
Dialogue: 0,0:09:47.72,0:09:50.72,Default,,0,0,0,,Бұл маңызды емес. а….
Dialogue: 0,0:09:50.72,0:09:52.72,Default,,0,0,0,,Кәсіпқойлар мен чемпиондар➡
Dialogue: 0,0:09:52.72,0:09:55.22,Default,,0,0,0,,Бұл тақырып дәл қазір➡
Dialogue: 0,0:09:55.22,0:09:58.26,Default,,0,0,0,,Оның ұрысқа қатысы жоқ➡
Dialogue: 0,0:09:58.26,0:10:01.73,Default,,0,0,0,,Ол кісі де биік мақсат қоя берді.
Dialogue: 0,0:10:01.73,0:10:03.73,Default,,0,0,0,,Сол адам...?
Dialogue: 0,0:10:03.73,0:10:07.74,Default,,0,0,0,,Мичиру Маварима Мен оған тәнтімін➡
Dialogue: 0,0:10:07.74,0:10:10.21,Default,,0,0,0,,Өзінен асып түсетін адам.
