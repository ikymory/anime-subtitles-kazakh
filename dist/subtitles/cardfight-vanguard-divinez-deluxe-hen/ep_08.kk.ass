Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.27,0:00:07.74,Default,,0,0,0,,Еңбегіңізге рахмет, Акина-кун.
Dialogue: 0,0:00:14.34,0:00:17.35,Default,,0,0,0,,((2-ші Deluxe жеңімпазы...
Dialogue: 0,0:00:19.31,0:00:21.75,Default,,0,0,0,,Келесі қарсылас…. ))
Dialogue: 0,0:00:21.75,0:00:24.75,Default,,0,0,0,,Түлкі Шиба...Лейка.
Dialogue: 0,0:00:24.75,0:00:26.76,Default,,0,0,0,,Бірінші кездесуде біреуді шақыру деген нені білдіреді?➡
Dialogue: 0,0:00:26.76,0:00:28.76,Default,,0,0,0,,...
Dialogue: 0,0:00:28.76,0:00:30.76,Default,,0,0,0,,Мен...Кешіріңіз!
Dialogue: 0,0:00:30.76,0:00:33.80,Default,,0,0,0,,Кола! Мен қорламаймын. Хмф.
Dialogue: 0,0:00:33.80,0:00:36.27,Default,,0,0,0,,Мег-чан мен Кицүнэ Шибамен жақсы дос болдым.
Dialogue: 0,0:00:36.27,0:00:38.30,Default,,0,0,0,,Құдық~➡
Dialogue: 0,0:00:38.30,0:00:41.27,Default,,0,0,0,,Мен Рокуоин-санды кіреберісте кездестірген сияқтымын.
Dialogue: 0,0:00:44.74,0:00:46.81,Default,,0,0,0,,Иә! Бұл да жақсы мүмкіндік➡
Dialogue: 0,0:00:46.81,0:00:50.28,Default,,0,0,0,,Барлығымыз кешкі ас ішсек ше? Жақсы идея!
Dialogue: 0,0:01:02.26,0:01:05.26,Default,,0,0,0,,Акина Мейдо. Ах... сәлем!
Dialogue: 0,0:01:05.26,0:01:08.23,Default,,0,0,0,,Ертеңгі жекпе-жек Рахмет.
Dialogue: 0,0:01:13.27,0:01:15.27,Default,,0,0,0,,Хаа….
Dialogue: 0,0:01:15.27,0:01:17.24,Default,,0,0,0,,...
Dialogue: 0,0:02:54.70,0:02:56.71,Default,,0,0,0,,Blackout-тың бәрі де осында ма?
Dialogue: 0,0:02:56.71,0:02:59.71,Default,,0,0,0,,Ум, олар мені қолдауға келді.
Dialogue: 0,0:02:59.71,0:03:01.74,Default,,0,0,0,,Өшіру➡
Dialogue: 0,0:03:01.74,0:03:03.75,Default,,0,0,0,,Мегуми топ жетекшісі, солай ма?
Dialogue: 0,0:03:03.75,0:03:06.72,Default,,0,0,0,,Дұрыс, барлығына таныстырамын➡
Dialogue: 0,0:03:06.72,0:03:09.18,Default,,0,0,0,,Менің мақтан тұтар достарым.
Dialogue: 0,0:03:10.22,0:03:12.22,Default,,0,0,0,,Itadaki~!
Dialogue: 0,0:03:12.22,0:03:15.22,Default,,0,0,0,,Жоқ! Бұл менің күріш шарым➡
Dialogue: 0,0:03:15.22,0:03:18.23,Default,,0,0,0,,Томари-сан! Бірінші келген бірінші қызмет көрсетіледі.
Dialogue: 0,0:03:18.23,0:03:20.23,Default,,0,0,0,,Ең дұрысын жеңіз➡
Dialogue: 0,0:03:20.23,0:03:23.20,Default,,0,0,0,,...
Dialogue: 0,0:03:23.20,0:03:25.23,Default,,0,0,0,,Міне!
Dialogue: 0,0:03:25.23,0:03:27.74,Default,,0,0,0,,Өте дәмді...! Бұл да жақсы!
Dialogue: 0,0:03:27.74,0:03:29.70,Default,,0,0,0,,Хаа….
Dialogue: 0,0:03:32.21,0:03:35.24,Default,,0,0,0,,Пуха~!
Dialogue: 0,0:03:35.24,0:03:38.21,Default,,0,0,0,,Турнирдің бірінші күніндегі жақсы жұмыс, Мег-чан.
Dialogue: 0,0:03:38.21,0:03:40.22,Default,,0,0,0,,Рахмет Томари➡
Dialogue: 0,0:03:40.22,0:03:42.22,Default,,0,0,0,,...
Dialogue: 0,0:03:42.22,0:03:44.22,Default,,0,0,0,,...
Dialogue: 0,0:03:44.22,0:03:47.72,Default,,0,0,0,,Йоцуги-кун, ол шынымен күшті еді.
Dialogue: 0,0:03:47.72,0:03:49.73,Default,,0,0,0,,...
Dialogue: 0,0:03:49.73,0:03:51.79,Default,,0,0,0,,Ах➡
Dialogue: 0,0:03:51.79,0:03:53.73,Default,,0,0,0,,Кешіріңіз, мен ешқандай зиян келтірмеймін.
Dialogue: 0,0:03:53.73,0:03:56.20,Default,,0,0,0,,Жарайды...! ➡
Dialogue: 0,0:03:56.20,0:03:58.20,Default,,0,0,0,,Келесі жолы мен жеңемін!
Dialogue: 0,0:03:59.20,0:04:02.20,Default,,0,0,0,,➡
Dialogue: 0,0:04:02.20,0:04:05.27,Default,,0,0,0,,Біз Blackout көшбасшымыз!
Dialogue: 0,0:04:05.27,0:04:08.24,Default,,0,0,0,,Блэкаут қандай команда?
Dialogue: 0,0:04:10.21,0:04:12.71,Default,,0,0,0,,Қараңғылық келе жатыр, бас тартпаңыз➡
Dialogue: 0,0:04:12.71,0:04:15.22,Default,,0,0,0,,Біреумен байланысу➡
Dialogue: 0,0:04:15.22,0:04:17.22,Default,,0,0,0,,Мен тұратын жерді қалаймын➡
Dialogue: 0,0:04:17.22,0:04:19.72,Default,,0,0,0,,Мен ұрыста дос болғым келеді➡
Dialogue: 0,0:04:19.72,0:04:21.72,Default,,0,0,0,,Мен солай сезіндім➡
Dialogue: 0,0:04:21.72,0:04:24.23,Default,,0,0,0,,Төбелесшілер жиналып жатыр.
Dialogue: 0,0:04:24.23,0:04:26.73,Default,,0,0,0,,Қараңғылық адамдарды жұтады➡
Dialogue: 0,0:04:26.73,0:04:28.70,Default,,0,0,0,,Бұл нәзік қараңғылық.
Dialogue: 0,0:04:28.70,0:04:30.70,Default,,0,0,0,,О, керемет!
Dialogue: 0,0:04:30.70,0:04:32.70,Default,,0,0,0,,Команданы Мегуми құрды ма?
Dialogue: 0,0:04:32.70,0:04:35.20,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:04:35.20,0:04:38.71,Default,,0,0,0,,Данжи мырза... солай емес пе?
Dialogue: 0,0:04:38.71,0:04:41.21,Default,,0,0,0,,Хехе... осындай жеңіл жүріс адам➡
Dialogue: 0,0:04:41.21,0:04:44.21,Default,,0,0,0,,Олардың команда құруы мүмкін емес.
Dialogue: 0,0:04:44.21,0:04:46.72,Default,,0,0,0,,Бұзушылық!
Dialogue: 0,0:04:46.72,0:04:48.75,Default,,0,0,0,,Біреу өсек айтып жатыр...
Dialogue: 0,0:04:48.75,0:04:51.72,Default,,0,0,0,,Амансың ба? жұмысшы?
Dialogue: 0,0:04:51.72,0:04:53.72,Default,,0,0,0,,А...жаман!
Dialogue: 0,0:04:53.72,0:04:56.76,Default,,0,0,0,,Менің достарым топ құрды➡
Dialogue: 0,0:04:56.76,0:05:00.73,Default,,0,0,0,,Өзінің жұмбақ сүйкімділігімен айналасындағыларды тартатын данышпан➡
Dialogue: 0,0:05:00.73,0:05:03.70,Default,,0,0,0,,Ол тайфунның көзіндей болды.
Dialogue: 0,0:05:03.70,0:05:05.70,Default,,0,0,0,,Ол керемет адам.
Dialogue: 0,0:05:05.70,0:05:08.20,Default,,0,0,0,,Тіпті мен және Мегуми де ешқашан кездескен емес➡
Dialogue: 0,0:05:08.20,0:05:11.21,Default,,0,0,0,,Бірінші жетекші. Мен қызықпын!
Dialogue: 0,0:05:11.21,0:05:14.71,Default,,0,0,0,,Мүмкін мен сені бір күні кездестірермін.
Dialogue: 0,0:05:14.71,0:05:16.71,Default,,0,0,0,,Е! Бұл рас па?
Dialogue: 0,0:05:16.71,0:05:18.71,Default,,0,0,0,,Иә, бірақ Урара-чан➡
Dialogue: 0,0:05:18.71,0:05:21.18,Default,,0,0,0,,Абыр-сабыр боп кетер ме екенмін.
Dialogue: 0,0:05:26.22,0:05:53.28,Default,,0,0,0,,(Метроном дыбысы)
Dialogue: 0,0:05:53.28,0:05:55.22,Default,,0,0,0,,((Сіз нені айтып тұрсыз?➡
Dialogue: 0,0:05:55.22,0:05:57.72,Default,,0,0,0,,Бұл қиын болып көрінгендіктен...
Dialogue: 0,0:05:57.72,0:05:59.72,Default,,0,0,0,,Көңілді сияқты.
Dialogue: 0,0:05:59.72,0:06:02.79,Default,,0,0,0,,...Бұл өте қызық!
Dialogue: 0,0:06:02.79,0:06:06.29,Default,,0,0,0,,Сіз де, солай ма? Рокуоин Сузуне! ))
Dialogue: 0,0:06:07.23,0:06:20.71,Default,,0,0,0,,(Метроном дыбысы)
Dialogue: 0,0:06:23.21,0:06:25.71,Default,,0,0,0,,Шешілді! ➡
Dialogue: 0,0:06:25.71,0:06:27.72,Default,,0,0,0,,Алдын ала А тобының 3-ші ойыны➡
Dialogue: 0,0:06:27.72,0:06:29.72,Default,,0,0,0,,Жеңімпаз ➡
Dialogue: 0,0:06:29.72,0:06:31.69,Default,,0,0,0,,Дәріге арналған сөмке Мираи~!
Dialogue: 0,0:06:34.29,0:06:36.26,Default,,0,0,0,,((Бұл 2 шығын...
Dialogue: 0,0:06:37.23,0:06:39.79,Default,,0,0,0,,Мен... менің болашағым ➡
Dialogue: 0,0:06:39.79,0:06:41.76,Default,,0,0,0,,Мен мұны істеуім керек...! ))
Dialogue: 0,0:06:50.71,0:06:53.71,Default,,0,0,0,,Ой➡
Dialogue: 0,0:06:53.71,0:06:56.24,Default,,0,0,0,,Мен Суоу➡
Dialogue: 0,0:06:56.24,0:06:58.71,Default,,0,0,0,,...
Dialogue: 0,0:07:01.22,0:07:03.72,Default,,0,0,0,,...
Dialogue: 0,0:07:03.72,0:07:05.72,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:07:05.72,0:07:07.72,Default,,0,0,0,,Сіздің сүйікті жеріңіз бар ма?
Dialogue: 0,0:07:07.72,0:07:09.72,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:07:09.72,0:07:12.23,Default,,0,0,0,,...
Dialogue: 0,0:07:12.23,0:07:14.23,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:07:14.23,0:07:16.20,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:20.20,0:07:22.20,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:28.74,0:07:30.71,Default,,0,0,0,,Рокуоин Сузуне.
Dialogue: 0,0:07:32.21,0:07:35.22,Default,,0,0,0,,...
Dialogue: 0,0:07:38.22,0:07:40.19,Default,,0,0,0,,...
Dialogue: 0,0:07:41.72,0:07:43.73,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:43.73,0:07:46.23,Default,,0,0,0,,Келесі матч В тобы! ➡
Dialogue: 0,0:07:46.23,0:07:49.20,Default,,0,0,0,,➡
Dialogue: 0,0:07:49.20,0:07:52.20,Default,,0,0,0,,Рокуоин Сузуне~!
Dialogue: 0,0:07:52.20,0:07:54.20,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:07:55.24,0:07:58.24,Default,,0,0,0,,...
Dialogue: 0,0:07:59.74,0:08:01.71,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:08:01.71,0:08:03.71,Default,,0,0,0,,～…
Dialogue: 0,0:08:06.72,0:08:08.72,Default,,0,0,0,,➡
Dialogue: 0,0:08:08.72,0:08:10.72,Default,,0,0,0,,➡
Dialogue: 0,0:08:10.72,0:08:12.72,Default,,0,0,0,,➡
Dialogue: 0,0:08:12.72,0:08:14.72,Default,,0,0,0,,Айтыңызшы➡
Dialogue: 0,0:08:14.72,0:08:16.73,Default,,0,0,0,,Ұрыста.
Dialogue: 0,0:08:16.73,0:08:19.73,Default,,0,0,0,,...
Dialogue: 0,0:08:19.73,0:08:22.23,Default,,0,0,0,,3-ші люкс! ➡
Dialogue: 0,0:08:22.23,0:08:25.20,Default,,0,0,0,,Алдын ала В тобының 3-ші ойыны...
Dialogue: 0,0:08:27.20,0:08:29.20,Default,,0,0,0,,Фай!
Dialogue: 0,0:08:32.71,0:08:35.74,Default,,0,0,0,,...
Dialogue: 0,0:08:35.74,0:08:38.71,Default,,0,0,0,,...
Dialogue: 0,0:08:38.71,0:08:40.72,Default,,0,0,0,,Ағаш мүйізді аң Роте.
Dialogue: 0,0:08:40.72,0:08:42.72,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:08:42.72,0:08:44.75,Default,,0,0,0,,Эстилаға бару.
Dialogue: 0,0:08:44.75,0:08:47.76,Default,,0,0,0,,➡
Dialogue: 0,0:08:47.76,0:08:50.73,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім ➡
Dialogue: 0,0:08:50.73,0:08:52.73,Default,,0,0,0,,Чалиске бару➡
Dialogue: 0,0:08:52.73,0:08:55.20,Default,,0,0,0,,１➡
Dialogue: 0,0:08:55.20,0:08:57.20,Default,,0,0,0,,Чалиспен шабуыл.
Dialogue: 0,0:08:57.20,0:08:59.20,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:59.20,0:09:01.74,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім ➡
Dialogue: 0,0:09:01.74,0:09:03.74,Default,,0,0,0,,Рейфельге бару➡
Dialogue: 0,0:09:03.74,0:09:07.21,Default,,0,0,0,,➡
Dialogue: 0,0:09:07.21,0:09:09.71,Default,,0,0,0,,➡
Dialogue: 0,0:09:09.71,0:09:11.71,Default,,0,0,0,,Люминоэль дағдылары➡
Dialogue: 0,0:09:11.71,0:09:14.22,Default,,0,0,0,,➡
Dialogue: 0,0:09:14.22,0:09:16.22,Default,,0,0,0,,Көлеңке армиясын шақырыңыз➡
Dialogue: 0,0:09:16.22,0:09:19.22,Default,,0,0,0,,...
Dialogue: 0,0:09:19.22,0:09:21.22,Default,,0,0,0,,Мен көремін➡
Dialogue: 0,0:09:21.22,0:09:23.22,Default,,0,0,0,,Мен шабуыл жасай алмаймын, бірақ...
Dialogue: 0,0:09:23.22,0:09:25.23,Default,,0,0,0,,Күшейтуге болады➡
Dialogue: 0,0:09:25.23,0:09:27.23,Default,,0,0,0,,Юикамен шабуыл.
Dialogue: 0,0:09:27.23,0:09:29.70,Default,,0,0,0,,Күзетші. Рейфельмен шабуыл.
Dialogue: 0,0:09:29.70,0:09:31.70,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:09:31.70,0:09:35.20,Default,,0,0,0,,Көлеңкелі армияның Luminoel көмегімен шабуылын күшейту.
Dialogue: 0,0:09:35.20,0:09:37.24,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:37.24,0:09:39.21,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:39.21,0:09:41.71,Default,,0,0,0,,Ол басынан бастап ұша бастайды➡
Dialogue: 0,0:09:41.71,0:09:43.71,Default,,0,0,0,,Сіз өте агрессивтісіз бе?
Dialogue: 0,0:09:45.21,0:09:48.72,Default,,0,0,0,,Бұл таңқаларлық шығар... менің кезегім! ➡
Dialogue: 0,0:09:48.72,0:09:50.72,Default,,0,0,0,,Торға міну➡
Dialogue: 0,0:09:50.72,0:09:52.72,Default,,0,0,0,,Фраппойға шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:09:52.72,0:09:55.72,Default,,0,0,0,,Сол дағдыны пайдаланып, Волжарды тамшыдан шақырыңыз➡
Dialogue: 0,0:09:55.72,0:09:57.73,Default,,0,0,0,,Фраппоймен шабуыл!
Dialogue: 0,0:09:57.73,0:10:00.23,Default,,0,0,0,,Күзетші. Тормен шабуыл жасаңыз!
Dialogue: 0,0:10:00.23,0:10:02.70,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:10:02.70,0:10:04.70,Default,,0,0,0,,Волжармен шабуыл!
Dialogue: 0,0:10:04.70,0:10:06.73,Default,,0,0,0,,Күзет.
Dialogue: 0,0:10:06.73,0:10:09.20,Default,,0,0,0,,Бұрылыстың соңы. менің кезегім.
Dialogue: 0,0:10:10.74,0:10:13.31,Default,,0,0,0,,Ою...өзгермейтін ырғақ➡
Dialogue: 0,0:10:13.31,0:10:15.78,Default,,0,0,0,,Rakuso жүйесін іске қосу….
Dialogue: 0,0:10:19.71,0:10:22.72,Default,,0,0,0,,Полифониялық Overdrive➡
Dialogue: 0,0:10:22.72,0:10:24.69,Default,,0,0,0,,Альтисарияға барыңыз!
Dialogue: 0,0:10:25.72,0:10:28.22,Default,,0,0,0,,Artisaria дағдысын белсендіру➡
Dialogue: 0,0:10:28.22,0:10:31.23,Default,,0,0,0,,Көлеңкедегі айқай ➡ тамшысын орнатыңыз
Dialogue: 0,0:10:31.23,0:10:33.73,Default,,0,0,0,,Осы дағдымен бір картаны салыңыз➡
Dialogue: 0,0:10:33.73,0:10:35.70,Default,,0,0,0,,Көлеңке армиясын шақырыңыз➡
Dialogue: 0,0:10:35.70,0:10:37.70,Default,,0,0,0,,Ruful-ға➡ қоңырау шалыңыз
Dialogue: 0,0:10:37.70,0:10:39.73,Default,,0,0,0,,Руфурмен шабуыл.
Dialogue: 0,0:10:39.73,0:10:43.24,Default,,0,0,0,,Күзетші. Юиканың шеберлігімен Руфуруды қолыңызға қайтарыңыз➡
Dialogue: 0,0:10:43.24,0:10:46.21,Default,,0,0,0,,Шеберлікпен тағы 1 карта сал.
Dialogue: 0,0:10:46.21,0:10:48.71,Default,,0,0,0,,Альтисариямен шабуыл.
Dialogue: 0,0:10:48.71,0:10:50.71,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:10:50.71,0:10:52.71,Default,,0,0,0,,Көлеңке әскерін шақырыңыз.
Dialogue: 0,0:10:52.71,0:10:55.72,Default,,0,0,0,,Күзетші жоқ. Бірінші тексеру➡
Dialogue: 0,0:10:55.72,0:10:57.72,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:10:57.72,0:10:59.75,Default,,0,0,0,,Емдеу триггері➡
Dialogue: 0,0:10:59.75,0:11:03.26,Default,,0,0,0,,Көлеңкелі армияның қуаты және 10 000 залалды қалпына келтіру.
Dialogue: 0,0:11:04.23,0:11:06.19,Default,,0,0,0,,Бұл жақсы келісім.
Dialogue: 0,0:11:07.23,0:11:09.23,Default,,0,0,0,,Көлеңкелі әскермен шабуыл.
Dialogue: 0,0:11:09.23,0:11:11.20,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:11:11.20,0:11:13.20,Default,,0,0,0,,Люминоэльмен шабуыл.
Dialogue: 0,0:11:13.20,0:11:15.24,Default,,0,0,0,,Мен саған рұқсат бермеймін➡
Dialogue: 0,0:11:15.24,0:11:17.71,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:11:17.71,0:11:20.24,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:11:20.24,0:11:23.21,Default,,0,0,0,,Сіз барлық әрекеттеріңізді алдын ала шешіп қойғандайсыз➡
Dialogue: 0,0:11:23.21,0:11:26.21,Default,,0,0,0,,Жақсы есептелген жекпе-жек.
Dialogue: 0,0:11:26.21,0:11:28.22,Default,,0,0,0,,Маған ұнайтыны осы.
Dialogue: 0,0:11:28.22,0:11:30.72,Default,,0,0,0,,Маған ұнамайды да, ұнатпайды да.
Dialogue: 0,0:11:30.72,0:11:33.72,Default,,0,0,0,,Жеңіске жету үшін не қажет болса, соны жасаңыз.
Dialogue: 0,0:11:33.72,0:11:35.72,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:11:35.72,0:11:37.69,Default,,0,0,0,,Маған ұнайтыны...
Dialogue: 0,0:11:39.23,0:11:41.70,Default,,0,0,0,,Жаза. а….
Dialogue: 0,0:11:43.20,0:11:45.20,Default,,0,0,0,,Келіңіздер➡
Dialogue: 0,0:11:45.20,0:11:47.20,Default,,0,0,0,,Мен дайындаламын!
Dialogue: 0,0:11:49.70,0:11:51.74,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:11:51.74,0:11:54.71,Default,,0,0,0,,Гүріл Ағаштар теңізін тербеткен көк шу!
Dialogue: 0,0:11:57.75,0:12:01.75,Default,,0,0,0,,Ағаш мүйізді аңға мініңіз Император Магнолия Патриархы!
Dialogue: 0,0:12:03.22,0:12:05.72,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:12:07.22,0:12:09.22,Default,,0,0,0,,Патриарх шеберлігі➡
Dialogue: 0,0:12:09.22,0:12:11.73,Default,,0,0,0,,Тамшыдан Банаспатиске қоңырау шалыңыз➡
Dialogue: 0,0:12:11.73,0:12:14.23,Default,,0,0,0,,Сонымен қатар, Гойлдортқа осы дағдымен қоңырау шалыңыз➡
Dialogue: 0,0:12:14.23,0:12:16.73,Default,,0,0,0,,Радикаға қоңырау шалыңыз➡
Dialogue: 0,0:12:16.73,0:12:19.23,Default,,0,0,0,,Магнолия патриархының шеберлігін белсендіру➡
Dialogue: 0,0:12:19.23,0:12:21.74,Default,,0,0,0,,Қарсыластың авангардының баға саны➡
Dialogue: 0,0:12:21.74,0:12:23.74,Default,,0,0,0,,Басқаша айтқанда, 3 артқы қорғаушы➡
Dialogue: 0,0:12:23.74,0:12:26.71,Default,,0,0,0,,Артқы қатардан шабуылдарға рұқсат береді➡
Dialogue: 0,0:12:26.71,0:12:29.74,Default,,0,0,0,,Сонымен қатар, барлық артқы қорғаныстар 5000➡ плюс қуатқа ие
Dialogue: 0,0:12:29.74,0:12:32.78,Default,,0,0,0,,Артқы қатардан ұстап алуға болады.
Dialogue: 0,0:12:32.78,0:12:35.22,Default,,0,0,0,,Мен саған аң патшасының үздіксіз шабуылдарын көрсетемін! ➡
Dialogue: 0,0:12:35.22,0:12:38.25,Default,,0,0,0,,Магнолия патриархымен шабуыл!
Dialogue: 0,0:12:38.25,0:12:40.22,Default,,0,0,0,,Luminoel көмегімен кесінді➡
Dialogue: 0,0:12:40.22,0:12:42.26,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:12:42.26,0:12:45.23,Default,,0,0,0,,2 көлеңкелі армия картасына дейін шегіну арқылы➡
Dialogue: 0,0:12:45.23,0:12:48.23,Default,,0,0,0,,Қалқан плюс әр бөлікке 10 000.
Dialogue: 0,0:12:48.23,0:12:51.23,Default,,0,0,0,,Бір көлеңкелі әскер шегінуге ➡
Dialogue: 0,0:12:51.23,0:12:53.70,Default,,0,0,0,,Демек, қалқан плюс 10 000.
Dialogue: 0,0:12:54.74,0:12:57.24,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:12:57.24,0:12:59.21,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:12:59.21,0:13:02.71,Default,,0,0,0,,Триггерді тартыңыз! Фраппоидың күші плюс 10 000.
Dialogue: 0,0:13:02.71,0:13:05.25,Default,,0,0,0,,Волжармен шабуыл!
Dialogue: 0,0:13:05.25,0:13:07.22,Default,,0,0,0,,Қуат +5000 шеберлікке байланысты➡
Dialogue: 0,0:13:07.22,0:13:09.25,Default,,0,0,0,,Қарсылас кедергі жасай алмайды.
Dialogue: 0,0:13:09.25,0:13:12.25,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:13:12.25,0:13:14.32,Default,,0,0,0,,Банаспатиспен шабуыл!
Dialogue: 0,0:13:14.32,0:13:17.23,Default,,0,0,0,,Күзетші. Гойледортпен шабуыл!
Dialogue: 0,0:13:17.23,0:13:19.26,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:13:19.26,0:13:22.23,Default,,0,0,0,,Ұрыс соңында Гойледорттан шегініңіз➡
Dialogue: 0,0:13:22.23,0:13:24.23,Default,,0,0,0,,1 картаны салыңыз➡
Dialogue: 0,0:13:24.23,0:13:26.23,Default,,0,0,0,,Мен әлі барамын! ➡
Dialogue: 0,0:13:26.23,0:13:28.24,Default,,0,0,0,,Флаппоимен шабуыл!
Dialogue: 0,0:13:28.24,0:13:30.74,Default,,0,0,0,,Күзетші. Radica➡ көмегімен шабуыл
Dialogue: 0,0:13:30.74,0:13:32.71,Default,,0,0,0,,Дағды +10000 қуат.
Dialogue: 0,0:13:32.71,0:13:35.28,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:13:35.28,0:13:37.81,Default,,0,0,0,,((Қорғау мәндерін дұрыс туралаңыз➡
Dialogue: 0,0:13:37.81,0:13:40.28,Default,,0,0,0,,Біз шығынды барынша азайттық... ))
Dialogue: 0,0:13:41.25,0:13:43.22,Default,,0,0,0,,Сіз тынышсыз.
Dialogue: 0,0:13:43.22,0:13:45.22,Default,,0,0,0,,Шабуылдар саны көп болғанымен➡
Dialogue: 0,0:13:45.22,0:13:48.26,Default,,0,0,0,,Қуаттың өзі жоғары емес➡
Dialogue: 0,0:13:48.26,0:13:51.26,Default,,0,0,0,,Онымен күресуге болады.
Dialogue: 0,0:13:51.26,0:13:54.23,Default,,0,0,0,,Бұрылыс соңында Волжардың шеберлігі іске қосылады➡
Dialogue: 0,0:13:54.23,0:13:57.73,Default,,0,0,0,,Өзіңді жанға салып, 1 картаны сал.
Dialogue: 0,0:13:58.73,0:14:01.74,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:14:01.74,0:14:03.71,Default,,0,0,0,,Persona Ride Altisaria.
Dialogue: 0,0:14:05.74,0:14:08.21,Default,,0,0,0,,Мегаломанияны шеберлікпен орнатыңыз➡
Dialogue: 0,0:14:08.21,0:14:10.85,Default,,0,0,0,,Мегаломандық дағдылар….
Dialogue: 0,0:14:10.85,0:14:13.35,Default,,0,0,0,,)
Dialogue: 0,0:14:14.25,0:14:16.22,Default,,0,0,0,,Фраппойды бекітіңіз.
Dialogue: 0,0:14:20.79,0:14:24.73,Default,,0,0,0,,Флаппойдың өз бөлімшелерінің қуатын арттыратын дағдысы бар.
Dialogue: 0,0:14:24.73,0:14:26.76,Default,,0,0,0,,Яғни, бұрынғыдай➡
Dialogue: 0,0:14:26.76,0:14:30.23,Default,,0,0,0,,Бұл қорғаныс пен шабуылды бір уақытта шектеп жатқаныңызды білдіре ме?
Dialogue: 0,0:14:30.23,0:14:33.23,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:14:33.23,0:14:35.74,Default,,0,0,0,,Әлі де дәмді.
Dialogue: 0,0:14:35.74,0:14:37.74,Default,,0,0,0,,Лакруа мен Вальчебланка➡ қоңырау шалыңыз
Dialogue: 0,0:14:37.74,0:14:40.71,Default,,0,0,0,,Дағды алдыңғы қатарға 5000 қуат қосады.
Dialogue: 0,0:14:41.74,0:14:44.21,Default,,0,0,0,,Ешқандай бос орынсыз күрес стилі.
Dialogue: 0,0:14:45.25,0:14:48.25,Default,,0,0,0,,Беделді Rokuoin атауы күн емес.
Dialogue: 0,0:14:49.22,0:14:51.75,Default,,0,0,0,,Үздіксіз жеңіс - Рокуоиннің абыройы.
Dialogue: 0,0:14:51.75,0:14:54.26,Default,,0,0,0,,Не істесеңіз де➡
Dialogue: 0,0:14:54.26,0:14:57.26,Default,,0,0,0,,Жеңіс ырғағын соғуды жалғастырамын.
Dialogue: 0,0:14:58.23,0:15:00.23,Default,,0,0,0,,Вальше Бланмен шабуыл.
Dialogue: 0,0:15:00.23,0:15:03.23,Default,,0,0,0,,Күзетші жоқ. Лакруамен шабуыл.
Dialogue: 0,0:15:03.23,0:15:05.23,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:15:05.23,0:15:08.24,Default,,0,0,0,,Альтисариядағы Авангардқа шабуыл жасау➡
Dialogue: 0,0:15:08.24,0:15:11.74,Default,,0,0,0,,2 Shadow Army картасын шеберлік бойынша шақырыңыз➡
Dialogue: 0,0:15:11.74,0:15:15.21,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 5000.
Dialogue: 0,0:15:15.21,0:15:17.21,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:15:17.21,0:15:19.21,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:15:19.21,0:15:21.22,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:15:21.22,0:15:23.22,Default,,0,0,0,,Критикалық триггер.
Dialogue: 0,0:15:23.22,0:15:25.25,Default,,0,0,0,,Көлеңкелі армияның қуаты плюс 10000➡
Dialogue: 0,0:15:25.25,0:15:27.76,Default,,0,0,0,,Critical Plus 1➡
Dialogue: 0,0:15:27.76,0:15:30.22,Default,,0,0,0,,Көлеңкелі әскермен шабуыл.
Dialogue: 0,0:15:30.22,0:15:32.73,Default,,0,0,0,,Мен саған рұқсат бермеймін...Күзетші!
Dialogue: 0,0:15:34.23,0:15:37.23,Default,,0,0,0,,Басқа көлеңкелі армиямен шабуыл.
Dialogue: 0,0:15:37.23,0:15:39.23,Default,,0,0,0,,Оны атамаңыз! ➡
Dialogue: 0,0:15:39.23,0:15:41.20,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:15:43.74,0:15:45.71,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:15:45.71,0:15:48.24,Default,,0,0,0,,Біз бұл шабуылдан сәтті қорғандық!
Dialogue: 0,0:15:48.24,0:15:50.21,Default,,0,0,0,,Мегуми-сан керемет!
Dialogue: 0,0:15:50.21,0:15:52.71,Default,,0,0,0,,Бірақ құны жоғары➡
Dialogue: 0,0:15:52.71,0:15:55.22,Default,,0,0,0,,Зақым 5➡
Dialogue: 0,0:15:55.22,0:15:57.22,Default,,0,0,0,,Қолда тек 1 карта қалды➡
Dialogue: 0,0:15:57.22,0:15:59.72,Default,,0,0,0,,Тақта қиратушы➡
Dialogue: 0,0:15:59.72,0:16:02.39,Default,,0,0,0,,Оның үстіне ол тіпті құлыптаулы.
Dialogue: 0,0:16:02.39,0:16:05.23,Default,,0,0,0,,)
Dialogue: 0,0:16:05.23,0:16:07.73,Default,,0,0,0,,Хэхе...! жұмысшы? ➡
Dialogue: 0,0:16:07.73,0:16:10.73,Default,,0,0,0,,Бұл жағдайда неге күлесің?
Dialogue: 0,0:16:10.73,0:16:13.73,Default,,0,0,0,,Авангард көңіл көтеруді қажет етпейді➡
Dialogue: 0,0:16:13.73,0:16:15.74,Default,,0,0,0,,Тек жеңіс пен жеңіліс бар.
Dialogue: 0,0:16:15.74,0:16:17.74,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:16:17.74,0:16:21.28,Default,,0,0,0,,Хехе... Әрине, жеңіс пен жеңіліс маңызды.
Dialogue: 0,0:16:21.28,0:16:24.71,Default,,0,0,0,,Бірақ жекпе-жек арқылы сіз қарсыласыңызбен тікелей бетпе-бет келе аласыз➡
Dialogue: 0,0:16:24.71,0:16:27.72,Default,,0,0,0,,Өйткені бұл Авангард.
Dialogue: 0,0:16:27.72,0:16:30.22,Default,,0,0,0,,Мен сізбен танысуға болады➡
Dialogue: 0,0:16:30.22,0:16:33.22,Default,,0,0,0,,Мен бақыттымын. а….
Dialogue: 0,0:16:33.22,0:16:37.23,Default,,0,0,0,,Жарайды...осылай жеңілемін деген ойым жоқ!
Dialogue: 0,0:16:37.23,0:16:39.73,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:16:39.73,0:16:42.23,Default,,0,0,0,,Persona Ride! Магнолия патриархы➡
Dialogue: 0,0:16:42.23,0:16:45.27,Default,,0,0,0,,Дөңгелектен Гюносураға қоңырау шалыңыз➡
Dialogue: 0,0:16:45.27,0:16:49.74,Default,,0,0,0,,Сонымен қатар, Гойледорттың шеберлігімен Магнолия қуаты +5000!
Dialogue: 0,0:16:49.74,0:16:52.71,Default,,0,0,0,,Генератор шеберлігі бар 1 картаны салыңыз➡
Dialogue: 0,0:16:52.71,0:16:54.71,Default,,0,0,0,,Серолға➡ қоңырау шалыңыз
Dialogue: 0,0:16:54.71,0:16:57.25,Default,,0,0,0,,Гинотра Джекалопаға➡ қоңырау шалыңыз
Dialogue: 0,0:16:57.25,0:17:01.22,Default,,0,0,0,,Магнолия шеберлігі артқы қатардағы 3 таңбаға шабуыл жасауға мүмкіндік береді.
Dialogue: 0,0:17:01.22,0:17:03.28,Default,,0,0,0,,Және Серолдың шеберлігімен➡
Dialogue: 0,0:17:03.28,0:17:07.76,Default,,0,0,0,,Persona Ride қуатын арттыру артқы қатарға да қолданылады.
Dialogue: 0,0:17:07.76,0:17:10.73,Default,,0,0,0,,Serol...2 Gynosra үшін.
Dialogue: 0,0:17:11.73,0:17:14.26,Default,,0,0,0,,Бір дене құлыптаулы болса да➡
Dialogue: 0,0:17:14.26,0:17:17.73,Default,,0,0,0,,Магнолия - бүкіл тақтаға үздіксіз шабуыл жасайтын палуба.
Dialogue: 0,0:17:17.73,0:17:20.74,Default,,0,0,0,,Минималды әсер.
Dialogue: 0,0:17:20.74,0:17:22.74,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:17:22.74,0:17:25.24,Default,,0,0,0,,қатарынан 5 шабуыл...Басымды тік ұстаймын!
Dialogue: 0,0:17:25.24,0:17:29.24,Default,,0,0,0,,Магнолия патриархымен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:29.24,0:17:32.21,Default,,0,0,0,,Persona мінген кезде Drive +1 болады.
Dialogue: 0,0:17:32.21,0:17:34.25,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:17:34.25,0:17:37.75,Default,,0,0,0,,Люминоэльдің шеберлігімен 2 көлеңкелі әскерді шегіндіріңіз ➡
Dialogue: 0,0:17:37.75,0:17:39.72,Default,,0,0,0,,Shield Plus 20 000.
Dialogue: 0,0:17:39.72,0:17:41.72,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:17:41.72,0:17:43.72,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:17:43.72,0:17:45.73,Default,,0,0,0,,Критикалық триггер.
Dialogue: 0,0:17:45.73,0:17:49.23,Default,,0,0,0,,Гюносураның қуаты плюс 10000 критикалық плюс 1➡
Dialogue: 0,0:17:49.23,0:17:51.73,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:17:51.73,0:17:55.24,Default,,0,0,0,,Триггерді тартыңыз! Серолдың күші плюс 10 000.
Dialogue: 0,0:17:55.24,0:17:57.74,Default,,0,0,0,,Қос триггер! Ілгері жүру! ➡
Dialogue: 0,0:17:57.74,0:17:59.71,Default,,0,0,0,,Мегуми-сан!
Dialogue: 0,0:18:00.71,0:18:03.24,Default,,0,0,0,,Бүктеу!
Dialogue: 0,0:18:03.24,0:18:05.21,Default,,0,0,0,,Бұл менікі➡
Dialogue: 0,0:18:05.21,0:18:07.18,Default,,0,0,0,,Мен барамын!
Dialogue: 0,0:18:10.82,0:18:13.32,Default,,0,0,0,,((Егер бұл жалғаса берсе...
Dialogue: 0,0:18:13.32,0:18:15.22,Default,,0,0,0,,Оның алдын алуға болмайды...! ))
Dialogue: 0,0:18:15.22,0:18:17.76,Default,,0,0,0,,Гюносурамен шабуыл!
Dialogue: 0,0:18:17.76,0:18:22.76,Default,,0,0,0,,Дағдыны белсендіру Өз күшіңізбен бір артқы қорғаушының қуатын арттырады➡
Dialogue: 0,0:18:22.76,0:18:25.73,Default,,0,0,0,,Гюносураның тағы бір қуаты плюс 35000!
Dialogue: 0,0:18:27.23,0:18:29.24,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:18:29.24,0:18:31.24,Default,,0,0,0,,Серолмен шабуыл!
Dialogue: 0,0:18:31.24,0:18:33.24,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:18:33.24,0:18:35.21,Default,,0,0,0,,Зақымдануды тексеру➡
Dialogue: 0,0:18:35.21,0:18:37.21,Default,,0,0,0,,Критикалық триггер.
Dialogue: 0,0:18:37.21,0:18:40.21,Default,,0,0,0,,Артисарияның күші плюс 10 000.
Dialogue: 0,0:18:40.21,0:18:44.22,Default,,0,0,0,,Егер солай болса, мен қазір өзімді тоқтата алмаймын!
Dialogue: 0,0:18:44.22,0:18:46.72,Default,,0,0,0,,Басқа Гюносурамен шабуыл!
Dialogue: 0,0:18:47.72,0:18:51.23,Default,,0,0,0,,Джекалопа күші +60 000 шеберлікпен!
Dialogue: 0,0:18:51.23,0:18:54.23,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:18:54.23,0:18:57.20,Default,,0,0,0,,Авангардқа джкалопамен шабуыл жасаңыз!
Dialogue: 0,0:18:58.23,0:19:01.24,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:01.24,0:19:03.20,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:19:11.71,0:19:13.71,Default,,0,0,0,,Жоқ... күзетші.
Dialogue: 0,0:19:16.22,0:19:20.22,Default,,0,0,0,,Жеңімпаз Мегуми Окура!
Dialogue: 0,0:19:20.22,0:19:25.73,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:25.73,0:19:27.73,Default,,0,0,0,,Бар күшіңізбен күресіңіз➡
Dialogue: 0,0:19:27.73,0:19:30.23,Default,,0,0,0,,Өз сезімдеріңізді бар күш-жігеріңізбен бөлісіңіз➡
Dialogue: 0,0:19:30.23,0:19:33.23,Default,,0,0,0,,Бұл мен істегім келетін карта күресі.
Dialogue: 0,0:19:34.24,0:19:36.24,Default,,0,0,0,,Бұл менің сүйікті жекпе-жегім.
Dialogue: 0,0:19:36.24,0:19:38.74,Default,,0,0,0,,Ха….
Dialogue: 0,0:19:38.74,0:19:41.71,Default,,0,0,0,,Сізге қандай жекпе-жек ұнайды?
Dialogue: 0,0:19:44.21,0:19:46.21,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:19:46.21,0:19:48.22,Default,,0,0,0,,Мен...ха!
Dialogue: 0,0:20:01.26,0:20:04.23,Default,,0,0,0,,Одан кейін маған не ұнайтынын айтқым келеді.
Dialogue: 0,0:20:18.21,0:20:21.22,Default,,0,0,0,,Менің сүйікті…жекпе-жек.
Dialogue: 0,0:20:22.22,0:20:25.22,Default,,0,0,0,,Авангардқа көңіл көтерудің қажеті жоқ.
Dialogue: 0,0:20:25.22,0:20:27.22,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:20:27.22,0:20:29.72,Default,,0,0,0,,Тек жеңіс пен жеңіліс бар➡
Dialogue: 0,0:20:29.72,0:20:32.73,Default,,0,0,0,,Жеңіске жете алмаған күрескердің құны жоқ.
Dialogue: 0,0:20:32.73,0:20:35.73,Default,,0,0,0,,Ана….
Dialogue: 0,0:20:35.73,0:20:39.23,Default,,0,0,0,,Иә...Айтуым керек еді➡
Dialogue: 0,0:20:39.23,0:20:41.20,Default,,0,0,0,,Сузуне.
Dialogue: 0,0:20:43.24,0:20:45.21,Default,,0,0,0,,Ух! ➡
Dialogue: 0,0:20:45.21,0:20:48.74,Default,,0,0,0,,E~Біз Blackout➡ көшбасшымыз
Dialogue: 0,0:20:48.74,0:20:52.25,Default,,0,0,0,,Мегуми Окураны алғашқы жеңісімен құттықтаймыз...
Dialogue: 0,0:20:56.25,0:21:01.72,Default,,0,0,0,,Банзай...!
Dialogue: 0,0:21:01.72,0:21:03.72,Default,,0,0,0,,Бұл өте қызықты.
Dialogue: 0,0:21:03.72,0:21:06.73,Default,,0,0,0,,Ах! (Есіктің ашылып, жабылуының дыбысы)
Dialogue: 0,0:21:06.73,0:21:09.23,Default,,0,0,0,,Акина. Un?
Dialogue: 0,0:21:09.23,0:21:11.73,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:21:11.73,0:21:13.77,Default,,0,0,0,,Не? Кенеттен.
Dialogue: 0,0:21:13.77,0:21:17.74,Default,,0,0,0,,Маған Сузунэ Рокуоинмен қалай дос болуға болатынын айтыңызшы.
Dialogue: 0,0:21:17.74,0:21:21.21,Default,,0,0,0,,Е...!
Dialogue: 0,0:21:21.21,0:21:23.21,Default,,0,0,0,,A...wa~➡
Dialogue: 0,0:21:23.21,0:21:27.72,Default,,0,0,0,,Ех!
Dialogue: 0,0:21:39.23,0:21:41.73,Default,,0,0,0,,Белгісіз кен...
Dialogue: 0,0:21:48.30,0:21:50.24,Default,,0,0,0,,((Басқа адам кім болса да➡
Dialogue: 0,0:21:50.24,0:21:52.74,Default,,0,0,0,,Біздің істегеніміз өзгеріссіз қалады➡
Dialogue: 0,0:21:52.74,0:21:56.28,Default,,0,0,0,,Бар жүрегіммен➡
Dialogue: 0,0:21:56.28,0:21:58.78,Default,,0,0,0,,Оны өшіріңіз! ))
Dialogue: 0,0:22:00.28,0:22:06.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory