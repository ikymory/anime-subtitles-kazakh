Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.20,0:00:07.74,Default,,0,0,0,,Мичиру. Хмм...?
Dialogue: 0,0:00:07.74,0:00:10.21,Default,,0,0,0,,Бастау уақыты келді. Жапонияда бәрі алаңдай ма?
Dialogue: 0,0:00:22.22,0:00:25.19,Default,,0,0,0,,Мен күшейген сайын... Келісемін.
Dialogue: 0,0:00:33.33,0:00:36.83,Default,,0,0,0,,｟Неге сіз Vanguard ойнайсыз? ｠
Dialogue: 0,0:00:37.77,0:00:39.74,Default,,0,0,0,,｟Осында➡
Dialogue: 0,0:00:39.74,0:00:41.74,Default,,0,0,0,,Бұл сұраққа жауап болуы мүмкін. ｠
Dialogue: 0,0:02:25.24,0:02:29.38,Default,,0,0,0,,Балалар, ең жақсы жекпе-жекті көргілерің келе ме?
Dialogue: 0,0:02:29.38,0:02:31.21,Default,,0,0,0,,Мен оны көргім келеді!
Dialogue: 0,0:02:31.21,0:02:33.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:33.75,0:02:36.72,Default,,0,0,0,,Ол майдангер ме, әлде қарсы жауынгер ме, бәрібір.
Dialogue: 0,0:02:36.72,0:02:40.19,Default,,0,0,0,,Нағыз ең күшті жауынгерді таңдау үшін Авангард фестивалі➡
Dialogue: 0,0:02:40.19,0:02:43.73,Default,,0,0,0,,Бұл... люкс!
Dialogue: 0,0:02:43.73,0:02:46.73,Default,,0,0,0,,Бұл жолы 3-ші рет жауынгерлерді мұқият таңдадық➡
Dialogue: 0,0:02:46.73,0:02:50.23,Default,,0,0,0,,Біз ең мықты екенімізді көрсету үшін жиналдық➡
Dialogue: 0,0:02:50.23,0:02:54.24,Default,,0,0,0,,Енді осы турнирдің басты кейіпкерлерімен таныстырып өтейік➡
Dialogue: 0,0:02:54.24,0:02:57.24,Default,,0,0,0,,1-ші Deluxe соңғы жетістігі➡
Dialogue: 0,0:02:57.24,0:03:00.71,Default,,0,0,0,,Чемпион екінші жарыста тамаша жеңіске жетті➡
Dialogue: 0,0:03:00.71,0:03:02.68,Default,,0,0,0,,Түлкі Шиба Лейка!
Dialogue: 0,0:03:04.68,0:03:08.18,Default,,0,0,0,,Таңның көсемі және Таңның киелі қызы➡
Dialogue: 0,0:03:08.18,0:03:10.69,Default,,0,0,0,,Дәріге арналған сөмке Мираи!
Dialogue: 0,0:03:12.72,0:03:16.69,Default,,0,0,0,,Кәсіби әлемде асығыс жүгіріп келе жатқан ашуланшақ➡
Dialogue: 0,0:03:16.69,0:03:18.69,Default,,0,0,0,,Динг Сенка!
Dialogue: 0,0:03:21.20,0:03:24.70,Default,,0,0,0,,Қараңғылық жыртқышы - Blackout➡ көшбасшысы
Dialogue: 0,0:03:24.70,0:03:26.67,Default,,0,0,0,,Мегуми Окура!
Dialogue: 0,0:03:29.20,0:03:32.21,Default,,0,0,0,,Теңдесі жоқ дәлдігі бар Vanguard машинасы➡
Dialogue: 0,0:03:32.21,0:03:34.68,Default,,0,0,0,,Рокуоин Сузуне!
Dialogue: 0,0:03:37.18,0:03:39.25,Default,,0,0,0,,Сеизо Тайзу мойындады➡
Dialogue: 0,0:03:39.25,0:03:42.18,Default,,0,0,0,,Seizo Anchor Bolt Supernova of Expectation➡
Dialogue: 0,0:03:42.18,0:03:44.69,Default,,0,0,0,,Эрика Миоджо!
Dialogue: 0,0:03:47.19,0:03:49.26,Default,,0,0,0,,Торю кубогын жеңіп алудан➡
Dialogue: 0,0:03:49.26,0:03:52.69,Default,,0,0,0,,Ноборигю кәсіби әлемге тез көтерілді➡
Dialogue: 0,0:03:52.69,0:03:54.66,Default,,0,0,0,,Инабе Нао!
Dialogue: 0,0:03:57.23,0:04:01.70,Default,,0,0,0,,Кемеңгер орта мектеп оқушысы Авангард➡-да да данышпан болды
Dialogue: 0,0:04:01.70,0:04:03.71,Default,,0,0,0,,Куон Айкава!
Dialogue: 0,0:04:06.24,0:04:09.18,Default,,0,0,0,,Кагада кенеттен Цуджикири жауынгері пайда болды➡
Dialogue: 0,0:04:09.18,0:04:11.68,Default,,0,0,0,,Үздіксіз Суоу!
Dialogue: 0,0:04:14.18,0:04:16.18,Default,,0,0,0,,Бірегей➡
Dialogue: 0,0:04:16.18,0:04:18.22,Default,,0,0,0,,Керемет AI➡
Dialogue: 0,0:04:18.22,0:04:20.19,Default,,0,0,0,,Жігіт!
Dialogue: 0,0:04:21.69,0:04:24.69,Default,,0,0,0,,Осы турнирдің ең үлкен қара тұлпары➡
Dialogue: 0,0:04:24.69,0:04:27.20,Default,,0,0,0,,Ғажайыптар тудыратын белгісіз өрескел тас➡
Dialogue: 0,0:04:27.20,0:04:29.20,Default,,0,0,0,,Акина Мейдо!
Dialogue: 0,0:04:31.70,0:04:33.70,Default,,0,0,0,,Және….
Dialogue: 0,0:04:33.70,0:04:35.70,Default,,0,0,0,,Белсенділік мерзімі тек 1 жыл➡
Dialogue: 0,0:04:35.70,0:04:38.24,Default,,0,0,0,,Өз мансабында жеңілмегеніне қарамастан➡
Dialogue: 0,0:04:38.24,0:04:42.18,Default,,0,0,0,,Кенет жоғалып кеткен фантомдық жауынгер➡
Dialogue: 0,0:04:42.18,0:04:45.68,Default,,0,0,0,,Кагецу Якумо!
Dialogue: 0,0:04:50.72,0:04:54.19,Default,,0,0,0,,Ал одан әрі қарай жалғастыруын сұрайық.
Dialogue: 0,0:04:54.19,0:04:56.19,Default,,0,0,0,,Қағаның айқайлаған келіні➡
Dialogue: 0,0:04:56.19,0:04:58.19,Default,,0,0,0,,Томари Сето!
Dialogue: 0,0:04:59.19,0:05:01.20,Default,,0,0,0,,Эй, га, is! ➡
Dialogue: 0,0:05:01.20,0:05:03.20,Default,,0,0,0,,Сіз мені күтуге мәжбүр еттіңіз!
Dialogue: 0,0:05:05.20,0:05:07.70,Default,,0,0,0,,Олай болса, ережелерді түсіндірейін! ➡
Dialogue: 0,0:05:07.70,0:05:09.74,Default,,0,0,0,,Алдын ала кезең 3 күн➡
Dialogue: 0,0:05:09.74,0:05:13.24,Default,,0,0,0,,Бұл әрқайсысы 4 адамнан 4 топқа бөлінген дөңгелек жүйе ойыны➡
Dialogue: 0,0:05:13.24,0:05:17.18,Default,,0,0,0,,Ал әр топтан үздік екі топ финалға өтеді➡
Dialogue: 0,0:05:17.18,0:05:19.21,Default,,0,0,0,,Егер бағалар бірдей болса➡
Dialogue: 0,0:05:19.21,0:05:21.22,Default,,0,0,0,,Бірнеше білікті жолдар болса➡
Dialogue: 0,0:05:21.22,0:05:23.22,Default,,0,0,0,,Білікті үміткерлер лотерея арқылы анықталады➡
Dialogue: 0,0:05:23.22,0:05:26.72,Default,,0,0,0,,Және! Алдын ала турдан өткен 8 адам➡
Dialogue: 0,0:05:26.72,0:05:29.19,Default,,0,0,0,,Кейінірек өтетін финалдық турнирде➡
Dialogue: 0,0:05:29.19,0:05:32.23,Default,,0,0,0,,Чемпиондық үшін жарысайық!
Dialogue: 0,0:05:32.23,0:05:36.20,Default,,0,0,0,,Енді сіз топтастыру туралы хабарландыруды күткен едіңіз!
Dialogue: 0,0:05:37.20,0:05:40.20,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:40.20,0:05:42.20,Default,,0,0,0,,А➡ тобындағы Эрика
Dialogue: 0,0:05:42.20,0:05:44.71,Default,,0,0,0,,Сіз өте қиын жерде тұрсыз.
Dialogue: 0,0:05:44.71,0:05:47.68,Default,,0,0,0,,Сіз уайымдап тұрсыз ба? Жоқ ➡
Dialogue: 0,0:05:47.68,0:05:49.68,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:05:50.68,0:05:54.18,Default,,0,0,0,,Бұл өте қызық топ➡
Dialogue: 0,0:05:54.18,0:05:56.22,Default,,0,0,0,,Бұл Мегумиге де қиын сияқты.
Dialogue: 0,0:05:56.22,0:05:59.22,Default,,0,0,0,,Үлкен апа болсаң, жақсы боларсың!
Dialogue: 0,0:05:59.22,0:06:01.19,Default,,0,0,0,,Хехе... Дұрыс.
Dialogue: 0,0:06:02.72,0:06:06.70,Default,,0,0,0,,Бітті... Е~! Бұл соншалықты жаман сезіне ме?
Dialogue: 0,0:06:06.70,0:06:08.70,Default,,0,0,0,,Лейка және Куон мырза➡
Dialogue: 0,0:06:08.70,0:06:11.70,Default,,0,0,0,,Ал Кагецу-сан тіпті сонда...
Dialogue: 0,0:06:11.70,0:06:13.70,Default,,0,0,0,,Қош бол, аға...
Dialogue: 0,0:06:13.70,0:06:16.20,Default,,0,0,0,,Ол әлі басталған жоқ!
Dialogue: 0,0:06:16.20,0:06:19.21,Default,,0,0,0,,…3 топ бар ма?
Dialogue: 0,0:06:19.21,0:06:21.71,Default,,0,0,0,,Барлығы 4 топ болуы керек еді➡
Dialogue: 0,0:06:21.71,0:06:24.18,Default,,0,0,0,,Қалған топ қайда?
Dialogue: 0,0:06:24.18,0:06:26.18,Default,,0,0,0,,Ухуху….
Dialogue: 0,0:06:26.18,0:06:28.22,Default,,0,0,0,,Дұрыс жауап теңіздің арғы жағында!
Dialogue: 0,0:06:28.22,0:06:30.72,Default,,0,0,0,,Негізі іріктеу турлары шетелде де өткізіледі➡
Dialogue: 0,0:06:30.72,0:06:34.19,Default,,0,0,0,,Біз финалда кездесуіміз керек!
Dialogue: 0,0:06:34.19,0:06:39.23,Default,,0,0,0,,Ал...бірден бастайық➡
Dialogue: 0,0:06:39.23,0:06:44.20,Default,,0,0,0,,Осымен біз 3-ші Deluxe оқиғасын жариялаймыз!
Dialogue: 0,0:06:44.20,0:06:48.70,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:48.70,0:06:51.71,Default,,0,0,0,,Ха~ Мен қобалжыдым...
Dialogue: 0,0:06:51.71,0:06:54.24,Default,,0,0,0,,～
Dialogue: 0,0:06:54.24,0:06:56.68,Default,,0,0,0,,...
Dialogue: 0,0:06:56.68,0:06:58.68,Default,,0,0,0,,Бұл анық➡
Dialogue: 0,0:06:58.68,0:07:00.68,Default,,0,0,0,,Мен кәсіпқоймын!
Dialogue: 0,0:07:00.68,0:07:02.72,Default,,0,0,0,,Бұл ақымақ емес пе!
Dialogue: 0,0:07:02.72,0:07:05.75,Default,,0,0,0,,～
Dialogue: 0,0:07:05.75,0:07:08.26,Default,,0,0,0,,Екеуің де қобалжыдыңдар ма?
Dialogue: 0,0:07:08.26,0:07:12.69,Default,,0,0,0,,Куон жақсы сияқты. Адамдардың алдында тұруға үйренгенмін.
Dialogue: 0,0:07:12.69,0:07:15.20,Default,,0,0,0,,～…
Dialogue: 0,0:07:15.20,0:07:17.20,Default,,0,0,0,,Мен тез төбелескім келеді!
Dialogue: 0,0:07:17.20,0:07:19.17,Default,,0,0,0,,Суоға ұқсайды...
Dialogue: 0,0:07:20.20,0:07:22.24,Default,,0,0,0,,Эй... Мен сені күттім!
Dialogue: 0,0:07:22.24,0:07:26.71,Default,,0,0,0,,Бұл жігіттер 3-ші люкске бірінші болып қатысады!
Dialogue: 0,0:07:26.71,0:07:29.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:29.71,0:07:33.18,Default,,0,0,0,,Хехе... Кенет бастықтардың соңғы кездесуі.
Dialogue: 0,0:07:33.18,0:07:35.28,Default,,0,0,0,,Қандай керемет көңіл-күй.
Dialogue: 0,0:07:35.28,0:07:37.22,Default,,0,0,0,,Дұрыс➡
Dialogue: 0,0:07:37.22,0:07:40.19,Default,,0,0,0,,Мираи Оякубукуро - Токай аймағындағы ең үлкен команда➡
Dialogue: 0,0:07:40.19,0:07:42.76,Default,,0,0,0,,Таңның көсемі.
Dialogue: 0,0:07:42.76,0:07:45.73,Default,,0,0,0,,Біз сондай-ақ Авангард➡ үндеуін жеткізу бойынша іс-шараларды жүзеге асырамыз
Dialogue: 0,0:07:45.73,0:07:48.70,Default,,0,0,0,,Өйткені ол барлық ұрпақтың тамсанатын жауынгер.
Dialogue: 0,0:07:49.70,0:07:51.70,Default,,0,0,0,,Осындай қызбен бетпе-бет келу➡
Dialogue: 0,0:07:51.70,0:07:54.20,Default,,0,0,0,,Бұл өте қауіпті AI жігіті.
Dialogue: 0,0:07:54.20,0:07:56.17,Default,,0,0,0,,Егер...
Dialogue: 0,0:07:57.71,0:07:59.74,Default,,0,0,0,,Турнир ережесіне сәйкес➡
Dialogue: 0,0:07:59.74,0:08:02.71,Default,,0,0,0,,Миллейге қолдау көрсету қызметкерлері қатысады.
Dialogue: 0,0:08:04.71,0:08:07.68,Default,,0,0,0,,Енді сенің кезегің... Жігіт!
Dialogue: 0,0:08:09.18,0:08:11.19,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:08:12.69,0:08:15.22,Default,,0,0,0,,Голографияны пайдаланып жобалауға мүмкіндік бердім.
Dialogue: 0,0:08:15.22,0:08:17.29,Default,,0,0,0,,Карточкалар голографиямен де шығарылады➡
Dialogue: 0,0:08:17.29,0:08:19.26,Default,,0,0,0,,Тіпті төбелесуге де болады.
Dialogue: 0,0:08:20.20,0:08:22.20,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:08:22.20,0:08:25.73,Default,,0,0,0,,Мираи...Мен сенімен төбелесуді асыға күтемін.
Dialogue: 0,0:08:25.73,0:08:29.20,Default,,0,0,0,,Мен туралы бәрін білмейсің бе?
Dialogue: 0,0:08:29.20,0:08:31.21,Default,,0,0,0,,Егер ол өткен деректер болса➡
Dialogue: 0,0:08:31.21,0:08:34.68,Default,,0,0,0,,Бірақ... Бүгін кіммен төбелесетініңді білмеймін.
Dialogue: 0,0:08:34.68,0:08:37.21,Default,,0,0,0,,Хехе... Бұл рас.
Dialogue: 0,0:08:37.21,0:08:40.72,Default,,0,0,0,,Эй...екеңнің көңіл-күйлерің керемет!
Dialogue: 0,0:08:40.72,0:08:42.72,Default,,0,0,0,,Олай болса, 3-ші Deluxe➡
Dialogue: 0,0:08:42.72,0:08:46.22,Default,,0,0,0,,Алдын ала А тобының 1-ші матчы...Жекпе-жек!
Dialogue: 0,0:08:51.19,0:08:53.70,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:08:53.70,0:08:55.70,Default,,0,0,0,,Зефирозидтер.
Dialogue: 0,0:08:55.70,0:08:57.70,Default,,0,0,0,,Тығыздағыш Айдаһар Ахинса Суул.
Dialogue: 0,0:08:57.70,0:08:59.70,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:08:59.70,0:09:01.70,Default,,0,0,0,,Атпен жүруге болмайды.
Dialogue: 0,0:09:01.70,0:09:03.71,Default,,0,0,0,,Атқа мінбеу... нені білдіреді?
Dialogue: 0,0:09:03.71,0:09:05.71,Default,,0,0,0,,Ал, қараңдаршы.
Dialogue: 0,0:09:05.71,0:09:08.18,Default,,0,0,0,,Бұл палуба керемет.
Dialogue: 0,0:09:08.18,0:09:11.21,Default,,0,0,0,,Оның орнына Зефирозид дағдысын белсендіріңіз➡
Dialogue: 0,0:09:11.21,0:09:15.18,Default,,0,0,0,,Ride Deck Gospel Card Жаныңызға жаңа бастама қойыңыз➡
Dialogue: 0,0:09:15.18,0:09:17.69,Default,,0,0,0,,Энергия генераторын орнатыңыз➡
Dialogue: 0,0:09:17.69,0:09:19.69,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:19.69,0:09:21.69,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:09:24.69,0:09:26.69,Default,,0,0,0,,Трикумунды қолыңыздан тастаңыз➡
Dialogue: 0,0:09:26.69,0:09:29.70,Default,,0,0,0,,Мөрленген айдаһар Намокар Ануиге міну➡
