Dialogue: 0,0:10:44.21,0:10:47.21,Default,,0,0,0,,Тұқым өсіп, Ізгі хабар тамыр алады➡
Dialogue: 0,0:10:47.21,0:10:49.68,Default,,0,0,0,,Ұрық жұлдыздардың тынысымен өседі➡
Dialogue: 0,0:10:49.68,0:10:53.18,Default,,0,0,0,,Кел, жердің баласы!
Dialogue: 0,0:10:56.75,0:11:00.22,Default,,0,0,0,,Зефирогираның туған күні айдаһар ағашына мініңіз!
Dialogue: 0,0:11:02.19,0:11:05.19,Default,,0,0,0,,Грифогилла қайта туды.
Dialogue: 0,0:11:05.19,0:11:08.20,Default,,0,0,0,,Қайта туылған...? Иә➡
Dialogue: 0,0:11:08.20,0:11:11.23,Default,,0,0,0,,Таптап, қирататын пәледен➡
Dialogue: 0,0:11:11.23,0:11:15.20,Default,,0,0,0,,Бірге өмір сүретін және айналымын басқаратын Ізгі хабарға.
Dialogue: 0,0:11:15.20,0:11:18.67,Default,,0,0,0,,Сол құдірет...Мен саған көрсетемін!
Dialogue: 0,0:11:19.71,0:11:21.68,Default,,0,0,0,,Рагн Гимрадқа➡ қоңырау шалыңыз
Dialogue: 0,0:11:21.68,0:11:23.68,Default,,0,0,0,,Рюки маркерін палубадан қойыңыз➡
Dialogue: 0,0:11:23.68,0:11:25.68,Default,,0,0,0,,Гидраглум маскасы➡
Dialogue: 0,0:11:25.68,0:11:27.72,Default,,0,0,0,,Қолға қосу және пайдалану.
Dialogue: 0,0:11:27.72,0:11:29.68,Default,,0,0,0,,Қолыңызға Зефирогира қосыңыз.
Dialogue: 0,0:11:29.68,0:11:31.72,Default,,0,0,0,,Зефирогира шеберлігін белсендіру➡
Dialogue: 0,0:11:31.72,0:11:34.22,Default,,0,0,0,,3 дана энергетикалық жарылыс➡
Dialogue: 0,0:11:34.22,0:11:36.19,Default,,0,0,0,,Рюки маркерін➡ қойыңыз
Dialogue: 0,0:11:36.19,0:11:38.19,Default,,0,0,0,,Палубаның жоғарғы 5 картасынан➡
Dialogue: 0,0:11:38.19,0:11:40.70,Default,,0,0,0,,Верлина Эспералидеаға қоңырау шалыңыз.
Dialogue: 0,0:11:40.70,0:11:42.70,Default,,0,0,0,,Espera Ruidea….
Dialogue: 0,0:11:42.70,0:11:45.20,Default,,0,0,0,,Бұл жақсы карта.
Dialogue: 0,0:11:45.20,0:11:47.20,Default,,0,0,0,,Хмм... жақсы карта!
Dialogue: 0,0:11:47.20,0:11:49.20,Default,,0,0,0,,Батикалды шақыру.
Dialogue: 0,0:11:49.20,0:11:51.74,Default,,0,0,0,,Зефирогира➡ қосымша дағдылары
Dialogue: 0,0:11:51.74,0:11:54.71,Default,,0,0,0,,Рюки маркерлері қанша болса, сонша артқы қорғау шеңбері➡
Dialogue: 0,0:11:54.71,0:11:58.18,Default,,0,0,0,,Энергия заряды және Zephyrogira қуаты плюс 5000➡
Dialogue: 0,0:11:58.18,0:12:00.18,Default,,0,0,0,,Ал Рюки маркеріндегі карта ➡
Dialogue: 0,0:12:00.18,0:12:02.68,Default,,0,0,0,,Қуаты +5000.
Dialogue: 0,0:12:02.68,0:12:04.69,Default,,0,0,0,,Espera идеясымен шабуыл!
Dialogue: 0,0:12:04.69,0:12:06.69,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:12:06.69,0:12:08.69,Default,,0,0,0,,Зефирогирамен шабуыл!
Dialogue: 0,0:12:08.69,0:12:11.19,Default,,0,0,0,,Эспералидеаны шеберлікпен тұрыңыз.
Dialogue: 0,0:12:11.19,0:12:13.19,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:12:13.19,0:12:15.20,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:12:15.20,0:12:17.20,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:12:17.20,0:12:19.20,Default,,0,0,0,,Критикалық триггер➡
Dialogue: 0,0:12:19.20,0:12:21.20,Default,,0,0,0,,Espera Idea Пауэр Plus 10000➡
Dialogue: 0,0:12:21.20,0:12:23.67,Default,,0,0,0,,Зефирогира сыни плюс 1.
Dialogue: 0,0:12:25.71,0:12:27.71,Default,,0,0,0,,Гимрадпен шабуыл!
Dialogue: 0,0:12:27.71,0:12:29.68,Default,,0,0,0,,Күзетшілерді ұстау.
Dialogue: 0,0:12:29.68,0:12:32.68,Default,,0,0,0,,Espera идеясымен шабуыл! күзетші.
Dialogue: 0,0:12:32.68,0:12:34.72,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:12:34.72,0:12:38.72,Default,,0,0,0,,Сіз қалай ойлайсыз? Менің жаңа авангард Зефирогира.
Dialogue: 0,0:12:38.72,0:12:40.69,Default,,0,0,0,,Бұл керемет және➡
Dialogue: 0,0:12:40.69,0:12:43.19,Default,,0,0,0,,Бұл қайта туылған карталар ғана емес➡
Dialogue: 0,0:12:43.19,0:12:45.69,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:12:45.69,0:12:49.23,Default,,0,0,0,,Ммм...Мен міндетті түрде өзгердім➡
Dialogue: 0,0:12:49.23,0:12:53.20,Default,,0,0,0,,Сол күнгі жекпе-жектен кейін қызық жеңу мен жеңілуден асып түседі➡
Dialogue: 0,0:12:53.20,0:12:56.24,Default,,0,0,0,,Оңтайлы шешімнің болмауының қызығы➡
Dialogue: 0,0:12:56.24,0:12:59.71,Default,,0,0,0,,Өзіңнен басқа киім киіп алға жылжу қуанышы➡
Dialogue: 0,0:12:59.71,0:13:02.21,Default,,0,0,0,,Мен көп нәрсені үйрендім➡
Dialogue: 0,0:13:02.21,0:13:05.68,Default,,0,0,0,,Сол жекпе-жектен бері менде осындай қызықты сезім болды➡
Dialogue: 0,0:13:05.68,0:13:07.72,Default,,0,0,0,,Мен оның қайдан шыққанын білгім келді➡
Dialogue: 0,0:13:07.72,0:13:11.19,Default,,0,0,0,,Мен көбірек білгім келді... терең➡
Dialogue: 0,0:13:11.19,0:13:14.69,Default,,0,0,0,,Сондықтан мен Vanguard ойнауды жалғастырамын!
Dialogue: 0,0:13:14.69,0:13:18.19,Default,,0,0,0,,Мен бұл сезімді түсінемін➡
Dialogue: 0,0:13:18.19,0:13:22.23,Default,,0,0,0,,Сізді өзгертетін ұрыстар бар.
Dialogue: 0,0:13:22.23,0:13:25.73,Default,,0,0,0,,Шындап күрессең, таң ата➡
Dialogue: 0,0:13:25.73,0:13:30.24,Default,,0,0,0,,Мен Vanguard ойнаймын, өйткені мен сол сәтті бастан өткергім келеді!
Dialogue: 0,0:13:31.34,0:13:34.34,Default,,0,0,0,,｟Ләззатқа толы сезімдер Сіз өзгерген сәт... ｠
Dialogue: 0,0:13:35.21,0:13:39.18,Default,,0,0,0,,Жүр, Мирай, маған қазір өзіңді көбірек көрсет!
Dialogue: 0,0:13:39.18,0:13:41.22,Default,,0,0,0,,Жарайды, бірақ➡
Dialogue: 0,0:13:41.22,0:13:44.19,Default,,0,0,0,,Тек көңіл көтеру жеткіліксіз болуы мүмкін.
Dialogue: 0,0:13:46.19,0:13:48.16,Default,,0,0,0,,кеттік Жігіт➡
Dialogue: 0,0:13:48.16,0:13:51.66,Default,,0,0,0,,Мен сізге қазіргі толық күшімді көрсетемін!
Dialogue: 0,0:13:51.66,0:13:53.70,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:13:53.70,0:13:57.27,Default,,0,0,0,,Қасиетті киім киген Өшпес жалын➡
Dialogue: 0,0:13:57.27,0:13:59.23,Default,,0,0,0,,Таң ата...
Dialogue: 0,0:13:59.23,0:14:04.21,Default,,0,0,0,,Келісу мөрі Бавсагара Аркширге барыңыз!
Dialogue: 0,0:14:08.18,0:14:10.21,Default,,0,0,0,,Харибхадра дағдылары➡
Dialogue: 0,0:14:10.21,0:14:13.21,Default,,0,0,0,,Палубадан түсетін жәшікке 2 жабдық картасын салыңыз➡
Dialogue: 0,0:14:13.21,0:14:17.69,Default,,0,0,0,,Тамшыдан Буданартты мөр қалқанымен жабдықтаңыз!
Dialogue: 0,0:14:19.65,0:14:21.69,Default,,0,0,0,,Бірдеңе болды!
Dialogue: 0,0:14:21.69,0:14:23.66,Default,,0,0,0,,Бұл палубаны жабдық карталарын қосу арқылы жасауға болады➡
Dialogue: 0,0:14:23.66,0:14:25.66,Default,,0,0,0,,Авангардыңызды күшейтіңіз.
Dialogue: 0,0:14:25.66,0:14:28.70,Default,,0,0,0,,Сонымен, осындай палубалар бар.
Dialogue: 0,0:14:28.70,0:14:31.17,Default,,0,0,0,,Әсіресе Mirai дәрі-дәрмек пакеті өте пайдалы➡
Dialogue: 0,0:14:31.17,0:14:33.67,Default,,0,0,0,,Сіз мұқият қарауыңыз керек.
Dialogue: 0,0:14:33.67,0:14:36.67,Default,,0,0,0,,Будханат шеберлігімен 1 картаны салыңыз➡
Dialogue: 0,0:14:36.67,0:14:39.17,Default,,0,0,0,,Ал Бавсағараның шеберлігі➡
Dialogue: 0,0:14:39.17,0:14:41.18,Default,,0,0,0,,Қуатыңызды зарядтаңыз➡
Dialogue: 0,0:14:41.18,0:14:43.18,Default,,0,0,0,,Трикумунға тамшыдан қоңырау шалыңыз! ➡
Dialogue: 0,0:14:43.18,0:14:45.68,Default,,0,0,0,,Шабдаға қоңырау шалыңыз➡
Dialogue: 0,0:14:45.68,0:14:47.72,Default,,0,0,0,,Юумашадқа қоңырау шалыңыз ➡
Dialogue: 0,0:14:47.72,0:14:50.18,Default,,0,0,0,,Қолыңыздан бір жабдық картасын алып тастау шеберлігін пайдаланыңыз➡
Dialogue: 0,0:14:50.18,0:14:53.15,Default,,0,0,0,,2 картаны салыңыз Қуат +5000➡
Dialogue: 0,0:14:53.15,0:14:55.19,Default,,0,0,0,,Бавсагара дағдылары➡
Dialogue: 0,0:14:55.19,0:14:58.69,Default,,0,0,0,,Диява жалынының семсерін тамшыдан жабдықтаңыз!
Dialogue: 0,0:15:00.73,0:15:04.17,Default,,0,0,0,,Диява шеберлігі алдыңғы қатарға 5000 қуат қосады➡
Dialogue: 0,0:15:04.17,0:15:07.17,Default,,0,0,0,,Бавусагараның шеберлігін одан әрі белсендіру➡
Dialogue: 0,0:15:07.17,0:15:09.17,Default,,0,0,0,,Қарсыластың алдыңғы қатарындағы артқы қорғаушыны шегіндіріңіз➡
Dialogue: 0,0:15:09.17,0:15:11.17,Default,,0,0,0,,Critical Plus 1➡
Dialogue: 0,0:15:11.17,0:15:13.14,Default,,0,0,0,,Оны шығарып тастаңыз!
Dialogue: 0,0:15:15.18,0:15:17.18,Default,,0,0,0,,Югмашадпен шабуыл! күзетші.
Dialogue: 0,0:15:17.18,0:15:19.18,Default,,0,0,0,,Trikumoon Boost➡
Dialogue: 0,0:15:19.18,0:15:21.18,Default,,0,0,0,,Бавсагарамен шабуыл!
Dialogue: 0,0:15:21.18,0:15:23.18,Default,,0,0,0,,Диява шеберлігі бойынша➡
Dialogue: 0,0:15:23.18,0:15:25.19,Default,,0,0,0,,Drive Plus 1➡
Dialogue: 0,0:15:25.19,0:15:28.16,Default,,0,0,0,,Көйлек күшейту арқылы 20 000 қуат!
Dialogue: 0,0:15:29.19,0:15:31.16,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:15:31.16,0:15:35.20,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:15:35.20,0:15:38.17,Default,,0,0,0,,Екінші тексеру…Триггерді салу➡
Dialogue: 0,0:15:38.17,0:15:41.67,Default,,0,0,0,,Юумашадтың күші плюс 10 000.
Dialogue: 0,0:15:41.67,0:15:43.67,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:15:43.67,0:15:47.71,Default,,0,0,0,,Алдыңғы триггер Алдыңғы қатардағы қуат плюс 10 000!
Dialogue: 0,0:15:47.71,0:15:50.68,Default,,0,0,0,,Ұрыс соңында Югмашадтың шеберлігі іске қосылады➡
Dialogue: 0,0:15:50.68,0:15:52.68,Default,,0,0,0,,Өзіңіз тұрыңыз➡
Dialogue: 0,0:15:52.68,0:15:54.68,Default,,0,0,0,,Шабдамен шабуыл!
Dialogue: 0,0:15:54.68,0:15:57.19,Default,,0,0,0,,Мен сізге рұқсат бермеймін.
Dialogue: 0,0:15:57.19,0:15:59.15,Default,,0,0,0,,Эрозия күйігін қолданыңыз➡
Dialogue: 0,0:15:59.15,0:16:01.66,Default,,0,0,0,,Зефирогира қуаты плюс 20 000➡
Dialogue: 0,0:16:01.66,0:16:03.69,Default,,0,0,0,,Рюки маркерін қойыңыз.
Dialogue: 0,0:16:03.69,0:16:06.66,Default,,0,0,0,,Әлі жоқ! Югмашадпен шабуыл!
Dialogue: 0,0:16:06.66,0:16:08.70,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:16:08.70,0:16:11.70,Default,,0,0,0,,Бұрылыстың соңында Дияваны түсіру аймағына қойыңыз.
Dialogue: 0,0:16:12.70,0:16:14.67,Default,,0,0,0,,Әй, жақсы➡
Dialogue: 0,0:16:14.67,0:16:17.74,Default,,0,0,0,,Көңілді сезім артады.
Dialogue: 0,0:16:17.74,0:16:21.18,Default,,0,0,0,,Сонда да...Мен жеңемін!
Dialogue: 0,0:16:21.18,0:16:23.68,Default,,0,0,0,,Менің жеребе кезегім!
Dialogue: 0,0:16:23.68,0:16:26.21,Default,,0,0,0,,Persona Ride Zephyrogira!
Dialogue: 0,0:16:26.21,0:16:30.22,Default,,0,0,0,,Қоңырау шалу дағдысы бар Рюки маркерін қойыңыз.
Dialogue: 0,0:16:30.22,0:16:33.69,Default,,0,0,0,,Зефирогира шеберлігі Меншікті қуат +25000➡
Dialogue: 0,0:16:33.69,0:16:35.69,Default,,0,0,0,,Және тағы басқалар! ➡
Dialogue: 0,0:16:35.69,0:16:39.73,Default,,0,0,0,,Рюки маркерлері бар 5 шеңбер болса, плюс 1 айдаңыз!
Dialogue: 0,0:16:39.73,0:16:42.16,Default,,0,0,0,,Тағы бір дағды: Рюки маркерін➡ қойыңыз
Dialogue: 0,0:16:42.16,0:16:44.17,Default,,0,0,0,,Espera идеясына қоңырау шалыңыз!
Dialogue: 0,0:16:44.17,0:16:48.67,Default,,0,0,0,,Сондай-ақ өз қолыңыздан Espera Idea деп атаңыз!
Dialogue: 0,0:16:48.67,0:16:51.67,Default,,0,0,0,,Көрініс орнатылды.
Dialogue: 0,0:16:51.67,0:16:54.68,Default,,0,0,0,,Зефирогира➡ жасаған шабуыл құрылымы
Dialogue: 0,0:16:54.68,0:16:56.68,Default,,0,0,0,,Оның алдын алуға бола ма?
Dialogue: 0,0:16:56.68,0:16:59.18,Default,,0,0,0,,Кел! Кеттік➡
Dialogue: 0,0:16:59.18,0:17:01.68,Default,,0,0,0,,Espera идеясымен шабуыл!
Dialogue: 0,0:17:01.68,0:17:03.68,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:17:03.68,0:17:06.15,Default,,0,0,0,,Басқа Espera идеясымен шабуыл жасаңыз!
Dialogue: 0,0:17:06.15,0:17:08.19,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:17:08.19,0:17:10.16,Default,,0,0,0,,Зефирогирамен шабуыл!
Dialogue: 0,0:17:11.19,0:17:14.16,Default,,0,0,0,,Екі эспера идеясы шеберлікпен тұр!
Dialogue: 0,0:17:14.16,0:17:16.16,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:17:16.16,0:17:19.17,Default,,0,0,0,,Үш жетек! Бірінші тексеру➡
Dialogue: 0,0:17:19.17,0:17:21.17,Default,,0,0,0,,Триггерді салу➡
Dialogue: 0,0:17:21.17,0:17:23.67,Default,,0,0,0,,Espera Idea Пауэр Plus 10000➡
Dialogue: 0,0:17:23.67,0:17:26.17,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:17:26.17,0:17:28.24,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:17:28.24,0:17:30.18,Default,,0,0,0,,Жарайды... сыни триггер!
Dialogue: 0,0:17:30.18,0:17:32.21,Default,,0,0,0,,Кух….
Dialogue: 0,0:17:32.21,0:17:35.68,Default,,0,0,0,,Espera Idea Пауэр Plus 10000 Critical Plus 1➡
Dialogue: 0,0:17:35.68,0:17:37.69,Default,,0,0,0,,Оған шыдай аласың ба?
Dialogue: 0,0:17:37.69,0:17:40.15,Default,,0,0,0,,Espera идеясымен шабуыл!
Dialogue: 0,0:17:40.15,0:17:42.16,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:17:42.16,0:17:44.19,Default,,0,0,0,,Будханат шеберлігін белсендіру➡
Dialogue: 0,0:17:44.19,0:17:46.16,Default,,0,0,0,,Бавсағараның күші плюс 20000➡
Dialogue: 0,0:17:46.16,0:17:48.16,Default,,0,0,0,,Көбірек сақ болыңыз!
Dialogue: 0,0:17:49.16,0:17:52.17,Default,,0,0,0,,Күткендей... сонда!
Dialogue: 0,0:17:52.17,0:17:54.67,Default,,0,0,0,,Басқа Espera идеясымен шабуыл жасаңыз!
Dialogue: 0,0:17:56.17,0:17:58.14,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:17:59.17,0:18:01.18,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:18:01.18,0:18:03.18,Default,,0,0,0,,Күткендей, Милэй керемет➡
Dialogue: 0,0:18:03.18,0:18:06.18,Default,,0,0,0,,Сізбен күресу өте қызық!
Dialogue: 0,0:18:06.18,0:18:09.68,Default,,0,0,0,,Мен сияқты, жүрегім ыстық.
Dialogue: 0,0:18:09.68,0:18:11.65,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:20.16,0:18:22.16,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:18:22.16,0:18:24.17,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:18:24.17,0:18:26.17,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:18:26.17,0:18:28.20,Default,,0,0,0,,Бавсагара Аркшир!
Dialogue: 0,0:18:28.20,0:18:30.17,Default,,0,0,0,,Бавусагара шеберлігін белсендіру➡
Dialogue: 0,0:18:30.17,0:18:32.17,Default,,0,0,0,,Drop Diyava➡ жабдықтаңыз
Dialogue: 0,0:18:32.17,0:18:34.14,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 5000!
Dialogue: 0,0:18:36.18,0:18:39.18,Default,,0,0,0,,Верлорд... маған күшіңді бер.
Dialogue: 0,0:18:39.18,0:18:43.18,Default,,0,0,0,,Бавсагараның шеберлігі Веллордқа түсіп қалды➡
Dialogue: 0,0:18:43.18,0:18:45.15,Default,,0,0,0,,Артық киіну!
Dialogue: 0,0:18:54.16,0:18:56.20,Default,,0,0,0,,Веллорд дағдылары➡
Dialogue: 0,0:18:56.20,0:18:58.17,Default,,0,0,0,,Drop Diyava➡ жабдықтаңыз
Dialogue: 0,0:18:58.17,0:19:01.17,Default,,0,0,0,,Алдыңғы қатардағы қуат +5000 қосымша➡
Dialogue: 0,0:19:01.17,0:19:03.17,Default,,0,0,0,,Юушадқа қоңырау шалыңыз.
Dialogue: 0,0:19:04.17,0:19:06.67,Default,,0,0,0,,Екі Юмашад….
Dialogue: 0,0:19:06.67,0:19:08.68,Default,,0,0,0,,Сіз оны қабылдай аласыз ба?
Dialogue: 0,0:19:08.68,0:19:10.68,Default,,0,0,0,,Әрине...Мен қабылдаймын!
Dialogue: 0,0:19:10.68,0:19:12.68,Default,,0,0,0,,Бавсагара дағдылары➡
Dialogue: 0,0:19:12.68,0:19:15.68,Default,,0,0,0,,Қарсыластың алдыңғы қатарынан шегін!
Dialogue: 0,0:19:15.68,0:19:17.69,Default,,0,0,0,,Югмашадпен шабуыл!
Dialogue: 0,0:19:17.69,0:19:21.16,Default,,0,0,0,,Күзетші! Югмашадпен тағы бір шабуыл!
Dialogue: 0,0:19:21.16,0:19:24.16,Default,,0,0,0,,Күзетші! Vellord's Boost➡
Dialogue: 0,0:19:24.16,0:19:27.23,Default,,0,0,0,,Бавсагарамен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:27.23,0:19:30.70,Default,,0,0,0,,Dress Boost Алдыңғы қатардағы қуат +10 000!
Dialogue: 0,0:19:36.17,0:19:39.17,Default,,0,0,0,,Жалынды тұмшалаған құдайлық қылыш➡
Dialogue: 0,0:19:39.17,0:19:41.18,Default,,0,0,0,,Жауды кесіп тастаңыз!
Dialogue: 0,0:19:41.18,0:19:44.18,Default,,0,0,0,,Мен саған рұқсат бермеймін...Толық күзет!
Dialogue: 0,0:19:45.18,0:19:48.15,Default,,0,0,0,,Мен Бавсагараның шабуылына тосқауыл қойдым, бірақ...
Dialogue: 0,0:19:51.69,0:19:53.65,Default,,0,0,0,,Үш жетек!
Dialogue: 0,0:19:53.65,0:19:57.16,Default,,0,0,0,,Алдымен триггер жоқ екенін тексеріңіз➡
Dialogue: 0,0:19:57.16,0:20:00.66,Default,,0,0,0,,Екінші тексеруде триггер жоқ➡
Dialogue: 0,0:20:00.66,0:20:02.66,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:20:02.66,0:20:05.23,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:20:05.23,0:20:09.17,Default,,0,0,0,,Юумашадтың күші плюс 10000 критикалық плюс 1!
Dialogue: 0,0:20:09.17,0:20:11.17,Default,,0,0,0,,Кух….
Dialogue: 0,0:20:11.17,0:20:13.14,Default,,0,0,0,,Екі Юумашад шеберлікпен тұр.
Dialogue: 0,0:20:14.68,0:20:16.68,Default,,0,0,0,,Югмашадпен шабуыл!
Dialogue: 0,0:20:16.68,0:20:18.68,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:20:18.68,0:20:21.68,Default,,0,0,0,,Басқа Югмашадпен шабуыл!
Dialogue: 0,0:20:21.68,0:20:24.19,Default,,0,0,0,,Күзетші жоқ! Бірақ әлі емес➡
Dialogue: 0,0:20:24.19,0:20:26.15,Default,,0,0,0,,Мен берілмеймін!
Dialogue: 0,0:20:27.15,0:20:31.66,Default,,0,0,0,,Зақымдануды тексеру 1-тармақ➡
Dialogue: 0,0:20:31.66,0:20:35.20,Default,,0,0,0,,Екінші тармақ➡
Dialogue: 0,0:20:35.20,0:20:37.67,Default,,0,0,0,,Триггер жоқ….
Dialogue: 0,0:20:39.17,0:20:41.67,Default,,0,0,0,,Жеңімпаз...Дәріге арналған сөмке Мираи!
Dialogue: 0,0:20:41.67,0:20:43.70,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:43.70,0:20:46.21,Default,,0,0,0,,Бар күшіңмен қиян-кескі ұрыс! ➡
Dialogue: 0,0:20:46.21,0:20:50.68,Default,,0,0,0,,Daybreak көшбасшысы Deluxe бірінші матчында жеңіске жетті!
Dialogue: 0,0:20:50.68,0:20:54.68,Default,,0,0,0,,Куфуфу...Мен оны басынан өткізіп жіберемін~.
Dialogue: 0,0:20:54.68,0:20:56.68,Default,,0,0,0,,Ах! ➡
Dialogue: 0,0:20:56.68,0:20:58.69,Default,,0,0,0,,Өте көңілсіз...!
Dialogue: 0,0:20:58.69,0:21:01.16,Default,,0,0,0,,Соңы Мен триггерді сол жаққа тартып алсам ғой!
Dialogue: 0,0:21:01.16,0:21:05.19,Default,,0,0,0,,Бұл ренжітеді… Бұл көңілсіз!
Dialogue: 0,0:21:05.19,0:21:08.70,Default,,0,0,0,,Хмм... бұл өте қызық болды!
Dialogue: 0,0:21:08.70,0:21:10.66,Default,,0,0,0,,Хехе...мен де.
Dialogue: 0,0:21:11.67,0:21:15.20,Default,,0,0,0,,Иә! Келесі жолы Daybreak-ке келгіңіз келе ме?
Dialogue: 0,0:21:15.20,0:21:18.17,Default,,0,0,0,,Күтпеген жерден ұрысып қалған балаларды кездестіргенде ➡
Dialogue: 0,0:21:18.17,0:21:20.17,Default,,0,0,0,,Бұл қызық болатынына сенімдімін.
Dialogue: 0,0:21:20.17,0:21:24.18,Default,,0,0,0,,Бұл жақсы~ Одан жақсы деректер алатын сияқтымыз.
Dialogue: 0,0:21:24.18,0:21:27.65,Default,,0,0,0,,Хехе...Мен оны асыға күтемін.
Dialogue: 0,0:21:28.68,0:21:31.69,Default,,0,0,0,,Жақсы жекпе-жек болды.
Dialogue: 0,0:21:31.69,0:21:34.16,Default,,0,0,0,,Сәлем... бұл керемет болды!
Dialogue: 0,0:21:35.66,0:21:38.16,Default,,0,0,0,,Осы екеуінің ғажайып жекпе-жегін көріп отырғанда➡
Dialogue: 0,0:21:38.16,0:21:40.16,Default,,0,0,0,,Бұл жерде күн ыстық!
Dialogue: 0,0:21:42.16,0:21:44.17,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:45.23,0:21:57.21,Default,,0,0,0,,(Метроном дыбысы)
Dialogue: 0,0:21:57.21,0:21:59.21,Default,,0,0,0,,Менің ырғағым есінен шықпайды...
