Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.96,0:00:13.22,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:00:13.30,0:00:15.93,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:20.35,0:00:22.77,Default,,0,0,0,,Мен көп тырыстым, бірақ нәтиже болмады.
Dialogue: 0,0:00:24.19,0:00:27.02,Default,,0,0,0,,Ол бала шайтанның баласы.
Dialogue: 0,0:00:36.12,0:00:37.24,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:00:37.91,0:00:41.25,Default,,0,0,0,,Сіздің айтқаныңызды ешкім қабылдай алмайды.
Dialogue: 0,0:00:41.33,0:00:44.21,Default,,0,0,0,,Ешкім өз қалауынша өмір сүре алмайды!
Dialogue: 0,0:00:47.33,0:00:49.80,Default,,0,0,0,,Химико-чанның түрі қорқынышты
Dialogue: 0,0:00:50.63,0:00:52.42,Default,,0,0,0,,Сабырлы болыңыз
Dialogue: 0,0:00:53.13,0:00:55.51,Default,,0,0,0,,Мен мұны сен үшін айтып отырмын!
Dialogue: 0,0:01:04.48,0:01:06.85,Default,,0,0,0,,Мен кішкентай құс болғым келеді
Dialogue: 0,0:01:06.94,0:01:09.86,Default,,0,0,0,,Чун Чун Пёнпён Кааиино
Dialogue: 0,0:01:09.94,0:01:12.36,Default,,0,0,0,,Мен Кейчан болғым келеді
Dialogue: 0,0:01:12.44,0:01:15.28,Default,,0,0,0,,Сізде күлімсіреген әдемі шұңқырлар бар.
Dialogue: 0,0:01:15.86,0:01:18.53,Default,,0,0,0,,Мен күнде түнде түс көремін
Dialogue: 0,0:01:18.62,0:01:21.20,Default,,0,0,0,,Қызыл торғай билеп жатыр
Dialogue: 0,0:01:21.29,0:01:24.21,Default,,0,0,0,,Менің ішімді түртіңіз
Dialogue: 0,0:01:24.29,0:01:29.79,Default,,0,0,0,,Көп ұзамай, ішіңді қағып, ішімде билей бастайсың.
Dialogue: 0,0:01:29.88,0:01:32.80,Default,,0,0,0,,Мен де ашық қызылға айналдым
Dialogue: 0,0:01:32.88,0:01:35.80,Default,,0,0,0,,Бұл өте сүйкімді болып барады.
Dialogue: 0,0:01:36.55,0:01:40.72,Default,,0,0,0,,Жағымды түс екен, қуанамын
Dialogue: 0,0:01:47.02,0:01:49.40,Default,,0,0,0,,Бәрін лақтырып жібердің.
Dialogue: 0,0:01:53.53,0:01:55.74,Default,,0,0,0,,Тіпті Теми сияқты жынды қыздарға...
Dialogue: 0,0:01:55.82,0:01:59.24,Default,,0,0,0,,Менде сентиментальды жүрек бар ма, білмеймін.
Dialogue: 0,0:01:59.32,0:02:02.28,Default,,0,0,0,,Мен сіздің үйіңіз туралы қызықты болдым.
Dialogue: 0,0:02:02.37,0:02:03.45,Default,,0,0,0,,Қалыпты
Dialogue: 0,0:02:03.54,0:02:06.33,Default,,0,0,0,,А, дайынсың ба?
Dialogue: 0,0:02:06.41,0:02:08.37,Default,,0,0,0,,Не?
Dialogue: 0,0:02:08.46,0:02:11.54,Default,,0,0,0,,Мен дүниені жоюға бел байладым.
Dialogue: 0,0:02:11.63,0:02:13.00,Default,,0,0,0,,тым кеш
Dialogue: 0,0:02:13.09,0:02:14.96,Default,,0,0,0,,(Айзава) Бірінші жекпе-жек бойынша ой елегінен өткізуге арналған негізгі тармақтарды айтыңыз
Dialogue: 0,0:02:15.05,0:02:19.89,Default,,0,0,0,,Кім жыласа да, күлсе де ертеңгі күні тең келеді.
Dialogue: 0,0:02:19.97,0:02:24.14,Default,,0,0,0,,Олай болса күлейік, Химико Тога
Dialogue: 0,0:02:24.22,0:02:25.35,Default,,0,0,0,,Адамдар...
Dialogue: 0,0:02:25.43,0:02:26.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:26.85,0:02:29.56,Default,,0,0,0,,Күлу үшін өмір сүру
Dialogue: 0,0:02:29.65,0:02:30.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:34.02,0:02:36.40,Default,,0,0,0,,Біз сені табамыз, Тоя-кун.
Dialogue: 0,0:02:38.57,0:02:39.99,Default,,0,0,0,,Сіз мейірімдісіз, солай емес пе?
Dialogue: 0,0:02:40.07,0:02:44.41,Default,,0,0,0,,Қазіргі жүйенің бізді қууға күші жетпейді.
Dialogue: 0,0:02:44.49,0:02:49.75,Default,,0,0,0,,Сенің мейірімді болуыңның себебі - Сендевордың азап шеккенін қалайсың.
Dialogue: 0,0:02:53.96,0:02:57.30,Default,,0,0,0,,«Трансформацияны» қолдануға болады
Dialogue: 0,0:02:59.38,0:03:00.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:01.09,0:03:03.51,Default,,0,0,0,,Тек жақсы ниет танытқандар үшін
Dialogue: 0,0:03:03.60,0:03:07.35,Default,,0,0,0,,Қаныңыздың көмегімен сіз енді сол «индивидуалдылықты» да пайдалана аласыз.
Dialogue: 0,0:03:07.43,0:03:10.02,Default,,0,0,0,,Макиа ұрлап кеткенге дейін
Dialogue: 0,0:03:10.10,0:03:15.73,Default,,0,0,0,,Нағыз заттан алған екі рет қан.
Dialogue: 0,0:03:16.53,0:03:18.86,Default,,0,0,0,,Садман шеруі
Dialogue: 0,0:03:18.94,0:03:23.07,Default,,0,0,0,,Аянышты марш жалғасын тапсын.
Dialogue: 0,0:03:23.16,0:03:25.41,Default,,0,0,0,,Соңында күлген адам
Dialogue: 0,0:03:26.24,0:03:27.75,Default,,0,0,0,,Бұл біз.
Dialogue: 0,0:03:29.00,0:03:34.00,Default,,0,0,0,,♪～
Dialogue: 0,0:04:53.96,0:04:58.96,Default,,0,0,0,,～♪
Dialogue: 0,0:05:03.30,0:05:05.88,Default,,0,0,0,,Ооо!
Dialogue: 0,0:05:05.97,0:05:07.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:07.34,0:05:11.60,Default,,0,0,0,,(Өлі ағаш жылайды)
Dialogue: 0,0:05:11.68,0:05:13.31,Default,,0,0,0,,Өлі ағаш
Dialogue: 0,0:05:14.14,0:05:16.40,Default,,0,0,0,,Ааа!
Dialogue: 0,0:05:16.48,0:05:17.31,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:05:19.86,0:05:20.69,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:22.32,0:05:24.70,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:05:24.78,0:05:29.53,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:05:29.62,0:05:30.99,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:05:31.08,0:05:31.91,Default,,0,0,0,,Ах
Dialogue: 0,0:05:31.99,0:05:35.87,Default,,0,0,0,,Мұраның жағдайы жақсы.
Dialogue: 0,0:05:35.96,0:05:39.88,Default,,0,0,0,,«Индивидуалдылық» эсхатологиясын жеңу
Dialogue: 0,0:05:40.63,0:05:43.38,Default,,0,0,0,,Өлі ағаш... бұл не?
Dialogue: 0,0:05:43.46,0:05:45.55,Default,,0,0,0,,О, әрине
Dialogue: 0,0:05:47.05,0:05:48.14,Default,,0,0,0,,Спиннер
Dialogue: 0,0:05:48.22,0:05:50.22,Default,,0,0,0,,Жау (жауыз) қылмыстары арасында
Dialogue: 0,0:05:50.30,0:05:54.39,Default,,0,0,0,,Сондай-ақ, сіз оның қаншалықты қалыпты емес пішіндерге қатысты екенін білуіңіз керек.
Dialogue: 0,0:05:54.48,0:05:58.19,Default,,0,0,0,,Қанша ел, батырлар нұры төгілсе де,
Dialogue: 0,0:05:58.27,0:06:00.56,Default,,0,0,0,,Жарық жете алмайтын қараңғылық
Dialogue: 0,0:06:00.65,0:06:04.90,Default,,0,0,0,,Батыр атанғандарға өшпенділік тудыратын көптеген ауытқулар бар.
Dialogue: 0,0:06:04.99,0:06:08.41,Default,,0,0,0,,Біздің қалдықтар қозғалыс сызығын сызды.
Dialogue: 0,0:06:08.49,0:06:12.33,Default,,0,0,0,,Жау (жауыз) одағының басында сіз өзіңіздің сыртқы түріңізді жұртшылықтың назарына шығардыңыз.
Dialogue: 0,0:06:13.45,0:06:16.04,Default,,0,0,0,,Костюм жай ғана еліктеу болды.
Dialogue: 0,0:06:16.12,0:06:19.37,Default,,0,0,0,,Ол енді оғаш пішіндерді басқаратын жұлдызға айналуда.
Dialogue: 0,0:06:19.46,0:06:24.34,Default,,0,0,0,,Микоши тым жеңіл. Ондай асқақ себеп жоқ.
Dialogue: 0,0:06:24.42,0:06:25.76,Default,,0,0,0,,Ең алдымен, сен—
Dialogue: 0,0:06:25.84,0:06:27.84,Default,,0,0,0,,Қалып құйылады
Dialogue: 0,0:06:27.93,0:06:32.93,Default,,0,0,0,,Дацугоку былай тұрсын, сізді Моб күтіп тұр.
Dialogue: 0,0:06:33.01,0:06:37.52,Default,,0,0,0,,Сіз Re-Destro атынан триггерді тартасыз.
Dialogue: 0,0:06:38.64,0:06:41.48,Default,,0,0,0,,Мен, кішкентай азамат, не ойласам да
Dialogue: 0,0:06:41.56,0:06:43.82,Default,,0,0,0,,Ағынды енді тоқтату мүмкін емес.
Dialogue: 0,0:06:43.90,0:06:48.74,Default,,0,0,0,,Сенің қадамың баршаға жігер береді.
Dialogue: 0,0:06:48.82,0:06:50.07,Default,,0,0,0,,...Мен мұны істеймін.
Dialogue: 0,0:06:51.16,0:06:55.24,Default,,0,0,0,,Мен сені құртамын ха-ха...
Dialogue: 0,0:06:55.33,0:06:58.25,Default,,0,0,0,,Бұл туралы ойланатын кез келді.
Dialogue: 0,0:06:59.29,0:07:00.67,Default,,0,0,0,,Өлі ағаш
Dialogue: 0,0:07:01.25,0:07:04.38,Default,,0,0,0,,Мен тек сен үшінмін
Dialogue: 0,0:07:04.46,0:07:06.88,Default,,0,0,0,,Иә, Игучи-кун.
Dialogue: 0,0:07:06.96,0:07:12.55,Default,,0,0,0,,Кез келген адам біреудің қаһарманы бола алады.
Dialogue: 0,0:07:29.07,0:07:31.16,Default,,0,0,0,,Бұйрық келді. Не?
Dialogue: 0,0:07:31.86,0:07:34.24,Default,,0,0,0,,Кейде біз қалаған нәрсені жасай алмаймыз.
Dialogue: 0,0:07:34.32,0:07:36.16,Default,,0,0,0,,Оны сол адам алдын ала білген.
Dialogue: 0,0:07:36.24,0:07:37.70,Default,,0,0,0,,«Аоре»
Dialogue: 0,0:07:37.79,0:07:41.96,Default,,0,0,0,,«Оппозицияда болуы мүмкін адамдарды тарту»
Dialogue: 0,0:07:42.04,0:07:45.71,Default,,0,0,0,,“   ”
Dialogue: 0,0:07:45.79,0:07:48.21,Default,,0,0,0,,«Мен бір апта қалғанын білемін.»
Dialogue: 0,0:07:48.30,0:07:51.97,Default,,0,0,0,,«Алдағы дағдарысты жасыру».
Dialogue: 0,0:07:52.89,0:07:54.47,Default,,0,0,0,,Аоре
Dialogue: 0,0:07:54.55,0:08:00.48,Default,,0,0,0,,Изуку Мидория енді сол бекіністе тұра алмайды.
Dialogue: 0,0:08:01.39,0:08:06.11,Default,,0,0,0,,Азаттық майданы мен жау (зұлым) коалициясын іздеуге қосылғандар
Dialogue: 0,0:08:06.19,0:08:09.61,Default,,0,0,0,,Кейбір Дацугоку қорғалғанымен
Dialogue: 0,0:08:09.69,0:08:13.78,Default,,0,0,0,,Іздеудің өзі нәтиже бермеді.
Dialogue: 0,0:08:15.16,0:08:17.20,Default,,0,0,0,,Мен... шаршадым...
Dialogue: 0,0:08:17.28,0:08:20.04,Default,,0,0,0,,Іздеу аймағы тым кең.
Dialogue: 0,0:08:20.12,0:08:23.46,Default,,0,0,0,,Батырлар саны осылай азайып бара жатқаны өте маңызды.
Dialogue: 0,0:08:23.54,0:08:24.46,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:08:24.54,0:08:26.84,Default,,0,0,0,,Тез ұйықтаңыз
Dialogue: 0,0:08:26.92,0:08:28.96,Default,,0,0,0,,Біздің күшіміз – жастарымыз
Dialogue: 0,0:08:29.05,0:08:31.80,Default,,0,0,0,,Әрбір қозғалыс билікке әкеледі
Dialogue: 0,0:08:31.88,0:08:33.93,Default,,0,0,0,,Сен маған мықты бол деді
Dialogue: 0,0:08:34.01,0:08:37.10,Default,,0,0,0,,үшінңыз, тістеріңізді тазалауды ұмытпаңыздар.
Dialogue: 0,0:08:37.18,0:08:40.39,Default,,0,0,0,,Мен сөйлесуге біраз уақыт алғым келеді.
Dialogue: 0,0:08:40.47,0:08:42.10,Default,,0,0,0,,Ұсақ әңгімеге болмайды.
Dialogue: 0,0:08:42.18,0:08:43.81,Default,,0,0,0,,Бірақ иә.
Dialogue: 0,0:08:45.35,0:08:47.90,Default,,0,0,0,,Мен жақында ваннаға түскім келеді.
Dialogue: 0,0:08:47.98,0:08:49.07,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:08:50.19,0:08:52.82,Default,,0,0,0,,Менің сөйлесуге уақытым жоқ
Dialogue: 0,0:08:53.32,0:08:54.78,Default,,0,0,0,,Міне!
Dialogue: 0,0:08:54.86,0:08:55.99,Default,,0,0,0,,Оның!
Dialogue: 0,0:08:57.07,0:09:00.83,Default,,0,0,0,,Маған Hero Academia-да сәтті өтіңіз!
Dialogue: 0,0:09:02.41,0:09:05.37,Default,,0,0,0,,Мен сізге әлі дұрыс алғыс айта алмадым.
Dialogue: 0,0:09:06.04,0:09:07.88,Default,,0,0,0,,Урарака... (Каминари) Уау!
Dialogue: 0,0:09:07.96,0:09:11.46,Default,,0,0,0,,Мен! Мен мұнда күн сайын дерлік келдім!
Dialogue: 0,0:09:11.55,0:09:13.84,Default,,0,0,0,,Часу менде бәрі жақсы.
Dialogue: 0,0:09:13.92,0:09:14.88,Default,,0,0,0,,...
Dialogue: 0,0:09:14.97,0:09:17.59,Default,,0,0,0,,Цукаучи мырзаға және мектеп директорына...
Dialogue: 0,0:09:18.18,0:09:20.26,Default,,0,0,0,,Бұл Аояма мырза туралы ма?
Dialogue: 0,0:09:21.72,0:09:23.93,Default,,0,0,0,,Одан әрі
Dialogue: 0,0:09:24.02,0:09:27.65,Default,,0,0,0,,Қазіргі уақытта контур туралы тек шектеулі адамдар ғана хабарланады.
Dialogue: 0,0:09:28.69,0:09:31.19,Default,,0,0,0,,Екінші шешуші шайқастың соңғы жоспары
Dialogue: 0,0:09:31.98,0:09:34.19,Default,,0,0,0,,Бұл кеңесті өткізіңіз.
Dialogue: 0,0:09:36.03,0:09:37.53,Default,,0,0,0,,Юэйді паналау —
Dialogue: 0,0:09:37.61,0:09:40.08,Default,,0,0,0,,Барлық азаматтарға ескерту
Dialogue: 0,0:09:40.74,0:09:43.79,Default,,0,0,0,,Батырлар мен полицияның бірлескен тергеуінің нәтижелері
Dialogue: 0,0:09:43.87,0:09:48.29,Default,,0,0,0,,Бұрын-соңды болмаған апат әкелген жау (зұлым) одағының қураған ағашы.
Dialogue: 0,0:09:48.38,0:09:53.26,Default,,0,0,0,,Енді 4 күннен кейін қызметімізді қайта бастайтынымыз анық.
Dialogue: 0,0:09:53.34,0:09:57.22,Default,,0,0,0,,Әр адамның қауіпсіздігін қамтамасыз ету үшін,
Dialogue: 0,0:09:57.30,0:10:00.51,Default,,0,0,0,,Төрт күннен кейін бүкіл Юэйде әскери жағдай енгізілді.
Dialogue: 0,0:10:00.60,0:10:05.52,Default,,0,0,0,,Біз қорғаныс жүйемізді барынша күшейтуді шештік.
Dialogue: 0,0:10:05.60,0:10:09.23,Default,,0,0,0,,Эвакуация жүйесі іске қосылған кезде қозғалысты шектеу және т.б.
Dialogue: 0,0:10:09.31,0:10:13.28,Default,,0,0,0,,Бұл сізге тудыруы мүмкін кез келген қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:10:13.36,0:10:18.57,Default,,0,0,0,,Түсінгеніңізге рахмет.
Dialogue: 0,0:10:21.87,0:10:23.20,Default,,0,0,0,,Баршаңыз!
Dialogue: 0,0:10:23.29,0:10:25.62,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:10:25.70,0:10:28.17,Default,,0,0,0,,Бауырым, сен осы жерден кететініңе сенімдісің бе?
Dialogue: 0,0:10:28.25,0:10:33.59,Default,,0,0,0,,Иә, менде балшықты тазалауға жеткілікті уақыт болды.
Dialogue: 0,0:10:33.67,0:10:37.59,Default,,0,0,0,,Сіздің қауіпсіздігіңіз біздің басты міндетіміз.
Dialogue: 0,0:10:37.67,0:10:42.10,Default,,0,0,0,,Жалғыз нәрсе - эвакуация жүйесі қашан іске қосылса да, қауіпсіз болу.
Dialogue: 0,0:10:42.18,0:10:44.35,Default,,0,0,0,,Дайын болыңыз, өтінемін.
Dialogue: 0,0:10:44.43,0:10:46.48,Default,,0,0,0,,Шынымды айтсам...
Dialogue: 0,0:10:46.56,0:10:51.23,Default,,0,0,0,,Осы жерде үндемей, қорған болса, көп қиналмас еді.
Dialogue: 0,0:10:51.31,0:10:54.98,Default,,0,0,0,,Алайда директиваға жоспарсыз қол жеткізілді.
Dialogue: 0,0:10:55.65,0:10:59.36,Default,,0,0,0,,Енді біздің болашағымызға кепілдік берілген
Dialogue: 0,0:11:32.52,0:11:34.61,Default,,0,0,0,,Юэйден кеткен біз
Dialogue: 0,0:11:34.69,0:11:39.86,Default,,0,0,0,,Біздің жаңа үй мектебімізден шамамен 30 шақырым жерде.
Dialogue: 0,0:11:39.95,0:11:42.99,Default,,0,0,0,,Трояның уақытша бекінісіне көшті.
Dialogue: 0,0:11:43.07,0:11:44.62,Default,,0,0,0,,Cementos қуат тиегіші
Dialogue: 0,0:11:44.70,0:11:47.08,Default,,0,0,0,,Және эктоплазма болғандықтан
Dialogue: 0,0:11:47.16,0:11:49.29,Default,,0,0,0,,Өте қысқа мерзімді құрылыс мүмкін
Dialogue: 0,0:11:49.37,0:11:52.67,Default,,0,0,0,,Бұл Юэй сияқты күшті емес, бірақ ол берік.
Dialogue: 0,0:11:52.75,0:11:55.34,Default,,0,0,0,,үшін сіздің жүктеріңізді бөлмеңізге апарып, дайындалыңыз.
Dialogue: 0,0:11:55.42,0:11:57.71,Default,,0,0,0,,Биіктіктер Альянсы құрметі.
Dialogue: 0,0:11:57.80,0:11:58.84,Default,,0,0,0,,Мейірімділік
Dialogue: 0,0:11:58.92,0:12:01.38,Default,,0,0,0,,Бұл менің үйім болып қалмайды деп үміттенемін.
Dialogue: 0,0:12:01.47,0:12:02.30,Default,,0,0,0,,Тоқта
Dialogue: 0,0:12:18.69,0:12:19.57,Default,,0,0,0,,(Камино) Көздері жылтырап, жүзі әдемі, бірақ—
Dialogue: 0,0:12:19.65,0:12:20.94,Default,,0,0,0,,Эй Деку-кун
Dialogue: 0,0:12:21.03,0:12:22.78,Default,,0,0,0,,Қаптаманы ашуды аяқтадыңыз ба?
Dialogue: 0,0:12:22.86,0:12:25.78,Default,,0,0,0,,Иә, мен ештеңе әкелген жоқпын.
Dialogue: 0,0:12:25.87,0:12:27.87,Default,,0,0,0,,Мен де жай ғана киім ауыстырамын.
Dialogue: 0,0:12:31.58,0:12:35.17,Default,,0,0,0,,Урарака-сан, сол уақыт үшін рахмет.
Dialogue: 0,0:12:35.25,0:12:38.50,Default,,0,0,0,,Мен сізге дұрыс алғыс айта алмадым. Өте көп.
Dialogue: 0,0:12:38.59,0:12:40.80,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:12:40.88,0:12:44.26,Default,,0,0,0,,Әдеттегідей сіз егжей-тегжейге назар аударасыз.
Dialogue: 0,0:12:44.34,0:12:46.39,Default,,0,0,0,,Сіз сыртта не істеп жүрдіңіз?
Dialogue: 0,0:12:46.47,0:12:50.72,Default,,0,0,0,,А... Мен қалаға қарап тұрдым.
Dialogue: 0,0:12:51.85,0:12:55.27,Default,,0,0,0,,Мен біртүрлімін, солай емес пе?
Dialogue: 0,0:12:55.35,0:12:56.52,Default,,0,0,0,,Бұл таңқаларлық емес.
Dialogue: 0,0:12:56.61,0:12:58.77,Default,,0,0,0,,Ол күшті, батыл, шаш үлгісі өзіне жарасады.
Dialogue: 0,0:12:58.86,0:13:00.44,Default,,0,0,0,,Өте мейірімді және жақсы
Dialogue: 0,0:13:00.53,0:13:02.28,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:13:03.57,0:13:07.78,Default,,0,0,0,,Сол кезде... Юэйдің мектеп ғимаратының үстінде сөйлесіп тұрған кезіміз.
Dialogue: 0,0:13:07.87,0:13:11.45,Default,,0,0,0,,Футоза Химико Тога ойыма оралды
Dialogue: 0,0:13:13.50,0:13:16.92,Default,,0,0,0,,Гигантомахия кезінде бір-бірден
Dialogue: 0,0:13:17.67,0:13:21.25,Default,,0,0,0,,Мен әдеттегідей қабылдайтын нәрселерді жасаймын.
Dialogue: 0,0:13:21.34,0:13:22.76,Default,,0,0,0,,Мен оған сөзбен жауап бердім.
Dialogue: 0,0:13:23.51,0:13:26.43,Default,,0,0,0,,Ол өте қайғылы көрінді.
Dialogue: 0,0:13:26.51,0:13:27.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:28.89,0:13:34.27,Default,,0,0,0,,Қалаға осылай жасап, талай жанды, бақытты алып кеткен жау (жауыз).
Dialogue: 0,0:13:34.35,0:13:36.98,Default,,0,0,0,,Бұл енді кешіру немесе кешірмеу мәселесі емес.
Dialogue: 0,0:13:37.06,0:13:40.27,Default,,0,0,0,,Мен білемін, бірақ...
Dialogue: 0,0:13:40.77,0:13:44.65,Default,,0,0,0,,Мен ол кісінің парасаттылығын білмеймін.
Dialogue: 0,0:13:44.74,0:13:49.20,Default,,0,0,0,,Мен Химико Тога туралы ештеңе білмеймін деп ойлаймын.
Dialogue: 0,0:13:50.37,0:13:52.37,Default,,0,0,0,,Сондықтан мен қалаға қарап тұрдым
Dialogue: 0,0:13:53.29,0:13:56.04,Default,,0,0,0,,Жан түршігерлік көріністі ұмытпа
Dialogue: 0,0:13:56.79,0:13:59.58,Default,,0,0,0,,Көп ойланбаңыз
Dialogue: 0,0:14:01.04,0:14:03.46,Default,,0,0,0,,Мен де... Не? (Рейхи) Иә?
Dialogue: 0,0:14:04.17,0:14:09.89,Default,,0,0,0,,Мен де қураған ағашта жылап тұрған кішкентай баланы көрдім.
Dialogue: 0,0:14:09.97,0:14:12.72,Default,,0,0,0,,Тіпті ұрыс сөзсіз болса да
Dialogue: 0,0:14:12.81,0:14:15.89,Default,,0,0,0,,Мен тереңде жатқан нәрселерді елеусіз қалдырғым келмейді.
Dialogue: 0,0:14:18.40,0:14:19.77,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:19.85,0:14:23.73,Default,,0,0,0,,Сонда екеуің біртүрлі екенсіңдер.
Dialogue: 0,0:14:25.24,0:14:28.66,Default,,0,0,0,,Қуатыңызды жұмсауға мәжбүрлегенім үшін кешіріңіз. Жарайды.
Dialogue: 0,0:14:28.74,0:14:30.99,Default,,0,0,0,,Өйткені менің де ағам бар.
Dialogue: 0,0:14:31.62,0:14:35.08,Default,,0,0,0,,Мен сенімен салыстыруға шыдай алмаймын.
Dialogue: 0,0:14:35.16,0:14:38.54,Default,,0,0,0,,Мен Тоя-нидің нені жақсы көретінін де білмеймін.
Dialogue: 0,0:14:38.62,0:14:41.67,Default,,0,0,0,,Бұл сөзсіз удон, қайнатылған.
Dialogue: 0,0:14:42.92,0:14:45.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:46.38,0:14:48.68,Default,,0,0,0,,Бірге тамақтанайық
Dialogue: 0,0:14:52.64,0:14:54.47,Default,,0,0,0,,Тоқтауды ұмытпаңыз
Dialogue: 0,0:15:05.48,0:15:08.07,Default,,0,0,0,,Өтірікті түсінбеймін
Dialogue: 0,0:15:08.15,0:15:12.78,Default,,0,0,0,,Егер сізде маған деген азғантай да жаман ниетіңіз болса, мен білемін.
Dialogue: 0,0:15:12.87,0:15:16.24,Default,,0,0,0,,«Индивидуалдылық» қалай аталды?
Dialogue: 0,0:15:16.33,0:15:18.71,Default,,0,0,0,,Өйткені, бұл алғашқы күндерде болды.
Dialogue: 0,0:15:19.29,0:15:23.13,Default,,0,0,0,,Бұл түсініксіз, себебі ол басқалармен біріктірілген түрде күшейтілген.
Dialogue: 0,0:15:24.00,0:15:27.88,Default,,0,0,0,,Менің ойымша, иесі түтіккен адам болды.
Dialogue: 0,0:15:27.96,0:15:31.13,Default,,0,0,0,,Оның ұрпағы жақсы.
Dialogue: 0,0:15:31.22,0:15:33.22,Default,,0,0,0,,Қандай себеп-салдар?
Dialogue: 0,0:15:33.30,0:15:37.93,Default,,0,0,0,,Бірде ол мені Бүкіл Құдірет-пен бұрышқа қағады.
Dialogue: 0,0:15:38.02,0:15:43.52,Default,,0,0,0,,Бірақ бұл жолы сол «жекелік» маған жеңіс әкеледі.
Dialogue: 0,0:15:43.61,0:15:48.61,Default,,0,0,0,,Еккен дәнім жеміс бергеннен артық қуаныш жоқ.
Dialogue: 0,0:15:49.24,0:15:51.20,Default,,0,0,0,,Иә, өзгеріс жоқ
Dialogue: 0,0:15:51.28,0:15:53.41,Default,,0,0,0,,Мен алкогольді ішкім келеді.
Dialogue: 0,0:15:53.49,0:15:56.70,Default,,0,0,0,,Макаллан 40 жаста жақсы
Dialogue: 0,0:15:56.79,0:16:00.25,Default,,0,0,0,,16 жаста болса, мен оны ұлыма беремін.
Dialogue: 0,0:16:00.33,0:16:02.42,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:16:02.50,0:16:07.00,Default,,0,0,0,,Мен сіздің ұлыңыздың байланыс ақпаратын алғым келеді.
Dialogue: 0,0:16:07.09,0:16:09.09,Default,,0,0,0,,Мен бәріне сенімді болғым келеді.
Dialogue: 0,0:16:09.17,0:16:11.26,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:16:11.34,0:16:14.09,Default,,0,0,0,,Осы заманда ағай.
Dialogue: 0,0:16:14.18,0:16:16.89,Default,,0,0,0,,Шинигами қалай өледі екен.
Dialogue: 0,0:16:16.97,0:16:19.97,Default,,0,0,0,,Өтірік немесе зиянды ниет жоқ Таза ақ
Dialogue: 0,0:16:20.56,0:16:22.14,Default,,0,0,0,,Сіз жүзуге мәжбүр болсаңыз да
Dialogue: 0,0:16:22.23,0:16:26.23,Default,,0,0,0,,Егер сізден кейін сұрақ қойылса, ешқандай проблема жоқ.
Dialogue: 0,0:16:26.31,0:16:31.49,Default,,0,0,0,,Бұл тосқауылға қарсы шаралар туралы соңғы ақымақ алмасу.
Dialogue: 0,0:16:31.57,0:16:33.20,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:16:33.28,0:16:36.41,Default,,0,0,0,,Аа, ертең кездескенше
Dialogue: 0,0:16:41.75,0:16:43.71,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:16:45.75,0:16:47.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:54.01,0:16:55.89,Default,,0,0,0,,Не? Денің сау ма? (Миямура) Иә.
Dialogue: 0,0:16:55.97,0:16:58.56,Default,,0,0,0,,Аояма-кун, мұнда неге келдің?
Dialogue: 0,0:16:59.18,0:17:00.68,Default,,0,0,0,,Сіз уақытша ұстау изоляторында болдыңыз...
Dialogue: 0,0:17:01.31,0:17:03.60,Default,,0,0,0,,Ата-анамның қорғаушысы мені босатты.
Dialogue: 0,0:17:03.69,0:17:06.27,Default,,0,0,0,,Мен бәріне айтамын, мен қайтадан іздеуді бастаймын ...
Dialogue: 0,0:17:06.35,0:17:07.23,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:17:08.40,0:17:10.23,Default,,0,0,0,,Мен сенімен сөйлескім келеді
Dialogue: 0,0:17:14.24,0:17:15.45,Default,,0,0,0,,Бұл күлкілі, солай емес пе?
Dialogue: 0,0:17:15.53,0:17:20.20,Default,,0,0,0,,Мен осы күйреген Жапонияда соттардың әлі тірі екеніне сене алмаймын.
Dialogue: 0,0:17:21.37,0:17:24.16,Default,,0,0,0,,Осындай дүниеде дәстүрлі өмір салтын ұстану
Dialogue: 0,0:17:24.25,0:17:26.12,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:26.21,0:17:27.83,Default,,0,0,0,,Мұндай жағдай ма? Мен мүлде алаңдаймын деп ойламаймын.
Dialogue: 0,0:17:27.92,0:17:31.63,Default,,0,0,0,,Мен сізге «үшін бір үшін» ойынының шынайы мақсатын айтайын.
Dialogue: 0,0:17:31.71,0:17:34.30,Default,,0,0,0,,Өйткені Жапония қазір осындай болып қалды
Dialogue: 0,0:17:34.38,0:17:37.14,Default,,0,0,0,,Дүниенің қандай екенін білесің бе?
Dialogue: 0,0:17:37.84,0:17:43.64,Default,,0,0,0,,Кенеттен иеннің құны құлдырап, көптеген жапондық компаниялар банкротқа ұшырай бастады.
Dialogue: 0,0:17:44.27,0:17:49.52,Default,,0,0,0,,Осы толқудың және бір мезгілде жаулардың (зұлымдардың) белсендіруіне байланысты зиян әр елге таралуда.
Dialogue: 0,0:17:49.61,0:17:54.82,Default,,0,0,0,,Ұлы депрессия мен паранормальдық көріністерге ұқсас тенденция жақын.
Dialogue: 0,0:17:54.90,0:17:59.91,Default,,0,0,0,,Жаһандық жұмыс орнын жоғалту Ақшаға деген сенімді жоғалту
Dialogue: 0,0:17:59.99,0:18:01.33,Default,,0,0,0,,Қатты аласапыран заман
Dialogue: 0,0:18:01.41,0:18:04.29,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Аояма-кун
Dialogue: 0,0:18:04.95,0:18:07.92,Default,,0,0,0,,Ұзақ мерзімді саясатты жүзеге асырыңыз Егер күшіңіз жоғалса
Dialogue: 0,0:18:08.00,0:18:12.25,Default,,0,0,0,,Біз тез арада қауіпсіздікті іздеп, соғысып, кедейленіп бара жатырмыз.
Dialogue: 0,0:18:12.92,0:18:14.88,Default,,0,0,0,,Жапония тасталды
Dialogue: 0,0:18:14.96,0:18:18.30,Default,,0,0,0,,Өйткені әрбір елдің қауіпсіздігі бірінші орында
Dialogue: 0,0:18:18.93,0:18:22.81,Default,,0,0,0,,Мұндай дүниеде, мысалы, сусыз елде.
Dialogue: 0,0:18:22.89,0:18:25.89,Default,,0,0,0,,Ауыз су шығаратын «тұлға» шықса
Dialogue: 0,0:18:25.98,0:18:29.15,Default,,0,0,0,,Электр, газ және қуат
Dialogue: 0,0:18:29.77,0:18:32.94,Default,,0,0,0,,Құлдыраған және хаос әлеміне ену
Dialogue: 0,0:18:33.02,0:18:35.44,Default,,0,0,0,,Тек бір басым жеке тұлға
Dialogue: 0,0:18:35.53,0:18:38.95,Default,,0,0,0,,Бастамаға негіз қалыптасуда.
Dialogue: 0,0:18:39.53,0:18:42.24,Default,,0,0,0,,Ол дүниенің жын патшасы болады
Dialogue: 0,0:18:42.33,0:18:48.25,Default,,0,0,0,,Егер мен бір жерде тепе-теңдікті бұзатын болсам, бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:18:48.33,0:18:51.08,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:18:51.17,0:18:53.92,Default,,0,0,0,,Әлем сені кешірмейді
Dialogue: 0,0:18:54.00,0:18:55.21,Default,,0,0,0,,Және...
Dialogue: 0,0:18:56.30,0:18:58.68,Default,,0,0,0,,Біз әлі осындамыз
Dialogue: 0,0:18:58.76,0:19:03.68,Default,,0,0,0,,Дұрыс, сондықтан мен бұл соңғы қадам екеніне сенімдімін.
Dialogue: 0,0:19:04.68,0:19:05.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:06.06,0:19:10.23,Default,,0,0,0,,Папан мен Маманның амандығын қалаймын ғой.
Dialogue: 0,0:19:10.31,0:19:12.65,Default,,0,0,0,,Бәрі бір адам үшін!
Dialogue: 0,0:19:12.73,0:19:16.40,Default,,0,0,0,,Сен керемет жұмыс жасадың, Юга Аояма.
Dialogue: 0,0:19:16.48,0:19:18.15,Default,,0,0,0,,Бұл қорқынышты емес пе? Досқа опасыздық жасау
Dialogue: 0,0:19:18.15,0:19:19.32,Default,,0,0,0,,Бұл қорқынышты емес пе? Досқа опасыздық жасау
Dialogue: 0,0:19:18.15,0:19:19.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:19.32,0:19:20.07,Default,,0,0,0,,Бұл қорқынышты емес пе? Досқа опасыздық жасау
Dialogue: 0,0:19:20.15,0:19:23.91,Default,,0,0,0,,Бұл ауыртпады ма? Сенімді болу деген сөз
Dialogue: 0,0:19:24.74,0:19:26.87,Default,,0,0,0,,Жақсы жеңді
Dialogue: 0,0:19:26.95,0:19:30.83,Default,,0,0,0,,Соңғы мақсатым туралы айту жақсы болды.
Dialogue: 0,0:19:30.92,0:19:33.33,Default,,0,0,0,,Қатаң айтқанда, бұл қате, бірақ
Dialogue: 0,0:19:33.42,0:19:36.09,Default,,0,0,0,,Сіз ана мен әкеден сұрадыңыз ба?
Dialogue: 0,0:19:36.17,0:19:41.55,Default,,0,0,0,,Иә, өз дүниеңде сен бізге бақытқа уәде бересің.
Dialogue: 0,0:19:41.63,0:19:43.14,Default,,0,0,0,,Мен саған сендім!
Dialogue: 0,0:19:44.35,0:19:47.64,Default,,0,0,0,,Өзіңді жаман сезінбеу қиын...
Dialogue: 0,0:19:48.18,0:19:49.81,Default,,0,0,0,,Ол жоқ еді, аға!
Dialogue: 0,0:19:52.69,0:19:54.86,Default,,0,0,0,,алғыссыз
Dialogue: 0,0:19:54.94,0:19:57.40,Default,,0,0,0,,Сенің әрекетің тым шынайы, Аояма-кун.
Dialogue: 0,0:19:57.48,0:19:58.82,Default,,0,0,0,,Біздің таңдауымыз жоқ.
Dialogue: 0,0:19:58.90,0:20:01.20,Default,,0,0,0,,Сіз басқа адамды тартуыңыз керек.
Dialogue: 0,0:20:01.28,0:20:03.74,Default,,0,0,0,,Сіз де тамаша орындаушы едіңіз.
Dialogue: 0,0:20:03.82,0:20:07.62,Default,,0,0,0,,Сені алдау үшін болса да, сол көз жасыңды көрсетсең...
Dialogue: 0,0:20:07.70,0:20:11.75,Default,,0,0,0,,Қорыққаным сонша, мен жылап қана қоймай, тіпті сілеп те жатырмын.
Dialogue: 0,0:20:11.83,0:20:14.42,Default,,0,0,0,,Жарайсың Аояма-кун!
Dialogue: 0,0:20:14.50,0:20:16.50,Default,,0,0,0,,Папан мен Маманға да
Dialogue: 0,0:20:16.59,0:20:20.01,Default,,0,0,0,,үшін үшін және өзім үшін
Dialogue: 0,0:20:20.97,0:20:23.51,Default,,0,0,0,,Мен «үшін бір үшін» күресетін боламын!
Dialogue: 0,0:20:24.80,0:20:26.68,Default,,0,0,0,,Менің көңілім қалды.
Dialogue: 0,0:20:27.56,0:20:29.35,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:30.27,0:20:33.35,Default,,0,0,0,,Мен сені шығарып саламын. Кез келген уақытта жақсы.
Dialogue: 0,0:20:33.44,0:20:37.73,Default,,0,0,0,,Соңғы минуттық қарым-қатынас және ата-ананың қарым-қатынасы
Dialogue: 0,0:20:37.82,0:20:40.32,Default,,0,0,0,,Ешқандай арам ниет немесе өтірік болған жоқ.
Dialogue: 0,0:20:40.40,0:20:42.65,Default,,0,0,0,,Қалай...
Dialogue: 0,0:20:42.74,0:20:45.99,Default,,0,0,0,,Жоқ, маған бәрібір.
Dialogue: 0,0:20:46.07,0:20:47.87,Default,,0,0,0,,Мен бұл қашықтықтағы қақпан деп ойладым.
Dialogue: 0,0:20:47.95,0:20:50.83,Default,,0,0,0,,«Біреуі бәрі үшін» фактісі
Dialogue: 0,0:20:50.91,0:20:55.17,Default,,0,0,0,,«Іздеу» көрерменнің позициясы мен әлсіз жақтарын түсінеді
Dialogue: 0,0:20:56.00,0:21:01.55,Default,,0,0,0,,Сорейдің алдыңғы шайқаста көрген батырлары жан-жаққа жайылып, жан-жаққа жайғасқан.
Dialogue: 0,0:21:01.63,0:21:04.63,Default,,0,0,0,,Жеңілдік уақытында жету үшін әлі ерте.
Dialogue: 0,0:21:05.26,0:21:10.93,Default,,0,0,0,,Сондықтан біз бұл санға байқамай жақындай алдық.
Dialogue: 0,0:21:11.02,0:21:15.48,Default,,0,0,0,,Бұл жағдайға әлі кеш емес пе?
Dialogue: 0,0:21:16.02,0:21:18.44,Default,,0,0,0,,Ол ауыр қылмыс жасамаған, бірақ—
Dialogue: 0,0:21:18.52,0:21:22.19,Default,,0,0,0,,Курогири... Оны қалай жылжыттыңыз?
Dialogue: 0,0:21:22.86,0:21:25.82,Default,,0,0,0,,Бірақ бұл уақыт пен күш-жігерді де үнемдейді.
Dialogue: 0,0:21:25.91,0:21:27.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:27.66,0:21:30.12,Default,,0,0,0,,Папан мен Маман да осыны айтты.
Dialogue: 0,0:21:31.24,0:21:34.62,Default,,0,0,0,,Сонымен, Біреу үшін үшін ең жек көретін нәрсе
Dialogue: 0,0:21:34.71,0:21:38.00,Default,,0,0,0,,Жапонияның әлі аяқталмағанын әлем біледі
Dialogue: 0,0:21:38.71,0:21:44.47,Default,,0,0,0,,Қайта құрудан асқан нұр бар екенін және әлем біріктіретінін көрсетеміз!
Dialogue: 0,0:21:44.97,0:21:46.18,Default,,0,0,0,,Сонымен бүгін
Dialogue: 0,0:21:47.22,0:21:49.76,Default,,0,0,0,,Мен сені осында жеңемін!
Dialogue: 0,0:21:51.01,0:21:56.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:15.89,0:23:20.90,Default,,0,0,0,,～♪
Dialogue: 0,0:23:21.90,0:23:22.90,Default,,0,0,0,,Мен бұны реттеймін
Dialogue: 0,0:23:23.65,0:23:27.61,Default,,0,0,0,,Батыр мен жау (жауыз) арасындағы соңғы шайқас ақыры басталды.
Dialogue: 0,0:23:28.53,0:23:31.57,Default,,0,0,0,,Батырлар бастаған жауды (зұлым) бөлу стратегиясы
Dialogue: 0,0:23:31.66,0:23:34.33,Default,,0,0,0,,Аояма-кун кілтті ұстайды.
Dialogue: 0,0:23:34.41,0:23:37.04,Default,,0,0,0,,Ал Шинсу-кунның «даралығы» «миын жуу»
Dialogue: 0,0:23:37.12,0:23:39.33,Default,,0,0,0,,Монома-кунның «даралығы» «көшірмесі»
Dialogue: 0,0:23:40.41,0:23:43.58,Default,,0,0,0,,Бұл стратегия міндетті түрде сәтті болады.
Dialogue: 0,0:23:44.59,0:23:46.88,Default,,0,0,0,,Келесі жолы «БӨЛІМ»
Dialogue: 0,0:23:46.96,0:23:50.26,Default,,0,0,0,,Әрі қарай!Plus Ultra!
Dialogue: 0,0:23:51.76,0:23:57.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
