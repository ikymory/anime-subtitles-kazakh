Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.73,0:00:26.65,Default,,0,0,0,,(Гошавк жылайды)
Dialogue: 0,0:00:37.91,0:00:39.41,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:49.59,0:00:50.84,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:00:50.96,0:00:52.71,Default,,0,0,0,,(Зұлымның ырылдауы)
Dialogue: 0,0:00:52.84,0:00:54.17,Default,,0,0,0,,Зұлым! (Турист) Қаш!
Dialogue: 0,0:00:57.05,0:01:00.14,Default,,0,0,0,,(Зұлым күлкі)
Dialogue: 0,0:01:00.43,0:01:04.89,Default,,0,0,0,,Мен саған 10 миллион доллар беремін. Бұл көп жұмыс!
Dialogue: 0,0:01:05.23,0:01:06.44,Default,,0,0,0,,Аники! (Зұлым) А?
Dialogue: 0,0:01:12.44,0:01:13.99,Default,,0,0,0,,үшін осы
Dialogue: 0,0:01:15.32,0:01:16.53,Default,,0,0,0,,Оның Токиодағы кеңсесінде 65-ке дейін көмекшісі бар.
Dialogue: 0,0:01:16.86,0:01:18.16,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:01:18.36,0:01:19.99,Default,,0,0,0,,Соңғы соққы, сиыр ханым!
Dialogue: 0,0:01:20.70,0:01:21.74,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:01:22.83,0:01:23.70,Default,,0,0,0,,Тыныш бол...
Dialogue: 0,0:01:24.00,0:01:26.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:30.21,0:01:31.84,Default,,0,0,0,,(Зұлымның ырылдауы)
Dialogue: 0,0:01:32.05,0:01:33.21,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:01:33.38,0:01:35.63,Default,,0,0,0,,Сен жолға түстің, жолдан кет! (Әпке) Кя!
Dialogue: 0,0:01:39.34,0:01:40.51,Default,,0,0,0,,Тория!
Dialogue: 0,0:01:44.72,0:01:47.10,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:01:48.94,0:01:51.98,Default,,0,0,0,,Қазір бәрі жақсы Неге?
Dialogue: 0,0:01:55.03,0:01:56.78,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:01:57.45,0:01:58.57,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:01:59.07,0:02:02.08,Default,,0,0,0,,Әй, ол кім? Теми
Dialogue: 0,0:02:02.74,0:02:06.87,Default,,0,0,0,,Жапониядан өтіп бара жатқан батыр
Dialogue: 0,0:02:07.12,0:02:11.88,Default,,0,0,0,,Ха, онда мен сені Жапонияға қайтарамын. Оны табытқа салыңыз.
Dialogue: 0,0:02:12.29,0:02:14.09,Default,,0,0,0,,Иә! Таааа
Dialogue: 0,0:02:19.59,0:02:20.97,Default,,0,0,0,,Кімді қайтару керек
Dialogue: 0,0:02:21.39,0:02:23.26,Default,,0,0,0,,...Не?
Dialogue: 0,0:02:24.35,0:02:25.85,Default,,0,0,0,,Тез қаш!
Dialogue: 0,0:02:27.56,0:02:29.60,Default,,0,0,0,,Сен тым алдасың, Тоши.
Dialogue: 0,0:02:32.52,0:02:34.36,Default,,0,0,0,,Ол қашып кетті. Менімен жүріңіз, Дэйв.
Dialogue: 0,0:02:34.48,0:02:37.53,Default,,0,0,0,,Ол әлі ойланбастан денесі қозғалатын жігіт.
Dialogue: 0,0:02:52.63,0:02:55.00,Default,,0,0,0,,Аники Артымнан көлік келе жатыр!
Dialogue: 0,0:02:55.34,0:02:56.88,Default,,0,0,0,,Қарғыс атқыр батыр!
Dialogue: 0,0:02:57.01,0:02:58.01,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:03:05.51,0:03:07.52,Default,,0,0,0,,Бұл не? Tsk...
Dialogue: 0,0:03:07.81,0:03:08.68,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:03:08.81,0:03:12.23,Default,,0,0,0,,Тоши мен колледжге кешігіп барамын. Тез бітірейік.
Dialogue: 0,0:03:12.56,0:03:14.65,Default,,0,0,0,,Менің айтқым келгені осы, Дэйв!
Dialogue: 0,0:03:17.32,0:03:19.90,Default,,0,0,0,,Мені жазалаңыз!
Dialogue: 0,0:03:20.03,0:03:24.24,Default,,0,0,0,,...
Dialogue: 0,0:03:27.08,0:03:28.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:29.41,0:03:30.41,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:33.25,0:03:34.21,Default,,0,0,0,,Ах
Dialogue: 0,0:03:41.17,0:03:43.05,Default,,0,0,0,,Соңында осы техникамен шешеміз
Dialogue: 0,0:03:43.18,0:03:44.14,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:03:44.39,0:03:46.97,Default,,0,0,0,,Дэйв Сіздің туған қалаңыздың атымен аталған...
Dialogue: 0,0:03:47.64,0:03:48.51,Default,,0,0,0,,Ято өледі
Dialogue: 0,0:03:48.93,0:03:50.48,Default,,0,0,0,,Калифорния…
Dialogue: 0,0:03:50.93,0:03:52.64,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:03:52.77,0:03:56.19,Default,,0,0,0,,Smash!
Dialogue: 0,0:04:08.41,0:04:11.75,Default,,0,0,0,,(үшінның күлкісі)
Dialogue: 0,0:04:11.87,0:04:13.54,Default,,0,0,0,,Бұл батыр кім?
Dialogue: 0,0:04:13.67,0:04:16.63,Default,,0,0,0,,Мен оны ешқашан көрмесем де (турист), бұл керемет
Dialogue: 0,0:04:17.17,0:04:19.63,Default,,0,0,0,,Ол Жапониядан келген алмасу студенті.
Dialogue: 0,0:04:20.30,0:04:22.88,Default,,0,0,0,,Батырдың аты «үшін мүмкін»
Dialogue: 0,0:04:24.47,0:04:25.72,Default,,0,0,0,,Ол Майт па?
Dialogue: 0,0:04:26.72,0:04:30.93,Default,,0,0,0,,Бір күні... жоқ, жақын арада, сөзсіз...
Dialogue: 0,0:04:31.64,0:04:34.39,Default,,0,0,0,,«Бейбітшілік символына» айналатын адам
Dialogue: 0,0:04:38.36,0:04:39.52,Default,,0,0,0,,Дэйвке рахмет
Dialogue: 0,0:04:40.11,0:04:43.57,Default,,0,0,0,,Сіз тіккен костюмнің арқасында кешікпедім.
Dialogue: 0,0:04:43.70,0:04:46.86,Default,,0,0,0,,Тезірек барайық. Егер кешігіп қалсақ, екеуміз де несиеден айырыламыз...
Dialogue: 0,0:04:46.99,0:04:50.79,Default,,0,0,0,,SFO UA857 SFO құрылғысында ұрлау орын алды...
Dialogue: 0,0:04:51.24,0:04:52.95,Default,,0,0,0,,Дэйв (Дэвид) Муча
Dialogue: 0,0:04:56.79,0:05:00.38,Default,,0,0,0,,Иә, сен маған көмектесе аласың ба?
Dialogue: 0,0:05:00.96,0:05:01.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:02.46,0:05:03.80,Default,,0,0,0,,Дэйв кеттік
Dialogue: 0,0:05:03.92,0:05:04.84,Default,,0,0,0,,О
Dialogue: 0,0:05:05.55,0:05:08.97,Default,,0,0,0,,Бірақ бұл қиын, батыр.
Dialogue: 0,0:05:09.97,0:05:14.02,Default,,0,0,0,,Хахахаха! Мен саған бүгін түскі ас сатып аламын.
Dialogue: 0,0:05:16.44,0:05:17.73,Default,,0,0,0,,Осылайша тәжірибеңіз артады және көпшіліктің назарын аударасыз
Dialogue: 0,0:05:17.98,0:05:20.73,Default,,0,0,0,,Бәрі мүмкін
Dialogue: 0,0:05:20.86,0:05:21.69,Default,,0,0,0,,Ha
Dialogue: 0,0:05:22.03,0:05:24.69,Default,,0,0,0,,Иә? Не болды, Мидорий бала?
Dialogue: 0,0:05:24.82,0:05:27.11,Default,,0,0,0,,Мен оны қазір көріп тұрмын.
Dialogue: 0,0:05:28.03,0:05:30.37,Default,,0,0,0,,Мұнда 10 мыңнан астам ғалымдар тұрады.
Dialogue: 0,0:05:30.49,0:05:33.91,Default,,0,0,0,,«I-Island» академиялық жасанды жылжымалы қала
Dialogue: 0,0:05:34.45,0:05:38.54,Default,,0,0,0,,Жазғы демалыста I-аралға ерте бару арман сияқты.
Dialogue: 0,0:05:38.67,0:05:42.80,Default,,0,0,0,,Сізді таң қалдыруға шақырған жөн болар.
Dialogue: 0,0:05:42.92,0:05:47.59,Default,,0,0,0,,Әй, бірақ мен сияқты біреудің келгені шынымен жақсы болды ма?
Dialogue: 0,0:05:47.72,0:05:49.55,Default,,0,0,0,,Ұстаудың қажеті жоқ.
Dialogue: 0,0:05:49.68,0:05:53.26,Default,,0,0,0,,Шақыру қағазында серік әкеле алатыным жазылған.
Dialogue: 0,0:05:53.77,0:05:56.14,Default,,0,0,0,,Серіктер әдетте отбасы мүшелері...
Dialogue: 0,0:05:56.77,0:06:01.48,Default,,0,0,0,,Мидория екеуміздің арамыздағы байланыс қаннан да күшті.
Dialogue: 0,0:06:02.27,0:06:04.78,Default,,0,0,0,,«Біреуі бәрі үшін» байланысымен
Dialogue: 0,0:06:04.90,0:06:05.74,Default,,0,0,0,,Иә
Dialogue: 0,0:06:05.86,0:06:07.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:07.61,0:06:08.95,Default,,0,0,0,,Бұл машина жақында келеді-
Dialogue: 0,0:06:09.07,0:06:11.66,Default,,0,0,0,,I-аралға қонуға дайындалыңыз.
Dialogue: 0,0:06:12.20,0:06:14.66,Default,,0,0,0,,Бұл әбден шаршатады.
Dialogue: 0,0:06:15.41,0:06:18.16,Default,,0,0,0,,Ақыр соңында, мен ол жерге жеткенде мен...
Dialogue: 0,0:06:19.21,0:06:21.88,Default,,0,0,0,,Бұлшық ет түрінде қалу керек.
Dialogue: 0,0:06:22.59,0:06:24.88,Default,,0,0,0,,Енді, Мидорий бала, сен де киіміңді ауыстыр.
Dialogue: 0,0:06:25.38,0:06:28.72,Default,,0,0,0,,Батыр костюмі Сіз мектепке құжат тапсырып, өзіңізбен бірге ала келгенсіз, солай ма?
Dialogue: 0,0:06:29.09,0:06:30.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:32.89,0:06:35.26,Default,,0,0,0,,Дүние жүзіндегі жалпы халықтың шамамен 80%-ы...
Dialogue: 0,0:06:35.39,0:06:39.27,Default,,0,0,0,,Біз қазір қандай да бір ерекше конституциясы бар адамнан тыс қоғамбыз.
Dialogue: 0,0:06:39.77,0:06:44.65,Default,,0,0,0,,Өзінің «жекелігін» теріс пайдаланатын жауыздармен күресіп, адамдарды қиындықтан құтқарыңыз.
Dialogue: 0,0:06:44.77,0:06:47.86,Default,,0,0,0,,«Батыр» мамандығы көпшіліктің назарында болды.
Dialogue: 0,0:06:49.11,0:06:51.32,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:06:51.45,0:06:54.28,Default,,0,0,0,,Қазір бәрі жақсы Неге?
Dialogue: 0,0:06:55.95,0:06:57.45,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:06:58.25,0:07:00.12,Default,,0,0,0,,Бұл өте керемет
Dialogue: 0,0:07:00.58,0:07:04.38,Default,,0,0,0,,Мен өзімнің жеке тұлғамды дамытатын болсам, мен осындай болғым келеді.
Dialogue: 0,0:07:05.13,0:07:06.67,Default,,0,0,0,,Бас тартқан дұрыс
Dialogue: 0,0:07:07.21,0:07:09.59,Default,,0,0,0,,Бірақ мен, Изуку Мидория
Dialogue: 0,0:07:09.72,0:07:12.68,Default,,0,0,0,,Ерекше тұлғасыз туған.
Dialogue: 0,0:07:12.80,0:07:16.39,Default,,0,0,0,,Батыр болсам деген арманымнан бас тартқалы тұр едім.
Dialogue: 0,0:07:17.27,0:07:19.23,Default,,0,0,0,,Менің өмірім осындай...
Dialogue: 0,0:07:19.35,0:07:20.85,Default,,0,0,0,,Бірінші нөмірлі батыр
Dialogue: 0,0:07:20.98,0:07:24.73,Default,,0,0,0,,Бүкіл Құдірет-пен тағдырлы кездесу бәрін өзгертеді.
Dialogue: 0,0:07:25.73,0:07:28.65,Default,,0,0,0,,Ерекшелігі жоқ батыр бола аласың ба?
Dialogue: 0,0:07:29.53,0:07:31.65,Default,,0,0,0,,Тіпті даралықсыз адамдар
Dialogue: 0,0:07:32.24,0:07:34.24,Default,,0,0,0,,Мен сен сияқты бола аламын ба?
Dialogue: 0,0:07:34.87,0:07:38.12,Default,,0,0,0,,Үздік кейіпкерлер артына мектеп кезіндегі анекдоттарды қалдырады.
Dialogue: 0,0:07:38.87,0:07:41.66,Default,,0,0,0,,Олардың көпшілігі әңгімелерін осылай аяқтайды.
Dialogue: 0,0:07:42.42,0:07:46.29,Default,,0,0,0,,«Менің денем ойланбай тұрып қозғалды».
Dialogue: 0,0:07:46.59,0:07:49.38,Default,,0,0,0,,Качан! (Кацуки) Неге?
Dialogue: 0,0:07:51.26,0:07:55.14,Default,,0,0,0,,Сіз көмек сұрап тұрған сияқтысыз.
Dialogue: 0,0:07:56.89,0:08:00.18,Default,,0,0,0,,Сіз батыр бола аласыз
Dialogue: 0,0:08:01.14,0:08:04.56,Default,,0,0,0,,Бала, мен саған шындықты айтайын
Dialogue: 0,0:08:05.86,0:08:09.98,Default,,0,0,0,,Менің даралығым маған шырақтай өтті.
Dialogue: 0,0:08:10.74,0:08:15.95,Default,,0,0,0,,Билікті беру құдіреті Бұл маған мұраға қалған тұлға
Dialogue: 0,0:08:17.58,0:08:21.04,Default,,0,0,0,,Берілген атау: «Біреуі бәрі үшін»
Dialogue: 0,0:08:21.75,0:08:24.92,Default,,0,0,0,,Ережелер қарапайым
Dialogue: 0,0:08:25.50,0:08:30.17,Default,,0,0,0,,Бір адам билікті дамытады және сол билікті екінші адамға береді.
Dialogue: 0,0:08:30.30,0:08:32.47,Default,,0,0,0,,♬~
Dialogue: 0,0:08:33.34,0:08:38.35,Default,,0,0,0,,Көмекке шақырған дауыс пен Джиюдің жүрегі осылай айналды...
Dialogue: 0,0:08:38.55,0:08:39.93,Default,,0,0,0,,қуаттың кристалдануы
Dialogue: 0,0:08:40.68,0:08:45.31,Default,,0,0,0,,Иә, енді сіздің кезегіңіз.
Dialogue: 0,0:08:46.23,0:08:47.73,Default,,0,0,0,,Бүкіл Құдірет тұлғасы―
Dialogue: 0,0:08:48.06,0:08:50.36,Default,,0,0,0,,«Біреуі бәрі үшін» мұрагері болдым.
Dialogue: 0,0:08:50.61,0:08:55.74,Default,,0,0,0,,Юэй орта мектебінің қаһарман бөліміне түсіп, қайтадан арманына қарай жүгіре бастайды
Dialogue: 0,0:08:56.20,0:09:00.70,Default,,0,0,0,,Кез келген қиындыққа қарсы тұрып, күлімдеп, адамдарға көмектесу...
Dialogue: 0,0:09:01.16,0:09:03.54,Default,,0,0,0,,Ең жақсы кейіпкер бол
Dialogue: 0,0:09:09.38,0:09:11.59,Default,,0,0,0,,Иммиграциялық тексеру қазір басталады.
Dialogue: 0,0:09:14.13,0:09:16.09,Default,,0,0,0,,Мидорий балаға сұрақ
Dialogue: 0,0:09:16.22,0:09:18.80,Default,,0,0,0,,Бұл жасанды арал не үшін жасалды?
Dialogue: 0,0:09:18.93,0:09:20.14,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:20.26,0:09:21.81,Default,,0,0,0,,Дүние жүзінен таланттарды жинау
Dialogue: 0,0:09:21.93,0:09:25.69,Default,,0,0,0,,Даралыққа зерттеу жүргізу, қаһармандық заттарды ойлап табу және т.б.
Dialogue: 0,0:09:26.10,0:09:27.65,Default,,0,0,0,,Бұл аралды жылжытуға болады
Dialogue: 0,0:09:27.77,0:09:30.94,Default,,0,0,0,,Зерттеу нәтижелері мен ғалымдарды зұлым адамдардан қорғау.
Dialogue: 0,0:09:31.07,0:09:32.15,Default,,0,0,0,,Қауіпсіздік жүйесі -
Dialogue: 0,0:09:32.28,0:09:34.40,Default,,0,0,0,,«Татарусқа» баламалы қабілеттерге ие
Dialogue: 0,0:09:34.53,0:09:36.45,Default,,0,0,0,,Осы уақытқа дейін жауыздың жасаған қылмысы болған емес...
Dialogue: 0,0:09:36.74,0:09:39.41,Default,,0,0,0,,Сіз бұл туралы көп нәрсені білесіз!
Dialogue: 0,0:09:40.87,0:09:42.70,Default,,0,0,0,,Иммиграциялық тексеру аяқталды
Dialogue: 0,0:09:43.29,0:09:44.87,Default,,0,0,0,,Қазіргі уақытта I аралында
Dialogue: 0,0:09:45.00,0:09:48.21,Default,,0,0,0,,Әртүрлі зерттеулер мен тәжірибелік-конструкторлық жұмыстардың нәтижелерін көрсететін көрме.
Dialogue: 0,0:09:48.62,0:09:50.84,Default,,0,0,0,,«I Expo» көрмесінің алдын ала ашылуы жүріп жатыр.
Dialogue: 0,0:09:50.96,0:09:54.13,Default,,0,0,0,,Шақыруыңыз болса, келіңіз.
Dialogue: 0,0:09:55.21,0:09:56.67,Default,,0,0,0,,Уау
Dialogue: 0,0:10:02.93,0:10:05.39,Default,,0,0,0,,Көпшілік алдында ашылғанда -
Dialogue: 0,0:10:05.52,0:10:07.64,Default,,0,0,0,,Келушілердің көп екеніне сене алар емеспін...
Dialogue: 0,0:10:07.89,0:10:10.65,Default,,0,0,0,,Сіз оны шынымен көргенде шынымен таң қалдырады!
Dialogue: 0,0:10:11.19,0:10:15.28,Default,,0,0,0,,Жапониядан айырмашылығы, I-Island сіздің даралығыңызды пайдалана алады.
Dialogue: 0,0:10:15.94,0:10:18.82,Default,,0,0,0,,Павильонда даралықты пайдаланатын көптеген аттракциондар бар сияқты.
Dialogue: 0,0:10:19.45,0:10:20.78,Default,,0,0,0,,Оны кейінірек көруге болады.
Dialogue: 0,0:10:20.91,0:10:21.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:22.12,0:10:24.33,Default,,0,0,0,,Енді қонақүй қайда... (Ұялы телефон жұмысының дыбысы)
Dialogue: 0,0:10:24.45,0:10:26.33,Default,,0,0,0,,I-Expo көрмесіне қош келдіңіз!
Dialogue: 0,0:10:26.58,0:10:29.21,Default,,0,0,0,,...О, Бүкіл Құдірет?
Dialogue: 0,0:10:29.62,0:10:30.67,Default,,0,0,0,,Ол Майт па?
Dialogue: 0,0:10:30.79,0:10:32.13,Default,,0,0,0,,Бірінші кейіпкер?
Dialogue: 0,0:10:32.54,0:10:34.25,Default,,0,0,0,,Бұл нағыз, керемет!
Dialogue: 0,0:10:34.38,0:10:35.17,Default,,0,0,0,,(үшінның күлкісі)
Dialogue: 0,0:10:35.17,0:10:36.88,Default,,0,0,0,,(үшінның күлкісі)
Dialogue: 0,0:10:35.17,0:10:36.88,Default,,0,0,0,,Бір сөзіңізді өтінемін!
Dialogue: 0,0:10:37.17,0:10:39.34,Default,,0,0,0,,Жылы қарсы алғаныңызға рахмет.
Dialogue: 0,0:10:39.47,0:10:41.39,Default,,0,0,0,,Тәртіпке кіруіңізді сұраймыз!
Dialogue: 0,0:10:45.64,0:10:48.48,Default,,0,0,0,,Онда тұрып қалу үшін...
Dialogue: 0,0:10:48.60,0:10:51.48,Default,,0,0,0,,Мен кездесуге кешігіп қалдым.
Dialogue: 0,0:10:51.60,0:10:52.44,Default,,0,0,0,,Тіпті ұйықтап қалғаннан кейін де, кем дегенде—
Dialogue: 0,0:10:52.56,0:10:57.44,Default,,0,0,0,,Аа, мен ұзақ уақыттан кейін ескі досыммен қайта қосылғым келді.
Dialogue: 0,0:10:57.57,0:10:59.90,Default,,0,0,0,,Кешіріңіз, бірақ менімен біраз уақыт араласа аласыз ба?
Dialogue: 0,0:11:00.20,0:11:02.37,Default,,0,0,0,,Бүкіл Құдірет-тың ең жақсы досы...
Dialogue: 0,0:11:02.49,0:11:03.91,Default,,0,0,0,,Әрине, ықыласпен
Dialogue: 0,0:11:04.28,0:11:07.95,Default,,0,0,0,,Оның жеке басын «үшін үшін» немесе Мидорияға ауыстыру тарихы жоқ.
Dialogue: 0,0:11:08.08,0:11:10.21,Default,,0,0,0,,Мен бұл туралы айтқан жоқпын, сондықтан айтқым келгені осы.
Dialogue: 0,0:11:10.41,0:11:12.88,Default,,0,0,0,,Сіз мұны ең жақын досыңыздан да құпия ұстайсыз ба?
Dialogue: 0,0:11:13.25,0:11:15.50,Default,,0,0,0,,үшін үшін Біреуінің сырын білетіндерге
Dialogue: 0,0:11:15.63,0:11:17.63,Default,,0,0,0,,Қауіптер бар.
Dialogue: 0,0:11:18.01,0:11:21.30,Default,,0,0,0,,Түсіндім, дұрыс...
Dialogue: 0,0:11:21.55,0:11:25.18,Default,,0,0,0,,Біреуі бәрі үшін - бұл маңызды құпия.
Dialogue: 0,0:11:25.89,0:11:26.89,Default,,0,0,0,,(Декү) Кешір мені (Каири) Ах…
Dialogue: 0,0:11:27.43,0:11:31.89,Default,,0,0,0,,Менен «үшін үшін Бірді» мұра еткендер бір күні үлкен зұлымдыққа айналады...
Dialogue: 0,0:11:32.69,0:11:36.40,Default,,0,0,0,,Маған "Бәрі бір үшін" қарсы тұру жазылды.
Dialogue: 0,0:11:37.11,0:11:40.28,Default,,0,0,0,,Иә, сол кезге де И
Dialogue: 0,0:11:40.40,0:11:44.87,Default,,0,0,0,,Мен мүмкіндігінше тезірек үшін үшін Біреу бағдарламасын меңгеруім керек!
Dialogue: 0,0:11:48.08,0:11:49.33,Default,,0,0,0,,Ах... (үшін мүмкін) Иә?
Dialogue: 0,0:11:49.45,0:11:50.29,Default,,0,0,0,,Ах
Dialogue: 0,0:11:50.54,0:11:53.00,Default,,0,0,0,,Ағай
Dialogue: 0,0:11:53.87,0:11:55.88,Default,,0,0,0,,Майт ағай! (үшін мүмкін) Хахахаха!
Dialogue: 0,0:11:56.00,0:11:57.59,Default,,0,0,0,,О, Мелисса!
Dialogue: 0,0:11:57.92,0:12:01.22,Default,,0,0,0,,Біраз уақыт өтті. Мен сенің келгеніңе қуаныштымын.
Dialogue: 0,0:12:01.63,0:12:04.01,Default,,0,0,0,,Шақырғаныңызға рахмет.
Dialogue: 0,0:12:04.14,0:12:07.89,Default,,0,0,0,,Бірақ мен қателесіппін. Ол қазірдің өзінде ересек әйел.
Dialogue: 0,0:12:08.26,0:12:09.93,Default,,0,0,0,,Мен 17 жасқа толдым
Dialogue: 0,0:12:10.06,0:12:12.10,Default,,0,0,0,,Бұрынғыдан да ауыр, солай емес пе?
Dialogue: 0,0:12:12.23,0:12:13.77,Default,,0,0,0,,Не, не, не!
Dialogue: 0,0:12:13.89,0:12:15.65,Default,,0,0,0,,(Мелисса мен Баршаның күлкісі)
Dialogue: 0,0:12:16.40,0:12:19.32,Default,,0,0,0,,Мен қуаныштымын, Майт ағай бұрынғыдай жақсы болып жатқан сияқты...
Dialogue: 0,0:12:20.03,0:12:22.86,Default,,0,0,0,,Бұл адам Бүкіл Құдірет-тың ең жақын досы ма?
Dialogue: 0,0:12:22.99,0:12:24.57,Default,,0,0,0,,Сол жаста...
Dialogue: 0,0:12:24.70,0:12:26.28,Default,,0,0,0,,Бұл тұлға ма?
Dialogue: 0,0:12:26.62,0:12:28.62,Default,,0,0,0,,А, Дэйв қайда?
Dialogue: 0,0:12:28.74,0:12:31.12,Default,,0,0,0,,Хехе... Мен зертханадамын.
Dialogue: 0,0:12:31.54,0:12:34.42,Default,,0,0,0,,Көп жылдар бойы жүргізген зерттеулерім тоқтап қалған сияқты.
Dialogue: 0,0:12:34.54,0:12:36.54,Default,,0,0,0,,Сонымен, мерекелік және тосын сый ретінде.
Dialogue: 0,0:12:36.67,0:12:39.21,Default,,0,0,0,,Мен Майт ағайды осы аралға шақырдым.
Dialogue: 0,0:12:39.34,0:12:41.34,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:12:41.46,0:12:44.09,Default,,0,0,0,,Айтпақшы, Дэйв бұл жолы қандай зерттеу жүргізді?
Dialogue: 0,0:12:44.22,0:12:46.01,Default,,0,0,0,,Себебі құпиялылық міндеті бар...
Dialogue: 0,0:12:46.14,0:12:48.05,Default,,0,0,0,,Сіз маған айтпайсыз
Dialogue: 0,0:12:48.18,0:12:50.14,Default,,0,0,0,,Ғалымдарға да қиын.
Dialogue: 0,0:12:50.56,0:12:54.52,Default,,0,0,0,,Аа, Мидорий бала, ол менің ең жақын досымның қызы...
Dialogue: 0,0:12:55.23,0:12:58.11,Default,,0,0,0,,Менің атым Мелисса Шилдс. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:12:58.36,0:13:00.52,Default,,0,0,0,,Аа, сіз осылай айтып тұрсыз...
Dialogue: 0,0:13:00.69,0:13:01.53,Default,,0,0,0,,Не? (үшін мүмкін) Иә?
Dialogue: 0,0:13:01.65,0:13:03.94,Default,,0,0,0,,А, жоқ, а...
Dialogue: 0,0:13:04.53,0:13:05.99,Default,,0,0,0,,... Танысқаныма қуаныштымын.
Dialogue: 0,0:13:06.53,0:13:10.24,Default,,0,0,0,,Менің атым Изуку Мидория, Юэй орта мектебінің батырлар бөлімінің бірінші курс студенті.
Dialogue: 0,0:13:10.78,0:13:14.25,Default,,0,0,0,,Юэй орта мектебі... Сонда Майт ағайдың ба?
Dialogue: 0,0:13:14.37,0:13:15.79,Default,,0,0,0,,Иә, мен студентпін.
Dialogue: 0,0:13:15.92,0:13:17.63,Default,,0,0,0,,Болашақ батырға үміткер
Dialogue: 0,0:13:18.38,0:13:21.59,Default,,0,0,0,,Керемет, сіз Майт ағайдың шәкіртісіз.
Dialogue: 0,0:13:21.71,0:13:23.21,Default,,0,0,0,,Болашақ болашағы зор.
Dialogue: 0,0:13:23.34,0:13:26.76,Default,,0,0,0,,Жоқ, мен әлі жаттығудамын, дәлірек айтсақ...
Dialogue: 0,0:13:27.22,0:13:28.64,Default,,0,0,0,,Сіздің мінезіңіз қандай?
Dialogue: 0,0:13:28.76,0:13:30.18,Default,,0,0,0,,Па... Бұл қуат түрі.
Dialogue: 0,0:13:30.85,0:13:34.27,Default,,0,0,0,,Салқын, бірақ ортодоксалды дизайн.
Dialogue: 0,0:13:34.89,0:13:37.06,Default,,0,0,0,,Мен де көмекші заттарды таба алмаймын.
Dialogue: 0,0:13:37.19,0:13:38.90,Default,,0,0,0,,Tch… жақын!
Dialogue: 0,0:13:37.19,0:13:38.90,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:13:39.23,0:13:40.15,Default,,0,0,0,,Ах
Dialogue: 0,0:13:41.48,0:13:44.61,Default,,0,0,0,,Костюм Оны жақсарту керек...
Dialogue: 0,0:13:44.86,0:13:47.20,Default,,0,0,0,,О! Мелисса, уақыт келді
Dialogue: 0,0:13:47.32,0:13:50.49,Default,,0,0,0,,Ах! Кешіріңіз, мен жай ғана қызып кеттім.
Dialogue: 0,0:13:51.49,0:13:54.70,Default,,0,0,0,,Мен әкемді тезірек қуантуым керек.
Dialogue: 0,0:13:55.37,0:13:58.21,Default,,0,0,0,,Бұл Майт ағай.
Dialogue: 0,0:13:58.54,0:14:00.04,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:14:01.67,0:14:04.71,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:14:06.22,0:14:08.84,Default,,0,0,0,,Мен алаңға еш қиындықсыз кірдім.
Dialogue: 0,0:14:08.97,0:14:11.05,Default,,0,0,0,,Сонымен заттар қашан келеді?
Dialogue: 0,0:14:11.18,0:14:14.52,Default,,0,0,0,,Оны сағат 15.00-де 66-қақпадан алыңыз.
Dialogue: 0,0:14:14.64,0:14:16.02,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:14:16.85,0:14:17.89,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:14:26.49,0:14:28.95,Default,,0,0,0,,Dr.
Dialogue: 0,0:14:29.70,0:14:31.74,Default,,0,0,0,,Доктор Дэвид (Дэвид) Иә?
Dialogue: 0,0:14:32.58,0:14:34.87,Default,,0,0,0,,Мен мұнда тазалауды аяқтадым.
Dialogue: 0,0:14:35.24,0:14:37.71,Default,,0,0,0,,Түсіндім, еңбегіңіз үшін рахмет, Сэм.
Dialogue: 0,0:14:38.79,0:14:42.00,Default,,0,0,0,,Неге анда-санда қызыңызбен түскі асқа бармайсыз?
Dialogue: 0,0:14:42.13,0:14:44.25,Default,,0,0,0,,Мен де бүгін академияға барамын.
Dialogue: 0,0:14:44.38,0:14:46.88,Default,,0,0,0,,I-Expo кезінде мектеп жабық емес пе?
Dialogue: 0,0:14:47.01,0:14:49.17,Default,,0,0,0,,Мен өз бетімше зерттеу жүргіземін.
Dialogue: 0,0:14:49.51,0:14:52.80,Default,,0,0,0,,Әкесінің қызы ғой, сондықтан ұқсаймыз.
Dialogue: 0,0:14:53.10,0:14:54.22,Default,,0,0,0,,Мелисса
Dialogue: 0,0:14:54.35,0:14:56.10,Default,,0,0,0,,Сәлеметсіз бе, жас ханым.
Dialogue: 0,0:14:56.22,0:14:58.02,Default,,0,0,0,,Сәлем Сэм
Dialogue: 0,0:14:58.23,0:15:01.94,Default,,0,0,0,,Үнемі ізденіспен айналысатын әкеме қамқорлық көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:15:02.06,0:15:04.02,Default,,0,0,0,,Ахаха (Дәуіт) О, Құдайым
Dialogue: 0,0:15:04.73,0:15:06.65,Default,,0,0,0,,Сонымен қатар, сен мұнда не үшін келдің?
Dialogue: 0,0:15:06.78,0:15:10.11,Default,,0,0,0,,Бұл менмін, әкемнің зерттеуінің аяқталуын тойлау үшін.
Dialogue: 0,0:15:10.24,0:15:12.16,Default,,0,0,0,,Мен біреуге шақыру жібердім
Dialogue: 0,0:15:12.49,0:15:13.66,Default,,0,0,0,,Біреу?
Dialogue: 0,0:15:13.78,0:15:15.83,Default,,0,0,0,,Әкемнің сүйікті адамы
Dialogue: 0,0:15:15.95,0:15:16.74,Default,,0,0,0,,Ах
Dialogue: 0,0:15:16.87,0:15:22.04,Default,,0,0,0,,Қосылу сезімінен дірілдеп келдім!
Dialogue: 0,0:15:22.83,0:15:25.88,Default,,0,0,0,,Toshi Бүкіл Құдірет...
Dialogue: 0,0:15:26.71,0:15:28.13,Default,,0,0,0,,Хмм... шынымен бе?
Dialogue: 0,0:15:28.26,0:15:30.09,Default,,0,0,0,,сол әйелдің еркі еді, иә?
Dialogue: 0,0:15:30.38,0:15:33.05,Default,,0,0,0,,Мен сені көру үшін келдім, Дэйв!
Dialogue: 0,0:15:33.68,0:15:35.26,Default,,0,0,0,,Сіз қалай таң қалдыңыз?
Dialogue: 0,0:15:36.22,0:15:38.06,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:15:38.93,0:15:40.81,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:15:41.39,0:15:43.81,Default,,0,0,0,,Мелиссаға екеуміз де рахмет айтамыз.
Dialogue: 0,0:15:43.94,0:15:45.69,Default,,0,0,0,,Бірақ неше жыл бұрын?
Dialogue: 0,0:15:45.81,0:15:47.07,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:15:47.19,0:15:49.65,Default,,0,0,0,,Екеуің де жыл туралы ойлағыларың келмейді.
Dialogue: 0,0:15:49.78,0:15:52.36,Default,,0,0,0,,Ахаха! Мен келісемін (Дэвид) Хахаха...
Dialogue: 0,0:15:53.95,0:15:56.24,Default,,0,0,0,,Танысқаныма қуаныштымын Дэйв.
Dialogue: 0,0:15:57.41,0:15:59.45,Default,,0,0,0,,Мен де, Бәрі мүмкін.
Dialogue: 0,0:16:00.58,0:16:01.71,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:16:02.29,0:16:04.58,Default,,0,0,0,,Мидория баламен таныстырайық.
Dialogue: 0,0:16:04.71,0:16:06.88,Default,,0,0,0,,Менің ең жақын досым Дэвид Шилдс...
Dialogue: 0,0:16:07.00,0:16:09.67,Default,,0,0,0,,Мен доктор Дэвид Шилдсті білемін!
Dialogue: 0,0:16:09.80,0:16:12.76,Default,,0,0,0,,Жеке тұлғаны зерттеу бойынша Нобель сыйлығын жеңіп алған үздік жүгіруші
Dialogue: 0,0:16:13.26,0:16:15.43,Default,,0,0,0,,Бүкіл Құдірет-тың американдық күндеріндегі серіктесі.
Dialogue: 0,0:16:15.55,0:16:17.43,Default,,0,0,0,,Бүкіл Құдірет's Hero костюмі
Dialogue: 0,0:16:18.26,0:16:19.18,Default,,0,0,0,,Жас шақ
Dialogue: 0,0:16:19.68,0:16:20.93,Default,,0,0,0,,Қола дәуірі
Dialogue: 0,0:16:21.68,0:16:22.81,Default,,0,0,0,,Күміс дәуірі
Dialogue: 0,0:16:23.69,0:16:26.48,Default,,0,0,0,,Ал... Алтын ғасыр!
Dialogue: 0,0:16:26.77,0:16:29.32,Default,,0,0,0,,Олардың барлығын жасаған данышпан өнертапқыш
Dialogue: 0,0:16:29.44,0:16:31.36,Default,,0,0,0,,Мен ешқашан шынайы нәрсені кездестіремін деп ойламадым.
Dialogue: 0,0:16:31.49,0:16:32.99,Default,,0,0,0,,Мен қатты әсер алдым!
Dialogue: 0,0:16:33.49,0:16:35.45,Default,,0,0,0,,Ахх... Ухуху
Dialogue: 0,0:16:36.20,0:16:37.74,Default,,0,0,0,,Кіріспе қажет емес сияқты.
Dialogue: 0,0:16:37.87,0:16:40.16,Default,,0,0,0,,Ха, кешіріңіз, бірдеңе.
Dialogue: 0,0:16:40.29,0:16:41.79,Default,,0,0,0,,Жоқ, маңызды емес.
Dialogue: 0,0:16:42.29,0:16:43.37,Default,,0,0,0,,(Барлық мүмкін жөтел)
Dialogue: 0,0:16:43.66,0:16:44.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:46.29,0:16:48.38,Default,,0,0,0,,Менің Бүкіл Құдірет-пен қайта кездескеніме көп уақыт болды.
Dialogue: 0,0:16:49.04,0:16:51.42,Default,,0,0,0,,Кешіріңіз, жинақтау туралы айтуға рұқсат ете аласыз ба?
Dialogue: 0,0:16:51.67,0:16:52.97,Default,,0,0,0,,Иә
Dialogue: 0,0:16:53.09,0:16:57.18,Default,,0,0,0,,Мелисса: I-Expo айналасында Мидория-кунды көрсетіңіз.
Dialogue: 0,0:16:57.30,0:16:58.76,Default,,0,0,0,,Түсіндім, әке.
Dialogue: 0,0:16:58.89,0:17:00.06,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:17:00.43,0:17:03.56,Default,,0,0,0,,Болашақ кейіпкерлерімізбен бірге жұмыс істеу үлкен мәртебе.
Dialogue: 0,0:17:03.68,0:17:04.52,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:04.64,0:17:06.65,Default,,0,0,0,,Цуки… Цуки…
Dialogue: 0,0:17:06.77,0:17:07.94,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:17:08.23,0:17:09.98,Default,,0,0,0,,Сэм Ах...
Dialogue: 0,0:17:10.11,0:17:11.82,Default,,0,0,0,,Сіз де, қазір демалыңыз.
Dialogue: 0,0:17:13.49,0:17:15.57,Default,,0,0,0,,Мен сені қалай атаймын?
Dialogue: 0,0:17:15.70,0:17:18.07,Default,,0,0,0,,Мидория-кун? Изуку-кун?
Dialogue: 0,0:17:18.20,0:17:19.20,Default,,0,0,0,,Мен туралы...
Dialogue: 0,0:17:21.91,0:17:23.08,Default,,0,0,0,,Мені Деку деп атаңыз
Dialogue: 0,0:17:23.66,0:17:26.92,Default,,0,0,0,,Деку? Бұл біртүрлі лақап ат
Dialogue: 0,0:17:27.21,0:17:29.21,Default,,0,0,0,,Мен Мелиссамен жақсымын.
Dialogue: 0,0:17:29.75,0:17:31.30,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:32.34,0:17:33.26,Default,,0,0,0,,(Барлық мүмкін жөтел)
Dialogue: 0,0:17:33.38,0:17:35.17,Default,,0,0,0,,Эй, жақсысың ба? Тоши
Dialogue: 0,0:17:36.59,0:17:37.80,Default,,0,0,0,,(Нацуки Субару) Ол қыз неге мұнда? Әлі күндізгі уақыт қой.
Dialogue: 0,0:17:37.93,0:17:41.18,Default,,0,0,0,,Бұлшықет формасын сақтау уақыты одан да аз...
Dialogue: 0,0:17:41.56,0:17:45.39,Default,,0,0,0,,Мен симптомдар туралы электрондық пошта арқылы білдім, бірақ оның мұндай нашар болатынын ешқашан күткен емеспін.
Dialogue: 0,0:17:45.52,0:17:47.35,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:17:52.90,0:17:54.57,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:17:55.03,0:17:58.53,Default,,0,0,0,,Осыған қарап, мен бұл жасанды арал екеніне сене алар емеспін.
Dialogue: 0,0:17:59.11,0:18:01.91,Default,,0,0,0,,Үлкен қалада барлық жағдай бар.
Dialogue: 0,0:18:02.03,0:18:04.41,Default,,0,0,0,,Менің қолымнан келмейтін жалғыз нәрсе - саяхаттау.
Dialogue: 0,0:18:04.54,0:18:05.95,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:18:06.08,0:18:08.12,Default,,0,0,0,,Мұндағы ғалымдар мен олардың отбасылары...
Dialogue: 0,0:18:08.25,0:18:10.67,Default,,0,0,0,,Ақпараттың ағып кетуіне жол бермеу Себебі құпиялылық міндеті бар
Dialogue: 0,0:18:10.96,0:18:12.04,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:18:12.29,0:18:13.21,Default,,0,0,0,,(Годзироның айқайы)
Dialogue: 0,0:18:13.34,0:18:16.01,Default,,0,0,0,,Кайдзю батыры Годзиро!
Dialogue: 0,0:18:16.42,0:18:18.43,Default,,0,0,0,,Мен шынайы нәрсені бірінші рет көріп тұрмын.
Dialogue: 0,0:18:18.55,0:18:20.14,Default,,0,0,0,,Таңғажайып даралық
Dialogue: 0,0:18:20.26,0:18:23.64,Default,,0,0,0,,Сізді демеуші компания шақырды.
Dialogue: 0,0:18:24.26,0:18:27.02,Default,,0,0,0,,Соңғы заттардың көрсетілімі, қолтаңба сессиялары және т.б.
Dialogue: 0,0:18:27.23,0:18:29.27,Default,,0,0,0,,Түрлі оқиғалар болып жатқан сияқты.
Dialogue: 0,0:18:29.39,0:18:30.98,Default,,0,0,0,,I Expo көрмесінен күткендей!
Dialogue: 0,0:18:31.48,0:18:34.15,Default,,0,0,0,,Кешке байланысты тараптарға арналған кеш болды.
Dialogue: 0,0:18:34.27,0:18:40.16,Default,,0,0,0,,...Деку-кун да қатысады, солай ма? Ол Майт ағайдың серігі.
Dialogue: 0,0:18:40.53,0:18:43.41,Default,,0,0,0,,Бүкіл Құдірет маған салтанатты киім алып келуімді айтты.
Dialogue: 0,0:18:43.53,0:18:44.95,Default,,0,0,0,,Осы себепті болды ма?
Dialogue: 0,0:18:45.08,0:18:46.50,Default,,0,0,0,,Ах, Деку-кун.
Dialogue: 0,0:18:47.08,0:18:49.41,Default,,0,0,0,,Мен де сол павильонды ұсынамын.
Dialogue: 0,0:18:50.42,0:18:53.71,Default,,0,0,0,,Көптеген жаңа кейіпкер элементтері!
Dialogue: 0,0:18:54.00,0:18:55.63,Default,,0,0,0,,Деку-кун, қарашы, қарашы!
Dialogue: 0,0:18:55.75,0:18:57.17,Default,,0,0,0,,Бұл жан-жақты бигл
Dialogue: 0,0:18:57.30,0:19:00.30,Default,,0,0,0,,Ол ұшуға ғана емес, су астындағы әрекетке де қабілетті.
Dialogue: 0,0:19:00.43,0:19:01.55,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:19:01.68,0:19:03.10,Default,,0,0,0,,Бұл сүңгуір костюмі-
Dialogue: 0,0:19:03.43,0:19:06.06,Default,,0,0,0,,7000 метрге дейінгі тереңдікке төтеп бере алады
Dialogue: 0,0:19:06.18,0:19:07.18,Default,,0,0,0,,Терең!
Dialogue: 0,0:19:07.56,0:19:11.69,Default,,0,0,0,,Бұл көзілдіріктерде 36 түрлі сенсорлар орнатылған.
Dialogue: 0,0:19:11.81,0:19:13.31,Default,,0,0,0,,Тым көрінетін!
Dialogue: 0,0:19:14.40,0:19:16.53,Default,,0,0,0,,Негізінде, заттардың көпшілігі ...
Dialogue: 0,0:19:16.65,0:19:19.57,Default,,0,0,0,,Бұл менің әкем ойлап тапқан патентке негізделген.
Dialogue: 0,0:19:19.90,0:19:22.24,Default,,0,0,0,,Иә, бұл керемет.
Dialogue: 0,0:19:22.36,0:19:24.70,Default,,0,0,0,,Мұндағы әрбір элемент
Dialogue: 0,0:19:24.83,0:19:28.45,Default,,0,0,0,,Дүние жүзіндегі батырларға табысқа жетуге көмектесу
Dialogue: 0,0:19:29.50,0:19:32.12,Default,,0,0,0,,Сіз әкеңізді сыйлайсыз, солай ма?
Dialogue: 0,0:19:33.17,0:19:36.17,Default,,0,0,0,,Менің арманым әкем сияқты ғалым болу.
Dialogue: 0,0:19:37.25,0:19:39.46,Default,,0,0,0,,Ой, енді ойлап қарасам, бұл Мелисса екен.
Dialogue: 0,0:19:39.59,0:19:41.05,Default,,0,0,0,,Мұндағы академия...
Dialogue: 0,0:19:41.18,0:19:43.05,Default,,0,0,0,,Иә, қазір 3 жыл
Dialogue: 0,0:19:43.18,0:19:45.22,Default,,0,0,0,,I. Арал академиясы
Dialogue: 0,0:19:45.35,0:19:48.56,Default,,0,0,0,,Бұл бүкіл дүние жүзіндегі ізденімпаз ғалымдардың арман мектебі емес пе?
Dialogue: 0,0:19:49.10,0:19:51.44,Default,,0,0,0,,Менің әлі алда көп жолым бар
Dialogue: 0,0:19:52.14,0:19:54.40,Default,,0,0,0,,Маған көбірек оқу керек
Dialogue: 0,0:19:56.40,0:19:59.48,Default,,0,0,0,,Бүкіл Құдірет сияқты болу
Dialogue: 0,0:19:59.61,0:20:01.15,Default,,0,0,0,,Мен көбірек тырысуым керек
Dialogue: 0,0:20:02.65,0:20:05.99,Default,,0,0,0,,Деку-кун, сен Майт ағаны шынымен жақсы көресің.
Dialogue: 0,0:20:06.12,0:20:08.41,Default,,0,0,0,,Мен бұрын таң қалдым.
Dialogue: 0,0:20:08.54,0:20:11.91,Default,,0,0,0,,А, кешіріңіз, бұл әдет...
Dialogue: 0,0:20:12.04,0:20:13.42,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:20:13.54,0:20:15.58,Default,,0,0,0,,Көңілді сияқты, Деку-кун.
Dialogue: 0,0:20:15.71,0:20:19.21,Default,,0,0,0,,А... Урарака-сан, сен неге келдің?
Dialogue: 0,0:20:19.67,0:20:20.96,Default,,0,0,0,,Көңілді сияқты
Dialogue: 0,0:20:21.09,0:20:22.09,Default,,0,0,0,,Мен екі рет айттым!
Dialogue: 0,0:20:22.34,0:20:23.80,Default,,0,0,0,,Гохон Ах...
Dialogue: 0,0:20:24.09,0:20:25.43,Default,,0,0,0,,Яойорозу-сан?
Dialogue: 0,0:20:25.55,0:20:27.72,Default,,0,0,0,,Бұл өте қызық сияқты болды.
Dialogue: 0,0:20:27.85,0:20:30.18,Default,,0,0,0,,Мидория Мен естідім.
Dialogue: 0,0:20:30.31,0:20:32.81,Default,,0,0,0,,Джироның қорқынышты құлаққап ұясы!
Dialogue: 0,0:20:33.31,0:20:34.39,Default,,0,0,0,,Достар?
Dialogue: 0,0:20:34.52,0:20:38.52,Default,,0,0,0,,Мектептегі сыныптастарым арасында түсініспеушілік болған сияқты...
Dialogue: 0,0:20:38.77,0:20:43.32,Default,,0,0,0,,А-а-а... Мен жай ғана Мелиссадан маған өтетін жерді көрсетуін өтінемін.
Dialogue: 0,0:20:43.45,0:20:45.74,Default,,0,0,0,,Дұрыс, менің әкем мен ағам мүмкін...
Dialogue: 0,0:20:45.86,0:20:46.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:47.03,0:20:48.03,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:20:48.16,0:20:50.20,Default,,0,0,0,,Менің «үшінның» серігі екенім...
Dialogue: 0,0:20:50.33,0:20:51.58,Default,,0,0,0,,Оны құпия сақтаңыз
Dialogue: 0,0:20:51.70,0:20:52.79,Default,,0,0,0,,Уа... неге?
Dialogue: 0,0:20:52.91,0:20:55.29,Default,,0,0,0,,Әртүрлі жағдайлар бар.
Dialogue: 0,0:20:55.54,0:20:56.96,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:20:58.34,0:21:00.88,Default,,0,0,0,,Қарсы болмасаңыз, кафеде шай ішуді қалайсыз ба?
Dialogue: 0,0:21:02.80,0:21:05.76,Default,,0,0,0,,Эй, Очако және басқалар, про-кейіпкерлермен бірге.
Dialogue: 0,0:21:05.88,0:21:07.72,Default,,0,0,0,,Мен бұрын батыр болып жұмыс істегенмін.
Dialogue: 0,0:21:07.97,0:21:10.47,Default,,0,0,0,,Тек жаттығу және патрульдеу.
Dialogue: 0,0:21:10.60,0:21:14.23,Default,,0,0,0,,Біз оқиғаға қатыстық, бірақ біз эвакуацияға басшылық жасауға ғана қатыстық.
Dialogue: 0,0:21:14.35,0:21:15.94,Default,,0,0,0,,Әлі де керемет
Dialogue: 0,0:21:16.06,0:21:19.40,Default,,0,0,0,,Белгілі бір себептермен мен теледидар жарнамасына түсіп қалдым.
Dialogue: 0,0:21:19.52,0:21:22.61,Default,,0,0,0,,Бұл әдетте жасай алмайтын нәрсе. Бұл керемет.
Dialogue: 0,0:21:22.86,0:21:24.95,Default,,0,0,0,,Академияның жұмыстары ертең көрмеге қойылады.
Dialogue: 0,0:21:25.07,0:21:26.82,Default,,0,0,0,,Мен де павильонға баруды жоспарлап отырмын.
Dialogue: 0,0:21:26.95,0:21:27.95,Default,,0,0,0,,Өте қызық!
Dialogue: 0,0:21:28.07,0:21:31.54,Default,,0,0,0,,Түсініспеушілікті жою үшін жақсы...
Dialogue: 0,0:21:31.91,0:21:32.74,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:21:32.87,0:21:34.87,Default,,0,0,0,,А, бұл дауыс...
Dialogue: 0,0:21:35.08,0:21:36.54,Default,,0,0,0,,Немесе... Каминари-кун
Dialogue: 0,0:21:36.67,0:21:38.63,Default,,0,0,0,,...және Минета-кун?
Dialogue: 0,0:21:38.75,0:21:40.38,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:21:40.50,0:21:43.21,Default,,0,0,0,,Біз уақытша толық емес жұмысшыларды ЭКСПО кезінде ғана жалдадық.
Dialogue: 0,0:21:43.34,0:21:45.30,Default,,0,0,0,,Мен өтініш бердім, солай ма?
Dialogue: 0,0:21:45.42,0:21:47.63,Default,,0,0,0,,Сіз үзіліс кезінде көрмені тамашалай аласыз.
Dialogue: 0,0:21:47.76,0:21:49.30,Default,,0,0,0,,Мен жалақы аламын.
Dialogue: 0,0:21:49.43,0:21:53.06,Default,,0,0,0,,Сіз шоуға келген сүйкімді қыздармен керемет кездесіп қалуыңыз мүмкін...
Dialogue: 0,0:21:53.18,0:21:54.60,Default,,0,0,0,,Мен алмаймын!
Dialogue: 0,0:21:54.73,0:21:57.56,Default,,0,0,0,,Эй, Мидория, сен осындай сұлу әйелді қайдан кездестірдің?
Dialogue: 0,0:21:57.69,0:21:59.10,Default,,0,0,0,,Кіріспе сөз
Dialogue: 0,0:21:59.23,0:22:00.52,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:22:00.65,0:22:02.02,Default,,0,0,0,,Олар да батыр ма?
Dialogue: 0,0:22:02.77,0:22:05.03,Default,,0,0,0,,Дұрыс (Минета) Мен батыр болғым келеді.
Dialogue: 0,0:22:05.49,0:22:07.11,Default,,0,0,0,,Сіз қандай майды сатасыз?
Dialogue: 0,0:22:07.24,0:22:10.45,Default,,0,0,0,,Енді сіз толық емес жұмыс күнін қабылдадыңыз, еңбектеніңіз!
Dialogue: 0,0:22:10.57,0:22:11.62,Default,,0,0,0,,Гаар!
Dialogue: 0,0:22:11.83,0:22:14.20,Default,,0,0,0,,Мен... Иида-кун (Очако) Келдің бе?
Dialogue: 0,0:22:14.45,0:22:16.79,Default,,0,0,0,,Біз батырлар отбасымыз.
Dialogue: 0,0:22:16.91,0:22:19.21,Default,,0,0,0,,Мен I-Expo көрмесінен шақыру алдым.
Dialogue: 0,0:22:19.83,0:22:22.71,Default,,0,0,0,,Менің отбасымның жоспарлары бар еді, мен жалғыз келдім...
Dialogue: 0,0:22:22.84,0:22:24.59,Default,,0,0,0,,Иида-сан да?
Dialogue: 0,0:22:24.71,0:22:26.67,Default,,0,0,0,,Менің әкем де I.Expo-да жұмыс істейді.
Dialogue: 0,0:22:26.80,0:22:29.26,Default,,0,0,0,,Себебі сіз демеуші компанияның акциясын иеленесіз.
Dialogue: 0,0:22:29.38,0:22:31.18,Default,,0,0,0,,Мен шақыру хатын алдым.
Dialogue: 0,0:22:31.30,0:22:34.64,Default,,0,0,0,,Менде екі Yaomomo шақыруы қалды...
Dialogue: 0,0:22:35.47,0:22:37.02,Default,,0,0,0,,Кек сақтама
Dialogue: 0,0:22:37.35,0:22:38.98,Default,,0,0,0,,Тас-қағаз-қайшы теннис!
Dialogue: 0,0:22:39.10,0:22:41.10,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:22:41.61,0:22:43.40,Default,,0,0,0,,Қатаң лотерея нәтижелері -
Dialogue: 0,0:22:43.86,0:22:46.32,Default,,0,0,0,,Екеуміз бірге барамыз деп шештік.
Dialogue: 0,0:22:46.44,0:22:49.61,Default,,0,0,0,,Иә, бұл аралға басқа қыздар да келеді.
Dialogue: 0,0:22:49.91,0:22:51.11,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:22:51.24,0:22:55.33,Default,,0,0,0,,Біз бәріміз ертеңнен бастап қоғамдық күні экскурсияға баруды жоспарлап отырмыз.
Dialogue: 0,0:22:55.45,0:22:58.04,Default,,0,0,0,,Қарсы болмасаң, мен саған айналамды көрсете аламын.
Dialogue: 0,0:22:58.16,0:22:59.58,Default,,0,0,0,,Уау... (Очако) Жақсысың ба?
Dialogue: 0,0:22:59.71,0:23:00.54,Default,,0,0,0,,Иә
Dialogue: 0,0:23:00.67,0:23:01.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:02.00,0:23:02.88,Default,,0,0,0,,Әй... бізді де алып кетіңізші.
Dialogue: 0,0:23:02.88,0:23:03.42,Default,,0,0,0,,Әй... бізді де алып кетіңізші.
Dialogue: 0,0:23:02.88,0:23:03.42,Default,,0,0,0,,(дыбыс)
Dialogue: 0,0:23:03.42,0:23:03.54,Default,,0,0,0,,(дыбыс)
Dialogue: 0,0:23:03.54,0:23:04.09,Default,,0,0,0,,(дыбыс)
Dialogue: 0,0:23:03.54,0:23:04.09,Default,,0,0,0,,Жоқ... не?
Dialogue: 0,0:23:04.09,0:23:05.92,Default,,0,0,0,,Жоқ... не?
Dialogue: 0,0:23:09.38,0:23:13.39,Default,,0,0,0,,Таза уақыт: 33 секунд, 8 орын!
Dialogue: 0,0:23:13.72,0:23:15.18,Default,,0,0,0,,Киришима-кун?
Dialogue: 0,0:23:15.47,0:23:17.52,Default,,0,0,0,,Деку-кун, ол кісі де?
Dialogue: 0,0:23:17.64,0:23:19.56,Default,,0,0,0,,Иә, біз сыныптаспыз.
Dialogue: 0,0:23:19.68,0:23:22.44,Default,,0,0,0,,Енді келесі сайыскер кім?
Dialogue: 0,0:23:22.69,0:23:24.98,Default,,0,0,0,,Әлде... Каччан?
Dialogue: 0,0:23:25.15,0:23:27.28,Default,,0,0,0,,Содан кейін зұлымдық шабуылы
Dialogue: 0,0:23:27.40,0:23:29.44,Default,,0,0,0,,Дайын!
Dialogue: 0,0:23:31.28,0:23:32.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:36.12,0:23:37.41,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:23:37.99,0:23:38.87,Default,,0,0,0,,♬~
Dialogue: 0,0:23:39.96,0:23:43.63,Default,,0,0,0,,Бұл керемет. Тазалау уақыты - 15 секунд. Жоғары!
Dialogue: 0,0:23:43.75,0:23:44.84,Default,,0,0,0,,(үшін қуанады)
Dialogue: 0,0:23:45.13,0:23:46.21,Default,,0,0,0,,Фу…
Dialogue: 0,0:23:46.96,0:23:49.34,Default,,0,0,0,,Мына жақтағы Мидория емес пе?
Dialogue: 0,0:23:49.46,0:23:50.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:50.76,0:23:52.68,Default,,0,0,0,,А… Аха
Dialogue: 0,0:23:52.80,0:23:53.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:54.09,0:23:56.47,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:23:56.60,0:23:58.72,Default,,0,0,0,,Жоқ... тоқтайық, Каччан, адамдар қарап тұр.
Dialogue: 0,0:23:58.85,0:24:00.27,Default,,0,0,0,,Сонымен не керек!
Dialogue: 0,0:24:00.39,0:24:01.69,Default,,0,0,0,,Тоқта, Бакугу-кун!
Dialogue: 0,0:24:01.98,0:24:03.94,Default,,0,0,0,,Ол бала неге ашулы?
Dialogue: 0,0:24:04.06,0:24:05.40,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:24:05.52,0:24:07.44,Default,,0,0,0,,Бұл адамның тағдыры.
Dialogue: 0,0:24:08.19,0:24:11.19,Default,,0,0,0,,Киришима-сан және басқалары да Экспоға шақыру алды ма?
Dialogue: 0,0:24:11.32,0:24:15.57,Default,,0,0,0,,Жоқ, шақырылған адам Юэй спорт фестивалінде жеңімпаз атанған Бакугу болды.
Dialogue: 0,0:24:15.70,0:24:16.95,Default,,0,0,0,,Мен қызметшімін
Dialogue: 0,0:24:17.45,0:24:19.91,Default,,0,0,0,,Не? Енді бәріңіз сол сынақты сынап көргіңіз келе ме?
Dialogue: 0,0:24:20.04,0:24:23.67,Default,,0,0,0,,Тырысудың қажеті жоқ, өйткені мен қазірдің өзінде жақсырақпын.
Dialogue: 0,0:24:23.79,0:24:25.50,Default,,0,0,0,,Иә Иә Иә Иә
Dialogue: 0,0:24:25.83,0:24:28.38,Default,,0,0,0,,Бірақ сіз тырыспайынша білмейсіз деп ойлаймын.
Dialogue: 0,0:24:28.71,0:24:29.96,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:24:30.09,0:24:30.92,Default,,0,0,0,,Цукуёми-кун мен Каэрубүки-санға қандай сынақтар қойылған?
Dialogue: 0,0:24:31.05,0:24:34.59,Default,,0,0,0,,Олай болса, шығып, маған аянышты нәтиже беріңіз.
Dialogue: 0,0:24:34.93,0:24:36.26,Default,,0,0,0,,Нерд!
Dialogue: 0,0:24:36.39,0:24:38.10,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:24:38.72,0:24:41.89,Default,,0,0,0,,Енді секіріп, қатысқан сайыскер.
Dialogue: 0,0:24:42.39,0:24:45.15,Default,,0,0,0,,Ол қандай жазбаларды шығарады?
Dialogue: 0,0:24:46.19,0:24:48.44,Default,,0,0,0,,Енді сіз мұны істеуге шешім қабылдадыңыз ...
Dialogue: 0,0:24:49.23,0:24:53.53,Default,,0,0,0,,Бірге барлығы үшін: Толық капюшон!
Dialogue: 0,0:24:54.65,0:24:57.16,Default,,0,0,0,,Зұлымдардың шабуылы дайын!
Dialogue: 0,0:24:58.95,0:24:59.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:00.08,0:25:04.54,Default,,0,0,0,,Қолыңызды зақымдамау үшін 5% күш қолданыңыз.
Dialogue: 0,0:25:12.80,0:25:16.26,Default,,0,0,0,,Бұл да керемет 16 секунд 2 орын!
Dialogue: 0,0:25:16.38,0:25:18.80,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:25:19.30,0:25:22.64,Default,,0,0,0,,Таңғажайып жарылғыш және жойғыш күш
Dialogue: 0,0:25:23.60,0:25:25.64,Default,,0,0,0,,Дәл Майт ағай сияқты
Dialogue: 0,0:25:26.94,0:25:28.06,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:25:28.48,0:25:30.11,Default,,0,0,0,,Хм, қандай ұят.
Dialogue: 0,0:25:30.52,0:25:32.28,Default,,0,0,0,,Сіз күткендей, Мидориа-кун.
Dialogue: 0,0:25:32.40,0:25:34.99,Default,,0,0,0,,Мен Каччанның рекордына бұлай жақындай аламын деп ешқашан ойламадым.
Dialogue: 0,0:25:35.11,0:25:37.57,Default,,0,0,0,,Даа! Шүкір, бұл мүмкін емес! Мені итеріп жіберсең!
Dialogue: 0,0:25:37.57,0:25:39.07,Default,,0,0,0,,Даа! Шүкір, бұл мүмкін емес! Мені итеріп жіберсең!
Dialogue: 0,0:25:37.57,0:25:39.07,Default,,0,0,0,,(дыбыс)
Dialogue: 0,0:25:39.20,0:25:42.12,Default,,0,0,0,,Сәлем! Керемет, ғажап, таңқаларлық!
Dialogue: 0,0:25:42.58,0:25:46.83,Default,,0,0,0,,Ju... 14 секунд Біз жоғарыдамыз!
Dialogue: 0,0:25:46.96,0:25:47.79,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:25:48.25,0:25:49.50,Default,,0,0,0,,Жоқ, мәселе сол жерде емес.
Dialogue: 0,0:25:49.63,0:25:51.54,Default,,0,0,0,,Ол да сыныптасы ма? (Яойорозу) Иә
Dialogue: 0,0:25:52.00,0:25:55.80,Default,,0,0,0,,Батыр жұмыртқасынан күткендей, бәрі ғажап
Dialogue: 0,0:25:55.92,0:25:57.05,Default,,0,0,0,,Мұндай нәрсе (Очако) Ахаха...
Dialogue: 0,0:25:57.88,0:25:59.93,Default,,0,0,0,,Қарғыс атсын, жарымжан!
Dialogue: 0,0:26:00.43,0:26:01.26,Default,,0,0,0,,Сен ғой—
Dialogue: 0,0:26:01.39,0:26:04.31,Default,,0,0,0,,Сіз кенеттен шығып, маған қандай керемет екеніңізді көрсеттіңіз!
Dialogue: 0,0:26:04.43,0:26:05.73,Default,,0,0,0,,Мидория мен басқалары келе ме?
Dialogue: 0,0:26:05.85,0:26:06.89,Default,,0,0,0,,Оны елемеңіз!
Dialogue: 0,0:26:07.44,0:26:10.15,Default,,0,0,0,,Негізінде не үшін келдің?
Dialogue: 0,0:26:10.27,0:26:12.27,Default,,0,0,0,,Шақыру алушының әкесінің атынан
Dialogue: 0,0:26:12.40,0:26:13.98,Default,,0,0,0,,Мм, келесісін күтіңіз...
Dialogue: 0,0:26:14.11,0:26:15.82,Default,,0,0,0,,Ой, келесі мен!
Dialogue: 0,0:26:15.94,0:26:17.36,Default,,0,0,0,,үшін, тоқтаңдар!
Dialogue: 0,0:26:17.49,0:26:19.70,Default,,0,0,0,,Юэйдің ұятты жерлері әлемге ашылады!
Dialogue: 0,0:26:19.82,0:26:21.16,Default,,0,0,0,,Ух... иә (Киришима) Ой уау.
Dialogue: 0,0:26:21.70,0:26:23.54,Default,,0,0,0,,Фуфуфуфуфу… (3 адам) Уф…
Dialogue: 0,0:26:23.66,0:26:25.04,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:26:26.08,0:26:28.79,Default,,0,0,0,,Мен Юэй орта мектебі қызықты болады деп ойладым.
Dialogue: 0,0:26:29.33,0:26:32.59,Default,,0,0,0,,Ең болмаса жалықпаймын...
Dialogue: 0,0:26:32.71,0:26:34.30,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:26:37.72,0:26:41.76,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:26:42.10,0:26:44.26,Default,,0,0,0,,Зат кесте бойынша алынды.
Dialogue: 0,0:26:45.97,0:26:48.52,Default,,0,0,0,,Не? үшін мүмкін бе?
Dialogue: 0,0:26:49.81,0:26:53.40,Default,,0,0,0,,Дүрбелең болмаңыз, біз оны шешеміз.
Dialogue: 0,0:26:53.73,0:26:54.73,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:26:55.44,0:26:58.45,Default,,0,0,0,,Барлық күш осы аралда...
Dialogue: 0,0:27:08.16,0:27:09.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:10.21,0:27:11.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:11.17,0:27:12.83,Default,,0,0,0,,(капсула ашылған дыбыс)
Dialogue: 0,0:27:14.88,0:27:16.80,Default,,0,0,0,,Тоши, сен нені айтып тұрсың?
Dialogue: 0,0:27:17.46,0:27:20.76,Default,,0,0,0,,Неліктен менің тұлғалық құндылықтарым тез төмендейді?
Dialogue: 0,0:27:21.18,0:27:23.85,Default,,0,0,0,,Бәрі бір үшін шайқаста зақымданса да...
Dialogue: 0,0:27:24.35,0:27:26.81,Default,,0,0,0,,Кенеттен бұл сан тым қалыпты емес.
Dialogue: 0,0:27:27.10,0:27:30.23,Default,,0,0,0,,Сенің денеңе не болды?
Dialogue: 0,0:27:30.69,0:27:31.73,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:27:32.19,0:27:36.61,Default,,0,0,0,,Ұзақ жылдар батыр болып жүре берсең, анда-мында босап кетесің.
Dialogue: 0,0:27:37.78,0:27:40.15,Default,,0,0,0,,Мен саған «үшінмыз үшін» құпиясын айта алмаймын
Dialogue: 0,0:27:40.53,0:27:43.53,Default,,0,0,0,,Сөйлессең, «үшін бір үшін» күреседі.
Dialogue: 0,0:27:43.66,0:27:46.12,Default,,0,0,0,,Бұл Дэйв пен Мелиссаның қатысуымен аяқталады.
Dialogue: 0,0:27:47.66,0:27:50.83,Default,,0,0,0,,Осылай жалғаса берсе, бейбітшілік символы жоғалады.
Dialogue: 0,0:27:51.66,0:27:55.71,Default,,0,0,0,,Жапонияның зұлымдық қылмысын 6% деңгейінде ұстауының себебі...
Dialogue: 0,0:27:55.84,0:27:57.71,Default,,0,0,0,,үшін сенің арқаңда
Dialogue: 0,0:27:57.84,0:28:01.51,Default,,0,0,0,,Басқа елдерде 20% астам болса да.
Dialogue: 0,0:28:03.05,0:28:07.10,Default,,0,0,0,,Мен сенің Америкада қалуыңды қанша рет тіледім?
Dialogue: 0,0:28:10.39,0:28:13.27,Default,,0,0,0,,Бұлай пессимистік болудың қажеті жоқ.
Dialogue: 0,0:28:13.52,0:28:15.73,Default,,0,0,0,,Керемет профессионалдар бар.
Dialogue: 0,0:28:15.86,0:28:19.11,Default,,0,0,0,,Мені қолдайтын сіз сияқты адамдар бар.
Dialogue: 0,0:28:19.48,0:28:22.95,Default,,0,0,0,,Тіпті мен күніне бірнеше сағат барлық күш-қуат ретінде әрекет ете аламын...
Dialogue: 0,0:28:23.07,0:28:24.16,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:28:24.86,0:28:27.12,Default,,0,0,0,,Зұлымдар барлығы бір үшін ұнайды
Dialogue: 0,0:28:27.24,0:28:29.87,Default,,0,0,0,,Қайтадан бір жерде пайда болуы мүмкін...
Dialogue: 0,0:28:30.37,0:28:32.04,Default,,0,0,0,,Дэйв?
Dialogue: 0,0:28:32.62,0:28:37.96,Default,,0,0,0,,Бұл жағдай орын алған жағдайда, мен бейбітшілік символынан кететін ойым жоқ.
Dialogue: 0,0:28:38.80,0:28:41.55,Default,,0,0,0,,Үміт те бар.
Dialogue: 0,0:28:43.43,0:28:45.55,Default,,0,0,0,,Бір адамның еркі баршаға
Dialogue: 0,0:28:46.14,0:28:48.01,Default,,0,0,0,,Бейбітшілік символы
Dialogue: 0,0:28:49.01,0:28:51.89,Default,,0,0,0,,Кейінгі ұрпаққа аманат ету үміті
Dialogue: 0,0:28:56.06,0:28:59.40,Default,,0,0,0,,Саябақ бүгін сағат 18:00-де жабылады.
Dialogue: 0,0:29:00.23,0:29:02.78,Default,,0,0,0,,Бізге келгеніңіз үшін рахмет.
Dialogue: 0,0:29:04.20,0:29:05.20,Default,,0,0,0,,Я...
Dialogue: 0,0:29:05.32,0:29:08.45,Default,,0,0,0,,Ашылу алдындағы бұл бос еместік нені білдіреді?
Dialogue: 0,0:29:08.58,0:29:10.79,Default,,0,0,0,,Ертеңнен бастап не болады?
Dialogue: 0,0:29:10.91,0:29:12.95,Default,,0,0,0,,Тоқта, бұл туралы ойлағым келмейді.
Dialogue: 0,0:29:13.41,0:29:14.87,Default,,0,0,0,,Минета-кун Каминари-кун
Dialogue: 0,0:29:15.00,0:29:15.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:16.08,0:29:17.13,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:29:17.25,0:29:19.09,Default,,0,0,0,,Еңбек Жақсы жұмыс.
Dialogue: 0,0:29:19.84,0:29:21.46,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:29:21.92,0:29:24.47,Default,,0,0,0,,Бұл қабылдау кешіне шақыру.
Dialogue: 0,0:29:25.51,0:29:27.30,Default,,0,0,0,,Партия? (Каминари) Біз үшін бе?
Dialogue: 0,0:29:27.72,0:29:29.72,Default,,0,0,0,,Мелисса оны маған дайындады.
Dialogue: 0,0:29:29.85,0:29:31.43,Default,,0,0,0,,Кем дегенде бүгін.
Dialogue: 0,0:29:31.97,0:29:33.35,Default,,0,0,0,,Себебі менде қосымша болды
Dialogue: 0,0:29:33.48,0:29:34.93,Default,,0,0,0,,Қаласаңыз, пайдаланыңыз
Dialogue: 0,0:29:35.23,0:29:36.56,Default,,0,0,0,,Бастапқы ұпайлар: 10 миллион
Dialogue: 0,0:29:36.69,0:29:38.31,Default,,0,0,0,,Минета...
Dialogue: 0,0:29:38.73,0:29:41.69,Default,,0,0,0,,Еңбегіміз ақталды!
Dialogue: 0,0:29:42.19,0:29:43.90,Default,,0,0,0,,Профессорлар да партияда.
Dialogue: 0,0:29:44.03,0:29:45.70,Default,,0,0,0,,Көп қатысады деп естідім.
Dialogue: 0,0:29:45.99,0:29:47.99,Default,,0,0,0,,Юэй есіміне лайық болу үшін...
Dialogue: 0,0:29:48.11,0:29:51.20,Default,,0,0,0,,Ресми киім киіп, кешке топ болып барыңыз!
Dialogue: 0,0:29:51.58,0:29:55.58,Default,,0,0,0,,18:30-да Орталық мұнараның 7 фойесінде кездесу
Dialogue: 0,0:29:55.71,0:29:56.79,Default,,0,0,0,,Уақытты ұстаныңыз
Dialogue: 0,0:29:57.29,0:30:00.42,Default,,0,0,0,,Мен Тодороки-кун мен Бакугу-кунға электрондық хат жіберемін.
Dialogue: 0,0:30:00.79,0:30:02.17,Default,,0,0,0,,Олай болса тара!
Dialogue: 0,0:30:03.63,0:30:06.05,Default,,0,0,0,,Iida Толық дроссель
Dialogue: 0,0:30:06.97,0:30:09.64,Default,,0,0,0,,Кейін кездескенше.
Dialogue: 0,0:30:10.18,0:30:11.60,Default,,0,0,0,,Деку-кун, ә...
Dialogue: 0,0:30:12.47,0:30:15.27,Default,,0,0,0,,Менімен біраз уақыт араласа аласыз ба?
Dialogue: 0,0:30:16.14,0:30:18.27,Default,,0,0,0,,Кештерге кім барады?
Dialogue: 0,0:30:18.69,0:30:22.27,Default,,0,0,0,,Сіз танымайтын адамның сөз сөйлегенін естіген сайын қол соға аласыз ба?
Dialogue: 0,0:30:22.52,0:30:23.53,Default,,0,0,0,,Күлкілі
Dialogue: 0,0:30:23.65,0:30:26.03,Default,,0,0,0,,Сәнді тағамды қалағаныңызша жеуге болатын сияқты.
Dialogue: 0,0:30:26.15,0:30:28.95,Default,,0,0,0,,Біріншіден, мен ешқандай салтанатты киім әкелген жоқпын.
Dialogue: 0,0:30:29.07,0:30:30.78,Default,,0,0,0,,Мен ойладым... (Кацуки) А?
Dialogue: 0,0:30:31.28,0:30:33.12,Default,,0,0,0,,Мен де саған әкелдім.
Dialogue: 0,0:30:33.24,0:30:35.58,Default,,0,0,0,,Сен тым жақсы дайындалдың, қарғыс атқыр шаш!
Dialogue: 0,0:30:37.91,0:30:39.33,Default,,0,0,0,,(Барлық мүмкін жөтел)
Dialogue: 0,0:30:40.29,0:30:41.75,Default,,0,0,0,,Дэйв Кейін кездескенше
Dialogue: 0,0:30:43.00,0:30:44.59,Default,,0,0,0,,Кеш өтетін жерде кездескенше!
Dialogue: 0,0:30:44.96,0:30:46.09,Default,,0,0,0,,О
Dialogue: 0,0:30:48.22,0:30:49.34,Default,,0,0,0,,Тоши
Dialogue: 0,0:30:50.05,0:30:52.35,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:30:52.76,0:30:54.47,Default,,0,0,0,,А, жоқ, ештеңе.
Dialogue: 0,0:30:56.60,0:30:57.89,Default,,0,0,0,,Өткізілетін жерде
Dialogue: 0,0:30:58.02,0:31:00.35,Default,,0,0,0,,Хахахаха! (есік жабылған дыбыс)
Dialogue: 0,0:31:11.49,0:31:12.82,Default,,0,0,0,,Эксперимент кезіндегі апат?
Dialogue: 0,0:31:12.95,0:31:14.58,Default,,0,0,0,,Қашып кетуге кешіккен біреу бар.
Dialogue: 0,0:31:14.70,0:31:16.08,Default,,0,0,0,,(Дэвидтің жөтелі)
Dialogue: 0,0:31:16.37,0:31:19.29,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:31:22.75,0:31:24.46,Default,,0,0,0,,(Оқушылардың айқайы)
Dialogue: 0,0:31:26.34,0:31:28.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:31:31.72,0:31:32.64,Default,,0,0,0,,Рахмет
Dialogue: 0,0:31:33.18,0:31:35.97,Default,,0,0,0,,Мен Дэвид Шилдспін. Сен ше?
Dialogue: 0,0:31:36.10,0:31:39.43,Default,,0,0,0,,Бүкіл Құдірет Батыр болғысы келетін оқушы
Dialogue: 0,0:31:39.56,0:31:40.39,Default,,0,0,0,,Ах
Dialogue: 0,0:31:40.69,0:31:43.90,Default,,0,0,0,,Соңғы материалдармен тігілген тек сізге арналған костюм.
Dialogue: 0,0:31:44.27,0:31:46.65,Default,,0,0,0,,Сіз мұнымен ақылсыз әрекеттер жасай аласыз
Dialogue: 0,0:31:46.77,0:31:47.65,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:31:48.99,0:31:50.03,Default,,0,0,0,,Хмф!
Dialogue: 0,0:31:57.79,0:31:58.70,Default,,0,0,0,,Фу…
Dialogue: 0,0:32:00.83,0:32:03.25,Default,,0,0,0,,Ха! Ха! Алақай!
Dialogue: 0,0:32:03.37,0:32:05.67,Default,,0,0,0,,Уау! (Зұлым жылайды)
Dialogue: 0,0:32:05.79,0:32:08.46,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:32:09.92,0:32:11.47,Default,,0,0,0,,Бейбітшілік символы?
Dialogue: 0,0:32:12.09,0:32:15.89,Default,,0,0,0,,Менің мақсатым - әркім өмір сүретін және күлетін әлем.
Dialogue: 0,0:32:16.76,0:32:20.77,Default,,0,0,0,,Мен әлемді нұрландыра беретін «бейбітшілік символы» болғым келеді.
Dialogue: 0,0:32:32.36,0:32:33.53,Default,,0,0,0,,(құлап жатқан адамның дыбысы)
Dialogue: 0,0:32:34.28,0:32:37.74,Default,,0,0,0,,Ол қамауға алынды. Бес күзетші бар. Жоспарлағандай.
Dialogue: 0,0:32:38.28,0:32:40.37,Default,,0,0,0,,Қауіпсіздік жүйесі әлі де тірі.
Dialogue: 0,0:32:40.50,0:32:42.04,Default,,0,0,0,,Мені өлтірме, үй қамағында ұста
Dialogue: 0,0:32:42.16,0:32:44.96,Default,,0,0,0,,Иә, мен қазір жұмыс істей бастаймын.
Dialogue: 0,0:32:45.25,0:32:46.83,Default,,0,0,0,,Іс жақсы жүріп жатыр.
Dialogue: 0,0:32:50.46,0:32:52.17,Default,,0,0,0,,Бұл да жұмыс істейді
Dialogue: 0,0:32:57.76,0:33:00.47,Default,,0,0,0,,Бұл мен оқитын академияның мектеп ғимараты.
Dialogue: 0,0:33:00.77,0:33:03.94,Default,,0,0,0,,Ал бұл мен қолданатын зертхана.
Dialogue: 0,0:33:06.35,0:33:07.69,Default,,0,0,0,,Қателік үшін кешіріңіз.
Dialogue: 0,0:33:08.11,0:33:10.36,Default,,0,0,0,,Уау, шынайы
Dialogue: 0,0:33:11.23,0:33:13.70,Default,,0,0,0,,Мен мұндай жерде зерттеу жүргізе алатыныма сене алмаймын.
Dialogue: 0,0:33:13.82,0:33:14.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:15.41,0:33:18.66,Default,,0,0,0,,Мелисса, сен өте кереметсің.
Dialogue: 0,0:33:18.78,0:33:23.04,Default,,0,0,0,,Негізі менің бағаларым онша жақсы болмады.
Dialogue: 0,0:33:23.16,0:33:25.25,Default,,0,0,0,,Сондықтан мен көп оқыдым.
Dialogue: 0,0:33:25.87,0:33:28.13,Default,,0,0,0,,Өйткені мен батыр болғым келді
Dialogue: 0,0:33:28.25,0:33:30.59,Default,,0,0,0,,Не? Профессионал кейіпкер боласыз ба?
Dialogue: 0,0:33:30.71,0:33:33.63,Default,,0,0,0,,Жоқ, мен одан бірден бас тарттым.
Dialogue: 0,0:33:33.76,0:33:35.68,Default,,0,0,0,,Өйткені менің мінезім жоқ.
Dialogue: 0,0:33:35.93,0:33:38.55,Default,,0,0,0,,Ах, тұлға жоқ...
Dialogue: 0,0:33:39.39,0:33:41.81,Default,,0,0,0,,5 жаста да даралық көрінбейді...
Dialogue: 0,0:33:41.93,0:33:44.14,Default,,0,0,0,,Мен оны дәрігерге тексерттім.
Dialogue: 0,0:33:44.60,0:33:48.15,Default,,0,0,0,,Содан кейін маған экспрессивті емес тип диагнозы қойылды.
Dialogue: 0,0:33:48.56,0:33:50.40,Default,,0,0,0,,Мен сияқты
Dialogue: 0,0:33:51.27,0:33:52.86,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:33:52.98,0:33:57.11,Default,,0,0,0,,Адам қанша қиналса да, күліп көмектесемін.
Dialogue: 0,0:33:57.82,0:34:01.33,Default,,0,0,0,,Мен де солай бола аламын ба деп ойлаймын...
Dialogue: 0,0:34:02.04,0:34:03.37,Default,,0,0,0,,Кешіріңіз, Изуку.
Dialogue: 0,0:34:03.95,0:34:06.41,Default,,0,0,0,,Менің аяғым шынында «сырс» етті!—
Dialogue: 0,0:34:07.46,0:34:10.21,Default,,0,0,0,,Мен... Кешіріңіз, бірдеңе...
Dialogue: 0,0:34:10.46,0:34:12.17,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:34:12.46,0:34:14.46,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:34:14.92,0:34:16.34,Default,,0,0,0,,Айналаңыздағы адамдар
Dialogue: 0,0:34:16.47,0:34:19.80,Default,,0,0,0,,Сізде әдеттегідей қабылдайтын нәрсе жоқ деп айту...
Dialogue: 0,0:34:19.93,0:34:21.05,Default,,0,0,0,,Фу…
Dialogue: 0,0:34:21.18,0:34:23.31,Default,,0,0,0,,Әрине, мен таң қалдым.
Dialogue: 0,0:34:23.51,0:34:26.93,Default,,0,0,0,,Бірақ жақын жерде менің мақсатым болды.
Dialogue: 0,0:34:27.06,0:34:29.19,Default,,0,0,0,,Иә? Мақсат?
Dialogue: 0,0:34:30.02,0:34:31.23,Default,,0,0,0,,менің әкем
Dialogue: 0,0:34:32.11,0:34:35.36,Default,,0,0,0,,Әкемнің батырлық қасиеті жоқ еді, бірақ...
Dialogue: 0,0:34:35.49,0:34:39.61,Default,,0,0,0,,Құдіретті аға мен батырларды ғылымның құдіретімен қолдау
Dialogue: 0,0:34:39.74,0:34:43.24,Default,,0,0,0,,Жанама болса да бейбітшілік үшін күресу
Dialogue: 0,0:34:44.08,0:34:46.58,Default,,0,0,0,,Батырға көмектесетін болмыс...
Dialogue: 0,0:34:46.70,0:34:47.71,Default,,0,0,0,,Иә
Dialogue: 0,0:34:48.12,0:34:51.75,Default,,0,0,0,,Міне, мен осындай батыр болғым келеді.
Dialogue: 0,0:34:53.88,0:34:55.55,Default,,0,0,0,,Бұл қолдау элементі.
Dialogue: 0,0:34:55.67,0:34:58.51,Default,,0,0,0,,Мен мұны «Ағамызды» сілтеме ретінде қолдандым.
Dialogue: 0,0:34:58.63,0:35:00.01,Default,,0,0,0,,үшін мүмкін бе?
Dialogue: 0,0:35:00.89,0:35:01.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:02.43,0:35:04.43,Default,,0,0,0,,Осы жерде панельді басып көріңіз.
Dialogue: 0,0:35:09.85,0:35:10.90,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:35:11.81,0:35:12.90,Default,,0,0,0,,Бұл...
Dialogue: 0,0:35:13.02,0:35:16.40,Default,,0,0,0,,Егер мен оны атау керек болса, ол «Толық Gauntlet» болар еді.
Dialogue: 0,0:35:16.53,0:35:17.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:18.69,0:35:20.57,Default,,0,0,0,,Мен Деку-кунмен алғаш кездескенімде...
Dialogue: 0,0:35:21.45,0:35:23.07,Default,,0,0,0,,Мен қолымдағы тыртықты көрдім...
Dialogue: 0,0:35:24.20,0:35:26.04,Default,,0,0,0,,Бұл аттракцион болған кезде де...
Dialogue: 0,0:35:26.16,0:35:29.37,Default,,0,0,0,,Мен өзімді әдейі сақтап жүргендей сезінемін...
Dialogue: 0,0:35:29.83,0:35:31.33,Default,,0,0,0,,Мен солай ойладым
Dialogue: 0,0:35:31.62,0:35:33.13,Default,,0,0,0,,Деку тым күшті мінезге ие
Dialogue: 0,0:35:33.25,0:35:35.71,Default,,0,0,0,,Менің денем шыдай алмайды деп ойлаймын.
Dialogue: 0,0:35:35.84,0:35:38.09,Default,,0,0,0,,А, олар мені көрді...
Dialogue: 0,0:35:40.84,0:35:42.43,Default,,0,0,0,,Бұл толық қолтық
Dialogue: 0,0:35:42.55,0:35:45.10,Default,,0,0,0,,Құдірет ағайдың күшімен жұдырық тассам да
Dialogue: 0,0:35:45.22,0:35:47.64,Default,,0,0,0,,Ол үш рет шыдауға жеткілікті күшті.
Dialogue: 0,0:35:47.77,0:35:50.39,Default,,0,0,0,,Деку-кун өзінің шынайы күшін көрсете алатынына сенімдімін.
Dialogue: 0,0:35:51.60,0:35:54.19,Default,,0,0,0,,Менің күшім...
Dialogue: 0,0:35:54.48,0:35:56.02,Default,,0,0,0,,Деку-кун соны пайдаланды.
Dialogue: 0,0:35:56.32,0:35:59.07,Default,,0,0,0,,Иә, бірақ бұл маңызды нәрсе...
Dialogue: 0,0:35:59.19,0:36:01.49,Default,,0,0,0,,Сондықтан мен оны пайдаланғаныңызды қалаймын.
Dialogue: 0,0:36:01.99,0:36:06.24,Default,,0,0,0,,Қиындыққа тап болған адамдарға көмектесе алатын тамаша кейіпкер бол.
Dialogue: 0,0:36:06.91,0:36:08.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:10.00,0:36:10.83,Default,,0,0,0,,Иә
Dialogue: 0,0:36:11.25,0:36:12.29,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:36:14.04,0:36:16.79,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:36:17.09,0:36:17.92,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:36:18.25,0:36:22.30,Default,,0,0,0,,Не істеп жатырсың, Мидория-кун, кездесу уақыты өтіп кетті!
Dialogue: 0,0:36:22.68,0:36:23.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:30.89,0:36:32.39,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым
Dialogue: 0,0:36:32.81,0:36:35.06,Default,,0,0,0,,...Басқа адамдар ше?
Dialogue: 0,0:36:35.19,0:36:38.40,Default,,0,0,0,,Ол әлі келген жоқ. Топтық әрекет туралы не ойлайсыз?
Dialogue: 0,0:36:40.11,0:36:42.86,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:36:43.15,0:36:45.28,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:36:45.41,0:36:46.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:47.07,0:36:49.62,Default,,0,0,0,,Кешіріңіз, Джиро мырза...
Dialogue: 0,0:36:49.95,0:36:51.50,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:36:51.83,0:36:56.13,Default,,0,0,0,,Уф, мен мұндай киім туралы не айтарымды білмеймін...
Dialogue: 0,0:36:56.25,0:36:58.17,Default,,0,0,0,,Умаконың да костюмдері бар.
Dialogue: 0,0:36:58.29,0:37:00.00,Default,,0,0,0,,Өлтіруші әйелге қараңыз
Dialogue: 0,0:37:00.13,0:37:01.21,Default,,0,0,0,,Гаар!
Dialogue: 0,0:37:01.46,0:37:02.38,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:37:02.51,0:37:04.55,Default,,0,0,0,,Не? Мен сені мақтадым ба?
Dialogue: 0,0:37:04.68,0:37:05.59,Default,,0,0,0,,Мақтамау
Dialogue: 0,0:37:05.97,0:37:09.60,Default,,0,0,0,,Бұл менің бірінші рет ресми киім киюім. Мен оны Яойорозу-саннан алғанмын...
Dialogue: 0,0:37:10.01,0:37:12.81,Default,,0,0,0,,Сізге жақсы көрінеді. Иә, бұл сізге өте жарасады.
Dialogue: 0,0:37:12.93,0:37:15.90,Default,,0,0,0,,Жарайды, Деку-кун, маған ешқандай мақтау айтудың қажеті жоқ!
Dialogue: 0,0:37:16.02,0:37:17.15,Default,,0,0,0,,Урарака-кун!
Dialogue: 0,0:37:17.27,0:37:19.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:37:19.19,0:37:20.19,Default,,0,0,0,,О, хо-хо! (Минета) Уау!
Dialogue: 0,0:37:20.40,0:37:24.11,Default,,0,0,0,,Деку балалар, сендер әлі осындасыңдар ма? Кеш басталып жатыр
Dialogue: 0,0:37:25.49,0:37:27.45,Default,,0,0,0,,Шинучи осында!
Dialogue: 0,0:37:27.57,0:37:29.74,Default,,0,0,0,,Қарғыс атсын, Минета, мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:37:29.87,0:37:31.45,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:37:31.58,0:37:33.37,Default,,0,0,0,,Қалағаныңды істе.
Dialogue: 0,0:37:33.50,0:37:35.25,Default,,0,0,0,,(Пернетақта жұмысының дыбысы)
Dialogue: 0,0:37:38.71,0:37:41.25,Default,,0,0,0,,Ал, құрметті қонақтар.
Dialogue: 0,0:37:41.38,0:37:43.63,Default,,0,0,0,,I-Expo қабылдау кешінде
Dialogue: 0,0:37:43.76,0:37:45.76,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:37:45.97,0:37:47.68,Default,,0,0,0,,Тост және сәлемдесу -
Dialogue: 0,0:37:47.80,0:37:50.39,Default,,0,0,0,,Қонақ болып келген бірінші нөмірлі батыр
Dialogue: 0,0:37:50.97,0:37:53.27,Default,,0,0,0,,Мен Бүкіл Құдірет-ке өтініш білдіргім келеді.
Dialogue: 0,0:37:53.72,0:37:56.27,Default,,0,0,0,,Баршаңызға, үлкен қошемет!
Dialogue: 0,0:37:57.10,0:37:59.19,Default,,0,0,0,,Сахнаға келіңіздер.
Dialogue: 0,0:37:59.81,0:38:02.15,Default,,0,0,0,,Дэйв, мен тыңдамаймын.
Dialogue: 0,0:38:02.28,0:38:04.90,Default,,0,0,0,,Құдіреттің бәрі келетінін білгенде солай болады.
Dialogue: 0,0:38:05.03,0:38:06.20,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:38:08.28,0:38:09.45,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:38:09.57,0:38:13.54,Default,,0,0,0,,Бакуго-кунның да, Киришима-кунның да телефондарына жауап берілмейді.
Dialogue: 0,0:38:14.16,0:38:17.58,Default,,0,0,0,,Эй, бұл жолдың сізге сәйкес келетініне сенімдісіз бе?
Dialogue: 0,0:38:17.71,0:38:19.79,Default,,0,0,0,,Менің ойымша, бұл рас шығар.
Dialogue: 0,0:38:19.92,0:38:21.25,Default,,0,0,0,,Мүмкін?
Dialogue: 0,0:38:21.38,0:38:25.09,Default,,0,0,0,,Негізі ұялы телефонымды бөлмеме қалдырдым.
Dialogue: 0,0:38:27.30,0:38:30.43,Default,,0,0,0,,Мені Бүкіл Құдірет бағдарламасымен таныстырғаныңыз үшін рахмет.
Dialogue: 0,0:38:30.55,0:38:32.51,Default,,0,0,0,,Ресми сәлемдесу...
Dialogue: 0,0:38:32.64,0:38:33.89,Default,,0,0,0,,(Қонақтардың шуы)
Dialogue: 0,0:38:34.97,0:38:37.94,Default,,0,0,0,,I Island басқару жүйесінен хабарлама
Dialogue: 0,0:38:38.35,0:38:40.86,Default,,0,0,0,,Қауіпсіздік жүйесі I-Expo аймағына апарады.
Dialogue: 0,0:38:41.15,0:38:43.19,Default,,0,0,0,,Жарылғыш заттардың қойылғаны туралы ақпарат алу
Dialogue: 0,0:38:43.32,0:38:44.94,Default,,0,0,0,,Бомба? (Серо) Шынайы ма?
Dialogue: 0,0:38:45.07,0:38:47.49,Default,,0,0,0,,I. Арал ағымдағы уақыт бойынша.
Dialogue: 0,0:38:47.61,0:38:50.11,Default,,0,0,0,,Жоғары ескерту режиміне ауысыңыз
Dialogue: 0,0:38:50.32,0:38:51.74,Default,,0,0,0,,Егер сіз аралда тұрсаңыз...
Dialogue: 0,0:38:52.37,0:38:54.29,Default,,0,0,0,,Өтірік (Ашидо) Жақсысың ба?
Dialogue: 0,0:38:54.79,0:38:56.95,Default,,0,0,0,,Нұсқауларды орындаңыз, сонда сіз қауіпсіз боласыз.
Dialogue: 0,0:38:57.08,0:38:58.04,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:38:58.54,0:39:02.54,Default,,0,0,0,,10 минуттан кейін кеткен адам ескертусіз ұсталады.
Dialogue: 0,0:39:02.92,0:39:05.05,Default,,0,0,0,,Тезірек бөлмеге барайық (Токоями) Уилл
Dialogue: 0,0:39:05.17,0:39:05.84,Default,,0,0,0,,(ысырманың түсірілу дыбысы)
Dialogue: 0,0:39:05.84,0:39:06.80,Default,,0,0,0,,(ысырманың түсірілу дыбысы)
Dialogue: 0,0:39:05.84,0:39:06.80,Default,,0,0,0,,Сондай-ақ, негізгі құралдар:
Dialogue: 0,0:39:06.80,0:39:07.47,Default,,0,0,0,,Сондай-ақ, негізгі құралдар:
Dialogue: 0,0:39:07.59,0:39:10.55,Default,,0,0,0,,Қауіпсіздік жүйесі арқылы мәжбүрлі құлыптау
Dialogue: 0,0:39:11.18,0:39:12.68,Default,,0,0,0,,Қайталау…
Dialogue: 0,0:39:12.80,0:39:14.39,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:39:15.77,0:39:16.85,Default,,0,0,0,,(Қонақтардың шуы)
Dialogue: 0,0:39:18.52,0:39:19.98,Default,,0,0,0,,Мен естігенім осы болды.
Dialogue: 0,0:39:20.31,0:39:23.31,Default,,0,0,0,,Біз қауіпсіздік жүйесін бақылауға алдық.
Dialogue: 0,0:39:23.52,0:39:26.07,Default,,0,0,0,,Бүлік шығаруды ойлама.
Dialogue: 0,0:39:26.32,0:39:28.24,Default,,0,0,0,,Егер сіз мұны істесеңіз...
Dialogue: 0,0:39:29.90,0:39:31.32,Default,,0,0,0,,Қауіпсіздік машинасы...
Dialogue: 0,0:39:31.45,0:39:35.16,Default,,0,0,0,,Осы аралдағы жақсы адамдарға азу тістерімді көрсетемін.
Dialogue: 0,0:39:36.54,0:39:38.37,Default,,0,0,0,,Иә, кепілге алынғандар...
Dialogue: 0,0:39:39.08,0:39:41.79,Default,,0,0,0,,Осы аралдағы барлық адамдар.
Dialogue: 0,0:39:42.25,0:39:44.88,Default,,0,0,0,,Әрине, сендер де.
Dialogue: 0,0:39:46.25,0:39:47.09,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:39:47.21,0:39:48.46,Default,,0,0,0,,(Қонақтардың шуы)
Dialogue: 0,0:39:50.47,0:39:51.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:39:52.72,0:39:54.30,Default,,0,0,0,,Қауіпсіздікті ұстау құрылғысы!
Dialogue: 0,0:39:54.55,0:39:55.81,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:39:55.93,0:39:57.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:57.52,0:39:58.64,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:39:59.31,0:40:02.44,Default,,0,0,0,,Бір қадам болса да қозғалсаң, мен тұрғындарды дереу өлтіремін.
Dialogue: 0,0:40:02.56,0:40:03.56,Default,,0,0,0,,Қат!
Dialogue: 0,0:40:03.69,0:40:04.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:05.40,0:40:07.11,Default,,0,0,0,,Жақсы бала
Dialogue: 0,0:40:07.90,0:40:11.24,Default,,0,0,0,,Әр адам Бүкіл Құдірет-тың басшылығына еріп, пайдасыз қарсылықты тоқтатуы керек.
Dialogue: 0,0:40:11.36,0:40:12.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:12.95,0:40:15.57,Default,,0,0,0,,Тоши: Бұл жерде олардың соңынан еруден басқа амалымыз жоқ.
Dialogue: 0,0:40:16.03,0:40:17.28,Default,,0,0,0,,Бірақ Дэйв…
Dialogue: 0,0:40:17.79,0:40:20.54,Default,,0,0,0,,Мен міндетті түрде көмектесетін жол табамын.
Dialogue: 0,0:40:20.79,0:40:23.00,Default,,0,0,0,,Оған дейін ұстаңыз
Dialogue: 0,0:40:25.04,0:40:26.88,Default,,0,0,0,,Ұялы телефон ауқымнан тыс
Dialogue: 0,0:40:27.13,0:40:29.96,Default,,0,0,0,,Барлық ақпараттық байланыстар үзілген сияқты.
Dialogue: 0,0:40:30.51,0:40:31.51,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:40:31.63,0:40:33.38,Default,,0,0,0,,Лифт де жауап бермейді.
Dialogue: 0,0:40:33.51,0:40:34.68,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:40:35.18,0:40:37.72,Default,,0,0,0,,Тек жарылғыш заттар қойылса
Dialogue: 0,0:40:37.85,0:40:40.98,Default,,0,0,0,,Қауіпсіздік жүйесі қатаң ескерту режиміне өтеді.
Dialogue: 0,0:40:41.27,0:40:43.98,Default,,0,0,0,,Иида-кун, той өтетін жерге барайық.
Dialogue: 0,0:40:44.10,0:40:45.15,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:40:45.27,0:40:47.27,Default,,0,0,0,,Өткізілетін жерге Бүкіл Құдірет келеді.
Dialogue: 0,0:40:47.40,0:40:48.57,Default,,0,0,0,,үшін мүмкін бе?
Dialogue: 0,0:40:48.90,0:40:51.65,Default,,0,0,0,,Не? Сонда уайымдаудың қажеті жоқ.
Dialogue: 0,0:40:52.19,0:40:56.03,Default,,0,0,0,,Мелисса, сіз қандай да бір жолмен кеш өтетін жерге жете аласыз ба?
Dialogue: 0,0:40:56.16,0:41:00.58,Default,,0,0,0,,Менің ойымша, егер сіз шұғыл сатыларды пайдалансаңыз, оқиға орнына жақындай аласыз.
Dialogue: 0,0:41:00.79,0:41:02.50,Default,,0,0,0,,Ақпарат беріңізші
Dialogue: 0,0:41:03.62,0:41:05.21,Default,,0,0,0,,Ұялы телефон да ауқымнан тыс
Dialogue: 0,0:41:05.58,0:41:07.50,Default,,0,0,0,,Мен енді интернетті де пайдалана алмаймын.
Dialogue: 0,0:41:07.63,0:41:10.17,Default,,0,0,0,,Мен енді теледидар да қарай алмаймын.
Dialogue: 0,0:41:10.30,0:41:14.38,Default,,0,0,0,,Оған көмектесу мүмкін емес. Біз бомбаны тапқанша UNO-ны қолданайық.
Dialogue: 0,0:41:15.47,0:41:16.59,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:41:17.05,0:41:19.60,Default,,0,0,0,,Сабыр сақтасаң, саған зиян тимейді.
Dialogue: 0,0:41:20.18,0:41:23.18,Default,,0,0,0,,Мен сені уақыты келгенде босатуға дайынмын.
Dialogue: 0,0:41:23.31,0:41:24.69,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:41:24.81,0:41:26.27,Default,,0,0,0,,Арх! (Тұтынушылар) Ах...
Dialogue: 0,0:41:26.40,0:41:29.02,Default,,0,0,0,,Сіз мені естіген жоқсыз ба? Тыныш бол
Dialogue: 0,0:41:29.15,0:41:30.27,Default,,0,0,0,,(Коммуникатордың қоңырау үні)
Dialogue: 0,0:41:32.11,0:41:34.49,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:41:38.49,0:41:40.58,Default,,0,0,0,,Сіз мұнда зерттеушісіз.
Dialogue: 0,0:41:40.70,0:41:42.37,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:41:42.50,0:41:44.21,Default,,0,0,0,,Мені өзіңізбен бірге алыңыз. Жер бетінде не ...
Dialogue: 0,0:41:44.58,0:41:45.71,Default,,0,0,0,,Тоқта
Dialogue: 0,0:41:46.21,0:41:49.34,Default,,0,0,0,,Ол менің көмекшім. Сіз не істемексіз?
Dialogue: 0,0:41:49.46,0:41:50.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:50.92,0:41:52.84,Default,,0,0,0,,Бұл Дэвид Шилдс емес пе?
Dialogue: 0,0:41:53.46,0:41:54.80,Default,,0,0,0,,Келіңіз
Dialogue: 0,0:41:54.92,0:41:56.26,Default,,0,0,0,,Мен бас тартсам ше?
Dialogue: 0,0:41:57.13,0:42:01.10,Default,,0,0,0,,Бұл аралдың бір жерінде біреудің айқайы жаңғырық болады.
Dialogue: 0,0:42:02.97,0:42:05.10,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:42:07.48,0:42:08.94,Default,,0,0,0,,Дэйв…
Dialogue: 0,0:42:09.06,0:42:11.15,Default,,0,0,0,,Қарғыс атсын... Зұлымдықты жеңіңіз-
Dialogue: 0,0:42:11.27,0:42:13.73,Default,,0,0,0,,Қауіпсіздік жүйесін қалпына келтіруге бола ма?
Dialogue: 0,0:42:13.86,0:42:15.78,Default,,0,0,0,,Оның үстіне бұл денеде...
Dialogue: 0,0:42:16.61,0:42:22.24,Default,,0,0,0,,Жоқ, керек, өйткені мен бейбітшілік символымын.
Dialogue: 0,0:42:22.37,0:42:23.20,Default,,0,0,0,,Ах
Dialogue: 0,0:42:26.00,0:42:28.12,Default,,0,0,0,,Ми... Мидорий бала!
Dialogue: 0,0:42:28.75,0:42:30.33,Default,,0,0,0,,үшін байқады
Dialogue: 0,0:42:30.46,0:42:32.00,Default,,0,0,0,,Джиро мырза, сіз бара аламын деп ойлайсыз ба?
Dialogue: 0,0:42:32.13,0:42:33.17,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:42:33.71,0:42:36.26,Default,,0,0,0,,Сөйлеңізші, мен тыңдаймын.
Dialogue: 0,0:42:36.97,0:42:38.18,Default,,0,0,0,,Сіз мені ести аласыз ба?
Dialogue: 0,0:42:38.30,0:42:42.10,Default,,0,0,0,,Зұлымдар мұнараны басып алып, қауіпсіздік жүйесін бақылауға алады.
Dialogue: 0,0:42:42.30,0:42:45.18,Default,,0,0,0,,Бұл аралдағы барлық адамдар кепілге алынды.
Dialogue: 0,0:42:45.85,0:42:48.14,Default,,0,0,0,,Барлық батырлар да тұтқынға алынды.
Dialogue: 0,0:42:48.27,0:42:51.40,Default,,0,0,0,,Бұл қауіпті. Бұл жерден дереу қашыңыз.
Dialogue: 0,0:42:51.81,0:42:53.61,Default,,0,0,0,,Қиын, Мидория.
Dialogue: 0,0:42:57.53,0:42:59.91,Default,,0,0,0,,Мен Бүкіл Құдірет-тен хабар алдым.
Dialogue: 0,0:43:00.36,0:43:03.91,Default,,0,0,0,,Мен Юэй орта мектебінде мұғаліммін. Бүкіл Құдірет сөзінен кейін...
Dialogue: 0,0:43:04.41,0:43:06.95,Default,,0,0,0,,Осы жерден қашуды ұсыныңыз
Dialogue: 0,0:43:07.08,0:43:09.50,Default,,0,0,0,,Иида мырзаның пікірімен келісемін.
Dialogue: 0,0:43:09.62,0:43:11.42,Default,,0,0,0,,Біз әлі де студентпіз
Dialogue: 0,0:43:11.54,0:43:14.42,Default,,0,0,0,,Менде батырлық куәлігі де жоқ, сондықтан жауыздармен күресе алмаймын...
Dialogue: 0,0:43:14.55,0:43:17.51,Default,,0,0,0,,Ха, онда қашып, сырттағы батырға барыңыз.
Dialogue: 0,0:43:18.05,0:43:20.34,Default,,0,0,0,,Менің ойымша, қашу қиын болады
Dialogue: 0,0:43:20.80,0:43:22.97,Default,,0,0,0,,Бұл жерде зұлым қылмыскерлер тұрады.
Dialogue: 0,0:43:23.10,0:43:26.43,Default,,0,0,0,,Ол Тартаруспен бірдей апаттың алдын алу дизайнымен салынған.
Dialogue: 0,0:43:26.81,0:43:30.19,Default,,0,0,0,,Көмек келгенше тыныш күту керек...
Dialogue: 0,0:43:30.31,0:43:32.61,Default,,0,0,0,,Каминари Жарайды ма?
Dialogue: 0,0:43:32.73,0:43:33.56,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:43:34.06,0:43:35.90,Default,,0,0,0,,Көмек көрсетуді ойламайсыз ба?
Dialogue: 0,0:43:36.03,0:43:39.07,Default,,0,0,0,,Ей, тіпті Бүкіл Құдірет-ті жауыздар басып алды.
Dialogue: 0,0:43:39.19,0:43:42.57,Default,,0,0,0,,Өзіміз барып көмектесуіміз тым мүмкін емес.
Dialogue: 0,0:43:44.37,0:43:46.62,Default,,0,0,0,,Біз батыр болуды мақсат етеміз
Dialogue: 0,0:43:46.87,0:43:49.62,Default,,0,0,0,,Сонымен, біз әлі де қаһармандық әрекеттерді жасаймыз...
Dialogue: 0,0:43:50.12,0:43:53.54,Default,,0,0,0,,Бұл маған ештеңе істеудің қажеті жоқ дегенді білдіре ме?
Dialogue: 0,0:43:53.67,0:43:56.05,Default,,0,0,0,,Бұл...
Dialogue: 0,0:43:59.47,0:44:01.01,Default,,0,0,0,,Мен көмектескім келеді (барлығына) Ах...
Dialogue: 0,0:44:01.88,0:44:03.34,Default,,0,0,0,,Біз кем дегенде сөйлесе аламыз. Ол пайдалы болады деп сенемін
Dialogue: 0,0:44:04.30,0:44:05.60,Default,,0,0,0,,Мен көмектескім келеді
Dialogue: 0,0:44:05.72,0:44:10.10,Default,,0,0,0,,Зұлыммен күрескіңіз келе ме? Сіз USJ, Мидориядан сабақ алған жоқсыз ба?
Dialogue: 0,0:44:10.39,0:44:13.56,Default,,0,0,0,,Жоқ, Минета-кун, мен бұл туралы ойлап отырмын.
Dialogue: 0,0:44:14.19,0:44:15.77,Default,,0,0,0,,Зұлыммен соғыспай-
Dialogue: 0,0:44:15.90,0:44:19.65,Default,,0,0,0,,Бүкіл Құдірет және басқаларға қалай көмектесуге болады
Dialogue: 0,0:44:19.82,0:44:22.40,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін, бірақ бұл өте ыңғайлы нәрсе...
Dialogue: 0,0:44:22.53,0:44:24.07,Default,,0,0,0,,Мен оны әлі тапқым келеді
Dialogue: 0,0:44:24.87,0:44:28.29,Default,,0,0,0,,Біз қазір жасай алатын ең жақсы жолды іздейміз.
Dialogue: 0,0:44:28.41,0:44:30.54,Default,,0,0,0,,Мен барлығына көмектескім келеді
Dialogue: 0,0:44:32.46,0:44:33.79,Default,,0,0,0,,(Катсухиннің күркіреуі)
Dialogue: 0,0:44:34.00,0:44:35.79,Default,,0,0,0,,I.Island қауіпсіздік жүйесі бұл...
Dialogue: 0,0:44:36.21,0:44:38.55,Default,,0,0,0,,Бұл мұнараның жоғарғы қабатында.
Dialogue: 0,0:44:39.17,0:44:41.59,Default,,0,0,0,,Егер зұлым адам жүйені басқарса
Dialogue: 0,0:44:41.72,0:44:44.72,Default,,0,0,0,,Аутентификацияны қорғау және құпия сөзді жою керек еді
Dialogue: 0,0:44:45.59,0:44:48.68,Default,,0,0,0,,Біз жүйені қайтадан өзгерте аламыз.
Dialogue: 0,0:44:48.97,0:44:52.68,Default,,0,0,0,,Егер сіз зұлым адамның бақылауынан құтылып, жоғарғы қабатқа шыға алсаңыз.
Dialogue: 0,0:44:53.56,0:44:55.77,Default,,0,0,0,,Мүмкін біз бәріне көмектесетін шығармыз
Dialogue: 0,0:44:56.90,0:44:58.36,Default,,0,0,0,,Мелисса...
Dialogue: 0,0:44:58.90,0:45:01.32,Default,,0,0,0,,Сіз бақылаудан қалай құтыласыз?
Dialogue: 0,0:45:01.44,0:45:03.90,Default,,0,0,0,,Бұл кезде бізге нақты зиян жоқ.
Dialogue: 0,0:45:04.03,0:45:07.24,Default,,0,0,0,,Менің ойымша, зұлым адамдар қауіпсіздік жүйелерімен жұмыс істеуге үйренбеген.
Dialogue: 0,0:45:07.49,0:45:11.04,Default,,0,0,0,,Күресті болдырмаңыз және жүйені қалпына келтіресіз бе?
Dialogue: 0,0:45:11.16,0:45:12.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:45:12.25,0:45:13.75,Default,,0,0,0,,Бұл керемет емес пе?
Dialogue: 0,0:45:13.87,0:45:15.00,Default,,0,0,0,,Дұрыс (Минета) Уау...
Dialogue: 0,0:45:15.37,0:45:18.59,Default,,0,0,0,,Бірақ жоғарғы қабатта бір зұлым адам күтіп тұр.
Dialogue: 0,0:45:18.71,0:45:21.09,Default,,0,0,0,,Ұрысудың қажеті жоқ (Йоёрозу) Иә?
Dialogue: 0,0:45:21.38,0:45:23.01,Default,,0,0,0,,Жүйені бастапқы қалпына келтірсеңіз-
Dialogue: 0,0:45:23.13,0:45:25.84,Default,,0,0,0,,Кепілге алынғандар мен Бүкіл Құдірет босатылды.
Dialogue: 0,0:45:26.05,0:45:29.76,Default,,0,0,0,,Егер бұл орын алса, жағдайды бірден өзгерту керек.
Dialogue: 0,0:45:31.22,0:45:32.60,Default,,0,0,0,,Деку-кун, кеттік!
Dialogue: 0,0:45:33.06,0:45:34.10,Default,,0,0,0,,(Камино) Көздері жылтырап, жүзі әдемі, бірақ—
Dialogue: 0,0:45:34.23,0:45:37.98,Default,,0,0,0,,Қолымыздан келетін нәрсе болған кезде біз ештеңе істегіміз келмейді.
Dialogue: 0,0:45:38.61,0:45:42.15,Default,,0,0,0,,Бұл батыр атанғанға дейінгі мәселе деп ойлаймын.
Dialogue: 0,0:45:42.69,0:45:45.53,Default,,0,0,0,,Иә, мұқтаж жандарға көмектесейік.
Dialogue: 0,0:45:45.65,0:45:47.78,Default,,0,0,0,,Адамдар үшін қалыпты нәрсені жасайық.
Dialogue: 0,0:45:47.91,0:45:48.95,Default,,0,0,0,,О
Dialogue: 0,0:45:49.32,0:45:50.74,Default,,0,0,0,,Мидория (Очако/Деку) Ах...
Dialogue: 0,0:45:51.24,0:45:53.16,Default,,0,0,0,,Мен де барамын (Джиро) Учи де.
Dialogue: 0,0:45:53.62,0:45:55.79,Default,,0,0,0,,Тодороки-кун (Очако) Киока-чан
Dialogue: 0,0:45:55.91,0:45:58.54,Default,,0,0,0,,Егер бұл енді мүмкін емес деп шешсем, кері бұрыламын.
Dialogue: 0,0:45:59.17,0:46:01.84,Default,,0,0,0,,Егер ол шарт орындалса, мен де барамын.
Dialogue: 0,0:46:01.96,0:46:02.80,Default,,0,0,0,,(Репортер) Студенттік куәлік немесе кіру рұқсаты жоқ кез келген адам ➡
Dialogue: 0,0:46:03.26,0:46:05.22,Default,,0,0,0,,Егер солай болса, мен де
Dialogue: 0,0:46:05.34,0:46:06.47,Default,,0,0,0,,Ал, мен де!
Dialogue: 0,0:46:06.59,0:46:09.01,Default,,0,0,0,,Яойорозу-сан Каминари-кун
Dialogue: 0,0:46:09.30,0:46:12.43,Default,,0,0,0,,А, мен енді түсіндім. Менің баруым керек деп ойлаймын! Бар!
Dialogue: 0,0:46:12.56,0:46:13.97,Default,,0,0,0,,Минета-кун рахмет
Dialogue: 0,0:46:14.22,0:46:15.77,Default,,0,0,0,,Жасайық, Минета!
Dialogue: 0,0:46:15.89,0:46:17.85,Default,,0,0,0,,Барымызды салайық, Минета-кун!
Dialogue: 0,0:46:18.40,0:46:20.44,Default,,0,0,0,,Мелисса, осында күте тұрыңыз.
Dialogue: 0,0:46:20.56,0:46:21.69,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:46:21.82,0:46:25.19,Default,,0,0,0,,Әй, бірақ Мелисаның ерекше мінезі бар...
Dialogue: 0,0:46:25.32,0:46:29.11,Default,,0,0,0,,Мұнда қауіпсіздік жүйесінің параметрлерін өзгерте алатын адам бар ма?
Dialogue: 0,0:46:29.24,0:46:30.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:30.53,0:46:33.83,Default,,0,0,0,,Мен академияның студентімін. Бұл пайдалы болады деп ойлаймын.
Dialogue: 0,0:46:33.95,0:46:34.79,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:46:35.70,0:46:39.92,Default,,0,0,0,,Жоғарғы қабатқа жеткенше бұл тек кедергі.
Dialogue: 0,0:46:40.21,0:46:42.21,Default,,0,0,0,,Маған да барлығын қорғауға рұқсат етіңіз.
Dialogue: 0,0:46:42.34,0:46:43.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:43.30,0:46:44.42,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:46:47.09,0:46:48.09,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:46:49.26,0:46:52.18,Default,,0,0,0,,үшінмызға көмектесейік.
Dialogue: 0,0:46:54.26,0:46:55.27,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:46:58.02,0:46:59.69,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:47:00.60,0:47:01.90,Default,,0,0,0,,Жас Мидория!
Dialogue: 0,0:47:03.48,0:47:05.65,Default,,0,0,0,,Бұл көздер...
Dialogue: 0,0:47:06.36,0:47:07.69,Default,,0,0,0,,Жоқ, қаш.
Dialogue: 0,0:47:08.24,0:47:09.82,Default,,0,0,0,,Жоқ, мен қашпаймын.
Dialogue: 0,0:47:10.11,0:47:11.49,Default,,0,0,0,,Тым қауіпті
Dialogue: 0,0:47:11.82,0:47:14.33,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасағым келеді!
Dialogue: 0,0:47:15.41,0:47:16.95,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,0:47:17.20,0:47:19.08,Default,,0,0,0,,Біз сізге міндетті түрде көмектесеміз!
Dialogue: 0,0:47:20.75,0:47:22.38,Default,,0,0,0,,Сіз әлі барасыз ба?
Dialogue: 0,0:47:22.83,0:47:24.29,Default,,0,0,0,,Мұғалім ретінде акт...
Dialogue: 0,0:47:24.42,0:47:27.30,Default,,0,0,0,,Мен сын айтуым керек екенін білемін.
Dialogue: 0,0:47:28.26,0:47:29.30,Default,,0,0,0,,Бірақ-
Dialogue: 0,0:47:30.05,0:47:33.30,Default,,0,0,0,,Бұл жерден көшпесең, батыр емессің.
Dialogue: 0,0:47:34.10,0:47:36.14,Default,,0,0,0,,Онда мен күтемін!
Dialogue: 0,0:47:37.02,0:47:40.98,Default,,0,0,0,,Сіз бұл жағдайдан өтесіз деп сенемін.
Dialogue: 0,0:47:41.56,0:47:44.23,Default,,0,0,0,,Өтінемін, құнарлы жұмыртқалар!
Dialogue: 0,0:47:44.77,0:47:45.69,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:47:45.82,0:47:46.90,Default,,0,0,0,,О!
Dialogue: 0,0:47:56.37,0:47:57.95,Default,,0,0,0,,Мен сені осында әкелдім.
Dialogue: 0,0:47:58.08,0:48:00.29,Default,,0,0,0,,Сақтау бөлмесін мүмкіндігінше тезірек қорғаңыз
Dialogue: 0,0:48:00.79,0:48:02.58,Default,,0,0,0,,бастық
Dialogue: 0,0:48:03.50,0:48:06.50,Default,,0,0,0,,Өлгің келмесе, тездет.
Dialogue: 0,0:48:08.01,0:48:09.46,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:48:09.80,0:48:11.05,Default,,0,0,0,,Мені ал
Dialogue: 0,0:48:11.34,0:48:12.34,Default,,0,0,0,,Шығыңыз
Dialogue: 0,0:48:18.43,0:48:19.60,Default,,0,0,0,,Бұл 30-қабат
Dialogue: 0,0:48:19.73,0:48:21.27,Default,,0,0,0,,Мелисса, жоғарғы қабат ше?
Dialogue: 0,0:48:23.23,0:48:24.98,Default,,0,0,0,,200-қабат (Қанари) Шынайы ма?
Dialogue: 0,0:48:25.36,0:48:27.11,Default,,0,0,0,,Бұл шынымен де соншалықты жоғары ма?
Dialogue: 0,0:48:27.23,0:48:29.19,Default,,0,0,0,,Жаман адаммен кездескеннен жақсы.
Dialogue: 0,0:48:29.32,0:48:33.32,Default,,0,0,0,,(Декудың ауыр тыныс алуы)
Dialogue: 0,0:48:33.45,0:48:35.12,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:48:35.95,0:48:38.83,Default,,0,0,0,,Мелисса, мен өз мінезімді пайдалануым керек пе?
Dialogue: 0,0:48:39.54,0:48:41.87,Default,,0,0,0,,Рахмет, бірақ бәрібір.
Dialogue: 0,0:48:42.00,0:48:45.29,Default,,0,0,0,,Бұл қуатты төтенше жағдай үшін сақтаңыз.
Dialogue: 0,0:48:50.01,0:48:50.84,Default,,0,0,0,,Хэ-хэ…
Dialogue: 0,0:48:53.59,0:48:55.89,Default,,0,0,0,,А, ысырма...
Dialogue: 0,0:48:56.26,0:48:58.26,Default,,0,0,0,,Мен не істеуім керек? Оны құрту керек пе?
Dialogue: 0,0:48:58.39,0:48:59.64,Default,,0,0,0,,осы қарқынмен өлтіруді жалғастыру қауіпті деп ойлаймын.
Dialogue: 0,0:48:59.77,0:49:02.73,Default,,0,0,0,,Қауіпсіздік жүйесі әрекет етеді және зұлым адам сізді байқайды.
Dialogue: 0,0:49:03.14,0:49:04.94,Default,,0,0,0,,Осы жерден кетсеңіз...
Dialogue: 0,0:49:05.27,0:49:07.15,Default,,0,0,0,,Минета-кун, жоқ!
Dialogue: 0,0:49:08.02,0:49:08.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:08.98,0:49:09.82,Default,,0,0,0,,Не?
Dialogue: 0,0:49:09.94,0:49:11.82,Default,,0,0,0,,80-қабаттың есігі ашылды?
Dialogue: 0,0:49:12.32,0:49:14.95,Default,,0,0,0,,Әр қабатты сканерлеу кезінде қате жібердіңіз бе?
Dialogue: 0,0:49:15.07,0:49:15.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:17.49,0:49:19.87,Default,,0,0,0,,80-қабаттағы барлық қалқаларды төмендетіңіз
Dialogue: 0,0:49:20.49,0:49:21.50,Default,,0,0,0,,Балалардың қашып кетуіне жол бермеңіз
Dialogue: 0,0:49:21.62,0:49:22.45,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:49:22.83,0:49:24.71,Default,,0,0,0,,(Барлық мүмкін жөтел)
Dialogue: 0,0:49:24.83,0:49:26.46,Default,,0,0,0,,үшінңыз сақ болыңыздар.
Dialogue: 0,0:49:27.00,0:49:29.46,Default,,0,0,0,,Жамандар айлакер.
Dialogue: 0,0:49:31.09,0:49:32.42,Default,,0,0,0,,Жоғары көтерілудің тағы қандай жолдары бар?
Dialogue: 0,0:49:32.76,0:49:35.72,Default,,0,0,0,,Екінші жағында бірдей құрылымы бар өрт сатысы бар.
Dialogue: 0,0:49:35.84,0:49:36.80,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:49:38.22,0:49:39.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:39.51,0:49:40.89,Default,,0,0,0,,Ысырма...
Dialogue: 0,0:49:41.43,0:49:42.93,Default,,0,0,0,,Сондай-ақ артқы жағында
Dialogue: 0,0:49:43.06,0:49:43.98,Default,,0,0,0,,Қашан басталғанын білгім келеді
Dialogue: 0,0:49:44.10,0:49:45.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:48.48,0:49:51.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:52.48,0:49:54.11,Default,,0,0,0,,Осыны еңсерейік
Dialogue: 0,0:49:55.74,0:49:57.36,Default,,0,0,0,,Мен әлі де оның өлуін қалаймын!
Dialogue: 0,0:49:57.49,0:49:58.82,Default,,0,0,0,,Өсімдік
Dialogue: 0,0:49:59.07,0:50:01.28,Default,,0,0,0,,Тұлға әсер ететін өсімдіктерді зерттеу
Dialogue: 0,0:50:01.41,0:50:03.25,Default,,0,0,0,,Күте тұрыңыз, мынаны қараңыз.
Dialogue: 0,0:50:03.54,0:50:05.46,Default,,0,0,0,,Лифт келе жатыр.
Dialogue: 0,0:50:05.75,0:50:07.54,Default,,0,0,0,,Жауыз мені қуып келе жатты...
Dialogue: 0,0:50:07.67,0:50:09.46,Default,,0,0,0,,Жасырынып, құтылайық
Dialogue: 0,0:50:12.67,0:50:16.51,Default,,0,0,0,,Біз сол лифтпен жоғарғы қабатқа шыға алмаймыз ба?
Dialogue: 0,0:50:16.63,0:50:17.80,Default,,0,0,0,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,0:50:17.93,0:50:20.93,Default,,0,0,0,,Лифттерді тек уәкілетті адамдар ғана басқара алады.
Dialogue: 0,0:50:21.05,0:50:24.56,Default,,0,0,0,,Ол баспанадай берік салынған, сондықтан оны бұзуға болмайды.
Dialogue: 0,0:50:24.68,0:50:27.31,Default,,0,0,0,,Қолдансын, өркениет құралдары.
Dialogue: 0,0:50:27.44,0:50:28.65,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:50:31.15,0:50:34.69,Default,,0,0,0,,Әй, бұл киім залдағы жауыз.
Dialogue: 0,0:50:35.15,0:50:37.40,Default,,0,0,0,,Ішінде бала болса керек.
Dialogue: 0,0:50:37.53,0:50:39.57,Default,,0,0,0,,Қиындыққа тап болу
Dialogue: 0,0:50:39.82,0:50:41.70,Default,,0,0,0,,Мұнда (Иида) тыныш кел
Dialogue: 0,0:50:42.08,0:50:44.24,Default,,0,0,0,,Келме, Келме...
Dialogue: 0,0:50:44.75,0:50:46.91,Default,,0,0,0,,Кет, кет
Dialogue: 0,0:50:47.29,0:50:50.21,Default,,0,0,0,,Байқамаңыз.
Dialogue: 0,0:50:51.59,0:50:53.59,Default,,0,0,0,,Мен таптым, бейбақ!
Dialogue: 0,0:50:54.30,0:50:57.30,Default,,0,0,0,,Не істеу керек Не істеу керек...
Dialogue: 0,0:50:57.92,0:51:00.18,Default,,0,0,0,,О? Дәл қазір не болды?
Dialogue: 0,0:51:01.18,0:51:02.89,Default,,0,0,0,,Каччан Киришима-кун!
Dialogue: 0,0:51:03.22,0:51:05.47,Default,,0,0,0,,Балалар мұнда не істеп жүрсіңдер?
Dialogue: 0,0:51:05.60,0:51:06.77,Default,,0,0,0,,Мен сізден мынаны сұраймын...
Dialogue: 0,0:51:06.89,0:51:08.23,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:51:08.52,0:51:09.52,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,0:51:09.98,0:51:11.98,Default,,0,0,0,,Мм... адасып қалдық.
Dialogue: 0,0:51:12.31,0:51:14.90,Default,,0,0,0,,Қабылдау өтетін жерге қайда баруым керек?
Dialogue: 0,0:51:15.32,0:51:18.57,Default,,0,0,0,,Мен адасып қалдым, неге 80-ші қабатқа түстім?
Dialogue: 0,0:51:18.70,0:51:21.41,Default,,0,0,0,,Мұндай ашық өтірік айтпа!
Dialogue: 0,0:51:21.53,0:51:23.62,Default,,0,0,0,,Жекелік, Киришима-кун!
Dialogue: 0,0:51:25.99,0:51:28.00,Default,,0,0,0,,А, мына кісі...
Dialogue: 0,0:51:28.83,0:51:30.08,Default,,0,0,0,,Тодороки?
Dialogue: 0,0:51:32.92,0:51:33.84,Default,,0,0,0,,Чи…
Dialogue: 0,0:51:33.96,0:51:37.46,Default,,0,0,0,,Уақыт ұтамыз Биікке жету жолын табыңыз
Dialogue: 0,0:51:37.59,0:51:39.34,Default,,0,0,0,,Тодороки-кун (Иида) ше?
Dialogue: 0,0:51:39.59,0:51:41.47,Default,,0,0,0,,Алға (Йойёрозу) Тодороки-сан
Dialogue: 0,0:51:41.72,0:51:43.80,Default,,0,0,0,,Мен бұл жерді босатқаннан кейін сізге еремін.
Dialogue: 0,0:51:45.22,0:51:46.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:51:46.43,0:51:48.14,Default,,0,0,0,,Мұндағылардың бәрі...
Dialogue: 0,0:51:48.27,0:51:49.94,Default,,0,0,0,,Сіз нені айтып тұрсыз, Тодороки?
Dialogue: 0,0:51:50.06,0:51:52.31,Default,,0,0,0,,Хабар естімедің бе (Киришима)?
Dialogue: 0,0:51:52.44,0:51:54.44,Default,,0,0,0,,Бұл мұнараны зұлым адамдар басып алды.
Dialogue: 0,0:51:54.56,0:51:56.19,Default,,0,0,0,,Иә! (Кацуки) Сонымен...
Dialogue: 0,0:51:56.48,0:51:59.07,Default,,0,0,0,,Егжей-тегжейлі түсініктеме кейінірек келеді, бірақ әзірге зұлымдар туралы сөйлесейік.
Dialogue: 0,0:52:00.82,0:52:02.95,Default,,0,0,0,,Ах! (Кацуки) Бұл қандай тұлға?
Dialogue: 0,0:52:03.32,0:52:06.20,Default,,0,0,0,,Сақтығыңызды түсірмеңіз (Кацуки) Бұл өте ыстық!
Dialogue: 0,0:52:06.66,0:52:08.54,Default,,0,0,0,,Балалар...
Dialogue: 0,0:52:08.75,0:52:11.12,Default,,0,0,0,,Алаңдамаңыз!
Dialogue: 0,0:52:12.87,0:52:13.71,Default,,0,0,0,,Хмф!
Dialogue: 0,0:52:13.83,0:52:16.92,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:52:19.05,0:52:20.09,Default,,0,0,0,,Ал енді—
Dialogue: 0,0:52:20.22,0:52:21.63,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,0:52:23.64,0:52:24.51,Default,,0,0,0,,Эх… Не?
Dialogue: 0,0:52:24.64,0:52:26.39,Default,,0,0,0,,Уау...
Dialogue: 0,0:52:29.27,0:52:30.56,Default,,0,0,0,,Киришима! (Тодороки) Додж.
Dialogue: 0,0:52:33.23,0:52:35.36,Default,,0,0,0,,Шах Кора!
Dialogue: 0,0:52:38.65,0:52:41.49,Default,,0,0,0,,Балалар сендер жай балалар емессіңдер.
Dialogue: 0,0:52:41.61,0:52:42.53,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:52:42.78,0:52:45.57,Default,,0,0,0,,Мына қарғыс атқан жауызға жауап бересің бе?
Dialogue: 0,0:52:45.87,0:52:48.24,Default,,0,0,0,,Ескертудің қажеті жоқ.
Dialogue: 0,0:52:52.62,0:52:54.71,Default,,0,0,0,,Қарғыс атқыр... Бұл да жақсы емес пе?
Dialogue: 0,0:52:55.17,0:52:57.17,Default,,0,0,0,,Эй, эй, не істеуіміз керек?
Dialogue: 0,0:52:57.29,0:52:59.80,Default,,0,0,0,,Балалар, бәрің қаптағы егеуқұйрықтарсыңдар, солай емес пе?
Dialogue: 0,0:52:59.92,0:53:01.09,Default,,0,0,0,,үшін осы ма?
Dialogue: 0,0:53:01.21,0:53:02.88,Default,,0,0,0,,О, Мелисса.
Dialogue: 0,0:53:03.01,0:53:05.68,Default,,0,0,0,,Сіз бұл төбедегі есікке ұқсайтын нәрсені көре аласыз ба?
Dialogue: 0,0:53:06.09,0:53:07.26,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:53:08.01,0:53:10.81,Default,,0,0,0,,Күн жүйесіне техникалық қызмет көрсету бөлмесі
Dialogue: 0,0:53:10.93,0:53:14.77,Default,,0,0,0,,Әй, ол құрылымда апаттық баспалдақ жоқ па?
Dialogue: 0,0:53:15.19,0:53:17.48,Default,,0,0,0,,Иә, қолмен нұсқасы бар, бірақ...
Dialogue: 0,0:53:17.61,0:53:19.69,Default,,0,0,0,,Оны тек ішінен ашуға болады.
Dialogue: 0,0:53:20.44,0:53:22.61,Default,,0,0,0,,Осы уақытқа дейін келсем де...
Dialogue: 0,0:53:23.24,0:53:25.45,Default,,0,0,0,,Мүмкіндік әлі де бар. (үшін) Ах...
Dialogue: 0,0:53:28.07,0:53:28.99,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:53:31.29,0:53:35.67,Default,,0,0,0,,Желдету тесігінің саңылауы арқылы сыртқа шығып, сыртқы қабырға бойымен жоғары көтеріліңіз.
Dialogue: 0,0:53:35.79,0:53:38.71,Default,,0,0,0,,Түсінемін, егер жоғарыда ұқсас нәрсе бар болса ...
Dialogue: 0,0:53:38.84,0:53:40.21,Default,,0,0,0,,Мен сені кіргіземін.
Dialogue: 0,0:53:40.88,0:53:45.59,Default,,0,0,0,,Оны тар желдеткіш тесікке салып, сыртқы қабырға бойымен өткізу...
Dialogue: 0,0:53:46.34,0:53:47.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:47.51,0:53:49.35,Default,,0,0,0,,Сондай-ақ... мүмкін сен бе?
Dialogue: 0,0:53:49.47,0:53:50.72,Default,,0,0,0,,Минета-кун өтінемін!
Dialogue: 0,0:53:50.85,0:53:52.39,Default,,0,0,0,,Мұны тек сіз жасай аласыз.
Dialogue: 0,0:53:52.52,0:53:55.85,Default,,0,0,0,,Ақымақ, бұл қай қабат деп ойлайсың?
Dialogue: 0,0:53:56.35,0:53:58.65,Default,,0,0,0,,үшінна көмектескен еңбегі сіңген адам болсаң ше?
Dialogue: 0,0:53:58.77,0:54:02.61,Default,,0,0,0,,Ол сұхбат берді және қыздар арасында танымал.
Dialogue: 0,0:54:02.94,0:54:03.86,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:54:03.99,0:54:05.90,Default,,0,0,0,,Гарем Гаремі
Dialogue: 0,0:54:06.49,0:54:09.99,Default,,0,0,0,,Жарайды, менің кетуім керек деп ойлаймын! Жәй жүр!
Dialogue: 0,0:54:12.37,0:54:14.20,Default,,0,0,0,,Гарем Гарем Гарем
Dialogue: 0,0:54:14.33,0:54:15.33,Default,,0,0,0,,Бұл шындық. Бұл не? Бұл қол! Ауырды!
Dialogue: 0,0:54:15.71,0:54:17.33,Default,,0,0,0,,Гарем Гарем Гарем
Dialogue: 0,0:54:17.46,0:54:18.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:18.46,0:54:19.38,Default,,0,0,0,,Гарем Гарем!
Dialogue: 0,0:54:21.67,0:54:23.30,Default,,0,0,0,,Уау, солай...
Dialogue: 0,0:54:24.71,0:54:28.22,Default,,0,0,0,,Біз мұны жасадық! Біз жасадық!
Dialogue: 0,0:54:29.22,0:54:32.26,Default,,0,0,0,,Қане, жүр, мені мақта!
Dialogue: 0,0:54:32.51,0:54:34.64,Default,,0,0,0,,Тек қыздар жақсы. Тек қыздар жақсы.
Dialogue: 0,0:54:36.31,0:54:39.60,Default,,0,0,0,,Бұл ғажап, Минета-кун, батыр үміткер күткендей!
Dialogue: 0,0:54:41.48,0:54:42.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:43.02,0:54:45.24,Default,,0,0,0,,Балалар, көңіл-күйімізді көтерейік!
Dialogue: 0,0:54:45.36,0:54:46.57,Default,,0,0,0,,О!
Dialogue: 0,0:54:46.90,0:54:49.41,Default,,0,0,0,,Эй, сен оны әлі таба алмайсың ба?
Dialogue: 0,0:54:51.24,0:54:52.45,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:54:52.58,0:54:55.29,Default,,0,0,0,,Әй, 80-ші қабаттағы балалар қашып барады.
Dialogue: 0,0:54:55.41,0:54:56.62,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,0:54:56.75,0:54:58.67,Default,,0,0,0,,Шу, үндеме...
Dialogue: 0,0:54:59.37,0:55:00.46,Default,,0,0,0,,Джоэстар әулеті
Dialogue: 0,0:55:01.00,0:55:02.00,Default,,0,0,0,,Хмф!
Dialogue: 0,0:55:02.59,0:55:04.30,Default,,0,0,0,,Джоэстар әулеті
Dialogue: 0,0:55:17.77,0:55:19.89,Default,,0,0,0,,Сора Сора Сора!
Dialogue: 0,0:55:23.61,0:55:26.32,Default,,0,0,0,,Ол кеңістікте тесік жасап жатқан жоқ.
Dialogue: 0,0:55:26.44,0:55:27.82,Default,,0,0,0,,Оны ойып алыңыз
Dialogue: 0,0:55:27.94,0:55:29.82,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:55:30.57,0:55:32.74,Default,,0,0,0,,Цк... Соңы жоқ.
Dialogue: 0,0:55:32.87,0:55:36.87,Default,,0,0,0,,Мен сені мәңгілікке уайымдай алмаймын!
Dialogue: 0,0:55:37.54,0:55:39.25,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:55:39.71,0:55:43.63,Default,,0,0,0,,Хаузердің әсері!
Dialogue: 0,0:55:49.38,0:55:50.80,Default,,0,0,0,,Жарайсың (Тодороки) Бакугу!
Dialogue: 0,0:55:55.22,0:55:56.68,Default,,0,0,0,,Цк... а?
Dialogue: 0,0:55:57.10,0:55:58.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:55:58.27,0:55:59.93,Default,,0,0,0,,Бұл менің қолымның тері
Dialogue: 0,0:56:00.64,0:56:02.44,Default,,0,0,0,,Nitro керемет көрінеді
Dialogue: 0,0:56:04.40,0:56:05.36,Default,,0,0,0,,Хмф!
Dialogue: 0,0:56:06.11,0:56:06.98,Default,,0,0,0,,Ха…
Dialogue: 0,0:56:11.36,0:56:12.45,Default,,0,0,0,,Гррр…
Dialogue: 0,0:56:14.03,0:56:14.99,Default,,0,0,0,,Гах...
Dialogue: 0,0:56:16.49,0:56:18.08,Default,,0,0,0,,Киришима! (Тодороки) Жақсысың ба?
Dialogue: 0,0:56:18.20,0:56:21.25,Default,,0,0,0,,Уф... Мен қозғала алмаймын, көмектесіңізші.
Dialogue: 0,0:56:22.12,0:56:25.67,Default,,0,0,0,,Сен ақымақсың ба? Сізге тек өзіңіздің жеке даралығыңызды анықтау керек.
Dialogue: 0,0:56:25.88,0:56:27.88,Default,,0,0,0,,А, мен түсіндім...
Dialogue: 0,0:56:28.59,0:56:30.13,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:56:30.51,0:56:32.55,Default,,0,0,0,,Жарақат алмағаныңызға қуаныштымын.
Dialogue: 0,0:56:32.68,0:56:34.43,Default,,0,0,0,,О, балалар
Dialogue: 0,0:56:34.55,0:56:35.39,Default,,0,0,0,,Ай жарығы қайтадан жарқыраған сәтте дейік
Dialogue: 0,0:56:37.26,0:56:38.52,Default,,0,0,0,,осылай тез жетіп келетін бе еді?
Dialogue: 0,0:56:38.64,0:56:41.14,Default,,0,0,0,,Бұл олай емес. Бұл жөнінде уайымдамаңыз.
Dialogue: 0,0:56:41.27,0:56:42.31,Default,,0,0,0,,Бұлай етпе!
Dialogue: 0,0:56:42.64,0:56:44.56,Default,,0,0,0,,Жарайды, Мидория мен басқалардың артынан барайық.
Dialogue: 0,0:56:44.69,0:56:45.77,Default,,0,0,0,,Бұйрық бермеу
Dialogue: 0,0:56:46.19,0:56:47.98,Default,,0,0,0,,Тодороки, маған егжей-тегжейлі айтып беріңізші.
Dialogue: 0,0:56:53.07,0:56:55.62,Default,,0,0,0,,Олар байыпты болып бара жатқан сияқты.
Dialogue: 0,0:56:55.87,0:56:58.49,Default,,0,0,0,,Бастық, олар жай балалар емес.
Dialogue: 0,0:56:59.04,0:57:02.25,Default,,0,0,0,,Юэй орта мектебінің батыр бөлімі Батырды дайындау армиясы
Dialogue: 0,0:57:02.54,0:57:06.50,Default,,0,0,0,,Баланың мақсаты қауіпсіздік жүйесін қалпына келтіру болса керек.
Dialogue: 0,0:57:07.21,0:57:09.92,Default,,0,0,0,,80-қабаттағы күзет машинасын қостыңыз ба?
Dialogue: 0,0:57:10.05,0:57:11.05,Default,,0,0,0,,Иә
Dialogue: 0,0:57:11.30,0:57:15.09,Default,,0,0,0,,Олай болса, барлық қалқаларды 100-ші қабаттан 130-қабатқа көтеріңіз.
Dialogue: 0,0:57:15.34,0:57:15.97,Default,,0,0,0,,А...
Dialogue: 0,0:57:15.97,0:57:16.34,Default,,0,0,0,,А...
Dialogue: 0,0:57:15.97,0:57:16.34,Default,,0,0,0,,Менің айтқанымды істе
Dialogue: 0,0:57:16.34,0:57:17.76,Default,,0,0,0,,Менің айтқанымды істе
Dialogue: 0,0:57:20.43,0:57:21.47,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:57:21.98,0:57:24.77,Default,,0,0,0,,Мен 100-ші қабаттан өткеннен бері жапқыштар ашық қалды.
Dialogue: 0,0:57:25.15,0:57:27.36,Default,,0,0,0,,Бізді көрмей қалдың ба?
Dialogue: 0,0:57:27.48,0:57:28.61,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:57:28.86,0:57:31.15,Default,,0,0,0,,Бізді азғырып жатыр.
Dialogue: 0,0:57:31.28,0:57:32.11,Default,,0,0,0,,О
Dialogue: 0,0:57:32.40,0:57:34.86,Default,,0,0,0,,Сөйтсе де сәл жоғары көтерілу үшін...
Dialogue: 0,0:57:35.41,0:57:37.57,Default,,0,0,0,,Біреудің шақыруын қабылдаңыз
Dialogue: 0,0:57:41.45,0:57:43.16,Default,,0,0,0,,Қандай сан...
Dialogue: 0,0:57:43.29,0:57:45.67,Default,,0,0,0,,Өйткені, екінші тарап шектелмейді
Dialogue: 0,0:57:45.79,0:57:47.50,Default,,0,0,0,,Сіз оны ұстау туралы ойыңызды өзгерттіңіз бе?
Dialogue: 0,0:57:47.63,0:57:51.05,Default,,0,0,0,,Олардың біздің батыр екенімізді білгеніне сенімдімін.
Dialogue: 0,0:57:52.38,0:57:55.97,Default,,0,0,0,,Бірақ біз де солай болады деп күткен едік.
Dialogue: 0,0:57:56.18,0:57:58.85,Default,,0,0,0,,А, жоспарлағандай А жоспарымен жүрейік.
Dialogue: 0,0:57:58.97,0:57:59.80,Default,,0,0,0,,Каминари-кун
Dialogue: 0,0:58:00.10,0:58:02.18,Default,,0,0,0,,Жарайды, мен де істеймін.
Dialogue: 0,0:58:02.64,0:58:04.27,Default,,0,0,0,,Өтінемін, Иида! (Иида) Ах!
Dialogue: 0,0:58:05.73,0:58:08.23,Default,,0,0,0,,Ой!
Dialogue: 0,0:58:08.98,0:58:11.23,Default,,0,0,0,,Бөлексіз тамақ ішу
Dialogue: 0,0:58:11.73,0:58:14.44,Default,,0,0,0,,1,3 миллион вольт!
Dialogue: 0,0:58:16.11,0:58:17.07,Default,,0,0,0,,Қорғады
Dialogue: 0,0:58:17.20,0:58:18.03,Default,,0,0,0,,Чи…
Dialogue: 0,0:58:18.16,0:58:22.45,Default,,0,0,0,,2 миллион вольт!
Dialogue: 0,0:58:22.66,0:58:24.33,Default,,0,0,0,,Идиот, егер солай істесең...
Dialogue: 0,0:58:25.83,0:58:27.25,Default,,0,0,0,,Жол...
Dialogue: 0,0:58:27.50,0:58:29.33,Default,,0,0,0,,Сен ақымақ боласың.
Dialogue: 0,0:58:29.63,0:58:32.05,Default,,0,0,0,,Бірақ сіздің арқаңызда мен күзет машинасын тоқтата алдым...
Dialogue: 0,0:58:33.25,0:58:34.09,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:58:34.46,0:58:36.72,Default,,0,0,0,,Каминари! (Минета) Бұл тым берік.
Dialogue: 0,0:58:37.93,0:58:40.39,Default,,0,0,0,,Оған көмектесу мүмкін емес, бәрі, В жоспары!
Dialogue: 0,0:58:40.51,0:58:41.43,Default,,0,0,0,,Иә
Dialogue: 0,0:58:42.93,0:58:43.89,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:58:45.81,0:58:47.81,Default,,0,0,0,,Енді сіз байланысқа кедергі жасай аласыз.
Dialogue: 0,0:58:48.10,0:58:49.27,Default,,0,0,0,,Бұл! сәуле!
Dialogue: 0,0:58:49.40,0:58:50.23,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,0:58:52.69,0:58:53.57,Default,,0,0,0,,Минета-кун
Dialogue: 0,0:58:53.98,0:58:57.40,Default,,0,0,0,,Каминарды қайтарыңыз, гарем сізді күтуде!
Dialogue: 0,0:59:00.03,0:59:01.74,Default,,0,0,0,,Сіз қалай ойлайсыз? Эх...
Dialogue: 0,0:59:02.16,0:59:03.74,Default,,0,0,0,,Тәртіп...
Dialogue: 0,0:59:04.91,0:59:06.45,Default,,0,0,0,,Кеттік, Мидория-кун!
Dialogue: 0,0:59:06.58,0:59:07.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:59:11.96,0:59:15.30,Default,,0,0,0,,Бірге барлығы үшін: Толық капюшон!
Dialogue: 0,0:59:16.01,0:59:18.09,Default,,0,0,0,,Толық Gauntlet
Dialogue: 0,0:59:18.59,0:59:20.26,Default,,0,0,0,,Егер сіз мұны кисеңіз
Dialogue: 0,0:59:20.39,0:59:23.10,Default,,0,0,0,,Менің ойымша, Деку-кун өзінің шынайы күшін көрсете алады.
Dialogue: 0,0:59:23.22,0:59:26.18,Default,,0,0,0,,Алдымен 30% күш қолданыңыз.
Dialogue: 0,0:59:26.47,0:59:28.98,Default,,0,0,0,,Smash!
Dialogue: 0,0:59:30.73,0:59:33.06,Default,,0,0,0,,Ауырмайды, қолым жақсы.
Dialogue: 0,0:59:33.82,0:59:34.82,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:59:34.94,0:59:36.78,Default,,0,0,0,,Жол...
Dialogue: 0,0:59:37.82,0:59:40.07,Default,,0,0,0,,Джиро-кун, күзет машинасы ше?
Dialogue: 0,0:59:40.20,0:59:41.20,Default,,0,0,0,,Сол жақтан келеді
Dialogue: 0,0:59:41.57,0:59:44.16,Default,,0,0,0,,Жарайды, оң жақтан алға жылжайық (барлығы) Иә!
Dialogue: 0,0:59:44.41,0:59:46.87,Default,,0,0,0,,Деку-кун, сенің қолдарың керемет.
Dialogue: 0,0:59:47.00,0:59:47.95,Default,,0,0,0,,Иә
Dialogue: 0,0:59:48.08,0:59:49.83,Default,,0,0,0,,Мелисса, бұл тамаша.
Dialogue: 0,0:59:49.96,0:59:51.04,Default,,0,0,0,,Сіз оны өзіңізбен бірге алып келдіңіз.
Dialogue: 0,0:59:51.17,0:59:53.92,Default,,0,0,0,,А... Мен оны қалай алып тастауды білмеймін.
Dialogue: 0,0:59:54.50,0:59:55.34,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:59:55.46,0:59:58.21,Default,,0,0,0,,Босс Қауіпсіздік машинасының сенсоры дұрыс жұмыс істемейді!
Dialogue: 0,0:59:58.34,1:00:00.22,Default,,0,0,0,,Мен балалардың ізін жоғалттым.
Dialogue: 0,1:00:00.34,1:00:01.43,Default,,0,0,0,,Біртүрлі. Шынында да, бәрі біртүрлі.
Dialogue: 0,1:00:01.97,1:00:06.89,Default,,0,0,0,,Балалардың арасында есту қабілеті жақсы біреу бар шығар.
Dialogue: 0,1:00:07.02,1:00:10.06,Default,,0,0,0,,Төмендегі еденнен көптеген күзет машиналарының дыбыстары шығады.
Dialogue: 0,1:00:10.18,1:00:11.14,Default,,0,0,0,,Жоғарыдан шыққан дыбыс ше?
Dialogue: 0,1:00:11.27,1:00:13.27,Default,,0,0,0,,Жоқ, жарайды (Иида) Кеттік!
Dialogue: 0,1:00:19.49,1:00:20.61,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:00:24.32,1:00:25.83,Default,,0,0,0,,Қарғыс атсын... бұл тұзақ па?
Dialogue: 0,1:00:26.12,1:00:27.24,Default,,0,0,0,,Жарып өтейік, Иида-кун
Dialogue: 0,1:00:27.37,1:00:28.49,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,1:00:28.62,1:00:32.71,Default,,0,0,0,,Мұндағы сервер зақымдалған болса, қауіпсіздік жүйесі де әсер етуі мүмкін.
Dialogue: 0,1:00:32.83,1:00:33.88,Default,,0,0,0,,(шу)
Dialogue: 0,1:00:36.17,1:00:37.80,Default,,0,0,0,,Бұл қандай жақсы!
Dialogue: 0,1:00:38.34,1:00:40.76,Default,,0,0,0,,Біз қауіпсіздік машиналарын тоқтатамыз.
Dialogue: 0,1:00:40.88,1:00:44.43,Default,,0,0,0,,Мидория-кун, Мелиссаны алып, басқа жолды табыңыз.
Dialogue: 0,1:00:45.43,1:00:47.18,Default,,0,0,0,,Мелисса, өтінемін!
Dialogue: 0,1:00:48.85,1:00:50.27,Default,,0,0,0,,Очако-сан, менімен бірге жүрші.
Dialogue: 0,1:00:50.39,1:00:51.56,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,1:00:51.93,1:00:53.52,Default,,0,0,0,,Урарака-кун өтінемін
Dialogue: 0,1:00:53.94,1:00:54.90,Default,,0,0,0,,Иә
Dialogue: 0,1:00:58.44,1:01:00.36,Default,,0,0,0,,Айналу моменті…
Dialogue: 0,1:01:01.07,1:01:03.74,Default,,0,0,0,,Жоқ, ештеңе байқалған жоқ.
Dialogue: 0,1:01:04.86,1:01:06.45,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,1:01:08.41,1:01:10.08,Default,,0,0,0,,Атқышты маған қалдырыңыз
Dialogue: 0,1:01:10.41,1:01:12.62,Default,,0,0,0,,Мен оқша құрам (Джиро) Түсінікті.
Dialogue: 0,1:01:18.38,1:01:20.38,Default,,0,0,0,,Мен гаремнен бас тартпаймын.
Dialogue: 0,1:01:20.51,1:01:21.55,Default,,0,0,0,,Жол
Dialogue: 0,1:01:24.68,1:01:25.72,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,1:01:30.26,1:01:31.10,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:31.22,1:01:32.93,Default,,0,0,0,,Деку-кун, сен тоқтай алмайсың!
Dialogue: 0,1:01:33.48,1:01:37.19,Default,,0,0,0,,Бізді осы жерден ұстасақ, Иида-кун мен басқалардың қалуының мәні болмас еді.
Dialogue: 0,1:01:37.40,1:01:38.69,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:01:39.36,1:01:41.98,Default,,0,0,0,,үшінңыз аман болыңыздар.
Dialogue: 0,1:01:45.66,1:01:46.20,Default,,0,0,0,,Қозғалтқыш тоқтап қалды!
Dialogue: 0,1:01:46.20,1:01:46.95,Default,,0,0,0,,Қозғалтқыш тоқтап қалды!
Dialogue: 0,1:01:47.62,1:01:48.74,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,1:01:49.03,1:01:50.12,Default,,0,0,0,,Иида!
Dialogue: 0,1:01:50.24,1:01:51.95,Default,,0,0,0,,Яомомо, оқ...
Dialogue: 0,1:01:52.16,1:01:53.37,Default,,0,0,0,,Яомомо
Dialogue: 0,1:01:53.50,1:01:55.96,Default,,0,0,0,,Сонымен... шығармашылықтың шегі...
Dialogue: 0,1:01:56.37,1:01:58.88,Default,,0,0,0,,Менің бас терісімнің де шегі бар.
Dialogue: 0,1:01:59.75,1:02:01.30,Default,,0,0,0,,Уау (Ёёрозу) Ах...
Dialogue: 0,1:02:01.42,1:02:04.01,Default,,0,0,0,,Хаха, себебі бала алып кетеді.
Dialogue: 0,1:02:04.55,1:02:05.76,Default,,0,0,0,,Қашқан үшеу кім?
Dialogue: 0,1:02:05.88,1:02:07.18,Default,,0,0,0,,Мен оны қазір іздеп жүрмін
Dialogue: 0,1:02:07.30,1:02:09.76,Default,,0,0,0,,Цк... бұл тітіркендіргіш.
Dialogue: 0,1:02:11.68,1:02:12.72,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:02:12.85,1:02:14.43,Default,,0,0,0,,Жел энергиясын өндіру жүйесі
Dialogue: 0,1:02:14.89,1:02:16.48,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,1:02:16.60,1:02:20.36,Default,,0,0,0,,Мұнараның ішіне көтерілсеңіз, сізді күзет машинасы күтіп тұруы керек.
Dialogue: 0,1:02:21.19,1:02:23.90,Default,,0,0,0,,Сонымен, осы жерден тікелей жоғарғы эшелондарға қарай жүріңіз.
Dialogue: 0,1:02:24.03,1:02:25.74,Default,,0,0,0,,Егер мен сол апаттық шығуға жетсем.
Dialogue: 0,1:02:26.15,1:02:27.78,Default,,0,0,0,,Сол жерге...
Dialogue: 0,1:02:28.61,1:02:31.66,Default,,0,0,0,,Егер Очако қолы тиген кез келген нәрсені салмақсыз ететін мінезге ие болса.
Dialogue: 0,1:02:32.41,1:02:33.83,Default,,0,0,0,,Бұл мүмкін
Dialogue: 0,1:02:35.46,1:02:37.50,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,1:02:39.21,1:02:41.29,Default,,0,0,0,,Мелисса, Деку мені ұстап алды.
Dialogue: 0,1:02:41.42,1:02:42.25,Default,,0,0,0,,Иә
Dialogue: 0,1:02:46.63,1:02:49.05,Default,,0,0,0,,Жүр!
Dialogue: 0,1:02:51.60,1:02:52.72,Default,,0,0,0,,Жарайды
Dialogue: 0,1:02:52.85,1:02:53.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:54.64,1:02:55.60,Default,,0,0,0,,Бұл...
Dialogue: 0,1:02:55.81,1:02:56.77,Default,,0,0,0,,Урарака!
Dialogue: 0,1:02:56.89,1:02:58.27,Default,,0,0,0,,Қиындығыңызды босатыңыз да, қашыңыз!
Dialogue: 0,1:02:58.56,1:02:59.65,Default,,0,0,0,,Декихин
Dialogue: 0,1:02:59.77,1:03:02.15,Default,,0,0,0,,Егер сіз мұны істесеңіз, сіз бәріне көмектесе алмайсыз!
Dialogue: 0,1:03:02.44,1:03:03.44,Default,,0,0,0,,Очако-сан!
Dialogue: 0,1:03:04.65,1:03:06.40,Default,,0,0,0,,Тез, тез
Dialogue: 0,1:03:06.53,1:03:09.07,Default,,0,0,0,,Тез, тез, тез!
Dialogue: 0,1:03:11.78,1:03:12.95,Default,,0,0,0,,Ха~ ха ха ха ха! Қандай бет-әлпет ол?
Dialogue: 0,1:03:16.66,1:03:18.50,Default,,0,0,0,,Тодороки-кун мен Киришима-кун!
Dialogue: 0,1:03:18.87,1:03:20.29,Default,,0,0,0,,Сіз ауырып қалдыңыз ба? Урарака
Dialogue: 0,1:03:20.42,1:03:21.92,Default,,0,0,0,,Иә, менде бәрі жақсы.
Dialogue: 0,1:03:22.04,1:03:25.25,Default,,0,0,0,,Деку мен Мелисса қазір жоғарғы қабатқа бара жатыр.
Dialogue: 0,1:03:25.59,1:03:26.96,Default,,0,0,0,,А, мен көрдім.
Dialogue: 0,1:03:27.09,1:03:29.34,Default,,0,0,0,,Біз бұл балаларды осы жерде тоқтатамыз.
Dialogue: 0,1:03:29.47,1:03:31.51,Default,,0,0,0,,Маған бұйрық берме
Dialogue: 0,1:03:31.64,1:03:34.51,Default,,0,0,0,,Бірақ комбинация жақсы (Кацуки) Бұл кім?
Dialogue: 0,1:03:34.64,1:03:35.85,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,1:03:35.97,1:03:37.14,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,1:03:37.64,1:03:39.31,Default,,0,0,0,,Деку-кун Мелисса-сан!
Dialogue: 0,1:03:39.44,1:03:41.81,Default,,0,0,0,,Бакуго, винтті Мидорияға бағыттаңыз!
Dialogue: 0,1:03:41.94,1:03:44.07,Default,,0,0,0,,Сондықтан бұйрық бермеңіз!
Dialogue: 0,1:03:48.65,1:03:49.86,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,1:03:53.24,1:03:54.49,Default,,0,0,0,,Уф…
Dialogue: 0,1:03:55.41,1:03:56.24,Default,,0,0,0,,Ыстық ауа
Dialogue: 0,1:03:56.49,1:03:57.33,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,1:03:57.58,1:04:00.33,Default,,0,0,0,,Тодороки-кун, жалынды қолдан...
Dialogue: 0,1:04:00.96,1:04:02.33,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:04:02.79,1:04:05.09,Default,,0,0,0,,Деку-кун қабырғаға соғылады!
Dialogue: 0,1:04:05.29,1:04:06.34,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:04:06.46,1:04:07.59,Default,,0,0,0,,Толық қолаяқ-
Dialogue: 0,1:04:08.26,1:04:11.51,Default,,0,0,0,,Міт ағайдың күші болса да, мен оған үш рет төтеп бере аламын.
Dialogue: 0,1:04:12.18,1:04:14.89,Default,,0,0,0,,Қазір ұстанатын уақыт емес.
Dialogue: 0,1:04:15.01,1:04:17.10,Default,,0,0,0,,Мықтап ұстаңыз Иә!
Dialogue: 0,1:04:17.60,1:04:20.31,Default,,0,0,0,,осындай қабырғаны оңай-ақ айналып өтіп кетеді
Dialogue: 0,1:04:22.35,1:04:26.57,Default,,0,0,0,,...
Dialogue: 0,1:04:27.86,1:04:29.82,Default,,0,0,0,,Мұнараға кірді Шығарылды
Dialogue: 0,1:04:29.94,1:04:31.82,Default,,0,0,0,,Кя! Апыр-ай!
Dialogue: 0,1:04:32.70,1:04:34.16,Default,,0,0,0,,Сокиру мен басқаларды жібер.
Dialogue: 0,1:04:34.28,1:04:35.12,Default,,0,0,0,,Иә
Dialogue: 0,1:04:35.24,1:04:37.62,Default,,0,0,0,,Мен жеткенше диспетчерлік бөлмені қорғаңыз.
Dialogue: 0,1:04:38.08,1:04:41.16,Default,,0,0,0,,Шыда, шыда, Құдіретті.
Dialogue: 0,1:04:41.29,1:04:43.12,Default,,0,0,0,,Олар мұны жасайды.
Dialogue: 0,1:04:43.33,1:04:44.88,Default,,0,0,0,,Майюри сол жарыққа тартылып бара жатқандай болды
Dialogue: 0,1:04:45.17,1:04:46.79,Default,,0,0,0,,Уф...
Dialogue: 0,1:04:47.84,1:04:49.96,Default,,0,0,0,,Деку-кун, жақсысың ба?
Dialogue: 0,1:04:50.46,1:04:53.18,Default,,0,0,0,,Жарайды, бұл Мелисса.
Dialogue: 0,1:04:53.30,1:04:55.76,Default,,0,0,0,,Иә, жақсы, тек сызат.
Dialogue: 0,1:04:57.01,1:04:58.85,Default,,0,0,0,,Ха... те!
Dialogue: 0,1:04:59.27,1:05:00.98,Default,,0,0,0,,Таа! Уф...
Dialogue: 0,1:05:01.18,1:05:02.85,Default,,0,0,0,,Жиренішті бәйбішелер!
Dialogue: 0,1:05:03.44,1:05:06.15,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,1:05:06.31,1:05:08.44,Default,,0,0,0,,Батыр болма!
Dialogue: 0,1:05:10.40,1:05:11.24,Default,,0,0,0,,Хахахаха…
Dialogue: 0,1:05:11.36,1:05:12.61,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,1:05:12.74,1:05:14.61,Default,,0,0,0,,Мазалама, а...
Dialogue: 0,1:05:14.78,1:05:15.95,Default,,0,0,0,,Smash!
Dialogue: 0,1:05:15.95,1:05:17.78,Default,,0,0,0,,Smash!
Dialogue: 0,1:05:15.95,1:05:17.78,Default,,0,0,0,,Кішкентай қыз... Уау!
Dialogue: 0,1:05:18.87,1:05:20.33,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,1:05:22.04,1:05:22.87,Default,,0,0,0,,Мелисса!
Dialogue: 0,1:05:23.50,1:05:26.33,Default,,0,0,0,,Жарайды, бұл маңызды емес.
Dialogue: 0,1:05:26.46,1:05:27.59,Default,,0,0,0,,Қол
Dialogue: 0,1:05:29.00,1:05:31.80,Default,,0,0,0,,Мен сені қорғай алмағаным үшін кешір.
Dialogue: 0,1:05:32.80,1:05:34.63,Default,,0,0,0,,«Рахмет» дұрыс па?
Dialogue: 0,1:05:39.35,1:05:40.31,Default,,0,0,0,,Иә
Dialogue: 0,1:05:42.35,1:05:45.14,Default,,0,0,0,,үшінмызға көмектесейік.
Dialogue: 0,1:05:45.48,1:05:46.48,Default,,0,0,0,,Иә
Dialogue: 0,1:05:48.48,1:05:51.40,Default,,0,0,0,,(Деку мен Мелисаның ауыр тыныс алуы)
Dialogue: 0,1:05:51.61,1:05:52.57,Default,,0,0,0,,Бұл жерде!
Dialogue: 0,1:05:54.53,1:05:55.53,Default,,0,0,0,,Гррр…
Dialogue: 0,1:05:56.20,1:05:57.32,Default,,0,0,0,,Тей! (Зұлым) Уау...
Dialogue: 0,1:05:59.20,1:06:01.45,Default,,0,0,0,,Мелисса, диспетчерлік пункт қайда?
Dialogue: 0,1:06:01.99,1:06:04.04,Default,,0,0,0,,Орталық лифт алдында.
Dialogue: 0,1:06:05.67,1:06:06.50,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,1:06:09.54,1:06:11.67,Default,,0,0,0,,А, әке...
Dialogue: 0,1:06:12.05,1:06:13.09,Default,,0,0,0,,Бұл рас
Dialogue: 0,1:06:13.55,1:06:15.26,Default,,0,0,0,,Неліктен жоғарғы қабатта?
Dialogue: 0,1:06:15.38,1:06:18.43,Default,,0,0,0,,Сізді зұлым адам әкеліп, бірдеңе істеуге мәжбүр етті ме?
Dialogue: 0,1:06:18.55,1:06:19.64,Default,,0,0,0,,және Қабырғаларды жоюды жоспарлап жүргендерді қудалау қиындайды.
Dialogue: 0,1:06:19.76,1:06:20.72,Default,,0,0,0,,Иә
Dialogue: 0,1:06:25.64,1:06:26.94,Default,,0,0,0,,(дыбыс шығару)
Dialogue: 0,1:06:27.06,1:06:27.90,Default,,0,0,0,,О...
Dialogue: 0,1:06:28.40,1:06:31.02,Default,,0,0,0,,Код құлпы ашылған 1147 блоктау үшін
Dialogue: 0,1:06:31.15,1:06:32.11,Default,,0,0,0,,Иә
Dialogue: 0,1:06:33.11,1:06:34.24,Default,,0,0,0,,Ашық
Dialogue: 0,1:06:38.16,1:06:40.28,Default,,0,0,0,,Сіз жасадыңыз, доктор.
Dialogue: 0,1:06:40.66,1:06:41.91,Default,,0,0,0,,Онда бәрі бар
Dialogue: 0,1:06:43.04,1:06:44.16,Default,,0,0,0,,О
Dialogue: 0,1:06:44.95,1:06:46.96,Default,,0,0,0,,Ақыры оны қайтарып алды
Dialogue: 0,1:06:48.12,1:06:51.92,Default,,0,0,0,,Мен бұл құрылғыны және зерттеу деректерін ешкімге бермеймін.
Dialogue: 0,1:06:52.75,1:06:54.46,Default,,0,0,0,,Беретін нәрсе ме?
Dialogue: 0,1:06:54.96,1:06:56.30,Default,,0,0,0,,Жоспармен бірдей.
Dialogue: 0,1:06:56.76,1:06:59.22,Default,,0,0,0,,Жамандардың да ісі жақсы сияқты.
Dialogue: 0,1:06:59.39,1:07:00.34,Default,,0,0,0,,Рахмет
Dialogue: 0,1:07:00.47,1:07:03.35,Default,,0,0,0,,Оларды реттегеніңіз үшін рахмет, Сэм.
Dialogue: 0,1:07:03.47,1:07:04.31,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,1:07:04.43,1:07:05.39,Default,,0,0,0,,А... (Дэвид) Иә?
Dialogue: 0,1:07:07.23,1:07:09.02,Default,,0,0,0,,Ерлер... Мелисса
Dialogue: 0,1:07:09.15,1:07:11.77,Default,,0,0,0,,Жас ханым, мұнда неге келдің?
Dialogue: 0,1:07:12.65,1:07:14.61,Default,,0,0,0,,«Орналастырылған» нені білдіреді?
Dialogue: 0,1:07:17.07,1:07:20.57,Default,,0,0,0,,Бұл оқиғаны сіздің әкеңіз ұйымдастырған болуы мүмкін бе?
Dialogue: 0,1:07:22.78,1:07:24.99,Default,,0,0,0,,Құрылғыны алу үшін
Dialogue: 0,1:07:27.20,1:07:28.37,Default,,0,0,0,,Солай ма? әке
Dialogue: 0,1:07:28.58,1:07:30.92,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:07:33.29,1:07:34.13,Default,,0,0,0,,Иә.
Dialogue: 0,1:07:34.34,1:07:35.84,Default,,0,0,0,,А, ә...
Dialogue: 0,1:07:35.96,1:07:38.01,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:07:38.13,1:07:41.34,Default,,0,0,0,,Дәрігер одан ұрланған затты қайтарып алды.
Dialogue: 0,1:07:41.47,1:07:45.39,Default,,0,0,0,,Бұл жаңашыл өнертабыс даралықты механикалық түрде күшейтеді.
Dialogue: 0,1:07:46.39,1:07:48.85,Default,,0,0,0,,Даралықты күшейту? Иә
Dialogue: 0,1:07:49.23,1:07:51.10,Default,,0,0,0,,Әлі прототип сатысында
Dialogue: 0,1:07:51.23,1:07:54.02,Default,,0,0,0,,Бұл құрылғыны пайдалансаңыз, химиялық заттардан айырмашылығы...
Dialogue: 0,1:07:54.15,1:07:58.03,Default,,0,0,0,,Адам ағзасына әсер етпей, даралықты күшейте алады
Dialogue: 0,1:07:59.36,1:08:04.49,Default,,0,0,0,,Дегенмен, бұл өнертабыс пен зерттеу деректерін демеуші тәркілейді.
Dialogue: 0,1:08:04.91,1:08:07.95,Default,,0,0,0,,Зерттеудің өзі де қатып қалды.
Dialogue: 0,1:08:09.75,1:08:14.79,Default,,0,0,0,,Егер бұл әлемге жария етілсе, адамнан тыс қоғамның құрылымы күрт өзгереді.
Dialogue: 0,1:08:14.92,1:08:19.47,Default,,0,0,0,,Бұдан қорыққан үкіметтер қысым көрсете бастады.
Dialogue: 0,1:08:20.38,1:08:22.18,Default,,0,0,0,,Сонымен дәрігер...
Dialogue: 0,1:08:23.80,1:08:25.22,Default,,0,0,0,,Мен зерттеуімді қайтара аламын ба?
Dialogue: 0,1:08:25.76,1:08:27.26,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,1:08:27.60,1:08:30.98,Default,,0,0,0,,Оны біз емес, жауыздар ұрласын.
Dialogue: 0,1:08:31.56,1:08:34.27,Default,,0,0,0,,Я... бұл ақымақтық
Dialogue: 0,1:08:34.40,1:08:37.27,Default,,0,0,0,,Олар нағыз жауыз болу міндетті емес
Dialogue: 0,1:08:37.40,1:08:38.23,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:38.69,1:08:42.78,Default,,0,0,0,,Біреуді зұлым етіп көрсету және оны ұрланған деп көрсету үшін жалдаңыз
Dialogue: 0,1:08:43.07,1:08:46.53,Default,,0,0,0,,Әрине, адамдарға зияны болмайды.
Dialogue: 0,1:08:46.66,1:08:50.45,Default,,0,0,0,,Содан кейін зерттеуімізді басқа жерде жалғастырамыз.
Dialogue: 0,1:08:51.29,1:08:52.50,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:08:52.75,1:08:55.58,Default,,0,0,0,,Дегенмен, мен өз зерттеулерімді қайтарғым келеді
Dialogue: 0,1:08:56.09,1:08:58.34,Default,,0,0,0,,Дәрігер де солай емес пе?
Dialogue: 0,1:09:00.26,1:09:02.13,Default,,0,0,0,,Шаралар орындалды
Dialogue: 0,1:09:02.26,1:09:06.26,Default,,0,0,0,,Мұнара I-Expo ашылуы алдында жабылатын күні жабылады
Dialogue: 0,1:09:06.39,1:09:08.47,Default,,0,0,0,,Барлық қатысушылар бір жерде кездесетін жалғыз орын.
Dialogue: 0,1:09:08.60,1:09:12.43,Default,,0,0,0,,Операция қабылдау кеші өтетін уақытта басталады.
Dialogue: 0,1:09:12.56,1:09:14.77,Default,,0,0,0,,Біз оларды сахнаның артына бағыттаймыз.
Dialogue: 0,1:09:14.90,1:09:18.32,Default,,0,0,0,,Зұлым адам I-аралды басып алғандай етіп көрсетіңіз.
Dialogue: 0,1:09:21.32,1:09:22.15,Default,,0,0,0,,Dr.
Dialogue: 0,1:09:26.78,1:09:28.03,Default,,0,0,0,,Бұл...
Dialogue: 0,1:09:28.99,1:09:30.79,Default,,0,0,0,,Бұл өтірік, әке.
Dialogue: 0,1:09:31.70,1:09:33.71,Default,,0,0,0,,Өтірік деп айт (Дэвид) Бұл өтірік емес
Dialogue: 0,1:09:34.04,1:09:35.04,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:35.92,1:09:37.92,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,1:09:39.38,1:09:42.72,Default,,0,0,0,,Мен білетін әкелер ешқашан олай жасамайды.
Dialogue: 0,1:09:42.84,1:09:44.34,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,1:09:44.47,1:09:45.89,Default,,0,0,0,,Неге...
Dialogue: 0,1:09:48.22,1:09:49.81,Default,,0,0,0,,Бұл барлық мүмкіншіліктерге арналған.
Dialogue: 0,1:09:50.26,1:09:51.31,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:51.43,1:09:55.90,Default,,0,0,0,,Сіз оны білмеуіңіз мүмкін, бірақ оның тұлғасы жоғалып барады.
Dialogue: 0,1:09:56.56,1:09:57.52,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:58.06,1:10:01.69,Default,,0,0,0,,Бірақ мен жабдықтың көмегімен оны қалпына келтіре аламын.
Dialogue: 0,1:10:02.03,1:10:05.53,Default,,0,0,0,,Жоқ, сіз оған одан да көп қабілет бере аласыз.
Dialogue: 0,1:10:06.66,1:10:10.20,Default,,0,0,0,,Бірінші нөмірлі батыр – бейбітшілік символы...
Dialogue: 0,1:10:10.53,1:10:13.20,Default,,0,0,0,,Жарықты қайтадан алуға болады
Dialogue: 0,1:10:14.16,1:10:17.29,Default,,0,0,0,,Сіз көптеген адамдарға көмектесе аласыз.
Dialogue: 0,1:10:18.29,1:10:22.25,Default,,0,0,0,,Өйткені, мен «Біреу үшін» мұрагер болдым
Dialogue: 0,1:10:22.50,1:10:25.84,Default,,0,0,0,,Бүкіл Құдірет өз күшін жоғалтады деп алаңдайды
Dialogue: 0,1:10:25.97,1:10:26.93,Default,,0,0,0,,Дәрігер...
Dialogue: 0,1:10:27.22,1:10:28.14,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,1:10:28.26,1:10:31.01,Default,,0,0,0,,Let Бүкіл Құдірет сізге бұл құрылғыны береді.
Dialogue: 0,1:10:31.14,1:10:32.93,Default,,0,0,0,,Оны қайта жасауға уақытым жоқ.
Dialogue: 0,1:10:33.27,1:10:36.10,Default,,0,0,0,,Осыдан кейін мен кез келген жазаны қабылдауға дайынмын...
Dialogue: 0,1:10:36.23,1:10:37.90,Default,,0,0,0,,Менің өмірім соған байланысты болды
Dialogue: 0,1:10:38.90,1:10:43.07,Default,,0,0,0,,Деку мен оның сыныптастары тұтқынға алынған адамдарға көмектесуге тырысады.
Dialogue: 0,1:10:43.19,1:10:45.86,Default,,0,0,0,,Бұл жерге жету үшін не болды деп ойлайсың?
Dialogue: 0,1:10:48.70,1:10:50.16,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,1:10:50.70,1:10:51.66,Default,,0,0,0,,Жаман адам – жалған
Dialogue: 0,1:10:52.53,1:10:54.12,Default,,0,0,0,,Мұның бәрі пьеса болуы керек...
Dialogue: 0,1:10:54.41,1:10:57.04,Default,,0,0,0,,Әрине, мен ойнадым.
Dialogue: 0,1:10:57.46,1:11:00.25,Default,,0,0,0,,«Жалған зұлым» атты пьеса жасаңыз.
Dialogue: 0,1:11:00.46,1:11:01.29,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,1:11:04.63,1:11:06.38,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:07.26,1:11:08.38,Default,,0,0,0,,Қарсыласты әдейі қателестіруге бағытталған шабуылдар қызыл картаға әкеледі.
Dialogue: 0,1:11:08.51,1:11:11.89,Default,,0,0,0,,Уф... Металды манипуляциялай алатын тұлға ма?
Dialogue: 0,1:11:12.35,1:11:14.56,Default,,0,0,0,,Кішкене үндемеңіз.
Dialogue: 0,1:11:14.68,1:11:16.31,Default,,0,0,0,,Сэм Құрылғы туралы не деуге болады?
Dialogue: 0,1:11:16.85,1:11:18.52,Default,,0,0,0,,Ах... міне... міне.
Dialogue: 0,1:11:18.64,1:11:19.48,Default,,0,0,0,,Сэм
Dialogue: 0,1:11:21.40,1:11:24.23,Default,,0,0,0,,Мен басынан бастап құрылғыны зұлым адамға беремін деп ойламадым.
Dialogue: 0,1:11:24.36,1:11:27.03,Default,,0,0,0,,Мені алдаған сенсің.
Dialogue: 0,1:11:27.15,1:11:31.91,Default,,0,0,0,,Мен сізге көп жыл қызмет етсем де, менің зерттеуім жай ғана қатып қалды.
Dialogue: 0,1:11:32.03,1:11:34.58,Default,,0,0,0,,Даңқ алу керек болған құрмет
Dialogue: 0,1:11:35.66,1:11:38.50,Default,,0,0,0,,Бәрі жойылды...
Dialogue: 0,1:11:38.96,1:11:42.38,Default,,0,0,0,,Тым болмаса ақша таппайынша, оның құны болмайды.
Dialogue: 0,1:11:42.50,1:11:43.42,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:43.67,1:11:45.92,Default,,0,0,0,,Уәде етілген сыйлық.
Dialogue: 0,1:11:46.21,1:11:47.97,Default,,0,0,0,,Ах... Сэм.
Dialogue: 0,1:11:48.55,1:11:51.34,Default,,0,0,0,,Неліктен... неге уәделер әртүрлі?
Dialogue: 0,1:11:51.72,1:11:54.56,Default,,0,0,0,,Уәде? Мен ұмыттым
Dialogue: 0,1:11:54.93,1:11:56.85,Default,,0,0,0,,Бұл марапат.
Dialogue: 0,1:11:56.97,1:11:57.85,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:11:58.10,1:11:59.06,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:03.69,1:12:04.94,Default,,0,0,0,,Дәрігер, неге...
Dialogue: 0,1:12:05.07,1:12:06.48,Default,,0,0,0,,Кімге... Қашыңыз.
Dialogue: 0,1:12:06.86,1:12:07.78,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,1:12:07.90,1:12:08.99,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:12:09.28,1:12:10.24,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:11.16,1:12:12.53,Default,,0,0,0,,Мелисса!
Dialogue: 0,1:12:12.66,1:12:14.53,Default,,0,0,0,,(Декудың ыңырсыуы)
Dialogue: 0,1:12:15.24,1:12:16.16,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,1:12:16.29,1:12:19.87,Default,,0,0,0,,Сіз қазір батыр болып көрінесіз бе? Бұл ысырап
Dialogue: 0,1:12:20.50,1:12:24.34,Default,,0,0,0,,Қандай себеп болса да, жамандық жасадың.
Dialogue: 0,1:12:24.88,1:12:28.01,Default,,0,0,0,,Біз жалған ба, әлде шынбыз ба...
Dialogue: 0,1:12:28.13,1:12:30.34,Default,,0,0,0,,Жасаған күнәларың ешқашан кетпейді.
Dialogue: 0,1:12:31.26,1:12:33.26,Default,,0,0,0,,Біз сияқты
Dialogue: 0,1:12:33.84,1:12:39.18,Default,,0,0,0,,Сіз енді ғалым бола алмайсыз немесе зерттеуіңізді жалғастыра алмайсыз.
Dialogue: 0,1:12:39.81,1:12:42.64,Default,,0,0,0,,Жаманның қараңғылығына түсіп бара жатқанда
Dialogue: 0,1:12:42.90,1:12:44.52,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,1:12:45.23,1:12:47.23,Default,,0,0,0,,Енді не істей аласыз...
Dialogue: 0,1:12:47.36,1:12:51.11,Default,,0,0,0,,Сізге бұл құрылғыны менің қадағалауыммен сериялық түрде шығару жеткілікті.
Dialogue: 0,1:12:51.24,1:12:52.20,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:52.65,1:12:54.24,Default,,0,0,0,,Эй, мені ал.
Dialogue: 0,1:12:54.37,1:12:56.03,Default,,0,0,0,,Оны қайтару керек пе?
Dialogue: 0,1:12:56.53,1:12:59.91,Default,,0,0,0,,Па... Маған әкемді қайтарыңыз.
Dialogue: 0,1:13:00.25,1:13:04.92,Default,,0,0,0,,Дұрыс, дәрігердің ұзаққа созылған өкінішін кесу керек.
Dialogue: 0,1:13:05.08,1:13:07.46,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:13:08.30,1:13:11.51,Default,,0,0,0,,Smash!
Dialogue: 0,1:13:12.34,1:13:13.84,Default,,0,0,0,,Стрей Кэтстың ауа оқтарымен—
Dialogue: 0,1:13:13.97,1:13:14.89,Default,,0,0,0,,Мелисса
Dialogue: 0,1:13:16.68,1:13:18.56,Default,,0,0,0,,Даналар көмектеседі
Dialogue: 0,1:13:20.72,1:13:22.35,Default,,0,0,0,,Бәріңе!
Dialogue: 0,1:13:22.68,1:13:24.98,Default,,0,0,0,,Иә...
Dialogue: 0,1:13:27.19,1:13:28.52,Default,,0,0,0,,Мені қу, қашып кетпе
Dialogue: 0,1:13:28.65,1:13:29.48,Default,,0,0,0,,Иә
Dialogue: 0,1:13:30.78,1:13:31.78,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:37.37,1:13:38.20,Default,,0,0,0,,Уау
Dialogue: 0,1:13:38.33,1:13:39.79,Default,,0,0,0,,Мен сені бұл жерге жібермеймін.
Dialogue: 0,1:13:39.91,1:13:41.20,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:41.54,1:13:44.08,Default,,0,0,0,,Алаңдамаңыз!
Dialogue: 0,1:13:44.21,1:13:46.04,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,1:13:46.17,1:13:47.13,Default,,0,0,0,,үшін
Dialogue: 0,1:13:47.67,1:13:48.71,Default,,0,0,0,,үшін
Dialogue: 0,1:13:49.25,1:13:50.84,Default,,0,0,0,,үшін мүмкін
Dialogue: 0,1:13:51.55,1:13:52.76,Default,,0,0,0,,Әке
Dialogue: 0,1:13:53.26,1:13:55.30,Default,,0,0,0,,Мүлдем
Dialogue: 0,1:13:55.68,1:13:58.97,Default,,0,0,0,,Мен сізге міндетті түрде көмектесемін!
Dialogue: 0,1:14:04.23,1:14:05.06,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:14:05.31,1:14:08.61,Default,,0,0,0,,Tsk... Сіз қауіпсіздік жүйесін кері қайтардыңыз ба?
Dialogue: 0,1:14:10.07,1:14:11.90,Default,,0,0,0,,Иә?Не?
Dialogue: 0,1:14:12.03,1:14:13.32,Default,,0,0,0,,тоқтатылды
Dialogue: 0,1:14:13.78,1:14:16.16,Default,,0,0,0,,Мидория-кун, сен істедің бе?
Dialogue: 0,1:14:16.66,1:14:20.12,Default,,0,0,0,,I-Island қауіпсіздік жүйесі қазір қалыпты режимде.
Dialogue: 0,1:14:20.24,1:14:23.16,Default,,0,0,0,,Мен қайтамын. (Серо) Менің ұялы телефоным да қосылған.
Dialogue: 0,1:14:24.16,1:14:25.62,Default,,0,0,0,,Неліктен кенеттен?
Dialogue: 0,1:14:25.79,1:14:26.87,Default,,0,0,0,,Не болды... (Қытай батыры) Тэй!
Dialogue: 0,1:14:27.00,1:14:27.88,Default,,0,0,0,,Боқ... (Пластик мырза) Хмф!
Dialogue: 0,1:14:28.29,1:14:29.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:14:30.17,1:14:32.88,Default,,0,0,0,,Бәрің орындадыңдар ма?
Dialogue: 0,1:14:34.38,1:14:36.43,Default,,0,0,0,,Тікұшақтар туралы не деуге болады? (Зұлым) келді
Dialogue: 0,1:14:36.88,1:14:39.18,Default,,0,0,0,,Қашайық (жауыз)... Иә.
Dialogue: 0,1:14:42.56,1:14:43.56,Default,,0,0,0,,Уф...
Dialogue: 0,1:14:46.31,1:14:48.44,Default,,0,0,0,,Гах...
Dialogue: 0,1:14:49.27,1:14:50.77,Default,,0,0,0,,Жылжы, Изуку Мидория
Dialogue: 0,1:14:51.86,1:14:54.61,Default,,0,0,0,,Мен мұнда не үшін келдім?
Dialogue: 0,1:14:55.40,1:14:58.86,Default,,0,0,0,,Енді мен қолымнан келгенін істеймін!
Dialogue: 0,1:14:59.66,1:15:01.66,Default,,0,0,0,,Ах
Dialogue: 0,1:15:02.08,1:15:02.95,Default,,0,0,0,,Не болды, Мелисса?
Dialogue: 0,1:15:03.08,1:15:04.04,Default,,0,0,0,,Майт ағай
Dialogue: 0,1:15:04.62,1:15:07.96,Default,,0,0,0,,...
Dialogue: 0,1:15:08.33,1:15:09.71,Default,,0,0,0,,Жарайды
Dialogue: 0,1:15:10.42,1:15:12.21,Default,,0,0,0,,Мен барамын!
Dialogue: 0,1:15:16.63,1:15:18.26,Default,,0,0,0,,Бастық Басқалары ше?
Dialogue: 0,1:15:18.68,1:15:21.35,Default,,0,0,0,,Қауіпсіздік жүйесі қайта іске қосылғанша мен кетемін.
Dialogue: 0,1:15:21.47,1:15:22.51,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,1:15:23.26,1:15:25.81,Default,,0,0,0,,Мені өлтір...
Dialogue: 0,1:15:26.23,1:15:28.81,Default,,0,0,0,,Кішкене күнә жасайық
Dialogue: 0,1:15:29.77,1:15:31.98,Default,,0,0,0,,Осыдан кейін мен сенің тілегіңді орындаймын.
Dialogue: 0,1:15:36.82,1:15:38.11,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,1:15:39.86,1:15:41.41,Default,,0,0,0,,Дәрігерді қайтарыңыз!
Dialogue: 0,1:15:41.78,1:15:42.62,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:42.95,1:15:47.70,Default,,0,0,0,,көремін. Жамандық жасаған мына адамды ұстауға келдің бе?
Dialogue: 0,1:15:47.83,1:15:48.83,Default,,0,0,0,,Жоқ
Dialogue: 0,1:15:49.50,1:15:52.46,Default,,0,0,0,,Мен дәрігерге көмектесуге келдім!
Dialogue: 0,1:15:53.59,1:15:54.84,Default,,0,0,0,,Қылмыскерлер?
Dialogue: 0,1:15:57.34,1:15:59.88,Default,,0,0,0,,Мен барлығына көмектесемін!
Dialogue: 0,1:16:00.01,1:16:01.47,Default,,0,0,0,,Дәрігер де көмектеседі!
Dialogue: 0,1:16:01.59,1:16:04.22,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,1:16:04.35,1:16:05.81,Default,,0,0,0,,Шу!
Dialogue: 0,1:16:05.93,1:16:10.27,Default,,0,0,0,,Батырлар осылай істейді: мұқтаждарға көмектес!
Dialogue: 0,1:16:10.60,1:16:11.69,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,1:16:11.98,1:16:12.90,Default,,0,0,0,,Ха…
Dialogue: 0,1:16:13.52,1:16:15.90,Default,,0,0,0,,Менде бәрі жақсы. Жүгіріп кету!
Dialogue: 0,1:16:17.78,1:16:21.61,Default,,0,0,0,,...
Dialogue: 0,1:16:21.74,1:16:25.20,Default,,0,0,0,,...
Dialogue: 0,1:16:25.53,1:16:26.54,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:30.62,1:16:31.62,Default,,0,0,0,,Ах
Dialogue: 0,1:16:34.25,1:16:35.09,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,1:16:35.21,1:16:37.71,Default,,0,0,0,,Қалай болғанда да, бұл өмір сүрудің ақылды жолы емес.
Dialogue: 0,1:16:38.01,1:16:39.38,Default,,0,0,0,,Уф, айналаңа абай бол.
Dialogue: 0,1:16:39.59,1:16:41.59,Default,,0,0,0,,Шығар (жауыз) Түсінікті
Dialogue: 0,1:16:50.31,1:16:51.89,Default,,0,0,0,,(Декудың айқайы)
Dialogue: 0,1:16:51.89,1:16:56.23,Default,,0,0,0,,(Декудың айқайы)
Dialogue: 0,1:16:51.89,1:16:56.23,Default,,0,0,0,,...
Dialogue: 0,1:16:56.40,1:16:57.23,Default,,0,0,0,,Уау
Dialogue: 0,1:16:59.40,1:17:01.53,Default,,0,0,0,,Уф...
Dialogue: 0,1:17:02.32,1:17:03.86,Default,,0,0,0,,Сен…
Dialogue: 0,1:17:06.03,1:17:07.03,Default,,0,0,0,,Ах
Dialogue: 0,1:17:07.58,1:17:08.95,Default,,0,0,0,,Қарсыласты әдейі қателестіруге бағытталған шабуылдар қызыл картаға әкеледі.
Dialogue: 0,1:17:11.08,1:17:12.41,Default,,0,0,0,,Дәрігер!
Dialogue: 0,1:17:12.54,1:17:15.04,Default,,0,0,0,,Тоқта, Мидориа-кун, қаш.
Dialogue: 0,1:17:15.17,1:17:16.46,Default,,0,0,0,,Мелисса...
Dialogue: 0,1:17:17.04,1:17:19.13,Default,,0,0,0,,Мелисса күтіп тұр!
Dialogue: 0,1:17:21.17,1:17:23.84,Default,,0,0,0,,Расында да сен батырсың.
Dialogue: 0,1:17:24.38,1:17:25.47,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,1:17:25.59,1:17:27.01,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,1:17:27.26,1:17:28.10,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:28.22,1:17:30.56,Default,,0,0,0,,Берілме, ойлан
Dialogue: 0,1:17:31.10,1:17:32.98,Default,,0,0,0,,Мен не істеуім керек? Не істеу керек?
Dialogue: 0,1:17:34.56,1:17:35.98,Default,,0,0,0,,Қарсыласты әдейі қателестіруге бағытталған шабуылдар қызыл картаға әкеледі.
Dialogue: 0,1:17:36.40,1:17:37.23,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,1:17:37.36,1:17:39.15,Default,,0,0,0,,Тыныш ұйықтаңыз.
Dialogue: 0,1:17:39.52,1:17:41.90,Default,,0,0,0,,Уф...
Dialogue: 0,1:17:42.19,1:17:43.49,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,1:17:44.07,1:17:45.66,Default,,0,0,0,,Чикушо Деку-кун
Dialogue: 0,1:17:46.03,1:17:47.07,Default,,0,0,0,,Қайта бер.
Dialogue: 0,1:17:47.20,1:17:49.41,Default,,0,0,0,,Дәрігерді қайтарыңыз!
Dialogue: 0,1:17:49.53,1:17:51.83,Default,,0,0,0,,Қат!
Dialogue: 0,1:17:52.29,1:17:55.42,Default,,0,0,0,,...
Dialogue: 0,1:17:55.67,1:17:56.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:56.92,1:17:57.75,Default,,0,0,0,,Хмф!
Dialogue: 0,1:17:59.71,1:18:01.21,Default,,0,0,0,,Хамф!
Dialogue: 0,1:18:03.01,1:18:04.88,Default,,0,0,0,,Уау... (үшін мүмкін) Қазір бәрі жақсы.
Dialogue: 0,1:18:05.01,1:18:06.55,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:18:08.64,1:18:10.43,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,1:18:12.27,1:18:13.35,Default,,0,0,0,,үшін мүмкін...
Dialogue: 0,1:18:13.64,1:18:16.31,Default,,0,0,0,,Мен ең жақын досымды қайтарамын.
Dialogue: 0,1:18:16.44,1:18:17.69,Default,,0,0,0,,Жаман!
Dialogue: 0,1:18:27.57,1:18:28.62,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:29.49,1:18:30.33,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,1:18:32.49,1:18:34.29,Default,,0,0,0,,Ерлер... Мелисса
Dialogue: 0,1:18:34.96,1:18:36.71,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,1:18:37.50,1:18:39.04,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:18:41.25,1:18:44.21,Default,,0,0,0,,Бәрі мүмкін...
Dialogue: 0,1:18:46.30,1:18:47.68,Default,,0,0,0,,Бәрі мүмкін!
Dialogue: 0,1:18:49.09,1:18:50.60,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,1:18:50.72,1:18:52.76,Default,,0,0,0,,Әке! Дәрігер!
Dialogue: 0,1:18:53.14,1:18:54.85,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:18:54.98,1:18:58.98,Default,,0,0,0,,...
Dialogue: 0,1:18:59.10,1:19:02.90,Default,,0,0,0,,Кешегі құдірет кетті десең де.
Dialogue: 0,1:19:03.02,1:19:05.36,Default,,0,0,0,,Сол дәрігер...
Dialogue: 0,1:19:05.69,1:19:07.40,Default,,0,0,0,,(Барлық мүмкін жөтел)
Dialogue: 0,1:19:07.65,1:19:10.07,Default,,0,0,0,,Қиямет! Уақыт...
Dialogue: 0,1:19:11.24,1:19:13.70,Default,,0,0,0,,Өлетін жаман уақыт!
Dialogue: 0,1:19:14.49,1:19:15.87,Default,,0,0,0,,Техас…
Dialogue: 0,1:19:17.21,1:19:19.42,Default,,0,0,0,,Smash!
Dialogue: 0,1:19:20.50,1:19:21.38,Default,,0,0,0,,Не?
Dialogue: 0,1:19:21.50,1:19:22.54,Default,,0,0,0,,Бәрі мүмкін!
Dialogue: 0,1:19:23.00,1:19:24.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:19:24.25,1:19:25.59,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,1:19:38.52,1:19:40.06,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:19:43.11,1:19:46.61,Default,,0,0,0,,Дэвид Шилд жұмысынан күткендей
Dialogue: 0,1:19:47.03,1:19:49.74,Default,,0,0,0,,Мінезім белсенді бола бастағанын байқаймын.
Dialogue: 0,1:19:49.86,1:19:54.70,Default,,0,0,0,,Хахаха... Жақсы! Бұл тамаша құрылғы!
Dialogue: 0,1:19:55.24,1:19:57.45,Default,,0,0,0,,Эй, бұл Дэйв...
Dialogue: 0,1:19:58.25,1:20:00.96,Default,,0,0,0,,Әкемнің жасаған құрылғысының қуаты
Dialogue: 0,1:20:03.46,1:20:04.96,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:20:05.42,1:20:08.47,Default,,0,0,0,,Құрал-жабдықтардың құндылығын арттыру
Dialogue: 0,1:20:08.59,1:20:13.18,Default,,0,0,0,,Мұны «Барлық Құдіретті» жеңу демонстрациясы деп атаймыз.
Dialogue: 0,1:20:13.30,1:20:15.01,Default,,0,0,0,,Хаха!
Dialogue: 0,1:20:17.35,1:20:18.39,Default,,0,0,0,,Хаха…
Dialogue: 0,1:20:18.85,1:20:20.06,Default,,0,0,0,,Иә!
Dialogue: 0,1:20:23.40,1:20:25.57,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:20:27.03,1:20:28.19,Default,,0,0,0,,Осылайша тәжірибеңіз артады және көпшіліктің назарын аударасыз
Dialogue: 0,1:20:28.82,1:20:33.03,Default,,0,0,0,,Дұрыс, бұл белсенділіктің шегі.
Dialogue: 0,1:20:33.62,1:20:36.62,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:20:39.62,1:20:40.71,Default,,0,0,0,,Ағам мүмкін...
Dialogue: 0,1:20:45.13,1:20:46.04,Default,,0,0,0,,Буха…
Dialogue: 0,1:20:46.25,1:20:48.92,Default,,0,0,0,,Тезірек құлаңыз!
Dialogue: 0,1:20:49.05,1:20:51.38,Default,,0,0,0,,Бәрі мүмкін!
Dialogue: 0,1:20:52.38,1:20:53.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:53.64,1:20:55.43,Default,,0,0,0,,Мен саған мені көріп тұрсың ба деп сұрап тұрмын, Джотаро
Dialogue: 0,1:20:55.85,1:20:56.76,Default,,0,0,0,,Цк
Dialogue: 0,1:21:00.14,1:21:04.35,Default,,0,0,0,,Қарғыс атсын... Бұл сұмдық. Соңғы бастық маған не істеді?
Dialogue: 0,1:21:04.48,1:21:06.11,Default,,0,0,0,,Не? үшін мүмкін!
Dialogue: 0,1:21:06.61,1:21:07.98,Default,,0,0,0,,Бала Бакугу...
Dialogue: 0,1:21:08.28,1:21:10.36,Default,,0,0,0,,Қазір зұлым адамды табыңыз
Dialogue: 0,1:21:10.86,1:21:13.07,Default,,0,0,0,,Тодороки-кун, бәріңе!
Dialogue: 0,1:21:13.41,1:21:15.91,Default,,0,0,0,,Біз металл кесектерін күтеміз!
Dialogue: 0,1:21:16.03,1:21:18.58,Default,,0,0,0,,Яойорозу-кун, осында келші (Яойорозу) Иә.
Dialogue: 0,1:21:18.91,1:21:22.87,Default,,0,0,0,,Студенттерімді ренжіту...
Dialogue: 0,1:21:23.00,1:21:25.71,Default,,0,0,0,,Бұл шек. Оның не екенін айта алмаймын.
Dialogue: 0,1:21:27.17,1:21:31.55,Default,,0,0,0,,Шектен тыс және одан әрі!
Dialogue: 0,1:21:32.67,1:21:35.47,Default,,0,0,0,,Иә, бұл Plus Ultra!
Dialogue: 0,1:21:37.47,1:21:38.43,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:42.73,1:21:43.98,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,1:21:44.69,1:21:45.85,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:48.32,1:21:49.52,Default,,0,0,0,,Хмф!
Dialogue: 0,1:21:52.78,1:21:56.57,Default,,0,0,0,,Каролина Смаш!
Dialogue: 0,1:21:57.66,1:21:58.83,Default,,0,0,0,,Уф...
Dialogue: 0,1:21:59.28,1:22:00.29,Default,,0,0,0,,Чи…
Dialogue: 0,1:22:00.41,1:22:03.79,Default,,0,0,0,,Ойлан, жауыз!
Dialogue: 0,1:22:04.16,1:22:05.17,Default,,0,0,0,,Уф...
Dialogue: 0,1:22:06.58,1:22:08.84,Default,,0,0,0,,Осыншама... Арх...
Dialogue: 0,1:22:09.29,1:22:10.21,Default,,0,0,0,,Уф...
Dialogue: 0,1:22:10.55,1:22:13.97,Default,,0,0,0,,Ойланып көріңізші? Бұл сенсің
Dialogue: 0,1:22:15.30,1:22:17.14,Default,,0,0,0,,Осылайша тәжірибеңіз артады және көпшіліктің назарын аударасыз
Dialogue: 0,1:22:17.51,1:22:20.22,Default,,0,0,0,,Бұл қандай күш...
Dialogue: 0,1:22:20.35,1:22:21.18,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,1:22:22.81,1:22:23.73,Default,,0,0,0,,Гррр…
Dialogue: 0,1:22:24.02,1:22:25.85,Default,,0,0,0,,О!
Dialogue: 0,1:22:25.98,1:22:28.44,Default,,0,0,0,,үшін мүмкін! Уф...
Dialogue: 0,1:22:28.56,1:22:29.40,Default,,0,0,0,,(Катсухиннің күркіреуі)
Dialogue: 0,1:22:29.69,1:22:31.57,Default,,0,0,0,,Қара mana-ның оғаш араласуының белгісі байқалмайды ғой, иә?
Dialogue: 0,1:22:32.28,1:22:33.19,Default,,0,0,0,,Уф...
Dialogue: 0,1:22:36.07,1:22:39.20,Default,,0,0,0,,Бұл күш бұлшықетті күшейтеді
Dialogue: 0,1:22:39.32,1:22:41.49,Default,,0,0,0,,Бірнеше тұлғаның болуы...
Dialogue: 0,1:22:41.70,1:22:43.41,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:22:43.75,1:22:47.67,Default,,0,0,0,,Ах, мен бұл ұрлықты жоспарлаған кезде.
Dialogue: 0,1:22:47.79,1:22:49.88,Default,,0,0,0,,Маған сол адам қоңырау шалды.
Dialogue: 0,1:22:50.96,1:22:53.80,Default,,0,0,0,,Мен ынтымақтастықты жақсы көретінімді айттым.
Dialogue: 0,1:22:54.21,1:22:59.01,Default,,0,0,0,,Мен одан себебін сұрағанымда ол былай деді.
Dialogue: 0,1:22:59.34,1:23:03.52,Default,,0,0,0,,Егер Бүкіл Құдірет-тің ең жақын досы жамандық жасаса...
Dialogue: 0,1:23:03.64,1:23:06.56,Default,,0,0,0,,Мен бұған қарамастан, көмектескім келеді.
Dialogue: 0,1:23:07.06,1:23:09.48,Default,,0,0,0,,Бүкіл Құдірет бұл фактіні білгенде...
Dialogue: 0,1:23:09.60,1:23:14.11,Default,,0,0,0,,Өкініштісі, оның бетін қиналып бұралғанын көре алмаймыз.
Dialogue: 0,1:23:15.65,1:23:18.49,Default,,0,0,0,,үшін бір үшін…
Dialogue: 0,1:23:18.86,1:23:21.70,Default,,0,0,0,,Ақыры күлімсіреуден құтылдың ба?
Dialogue: 0,1:23:22.16,1:23:24.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:23:24.37,1:23:27.46,Default,,0,0,0,,(Вольфрамның күлкісі)
Dialogue: 0,1:23:27.58,1:23:28.50,Default,,0,0,0,,Гррр…
Dialogue: 0,1:23:29.33,1:23:30.63,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:23:33.00,1:23:34.09,Default,,0,0,0,,Бәрі мүмкін!
Dialogue: 0,1:23:34.84,1:23:35.84,Default,,0,0,0,,Ағай...
Dialogue: 0,1:23:36.26,1:23:39.26,Default,,0,0,0,,Қош болайық!
Dialogue: 0,1:23:42.05,1:23:44.39,Default,,0,0,0,,Майт ағай!
Dialogue: 0,1:23:47.31,1:23:49.39,Default,,0,0,0,,Детройт…
Dialogue: 0,1:23:49.69,1:23:50.52,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:50.65,1:23:54.61,Default,,0,0,0,,Smash!
Dialogue: 0,1:23:57.11,1:23:58.74,Default,,0,0,0,,Мен барлығын тыңшылап жүрмін, бірақ Хинацуру туралы ешқандай жаңалық жоқ.
Dialogue: 0,1:23:58.90,1:23:59.90,Default,,0,0,0,,Уф...
Dialogue: 0,1:24:02.62,1:24:04.70,Default,,0,0,0,,(Барлық мүмкін жөтел)
Dialogue: 0,1:24:05.49,1:24:06.49,Default,,0,0,0,,Гррр…
Dialogue: 0,1:24:08.00,1:24:09.16,Default,,0,0,0,,Жас Мидория!
Dialogue: 0,1:24:09.87,1:24:12.17,Default,,0,0,0,,Ондай денемен, қандай шектен шыққан...
Dialogue: 0,1:24:13.33,1:24:14.67,Default,,0,0,0,,Өйткені
Dialogue: 0,1:24:15.21,1:24:18.55,Default,,0,0,0,,Өйткені қаһарман қиналғандарға көмектеседі.
Dialogue: 0,1:24:19.13,1:24:20.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:21.55,1:24:24.10,Default,,0,0,0,,Хехе хахаха!
Dialogue: 0,1:24:24.22,1:24:28.56,Default,,0,0,0,,Рахмет. Дәл қазір аздап қиналып жүргенім рас.
Dialogue: 0,1:24:29.39,1:24:31.98,Default,,0,0,0,,Маған қолыңды соз, Мидорий бала.
Dialogue: 0,1:24:32.19,1:24:33.15,Default,,0,0,0,,Иә
Dialogue: 0,1:24:42.16,1:24:44.12,Default,,0,0,0,,Кеттік! иә!
Dialogue: 0,1:24:44.95,1:24:49.54,Default,,0,0,0,,Гах... Сәтсіз болсаң, бала боласың.
Dialogue: 0,1:24:49.75,1:24:51.75,Default,,0,0,0,,Қоқыстың шетінде
Dialogue: 0,1:24:52.17,1:24:55.29,Default,,0,0,0,,Өлгенің қорқынышты!
Dialogue: 0,1:24:55.75,1:24:58.13,Default,,0,0,0,,Әрине!
Dialogue: 0,1:25:04.72,1:25:06.68,Default,,0,0,0,,Бұған жол берме!
Dialogue: 0,1:25:12.19,1:25:13.19,Default,,0,0,0,,Бұл ыңғайсыздық!
Dialogue: 0,1:25:16.82,1:25:17.86,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:25:17.98,1:25:19.69,Default,,0,0,0,,Ах, уау!
Dialogue: 0,1:25:23.36,1:25:24.36,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:46.43,1:25:47.43,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:58.11,1:26:01.90,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:26:02.32,1:26:03.82,Default,,0,0,0,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,1:26:04.53,1:26:05.53,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:07.07,1:26:08.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:26:10.58,1:26:13.12,Default,,0,0,0,,Алдымдағы шымшым...
Dialogue: 0,1:26:13.75,1:26:16.08,Default,,0,0,0,,Бар күшіңмен жең
Dialogue: 0,1:26:16.67,1:26:17.96,Default,,0,0,0,,Адамдар...
Dialogue: 0,1:26:18.08,1:26:20.09,Default,,0,0,0,,Мен көмектесуге бар күшімді саламын!
Dialogue: 0,1:26:20.50,1:26:22.13,Default,,0,0,0,,Міне...
Dialogue: 0,1:26:22.26,1:26:23.84,Default,,0,0,0,,Батыр!
Dialogue: 0,1:26:24.26,1:26:27.84,Default,,0,0,0,,Бүкіл мұнараны қиратыңыз!
Dialogue: 0,1:26:28.43,1:26:33.47,Default,,0,0,0,,...
Dialogue: 0,1:26:33.98,1:26:36.23,Default,,0,0,0,,Smash!
Dialogue: 0,1:26:36.35,1:26:37.44,Default,,0,0,0,,Гррр…
Dialogue: 0,1:26:40.48,1:26:43.23,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:26:43.36,1:26:46.20,Default,,0,0,0,,Гү… Ха-ха
Dialogue: 0,1:26:47.82,1:26:49.82,Default,,0,0,0,,Бұл карта сәл ақымақтай көрінбей ме?
Dialogue: 0,1:26:49.95,1:26:50.91,Default,,0,0,0,,Гаха!
Dialogue: 0,1:26:58.00,1:26:59.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:59.33,1:27:00.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:00.79,1:27:02.25,Default,,0,0,0,,Жүр!
Dialogue: 0,1:27:02.55,1:27:03.50,Default,,0,0,0,,Бәрі мүмкін!
Dialogue: 0,1:27:03.84,1:27:04.80,Default,,0,0,0,,Мидория!
Dialogue: 0,1:27:05.26,1:27:06.76,Default,,0,0,0,,Мені ұр!
Dialogue: 0,1:27:10.39,1:27:11.47,Default,,0,0,0,,Сонымен қатар…
Dialogue: 0,1:27:11.85,1:27:13.64,Default,,0,0,0,,Мына жерде!
Dialogue: 0,1:27:14.93,1:27:19.85,Default,,0,0,0,,...
Dialogue: 0,1:27:25.24,1:27:28.28,Default,,0,0,0,,Олардың аурасы ұқсас қой, иә? Олар әпкелер ме?
Dialogue: 0,1:27:28.78,1:27:34.45,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:28:01.44,1:28:02.94,Default,,0,0,0,,Сіз мұны жасадыңыз ба...
Dialogue: 0,1:28:03.73,1:28:05.23,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,1:28:05.36,1:28:08.03,Default,,0,0,0,,Біз зұлымдықты жеңдік!
Dialogue: 0,1:28:08.15,1:28:11.03,Default,,0,0,0,,(Минета мен оның достарының қуанышты дауыстары)
Dialogue: 0,1:28:11.16,1:28:11.99,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:28:12.12,1:28:14.99,Default,,0,0,0,,(Минета мен оның достарының қуанышты дауыстары)
Dialogue: 0,1:28:24.71,1:28:26.67,Default,,0,0,0,,Уф...
Dialogue: 0,1:28:29.47,1:28:30.55,Default,,0,0,0,,(Ақ) Адамнан тыс қабілеттері бар данышпан қыз
Dialogue: 0,1:28:30.93,1:28:32.26,Default,,0,0,0,,Деку-кун, аа...
Dialogue: 0,1:28:32.80,1:28:34.18,Default,,0,0,0,,Мелисса
Dialogue: 0,1:28:34.30,1:28:35.26,Default,,0,0,0,,Жақсы
Dialogue: 0,1:28:36.60,1:28:39.27,Default,,0,0,0,,Дэйв Дэйв
Dialogue: 0,1:28:42.02,1:28:44.52,Default,,0,0,0,,үшін мүмкін...
Dialogue: 0,1:28:45.32,1:28:47.86,Default,,0,0,0,,Мен көмектесуге келдім, Дэйв.
Dialogue: 0,1:28:48.44,1:28:49.99,Default,,0,0,0,,Рахмет
Dialogue: 0,1:28:50.32,1:28:53.66,Default,,0,0,0,,Папа! үшін мүмкін!
Dialogue: 0,1:28:54.37,1:28:58.41,Default,,0,0,0,,Мелисаға алғыс айтқыңыз келсе, Мидорияға айту керек.
Dialogue: 0,1:28:58.95,1:29:02.25,Default,,0,0,0,,Жақсы, шынымен...
Dialogue: 0,1:29:03.42,1:29:04.54,Default,,0,0,0,,Рахмет
Dialogue: 0,1:29:04.67,1:29:08.55,Default,,0,0,0,,Деку мен басқалардың арқасында мен барлығына көмектесе алдым.
Dialogue: 0,1:29:08.80,1:29:10.47,Default,,0,0,0,,Мелисса да солай.
Dialogue: 0,1:29:11.13,1:29:14.01,Default,,0,0,0,,Мен Мелисаның қолындамын
Dialogue: 0,1:29:14.14,1:29:16.14,Default,,0,0,0,,Бірнеше рет сақталды
Dialogue: 0,1:29:16.72,1:29:18.14,Default,,0,0,0,,Рахмет
Dialogue: 0,1:29:20.10,1:29:21.43,Default,,0,0,0,,(Катсухиннің күркіреуі)
Dialogue: 0,1:29:21.68,1:29:24.31,Default,,0,0,0,,Ах, бірақ мен оны бұзғаным үшін кешіріңіз...
Dialogue: 0,1:29:24.44,1:29:26.61,Default,,0,0,0,,Хехе, мұндай нәрсе
Dialogue: 0,1:29:26.73,1:29:28.69,Default,,0,0,0,,Деку-кун!
Dialogue: 0,1:29:28.82,1:29:30.40,Default,,0,0,0,,Сәлем, Мелисса! (Киришима) Сен істедің!
Dialogue: 0,1:29:30.53,1:29:32.53,Default,,0,0,0,,Сіз жарақат алдыңыз ба? Екеуміз де
Dialogue: 0,1:29:32.65,1:29:36.32,Default,,0,0,0,,Жарайды, Бүкіл Құдірет және Doctor қауіпсіз!
Dialogue: 0,1:29:36.91,1:29:38.95,Default,,0,0,0,,үшін жақсы ма?
Dialogue: 0,1:29:39.08,1:29:41.33,Default,,0,0,0,,Жарайды! (Очако) Жарайды!
Dialogue: 0,1:29:41.62,1:29:44.83,Default,,0,0,0,,Жалпы мәліметтерді Мелиссадан естідім.
Dialogue: 0,1:29:46.79,1:29:51.63,Default,,0,0,0,,Сен деген жарықтан айырылып қалар едім...
Dialogue: 0,1:29:51.88,1:29:55.22,Default,,0,0,0,,Құрған тыныштығым бұзыла ма деп қорықтым.
Dialogue: 0,1:29:56.59,1:30:01.10,Default,,0,0,0,,Бірақ менің ойым және сол құрылғы...
Dialogue: 0,1:30:01.22,1:30:04.19,Default,,0,0,0,,Өйткені, бұл тек статус-квоны сақтаудың өнімі.
Dialogue: 0,1:30:06.27,1:30:10.15,Default,,0,0,0,,Болашақ пен үміт жақын болса да...
Dialogue: 0,1:30:10.61,1:30:12.86,Default,,0,0,0,,Мен мұны байқамадым
Dialogue: 0,1:30:14.11,1:30:18.03,Default,,0,0,0,,Мелисса менің ізіммен жүруге тырысатыны сияқты...
Dialogue: 0,1:30:18.62,1:30:24.25,Default,,0,0,0,,Изуку Мидория, ол сенің орнын басатын адам.
Dialogue: 0,1:30:25.29,1:30:27.63,Default,,0,0,0,,Әлі жетілмеген
Dialogue: 0,1:30:28.33,1:30:34.30,Default,,0,0,0,,Әйтсе де, оның батыр ретінде жарқырауға мүмкіндігі бар.
Dialogue: 0,1:30:37.26,1:30:39.93,Default,,0,0,0,,Мен де көріп тұрмын Тоши
Dialogue: 0,1:30:41.43,1:30:43.43,Default,,0,0,0,,Сіз сияқты жарық
Dialogue: 0,1:30:45.10,1:30:48.27,Default,,0,0,0,,Батырдың жарқырауы
Dialogue: 0,1:30:56.78,1:31:01.78,Default,,0,0,0,,♪～
Dialogue: 0,1:35:40.73,1:35:45.73,Default,,0,0,0,,～♪
