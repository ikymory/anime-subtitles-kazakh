Dialogue: 0,0:00:34.32,0:00:36.87,Default,,0,0,0,,Тіліңізді таңдаңыз
Dialogue: 0,0:00:39.41,0:00:40.70,Default,,0,0,0,,Сіз жапон тілін таңдадыңыз
Dialogue: 0,0:00:40.70,0:00:41.70,Default,,0,0,0,,Сіз жапон тілін таңдадыңыз
Dialogue: 0,0:00:40.70,0:00:41.70,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:41.70,0:00:42.41,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:42.41,0:00:46.08,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:42.41,0:00:46.08,Default,,0,0,0,,Сараево раушан гүлі Югославия ыдырағаннан кейін...
Dialogue: 0,0:00:46.08,0:00:46.21,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:46.21,0:00:46.71,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:46.21,0:00:46.71,Default,,0,0,0,,(көп тілдегі машина дауысы)
Dialogue: 0,0:00:46.71,0:00:51.67,Default,,0,0,0,,(бірнеше тілдегі машина дауысы)
Dialogue: 0,0:00:52.63,0:00:54.67,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:12.03,0:01:13.11,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:14.99,0:01:16.82,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:01:17.20,0:01:20.53,Default,,0,0,0,,(Лузияның ауыр тыныс алуы)
Dialogue: 0,0:01:20.53,0:01:21.49,Default,,0,0,0,,(Лузияның ауыр тыныс алуы)
Dialogue: 0,0:01:20.53,0:01:21.49,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:01:21.49,0:01:21.62,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:01:21.62,0:01:22.41,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:01:21.62,0:01:22.41,Default,,0,0,0,,(Лузия ентігу)
Dialogue: 0,0:01:22.41,0:01:24.58,Default,,0,0,0,,(Лузия ентігу)
Dialogue: 0,0:01:24.58,0:01:24.79,Default,,0,0,0,,(Лузия ентігу)
Dialogue: 0,0:01:24.58,0:01:24.79,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:01:24.79,0:01:26.25,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:01:26.25,0:01:27.12,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:01:26.25,0:01:27.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:36.84,0:01:39.76,Default,,0,0,0,,Жергілікті Америка елшілігімен де байланыс үзілді...
Dialogue: 0,0:01:41.97,0:01:43.77,Default,,0,0,0,,Капитан Клавис Шепард
Dialogue: 0,0:01:44.77,0:01:49.15,Default,,0,0,0,,Арнайы іздестіру тобының I отрядына және оның міндетіне қатысты—
Dialogue: 0,0:01:49.27,0:01:51.77,Default,,0,0,0,,Ал мұндағылардың бәрі аузын жауып тұрады...
Dialogue: 0,0:01:52.02,0:01:56.28,Default,,0,0,0,,Сұрағыңызға жауап беруіңіз керек.
Dialogue: 0,0:02:02.66,0:02:07.04,Default,,0,0,0,,Маған жауап берейін, Джон Пол деген кім?
Dialogue: 0,0:02:13.55,0:02:16.21,Default,,0,0,0,,(Радиода ойналатын музыка)
Dialogue: 0,0:02:16.34,0:02:22.35,Default,,0,0,0,,(Шетелдік жауынгерлердің сөйлеген дыбыстары)
Dialogue: 0,0:02:37.32,0:02:38.32,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:02:48.87,0:02:50.46,Default,,0,0,0,,Әуесқой
Dialogue: 0,0:02:51.58,0:02:55.17,Default,,0,0,0,,Менде ештеңе жоқ. Не істеуім керек, Клавис?
Dialogue: 0,0:03:03.14,0:03:04.68,Default,,0,0,0,,Әдеттегі әдіспен жүріңіз
Dialogue: 0,0:03:09.14,0:03:12.40,Default,,0,0,0,,(Радиода ойналатын музыка)
Dialogue: 0,0:03:14.94,0:03:18.65,Default,,0,0,0,,(радиода ойналатын шет тілі)
Dialogue: 0,0:03:18.78,0:03:21.40,Default,,0,0,0,,Бұл әскери үкіметтің насихаты ма?
Dialogue: 0,0:03:21.53,0:03:25.78,Default,,0,0,0,,Иә, алты ай бұрын дәл осындай хабарды естігенім есімде.
Dialogue: 0,0:03:25.91,0:03:29.70,Default,,0,0,0,,Алекс, Осетия операциясына қатыстыңыз ба?
Dialogue: 0,0:03:29.83,0:03:32.83,Default,,0,0,0,,Иә, грузин тілінде сөйлей білу құнды сияқты.
Dialogue: 0,0:03:33.17,0:03:35.54,Default,,0,0,0,,Бірақ сіз ең маңызды адамды жойсаңыз да—
Dialogue: 0,0:03:35.67,0:03:37.75,Default,,0,0,0,,Келесісі жақын арада пайда болады.
Dialogue: 0,0:03:37.88,0:03:40.13,Default,,0,0,0,,Біздің жұмысымыздың шын мәнінде мағынасы бар ма?
Dialogue: 0,0:03:40.26,0:03:41.97,Default,,0,0,0,,Мен бұл туралы ойланамын.
Dialogue: 0,0:03:42.09,0:03:42.93,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:03:43.05,0:03:44.59,Default,,0,0,0,,
Dialogue: 0,0:03:49.10,0:03:51.52,Default,,0,0,0,,500 метр жерде бақылау бекеті бар.
Dialogue: 0,0:03:51.64,0:03:53.60,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:04:05.49,0:04:09.45,Default,,0,0,0,,(Алекстің шет тілі)
Dialogue: 0,0:04:09.79,0:04:10.83,Default,,0,0,0,,(шетелдік жауынгерлердің шет тілі)
Dialogue: 0,0:04:11.96,0:04:12.96,Default,,0,0,0,,(шетелдік жауынгерлердің шет тілі)
Dialogue: 0,0:04:20.17,0:04:21.17,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:04:23.42,0:04:24.43,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:04:26.93,0:04:27.97,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:04:29.01,0:04:30.01,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:04:40.07,0:04:41.28,Default,,0,0,0,,
Dialogue: 0,0:04:54.71,0:04:58.71,Default,,0,0,0,,Сіз ақпараттық сауаттылықтың не екенін білмейсіз.
Dialogue: 0,0:05:00.59,0:05:02.80,Default,,0,0,0,,Аурухананың жалпы қызметі келді.
Dialogue: 0,0:05:03.17,0:05:05.34,Default,,0,0,0,,Ақпаратты кім берді?
Dialogue: 0,0:05:07.84,0:05:11.47,Default,,0,0,0,,Маған тезірек хабарлауыңызды қалаймын.
Dialogue: 0,0:05:11.60,0:05:12.93,Default,,0,0,0,,Президент
Dialogue: 0,0:05:13.06,0:05:15.60,Default,,0,0,0,,Кешіріңіз Джордж, бірақ...
Dialogue: 0,0:05:15.85,0:05:19.52,Default,,0,0,0,,Мүмкін бүгін мен бұл қорқыныштан құтылармын.
Dialogue: 0,0:05:28.57,0:05:31.03,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:05:36.62,0:05:38.04,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:05:38.25,0:05:39.08,Default,,0,0,0,,(Балаларға арналған шет тілі)
Dialogue: 0,0:05:39.21,0:05:40.71,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:05:40.84,0:05:45.63,Default,,0,0,0,,(Ерлерге арналған шет тілі)
Dialogue: 0,0:05:45.76,0:05:47.09,Default,,0,0,0,,(Шетелдік солдаттардың айқайы)
Dialogue: 0,0:05:48.38,0:05:51.22,Default,,0,0,0,,Біз тозаққа барамыз ба?
Dialogue: 0,0:05:52.39,0:05:54.06,Default,,0,0,0,,Мен атеистпін
Dialogue: 0,0:05:54.89,0:05:58.56,Default,,0,0,0,,Құдайға сенбесең де, тозақ бар.
Dialogue: 0,0:05:58.90,0:06:01.61,Default,,0,0,0,,Дұрыс, бұл жер қазірдің өзінде тозақ.
Dialogue: 0,0:06:01.73,0:06:02.57,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:06:02.98,0:06:03.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:04.32,0:06:08.86,Default,,0,0,0,,Тозақ осында, басыңда, миыңда.
Dialogue: 0,0:06:08.99,0:06:11.82,Default,,0,0,0,,Сіздің алдыңыздағы көрініс тозақ емес.
Dialogue: 0,0:06:12.66,0:06:16.75,Default,,0,0,0,,Біз Америкаға оралып, қалыпты өмірімізді жалғастыра аламыз.
Dialogue: 0,0:06:16.87,0:06:19.67,Default,,0,0,0,,Бірақ тозақтан құтыла алмайсың
Dialogue: 0,0:06:20.29,0:06:23.25,Default,,0,0,0,,Өйткені бәрі менің ойымда.
Dialogue: 0,0:06:23.38,0:06:26.42,Default,,0,0,0,,Ахахха Аспан сонда да ма?
Dialogue: 0,0:06:26.63,0:06:29.01,Default,,0,0,0,,Шатаспа, Леланд.
Dialogue: 0,0:06:29.38,0:06:31.59,Default,,0,0,0,,Ой, мақсатты шіркеуге уақыт таяп қалды.
Dialogue: 0,0:06:31.72,0:06:34.39,Default,,0,0,0,,Бұл бейшараға не істеуіміз керек?
Dialogue: 0,0:06:35.77,0:06:38.89,Default,,0,0,0,,Тұрақты ID оқу құралы болуы мүмкін.
Dialogue: 0,0:06:39.02,0:06:42.31,Default,,0,0,0,,Кішкентай шабақтарды белгілеу керісінше әсер етеді. Оны шығарып алыңыз.
Dialogue: 0,0:07:19.35,0:07:25.36,Default,,0,0,0,,(Шет тіліндегі хабарландыру)
Dialogue: 0,0:07:33.28,0:07:34.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:34.24,0:07:38.87,Default,,0,0,0,,Ватару!
Dialogue: 0,0:07:39.16,0:07:40.58,Default,,0,0,0,,«Ай сәулесі»?
Dialogue: 0,0:07:40.91,0:07:42.21,Default,,0,0,0,,Не?
Dialogue: 0,0:07:42.33,0:07:48.34,Default,,0,0,0,,Ватару!
Dialogue: 0,0:08:02.56,0:08:03.39,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:08:03.81,0:08:06.06,Default,,0,0,0,,Мен сізден шындап сұраймын, Әдебиет факультеті.
Dialogue: 0,0:08:06.19,0:08:07.27,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:07.48,0:08:13.40,Default,,0,0,0,,Ватару!
Dialogue: 0,0:08:20.08,0:08:26.08,Default,,0,0,0,,(шетел тілінде сөйлейді)
Dialogue: 0,0:08:28.29,0:08:34.22,Default,,0,0,0,,Ватару!
Dialogue: 0,0:09:15.72,0:09:17.13,Default,,0,0,0,,Америкалықтар жоқ
Dialogue: 0,0:09:17.26,0:09:18.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:20.01,0:09:21.18,Default,,0,0,0,,Операцияны басқаратын шебер агент: Твайлайт
Dialogue: 0,0:09:27.31,0:09:29.23,Default,,0,0,0,,Иә? Ууууууууууу
Dialogue: 0,0:09:29.36,0:09:32.53,Default,,0,0,0,,Ууууууууууууууууу...
Dialogue: 0,0:09:32.65,0:09:34.82,Default,,0,0,0,,Біз американдықтарды іздейміз.
Dialogue: 0,0:09:35.40,0:09:39.45,Default,,0,0,0,,Бұл сіз бүгін осында кездесуіңіз керек еді.
Dialogue: 0,0:09:39.62,0:09:42.37,Default,,0,0,0,,Мен сенің америкалық екеніңді білмедім.
Dialogue: 0,0:09:42.49,0:09:45.54,Default,,0,0,0,,Ол біздің Мәдениет және ақпарат министрінің орынбасары.
Dialogue: 0,0:09:45.79,0:09:48.50,Default,,0,0,0,,Жоқ, мен «болды» деп айтуым керек
Dialogue: 0,0:09:48.62,0:09:49.88,Default,,0,0,0,,Сен оны өлтірдің бе?
Dialogue: 0,0:09:50.00,0:09:53.71,Default,,0,0,0,,Жоқ, бірақ ол кететінін айтты.
Dialogue: 0,0:09:54.38,0:09:59.18,Default,,0,0,0,,Сөзге шешен адам өзінің ресми кеңсе тауарларына бір ғана сөз қалдырған.
Dialogue: 0,0:09:59.47,0:10:01.35,Default,,0,0,0,,Ол кетіп қалды ма?
Dialogue: 0,0:10:01.97,0:10:05.60,Default,,0,0,0,,Бұл оның келмейтінін білдіреді, президент мырза.
Dialogue: 0,0:10:06.56,0:10:07.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:07.73,0:10:08.85,Default,,0,0,0,,Иә
Dialogue: 0,0:10:09.44,0:10:10.98,Default,,0,0,0,,Бұл ресми кеңсе тауарлары ма?
Dialogue: 0,0:10:11.11,0:10:12.57,Default,,0,0,0,,Мұнда үкімет жоқ
Dialogue: 0,0:10:12.69,0:10:14.61,Default,,0,0,0,,Тек кейбір қарулы топтар —
Dialogue: 0,0:10:14.86,0:10:18.78,Default,,0,0,0,,Сіз бәрінен де сорақысыз, қырғынды жасадыңыз.
Dialogue: 0,0:10:18.90,0:10:20.16,Default,,0,0,0,,Бұл геноцид пе?
Dialogue: 0,0:10:20.28,0:10:24.54,Default,,0,0,0,,Осындай сөздермен бейбітшілік тілегімізді балағаттайсың ба?
Dialogue: 0,0:10:24.91,0:10:30.04,Default,,0,0,0,,Бұл біздің үкімет пен халқымызға қарсы жексұрын терроризмге қарсы соғыс.
Dialogue: 0,0:10:30.17,0:10:32.21,Default,,0,0,0,,Адамдарды өлтіретін адамдар -
Dialogue: 0,0:10:32.34,0:10:33.59,Default,,0,0,0,,Сіз өзіңіз.
Dialogue: 0,0:10:33.71,0:10:35.30,Default,,0,0,0,,Сіз қандай үкімет туралы айтып отырсыз?
Dialogue: 0,0:10:35.42,0:10:38.38,Default,,0,0,0,,Біріккен Ұлттар Ұйымына мүше ешбір мемлекет танымайды
Dialogue: 0,0:10:38.72,0:10:40.22,Default,,0,0,0,,Біріккен Ұлттар Ұйымы туралы не деуге болады?
Dialogue: 0,0:10:40.34,0:10:43.10,Default,,0,0,0,,Мәдениетімізді аяқ астынан таптау
Dialogue: 0,0:10:43.22,0:10:47.10,Default,,0,0,0,,Ең сорақы империалистер өзін-өзі анықтау құқығына күледі.
Dialogue: 0,0:10:47.22,0:10:52.27,Default,,0,0,0,,Әртүрлі этностар ежелден бірге өмір сүріп, тату-тәтті өмір сүрген елімізде...
Dialogue: 0,0:10:53.73,0:10:58.07,Default,,0,0,0,,Дұрыс... неліктен бізде бұлай болды?
Dialogue: 0,0:10:58.69,0:11:02.66,Default,,0,0,0,,Толеранттылық пен көпмәдениеттілік – бұл елдің ізгі қасиеттері
Dialogue: 0,0:11:03.07,0:11:07.50,Default,,0,0,0,,Иә, террористер. Бұл лаңкестердің кінәсі.
Dialogue: 0,0:11:08.16,0:11:12.17,Default,,0,0,0,,Жоқ, жоқ, бұл тіпті әскерилердің астанаға кіруін талап етпейді...
Dialogue: 0,0:11:13.00,0:11:16.75,Default,,0,0,0,,Неліктен... неге бұлай болды?
Dialogue: 0,0:11:19.30,0:11:21.34,Default,,0,0,0,,Мойындаудың қажеті жоқ
Dialogue: 0,0:11:23.39,0:11:25.39,Default,,0,0,0,,Сіз не туралы айтып отырсыз ...
Dialogue: 0,0:11:25.51,0:11:27.60,Default,,0,0,0,,Қандай да бір дінде тозақ болса...
Dialogue: 0,0:11:27.72,0:11:29.56,Default,,0,0,0,,Онда міндетті түрде құлайсың.
Dialogue: 0,0:11:29.85,0:11:32.90,Default,,0,0,0,,Иә, мен тозаққа барамын.
Dialogue: 0,0:11:33.02,0:11:35.02,Default,,0,0,0,,Сіз қателесесіз.
Dialogue: 0,0:11:35.15,0:11:38.69,Default,,0,0,0,,Бұл мойындау емес. Мен түсінбедім.
Dialogue: 0,0:11:38.82,0:11:41.20,Default,,0,0,0,,Екі жыл бұрын бұл жер әдемі еді...
Dialogue: 0,0:11:41.32,0:11:44.62,Default,,0,0,0,,Неге сонша қаңырап қалды?
Dialogue: 0,0:11:44.82,0:11:47.24,Default,,0,0,0,,Мен бастаған соғыс болса да
Dialogue: 0,0:11:47.37,0:11:49.08,Default,,0,0,0,,Мен бастадым ба?
Dialogue: 0,0:11:49.70,0:11:50.54,Default,,0,0,0,,Сіз...
Dialogue: 0,0:11:50.66,0:11:53.92,Default,,0,0,0,,Мен неге өлтірдім...?
Dialogue: 0,0:11:54.38,0:11:58.05,Default,,0,0,0,,Ой... у... ой...
Dialogue: 0,0:11:58.38,0:12:01.34,Default,,0,0,0,,Ууууууууууууууууу...
Dialogue: 0,0:12:01.47,0:12:03.05,Default,,0,0,0,,Хе... у...
Dialogue: 0,0:12:05.18,0:12:08.43,Default,,0,0,0,,Полковник: Эмоционалды бейімделуді реттеу мәнінде ауытқу бар.
Dialogue: 0,0:12:08.68,0:12:09.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:10.64,0:12:12.60,Default,,0,0,0,,Эй... айтыңызшы.
Dialogue: 0,0:12:12.73,0:12:13.73,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:12:14.31,0:12:17.86,Default,,0,0,0,,Айтыңызшы, өтінемін.
Dialogue: 0,0:12:19.11,0:12:22.32,Default,,0,0,0,,Мен не өлтірдім...?
Dialogue: 0,0:12:22.70,0:12:23.53,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:12:23.65,0:12:26.24,Default,,0,0,0,,Бақылау деңгейінен асып кету
Dialogue: 0,0:12:27.24,0:12:29.62,Default,,0,0,0,,Өзін-өзі бақылау мүмкін емес деңгейге дейін көтерілді!
Dialogue: 0,0:12:29.91,0:12:33.04,Default,,0,0,0,,Сіз нені айтасыз, капитан Шепард?
Dialogue: 0,0:12:33.16,0:12:34.62,Default,,0,0,0,,Жауап беріңіз!
Dialogue: 0,0:12:37.38,0:12:38.84,Default,,0,0,0,,Полковник... Шепард!
Dialogue: 0,0:12:39.21,0:12:40.38,Default,,0,0,0,,Неге өлтірдің...
Dialogue: 0,0:12:40.38,0:12:41.30,Default,,0,0,0,,Неге өлтірдің...
Dialogue: 0,0:12:40.38,0:12:41.30,Default,,0,0,0,,Капитан Шепард!
Dialogue: 0,0:12:41.42,0:12:43.09,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:12:43.30,0:12:44.13,Default,,0,0,0,,Шопан!
Dialogue: 0,0:12:44.26,0:12:47.05,Default,,0,0,0,,Неге... у...
Dialogue: 0,0:12:47.18,0:12:51.06,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:12:55.64,0:12:59.86,Default,,0,0,0,,Жоқ... бұл капитан Шепард емес!
Dialogue: 0,0:13:06.95,0:13:08.07,Default,,0,0,0,,Ай…
Dialogue: 0,0:13:08.20,0:13:13.87,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:13:29.26,0:13:30.76,Default,,0,0,0,,Алекс…
Dialogue: 0,0:13:31.35,0:13:32.43,Default,,0,0,0,,Эй
Dialogue: 0,0:13:33.18,0:13:33.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:34.10,0:13:36.10,Default,,0,0,0,,Неге бұлай істедің...
Dialogue: 0,0:13:37.27,0:13:38.56,Default,,0,0,0,,Неге...
Dialogue: 0,0:13:40.81,0:13:43.19,Default,,0,0,0,,Шепард Сіз мені естисіз бе?
Dialogue: 0,0:13:58.75,0:13:59.58,Default,,0,0,0,,Я...
Dialogue: 0,0:14:08.72,0:14:11.80,Default,,0,0,0,,Прапорщик Алекстің биологиялық реакциясы жоғалады
Dialogue: 0,0:14:13.60,0:14:16.77,Default,,0,0,0,,Капитан Шепард! Жағдайды хабарлаңыз!
Dialogue: 0,0:14:19.14,0:14:21.36,Default,,0,0,0,,А нысанасы өлі расталды
Dialogue: 0,0:14:21.48,0:14:24.28,Default,,0,0,0,,Прапорщик Алекс өз қалауы бойынша атып өлтірілді.
Dialogue: 0,0:14:25.40,0:14:29.45,Default,,0,0,0,,Төтенше жағдайларда денені процедураларға сәйкес тастаңыз
Dialogue: 0,0:14:31.62,0:14:32.74,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:14:32.87,0:14:36.45,Default,,0,0,0,,(Шетелдік солдаттардың айқайы)
Dialogue: 0,0:14:37.00,0:14:40.21,Default,,0,0,0,,Сіз американдық солдаттардың мәйіттерін жойып, үйіңізге барасыз ба?
Dialogue: 0,0:14:40.33,0:14:42.71,Default,,0,0,0,,Мұндайды халық кешіре ме?
Dialogue: 0,0:14:43.42,0:14:46.30,Default,,0,0,0,,Жоқ, бұл сабырлы шешім.
Dialogue: 0,0:14:47.30,0:14:51.30,Default,,0,0,0,,Енді 12333 Атқарушы бұйрығы күшінде қалады -
Dialogue: 0,0:14:51.43,0:14:54.72,Default,,0,0,0,,Бұл операцияның жалпыға қолжетімді болуына жол бермеу керек.
Dialogue: 0,0:15:00.52,0:15:03.11,Default,,0,0,0,,Маған Уильямсқа қосылуға рұқсат етіңіз...
Dialogue: 0,0:15:03.56,0:15:07.11,Default,,0,0,0,,Ештеңеге қарамай қайт. Әңгіме содан кейін жалғасады.
Dialogue: 0,0:15:10.20,0:15:11.28,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:12.03,0:15:14.07,Default,,0,0,0,,(Шетелдік солдаттардың айқайы)
Dialogue: 0,0:15:14.20,0:15:16.58,Default,,0,0,0,,(Шетелдік солдаттардың айқайы)
Dialogue: 0,0:15:20.54,0:15:22.12,Default,,0,0,0,,Уильямс, келе жатырсың ба?
Dialogue: 0,0:15:23.38,0:15:25.67,Default,,0,0,0,,А, дәл терезенің астында.
Dialogue: 0,0:15:26.67,0:15:27.88,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:15:28.09,0:15:30.09,Default,,0,0,0,,Мөлдір, ай сәулесіндей
Dialogue: 0,0:15:30.76,0:15:31.80,Default,,0,0,0,,Иә
Dialogue: 0,0:15:42.35,0:15:46.65,Default,,0,0,0,,(Шетелдік жауынгерлердің сөйлеген дыбыстары)
Dialogue: 0,0:15:47.44,0:15:51.11,Default,,0,0,0,,Сезімдер әсер етпеген соңғы сарбаздар?
Dialogue: 0,0:15:51.24,0:15:52.11,Default,,0,0,0,,Га
Dialogue: 0,0:15:52.24,0:15:54.03,Default,,0,0,0,,Алайда жағдай...
Dialogue: 0,0:15:54.41,0:15:58.04,Default,,0,0,0,,Жоқ... Қалғандардың халінде өзгеріс болды ма?
Dialogue: 0,0:15:58.29,0:15:59.54,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:16:00.33,0:16:02.67,Default,,0,0,0,,Өте тегіс
Dialogue: 0,0:16:25.48,0:16:31.49,Default,,0,0,0,,(Клавистің ауыр тыныс алуы)
Dialogue: 0,0:17:05.27,0:17:09.98,Default,,0,0,0,,Хаа... хаа... хаа... хаа...
Dialogue: 0,0:17:10.52,0:17:14.45,Default,,0,0,0,,Ах… Хехе…
Dialogue: 0,0:17:18.78,0:17:21.24,Default,,0,0,0,,Оның үш апта бұрын қайтыс болғаны туралы хабарланған.
Dialogue: 0,0:17:21.37,0:17:24.66,Default,,0,0,0,,Грузия Уақытша Үкіметінің Қорғаныс министрі туралы —
Dialogue: 0,0:17:24.79,0:17:26.79,Default,,0,0,0,,Ақ үй қатысты
Dialogue: 0,0:17:26.92,0:17:28.92,Default,,0,0,0,,Ресми түрде бас тартылды
Dialogue: 0,0:17:29.04,0:17:31.63,Default,,0,0,0,,Жауап ретінде уақытша үкімет тарапы Америка Құрама Штаттарының...
Dialogue: 0,0:17:31.75,0:17:34.88,Default,,0,0,0,,Нью-Йорктегі екі мұнарадан айырылған күн
Dialogue: 0,0:17:35.38,0:17:38.14,Default,,0,0,0,,Біздің ішімізде бір нәрсе өзгерді.
Dialogue: 0,0:17:39.80,0:17:42.26,Default,,0,0,0,,Терроризм қорқынышына қарсы тұру -
Dialogue: 0,0:17:42.39,0:17:45.23,Default,,0,0,0,,Бостандық ауқымы кішірейгенімен...
Dialogue: 0,0:17:45.73,0:17:48.44,Default,,0,0,0,,Қаншама отандастарымды жоғалтудың мұңы мен қорқынышы...
Dialogue: 0,0:17:48.56,0:17:52.73,Default,,0,0,0,,Өздері жасаған жарақаттан арқасы қайырылған халықтың еркі —
Dialogue: 0,0:17:53.11,0:17:55.57,Default,,0,0,0,,Кішкене серпіліс болғанымен,
Dialogue: 0,0:17:55.69,0:17:58.41,Default,,0,0,0,,ешқашан өз бағытын өзгерткен емес
Dialogue: 0,0:18:11.63,0:18:13.05,Default,,0,0,0,,5 жыл бұрын—
Dialogue: 0,0:18:13.17,0:18:16.76,Default,,0,0,0,,қолдан жасалған ядролық бомба Сараево қаласын жойғаннан кейін —
Dialogue: 0,0:18:16.88,0:18:18.26,Default,,0,0,0,,Импульс үдемелі
Dialogue: 0,0:18:19.84,0:18:23.39,Default,,0,0,0,,Сіздің арқаңызда біз терроризм қорқынышынан құтылдық.
Dialogue: 0,0:18:23.60,0:18:27.43,Default,,0,0,0,,Оның үстіне біз бұрын-соңды болмаған қауіпсіздік жағдайына қол жеткіздік.
Dialogue: 0,0:18:28.64,0:18:30.44,Default,,0,0,0,,Реакция?
Dialogue: 0,0:18:30.77,0:18:34.86,Default,,0,0,0,,Дамыған елдерге бет алған лаңкестік қаупі қазір ішке қарай жылжуда...
Dialogue: 0,0:18:34.98,0:18:38.74,Default,,0,0,0,,Азамат соғысы Қырғын дауыл соғып тұр
Dialogue: 0,0:18:40.49,0:18:44.08,Default,,0,0,0,,Дүние жынды болуды шешкендей.
Dialogue: 0,0:19:00.51,0:19:03.43,Default,,0,0,0,,Ричмонд стадионы бүгін тағы да толы.
Dialogue: 0,0:19:03.55,0:19:05.35,Default,,0,0,0,,Бұрынғы төменге екінші пас болды:
Dialogue: 0,0:19:05.47,0:19:07.60,Default,,0,0,0,,Сыртқа жылдам пас болды, бірақ...
Dialogue: 0,0:19:07.72,0:19:09.43,Default,,0,0,0,,Ол толық емес болып шықты және бұл —
Dialogue: 0,0:19:09.56,0:19:11.44,Default,,0,0,0,,Үшіншіден онға
Dialogue: 0,0:19:11.56,0:19:14.15,Default,,0,0,0,,Бүгінгі өтуіңіз өте жақсы.
Dialogue: 0,0:19:14.27,0:19:16.86,Default,,0,0,0,,Енді қандай жолды таңдаймыз деп ойлаймын.
Dialogue: 0,0:19:16.98,0:19:19.32,Default,,0,0,0,,шолақ мылтықтан солға қарасақ—
Dialogue: 0,0:19:19.44,0:19:20.45,Default,,0,0,0,,Мен пас бердім. Мен жолдамаға жауаптымын.
Dialogue: 0,0:19:20.45,0:19:21.41,Default,,0,0,0,,Мен пас бердім. Мен жолдамаға жауаптымын.
Dialogue: 0,0:19:20.45,0:19:21.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:21.41,0:19:21.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:21.53,0:19:21.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:21.53,0:19:21.78,Default,,0,0,0,,Бұны тастаңыз!
Dialogue: 0,0:19:21.78,0:19:22.57,Default,,0,0,0,,Мынаны тастаңыз!
Dialogue: 0,0:19:22.70,0:19:23.87,Default,,0,0,0,,Бұл күшті соққы болды.
Dialogue: 0,0:19:23.99,0:19:24.87,Default,,0,0,0,,Жол толық емес
Dialogue: 0,0:19:24.99,0:19:26.95,Default,,0,0,0,,Ресивер бір рет шығады...
Dialogue: 0,0:19:27.08,0:19:28.79,Default,,0,0,0,,Менде кері қайтару бар болса да...
Dialogue: 0,0:19:28.91,0:19:30.62,Default,,0,0,0,,Иә, жалау өшті.
Dialogue: 0,0:19:30.75,0:19:33.50,Default,,0,0,0,,Бұзушылық орын алған сияқты.
Dialogue: 0,0:19:34.33,0:19:35.50,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:19:36.42,0:19:37.96,Default,,0,0,0,,Менің ұстағаным... (Комментатор) Иә...
Dialogue: 0,0:19:38.09,0:19:40.34,Default,,0,0,0,,Мен Смитпін, кең қабылдаушымын.
Dialogue: 0,0:19:40.47,0:19:42.89,Default,,0,0,0,,Бұл біраз алаңдатады. (Комментатор) Дұрыс.
Dialogue: 0,0:19:43.64,0:19:44.60,Default,,0,0,0,,Жарайды, басына тиген шығар...
Dialogue: 0,0:19:44.60,0:19:46.81,Default,,0,0,0,,Жарайды, басына тиген шығар...
Dialogue: 0,0:19:44.60,0:19:46.81,Default,,0,0,0,,(ағылшынша төреші)
Dialogue: 0,0:19:46.81,0:19:49.27,Default,,0,0,0,,(ағылшынша төреші)
Dialogue: 0,0:19:49.27,0:19:51.02,Default,,0,0,0,,(ағылшынша төреші)
Dialogue: 0,0:19:49.27,0:19:51.02,Default,,0,0,0,,Қорғанысты бұзғаны үшін -
Dialogue: 0,0:19:51.02,0:19:51.69,Default,,0,0,0,,Қорғанысты бұзғаны үшін -
Dialogue: 0,0:19:51.81,0:19:53.85,Default,,0,0,0,,Енді автоматты түрде алдымен төмен түседі
Dialogue: 0,0:19:53.98,0:19:55.48,Default,,0,0,0,,Қорғаныссыз ойыншыларға қарсы
Dialogue: 0,0:19:55.61,0:19:57.36,Default,,0,0,0,,Оны дулығамен ұруға болмайды...
Dialogue: 0,0:19:57.48,0:19:58.61,Default,,0,0,0,,Бұл ақымақ ереже.
Dialogue: 0,0:19:58.73,0:20:00.24,Default,,0,0,0,,Бетпе-бет деп аталатындар—
Dialogue: 0,0:20:00.24,0:20:01.74,Default,,0,0,0,,Бетпе-бет деп аталатын.
Dialogue: 0,0:20:00.24,0:20:01.74,Default,,0,0,0,,Аа, сен тым қорғансың.
Dialogue: 0,0:20:01.74,0:20:01.86,Default,,0,0,0,,А, сен тым қорғансың.
Dialogue: 0,0:20:01.86,0:20:02.65,Default,,0,0,0,,А, сен тым қорғансың.
Dialogue: 0,0:20:01.86,0:20:02.65,Default,,0,0,0,,Осындай қауіпті ойынмен, Смит...
Dialogue: 0,0:20:02.65,0:20:05.16,Default,,0,0,0,,Осындай қауіпті ойынмен, Смит...
Dialogue: 0,0:20:05.49,0:20:08.66,Default,,0,0,0,,Ол өлсе де мен ештеңе сезбеймін.
Dialogue: 0,0:20:08.79,0:20:11.12,Default,,0,0,0,,Мен оны өлтірсем де, оны сезе алмадым.
Dialogue: 0,0:20:11.25,0:20:13.67,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:20:13.96,0:20:16.04,Default,,0,0,0,,Мен соңғы кездері түс көріп жүрмін.
Dialogue: 0,0:20:16.67,0:20:18.63,Default,,0,0,0,,Бұл қорқынышты түс пе?
Dialogue: 0,0:20:19.00,0:20:20.88,Default,,0,0,0,,Негізі мен де.
Dialogue: 0,0:20:21.13,0:20:22.42,Default,,0,0,0,,Жарайды, мен де мұндағы ісімді бітірдім. Өз кілтіңмен кір.
Dialogue: 0,0:20:22.55,0:20:23.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:23.72,0:20:27.35,Default,,0,0,0,,Біз бірдеңені сезіне алмаймыз, өйткені біз тым қорғандық...
Dialogue: 0,0:20:27.47,0:20:30.39,Default,,0,0,0,,Менің ойымша, ол әлі де мида бар.
Dialogue: 0,0:20:30.64,0:20:33.48,Default,,0,0,0,,Алекс айтты... Эй.
Dialogue: 0,0:20:33.73,0:20:36.44,Default,,0,0,0,,Ах, тозақ.
Dialogue: 0,0:20:38.69,0:20:42.15,Default,,0,0,0,,Бәлкім, бір күні біздің де басымыздан осындай нәрсе болатын шығар.
Dialogue: 0,0:20:43.74,0:20:46.49,Default,,0,0,0,,Бұған дейін мен ереже бұздым.
Dialogue: 0,0:20:46.70,0:20:47.66,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:20:48.49,0:20:50.62,Default,,0,0,0,,Бұл нашар жұмыс.
Dialogue: 0,0:20:50.74,0:20:51.83,Default,,0,0,0,,Міне, Абдул мырза дәл осылай дейді
Dialogue: 0,0:20:52.41,0:20:53.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:54.33,0:20:59.21,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:20:59.34,0:21:00.17,Default,,0,0,0,,Иә
Dialogue: 0,0:21:04.05,0:21:05.88,Default,,0,0,0,,Иә, мен сенімен біргемін.
Dialogue: 0,0:21:06.89,0:21:10.22,Default,,0,0,0,,Пентагон? Жақында ма?
Dialogue: 0,0:21:11.85,0:21:12.68,Default,,0,0,0,,Сонымен
Dialogue: 0,0:21:14.69,0:21:15.64,Default,,0,0,0,,Шақыру
Dialogue: 0,0:21:15.77,0:21:18.23,Default,,0,0,0,,Енді... Смит, сен тұрсың.
Dialogue: 0,0:21:18.36,0:21:19.19,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:19.90,0:21:21.69,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:21:21.78,0:21:22.53,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:21:22.53,0:21:25.74,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:21:22.53,0:21:25.74,Default,,0,0,0,,Осылайша үлкен қуаныш болды.
Dialogue: 0,0:21:25.74,0:21:25.86,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:21:25.86,0:21:26.70,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:21:25.86,0:21:26.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:56.39,0:21:57.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:01.36,0:22:02.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:03.86,0:22:05.74,Default,,0,0,0,,Келесі қайда?
Dialogue: 0,0:22:05.86,0:22:08.74,Default,,0,0,0,,Терроризмге қарсы барлау қызметінің жиыны. Сен ше?
Dialogue: 0,0:22:08.86,0:22:11.45,Default,,0,0,0,,Ливияны либерализациялау комиссиясы, солай ма?
Dialogue: 0,0:22:13.12,0:22:15.66,Default,,0,0,0,,Бұл капитан Клавис Шепард болатын.
Dialogue: 0,0:22:15.95,0:22:17.58,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:22:18.83,0:22:21.92,Default,,0,0,0,,Сіз АҚШ-ты дағдарыстан құтқардыңыз.
Dialogue: 0,0:22:22.04,0:22:23.55,Default,,0,0,0,,Мен ризашылығымды білдіргім келеді
Dialogue: 0,0:22:23.67,0:22:25.05,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:22:31.26,0:22:34.18,Default,,0,0,0,,Дұрыс, кіріңіз.
Dialogue: 0,0:22:40.69,0:22:41.52,Default,,0,0,0,,Иә
Dialogue: 0,0:22:43.02,0:22:46.40,Default,,0,0,0,,Бұл әйел - Евгений мен Круппстың Эрика Сэйлс.
Dialogue: 0,0:22:46.53,0:22:48.15,Default,,0,0,0,,Жеке әскери рота?
Dialogue: 0,0:22:48.49,0:22:50.78,Default,,0,0,0,,Ол дарынды сатушы әйел.
Dialogue: 0,0:22:50.91,0:22:52.66,Default,,0,0,0,,Сол екі адам
Dialogue: 0,0:22:53.20,0:22:55.99,Default,,0,0,0,,Сіз не істеп жатырсыз? Кіріңіз.
Dialogue: 0,0:22:57.08,0:22:58.91,Default,,0,0,0,,Бұл PTSD ма?
Dialogue: 0,0:22:59.16,0:23:02.92,Default,,0,0,0,,Иә, бұл барлық сарапшылардың пікірлеріне негізделген қорытынды.
Dialogue: 0,0:23:03.21,0:23:05.55,Default,,0,0,0,,Прапорщик Алекстің операция алдындағы эмоционалды бейімделуі —
Dialogue: 0,0:23:05.67,0:23:07.34,Default,,0,0,0,,Кемшілік анықталды
Dialogue: 0,0:23:07.46,0:23:08.38,Default,,0,0,0,,Жетіспеушілік?
Dialogue: 0,0:23:08.51,0:23:11.43,Default,,0,0,0,,Мен мұнда нақты сандарды түсіндіре алмаймын, бірақ...
Dialogue: 0,0:23:11.89,0:23:14.93,Default,,0,0,0,,Реттеу мәнінің параметрлерінде қате табылды.
Dialogue: 0,0:23:16.93,0:23:20.10,Default,,0,0,0,,PTSD алдын алу үшін эмоционалды реттеу
Dialogue: 0,0:23:20.23,0:23:23.31,Default,,0,0,0,,Сіз бұл PTSD тудырды дейсіз бе?
Dialogue: 0,0:23:23.44,0:23:26.44,Default,,0,0,0,,Сізді де алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:23:26.90,0:23:29.40,Default,,0,0,0,,Қайталанудың алдын алу шаралары қазірдің өзінде қабылданған
Dialogue: 0,0:23:29.53,0:23:30.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:30.49,0:23:34.70,Default,,0,0,0,,Сіздің бұл жағдайдағы пікіріңіз 100% расталды.
Dialogue: 0,0:23:34.83,0:23:36.28,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,0:23:36.41,0:23:39.45,Default,,0,0,0,,Капитан Крависті тастағыңыз келе ме?
Dialogue: 0,0:23:39.83,0:23:42.46,Default,,0,0,0,,Жоқ, жоқ... олай емес...
Dialogue: 0,0:23:45.34,0:23:47.67,Default,,0,0,0,,Сізде жаңа миссия бар.
Dialogue: 0,0:23:47.80,0:23:49.80,Default,,0,0,0,,Сіз американдықсыз ба?
Dialogue: 0,0:23:49.92,0:23:51.05,Default,,0,0,0,,Иә.
Dialogue: 0,0:23:55.51,0:23:56.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:57.01,0:23:58.31,Default,,0,0,0,,Джон Павел
Dialogue: 0,0:23:58.43,0:24:01.39,Default,,0,0,0,,Бұл сізге таныс ер есім.
Dialogue: 0,0:24:01.85,0:24:04.23,Default,,0,0,0,,және Intermedia Group
Dialogue: 0,0:24:04.35,0:24:08.11,Default,,0,0,0,,Мемлекеттер мен ірі компаниялардың имидждік стратегияларын үйлестіретін компания.
Dialogue: 0,0:24:08.23,0:24:11.95,Default,,0,0,0,,Үш жыл бұрын Сомали халықаралық қауымдастықтан инвестиция тартты—
Dialogue: 0,0:24:12.07,0:24:15.99,Default,,0,0,0,,Ол экономиканы қалпына келтіру үшін танымал болды.
Dialogue: 0,0:24:16.12,0:24:17.41,Default,,0,0,0,,Сол кезде Джон Павел —
Dialogue: 0,0:24:17.53,0:24:20.62,Default,,0,0,0,,Мемлекет клиент болып табылатын іске жауапты тұлға ретінде...
Dialogue: 0,0:24:20.75,0:24:23.33,Default,,0,0,0,,Көптеген елдерде қызмет көрсетіледі
Dialogue: 0,0:24:23.83,0:24:26.71,Default,,0,0,0,,Ақырында Джон Пол жетістіктері үшін танылды.
Dialogue: 0,0:24:26.84,0:24:31.51,Default,,0,0,0,,Бірқатар елдердің мәдениет және жариялылыққа жауапты министрлерінің көмекшісі болды
Dialogue: 0,0:24:32.47,0:24:34.51,Default,,0,0,0,,Ал қырғын басталды
Dialogue: 0,0:24:34.76,0:24:38.51,Default,,0,0,0,,Иә, сіз бұрыннан білетін сияқтысыз, Шепард.
Dialogue: 0,0:24:38.76,0:24:41.43,Default,,0,0,0,,Иә, бұл қазіргі күй —
Dialogue: 0,0:24:41.56,0:24:46.02,Default,,0,0,0,,Ол бүкіл әлемде болып жатқан хаостың ортасында.
Dialogue: 0,0:24:49.07,0:24:51.03,Default,,0,0,0,,Бар болғаны жарты жыл
Dialogue: 0,0:24:51.40,0:24:53.90,Default,,0,0,0,,Джон қай бейбіт елге барды?
Dialogue: 0,0:24:54.03,0:24:57.03,Default,,0,0,0,,Азаматтар бір-бірін алты айдың ішінде өлтірді.
Dialogue: 0,0:24:57.37,0:24:59.70,Default,,0,0,0,,Көп ұзамай қырғын басталады
Dialogue: 0,0:24:59.83,0:25:02.54,Default,,0,0,0,,Бірақ сіз жауапты білдіңіз, солай ма?
Dialogue: 0,0:25:03.04,0:25:07.46,Default,,0,0,0,,Операциядан бұрын мен Джон Полды өлтіру туралы бұйрық алған кезде де.
Dialogue: 0,0:25:10.75,0:25:12.17,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:25:12.76,0:25:16.47,Default,,0,0,0,,Арнайы операциялар қолбасшылығынан өлтіру операциясын сұрамас бұрын —
Dialogue: 0,0:25:16.59,0:25:20.64,Default,,0,0,0,,Біз Джон Полды ұстауға бірнеше әрекет жасадық.
Dialogue: 0,0:25:20.76,0:25:22.52,Default,,0,0,0,,Сіз «біз» дейсіз, ал сіз ше?
Dialogue: 0,0:25:22.64,0:25:27.19,Default,,0,0,0,,Бұл ЦРУ. Шетелге келетін болсақ, бұл біздің бақшамыз.
Dialogue: 0,0:25:27.31,0:25:30.36,Default,,0,0,0,,Басқаша айтқанда, сәтсіздіктеріңізді өшіру үшін...
Dialogue: 0,0:25:30.48,0:25:32.61,Default,,0,0,0,,Біз өз өмірімізді жоғалтуға мәжбүрміз.
Dialogue: 0,0:25:32.73,0:25:34.82,Default,,0,0,0,,Аузыңызды жабық ұстаңыз
Dialogue: 0,0:25:35.36,0:25:36.78,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:25:36.91,0:25:39.12,Default,,0,0,0,,Бірақ олардың ебедейсіздігі болмаса...
Dialogue: 0,0:25:39.24,0:25:41.16,Default,,0,0,0,,Алекс ешқашан өлген жоқ.
Dialogue: 0,0:25:41.28,0:25:43.33,Default,,0,0,0,,Бұл тағы да «ол қазір басталды» сценарийі ме, кіру емтихандарындағыдай?
Dialogue: 0,0:25:43.58,0:25:45.75,Default,,0,0,0,,Егер мен бір ақтауға болатын болсам...
Dialogue: 0,0:25:45.87,0:25:49.50,Default,,0,0,0,,Осы кезеңде кейбір қатыгездіктерге қатысты—
Dialogue: 0,0:25:49.63,0:25:52.42,Default,,0,0,0,,Оның қандай да бір жолмен қатысы бар сияқты.
Dialogue: 0,0:25:52.55,0:25:55.92,Default,,0,0,0,,Күдіктің деңгейі ғана болды.
Dialogue: 0,0:25:56.05,0:25:57.55,Default,,0,0,0,,Осы арада...
Dialogue: 0,0:25:57.68,0:26:00.18,Default,,0,0,0,,Әлемдегі хаос жеделдетілген қарқынмен тереңдей түсуде.
Dialogue: 0,0:26:00.30,0:26:02.81,Default,,0,0,0,,Біз алған ақпарат негізінде
Dialogue: 0,0:26:02.93,0:26:06.60,Default,,0,0,0,,Джон Пол бұл зұлымдықтардың себебі...
Dialogue: 0,0:26:06.73,0:26:08.40,Default,,0,0,0,,Мен сенімді болдым
Dialogue: 0,0:26:08.52,0:26:09.98,Default,,0,0,0,,Тек бір адам...
Dialogue: 0,0:26:10.40,0:26:14.23,Default,,0,0,0,,Дүние жүзін аралап, жаппай кісі өлтіру туралы нұсқау беру керек пе?
Dialogue: 0,0:26:14.36,0:26:15.94,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:26:16.07,0:26:16.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:17.36,0:26:19.99,Default,,0,0,0,,Мен неге өлтірдім...?
Dialogue: 0,0:26:20.66,0:26:22.99,Default,,0,0,0,,сұраңыз, айтыңыз
Dialogue: 0,0:26:24.79,0:26:28.00,Default,,0,0,0,,Мен не өлтірдім...?
Dialogue: 0,0:26:31.71,0:26:33.00,Default,,0,0,0,,Сонымен не керек?
Dialogue: 0,0:26:35.38,0:26:36.26,Default,,0,0,0,,Соқпақ
Dialogue: 0,0:26:36.55,0:26:37.55,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:26:38.05,0:26:39.09,Default,,0,0,0,,Джон Пол қазір...
Dialogue: 0,0:26:39.22,0:26:42.01,Default,,0,0,0,,Чехияда жасырынып жүр деген болжам бар
Dialogue: 0,0:26:42.35,0:26:44.35,Default,,0,0,0,,Шпионға еліктегенімізді қалайсың ба?
Dialogue: 0,0:26:44.47,0:26:45.56,Default,,0,0,0,,Өздеріңіз білетіндей—
Dialogue: 0,0:26:45.68,0:26:49.56,Default,,0,0,0,,Біздің барлау күштерінің I арнайы іздестіру тобының миссиясы:
Dialogue: 0,0:26:49.69,0:26:52.90,Default,,0,0,0,,Ең алдымен адамзатқа қарсы қылмыстар, б.а.
Dialogue: 0,0:26:53.44,0:26:56.61,Default,,0,0,0,,Қанды қырғынды басқарған қарулы топтың басшысын өлтіру —
Dialogue: 0,0:26:56.74,0:26:59.07,Default,,0,0,0,,Геноцидтің таралуын тоқтату
Dialogue: 0,0:26:59.20,0:27:00.99,Default,,0,0,0,,Бірақ қазір Джон
Dialogue: 0,0:27:01.11,0:27:04.12,Default,,0,0,0,,Егер бір жерде жаппай өлтіру тұқымдары өсіп жатса...
Dialogue: 0,0:27:04.24,0:27:06.75,Default,,0,0,0,,Мен оның қайда бара жатқанын қадағалауым керек.
Dialogue: 0,0:27:09.00,0:27:10.75,Default,,0,0,0,,Лузия Шкурупова
Dialogue: 0,0:27:10.87,0:27:14.00,Default,,0,0,0,,Мен Прагада жеке чех мұғалімімін.
Dialogue: 0,0:27:14.13,0:27:15.75,Default,,0,0,0,,3 күн бұрын Джон Пол...
Dialogue: 0,0:27:15.88,0:27:18.09,Default,,0,0,0,,Бұл әйелге көрінді
Dialogue: 0,0:27:18.21,0:27:22.01,Default,,0,0,0,,Мен мұны екі жыл бойы бақылап келемін және бұл бірінші рет.
Dialogue: 0,0:27:22.72,0:27:24.72,Default,,0,0,0,,Джон Полдың әйелі?
Dialogue: 0,0:27:25.47,0:27:27.81,Default,,0,0,0,,Ол Чехиядан шығып кеткен болуы мүмкін бе?
Dialogue: 0,0:27:28.10,0:27:29.18,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:27:29.31,0:27:32.31,Default,,0,0,0,,Өйткені, ол тіпті әуежай куәлігімен де танылмайтын адам.
Dialogue: 0,0:27:32.85,0:27:38.03,Default,,0,0,0,,Сіз оның әйелді желіге қою арқылы қайтып оралу мүмкіндігіне бәс тігесіз...?
Dialogue: 0,0:27:38.23,0:27:41.78,Default,,0,0,0,,Сізді барлау қызметкері етіп тағайындаумен бір мезгілде...
Dialogue: 0,0:27:41.91,0:27:45.95,Default,,0,0,0,,Біріккен штабтар бастықтарының барлау басқармасына уақытша бекітілген
Dialogue: 0,0:27:46.08,0:27:49.33,Default,,0,0,0,,Тағы бір қырғынды тек сіз ғана тоқтата аласыз.
Dialogue: 0,0:27:49.66,0:27:51.62,Default,,0,0,0,,Енді мен мұны істеп жатқанда...
Dialogue: 0,0:27:51.75,0:27:54.08,Default,,0,0,0,,Джон Пол жер бетіндегі кейбір елді...
Dialogue: 0,0:27:54.63,0:27:57.59,Default,,0,0,0,,Ол тозаққа түсуі мүмкін.
Dialogue: 0,0:28:01.80,0:28:03.93,Default,,0,0,0,,Джон Полдың профилі:
Dialogue: 0,0:28:04.05,0:28:07.76,Default,,0,0,0,,Бұл аяқталып жатқан кроссворд.
Dialogue: 0,0:28:07.89,0:28:10.73,Default,,0,0,0,,Сіз бәрін басынан бастап ашсаңыз...
Dialogue: 0,0:28:11.06,0:28:12.94,Default,,0,0,0,,Бұл біздің пікіріміз.
Dialogue: 0,0:28:13.77,0:28:16.36,Default,,0,0,0,,Джон Пол Сараевода әйелі мен баласынан айырылды
Dialogue: 0,0:28:17.61,0:28:18.27,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:28:18.27,0:28:18.86,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:28:18.27,0:28:18.86,Default,,0,0,0,,Қалада мен тек көрікті жерлерді көру үшін бардым —
Dialogue: 0,0:28:18.86,0:28:20.99,Default,,0,0,0,,Қалада мен тек көрікті жерлерді көру үшін бардым —
Dialogue: 0,0:28:21.11,0:28:23.99,Default,,0,0,0,,Джон Полдың әйелі мен алты жасар қызы...
Dialogue: 0,0:28:24.11,0:28:27.74,Default,,0,0,0,,Мен әп-сәтте кратердің түбіне дейін өртеніп кеттім.
Dialogue: 0,0:28:28.41,0:28:31.37,Default,,0,0,0,,Жеке куәлік ізіне сәйкес ол...
Dialogue: 0,0:28:31.50,0:28:34.79,Default,,0,0,0,,Студент Лузия Шкурупованың пәтерінде болды.
Dialogue: 0,0:28:34.92,0:28:36.13,Default,,0,0,0,,Бұл зинақорлық.
Dialogue: 0,0:28:36.79,0:28:38.13,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:28:38.25,0:28:40.63,Default,,0,0,0,,Джон Пол жәбірленушінің туысы ретінде
Dialogue: 0,0:28:40.76,0:28:43.13,Default,,0,0,0,,Мен Сараево кратерінің жанында жұмыс істеймін.
Dialogue: 0,0:28:47.01,0:28:50.14,Default,,0,0,0,,Көп ұзамай Джон Пол MIT қызметінен кетті.
Dialogue: 0,0:28:50.97,0:28:54.14,Default,,0,0,0,,Ол Intermedia Group-қа алты айдан кейін қосылды.
Dialogue: 0,0:28:54.94,0:28:57.81,Default,,0,0,0,,Біздің клиент елдеріміздің қиын жағдайын жеткізу үшін—
Dialogue: 0,0:28:57.94,0:28:59.90,Default,,0,0,0,,Атақты шенеуніктерді қабылдау және—
Dialogue: 0,0:29:00.23,0:29:03.65,Default,,0,0,0,,Американдық жаңалықтар шоуларында министрлердің шығуын басқару
Dialogue: 0,0:29:03.78,0:29:07.95,Default,,0,0,0,,Ол компания ішінде үлкен мақтауға ие болады.
Dialogue: 0,0:29:09.28,0:29:12.41,Default,,0,0,0,,Міне, оның жасырғысы келетін тарихының бір бөлігі.
Dialogue: 0,0:29:14.87,0:29:18.92,Default,,0,0,0,,Ол Америка үкіметі бекіткен экспорт болды.
Dialogue: 0,0:29:19.46,0:29:21.17,Default,,0,0,0,,Яғни, Пентагон отырысында —
Dialogue: 0,0:29:21.30,0:29:22.88,Default,,0,0,0,,Қатысқандар арасында—
Dialogue: 0,0:29:23.01,0:29:27.30,Default,,0,0,0,,Бұл Джонды білетін адамдар аз болғанын білдіреді.
Dialogue: 0,0:29:31.68,0:29:34.14,Default,,0,0,0,,Бұл мен басқарған барлық істерде орын алды.
Dialogue: 0,0:29:34.27,0:29:36.23,Default,,0,0,0,,Қанды қырғыннан шығар
Dialogue: 0,0:29:36.35,0:29:39.15,Default,,0,0,0,,Ол компаниядан кетуге мәжбүр болды.
Dialogue: 0,0:29:39.27,0:29:41.44,Default,,0,0,0,,Ал Джон Полдың сертификаты —
Dialogue: 0,0:29:41.57,0:29:44.03,Default,,0,0,0,,Ақырында, Прагадағы осы сауда орталығы.
Dialogue: 0,0:29:44.15,0:29:46.15,Default,,0,0,0,,Өмір сүруін тоқтатады
Dialogue: 0,0:29:48.49,0:29:52.45,Default,,0,0,0,,(Музыкалық аспаптарда ойнау)
Dialogue: 0,0:29:55.75,0:29:57.87,Default,,0,0,0,,Еуропалық ақпарат саласында —
Dialogue: 0,0:29:58.00,0:30:00.17,Default,,0,0,0,,Прагада жоғалып кеткен адамның ізі...
Dialogue: 0,0:30:00.29,0:30:02.30,Default,,0,0,0,,Шамасы, ол нөлге тең деп айтылады.
Dialogue: 0,0:30:02.42,0:30:05.67,Default,,0,0,0,,«Шамасы» анық емес ақпарат.
Dialogue: 0,0:30:05.80,0:30:07.13,Default,,0,0,0,,Бірақ Джон Павел
Dialogue: 0,0:30:07.26,0:30:08.97,Default,,0,0,0,,Олар шынымен де осы қалада жоғалып кетті.
Dialogue: 0,0:30:09.34,0:30:13.01,Default,,0,0,0,,Бұл екі рет болды, бір рет үш жыл бұрын және бір жеті күн бұрын.
Dialogue: 0,0:30:13.35,0:30:15.93,Default,,0,0,0,,«Джон Павелді күту»?
Dialogue: 0,0:30:16.06,0:30:18.52,Default,,0,0,0,,Бұл Кафка сияқты.
Dialogue: 0,0:30:19.06,0:30:20.36,Default,,0,0,0,,Сіз айтып отырған нәрсе –
Dialogue: 0,0:30:20.73,0:30:24.03,Default,,0,0,0,,«Годотты күту» болса, бұл Бекетт.
Dialogue: 0,0:30:24.15,0:30:25.74,Default,,0,0,0,,Ал оқиға –
Dialogue: 0,0:30:25.86,0:30:30.87,Default,,0,0,0,,Бұл Годоның соңына дейін көрінбейтін және даяшы ол туралы тоқтаусыз әңгімелейтін оқиға.
Dialogue: 0,0:30:30.99,0:30:33.12,Default,,0,0,0,,Тіпті берекелі болмайтын нәрсені айтпа.
Dialogue: 0,0:30:33.54,0:30:35.62,Default,,0,0,0,,Барлық абсурдтар Кафка.
Dialogue: 0,0:30:35.70,0:30:36.16,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:30:36.16,0:30:37.16,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:30:36.16,0:30:37.16,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:30:37.16,0:30:41.71,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:30:44.55,0:30:46.13,Default,,0,0,0,,Шынымен-
Dialogue: 0,0:30:46.26,0:30:51.01,Default,,0,0,0,,Чех тілін үйрену басқа тілдерге қарағанда қиынырақ болуы мүмкін.
Dialogue: 0,0:30:51.72,0:30:52.93,Default,,0,0,0,,епископ мырза
Dialogue: 0,0:30:53.39,0:30:54.47,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:30:55.68,0:30:57.23,Default,,0,0,0,,Чех негізінен —
Dialogue: 0,0:30:57.35,0:31:01.44,Default,,0,0,0,,Бұл орыс және хорват тілдерімен бірдей славян тілінің аймағына жатады, бірақ...
Dialogue: 0,0:31:01.56,0:31:03.40,Default,,0,0,0,,Бұл славян тіліне тән —
Dialogue: 0,0:31:03.52,0:31:05.65,Default,,0,0,0,,Әр сөздің жағдайына қарай—
Dialogue: 0,0:31:05.78,0:31:08.61,Default,,0,0,0,,Кіріспедегі вариациялар шектен шыққан.
Dialogue: 0,0:31:08.74,0:31:12.20,Default,,0,0,0,,200-ден астам флексия, солай ма?
Dialogue: 0,0:31:12.32,0:31:14.16,Default,,0,0,0,,Бұл ең жарқын мысал.
Dialogue: 0,0:31:16.66,0:31:19.21,Default,,0,0,0,,Бірақ чех тілінің қиындығы –
Dialogue: 0,0:31:19.33,0:31:23.42,Default,,0,0,0,,Бұл сөздің еркін орын тәртібі мен айтылуы қиын екпінге байланысты болған сияқты.
Dialogue: 0,0:31:23.54,0:31:26.13,Default,,0,0,0,,Шетелден келгендер үшін...
Dialogue: 0,0:31:26.25,0:31:29.80,Default,,0,0,0,,Барлығының айтылуында қиналған сияқты.
Dialogue: 0,0:31:29.92,0:31:31.43,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:31:32.72,0:31:34.35,Default,,0,0,0,,Лузия Шукурупова —
Dialogue: 0,0:31:34.47,0:31:38.06,Default,,0,0,0,,Шетелдіктерге чех тілін үйрету арқылы күн көремін.
Dialogue: 0,0:31:39.06,0:31:41.44,Default,,0,0,0,,Осы сәл кең қонақ бөлмеде —
Dialogue: 0,0:31:41.56,0:31:45.15,Default,,0,0,0,,Студенттер чех тілін осы әйелден үйренеді
Dialogue: 0,0:31:46.11,0:31:48.69,Default,,0,0,0,,Сіздің мұғаліміңіз ағылшын тілін өте жақсы біледі.
Dialogue: 0,0:31:49.57,0:31:52.20,Default,,0,0,0,,Ағылшын тілі енді гегемондық тіл.
Dialogue: 0,0:31:52.70,0:31:54.53,Default,,0,0,0,,Қайсысы ағылшын тілі?
Dialogue: 0,0:31:54.74,0:31:55.70,Default,,0,0,0,,Америка
Dialogue: 0,0:31:56.37,0:31:57.95,Default,,0,0,0,,Мен тіл білімін оқып жүргенмін.
Dialogue: 0,0:31:58.08,0:32:00.71,Default,,0,0,0,,Демек, сіз сөз кәсіпқойсыз ба?
Dialogue: 0,0:32:01.58,0:32:03.54,Default,,0,0,0,,Америкада қайсысы?
Dialogue: 0,0:32:03.67,0:32:04.96,Default,,0,0,0,,М.И.Т.
Dialogue: 0,0:32:05.21,0:32:07.46,Default,,0,0,0,,Уау, бұл элита.
Dialogue: 0,0:32:07.80,0:32:09.30,Default,,0,0,0,,«Уау, бұл элита».
Dialogue: 0,0:32:09.42,0:32:12.09,Default,,0,0,0,,Мен сонда ғана оқи алатын кезім болды.
Dialogue: 0,0:32:12.22,0:32:15.26,Default,,0,0,0,,Сол үшін бардым, болды.
Dialogue: 0,0:32:15.39,0:32:17.68,Default,,0,0,0,,Сіз MIT-те қандай зерттеу жүргізесіз?
Dialogue: 0,0:32:19.56,0:32:20.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:22.06,0:32:24.48,Default,,0,0,0,,Жарайды... былайша айтқанда...
Dialogue: 0,0:32:25.19,0:32:28.73,Default,,0,0,0,,Тіл адамның мінез-құлқына қалай әсер етеді...
Dialogue: 0,0:32:28.86,0:32:29.98,Default,,0,0,0,,Зерттеудің бұл түрі.
Dialogue: 0,0:32:30.44,0:32:33.70,Default,,0,0,0,,Тіл адам болмысын қалыптастырады...
Dialogue: 0,0:32:33.82,0:32:38.24,Default,,0,0,0,,Эскимостар қарды сипаттау үшін 20 түрлі зат есім қолданады ма?
Dialogue: 0,0:32:38.53,0:32:40.24,Default,,0,0,0,,Уууу (Клавис) Ах...
Dialogue: 0,0:32:40.50,0:32:42.91,Default,,0,0,0,,Ностальгиялық Сапир-Уорф.
Dialogue: 0,0:32:43.04,0:32:45.67,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:32:45.79,0:32:48.75,Default,,0,0,0,,Туа біткен сөйлем тудыру қызметі туралы білесің бе?
Dialogue: 0,0:32:49.13,0:32:50.09,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:32:50.21,0:32:51.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:52.97,0:32:56.55,Default,,0,0,0,,Бұл құл еңбегі заңды болған кезден.
Dialogue: 0,0:32:56.68,0:32:59.43,Default,,0,0,0,,Мені Африканың әртүрлі бөліктерінен ұрлап әкетті —
Dialogue: 0,0:32:59.56,0:33:01.81,Default,,0,0,0,,Әр түрлі тайпалардың адамдары—
Dialogue: 0,0:33:01.93,0:33:05.27,Default,,0,0,0,,Бір-бірімізбен тіл табыса алмай жұмыс істеуге мәжбүр болдық.
Dialogue: 0,0:33:05.90,0:33:08.73,Default,,0,0,0,,Ақыры олар қожайынының тілін естіп,...
Dialogue: 0,0:33:08.86,0:33:11.11,Default,,0,0,0,,Сынық сөздермен сөйлей бастады
Dialogue: 0,0:33:11.53,0:33:16.61,Default,,0,0,0,,Оның грамматикасы бей-берекет, әдеби шеберлігі жоқ еді.
Dialogue: 0,0:33:16.95,0:33:20.91,Default,,0,0,0,,Бірінші буын сөзі «пиджин» деп аталады.
Dialogue: 0,0:33:21.29,0:33:25.29,Default,,0,0,0,,Балалары ана тілі деп сол пиджинмен өскенде...
Dialogue: 0,0:33:25.71,0:33:27.46,Default,,0,0,0,,Қатты пиджинде емес—
Dialogue: 0,0:33:27.58,0:33:30.67,Default,,0,0,0,,Жанды және табиғи грамматика дүниеге келді.
Dialogue: 0,0:33:31.09,0:33:35.43,Default,,0,0,0,,Балалар болмаған күрделі грамматиканы меңгерді.
Dialogue: 0,0:33:35.93,0:33:38.34,Default,,0,0,0,,Оның ішінде миы алдын ала болғандықтан.
Dialogue: 0,0:33:38.47,0:33:41.68,Default,,0,0,0,,Оның сөйлем құрайтын механизмі болуы керек.
Dialogue: 0,0:33:42.52,0:33:45.35,Default,,0,0,0,,Туа біткен сөйлем тудыру қызметі...
Dialogue: 0,0:33:45.48,0:33:48.19,Default,,0,0,0,,Гендерде жазылған ми функциялары
Dialogue: 0,0:33:48.65,0:33:52.86,Default,,0,0,0,,Менің ойымша, мен оны сөз тудыратын орган деп атасам керек...
Dialogue: 0,0:33:52.98,0:33:55.74,Default,,0,0,0,,Ах... органдар дегеніміз...
Dialogue: 0,0:33:55.86,0:33:59.24,Default,,0,0,0,,Ішкі мүшелер, қолдар немесе көздер сияқты мүше ме?
Dialogue: 0,0:33:59.37,0:34:01.83,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:34:03.12,0:34:06.50,Default,,0,0,0,,Мәдени әңгімеден оған біраз ләззат алған сияқты.
Dialogue: 0,0:34:06.62,0:34:08.37,Default,,0,0,0,,Әдебиет түлегі күткендей
Dialogue: 0,0:34:08.67,0:34:10.84,Default,,0,0,0,,Бұл жай ғана ағынның салдарынан болды.
Dialogue: 0,0:34:10.96,0:34:12.05,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:34:12.17,0:34:15.96,Default,,0,0,0,,Бұл бағытты басқарған сіз сияқты болдыңыз ба?
Dialogue: 0,0:34:16.09,0:34:17.76,Default,,0,0,0,,Әйел алудың сыры ма?
Dialogue: 0,0:34:18.13,0:34:21.30,Default,,0,0,0,,Айтпаңыз, бұл әлі де танымал.
Dialogue: 0,0:34:21.43,0:34:24.22,Default,,0,0,0,,Тіпті әлгі мұғалім мен барсам, хит болатынын айтты.
Dialogue: 0,0:34:24.35,0:34:27.64,Default,,0,0,0,,Мәдениетті әңгіме құра аласыз ба?
Dialogue: 0,0:34:27.94,0:34:28.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:30.56,0:34:32.73,Default,,0,0,0,,Эскимостар туралы әңгімелеу
Dialogue: 0,0:34:33.40,0:34:35.03,Default,,0,0,0,,Немесе Кафка әңгімесі.
Dialogue: 0,0:34:35.28,0:34:36.28,Default,,0,0,0,,Фу…
Dialogue: 0,0:34:36.78,0:34:38.11,Default,,0,0,0,,Бос орындар маңызды
Dialogue: 0,0:34:38.24,0:34:41.37,Default,,0,0,0,,Әйелді итеріп жібергендіктен, мен сүйкімді жағымды сақтауым керек.
Dialogue: 0,0:34:41.49,0:34:43.74,Default,,0,0,0,,Бұл саңылаудан гөрі кратер сияқты.
Dialogue: 0,0:34:43.87,0:34:45.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:46.58,0:34:48.54,Default,,0,0,0,,Бенхалигон суы
Dialogue: 0,0:34:49.17,0:34:51.42,Default,,0,0,0,,Бұл ерлерге арналған парфюмерия ма?
Dialogue: 0,0:34:51.54,0:34:54.55,Default,,0,0,0,,Джон Павелден кейін ер адамдар болмауы керек.
Dialogue: 0,0:34:55.09,0:34:57.59,Default,,0,0,0,,Джон Павелдің ұзаққа созылған иісі?
Dialogue: 0,0:34:58.09,0:34:59.30,Default,,0,0,0,,Оның алдында
Dialogue: 0,0:34:59.43,0:35:02.05,Default,,0,0,0,,Ол да әдемі көрінуге тырысып жатыр ма деп ойлаймын.
Dialogue: 0,0:35:03.10,0:35:03.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:04.14,0:35:04.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:05.10,0:35:07.31,Default,,0,0,0,,Шәует иісі бар ма?
Dialogue: 0,0:35:07.43,0:35:10.27,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет кездессек те, өте кездейсоқ болды.
Dialogue: 0,0:35:11.94,0:35:13.94,Default,,0,0,0,,Абайлаңыз, Клавис.
Dialogue: 0,0:35:14.23,0:35:17.44,Default,,0,0,0,,Менің ойымша, бұл әйел - фемма фатале.
Dialogue: 0,0:35:17.57,0:35:19.20,Default,,0,0,0,,Ер адамды бақытсыз етіңіз
Dialogue: 0,0:35:20.91,0:35:24.78,Default,,0,0,0,,Анау ақсақ феромондар әйелдерді тартпайды.
Dialogue: 0,0:35:26.37,0:35:27.37,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:35:28.29,0:35:29.21,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:35:29.54,0:35:33.21,Default,,0,0,0,,Олай болса, мұны келісім-шарт ретінде растай аласыз ба?
Dialogue: 0,0:35:33.79,0:35:37.17,Default,,0,0,0,,Уильямсқа қарағанда біршама озық қабілетті көрсетеді
Dialogue: 0,0:35:39.01,0:35:42.51,Default,,0,0,0,,Мен бір күні Кафканы чех тілінде оқи аламын деп үміттенемін.
Dialogue: 0,0:35:42.93,0:35:46.93,Default,,0,0,0,,О, Кафка романдарын неміс тілінде жазды.
Dialogue: 0,0:35:47.06,0:35:48.39,Default,,0,0,0,,Бұл ел бұрын болған кезде—
Dialogue: 0,0:35:48.52,0:35:52.19,Default,,0,0,0,,Оның Австро-Венгрия империясының құрамында болғанын білесіз бе?
Dialogue: 0,0:35:52.31,0:35:53.27,Default,,0,0,0,,Кез келген жағдайда.
Dialogue: 0,0:35:53.40,0:35:55.52,Default,,0,0,0,,Кафка да еврей болған
Dialogue: 0,0:35:55.65,0:35:58.99,Default,,0,0,0,,Алайда мен еврей қоғамына толықтай араласа алмадым.
Dialogue: 0,0:35:59.28,0:36:02.86,Default,,0,0,0,,Неміс тілінде де ол бұл сөздің жалған сөз екенін сезгендей болды.
Dialogue: 0,0:36:03.24,0:36:06.99,Default,,0,0,0,,Менің ешқайда жатпайтын адам екенімді түсіну...
Dialogue: 0,0:36:07.12,0:36:10.37,Default,,0,0,0,,«Құлып», «Америка» сияқты шығармаларда көрініс тапты ма деп ойлаймын.
Dialogue: 0,0:36:11.33,0:36:14.33,Default,,0,0,0,,Мен ешқайда жатпаймын...
Dialogue: 0,0:36:14.46,0:36:17.67,Default,,0,0,0,,Біз қолданатын сөздер қабылданатын дыбыстар қатары
Dialogue: 0,0:36:17.80,0:36:20.63,Default,,0,0,0,,Мүмкін Кафка солай ойлаған шығар.
Dialogue: 0,0:36:21.38,0:36:25.43,Default,,0,0,0,,маркшейдердей қамалды кезіп...?
Dialogue: 0,0:36:25.55,0:36:26.39,Default,,0,0,0,,А...
Dialogue: 0,0:36:28.22,0:36:29.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:30.93,0:36:35.61,Default,,0,0,0,,Кешіріңіз, мен сізге ұқсас адам есіме түсті.
Dialogue: 0,0:36:36.15,0:36:38.15,Default,,0,0,0,,Кітапты да жақсы көретін.
Dialogue: 0,0:36:38.40,0:36:40.32,Default,,0,0,0,,Ол қандай жігіт еді?
Dialogue: 0,0:36:40.44,0:36:43.32,Default,,0,0,0,,Хмм... Мен оған біраз кіремін.
Dialogue: 0,0:36:43.45,0:36:46.03,Default,,0,0,0,,Хехе... Бұл туралы айтқан сен едің ғой?
Dialogue: 0,0:36:47.20,0:36:49.54,Default,,0,0,0,,Ал... иә.
Dialogue: 0,0:36:51.25,0:36:56.46,Default,,0,0,0,,Ол да мен сияқты тіл үйренуші ғалым еді.
Dialogue: 0,0:36:56.88,0:37:00.34,Default,,0,0,0,,Алайда ол кісі одан да үлкен ғалым.
Dialogue: 0,0:37:00.46,0:37:04.30,Default,,0,0,0,,Ол Қорғаныс министрлігіне арналған тіл жобасына қатысқан сияқты.
Dialogue: 0,0:37:04.84,0:37:07.55,Default,,0,0,0,,Пентагон тіл біліміне инвестиция сала ма?
Dialogue: 0,0:37:07.80,0:37:11.93,Default,,0,0,0,,Ол Қорғаныс ғылыми жобалары агенттігінен ақша алып жатқанын айтты.
Dialogue: 0,0:37:12.06,0:37:14.06,Default,,0,0,0,,Ол керемет адам.
Dialogue: 0,0:37:14.39,0:37:16.06,Default,,0,0,0,,Біз MIT-те кездестік
Dialogue: 0,0:37:16.19,0:37:18.81,Default,,0,0,0,,Біз біраз уақыт кездесіп жүрдік, бірақ ол ұзаққа бармады.
Dialogue: 0,0:37:19.90,0:37:22.94,Default,,0,0,0,,Осыдан кейін мен туған жерім Чехияға оралдым және...
Dialogue: 0,0:37:23.07,0:37:25.32,Default,,0,0,0,,Мен бұл жұмысты не үшін бастадым?
Dialogue: 0,0:38:00.44,0:38:02.90,Default,,0,0,0,,Чехияның Туризм министрлігіне қош келдіңіз
Dialogue: 0,0:38:03.03,0:38:04.82,Default,,0,0,0,,Тілді таңдаңыз
Dialogue: 0,0:38:04.94,0:38:06.86,Default,,0,0,0,,(Экран жұмысының дыбысы)
Dialogue: 0,0:38:16.75,0:38:18.21,Default,,0,0,0,,Ондай емес пе...
Dialogue: 0,0:38:46.40,0:38:47.40,Default,,0,0,0,,(көліктегі қоңырау)
Dialogue: 0,0:38:47.90,0:38:54.41,Default,,0,0,0,,(Чех хабарландыруы)
Dialogue: 0,0:39:24.98,0:39:30.99,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:39:39.46,0:39:41.08,Default,,0,0,0,,Уильямсқа рахмет
Dialogue: 0,0:39:55.72,0:39:57.39,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:40:00.77,0:40:02.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:02.31,0:40:04.36,Default,,0,0,0,,Хух (Еркек) Ха! Гуаа
Dialogue: 0,0:40:04.48,0:40:06.19,Default,,0,0,0,,...Мен таң қалдым.
Dialogue: 0,0:40:06.32,0:40:08.98,Default,,0,0,0,,Ах... Уф!
Dialogue: 0,0:40:11.20,0:40:13.91,Default,,0,0,0,,Енді... сұрайын дегенім...
Dialogue: 0,0:40:14.03,0:40:15.74,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:40:16.08,0:40:18.24,Default,,0,0,0,,Мұны кім айтады?
Dialogue: 0,0:40:18.70,0:40:20.20,Default,,0,0,0,,Арх! Уф...
Dialogue: 0,0:40:20.33,0:40:24.50,Default,,0,0,0,,Енді менің сұрайын дегенім, сіз кімсіз?
Dialogue: 0,0:40:24.63,0:40:26.17,Default,,0,0,0,,Мен ешкім емеспін...
Dialogue: 0,0:40:26.50,0:40:27.34,Default,,0,0,0,,Бұлхо!
Dialogue: 0,0:40:27.84,0:40:29.80,Default,,0,0,0,,(Clavis шет тілі)
Dialogue: 0,0:40:29.92,0:40:34.30,Default,,0,0,0,,Уф... Мен ешкім емеспін, сеніңіз!
Dialogue: 0,0:40:34.43,0:40:38.35,Default,,0,0,0,,Бұл ешкім емес! Ух ха ха...
Dialogue: 0,0:40:38.72,0:40:41.81,Default,,0,0,0,,(адамның үрейлі дауысы)
Dialogue: 0,0:40:41.93,0:40:42.85,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:40:44.15,0:40:45.23,Default,,0,0,0,,Гррр…
Dialogue: 0,0:40:48.94,0:40:50.86,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:40:50.99,0:40:54.86,Default,,0,0,0,,(қуғыншылардың ауыр тыныс алуы)
Dialogue: 0,0:40:56.74,0:40:58.37,Default,,0,0,0,,Сіз қорқынышты адамсыз.
Dialogue: 0,0:41:00.16,0:41:01.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:02.71,0:41:04.37,Default,,0,0,0,,Мен қорқынышты адаммын
Dialogue: 0,0:41:13.80,0:41:16.14,Default,,0,0,0,,Жазатайым жағдайда немесе бірдеңеде саусағын жоғалтты
Dialogue: 0,0:41:16.26,0:41:18.51,Default,,0,0,0,,Сіз басқа біреудің...
Dialogue: 0,0:41:18.80,0:41:20.93,Default,,0,0,0,,Онда ол жазбада болуы керек.
Dialogue: 0,0:41:21.06,0:41:23.43,Default,,0,0,0,,Мәліметтер базасының сәйкессіздігі?
Dialogue: 0,0:41:26.40,0:41:28.77,Default,,0,0,0,,«Мен ешкім емеспін»…
Dialogue: 0,0:41:29.27,0:41:31.40,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:41:32.07,0:41:34.57,Default,,0,0,0,,Деректер базасына өзгерістер енгізе алады—
Dialogue: 0,0:41:34.70,0:41:36.95,Default,,0,0,0,,Қараңғы байланыстар бар
Dialogue: 0,0:41:37.07,0:41:39.49,Default,,0,0,0,,Ондайда бұл жігіт әлдебір үкіметтікі...
Dialogue: 0,0:41:39.62,0:41:41.54,Default,,0,0,0,,Агент болу ықтималдығы жоғары
Dialogue: 0,0:41:41.95,0:41:43.58,Default,,0,0,0,,Сол себепті Пентагон...
Dialogue: 0,0:41:43.70,0:41:46.33,Default,,0,0,0,,Джон Полды өлтіруге асығасыз ба?
Dialogue: 0,0:41:46.46,0:41:48.92,Default,,0,0,0,,Мүмкін... Иә?
Dialogue: 0,0:41:49.04,0:41:50.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:52.84,0:41:53.88,Default,,0,0,0,,Эй
Dialogue: 0,0:41:54.51,0:42:00.51,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:42:02.31,0:42:03.31,Default,,0,0,0,,Иә
Dialogue: 0,0:42:06.10,0:42:07.10,Default,,0,0,0,,Иә
Dialogue: 0,0:42:10.31,0:42:11.98,Default,,0,0,0,,Ол сізге Кафканың қабірін көрсеткісі келеді.
Dialogue: 0,0:42:12.11,0:42:15.78,Default,,0,0,0,,Люсиядан келген шақыру қайықпен жүру болды.
Dialogue: 0,0:42:16.70,0:42:20.41,Default,,0,0,0,,Люсияның соңынан ерген болса, менің жауым тек мен емес еді...
Dialogue: 0,0:42:20.53,0:42:22.99,Default,,0,0,0,,Бұл Люсияның да қызығушылық танытқанын білдіреді.
Dialogue: 0,0:42:23.12,0:42:28.00,Default,,0,0,0,,Кім бақыланады? Әлде Люсияның өзі гуру ма?
Dialogue: 0,0:42:28.92,0:42:30.54,Default,,0,0,0,,Ол Кафканың әпкесі ме?
Dialogue: 0,0:42:30.88,0:42:32.00,Default,,0,0,0,,Иә
Dialogue: 0,0:42:32.13,0:42:34.55,Default,,0,0,0,,Олардың барлығы бір уақытта қайтыс болды.
Dialogue: 0,0:42:35.13,0:42:36.42,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:42:36.55,0:42:39.05,Default,,0,0,0,,Иә, Освенцим.
Dialogue: 0,0:42:39.76,0:42:41.93,Default,,0,0,0,,Олардың барлығы Холокостта қайтыс болды.
Dialogue: 0,0:42:42.05,0:42:45.47,Default,,0,0,0,,Неміске тұрмысқа шыққан үшінші әпкем Отто да...
Dialogue: 0,0:42:45.60,0:42:49.40,Default,,0,0,0,,Күйеуімен ажырасып, өзі геттоға барды.
Dialogue: 0,0:42:49.69,0:42:53.57,Default,,0,0,0,,Егер ол арий әйелі болса, оны еврей деп танудан босатылар еді.
Dialogue: 0,0:42:54.40,0:42:55.94,Default,,0,0,0,,Сіз көп нәрсені білесіз.
Dialogue: 0,0:42:56.19,0:42:58.15,Default,,0,0,0,,Өйткені бұл туралы Джон маған жиі айтатын.
Dialogue: 0,0:42:58.28,0:43:01.32,Default,,0,0,0,,Джон... Менің ойымша, бұл сіз бұрын кездескен жігіт.
Dialogue: 0,0:43:02.07,0:43:05.33,Default,,0,0,0,,Джон Холокост туралы жиі айтатын.
Dialogue: 0,0:43:05.74,0:43:09.04,Default,,0,0,0,,Оны геноцид тарихы қызықтыратын сияқты.
Dialogue: 0,0:43:09.16,0:43:12.84,Default,,0,0,0,,Сталиннің әңгімесі Камбоджа Судан және Руанда
Dialogue: 0,0:43:14.55,0:43:16.34,Default,,0,0,0,,Геноцидтің тарихы?
Dialogue: 0,0:43:17.76,0:43:21.05,Default,,0,0,0,,Геноцидтің ерекше иісі бар дейді.
Dialogue: 0,0:43:21.43,0:43:22.60,Default,,0,0,0,,Иіс?
Dialogue: 0,0:43:22.72,0:43:25.06,Default,,0,0,0,,Холокост пен Катын орманында —
Dialogue: 0,0:43:25.18,0:43:27.35,Default,,0,0,0,,Бәріне жабысып қалды.
Dialogue: 0,0:43:28.81,0:43:30.69,Default,,0,0,0,,Осылайша Джон —
Dialogue: 0,0:43:30.81,0:43:33.31,Default,,0,0,0,,Өйткені ол қандай зерттеумен айналысты...
Dialogue: 0,0:43:33.44,0:43:36.98,Default,,0,0,0,,Иә, сіз ешкімге айтпаған шығарсыз.
Dialogue: 0,0:43:37.44,0:43:39.86,Default,,0,0,0,,Ол зерттеуді өз бетімен жүргізген сияқты.
Dialogue: 0,0:43:40.78,0:43:42.82,Default,,0,0,0,,Менің әйелім де білген жоқ деп ойлаймын.
Dialogue: 0,0:43:42.95,0:43:46.87,Default,,0,0,0,,Не, «әйелі»... сонда сен...
Dialogue: 0,0:43:47.16,0:43:49.62,Default,,0,0,0,,Мен сенің балаң бар екенін білдім.
Dialogue: 0,0:43:50.83,0:43:52.79,Default,,0,0,0,,Мен ең нашар әйелмін
Dialogue: 0,0:43:52.92,0:43:56.21,Default,,0,0,0,,Мм... Келгенім үшін кешіріңіз.
Dialogue: 0,0:43:56.34,0:43:59.88,Default,,0,0,0,,Жарайды, егер мені кешіремін деп ойласаңыз...
Dialogue: 0,0:44:00.01,0:44:02.34,Default,,0,0,0,,Мен сені тағы бір жерде кездестіре аламын ба?
Dialogue: 0,0:44:02.68,0:44:03.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:06.43,0:44:12.44,Default,,0,0,0,,(Музыка және адамдардың шуы)
Dialogue: 0,0:44:15.36,0:44:17.27,Default,,0,0,0,,Kya (ер тұтынушы)
Dialogue: 0,0:44:17.78,0:44:19.61,Default,,0,0,0,,Хе хахаха...
Dialogue: 0,0:44:26.20,0:44:27.49,Default,,0,0,0,,Будвейзель туралы не деуге болады?
Dialogue: 0,0:44:27.62,0:44:31.12,Default,,0,0,0,,Будвайзер... Америкада үнемі ішемін.
Dialogue: 0,0:44:31.37,0:44:34.54,Default,,0,0,0,,Буш, мен оны жаман деп айтпаймын, бірақ...
Dialogue: 0,0:44:34.67,0:44:36.25,Default,,0,0,0,,Нағыз нәрсені ішу керек
Dialogue: 0,0:44:38.59,0:44:39.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:41.84,0:44:43.38,Default,,0,0,0,,Банкноттар? Бұл дұрыс
Dialogue: 0,0:44:43.51,0:44:45.97,Default,,0,0,0,,Төлем қазір аутентификация болып табылады.
Dialogue: 0,0:44:46.10,0:44:47.35,Default,,0,0,0,,Сонымен, бұл қара валюта ма?
Dialogue: 0,0:44:47.47,0:44:52.02,Default,,0,0,0,,Бұл күлкілі. Бұл үкімет те, еуро да мойындайтын жергілікті валюта.
Dialogue: 0,0:44:52.31,0:44:55.23,Default,,0,0,0,,Мен қауымдастықтың валюталық әрекеті жойылды деп ойладым.
Dialogue: 0,0:44:55.35,0:44:58.77,Default,,0,0,0,,Иә, бұрын бұл қауымдастықты қалпына келтіру сияқты болатын.
Dialogue: 0,0:44:58.90,0:45:01.94,Default,,0,0,0,,Себебі мен солақай ойлауға тым көп сендім.
Dialogue: 0,0:45:02.07,0:45:06.03,Default,,0,0,0,,Бірақ бұл қауымдастықтан гөрі панк қозғалысы.
Dialogue: 0,0:45:06.57,0:45:08.16,Default,,0,0,0,,Панк қозғалысы?
Dialogue: 0,0:45:08.49,0:45:13.16,Default,,0,0,0,,Бір жерде адамдар ақпараттық қоғамды теңестіргісі келеді.
Dialogue: 0,0:45:13.54,0:45:14.62,Default,,0,0,0,,Сәлем Люсия
Dialogue: 0,0:45:14.75,0:45:16.04,Default,,0,0,0,,Чао Люсис!
Dialogue: 0,0:45:16.17,0:45:18.96,Default,,0,0,0,,Ах... хахаха...
Dialogue: 0,0:45:19.50,0:45:24.38,Default,,0,0,0,,Люсис - бұл дүкеннің иесі, ол өте ақылды және ойлы адам.
Dialogue: 0,0:45:24.51,0:45:26.34,Default,,0,0,0,,Бұл Чарльз Бишоп.
Dialogue: 0,0:45:26.47,0:45:28.68,Default,,0,0,0,,Америкадан осы филиалға ауыстырылған адам
Dialogue: 0,0:45:28.97,0:45:31.31,Default,,0,0,0,,Бұл епископ. Жақсы дүкен екен.
Dialogue: 0,0:45:31.43,0:45:32.81,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:45:32.93,0:45:35.73,Default,,0,0,0,,Біраз уақыт болды, солай емес пе? Лузия.
Dialogue: 0,0:45:35.85,0:45:37.52,Default,,0,0,0,,Барлығы жалғыздықта болды.
Dialogue: 0,0:45:37.65,0:45:39.90,Default,,0,0,0,,Тайрон сені сағынды
Dialogue: 0,0:45:40.02,0:45:41.86,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:45:45.07,0:45:47.28,Default,,0,0,0,,Люсия дегеніміз не?
Dialogue: 0,0:45:47.87,0:45:48.70,Default,,0,0,0,,А...
Dialogue: 0,0:45:50.66,0:45:53.50,Default,,0,0,0,,Мен студентпін. Маған чех тілін үйретеді.
Dialogue: 0,0:45:53.62,0:45:58.38,Default,,0,0,0,,Люсия өзімен бірге студентті алғаш рет алып келді. Хахаха...
Dialogue: 0,0:45:58.50,0:45:59.33,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:46:00.71,0:46:02.21,Default,,0,0,0,,Сіз таң қалдыңыз.
Dialogue: 0,0:46:02.34,0:46:05.09,Default,,0,0,0,,Чексіз кіру, ұлттық валюта және т.б.
Dialogue: 0,0:46:05.34,0:46:08.80,Default,,0,0,0,,Шынымды айтсам, мен таң қалдым, өйткені Америкада бұл мүмкін емес.
Dialogue: 0,0:46:08.93,0:46:12.10,Default,,0,0,0,,Американы бір кездері азаттардың елі деп атаған, бірақ...
Dialogue: 0,0:46:12.22,0:46:14.48,Default,,0,0,0,,Қазір кейбір Еуропа елдері...
Dialogue: 0,0:46:14.60,0:46:16.60,Default,,0,0,0,,Бұл аздап тегін сияқты.
Dialogue: 0,0:46:16.73,0:46:20.40,Default,,0,0,0,,Сараеводан ұтылғаннан кейін де мұндай жерлер қалғаны рас.
Dialogue: 0,0:46:20.52,0:46:23.36,Default,,0,0,0,,Мен Еуропаның толеранттылығының кеңдігіне тәнтімін...
Dialogue: 0,0:46:23.48,0:46:25.61,Default,,0,0,0,,Бұл еркін таңдау мәселесі.
Dialogue: 0,0:46:26.03,0:46:27.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:28.66,0:46:31.53,Default,,0,0,0,,Еңбек жеке адамды бостандығынан айырса да...
Dialogue: 0,0:46:31.66,0:46:36.62,Default,,0,0,0,,Сіз алған жалақыңызға әртүрлі өнімдерді сатып ала аласыз.
Dialogue: 0,0:46:37.25,0:46:40.63,Default,,0,0,0,,Белгілі бір бостандықтардан бас тарту және белгілі бір бостандықтарға ие болу
Dialogue: 0,0:46:40.75,0:46:43.96,Default,,0,0,0,,Америка өзінің жеке өміріне қол сұғылмаушылықтың кейбір бостандығынан бас тартты...
Dialogue: 0,0:46:44.09,0:46:47.72,Default,,0,0,0,,Терроризм қорқынышының қысымынан құтылу?
Dialogue: 0,0:46:47.84,0:46:50.76,Default,,0,0,0,,Хмм... Менің ойымша, сіз мұны айта аласыз.
Dialogue: 0,0:46:50.89,0:46:54.10,Default,,0,0,0,,Сіздің ел мен осы Еуропа арасындағы тепе-теңдік...
Dialogue: 0,0:46:54.22,0:46:56.39,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:46:57.43,0:47:00.48,Default,,0,0,0,,Сіз бұл дүкенді еркіндігіңізді қорғау үшін басқарасыз ба?
Dialogue: 0,0:47:00.60,0:47:03.19,Default,,0,0,0,,Бұл тым асыра айтылған емес.
Dialogue: 0,0:47:03.32,0:47:06.36,Default,,0,0,0,,Дегенмен, еркіндік - осындай әртүрлі таңдау жасау еркіндігі.
Dialogue: 0,0:47:06.49,0:47:11.16,Default,,0,0,0,,Олардың бұл мәміле екенін түсінуге мәжбүрлеу қиын.
Dialogue: 0,0:47:11.57,0:47:15.24,Default,,0,0,0,,Жастар абсолютті және таза еркіндік бар деп санайды.
Dialogue: 0,0:47:15.37,0:47:16.87,Default,,0,0,0,,Сену
Dialogue: 0,0:47:17.00,0:47:21.67,Default,,0,0,0,,Олар бұл жалған еркіндікке ие болу керек.
Dialogue: 0,0:47:22.50,0:47:26.17,Default,,0,0,0,,Ересек адам ретінде таңдау еркіндігі - еркіндіктің жоғары деңгейі.
Dialogue: 0,0:47:26.67,0:47:29.42,Default,,0,0,0,,Оны шынайы сезіну үшін.
Dialogue: 0,0:47:29.72,0:47:32.18,Default,,0,0,0,,Сіз білімді адамсыз.
Dialogue: 0,0:47:32.47,0:47:35.31,Default,,0,0,0,,Мен ағартушы атанғанды ​​жөн көремін.
Dialogue: 0,0:47:35.43,0:47:37.02,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:47:37.14,0:47:39.06,Default,,0,0,0,,Еркіндік – валюта дейді.
Dialogue: 0,0:47:39.18,0:47:40.02,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:47:40.14,0:47:44.15,Default,,0,0,0,,Бұлай сөйлейтіндер көп емес.
Dialogue: 0,0:47:44.27,0:47:46.11,Default,,0,0,0,,Бүгінгі күн өте қызықты өтті
Dialogue: 0,0:47:46.23,0:47:47.99,Default,,0,0,0,,Қарсы болмасаңыз, маған қайта хабарласыңыз.
Dialogue: 0,0:47:48.11,0:47:49.28,Default,,0,0,0,,епископ мырза
Dialogue: 0,0:47:49.40,0:47:51.36,Default,,0,0,0,,Иә, бәрібір.
Dialogue: 0,0:47:52.20,0:47:53.20,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:47:53.82,0:47:58.20,Default,,0,0,0,,Қазіргі заманда мұндай дүкеннің жұмысын жалғастыру қиын болуы керек.
Dialogue: 0,0:47:58.33,0:48:00.00,Default,,0,0,0,,Иә, бірақ—
Dialogue: 0,0:48:00.12,0:48:03.58,Default,,0,0,0,,Аутентификация қазіргідей әбігерге түспеген уақыттарды білетін адамдар.
Dialogue: 0,0:48:03.71,0:48:06.71,Default,,0,0,0,,Қазіргі жастарға осындай орын керек...
Dialogue: 0,0:48:06.84,0:48:09.97,Default,,0,0,0,,Мұндай кеңістік бір жерде туылуы керек.
Dialogue: 0,0:48:10.51,0:48:13.22,Default,,0,0,0,,Сіз де осындай еркіндікті іздеп жүрсіз бе?
Dialogue: 0,0:48:13.89,0:48:18.18,Default,,0,0,0,,Менің жағдайымда маған аздап дем алу керек.
Dialogue: 0,0:48:19.68,0:48:22.44,Default,,0,0,0,,Не іштің? Кіммен биледің?
Dialogue: 0,0:48:22.56,0:48:24.77,Default,,0,0,0,,Бұл туралы ешкім білмей-ақ...
Dialogue: 0,0:48:24.90,0:48:28.61,Default,,0,0,0,,Кейде сізге жай ғана демалатын орын қажет.
Dialogue: 0,0:48:33.82,0:48:36.58,Default,,0,0,0,,А... бұл жерден кетейік.
Dialogue: 0,0:48:36.70,0:48:39.62,Default,,0,0,0,,Не? Әлі емес... аа...
Dialogue: 0,0:48:45.21,0:48:49.76,Default,,0,0,0,,Мен онымен ұйықтап жатқанымда Сараево жоғалып кетті.
Dialogue: 0,0:48:54.80,0:48:57.10,Default,,0,0,0,,Джонның әйелі мен қызы —
Dialogue: 0,0:48:57.22,0:49:00.14,Default,,0,0,0,,Мен Сараеводағы әпкемнің үйінде болдым.
Dialogue: 0,0:49:00.47,0:49:06.56,Default,,0,0,0,,Бізсіз Бостон қаласы өте көңілді және бақытты болды
Dialogue: 0,0:49:12.86,0:49:14.20,Default,,0,0,0,,Бақылау есебі
Dialogue: 0,0:49:14.32,0:49:18.83,Default,,0,0,0,,Ядролық болып көрінетін бұл жарылыстың эпицентрі біз хабарлағандай —
Dialogue: 0,0:49:18.95,0:49:21.87,Default,,0,0,0,,Ол ескі Сараево қаласының маңында деп саналады.
Dialogue: 0,0:49:22.16,0:49:24.37,Default,,0,0,0,,Жергілікті Америка елшілігімен де байланыс үзілді...
Dialogue: 0,0:49:30.34,0:49:33.05,Default,,0,0,0,,Ол кісі Сараевоға ұшып кетті.
Dialogue: 0,0:49:33.92,0:49:37.59,Default,,0,0,0,,Ең сорақысы, осының бәрінен кейін де мен
Dialogue: 0,0:49:37.72,0:49:39.89,Default,,0,0,0,,Мен ол адамды жақсы көрдім.
Dialogue: 0,0:49:41.89,0:49:45.44,Default,,0,0,0,,Бірақ ол Сараеводан жасырын оралды және...
Dialogue: 0,0:49:45.56,0:49:49.11,Default,,0,0,0,,Мен университетті тастап, басқа жерге кеттім.
Dialogue: 0,0:49:50.11,0:49:52.82,Default,,0,0,0,,Мен ол адамды таба алмадым
Dialogue: 0,0:49:53.03,0:49:57.41,Default,,0,0,0,,Өйткені ол кісінің бар болуы менің күнәмнің өзі еді.
Dialogue: 0,0:49:58.32,0:50:02.41,Default,,0,0,0,,Мен енді күнәларымды өтей алмаймын.
Dialogue: 0,0:50:04.20,0:50:08.54,Default,,0,0,0,,Өйткені өлген адамды ешкім кешіре алмайды.
Dialogue: 0,0:50:12.96,0:50:15.17,Default,,0,0,0,,Сіз оны танисыз, солай ма?
Dialogue: 0,0:50:15.42,0:50:16.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:16.93,0:50:19.22,Default,,0,0,0,,Ол маған 5 жылдан кейін бірінші рет келді.
Dialogue: 0,0:50:19.34,0:50:21.64,Default,,0,0,0,,Сосын сен көріндің
Dialogue: 0,0:50:22.43,0:50:26.23,Default,,0,0,0,,Ол не істеді? Сен не қуып жүрсің?
Dialogue: 0,0:50:26.35,0:50:27.19,Default,,0,0,0,,Люсия…
Dialogue: 0,0:50:27.44,0:50:29.94,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін, бірақ...
Dialogue: 0,0:50:30.06,0:50:33.19,Default,,0,0,0,,Мен оның өзі айтқан жаман жігіт екеніне сене алар емеспін!
Dialogue: 0,0:50:33.48,0:50:36.19,Default,,0,0,0,,Сіз... Джон мен Гурусыз ба!?
Dialogue: 0,0:50:37.11,0:50:40.74,Default,,0,0,0,,Бұл оңай емес. Менің онымен қарым-қатынасым...
Dialogue: 0,0:50:40.87,0:50:41.70,Default,,0,0,0,,Сен…
Dialogue: 0,0:50:42.66,0:50:43.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:50:48.92,0:50:51.59,Default,,0,0,0,,Ха... жолдастар!?
Dialogue: 0,0:50:51.88,0:50:54.09,Default,,0,0,0,,Жоқ, мен сенің достарың туралы білмеймін...
Dialogue: 0,0:51:06.93,0:51:08.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:12.94,0:51:14.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:51:15.15,0:51:16.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:31.54,0:51:32.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:39.51,0:51:40.84,Default,,0,0,0,,Күте тұрыңыз... бұл тез.
Dialogue: 0,0:52:04.03,0:52:05.41,Default,,0,0,0,,Уау... (Клавис) Әй!
Dialogue: 0,0:52:05.83,0:52:06.62,Default,,0,0,0,,Хмф! (Ер) Жоғары!
Dialogue: 0,0:52:06.74,0:52:08.04,Default,,0,0,0,,бұл... Ах!
Dialogue: 0,0:52:09.12,0:52:13.58,Default,,0,0,0,,Ах... саусақ ізінің аутентификациясы туралы не деуге болады? Бұл әлі барлау мекемесі ме?
Dialogue: 0,0:52:20.09,0:52:23.84,Default,,0,0,0,,Уф! Ах... уф... а...
Dialogue: 0,0:52:23.97,0:52:25.89,Default,,0,0,0,,Мистер епископ!?
Dialogue: 0,0:52:26.51,0:52:29.35,Default,,0,0,0,,Чарльз! Эй, не болды!?
Dialogue: 0,0:52:29.47,0:52:32.10,Default,,0,0,0,,А... а...
Dialogue: 0,0:52:32.23,0:52:36.11,Default,,0,0,0,,Кешіріңіз... Мен мұндай жағдай болады деп күтпедім...
Dialogue: 0,0:52:36.23,0:52:37.61,Default,,0,0,0,,Қаш!
Dialogue: 0,0:52:37.73,0:52:40.90,Default,,0,0,0,,Маған оны дүкенге әкелу керек еді...
Dialogue: 0,0:52:43.49,0:52:44.99,Default,,0,0,0,,Хехе...
Dialogue: 0,0:52:45.87,0:52:48.49,Default,,0,0,0,,Қаш... Лузия...
Dialogue: 0,0:52:48.62,0:52:51.00,Default,,0,0,0,,Қашудың қажеті жоқ, Лузия.
Dialogue: 0,0:52:51.12,0:52:52.08,Default,,0,0,0,,А...
Dialogue: 0,0:52:52.37,0:52:54.96,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:52:59.96,0:53:02.30,Default,,0,0,0,,Ах... у... а...
Dialogue: 0,0:53:16.19,0:53:19.65,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:53:20.23,0:53:21.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:53:25.36,0:53:27.07,Default,,0,0,0,,Хмм... у...
Dialogue: 0,0:53:27.82,0:53:31.58,Default,,0,0,0,,Бұл Америка үкіметінің қастандық жасағы сияқты ма?
Dialogue: 0,0:53:33.41,0:53:34.83,Default,,0,0,0,,Джон Пол
Dialogue: 0,0:53:36.50,0:53:38.34,Default,,0,0,0,,«Қырғын патшасы»
Dialogue: 0,0:53:38.59,0:53:40.30,Default,,0,0,0,,Неліктен оны солдат деп ойладың?
Dialogue: 0,0:53:40.42,0:53:42.84,Default,,0,0,0,,Сарбаздардың жүру тәсілі ерекше.
Dialogue: 0,0:53:43.26,0:53:46.09,Default,,0,0,0,,Әртүрлі элементтерде жасырылған үлгілерді табу...
Dialogue: 0,0:53:46.22,0:53:48.09,Default,,0,0,0,,Өйткені бұл менің зерттеуім болатын.
Dialogue: 0,0:53:48.39,0:53:52.22,Default,,0,0,0,,Сіз Пентагонның қаржыландыруымен тіл зерттеуін жүргіздіңіз.
Dialogue: 0,0:53:52.35,0:53:53.68,Default,,0,0,0,,Тек сөздерді зерттеу...
Dialogue: 0,0:53:53.81,0:53:56.81,Default,,0,0,0,,Неліктен ол қорғаныс құпиясы ретінде белгіленуі керек?
Dialogue: 0,0:53:56.94,0:53:59.23,Default,,0,0,0,,Саған сабақ болған жоқ па?
Dialogue: 0,0:54:00.40,0:54:04.11,Default,,0,0,0,,Сіз өзіңізге мұндай құлдыққа жол бересіз.
Dialogue: 0,0:54:06.07,0:54:10.03,Default,,0,0,0,,Алдымен бұл тек академиялық зерттеу болды.
Dialogue: 0,0:54:10.16,0:54:14.25,Default,,0,0,0,,Фашистік Германияның радиохабарларының ресми құжаттары Фашистік режим кезінде —
Dialogue: 0,0:54:14.37,0:54:18.88,Default,,0,0,0,,Мәтіндік мәліметтердің барлық түрін алып, грамматикалық талдауға түсірді
Dialogue: 0,0:54:19.00,0:54:21.42,Default,,0,0,0,,Зерттеу нәтижелерін қағазда жариялағанда—
Dialogue: 0,0:54:21.54,0:54:24.13,Default,,0,0,0,,Пентагоннан көмек көрсету туралы ұсыныс түсті.
Dialogue: 0,0:54:24.38,0:54:26.38,Default,,0,0,0,,ЦРУ-ның құпия құжаттары мен...
Dialogue: 0,0:54:26.51,0:54:29.47,Default,,0,0,0,,NSA ұстаған шетелдегі трафик жазбалары -
Dialogue: 0,0:54:29.59,0:54:31.89,Default,,0,0,0,,Енді сіз бәрін көре аласыз
Dialogue: 0,0:54:32.14,0:54:34.60,Default,,0,0,0,,Ол жерден не таптың?
Dialogue: 0,0:54:34.72,0:54:37.89,Default,,0,0,0,,Геноцидтің грамматикасы бар.
Dialogue: 0,0:54:40.23,0:54:44.53,Default,,0,0,0,,Қанды қырғынға аз уақыт қалғанда өрнек жыпылықтай бастайды.
Dialogue: 0,0:54:44.65,0:54:48.70,Default,,0,0,0,,Өйткені ол тілдік ерекшеліктерге тәуелді емес туа біткен терең грамматика.
Dialogue: 0,0:54:48.82,0:54:52.95,Default,,0,0,0,,Сөзден ләззат алатындар оны өзіңіз көре алмайсыз.
Dialogue: 0,0:54:53.08,0:54:55.66,Default,,0,0,0,,Туа біткен грамматика?
Dialogue: 0,0:54:58.21,0:54:59.62,Default,,0,0,0,,Органдар…
Dialogue: 0,0:55:01.21,0:55:06.09,Default,,0,0,0,,Жол қозғалысын талдай отырып, зұлымдықтардың орын алуын болжауға болады
Dialogue: 0,0:55:06.21,0:55:08.47,Default,,0,0,0,,Пентагон осылай ойлады ма?
Dialogue: 0,0:55:10.30,0:55:15.35,Default,,0,0,0,,Мен сөздің ішінде жасырылған зорлық белгілерін көре бастадым.
Dialogue: 0,0:55:17.14,0:55:21.15,Default,,0,0,0,,Осы грамматика арқылы сөздерді ұзақ уақыт тыңдайтын адам миы...
Dialogue: 0,0:55:21.27,0:55:23.36,Default,,0,0,0,,Белгілі бір өзгерістер орын алады.
Dialogue: 0,0:55:24.90,0:55:28.07,Default,,0,0,0,,Белгілі бір құндылықтарды пайымдауға қатысатын мидың функционалдық бөліктерінің қызметі...
Dialogue: 0,0:55:28.19,0:55:29.86,Default,,0,0,0,,Ол басылады.
Dialogue: 0,0:55:30.20,0:55:32.41,Default,,0,0,0,,Міне, «ар-ұждан» —
Dialogue: 0,0:55:32.53,0:55:34.08,Default,,0,0,0,,Ориентацияны бұрмалау
Dialogue: 0,0:55:34.20,0:55:35.29,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:55:35.41,0:55:37.79,Default,,0,0,0,,белгілі бір тенденцияға қарай
Dialogue: 0,0:55:38.46,0:55:39.29,Default,,0,0,0,,Фу…
Dialogue: 0,0:55:39.41,0:55:42.13,Default,,0,0,0,,Сөз осындай санасыз сананы тудыруы мүмкін...
Dialogue: 0,0:55:42.25,0:55:44.71,Default,,0,0,0,,Сапир-Уорф өтірікші болуы керек.
Dialogue: 0,0:55:44.84,0:55:47.76,Default,,0,0,0,,Ойды сөзбен анықтамайды!
Dialogue: 0,0:55:47.88,0:55:49.80,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:55:49.92,0:55:51.18,Default,,0,0,0,,Не болды!?
Dialogue: 0,0:55:51.43,0:55:55.68,Default,,0,0,0,,Жоқ, жоқ, мен оны тілдерді жақсы білетін тыңшы деп ойладым.
Dialogue: 0,0:55:56.85,0:55:58.85,Default,,0,0,0,,Люсиядан естіген
Dialogue: 0,0:56:02.31,0:56:04.19,Default,,0,0,0,,Сіз осылай ойладыңыз ба?
Dialogue: 0,0:56:04.65,0:56:07.19,Default,,0,0,0,,«Сөздің мағынасы жоқ»
Dialogue: 0,0:56:07.61,0:56:08.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:08.57,0:56:10.20,Default,,0,0,0,,Гете былай деп жазды:
Dialogue: 0,0:56:10.65,0:56:13.32,Default,,0,0,0,,«Әскери музыка ашық жұдырықтай...»
Dialogue: 0,0:56:13.45,0:56:15.78,Default,,0,0,0,,«Арқамды соз»
Dialogue: 0,0:56:15.91,0:56:17.95,Default,,0,0,0,,Музыка сананы зорлайды
Dialogue: 0,0:56:18.41,0:56:19.54,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:56:19.66,0:56:22.96,Default,,0,0,0,,Үстіне түзелетін пайдасыз ақсүйек сияқты.
Dialogue: 0,0:56:23.79,0:56:26.96,Default,,0,0,0,,Дыбыс мағынаны айналып өтуі мүмкін
Dialogue: 0,0:56:28.25,0:56:31.93,Default,,0,0,0,,Бізде сана да, түсінік те жоқ.
Dialogue: 0,0:56:32.05,0:56:34.84,Default,,0,0,0,,Қарғыс тәрізді қабат болса ше?
Dialogue: 0,0:56:39.31,0:56:41.23,Default,,0,0,0,,Бір нәрсені дәлелдеп көрейік.
Dialogue: 0,0:56:41.52,0:56:45.40,Default,,0,0,0,,Мен сізбен әңгімеме грамматиканы жасырып қойдым.
Dialogue: 0,0:56:45.52,0:56:47.65,Default,,0,0,0,,Уф... уайымдаудың қажеті жоқ.
Dialogue: 0,0:56:47.77,0:56:49.98,Default,,0,0,0,,Бұл геноцидке себепші болғаннан басқа.
Dialogue: 0,0:56:50.11,0:56:51.61,Default,,0,0,0,,Маған не істедің!?
Dialogue: 0,0:56:51.90,0:56:54.86,Default,,0,0,0,,Эволюция қажеттілігіне байланысты мида қалған кейбір функциялар—
Dialogue: 0,0:56:54.99,0:56:57.12,Default,,0,0,0,,Себебі мен оны тек ынталандырдым...
Dialogue: 0,0:56:58.41,0:57:02.12,Default,,0,0,0,,Біреу құлақтың қабағы жоқ деді.
Dialogue: 0,0:57:02.83,0:57:05.29,Default,,0,0,0,,Менің сөздеріме не кедергі
Dialogue: 0,0:57:05.54,0:57:07.92,Default,,0,0,0,,Мұны ешкім жасай алмайды
Dialogue: 0,0:57:08.04,0:57:09.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:57:12.05,0:57:12.88,Default,,0,0,0,,Га
Dialogue: 0,0:57:14.88,0:57:15.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:23.98,0:57:24.98,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:57:29.98,0:57:31.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:57:33.90,0:57:34.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:40.83,0:57:41.83,Default,,0,0,0,,Га
Dialogue: 0,0:57:42.91,0:57:44.91,Default,,0,0,0,,Уау! Арх... аа!
Dialogue: 0,0:57:47.46,0:57:49.42,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:57:52.01,0:57:52.80,Default,,0,0,0,,Жетеді
Dialogue: 0,0:57:53.30,0:57:54.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:56.63,0:57:58.72,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:57:58.85,0:58:00.01,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:58:00.14,0:58:03.64,Default,,0,0,0,,Бұл нервтерді қоздыратын наномашина.
Dialogue: 0,0:58:03.77,0:58:04.64,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:58:04.77,0:58:07.44,Default,,0,0,0,,Мен оны бұрынғы Будвейзельмен араластырдым.
Dialogue: 0,0:58:07.69,0:58:09.27,Default,,0,0,0,,Люсис...
Dialogue: 0,0:58:09.52,0:58:10.90,Default,,0,0,0,,Люсияға не болды!?
Dialogue: 0,0:58:11.02,0:58:12.69,Default,,0,0,0,,Мен Джонмен біргемін.
Dialogue: 0,0:58:12.82,0:58:14.78,Default,,0,0,0,,Бейшара сен, көріндің...
Dialogue: 0,0:58:14.90,0:58:17.70,Default,,0,0,0,,Ол енді мұнда қала алмайды.
Dialogue: 0,0:58:17.99,0:58:20.74,Default,,0,0,0,,Мен оның Джон Полдың серіктесі болғанын білмеймін.
Dialogue: 0,0:58:21.78,0:58:24.20,Default,,0,0,0,,Джон біздің клиентіміз
Dialogue: 0,0:58:24.70,0:58:28.42,Default,,0,0,0,,Біз өзімізді қорғау үшін ынтымақтастықта болдық.
Dialogue: 0,0:58:28.54,0:58:29.88,Default,,0,0,0,,«Біз»?
Dialogue: 0,0:58:30.21,0:58:34.42,Default,,0,0,0,,Хмм... Біз «саналмайтынбыз».
Dialogue: 0,0:58:34.55,0:58:36.63,Default,,0,0,0,,«Есептелмеген»?
Dialogue: 0,0:58:36.76,0:58:39.34,Default,,0,0,0,,Өте төмен технологиялы әдіс бар
Dialogue: 0,0:58:40.05,0:58:44.14,Default,,0,0,0,,Құм сияқты көп сенсорлар бар, бірақ олардың көпшілігінің бір ғана қызметі бар.
Dialogue: 0,0:58:44.27,0:58:47.35,Default,,0,0,0,,Тек көз торы, тек тамырлар, саусақ іздері ғана
Dialogue: 0,0:58:47.77,0:58:50.52,Default,,0,0,0,,Мұнда ми толқындары, мұнда бақылау камералары —
Dialogue: 0,0:58:50.65,0:58:53.57,Default,,0,0,0,,Егер сіз әрбір сенсорды бір-бірден осылайша картаға түсірсеңіз...
Dialogue: 0,0:58:53.69,0:58:56.82,Default,,0,0,0,,Сіз жүруге салыстырмалы түрде оңай жолды табасыз.
Dialogue: 0,0:58:56.95,0:58:59.32,Default,,0,0,0,,Наноқабат саусақ іздері бар және—
Dialogue: 0,0:58:59.45,0:59:01.91,Default,,0,0,0,,Егер сізде басқа адамның басып шығарылған тор қабығы болса—
Dialogue: 0,0:59:02.03,0:59:04.87,Default,,0,0,0,,Аяқ ізімен жүру мүмкін болмай қалады.
Dialogue: 0,0:59:06.37,0:59:07.87,Default,,0,0,0,,Сараево!
Dialogue: 0,0:59:08.16,0:59:10.58,Default,,0,0,0,,Біз оны тірі идентификаторға айналдырдық
Dialogue: 0,0:59:10.71,0:59:12.63,Default,,0,0,0,,Бостандық мәміле мәселесі деп кім айтты?
Dialogue: 0,0:59:12.75,0:59:13.96,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:59:14.09,0:59:17.63,Default,,0,0,0,,Дегенмен, қазіргі жағдай өте теңгерімсіз.
Dialogue: 0,0:59:19.59,0:59:20.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:59:22.22,0:59:24.56,Default,,0,0,0,,Біз ұсынатын құпиялылық және-
Dialogue: 0,0:59:24.68,0:59:28.14,Default,,0,0,0,,Қауіпті қамтамасыз ету мүлдем пропорционалды емес.
Dialogue: 0,0:59:29.77,0:59:31.10,Default,,0,0,0,,11 қыркүйектен кейін—
Dialogue: 0,0:59:31.23,0:59:34.86,Default,,0,0,0,,Әлем жеке ақпаратты басқару арқылы қауіпсіздікті арттырды
Dialogue: 0,0:59:34.98,0:59:36.32,Default,,0,0,0,,Бірақ қауіпсіздік осылай...
Dialogue: 0,0:59:36.44,0:59:39.40,Default,,0,0,0,,Ол жоғарылаған сайын лаңкестік күшейеді.
Dialogue: 0,0:59:39.53,0:59:40.41,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:59:40.53,0:59:43.66,Default,,0,0,0,,Мұны ресми статистикалық графиктерде растауға болады.
Dialogue: 0,0:59:43.91,0:59:47.83,Default,,0,0,0,,Үкімет өтірік айтады, ал БАҚ соған ілеседі.
Dialogue: 0,0:59:48.16,0:59:51.92,Default,,0,0,0,,Дүние жүзіне хабарланбайтын қайғылы оқиғалар көп.
Dialogue: 0,0:59:52.04,0:59:54.67,Default,,0,0,0,,Мысалы...
Dialogue: 0,0:59:54.92,0:59:56.67,Default,,0,0,0,,Сол жасанды бұлшықет
Dialogue: 0,0:59:58.21,1:00:02.01,Default,,0,0,0,,Бұл кит пен дельфиннің гендік инженериясы.
Dialogue: 0,1:00:02.14,1:00:03.39,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:04.14,1:00:07.72,Default,,0,0,0,,Олар Виктория көлінде егіншілікпен айналысып, сойылған.
Dialogue: 0,1:00:07.85,1:00:11.31,Default,,0,0,0,,Тек сол бұлшықет талшықтары өнеркәсіптік пайдалану үшін жіберіледі.
Dialogue: 0,1:00:11.44,1:00:16.19,Default,,0,0,0,,Өте төмен жалақыға жұмыс істеуге мәжбүрлеген ұлдар мен қыздар.
Dialogue: 0,1:00:17.15,1:00:18.82,Default,,0,0,0,,Егер сізде жаңбыр тамшысындай қызығушылық болса,—
Dialogue: 0,1:00:18.94,1:00:21.32,Default,,0,0,0,,Біз заттарды қадағалай алатын қоғамда болуымыз керек...
Dialogue: 0,1:00:21.61,1:00:23.87,Default,,0,0,0,,Олардың өмірін қамтамасыз ететін заттар...
Dialogue: 0,1:00:23.99,1:00:26.62,Default,,0,0,0,,Олар қандай қорқынышты жағдайда өндіріледі?
Dialogue: 0,1:00:26.74,1:00:29.41,Default,,0,0,0,,Менің тіпті білгім де келмейді.
Dialogue: 0,1:00:30.12,1:00:32.08,Default,,0,0,0,,Сіз білетін боларсыз, солай ма?
Dialogue: 0,1:00:32.21,1:00:37.46,Default,,0,0,0,,Дүние жүзінде қанша қайғылы азаматтық соғыстар еленбейді?
Dialogue: 0,1:00:37.75,1:00:41.76,Default,,0,0,0,,Адамдарды оның аз ғана бөлігі қызықтырады.
Dialogue: 0,1:00:41.97,1:00:46.55,Default,,0,0,0,,Адамдар тек көргісі келетін нәрсені көруге арналған.
Dialogue: 0,1:01:02.70,1:01:05.57,Default,,0,0,0,,Ит іздеу! бұл!
Dialogue: 0,1:01:05.70,1:01:06.87,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:06.99,1:01:08.41,Default,,0,0,0,,Уф... аа!
Dialogue: 0,1:01:08.53,1:01:14.46,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:01:22.76,1:01:24.47,Default,,0,0,0,,Амансың ба? клавис
Dialogue: 0,1:01:25.18,1:01:27.14,Default,,0,0,0,,Лузияға не болды!? Ол...
Dialogue: 0,1:01:27.26,1:01:28.43,Default,,0,0,0,,(Уильямс күрсіну)
Dialogue: 0,1:01:28.55,1:01:31.47,Default,,0,0,0,,Білмеймін, бір жерде жоғалып кетті.
Dialogue: 0,1:01:34.31,1:01:35.98,Default,,0,0,0,,Хмм...
Dialogue: 0,1:01:45.95,1:01:48.41,Default,,0,0,0,,Табиғи түрде шығарылатын антинаномашиналар:
Dialogue: 0,1:01:48.53,1:01:51.70,Default,,0,0,0,,Ауырсыну құралдарын сәтті алып тастау
Dialogue: 0,1:01:52.08,1:01:53.66,Default,,0,0,0,,Қандағы наномашиналар —
Dialogue: 0,1:01:53.79,1:01:57.13,Default,,0,0,0,,Ол шамамен 3 күнде толығымен жойылады.
Dialogue: 0,1:01:57.25,1:02:00.25,Default,,0,0,0,,Мәселе мынада, бұл құрылғы тудыратын психикалық күйзеліс...
Dialogue: 0,1:02:00.38,1:02:02.05,Default,,0,0,0,,Ұрыс кезіндегі психологиялық жағдайыңыз туралы не айтасыз?
Dialogue: 0,1:02:02.05,1:02:03.55,Default,,0,0,0,,Ұрыс кезіндегі психологиялық жағдайыңыз туралы не айтасыз?
Dialogue: 0,1:02:02.05,1:02:03.55,Default,,0,0,0,,Күнә…
Dialogue: 0,1:02:03.67,1:02:05.26,Default,,0,0,0,,Хмм... аа
Dialogue: 0,1:02:14.02,1:02:16.69,Default,,0,0,0,,Аэроғарыш күштерінің барлау спутнигі —
Dialogue: 0,1:02:16.81,1:02:20.44,Default,,0,0,0,,Бұл төрт күн бұрын бұрынғы Үндістан-Пәкістан шекарасында түсірілген бейне.
Dialogue: 0,1:02:21.23,1:02:24.99,Default,,0,0,0,,Гаагадағы Прокуратура департаменті Үндістанның Жаңа үкіметінің шағымы бойынша,—
Dialogue: 0,1:02:25.11,1:02:26.45,Default,,0,0,0,,Үндістанның ішкі жағында жұмыс істеу —
Dialogue: 0,1:02:26.57,1:02:31.28,Default,,0,0,0,,Инд Фундаменталистер Альянсының сегіз көшбасшысын қамауға алуға ордер берілді
Dialogue: 0,1:02:31.41,1:02:35.50,Default,,0,0,0,,Қылмыс – адамзатқа қарсы қылмыс, балаларды ұрысқа жұмылдыру қылмысы.
Dialogue: 0,1:02:35.62,1:02:38.37,Default,,0,0,0,,Бұл геноцид қылмысы.
Dialogue: 0,1:02:39.42,1:02:40.67,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:02:42.46,1:02:44.30,Default,,0,0,0,,Ядролық түймені басқан генералдар —
Dialogue: 0,1:02:44.42,1:02:47.97,Default,,0,0,0,,Бұл менің соттан қашқан кездегі естелік.
Dialogue: 0,1:02:48.09,1:02:51.60,Default,,0,0,0,,Джон Павел олармен бірге болуы мүмкін.
Dialogue: 0,1:02:51.72,1:02:52.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:53.01,1:02:57.56,Default,,0,0,0,,Қазіргі уақытта Үндістанның жаңа үкіметінің әскери әрекеттерін Біріккен Ұлттар Ұйымы мақұлдады.
Dialogue: 0,1:02:57.69,1:03:00.69,Default,,0,0,0,,Ішінара Евгений мен Круппсқа сеніп тапсырылған
Dialogue: 0,1:03:02.57,1:03:04.61,Default,,0,0,0,,Егер олар Джон Павелді ұстап қалса,
Dialogue: 0,1:03:04.73,1:03:06.19,Default,,0,0,0,,Бұл оның нашар екенін білдіреді.
Dialogue: 0,1:03:07.15,1:03:08.45,Default,,0,0,0,,Хмм… біз…
Dialogue: 0,1:03:08.57,1:03:12.53,Default,,0,0,0,,Жапон үкіметінің далада әскери агенті ретінде операциялар жүргізу
Dialogue: 0,1:03:12.66,1:03:16.20,Default,,0,0,0,,Басқаша айтқанда, Женева конвенциясы бойынша олар жалдамалылар қатарына жатқызылады.
Dialogue: 0,1:03:16.54,1:03:18.16,Default,,0,0,0,,Бұл Рим статуты ма?
Dialogue: 0,1:03:18.29,1:03:19.79,Default,,0,0,0,,Осымен
Dialogue: 0,1:03:20.67,1:03:24.63,Default,,0,0,0,,Миссияның негізгі мақсаты - Джон Полды өлтіру...
Dialogue: 0,1:03:24.75,1:03:26.71,Default,,0,0,0,,Жоқ, бұл жай ғана қамауға алу.
Dialogue: 0,1:03:27.09,1:03:30.47,Default,,0,0,0,,Бірақ ол Гааганың немесе Үндістанның жаңа үкіметінің қолына түспеуі керек.
Dialogue: 0,1:03:31.14,1:03:32.76,Default,,0,0,0,,Жергілікті күштердің мүшелері:
Dialogue: 0,1:03:32.89,1:03:36.72,Default,,0,0,0,,18 жасқа толмағандар 60% құрайды деп есептеледі.
Dialogue: 0,1:03:37.68,1:03:41.23,Default,,0,0,0,,Ертеңнен бастап мүмкіндігінше тезірек тактикалық кеңес алыңыз.
Dialogue: 0,1:03:41.65,1:03:43.98,Default,,0,0,0,,Операция бір аптадан кейін.
Dialogue: 0,1:03:47.19,1:03:51.20,Default,,0,0,0,,Бұл кісі өлтіру ниеті сіздікі ме?
Dialogue: 0,1:03:52.24,1:03:55.08,Default,,0,0,0,,Әрине, бұл сіздің ниетіңіз.
Dialogue: 0,1:03:55.20,1:03:56.66,Default,,0,0,0,,Сөзсіз
Dialogue: 0,1:03:56.79,1:03:59.25,Default,,0,0,0,,«Күмәнсіз»?
Dialogue: 0,1:04:00.16,1:04:01.54,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:04:01.67,1:04:04.50,Default,,0,0,0,,Суық тигенде ауруханаға келгенмен бірдей.
Dialogue: 0,1:04:04.88,1:04:08.51,Default,,0,0,0,,Ең алдымен емдейтін ерік-жігер бар.
Dialogue: 0,1:04:09.05,1:04:13.09,Default,,0,0,0,,Фронтальды бөлікті жергілікті маскалау және кеңес беру құралдары болып табылады.
Dialogue: 0,1:04:13.22,1:04:14.85,Default,,0,0,0,,Өйткені сіз мұнда келмес бұрын,
Dialogue: 0,1:04:14.97,1:04:18.10,Default,,0,0,0,,Сіз күресуді таңдадыңыз.
Dialogue: 0,1:04:18.68,1:04:20.10,Default,,0,0,0,,Адамның әрекеттері мен ойлары-
Dialogue: 0,1:04:20.23,1:04:24.65,Default,,0,0,0,,Ол мидағы көптеген модульдердің бірігуі ретінде жасалады.
Dialogue: 0,1:04:25.48,1:04:27.15,Default,,0,0,0,,Бұл модуль ме?
Dialogue: 0,1:04:27.44,1:04:30.19,Default,,0,0,0,,«Топ» сөзін қарастырыңыз
Dialogue: 0,1:04:30.32,1:04:35.49,Default,,0,0,0,,10 000 адам 1000 адам тобыр болар еді. Сонда 100 адам? Ал 10 адам ше?
Dialogue: 0,1:04:35.62,1:04:38.66,Default,,0,0,0,,Көпшілік қанша топты құрайды?
Dialogue: 0,1:04:40.45,1:04:43.75,Default,,0,0,0,,«Мен» болу үшін қанша модуль тірі болуы керек?
Dialogue: 0,1:04:43.88,1:04:47.67,Default,,0,0,0,,«Сананы» қалыптастыру үшін неше модуль қосылуы керек?
Dialogue: 0,1:04:48.17,1:04:50.13,Default,,0,0,0,,Кеңесші сұрақтар қояды
Dialogue: 0,1:04:50.26,1:04:54.68,Default,,0,0,0,,Бұл сұрақ жауынгерлік бейімделгіш эмоционалды реттеу деп аталатын процесте қойылады.
Dialogue: 0,1:04:54.80,1:04:58.68,Default,,0,0,0,,Мен оның қандай қызмет атқаратынын білмеймін.
Dialogue: 0,1:04:59.31,1:05:03.69,Default,,0,0,0,,Жауаптан кеңесші не тұжырымдайды?
Dialogue: 0,1:05:04.15,1:05:07.44,Default,,0,0,0,,Осы уақытқа дейін бұл кеңесшінің аузынан шыққан сөздер...
Dialogue: 0,1:05:07.57,1:05:10.82,Default,,0,0,0,,Оның сезімге, парасатқа қандай әсері болды?
Dialogue: 0,1:05:11.40,1:05:12.95,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:05:17.12,1:05:20.70,Default,,0,0,0,,Сіз қалай ойлайсыз? Енді сіз баланы өлтіре аламын деп ойлайсыз ба?
Dialogue: 0,1:05:54.45,1:05:57.32,Default,,0,0,0,,Бұл достықтың қайнар көзі, Клавис.
Dialogue: 0,1:05:59.49,1:06:02.08,Default,,0,0,0,,Иә? Иә иә
Dialogue: 0,1:06:02.87,1:06:06.08,Default,,0,0,0,,Мен сені қазір қаншалықты жақсы көремін.
Dialogue: 0,1:06:06.54,1:06:08.42,Default,,0,0,0,,Мен сізге айтқым келеді.
Dialogue: 0,1:06:09.04,1:06:10.38,Default,,0,0,0,,Отбасы адамы
Dialogue: 0,1:06:10.50,1:06:11.75,Default,,0,0,0,,А…?
Dialogue: 0,1:06:13.97,1:06:15.05,Default,,0,0,0,,Қараңыз, балама.
Dialogue: 0,1:06:15.17,1:06:16.18,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:06:26.27,1:06:28.35,Default,,0,0,0,,Дисплей жүйесінде ақау жоқ
Dialogue: 0,1:06:28.69,1:06:29.86,Default,,0,0,0,,Мен әрқашан ойлаймын
Dialogue: 0,1:06:29.98,1:06:33.03,Default,,0,0,0,,Бұл сынақ үлгісі біраз саяхат.
Dialogue: 0,1:06:33.78,1:06:36.95,Default,,0,0,0,,Пандаға ұқсайсың, кремді сүрт.
Dialogue: 0,1:06:37.24,1:06:40.37,Default,,0,0,0,,Пандалардың беттері ақ, көздерінің айналасында қара шеңберлер бар.
Dialogue: 0,1:06:40.37,1:06:41.03,Default,,0,0,0,,Пандалардың беттері ақ, көздерінің айналасында қара шеңберлер бар.
Dialogue: 0,1:06:40.37,1:06:41.03,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,1:06:41.03,1:06:41.16,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,1:06:41.16,1:06:42.91,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,1:06:41.16,1:06:42.91,Default,,0,0,0,,Түсетін уақыт та қалды. Жоғары суға түсуге дайын болыңыз.
Dialogue: 0,1:06:42.91,1:06:45.00,Default,,0,0,0,,Түсетін уақыт та қалды. Жоғары суға түсуге дайын болыңыз.
Dialogue: 0,1:06:45.12,1:06:50.42,Default,,0,0,0,,Механик оттегі маскасын киеді. Инъекция қақпасы 20 секундта ашылады!
Dialogue: 0,1:06:51.59,1:06:56.92,Default,,0,0,0,,Жоспарланғандай CCB-мен айналадағы атыс қаруы бар көлікті соққаннан кейін бірден қону
Dialogue: 0,1:06:57.22,1:06:58.93,Default,,0,0,0,,Тартқышты кеңейту уақыты:
Dialogue: 0,1:06:59.26,1:07:01.26,Default,,0,0,0,,Оны қорапқа қалдырыңыз.
Dialogue: 0,1:07:08.64,1:07:11.44,Default,,0,0,0,,CCB түсіргеннен кейін кері санақты енгізіңіз
Dialogue: 0,1:07:11.86,1:07:13.52,Default,,0,0,0,,Инъекция қақпасы ашық!
Dialogue: 0,1:07:15.99,1:07:17.45,Default,,0,0,0,,Түсіріңіз!
Dialogue: 0,1:07:20.66,1:07:23.58,Default,,0,0,0,,5 4 3…
Dialogue: 0,1:07:23.70,1:07:25.41,Default,,0,0,0,,Алла разы болсын
Dialogue: 0,1:07:53.36,1:07:54.61,Default,,0,0,0,,(Шетелдік жауынгерлердің айқайы)
Dialogue: 0,1:07:55.73,1:07:57.32,Default,,0,0,0,,(Шетелдік солдаттардың айқайы)
Dialogue: 0,1:07:57.74,1:08:00.65,Default,,0,0,0,,(Шетелдік солдаттардың үрейлі дауыстары)
Dialogue: 0,1:08:08.08,1:08:08.91,Default,,0,0,0,,Ол сәл қорқынышты емес пе?
Dialogue: 0,1:08:10.12,1:08:11.42,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,1:08:19.72,1:08:21.68,Default,,0,0,0,,...
Dialogue: 0,1:08:30.43,1:08:31.31,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:08:47.70,1:08:50.62,Default,,0,0,0,,(шетел тілінде сөйлейді)
Dialogue: 0,1:08:51.08,1:08:52.37,Default,,0,0,0,,(Әскери баланың айқайы)
Dialogue: 0,1:08:52.37,1:08:53.62,Default,,0,0,0,,(Әскери баланың айқайы)
Dialogue: 0,1:08:52.37,1:08:53.62,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:08:53.62,1:08:54.13,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:09:07.10,1:09:08.01,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:09:30.87,1:09:34.46,Default,,0,0,0,,Сіз білесіз бе? Балалар, сендер есірткі ішіп жүрсіңдер.
Dialogue: 0,1:09:34.58,1:09:38.88,Default,,0,0,0,,Сондықтан біз өмірді алуға міндеттіміз.
Dialogue: 0,1:09:40.75,1:09:41.84,Default,,0,0,0,,Ахх...
Dialogue: 0,1:09:45.09,1:09:46.30,Default,,0,0,0,,Ахх...
Dialogue: 0,1:09:46.43,1:09:49.68,Default,,0,0,0,,Гах... Куккук... Ух...
Dialogue: 0,1:09:50.31,1:09:51.14,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:09:55.31,1:09:58.86,Default,,0,0,0,,Джейгер Бізде де солай.
Dialogue: 0,1:09:59.90,1:10:01.61,Default,,0,0,0,,Наномашиналарды миға енгізу —
Dialogue: 0,1:10:01.73,1:10:04.15,Default,,0,0,0,,Өйткені біз ауырсыну сезімін жасырамыз.
Dialogue: 0,1:10:04.28,1:10:05.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:22.21,1:10:22.76,Default,,0,0,0,,Сіз бұл туралы ойлап көрдіңіз бе?
Dialogue: 0,1:10:22.76,1:10:24.05,Default,,0,0,0,,Сіз бұл туралы ойлап көрдіңіз бе?
Dialogue: 0,1:10:22.76,1:10:24.05,Default,,0,0,0,,(Әскери баланың айқайы)
Dialogue: 0,1:10:24.05,1:10:24.17,Default,,0,0,0,,(Әскери баланың айқайы)
Dialogue: 0,1:10:24.17,1:10:26.01,Default,,0,0,0,,(Әскери баланың айқайы)
Dialogue: 0,1:10:24.17,1:10:26.01,Default,,0,0,0,,Егер сіз және сіздің достарыңыз бір-біріңізді атып алсаңыз—
Dialogue: 0,1:10:26.01,1:10:26.72,Default,,0,0,0,,(Әскери баланың айқайы)
Dialogue: 0,1:10:26.72,1:10:28.59,Default,,0,0,0,,(Әскери баланың айқайы)
Dialogue: 0,1:10:26.72,1:10:28.59,Default,,0,0,0,,Біз оны өлтіргенімізге сенімді болмайынша...
Dialogue: 0,1:10:28.59,1:10:29.76,Default,,0,0,0,,Біз оны өлтіргенімізге сенімді болмайынша —
Dialogue: 0,1:10:30.18,1:10:32.10,Default,,0,0,0,,Сізге тек атуды жалғастыру керек.
Dialogue: 0,1:10:35.48,1:10:37.90,Default,,0,0,0,,Бұл тозақ
Dialogue: 0,1:10:38.65,1:10:40.77,Default,,0,0,0,,Уф... аа!
Dialogue: 0,1:10:40.90,1:10:41.98,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:42.11,1:10:43.65,Default,,0,0,0,,Ааа! (Бала солдат) Арх!
Dialogue: 0,1:10:43.78,1:10:44.74,Default,,0,0,0,,《Міне, басталды!》
Dialogue: 0,1:10:50.41,1:10:52.53,Default,,0,0,0,,(Әскери баланың ауыр тыныс алуы)
Dialogue: 0,1:10:52.66,1:10:54.08,Default,,0,0,0,,Хаа (мылтық дыбысы)
Dialogue: 0,1:10:54.54,1:10:55.58,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:57.67,1:10:58.58,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:11:04.96,1:11:05.80,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:11:05.92,1:11:07.09,Default,,0,0,0,,Бұл мерген.
Dialogue: 0,1:11:07.76,1:11:08.80,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:11:09.59,1:11:11.60,Default,,0,0,0,,Не істеу керек? Мен енді жалғастыра алмаймын
Dialogue: 0,1:11:11.93,1:11:14.35,Default,,0,0,0,,Терезенің астына кіріп кеткіңіз келе ме?
Dialogue: 0,1:11:15.72,1:11:17.43,Default,,0,0,0,,Көк бала, келе жатырсың ба?
Dialogue: 0,1:11:17.56,1:11:18.64,Default,,0,0,0,,Иә, Джегер.
Dialogue: 0,1:11:18.77,1:11:21.73,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:11:21.86,1:11:24.32,Default,,0,0,0,,Бірақ қанша мерген бар?
Dialogue: 0,1:11:24.44,1:11:26.49,Default,,0,0,0,,Менің оған бәс тіккенді ұнатпаймын.
Dialogue: 0,1:11:26.61,1:11:28.36,Default,,0,0,0,,Оны түтінмен толтырыңыз?
Dialogue: 0,1:11:30.03,1:11:31.87,Default,,0,0,0,,Ішіңізде сізге шабуыл жасалса, жағымсыз болар еді.
Dialogue: 0,1:11:32.28,1:11:34.62,Default,,0,0,0,,Олай болса, Алла разы болсын.
Dialogue: 0,1:11:36.16,1:11:40.71,Default,,0,0,0,,Теңіз балдыры Мен сенің біреуін бөліп алуыңды қалаймын. Мен саған мақсат беремін.
Dialogue: 0,1:11:41.71,1:11:43.13,Default,,0,0,0,,Джегерді түсіндім
Dialogue: 0,1:11:48.30,1:11:49.38,Default,,0,0,0,,ұсталды
Dialogue: 0,1:11:54.60,1:11:55.60,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:12:00.19,1:12:02.86,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:12:05.11,1:12:06.78,Default,,0,0,0,,Рахмет! seaweed
Dialogue: 0,1:12:20.54,1:12:21.67,Default,,0,0,0,,(Әскери баланың жөтелі)
Dialogue: 0,1:12:28.38,1:12:29.38,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:12:30.59,1:12:31.47,Default,,0,0,0,,(Әскери баланың айқайы)
Dialogue: 0,1:12:32.01,1:12:33.01,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:36.51,1:12:38.47,Default,,0,0,0,,У… Уу…
Dialogue: 0,1:12:40.35,1:12:43.10,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,1:12:43.23,1:12:44.77,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,1:12:46.07,1:12:46.94,Default,,0,0,0,,(шетел тілінде сөйлейді)
Dialogue: 0,1:12:46.94,1:12:50.07,Default,,0,0,0,,(шетел тілінде сөйлейді)
Dialogue: 0,1:12:46.94,1:12:50.07,Default,,0,0,0,,Халықаралық қылмыстық соттың мәжбүрлеу күші.
Dialogue: 0,1:12:50.07,1:12:50.19,Default,,0,0,0,,(шетел тілінде сөйлейді)
Dialogue: 0,1:12:50.19,1:12:52.03,Default,,0,0,0,,(шетел тілінде сөйлейді)
Dialogue: 0,1:12:50.19,1:12:52.03,Default,,0,0,0,,Сізді тұтқындауға ордері бар адамдар үшін —
Dialogue: 0,1:12:52.15,1:12:55.37,Default,,0,0,0,,Қалай ойлайсың, басқа адамдармен осылай амандасатындар бар ма?
Dialogue: 0,1:12:55.49,1:12:57.45,Default,,0,0,0,,Жалдамалы солдат?
Dialogue: 0,1:12:57.87,1:13:00.95,Default,,0,0,0,,Соғысқа жем болғандар
Dialogue: 0,1:13:01.71,1:13:04.67,Default,,0,0,0,,Хмф! Сіз де сол саладасыз.
Dialogue: 0,1:13:04.79,1:13:08.67,Default,,0,0,0,,Біз Үндістанның ұлы жерін қорлаймыз —
Dialogue: 0,1:13:08.80,1:13:11.92,Default,,0,0,0,,Кәпірлерге қарсы соғысқан крест жорығы.
Dialogue: 0,1:13:08.80,1:13:11.92,Default,,0,0,0,,(шетел тілінде сөйлейді)
Dialogue: 0,1:13:13.05,1:13:15.43,Default,,0,0,0,,Ақшаға табынушылар сендермен араласпаңдар.
Dialogue: 0,1:13:15.55,1:13:19.68,Default,,0,0,0,,Комедиялық шоу сияқты хахахахаха
Dialogue: 0,1:13:20.35,1:13:22.31,Default,,0,0,0,,Nuah! Уф...
Dialogue: 0,1:13:22.43,1:13:23.44,Default,,0,0,0,,Хмм...
Dialogue: 0,1:13:30.86,1:13:32.40,Default,,0,0,0,,Джон Павел
Dialogue: 0,1:13:35.49,1:13:37.41,Default,,0,0,0,,Шпиондар ханзадасы
Dialogue: 0,1:13:37.70,1:13:40.24,Default,,0,0,0,,Ол сондай-ақ арнайы жасақтың мүшесі болған.
Dialogue: 0,1:13:40.70,1:13:44.50,Default,,0,0,0,,Бұл менің нағыз жұмысым. Where's Lucia?
Dialogue: 0,1:13:44.62,1:13:46.42,Default,,0,0,0,,Мұнда емес
Dialogue: 0,1:13:46.71,1:13:51.17,Default,,0,0,0,,Сіздің мақсатыңыз ұлт өмірінен басқа жерде жатқан сияқты.
Dialogue: 0,1:14:00.47,1:14:02.31,Default,,0,0,0,,Мен сені тұтқынға аламын.
Dialogue: 0,1:14:02.93,1:14:04.89,Default,,0,0,0,,Джегер, бұл менмін
Dialogue: 0,1:14:07.60,1:14:10.86,Default,,0,0,0,,Теңіз балдыры, менде заттар бар, есеп айырысу.
Dialogue: 0,1:14:34.67,1:14:40.68,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,1:14:50.94,1:14:54.53,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:14:59.62,1:15:02.03,Default,,0,0,0,,Әй, бәрі, мынау!
Dialogue: 0,1:15:05.16,1:15:07.58,Default,,0,0,0,,У… Уу…
Dialogue: 0,1:15:07.71,1:15:09.50,Default,,0,0,0,,Ку... у...
Dialogue: 0,1:15:09.63,1:15:10.50,Default,,0,0,0,,Уф
Dialogue: 0,1:15:11.04,1:15:12.29,Default,,0,0,0,,Ei (атқарушы) Уф
Dialogue: 0,1:15:13.55,1:15:16.22,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,1:15:23.31,1:15:25.39,Default,,0,0,0,,Барлығы қалпына келтірілді.
Dialogue: 0,1:15:26.56,1:15:29.44,Default,,0,0,0,,Джегер! Бұл қонақүй қай қабатта болды?
Dialogue: 0,1:15:29.56,1:15:32.56,Default,,0,0,0,,Бұл 4-қабат. 1 қабат 8 фут.
Dialogue: 0,1:15:35.86,1:15:36.86,Default,,0,0,0,,Әй!
Dialogue: 0,1:15:42.91,1:15:43.91,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,1:15:46.79,1:15:48.66,Default,,0,0,0,,Джегерден келген кеңсе
Dialogue: 0,1:15:49.50,1:15:51.00,Default,,0,0,0,,Жұмыс аяқталады
Dialogue: 0,1:15:52.21,1:15:55.59,Default,,0,0,0,,Барлық пакеттер мен құндылықтар қорғалған
Dialogue: 0,1:15:57.67,1:15:59.38,Default,,0,0,0,,Мен енді үйге қайтамын.
Dialogue: 0,1:16:02.22,1:16:03.68,Default,,0,0,0,,Теңіз балдырының қоңырауы
Dialogue: 0,1:16:03.80,1:16:06.22,Default,,0,0,0,,А нысанасы қорғалған
Dialogue: 0,1:16:06.43,1:16:08.02,Default,,0,0,0,,О...
Dialogue: 0,1:16:09.77,1:16:10.98,Default,,0,0,0,,Әскерлерге зақым келді ме?
Dialogue: 0,1:16:11.10,1:16:12.35,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:16:12.48,1:16:14.90,Default,,0,0,0,,Ұшатын шошқа соңғы қауіпсіздік сызығын кесіп өтті.
Dialogue: 0,1:16:15.02,1:16:18.53,Default,,0,0,0,,Евгений мен Круппс ауаны басқару аймағына кірген сияқты.
Dialogue: 0,1:16:18.61,1:16:19.03,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:16:19.03,1:16:21.66,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:16:19.03,1:16:21.66,Default,,0,0,0,,Мумбай базасына жоспарланған маршрут бойынша келу –
Dialogue: 0,1:16:21.66,1:16:21.78,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:16:21.78,1:16:24.62,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:16:21.78,1:16:24.62,Default,,0,0,0,,Вашингтон уақытымен 26:53-те күтіледі
Dialogue: 0,1:16:24.62,1:16:25.62,Default,,0,0,0,,Вашингтон уақытымен 26:53-те күтіледі
Dialogue: 0,1:16:29.08,1:16:33.21,Default,,0,0,0,,Джегер болжанған соңғы ескерту сызығынан өтті.
Dialogue: 0,1:16:33.71,1:16:35.54,Default,,0,0,0,,Іздеу белгісі жоқ
Dialogue: 0,1:16:35.92,1:16:36.92,Default,,0,0,0,,Сіз мұны естідіңіз бе?
Dialogue: 0,1:16:37.05,1:16:39.88,Default,,0,0,0,,Испан инквизициясы туралы менің күтпеген оқиғам
Dialogue: 0,1:16:40.01,1:16:42.01,Default,,0,0,0,,Сіз мұны айттыңыз ба?
Dialogue: 0,1:16:42.13,1:16:44.72,Default,,0,0,0,,Бұл ғасырдағы ең жақсы әзіл.
Dialogue: 0,1:16:44.85,1:16:45.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:46.97,1:16:49.31,Default,,0,0,0,,Біріншіден, біз—
Dialogue: 0,1:16:49.43,1:16:50.52,Default,,0,0,0,,Адам құқықтарын елемеудің бұл түрі...
Dialogue: 0,1:16:50.52,1:16:52.44,Default,,0,0,0,,Адам құқықтарын елемеудің бұл түрі...
Dialogue: 0,1:16:50.52,1:16:52.44,Default,,0,0,0,,Бұл сіз үшін босқа...
Dialogue: 0,1:16:53.48,1:16:55.19,Default,,0,0,0,,Бұл бірінші сынып.
Dialogue: 0,1:16:55.31,1:16:57.15,Default,,0,0,0,,Леланд (Лиланд) Иә?
Dialogue: 0,1:16:57.52,1:16:58.94,Default,,0,0,0,,Бұл менмін
Dialogue: 0,1:16:59.40,1:17:00.44,Default,,0,0,0,,Хмм... (қақпақ жабылған дыбыс)
Dialogue: 0,1:17:03.24,1:17:05.62,Default,,0,0,0,,Тым көп қорқытпаңыз
Dialogue: 0,1:17:07.91,1:17:12.21,Default,,0,0,0,,Жасанды бұлшықет табыттарының дәмі нашар.
Dialogue: 0,1:17:12.58,1:17:15.83,Default,,0,0,0,,Бірақ егер сіз апатқа ұшырасаңыз да, ол сіздің өміріңізді сақтайды.
Dialogue: 0,1:17:16.04,1:17:18.42,Default,,0,0,0,,Соңғы бірінші класс.
Dialogue: 0,1:17:18.55,1:17:19.71,Default,,0,0,0,,Люсия қайда орналасқан?
Dialogue: 0,1:17:20.55,1:17:23.09,Default,,0,0,0,,Бұл сұрақтың сіздің тапсырмаңызға еш қатысы жоқ.
Dialogue: 0,1:17:23.22,1:17:24.97,Default,,0,0,0,,Менің қалағаным - Лузия
Dialogue: 0,1:17:25.64,1:17:26.93,Default,,0,0,0,,(Юки) Қыз ба? (Миямура) Ұл ба?
Dialogue: 0,1:17:27.64,1:17:31.48,Default,,0,0,0,,Осы мақсат үшін болса, мен тіпті баланы өлтірер едім... иә?
Dialogue: 0,1:17:34.06,1:17:37.90,Default,,0,0,0,,Ақыр соңында, бұл қиын жұмыс.
Dialogue: 0,1:17:38.61,1:17:42.11,Default,,0,0,0,,Бұл ауырады ма? Хахахаха...
Dialogue: 0,1:17:42.24,1:17:47.12,Default,,0,0,0,,Бұл өтірік. Білемін, сендер ештеңе сезбейсіңдер.
Dialogue: 0,1:17:47.37,1:17:51.45,Default,,0,0,0,,«Бұл жұмыс, сондықтан менде басқа амал жоқ». 19 ғасырдың басынан бастап-
Dialogue: 0,1:17:51.58,1:17:55.33,Default,,0,0,0,,Сөзі жәндіктерді де өлтірмейтін қарапайым адамдардан...
Dialogue: 0,1:17:55.46,1:17:58.79,Default,,0,0,0,,Қанша қатыгездікті сыртқа шығара алдыңыз?
Dialogue: 0,1:17:59.25,1:18:02.76,Default,,0,0,0,,Бұл жұмыс болғандықтан, нацистер еврейлерді газ камераларына жібере алды.
Dialogue: 0,1:18:03.22,1:18:05.76,Default,,0,0,0,,Бұл жұмыс болғандықтан, Шығыс Германия шекарашылары...
Dialogue: 0,1:18:05.88,1:18:08.68,Default,,0,0,0,,Біз дезертирді батысқа атып түсіре алдық.
Dialogue: 0,1:18:08.80,1:18:14.06,Default,,0,0,0,,Адамның ар-ұжданын әлсірету үшін барлық жұмыс бар.
Dialogue: 0,1:18:14.35,1:18:16.90,Default,,0,0,0,,Сіз де еңбекқорлықтан ұтыла алмайсыз.
Dialogue: 0,1:18:17.27,1:18:21.02,Default,,0,0,0,,Дүниені айналып ұшып, Салқын жағында қырғын
Dialogue: 0,1:18:21.15,1:18:24.82,Default,,0,0,0,,Дәл... Мүлдем ұқсаспыз...
Dialogue: 0,1:18:24.95,1:18:25.82,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,1:18:25.95,1:18:27.41,Default,,0,0,0,,Жоқ, дәл солай
Dialogue: 0,1:18:28.70,1:18:33.91,Default,,0,0,0,,Мойындайық Иә, мен тек сөзді қарғаймын
Dialogue: 0,1:18:34.04,1:18:37.92,Default,,0,0,0,,Жауап нөлге тең. Сен ше?
Dialogue: 0,1:18:38.71,1:18:41.67,Default,,0,0,0,,Сіздің миыңыз өз эмоцияларын ұрысқа бейімдеді.
Dialogue: 0,1:18:41.80,1:18:44.30,Default,,0,0,0,,Мен мылтық сілтеген балаларды атып өлтіргенде —
Dialogue: 0,1:18:44.42,1:18:47.88,Default,,0,0,0,,Сіз өзіңізді кінәлі сезінесіз бе?
Dialogue: 0,1:18:48.39,1:18:49.93,Default,,0,0,0,,Сізді сендіруге рұқсат етіңіз
Dialogue: 0,1:18:51.47,1:18:53.14,Default,,0,0,0,,Бұл тегіс.
Dialogue: 0,1:18:53.27,1:18:54.10,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,1:18:54.22,1:18:57.89,Default,,0,0,0,,Сіз, эмоцияларыңыз оңтайландырылған, сіз біреуге қолыңызды қойған кезде—
Dialogue: 0,1:18:58.02,1:19:02.44,Default,,0,0,0,,Бұл бір уақытта толығымен рефлексиялық және тыныш болуы керек.
Dialogue: 0,1:19:06.57,1:19:07.70,Default,,0,0,0,,Ашық сөйлеңіз
Dialogue: 0,1:19:08.16,1:19:11.37,Default,,0,0,0,,Сіз және мүмкін сіздің жолдастарыңыз...
Dialogue: 0,1:19:11.49,1:19:14.29,Default,,0,0,0,,Нағыз ұрысқа қатысқанына қарамастан —
Dialogue: 0,1:19:14.41,1:19:16.12,Default,,0,0,0,,Сіз әрқашан қанағаттанбауыңызды сезінуіңіз керек.
Dialogue: 0,1:19:16.12,1:19:17.58,Default,,0,0,0,,Сіз әрқашан қанағаттанбағаныңызды сезінуіңіз керек.
Dialogue: 0,1:19:16.12,1:19:17.58,Default,,0,0,0,,(Сарбаздардың күлкісі)
Dialogue: 0,1:19:17.58,1:19:18.37,Default,,0,0,0,,(Сарбаздардың күлкісі)
Dialogue: 0,1:19:18.37,1:19:19.21,Default,,0,0,0,,(Сарбаздардың күлкісі)
Dialogue: 0,1:19:18.37,1:19:19.21,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:19.21,1:19:19.50,Default,,0,0,0,,(Сарбаздардың күлкісі)
Dialogue: 0,1:19:19.50,1:19:22.21,Default,,0,0,0,,(Сарбаздардың күлкісі)
Dialogue: 0,1:19:19.50,1:19:22.21,Default,,0,0,0,,Жүрегіңді жауып аласың
Dialogue: 0,1:19:22.67,1:19:26.38,Default,,0,0,0,,Дәлірек айтқанда, адамның жүрегін жабуға мүмкіндік беріңіз.
Dialogue: 0,1:19:27.34,1:19:33.31,Default,,0,0,0,,Өзіңізге басқаларға, тіпті жас өмірге де сезімтал болуға мүмкіндік беріңіз.
Dialogue: 0,1:19:33.43,1:19:35.10,Default,,0,0,0,,Бұл белгілі бір мағынада
Dialogue: 0,1:19:35.22,1:19:38.35,Default,,0,0,0,,Баланың өзін өлтіруден әлдеқайда қатыгез.
Dialogue: 0,1:19:41.69,1:19:43.73,Default,,0,0,0,,Маған жақсы нәрсе айтайын.
Dialogue: 0,1:19:44.15,1:19:46.82,Default,,0,0,0,,Геноцид грамматикасы миға қандай әсер етеді?
Dialogue: 0,1:19:46.94,1:19:50.95,Default,,0,0,0,,Бұл балалар сіздердің эмоцияларды реттеу процесіне өте ұқсас.
Dialogue: 0,1:19:51.07,1:19:53.12,Default,,0,0,0,,Е... а...
Dialogue: 0,1:19:53.24,1:19:54.62,Default,,0,0,0,,Ар-ұжданыңызды басыңыз—
Dialogue: 0,1:19:54.74,1:19:57.87,Default,,0,0,0,,Ол құндылық пайымдауларын белгілі бір бағытта бағыттайды.
Dialogue: 0,1:19:58.29,1:19:59.37,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:59.62,1:20:02.25,Default,,0,0,0,,Сіз мұны технология арқылы жасайсыз.
Dialogue: 0,1:20:02.54,1:20:07.38,Default,,0,0,0,,Ежелден келе жатқан өсиетті сөз құдіретімен орындаймын.
Dialogue: 0,1:20:08.51,1:20:10.47,Default,,0,0,0,,А... не болды?
Dialogue: 0,1:20:10.59,1:20:14.26,Default,,0,0,0,,Егер біздің миымыз маскалы болса,
Dialogue: 0,1:20:14.39,1:20:17.39,Default,,0,0,0,,Егер геноцид грамматикасының әсерлері қолданылса...
Dialogue: 0,1:20:17.77,1:20:18.93,Default,,0,0,0,,Иә...
Dialogue: 0,1:20:19.06,1:20:22.40,Default,,0,0,0,,Мен оның тиімдірек көрінетініне сенімдімін.
Dialogue: 0,1:20:24.44,1:20:25.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:26.32,1:20:28.36,Default,,0,0,0,,Оны қолданып көргіңіз келе ме?
Dialogue: 0,1:20:29.99,1:20:31.28,Default,,0,0,0,,Джагер Бір
Dialogue: 0,1:20:31.82,1:20:34.07,Default,,0,0,0,,Хмм... не болды?
Dialogue: 0,1:20:34.20,1:20:35.91,Default,,0,0,0,,Бірдеңе болады
Dialogue: 0,1:20:42.21,1:20:43.46,Default,,0,0,0,,Үнді қуғыншылар?
Dialogue: 0,1:20:43.75,1:20:47.80,Default,,0,0,0,,Ол Қытайда жасалған. Қай фракцияға жататынын білмеймін.
Dialogue: 0,1:20:50.22,1:20:51.97,Default,,0,0,0,,Теңіз балдыры Артынан...
Dialogue: 0,1:20:57.47,1:20:58.35,Default,,0,0,0,,Ух... (Клавис) Ах.
Dialogue: 0,1:20:58.60,1:20:59.56,Default,,0,0,0,,менің, Иида мен Тодорокидің есімдері жарияланбады—
Dialogue: 0,1:20:59.68,1:21:01.69,Default,,0,0,0,,Уф...
Dialogue: 0,1:21:07.36,1:21:10.57,Default,,0,0,0,,Уау... ау!
Dialogue: 0,1:21:21.04,1:21:22.96,Default,,0,0,0,,Уф... аа...
Dialogue: 0,1:21:28.04,1:21:29.21,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:29.59,1:21:34.97,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,1:21:37.18,1:21:38.26,Default,,0,0,0,,Уф...
Dialogue: 0,1:21:42.14,1:21:43.35,Default,,0,0,0,,Уильямс
Dialogue: 0,1:21:45.94,1:21:48.82,Default,,0,0,0,,Өлген жоқ... Боқ...
Dialogue: 0,1:21:50.65,1:21:51.65,Default,,0,0,0,,Хмм
Dialogue: 0,1:21:52.57,1:21:53.61,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:21:57.53,1:22:00.37,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,1:22:08.79,1:22:13.38,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:22:17.84,1:22:18.68,Default,,0,0,0,,Уф...
Dialogue: 0,1:22:19.76,1:22:22.56,Default,,0,0,0,,Көк бала Көк бала жауап!
Dialogue: 0,1:22:22.68,1:22:24.31,Default,,0,0,0,,Сіз Джейгерсіз бе?
Dialogue: 0,1:22:25.14,1:22:27.69,Default,,0,0,0,,Ол жерден шамамен 200 ярд.
Dialogue: 0,1:22:27.81,1:22:28.81,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,1:22:28.94,1:22:31.27,Default,,0,0,0,,Тікұшақ атып түсірілген сияқты.
Dialogue: 0,1:22:31.52,1:22:32.11,Default,,0,0,0,,Көп ұзамай тікұшақ әскерлері келеді.
Dialogue: 0,1:22:32.11,1:22:33.11,Default,,0,0,0,,Көп ұзамай тікұшақ әскерлері келеді.
Dialogue: 0,1:22:32.11,1:22:33.11,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:22:33.11,1:22:33.86,Default,,0,0,0,,Көп ұзамай тікұшақ әскерлері келеді.
Dialogue: 0,1:22:33.99,1:22:36.95,Default,,0,0,0,,Біз қазір аударылған екінші жүкпен айналысып жатырмыз.
Dialogue: 0,1:22:37.41,1:22:38.57,Default,,0,0,0,,Тұтқындар ше?
Dialogue: 0,1:22:38.70,1:22:40.08,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:22:40.20,1:22:44.79,Default,,0,0,0,,Алайда бірінші жүкте қалғандардың мәртебесі өлімді көрсетеді.
Dialogue: 0,1:22:44.91,1:22:47.17,Default,,0,0,0,,Мен сыртқа шығайын деп жатқанда...
Dialogue: 0,1:22:47.29,1:22:49.96,Default,,0,0,0,,Сол қолым иығымнан ұшып кетті.
Dialogue: 0,1:22:51.50,1:22:52.46,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,1:22:52.59,1:22:55.01,Default,,0,0,0,,Хехе, иә, ауырады.
Dialogue: 0,1:22:55.13,1:22:58.39,Default,,0,0,0,,Мен оны сезбеймін, бірақ тани аламын.
Dialogue: 0,1:22:58.64,1:23:00.60,Default,,0,0,0,,Бірақ ешқандай проблема жоқ.
Dialogue: 0,1:23:00.72,1:23:03.31,Default,,0,0,0,,Мен текстура ретінде ауырсынуды сезіне алмаймын ...
Dialogue: 0,1:23:03.43,1:23:07.10,Default,,0,0,0,,Уа, Барри! Уф... Қарғыс атсын.
Dialogue: 0,1:23:07.23,1:23:09.40,Default,,0,0,0,,Клавис Енді Нельсон жеңілді!
Dialogue: 0,1:23:09.52,1:23:11.86,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:23:41.01,1:23:43.56,Default,,0,0,0,,А... бетперделеу?
Dialogue: 0,1:23:46.06,1:23:48.39,Default,,0,0,0,,Олар ауырсыну сезімін жасырады!
Dialogue: 0,1:23:48.52,1:23:50.23,Default,,0,0,0,,Иә, мен оны білемін.
Dialogue: 0,1:23:50.98,1:23:54.90,Default,,0,0,0,,Сізге гамбургер алғанша оқ пен мылтық шашу жеткілікті.
Dialogue: 0,1:24:06.49,1:24:12.50,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:24:23.18,1:24:25.68,Default,,0,0,0,,Қарғыс атсын... бұл сұмдық!
Dialogue: 0,1:24:25.97,1:24:27.14,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:24:30.02,1:24:31.10,Default,,0,0,0,,Уф!
Dialogue: 0,1:24:33.44,1:24:34.56,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:24:34.90,1:24:36.78,Default,,0,0,0,,Сәлем (Клавис) Жақсы...
Dialogue: 0,1:24:38.36,1:24:40.40,Default,,0,0,0,,Сыртта қандай?
Dialogue: 0,1:24:44.45,1:24:45.49,Default,,0,0,0,,Ха...
Dialogue: 0,1:25:02.55,1:25:04.93,Default,,0,0,0,,Осыған әзірше шыдай аласыз ба?
Dialogue: 0,1:25:05.05,1:25:06.97,Default,,0,0,0,,Хехехе
Dialogue: 0,1:25:07.31,1:25:08.35,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,1:25:08.47,1:25:11.48,Default,,0,0,0,,Сыртта ше? Бұл не?
Dialogue: 0,1:25:11.60,1:25:13.14,Default,,0,0,0,,Олар...
Dialogue: 0,1:25:20.78,1:25:21.99,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,1:25:25.99,1:25:32.00,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,1:25:39.55,1:25:41.67,Default,,0,0,0,,(ағылшынша төреші)
Dialogue: 0,1:25:41.80,1:25:42.88,Default,,0,0,0,,Күтілгендей, қорғаныс жағында болды.
Dialogue: 0,1:25:42.88,1:25:44.59,Default,,0,0,0,,Күтілгендей, қорғаныс жағында болды.
Dialogue: 0,1:25:42.88,1:25:44.59,Default,,0,0,0,,Бұл ақымақ ереже.
Dialogue: 0,1:25:44.72,1:25:47.30,Default,,0,0,0,,Аа, сен тым қорғансың.
Dialogue: 0,1:25:50.22,1:25:53.18,Default,,0,0,0,,Алекс айтты... Эй.
Dialogue: 0,1:25:53.31,1:25:56.02,Default,,0,0,0,,Ах, тозақ.
Dialogue: 0,1:25:56.48,1:25:57.73,Default,,0,0,0,,Біз де—
Dialogue: 0,1:25:57.86,1:26:00.61,Default,,0,0,0,,Бәлкім, бір күні сондай нәрсе болатын шығар.
Dialogue: 0,1:26:00.94,1:26:02.61,Default,,0,0,0,,Сіз жалғастыра аласыз ба?
Dialogue: 0,1:26:03.28,1:26:06.91,Default,,0,0,0,,Мен жалғастырамын, бұл жұмыс.
Dialogue: 0,1:26:09.03,1:26:12.08,Default,,0,0,0,,Мен және Уильямстан басқа жалғыз аман қалғандар:
Dialogue: 0,1:26:12.20,1:26:14.37,Default,,0,0,0,,Бұл жай ғана Шон мен Боб болды.
Dialogue: 0,1:26:15.42,1:26:21.21,Default,,0,0,0,,Біз АҚШ-тың әскери арнайы операциялар тобында жеңілген бірінші бөлім болдық.
Dialogue: 0,1:26:22.17,1:26:25.47,Default,,0,0,0,,Жаудың талай денелері жарылған.
Dialogue: 0,1:26:27.43,1:26:29.93,Default,,0,0,0,,Пазлға бір апта жұмсағаннан кейін үйренгенім:
Dialogue: 0,1:26:30.72,1:26:33.93,Default,,0,0,0,,Олар басқа мағынада өлі болды.
Dialogue: 0,1:26:34.06,1:26:37.44,Default,,0,0,0,,Олардың барлығы ұрыс даласында хабарсыз кетті.
Dialogue: 0,1:26:37.56,1:26:42.44,Default,,0,0,0,,Бұл соғыста қаза тапқан әскери ротаның сарбаздары.
Dialogue: 0,1:26:43.99,1:26:48.45,Default,,0,0,0,,Күдіктілер Евгений мен Круппс екені анық.
Dialogue: 0,1:26:48.57,1:26:51.28,Default,,0,0,0,,Оның үстіне, басқару тобының бірі...
Dialogue: 0,1:26:51.41,1:26:54.79,Default,,0,0,0,,Мен оның Сенаттағы көпшілік көшбасшысы екенін бірден білдім.
Dialogue: 0,1:26:56.16,1:26:57.12,Default,,0,0,0,,Біз басып алдық—
Dialogue: 0,1:26:57.25,1:27:00.21,Default,,0,0,0,,Индус фундаменталистік альянсының жетекшілері:
Dialogue: 0,1:27:00.34,1:27:04.38,Default,,0,0,0,,Соңында мен Гааганы былай қойғанда, концлагерьге де барған емеспін.
Dialogue: 0,1:27:04.51,1:27:05.97,Default,,0,0,0,,Мен тура зиратқа бардым.
Dialogue: 0,1:27:06.80,1:27:09.97,Default,,0,0,0,,Сая және апаттан өз өмірін сақтап қалған басқалар —
Dialogue: 0,1:27:10.30,1:27:12.06,Default,,0,0,0,,Бұл олардың табытына айналды.
Dialogue: 0,1:27:13.97,1:27:17.98,Default,,0,0,0,,Елес сарбаздардың мақсаты - Джон Полды қайтарып алу.
Dialogue: 0,1:27:18.10,1:27:20.06,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,1:27:27.82,1:27:29.82,Default,,0,0,0,,Мұнда басыңыз Тінтуір 02
Dialogue: 0,1:27:31.16,1:27:33.49,Default,,0,0,0,,Мен саған алтын медаль беремін, Теңіз балдыры.
Dialogue: 0,1:27:33.62,1:27:34.87,Default,,0,0,0,,Өтінемін, тышқан.
Dialogue: 0,1:27:34.99,1:27:36.41,Default,,0,0,0,,Хмм
Dialogue: 0,1:27:36.54,1:27:38.25,Default,,0,0,0,,Жерден радиолокациялық сәулені қабылдайды
Dialogue: 0,1:27:38.37,1:27:40.50,Default,,0,0,0,,Ақымақ, мені көре аласың ба?
Dialogue: 0,1:27:40.63,1:27:42.13,Default,,0,0,0,,Мені қазір бөл!
Dialogue: 0,1:27:42.25,1:27:44.34,Default,,0,0,0,,Бұл қалжың емес, сені жау тапты.
Dialogue: 0,1:27:44.63,1:27:45.92,Default,,0,0,0,,Босату түймесін басыңыз
Dialogue: 0,1:27:46.05,1:27:48.97,Default,,0,0,0,,Бұл ақылсыз! Уф... Жау зымыран ұшырды!
Dialogue: 0,1:27:49.51,1:27:51.05,Default,,0,0,0,,Сәлем, Кравис...
Dialogue: 0,1:27:56.06,1:27:58.43,Default,,0,0,0,,Орындалған басымдықты үзу
Dialogue: 0,1:27:58.56,1:28:00.94,Default,,0,0,0,,5 секундтан кейін шығарылады
Dialogue: 0,1:28:01.56,1:28:04.73,Default,,0,0,0,,2 1… Белгілеу
Dialogue: 0,1:28:18.33,1:28:19.75,Default,,0,0,0,,Уф...
Dialogue: 0,1:28:41.23,1:28:43.02,Default,,0,0,0,,Қонуға дейін 5 секунд
Dialogue: 0,1:28:43.15,1:28:46.32,Default,,0,0,0,,2 1… Белгілеу
Dialogue: 0,1:28:51.49,1:28:56.12,Default,,0,0,0,,10 11 12… Қозғалтқыштың құйрығын орналастыру
Dialogue: 0,1:29:14.18,1:29:15.93,Default,,0,0,0,,Есепке алынбағандар…
Dialogue: 0,1:29:16.80,1:29:19.64,Default,,0,0,0,,Люсис маған Прагада өлім аузында жатқанда өзін көрсетті.
Dialogue: 0,1:29:19.89,1:29:22.64,Default,,0,0,0,,Олар жалған идентификаторларды қалай пайдаланады
Dialogue: 0,1:29:24.85,1:29:27.02,Default,,0,0,0,,Бұл рас болды
Dialogue: 0,1:29:27.61,1:29:28.44,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:37.95,1:29:39.95,Default,,0,0,0,,Джон да осылай деді.
Dialogue: 0,1:29:43.83,1:29:47.34,Default,,0,0,0,,Бұл әртүрлі элементтерде жасырылған үлгі.
Dialogue: 0,1:29:48.00,1:29:50.17,Default,,0,0,0,,Заңды түрде пайдаланылған идентификаторлардың трафигі—
Dialogue: 0,1:29:50.30,1:29:52.26,Default,,0,0,0,,Оларды бірінен соң бірін жою...
Dialogue: 0,1:29:52.38,1:29:55.43,Default,,0,0,0,,Қалған нәрсе - сәйкес келмейтін идентификатор.
Dialogue: 0,1:29:56.59,1:29:58.97,Default,,0,0,0,,Оларды белгілеу арқылы экранға шығарыңыз—
Dialogue: 0,1:29:59.60,1:30:02.27,Default,,0,0,0,,Олардың қозғалысы пайда болды.
Dialogue: 0,1:30:08.94,1:30:11.48,Default,,0,0,0,,Олар шындықты айтты
Dialogue: 0,1:30:11.94,1:30:15.11,Default,,0,0,0,,Шынымен... шындық
Dialogue: 0,1:30:15.99,1:30:17.49,Default,,0,0,0,,Жоспарланған жерге келу
Dialogue: 0,1:30:17.74,1:30:20.79,Default,,0,0,0,,Pod 30 секундтан кейін жою режиміне өтеді
Dialogue: 0,1:30:20.91,1:30:23.50,Default,,0,0,0,,Экипаж сүңгуге дайындалуы керек
Dialogue: 0,1:31:25.56,1:31:29.48,Default,,0,0,0,,Мен сыртта керемет өмір сүретін адамдарды көргенде...
Dialogue: 0,1:31:29.60,1:31:31.27,Default,,0,0,0,,Бұл әлі де ауырады...
Dialogue: 0,1:31:31.40,1:31:33.27,Default,,0,0,0,,Уайымдамаңыз, Пол ханым
Dialogue: 0,1:31:33.40,1:31:36.57,Default,,0,0,0,,Иә... Мұны естігеніме қуаныштымын.
Dialogue: 0,1:31:37.24,1:31:38.82,Default,,0,0,0,,Қайырлы түн Мугабе
Dialogue: 0,1:31:38.95,1:31:40.57,Default,,0,0,0,,Қайырлы түн ханым
Dialogue: 0,1:31:45.70,1:31:46.87,Default,,0,0,0,,Люсия…
Dialogue: 0,1:32:32.83,1:32:33.75,Default,,0,0,0,,Хмм...
Dialogue: 0,1:32:39.30,1:32:40.59,Default,,0,0,0,,Бұл...
Dialogue: 0,1:32:41.76,1:32:42.84,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,1:32:42.97,1:32:45.68,Default,,0,0,0,,Massacre редакторы...
Dialogue: 0,1:32:48.43,1:32:52.19,Default,,0,0,0,,Сіз бұл жолы уақытында орындадыңыз, Ассасин мырза.
Dialogue: 0,1:32:53.19,1:32:56.82,Default,,0,0,0,,Мұндағы егіс енді ғана басталды.
Dialogue: 0,1:32:56.94,1:32:59.32,Default,,0,0,0,,Бұл Браунинг периодтық шығармасы ма?
Dialogue: 0,1:32:59.74,1:33:04.70,Default,,0,0,0,,Кез келген адам қолдана алатын және жеке куәліксіз кез келген адамды өлтіретін мылтық
Dialogue: 0,1:33:05.24,1:33:08.04,Default,,0,0,0,,Негізі мен оны бүгін кешке бірінші рет алдым.
Dialogue: 0,1:33:08.83,1:33:11.41,Default,,0,0,0,,Мен одан белсенді түрде аулақ болдым.
Dialogue: 0,1:33:11.96,1:33:15.63,Default,,0,0,0,,Дұрыс, қолдарыңызды лас ұстайсыздар...
Dialogue: 0,1:33:15.75,1:33:19.38,Default,,0,0,0,,Көп адамды союға күші бар.
Dialogue: 0,1:33:19.88,1:33:22.22,Default,,0,0,0,,Мен оны жаңа ғана таптым
Dialogue: 0,1:33:22.47,1:33:25.85,Default,,0,0,0,,Қатыгездік адам миына енді.
Dialogue: 0,1:33:26.47,1:33:29.10,Default,,0,0,0,,Осындай геноцидтік сөзді тәрбиелемесең де...
Dialogue: 0,1:33:29.22,1:33:30.43,Default,,0,0,0,,Адам миы –
Dialogue: 0,1:33:30.56,1:33:34.48,Default,,0,0,0,,Оның ішінде өлтіру, ұрлау және қылмыс жасау мүмкіндігі бар.
Dialogue: 0,1:33:34.73,1:33:36.56,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,1:33:36.69,1:33:41.57,Default,,0,0,0,,Мен сені дәл қазір өлтіргім келіп тұрған сияқты.
Dialogue: 0,1:33:41.69,1:33:44.24,Default,,0,0,0,,Бірақ тонау мен зорлау...
Dialogue: 0,1:33:44.36,1:33:47.33,Default,,0,0,0,,Егер ол өмір сүру қажеттілігінен туындаса -
Dialogue: 0,1:33:47.45,1:33:49.49,Default,,0,0,0,,Басқаларды ойлаңыз, басқаларды жақсы көріңіз -
Dialogue: 0,1:33:50.08,1:33:52.87,Default,,0,0,0,,Өзін басқалар үшін құрбан ету -
Dialogue: 0,1:33:53.00,1:33:55.96,Default,,0,0,0,,Эволюциялық қажеттіліктермен жасалған болуы керек.
Dialogue: 0,1:33:57.04,1:33:59.67,Default,,0,0,0,,Иә... кейбіріміз—
Dialogue: 0,1:33:59.80,1:34:01.84,Default,,0,0,0,,Бәсекелес эмоция модульдері...
Dialogue: 0,1:34:01.96,1:34:03.51,Default,,0,0,0,,Бірнеше бар.
Dialogue: 0,1:34:04.76,1:34:06.47,Default,,0,0,0,,Және олардың арасында -
Dialogue: 0,1:34:06.59,1:34:08.93,Default,,0,0,0,,Енді бұл маған мүлдем керек емес...
Dialogue: 0,1:34:09.06,1:34:11.52,Default,,0,0,0,,Кейбір функциялар әлі де сақталады.
Dialogue: 0,1:34:12.98,1:34:15.31,Default,,0,0,0,,Құрғақшылық болды делік.
Dialogue: 0,1:34:15.44,1:34:19.61,Default,,0,0,0,,Бұл адамдар әлі егіншілікпен айналыспаған кездегі оқиға.
Dialogue: 0,1:34:19.82,1:34:24.74,Default,,0,0,0,,Адамдардың топ құрып, бір-біріне көмектесіп, бірігіп жұмыс істегені жақсы.
Dialogue: 0,1:34:24.86,1:34:29.03,Default,,0,0,0,,Сатқындық жасап, қашқанша, тұрақты өмір сүрген артық екенін білдім.
Dialogue: 0,1:34:29.33,1:34:31.62,Default,,0,0,0,,Тіршілікке бейімделу…
Dialogue: 0,1:34:31.74,1:34:34.75,Default,,0,0,0,,Бірақ олай дүбірлеген ауыл...
Dialogue: 0,1:34:34.87,1:34:36.29,Default,,0,0,0,,Құрғақшылықтан зардап шегу —
Dialogue: 0,1:34:36.42,1:34:40.54,Default,,0,0,0,,Халқымызды асырауға азық-түлік жетпей қалды делік.
Dialogue: 0,1:34:41.09,1:34:44.63,Default,,0,0,0,,Альтруистік рухқа толы бұл жиынмен не істеуіміз керек?
Dialogue: 0,1:34:44.76,1:34:46.43,Default,,0,0,0,,Өлуден басқа амал жоқ па?
Dialogue: 0,1:34:48.76,1:34:51.35,Default,,0,0,0,,Ха... Геноцид грамматикасы — бұл—
Dialogue: 0,1:34:51.47,1:34:54.56,Default,,0,0,0,,Бұл азық-түлік тапшылығына бейімделу болды ма?
Dialogue: 0,1:34:54.85,1:34:58.65,Default,,0,0,0,,Иә, геноцид грамматикасы адамзат әлі де...
Dialogue: 0,1:34:58.77,1:35:02.02,Default,,0,0,0,,Бұл азық-түлік өндірісін бақылау мүмкін болмаған заманның қалдығы.
Dialogue: 0,1:35:02.15,1:35:03.48,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:35:03.61,1:35:09.12,Default,,0,0,0,,Геноцид жүргізіліп, халық саны азайып, азық-түлік қауіпсіздігі тұрақты болады.
Dialogue: 0,1:35:09.24,1:35:12.87,Default,,0,0,0,,Осы мақсатта олар геноцидке төзетін көңіл-күй тудырды.
Dialogue: 0,1:35:12.99,1:35:17.42,Default,,0,0,0,,Ар-ұжданды бүркемелеу шын мәнінде адамның өмір сүруіне пайдалы.
Dialogue: 0,1:35:17.54,1:35:20.00,Default,,0,0,0,,Осылайша кедейлер еліне айналды.
Dialogue: 0,1:35:20.13,1:35:21.71,Default,,0,0,0,,Ұшқын себу үшін айналып өтуге себеп пе?
Dialogue: 0,1:35:22.34,1:35:26.30,Default,,0,0,0,,Адамдардың табиғатынан қатыгез екенін дәлелдеуді жалғастыру
Dialogue: 0,1:35:26.51,1:35:28.80,Default,,0,0,0,,Осыны қалайсыз ба?
Dialogue: 0,1:35:29.55,1:35:31.10,Default,,0,0,0,,Бұл менің кінәм!
Dialogue: 0,1:35:31.76,1:35:32.60,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:33.39,1:35:36.27,Default,,0,0,0,,Сараево қаласы жоғалып кеткен кезде —
Dialogue: 0,1:35:36.52,1:35:39.60,Default,,0,0,0,,Сіз өзіңізді кешіре алмадыңыз
Dialogue: 0,1:35:39.90,1:35:41.19,Default,,0,0,0,,Люсия
Dialogue: 0,1:35:42.86,1:35:45.23,Default,,0,0,0,,Сондықтан сатқындық пен зорлық...
Dialogue: 0,1:35:45.36,1:35:48.82,Default,,0,0,0,,Сіз оны адам бойындағы бұлтартпас табиғат деп түсінуге тырыстыңыз.
Dialogue: 0,1:35:48.95,1:35:52.49,Default,,0,0,0,,Ол адамдардың қараңғылығын дәлелдеуде!
Dialogue: 0,1:35:52.74,1:35:55.04,Default,,0,0,0,,Күнәдан құтылу
Dialogue: 0,1:35:55.24,1:35:57.37,Default,,0,0,0,,Бұл дұрыс емес, Лузия.
Dialogue: 0,1:35:58.00,1:36:02.67,Default,,0,0,0,,Мен мұны бір нәрсені дәлелдеу үшін жасап отырған жоқпын.
Dialogue: 0,1:36:02.79,1:36:04.88,Default,,0,0,0,,Сонда ше?
Dialogue: 0,1:36:05.21,1:36:08.76,Default,,0,0,0,,Мен адамның ескі функциясын аштым
Dialogue: 0,1:36:08.88,1:36:12.72,Default,,0,0,0,,Бірақ сонымен бірге мен көршімді жақсы көремін...
Dialogue: 0,1:36:12.85,1:36:16.72,Default,,0,0,0,,Адамның жабайылығы сияқты... жоқ, одан да көп...
Dialogue: 0,1:36:16.85,1:36:20.56,Default,,0,0,0,,Бұл функцияның биологиялық негізі бар екенін білемін.
Dialogue: 0,1:36:21.15,1:36:23.40,Default,,0,0,0,,Геноцидтік органды қайдан таптық
Dialogue: 0,1:36:23.52,1:36:27.86,Default,,0,0,0,,Мен бұл адамның табиғаты екенінен үміт үзбеймін.
Dialogue: 0,1:36:27.99,1:36:29.90,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:36:30.15,1:36:32.49,Default,,0,0,0,,Егер сен мені үмітсіздіктен өлтіріп жатпасаң...
Dialogue: 0,1:36:32.62,1:36:34.41,Default,,0,0,0,,Басқа қандай себеп бар!
Dialogue: 0,1:36:44.92,1:36:47.30,Default,,0,0,0,,Өзің жақсы көретін адамдарды қорғау
Dialogue: 0,1:36:47.76,1:36:48.80,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:36:56.10,1:37:00.23,Default,,0,0,0,,Әйелім мен баламнан айырылғанда, шешім қабылдадым.
Dialogue: 0,1:37:00.73,1:37:03.85,Default,,0,0,0,,Мен бұл мұңды көрдім деп ойлаймын.
Dialogue: 0,1:37:04.61,1:37:06.40,Default,,0,0,0,,Қайғыға не себеп болады:
Dialogue: 0,1:37:06.52,1:37:08.23,Default,,0,0,0,,Сіз емес!
Dialogue: 0,1:37:08.36,1:37:10.32,Default,,0,0,0,,Көп адам өлсін -
Dialogue: 0,1:37:10.53,1:37:13.20,Default,,0,0,0,,Барлық жерде қайғыдан басқа ештеңе жоқ!
Dialogue: 0,1:37:13.32,1:37:17.33,Default,,0,0,0,,Бірақ бұл адамдар көрмейтін мұң.
Dialogue: 0,1:37:18.74,1:37:21.16,Default,,0,0,0,,Адамдар тек көргісі келетін нәрсені көреді
Dialogue: 0,1:37:21.29,1:37:22.29,Default,,0,0,0,,Хмм...
Dialogue: 0,1:37:24.67,1:37:28.46,Default,,0,0,0,,Дүниенің қандай қасіретпен қапталғаны маған бәрібір.
Dialogue: 0,1:37:28.88,1:37:31.34,Default,,0,0,0,,Бірақ мен өскен дүние.
Dialogue: 0,1:37:31.47,1:37:32.22,Default,,0,0,0,,Ха...
Dialogue: 0,1:37:32.47,1:37:35.05,Default,,0,0,0,,Starbucks-қа барыңыз және Amazon-да дүкен жасаңыз—
Dialogue: 0,1:37:35.18,1:37:37.22,Default,,0,0,0,,Тек көргіңіз келетін нәрсені көру арқылы өмір сүріңіз
Dialogue: 0,1:37:37.35,1:37:40.22,Default,,0,0,0,,Мен сондай құлаған дүниені жақсы көремін...
Dialogue: 0,1:37:40.68,1:37:43.48,Default,,0,0,0,,Онда тұратын адамдарды құрметте
Dialogue: 0,1:37:44.27,1:37:45.73,Default,,0,0,0,,Өркениет дегеніміз...
Dialogue: 0,1:37:46.52,1:37:48.98,Default,,0,0,0,,Ар-ождан нәзік және оңай жойылады.
Dialogue: 0,1:37:50.19,1:37:51.36,Default,,0,0,0,,Жалпы өркениет—
Dialogue: 0,1:37:51.49,1:37:56.45,Default,,0,0,0,,Өзгенің бақытын тілеу бағытында ілгерілеп келеміз, бірақ ол әлі де аз.
Dialogue: 0,1:37:57.07,1:37:59.87,Default,,0,0,0,,Нағыз үмітсіздіктен туындайтын терроризм...
Dialogue: 0,1:37:59.99,1:38:03.79,Default,,0,0,0,,Бұл қадағалану қаупін елемейтін суицидтік әрекет.
Dialogue: 0,1:38:04.54,1:38:06.67,Default,,0,0,0,,Қоғамның үмітсіздігінен туындайтын нәрсе—
Dialogue: 0,1:38:06.79,1:38:08.88,Default,,0,0,0,,Жеке аутентификация қауіпсіздігі және т.б.
Dialogue: 0,1:38:09.00,1:38:11.51,Default,,0,0,0,,Оны жүйемен азайту мүмкін емес.
Dialogue: 0,1:38:12.51,1:38:14.76,Default,,0,0,0,,Мен ойладым
Dialogue: 0,1:38:15.34,1:38:18.76,Default,,0,0,0,,Олар бізді өлтіруді ойламас бұрын
Dialogue: 0,1:38:18.89,1:38:21.52,Default,,0,0,0,,Өз шеңберлерінде бірін-бірі өлтірсін.
Dialogue: 0,1:38:21.81,1:38:22.93,Default,,0,0,0,,Ах...
Dialogue: 0,1:38:23.06,1:38:27.52,Default,,0,0,0,,Бұл олардың әлемін біздікінен ажыратады.
Dialogue: 0,1:38:28.36,1:38:30.82,Default,,0,0,0,,Бірін-бірі өлтіретін және жек көретін әлем —
Dialogue: 0,1:38:31.19,1:38:32.82,Default,,0,0,0,,Бейбіт әлем үшін
Dialogue: 0,1:38:33.57,1:38:34.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:38:35.32,1:38:38.16,Default,,0,0,0,,Бір-бірін өздері өлтірсін
Dialogue: 0,1:38:38.87,1:38:42.04,Default,,0,0,0,,Біздің әлемге саусақ тиіп кетпесін
Dialogue: 0,1:38:44.04,1:38:47.21,Default,,0,0,0,,Терең грамматиканың құрылымының өзі анық.
Dialogue: 0,1:38:48.13,1:38:51.67,Default,,0,0,0,,Әр аймақтың тіліне қарай аударсаңыз...
Dialogue: 0,1:38:51.80,1:38:55.97,Default,,0,0,0,,Бір тілдік аймақпен және оның айналасымен шектелген тиімді аймақ
Dialogue: 0,1:38:56.55,1:39:01.68,Default,,0,0,0,,Ағылшын тілінде сөйлесу туралы ойламасаңыз, масштабты реттеу оңай.
Dialogue: 0,1:39:01.89,1:39:04.18,Default,,0,0,0,,Өтінемін, Джон, мылтықты қойыңыз.
Dialogue: 0,1:39:04.68,1:39:06.85,Default,,0,0,0,,Сіз оны қазір міндетті түрде түсіре аласыз
Dialogue: 0,1:39:07.44,1:39:09.02,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,1:39:09.48,1:39:10.69,Default,,0,0,0,,О Люсия
Dialogue: 0,1:39:10.98,1:39:15.53,Default,,0,0,0,,Осылайша сіз өз күнәларыңыз үшін жауап бересіз.
Dialogue: 0,1:39:23.54,1:39:24.95,Default,,0,0,0,,Епископ
Dialogue: 0,1:39:25.70,1:39:28.21,Default,,0,0,0,,Сіздің шын есіміңіз кім?
Dialogue: 0,1:39:29.50,1:39:32.96,Default,,0,0,0,,Клавис Шепард, барлау күштерінің капитаны.
Dialogue: 0,1:39:33.96,1:39:37.22,Default,,0,0,0,,Клавис, мына адамды қамауға ал.
Dialogue: 0,1:39:38.72,1:39:41.68,Default,,0,0,0,,Оны Америкаға қайтарып, сот алдында жауап беріңіз.
Dialogue: 0,1:39:41.89,1:39:44.97,Default,,0,0,0,,Әркім білуі керек, білуге міндетті...
Dialogue: 0,1:39:45.27,1:39:48.81,Default,,0,0,0,,Біз өз таңдауымыздың нәтижесінде пайда болатын еркіндікке ие болуымыз керек.
Dialogue: 0,1:39:50.23,1:39:52.98,Default,,0,0,0,,Мен бұл адамды өлтіріп, оны аяқтасам...
Dialogue: 0,1:39:53.11,1:39:55.57,Default,,0,0,0,,Қанды қырғында қаза тапқандардың барлығы...
Dialogue: 0,1:39:55.69,1:39:58.65,Default,,0,0,0,,Біз сені аңдып қаламыз.
Dialogue: 0,1:39:59.28,1:40:01.87,Default,,0,0,0,,Мұның өзі мүлдем қабылданбайды.
Dialogue: 0,1:40:02.53,1:40:03.87,Default,,0,0,0,,Люсия…
Dialogue: 0,1:40:11.17,1:40:12.38,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:40:13.96,1:40:15.88,Default,,0,0,0,,Джонды алыңыз... (Мылтық дыбысы)
Dialogue: 0,1:40:21.55,1:40:22.39,Default,,0,0,0,,Люсия…
Dialogue: 0,1:40:22.68,1:40:24.39,Default,,0,0,0,,Уау! (мылтық дыбысы)
Dialogue: 0,1:40:24.68,1:40:25.85,Default,,0,0,0,,Уф... эй
Dialogue: 0,1:40:29.35,1:40:30.52,Default,,0,0,0,,Уф
Dialogue: 0,1:40:31.65,1:40:32.69,Default,,0,0,0,,Гррр…
Dialogue: 0,1:40:33.48,1:40:35.36,Default,,0,0,0,,Мен оның өлмегеніне қуаныштымын!
Dialogue: 0,1:40:35.77,1:40:38.53,Default,,0,0,0,,Ешкімді өлтірудің қажеті жоқ!
Dialogue: 0,1:40:39.45,1:40:40.99,Default,,0,0,0,,Неге мені өлтірдің!?
Dialogue: 0,1:40:41.11,1:40:43.37,Default,,0,0,0,,Монитор мен нәресте үшін!
Dialogue: 0,1:40:43.95,1:40:46.12,Default,,0,0,0,,Бұл дүние қандай сұмдық?
Dialogue: 0,1:40:46.24,1:40:47.70,Default,,0,0,0,,Оған білудің қажеті жоқ!
Dialogue: 0,1:40:47.83,1:40:50.25,Default,,0,0,0,,Бұл дүние тозақ үстінде қалқып тұр...
Dialogue: 0,1:40:50.37,1:40:53.08,Default,,0,0,0,,Сәбиге білмей, өсе бер!
Dialogue: 0,1:40:54.08,1:40:56.34,Default,,0,0,0,,Мен өз әлемімді қорғаймын!
Dialogue: 0,1:40:56.46,1:40:59.13,Default,,0,0,0,,Жарайды, мен жалапеньо пиццасына тапсырыс бердім.
Dialogue: 0,1:40:59.26,1:41:01.55,Default,,0,0,0,,Аутентификация арқылы алатын әлемді қорғаңыз!
Dialogue: 0,1:41:01.68,1:41:05.89,Default,,0,0,0,,Ол адамдар барлық Big Mac компьютерлерін жей алмайтын және оларды қоқыс жәшігіне лақтыра алмайтын әлемді қорғайтынын айтты!
Dialogue: 0,1:41:06.01,1:41:08.35,Default,,0,0,0,,Люсияға өлудің қажеті жоқ еді!
Dialogue: 0,1:41:08.47,1:41:10.43,Default,,0,0,0,,Осы жерде өлуің керек!
Dialogue: 0,1:41:10.56,1:41:11.39,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:17.11,1:41:18.90,Default,,0,0,0,,Клавис, сабыр ет!
Dialogue: 0,1:41:19.03,1:41:22.15,Default,,0,0,0,,Біз қауіпсіздік құрылымын бұзу үшін бірге жұмыс істеуіміз керек!
Dialogue: 0,1:41:22.28,1:41:25.87,Default,,0,0,0,,Мен сені өлтіріп, мәйітпен жұмыс істеймін!
Dialogue: 0,1:41:25.99,1:41:30.87,Default,,0,0,0,,Тыңдаңыз, өлтіру туралы бұйрық берілді, сіз жай ғана білмедіңіз.
Dialogue: 0,1:41:31.12,1:41:32.87,Default,,0,0,0,,Неге!? Қарғыс атқыр...
Dialogue: 0,1:41:36.75,1:41:37.59,Default,,0,0,0,,Уф...
Dialogue: 0,1:41:37.71,1:41:38.88,Default,,0,0,0,,Мен оны қазір тоқтата алмаймын!
Dialogue: 0,1:41:40.13,1:41:44.89,Default,,0,0,0,,Халық қалаған, ел қалаған, компаниялар қалағандықтан басталды.
Dialogue: 0,1:41:45.43,1:41:47.39,Default,,0,0,0,,Осы мақсат үшін құрылған инфрақұрылым –
Dialogue: 0,1:41:48.56,1:41:51.77,Default,,0,0,0,,Сіз бәрін пааға айналдыруды жоспарлап отырсыз ба?!
Dialogue: 0,1:41:54.44,1:41:55.90,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:41:56.65,1:42:00.40,Default,,0,0,0,,Мұның бәрі өтірік!
Dialogue: 0,1:42:00.65,1:42:02.90,Default,,0,0,0,,Өтірік пе, өтірік пе...
Dialogue: 0,1:42:03.03,1:42:06.82,Default,,0,0,0,,Қазірдің өзінде жұмыс істеп тұрған экономика сөзсіз нақты!
Dialogue: 0,1:42:06.82,1:42:07.95,Default,,0,0,0,,Қазірдің өзінде жұмыс істеп тұрған экономика нақты!
Dialogue: 0,1:42:06.82,1:42:07.95,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:42:08.53,1:42:09.37,Default,,0,0,0,,Уф...
Dialogue: 0,1:42:09.49,1:42:11.41,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:42:11.70,1:42:13.00,Default,,0,0,0,,Уф...
Dialogue: 0,1:42:29.30,1:42:31.31,Default,,0,0,0,,Ах! Гу…
Dialogue: 0,1:42:32.27,1:42:33.93,Default,,0,0,0,,Уф... (мылтық дыбысы)
Dialogue: 0,1:42:35.39,1:42:36.19,Default,,0,0,0,,Жүгірейік!
Dialogue: 0,1:42:36.31,1:42:37.90,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:42:38.02,1:42:38.86,Default,,0,0,0,,(Шетелдік жауынгерлердің айқайы)
Dialogue: 0,1:42:38.86,1:42:40.36,Default,,0,0,0,,(Шетелдік солдаттардың айқайы)
Dialogue: 0,1:42:38.86,1:42:40.36,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:42:40.36,1:42:42.82,Default,,0,0,0,,(Шетелдік солдаттардың айқайы)
Dialogue: 0,1:42:43.15,1:42:48.82,Default,,0,0,0,,(шетел тілінде сөйлейді)
Dialogue: 0,1:43:05.55,1:43:07.93,Default,,0,0,0,,Мен оны тастап кеттім.
Dialogue: 0,1:43:08.55,1:43:10.55,Default,,0,0,0,,Оның мәйіті...
Dialogue: 0,1:43:10.93,1:43:12.85,Default,,0,0,0,,Уф... аа...
Dialogue: 0,1:43:14.14,1:43:15.89,Default,,0,0,0,,Бұл ерікті.
Dialogue: 0,1:43:16.39,1:43:20.48,Default,,0,0,0,,Сүйген адамның мәйіті зат сияқты емес.
Dialogue: 0,1:43:21.02,1:43:22.02,Default,,0,0,0,,Уф...
Dialogue: 0,1:43:23.86,1:43:26.65,Default,,0,0,0,,Мен Сараевода әйелім мен баламнан айырылғанда —
Dialogue: 0,1:43:26.78,1:43:30.95,Default,,0,0,0,,Люсия бұл сөзді мен өзімді жоғалтып алайын деп тұрғанда айтты.
Dialogue: 0,1:43:33.66,1:43:38.67,Default,,0,0,0,,«Егер сөз адамдарды анықтау күші болса, онда әлем...»
Dialogue: 0,1:43:38.79,1:43:43.38,Default,,0,0,0,,«Мен әлемді кенеттен біреуді жоғалтпайтын жерге өзгерткім келеді».
Dialogue: 0,1:43:46.38,1:43:48.34,Default,,0,0,0,,Мен еш өкінбеймін
Dialogue: 0,1:43:49.18,1:43:51.89,Default,,0,0,0,,Өмірімді таразыға салдым
Dialogue: 0,1:43:52.30,1:43:54.89,Default,,0,0,0,,Біздің әлемдегі адам өмірі және—
Dialogue: 0,1:43:55.43,1:44:00.02,Default,,0,0,0,,Кедей және жау елдегі адам өмірі
Dialogue: 0,1:44:00.85,1:44:05.15,Default,,0,0,0,,Арқама қанша өмір жабысады?
Dialogue: 0,1:44:05.28,1:44:09.20,Default,,0,0,0,,Бұл да мен анық түсініп жасаған таңдауым болды.
Dialogue: 0,1:44:11.70,1:44:14.53,Default,,0,0,0,,Сіз не істей алатыныңызды білгеннен кейін—
Dialogue: 0,1:44:15.16,1:44:18.16,Default,,0,0,0,,Одан қашып құтыла алмайсың
Dialogue: 0,1:44:22.29,1:44:23.96,Default,,0,0,0,,Біз қазір не істейміз?
Dialogue: 0,1:44:24.42,1:44:29.55,Default,,0,0,0,,Люсия мен әлемге не істегенімді түсіндіруім керек деді.
Dialogue: 0,1:44:29.97,1:44:33.60,Default,,0,0,0,,Мен Люсияның қалағанын орындаймын деп ойлаймын.
Dialogue: 0,1:44:33.72,1:44:37.52,Default,,0,0,0,,Бұл менің ол үшін өтеуім.
Dialogue: 0,1:44:40.89,1:44:45.73,Default,,0,0,0,,Бірақ біздің әлем бұған жол бермейді.
Dialogue: 0,1:44:46.94,1:44:49.44,Default,,0,0,0,,Сіздің жолдасыңыз айтқандай-
Dialogue: 0,1:44:49.57,1:44:53.82,Default,,0,0,0,,Туған жерге қолайсыздық тудыратын шығармын.
Dialogue: 0,1:44:53.95,1:44:57.29,Default,,0,0,0,,Сонымен Люсия нені қалайды...
Dialogue: 0,1:45:01.46,1:45:03.25,Default,,0,0,0,,Бір жауап бар.
Dialogue: 0,1:45:03.38,1:45:04.38,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:05.25,1:45:08.13,Default,,0,0,0,,Егер сіз болсаңыз... жоқ—
Dialogue: 0,1:45:09.01,1:45:10.92,Default,,0,0,0,,Мұны тек сіз жасай аласыз
Dialogue: 0,1:45:13.80,1:45:15.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:19.73,1:45:20.73,Default,,0,0,0,,Иә
Dialogue: 0,1:45:25.65,1:45:26.65,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:45:43.83,1:45:44.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:51.63,1:45:55.64,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,1:45:57.89,1:46:00.81,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:46:04.14,1:46:06.40,Default,,0,0,0,,Қажырлы еңбегіңіз үшін рахмет, капитан Шепард.
Dialogue: 0,1:46:06.69,1:46:09.78,Default,,0,0,0,,Операция аяқталды... солай ма?
Dialogue: 0,1:46:15.61,1:46:17.03,Default,,0,0,0,,Уильямс туралы не деуге болады?
Dialogue: 0,1:46:17.62,1:46:19.33,Default,,0,0,0,,Өлген сияқты.
Dialogue: 0,1:46:20.12,1:46:24.16,Default,,0,0,0,,NSA тобы ұстаған радио ақпараты.
Dialogue: 0,1:46:25.33,1:46:28.96,Default,,0,0,0,,(Көлікке отырған дыбыс)
Dialogue: 0,1:46:29.09,1:46:30.25,Default,,0,0,0,,Хмм...
Dialogue: 0,1:46:32.88,1:46:36.55,Default,,0,0,0,,(Жан) Д… Жоқ, басқа нәрсе. Қара, ол сонда тұр.
Dialogue: 0,1:46:36.68,1:46:37.59,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:46:37.72,1:46:38.80,Default,,0,0,0,,Иә
Dialogue: 0,1:47:08.83,1:47:12.71,Default,,0,0,0,,Соғыс спектакль ретінде әрқашан қажет.
Dialogue: 0,1:47:13.00,1:47:15.59,Default,,0,0,0,,Бір жерде соғыс жүріп жатыр.
Dialogue: 0,1:47:16.51,1:47:19.26,Default,,0,0,0,,Әсіресе маған еш қатысы жоқ жерде—
Dialogue: 0,1:47:19.39,1:47:22.60,Default,,0,0,0,,Сұрапыл соғыс жүріп жатыр.
Dialogue: 0,1:47:23.10,1:47:27.39,Default,,0,0,0,,Басқаша айтқанда, оны білу және оған куә болу арқылы ...
Dialogue: 0,1:47:27.64,1:47:31.36,Default,,0,0,0,,Алғаш рет өзіңізді анықтай аласыз.
Dialogue: 0,1:47:34.61,1:47:36.90,Default,,0,0,0,,Капитан Клавис Шепард
Dialogue: 0,1:47:38.91,1:47:41.24,Default,,0,0,0,,Қастандық жасаған құпия бөлімшенің мүшелері —
Dialogue: 0,1:47:41.37,1:47:45.33,Default,,0,0,0,,Клавис Шепардқа айып тағылу керек еді.
Dialogue: 0,1:47:45.45,1:47:49.17,Default,,0,0,0,,Ал... Мен Джонға берген уәдемді орындаймын.
Dialogue: 0,1:47:50.08,1:47:52.13,Default,,0,0,0,,Менің айтқаныма байланысты
Dialogue: 0,1:47:52.25,1:47:54.30,Default,,0,0,0,,21 ғасырдың басынан бастап Вашингтон—
Dialogue: 0,1:47:54.42,1:47:56.80,Default,,0,0,0,,Жанжалға түседі
Dialogue: 0,1:47:57.38,1:48:00.64,Default,,0,0,0,,Бірақ қазір үкіметті сынайтындар да —
Dialogue: 0,1:48:01.14,1:48:03.93,Default,,0,0,0,,Бұл ел тағы да терроризмнің нысанасына айналғанда —
Dialogue: 0,1:48:04.31,1:48:06.68,Default,,0,0,0,,Біз сол көзқарасты сақтай аламыз ба?
Dialogue: 0,1:48:08.27,1:48:11.44,Default,,0,0,0,,Ол менің аяғымды шайқағанда
Dialogue: 0,1:48:11.69,1:48:14.07,Default,,0,0,0,,Адамдар жүректерін жауып тастай бастайды
Dialogue: 0,1:48:14.52,1:48:18.99,Default,,0,0,0,,Өзіңіздің басқаларға ыңғайсыздануға мүмкіндік бере бастаңыз
Dialogue: 0,1:48:19.40,1:48:19.95,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:48:19.95,1:48:22.32,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:48:19.95,1:48:22.32,Default,,0,0,0,,Енді ойлаймын
Dialogue: 0,1:48:22.70,1:48:24.70,Default,,0,0,0,,Джон Павел де —
Dialogue: 0,1:48:24.83,1:48:27.58,Default,,0,0,0,,Ол жай ғана Кафка сарайының тұрғыны еді.
Dialogue: 0,1:48:28.21,1:48:30.67,Default,,0,0,0,,Саяхатқа қанат қағып, қамалды қорғауға тырысқан тұрғынға...
Dialogue: 0,1:48:30.67,1:48:32.96,Default,,0,0,0,,Саяхатқа қанат қағып, қамалды қорғауға тырысқан тұрғынға...
Dialogue: 0,1:48:30.67,1:48:32.96,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:48:32.96,1:48:34.13,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:48:34.13,1:48:35.67,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:48:34.13,1:48:35.67,Default,,0,0,0,,Егер сіз сыртқа шықсаңыз—
Dialogue: 0,1:48:35.67,1:48:35.80,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:48:35.80,1:48:36.67,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:48:35.80,1:48:36.67,Default,,0,0,0,,Бұл үмітсіз дүние өзгерсе де
Dialogue: 0,1:48:36.67,1:48:38.63,Default,,0,0,0,,Бұл үмітсіз дүние өзгерсе де
Dialogue: 0,1:48:40.09,1:48:42.76,Default,,0,0,0,,Күнәнің ауыртпалығын көтеруді шештім.
Dialogue: 0,1:48:43.51,1:48:45.85,Default,,0,0,0,,Мен өзімді жазалаймын деп шештім.
Dialogue: 0,1:48:46.85,1:48:49.23,Default,,0,0,0,,Жүрек жабылмас бұрын
Dialogue: 0,1:48:49.64,1:48:52.27,Default,,0,0,0,,Сіз ессіз қалмас бұрын...
Dialogue: 0,1:48:54.44,1:48:57.23,Default,,0,0,0,,Өкінішке орай, Джон үшін бұл...
Dialogue: 0,1:48:57.36,1:49:00.86,Default,,0,0,0,,Өйткені бұл Люсияға берген уәдемді орындау екенін түсіндім.
Dialogue: 0,1:49:01.99,1:49:05.16,Default,,0,0,0,,Біз ең қымбат адамдарымыздан айырыламыз, бірақ...
Dialogue: 0,1:49:05.41,1:49:09.33,Default,,0,0,0,,Бұл жаңа әлемнің бастамасы болары сөзсіз
Dialogue: 0,1:49:14.21,1:49:17.00,Default,,0,0,0,,Бұл менің оқиғам
Dialogue: 0,1:49:18.30,1:49:19.30,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,1:49:19.76,1:49:24.76,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:54:16.97,1:54:21.98,Default,,0,0,0,,~♪
Dialogue: 0,1:54:23.48,1:54:29.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory