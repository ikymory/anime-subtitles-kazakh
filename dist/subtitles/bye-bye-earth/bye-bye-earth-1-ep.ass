Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:05.50,Default,,0,0,0,,Ха ха ха... неге...
Dialogue: 0,0:00:09.51,0:00:13.51,Default,,0,0,0,,Бұл менің мұғалім ретіндегі соңғы рөлім.
Dialogue: 0,0:00:13.51,0:00:16.51,Default,,0,0,0,,Кеттік, Белл!
Dialogue: 0,0:00:18.51,0:00:20.52,Default,,0,0,0,,Неге...
Dialogue: 0,0:00:36.53,0:00:39.54,Default,,0,0,0,,Мұның бәрі не туралы?
Dialogue: 0,0:00:39.54,0:00:41.54,Default,,0,0,0,,Бұл фестиваль емес, бірақ
Dialogue: 0,0:00:41.54,0:00:45.54,Default,,0,0,0,,Бұл ғалымның үкіміне ұқсамайды...
Dialogue: 0,0:00:45.54,0:00:50.55,Default,,0,0,0,,Уайымдама, өзен көтеріліп жатыр, ағыс келеді.
Dialogue: 0,0:00:50.55,0:00:52.55,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:00:52.55,0:00:56.55,Default,,0,0,0,,Суда гүлдеп, у таратады деп сенемін.
Dialogue: 0,0:00:56.55,0:00:59.56,Default,,0,0,0,,Балық гүлі улы ма? (Оттылар тайпасы) Толқын, толқын
Dialogue: 0,0:00:59.56,0:01:02.56,Default,,0,0,0,,Якко-сан, су, сіз толқынды өзгертуге тырысып жатырсыз.
Dialogue: 0,0:01:02.56,0:01:05.56,Default,,0,0,0,,Қараңдар, жас сиырлар!
Dialogue: 0,0:01:05.56,0:01:07.56,Default,,0,0,0,,Сіз баяғыда жеңіліп қалдыңыз.
Dialogue: 0,0:01:07.56,0:01:09.57,Default,,0,0,0,,Келіңдер, егеуқұйрықтар.
Dialogue: 0,0:01:09.57,0:01:12.57,Default,,0,0,0,,Мен саяхатшыдан сұрауды жөн көрдім.
Dialogue: 0,0:01:12.57,0:01:15.57,Default,,0,0,0,,Хохо Номад Бұл жағдайда...
Dialogue: 0,0:01:15.57,0:01:18.57,Default,,0,0,0,,Міне, көшпендіге ұқсас нәрсе.
Dialogue: 0,0:01:18.57,0:01:21.58,Default,,0,0,0,,Менімен бірге тұратын қызды саған жіберемін.
Dialogue: 0,0:01:21.58,0:01:23.58,Default,,0,0,0,,А... (саудагер) Қызым?
Dialogue: 0,0:01:23.58,0:01:26.58,Default,,0,0,0,,Біртүрлі қауесеттер бар.
Dialogue: 0,0:01:26.58,0:01:29.59,Default,,0,0,0,,Қалада зәр шығарудың зияны көп дейді.
Dialogue: 0,0:01:29.59,0:01:32.59,Default,,0,0,0,,Оны қуып жіберген деген қауесет бар.
Dialogue: 0,0:01:32.59,0:01:36.59,Default,,0,0,0,,Оның үстіне әлгі Энри деген қыз менің көзіме түседі.
Dialogue: 0,0:01:36.59,0:01:40.60,Default,,0,0,0,,Бір нәрсе... Иә? (саудагер) Уау
Dialogue: 0,0:01:40.60,0:01:43.60,Default,,0,0,0,,Бұл толық үй (Аң адам) Бұл не? Бұл...
Dialogue: 0,0:01:43.60,0:01:46.60,Default,,0,0,0,,Құлағы мен мүйізі жоқ (аң адам) Бұл не? Иә
Dialogue: 0,0:01:46.60,0:01:50.61,Default,,0,0,0,,Сондай жарыс болды (Аңдар) Олардың денелерінде түк те жоқ сияқты.
Dialogue: 0,0:01:50.61,0:01:52.61,Default,,0,0,0,,Ештеңе, әлгі жігіт.
Dialogue: 0,0:01:52.61,0:01:55.61,Default,,0,0,0,,Біртүрлі (Педлар) Нопперабу...
Dialogue: 0,0:01:55.61,0:01:57.61,Default,,0,0,0,,Фуфу (саудагер) Ууууу
Dialogue: 0,0:01:57.61,0:01:59.62,Default,,0,0,0,,Әдеттегідей...
Dialogue: 0,0:01:59.62,0:02:02.62,Default,,0,0,0,,Қандай оғаш нәсіл (Аң адам) Олар қайдан шыққан?
Dialogue: 0,0:02:02.62,0:02:04.62,Default,,0,0,0,,《Бір күні...》
Dialogue: 0,0:02:04.62,0:02:07.62,Default,,0,0,0,,Махаббат Қара = Қоңырау! бұл менің атым
Dialogue: 0,0:02:07.62,0:02:10.63,Default,,0,0,0,,Менің қожайыным Лабрак-Сианның бұйрығымен.
Dialogue: 0,0:02:10.63,0:02:12.63,Default,,0,0,0,,Хасесам келді!
Dialogue: 0,0:02:12.63,0:02:15.63,Default,,0,0,0,,Келгеніңізге рахмет, Белл мырза.
Dialogue: 0,0:02:15.63,0:02:19.64,Default,,0,0,0,,Мен Ауа райы сақина мұнарасында сотты басқаратын адаммын.
Dialogue: 0,0:02:19.64,0:02:23.64,Default,,0,0,0,,Танысқаныма қуаныштымын, менің жолдасым қайда?
Dialogue: 0,0:02:23.64,0:02:25.64,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:02:25.64,0:02:27.64,Default,,0,0,0,,Қолдар ағаштың діңінен қалың.
Dialogue: 0,0:02:27.64,0:02:34.65,Default,,0,0,0,,Оның ашық қызыл денесі қылыш пен найзаны қайтарады, ал аузынан қара уды түкіреді.
Dialogue: 0,0:02:34.65,0:02:38.65,Default,,0,0,0,,Менің қожайыным бұл негрони болуы керек деді.
Dialogue: 0,0:02:38.65,0:02:42.66,Default,,0,0,0,,Ал, оның рас па, жоқ па, соны көреміз.
Dialogue: 0,0:02:42.66,0:02:45.66,Default,,0,0,0,,Әй... онда мені құртып жіберіңізші.
Dialogue: 0,0:02:45.66,0:02:48.66,Default,,0,0,0,,Кез келген гүлдің өзегі менің сүйікті тағамым.
Dialogue: 0,0:02:48.66,0:02:51.67,Default,,0,0,0,,Иә... Уайымдама.
Dialogue: 0,0:02:51.67,0:02:54.67,Default,,0,0,0,,Мен сені міндетті түрде жеңемін
Dialogue: 0,0:02:54.67,0:02:57.67,Default,,0,0,0,,Қандай айуандық... Тексеру
Dialogue: 0,0:02:57.67,0:03:01.68,Default,,0,0,0,,Сіз тек шөп пен жеміс-жидек жегеніңіз үшін мені варвар дейсіз бе?
Dialogue: 0,0:03:05.68,0:03:07.68,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:03:07.68,0:03:09.69,Default,,0,0,0,,Мен жеңіл жүрмін.
Dialogue: 0,0:03:09.69,0:03:11.69,Default,,0,0,0,,О, құдайым... (Айуан адам) Әй.
Dialogue: 0,0:03:11.69,0:03:13.69,Default,,0,0,0,,Ноппера Буда
Dialogue: 0,0:03:19.70,0:03:21.70,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:22.70,0:03:24.70,Default,,0,0,0,,О!
Dialogue: 0,0:03:26.70,0:03:28.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:31.71,0:03:33.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:34.71,0:03:36.71,Default,,0,0,0,,Ннн!
Dialogue: 0,0:03:37.71,0:03:40.72,Default,,0,0,0,,N... Ах.
Dialogue: 0,0:03:43.72,0:03:45.72,Default,,0,0,0,,О...!
Dialogue: 0,0:03:47.72,0:03:51.73,Default,,0,0,0,,Қараңдар, келді, келді.
Dialogue: 0,0:03:51.73,0:03:54.73,Default,,0,0,0,,Су әлі суық.
Dialogue: 0,0:03:55.73,0:03:59.74,Default,,0,0,0,,Ах... бұл негрони ғой.
Dialogue: 0,0:03:59.74,0:04:01.74,Default,,0,0,0,,Бұл өте үлкен, бірақ...
Dialogue: 0,0:04:01.74,0:04:03.74,Default,,0,0,0,,(Негронидің айқайы)
Dialogue: 0,0:04:03.74,0:04:06.74,Default,,0,0,0,,Сенің кезегің, жолдасым.
Dialogue: 0,0:04:06.74,0:04:18.75,Default,,0,0,0,,♪♪～
Dialogue: 0,0:04:18.75,0:04:20.76,Default,,0,0,0,,А... нх.
Dialogue: 0,0:04:22.76,0:04:25.76,Default,,0,0,0,,Hmph.
Dialogue: 0,0:04:28.76,0:04:33.77,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:04:33.77,0:04:36.77,Default,,0,0,0,,Ән сал! Лундинг!
Dialogue: 0,0:04:37.77,0:04:40.78,Default,,0,0,0,,Ай!
Dialogue: 0,0:04:40.78,0:04:57.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:04:57.79,0:04:59.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:01.80,0:05:04.80,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:05:04.80,0:05:14.81,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:14.81,0:05:17.81,Default,,0,0,0,,Ха! Ха…
Dialogue: 0,0:05:18.81,0:05:22.82,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:27.82,0:05:31.83,Default,,0,0,0,,Ннн! Ха!
Dialogue: 0,0:05:40.84,0:05:45.84,Default,,0,0,0,,(Негронидің айқайы)
Dialogue: 0,0:05:45.84,0:05:48.84,Default,,0,0,0,,《Бұл теңіздің иісі》
Dialogue: 0,0:05:53.85,0:05:55.85,Default,,0,0,0,,Жаман... (Жыртқыш) Бұл толқын!
Dialogue: 0,0:05:55.85,0:05:57.85,Default,,0,0,0,,Тамақ... (Құбыжық) Жаман.
Dialogue: 0,0:05:57.85,0:05:59.86,Default,,0,0,0,,Орындаңыз! (Айуан адам) Сіз тамақ іше алмайсыз!
Dialogue: 0,0:05:59.86,0:06:02.86,Default,,0,0,0,,Бұл... а
Dialogue: 0,0:06:09.87,0:06:14.87,Default,,0,0,0,,Әй, сен бұл жерге не үшін келдің?
Dialogue: 0,0:06:14.87,0:06:17.87,Default,,0,0,0,,Сенің туған жерің жоқ па?
Dialogue: 0,0:06:17.87,0:06:22.88,Default,,0,0,0,,(Негронидің айқайы)
Dialogue: 0,0:06:22.88,0:06:25.88,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:06:25.88,0:06:28.88,Default,,0,0,0,,《Мен қайтып барғым келеді...теңізге...》
Dialogue: 0,0:06:28.88,0:06:31.89,Default,,0,0,0,,Сонда неге...
Dialogue: 0,0:06:31.89,0:06:33.89,Default,,0,0,0,,《Мен енді қайта алмаймын》
Dialogue: 0,0:06:33.89,0:06:37.89,Default,,0,0,0,,Ха... (Негрони) 《Мен осында өлемін》
Dialogue: 0,0:06:37.89,0:06:40.90,Default,,0,0,0,,《Тұқымдар себу...》
Dialogue: 0,0:06:41.90,0:06:43.90,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:44.90,0:06:46.90,Default,,0,0,0,,(Шиозаки) «Кісі өлтіруші» дегенің не?
Dialogue: 0,0:06:48.90,0:06:53.91,Default,,0,0,0,,(Негронидің айқайы)
Dialogue: 0,0:06:53.91,0:07:13.93,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:13.93,0:07:20.94,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:24.94,0:07:27.94,Default,,0,0,0,,Аа... көп рахмет
Dialogue: 0,0:07:27.94,0:07:32.95,Default,,0,0,0,,Рахмет ретінде мен оны үйге қайта әкелемін.
Dialogue: 0,0:07:32.95,0:07:35.95,Default,,0,0,0,,Бұл түр мен...
Dialogue: 0,0:07:35.95,0:07:37.95,Default,,0,0,0,,Мен оны ала аламын ба?
Dialogue: 0,0:07:37.95,0:07:40.96,Default,,0,0,0,,Сіз мұндай нәрсемен не істер едіңіз?
Dialogue: 0,0:07:40.96,0:07:45.96,Default,,0,0,0,,Жоғарыда айтқанымдай, гүлдің еті – менің сүйікті тағамым.
Dialogue: 0,0:07:45.96,0:07:48.96,Default,,0,0,0,,Эй... (Айуан адам) Мен сенбеймін.
Dialogue: 0,0:07:48.96,0:07:50.97,Default,,0,0,0,,Бести…
Dialogue: 0,0:07:52.97,0:08:05.98,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:05.98,0:08:11.99,Default,,0,0,0,,Мен олар әрбір тұқымды ұсақтайтынына сенімдімін.
Dialogue: 0,0:08:16.99,0:08:22.00,Default,,0,0,0,,Егер мен сенің жаныңда соғысуға тура келсе...
Dialogue: 0,0:08:23.00,0:08:26.00,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:08:39.01,0:08:42.02,Default,,0,0,0,,А... А? (шақпақтастың соғылған дыбысы)
Dialogue: 0,0:08:42.02,0:08:44.02,Default,,0,0,0,,Мен қайтып келдім, ұстаз.
Dialogue: 0,0:08:44.02,0:08:47.02,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:08:48.02,0:08:50.03,Default,,0,0,0,,Көгілдір…
Dialogue: 0,0:08:53.03,0:08:55.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:55.03,0:08:57.03,Default,,0,0,0,,《Неге алаңдау керек?》
Dialogue: 0,0:08:57.03,0:08:59.03,Default,,0,0,0,,《Мен өз сиқырымды қолдансам деп едім》
Dialogue: 0,0:08:59.03,0:09:03.04,Default,,0,0,0,,《Бармасам да, бұл жолы да солай.
Dialogue: 0,0:09:03.04,0:09:07.04,Default,,0,0,0,,Егер бұл көгілдір болса, ол жақсырақ болар еді.
Dialogue: 0,0:09:08.04,0:09:10.05,Default,,0,0,0,,Ой...
Dialogue: 0,0:09:10.05,0:09:12.05,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:12.05,0:09:15.05,Default,,0,0,0,,Иә? Не? Яғни
Dialogue: 0,0:09:15.05,0:09:17.05,Default,,0,0,0,,Соғыс олжасы Хмм
Dialogue: 0,0:09:17.05,0:09:21.06,Default,,0,0,0,,Бұл жақсы қылышпен шабуыл. Әдемі кеседі.
Dialogue: 0,0:09:21.06,0:09:23.06,Default,,0,0,0,,Эххехе Бірақ бәрібір жүзі
Dialogue: 0,0:09:23.06,0:09:26.06,Default,,0,0,0,,Мен бақылап жүргендіктен барымды берген жоқпын.
Dialogue: 0,0:09:26.06,0:09:29.06,Default,,0,0,0,,Оны әрқашан бір серпілуде лақтыра алатыныңызға көз жеткізіңіз.
Dialogue: 0,0:09:29.06,0:09:32.07,Default,,0,0,0,,Айтпақшы, сен мұны не істейсің?
Dialogue: 0,0:09:32.07,0:09:35.07,Default,,0,0,0,,Балық гүлі болуы керек нәрсені же
Dialogue: 0,0:09:35.07,0:09:40.08,Default,,0,0,0,,Мм, өлгендерді жоқтаудың ең жақсы тәсілі - оларды жеу.
Dialogue: 0,0:09:42.08,0:09:46.08,Default,,0,0,0,,Негрони тек целлюлозаға қатысты емес; терісі де қатал.
Dialogue: 0,0:09:46.08,0:09:49.08,Default,,0,0,0,,Ал, мен оны аяқ киімге немесе басқа нәрсеге қолданып көремін деп ойлаймын.
Dialogue: 0,0:09:49.08,0:09:52.09,Default,,0,0,0,,Аанг?
Dialogue: 0,0:09:52.09,0:09:55.09,Default,,0,0,0,,Тағы кездескенше...
Dialogue: 0,0:09:56.09,0:09:58.09,Default,,0,0,0,,Жақсы болды, бұзылды
Dialogue: 0,0:09:58.09,0:10:00.10,Default,,0,0,0,,Дәмге қатысты ерекше айтылады.
Dialogue: 0,0:10:00.10,0:10:04.10,Default,,0,0,0,,Егер сіз соншалықты егжей-тегжейлі болғыңыз келсе, неге оны күнделікті өзіңіз жасауға тырыспасқа?
Dialogue: 0,0:10:04.10,0:10:08.10,Default,,0,0,0,,Хмм... Мен қалжыңдап тұрмын!
Dialogue: 0,0:10:08.10,0:10:10.11,Default,,0,0,0,,Ах... өте жақсы
Dialogue: 0,0:10:10.11,0:10:12.11,Default,,0,0,0,,Я...
Dialogue: 0,0:10:13.11,0:10:17.11,Default,,0,0,0,,Ей, ұстаз, бұл негрони теңізді неге тастап кетті?
Dialogue: 0,0:10:17.11,0:10:21.12,Default,,0,0,0,,Жарайды... теңізді жек көре бастаған шығармын.
Dialogue: 0,0:10:21.12,0:10:24.12,Default,,0,0,0,,Мен теңізге қайта барғым келді.
Dialogue: 0,0:10:24.12,0:10:27.12,Default,,0,0,0,,Бұл жігіт гүлдің тапсырмасын орындамақ болды.
Dialogue: 0,0:10:27.12,0:10:30.13,Default,,0,0,0,,Тұқым себуші ретінде тапсырмаңызды орындаңыз.
Dialogue: 0,0:10:30.13,0:10:32.13,Default,,0,0,0,,Миссия…
Dialogue: 0,0:10:32.13,0:10:34.13,Default,,0,0,0,,Гүлдер ғана емес
Dialogue: 0,0:10:34.13,0:10:39.13,Default,,0,0,0,,Бұл дүниеде бәрі бір-бірімен араласуға тырысады.
Dialogue: 0,0:10:39.13,0:10:41.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:00.16,0:11:02.16,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:03.16,0:11:05.16,Default,,0,0,0,,Иә
Dialogue: 0,0:11:11.17,0:11:13.17,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:13.17,0:11:17.17,Default,,0,0,0,,Менен бәрі қорықты
Dialogue: 0,0:11:17.17,0:11:20.18,Default,,0,0,0,,Барсаң жақсырақ болар едің...
Dialogue: 0,0:11:20.18,0:11:24.18,Default,,0,0,0,,Мен балыққа не үйретемін?
Dialogue: 0,0:11:24.18,0:11:26.18,Default,,0,0,0,,Бұл фанат.
Dialogue: 0,0:11:26.18,0:11:29.18,Default,,0,0,0,,Мен өз күшімді сабақ беруден басқа ештеңеге пайдаланбайтыныма сене алмаймын.
Dialogue: 0,0:11:29.18,0:11:32.19,Default,,0,0,0,,Бұл менің Энола ретіндегі рөлім.
Dialogue: 0,0:11:32.19,0:11:36.19,Default,,0,0,0,,Бұл жерде қайтадан қалу қиын болады, мен сенімдімін...
Dialogue: 0,0:11:36.19,0:11:38.19,Default,,0,0,0,,Олай болса, тез қозғаламыз ба?
Dialogue: 0,0:11:38.19,0:11:41.20,Default,,0,0,0,,Бұл елде сіз әлі бармаған жерлер бар.
Dialogue: 0,0:11:41.20,0:11:44.20,Default,,0,0,0,,Олар өте көп, иә...
Dialogue: 0,0:11:44.20,0:11:47.20,Default,,0,0,0,,Барсам, менімен бір нәсілден адамдар табыла ма?
Dialogue: 0,0:11:47.20,0:11:49.20,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:11:49.20,0:11:51.21,Default,,0,0,0,,Мен бұрын тоқтаған кезде
Dialogue: 0,0:11:51.21,0:11:54.21,Default,,0,0,0,,Сендей ешкім еш жерде болған емес.
Dialogue: 0,0:11:54.21,0:11:57.21,Default,,0,0,0,,Егер сіз осылай істей берсеңіз
Dialogue: 0,0:11:57.21,0:12:00.22,Default,,0,0,0,,Ақырында мені аштық альянсы алып кетеді.
Dialogue: 0,0:12:00.22,0:12:04.22,Default,,0,0,0,,Өзінің қандай екенін де білмейтіндер осылай дейді.
Dialogue: 0,0:12:04.22,0:12:07.22,Default,,0,0,0,,Мен сенің маған не үйреткеніңді білемін.
Dialogue: 0,0:12:07.22,0:12:10.23,Default,,0,0,0,,Сіз бұл дүниеден ләззат ала алмайтын адамдар туралы айтып отырсыз, солай ма?
Dialogue: 0,0:12:10.23,0:12:15.23,Default,,0,0,0,,Егер мен сол жігіттердің қолына түссем, бұл мен үшін ақырет екені анық.
Dialogue: 0,0:12:15.23,0:12:20.24,Default,,0,0,0,,Мен өз түрімді кездестіру үшін жер бетінде қайда баруым керек?
Dialogue: 0,0:12:20.24,0:12:22.24,Default,,0,0,0,,Тіпті мен әлеммен араласқым келеді
Dialogue: 0,0:12:22.24,0:12:25.24,Default,,0,0,0,,Осылай қалса, ауырады.
Dialogue: 0,0:12:25.24,0:12:31.25,Default,,0,0,0,,Сенің ішіңде мен сағыныш дер едім.
Dialogue: 0,0:12:31.25,0:12:34.25,Default,,0,0,0,,Сағыныш? Бұл не?
Dialogue: 0,0:12:34.25,0:12:36.25,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:12:36.25,0:12:41.26,Default,,0,0,0,,Туған жерін ойлау, утопияны аңсау немесе
Dialogue: 0,0:12:41.26,0:12:47.26,Default,,0,0,0,,Өзімді де, тұрған жерімді де сүйе алмаудың азабы... осыны айттым ба?
Dialogue: 0,0:12:47.26,0:12:51.27,Default,,0,0,0,,Ендеше сол сағынышпен қалай күресуге болатынын айт!
Dialogue: 0,0:12:51.27,0:12:54.27,Default,,0,0,0,,Менің туған жерім жоқ!
Dialogue: 0,0:12:54.27,0:12:57.27,Default,,0,0,0,,Сонымен... саяхатқа шығамыз ба?
Dialogue: 0,0:13:00.28,0:13:02.28,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:02.28,0:13:04.28,Default,,0,0,0,,Жарайсың ба? қоңырау
Dialogue: 0,0:13:04.28,0:13:08.28,Default,,0,0,0,,Қылыш елінде сендей ешкім жоқ.
Dialogue: 0,0:13:08.28,0:13:11.29,Default,,0,0,0,,Бірақ еліңді тастап, әлемге саяхат жасасаң
Dialogue: 0,0:13:11.29,0:13:16.29,Default,,0,0,0,,Сіз өзіңіздің шынайы әлеміңізді ала аласыз.
Dialogue: 0,0:13:16.29,0:13:20.30,Default,,0,0,0,,Саябаққа барып, көшпенді болу үшін тест тапсыр.
Dialogue: 0,0:13:20.30,0:13:23.30,Default,,0,0,0,,Егер бұл сіз болсаңыз, сіз мұны міндетті түрде жасай аласыз.
Dialogue: 0,0:13:23.30,0:13:28.30,Default,,0,0,0,,Өйткені, ол менің шәкіртім.
Dialogue: 0,0:13:28.30,0:13:30.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:38.81,0:13:43.82,Default,,0,0,0,,Ха, бұл кенеттен болып жатқаны несі...
Dialogue: 0,0:13:43.82,0:13:47.82,Default,,0,0,0,,)
Dialogue: 0,0:13:47.82,0:13:50.83,Default,,0,0,0,,)
Dialogue: 0,0:13:50.83,0:13:54.83,Default,,0,0,0,,)
Dialogue: 0,0:13:54.83,0:13:58.83,Default,,0,0,0,,)
Dialogue: 0,0:13:58.83,0:14:00.84,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:14:00.84,0:14:03.84,Default,,0,0,0,,Бір күні бұл өмір бітеді
Dialogue: 0,0:14:03.84,0:14:07.84,Default,,0,0,0,,Бұл бастамасы ғана
Dialogue: 0,0:14:07.84,0:14:12.85,Default,,0,0,0,,)
Dialogue: 0,0:14:17.35,0:14:19.35,Default,,0,0,0,,Менің әлемім…
Dialogue: 0,0:14:19.35,0:14:24.36,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:14:25.36,0:14:27.36,Default,,0,0,0,,Ландинг…
Dialogue: 0,0:14:37.37,0:14:39.37,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:14:39.37,0:14:42.38,Default,,0,0,0,,((Мен тастан жаралғанмын)) (Айуан адам)((Шынымен де ме?))
Dialogue: 0,0:14:42.38,0:14:46.38,Default,,0,0,0,,((Бұл қорқынышты)) (Beastman)((Жоқ, маған ұнамайды))
Dialogue: 0,0:14:46.38,0:14:48.38,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:14:48.38,0:14:50.39,Default,,0,0,0,,() (аң адам)()
Dialogue: 0,0:14:50.39,0:14:53.39,Default,,0,0,0,,((Ия, бұл біртүрлі)) (Beastman баласы)((Бұл әрине біртүрлі))
Dialogue: 0,0:14:53.39,0:14:55.39,Default,,0,0,0,,((біртүрлі)) ((ngh!))
