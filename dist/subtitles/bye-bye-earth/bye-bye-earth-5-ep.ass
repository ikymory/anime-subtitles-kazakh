Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.00,0:00:27.02,Default,,0,0,0,,♪～
Dialogue: 0,0:00:27.02,0:00:33.03,Default,,0,0,0,,♪～
Dialogue: 0,0:00:33.03,0:00:36.03,Default,,0,0,0,,Көмекші жолақ жалын!
Dialogue: 0,0:00:40.04,0:00:43.04,Default,,0,0,0,,Директор: Жарық!
Dialogue: 0,0:00:47.04,0:00:50.05,Default,,0,0,0,,Және су!
Dialogue: 0,0:00:58.05,0:01:02.06,Default,,0,0,0,,Өрт, жарық және су... үштік бөгет?
Dialogue: 0,0:01:02.06,0:01:05.06,Default,,0,0,0,,Авангард әскерлері! Қараңғылықты кесіңіз!
Dialogue: 0,0:01:05.06,0:01:07.06,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:01:09.06,0:01:13.07,Default,,0,0,0,,Тым қатты шығып тұр... Жарайды ма?
Dialogue: 0,0:01:13.07,0:01:15.07,Default,,0,0,0,,Ах
Dialogue: 0,0:01:16.07,0:01:20.08,Default,,0,0,0,,Екі қанаттағы авангардты қолдаңыз!
Dialogue: 0,0:01:21.08,0:01:24.08,Default,,0,0,0,,А... бұл!
Dialogue: 0,0:01:25.08,0:01:27.08,Default,,0,0,0,,Дионың Рух толқынының шынайы табиғатын қалай ашуға болады
Dialogue: 0,0:01:27.08,0:01:29.08,Default,,0,0,0,,О!
Dialogue: 0,0:01:29.08,0:01:32.09,Default,,0,0,0,,Жеңдер! Хмф! (Адонис) Ақымақ!
Dialogue: 0,0:01:34.09,0:01:36.09,Default,,0,0,0,,Сәлем! (Қылыш шебері) Гордон күткендей!
Dialogue: 0,0:01:36.09,0:01:38.09,Default,,0,0,0,,Сіз бара аласыз! (Гордон) Алға ұмтыл!
Dialogue: 0,0:01:38.09,0:01:41.10,Default,,0,0,0,,Ақымақ! Жабыңыз!
Dialogue: 0,0:01:41.10,0:01:44.10,Default,,0,0,0,,Уау! Хмм
Dialogue: 0,0:01:44.10,0:01:46.10,Default,,0,0,0,,Мен білмейтін қыз…➡
Dialogue: 0,0:01:48.60,0:02:08.62,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:08.62,0:02:28.64,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:28.64,0:02:48.66,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:48.66,0:03:08.68,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:08.68,0:03:17.69,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:18.69,0:03:23.70,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:03:23.70,0:03:25.70,Default,,0,0,0,,Мұндай соқырлық! Хмм!
Dialogue: 0,0:03:25.70,0:03:28.70,Default,,0,0,0,,Сабыр ет! Үлкен мәселе жоқ!
Dialogue: 0,0:03:28.70,0:03:30.71,Default,,0,0,0,,Ha
Dialogue: 0,0:03:30.71,0:03:34.71,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:03:34.71,0:03:38.71,Default,,0,0,0,,Қарғыс атсын... Жаудың нысанасы – тылдағы! Сіздің қашу жолыңыз кесіледі!
Dialogue: 0,0:03:38.71,0:03:40.72,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:03:40.72,0:03:42.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:46.72,0:03:48.72,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:03:48.72,0:03:51.73,Default,,0,0,0,,Ха... бұл кім?
Dialogue: 0,0:03:54.73,0:03:56.73,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:03:56.73,0:03:59.74,Default,,0,0,0,,Су алынды!
Dialogue: 0,0:03:59.74,0:04:02.74,Default,,0,0,0,,Ішіп-жеудің сиқырына сіңіп кетесің!
Dialogue: 0,0:04:02.74,0:04:04.74,Default,,0,0,0,,Жабу!
Dialogue: 0,0:04:04.74,0:04:06.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:07.74,0:04:09.75,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:04:11.75,0:04:13.75,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:04:13.75,0:04:16.75,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:04:16.75,0:04:19.76,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:04:19.76,0:04:21.76,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:04:21.76,0:04:23.76,Default,,0,0,0,,Дирижер!
Dialogue: 0,0:04:23.76,0:04:26.76,Default,,0,0,0,,Қарғыс атсын... (Перри) Тез пәрмен бер.
Dialogue: 0,0:04:26.76,0:04:28.76,Default,,0,0,0,,Уау ха...
Dialogue: 0,0:04:28.76,0:04:30.77,Default,,0,0,0,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,0:04:36.77,0:04:40.78,Default,,0,0,0,,《Бұл... Тициан ба? 》
Dialogue: 0,0:04:43.78,0:04:45.78,Default,,0,0,0,,А... Қоңырау!
Dialogue: 0,0:04:45.78,0:04:48.78,Default,,0,0,0,,Бұл жер нашар! Қазір жабыңыз!
Dialogue: 0,0:04:48.78,0:04:50.79,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:04:51.79,0:04:56.79,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:03.80,0:05:08.80,Default,,0,0,0,,Чикушо... тағы бірдеңе істей алмас па едің?
Dialogue: 0,0:05:11.81,0:05:14.81,Default,,0,0,0,,《Ол...》
Dialogue: 0,0:05:14.81,0:05:17.81,Default,,0,0,0,,《Бенедиктин? 》
Dialogue: 0,0:05:17.81,0:05:20.82,Default,,0,0,0,,《Мен өзіме ұнамайтын адамды кездестірдім》
Dialogue: 0,0:05:20.82,0:05:23.82,Default,,0,0,0,,《Кісі өлтіру ниетінің массасы》
Dialogue: 0,0:05:23.82,0:05:25.82,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:25.82,0:05:27.82,Default,,0,0,0,,Эй, эй...
Dialogue: 0,0:05:30.83,0:05:34.83,Default,,0,0,0,,Ха... бұл өтірік...
Dialogue: 0,0:05:35.83,0:05:37.83,Default,,0,0,0,,Эй, мен сенің жағындамын.
Dialogue: 0,0:05:37.83,0:05:39.84,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:05:39.84,0:05:43.84,Default,,0,0,0,,Мені осылай шақырсаң, өлтіріп кетсем де шағым айта алмаймын!
Dialogue: 0,0:05:43.84,0:05:45.84,Default,,0,0,0,,Пок-юн!
Dialogue: 0,0:05:45.84,0:05:48.84,Default,,0,0,0,,Мен неге мұндаймын...
Dialogue: 0,0:05:48.84,0:05:51.85,Default,,0,0,0,,Сіз не істеп жүрсіз?
Dialogue: 0,0:05:51.85,0:05:54.85,Default,,0,0,0,,Гордонға көмектесе алмай!
Dialogue: 0,0:05:54.85,0:05:57.85,Default,,0,0,0,,Білесің бе... (Қылыштың ақыруы)
Dialogue: 0,0:05:57.85,0:06:00.86,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:06:00.86,0:06:03.86,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:03.86,0:06:06.86,Default,,0,0,0,,Гордон!
Dialogue: 0,0:06:08.86,0:06:13.87,Default,,0,0,0,,Сондықтан сіз қауіпсізсіз! Мен уже уайымдап жүрмін...
Dialogue: 0,0:06:13.87,0:06:15.87,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:06:15.87,0:06:17.87,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:17.87,0:06:19.88,Default,,0,0,0,,...
Dialogue: 0,0:06:19.88,0:06:22.88,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:06:22.88,0:06:26.88,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:26.88,0:06:29.89,Default,,0,0,0,,Қанның тоқырауы сонша...
Dialogue: 0,0:06:29.89,0:06:32.89,Default,,0,0,0,,Ол өлді...
Dialogue: 0,0:06:33.89,0:06:37.89,Default,,0,0,0,,Ол әлдеқашан өлген және айла-шарғы жасауда!
Dialogue: 0,0:06:38.89,0:06:40.90,Default,,0,0,0,,Мен одан құтылуым керек. Мен одан құтылуым керек.
Dialogue: 0,0:06:40.90,0:06:44.90,Default,,0,0,0,,Өшіруім керек Өшіруім керек Өшіруім керек...
Dialogue: 0,0:06:44.90,0:06:46.90,Default,,0,0,0,,Мен ол жігітті жоюым керек...
Dialogue: 0,0:06:46.90,0:06:49.91,Default,,0,0,0,,Бенедиктин! Қазірдің өзінде оның айналасында ...
Dialogue: 0,0:06:49.91,0:06:51.91,Default,,0,0,0,,Маған енді ұнамайды
Dialogue: 0,0:06:51.91,0:06:56.91,Default,,0,0,0,,Бұл маған ұнамайды, бұл өтірік...
Dialogue: 0,0:06:56.91,0:06:58.91,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:07:01.92,0:07:04.92,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:07:06.92,0:07:09.93,Default,,0,0,0,,Ха... (Гордонның ырылдауы)
Dialogue: 0,0:07:09.93,0:07:11.93,Default,,0,0,0,,Абай бол, ЖоЖо
Dialogue: 0,0:07:12.93,0:07:14.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:17.93,0:07:19.94,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:21.94,0:07:26.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:26.94,0:07:28.94,Default,,0,0,0,,《Сен оны қиып аласың ба? 》
Dialogue: 0,0:07:32.95,0:07:35.95,Default,,0,0,0,,Бұл қауіпті жер еді.
Dialogue: 0,0:07:36.95,0:07:40.96,Default,,0,0,0,,Китти! сен неге...
Dialogue: 0,0:07:40.96,0:07:43.96,Default,,0,0,0,,Бұл мені құтқарды. Бұл таңғажайып техника.
Dialogue: 0,0:07:43.96,0:07:47.96,Default,,0,0,0,,Жоқ, бұл жай ғана ойша есеп.
Dialogue: 0,0:07:47.96,0:07:51.97,Default,,0,0,0,,Маған ұнамайды... Маған енді ұнамайды!
Dialogue: 0,0:07:51.97,0:07:54.97,Default,,0,0,0,,Мен мұндай жерде болғым келмейді!
Dialogue: 0,0:07:54.97,0:07:57.97,Default,,0,0,0,,Күте тұрыңыз... ннн!
Dialogue: 0,0:08:02.98,0:08:04.98,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:04.98,0:08:08.98,Default,,0,0,0,,Жаман, мен қылышты сындырғым келмеді...
Dialogue: 0,0:08:08.98,0:08:11.99,Default,,0,0,0,,Маған енді ұнамайды
Dialogue: 0,0:08:11.99,0:08:14.99,Default,,0,0,0,,Ой, күте тұр... (Бенедиктин) Маған ұнамайды.
Dialogue: 0,0:08:14.99,0:08:17.99,Default,,0,0,0,,О, ау
Dialogue: 0,0:08:17.99,0:08:22.00,Default,,0,0,0,,Шаршадым... Сен мықты болғаның жөн (Бенедиктиннің айқайы)
Dialogue: 0,0:08:22.00,0:08:26.00,Default,,0,0,0,,Өйткені, өйткені, Гордонсыз мен...
Dialogue: 0,0:08:26.00,0:08:29.00,Default,,0,0,0,,Су тайпасы
Dialogue: 0,0:08:29.00,0:08:33.01,Default,,0,0,0,,Айна сияқты басқалардың жүрегін өз жүрегіңмен бейнеле
Dialogue: 0,0:08:33.01,0:08:36.01,Default,,0,0,0,,Оған жүрегіңді сал
Dialogue: 0,0:08:36.01,0:08:41.02,Default,,0,0,0,,Рухани паразит деп атауға болатын нәсіл...
Dialogue: 0,0:08:41.02,0:08:46.02,Default,,0,0,0,,Бұл сіздің мінезіңіз Гордонға ұқсас екенін білдіре ме?
Dialogue: 0,0:08:46.02,0:08:49.02,Default,,0,0,0,,Ал басқа адам өлгендіктен
Dialogue: 0,0:08:49.02,0:08:51.03,Default,,0,0,0,,Менің жүрегім жаралы.
Dialogue: 0,0:08:51.03,0:08:53.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:53.03,0:08:58.03,Default,,0,0,0,,Бұған жол бермеу үшін көптеген адамдармен кең және тайыз қарым-қатынас жасау маңызды.
Dialogue: 0,0:08:58.03,0:09:02.04,Default,,0,0,0,,Бұл су перісінің табиғаты болуы керек...
Dialogue: 0,0:09:03.04,0:09:08.04,Default,,0,0,0,,Енді өз бетімше не істеуім керек?
Dialogue: 0,0:09:08.04,0:09:10.05,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:09:10.05,0:09:14.05,Default,,0,0,0,,Мен тіпті білмеймін
Dialogue: 0,0:09:22.06,0:09:24.06,Default,,0,0,0,,А... (2 адам) А?
Dialogue: 0,0:09:24.06,0:09:27.06,Default,,0,0,0,,Құбыжық! Бұл құбыжық!
Dialogue: 0,0:09:27.06,0:09:29.06,Default,,0,0,0,,Ха-а-уау
Dialogue: 0,0:09:29.06,0:09:32.07,Default,,0,0,0,,А, мұнда да!
Dialogue: 0,0:09:32.07,0:09:34.07,Default,,0,0,0,,Гиннесті тыныштандырыңыз
Dialogue: 0,0:09:35.07,0:09:38.07,Default,,0,0,0,,А... сендер балалар?
Dialogue: 0,0:09:38.07,0:09:41.08,Default,,0,0,0,,Арттағы Гордон ба? О
Dialogue: 0,0:09:41.08,0:09:44.08,Default,,0,0,0,,Түсінемін, Ием...
Dialogue: 0,0:09:44.08,0:09:47.08,Default,,0,0,0,,Неліктен саяхатшы ұзын құлақты тайпа осындай жерге тап болды?
Dialogue: 0,0:09:47.08,0:09:52.09,Default,,0,0,0,,Ол одан әлдеқайда үрейленді.
Dialogue: 0,0:09:52.09,0:09:55.09,Default,,0,0,0,,Сосын... өлді деген одақтас маған шабуыл жасады.
Dialogue: 0,0:09:55.09,0:09:58.09,Default,,0,0,0,,Хмм, ол сияқты.
Dialogue: 0,0:09:58.09,0:10:01.10,Default,,0,0,0,,О, онда Гордон мырза...
Dialogue: 0,0:10:01.10,0:10:06.10,Default,,0,0,0,,Бұл да... Тицианның ісі ме?
Dialogue: 0,0:10:10.11,0:10:12.11,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:12.11,0:10:14.11,Default,,0,0,0,,Мен бірдеңе естідім, иә?
Dialogue: 0,0:10:14.11,0:10:16.11,Default,,0,0,0,,Біреу сөйлеп тұр
Dialogue: 0,0:10:16.11,0:10:18.11,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:10:18.11,0:10:22.12,Default,,0,0,0,,Осындай кезде су перісінің есту қабілетіне сенуге болады.
Dialogue: 0,0:10:22.12,0:10:24.12,Default,,0,0,0,,Кеттік
Dialogue: 0,0:10:24.12,0:10:27.12,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:10:35.13,0:10:37.13,Default,,0,0,0,,Міндеттеме
Dialogue: 0,0:10:38.13,0:10:40.14,Default,,0,0,0,,Сіз қандайсыз?
Dialogue: 0,0:10:40.14,0:10:43.14,Default,,0,0,0,,Бар болғаныңызға рахмет. Біреу сөйлеп тұр.
Dialogue: 0,0:10:43.14,0:10:46.14,Default,,0,0,0,,Асқазанды арқаға ауыстыра алмайсыз
Dialogue: 0,0:10:46.14,0:10:48.14,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ. Мен түссіндім.
Dialogue: 0,0:10:48.14,0:10:50.15,Default,,0,0,0,,Адонис!
Dialogue: 0,0:10:52.15,0:10:55.15,Default,,0,0,0,,Жақсы! Мен қауіпсізмін...
Dialogue: 0,0:10:55.65,0:10:58.65,Default,,0,0,0,,Перьер... Жаңа ғана қайтыс болды.
Dialogue: 0,0:10:58.65,0:11:01.66,Default,,0,0,0,,А, Адонис...
Dialogue: 0,0:11:01.66,0:11:05.66,Default,,0,0,0,,Қоңырау Қанша адам тірі қалды?
Dialogue: 0,0:11:05.66,0:11:07.66,Default,,0,0,0,,Дәл осы жерде.
Dialogue: 0,0:11:07.66,0:11:09.66,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:09.66,0:11:12.67,Default,,0,0,0,,Мен мына жігіттің қылышын аламын.
Dialogue: 0,0:11:12.67,0:11:14.67,Default,,0,0,0,,Қылыш ұры...
Dialogue: 0,0:11:14.67,0:11:16.67,Default,,0,0,0,,Алда көл бар
Dialogue: 0,0:11:16.67,0:11:18.67,Default,,0,0,0,,«Сырттағы» тұрғындар үшін…
Dialogue: 0,0:11:18.67,0:11:20.68,Default,,0,0,0,,Гува, дұрыс немесе бұрыс маңызды емес.
Dialogue: 0,0:11:20.68,0:11:23.68,Default,,0,0,0,,Өлгендердің рухы жұбататын жердің бірі.
Dialogue: 0,0:11:23.68,0:11:26.68,Default,,0,0,0,,Онда шоу бар сияқты.
Dialogue: 0,0:11:26.68,0:11:29.68,Default,,0,0,0,,Көрініс дегеніміз не?
Dialogue: 0,0:11:29.68,0:11:33.69,Default,,0,0,0,,Мұны кім жасайды? неге өзіңді көрсетпейсің
Dialogue: 0,0:11:33.69,0:11:35.69,Default,,0,0,0,,Ол адам зұлымдықты жүргізушісі.
Dialogue: 0,0:11:35.69,0:11:37.69,Default,,0,0,0,,Не? (Кашису) Сіз...
Dialogue: 0,0:11:37.69,0:11:40.70,Default,,0,0,0,,Сіз зұлым адамдармен сөйлесесіз бе!?
Dialogue: 0,0:11:40.70,0:11:43.70,Default,,0,0,0,,Күте тұрыңыз! біз қателестік
Dialogue: 0,0:11:43.70,0:11:45.70,Default,,0,0,0,,Біздің жауымыз кім?
Dialogue: 0,0:11:45.70,0:11:47.70,Default,,0,0,0,,Ол біздің жауымыз.
Dialogue: 0,0:11:47.70,0:11:51.71,Default,,0,0,0,,Бұл шайқастың отын ең бірінші кім сепкен?
Dialogue: 0,0:11:51.71,0:11:53.71,Default,,0,0,0,,Тициан Иә!
Dialogue: 0,0:11:53.71,0:11:56.71,Default,,0,0,0,,Біздің жалғыз жауымыз – Тициан!
Dialogue: 0,0:11:56.71,0:12:00.72,Default,,0,0,0,,Үздік иттерге де, астыртын иттерге де тән
Dialogue: 0,0:12:00.72,0:12:02.72,Default,,0,0,0,,Адонис…
Dialogue: 0,0:12:02.72,0:12:07.72,Default,,0,0,0,,Қайталаңыз! Жалғыз жау - Тициан!
Dialogue: 0,0:12:12.73,0:12:15.73,Default,,0,0,0,,Бұл көл...
Dialogue: 0,0:12:15.73,0:12:17.73,Default,,0,0,0,,Бірақ бұл шоу...
Dialogue: 0,0:12:18.73,0:12:20.74,Default,,0,0,0,,Сол жерде.
Dialogue: 0,0:12:25.74,0:12:27.74,Default,,0,0,0,,Тициан
Dialogue: 0,0:12:33.75,0:12:38.75,Default,,0,0,0,,(Өлген сарбаздардың мұңы)
Dialogue: 0,0:12:38.75,0:12:58.77,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:58.77,0:13:01.78,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:01.78,0:13:04.78,Default,,0,0,0,,Сіз жақсылық пен зұлымдық арасындағы күресті қайталап жатырсыз ба?
Dialogue: 0,0:13:04.78,0:13:06.78,Default,,0,0,0,,Мәйітті пайдалану
Dialogue: 0,0:13:06.78,0:13:09.78,Default,,0,0,0,,Құдай болып көріну
Dialogue: 0,0:13:10.79,0:13:15.79,Default,,0,0,0,,Сол жарық... бұл Гордонның жарасымен бірдей ме?
Dialogue: 0,0:13:15.79,0:13:18.79,Default,,0,0,0,,Жоқ, керісінше...
Dialogue: 0,0:13:18.79,0:13:20.80,Default,,0,0,0,,Құдай ағашы?
Dialogue: 0,0:13:20.80,0:13:24.80,Default,,0,0,0,,Сол адамның жүзінің бөліктері менің денемді тістеп жатқанда,
Dialogue: 0,0:13:24.80,0:13:27.80,Default,,0,0,0,,Өлгендерді басқарып жатқан сияқты.
Dialogue: 0,0:13:27.80,0:13:29.80,Default,,0,0,0,,(Shinsou) Маған үйреткеннің тіпті 10 пайызын да іс жүзінде қолдана алмадым
Dialogue: 0,0:13:29.80,0:13:31.81,Default,,0,0,0,,Жаман емес пе?
Dialogue: 0,0:13:34.81,0:13:40.82,Default,,0,0,0,,Ардони Сью!
Dialogue: 0,0:13:40.82,0:13:43.82,Default,,0,0,0,,Боқ (Джинбек) Бұл ақылсыз!
Dialogue: 0,0:13:43.82,0:13:46.82,Default,,0,0,0,,Жаңа қозғалыс? (Джинбаг) Міне, асығыңыз!
Dialogue: 0,0:13:46.82,0:13:48.82,Default,,0,0,0,,Иллюзия? Қанекей жүгірейік!
Dialogue: 0,0:13:48.82,0:13:50.83,Default,,0,0,0,,Маған ер!
Dialogue: 0,0:13:54.83,0:13:56.83,Default,,0,0,0,,Абайлаңыз, ха
Dialogue: 0,0:13:56.83,0:14:01.84,Default,,0,0,0,,(Өлген сарбаздардың мұңы)
Dialogue: 0,0:14:01.84,0:14:03.84,Default,,0,0,0,,Бамбук! Ол ыстық және оңай бұзылады.
Dialogue: 0,0:14:03.84,0:14:05.84,Default,,0,0,0,,Мен сенің қаныңды осы дененің бір бөлігіне айналдырамын!
Dialogue: 0,0:14:09.84,0:14:11.85,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:14:14.85,0:14:16.85,Default,,0,0,0,,Сынған ба?
Dialogue: 0,0:14:20.86,0:14:22.86,Default,,0,0,0,,《Мен қылышымды лақтырдым...》
Dialogue: 0,0:14:22.86,0:14:25.86,Default,,0,0,0,,《Бұл Адонистің қылыш техникасы》
Dialogue: 0,0:14:25.86,0:14:28.86,Default,,0,0,0,,《Мен тек жауды тиімді жеңуді ойладым...》
Dialogue: 0,0:14:28.86,0:14:31.87,Default,,0,0,0,,《Қылыш маған мүлдем қарама-қайшы келеді》
Dialogue: 0,0:14:31.87,0:14:33.87,Default,,0,0,0,,≪(Дэннидің үрген дауысы) (Джонатан) Дұрыс~, жақсы бала!
Dialogue: 0,0:14:41.88,0:14:44.88,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:14:46.88,0:14:48.88,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:14:48.88,0:14:51.89,Default,,0,0,0,,Пайдасыз! Бұл есік...
Dialogue: 0,0:14:51.89,0:14:54.89,Default,,0,0,0,,Оны темір қабырғаға айналдырып, көрейік.
Dialogue: 0,0:14:57.89,0:14:59.89,Default,,0,0,0,,(Өлген сарбаздардың мұңы)
Dialogue: 0,0:14:59.89,0:15:02.90,Default,,0,0,0,,Егер сіз оны сол жағынан ұстасаңыз
Dialogue: 0,0:15:02.90,0:15:06.90,Default,,0,0,0,,Барлығы күйіп тұрған тозақ көзіне қарайды
Dialogue: 0,0:15:09.90,0:15:11.91,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:15:11.91,0:15:13.91,Default,,0,0,0,,Ей, біз тағы кездестік.
Dialogue: 0,0:15:13.91,0:15:15.91,Default,,0,0,0,,Сіз...
Dialogue: 0,0:15:15.91,0:15:18.91,Default,,0,0,0,,Бірінші сот талқылауы кезінде...
Dialogue: 0,0:15:18.91,0:15:23.92,Default,,0,0,0,,Мен Зимбэк Андердогтың дирижерімін.
Dialogue: 0,0:15:23.92,0:15:25.92,Default,,0,0,0,,Содан кейін Тициан.
Dialogue: 0,0:15:25.92,0:15:27.92,Default,,0,0,0,,Оның қол астында болды ма? (Джинбек) А
Dialogue: 0,0:15:27.92,0:15:30.93,Default,,0,0,0,,Бұл көрініс не туралы болды?
Dialogue: 0,0:15:30.93,0:15:32.93,Default,,0,0,0,,Сол су қыз да.
Dialogue: 0,0:15:32.93,0:15:37.93,Default,,0,0,0,,Алғаш пайда болған кезде олай емес еді.
Dialogue: 0,0:15:37.93,0:15:42.94,Default,,0,0,0,,Оның ойы жақсы жұмыс істеп, көзінде жүрек бар.
Dialogue: 0,0:15:42.94,0:15:46.94,Default,,0,0,0,,Бірге соғысуымызды өтінді, солай ма?
Dialogue: 0,0:15:46.94,0:15:48.94,Default,,0,0,0,,Не?
Dialogue: 0,0:15:48.94,0:15:51.95,Default,,0,0,0,,«Бұл жерде басты ит шабуылдап жатыр».
Dialogue: 0,0:15:51.95,0:15:56.95,Default,,0,0,0,,«Мен мұнда бір себеппен келдім және әділеттілікті жақтаймын».
Dialogue: 0,0:15:56.95,0:15:59.95,Default,,0,0,0,,«Мен бірге күрескім келеді»
Dialogue: 0,0:15:59.95,0:16:01.96,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:01.96,0:16:04.96,Default,,0,0,0,,Тициан жаман жаққа құлағандықтан, біз
Dialogue: 0,0:16:04.96,0:16:07.96,Default,,0,0,0,,Сен мұнда мені жеңу үшін келмедің бе? (Кашису) Хмм...
Dialogue: 0,0:16:07.96,0:16:12.97,Default,,0,0,0,,Анау су қыздың жынды болғанын айтайын ба?
Dialogue: 0,0:16:12.97,0:16:15.97,Default,,0,0,0,,Мені көргеннен бері
Dialogue: 0,0:16:15.97,0:16:17.97,Default,,0,0,0,,Иә, мен сені көрген бойда
Dialogue: 0,0:16:17.97,0:16:21.98,Default,,0,0,0,,Ол бәрін, оның ішінде өзін де жарып жіберді.
Dialogue: 0,0:16:21.98,0:16:24.98,Default,,0,0,0,,Адонис Сіз себепкерсіз бе?
Dialogue: 0,0:16:24.98,0:16:27.98,Default,,0,0,0,,Бұл мен емес, басқа адам.
Dialogue: 0,0:16:27.98,0:16:32.99,Default,,0,0,0,,Ол Құдайдың сөзіне мойынсұнбай, соғыстан қашып, діни қызметкердің қолынан қаза тапты.
Dialogue: 0,0:16:32.99,0:16:36.99,Default,,0,0,0,,Мұндай... сүйікті адамның өлімі.
Dialogue: 0,0:16:36.99,0:16:38.99,Default,,0,0,0,,Мен оған айттым.
Dialogue: 0,0:16:38.99,0:16:43.00,Default,,0,0,0,,Сол кезде ол жынды бола бастады.
Dialogue: 0,0:16:43.00,0:16:46.00,Default,,0,0,0,,Сонымен... қазір жағдай осылай ма?
Dialogue: 0,0:16:46.00,0:16:51.01,Default,,0,0,0,,Мені көргенде көп нәрсені еске түсірді деп ойлаймын.
Dialogue: 0,0:16:51.01,0:16:53.01,Default,,0,0,0,,Адонис…
Dialogue: 0,0:16:53.01,0:16:57.01,Default,,0,0,0,,Ал, бір нәрсе анық: оны сол күйінде қалдыр.
Dialogue: 0,0:16:57.01,0:17:03.02,Default,,0,0,0,,Біз бәріміз сол су қызының қуыршақтарымыз.
Dialogue: 0,0:17:03.02,0:17:07.02,Default,,0,0,0,,Ендеше... неге бір сәт бізбен күш біріктірмейсіз?
Dialogue: 0,0:17:07.02,0:17:09.02,Default,,0,0,0,,Не? (Бенедикт) Бұл әзіл емес.
Dialogue: 0,0:17:09.02,0:17:12.03,Default,,0,0,0,,Оның тұзақ емес екеніне дәлеліңіз бар ма?
Dialogue: 0,0:17:12.03,0:17:16.03,Default,,0,0,0,,Иә? Сіз жынды емессіз бе? (Бенедикт) Бұл не!?
Dialogue: 0,0:17:16.03,0:17:19.03,Default,,0,0,0,,Мен мұндай қиын тұзақ құрғаннан гөрі, үңгірдің ішіне кіргенді жөн көремін.
Dialogue: 0,0:17:19.03,0:17:23.04,Default,,0,0,0,,Маған оларды бір-бірлеп өлтіру оңайырақ.
Dialogue: 0,0:17:23.04,0:17:25.04,Default,,0,0,0,,Бірақ бірге күрессек
Dialogue: 0,0:17:25.04,0:17:28.04,Default,,0,0,0,,Қылышым мен тактикамның сапасы белгілі болады.
Dialogue: 0,0:17:28.04,0:17:32.05,Default,,0,0,0,,Дұрыс, зұлым адамдармен бір күні тағы бір шайқас болады.
Dialogue: 0,0:17:32.05,0:17:34.05,Default,,0,0,0,,Шынында да, иә.
Dialogue: 0,0:17:34.05,0:17:38.05,Default,,0,0,0,,Осыдан кейін сіз жеңіліп, айла-шарғы жасайсыз.
Dialogue: 0,0:17:38.05,0:17:40.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:40.05,0:17:43.06,Default,,0,0,0,,Хехехехехехехехе
Dialogue: 0,0:17:43.06,0:17:47.06,Default,,0,0,0,,Эй, сен жеңілдің. Мұнда қолыңызды біріктірсеңіз болғаны.
Dialogue: 0,0:17:47.06,0:17:50.06,Default,,0,0,0,,Беннетт иә? Иә.
Dialogue: 0,0:17:50.06,0:17:53.07,Default,,0,0,0,,Жарайды, егер солай десеңіз.
Dialogue: 0,0:17:53.07,0:17:56.07,Default,,0,0,0,,Беру? Хи хи
Dialogue: 0,0:17:56.07,0:17:58.07,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:17:58.07,0:18:03.08,Default,,0,0,0,,Жарайды, тезірек рөлдерге бөлейік.
Dialogue: 0,0:18:03.08,0:18:06.08,Default,,0,0,0,,Мен дирижер бола аламын ба?
Dialogue: 0,0:18:06.08,0:18:08.08,Default,,0,0,0,,«Жарайды ма?»...
Dialogue: 0,0:18:08.08,0:18:11.09,Default,,0,0,0,,Мұнда дирижер жоқ.
Dialogue: 0,0:18:11.09,0:18:14.09,Default,,0,0,0,,Хехе, сосын шешілді.
Dialogue: 0,0:18:14.09,0:18:16.09,Default,,0,0,0,,Келесіде директор...
Dialogue: 0,0:18:16.09,0:18:18.09,Default,,0,0,0,,Эй, сен оны көргің келе ме?
Dialogue: 0,0:18:18.09,0:18:21.10,Default,,0,0,0,,Мен?
Dialogue: 0,0:18:21.10,0:18:24.10,Default,,0,0,0,,Бұл жолы жақсылық пен зұлымдықтың аралас тобы
Dialogue: 0,0:18:24.10,0:18:28.10,Default,,0,0,0,,Өнімді саяхатшы бейтаныс адамға тапсырған дұрыс.
Dialogue: 0,0:18:28.10,0:18:30.10,Default,,0,0,0,,Хмм (Джинбэк) Менің ойымша.
Dialogue: 0,0:18:30.10,0:18:34.11,Default,,0,0,0,,Сіз күтпеген нәрсені табуыңыз мүмкін.
Dialogue: 0,0:18:34.11,0:18:36.11,Default,,0,0,0,,О... (Джинбэк) Эй, Тұман
Dialogue: 0,0:18:36.11,0:18:38.11,Default,,0,0,0,,Не? (Джинбэк) Сіз өткен күні болдыңыз.
Dialogue: 0,0:18:38.11,0:18:41.12,Default,,0,0,0,,Маған тапқаныңызды беріңіз (мырза) Иә...
Dialogue: 0,0:18:41.12,0:18:43.12,Default,,0,0,0,,Ммм, неге...
Dialogue: 0,0:18:43.12,0:18:46.12,Default,,0,0,0,,Сіз бұл жігітті танисыз ба?
Dialogue: 0,0:18:46.12,0:18:51.13,Default,,0,0,0,,Күтілгендей, себеп-салдар жібі әлі де үзілу белгілерін көрсетпейді.
Dialogue: 0,0:18:51.13,0:18:54.13,Default,,0,0,0,,Не? (Кити) Жоқ, әрине.
Dialogue: 0,0:18:54.13,0:18:56.13,Default,,0,0,0,,Рахмет ретінде,
Dialogue: 0,0:18:56.13,0:19:00.13,Default,,0,0,0,,Мен рөлді аламын.
Dialogue: 0,0:19:00.13,0:19:04.14,Default,,0,0,0,,Жарайды, стратегияға жауапты сценарийші...
Dialogue: 0,0:19:04.14,0:19:06.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:06.14,0:19:09.14,Default,,0,0,0,,Маған бірдеңе бұйырса, орындаймын.
Dialogue: 0,0:19:09.14,0:19:11.15,Default,,0,0,0,,Бұл не? Сіз мотивациясыз ба?
Dialogue: 0,0:19:11.15,0:19:15.15,Default,,0,0,0,,Күлсін... Сонда қандай сценарий жазуым керек?
Dialogue: 0,0:19:15.15,0:19:18.15,Default,,0,0,0,,Бұл сіздің жұмысыңыз ба?
Dialogue: 0,0:19:18.15,0:19:21.16,Default,,0,0,0,,Иә, әрине, бірақ...
Dialogue: 0,0:19:21.16,0:19:25.16,Default,,0,0,0,,Алдын ала тапсырыс бермесеңіз... (Тұман) Мен өзімді ақымақ сияқты сезінемін!
Dialogue: 0,0:19:25.16,0:19:30.16,Default,,0,0,0,,Адамдардың бет-әлпетін ғана ойлайтындықтан, сонша саңылаулары бар формацияларға түсесің.
Dialogue: 0,0:19:30.16,0:19:33.17,Default,,0,0,0,,Жазғыңыз келетін нәрсені жазыңыз.
Dialogue: 0,0:19:33.17,0:19:36.17,Default,,0,0,0,,Сен мықтысың, солай ма? (Мистер) А?
Dialogue: 0,0:19:36.17,0:19:39.17,Default,,0,0,0,,Сіз өзіңіздің әлсіздігіңізді қалқан ретінде пайдаланасыз.
Dialogue: 0,0:19:39.17,0:19:41.18,Default,,0,0,0,,Мен бақытсызмын
Dialogue: 0,0:19:41.18,0:19:43.18,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:19:45.18,0:19:49.18,Default,,0,0,0,,Мен мұны істеймін. Мен байқап көргім келетін нәрсе бар.
Dialogue: 0,0:19:49.18,0:19:53.19,Default,,0,0,0,,Жақсы, қазір...
Dialogue: 0,0:19:53.19,0:19:56.19,Default,,0,0,0,,Мен тек концертмейстер бола аламын (синбэк) Бұл не?
Dialogue: 0,0:19:56.19,0:19:59.19,Default,,0,0,0,,Шайқас нәтижесін патшаға хабарлау...
Dialogue: 0,0:19:59.19,0:20:02.20,Default,,0,0,0,,Сіз көрерменсіз бе?
Dialogue: 0,0:20:02.20,0:20:05.20,Default,,0,0,0,,Діни қызметкер қылыш ұстай алмайды.
Dialogue: 0,0:20:05.20,0:20:07.20,Default,,0,0,0,,Не?
Dialogue: 0,0:20:07.20,0:20:10.20,Default,,0,0,0,,Менде осы тізбек пен маска болғанша
Dialogue: 0,0:20:10.20,0:20:12.21,Default,,0,0,0,,Мен қылыш емес, семсермін.
Dialogue: 0,0:20:12.21,0:20:18.21,Default,,0,0,0,,Мен шайқасты құдайдың алтер-эгосы ретінде бақылап, патшаға хабарлауым керек.
Dialogue: 0,0:20:18.21,0:20:20.21,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:20:20.21,0:20:23.22,Default,,0,0,0,,Кедергі жасама, артымда қал.
Dialogue: 0,0:20:23.22,0:20:26.22,Default,,0,0,0,,Не? (Кашису) Хмм...
Dialogue: 0,0:20:26.22,0:20:28.22,Default,,0,0,0,,Адонис па?
Dialogue: 0,0:20:28.22,0:20:31.23,Default,,0,0,0,,Қолдарыңыз...
Dialogue: 0,0:20:32.23,0:20:36.23,Default,,0,0,0,,Көрдім, тіпті қасиетті күл де емдей алмады...
Dialogue: 0,0:20:36.23,0:20:39.23,Default,,0,0,0,,Мен тек сол мақсатпен «ішке» кірген жоқпын.
Dialogue: 0,0:20:39.23,0:20:41.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:41.24,0:20:43.24,Default,,0,0,0,,Екеуің бір-біріңді танисыңдар ма?
Dialogue: 0,0:20:43.24,0:20:45.24,Default,,0,0,0,,Біз ата-ана және баламыз.
Dialogue: 0,0:20:45.24,0:20:48.24,Default,,0,0,0,,Ата-ана мен бала? Иә
Dialogue: 0,0:20:48.24,0:20:52.25,Default,,0,0,0,,Бірге қылыш ұстай білу бір ғанибет.
Dialogue: 0,0:20:52.25,0:20:56.25,Default,,0,0,0,,Сонда Адонис шынымен де зұлым қылышшы болған ба?
Dialogue: 0,0:20:56.25,0:20:59.25,Default,,0,0,0,,Жоқ, біз, Коллинз отбасы,
Dialogue: 0,0:20:59.25,0:21:03.26,Default,,0,0,0,,«Сыртта» болса да, ол дұрыс та, бұрыс та емес.
Dialogue: 0,0:21:03.26,0:21:05.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:05.26,0:21:08.26,Default,,0,0,0,,Тек осы катакомбаны қорғау үшін.
Dialogue: 0,0:21:08.26,0:21:10.26,Default,,0,0,0,,Бұл ұрпақтан-ұрпаққа жалғасып келе жатқан отбасылық миссия.
Dialogue: 0,0:21:10.26,0:21:14.27,Default,,0,0,0,,Дұрыс та, бұрыс та емес...
Dialogue: 0,0:21:14.27,0:21:18.27,Default,,0,0,0,,Олай болса, біраз үйреніп алайық!
Dialogue: 0,0:21:18.27,0:21:20.27,Default,,0,0,0,,Libret Formation нұсқаулары!
Dialogue: 0,0:21:20.27,0:21:22.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:30.79,0:21:35.79,Default,,0,0,0,,Қарқынды ұстанып, жүрейік!
Dialogue: 0,0:21:35.79,0:21:39.79,Default,,0,0,0,,《Бұл не деген шаттық...》
Dialogue: 0,0:21:39.79,0:21:42.80,Default,,0,0,0,,《Бұл менің бірінші рет》
Dialogue: 0,0:21:45.80,0:21:47.80,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:21:47.80,0:21:49.80,Default,,0,0,0,,Балалар, меннен озып кетпеңдер!
Dialogue: 0,0:21:49.80,0:21:52.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:52.81,0:21:55.81,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:22:00.31,0:22:20.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:20.33,0:22:34.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:34.35,0:22:54.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:54.37,0:22:57.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:57.37,0:23:17.39,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:17.39,0:23:27.40,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:30.40,0:23:33.41,Default,,0,0,0,,Сұрақ! Неліктен? (Джинбек) Мына жерді бекініс етіп сал.
Dialogue: 0,0:23:33.41,0:23:36.41,Default,,0,0,0,,Бұл жақсы ма? (Кити) Кедергілерді өзгерту заңы
Dialogue: 0,0:23:36.41,0:23:39.41,Default,,0,0,0,,Мен өмір сүруге тұрарлық деп есептеймін...
Dialogue: 0,0:23:40.91,0:23:46.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory