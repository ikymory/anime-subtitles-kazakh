Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.50,Default,,0,0,0,,`` Өткен күн үшін рахмет айтқым келеді.
Dialogue: 0,0:00:03.50,0:00:06.50,Default,,0,0,0,,Мен сендерді сарай балына шақырғым келеді.
Dialogue: 0,0:00:06.50,0:00:10.51,Default,,0,0,0,,Мен естіген құсқа хабар жаздым».
Dialogue: 0,0:00:10.51,0:00:12.51,Default,,0,0,0,,Шерри…
Dialogue: 0,0:00:12.51,0:00:16.51,Default,,0,0,0,,А... не... бұл не?
Dialogue: 0,0:00:16.51,0:00:19.52,Default,,0,0,0,,Бұл менің киген менің сүйікті көйлегім.
Dialogue: 0,0:00:19.52,0:00:23.52,Default,,0,0,0,,Сізге өте жарасады, рахмет...
Dialogue: 0,0:00:23.52,0:00:25.52,Default,,0,0,0,,Эй, бұл жақсы.
Dialogue: 0,0:00:25.52,0:00:28.52,Default,,0,0,0,,Бұл ең жақсы сақина
Dialogue: 0,0:00:28.52,0:00:31.53,Default,,0,0,0,,Нағыз әдемі шаш.
Dialogue: 0,0:00:31.53,0:00:34.53,Default,,0,0,0,,Егер сіз күмісті қолдансаңыз, одан да жақсырақ болар еді.
Dialogue: 0,0:00:34.53,0:00:36.53,Default,,0,0,0,,А... а...
Dialogue: 0,0:00:36.53,0:00:38.53,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:38.53,0:00:58.55,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:58.55,0:01:18.57,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:18.57,0:01:38.59,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:38.59,0:01:58.61,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:58.61,0:02:07.62,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:12.63,0:02:14.63,Default,,0,0,0,,Бұл катакомбалардың кейіпкері ме?
Dialogue: 0,0:02:14.63,0:02:17.63,Default,,0,0,0,,Мен мұны жабайылық деп естідім...
Dialogue: 0,0:02:17.63,0:02:20.64,Default,,0,0,0,,Мен оның соншалықты кішкентай екеніне сене алмаймын.
Dialogue: 0,0:02:20.64,0:02:23.64,Default,,0,0,0,,《Адонис және басқалары да келеді, солай ма? 》
Dialogue: 0,0:02:25.64,0:02:28.64,Default,,0,0,0,,Ой, бұл ақымақ күшті қылыш қолданушы ма?
Dialogue: 0,0:02:28.64,0:02:31.65,Default,,0,0,0,,Қолдары өсек-аяңға қарамастан жіңішке.
Dialogue: 0,0:02:31.65,0:02:33.65,Default,,0,0,0,,Иә? Хехе
Dialogue: 0,0:02:33.65,0:02:36.65,Default,,0,0,0,,Уау! Увааааааааааааааааааааа
Dialogue: 0,0:02:36.65,0:02:40.66,Default,,0,0,0,,Егер сен маған тиетін болсаң, бір қолды қолдануға дайын бол.
Dialogue: 0,0:02:40.66,0:02:42.66,Default,,0,0,0,,О! қоңырау
Dialogue: 0,0:02:42.66,0:02:45.66,Default,,0,0,0,,Мынандай сүйкімді түрімен, қандай аң
Dialogue: 0,0:02:45.66,0:02:49.67,Default,,0,0,0,,Жоқ, жоқ, Катакомбаның кейіпкері осындай болуы керек.
Dialogue: 0,0:02:49.67,0:02:52.67,Default,,0,0,0,,Беннетт Гиннес
Dialogue: 0,0:02:52.67,0:02:55.67,Default,,0,0,0,,Мен шынымен де Катакомбадағы жекпе-жектен өз костюміммен келдім.
Dialogue: 0,0:02:55.67,0:02:59.68,Default,,0,0,0,,Біз допта орынсызбыз.
Dialogue: 0,0:02:59.68,0:03:01.68,Default,,0,0,0,,Әзілдің мәні де осы.
Dialogue: 0,0:03:01.68,0:03:03.68,Default,,0,0,0,,Бізге де сіз ұнайсыз.
Dialogue: 0,0:03:03.68,0:03:07.68,Default,,0,0,0,,Маған айуандықпен қарау керек.
Dialogue: 0,0:03:07.68,0:03:11.69,Default,,0,0,0,,Адонис... сен массың ба?
Dialogue: 0,0:03:11.69,0:03:13.69,Default,,0,0,0,,Хмм... бұл өте дәмді көрінеді.
Dialogue: 0,0:03:13.69,0:03:16.69,Default,,0,0,0,,Уф…
Dialogue: 0,0:03:16.69,0:03:18.69,Default,,0,0,0,,Адонис
Dialogue: 0,0:03:21.70,0:03:23.70,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:03:27.70,0:03:30.71,Default,,0,0,0,,Жақсы, жаман емес.
Dialogue: 0,0:03:30.71,0:03:33.71,Default,,0,0,0,,Не? Ха
Dialogue: 0,0:03:33.71,0:03:37.71,Default,,0,0,0,,А... бұл не болды?
Dialogue: 0,0:03:40.72,0:03:43.72,Default,,0,0,0,,(қолдау мен қол шапалақтау)
Dialogue: 0,0:03:43.72,0:03:45.72,Default,,0,0,0,,Даңқ саған
Dialogue: 0,0:03:45.72,0:03:49.73,Default,,0,0,0,,Құдайдың ісімен, асыл «семсер мен таразыға»
Dialogue: 0,0:03:49.73,0:03:53.73,Default,,0,0,0,,Мәңгілік даңқты жырлау
Dialogue: 0,0:03:54.73,0:03:59.74,Default,,0,0,0,,♪(Шерридің ән салған дауысы)
Dialogue: 0,0:03:59.74,0:04:19.76,Default,,0,0,0,,♪～
Dialogue: 0,0:04:19.76,0:04:39.78,Default,,0,0,0,,♪～
Dialogue: 0,0:04:39.78,0:04:42.78,Default,,0,0,0,,♪～
Dialogue: 0,0:04:42.78,0:04:44.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:44.78,0:04:50.79,Default,,0,0,0,,♪(Шерридің ән салған дауысы) 《Маған көрсеткің келгені осы ма?》
Dialogue: 0,0:04:50.79,0:04:52.79,Default,,0,0,0,,((Мен бұдан былай ауыра алмаймын.
Dialogue: 0,0:04:52.79,0:04:55.79,Default,,0,0,0,,Мен олай ойламаймын))
Dialogue: 0,0:04:56.79,0:05:00.80,Default,,0,0,0,,《Ол кездегіден басқаша》
Dialogue: 0,0:05:01.80,0:05:07.80,Default,,0,0,0,,《Көңілді, құдай және қанағаттанарлық》
Dialogue: 0,0:05:07.80,0:05:10.81,Default,,0,0,0,,《Сен қолыңнан келгеннің бәрін жасадың, Шерри》
Dialogue: 0,0:05:11.81,0:05:14.81,Default,,0,0,0,,《Жеңілуге шыдай алмаймын》
Dialogue: 0,0:05:15.81,0:05:18.81,Default,,0,0,0,,《Әр жерде тұрсақ та
Dialogue: 0,0:05:18.81,0:05:22.82,Default,,0,0,0,,Бір-бірімізге бірдей қарым-қатынас жасай алуымыз үшін.
Dialogue: 0,0:05:22.82,0:05:27.82,Default,,0,0,0,,Мен хат жібергім келеді…
Dialogue: 0,0:05:31.83,0:05:34.83,Default,,0,0,0,,Менің сүйікті қызым үйге келген сияқты.
Dialogue: 0,0:05:34.83,0:05:38.83,Default,,0,0,0,,Иа, сен әрқашан кенетсің, Китти.
Dialogue: 0,0:05:38.83,0:05:41.84,Default,,0,0,0,,Қайырлы кеш, Ловерак Белл
Dialogue: 0,0:05:41.84,0:05:44.84,Default,,0,0,0,,Қандай әдемі фигура!
Dialogue: 0,0:05:44.84,0:05:46.84,Default,,0,0,0,,Сіз сияқты біреу
Dialogue: 0,0:05:46.84,0:05:49.85,Default,,0,0,0,,Біздің теңгелер елінде біз оны аспан деп атаймыз.
Dialogue: 0,0:05:49.85,0:05:51.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:51.85,0:05:55.85,Default,,0,0,0,,Оның нені білдіретінін көргіңіз келсе.
Dialogue: 0,0:05:55.85,0:05:58.85,Default,,0,0,0,,Өтінемін, менімен билеңіз.
Dialogue: 0,0:05:58.85,0:06:00.86,Default,,0,0,0,,Мен?
Dialogue: 0,0:06:00.86,0:06:03.86,Default,,0,0,0,,Гүлдермен билейміз Аңдармен билейміз
Dialogue: 0,0:06:03.86,0:06:08.86,Default,,0,0,0,,Неге, біздің сүйікті қызымызда?
Dialogue: 0,0:06:12.87,0:06:14.87,Default,,0,0,0,,Аспан дегеніміз не?
Dialogue: 0,0:06:14.87,0:06:16.87,Default,,0,0,0,,Өз қалауыңыз бойынша
Dialogue: 0,0:06:16.87,0:06:20.88,Default,,0,0,0,,Тегін біл, шын болмысыңды біл
Dialogue: 0,0:06:20.88,0:06:25.88,Default,,0,0,0,,Оған берілме, барлық құлдықтан құтылуға тырыс.
Dialogue: 0,0:06:25.88,0:06:30.89,Default,,0,0,0,,Ақырында тіпті қашуға тырысқанды жеңетін адамға қатысты.
Dialogue: 0,0:06:30.89,0:06:32.89,Default,,0,0,0,,Бұл аспан...
Dialogue: 0,0:06:32.89,0:06:34.89,Default,,0,0,0,,Қадамдар кездейсоқ
Dialogue: 0,0:06:34.89,0:06:36.89,Default,,0,0,0,,Бірақ сөзсіз
Dialogue: 0,0:06:36.89,0:06:38.89,Default,,0,0,0,,Қадам жасамасаң, тумайсың.
Dialogue: 0,0:06:38.89,0:06:41.90,Default,,0,0,0,,Сыртқа шығып өл
Dialogue: 0,0:06:41.90,0:06:43.90,Default,,0,0,0,,Барлығы бос
Dialogue: 0,0:06:43.90,0:06:45.90,Default,,0,0,0,,Барлығынан азат
Dialogue: 0,0:06:45.90,0:06:48.90,Default,,0,0,0,,Тек қозғалып, ағып жүр.
Dialogue: 0,0:06:48.90,0:06:50.91,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:53.91,0:06:58.91,Default,,0,0,0,,Сен бірінші болып Тицианның қылышын сындырдың.
Dialogue: 0,0:06:58.91,0:07:00.92,Default,,0,0,0,,Жаншылып қалғысы келген сияқты.
Dialogue: 0,0:07:00.92,0:07:02.92,Default,,0,0,0,,Сізді ұстай алмағанның орнына?
Dialogue: 0,0:07:02.92,0:07:04.92,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:04.92,0:07:08.92,Default,,0,0,0,,Жақынмын деп өсек таратқан сен сияқтысың.
Dialogue: 0,0:07:08.92,0:07:12.93,Default,,0,0,0,,Я, ол жалғыз қалды.
Dialogue: 0,0:07:12.93,0:07:16.93,Default,,0,0,0,,Ол кісінің мұңын түсіну қиын.
Dialogue: 0,0:07:16.93,0:07:19.94,Default,,0,0,0,,Сіз осылай шақырдыңыз ба?
Dialogue: 0,0:07:19.94,0:07:22.94,Default,,0,0,0,,Анагачи Байланысты емес
Dialogue: 0,0:07:22.94,0:07:24.94,Default,,0,0,0,,Катакомбаларда
Dialogue: 0,0:07:24.94,0:07:28.94,Default,,0,0,0,,Мен сенің әкең Том Коллинзбен қылыш айқастырдым...
Dialogue: 0,0:07:28.94,0:07:31.95,Default,,0,0,0,,Жеңілген мен білемін
Dialogue: 0,0:07:31.95,0:07:35.95,Default,,0,0,0,,Өлім құсы маған қауесетті айтқандықтан (гуф) мен көріп тұрмын ...
Dialogue: 0,0:07:35.95,0:07:37.95,Default,,0,0,0,,Менің әкеме де ұнайды.
Dialogue: 0,0:07:37.95,0:07:41.96,Default,,0,0,0,,Катакомбаларды қорғау кезінде қаза тапты.
Dialogue: 0,0:07:41.96,0:07:44.96,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,0:07:44.96,0:07:48.96,Default,,0,0,0,,Мен сенің әкеңнің қылышын ұстаймын.
Dialogue: 0,0:07:48.96,0:07:51.97,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:07:51.97,0:07:53.97,Default,,0,0,0,,Қылыш алғың келсе
Dialogue: 0,0:07:53.97,0:07:56.97,Default,,0,0,0,,Өлімнен алған қылыш
Dialogue: 0,0:07:56.97,0:07:59.98,Default,,0,0,0,,Барлығы қайтыс болған отбасына қайтарылуы керек.
Dialogue: 0,0:07:59.98,0:08:02.98,Default,,0,0,0,,Бұл бас қылышшының үкімі ме?
Dialogue: 0,0:08:02.98,0:08:04.98,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:04.98,0:08:06.98,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:08:08.98,0:08:11.99,Default,,0,0,0,,Қылышшы ретінде мен сізге Iai үшін өтініш білдіремін.
Dialogue: 0,0:08:11.99,0:08:13.99,Default,,0,0,0,,Неліктен? Адонис
Dialogue: 0,0:08:13.99,0:08:15.99,Default,,0,0,0,,Бамбук!
Dialogue: 0,0:08:17.99,0:08:20.00,Default,,0,0,0,,Бұл ән айтатын ойын-сауық.
Dialogue: 0,0:08:20.00,0:08:25.00,Default,,0,0,0,,Мені бас қылышшы қылышшы ретінде ұстағанын қалаймын.
Dialogue: 0,0:08:25.00,0:08:28.00,Default,,0,0,0,,Менің осы жерде және қазір жауап беру ниетім жоқ.
Dialogue: 0,0:08:34.01,0:08:36.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:39.01,0:08:43.02,Default,,0,0,0,,Не болды? Екеуіңнің араларыңда қылыш ұрыс па?
Dialogue: 0,0:08:43.02,0:08:47.02,Default,,0,0,0,,Біз осы жерде соғысамыз ба? Көрермендер жоқ.
Dialogue: 0,0:08:47.02,0:08:51.03,Default,,0,0,0,,Куәгерлер жоқ. Бұл босқа.
Dialogue: 0,0:08:51.03,0:08:54.03,Default,,0,0,0,,Кил... Кил емес
Dialogue: 0,0:08:54.03,0:08:56.03,Default,,0,0,0,,Адонис қылышын суырған болады
Dialogue: 0,0:08:56.03,0:08:59.03,Default,,0,0,0,,Мен әлі қылышымды суырмаймын.
Dialogue: 0,0:08:59.03,0:09:02.04,Default,,0,0,0,,Қылышыңды суырмайсың ба?
Dialogue: 0,0:09:02.04,0:09:04.04,Default,,0,0,0,,Бұл қабілет не өзі?
Dialogue: 0,0:09:04.04,0:09:07.04,Default,,0,0,0,,Қарғыс атсын... Ах!
Dialogue: 0,0:09:07.04,0:09:10.05,Default,,0,0,0,,Гуф... (Дін қызметкері) Ғафф-сама!
Dialogue: 0,0:09:12.05,0:09:14.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:14.05,0:09:16.05,Default,,0,0,0,,《Құлыптау семсерінің құлпы ашылды》
Dialogue: 0,0:09:16.05,0:09:19.05,Default,,0,0,0,,《Құдайдың қалауы》
Dialogue: 0,0:09:19.05,0:09:21.06,Default,,0,0,0,,《Оны өлтір...》
Dialogue: 0,0:09:23.06,0:09:26.06,Default,,0,0,0,,Яааа
Dialogue: 0,0:09:30.07,0:09:32.07,Default,,0,0,0,,Оған тұрарлық емес
Dialogue: 0,0:09:32.07,0:09:35.07,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл ғажайып қылыш.
Dialogue: 0,0:09:35.07,0:09:39.07,Default,,0,0,0,,Бұны менің меншігіме айналдыру үшін көп күш жұмсалды.
Dialogue: 0,0:09:39.07,0:09:41.08,Default,,0,0,0,,О Киль...
Dialogue: 0,0:09:41.08,0:09:43.08,Default,,0,0,0,,Не...
Dialogue: 0,0:09:43.08,0:09:45.08,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:09:45.08,0:09:49.08,Default,,0,0,0,,Сіз өзіңізге ұнайтын жолмен өлтіре аласыз (гуф)... уф...
Dialogue: 0,0:09:49.08,0:09:52.09,Default,,0,0,0,,Әй, қарт кісі, жақсысың ба? Ауырған жоқсың ба?
Dialogue: 0,0:09:53.09,0:09:55.09,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:55.09,0:09:58.09,Default,,0,0,0,,Ойнайық...
Dialogue: 0,0:09:58.09,0:10:00.10,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:10:00.10,0:10:03.10,Default,,0,0,0,,Мені Ловерак Белл күтіп тұр.
Dialogue: 0,0:10:03.10,0:10:07.10,Default,,0,0,0,,Ннн! (Киль) Мұның бәрі сенің арқаң, Адонис.
Dialogue: 0,0:10:07.10,0:10:11.11,Default,,0,0,0,,Сенсіз бұл қылыш болмас еді.
Dialogue: 0,0:10:11.11,0:10:14.11,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:16.11,0:10:18.11,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:19.11,0:10:21.12,Default,,0,0,0,,♪(Шерридің ән салған дауысы)
Dialogue: 0,0:10:23.12,0:10:25.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:29.12,0:10:31.13,Default,,0,0,0,,Мен адамдардың өмірін сақтайтын жұмыста істедім
Dialogue: 0,0:10:31.13,0:10:33.13,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:33.13,0:10:39.13,Default,,0,0,0,,Даусыммен Алланың хабарын айтайын.
Dialogue: 0,0:10:39.13,0:10:44.14,Default,,0,0,0,,Бүгін түнде жын Құдай ағашының тамырларын жұтып қоюға тырысады.
Dialogue: 0,0:10:44.14,0:10:48.14,Default,,0,0,0,,Жаман қылышпен туған
Dialogue: 0,0:10:48.14,0:10:52.15,Default,,0,0,0,,Оның есімі Қылыш шебері Киль-Луара Ха...
Dialogue: 0,0:10:52.15,0:10:56.15,Default,,0,0,0,,Осы арқылы мен сізге қылышпен күресу миссиясын жіберемін.
Dialogue: 0,0:10:56.15,0:11:01.16,Default,,0,0,0,,Киль-Луарды жеңіп, өлім жазасына кесіңіз.
Dialogue: 0,0:11:01.16,0:11:05.16,Default,,0,0,0,,Бұл шайқаста семсер алатын адамның аты...
Dialogue: 0,0:11:08.16,0:11:12.17,Default,,0,0,0,,Саяхаттың есігін қағатын, Ловерак Белл!
Dialogue: 0,0:11:12.17,0:11:15.17,Default,,0,0,0,,Ха... (Шерри) Бір ғана адам!
Dialogue: 0,0:11:16.17,0:11:18.17,Default,,0,0,0,,Ха... (діни қызметкерлер) Ханшайым!
Dialogue: 0,0:11:18.17,0:11:20.18,Default,,0,0,0,,Шери! Жүгіріп кету!
Dialogue: 0,0:11:20.18,0:11:22.18,Default,,0,0,0,,Қаш, Белл!
Dialogue: 0,0:11:24.18,0:11:26.18,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:27.68,0:11:29.68,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:11:29.68,0:11:32.69,Default,,0,0,0,,Қара қоңырауды жақсы көр! Бұл қайда!
Dialogue: 0,0:11:34.69,0:11:38.69,Default,,0,0,0,,Қара түсті жақсы көр! (Діни қызметкерлер) Тах!
Dialogue: 0,0:11:40.70,0:11:42.70,Default,,0,0,0,,Иә? (Ген) Құдай айтады
Dialogue: 0,0:11:42.70,0:11:46.70,Default,,0,0,0,,Мен сізбен айналысатын адам емеспін...!
Dialogue: 0,0:11:47.70,0:11:50.71,Default,,0,0,0,,Хмф (салқын) Ха!
Dialogue: 0,0:11:50.71,0:11:52.71,Default,,0,0,0,,Кішкентай бәйбішелер
Dialogue: 0,0:11:52.71,0:11:56.71,Default,,0,0,0,,Нидхог Құдай Сөзіне не дейді?
Dialogue: 0,0:11:56.71,0:11:59.71,Default,,0,0,0,,Әй, қылыш Кильді жұтып қояйын деп тұр.
Dialogue: 0,0:11:59.71,0:12:02.72,Default,,0,0,0,,Бұл дәл...
Dialogue: 0,0:12:03.72,0:12:06.72,Default,,0,0,0,,Га (Беннет) Иә
Dialogue: 0,0:12:06.72,0:12:08.72,Default,,0,0,0,,Хааа
Dialogue: 0,0:12:09.72,0:12:11.73,Default,,0,0,0,,Ах (Беннет)
Dialogue: 0,0:12:11.73,0:12:14.73,Default,,0,0,0,,Кил! Мен мындамын!
Dialogue: 0,0:12:14.73,0:12:17.73,Default,,0,0,0,,Хааа! Салтанат!
Dialogue: 0,0:12:19.73,0:12:22.74,Default,,0,0,0,,Қара түсті жақсы көр!
Dialogue: 0,0:12:24.74,0:12:27.74,Default,,0,0,0,,Қалай... есептеулерді кесу деген нені білдіреді?
Dialogue: 0,0:12:27.74,0:12:29.74,Default,,0,0,0,,Сенің қылышың қайда?
Dialogue: 0,0:12:29.74,0:12:32.75,Default,,0,0,0,,Сені қылышсыз өлтіруімді қалайсың ба?
Dialogue: 0,0:12:32.75,0:12:35.75,Default,,0,0,0,,Әлгі жігіттің қолы...
Dialogue: 0,0:12:35.75,0:12:38.75,Default,,0,0,0,,)
Dialogue: 0,0:12:38.75,0:12:42.76,Default,,0,0,0,,)
Dialogue: 0,0:12:43.76,0:12:45.76,Default,,0,0,0,,《Неге...》
Dialogue: 0,0:12:45.76,0:12:48.76,Default,,0,0,0,,Қоңырау! Құдай сені таңдады!
Dialogue: 0,0:12:48.76,0:12:53.77,Default,,0,0,0,,Бұл сіздің саяхатқа шығудың соңғы миссиясы!
Dialogue: 0,0:12:53.77,0:12:55.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:57.77,0:13:01.78,Default,,0,0,0,,Шолақ қылыш! бұл соңғы сынақ
Dialogue: 0,0:13:01.78,0:13:05.78,Default,,0,0,0,,Ха... не?
Dialogue: 0,0:13:06.78,0:13:11.79,Default,,0,0,0,,《Мен сені алғаш рет кездестірген сияқтымын...》
Dialogue: 0,0:13:11.79,0:13:13.79,Default,,0,0,0,,)
Dialogue: 0,0:13:13.79,0:13:15.79,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:16.79,0:13:21.80,Default,,0,0,0,,《Түсіндім, өзгерген менмін》
Dialogue: 0,0:13:21.80,0:13:23.80,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:13:23.80,0:13:36.81,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:36.81,0:13:39.81,Default,,0,0,0,,Кеттік, жолдасым.
Dialogue: 0,0:13:39.81,0:13:44.82,Default,,0,0,0,,Тұтынушылар тағатсыздана күтуде.
Dialogue: 0,0:13:44.82,0:13:46.82,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:13:50.83,0:13:52.83,Default,,0,0,0,,Жабу! Китти бәрі!
Dialogue: 0,0:13:52.83,0:13:55.83,Default,,0,0,0,,Ол адам менмін!
Dialogue: 0,0:13:55.83,0:13:59.83,Default,,0,0,0,,Ақыры қылышты қолыңа алдың ба? Ловерак
Dialogue: 0,0:14:00.84,0:14:03.84,Default,,0,0,0,,Қоңырау! Бұл адамның тістері!
Dialogue: 0,0:14:06.84,0:14:08.84,Default,,0,0,0,,Мен білмейтін қыз…➡
Dialogue: 0,0:14:08.84,0:14:11.85,Default,,0,0,0,,Сиқырдың ішіп-жеу әсерімен сусындаған қылыш.
Dialogue: 0,0:14:11.85,0:14:13.85,Default,,0,0,0,,Өлшемді үзілу пышағында қалқан жоқ!
Dialogue: 0,0:14:13.85,0:14:16.85,Default,,0,0,0,,Рахмет Китти
Dialogue: 0,0:14:18.85,0:14:22.86,Default,,0,0,0,,Бұл Иайдо, түсіндің бе?
Dialogue: 0,0:14:22.86,0:14:24.86,Default,,0,0,0,,《Кил…》
Dialogue: 0,0:14:24.86,0:14:28.86,Default,,0,0,0,,《Менімен кездесіп, қылыш алмасыңдар
Dialogue: 0,0:14:28.86,0:14:31.87,Default,,0,0,0,,Себебі мен бұл қылышты сындырдым...》
Dialogue: 0,0:14:31.87,0:14:36.87,Default,,0,0,0,,Мұң жаңбыры тоңып, аштыққа ұшыратады.
Dialogue: 0,0:14:36.87,0:14:39.87,Default,,0,0,0,,Мен білемін (киль) иә
Dialogue: 0,0:14:46.88,0:14:49.88,Default,,0,0,0,,Ннн! Хааа!
Dialogue: 0,0:14:53.89,0:14:55.89,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:14:57.89,0:15:00.90,Default,,0,0,0,,Қалай... менің сүйікті қызымда...
Dialogue: 0,0:15:00.90,0:15:04.90,Default,,0,0,0,,Тіпті өлшемді үзілудің жүзін де кесуге бола ма?
Dialogue: 0,0:15:05.90,0:15:08.90,Default,,0,0,0,,Бұл сенің мақтаныш қылышың ба?
Dialogue: 0,0:15:08.90,0:15:12.91,Default,,0,0,0,,Ескі қылыш әлдеқайда жақсы болды!
Dialogue: 0,0:15:12.91,0:15:14.91,Default,,0,0,0,,Дея!
Dialogue: 0,0:15:14.91,0:15:17.91,Default,,0,0,0,,Әйтеуір, солай қалдырдым.
Dialogue: 0,0:15:17.91,0:15:20.92,Default,,0,0,0,,Тіпті, қылыштай жанымды жедің!
Dialogue: 0,0:15:20.92,0:15:23.92,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:15:23.92,0:15:26.92,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:15:26.92,0:15:28.92,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:15:28.92,0:15:34.93,Default,,0,0,0,,Хехехехехехе...
Dialogue: 0,0:15:34.93,0:15:36.93,Default,,0,0,0,,Мына бейбақ... қылышшы...
Dialogue: 0,0:15:36.93,0:15:39.93,Default,,0,0,0,,Сіздің жеміңіз емес!
Dialogue: 0,0:15:39.93,0:15:42.94,Default,,0,0,0,,Ннн!
Dialogue: 0,0:15:44.94,0:15:48.94,Default,,0,0,0,,Сен... мені кесіп алмақсың.
Dialogue: 0,0:15:49.94,0:15:52.95,Default,,0,0,0,,Ия...
Dialogue: 0,0:15:52.95,0:15:54.95,Default,,0,0,0,,Уф…
Dialogue: 0,0:15:55.95,0:15:59.95,Default,,0,0,0,,Қара түсті жақсы көр!
Dialogue: 0,0:15:59.95,0:16:02.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:02.96,0:16:05.96,Default,,0,0,0,,Ннн! Да!
Dialogue: 0,0:16:06.96,0:16:10.97,Default,,0,0,0,,Маған біреу көмектессін! өтінемін!
Dialogue: 0,0:16:10.97,0:16:12.97,Default,,0,0,0,,Қоңырауға көмектес!
Dialogue: 0,0:16:12.97,0:16:15.97,Default,,0,0,0,,Қарғыс атсын... Құдайдың әулие қызы Алланың сөзіне қайшы келеді.
Dialogue: 0,0:16:15.97,0:16:18.97,Default,,0,0,0,,Көмек сұрап ұрысты ластайсыз ба?
Dialogue: 0,0:16:18.97,0:16:20.98,Default,,0,0,0,,Ах! Мұнан кеттік!
Dialogue: 0,0:16:20.98,0:16:23.98,Default,,0,0,0,,Уау! (соққы дыбысы)
Dialogue: 0,0:16:23.98,0:16:25.98,Default,,0,0,0,,Қоңырау!
Dialogue: 0,0:16:27.98,0:16:29.98,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:16:29.98,0:16:33.99,Default,,0,0,0,,Менде бәрі жақсы, Шерри.
Dialogue: 0,0:16:34.99,0:16:38.99,Default,,0,0,0,,Сіз өте қуанышты ән айттыңыз.
Dialogue: 0,0:16:38.99,0:16:42.00,Default,,0,0,0,,А... у...
Dialogue: 0,0:16:42.00,0:16:50.00,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:16:51.01,0:16:53.01,Default,,0,0,0,,《Қылыш емес》
Dialogue: 0,0:16:53.01,0:16:57.01,Default,,0,0,0,,《Құдай ағашы семсершіні жеп жатыр》
Dialogue: 0,0:16:57.01,0:17:00.01,Default,,0,0,0,,Бұл Құдай ма?
Dialogue: 0,0:17:00.01,0:17:05.02,Default,,0,0,0,,Мынау... осы елдің құдайы ма?
Dialogue: 0,0:17:05.02,0:17:07.02,Default,,0,0,0,,(Поконың әкесі) Поко! Түннің осы уақытында қай жақта адасып жүрсің?
Dialogue: 0,0:17:10.02,0:17:15.03,Default,,0,0,0,,《Құдай ағашы мені әлі көрмеді》
Dialogue: 0,0:17:20.03,0:17:24.04,Default,,0,0,0,,《Өлім туралы айтатын құс》
Dialogue: 0,0:17:24.04,0:17:26.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:26.04,0:17:32.05,Default,,0,0,0,,《Нидхог Құдай ағашы туралы қауесеттердегі құс па?》
Dialogue: 0,0:17:32.05,0:17:34.05,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:17:35.05,0:17:38.05,Default,,0,0,0,,Олай болса, Құдай нені білдіреді? 》
Dialogue: 0,0:17:38.05,0:17:40.05,Default,,0,0,0,,《Кімге? 》
Dialogue: 0,0:17:41.06,0:17:46.06,Default,,0,0,0,,Құдай ағашының өзін Нидхог жеп қойды...
Dialogue: 0,0:17:47.06,0:17:49.06,Default,,0,0,0,,Уау! Сіз сөйлесетін адам
Dialogue: 0,0:17:49.06,0:17:51.07,Default,,0,0,0,,Сен жалғыз болғандықтан емес пе?
Dialogue: 0,0:17:51.07,0:17:55.07,Default,,0,0,0,,Әй, қарт кісі, жақсысың ба? Ауырған жоқсың ба?
Dialogue: 0,0:18:07.08,0:18:11.09,Default,,0,0,0,,Сіз... күштісіз.
Dialogue: 0,0:18:11.09,0:18:13.09,Default,,0,0,0,,Өкінбе
Dialogue: 0,0:18:19.09,0:18:23.10,Default,,0,0,0,,《Бұл ағашқа ешкім қарап тұрған жоқ》
Dialogue: 0,0:18:23.10,0:18:26.10,Default,,0,0,0,,《Тек... өзім》
Dialogue: 0,0:18:32.11,0:18:37.11,Default,,0,0,0,,Адонис, Бамбукта қашанғы қамауда боласың?
Dialogue: 0,0:18:37.11,0:18:40.11,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:40.11,0:18:43.12,Default,,0,0,0,,Менің айтқым келетін нәрселер өте көп...
Dialogue: 0,0:18:43.12,0:18:46.12,Default,,0,0,0,,Сіз Гаффтан өсек естідіңіз бе?
Dialogue: 0,0:18:46.12,0:18:48.12,Default,,0,0,0,,Ертең ме?
Dialogue: 0,0:18:48.12,0:18:53.13,Default,,0,0,0,,Патша жол есігін ашу үшін кілт дайындап қойды.
Dialogue: 0,0:18:53.13,0:18:57.13,Default,,0,0,0,,Онда соңғы сынақ өтеді.
Dialogue: 0,0:18:57.13,0:18:59.13,Default,,0,0,0,,Және…
Dialogue: 0,0:18:59.13,0:19:03.14,Default,,0,0,0,,Ендеше бірге саяхатқа шығайық
Dialogue: 0,0:19:05.14,0:19:09.14,Default,,0,0,0,,Сіз келмейінше, мен де сынақтан өтпеймін!
Dialogue: 0,0:19:09.14,0:19:12.15,Default,,0,0,0,,Саған қара, ақымақ!
Dialogue: 0,0:19:20.15,0:19:24.16,Default,,0,0,0,,Ішке қарасаң, кесіп тастаймын!
Dialogue: 0,0:19:26.16,0:19:30.16,Default,,0,0,0,,Мен сені құшақтағым келді. Ол сен болсаң керек.
Dialogue: 0,0:19:38.17,0:19:43.18,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:19:44.18,0:19:46.18,Default,,0,0,0,,( Төсектің сықырлаған дыбысы)
Dialogue: 0,0:19:53.19,0:19:56.19,Default,,0,0,0,,Тіпті саған ғашық болмасам да
Dialogue: 0,0:19:59.19,0:20:01.20,Default,,0,0,0,,( Төсектің сықырлаған дыбысы)
Dialogue: 0,0:20:01.20,0:20:06.20,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:20:06.20,0:20:08.20,Default,,0,0,0,,Адонис…
Dialogue: 0,0:20:09.20,0:20:12.21,Default,,0,0,0,,Мен толық емес өлі адаммын.
Dialogue: 0,0:20:12.21,0:20:16.21,Default,,0,0,0,,Осы бұзылған қолдармен уақыт өткізіңіз.
Dialogue: 0,0:20:16.21,0:20:20.21,Default,,0,0,0,,Мен бір күні толық өліммен азат етемін деп үміттенемін.
Dialogue: 0,0:20:20.21,0:20:25.22,Default,,0,0,0,,Тек күту, өлмеген өмір
Dialogue: 0,0:20:25.22,0:20:27.22,Default,,0,0,0,,Мен қалай сендей боламын?
Dialogue: 0,0:20:27.22,0:20:29.22,Default,,0,0,0,,Осыншама ұзақ өмір сүре ала ма деп ойлаймын.
Dialogue: 0,0:20:29.22,0:20:34.23,Default,,0,0,0,,Содан кейін қайта туыл
Dialogue: 0,0:20:34.23,0:20:38.23,Default,,0,0,0,,Бірдеңе болса... Мен сені тағы туамын.
Dialogue: 0,0:20:38.23,0:20:43.24,Default,,0,0,0,,Ендеше... бірге саяхатқа шығайық.
Dialogue: 0,0:20:46.24,0:20:50.24,Default,,0,0,0,,Менде әлі де растайтын бір нәрсе бар.
Dialogue: 0,0:20:50.24,0:20:53.25,Default,,0,0,0,,Орындалмайынша мен ешқандай уәде бере алмаймын.
Dialogue: 0,0:20:53.25,0:20:56.25,Default,,0,0,0,,Ертең келеді, солай ма?
Dialogue: 0,0:20:58.25,0:21:03.26,Default,,0,0,0,,Сен... неге келгенімді сұрамайсың.
Dialogue: 0,0:21:03.26,0:21:05.26,Default,,0,0,0,,Кез келген бөлме
Dialogue: 0,0:21:05.26,0:21:09.26,Default,,0,0,0,,Сен маған қарағанда осында тұруға лайықсың.
Dialogue: 0,0:21:09.26,0:21:11.27,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:21:11.27,0:21:13.27,Default,,0,0,0,,Расында, сен ақымақсың.
Dialogue: 0,0:21:13.27,0:21:17.27,Default,,0,0,0,,Олай десеңіз, солай болуы керек.
Dialogue: 0,0:21:17.27,0:21:21.28,Default,,0,0,0,,Міндетті түрде келіңіз, тек ертеңге.
Dialogue: 0,0:21:21.28,0:21:25.28,Default,,0,0,0,,Мен барамын, бірақ сен мені күтпейсің.
Dialogue: 0,0:21:25.28,0:21:28.28,Default,,0,0,0,,Тек алға, ақымақ.
Dialogue: 0,0:21:28.28,0:21:30.28,Default,,0,0,0,,Айтпасаң да, рас.
Dialogue: 0,0:21:30.28,0:21:32.29,Default,,0,0,0,,Менмен болма
Dialogue: 0,0:21:34.29,0:21:37.29,Default,,0,0,0,,Кешіріңіз Белл
Dialogue: 0,0:21:42.30,0:21:45.30,Default,,0,0,0,,(Сағат тасының шырылдаған дыбысы)
Dialogue: 0,0:21:46.30,0:21:49.30,Default,,0,0,0,,Мен ақымақпын.
Dialogue: 0,0:21:51.31,0:21:54.31,Default,,0,0,0,,Нағыз ақымақ
Dialogue: 0,0:22:00.82,0:22:20.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:20.84,0:22:38.85,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:38.85,0:22:58.87,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:58.87,0:23:04.88,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:04.88,0:23:17.89,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:17.89,0:23:26.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:30.91,0:23:32.91,Default,,0,0,0,,Мен саяхатшы боламын. Қылыш шебері дегеніміз не?
Dialogue: 0,0:23:32.91,0:23:34.91,Default,,0,0,0,,Сіз не үшін өлу үшін саяхатқа барасыз?
Dialogue: 0,0:23:34.91,0:23:37.91,Default,,0,0,0,,Мен қателескен жоқпын. Мен бұлай болатынын білдім.
Dialogue: 0,0:23:37.91,0:23:39.91,Default,,0,0,0,,Мен сенің бөлмеңде күтемін.
Dialogue: 0,0:23:41.41,0:23:47.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory