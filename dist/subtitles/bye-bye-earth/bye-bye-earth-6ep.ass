Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.50,0:00:04.50,Default,,0,0,0,,Бұл келе жатыр! (Джинбек) Балалар
Dialogue: 0,0:00:04.50,0:00:06.50,Default,,0,0,0,,Оны басып озуға болмайды!
Dialogue: 0,0:00:06.50,0:00:09.51,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:00:09.51,0:00:12.51,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:00:17.51,0:00:20.52,Default,,0,0,0,,Жақсылық пен жамандықтың аралас тобы
Dialogue: 0,0:00:20.52,0:00:23.52,Default,,0,0,0,,Қандай қылыш музыкасын тыңдауға болады?
Dialogue: 0,0:00:23.52,0:00:25.52,Default,,0,0,0,,Иә
Dialogue: 0,0:00:25.52,0:00:45.54,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:45.54,0:01:05.56,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:05.56,0:01:25.58,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:25.58,0:01:45.60,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:45.60,0:01:54.61,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:55.61,0:01:58.61,Default,,0,0,0,,хм/сағ хм/сағ
Dialogue: 0,0:01:58.61,0:02:02.62,Default,,0,0,0,,《Мен не істеуім керек? Мен не істеуім керек...》
Dialogue: 0,0:02:04.62,0:02:07.62,Default,,0,0,0,,Сіз мұны жасадыңыз ба? (Джинс) Жалпы
Dialogue: 0,0:02:07.62,0:02:09.63,Default,,0,0,0,,Қысқасы
Dialogue: 0,0:02:09.63,0:02:13.63,Default,,0,0,0,,Үшінші әрекет (жин back) де бірдеңе айтады
Dialogue: 0,0:02:13.63,0:02:15.63,Default,,0,0,0,,Барлығын пісіріңіз
Dialogue: 0,0:02:15.63,0:02:19.64,Default,,0,0,0,,Хмм... Оны пісіргіңіз келе ме? (Жақсылық) Иә.
Dialogue: 0,0:02:19.64,0:02:22.64,Default,,0,0,0,,Okay, you won't fight at all.
Dialogue: 0,0:02:22.64,0:02:25.64,Default,,0,0,0,,Ойлануды жалғастыр (Гендер) Иә
Dialogue: 0,0:02:25.64,0:02:29.65,Default,,0,0,0,,Олай болса, менің ойымша, нақты нәрсеге уақыт келді.
Dialogue: 0,0:02:31.65,0:02:34.65,Default,,0,0,0,,Бұл көпір біздің базамыз.
Dialogue: 0,0:02:34.65,0:02:38.65,Default,,0,0,0,,Мұнда олар тек алдыңғы және артқы жағынан шыға алады.
Dialogue: 0,0:02:38.65,0:02:41.66,Default,,0,0,0,,Бұл жерді бекініс етіп сал.
Dialogue: 0,0:02:45.66,0:02:50.67,Default,,0,0,0,,(Moaning of the Dead Soldiers)
Dialogue: 0,0:02:50.67,0:03:01.68,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:01.68,0:03:04.68,Default,,0,0,0,,Ммммм
Dialogue: 0,0:03:04.68,0:03:06.68,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:03:07.68,0:03:09.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:12.69,0:03:15.69,Default,,0,0,0,,Ah... Mr. Jimback!
Dialogue: 0,0:03:15.69,0:03:27.70,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:27.70,0:03:29.71,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:03:29.71,0:03:31.71,Default,,0,0,0,,...
Dialogue: 0,0:03:31.71,0:03:41.72,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:41.72,0:03:44.72,Default,,0,0,0,,Кедергілерді өзгерту заңы
Dialogue: 0,0:03:44.72,0:03:48.72,Default,,0,0,0,,Ей, бірінен соң бірі барайық!
Dialogue: 0,0:03:55.73,0:03:58.73,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:03:58.73,0:04:00.74,Default,,0,0,0,,Бұл не деген жігіттер!
Dialogue: 0,0:04:00.74,0:04:02.74,Default,,0,0,0,,Жібер!
Dialogue: 0,0:04:02.74,0:04:04.74,Default,,0,0,0,,Ку... Ах...
Dialogue: 0,0:04:05.74,0:04:07.74,Default,,0,0,0,,Осы түннің өзінде оған соншалықты адал күтім жасап отыр ма?
Dialogue: 0,0:04:08.74,0:04:10.75,Default,,0,0,0,,Мм... (өлген сарбаздар ыңылайды)
Dialogue: 0,0:04:10.75,0:04:13.75,Default,,0,0,0,,Нннн... нннннн... (Өлген сарбаздардың ыңырануы)
Dialogue: 0,0:04:13.75,0:04:16.75,Default,,0,0,0,,Адонис! Боқ...
Dialogue: 0,0:04:17.75,0:04:19.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:21.76,0:04:23.76,Default,,0,0,0,,Чи…
Dialogue: 0,0:04:24.76,0:04:27.76,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:04:27.76,0:04:29.77,Default,,0,0,0,,Не?
Dialogue: 0,0:04:29.77,0:04:31.77,Default,,0,0,0,,(Қылыш айқайы)
Dialogue: 0,0:04:31.77,0:04:33.77,Default,,0,0,0,,《Өшіру...》
Dialogue: 0,0:04:33.77,0:04:37.77,Default,,0,0,0,,《The sword... screams...》
Dialogue: 0,0:04:37.77,0:04:39.78,Default,,0,0,0,,《Rotting down》
Dialogue: 0,0:04:39.78,0:04:41.78,Default,,0,0,0,,(Қылыш айқайы)
Dialogue: 0,0:04:41.78,0:04:46.78,Default,,0,0,0,,Сіз суарыңыз қыз... өз фигураңызбен ойнайсыз.
Dialogue: 0,0:04:46.78,0:04:48.78,Default,,0,0,0,,Сіз күткендей.
Dialogue: 0,0:04:48.78,0:04:52.79,Default,,0,0,0,,Еркін көңіл көтеруге болатын ойыншықтарды сындыру.
Dialogue: 0,0:04:52.79,0:04:54.79,Default,,0,0,0,,Бұл мен де жиі жасайтын нәрсе.
Dialogue: 0,0:04:54.79,0:04:58.79,Default,,0,0,0,,I'm starting to get scared of you.
Dialogue: 0,0:04:58.79,0:05:00.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:00.80,0:05:03.80,Default,,0,0,0,,Ах... уау
Dialogue: 0,0:05:03.80,0:05:05.80,Default,,0,0,0,,Бұлт!
Dialogue: 0,0:05:05.80,0:05:09.81,Default,,0,0,0,,Бұл! Ха, мына жігіт... Нгх.
Dialogue: 0,0:05:09.81,0:05:11.81,Default,,0,0,0,,(Өлген сарбаздардың мұңы)
Dialogue: 0,0:05:11.81,0:05:13.81,Default,,0,0,0,,...
Dialogue: 0,0:05:14.81,0:05:16.81,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:05:16.81,0:05:19.82,Default,,0,0,0,,Ах... (Бенедиктин) Ахх.
Dialogue: 0,0:05:19.82,0:05:22.82,Default,,0,0,0,,Ннн яааа
Dialogue: 0,0:05:22.82,0:05:25.82,Default,,0,0,0,,Беннетт! Ха…
Dialogue: 0,0:05:25.82,0:05:28.82,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:05:29.83,0:05:31.83,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:05:31.83,0:05:33.83,Default,,0,0,0,,Бізге ілесіп жүруді қойып, тезірек кетші!
Dialogue: 0,0:05:34.83,0:05:36.83,Default,,0,0,0,,Ха! Хмм!
Dialogue: 0,0:05:36.83,0:05:39.84,Default,,0,0,0,,...
Dialogue: 0,0:05:39.84,0:05:41.84,Default,,0,0,0,,《Қоңырау…》
Dialogue: 0,0:05:41.84,0:05:44.84,Default,,0,0,0,,Хааааааааа!
Dialogue: 0,0:05:44.84,0:05:46.84,Default,,0,0,0,,...
Dialogue: 0,0:05:46.84,0:05:48.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:48.84,0:05:50.85,Default,,0,0,0,,Қиямет! Бұл...
Dialogue: 0,0:05:50.85,0:05:53.85,Default,,0,0,0,,Ах... (ату дыбысы)
Dialogue: 0,0:05:55.85,0:05:57.85,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:57.85,0:05:59.86,Default,,0,0,0,,Жарайды, Белл.
Dialogue: 0,0:05:59.86,0:06:02.86,Default,,0,0,0,,Беннет... Мен сене алмаймын...
Dialogue: 0,0:06:02.86,0:06:07.86,Default,,0,0,0,,Мен ішімде әйелдің ұйықтап жатқанын сеземін.
Dialogue: 0,0:06:07.86,0:06:09.87,Default,,0,0,0,,Бұл енді қайталанбауы мүмкін
Dialogue: 0,0:06:09.87,0:06:14.87,Default,,0,0,0,,Су тайпасының жынысының өзгеруі өз еркімен емес.
Dialogue: 0,0:06:14.87,0:06:19.88,Default,,0,0,0,,Өйткені мен жүрегімнің айнасында нені көрсету керектігін анықтадым...
Dialogue: 0,0:06:19.88,0:06:22.88,Default,,0,0,0,,Енді мен көз емеспін...
Dialogue: 0,0:06:22.88,0:06:25.88,Default,,0,0,0,,Құлақпен садақ ату
Dialogue: 0,0:06:26.88,0:06:29.89,Default,,0,0,0,,Сол су қыз шықпаса.
Dialogue: 0,0:06:29.89,0:06:31.89,Default,,0,0,0,,Қанша өлген адамды өлтіргеніңіз маңызды емес.
Dialogue: 0,0:06:31.89,0:06:33.89,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:06:33.89,0:06:35.89,Default,,0,0,0,,Оны қалай тартуға болады?
Dialogue: 0,0:06:35.89,0:06:38.89,Default,,0,0,0,,Оны керемет етіп көрсетіңіз, содан кейін оны ашылғандай етіп көрсетіңіз.
Dialogue: 0,0:06:38.89,0:06:42.90,Default,,0,0,0,,Соңында, бұл соңы деп ойлаймын.
Dialogue: 0,0:06:42.90,0:06:44.90,Default,,0,0,0,,қатты ашулану
Dialogue: 0,0:06:44.90,0:06:46.90,Default,,0,0,0,,Ашу...
Dialogue: 0,0:06:46.90,0:06:50.91,Default,,0,0,0,,Ашу – басқа адамның сыртқа шығуының бүкіл мотиві.
Dialogue: 0,0:06:50.91,0:06:53.91,Default,,0,0,0,,《Мен жаудың санасына мұншалықты оқимын деп ойламаппын...》
Dialogue: 0,0:06:53.91,0:06:55.91,Default,,0,0,0,,《Бұл үлкен мәселе》
Dialogue: 0,0:06:55.91,0:06:58.91,Default,,0,0,0,,Менің ойымша, ол өз шегіне жақындады.
Dialogue: 0,0:06:58.91,0:07:01.92,Default,,0,0,0,,Олай болса екінші актісіне көшейік!
Dialogue: 0,0:07:01.92,0:07:11.93,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:11.93,0:07:14.93,Default,,0,0,0,,Енді сол су жолын жауып алайық.
Dialogue: 0,0:07:14.93,0:07:16.93,Default,,0,0,0,,Растау
Dialogue: 0,0:07:20.94,0:07:22.94,Default,,0,0,0,,Міне! Өзеннің ағынын өзгертіңіз!
Dialogue: 0,0:07:22.94,0:07:24.94,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:07:24.94,0:07:27.94,Default,,0,0,0,,Әй, мұның мақсаты не?
Dialogue: 0,0:07:27.94,0:07:30.95,Default,,0,0,0,,Тицианды судан тартыңыз.
Dialogue: 0,0:07:30.95,0:07:33.95,Default,,0,0,0,,Өйткені, су – су перісі аумағы.
Dialogue: 0,0:07:33.95,0:07:36.95,Default,,0,0,0,,Келесі жолы субұрқақтың аузын жабыңыз.
Dialogue: 0,0:07:36.95,0:07:38.95,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:07:38.95,0:07:41.96,Default,,0,0,0,,《Адонистің әкесі...》
Dialogue: 0,0:07:42.96,0:07:44.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:45.96,0:07:48.96,Default,,0,0,0,,Иә? Ах, мм...
Dialogue: 0,0:07:48.96,0:07:52.97,Default,,0,0,0,,Қараңғы болса да жолды анық көруге болады, есіңде ме?
Dialogue: 0,0:07:52.97,0:07:54.97,Default,,0,0,0,,Олай емес
Dialogue: 0,0:07:54.97,0:07:59.98,Default,,0,0,0,,Көзіңізді жұмып, санаңызды ішке қарай бұрыңыз және бүкіл жердің бар екенін сезініңіз.
Dialogue: 0,0:07:59.98,0:08:01.98,Default,,0,0,0,,Бағытты білу
Dialogue: 0,0:08:01.98,0:08:03.98,Default,,0,0,0,,Сана іштей?
Dialogue: 0,0:08:03.98,0:08:07.98,Default,,0,0,0,,Менің жүрегімде кенеттен пайда болған аянға сену
Dialogue: 0,0:08:07.98,0:08:10.99,Default,,0,0,0,,Бұл менің өмір сүруімді бағыттайды
Dialogue: 0,0:08:10.99,0:08:14.99,Default,,0,0,0,,Көрінбейтін жіп сияқты бірдеңе әкелетін шығар.
Dialogue: 0,0:08:15.99,0:08:17.99,Default,,0,0,0,,Қараңғылықтан алыс, көрінбейтін нәрсе
Dialogue: 0,0:08:17.99,0:08:23.00,Default,,0,0,0,,Көру қабілетін дамыту өте қиын.
Dialogue: 0,0:08:23.00,0:08:28.00,Default,,0,0,0,,Бұл ерекше, нәсілге тән табиғаттан тыс күш сияқты емес.
Dialogue: 0,0:08:28.00,0:08:33.01,Default,,0,0,0,,Мұны әркім кейде бейсаналы түрде жасайды.
Dialogue: 0,0:08:33.01,0:08:35.01,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:08:36.01,0:08:38.01,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:08:41.52,0:08:45.52,Default,,0,0,0,,Бұл жеткілікті (Джинбек) Хмм...
Dialogue: 0,0:08:49.52,0:08:52.53,Default,,0,0,0,,Не болса да...
Dialogue: 0,0:08:53.53,0:08:56.53,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:57.53,0:08:59.53,Default,,0,0,0,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:09:01.54,0:09:04.54,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:09:04.54,0:09:06.54,Default,,0,0,0,,Тендо зираты…
Dialogue: 0,0:09:06.54,0:09:10.55,Default,,0,0,0,,Ол «Өлім бағы» деп аталады.
Dialogue: 0,0:09:10.55,0:09:28.56,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:28.56,0:09:31.57,Default,,0,0,0,,Өлім құсының гүлі…
Dialogue: 0,0:09:34.57,0:09:37.57,Default,,0,0,0,,Өлім туралы отбасына хабарлау үшін барыңыз.
Dialogue: 0,0:09:37.57,0:09:41.58,Default,,0,0,0,,Дәл... жәннатқа апаратын зират
Dialogue: 0,0:09:41.58,0:09:46.58,Default,,0,0,0,,Бұл катакомбалардағы ең қасиетті және қол сұғылмайтын кеңістік.
Dialogue: 0,0:09:46.58,0:09:50.59,Default,,0,0,0,,Бұл біздің соңғы ұстанымымыз.
Dialogue: 0,0:09:50.59,0:09:52.59,Default,,0,0,0,,Кешіріңіз, Коллинз.
Dialogue: 0,0:09:52.59,0:09:55.59,Default,,0,0,0,,Сіз бұл жерді сәттілікпен таңдадыңыз.
Dialogue: 0,0:09:55.59,0:09:57.59,Default,,0,0,0,,Оны орындаңыз
Dialogue: 0,0:09:57.59,0:09:59.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:59.59,0:10:01.60,Default,,0,0,0,,Бүкіл зираттың айналасына бөгет қойыңыз!
Dialogue: 0,0:10:01.60,0:10:04.60,Default,,0,0,0,,Жоқ, сіз дөрекі болып жатырсыз.
Dialogue: 0,0:10:04.60,0:10:07.60,Default,,0,0,0,,Бұл өлшем біраз уақыт алады.
Dialogue: 0,0:10:07.60,0:10:09.60,Default,,0,0,0,,Неге мұнда!
Dialogue: 0,0:10:09.60,0:10:12.61,Default,,0,0,0,,Бұл жерде оған манипуляция жасау үшін көптеген денелер бар.
Dialogue: 0,0:10:12.61,0:10:15.61,Default,,0,0,0,,Бір ғана кіреберіс бар, қашып құтылу мүмкін емес!
Dialogue: 0,0:10:18.61,0:10:20.62,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:25.62,0:10:28.62,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:10:30.63,0:10:35.63,Default,,0,0,0,,《Құдай рұқсат бермейінше мен қылышымды суырмаймын.》
Dialogue: 0,0:10:35.63,0:10:39.63,Default,,0,0,0,,《Мен қылыштан бұрын діни қызметкермін》
Dialogue: 0,0:10:44.64,0:10:46.64,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:10:46.64,0:10:57.65,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:57.65,0:10:59.65,Default,,0,0,0,,Тым кең және тосқауыл жұқа
Dialogue: 0,0:10:59.65,0:11:02.66,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:11:07.66,0:11:10.67,Default,,0,0,0,,Бұл туралы не істеу керек?
Dialogue: 0,0:11:10.67,0:11:13.67,Default,,0,0,0,,Хмм... бірдеңе келе жатыр (судың ағып жатқан дыбысы)
Dialogue: 0,0:11:13.67,0:11:15.67,Default,,0,0,0,,Судың дыбысы?
Dialogue: 0,0:11:15.67,0:11:19.67,Default,,0,0,0,,Тициан, сен суды ұстап тұрған бөгетті бұздың.
Dialogue: 0,0:11:19.67,0:11:21.68,Default,,0,0,0,,Міне!
Dialogue: 0,0:11:21.68,0:11:24.68,Default,,0,0,0,,Міне келді (Джинбек) Ах.
Dialogue: 0,0:11:24.68,0:11:27.68,Default,,0,0,0,,Маған бере аласыз ба?
Dialogue: 0,0:11:27.68,0:11:32.69,Default,,0,0,0,,Жақында мені де осында жерлеу керек.
Dialogue: 0,0:11:32.69,0:11:34.69,Default,,0,0,0,,Мен оны да көтере алмаймын деп ойлаймын.
Dialogue: 0,0:11:34.69,0:11:38.69,Default,,0,0,0,,Бірақ... бұл жалғыз жол.
Dialogue: 0,0:11:38.69,0:11:42.70,Default,,0,0,0,,Мен бұған тұрарлық деп ойлағым келеді...
Dialogue: 0,0:11:42.70,0:11:45.70,Default,,0,0,0,,Мен үшін өмір сүруге тұрарлық нәрсе бар...
Dialogue: 0,0:11:45.70,0:11:48.70,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:11:48.70,0:11:51.71,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:11:56.71,0:11:58.71,Default,,0,0,0,,Джимбек мырза!
Dialogue: 0,0:11:58.71,0:12:00.72,Default,,0,0,0,,Жабу!
Dialogue: 0,0:12:01.72,0:12:04.72,Default,,0,0,0,,Сен де бару керек (Гинесу) Иә.
Dialogue: 0,0:12:07.72,0:12:13.73,Default,,0,0,0,,Хехехехе, тағы да кездестік, су қыз.
Dialogue: 0,0:12:22.74,0:12:25.74,Default,,0,0,0,,Ооо
Dialogue: 0,0:12:25.74,0:12:28.74,Default,,0,0,0,,Nnnnnnn…
Dialogue: 0,0:12:29.74,0:12:33.75,Default,,0,0,0,,Мен сенің қаншалықты баяу екеніңді ұмытып қалдым.
Dialogue: 0,0:12:33.75,0:12:36.75,Default,,0,0,0,,Аа... Джинбак!
Dialogue: 0,0:12:36.75,0:12:40.76,Default,,0,0,0,,Ақымақ! Маған бәрі бір!
Dialogue: 0,0:12:41.76,0:12:46.76,Default,,0,0,0,,Бұл ыңғайсыздық! Жүгір! Бұл ақымақтар!
Dialogue: 0,0:12:46.76,0:12:51.77,Default,,0,0,0,,Олай болса, екінші актіні аяқтайық!
Dialogue: 0,0:13:01.78,0:13:03.78,Default,,0,0,0,,Ал...
Dialogue: 0,0:13:03.78,0:13:07.78,Default,,0,0,0,,Зираттың түгелдей бөгетпен жабылуының себебі осы ма?
Dialogue: 0,0:13:07.78,0:13:09.78,Default,,0,0,0,,Иә
Dialogue: 0,0:13:09.78,0:13:12.79,Default,,0,0,0,,Бірақ су неге кенеттен жоғалып кетті?
Dialogue: 0,0:13:12.79,0:13:16.79,Default,,0,0,0,,Мен су тамырларын тоқтататын тосқауылға генджуцу отырғыздым.
Dialogue: 0,0:13:16.79,0:13:22.80,Default,,0,0,0,,Тосқауылдан өтіп, сыртқа ағып жатқан су үлкен бұлдыр ағынға ұқсайды.
Dialogue: 0,0:13:22.80,0:13:25.80,Default,,0,0,0,,Мен өлім алдында тұрмын деп ойладым.
Dialogue: 0,0:13:25.80,0:13:27.80,Default,,0,0,0,,Жақсы нәрсе қалдырыңыз
Dialogue: 0,0:13:27.80,0:13:31.81,Default,,0,0,0,,Егер сіз осындай нәрсеге жол берсеңіз, сіз өз бетіңізше қашып, жеңе алмайсыз.
Dialogue: 0,0:13:31.81,0:13:33.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:33.81,0:13:36.81,Default,,0,0,0,,Біздің аман қалуымыз үшін
Dialogue: 0,0:13:36.81,0:13:40.82,Default,,0,0,0,,Өлгендер мен ғибадат орындары өртенді.
Dialogue: 0,0:13:40.82,0:13:43.82,Default,,0,0,0,,Қарға тұқымдары әлі де бар.
Dialogue: 0,0:13:43.82,0:13:47.82,Default,,0,0,0,,Тұқымдар бар болғанша, оларды себу керек.
Dialogue: 0,0:13:47.82,0:13:52.83,Default,,0,0,0,,Біз бүгін үлкен нәрсені жоғалттық, бұл анық.
Dialogue: 0,0:13:52.83,0:13:56.83,Default,,0,0,0,,Бірақ мен өзім жоғалған жоқпын.
Dialogue: 0,0:13:56.83,0:14:00.84,Default,,0,0,0,,Қиын, бірақ оны қабылдайық.
Dialogue: 0,0:14:00.84,0:14:02.84,Default,,0,0,0,,Мен кешіре алмаймын!
Dialogue: 0,0:14:02.84,0:14:06.84,Default,,0,0,0,,Мен мұндай нәрсені кешіре алмаймын...
Dialogue: 0,0:14:06.84,0:14:09.84,Default,,0,0,0,,Сіз осындасыз ба? Қауіпсіздікті төмендетпеңіз.
Dialogue: 0,0:14:09.84,0:14:12.85,Default,,0,0,0,,Бұл соңғы әрекет
Dialogue: 0,0:14:15.85,0:14:17.85,Default,,0,0,0,,Сен сол қолмен келдің бе?
Dialogue: 0,0:14:17.85,0:14:19.85,Default,,0,0,0,,Иә
Dialogue: 0,0:14:28.36,0:14:30.37,Default,,0,0,0,,Уау (қар) Жақсы...
Dialogue: 0,0:14:30.37,0:14:32.37,Default,,0,0,0,,Гуа (қатып қалды) Уау
Dialogue: 0,0:14:32.37,0:14:35.37,Default,,0,0,0,,Уау ха... Уау (қиғаш дыбыс)
Dialogue: 0,0:14:35.37,0:14:37.37,Default,,0,0,0,,Мұнда келу керек!
Dialogue: 0,0:14:37.37,0:14:39.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:39.37,0:14:43.38,Default,,0,0,0,,Сен өлесің бе? Сіз өлесіз бе?
Dialogue: 0,0:14:43.38,0:14:46.38,Default,,0,0,0,,Осы уақытқа дейін кел! осы уақытқа дейін!
Dialogue: 0,0:14:47.38,0:14:49.38,Default,,0,0,0,,Ннн!
Dialogue: 0,0:14:50.39,0:14:52.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:54.39,0:14:56.39,Default,,0,0,0,,Nng (шаншу дыбысы)
Dialogue: 0,0:14:56.39,0:14:58.39,Default,,0,0,0,,Иә!?
Dialogue: 0,0:15:01.40,0:15:03.40,Default,,0,0,0,,Дұрыс, Макио-сан. Ммм…
Dialogue: 0,0:15:03.40,0:15:08.40,Default,,0,0,0,,Нннн... Ннннннн!
Dialogue: 0,0:15:08.40,0:15:12.41,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:15:16.41,0:15:19.41,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:15:23.42,0:15:26.42,Default,,0,0,0,,Басқа ештеңе болған жоқ па?
Dialogue: 0,0:15:26.42,0:15:28.42,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:30.43,0:15:32.43,Default,,0,0,0,,Сен ақымақ...
Dialogue: 0,0:15:36.43,0:15:38.43,Default,,0,0,0,,Бұл тұман...
Dialogue: 0,0:15:38.43,0:15:40.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:40.44,0:15:44.44,Default,,0,0,0,,Осы қылышты менің орныма көтергеніңді қалаймын.
Dialogue: 0,0:15:44.44,0:15:49.44,Default,,0,0,0,,Менің бір қолыммен қылыш көтеруге күшім жетпейді.
Dialogue: 0,0:15:49.44,0:15:51.45,Default,,0,0,0,,Бұл қандай мөр?
Dialogue: 0,0:15:51.45,0:15:55.45,Default,,0,0,0,,Иврейн Батылдық пен қорқақтық
Dialogue: 0,0:15:55.45,0:15:59.45,Default,,0,0,0,,Қайсысы жоқ болса да, жалғыз өзі жұмыс істемейді.
Dialogue: 0,0:15:59.45,0:16:02.46,Default,,0,0,0,,Батылдық пен қорқақтық...
Dialogue: 0,0:16:02.46,0:16:06.46,Default,,0,0,0,,Мен саған қорқақтық туралы көп нәрсені үйреттім.
Dialogue: 0,0:16:06.46,0:16:09.46,Default,,0,0,0,,Келесі жолы қолдарыңмен батылдықты үйретсеңдер деймін.
Dialogue: 0,0:16:09.46,0:16:13.47,Default,,0,0,0,,А... Мен саған не істедім?
Dialogue: 0,0:16:13.47,0:16:15.47,Default,,0,0,0,,Мен сізден өтінемін...
Dialogue: 0,0:16:15.47,0:16:17.47,Default,,0,0,0,,Гиннес!
Dialogue: 0,0:16:18.47,0:16:20.48,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:16:23.48,0:16:28.48,Default,,0,0,0,,Ха... қылыш сенің қолыңды жеп жатыр ма?
Dialogue: 0,0:16:28.48,0:16:32.49,Default,,0,0,0,,Regnar пайдаланушысы...
Dialogue: 0,0:16:32.49,0:16:34.49,Default,,0,0,0,,Енді бұл аянышты сөз.
Dialogue: 0,0:16:34.49,0:16:37.49,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:42.50,0:16:46.50,Default,,0,0,0,,《Бұл не сезім...》
Dialogue: 0,0:16:50.51,0:16:52.51,Default,,0,0,0,,Ннннн (шаншу дыбысы)
Dialogue: 0,0:16:52.51,0:16:54.51,Default,,0,0,0,,Иә
Dialogue: 0,0:16:55.51,0:16:59.51,Default,,0,0,0,,Түскі түскі түсте!
Dialogue: 0,0:16:59.51,0:17:01.52,Default,,0,0,0,,...
Dialogue: 0,0:17:01.52,0:17:21.54,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:21.54,0:17:25.54,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:25.54,0:17:27.54,Default,,0,0,0,,...
Dialogue: 0,0:17:27.54,0:17:43.56,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:43.56,0:17:46.56,Default,,0,0,0,,Адонис!
Dialogue: 0,0:17:48.56,0:17:50.57,Default,,0,0,0,,Адонис! Хмм
Dialogue: 0,0:17:50.57,0:17:53.57,Default,,0,0,0,,Құрметті қызым!
Dialogue: 0,0:18:01.58,0:18:08.58,Default,,0,0,0,,《Бір күні, бір жерде, мен де дәл осындай сезімде болдым》
Dialogue: 0,0:18:08.58,0:18:11.59,Default,,0,0,0,,《Тас жұмыртқа...》
Dialogue: 0,0:18:13.59,0:18:15.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:21.60,0:18:24.60,Default,,0,0,0,,Китти хехе
Dialogue: 0,0:18:24.60,0:18:27.60,Default,,0,0,0,,Жоғарғы, төменгі, сол және оң жақтарды, орны мен бағытын, уақыты мен орнын анықтаңыз
Dialogue: 0,0:18:27.60,0:18:33.61,Default,,0,0,0,,Оны өзіңдікі ету - есептеудің мәні.
Dialogue: 0,0:18:33.61,0:18:36.61,Default,,0,0,0,,《Шынымен... Не болғанын білмеймін》
Dialogue: 0,0:18:36.61,0:18:38.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:38.61,0:18:40.62,Default,,0,0,0,,Онда?
Dialogue: 0,0:18:40.62,0:18:42.62,Default,,0,0,0,,Адонис!
Dialogue: 0,0:18:42.62,0:18:46.62,Default,,0,0,0,,Сіз стендті танысыңызға тапсырып жатқан сияқтысыз.
Dialogue: 0,0:18:46.62,0:18:49.62,Default,,0,0,0,,Мен сенімдімін... Перьердің қылышы
Dialogue: 0,0:18:50.63,0:18:53.63,Default,,0,0,0,,Сұрақ! Неге...
Dialogue: 0,0:18:53.63,0:18:57.63,Default,,0,0,0,,Қолы тигеннің бәрін шірітетін сияқты.
Dialogue: 0,0:18:57.63,0:18:59.63,Default,,0,0,0,,Мұндай нәрсе...
Dialogue: 0,0:18:59.63,0:19:03.64,Default,,0,0,0,,Шындығында, оның саусақтарының тиюі болаттың шіріп кетуіне себеп болды, солай ма?
Dialogue: 0,0:19:03.64,0:19:06.64,Default,,0,0,0,,Иә, бірақ... а
Dialogue: 0,0:19:06.64,0:19:25.66,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:25.66,0:19:28.66,Default,,0,0,0,,Хехехе күліп тұрсың ба?
Dialogue: 0,0:19:28.66,0:19:31.67,Default,,0,0,0,,Бұл өлім биі.
Dialogue: 0,0:19:31.67,0:19:33.67,Default,,0,0,0,,Тито…
Dialogue: 0,0:19:33.67,0:19:36.67,Default,,0,0,0,,Менің кінәм бар ма?
Dialogue: 0,0:19:36.67,0:19:41.68,Default,,0,0,0,,Сенің семсерің сынып қалса, бақытты болар ма едің?
Dialogue: 0,0:19:42.68,0:19:46.68,Default,,0,0,0,,Бұл қылыш Құдай ағашына ұқсайды.
Dialogue: 0,0:19:46.68,0:19:48.68,Default,,0,0,0,,Қатерлі қылыш
Dialogue: 0,0:19:48.68,0:19:52.69,Default,,0,0,0,,Өлімге апаратын аурумен ол жалған құдайдың тағына айналады.
Dialogue: 0,0:19:52.69,0:19:55.69,Default,,0,0,0,,Оны қиялдағы жанның бар болуы деп атауға болады.
Dialogue: 0,0:19:55.69,0:19:57.69,Default,,0,0,0,,Жер бетінде псевдоқұдай деген не?
Dialogue: 0,0:19:57.69,0:20:00.70,Default,,0,0,0,,Ақырында түсінесіз.
Dialogue: 0,0:20:00.70,0:20:06.70,Default,,0,0,0,,Ескі жалған құдайлар мен жұмақ тұрғындары арасындағы шайқас басталып кетті.
Dialogue: 0,0:20:06.70,0:20:09.70,Default,,0,0,0,,Бұл не... (Кити) Ол жағы.
Dialogue: 0,0:20:09.70,0:20:11.71,Default,,0,0,0,,Мен сізге осы жерден қалай көмектесе аламын?
Dialogue: 0,0:20:11.71,0:20:15.71,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:20:20.72,0:20:22.72,Default,,0,0,0,,Мен сенемін
Dialogue: 0,0:20:24.72,0:20:26.72,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:20:26.72,0:20:31.73,Default,,0,0,0,,Адонис!
Dialogue: 0,0:20:31.73,0:20:33.73,Default,,0,0,0,,Хмф!
Dialogue: 0,0:20:36.73,0:20:39.73,Default,,0,0,0,,Хмм... аа
Dialogue: 0,0:20:48.74,0:20:51.75,Default,,0,0,0,,(Фушигуро) Ол іссапарда. (Итадори) Ә?
Dialogue: 0,0:20:51.75,0:20:53.75,Default,,0,0,0,,Ннн!
Dialogue: 0,0:20:56.75,0:20:58.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:03.76,0:21:09.76,Default,,0,0,0,,《Бұл адамды тіпті қылыш басқарды ма?》
Dialogue: 0,0:21:13.77,0:21:16.77,Default,,0,0,0,,Адонис…
Dialogue: 0,0:21:18.77,0:21:20.78,Default,,0,0,0,,Қазір бәрі жақсы, Тито.
Dialogue: 0,0:21:20.78,0:21:22.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:30.79,0:21:34.79,Default,,0,0,0,,Қолым тисе де...
Dialogue: 0,0:21:35.79,0:21:40.80,Default,,0,0,0,,Мен саған тұқым себемін
Dialogue: 0,0:21:40.80,0:21:43.80,Default,,0,0,0,,Қарға гүлдері әдемі гүлдесін
Dialogue: 0,0:21:43.80,0:21:46.80,Default,,0,0,0,,Мен көшеттерді өсіремін
Dialogue: 0,0:21:46.80,0:21:59.81,Default,,0,0,0,,♪♪～
