Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:42.70,0:00:46.12,Default,,0,0,0,,Кәне, бәріміз көңіл көтерейік
Dialogue: 0,0:00:46.54,0:00:48.04,Default,,0,0,0,,үшін
Dialogue: 0,0:00:49.92,0:00:51.13,Default,,0,0,0,,Жарылсын
Dialogue: 0,0:00:55.18,0:00:56.84,Default,,0,0,0,,Бөксені шайқаңыз
Dialogue: 0,0:00:57.59,0:00:58.85,Default,,0,0,0,,Шайқаңыз!
Dialogue: 0,0:00:59.01,0:01:03.98,Default,,0,0,0,,Мұндай қызықтарды халықпен бөлісу керек.
Dialogue: 0,0:01:07.81,0:01:10.65,Default,,0,0,0,,Бөксесі үлкен болса да, дәмі жақсы.
Dialogue: 0,0:01:10.77,0:01:12.86,Default,,0,0,0,,үшінмыз көңіл көтерейік
Dialogue: 0,0:01:15.24,0:01:16.70,Default,,0,0,0,,үшін
Dialogue: 0,0:01:23.95,0:01:25.46,Default,,0,0,0,,Үнемі қарап тұру керек пе?
Dialogue: 0,0:01:25.58,0:01:27.75,Default,,0,0,0,,Бұл бетті жасамаңыз
Dialogue: 0,0:01:27.87,0:01:32.38,Default,,0,0,0,,үшін сенің бөркіңнің жанкүйері.
Dialogue: 0,0:01:32.55,0:01:33.55,Default,,0,0,0,,Мен күле алмаймын
Dialogue: 0,0:01:33.67,0:01:35.13,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:01:35.26,0:01:36.72,Default,,0,0,0,,LOL
Dialogue: 0,0:01:37.76,0:01:40.97,Default,,0,0,0,,Морис менің бөкселерімді сипады.
Dialogue: 0,0:01:48.06,0:01:50.23,Default,,0,0,0,,Неге ашуланасың?
Dialogue: 0,0:01:50.52,0:01:51.94,Default,,0,0,0,,үшін
Dialogue: 0,0:01:52.48,0:01:54.07,Default,,0,0,0,,бірге
Dialogue: 0,0:01:54.44,0:01:57.07,Default,,0,0,0,,Бірге көңіл көтерейік
Dialogue: 0,0:01:59.57,0:02:03.12,Default,,0,0,0,,Жетіспейтін банан микрофонының орнына-
Dialogue: 0,0:02:03.24,0:02:08.21,Default,,0,0,0,,Король Джульенді жеңіп, елді азат ету.
Dialogue: 0,0:02:08.33,0:02:11.84,Default,,0,0,0,,«LALA» атын таратыңыз
Dialogue: 0,0:02:11.96,0:02:13.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:13.59,0:02:15.34,Default,,0,0,0,,Бірақ «Лара» нені білдіреді?
Dialogue: 0,0:02:15.46,0:02:19.63,Default,,0,0,0,,Сіз ұмыттыңыз ба? Майк осылай деді
Dialogue: 0,0:02:19.88,0:02:22.51,Default,,0,0,0,,«Лемур одағының азат ету армиясы»
Dialogue: 0,0:02:22.64,0:02:24.06,Default,,0,0,0,,«LALA» деп қысқартылған
Dialogue: 0,0:02:25.22,0:02:26.52,Default,,0,0,0,,Сәлем
Dialogue: 0,0:02:27.56,0:02:31.73,Default,,0,0,0,,Бір орында тұрсаңыз, бұл мүсін деп ойлауыңыз мүмкін.
Dialogue: 0,0:02:32.48,0:02:33.98,Default,,0,0,0,,Жоқ, бірақ Йор-чан менің байқамай тұрғанымда үйленіп кеткеніне сенбеймін.
Dialogue: 0,0:02:34.11,0:02:35.23,Default,,0,0,0,,Мүсінге айналды
Dialogue: 0,0:02:35.36,0:02:36.36,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:02:36.48,0:02:38.07,Default,,0,0,0,,Бұл тамаша өнер.
Dialogue: 0,0:02:38.19,0:02:42.20,Default,,0,0,0,,Иә, бұл өнер.
Dialogue: 0,0:02:42.32,0:02:44.49,Default,,0,0,0,,Патшалықты дәріптеу
Dialogue: 0,0:02:44.62,0:02:48.79,Default,,0,0,0,,Мен патшаны құлатуға шақырмаймын.
Dialogue: 0,0:02:49.12,0:02:49.87,Default,,0,0,0,,Маған көмектесейін
Dialogue: 0,0:02:50.83,0:02:51.67,Default,,0,0,0,,Консультация
Dialogue: 0,0:02:51.79,0:02:52.96,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:02:53.08,0:02:53.84,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:02:53.96,0:02:58.01,Default,,0,0,0,,Менің өмір туралы қалай ойлайтынымды айтасыз ба?
Dialogue: 0,0:02:59.22,0:03:02.05,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:03:03.97,0:03:05.10,Default,,0,0,0,,Сіз?
Dialogue: 0,0:03:05.22,0:03:07.22,Default,,0,0,0,,Бұл жай ғана дудл
Dialogue: 0,0:03:07.35,0:03:10.14,Default,,0,0,0,,Мен жақсы нәрсе ойладым
Dialogue: 0,0:03:10.27,0:03:11.06,Default,,0,0,0,,Консультация
Dialogue: 0,0:03:11.19,0:03:12.27,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:12.40,0:03:14.81,Default,,0,0,0,,Көрдіңіз бе, бұл сурет қаншалықты ғажайып?
Dialogue: 0,0:03:14.94,0:03:18.11,Default,,0,0,0,,Менің бір көзім салқын емес.
Dialogue: 0,0:03:18.23,0:03:22.32,Default,,0,0,0,,Суретшімін деп жүргенді пайдаланып...
Dialogue: 0,0:03:22.45,0:03:27.70,Default,,0,0,0,,Бейбітшілік пен махаббат үшін патшаны құлату идеясын тарату
Dialogue: 0,0:03:27.87,0:03:31.41,Default,,0,0,0,,Достардың көп болғаны жақсы.
Dialogue: 0,0:03:31.75,0:03:36.13,Default,,0,0,0,,Біздің өнер үйірмесіне келіңіз
Dialogue: 0,0:03:36.25,0:03:39.67,Default,,0,0,0,,Жиналыс түстен кейін өтеді, жеңіл тағамдар беріледі.
Dialogue: 0,0:03:39.80,0:03:42.80,Default,,0,0,0,,Мен тәттілерді жақсы көремін!
Dialogue: 0,0:03:43.13,0:03:46.97,Default,,0,0,0,,Неге ашуланасың, Морис?
Dialogue: 0,0:03:47.10,0:03:48.56,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:48.72,0:03:52.98,Default,,0,0,0,,Менің биімді бәрі мазақ етеді
Dialogue: 0,0:03:53.10,0:03:57.11,Default,,0,0,0,,Ол көңілді жігіт ретінде танымал болды.
Dialogue: 0,0:03:58.02,0:03:59.48,Default,,0,0,0,,Жаман емес, солай ма?
Dialogue: 0,0:04:04.45,0:04:05.95,Default,,0,0,0,,Барлық жерде солай
Dialogue: 0,0:04:06.07,0:04:08.74,Default,,0,0,0,,Мен патшаның кесірінен шыға алмаймын.
Dialogue: 0,0:04:10.04,0:04:12.62,Default,,0,0,0,,Морис? Момо-чан
Dialogue: 0,0:04:12.75,0:04:18.25,Default,,0,0,0,,Ұрыса берсек, мен және сен.
Dialogue: 0,0:04:18.42,0:04:21.80,Default,,0,0,0,,Бірақ оның жалғасуын тоқтату үшін не істеуім керек?
Dialogue: 0,0:04:22.47,0:04:23.76,Default,,0,0,0,,Кешірім сұраңыз
Dialogue: 0,0:04:24.51,0:04:28.26,Default,,0,0,0,,Джулиан ағай айтты
Dialogue: 0,0:04:28.39,0:04:30.68,Default,,0,0,0,,«Патшалар кешірім сұрамайды»
Dialogue: 0,0:04:30.81,0:04:32.98,Default,,0,0,0,,Әрине? Тіпті бір рет пе?
Dialogue: 0,0:04:33.10,0:04:36.69,Default,,0,0,0,,Тіпті дұрыс емес елде шабуыл жасағанда да...
Dialogue: 0,0:04:36.81,0:04:42.78,Default,,0,0,0,,Патша өз қателігін мойындамау керектігін айтып, кешірім сұрамады.
Dialogue: 0,0:04:42.90,0:04:44.36,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:04:44.53,0:04:46.11,Default,,0,0,0,,Масикура бірдеңе дейді
Dialogue: 0,0:04:46.28,0:04:49.74,Default,,0,0,0,,Алдыңғы патшаның кешірім сұрамағаны рас, бірақ...
Dialogue: 0,0:04:51.04,0:04:52.62,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:52.75,0:04:54.46,Default,,0,0,0,,Сіз жоғалып кете аласыз
Dialogue: 0,0:04:54.58,0:04:58.79,Default,,0,0,0,,Патша достарынан кешірім сұрауы керек емес пе?
Dialogue: 0,0:04:58.92,0:05:01.21,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:01.75,0:05:04.97,Default,,0,0,0,,Айтқыңыз келген нәрсені түсіндіңіз бе?
Dialogue: 0,0:05:06.22,0:05:08.85,Default,,0,0,0,,Сіз кешірім сұрауыңыз керек
Dialogue: 0,0:05:08.97,0:05:13.22,Default,,0,0,0,,Кешірім сұрау достығыңды тереңдетеді.
Dialogue: 0,0:05:13.35,0:05:17.77,Default,,0,0,0,,Менің айтып отырғаным осы.
Dialogue: 0,0:05:17.90,0:05:21.07,Default,,0,0,0,,Жақсырақ жолды ойлап көріңіз
Dialogue: 0,0:05:21.32,0:05:23.48,Default,,0,0,0,,Жаман нәрсе болатын сияқты
Dialogue: 0,0:05:23.61,0:05:26.03,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:26.15,0:05:28.70,Default,,0,0,0,,«Ұят спиралы»
Dialogue: 0,0:05:28.82,0:05:32.33,Default,,0,0,0,,Оны қалай пайдаланамын?
Dialogue: 0,0:05:33.62,0:05:35.37,Default,,0,0,0,,Менің анам-
Dialogue: 0,0:05:35.50,0:05:40.46,Default,,0,0,0,,Сіз мені ұятқа қалдыруға өте шеберсіз...
Dialogue: 0,0:05:40.59,0:05:41.96,Default,,0,0,0,,Қысқаша болыңыз.
Dialogue: 0,0:05:42.09,0:05:48.22,Default,,0,0,0,,Басқаша айтқанда, бала кезімде ұятқа қалғанымнан...
Dialogue: 0,0:05:48.34,0:05:50.72,Default,,0,0,0,,Мен бұл құрылғыны жасадым
Dialogue: 0,0:05:50.85,0:05:55.10,Default,,0,0,0,,Мен әр түрлі ыңғайсыз жағдайларға тап боламын...
Dialogue: 0,0:05:55.22,0:05:57.69,Default,,0,0,0,,үшін маған күледі
Dialogue: 0,0:05:57.81,0:06:01.19,Default,,0,0,0,,Мені ақымаққа көрсетсең
Dialogue: 0,0:06:01.31,0:06:03.69,Default,,0,0,0,,Морис де мені кешіреді.
Dialogue: 0,0:06:03.90,0:06:08.53,Default,,0,0,0,,Мен нәтижеге алаңдаймын, бірақ мен айналама қарауым керек.
Dialogue: 0,0:06:08.65,0:06:14.58,Default,,0,0,0,,Бұл менің жұмысым, мен ешқашан берілмеймін...
Dialogue: 0,0:06:14.74,0:06:15.45,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:06:15.58,0:06:18.00,Default,,0,0,0,,Хаа, міне
Dialogue: 0,0:06:18.12,0:06:23.50,Default,,0,0,0,,Бұл туралы дәл осы жерде сөйлесейік.
Dialogue: 0,0:06:23.67,0:06:26.01,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:06:26.42,0:06:28.84,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:06:28.97,0:06:33.97,Default,,0,0,0,,Бәлкім, сен мені қорлау үшін келген шығарсың.
Dialogue: 0,0:06:37.06,0:06:39.77,Default,,0,0,0,,Мен ұялдым
Dialogue: 0,0:06:40.52,0:06:42.27,Default,,0,0,0,,Король Джулиен?
Dialogue: 0,0:06:42.94,0:06:44.19,Default,,0,0,0,,Бұл өшірулі болды.
Dialogue: 0,0:06:53.70,0:06:54.41,Default,,0,0,0,,Тоқта
Dialogue: 0,0:07:18.60,0:07:23.10,Default,,0,0,0,,үшін, күлуді доғарыңдар, Морис ренжіді...
Dialogue: 0,0:07:24.65,0:07:26.61,Default,,0,0,0,,Бұл таңқаларлық емес!
Dialogue: 0,0:07:26.82,0:07:29.11,Default,,0,0,0,,Жоқ, бұл қызық.
Dialogue: 0,0:07:30.45,0:07:33.57,Default,,0,0,0,,Мен мұны бастан өткермегеніме қуаныштымын.
Dialogue: 0,0:07:33.70,0:07:34.91,Default,,0,0,0,,Мына бетке қараңыз
Dialogue: 0,0:07:35.24,0:07:39.95,Default,,0,0,0,,Бұл өте күлкілі, мен шыдай алмаймын. Бұл лемур клоун.
Dialogue: 0,0:07:42.25,0:07:44.67,Default,,0,0,0,,Морис, бұл тамаша.
Dialogue: 0,0:07:50.80,0:07:51.97,Default,,0,0,0,,Дудльдер.
Dialogue: 0,0:07:52.38,0:07:54.51,Default,,0,0,0,,Иә! Мен анықтауым керек
Dialogue: 0,0:07:54.64,0:07:58.51,Default,,0,0,0,,Ұрысқан жақсы, бірақ мен оны сән-салтанат деп айта алмаймын.
Dialogue: 0,0:08:05.44,0:08:06.65,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:08:06.77,0:08:09.69,Default,,0,0,0,,Патшаға жұдырық көтерді
Dialogue: 0,0:08:09.82,0:08:12.15,Default,,0,0,0,,Оны қалай ойлап табасың?
Dialogue: 0,0:08:12.28,0:08:15.66,Default,,0,0,0,,Банан қолы деп бір күні түс көрдім.
Dialogue: 0,0:08:15.78,0:08:18.78,Default,,0,0,0,,Мен бұл суретті Майкқа да көрсеткім келді.
Dialogue: 0,0:08:18.91,0:08:21.54,Default,,0,0,0,,Жатқан жерің жайлы болсын, Майк.
Dialogue: 0,0:08:21.66,0:08:25.00,Default,,0,0,0,,Мен сүйікті жігітімнен айырылдым.
Dialogue: 0,0:08:30.25,0:08:31.92,Default,,0,0,0,,Уәде етілген сыйлық ше?
Dialogue: 0,0:08:32.05,0:08:33.67,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:08:38.30,0:08:40.14,Default,,0,0,0,,Жеміс жоқ па?
Dialogue: 0,0:08:40.31,0:08:43.98,Default,,0,0,0,,«Пок Поку жидектері» өте көп.
Dialogue: 0,0:08:44.52,0:08:48.36,Default,,0,0,0,,Сыртта өсетін жаңғақтар қоректік.
Dialogue: 0,0:08:48.48,0:08:49.15,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:08:49.36,0:08:51.44,Default,,0,0,0,,Тамақтану маңызды
Dialogue: 0,0:08:51.57,0:08:53.78,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:08:55.03,0:08:59.87,Default,,0,0,0,,Бірақ жағада шайылған тамақты жеген дұрыс.
Dialogue: 0,0:08:59.99,0:09:04.75,Default,,0,0,0,,Организмге жаңғақтың пайдалы екенін айтады.
Dialogue: 0,0:09:04.87,0:09:07.29,Default,,0,0,0,,Олар біздің миымызды шайып жатыр.
Dialogue: 0,0:09:07.42,0:09:08.46,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:09:08.58,0:09:10.92,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жеңіз
Dialogue: 0,0:09:11.05,0:09:16.30,Default,,0,0,0,,Ит азығы, тіпті ит етінен жасалған тағам.
Dialogue: 0,0:09:16.43,0:09:19.30,Default,,0,0,0,,Сіз кез келген нәрсені жеуге құқығыңыз бар.
Dialogue: 0,0:09:19.43,0:09:23.22,Default,,0,0,0,,Қолыңнан келгенше жеп, үкіметке қарсы шығу
Dialogue: 0,0:09:23.35,0:09:25.52,Default,,0,0,0,,Жақсы! Мен де күресемін
Dialogue: 0,0:09:27.52,0:09:31.52,Default,,0,0,0,,Бұл күрделі дәм, иісі бар.
Dialogue: 0,0:09:32.98,0:09:37.03,Default,,0,0,0,,Еркін жейді, немесе ит етін жейді.
Dialogue: 0,0:09:37.15,0:09:38.99,Default,,0,0,0,,Шындықты айтатын кез келді
Dialogue: 0,0:09:39.49,0:09:40.24,Default,,0,0,0,,Морт
Dialogue: 0,0:09:40.91,0:09:41.83,Default,,0,0,0,,Морт!
Dialogue: 0,0:09:42.37,0:09:43.79,Default,,0,0,0,,таңдау шайқасында соңына дейін жеңіске жетті,
Dialogue: 0,0:09:43.91,0:09:47.21,Default,,0,0,0,,Өнер үйірмесі деп өтірік айттым.
Dialogue: 0,0:09:47.33,0:09:52.71,Default,,0,0,0,,Сіз оны жеңіп, революция бастауға мүдделісіз бе?
Dialogue: 0,0:09:52.84,0:09:55.63,Default,,0,0,0,,Иә! Ол жігіт үлкен
Dialogue: 0,0:09:55.76,0:09:57.88,Default,,0,0,0,,Сонда біз доспыз.
Dialogue: 0,0:09:58.01,0:10:02.81,Default,,0,0,0,,Абнер, маған керемет идея келді.
Dialogue: 0,0:10:02.93,0:10:05.73,Default,,0,0,0,,Менің басымда айналады
Dialogue: 0,0:10:05.85,0:10:08.19,Default,,0,0,0,,Айтыңыз.
Dialogue: 0,0:10:08.31,0:10:09.35,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:10:09.48,0:10:11.94,Default,,0,0,0,,Қызық көрінеді
Dialogue: 0,0:10:12.94,0:10:14.78,Default,,0,0,0,,Оны үлкейтіңіз
Dialogue: 0,0:10:14.90,0:10:17.65,Default,,0,0,0,,үшін көре алатындай етіп.
Dialogue: 0,0:10:17.78,0:10:20.28,Default,,0,0,0,,Мен толқу үстіндемін.
Dialogue: 0,0:10:20.41,0:10:21.78,Default,,0,0,0,,Морт ше?
Dialogue: 0,0:10:21.91,0:10:25.29,Default,,0,0,0,,Егер мен өз талантымды пайдалана алсам...
Dialogue: 0,0:10:28.12,0:10:31.58,Default,,0,0,0,,Мен ит етін көп жедім.
Dialogue: 0,0:10:32.25,0:10:35.25,Default,,0,0,0,,Мориске не айтуым керек?
Dialogue: 0,0:10:35.38,0:10:39.09,Default,,0,0,0,,«Кешіріңіз» деген сөз сізді патша етпейді.
Dialogue: 0,0:10:39.22,0:10:40.76,Default,,0,0,0,,Маған түсінік беріңіз
Dialogue: 0,0:10:42.22,0:10:44.76,Default,,0,0,0,,Мориссіз қызықсыз
Dialogue: 0,0:10:44.93,0:10:48.23,Default,,0,0,0,,Мен жек көретін дауысты ойласам да.
Dialogue: 0,0:10:48.39,0:10:49.44,Default,,0,0,0,,Ең жоғарғы деңгейдегі ессіз ғалым
Dialogue: 0,0:10:54.57,0:10:56.82,Default,,0,0,0,,Кешірім сұрауым керек пе?
Dialogue: 0,0:10:57.11,0:10:58.15,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:10:58.28,0:11:02.82,Default,,0,0,0,,Ұлы патшаны оның сезімдері басып кете алмайды.
Dialogue: 0,0:11:02.95,0:11:07.20,Default,,0,0,0,,Амелия, сен мені ойдан тайдырдың.
Dialogue: 0,0:11:07.33,0:11:09.83,Default,,0,0,0,,Жасаудың өзі ақымақтық
Dialogue: 0,0:11:10.33,0:11:12.29,Default,,0,0,0,,Кловер қош келдіңіз
Dialogue: 0,0:11:12.58,0:11:13.92,Default,,0,0,0,,Менің кездесуім болды.
Dialogue: 0,0:11:17.34,0:11:19.42,Default,,0,0,0,,Мұны таптым
Dialogue: 0,0:11:19.59,0:11:22.26,Default,,0,0,0,,Мемлекеттік мүлік қорланған
Dialogue: 0,0:11:22.43,0:11:23.59,Default,,0,0,0,,Кегасаре?
Dialogue: 0,0:11:23.72,0:11:24.68,Default,,0,0,0,,Зақымдалған
Dialogue: 0,0:11:24.80,0:11:25.72,Default,,0,0,0,,Хассон?
Dialogue: 0,0:11:25.85,0:11:26.85,Default,,0,0,0,,Бұл дудл
Dialogue: 0,0:11:26.97,0:11:30.27,Default,,0,0,0,,Дудлдерді орындау дұрыс па?
Dialogue: 0,0:11:31.56,0:11:33.98,Default,,0,0,0,,Дұрыс, мен сені кешірмеймін.
Dialogue: 0,0:11:34.11,0:11:37.82,Default,,0,0,0,,Мағынасы белгісіз, бірақ «ла-ла» дегенді барлық жерде естисіз.
Dialogue: 0,0:11:37.94,0:11:42.20,Default,,0,0,0,,«Лара»? Бұл көңілді естіледі.
Dialogue: 0,0:11:42.32,0:11:43.07,Default,,0,0,0,,Патша…
Dialogue: 0,0:11:43.20,0:11:43.74,Default,,0,0,0,,«Лара»!
Dialogue: 0,0:11:43.86,0:11:45.57,Default,,0,0,0,,Бұл не? Қайда жүрміз…
Dialogue: 0,0:11:45.70,0:11:48.83,Default,,0,0,0,,Лала! Лала! Қараңыз, айтыңыз
Dialogue: 0,0:11:48.95,0:11:50.66,Default,,0,0,0,,Бұл зұлым жоспар болса керек...
Dialogue: 0,0:11:52.21,0:11:53.12,Default,,0,0,0,,Бұл дауыс ше?
Dialogue: 0,0:11:56.79,0:11:58.38,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:12:00.09,0:12:00.80,Default,,0,0,0,,Нигеро!
Dialogue: 0,0:12:00.92,0:12:02.26,Default,,0,0,0,,Беде
Dialogue: 0,0:12:14.73,0:12:17.82,Default,,0,0,0,,Мен ол бұтадан қаша алмаймын!
Dialogue: 0,0:12:34.71,0:12:36.33,Default,,0,0,0,,Лала! Лала!
Dialogue: 0,0:12:45.09,0:12:47.97,Default,,0,0,0,,Бұл қызықты болды. Қайтадан жасайық.
Dialogue: 0,0:12:54.52,0:12:56.15,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:12:56.27,0:12:58.86,Default,,0,0,0,,Бұл жерде сізді күлдірмейді.
Dialogue: 0,0:12:59.02,0:13:02.28,Default,,0,0,0,,Әй, сен ақымақ есек.
Dialogue: 0,0:13:02.40,0:13:04.90,Default,,0,0,0,,Сіз осында жасырынып жүрсіз бе?
Dialogue: 0,0:13:08.07,0:13:09.33,Default,,0,0,0,,Бұл да жақсы емес пе?
Dialogue: 0,0:13:09.45,0:13:12.12,Default,,0,0,0,,Мен мейірімді емеспін...
Dialogue: 0,0:13:12.24,0:13:15.71,Default,,0,0,0,,Менімен сөйлесу қиын деп жиі айтады.
Dialogue: 0,0:13:15.92,0:13:20.54,Default,,0,0,0,,Бірақ біреудің сізбен сөйлескенін қаласаңыз...
Dialogue: 0,0:13:20.67,0:13:21.71,Default,,0,0,0,,Мен
Dialogue: 0,0:13:21.84,0:13:24.05,Default,,0,0,0,,Рахмет саған Кловер
Dialogue: 0,0:13:24.17,0:13:27.43,Default,,0,0,0,,Маған күлгенде, балалық шағым...
Dialogue: 0,0:13:27.55,0:13:28.76,Default,,0,0,0,,Бұл аянышты.
Dialogue: 0,0:13:29.47,0:13:30.97,Default,,0,0,0,,Бұл анықтама.
Dialogue: 0,0:13:31.22,0:13:33.60,Default,,0,0,0,,Бұл қоңыр дақ ше?
Dialogue: 0,0:13:34.06,0:13:37.77,Default,,0,0,0,,Бұл тезек сияқты, бірақ мүмкін...
Dialogue: 0,0:13:38.48,0:13:39.40,Default,,0,0,0,,Пок поку!
Dialogue: 0,0:13:40.06,0:13:43.36,Default,,0,0,0,,Жақын жерде Поку Поку ағашы бар.
Dialogue: 0,0:13:43.48,0:13:44.49,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:13:51.95,0:13:53.79,Default,,0,0,0,,Бұл жұмыс істей ме?
Dialogue: 0,0:13:53.91,0:13:59.42,Default,,0,0,0,,Егер сізді осы шаян шағып алса, Джунглидегі ең улы...
Dialogue: 0,0:13:59.54,0:14:00.50,Default,,0,0,0,,Ичикоро!
Dialogue: 0,0:14:01.38,0:14:05.13,Default,,0,0,0,,Патшаға кім жететінін шешуіміз керек.
Dialogue: 0,0:14:05.67,0:14:06.88,Default,,0,0,0,,үшін...
Dialogue: 0,0:14:07.38,0:14:08.51,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:11.47,0:14:13.43,Default,,0,0,0,,Маған сыйлық?
Dialogue: 0,0:14:13.60,0:14:14.93,Default,,0,0,0,,Корольге қаралған
Dialogue: 0,0:14:15.06,0:14:16.23,Default,,0,0,0,,Егер ол жеткізілсе
Dialogue: 0,0:14:16.35,0:14:17.89,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:14:18.02,0:14:21.15,Default,,0,0,0,,Маған қалдырыңыз, мен дұрыстап аламын.
Dialogue: 0,0:14:22.27,0:14:23.65,Default,,0,0,0,,Артқа қайтару жоқ.
Dialogue: 0,0:14:24.65,0:14:29.15,Default,,0,0,0,,Кингтің қатты таң қалатынына сенімдімін.
Dialogue: 0,0:14:35.62,0:14:37.41,Default,,0,0,0,,Масикура Жерде не...
Dialogue: 0,0:14:37.54,0:14:38.62,Default,,0,0,0,,Кешірім сұрау
Dialogue: 0,0:14:38.87,0:14:40.75,Default,,0,0,0,,Біз әңгіменің ортасындамыз.
Dialogue: 0,0:14:40.88,0:14:42.88,Default,,0,0,0,,Кешірім сұраймын.
Dialogue: 0,0:14:43.00,0:14:44.46,Default,,0,0,0,,Аузыңды жап
Dialogue: 0,0:14:44.59,0:14:46.42,Default,,0,0,0,,Сәлем Машикура
Dialogue: 0,0:14:46.55,0:14:51.05,Default,,0,0,0,,Сен менің орнымда болсаң, қалай татуласар едік...
Dialogue: 0,0:14:51.18,0:14:52.30,Default,,0,0,0,,Кешірім сұраймын
Dialogue: 0,0:14:52.80,0:14:54.05,Default,,0,0,0,,Масикура!
Dialogue: 0,0:14:55.01,0:14:56.77,Default,,0,0,0,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,0:14:56.89,0:14:59.77,Default,,0,0,0,,Қарапайым болса да
Dialogue: 0,0:14:59.89,0:15:02.35,Default,,0,0,0,,Сіз таң қалуыңыз мүмкін...
Dialogue: 0,0:15:02.48,0:15:06.19,Default,,0,0,0,,Мен де мінсіз патша емеспін.
Dialogue: 0,0:15:06.32,0:15:07.40,Default,,0,0,0,,Егер менің шарттарыма келіссең, мен жүрегіңді жазып, қайта тірілтамын.
Dialogue: 0,0:15:07.53,0:15:09.78,Default,,0,0,0,,Қиындыққа тап болсаңыз...
Dialogue: 0,0:15:09.90,0:15:15.66,Default,,0,0,0,,«Аға не істер еді?» деген ой.
Dialogue: 0,0:15:15.78,0:15:19.83,Default,,0,0,0,,«OJSNNRDUSR?» аббревиатурасы
Dialogue: 0,0:15:19.96,0:15:22.92,Default,,0,0,0,,Өйткені бұрынғы патша ешқашан кешірім сұрамаған...
Dialogue: 0,0:15:23.04,0:15:24.75,Default,,0,0,0,,Сіз кешірім сұрамайсыз ба?
Dialogue: 0,0:15:24.88,0:15:28.80,Default,,0,0,0,,Ағам маған тағын берді, бірақ
Dialogue: 0,0:15:28.92,0:15:31.88,Default,,0,0,0,,Мен ешқашан мұндай ұлы патша бола алмас едім.
Dialogue: 0,0:15:32.01,0:15:36.14,Default,,0,0,0,,Ұлы патша болудан алыс, ол ең нашар еді.
Dialogue: 0,0:15:36.26,0:15:38.60,Default,,0,0,0,,Шағымдар болған жоқ.
Dialogue: 0,0:15:38.72,0:15:42.48,Default,,0,0,0,,Мен сені ашуландырып аламын ба деп қорқамын, сондықтан үндемедім.
Dialogue: 0,0:15:42.60,0:15:45.61,Default,,0,0,0,,Ол жер аударуға шебер болды.
Dialogue: 0,0:15:45.77,0:15:48.44,Default,,0,0,0,,Шығу клишесі -
Dialogue: 0,0:15:48.61,0:15:52.40,Default,,0,0,0,,«Джунглиде жалғыз өл»?
Dialogue: 0,0:15:52.70,0:15:54.41,Default,,0,0,0,,Оның дәмі жақсы болды.
Dialogue: 0,0:15:54.53,0:15:55.95,Default,,0,0,0,,Патша
Dialogue: 0,0:15:56.08,0:15:59.37,Default,,0,0,0,,Өзіңіз дұрыс деп санайтын нәрсені жасаңыз
Dialogue: 0,0:15:59.54,0:16:03.87,Default,,0,0,0,,Бұрынғы патшаны мақсат етпе, одан асып түс.
Dialogue: 0,0:16:04.29,0:16:08.84,Default,,0,0,0,,Басқаша айтқанда, егер сіз өзіңіз таңдаған жолмен жүрсеңіз ...
Dialogue: 0,0:16:08.96,0:16:11.76,Default,,0,0,0,,Сіз ең жақсы патша бола аласыз.
Dialogue: 0,0:16:12.13,0:16:16.14,Default,,0,0,0,,Сен қандай ақылды бақасың.
Dialogue: 0,0:16:16.97,0:16:18.10,Default,,0,0,0,,Хамелеон
Dialogue: 0,0:16:18.22,0:16:21.43,Default,,0,0,0,,Қатты тілесең, бақа бола аласың.
Dialogue: 0,0:16:21.56,0:16:23.14,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:16:23.31,0:16:25.65,Default,,0,0,0,,Мен Мористен кешірім сұраймын.
Dialogue: 0,0:16:25.77,0:16:28.15,Default,,0,0,0,,Ашықтығыңызды көрсетсеңіз...
Dialogue: 0,0:16:28.32,0:16:32.65,Default,,0,0,0,,Мен ең жақсы патша екенімді дәлелдей аламын.
Dialogue: 0,0:16:35.20,0:16:37.62,Default,,0,0,0,,Патшаға сыйлық.
Dialogue: 0,0:16:37.87,0:16:39.03,Default,,0,0,0,,Таң қалдырыңыз!
Dialogue: 0,0:16:39.95,0:16:41.12,Default,,0,0,0,,Сыйлық па?
Dialogue: 0,0:16:41.25,0:16:46.50,Default,,0,0,0,,Сіздің туған күніңіз болмаса да, алты ай немесе екі ай бұрын?
Dialogue: 0,0:16:47.13,0:16:50.63,Default,,0,0,0,,Күте тұрыңыз, мен керемет идея таптым.
Dialogue: 0,0:16:50.75,0:16:55.34,Default,,0,0,0,,Менің ең жақсы патша екенімді дәлелдеу үшін...
Dialogue: 0,0:16:56.30,0:16:58.80,Default,,0,0,0,,Оны Мориске беріңіз
Dialogue: 0,0:16:58.93,0:17:02.27,Default,,0,0,0,,Салыстыру элементтері жақсы идея.
Dialogue: 0,0:17:05.94,0:17:09.31,Default,,0,0,0,,Бұл жақсы естіледі. Мен қызғаншақпын.
Dialogue: 0,0:17:10.11,0:17:14.74,Default,,0,0,0,,Патшадан құтылғаннан кейін жоспар шешілді.
Dialogue: 0,0:17:14.86,0:17:17.99,Default,,0,0,0,,Сонда жаңа патша кім болады?
Dialogue: 0,0:17:18.12,0:17:21.29,Default,,0,0,0,,Бізге патша керек емес пе?
Dialogue: 0,0:17:21.41,0:17:25.21,Default,,0,0,0,,Егер біз патша бола алатын болсақ, бұл басқа әңгіме болар еді.
Dialogue: 0,0:17:25.33,0:17:26.71,Default,,0,0,0,,Онда менмін
Dialogue: 0,0:17:26.83,0:17:30.13,Default,,0,0,0,,Күте тұрыңыз, маған да мүмкіндік беріңіз.
Dialogue: 0,0:17:30.25,0:17:33.34,Default,,0,0,0,,Мен екеуіңді ұстаймын.
Dialogue: 0,0:17:33.55,0:17:34.47,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:17:34.59,0:17:37.72,Default,,0,0,0,,Поку Поку жидектері қалды.
Dialogue: 0,0:17:37.84,0:17:41.39,Default,,0,0,0,,Дәл осы суретке ұқсайтын дудлда.
Dialogue: 0,0:17:41.51,0:17:45.85,Default,,0,0,0,,Поку Поку ағашының астында сіздің үйіңіз бар.
Dialogue: 0,0:17:45.98,0:17:49.69,Default,,0,0,0,,Балалар, тіпті сендердің портреттерің де болды.
Dialogue: 0,0:17:52.02,0:17:53.94,Default,,0,0,0,,Кінәлі туралы шешім қабылданды
Dialogue: 0,0:17:55.94,0:17:57.32,Default,,0,0,0,,Жоқ, бірақ Йор-чан менің байқамай тұрғанымда үйленіп кеткеніне сенбеймін.
Dialogue: 0,0:17:58.28,0:18:00.24,Default,,0,0,0,,Дәлелдемелерді жою.
Dialogue: 0,0:18:00.37,0:18:03.12,Default,,0,0,0,,Тағы дәлелдер бар.
Dialogue: 0,0:18:05.75,0:18:07.58,Default,,0,0,0,,Маған бәрін айт
Dialogue: 0,0:18:07.71,0:18:08.96,Default,,0,0,0,,Ал Вайолет ше?
Dialogue: 0,0:18:09.75,0:18:13.92,Default,,0,0,0,,Лемурды патшадан босат.
Dialogue: 0,0:18:14.05,0:18:17.93,Default,,0,0,0,,Сәлем! Саған бәрін айтып берсем не істеуім керек?
Dialogue: 0,0:18:18.05,0:18:19.38,Default,,0,0,0,,Әйелдерді ұруға болмайды
Dialogue: 0,0:18:25.93,0:18:27.39,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:18:27.52,0:18:30.94,Default,,0,0,0,,Мен патшаға сыйлық жібердім.
Dialogue: 0,0:18:31.06,0:18:34.02,Default,,0,0,0,,Ішінде улы шаян бар.
Dialogue: 0,0:18:34.15,0:18:36.36,Default,,0,0,0,,Арнайы сыйлық
Dialogue: 0,0:18:36.49,0:18:37.74,Default,,0,0,0,,Тоқтау керек
Dialogue: 0,0:18:37.86,0:18:42.24,Default,,0,0,0,,Корольді құтқару немесе революцияны тоқтатуды таңдаңыз.
Dialogue: 0,0:18:42.37,0:18:43.33,Default,,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:18:43.45,0:18:45.91,Default,,0,0,0,,Мен патшаға көмектесемін
Dialogue: 0,0:18:46.79,0:18:49.12,Default,,0,0,0,,Иә, бірінші патша.
Dialogue: 0,0:18:49.79,0:18:51.21,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:18:51.33,0:18:54.29,Default,,0,0,0,,Дұрыс жауап – патшаға көмектесу.
Dialogue: 0,0:18:54.42,0:18:58.30,Default,,0,0,0,,Біріншіден, бұл нағыз революция ма?
Dialogue: 0,0:18:58.42,0:18:59.59,Default,,0,0,0,,Әрине.
Dialogue: 0,0:18:59.72,0:19:01.55,Default,,0,0,0,,Басқаша көрінеді.
Dialogue: 0,0:19:01.68,0:19:02.72,Default,,0,0,0,,Бұл шынайы
Dialogue: 0,0:19:02.80,0:19:03.43,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:19:03.51,0:19:04.14,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:04.22,0:19:04.81,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:19:04.89,0:19:05.43,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:05.51,0:19:06.06,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:19:06.14,0:19:06.64,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:06.72,0:19:09.10,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:19:10.06,0:19:12.40,Default,,0,0,0,,Патшаға еш ойланбастан көмектесе аласыз.
Dialogue: 0,0:19:16.78,0:19:18.36,Default,,0,0,0,,Ол орындаушы.
Dialogue: 0,0:19:20.28,0:19:22.36,Default,,0,0,0,,Тағы да күлесіз бе?
Dialogue: 0,0:19:22.49,0:19:26.24,Default,,0,0,0,,Бұл дұрыс емес, өз аузыммен айтайын деп келдім.
Dialogue: 0,0:19:26.41,0:19:31.46,Default,,0,0,0,,Мен кешірім сұрауда өте нашармын.
Dialogue: 0,0:19:33.29,0:19:36.34,Default,,0,0,0,,Бірақ сіз ескі доссыз.
Dialogue: 0,0:19:36.50,0:19:42.09,Default,,0,0,0,,Әрқашан ұлы патшаның көлеңкесінде жасырыну қиын болуы керек.
Dialogue: 0,0:19:42.22,0:19:44.51,Default,,0,0,0,,Көп нәрсе қиын.
Dialogue: 0,0:19:44.64,0:19:48.06,Default,,0,0,0,,Сенің сезімдерің туралы ойлауым керек еді.
Dialogue: 0,0:19:48.18,0:19:50.35,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:19:50.93,0:19:51.85,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:19:54.73,0:19:56.02,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:19:58.03,0:19:59.32,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:20:00.19,0:20:01.20,Default,,0,0,0,,Окабе?
Dialogue: 0,0:20:01.53,0:20:05.32,Default,,0,0,0,,Мен сенің кешіріміңді алу үшін бәрін істеймін
Dialogue: 0,0:20:05.45,0:20:08.79,Default,,0,0,0,,Маған бұл сөздерді есту керек.
Dialogue: 0,0:20:08.99,0:20:09.95,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:10.08,0:20:14.83,Default,,0,0,0,,Мен сендерге татуласу белгісі ретінде сыйлық беремін.
Dialogue: 0,0:20:14.96,0:20:17.59,Default,,0,0,0,,Сізге ұнайды деп үміттенемін.
Dialogue: 0,0:20:19.84,0:20:22.67,Default,,0,0,0,,Сіз мені тағы да ұятқа қалдырмақшысыз ба?
Dialogue: 0,0:20:22.80,0:20:24.72,Default,,0,0,0,,Әрине жоқ
Dialogue: 0,0:20:24.84,0:20:29.10,Default,,0,0,0,,Мен мұны істегім келмеді. Бұл көңілді көрінеді.
Dialogue: 0,0:20:34.94,0:20:37.52,Default,,0,0,0,,Менің сыйлығымды не істейсің?
Dialogue: 0,0:20:37.65,0:20:39.78,Default,,0,0,0,,Бұл... бос.
Dialogue: 0,0:20:42.95,0:20:45.61,Default,,0,0,0,,Қауіп жоқ
Dialogue: 0,0:20:45.74,0:20:47.78,Default,,0,0,0,,жақсы болар еді
Dialogue: 0,0:20:47.91,0:20:49.62,Default,,0,0,0,,Морис Қабылдау
Dialogue: 0,0:20:49.74,0:20:52.66,Default,,0,0,0,,Сыйлықтардың маңыздысы – жүрек.
Dialogue: 0,0:20:52.79,0:20:53.50,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:20:53.62,0:20:55.29,Default,,0,0,0,,Неліктен бос қорап...
Dialogue: 0,0:20:59.67,0:21:01.38,Default,,0,0,0,,Ал, ал.
Dialogue: 0,0:21:03.09,0:21:03.97,Default,,0,0,0,,Сіздің арқаңызда!
Dialogue: 0,0:21:04.34,0:21:05.84,Default,,0,0,0,,Король Жарайды.
Dialogue: 0,0:21:11.52,0:21:13.64,Default,,0,0,0,,Ештеңе болмаса да шу шығарып тұрсың ба?
Dialogue: 0,0:21:20.11,0:21:21.48,Default,,0,0,0,,Егер ол жылдамдықты арттырса, тіпті модель ұшақ болса да—
Dialogue: 0,0:21:21.61,0:21:24.70,Default,,0,0,0,,Ештеңе болмаса да, бұл дүрбелең
Dialogue: 0,0:21:28.62,0:21:33.12,Default,,0,0,0,,Кешірім сұрауды аяқтайтын тосынсый
Dialogue: 0,0:21:33.25,0:21:39.67,Default,,0,0,0,,Шаянымнан қорқатындай кейіп таныту қызық болды ма?
Dialogue: 0,0:21:46.34,0:21:47.43,Default,,0,0,0,,Егер ол жылдамдықты арттырса, тіпті модель ұшақ болса да—
Dialogue: 0,0:21:50.10,0:21:51.47,Default,,0,0,0,,Осымен.
Dialogue: 0,0:21:51.60,0:21:56.35,Default,,0,0,0,,Патшалықта барлығын ауыртатын «әлгі жігіт» бар ма?
Dialogue: 0,0:21:56.98,0:21:59.94,Default,,0,0,0,,Біз оны тауып өлтіруіміз керек.
Dialogue: 0,0:22:00.06,0:22:03.69,Default,,0,0,0,,Сіз Корольді білдірмейсіз бе?
Dialogue: 0,0:22:03.82,0:22:06.78,Default,,0,0,0,,Олай болса, оны өзіңіз түсінуіңіз керек.
Dialogue: 0,0:22:07.61,0:22:09.70,Default,,0,0,0,,Менсінбеген адам, тұр.
Dialogue: 0,0:22:09.82,0:22:12.49,Default,,0,0,0,,Достарына күлгендерді кешір
Dialogue: 0,0:22:12.62,0:22:16.00,Default,,0,0,0,,Кинг күлді.
Dialogue: 0,0:22:16.12,0:22:21.21,Default,,0,0,0,,Ақымақ болма. Мен саған күлгенім анық.
Dialogue: 0,0:22:21.75,0:22:24.34,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:22:24.46,0:22:26.42,Default,,0,0,0,,Бұл әңгіме аяқталды.
Dialogue: 0,0:22:26.55,0:22:28.09,Default,,0,0,0,,Бұл әнді айт
Dialogue: 0,0:22:33.43,0:22:35.31,Default,,0,0,0,,бірге
Dialogue: 0,0:22:35.47,0:22:39.98,Default,,0,0,0,,Кәне, бәріміз көңіл көтерейік!
Dialogue: 0,0:23:05.96,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Акико Комори
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
