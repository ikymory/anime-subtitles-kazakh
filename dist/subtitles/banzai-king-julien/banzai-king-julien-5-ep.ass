Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:50.71,0:00:54.38,Default,,0,0,0,,Жарайсыңдар бәріміз келесі деңгейге өтейік.
Dialogue: 0,0:00:54.51,0:00:56.72,Default,,0,0,0,,Қолдарыңызды жоғары көтеріңіз
Dialogue: 0,0:00:56.84,0:01:00.47,Default,,0,0,0,,Барынша қатты шайқаңыз, сынса уайымдамаңыз
Dialogue: 0,0:01:03.39,0:01:08.56,Default,,0,0,0,,Жоқ, егер ол жыртылып кетсе, одан да көп уайымдамаңыз.
Dialogue: 0,0:01:10.32,0:01:13.23,Default,,0,0,0,,Одан да көп. Қолдарыңды жау деп ойла.
Dialogue: 0,0:01:13.36,0:01:16.91,Default,,0,0,0,,Кішкентай болса да, жолында болса да, кетпейді...
Dialogue: 0,0:01:23.58,0:01:25.12,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:01:37.72,0:01:39.55,Default,,0,0,0,,Біреу шабуыл жасады ма?
Dialogue: 0,0:01:45.18,0:01:47.19,Default,,0,0,0,,Жаңа су сырғаны?
Dialogue: 0,0:01:47.31,0:01:49.77,Default,,0,0,0,,Қатыгез оққағар
Dialogue: 0,0:01:49.90,0:01:52.40,Default,,0,0,0,,Бұл екінші су сырғаны.
Dialogue: 0,0:01:52.52,0:01:56.78,Default,,0,0,0,,үшін суды жақсы көреді, сондықтан олар сырғанайды.
Dialogue: 0,0:01:56.99,0:02:01.70,Default,,0,0,0,,Әркім, көбірек тайып, есегіңді сула.
Dialogue: 0,0:02:03.79,0:02:07.58,Default,,0,0,0,,Түсіндің бе? Ұлы патшаны жақсы көреді
Dialogue: 0,0:02:10.08,0:02:12.09,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:02:12.25,0:02:12.96,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:13.09,0:02:16.34,Default,,0,0,0,,Сіз де көңіл көтере аласыз.
Dialogue: 0,0:02:16.88,0:02:18.84,Default,,0,0,0,,Мен көңілді жүрмін
Dialogue: 0,0:02:19.84,0:02:23.89,Default,,0,0,0,,Эй Кловер, бірге билейік...
Dialogue: 0,0:02:24.89,0:02:27.02,Default,,0,0,0,,Себебі сіз бейқамдыққа жақындайсыз.
Dialogue: 0,0:02:27.27,0:02:28.31,Default,,0,0,0,,Жаңа жыл құтты болсын...
Dialogue: 0,0:02:29.06,0:02:31.27,Default,,0,0,0,,〝Жаңа жыл құтты болсын〞
Dialogue: 0,0:02:31.27,0:02:33.48,Default,,0,0,0,,〝Жаңа жылыңызбен〞
Dialogue: 0,0:02:31.27,0:02:33.48,Default,,0,0,0,,Ұзын тырнақтар қарумен бірдей
Dialogue: 0,0:02:35.07,0:02:37.11,Default,,0,0,0,,Жылама
Dialogue: 0,0:02:37.32,0:02:39.70,Default,,0,0,0,,Үй өртенген жоқ.
Dialogue: 0,0:02:45.24,0:02:47.37,Default,,0,0,0,,Сізге қай жерде ұнайды?
Dialogue: 0,0:02:47.50,0:02:52.92,Default,,0,0,0,,үшін көңіл көтеру үшін оны біреу қауіпсіз ұстауы керек.
Dialogue: 0,0:02:53.04,0:02:55.80,Default,,0,0,0,,Қараңдар, бұл бір жағынан сырғанау.
Dialogue: 0,0:03:03.80,0:03:07.14,Default,,0,0,0,,Иісі дәмді. Бұл не?
Dialogue: 0,0:03:10.44,0:03:12.10,Default,,0,0,0,,Менің бөксем өртеніп жатыр
Dialogue: 0,0:03:13.73,0:03:15.69,Default,,0,0,0,,Ачи чичи!
Dialogue: 0,0:03:15.90,0:03:17.65,Default,,0,0,0,,Суды кім өшірді?
Dialogue: 0,0:03:18.03,0:03:20.70,Default,,0,0,0,,Не жасырып тұрсың? Бұл мен.
Dialogue: 0,0:03:25.07,0:03:25.83,Default,,0,0,0,,Артқа...
Dialogue: 0,0:03:25.95,0:03:26.91,Default,,0,0,0,,Тайбар әулеті келді!!
Dialogue: 0,0:03:27.79,0:03:30.20,Default,,0,0,0,,Мен оны қандай да бір себептермен танимын.
Dialogue: 0,0:03:30.79,0:03:32.71,Default,,0,0,0,,Болашақтың қыраны?
Dialogue: 0,0:03:32.83,0:03:34.83,Default,,0,0,0,,Бұл сенің ағаң.
Dialogue: 0,0:03:34.96,0:03:39.09,Default,,0,0,0,,Жоқ, менің болашақ адамым қарт болуы мүмкін емес.
Dialogue: 0,0:03:39.21,0:03:40.92,Default,,0,0,0,,Бұл менің ағам Джулиан.
Dialogue: 0,0:03:41.05,0:03:43.43,Default,,0,0,0,,Мен бұл нені білдіретінін түсінбеймін...
Dialogue: 0,0:03:43.97,0:03:46.35,Default,,0,0,0,,Тыңдаңыз, міне, осыны білдіреді.
Dialogue: 0,0:03:46.47,0:03:51.35,Default,,0,0,0,,Уақыт саяхаты арқылы келген қария?
Dialogue: 0,0:03:51.48,0:03:53.35,Default,,0,0,0,,Жоқ, бұл сенің ағаң.
Dialogue: 0,0:03:56.56,0:03:57.86,Default,,0,0,0,,Бұрынғы патша?
Dialogue: 0,0:03:57.98,0:04:00.49,Default,,0,0,0,,Ол адам кенет жоғалып кетті.
Dialogue: 0,0:04:00.78,0:04:03.11,Default,,0,0,0,,Бұл жоғалып кеткен қарт.
Dialogue: 0,0:04:03.24,0:04:06.07,Default,,0,0,0,,Күте тұрыңыз, мен басымды тазалаймын.
Dialogue: 0,0:04:07.95,0:04:08.99,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:09.45,0:04:10.95,Default,,0,0,0,,Мен әлі түсінбеймін
Dialogue: 0,0:04:13.04,0:04:14.37,Default,,0,0,0,,Ағай!
Dialogue: 0,0:04:14.96,0:04:19.42,Default,,0,0,0,,Менің әлі тірі екеніме таң қалдыңыз ба?
Dialogue: 0,0:04:19.55,0:04:21.88,Default,,0,0,0,,...
Dialogue: 0,0:04:22.01,0:04:25.09,Default,,0,0,0,,Мен пайғамбарлықтың орындалғанына қуаныштымын.
Dialogue: 0,0:04:25.22,0:04:28.47,Default,,0,0,0,,Бұл мүлдем орынсыз емес. Мені тістеп алды.
Dialogue: 0,0:04:28.85,0:04:31.31,Default,,0,0,0,,Бұл өте ауыр жарақат, солай емес пе?
Dialogue: 0,0:04:31.43,0:04:32.93,Default,,0,0,0,,Бірақ тірі
Dialogue: 0,0:04:33.31,0:04:35.81,Default,,0,0,0,,Мен үміттендім... жоқ, мен уайымдадым.
Dialogue: 0,0:04:35.94,0:04:39.27,Default,,0,0,0,,Мен қайтадан патша боламын ба?
Dialogue: 0,0:04:39.82,0:04:41.11,Default,,0,0,0,,Уедди.
Dialogue: 0,0:04:41.23,0:04:43.24,Default,,0,0,0,,Неге қайтып келдің?
Dialogue: 0,0:04:43.36,0:04:45.86,Default,,0,0,0,,Керемет сұрақ.
Dialogue: 0,0:04:45.99,0:04:48.87,Default,,0,0,0,,Мен неге оралдым?
Dialogue: 0,0:04:49.78,0:04:53.37,Default,,0,0,0,,Дәл қазір аузымнан шығып жатыр.
Dialogue: 0,0:04:53.91,0:04:56.08,Default,,0,0,0,,〝Фосса шабуылы 65 күн〞
Dialogue: 0,0:04:57.38,0:04:59.79,Default,,0,0,0,,Жау туралы хабарым бар.
Dialogue: 0,0:04:59.92,0:05:04.22,Default,,0,0,0,,Бізді қорқытады деген қауесет бар.
Dialogue: 0,0:05:04.34,0:05:06.47,Default,,0,0,0,,Джулиан, тыңдап тұрсың ба?
Dialogue: 0,0:05:07.93,0:05:09.35,Default,,0,0,0,,Қандай жаңалық бар?
Dialogue: 0,0:05:09.68,0:05:11.35,Default,,0,0,0,,Жаңа ғана сөйлестім
Dialogue: 0,0:05:13.64,0:05:15.02,Default,,0,0,0,,Бұл жаман
Dialogue: 0,0:05:15.14,0:05:17.19,Default,,0,0,0,,А, сен не істейсің?
Dialogue: 0,0:05:18.02,0:05:19.61,Default,,0,0,0,,Маған адасып кетейін деп айт
Dialogue: 0,0:05:21.27,0:05:25.53,Default,,0,0,0,,Осындай жақсы сыйлық үшін рахмет.
Dialogue: 0,0:05:25.70,0:05:27.95,Default,,0,0,0,,Сіз не істеп жатырсыз...?
Dialogue: 0,0:05:28.16,0:05:34.20,Default,,0,0,0,,Мен Фоссаның жоспарларын жасырын түрде ашуды мақсат еттім.
Dialogue: 0,0:05:34.33,0:05:38.17,Default,,0,0,0,,Бірақ мен оны сенен алып кеткеніме өкінемін.
Dialogue: 0,0:05:38.29,0:05:42.30,Default,,0,0,0,,Өлмейтін денені алу мүмкіндігін пайдаланыңыз.
Dialogue: 0,0:05:43.05,0:05:44.17,Default,,0,0,0,,Өлмейтін дене?
Dialogue: 0,0:05:44.30,0:05:47.68,Default,,0,0,0,,Иә, бірақ сіз мұны істей алмайсыз.
Dialogue: 0,0:05:47.80,0:05:48.80,Default,,0,0,0,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 0,0:05:49.14,0:05:52.47,Default,,0,0,0,,Бұлай асығудың қажеті жоқ
Dialogue: 0,0:05:52.60,0:05:55.27,Default,,0,0,0,,Өлмейтіндік туралы айт
Dialogue: 0,0:05:55.39,0:05:57.48,Default,,0,0,0,,Әрбір патша нені қалайды
Dialogue: 0,0:05:57.60,0:06:00.02,Default,,0,0,0,,Барлық балалар-
Dialogue: 0,0:06:00.15,0:06:03.23,Default,,0,0,0,,«Өлмейтін Лемур» сабағында оқыңыз
Dialogue: 0,0:06:03.36,0:06:07.24,Default,,0,0,0,,Бұл өлместік қанша уақытқа созылады?
Dialogue: 0,0:06:07.36,0:06:08.74,Default,,0,0,0,,Өмір бойы
Dialogue: 0,0:06:10.87,0:06:12.49,Default,,0,0,0,,Партия партиясы
Dialogue: 0,0:06:12.62,0:06:16.00,Default,,0,0,0,,Өмір – бітпейтін кеш
Dialogue: 0,0:06:16.12,0:06:17.91,Default,,0,0,0,,Қайда және не істеу керек?
Dialogue: 0,0:06:18.04,0:06:23.46,Default,,0,0,0,,Фосса аумағындағы шабуыл жоспарларын ашыңыз
Dialogue: 0,0:06:23.59,0:06:26.92,Default,,0,0,0,,Фосса жоспарламайды
Dialogue: 0,0:06:27.05,0:06:32.51,Default,,0,0,0,,Бұл жолы басқаша. Мен жоспарды анықтауым керек ...
Dialogue: 0,0:06:32.72,0:06:35.39,Default,,0,0,0,,Бірақ Кинг, бұл...
Dialogue: 0,0:06:35.52,0:06:36.77,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:06:37.56,0:06:38.60,Default,,0,0,0,,Өлмейтіндік?
Dialogue: 0,0:06:38.73,0:06:40.90,Default,,0,0,0,,Бұл өз-өзіне қол жұмсау әрекеті. Кловерге...
Dialogue: 0,0:06:40.98,0:06:41.56,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:42.06,0:06:45.19,Default,,0,0,0,,Өлмейтін... Жоқ, бұл өте қауіпті.
Dialogue: 0,0:06:45.44,0:06:49.32,Default,,0,0,0,,Бұл құпия тапсырма, сондықтан бұл...
Dialogue: 0,0:06:49.45,0:06:50.57,Default,,0,0,0,,жасалды
Dialogue: 0,0:06:55.24,0:07:00.33,Default,,0,0,0,,Бұл Фоссаның костюмі. Бізді ешкім танымайды.
Dialogue: 0,0:07:01.17,0:07:02.17,Default,,0,0,0,,Біз?
Dialogue: 0,0:07:06.63,0:07:08.01,Default,,0,0,0,,Стратегия дегеніміз не?
Dialogue: 0,0:07:09.30,0:07:10.68,Default,,0,0,0,,Жақсы сұрақ.
Dialogue: 0,0:07:15.18,0:07:16.93,Default,,0,0,0,,«Фосса аумағынан тыс»
Dialogue: 0,0:07:17.06,0:07:21.02,Default,,0,0,0,,Сіз дірілдеп тұрсыз ба? Мен қазір де қайта аламын.
Dialogue: 0,0:07:21.14,0:07:24.11,Default,,0,0,0,,Өлмейтін дене
Dialogue: 0,0:07:24.98,0:07:25.98,Default,,0,0,0,,Менің басымдағы дауыс
Dialogue: 0,0:07:26.11,0:07:30.19,Default,,0,0,0,,Мына керемет жаңғырықты тыңдаңыз, жаңғырық...
Dialogue: 0,0:07:30.53,0:07:31.90,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:32.03,0:07:33.20,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:33.32,0:07:36.20,Default,,0,0,0,,Мінсізден артық Мінсіз...
Dialogue: 0,0:07:40.58,0:07:41.75,Default,,0,0,0,,Патша
Dialogue: 0,0:07:42.42,0:07:44.33,Default,,0,0,0,,Король Джулиен?
Dialogue: 0,0:07:44.50,0:07:47.75,Default,,0,0,0,,Сіз іздеген нәрсе емес
Dialogue: 0,0:07:48.13,0:07:51.63,Default,,0,0,0,,Мен де король Джулиенмін.
Dialogue: 0,0:07:52.38,0:07:56.05,Default,,0,0,0,,Маңдайда үлкен «J» әрпі бар.
Dialogue: 0,0:07:58.35,0:08:01.56,Default,,0,0,0,,Тағы бір патша серуендеп жүр
Dialogue: 0,0:08:01.68,0:08:03.35,Default,,0,0,0,,Джунглиде
Dialogue: 0,0:08:03.48,0:08:05.06,Default,,0,0,0,,Менің еріп жүруімсіз бе?
Dialogue: 0,0:08:05.19,0:08:09.98,Default,,0,0,0,,Қуан, ол жоқта мен оның орнын басамын.
Dialogue: 0,0:08:10.11,0:08:13.03,Default,,0,0,0,,Сіз мені қорғай аласыз.
Dialogue: 0,0:08:13.45,0:08:14.99,Default,,0,0,0,,Патша! Король!
Dialogue: 0,0:08:15.11,0:08:17.66,Default,,0,0,0,,Айлы түнде батут тебуге барайық
Dialogue: 0,0:08:17.78,0:08:18.62,Default,,0,0,0,,Фут~
Dialogue: 0,0:08:21.87,0:08:26.75,Default,,0,0,0,,Түсімде көрінетін патшаның әдемі аяқтары емес.
Dialogue: 0,0:08:26.83,0:08:28.13,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:08:29.59,0:08:33.26,Default,,0,0,0,,Мына шулы жігіт кім?
Dialogue: 0,0:08:33.38,0:08:37.60,Default,,0,0,0,,Бұл Морт. Ол корольдікі...
Dialogue: 0,0:08:37.72,0:08:38.89,Default,,0,0,0,,Ол менің ең жақын досым.
Dialogue: 0,0:08:39.01,0:08:40.18,Default,,0,0,0,,Ақыры босап шыққаныма қарамастан, мен бұл жерден сирек шығамын.
Dialogue: 0,0:08:40.31,0:08:42.52,Default,,0,0,0,,Неліктен Король тәжі?
Dialogue: 0,0:08:42.64,0:08:45.10,Default,,0,0,0,,Тек патша ғана бөртпе алады.
Dialogue: 0,0:08:45.23,0:08:48.61,Default,,0,0,0,,Бұл сен емес, басқа адам.
Dialogue: 0,0:08:48.73,0:08:52.53,Default,,0,0,0,,Ол сенен есе артық патша.
Dialogue: 0,0:08:53.19,0:08:56.41,Default,,0,0,0,,Мына жігітке тез қамқорлық жасаңыз.
Dialogue: 0,0:08:56.57,0:08:58.99,Default,,0,0,0,,Сен үшін кешірім сұраймын.
Dialogue: 0,0:09:07.54,0:09:09.75,Default,,0,0,0,,Мен қатты дауысты естимін.
Dialogue: 0,0:09:09.88,0:09:13.46,Default,,0,0,0,,Шынымен ескірген кеш.
Dialogue: 0,0:09:13.59,0:09:16.88,Default,,0,0,0,,үшінна айқайлау тым ақсақ.
Dialogue: 0,0:09:17.01,0:09:19.93,Default,,0,0,0,,Енді үйге қайтайық.
Dialogue: 0,0:09:23.98,0:09:26.56,Default,,0,0,0,,Жағдай қандай? Мен сенің бөксеңді ғана көремін
Dialogue: 0,0:09:27.27,0:09:28.65,Default,,0,0,0,,Морис үнсіз
Dialogue: 0,0:09:30.44,0:09:33.99,Default,,0,0,0,,Сәлем бәріңе, қалайсыңдар?
Dialogue: 0,0:09:39.24,0:09:41.74,Default,,0,0,0,,Қашайық
Dialogue: 0,0:09:42.37,0:09:47.29,Default,,0,0,0,,Жоқ, бұл сіздің өлмейтін болу мүмкіндігіңіз.
Dialogue: 0,0:09:47.42,0:09:50.84,Default,,0,0,0,,Өлмейтін болмай тұрып өлесің.
Dialogue: 0,0:09:50.96,0:09:51.84,Default,,0,0,0,,Мен үйге бармаймын
Dialogue: 0,0:09:52.50,0:09:53.17,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:09:53.30,0:09:54.09,Default,,0,0,0,,Ал Вайолет ше?
Dialogue: 0,0:10:06.06,0:10:07.18,Default,,0,0,0,,Оны салыңыз
Dialogue: 0,0:10:18.70,0:10:21.57,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:10:21.70,0:10:25.54,Default,,0,0,0,,Жарайды, мен үйге бармаймын, мені кіргіз.
Dialogue: 0,0:10:25.66,0:10:26.33,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:29.50,0:10:31.46,Default,,0,0,0,,Фосса Бұл керемет.
Dialogue: 0,0:10:31.92,0:10:33.38,Default,,0,0,0,,Жеуге болады!
Dialogue: 0,0:10:33.50,0:10:39.22,Default,,0,0,0,,Жоқ, бізді топқа қабылдадық.
Dialogue: 0,0:10:44.43,0:10:46.68,Default,,0,0,0,,Бұл не істеп жатыр?
Dialogue: 0,0:10:47.93,0:10:50.98,Default,,0,0,0,,Бұл созылған жер.
Dialogue: 0,0:10:51.27,0:10:55.86,Default,,0,0,0,,Жаңа патша барлығының денесінің қатып қалғанын сезеді.
Dialogue: 0,0:10:55.98,0:10:59.95,Default,,0,0,0,,«Жамбастарын төмен түсіре алмайтындар, олар есек болып көрінуде-»
Dialogue: 0,0:11:00.07,0:11:01.99,Default,,0,0,0,,«Азамат емес»
Dialogue: 0,0:11:02.70,0:11:05.24,Default,,0,0,0,,Басқа реформалар бар ма?
Dialogue: 0,0:11:05.53,0:11:07.91,Default,,0,0,0,,Аз... жоқ, көп
Dialogue: 0,0:11:08.04,0:11:09.29,Default,,0,0,0,,Маған бәрін көрсет
Dialogue: 0,0:11:09.66,0:11:15.25,Default,,0,0,0,,Бұл қоқыс және тоқыма жері.
Dialogue: 0,0:11:16.05,0:11:19.63,Default,,0,0,0,,Патшама тоқыма қазан жабу.
Dialogue: 0,0:11:20.34,0:11:23.64,Default,,0,0,0,,Бұл секіру алаңы
Dialogue: 0,0:11:26.97,0:11:29.56,Default,,0,0,0,,Бұл батут жері
Dialogue: 0,0:11:29.68,0:11:31.31,Default,,0,0,0,,Тақырыпты түсіндім.
Dialogue: 0,0:11:31.44,0:11:32.56,Default,,0,0,0,,Жалғастырғыңыз келе ме?
Dialogue: 0,0:11:32.69,0:11:34.48,Default,,0,0,0,,Жоқ, жеткілікті.
Dialogue: 0,0:11:34.86,0:11:38.15,Default,,0,0,0,,Мен сенімен ешқашан жақсы қарым-қатынаста болған емеспін.
Dialogue: 0,0:11:38.32,0:11:43.57,Default,,0,0,0,,Мен истерикаға ұшыраған кезде менде газ пайда болады, сондықтан маған бұл туралы айтпауды айтады.
Dialogue: 0,0:11:44.07,0:11:46.78,Default,,0,0,0,,Ах, бірақ бұл баяғыда болды.
Dialogue: 0,0:11:46.91,0:11:50.37,Default,,0,0,0,,...
Dialogue: 0,0:11:50.96,0:11:52.46,Default,,0,0,0,,Сізге бұл ұнамайды, солай ма?
Dialogue: 0,0:11:52.58,0:11:57.55,Default,,0,0,0,,...
Dialogue: 0,0:11:57.67,0:12:01.13,Default,,0,0,0,,...
Dialogue: 0,0:12:01.47,0:12:06.60,Default,,0,0,0,,...
Dialogue: 0,0:12:06.72,0:12:09.89,Default,,0,0,0,,Менің ойымша, сіз дәл осылай айтқыңыз келеді ...
Dialogue: 0,0:12:10.02,0:12:10.72,Default,,0,0,0,,Іздеу
Dialogue: 0,0:12:10.85,0:12:11.81,Default,,0,0,0,,Не?
Dialogue: 0,0:12:11.93,0:12:13.98,Default,,0,0,0,,Мен тағы да айтамын
Dialogue: 0,0:12:14.10,0:12:17.27,Default,,0,0,0,,Соңғысын алыңыз.
Dialogue: 0,0:12:33.83,0:12:37.13,Default,,0,0,0,,Олар көңілді балалар, сен білесің бе?
Dialogue: 0,0:12:37.63,0:12:40.09,Default,,0,0,0,,Сіз білуге ​​мүмкіндік жоқ.
Dialogue: 0,0:12:40.21,0:12:45.13,Default,,0,0,0,,...
Dialogue: 0,0:12:45.26,0:12:50.81,Default,,0,0,0,,...
Dialogue: 0,0:12:51.97,0:12:55.64,Default,,0,0,0,,...
Dialogue: 0,0:12:55.77,0:12:59.57,Default,,0,0,0,,Фоссаның жоспарларын зерттейік
Dialogue: 0,0:12:59.69,0:13:01.94,Default,,0,0,0,,Сол үшін келдің емес пе?
Dialogue: 0,0:13:02.07,0:13:06.53,Default,,0,0,0,,...
Dialogue: 0,0:13:06.66,0:13:08.37,Default,,0,0,0,,Мұқият қараңыз... Ах!
Dialogue: 0,0:13:09.58,0:13:12.58,Default,,0,0,0,,Жоқ, жамбасыңызды тегіс айналдырыңыз.
Dialogue: 0,0:13:12.70,0:13:15.87,Default,,0,0,0,,Фосса Музыканы сезіну
Dialogue: 0,0:13:19.21,0:13:20.34,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:13:20.84,0:13:24.51,Default,,0,0,0,,Олар сіздің турнирге қатысуыңызды қалайтын сияқты.
Dialogue: 0,0:13:25.22,0:13:28.39,Default,,0,0,0,,Жүр, мен саған күшімді көрсетемін.
Dialogue: 0,0:13:29.51,0:13:31.76,Default,,0,0,0,,О, бұл лемур.
Dialogue: 0,0:13:36.89,0:13:39.10,Default,,0,0,0,,Морис Осымен.
Dialogue: 0,0:13:56.87,0:14:00.75,Default,,0,0,0,,Толық жеңдік, біз ең мықты сияқтымыз.
Dialogue: 0,0:14:00.88,0:14:03.67,Default,,0,0,0,,Олардың жоспарын тез анықтайық.
Dialogue: 0,0:14:04.17,0:14:06.92,Default,,0,0,0,,Сіз бір нәрсеге қолыңызды тигізесіз бе?
Dialogue: 0,0:14:08.55,0:14:10.72,Default,,0,0,0,,Бұл әйел Фосса.
Dialogue: 0,0:14:10.84,0:14:12.72,Default,,0,0,0,,Ер адам болуы мүмкін
Dialogue: 0,0:14:14.97,0:14:17.06,Default,,0,0,0,,О, мына дауыс
Dialogue: 0,0:14:17.18,0:14:18.23,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:14:18.35,0:14:19.94,Default,,0,0,0,,Бұл керемет, Морис.
Dialogue: 0,0:14:20.06,0:14:24.40,Default,,0,0,0,,Мені Фосса еркелетіп жатқан сияқты.
Dialogue: 0,0:14:24.53,0:14:26.44,Default,,0,0,0,,Бұл біз.
Dialogue: 0,0:14:26.57,0:14:30.74,Default,,0,0,0,,Менің де осында екенімді ұмытпа.
Dialogue: 0,0:14:30.87,0:14:33.20,Default,,0,0,0,,Сіз қызғанасыз ба?
Dialogue: 0,0:14:33.58,0:14:36.79,Default,,0,0,0,,Ол сізді қызықтыратын сияқты.
Dialogue: 0,0:14:36.91,0:14:39.54,Default,,0,0,0,,Оны қазір тоқтатпасақ...
Dialogue: 0,0:14:40.42,0:14:41.71,Default,,0,0,0,,Мен қайда жүретінім – менің ісім, солай емес пе?
Dialogue: 0,0:14:43.46,0:14:48.42,Default,,0,0,0,,...
Dialogue: 0,0:14:48.55,0:14:54.31,Default,,0,0,0,,...
Dialogue: 0,0:14:55.18,0:14:57.22,Default,,0,0,0,,Маған өлместік керек емес
Dialogue: 0,0:14:57.47,0:14:59.10,Default,,0,0,0,,«Қоқыс алаңы жабылды»
Dialogue: 0,0:15:02.10,0:15:02.98,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:15:03.56,0:15:05.90,Default,,0,0,0,,Бұл тапсырыс болғандықтан көмектесу мүмкін емес.
Dialogue: 0,0:15:07.69,0:15:11.61,Default,,0,0,0,,Жылама, Кингтің де ойы бар екеніне сенімдімін.
Dialogue: 0,0:15:11.86,0:15:13.78,Default,,0,0,0,,Маған ұнамайды Маған ұнамайды
Dialogue: 0,0:15:13.91,0:15:17.16,Default,,0,0,0,,Егер тайып кетсең, мен сені кешірмеймін.
Dialogue: 0,0:15:17.29,0:15:21.54,Default,,0,0,0,,Тоқта, сатқын, қызық жау.
Dialogue: 0,0:15:22.21,0:15:24.42,Default,,0,0,0,,Маған қауіп ұнайды
Dialogue: 0,0:15:24.54,0:15:28.96,Default,,0,0,0,,Ермек қауіп әкелетіндіктен, мен де көңілді ұнатамын.
Dialogue: 0,0:15:29.09,0:15:31.76,Default,,0,0,0,,Мен бұған мүлдем сене алмаймын.
Dialogue: 0,0:15:31.88,0:15:33.14,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:15:42.94,0:15:45.94,Default,,0,0,0,,Қараңызшы, мен де ләззат аламын...
Dialogue: 0,0:15:46.07,0:15:49.69,Default,,0,0,0,,Мен көңілді болдым. Бұл жаман болған жоқ.
Dialogue: 0,0:15:49.82,0:15:53.45,Default,,0,0,0,,Доспыз, доспыз, уау уау...
Dialogue: 0,0:15:53.99,0:15:57.74,Default,,0,0,0,,Мен одан ләззат алғаныма сене алар емеспін.
Dialogue: 0,0:16:02.46,0:16:04.42,Default,,0,0,0,,Мен мұны қайталағым келеді
Dialogue: 0,0:16:05.29,0:16:06.42,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:16:08.75,0:16:11.55,Default,,0,0,0,,Не болды? Сіз терлеп жатырсыз.
Dialogue: 0,0:16:11.67,0:16:13.84,Default,,0,0,0,,Сізде қызба бар ма?
Dialogue: 0,0:16:13.97,0:16:15.80,Default,,0,0,0,,Қозғалма, мен сені емдеймін.
Dialogue: 0,0:16:15.93,0:16:18.68,Default,,0,0,0,,Су сырғанағындағы су
Dialogue: 0,0:16:18.81,0:16:20.72,Default,,0,0,0,,Бұл өте қызық болды
Dialogue: 0,0:16:20.85,0:16:24.27,Default,,0,0,0,,Мен саған оны алып кет деп айтуым керек еді.
Dialogue: 0,0:16:24.40,0:16:27.11,Default,,0,0,0,,Қызба сізді ақылсыз етті ме?
Dialogue: 0,0:16:27.23,0:16:28.48,Default,,0,0,0,,Мен сені емдеймін
Dialogue: 0,0:16:28.61,0:16:30.19,Default,,0,0,0,,Қызу деген жоқ!
Dialogue: 0,0:16:30.32,0:16:33.20,Default,,0,0,0,,Дөрекілігіңіз үшін кешіріңіз.
Dialogue: 0,0:16:33.32,0:16:38.12,Default,,0,0,0,,Бірақ біраз уақыттан бері патшалық бірінші рет бақытқа толы.
Dialogue: 0,0:16:38.41,0:16:41.12,Default,,0,0,0,,Король Джулиенге рахмет
Dialogue: 0,0:16:41.25,0:16:45.46,Default,,0,0,0,,Кинг реформасын өткенге дейін қорғаңыз
Dialogue: 0,0:16:45.58,0:16:48.79,Default,,0,0,0,,Пайдасы жоқ, ол қайтып келмейді.
Dialogue: 0,0:16:49.55,0:16:53.84,Default,,0,0,0,,Ақырын қайталап айта аласыз ба?
Dialogue: 0,0:16:56.84,0:17:00.72,Default,,0,0,0,,Фосса-кун Фосса-кун
Dialogue: 0,0:17:02.10,0:17:03.52,Default,,0,0,0,,Бітті.
Dialogue: 0,0:17:03.64,0:17:08.19,Default,,0,0,0,,Патша киім киіп, жауына ғашық.
Dialogue: 0,0:17:08.31,0:17:12.28,Default,,0,0,0,,Бұдан асқан сорақы жағдай жоқ.
Dialogue: 0,0:17:14.90,0:17:19.70,Default,,0,0,0,,Фосса Сәл күтіңіз Фосса дереу оралыңыз
Dialogue: 0,0:17:22.54,0:17:26.00,Default,,0,0,0,,Фосса орындалуда, араласпаңыз.
Dialogue: 0,0:17:26.12,0:17:27.71,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,0:17:27.83,0:17:28.58,Default,,0,0,0,,Бұл стратегия.
Dialogue: 0,0:17:28.71,0:17:32.88,Default,,0,0,0,,«Дұшпаныңды білу үшін оған жақындап, үйлен.»
Dialogue: 0,0:17:33.01,0:17:36.05,Default,,0,0,0,,Сіз Фосса елін ала аласыз.
Dialogue: 0,0:17:36.18,0:17:39.85,Default,,0,0,0,,Өз еліңнен жырақта болсаң да?
Dialogue: 0,0:17:39.97,0:17:44.22,Default,,0,0,0,,Оның орнына менің ағам патша болып отыр.
Dialogue: 0,0:17:44.35,0:17:47.48,Default,,0,0,0,,Ағаң айтты ма?
Dialogue: 0,0:17:47.60,0:17:51.57,Default,,0,0,0,,О, сен маған Фоссаның жоспарлары туралы да айттың.
Dialogue: 0,0:17:51.69,0:17:54.94,Default,,0,0,0,,Сондықтан мен мұнда білу үшін келдім.
Dialogue: 0,0:17:57.40,0:18:01.24,Default,,0,0,0,,Фосса сендер, балалар Фосса некелері
Dialogue: 0,0:18:02.12,0:18:04.20,Default,,0,0,0,,Бұл қарттың тұзағы
Dialogue: 0,0:18:05.08,0:18:07.04,Default,,0,0,0,,Неке туралы шешім қабылданды.
Dialogue: 0,0:18:07.75,0:18:11.13,Default,,0,0,0,,Мен гүлге құмар немесе гүлге құмар боламын.
Dialogue: 0,0:18:11.25,0:18:12.13,Default,,0,0,0,,Фосса маңында
Dialogue: 0,0:18:17.38,0:18:20.72,Default,,0,0,0,,Сіз не істеп жатырсыз? Ол әлдеқашан жеп қойған.
Dialogue: 0,0:18:21.89,0:18:24.60,Default,,0,0,0,,Тағы бірдеңе десең, мен сені егіз деп атаймын.
Dialogue: 0,0:18:24.85,0:18:27.06,Default,,0,0,0,,Лаверн мен Ширли
Dialogue: 0,0:18:27.18,0:18:28.94,Default,,0,0,0,,Әй, ойланып көрші.
Dialogue: 0,0:18:29.06,0:18:32.06,Default,,0,0,0,,Қайсысы жақсы: қорқыныш немесе ләззат?
Dialogue: 0,0:18:32.19,0:18:33.32,Default,,0,0,0,,Анықталған
Dialogue: 0,0:18:37.15,0:18:42.03,Default,,0,0,0,,Кішкентай кезімнен сүйкімді едім.
Dialogue: 0,0:18:42.16,0:18:43.83,Default,,0,0,0,,Үйленуді армандадым
Dialogue: 0,0:18:43.95,0:18:46.79,Default,,0,0,0,,«Көрші есіктегі ағаш» фильміндегі Карен есіңізде ме?
Dialogue: 0,0:18:46.91,0:18:51.58,Default,,0,0,0,,Бұл біртүрлі қол пішінді сүйкімді маймыл болды.
Dialogue: 0,0:18:51.71,0:18:54.67,Default,,0,0,0,,Осы күндері не істеп жүрсің деп ойлаймын.
Dialogue: 0,0:18:54.80,0:18:58.80,Default,,0,0,0,,Мені Фосса жеп қойды. Бұл кінәлі болуы мүмкін.
Dialogue: 0,0:18:59.34,0:19:00.30,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,0:19:00.43,0:19:03.93,Default,,0,0,0,,Бір мағынада екеуіне де үйлендім.
Dialogue: 0,0:19:04.05,0:19:05.64,Default,,0,0,0,,Ағам -
Dialogue: 0,0:19:05.76,0:19:10.77,Default,,0,0,0,,Мен тағы да таққа отырғым келгендіктен сені осында жібердім.
Dialogue: 0,0:19:10.89,0:19:14.73,Default,,0,0,0,,Үйленгендердің қызғаныштары?
Dialogue: 0,0:19:15.11,0:19:16.19,Default,,0,0,0,,Үйленуге рұқсат етілмейді
Dialogue: 0,0:19:16.32,0:19:20.36,Default,,0,0,0,,Сіз қайда екеніңізді ұмыттыңыз ба?
Dialogue: 0,0:19:20.49,0:19:21.74,Default,,0,0,0,,Мен қазір кетемін.
Dialogue: 0,0:19:29.37,0:19:31.87,Default,,0,0,0,,Тапсырманы орындаңыз
Dialogue: 0,0:19:49.81,0:19:52.02,Default,,0,0,0,,Мүмкіндігінше тезірек
Dialogue: 0,0:19:54.23,0:19:56.23,Default,,0,0,0,,Сіз Fossa нәжісін жейсіз бе?
Dialogue: 0,0:19:56.44,0:19:58.36,Default,,0,0,0,,Фосса тағамы
Dialogue: 0,0:19:58.48,0:20:00.57,Default,,0,0,0,,...
Dialogue: 0,0:20:06.03,0:20:07.70,Default,,0,0,0,,Мен оны көрмеуім керек еді.
Dialogue: 0,0:20:07.83,0:20:09.75,Default,,0,0,0,,Бұл патша болуы керек пе?
Dialogue: 0,0:20:09.87,0:20:11.12,Default,,0,0,0,,Әрине.
Dialogue: 0,0:20:14.71,0:20:17.75,Default,,0,0,0,,Қозғалмаңыз.
Dialogue: 0,0:20:21.55,0:20:24.59,Default,,0,0,0,,Рәсім жойылған сияқты.
Dialogue: 0,0:20:25.59,0:20:30.06,Default,,0,0,0,,Мені жегің келсе, бөкседен бастауды ұсынамын.
Dialogue: 0,0:20:30.18,0:20:33.69,Default,,0,0,0,,Ол өте шырынды, майы бар.
Dialogue: 0,0:20:34.19,0:20:35.44,Default,,0,0,0,,Бұл бұлшықет
Dialogue: 0,0:20:35.98,0:20:38.19,Default,,0,0,0,,Міне, ақымақтар.
Dialogue: 0,0:20:38.32,0:20:43.24,Default,,0,0,0,,Дәмді ішкі мүшелерге толы лемур туралы не деуге болады?
Dialogue: 0,0:20:45.28,0:20:47.66,Default,,0,0,0,,Беде Сен мұнда не істеп жүрсің?
Dialogue: 0,0:20:47.78,0:20:49.41,Default,,0,0,0,,Патшаға көмектесу
Dialogue: 0,0:20:53.66,0:20:55.21,Default,,0,0,0,,Олар осы жаққа келеді.
Dialogue: 0,0:20:57.25,0:20:58.54,Default,,0,0,0,,Бөлінбеу
Dialogue: 0,0:20:58.67,0:21:00.09,Default,,0,0,0,,А, бұл оңай.
Dialogue: 0,0:21:14.60,0:21:15.77,Default,,0,0,0,,Осылай орындаңыз
Dialogue: 0,0:21:30.08,0:21:31.83,Default,,0,0,0,,Барлық ағай-
Dialogue: 0,0:21:31.95,0:21:35.62,Default,,0,0,0,,Таққа қайта отыру үшін тұзақ болды дедің бе?
Dialogue: 0,0:21:35.75,0:21:40.13,Default,,0,0,0,,Сіз кеңесші болсаңыз да, осы уақытқа дейін неге үнсіз қалдыңыз?
Dialogue: 0,0:21:41.84,0:21:45.63,Default,,0,0,0,,Сен мені Кловерді таңдадың
Dialogue: 0,0:21:45.76,0:21:50.22,Default,,0,0,0,,Жыл бойы рахаттанып жүру қауіпті.
Dialogue: 0,0:21:50.35,0:21:53.14,Default,,0,0,0,,Бірақ бұл күнде қорқып жүргеннен жақсы
Dialogue: 0,0:21:53.27,0:21:57.19,Default,,0,0,0,,Ал мен қауіптен ләззат аламын.
Dialogue: 0,0:21:57.39,0:21:58.40,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:59.27,0:21:59.94,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:22:00.06,0:22:02.15,Default,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:22:02.65,0:22:04.74,Default,,0,0,0,,Мен жалақымды көтермеймін, бірақ
Dialogue: 0,0:22:04.86,0:22:07.53,Default,,0,0,0,,Біреудің атынан қолым шаршады.
Dialogue: 0,0:22:07.95,0:22:08.61,Default,,0,0,0,,I
Dialogue: 0,0:22:12.12,0:22:15.00,Default,,0,0,0,,Диспозиция дегеніміз не? Ол мен сене алмайтын жігіт
Dialogue: 0,0:22:15.12,0:22:17.83,Default,,0,0,0,,Сонда да бұл менің отбасым.
Dialogue: 0,0:22:18.17,0:22:21.84,Default,,0,0,0,,Ойымызды өзгертуге мүмкіндік алайық
Dialogue: 0,0:22:21.96,0:22:25.55,Default,,0,0,0,,Бұл сіздің жаңа өмір сүру мүмкіндігіңіз.
Dialogue: 0,0:22:27.01,0:22:30.64,Default,,0,0,0,,Сіздің басыңызда бірдеңе бар ма?
Dialogue: 0,0:22:31.39,0:22:35.81,Default,,0,0,0,,Бұл өтірік, Джулиан.
Dialogue: 0,0:22:38.27,0:22:40.10,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:23:07.26,0:23:09.26,Default,,0,0,0,,Жапон субтитрлері Кайо Уэда
Dialogue: 0,0:23:10.76,0:23:16.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
