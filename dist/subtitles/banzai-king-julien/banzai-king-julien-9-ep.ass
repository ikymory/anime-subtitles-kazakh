Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:48.29,0:00:50.30,Default,,0,0,0,,«Туған күніңмен Тодд»
Dialogue: 0,0:00:50.42,0:00:53.13,Default,,0,0,0,,Тодд деген кім?
Dialogue: 0,0:00:53.26,0:00:56.43,Default,,0,0,0,,Неліктен мені шақырмайды?
Dialogue: 0,0:00:56.76,0:00:58.34,Default,,0,0,0,,Қоқыс есебі
Dialogue: 0,0:00:58.51,0:01:00.97,Default,,0,0,0,,«Тоддтан»? Мен қоқысты білмеймін
Dialogue: 0,0:01:01.97,0:01:04.81,Default,,0,0,0,,Жарайды, осы жерден тілек айтайық.
Dialogue: 0,0:01:05.23,0:01:07.27,Default,,0,0,0,,Мен Тоддты білмеймін.
Dialogue: 0,0:01:07.94,0:01:12.78,Default,,0,0,0,,Бірақ мен торт жей аламын деп ойлаймын.
Dialogue: 0,0:01:13.36,0:01:14.90,Default,,0,0,0,,Тоддқа бәрібір
Dialogue: 0,0:01:15.03,0:01:18.57,Default,,0,0,0,,Оны жайына қалдырсаң, одан да жаман болады.
Dialogue: 0,0:01:19.91,0:01:22.08,Default,,0,0,0,,Шыбындар, кедергі жасамаңдар
Dialogue: 0,0:01:27.71,0:01:28.88,Default,,0,0,0,,Бетіңізді көрсетпеңіз
Dialogue: 0,0:01:29.13,0:01:30.29,Default,,0,0,0,,Бет жоқ
Dialogue: 0,0:01:33.13,0:01:36.34,Default,,0,0,0,,Көздер! Қандай жиіркенішті жәндік
Dialogue: 0,0:01:48.77,0:01:51.11,Default,,0,0,0,,Таяқшаны жерге қойыңыз
Dialogue: 0,0:01:51.94,0:01:55.90,Default,,0,0,0,,Қолыңызды көтеріп, ақырын бұрылыңыз.
Dialogue: 0,0:01:58.86,0:01:59.82,Default,,0,0,0,,Король?
Dialogue: 0,0:02:00.32,0:02:04.04,Default,,0,0,0,,Мен бұл өте бейберекет екенін мойындаймын.
Dialogue: 0,0:02:04.16,0:02:06.79,Default,,0,0,0,,Мұны Кинг жасады ма?
Dialogue: 0,0:02:06.91,0:02:08.41,Default,,0,0,0,,Тоддты жек көреді
Dialogue: 0,0:02:09.33,0:02:12.42,Default,,0,0,0,,Қорытынды жасауға асықпаңыз
Dialogue: 0,0:02:12.54,0:02:15.05,Default,,0,0,0,,Қандай да бір себеп болуы керек
Dialogue: 0,0:02:15.17,0:02:16.26,Default,,0,0,0,,, солай ма?
Dialogue: 0,0:02:19.38,0:02:23.14,Default,,0,0,0,,Әрине себебі бар.
Dialogue: 0,0:02:23.30,0:02:25.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:27.85,0:02:28.69,Default,,0,0,0,,Бұл геккон.
Dialogue: 0,0:02:28.81,0:02:30.10,Default,,0,0,0,,Кішкентай геккон?
Dialogue: 0,0:02:31.48,0:02:34.82,Default,,0,0,0,,Жоқ, сен соншалықты ақымақсың.
Dialogue: 0,0:02:34.94,0:02:37.49,Default,,0,0,0,,Мұны үлкен геккон жасады.
Dialogue: 0,0:02:37.61,0:02:38.28,Default,,0,0,0,,Ол қаншалықты үлкен?
Dialogue: 0,0:02:38.40,0:02:39.70,Default,,0,0,0,,Бұл үлкен жігіт.
Dialogue: 0,0:02:39.82,0:02:42.91,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:02:43.03,0:02:46.20,Default,,0,0,0,,Барлығын көру үшін 12 көз керек
Dialogue: 0,0:02:46.49,0:02:49.41,Default,,0,0,0,,Ол соншалықты үлкен бола ма?
Dialogue: 0,0:02:49.54,0:02:52.58,Default,,0,0,0,,Бұл геккон жалғыз өседі.
Dialogue: 0,0:02:52.71,0:02:54.84,Default,,0,0,0,,Өйткені мен көп жеймін
Dialogue: 0,0:02:55.25,0:02:56.17,Default,,0,0,0,,Торт жеңіз
Dialogue: 0,0:02:56.67,0:02:58.38,Default,,0,0,0,,Және де лемурлар!
Dialogue: 0,0:02:59.26,0:03:01.51,Default,,0,0,0,,Барлығы өледі!
Dialogue: 0,0:03:01.63,0:03:03.34,Default,,0,0,0,,бұл дұрыс
Dialogue: 0,0:03:03.47,0:03:06.51,Default,,0,0,0,,Мен оны «Мега Гекко» деп атадым
Dialogue: 0,0:03:06.64,0:03:10.69,Default,,0,0,0,,Кешті, лемурды және тортты бұзу -
Dialogue: 0,0:03:10.81,0:03:12.23,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:03:13.10,0:03:14.65,Default,,0,0,0,,Мен оны бірінші рет естіп тұрмын.
Dialogue: 0,0:03:14.77,0:03:19.90,Default,,0,0,0,,Өйткені меннен басқа әлсіз патшалар мен сөйлей алмай өлтірілді.
Dialogue: 0,0:03:20.03,0:03:21.65,Default,,0,0,0,,Сонымен Король туралы не деуге болады?
Dialogue: 0,0:03:21.78,0:03:23.57,Default,,0,0,0,,Біз соғыстық.
Dialogue: 0,0:03:24.12,0:03:25.20,Default,,0,0,0,,Жаңғақтармен
Dialogue: 0,0:03:25.33,0:03:26.70,Default,,0,0,0,,Сіз жаңғақ жейсіз бе?
Dialogue: 0,0:03:26.83,0:03:29.20,Default,,0,0,0,,Ақымақ болма, Клевер
Dialogue: 0,0:03:29.33,0:03:33.63,Default,,0,0,0,,Жаңғаққа қатты аллергиясы бар.
Dialogue: 0,0:03:33.96,0:03:37.96,Default,,0,0,0,,Сонымен мен жаңғақты аузыма тығып, лақтырып жібердім.
Dialogue: 0,0:03:38.46,0:03:41.30,Default,,0,0,0,,Патша басқалардан күшті
Dialogue: 0,0:03:43.76,0:03:45.14,Default,,0,0,0,,Ол қандай адам?
Dialogue: 0,0:03:45.26,0:03:47.31,Default,,0,0,0,,Өте үлкен...
Dialogue: 0,0:03:48.18,0:03:49.52,Default,,0,0,0,,Қызыл көздер
Dialogue: 0,0:03:49.64,0:03:51.85,Default,,0,0,0,,Ол өртеніп кетті
Dialogue: 0,0:03:52.69,0:03:54.48,Default,,0,0,0,,Тек түнде пайда болады
Dialogue: 0,0:03:54.60,0:03:55.73,Default,,0,0,0,,Қазір күн
Dialogue: 0,0:03:55.86,0:03:57.86,Default,,0,0,0,,Олар күндіз де шығады.
Dialogue: 0,0:03:57.98,0:04:00.40,Default,,0,0,0,,Мен қатты аштық сезінемін.
Dialogue: 0,0:04:00.53,0:04:02.53,Default,,0,0,0,,Бәрінен де қорқынышты не бар...
Dialogue: 0,0:04:02.65,0:04:06.20,Default,,0,0,0,,Біздің ішімізде жасырылған заттар бар.
Dialogue: 0,0:04:06.32,0:04:08.45,Default,,0,0,0,,Мен дәл қазір осында болуым мүмкін.
Dialogue: 0,0:04:11.16,0:04:14.12,Default,,0,0,0,,Кинг маған көмектесті, солай емес пе?
Dialogue: 0,0:04:14.46,0:04:17.17,Default,,0,0,0,,Иә, мен саған көмектестім.
Dialogue: 0,0:04:17.29,0:04:19.42,Default,,0,0,0,,Барлығы
Dialogue: 0,0:04:23.55,0:04:29.10,Default,,0,0,0,,Мега геккон ең биік ағаш және ол баобаб ағашынан үлкен.
Dialogue: 0,0:04:29.22,0:04:31.68,Default,,0,0,0,,Африканың барлық жануарларын жалма
Dialogue: 0,0:04:31.85,0:04:34.60,Default,,0,0,0,,Мен сенің десерт жеуге келгеніңді естідім.
Dialogue: 0,0:04:34.73,0:04:37.69,Default,,0,0,0,,Лемурды қуырыңыз
Dialogue: 0,0:04:37.81,0:04:40.57,Default,,0,0,0,,Крекермен тамақтаныңыз
Dialogue: 0,0:04:40.69,0:04:42.78,Default,,0,0,0,,Оның аты «маймыл құмы»
Dialogue: 0,0:04:42.90,0:04:47.70,Default,,0,0,0,,Жүрегімізді жеп, күшімізді сіңіру.
Dialogue: 0,0:04:48.12,0:04:50.41,Default,,0,0,0,,Бекіту рейтингін қараңыз
Dialogue: 0,0:04:48.12,0:04:50.41,Default,,0,0,0,,«Танымал график»
Dialogue: 0,0:04:50.62,0:04:52.29,Default,,0,0,0,,130%
Dialogue: 0,0:04:53.75,0:04:55.16,Default,,0,0,0,,Ең жақсысы
Dialogue: 0,0:04:55.29,0:04:59.38,Default,,0,0,0,,Әрине, өйткені мен мега гекконды өлтірдім.
Dialogue: 0,0:04:59.50,0:05:04.01,Default,,0,0,0,,Бізді геккондардан қорғаңыз.
Dialogue: 0,0:05:04.63,0:05:07.30,Default,,0,0,0,,Сабыр ет, қолың ауырып тұр.
Dialogue: 0,0:05:34.29,0:05:36.75,Default,,0,0,0,,Масикура қозғалғысы келеді, бірақ әлі емес.
Dialogue: 0,0:05:36.87,0:05:38.62,Default,,0,0,0,,Шұғыл мәселелер үшін
Dialogue: 0,0:05:39.42,0:05:41.75,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:05:41.88,0:05:43.21,Default,,0,0,0,,Бірдеңе дұрыс болмады
Dialogue: 0,0:05:43.34,0:05:48.38,Default,,0,0,0,,Мега гекконға жұмыс істейтін кесіртке тыңшысы бар дейді.
Dialogue: 0,0:05:48.51,0:05:49.93,Default,,0,0,0,,Шпион?
Dialogue: 0,0:05:50.34,0:05:53.43,Default,,0,0,0,,Барлық кесірткелер сұрақ қояды
Dialogue: 0,0:05:53.56,0:05:56.52,Default,,0,0,0,,Ел еңсесін көтерді емес пе?
Dialogue: 0,0:05:56.64,0:05:59.73,Default,,0,0,0,,Дороти жаңғақ беру акциясын бастады.
Dialogue: 0,0:05:59.85,0:06:02.36,Default,,0,0,0,,Жеңіске арналған жаңғақтар
Dialogue: 0,0:06:04.19,0:06:07.86,Default,,0,0,0,,Өйткені менің мега геккондарға аллергиям бар.
Dialogue: 0,0:06:08.07,0:06:12.41,Default,,0,0,0,,Не болды? Барлығы бірге жұмыс істейді.
Dialogue: 0,0:06:13.12,0:06:15.83,Default,,0,0,0,,Иә! Торт уақыты келді ме?
Dialogue: 0,0:06:16.41,0:06:20.33,Default,,0,0,0,,Көрдің бе, торт қауіпті, сондықтан оны ұсақтап ал.
Dialogue: 0,0:06:20.46,0:06:24.63,Default,,0,0,0,,Тортты ұсақтау ше? Бірдеңе дұрыс емес
Dialogue: 0,0:06:24.75,0:06:25.67,Default,,0,0,0,,Морис!
Dialogue: 0,0:06:26.05,0:06:30.30,Default,,0,0,0,,Сіз кездестірген мега гекко болды.
Dialogue: 0,0:06:30.43,0:06:33.35,Default,,0,0,0,,Қорыққаным сонша, шыдай алмаймын
Dialogue: 0,0:06:33.47,0:06:38.56,Default,,0,0,0,,Түнде жақсы ұйықтай алмаймын, ұйықтасам да қорқынышты түс көремін.
Dialogue: 0,0:06:40.31,0:06:44.65,Default,,0,0,0,,Түсімде мен жүгірдім, ал геккон мені қуып келді...
Dialogue: 0,0:06:46.57,0:06:48.74,Default,,0,0,0,,Морис сонда?
Dialogue: 0,0:06:48.86,0:06:52.20,Default,,0,0,0,,Амелиямен не істеп жатырсың?
Dialogue: 0,0:06:52.66,0:06:57.16,Default,,0,0,0,,Мен... мен ваннаға барамын.
Dialogue: 0,0:06:57.29,0:06:59.16,Default,,0,0,0,,Бірдеңе дұрыс емес
Dialogue: 0,0:06:59.29,0:07:01.00,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:07:01.75,0:07:04.84,Default,,0,0,0,,Менің қиындықтарымды Мористен тыңда.
Dialogue: 0,0:07:04.96,0:07:06.84,Default,,0,0,0,,Барлығы жынды болды
Dialogue: 0,0:07:06.96,0:07:09.09,Default,,0,0,0,,Тортты бүлдіруге қалай дәтің бар?
Dialogue: 0,0:07:09.30,0:07:13.68,Default,,0,0,0,,Бұл мега гекконның сыбдыры мен көрген ең жаманы.
Dialogue: 0,0:07:15.35,0:07:19.48,Default,,0,0,0,,Бірақ мойындасам, мені өтірікші деп атайды.
Dialogue: 0,0:07:21.02,0:07:24.15,Default,,0,0,0,,Қаңқа болса да, түкке тұрғысыз.
Dialogue: 0,0:07:24.27,0:07:28.48,Default,,0,0,0,,Морис маған әрқашан жақсы кеңес береді.
Dialogue: 0,0:07:28.61,0:07:30.36,Default,,0,0,0,,Мен жақсы нәрсе ойладым!
Dialogue: 0,0:07:30.49,0:07:33.07,Default,,0,0,0,,Мен, жетекші...
Dialogue: 0,0:07:33.20,0:07:36.45,Default,,0,0,0,,Олардың сезімдерін тыңдап, оларға мүмкіндік беріңіз
Dialogue: 0,0:07:36.58,0:07:40.29,Default,,0,0,0,,Барлығына өз сезімімді айтайық
Dialogue: 0,0:07:40.41,0:07:44.50,Default,,0,0,0,,Морис, осы жерде барлығымен сөйлес.
Dialogue: 0,0:07:44.63,0:07:45.88,Default,,0,0,0,,Мен не айтуым керек?
Dialogue: 0,0:07:46.00,0:07:50.09,Default,,0,0,0,,«Енді жақсы» немесе «Мен ештеңеден қорықпаймын»
Dialogue: 0,0:07:50.21,0:07:52.47,Default,,0,0,0,,Сіз өзіңізге ұнайтын нәрсені айта аласыз.
Dialogue: 0,0:07:53.84,0:07:55.22,Default,,0,0,0,,Бәріне сәлем
Dialogue: 0,0:07:55.34,0:07:58.39,Default,,0,0,0,,Біріншіден, менің сөзім.
Dialogue: 0,0:07:58.51,0:08:04.15,Default,,0,0,0,,Мені мега геккон қуып жегенін армандаймын.
Dialogue: 0,0:08:04.27,0:08:06.52,Default,,0,0,0,,Барлығы да тамақтанды.
Dialogue: 0,0:08:06.65,0:08:08.94,Default,,0,0,0,,Сіз де, Сіз де
Dialogue: 0,0:08:09.11,0:08:10.99,Default,,0,0,0,,Және Тодд!
Dialogue: 0,0:08:14.28,0:08:17.58,Default,,0,0,0,,Мористің айтқанын ұмыт.
Dialogue: 0,0:08:17.70,0:08:19.54,Default,,0,0,0,,Морис деген ұғым жоқ.
Dialogue: 0,0:08:19.83,0:08:21.00,Default,,0,0,0,,Морис деген кім?
Dialogue: 0,0:08:21.12,0:08:23.04,Default,,0,0,0,,Жақсы сұрақ.
Dialogue: 0,0:08:23.21,0:08:24.21,Default,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:08:24.33,0:08:26.54,Default,,0,0,0,,Мен сөйлеймін патша
Dialogue: 0,0:08:26.88,0:08:29.71,Default,,0,0,0,,Барлығы, қорықпа
Dialogue: 0,0:08:29.84,0:08:34.72,Default,,0,0,0,,Бір ғана нәрсе істеу керек: мега гекконды аулау.
Dialogue: 0,0:08:35.01,0:08:38.18,Default,,0,0,0,,Мен аң аулауды білмеймін
Dialogue: 0,0:08:38.30,0:08:39.72,Default,,0,0,0,,Мен аңшы емеспін.
Dialogue: 0,0:08:39.85,0:08:43.02,Default,,0,0,0,,Бұдан былай мен аңшы боламын.
Dialogue: 0,0:08:45.77,0:08:51.07,Default,,0,0,0,,Мега гекконды таба алмасақ ше?
Dialogue: 0,0:08:51.19,0:08:55.11,Default,,0,0,0,,Ұйықтамай, тамақ ішпей іздеу
Dialogue: 0,0:08:55.24,0:08:57.32,Default,,0,0,0,,Ешкіммен таныспай
Dialogue: 0,0:08:57.99,0:09:01.66,Default,,0,0,0,,Жақсы, мен де солай ойладым.
Dialogue: 0,0:09:03.41,0:09:04.25,Default,,0,0,0,,Иә
Dialogue: 0,0:09:04.37,0:09:06.04,Default,,0,0,0,,Тимо, мұны істе.
Dialogue: 0,0:09:08.75,0:09:10.55,Default,,0,0,0,,Мүмкін сіз аласыз
Dialogue: 0,0:09:10.71,0:09:13.05,Default,,0,0,0,,Сізге бірнеше сұрақ қоя аламын ба?
Dialogue: 0,0:09:13.21,0:09:15.17,Default,,0,0,0,,Не болып жатыр, Жороно? Апачай?
Dialogue: 0,0:09:15.63,0:09:18.76,Default,,0,0,0,,Баобаб ағашынан тікелей эфир
Dialogue: 0,0:09:18.89,0:09:24.98,Default,,0,0,0,,Кловер аңшылар тобымен бірге мега гекконды табуға барады.
Dialogue: 0,0:09:25.35,0:09:28.02,Default,,0,0,0,,Ұжым туралы бір ауыз сөз
Dialogue: 0,0:09:28.15,0:09:31.32,Default,,0,0,0,,Мен ең жақсы мүшелерді жинадым.
Dialogue: 0,0:09:32.98,0:09:38.74,Default,,0,0,0,,Өте аз өтініш берушілер арасында.
Dialogue: 0,0:09:40.41,0:09:41.37,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:09:41.49,0:09:45.79,Default,,0,0,0,,Жау аумағына кіріп, Mega Gecko-ны табыңыз
Dialogue: 0,0:09:45.91,0:09:48.62,Default,,0,0,0,,Аяушылықты тастаңыз.
Dialogue: 0,0:09:48.75,0:09:51.96,Default,,0,0,0,,Балаларға айта алмайтын нәрселерді жасау
Dialogue: 0,0:09:52.34,0:09:53.34,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:09:54.01,0:09:54.84,Default,,0,0,0,,Сенімсіз
Dialogue: 0,0:09:54.96,0:09:55.80,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:09:55.92,0:09:59.55,Default,,0,0,0,,Форма жоқ па? Керемет болса да
Dialogue: 0,0:10:01.51,0:10:05.27,Default,,0,0,0,,Әлі емес пе? Мен асығып тұрмын.
Dialogue: 0,0:10:06.06,0:10:11.69,Default,,0,0,0,,Неліктен сен бәрін үндемей, алып геккон жасайсың?
Dialogue: 0,0:10:12.23,0:10:14.19,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:14.32,0:10:15.19,Default,,0,0,0,,Тодд?
Dialogue: 0,0:10:15.32,0:10:17.90,Default,,0,0,0,,Қоянды жақсы көретін сүйкімді бала
Dialogue: 0,0:10:18.03,0:10:22.87,Default,,0,0,0,,Мені қонаққа шақырды, бірақ мен ауырғандықтан бара алмадым.
Dialogue: 0,0:10:24.45,0:10:27.00,Default,,0,0,0,,Жылына бір рет шомылу керек.
Dialogue: 0,0:10:27.12,0:10:28.91,Default,,0,0,0,,Өрескел нәрселер туралы айтуды доғар.
Dialogue: 0,0:10:29.04,0:10:33.88,Default,,0,0,0,,Менен басқаның шақырылғанына сене алмаймын...
Dialogue: 0,0:10:36.42,0:10:38.76,Default,,0,0,0,,Әйтеуір, менің туған күнім.
Dialogue: 0,0:10:38.88,0:10:42.89,Default,,0,0,0,,Мен Тоддты осымен таң қалдырғым келеді.
Dialogue: 0,0:10:45.89,0:10:47.10,Default,,0,0,0,,Дайын
Dialogue: 0,0:10:48.56,0:10:50.65,Default,,0,0,0,,Құлағыңызды тақпаңыз
Dialogue: 0,0:10:51.15,0:10:53.02,Default,,0,0,0,,Бірақ Тоддтың қояны бар...
Dialogue: 0,0:10:53.15,0:10:55.11,Default,,0,0,0,,Мега геккондардың құлағы жоқ.
Dialogue: 0,0:10:55.69,0:10:56.98,Default,,0,0,0,,Бұл атау.
Dialogue: 0,0:10:57.11,0:11:00.91,Default,,0,0,0,,Мен оны осылай атадым.
Dialogue: 0,0:11:20.84,0:11:21.84,Default,,0,0,0,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,0:11:21.97,0:11:25.51,Default,,0,0,0,,Зәр шығару дұрыс па? Мен өзімді кішкентай сияқты сезінемін
Dialogue: 0,0:11:31.39,0:11:34.52,Default,,0,0,0,,Кинг мұнда не үшін? Бұл қауіпті
Dialogue: 0,0:11:34.65,0:11:37.53,Default,,0,0,0,,Сіз «шошқа» аңшысыз ба?
Dialogue: 0,0:11:37.82,0:11:39.86,Default,,0,0,0,,Бұл билейтін орын.
Dialogue: 0,0:11:39.99,0:11:42.82,Default,,0,0,0,,Бұл «кезең» Ел қорғанысы дегеніміз не?
Dialogue: 0,0:11:42.95,0:11:44.28,Default,,0,0,0,,Морис осында
Dialogue: 0,0:11:46.66,0:11:48.91,Default,,0,0,0,,Айтпақшы, бағыттары әртүрлі.
Dialogue: 0,0:11:49.04,0:11:49.87,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:50.00,0:11:54.08,Default,,0,0,0,,Мен мега гекконның қайда екенін білемін.
Dialogue: 0,0:11:54.21,0:11:55.75,Default,,0,0,0,,«Бесінші сезім»
Dialogue: 0,0:12:00.88,0:12:02.55,Default,,0,0,0,,Жарайды, біз келдік.
Dialogue: 0,0:12:02.68,0:12:06.76,Default,,0,0,0,,Өзіңізді қорқынышты қарсыласқа дайындаңыз.
Dialogue: 0,0:12:07.01,0:12:09.52,Default,,0,0,0,,Кенеттен қозғалмаңыз
Dialogue: 0,0:12:09.64,0:12:12.89,Default,,0,0,0,,Тыңдаңыз, міне, мега геккон келеді.
Dialogue: 0,0:12:13.02,0:12:15.60,Default,,0,0,0,,Мен онымен айналысамын.
Dialogue: 0,0:12:15.73,0:12:17.44,Default,,0,0,0,,Міне
Dialogue: 0,0:12:17.57,0:12:20.32,Default,,0,0,0,,Король Ештеңе жоқ.
Dialogue: 0,0:12:20.48,0:12:22.65,Default,,0,0,0,,Мен саған мына жерге қой дедім.
Dialogue: 0,0:12:22.74,0:12:23.40,Default,,0,0,0,,Не?
Dialogue: 0,0:12:24.20,0:12:24.86,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:12:24.99,0:12:27.70,Default,,0,0,0,,Мен өзіммен көп сөйлесемін
Dialogue: 0,0:12:29.20,0:12:31.66,Default,,0,0,0,,Бұл іздер біртүрлі.
Dialogue: 0,0:12:31.79,0:12:33.46,Default,,0,0,0,,Шеңбер сызу
Dialogue: 0,0:12:35.12,0:12:37.63,Default,,0,0,0,,Олар артымыздан келе жатыр.
Dialogue: 0,0:12:37.75,0:12:39.88,Default,,0,0,0,,Барлығы өледі!
Dialogue: 0,0:12:40.00,0:12:41.34,Default,,0,0,0,,Бұл мені ашуландырады
Dialogue: 0,0:12:41.92,0:12:43.67,Default,,0,0,0,,Ой, шықты.
Dialogue: 0,0:12:44.09,0:12:47.09,Default,,0,0,0,,Осы сомаға құндыздар бөгет сала алады.
Dialogue: 0,0:12:49.47,0:12:53.06,Default,,0,0,0,,Тұзақ жасап, оны ұстау.
Dialogue: 0,0:12:53.18,0:12:55.14,Default,,0,0,0,,Сізге қажет нәрсе -
Dialogue: 0,0:12:55.60,0:12:56.73,Default,,0,0,0,,Тамақ
Dialogue: 0,0:12:57.06,0:12:57.86,Default,,0,0,0,,Керемет!
Dialogue: 0,0:12:58.52,0:13:00.77,Default,,0,0,0,,Мен оны жасырын түрде алдым.
Dialogue: 0,0:13:07.41,0:13:08.70,Default,,0,0,0,,Жан-Пьер Польнарефф
Dialogue: 0,0:13:08.82,0:13:09.99,Default,,0,0,0,,Тортты маған қайтарыңыз
Dialogue: 0,0:13:10.12,0:13:10.95,Default,,0,0,0,,No
Dialogue: 0,0:13:19.59,0:13:20.50,Default,,0,0,0,,Мен істедім
Dialogue: 0,0:13:28.89,0:13:30.76,Default,,0,0,0,,Қант жеткіліксіз
Dialogue: 0,0:13:33.39,0:13:34.73,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:13:34.93,0:13:36.56,Default,,0,0,0,,Лагерьге барайық
Dialogue: 0,0:13:36.69,0:13:37.35,Default,,0,0,0,,Морт
Dialogue: 0,0:13:37.85,0:13:40.27,Default,,0,0,0,,Сен қырағысың
Dialogue: 0,0:13:50.74,0:13:54.58,Default,,0,0,0,,Патша мені сүйеді Патша мені сүйеді
Dialogue: 0,0:13:54.75,0:13:58.58,Default,,0,0,0,,Патша мені сүйеді Патша мені жақсы көреді!
Dialogue: 0,0:14:01.09,0:14:02.88,Default,,0,0,0,,Өте үлкен
Dialogue: 0,0:14:04.71,0:14:05.76,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:14:08.26,0:14:13.31,Default,,0,0,0,,Аңшы «Шошқа» сөзі түсініксіз.
Dialogue: 0,0:14:14.81,0:14:16.31,Default,,0,0,0,,Морт Қайда?
Dialogue: 0,0:14:16.60,0:14:19.44,Default,,0,0,0,,Мега геккон оны алып кетті.
Dialogue: 0,0:14:19.69,0:14:23.61,Default,,0,0,0,,Ол сол жаққа кеткен сияқты.
Dialogue: 0,0:14:24.78,0:14:28.24,Default,,0,0,0,,Патшалық жолда, мен бір жерден көрінбеймін
Dialogue: 0,0:14:28.36,0:14:30.28,Default,,0,0,0,,Ол патшалықты көрсетті.
Dialogue: 0,0:14:34.99,0:14:36.04,Default,,0,0,0,,Асығу керек
Dialogue: 0,0:14:37.04,0:14:39.46,Default,,0,0,0,,Барлығы өледі!
Dialogue: 0,0:14:40.12,0:14:41.88,Default,,0,0,0,,Бізде бәрі жақсы
Dialogue: 0,0:14:50.13,0:14:51.09,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:55.43,0:14:57.81,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:15:06.23,0:15:07.03,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:15:07.15,0:15:09.36,Default,,0,0,0,,Жоқ, мен барамын.
Dialogue: 0,0:15:10.74,0:15:12.24,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:15:12.36,0:15:15.70,Default,,0,0,0,,Патшалықтың жауларын жеңемін.
Dialogue: 0,0:15:17.08,0:15:19.87,Default,,0,0,0,,Коммутатор қайда?
Dialogue: 0,0:15:20.00,0:15:22.58,Default,,0,0,0,,Ол аузындағыдай жақсы емес.
Dialogue: 0,0:15:28.30,0:15:30.22,Default,,0,0,0,,Ыстық! Тым ыстық!
Dialogue: 0,0:15:31.22,0:15:32.34,Default,,0,0,0,,Тимо!
Dialogue: 0,0:15:33.68,0:15:36.51,Default,,0,0,0,,Бұл сіз сұраған мега гекконнан өзгеше.
Dialogue: 0,0:15:38.77,0:15:42.56,Default,,0,0,0,,Бұл схема немесе код қатесі болуы мүмкін.
Dialogue: 0,0:15:42.69,0:15:44.56,Default,,0,0,0,,Мен түсінетіндей етіп сөйле
Dialogue: 0,0:15:44.69,0:15:45.69,Default,,0,0,0,,Ақаулық
Dialogue: 0,0:15:46.11,0:15:48.57,Default,,0,0,0,,Нақтырақ
Dialogue: 0,0:15:50.90,0:15:52.57,Default,,0,0,0,,Барлығы өледі
Dialogue: 0,0:15:52.70,0:15:53.45,Default,,0,0,0,,Міне
Dialogue: 0,0:15:58.54,0:16:01.62,Default,,0,0,0,,Морис, батыл бол.
Dialogue: 0,0:16:01.75,0:16:05.04,Default,,0,0,0,,Елді патша басқарады
Dialogue: 0,0:16:07.50,0:16:08.75,Default,,0,0,0,,Ханшайым, егер кездейсоқ
Dialogue: 0,0:16:09.34,0:16:12.80,Default,,0,0,0,,Мен мұны істей алатыныма сенімдімін.
Dialogue: 0,0:16:21.60,0:16:24.44,Default,,0,0,0,,Бұл менің қолымдағы жалғыз қару болды.
Dialogue: 0,0:16:24.73,0:16:27.15,Default,,0,0,0,,Жарайсың Тед.
Dialogue: 0,0:16:27.27,0:16:27.94,Default,,0,0,0,,Жаса!
Dialogue: 0,0:16:28.23,0:16:30.44,Default,,0,0,0,,Мен мұнымен өмір сүре аламын
Dialogue: 0,0:16:30.57,0:16:31.69,Default,,0,0,0,,Тағы бір ату
Dialogue: 0,0:16:31.82,0:16:33.70,Default,,0,0,0,,Түсіру
Dialogue: 0,0:16:33.82,0:16:35.91,Default,,0,0,0,,Мен нені түсіруім керек?
Dialogue: 0,0:16:36.95,0:16:38.12,Default,,0,0,0,,Өшіру
Dialogue: 0,0:16:38.24,0:16:40.49,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:16:40.62,0:16:43.29,Default,,0,0,0,,Сіз ауыстырып қостыңыз ба?
Dialogue: 0,0:16:43.41,0:16:45.21,Default,,0,0,0,,Әрине.
Dialogue: 0,0:16:45.33,0:16:46.33,Default,,0,0,0,,Сонда не?
Dialogue: 0,0:16:46.46,0:16:49.04,Default,,0,0,0,,Ажыратқыш қоянның құлағында
Dialogue: 0,0:16:49.17,0:16:50.17,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:16:52.63,0:16:53.97,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:16:54.09,0:16:56.05,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:57.22,0:16:59.22,Default,,0,0,0,,Күте тұрыңыз, оны кесудің жолы бар.
Dialogue: 0,0:16:59.64,0:17:01.10,Default,,0,0,0,,«Киіну» дегенді қалай түсінесіңдер?
Dialogue: 0,0:17:01.22,0:17:02.77,Default,,0,0,0,,Өшіруге болады
Dialogue: 0,0:17:02.89,0:17:05.23,Default,,0,0,0,,Корпустың ішінде түйме бар
Dialogue: 0,0:17:05.35,0:17:09.27,Default,,0,0,0,,Жете алмайтын жерде, салқын емес пе?
Dialogue: 0,0:17:09.40,0:17:11.65,Default,,0,0,0,,Бұл жерде қауіпті... солай ма?
Dialogue: 0,0:17:11.78,0:17:12.44,Default,,0,0,0,,Жолтайым Құдай
Dialogue: 0,0:17:14.65,0:17:16.28,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:17:16.91,0:17:17.74,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:17:17.87,0:17:24.12,Default,,0,0,0,,Кинг жасаған мега геккон жаңа ғана бақылаудан шықты.
Dialogue: 0,0:17:25.46,0:17:27.25,Default,,0,0,0,,Бір шымшып қалғанда күлемін.
Dialogue: 0,0:17:27.37,0:17:29.84,Default,,0,0,0,,Сондай-ақ ұйқыңыз келген кезде...
Dialogue: 0,0:17:29.96,0:17:32.21,Default,,0,0,0,,Король жауапты ма?
Dialogue: 0,0:17:32.34,0:17:35.13,Default,,0,0,0,,Кімнің жауапты екені маңызды емес.
Dialogue: 0,0:17:35.63,0:17:40.10,Default,,0,0,0,,Жауапкершілік туралы айтқанда, Тодд өзінің туған күнін жасырды...
Dialogue: 0,0:17:40.22,0:17:41.72,Default,,0,0,0,,Оны қалай тоқтатуға болады?
Dialogue: 0,0:17:41.85,0:17:44.85,Default,,0,0,0,,Оны өшіру үшін осы жерге енгізіңіз
Dialogue: 0,0:17:44.98,0:17:48.81,Default,,0,0,0,,...
Dialogue: 0,0:17:48.94,0:17:51.02,Default,,0,0,0,,B(B) Ipasu(U) Тақ жақты...
Dialogue: 0,0:17:51.15,0:17:52.98,Default,,0,0,0,,Өткізілмесе...
Dialogue: 0,0:17:53.11,0:17:54.90,Default,,0,0,0,,Иә, «БӨК»
Dialogue: 0,0:17:55.03,0:17:57.95,Default,,0,0,0,,Сондай-ақ анамның аты
Dialogue: 0,0:17:58.91,0:18:00.70,Default,,0,0,0,,Басқаша айтқанда, «Ошири-сан»?
Dialogue: 0,0:18:00.82,0:18:04.83,Default,,0,0,0,,Сүйікті анаңызды мазақ етесіз бе?
Dialogue: 0,0:18:05.41,0:18:07.41,Default,,0,0,0,,Жоқ, кешірім сұраймын.
Dialogue: 0,0:18:07.54,0:18:10.00,Default,,0,0,0,,Түсіндіруді жалғастырыңыз.
Dialogue: 0,0:18:10.54,0:18:11.59,Default,,0,0,0,,«Бөксе»
Dialogue: 0,0:18:12.21,0:18:17.42,Default,,0,0,0,,Оны өшіру үшін осы жерге кіріп, осы түймені басыңыз.
Dialogue: 0,0:18:17.93,0:18:23.26,Default,,0,0,0,,Бұл сіздің бөксеңізге біреу кіріп кетеді дегенді білдіре ме?
Dialogue: 0,0:18:23.39,0:18:24.14,Default,,0,0,0,,Иә
Dialogue: 0,0:18:24.26,0:18:25.68,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:18:25.81,0:18:28.77,Default,,0,0,0,,Жоқ, мен барамын.
Dialogue: 0,0:18:29.94,0:18:32.77,Default,,0,0,0,,Бұлай айтқаныңызға рахмет.
Dialogue: 0,0:18:32.90,0:18:34.19,Default,,0,0,0,,Жаңалықтар
Dialogue: 0,0:18:34.32,0:18:40.11,Default,,0,0,0,,Беде мега геккон ішінде елді құтқарады
Dialogue: 0,0:18:40.24,0:18:44.16,Default,,0,0,0,,Өлгелі тұрғанда қандай сезім бар?
Dialogue: 0,0:18:44.28,0:18:47.54,Default,,0,0,0,,Сондай-ақ, сіз қандай маркалы киім киесіз?
Dialogue: 0,0:18:59.97,0:19:01.30,Default,,0,0,0,,Менің құйрығым қатты
Dialogue: 0,0:19:02.05,0:19:03.35,Default,,0,0,0,,Менің құйрығым қатты.
Dialogue: 0,0:19:08.64,0:19:11.85,Default,,0,0,0,,Батутты орнату Жұмысқа дайын
Dialogue: 0,0:19:19.07,0:19:21.78,Default,,0,0,0,,Эй, мынау!
Dialogue: 0,0:19:25.24,0:19:26.58,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:19:28.41,0:19:32.42,Default,,0,0,0,,Мен сенің айқайлап қашатыныңды білдім.
Dialogue: 0,0:19:40.88,0:19:42.18,Default,,0,0,0,,Сіз қайда бардыңыз?
Dialogue: 0,0:19:43.80,0:19:45.30,Default,,0,0,0,,Қайда?
Dialogue: 0,0:19:48.52,0:19:50.10,Default,,0,0,0,,Ақылды бала.
Dialogue: 0,0:19:54.15,0:19:55.31,Default,,0,0,0,,Беде!
Dialogue: 0,0:19:59.82,0:20:01.82,Default,,0,0,0,,Тимо да!
Dialogue: 0,0:20:01.95,0:20:04.36,Default,,0,0,0,,Маған жамбасқа көмек керек.
Dialogue: 0,0:20:07.62,0:20:08.62,Default,,0,0,0,,Морис
Dialogue: 0,0:20:08.79,0:20:13.87,Default,,0,0,0,,Аспан маған көмектесші, мен өзім баруым керек деп ойлаймын.
Dialogue: 0,0:20:14.37,0:20:16.79,Default,,0,0,0,,Неліктен таблеткадағы қателік поза?
Dialogue: 0,0:20:16.92,0:20:18.67,Default,,0,0,0,,Мен қозғалуға қатты қорқамын
Dialogue: 0,0:20:18.80,0:20:20.59,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:20:20.71,0:20:24.84,Default,,0,0,0,,Гекконның бөксесін енгіз Менің маңызды миссиям бар.
Dialogue: 0,0:20:24.97,0:20:28.35,Default,,0,0,0,,Кешіріңіз, бірақ мен шынымен қозғала алмаймын.
Dialogue: 0,0:20:29.51,0:20:31.31,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ
Dialogue: 0,0:20:46.70,0:20:48.08,Default,,0,0,0,,Мен кіремін.
Dialogue: 0,0:20:48.20,0:20:49.53,Default,,0,0,0,,Жоқ, күте тұрыңыз.
Dialogue: 0,0:20:49.83,0:20:51.62,Default,,0,0,0,,Ұсталды
Dialogue: 0,0:20:54.25,0:20:57.00,Default,,0,0,0,,Бұл соңы ма?
Dialogue: 0,0:20:59.17,0:21:04.72,Default,,0,0,0,,Қорқынышыңызды сейілтіп, досыңызға көмектесіңіз
Dialogue: 0,0:21:04.84,0:21:06.84,Default,,0,0,0,,Ал енді патша!
Dialogue: 0,0:21:12.31,0:21:15.35,Default,,0,0,0,,Сізге рахмет, мен оны толығымен енгізе алдым.
Dialogue: 0,0:21:15.48,0:21:16.27,Default,,0,0,0,,Әрі қарай не болады?
Dialogue: 0,0:21:16.40,0:21:20.02,Default,,0,0,0,,Түймені тауып, түнгі түнді аяқтаңыз
Dialogue: 0,0:21:21.78,0:21:22.86,Default,,0,0,0,,қытық
Dialogue: 0,0:21:22.99,0:21:24.15,Default,,0,0,0,,Сәлем, сәлем.
Dialogue: 0,0:21:24.28,0:21:26.99,Default,,0,0,0,,Морис, алдымызда тұтынушы бар.
Dialogue: 0,0:21:27.11,0:21:29.83,Default,,0,0,0,,Менің дауысыма келіңіз
Dialogue: 0,0:21:29.95,0:21:32.04,Default,,0,0,0,,Түймеге жете алмайсыз ба?
Dialogue: 0,0:21:32.16,0:21:34.25,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:21:38.50,0:21:40.34,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:21:41.21,0:21:42.80,Default,,0,0,0,,Егер Хигучи екінші Кира сияқты тек қарап-ақ адам өлтіре алса, онда Кираның шын кім екені бағдарлама соңында ашылады!
Dialogue: 0,0:21:45.59,0:21:47.93,Default,,0,0,0,,Қаруды ұстаңыз
Dialogue: 0,0:21:54.56,0:21:57.35,Default,,0,0,0,,Барлығы тірі!
Dialogue: 0,0:22:01.44,0:22:04.19,Default,,0,0,0,,〝Тодд, құттықтаймын. Өтірік айтқаным үшін кешіріңіз.〞
Dialogue: 0,0:22:10.99,0:22:13.12,Default,,0,0,0,,Ақырында бұл кеш
Dialogue: 0,0:22:14.75,0:22:17.37,Default,,0,0,0,,Рахмет айтайын
Dialogue: 0,0:22:17.50,0:22:21.38,Default,,0,0,0,,Гекконның бөксесіне ілініп өліп қала жаздадым.
Dialogue: 0,0:22:21.63,0:22:24.17,Default,,0,0,0,,Бұл өте батыл болды.
Dialogue: 0,0:22:24.30,0:22:25.80,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:25.92,0:22:28.43,Default,,0,0,0,,Құбыжықтың кеткеніне қуаныштымын.
Dialogue: 0,0:23:05.96,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Акико Комори
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
