Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:46.71,0:00:51.30,Default,,0,0,0,,Ол әйгілі король Юлиан XIII
Dialogue: 0,0:00:51.42,0:00:53.80,Default,,0,0,0,,Фоссаны жеңу...
Dialogue: 0,0:00:53.92,0:00:55.34,Default,,0,0,0,,Сіз де осыны айтасыз ба?
Dialogue: 0,0:00:55.63,0:00:57.55,Default,,0,0,0,,Әрине
Dialogue: 0,0:00:58.22,0:01:04.06,Default,,0,0,0,,Маған еркін би мен еркін махаббатты үйретші......
Dialogue: 0,0:01:04.18,0:01:05.69,Default,,0,0,0,,Патша осында!
Dialogue: 0,0:01:06.98,0:01:10.61,Default,,0,0,0,,Бұл «сексуалды» Өткізу орнында ауытқулар жоқ
Dialogue: 0,0:01:10.73,0:01:13.11,Default,,0,0,0,,Сахна жанында қарау
Dialogue: 0,0:01:13.23,0:01:14.65,Default,,0,0,0,,Сіз кіммен сөйлесіп тұрсыз?
Dialogue: 0,0:01:14.78,0:01:15.65,Default,,0,0,0,,Бұл құпия
Dialogue: 0,0:01:15.78,0:01:17.41,Default,,0,0,0,,Сымсыз байланыс болмаса да...
Dialogue: 0,0:01:17.53,0:01:21.41,Default,,0,0,0,,Жолдағы адамды ұстап алып, алып кетті
Dialogue: 0,0:01:29.29,0:01:30.96,Default,,0,0,0,,Керемет қошемет!
Dialogue: 0,0:01:31.09,0:01:34.38,Default,,0,0,0,,Менің арманым бүкіл халық сүйетін патша болу еді.
Dialogue: 0,0:01:34.71,0:01:36.88,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:01:37.01,0:01:38.84,Default,,0,0,0,,үшінңызға рахмет
Dialogue: 0,0:01:38.97,0:01:43.10,Default,,0,0,0,,Патша ретінде елдің қауіпсіздігін қорғау.
Dialogue: 0,0:01:43.22,0:01:45.31,Default,,0,0,0,,Әскери-теңіз флотын құру туралы шешім қабылдады
Dialogue: 0,0:01:45.43,0:01:47.77,Default,,0,0,0,,Маған соғыс кемесін көрсетіңіз
Dialogue: 0,0:01:49.65,0:01:52.15,Default,,0,0,0,,Оның аты «Жауынгерлік кеме дәретханасы»
Dialogue: 0,0:01:52.27,0:01:56.65,Default,,0,0,0,,Нәзік қызға ұқсайды.
Dialogue: 0,0:01:58.20,0:02:00.57,Default,,0,0,0,,Патша мен сені сүйемін!
Dialogue: 0,0:02:03.03,0:02:06.16,Default,,0,0,0,,«Жауынгерлік кеме дәретханасының» аяқталуын тойлау…
Dialogue: 0,0:02:15.17,0:02:18.93,Default,,0,0,0,,Ал беделді капитан болып сайланған адам...
Dialogue: 0,0:02:19.05,0:02:20.51,Default,,0,0,0,,Бұл Вилли.
Dialogue: 0,0:02:23.56,0:02:25.18,Default,,0,0,0,,Тез мініп жүр
Dialogue: 0,0:02:25.47,0:02:27.73,Default,,0,0,0,,Мен батып кете ме деп қорқамын.
Dialogue: 0,0:02:28.23,0:02:29.73,Default,,0,0,0,,Қалағаныңызша
Dialogue: 0,0:02:33.15,0:02:35.69,Default,,0,0,0,,Бұл жақсы, бірақ...
Dialogue: 0,0:02:43.83,0:02:48.37,Default,,0,0,0,,Патша болу оңай. Неге бәрің де бір болмайсыңдар?
Dialogue: 0,0:02:48.50,0:02:52.29,Default,,0,0,0,,Бірақ патшаға үлкен жауапкершілік жүктеледі.
Dialogue: 0,0:02:52.92,0:02:56.30,Default,,0,0,0,,Жауапкершілік? Бұл күлкілі Морис
Dialogue: 0,0:02:58.21,0:03:00.34,Default,,0,0,0,,Бұл рас, қызық!
Dialogue: 0,0:03:00.47,0:03:01.30,Default,,0,0,0,,Не?
Dialogue: 0,0:03:01.43,0:03:04.72,Default,,0,0,0,,Сіз соңғы жаңалықтарды білуіңіз керек
Dialogue: 0,0:03:04.85,0:03:06.35,Default,,0,0,0,,Жаңалықтар?
Dialogue: 0,0:03:09.43,0:03:13.56,Default,,0,0,0,,Сәлеметсіз бе, Джиги сізге жаңалық әкелу үшін келді.
Dialogue: 0,0:03:13.98,0:03:16.52,Default,,0,0,0,,Жақында жауған жаңбырмен...
Dialogue: 0,0:03:16.65,0:03:20.07,Default,,0,0,0,,Биыл мангоның мол өнімі болады.
Dialogue: 0,0:03:20.19,0:03:21.74,Default,,0,0,0,,Басқалары бар ма?
Dialogue: 0,0:03:21.86,0:03:23.62,Default,,0,0,0,,Одан әрі өсек айту
Dialogue: 0,0:03:23.74,0:03:24.74,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:03:24.87,0:03:29.25,Default,,0,0,0,,Панчо жұмбақ әйелмен кездесіп жатыр деген.
Dialogue: 0,0:03:29.37,0:03:30.41,Default,,0,0,0,,Жалынды махаббат?
Dialogue: 0,0:03:30.54,0:03:32.79,Default,,0,0,0,,Панчо да жасамаңыз.
Dialogue: 0,0:03:32.92,0:03:33.92,Default,,0,0,0,,Саясатта -
Dialogue: 0,0:03:34.04,0:03:37.80,Default,,0,0,0,,Король Джулиеннің танымалдылығы күрт өсті
Dialogue: 0,0:03:37.92,0:03:41.30,Default,,0,0,0,,Кенеттен көтерілу шынымен таң қалдырады.
Dialogue: 0,0:03:41.42,0:03:44.47,Default,,0,0,0,,Мен де сені жақсы көремін және солай боламын...
Dialogue: 0,0:03:46.76,0:03:51.68,Default,,0,0,0,,Сауалнама бойынша халықтың 99%-ы Кингті қолдаған.
Dialogue: 0,0:03:53.44,0:03:56.44,Default,,0,0,0,,Бұл таңқаларлық, 99%.
Dialogue: 0,0:03:56.56,0:03:58.23,Default,,0,0,0,,Жоғары бес!
Dialogue: 0,0:03:58.36,0:04:00.61,Default,,0,0,0,,Келіңіздер, назардан тыс қалдырмаңыз.
Dialogue: 0,0:04:00.74,0:04:02.28,Default,,0,0,0,,Теледидарды өшіріңіз
Dialogue: 0,0:04:02.40,0:04:04.16,Default,,0,0,0,,Бұл сізді мазалады ма?
Dialogue: 0,0:04:04.53,0:04:06.12,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:07.24,0:04:09.08,Default,,0,0,0,,Мористі түсінбейсің бе?
Dialogue: 0,0:04:09.20,0:04:13.33,Default,,0,0,0,,Бұл мінсіз емес, тіпті 1% жеткіліксіз.
Dialogue: 0,0:04:13.46,0:04:16.79,Default,,0,0,0,,Бұл 99%, сондықтан ол тамаша дерлік.
Dialogue: 0,0:04:16.92,0:04:20.51,Default,,0,0,0,,Бұл дұрыс емес. Сол сөздер...
Dialogue: 0,0:04:20.63,0:04:23.80,Default,,0,0,0,,Бұл жай ғана жайлылық
Dialogue: 0,0:04:23.93,0:04:25.59,Default,,0,0,0,,Халыққа ұнамаған
Dialogue: 0,0:04:25.72,0:04:29.26,Default,,0,0,0,,Бір ғана адам. Бір ғана адам бар.
Dialogue: 0,0:04:29.39,0:04:32.81,Default,,0,0,0,,Қараңызшы, басқа адамдар мені ұнатады.
Dialogue: 0,0:04:32.93,0:04:35.48,Default,,0,0,0,,Неліктен Кингті қолдамасқа?
Dialogue: 0,0:04:35.60,0:04:37.19,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:04:37.31,0:04:42.07,Default,,0,0,0,,Корольді қолдау үшін барлығын қорқытыңыз
Dialogue: 0,0:04:42.82,0:04:44.20,Default,,0,0,0,,(Норияки) Ах! (Джозеф) Хмм?
Dialogue: 0,0:04:44.32,0:04:47.45,Default,,0,0,0,,Сіз мұны істей аласыз, бірақ солай емес пе?
Dialogue: 0,0:04:47.57,0:04:49.99,Default,,0,0,0,,Бір ғана адам емес пе?
Dialogue: 0,0:04:50.12,0:04:52.54,Default,,0,0,0,,Уақыты келгенде қолдау көрсетіледі
Dialogue: 0,0:04:52.66,0:04:55.87,Default,,0,0,0,,Біреуі достарының санын көбейтсе ше?
Dialogue: 0,0:04:56.00,0:04:57.71,Default,,0,0,0,,Көтеріліс орын алады
Dialogue: 0,0:04:57.92,0:05:01.09,Default,,0,0,0,,Олардың ашуының азу тістерін елестетіңіз
Dialogue: 0,0:05:01.21,0:05:03.38,Default,,0,0,0,,Біз өртті қазір сөндіруіміз керек!
Dialogue: 0,0:05:04.01,0:05:06.63,Default,,0,0,0,,Ол есінен танып қалды. Сіз жарақат алдыңыз ба?
Dialogue: 0,0:05:07.01,0:05:13.35,Default,,0,0,0,,Бір адамды уайымдаудың орнына, неге қазір бар нәрсеге назар аудармасқа?
Dialogue: 0,0:05:13.47,0:05:17.10,Default,,0,0,0,,Тамаша патшалықта ас көп...
Dialogue: 0,0:05:17.23,0:05:18.02,Default,,0,0,0,,Мен де!
Dialogue: 0,0:05:18.69,0:05:21.27,Default,,0,0,0,,Мен жеткілікті бата алдым
Dialogue: 0,0:05:21.40,0:05:23.53,Default,,0,0,0,,Соғыс кемелері де бар.
Dialogue: 0,0:05:24.15,0:05:25.45,Default,,0,0,0,,Ол батып бара жатыр!
Dialogue: 0,0:05:25.57,0:05:27.49,Default,,0,0,0,,Уау, бұл акула екен.
Dialogue: 0,0:05:27.61,0:05:30.91,Default,,0,0,0,,Оның да айырмашылығы жоқ, бұл дельфин болатын.
Dialogue: 0,0:05:32.08,0:05:34.08,Default,,0,0,0,,Бұл жауыз дельфин!
Dialogue: 0,0:05:35.16,0:05:39.63,Default,,0,0,0,,Бұл менің өмірімдегі ең жаман оқиға.
Dialogue: 0,0:05:39.71,0:05:43.25,Default,,0,0,0,,Әй, сен отбасыңды жей алдың ба?
Dialogue: 0,0:05:44.92,0:05:49.22,Default,,0,0,0,,Джиги, отбасы фермаға барды.
Dialogue: 0,0:05:52.14,0:05:55.56,Default,,0,0,0,,Мен осындай нәрсені жасауға тырыстым
Dialogue: 0,0:05:55.68,0:05:59.73,Default,,0,0,0,,Кумкват шашлығы? бұл не
Dialogue: 0,0:05:59.85,0:06:04.23,Default,,0,0,0,,Патшалықтың қазіргі күйі кумкаттармен көрсетілген.
Dialogue: 0,0:06:04.36,0:06:05.61,Default,,0,0,0,,Шашлык - бұл патшалық-
Dialogue: 0,0:06:05.74,0:06:09.16,Default,,0,0,0,,Асылған құмық – тірек
Dialogue: 0,0:06:09.28,0:06:11.66,Default,,0,0,0,,Қараңызшы, шыңға дейін
Dialogue: 0,0:06:11.91,0:06:15.16,Default,,0,0,0,,Жоқ, мені біреу жек көреді.
Dialogue: 0,0:06:15.29,0:06:19.42,Default,,0,0,0,,Мені жек көретін бұл жігіт кім?
Dialogue: 0,0:06:19.71,0:06:24.88,Default,,0,0,0,,Жақсы журналистің алдында, жақсы досым, солай ма?
Dialogue: 0,0:06:25.00,0:06:27.51,Default,,0,0,0,,Біз бір-бірімізді бұрыннан танимыз.
Dialogue: 0,0:06:27.63,0:06:31.97,Default,,0,0,0,,Олай болса мені тыңда.
Dialogue: 0,0:06:32.10,0:06:35.81,Default,,0,0,0,,Оқиғаның қайдан шыққанын айта алмаймын.
Dialogue: 0,0:06:35.93,0:06:39.73,Default,,0,0,0,,Сеніміңізді жоғалтсаңыз, сіз ақпарат алмайсыз.
Dialogue: 0,0:06:39.85,0:06:43.73,Default,,0,0,0,,Дұрыс, оған алаңдау ақымақтық.
Dialogue: 0,0:06:43.86,0:06:46.57,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:06:48.24,0:06:48.90,Default,,0,0,0,,Масикура!
Dialogue: 0,0:06:48.99,0:06:50.45,Default,,0,0,0,,Иә патша
Dialogue: 0,0:06:50.57,0:06:54.20,Default,,0,0,0,,Сиқырлы тіліңмен Джиджидің ойын оқы
Dialogue: 0,0:06:54.58,0:06:57.95,Default,,0,0,0,,Мен алмаймын, себебі бұл моральдық тұрғыдан проблемалық...
Dialogue: 0,0:07:05.09,0:07:06.92,Default,,0,0,0,,Қорқынышты Мені жіберіңіз!
Dialogue: 0,0:07:10.09,0:07:13.30,Default,,0,0,0,,Jelly Funnel Әйелдер аяқ киімі?
Dialogue: 0,0:07:13.43,0:07:14.80,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:14.93,0:07:16.56,Default,,0,0,0,,Бұл көктемгі демалыс кеші.
Dialogue: 0,0:07:25.06,0:07:28.07,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:07:28.19,0:07:31.61,Default,,0,0,0,,Кешіріңіз, кездескенше.
Dialogue: 0,0:07:32.57,0:07:35.20,Default,,0,0,0,,Әзірге қауіпсіз
Dialogue: 0,0:07:35.32,0:07:36.78,Default,,0,0,0,,Шағын әңгіме
Dialogue: 0,0:07:37.87,0:07:42.79,Default,,0,0,0,,Менің ойымша, патшалыққа қауіп төніп тұр.
Dialogue: 0,0:07:42.92,0:07:45.25,Default,,0,0,0,,Жарайды, бір ғана адам бар.
Dialogue: 0,0:07:45.38,0:07:48.30,Default,,0,0,0,,Жасырын кездесулерді бұзбаңыз
Dialogue: 0,0:07:48.42,0:07:51.13,Default,,0,0,0,,Құпия? Мен оны толығымен естимін
Dialogue: 0,0:07:51.30,0:07:53.22,Default,,0,0,0,,Бәрібір кейін сұраймын.
Dialogue: 0,0:07:53.34,0:07:55.93,Default,,0,0,0,,Дұрыс, мен жеңіл сөйлейтінмін.
Dialogue: 0,0:07:56.05,0:07:59.06,Default,,0,0,0,,Бір шіріген манго...
Dialogue: 0,0:07:59.18,0:08:02.35,Default,,0,0,0,,Бәрі шіріп кетсін
Dialogue: 0,0:08:02.48,0:08:03.56,Default,,0,0,0,,Манго шашырауы
Dialogue: 0,0:08:03.69,0:08:09.40,Default,,0,0,0,,Жақында сізді бүлікшілер қоршап алады, бірақ сәттілікке ие боласыз.
Dialogue: 0,0:08:09.53,0:08:12.07,Default,,0,0,0,,Сонымен, жаман нәрсе неде?
Dialogue: 0,0:08:12.20,0:08:15.16,Default,,0,0,0,,Білмегенің жақсы
Dialogue: 0,0:08:15.28,0:08:18.66,Default,,0,0,0,,Мен әрбір азаматқа сұрақ қоямын.
Dialogue: 0,0:08:18.78,0:08:21.12,Default,,0,0,0,,үшін үрейленеді
Dialogue: 0,0:08:21.25,0:08:22.83,Default,,0,0,0,,Сәлем, патша
Dialogue: 0,0:08:23.21,0:08:26.21,Default,,0,0,0,,«Мен қайсысын таңдауым керек?»
Dialogue: 0,0:08:27.34,0:08:29.09,Default,,0,0,0,,Иә... жоқ.
Dialogue: 0,0:08:29.21,0:08:32.67,Default,,0,0,0,,Бірақ мен Кловермен келісемін.
Dialogue: 0,0:08:32.84,0:08:36.22,Default,,0,0,0,,Сатқынды табыңыз
Dialogue: 0,0:08:36.34,0:08:37.22,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:08:37.85,0:08:39.68,Default,,0,0,0,,Көтеріліске алаңдайсыз ба?
Dialogue: 0,0:08:39.81,0:08:41.31,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:08:41.43,0:08:44.56,Default,,0,0,0,,Мен жаңа ғана патша болдым, өлгім келмейді.
Dialogue: 0,0:08:44.69,0:08:49.40,Default,,0,0,0,,Біраз адамдарды жинап, пікірлерін тыңдайық.
Dialogue: 0,0:08:49.69,0:08:53.15,Default,,0,0,0,,Бұл өте жақсы идея.
Dialogue: 0,0:08:53.28,0:08:54.86,Default,,0,0,0,,Жасырын болуы керек
Dialogue: 0,0:08:54.99,0:08:56.66,Default,,0,0,0,,Бұл сіз іздеп жүрген нәрсе ме?
Dialogue: 0,0:08:56.78,0:08:58.62,Default,,0,0,0,,Хаа, міне
Dialogue: 0,0:08:59.37,0:09:01.37,Default,,0,0,0,,Сол бетті таққандықтан бәрін жеп қойды.
Dialogue: 0,0:09:01.49,0:09:05.96,Default,,0,0,0,,Патшалық туралы түзеткіңіз келетін нәрсе бар ма?
Dialogue: 0,0:09:06.42,0:09:07.08,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:07.42,0:09:11.00,Default,,0,0,0,,Иә, сұрасаңыз...
Dialogue: 0,0:09:11.13,0:09:11.80,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:09:11.92,0:09:13.46,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:13.59,0:09:17.13,Default,,0,0,0,,Жаңа патшаға ризасың ба?
Dialogue: 0,0:09:18.64,0:09:21.76,Default,,0,0,0,,Бұрынғы патшаларға қарағанда жақсы
Dialogue: 0,0:09:22.06,0:09:25.14,Default,,0,0,0,,Сонымен Гектор да «қанағаттанды».
Dialogue: 0,0:09:30.40,0:09:32.15,Default,,0,0,0,,Жоқ, солай.
Dialogue: 0,0:09:32.53,0:09:36.07,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым, жол толып кетті.
Dialogue: 0,0:09:36.20,0:09:37.36,Default,,0,0,0,,Тақырып қандай?
Dialogue: 0,0:09:37.49,0:09:40.07,Default,,0,0,0,,Кинг туралы жақсы көретін нәрсе?
Dialogue: 0,0:09:40.20,0:09:42.74,Default,,0,0,0,,Маған бір-бірден айтып бер.
Dialogue: 0,0:09:43.04,0:09:44.62,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:09:45.00,0:09:50.17,Default,,0,0,0,,Бұл анық. Бұл король Джулиен.
Dialogue: 0,0:09:50.42,0:09:54.88,Default,,0,0,0,,Не? Мен патша болсам ше?
Dialogue: 0,0:09:55.01,0:09:59.18,Default,,0,0,0,,Мен жай ғана лемурмын. Менің атым...
Dialogue: 0,0:09:59.30,0:10:03.10,Default,,0,0,0,,Орындық, маймыл, үстел.
Dialogue: 0,0:10:03.22,0:10:05.27,Default,,0,0,0,,Бұл бос сөз. Мен үйге бара жатырмын.
Dialogue: 0,0:10:05.73,0:10:10.02,Default,,0,0,0,,Тоқта, сөйлескің келмей ме?
Dialogue: 0,0:10:11.02,0:10:12.61,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:10:13.73,0:10:15.07,Default,,0,0,0,,Бұл жасанды сақал
Dialogue: 0,0:10:15.19,0:10:17.86,Default,,0,0,0,,Әй, бұл тосын сый.
Dialogue: 0,0:10:17.99,0:10:20.11,Default,,0,0,0,,Жақсы өтті.
Dialogue: 0,0:10:20.24,0:10:22.41,Default,,0,0,0,,Мен ештеңе ести алмадым
Dialogue: 0,0:10:22.53,0:10:24.12,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:10:24.24,0:10:27.37,Default,,0,0,0,,Бұл 1% тапқан Гектор.
Dialogue: 0,0:10:28.46,0:10:31.25,Default,,0,0,0,,Әр нәрсеге шағымданады
Dialogue: 0,0:10:31.38,0:10:35.59,Default,,0,0,0,,Тек оның ойын өзгертіңіз.
Dialogue: 0,0:10:35.71,0:10:37.21,Default,,0,0,0,,Жеңіс оңай болатынына сенімдімін
Dialogue: 0,0:10:44.85,0:10:46.89,Default,,0,0,0,,Шындық дәл сіздің алдыңызда
Dialogue: 0,0:10:47.02,0:10:51.27,Default,,0,0,0,,Қарашы, мен сені өкіндіремін.
Dialogue: 0,0:10:53.23,0:10:53.90,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:56.36,0:10:58.69,Default,,0,0,0,,Бұл король Джулиен.
Dialogue: 0,0:10:58.82,0:10:59.86,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:10:59.99,0:11:02.24,Default,,0,0,0,,Сіз тез сөйлейсіз.
Dialogue: 0,0:11:02.37,0:11:05.49,Default,,0,0,0,,Мен сенімен бұрын кездескеніме қуаныштымын.
Dialogue: 0,0:11:05.62,0:11:07.79,Default,,0,0,0,,Тағы кездесейік...
Dialogue: 0,0:11:07.91,0:11:11.83,Default,,0,0,0,,Денсаулығыңызды және мені ұнататынымды тексеріңіз.
Dialogue: 0,0:11:11.96,0:11:13.71,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:11:13.83,0:11:17.34,Default,,0,0,0,,Гектор, бізде әзіл-оспақ бірдей.
Dialogue: 0,0:11:17.46,0:11:20.09,Default,,0,0,0,,Күлкі өмірде маңызды
Dialogue: 0,0:11:21.30,0:11:23.26,Default,,0,0,0,,Қарашы, мен тағы да күлдім.
Dialogue: 0,0:11:23.39,0:11:24.76,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:11:24.89,0:11:25.72,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:11:26.06,0:11:27.18,Default,,0,0,0,,Бұл жақсы үй.
Dialogue: 0,0:11:27.31,0:11:29.18,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:29.31,0:11:30.52,Default,,0,0,0,,Бұл өнер туындысы.
Dialogue: 0,0:11:30.64,0:11:33.31,Default,,0,0,0,,Жақында аяқтау үшін бір жыл қажет.
Dialogue: 0,0:11:33.44,0:11:35.40,Default,,0,0,0,,Есік ана жақта.
Dialogue: 0,0:11:35.52,0:11:37.53,Default,,0,0,0,,Маған көмектесейін
Dialogue: 0,0:11:37.65,0:11:40.65,Default,,0,0,0,,Өнер деген жақсы нәрсе ғой, солай емес пе?
Dialogue: 0,0:11:40.78,0:11:44.78,Default,,0,0,0,,үшін жұмысын тастап, өнермен айналысса...
Dialogue: 0,0:11:44.91,0:11:46.70,Default,,0,0,0,,Әлем жақсарады
Dialogue: 0,0:11:55.67,0:12:00.09,Default,,0,0,0,,Оның денесін сиқыршы емдейді, олай болса.
Dialogue: 0,0:12:05.76,0:12:06.47,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:12:07.26,0:12:08.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:17.48,0:12:19.61,Default,,0,0,0,,83% қолдау?
Dialogue: 0,0:12:19.73,0:12:23.28,Default,,0,0,0,,Неліктен төмендеді? Бұл мен қалаған нәрсеге керісінше
Dialogue: 0,0:12:23.40,0:12:27.83,Default,,0,0,0,,Гектордың барлық отбасы оны қолдауды тоқтатқан кезде.
Dialogue: 0,0:12:28.08,0:12:31.08,Default,,0,0,0,,Бірақ ол әлі де 83%.
Dialogue: 0,0:12:31.20,0:12:32.20,Default,,0,0,0,,Жоғары бес!
Dialogue: 0,0:12:33.50,0:12:35.42,Default,,0,0,0,,Бұл әлі де жақсы емес пе?
Dialogue: 0,0:12:36.83,0:12:40.34,Default,,0,0,0,,Енді 1% гектор арқылы анықталады
Dialogue: 0,0:12:40.46,0:12:45.43,Default,,0,0,0,,Көңілімізді басқа да мейірімді жандарға аударайық.
Dialogue: 0,0:12:45.55,0:12:49.81,Default,,0,0,0,,Негізінде, Гектор сауалнамаға жауап бермеді.
Dialogue: 0,0:12:49.93,0:12:53.39,Default,,0,0,0,,Ол, Широ, өзінің ата-бабаларын зерттеді.
Dialogue: 0,0:12:53.81,0:12:54.89,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:55.02,0:12:56.94,Default,,0,0,0,,Көтерілістің басталуы
Dialogue: 0,0:12:57.06,0:13:00.36,Default,,0,0,0,,Қолдаушылардың саны сонша азайды.
Dialogue: 0,0:13:00.48,0:13:03.78,Default,,0,0,0,,Бір адамның зұлым жоспарының кесірінен!
Dialogue: 0,0:13:03.90,0:13:05.82,Default,,0,0,0,,Бұл көздер қорқынышты
Dialogue: 0,0:13:05.95,0:13:10.24,Default,,0,0,0,,Зұлымдық жоспары? Мен қатты толқып тұрмын
Dialogue: 0,0:13:10.37,0:13:11.95,Default,,0,0,0,,Бұл асыра сілтеу.
Dialogue: 0,0:13:12.08,0:13:15.25,Default,,0,0,0,,Жарайды, жалғастыра бер, Кловер.
Dialogue: 0,0:13:15.41,0:13:17.17,Default,,0,0,0,,Иә, маған қалдырыңыз!
Dialogue: 0,0:13:17.29,0:13:18.42,Default,,0,0,0,,Әрқашан осылай бола ма?
Dialogue: 0,0:13:18.54,0:13:19.92,Default,,0,0,0,,Жақсырақ
Dialogue: 0,0:13:20.04,0:13:24.63,Default,,0,0,0,,Менің ойымды мазалап жүрген маңыздырақ нәрсе туралы сөйлесейік.
Dialogue: 0,0:13:24.76,0:13:27.84,Default,,0,0,0,,Қалай болғанда да, қалған 17%...
Dialogue: 0,0:13:27.97,0:13:31.10,Default,,0,0,0,,Мен олардың жағында екенімді білгім келеді.
Dialogue: 0,0:13:31.22,0:13:34.48,Default,,0,0,0,,Уақыт өте тынышталады.
Dialogue: 0,0:13:35.02,0:13:37.14,Default,,0,0,0,,Сонымен, күте тұрыңыз ба?
Dialogue: 0,0:13:37.27,0:13:39.02,Default,,0,0,0,,Маған ұнамайды, шыдай алмаймын.
Dialogue: 0,0:13:39.15,0:13:42.27,Default,,0,0,0,,Неге жақсы жақтарын атап көрсетпеске?
Dialogue: 0,0:13:42.40,0:13:43.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:43.57,0:13:47.74,Default,,0,0,0,,Тәтті маскалар, өткір билер, т.б.
Dialogue: 0,0:13:47.86,0:13:49.03,Default,,0,0,0,,Иілуге болатын бас бармақ
Dialogue: 0,0:13:49.32,0:13:50.82,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:13:51.70,0:13:53.62,Default,,0,0,0,,Сіз тым көп жасадыңыз!
Dialogue: 0,0:13:53.74,0:13:57.33,Default,,0,0,0,,Мористің жоспарында кемшіліктер болды.
Dialogue: 0,0:13:57.46,0:13:58.50,Default,,0,0,0,,Бұл сіздің идеяңыз.
Dialogue: 0,0:13:58.87,0:14:02.00,Default,,0,0,0,,Осы уақытқа дейін мен өз-өзіме тартылдым, бірақ
Dialogue: 0,0:14:02.13,0:14:05.21,Default,,0,0,0,,Маған адамдармен көбірек араласу керек.
Dialogue: 0,0:14:05.34,0:14:10.22,Default,,0,0,0,,Мен сізге шынымен үнемшіл екенімді көрсетемін.
Dialogue: 0,0:14:10.68,0:14:12.14,Default,,0,0,0,,Стокседо
Dialogue: 0,0:14:19.19,0:14:22.06,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:14:23.94,0:14:26.44,Default,,0,0,0,,Құрметті субъектілер!
Dialogue: 0,0:14:26.57,0:14:32.45,Default,,0,0,0,,Бұл патша Джулиен сәбиді сүйіп, батасын береді.
Dialogue: 0,0:14:32.58,0:14:37.87,Default,,0,0,0,,Егер сізде қандай да бір өтініштер болса, мен оларды тыңдаймын. Мен байсалдымын...
Dialogue: 0,0:14:38.91,0:14:42.21,Default,,0,0,0,,Енді кішкентай балаларды осында әкеліңдер.
Dialogue: 0,0:14:50.34,0:14:52.18,Default,,0,0,0,,Керемет табыс!
Dialogue: 0,0:14:52.30,0:14:55.85,Default,,0,0,0,,Әй, мен бата сүйген данышпанмын.
Dialogue: 0,0:14:55.97,0:14:57.22,Default,,0,0,0,,Бұл өте кішкентай
Dialogue: 0,0:14:57.35,0:14:58.18,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:58.48,0:14:59.98,Default,,0,0,0,,Барған сайын көбірек істе
Dialogue: 0,0:15:01.90,0:15:04.36,Default,,0,0,0,,Менің арманым орындалды
Dialogue: 0,0:15:05.07,0:15:07.69,Default,,0,0,0,,Кедергі жасамаңыз. Біз қолдау тауып жатырмыз.
Dialogue: 0,0:15:07.82,0:15:10.24,Default,,0,0,0,,Менің де қолдауымды алыңыз.
Dialogue: 0,0:15:11.49,0:15:14.07,Default,,0,0,0,,Маңдайыңызды ешқашан жууға болмайды!
Dialogue: 0,0:15:14.78,0:15:17.20,Default,,0,0,0,,Мен баланы тептім
Dialogue: 0,0:15:17.33,0:15:21.12,Default,,0,0,0,,Бұл сәби емес, бала ғана.
Dialogue: 0,0:15:21.25,0:15:23.17,Default,,0,0,0,,«Гаки»?
Dialogue: 0,0:15:23.29,0:15:25.84,Default,,0,0,0,,Сіз балаларды ұнатпайсыз.
Dialogue: 0,0:15:31.18,0:15:34.85,Default,,0,0,0,,Мен үйілген құмваттарды армандадым, бірақ...
Dialogue: 0,0:15:36.47,0:15:38.68,Default,,0,0,0,,Енді бұл қорқынышты түс
Dialogue: 0,0:15:39.27,0:15:41.19,Default,,0,0,0,,Мен тамақ ішуім керек пе?
Dialogue: 0,0:15:41.27,0:15:45.81,Default,,0,0,0,,Енді менің күтетін ештеңем жоқ.
Dialogue: 0,0:15:53.53,0:15:57.45,Default,,0,0,0,,Кішкентай кезімнен мені бәрі жақсы көретін.
Dialogue: 0,0:15:57.70,0:16:01.29,Default,,0,0,0,,«Қандай сүйкімді сәби».
Dialogue: 0,0:16:01.41,0:16:05.75,Default,,0,0,0,,«Менің баламмен салыстырғанда Джулиан – періште».
Dialogue: 0,0:16:05.88,0:16:11.01,Default,,0,0,0,,Бірақ енді сен менің махаббатыма жауап бермейсің.
Dialogue: 0,0:16:11.13,0:16:15.14,Default,,0,0,0,,Мен қайтадан өз-өзіммен сөйлесемін. Сіз де кіріңіз.
Dialogue: 0,0:16:18.43,0:16:22.35,Default,,0,0,0,,Шіріген манго себеп пе?
Dialogue: 0,0:16:24.48,0:16:27.82,Default,,0,0,0,,Жаман манго жоқ.
Dialogue: 0,0:16:27.94,0:16:30.61,Default,,0,0,0,,Манго – барлығының сүйікті тағамы
Dialogue: 0,0:16:31.36,0:16:32.57,Default,,0,0,0,,Не?
Dialogue: 0,0:16:32.70,0:16:35.49,Default,,0,0,0,,Халыққа манго беріңізші?
Dialogue: 0,0:16:35.61,0:16:37.41,Default,,0,0,0,,«Бұл манго».
Dialogue: 0,0:16:37.70,0:16:39.20,Default,,0,0,0,,«Банзай патша»
Dialogue: 0,0:16:39.33,0:16:40.79,Default,,0,0,0,,«Маған ұнайды»
Dialogue: 0,0:16:41.37,0:16:44.92,Default,,0,0,0,,Амелия, сен жай ғана сұлу емессің.
Dialogue: 0,0:16:45.92,0:16:48.38,Default,,0,0,0,,Мұзды ірілі-ұсақты кармин
Dialogue: 0,0:16:48.50,0:16:50.84,Default,,0,0,0,,Винни мен Юмбургер
Dialogue: 0,0:16:53.05,0:16:55.84,Default,,0,0,0,,Ойлан! шындық көз алдымда
Dialogue: 0,0:16:55.97,0:16:58.35,Default,,0,0,0,,Егер нүктелерді қоссаңыз...
Dialogue: 0,0:16:59.85,0:17:01.35,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:02.89,0:17:05.44,Default,,0,0,0,,Ұпайларыңыз жеткіліксіз екеніне сенімдімін.
Dialogue: 0,0:17:07.44,0:17:09.31,Default,,0,0,0,,Бұл жолы жақсы идея
Dialogue: 0,0:17:09.44,0:17:12.99,Default,,0,0,0,,Тек бірдеңе беріп, қолдау жинаңыз.
Dialogue: 0,0:17:13.11,0:17:13.99,Default,,0,0,0,,Бұл пара
Dialogue: 0,0:17:14.11,0:17:15.28,Default,,0,0,0,,Wiro?
Dialogue: 0,0:17:16.03,0:17:17.32,Default,,0,0,0,,Мен жындымын
Dialogue: 0,0:17:17.45,0:17:22.33,Default,,0,0,0,,Сіз Морт Вайроға манго жинадыңыз ба?
Dialogue: 0,0:17:22.62,0:17:24.16,Default,,0,0,0,,Мен жинадым
Dialogue: 0,0:17:24.29,0:17:27.54,Default,,0,0,0,,Ең тәттісін Патшаға бер.
Dialogue: 0,0:17:48.73,0:17:49.90,Default,,0,0,0,,Оянайық
Dialogue: 0,0:17:50.02,0:17:50.65,Default,,0,0,0,,Қауіпті...
Dialogue: 0,0:17:52.57,0:17:53.57,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:17:53.73,0:17:55.11,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:17:55.24,0:17:57.40,Default,,0,0,0,,Менің бүкіл денем...
Dialogue: 0,0:17:57.74,0:17:58.82,Default,,0,0,0,,Ессіз
Dialogue: 0,0:17:58.95,0:18:00.82,Default,,0,0,0,,Мен көптен бері ұйықтамадым
Dialogue: 0,0:18:00.91,0:18:04.54,Default,,0,0,0,,Бірақ мен қазір тек сүйікті тағамымның қауіптілігі туралы ойлаймын.
Dialogue: 0,0:18:05.12,0:18:06.08,Default,,0,0,0,,Оны естігіңіз келе ме?
Dialogue: 0,0:18:06.21,0:18:07.00,Default,,0,0,0,,Иә
Dialogue: 0,0:18:07.12,0:18:07.92,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:18:08.00,0:18:12.00,Default,,0,0,0,,Біріншіден, мен барлығынан күдіктендім.
Dialogue: 0,0:18:12.13,0:18:13.13,Default,,0,0,0,,Мен осындамын, Коичи.
Dialogue: 0,0:18:13.25,0:18:14.38,Default,,0,0,0,,Бұл өтірік болды
Dialogue: 0,0:18:14.51,0:18:17.63,Default,,0,0,0,,Сөздер «иә» бірақ сол көздер...
Dialogue: 0,0:18:17.76,0:18:20.68,Default,,0,0,0,,Әдетте тыныш жүретін досым...
Dialogue: 0,0:18:20.80,0:18:25.02,Default,,0,0,0,,Сосын уау, сосын уау!
Dialogue: 0,0:18:25.10,0:18:26.39,Default,,0,0,0,,Зұлымдық жоспары?
Dialogue: 0,0:18:26.48,0:18:27.52,Default,,0,0,0,,Зұлым ұйым?
Dialogue: 0,0:18:27.60,0:18:29.27,Default,,0,0,0,,Әлемді жаулап алу?
Dialogue: 0,0:18:29.35,0:18:32.61,Default,,0,0,0,,Демек, Патшаны жек көретін адам...
Dialogue: 0,0:18:33.69,0:18:34.86,Default,,0,0,0,,Бұл 1%...
Dialogue: 0,0:18:35.94,0:18:38.95,Default,,0,0,0,,Король Джульенге қарсы шыққандар...
Dialogue: 0,0:18:40.61,0:18:41.37,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:18:43.37,0:18:46.04,Default,,0,0,0,,Сізге демалу керек.
Dialogue: 0,0:18:46.16,0:18:48.87,Default,,0,0,0,,Менің басым айналады
Dialogue: 0,0:18:49.62,0:18:50.79,Default,,0,0,0,,Құстар ән айтады
Dialogue: 0,0:18:50.87,0:18:53.46,Default,,0,0,0,,Оны қазірдің өзінде тоқтатайық
Dialogue: 0,0:18:53.59,0:18:55.63,Default,,0,0,0,,Тағы бір қадам
Dialogue: 0,0:18:55.75,0:18:57.38,Default,,0,0,0,,Тағы бір күн
Dialogue: 0,0:18:57.51,0:18:58.84,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:18:59.09,0:18:59.80,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:19:03.30,0:19:06.97,Default,,0,0,0,,Онда мен мангоны ұрлаймын.
Dialogue: 0,0:19:20.07,0:19:21.66,Default,,0,0,0,,Патша мен сені жақсы көремін!
Dialogue: 0,0:19:24.62,0:19:26.83,Default,,0,0,0,,Мен аламын.
Dialogue: 0,0:19:27.83,0:19:30.46,Default,,0,0,0,,Ол сенуге болатын көшбасшы.
Dialogue: 0,0:19:31.42,0:19:34.46,Default,,0,0,0,,Манго жаңбыр жауып тұр. Сәлем!
Dialogue: 0,0:19:39.13,0:19:41.01,Default,,0,0,0,,Морт! Мен оны алысқа лақтырамын
Dialogue: 0,0:19:45.18,0:19:50.18,Default,,0,0,0,,Біздің осындай болғанымызға король Джулиен кінәлі.
Dialogue: 0,0:19:50.31,0:19:51.56,Default,,0,0,0,,Тиран
Dialogue: 0,0:19:51.69,0:19:53.85,Default,,0,0,0,,Құдай-ау... бұл манго.
Dialogue: 0,0:19:53.98,0:19:56.19,Default,,0,0,0,,Король - ең жақсы!
Dialogue: 0,0:19:56.32,0:19:57.52,Default,,0,0,0,,Джулиан!
Dialogue: 0,0:19:57.65,0:20:01.32,Default,,0,0,0,,Сіз қалай ойлайсыз? Маған бәрібір ұнады
Dialogue: 0,0:20:01.45,0:20:05.53,Default,,0,0,0,,Кешіріңіз, бізде манго таусылды.
Dialogue: 0,0:20:06.74,0:20:09.41,Default,,0,0,0,,Осыншама беру жеткілікті
Dialogue: 0,0:20:09.54,0:20:11.96,Default,,0,0,0,,Көбірек манго!
Dialogue: 0,0:20:12.37,0:20:15.38,Default,,0,0,0,,Маған көбірек манго беріңізші
Dialogue: 0,0:20:15.50,0:20:16.84,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:20:16.96,0:20:20.01,Default,,0,0,0,,Сабыр ет, бәріне беремін.
Dialogue: 0,0:20:20.13,0:20:21.38,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:20:21.51,0:20:24.05,Default,,0,0,0,,Қараңыз! Бұл уақытты үнемдеу
Dialogue: 0,0:20:25.84,0:20:29.22,Default,,0,0,0,,Салмақ бұтақты сындыруы мүмкін.
Dialogue: 0,0:20:29.31,0:20:31.10,Default,,0,0,0,,Сіз тым көп уайымдайсыз
Dialogue: 0,0:20:32.89,0:20:34.73,Default,,0,0,0,,Бұл қауіпті болуы мүмкін
Dialogue: 0,0:20:34.85,0:20:37.15,Default,,0,0,0,,үшінң артқа тұрыңдар.
Dialogue: 0,0:21:02.80,0:21:06.64,Default,,0,0,0,,Қараңдар, мен мангоны сақтап қалдым.
Dialogue: 0,0:21:06.76,0:21:09.39,Default,,0,0,0,,Баланы құтқармадыңыз ба?
Dialogue: 0,0:21:09.51,0:21:13.43,Default,,0,0,0,,Ақымақ болма, сәбилерді жеуге болмайды.
Dialogue: 0,0:21:14.60,0:21:17.52,Default,,0,0,0,,Иә, мені көбірек жақсы көр!
Dialogue: 0,0:21:17.65,0:21:21.57,Default,,0,0,0,,Мен бұл мангоны сақтап қалдым.
Dialogue: 0,0:21:21.69,0:21:23.61,Default,,0,0,0,,Бала да.
Dialogue: 0,0:21:28.53,0:21:31.41,Default,,0,0,0,,Қолдаушы оралды
Dialogue: 0,0:21:32.16,0:21:34.58,Default,,0,0,0,,Мен маңызды нәрсені білдім
Dialogue: 0,0:21:34.71,0:21:37.96,Default,,0,0,0,,«Жақын адамдардың пікірі маңызды»?
Dialogue: 0,0:21:38.54,0:21:41.30,Default,,0,0,0,,Мен не білдім...
Dialogue: 0,0:21:41.42,0:21:45.38,Default,,0,0,0,,«Қиындыққа тап болсаңыз, баланы құтқарыңыз».
Dialogue: 0,0:21:45.84,0:21:47.47,Default,,0,0,0,,Бірақ сіз де дұрыссыз.
Dialogue: 0,0:21:47.59,0:21:51.51,Default,,0,0,0,,Мені ұнатпайтын адам болса жақсы.
Dialogue: 0,0:21:51.64,0:21:55.85,Default,,0,0,0,,Мен ол жігітті де ұнатпаймын.
Dialogue: 0,0:21:57.48,0:21:59.52,Default,,0,0,0,,Сіз бас тартасыз ба?
Dialogue: 0,0:21:59.65,0:22:01.15,Default,,0,0,0,,Қылмыскерді табу туралы не айтасыз?
Dialogue: 0,0:22:01.27,0:22:03.69,Default,,0,0,0,,Бір адам сені жек көрсе...
Dialogue: 0,0:22:03.82,0:22:06.53,Default,,0,0,0,,Өзіңізді екі рет жақсы көріңіз
Dialogue: 0,0:22:06.82,0:22:08.82,Default,,0,0,0,,Оны кестеңізге жазыңыз
Dialogue: 0,0:22:08.95,0:22:09.99,Default,,0,0,0,,Бірақ кінәлі...
Dialogue: 0,0:22:10.12,0:22:13.99,Default,,0,0,0,,Маған енді оның кім екені маңызды емес
Dialogue: 0,0:22:19.33,0:22:20.63,Default,,0,0,0,,Морт
Dialogue: 0,0:22:20.75,0:22:22.13,Default,,0,0,0,,Бо... Мен?
Dialogue: 0,0:22:22.25,0:22:25.26,Default,,0,0,0,,Менің есептеуім бойынша, кінәлі сізсіз.
Dialogue: 0,0:22:25.38,0:22:29.30,Default,,0,0,0,,Мен өз басыма сене алмадым
Dialogue: 0,0:22:29.43,0:22:30.47,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:22:30.59,0:22:33.35,Default,,0,0,0,,Неге ұнамады деп айттыңыз?
Dialogue: 0,0:22:33.47,0:22:35.85,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:22:36.10,0:22:38.19,Default,,0,0,0,,Мен сені қатты жақсы көремін
Dialogue: 0,0:23:06.80,0:23:08.80,Default,,0,0,0,,Жапон субтитрлері Akira Horiike
Dialogue: 0,0:23:10.30,0:23:16.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
