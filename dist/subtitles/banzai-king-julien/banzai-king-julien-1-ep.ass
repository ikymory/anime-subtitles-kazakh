Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:41.75,0:00:45.21,Default,,0,0,0,,Сәлем, бұл король Джулиен.
Dialogue: 0,0:00:48.21,0:00:50.46,Default,,0,0,0,,Мен билегім келеді
Dialogue: 0,0:00:51.88,0:00:54.05,Default,,0,0,0,,Дыбыс бойынша
Dialogue: 0,0:00:55.22,0:00:57.51,Default,,0,0,0,,Мен билегім келеді
Dialogue: 0,0:01:02.18,0:01:04.68,Default,,0,0,0,,Мен көңіл көтергім келеді
Dialogue: 0,0:01:05.02,0:01:06.85,Default,,0,0,0,,Көру уақыты
Dialogue: 0,0:01:07.19,0:01:08.73,Default,,0,0,0,,үшін қалай?
Dialogue: 0,0:01:08.86,0:01:12.82,Default,,0,0,0,,Иә, мен Джулиен корольмін.
Dialogue: 0,0:01:12.94,0:01:15.53,Default,,0,0,0,,Бұл Морис, сәлем.
Dialogue: 0,0:01:16.07,0:01:16.95,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:01:17.07,0:01:20.99,Default,,0,0,0,,Күшті болыңыз Бұл менің кешім.
Dialogue: 0,0:01:21.12,0:01:24.29,Default,,0,0,0,,үшінның даусы естілсін
Dialogue: 0,0:01:33.59,0:01:35.63,Default,,0,0,0,,Оны елемесеңіз қауіпті.
Dialogue: 0,0:01:35.80,0:01:38.47,Default,,0,0,0,,Патша берілмейді, соғысады.
Dialogue: 0,0:02:12.92,0:02:16.34,Default,,0,0,0,,Джулиан ханзада, оян.
Dialogue: 0,0:02:16.71,0:02:18.84,Default,,0,0,0,,Ояныңыз
Dialogue: 0,0:02:18.97,0:02:21.09,Default,,0,0,0,,Корольмен кездесуге арналған кездесу
Dialogue: 0,0:02:24.81,0:02:26.31,Default,,0,0,0,,Бұл кеш!
Dialogue: 0,0:02:26.56,0:02:28.18,Default,,0,0,0,,Не? Мен шақырған жоқпын.
Dialogue: 0,0:02:28.35,0:02:30.73,Default,,0,0,0,,Партия өтірік
Dialogue: 0,0:02:30.85,0:02:33.86,Default,,0,0,0,,Сіз тағы да түс көрдіңіз.
Dialogue: 0,0:02:34.19,0:02:36.44,Default,,0,0,0,,Әй, бұл әрқашан бірдей
Dialogue: 0,0:02:36.57,0:02:40.32,Default,,0,0,0,,``Тыныш бол, әйтпесе мен сені жеймін.''
Dialogue: 0,0:02:36.57,0:02:40.32,Default,,0,0,0,,Мен ең ұлы патшамын
Dialogue: 0,0:02:40.74,0:02:42.66,Default,,0,0,0,,Түсінде ғана
Dialogue: 0,0:02:42.78,0:02:45.62,Default,,0,0,0,,Бір күні патша боласың.
Dialogue: 0,0:02:46.66,0:02:50.92,Default,,0,0,0,,Джулиан ағай өлсе де...
Dialogue: 0,0:02:51.04,0:02:53.13,Default,,0,0,0,,Олар маған тәжді бере алмайды.
Dialogue: 0,0:02:53.25,0:02:55.92,Default,,0,0,0,,Патша өз халқын қорғайды
Dialogue: 0,0:02:56.50,0:03:01.47,Default,,0,0,0,,Бірақ сіз асыра айтып отырсыз. Фосса шынымен де қорқынышты ма?
Dialogue: 0,0:03:01.59,0:03:03.47,Default,,0,0,0,,Елдің жартысын жеді
Dialogue: 0,0:03:03.60,0:03:07.97,Default,,0,0,0,,Бірақ жартысы жақсы болды. Менің әдетім қандай?
Dialogue: 0,0:03:08.10,0:03:09.52,Default,,0,0,0,,«Мен семіз көрінемін бе?»
Dialogue: 0,0:03:09.68,0:03:12.48,Default,,0,0,0,,Иә! ...жоқ...
Dialogue: 0,0:03:12.65,0:03:16.86,Default,,0,0,0,,Мен Фоссадан қорқып өмір сүргім келмейді.
Dialogue: 0,0:03:17.19,0:03:18.82,Default,,0,0,0,,Мен көңіл көтергім келеді
Dialogue: 0,0:03:18.94,0:03:21.65,Default,,0,0,0,,Қазіргі патшалық жігерлі емес.
Dialogue: 0,0:03:24.28,0:03:25.74,Default,,0,0,0,,«Тыныш»
Dialogue: 0,0:03:25.87,0:03:29.29,Default,,0,0,0,,«Сөйлеме»
Dialogue: 0,0:03:29.41,0:03:30.79,Default,,0,0,0,,«Шщ!»
Dialogue: 0,0:03:30.91,0:03:31.79,Default,,0,0,0,,«Тыныш»
Dialogue: 0,0:03:42.13,0:03:43.47,Default,,0,0,0,,Масикура
Dialogue: 0,0:03:43.59,0:03:44.72,Default,,0,0,0,,Және?
Dialogue: 0,0:03:44.84,0:03:46.47,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:03:46.60,0:03:50.85,Default,,0,0,0,,Менің байлығымды айтыңызшы. Бүгін менде жақсы сезім бар.
Dialogue: 0,0:03:50.98,0:03:54.23,Default,,0,0,0,,Өкінішке орай, пайғамбарлық бірдей.
Dialogue: 0,0:03:54.35,0:03:57.27,Default,,0,0,0,,Корольді Фосса жейді
Dialogue: 0,0:03:57.40,0:04:00.28,Default,,0,0,0,,Ертең күн батқанда, солай ма?
Dialogue: 0,0:04:00.44,0:04:04.36,Default,,0,0,0,,Аспан тәңіріне арнаған құрбандықтарың жетпей ме?
Dialogue: 0,0:04:06.62,0:04:10.75,Default,,0,0,0,,Құрбандықпен болашақты өзгерте алмайсың.
Dialogue: 0,0:04:10.87,0:04:13.83,Default,,0,0,0,,Амалсыздан сұрасам да?
Dialogue: 0,0:04:13.96,0:04:15.58,Default,,0,0,0,,Салиқалы болыңыз
Dialogue: 0,0:04:15.71,0:04:18.75,Default,,0,0,0,,Еңкейіп ұйықта
Dialogue: 0,0:04:18.88,0:04:21.30,Default,,0,0,0,,Мынадай
Dialogue: 0,0:04:21.42,0:04:23.30,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:27.68,0:04:32.02,Default,,0,0,0,,Тәжін кигенді ертең жейді
Dialogue: 0,0:04:32.14,0:04:35.52,Default,,0,0,0,,Тәжді кім киеді?
Dialogue: 0,0:04:35.85,0:04:37.40,Default,,0,0,0,,Масикура, сен...
Dialogue: 0,0:04:38.90,0:04:39.77,Default,,0,0,0,,Ол данышпан.
Dialogue: 0,0:04:40.19,0:04:42.90,Default,,0,0,0,,Менің тамаша жаңалығым бар.
Dialogue: 0,0:04:43.03,0:04:45.20,Default,,0,0,0,,Сіз қазір патшасыз.
Dialogue: 0,0:04:45.32,0:04:46.78,Default,,0,0,0,,Не?
Dialogue: 0,0:04:46.91,0:04:51.83,Default,,0,0,0,,Патшалықты басқар мен көп тырыстым
Dialogue: 0,0:04:51.95,0:04:53.33,Default,,0,0,0,,Әлі ерте емес пе?
Dialogue: 0,0:04:54.54,0:04:55.87,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:04:56.50,0:04:58.33,Default,,0,0,0,,Тым тік
Dialogue: 0,0:04:58.46,0:05:00.88,Default,,0,0,0,,Жарайды, тағы кездесеміз.
Dialogue: 0,0:05:01.00,0:05:04.09,Default,,0,0,0,,Келесі күні ерте
Dialogue: 0,0:05:04.22,0:05:08.55,Default,,0,0,0,,Тағдыр деген біз білмейтін нәрсе.
Dialogue: 0,0:05:09.51,0:05:11.60,Default,,0,0,0,,Мен беде туралы ұмытып кетіппін.
Dialogue: 0,0:05:11.72,0:05:14.06,Default,,0,0,0,,Мен сенің оққағарыңмын.
Dialogue: 0,0:05:15.81,0:05:20.86,Default,,0,0,0,,Есікті құлыптамасаң, дәретхананың ішінде сені аңдып алады.
Dialogue: 0,0:05:20.98,0:05:23.11,Default,,0,0,0,,Олай болса, қош бол!
Dialogue: 0,0:05:28.32,0:05:29.32,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:05:29.45,0:05:34.50,Default,,0,0,0,,Мен де бұл туралы үнемі уайымдадым.
Dialogue: 0,0:05:36.16,0:05:40.29,Default,,0,0,0,,Қуаныштан бұл, Мен тез оянамын.
Dialogue: 0,0:05:40.42,0:05:42.59,Default,,0,0,0,,３ ２ １
Dialogue: 0,0:05:45.92,0:05:49.09,Default,,0,0,0,,Мен патшамын Мен патша болдым
Dialogue: 0,0:05:50.26,0:05:52.76,Default,,0,0,0,,Балалар сендер де бақытты болыңдар.
Dialogue: 0,0:05:53.10,0:05:56.31,Default,,0,0,0,,үшінна алғыс айтқым келеді
Dialogue: 0,0:05:56.43,0:05:59.69,Default,,0,0,0,,Бірақ алдымен аспан құдайынан бастайық.
Dialogue: 0,0:05:59.81,0:06:03.15,Default,,0,0,0,,Мені әрқашан қолдап келгеніңіз үшін рахмет
Dialogue: 0,0:06:03.48,0:06:05.69,Default,,0,0,0,,Ханзада... жоқ, король
Dialogue: 0,0:06:05.82,0:06:08.53,Default,,0,0,0,,Сәл сабыр етіңіз.
Dialogue: 0,0:06:08.65,0:06:13.20,Default,,0,0,0,,үшінна айтпас бұрын мен жоспар құруым керек.
Dialogue: 0,0:06:13.33,0:06:17.08,Default,,0,0,0,,Ең ақылсыз кешті өткізіңіз...
Dialogue: 0,0:06:17.21,0:06:20.00,Default,,0,0,0,,Біз патша екенімізді жария етейік
Dialogue: 0,0:06:20.12,0:06:25.51,Default,,0,0,0,,Егер сіз жаңа патшаға қолыңызды тигізсеңіз, Фосса сізді байқайды.
Dialogue: 0,0:06:25.80,0:06:29.63,Default,,0,0,0,,Дұрыс, партиялар барынша аз болуы керек.
Dialogue: 0,0:06:29.76,0:06:32.80,Default,,0,0,0,,Тек менің туыстарым... Сонда бұл тек мен бе?
Dialogue: 0,0:06:32.93,0:06:35.06,Default,,0,0,0,,Корольдің басқа мүшелерін жеп қойды...
Dialogue: 0,0:06:35.18,0:06:39.77,Default,,0,0,0,,Жоқ, біз фермада көңілді ойнаймыз.
Dialogue: 0,0:06:40.23,0:06:42.44,Default,,0,0,0,,Бұл, әрине, рас.
Dialogue: 0,0:06:42.56,0:06:47.07,Default,,0,0,0,,Келіңіздер, ең төменгі кілтті кешті өткізейік
Dialogue: 0,0:06:48.49,0:06:55.45,Default,,0,0,0,,Жаңа патшаны көргісі келгендіктен бәрі қобалжыды.
Dialogue: 0,0:06:55.58,0:06:58.91,Default,,0,0,0,,Джиги өтетін жерден есеп береді.
Dialogue: 0,0:07:05.46,0:07:09.63,Default,,0,0,0,,Мадагаскардың кедей лемурлары
Dialogue: 0,0:07:09.80,0:07:14.18,Default,,0,0,0,,Ол жаңа патша. Ол керемет және қызықты.
Dialogue: 0,0:07:14.80,0:07:16.76,Default,,0,0,0,,Кері айналдыруды да орындай алады
Dialogue: 0,0:07:16.89,0:07:18.52,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:07:18.64,0:07:21.77,Default,,0,0,0,,Алдыңғы патша кетті...
Dialogue: 0,0:07:21.89,0:07:27.02,Default,,0,0,0,,Партияны жақсы көретін ханзада лайықты патша бола ала ма?
Dialogue: 0,0:07:27.15,0:07:28.23,Default,,0,0,0,,Әдемі аяқ киім
Dialogue: 0,0:07:28.82,0:07:33.78,Default,,0,0,0,,Король Юлиан XIII-тің келуі
Dialogue: 0,0:07:33.95,0:07:39.16,Default,,0,0,0,,Жаңа патшамен жаңа дәуір басталады
Dialogue: 0,0:07:39.33,0:07:44.50,Default,,0,0,0,,Сіз кешке және көңіл көтеруге еркінсіз.
Dialogue: 0,0:07:44.92,0:07:49.13,Default,,0,0,0,,Ал енді Фоссадан қорқудың қажеті жоқ.
Dialogue: 0,0:07:50.30,0:07:55.14,Default,,0,0,0,,Әйелдерімізді, мал-мүлкімізді, бостандығымызды тартып алды.
Dialogue: 0,0:07:55.30,0:07:56.97,Default,,0,0,0,,Алып тастауы мүмкін
Dialogue: 0,0:07:57.47,0:08:01.43,Default,,0,0,0,,Бірақ біздің бостандығымызды ешқашан тартып алуға болмайды
Dialogue: 0,0:08:04.73,0:08:09.11,Default,,0,0,0,,Мен король Джулиенге сенемін
Dialogue: 0,0:08:11.07,0:08:15.74,Default,,0,0,0,,Ол дөңгелек және тышқан тәрізді. Оның аты қандай?
Dialogue: 0,0:08:15.87,0:08:17.95,Default,,0,0,0,,Сәлем, мен Мортпын.
Dialogue: 0,0:08:18.08,0:08:19.49,Default,,0,0,0,,Пернетақта
Dialogue: 0,0:08:44.14,0:08:46.19,Default,,0,0,0,,Кәне, көңіл көтерейік
Dialogue: 0,0:08:48.90,0:08:51.32,Default,,0,0,0,,Жаулар, мен оларды жеңемін.
Dialogue: 0,0:08:56.03,0:08:57.62,Default,,0,0,0,,...
Dialogue: 0,0:09:03.58,0:09:05.92,Default,,0,0,0,,Мереке күні шабуыл жасау нені білдіреді?
Dialogue: 0,0:09:08.67,0:09:09.79,Default,,0,0,0,,Фосса аш
Dialogue: 0,0:09:09.92,0:09:11.34,Default,,0,0,0,,Фосса жейді
Dialogue: 0,0:09:15.05,0:09:17.43,Default,,0,0,0,,Менің дәмім жоқ.
Dialogue: 0,0:09:19.80,0:09:22.56,Default,,0,0,0,,Уайымдама, маған қалдыр
Dialogue: 0,0:09:24.60,0:09:26.52,Default,,0,0,0,,Сіз не істейсіз, патша?
Dialogue: 0,0:09:26.64,0:09:28.65,Default,,0,0,0,,Бар күшіңді салып қаш
Dialogue: 0,0:09:32.28,0:09:36.49,Default,,0,0,0,,Бұл Кингтің көмектесу тәсілі екеніне сенімдімін.
Dialogue: 0,0:09:46.62,0:09:48.21,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:09:48.58,0:09:49.92,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,0:09:50.04,0:09:50.92,Default,,0,0,0,,Орынбасар директор
Dialogue: 0,0:09:52.21,0:09:57.63,Default,,0,0,0,,Сіз соққы алдыңыз ба? Мен «Нигеро» деп дауыстап айтсам да
Dialogue: 0,0:09:57.76,0:10:01.43,Default,,0,0,0,,Кейбіреулер ұсталмай қашып үлгерді...
Dialogue: 0,0:10:01.60,0:10:03.47,Default,,0,0,0,,Қайтып келмейді
Dialogue: 0,0:10:03.60,0:10:04.43,Default,,0,0,0,,Патшалық...
Dialogue: 0,0:10:04.56,0:10:06.18,Default,,0,0,0,,Тек Король және мен
Dialogue: 0,0:10:06.31,0:10:07.52,Default,,0,0,0,,Мен де
Dialogue: 0,0:10:11.06,0:10:14.03,Default,,0,0,0,,Менің орындауымды тыңдауларыңызды қаладым.
Dialogue: 0,0:10:16.86,0:10:18.45,Default,,0,0,0,,Бастау мүмкін емес.
Dialogue: 0,0:10:18.57,0:10:21.49,Default,,0,0,0,,Бұл кім? Тәжі сөйледі ме?
Dialogue: 0,0:10:23.66,0:10:26.70,Default,,0,0,0,,Мұндай кезде таң қалмаңыз
Dialogue: 0,0:10:26.83,0:10:28.87,Default,,0,0,0,,Неліктен мүмкін емес?
Dialogue: 0,0:10:29.00,0:10:31.63,Default,,0,0,0,,Алдыңғы патша пайғамбарлық туралы білген.
Dialogue: 0,0:10:31.75,0:10:36.51,Default,,0,0,0,,Лемур патшасын Фосса жеген кезде.
Dialogue: 0,0:10:36.63,0:10:40.43,Default,,0,0,0,,Сондықтан мен сені кенет патша етіп қойдым.
Dialogue: 0,0:10:40.55,0:10:43.01,Default,,0,0,0,,Қандай ақылды
Dialogue: 0,0:10:43.14,0:10:46.22,Default,,0,0,0,,Патша болмасаң, жемейді.
Dialogue: 0,0:10:46.35,0:10:50.35,Default,,0,0,0,,Патша өзінің миын соншалықты көп пайдалануы керек.
Dialogue: 0,0:10:50.48,0:10:53.94,Default,,0,0,0,,Бірақ оны жеуге болады.
Dialogue: 0,0:10:54.07,0:10:56.53,Default,,0,0,0,,Мұны естіген жоқсың ба?
Dialogue: 0,0:10:56.65,0:11:00.28,Default,,0,0,0,,Патша болмасаң, жей алмайсың.
Dialogue: 0,0:11:00.40,0:11:03.57,Default,,0,0,0,,Мен патшамын, демек...
Dialogue: 0,0:11:05.20,0:11:07.29,Default,,0,0,0,,Пайғамбарлық қате болуы мүмкін.
Dialogue: 0,0:11:07.41,0:11:09.83,Default,,0,0,0,,Мүлдем жеуге болады
Dialogue: 0,0:11:09.96,0:11:12.79,Default,,0,0,0,,Әркімге патша керек
Dialogue: 0,0:11:13.63,0:11:16.25,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:11:16.38,0:11:20.34,Default,,0,0,0,,Халқымызды қайтарудың жолы бар.
Dialogue: 0,0:11:20.76,0:11:22.26,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:11:22.39,0:11:25.30,Default,,0,0,0,,Азаматтардың санын көбейту
Dialogue: 0,0:11:25.43,0:11:26.93,Default,,0,0,0,,Беде - мен
Dialogue: 0,0:11:27.06,0:11:29.89,Default,,0,0,0,,Морис Масикуламен бірге.
Dialogue: 0,0:11:30.02,0:11:30.94,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:11:31.06,0:11:34.02,Default,,0,0,0,,Жоқ? Бұл ескі жол
Dialogue: 0,0:11:35.98,0:11:38.57,Default,,0,0,0,,Жарайды, мен көмектесе алмаймын.
Dialogue: 0,0:11:39.07,0:11:41.11,Default,,0,0,0,,Мен мұны жалғыз жасаймын
Dialogue: 0,0:11:41.24,0:11:42.91,Default,,0,0,0,,Король?
Dialogue: 0,0:11:43.03,0:11:45.78,Default,,0,0,0,,Мен барлығына көмектесемін...
Dialogue: 0,0:11:45.91,0:11:49.25,Default,,0,0,0,,Тағдырымды жеу керек.
Dialogue: 0,0:11:49.37,0:11:51.96,Default,,0,0,0,,Құдайға шүкір
Dialogue: 0,0:11:52.08,0:11:53.67,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:11:57.04,0:11:59.09,Default,,0,0,0,,Маған рахмет айтыңыз.
Dialogue: 0,0:11:59.21,0:12:02.76,Default,,0,0,0,,Мен мұны жалғыз істеуім керек.
Dialogue: 0,0:12:03.09,0:12:04.05,Default,,0,0,0,,Кел, Морис.
Dialogue: 0,0:12:04.18,0:12:04.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:09.52,0:12:14.27,Default,,0,0,0,,Мұндағы ет өте жұмсақ.
Dialogue: 0,0:12:19.11,0:12:21.36,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:21.49,0:12:22.90,Default,,0,0,0,,Ал, көзіңді жұм.
Dialogue: 0,0:12:23.03,0:12:26.49,Default,,0,0,0,,Біз оны ешқашан жей алмаймыз.
Dialogue: 0,0:12:26.62,0:12:29.95,Default,,0,0,0,,Король сізге көмектеседі
Dialogue: 0,0:12:32.08,0:12:35.92,Default,,0,0,0,,Қыша? Немесе барбекю дәмі?
Dialogue: 0,0:12:38.54,0:12:41.13,Default,,0,0,0,,Жол дұрыс па?
Dialogue: 0,0:12:41.26,0:12:43.51,Default,,0,0,0,,Мен Масикурадан сұрадым.
Dialogue: 0,0:12:47.30,0:12:50.43,Default,,0,0,0,,«Жұмбақ бухта»
Dialogue: 0,0:12:50.56,0:12:56.65,Default,,0,0,0,,Құдай берген патша қазынасы осында жасырылған.
Dialogue: 0,0:12:56.77,0:12:59.65,Default,,0,0,0,,Жуылған қоқыс ше?
Dialogue: 0,0:12:59.77,0:13:03.82,Default,,0,0,0,,Бәрібір қазір бәрі менікі.
Dialogue: 0,0:13:06.86,0:13:08.95,Default,,0,0,0,,Мен пайғамбарлықтан нені іздеуім керек?
Dialogue: 0,0:13:09.12,0:13:14.29,Default,,0,0,0,,Дұрыс қаруды тапсаң, оны жүрегіңмен танисың.
Dialogue: 0,0:13:15.46,0:13:16.83,Default,,0,0,0,,Бұл маған тиді
Dialogue: 0,0:13:17.21,0:13:18.54,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:13:20.13,0:13:22.67,Default,,0,0,0,,Сіз Фоссаны ұшырып жібере аласыз.
Dialogue: 0,0:13:22.80,0:13:25.80,Default,,0,0,0,,Бұл керемет басс емес пе?
Dialogue: 0,0:13:25.93,0:13:28.72,Default,,0,0,0,,Мен саңырау болып кететін сияқтымын
Dialogue: 0,0:13:28.84,0:13:30.51,Default,,0,0,0,,Дене өздігінен қозғалады
Dialogue: 0,0:13:30.64,0:13:32.10,Default,,0,0,0,,Тағы... мықты батырлар жоқ па?
Dialogue: 0,0:13:32.22,0:13:36.60,Default,,0,0,0,,Тиісті қаруды іздеңіз
Dialogue: 0,0:13:36.98,0:13:39.61,Default,,0,0,0,,Металл басы, лемураның жүрегі
Dialogue: 0,0:13:39.73,0:13:42.48,Default,,0,0,0,,Фоссаны жеңу
Dialogue: 0,0:13:44.11,0:13:45.40,Default,,0,0,0,,Бұл күшті
Dialogue: 0,0:13:47.45,0:13:48.49,Default,,0,0,0,,Мори
Dialogue: 0,0:13:48.61,0:13:50.66,Default,,0,0,0,,Мені тұрақты ұста
Dialogue: 0,0:13:50.78,0:13:52.03,Default,,0,0,0,,Қалай қолдануға болады?
Dialogue: 0,0:13:52.28,0:13:53.58,Default,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:14:02.00,0:14:05.76,Default,,0,0,0,,Бұл біртүрлі. Ақыр соңында мен осында оралдым.
Dialogue: 0,0:14:05.88,0:14:09.13,Default,,0,0,0,,Бәлкім, біз қандас туысқан шығармыз
Dialogue: 0,0:14:09.26,0:14:12.43,Default,,0,0,0,,Радио мен кассета ойнатқыш ағайынды бола алмайды.
Dialogue: 0,0:14:13.89,0:14:15.47,Default,,0,0,0,,Бұл ойыншық
Dialogue: 0,0:14:15.60,0:14:17.98,Default,,0,0,0,,Ойыншық емес...
Dialogue: 0,0:14:18.10,0:14:21.40,Default,,0,0,0,,Фоссаны жеңетін қару емес пе?
Dialogue: 0,0:14:21.52,0:14:23.48,Default,,0,0,0,,Солай болуы керек...
Dialogue: 0,0:14:25.73,0:14:26.44,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:14:28.86,0:14:29.99,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:14:30.66,0:14:32.83,Default,,0,0,0,,Шынымен... онда шындап!
Dialogue: 0,0:14:46.09,0:14:49.63,Default,,0,0,0,,Ақыры жақсы қару таптыңыз.
Dialogue: 0,0:15:00.77,0:15:04.48,Default,,0,0,0,,Жігіт неғұрлым ақымақ болса, соғұрлым батыл.
Dialogue: 0,0:15:04.61,0:15:08.61,Default,,0,0,0,,Мен алдамшы боламын, сондықтан бәріне көмектесіңіз.
Dialogue: 0,0:15:08.74,0:15:09.49,Default,,0,0,0,,Иә
Dialogue: 0,0:15:09.61,0:15:14.70,Default,,0,0,0,,Мен сенен көмек сұрасам да, алдымен патшалықты ойла.
Dialogue: 0,0:15:14.83,0:15:15.66,Default,,0,0,0,,Әрине
Dialogue: 0,0:15:15.78,0:15:21.33,Default,,0,0,0,,Бөксемді жеп, денемді екіге бөлсе де.
Dialogue: 0,0:15:21.46,0:15:24.75,Default,,0,0,0,,Корольдің батылдығы бар.
Dialogue: 0,0:15:24.88,0:15:26.34,Default,,0,0,0,,Мен ұмытпаймын
Dialogue: 0,0:15:28.30,0:15:29.97,Default,,0,0,0,,Сіз жылап жатырсыз ба?
Dialogue: 0,0:15:30.09,0:15:34.51,Default,,0,0,0,,Құлағыңыз көзіңізге қадалып, көрмей қалдыңыз.
Dialogue: 0,0:15:35.64,0:15:36.89,Default,,0,0,0,,Жоқ, мен оны көрмеймін.
Dialogue: 0,0:15:37.01,0:15:41.73,Default,,0,0,0,,Маған қамқор болғандарыңызға рахмет.
Dialogue: 0,0:15:41.85,0:15:45.19,Default,,0,0,0,,Мен мұны жұмыс деп санамаймын.
Dialogue: 0,0:15:45.31,0:15:47.32,Default,,0,0,0,,Сіз мейірімдісіз.
Dialogue: 0,0:15:47.44,0:15:52.66,Default,,0,0,0,,Бірақ жұмыс болмаса да оның қасында болу қорқынышты.
Dialogue: 0,0:15:56.95,0:15:58.91,Default,,0,0,0,,Осылайша сендер ақымақсыңдар
Dialogue: 0,0:16:01.79,0:16:02.87,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:16:13.30,0:16:16.60,Default,,0,0,0,,Бұлай болмауы керек еді.
Dialogue: 0,0:16:23.81,0:16:27.90,Default,,0,0,0,,Патша, барлығы торда.
Dialogue: 0,0:16:39.62,0:16:41.79,Default,,0,0,0,,Мен де сізге көмектесуге келдім.
Dialogue: 0,0:16:47.71,0:16:52.26,Default,,0,0,0,,Морис Бұрын айтқаныңды ұмыт, маған көмектес!
Dialogue: 0,0:16:52.88,0:16:57.97,Default,,0,0,0,,Егер мен дұрыс қару қолдансам, аман қалуым мүмкін еді.
Dialogue: 0,0:16:58.64,0:17:01.68,Default,,0,0,0,,Иә, мен сондай ақымақпын.
Dialogue: 0,0:17:02.31,0:17:04.81,Default,,0,0,0,,Морис Қайда бара жатырсың?
Dialogue: 0,0:17:04.94,0:17:07.77,Default,,0,0,0,,Менің достарым тамақтанатын сияқты.
Dialogue: 0,0:17:07.94,0:17:11.23,Default,,0,0,0,,Мені тастап қашқан қайда?
Dialogue: 0,0:17:14.78,0:17:18.07,Default,,0,0,0,,Иә, сіз осында екеніңізге сенімдімін.
Dialogue: 0,0:17:18.45,0:17:22.20,Default,,0,0,0,,Мен ең нашар патшамын
Dialogue: 0,0:17:22.33,0:17:25.75,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мені же.
Dialogue: 0,0:17:28.04,0:17:30.75,Default,,0,0,0,,Мен Корольге сендім.
Dialogue: 0,0:17:35.76,0:17:40.93,Default,,0,0,0,,Менің жалғыз өкінетінім, мен бәрін құтқара алмадым.
Dialogue: 0,0:17:41.26,0:17:44.18,Default,,0,0,0,,Мен қатты өкінемін.
Dialogue: 0,0:17:44.31,0:17:45.39,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:17:45.52,0:17:46.73,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:17:46.85,0:17:48.40,Default,,0,0,0,,Мен қайғылымын
Dialogue: 0,0:17:48.52,0:17:51.36,Default,,0,0,0,,Маймыл үшін ұзақ өмір сүрді
Dialogue: 0,0:17:51.48,0:17:54.82,Default,,0,0,0,,Тед, бұл рас.
Dialogue: 0,0:18:00.87,0:18:04.41,Default,,0,0,0,,Морис, қайтып келдің бе?
Dialogue: 0,0:18:05.37,0:18:08.62,Default,,0,0,0,,Бірақ бұл билейтін уақыт емес.
Dialogue: 0,0:18:09.00,0:18:12.84,Default,,0,0,0,,Бұл патшаның бірінші таңдау қаруы.
Dialogue: 0,0:18:12.96,0:18:14.17,Default,,0,0,0,,Жүрегіңізбен!
Dialogue: 0,0:18:17.17,0:18:20.84,Default,,0,0,0,,Менің бөксем дірілдей бастады.
Dialogue: 0,0:18:20.97,0:18:22.10,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:18:22.22,0:18:23.01,Default,,0,0,0,,Сагири тауының шыңында ауа тіпті де жұқа еді!
Dialogue: 0,0:18:23.14,0:18:24.18,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:24.31,0:18:25.85,Default,,0,0,0,,Дыбысты күшейтіңіз
Dialogue: 0,0:19:10.64,0:19:11.94,Default,,0,0,0,,Аяқтар!
Dialogue: 0,0:19:13.06,0:19:14.52,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:14.65,0:19:19.19,Default,,0,0,0,,Мені құтқарған аяқты ешқашан жібермеймін
Dialogue: 0,0:19:19.32,0:19:21.53,Default,,0,0,0,,Патшаның аяғын ұстама
Dialogue: 0,0:19:23.20,0:19:24.74,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:19:24.99,0:19:26.87,Default,,0,0,0,,Жау келе жатыр.
Dialogue: 0,0:19:27.87,0:19:32.71,Default,,0,0,0,,Түсімде көргендей, бірақ пернетақтасыз.
Dialogue: 0,0:19:44.05,0:19:46.93,Default,,0,0,0,,Бірақ менде бұл бас бар.
Dialogue: 0,0:19:47.68,0:19:50.06,Default,,0,0,0,,Көбірек шу шығар, Морис.
Dialogue: 0,0:20:10.12,0:20:13.46,Default,,0,0,0,,Болжағандай, король Джульен!
Dialogue: 0,0:20:31.35,0:20:32.60,Default,,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,0:20:32.89,0:20:36.31,Default,,0,0,0,,Патша, сіз бәріне көмектестіңіз.
Dialogue: 0,0:20:36.44,0:20:38.86,Default,,0,0,0,,Мен сене алар емеспін.
Dialogue: 0,0:20:38.98,0:20:43.36,Default,,0,0,0,,Мені жейді деген сәуегейлік қате ме?
Dialogue: 0,0:20:43.49,0:20:45.86,Default,,0,0,0,,Оның біразын жеуге болады, солай ма?
Dialogue: 0,0:20:46.20,0:20:50.16,Default,,0,0,0,,Менің бөксесін алғаным рас.
Dialogue: 0,0:20:50.33,0:20:53.21,Default,,0,0,0,,Мен болашақты көре аламын
Dialogue: 0,0:21:03.97,0:21:05.80,Default,,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:21:05.93,0:21:08.80,Default,,0,0,0,,Бұл да Кингтің жұмысы.
Dialogue: 0,0:21:09.64,0:21:10.89,Default,,0,0,0,,Тұр! Бір сәт!
Dialogue: 0,0:21:11.01,0:21:15.02,Default,,0,0,0,,Барлық күзетшілер қашып кетті.
Dialogue: 0,0:21:15.14,0:21:18.73,Default,,0,0,0,,Сіз капитан боласыз.
Dialogue: 0,0:21:18.86,0:21:20.77,Default,,0,0,0,,Мен 100 пайыз дәлдікпен анықтай аламын
Dialogue: 0,0:21:21.02,0:21:24.11,Default,,0,0,0,,Көптеген идеялар бар.
Dialogue: 0,0:21:24.24,0:21:26.03,Default,,0,0,0,,Шұңқырлар т.б.
Dialogue: 0,0:21:26.15,0:21:29.87,Default,,0,0,0,,Сабыр ет, бәрібір істедің.
Dialogue: 0,0:21:29.99,0:21:32.20,Default,,0,0,0,,Қызық енді
Dialogue: 0,0:21:32.49,0:21:36.25,Default,,0,0,0,,Иә, Фосса қайтадан келеді.
Dialogue: 0,0:21:37.00,0:21:41.34,Default,,0,0,0,,Және оны өткір тістермен жұлып алуға тырысыңыз
Dialogue: 0,0:21:45.97,0:21:50.22,Default,,0,0,0,,Біз джунглиде тұрамыз.
Dialogue: 0,0:21:50.35,0:21:53.97,Default,,0,0,0,,Түрлі жануарлар бізді жыртып тастады...
Dialogue: 0,0:21:54.10,0:21:57.98,Default,,0,0,0,,Ажал аузына сүйреп апаруды мақсат еткен
Dialogue: 0,0:21:58.85,0:22:01.06,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:22:01.19,0:22:04.44,Default,,0,0,0,,Бірақ мен бүгін бір нәрсені білдім.
Dialogue: 0,0:22:04.57,0:22:07.95,Default,,0,0,0,,Мен ұмыттым, бірақ қазір есімде
Dialogue: 0,0:22:08.07,0:22:11.37,Default,,0,0,0,,Егер ертең ешқашан келмейтін болса
Dialogue: 0,0:22:11.49,0:22:14.54,Default,,0,0,0,,Бүгіннен толық рахат алыңыз
Dialogue: 0,0:22:27.47,0:22:32.10,Default,,0,0,0,,Морис Бұл шынымен жұмақ, солай емес пе?
Dialogue: 0,0:22:37.93,0:22:39.98,Default,,0,0,0,,Оны жеп қойған жоқ па?
