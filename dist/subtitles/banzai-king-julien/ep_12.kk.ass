Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:42.75,0:00:46.04,Default,,0,0,0,,Патша құжатқа қол қойыңыз
Dialogue: 0,0:00:46.37,0:00:48.75,Default,,0,0,0,,Оны қалдырыңыз, Морис.
Dialogue: 0,0:00:48.88,0:00:52.30,Default,,0,0,0,,Тимо маған сиқырлы құрал сыйлады.
Dialogue: 0,0:00:52.42,0:00:54.59,Default,,0,0,0,,Еден таза болады
Dialogue: 0,0:00:54.72,0:00:57.64,Default,,0,0,0,,Бұлбұл өзін жақсы сезінеді
Dialogue: 0,0:01:02.64,0:01:05.23,Default,,0,0,0,,Патша, сен не мініп жүрсің?
Dialogue: 0,0:01:05.35,0:01:06.73,Default,,0,0,0,,Э-э…
Dialogue: 0,0:01:07.02,0:01:07.85,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:01:07.98,0:01:09.56,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:01:23.04,0:01:24.79,Default,,0,0,0,,Морис Не?
Dialogue: 0,0:01:24.91,0:01:26.92,Default,,0,0,0,,Құжатқа қол қою
Dialogue: 0,0:01:27.04,0:01:29.58,Default,,0,0,0,,Көптеген басқа жұмыстар
Dialogue: 0,0:01:29.71,0:01:33.09,Default,,0,0,0,,Менің істейтінім «жұмыс» емес
Dialogue: 0,0:01:33.21,0:01:37.63,Default,,0,0,0,,Біз бұл «сұлулыққа мәңгілік ұмтылу» деп санаймыз
Dialogue: 0,0:01:37.76,0:01:40.76,Default,,0,0,0,,Ол үшін патша кеңсе тауарлары болуы керек.
Dialogue: 0,0:01:40.89,0:01:43.26,Default,,0,0,0,,Суреттер жинағы
Dialogue: 0,0:01:47.85,0:01:51.15,Default,,0,0,0,,Қызыл-қоңыр тым қарапайым
Dialogue: 0,0:01:51.27,0:01:53.11,Default,,0,0,0,,Оны ешкім қолданбайды
Dialogue: 0,0:01:55.99,0:01:56.74,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:01:56.90,0:01:57.90,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:01:58.28,0:02:01.78,Default,,0,0,0,,Ｊ～
Dialogue: 0,0:02:02.20,0:02:03.20,Default,,0,0,0,,Келесі!
Dialogue: 0,0:02:03.41,0:02:06.25,Default,,0,0,0,,Ｕ～
Dialogue: 0,0:02:06.54,0:02:07.50,Default,,0,0,0,,Келесі!
Dialogue: 0,0:02:07.62,0:02:10.17,Default,,0,0,0,,Ｌ～
Dialogue: 0,0:02:18.76,0:02:23.35,Default,,0,0,0,,Маған бірнеше параққа қол қою керек болса да.
Dialogue: 0,0:02:24.18,0:02:25.60,Default,,0,0,0,,Осымен
Dialogue: 0,0:02:38.53,0:02:41.70,Default,,0,0,0,,Қызыл-қоңыр түсті қолдануға жарамсыз.
Dialogue: 0,0:02:41.82,0:02:45.20,Default,,0,0,0,,Морис Дүниеден қызыл қоңыр түсті өшіріңіз
Dialogue: 0,0:02:46.24,0:02:47.16,Default,,0,0,0,,Морис?
Dialogue: 0,0:02:49.04,0:02:51.12,Default,,0,0,0,,Бұл патшалық үшін үлкен мәселе.
Dialogue: 0,0:02:51.25,0:02:55.80,Default,,0,0,0,,Джулианның «и» белгісіне қайсысы жақсы: жүрек пе, әлде күлімсіреу ме?
Dialogue: 0,0:02:55.92,0:02:59.34,Default,,0,0,0,,Кешіріңіз, менің де жүрегім де, күлкісі де...
Dialogue: 0,0:02:59.47,0:03:02.47,Default,,0,0,0,,Бұл менің тәжірибемнен тыс.
Dialogue: 0,0:03:06.47,0:03:09.43,Default,,0,0,0,,Мен мұнда жиі болдым. Осы уақытқа дейін қайда болдың?
Dialogue: 0,0:03:09.56,0:03:12.77,Default,,0,0,0,,Мен жай ғана қыдырдым.
Dialogue: 0,0:03:12.90,0:03:15.52,Default,,0,0,0,,Жалқау болмаңыз және көмектесіңіз
Dialogue: 0,0:03:15.65,0:03:18.23,Default,,0,0,0,,Қай қолтаңба жақсы?
Dialogue: 0,0:03:18.86,0:03:20.03,Default,,0,0,0,,Маған сенің күлкің ұнайды
Dialogue: 0,0:03:20.24,0:03:22.78,Default,,0,0,0,,Жарайды, оны жүрек жасайық.
Dialogue: 0,0:03:22.91,0:03:25.12,Default,,0,0,0,,Қалауыңызша жасаңыз.
Dialogue: 0,0:03:26.20,0:03:28.70,Default,,0,0,0,,Мен жеңіл ұйықтайын деп жатырмын.
Dialogue: 0,0:03:28.83,0:03:29.58,Default,,0,0,0,,«Ұйқылық»?
Dialogue: 0,0:03:30.16,0:03:34.08,Default,,0,0,0,,Бұлай айтуды қашан үйрендің?
Dialogue: 0,0:03:34.21,0:03:37.84,Default,,0,0,0,,Оның үстіне бұл өте қызық сияқты.
Dialogue: 0,0:03:37.96,0:03:41.97,Default,,0,0,0,,Сол бейқам сезім, әрине, ондай емес сияқты.
Dialogue: 0,0:03:42.09,0:03:48.26,Default,,0,0,0,,Бұл менің басымнан өткен. Мен: «Ештеңе емес» дедім.
Dialogue: 0,0:03:50.77,0:03:54.69,Default,,0,0,0,,Патша, бұл жұмбақты зерттеу керек.
Dialogue: 0,0:03:54.81,0:03:56.15,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:56.27,0:03:58.40,Default,,0,0,0,,Ал, мен зерттеймін.
Dialogue: 0,0:03:58.52,0:03:59.86,Default,,0,0,0,,О, жүр
Dialogue: 0,0:04:04.24,0:04:06.70,Default,,0,0,0,,Мақсат - Морис
Dialogue: 0,0:04:06.82,0:04:09.45,Default,,0,0,0,,Неге екені белгісіз, қатты толқып тұрмын, күдікті
Dialogue: 0,0:04:09.58,0:04:15.21,Default,,0,0,0,,Егер сізде жақсылық болмаса, жеке сезімдеріңізді тастап, оны тоқтатыңыз.
Dialogue: 0,0:04:15.92,0:04:17.38,Default,,0,0,0,,Мақсат жылжытылды
Dialogue: 0,0:04:29.60,0:04:31.93,Default,,0,0,0,,Күдікті мінез-құлық
Dialogue: 0,0:04:32.06,0:04:34.31,Default,,0,0,0,,Зиянды жоспардың дәлелі.
Dialogue: 0,0:04:34.44,0:04:36.15,Default,,0,0,0,,Мен сені ұстаймын
Dialogue: 0,0:04:39.94,0:04:40.86,Default,,0,0,0,,Міне!
Dialogue: 0,0:04:41.48,0:04:43.95,Default,,0,0,0,,Морис, бұл қорқынышты.
Dialogue: 0,0:04:48.37,0:04:49.33,Default,,0,0,0,,Қайтарылды
Dialogue: 0,0:04:50.24,0:04:52.91,Default,,0,0,0,,Беде Кенеттен пайда болма
Dialogue: 0,0:04:53.04,0:04:56.50,Default,,0,0,0,,Есікті басқалар сияқты пайдаланыңыз
Dialogue: 0,0:04:56.62,0:04:59.50,Default,,0,0,0,,Енді не айтасың?
Dialogue: 0,0:04:59.84,0:05:01.42,Default,,0,0,0,,«Қорыққан»?
Dialogue: 0,0:05:02.09,0:05:04.01,Default,,0,0,0,,Иә, мен «қорықтым».
Dialogue: 0,0:05:04.51,0:05:08.14,Default,,0,0,0,,Мен Мористің жұмбағын түсіндім.
Dialogue: 0,0:05:08.47,0:05:11.93,Default,,0,0,0,,Тез айтшы, шыдай алмаймын.
Dialogue: 0,0:05:12.06,0:05:15.35,Default,,0,0,0,,Сізге ұнамайтынына сенімдімін.
Dialogue: 0,0:05:18.65,0:05:21.65,Default,,0,0,0,,Джой патша, жарай ма?
Dialogue: 0,0:05:21.77,0:05:25.36,Default,,0,0,0,,Канал салсаң, егістікке су жетеді.
Dialogue: 0,0:05:25.49,0:05:27.20,Default,,0,0,0,,Керемет
Dialogue: 0,0:05:27.32,0:05:30.20,Default,,0,0,0,,Олай болса лабиринт жасайық
Dialogue: 0,0:05:30.33,0:05:33.62,Default,,0,0,0,,Тұйықтары көп лабиринт!
Dialogue: 0,0:05:33.91,0:05:38.21,Default,,0,0,0,,Айттым ғой, басқа лабиринт жасамаймын.
Dialogue: 0,0:05:38.33,0:05:41.46,Default,,0,0,0,,Дұрыс, мен ақымақпын.
Dialogue: 0,0:05:48.59,0:05:53.14,Default,,0,0,0,,Морис ақылды, ол сенің айтқаныңды орындайды.
Dialogue: 0,0:05:53.26,0:05:54.72,Default,,0,0,0,,Лабиринт жасамаңыз
Dialogue: 0,0:05:54.85,0:05:56.68,Default,,0,0,0,,Морис, не істеп жатырсың!
Dialogue: 0,0:05:56.81,0:05:59.44,Default,,0,0,0,,Король Джульен Бұл түсінбеушілік.
Dialogue: 0,0:05:59.56,0:06:02.90,Default,,0,0,0,,Басқа патшаларға кеңес беру
Dialogue: 0,0:06:03.02,0:06:06.82,Default,,0,0,0,,Иә, бірақ... себебі бар.
Dialogue: 0,0:06:06.94,0:06:09.41,Default,,0,0,0,,Мен сенің сылтауларыңды тыңдамаймын.
Dialogue: 0,0:06:09.53,0:06:12.74,Default,,0,0,0,,Артқа тұрыңыз, мен сөйлеймін.
Dialogue: 0,0:06:13.20,0:06:14.58,Default,,0,0,0,,Сонымен айтыңыз
Dialogue: 0,0:06:14.70,0:06:17.16,Default,,0,0,0,,Мен сенің сылтауларыңды тыңдамаймын.
Dialogue: 0,0:06:17.62,0:06:21.00,Default,,0,0,0,,Бірақ сұрайық. Мен себебін білгім келеді.
Dialogue: 0,0:06:21.13,0:06:25.42,Default,,0,0,0,,Карлмен жекпе-жекке шыққанда өрісті өртеп жібермедің бе?
Dialogue: 0,0:06:25.55,0:06:28.59,Default,,0,0,0,,Бұл... не? бұйралау?
Dialogue: 0,0:06:28.72,0:06:33.05,Default,,0,0,0,,Бұл қызық есім. Бірінші C әрпі ме? K?
Dialogue: 0,0:06:33.18,0:06:37.52,Default,,0,0,0,,Бұл Карл, ол сені өлтірмек болды.
Dialogue: 0,0:06:37.64,0:06:38.89,Default,,0,0,0,,Ағай?
Dialogue: 0,0:06:39.02,0:06:41.44,Default,,0,0,0,,Ол да солай...
Dialogue: 0,0:06:41.56,0:06:45.53,Default,,0,0,0,,Карл оғаш қимылдар жасайды.
Dialogue: 0,0:06:45.86,0:06:47.03,Default,,0,0,0,,Crimson?
Dialogue: 0,0:06:47.15,0:06:50.91,Default,,0,0,0,,Ол да оғаш қимылдар жасайды...
Dialogue: 0,0:06:51.03,0:06:52.20,Default,,0,0,0,,Бұл Карл.
Dialogue: 0,0:06:52.32,0:06:55.45,Default,,0,0,0,,Кармин? Барт? Патрис?
Dialogue: 0,0:06:55.58,0:06:57.79,Default,,0,0,0,,Соқпақ? Тодд?
Dialogue: 0,0:06:57.87,0:07:02.00,Default,,0,0,0,,Қалай болғанда да, Карл мен өрісті жоғалтқандықтан...
Dialogue: 0,0:07:02.13,0:07:04.00,Default,,0,0,0,,Тышқандар абдырап қалды.
Dialogue: 0,0:07:04.13,0:07:08.38,Default,,0,0,0,,Егер сіз патшалық құрғыңыз келсе де, сіз жасай алатын жалғыз нәрсе - лабиринт жасау.
Dialogue: 0,0:07:08.51,0:07:10.47,Default,,0,0,0,,Оның үстіне мен өз-өзімнен адасып қалдым.
Dialogue: 0,0:07:10.59,0:07:14.85,Default,,0,0,0,,Мен оны тапсам, аштан өліп жатыр екен.
Dialogue: 0,0:07:14.97,0:07:17.47,Default,,0,0,0,,Бұл осында. Мен оның иісін сеземін.
Dialogue: 0,0:07:25.11,0:07:27.11,Default,,0,0,0,,Сондықтан мен саған көмектесіп отырмын
Dialogue: 0,0:07:27.23,0:07:30.82,Default,,0,0,0,,Ол бірінші патша Джои патша болды.
Dialogue: 0,0:07:30.95,0:07:34.82,Default,,0,0,0,,Менің «патшалығыма» қош келдіңіз
Dialogue: 0,0:07:34.95,0:07:38.74,Default,,0,0,0,,Менің кеңесіммен бәрі бақытты.
Dialogue: 0,0:07:38.87,0:07:40.20,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,0:07:40.33,0:07:42.62,Default,,0,0,0,,Тамақты оңай табуға болады
Dialogue: 0,0:07:42.75,0:07:44.50,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:07:44.63,0:07:45.42,Default,,0,0,0,,Шкаф
Dialogue: 0,0:07:45.54,0:07:48.67,Default,,0,0,0,,Мен көремін. «Күріш шкафта.»
Dialogue: 0,0:07:48.80,0:07:50.38,Default,,0,0,0,,Тамақ ішейік
Dialogue: 0,0:07:55.47,0:07:57.51,Default,,0,0,0,,Тым көп
Dialogue: 0,0:07:57.64,0:08:02.06,Default,,0,0,0,,«Тағам шкафта» емес, «тағам шкафта».
Dialogue: 0,0:08:02.73,0:08:04.15,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:08:04.27,0:08:06.81,Default,,0,0,0,,Мен ақымақпын, ақымақпын!
Dialogue: 0,0:08:07.15,0:08:10.65,Default,,0,0,0,,Морис-кун күткендей, ол өте ақылды.
Dialogue: 0,0:08:11.86,0:08:14.16,Default,,0,0,0,,Оны қалай айтқаныңыз маңызды.
Dialogue: 0,0:08:14.28,0:08:15.62,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:08:15.74,0:08:19.49,Default,,0,0,0,,Мен Мористі үйге апарамын, жарай ма?
Dialogue: 0,0:08:19.62,0:08:22.71,Default,,0,0,0,,Менің саңырау емеспін.
Dialogue: 0,0:08:22.83,0:08:26.54,Default,,0,0,0,,Басқалардан айырмашылығы, басқалардың кеңесін адал тыңдаңыз
Dialogue: 0,0:08:26.67,0:08:29.50,Default,,0,0,0,,Мен де естідім.
Dialogue: 0,0:08:29.63,0:08:30.96,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:08:31.09,0:08:36.22,Default,,0,0,0,,Акушерлік және гинекология бөлімшесіне батут қойылды.
Dialogue: 0,0:08:36.34,0:08:39.35,Default,,0,0,0,,Сәби де қатты қуанды.
Dialogue: 0,0:08:39.47,0:08:42.06,Default,,0,0,0,,Сіздің ұсынысыңыз
Dialogue: 0,0:08:42.18,0:08:44.64,Default,,0,0,0,,Мен қарттар үйін салғым келеді
Dialogue: 0,0:08:44.77,0:08:47.19,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:08:47.31,0:08:52.11,Default,,0,0,0,,Мен сіздің қызықсыз кеңестеріңізді қызықты етемін.
Dialogue: 0,0:08:52.24,0:08:53.61,Default,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,0:08:53.74,0:08:54.49,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:08:55.57,0:08:57.53,Default,,0,0,0,,Жарайды, қал.
Dialogue: 0,0:08:57.66,0:08:59.87,Default,,0,0,0,,Бәрібір жалықтырасың
Dialogue: 0,0:08:59.99,0:09:00.91,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:01.04,0:09:05.33,Default,,0,0,0,,Сіз лемур патшалығынан қуылдыңыз.
Dialogue: 0,0:09:05.46,0:09:07.38,Default,,0,0,0,,Қайтып келме
Dialogue: 0,0:09:07.50,0:09:11.30,Default,,0,0,0,,Мені оқудан шығаруға болмайды. Мен өз бетіммен кеттім.
Dialogue: 0,0:09:11.42,0:09:15.76,Default,,0,0,0,,Сәлемдемеңіз, онда мен айдауыңызды тоқтатамын.
Dialogue: 0,0:09:15.84,0:09:16.51,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:09:16.59,0:09:18.93,Default,,0,0,0,,Ах, және қайта айдау.
Dialogue: 0,0:09:19.05,0:09:22.27,Default,,0,0,0,,Сіз мәңгілікке қуылдыңыз.
Dialogue: 0,0:09:22.39,0:09:23.64,Default,,0,0,0,,Бұл менің жеңісім.
Dialogue: 0,0:09:26.06,0:09:27.48,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:09:28.02,0:09:30.61,Default,,0,0,0,,Сен мені жақсы көрмедің!
Dialogue: 0,0:09:30.73,0:09:32.57,Default,,0,0,0,,Түсінуіңізді сұраймыз.
Dialogue: 0,0:09:32.69,0:09:36.82,Default,,0,0,0,,Мен сені сүйемін, мен сені сүйемін
Dialogue: 0,0:09:38.86,0:09:41.78,Default,,0,0,0,,Дыбыс деңгейін көтеріңіз! Артқа айналдыру!
Dialogue: 0,0:09:43.58,0:09:45.58,Default,,0,0,0,,Түсінуіңізді сұраймыз.
Dialogue: 0,0:09:45.71,0:09:48.17,Default,,0,0,0,,Мен сені жақсы көремін!
Dialogue: 0,0:09:48.29,0:09:50.54,Default,,0,0,0,,Енді ештеңе айтпа
Dialogue: 0,0:09:50.67,0:09:54.51,Default,,0,0,0,,«Мен сені сүйемін!» деген сөзіңді естідім.
Dialogue: 0,0:09:55.38,0:09:56.97,Default,,0,0,0,,Бұл қандай ақша?
Dialogue: 0,0:09:57.09,0:09:59.01,Default,,0,0,0,,Бұл әдеттегі сүйіспеншілік.
Dialogue: 0,0:10:00.47,0:10:04.14,Default,,0,0,0,,Иә, махаббат хикаялары әрқашан...
Dialogue: 0,0:10:04.27,0:10:07.35,Default,,0,0,0,,Бір-біріне қарсы шыққан екі адам бір-бірін жақсы көреді
Dialogue: 0,0:10:07.48,0:10:09.27,Default,,0,0,0,,Кинг пен Морис те?
Dialogue: 0,0:10:10.15,0:10:12.82,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:10:13.36,0:10:19.32,Default,,0,0,0,,Біздің күнделікті уайымымызды еске түсіретін драмалар ғана бар ма?
Dialogue: 0,0:10:19.49,0:10:20.82,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:10:22.12,0:10:24.41,Default,,0,0,0,,Бұл бос сөз, жалғастыра бер.
Dialogue: 0,0:10:25.62,0:10:28.33,Default,,0,0,0,,Қараңыз, шешілді.
Dialogue: 0,0:10:28.46,0:10:29.83,Default,,0,0,0,,Мені сүй!
Dialogue: 0,0:10:44.18,0:10:49.31,Default,,0,0,0,,Менің Мориске ысырап болғаным рас.
Dialogue: 0,0:10:49.44,0:10:51.73,Default,,0,0,0,,Мен жақсырақпын
Dialogue: 0,0:10:52.86,0:10:54.94,Default,,0,0,0,,Амелия, сен ғана.
Dialogue: 0,0:10:55.07,0:10:57.53,Default,,0,0,0,,Тек мені жіберме
Dialogue: 0,0:10:58.44,0:10:59.53,Default,,0,0,0,,Не?
Dialogue: 0,0:10:59.65,0:11:03.95,Default,,0,0,0,,Дұрыс, мұңаймаңыз.
Dialogue: 0,0:11:04.08,0:11:06.87,Default,,0,0,0,,Король Джулиен қайтып келді.
Dialogue: 0,0:11:08.37,0:11:10.96,Default,,0,0,0,,Мен қайтадан жарақат алудан қорқамын
Dialogue: 0,0:11:11.54,0:11:15.71,Default,,0,0,0,,Бірақ сіз дұрыс айтасыз, мен алты сағат күттім.
Dialogue: 0,0:11:16.09,0:11:18.67,Default,,0,0,0,,Жаңа кеңесшіні іздеу
Dialogue: 0,0:11:21.22,0:11:24.14,Default,,0,0,0,,Бірінші үміткерді тапсырыңыз.
Dialogue: 0,0:11:27.43,0:11:31.06,Default,,0,0,0,,Оның аты... «Жак де Жак»?
Dialogue: 0,0:11:31.89,0:11:34.19,Default,,0,0,0,,Морттың бетпердесі, солай ма?
Dialogue: 0,0:11:34.40,0:11:36.94,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:11:37.07,0:11:40.07,Default,,0,0,0,,Иә... Ви емес
Dialogue: 0,0:11:40.78,0:11:42.78,Default,,0,0,0,,Бұл Ви Ви
Dialogue: 0,0:11:44.24,0:11:44.91,Default,,0,0,0,,Келесі!
Dialogue: 0,0:11:45.53,0:11:49.08,Default,,0,0,0,,Сәлем, қайырлы күн. Қалдарыңыз қалай?
Dialogue: 0,0:11:49.20,0:11:54.17,Default,,0,0,0,,Мен Is Sal Table Jr.
Dialogue: 0,0:11:54.29,0:11:57.17,Default,,0,0,0,,Сіздің кеңесшіңіз болыңыз
Dialogue: 0,0:11:57.71,0:11:58.71,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:58.84,0:12:00.67,Default,,0,0,0,,Морт, шық!
Dialogue: 0,0:12:01.01,0:12:06.26,Default,,0,0,0,,Мен сізге әр түрлі кеңес беремін.Сіз ыстық тамақты ұнатасыз ба?
Dialogue: 0,0:12:09.60,0:12:13.10,Default,,0,0,0,,Сіз тым алыс кеттіңіз. Одан құтыл.
Dialogue: 0,0:12:14.15,0:12:16.02,Default,,0,0,0,,Бұл шынымен де мәселе.
Dialogue: 0,0:12:16.15,0:12:17.94,Default,,0,0,0,,Бұл өте қорқынышты болды
Dialogue: 0,0:12:18.07,0:12:21.24,Default,,0,0,0,,Басқа үміткерлер бар ма?
Dialogue: 0,0:12:21.36,0:12:23.78,Default,,0,0,0,,Мен кандидатпын.
Dialogue: 0,0:12:24.11,0:12:27.66,Default,,0,0,0,,Алданбаңыз, бұл Морттың бетпердесі.
Dialogue: 0,0:12:27.78,0:12:29.45,Default,,0,0,0,,Бұл Хорст.
Dialogue: 0,0:12:29.58,0:12:30.24,Default,,0,0,0,,Кім?
Dialogue: 0,0:12:30.37,0:12:32.29,Default,,0,0,0,,Доссыз Хорст
Dialogue: 0,0:12:32.41,0:12:35.67,Default,,0,0,0,,Менде үнемі ішетін нәрсе бар
Dialogue: 0,0:12:35.79,0:12:38.96,Default,,0,0,0,,Ол біртүрлі жігіт. Біртүрлілердің пайдасы жоқ.
Dialogue: 0,0:12:39.09,0:12:40.80,Default,,0,0,0,,Келесіде шығыңыз!
Dialogue: 0,0:12:41.30,0:12:43.80,Default,,0,0,0,,Морт, бетперде болма.
Dialogue: 0,0:12:43.92,0:12:44.76,Default,,0,0,0,,№.
Dialogue: 0,0:12:44.88,0:12:47.09,Default,,0,0,0,,үшін бірдей көрінеді
Dialogue: 0,0:12:47.22,0:12:48.22,Default,,0,0,0,,Дороти?
Dialogue: 0,0:12:48.35,0:12:50.18,Default,,0,0,0,,Жоқ, ол ер адам.
Dialogue: 0,0:12:50.31,0:12:54.10,Default,,0,0,0,,Сыртқы түріне қарап баға беру жақсы емес.
Dialogue: 0,0:12:54.23,0:12:56.06,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:12:56.35,0:12:59.69,Default,,0,0,0,,Ер адамсың ба, әйелсің бе бәрібір. Өтінемін жауап беріңізші.
Dialogue: 0,0:12:59.82,0:13:02.57,Default,,0,0,0,,Сіз қандай кеңес берер едіңіз?
Dialogue: 0,0:13:03.61,0:13:06.41,Default,,0,0,0,,«үшін өледі»
Dialogue: 0,0:13:07.16,0:13:08.16,Default,,0,0,0,,Жетеді
Dialogue: 0,0:13:09.03,0:13:10.08,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:13:10.20,0:13:12.45,Default,,0,0,0,,Енді орындалды.
Dialogue: 0,0:13:12.58,0:13:14.29,Default,,0,0,0,,Жарайды, қатты жүрейік.
Dialogue: 0,0:13:16.58,0:13:17.54,Default,,0,0,0,,Неліктен бұл ұнайды?
Dialogue: 0,0:13:17.67,0:13:19.34,Default,,0,0,0,,«Қатты жаса»
Dialogue: 0,0:13:19.46,0:13:20.71,Default,,0,0,0,,Солай деді
Dialogue: 0,0:13:20.84,0:13:23.46,Default,,0,0,0,,Бұл жай сөйлем...
Dialogue: 0,0:13:23.59,0:13:27.68,Default,,0,0,0,,Жарайды, су жолын аяқтаймыз.
Dialogue: 0,0:13:27.80,0:13:30.18,Default,,0,0,0,,Олай болса лабиринт жасайық
Dialogue: 0,0:13:30.30,0:13:35.02,Default,,0,0,0,,Қабырғаны шынымен биік етіп, ішіне тағамды жасырыңыз.
Dialogue: 0,0:13:35.14,0:13:36.89,Default,,0,0,0,,Жасырын.
Dialogue: 0,0:13:37.02,0:13:38.40,Default,,0,0,0,,Э-э…
Dialogue: 0,0:13:38.52,0:13:42.32,Default,,0,0,0,,Айтпақшы, тамақ қайда? Менің қарыным ашты.
Dialogue: 0,0:13:50.28,0:13:51.37,Default,,0,0,0,,Беде
Dialogue: 0,0:13:51.62,0:13:54.91,Default,,0,0,0,,Мен сені іздедім. Мен мойындағым келеді.
Dialogue: 0,0:13:55.04,0:13:57.33,Default,,0,0,0,,Сіз таң қалуыңыз мүмкін...
Dialogue: 0,0:13:57.46,0:13:59.83,Default,,0,0,0,,Мен Морис үшін алаңдаймын.
Dialogue: 0,0:13:59.96,0:14:03.34,Default,,0,0,0,,Жарайды, сен есейдің.
Dialogue: 0,0:14:03.46,0:14:05.92,Default,,0,0,0,,Адамға айтыңыз
Dialogue: 0,0:14:06.05,0:14:08.22,Default,,0,0,0,,...
Dialogue: 0,0:14:08.34,0:14:11.80,Default,,0,0,0,,Айтсам, сезімім ашылады.
Dialogue: 0,0:14:11.93,0:14:15.02,Default,,0,0,0,,Сіз кеңесшісіз, сондықтан мықты болыңыз.
Dialogue: 0,0:14:15.14,0:14:17.48,Default,,0,0,0,,Оққағар
Dialogue: 0,0:14:17.60,0:14:20.15,Default,,0,0,0,,Жақсы, бұл жақсы
Dialogue: 0,0:14:20.77,0:14:23.90,Default,,0,0,0,,Мен Мориске ұнаудың жолын ойладым.
Dialogue: 0,0:14:24.02,0:14:28.57,Default,,0,0,0,,Тышқан патшалығына барып, оны қадағалаңыз.
Dialogue: 0,0:14:28.70,0:14:31.66,Default,,0,0,0,,Көлеңкеден жасырын
Dialogue: 0,0:14:31.78,0:14:34.24,Default,,0,0,0,,Бұл аңдыушы
Dialogue: 0,0:14:35.20,0:14:38.08,Default,,0,0,0,,Сталкер? Көңілді сияқты.
Dialogue: 0,0:14:38.21,0:14:43.29,Default,,0,0,0,,Жасырын қарауға қуанбайтын адам жоқ.
Dialogue: 0,0:14:43.42,0:14:48.97,Default,,0,0,0,,Мм... аңдыушылар мүлде керісінше.
Dialogue: 0,0:14:49.09,0:14:50.09,Default,,0,0,0,,Кеттік
Dialogue: 0,0:14:50.38,0:14:55.64,Default,,0,0,0,,Бұрынғы кеңесшіңізді жасырын түрде қуантыңыз.
Dialogue: 0,0:14:55.89,0:14:58.27,Default,,0,0,0,,Сондықтан мен риза емеспін...
Dialogue: 0,0:15:01.35,0:15:05.94,Default,,0,0,0,,Король Джои бүгін не істеп жатырсыз?
Dialogue: 0,0:15:06.23,0:15:10.65,Default,,0,0,0,,Мен лабиринттен басқа кез келген нәрсеге көмектесемін.
Dialogue: 0,0:15:10.78,0:15:13.74,Default,,0,0,0,,Олай болса лабиринт жасайық.
Dialogue: 0,0:15:15.66,0:15:20.46,Default,,0,0,0,,Сіз батыл және ерекше ойнағыңыз келе ме?
Dialogue: 0,0:15:20.58,0:15:25.38,Default,,0,0,0,,Басында бұл мүмкін емес сияқты көрінді, бірақ соңында бәрі жақсы болды.
Dialogue: 0,0:15:27.71,0:15:31.43,Default,,0,0,0,,Сөздердің орналасу жолы тым қиын
Dialogue: 0,0:15:32.13,0:15:33.68,Default,,0,0,0,,Қалай болғанда да, торттан дәм татпайсың ба?
Dialogue: 0,0:15:34.35,0:15:39.06,Default,,0,0,0,,Мен король Джулиенмен көңіл көтердім...
Dialogue: 0,0:15:41.39,0:15:44.90,Default,,0,0,0,,Морис Сіз де осында тамақтанып жатырсыз ба?
Dialogue: 0,0:15:45.02,0:15:47.07,Default,,0,0,0,,Сіз аңдыушысыз ба?
Dialogue: 0,0:15:47.19,0:15:48.98,Default,,0,0,0,,Иә, бақыттысың ба?
Dialogue: 0,0:15:50.44,0:15:54.24,Default,,0,0,0,,Бұл түсінбеушілік... Жоқ, көріп тұрғаныңыздай.
Dialogue: 0,0:15:54.37,0:15:57.03,Default,,0,0,0,,Басқалары бар ма?
Dialogue: 0,0:15:57.99,0:15:59.45,Default,,0,0,0,,Сәлем, қалайсың?
Dialogue: 0,0:16:00.62,0:16:02.41,Default,,0,0,0,,Барлық азаматтар?
Dialogue: 0,0:16:02.54,0:16:06.92,Default,,0,0,0,,Ел басқарушы қызметін артқа тастадым.
Dialogue: 0,0:16:13.93,0:16:18.56,Default,,0,0,0,,Айттым ғой, қайтпаймын.
Dialogue: 0,0:16:18.68,0:16:19.64,Default,,0,0,0,,Ал Вайолет ше?
Dialogue: 0,0:16:19.77,0:16:22.60,Default,,0,0,0,,Қайда барсаңыз да табыңыз
Dialogue: 0,0:16:22.73,0:16:25.40,Default,,0,0,0,,Мен сенің аңдыушыңмын
Dialogue: 0,0:16:26.40,0:16:28.11,Default,,0,0,0,,Орынсыз
Dialogue: 0,0:16:28.23,0:16:30.90,Default,,0,0,0,,Менің көзімнен жоғалып кетші
Dialogue: 0,0:16:32.19,0:16:35.03,Default,,0,0,0,,Мінезі дұрыс емес.
Dialogue: 0,0:16:35.16,0:16:39.20,Default,,0,0,0,,Мен сенсіз бақыттымын деп келдім.
Dialogue: 0,0:16:39.33,0:16:42.50,Default,,0,0,0,,Күнде күлгенімді тыя алмаймын
Dialogue: 0,0:16:44.37,0:16:45.25,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:16:45.37,0:16:47.33,Default,,0,0,0,,Бұл жолы қоштасу
Dialogue: 0,0:16:47.46,0:16:51.38,Default,,0,0,0,,Кловер және бәріміз, тезірек үйге қайтайық.
Dialogue: 0,0:16:52.01,0:16:53.80,Default,,0,0,0,,Патша белі...
Dialogue: 0,0:16:57.85,0:17:01.10,Default,,0,0,0,,Түс солып қалады
Dialogue: 0,0:17:01.39,0:17:04.94,Default,,0,0,0,,Өмір неге қиын?
Dialogue: 0,0:17:05.23,0:17:09.82,Default,,0,0,0,,Тырнақ тырнақтары бұл сияқты ауыртпайды.
Dialogue: 0,0:17:10.27,0:17:12.99,Default,,0,0,0,,Егер сіз оған өз сезіміңізді айтсаңыз...
Dialogue: 0,0:17:13.11,0:17:14.11,Default,,0,0,0,,Бұл дауыс
Dialogue: 0,0:17:14.24,0:17:15.70,Default,,0,0,0,,Қайтып кел
Dialogue: 0,0:17:15.82,0:17:16.95,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:17:17.07,0:17:20.03,Default,,0,0,0,,Иә, мен ананаспын
Dialogue: 0,0:17:20.16,0:17:24.29,Default,,0,0,0,,Неліктен мұнда? Ол әрқашан жұмақ емес пе?
Dialogue: 0,0:17:24.41,0:17:28.54,Default,,0,0,0,,Жоғалып бара жатқан достықты сақтау үшін келдім.
Dialogue: 0,0:17:28.79,0:17:33.17,Default,,0,0,0,,Ал мен үлкен жеміске қарыздармын...
Dialogue: 0,0:17:33.30,0:17:35.63,Default,,0,0,0,,Себебі мені қорқытты.
Dialogue: 0,0:17:35.84,0:17:38.34,Default,,0,0,0,,тым кеш
Dialogue: 0,0:17:38.47,0:17:40.80,Default,,0,0,0,,Морис байланыстарын үзген кезде
Dialogue: 0,0:17:40.93,0:17:42.97,Default,,0,0,0,,Сіз өз сезіміңізді білдірдіңіз бе?
Dialogue: 0,0:17:43.10,0:17:44.56,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:17:44.68,0:17:48.15,Default,,0,0,0,,Телекинез болса, оны дауыстап айтудың қажеті жоқ.
Dialogue: 0,0:17:48.27,0:17:51.23,Default,,0,0,0,,Басқа да жолдар бар
Dialogue: 0,0:17:52.44,0:17:53.19,Default,,0,0,0,,Вентрилокизм?
Dialogue: 0,0:17:53.32,0:17:55.11,Default,,0,0,0,,Жоқ, одан да көп
Dialogue: 0,0:17:55.69,0:17:57.45,Default,,0,0,0,,Ән туралы не айтасыз?
Dialogue: 0,0:18:01.12,0:18:07.54,Default,,0,0,0,,Момо Сіз сондасыз ба? Жалғыз болу қорқынышты емес пе?
Dialogue: 0,0:18:08.08,0:18:11.34,Default,,0,0,0,,Замаға қарашы... Бұл дұрыс емес.
Dialogue: 0,0:18:11.71,0:18:15.26,Default,,0,0,0,,Мен жалғызбын, үйге қайт.
Dialogue: 0,0:18:16.05,0:18:22.60,Default,,0,0,0,,Момо Бұл сезім менің жүрегімдегі тесік сияқты.
Dialogue: 0,0:18:23.14,0:18:25.64,Default,,0,0,0,,Тінтуірді таңдау
Dialogue: 0,0:18:26.85,0:18:30.35,Default,,0,0,0,,Кешіріңіз, мен тағы ашуландым.
Dialogue: 0,0:18:33.98,0:18:35.73,Default,,0,0,0,,О, Момо
Dialogue: 0,0:18:35.86,0:18:37.99,Default,,0,0,0,,Король Джулиен
Dialogue: 0,0:18:38.11,0:18:41.49,Default,,0,0,0,,Мені бұл үмітсіздіктен құтқар
Dialogue: 0,0:18:41.62,0:18:45.45,Default,,0,0,0,,Ағайын болсақ та, Тағдыр тартқан бізді.
Dialogue: 0,0:18:45.58,0:18:48.71,Default,,0,0,0,,Бұл қалай болды?
Dialogue: 0,0:18:48.83,0:18:50.42,Default,,0,0,0,,О, Момо
Dialogue: 0,0:18:50.54,0:18:52.63,Default,,0,0,0,,Король Джулиен
Dialogue: 0,0:18:52.75,0:18:56.00,Default,,0,0,0,,Сенсіз патшалық бос
Dialogue: 0,0:18:56.34,0:19:00.18,Default,,0,0,0,,Менің досым, менің ең жақын досым
Dialogue: 0,0:19:00.30,0:19:04.01,Default,,0,0,0,,Менің өмірім, сүйіктім...
Dialogue: 0,0:19:04.14,0:19:05.31,Default,,0,0,0,,Иә, ғашық?
Dialogue: 0,0:19:06.52,0:19:09.85,Default,,0,0,0,,Саксофон.
Dialogue: 0,0:19:11.69,0:19:16.44,Default,,0,0,0,,Сөзбен айтып жеткізу мүмкін емес сезімдерді бағалаңыз.
Dialogue: 0,0:19:20.15,0:19:21.86,Default,,0,0,0,,О, Момо
Dialogue: 0,0:19:21.99,0:19:24.20,Default,,0,0,0,,Король Джулиен
Dialogue: 0,0:19:24.32,0:19:27.62,Default,,0,0,0,,Мен мұның осылай аяқталғанын қаламаймын.
Dialogue: 0,0:19:27.74,0:19:32.92,Default,,0,0,0,,Егер мен сізді тағы бір рет көрсем...
Dialogue: 0,0:19:33.29,0:19:36.46,Default,,0,0,0,,«Кешіріңіз» деңіз
Dialogue: 0,0:19:41.22,0:19:45.72,Default,,0,0,0,,Момо~ Менің ағам
Dialogue: 0,0:19:49.06,0:19:52.10,Default,,0,0,0,,Не істеу керектігін білдіңіз бе?
Dialogue: 0,0:19:52.23,0:19:54.06,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:19:54.19,0:19:56.48,Default,,0,0,0,,Бірақ вентрилокизм...
Dialogue: 0,0:19:56.61,0:19:59.53,Default,,0,0,0,,Жоқ, ананас
Dialogue: 0,0:19:59.65,0:20:01.74,Default,,0,0,0,,Мен не істей алатынымды көрдім
Dialogue: 0,0:20:01.95,0:20:06.53,Default,,0,0,0,,Тышқан патшалығына барып, Мориске айтыңыз.
Dialogue: 0,0:20:06.66,0:20:08.91,Default,,0,0,0,,«Кешіріңіз, мен жалғызбын.»
Dialogue: 0,0:20:09.04,0:20:11.79,Default,,0,0,0,,«Мен сенсіз өмір сүре алмаймын»
Dialogue: 0,0:20:11.91,0:20:13.33,Default,,0,0,0,,«Онымен бірдей»
Dialogue: 0,0:20:13.46,0:20:16.84,Default,,0,0,0,,«Мен сен үшін қолымнан келгеннің бәрін жасаймын».
Dialogue: 0,0:20:16.96,0:20:22.80,Default,,0,0,0,,«Менің кеңесшіме оралыңыз» деп айтыңыз.
Dialogue: 0,0:20:25.51,0:20:27.55,Default,,0,0,0,,Морис, сен мұны естідің бе?
Dialogue: 0,0:20:27.68,0:20:29.60,Default,,0,0,0,,Қош келдіңіз... Сіз кімсіз?
Dialogue: 0,0:20:31.64,0:20:33.35,Default,,0,0,0,,Морис, не болды?
Dialogue: 0,0:20:33.48,0:20:37.11,Default,,0,0,0,,Сіз тышқан қақпанына түсіп қалдыңыз ба?
Dialogue: 0,0:20:37.23,0:20:40.94,Default,,0,0,0,,Уайымдама, король Джой, тек...
Dialogue: 0,0:20:41.57,0:20:47.28,Default,,0,0,0,,Мен Король Джулиенді көргенде оның жақсы екенін түсіндім.
Dialogue: 0,0:20:47.41,0:20:48.53,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:20:48.66,0:20:53.21,Default,,0,0,0,,Уайымдама, ол әлдеқашан өліп қалды.
Dialogue: 0,0:20:54.87,0:20:55.62,Default,,0,0,0,,Не?
Dialogue: 0,0:20:55.75,0:20:57.17,Default,,0,0,0,,Мен өлтірген адам
Dialogue: 0,0:20:57.29,0:20:59.50,Default,,0,0,0,,Тойлау үшін лабиринт жасайық
Dialogue: 0,0:20:59.63,0:21:01.09,Default,,0,0,0,,Сен оны өлтірдің бе?
Dialogue: 0,0:21:01.21,0:21:05.51,Default,,0,0,0,,«Сенің жоғалғаныңды қалаймын» деп айтпадың ба?
Dialogue: 0,0:21:05.63,0:21:08.85,Default,,0,0,0,,Бұл жай ғана сөз тіркесі...
Dialogue: 0,0:21:08.97,0:21:13.56,Default,,0,0,0,,Өтінемін, оны өшіруді тоқтатыңыз.
Dialogue: 0,0:21:13.68,0:21:16.35,Default,,0,0,0,,Мен ақымақпын, ақымақпын!
Dialogue: 0,0:21:16.48,0:21:18.61,Default,,0,0,0,,Кешіріңіз, Морис-кун.
Dialogue: 0,0:21:18.73,0:21:23.24,Default,,0,0,0,,Бірақ мен жалқау Дагтан сұрадым, мүмкін уақытында үлгеремін.
Dialogue: 0,0:21:23.36,0:21:25.11,Default,,0,0,0,,Міне, Даг.
Dialogue: 0,0:21:25.24,0:21:27.70,Default,,0,0,0,,Король Джульен ше?
Dialogue: 0,0:21:27.82,0:21:29.83,Default,,0,0,0,,Мен ұйықтап қалдым.
Dialogue: 0,0:21:29.95,0:21:33.16,Default,,0,0,0,,Мен оны білікті Чарлиге қалдырдым.
Dialogue: 0,0:21:33.29,0:21:34.91,Default,,0,0,0,,Мен твиттер жазбадым.
Dialogue: 0,0:21:35.08,0:21:39.75,Default,,0,0,0,,Чарли тез жұмыс істейді.
Dialogue: 0,0:21:39.88,0:21:42.17,Default,,0,0,0,,Мен саған көмектесуім керек. Ол қайда?
Dialogue: 0,0:21:43.17,0:21:47.01,Default,,0,0,0,,Мен жай ғана нұсқауларды орындаймын
Dialogue: 0,0:21:47.13,0:21:48.39,Default,,0,0,0,,Түсініңіз
Dialogue: 0,0:21:48.51,0:21:50.72,Default,,0,0,0,,Маған ұнамайды, түсінбеймін.
Dialogue: 0,0:21:50.85,0:21:52.85,Default,,0,0,0,,Бұдан былай сіз...
Dialogue: 0,0:21:52.97,0:21:54.81,Default,,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:21:56.27,0:21:58.40,Default,,0,0,0,,Қазір көмектесіңіз!
Dialogue: 0,0:21:59.56,0:22:02.07,Default,,0,0,0,,Король Джульен!
Dialogue: 0,0:22:08.70,0:22:10.87,Default,,0,0,0,,Кешірім сұрауды қабылдаңыз
Dialogue: 0,0:22:10.99,0:22:15.16,Default,,0,0,0,,Мен кешірім сұрамаймын, бірақ мен сізге бір нәрсе айтқым келеді.
Dialogue: 0,0:22:15.29,0:22:17.12,Default,,0,0,0,,I патша...
Dialogue: 0,0:22:18.58,0:22:19.33,Default,,0,0,0,,Йосе
Dialogue: 0,0:22:19.79,0:22:21.00,Default,,0,0,0,,Татуласу
Dialogue: 0,0:22:21.13,0:22:22.71,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:23.42,0:22:25.46,Default,,0,0,0,,Алыс болыңыз, бұл 5 секунд ережесі.
Dialogue: 0,0:22:25.59,0:22:26.72,Default,,0,0,0,,Үйге қайтайық?
Dialogue: 0,0:22:26.84,0:22:28.76,Default,,0,0,0,,Иә, қызықсыз болды.
Dialogue: 0,0:22:28.88,0:22:34.31,Default,,0,0,0,,Тышқан патшалығы менсіз жақсы болады.
Dialogue: 0,0:22:37.14,0:22:39.23,Default,,0,0,0,,Содан кейін лабиринт жасаңыз...
Dialogue: 0,0:23:06.17,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Akira Horiike
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
