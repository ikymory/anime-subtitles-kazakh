Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:25.29,0:01:30.29,Default,,0,0,0,,～♪
Dialogue: 0,0:01:31.00,0:01:33.92,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:01:34.01,0:01:37.88,Default,,0,0,0,,Келіңіздер, Чемпионат турнирі Токио A Алдын ала финалдар
Dialogue: 0,0:01:37.97,0:01:39.93,Default,,0,0,0,,Жақында екінші жартысы басталады.
Dialogue: 0,0:01:40.89,0:01:43.68,Default,,0,0,0,,Сейсеки орта мектебінде мүшелер өзгермейді.
Dialogue: 0,0:01:44.35,0:01:48.81,Default,,0,0,0,,Екінші жағынан, Тоин Гакуэн 3-ші жыл шабуылшы Кайтоны таныстырды.
Dialogue: 0,0:01:48.90,0:01:49.56,Default,,0,0,0,,Кайто! Кайто! Кайто!
Dialogue: 0,0:01:49.56,0:01:50.86,Default,,0,0,0,,Кайто! Кайто! Кайто!
Dialogue: 0,0:01:49.56,0:01:50.86,Default,,0,0,0,,Көңіл көтеру орындықтары да бүгінгі күні ең толқуды көрсетеді.
Dialogue: 0,0:01:50.86,0:01:50.94,Default,,0,0,0,,Көңіл көтеру орындықтары да бүгінгі таңда ең толқуды көрсетеді.
Dialogue: 0,0:01:50.94,0:01:52.82,Default,,0,0,0,,Көңіл көтеру орындықтары да бүгінгі таңда ең толқуды көрсетеді.
Dialogue: 0,0:01:50.94,0:01:52.82,Default,,0,0,0,,Кайто! Кайто! Кайто!
Dialogue: 0,0:01:52.90,0:01:57.15,Default,,0,0,0,,Мен төменгі арқамның жарақатына алаңдаймын, бірақ мен эйспін.
Dialogue: 0,0:01:57.24,0:01:59.03,Default,,0,0,0,,Күтілетін мән де жоғары болады.
Dialogue: 0,0:01:59.11,0:02:03.12,Default,,0,0,0,,Мен де сенің маған қандай қойылым көрсететініңді асыға күтемін.
Dialogue: 0,0:02:03.62,0:02:05.75,Default,,0,0,0,,Таку Сіз басынан бастап келе аласыз.
Dialogue: 0,0:02:05.83,0:02:07.41,Default,,0,0,0,,Сіз шынымен бара аласыз ба?
Dialogue: 0,0:02:08.29,0:02:10.75,Default,,0,0,0,,Қарияның белін берік ұстау үшін күрес.
Dialogue: 0,0:02:10.83,0:02:13.13,Default,,0,0,0,,Ал, сенің жеңетініңе сенімдімін.
Dialogue: 0,0:02:13.21,0:02:15.76,Default,,0,0,0,,Оны осылай аяқтау керек пе?
Dialogue: 0,0:02:18.34,0:02:21.76,Default,,0,0,0,,Тек алаңдағы басқалардан жылдам жүгіріңіз.
Dialogue: 0,0:02:22.51,0:02:24.51,Default,,0,0,0,,Басқалардан көбірек жүгір!
Dialogue: 0,0:02:29.10,0:02:30.69,Default,,0,0,0,,Уф (Кайто) Не!
Dialogue: 0,0:02:30.77,0:02:31.60,Default,,0,0,0,,Не!
Dialogue: 0,0:02:35.19,0:02:36.86,Default,,0,0,0,,Егер солай болса, Мелло Нианы айналып өтіп, дәптерді қолға түсіру үшін барын салған болар еді
Dialogue: 0,0:02:37.57,0:02:41.16,Default,,0,0,0,,Ой, старттан кейін №17 Сейсекидің қызу басуы
Dialogue: 0,0:02:41.24,0:02:43.62,Default,,0,0,0,,Мен кенет басынан аттап кеттім.
Dialogue: 0,0:02:43.70,0:02:45.58,Default,,0,0,0,,Міне, жылқы құйрығы
Dialogue: 0,0:02:45.66,0:02:48.58,Default,,0,0,0,,Эмото! Эмото!
Dialogue: 0,0:02:48.66,0:02:51.58,Default,,0,0,0,,Эмото! Эмото!
Dialogue: 0,0:02:52.21,0:02:54.59,Default,,0,0,0,,Эмото! Эмото!
Dialogue: 0,0:02:55.46,0:02:56.63,Default,,0,0,0,,Қолдану~
Dialogue: 0,0:02:57.38,0:02:59.38,Default,,0,0,0,,Доп мүлде айналмайды!
Dialogue: 0,0:02:59.47,0:03:03.01,Default,,0,0,0,,Екінші таймның 3-минутында Туен алға жылжуда қиналып жатыр.
Dialogue: 0,0:03:03.09,0:03:05.31,Default,,0,0,0,,Жақсы, егер алдыңғы шеп қолынан келгенін жасаса.
Dialogue: 0,0:03:05.39,0:03:06.89,Default,,0,0,0,,Командаңызға қуат беріңіз
Dialogue: 0,0:03:06.97,0:03:09.68,Default,,0,0,0,,Біз де оның қасіретін көрдік.
Dialogue: 0,0:03:09.77,0:03:11.39,Default,,0,0,0,,Қазірдің өзінде көңіл-күй жасаушы ретінде――
Dialogue: 0,0:03:11.48,0:03:13.40,Default,,0,0,0,,Болу мәні жеткілікті
Dialogue: 0,0:03:15.36,0:03:17.32,Default,,0,0,0,,Сәлем! (Ура) Жарайды!
Dialogue: 0,0:03:17.40,0:03:19.57,Default,,0,0,0,,Иә! Ура! (Ура) А-а...
Dialogue: 0,0:03:19.65,0:03:21.32,Default,,0,0,0,,(Доптың соғу дыбысы)
Dialogue: 0,0:03:26.16,0:03:29.95,Default,,0,0,0,,Мынау... доп тікелей Кайтоның жамбасына тиді...?
Dialogue: 0,0:03:30.04,0:03:33.33,Default,,0,0,0,,Меніңше... Мен жаңа ғана тарсылдаған дыбысты естідім.
Dialogue: 0,0:03:33.42,0:03:36.00,Default,,0,0,0,,Амансың ба? Төреші сізді тексеріп жатыр...
Dialogue: 0,0:03:37.13,0:03:38.59,Default,,0,0,0,,О, жоқ.
Dialogue: 0,0:03:39.17,0:03:40.30,Default,,0,0,0,,Уау! (Тікелей эфир) Иә?
Dialogue: 0,0:03:40.38,0:03:41.76,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:03:41.84,0:03:43.34,Default,,0,0,0,,Тек ностальгия соншалықты күшті болды,
Dialogue: 0,0:03:43.43,0:03:44.97,Default,,0,0,0,,Ойын қайта басталатын сияқты
Dialogue: 0,0:03:45.05,0:03:47.51,Default,,0,0,0,,Тоин үшін жаттығу әдісі әртүрлі.
Dialogue: 0,0:03:47.60,0:03:50.64,Default,,0,0,0,,Бұл соншалықты ақымақ... А-а, бұл ауыратын сияқты.
Dialogue: 0,0:03:50.73,0:03:51.60,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:03:51.68,0:03:54.35,Default,,0,0,0,,Кайто-сан ең жақсы~
Dialogue: 0,0:03:54.44,0:03:57.27,Default,,0,0,0,,Ей, себепсіз төмен түспе!
Dialogue: 0,0:03:57.36,0:03:58.86,Default,,0,0,0,,Жұмысыңды дұрыс атқар!
Dialogue: 0,0:03:58.94,0:04:00.78,Default,,0,0,0,,Иә, иә, түсіндім.
Dialogue: 0,0:04:00.86,0:04:02.11,Default,,0,0,0,,Сізге тек бір рет жауап беру керек!
Dialogue: 0,0:04:02.82,0:04:04.41,Default,,0,0,0,,Олай болса, теңізді көздеп алайық
Dialogue: 0,0:04:04.49,0:04:07.12,Default,,0,0,0,,Түсіндім, сәл дөрекі болса, қарсы емеспін.
Dialogue: 0,0:04:07.20,0:04:10.87,Default,,0,0,0,,Кайто жау лагерінің тереңінде орналасады.
Dialogue: 0,0:04:10.95,0:04:13.41,Default,,0,0,0,,Мен Усуй-кунға баруға батылым бар...
Dialogue: 0,0:04:14.00,0:04:16.29,Default,,0,0,0,,Маған мықты жігіттер ұнайды.
Dialogue: 0,0:04:16.38,0:04:17.38,Default,,0,0,0,,Бұл (Каито) фу
Dialogue: 0,0:04:17.46,0:04:20.00,Default,,0,0,0,,Допты Сейсеки Тоинға қайтару
Dialogue: 0,0:04:20.67,0:04:24.30,Default,,0,0,0,,Міне, мен қайта жинағым келеді. Ой, Уваджима, тоқта!
Dialogue: 0,0:04:24.38,0:04:25.64,Default,,0,0,0,,Құлап жатқан доп - Тоин
Dialogue: 0,0:04:25.72,0:04:27.39,Default,,0,0,0,,Сіз оны мұқият оқып шығыңыз.
Dialogue: 0,0:04:27.47,0:04:31.14,Default,,0,0,0,,Енді қалай шабуыл жасауымыз керек? Тоин, Кайто алдыңғы қатарда.
Dialogue: 0,0:04:35.48,0:04:36.90,Default,,0,0,0,,Уф (тірі) Тоин Алға қарай бер
Dialogue: 0,0:04:36.98,0:04:37.90,Default,,0,0,0,,Кайтоның ұзақ пасы
Dialogue: 0,0:04:37.98,0:04:39.65,Default,,0,0,0,,Аа, қысқа болыңыз.
Dialogue: 0,0:04:40.98,0:04:42.15,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:43.74,0:04:45.66,Default,,0,0,0,,Бұл тәтті (Каито) Хэ.
Dialogue: 0,0:04:46.53,0:04:48.32,Default,,0,0,0,,Мен оны бір рет төмендетемін. Кайто (Хошина) Уф.
Dialogue: 0,0:04:48.41,0:04:49.58,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:04:49.66,0:04:51.08,Default,,0,0,0,,Үлкен тұзақ күтімі (Усуи) Ах.
Dialogue: 0,0:04:51.16,0:04:53.08,Default,,0,0,0,,Бұл жолы оң жақтан
Dialogue: 0,0:04:53.16,0:04:54.08,Default,,0,0,0,,Тоинға қалай шабуыл жасау керек
Dialogue: 0,0:04:54.16,0:04:55.46,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:56.42,0:04:58.96,Default,,0,0,0,,Белгілерді жою қозғалысы баяулаған жоқ.
Dialogue: 0,0:04:59.54,0:05:00.46,Default,,0,0,0,,Жақсы пас
Dialogue: 0,0:05:00.55,0:05:02.46,Default,,0,0,0,,Жарайды, сіз бұған жете алмайсыз.
Dialogue: 0,0:05:03.72,0:05:04.97,Default,,0,0,0,,Бұл жақсы жел
Dialogue: 0,0:05:07.59,0:05:09.47,Default,,0,0,0,,ше? Түсірілім курсы толығымен...
Dialogue: 0,0:05:10.56,0:05:11.81,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:17.15,0:05:18.35,Default,,0,0,0,,Енгізілді
Dialogue: 0,0:05:22.23,0:05:24.61,Default,,0,0,0,,Барда! Масқара!
Dialogue: 0,0:05:22.23,0:05:24.61,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:05:24.61,0:05:24.69,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:05:24.69,0:05:26.57,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:05:24.69,0:05:26.57,Default,,0,0,0,,Кайтоның керемет түсірілімі!
Dialogue: 0,0:05:26.57,0:05:26.65,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:05:26.65,0:05:29.16,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:05:26.65,0:05:29.16,Default,,0,0,0,,Жерге тиетін керемет ілмек!
Dialogue: 0,0:05:30.03,0:05:31.66,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:05:31.74,0:05:33.70,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:05:33.79,0:05:36.25,Default,,0,0,0,,Бірінші қақпан - сол аяқ
Dialogue: 0,0:05:36.33,0:05:39.67,Default,,0,0,0,,Ағымдағы тіке волейбол оң аяқпен... ақымақ.
Dialogue: 0,0:05:39.75,0:05:41.67,Default,,0,0,0,,Бұл бұрынғыдай нашар.
Dialogue: 0,0:05:41.75,0:05:44.42,Default,,0,0,0,,Асықпаңыз, шабуылға асықпаңыз!
Dialogue: 0,0:05:45.05,0:05:47.18,Default,,0,0,0,,Бұл жерде сіз тынышталғыңыз келетін шығар.
Dialogue: 0,0:05:48.38,0:05:49.64,Default,,0,0,0,,Kurusu! (Усуи) Келе жатыр!
Dialogue: 0,0:05:50.22,0:05:51.26,Default,,0,0,0,,Не?
Dialogue: 0,0:05:51.35,0:05:54.97,Default,,0,0,0,,Бірінші тайм сияқты, мен жоғары басыңызды қолдандым. Тоин
Dialogue: 0,0:05:55.06,0:05:59.15,Default,,0,0,0,,Бұл ортаңғы қорғанысты кесіп тастау және алдыңғы шептің кез келген жұмысты орындауына жол бермеу стратегиясы.
Dialogue: 0,0:05:59.23,0:06:00.48,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:06:01.15,0:06:01.98,Default,,0,0,0,,Ух (Курусу) Ах.
Dialogue: 0,0:06:02.07,0:06:04.32,Default,,0,0,0,,Қарғыс атсын, мен тіпті алға қарай да алмаймын.
Dialogue: 0,0:06:04.40,0:06:05.61,Default,,0,0,0,,Бір жыл, солай ма?
Dialogue: 0,0:06:06.32,0:06:07.99,Default,,0,0,0,,Допты бөлу және баяу пайымдау
Dialogue: 0,0:06:08.57,0:06:09.61,Default,,0,0,0,,Құт
Dialogue: 0,0:06:10.70,0:06:12.37,Default,,0,0,0,,Казама…
Dialogue: 0,0:06:13.62,0:06:14.87,Default,,0,0,0,,Қасиетті ғибадатхана ортасында-
Dialogue: 0,0:06:14.95,0:06:16.29,Default,,0,0,0,,Допты ұстау...
Dialogue: 0,0:06:16.37,0:06:18.87,Default,,0,0,0,,Маған сол әсер қалдырыңызшы, өтінемін.
Dialogue: 0,0:06:19.87,0:06:22.38,Default,,0,0,0,,Екінші жартысы сіз туралы.
Dialogue: 0,0:06:22.46,0:06:25.09,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:06:25.17,0:06:28.59,Default,,0,0,0,,Хошина Туиннен допты лақтырды.
Dialogue: 0,0:06:28.67,0:06:30.09,Default,,0,0,0,,Қасиетті Қасиетті Айқын!
Dialogue: 0,0:06:30.18,0:06:32.60,Default,,0,0,0,,Кайто допты тура бағыттады
Dialogue: 0,0:06:32.68,0:06:34.10,Default,,0,0,0,,Бұл...!
Dialogue: 0,0:06:34.68,0:06:36.31,Default,,0,0,0,,Өкінішке орай көлденең жолақ
Dialogue: 0,0:06:36.43,0:06:38.60,Default,,0,0,0,,Екінші доп Сейсеки Мизукиге берілді
Dialogue: 0,0:06:39.19,0:06:41.81,Default,,0,0,0,,Ой, мен Тойнды көбірек басамын.
Dialogue: 0,0:06:41.90,0:06:44.44,Default,,0,0,0,,Жақсы, ешкім әлсіреп жатқан жоқ.
Dialogue: 0,0:06:44.52,0:06:46.61,Default,,0,0,0,,Бұл киелі киелі жер қысымы.
Dialogue: 0,0:06:46.69,0:06:50.11,Default,,0,0,0,,Жақсы, жүр, жүр! Допты жеңілдетпеңіз!
Dialogue: 0,0:06:50.20,0:06:52.57,Default,,0,0,0,,Мизукиге жақсылап қараңыз!
Dialogue: 0,0:06:52.66,0:06:53.49,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:06:53.57,0:06:56.91,Default,,0,0,0,,Мына жігіт кіргенде мүйізтұмсық тіріледі.
Dialogue: 0,0:06:56.99,0:06:58.83,Default,,0,0,0,,Ішек... Тағы да ішегі
Dialogue: 0,0:06:59.58,0:07:00.41,Default,,0,0,0,,Курусты қайтарыңыз!
Dialogue: 0,0:07:00.50,0:07:02.21,Default,,0,0,0,,Боқ (Сато) Курусу!
Dialogue: 0,0:07:02.29,0:07:04.75,Default,,0,0,0,,Сейсеки Курусу дриблингтік серпіліс?
Dialogue: 0,0:07:04.84,0:07:06.42,Default,,0,0,0,,Жоқ, мен де рұқсат бермеймін.
Dialogue: 0,0:07:06.50,0:07:07.92,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:07:08.01,0:07:09.17,Default,,0,0,0,,Шығар, Курусу!
Dialogue: 0,0:07:09.26,0:07:11.43,Default,,0,0,0,,Курусу-кун? (Мәртебелі) Ақымақ
Dialogue: 0,0:07:11.51,0:07:13.47,Default,,0,0,0,,Kurusu сақтауды жалғастырыңыз
Dialogue: 0,0:07:13.55,0:07:16.43,Default,,0,0,0,,Жоқ, егер ол алынса, бұл қауіпті позиция.
Dialogue: 0,0:07:17.39,0:07:19.85,Default,,0,0,0,,Бұл мүмкін емес, Қазаманың ақымақтығы!
Dialogue: 0,0:07:19.93,0:07:20.77,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:07:20.85,0:07:24.02,Default,,0,0,0,,Сіз мұны істей аласыз. Бұл бар болғаны 10 секундты алады.
Dialogue: 0,0:07:24.11,0:07:28.73,Default,,0,0,0,,Егер сіз оны 10 секунд ұстай алсаңыз, Кимишита-кун міндетті түрде бос болады.
Dialogue: 0,0:07:28.82,0:07:31.03,Default,,0,0,0,,Қарғыс атсын... Өтінемін!
Dialogue: 0,0:07:31.82,0:07:32.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:32.91,0:07:33.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:35.78,0:07:36.70,Default,,0,0,0,,Барлығы жақсы болады, иә?
Dialogue: 0,0:07:36.78,0:07:39.20,Default,,0,0,0,,Бұл киелі жер, мінсіз санау!
Dialogue: 0,0:07:39.29,0:07:40.71,Default,,0,0,0,,Бом!
Dialogue: 0,0:07:41.58,0:07:43.46,Default,,0,0,0,,Сіз мұнда былтыр уәде бергенсіз.
Dialogue: 0,0:07:44.33,0:07:46.84,Default,,0,0,0,,Келесі жылы мен сенімен бірге шыңды алып барамын.
Dialogue: 0,0:07:46.92,0:07:48.71,Default,,0,0,0,,Оны өлтір!
Dialogue: 0,0:07:49.42,0:07:51.22,Default,,0,0,0,,Бұл қате болды
Dialogue: 0,0:07:53.47,0:07:54.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:54.22,0:07:54.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:54.22,0:07:54.80,Default,,0,0,0,,Сакрамент Бірге біз оны орындай аламыз!
Dialogue: 0,0:07:54.80,0:07:56.76,Default,,0,0,0,,Сакрамент Бірге, біз оны орындай аламыз!
Dialogue: 0,0:07:57.72,0:07:59.27,Default,,0,0,0,,Emoto толығымен тегін!
Dialogue: 0,0:07:59.93,0:08:01.02,Default,,0,0,0,,Шешім
Dialogue: 0,0:08:01.10,0:08:02.27,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:08:02.35,0:08:03.27,Default,,0,0,0,,Atomu!
Dialogue: 0,0:08:03.35,0:08:04.27,Default,,0,0,0,,Ято өледі
Dialogue: 0,0:08:04.35,0:08:05.52,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:08:05.61,0:08:07.06,Default,,0,0,0,,Ағымдағы жағдайдың алдын алу?
Dialogue: 0,0:08:08.77,0:08:09.73,Default,,0,0,0,,Цк (Хошина) Уф
Dialogue: 0,0:08:09.82,0:08:11.32,Default,,0,0,0,,Міне, менің уақытым келді!
Dialogue: 0,0:08:11.40,0:08:12.32,Default,,0,0,0,,Мені ұрмаңыз!
Dialogue: 0,0:08:12.40,0:08:15.16,Default,,0,0,0,,Иә, данышпан!
Dialogue: 0,0:08:15.24,0:08:17.16,Default,,0,0,0,,Қозаке! Уф...
Dialogue: 0,0:08:17.24,0:08:18.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:18.95,0:08:20.12,Default,,0,0,0,,Керемет, Ура!
Dialogue: 0,0:08:21.29,0:08:22.37,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:08:22.46,0:08:23.37,Default,,0,0,0,,Не?
Dialogue: 0,0:08:24.96,0:08:29.38,Default,,0,0,0,,Сейсеки тәуекелге барғандықтан маған келген мүмкіндік болды, бірақ...
Dialogue: 0,0:08:29.46,0:08:32.38,Default,,0,0,0,,Адамның бұл мүмкіндікті жіберіп алуы мүмкін емес.
Dialogue: 0,0:08:32.47,0:08:34.38,Default,,0,0,0,,Доп Кайтоға барады (Комментатор) Жақсы пас
Dialogue: 0,0:08:34.47,0:08:35.89,Default,,0,0,0,,Жай ғана дриблинг...
Dialogue: 0,0:08:37.97,0:08:40.14,Default,,0,0,0,,Иә? (Усуи) Түсінікті! Ах
Dialogue: 0,0:08:42.73,0:08:45.39,Default,,0,0,0,,Нақты шешім қабылда, Кайто Таку!
Dialogue: 0,0:08:45.48,0:08:46.40,Default,,0,0,0,,Бұған жол берме!
Dialogue: 0,0:09:00.74,0:09:03.66,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:09:03.75,0:09:05.67,Default,,0,0,0,,Тоин! Тоин! Тоин!
Dialogue: 0,0:09:05.75,0:09:07.54,Default,,0,0,0,,Toin Preemptive!
Dialogue: 0,0:09:07.63,0:09:10.25,Default,,0,0,0,,Хошина Кайтоның төгілген допын толтырды!
Dialogue: 0,0:09:10.34,0:09:12.34,Default,,0,0,0,,Ұпай болмаған 54 минуттан кейін -
Dialogue: 0,0:09:12.42,0:09:14.92,Default,,0,0,0,,Капитанның өзі қақпаны жарып жіберді!
Dialogue: 0,0:09:15.01,0:09:17.13,Default,,0,0,0,,Он бірінші қасиетті орын
Dialogue: 0,0:09:17.22,0:09:19.68,Default,,0,0,0,,Бұл тамаша кадр болды.
Dialogue: 0,0:09:19.76,0:09:22.35,Default,,0,0,0,,Жарайды, келесі... не?
Dialogue: 0,0:09:22.43,0:09:23.68,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:09:23.77,0:09:25.35,Default,,0,0,0,,Мен тағы бір ұпай аламын!
Dialogue: 0,0:09:25.43,0:09:27.06,Default,,0,0,0,,Наиш!
Dialogue: 0,0:09:25.43,0:09:27.06,Default,,0,0,0,,(Шығыс үйінің мүшелерінің құттықтауы)
Dialogue: 0,0:09:27.06,0:09:27.14,Default,,0,0,0,,(Шығыс үйінің мүшелерінің қошеметі)
Dialogue: 0,0:09:27.14,0:09:28.15,Default,,0,0,0,,(Шығыс үйінің мүшелерінің құттықтауы)
Dialogue: 0,0:09:27.14,0:09:28.15,Default,,0,0,0,,Капитан!
Dialogue: 0,0:09:28.15,0:09:28.23,Default,,0,0,0,,(Шығыс үйінің мүшелерінің құттықтауы)
Dialogue: 0,0:09:28.23,0:09:29.61,Default,,0,0,0,,(Шығыс үйінің мүшелерінің қошеметі)
Dialogue: 0,0:09:28.23,0:09:29.61,Default,,0,0,0,,Таку!
Dialogue: 0,0:09:29.61,0:09:29.69,Default,,0,0,0,,(Шығыс үйінің мүшелерінің қошеметі)
Dialogue: 0,0:09:29.69,0:09:30.69,Default,,0,0,0,,(Шығыс үйінің мүшелерінің құттықтауы)
Dialogue: 0,0:09:30.77,0:09:32.61,Default,,0,0,0,,Тез оралыңыз!
Dialogue: 0,0:09:32.69,0:09:34.24,Default,,0,0,0,,Артқа оралып, қайта іске қосыңыз!
Dialogue: 0,0:09:34.32,0:09:36.65,Default,,0,0,0,,Егер сіз осындай карта алсаңыз, сіз ақымақсыз.
Dialogue: 0,0:09:36.74,0:09:40.03,Default,,0,0,0,,Сізді қуанғанды ​​көру барлығын да қуантады.
Dialogue: 0,0:09:40.12,0:09:43.70,Default,,0,0,0,,Бірдеңе... (Каито) Бұл қажет емес пе...?
Dialogue: 0,0:09:47.92,0:09:48.75,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:48.83,0:09:51.13,Default,,0,0,0,,(Шығыс үйінің мүшелерінің құттықтауы)
Dialogue: 0,0:09:51.21,0:09:53.88,Default,,0,0,0,,Бұл бұрынғыдай пьеса, проблема жоқ.
Dialogue: 0,0:09:53.96,0:09:55.09,Default,,0,0,0,,Ол көздің үстінде.
Dialogue: 0,0:09:55.17,0:09:56.51,Default,,0,0,0,,Мен кейінірек қан құюға барамын.
Dialogue: 0,0:09:56.59,0:09:58.09,Default,,0,0,0,,Сыртқа шығып, қанды тоқтатыңыз!
Dialogue: 0,0:09:59.43,0:10:00.76,Default,,0,0,0,,Сіз оны алмастыра алмайсыз
Dialogue: 0,0:10:02.43,0:10:05.06,Default,,0,0,0,,Оны Убукатаға қалдырудан басқа амалым жоқ.
Dialogue: 0,0:10:05.14,0:10:07.02,Default,,0,0,0,,Өтінемін, мен тезірек оралғым келеді.
Dialogue: 0,0:10:07.10,0:10:08.60,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:10:10.48,0:10:11.90,Default,,0,0,0,,Капитан (Мидзуки) иә?
Dialogue: 0,0:10:11.98,0:10:15.99,Default,,0,0,0,,Бірінші таймда Хошинамен жеке-жеке, ол біріншіні тоқтата алса да.
Dialogue: 0,0:10:16.07,0:10:18.36,Default,,0,0,0,,Екіншісін неге өткізіп алғанымды білесің бе?
Dialogue: 0,0:10:20.11,0:10:22.12,Default,,0,0,0,,Түсіндім, әрине, жанып кеттім.
Dialogue: 0,0:10:22.20,0:10:24.87,Default,,0,0,0,,Жоқ, бұл нақтырақ.
Dialogue: 0,0:10:24.95,0:10:26.29,Default,,0,0,0,,Гарн…
Dialogue: 0,0:10:26.37,0:10:28.37,Default,,0,0,0,,Жарайды, мұқият тыңдаңыз.
Dialogue: 0,0:10:28.46,0:10:30.88,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:10:30.96,0:10:32.88,Default,,0,0,0,,Тоин! Тоин! Тоин!
Dialogue: 0,0:10:32.96,0:10:34.88,Default,,0,0,0,,Сакрамент! Қасиетті ғибадатхана!
Dialogue: 0,0:10:35.50,0:10:37.51,Default,,0,0,0,,Бұл қарапайым ма?
Dialogue: 0,0:10:37.59,0:10:39.59,Default,,0,0,0,,Мен де енді ғана білдім.
Dialogue: 0,0:10:39.68,0:10:41.59,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:10:42.55,0:10:44.81,Default,,0,0,0,,Соңы Ол тоқтады.
Dialogue: 0,0:10:44.89,0:10:46.02,Default,,0,0,0,,Мен бұған шыдай алмаймын
Dialogue: 0,0:10:46.10,0:10:47.98,Default,,0,0,0,,А... анау капитан!
Dialogue: 0,0:10:48.06,0:10:49.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:49.85,0:10:51.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:52.65,0:10:55.11,Default,,0,0,0,,Біз бәріміз сізге сенеміз.
Dialogue: 0,0:10:56.07,0:10:57.44,Default,,0,0,0,,Иә
Dialogue: 0,0:10:57.53,0:10:59.03,Default,,0,0,0,,Өзіңізді балшық қайықта жүргендей сезінесіз
Dialogue: 0,0:10:59.11,0:11:00.11,Default,,0,0,0,,Ол батып бара жатыр!
Dialogue: 0,0:11:00.20,0:11:02.87,Default,,0,0,0,,Мизуки! Мизуки!
Dialogue: 0,0:11:04.49,0:11:07.87,Default,,0,0,0,,Мизуки Марк Хошина алаңға оралды
Dialogue: 0,0:11:07.95,0:11:09.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:09.58,0:11:12.38,Default,,0,0,0,,Жарайды, бірінші мен екіншісінің айырмашылығы.
Dialogue: 0,0:11:12.46,0:11:17.13,Default,,0,0,0,,Біріншіні оңға шығарып, сол аяқты бірге жылжытыңыз.
Dialogue: 0,0:11:17.21,0:11:20.63,Default,,0,0,0,,Позицияңызды реттегеннен кейін оны ішкі оң жақпен жылдам өткізіңіз.
Dialogue: 0,0:11:20.72,0:11:22.84,Default,,0,0,0,,Бұл тоқтатылды
Dialogue: 0,0:11:22.93,0:11:27.43,Default,,0,0,0,,Екінші жағынан, сол жақтың ішкі жағында, тартады және қосарланады.
Dialogue: 0,0:11:27.52,0:11:29.60,Default,,0,0,0,,Ішкі оң жақта алға қарай жылжу.
Dialogue: 0,0:11:29.68,0:11:30.48,Default,,0,0,0,,Сол жақ оң сол оң оң сол…
Dialogue: 0,0:11:30.48,0:11:33.60,Default,,0,0,0,,Сол жақ оң сол оң оң сол…
Dialogue: 0,0:11:30.48,0:11:33.60,Default,,0,0,0,,Ол осылайша жылдамырақ қозғалуы керек.
Dialogue: 0,0:11:33.69,0:11:34.61,Default,,0,0,0,,(Танжиро) Уф… (Барабан соғу дыбысы)
Dialogue: 0,0:11:36.11,0:11:38.11,Default,,0,0,0,,Ах... уф
Dialogue: 0,0:11:38.19,0:11:40.61,Default,,0,0,0,,Мен оны шығарып алдым! Хошинаны артта қалдырыңыз!
Dialogue: 0,0:11:40.69,0:11:41.61,Default,,0,0,0,,Міне!
Dialogue: 0,0:11:43.20,0:11:44.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:44.70,0:11:48.37,Default,,0,0,0,,Мизукидің алыстан соққысы! Бірақ бұл қорғаушының алдыңғы жағы ма?
Dialogue: 0,0:11:48.45,0:11:50.79,Default,,0,0,0,,Adomu Егер сіз оны алсаңыз, бұл есептегіш!
Dialogue: 0,0:11:50.87,0:11:52.12,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:11:53.46,0:11:54.71,Default,,0,0,0,,Ах
Dialogue: 0,0:11:55.75,0:11:57.50,Default,,0,0,0,,Иә! (Кайто) Айналу жоқ!
Dialogue: 0,0:11:57.59,0:11:59.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:00.38,0:12:01.63,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:12:01.72,0:12:05.14,Default,,0,0,0,,Бұл дағдарысты мен тудырдым.
Dialogue: 0,0:12:05.22,0:12:05.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:05.72,0:12:08.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:05.72,0:12:08.64,Default,,0,0,0,,Оны денеңіздің кез келген жеріне соғуға болады!
Dialogue: 0,0:12:08.64,0:12:09.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:09.35,0:12:10.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:09.35,0:12:10.64,Default,,0,0,0,,Эмото?
Dialogue: 0,0:12:19.36,0:12:22.65,Default,,0,0,0,,Доп... Иә? Ха!
Dialogue: 0,0:12:26.24,0:12:27.16,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:12:27.24,0:12:28.74,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:12:28.83,0:12:32.41,Default,,0,0,0,,Екінші таймның 21-минутында Эмото голы ақыры есепті теңестірді.
Dialogue: 0,0:12:32.50,0:12:34.17,Default,,0,0,0,,Сіз оны жақсы жинадыңыз!
Dialogue: 0,0:12:34.25,0:12:36.13,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:12:36.21,0:12:37.17,Default,,0,0,0,,Бұл тым көп!
Dialogue: 0,0:12:37.84,0:12:40.67,Default,,0,0,0,,Мен де барлығына пайдалы болдым...
Dialogue: 0,0:12:41.34,0:12:42.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:42.84,0:12:43.97,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:12:44.05,0:12:46.47,Default,,0,0,0,,Менің қорғаушының тартымдылығын көрдіңіз бе?
Dialogue: 0,0:12:46.55,0:12:48.26,Default,,0,0,0,,Галстук туралы тым көп әбігер бар.
Dialogue: 0,0:12:48.35,0:12:49.18,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:12:49.85,0:12:52.18,Default,,0,0,0,,Жоқ, бұл офсайд!
Dialogue: 0,0:12:52.27,0:12:54.19,Default,,0,0,0,,Оффсайд жалаушасы көтерілді
Dialogue: 0,0:12:54.27,0:12:55.69,Default,,0,0,0,,Бұл мақсат емес
Dialogue: 0,0:12:55.77,0:12:56.73,Default,,0,0,0,,Не...
Dialogue: 0,0:12:56.81,0:12:59.69,Default,,0,0,0,,А...жоқ...жақта?
Dialogue: 0,0:12:59.77,0:13:01.03,Default,,0,0,0,,Ура.
Dialogue: 0,0:13:01.57,0:13:05.03,Default,,0,0,0,,Менің ойымша, олар Мизукидің өту мүмкіндігі туралы ойлады.
Dialogue: 0,0:13:05.11,0:13:06.07,Default,,0,0,0,,Сіз тепкен сәтте—
Dialogue: 0,0:13:06.16,0:13:08.74,Default,,0,0,0,,Ол Эмотодан жарты қадам артта қалды.
Dialogue: 0,0:13:10.53,0:13:13.16,Default,,0,0,0,,Уайымдамаңыз, ауыстырыңыз! Ауыстыру!
Dialogue: 0,0:13:13.25,0:13:17.17,Default,,0,0,0,,Білемін, басыңды төмен түсіре алмайсың.
Dialogue: 0,0:13:17.25,0:13:20.88,Default,,0,0,0,,Мен білемін, бірақ...
Dialogue: 0,0:13:21.92,0:13:23.76,Default,,0,0,0,,Төменге қарама, Цукуси
Dialogue: 0,0:13:23.84,0:13:24.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:24.76,0:13:25.42,Default,,0,0,0,,19 минут қалды 0-1
Dialogue: 0,0:13:25.42,0:13:28.64,Default,,0,0,0,,19 минут қалды 0-1
Dialogue: 0,0:13:25.42,0:13:28.64,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:13:28.64,0:13:28.72,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:13:28.72,0:13:31.51,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:13:28.72,0:13:31.51,Default,,0,0,0,,Бұл чемпионға қарсы өте қиын жағдай.
Dialogue: 0,0:13:33.27,0:13:35.94,Default,,0,0,0,,Бұл қайтып келу үшін тамаша кезең!
Dialogue: 0,0:13:46.03,0:13:48.53,Default,,0,0,0,,Бұл жерде қасиетті рәсім ойыншыларды ауыстыру сияқты.
Dialogue: 0,0:13:48.61,0:13:50.20,Default,,0,0,0,,No 15 Курусу орнына -
Dialogue: 0,0:13:50.28,0:13:53.08,Default,,0,0,0,,№ 9 Казама енгізу (Курусу) Нашар Мен ештеңе істей алмадым.
Dialogue: 0,0:13:53.16,0:13:54.75,Default,,0,0,0,,Курусу (Крусу) А?
Dialogue: 0,0:13:54.83,0:13:56.33,Default,,0,0,0,,Сен жақсы жұмыс жасадың.
Dialogue: 0,0:13:56.41,0:13:59.25,Default,,0,0,0,,Форвардтарды қалдырып, шабуылға назар аударыңыз.
Dialogue: 0,0:13:59.33,0:14:01.79,Default,,0,0,0,,20 минут қалды, қарсы шабуыл болады ма?
Dialogue: 0,0:14:01.88,0:14:02.71,Default,,0,0,0,,Казама-кун
Dialogue: 0,0:14:03.50,0:14:06.76,Default,,0,0,0,,Цукуси, доп келгенде, оны дереу қайтарыңыз.
Dialogue: 0,0:14:06.84,0:14:08.09,Default,,0,0,0,,Мен міндетті түрде шешемін
Dialogue: 0,0:14:08.76,0:14:10.97,Default,,0,0,0,,Өйткені, Казама-кун сенімді.
Dialogue: 0,0:14:11.05,0:14:14.35,Default,,0,0,0,,Кел, киелі жер! Бірінші ұпай! Дұрыстап қайтарайық
Dialogue: 0,0:14:16.64,0:14:17.98,Default,,0,0,0,,Қайтадан шықты ма?
Dialogue: 0,0:14:18.06,0:14:20.86,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:14:20.94,0:14:24.36,Default,,0,0,0,,Мен бастаманы қолға алсам да, мен енжар ​​болмаймын.
Dialogue: 0,0:14:24.44,0:14:26.36,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:14:26.44,0:14:30.24,Default,,0,0,0,,Ауыстырушы Казама допты тынымсыз қуады
Dialogue: 0,0:14:30.32,0:14:31.45,Default,,0,0,0,,Атомуды қайтарыңыз!
Dialogue: 0,0:14:31.53,0:14:32.95,Default,,0,0,0,,Таку мырза! Уф
Dialogue: 0,0:14:33.03,0:14:34.45,Default,,0,0,0,,(Допты қабылдау дыбысы)
Dialogue: 0,0:14:34.54,0:14:36.45,Default,,0,0,0,,Хмм... (тікелей эфир) Мен оны тез жинаймын!
Dialogue: 0,0:14:36.54,0:14:39.96,Default,,0,0,0,,Сейсеки Казама Майданнан қызу қуу
Dialogue: 0,0:14:40.04,0:14:43.71,Default,,0,0,0,,Бұл дәмді! Мен соқыр ілесіп жүрген сияқтымын
Dialogue: 0,0:14:43.79,0:14:46.21,Default,,0,0,0,,Шындығында, біз ең көп адам жинағанға қарай ұмтыламыз.
Dialogue: 0,0:14:46.30,0:14:47.72,Default,,0,0,0,,Уф (Казама) Керемет, Цукуси!
Dialogue: 0,0:14:47.80,0:14:49.76,Default,,0,0,0,,Уф... (Хошина) Орталықтандыру!
Dialogue: 0,0:14:49.84,0:14:50.72,Default,,0,0,0,,Оны сол жақпен көтеріңіз!
Dialogue: 0,0:14:50.80,0:14:52.22,Default,,0,0,0,,Жалама, балақай!
Dialogue: 0,0:14:53.55,0:14:55.06,Default,,0,0,0,,Kazama Centering!
Dialogue: 0,0:14:55.14,0:14:56.47,Default,,0,0,0,,Бұл Лабона.
Dialogue: 0,0:14:59.56,0:15:00.48,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:00.56,0:15:02.48,Default,,0,0,0,,Ах~
Dialogue: 0,0:15:02.56,0:15:03.98,Default,,0,0,0,,Капитан!
Dialogue: 0,0:15:04.06,0:15:06.73,Default,,0,0,0,,Кешіріңіз, бұл қылмыс менің бүкіл өмірімді алады.
Dialogue: 0,0:15:06.82,0:15:08.99,Default,,0,0,0,,Өтірік өтірік Ол сізге жетеді. Олай болса да.
Dialogue: 0,0:15:09.07,0:15:10.74,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:15:10.82,0:15:14.41,Default,,0,0,0,,Казаманың жігіті атмосфераны толығымен өзгертті.
Dialogue: 0,0:15:14.49,0:15:18.41,Default,,0,0,0,,Казама Сакура орта мектебінің Инудо және Наруками...
Dialogue: 0,0:15:18.50,0:15:20.41,Default,,0,0,0,,Сізде жоқ нәрсені білесіз бе?
Dialogue: 0,0:15:20.50,0:15:21.42,Default,,0,0,0,,Бет?
Dialogue: 0,0:15:21.50,0:15:22.92,Default,,0,0,0,,Шынайы.
Dialogue: 0,0:15:23.00,0:15:24.04,Default,,0,0,0,,Не?
Dialogue: 0,0:15:24.13,0:15:26.80,Default,,0,0,0,,Сол екі адам бір-біріне сенеді.
Dialogue: 0,0:15:26.88,0:15:29.21,Default,,0,0,0,,Мен ешкімге сенбеймін дейсің бе?
Dialogue: 0,0:15:29.30,0:15:31.68,Default,,0,0,0,,Мен бұлай айтқан жоқпын, мен...
Dialogue: 0,0:15:31.76,0:15:35.68,Default,,0,0,0,,Төтенше жағдайда достарыңызға көбірек сенім артқан дұрыс емес пе?
Dialogue: 0,0:15:37.77,0:15:41.19,Default,,0,0,0,,Мен саған кенеттен көрсетемін, Қазама: Импульс киелі ғибадатхана ма?
Dialogue: 0,0:15:41.27,0:15:44.69,Default,,0,0,0,,Алайда ортаңғы қорғаныс жетіспей, қорғаныс қиындай түсті.
Dialogue: 0,0:15:44.77,0:15:48.19,Default,,0,0,0,,Түсіндім, Кайтоға оңай өтуге болады.
Dialogue: 0,0:15:48.28,0:15:49.94,Default,,0,0,0,,Енді менің кезегім...
Dialogue: 0,0:15:50.03,0:15:52.20,Default,,0,0,0,,Хмм... өтірік пе?
Dialogue: 0,0:15:52.28,0:15:54.45,Default,,0,0,0,,Казама неге соншалықты төмен?
Dialogue: 0,0:15:55.28,0:15:56.28,Default,,0,0,0,,Сіз мұны істей аласыз, солай ма?
Dialogue: 0,0:15:56.37,0:15:58.95,Default,,0,0,0,,Бұл анық. Сенсеңіз, нәтиже аласыз.
Dialogue: 0,0:15:59.58,0:16:01.46,Default,,0,0,0,,Бұл Казама деген адам.
Dialogue: 0,0:16:02.29,0:16:06.46,Default,,0,0,0,,Соңында, бұл Тоинның мақсатты жіберіп алу үлгісін талдауға негізделген стратегия.
Dialogue: 0,0:16:06.54,0:16:07.96,Default,,0,0,0,,Шығар, Казама!
Dialogue: 0,0:16:08.05,0:16:08.96,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:16:09.55,0:16:13.30,Default,,0,0,0,,Сіз бұл операцияның орталығысыз, Казама.
Dialogue: 0,0:16:13.38,0:16:14.80,Default,,0,0,0,,Бір-екі сізбен бірге!
Dialogue: 0,0:16:14.89,0:16:17.30,Default,,0,0,0,,Дрибл келе жатыр! Тоқта!
Dialogue: 0,0:16:17.39,0:16:18.51,Default,,0,0,0,,Не?
Dialogue: 0,0:16:18.60,0:16:20.68,Default,,0,0,0,,Енді Ошибаға тік жол!
Dialogue: 0,0:16:21.52,0:16:22.94,Default,,0,0,0,,Керемет Кичман!
Dialogue: 0,0:16:23.02,0:16:24.23,Default,,0,0,0,,Бұл да тікелей ме?
Dialogue: 0,0:16:25.81,0:16:27.98,Default,,0,0,0,,Кел, жасанды кірпікші
Dialogue: 0,0:16:29.07,0:16:30.23,Default,,0,0,0,,Қайтадан өту керек пе?
Dialogue: 0,0:16:33.57,0:16:35.36,Default,,0,0,0,,Мизуки! (Исуруги) Кух!
Dialogue: 0,0:16:36.24,0:16:37.62,Default,,0,0,0,,Хамф (Исуруги) Сен секірдің бе?
Dialogue: 0,0:16:39.45,0:16:40.87,Default,,0,0,0,,Мақсат қоймаңыз ба?
Dialogue: 0,0:16:40.95,0:16:43.33,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:16:43.41,0:16:46.08,Default,,0,0,0,,Капитан, сіз кереметсіз.
Dialogue: 0,0:16:46.17,0:16:47.84,Default,,0,0,0,,Доп қайтадан Казамаға барады!
Dialogue: 0,0:16:47.92,0:16:49.84,Default,,0,0,0,,Мені ұрмаңыз! (Ура) Ах!
Dialogue: 0,0:16:49.92,0:16:50.84,Default,,0,0,0,,Эмото!
Dialogue: 0,0:16:53.42,0:16:57.09,Default,,0,0,0,,Доп келгенде, оны қайтарыңыз. Мен міндетті түрде шешемін.
Dialogue: 0,0:17:00.68,0:17:02.85,Default,,0,0,0,,100 ұпай Жылқы құйрығы!
Dialogue: 0,0:17:02.93,0:17:04.10,Default,,0,0,0,,Atomu
Dialogue: 0,0:17:05.98,0:17:08.11,Default,,0,0,0,,Не? реакция жасай алмайды
Dialogue: 0,0:17:08.19,0:17:10.61,Default,,0,0,0,,Мен қатты селт еттім (Маруока) Ах.
Dialogue: 0,0:17:10.69,0:17:14.11,Default,,0,0,0,,Казаманың мақсаты басынан Исуруги болатын.
Dialogue: 0,0:17:14.19,0:17:16.61,Default,,0,0,0,,Қасиетті жерге кіргеніме қуаныштымын.
Dialogue: 0,0:17:18.12,0:17:20.12,Default,,0,0,0,,Менің достарым бар!
Dialogue: 0,0:17:20.20,0:17:22.12,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:17:22.20,0:17:27.37,Default,,0,0,0,,Екінші таймның 34-минутында Казама алмастырылып, керемет теңестіруші болды!
Dialogue: 0,0:17:27.46,0:17:30.21,Default,,0,0,0,,Мен оны тура жолмен дерлік байланыстырдым.
Dialogue: 0,0:17:30.29,0:17:32.63,Default,,0,0,0,,Тоин ештеңе істей алмады.
Dialogue: 0,0:17:33.21,0:17:34.13,Default,,0,0,0,,Курусу (Крусу) Уф
Dialogue: 0,0:17:34.76,0:17:37.63,Default,,0,0,0,,Сіздің жұмысыңыз тура жолды іске қосты.
Dialogue: 0,0:17:37.72,0:17:39.89,Default,,0,0,0,,Уа, ау!
Dialogue: 0,0:17:39.97,0:17:41.14,Default,,0,0,0,,Уката
Dialogue: 0,0:17:41.22,0:17:43.64,Default,,0,0,0,,Е... Уф.
Dialogue: 0,0:17:43.72,0:17:48.19,Default,,0,0,0,,Ол жігіт менің қимыл-қозғалысымды толық оқып шықты.
Dialogue: 0,0:17:48.77,0:17:50.65,Default,,0,0,0,,Джин Казама
Dialogue: 0,0:17:50.73,0:17:52.65,Default,,0,0,0,,Хаябуса Кайто
Dialogue: 0,0:17:52.73,0:17:54.19,Default,,0,0,0,,Уау (Кайто) Хахаха
Dialogue: 0,0:17:54.28,0:17:56.57,Default,,0,0,0,,Галстук Оны дереу қайтарыңыз
Dialogue: 0,0:17:56.65,0:17:58.28,Default,,0,0,0,,Бұзбаңыз
Dialogue: 0,0:17:58.36,0:18:00.16,Default,,0,0,0,,Сіз патшалардың бірісіз
Dialogue: 0,0:18:00.24,0:18:02.24,Default,,0,0,0,,Білсеңіз, уайымыңыз жоғалады.
Dialogue: 0,0:18:02.33,0:18:03.66,Default,,0,0,0,,Таку Адому (Исуруги)
Dialogue: 0,0:18:03.74,0:18:06.91,Default,,0,0,0,,Жеңіске жетіп, ел атағын алдық. Мақсатты саған қалдырдым.
Dialogue: 0,0:18:07.54,0:18:09.92,Default,,0,0,0,,Мен сізге Тоинның шынайы мүмкіндіктерін көрсетемін.
Dialogue: 0,0:18:11.46,0:18:15.92,Default,,0,0,0,,Қарасам, бұл адамдар талай рет осылай шымшып қалған.
Dialogue: 0,0:18:16.72,0:18:18.43,Default,,0,0,0,,Дыбыс шығарайық, Тоин!
Dialogue: 0,0:18:19.05,0:18:22.47,Default,,0,0,0,,6 минут қалды. Тоин, сен қайтадан итеріп кете аласың ба?
Dialogue: 0,0:18:22.55,0:18:24.43,Default,,0,0,0,,Қасиетті ғибадатхана орнына айнала ма?
Dialogue: 0,0:18:24.52,0:18:27.94,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:18:28.02,0:18:29.48,Default,,0,0,0,,Жылқықұйрығы га
Dialogue: 0,0:18:29.56,0:18:30.94,Default,,0,0,0,,Өзіңізді көрсетіңіз
Dialogue: 0,0:18:31.77,0:18:33.44,Default,,0,0,0,,Жеңіске жетейік, сөзсіз
Dialogue: 0,0:18:33.52,0:18:35.44,Default,,0,0,0,,Ха, иә
Dialogue: 0,0:18:35.53,0:18:37.44,Default,,0,0,0,,Тоин! Тоин! Тоин!
Dialogue: 0,0:18:37.53,0:18:39.99,Default,,0,0,0,,Биіктігі күткендей жақсы.
Dialogue: 0,0:18:40.07,0:18:41.03,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,0:18:41.12,0:18:43.74,Default,,0,0,0,,Қарияның басқа жұмысы бар сияқты.
Dialogue: 0,0:18:44.28,0:18:45.70,Default,,0,0,0,,Кешіріңіз, өтінемін.
Dialogue: 0,0:18:45.79,0:18:47.70,Default,,0,0,0,,Енді, тағдырдың ысқырығы!
Dialogue: 0,0:18:47.79,0:18:50.21,Default,,0,0,0,,Сакрамент! Қасиетті ғибадатхана!
Dialogue: 0,0:18:50.29,0:18:53.71,Default,,0,0,0,,(Ат құйрықтың ауыр тыныс алуы)
Dialogue: 0,0:18:53.79,0:18:57.21,Default,,0,0,0,,Тоиннің шабуылы! Қасиетті ғибадатхана қорғаныста
Dialogue: 0,0:18:58.51,0:19:01.47,Default,,0,0,0,,Урадан ұзақ пас! шынымен жақсы жүгіреді
Dialogue: 0,0:19:01.55,0:19:02.97,Default,,0,0,0,,Сіз жақсы дайындалғансыз.
Dialogue: 0,0:19:03.80,0:19:05.72,Default,,0,0,0,,Қасиетті ғибадатхана біршама баяу қозғалады.
Dialogue: 0,0:19:05.81,0:19:07.93,Default,,0,0,0,,Менің аяғым кептеліп қалды!
Dialogue: 0,0:19:08.02,0:19:09.23,Default,,0,0,0,,Тұтқаны түсіріңіз?
Dialogue: 0,0:19:09.31,0:19:11.23,Default,,0,0,0,,Бір минут күтіңіз! Шын айтасың ба?
Dialogue: 0,0:19:11.31,0:19:12.65,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:19:12.73,0:19:14.65,Default,,0,0,0,,Иегі қатты көтерілген ойыншы...
Dialogue: 0,0:19:14.73,0:19:16.73,Default,,0,0,0,,Мен оны бір секундқа да қалдыра алмаймын
Dialogue: 0,0:19:16.82,0:19:17.44,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:17.44,0:19:19.24,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:17.44,0:19:19.24,Default,,0,0,0,,Егер сіз ұтсаңыз, пайда жоқ
Dialogue: 0,0:19:20.24,0:19:22.24,Default,,0,0,0,,Ол жақсы біледі.
Dialogue: 0,0:19:23.87,0:19:25.74,Default,,0,0,0,,Кокумо Кірейік (Кокумо) Иә!
Dialogue: 0,0:19:27.33,0:19:30.25,Default,,0,0,0,,Эмото: Кезекпен жүріңіз! Соңына дейін жүгір!
Dialogue: 0,0:19:30.96,0:19:35.75,Default,,0,0,0,,Соңғысы... Дұрыс, оған дейін тым болмаса бір жұмысты орында!
Dialogue: 0,0:19:36.84,0:19:40.55,Default,,0,0,0,,Бұл Шығыс үйде шешуші жұмысты атқаратын адам.
Dialogue: 0,0:19:41.72,0:19:45.30,Default,,0,0,0,,Мен оны есептеуге кірмегендіктен жеткілікті түрде есептедім деп ойладым, бірақ
Dialogue: 0,0:19:45.39,0:19:48.81,Default,,0,0,0,,Мен сізді әлі толық өлшеген жоқпын.
Dialogue: 0,0:19:48.89,0:19:52.56,Default,,0,0,0,,Сонда да ұтылмайтын себебіміз бар.
Dialogue: 0,0:19:52.64,0:19:56.06,Default,,0,0,0,,Мен сені жеймін, өлсең де жеймін
Dialogue: 0,0:19:56.15,0:20:00.15,Default,,0,0,0,,Менің тізем күліп тұр. Мен жеткілікті жүгірген жоқпын.
Dialogue: 0,0:20:00.24,0:20:04.99,Default,,0,0,0,,Бірақ қуаныңыз, сізде әлі... келесі жылы және одан кейінгі жылы бар.
Dialogue: 0,0:20:11.08,0:20:13.25,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:20:13.96,0:20:16.25,Default,,0,0,0,,Келесі жыл мен келесі жыл туралы білмеймін.
Dialogue: 0,0:20:16.88,0:20:18.50,Default,,0,0,0,,Қазір... бүгін!
Dialogue: 0,0:20:24.09,0:20:28.10,Default,,0,0,0,,Не болсада... қаншама бақытты күндер...
Dialogue: 0,0:20:30.60,0:20:34.77,Default,,0,0,0,,Ештеңе анық емес. Оның қашан бітетінін білмеймін.
Dialogue: 0,0:20:34.85,0:20:38.07,Default,,0,0,0,,Екеуміз ғана болсақ, өзін жалғыз сезінеді.
Dialogue: 0,0:20:38.15,0:20:40.03,Default,,0,0,0,,Иә, бұл жалғыздық.
Dialogue: 0,0:20:40.11,0:20:43.78,Default,,0,0,0,,Жасалуы қиын болуы мүмкін, бірақ әп-сәтте бұзылады!
Dialogue: 0,0:20:44.53,0:20:46.28,Default,,0,0,0,,Бірақ бәрібір!
Dialogue: 0,0:20:53.08,0:20:57.79,Default,,0,0,0,,Қол-аяғыңмен сәл болса да тоқтата алсаң
Dialogue: 0,0:20:58.50,0:21:00.30,Default,,0,0,0,,Хошина (Хошина) қақпа алдына келді!
Dialogue: 0,0:21:00.38,0:21:01.80,Default,,0,0,0,,Осы жерден өту керек пе? (Барлығы) Уф
Dialogue: 0,0:21:01.88,0:21:04.05,Default,,0,0,0,,Кайто тегін секіріп кетті!
Dialogue: 0,0:21:04.13,0:21:06.30,Default,,0,0,0,,Ол бір күні бітеді
Dialogue: 0,0:21:06.39,0:21:07.51,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:21:07.59,0:21:12.56,Default,,0,0,0,,Әр күн бір секундқа ұзағырақ жалғасуы үшін!
Dialogue: 0,0:21:16.14,0:21:18.61,Default,,0,0,0,,Мен оны тоқтаттым! Әйтеуір Сейсеки аман қалды!
Dialogue: 0,0:21:16.14,0:21:18.61,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:21:18.61,0:21:18.69,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:21:18.69,0:21:20.07,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:21:20.15,0:21:22.19,Default,,0,0,0,,Ой, бұл қандай ысқырық?
Dialogue: 0,0:21:22.28,0:21:23.57,Default,,0,0,0,,Бұл PK (тікелей эфир) Ха!
Dialogue: 0,0:21:24.32,0:21:28.28,Default,,0,0,0,,Бұл ПК! Соңғы минутта Тоин айып добын орындады!
Dialogue: 0,0:21:28.37,0:21:31.33,Default,,0,0,0,,Аа, Эмото-кунның қолына тиген сияқты.
Dialogue: 0,0:21:31.41,0:21:34.33,Default,,0,0,0,,Мен наразылық білдіремін, бірақ бұл жойылмайды.
Dialogue: 0,0:21:34.41,0:21:36.92,Default,,0,0,0,,Эмото қозғалмайды. Сіз жарақат алдыңыз ба?
Dialogue: 0,0:21:37.00,0:21:39.17,Default,,0,0,0,,Жоқ, бұл рухани нәрсе шығар.
Dialogue: 0,0:21:40.92,0:21:41.92,Default,,0,0,0,,Мен жасадым
Dialogue: 0,0:21:44.09,0:21:46.68,Default,,0,0,0,,Ақырында мен ештеңе істей алмадым.
Dialogue: 0,0:21:46.76,0:21:48.68,Default,,0,0,0,,Бұл Эмотоның кінәсі емес.
Dialogue: 0,0:21:48.76,0:21:51.68,Default,,0,0,0,,Сақтау мүмкіндігі (Oshiba) қосылды.
Dialogue: 0,0:21:52.93,0:21:57.44,Default,,0,0,0,,Мен сені құрметтеймін, сен маған, Цукуси, біз жеңеміз!
Dialogue: 0,0:21:57.52,0:21:59.48,Default,,0,0,0,,Қосымша уақытты енгізу
Dialogue: 0,0:21:59.56,0:22:01.44,Default,,0,0,0,,Бір қызығы, Туин айып добын орындады.
Dialogue: 0,0:22:01.52,0:22:04.78,Default,,0,0,0,,Соққы - Сейсеки Хошина, шарасыз жағдай!
Dialogue: 0,0:22:07.53,0:22:08.99,Default,,0,0,0,,Ысқырық естілді!
Dialogue: 0,0:22:09.07,0:22:10.91,Default,,0,0,0,,Жасандылық! Мен оны тоқтаттым!
Dialogue: 0,0:22:10.99,0:22:11.83,Default,,0,0,0,,Не? (Ура) Әлі жоқ!
Dialogue: 0,0:22:11.91,0:22:13.29,Default,,0,0,0,,Ура! (Қазама) Маған рұқсат берме!
Dialogue: 0,0:22:14.87,0:22:16.04,Default,,0,0,0,,Рұқсатсыз маған қарама.
Dialogue: 0,0:22:16.12,0:22:18.04,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:22:18.62,0:22:20.04,Default,,0,0,0,,Уф
Dialogue: 0,0:22:20.13,0:22:22.54,Default,,0,0,0,,Мақсат қоюға уақыт жоқ! Уф!
Dialogue: 0,0:22:22.63,0:22:24.05,Default,,0,0,0,,Түсінікті! (Кай) Жоқ, олай емес.
Dialogue: 0,0:22:25.38,0:22:26.30,Default,,0,0,0,,Есептегіш!
Dialogue: 0,0:22:26.38,0:22:28.30,Default,,0,0,0,,Тоқта! (Хошина) Тіпті фол да жақсы!
Dialogue: 0,0:22:28.38,0:22:30.55,Default,,0,0,0,,Екі қорғаушы тоқтай алмайды!
Dialogue: 0,0:22:31.89,0:22:33.31,Default,,0,0,0,,Өзіңді жаман сезінбе...
Dialogue: 0,0:22:34.06,0:22:35.56,Default,,0,0,0,,Бұл құбыжық па?
Dialogue: 0,0:22:35.64,0:22:36.81,Default,,0,0,0,,Жүр!
Dialogue: 0,0:22:38.31,0:22:39.31,Default,,0,0,0,,Бітті!
Dialogue: 0,0:22:41.40,0:22:44.07,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,0:22:45.65,0:22:48.45,Default,,0,0,0,,Төменге қарама, Эмото.
Dialogue: 0,0:22:50.20,0:22:51.62,Default,,0,0,0,,Бүкіл ел бойынша.
Dialogue: 0,0:22:53.49,0:22:56.75,Default,,0,0,0,,Ең күшті адам – капитан.
Dialogue: 0,0:22:56.83,0:22:59.08,Default,,0,0,0,,Усуй өте жақсы нәрселерді айтады.
Dialogue: 0,0:22:59.79,0:23:03.84,Default,,0,0,0,,Күш дегеніміз не? Ол жүрек пе? Денесі ме?
Dialogue: 0,0:23:05.42,0:23:07.38,Default,,0,0,0,,Менде түсінік жоқ
Dialogue: 0,0:23:07.46,0:23:10.59,Default,,0,0,0,,Түсінбегендіктен, бір ғана ант бердім.
Dialogue: 0,0:23:13.60,0:23:15.10,Default,,0,0,0,,Сол кезде мен шештім.
Dialogue: 0,0:23:16.47,0:23:19.10,Default,,0,0,0,,Мен бұдан былай ешкімге менсінбеймін!
Dialogue: 0,0:23:19.18,0:23:21.10,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:23:21.19,0:23:22.85,Default,,0,0,0,,Қасиетті кері қайтару!
Dialogue: 0,0:23:22.94,0:23:26.86,Default,,0,0,0,,Капитан Мизукидің нағыз соққысы! PK есептегіші!
Dialogue: 0,0:23:26.94,0:23:28.11,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:23:29.19,0:23:31.11,Default,,0,0,0,,Ойын аяқталды!
Dialogue: 0,0:23:31.20,0:23:32.03,Default,,0,0,0,,2-ден 1-ге дейін! Сейсеки Тоинді артта қалдырған жеңісте жеңді!
Dialogue: 0,0:23:32.03,0:23:35.12,Default,,0,0,0,,2-ден 1-ге дейін! Сейсеки Тоинді артта қалдырған жеңісте жеңді!
Dialogue: 0,0:23:32.03,0:23:35.12,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:23:35.12,0:23:35.78,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:23:35.78,0:23:37.37,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:23:35.78,0:23:37.37,Default,,0,0,0,,80 азапты минут
Dialogue: 0,0:23:37.45,0:23:41.37,Default,,0,0,0,,Көп үмітті ақтап, ұлттық билетті жеңіп алған адам болды
Dialogue: 0,0:23:41.46,0:23:44.13,Default,,0,0,0,,Жеке Сейсеки орта мектебі!
Dialogue: 0,0:23:48.80,0:23:50.09,Default,,0,0,0,,Жылқы құйрығы!
Dialogue: 0,0:23:50.17,0:23:51.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:51.09,0:23:53.76,Default,,0,0,0,,Сіз мұны жасадыңыз! Сіз жеңдіңіз! Сізге рахмет!
Dialogue: 0,0:23:53.84,0:23:55.51,Default,,0,0,0,,Жеңіс...? (Қазама) Дұрыс.
Dialogue: 0,0:23:55.60,0:23:57.47,Default,,0,0,0,,Біз жеңдік.
Dialogue: 0,0:23:58.27,0:23:59.64,Default,,0,0,0,,Ол әлі жалғасып жатыр ма?
Dialogue: 0,0:23:59.72,0:24:02.27,Default,,0,0,0,,А, жалғасады, жалғасады!
Dialogue: 0,0:24:02.35,0:24:03.35,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:24:04.56,0:24:11.15,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:24:18.66,0:24:19.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:19.58,0:24:21.04,Default,,0,0,0,,Хабар тарату орны Хабар тарату орны
Dialogue: 0,0:24:21.87,0:24:23.92,Default,,0,0,0,,Енді кейіпкердің сұхбаты.
Dialogue: 0,0:24:24.00,0:24:26.17,Default,,0,0,0,,Керемет жеңісіңіз құтты болсын!
Dialogue: 0,0:24:26.25,0:24:28.88,Default,,0,0,0,,Жоқ, бұл менің жеке күшім емес.
Dialogue: 0,0:24:28.96,0:24:31.09,Default,,0,0,0,,Оның ішінде орындықта болмаған мүшелер
Dialogue: 0,0:24:31.17,0:24:32.92,Default,,0,0,0,,Барлығының жеңісі.
Dialogue: 0,0:24:33.01,0:24:33.93,Default,,0,0,0,,Қолдауыңызға рахмет
Dialogue: 0,0:24:33.93,0:24:35.93,Default,,0,0,0,,Қолдауыңызға рахмет
Dialogue: 0,0:24:33.93,0:24:35.93,Default,,0,0,0,,Мизуки дұрыс сөйлеп тұр...
Dialogue: 0,0:24:36.01,0:24:38.93,Default,,0,0,0,,Трибунада маған аз да болса қуат бергендердің бәрі
Dialogue: 0,0:24:39.01,0:24:41.39,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:24:41.47,0:24:44.85,Default,,0,0,0,,Республикалық байқауға қатысуыңызды асыға күтеміз!
Dialogue: 0,0:24:46.10,0:24:47.94,Default,,0,0,0,,Genkidama?
Dialogue: 0,0:24:48.77,0:24:53.61,Default,,0,0,0,,♪～
Dialogue: 0,0:26:12.90,0:26:17.90,Default,,0,0,0,,～♪
Dialogue: 0,0:26:19.40,0:26:25.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory