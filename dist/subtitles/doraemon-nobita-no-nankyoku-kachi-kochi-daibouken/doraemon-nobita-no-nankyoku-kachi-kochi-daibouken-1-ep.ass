Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.61,0:00:34.36,Default,,0,0,0,,Бұл? (Карла) Дәрігер!
Dialogue: 0,0:00:34.49,0:00:36.07,Default,,0,0,0,,Хмм, мофу мофу
Dialogue: 0,0:00:41.75,0:00:43.46,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:00:43.58,0:00:45.50,Default,,0,0,0,,Бұл Блицзаганың қаңқасы
Dialogue: 0,0:00:50.63,0:00:51.63,Default,,0,0,0,,Осымен.
Dialogue: 0,0:00:58.93,0:00:59.93,Default,,0,0,0,,Ал егер Цуки Кира болса, онда Цуки Нианы өлтіреді
Dialogue: 0,0:01:05.02,0:01:07.65,Default,,0,0,0,,Ууууууууууууу...
Dialogue: 0,0:01:07.77,0:01:09.94,Default,,0,0,0,,О, абай болыңыз
Dialogue: 0,0:01:10.07,0:01:11.52,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:01:16.65,0:01:18.16,Default,,0,0,0,,Сол силуэт...
Dialogue: 0,0:01:18.45,0:01:19.49,Default,,0,0,0,,Карла! Асығыңыз!
Dialogue: 0,0:01:19.62,0:01:22.41,Default,,0,0,0,,Тағы да... кетті!
Dialogue: 0,0:01:22.54,0:01:24.45,Default,,0,0,0,,Пао пао
Dialogue: 0,0:01:24.58,0:01:25.79,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:01:27.04,0:01:28.67,Default,,0,0,0,,Кеттік! пао пао
Dialogue: 0,0:01:28.79,0:01:30.79,Default,,0,0,0,,Уау Пао
Dialogue: 0,0:01:36.97,0:01:38.59,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:01:38.97,0:01:40.18,Default,,0,0,0,,Сегізбұрыш
Dialogue: 0,0:01:40.39,0:01:43.06,Default,,0,0,0,,Алдымен Otodama Go қолданбасын пайдаланыңыз!
Dialogue: 0,0:01:44.52,0:01:47.23,Default,,0,0,0,,(Октогонның ыңырсыуы)
Dialogue: 0,0:01:47.35,0:01:49.60,Default,,0,0,0,,(сегіз бұрышты ырылдау)
Dialogue: 0,0:01:49.73,0:01:51.65,Default,,0,0,0,,Уа, ау...
Dialogue: 0,0:01:51.98,0:01:52.82,Default,,0,0,0,,Дәрігер! Техникалық технология!
Dialogue: 0,0:01:52.94,0:01:53.94,Default,,0,0,0,,(сегіз бұрышты ырылдау)
Dialogue: 0,0:01:54.07,0:01:56.32,Default,,0,0,0,,Уаааааааааааааааааааа
Dialogue: 0,0:02:04.45,0:02:06.50,Default,,0,0,0,,Жоқ! Жақсы
Dialogue: 0,0:02:07.04,0:02:08.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:12.54,0:02:14.21,Default,,0,0,0,,Мофф (Қара) Жоқ!
Dialogue: 0,0:02:22.10,0:02:23.14,Default,,0,0,0,,Білезік! Киіз үй!
Dialogue: 0,0:02:23.26,0:02:27.27,Default,,0,0,0,,(сегіз бұрышты ырылдау)
Dialogue: 0,0:02:44.28,0:02:48.50,Default,,0,0,0,,(цикада айқайы)
Dialogue: 0,0:02:48.62,0:02:51.88,Default,,0,0,0,,Қарқынды қызу басылу белгілерін көрсетпейді.
Dialogue: 0,0:02:52.13,0:02:54.96,Default,,0,0,0,,Бүгін де 35 градустан жоғары болатын жерлер көп.
Dialogue: 0,0:02:55.09,0:02:57.59,Default,,0,0,0,,Бұл ыстық біраз уақытқа дейін сақталады деп күтілуде.
Dialogue: 0,0:02:58.09,0:03:01.55,Default,,0,0,0,,Қала орталығындағы кей жерлерде 45 градус ыстық тіркелді.
Dialogue: 0,0:03:01.68,0:03:04.05,Default,,0,0,0,,Ел аумағында аптап ыстық жалғасуда.
Dialogue: 0,0:03:04.76,0:03:06.51,Default,,0,0,0,,Токио екі апта қатарынан...
Dialogue: 0,0:03:06.64,0:03:09.93,Default,,0,0,0,,Қырылған мұз - қалағаныңызша жеуге мүмкіндік беретін құрал?
Dialogue: 0,0:03:10.06,0:03:10.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:11.02,0:03:13.69,Default,,0,0,0,,Осылай жүре берсек, күн ыстық болып, жанып өлеміз.
Dialogue: 0,0:03:13.86,0:03:16.65,Default,,0,0,0,,Тіпті менің үй тапсырмасы да бір қалыпты орындалмайды.
Dialogue: 0,0:03:16.77,0:03:18.23,Default,,0,0,0,,Жарайды, сен осылай айта бересің...
Dialogue: 0,0:03:18.23,0:03:19.40,Default,,0,0,0,,Ал, сен осылай айта бересің...
Dialogue: 0,0:03:18.23,0:03:19.40,Default,,0,0,0,,(Уақыт телефонының рингтоны)
Dialogue: 0,0:03:19.40,0:03:19.57,Default,,0,0,0,,(Уақыт телефонының рингтоны)
Dialogue: 0,0:03:19.57,0:03:19.90,Default,,0,0,0,,(Уақыт телефонының рингтоны)
Dialogue: 0,0:03:19.57,0:03:19.90,Default,,0,0,0,,Иә? Бұл Дорамиден
Dialogue: 0,0:03:19.90,0:03:21.95,Default,,0,0,0,,Иә? Бұл Дорамиден
Dialogue: 0,0:03:23.57,0:03:27.91,Default,,0,0,0,,Үлкен аға, жақсысың ба? Жақсы, сіз әлі де жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:03:28.20,0:03:30.25,Default,,0,0,0,,Мен өзімді мүлде жақсы сезінбеймін.
Dialogue: 0,0:03:30.41,0:03:31.79,Default,,0,0,0,,Бұл жерде ыстық (Нобита) Ах.
Dialogue: 0,0:03:32.08,0:03:34.00,Default,,0,0,0,,Ыстық па? Бұл біртүрлі
Dialogue: 0,0:03:34.13,0:03:36.79,Default,,0,0,0,,Робот болжамы бойынша сіздің ағаңыз осы аптада болады—
Dialogue: 0,0:03:36.92,0:03:40.09,Default,,0,0,0,,Менің өмірімдегі ең нашар бақыт «Хёнан» пайда болды дейді.
Dialogue: 0,0:03:40.59,0:03:42.43,Default,,0,0,0,,Е (Нобита) Хьюнан?
Dialogue: 0,0:03:42.55,0:03:44.47,Default,,0,0,0,,Оның жеңіске деген беделі бар.
Dialogue: 0,0:03:44.80,0:03:47.18,Default,,0,0,0,,«Мұз мәселесі» деп жазылған.
Dialogue: 0,0:03:47.31,0:03:50.93,Default,,0,0,0,,Суық. Суық Мұздың кесірінен сіз қиындыққа тап боласыз.
Dialogue: 0,0:03:51.10,0:03:54.98,Default,,0,0,0,,Тек мұздан сақ болыңыз және оған ешқашан жақындамаңыз.
Dialogue: 0,0:03:55.31,0:03:58.94,Default,,0,0,0,,Сонымен қатар пингвиндерден сақ болыңыз. Бақытты зат - жұлдыз.
Dialogue: 0,0:03:59.28,0:04:03.15,Default,,0,0,0,,Бұл өте дұрыс~ Дорами жақында сәнге айналады.
Dialogue: 0,0:04:03.57,0:04:06.07,Default,,0,0,0,,Иә? Мұздар алып кетті ме?
Dialogue: 0,0:04:07.74,0:04:08.83,Default,,0,0,0,,Хун
Dialogue: 0,0:04:09.58,0:04:11.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:11.70,0:04:15.79,Default,,0,0,0,,А... Қырылған мұзды жемесем, күйіп кетем!
Dialogue: 0,0:04:16.17,0:04:19.25,Default,,0,0,0,,Қырылған мұз Drift мұз…
Dialogue: 0,0:04:19.38,0:04:22.59,Default,,0,0,0,,Иә! Қалағаныңызша тамақтанатын орындар бар!
Dialogue: 0,0:04:23.22,0:04:26.97,Default,,0,0,0,,Жарайды, менің ойымша, бұл жерде... Ол жерде! Хмм...
Dialogue: 0,0:04:27.26,0:04:30.01,Default,,0,0,0,,Міне. Мен оған қызық болдым, сондықтан оны сақтап қалдым.
Dialogue: 0,0:04:30.60,0:04:32.23,Default,,0,0,0,,Үлкен айсберг...
Dialogue: 0,0:04:32.52,0:04:34.98,Default,,0,0,0,,Асқазаныңызды қырынған мұзбен толтырыңыз
Dialogue: 0,0:04:35.14,0:04:36.52,Default,,0,0,0,,Түсіндім, жақсы.
Dialogue: 0,0:04:36.65,0:04:39.57,Default,,0,0,0,,Ах... Бірақ Дорами-чанның сәуегейлігі ше?
Dialogue: 0,0:04:39.69,0:04:42.40,Default,,0,0,0,,«Мұздың қиын кезеңі: мұздан сақ болыңыз»
Dialogue: 0,0:04:42.53,0:04:44.20,Default,,0,0,0,,Маған бәрібір Маған бәрібір
Dialogue: 0,0:04:46.36,0:04:47.78,Default,,0,0,0,,Хмф (Нобита) Иә?
Dialogue: 0,0:04:49.03,0:04:50.12,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:55.83,0:04:58.08,Default,,0,0,0,,Бұл алып айсберг пе?
Dialogue: 0,0:04:59.29,0:05:00.46,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:05:07.51,0:05:08.34,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:11.06,0:05:14.73,Default,,0,0,0,,Иә? Ештеңе де...
Dialogue: 0,0:05:15.52,0:05:20.15,Default,,0,0,0,,Бұл бір жылдан астам уақыт бұрын мақала болды, сондықтан ол қазірдің өзінде еріген деп ойлаймын, солай емес пе?
Dialogue: 0,0:05:21.32,0:05:24.19,Default,,0,0,0,,Ах, о! Гуаааа...
Dialogue: 0,0:05:24.32,0:05:26.95,Default,,0,0,0,,Мына жақта, мына жақта! (Нобита) А?
Dialogue: 0,0:05:30.45,0:05:32.74,Default,,0,0,0,,Эй, мына мұз қабырға...
Dialogue: 0,0:05:32.87,0:05:34.45,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:05:34.58,0:05:35.91,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:05:36.83,0:05:39.21,Default,,0,0,0,,Бұл үлкен айсберг!
Dialogue: 0,0:05:42.42,0:05:44.67,Default,,0,0,0,,Керемет! Мұның бәрі мұз ба?
Dialogue: 0,0:05:44.80,0:05:47.76,Default,,0,0,0,,Мұнда қырылған мұзды жеуге болады!
Dialogue: 0,0:05:50.80,0:05:53.22,Default,,0,0,0,,Осы қарқынмен қанша жесең де, арықтамайсың.
Dialogue: 0,0:05:53.39,0:05:55.56,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:05:55.73,0:05:58.39,Default,,0,0,0,,Эй, мен үйімнен үстел мен орындық әкелемін.
Dialogue: 0,0:05:58.52,0:06:00.06,Default,,0,0,0,,Кез келген жерде есікке жауап беріңіз
Dialogue: 0,0:06:00.19,0:06:02.11,Default,,0,0,0,,Сонда бізде жақсы құрал бар...
Dialogue: 0,0:06:05.40,0:06:06.44,Default,,0,0,0,,Не?
Dialogue: 0,0:06:07.70,0:06:12.20,Default,,0,0,0,,Иә? Апыр-ай! Бар... Хм...
Dialogue: 0,0:06:12.33,0:06:14.08,Default,,0,0,0,,Бұл үстел мен орындықтар ма?
Dialogue: 0,0:06:14.29,0:06:15.41,Default,,0,0,0,,Аа, мен қателесіппін.
Dialogue: 0,0:06:15.54,0:06:18.25,Default,,0,0,0,,Оны плюс күйіне қойыңыз...
Dialogue: 0,0:06:19.67,0:06:20.50,Default,,0,0,0,,Уаааа
Dialogue: 0,0:06:20.63,0:06:23.59,Default,,0,0,0,,Содан кейін үтіктің ұшын тарылтыңыз.
Dialogue: 0,0:06:23.80,0:06:24.55,Default,,0,0,0,,Енді
Dialogue: 0,0:06:24.67,0:06:27.38,Default,,0,0,0,,(Дораэмонның ызылдаған дауысы)
Dialogue: 0,0:06:27.59,0:06:29.84,Default,,0,0,0,,Міне осылай... орындалды.
Dialogue: 0,0:06:30.64,0:06:32.93,Default,,0,0,0,,Керемет! Ол диванға айналды~
Dialogue: 0,0:06:33.14,0:06:37.14,Default,,0,0,0,,Хмм... Менің ойымша, келесідей нәрсе...
Dialogue: 0,0:06:40.65,0:06:41.81,Default,,0,0,0,,Бұны шашқанда—
Dialogue: 0,0:06:41.94,0:06:45.98,Default,,0,0,0,,Мұз үлпілдеп, жұмсақ болып, қатып, ерімейді.
Dialogue: 0,0:06:46.11,0:06:48.28,Default,,0,0,0,,Уау! Хе хехе
Dialogue: 0,0:06:48.44,0:06:50.74,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:06:50.91,0:06:52.62,Default,,0,0,0,,Эй, сен де үстел жасай аласың ба?
Dialogue: 0,0:06:52.95,0:06:56.08,Default,,0,0,0,,Әрине! Кез келген пішін тегін
Dialogue: 0,0:06:58.45,0:07:02.96,Default,,0,0,0,,Хмм, фу~ Бұл жақсы және керемет~
Dialogue: 0,0:07:03.42,0:07:06.75,Default,,0,0,0,,Жалпы бұл күндері жаз тым ыстық.
Dialogue: 0,0:07:06.88,0:07:10.76,Default,,0,0,0,,Жер бетіндегі барлық нәрсе осындай мұз болғанын қалаймын~
Dialogue: 0,0:07:10.93,0:07:14.18,Default,,0,0,0,,Тағы да~ Ах~
Dialogue: 0,0:07:14.30,0:07:17.68,Default,,0,0,0,,Бірақ бұрын Жер сіз қалағандай болғаны рас.
Dialogue: 0,0:07:17.81,0:07:20.73,Default,,0,0,0,,Бірде мені мұз басып қалды.
Dialogue: 0,0:07:21.14,0:07:24.61,Default,,0,0,0,,А, мен білемін! Бұл мамонттар болған дәуір еді, солай ма?
Dialogue: 0,0:07:24.73,0:07:27.73,Default,,0,0,0,,Бұдан көп, әлдеқайда, әлдеқайда ертерек
Dialogue: 0,0:07:27.86,0:07:32.53,Default,,0,0,0,,Бір кездері бүкіл Жер қалың мұзбен жабылған.
Dialogue: 0,0:07:32.66,0:07:33.32,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:07:33.95,0:07:37.45,Default,,0,0,0,,Ол кезде теңіз бен таулардың барлығы мұз басқан еді.
Dialogue: 0,0:07:37.58,0:07:41.46,Default,,0,0,0,,Дүниенің қай түкпіріне барсам да, табиғаты осындай болар еді.
Dialogue: 0,0:07:41.58,0:07:43.79,Default,,0,0,0,,Я~ Бұл...
Dialogue: 0,0:07:43.92,0:07:46.96,Default,,0,0,0,,«Қарлы жер» деп аталатын құбылыс—
Dialogue: 0,0:07:47.09,0:07:49.30,Default,,0,0,0,,Ол ондаған миллион жылдарға созылған дейді.
Dialogue: 0,0:07:50.26,0:07:55.30,Default,,0,0,0,,Бұл жер бетінде адамдар дүниеге келмес бұрын болды.
Dialogue: 0,0:07:56.68,0:08:00.73,Default,,0,0,0,,Енді жеткілікті суытып алдың, үйге барып, үй тапсырмасын орында.
Dialogue: 0,0:08:01.02,0:08:04.31,Default,,0,0,0,,Жақсы, мен жақсы жер таптым~
Dialogue: 0,0:08:04.44,0:08:06.19,Default,,0,0,0,,Осы жерде көбірек ойнайық
Dialogue: 0,0:08:07.19,0:08:09.82,Default,,0,0,0,,Иә! Мұнда мұз ойын-сауық саябағын салайық!
Dialogue: 0,0:08:09.94,0:08:10.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.74,0:08:12.74,Default,,0,0,0,,Құрып көргіңіз келмей ме?
Dialogue: 0,0:08:12.86,0:08:15.45,Default,,0,0,0,,Мұзды айналу дөңгелегі және роликті жағалау
Dialogue: 0,0:08:15.57,0:08:18.08,Default,,0,0,0,,Е... Мм! Үй тапсырмасы ше?
Dialogue: 0,0:08:18.20,0:08:21.33,Default,,0,0,0,,Жарайды, бізде әлі жазғы демалыс~
Dialogue: 0,0:08:21.45,0:08:23.87,Default,,0,0,0,,Мм... Бірақ... (Нобита) Эй! Эй!
Dialogue: 0,0:08:24.00,0:08:26.17,Default,,0,0,0,,Ал... сәл ғана.
Dialogue: 0,0:08:26.71,0:08:28.84,Default,,0,0,0,,Дораемон күткендей!
Dialogue: 0,0:08:28.96,0:08:34.97,Default,,0,0,0,,♪〜
Dialogue: 0,0:09:51.54,0:09:57.55,Default,,0,0,0,,〜♪
Dialogue: 0,0:09:59.84,0:10:01.14,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:10:02.14,0:10:03.56,Default,,0,0,0,,Уау (Сунео) Ада!
Dialogue: 0,0:10:03.93,0:10:05.81,Default,,0,0,0,,Кя! Ахахах... Ууууууу...
Dialogue: 0,0:10:05.98,0:10:07.85,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:10:08.02,0:10:12.02,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:10:15.03,0:10:18.53,Default,,0,0,0,,Ах... ахах
Dialogue: 0,0:10:19.11,0:10:21.37,Default,,0,0,0,,Yahoo yay
Dialogue: 0,0:10:23.28,0:10:24.66,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:10:24.99,0:10:26.50,Default,,0,0,0,,Ахаха...
Dialogue: 0,0:10:27.16,0:10:28.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:28.21,0:10:29.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:29.75,0:10:32.46,Default,,0,0,0,,А... тоқтады... ау.
Dialogue: 0,0:10:32.88,0:10:35.13,Default,,0,0,0,,Сәлем Нобита! Не болып жатыр?
Dialogue: 0,0:10:35.25,0:10:36.13,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:10:36.26,0:10:37.72,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:10:37.84,0:10:39.30,Default,,0,0,0,,Бұл мені өлтірмейді, бірақ біраз уақыт дұрыс жүре алмайтын шығармын.
Dialogue: 0,0:10:40.26,0:10:42.85,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:10:43.10,0:10:44.56,Default,,0,0,0,,Дораемон! Ал... міне, болды!
Dialogue: 0,0:10:45.10,0:10:45.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:49.10,0:10:50.23,Default,,0,0,0,,Я~
Dialogue: 0,0:10:50.35,0:10:51.69,Default,,0,0,0,,Иә! Нобита!
Dialogue: 0,0:10:51.81,0:10:52.56,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:10:53.19,0:10:54.48,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:10:54.61,0:10:55.82,Default,,0,0,0,,Оны дұрыс құрастырыңыз!
Dialogue: 0,0:10:55.94,0:10:57.19,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:10:57.65,0:10:59.74,Default,,0,0,0,,Ей, оны да құрастырайық.
Dialogue: 0,0:10:59.86,0:11:00.78,Default,,0,0,0,,(жұмбақ дыбыс)
Dialogue: 0,0:10:59.86,0:11:00.78,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:11:00.78,0:11:00.91,Default,,0,0,0,,(жұмбақ дыбыс)
Dialogue: 0,0:11:00.91,0:11:02.28,Default,,0,0,0,,(жұмбақ дыбыс)
Dialogue: 0,0:11:00.91,0:11:02.28,Default,,0,0,0,,Мен одан да керемет нәрсе жасаймын.
Dialogue: 0,0:11:02.28,0:11:03.37,Default,,0,0,0,,Мен одан да керемет нәрсе жасаймын.
Dialogue: 0,0:11:03.49,0:11:05.37,Default,,0,0,0,,Жақсы, мен не салуым керек?
Dialogue: 0,0:11:05.49,0:11:07.33,Default,,0,0,0,,Эй, мен қазір ештеңе естімеймін...
Dialogue: 0,0:11:09.41,0:11:11.25,Default,,0,0,0,,Эй, сәл күте тұрыңыз~
Dialogue: 0,0:11:12.71,0:11:13.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:14.79,0:11:16.21,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:19.22,0:11:20.05,Default,,0,0,0,,Ах
Dialogue: 0,0:11:28.72,0:11:31.60,Default,,0,0,0,,Ооо~
Dialogue: 0,0:11:35.40,0:11:39.03,Default,,0,0,0,,Дораемон, сен оны тереңдетесің.
Dialogue: 0,0:11:40.49,0:11:41.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:43.07,0:11:43.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:47.16,0:11:48.91,Default,,0,0,0,,Бір нәрсе көмілген
Dialogue: 0,0:12:03.05,0:12:04.80,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:12:04.93,0:12:06.14,Default,,0,0,0,,Уау
Dialogue: 0,0:12:08.72,0:12:10.98,Default,,0,0,0,,А... мм?
Dialogue: 0,0:12:15.69,0:12:18.11,Default,,0,0,0,,Хмм? о?
Dialogue: 0,0:12:21.07,0:12:22.15,Default,,0,0,0,,Туннель!
Dialogue: 0,0:12:22.28,0:12:25.45,Default,,0,0,0,,Бұл қиын! Айсберг ери бастады
Dialogue: 0,0:12:25.57,0:12:27.16,Default,,0,0,0,,Эй, Нобита ше?
Dialogue: 0,0:12:27.28,0:12:29.99,Default,,0,0,0,,Әй, Нобита! Аха
Dialogue: 0,0:12:30.12,0:12:31.79,Default,,0,0,0,,Әй, Нобита!
Dialogue: 0,0:12:31.91,0:12:34.17,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:12:48.39,0:12:50.97,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:12:57.81,0:12:59.44,Default,,0,0,0,,Мм... Қарғыс атсын!
Dialogue: 0,0:13:02.69,0:13:04.28,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:13:25.67,0:13:27.68,Default,,0,0,0,,Сәлем (Сунео) Сәлем
Dialogue: 0,0:13:27.84,0:13:30.01,Default,,0,0,0,,Нобита-сан! Қайда бардың!
Dialogue: 0,0:13:30.18,0:13:32.01,Default,,0,0,0,,Нобита! Нобита-сан!
Dialogue: 0,0:13:32.18,0:13:33.85,Default,,0,0,0,,Нобита Ноби! (көлік сигналы)
Dialogue: 0,0:13:33.97,0:13:35.81,Default,,0,0,0,,А, ана жерде! (Джан Сунео) Иә?
Dialogue: 0,0:13:35.94,0:13:40.90,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:13:42.44,0:13:44.11,Default,,0,0,0,,Нобита-кун...
Dialogue: 0,0:13:44.49,0:13:47.15,Default,,0,0,0,,Ууууууууууууууууууууууууйшо
Dialogue: 0,0:13:47.28,0:13:48.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:48.66,0:13:50.37,Default,,0,0,0,,Не? сол мұз
Dialogue: 0,0:13:50.62,0:13:53.70,Default,,0,0,0,,Мен оны айсбергтің түбінен таптым.
Dialogue: 0,0:13:53.87,0:13:56.41,Default,,0,0,0,,Не? (Сунео) Дораэмонның құралдары?
Dialogue: 0,0:13:56.54,0:13:57.25,Default,,0,0,0,,Бұл менікі емес.
Dialogue: 0,0:13:57.37,0:13:58.29,Default,,0,0,0,,Гаха... (Сунео) Ах~аа
Dialogue: 0,0:14:02.09,0:14:05.26,Default,,0,0,0,,Қазірдің өзінде! Бұл соншалықты жаман, өте жаман
Dialogue: 0,0:14:05.38,0:14:08.59,Default,,0,0,0,,Бұл білезікке ұқсайды, бірақ ол біреудің жоғалған заты ма?
Dialogue: 0,0:14:08.72,0:14:10.43,Default,,0,0,0,,Мен полиция жәшігіне хабарлауым керек.
Dialogue: 0,0:14:10.55,0:14:13.56,Default,,0,0,0,,Бірақ бізден басқа ешкім болған жоқ, солай ма?
Dialogue: 0,0:14:13.68,0:14:14.97,Default,,0,0,0,,Ол қатып қалды...
Dialogue: 0,0:14:15.10,0:14:17.60,Default,,0,0,0,,Сіз оны тастағаныңызға біраз уақыт болды емес пе?
Dialogue: 0,0:14:17.73,0:14:20.81,Default,,0,0,0,,Әй, бұл айсберг Антарктидадан келді, солай ма?
Dialogue: 0,0:14:20.94,0:14:21.61,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:22.02,0:14:24.78,Default,,0,0,0,,Сонымен, бұл Антарктидада біреу жоғалтқан нәрсе ме?
Dialogue: 0,0:14:24.90,0:14:27.19,Default,,0,0,0,,Антарктидада адамдар өмір сүре ме?
Dialogue: 0,0:14:27.32,0:14:28.40,Default,,0,0,0,,Жоқ, олар антарктикалық базада немесе басқа жерде өмір сүретін шығар.
Dialogue: 0,0:14:28.40,0:14:31.16,Default,,0,0,0,,Жоқ, олар антарктикалық базада немесе басқа жерде өмір сүретін шығар.
Dialogue: 0,0:14:28.40,0:14:31.16,Default,,0,0,0,,Хмм... Мм!
Dialogue: 0,0:14:31.28,0:14:34.12,Default,,0,0,0,,Бұл тамаша жаңалық болуы мүмкін.
Dialogue: 0,0:14:34.37,0:14:36.58,Default,,0,0,0,,Бұл? Не айтқың келеді?
Dialogue: 0,0:14:40.67,0:14:43.59,Default,,0,0,0,,Енді мұздың қашан қатқанын білуге ​​болады.
Dialogue: 0,0:14:43.92,0:14:45.38,Default,,0,0,0,,Керемет!
Dialogue: 0,0:14:48.97,0:14:52.34,Default,,0,0,0,,Хмм... 100 000 жыл бұрын Күтілгендей.
Dialogue: 0,0:14:52.47,0:14:54.26,Default,,0,0,0,,100 000 жыл?
Dialogue: 0,0:14:54.43,0:14:56.31,Default,,0,0,0,,Бұл баяғыда ма?
Dialogue: 0,0:14:56.43,0:15:00.64,Default,,0,0,0,,Айсбергтер жүз мыңдаған жылдар бойы жиналған қардан тұрады.
Dialogue: 0,0:15:00.77,0:15:03.61,Default,,0,0,0,,Олай болса, неғұрлым төмен түссе, мұз соғұрлым қартаяды.
Dialogue: 0,0:15:04.06,0:15:06.65,Default,,0,0,0,,Бұл сіз бұрын жоғалтқан нәрсе ме?
Dialogue: 0,0:15:06.78,0:15:08.03,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:15:08.57,0:15:12.99,Default,,0,0,0,,Антарктида шамамен 200 жыл бұрын ашылған
Dialogue: 0,0:15:13.24,0:15:17.16,Default,,0,0,0,,Бұған дейін ол жерге ешкім аяқ басқан емес.
Dialogue: 0,0:15:17.58,0:15:20.66,Default,,0,0,0,,Ал 100 000 жыл бұрын палеолит кезеңі
Dialogue: 0,0:15:20.79,0:15:21.96,Default,,0,0,0,,Сол кездегі адамзатқа —
Dialogue: 0,0:15:22.12,0:15:25.50,Default,,0,0,0,,Мұндай күрделі сақина жасау технологиясы әлі болған жоқ.
Dialogue: 0,0:15:26.00,0:15:28.71,Default,,0,0,0,,100 000 жыл бұрын... Антарктида! ?
Dialogue: 0,0:15:28.84,0:15:30.76,Default,,0,0,0,,Егер заттың иесі табылса...
Dialogue: 0,0:15:30.88,0:15:33.01,Default,,0,0,0,,Ғасырдың ұлы жаңалығы!
Dialogue: 0,0:15:33.14,0:15:37.93,Default,,0,0,0,,Арх! Сәлем Нобита! Мұздатылған тағы бір нәрсе болды ма?
Dialogue: 0,0:15:38.06,0:15:39.02,Default,,0,0,0,,Е...
Dialogue: 0,0:15:39.14,0:15:40.43,Default,,0,0,0,,Артқа оралып, іздеп көрейік!
Dialogue: 0,0:15:40.56,0:15:43.60,Default,,0,0,0,,Аа, бүгін кеш болды, ертең...
Dialogue: 0,0:15:43.73,0:15:46.36,Default,,0,0,0,,Айсберг болған жерге оралайық.
Dialogue: 0,0:15:46.48,0:15:49.49,Default,,0,0,0,,Жарайды! Ал, ертең таңертең осында кездесейік!
Dialogue: 0,0:15:49.65,0:15:52.53,Default,,0,0,0,,Ешқашан ұйықтамаңыз! (Нобита) Әрине!
Dialogue: 0,0:15:53.32,0:15:55.66,Default,,0,0,0,,күрсіну~ Қайырлы түн.
Dialogue: 0,0:15:55.78,0:15:57.03,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:16:02.08,0:16:03.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:17.18,0:16:19.56,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:16:29.53,0:16:30.65,Default,,0,0,0,,Нобита
Dialogue: 0,0:16:32.53,0:16:33.49,Default,,0,0,0,,Нобита!
Dialogue: 0,0:16:33.86,0:16:35.03,Default,,0,0,0,,Кім?
Dialogue: 0,0:16:37.62,0:16:40.66,Default,,0,0,0,,Күте тұрыңыз, күн суық~
Dialogue: 0,0:16:41.33,0:16:43.71,Default,,0,0,0,,Күте тұрыңыз! Апыр-ай!
Dialogue: 0,0:16:54.05,0:16:55.59,Default,,0,0,0,,Дораемон! ?
Dialogue: 0,0:16:56.39,0:16:57.09,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:16:57.18,0:16:58.55,Default,,0,0,0,,Мұздың зақымдану аспектісі бар...
Dialogue: 0,0:16:58.89,0:17:00.47,Default,,0,0,0,,Бақытты зат – жұлдыз...
Dialogue: 0,0:17:00.68,0:17:02.43,Default,,0,0,0,,Тек мұзбен абай болыңыз...
Dialogue: 0,0:17:02.52,0:17:03.98,Default,,0,0,0,,Бұл біреудің жоғалған заты ма?
Dialogue: 0,0:17:04.10,0:17:06.90,Default,,0,0,0,,Егер сіз бірдеңені жоғалтсаңыз, ол туралы хабарлауыңыз керек...
Dialogue: 0,0:17:11.69,0:17:13.40,Default,,0,0,0,,Ух... мм...
Dialogue: 0,0:17:13.57,0:17:14.95,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:17:15.28,0:17:17.87,Default,,0,0,0,,… …
Dialogue: 0,0:17:17.99,0:17:20.08,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:17:20.62,0:17:21.95,Default,,0,0,0,,А... а...
Dialogue: 0,0:17:25.91,0:17:27.12,Default,,0,0,0,,Хэхехехе
Dialogue: 0,0:17:27.25,0:17:28.96,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:29.08,0:17:31.30,Default,,0,0,0,,Қайда ерте бара жатырсың?
Dialogue: 0,0:17:31.42,0:17:33.63,Default,,0,0,0,,Оңтүстік полюске қарай сәл әрірек
Dialogue: 0,0:17:33.92,0:17:35.88,Default,,0,0,0,,Мен кешкі асқа дейін үйде боламын.
Dialogue: 0,0:17:36.01,0:17:37.26,Default,,0,0,0,,Уа!
Dialogue: 0,0:17:37.43,0:17:38.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:39.09,0:17:40.64,Default,,0,0,0,,Атлантида?
Dialogue: 0,0:17:40.80,0:17:44.77,Default,,0,0,0,,Менің немере ағам Антарктида мұзының астында...
Dialogue: 0,0:17:44.89,0:17:48.60,Default,,0,0,0,,Елес көне өркениет ұйықтап жатыр деген аңыз бар...
Dialogue: 0,0:17:48.77,0:17:49.61,Default,,0,0,0,,Бұл шын мәнінде
Dialogue: 0,0:17:49.73,0:17:52.61,Default,,0,0,0,,Бұл Атлантида деп айтылады.
Dialogue: 0,0:17:52.78,0:17:53.65,Default,,0,0,0,,Хо…
Dialogue: 0,0:17:53.78,0:17:55.99,Default,,0,0,0,,Егер фантомдық өркениет Атлантида...
Dialogue: 0,0:17:56.11,0:18:00.07,Default,,0,0,0,,100 000 жыл бұрын да сақиналар жасауға болатын шығар, солай ма?
Dialogue: 0,0:18:00.20,0:18:01.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:01.41,0:18:04.62,Default,,0,0,0,,Сонымен ол Антарктиданың қай жерінде орналасқан? «Аталандес» бұл
Dialogue: 0,0:18:04.87,0:18:07.00,Default,,0,0,0,,Атлантида Сіз мұны білгенде—
Dialogue: 0,0:18:07.12,0:18:09.67,Default,,0,0,0,,Бұл енді иллюзия болмайды, солай ма?
Dialogue: 0,0:18:09.79,0:18:11.38,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:18:11.50,0:18:14.80,Default,,0,0,0,,А... Атлантида ма, жоқ па білмеймін...
Dialogue: 0,0:18:15.21,0:18:18.51,Default,,0,0,0,,Антарктидадағы мұздың астында бір нәрсе көмілген болуы мүмкін.
Dialogue: 0,0:18:19.01,0:18:20.97,Default,,0,0,0,,Мына картаны қарауларыңызды қалаймын.
Dialogue: 0,0:18:21.39,0:18:23.68,Default,,0,0,0,,Міне, кеше айсберг болған
Dialogue: 0,0:18:23.81,0:18:26.85,Default,,0,0,0,,Бұл жердегі мұхит ағыстары осылай көрінеді
Dialogue: 0,0:18:26.98,0:18:30.31,Default,,0,0,0,,Айсбергті осы мұхит ағысы алып жүрген болуы керек.
Dialogue: 0,0:18:30.65,0:18:32.77,Default,,0,0,0,,Егер бұл ағынды артқа қарай іздесек...
Dialogue: 0,0:18:33.32,0:18:38.15,Default,,0,0,0,,Антарктика континентінің бойымен, негізінен батысқа қарай бұрылып...
Dialogue: 0,0:18:53.88,0:18:56.76,Default,,0,0,0,,Жаңа ғана келдім
Dialogue: 0,0:18:57.13,0:18:59.51,Default,,0,0,0,,Айсбергтің туған жері.
Dialogue: 0,0:18:59.63,0:19:01.14,Default,,0,0,0,,Олай болса, осы жерде...
Dialogue: 0,0:19:01.26,0:19:02.72,Default,,0,0,0,,«Тамаранд»?
Dialogue: 0,0:19:03.10,0:19:06.18,Default,,0,0,0,,Жоқ, бұл сақинаның қатып қалған жері емес.
Dialogue: 0,0:19:06.43,0:19:09.89,Default,,0,0,0,,Сіз нені айтасыз? Айсберг осы жерден шықты ма?
Dialogue: 0,0:19:10.23,0:19:12.65,Default,,0,0,0,,Олай болса, мынаны қарағаныңызды қалаймын.
Dialogue: 0,0:19:13.19,0:19:18.82,Default,,0,0,0,,Антарктидада мұз шамамен 40 миллион жыл бұрын қалыптаса бастаған дейді.
Dialogue: 0,0:19:18.94,0:19:20.32,Default,,0,0,0,,Қар мұзға айналады—
Dialogue: 0,0:19:20.45,0:19:22.95,Default,,0,0,0,,Мұз барған сайын үлкейеді, ақырында—
Dialogue: 0,0:19:23.07,0:19:25.70,Default,,0,0,0,,«Мұз қабаты» деп аталатын үлкен мұздыққа айналады.
Dialogue: 0,0:19:25.87,0:19:27.04,Default,,0,0,0,,Қозғала бастады
Dialogue: 0,0:19:27.16,0:19:28.25,Default,,0,0,0,,Мұз - салмақ
Dialogue: 0,0:19:28.37,0:19:32.37,Default,,0,0,0,,Крахмал шәрбаты сияқты биіктен төменге қарай жылжиды.
Dialogue: 0,0:19:32.54,0:19:36.84,Default,,0,0,0,,Ал теңізге шыққанда толқындардың қозғалысы сізді одан әрі итермелейді...
Dialogue: 0,0:19:36.96,0:19:38.42,Default,,0,0,0,,Жыртылған
Dialogue: 0,0:19:38.76,0:19:40.92,Default,,0,0,0,,Бұл айсберг
Dialogue: 0,0:19:41.05,0:19:43.39,Default,,0,0,0,,Хаха~ Көріп тұрмын (Шидзука/Нобита) Ху~
Dialogue: 0,0:19:48.27,0:19:50.93,Default,,0,0,0,,Сонда бұл сақина қай жерде қатып қалған?
Dialogue: 0,0:19:51.64,0:19:54.73,Default,,0,0,0,,Осы жерден біз мұз ағынын жалғастырдық—
Dialogue: 0,0:19:54.86,0:19:57.77,Default,,0,0,0,,Материктің бір жерінде
Dialogue: 0,0:19:58.07,0:20:00.74,Default,,0,0,0,,Мына картамен жүр... (Сунео) Мұз астына қарасаң
Dialogue: 0,0:20:01.07,0:20:01.95,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:20:02.07,0:20:05.87,Default,,0,0,0,,Мен мұздың крахмал шәрбаты сияқты қозғалатынын елестете алмаймын.
Dialogue: 0,0:20:05.99,0:20:08.70,Default,,0,0,0,,Қалай болғанда да, бұдан былай...
Dialogue: 0,0:20:08.83,0:20:13.42,Default,,0,0,0,,Мен осы картадағы айсберг пайда болған жерге барғым келеді.
Dialogue: 0,0:20:13.87,0:20:14.67,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:14.79,0:20:16.17,Default,,0,0,0,,Барайық (Сунео) Иә, иә
Dialogue: 0,0:20:16.29,0:20:19.80,Default,,0,0,0,,Антарктидадағы «Хамарандты» ашу, ғасырдың ұлы жаңалығы!
Dialogue: 0,0:20:19.92,0:20:22.13,Default,,0,0,0,,Сақинаның иесін табыңыз!
Dialogue: 0,0:20:22.42,0:20:23.93,Default,,0,0,0,,Секір!!
Dialogue: 0,0:20:24.26,0:20:25.55,Default,,0,0,0,,ияйййййййййййййййййййййййййййййййййййй!
Dialogue: 0,0:20:27.60,0:20:29.10,Default,,0,0,0,,Иә... Йотто
Dialogue: 0,0:20:29.77,0:20:32.27,Default,,0,0,0,,Барлығың дайынсыңдар ма?
Dialogue: 0,0:20:36.15,0:20:38.07,Default,,0,0,0,,Бұл Антарктида ма?
Dialogue: 0,0:20:38.19,0:20:39.57,Default,,0,0,0,,Мен жұлдыздарды көремін
Dialogue: 0,0:20:39.69,0:20:42.90,Default,,0,0,0,,Дүниенің арғы жағында болғандықтан, қазір қыс.
Dialogue: 0,0:20:43.03,0:20:48.62,Default,,0,0,0,,Антарктидада қыста айлар бойы күн шықпайтын «полярлық түн» болады.
Dialogue: 0,0:20:48.91,0:20:50.37,Default,,0,0,0,,Әрқашан түн бола ма?
Dialogue: 0,0:20:50.66,0:20:52.33,Default,,0,0,0,,Абайлаңыз (Сунео) А?
Dialogue: 0,0:20:52.58,0:20:55.50,Default,,0,0,0,,Мұндағы температура дәл қазір 30 градус шамасында.
Dialogue: 0,0:20:55.62,0:20:58.75,Default,,0,0,0,,Есіктің сыртында -40 градус!
Dialogue: 0,0:20:58.88,0:21:02.51,Default,,0,0,0,,Бұл мүмкін емес, кірген бойда тоңып қаласыз.
Dialogue: 0,0:21:02.63,0:21:05.22,Default,,0,0,0,,Бұлбұлбұл... Жарайды.
Dialogue: 0,0:21:06.13,0:21:08.14,Default,,0,0,0,,Иә, бәріңіз мынаны киіңіздер.
Dialogue: 0,0:21:08.30,0:21:09.64,Default,,0,0,0,,Не?
Dialogue: 0,0:21:09.89,0:21:11.35,Default,,0,0,0,,Сіз оны киесіз бе? (Сунео) Бұл?
Dialogue: 0,0:21:11.47,0:21:12.27,Default,,0,0,0,,Иә
Dialogue: 0,0:21:12.39,0:21:13.18,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:21:14.39,0:21:17.40,Default,,0,0,0,,Яан, бұл полярлық барлау костюмі.
Dialogue: 0,0:21:17.81,0:21:23.32,Default,,0,0,0,,Сіз Антарктидада тайғанақсыз мұзбен жүріп, жайлы бола аласыз.
Dialogue: 0,0:21:25.32,0:21:25.99,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:26.24,0:21:27.66,Default,,0,0,0,,Сізге керемет көрінеді
Dialogue: 0,0:21:27.78,0:21:28.91,Default,,0,0,0,,Иә, иә, иә, иә!
Dialogue: 0,0:21:29.45,0:21:31.12,Default,,0,0,0,,Сіз ештеңе ұмыттыңыз ба?
Dialogue: 0,0:21:31.24,0:21:33.87,Default,,0,0,0,,Олай болса, жасайық!
Dialogue: 0,0:21:34.50,0:21:36.58,Default,,0,0,0,,Эй (Сунео) және яй
Dialogue: 0,0:21:38.46,0:21:39.50,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:42.88,0:21:46.88,Default,,0,0,0,,(цикада айқайы)
Dialogue: 0,0:21:50.89,0:21:52.76,Default,,0,0,0,,Уау~
Dialogue: 0,0:21:54.39,0:21:58.15,Default,,0,0,0,,Уау, бұл керемет! Қараңдаршы, жұлдыздар әдемі!
Dialogue: 0,0:22:01.19,0:22:03.78,Default,,0,0,0,,Қараңдар! ғимарат бар
Dialogue: 0,0:22:04.11,0:22:07.70,Default,,0,0,0,,Бұл Шоуа станциясы. Ол Антарктидада бақылау жүргізеді.
Dialogue: 0,0:22:07.82,0:22:12.20,Default,,0,0,0,,Уау! Хехехехехе
Dialogue: 0,0:22:12.45,0:22:15.12,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:22:15.25,0:22:17.37,Default,,0,0,0,,Жарайды! Бұл менің тауым!
Dialogue: 0,0:22:17.54,0:22:19.67,Default,,0,0,0,,Бұл не? Сен соншалықты жасырынсың! Міне, мен...
Dialogue: 0,0:22:19.79,0:22:23.59,Default,,0,0,0,,Әй, мұз қозғалатын сияқты емес.
Dialogue: 0,0:22:23.84,0:22:25.13,Default,,0,0,0,,Сіз қозғалып жатыр десеңіз де—
Dialogue: 0,0:22:25.26,0:22:29.30,Default,,0,0,0,,Тәулігіне небәрі бірнеше сантиметр, сондықтан оны қарап білу мүмкін емес. Хмм...
Dialogue: 0,0:22:29.43,0:22:31.55,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:22:32.10,0:22:34.18,Default,,0,0,0,,Хмм... Йотто
Dialogue: 0,0:22:35.06,0:22:36.56,Default,,0,0,0,,Хмм... Йотто
Dialogue: 0,0:22:36.68,0:22:39.48,Default,,0,0,0,,Мұз астына қалай қарайсың?
Dialogue: 0,0:22:40.44,0:22:42.90,Default,,0,0,0,,...
Dialogue: 0,0:22:46.49,0:22:47.61,Default,,0,0,0,,Не?Бұл
Dialogue: 0,0:22:48.11,0:22:51.91,Default,,0,0,0,,Мен аяғымның астына көмілген заттарды таба аламын.
Dialogue: 0,0:22:52.07,0:22:54.37,Default,,0,0,0,,Артқа бұрылып, көзіңізді жұмыңыз
Dialogue: 0,0:22:54.45,0:22:55.20,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:22:55.29,0:22:57.33,Default,,0,0,0,,Сізде толтыратын нәрсе жоқ па?
Dialogue: 0,0:22:57.45,0:22:59.29,Default,,0,0,0,,Лимон хош иісті кәмпит алуға болады ма?
Dialogue: 0,0:22:59.41,0:23:01.58,Default,,0,0,0,,Иә, хехе
Dialogue: 0,0:23:01.92,0:23:03.84,Default,,0,0,0,,Оған қарамаңыз
Dialogue: 0,0:23:06.05,0:23:08.30,Default,,0,0,0,,Көзіңізді ашып, сымды ысқылаңыз
Dialogue: 0,0:23:09.05,0:23:10.34,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:23:11.05,0:23:12.97,Default,,0,0,0,,Егер сымды сүртсеңіз—
Dialogue: 0,0:23:13.05,0:23:16.43,Default,,0,0,0,,Мен айналамда көмілген заттарды таба аламын.
Dialogue: 0,0:23:16.56,0:23:18.18,Default,,0,0,0,,Хмм.
Dialogue: 0,0:23:18.56,0:23:19.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:19.89,0:23:21.31,Default,,0,0,0,,Уау... уау
Dialogue: 0,0:23:24.61,0:23:26.15,Default,,0,0,0,,Неғұрлым көп ысқыласаңыз, соғұрлым көп ысқылайсыз—
Dialogue: 0,0:23:26.27,0:23:29.74,Default,,0,0,0,,Сіз тереңірек және кеңірек жерлерді іздей аласыз.
Dialogue: 0,0:23:29.86,0:23:31.28,Default,,0,0,0,,Фухун Йотто
Dialogue: 0,0:23:31.61,0:23:33.49,Default,,0,0,0,,Осыны ысқылау арқылы жалғастырсаңыз...
Dialogue: 0,0:23:33.62,0:23:36.70,Default,,0,0,0,,Мұз астына көмілген заттарды табуға болады.
Dialogue: 0,0:23:37.12,0:23:39.16,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:23:39.70,0:23:42.62,Default,,0,0,0,,Жарайды, бірден кетейік!
Dialogue: 0,0:23:42.79,0:23:45.17,Default,,0,0,0,,Сонымен... бұл жұмысты қалай жасауға болады?
Dialogue: 0,0:23:45.79,0:23:47.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:47.63,0:23:51.01,Default,,0,0,0,,Бұл полярлық зерттеулерге арналған Пихёро арқаны және ноталық музыка.
Dialogue: 0,0:23:51.13,0:23:53.84,Default,,0,0,0,,Біріншіден, шақыру әні.
Dialogue: 0,0:23:54.39,0:23:58.39,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:24:10.90,0:24:11.86,Default,,0,0,0,,дейін
Dialogue: 0,0:24:11.99,0:24:15.99,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:24:20.20,0:24:21.96,Default,,0,0,0,,Бұл «жалғастыру» әні
Dialogue: 0,0:24:22.08,0:24:24.88,Default,,0,0,0,,Әнге байланысты сіз 200км/сағ максималды жылдамдыққа жете аласыз.
Dialogue: 0,0:24:25.00,0:24:27.09,Default,,0,0,0,,Керемет~ (Шидзука/Нобита) Уау~
Dialogue: 0,0:24:44.19,0:24:45.19,Default,,0,0,0,,Уау~
Dialogue: 0,0:24:45.35,0:24:49.36,Default,,0,0,0,,(Пингвин дыбысы)
Dialogue: 0,0:24:55.86,0:24:58.74,Default,,0,0,0,,(Нобита мен Шизуканың күлкісі)
Dialogue: 0,0:25:02.00,0:25:04.79,Default,,0,0,0,,Кеш болды! Не?!
Dialogue: 0,0:25:05.29,0:25:09.09,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:25:09.21,0:25:09.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:12.67,0:25:13.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:16.64,0:25:18.22,Default,,0,0,0,,Ах! (Нобита) Иә?
Dialogue: 0,0:25:20.72,0:25:21.60,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:25:21.72,0:25:25.73,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:25:27.65,0:25:30.77,Default,,0,0,0,,Ух... (Сунео мен Джианның күлкілері)
Dialogue: 0,0:25:30.90,0:25:32.98,Default,,0,0,0,,Ах, а, а...
Dialogue: 0,0:25:33.74,0:25:35.32,Default,,0,0,0,,Салқын
Dialogue: 0,0:25:35.82,0:25:37.24,Default,,0,0,0,,Иә...
Dialogue: 0,0:25:43.91,0:25:46.96,Default,,0,0,0,,(Джан мен Сунеоның күлкісі)
Dialogue: 0,0:25:47.08,0:25:48.33,Default,,0,0,0,,（）
Dialogue: 0,0:25:48.46,0:25:49.83,Default,,0,0,0,,(Сунеоның айқайы)
Dialogue: 0,0:25:51.09,0:25:52.88,Default,,0,0,0,,Ах... (Нобита) Уф.
Dialogue: 0,0:25:53.42,0:25:58.26,Default,,0,0,0,,Бір минут күтіңіз! Қатты соқ!
Dialogue: 0,0:25:59.09,0:26:03.10,Default,,0,0,0,,(Сидзука мен Нобитаның тарсылдаған дауысы)
Dialogue: 0,0:26:04.47,0:26:08.35,Default,,0,0,0,,(Сунеоның күшті дауысы)
Dialogue: 0,0:26:08.48,0:26:10.15,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:26:21.95,0:26:24.58,Default,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,0:26:25.25,0:26:27.37,Default,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,0:26:28.25,0:26:31.46,Default,,0,0,0,,Ах! (Сунео) Жақсысың ба?
Dialogue: 0,0:26:31.84,0:26:35.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:26:36.88,0:26:40.30,Default,,0,0,0,,Ах (Нобита/Шидзука) Ах...
Dialogue: 0,0:26:40.68,0:26:44.68,Default,,0,0,0,,(Сунео мен Джианның күш айқайы)
Dialogue: 0,0:26:51.86,0:26:53.90,Default,,0,0,0,,Уау~
Dialogue: 0,0:26:56.36,0:26:57.36,Default,,0,0,0,,​​Не!
Dialogue: 0,0:26:58.49,0:27:00.99,Default,,0,0,0,,Уау~
Dialogue: 0,0:27:01.16,0:27:03.16,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:27:20.22,0:27:23.76,Default,,0,0,0,,Уф... уф... Иә?
Dialogue: 0,0:27:30.52,0:27:34.11,Default,,0,0,0,,(барлығы ыңылдап)
Dialogue: 0,0:27:34.65,0:27:37.11,Default,,0,0,0,,Сіз мұнымен алға жылжи алмайсыз!
Dialogue: 0,0:27:37.78,0:27:39.78,Default,,0,0,0,,Бивуак осында!
Dialogue: 0,0:27:40.90,0:27:42.20,Default,,0,0,0,,Пааааа! Апыр-ай!
Dialogue: 0,0:27:42.32,0:27:43.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:44.70,0:27:46.08,Default,,0,0,0,,Шатыр туралы не істеуім керек?
Dialogue: 0,0:27:46.20,0:27:47.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:47.37,0:27:48.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:51.75,0:27:52.75,Default,,0,0,0,,Ei
Dialogue: 0,0:27:52.87,0:27:55.38,Default,,0,0,0,,Уау! Уф Уау
Dialogue: 0,0:27:57.09,0:28:02.84,Default,,0,0,0,,Йоттототото...
Dialogue: 0,0:28:05.85,0:28:09.39,Default,,0,0,0,,Ах... Бұл курс сізге шынымен қолайлы ма?
Dialogue: 0,0:28:09.56,0:28:11.52,Default,,0,0,0,,Мен шаршадым, балақай.
Dialogue: 0,0:28:11.64,0:28:14.27,Default,,0,0,0,,Ол шынымен бар ма? «Камаван өлімі»
Dialogue: 0,0:28:14.56,0:28:19.28,Default,,0,0,0,,А... бүгінге бітті, боран тоқтаған соң үйге қайтайық.
Dialogue: 0,0:28:19.57,0:28:22.32,Default,,0,0,0,,Күте тұрыңыз, мен осы уақытқа дейін келдім.
Dialogue: 0,0:28:22.45,0:28:24.36,Default,,0,0,0,,Нобита, сен ештеңе істеп жатқан жоқсың.
Dialogue: 0,0:28:24.49,0:28:28.33,Default,,0,0,0,,Бұл дұрыс емес. Қазір де сымды осылай ысқылап жүрмін...
Dialogue: 0,0:28:28.45,0:28:29.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:29.83,0:28:31.45,Default,,0,0,0,,Сіз реакция жасайсыз ба?
Dialogue: 0,0:28:31.91,0:28:33.08,Default,,0,0,0,,Сыртта!
Dialogue: 0,0:28:35.75,0:28:38.46,Default,,0,0,0,,Уф... ана жаққа қара!
Dialogue: 0,0:28:38.59,0:28:40.76,Default,,0,0,0,,Хмф! Апыр-ай!
Dialogue: 0,0:28:40.88,0:28:42.59,Default,,0,0,0,,Ах, о... Ах, хихе...
Dialogue: 0,0:28:42.76,0:28:44.38,Default,,0,0,0,,Ех хе хе аха
Dialogue: 0,0:28:46.34,0:28:47.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:54.60,0:28:56.60,Default,,0,0,0,,Бұл реакция...
Dialogue: 0,0:28:56.73,0:28:57.90,Default,,0,0,0,,Ах
Dialogue: 0,0:28:58.02,0:28:59.23,Default,,0,0,0,,Осы жерде!
Dialogue: 0,0:28:59.36,0:29:00.28,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:29:03.49,0:29:05.82,Default,,0,0,0,,Алдымен мынаны пайдаланыңыз...
Dialogue: 0,0:29:05.95,0:29:06.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:07.03,0:29:07.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:29:07.99,0:29:09.62,Default,,0,0,0,,А, мен тоңып қалдым...
Dialogue: 0,0:29:09.74,0:29:12.37,Default,,0,0,0,,Уау...
Dialogue: 0,0:29:12.95,0:29:16.29,Default,,0,0,0,,Уау, біреу! (4 адам) Әй?
Dialogue: 0,0:29:16.46,0:29:19.46,Default,,0,0,0,,Маған көмектесіңіз~
Dialogue: 0,0:29:19.63,0:29:23.63,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:29:26.51,0:29:28.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:29:28.30,0:29:30.81,Default,,0,0,0,,Бұл қаланың жауабының өлшемі.
Dialogue: 0,0:29:30.97,0:29:34.23,Default,,0,0,0,,Жарайды, онда... Жарайды.
Dialogue: 0,0:29:34.35,0:29:38.56,Default,,0,0,0,,Atttttttttttttttttttttttttttttttttttttttttttttttttt...
Dialogue: 0,0:29:38.69,0:29:40.48,Default,,0,0,0,,Сәлем! (Сунео және басқалар) Ах!
Dialogue: 0,0:29:41.69,0:29:44.69,Default,,0,0,0,,Керемет! (Сунео) Жай ғана оны ақырын шығарыңыз!
Dialogue: 0,0:29:45.24,0:29:48.16,Default,,0,0,0,,Кешіріңіз, кешіріңіз (Нобита) Өтінемін тез қойыңыз~
Dialogue: 0,0:29:48.70,0:29:50.83,Default,,0,0,0,,Бұл мұз асты барлау көлігі деп аталады.
Dialogue: 0,0:29:50.95,0:29:54.66,Default,,0,0,0,,Олар мұздың астынан мыңдаған метр тереңдікке үңіле алады.
Dialogue: 0,0:29:55.25,0:29:56.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:56.92,0:29:59.71,Default,,0,0,0,,Орыныңызға жеткенде қауіпсіздік белдігін байлаңыз.
Dialogue: 0,0:30:00.00,0:30:01.00,Default,,0,0,0,,Э-э-э—
Dialogue: 0,0:30:01.17,0:30:04.51,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:30:04.76,0:30:08.64,Default,,0,0,0,,Қозғалтқышты іске қосу Гиробасқаруды растау Радарларды қосу
Dialogue: 0,0:30:08.76,0:30:10.26,Default,,0,0,0,,Барлығың дайынсыңдар ма?
Dialogue: 0,0:30:10.39,0:30:12.72,Default,,0,0,0,,Әрине, сіз дайынсыз.
Dialogue: 0,0:30:12.85,0:30:14.27,Default,,0,0,0,,Секір!!
Dialogue: 0,0:30:20.31,0:30:23.19,Default,,0,0,0,,Жақсы бұрыш, мұз асты барлау көлігі ұшып жатыр!
Dialogue: 0,0:30:29.36,0:30:32.49,Default,,0,0,0,,Көлденең ось Ешбір ауытқулар жоқ Курс көрсеткіші жақсы!
Dialogue: 0,0:30:35.45,0:30:39.17,Default,,0,0,0,,X осі 2% плюс Y осі 3% минус
Dialogue: 0,0:30:39.29,0:30:41.50,Default,,0,0,0,,Ах! Қарашы, Нобита!
Dialogue: 0,0:30:41.63,0:30:43.59,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:30:44.05,0:30:45.67,Default,,0,0,0,,Мұз...
Dialogue: 0,0:30:46.05,0:30:47.80,Default,,0,0,0,,Жұлдыз сияқты
Dialogue: 0,0:30:48.13,0:30:50.22,Default,,0,0,0,,Мұзда қалған ауа —
Dialogue: 0,0:30:50.34,0:30:52.72,Default,,0,0,0,,Жарықты шағылыстырады.
Dialogue: 0,0:30:59.64,0:31:02.98,Default,,0,0,0,,Антарктика мұзы шынымен де қалың ма?
Dialogue: 0,0:31:03.40,0:31:06.19,Default,,0,0,0,,Ең қалың жерінде 4000 метр
Dialogue: 0,0:31:06.28,0:31:07.49,Default,,0,0,0,,Керемет!
Dialogue: 0,0:31:07.57,0:31:09.45,Default,,0,0,0,,Ол Фудзи тауынан үлкен!
Dialogue: 0,0:31:09.57,0:31:11.61,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:31:11.74,0:31:15.12,Default,,0,0,0,,Иә? Мен әлі онша тереңдеген жоқпын.
Dialogue: 0,0:31:15.24,0:31:18.00,Default,,0,0,0,,(барлығы ыңылдап)
Dialogue: 0,0:31:23.92,0:31:25.50,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:31:26.05,0:31:27.21,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:31:27.59,0:31:30.88,Default,,0,0,0,,Ол Антарктидадағы мұздың астында болуы керек...
Dialogue: 0,0:31:31.05,0:31:32.76,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:31:32.89,0:31:36.89,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:31:47.65,0:31:49.07,Default,,0,0,0,,Ах! (дабыл дыбысы)
Dialogue: 0,0:31:49.19,0:31:54.20,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:31:58.29,0:32:00.75,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:32:03.75,0:32:06.25,Default,,0,0,0,,Уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:32:07.71,0:32:09.30,Default,,0,0,0,,Йокогама Токионың бір бөлігі ғой!
Dialogue: 0,0:32:14.18,0:32:16.22,Default,,0,0,0,,Уау! (Дораэмон/Нобита) А?
Dialogue: 0,0:32:16.35,0:32:18.06,Default,,0,0,0,,Не болды? О, сәл күте тұрыңыз
Dialogue: 0,0:32:20.64,0:32:22.52,Default,,0,0,0,,А, мынау... мынау!
Dialogue: 0,0:32:29.48,0:32:31.74,Default,,0,0,0,,Не? Онда барайық
Dialogue: 0,0:32:34.03,0:32:38.24,Default,,0,0,0,,Күте тұрыңыз, Джан! Бұл ғасыр жаңалығы!
Dialogue: 0,0:32:41.41,0:32:43.04,Default,,0,0,0,,Нобита-кун, сол пішін!
Dialogue: 0,0:32:43.16,0:32:43.67,Default,,0,0,0,,Иә
Dialogue: 0,0:32:46.83,0:32:48.25,Default,,0,0,0,,Бірдей пішін!
Dialogue: 0,0:32:48.38,0:32:51.59,Default,,0,0,0,,Сақинаның қатып қалған жеріне күмән жоқ.
Dialogue: 0,0:32:51.71,0:32:52.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:53.05,0:32:55.09,Default,,0,0,0,,Ішке қалай кіруге болады?
Dialogue: 0,0:32:55.22,0:32:59.18,Default,,0,0,0,,Хм... Ешқайда кіреберіс жоқ.
Dialogue: 0,0:32:59.31,0:33:02.06,Default,,0,0,0,,Сым осы мұнараға әсер етті.
Dialogue: 0,0:33:02.18,0:33:03.64,Default,,0,0,0,,Хмм... бірақ—
Dialogue: 0,0:33:03.77,0:33:06.94,Default,,0,0,0,,Менің ойымша, бұл реакция одан да күштірек болды.
Dialogue: 0,0:33:07.06,0:33:08.90,Default,,0,0,0,,О, күте тұрыңыз! Апыр-ай!
Dialogue: 0,0:33:09.36,0:33:11.15,Default,,0,0,0,,О... жақсысың ба?
Dialogue: 0,0:33:11.28,0:33:14.36,Default,,0,0,0,,Сіз шынымен... иә?
Dialogue: 0,0:33:15.53,0:33:17.49,Default,,0,0,0,,Дораэмонға қараңыз
Dialogue: 0,0:33:30.04,0:33:31.96,Default,,0,0,0,,Қала мұздады
Dialogue: 0,0:33:32.09,0:33:34.76,Default,,0,0,0,,Сым осылай әрекет етті.
Dialogue: 0,0:33:34.88,0:33:35.76,Default,,0,0,0,,Мына жерде! (Сунео) Иә?
Dialogue: 0,0:33:36.22,0:33:37.89,Default,,0,0,0,,Мұнара қабырғасына қараңыз.
Dialogue: 0,0:33:38.47,0:33:39.76,Default,,0,0,0,,Тесік бар
Dialogue: 0,0:33:39.89,0:33:42.06,Default,,0,0,0,,Ол жерден кіруге болмай ма?
Dialogue: 0,0:33:42.22,0:33:43.56,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:33:43.68,0:33:45.60,Default,,0,0,0,,Жақсы... иә, бұл
Dialogue: 0,0:33:46.02,0:33:47.60,Default,,0,0,0,,Иә! Жақсы жұмыс
Dialogue: 0,0:34:01.33,0:34:03.87,Default,,0,0,0,,Ішінде қатып қалмаған сияқты.
Dialogue: 0,0:34:04.00,0:34:06.91,Default,,0,0,0,,Сәлем! Онда біреу бар ма?
Dialogue: 0,0:34:16.13,0:34:17.68,Default,,0,0,0,,Бірдеңе бар
Dialogue: 0,0:34:17.76,0:34:19.93,Default,,0,0,0,,Мүмкін Атлантиданың қазынасы шығар?
Dialogue: 0,0:34:20.05,0:34:21.43,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:34:21.72,0:34:23.14,Default,,0,0,0,,Мұз!
Dialogue: 0,0:34:23.26,0:34:24.39,Default,,0,0,0,,Бір нәрсе қатып қалды
Dialogue: 0,0:34:24.93,0:34:26.60,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:34:28.64,0:34:31.06,Default,,0,0,0,,Мына түкті нәрсе не?
Dialogue: 0,0:34:31.90,0:34:36.03,Default,,0,0,0,,Хмм... Мен бұл қазына емес деп ойлаймын...
Dialogue: 0,0:34:36.15,0:34:37.65,Default,,0,0,0,,Әй, ау, қозғалды!
Dialogue: 0,0:34:37.78,0:34:41.45,Default,,0,0,0,,(Алыптардың айқайы)
Dialogue: 0,0:34:46.50,0:34:48.12,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,0:34:49.87,0:34:51.58,Default,,0,0,0,,Мофу
Dialogue: 0,0:34:52.42,0:34:54.30,Default,,0,0,0,,Мамонт?
Dialogue: 0,0:34:54.42,0:34:56.46,Default,,0,0,0,,Бұл сәл басқаша сияқты...
Dialogue: 0,0:34:56.63,0:34:59.18,Default,,0,0,0,,Эй, мүмкін сен Атлантикалық шығарсың?
Dialogue: 0,0:34:59.30,0:35:01.89,Default,,0,0,0,,Негізі мен сақинаның иесін іздеп жүрмін.
Dialogue: 0,0:35:02.01,0:35:04.01,Default,,0,0,0,,Мофу? (Нобита) Мүмкін сен...
Dialogue: 0,0:35:04.14,0:35:05.64,Default,,0,0,0,,Пао! (Нобита) Уф...
Dialogue: 0,0:35:05.81,0:35:10.14,Default,,0,0,0,,Мофу Мофу Мофу~ (Нобита) Уфуфу қытықтайды
Dialogue: 0,0:35:10.65,0:35:13.65,Default,,0,0,0,,Не? Ол (Сунео) маған байланған сияқты.
Dialogue: 0,0:35:15.69,0:35:16.73,Default,,0,0,0,,Мофф~
Dialogue: 0,0:35:17.94,0:35:20.40,Default,,0,0,0,,Үлпілдек (Нобита) сөмке?
Dialogue: 0,0:35:20.53,0:35:22.24,Default,,0,0,0,,Маған бересің бе? Мофф
Dialogue: 0,0:35:22.37,0:35:24.83,Default,,0,0,0,,Мофф~ Мофф (Нобита) Уау
Dialogue: 0,0:35:27.62,0:35:28.96,Default,,0,0,0,,Не?Бұл
Dialogue: 0,0:35:29.08,0:35:30.00,Default,,0,0,0,,Мофф~
Dialogue: 0,0:35:30.37,0:35:33.92,Default,,0,0,0,,Хм... (Нобита) Оның не екенін білесің бе?
Dialogue: 0,0:35:34.04,0:35:37.96,Default,,0,0,0,,Хмм, мен оны бір жерден көргендей болдым...
Dialogue: 0,0:35:38.09,0:35:38.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:39.09,0:35:42.47,Default,,0,0,0,,Мофф~ Пао~
Dialogue: 0,0:35:42.55,0:35:44.22,Default,,0,0,0,,Қылықтайды, тоқтат.
Dialogue: 0,0:35:44.60,0:35:47.18,Default,,0,0,0,,Ол бұл жолы Дора-чанға байланған сияқты
Dialogue: 0,0:35:47.35,0:35:50.52,Default,,0,0,0,,Эй Нобита, сен бұл жігіт туралы білесің бе?
Dialogue: 0,0:35:50.85,0:35:53.40,Default,,0,0,0,,Жоқ, менің ойымша, бұл бірінші рет.
Dialogue: 0,0:35:53.52,0:35:54.98,Default,,0,0,0,,Барлығы осылай! (3 адам) Әй?
Dialogue: 0,0:35:55.31,0:35:57.15,Default,,0,0,0,,Жалғасы төменде!
Dialogue: 0,0:36:00.44,0:36:01.65,Default,,0,0,0,,қою қара
Dialogue: 0,0:36:01.78,0:36:04.12,Default,,0,0,0,,Бұл қанша уақытқа созылады деп ойлаймын
Dialogue: 0,0:36:04.24,0:36:08.12,Default,,0,0,0,,Мына бір реттік жасанды күнді қолданайық
Dialogue: 0,0:36:08.24,0:36:10.79,Default,,0,0,0,,Ол бар болғаны 10 минутқа жарқырап жанады.
Dialogue: 0,0:36:17.04,0:36:19.88,Default,,0,0,0,,Мұнда бір нәрсе бар. Барайық.
Dialogue: 0,0:36:20.01,0:36:21.67,Default,,0,0,0,,А... сәл күте тұрыңыз.
Dialogue: 0,0:36:22.26,0:36:24.47,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:36:25.68,0:36:26.85,Default,,0,0,0,,Дио…
Dialogue: 0,0:36:26.97,0:36:29.97,Default,,0,0,0,,Пао~ (Нобита) Ооо... күте тұр!
Dialogue: 0,0:36:33.06,0:36:34.19,Default,,0,0,0,,Джанға қара!
Dialogue: 0,0:36:34.56,0:36:36.40,Default,,0,0,0,,Тағы бірдеңе қатып қалды.
Dialogue: 0,0:36:38.36,0:36:42.36,Default,,0,0,0,,Бұл жолы мамонт емес сияқты...
Dialogue: 0,0:36:42.49,0:36:44.41,Default,,0,0,0,,Эй, бұл болуы мүмкін ...
Dialogue: 0,0:36:44.57,0:36:47.58,Default,,0,0,0,,Уф... Не болды?
Dialogue: 0,0:36:48.33,0:36:49.58,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:36:53.29,0:36:55.63,Default,,0,0,0,,Мен... Мен тоңып қалдым.
Dialogue: 0,0:36:57.42,0:36:59.50,Default,,0,0,0,,Бұл Дораемон.
Dialogue: 0,0:36:59.63,0:37:02.88,Default,,0,0,0,,Не? Ммм...
Dialogue: 0,0:37:04.80,0:37:06.97,Default,,0,0,0,,100 000 жыл бұрын мұздатылған
Dialogue: 0,0:37:07.43,0:37:09.14,Default,,0,0,0,,Сол сақинамен бірдей.
Dialogue: 0,0:37:09.26,0:37:11.06,Default,,0,0,0,,«Мұз апатының аспектілері»
Dialogue: 0,0:37:11.27,0:37:13.64,Default,,0,0,0,,Дорами-чанның болжамы дұрыс болды.
Dialogue: 0,0:37:13.89,0:37:16.81,Default,,0,0,0,,Күте тұрыңыз, мен әлі тоңған жоқпын.
Dialogue: 0,0:37:16.94,0:37:18.86,Default,,0,0,0,,Бірдеңені жасап көрейік...
Dialogue: 0,0:37:19.32,0:37:22.19,Default,,0,0,0,,Бұл жігіт те қозғала бастауы мүмкін.
Dialogue: 0,0:37:25.57,0:37:27.82,Default,,0,0,0,,Иә? Бірақ бұл...
Dialogue: 0,0:37:28.32,0:37:30.58,Default,,0,0,0,,Бұл не? Бұл тас емес пе?
Dialogue: 0,0:37:30.70,0:37:33.29,Default,,0,0,0,,Бірақ неге Дора-чан тасы осында?
Dialogue: 0,0:37:33.79,0:37:35.79,Default,,0,0,0,,Мо! мофу
Dialogue: 0,0:37:36.29,0:37:37.42,Default,,0,0,0,,Не болды? Урибо
Dialogue: 0,0:37:37.54,0:37:40.38,Default,,0,0,0,,Жоқ, Урибо - қабан.
Dialogue: 0,0:37:40.50,0:37:43.30,Default,,0,0,0,,Не? Сонымен, мамонт баласын қалай атайсыз?
Dialogue: 0,0:37:43.46,0:37:46.05,Default,,0,0,0,,Хмм, кішкентай мамонт? Моху!
Dialogue: 0,0:37:49.05,0:37:52.68,Default,,0,0,0,,(Ямитемнің ырылдауы)
Dialogue: 0,0:37:52.97,0:37:55.14,Default,,0,0,0,,Дораемон пингвинге айналады ма?
Dialogue: 0,0:37:55.31,0:37:56.81,Default,,0,0,0,,Мен пингвин емеспін
Dialogue: 0,0:37:56.98,0:37:59.65,Default,,0,0,0,,Уф
Dialogue: 0,0:37:59.77,0:38:03.78,Default,,0,0,0,,(Ямитемнің ырылдауы)
Dialogue: 0,0:38:04.74,0:38:06.90,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:38:07.03,0:38:08.78,Default,,0,0,0,,(Ямитемнің дауысы)
Dialogue: 0,0:38:09.32,0:38:11.70,Default,,0,0,0,,(Ямитемнің ырылдауы)
Dialogue: 0,0:38:11.83,0:38:13.70,Default,,0,0,0,,Мофу Мофу (Нобита) Ахх...
Dialogue: 0,0:38:13.83,0:38:16.21,Default,,0,0,0,,Уау! Ой... аа
Dialogue: 0,0:38:16.41,0:38:17.16,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,0:38:23.67,0:38:25.17,Default,,0,0,0,,Мм... м... мінекей!
Dialogue: 0,0:38:29.14,0:38:30.43,Default,,0,0,0,,Ех!
Dialogue: 0,0:38:30.55,0:38:33.14,Default,,0,0,0,,ол кеше ғана болғандай сезіледі.
Dialogue: 0,0:38:37.10,0:38:38.02,Default,,0,0,0,,Ху~ Мофуу
Dialogue: 0,0:38:38.31,0:38:40.60,Default,,0,0,0,,күрсіну... Бұл көмектесті.
Dialogue: 0,0:38:40.81,0:38:43.65,Default,,0,0,0,,Дорэмон пингвинге айналып, сізге шабуыл жасайды ма?
Dialogue: 0,0:38:43.77,0:38:46.15,Default,,0,0,0,,Мына жігіт бірдеңе айтып тұрды.
Dialogue: 0,0:38:46.28,0:38:48.49,Default,,0,0,0,,Ол шынымен ашулы болып көрінді.
Dialogue: 0,0:38:52.83,0:38:57.33,Default,,0,0,0,,Мен осыдан 100 000 жыл бұрын не болды деп ойлаймын.
Dialogue: 0,0:38:58.91,0:38:59.92,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:39:00.04,0:39:01.71,Default,,0,0,0,,Тағы, тағы!
Dialogue: 0,0:39:01.83,0:39:05.71,Default,,0,0,0,,Уақыт машинасын сақина қатқанға дейін 100 000 жылға алайық!
Dialogue: 0,0:39:05.84,0:39:08.30,Default,,0,0,0,,Сонда не болғанын білесіз.
Dialogue: 0,0:39:08.42,0:39:09.22,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:39:09.51,0:39:13.39,Default,,0,0,0,,Жақсы! Олай болса, Нобита-кунның бөлмесіне қайтайық... Аа...
Dialogue: 0,0:39:13.55,0:39:14.39,Default,,0,0,0,,Дааааа!
Dialogue: 0,0:39:14.97,0:39:17.73,Default,,0,0,0,,Мен есікті барлық жерде ұмытып кетіппін!
Dialogue: 0,0:39:17.89,0:39:19.39,Default,,0,0,0,,Не?!
Dialogue: 0,0:39:19.56,0:39:21.02,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:39:21.15,0:39:23.06,Default,,0,0,0,,Жарайды, одан да жақсысы бар.
Dialogue: 0,0:39:26.40,0:39:29.20,Default,,0,0,0,,Ол 100 000 жыл бұрын орнатылған...
Dialogue: 0,0:39:29.90,0:39:30.61,Default,,0,0,0,,Иә
Dialogue: 0,0:39:30.74,0:39:33.37,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:39:33.66,0:39:35.12,Default,,0,0,0,,Барлығы ұстаныңыз!
Dialogue: 0,0:39:35.24,0:39:37.62,Default,,0,0,0,,Осыны кисеңіз, ешқайда қозғала алмайсыз...
Dialogue: 0,0:39:37.75,0:39:41.08,Default,,0,0,0,,Тек уақытты еркін жылжытуға болады.
Dialogue: 0,0:39:48.38,0:39:52.97,Default,,0,0,0,,45 000 жыл бұрын 50 000 жыл бұрын 55 000 жыл бұрын
Dialogue: 0,0:39:53.09,0:39:56.18,Default,,0,0,0,,60 000 жыл бұрын 65 000 жыл бұрын
Dialogue: 0,0:39:56.31,0:39:59.18,Default,,0,0,0,,70 000 жыл бұрын 75 000 жыл бұрын
Dialogue: 0,0:40:00.02,0:40:03.94,Default,,0,0,0,,80 000 жыл бұрын 85 000 жыл бұрын
Dialogue: 0,0:40:04.23,0:40:06.36,Default,,0,0,0,,90 000 жыл бұрын (Сунео) Ах, а...
Dialogue: 0,0:40:06.48,0:40:09.19,Default,,0,0,0,,95 000 жыл бұрын (Сунео) Уау, уау...
Dialogue: 0,0:40:09.32,0:40:12.03,Default,,0,0,0,,100 000 жыл бұрын! (Сунео) Ахх...
Dialogue: 0,0:40:15.66,0:40:18.99,Default,,0,0,0,,Уау... Уф
Dialogue: 0,0:40:19.58,0:40:22.08,Default,,0,0,0,,Бұл жер 100 000 жыл бұрын болған ба?
Dialogue: 0,0:40:22.29,0:40:26.46,Default,,0,0,0,,А... міне, мұз кетіп қалды!
Dialogue: 0,0:40:28.30,0:40:30.88,Default,,0,0,0,,Сол пингвин де жоғалып кетті.
Dialogue: 0,0:40:31.01,0:40:33.38,Default,,0,0,0,,Мұнда бірдеңе болады.
Dialogue: 0,0:40:34.80,0:40:35.59,Default,,0,0,0,,А...
Dialogue: 0,0:40:35.97,0:40:39.64,Default,,0,0,0,,Біз көп адаммен бірге өткенге саяхат жасағандықтан, батарея тез таусылып жатыр...
Dialogue: 0,0:40:39.77,0:40:40.72,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:40:40.85,0:40:43.56,Default,,0,0,0,,Иә! Төтенше жағдайда қосалқы батареяларым бар.
Dialogue: 0,0:40:43.81,0:40:44.94,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:40:47.31,0:40:49.15,Default,,0,0,0,,Артқы жағында шам бар
Dialogue: 0,0:40:49.32,0:40:51.07,Default,,0,0,0,,Ашу керек емес пе?
Dialogue: 0,0:40:51.24,0:40:52.78,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:40:52.90,0:40:54.16,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:40:54.36,0:40:56.66,Default,,0,0,0,,Иә...
Dialogue: 0,0:40:56.82,0:40:58.74,Default,,0,0,0,,Не істеп жатырсың! Сіздер де көмектесе аласыздар!
Dialogue: 0,0:40:58.87,0:41:01.12,Default,,0,0,0,,Дегенмен, заттары көп екен.
Dialogue: 0,0:41:01.25,0:41:05.71,Default,,0,0,0,,Жақсы, жақсы...
Dialogue: 0,0:41:05.83,0:41:08.13,Default,,0,0,0,,Киіз үй Киіз үй
Dialogue: 0,0:41:08.63,0:41:09.71,Default,,0,0,0,,Ах! а!
Dialogue: 0,0:41:09.92,0:41:11.55,Default,,0,0,0,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,0:41:11.67,0:41:14.84,Default,,0,0,0,,А? Бұл... міне!
Dialogue: 0,0:41:18.35,0:41:19.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:23.98,0:41:28.11,Default,,0,0,0,,Ах... қала! Ол әлі мұздатылған жоқ!
Dialogue: 0,0:41:28.23,0:41:30.19,Default,,0,0,0,,Керемет! (Сунео) Уау!
Dialogue: 0,0:41:30.36,0:41:33.28,Default,,0,0,0,,Антарктида тоңғанға дейінгі уақытқа келдің.
Dialogue: 0,0:41:33.40,0:41:34.78,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:41:34.90,0:41:39.87,Default,,0,0,0,,Тіпті 100 000 жыл бұрын Антарктида мұзбен жабылуы керек еді.
Dialogue: 0,0:41:40.03,0:41:42.58,Default,,0,0,0,,А... Бұл біз түскен мұнара ма?
Dialogue: 0,0:41:43.08,0:41:44.71,Default,,0,0,0,,Сол Косаку Каваджири, иіліп-жығылып, жалтақтайды.
Dialogue: 0,0:41:50.21,0:41:52.46,Default,,0,0,0,,Аспан төбеде көрінеді
Dialogue: 0,0:41:52.59,0:41:56.22,Default,,0,0,0,,Өйткені, біз әлі де Антарктида мұзының астындамыз.
Dialogue: 0,0:41:56.38,0:41:57.38,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:41:57.51,0:42:01.26,Default,,0,0,0,,Yahoo! Эй, ол кім?
Dialogue: 0,0:42:01.68,0:42:07.31,Default,,0,0,0,,Аталандес тұрғындары~ Сіз мені естисіз бе~ Ах...
Dialogue: 0,0:42:12.90,0:42:14.61,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:42:14.78,0:42:16.40,Default,,0,0,0,,Өте ескі көрінеді
Dialogue: 0,0:42:16.57,0:42:18.41,Default,,0,0,0,,Адамдар бар ма?
Dialogue: 0,0:42:18.57,0:42:20.57,Default,,0,0,0,,Сәлем! сәл төмен
Dialogue: 0,0:42:20.70,0:42:22.45,Default,,0,0,0,,Иә, төмен түсейік.
Dialogue: 0,0:42:22.58,0:42:23.91,Default,,0,0,0,,Хехехе
Dialogue: 0,0:42:24.04,0:42:27.67,Default,,0,0,0,,Йотто, тотто, тотто…
Dialogue: 0,0:42:40.51,0:42:43.93,Default,,0,0,0,,(Дораэмон мен Шизуканың күлкісі)
Dialogue: 0,0:42:44.10,0:42:48.31,Default,,0,0,0,,Пао Пао (Нобита) Бұл қауіпті... Ах!
Dialogue: 0,0:42:50.06,0:42:51.86,Default,,0,0,0,,Ашуланба!
Dialogue: 0,0:42:52.11,0:42:55.44,Default,,0,0,0,,Барлығы, күте тұрыңдар!
Dialogue: 0,0:43:16.13,0:43:18.17,Default,,0,0,0,,Бұл қалада ешкім жоқ сияқты
Dialogue: 0,0:43:18.30,0:43:21.14,Default,,0,0,0,,Қызық, сонда тұратын адамдар қайда кетті?
Dialogue: 0,0:43:21.26,0:43:22.09,Default,,0,0,0,,Хаха...
Dialogue: 0,0:43:22.22,0:43:26.22,Default,,0,0,0,,(Паопао мен Нобитаның толқыған дауыстары)
Dialogue: 0,0:43:31.81,0:43:33.48,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:43:33.65,0:43:35.69,Default,,0,0,0,,Өйткені Мофусуке көңілді
Dialogue: 0,0:43:35.98,0:43:36.98,Default,,0,0,0,,Мофусуке?
Dialogue: 0,0:43:37.15,0:43:40.53,Default,,0,0,0,,Иә! Мен оны «Мофусуке» деп атадым, себебі ол үлпілдек.
Dialogue: 0,0:43:40.65,0:43:42.36,Default,,0,0,0,,Мофф~
Dialogue: 0,0:43:42.49,0:43:43.66,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:43:47.58,0:43:48.20,Default,,0,0,0,,Мофф!
Dialogue: 0,0:43:48.33,0:43:51.83,Default,,0,0,0,,Бұл жердің құлағанына көп уақыт болмаған сияқты.
Dialogue: 0,0:43:51.96,0:43:53.96,Default,,0,0,0,,Мына қара нәрсе не?
Dialogue: 0,0:43:54.08,0:43:56.00,Default,,0,0,0,,Мофу! Мофумофу (Нобита) Мофусуке!
Dialogue: 0,0:43:56.17,0:43:57.50,Default,,0,0,0,,Мофу!
Dialogue: 0,0:43:59.01,0:43:59.88,Default,,0,0,0,,Не? Уау
Dialogue: 0,0:44:04.68,0:44:08.27,Default,,0,0,0,,Су ағып жатыр. Балықтар бар ма?
Dialogue: 0,0:44:08.39,0:44:10.56,Default,,0,0,0,,Сіз бірдеңе естідіңіз бе? мофу
Dialogue: 0,0:44:10.68,0:44:12.65,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:44:12.85,0:44:14.19,Default,,0,0,0,,Жарылыс?
Dialogue: 0,0:44:14.61,0:44:18.23,Default,,0,0,0,,Паон!
Dialogue: 0,0:44:18.82,0:44:20.86,Default,,0,0,0,,Мофуу (Нобита) Уф
Dialogue: 0,0:44:20.99,0:44:22.20,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,0:44:22.32,0:44:25.57,Default,,0,0,0,,Ta Takecopter!
Dialogue: 0,0:44:28.70,0:44:30.70,Default,,0,0,0,,Мофу мофу мофу!
Dialogue: 0,0:44:30.83,0:44:37.25,Default,,0,0,0,,Пао Пао Паон Паон Паон
Dialogue: 0,0:44:37.38,0:44:38.71,Default,,0,0,0,,Киіз үй…
Dialogue: 0,0:44:43.63,0:44:46.43,Default,,0,0,0,,Әй, қайда бара жатырсың? мофу
Dialogue: 0,0:44:52.52,0:44:54.35,Default,,0,0,0,,Мофусукенің досы ма? қыз?
Dialogue: 0,0:44:54.48,0:44:55.85,Default,,0,0,0,,Паон (Нобита) Уау
Dialogue: 0,0:44:59.57,0:45:03.36,Default,,0,0,0,,Папа папа! (Нобита) Уф...
Dialogue: 0,0:45:04.74,0:45:06.07,Default,,0,0,0,,Пао?
Dialogue: 0,0:45:07.20,0:45:08.20,Default,,0,0,0,,Мофф
Dialogue: 0,0:45:11.58,0:45:14.75,Default,,0,0,0,,А, бұл! мофу мофу
Dialogue: 0,0:45:15.00,0:45:16.67,Default,,0,0,0,,Мофу?
Dialogue: 0,0:45:16.88,0:45:19.13,Default,,0,0,0,,(шет тілі)
Dialogue: 0,0:45:19.29,0:45:22.26,Default,,0,0,0,,Атлантикалық? Сен не айтып тұрсың?
Dialogue: 0,0:45:22.42,0:45:23.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:23.67,0:45:25.76,Default,,0,0,0,,(шет тілі)
Dialogue: 0,0:45:25.93,0:45:28.01,Default,,0,0,0,,Не? не болды?
Dialogue: 0,0:45:28.14,0:45:29.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:33.23,0:45:34.52,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:45:34.94,0:45:35.98,Default,,0,0,0,,(шет тілі)
Dialogue: 0,0:45:36.15,0:45:40.15,Default,,0,0,0,,(сегіз қырлы ырылдау)
Dialogue: 0,0:45:43.49,0:45:45.70,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:45:46.11,0:45:47.66,Default,,0,0,0,,Мен бір нәрсе құстым!
Dialogue: 0,0:45:47.78,0:45:49.16,Default,,0,0,0,,(шет тілі)
Dialogue: 0,0:45:49.49,0:45:51.62,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:45:52.20,0:45:53.45,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:45:54.46,0:45:56.58,Default,,0,0,0,,Өте суық! Ах
Dialogue: 0,0:45:57.12,0:45:59.54,Default,,0,0,0,,Moff (Нобита) аяқтары!
Dialogue: 0,0:45:59.88,0:46:02.25,Default,,0,0,0,,Мен қозғала алмайтын сияқтымын
Dialogue: 0,0:46:02.67,0:46:05.13,Default,,0,0,0,,О, күт!
Dialogue: 0,0:46:05.34,0:46:08.22,Default,,0,0,0,,Ула ла ла У ла ла
Dialogue: 0,0:46:08.34,0:46:13.35,Default,,0,0,0,,(сегіз бұрышты дауыс)
Dialogue: 0,0:46:15.73,0:46:17.35,Default,,0,0,0,,Ол бізге көмектесті.
Dialogue: 0,0:46:17.48,0:46:18.81,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:46:19.31,0:46:22.15,Default,,0,0,0,,Не? Бұл сегізаяқ (Сунео) кальмар емес пе?
Dialogue: 0,0:46:22.27,0:46:23.28,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:46:23.48,0:46:25.82,Default,,0,0,0,,Дораемон, қазір қандай?
Dialogue: 0,0:46:26.99,0:46:28.32,Default,,0,0,0,,Пао!
Dialogue: 0,0:46:28.49,0:46:30.12,Default,,0,0,0,,Маған конняку беріңізші!
Dialogue: 0,0:46:30.24,0:46:31.20,Default,,0,0,0,,Егер Ренгоку мырза бара жатса, уайымдаудың қажеті жоқ қой?
Dialogue: 0,0:46:31.95,0:46:33.62,Default,,0,0,0,,Не болды?
Dialogue: 0,0:46:33.74,0:46:35.45,Default,,0,0,0,,Бұл туралы кейінірек айтыңыз!
Dialogue: 0,0:46:37.79,0:46:40.21,Default,,0,0,0,,Уф... аяз...
Dialogue: 0,0:46:43.17,0:46:45.13,Default,,0,0,0,,(Қараның айқайы)
Dialogue: 0,0:46:45.26,0:46:47.88,Default,,0,0,0,,(сегіз қырлы ырылдау)
Dialogue: 0,0:46:50.80,0:46:51.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:55.02,0:46:57.98,Default,,0,0,0,,(Карланың шет тілі)
Dialogue: 0,0:47:01.65,0:47:05.65,Default,,0,0,0,,(Октогонның ыңырсыуы)
Dialogue: 0,0:47:07.90,0:47:09.11,Default,,0,0,0,,(шет тілі)
Dialogue: 0,0:47:10.53,0:47:13.41,Default,,0,0,0,,Менің додододо шабуылымды көрдіңіз бе?
Dialogue: 0,0:47:13.53,0:47:14.99,Default,,0,0,0,,Менің әкем жақсырақ
Dialogue: 0,0:47:15.08,0:47:16.83,Default,,0,0,0,,Бұл сөзсіз дұрыс болды.
Dialogue: 0,0:47:16.95,0:47:18.75,Default,,0,0,0,,Не!?
Dialogue: 0,0:47:19.50,0:47:21.42,Default,,0,0,0,,Дододо... (Сунео) Дадададада...
Dialogue: 0,0:47:21.88,0:47:23.59,Default,,0,0,0,,(Карланың шет тілі)
Dialogue: 0,0:47:23.71,0:47:25.46,Default,,0,0,0,,Да-да-да-да-да…
Dialogue: 0,0:47:25.59,0:47:26.88,Default,,0,0,0,,(Октогонның ыңырсыуы)
Dialogue: 0,0:47:27.13,0:47:28.30,Default,,0,0,0,,(шет тілі)
Dialogue: 0,0:47:28.42,0:47:30.22,Default,,0,0,0,,Дораэмон әлі?
Dialogue: 0,0:47:31.01,0:47:32.80,Default,,0,0,0,,Иә! Ләззат алыңыз!
Dialogue: 0,0:47:32.93,0:47:34.89,Default,,0,0,0,,Ха, ха, ыстық...
Dialogue: 0,0:47:36.47,0:47:37.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:41.81,0:47:42.86,Default,,0,0,0,,Киіз үй~
Dialogue: 0,0:47:43.36,0:47:44.57,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:47:48.40,0:47:50.82,Default,,0,0,0,,Алдын ала айтқаныңызға рахмет. Сіз жарақат алдыңыз ба?
Dialogue: 0,0:47:51.15,0:47:53.91,Default,,0,0,0,,Сіз сөйлей аласыз ба?
Dialogue: 0,0:47:54.07,0:47:54.99,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:47:55.12,0:47:57.33,Default,,0,0,0,,Жасау-істеу-іс…
Dialogue: 0,0:47:58.33,0:48:01.00,Default,,0,0,0,,Менің додогам!
Dialogue: 0,0:48:01.29,0:48:04.08,Default,,0,0,0,,Бұл жақсы емес, ол октогонда жұмыс істемейді.
Dialogue: 0,0:48:04.33,0:48:08.05,Default,,0,0,0,,Сегізбұрыш? Сізде кемшіліктер жоқ па? Сол жігіт
Dialogue: 0,0:48:08.42,0:48:11.13,Default,,0,0,0,,Ах... Мен барлық Отодамамды татып қойдым...
Dialogue: 0,0:48:11.26,0:48:13.93,Default,,0,0,0,,Отодама? Бұл сіздің дыбысқа әлсіз екеніңізді білдіре ме?
Dialogue: 0,0:48:14.09,0:48:16.01,Default,,0,0,0,,Дораемон Жарайды.
Dialogue: 0,0:48:17.10,0:48:20.98,Default,,0,0,0,,Таңқаларлық дыбыс толқынының тербелісі зиянкестерден қорғайтын құрал
Dialogue: 0,0:48:21.69,0:48:24.10,Default,,0,0,0,,Жоқ! Мен бұған мүлдем шыдай алмаймын!
Dialogue: 0,0:48:24.27,0:48:25.90,Default,,0,0,0,,Джан, осымен ән айт
Dialogue: 0,0:48:26.02,0:48:28.23,Default,,0,0,0,,Ән айту? Неліктен?
Dialogue: 0,0:48:28.36,0:48:31.40,Default,,0,0,0,,Иә? Ал...
Dialogue: 0,0:48:31.53,0:48:33.49,Default,,0,0,0,,Иә! Мен үлкен жұлдызды күттім!
Dialogue: 0,0:48:33.61,0:48:37.37,Default,,0,0,0,,Түсіндім, егер сіз соншалықты көп айтатын болсаңыз, онда.
Dialogue: 0,0:48:37.49,0:48:41.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:48:42.08,0:48:46.88,Default,,0,0,0,,(Джианның ән салған дауысы)
Dialogue: 0,0:48:47.00,0:48:48.00,Default,,0,0,0,,(Октогонның ыңырсыуы)
Dialogue: 0,0:48:48.38,0:48:49.80,Default,,0,0,0,,Қозғалыс тоқтады!
Dialogue: 0,0:48:49.92,0:48:51.92,Default,,0,0,0,,Ол жұмыс істейді, жарай ма?
Dialogue: 0,0:48:52.05,0:48:56.05,Default,,0,0,0,,(Джианның ән салған дауысы)
Dialogue: 0,0:49:02.35,0:49:06.36,Default,,0,0,0,,(Октогонның ыңырсыуы)
Dialogue: 0,0:49:18.16,0:49:19.58,Default,,0,0,0,,Мофу
Dialogue: 0,0:49:20.83,0:49:22.83,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,0:49:23.83,0:49:25.67,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:49:25.83,0:49:27.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:31.42,0:49:35.30,Default,,0,0,0,,Менің әнімді естіп қашуға қалай дәтің бар?
Dialogue: 0,0:49:35.43,0:49:38.51,Default,,0,0,0,,Оның қатты әсер еткені сонша, есінен танып қала жаздағанына сенімдімін.
Dialogue: 0,0:49:38.64,0:49:40.85,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:49:40.97,0:49:42.18,Default,,0,0,0,,Біраз
Dialogue: 0,0:49:43.14,0:49:44.89,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:49:45.23,0:49:46.52,Default,,0,0,0,,Е... біз...
Dialogue: 0,0:49:46.65,0:49:49.90,Default,,0,0,0,,Паон Паон (Нобита) Ахх...
Dialogue: 0,0:49:50.19,0:49:51.73,Default,,0,0,0,,Пао!
Dialogue: 0,0:49:51.86,0:49:53.36,Default,,0,0,0,,Ух... аааа!
Dialogue: 0,0:49:54.99,0:49:56.41,Default,,0,0,0,,Мофу!
Dialogue: 0,0:49:56.57,0:49:58.37,Default,,0,0,0,,Хмм, мофу
Dialogue: 0,0:50:10.29,0:50:11.00,Default,,0,0,0,,О!
Dialogue: 0,0:50:14.42,0:50:16.26,Default,,0,0,0,,Паопаоның сәлемдесу биі
Dialogue: 0,0:50:24.56,0:50:28.27,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:50:28.40,0:50:30.40,Default,,0,0,0,,Паон
Dialogue: 0,0:50:30.77,0:50:32.90,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:50:33.40,0:50:36.90,Default,,0,0,0,,Егер Паопао және басқалары оны жақсы көретін болса, онда ол жаман адам емес.
Dialogue: 0,0:50:37.11,0:50:39.03,Default,,0,0,0,,Ол Паопао деп аталады.
Dialogue: 0,0:50:39.16,0:50:42.58,Default,,0,0,0,,Бұл бала адасып қалған балаға ұқсайды, сіз бұл туралы бірдеңе білесіз бе?
Dialogue: 0,0:50:42.74,0:50:44.12,Default,,0,0,0,,Жоғалдың ба?
Dialogue: 0,0:50:44.37,0:50:49.83,Default,,0,0,0,,Ол Юкатанның інісіне ұқсайды, бірақ құлағының пішіні басқаша...
Dialogue: 0,0:50:50.75,0:50:52.21,Default,,0,0,0,,Мофу?
Dialogue: 0,0:50:53.34,0:50:55.55,Default,,0,0,0,,Иә... Нобита-кун
Dialogue: 0,0:50:56.30,0:50:59.05,Default,,0,0,0,,Ах! Сіздерді Нобитамен таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:50:59.18,0:51:01.51,Default,,0,0,0,,Бұл Дораемон мен Шизука-чан
Dialogue: 0,0:51:01.64,0:51:02.93,Default,,0,0,0,,Боку-чан Сунео
Dialogue: 0,0:51:03.06,0:51:05.27,Default,,0,0,0,,Мені Джан деп атаңыз.
Dialogue: 0,0:51:06.14,0:51:08.77,Default,,0,0,0,,Мен Карламын, бұл Юкатан
Dialogue: 0,0:51:08.94,0:51:10.31,Default,,0,0,0,,Пао
Dialogue: 0,0:51:10.44,0:51:14.65,Default,,0,0,0,,Біз бұл қирандыларды зерттеу үшін Хёга Хёга планетасынан келдік.
Dialogue: 0,0:51:15.36,0:51:17.32,Default,,0,0,0,,Хёга Хёга жұлдызы?
Dialogue: 0,0:51:17.44,0:51:20.07,Default,,0,0,0,,Ол Камавандес адамы емес пе еді?
Dialogue: 0,0:51:20.20,0:51:21.66,Default,,0,0,0,,Мына құбыжық ше?
Dialogue: 0,0:51:22.12,0:51:23.74,Default,,0,0,0,,Бұл сегізбұрыш
Dialogue: 0,0:51:23.95,0:51:26.29,Default,,0,0,0,,Осы қирандыларды қорғайтын тас мүсін
Dialogue: 0,0:51:26.62,0:51:28.83,Default,,0,0,0,,Кеше мен су жолында бірдеңені жоғалтып алдым.
Dialogue: 0,0:51:28.96,0:51:31.63,Default,,0,0,0,,Іздеп қайтып барсам, табылды.
Dialogue: 0,0:51:32.04,0:51:34.54,Default,,0,0,0,,Жоғалған зат? Нобита-кун
Dialogue: 0,0:51:36.96,0:51:40.34,Default,,0,0,0,,Біз бұл сақинаның иесін іздейміз.
Dialogue: 0,0:51:41.72,0:51:43.14,Default,,0,0,0,,Қоңырау! Сіз мұны қайда жасадыңыз?
Dialogue: 0,0:51:43.43,0:51:46.10,Default,,0,0,0,,Бұл сіздікі болды!
Dialogue: 0,0:51:46.22,0:51:50.14,Default,,0,0,0,,Негізі мен мұны мұздан 100 000 жылдан кейін таптым.
Dialogue: 0,0:51:50.35,0:51:53.56,Default,,0,0,0,,100 000 жыл? Мұзда ма? Ах!
Dialogue: 0,0:51:54.15,0:51:57.23,Default,,0,0,0,,Біз болашақта 100 000 жылдан келдік.
Dialogue: 0,0:51:57.36,0:51:58.82,Default,,0,0,0,,Хмм... Не болды?
Dialogue: 0,0:51:58.99,0:52:01.70,Default,,0,0,0,,Тыныш! Тас жарғанаттар, айналаңда.
Dialogue: 0,0:52:02.32,0:52:03.99,Default,,0,0,0,,Тас? (Нобита) Жарқанат па?
Dialogue: 0,0:52:04.12,0:52:06.54,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:52:07.79,0:52:10.00,Default,,0,0,0,,Ах! (2 адам) Қал... Қал...
Dialogue: 0,0:52:10.12,0:52:13.00,Default,,0,0,0,,(барлығы ыңылдап)
Dialogue: 0,0:52:13.21,0:52:17.42,Default,,0,0,0,,А-а, эй, бұл менің рюкзакым! Жіберу!
Dialogue: 0,0:52:17.55,0:52:19.88,Default,,0,0,0,,О, хаха, қайтар!
Dialogue: 0,0:52:20.01,0:52:23.43,Default,,0,0,0,,Менің шыныаяқ раменіме арналған тағамдар! Атта!
Dialogue: 0,0:52:23.59,0:52:28.60,Default,,0,0,0,,Менің жоғары сапалы шоколадыма картоп чипсы! Апыр-ай!
Dialogue: 0,0:52:28.72,0:52:31.35,Default,,0,0,0,,Уф! Олар жылтыр заттар мен тамақ іздейді!
Dialogue: 0,0:52:35.36,0:52:37.19,Default,,0,0,0,,Барлығына! Бұған!
Dialogue: 0,0:52:46.70,0:52:47.91,Default,,0,0,0,,Барлығы зардап шегеді ме?
Dialogue: 0,0:52:48.03,0:52:48.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:52:49.24,0:52:50.70,Default,,0,0,0,,Бұл! ? Сақина!
Dialogue: 0,0:52:54.37,0:52:56.25,Default,,0,0,0,,Сол жерде! Жарайды!
Dialogue: 0,0:52:59.67,0:53:02.67,Default,,0,0,0,,Сіз алыс жерден заттарға тапсырыс бере аласыз.
Dialogue: 0,0:53:02.80,0:53:03.47,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:53:03.88,0:53:05.14,Default,,0,0,0,,Хмм! Эй, тот, тот...
Dialogue: 0,0:53:05.26,0:53:07.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:07.64,0:53:09.89,Default,,0,0,0,,Уф... (Нобита) Не болды?
Dialogue: 0,0:53:10.02,0:53:15.65,Default,,0,0,0,,Бар, бар...! Ауырады, ауырады, ауырады, хо-хо-хо...
Dialogue: 0,0:53:19.44,0:53:20.73,Default,,0,0,0,,Қашайық
Dialogue: 0,0:53:20.90,0:53:22.86,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:53:28.16,0:53:30.08,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:53:30.20,0:53:32.75,Default,,0,0,0,,(радар дыбысы)
Dialogue: 0,0:53:33.12,0:53:36.63,Default,,0,0,0,,Егер сіз осы сигналды орындасаңыз, оны қайда барсаңыз да табасыз.
Dialogue: 0,0:53:40.17,0:53:41.67,Default,,0,0,0,,Мұнараға бет алу
Dialogue: 0,0:53:41.80,0:53:43.51,Default,,0,0,0,,Қуып алайық (Сунео) Иә!
Dialogue: 0,0:53:43.63,0:53:45.26,Default,,0,0,0,,Күте тұрыңыз (Джан Сунео) А...
Dialogue: 0,0:53:47.59,0:53:48.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:49.68,0:53:53.14,Default,,0,0,0,,Жақында түн келеді, қазір қуу қауіпті.
Dialogue: 0,0:53:53.52,0:53:54.64,Default,,0,0,0,,Түн? (Байланыс құрылғысының қоңырау үні)
Dialogue: 0,0:53:54.77,0:53:55.94,Default,,0,0,0,,Иә
Dialogue: 0,0:53:57.77,0:53:59.90,Default,,0,0,0,,Кара, жақсысың ба? Жағдай қандай?
Dialogue: 0,0:54:00.02,0:54:04.07,Default,,0,0,0,,Мен сақинаны таптым, бірақ тас жарғанаттар ұрлап кетті.
Dialogue: 0,0:54:04.19,0:54:07.41,Default,,0,0,0,,Түсіндім... Бірақ түн болды. Жақында оралыңыз.
Dialogue: 0,0:54:07.53,0:54:09.82,Default,,0,0,0,,Сіз бұл картада сақинаның қай жерде екенін көре аласыз, солай ма?
Dialogue: 0,0:54:10.12,0:54:11.12,Default,,0,0,0,,Әрине!
Dialogue: 0,0:54:11.24,0:54:13.08,Default,,0,0,0,,Менің келушім бар. Мен оны сонда апарамын.
Dialogue: 0,0:54:13.20,0:54:14.33,Default,,0,0,0,,А... (Дәрігер) Тұтынушы?
Dialogue: 0,0:54:14.87,0:54:18.29,Default,,0,0,0,,Біздің баспанаға келіп, аман-есен түнеңіз.
Dialogue: 0,0:54:18.88,0:54:23.17,Default,,0,0,0,,Таң атқанда іздеп көрейік. Сіз маған картаны бере аласыз ба?
Dialogue: 0,0:54:23.30,0:54:25.51,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:54:28.59,0:54:31.47,Default,,0,0,0,,Бұл қалашық күніне үш сағат қана.
Dialogue: 0,0:54:31.60,0:54:34.93,Default,,0,0,0,,Төбенің күмбезінде аспан шағылысып, күндіз.
Dialogue: 0,0:54:35.06,0:54:36.31,Default,,0,0,0,,Одан басқа, әрқашан түн
Dialogue: 0,0:54:36.94,0:54:38.31,Default,,0,0,0,,3 сағат?
Dialogue: 0,0:54:38.48,0:54:40.36,Default,,0,0,0,,Түнде қатты салқын болады...
Dialogue: 0,0:54:40.48,0:54:43.02,Default,,0,0,0,,Өйткені минус 100 градустан да суық болады.
Dialogue: 0,0:54:43.15,0:54:45.24,Default,,0,0,0,,Бұлай әрекет ету мүмкін емес.
Dialogue: 0,0:54:45.90,0:54:48.36,Default,,0,0,0,,Минус? (Сунео) 100 градус?
Dialogue: 0,0:54:48.49,0:54:50.16,Default,,0,0,0,,Бұл не нәрсе? бұл жер
Dialogue: 0,0:54:50.82,0:54:53.91,Default,,0,0,0,,Бұл жерде біздің ата-бабаларымыз өмір сүрген...
Dialogue: 0,0:54:54.04,0:54:56.87,Default,,0,0,0,,Ежелгі Хёга Хиога жат планеталықтар салған қала
Dialogue: 0,0:54:57.21,0:54:59.50,Default,,0,0,0,,Қазір ол жерде ешкім тұрмайды.
Dialogue: 0,0:55:07.80,0:55:08.88,Default,,0,0,0,,Мен жетемін!
Dialogue: 0,0:55:09.59,0:55:10.76,Default,,0,0,0,,Жарайды
Dialogue: 0,0:55:19.23,0:55:21.35,Default,,0,0,0,,Дірілдеп тұр, ұстаңыз!
Dialogue: 0,0:55:21.94,0:55:24.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:30.11,0:55:32.37,Default,,0,0,0,,Бұл амфибия көлігі болды.
Dialogue: 0,0:55:32.49,0:55:33.20,Default,,0,0,0,,Сонымен... мені ұмытып қалғың келе ме?
Dialogue: 0,0:55:41.79,0:55:47.09,Default,,0,0,0,,Үлпілдек үлпілдек…
Dialogue: 0,0:55:56.72,0:55:57.60,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:55:57.72,0:56:00.23,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:56:00.81,0:56:05.07,Default,,0,0,0,,Пао Пао…
Dialogue: 0,0:56:08.90,0:56:11.20,Default,,0,0,0,,Мофусукенің достары өте көп.
Dialogue: 0,0:56:11.32,0:56:13.74,Default,,0,0,0,,Біз бәріміз бірге саяхаттап жүрген достармыз.
Dialogue: 0,0:56:14.32,0:56:15.62,Default,,0,0,0,,Мукю Мукю
Dialogue: 0,0:56:16.37,0:56:17.58,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:56:17.79,0:56:19.62,Default,,0,0,0,,Өте сүйкімді~
Dialogue: 0,0:56:20.12,0:56:22.46,Default,,0,0,0,,Уау! Ахахха... (Сунео) Уау, аа
Dialogue: 0,0:56:22.75,0:56:25.25,Default,,0,0,0,,(Паопаоның айқайы)
Dialogue: 0,0:56:25.67,0:56:27.80,Default,,0,0,0,,Мукю (Қара) Жүр, осы жаққа.
Dialogue: 0,0:56:28.13,0:56:28.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:56:31.47,0:56:32.84,Default,,0,0,0,,Ол қатып қалды
Dialogue: 0,0:56:33.01,0:56:34.93,Default,,0,0,0,,Бұл балалар қысқы ұйқыда жатыр.
Dialogue: 0,0:56:35.10,0:56:38.35,Default,,0,0,0,,Паопао кейде мұзда ұзақ ұйықтайды.
Dialogue: 0,0:56:38.47,0:56:39.89,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,0:56:40.02,0:56:43.10,Default,,0,0,0,,Сонымен Мофусуке де мұзда болды ма?
Dialogue: 0,0:56:43.90,0:56:48.23,Default,,0,0,0,,Олар қысқы ұйқы кезінде қартамайды және өте ұзақ өмір сүреді.
Dialogue: 0,0:56:48.36,0:56:51.99,Default,,0,0,0,,Кометаның мұзында миллиондаған жылдар бойы ғарышта қалқып жүрген.
Dialogue: 0,0:56:52.11,0:56:54.45,Default,,0,0,0,,Паопао тіпті табылды.
Dialogue: 0,0:56:54.57,0:56:56.83,Default,,0,0,0,,Иә? (Нобита) Иә?
Dialogue: 0,0:56:59.08,0:56:59.79,Default,,0,0,0,,(саусақ ысқырығы)
Dialogue: 0,0:57:00.08,0:57:03.00,Default,,0,0,0,,Мофу мофу мофу мофу…
Dialogue: 0,0:57:03.67,0:57:05.13,Default,,0,0,0,,Осының үстінде
Dialogue: 0,0:57:07.79,0:57:09.96,Default,,0,0,0,,Менің баспанама қош келдіңіз
Dialogue: 0,0:57:12.47,0:57:13.93,Default,,0,0,0,,Уф! (Карла) Не болды?
Dialogue: 0,0:57:14.51,0:57:18.89,Default,,0,0,0,,Қонақсың, менің баспанама қош келдің.
Dialogue: 0,0:57:19.31,0:57:21.14,Default,,0,0,0,,Уау! (Карла) Дәрігер!
Dialogue: 0,0:57:21.27,0:57:24.23,Default,,0,0,0,,Тірі қалу костюмін киіңіз! Сіз аралдан кеттіңіз бе?
Dialogue: 0,0:57:24.35,0:57:26.06,Default,,0,0,0,,Мен сендерге демалыңдар дедім.
Dialogue: 0,0:57:26.19,0:57:29.52,Default,,0,0,0,,Иә? А... бұл...
Dialogue: 0,0:57:31.03,0:57:35.32,Default,,0,0,0,,Үйінділерді зерттеп көрейік. Жарайды, ауыр сөз айтпа.
Dialogue: 0,0:57:35.61,0:57:39.49,Default,,0,0,0,,Мүлде жоқ! Аяғыңыздағы сүйектер әлі біріккен жоқ.
Dialogue: 0,0:57:39.62,0:57:40.54,Default,,0,0,0,,Дәрігер?
Dialogue: 0,0:57:40.91,0:57:43.96,Default,,0,0,0,,Уф... Қараңызшы, ауру басылды...
Dialogue: 0,0:57:44.08,0:57:48.50,Default,,0,0,0,,Аа, дұрыс. Қонақ келмегеніне біраз болды. Бүгін кешке қойманы ашайық.
Dialogue: 0,0:57:48.63,0:57:50.04,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:57:50.17,0:57:53.88,Default,,0,0,0,,Аа, мен соңғы кездері тек картоп жейтін болдым.
Dialogue: 0,0:57:54.01,0:57:56.72,Default,,0,0,0,,Барлығы қуансын! Бүгін кешке той жасаймыз!
Dialogue: 0,0:57:56.84,0:57:58.51,Default,,0,0,0,,Бомбадан жасалған пудинг те бар. (Дәрігер) Хе.
Dialogue: 0,0:57:59.01,0:58:01.31,Default,,0,0,0,,Бомба... (Нобита) Пудинг?
Dialogue: 0,0:58:01.43,0:58:04.27,Default,,0,0,0,,А, бірақ алдымен маған душ керек.
Dialogue: 0,0:58:04.39,0:58:06.73,Default,,0,0,0,,Маған сол шаңнан құтылу керек.
Dialogue: 0,0:58:06.85,0:58:09.73,Default,,0,0,0,,Душ? (Нобита/Дораэмон) Хмм...
Dialogue: 0,0:58:11.02,0:58:12.69,Default,,0,0,0,,Ол кешкі асқа дейін үйде болатынын айтты.
Dialogue: 0,0:58:13.03,0:58:14.69,Default,,0,0,0,,Мен анама уәде бердім
Dialogue: 0,0:58:14.82,0:58:17.41,Default,,0,0,0,,Дұрыс, анам ұрсады.
Dialogue: 0,0:58:17.74,0:58:18.70,Default,,0,0,0,,Жарайды
Dialogue: 0,0:58:18.87,0:58:23.41,Default,,0,0,0,,Жайғасып болған соң, біз кеткен күннің кешіне оралу үшін уақыт машинасын қолданайық.
Dialogue: 0,0:58:23.95,0:58:25.87,Default,,0,0,0,,Хм, бір нәрсенің иісі жақсы.
Dialogue: 0,0:58:28.08,0:58:30.29,Default,,0,0,0,,Йотто Эхехе
Dialogue: 0,0:58:30.67,0:58:32.88,Default,,0,0,0,,(Қараның гуілдеуі)
Dialogue: 0,0:58:33.38,0:58:36.09,Default,,0,0,0,,Жай ғана бумен пісіруге рұқсат етіңіз, сондықтан сәл күтіңіз.
Dialogue: 0,0:58:36.22,0:58:38.80,Default,,0,0,0,,Иә! Күткеніңізге рахмет
Dialogue: 0,0:58:39.39,0:58:41.93,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:58:47.89,0:58:49.15,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:58:51.40,0:58:52.61,Default,,0,0,0,,Мен аш емеспін. Хүү…
Dialogue: 0,0:58:52.73,0:58:55.19,Default,,0,0,0,,ірімшік зефир тәрізді
Dialogue: 0,0:58:55.32,0:58:59.11,Default,,0,0,0,,Париждегі бес жұлдызды мейрамхананың дәмін еске түсіреді.
Dialogue: 0,0:58:59.49,0:59:02.24,Default,,0,0,0,,Не! 100 000 жылдан бастап болашақта -
Dialogue: 0,0:59:02.41,0:59:04.41,Default,,0,0,0,,Сақинаны жеткізуге келдің бе?
Dialogue: 0,0:59:04.58,0:59:07.41,Default,,0,0,0,,Хёга Хёга планетасы қандай орын?
Dialogue: 0,0:59:07.58,0:59:11.25,Default,,0,0,0,,Бұл жерден дәл 100 000 жарық жылы...
Dialogue: 0,0:59:11.33,0:59:12.96,Default,,0,0,0,,Суретке қараңыз.
Dialogue: 0,0:59:13.29,0:59:13.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:15.30,0:59:17.26,Default,,0,0,0,,Таза ақ жұлдыз
Dialogue: 0,0:59:17.63,0:59:24.35,Default,,0,0,0,,Бұрын жасыл желекке толы болса, қазір мұз басқан.
Dialogue: 0,0:59:24.47,0:59:26.02,Default,,0,0,0,,Жұлдыздар мұздады ма?
Dialogue: 0,0:59:26.56,0:59:28.02,Default,,0,0,0,,Бұл Близзаганың кінәсі
Dialogue: 0,0:59:28.39,0:59:29.69,Default,,0,0,0,,Блицзага?
Dialogue: 0,0:59:29.98,0:59:33.36,Default,,0,0,0,,Бұл ұзақ әңгіме, бірақ...
Dialogue: 0,0:59:33.57,0:59:36.82,Default,,0,0,0,,Біздің ата-бабаларымыз, ежелгі Хёга Хиога жат планеталықтар...
Dialogue: 0,0:59:36.94,0:59:39.40,Default,,0,0,0,,Галактиканың шетіне бір рет саяхаттаған
Dialogue: 0,0:59:39.53,0:59:42.53,Default,,0,0,0,,Тамаша ғылым мен техникаға ие болды
Dialogue: 0,0:59:42.87,0:59:45.62,Default,,0,0,0,,Бірақ қазір бұл техника жоғалды -
Dialogue: 0,0:59:45.74,0:59:48.75,Default,,0,0,0,,Бұл бізге хабарланған жоқ.
Dialogue: 0,0:59:49.46,0:59:52.67,Default,,0,0,0,,Мынау қираған жерден ұстаған жәндік.
Dialogue: 0,0:59:53.04,0:59:57.63,Default,,0,0,0,,Оны ежелгі адамдар сол тас мүсін сияқты техникамен жасаған.
Dialogue: 0,0:59:58.13,1:00:00.34,Default,,0,0,0,,Бұл сегізаяқ құбыжықтар тұқымдасының өкілі ме?
Dialogue: 0,1:00:00.63,1:00:04.43,Default,,0,0,0,,Ежелгілерден қалған қирандыларды зерттей отырып, біз...
Dialogue: 0,1:00:04.55,1:00:07.35,Default,,0,0,0,,Біз ғылымды дамыттық.
Dialogue: 0,1:00:08.68,1:00:12.85,Default,,0,0,0,,Бірақ мен ашылмайтын есік таптым.
Dialogue: 0,1:00:17.65,1:00:21.11,Default,,0,0,0,,Блицзага Ең күшті қозғалатын тас мүсін
Dialogue: 0,1:00:21.24,1:00:22.49,Default,,0,0,0,,Ол бізге береді—
Dialogue: 0,1:00:22.61,1:00:25.62,Default,,0,0,0,,Бұл басқаруға болатын нәрсе емес еді.
Dialogue: 0,1:00:37.84,1:00:40.26,Default,,0,0,0,,Барлығы жұлдыздарды тастап кетті
Dialogue: 0,1:00:40.38,1:00:41.67,Default,,0,0,0,,Бірақ мен—
Dialogue: 0,1:00:41.80,1:00:46.68,Default,,0,0,0,,Мен Близзаганы қайтадан мөрлеудің жолын іздеу үшін жолға шықтым.
Dialogue: 0,1:00:47.06,1:00:50.02,Default,,0,0,0,,Бұл өте ұзақ жол болды, бірақ...
Dialogue: 0,1:00:50.14,1:00:51.35,Default,,0,0,0,,Ақырында бұл планетада
Dialogue: 0,1:00:51.52,1:00:54.69,Default,,0,0,0,,Мен сол күшке ие сақина таптым.
Dialogue: 0,1:00:55.86,1:00:58.73,Default,,0,0,0,,Мен оның соншалықты маңызды болғанына сене алмаймын...
Dialogue: 0,1:00:58.86,1:01:00.86,Default,,0,0,0,,Мен оны міндетті түрде қайтаруым керек.
Dialogue: 0,1:01:01.65,1:01:05.66,Default,,0,0,0,,Бірақ неліктен ежелгі адамдар мұндай сұмдық нәрселерді жасады?
Dialogue: 0,1:01:05.78,1:01:09.45,Default,,0,0,0,,Дұрыс. Неліктен мұндай адам Жерде болады?
Dialogue: 0,1:01:09.87,1:01:12.50,Default,,0,0,0,,Олар өмір сүруге жарамды планетаны тапқанда...
Dialogue: 0,1:01:12.62,1:01:15.42,Default,,0,0,0,,Мен оны мұздату үшін Blizzaga-ны қолдандым.
Dialogue: 0,1:01:15.63,1:01:16.96,Default,,0,0,0,,Мұздату керек пе?
Dialogue: 0,1:01:17.09,1:01:19.88,Default,,0,0,0,,Олай жасасаң, онда тұра алмайсың.
Dialogue: 0,1:01:20.17,1:01:24.01,Default,,0,0,0,,Жоқ, мұзда қатып қалған жұлдыздар мұз ерігеннен кейін ериді...
Dialogue: 0,1:01:24.13,1:01:27.89,Default,,0,0,0,,Реакция жарылғыш өзгерістерге әкеледі.
Dialogue: 0,1:01:28.10,1:01:30.18,Default,,0,0,0,,Қарлы жер
Dialogue: 0,1:01:30.31,1:01:32.02,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,1:01:32.14,1:01:36.31,Default,,0,0,0,,Баяғыда жер бетін мұз басқанына сенемін...
Dialogue: 0,1:01:36.44,1:01:38.02,Default,,0,0,0,,Ах! не?
Dialogue: 0,1:01:38.15,1:01:39.77,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,1:01:39.90,1:01:42.82,Default,,0,0,0,,Дәл осындай жағдай бұрыннан жер бетінде болған.
Dialogue: 0,1:01:43.32,1:01:45.03,Default,,0,0,0,,Шамамен 600 миллион жыл бұрын—
Dialogue: 0,1:01:45.15,1:01:47.20,Default,,0,0,0,,Жер дәл Хёга Хёга сияқты.
Dialogue: 0,1:01:47.32,1:01:49.28,Default,,0,0,0,,Мен мүлде ақ болып қатып қалдым.
Dialogue: 0,1:01:49.41,1:01:52.75,Default,,0,0,0,,Оның ондаған миллион жылдарға созылғаны айтылады.
Dialogue: 0,1:01:53.25,1:01:56.50,Default,,0,0,0,,Бірақ біраз уақыттан кейін мұз еріді.
Dialogue: 0,1:01:56.62,1:01:59.63,Default,,0,0,0,,Жер бетінде тіршіліктің үлкен эволюциясы болды.
Dialogue: 0,1:02:00.34,1:02:03.21,Default,,0,0,0,,«Кембрий жарылысы» деп аталды—
Dialogue: 0,1:02:03.38,1:02:07.97,Default,,0,0,0,,Осы кезде қазіргі тіршілік иелерінің прототиптерінің көпшілігі жасалған деседі.
Dialogue: 0,1:02:08.80,1:02:10.81,Default,,0,0,0,,Сонымен, біз қазір қайда
Dialogue: 0,1:02:10.93,1:02:13.14,Default,,0,0,0,,Ежелгілерге рахмет?
Dialogue: 0,1:02:13.27,1:02:18.27,Default,,0,0,0,,Алайда бұл қирандылардағы барлық Близзагалар аяқталмай қалды.
Dialogue: 0,1:02:19.02,1:02:20.52,Default,,0,0,0,,Мүмкін бұл жұлдыз...
Dialogue: 0,1:02:20.65,1:02:24.28,Default,,0,0,0,,Бұрынғыларға қатысы жоқ, қатып қалған болуы да мүмкін.
Dialogue: 0,1:02:24.57,1:02:28.28,Default,,0,0,0,,Қардан қорғайтын көзілдірік пен бульдозер... Түсіндім.
Dialogue: 0,1:02:28.41,1:02:30.32,Default,,0,0,0,,Сіз мүлде түсінбейсіз.
Dialogue: 0,1:02:30.45,1:02:32.37,Default,,0,0,0,,Уайымдамаңыз! Мұндай құбыжық-
Dialogue: 0,1:02:32.49,1:02:35.96,Default,,0,0,0,,Мен бұны бүлдіремін!
Dialogue: 0,1:02:36.08,1:02:37.00,Default,,0,0,0,,Хи хи хи (Сунео) Иә?
Dialogue: 0,1:02:37.12,1:02:38.88,Default,,0,0,0,,А, фуфу, ә?
Dialogue: 0,1:02:39.25,1:02:39.71,Default,,0,0,0,,Мұны да ежелгі адамдар жасаған ба?
Dialogue: 0,1:02:39.71,1:02:41.29,Default,,0,0,0,,Мұны да ежелгі адамдар жасаған ба?
Dialogue: 0,1:02:39.71,1:02:41.29,Default,,0,0,0,,Иә! Қалыңыз...
Dialogue: 0,1:02:41.63,1:02:43.00,Default,,0,0,0,,Бұл мен Дородромеда планетасынан сатып алған жауынгер қуыршақ.
Dialogue: 0,1:02:43.00,1:02:45.51,Default,,0,0,0,,Бұл мен Дромедромедадан сатып алған жауынгер қуыршақ.
Dialogue: 0,1:02:43.00,1:02:45.51,Default,,0,0,0,,Иә, ммм...
Dialogue: 0,1:02:45.63,1:02:48.22,Default,,0,0,0,,Артқы жағындағы түймені басыңыз
Dialogue: 0,1:02:48.34,1:02:49.84,Default,,0,0,0,,Жарайсың!
Dialogue: 0,1:02:49.84,1:02:50.14,Default,,0,0,0,,Жарайсың, солай ма?
Dialogue: 0,1:02:49.84,1:02:50.14,Default,,0,0,0,,А, сен барсың... сен барсың...
Dialogue: 0,1:02:50.14,1:02:50.30,Default,,0,0,0,,А, сен барсың... сен барсың...
Dialogue: 0,1:02:50.30,1:02:52.81,Default,,0,0,0,,А, сен барсың... сен барсың...
Dialogue: 0,1:02:50.30,1:02:52.81,Default,,0,0,0,,Менің көзім жарқырап тұратын.
Dialogue: 0,1:02:52.81,1:02:52.93,Default,,0,0,0,,А, сен барсың... сен барсың...
Dialogue: 0,1:02:52.93,1:02:54.60,Default,,0,0,0,,А, сен барсың... сен барсың...
Dialogue: 0,1:02:52.93,1:02:54.60,Default,,0,0,0,,Ой, эй, эй, тоқтат.
Dialogue: 0,1:02:54.72,1:02:56.18,Default,,0,0,0,,Тағы бір дене
Dialogue: 0,1:02:56.35,1:02:58.64,Default,,0,0,0,,Менің көзім осында әлі жарқырап тұр.
Dialogue: 0,1:02:59.81,1:03:01.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:03.69,1:03:06.65,Default,,0,0,0,,Десерт ішейік: бомба пудингі!
Dialogue: 0,1:03:07.32,1:03:08.53,Default,,0,0,0,,Иә...
Dialogue: 0,1:03:11.32,1:03:12.99,Default,,0,0,0,,Бухаха
Dialogue: 0,1:03:15.45,1:03:16.37,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,1:03:16.66,1:03:18.33,Default,,0,0,0,,Е...
Dialogue: 0,1:03:18.46,1:03:20.50,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,1:03:21.96,1:03:23.42,Default,,0,0,0,,Буух
Dialogue: 0,1:03:26.51,1:03:27.47,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,1:03:29.88,1:03:31.68,Default,,0,0,0,,Паху (Сунео/Джиан) Аххх
Dialogue: 0,1:03:32.55,1:03:33.81,Default,,0,0,0,,Хамф
Dialogue: 0,1:03:35.68,1:03:36.85,Default,,0,0,0,,Хамф
Dialogue: 0,1:03:40.94,1:03:42.19,Default,,0,0,0,,Ол да солардың бірі ғана ғой, иә?
Dialogue: 0,1:03:44.15,1:03:49.53,Default,,0,0,0,,Ол кезде мен ғарыштық құбыжықпен соғысып жүргенмін.
Dialogue: 0,1:03:49.99,1:03:56.49,Default,,0,0,0,,Қанша жерден жеңілетінімді сезсем де, берілмей, соңғы соққыны бермеймін!
Dialogue: 0,1:03:56.62,1:03:58.62,Default,,0,0,0,,Уау! Дааааа
Dialogue: 0,1:03:58.75,1:04:00.08,Default,,0,0,0,,Ой... (Сунео мен оның достары күледі)
Dialogue: 0,1:04:00.71,1:04:03.54,Default,,0,0,0,,Ахаха (Карла) Ахха Ухуфуфу
Dialogue: 0,1:04:03.67,1:04:08.42,Default,,0,0,0,,(Барлығы қорылдады)
Dialogue: 0,1:04:08.55,1:04:12.01,Default,,0,0,0,,(Дораэмонның ұйқы туралы әңгімесі)
Dialogue: 0,1:04:23.48,1:04:24.52,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,1:04:24.65,1:04:26.98,Default,,0,0,0,,Барлау көлігіне барлығы бірдей міне алмайды...
Dialogue: 0,1:04:27.11,1:04:30.07,Default,,0,0,0,,Оларды жалғыз қалдырсақ, аянышты болар еді.
Dialogue: 0,1:04:45.08,1:04:47.25,Default,,0,0,0,,(радар дыбысы)
Dialogue: 0,1:04:47.50,1:04:49.71,Default,,0,0,0,,Кешеден бері жұмыс істемеді.
Dialogue: 0,1:04:49.88,1:04:51.97,Default,,0,0,0,,Мұнда олардың ұясы бар.
Dialogue: 0,1:04:57.81,1:04:59.85,Default,,0,0,0,,Тас жарғанаттардың ұясы...
Dialogue: 0,1:04:59.97,1:05:02.18,Default,,0,0,0,,Сіз қызықты нәрсе көруіңіз мүмкін.
Dialogue: 0,1:05:03.27,1:05:04.65,Default,,0,0,0,,Арх! Күрсін...
Dialogue: 0,1:05:04.77,1:05:07.77,Default,,0,0,0,,Қараңыз! Мен бұл аяқтарымды әлі жасай алмаймын.
Dialogue: 0,1:05:07.90,1:05:09.11,Default,,0,0,0,,Осы жерде күтіңіз.
Dialogue: 0,1:05:09.32,1:05:13.82,Default,,0,0,0,,Бірақ... Мен камераға құнды материалдарды түсіруім керек.
Dialogue: 0,1:05:13.99,1:05:16.28,Default,,0,0,0,,Жібер! Мұнда!
Dialogue: 0,1:05:16.62,1:05:18.12,Default,,0,0,0,,Мен бірден қайтамын.
Dialogue: 0,1:05:18.24,1:05:20.24,Default,,0,0,0,,Камераны маған қалдырыңыз
Dialogue: 0,1:05:21.12,1:05:23.71,Default,,0,0,0,,О, құдайым... А?
Dialogue: 0,1:05:27.84,1:05:29.00,Default,,0,0,0,,Не!
Dialogue: 0,1:05:30.88,1:05:33.09,Default,,0,0,0,,Blizzaga ангары
Dialogue: 0,1:05:33.26,1:05:36.76,Default,,0,0,0,,Ашық болса да, қар оттары жиналып жатыр
Dialogue: 0,1:05:37.14,1:05:38.47,Default,,0,0,0,,Хмм...
Dialogue: 0,1:05:43.64,1:05:44.81,Default,,0,0,0,,Ах... (Нобита) Ах.
Dialogue: 0,1:05:47.06,1:05:48.31,Default,,0,0,0,,Өз баламды ешқашан қателеспес едім.
Dialogue: 0,1:05:51.11,1:05:54.32,Default,,0,0,0,,Бұл көтеріліп жатыр ма? Солай сияқты
Dialogue: 0,1:05:54.49,1:05:56.16,Default,,0,0,0,,Кеттік! (Дораэмон/Нобита) Хмм...
Dialogue: 0,1:05:56.32,1:05:57.49,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,1:05:59.16,1:06:01.29,Default,,0,0,0,,Мен алда не күтіп тұрғанын білмеймін
Dialogue: 0,1:06:01.41,1:06:03.75,Default,,0,0,0,,Төтенше жағдайда өзіңізді қорғау үшін сол құралды пайдаланыңыз.
Dialogue: 0,1:06:04.00,1:06:04.96,Default,,0,0,0,,Жарайды, кеттік! (Мофусуке мен оның достарының айқайы)
Dialogue: 0,1:06:04.96,1:06:06.71,Default,,0,0,0,,Жарайды, кеттік! (Мофусуке мен оның достарының айқайы)
Dialogue: 0,1:06:04.96,1:06:06.71,Default,,0,0,0,,Оны тастама, Нобита-сан
Dialogue: 0,1:06:06.83,1:06:08.21,Default,,0,0,0,,Сунео, менің артымнан жүр!
Dialogue: 0,1:06:09.79,1:06:11.17,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,1:06:11.71,1:06:14.01,Default,,0,0,0,,Мен ол жерде біреу жүргендей болдым...
Dialogue: 0,1:06:14.17,1:06:15.17,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:43.20,1:06:45.87,Default,,0,0,0,,(радар дыбысы)
Dialogue: 0,1:06:46.21,1:06:49.04,Default,,0,0,0,,Жақын (Сунео) Нобита мен басқалары ше?
Dialogue: 0,1:06:49.17,1:06:50.88,Default,,0,0,0,,Аа, қазір ойлап қарасам
Dialogue: 0,1:06:52.04,1:06:54.38,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:06:54.55,1:06:56.72,Default,,0,0,0,,Пао
Dialogue: 0,1:06:58.22,1:07:00.55,Default,,0,0,0,,Мен не істеуім керек? Екеуміз ажырасып кеткен сияқтымыз.
Dialogue: 0,1:07:00.72,1:07:02.76,Default,,0,0,0,,Оған көмектесу мүмкін емес. Осыны қолданайық...
Dialogue: 0,1:07:06.06,1:07:08.56,Default,,0,0,0,,Ол бір нәрсені қай жерден іздеу керектігін айтады.
Dialogue: 0,1:07:08.73,1:07:10.23,Default,,0,0,0,,Сақина қайда?
Dialogue: 0,1:07:10.73,1:07:11.94,Default,,0,0,0,,Мен абдырап қалдым
Dialogue: 0,1:07:12.06,1:07:13.57,Default,,0,0,0,,Осы жолмен! Бұл...
Dialogue: 0,1:07:13.69,1:07:16.40,Default,,0,0,0,,Ах... дәлдік көрсеткіші 70%.
Dialogue: 0,1:07:16.57,1:07:18.65,Default,,0,0,0,,Оған сенуге болмайды~
Dialogue: 0,1:07:18.82,1:07:19.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:19.74,1:07:22.45,Default,,0,0,0,,Сен осылай айтқаның үшін күйзеліп қалдың, солай емес пе?
Dialogue: 0,1:07:23.03,1:07:24.74,Default,,0,0,0,,Ал, бәрібір кеттік!
Dialogue: 0,1:07:24.87,1:07:26.54,Default,,0,0,0,,Ех! Сіз әлі көтерілесіз бе?
Dialogue: 0,1:07:26.66,1:07:28.41,Default,,0,0,0,,Әрине! Барайық!
Dialogue: 0,1:07:32.04,1:07:34.38,Default,,0,0,0,,Қырылған мұз? Сіз мұз жейсіз бе?
Dialogue: 0,1:07:34.50,1:07:34.63,Default,,0,0,0,,Иә, сироптың әртүрлі хош иістерімен—
Dialogue: 0,1:07:34.63,1:07:36.59,Default,,0,0,0,,Иә, сироптың әртүрлі хош иістерімен—
Dialogue: 0,1:07:34.63,1:07:36.59,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,1:07:36.71,1:07:37.84,Default,,0,0,0,,Өйткені бұл дәмді
Dialogue: 0,1:07:37.97,1:07:40.30,Default,,0,0,0,,Эй, сен бәрін жейсің.
Dialogue: 0,1:07:40.59,1:07:42.51,Default,,0,0,0,,Бұл ештеңе туралы емес, бірақ...
Dialogue: 0,1:07:42.89,1:07:45.47,Default,,0,0,0,,Близзаганы сендер де жемейсіңдер ме?
Dialogue: 0,1:07:46.22,1:07:49.44,Default,,0,0,0,,А, эй, Близзага қандай адам?
Dialogue: 0,1:07:49.69,1:07:51.65,Default,,0,0,0,,Денесі мұзды алып
Dialogue: 0,1:07:52.48,1:07:54.98,Default,,0,0,0,,Мен оны бір-ақ рет жақыннан көрдім.
Dialogue: 0,1:07:55.19,1:07:58.94,Default,,0,0,0,,Мұзды алып, үлкейе береді.
Dialogue: 0,1:07:59.07,1:08:00.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:07.45,1:08:09.83,Default,,0,0,0,,Близзага! (Қыз) Мен бәріне хабарлаймын.
Dialogue: 0,1:08:24.85,1:08:29.10,Default,,0,0,0,,Сол күні қаламыз қатып қалды.
Dialogue: 0,1:08:29.73,1:08:32.65,Default,,0,0,0,,Бірақ бұл сақина менде болғанша, менде бәрі жақсы болады.
Dialogue: 0,1:08:32.77,1:08:34.98,Default,,0,0,0,,Мен Близзагадан қырылған мұз жасаймын!
Dialogue: 0,1:08:35.61,1:08:39.90,Default,,0,0,0,,Ал, мен саған кәдесый ретінде сироп беремін. Сіз қандай дәмді қалайсыз?
Dialogue: 0,1:08:40.03,1:08:42.36,Default,,0,0,0,,Сәлем! Тетте~
Dialogue: 0,1:08:42.49,1:08:45.20,Default,,0,0,0,,Иә? Дораэмон ше?
Dialogue: 0,1:08:47.99,1:08:50.20,Default,,0,0,0,,Иә? Ха, мінекей!
Dialogue: 0,1:08:54.50,1:08:55.84,Default,,0,0,0,,Нобита-кун, осылай!
Dialogue: 0,1:08:58.80,1:09:02.38,Default,,0,0,0,,Жарайды, алдымен айт.
Dialogue: 0,1:09:11.27,1:09:12.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:14.40,1:09:16.27,Default,,0,0,0,,(тас жарғанаттың айқайы)
Dialogue: 0,1:09:18.98,1:09:20.94,Default,,0,0,0,,Бұл тас жарғанақтың ұясы.
Dialogue: 0,1:09:23.36,1:09:24.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:26.87,1:09:29.54,Default,,0,0,0,,Бұл тас жарғанаттар жинаған қоқыс.
Dialogue: 0,1:09:29.70,1:09:32.71,Default,,0,0,0,,Джан мен Сунеоның сөмкесі
Dialogue: 0,1:09:33.54,1:09:34.79,Default,,0,0,0,,Құрметті Құт-береке Құдайының шын мәнінде Нора ұстайтын сиқыршы екеніне сену қиын.
Dialogue: 0,1:09:44.30,1:09:45.22,Default,,0,0,0,,Ах
Dialogue: 0,1:09:47.89,1:09:49.26,Default,,0,0,0,,Міне болды! Бұл сақина!
Dialogue: 0,1:09:49.39,1:09:54.39,Default,,0,0,0,,Менің мұнарама рұқсатсыз кім кірді?
Dialogue: 0,1:09:56.35,1:09:57.27,Default,,0,0,0,,Сіз...
Dialogue: 0,1:09:58.02,1:09:59.65,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:11.12,1:10:15.33,Default,,0,0,0,,А... О, құдайым...
Dialogue: 0,1:10:19.34,1:10:21.55,Default,,0,0,0,,Блицзагадағы мұз денесі
Dialogue: 0,1:10:21.75,1:10:22.96,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:23.09,1:10:24.76,Default,,0,0,0,,Анашым! Пао
Dialogue: 0,1:10:24.92,1:10:26.26,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:10:26.38,1:10:28.05,Default,,0,0,0,,Ах! Мофф
Dialogue: 0,1:10:28.80,1:10:32.14,Default,,0,0,0,,Сен… сен сорлы! Қалай батылың жетті!
Dialogue: 0,1:10:32.77,1:10:33.89,Default,,0,0,0,,Мофф~
Dialogue: 0,1:10:33.97,1:10:34.06,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:10:34.06,1:10:35.56,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:10:34.06,1:10:35.56,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:35.56,1:10:35.94,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:36.02,1:10:37.94,Default,,0,0,0,,(радар дыбысы)
Dialogue: 0,1:10:38.60,1:10:40.40,Default,,0,0,0,,Осы жерде болуы керек.
Dialogue: 0,1:10:40.52,1:10:42.73,Default,,0,0,0,,Барлығы кешігіп қалды (5 адам) Иә?
Dialogue: 0,1:10:43.15,1:10:44.53,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:10:44.65,1:10:45.86,Default,,0,0,0,,Бабун
Dialogue: 0,1:10:46.74,1:10:51.24,Default,,0,0,0,,(Дораэмонның ұйқы туралы әңгімесі)
Dialogue: 0,1:10:51.37,1:10:54.08,Default,,0,0,0,,Үгегеге...!
Dialogue: 0,1:10:54.50,1:10:55.62,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,1:10:56.25,1:10:59.46,Default,,0,0,0,,А... бұл қиын! Ой...
Dialogue: 0,1:11:03.13,1:11:04.71,Default,,0,0,0,,Нобита және басқалары ше?
Dialogue: 0,1:11:05.38,1:11:07.51,Default,,0,0,0,,Жарайды! Хе хе...
Dialogue: 0,1:11:10.72,1:11:13.43,Default,,0,0,0,,Ах! сурет?
Dialogue: 0,1:11:13.81,1:11:14.60,Default,,0,0,0,,Қайда?
Dialogue: 0,1:11:14.72,1:11:15.98,Default,,0,0,0,,Бұл не? Дораемон!
Dialogue: 0,1:11:16.52,1:11:19.40,Default,,0,0,0,,Міне, міне, а
Dialogue: 0,1:11:19.77,1:11:21.86,Default,,0,0,0,,Мынадай жерде төсбелгі бар
Dialogue: 0,1:11:21.98,1:11:24.02,Default,,0,0,0,,О? Бұл рас!
Dialogue: 0,1:11:24.15,1:11:25.61,Default,,0,0,0,,Неліктен жер бетінде...
Dialogue: 0,1:11:25.73,1:11:28.86,Default,,0,0,0,,Жоғарыдан құлаған шығар.
Dialogue: 0,1:11:29.49,1:11:33.49,Default,,0,0,0,,(Сунеоның айқайы)
Dialogue: 0,1:11:36.41,1:11:38.41,Default,,0,0,0,,Сақина осында екені анық.
Dialogue: 0,1:11:38.54,1:11:40.29,Default,,0,0,0,,Сіз бірдеңе естіген жоқсыз ба?
Dialogue: 0,1:11:40.42,1:11:41.79,Default,,0,0,0,,Жарайды, осы сұраққа жауап…
Dialogue: 0,1:11:42.42,1:11:45.59,Default,,0,0,0,,Сәлем! Нобита!
Dialogue: 0,1:11:47.21,1:11:48.97,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:11:53.43,1:11:55.72,Default,,0,0,0,,Бұл тұзақ! Мен сені шұбыртпақпын!
Dialogue: 0,1:11:57.02,1:11:59.64,Default,,0,0,0,,Сәлем! Нобита!
Dialogue: 0,1:11:59.94,1:12:01.65,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:12:02.65,1:12:05.02,Default,,0,0,0,,Мен сізге қандай да бір түрде хабарлауым керек!
Dialogue: 0,1:12:07.61,1:12:10.40,Default,,0,0,0,,Ия gogggggggggggggggggggg...
Dialogue: 0,1:12:10.53,1:12:13.03,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,1:12:13.37,1:12:15.87,Default,,0,0,0,,Хмм... А, иә...
Dialogue: 0,1:12:16.04,1:12:17.20,Default,,0,0,0,,Не...
Dialogue: 0,1:12:20.25,1:12:21.67,Default,,0,0,0,,Уф... у...
Dialogue: 0,1:12:26.67,1:12:28.92,Default,,0,0,0,,Маған енді құралдар қажет емес, сондықтан оларды қайтарыңыз.
Dialogue: 0,1:12:29.05,1:12:30.63,Default,,0,0,0,,Бір минут күтіңіз! Иә
Dialogue: 0,1:12:30.76,1:12:31.43,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,1:12:31.88,1:12:33.39,Default,,0,0,0,,Мынау қайда... Уф...
Dialogue: 0,1:12:33.68,1:12:38.35,Default,,0,0,0,,Барлығына! Алданбаңыз! Бұл жалған!
Dialogue: 0,1:12:38.47,1:12:40.14,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:40.85,1:12:42.60,Default,,0,0,0,,Екі Дора-чан?
Dialogue: 0,1:12:43.23,1:12:44.86,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:12:44.98,1:12:46.82,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:12:47.27,1:12:49.07,Default,,0,0,0,,Бұл нақты нәрсе
Dialogue: 0,1:12:49.23,1:12:51.61,Default,,0,0,0,,Жоқ! Мен шынайымын!
Dialogue: 0,1:12:51.74,1:12:52.91,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:54.11,1:12:55.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:55.82,1:12:59.50,Default,,0,0,0,,Қайсысы жалған! Мен сені ұрамын! Куу!
Dialogue: 0,1:12:59.62,1:13:02.92,Default,,0,0,0,,А? Хехе, мына Дорэмонға қараңдаршы
Dialogue: 0,1:13:03.17,1:13:05.79,Default,,0,0,0,,Қоңырау да, қалта да мұздан жасалған.
Dialogue: 0,1:13:06.13,1:13:07.38,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,1:13:07.71,1:13:12.01,Default,,0,0,0,,Жарайды, егер шын болса, құралды қалтаңыздан шығарыңыз.
Dialogue: 0,1:13:12.55,1:13:14.18,Default,,0,0,0,,Әрине, әрине!
Dialogue: 0,1:13:14.93,1:13:17.43,Default,,0,0,0,,Хмм... Көрдіңіз бе?
Dialogue: 0,1:13:17.55,1:13:20.27,Default,,0,0,0,,Дұрыс айтасыз. (Сунео) Бұл Дораэмон құралы.
Dialogue: 0,1:13:20.39,1:13:22.39,Default,,0,0,0,,Сіз нені айтасыз? (Жалған Дораемон) Нии
Dialogue: 0,1:13:22.52,1:13:24.85,Default,,0,0,0,,Уф... (Сунео) Мынау жалған!
Dialogue: 0,1:13:25.23,1:13:27.56,Default,,0,0,0,,Жоқ! Мен ауыстырылдым!
Dialogue: 0,1:13:27.86,1:13:31.15,Default,,0,0,0,,Мен түсіндім, бұл мүмкін бе?
Dialogue: 0,1:13:31.28,1:13:33.53,Default,,0,0,0,,Хмм...хехе~
Dialogue: 0,1:13:33.70,1:13:36.24,Default,,0,0,0,,Олай болса менің атымды табуға тырысыңыз.
Dialogue: 0,1:13:36.37,1:13:38.53,Default,,0,0,0,,Иә, менің де атым.
Dialogue: 0,1:13:38.87,1:13:40.49,Default,,0,0,0,,Иә, бұл оңай.
Dialogue: 0,1:13:41.79,1:13:46.46,Default,,0,0,0,,Джай... Иә! Ngggggg...
Dialogue: 0,1:13:46.88,1:13:48.34,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,1:13:48.59,1:13:50.21,Default,,0,0,0,,Мен оны айта алмайтын сияқтымын.
Dialogue: 0,1:13:50.38,1:13:52.46,Default,,0,0,0,,Джан мен Сунео
Dialogue: 0,1:13:52.59,1:13:55.18,Default,,0,0,0,,Бұл не? Бұл жалған болуы керек.
Dialogue: 0,1:13:55.47,1:13:59.14,Default,,0,0,0,,Жалғансың, мен сені жазалаймын! Бум!
Dialogue: 0,1:13:59.56,1:14:01.10,Default,,0,0,0,,(Дораэмонның ыңырсыуы)
Dialogue: 0,1:14:01.35,1:14:02.43,Default,,0,0,0,,Ол кім?
Dialogue: 0,1:14:02.56,1:14:05.10,Default,,0,0,0,,Бәлкім, нағыз тұлға осы мұнараны қорғайтын тас мүсін шығар.
Dialogue: 0,1:14:05.23,1:14:06.06,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:14:06.69,1:14:09.19,Default,,0,0,0,,Оны тез салқындату шамымен мұздатайық
Dialogue: 0,1:14:09.77,1:14:11.73,Default,,0,0,0,,Уф, уф, иә! иә!
Dialogue: 0,1:14:12.19,1:14:13.82,Default,,0,0,0,,Ашумен қолдарыңызды көтеріңіз
Dialogue: 0,1:14:13.94,1:14:16.70,Default,,0,0,0,,Маған шынайы болмысыңды көрсетші, жалған!
Dialogue: 0,1:14:17.70,1:14:20.12,Default,,0,0,0,,Ей, мен сені аяймын.
Dialogue: 0,1:14:20.24,1:14:22.87,Default,,0,0,0,,Оның жалған екені әлі шешілген жоқ.
Dialogue: 0,1:14:23.00,1:14:24.91,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:14:25.04,1:14:29.21,Default,,0,0,0,,Қоңырау да, қалталар да, мұздар да атымызды айта алмайды.
Dialogue: 0,1:14:29.33,1:14:30.67,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:14:31.25,1:14:35.38,Default,,0,0,0,,Қарғыс атсын... Жарайды, түсіндім! Сонда сіз шешесіз
Dialogue: 0,1:14:35.97,1:14:36.84,Default,,0,0,0,,Иә!
Dialogue: 0,1:14:36.97,1:14:39.85,Default,,0,0,0,,Нобита Дораэмонды бәрінен де жақсы білуі керек.
Dialogue: 0,1:14:40.60,1:14:43.02,Default,,0,0,0,,Мен? (Жалған Дораемон) Хмм...
Dialogue: 0,1:14:45.02,1:14:45.81,Default,,0,0,0,,Эххе
Dialogue: 0,1:14:49.06,1:14:50.48,Default,,0,0,0,,Нобита, абай бол!
Dialogue: 0,1:14:52.48,1:14:54.65,Default,,0,0,0,,Ммм...
Dialogue: 0,1:14:55.69,1:14:57.03,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:58.16,1:14:58.91,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:03.91,1:15:05.58,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,1:15:06.12,1:15:07.54,Default,,0,0,0,,Хмм...
Dialogue: 0,1:15:08.21,1:15:09.96,Default,,0,0,0,,(Жалған Доремонның күлкісі)
Dialogue: 0,1:15:11.71,1:15:14.46,Default,,0,0,0,,Ей, екеуі де шынайы болуы мүмкін емес пе?
Dialogue: 0,1:15:14.76,1:15:18.80,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың? Бұл дұрыс емес!
Dialogue: 0,1:15:18.93,1:15:21.43,Default,,0,0,0,,Уф... Кара, мен сені тоңдырдым.
Dialogue: 0,1:15:21.72,1:15:23.64,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,1:15:23.76,1:15:25.02,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:15:25.97,1:15:28.31,Default,,0,0,0,,Маған кедергі жасама! Карла
Dialogue: 0,1:15:28.44,1:15:30.56,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,1:15:30.94,1:15:35.19,Default,,0,0,0,,Қоңырау мен қалта бөлек болса да, маған шынайы көрінеді!
Dialogue: 0,1:15:35.32,1:15:39.28,Default,,0,0,0,,Оның атын айта алмасаңыз да, Дораемон бәрібір Дораемон!
Dialogue: 0,1:15:39.45,1:15:41.74,Default,,0,0,0,,Ngggg...
Dialogue: 0,1:15:42.12,1:15:43.41,Default,,0,0,0,,Нобита...
Dialogue: 0,1:15:44.91,1:15:46.58,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,1:15:47.79,1:15:50.83,Default,,0,0,0,,Осындай ақымақтық бар ма? Ти!
Dialogue: 0,1:15:50.96,1:15:53.92,Default,,0,0,0,,Маған қарызға бер! Уф... (Карла) Уф, күте тұрыңыз!
Dialogue: 0,1:15:54.09,1:15:55.42,Default,,0,0,0,,Ха! (Карла) Ах!
Dialogue: 0,1:15:57.42,1:15:58.26,Default,,0,0,0,,Уф!
Dialogue: 0,1:15:59.26,1:16:00.30,Default,,0,0,0,,Уф...
Dialogue: 0,1:16:01.64,1:16:03.39,Default,,0,0,0,,Нобита! Нобита-сан!
Dialogue: 0,1:16:07.06,1:16:08.81,Default,,0,0,0,,Ах... Дораемон!
Dialogue: 0,1:16:09.10,1:16:11.31,Default,,0,0,0,,Ngggg...
Dialogue: 0,1:16:11.44,1:16:14.61,Default,,0,0,0,,Маған көмектескеніңіз үшін рахмет.
Dialogue: 0,1:16:14.98,1:16:18.07,Default,,0,0,0,,Күрсін... Мен қатты қорықтым.
Dialogue: 0,1:16:18.49,1:16:20.57,Default,,0,0,0,,Сонымен сіз Нобитаға көмектестіңіз...
Dialogue: 0,1:16:21.24,1:16:22.28,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:16:22.41,1:16:23.99,Default,,0,0,0,,Бұл жалған!
Dialogue: 0,1:16:27.83,1:16:33.50,Default,,0,0,0,,(Жалған Доремон айқайлайды)
Dialogue: 0,1:16:43.39,1:16:44.55,Default,,0,0,0,,Ол қатып қалды
Dialogue: 0,1:16:46.39,1:16:50.23,Default,,0,0,0,,Hmm… Haaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa! Мен сөйлесе аламын!
Dialogue: 0,1:16:50.35,1:16:52.69,Default,,0,0,0,,А, кетші! (Нобита) Дораемон?
Dialogue: 0,1:16:52.81,1:16:57.61,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,1:16:57.73,1:16:58.69,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,1:17:09.75,1:17:11.41,Default,,0,0,0,,Я~
Dialogue: 0,1:17:11.54,1:17:14.04,Default,,0,0,0,,Мен сені шашпақшы едім!
Dialogue: 0,1:17:14.17,1:17:16.38,Default,,0,0,0,,Мен Дораемонның арқасында құтқарылдым
Dialogue: 0,1:17:16.54,1:17:17.96,Default,,0,0,0,,Я~
Dialogue: 0,1:17:18.09,1:17:20.88,Default,,0,0,0,,Ах... Эй, мына жер...
Dialogue: 0,1:17:22.05,1:17:25.34,Default,,0,0,0,,Бұл біздің өткенге саяхат жасаған жер емес пе?
Dialogue: 0,1:17:26.18,1:17:27.55,Default,,0,0,0,,Бұл рас.
Dialogue: 0,1:17:27.93,1:17:31.31,Default,,0,0,0,,Жалғанның нақты тұлғасы сол пингвин болды!
Dialogue: 0,1:17:31.93,1:17:34.52,Default,,0,0,0,,Сол жерде қатып қал!
Dialogue: 0,1:17:34.65,1:17:36.27,Default,,0,0,0,,100 000 жылдан кейін...
Dialogue: 0,1:17:36.40,1:17:39.02,Default,,0,0,0,,Джиан оны тарамайды.
Dialogue: 0,1:17:39.48,1:17:40.82,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:17:41.53,1:17:44.82,Default,,0,0,0,,Содан кейін мен оны дәл қазір алып мета-метаға айналдырамын!
Dialogue: 0,1:17:44.95,1:17:47.87,Default,,0,0,0,,Осылай жасасаңыз, тарих өзгереді.
Dialogue: 0,1:17:48.20,1:17:49.91,Default,,0,0,0,,Оны сол күйінде қалдырайық.
Dialogue: 0,1:17:52.25,1:17:53.62,Default,,0,0,0,,Әй?
Dialogue: 0,1:17:57.71,1:18:00.38,Default,,0,0,0,,Сіздің арқаңызда мен құтқарылдым.
Dialogue: 0,1:18:00.55,1:18:02.59,Default,,0,0,0,,Дораэмон Ертерек үшін кешіріңіз.
Dialogue: 0,1:18:02.71,1:18:04.72,Default,,0,0,0,,Бұл біздің кінәміз болды.
Dialogue: 0,1:18:04.84,1:18:06.80,Default,,0,0,0,,Жарайды, менің амалым жоқ.
Dialogue: 0,1:18:06.93,1:18:09.39,Default,,0,0,0,,Эй, айтпақшы, сақина ше?
Dialogue: 0,1:18:13.23,1:18:14.39,Default,,0,0,0,,Сол жерде
Dialogue: 0,1:18:15.35,1:18:17.19,Default,,0,0,0,,Дораемонға сілтеме жасайды
Dialogue: 0,1:18:17.31,1:18:20.19,Default,,0,0,0,,Мүмкін... Иә?
Dialogue: 0,1:18:21.53,1:18:22.65,Default,,0,0,0,,Бұл...
Dialogue: 0,1:18:24.28,1:18:25.40,Default,,0,0,0,,Қоңырау!
Dialogue: 0,1:18:25.57,1:18:28.03,Default,,0,0,0,,Оның қалтасында болды.
Dialogue: 0,1:18:28.41,1:18:29.28,Default,,0,0,0,,Карла
Dialogue: 0,1:18:30.58,1:18:32.29,Default,,0,0,0,,Иә, бұл
Dialogue: 0,1:18:35.79,1:18:36.75,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:18:38.42,1:18:40.71,Default,,0,0,0,,(Үшеуі) Қане, бастаймыз~! (Танжиро) Уа!
Dialogue: 0,1:18:42.59,1:18:43.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:44.01,1:18:45.67,Default,,0,0,0,,Не болды? Ах...
Dialogue: 0,1:18:46.17,1:18:48.51,Default,,0,0,0,,Қатты! Қазірдің өзінде түн болды
Dialogue: 0,1:18:53.14,1:18:54.98,Default,,0,0,0,,Дәрігер, мен сақинаны алдым.
Dialogue: 0,1:18:55.60,1:18:56.77,Default,,0,0,0,,Жарайсың
Dialogue: 0,1:18:56.94,1:18:59.94,Default,,0,0,0,,Бірақ сақина Близзагаға қайтарылуы керек.
Dialogue: 0,1:19:00.15,1:19:00.90,Default,,0,0,0,,Қайтару?
Dialogue: 0,1:19:01.19,1:19:04.36,Default,,0,0,0,,Бұл Близзага аяқталмаған.
Dialogue: 0,1:19:04.78,1:19:09.66,Default,,0,0,0,,Ол аяқталмай тұрып, өмірге әкелінді.
Dialogue: 0,1:19:10.95,1:19:13.79,Default,,0,0,0,,Біз оны шештік
Dialogue: 0,1:19:14.29,1:19:15.70,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:19:15.83,1:19:19.37,Default,,0,0,0,,Егер бұлай жалғаса берсе, бұл планета да мұзда қатып қалады.
Dialogue: 0,1:19:19.50,1:19:20.50,Default,,0,0,0,,Не? (Нобита) Міне!
Dialogue: 0,1:19:20.63,1:19:22.00,Default,,0,0,0,,Мына жаққа қара!
Dialogue: 0,1:19:24.38,1:19:27.22,Default,,0,0,0,,Блицзага оянғалы жатыр.
Dialogue: 0,1:19:27.88,1:19:30.47,Default,,0,0,0,,Қара, мүмкін әлі уақыт бар шығар.
Dialogue: 0,1:19:30.64,1:19:32.18,Default,,0,0,0,,Сақинаны орнына қойыңыз
Dialogue: 0,1:19:33.01,1:19:35.89,Default,,0,0,0,,Әй, сақинаны қайта салсам не болады?
Dialogue: 0,1:19:36.02,1:19:38.06,Default,,0,0,0,,Білмеймін, бірақ әзірге...
Dialogue: 0,1:19:38.19,1:19:41.35,Default,,0,0,0,,Бірақ бұл сақинасыз Хёга Хёга жұлдызының мұзы!
Dialogue: 0,1:19:41.48,1:19:43.15,Default,,0,0,0,,Не айтып тұрсың! (Карла) Иә?
Dialogue: 0,1:19:43.52,1:19:45.65,Default,,0,0,0,,Жер қатып тұр!
Dialogue: 0,1:19:45.78,1:19:46.61,Default,,0,0,0,,Дұрыс!
Dialogue: 0,1:19:46.94,1:19:48.07,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,1:19:48.20,1:19:49.78,Default,,0,0,0,,Мына сақинаны маған бер!
Dialogue: 0,1:19:49.91,1:19:50.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:52.32,1:19:54.49,Default,,0,0,0,,Ах... (Дораэмон/Нобита) Ах...
Dialogue: 0,1:19:55.12,1:19:57.25,Default,,0,0,0,,Иә? (Нобита) А...
Dialogue: 0,1:20:03.96,1:20:05.88,Default,,0,0,0,,Жоқ, біз уақытында үлгермейміз!
Dialogue: 0,1:20:49.21,1:20:50.38,Default,,0,0,0,,Киіз үй…
Dialogue: 0,1:20:55.18,1:20:57.31,Default,,0,0,0,,Төбеде үлкен тесік бар...
Dialogue: 0,1:20:57.64,1:20:58.31,Default,,0,0,0,,Міне!
Dialogue: 0,1:21:06.77,1:21:08.23,Default,,0,0,0,,Блицзага
Dialogue: 0,1:21:08.40,1:21:10.49,Default,,0,0,0,,Бұл не? (Сунео) Мен ояндым.
Dialogue: 0,1:21:10.78,1:21:14.66,Default,,0,0,0,,Қарғыс атсын, жерді тоңдырайық!
Dialogue: 0,1:21:15.32,1:21:17.99,Default,,0,0,0,,(Джианның ән салған дауысы)
Dialogue: 0,1:21:18.12,1:21:19.20,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:21:19.33,1:21:21.45,Default,,0,0,0,,Егер солай істесең, ол сені табады!
Dialogue: 0,1:21:21.58,1:21:24.21,Default,,0,0,0,,Барлығына! Асығыңыз және мұнараға кіріңіз!
Dialogue: 0,1:21:30.55,1:21:31.63,Default,,0,0,0,,Киіз үй!
Dialogue: 0,1:21:32.97,1:21:35.26,Default,,0,0,0,,Қарғыс атсын! Сіз жасадыңыз!
Dialogue: 0,1:21:35.39,1:21:36.76,Default,,0,0,0,,А... Иә?
Dialogue: 0,1:21:36.89,1:21:38.31,Default,,0,0,0,,Мукю…
Dialogue: 0,1:21:38.60,1:21:40.06,Default,,0,0,0,,Қатты! Менің құлағым...
Dialogue: 0,1:21:40.18,1:21:43.77,Default,,0,0,0,,А... менің сөмкем! Ішінде дәрі бар
Dialogue: 0,1:21:43.98,1:21:46.02,Default,,0,0,0,,Жарайды, тез жазылады.
Dialogue: 0,1:21:46.15,1:21:47.77,Default,,0,0,0,,Иә? Дәрігер!
Dialogue: 0,1:21:48.02,1:21:51.15,Default,,0,0,0,,Паопао мен оның баспанаға оралған достары аман.
Dialogue: 0,1:21:51.28,1:21:52.99,Default,,0,0,0,,Мен қазір сонда бара жатырмын.
Dialogue: 0,1:21:53.28,1:21:55.95,Default,,0,0,0,,Жоқ, қазір мұнда келу қауіпті!
Dialogue: 0,1:22:10.92,1:22:12.96,Default,,0,0,0,,Қала тоңып тұр (Қара) Артқа тұр!
Dialogue: 0,1:22:13.09,1:22:13.76,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,1:22:14.97,1:22:16.22,Default,,0,0,0,,Уау...
Dialogue: 0,1:22:16.64,1:22:19.18,Default,,0,0,0,,Мен не істеуім керек? Түнге таяп қалды.
Dialogue: 0,1:22:19.55,1:22:22.39,Default,,0,0,0,,Дұрыс, уақыт белдеуін қолданыңыз. Барлығыңыз, көтеріліңіздер!
Dialogue: 0,1:22:23.22,1:22:24.48,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:22:24.60,1:22:27.69,Default,,0,0,0,,Біз 100 000 жылдан кейін көшіреміз!
Dialogue: 0,1:22:27.81,1:22:29.15,Default,,0,0,0,,Мофу
Dialogue: 0,1:22:29.81,1:22:31.94,Default,,0,0,0,,Барлығына! Күте тұр!
Dialogue: 0,1:22:34.03,1:22:35.03,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:22:42.66,1:22:43.95,Default,,0,0,0,,Пао Ух... Ах!
Dialogue: 0,1:22:44.50,1:22:45.37,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:22:45.50,1:22:46.33,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:22:48.83,1:22:51.17,Default,,0,0,0,,Нобита!
Dialogue: 0,1:22:53.13,1:22:55.13,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:23:00.72,1:23:01.68,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:01.81,1:23:04.02,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:23:05.43,1:23:07.23,Default,,0,0,0,,Уф... Ааа!
Dialogue: 0,1:23:07.52,1:23:10.31,Default,,0,0,0,,Оны ашық ұстаңыз...
Dialogue: 0,1:23:10.44,1:23:12.36,Default,,0,0,0,,Ах~ Ах~ Тейе
Dialogue: 0,1:23:15.86,1:23:18.15,Default,,0,0,0,,Міне, біз 100 000 жылдан кейін келеміз?
Dialogue: 0,1:23:18.28,1:23:19.41,Default,,0,0,0,,Барлығы, күте тұрыңдар!
Dialogue: 0,1:23:19.53,1:23:22.28,Default,,0,0,0,,Мен Юкатан мен Дорэмонды алып кетейін. иә?
Dialogue: 0,1:23:22.41,1:23:24.37,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:23:24.58,1:23:27.00,Default,,0,0,0,,Батарея бітті! (Нобита) Осымен.
Dialogue: 0,1:23:29.83,1:23:32.54,Default,,0,0,0,,А... кетті!
Dialogue: 0,1:23:34.34,1:23:38.43,Default,,0,0,0,,Эй... бұл жер Антарктиданың мұзының астында, солай ма?
Dialogue: 0,1:23:39.34,1:23:42.89,Default,,0,0,0,,Мүмкін біз тұзаққа түскен шығармыз?
Dialogue: 0,1:23:43.01,1:23:44.43,Default,,0,0,0,,Хмм...
Dialogue: 0,1:23:44.68,1:23:46.93,Default,,0,0,0,,Жалпы айтқанда, Кара мен басқалары мұнда келмесе...
Dialogue: 0,1:23:47.06,1:23:48.06,Default,,0,0,0,,Дұрыс!
Dialogue: 0,1:23:48.23,1:23:50.94,Default,,0,0,0,,Бұл сіздердің арқаларыңызда болды!
Dialogue: 0,1:23:51.23,1:23:52.11,Default,,0,0,0,,Мен?
Dialogue: 0,1:23:52.23,1:23:54.52,Default,,0,0,0,,Ммм! Бірдеңе істе, Кара!
Dialogue: 0,1:23:54.65,1:23:55.36,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:56.94,1:23:58.24,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:23:58.36,1:24:01.07,Default,,0,0,0,,Кара өз планетасын құтқарғысы келді.
Dialogue: 0,1:24:01.20,1:24:02.41,Default,,0,0,0,,Менің таңдауым жоқ!
Dialogue: 0,1:24:03.07,1:24:03.91,Default,,0,0,0,,Нобита...
Dialogue: 0,1:24:04.28,1:24:06.58,Default,,0,0,0,,Иә, тоқтаңдар, екеуің де!
Dialogue: 0,1:24:06.75,1:24:09.12,Default,,0,0,0,,Қат! Қарғыс атсын!
Dialogue: 0,1:24:09.62,1:24:11.08,Default,,0,0,0,,Неге мен?
Dialogue: 0,1:24:11.25,1:24:14.34,Default,,0,0,0,,Анашым!
Dialogue: 0,1:24:15.05,1:24:16.88,Default,,0,0,0,,Мыңғыр!
Dialogue: 0,1:24:17.01,1:24:18.09,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,1:24:18.38,1:24:19.67,Default,,0,0,0,,Мофу!
Dialogue: 0,1:24:29.77,1:24:33.15,Default,,0,0,0,,Айаяя... Ууууу...
Dialogue: 0,1:24:33.48,1:24:35.52,Default,,0,0,0,,Тым суық, мен мұны істей алмаймын деп ойлаймын.
Dialogue: 0,1:24:35.65,1:24:37.90,Default,,0,0,0,,Дорамидің болжамы дұрыс болды...
Dialogue: 0,1:24:38.03,1:24:43.07,Default,,0,0,0,,Уақыт белдеуінің батареясы таусылған болуы мүмкін, сондықтан мен мұзда қалып қоямын...
Dialogue: 0,1:24:43.20,1:24:44.78,Default,,0,0,0,,Пао~ Аа...
Dialogue: 0,1:24:44.91,1:24:47.33,Default,,0,0,0,,Дұрыс, берілме.
Dialogue: 0,1:24:47.45,1:24:50.21,Default,,0,0,0,,Мен Нобита-кунмен бірге болуым керек.
Dialogue: 0,1:24:50.87,1:24:54.96,Default,,0,0,0,,Егер біз 100 000 жылдан кейін қосалқы аккумуляторды жеткізе алсақ...
Dialogue: 0,1:24:55.46,1:24:56.13,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:57.75,1:24:59.96,Default,,0,0,0,,Жақында, бір жерде...
Dialogue: 0,1:25:00.76,1:25:01.42,Default,,0,0,0,,Әй!
Dialogue: 0,1:25:05.80,1:25:08.14,Default,,0,0,0,,Кел, жоғарыға көтерілейік.
Dialogue: 0,1:25:10.10,1:25:11.43,Default,,0,0,0,,Мофф~
Dialogue: 0,1:25:11.56,1:25:14.40,Default,,0,0,0,,Мұзға түсу арқылы ұйықтауға болады.
Dialogue: 0,1:25:14.52,1:25:16.23,Default,,0,0,0,,Төтенше жағдайда, тіпті сіз...
Dialogue: 0,1:25:16.36,1:25:17.19,Default,,0,0,0,,Мофф~
Dialogue: 0,1:25:18.15,1:25:22.45,Default,,0,0,0,,Мен өнімділігі жоғары роботпын, бірақ мен ұйықтай алмаймын.
Dialogue: 0,1:25:23.32,1:25:24.61,Default,,0,0,0,,Күту күйі?
Dialogue: 0,1:25:25.28,1:25:28.54,Default,,0,0,0,,Иә? Күте тұрыңыз, бұл батарея ...
Dialogue: 0,1:25:29.83,1:25:31.83,Default,,0,0,0,,Бақытты зат – жұлдыз
Dialogue: 0,1:25:32.16,1:25:33.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:35.42,1:25:37.21,Default,,0,0,0,,Түсіндім! Түсіндім!
Dialogue: 0,1:25:38.50,1:25:40.84,Default,,0,0,0,,Бұл сіз пайдалана алатын жалғыз құрал ма?
Dialogue: 0,1:25:41.17,1:25:44.18,Default,,0,0,0,,Егер сіз шыңға шықсаңыз, онда мұз асты барлау көлігі болуы керек.
Dialogue: 0,1:25:44.34,1:25:45.93,Default,,0,0,0,,Ол сынған, бірақ...
Dialogue: 0,1:25:46.05,1:25:47.14,Default,,0,0,0,,Хмм...
Dialogue: 0,1:25:47.26,1:25:49.26,Default,,0,0,0,,Мен қазір көмекке қоңырау шала аламын ба?
Dialogue: 0,1:25:54.19,1:25:56.86,Default,,0,0,0,,Бұл уақыт белдеуінің батареясы ма?
Dialogue: 0,1:25:57.02,1:26:00.02,Default,,0,0,0,,Хмм... Мен оны бір жерден көргендей болдым...
Dialogue: 0,1:26:00.19,1:26:01.69,Default,,0,0,0,,Мофф~ (Нобита) А...
Dialogue: 0,1:26:02.03,1:26:03.90,Default,,0,0,0,,Мофусуке?
Dialogue: 0,1:26:04.03,1:26:06.16,Default,,0,0,0,,Сіздің сөмкеңіз осында болды ма?
Dialogue: 0,1:26:06.61,1:26:09.08,Default,,0,0,0,,Әй, мына сөмкеге не болды?
Dialogue: 0,1:26:09.53,1:26:11.70,Default,,0,0,0,,Мен Мофусукемен бірге қатып қалдым.
Dialogue: 0,1:26:11.83,1:26:12.70,Default,,0,0,0,,Мофф~
Dialogue: 0,1:26:13.08,1:26:16.00,Default,,0,0,0,,Мынау дәрігердің сөмкесі ғой, иә?
Dialogue: 0,1:26:16.21,1:26:18.63,Default,,0,0,0,,Юкатанда сөмке болуы керек.
Dialogue: 0,1:26:19.25,1:26:23.80,Default,,0,0,0,,Ойланып қарашы, Мофусуке-чан, қызық, сен неге мұндай жерде қыстағансың?
Dialogue: 0,1:26:24.88,1:26:27.26,Default,,0,0,0,,Эй, сен бірдеңе білесің бе?
Dialogue: 0,1:26:28.05,1:26:29.72,Default,,0,0,0,,Могу~
Dialogue: 0,1:26:30.22,1:26:31.85,Default,,0,0,0,,Мофусуке…
Dialogue: 0,1:26:32.27,1:26:33.81,Default,,0,0,0,,Юкатан…
Dialogue: 0,1:26:34.31,1:26:35.19,Default,,0,0,0,,Ммм, дәмді!
Dialogue: 0,1:26:35.52,1:26:36.44,Default,,0,0,0,,Маған бересің бе?
Dialogue: 0,1:26:36.56,1:26:38.61,Default,,0,0,0,,Мен оны бір жерден көргендей сезінемін...
Dialogue: 0,1:26:38.73,1:26:41.90,Default,,0,0,0,,Мен оны «Мофусуке» деп атадым, себебі ол үлпілдек.
Dialogue: 0,1:26:44.24,1:26:45.49,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:45.74,1:26:48.11,Default,,0,0,0,,Ха! Мүмкін... аа...
Dialogue: 0,1:26:49.41,1:26:54.54,Default,,0,0,0,,Ах... Дораемон! Бұл дұрыс! Бұл дұрыс!
Dialogue: 0,1:26:54.91,1:26:57.46,Default,,0,0,0,,Барлығына! Сіз Дораэмон-ға көмектесе аласыз!
Dialogue: 0,1:26:57.62,1:26:58.63,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:58.75,1:26:59.83,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:27:04.76,1:27:06.80,Default,,0,0,0,,Мұзда қауіпсіз
Dialogue: 0,1:27:07.22,1:27:11.01,Default,,0,0,0,,Юкатан, сол сөмкені Нобита-кунға жеткіз.
Dialogue: 0,1:27:18.35,1:27:20.44,Default,,0,0,0,,Неліктен сөмкеде батареялар бар?
Dialogue: 0,1:27:20.61,1:27:22.94,Default,,0,0,0,,Дораэмон оны Мофусукеге берді.
Dialogue: 0,1:27:26.40,1:27:27.15,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:27:27.61,1:27:28.53,Default,,0,0,0,,Ол қозғалды!
Dialogue: 0,1:27:28.66,1:27:31.82,Default,,0,0,0,,Бірақ... сонда Мофусуке қайдан шықты?
Dialogue: 0,1:27:31.95,1:27:33.58,Default,,0,0,0,,Мофусуке 100 000 жыл бұрын—
Dialogue: 0,1:27:33.70,1:27:36.41,Default,,0,0,0,,Бұл Дораэмон ұйықтаған Юкатан болды.
Dialogue: 0,1:27:36.54,1:27:38.79,Default,,0,0,0,,Не? Могу~
Dialogue: 0,1:27:38.92,1:27:41.04,Default,,0,0,0,,Мофусуке Юкатан болды ма?
Dialogue: 0,1:27:41.17,1:27:44.59,Default,,0,0,0,,Жоқ, Юкатан Мофусуке-чан болды.
Dialogue: 0,1:27:44.71,1:27:46.46,Default,,0,0,0,,Бірақ түстері әртүрлі.
Dialogue: 0,1:27:46.63,1:27:49.84,Default,,0,0,0,,Қысқы ұйқы кезінде көгерген болуы мүмкін.
Dialogue: 0,1:27:51.47,1:27:53.64,Default,,0,0,0,,Кеттік! 100 000 жыл бұрын!
Dialogue: 0,1:27:53.76,1:27:55.52,Default,,0,0,0,,Бірақ сол құбыжық ше?
Dialogue: 0,1:27:55.64,1:27:58.27,Default,,0,0,0,,Дұрыс, біз оны жеңуіміз керек!
Dialogue: 0,1:27:58.39,1:28:00.73,Default,,0,0,0,,Қалай? Ах...
Dialogue: 0,1:28:01.10,1:28:02.44,Default,,0,0,0,,Сақина бар (Джан Нобита) иә?
Dialogue: 0,1:28:03.02,1:28:05.36,Default,,0,0,0,,Бұл сақина оны жауып тастайды.
Dialogue: 0,1:28:06.32,1:28:07.65,Default,,0,0,0,,Жарайды ма? Карла
Dialogue: 0,1:28:07.99,1:28:10.32,Default,,0,0,0,,Мен сіздің планетаңызды мұздатқанша -
Dialogue: 0,1:28:10.45,1:28:13.03,Default,,0,0,0,,Хёга Хиога планетасын құтқару мүмкін емес!
Dialogue: 0,1:28:13.53,1:28:16.20,Default,,0,0,0,,Қара Жарайды, кеттік!
Dialogue: 0,1:28:16.33,1:28:19.50,Default,,0,0,0,,Мұндай құбыжықпен қалай жақындайсың?
Dialogue: 0,1:28:20.00,1:28:22.67,Default,,0,0,0,,Маған қалдырыңыз, менде жақсы ой бар.
Dialogue: 0,1:28:22.79,1:28:24.59,Default,,0,0,0,,Иә? Уху
Dialogue: 0,1:28:24.71,1:28:28.21,Default,,0,0,0,,Уф... Жарайды, менің кетуім керек шығар!
Dialogue: 0,1:28:29.01,1:28:31.43,Default,,0,0,0,,Барлығың дайынсыңдар ма? (Сунео) Иә!
Dialogue: 0,1:28:31.55,1:28:33.68,Default,,0,0,0,,О! Мофф!
Dialogue: 0,1:28:33.80,1:28:35.64,Default,,0,0,0,,Иә! иә!
Dialogue: 0,1:28:36.01,1:28:37.56,Default,,0,0,0,,Олай болса кеттік!
Dialogue: 0,1:28:37.68,1:28:40.44,Default,,0,0,0,,Жерді бірге құтқарайық!
Dialogue: 0,1:28:52.86,1:28:53.74,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:55.95,1:28:59.12,Default,,0,0,0,,Takecopter... Ах! Апыр-ай!
Dialogue: 0,1:29:03.75,1:29:04.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:06.96,1:29:08.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:29:10.88,1:29:13.22,Default,,0,0,0,,Ууууууу...
Dialogue: 0,1:29:13.72,1:29:15.18,Default,,0,0,0,,Иә... Ах!
Dialogue: 0,1:29:20.93,1:29:21.77,Default,,0,0,0,,Хирари!
Dialogue: 0,1:29:21.89,1:29:23.60,Default,,0,0,0,,Джан! Сунео!
Dialogue: 0,1:29:23.73,1:29:25.48,Default,,0,0,0,,Хирари Йотто
Dialogue: 0,1:29:26.27,1:29:28.78,Default,,0,0,0,,Оның денесі үлкен, бірақ қимылдары баяу!
Dialogue: 0,1:29:29.40,1:29:31.74,Default,,0,0,0,,Хоорахо, міне, осында~
Dialogue: 0,1:29:32.24,1:29:34.91,Default,,0,0,0,,Батареялар келді... Ах!
Dialogue: 0,1:29:37.49,1:29:41.91,Default,,0,0,0,,Нобита-кун! Шизука-чан да! Сен келдің.
Dialogue: 0,1:29:42.58,1:29:44.58,Default,,0,0,0,,Блицзага алыптарды тартады.
Dialogue: 0,1:29:44.71,1:29:45.88,Default,,0,0,0,,Қазір!
Dialogue: 0,1:29:55.01,1:29:57.55,Default,,0,0,0,,Жақсы, онда жоспарды орындаңыз.
Dialogue: 0,1:29:57.68,1:29:59.01,Default,,0,0,0,,Мофф~!
Dialogue: 0,1:30:01.35,1:30:04.35,Default,,0,0,0,,Hore hore~ мұнда~
Dialogue: 0,1:30:16.36,1:30:17.70,Default,,0,0,0,,Үлпілдек спрей
Dialogue: 0,1:30:25.29,1:30:28.58,Default,,0,0,0,,Оңай құтыла алмайсың.
Dialogue: 0,1:30:28.71,1:30:29.38,Default,,0,0,0,,Ах, Маеда әлі тірі екені
Dialogue: 0,1:30:35.97,1:30:37.72,Default,,0,0,0,,Қанаттар өсті!
Dialogue: 0,1:30:37.84,1:30:40.56,Default,,0,0,0,,Мен бұл туралы естіген жоқпын!
Dialogue: 0,1:30:47.69,1:30:49.48,Default,,0,0,0,,Үлпілдек спрей...
Dialogue: 0,1:30:49.98,1:30:53.07,Default,,0,0,0,,Ол төбедегі тесіктен шығуға тырысады.
Dialogue: 0,1:30:53.99,1:30:59.28,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,1:30:59.70,1:31:02.37,Default,,0,0,0,,Хирари! Барлығы артымда
Dialogue: 0,1:31:02.49,1:31:04.83,Default,,0,0,0,,Иә! Сунео!
Dialogue: 0,1:31:04.95,1:31:07.08,Default,,0,0,0,,Ах! Уф... плащ!
Dialogue: 0,1:31:07.21,1:31:10.08,Default,,0,0,0,,Сондай-ақ... енді жоқ! Ах
Dialogue: 0,1:31:10.21,1:31:12.00,Default,,0,0,0,,Иә? Мынаны қара!
Dialogue: 0,1:31:20.30,1:31:22.72,Default,,0,0,0,,Баяулады (Сунео) Міне!
Dialogue: 0,1:31:23.89,1:31:24.93,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:31:25.39,1:31:28.64,Default,,0,0,0,,Мен тапсырыс қалтасын пайдаланып көл суына тапсырыс бердім.
Dialogue: 0,1:31:28.90,1:31:29.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:31:30.81,1:31:34.40,Default,,0,0,0,,Денесі мұз болғандықтан суға қарсы әлсіз.
Dialogue: 0,1:31:35.23,1:31:36.61,Default,,0,0,0,,Нобита-кун, қазір!
Dialogue: 0,1:31:37.03,1:31:38.57,Default,,0,0,0,,Кеттік Карла (Карла) Иә!
Dialogue: 0,1:31:57.09,1:31:58.09,Default,,0,0,0,,Қара!
Dialogue: 0,1:32:02.72,1:32:03.85,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:32:04.89,1:32:07.39,Default,,0,0,0,,Укккккккккккк...
Dialogue: 0,1:32:09.98,1:32:11.19,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:23.07,1:32:24.74,Default,,0,0,0,,Жарық сөніп барады...
Dialogue: 0,1:32:29.29,1:32:30.96,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,1:32:31.08,1:32:33.42,Default,,0,0,0,,Иә! Ухуху
Dialogue: 0,1:32:35.34,1:32:36.34,Default,,0,0,0,,Қабыл ал!
Dialogue: 0,1:33:18.25,1:33:19.96,Default,,0,0,0,,Сол жерде.
Dialogue: 0,1:33:20.13,1:33:21.55,Default,,0,0,0,,Хмм.
Dialogue: 0,1:33:27.68,1:33:29.81,Default,,0,0,0,,Иә? (Сунео) А, уф.
Dialogue: 0,1:33:30.68,1:33:31.81,Default,,0,0,0,,Міне болды, Джан.
Dialogue: 0,1:33:31.98,1:33:34.15,Default,,0,0,0,,Менің кесе раменім
Dialogue: 0,1:33:34.60,1:33:37.65,Default,,0,0,0,,Менің жоғары сапалы шоколадым Ах...
Dialogue: 0,1:33:38.15,1:33:41.19,Default,,0,0,0,,Қарашы, Джан, бұл...
Dialogue: 0,1:33:50.24,1:33:51.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:53.96,1:33:55.50,Default,,0,0,0,,Кешіріңіз, Кара.
Dialogue: 0,1:33:56.63,1:33:59.46,Default,,0,0,0,,Жарайды, мен басқа жұлдызды іздеймін.
Dialogue: 0,1:34:00.76,1:34:01.67,Default,,0,0,0,,Карла
Dialogue: 0,1:34:02.13,1:34:05.51,Default,,0,0,0,,Ғалам кең, ол бір жерде болуы керек.
Dialogue: 0,1:34:06.05,1:34:08.01,Default,,0,0,0,,Эй, Такеши мырза және басқалар?
Dialogue: 0,1:34:08.14,1:34:09.56,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,1:34:09.68,1:34:12.14,Default,,0,0,0,,Сәлем! (Барлығы) Ах...
Dialogue: 0,1:34:12.56,1:34:13.85,Default,,0,0,0,,Эй
Dialogue: 0,1:34:14.48,1:34:16.02,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,1:34:16.19,1:34:17.56,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,1:34:17.98,1:34:20.19,Default,,0,0,0,,Бұл тас жарғанақтың ұясында болды.
Dialogue: 0,1:34:20.36,1:34:22.03,Default,,0,0,0,,Олар оларды жинап жатты.
Dialogue: 0,1:34:24.65,1:34:26.24,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:26.66,1:34:27.70,Default,,0,0,0,,Сақина?
Dialogue: 0,1:34:28.12,1:34:29.53,Default,,0,0,0,,Бұл...
Dialogue: 0,1:34:29.87,1:34:32.41,Default,,0,0,0,,Оны қарастырған жөн.
Dialogue: 0,1:34:33.04,1:34:35.75,Default,,0,0,0,,Хёга Мүмкін біз Хёга планетасын құтқара аламыз.
Dialogue: 0,1:34:36.96,1:34:38.33,Default,,0,0,0,,Керемет! Карла
Dialogue: 0,1:34:38.46,1:34:40.88,Default,,0,0,0,,Иә! Рахмет Нобита
Dialogue: 0,1:34:41.00,1:34:42.09,Default,,0,0,0,,Және бәрі де.
Dialogue: 0,1:34:42.21,1:34:43.38,Default,,0,0,0,,Иә, иә, жұмсақ
Dialogue: 0,1:34:43.96,1:34:47.84,Default,,0,0,0,,Сені жерге түсірейік. Барлығыңыз, баспанаға кіріңіздер.
Dialogue: 0,1:34:47.97,1:34:49.35,Default,,0,0,0,,Паопао~
Dialogue: 0,1:35:07.41,1:35:09.62,Default,,0,0,0,,Эй, Юкатан жақсы ма?
Dialogue: 0,1:35:10.20,1:35:13.33,Default,,0,0,0,,Жарайды, балалар мені 100 000 жылдан кейін оятасыңдар.
Dialogue: 0,1:35:13.70,1:35:14.95,Default,,0,0,0,,100 000 жыл…
Dialogue: 0,1:35:15.08,1:35:17.58,Default,,0,0,0,,Олар үшін ұйықтау сияқты
Dialogue: 0,1:35:17.75,1:35:19.29,Default,,0,0,0,,Киіз үй~
Dialogue: 0,1:36:04.30,1:36:05.59,Default,,0,0,0,,(Ағылшын тілі радиосы)
Dialogue: 0,1:36:05.71,1:36:07.84,Default,,0,0,0,,Шырынды науқан қазір жүріп жатыр
Dialogue: 0,1:36:07.97,1:36:09.47,Default,,0,0,0,,Иә, шынымен.
Dialogue: 0,1:36:09.59,1:36:11.05,Default,,0,0,0,,Салауатты денсаулық жаттығулары...
Dialogue: 0,1:36:11.30,1:36:13.22,Default,,0,0,0,,Күннің қатты ыстығынан құтылу —
Dialogue: 0,1:36:13.39,1:36:17.10,Default,,0,0,0,,Ертең біраз уақыттан кейін бірінші қолайлы күн болатын сияқты.
Dialogue: 0,1:36:17.22,1:36:19.52,Default,,0,0,0,,Хмм, аа, мм...
Dialogue: 0,1:36:19.64,1:36:21.85,Default,,0,0,0,,Нобита-кун?
Dialogue: 0,1:36:25.69,1:36:27.32,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:36:28.32,1:36:30.32,Default,,0,0,0,,Астрономиялық бақылау
Dialogue: 0,1:36:32.41,1:36:33.62,Default,,0,0,0,,Маған доктор.
Dialogue: 0,1:36:33.74,1:36:36.70,Default,,0,0,0,,Мен оны Хёга Хёга жұлдызының координаталарына келтірдім.
Dialogue: 0,1:36:37.04,1:36:39.33,Default,,0,0,0,,Өйткені ол 100 000 жарық жылы қашықтықта орналасқан жұлдыз—
Dialogue: 0,1:36:39.46,1:36:42.21,Default,,0,0,0,,Оның 100 000 жыл бұрын қандай болғанын дәл көруге болады.
Dialogue: 0,1:36:42.96,1:36:45.25,Default,,0,0,0,,Бұл Хёга Хёга жұлдызы ма?
Dialogue: 0,1:36:45.88,1:36:48.51,Default,,0,0,0,,Ол толығымен ақ. Ол қатып қалды ма?
Dialogue: 0,1:36:48.63,1:36:50.55,Default,,0,0,0,,Мұқият қараңыз.
Dialogue: 0,1:36:55.22,1:36:58.02,Default,,0,0,0,,Мен оны көріп тұрмын! мұз ери бастайды
Dialogue: 0,1:36:58.52,1:37:01.35,Default,,0,0,0,,Дәрігердің зерттеуі сәтті болғанына сенімдімін.
Dialogue: 0,1:37:01.48,1:37:02.60,Default,,0,0,0,,Хаха
Dialogue: 0,1:37:08.19,1:37:10.53,Default,,0,0,0,,Жарайсың, Кара.
Dialogue: 0,1:37:20.45,1:37:25.33,Default,,0,0,0,,Ол әлдеқайда салқындап барады. Жаз аяқталуға жақын...
Dialogue: 0,1:37:25.50,1:37:28.92,Default,,0,0,0,,Нобита Дора-чан, кешкі ас іш
Dialogue: 0,1:37:29.05,1:37:30.88,Default,,0,0,0,,Уа!
Dialogue: 0,1:37:33.22,1:37:39.22,Default,,0,0,0,,♪〜
Dialogue: 0,1:40:16.92,1:40:22.93,Default,,0,0,0,,〜♪
