Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:01.03,0:02:11.03,Default,,0000,0000,0000,,Бұл субтитр көзі коммерциялық пайдалануға тыйым салынған субтитрлер тобының өндірісі, жеткізу алмасуы болып табылады.
Dialogue: 0,0:02:01.03,0:02:11.03,Default,,0000,0000,0000,,: ： яя : Сюра :
Dialogue: 0,0:00:11.65,0:00:13.37,Default,,0000,0000,0000,,Ол қатты жараланған еді...
Dialogue: 0,0:00:17.02,0:00:17.82,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:00:24.20,0:00:25.07,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:00:26.12,0:00:26.79,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:00:27.78,0:00:29.07,Default,,0000,0000,0000,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:02:16.22,0:02:17.46,Default,,0000,0000,0000,,Ойланба
Dialogue: 0,0:02:18.41,0:02:20.69,Default,,0000,0000,0000,,Тым терең ойламаңыз Кайто Киришима
Dialogue: 0,0:02:21.71,0:02:24.65,Default,,0000,0000,0000,,Мен кеше ағама ештеңе мойындамадым.
Dialogue: 0,0:02:25.59,0:02:28.90,Default,,0000,0000,0000,,Күні кеше болса да, ағаң байқамай қалды.
Dialogue: 0,0:02:29.64,0:02:31.61,Default,,0000,0000,0000,,Сабыр сақта, Ичика.
Dialogue: 0,0:02:32.35,0:02:35.63,Default,,0000,0000,0000,,Мен, Кайто-куннан үлкен, бар күшімді салуым керек.
Dialogue: 0,0:02:36.70,0:02:38.91,Default,,0000,0000,0000,,Таңғы асты әдеттегідей дайындаңыз.
Dialogue: 0,0:02:39.11,0:02:40.33,Default,,0000,0000,0000,,Бар күшіңізді салып көріңіз
Dialogue: 0,0:02:40.43,0:02:42.37,Default,,0000,0000,0000,,Мен түскі ас қораптарын да жасап көрдім.
Dialogue: 0,0:02:42.76,0:02:44.98,Default,,0000,0000,0000,,Иә, проблема жоқ.
Dialogue: 0,0:02:45.45,0:02:48.28,Default,,0000,0000,0000,,Бұл үйде менің ағам тұратындықтан.
Dialogue: 0,0:02:48.61,0:02:49.67,Default,,0000,0000,0000,,Дәл осы
Dialogue: 0,0:02:49.97,0:02:51.86,Default,,0000,0000,0000,,Табиғи дене, Ичика
Dialogue: 0,0:02:52.09,0:02:53.70,Default,,0000,0000,0000,,Табиғи болыңыз
Dialogue: 0,0:02:53.95,0:02:55.62,Default,,0000,0000,0000,,Әдеттегідей
Dialogue: 0,0:02:58.50,0:03:01.01,Default,,0000,0000,0000,,Қарапайым ақыл Қарапайым ақыл Қарапайым ақыл
Dialogue: 0,0:03:01.43,0:03:04.86,Default,,0000,0000,0000,,Мен тырыссам бәрін жасай алатын баламын, сондықтан менде сенімділік бар.
Dialogue: 0,0:03:05.28,0:03:07.64,Default,,0000,0000,0000,,Жоқ, баланың қолынан келетіні біртүрлі деп ойлаймын.
Dialogue: 0,0:03:07.77,0:03:08.14,Default,,0000,0000,0000,,штамп картаңды қатты үнемдеп жинап, дәл қолданар сәтте оның мерзімі өтіп кеткенін байқағандай жүз жаса,
Dialogue: 0,0:03:08.19,0:03:09.09,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:03:11.02,0:03:12.99,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:03:13.16,0:03:15.08,Default,,0000,0000,0000,,Ауа райы жақсы.
Dialogue: 0,0:03:15.32,0:03:16.72,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:03:16.82,0:03:18.17,Default,,0000,0000,0000,,Бүгін күн ашық болады.
Dialogue: 0,0:03:18.42,0:03:19.64,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:03:21.34,0:03:23.68,Default,,0000,0000,0000,,Жақында қорытынды емтихан келеді.
Dialogue: 0,0:03:24.46,0:03:25.71,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:03:26.29,0:03:28.50,Default,,0000,0000,0000,,Мен оқуда жақсы емеспін
Dialogue: 0,0:03:28.94,0:03:30.07,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:03:36.57,0:03:38.83,Default,,0000,0000,0000,,Таңертең не жегенім есімде де жоқ.
Dialogue: 0,0:03:39.90,0:03:40.92,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:03:41.37,0:03:42.54,Default,,0000,0000,0000,,Киришима-кун
Dialogue: 0,0:03:42.92,0:03:44.99,Default,,0000,0000,0000,,Ерте тұруың әдеттен тыс.
Dialogue: 0,0:03:45.66,0:03:46.76,Default,,0000,0000,0000,,Кейде.
Dialogue: 0,0:03:47.65,0:03:50.79,Default,,0000,0000,0000,,А, Танигава, кешегі күн үшін кешірім сұраймын.
Dialogue: 0,0:03:51.34,0:03:53.33,Default,,0000,0000,0000,,Оны сол күйінде қалдырыңыз
Dialogue: 0,0:03:53.50,0:03:56.67,Default,,0000,0000,0000,,Жоқ, кешіріңіз.
Dialogue: 0,0:03:57.02,0:04:00.17,Default,,0000,0000,0000,,Дұрысы, Лимон-сенпай мен Мио кінәлі.
Dialogue: 0,0:04:00.99,0:04:03.33,Default,,0000,0000,0000,,Мен де кеше қатты кешірім сұрадым.
Dialogue: 0,0:04:03.40,0:04:05.87,Default,,0000,0000,0000,,Иә, мені тыңда, Кайто-кун.
Dialogue: 0,0:04:06.25,0:04:08.90,Default,,0000,0000,0000,,Кеше ғана Лимон-сенпай емес.
Dialogue: 0,0:04:09.17,0:04:12.44,Default,,0000,0000,0000,,Тецуро мен Мио да маған қарап тұрды.
Dialogue: 0,0:04:12.66,0:04:14.18,Default,,0000,0000,0000,,О, дұрыс.
Dialogue: 0,0:04:14.31,0:04:16.43,Default,,0000,0000,0000,,Кешіріңіз, Киришима-кун.
Dialogue: 0,0:04:16.76,0:04:17.68,Default,,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:04:19.12,0:04:20.41,Default,,0000,0000,0000,,Капитан, 3D маневрге көшейік
Dialogue: 0,0:04:20.51,0:04:22.62,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:04:23.07,0:04:25.49,Default,,0000,0000,0000,,Өйткені сіздің көзқарасыңыз әдеттегіден басқаша.
Dialogue: 0,0:04:25.60,0:04:27.77,Default,,0000,0000,0000,,Иә, бұл дұрыс емес деп ойлаймын.
Dialogue: 0,0:04:27.90,0:04:29.26,Default,,0000,0000,0000,,Бұл қалыпты жағдай.
Dialogue: 0,0:04:33.91,0:04:37.05,Default,,0000,0000,0000,,Мен сіздің кеше Каруизаваға барғаныңызды естідім.
Dialogue: 0,0:04:37.25,0:04:39.37,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:04:39.75,0:04:40.82,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:41.20,0:04:42.58,Default,,0000,0000,0000,,Кішкене сатып алу
Dialogue: 0,0:04:43.12,0:04:44.59,Default,,0000,0000,0000,,Киришима-кун да сонда болды.
Dialogue: 0,0:04:46.34,0:04:47.77,Default,,0000,0000,0000,,Каруизаваға
Dialogue: 0,0:04:48.75,0:04:50.15,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:51.20,0:04:54.48,Default,,0000,0000,0000,,Киришима-кун Киришима-кун
Dialogue: 0,0:04:59.78,0:05:00.89,Default,,0000,0000,0000,,Тенген мырза… Мен үшін уайымдамаңыз; сіз қазір кетуіңіз керек.
Dialogue: 0,0:05:09.62,0:05:12.90,Default,,0000,0000,0000,,Ақыр соңында, сіз қиындық тудырып жатырсыз.
Dialogue: 0,0:05:13.21,0:05:15.68,Default,,0000,0000,0000,,Жоқ, ондай ештеңе жоқ.
Dialogue: 0,0:05:17.91,0:05:21.07,Default,,0000,0000,0000,,Мен жай ғана ренжідім, өйткені бұл кенеттен болды.
Dialogue: 0,0:05:22.21,0:05:24.35,Default,,0000,0000,0000,,Мен де Кайто-кун туралы ойлаймын.
Dialogue: 0,0:05:25.39,0:05:26.20,Default,,0000,0000,0000,,Шынайы ма?
Dialogue: 0,0:05:27.67,0:05:28.74,Default,,0000,0000,0000,,Шынайы ма?
Dialogue: 0,0:05:31.19,0:05:32.50,Default,,0000,0000,0000,,Менде екі сезім де бар.
Dialogue: 0,0:05:33.23,0:05:34.66,Default,,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:05:34.93,0:05:37.02,Default,,0000,0000,0000,,Менің ондай хоббиім жоқ.
Dialogue: 0,0:05:42.41,0:05:44.11,Default,,0000,0000,0000,,Бұл менің реакциям.
Dialogue: 0,0:05:44.46,0:05:45.00,Default,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:05:45.58,0:05:46.45,Default,,0000,0000,0000,,Түскі ас қорабы
Dialogue: 0,0:05:46.67,0:05:49.39,Default,,0000,0000,0000,,Ичика-сенпай біраз бұрын менен сұрады.
Dialogue: 0,0:05:49.97,0:05:51.77,Default,,0000,0000,0000,,Оны теңізге бер
Dialogue: 0,0:05:52.33,0:05:53.19,Default,,0000,0000,0000,,Менің ағам
Dialogue: 0,0:05:53.82,0:05:55.40,Default,,0000,0000,0000,,Сіз маған оны жасау үшін қиындықты көтердіңіз.
Dialogue: 0,0:05:55.60,0:05:56.69,Default,,0000,0000,0000,,Ұмытпаңыз
Dialogue: 0,0:06:00.17,0:06:02.19,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:06:05.62,0:06:07.38,Default,,0000,0000,0000,,Аноса Тецуро
Dialogue: 0,0:06:08.66,0:06:10.61,Default,,0000,0000,0000,,Бұл жай ғана мысал.
Dialogue: 0,0:06:11.51,0:06:14.82,Default,,0000,0000,0000,,А бала В қызына кінәсін мойындау сияқты бірдеңе жасады.
Dialogue: 0,0:06:15.80,0:06:18.93,Default,,0000,0000,0000,,Бірден Б-чан үндеместен үйіне кетті.
Dialogue: 0,0:06:19.57,0:06:22.94,Default,,0000,0000,0000,,Содан бастап Б-чанның А-балаға деген көзқарасы болды
Dialogue: 0,0:06:23.09,0:06:24.32,Default,,0000,0000,0000,,Әйтеуір ыңғайсыз
Dialogue: 0,0:06:25.23,0:06:27.39,Default,,0000,0000,0000,,Б-чанның психологиялық жағдайы туралы жауап беріңіз.
Dialogue: 0,0:06:29.35,0:06:30.44,Default,,0000,0000,0000,,Қиындыққа тап болма
Dialogue: 0,0:06:31.56,0:06:32.49,Default,,0000,0000,0000,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:06:33.74,0:06:37.23,Default,,0000,0000,0000,,А-чан Б-кунға мойындау сияқты бірдеңе жасады.
Dialogue: 0,0:06:37.33,0:06:40.62,Default,,0000,0000,0000,,Мен таң қалғаным сонша, оқиға орнынан қашып кеттім.
Dialogue: 0,0:06:41.24,0:06:42.22,Default,,0000,0000,0000,,Сұрақ осында
Dialogue: 0,0:06:42.49,0:06:44.85,Default,,0000,0000,0000,,Ами-чан қандай көзқараста болуы керек?
Dialogue: 0,0:06:45.14,0:06:46.70,Default,,0000,0000,0000,,Сіз жауап беруіңіз керек.
Dialogue: 0,0:06:48.17,0:06:49.51,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:06:49.96,0:06:54.43,Default,,0000,0000,0000,,Айтпақшы, А-чан Б-кун туралы не ойлайды?
Dialogue: 0,0:06:55.08,0:06:57.69,Default,,0000,0000,0000,,Мен сені мүлдем жек көрмеймін.
Dialogue: 0,0:06:58.44,0:07:00.60,Default,,0000,0000,0000,,Ол тіпті сүйкімді деп ойлайтын сияқты.
Dialogue: 0,0:07:01.30,0:07:02.90,Default,,0000,0000,0000,,Егер Жарайды
Dialogue: 0,0:07:03.48,0:07:06.57,Default,,0000,0000,0000,,Мәселе соншалықты қарапайым емес
Dialogue: 0,0:07:06.84,0:07:07.69,Default,,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:07:08.69,0:07:09.45,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:07:10.32,0:07:11.41,Default,,0000,0000,0000,,Ами-чан
Dialogue: 0,0:07:16.35,0:07:20.18,Default,,0000,0000,0000,,Өйткені мен бұл қаладан кетемін.
Dialogue: 0,0:07:27.96,0:07:30.17,Default,,0000,0000,0000,,В-чанның қиындығы сөзсіз.
Dialogue: 0,0:07:30.86,0:07:33.55,Default,,0000,0000,0000,,Бірақ бұл сізді тітіркендіреді ме?
Dialogue: 0,0:07:33.93,0:07:36.73,Default,,0000,0000,0000,,Мен жай ғана шатастырғанымды білмеймін.
Dialogue: 0,0:07:37.40,0:07:40.54,Default,,0000,0000,0000,,Менің ойымша, сізге, А мырза, нәтижеге алаңдамағаныңыз дұрыс.
Dialogue: 0,0:07:41.68,0:07:44.06,Default,,0000,0000,0000,,Асықпаңыз
Dialogue: 0,0:07:44.46,0:07:46.05,Default,,0000,0000,0000,,Жалқаулықты тапты
Dialogue: 0,0:07:46.47,0:07:47.70,Default,,0000,0000,0000,,А Танигава
Dialogue: 0,0:07:47.87,0:07:49.77,Default,,0000,0000,0000,,Не, мен шаршадым.
Dialogue: 0,0:07:50.39,0:07:51.15,Default,,0000,0000,0000,,Аздап
Dialogue: 0,0:07:54.74,0:07:57.99,Default,,0000,0000,0000,,Білесің бе, мен бүгін таңертең естігенімді сағындым.
Dialogue: 0,0:07:58.72,0:08:00.79,Default,,0000,0000,0000,,Кешегі ауытқудан кейін
Dialogue: 0,0:08:02.40,0:08:03.38,Default,,0000,0000,0000,,Сіз не істеп жүрсіз?
Dialogue: 0,0:08:03.65,0:08:06.25,Default,,0000,0000,0000,,А, менің үйге қайтудан басқа амалым қалмады.
Dialogue: 0,0:08:06.43,0:08:07.34,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:08:07.56,0:08:08.37,Default,,0000,0000,0000,,Нашар
Dialogue: 0,0:08:09.35,0:08:10.69,Default,,0000,0000,0000,,Мені іздеді
Dialogue: 0,0:08:12.38,0:08:15.68,Default,,0000,0000,0000,,О, бұл Киришима-кун мен Танигава-сан емес.
Dialogue: 0,0:08:18.32,0:08:20.46,Default,,0000,0000,0000,,Бұл не, Лимон-сенпай?
Dialogue: 0,0:08:21.06,0:08:22.04,Default,,0000,0000,0000,,Сәлемдесу.
Dialogue: 0,0:08:22.69,0:08:25.03,Default,,0000,0000,0000,,Тартымды егде әйел
Dialogue: 0,0:08:25.36,0:08:28.39,Default,,0000,0000,0000,,Ол өзінің сиқырлы купальнигін ашып жатса да
Dialogue: 0,0:08:28.84,0:08:29.97,Default,,0000,0000,0000,,Сиқырлау
Dialogue: 0,0:08:30.26,0:08:32.03,Default,,0000,0000,0000,,Бұл жай ғана мектептегі купальник.
Dialogue: 0,0:08:32.25,0:08:34.76,Default,,0000,0000,0000,,Лимон жинау
Dialogue: 0,0:08:38.13,0:08:40.40,Default,,0000,0000,0000,,Лимонға барайық
Dialogue: 0,0:08:40.89,0:08:41.42,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:43.65,0:08:47.84,Default,,0000,0000,0000,,А-чанның С-чан атты қарсыласы бар сияқты.
Dialogue: 0,0:08:48.04,0:08:49.67,Default,,0000,0000,0000,,Не? Не?
Dialogue: 0,0:08:55.10,0:08:58.87,Default,,0000,0000,0000,,Такизуки-сенпаймен әлі де қиналып жүрген шығарсыз?
Dialogue: 0,0:08:59.76,0:09:01.09,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:09:01.38,0:09:03.59,Default,,0000,0000,0000,,Кайто-кун, сен мықты болуың керек.
Dialogue: 0,0:09:04.26,0:09:07.84,Default,,0000,0000,0000,,Жарайды, Такизуки-сенпай шетелдік екен.
Dialogue: 0,0:09:08.38,0:09:09.70,Default,,0000,0000,0000,,Байланыс және т.б.
Dialogue: 0,0:09:09.83,0:09:12.14,Default,,0000,0000,0000,,Әртүрлі мәселелер болуы мүмкін
Dialogue: 0,0:09:12.86,0:09:16.35,Default,,0000,0000,0000,,Бірақ, менің ағам бұл елге жалғыз келді.
Dialogue: 0,0:09:16.78,0:09:20.32,Default,,0000,0000,0000,,Мүмкін сіз өзіңізді мазасыз немесе жалғыз сезінетін шығарсыз.
Dialogue: 0,0:09:21.25,0:09:24.17,Default,,0000,0000,0000,,Маған Кайто мұны істеу үшін керек.
Dialogue: 0,0:09:25.66,0:09:27.43,Default,,0000,0000,0000,,Ах, дұрыс.
Dialogue: 0,0:09:27.71,0:09:30.32,Default,,0000,0000,0000,,Иә, менің ойымша, Танигава дұрыс.
Dialogue: 0,0:09:31.06,0:09:33.62,Default,,0000,0000,0000,,Мен өзімді ғана ойладым
Dialogue: 0,0:09:34.44,0:09:36.03,Default,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:09:36.45,0:09:41.30,Default,,0000,0000,0000,,Бірақ Кайтоның басқа адам туралы дұрыс ойлағаны жақсы деп ойлаймын.
Dialogue: 0,0:09:42.17,0:09:42.82,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:09:43.46,0:09:44.25,Default,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:09:45.05,0:09:45.58,Default,,0000,0000,0000,,О
Dialogue: 0,0:09:47.12,0:09:50.81,Default,,0000,0000,0000,,Уау, С-чан, сен миналарға баса бересің.
Dialogue: 0,0:09:51.28,0:09:52.47,Default,,0000,0000,0000,,...
Dialogue: 0,0:10:01.11,0:10:04.41,Default,,0000,0000,0000,,Мықты болуы керек
Dialogue: 0,0:10:10.15,0:10:11.24,Default,,0000,0000,0000,,Ичика Сенпай
Dialogue: 0,0:10:11.31,0:10:13.27,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:10:13.65,0:10:14.96,Default,,0000,0000,0000,,Бұл кеше болды.
Dialogue: 0,0:10:15.56,0:10:18.19,Default,,0000,0000,0000,,Біртүрлі қылығым үшін кешірім сұраймын.
Dialogue: 0,0:10:18.42,0:10:20.69,Default,,0000,0000,0000,,Бірақ бұл менің айтқым келгенім емес.
Dialogue: 0,0:10:20.96,0:10:21.98,Default,,0000,0000,0000,,Бірлесіп әрекет етіп жатыр ма?
Dialogue: 0,0:10:22.51,0:10:24.12,Default,,0000,0000,0000,,Олай ма еді?
Dialogue: 0,0:10:24.65,0:10:26.95,Default,,0000,0000,0000,,Ендеше әдеттегідей барайық.
Dialogue: 0,0:10:27.33,0:10:29.15,Default,,0000,0000,0000,,Әдеттегідей орындаңыз
Dialogue: 0,0:10:29.86,0:10:31.62,Default,,0000,0000,0000,,Жарайды, осы.
Dialogue: 0,0:10:32.27,0:10:34.36,Default,,0000,0000,0000,,Осы үлгімен статус-кводы бұзыңыз
Dialogue: 0,0:10:35.01,0:10:37.75,Default,,0000,0000,0000,,Мен мұны істей аламын, мен мұны істеуім керек.
Dialogue: 0,0:10:37.98,0:10:38.87,Default,,0000,0000,0000,,Мен мұны істегім келеді
Dialogue: 0,0:10:38.98,0:10:40.67,Default,,0000,0000,0000,,Сіз соншалықты ұстайсыз ба?
Dialogue: 0,0:10:40.82,0:10:42.23,Default,,0000,0000,0000,,Иә, солай.
Dialogue: 0,0:10:42.68,0:10:46.26,Default,,0000,0000,0000,,Сонымен, Манами-сан?
Dialogue: 0,0:10:46.66,0:10:49.49,Default,,0000,0000,0000,,Олай болса, мен оны сен үшін шешемін.
Dialogue: 0,0:10:50.02,0:10:50.94,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:10:51.50,0:10:53.30,Default,,0000,0000,0000,,...
Dialogue: 0,0:10:55.40,0:10:56.17,Default,,0000,0000,0000,,Мен оны түсінбеймін
Dialogue: 0,0:10:56.64,0:10:58.25,Default,,0000,0000,0000,,Тек адал болыңыз
Dialogue: 0,0:10:58.51,0:10:59.43,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:11:00.29,0:11:02.39,Default,,0000,0000,0000,,Уми мен сауданың ортасындамын.
Dialogue: 0,0:11:02.90,0:11:03.72,Default,,0000,0000,0000,,Менімен бірге жүр
Dialogue: 0,0:11:05.77,0:11:07.49,Default,,0000,0000,0000,,Қарсылық жоқ.
Dialogue: 0,0:11:07.76,0:11:08.90,Default,,0000,0000,0000,,Сонымен? Қалаған ауылыңды тамашалай алдың ба?
Dialogue: 0,0:11:11.19,0:11:12.06,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:11:12.77,0:11:15.85,Default,,0000,0000,0000,,Кайто өзін өте бақытты сезінді.
Dialogue: 0,0:11:16.42,0:11:20.23,Default,,0000,0000,0000,,Бірақ біз енді ғана кездестік.
Dialogue: 0,0:11:20.72,0:11:24.20,Default,,0000,0000,0000,,Олай болса, маған жауап беруге уақыт бере аласыз ба?
Dialogue: 0,0:11:24.69,0:11:28.25,Default,,0000,0000,0000,,Мен Кайто-кун туралы мұқият ойланып, тиісті жауап беремін.
Dialogue: 0,0:11:28.81,0:11:31.55,Default,,0000,0000,0000,,Оған дейін әдеттегідей жалғастырайық.
Dialogue: 0,0:11:31.66,0:11:36.32,Default,,0000,0000,0000,,Иә, түсіндім. Мен ағамның айтқанын орындаймын.
Dialogue: 0,0:11:36.74,0:11:39.79,Default,,0000,0000,0000,,Иә, егер осылай сөйлесеңіз
Dialogue: 0,0:11:44.47,0:11:45.87,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:11:47.23,0:11:48.30,Default,,0000,0000,0000,,Сол әйел
Dialogue: 0,0:11:50.89,0:11:52.96,Default,,0000,0000,0000,,Сіз нені білдіреді?
Dialogue: 0,0:11:53.96,0:11:55.54,Default,,0000,0000,0000,,Кеше маған
Dialogue: 0,0:11:55.68,0:11:59.40,Default,,0000,0000,0000,,Дұрыс жауап бермегеніме менің де кінәм бар.
Dialogue: 0,0:12:00.08,0:12:04.56,Default,,0000,0000,0000,,Кеше және бүгін мен басқа әйелмен кездесіп жүрмін.
Dialogue: 0,0:12:05.21,0:12:06.57,Default,,0000,0000,0000,,Сенгісіз
Dialogue: 0,0:12:07.93,0:12:10.60,Default,,0000,0000,0000,,Мен уайымдағаным үшін ақымақ сияқты емеспін.
Dialogue: 0,0:12:10.71,0:12:12.58,Default,,0000,0000,0000,,Сіз өзіңіз қалаған нәрсені жасай аласыз.
Dialogue: 0,0:12:19.29,0:12:23.12,Default,,0000,0000,0000,,Ринон, маған рингежбен сусабынмен жууға рұқсат етіңіз
Dialogue: 0,0:12:26.30,0:12:30.27,Default,,0000,0000,0000,,Бүгін жауап бермесең, не болатынын білмеймін.
Dialogue: 0,0:12:36.00,0:12:38.67,Default,,0000,0000,0000,,Ринон Бұл ма?
Dialogue: 0,0:12:39.14,0:12:42.25,Default,,0000,0000,0000,,Өйткені әпкем менен Кайто-кун туралы сұрады.
Dialogue: 0,0:12:42.45,0:12:44.01,Default,,0000,0000,0000,,Себебі мен саған қамқор болуды өтіндім.
Dialogue: 0,0:12:45.79,0:12:47.75,Default,,0000,0000,0000,,Барлығы осы. Бар болғаны.
Dialogue: 0,0:12:57.42,0:12:59.16,Default,,0000,0000,0000,,Мынау да, мынау да
Dialogue: 0,0:12:59.47,0:13:00.50,Default,,0000,0000,0000,,Сіз соншалықты көп сатып аласыз ба?
Dialogue: 0,0:13:01.06,0:13:02.73,Default,,0000,0000,0000,,Бұл ұзақ шайқас
Dialogue: 0,0:13:04.82,0:13:05.98,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:13:08.03,0:13:11.41,Default,,0000,0000,0000,,Енді қайда барамыз?
Dialogue: 0,0:13:11.53,0:13:13.09,Default,,0000,0000,0000,,Сәлем Манами-сан
Dialogue: 0,0:13:13.24,0:13:14.46,Default,,0000,0000,0000,,Мен бақытты болсам да
Dialogue: 0,0:13:14.62,0:13:16.11,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:13:16.40,0:13:18.88,Default,,0000,0000,0000,,Әй, батылдықпен
Dialogue: 0,0:13:28.46,0:13:29.41,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:13:33.45,0:13:35.87,Default,,0000,0000,0000,,Сіз әлі де сондасыз ба?
Dialogue: 0,0:13:37.01,0:13:38.72,Default,,0000,0000,0000,,Мен теңізді көргім келеді
Dialogue: 0,0:13:38.95,0:13:39.88,Default,,0000,0000,0000,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:13:39.97,0:13:41.29,Default,,0000,0000,0000,,Сізге қаншалықты сәйкес келеді?
Dialogue: 0,0:13:41.73,0:13:43.62,Default,,0000,0000,0000,,Иә, қазір тамаша.
Dialogue: 0,0:13:43.73,0:13:45.99,Default,,0000,0000,0000,,Сондықтан оны тез сатып алыңыз.
Dialogue: 0,0:14:15.83,0:14:17.15,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:14:18.62,0:14:19.62,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:14:23.01,0:14:25.93,Default,,0000,0000,0000,,Кайто, мұнда кел.
Dialogue: 0,0:14:26.10,0:14:26.91,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:14:28.16,0:14:29.05,Default,,0000,0000,0000,,Жақсы қыз.
Dialogue: 0,0:14:32.37,0:14:37.56,Default,,0000,0000,0000,,Мен Ичикадан жақсымын деп ойлаймын.
Dialogue: 0,0:14:38.29,0:14:39.27,Default,,0000,0000,0000,,Бірлесіп күресу
Dialogue: 0,0:14:40.01,0:14:45.46,Default,,0000,0000,0000,,Айтсаңыз да жауап бермейтін әйелді ұмытыңыз.
Dialogue: 0,0:14:46.51,0:14:47.05,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:14:51.74,0:14:52.33,Default,,0000,0000,0000,,Ринон
Dialogue: 0,0:14:55.47,0:14:57.31,Default,,0000,0000,0000,,Мен душқа түсемін.
Dialogue: 0,0:14:57.69,0:14:59.34,Default,,0000,0000,0000,,Рұқсатсыз шай ішу
Dialogue: 0,0:14:59.50,0:15:00.45,Default,,0000,0000,0000,,Хи хи
Dialogue: 0,0:15:00.99,0:15:04.37,Default,,0000,0000,0000,,Теңізге бірге кіріңіз
Dialogue: 0,0:15:05.85,0:15:07.69,Default,,0000,0000,0000,,Шын жүректен кешірім сұраймыз.
Dialogue: 0,0:15:07.78,0:15:09.37,Default,,0000,0000,0000,,Бұл сүйкімді емес.
Dialogue: 0,0:15:11.19,0:15:12.62,Default,,0000,0000,0000,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:15:13.37,0:15:15.43,Default,,0000,0000,0000,,Үйге келгенде ағама айтуым керек.
Dialogue: 0,0:15:15.47,0:15:16.07,Default,,0000,0000,0000,,Не
Dialogue: 0,0:15:19.83,0:15:21.49,Default,,0000,0000,0000,,Сенпай
Dialogue: 0,0:15:22.26,0:15:23.20,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:15:23.78,0:15:25.65,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:15:25.81,0:15:26.78,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:15:26.79,0:15:28.05,Default,,0000,0000,0000,,Мен үйге бара жатырмын
Dialogue: 0,0:15:28.25,0:15:28.75,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:15:28.92,0:15:30.04,Default,,0000,0000,0000,,Жарайды, үйге қайтайық.
Dialogue: 0,0:15:30.33,0:15:32.71,Default,,0000,0000,0000,,Сәл күте тұрыңыз.
Dialogue: 0,0:15:33.71,0:15:35.07,Default,,0000,0000,0000,,Мен осында болғым келеді
Dialogue: 0,0:15:35.34,0:15:38.19,Default,,0000,0000,0000,,Бірақ сәлемдесуге келетін болсақ.
Dialogue: 0,0:15:39.22,0:15:40.09,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:15:41.35,0:15:42.18,Default,,0000,0000,0000,,Иә…♡
Dialogue: 0,0:15:45.30,0:15:48.24,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:15:48.86,0:15:52.34,Default,,0000,0000,0000,,Мен неге мұндаймын?
Dialogue: 0,0:15:52.96,0:15:56.55,Default,,0000,0000,0000,,Ым, Сенпай, мен бір нәрсені дұрыс түсінбедім.
Dialogue: 0,0:15:56.63,0:15:57.86,Default,,0000,0000,0000,,Сіз не деп әбігерленесіз?
Dialogue: 0,0:15:58.91,0:16:00.13,Default,,0000,0000,0000,,Бұл бала кім?
Dialogue: 0,0:16:00.24,0:16:02.09,Default,,0000,0000,0000,,Мүмкін теңіз
Dialogue: 0,0:16:02.14,0:16:02.90,Default,,0000,0000,0000,,Жоқ (жоқ)
Dialogue: 0,0:16:03.23,0:16:04.14,Default,,0000,0000,0000,,Сонда ше?
Dialogue: 0,0:16:04.26,0:16:09.16,Default,,0000,0000,0000,,Менің әпкем Кайтоға қамқорлық жасауымды өтінді.
Dialogue: 0,0:16:09.44,0:16:10.43,Default,,0000,0000,0000,,Нанамиден
Dialogue: 0,0:16:10.82,0:16:13.06,Default,,0000,0000,0000,,Иә, солай
Dialogue: 0,0:16:13.19,0:16:15.53,Default,,0000,0000,0000,,Мен Кайтоның осында қалуына жол бере алмаймын.
Dialogue: 0,0:16:15.95,0:16:16.82,Default,,0000,0000,0000,,Сенпай, бұл
Dialogue: 0,0:16:16.88,0:16:17.89,Default,,0000,0000,0000,,Кайто-кун, үндеме.
Dialogue: 0,0:16:17.98,0:16:18.44,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:16:19.54,0:16:21.96,Default,,0000,0000,0000,,Иә, жақсы. Махаббат тегін.
Dialogue: 0,0:16:22.43,0:16:24.41,Default,,0000,0000,0000,,Ол менен әлдеқайда үлкен көрінеді.
Dialogue: 0,0:16:24.77,0:16:26.64,Default,,0000,0000,0000,,Жас айырмашылығы маңызды емес.
Dialogue: 0,0:16:27.02,0:16:28.65,Default,,0000,0000,0000,,Кайто – орта мектеп оқушысы.
Dialogue: 0,0:16:29.29,0:16:31.03,Default,,0000,0000,0000,,Махаббат әрқашан кедергілермен келеді
Dialogue: 0,0:16:31.17,0:16:32.72,Default,,0000,0000,0000,,Манами-сан, сен не айтып тұрсың?
Dialogue: 0,0:16:32.77,0:16:34.11,Default,,0000,0000,0000,,Кайто-кун, үндеме.
Dialogue: 0,0:16:34.28,0:16:34.91,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:16:35.17,0:16:36.33,Default,,0000,0000,0000,,Менің жеңуімнің себебі…
Dialogue: 0,0:16:36.55,0:16:37.45,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:16:37.82,0:16:39.03,Default,,0000,0000,0000,,Сіз мені мазалап жүрсіз бе?
Dialogue: 0,0:16:40.50,0:16:43.02,Default,,0000,0000,0000,,Мен Кайто-кунды қорғауға міндеттімін.
Dialogue: 0,0:16:43.17,0:16:44.19,Default,,0000,0000,0000,,Барлығы осы
Dialogue: 0,0:16:45.47,0:16:50.30,Default,,0000,0000,0000,,Сондықтан мен басқалардың үйіне сұрамай кірдім.
Dialogue: 0,0:16:51.21,0:16:52.46,Default,,0000,0000,0000,,Сіз бара аласыз ба?
Dialogue: 0,0:16:52.90,0:16:54.04,Default,,0000,0000,0000,,Бұл ақылсыз.
Dialogue: 0,0:16:56.71,0:16:58.47,Default,,0000,0000,0000,,Егер сіз өз сезіміңізді мойындасаңыз
Dialogue: 0,0:16:58.94,0:17:00.90,Default,,0000,0000,0000,,Сенің мұнда келу себебің
Dialogue: 0,0:17:01.32,0:17:02.53,Default,,0000,0000,0000,,Ондай нәрсе жоқ.
Dialogue: 0,0:17:02.78,0:17:03.67,Default,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:17:03.86,0:17:04.74,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:17:05.71,0:17:08.48,Default,,0000,0000,0000,,Уми Бұл бала өте баяу.
Dialogue: 0,0:17:09.14,0:17:09.95,Default,,0000,0000,0000,,Не
Dialogue: 0,0:17:10.15,0:17:11.28,Default,,0000,0000,0000,,Абдол мырза
Dialogue: 0,0:17:12.15,0:17:14.16,Default,,0000,0000,0000,,А, сен қалағаныңды істей аласың.
Dialogue: 0,0:17:14.56,0:17:16.74,Default,,0000,0000,0000,,Бұл да қызықты уақыт болса керек.
Dialogue: 0,0:17:17.32,0:17:20.91,Default,,0000,0000,0000,,Әпке, бұл не? Тағы келдің бе?
Dialogue: 0,0:17:21.24,0:17:22.85,Default,,0000,0000,0000,,Үлкен апа
Dialogue: 0,0:17:22.98,0:17:25.85,Default,,0000,0000,0000,,Бұл Уми, Ичика-сенпайға дейін.
Dialogue: 0,0:17:26.43,0:17:27.90,Default,,0000,0000,0000,,Мені осында әпкем алып келді.
Dialogue: 0,0:17:28.08,0:17:29.84,Default,,0000,0000,0000,,Міне, бұл туралы.
Dialogue: 0,0:17:29.97,0:17:32.33,Default,,0000,0000,0000,,Ал, жеңіл жүріңіз.
Dialogue: 0,0:17:32.89,0:17:34.72,Default,,0000,0000,0000,,Жарайды, сен олай киінбейсің.
Dialogue: 0,0:17:35.16,0:17:36.35,Default,,0000,0000,0000,,Киіміңді ауыстыр.
Dialogue: 0,0:17:36.43,0:17:38.15,Default,,0000,0000,0000,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:17:39.29,0:17:42.81,Default,,0000,0000,0000,,Исигаки мырза, әлгі үлкен апа?
Dialogue: 0,0:17:43.10,0:17:44.83,Default,,0000,0000,0000,,Сіз оны әлі таныстырдыңыз ба?
Dialogue: 0,0:17:45.21,0:17:47.55,Default,,0000,0000,0000,,Бұл менің әпкем Манами Огура.
Dialogue: 0,0:17:48.15,0:17:49.93,Default,,0000,0000,0000,,Огура тегі
Dialogue: 0,0:17:50.16,0:17:51.31,Default,,0000,0000,0000,,Өйткені мен үйленгенмін
Dialogue: 0,0:17:51.65,0:17:54.57,Default,,0000,0000,0000,,Дұрысы, апа, мен күйеуіммен ұрысып қалған сайын,
Dialogue: 0,0:17:54.65,0:17:57.10,Default,,0000,0000,0000,,Мен осында келемін, мен ауырып қаламын.
Dialogue: 0,0:17:58.04,0:17:59.96,Default,,0000,0000,0000,,Мен сені бұл жолы кешірмеймін.
Dialogue: 0,0:18:00.42,0:18:01.45,Default,,0000,0000,0000,,Жанжалдың себебі
Dialogue: 0,0:18:01.65,0:18:05.73,Default,,0000,0000,0000,,Ол адам мен жазған бағдарламаны рұқсатсыз өшіріп тастады.
Dialogue: 0,0:18:05.81,0:18:06.53,Default,,0000,0000,0000,,Уау, бұл сұмдық.
Dialogue: 0,0:18:06.68,0:18:08.02,Default,,0000,0000,0000,,Мен оны асыға күттім.
Dialogue: 0,0:18:08.07,0:18:10.12,Default,,0000,0000,0000,,Жарайды, Сатоши-санға оралыңыз.
Dialogue: 0,0:18:10.21,0:18:11.74,Default,,0000,0000,0000,,Мен сені жерге тізерлеп отырсаң да кешірмеймін
Dialogue: 0,0:18:11.85,0:18:12.46,Default,,0000,0000,0000,,Мені кешіріңіз
Dialogue: 0,0:18:12.52,0:18:15.40,Default,,0000,0000,0000,,Бұл жолы махаббатым таусылды.
Dialogue: 0,0:18:15.53,0:18:16.13,Default,,0000,0000,0000,,Таусылмаңыз
Dialogue: 0,0:18:16.20,0:18:17.75,Default,,0000,0000,0000,,Сізде қандай көзқарас бар?
Dialogue: 0,0:18:17.82,0:18:18.63,Default,,0000,0000,0000,,Бұл әділдік.
Dialogue: 0,0:18:20.65,0:18:23.53,Default,,0000,0000,0000,,Кешіріңіз, шынымен кешіріңіз
Dialogue: 0,0:18:23.82,0:18:25.64,Default,,0000,0000,0000,,Айя, жарайды.
Dialogue: 0,0:18:26.31,0:18:29.25,Default,,0000,0000,0000,,Негізі, сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:18:29.78,0:18:31.83,Default,,0000,0000,0000,,Бұл толығымен менің кінәм.
Dialogue: 0,0:18:32.06,0:18:36.16,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес, өйткені Манами-сан адастыратын нәрселерді айтады.
Dialogue: 0,0:18:36.73,0:18:37.72,Default,,0000,0000,0000,,Енді барайық
Dialogue: 0,0:18:41.93,0:18:44.47,Default,,0000,0000,0000,,Эй Кайто-кун, кешірім сұрауыма рұқсат ет.
Dialogue: 0,0:18:45.09,0:18:46.13,Default,,0000,0000,0000,,Мен бәрін істеймін
Dialogue: 0,0:18:46.42,0:18:47.05,Default,,0000,0000,0000,,Кез келген нәрсе
Dialogue: 0,0:18:47.30,0:18:48.85,Default,,0000,0000,0000,,Иә, кез келген нәрсе.
Dialogue: 0,0:18:49.77,0:18:52.13,Default,,0000,0000,0000,,Сол кезде И
Dialogue: 0,0:18:53.84,0:18:56.01,Default,,0000,0000,0000,,Мен шынымен де сұрағым келді.
Dialogue: 0,0:18:57.07,0:18:58.21,Default,,0000,0000,0000,,Кешегі жауап
Dialogue: 0,0:18:59.10,0:19:01.95,Default,,0000,0000,0000,,Мен туралы не ойлайсың?
Dialogue: 0,0:19:02.84,0:19:03.35,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:19:04.34,0:19:06.97,Default,,0000,0000,0000,,Мен оқуда жақсы емеспін.
Dialogue: 0,0:19:07.56,0:19:10.35,Default,,0000,0000,0000,,Сенпай, айта аласың ба?
Dialogue: 0,0:19:15.99,0:19:18.08,Default,,0000,0000,0000,,Иә, мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:19:20.64,0:19:22.54,Default,,0000,0000,0000,,Бұл қате жазылған.
Dialogue: 0,0:19:22.87,0:19:24.65,Default,,0000,0000,0000,,Бұл «Е» емес, «Мен»
Dialogue: 0,0:19:24.99,0:19:25.85,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:19:26.25,0:19:28.55,Default,,0000,0000,0000,,Ағылшын тілінен кейін келесі орында математика.
Dialogue: 0,0:19:29.00,0:19:33.29,Default,,0000,0000,0000,,Сенпай, неге ұйықтамайсың? Ертең сенің де сабағың бар.
Dialogue: 0,0:19:33.41,0:19:35.61,Default,,0000,0000,0000,,Менің қорытынды емтиханға дейін уақытым жоқ.
Dialogue: 0,0:19:36.41,0:19:37.39,Default,,0000,0000,0000,,Осындай академиялық қабілеті бар
Dialogue: 0,0:19:37.48,0:19:39.40,Default,,0000,0000,0000,,Менің әпкем де уайымдап тұр.
Dialogue: 0,0:19:39.73,0:19:42.11,Default,,0000,0000,0000,,Кем дегенде орташа немесе одан жоғары балл алуды мақсат етіңіз
Dialogue: 0,0:19:42.25,0:19:44.25,Default,,0000,0000,0000,,Оның қызыл нүкте болуы міндетті емес.
Dialogue: 0,0:19:44.65,0:19:46.59,Default,,0000,0000,0000,,Мұндай көзқарас жақсы емес.
Dialogue: 0,0:19:47.35,0:19:50.25,Default,,0000,0000,0000,,Оны оқып, үйретуіңді сұраған Кайтокун болса керек.
Dialogue: 0,0:19:51.01,0:19:51.58,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:51.76,0:19:53.08,Default,,0000,0000,0000,,Иә, есепті шеш.
Dialogue: 0,0:19:54.06,0:19:54.77,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:55.68,0:19:57.17,Default,,0000,0000,0000,,Мен бұлай айтпауым керек еді.
Dialogue: 0,0:19:59.20,0:20:01.76,Default,,0000,0000,0000,,Эй Уми, жақсысың ба?
Dialogue: 0,0:20:02.32,0:20:03.12,Default,,0000,0000,0000,,Pi
Dialogue: 0,0:20:03.37,0:20:04.62,Default,,0000,0000,0000,,А кеуде
Dialogue: 0,0:20:04.93,0:20:09.25,Default,,0000,0000,0000,,Мен ағамның мінезі ондай деп ойламаппын.
Dialogue: 0,0:20:09.74,0:20:12.21,Default,,0000,0000,0000,,Кайто-кун, мен оқимын.
Dialogue: 0,0:20:12.55,0:20:13.77,Default,,0000,0000,0000,,Такизуки Сенпай
Dialogue: 0,0:20:13.97,0:20:16.76,Default,,0000,0000,0000,,Сенпай, қазір түскі үзіліс.
Dialogue: 0,0:20:16.85,0:20:19.40,Default,,0000,0000,0000,,Тамақтану кезінде оқу. Менің уақытым жоқ.
Dialogue: 0,0:20:19.59,0:20:20.76,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:20:23.44,0:20:25.47,Default,,0000,0000,0000,,О, бұл қиын сияқты.
Dialogue: 0,0:20:25.75,0:20:27.16,Default,,0000,0000,0000,,Бірақ бұл жақсы болды.
Dialogue: 0,0:20:27.38,0:20:28.16,Default,,0000,0000,0000,,Не
Dialogue: 0,0:20:28.45,0:20:31.70,Default,,0000,0000,0000,,Кайто-кун мен Такизуки-сенпай енді ыңғайсыз емес.
Dialogue: 0,0:20:32.51,0:20:34.04,Default,,0000,0000,0000,,Иә, жақсы.
Dialogue: 0,0:20:34.80,0:20:36.91,Default,,0000,0000,0000,,С-чан көңілсіз болды
Dialogue: 0,0:20:37.69,0:20:38.70,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:38.94,0:20:41.82,Default,,0000,0000,0000,,Енді қыздардың басына жеңіл тиме.
Dialogue: 0,0:20:41.88,0:20:44.80,Default,,0000,0000,0000,,қыз қыз
Dialogue: 0,0:20:44.84,0:20:47.99,Default,,0000,0000,0000,,Не? Қайта айтып көріңіз.
Dialogue: 0,0:21:37.08,0:21:37.86,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:21:39.20,0:21:40.00,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:21:40.91,0:21:41.49,Default,,0000,0000,0000,,Үйге қайтайық.
Dialogue: 0,0:21:43.32,0:21:46.08,Default,,0000,0000,0000,,Жазғы демалыс басталатын болды
Dialogue: 0,0:21:47.02,0:21:49.49,Default,,0000,0000,0000,,Ешқашан ұмытылмайды
Dialogue: 0,0:21:51.50,0:21:53.61,Default,,0000,0000,0000,,Ұмытылмас жаз
Dialogue: 0,0:21:54.23,0:21:55.33,Default,,0000,0000,0000,,Мен сенімдімін
Dialogue: 0,0:21:56.11,0:21:58.07,Default,,0000,0000,0000,,Менің ойымша, барлығы бірдей болды.
Dialogue: 0,0:21:58.71,0:22:00.96,Default,,0000,0000,0000,,Қуаныш, қайғы, қайғы
Dialogue: 0,0:22:01.92,0:22:04.48,Default,,0000,0000,0000,,Осы заттардың барлығы бірге
Dialogue: 0,0:22:04.99,0:22:06.20,Default,,0000,0000,0000,,Тек бір рет
Dialogue: 0,0:22:07.53,0:22:09.52,Default,,0000,0000,0000,,Сол жаз басталады
Dialogue: 0,0:23:41.12,0:23:42.43,Default,,0000,0000,0000,,Ичика-сенпайдың шынайы тұлғасы
Dialogue: 0,0:23:42.54,0:23:43.50,Default,,0000,0000,0000,,Бас тарту
Dialogue: 0,0:23:43.55,0:23:45.44,Default,,0000,0000,0000,,Маған басқаша айтпа
Dialogue: 0,0:23:46.35,0:23:49.74,Default,,0000,0000,0000,,Тецуро-кун қайтыс болды.
Dialogue: 0,0:12:51.92,0:12:55.02,Default,,0000,0000,0000,,Білім беру артықшылықтары
Dialogue: 0,0:21:32.74,0:21:35.39,Default,,0000,0000,0000,,Қорытынды рәсім (Жапониядағы әр семестр үшін толық рәсім)
Dialogue: 0,0:06:13.55,0:06:18.75,Default,,0000,0000,0000,,Мен бақыттымын!
Dialogue: 0,0:20:03.37,0:20:04.62,Default,,0000,0000,0000,,Жапон тіліндегі «кеуденің» жарты бөлігінің қосындысынан кейін гомолог
Dialogue: 0,0:00:39.82,0:00:43.02,Default,,0000,0000,0000,,Теңіз самалы жүзіңнен соғады
Dialogue: 0,0:00:43.79,0:00:46.91,Default,,0000,0000,0000,,Сіз үндемейсіз
Dialogue: 0,0:00:47.60,0:00:51.59,Default,,0000,0000,0000,,Іс жүзінде бұл профиль
Dialogue: 0,0:00:52.31,0:00:55.22,Default,,0000,0000,0000,,Мен оған қол тигізгім келеді
Dialogue: 0,0:00:55.33,0:00:58.62,Default,,0000,0000,0000,,Мен сені сүйіп тұрғандай болдым
Dialogue: 0,0:00:59.47,0:01:02.64,Default,,0000,0000,0000,,Бұл түсінде болды
Dialogue: 0,0:01:03.09,0:01:09.76,Default,,0000,0000,0000,,Жел шындықтың шекарасына тиеді
Dialogue: 0,0:01:11.65,0:01:18.23,Default,,0000,0000,0000,,Күнделікті өмір кездейсоқ сөздермен жарқырайды
Dialogue: 0,0:01:18.39,0:01:24.53,Default,,0000,0000,0000,,Бір күні көрген кино сияқты.
Dialogue: 0,0:01:25.52,0:01:29.22,Default,,0000,0000,0000,,Жыл мезгілдері келіп-кетсе де
Dialogue: 0,0:01:29.75,0:01:33.49,Default,,0000,0000,0000,,Бізді мәңгі күтеді
Dialogue: 0,0:01:33.57,0:01:40.74,Default,,0000,0000,0000,,Күйген пленка сияқты жаздың иісі
Dialogue: 0,0:01:41.05,0:01:44.97,Default,,0000,0000,0000,,Ұзақ уақытқа созылатын ескерту
Dialogue: 0,0:01:45.20,0:01:49.69,Default,,0000,0000,0000,,Мен қараған объективтен секіру
Dialogue: 0,0:01:50.01,0:01:55.12,Default,,0000,0000,0000,,Мен сенің қолыңнан ұстаймын
Dialogue: 0,0:00:39.82,0:00:43.02,Default,,0000,0000,0000,,Теңіз самалы
Dialogue: 0,0:00:43.76,0:00:46.91,Default,,0000,0000,0000,,Сізде сөз жоқ.
Dialogue: 0,0:00:47.60,0:00:51.59,Default,,0000,0000,0000,,Менің ойымша, дәл осылай.
Dialogue: 0,0:00:52.31,0:00:55.22,Default,,0000,0000,0000,,Үстелдің жағы
Dialogue: 0,0:00:55.33,0:00:58.62,Default,,0000,0000,0000,,...
Dialogue: 0,0:00:59.47,0:01:02.64,Default,,0000,0000,0000,,Түсінде жатқан түсте
Dialogue: 0,0:01:03.09,0:01:09.76,Default,,0000,0000,0000,,Теңіз желінің нақты әлемі
Dialogue: 0,0:01:11.65,0:01:18.23,Default,,0000,0000,0000,,Күтпеген сөз, күтпеген күнделікті өмір
Dialogue: 0,0:01:18.39,0:01:24.53,Default,,0000,0000,0000,,Сурет дегеніміз не?
Dialogue: 0,0:01:25.52,0:01:29.22,Default,,0000,0000,0000,,Өкілді дереу ауыстыру
Dialogue: 0,0:01:29.75,0:01:33.49,Default,,0000,0000,0000,,Біз мәңгі бірге жұмыс істей береміз.
Dialogue: 0,0:01:33.57,0:01:40.74,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:41.05,0:01:44.97,Default,,0000,0000,0000,,Кездесусіз тарайтын толқу сезімі
Dialogue: 0,0:01:45.20,0:01:49.69,Default,,0000,0000,0000,,Мөлдір айна
Dialogue: 0,0:01:50.01,0:01:55.12,Default,,0000,0000,0000,,Гайкай Коукен Сумина Тадате
Dialogue: 0,0:22:25.13,0:22:30.84,Default,,0000,0000,0000,,Саған ғашық болу үшін іздеген себебім
Dialogue: 0,0:22:30.94,0:22:37.90,Default,,0000,0000,0000,,Бұл ең қуанышты сөз деп айтылады.
Dialogue: 0,0:22:40.16,0:22:45.68,Default,,0000,0000,0000,,Мен оны түсінгенде, жіптер дұрыс емес тураланған.
Dialogue: 0,0:22:46.14,0:22:53.54,Default,,0000,0000,0000,,Бір жақты түйін күшейе түсті.
Dialogue: 0,0:22:54.83,0:23:01.42,Default,,0000,0000,0000,,Еш ойланбай, қашып кет
Dialogue: 0,0:23:02.20,0:23:07.24,Default,,0000,0000,0000,,Сіз мәңгілік емессіз
Dialogue: 0,0:23:08.49,0:23:12.43,Default,,0000,0000,0000,,Бұлт пішінін пирсинг
Dialogue: 0,0:23:12.54,0:23:14.94,Default,,0000,0000,0000,,Ойлы серпін фильмі
Dialogue: 0,0:23:15.04,0:23:19.89,Default,,0000,0000,0000,,Ауада жаздың иісі аңқып тұрады
Dialogue: 0,0:23:19.95,0:23:23.46,Default,,0000,0000,0000,,Бұл менің есімде талай рет
Dialogue: 0,0:23:23.53,0:23:27.11,Default,,0000,0000,0000,,Тек сен маған берген ғажайып
Dialogue: 0,0:23:27.20,0:23:31.85,Default,,0000,0000,0000,,Душ сияқты түсіп кетіңіз
Dialogue: 0,0:23:31.95,0:23:39.57,Default,,0000,0000,0000,,Ол түсті шығарды.
Dialogue: 0,0:22:25.13,0:22:30.84,Default,,0000,0000,0000,,Адал болу қуанышының себебі
Dialogue: 0,0:22:30.94,0:22:37.90,Default,,0000,0000,0000,,Бұл сіздің ең ашық әңгімеңіз.
Dialogue: 0,0:22:40.16,0:22:45.68,Default,,0000,0000,0000,,Ниет жеткенде кенет қызыл сызық ашылады.
Dialogue: 0,0:22:46.14,0:22:53.54,Default,,0000,0000,0000,,...
Dialogue: 0,0:22:54.83,0:23:01.42,Default,,0000,0000,0000,,Оны оқудың қажеті жоқ.
Dialogue: 0,0:23:02.20,0:23:07.24,Default,,0000,0000,0000,,...
