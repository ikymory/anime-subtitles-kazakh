Dialogue: 0,0:02:24.00,0:02:33.94,Default,,0000,0000,0000,,Бұл субтитр көзі коммерциялық пайдалануға тыйым салынған субтитрлер тобының өндірісі, жеткізу алмасуы болып табылады.
Dialogue: 0,0:02:24.00,0:02:33.94,Default,,0000,0000,0000,,: ： яя : Сюра :
Dialogue: 0,0:00:01.61,0:00:05.29,Default,,0000,0000,0000,,Сол кезде екеуің қандай едіңдер?
Dialogue: 0,0:00:05.94,0:00:07.66,Default,,0000,0000,0000,,Сіз не туралы айттыңыз?
Dialogue: 0,0:00:08.57,0:00:11.33,Default,,0000,0000,0000,,Мен мүлде түсінбедім
Dialogue: 0,0:00:13.14,0:00:14.44,Default,,0000,0000,0000,,Тіпті менің сезімдерім
Dialogue: 0,0:00:15.73,0:00:17.07,Default,,0000,0000,0000,,Мен түсінбедім
Dialogue: 0,0:00:17.74,0:00:19.88,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:00:21.39,0:00:23.10,Default,,0000,0000,0000,,А, солай.
Dialogue: 0,0:00:23.43,0:00:25.40,Default,,0000,0000,0000,,Сенпай, міне, осы.
Dialogue: 0,0:00:25.72,0:00:27.28,Default,,0000,0000,0000,,I
Dialogue: 0,0:00:27.68,0:00:28.90,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:00:29.52,0:00:30.37,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:00:31.71,0:00:35.93,Default,,0000,0000,0000,,Бірақ мен оны көргенді жек көремін.
Dialogue: 0,0:00:37.75,0:00:39.69,Default,,0000,0000,0000,,Такизуки Сенпай
Dialogue: 0,0:00:40.26,0:00:41.77,Default,,0000,0000,0000,,Сол кезде И
Dialogue: 0,0:00:45.35,0:00:47.69,Default,,0000,0000,0000,,Сезімдеріңмен бетпе-бет келу
Dialogue: 0,0:00:52.61,0:00:53.70,Default,,0000,0000,0000,,Мен қорықтым.
Dialogue: 0,0:02:38.76,0:02:40.15,Default,,0000,0000,0000,,Тецуро мырза
Dialogue: 0,0:02:44.06,0:02:47.19,Default,,0000,0000,0000,,Мен ұялшақ адаммын.
Dialogue: 0,0:02:47.64,0:02:51.03,Default,,0000,0000,0000,,Дәлірек айтсақ, бұл менмін.
Dialogue: 0,0:03:02.03,0:03:04.81,Default,,0000,0000,0000,,Осы уақытқа дейін келген болсаң, жақсы болады.
Dialogue: 0,0:03:05.63,0:03:07.82,Default,,0000,0000,0000,,Ал, бұл бала тым итермелейді.
Dialogue: 0,0:03:07.89,0:03:08.99,Default,,0000,0000,0000,,Айтпа
Dialogue: 0,0:03:10.18,0:03:11.07,Default,,0000,0000,0000,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:03:11.57,0:03:12.61,Default,,0000,0000,0000,,Кез келген адамға
Dialogue: 0,0:03:13.88,0:03:14.95,Default,,0000,0000,0000,,Айтпа
Dialogue: 0,0:03:17.61,0:03:19.77,Default,,0000,0000,0000,,Сталкер мырза, келіңізші.
Dialogue: 0,0:03:21.34,0:03:21.86,Default,,0000,0000,0000,,Тецуро
Dialogue: 0,0:03:21.96,0:03:22.61,Default,,0000,0000,0000,,Енді қайтайық
Dialogue: 0,0:03:23.53,0:03:24.47,Default,,0000,0000,0000,,Мен асығуым керек
Dialogue: 0,0:03:25.61,0:03:27.45,Default,,0000,0000,0000,,Лимон-сенпай маған ұрысады
Dialogue: 0,0:03:32.10,0:03:32.92,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:03:33.49,0:03:37.06,Default,,0000,0000,0000,,Мен өз бөлмеме қайтып барамын.
Dialogue: 0,0:03:37.94,0:03:41.40,Default,,0000,0000,0000,,А, мен түсіндім. Содан кейін мен бірінші қайтамын.
Dialogue: 0,0:03:46.32,0:03:47.78,Default,,0000,0000,0000,,Мен қайтып келдім
Dialogue: 0,0:03:48.01,0:03:49.05,Default,,0000,0000,0000,,Бұл жаман.
Dialogue: 0,0:03:49.37,0:03:51.76,Default,,0000,0000,0000,,Екеуің бірге не істедіңдер?
Dialogue: 0,0:03:52.53,0:03:53.23,Default,,0000,0000,0000,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:03:53.28,0:03:55.39,Default,,0000,0000,0000,,Ол маған актерлік өнерді үйретті.
Dialogue: 0,0:03:56.21,0:03:58.07,Default,,0000,0000,0000,,Өйткені Уми-чан перфекционист
Dialogue: 0,0:03:58.64,0:03:59.75,Default,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:04:00.41,0:04:04.16,Default,,0000,0000,0000,,Аа, бұл кішкентай ғана нәрсе.
Dialogue: 0,0:04:04.39,0:04:05.73,Default,,0000,0000,0000,,Одан үлкенірек
Dialogue: 0,0:04:05.83,0:04:06.70,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:04:06.95,0:04:08.49,Default,,0000,0000,0000,,Кеш болды.
Dialogue: 0,0:04:09.03,0:04:10.20,Default,,0000,0000,0000,,Кеш болды.
Dialogue: 0,0:04:10.53,0:04:11.79,Default,,0000,0000,0000,,Капитан, 3D маневрге көшейік
Dialogue: 0,0:04:12.81,0:04:17.14,Default,,0000,0000,0000,,Аа, әсіресе ештеңе жоқ.
Dialogue: 0,0:04:17.98,0:04:20.02,Default,,0000,0000,0000,,А-а, одан да, Ичика-сенпай.
Dialogue: 0,0:04:21.19,0:04:22.68,Default,,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:04:23.72,0:04:25.41,Default,,0000,0000,0000,,Бұл қашан болды?
Dialogue: 0,0:04:26.64,0:04:29.12,Default,,0000,0000,0000,,Мм, Сенпай, дәл қазір.
Dialogue: 0,0:04:29.22,0:04:31.83,Default,,0000,0000,0000,,Түсіру Бастайық
Dialogue: 0,0:04:34.16,0:04:36.32,Default,,0000,0000,0000,,Жақсы бастама
Dialogue: 0,0:04:38.46,0:04:39.90,Default,,0000,0000,0000,,Келіңіздер, ойланыңыздар.
Dialogue: 0,0:04:40.10,0:04:41.69,Default,,0000,0000,0000,,ертегіні тыңдау
Dialogue: 0,0:04:41.89,0:04:43.23,Default,,0000,0000,0000,,Сіз қылмыскерсіз
Dialogue: 0,0:04:43.36,0:04:46.51,Default,,0000,0000,0000,,Киносита кенет жылай бастады.
Dialogue: 0,0:04:47.68,0:04:49.60,Default,,0000,0000,0000,,Менің ағам кенет пайда болды
Dialogue: 0,0:04:50.71,0:04:52.18,Default,,0000,0000,0000,,Ештеңені білмей-ақ
Dialogue: 0,0:04:52.90,0:04:53.92,Default,,0000,0000,0000,,Камераны бұраңыз
Dialogue: 0,0:04:54.72,0:04:55.24,Default,,0000,0000,0000,,НЛО
Dialogue: 0,0:04:55.31,0:04:58.63,Default,,0000,0000,0000,,Бұл ыңғайсыз.
Dialogue: 0,0:04:56.06,0:04:58.25,Default,,0000,0000,0000,,Қайда, қайда, қайдасың?
Dialogue: 0,0:04:58.62,0:04:59.29,Default,,0000,0000,0000,,Әділ
Dialogue: 0,0:05:00.95,0:05:04.93,Default,,0000,0000,0000,,Бәлкім, бұлай тұра алмайтын шығармыз деп ойладым.
Dialogue: 0,0:04:59.86,0:05:04.14,Default,,0000,0000,0000,,қай жерде сол жерде
Dialogue: 0,0:05:05.03,0:05:05.83,Default,,0000,0000,0000,,Алшақтық
Dialogue: 0,0:05:08.41,0:05:09.90,Default,,0000,0000,0000,,Өтінемін, жіберіп алмаңыз
Dialogue: 0,0:05:10.03,0:05:12.29,Default,,0000,0000,0000,,Олай болса менің сұрағыма жауап беріңіз.
Dialogue: 0,0:05:12.51,0:05:15.99,Default,,0000,0000,0000,,Бұл планетаға қалай келдің?
Dialogue: 0,0:05:17.46,0:05:18.30,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:05:18.92,0:05:20.54,Default,,0000,0000,0000,,Ал шынайы мақсат
Dialogue: 0,0:05:24.54,0:05:25.81,Default,,0000,0000,0000,,Маған Уми-чан ұнайды
Dialogue: 0,0:05:26.60,0:05:27.87,Default,,0000,0000,0000,,Сталкер мырза, келіңізші.
Dialogue: 0,0:05:28.72,0:05:29.49,Default,,0000,0000,0000,,Кесу
Dialogue: 0,0:05:30.70,0:05:32.36,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:05:32.44,0:05:33.24,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:05:33.79,0:05:36.84,Default,,0000,0000,0000,,Ағымдағы көрініс Бұрышты өзгертіп, қайта барайық.
Dialogue: 0,0:05:37.44,0:05:38.09,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:38.35,0:05:39.33,Default,,0000,0000,0000,,Танигаваға оралуыңызды өтінемін
Dialogue: 0,0:05:40.42,0:05:41.76,Default,,0000,0000,0000,,Мен сені қорқыттым.
Dialogue: 0,0:05:39.98,0:05:41.24,Default,,0000,0000,0000,,Мио қозғалады.
Dialogue: 0,0:05:41.86,0:05:42.27,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:42.61,0:05:44.60,Default,,0000,0000,0000,,Лимон-сенпайға да көмектесіңізші.
Dialogue: 0,0:05:44.72,0:05:45.67,Default,,0000,0000,0000,,Сіз ше?
Dialogue: 0,0:05:46.00,0:05:49.15,Default,,0000,0000,0000,,Дәл қазір мен кино құдайымен сөйлесіп жатырмын.
Dialogue: 0,0:05:49.82,0:05:50.66,Default,,0000,0000,0000,,Кайто
Dialogue: 0,0:05:53.27,0:05:55.78,Default,,0000,0000,0000,,Күте тұрыңыз, Тецуро-сан.
Dialogue: 0,0:05:54.09,0:05:55.78,Default,,0000,0000,0000,,Сол Чихару
Dialogue: 0,0:05:57.82,0:05:59.61,Default,,0000,0000,0000,,Агрессивті, солай емес пе?
Dialogue: 0,0:05:59.89,0:06:01.77,Default,,0000,0000,0000,,Бұл Арисава мырза ма?
Dialogue: 0,0:06:02.15,0:06:03.51,Default,,0000,0000,0000,,Мына қыз сүйкімді
Dialogue: 0,0:06:03.61,0:06:05.53,Default,,0000,0000,0000,,Тецуро, мен кездессек екен.
Dialogue: 0,0:06:09.72,0:06:13.63,Default,,0000,0000,0000,,Тецуроға олай айтпа.
Dialogue: 0,0:06:14.75,0:06:15.69,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:06:17.13,0:06:18.35,Default,,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:06:19.43,0:06:20.34,Default,,0000,0000,0000,,Китахара мырза
Dialogue: 0,0:06:20.93,0:06:22.72,Default,,0000,0000,0000,,Оның орнына мен саған шағылыстырғыш тақта әкелемін.
Dialogue: 0,0:06:23.12,0:06:25.18,Default,,0000,0000,0000,,Мұнда
Dialogue: 0,0:06:25.31,0:06:27.27,Default,,0000,0000,0000,,Түсіруді жалғастырыңыз
Dialogue: 0,0:06:27.65,0:06:28.75,Default,,0000,0000,0000,,А, жақсы
Dialogue: 0,0:06:29.09,0:06:29.88,Default,,0000,0000,0000,,Уми-чан
Dialogue: 0,0:06:31.60,0:06:32.69,Default,,0000,0000,0000,,Сүйкімді суреттерді түсіріңіз
Dialogue: 0,0:06:33.16,0:06:34.07,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:06:34.43,0:06:36.44,Default,,0000,0000,0000,,Ичика, мен дайынмын.
Dialogue: 0,0:06:37.11,0:06:38.61,Default,,0000,0000,0000,,Иә, бәрібір
Dialogue: 0,0:06:41.22,0:06:42.66,Default,,0000,0000,0000,,Тецуро-кун
Dialogue: 0,0:06:48.15,0:06:49.19,Default,,0000,0000,0000,,Мистер Столкер
Dialogue: 0,0:06:49.32,0:06:50.86,Default,,0000,0000,0000,,Қаншалықты?
Dialogue: 0,0:06:52.57,0:06:55.21,Default,,0000,0000,0000,,Тецуро мырза
Dialogue: 0,0:06:56.77,0:06:59.58,Default,,0000,0000,0000,,Тецуро бұлай қайтып келмейді.
Dialogue: 0,0:06:59.96,0:07:02.95,Default,,0000,0000,0000,,Мио біткен бойда жоғалады.
Dialogue: 0,0:07:03.31,0:07:05.52,Default,,0000,0000,0000,,Такизуки-сенпай да жоқ.
Dialogue: 0,0:07:11.99,0:07:13.97,Default,,0000,0000,0000,,Немесе Кайто-кун осында.
Dialogue: 0,0:07:18.05,0:07:20.31,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:07:21.21,0:07:23.69,Default,,0000,0000,0000,,Бұл жерде жоқ.
Dialogue: 0,0:07:27.07,0:07:28.34,Default,,0000,0000,0000,,Егер сіз Киришима-кун болсаңыз
Dialogue: 0,0:07:28.51,0:07:30.75,Default,,0000,0000,0000,,Мен жай ғана асығыс шықтым.
Dialogue: 0,0:07:31.27,0:07:31.97,Default,,0000,0000,0000,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:07:33.11,0:07:34.68,Default,,0000,0000,0000,,Киношита мырзаның орны.
Dialogue: 0,0:07:36.74,0:07:39.13,Default,,0000,0000,0000,,Кайто-кун, бәрібір, бұл Киносита-сан туралы.
Dialogue: 0,0:07:39.20,0:07:40.87,Default,,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:07:41.74,0:07:43.28,Default,,0000,0000,0000,,Мұны қалай айта аласыз?
Dialogue: 0,0:07:43.65,0:07:45.29,Default,,0000,0000,0000,,Оны көргенде білесің
Dialogue: 0,0:07:45.71,0:07:47.35,Default,,0000,0000,0000,,Киришима-кунның сезімі
Dialogue: 0,0:07:48.84,0:07:49.89,Default,,0000,0000,0000,,Қарап тұрсаңыз
Dialogue: 0,0:07:50.14,0:07:50.66,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:51.40,0:07:55.21,Default,,0000,0000,0000,,Қарсы болмасаңыз, айта аласыз ба?
Dialogue: 0,0:07:55.53,0:07:57.84,Default,,0000,0000,0000,,Бұл сезім?
Dialogue: 0,0:07:58.19,0:08:01.49,Default,,0000,0000,0000,,Иә, жайлап сөйлесейік.
Dialogue: 0,0:08:05.47,0:08:09.32,Default,,0000,0000,0000,,7035 бөлмеден Киносита мырза шығып кетті.
Dialogue: 0,0:08:10.09,0:08:11.24,Default,,0000,0000,0000,,О, солай ма?
Dialogue: 0,0:08:12.03,0:08:13.97,Default,,0000,0000,0000,,Сенің атың Киришима-сама, солай ма?
Dialogue: 0,0:08:15.56,0:08:18.27,Default,,0000,0000,0000,,Бізге Киносита мырзадан хабарлама келді.
Dialogue: 0,0:08:28.81,0:08:29.90,Default,,0000,0000,0000,,Кездесу аяқталғаннан кейін де, үйге келген соң қылмыскерлерді үкім шығарумен қайта айналысамын.
Dialogue: 0,0:08:32.31,0:08:36.76,Default,,0000,0000,0000,,Күте тұрыңыз, Тецуро-сан.
Dialogue: 0,0:08:46.56,0:08:50.16,Default,,0000,0000,0000,,Ал, ол жігіт неше сағат жүгіру керек?
Dialogue: 0,0:08:50.36,0:08:53.19,Default,,0000,0000,0000,,Күте тұрыңыз
Dialogue: 0,0:08:51.25,0:08:52.40,Default,,0000,0000,0000,,Тецуро-кун
Dialogue: 0,0:08:53.66,0:08:54.39,Default,,0000,0000,0000,,Мио
Dialogue: 0,0:08:54.40,0:08:56.17,Default,,0000,0000,0000,,Тецуро-кун
Dialogue: 0,0:08:57.32,0:09:01.29,Default,,0000,0000,0000,,Мен ұялдым, Тецуро-сан, сен қайдасың?
Dialogue: 0,0:09:06.22,0:09:07.48,Default,,0000,0000,0000,,Қайтадан көмектесті
Dialogue: 0,0:09:08.10,0:09:09.38,Default,,0000,0000,0000,,Рахмет, Мио
Dialogue: 0,0:09:09.79,0:09:13.80,Default,,0000,0000,0000,,Үндемегеніңіз үшін рахмет.
Dialogue: 0,0:09:14.22,0:09:17.25,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:09:18.42,0:09:21.05,Default,,0000,0000,0000,,Сен сондай мейірімдісің, Тецуро-кун.
Dialogue: 0,0:09:21.40,0:09:22.43,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:09:22.92,0:09:24.93,Default,,0000,0000,0000,,Тек сүйкімді қыздарға арналған
Dialogue: 0,0:09:26.57,0:09:28.06,Default,,0000,0000,0000,,Жоқ, бұл
Dialogue: 0,0:09:28.14,0:09:29.35,Default,,0000,0000,0000,,Табылды
Dialogue: 0,0:09:29.53,0:09:30.10,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:30.37,0:09:32.76,Default,,0000,0000,0000,,Бұл қорқынышты емес пе, Тецуро-сан?
Dialogue: 0,0:09:32.83,0:09:34.25,Default,,0000,0000,0000,,Жүгіру
Dialogue: 0,0:09:34.42,0:09:36.93,Default,,0000,0000,0000,,Мен де ондай ойынды ұнатпаймын.
Dialogue: 0,0:09:37.01,0:09:39.27,Default,,0000,0000,0000,,Күнді жалғастырып, көңіл көтерейік
Dialogue: 0,0:09:39.72,0:09:41.28,Default,,0000,0000,0000,,Осы уақытқа дейін бұл Тэйт болатын.
Dialogue: 0,0:09:41.43,0:09:43.57,Default,,0000,0000,0000,,Бірлесіп күресу
Dialogue: 0,0:09:46.65,0:09:49.09,Default,,0000,0000,0000,,Жоқ, жоқ
Dialogue: 0,0:09:51.25,0:09:53.54,Default,,0000,0000,0000,,Маған қоңырау шалыңыз, мен кешігіп қаламын.
Dialogue: 0,0:09:54.23,0:09:56.00,Default,,0000,0000,0000,,Ал үнсіз бе?
Dialogue: 0,0:09:56.64,0:09:57.36,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:09:58.04,0:10:00.17,Default,,0000,0000,0000,,Мен нақты ойлай алмаймын
Dialogue: 0,0:10:01.64,0:10:05.02,Default,,0000,0000,0000,,Білесіз бе, мен оны дұрыс естігім келді.
Dialogue: 0,0:10:05.54,0:10:08.93,Default,,0000,0000,0000,,Киносита мырза Кайто мырза туралы айтып отыр.
Dialogue: 0,0:10:09.49,0:10:11.31,Default,,0000,0000,0000,,Қалай
Dialogue: 0,0:10:12.05,0:10:12.87,Default,,0000,0000,0000,,Маған ұнайды
Dialogue: 0,0:10:14.59,0:10:17.10,Default,,0000,0000,0000,,десем не істер едіңіз?
Dialogue: 0,0:10:17.20,0:10:18.79,Default,,0000,0000,0000,,Сіз мені қалжыңдап тұрсыз ба?
Dialogue: 0,0:10:20.08,0:10:21.05,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:10:21.32,0:10:22.69,Default,,0000,0000,0000,,Мен аздап қызғаншақпын
Dialogue: 0,0:10:23.86,0:10:25.25,Default,,0000,0000,0000,,Мені тастап кетті.
Dialogue: 0,0:10:25.60,0:10:26.15,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:10:28.90,0:10:29.40,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:10:30.99,0:10:32.81,Default,,0000,0000,0000,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:10:33.08,0:10:37.13,Default,,0000,0000,0000,,Мен Тецуро-кун мені мазалап жүр деп ойладым.
Dialogue: 0,0:10:37.33,0:10:39.39,Default,,0000,0000,0000,,Бұл неліктен ыңғайсыздық тудырады?
Dialogue: 0,0:10:39.64,0:10:41.12,Default,,0000,0000,0000,,Сәлем Тецуро-сан
Dialogue: 0,0:10:41.41,0:10:42.72,Default,,0000,0000,0000,,Жоқ, солай.
Dialogue: 0,0:10:42.75,0:10:43.72,Default,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:10:44.02,0:10:44.84,Default,,0000,0000,0000,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:10:46.35,0:10:47.40,Default,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:10:47.99,0:10:50.25,Default,,0000,0000,0000,,Сізге Тецуро-сан ұнайтын шығар.
Dialogue: 0,0:10:56.52,0:11:00.59,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:11:03.05,0:11:04.47,Default,,0000,0000,0000,,Бұл күлкілі емес пе?
Dialogue: 0,0:11:04.89,0:11:07.95,Default,,0000,0000,0000,,Сіз сондай экспозицияшылсыз.
Dialogue: 0,0:11:08.45,0:11:09.37,Default,,0000,0000,0000,,Эй, бір минут!
Dialogue: 0,0:11:09.37,0:11:10.61,Default,,0000,0000,0000,,Себебі мен оны көрдім.
Dialogue: 0,0:11:10.66,0:11:12.23,Default,,0000,0000,0000,,Сіз секірген кезде
Dialogue: 0,0:11:12.30,0:11:13.89,Default,,0000,0000,0000,,Мен іш киім киген жоқпын.
Dialogue: 0,0:11:14.15,0:11:15.68,Default,,0000,0000,0000,,Бұл күлкілі, солай емес пе?
Dialogue: 0,0:11:15.78,0:11:16.95,Default,,0000,0000,0000,,Бұл күлкілі.
Dialogue: 0,0:11:17.07,0:11:17.82,Default,,0000,0000,0000,,Мен сенімдімін.
Dialogue: 0,0:11:17.99,0:11:19.51,Default,,0000,0000,0000,,Тіпті іш киімсіз де серуендеу
Dialogue: 0,0:11:19.69,0:11:22.96,Default,,0000,0000,0000,,Ол біреудің бақылап тұрғанын елестетуді ұнататын бұзық болуы керек.
Dialogue: 0,0:11:23.14,0:11:25.47,Default,,0000,0000,0000,,Тецуроға сондай қыз ұнағанына сене алар емеспін.
Dialogue: 0,0:11:25.52,0:11:26.67,Default,,0000,0000,0000,,Жалаңаш тайпа
Dialogue: 0,0:11:30.32,0:11:33.92,Default,,0000,0000,0000,,Біз нудистпіз.
Dialogue: 0,0:11:34.37,0:11:37.88,Default,,0000,0000,0000,,Қоқыс тастау дегенді қалай түсінесіңдер?
Dialogue: 0,0:11:38.25,0:11:39.32,Default,,0000,0000,0000,,Кайто-кунға
Dialogue: 0,0:11:40.66,0:11:42.35,Default,,0000,0000,0000,,Мұндай жерде дүкен ашу—
Dialogue: 0,0:11:43.10,0:11:45.41,Default,,0000,0000,0000,,Токиодағы мектепте оқитын жоғары сынып оқушысына
Dialogue: 0,0:11:46.23,0:11:49.38,Default,,0000,0000,0000,,Мен Окинаваға қайғылы сапармен келдім.
Dialogue: 0,0:11:50.00,0:11:51.47,Default,,0000,0000,0000,,Айттым ғой, мен тек жұмысымды істеп жүрмін...
Dialogue: 0,0:11:52.09,0:11:53.01,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:11:54.08,0:11:56.22,Default,,0000,0000,0000,,Кездейсоқ Уми-чанды тағы кездестірдім.
Dialogue: 0,0:11:57.02,0:12:00.17,Default,,0000,0000,0000,,Жігітім тастап кеткен соң өзімді жалғыз сезіну
Dialogue: 0,0:12:00.24,0:12:01.54,Default,,0000,0000,0000,,Шатастыруға тырысу
Dialogue: 0,0:12:02.88,0:12:06.36,Default,,0000,0000,0000,,Бұл маған көп қиындық тудырды.
Dialogue: 0,0:12:09.27,0:12:10.06,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:12:10.91,0:12:12.45,Default,,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:12:12.64,0:12:14.41,Default,,0000,0000,0000,,Міне, солай.
Dialogue: 0,0:12:16.99,0:12:17.64,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:12:19.38,0:12:21.46,Default,,0000,0000,0000,,Сол кезде неге жыладың?
Dialogue: 0,0:12:23.86,0:12:26.74,Default,,0000,0000,0000,,Жігітім мені тастап кеткенде дәл айтқан сөзім
Dialogue: 0,0:12:27.31,0:12:29.03,Default,,0000,0000,0000,,Мұны маған Уми-чан айтты.
Dialogue: 0,0:12:30.20,0:12:31.78,Default,,0000,0000,0000,,Егер есімде болса
Dialogue: 0,0:12:32.31,0:12:33.96,Default,,0000,0000,0000,,Мен қатты жылай бастадым
Dialogue: 0,0:12:35.49,0:12:38.04,Default,,0000,0000,0000,,Бұл кезде Уми Чанның айтқаны.
Dialogue: 0,0:12:40.76,0:12:42.89,Default,,0000,0000,0000,,Маған ұнайтын адам бар
Dialogue: 0,0:12:43.76,0:12:46.22,Default,,0000,0000,0000,,Бұл сіз екеніңізге сенімдімін.
Dialogue: 0,0:12:47.47,0:12:48.11,Default,,0000,0000,0000,,Не
Dialogue: 0,0:12:48.16,0:12:49.73,Default,,0000,0000,0000,,Уми-чанға қарасаң түсінесің.
Dialogue: 0,0:12:50.77,0:12:52.93,Default,,0000,0000,0000,,Солай бола тұра біз әлі бала кезден доспыз.
Dialogue: 0,0:12:53.71,0:12:56.49,Default,,0000,0000,0000,,Сіз де солай етесіз.
Dialogue: 0,0:12:57.50,0:12:59.47,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:13:01.61,0:13:02.98,Default,,0000,0000,0000,,Сондықтан мен кешірім сұраймын.
Dialogue: 0,0:13:03.20,0:13:05.09,Default,,0000,0000,0000,,Итсукита.
Dialogue: 0,0:13:05.24,0:13:06.43,Default,,0000,0000,0000,,Мен де ертеңгі түсірілімді асыға күтемін.
Dialogue: 0,0:13:09.07,0:13:10.48,Default,,0000,0000,0000,,Кешірім сұрау
Dialogue: 0,0:13:11.13,0:13:12.57,Default,,0000,0000,0000,,Міне, Сенпай.
Dialogue: 0,0:13:14.63,0:13:15.85,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:13:16.23,0:13:19.03,Default,,0000,0000,0000,,Мені ағаштың астына шақырды.
Dialogue: 0,0:13:19.45,0:13:21.99,Default,,0000,0000,0000,,Бірақ неге менің ағам
Dialogue: 0,0:13:24.49,0:13:26.16,Default,,0000,0000,0000,,Ум, Сенпай
Dialogue: 0,0:13:29.84,0:13:30.65,Default,,0000,0000,0000,,Мен бұны білгенмін.
Dialogue: 0,0:13:32.06,0:13:32.88,Default,,0000,0000,0000,,Не
Dialogue: 0,0:13:33.70,0:13:35.81,Default,,0000,0000,0000,,Білгеніңізге сенімдімін
Dialogue: 0,0:13:37.15,0:13:38.84,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:13:39.14,0:13:41.80,Default,,0000,0000,0000,,Маған тезірек айтыңызшы.
Dialogue: 0,0:13:41.90,0:13:43.69,Default,,0000,0000,0000,,Кайтоның сезімі
Dialogue: 0,0:13:44.13,0:13:44.73,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:45.08,0:13:46.82,Default,,0000,0000,0000,,Егер сіз осы костюмді кисеңіз
Dialogue: 0,0:13:46.89,0:13:48.28,Default,,0000,0000,0000,,Мен бұл туралы ойламаймын.
Dialogue: 0,0:13:48.38,0:13:51.57,Default,,0000,0000,0000,,Иә, тағы да?
Dialogue: 0,0:13:53.26,0:13:54.11,Default,,0000,0000,0000,,Жалаңаш тайпа
Dialogue: 0,0:13:54.75,0:13:57.88,Default,,0000,0000,0000,,Нудистер ме?
Dialogue: 0,0:13:58.17,0:14:02.40,Default,,0000,0000,0000,,Үйде жалаңаш және еркіндікте уақыт өткізу.
Dialogue: 0,0:14:03.57,0:14:04.27,Default,,0000,0000,0000,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:14:04.91,0:14:06.01,Default,,0000,0000,0000,,Бұл отбасына да қатысты.
Dialogue: 0,0:14:06.45,0:14:08.67,Default,,0000,0000,0000,,Мен кішкентай кезімнен осындаймын.
Dialogue: 0,0:14:08.85,0:14:10.95,Default,,0000,0000,0000,,Мен мұны үйде істедік деп ойладым.
Dialogue: 0,0:14:11.39,0:14:15.85,Default,,0000,0000,0000,,Бастауыш сыныпқа барған кезде менде басқа нәрсе бар деп ойлай бастадым.
Dialogue: 0,0:14:16.12,0:14:18.11,Default,,0000,0000,0000,,Мен мұны ешкімге айта алмаймын.
Dialogue: 0,0:14:18.57,0:14:20.10,Default,,0000,0000,0000,,Ерм
Dialogue: 0,0:14:20.35,0:14:22.76,Default,,0000,0000,0000,,Іш киім кию қалыпты жағдай
Dialogue: 0,0:14:23.20,0:14:24.05,Default,,0000,0000,0000,,Б-барлаушы? Не туралы айтып тұрсыздар?
Dialogue: 0,0:14:24.35,0:14:26.98,Default,,0000,0000,0000,,Бірақ менің қан қысымым өте төмен.
Dialogue: 0,0:14:27.61,0:14:30.51,Default,,0000,0000,0000,,Кейде таң атқанда есім түсіп, іш киімімді киюді ұмытып қаламын.
Dialogue: 0,0:14:30.63,0:14:32.90,Default,,0000,0000,0000,,Тек мектепке барыңыз.
Dialogue: 0,0:14:33.41,0:14:35.21,Default,,0000,0000,0000,,Мен қатты ұялдым
Dialogue: 0,0:14:35.66,0:14:37.57,Default,,0000,0000,0000,,Мен бұл дұрыс емес деп ойладым.
Dialogue: 0,0:14:37.65,0:14:39.86,Default,,0000,0000,0000,,Мен оны қайта-қайта түзеуге тырыстым, бірақ
Dialogue: 0,0:14:40.01,0:14:41.62,Default,,0000,0000,0000,,Мен мұны кейде жасаймын.
Dialogue: 0,0:14:41.99,0:14:44.51,Default,,0000,0000,0000,,Сосын мен оны елеусіз қалдыруға тырысамын деп ойладым.
Dialogue: 0,0:14:45.09,0:14:46.87,Default,,0000,0000,0000,,Мен оған көлеңке түсірдім, бірақ
Dialogue: 0,0:14:47.60,0:14:48.90,Default,,0000,0000,0000,,Маған солай
Dialogue: 0,0:14:49.50,0:14:52.16,Default,,0000,0000,0000,,Канна мені шақырды.
Dialogue: 0,0:14:52.56,0:14:56.78,Default,,0000,0000,0000,,Тецуро-кун мен Киришима-кун да дос болды.
Dialogue: 0,0:14:57.85,0:15:01.13,Default,,0000,0000,0000,,Мен өте қуаныштымын және көңілдімін
Dialogue: 0,0:15:01.98,0:15:04.21,Default,,0000,0000,0000,,Сол себепті мен танылғым келмейді.
Dialogue: 0,0:15:05.43,0:15:08.49,Default,,0000,0000,0000,,Мен бұзық емеспін.
Dialogue: 0,0:15:10.30,0:15:11.79,Default,,0000,0000,0000,,Сіз ақымақ емессіз.
Dialogue: 0,0:15:13.09,0:15:14.45,Default,,0000,0000,0000,,Егер сіз жиі ұмытып кетсеңіз
Dialogue: 0,0:15:14.71,0:15:16.52,Default,,0000,0000,0000,,Ақшаны сөмкеге салу керек.
Dialogue: 0,0:15:16.88,0:15:18.13,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:15:18.16,0:15:20.99,Default,,0000,0000,0000,,Сосын жуынатын бөлмеге бара жатқандай кейіп танытып, кіріңіз.
Dialogue: 0,0:15:21.31,0:15:22.28,Default,,0000,0000,0000,,Спортзалға арналған киімдер де бар шығар.
Dialogue: 0,0:15:22.95,0:15:24.10,Default,,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:15:23.55,0:15:26.32,Default,,0000,0000,0000,,Асығыс пен асығыс мәселені шешпейді.
Dialogue: 0,0:15:26.80,0:15:27.95,Default,,0000,0000,0000,,Ненің көлеңкесі бар?
Dialogue: 0,0:15:28.47,0:15:29.89,Default,,0000,0000,0000,,Негативті ойлар тым көп
Dialogue: 0,0:15:32.15,0:15:34.09,Default,,0000,0000,0000,,Қиындыққа тап болсаңыз, бізбен кеңесіңіз.
Dialogue: 0,0:15:35.07,0:15:36.52,Default,,0000,0000,0000,,Артымнан еретініңізге сенімдімін.
Dialogue: 0,0:15:37.04,0:15:39.78,Default,,0000,0000,0000,,Канна, теңіз және мен
Dialogue: 0,0:15:40.71,0:15:41.22,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:15:41.60,0:15:42.66,Default,,0000,0000,0000,,Бірақ жоқ.
Dialogue: 0,0:15:44.68,0:15:46.66,Default,,0000,0000,0000,,Мені бәрі жек көрсе
Dialogue: 0,0:15:47.13,0:15:48.08,Default,,0000,0000,0000,,Мұны жасамаңыз
Dialogue: 0,0:15:49.68,0:15:50.32,Default,,0000,0000,0000,,Шынымен
Dialogue: 0,0:15:50.99,0:15:52.78,Default,,0000,0000,0000,,Бізге сене алмайсыз ба?
Dialogue: 0,0:15:59.86,0:16:03.54,Default,,0000,0000,0000,,Сондықтан не айтқыңыз келетінін айтыңыз.
Dialogue: 0,0:16:08.99,0:16:09.68,Default,,0000,0000,0000,,Ұнады
Dialogue: 0,0:16:11.40,0:16:15.70,Default,,0000,0000,0000,,Маған Тецуро-кун ұнайды
Dialogue: 0,0:16:18.06,0:16:18.95,Default,,0000,0000,0000,,Мен сенің үмітіңді артамын
Dialogue: 0,0:16:21.41,0:16:22.18,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:16:22.63,0:16:24.57,Default,,0000,0000,0000,,Киношита: Міне солай болды.
Dialogue: 0,0:16:25.84,0:16:26.77,Default,,0000,0000,0000,,Сондықтан да көп
Dialogue: 0,0:16:27.64,0:16:29.17,Default,,0000,0000,0000,,Ол кешірім сұрады.
Dialogue: 0,0:16:29.99,0:16:31.58,Default,,0000,0000,0000,,О, қандай аянышты.
Dialogue: 0,0:16:32.82,0:16:34.76,Default,,0000,0000,0000,,Мен оның өзін итеріп жатқанын білдім.
Dialogue: 0,0:16:35.38,0:16:36.80,Default,,0000,0000,0000,,Мен дұрыс тыңдай алмадым.
Dialogue: 0,0:16:37.49,0:16:39.73,Default,,0000,0000,0000,,Мен оны үлкендерге қалдырдым.
Dialogue: 0,0:16:41.05,0:16:43.91,Default,,0000,0000,0000,,Менің ойымша, Киносита мырза Кайтоға айтқысы келді.
Dialogue: 0,0:16:45.28,0:16:48.30,Default,,0000,0000,0000,,Бірақ бұған дейін мен сізге қоңырау шалдым.
Dialogue: 0,0:16:48.68,0:16:49.38,Default,,0000,0000,0000,,Ағаштың астында
Dialogue: 0,0:16:52.50,0:16:54.09,Default,,0000,0000,0000,,Бұл да тапсырма болды ма?
Dialogue: 0,0:16:55.46,0:16:58.25,Default,,0000,0000,0000,,Әй, түсте келдің ғой.
Dialogue: 0,0:16:59.74,0:17:01.80,Default,,0000,0000,0000,,Не айтқыңыз келді?
Dialogue: 0,0:17:02.40,0:17:04.56,Default,,0000,0000,0000,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:17:09.06,0:17:10.32,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:17:20.84,0:17:21.93,Default,,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,0:17:22.58,0:17:23.21,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:17:44.52,0:17:47.56,Default,,0000,0000,0000,,Әйтеуір, екеуің бірге жарасып тұрсыңдар.
Dialogue: 0,0:17:47.71,0:17:50.59,Default,,0000,0000,0000,,Мен сізді мазалағандай сезінемін.
Dialogue: 0,0:17:50.79,0:17:53.67,Default,,0000,0000,0000,,Тецуро-сан өзіне ұнайтын адам жоқ екенін айтты.
Dialogue: 0,0:17:53.79,0:17:56.08,Default,,0000,0000,0000,,Мен қандай сайқымазақпын.
Dialogue: 0,0:17:56.43,0:17:59.46,Default,,0000,0000,0000,,Сіз менің жүрегімді сыздатқан сапарымда мені ертіп келдіңіз.
Dialogue: 0,0:17:59.89,0:18:01.04,Default,,0000,0000,0000,,Қазір де солай
Dialogue: 0,0:18:01.52,0:18:06.49,Default,,0000,0000,0000,,Нағыз табиғат – қулық
Dialogue: 0,0:18:07.81,0:18:11.92,Default,,0000,0000,0000,,Кешіріңіз, бұл жазда екінші рет.
Dialogue: 0,0:18:14.75,0:18:16.40,Default,,0000,0000,0000,,Кеш болды.
Dialogue: 0,0:18:17.52,0:18:18.13,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:18:19.22,0:18:20.66,Default,,0000,0000,0000,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:18:22.25,0:18:23.15,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:18:23.94,0:18:26.68,Default,,0000,0000,0000,,Сіздің алдыңғы жауабыңызға қарсы емеспін.
Dialogue: 0,0:18:28.79,0:18:30.06,Default,,0000,0000,0000,,Себебі мен түсінемін
Dialogue: 0,0:18:33.44,0:18:35.39,Default,,0000,0000,0000,,Ишигаки-кун, қызық, қалайсың?
Dialogue: 0,0:18:35.72,0:18:37.79,Default,,0000,0000,0000,,Қазірдің өзінде ағаш астындағы балаға
Dialogue: 0,0:18:37.86,0:18:38.91,Default,,0000,0000,0000,,Айнала қуып бара жатыр
Dialogue: 0,0:18:39.82,0:18:43.25,Default,,0000,0000,0000,,Әйтеуір, саған осылай қыз жақындаса...
Dialogue: 0,0:18:43.47,0:18:44.96,Default,,0000,0000,0000,,Бала өзін жаман сезінбейді.
Dialogue: 0,0:18:45.65,0:18:47.26,Default,,0000,0000,0000,,Бұл біраз
Dialogue: 0,0:18:48.09,0:18:49.48,Default,,0000,0000,0000,,Киносита мырзаның кезінде де
Dialogue: 0,0:18:50.09,0:18:52.03,Default,,0000,0000,0000,,Өтінемін, мені қорламаңыз
Dialogue: 0,0:18:53.10,0:18:53.94,Default,,0000,0000,0000,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:18:59.01,0:18:59.77,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:19:00.97,0:19:01.55,Default,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:19:03.38,0:19:05.85,Default,,0000,0000,0000,,Мені қуып жібергім келмейді.
Dialogue: 0,0:19:06.79,0:19:08.08,Default,,0000,0000,0000,,Мен сені қуғым келеді
Dialogue: 0,0:19:08.70,0:19:10.02,Default,,0000,0000,0000,,Сізге ұнайтын адам туралы
Dialogue: 0,0:19:10.62,0:19:11.61,Default,,0000,0000,0000,,Мен қуғым келеді
Dialogue: 0,0:19:15.79,0:19:16.47,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:19:16.93,0:19:19.71,Default,,0000,0000,0000,,Менің сезімім ағама қиындық тудырса
Dialogue: 0,0:19:19.91,0:19:21.28,Default,,0000,0000,0000,,Ондай нәрсе жоқ
Dialogue: 0,0:19:24.49,0:19:25.47,Default,,0000,0000,0000,,Қиындыққа тап болдыңыз ба?
Dialogue: 0,0:19:26.10,0:19:26.61,Default,,0000,0000,0000,,және үшінші (Three) фильмде алғашқы болып өлген адамның немересі, және т.б.—
Dialogue: 0,0:19:35.20,0:19:37.73,Default,,0000,0000,0000,,Жоқ, жоқ.
Dialogue: 0,0:19:42.43,0:19:44.07,Default,,0000,0000,0000,,№
Dialogue: 0,0:19:47.01,0:19:48.15,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:50.11,0:19:51.43,Default,,0000,0000,0000,,Тататата Танигава мырза
Dialogue: 0,0:19:51.48,0:19:52.75,Default,,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:19:52.82,0:19:54.06,Default,,0000,0000,0000,,Бұл қандай көрініс?
Dialogue: 0,0:19:54.24,0:19:56.75,Default,,0000,0000,0000,,Қайда болдыңдар, екеуің ғана?
Dialogue: 0,0:19:57.27,0:20:00.82,Default,,0000,0000,0000,,Сіз қайда болдыңыз?
Dialogue: 0,0:20:02.14,0:20:03.56,Default,,0000,0000,0000,,Эй, бұл не?
Dialogue: 0,0:20:03.81,0:20:06.08,Default,,0000,0000,0000,,Біз қыздар түнін өткізіп жатқан едік, тек екеуміз.
Dialogue: 0,0:20:07.26,0:20:08.83,Default,,0000,0000,0000,,Танигава мырза, жарайды.
Dialogue: 0,0:20:09.05,0:20:10.77,Default,,0000,0000,0000,,Ха, Такизуки-сенпай.
Dialogue: 0,0:20:12.80,0:20:14.21,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Танигава
Dialogue: 0,0:20:14.67,0:20:15.78,Default,,0000,0000,0000,,Олай болса, Кайто-кун.
Dialogue: 0,0:20:16.76,0:20:17.48,Default,,0000,0000,0000,,No
Dialogue: 0,0:20:17.63,0:20:18.32,Default,,0000,0000,0000,,Тоқта
Dialogue: 0,0:20:18.45,0:20:18.97,Default,,0000,0000,0000,,Канна
Dialogue: 0,0:20:19.27,0:20:20.46,Default,,0000,0000,0000,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:20:21.38,0:20:23.57,Default,,0000,0000,0000,,Тецуро мияу Мио мияу
Dialogue: 0,0:20:23.69,0:20:25.36,Default,,0000,0000,0000,,Екеуің қайда бардыңдар?
Dialogue: 0,0:20:26.77,0:20:27.92,Default,,0000,0000,0000,,Цука
Dialogue: 0,0:20:28.24,0:20:29.85,Default,,0000,0000,0000,,Сіз қайда болдыңыз?
Dialogue: 0,0:20:29.95,0:20:30.60,Default,,0000,0000,0000,,Не болып жатыр өзі?
Dialogue: 0,0:20:30.67,0:20:31.37,Default,,0000,0000,0000,,Канна
Dialogue: 0,0:20:31.54,0:20:32.51,Default,,0000,0000,0000,,Оны ұмытып қалдың ба?
Dialogue: 0,0:20:32.61,0:20:34.58,Default,,0000,0000,0000,,Мен жалғыз қалдым
Dialogue: 0,0:20:34.68,0:20:35.94,Default,,0000,0000,0000,,Менің ұйқым келгені сондықтан
Dialogue: 0,0:20:36.09,0:20:38.60,Default,,0000,0000,0000,,Жоқ, жоқ, мен осындай жерде ұйықтаймын.
Dialogue: 0,0:20:38.80,0:20:41.04,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:20:41.14,0:20:42.45,Default,,0000,0000,0000,,Нян
Dialogue: 0,0:20:53.71,0:20:54.42,Default,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,0:20:55.45,0:20:56.56,Default,,0000,0000,0000,,Мені қорға
Dialogue: 0,0:20:57.56,0:20:58.31,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:20:59.43,0:21:00.52,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:21:01.41,0:21:02.04,Default,,0000,0000,0000,,Кесу
Dialogue: 0,0:21:03.68,0:21:06.59,Default,,0000,0000,0000,,Осымен Киношита мырзаның бөлімі аяқталды және түсірілім аяқталды.
Dialogue: 0,0:21:07.47,0:21:08.40,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:21:08.91,0:21:09.87,Default,,0000,0000,0000,,Мен де солай.
Dialogue: 0,0:21:11.16,0:21:13.90,Default,,0000,0000,0000,,Менің ұшуға уақытым бар, міне, келдім.
Dialogue: 0,0:21:14.11,0:21:16.33,Default,,0000,0000,0000,,Өкініштісі, мен соңғы сәтке дейін шыдадым.
Dialogue: 0,0:21:16.46,0:21:17.67,Default,,0000,0000,0000,,сабырлы және сабырлы
Dialogue: 0,0:21:17.81,0:21:18.82,Default,,0000,0000,0000,,Түсірілімге сәттілік
Dialogue: 0,0:21:19.39,0:21:21.20,Default,,0000,0000,0000,,Ол аяқталғаннан кейін, оны маған көрсетіңіз.
Dialogue: 0,0:21:21.33,0:21:21.77,Default,,0000,0000,0000,,О
Dialogue: 0,0:21:22.45,0:21:23.65,Default,,0000,0000,0000,,Киносита мырза, бұл
Dialogue: 0,0:21:24.29,0:21:25.63,Default,,0000,0000,0000,,Ах, рақмет.
Dialogue: 0,0:21:27.29,0:21:29.93,Default,,0000,0000,0000,,Шағымдай берсең, Уми-чан алып кетеді.
Dialogue: 0,0:21:31.77,0:21:32.56,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:21:41.65,0:21:42.18,Default,,0000,0000,0000,,Мен өзімді жалғыз сезінемін
Dialogue: 0,0:21:42.65,0:21:43.92,Default,,0000,0000,0000,,Ал, аздап.
Dialogue: 0,0:21:44.47,0:21:46.33,Default,,0000,0000,0000,,Ол менің алғашқы махаббатым.
Dialogue: 0,0:21:46.46,0:21:47.70,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:21:48.64,0:21:50.36,Default,,0000,0000,0000,,Бізде кешкі рейс бар.
Dialogue: 0,0:21:50.56,0:21:52.07,Default,,0000,0000,0000,,Сағат 17.
Dialogue: 0,0:21:52.64,0:21:54.38,Default,,0000,0000,0000,,Бүгінгі түсірілім аяқталды
Dialogue: 0,0:21:54.73,0:21:56.47,Default,,0000,0000,0000,,Сіз кетуге дайын болған кезде
Dialogue: 0,0:21:56.74,0:21:58.76,Default,,0000,0000,0000,,Окинава теңізінен рахат алыңыз
Dialogue: 0,0:22:00.05,0:22:01.59,Default,,0000,0000,0000,,Келісіңіз
Dialogue: 0,0:22:07.78,0:22:08.65,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:22:14.29,0:22:17.60,Default,,0000,0000,0000,,Мен түсіндім
Dialogue: 0,0:22:34.25,0:22:35.10,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:22:37.13,0:22:38.23,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:23:40.93,0:23:44.39,Default,,0000,0000,0000,,Китахара-сан, Лимон бәріміз фестивальге барайық деді.
Dialogue: 0,0:23:44.46,0:23:46.15,Default,,0000,0000,0000,,Бұл қауіпті
Dialogue: 0,0:23:46.20,0:23:47.00,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:23:47.10,0:23:49.71,Default,,0000,0000,0000,,Мен қастандықтың иісін сезіп тұрмын
Dialogue: 0,0:04:56.06,0:04:58.25,Default,,0000,0000,0000,,Нюри Нюри Зайори
Dialogue: 0,0:04:58.62,0:04:59.29,Default,,0000,0000,0000,,Нари Нари
Dialogue: 0,0:04:59.86,0:05:04.14,Default,,0000,0000,0000,,Нари Нари Зайнари Нари
Dialogue: 0,0:05:39.98,0:05:41.24,Default,,0000,0000,0000,,Микуды жылжыту керек
Dialogue: 0,0:05:53.27,0:05:55.78,Default,,0000,0000,0000,,т.б. Тецуро Догаку
Dialogue: 0,0:08:50.36,0:08:53.19,Default,,0000,0000,0000,,Бірінші сынып
Dialogue: 0,0:13:49.28,0:13:51.91,Default,,0000,0000,0000,,Оқушылардың ойлары
Dialogue: 0,0:22:25.13,0:22:30.84,Default,,0000,0000,0000,,Саған ғашық болу үшін іздеген себебім
Dialogue: 0,0:22:30.94,0:22:37.90,Default,,0000,0000,0000,,Бұл ең қуанышты сөз деп айтылады.
Dialogue: 0,0:22:40.16,0:22:45.68,Default,,0000,0000,0000,,Мен мұны түсінгенде, жіптер дұрыс емес тураланған.
Dialogue: 0,0:22:46.14,0:22:53.54,Default,,0000,0000,0000,,Бір жақты түйін күшейе түсті.
Dialogue: 0,0:22:54.83,0:23:01.42,Default,,0000,0000,0000,,Еш ойланбай, қаш
Dialogue: 0,0:23:02.20,0:23:07.24,Default,,0000,0000,0000,,Сіз мәңгілік емессіз
Dialogue: 0,0:23:08.49,0:23:12.43,Default,,0000,0000,0000,,Бұлт пішінін пирсинг
Dialogue: 0,0:23:12.54,0:23:14.94,Default,,0000,0000,0000,,Ойлы серпін фильмі
Dialogue: 0,0:23:15.04,0:23:19.89,Default,,0000,0000,0000,,Жаз ортасының иісімен
Dialogue: 0,0:23:19.95,0:23:23.46,Default,,0000,0000,0000,,Бұл менің есімде талай рет
Dialogue: 0,0:23:23.53,0:23:27.11,Default,,0000,0000,0000,,Тек сен маған берген ғажайып
Dialogue: 0,0:23:27.20,0:23:31.85,Default,,0000,0000,0000,,Душ сияқты өтіңіз
Dialogue: 0,0:23:31.95,0:23:39.57,Default,,0000,0000,0000,,Ол түсті шығарды.
Dialogue: 0,0:22:25.13,0:22:30.84,Default,,0000,0000,0000,,Адал болу қуанышының себебі
Dialogue: 0,0:22:30.94,0:22:37.90,Default,,0000,0000,0000,,Бұл сіздің ең ашық әңгімеңіз.
Dialogue: 0,0:22:40.16,0:22:45.68,Default,,0000,0000,0000,,Ниет жеткенде кенет қызыл сызық ашылады.
Dialogue: 0,0:22:46.14,0:22:53.54,Default,,0000,0000,0000,,Оңтүстік және терең ойлар
Dialogue: 0,0:22:54.83,0:23:01.42,Default,,0000,0000,0000,,Ол үшін төлеудің қажеті жоқ.
Dialogue: 0,0:23:02.20,0:23:07.24,Default,,0000,0000,0000,,Накая ұзақ уақыт бойы белсенділік танытты
Dialogue: 0,0:23:08.49,0:23:12.43,Default,,0000,0000,0000,,ену қабаты
Dialogue: 0,0:23:12.54,0:23:14.94,Default,,0000,0000,0000,,Ой қозғайтын бейне
Dialogue: 0,0:23:15.04,0:23:19.89,Default,,0000,0000,0000,,Жаз ортасының дәмі
Dialogue: 0,0:23:19.95,0:23:23.46,Default,,0000,0000,0000,,Шексіз жерді тіркеу
Dialogue: 0,0:23:23.53,0:23:27.11,Default,,0000,0000,0000,,Мен үшін бұл жай ғана ғажайып
Dialogue: 0,0:23:27.20,0:23:31.85,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:31.95,0:23:39.57,Default,,0000,0000,0000,,Түсімен әдемі ашылған
Dialogue: 0,0:01:02.72,0:01:05.92,Default,,0000,0000,0000,,Теңіз самалы жүзіңнен соғады
Dialogue: 0,0:01:06.69,0:01:09.81,Default,,0000,0000,0000,,Сіз үндемейсіз
Dialogue: 0,0:01:10.50,0:01:14.49,Default,,0000,0000,0000,,Іс жүзінде бұл профиль
Dialogue: 0,0:01:15.21,0:01:18.12,Default,,0000,0000,0000,,Мен оған қол тигізгім келеді
Dialogue: 0,0:01:18.23,0:01:21.52,Default,,0000,0000,0000,,Мен сені сүйіп тұрғандай болдым
Dialogue: 0,0:01:22.37,0:01:25.54,Default,,0000,0000,0000,,Бұл түсінде болды
Dialogue: 0,0:01:25.99,0:01:32.66,Default,,0000,0000,0000,,Жел шындықтың шекарасына тиеді
Dialogue: 0,0:01:34.22,0:01:41.13,Default,,0000,0000,0000,,Күнделікті өмір кездейсоқ сөздермен жарқырайды
Dialogue: 0,0:01:41.29,0:01:47.43,Default,,0000,0000,0000,,Бір күні көрген кино сияқты.
Dialogue: 0,0:01:48.42,0:01:52.12,Default,,0000,0000,0000,,Жыл мезгілдері келіп-кетсе де
Dialogue: 0,0:01:52.65,0:01:56.39,Default,,0000,0000,0000,,Бізді мәңгі күтеді
Dialogue: 0,0:01:56.47,0:02:03.64,Default,,0000,0000,0000,,Күйген пленка сияқты жаздың иісі
Dialogue: 0,0:02:03.95,0:02:07.87,Default,,0000,0000,0000,,Ұзақ уақытқа созылатын ескерту
Dialogue: 0,0:02:08.10,0:02:12.59,Default,,0000,0000,0000,,Мен қараған объективтен секіру
Dialogue: 0,0:02:12.91,0:02:18.02,Default,,0000,0000,0000,,Мен сенің қолыңнан ұстаймын
Dialogue: 0,0:01:02.72,0:01:05.92,Default,,0000,0000,0000,,Теңіз самалы
Dialogue: 0,0:01:07.16,0:01:09.81,Default,,0000,0000,0000,,Сізде сөз жоқ.
Dialogue: 0,0:01:10.50,0:01:14.49,Default,,0000,0000,0000,,Менің ойымша, дәл осылай.
Dialogue: 0,0:01:15.21,0:01:18.12,Default,,0000,0000,0000,,Үстелдің жағы
Dialogue: 0,0:01:18.23,0:01:21.52,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:22.37,0:01:25.54,Default,,0000,0000,0000,,Түсінде жатқан түсте
Dialogue: 0,0:01:25.99,0:01:32.66,Default,,0000,0000,0000,,Теңіз желінің нақты әлемі
Dialogue: 0,0:01:34.55,0:01:41.13,Default,,0000,0000,0000,,Күтпеген сөз, күтпеген күнделікті өмір
Dialogue: 0,0:01:41.29,0:01:47.43,Default,,0000,0000,0000,,Сурет дегеніміз не?
Dialogue: 0,0:01:48.42,0:01:52.12,Default,,0000,0000,0000,,Өкілді дереу ауыстыру
Dialogue: 0,0:01:52.65,0:01:56.39,Default,,0000,0000,0000,,Біз мәңгі бірге жұмыс істей береміз.
Dialogue: 0,0:01:56.47,0:02:03.64,Default,,0000,0000,0000,,...
Dialogue: 0,0:02:03.95,0:02:07.87,Default,,0000,0000,0000,,Кездесусіз тарайтын толқу сезімі
Dialogue: 0,0:02:08.10,0:02:12.59,Default,,0000,0000,0000,,Мөлдір айна
Dialogue: 0,0:02:12.91,0:02:18.02,Default,,0000,0000,0000,,Гайкай Коукен Сумина Тадате
Dialogue: 0,0:23:51.21,0:23:57.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory