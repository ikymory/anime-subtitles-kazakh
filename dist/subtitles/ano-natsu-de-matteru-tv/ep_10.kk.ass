Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:59.96,0:03:09.96,Default,,0000,0000,0000,,Бұл субтитр көзі коммерциялық пайдалануға тыйым салынған субтитрлер тобының өндірісі, жеткізу алмасуы болып табылады.
Dialogue: 0,0:02:59.96,0:03:09.96,Default,,0000,0000,0000,,: ： яя : Сюра :
Dialogue: 0,0:00:01.66,0:00:02.80,Default,,0000,0000,0000,,Мен сені әрқашан жақсы көрдім
Dialogue: 0,0:00:05.72,0:00:06.83,Default,,0000,0000,0000,,Мен сені әрқашан жақсы көрдім
Dialogue: 0,0:00:07.50,0:00:09.61,Default,,0000,0000,0000,,Мен басынан бастап сенімдімін
Dialogue: 0,0:00:10.56,0:00:12.65,Default,,0000,0000,0000,,Мен түсінбедім
Dialogue: 0,0:00:14.76,0:00:15.57,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:00:16.34,0:00:18.86,Default,,0000,0000,0000,,Мен саған ғашық болдым
Dialogue: 0,0:00:29.27,0:00:30.81,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:00:31.31,0:00:32.33,Default,,0000,0000,0000,,Бұл арман сызығы ма?
Dialogue: 0,0:00:32.97,0:00:34.49,Default,,0000,0000,0000,,Кеше де айтты.
Dialogue: 0,0:00:36.13,0:00:36.70,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:00:37.38,0:00:38.49,Default,,0000,0000,0000,,Жаз қандай болса да
Dialogue: 0,0:00:39.23,0:00:41.60,Default,,0000,0000,0000,,Осындай жерде ұйықтасам, суық тиіп қаламын.
Dialogue: 0,0:00:41.95,0:00:42.69,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:00:46.77,0:00:47.62,Default,,0000,0000,0000,,Енді сіз сенімді бола аласыз
Dialogue: 0,0:00:50.15,0:00:52.11,Default,,0000,0000,0000,,Мен түс көрдім
Dialogue: 0,0:00:52.62,0:00:53.38,Default,,0000,0000,0000,,Шиганьшинаға апаратын жолды іздеуге аттанған Зерттеу корпусы
Dialogue: 0,0:00:54.15,0:00:57.37,Default,,0000,0000,0000,,Үлкенмен ғашық болуды армандайды
Dialogue: 0,0:00:59.82,0:01:00.91,Default,,0000,0000,0000,,Бұл шындық
Dialogue: 0,0:01:01.38,0:01:04.42,Default,,0000,0000,0000,,Мен әлі де сене алар емеспін.
Dialogue: 0,0:01:05.34,0:01:07.47,Default,,0000,0000,0000,,Танигава мырзаға рахмет
Dialogue: 0,0:01:09.21,0:01:12.12,Default,,0000,0000,0000,,Өйткені сен менің сезімімді сезіндірдің
Dialogue: 0,0:01:15.00,0:01:18.83,Default,,0000,0000,0000,,Танигава: Сіз әлі де өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:03:03.17,0:03:06.18,Default,,0000,0000,0000,,Қорқынышты, әлі ісінген
Dialogue: 0,0:03:06.53,0:03:09.33,Default,,0000,0000,0000,,Бəрінің алдына осындай жүзбен шыға алмайсың.
Dialogue: 0,0:03:09.51,0:03:11.17,Default,,0000,0000,0000,,Бұл алаңдататын ештеңе жоқ.
Dialogue: 0,0:03:11.27,0:03:12.54,Default,,0000,0000,0000,,Көп нәрсе өзгерген жоқ.
Dialogue: 0,0:03:12.66,0:03:15.57,Default,,0000,0000,0000,,Оның орнына ол барлығына хабарласты.
Dialogue: 0,0:03:16.07,0:03:18.39,Default,,0000,0000,0000,,Әзірше мен жазғы суық деп шештім.
Dialogue: 0,0:03:18.75,0:03:20.12,Default,,0000,0000,0000,,Бұл орынды.
Dialogue: 0,0:03:22.11,0:03:22.74,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:03:23.23,0:03:25.32,Default,,0000,0000,0000,,Біз бала кезден доспыз.
Dialogue: 0,0:03:27.90,0:03:30.44,Default,,0000,0000,0000,,Әй, кешегі күн туралы.
Dialogue: 0,0:03:30.73,0:03:32.80,Default,,0000,0000,0000,,Уайымдама, мен ешкімге айтпаймын.
Dialogue: 0,0:03:33.99,0:03:34.52,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:03:37.15,0:03:39.66,Default,,0000,0000,0000,,Эй, түскі асқа аз қалды.
Dialogue: 0,0:03:39.78,0:03:41.34,Default,,0000,0000,0000,,Тецуро-кун тамақ ішеді
Dialogue: 0,0:03:41.50,0:03:42.94,Default,,0000,0000,0000,,Аа, көп рахмет.
Dialogue: 0,0:03:42.96,0:03:45.65,Default,,0000,0000,0000,,Тецуро, менің бір ісім бар. Мен бірден қайтамын.
Dialogue: 0,0:03:46.52,0:03:47.60,Default,,0000,0000,0000,,Солай сияқты.
Dialogue: 0,0:03:57.65,0:03:59.42,Default,,0000,0000,0000,,Мен Кайто-кунды жақсы көремін
Dialogue: 0,0:04:01.70,0:04:03.02,Default,,0000,0000,0000,,Маған ұнайды
Dialogue: 0,0:04:04.76,0:04:05.23,Default,,0000,0000,0000,,Канна
Dialogue: 0,0:04:07.02,0:04:07.60,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:04:08.71,0:04:09.81,Default,,0000,0000,0000,,Эй, эй
Dialogue: 0,0:04:10.62,0:04:11.27,Default,,0000,0000,0000,,Қайтару
Dialogue: 0,0:04:12.09,0:04:13.23,Default,,0000,0000,0000,,Хачо
Dialogue: 0,0:04:13.31,0:04:14.40,Default,,0000,0000,0000,,Менің артымнан ерме
Dialogue: 0,0:04:17.88,0:04:18.53,Default,,0000,0000,0000,,Қазір туралы
Dialogue: 0,0:04:20.91,0:04:21.93,Default,,0000,0000,0000,,Сол жігіт
Dialogue: 0,0:04:25.01,0:04:25.80,Default,,0000,0000,0000,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:04:37.42,0:04:39.30,Default,,0000,0000,0000,,Китахара мырза, солай ма?
Dialogue: 0,0:04:40.42,0:04:42.02,Default,,0000,0000,0000,,Бір бастауыш мектепте оқысақ та
Dialogue: 0,0:04:42.29,0:04:44.33,Default,,0000,0000,0000,,Бір сыныпта бірінші рет оқып жатырмыз.
Dialogue: 0,0:04:44.70,0:04:46.92,Default,,0000,0000,0000,,Канна Танигава бұдан былай танысқаныма қуаныштымын
Dialogue: 0,0:04:47.09,0:04:48.41,Default,,0000,0000,0000,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:04:48.92,0:04:50.54,Default,,0000,0000,0000,,Тағы да сол сынып?
Dialogue: 0,0:04:51.14,0:04:52.63,Default,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:04:52.95,0:04:54.77,Default,,0000,0000,0000,,Бұл менің жолым.
Dialogue: 0,0:04:55.31,0:04:57.28,Default,,0000,0000,0000,,Тецуро Ишигаки
Dialogue: 0,0:04:57.55,0:04:58.52,Default,,0000,0000,0000,,Бала күнгі досы
Dialogue: 0,0:04:58.74,0:05:00.71,Default,,0000,0000,0000,,Құрметпен, Мио Китахара
Dialogue: 0,0:05:01.38,0:05:03.29,Default,,0000,0000,0000,,менің атым
Dialogue: 0,0:05:03.54,0:05:04.72,Default,,0000,0000,0000,,Бұл таныс.
Dialogue: 0,0:05:04.93,0:05:08.39,Default,,0000,0000,0000,,Жоқ, мен барлық қыздардың бетін, атын жаттап алдым.
Dialogue: 0,0:05:08.56,0:05:11.07,Default,,0000,0000,0000,,Бұл ақымақ па? Бұл ақымақ па?
Dialogue: 0,0:05:11.64,0:05:14.36,Default,,0000,0000,0000,,Феминистік джентльмен ретінде түсіндіруге болмайды
Dialogue: 0,0:05:14.52,0:05:15.10,Default,,0000,0000,0000,,Сол жылы тағы бір үрей басталды
Dialogue: 0,0:05:15.20,0:05:16.50,Default,,0000,0000,0000,,Біраз уақыт қажет болды.
Dialogue: 0,0:05:16.66,0:05:18.03,Default,,0000,0000,0000,,Босқа кеткен күш
Dialogue: 0,0:05:19.35,0:05:24.34,Default,,0000,0000,0000,,Содан бері үш жыл өтті.
Dialogue: 0,0:05:26.31,0:05:26.94,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:05:27.22,0:05:28.32,Default,,0000,0000,0000,,Тецуро-кун
Dialogue: 0,0:05:28.69,0:05:29.46,Default,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:05:30.65,0:05:32.32,Default,,0000,0000,0000,,Каннаға бару
Dialogue: 0,0:05:32.69,0:05:34.45,Default,,0000,0000,0000,,О, тоқтағаның жөн.
Dialogue: 0,0:05:35.28,0:05:37.07,Default,,0000,0000,0000,,Жоқ, мен қазір оған қарап тұрмын.
Dialogue: 0,0:05:37.66,0:05:38.29,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:05:38.46,0:05:39.25,Default,,0000,0000,0000,,Көздер
Dialogue: 0,0:05:39.55,0:05:41.47,Default,,0000,0000,0000,,Өйткені мен суық тигізгім келмейді.
Dialogue: 0,0:05:41.57,0:05:42.99,Default,,0000,0000,0000,,Маған да бас тартылды.
Dialogue: 0,0:05:44.35,0:05:46.46,Default,,0000,0000,0000,,Мен Каннаның орнына бардым.
Dialogue: 0,0:05:46.98,0:05:48.38,Default,,0000,0000,0000,,Өйткені біз бала кезден доспыз
Dialogue: 0,0:05:49.22,0:05:50.91,Default,,0000,0000,0000,,О Мио
Dialogue: 0,0:05:51.81,0:05:53.20,Default,,0000,0000,0000,,Мен аш емеспін
Dialogue: 0,0:05:55.66,0:05:58.95,Default,,0000,0000,0000,,Сауықтыру торты босқа кетеді.
Dialogue: 0,0:06:01.90,0:06:03.04,Default,,0000,0000,0000,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:06:03.16,0:06:04.81,Default,,0000,0000,0000,,Иә, қолайсыздықтар үшін кешіріңіз.
Dialogue: 0,0:06:09.70,0:06:10.99,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:06:11.37,0:06:11.92,Default,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:06:12.21,0:06:15.16,Default,,0000,0000,0000,,Аа, мен фильмдерімді ретке келтіруге тырыстым.
Dialogue: 0,0:06:15.64,0:06:18.25,Default,,0000,0000,0000,,Лимон-сенпай мен үшін көп суретке түседі.
Dialogue: 0,0:06:18.35,0:06:20.36,Default,,0000,0000,0000,,Көп нәрсе жиналды.
Dialogue: 0,0:06:21.46,0:06:22.58,Default,,0000,0000,0000,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:06:24.86,0:06:25.91,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:06:26.28,0:06:27.51,Default,,0000,0000,0000,,Маған не керек?
Dialogue: 0,0:06:27.94,0:06:29.29,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:06:29.78,0:06:33.31,Default,,0000,0000,0000,,Мен бір-біріне жабысқанды ұнатамын деп ойлаймын.
Dialogue: 0,0:06:34.60,0:06:36.57,Default,,0000,0000,0000,,Кайто-кун мұндай нәрсені жек көреді.
Dialogue: 0,0:06:36.97,0:06:38.60,Default,,0000,0000,0000,,Су Мұндай нәрсе
Dialogue: 0,0:06:39.92,0:06:42.21,Default,,0000,0000,0000,,Мен де сені жек көрмеймін.
Dialogue: 0,0:06:44.25,0:06:45.19,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:06:55.88,0:06:57.83,Default,,0000,0000,0000,,Мен үшін алаңдама
Dialogue: 0,0:06:58.17,0:06:59.33,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:06:59.43,0:07:00.38,Default,,0000,0000,0000,,Маған бәрібір
Dialogue: 0,0:07:00.75,0:07:03.09,Default,,0000,0000,0000,,Балалар сендер орындадыңдар.
Dialogue: 0,0:07:03.36,0:07:07.86,Default,,0000,0000,0000,,Жақсы, жақсы
Dialogue: 0,0:07:08.03,0:07:08.88,Default,,0000,0000,0000,,Артық емес
Dialogue: 0,0:07:08.90,0:07:11.09,Default,,0000,0000,0000,,Ааа, не айтасың?
Dialogue: 0,0:07:11.21,0:07:11.96,Default,,0000,0000,0000,,Шатасудан адасып қалды
Dialogue: 0,0:07:12.03,0:07:13.63,Default,,0000,0000,0000,,Жақсы болды, Ичика.
Dialogue: 0,0:07:14.27,0:07:14.95,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:15.94,0:07:16.52,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:07:18.70,0:07:22.95,Default,,0000,0000,0000,,Киришима-кун, бұл менің сыйлығым.
Dialogue: 0,0:07:25.90,0:07:26.74,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:07:27.12,0:07:27.94,Default,,0000,0000,0000,,Бұл не
Dialogue: 0,0:07:28.22,0:07:29.08,Default,,0000,0000,0000,,Өйткені қазір
Dialogue: 0,0:07:29.16,0:07:30.40,Default,,0000,0000,0000,,Лимон Сенпай
Dialogue: 0,0:07:30.70,0:07:32.14,Default,,0000,0000,0000,,Оны бағалаңыз.
Dialogue: 0,0:07:33.26,0:07:35.03,Default,,0000,0000,0000,,Бұл ғажайып кездесу
Dialogue: 0,0:07:38.26,0:07:39.13,Default,,0000,0000,0000,,Гочисусан
Dialogue: 0,0:07:40.02,0:07:41.93,Default,,0000,0000,0000,,О, мен жедім, жедім
Dialogue: 0,0:07:42.48,0:07:44.44,Default,,0000,0000,0000,,Өйткені, Мионың торты дәмді екен.
Dialogue: 0,0:07:44.99,0:07:48.02,Default,,0000,0000,0000,,Өйткені бұл менің жалғыз еңбегім.
Dialogue: 0,0:07:48.57,0:07:49.59,Default,,0000,0000,0000,,Бар болғанша жақсы.
Dialogue: 0,0:07:50.14,0:07:51.88,Default,,0000,0000,0000,,Тецуро-кун да бар.
Dialogue: 0,0:07:52.32,0:07:53.69,Default,,0000,0000,0000,,Биік
Dialogue: 0,0:07:53.96,0:07:55.18,Default,,0000,0000,0000,,Әдемі келбет
Dialogue: 0,0:07:55.38,0:07:56.60,Default,,0000,0000,0000,,Қолмен жақсы
Dialogue: 0,0:07:57.07,0:08:00.18,Default,,0000,0000,0000,,Мен қыздардың бет-бейнесін, есімдерін жаттап алуды жақсы білемін.
Dialogue: 0,0:08:00.65,0:08:02.14,Default,,0000,0000,0000,,Бұл менің еңбегім емес.
Dialogue: 0,0:08:04.13,0:08:05.42,Default,,0000,0000,0000,,Естуге қиын нәрселер
Dialogue: 0,0:08:05.97,0:08:07.14,Default,,0000,0000,0000,,Сұрауға бола ма?
Dialogue: 0,0:08:07.31,0:08:07.84,Default,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:08:08.60,0:08:12.55,Default,,0000,0000,0000,,Неліктен Такидзуки-сенпайды фильмді түсіруге шақырдыңыз?
Dialogue: 0,0:08:14.15,0:08:16.80,Default,,0000,0000,0000,,Өйткені теңіз де солай қалағандай болды.
Dialogue: 0,0:08:17.50,0:08:20.46,Default,,0000,0000,0000,,Мен ағам мұны қабылдайды деп ойламаппын.
Dialogue: 0,0:08:21.13,0:08:22.62,Default,,0000,0000,0000,,Каннаның сезімі
Dialogue: 0,0:08:22.82,0:08:23.63,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:08:24.44,0:08:25.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:25.80,0:08:27.59,Default,,0000,0000,0000,,Бұл өте жақын.
Dialogue: 0,0:08:28.56,0:08:30.20,Default,,0000,0000,0000,,Себебі мен оны түсіндім.
Dialogue: 0,0:08:30.52,0:08:31.96,Default,,0000,0000,0000,,Білмейтін жол жоқ.
Dialogue: 0,0:08:33.36,0:08:35.68,Default,,0000,0000,0000,,Такидзуки-сенпайды не үшін шақырдың?
Dialogue: 0,0:08:37.58,0:08:40.22,Default,,0000,0000,0000,,Сенпай мен Киришима дос болып қалса
Dialogue: 0,0:08:40.27,0:08:40.84,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:08:41.58,0:08:42.19,Default,,0000,0000,0000,,Канна
Dialogue: 0,0:08:42.80,0:08:43.92,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:08:44.84,0:08:48.57,Default,,0000,0000,0000,,Мен Умиді қолдағым келіп, ағамды шақырдым.
Dialogue: 0,0:08:49.09,0:08:51.18,Default,,0000,0000,0000,,Канна фильм түсіруге қатысса
Dialogue: 0,0:08:51.55,0:08:53.74,Default,,0000,0000,0000,,Мен Кайтоға жақындай аламын деп ойладым.
Dialogue: 0,0:08:54.43,0:08:58.06,Default,,0000,0000,0000,,Нәтижесі қандай болатынын білмеймін.
Dialogue: 0,0:08:58.98,0:09:01.10,Default,,0000,0000,0000,,Мен екеуін де қолдауға тырыстым.
Dialogue: 0,0:09:01.89,0:09:02.65,Default,,0000,0000,0000,,Міне
Dialogue: 0,0:09:04.52,0:09:08.20,Default,,0000,0000,0000,,Ондай жағдайда Тецуроның сезімі қайда кетеді?
Dialogue: 0,0:09:10.09,0:09:13.03,Default,,0000,0000,0000,,Менің Каннаға деген сезімім қайда кетеді?
Dialogue: 0,0:09:14.12,0:09:16.90,Default,,0000,0000,0000,,Бұл не? Сіз не айттыңыз?
Dialogue: 0,0:09:17.00,0:09:18.67,Default,,0000,0000,0000,,Мен мұны көптен бері көріп жүргендіктен білемін.
Dialogue: 0,0:09:19.66,0:09:22.39,Default,,0000,0000,0000,,Тецуро-кун тек Каннаға қарап отырды.
Dialogue: 0,0:09:22.44,0:09:23.41,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:09:23.66,0:09:24.19,Default,,0000,0000,0000,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:09:25.75,0:09:27.69,Default,,0000,0000,0000,,Неге өзіңді өтірік айтасың?
Dialogue: 0,0:09:28.71,0:09:31.22,Default,,0000,0000,0000,,Осылай жалтарсаң да
Dialogue: 0,0:09:31.42,0:09:33.77,Default,,0000,0000,0000,,Уақыт мәселені шешпейді
Dialogue: 0,0:09:35.29,0:09:36.84,Default,,0000,0000,0000,,Не айтқыңыз келетінін айтыңыз
Dialogue: 0,0:09:37.43,0:09:39.67,Default,,0000,0000,0000,,Мұны маған Тецуро айтты.
Dialogue: 0,0:09:40.44,0:09:42.67,Default,,0000,0000,0000,,Сондықтан мен батылдығымды жинадым.
Dialogue: 0,0:09:44.42,0:09:45.00,Default,,0000,0000,0000,,Ұнады
Dialogue: 0,0:09:46.26,0:09:50.70,Default,,0000,0000,0000,,Маған Тецуро-кун ұнайды
Dialogue: 0,0:09:52.92,0:09:53.94,Default,,0000,0000,0000,,Мен сенің үмітіңді артамын
Dialogue: 0,0:09:55.55,0:09:58.26,Default,,0000,0000,0000,,Сол кезде мен жауап бергенім дұрыс дедім.
Dialogue: 0,0:09:58.51,0:10:00.10,Default,,0000,0000,0000,,Маған тыңдауға рұқсат етіңіз
Dialogue: 0,0:10:01.57,0:10:03.83,Default,,0000,0000,0000,,Мио мен
Dialogue: 0,0:10:04.77,0:10:07.23,Default,,0000,0000,0000,,Сіз туралы
Dialogue: 0,0:10:07.58,0:10:08.76,Default,,0000,0000,0000,,Мен оны жек көрмеймін
Dialogue: 0,0:10:09.62,0:10:11.59,Default,,0000,0000,0000,,Бірақ мен қазір
Dialogue: 0,0:10:12.90,0:10:13.64,Default,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:10:14.81,0:10:15.65,Default,,0000,0000,0000,,Мен үйге бара жатырмын
Dialogue: 0,0:10:19.21,0:10:20.80,Default,,0000,0000,0000,,Мен жай ғана қалыптымын.
Dialogue: 0,0:10:21.47,0:10:24.68,Default,,0000,0000,0000,,Жазғы демалыс: Бірге фильм түсіріп, көңілді болыңыз
Dialogue: 0,0:10:25.33,0:10:28.76,Default,,0000,0000,0000,,Кино түсіріп, оны мектептегі фестивальде немесе бірдеңеде көрсету.
Dialogue: 0,0:10:29.41,0:10:32.14,Default,,0000,0000,0000,,Қалай болғанда да, мен әдеттегідей Канна Танигавамын.
Dialogue: 0,0:10:33.38,0:10:34.33,Default,,0000,0000,0000,,Мен осылай шештім
Dialogue: 0,0:10:35.19,0:10:36.00,Default,,0000,0000,0000,,Каннана
Dialogue: 0,0:10:36.61,0:10:37.22,Default,,0000,0000,0000,,Таникава
Dialogue: 0,0:10:37.83,0:10:38.97,Default,,0000,0000,0000,,Егер бұл Танигава болса, бүгін менің үйіме кел.
Dialogue: 0,0:10:39.05,0:10:40.91,Default,,0000,0000,0000,,Теңізді жақсы көреді.
Dialogue: 0,0:10:41.73,0:10:43.15,Default,,0000,0000,0000,,Мен Кайто-кунды жақсы көремін
Dialogue: 0,0:10:43.64,0:10:44.71,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:10:49.24,0:10:50.45,Default,,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:10:52.17,0:10:55.00,Default,,0000,0000,0000,,Мен не істей аламын?
Dialogue: 0,0:11:01.91,0:11:02.68,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:11:04.10,0:11:05.43,Default,,0000,0000,0000,,Тейе
Dialogue: 0,0:11:09.52,0:11:10.09,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:11:11.53,0:11:12.20,Default,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:11:12.72,0:11:16.00,Default,,0000,0000,0000,,Қарсы болмасаң, суды суыт, сонда мен серуендемеймін.
Dialogue: 0,0:11:16.30,0:11:17.72,Default,,0000,0000,0000,,Иә, жақсы.
Dialogue: 0,0:11:18.56,0:11:20.38,Default,,0000,0000,0000,,Иә, бұл үлкен мәселе.
Dialogue: 0,0:11:20.90,0:11:21.37,Default,,0000,0000,0000,,Ринон
Dialogue: 0,0:11:24.03,0:11:25.45,Default,,0000,0000,0000,,Уау, бұл таңқаларлық.
Dialogue: 0,0:11:25.75,0:11:26.42,Default,,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:11:27.06,0:11:28.98,Default,,0000,0000,0000,,Түнде де жақсы болуы керек.
Dialogue: 0,0:11:29.70,0:11:32.21,Default,,0000,0000,0000,,Бұл естеліктердің орны.
Dialogue: 0,0:11:34.67,0:11:36.56,Default,,0000,0000,0000,,Қаншама табиғат қалды
Dialogue: 0,0:11:37.73,0:11:40.63,Default,,0000,0000,0000,,Бұл ғаламшарға бірінші рет келуім болса да, бұл біртүрлі.
Dialogue: 0,0:11:41.24,0:11:43.10,Default,,0000,0000,0000,,Бұл сағыныш сезімін тудырады.
Dialogue: 0,0:11:44.51,0:11:46.28,Default,,0000,0000,0000,,Ум, Сенпай
Dialogue: 0,0:11:47.49,0:11:48.98,Default,,0000,0000,0000,,Маған тағы да
Dialogue: 0,0:11:49.56,0:11:53.28,Default,,0000,0000,0000,,Маған сол жерді табуға көмектесе аласыз ба?
Dialogue: 0,0:11:53.41,0:11:53.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:54.43,0:11:56.19,Default,,0000,0000,0000,,Мен сенен сәл үлкенмін.
Dialogue: 0,0:11:56.22,0:11:56.79,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:11:58.38,0:11:58.92,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:12:00.24,0:12:00.67,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:12:01.24,0:12:02.64,Default,,0000,0000,0000,,Бірақ жеткілікті.
Dialogue: 0,0:12:03.82,0:12:07.58,Default,,0000,0000,0000,,Расында да мен бұл планетаға сол мақсатпен келдім.
Dialogue: 0,0:12:08.45,0:12:11.55,Default,,0000,0000,0000,,Керісінше, мен бұл сапарды мүмкіндік ретінде пайдаланғым келді.
Dialogue: 0,0:12:12.50,0:12:14.68,Default,,0000,0000,0000,,Бұл ештеңе болған сияқты емес.
Dialogue: 0,0:12:15.48,0:12:18.24,Default,,0000,0000,0000,,Сондықтан мен бірдеңе істегім келді
Dialogue: 0,0:12:20.72,0:12:21.81,Default,,0000,0000,0000,,Мен де
Dialogue: 0,0:12:23.06,0:12:27.56,Default,,0000,0000,0000,,Мен де бір нәрсені осыдан бастағым келді.
Dialogue: 0,0:12:28.50,0:12:29.96,Default,,0000,0000,0000,,Егер мен бірдеңе істей алсам
Dialogue: 0,0:12:30.69,0:12:31.61,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:12:32.26,0:12:33.62,Default,,0000,0000,0000,,Дәл солай болды, солай ма?
Dialogue: 0,0:12:34.52,0:12:38.32,Default,,0000,0000,0000,,Сонда мен одан да үлкен ағамның тілегін орындағым келеді.
Dialogue: 0,0:12:40.16,0:12:42.77,Default,,0000,0000,0000,,Енді мен Кайто-кунмен бірге болғым келеді.
Dialogue: 0,0:12:43.66,0:12:47.31,Default,,0000,0000,0000,,Мен Кайто-кунмен және басқалармен фильм түсіргім келеді.
Dialogue: 0,0:12:47.96,0:12:50.25,Default,,0000,0000,0000,,Бұл менің ендігі тілегім.
Dialogue: 0,0:12:51.34,0:12:52.59,Default,,0000,0000,0000,,Мен шын мәнінде бұны киюім керек пе?
Dialogue: 0,0:12:53.43,0:12:53.88,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:56.07,0:12:57.31,Default,,0000,0000,0000,,Мен оны білдім.
Dialogue: 0,0:12:59.55,0:13:02.95,Default,,0000,0000,0000,,Мәңгілік бұл дүниеде жоқ
Dialogue: 0,0:13:06.13,0:13:08.42,Default,,0000,0000,0000,,Мен жат планеталықпын деп жоқ дейсіз бе?
Dialogue: 0,0:13:09.29,0:13:11.03,Default,,0000,0000,0000,,Өйткені біз мәңгі бірге бола алмаймыз
Dialogue: 0,0:13:11.13,0:13:13.66,Default,,0000,0000,0000,,Сіз Кайтоның сезіміне жауап бере алмаймын дейсіз бе?
Dialogue: 0,0:13:14.58,0:13:16.00,Default,,0000,0000,0000,,Мұны сылтау ретінде пайдаланыңыз
Dialogue: 0,0:13:16.37,0:13:18.68,Default,,0000,0000,0000,,Сіз Кайто-куннан қашуды жалғастыра бересіз бе?
Dialogue: 0,0:13:20.32,0:13:21.74,Default,,0000,0000,0000,,Бұл жақсы болды.
Dialogue: 0,0:13:23.41,0:13:25.92,Default,,0000,0000,0000,,Кайто-кунның тілегі орындалады.
Dialogue: 0,0:13:27.98,0:13:30.54,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:13:31.58,0:13:33.35,Default,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:13:34.49,0:13:37.05,Default,,0000,0000,0000,,Қайтып келгеннен бері үндемейсің.
Dialogue: 0,0:13:37.47,0:13:38.55,Default,,0000,0000,0000,,Бірдеңе болды
Dialogue: 0,0:13:38.79,0:13:39.78,Default,,0000,0000,0000,,Әпкеңмен сөйлес.
Dialogue: 0,0:13:41.85,0:13:45.00,Default,,0000,0000,0000,,Айтайын, бұл жерде сен кінәлісің.
Dialogue: 0,0:13:45.64,0:13:48.46,Default,,0000,0000,0000,,Үндемей отырып іс шешілмейді, солай ма?
Dialogue: 0,0:13:49.23,0:13:50.92,Default,,0000,0000,0000,,Әдемі көрінуге тырысудың пайдасы жоқ
Dialogue: 0,0:13:51.62,0:13:53.45,Default,,0000,0000,0000,,Бейбіт өмір сүріп жатқан сияқты көрінсеңіз де
Dialogue: 0,0:13:53.73,0:13:56.10,Default,,0000,0000,0000,,Мен үшін сен жай ғана баласың.
Dialogue: 0,0:13:57.18,0:13:59.80,Default,,0000,0000,0000,,Өз өміріңді қайтып келген адамдай айтпа.
Dialogue: 0,0:14:00.44,0:14:02.22,Default,,0000,0000,0000,,Үйден қашу, қайтып оралмау
Dialogue: 0,0:14:02.80,0:14:05.02,Default,,0000,0000,0000,,Бұл менің қайтатын жерім бар дегенді білдіреді.
Dialogue: 0,0:14:05.83,0:14:08.24,Default,,0000,0000,0000,,Ерлі-зайыптылардың жанжалдарының түрлері көп.
Dialogue: 0,0:14:08.57,0:14:11.97,Default,,0000,0000,0000,,Ал, сен ешқашан қызбен болған емессің.
Dialogue: 0,0:14:12.22,0:14:13.84,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:14:14.16,0:14:15.62,Default,,0000,0000,0000,,О, жоқ, жоқ
Dialogue: 0,0:14:15.80,0:14:17.74,Default,,0000,0000,0000,,Бұл жерде қыздың иісі аңқып тұр.
Dialogue: 0,0:14:18.28,0:14:19.40,Default,,0000,0000,0000,,Содан кейін өзгертіңіз
Dialogue: 0,0:14:20.12,0:14:21.02,Default,,0000,0000,0000,,Кел, кел, кел
Dialogue: 0,0:14:21.76,0:14:23.02,Default,,0000,0000,0000,,Көмегің үшін рахмет, Тецуро.
Dialogue: 0,0:14:23.40,0:14:24.35,Default,,0000,0000,0000,,Ал, қолыңнан келгенше тырыспа.
Dialogue: 0,0:14:25.39,0:14:26.87,Default,,0000,0000,0000,,Түсіндім. Яғни бұл…
Dialogue: 0,0:14:27.55,0:14:29.27,Default,,0000,0000,0000,,Мен шаршадым
Dialogue: 0,0:14:31.28,0:14:32.73,Default,,0000,0000,0000,,Сондай-ақ, бұл лента?
Dialogue: 0,0:14:37.35,0:14:38.66,Default,,0000,0000,0000,,(Курокири) Шигараки, күткен нәтижеңді алдың ба?
Dialogue: 0,0:14:39.19,0:14:39.69,Default,,0000,0000,0000,,Тецуро
Dialogue: 0,0:14:41.29,0:14:42.15,Default,,0000,0000,0000,,Теңізге не болды?
Dialogue: 0,0:14:42.57,0:14:45.03,Default,,0000,0000,0000,,Мен ертеңгі күні түсірілімді жалғастыруды жоспарлап отырмын.
Dialogue: 0,0:14:45.62,0:14:46.19,Default,,0000,0000,0000,,Ал сосын!
Dialogue: 0,0:14:46.82,0:14:48.51,Default,,0000,0000,0000,,Жақсы, бірақ
Dialogue: 0,0:14:48.83,0:14:50.99,Default,,0000,0000,0000,,Үлкендеріңіз де келеді.
Dialogue: 0,0:14:51.74,0:14:53.18,Default,,0000,0000,0000,,Бұдан басқа, қауесетке сенсек, сол жігіт... өзімен бірге екі Өлім дәптерін алып кеткен.
Dialogue: 0,0:14:54.50,0:14:56.78,Default,,0000,0000,0000,,Сіз және сіздің аға буынсыз ба?
Dialogue: 0,0:14:58.13,0:15:01.11,Default,,0000,0000,0000,,А, мен бұл туралы бәрімен кездескенде айтамын.
Dialogue: 0,0:15:01.78,0:15:03.10,Default,,0000,0000,0000,,Олай болса, бәрібір.
Dialogue: 0,0:15:03.47,0:15:04.69,Default,,0000,0000,0000,,Иә, жақсы
Dialogue: 0,0:15:09.98,0:15:13.26,Default,,0000,0000,0000,,Сонымен, Каннамен не істеуіміз керек?
Dialogue: 0,0:15:14.38,0:15:17.36,Default,,0000,0000,0000,,Сондықтан дұрыс айтуым керек
Dialogue: 0,0:15:18.51,0:15:19.23,Default,,0000,0000,0000,,Менің сезімдерім
Dialogue: 0,0:15:23.95,0:15:25.56,Default,,0000,0000,0000,,Мен Тецуромын
Dialogue: 0,0:15:27.01,0:15:27.98,Default,,0000,0000,0000,,Тецуро
Dialogue: 0,0:15:33.05,0:15:35.51,Default,,0000,0000,0000,,Мен не істеп жатырмын?
Dialogue: 0,0:15:38.36,0:15:40.18,Default,,0000,0000,0000,,Иә, жарайды.
Dialogue: 0,0:15:40.40,0:15:43.14,Default,,0000,0000,0000,,Осы арқылы ертең түсіруді бастауға болады.
Dialogue: 0,0:15:44.25,0:15:45.94,Default,,0000,0000,0000,,Жарайды, иә
Dialogue: 0,0:15:46.43,0:15:46.96,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,0:15:47.63,0:15:49.97,Default,,0000,0000,0000,,Канна телефоны
Dialogue: 0,0:15:50.60,0:15:51.51,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:15:55.29,0:15:57.70,Default,,0000,0000,0000,,Неге мені мұндай жерге шақырдың?
Dialogue: 0,0:15:58.45,0:16:00.91,Default,,0000,0000,0000,,Ол аурудан айығуы керек.
Dialogue: 0,0:16:01.42,0:16:03.83,Default,,0000,0000,0000,,Жарайды, ісік басылды.
Dialogue: 0,0:16:04.29,0:16:05.58,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:16:06.18,0:16:07.54,Default,,0000,0000,0000,,Жарайды, сиқыр.
Dialogue: 0,0:16:07.94,0:16:09.01,Default,,0000,0000,0000,,О, мен жеңілдім.
Dialogue: 0,0:16:09.18,0:16:11.46,Default,,0000,0000,0000,,Балабақшада жүргенде жиі келетінмін.
Dialogue: 0,0:16:12.48,0:16:13.21,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:16:14.08,0:16:17.31,Default,,0000,0000,0000,,Ол кезде менің бойым ұзын болатын.
Dialogue: 0,0:16:17.98,0:16:20.57,Default,,0000,0000,0000,,Мен білмей тұрып, арамызда осындай айырмашылық бар еді.
Dialogue: 0,0:16:21.19,0:16:23.97,Default,,0000,0000,0000,,Мені қорлағанда сен маған көп көмектестің.
Dialogue: 0,0:16:25.24,0:16:27.33,Default,,0000,0000,0000,,Канна Пунч жеңілмейтін болды.
Dialogue: 0,0:16:29.64,0:16:30.48,Default,,0000,0000,0000,,Керемет болды
Dialogue: 0,0:16:31.83,0:16:33.34,Default,,0000,0000,0000,,Не қорқынышты?
Dialogue: 0,0:16:33.91,0:16:37.34,Default,,0000,0000,0000,,Сіз мені өткенді айту үшін шақырмаған шығарсыз.
Dialogue: 0,0:16:37.82,0:16:39.56,Default,,0000,0000,0000,,Дәлірек айтсақ, бұл қандай аяқтар?
Dialogue: 0,0:16:40.28,0:16:41.40,Default,,0000,0000,0000,,Кішкене ғана.
Dialogue: 0,0:16:43.52,0:16:45.27,Default,,0000,0000,0000,,талаптары қандай?
Dialogue: 0,0:16:47.09,0:16:48.80,Default,,0000,0000,0000,,Иә, солай
Dialogue: 0,0:16:52.26,0:16:54.64,Default,,0000,0000,0000,,Кайто-кун туралы ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:16:55.69,0:16:57.47,Default,,0000,0000,0000,,Өйткені мен оны қалай да түсінемін
Dialogue: 0,0:16:57.91,0:16:59.61,Default,,0000,0000,0000,,Себебі менде бәрі жақсы
Dialogue: 0,0:17:04.71,0:17:06.67,Default,,0000,0000,0000,,Басқа шаруам болмаса, үйге барамын.
Dialogue: 0,0:17:10.90,0:17:13.36,Default,,0000,0000,0000,,Мен сенің де, теңіздің де жағдайы жақсы болады деп үміттендім.
Dialogue: 0,0:17:13.98,0:17:16.27,Default,,0000,0000,0000,,Бірақ мен оны көргім келмеді.
Dialogue: 0,0:17:18.13,0:17:19.84,Default,,0000,0000,0000,,Кай мен Сенпай жақсы жүрсе
Dialogue: 0,0:17:20.39,0:17:21.86,Default,,0000,0000,0000,,Сіз еркін боласыз ба?
Dialogue: 0,0:17:22.70,0:17:24.24,Default,,0000,0000,0000,,Бұл қызықсыз деп үміттенемін
Dialogue: 0,0:17:24.76,0:17:26.75,Default,,0000,0000,0000,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:17:29.01,0:17:29.84,Default,,0000,0000,0000,,Тецуро
Dialogue: 0,0:17:31.05,0:17:34.21,Default,,0000,0000,0000,,Маған ұнайтын қыз, мені айналдырып, жылатыңыз
Dialogue: 0,0:17:35.08,0:17:36.55,Default,,0000,0000,0000,,Ештеңе істей алмайды
Dialogue: 0,0:17:37.84,0:17:40.37,Default,,0000,0000,0000,,Сізге ұнайтын адам
Dialogue: 0,0:17:42.88,0:17:44.42,Default,,0000,0000,0000,,Бұл өтірік.
Dialogue: 0,0:17:45.84,0:17:46.98,Default,,0000,0000,0000,,Шынайы
Dialogue: 0,0:17:49.10,0:17:49.87,Default,,0000,0000,0000,,Қашаннан бері
Dialogue: 0,0:17:50.94,0:17:52.15,Default,,0000,0000,0000,,Ұзақ уақыт бойы
Dialogue: 0,0:17:55.06,0:17:59.04,Default,,0000,0000,0000,,Менің басым мыжылған кезде
Dialogue: 0,0:17:59.19,0:18:01.35,Default,,0000,0000,0000,,Кенет не айтып тұрсың, ақымақ?
Dialogue: 0,0:18:01.80,0:18:04.26,Default,,0000,0000,0000,,Шынымен, дұрыс емес уақыт.
Dialogue: 0,0:18:05.63,0:18:08.26,Default,,0000,0000,0000,,Бірақ мен мұны айта алдым.
Dialogue: 0,0:18:09.88,0:18:11.09,Default,,0000,0000,0000,,Тецуро
Dialogue: 0,0:18:11.61,0:18:15.42,Default,,0000,0000,0000,,Мен сенің теңізді жақсы көретініңді білемін.
Dialogue: 0,0:18:15.94,0:18:16.41,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:17.03,0:18:18.68,Default,,0000,0000,0000,,Умиге Ичика-сенпай ұнаса да
Dialogue: 0,0:18:18.90,0:18:20.04,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:18:20.36,0:18:20.93,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:22.10,0:18:23.60,Default,,0000,0000,0000,,Сен маған ұнадың.
Dialogue: 0,0:18:25.61,0:18:26.53,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:18:26.91,0:18:28.74,Default,,0000,0000,0000,,Тек айтқыңыз келген нәрсені айтыңыз
Dialogue: 0,0:18:28.86,0:18:30.78,Default,,0000,0000,0000,,Қанағаттанған жүзімен.
Dialogue: 0,0:18:31.18,0:18:32.04,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:18:34.43,0:18:35.35,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:18:36.67,0:18:40.74,Default,,0000,0000,0000,,Ұстамаңыз. Канна жай ғана Канна болуы керек.
Dialogue: 0,0:18:43.93,0:18:47.36,Default,,0000,0000,0000,,Қыздың шашына абайсызда тиіспе.
Dialogue: 0,0:18:47.66,0:18:49.29,Default,,0000,0000,0000,,Айтпасаң да білемін
Dialogue: 0,0:18:51.31,0:18:52.02,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:19:05.70,0:19:06.95,Default,,0000,0000,0000,,Жылауға болмайды
Dialogue: 0,0:19:07.36,0:19:08.15,Default,,0000,0000,0000,,Жылама
Dialogue: 0,0:19:09.60,0:19:10.79,Default,,0000,0000,0000,,қыңырлық
Dialogue: 0,0:19:11.84,0:19:12.54,Default,,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:19:13.45,0:19:17.40,Default,,0000,0000,0000,,Менің айтайын дегенім, сіздің мұнда келуіңіз заңсыз.
Dialogue: 0,0:19:18.45,0:19:20.66,Default,,0000,0000,0000,,Қыздар күшті
Dialogue: 0,0:19:21.70,0:19:23.05,Default,,0000,0000,0000,,Сен мықтысың
Dialogue: 0,0:19:23.72,0:19:26.65,Default,,0000,0000,0000,,Сіз өзіңізге ұнайтын адам бола аласыз. Сіз күшті бола аласыз.
Dialogue: 0,0:19:27.47,0:19:30.43,Default,,0000,0000,0000,,Мен Тецуро-кунның арқасында өзгердім.
Dialogue: 0,0:19:31.07,0:19:34.05,Default,,0000,0000,0000,,Жарайды, ең болмаса өзгерейік.
Dialogue: 0,0:19:34.75,0:19:36.17,Default,,0000,0000,0000,,Күшті болайық
Dialogue: 0,0:19:36.49,0:19:37.95,Default,,0000,0000,0000,,Мен ойлана бастадым
Dialogue: 0,0:19:39.40,0:19:41.02,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:19:42.26,0:19:43.77,Default,,0000,0000,0000,,Тіпті бұл өзін
Dialogue: 0,0:19:51.95,0:19:53.05,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:19:53.82,0:19:54.51,Default,,0000,0000,0000,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:20:19.44,0:20:20.28,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:20:24.16,0:20:25.28,Default,,0000,0000,0000,,Таникава
Dialogue: 0,0:20:26.15,0:20:27.69,Default,,0000,0000,0000,,Сіз енді тоңып қалдыңыз ба?
Dialogue: 0,0:20:30.82,0:20:32.14,Default,,0000,0000,0000,,Қарбыз жейді
Dialogue: 0,0:20:36.54,0:20:37.91,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:20:40.99,0:20:41.66,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:20:42.31,0:20:43.67,Default,,0000,0000,0000,,Мен Кайто-кунды жақсы көремін
Dialogue: 0,0:20:43.98,0:20:45.61,Default,,0000,0000,0000,,Мен сені көптен бері жақсы көремін
Dialogue: 0,0:20:46.96,0:20:47.85,Default,,0000,0000,0000,,Мен сенің үмітіңді артамын
Dialogue: 0,0:20:50.85,0:20:51.75,Default,,0000,0000,0000,,Кешіріңіз, Танигава
Dialogue: 0,0:20:52.68,0:20:55.13,Default,,0000,0000,0000,,Мен ағамды жақсы көремін.
Dialogue: 0,0:20:55.87,0:20:57.12,Default,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:20:59.28,0:21:01.89,Default,,0000,0000,0000,,тыңдағандарыңызға рахмет.
Dialogue: 0,0:21:04.97,0:21:06.81,Default,,0000,0000,0000,,Кинода бар күшімізді салайық
Dialogue: 0,0:21:08.47,0:21:08.81,Default,,0000,0000,0000,,О
Dialogue: 0,0:21:09.82,0:21:14.44,Default,,0000,0000,0000,,Бұл дүниеде мәңгілік болмаса да
Dialogue: 0,0:21:17.33,0:21:18.22,Default,,0000,0000,0000,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:21:18.67,0:21:19.51,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:21:20.53,0:21:21.75,Default,,0000,0000,0000,,Камера OK
Dialogue: 0,0:21:21.90,0:21:23.12,Default,,0000,0000,0000,,Бұл да жақсы
Dialogue: 0,0:21:23.24,0:21:24.51,Default,,0000,0000,0000,,Дайын
Dialogue: 0,0:21:24.96,0:21:27.63,Default,,0000,0000,0000,,275-көрініс Жақсы
Dialogue: 0,0:21:28.14,0:21:28.77,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:29.93,0:21:31.42,Default,,0000,0000,0000,,Кешіріңіз Блэкман
Dialogue: 0,0:21:32.44,0:21:35.17,Default,,0000,0000,0000,,Бірақ мен әлі де осы планетада болғым келеді
Dialogue: 0,0:21:36.11,0:21:39.10,Default,,0000,0000,0000,,Өйткені бұл планетада маңызды нәрсе бар
Dialogue: 0,0:21:40.69,0:21:41.33,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:23:04.22,0:23:08.15,Default,,0000,0000,0000,,Лимон-сенпай бүгін кешке дейін суретке түсуімді айтты.
Dialogue: 0,0:23:09.04,0:23:11.31,Default,,0000,0000,0000,,Түсірілім қанша уақытта аяқталады деп ойлаймын.
Dialogue: 0,0:23:12.05,0:23:14.73,Default,,0000,0000,0000,,Жазғы демалыста бітеді деп ойлаймын.
Dialogue: 0,0:23:15.28,0:23:16.63,Default,,0000,0000,0000,,Тағы бір апта?
Dialogue: 0,0:23:26.49,0:23:27.21,Default,,0000,0000,0000,,Ичика
Dialogue: 0,0:23:28.08,0:23:30.82,Default,,0000,0000,0000,,Сен әлі тірісің, Ичика.
Dialogue: 0,0:23:30.99,0:23:33.53,Default,,0000,0000,0000,,Мен қаншалықты уайымдадым деп ойлайсыз?
Dialogue: 0,0:23:33.00,0:23:34.27,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:23:34.30,0:23:36.04,Default,,0000,0000,0000,,Ичика
Dialogue: 0,0:23:37.58,0:23:39.22,Default,,0000,0000,0000,,Үлкен апа
Dialogue: 0,0:23:40.91,0:23:42.37,Default,,0000,0000,0000,,Әпке, Жерге не үшін келдің?
Dialogue: 0,0:23:42.42,0:23:45.22,Default,,0000,0000,0000,,Міне. Бізге батасын беруге келгеніне сенімдімін.
Dialogue: 0,0:23:45.23,0:23:47.22,Default,,0000,0000,0000,,Жоқ, менің әпкем жылдам.
Dialogue: 0,0:23:47.34,0:23:48.54,Default,,0000,0000,0000,,Қызық, бұл рас па?
Dialogue: 0,0:11:03.20,0:11:05.94,Default,,0000,0000,0000,,Өз бетімен үйрендім
Dialogue: 0,0:23:33.00,0:23:34.27,Default,,0000,0000,0000,,Міне, марапат ретінде сүйіс. Мwah.
Dialogue: 0,0:01:29.74,0:01:32.94,Default,,0000,0000,0000,,Теңіз самалы жүзіңнен соғады
Dialogue: 0,0:01:33.71,0:01:36.83,Default,,0000,0000,0000,,Сіз үндемейсіз
Dialogue: 0,0:01:37.52,0:01:41.51,Default,,0000,0000,0000,,Іс жүзінде бұл профиль
Dialogue: 0,0:01:42.23,0:01:45.14,Default,,0000,0000,0000,,Мен оған қол тигізгім келеді
Dialogue: 0,0:01:45.25,0:01:48.54,Default,,0000,0000,0000,,Мен сені сүйіп тұрғандай болдым
Dialogue: 0,0:01:49.39,0:01:52.56,Default,,0000,0000,0000,,Бұл түсінде болды
Dialogue: 0,0:01:53.01,0:01:59.68,Default,,0000,0000,0000,,Жел шындықтың шекарасына тиеді
Dialogue: 0,0:02:01.24,0:02:08.15,Default,,0000,0000,0000,,Күнделікті өмір кездейсоқ сөздермен жарқырайды
Dialogue: 0,0:02:08.31,0:02:14.45,Default,,0000,0000,0000,,Бір күні көрген кино сияқты.
Dialogue: 0,0:02:15.44,0:02:19.14,Default,,0000,0000,0000,,Жыл мезгілдері келіп-кетсе де
Dialogue: 0,0:02:19.67,0:02:23.41,Default,,0000,0000,0000,,Бізді мәңгі күтеді
Dialogue: 0,0:02:23.49,0:02:30.66,Default,,0000,0000,0000,,Күйген пленка сияқты жаздың иісі
Dialogue: 0,0:02:30.97,0:02:34.89,Default,,0000,0000,0000,,Ешқашан өшпейтін алдын ала ескерту
Dialogue: 0,0:02:35.12,0:02:39.61,Default,,0000,0000,0000,,Мен қараған объективтен секіру
Dialogue: 0,0:02:39.93,0:02:45.04,Default,,0000,0000,0000,,Мен сенің қолыңнан ұстаймын
Dialogue: 0,0:01:29.74,0:01:32.94,Default,,0000,0000,0000,,Теңіз самалы
Dialogue: 0,0:01:34.18,0:01:36.83,Default,,0000,0000,0000,,Сізде сөз жоқ.
Dialogue: 0,0:01:37.52,0:01:41.51,Default,,0000,0000,0000,,Менің ойымша, дәл осылай.
Dialogue: 0,0:01:42.23,0:01:45.14,Default,,0000,0000,0000,,Үстелдің жағы
Dialogue: 0,0:01:45.25,0:01:48.54,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:49.39,0:01:52.56,Default,,0000,0000,0000,,Түсімде
Dialogue: 0,0:01:53.01,0:01:59.68,Default,,0000,0000,0000,,Теңіз желінің нақты әлемі
Dialogue: 0,0:02:01.57,0:02:08.15,Default,,0000,0000,0000,,Күтпеген сөз, әдеттен тыс күнделікті өмір
Dialogue: 0,0:02:08.31,0:02:14.45,Default,,0000,0000,0000,,Сурет дегеніміз не?
Dialogue: 0,0:02:15.44,0:02:19.14,Default,,0000,0000,0000,,Өкілді дереу ауыстыру
Dialogue: 0,0:02:19.67,0:02:23.41,Default,,0000,0000,0000,,Біз мәңгі бірге жұмыс істей береміз.
Dialogue: 0,0:02:23.49,0:02:30.66,Default,,0000,0000,0000,,...
Dialogue: 0,0:02:30.97,0:02:34.89,Default,,0000,0000,0000,,Қозу сезімінің жауапсыздығы
Dialogue: 0,0:02:35.12,0:02:39.61,Default,,0000,0000,0000,,Мөлдір айна
Dialogue: 0,0:02:39.93,0:02:45.04,Default,,0000,0000,0000,,Гайкай Коукен Сумина Тадате
Dialogue: 0,0:21:41.58,0:21:47.29,Default,,0000,0000,0000,,Саған ғашық болу үшін іздеген себебім
Dialogue: 0,0:21:47.39,0:21:54.35,Default,,0000,0000,0000,,Бұл ең қуанышты сөз деп айтылады.
Dialogue: 0,0:21:56.61,0:22:02.13,Default,,0000,0000,0000,,Мен мұны түсінгенде, жіптер дұрыс емес тураланған.
Dialogue: 0,0:22:02.59,0:22:09.99,Default,,0000,0000,0000,,Бір жақты түйін күшейе түсті.
Dialogue: 0,0:22:11.28,0:22:17.87,Default,,0000,0000,0000,,Ойланбай қашып кетсең
Dialogue: 0,0:22:18.65,0:22:23.69,Default,,0000,0000,0000,,Сіз мәңгілік өмір сүрмейсіз
Dialogue: 0,0:22:24.94,0:22:28.88,Default,,0000,0000,0000,,Бұлт пішінін пирсинг
Dialogue: 0,0:22:28.99,0:22:31.39,Default,,0000,0000,0000,,Ойлы серпін фильмі
Dialogue: 0,0:22:31.49,0:22:36.34,Default,,0000,0000,0000,,Ауада жаздың иісі аңқып тұрады
Dialogue: 0,0:22:36.40,0:22:39.91,Default,,0000,0000,0000,,Бұл менің есімде талай рет
Dialogue: 0,0:22:39.98,0:22:43.56,Default,,0000,0000,0000,,Тек сен маған берген ғажайып
Dialogue: 0,0:22:43.65,0:22:48.30,Default,,0000,0000,0000,,Душ сияқты түсіп кетіңіз
Dialogue: 0,0:22:48.40,0:22:56.02,Default,,0000,0000,0000,,Түсін шығарды.
Dialogue: 0,0:21:41.58,0:21:47.29,Default,,0000,0000,0000,,Адал болу қуанышының себебі
Dialogue: 0,0:21:47.39,0:21:54.35,Default,,0000,0000,0000,,Бұл сіздің ең ашық әңгімеңіз.
Dialogue: 0,0:21:56.61,0:22:02.13,Default,,0000,0000,0000,,Ниет жеткенде кенет қызыл сызық ашылады.
Dialogue: 0,0:22:02.59,0:22:09.99,Default,,0000,0000,0000,,...
Dialogue: 0,0:22:11.28,0:22:17.87,Default,,0000,0000,0000,,Оны оқудың қажеті болмаса, қашып құтыла аласыз
Dialogue: 0,0:22:18.65,0:22:23.69,Default,,0000,0000,0000,,...
Dialogue: 0,0:22:24.94,0:22:28.88,Default,,0000,0000,0000,,ену қабаты
Dialogue: 0,0:22:28.99,0:22:31.39,Default,,0000,0000,0000,,Ой қозғайтын бейне
Dialogue: 0,0:22:31.49,0:22:36.34,Default,,0000,0000,0000,,Жаз ортасының дәмі
Dialogue: 0,0:22:36.40,0:22:39.91,Default,,0000,0000,0000,,Шектеусіз өкінемін
Dialogue: 0,0:22:39.98,0:22:43.56,Default,,0000,0000,0000,,Мен үшін бұл жай ғана ғажайып
Dialogue: 0,0:22:43.65,0:22:48.30,Default,,0000,0000,0000,,...
Dialogue: 0,0:22:48.40,0:22:56.02,Default,,0000,0000,0000,,Түсімен әдемі ашылған
Dialogue: 0,0:23:50.04,0:23:56.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory