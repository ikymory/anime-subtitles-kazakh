Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:57.01,0:03:06.92,Default,,0000,0000,0000,,Бұл субтитр көзі коммерциялық пайдалануға тыйым салынған субтитрлер тобының өндірісі, жеткізу алмасуы болып табылады.
Dialogue: 0,0:02:57.01,0:03:06.92,Default,,0000,0000,0000,,: ： яя : Сюра :
Dialogue: 0,0:00:00.86,0:00:02.43,Default,,0000,0000,0000,,Сен тірі едің, Ичика.
Dialogue: 0,0:00:03.62,0:00:05.49,Default,,0000,0000,0000,,Мен сендім
Dialogue: 0,0:00:06.90,0:00:08.02,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:00:08.25,0:00:09.71,Default,,0000,0000,0000,,Еш жерде жарақаттар жоқ.
Dialogue: 0,0:00:09.89,0:00:11.78,Default,,0000,0000,0000,,Мен жарақат алған жоқпын.
Dialogue: 0,0:00:12.35,0:00:13.79,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:00:14.04,0:00:15.27,Default,,0000,0000,0000,,Ол мені көруге келді.
Dialogue: 0,0:00:15.31,0:00:16.31,Default,,0000,0000,0000,,Мен оны іздедім.
Dialogue: 0,0:00:16.54,0:00:18.23,Default,,0000,0000,0000,,Сіз жоғалып кеттіңіз
Dialogue: 0,0:00:18.32,0:00:20.39,Default,,0000,0000,0000,,Біз қаншалықты уайымдадық
Dialogue: 0,0:00:20.55,0:00:22.68,Default,,0000,0000,0000,,Сен неге жоқсың?
Dialogue: 0,0:00:23.15,0:00:26.34,Default,,0000,0000,0000,,Сіз төтенше жағдай сигналын жіберген болуыңыз керек.
Dialogue: 0,0:00:29.01,0:00:31.21,Default,,0000,0000,0000,,Бұл оқыс оқиға болды.
Dialogue: 0,0:00:31.28,0:00:35.52,Default,,0000,0000,0000,,Олай болса, құтқаруға барған ұшқышсыз боттың жауабы неге жоғалды?
Dialogue: 0,0:00:35.74,0:00:36.83,Default,,0000,0000,0000,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:00:37.32,0:00:38.25,Default,,0000,0000,0000,,Көп нәрсе бар
Dialogue: 0,0:00:38.54,0:00:39.13,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:00:40.24,0:00:41.97,Default,,0000,0000,0000,,Айя, мен жасадым.
Dialogue: 0,0:00:42.46,0:00:47.22,Default,,0000,0000,0000,,Сенпай Ичика қауіпті деп ойлады.
Dialogue: 0,0:00:48.12,0:00:48.90,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:00:50.15,0:00:51.66,Default,,0000,0000,0000,,Мен сені әпкеммен таныстырамын.
Dialogue: 0,0:00:52.22,0:00:55.20,Default,,0000,0000,0000,,Кайто Киришима, менің
Dialogue: 0,0:00:55.79,0:00:57.19,Default,,0000,0000,0000,,Жігіт?
Dialogue: 0,0:00:58.13,0:00:59.48,Default,,0000,0000,0000,,Сәлем, танысқаныма қуаныштымын.
Dialogue: 0,0:00:59.71,0:01:01.06,Default,,0000,0000,0000,,На на
Dialogue: 0,0:01:02.47,0:01:03.97,Default,,0000,0000,0000,,Не ойлап отырсың, Ичика?
Dialogue: 0,0:01:04.21,0:01:06.06,Default,,0000,0000,0000,,Жергілікті халықтармен байланысудан алыс
Dialogue: 0,0:01:06.12,0:01:07.66,Default,,0000,0000,0000,,Ғашық болу деген нені білдіреді?
Dialogue: 0,0:01:07.72,0:01:10.31,Default,,0000,0000,0000,,Сіз Федерация заңын түсінесіз. Мен түссіндім.
Dialogue: 0,0:01:10.60,0:01:13.50,Default,,0000,0000,0000,,Тіпті сіздің әпкеңіз де Кайтомен байланыста.
Dialogue: 0,0:01:13.56,0:01:14.63,Default,,0000,0000,0000,,Мен көмекке келдім
Dialogue: 0,0:01:14.68,0:01:15.75,Default,,0000,0000,0000,,Бұл төтенше жағдай.
Dialogue: 0,0:01:15.84,0:01:17.59,Default,,0000,0000,0000,,Мен де төтенше жағдайдамын.
Dialogue: 0,0:01:18.37,0:01:21.46,Default,,0000,0000,0000,,Сіздің ойыңызша, біздің отбасы қаншалықты алаңдады?
Dialogue: 0,0:01:21.87,0:01:24.63,Default,,0000,0000,0000,,Сіз өзіңіздің қазіргі жағдайыңыз туралы ештеңе түсінбейтін шығарсыз.
Dialogue: 0,0:01:24.70,0:01:27.07,Default,,0000,0000,0000,,Ауырды
Dialogue: 0,0:03:16.01,0:03:17.92,Default,,0000,0000,0000,,Лимон-сенпай, кеш болды.
Dialogue: 0,0:03:18.64,0:03:20.96,Default,,0000,0000,0000,,Мен болашақ оқиға туралы тым көп ойладым.
Dialogue: 0,0:03:21.52,0:03:23.08,Default,,0000,0000,0000,,Ичика мен Киришима-кун
Dialogue: 0,0:03:23.39,0:03:24.55,Default,,0000,0000,0000,,Ол әлі келген жоқ.
Dialogue: 0,0:03:25.01,0:03:27.39,Default,,0000,0000,0000,,Кездесу уақыты туралы қателескен сияқтымын.
Dialogue: 0,0:03:29.52,0:03:31.32,Default,,0000,0000,0000,,Танигава мырза, кешіріңіз.
Dialogue: 0,0:03:31.45,0:03:32.72,Default,,0000,0000,0000,,Барып көруге болады.
Dialogue: 0,0:03:35.59,0:03:37.98,Default,,0000,0000,0000,,Маған тағы да сәлем беруге рұқсат етіңіз.
Dialogue: 0,0:03:38.43,0:03:40.78,Default,,0000,0000,0000,,Бұл Ичиканың үлкен әпкесі Минацу Такизуки.
Dialogue: 0,0:03:41.37,0:03:42.99,Default,,0000,0000,0000,,Бұл Кайто Киришима.
Dialogue: 0,0:03:43.48,0:03:44.71,Default,,0000,0000,0000,,Киришима Кайто-кун.
Dialogue: 0,0:03:45.04,0:03:47.91,Default,,0000,0000,0000,,Ичиканы апаттан қорғағаныңыз үшін рахмет.
Dialogue: 0,0:03:48.58,0:03:49.68,Default,,0000,0000,0000,,Отбасы атынан
Dialogue: 0,0:03:49.98,0:03:51.08,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:03:51.43,0:03:52.72,Default,,0000,0000,0000,,A №
Dialogue: 0,0:03:53.06,0:03:54.84,Default,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:03:55.29,0:03:57.85,Default,,0000,0000,0000,,Мен Ичиканы үйге апарамын.
Dialogue: 0,0:03:58.63,0:03:59.61,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:04:00.03,0:04:02.44,Default,,0000,0000,0000,,Шалғай планетадан апат сигналы
Dialogue: 0,0:04:03.08,0:04:05.92,Default,,0000,0000,0000,,Құтқару үшін ұшқышсыз ботпен байланыстың жоғалуы
Dialogue: 0,0:04:06.45,0:04:09.52,Default,,0000,0000,0000,,Ичика Сіз қазір құрбан болудан алыссыз.
Dialogue: 0,0:04:09.68,0:04:11.38,Default,,0000,0000,0000,,Сіз із-түзсіз жоғалғандар тізіміндесіз бе?
Dialogue: 0,0:04:11.91,0:04:13.16,Default,,0000,0000,0000,,Мұны біз білетінбіз
Dialogue: 0,0:04:13.35,0:04:14.80,Default,,0000,0000,0000,,Мен сіздің қаншалықты уайымдағаныңызды көріп тұрмын.
Dialogue: 0,0:04:14.98,0:04:16.92,Default,,0000,0000,0000,,Менің туыстарым әбігерге түсті.
Dialogue: 0,0:04:17.81,0:04:19.90,Default,,0000,0000,0000,,Сондықтан мен жалақы алдым.
Dialogue: 0,0:04:19.97,0:04:21.65,Default,,0000,0000,0000,,Соңғы үлгідегі қайықты жалға алыңыз
Dialogue: 0,0:04:21.82,0:04:23.66,Default,,0000,0000,0000,,Мен сені іздеп келдім.
Dialogue: 0,0:04:23.89,0:04:25.01,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:04:25.43,0:04:26.72,Default,,0000,0000,0000,,Мен қатты уайымдасам да
Dialogue: 0,0:04:26.76,0:04:28.08,Default,,0000,0000,0000,,Ауа-райы жоқ жерде өмір сүруден алыс
Dialogue: 0,0:04:28.14,0:04:29.19,Default,,0000,0000,0000,,Тіпті жігіт тауып ал
Dialogue: 0,0:04:30.30,0:04:31.02,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:04:31.64,0:04:34.11,Default,,0000,0000,0000,,Менің ойымша, бұл соншалықты маңызды емес.
Dialogue: 0,0:04:35.00,0:04:37.10,Default,,0000,0000,0000,,Әй, анау әпке.
Dialogue: 0,0:04:38.84,0:04:40.40,Default,,0000,0000,0000,,Бұл жаман емес.
Dialogue: 0,0:04:40.93,0:04:43.28,Default,,0000,0000,0000,,Маған кіші бала осылай дейді.
Dialogue: 0,0:04:43.41,0:04:44.56,Default,,0000,0000,0000,,Өте жаңа
Dialogue: 0,0:04:45.05,0:04:48.37,Default,,0000,0000,0000,,Мен Ичиканың аман екенін білдім.
Dialogue: 0,0:04:48.89,0:04:50.20,Default,,0000,0000,0000,,Енді проблема жоқ, солай ма?
Dialogue: 0,0:04:50.46,0:04:51.67,Default,,0000,0000,0000,,Не болды саған? Біраз қақтығысқыш болып тұрсың ғой?
Dialogue: 0,0:04:52.14,0:04:53.92,Default,,0000,0000,0000,,Іздеу басталды.
Dialogue: 0,0:04:54.97,0:04:57.13,Default,,0000,0000,0000,,Бірақ егер сіз маған жақсы екенімді білдірсеңіз.
Dialogue: 0,0:04:57.59,0:04:58.86,Default,,0000,0000,0000,,Даму деңгейі F
Dialogue: 0,0:04:59.80,0:05:02.03,Default,,0000,0000,0000,,Жергілікті халықтармен байланысқа жол берілмейді
Dialogue: 0,0:05:02.38,0:05:04.52,Default,,0000,0000,0000,,Шалғай планетада жоғалған адам
Dialogue: 0,0:05:05.14,0:05:06.19,Default,,0000,0000,0000,,Егер федерация
Dialogue: 0,0:05:06.42,0:05:09.12,Default,,0000,0000,0000,,Жағдайды мүмкіндігінше тезірек тексергіңіз келеді.
Dialogue: 0,0:05:09.96,0:05:12.70,Default,,0000,0000,0000,,Мен сені тауып, не істеп жатқаныңды білсем
Dialogue: 0,0:05:12.83,0:05:14.40,Default,,0000,0000,0000,,Дереу қамауға алу және қамауға алу
Dialogue: 0,0:05:14.93,0:05:17.41,Default,,0000,0000,0000,,Сіз Федерация заңына сәйкес сотталатын боласыз.
Dialogue: 0,0:05:17.91,0:05:18.74,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:05:19.38,0:05:20.66,Default,,0000,0000,0000,,Бұл туралы ештеңе істей алмайсыз ба?
Dialogue: 0,0:05:21.32,0:05:22.66,Default,,0000,0000,0000,,Сол үшін келдім
Dialogue: 0,0:05:23.14,0:05:25.68,Default,,0000,0000,0000,,Ичика Істер тым үлкен болмай тұрып
Dialogue: 0,0:05:25.97,0:05:27.32,Default,,0000,0000,0000,,Менімен үйге кел
Dialogue: 0,0:05:28.27,0:05:28.95,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:05:30.03,0:05:30.61,Default,,0000,0000,0000,,Мен осындамын ғой?
Dialogue: 0,0:05:32.30,0:05:33.72,Default,,0000,0000,0000,,Мен Кайто-кунды тастамаймын.
Dialogue: 0,0:05:34.46,0:05:35.75,Default,,0000,0000,0000,,Ешқашан кетпеңіз
Dialogue: 0,0:05:36.22,0:05:37.24,Default,,0000,0000,0000,,Егер сіз қалсаңыз
Dialogue: 0,0:05:37.83,0:05:40.65,Default,,0000,0000,0000,,Бұл Киришима-кунға және осы планетаға қиындық тудырады.
Dialogue: 0,0:05:41.88,0:05:44.52,Default,,0000,0000,0000,,Мен қателескен жоқпын.
Dialogue: 0,0:05:45.27,0:05:46.69,Default,,0000,0000,0000,,Мәселе осы емес пе?
Dialogue: 0,0:05:46.76,0:05:48.32,Default,,0000,0000,0000,,Неге түсінбейсің?
Dialogue: 0,0:05:48.52,0:05:50.35,Default,,0000,0000,0000,,Сенпай, сабыр ет.
Dialogue: 0,0:05:51.06,0:05:52.79,Default,,0000,0000,0000,,Әпкеңді мұқият тыңда.
Dialogue: 0,0:05:53.17,0:05:53.86,Default,,0000,0000,0000,,Мен не істеуім керек...
Dialogue: 0,0:05:53.91,0:05:55.35,Default,,0000,0000,0000,,Мен ештеңе істей алмаймын.
Dialogue: 0,0:05:56.38,0:05:59.14,Default,,0000,0000,0000,,Ичика, сен түсінесің.
Dialogue: 0,0:06:06.72,0:06:07.31,Default,,0000,0000,0000,,Ринон
Dialogue: 0,0:06:07.39,0:06:08.15,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:06:09.70,0:06:10.55,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:06:11.56,0:06:13.08,Default,,0000,0000,0000,,Кешіріңіз, Киришима-кун.
Dialogue: 0,0:06:14.30,0:06:16.61,Default,,0000,0000,0000,,Мен жөнсіз нәрсені көрсеттім.
Dialogue: 0,0:06:18.62,0:06:19.10,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:06:23.74,0:06:25.86,Default,,0000,0000,0000,,Такидзуки Сенпай
Dialogue: 0,0:06:27.87,0:06:30.99,Default,,0000,0000,0000,,Танигава мырза
Dialogue: 0,0:06:31.99,0:06:33.36,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:33.83,0:06:37.88,Default,,0000,0000,0000,,Түсіру уақыты өтіп кетті.
Dialogue: 0,0:06:39.20,0:06:41.09,Default,,0000,0000,0000,,Сен неге аяқ киім кимейсің?
Dialogue: 0,0:06:43.28,0:06:44.10,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:06:45.64,0:06:47.01,Default,,0000,0000,0000,,Ол қатты жараланған еді...
Dialogue: 0,0:06:47.83,0:06:49.50,Default,,0000,0000,0000,,А №
Dialogue: 0,0:06:50.54,0:06:51.43,Default,,0000,0000,0000,,Ичика-сан
Dialogue: 0,0:06:52.23,0:06:54.83,Default,,0000,0000,0000,,Сізге шынымен үйге бару керек пе?
Dialogue: 0,0:06:55.21,0:06:56.10,Default,,0000,0000,0000,,№.
Dialogue: 0,0:06:56.53,0:06:59.53,Default,,0000,0000,0000,,Бір рет қайтып, осында тағы келесің бе?
Dialogue: 0,0:06:59.81,0:07:02.64,Default,,0000,0000,0000,,Жағдайды ескерсек, бұл қиын болар еді.
Dialogue: 0,0:07:04.53,0:07:05.22,Default,,0000,0000,0000,,Өзің бар
Dialogue: 0,0:07:06.29,0:07:09.38,Default,,0000,0000,0000,,Олай болса, мені ғарышқа өзіңізбен бірге алып кете аласыз ба?
Dialogue: 0,0:07:09.70,0:07:11.31,Default,,0000,0000,0000,,Мен бәрін істеймін
Dialogue: 0,0:07:13.58,0:07:15.71,Default,,0000,0000,0000,,Сондай дөрекі, қыңыр бала.
Dialogue: 0,0:07:16.16,0:07:17.18,Default,,0000,0000,0000,,Бұл шынымен жақсы ма?
Dialogue: 0,0:07:17.53,0:07:18.07,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:22.00,0:07:24.97,Default,,0000,0000,0000,,Орындарды сәл ауыстырайық па?
Dialogue: 0,0:07:26.25,0:07:27.92,Default,,0000,0000,0000,,Үйге барасыз ба?
Dialogue: 0,0:07:28.69,0:07:30.90,Default,,0000,0000,0000,,Менің іздеуім басталып кетті
Dialogue: 0,0:07:31.79,0:07:33.96,Default,,0000,0000,0000,,Ол оңай қашып кететін адам емес.
Dialogue: 0,0:07:35.42,0:07:37.38,Default,,0000,0000,0000,,Ол талқылауға жауап бермейді деп ойлаймын.
Dialogue: 0,0:07:37.76,0:07:39.17,Default,,0000,0000,0000,,Сіз көмектесе алмайсыз ба?
Dialogue: 0,0:07:40.19,0:07:40.88,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:42.98,0:07:44.52,Default,,0000,0000,0000,,Егер сіз өзіңізді қалуға мәжбүрлесеңіз
Dialogue: 0,0:07:44.79,0:07:46.43,Default,,0000,0000,0000,,Қиын болатынына сенімдімін
Dialogue: 0,0:07:50.26,0:07:51.43,Default,,0000,0000,0000,,Сонымен, мен
Dialogue: 0,0:07:51.85,0:07:52.88,Default,,0000,0000,0000,,Сіз барасыз ба?
Dialogue: 0,0:07:54.36,0:07:57.24,Default,,0000,0000,0000,,Мен Кайтоны тастап, ғарышқа барамын.
Dialogue: 0,0:07:57.99,0:08:00.77,Default,,0000,0000,0000,,Бірақ мен енді ештеңе істей алмаймын
Dialogue: 0,0:08:00.82,0:08:03.43,Default,,0000,0000,0000,,Сіз жақсы көретін адамыңызбен бірге болудан бас тартасыз.
Dialogue: 0,0:08:05.45,0:08:07.98,Default,,0000,0000,0000,,Өзіңізді оңай тапсыратындай сезінесіз
Dialogue: 0,0:08:08.23,0:08:11.71,Default,,0000,0000,0000,,Сіз Кайтомен осындай сезіммен шықтыңыз ба?
Dialogue: 0,0:08:12.43,0:08:15.24,Default,,0000,0000,0000,,Мен өзімді қалай сезінемін
Dialogue: 0,0:08:16.66,0:08:17.38,Default,,0000,0000,0000,,Танигава мырза
Dialogue: 0,0:08:17.58,0:08:18.92,Default,,0000,0000,0000,,Қалағаныңды істесең
Dialogue: 0,0:08:19.04,0:08:20.91,Default,,0000,0000,0000,,Өзіңіз жақсы көретін адамыңызды тастап, бас тартыңыз.
Dialogue: 0,0:08:21.23,0:08:22.93,Default,,0000,0000,0000,,Ғарышқа немесе басқасына барыңыз
Dialogue: 0,0:08:29.51,0:08:32.12,Default,,0000,0000,0000,,Бұл планета жақсы жер.
Dialogue: 0,0:08:32.94,0:08:34.39,Default,,0000,0000,0000,,Қаншама табиғат қалды
Dialogue: 0,0:08:35.17,0:08:37.17,Default,,0000,0000,0000,,Менің жұлдызымнан мүлдем басқаша болса да
Dialogue: 0,0:08:37.28,0:08:38.63,Default,,0000,0000,0000,,Қандай да бір сағыныш сезімін тудырады.
Dialogue: 0,0:08:39.80,0:08:41.97,Default,,0000,0000,0000,,Ичика да осыны айтты.
Dialogue: 0,0:08:43.00,0:08:45.39,Default,,0000,0000,0000,,Бейненің сіздің басыңыздағы орны
Dialogue: 0,0:08:45.78,0:08:46.94,Default,,0000,0000,0000,,Бұл планетада
Dialogue: 0,0:08:48.05,0:08:49.95,Default,,0000,0000,0000,,Сондықтан мен бұл планетаға келдім
Dialogue: 0,0:08:50.41,0:08:53.70,Default,,0000,0000,0000,,Ол бейне менде де бар.
Dialogue: 0,0:08:53.94,0:08:54.36,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:54.71,0:08:56.67,Default,,0000,0000,0000,,Мүмкін, бірақ
Dialogue: 0,0:08:57.74,0:08:59.27,Default,,0000,0000,0000,,Ичика және менің ата-бабаларым
Dialogue: 0,0:08:59.53,0:09:02.04,Default,,0000,0000,0000,,Сонымен, сіз бұл суретті генетикалық деректеріңізге енгіздіңіз бе?
Dialogue: 0,0:09:02.64,0:09:05.07,Default,,0000,0000,0000,,Біз оны мұра еттік.
Dialogue: 0,0:09:05.79,0:09:07.22,Default,,0000,0000,0000,,Неге олай істедің?
Dialogue: 0,0:09:07.48,0:09:08.13,Default,,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:09:08.65,0:09:11.21,Default,,0000,0000,0000,,Қызық, ол ата-бабаңнан қалған қазынаға толы ма?
Dialogue: 0,0:09:12.08,0:09:14.04,Default,,0000,0000,0000,,Маған бұл маңызды емес.
Dialogue: 0,0:09:14.67,0:09:18.22,Default,,0000,0000,0000,,Ичика ол суретті үнемі өзімен бірге алып жүрген болуы мүмкін.
Dialogue: 0,0:09:19.74,0:09:21.13,Default,,0000,0000,0000,,Ичиканы іздегенде
Dialogue: 0,0:09:21.53,0:09:23.49,Default,,0000,0000,0000,,Мен бүкіл планетаны сканерлеуге тырыстым.
Dialogue: 0,0:09:23.89,0:09:27.15,Default,,0000,0000,0000,,Мен суретке сәйкес келетін орынды таба алмадым.
Dialogue: 0,0:09:28.68,0:09:29.16,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:09:29.21,0:09:31.62,Default,,0000,0000,0000,,Біз ғарышқа бірге барғымыз келетінін айттық.
Dialogue: 0,0:09:32.59,0:09:36.52,Default,,0000,0000,0000,,Біз F деңгейінің тұрғындарын ғарышқа шығара алмаймыз.
Dialogue: 0,0:09:37.48,0:09:41.43,Default,,0000,0000,0000,,Бұл планетаның адамдары жұлдыздар арасында саяхаттауға жеткілікті технологияға ие болды.
Dialogue: 0,0:09:41.96,0:09:45.24,Default,,0000,0000,0000,,Бізбен байланысып, Галактика федерациясына қосылыңыз
Dialogue: 0,0:09:45.93,0:09:49.11,Default,,0000,0000,0000,,Сонда ғана Киришиманың тілегі орындалады.
Dialogue: 0,0:09:50.55,0:09:51.35,Default,,0000,0000,0000,,Оған дейін
Dialogue: 0,0:09:51.82,0:09:53.39,Default,,0000,0000,0000,,Осы планетаның стандартты уақытында
Dialogue: 0,0:09:53.69,0:09:55.95,Default,,0000,0000,0000,,Оған жүздеген жылдар керек еді.
Dialogue: 0,0:09:56.82,0:09:59.73,Default,,0000,0000,0000,,Балама қандай?
Dialogue: 0,0:10:00.15,0:10:02.66,Default,,0000,0000,0000,,Федерация туралы заңға түзетулер енгізілмесе
Dialogue: 0,0:10:02.73,0:10:03.46,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:10:05.79,0:10:07.33,Default,,0000,0000,0000,,Рахмет, Киришима-кун
Dialogue: 0,0:10:07.68,0:10:10.16,Default,,0000,0000,0000,,Ичика туралы көп ойлағаныңыз үшін рахмет.
Dialogue: 0,0:10:12.33,0:10:16.75,Default,,0000,0000,0000,,Бірақ мен Ичиканы үйге апарамын.
Dialogue: 0,0:10:18.34,0:10:21.21,Default,,0000,0000,0000,,Бұл балаға арналған.
Dialogue: 0,0:10:27.89,0:10:30.33,Default,,0000,0000,0000,,Мына қыздың жігіті бар ма еді?
Dialogue: 0,0:10:32.29,0:10:33.88,Default,,0000,0000,0000,,Мен сені алып кетуге келсем де
Dialogue: 0,0:10:34.55,0:10:36.19,Default,,0000,0000,0000,,Бұл біршама қолайсыз рөл.
Dialogue: 0,0:10:37.60,0:10:40.61,Default,,0000,0000,0000,,Ол Ичика Такизукидің үлкен әпкесі.
Dialogue: 0,0:10:42.15,0:10:42.84,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:10:50.18,0:10:51.99,Default,,0000,0000,0000,,Канна қайтып келмейді.
Dialogue: 0,0:10:52.37,0:10:54.63,Default,,0000,0000,0000,,Лимон-сенпай да бір жерге барады.
Dialogue: 0,0:10:54.83,0:10:57.61,Default,,0000,0000,0000,,Теңіздер не істейді?
Dialogue: 0,0:10:57.96,0:11:00.84,Default,,0000,0000,0000,,Сіз фотоға түсуді ұмытып, менімен сырласып жатқаныңызға сенімдімін.
Dialogue: 0,0:11:01.91,0:11:04.02,Default,,0000,0000,0000,,Менің жолым аз
Dialogue: 0,0:11:07.80,0:11:08.67,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:11:09.27,0:11:10.22,Default,,0000,0000,0000,,Не болды, мырза Мокки!
Dialogue: 0,0:11:11.11,0:11:12.10,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:11:13.19,0:11:13.94,Default,,0000,0000,0000,,Канна
Dialogue: 0,0:11:14.44,0:11:15.85,Default,,0000,0000,0000,,Теңіздер
Dialogue: 0,0:11:15.98,0:11:16.65,Default,,0000,0000,0000,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:11:20.97,0:11:22.32,Default,,0000,0000,0000,,Не болды, Канна?
Dialogue: 0,0:11:22.59,0:11:24.55,Default,,0000,0000,0000,,Такизуки-сенпайдың ғарышқа ұшатынын естідім.
Dialogue: 0,0:11:24.75,0:11:25.99,Default,,0000,0000,0000,,Мен біреудің мені алып кетуге келе жатқанын естідім.
Dialogue: 0,0:11:26.77,0:11:27.85,Default,,0000,0000,0000,,Жағдайлар бар.
Dialogue: 0,0:11:28.03,0:11:29.23,Default,,0000,0000,0000,,Мен ештеңе істей алмаймын
Dialogue: 0,0:11:29.50,0:11:30.94,Default,,0000,0000,0000,,Сонымен фильм түсіру аяқталды.
Dialogue: 0,0:11:31.07,0:11:32.80,Default,,0000,0000,0000,,Бұл жерде тұрғаннан пайда жоқ, үйге қайтайық.
Dialogue: 0,0:11:33.20,0:11:34.54,Default,,0000,0000,0000,,Эй, сәл күте тұршы, Канна.
Dialogue: 0,0:11:34.69,0:11:35.18,Default,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:11:35.46,0:11:39.07,Default,,0000,0000,0000,,Такизуки-сенпай шынымен ғарышқа ұшқысы келе ме?
Dialogue: 0,0:11:39.71,0:11:40.58,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:11:41.11,0:11:42.57,Default,,0000,0000,0000,,Теңізге не болады?
Dialogue: 0,0:11:45.48,0:11:46.45,Default,,0000,0000,0000,,Эй, досым! Эй, досым!
Dialogue: 0,0:11:47.10,0:11:49.39,Default,,0000,0000,0000,,Менің ағам теңізді тастап кетіп қалды.
Dialogue: 0,0:11:49.95,0:11:51.13,Default,,0000,0000,0000,,Оны осылай қалдыру дұрыс па?
Dialogue: 0,0:11:51.47,0:11:53.33,Default,,0000,0000,0000,,Бұл шынымен Каннаға жарай ма?
Dialogue: 0,0:11:54.48,0:11:55.40,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:11:57.76,0:11:59.00,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:12:03.87,0:12:05.46,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:12:24.40,0:12:27.68,Default,,0000,0000,0000,,Мен дәл қазір әпкеңмен сөйлестім.
Dialogue: 0,0:12:28.65,0:12:30.43,Default,,0000,0000,0000,,Мен сені ғарышқа апаруыңды сұрағанымда
Dialogue: 0,0:12:31.04,0:12:32.17,Default,,0000,0000,0000,,Маған бас тартылды.
Dialogue: 0,0:12:33.08,0:12:35.24,Default,,0000,0000,0000,,Мен бас тартпаймын.
Dialogue: 0,0:12:35.81,0:12:37.40,Default,,0000,0000,0000,,Қарт адамдармен қалай болу керек
Dialogue: 0,0:12:38.25,0:12:41.30,Default,,0000,0000,0000,,Мен, Танигава-сан маған ашуланды.
Dialogue: 0,0:12:41.55,0:12:43.01,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:13:02.95,0:13:04.69,Default,,0000,0000,0000,,Сенпай, мүмкін емес.
Dialogue: 0,0:13:05.24,0:13:07.67,Default,,0000,0000,0000,,Ринон, мені секірт
Dialogue: 0,0:13:08.43,0:13:08.85,Default,,0000,0000,0000,,Сенпай
Dialogue: 0,0:13:08.88,0:13:09.54,Default,,0000,0000,0000,,Ханым
Dialogue: 0,0:13:11.78,0:13:14.35,Default,,0000,0000,0000,,Сенпай, бас тартуға әлі ерте емес пе?
Dialogue: 0,0:13:16.04,0:13:16.74,Default,,0000,0000,0000,,Тецуро
Dialogue: 0,0:13:17.04,0:13:18.24,Default,,0000,0000,0000,,Китахара мырза да
Dialogue: 0,0:13:18.68,0:13:19.88,Default,,0000,0000,0000,,Мен мән-жайды естідім.
Dialogue: 0,0:13:20.06,0:13:21.16,Default,,0000,0000,0000,,Сол үшін келдім
Dialogue: 0,0:13:21.63,0:13:23.43,Default,,0000,0000,0000,,Мені жалғыз қалдырмаңыз
Dialogue: 0,0:13:26.59,0:13:28.30,Default,,0000,0000,0000,,Бұл мәселе, солай емес пе?
Dialogue: 0,0:13:28.46,0:13:31.20,Default,,0000,0000,0000,,Такизуки-сенпай жоғалып кетсе, мен кино түсіре алмаймын.
Dialogue: 0,0:13:32.11,0:13:32.93,Default,,0000,0000,0000,,Танигава мырза
Dialogue: 0,0:13:33.35,0:13:36.14,Default,,0000,0000,0000,,Мен Такацуки-сенпайдың осында болғанын қалаймын.
Dialogue: 0,0:13:36.28,0:13:36.84,Default,,0000,0000,0000,,Жоспар
Dialogue: 0,0:13:37.07,0:13:38.19,Default,,0000,0000,0000,,Бір қолымда оқталған винтовка ұстап
Dialogue: 0,0:13:38.43,0:13:40.70,Default,,0000,0000,0000,,Киришима-кун осында.
Dialogue: 0,0:13:41.26,0:13:41.77,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:13:42.05,0:13:43.20,Default,,0000,0000,0000,,Маған шындықты айт
Dialogue: 0,0:13:43.69,0:13:45.87,Default,,0000,0000,0000,,Сіз шынымен не істегіңіз келеді?
Dialogue: 0,0:13:53.12,0:13:54.08,Default,,0000,0000,0000,,Менің барғым келмейді
Dialogue: 0,0:13:55.06,0:13:56.14,Default,,0000,0000,0000,,Шынымен бе!? Иә
Dialogue: 0,0:13:57.12,0:13:58.08,Default,,0000,0000,0000,,Мен кеткім келмейді
Dialogue: 0,0:13:59.27,0:14:01.73,Default,,0000,0000,0000,,Маған Кайто-кун ұнайды.
Dialogue: 0,0:14:02.74,0:14:03.67,Default,,0000,0000,0000,,Маған да ұнайды
Dialogue: 0,0:14:05.75,0:14:06.64,Default,,0000,0000,0000,,Мен сенімен бірге болғым келеді
Dialogue: 0,0:14:07.11,0:14:09.29,Default,,0000,0000,0000,,Ғаламды өзіңе жау етіп алудың мәні жоқ.
Dialogue: 0,0:14:09.80,0:14:10.60,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:14:11.67,0:14:13.36,Default,,0000,0000,0000,,Содан кейін орындаңыз.
Dialogue: 0,0:14:16.19,0:14:16.78,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:14:17.99,0:14:19.00,Default,,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:14:19.14,0:14:19.85,Default,,0000,0000,0000,,Сіз қашып барасыз ба?
Dialogue: 0,0:14:19.98,0:14:21.48,Default,,0000,0000,0000,,Бір жерге тығылу
Dialogue: 0,0:14:22.23,0:14:23.49,Default,,0000,0000,0000,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:14:23.82,0:14:25.29,Default,,0000,0000,0000,,Сіз қиындыққа тап болған сияқтысыз.
Dialogue: 0,0:14:27.56,0:14:28.28,Default,,0000,0000,0000,,Лимон
Dialogue: 0,0:14:29.15,0:14:32.41,Default,,0000,0000,0000,,Менің сендерге жақсы жаңалығым бар.
Dialogue: 0,0:14:35.89,0:14:37.37,Default,,0000,0000,0000,,Үлкендер Жерде қала алады
Dialogue: 0,0:14:37.81,0:14:41.06,Default,,0000,0000,0000,,Иә, мүмкіндігі өте төмен болса да.
Dialogue: 0,0:14:41.62,0:14:43.05,Default,,0000,0000,0000,,Бірақ бұл нөл емес.
Dialogue: 0,0:14:43.68,0:14:44.71,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:14:45.27,0:14:50.97,Default,,0000,0000,0000,,Ичика Сіз өз басыңыздағы бейненің орнын іздедіңіз ғой, солай ма?
Dialogue: 0,0:14:51.21,0:14:51.68,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:14:51.94,0:14:52.87,Default,,0000,0000,0000,,Егер
Dialogue: 0,0:14:53.41,0:14:58.33,Default,,0000,0000,0000,,Бұл жерге жат планеталықтар бұрын да келген болуы мүмкін бе?
Dialogue: 0,0:14:58.54,0:15:01.89,Default,,0000,0000,0000,,Бірақ бұл менің бейнем ғана.
Dialogue: 0,0:15:06.26,0:15:07.94,Default,,0000,0000,0000,,Менің үлкен апам осылай деді
Dialogue: 0,0:15:08.46,0:15:11.47,Default,,0000,0000,0000,,Менде де үлкендер сияқты декорация бейнесі бар.
Dialogue: 0,0:15:12.08,0:15:14.73,Default,,0000,0000,0000,,Бірақ жер бетінде мұндай жер жоқ.
Dialogue: 0,0:15:15.29,0:15:17.63,Default,,0000,0000,0000,,Жадыңызға сурет қалдыру
Dialogue: 0,0:15:17.72,0:15:19.08,Default,,0000,0000,0000,,Сіз егжей-тегжейлі бірдеңе жасадыңыз.
Dialogue: 0,0:15:19.76,0:15:20.67,Default,,0000,0000,0000,,Сол жерде
Dialogue: 0,0:15:20.90,0:15:24.97,Default,,0000,0000,0000,,Ичика технологиясы анықтай алмайтын құрылғы орнатылған болуы мүмкін.
Dialogue: 0,0:15:25.35,0:15:26.73,Default,,0000,0000,0000,,Мен оны қарастырамын.
Dialogue: 0,0:15:27.27,0:15:30.99,Default,,0000,0000,0000,,Жер картасы бойынша Ичика зерттеген мәліметтерді салыстырайық.
Dialogue: 0,0:15:31.43,0:15:34.66,Default,,0000,0000,0000,,Мен картада деректері жоқ жерлер болғанын көремін.
Dialogue: 0,0:15:35.03,0:15:35.57,Default,,0000,0000,0000,,Онда
Dialogue: 0,0:15:35.97,0:15:38.36,Default,,0000,0000,0000,,Лимон Мұны қалай жасадыңыз?
Dialogue: 0,0:15:38.89,0:15:40.92,Default,,0000,0000,0000,,Маған кеңес берген адам бар ма?
Dialogue: 0,0:15:41.23,0:15:42.22,Default,,0000,0000,0000,,Бұл дегеніміз…
Dialogue: 0,0:15:45.72,0:15:46.53,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:15:47.55,0:15:49.84,Default,,0000,0000,0000,,Мен өзімшіл болдым
Dialogue: 0,0:15:50.15,0:15:52.81,Default,,0000,0000,0000,,Достарыңа риза бол, Ичика.
Dialogue: 0,0:15:53.89,0:15:55.86,Default,,0000,0000,0000,,Бізде уақыт жоқ. Асығыңыз.
Dialogue: 0,0:15:56.09,0:15:56.44,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:15:58.19,0:15:59.48,Default,,0000,0000,0000,,Орын тап
Dialogue: 0,0:15:59.65,0:16:02.71,Default,,0000,0000,0000,,Жер тұрғындары мен жат планеталықтар арасында байланыс іздері болса
Dialogue: 0,0:16:03.13,0:16:05.75,Default,,0000,0000,0000,,Жер енді F деңгейлі ашық планета болмайды.
Dialogue: 0,0:16:06.41,0:16:08.93,Default,,0000,0000,0000,,Іздеу тобы келгенше тауып алсақ
Dialogue: 0,0:16:09.45,0:16:13.71,Default,,0000,0000,0000,,Сенпай: Сіздің суретіңіздегі декорацияны Жапониямен шектегеніңіз дұрыс емес пе?
Dialogue: 0,0:16:14.15,0:16:17.52,Default,,0000,0000,0000,,Иә, ішіндегі өсімдіктердің мекендеу ортасына негізделген.
Dialogue: 0,0:16:17.73,0:16:19.52,Default,,0000,0000,0000,,Шиншумен шектелу керек деп ойлаймын.
Dialogue: 0,0:16:20.30,0:16:21.43,Default,,0000,0000,0000,,Оны міндетті түрде іздеңіз
Dialogue: 0,0:16:21.89,0:16:22.51,Default,,0000,0000,0000,,О
Dialogue: 0,0:16:26.43,0:16:28.16,Default,,0000,0000,0000,,Бірдеңе келе жатыр
Dialogue: 0,0:16:28.70,0:16:30.32,Default,,0000,0000,0000,,Оң жақтан
Dialogue: 0,0:16:30.43,0:16:31.69,Default,,0000,0000,0000,,Уми, сен де ұйықта.
Dialogue: 0,0:16:32.59,0:16:35.39,Default,,0000,0000,0000,,Бірақ менің үлкен ағам мені алып кетуге қашан келеді?
Dialogue: 0,0:16:36.49,0:16:38.88,Default,,0000,0000,0000,,Олай болса мен саған ұйқыдан ояну үшін жақсы нәрсе айтайын.
Dialogue: 0,0:16:39.47,0:16:40.11,Default,,0000,0000,0000,,Жақсы нәрсе
Dialogue: 0,0:16:40.66,0:16:42.14,Default,,0000,0000,0000,,Мен Каннаға өткен күні айттым.
Dialogue: 0,0:16:42.32,0:16:44.45,Default,,0000,0000,0000,,Өтірік не істеп жатырсың?
Dialogue: 0,0:16:45.13,0:16:46.99,Default,,0000,0000,0000,,Мен нәтижені білдім.
Dialogue: 0,0:16:47.33,0:16:50.57,Default,,0000,0000,0000,,Сондықтан маған Танигава туралы айттыңыз.
Dialogue: 0,0:16:51.23,0:16:54.74,Default,,0000,0000,0000,,Мен өзім туралы тым көп ойладым.
Dialogue: 0,0:16:55.40,0:16:57.78,Default,,0000,0000,0000,,Сондықтан мен бұлай болғанын қаламаймын.
Dialogue: 0,0:16:59.08,0:16:59.63,Default,,0000,0000,0000,,Тецуро
Dialogue: 0,0:17:00.40,0:17:02.63,Default,,0000,0000,0000,,Кейінірек Окинаваға барғанымда.
Dialogue: 0,0:17:02.74,0:17:03.63,Default,,0000,0000,0000,,Мио айтып берді
Dialogue: 0,0:17:04.15,0:17:04.68,Default,,0000,0000,0000,,Ә... ә... білесің бе...
Dialogue: 0,0:17:04.97,0:17:05.62,Default,,0000,0000,0000,,Ә... ә... білесің бе...
Dialogue: 0,0:17:08.36,0:17:11.19,Default,,0000,0000,0000,,Мен мектепті бітіргеннен кейін ештеңе істемедім.
Dialogue: 0,0:17:11.77,0:17:13.69,Default,,0000,0000,0000,,Егер сіз бірдеңе жасағыңыз келсе
Dialogue: 0,0:17:14.30,0:17:16.07,Default,,0000,0000,0000,,Көп нәрсе болды.
Dialogue: 0,0:17:16.36,0:17:18.18,Default,,0000,0000,0000,,Әсіресе үлкен ағам келген соң.
Dialogue: 0,0:17:19.07,0:17:20.62,Default,,0000,0000,0000,,Биылғы жаз керемет
Dialogue: 0,0:17:21.30,0:17:21.82,Default,,0000,0000,0000,,О
Dialogue: 0,0:17:22.12,0:17:24.62,Default,,0000,0000,0000,,Өйткені, бұл кеңістік.
Dialogue: 0,0:17:26.72,0:17:28.40,Default,,0000,0000,0000,,Менің қолымнан келетіні осы
Dialogue: 0,0:17:29.60,0:17:31.71,Default,,0000,0000,0000,,Сіз оны таба аласыз деп үміттенемін, Ичика.
Dialogue: 0,0:17:32.69,0:17:33.70,Default,,0000,0000,0000,,Сіздің орналасқан жеріңіз
Dialogue: 0,0:17:35.45,0:17:36.04,Default,,0000,0000,0000,,Болашақ бұл
Dialogue: 0,0:17:44.62,0:17:45.49,Default,,0000,0000,0000,,Мен мұны білмей тұрып
Dialogue: 0,0:17:45.84,0:17:47.46,Default,,0000,0000,0000,,Сіз ұзағырақ ұйықтай аласыз.
Dialogue: 0,0:17:48.67,0:17:50.14,Default,,0000,0000,0000,,Өйткені біз де ояндық.
Dialogue: 0,0:17:51.22,0:17:53.47,Default,,0000,0000,0000,,Бірдеңе болса, менің тіземе жатып ұйықта.
Dialogue: 0,0:17:53.58,0:17:55.15,Default,,0000,0000,0000,,Е, жоқ.
Dialogue: 0,0:17:55.36,0:17:57.14,Default,,0000,0000,0000,,Сен неге ғашықсың?
Dialogue: 0,0:17:58.31,0:17:59.36,Default,,0000,0000,0000,,Бұл емес
Dialogue: 0,0:17:59.74,0:18:01.05,Default,,0000,0000,0000,,Иә, олай емес.
Dialogue: 0,0:18:02.22,0:18:02.73,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:18:03.22,0:18:05.21,Default,,0000,0000,0000,,Мен таптым.
Dialogue: 0,0:18:05.35,0:18:06.97,Default,,0000,0000,0000,,Белгіленбеген орындар
Dialogue: 0,0:18:09.49,0:18:10.20,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:18:10.26,0:18:10.79,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:13.31,0:18:14.71,Default,,0000,0000,0000,,Ичика мен сені естимін.
Dialogue: 0,0:18:14.97,0:18:15.72,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:18:15.76,0:18:17.59,Default,,0000,0000,0000,,Іздеу тобы планетаның жанында.
Dialogue: 0,0:18:18.24,0:18:20.21,Default,,0000,0000,0000,,Сол жерден тез
Dialogue: 0,0:18:20.93,0:18:21.92,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:18:22.17,0:18:22.63,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:18:23.86,0:18:26.88,Default,,0000,0000,0000,,Ринон, тезірек бізді алдыңғы нүктеге секір.
Dialogue: 0,0:18:33.59,0:18:34.19,Default,,0000,0000,0000,,Ринон
Dialogue: 0,0:18:34.62,0:18:35.57,Default,,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:18:39.30,0:18:42.11,Default,,0000,0000,0000,,Мұндай байланыс антифилді
Dialogue: 0,0:18:42.88,0:18:45.24,Default,,0000,0000,0000,,Ол планеталық деңгейде таралған.
Dialogue: 0,0:18:46.50,0:18:47.44,Default,,0000,0000,0000,,Тарату мүмкін емес
Dialogue: 0,0:18:47.53,0:18:50.06,Default,,0000,0000,0000,,Мен не істеуім керек? Пойызбен барсам да үш сағат кетеді.
Dialogue: 0,0:18:50.20,0:18:51.33,Default,,0000,0000,0000,,Меніңше, қуғыншылар келе жатыр.
Dialogue: 0,0:18:51.44,0:18:52.54,Default,,0000,0000,0000,,Асығу керек
Dialogue: 0,0:18:56.89,0:18:57.73,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:18:58.25,0:18:58.83,Default,,0000,0000,0000,,Ұшқышсыз
Dialogue: 0,0:18:59.21,0:18:59.93,Default,,0000,0000,0000,,Мен едім!
Dialogue: 0,0:19:00.94,0:19:01.95,Default,,0000,0000,0000,,Лимон Сенпай
Dialogue: 0,0:19:05.97,0:19:10.44,Default,,0000,0000,0000,,Осындай жағдай орын алған жағдайда көлігімнің дайын болғанына қуаныштымын.
Dialogue: 0,0:19:10.65,0:19:12.38,Default,,0000,0000,0000,,Сенпай, лицензияң бар ма?
Dialogue: 0,0:19:12.54,0:19:13.89,Default,,0000,0000,0000,,Иә, дәл солай.
Dialogue: 0,0:19:14.35,0:19:16.71,Default,,0000,0000,0000,,Сізді алып кетуге қандай адам келеді?
Dialogue: 0,0:19:16.94,0:19:20.26,Default,,0000,0000,0000,,Менің ойымша, бұл бұрынғыдай құтқару боты шығар.
Dialogue: 0,0:19:20.38,0:19:20.99,Default,,0000,0000,0000,,Ичика
Dialogue: 0,0:19:21.11,0:19:24.77,Default,,0000,0000,0000,,Екінші тарап сіздің биометриялық деректеріңізді сканерлейді және сізді қадағалайды, солай ма?
Dialogue: 0,0:19:25.06,0:19:26.93,Default,,0000,0000,0000,,Иә, бірақ неге?
Dialogue: 0,0:19:27.92,0:19:28.91,Default,,0000,0000,0000,,Мынаны киіңіз
Dialogue: 0,0:19:29.41,0:19:32.34,Default,,0000,0000,0000,,Бұл сіз шығаратын биологиялық реакцияларды азайтады.
Dialogue: 0,0:19:33.04,0:19:33.64,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:19:35.05,0:19:35.94,Default,,0000,0000,0000,,Бұл құрылғы
Dialogue: 0,0:19:36.57,0:19:40.99,Default,,0000,0000,0000,,Коммутаторды қосқанда, ол Ичика сияқты биометриялық деректерді жібереді.
Dialogue: 0,0:19:41.18,0:19:41.91,Default,,0000,0000,0000,,Лимон
Dialogue: 0,0:19:42.30,0:19:43.54,Default,,0000,0000,0000,,Мүмкін бұл да шығар
Dialogue: 0,0:19:43.92,0:19:47.45,Default,,0000,0000,0000,,Иә, сенің апаң маған көмектесті.
Dialogue: 0,0:19:49.04,0:19:49.84,Default,,0000,0000,0000,,Әпке
Dialogue: 0,0:19:50.40,0:19:52.97,Default,,0000,0000,0000,,Жарайды, баратын жеріңізге қарай жүріңіз.
Dialogue: 0,0:19:58.61,0:20:00.70,Default,,0000,0000,0000,,ги сықырлау
Dialogue: 0,0:20:01.18,0:20:01.77,Default,,0000,0000,0000,,Жарайды, мен қазір кетейін
Dialogue: 0,0:20:09.70,0:20:10.36,Default,,0000,0000,0000,,Қуғыншы
Dialogue: 0,0:20:10.47,0:20:11.03,Default,,0000,0000,0000,,Қайта кел
Dialogue: 0,0:20:11.41,0:20:12.65,Default,,0000,0000,0000,,Исигаки мырза
Dialogue: 0,0:20:15.90,0:20:16.52,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:20:16.70,0:20:17.34,Default,,0000,0000,0000,,Мен де
Dialogue: 0,0:20:17.91,0:20:18.89,Default,,0000,0000,0000,,Тоқтат! Сол жерде тоқта!
Dialogue: 0,0:20:19.06,0:20:19.39,Default,,0000,0000,0000,,Мио
Dialogue: 0,0:20:19.88,0:20:21.19,Default,,0000,0000,0000,,Маған рұқсат етіңіз
Dialogue: 0,0:20:31.48,0:20:32.21,Default,,0000,0000,0000,,Тецуро
Dialogue: 0,0:20:32.84,0:20:34.70,Default,,0000,0000,0000,,Теңізге жетуді ұмытпаңыз
Dialogue: 0,0:20:34.90,0:20:35.79,Default,,0000,0000,0000,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:20:39.09,0:20:40.02,Default,,0000,0000,0000,,Mio ауыстырғышы
Dialogue: 0,0:20:40.58,0:20:41.12,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:20:44.91,0:20:47.34,Default,,0000,0000,0000,,Қара, қара, кел, кел, кел.
Dialogue: 0,0:20:48.84,0:20:49.76,Default,,0000,0000,0000,,Бинго
Dialogue: 0,0:20:50.41,0:20:51.70,Default,,0000,0000,0000,,Тецуро
Dialogue: 0,0:20:52.51,0:20:53.01,Default,,0000,0000,0000,,Мио
Dialogue: 0,0:20:53.22,0:20:53.98,Default,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:20:54.27,0:20:56.03,Default,,0000,0000,0000,,Келесі жолы киноға бармаймын.
Dialogue: 0,0:20:57.61,0:21:00.02,Default,,0000,0000,0000,,Канна мен теңізбен, екеуміз ғана
Dialogue: 0,0:21:00.16,0:21:02.01,Default,,0000,0000,0000,,Иә, барыңыз
Dialogue: 0,0:21:09.76,0:21:10.55,Default,,0000,0000,0000,,Лимон Сенпай
Dialogue: 0,0:21:10.76,0:21:12.13,Default,,0000,0000,0000,,75-жолды енгізіңіз
Dialogue: 0,0:21:12.70,0:21:15.44,Default,,0000,0000,0000,,10 км-ден сәл астам қалды
Dialogue: 0,0:21:15.96,0:21:16.68,Default,,0000,0000,0000,,Артқа
Dialogue: 0,0:21:17.97,0:21:18.86,Default,,0000,0000,0000,,Әлі де бар
Dialogue: 0,0:21:21.17,0:21:22.27,Default,,0000,0000,0000,,Мен түсіп жатырмын
Dialogue: 0,0:21:22.58,0:21:23.32,Default,,0000,0000,0000,,Танигава мырза
Dialogue: 0,0:21:23.54,0:21:25.46,Default,,0000,0000,0000,,Мен мұны үлкендер үшін істеп жатқан жоқпын.
Dialogue: 0,0:21:25.71,0:21:27.61,Default,,0000,0000,0000,,Мен мұны жақсы көретін адамым үшін жасаймын.
Dialogue: 0,0:21:28.61,0:21:30.37,Default,,0000,0000,0000,,Мен жақсы көретін адамға
Dialogue: 0,0:21:31.05,0:21:32.39,Default,,0000,0000,0000,,Себебі мен сенің күлгеніңді қалаймын
Dialogue: 0,0:21:34.04,0:21:35.49,Default,,0000,0000,0000,,Таникава
Dialogue: 0,0:21:36.12,0:21:40.15,Default,,0000,0000,0000,,Үш жылдан кейін мен сені өлгенше өкінемін.
Dialogue: 0,0:21:45.65,0:21:48.82,Default,,0000,0000,0000,,Бақытты бол, ақымақ
Dialogue: 0,0:21:50.30,0:21:52.29,Default,,0000,0000,0000,,Қуғыншылар жоқ сияқты.
Dialogue: 0,0:21:52.85,0:21:53.69,Default,,0000,0000,0000,,Киришима-кун
Dialogue: 0,0:21:54.12,0:21:54.73,Default,,0000,0000,0000,,Ууух!
Dialogue: 0,0:21:57.32,0:21:58.14,Default,,0000,0000,0000,,Менің камерам
Dialogue: 0,0:21:58.86,0:21:59.83,Default,,0000,0000,0000,,Сіз не істейсіз?
Dialogue: 0,0:22:00.03,0:22:01.11,Default,,0000,0000,0000,,Ол қазірдің өзінде шешілді.
Dialogue: 0,0:22:01.34,0:22:02.50,Default,,0000,0000,0000,,Мен суретке түсейін деп жатырмын.
Dialogue: 0,0:22:03.59,0:22:07.31,Default,,0000,0000,0000,,Батыр қыз жаудың шабуылынан қашып, баратын жеріне қарай бет алады.
Dialogue: 0,0:22:07.83,0:22:09.75,Default,,0000,0000,0000,,Менің ойымша, біз тамаша шарықтау шегін түсіре аламыз.
Dialogue: 0,0:22:11.15,0:22:13.58,Default,,0000,0000,0000,,Ал эпилогты Құдайға қалдырыңыз
Dialogue: 0,0:22:14.10,0:22:17.04,Default,,0000,0000,0000,,Бұл фильм түсірудің нағыз қызығы да.
Dialogue: 0,0:22:17.63,0:22:18.68,Default,,0000,0000,0000,,Дайындық дұрыс
Dialogue: 0,0:22:19.03,0:22:20.69,Default,,0000,0000,0000,,Жақсы бастама
Dialogue: 0,0:22:36.32,0:22:37.35,Default,,0000,0000,0000,,Кушакуне
Dialogue: 0,0:22:42.19,0:22:44.04,Default,,0000,0000,0000,,Бұл қандай көлік?
Dialogue: 0,0:23:41.10,0:23:42.66,Default,,0000,0000,0000,,Біз міндетті түрде ұмытпаймыз
Dialogue: 0,0:23:43.02,0:23:45.24,Default,,0000,0000,0000,,Барлығымен бірге ерекше жаз өтті
Dialogue: 0,0:23:45.78,0:23:47.13,Default,,0000,0000,0000,,Қанша уақыт өтсе де
Dialogue: 0,0:23:47.44,0:23:49.90,Default,,0000,0000,0000,,Біз сол жазда күтеміз
Dialogue: 0,0:14:32.23,0:14:34.98,Default,,0000,0000,0000,,Гакушю қажетсіз жүгіру
Dialogue: 0,0:01:35.86,0:01:39.06,Default,,0000,0000,0000,,Теңіз самалы жүзіңнен соғады
Dialogue: 0,0:01:39.83,0:01:42.95,Default,,0000,0000,0000,,Сіз үндемейсіз
Dialogue: 0,0:01:43.64,0:01:47.63,Default,,0000,0000,0000,,Іс жүзінде бұл профиль
Dialogue: 0,0:01:48.35,0:01:51.26,Default,,0000,0000,0000,,Мен оған қол тигізгім келеді
Dialogue: 0,0:01:51.37,0:01:54.66,Default,,0000,0000,0000,,Мен сені сүйіп тұрғандай болдым
Dialogue: 0,0:01:55.51,0:01:58.68,Default,,0000,0000,0000,,Бұл түсінде болды
Dialogue: 0,0:01:59.13,0:02:05.80,Default,,0000,0000,0000,,Жел шындықтың шекарасына тиеді
Dialogue: 0,0:02:07.36,0:02:14.27,Default,,0000,0000,0000,,Күнделікті өмір кездейсоқ сөздермен жарқырайды
Dialogue: 0,0:02:14.43,0:02:20.57,Default,,0000,0000,0000,,Бір күні көрген кино сияқты.
Dialogue: 0,0:02:21.56,0:02:25.26,Default,,0000,0000,0000,,Жыл мезгілдері келіп-кетсе де
Dialogue: 0,0:02:25.79,0:02:29.53,Default,,0000,0000,0000,,Бізді мәңгі күту
Dialogue: 0,0:02:29.61,0:02:36.78,Default,,0000,0000,0000,,Күйген пленка сияқты жаздың иісі
Dialogue: 0,0:02:37.09,0:02:41.01,Default,,0000,0000,0000,,Ешқашан кетпейтін алдын ала ескерту
Dialogue: 0,0:02:41.24,0:02:45.73,Default,,0000,0000,0000,,Қараған объективтің үстінен секіріңіз
Dialogue: 0,0:02:46.05,0:02:51.16,Default,,0000,0000,0000,,Мен сенің қолыңнан ұстаймын
Dialogue: 0,0:01:35.86,0:01:39.06,Default,,0000,0000,0000,,Теңіз самалы
Dialogue: 0,0:01:40.30,0:01:42.95,Default,,0000,0000,0000,,Сізде сөз жоқ.
Dialogue: 0,0:01:43.64,0:01:47.63,Default,,0000,0000,0000,,Менің ойымша, дәл осылай.
Dialogue: 0,0:01:48.35,0:01:51.26,Default,,0000,0000,0000,,Үстелдің жағы
Dialogue: 0,0:01:51.37,0:01:54.66,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:55.51,0:01:58.68,Default,,0000,0000,0000,,Түсінде жатқан түсте
Dialogue: 0,0:01:59.13,0:02:05.80,Default,,0000,0000,0000,,Теңіз желінің нақты әлемі
Dialogue: 0,0:02:07.69,0:02:14.27,Default,,0000,0000,0000,,Күтпеген сөз, күтпеген күнделікті өмір
Dialogue: 0,0:02:14.43,0:02:20.57,Default,,0000,0000,0000,,Сурет дегеніміз не?
Dialogue: 0,0:02:21.56,0:02:25.26,Default,,0000,0000,0000,,Өкілді дереу ауыстыру
Dialogue: 0,0:02:25.79,0:02:29.53,Default,,0000,0000,0000,,Біз мәңгі бірге жұмыс істей береміз.
Dialogue: 0,0:02:29.61,0:02:36.78,Default,,0000,0000,0000,,...
Dialogue: 0,0:02:37.09,0:02:41.01,Default,,0000,0000,0000,,Жауапсыз қозу сезімі
Dialogue: 0,0:02:41.24,0:02:45.73,Default,,0000,0000,0000,,Мөлдір айна
Dialogue: 0,0:02:46.05,0:02:51.16,Default,,0000,0000,0000,,Гайкай Коукен Сумина Тадате
Dialogue: 0,0:22:25.00,0:22:30.71,Default,,0000,0000,0000,,Саған ғашық болу үшін іздеген себебім
Dialogue: 0,0:22:30.81,0:22:37.77,Default,,0000,0000,0000,,Бұл ең қуанышты сөз деп айтылады.
Dialogue: 0,0:22:40.03,0:22:45.55,Default,,0000,0000,0000,,Мен мұны түсінгенде, жіптер дұрыс емес тураланған.
Dialogue: 0,0:22:46.01,0:22:53.41,Default,,0000,0000,0000,,Бір жақты түйін күшейе түсті.
Dialogue: 0,0:22:54.70,0:23:01.29,Default,,0000,0000,0000,,Еш ойланбай, қаш
Dialogue: 0,0:23:02.07,0:23:07.11,Default,,0000,0000,0000,,Сіз мәңгілік емессіз
Dialogue: 0,0:23:08.36,0:23:12.30,Default,,0000,0000,0000,,Бұлт пішінін пирсинг
Dialogue: 0,0:23:12.41,0:23:14.81,Default,,0000,0000,0000,,Ойлы серпін фильмі
Dialogue: 0,0:23:14.91,0:23:19.76,Default,,0000,0000,0000,,Жаз ортасының иісімен
Dialogue: 0,0:23:19.82,0:23:23.33,Default,,0000,0000,0000,,Бұл менің есімде талай рет
Dialogue: 0,0:23:23.40,0:23:26.98,Default,,0000,0000,0000,,Тек сен маған берген ғажайып
Dialogue: 0,0:23:27.07,0:23:31.72,Default,,0000,0000,0000,,Душ сияқты
Dialogue: 0,0:23:31.82,0:23:39.44,Default,,0000,0000,0000,,Ол түсті шығарды.
Dialogue: 0,0:22:25.00,0:22:30.71,Default,,0000,0000,0000,,Адал болу қуанышының себебі
Dialogue: 0,0:22:30.81,0:22:37.77,Default,,0000,0000,0000,,Бұл сіздің ең ашық әңгімеңіз.
Dialogue: 0,0:22:40.03,0:22:45.55,Default,,0000,0000,0000,,Ниет жеткенде кенет қызыл сызық ашылады.
Dialogue: 0,0:22:46.01,0:22:53.41,Default,,0000,0000,0000,,Оңтүстік және терең ойлар
Dialogue: 0,0:22:54.70,0:23:01.29,Default,,0000,0000,0000,,Оған назар аударудың қажеті жоқ.
Dialogue: 0,0:23:02.07,0:23:07.11,Default,,0000,0000,0000,,Накагидің мәңгілік өмірі
Dialogue: 0,0:23:08.36,0:23:12.30,Default,,0000,0000,0000,,ену қабаты
Dialogue: 0,0:23:12.41,0:23:14.81,Default,,0000,0000,0000,,Ой қозғайтын бейне
Dialogue: 0,0:23:14.91,0:23:19.76,Default,,0000,0000,0000,,Жаз ортасының дәмі
Dialogue: 0,0:23:19.82,0:23:23.33,Default,,0000,0000,0000,,Болашақта шексіз еске алу үшін тіркелу
Dialogue: 0,0:23:23.40,0:23:26.98,Default,,0000,0000,0000,,Сенде ғана керемет бар
Dialogue: 0,0:23:27.07,0:23:31.72,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:31.82,0:23:39.44,Default,,0000,0000,0000,,Түсімен әдемі ашылған
Dialogue: 0,0:23:51.40,0:23:57.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
