Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.42,0:00:12.34,Default,,0,0,0,,Сіз қайтадан қоқыс жинадыңыз ба?
Dialogue: 0,0:00:19.85,0:00:22.17,Default,,0,0,0,,Күн қатты салқындап барады.
Dialogue: 0,0:00:25.23,0:00:27.35,Default,,0,0,0,,Кешіріңіз, мен ештеңе істей алмаймын.
Dialogue: 0,0:00:31.39,0:00:33.13,Default,,0,0,0,,Сіз әлі барасыз ба?
Dialogue: 0,0:00:35.43,0:00:37.21,Default,,0,0,0,,Мен сенің қасымда болғаныңды қалаймын
Dialogue: 0,0:00:41.22,0:00:44.05,Default,,0,0,0,,Ей, мәңгілік жаныңда болайық
Dialogue: 0,0:00:45.75,0:00:49.01,Default,,0,0,0,,Сондықтан мен кетуім керек
Dialogue: 0,0:00:50.73,0:00:54.41,Default,,0,0,0,,Енді біз мәңгі бірге болуымыз үшін
Dialogue: 0,0:01:15.85,0:01:21.29,Default,,0,0,0,,Сен ғана өткен төбеден түсіп келе жатқанда
Dialogue: 0,0:01:21.43,0:01:26.86,Default,,0,0,0,,Көптеген жылы күн бассейндері пайда болды.
Dialogue: 0,0:01:26.99,0:01:32.14,Default,,0,0,0,,Мен ғана мейірімдімін.
Dialogue: 0,0:01:32.28,0:01:39.44,Default,,0,0,0,,Жылылықты еске түсіру
Dialogue: 0,0:01:39.90,0:01:47.74,Default,,0,0,0,,Тек сен, тек сен
Dialogue: 0,0:01:47.74,0:01:53.59,Default,,0,0,0,,Мен сені сүйдім
Dialogue: 0,0:01:53.73,0:02:01.41,Default,,0,0,0,,Жел көзімді бұлдыратады
Dialogue: 0,0:02:01.53,0:02:08.03,Default,,0,0,0,,Ол алыс болады
Dialogue: 0,0:02:08.32,0:02:10.84,Default,,0,0,0,,Мен сені мәңгі есте сақтаймын
Dialogue: 0,0:02:10.44,0:02:12.86,Default,,0,0,0,,Бәрі өзгерсе де
Dialogue: 0,0:02:12.46,0:02:14.92,Default,,0,0,0,,Бір ғана Бір ғана
Dialogue: 0,0:02:14.52,0:02:17.61,Default,,0,0,0,,Қарапайым болса да
Dialogue: 0,0:02:17.21,0:02:21.82,Default,,0,0,0,,Мен сендерге жарқыраған бір нәрсені көрсетемін
Dialogue: 0,0:02:21.32,0:02:26.63,Default,,0,0,0,,Мен сені мәңгілікке қорғаймын.
Dialogue: 0,0:02:30.26,0:02:32.97,Default,,0,0,0,,Томоя-кун, сен ештеңе ұмыттың ба?
Dialogue: 0,0:02:33.29,0:02:34.60,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:36.84,0:02:38.82,Default,,0,0,0,,Шио-чан, қоштасу.
Dialogue: 0,0:02:40.68,0:02:41.60,Default,,0,0,0,,I'm going
Dialogue: 0,0:02:42.77,0:02:44.02,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:02:44.78,0:02:46.10,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:02:55.96,0:02:58.76,Default,,0,0,0,,Күндізгі Нагиса Санаэ-санмен бірге жүреді
Dialogue: 0,0:03:00.26,0:03:01.89,Default,,0,0,0,,Қарттар да жүздерін жиі көрсетеді.
Dialogue: 0,0:03:03.13,0:03:05.28,Default,,0,0,0,,Нагиса Ушионы аман-есен дүниеге әкелсін
Dialogue: 0,0:03:05.61,0:03:08.05,Default,,0,0,0,,Әркім қолынан келгеннің бәрін жасайды
Dialogue: 0,0:03:09.24,0:03:11.11,Default,,0,0,0,,Нағиса ертең кездескенше.
Dialogue: 0,0:03:11.20,0:03:13.03,Default,,0,0,0,,Иә, ертең кездескенше.
Dialogue: 0,0:03:16.91,0:03:20.62,Default,,0,0,0,,Санаэ-санның маған өкпесі бар шығар.
Dialogue: 0,0:03:20.88,0:03:22.31,Default,,0,0,0,,Менің ойланатын нәрсем бар
Dialogue: 0,0:03:24.30,0:03:25.74,Default,,0,0,0,,Менімен кездеспесеңіз
Dialogue: 0,0:03:25.74,0:03:29.70,Default,,0,0,0,,Нағисаға қауіп төніп тұрған босануға тура келмеді.
Dialogue: 0,0:03:30.48,0:03:32.49,Default,,0,0,0,,Мен Нағисаны ауыстырдым.
Dialogue: 0,0:03:33.63,0:03:37.62,Default,,0,0,0,,Мен оны алғаш көргенде ол шынымен әлсіз болып көрінді.
Dialogue: 0,0:03:38.11,0:03:39.50,Default,,0,0,0,,Егер мен сені шақырмасам
Dialogue: 0,0:03:39.96,0:03:43.01,Default,,0,0,0,,Мен өзімді бүкіл уақыт бойы төбенің түбінде тұрғандай сезіндім.
Dialogue: 0,0:03:44.19,0:03:46.51,Default,,0,0,0,,Мен бекер болдым.
Dialogue: 0,0:03:47.59,0:03:50.42,Default,,0,0,0,,Ол менімен кездескеннен кейін күшейе түсті.
Dialogue: 0,0:03:51.05,0:03:53.66,Default,,0,0,0,,Оның арқасында мен де күшейдім.
Dialogue: 0,0:03:55.04,0:03:56.75,Default,,0,0,0,,Дұрыс, Томоя-сан.
Dialogue: 0,0:03:57.25,0:04:00.87,Default,,0,0,0,,Мен және Акио-сан Томоя-санға қаншалықты ризамыз...
Dialogue: 0,0:04:00.87,0:04:02.98,Default,,0,0,0,,Бірақ мен түсінбеймін.
Dialogue: 0,0:04:03.38,0:04:06.60,Default,,0,0,0,,Мен болмасам, ол әлі үйде болар еді
Dialogue: 0,0:04:06.98,0:04:10.93,Default,,0,0,0,,Достарым көп болмаса да, бақытты болар едім.
Dialogue: 0,0:04:11.49,0:04:14.32,Default,,0,0,0,,Олай болмаса, менен жақсырақ кездесермін.
Dialogue: 0,0:04:14.52,0:04:16.40,Default,,0,0,0,,Бақытты болуы мүмкін еді
Dialogue: 0,0:04:16.43,0:04:19.38,Default,,0,0,0,,Мен бұл туралы ойлай алмаймын, Томоя-сан.
Dialogue: 0,0:04:20.23,0:04:22.27,Default,,0,0,0,,Санаэ-сан мейірімді адам.
Dialogue: 0,0:04:22.44,0:04:25.58,Default,,0,0,0,,Мен сенің бұлай айтатыныңды білдім, бірақ...
Dialogue: 0,0:04:25.97,0:04:27.33,Default,,0,0,0,,Мен мұны айтқым келеді.
Dialogue: 0,0:04:28.54,0:04:32.34,Default,,0,0,0,,Кешіріңіз, мен аздап бүліндім.
Dialogue: 0,0:04:38.92,0:04:40.77,Default,,0,0,0,,Мен жұмысты жалғастырдым.
Dialogue: 0,0:04:42.07,0:04:43.63,Default,,0,0,0,,Ұша алатын машина
Dialogue: 0,0:04:44.39,0:04:48.69,Default,,0,0,0,,Мен оны және мені осы жерден алып кететін машина құрастырамын.
Dialogue: 0,0:05:05.16,0:05:06.93,Default,,0,0,0,,Рождество жақындап қалды
Dialogue: 0,0:05:08.68,0:05:11.03,Default,,0,0,0,,Бұл сенің де туған күнің.
Dialogue: 0,0:05:11.52,0:05:12.73,Default,,0,0,0,,Осы жылы нені қалайсыз?
Dialogue: 0,0:05:12.82,0:05:14.49,Default,,0,0,0,,Данго үлкен отбасы
Dialogue: 0,0:05:15.57,0:05:18.36,Default,,0,0,0,,Бұдан артық қосудың қажеті жоқ.
Dialogue: 0,0:05:19.00,0:05:20.93,Default,,0,0,0,,Олардың көпшілігі енді еш жерде сатылмайды.
Dialogue: 0,0:05:21.48,0:05:22.97,Default,,0,0,0,,Бұл қиын ба?
Dialogue: 0,0:05:23.06,0:05:24.33,Default,,0,0,0,,Біріншіден, бұл мүмкін емес.
Dialogue: 0,0:05:24.76,0:05:26.30,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:35.26,0:05:37.60,Default,,0,0,0,,Бірақ сіз оны жақсы таптыңыз.
Dialogue: 0,0:05:37.94,0:05:40.97,Default,,0,0,0,,Томоя-кун, сен мені табу үшін көп жұмыс істедің.
Dialogue: 0,0:05:41.04,0:05:44.29,Default,,0,0,0,,Оны жылына бір көбейтуге қалай болады?
Dialogue: 0,0:05:44.79,0:05:47.46,Default,,0,0,0,,Ақыр соңында бізде үлкен отбасы болады.
Dialogue: 0,0:05:47.52,0:05:50.36,Default,,0,0,0,,Меніңше, қызғаншақ қариялар шығар.
Dialogue: 0,0:05:52.03,0:05:54.86,Default,,0,0,0,,Бірақ мен үшеуін бірден ұстай алмаймын.
Dialogue: 0,0:05:54.94,0:05:57.52,Default,,0,0,0,,Сондықтан мен Томояның мені ұстағанын қалаймын.
Dialogue: 0,0:05:57.77,0:05:58.61,Default,,0,0,0,,Мен?
Dialogue: 0,0:05:59.02,0:06:01.16,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:06:03.12,0:06:05.52,Default,,0,0,0,,Томоя-кун сондай сүйкімді
Dialogue: 0,0:06:11.16,0:06:13.78,Default,,0,0,0,,Жағажайдың иісі
Dialogue: 0,0:06:24.04,0:06:25.48,Default,,0,0,0,,Әй, біраз уақыт болды!
Dialogue: 0,0:06:25.81,0:06:26.81,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:06:26.81,0:06:29.51,Default,,0,0,0,,Сіз, бізде өткен сәуірде бірдей алмасу болды.
Dialogue: 0,0:06:30.94,0:06:34.36,Default,,0,0,0,,Жаңа жылыңызбен, Сунохара мырза
Dialogue: 0,0:06:35.28,0:06:37.49,Default,,0,0,0,,Нагиса-чан, біраз болды...
Dialogue: 0,0:06:39.75,0:06:41.15,Default,,0,0,0,,Ол үлкенірек болады.
Dialogue: 0,0:06:41.16,0:06:42.91,Default,,0,0,0,,Бұл аздап ұят.
Dialogue: 0,0:06:45.13,0:06:46.62,Default,,0,0,0,,Біртүрлі сезіледі
Dialogue: 0,0:06:49.11,0:06:50.27,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:06:50.67,0:06:53.01,Default,,0,0,0,,Сезімсіз нәрсе істеп жатырсыз ба?
Dialogue: 0,0:06:54.48,0:06:57.76,Default,,0,0,0,,Қоғам мүшесі болғаннан кейін де мінез-құлық үлгісі өзгеріссіз қалады.
Dialogue: 0,0:06:57.88,0:07:00.63,Default,,0,0,0,,Әпке, менің ойымша, сіз басқа адамдар туралы айта алмайсыз.
Dialogue: 0,0:07:00.67,0:07:03.21,Default,,0,0,0,,Анзу Фудзибаяши, келдің бе?
Dialogue: 0,0:07:03.51,0:07:05.81,Default,,0,0,0,,Жаңа жыл құтты болсын
Dialogue: 0,0:07:06.22,0:07:09.92,Default,,0,0,0,,Мен де Америкадан оралдым.
Dialogue: 0,0:07:10.39,0:07:14.11,Default,,0,0,0,,Баршаңызды Жаңа жылыңызбен!
Dialogue: 0,0:07:14.55,0:07:17.93,Default,,0,0,0,,Жаңа жылыңызбен Котоми-чан
Dialogue: 0,0:07:20.58,0:07:21.93,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:07:21.99,0:07:22.71,Default,,0,0,0,,Иә
Dialogue: 0,0:07:23.23,0:07:24.37,Default,,0,0,0,,Мен оны ұстай аламын ба?
Dialogue: 0,0:07:24.73,0:07:25.75,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:07:28.07,0:07:30.41,Default,,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:07:31.92,0:07:33.44,Default,,0,0,0,,Иә, менде!
Dialogue: 0,0:07:33.74,0:07:35.12,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:07:35.63,0:07:36.66,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:41.99,0:07:43.77,Default,,0,0,0,,Бұл Томойоның отбасы ма?
Dialogue: 0,0:07:44.34,0:07:46.21,Default,,0,0,0,,Менің інім де жақсы сияқты.
Dialogue: 0,0:07:46.93,0:07:51.36,Default,,0,0,0,,Миязава мырза да осында. Барлығы жақсы араласатын сияқты.
Dialogue: 0,0:07:51.86,0:07:54.52,Default,,0,0,0,,Бұл Нишина және Сугисака мырзалар.
Dialogue: 0,0:07:54.61,0:07:57.92,Default,,0,0,0,,Өтінемін дені сау бала туыңыз дейді.
Dialogue: 0,0:07:58.50,0:07:59.67,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:08:03.12,0:08:04.90,Default,,0,0,0,,Мұны Мэй Чанға бер.
Dialogue: 0,0:08:05.26,0:08:05.80,Default,,0,0,0,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:08:06.26,0:08:10.72,Default,,0,0,0,,Бұл Йошиноның жаңа әні. Ол өзінің инди қызметін қайта бастады.
Dialogue: 0,0:08:11.10,0:08:13.47,Default,,0,0,0,,Халат пен Спанья
Dialogue: 0,0:08:14.20,0:08:16.40,Default,,0,0,0,,Бұл махаббат пен кілт
Dialogue: 0,0:08:17.42,0:08:19.55,Default,,0,0,0,,Сіз шынымен орта мектепті бітірдіңіз бе?
Dialogue: 0,0:08:20.07,0:08:21.93,Default,,0,0,0,,Бұл әдеттен тыс ән атауы.
Dialogue: 0,0:08:22.13,0:08:24.73,Default,,0,0,0,,Йошино мырза екеуміз ойланып қалдық.
Dialogue: 0,0:08:24.77,0:08:27.19,Default,,0,0,0,,Қазір ол әлдеқайда жақсырақ болды.
Dialogue: 0,0:08:30.18,0:08:31.44,Default,,0,0,0,,Сәлем Оказаки
Dialogue: 0,0:08:31.68,0:08:32.36,Default,,0,0,0,,Не? Иә?
Dialogue: 0,0:08:32.78,0:08:34.40,Default,,0,0,0,,Екеуі де Оказаки, солай ма?
Dialogue: 0,0:08:35.63,0:08:37.44,Default,,0,0,0,,Олай болса, Оказаки, адам.
Dialogue: 0,0:08:37.52,0:08:39.17,Default,,0,0,0,,Ол қалай аталады?
Dialogue: 0,0:08:41.71,0:08:44.23,Default,,0,0,0,,Әке болу қандай сезімде?
Dialogue: 0,0:08:45.26,0:08:46.93,Default,,0,0,0,,Мен біртүрлі нәрселерді естимін.
Dialogue: 0,0:08:47.30,0:08:48.69,Default,,0,0,0,,Мені де қызықтырады.
Dialogue: 0,0:08:49.11,0:08:52.31,Default,,0,0,0,,Ата-ана болу қандай сезім?
Dialogue: 0,0:08:53.17,0:08:57.69,Default,,0,0,0,,Мен ата-ана болу әлі алыс деп ойладым.
Dialogue: 0,0:08:58.23,0:09:01.29,Default,,0,0,0,,Бірақ мен сендерге солай болған деп естідім.
Dialogue: 0,0:09:01.29,0:09:03.63,Default,,0,0,0,,Бұл маған кенет таныс болып көрінді.
Dialogue: 0,0:09:04.87,0:09:07.87,Default,,0,0,0,,Балалар, алдарыңда мұны айтудың мәні неде?
Dialogue: 0,0:09:08.30,0:09:10.76,Default,,0,0,0,,Әкеге ұнау мүмкін емес деп ойлаймын.
Dialogue: 0,0:09:11.48,0:09:15.77,Default,,0,0,0,,Менің ойымша, бұл жер сілкінісі мен найзағай сияқты табиғи апаттар сияқты.
Dialogue: 0,0:09:16.37,0:09:17.12,Default,,0,0,0,,Сонымен
Dialogue: 0,0:09:17.32,0:09:20.72,Default,,0,0,0,,Мен сенің мұндай болғаныңа қалай қарайтыныңды білгім келеді.
Dialogue: 0,0:09:24.12,0:09:26.31,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:09:26.38,0:09:27.59,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:09:28.33,0:09:32.31,Default,,0,0,0,,Шынымды айтсам, мен оны әлі сезінемін бе, жоқ па білмеймін.
Dialogue: 0,0:09:32.82,0:09:34.45,Default,,0,0,0,,Жаңа ғана өзіме ұнайтын адамды таптым
Dialogue: 0,0:09:34.83,0:09:37.24,Default,,0,0,0,,Мен ол үшін өмір сүрсем, солай болды.
Dialogue: 0,0:09:37.49,0:09:38.50,Default,,0,0,0,,Міне
Dialogue: 0,0:09:40.62,0:09:42.06,Default,,0,0,0,,Оказаки
Dialogue: 0,0:09:42.62,0:09:44.54,Default,,0,0,0,,Сіз ештеңені өзгерткен жоқсыз.
Dialogue: 0,0:09:45.40,0:09:46.29,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:09:46.49,0:09:47.11,Default,,0,0,0,,О
Dialogue: 0,0:09:47.30,0:09:50.94,Default,,0,0,0,,Нағиса-чан екеуің алысқа кетті деп ойладым.
Dialogue: 0,0:09:51.14,0:09:52.68,Default,,0,0,0,,Бірақ бұл күтпеген жерден жақын болды.
Dialogue: 0,0:09:52.91,0:09:54.13,Default,,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,0:09:54.37,0:09:55.44,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:09:55.73,0:09:59.05,Default,,0,0,0,,Шынымды айтсам, танысқанға дейін мен де біраз қобалжыдым.
Dialogue: 0,0:09:59.51,0:10:02.83,Default,,0,0,0,,Біз өмірімізде мәңгілікке көшіп кеткендей сезінеміз.
Dialogue: 0,0:10:03.10,0:10:05.16,Default,,0,0,0,,Өмір жұмбақ, солай емес пе?
Dialogue: 0,0:10:05.24,0:10:08.01,Default,,0,0,0,,Біз қайдан келдік, қайда барамыз?
Dialogue: 0,0:10:09.40,0:10:14.72,Default,,0,0,0,,Мен қазір анам мен әкеммен бірдей нәрсені зерттеп жатырмын.
Dialogue: 0,0:10:14.80,0:10:18.07,Default,,0,0,0,,Сіз жасырын дүниені айтқыңыз келді ме?
Dialogue: 0,0:10:18.40,0:10:22.23,Default,,0,0,0,,Иә, дәл осы дүниенің қасында
Dialogue: 0,0:10:22.69,0:10:27.96,Default,,0,0,0,,Бірақ мен көре алмайтын, сезбейтін басқа дүние бар.
Dialogue: 0,0:10:28.30,0:10:28.94,Default,,0,0,0,,Бірақ
Dialogue: 0,0:10:29.46,0:10:33.24,Default,,0,0,0,,Мен бұлай емес шығар деп түсіндім.
Dialogue: 0,0:10:33.60,0:10:34.84,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:10:35.23,0:10:39.35,Default,,0,0,0,,Иә, бұл қосымша өлшемдерге қатысты болуы мүмкін.
Dialogue: 0,0:10:39.78,0:10:41.34,Default,,0,0,0,,Қазіргі теорияда
Dialogue: 0,0:10:41.45,0:10:46.11,Default,,0,0,0,,Біз білетін материя жоғары өлшемді әлемнің миына бекітілген.
Dialogue: 0,0:10:46.27,0:10:49.64,Default,,0,0,0,,Мен сол болмыс формасының шегінен құтыла алмасам да.
Dialogue: 0,0:10:50.05,0:10:52.28,Default,,0,0,0,,Мысалы, гравитациялық энергия болып табылады
Dialogue: 0,0:10:52.28,0:10:55.78,Default,,0,0,0,,Уақыт пен кеңістікте алға-артқа саяхат жасауға болады дейді.
Dialogue: 0,0:10:56.08,0:10:57.12,Default,,0,0,0,,Дәл осылай...
Dialogue: 0,0:10:57.12,0:10:58.09,Default,,0,0,0,,Гү… гүг… Дұрыс.
Dialogue: 0,0:10:58.41,0:10:59.98,Default,,0,0,0,,Түсінуім үшін айтыңыз
Dialogue: 0,0:11:00.67,0:11:04.13,Default,,0,0,0,,Бұл өте қарапайым түсініктеме.
Dialogue: 0,0:11:04.66,0:11:07.42,Default,,0,0,0,,Бұл дүние де, жасырын дүние де солай
Dialogue: 0,0:11:07.68,0:11:10.18,Default,,0,0,0,,Бұл олардың терең байланысты екенін білдіре ме?
Dialogue: 0,0:11:10.32,0:11:10.99,Default,,0,0,0,,Иә
Dialogue: 0,0:11:11.33,0:11:15.41,Default,,0,0,0,,Уақыт, кеңістік, адам санасы жұмбақ резонанс жасайды.
Dialogue: 0,0:11:15.53,0:11:17.68,Default,,0,0,0,,Екі дүниені де қайта жасау
Dialogue: 0,0:11:17.81,0:11:19.98,Default,,0,0,0,,Жаңа әлем құру
Dialogue: 0,0:11:20.07,0:11:23.05,Default,,0,0,0,,Мүмкін олар бір-біріне осылай әсер етеді.
Dialogue: 0,0:11:23.38,0:11:24.61,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:24.75,0:11:29.42,Default,,0,0,0,,Біздің өміріміздің де сол әлемге қатысы бар ма?
Dialogue: 0,0:11:29.64,0:11:32.95,Default,,0,0,0,,Мүмкін солай шығар, бірақ мүмкін емес.
Dialogue: 0,0:11:33.48,0:11:36.49,Default,,0,0,0,,Бұл әлем шынымен де біз түсінбейтін нәрселерге толы.
Dialogue: 0,0:11:37.06,0:11:40.81,Default,,0,0,0,,Бұл жасырын дүние қандай орын?
Dialogue: 0,0:11:46.00,0:11:49.61,Default,,0,0,0,,Не? Неліктен кенеттен сол кездегі бірдеңе есіме түсіп кетті?
Dialogue: 0,0:11:50.25,0:11:52.06,Default,,0,0,0,,Ақырғы дүниедегі қыз
Dialogue: 0,0:11:52.48,0:11:55.15,Default,,0,0,0,,Мен бұл оқиғаны не үшін білдім?
Dialogue: 0,0:11:55.76,0:11:56.72,Default,,0,0,0,,Томоя-кун?
Dialogue: 0,0:11:56.95,0:11:58.95,Default,,0,0,0,,Жоқ, мен бұл туралы ойладым.
Dialogue: 0,0:11:59.14,0:12:01.35,Default,,0,0,0,,Ол дүниеде де біз сияқты адамдар бар.
Dialogue: 0,0:12:01.47,0:12:03.73,Default,,0,0,0,,Бәлкім, ол мұны жанданған шығар.
Dialogue: 0,0:12:04.41,0:12:07.88,Default,,0,0,0,,Бірден көп жасырын дүние болуы мүмкін.
Dialogue: 0,0:12:07.95,0:12:11.63,Default,,0,0,0,,Әртүрлі дүниелер бар деген теория да бар.
Dialogue: 0,0:12:12.28,0:12:12.97,Default,,0,0,0,,Фудзибаяши
Dialogue: 0,0:12:13.23,0:12:17.46,Default,,0,0,0,,Бірде біз сәуегейлік туралы айтып отырғанда, сіз осындай сөз айттыңыз.
Dialogue: 0,0:12:17.54,0:12:20.79,Default,,0,0,0,,Иә, бір ғана бекітілген болашақ жоқ.
Dialogue: 0,0:12:20.91,0:12:22.45,Default,,0,0,0,,Көптеген мүмкіндіктер бар
Dialogue: 0,0:12:22.69,0:12:24.31,Default,,0,0,0,,Мен әлі де солай ойлаймын.
Dialogue: 0,0:12:24.70,0:12:26.64,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:12:26.75,0:12:29.71,Default,,0,0,0,,Осы адамдардың бірі менімен кездесіп жүрген сияқты.
Dialogue: 0,0:12:30.07,0:12:32.60,Default,,0,0,0,,Ондай дүние болуы мүмкін емес пе?
Dialogue: 0,0:12:32.97,0:12:35.42,Default,,0,0,0,,Өйткені ол менімен ешқашан әділ бола алмайды
Dialogue: 0,0:12:35.80,0:12:37.81,Default,,0,0,0,,Мен де сенімен сөйлесуден бас тартамын.
Dialogue: 0,0:12:45.52,0:12:48.80,Default,,0,0,0,,Мен ештеңе жасай алмаймын
Dialogue: 0,0:12:49.48,0:12:52.45,Default,,0,0,0,,Қоқыстарды жинау ғана
Dialogue: 0,0:12:53.55,0:12:55.71,Default,,0,0,0,,Қанша тырыссам да босқа кетті.
Dialogue: 0,0:12:56.73,0:12:59.50,Default,,0,0,0,,Мен мұны білмей тұрып жұмысымды тоқтаттым.
Dialogue: 0,0:13:12.02,0:13:13.63,Default,,0,0,0,,Сен де келдің бе?
Dialogue: 0,0:13:13.75,0:13:14.57,Default,,0,0,0,,Қария
Dialogue: 0,0:13:14.87,0:13:17.00,Default,,0,0,0,,Қала өзгеруде
Dialogue: 0,0:13:17.68,0:13:20.07,Default,,0,0,0,,Барлығы өзгермейді
Dialogue: 0,0:13:20.76,0:13:24.04,Default,,0,0,0,,Адамдардың аман қалуы осыны білдіреді.
Dialogue: 0,0:13:24.63,0:13:28.10,Default,,0,0,0,,Бірақ бұл жер сіз үшін маңызды, солай ма?
Dialogue: 0,0:13:29.49,0:13:31.35,Default,,0,0,0,,Егер сіз осы құрылысқа кедергі келтірсеңіз
Dialogue: 0,0:13:31.55,0:13:33.60,Default,,0,0,0,,Нағиса жақсы болар ма екен?
Dialogue: 0,0:13:33.71,0:13:34.32,Default,,0,0,0,,Саған қонақүй тауып беремін.
Dialogue: 0,0:13:34.85,0:13:36.94,Default,,0,0,0,,Мен кенеттен солай болдым.
Dialogue: 0,0:13:37.32,0:13:38.49,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:13:38.84,0:13:42.96,Default,,0,0,0,,Қала тұрғындары үшін мұнда үлкен аурухана болғаны жақсы.
Dialogue: 0,0:13:43.06,0:13:45.88,Default,,0,0,0,,Бұл біздің көңіл-күйімізге байланысты шешілетін мәселе емес.
Dialogue: 0,0:13:46.32,0:13:49.20,Default,,0,0,0,,Мен бұл қаланы жек көретін шығармын деп ойлаймын.
Dialogue: 0,0:13:50.58,0:13:51.54,Default,,0,0,0,,Іс жүзінде
Dialogue: 0,0:13:51.91,0:13:53.32,Default,,0,0,0,,Мүдделі адамнан сұрау
Dialogue: 0,0:13:53.32,0:13:56.20,Default,,0,0,0,,Кейбір ағаштарды қалдыру керек.
Dialogue: 0,0:13:56.66,0:13:58.97,Default,,0,0,0,,Джипён жасады, солай ма? ұқсас нәрсе
Dialogue: 0,0:13:59.14,0:13:59.93,Default,,0,0,0,,Чипён?
Dialogue: 0,0:14:00.33,0:14:01.77,Default,,0,0,0,,О, сіз Томойо дейсіз бе?
Dialogue: 0,0:14:02.91,0:14:05.33,Default,,0,0,0,,Мен сізді ауруханада босануға шешім қабылдағаныңызды естідім.
Dialogue: 0,0:14:05.45,0:14:09.12,Default,,0,0,0,,Аа, жабдықты алу қауіпсізірек.
Dialogue: 0,0:14:10.05,0:14:13.08,Default,,0,0,0,,Мен бірдеңе істеу үшін қолымнан келгеннің бәрін жасадым...
Dialogue: 0,0:14:14.58,0:14:16.24,Default,,0,0,0,,Жаңбыр жауатын сияқты
Dialogue: 0,0:14:21.13,0:14:23.16,Default,,0,0,0,,Сол күні қалың қар жауды.
Dialogue: 0,0:14:23.93,0:14:25.48,Default,,0,0,0,,Автомобильдер мен пойыздар қозғала алмайды
Dialogue: 0,0:14:25.62,0:14:29.55,Default,,0,0,0,,Қаланың қызметі ауырып қалғандай әлсіреген кезде.
Dialogue: 0,0:14:31.49,0:14:35.08,Default,,0,0,0,,Нағисаның қызуы көтеріліп, толғағы бір уақытта басталды.
Dialogue: 0,0:14:35.88,0:14:39.08,Default,,0,0,0,,Босану жоспарланған уақыттан екі апта бұрын болды.
Dialogue: 0,0:14:43.76,0:14:46.28,Default,,0,0,0,,Нағиса, берік бол.
Dialogue: 0,0:14:46.28,0:14:47.07,Default,,0,0,0,,Нагиса!
Dialogue: 0,0:14:53.43,0:14:54.42,Default,,0,0,0,,Нағиса
Dialogue: 0,0:14:59.47,0:15:04.45,Default,,0,0,0,,Жарайды, мен Тосио-чанды дұрыстап босанамын.
Dialogue: 0,0:15:04.60,0:15:09.23,Default,,0,0,0,,Мен Томоя мен Тосиомен бірге тұрамын.
Dialogue: 0,0:15:11.40,0:15:13.22,Default,,0,0,0,,Яги мырза келді.
Dialogue: 0,0:15:13.25,0:15:14.90,Default,,0,0,0,,Көлік әлі қозғала алмайтын сияқты.
Dialogue: 0,0:15:15.09,0:15:17.13,Default,,0,0,0,,Осындай кездер
Dialogue: 0,0:15:17.44,0:15:19.66,Default,,0,0,0,,Кога мырза, суды қайнатыңыз.
Dialogue: 0,0:15:20.05,0:15:20.95,Default,,0,0,0,,Мүмкіндігінше көп
Dialogue: 0,0:15:21.21,0:15:21.88,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:15:23.16,0:15:26.09,Default,,0,0,0,,Оказаки мырза, әйеліңізді жігерлендіріңіз.
Dialogue: 0,0:15:26.91,0:15:29.37,Default,,0,0,0,,Қол ұстасу дұрыс емес пе?
Dialogue: 0,0:15:30.56,0:15:32.97,Default,,0,0,0,,Әрине, солай істеңіз.
Dialogue: 0,0:15:34.63,0:15:36.89,Default,,0,0,0,,Нагиса Мен осындамын.
Dialogue: 0,0:15:37.60,0:15:39.23,Default,,0,0,0,,Жоғалтпа, Нағиса
Dialogue: 0,0:15:40.12,0:15:42.12,Default,,0,0,0,,Аман-есен босанып, бастайық.
Dialogue: 0,0:15:43.05,0:15:45.78,Default,,0,0,0,,Ушио және үшеумізбен жаңа өмір
Dialogue: 0,0:15:46.83,0:15:48.32,Default,,0,0,0,,Тыныштал, жарайды.
Dialogue: 0,0:15:49.51,0:15:52.33,Default,,0,0,0,,Иә, ау, дем шығарып көріңіз.
Dialogue: 0,0:15:55.45,0:15:58.13,Default,,0,0,0,,Иә, сен жақсысың.
Dialogue: 0,0:16:00.35,0:16:02.01,Default,,0,0,0,,Иә, ол қуатты шығарады.
Dialogue: 0,0:16:02.75,0:16:04.02,Default,,0,0,0,,жақсы шеберлік
Dialogue: 0,0:16:04.70,0:16:06.14,Default,,0,0,0,,Қарап көрейік.
Dialogue: 0,0:16:15.41,0:16:18.16,Default,,0,0,0,,Нағиса талай рет есінен танып қалды.
Dialogue: 0,0:16:19.43,0:16:21.99,Default,,0,0,0,,Сосын мен қайтадан ауырып оянамын.
Dialogue: 0,0:16:22.77,0:16:26.14,Default,,0,0,0,,Көзімді жауып алғым келген қатыгез көрініс болды.
Dialogue: 0,0:16:32.92,0:16:38.87,Default,,0,0,0,,Оның ұзаққа созылғаны сонша, мен оның ешқайсысы көрінбейтін мәңгілік болады деп ойладым.
Dialogue: 0,0:16:40.88,0:16:43.25,Default,,0,0,0,,Мен өзім ес-түсінен айырылып қала жаздадым.
Dialogue: 0,0:16:45.02,0:16:48.18,Default,,0,0,0,,Жүрегің шыдамай қалды ма?
Dialogue: 0,0:16:50.42,0:16:53.11,Default,,0,0,0,,Сіз бәрінен үміт үздіңіз бе?
Dialogue: 0,0:17:17.06,0:17:17.81,Default,,0,0,0,,Нагиса?
Dialogue: 0,0:17:19.90,0:17:20.49,Default,,0,0,0,,Нагиса?
Dialogue: 0,0:17:22.13,0:17:22.72,Default,,0,0,0,,Нағиса...
Dialogue: 0,0:17:26.98,0:17:27.81,Default,,0,0,0,,Нагиса!
Dialogue: 0,0:17:30.67,0:17:32.95,Default,,0,0,0,,Томоя…кун
Dialogue: 0,0:17:32.95,0:17:33.72,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:17:34.20,0:17:34.82,Default,,0,0,0,,Нағиса
Dialogue: 0,0:17:35.85,0:17:36.99,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:17:42.75,0:17:43.97,Default,,0,0,0,,Сіз оны ести аласыз.
Dialogue: 0,0:17:44.89,0:17:46.81,Default,,0,0,0,,Баламыздың жылағаны
Dialogue: 0,0:17:47.83,0:17:48.51,Default,,0,0,0,,Иә
Dialogue: 0,0:17:48.67,0:17:51.92,Default,,0,0,0,,Қарашы, мен сені бірінші ұстап тұрмын.
Dialogue: 0,0:17:54.46,0:17:57.46,Default,,0,0,0,,Иә, сүйкімді
Dialogue: 0,0:17:58.59,0:18:00.18,Default,,0,0,0,,Ол біздің баламыз.
Dialogue: 0,0:18:00.60,0:18:01.53,Default,,0,0,0,,Шио
Dialogue: 0,0:18:02.39,0:18:03.82,Default,,0,0,0,,Шио-чан
Dialogue: 0,0:18:03.90,0:18:06.87,Default,,0,0,0,,Бұл қыз. Ол дені сау қыз.
Dialogue: 0,0:18:07.69,0:18:12.31,Default,,0,0,0,,Иә, үйде босанғаныма қуаныштымын.
Dialogue: 0,0:18:12.97,0:18:17.99,Default,,0,0,0,,Мен Шио-чанға көп қиындық туғыздым.
Dialogue: 0,0:18:18.06,0:18:20.23,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:18:22.35,0:18:26.22,Default,,0,0,0,,Бірақ мен аздап шаршадым.
Dialogue: 0,0:18:27.50,0:18:31.03,Default,,0,0,0,,Маған біраз демалуға рұқсат етіңіз.
Dialogue: 0,0:18:31.92,0:18:32.58,Default,,0,0,0,,Нағиса
Dialogue: 0,0:18:32.81,0:18:35.07,Default,,0,0,0,,Ей, дәрігер әлі келмеді ме?
Dialogue: 0,0:18:35.15,0:18:36.84,Default,,0,0,0,,Көлікті әлі пайдалана алмайсыз ба? ?
Dialogue: 0,0:18:37.44,0:18:38.19,Default,,0,0,0,,Нағиса
Dialogue: 0,0:18:38.52,0:18:39.94,Default,,0,0,0,,Күте тұрыңыз, Нағиса.
Dialogue: 0,0:18:40.75,0:18:43.64,Default,,0,0,0,,Кішкене сөйлесейік
Dialogue: 0,0:18:44.14,0:18:46.03,Default,,0,0,0,,Тек тыңдау жеткілікті.
Dialogue: 0,0:18:48.57,0:18:50.54,Default,,0,0,0,,Қараңдаршы, бұл біздің баламыз.
Dialogue: 0,0:18:51.25,0:18:53.25,Default,,0,0,0,,Сіз маймылға ұқсайсыз.
Dialogue: 0,0:18:53.70,0:18:55.56,Default,,0,0,0,,Таңғажайып кішкентай
Dialogue: 0,0:18:56.05,0:18:57.96,Default,,0,0,0,,Мен сізге қоңырау шаламын.
Dialogue: 0,0:18:58.44,0:18:59.34,Default,,0,0,0,,Шио
Dialogue: 0,0:19:01.75,0:19:03.61,Default,,0,0,0,,Бұл менің әкем, Шио.
Dialogue: 0,0:19:04.28,0:19:05.53,Default,,0,0,0,,Бұл ана
Dialogue: 0,0:19:05.81,0:19:06.31,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:19:11.65,0:19:12.86,Default,,0,0,0,,еленбейді
Dialogue: 0,0:19:13.61,0:19:14.94,Default,,0,0,0,,Сіз түсінуге мүмкіндік жоқ.
Dialogue: 0,0:19:18.91,0:19:20.79,Default,,0,0,0,,Мен олардың жақын арада есейетініне сенімдімін.
Dialogue: 0,0:19:20.88,0:19:22.17,Default,,0,0,0,,Бастауыш мектепке бару
Dialogue: 0,0:19:23.01,0:19:24.71,Default,,0,0,0,,Мен және сен біргеміз
Dialogue: 0,0:19:25.35,0:19:27.88,Default,,0,0,0,,Сыныптағы бақылау, спартакиада және т.б.
Dialogue: 0,0:19:28.31,0:19:29.75,Default,,0,0,0,,Мұны отбасы ретінде жасаңыз
Dialogue: 0,0:19:30.19,0:19:34.11,Default,,0,0,0,,Осындай нәрселерді ең көп мазақ еткен мен болдым.
Dialogue: 0,0:19:40.81,0:19:41.49,Default,,0,0,0,,Нагиса?
Dialogue: 0,0:19:45.41,0:19:45.99,Default,,0,0,0,,Нағиса
Dialogue: 0,0:19:48.72,0:19:50.97,Default,,0,0,0,,Қараңдаршы, Шионың беттері.
Dialogue: 0,0:19:52.00,0:19:53.60,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:20:04.17,0:20:04.82,Default,,0,0,0,,Нағиса
Dialogue: 0,0:20:06.21,0:20:08.29,Default,,0,0,0,,Сіз әрқашан менің жанымда боламын дедіңіз.
Dialogue: 0,0:20:09.29,0:20:11.03,Default,,0,0,0,,Біз әрқашан бірге боламыз
Dialogue: 0,0:20:13.08,0:20:13.95,Default,,0,0,0,,Көп рет
Dialogue: 0,0:20:15.06,0:20:17.93,Default,,0,0,0,,Қанша рет уәде бердіңіз.
Dialogue: 0,0:20:21.55,0:20:23.26,Default,,0,0,0,,Бұл менің арманым еді
Dialogue: 0,0:20:23.99,0:20:26.78,Default,,0,0,0,,Тірі болудан жақсы ештеңе жоқ
Dialogue: 0,0:20:27.24,0:20:31.01,Default,,0,0,0,,Өмірді қызықсыз деп ойлаған адам
Dialogue: 0,0:20:31.68,0:20:33.37,Default,,0,0,0,,Ақыры тапқан арманым
Dialogue: 0,0:20:34.16,0:20:36.21,Default,,0,0,0,,Сәлем Нағиса
Dialogue: 0,0:20:37.70,0:20:38.55,Default,,0,0,0,,Нағиса...
Dialogue: 0,0:20:39.97,0:20:41.01,Default,,0,0,0,,Нагиса!
Dialogue: 0,0:20:59.30,0:21:01.83,Default,,0,0,0,,Сізге бұл мектеп ұнай ма?
Dialogue: 0,0:21:05.15,0:21:07.85,Default,,0,0,0,,Маған бұл өте ұнайды.
Dialogue: 0,0:21:08.94,0:21:12.19,Default,,0,0,0,,Бірақ ешнәрсе бұрынғыдай қала алмайды.
Dialogue: 0,0:21:12.68,0:21:15.46,Default,,0,0,0,,Барлық қызықты және қуанышты нәрселер...
Dialogue: 0,0:21:15.46,0:21:17.47,Default,,0,0,0,,Мен өзгермей тұра алмаймын
Dialogue: 0,0:21:18.20,0:21:21.26,Default,,0,0,0,,Сіз бұл жерді әлі де жақсы көре аласыз ба?
Dialogue: 0,0:21:32.19,0:21:33.96,Default,,0,0,0,,Ешқашан кездеспегенімізді қалаймын.
Dialogue: 0,0:21:34.93,0:21:37.69,Default,,0,0,0,,Біз әр түрлі жолмен жүруіміз керек еді.
Dialogue: 0,0:21:39.11,0:21:40.92,Default,,0,0,0,,Мен Нағисамен араласпаймын.
Dialogue: 0,0:21:41.51,0:21:42.92,Default,,0,0,0,,Мен Нағисаға да үйленбеймін.
Dialogue: 0,0:21:43.52,0:21:45.92,Default,,0,0,0,,Ал толқын да тумайды
Dialogue: 0,0:21:46.96,0:21:50.70,Default,,0,0,0,,Егер мен мұны істегенімде, мен бұл қайғыны сезбес едім.
Dialogue: 0,0:22:01.21,0:22:03.78,Default,,0,0,0,,Ешқашан кездеспегенімізді қалаймын.
Dialogue: 0,0:22:18.62,0:22:25.84,Default,,0,0,0,,Мен өтіп бара жатқан бұлттарға қарап тұрдым
Dialogue: 0,0:22:26.14,0:22:32.77,Default,,0,0,0,,Аспан түсінің өзгергенін сезіндім
Dialogue: 0,0:22:33.65,0:22:40.98,Default,,0,0,0,,Тоқтаған біз, түсіндік
Dialogue: 0,0:22:41.31,0:22:48.17,Default,,0,0,0,,Өзгермелі дүние иірген ән
Dialogue: 0,0:22:48.26,0:22:55.44,Default,,0,0,0,,Саусақтарын созып тартқандай
Dialogue: 0,0:22:55.65,0:23:03.90,Default,,0,0,0,,Бір өзгеріссіз қалатын затты табыңыз
Dialogue: 0,0:23:04.39,0:23:11.60,Default,,0,0,0,,Сіз ұстаған қолыңыздағы шам
Dialogue: 0,0:23:11.75,0:23:19.41,Default,,0,0,0,,Ертеңге апаратын шағын бағдаршам
Dialogue: 0,0:23:19.41,0:23:26.65,Default,,0,0,0,,Қазір де жаңғырық
Dialogue: 0,0:23:26.93,0:23:34.28,Default,,0,0,0,,Сол күнгі сөздерді ант етіп өзгертіңіз
Dialogue: 0,0:23:34.39,0:23:39.13,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:23:40.63,0:23:45.63,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
