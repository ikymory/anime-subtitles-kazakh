Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.94,0:00:07.47,Default,,0,0,0,,Бүгін өнерлі болдың.
Dialogue: 0,0:00:07.94,0:00:08.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:09.00,0:00:11.58,Default,,0,0,0,,Оны үйрену оңай және қадамдар дәл.
Dialogue: 0,0:00:12.37,0:00:14.62,Default,,0,0,0,,Бәлкім, мен мұндай жұмысқа лайық шығармын.
Dialogue: 0,0:00:15.39,0:00:17.53,Default,,0,0,0,,Сіз мені кездейсоқ мақтап жатырсыз ба?
Dialogue: 0,0:00:18.41,0:00:19.91,Default,,0,0,0,,Тым көп алданып қалмаңыз
Dialogue: 0,0:00:20.85,0:00:23.64,Default,,0,0,0,,Әрине, біз күнде бір нәрсені жасаймыз.
Dialogue: 0,0:00:24.50,0:00:25.05,Default,,0,0,0,,Иә
Dialogue: 0,0:00:31.29,0:00:33.62,Default,,0,0,0,,Ол кезде парталарды тізіп тұрғандар
Dialogue: 0,0:00:33.92,0:00:37.34,Default,,0,0,0,,Менің ойымша, барлығы жоғары білім алды және қазір бір жерде қалада.
Dialogue: 0,0:00:38.24,0:00:39.69,Default,,0,0,0,,Мұнда жалғыз мен ғанамын
Dialogue: 0,0:00:41.04,0:00:42.67,Default,,0,0,0,,Бірақ сіз жалғыз емессіз
Dialogue: 0,0:00:44.36,0:00:47.76,Default,,0,0,0,,Сол сияқты күнде күйе басып жүргендер де бар.
Dialogue: 0,0:00:49.05,0:00:52.20,Default,,0,0,0,,Бұл мен таңдаған жаңа жер болды.
Dialogue: 0,0:01:10.94,0:01:16.38,Default,,0,0,0,,Сен ғана өткен төбеден түсіп келе жатқанда
Dialogue: 0,0:01:16.52,0:01:21.95,Default,,0,0,0,,Күннің жылы дақтары көп болды.
Dialogue: 0,0:01:22.08,0:01:27.23,Default,,0,0,0,,Мен ғана мейірімдімін.
Dialogue: 0,0:01:27.37,0:01:34.53,Default,,0,0,0,,Жылылықты еске түсіру
Dialogue: 0,0:01:34.99,0:01:42.83,Default,,0,0,0,,Тек сен, тек сен
Dialogue: 0,0:01:42.83,0:01:48.68,Default,,0,0,0,,Мен сені сүйдім
Dialogue: 0,0:01:48.82,0:01:56.50,Default,,0,0,0,,Жел көзімді бұлдыратады
Dialogue: 0,0:01:56.62,0:02:03.12,Default,,0,0,0,,Ол алыс болады
Dialogue: 0,0:02:03.41,0:02:05.93,Default,,0,0,0,,Мен сені мәңгі есте сақтаймын
Dialogue: 0,0:02:05.53,0:02:07.95,Default,,0,0,0,,Бәрі өзгерсе де
Dialogue: 0,0:02:07.55,0:02:10.01,Default,,0,0,0,,Бір ғана Бір ғана
Dialogue: 0,0:02:09.61,0:02:12.70,Default,,0,0,0,,Қарапайым болса да
Dialogue: 0,0:02:12.30,0:02:16.91,Default,,0,0,0,,Мен саған жарқыраған бір нәрсені көрсетемін
Dialogue: 0,0:02:16.41,0:02:21.72,Default,,0,0,0,,Мен сені мәңгілікке қорғаймын.
Dialogue: 0,0:02:26.11,0:02:28.35,Default,,0,0,0,,Енді викторина.
Dialogue: 0,0:02:29.10,0:02:30.44,Default,,0,0,0,,Қайтадан басталды
Dialogue: 0,0:02:31.68,0:02:35.96,Default,,0,0,0,,Осы жаздың бірінші үлкен оқиғасы қандай деп ойлаймын?
Dialogue: 0,0:02:36.22,0:02:38.08,Default,,0,0,0,,1 Теңіздегі барбекю Q
Dialogue: 0,0:02:38.16,0:02:40.16,Default,,0,0,0,,2 Баттан Q теңізде
Dialogue: 0,0:02:40.24,0:02:42.62,Default,,0,0,0,,Үш теңіздегі Барбара Фудзиока
Dialogue: 0,0:02:42.79,0:02:45.00,Default,,0,0,0,,Мен уайымдап отырмын, өйткені сөздер ұқсас
Dialogue: 0,0:02:45.08,0:02:46.51,Default,,0,0,0,,Соңғысы мүлдем басқаша болды.
Dialogue: 0,0:02:46.66,0:02:48.26,Default,,0,0,0,,Біз бірге барға бардық.
Dialogue: 0,0:02:48.42,0:02:50.58,Default,,0,0,0,,Барбара Фудзиоканы өзіңіз ойнаңыз.
Dialogue: 0,0:02:50.74,0:02:51.86,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:02:51.94,0:02:54.95,Default,,0,0,0,,Соңғы кездері Нағисамен ойнай алмағандықтан өзімді жалғыз сезінемін.
Dialogue: 0,0:02:55.03,0:02:57.59,Default,,0,0,0,,Бәрі жақсы, менімен бірге бол.
Dialogue: 0,0:02:57.66,0:02:58.78,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:59.51,0:03:03.52,Default,,0,0,0,,Екеуіңіздің ұзақ уақыт бірге болуыңыз табиғи нәрсе.
Dialogue: 0,0:03:03.75,0:03:05.83,Default,,0,0,0,,Баламды тастап қиналамын.
Dialogue: 0,0:03:06.19,0:03:06.98,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:03:07.74,0:03:09.37,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:15.97,0:03:18.34,Default,,0,0,0,,Сіз бұрынғыдай сергексіз.
Dialogue: 0,0:03:20.81,0:03:22.18,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:03:25.66,0:03:27.79,Default,,0,0,0,,Бір оқиға бар.
Dialogue: 0,0:03:28.87,0:03:31.06,Default,,0,0,0,,Не болды, купальник алғың келе ме?
Dialogue: 0,0:03:31.32,0:03:32.91,Default,,0,0,0,,Яғни, қарашы ғой — сол Хаято.
Dialogue: 0,0:03:34.24,0:03:37.27,Default,,0,0,0,,Жоқ, мен оны қаламаймын деген сөз емес.
Dialogue: 0,0:03:37.44,0:03:39.48,Default,,0,0,0,,Жарайды, ертең ерте тұрамын.
Dialogue: 0,0:03:39.56,0:03:40.98,Default,,0,0,0,,Кешке дүкен аралауға барамыз ба?
Dialogue: 0,0:03:41.10,0:03:41.94,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:42.44,0:03:43.69,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:03:43.92,0:03:46.64,Default,,0,0,0,,Менің ойымша, сізде тек мектеп купальнигі болған сияқты.
Dialogue: 0,0:03:46.85,0:03:49.67,Default,,0,0,0,,Иә, бірақ бұл мүлдем маңызды емес.
Dialogue: 0,0:03:49.72,0:03:51.23,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:03:51.53,0:03:54.67,Default,,0,0,0,,Мен оның сүйкімді болғанын қалаймын.
Dialogue: 0,0:03:54.75,0:03:56.59,Default,,0,0,0,,Бірден жағажай кумиріне айналу
Dialogue: 0,0:03:56.81,0:03:59.84,Default,,0,0,0,,Мен купальникпен осылай көрінемін
Dialogue: 0,0:04:00.05,0:04:01.53,Default,,0,0,0,,Олай айтпа
Dialogue: 0,0:04:01.78,0:04:03.78,Default,,0,0,0,,Ертең шоппинг жасайық
Dialogue: 0,0:04:04.00,0:04:04.54,Default,,0,0,0,,Иә
Dialogue: 0,0:04:04.79,0:04:05.89,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:04:07.58,0:04:08.69,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:04:09.75,0:04:11.08,Default,,0,0,0,,Бұл купальник емес пе?
Dialogue: 0,0:04:11.43,0:04:11.93,Default,,0,0,0,,А, онда...
Dialogue: 0,0:04:11.97,0:04:12.85,Default,,0,0,0,,Томоя-кун
Dialogue: 0,0:04:18.13,0:04:22.18,Default,,0,0,0,,Томоя-кун, сен көшіп келгеннен бері әкеңмен дұрыс таныстың ба?
Dialogue: 0,0:04:22.99,0:04:25.86,Default,,0,0,0,,Сіз оларға жаңа мекен-жайыңызды айттыңыз ба?
Dialogue: 0,0:04:27.49,0:04:28.10,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:29.46,0:04:31.09,Default,,0,0,0,,Мұны сіз де білесіз.
Dialogue: 0,0:04:31.43,0:04:33.74,Default,,0,0,0,,Ол адам мен менің арамызда алшақтық бар.
Dialogue: 0,0:04:35.46,0:04:37.14,Default,,0,0,0,,Бұл ешқашан толтырылмайтын қашықтық
Dialogue: 0,0:04:37.40,0:04:37.90,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:37.94,0:04:39.92,Default,,0,0,0,,Мен күн сайын жұмыс істеймін
Dialogue: 0,0:04:42.20,0:04:44.68,Default,,0,0,0,,Шаршағанша жұмыс істеймін.
Dialogue: 0,0:04:45.40,0:04:47.94,Default,,0,0,0,,Демалыс күндерімде сенімен бірге болғым келеді.
Dialogue: 0,0:04:48.86,0:04:50.76,Default,,0,0,0,,Мен өзімді жаман сезінгім келмейді
Dialogue: 0,0:04:52.27,0:04:54.36,Default,,0,0,0,,Бұл қазір болмауы керек.
Dialogue: 0,0:04:55.38,0:04:59.42,Default,,0,0,0,,Жақында әкеңмен бірге сәлемдесейік.
Dialogue: 0,0:05:00.45,0:05:02.78,Default,,0,0,0,,Әй, бір күні
Dialogue: 0,0:05:03.95,0:05:06.31,Default,,0,0,0,,Иә, мен бір күні сенімдімін
Dialogue: 0,0:05:12.93,0:05:17.62,Default,,0,0,0,,Менің ескі әріптесім бас мердігер болып табылатын компанияның бас менеджері.
Dialogue: 0,0:05:18.41,0:05:22.30,Default,,0,0,0,,Ол сайтты басқаратын жас адамды іздеп жатыр.
Dialogue: 0,0:05:22.42,0:05:23.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:23.68,0:05:25.85,Default,,0,0,0,,Ең алдымен, шәкірт ретінде.
Dialogue: 0,0:05:26.39,0:05:28.83,Default,,0,0,0,,Әрине, сіз штаттық қызметкер ретінде қабылданасыз.
Dialogue: 0,0:05:29.90,0:05:31.00,Default,,0,0,0,,Жалақы...
Dialogue: 0,0:05:32.69,0:05:34.43,Default,,0,0,0,,Бұл сома шығатын сияқты.
Dialogue: 0,0:05:35.00,0:05:36.14,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:05:36.50,0:05:40.44,Default,,0,0,0,,Мен сізге ұсынғым келеді.
Dialogue: 0,0:05:41.70,0:05:43.26,Default,,0,0,0,,Барғыңыз келе ме?
Dialogue: 0,0:05:44.38,0:05:46.19,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:05:46.32,0:05:47.88,Default,,0,0,0,,Бұл жұмыстан босатылғаныңызды білдіре ме?
Dialogue: 0,0:05:48.09,0:05:52.79,Default,,0,0,0,,Мені қате түсінбеңіз, сізге кеңес берген қожайынымның мейірімділігі болды.
Dialogue: 0,0:05:53.42,0:05:55.80,Default,,0,0,0,,Мен саған бірден шешім қабылда деп тұрған жоқпын.
Dialogue: 0,0:05:56.38,0:05:58.60,Default,,0,0,0,,Бірақ мен сенің позитивті ойлағаныңды қалаймын.
Dialogue: 0,0:05:59.48,0:06:00.29,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:06:03.20,0:06:04.56,Default,,0,0,0,,Сіз жоғалмайсыз
Dialogue: 0,0:06:05.38,0:06:09.15,Default,,0,0,0,,Бірақ мен әрқашан осы компанияда жұмыс істегім келетін.
Dialogue: 0,0:06:09.68,0:06:13.64,Default,,0,0,0,,Жалпы айтқанда, Йошино мырза маған қарағанда қабілетті емес пе?
Dialogue: 0,0:06:13.92,0:06:15.70,Default,,0,0,0,,Мен араласуға жақсы емеспін
Dialogue: 0,0:06:16.31,0:06:18.78,Default,,0,0,0,,Шебер бола аласың, директор бола алмайсың.
Dialogue: 0,0:06:19.25,0:06:21.94,Default,,0,0,0,,Сіз жас болғандықтан, сіздің мүмкіндігіңіз жоғары.
Dialogue: 0,0:06:22.87,0:06:24.80,Default,,0,0,0,,Бірақ оқиға тым кенет болды...
Dialogue: 0,0:06:25.06,0:06:26.98,Default,,0,0,0,,Онда барсаң айлығың көбейеді.
Dialogue: 0,0:06:27.45,0:06:30.96,Default,,0,0,0,,Сіз де бір күні отбасыңызды асырайтын жағдайға ие боласыз.
Dialogue: 0,0:06:31.37,0:06:32.11,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:06:35.09,0:06:38.81,Default,,0,0,0,,Егер сіз үшін маңызды адам болса, сіз кейбір қиындықтарды жеңе аласыз.
Dialogue: 0,0:06:41.70,0:06:45.61,Default,,0,0,0,,Йошино мырза, сіз қазіргі жұмысыңызға осыны ескере отырып кірістіңіз бе?
Dialogue: 0,0:06:48.82,0:06:51.47,Default,,0,0,0,,Сіздің кіруіңіз туралы естігенім үшін кешіріңіз.
Dialogue: 0,0:06:54.82,0:06:56.54,Default,,0,0,0,,Ежелгі күндерді айтамыз ба?
Dialogue: 0,0:06:58.59,0:07:02.07,Default,,0,0,0,,Бұл қаладағы жаман рок бала туралы әңгіме.
Dialogue: 0,0:07:05.43,0:07:07.96,Default,,0,0,0,,Ол бала кезінен қалағанын жасайды.
Dialogue: 0,0:07:08.83,0:07:12.71,Default,,0,0,0,,Маған ұрысатын адам болмағандықтан, жаман істерді істей бердім.
Dialogue: 0,0:07:15.33,0:07:17.43,Default,,0,0,0,,Ол кезде топ бум болатын.
Dialogue: 0,0:07:17.72,0:07:20.63,Default,,0,0,0,,-да ол гитараны да алды.
Dialogue: 0,0:07:22.14,0:07:25.26,Default,,0,0,0,,Біреудің жанды орындауына қол сұғу және басты вокалистті ұрлау.
Dialogue: 0,0:07:25.59,0:07:26.90,Default,,0,0,0,,Мен үнемі ойнайтынмын
Dialogue: 0,0:07:30.99,0:07:33.55,Default,,0,0,0,,Мен үшінші курста оқып жүргенімде екеуміз кездестік.
Dialogue: 0,0:07:35.19,0:07:38.27,Default,,0,0,0,,Ол оның махаббат әнін мақтады.
Dialogue: 0,0:07:39.74,0:07:41.49,Default,,0,0,0,,Өлең сөздері ұят болды
Dialogue: 0,0:07:42.01,0:07:44.43,Default,,0,0,0,,Мағынаны анық оқыды.
Dialogue: 0,0:07:45.77,0:07:47.82,Default,,0,0,0,,Ал, бұл туралы сөйлесіңіз.
Dialogue: 0,0:07:47.95,0:07:52.34,Default,,0,0,0,,Мен сыныптың ортасында жүргенімді ұмытып кеткендей болдым.
Dialogue: 0,0:07:53.36,0:07:55.05,Default,,0,0,0,,Ол шектен шыққан, бірақ...
Dialogue: 0,0:07:58.88,0:08:01.67,Default,,0,0,0,,Оқуды бітіргеннен кейін музыка арқылы өмір сүруді жоспарладым.
Dialogue: 0,0:08:03.20,0:08:05.34,Default,,0,0,0,,Сынып оған күлді, бірақ
Dialogue: 0,0:08:05.60,0:08:07.77,Default,,0,0,0,,Тек сол мұғалім ғана мені жігерлендірді.
Dialogue: 0,0:08:08.90,0:08:12.39,Default,,0,0,0,,Жалғассаң орындалады, берілме
Dialogue: 0,0:08:14.17,0:08:16.31,Default,,0,0,0,,Қоштасар күні, деді
Dialogue: 0,0:08:17.26,0:08:21.33,Default,,0,0,0,,Мен міндетті түрде кәсіпқой боламын, сондықтан менімен бірге болыңыз.
Dialogue: 0,0:08:24.49,0:08:27.93,Default,,0,0,0,,Мен кәсіби маман боламын деп шештім.
Dialogue: 0,0:08:31.65,0:08:33.68,Default,,0,0,0,,Дебют салыстырмалы түрде оңай шешілді.
Dialogue: 0,0:08:34.67,0:08:35.57,Default,,0,0,0,,Замамиро
Dialogue: 0,0:08:36.38,0:08:39.84,Default,,0,0,0,,Мені жоққа шығарғандарға айтқым келгені осы еді.
Dialogue: 0,0:08:42.21,0:08:44.79,Default,,0,0,0,,Содан бері мен шарасыз болдым.
Dialogue: 0,0:08:45.86,0:08:47.93,Default,,0,0,0,,Мен айтқым келген нәрсені бар ынтамен айттым.
Dialogue: 0,0:08:48.93,0:08:51.79,Default,,0,0,0,,Түкіргендей, ағып жатқандай
Dialogue: 0,0:08:53.03,0:08:55.00,Default,,0,0,0,,Кейде шіркін ән айтатынмын
Dialogue: 0,0:09:05.44,0:09:06.01,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:06.98,0:09:10.16,Default,,0,0,0,,Бар күшіммен ән айтсам, әдемі көрінетін.
Dialogue: 0,0:09:11.80,0:09:14.22,Default,,0,0,0,,Тірі сергітетін сезінді.
Dialogue: 0,0:09:15.96,0:09:19.91,Default,,0,0,0,,Өмір сүру - ең шіркін.
Dialogue: 0,0:09:23.28,0:09:25.68,Default,,0,0,0,,Ол өз орнын тапты.
Dialogue: 0,0:09:30.26,0:09:33.51,Default,,0,0,0,,Бірде бір телеарна маған бір жобамен келді.
Dialogue: 0,0:09:34.21,0:09:36.34,Default,,0,0,0,,Жанкүйерлерімен кездесу жоспары болды.
Dialogue: 0,0:09:37.58,0:09:38.71,Default,,0,0,0,,Жай жанкүйер емес
Dialogue: 0,0:09:39.33,0:09:41.38,Default,,0,0,0,,Мен сол музыканы тыңдау арқылы құтқарылдым.
Dialogue: 0,0:09:41.93,0:09:45.21,Default,,0,0,0,,Ал әлі де қиыншылықта тұрғандар.
Dialogue: 0,0:09:46.63,0:09:47.56,Default,,0,0,0,,Ауру адам
Dialogue: 0,0:09:48.14,0:09:49.36,Default,,0,0,0,,Жазатайым оқиғаға қатысқан адамдар
Dialogue: 0,0:09:50.15,0:09:52.75,Default,,0,0,0,,Ата-анасының кесірінен қатты қиналған адамдар.
Dialogue: 0,0:09:54.41,0:09:58.39,Default,,0,0,0,,Ақыл-ойы әлсіреп, кез келген сәтте бұзылуға жақын адам.
Dialogue: 0,0:10:00.84,0:10:03.77,Default,,0,0,0,,Барлығы азаптың ортасында болды.
Dialogue: 0,0:10:06.36,0:10:09.60,Default,,0,0,0,,Барлығы сол әнге тәуелді болды.
Dialogue: 0,0:10:11.09,0:10:14.34,Default,,0,0,0,,Менің әндерім енді менікі емес.
Dialogue: 0,0:10:15.46,0:10:17.05,Default,,0,0,0,,Мен мұны түсіндім
Dialogue: 0,0:10:19.63,0:10:23.49,Default,,0,0,0,,Осы уақытқа дейін ол өзі үшін музыкамен айналысты.
Dialogue: 0,0:10:24.51,0:10:26.61,Default,,0,0,0,,Бірақ қазір бәрі басқаша болды.
Dialogue: 0,0:10:27.54,0:10:31.42,Default,,0,0,0,,Мен ешқашан кездестірмеген мыңдаған және мыңдаған адамдар үшін
Dialogue: 0,0:10:31.72,0:10:34.23,Default,,0,0,0,,Маған музыка жасау керек болды
Dialogue: 0,0:10:42.76,0:10:45.63,Default,,0,0,0,,Ол енді ән жаза алмады.
Dialogue: 0,0:10:46.59,0:10:52.98,Default,,0,0,0,,Өйткені мен шындықтың ұлылығын, таяздығымды, таяздығымды түсіндім.
Dialogue: 0,0:10:54.54,0:10:56.63,Default,,0,0,0,,Кеңсеге демалуға бұйрық берілді.
Dialogue: 0,0:10:57.98,0:11:00.15,Default,,0,0,0,,Алты айдан кейін...
Dialogue: 0,0:11:02.93,0:11:05.13,Default,,0,0,0,,Мен шоуда кездескен жігіт қылмыс жасады.
Dialogue: 0,0:11:06.64,0:11:09.18,Default,,0,0,0,,Бұл қайтарылмайтын үлкен күнә.
Dialogue: 0,0:11:11.37,0:11:15.17,Default,,0,0,0,,Сосын бәрі ыдырап кетті
Dialogue: 0,0:11:20.33,0:11:24.86,Default,,0,0,0,,Оқиғаға себепкер болған адам ``Сенің әніңді тыңдасам, өзімді тыныш сезінемін.''
Dialogue: 0,0:11:25.44,0:11:30.04,Default,,0,0,0,,Жаңа әнді тезірек естуге ерекше құлшыныс танытқан.
Dialogue: 0,0:11:32.16,0:11:34.33,Default,,0,0,0,,Мен бәрін кінәлі деп ойладым.
Dialogue: 0,0:11:35.34,0:11:37.24,Default,,0,0,0,,Себебі мен ән айтуды қойдым
Dialogue: 0,0:11:37.62,0:11:41.21,Default,,0,0,0,,Оқиғаға себепкер болған адамның күнкөрісі тоналды...
Dialogue: 0,0:11:44.85,0:11:47.40,Default,,0,0,0,,Ол қайтадан ән айта бастады
Dialogue: 0,0:11:48.81,0:11:51.08,Default,,0,0,0,,Мүмкін емес мұраттар мен әдемі нәрселер туралы жырланады
Dialogue: 0,0:11:51.81,0:11:55.68,Default,,0,0,0,,Мені күткендерді құтқару керек деп ойладым.
Dialogue: 0,0:11:57.09,0:11:59.01,Default,,0,0,0,,Мұны неге ән айтып жатырсың?
Dialogue: 0,0:11:59.36,0:12:01.48,Default,,0,0,0,,Тіпті мен сенімді емес едім
Dialogue: 0,0:12:02.33,0:12:05.41,Default,,0,0,0,,Бірақ мен өзімнің күмәнімді сейілтіп, ән айтуды жалғастырдым.
Dialogue: 0,0:12:07.11,0:12:10.05,Default,,0,0,0,,Ән ақырында тіпті идеализмнен ауытқиды.
Dialogue: 0,0:12:10.40,0:12:13.21,Default,,0,0,0,,Бұл шикі шындықты айқайлаудан басқа ештеңе болмады.
Dialogue: 0,0:12:14.11,0:12:17.80,Default,,0,0,0,,Ән айтудан алатын нәрсе – нағыз азап.
Dialogue: 0,0:12:18.34,0:12:21.95,Default,,0,0,0,,Өлең сөздері үйлесімсіз болып, қарама-қайшылықтарға толы болды.
Dialogue: 0,0:12:23.21,0:12:25.71,Default,,0,0,0,,Сонда да ол ән айтуды жалғастырды
Dialogue: 0,0:12:26.42,0:12:29.68,Default,,0,0,0,,Өйткені мен бәрінен де әнімді жоғалтып алудан қорықтым.
Dialogue: 0,0:12:30.87,0:12:31.56,Default,,0,0,0,,Және…
Dialogue: 0,0:12:34.15,0:12:36.35,Default,,0,0,0,,Ол ең нашар әдісті қолданды
Dialogue: 0,0:12:37.79,0:12:39.95,Default,,0,0,0,,Бұл түзетілмейтін қате болды.
Dialogue: 0,0:12:42.43,0:12:46.79,Default,,0,0,0,,Ол қылмыс жасағаннан кейін оған тиесілі орын болмады.
Dialogue: 0,0:12:47.79,0:12:51.04,Default,,0,0,0,,Үмітсіз, жабысатын ештеңесі жоқ, ол
Dialogue: 0,0:12:51.40,0:12:53.03,Default,,0,0,0,,Мен тек бір рет тіледім
Dialogue: 0,0:12:54.20,0:12:55.26,Default,,0,0,0,,Мен үйге барғым келеді...
Dialogue: 0,0:13:39.00,0:13:41.06,Default,,0,0,0,,Сіз әлі де музыка ойнап жатырсыз ба?
Dialogue: 0,0:13:42.55,0:13:44.58,Default,,0,0,0,,Барлығы өзгерді
Dialogue: 0,0:13:45.59,0:13:47.57,Default,,0,0,0,,Мен өзгермей тұра алмадым
Dialogue: 0,0:13:47.79,0:13:50.08,Default,,0,0,0,,Берілмей жүре берсең
Dialogue: 0,0:13:52.02,0:13:53.56,Default,,0,0,0,,Өйткені армандар орындалады
Dialogue: 0,0:13:54.61,0:13:57.72,Default,,0,0,0,,Бірақ мен назардан тыс қалдырмау керек нәрсе бар еді.
Dialogue: 0,0:13:59.19,0:14:00.85,Default,,0,0,0,,Мен ән айтуым керек еді
Dialogue: 0,0:14:02.67,0:14:04.02,Default,,0,0,0,,Ешкім үшін емес
Dialogue: 0,0:14:04.60,0:14:07.43,Default,,0,0,0,,Осы адамға арналған махаббат жыры...
Dialogue: 0,0:14:11.16,0:14:12.38,Default,,0,0,0,,Эй, біз келдік.
Dialogue: 0,0:14:13.68,0:14:15.42,Default,,0,0,0,,Әңгіменің соңы, кеттік.
Dialogue: 0,0:14:17.45,0:14:18.02,Default,,0,0,0,,А, жақсы
Dialogue: 0,0:14:19.54,0:14:20.20,Default,,0,0,0,,Оказаки
Dialogue: 0,0:14:20.41,0:14:20.98,Default,,0,0,0,,Иә
Dialogue: 0,0:14:21.81,0:14:24.12,Default,,0,0,0,,Маңызды нәрсені назардан тыс қалдырмаңыз
Dialogue: 0,0:14:25.53,0:14:26.07,Default,,0,0,0,,Иә
Dialogue: 0,0:14:30.80,0:14:31.96,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:33.01,0:14:37.60,Default,,0,0,0,,Менің ойымша, Томоя ең жақсы деп санайтын жолды таңдауы керек.
Dialogue: 0,0:14:39.86,0:14:43.60,Default,,0,0,0,,Мен басқа компанияға ауысамын, бірақ қарсы емеспін.
Dialogue: 0,0:14:43.91,0:14:48.17,Default,,0,0,0,,Иә, бұл Томоя-кунның қажырлы еңбегінің мойындалғанын білдіреді.
Dialogue: 0,0:14:49.47,0:14:50.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:50.51,0:14:51.40,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:14:54.37,0:14:55.58,Default,,0,0,0,,Жарайды, жасайық.
Dialogue: 0,0:14:55.66,0:14:56.22,Default,,0,0,0,,Иә
Dialogue: 0,0:15:00.08,0:15:01.34,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:15:02.06,0:15:04.29,Default,,0,0,0,,Оказаки мырза сізбен ойнамайды ма?
Dialogue: 0,0:15:04.32,0:15:05.79,Default,,0,0,0,,Ха, мен...
Dialogue: 0,0:15:06.01,0:15:09.90,Default,,0,0,0,,Мен балалармен ойнағаннан гөрі оның жанында болғанды жөн көремін.
Dialogue: 0,0:15:11.19,0:15:14.11,Default,,0,0,0,,Расында да Нағиса-чан сұлу болып кетті.
Dialogue: 0,0:15:14.59,0:15:16.58,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:15:17.25,0:15:19.94,Default,,0,0,0,,Менің жас кезімдегідей
Dialogue: 0,0:15:20.02,0:15:21.16,Default,,0,0,0,,Жақсы
Dialogue: 0,0:15:26.73,0:15:28.21,Default,,0,0,0,,Ертең теңіз ме?
Dialogue: 0,0:15:28.87,0:15:30.14,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:15:30.59,0:15:33.85,Default,,0,0,0,,Томоя-кун, менің ойымша, сен қазір мейірімдірек көрінесің.
Dialogue: 0,0:15:33.89,0:15:34.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:35.17,0:15:38.91,Default,,0,0,0,,Бүгін бейтаныс адаммен қуанып сөйлесіп отырдым.
Dialogue: 0,0:15:39.10,0:15:40.52,Default,,0,0,0,,Өте табиғи
Dialogue: 0,0:15:41.85,0:15:44.48,Default,,0,0,0,,Мен мұндай нәрсе тітіркендіргіш деп ойладым.
Dialogue: 0,0:15:45.38,0:15:48.48,Default,,0,0,0,,Мектепте мен көп уақытымды басқа адамдарға қамқорлықпен өткіздім.
Dialogue: 0,0:15:49.03,0:15:50.88,Default,,0,0,0,,Қазір басқаша ма?
Dialogue: 0,0:15:54.07,0:15:54.65,Default,,0,0,0,,Нағиса
Dialogue: 0,0:15:57.27,0:15:57.88,Default,,0,0,0,,Иә
Dialogue: 0,0:16:05.87,0:16:06.90,Default,,0,0,0,,Мен оны ала аламын ба?
Dialogue: 0,0:16:07.07,0:16:08.25,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:16:13.23,0:16:14.82,Default,,0,0,0,,Иә, бұл Оказаки.
Dialogue: 0,0:16:15.61,0:16:16.19,Default,,0,0,0,,Иә
Dialogue: 0,0:16:16.63,0:16:18.66,Default,,0,0,0,,Э-э… ал 16:42-де ол Токио станциясының платформасында өлі күйінде табылды
Dialogue: 0,0:16:20.10,0:16:23.09,Default,,0,0,0,,Томоя-кун, бұл Mitsuzaka Electric компаниясынан.
Dialogue: 0,0:16:23.96,0:16:25.96,Default,,0,0,0,,Мүмкін сіз жұмысты ауыстыруды шешкен шығарсыз.
Dialogue: 0,0:16:27.51,0:16:29.02,Default,,0,0,0,,Сәлеметсіз бе, бұл Оказаки.
Dialogue: 0,0:16:30.13,0:16:31.91,Default,,0,0,0,,Еңбегіңізге рахмет, ұстаз.
Dialogue: 0,0:16:34.55,0:16:35.72,Default,,0,0,0,,Киношита мырзадан?
Dialogue: 0,0:16:36.83,0:16:38.31,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:16:38.60,0:16:39.29,Default,,0,0,0,,Сан дегеніміз не?
Dialogue: 0,0:16:40.76,0:16:41.33,Default,,0,0,0,,Иә
Dialogue: 0,0:16:42.49,0:16:44.56,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:16:44.89,0:16:46.96,Default,,0,0,0,,Көмегің үшін көп рахмет.
Dialogue: 0,0:16:52.03,0:16:52.96,Default,,0,0,0,,Томоя-кун?
Dialogue: 0,0:16:53.00,0:16:55.34,Default,,0,0,0,,Ол әкесінің танысы қоңырау шалғанын айтты.
Dialogue: 0,0:16:56.52,0:16:57.31,Default,,0,0,0,,Не?
Dialogue: 0,0:17:01.11,0:17:02.59,Default,,0,0,0,,Иә, Киношита.
Dialogue: 0,0:17:02.71,0:17:04.40,Default,,0,0,0,,Сәлеметсіз бе, бұл Оказаки.
Dialogue: 0,0:17:04.75,0:17:06.78,Default,,0,0,0,,Томоя-кун, бұл қиын.
Dialogue: 0,0:17:07.33,0:17:10.98,Default,,0,0,0,,Әкеңізді полиция қамауға алды.
Dialogue: 0,0:17:12.03,0:17:14.31,Default,,0,0,0,,Олар ақылсыз мәміле жасағанын айтты.
Dialogue: 0,0:17:14.99,0:17:17.60,Default,,0,0,0,,Тыңдаңыз, мен сізге хабарласуым керек.
Dialogue: 0,0:17:21.85,0:17:25.97,Default,,0,0,0,,Бұл шағын қала, сондықтан қауесет тез тарады.
Dialogue: 0,0:17:26.73,0:17:31.19,Default,,0,0,0,,Кешіріңіз, бірақ екінші тарап бұл оқиға ешқашан болмағандай кейіп көрсетуімді өтінді.
Dialogue: 0,0:17:32.32,0:17:33.18,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:34.39,0:17:38.57,Default,,0,0,0,,Әрине, мұнда әдеттегідей жұмысты жалғастыруға болады.
Dialogue: 0,0:17:40.19,0:17:42.78,Default,,0,0,0,,Бұл уақыт өте нашар болды.
Dialogue: 0,0:17:44.03,0:17:45.46,Default,,0,0,0,,Көңіліңді түсірме
Dialogue: 0,0:17:49.41,0:17:50.03,Default,,0,0,0,,Нағиса
Dialogue: 0,0:17:50.82,0:17:51.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:51.86,0:17:53.57,Default,,0,0,0,,Екеуміз осы қаладан кетеміз бе?
Dialogue: 0,0:17:54.49,0:17:56.00,Default,,0,0,0,,Мен бұл жолы не болғанын түсіндім.
Dialogue: 0,0:17:56.60,0:17:58.47,Default,,0,0,0,,Мені сол жігіт қарғады.
Dialogue: 0,0:17:59.80,0:18:02.51,Default,,0,0,0,,Мен оның қарғысы маған жетпейтін жерде қайталап көргім келеді.
Dialogue: 0,0:18:03.85,0:18:04.93,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:05.38,0:18:06.26,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:18:07.02,0:18:08.56,Default,,0,0,0,,Бұл қашу туралы
Dialogue: 0,0:18:09.09,0:18:11.07,Default,,0,0,0,,Сіз мұндай нәрседен құтыла алмайсыз.
Dialogue: 0,0:18:14.14,0:18:16.37,Default,,0,0,0,,Мені қуантқаныңды қалаймын.
Dialogue: 0,0:18:16.80,0:18:17.91,Default,,0,0,0,,Осы қалада
Dialogue: 0,0:18:18.19,0:18:21.14,Default,,0,0,0,,Бірақ сіз бұл қалада болмасаңыз да жасай аласыз.
Dialogue: 0,0:18:23.59,0:18:26.41,Default,,0,0,0,,Саған тек мен ғана керек екенін айтпайсың ба?
Dialogue: 0,0:18:28.17,0:18:32.29,Default,,0,0,0,,Томоя-кун менімен болғанша, мен кез келген жерге барамын.
Dialogue: 0,0:18:33.13,0:18:35.43,Default,,0,0,0,,Бірақ мен бұл қаладан шыққанда
Dialogue: 0,0:18:35.47,0:18:37.78,Default,,0,0,0,,Сізде позитивті ойлау керек
Dialogue: 0,0:18:38.37,0:18:42.09,Default,,0,0,0,,Әйтпесе, бұл қайтып келетін жер болмайды.
Dialogue: 0,0:18:44.31,0:18:47.41,Default,,0,0,0,,Бұл қала біздің туған жеріміз
Dialogue: 0,0:18:48.03,0:18:49.81,Default,,0,0,0,,Бұл біздің қала.
Dialogue: 0,0:18:51.52,0:18:53.47,Default,,0,0,0,,Жақсы ештеңе болмаса да?
Dialogue: 0,0:18:55.39,0:18:57.57,Default,,0,0,0,,Менде көп нәрсе болды
Dialogue: 0,0:18:59.62,0:19:02.67,Default,,0,0,0,,Ең бастысы, мен Томоя-кунмен кездесе алдым.
Dialogue: 0,0:19:16.66,0:19:17.64,Default,,0,0,0,,Сіз
Dialogue: 0,0:19:19.11,0:19:21.80,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:19:23.46,0:19:26.41,Default,,0,0,0,,Басқа адамдардың өміріне араласқанды ұнатасыз ба?
Dialogue: 0,0:19:28.25,0:19:30.81,Default,,0,0,0,,Мен сізді ата-ана ретінде ойламаймын.
Dialogue: 0,0:19:31.24,0:19:34.48,Default,,0,0,0,,Бірақ әлем олай ойламайды.
Dialogue: 0,0:19:35.34,0:19:37.10,Default,,0,0,0,,Мен сенің ұлыңмын
Dialogue: 0,0:19:40.20,0:19:43.07,Default,,0,0,0,,Әй, сенің енді сөйлескің келмейді.
Dialogue: 0,0:19:44.03,0:19:47.71,Default,,0,0,0,,Қиындық туғызған ұлыңызға айтар сөзіңіз жоқ па?
Dialogue: 0,0:19:51.43,0:19:52.86,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:19:52.90,0:19:53.77,Default,,0,0,0,,Томоя-кун
Dialogue: 0,0:19:55.23,0:19:58.80,Default,,0,0,0,,Жетер, басқа айтар ештеңе жоқ.
Dialogue: 0,0:19:59.46,0:20:01.30,Default,,0,0,0,,Өмір бойы осылай өмір сүр.
Dialogue: 0,0:20:01.34,0:20:02.25,Default,,0,0,0,,Томоя-кун
Dialogue: 0,0:20:10.82,0:20:11.95,Default,,0,0,0,,Томоя-кун
Dialogue: 0,0:20:13.84,0:20:15.12,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:20:21.72,0:20:22.32,Default,,0,0,0,,Томоя…
Dialogue: 0,0:20:25.08,0:20:26.70,Default,,0,0,0,,Сіз не істеп жатырсыз? ?
Dialogue: 0,0:20:39.14,0:20:40.16,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:46.14,0:20:47.20,Default,,0,0,0,,Томоя-кун
Dialogue: 0,0:20:47.45,0:20:48.55,Default,,0,0,0,,Томоя-кун!
Dialogue: 0,0:21:08.42,0:21:10.38,Default,,0,0,0,,Қолыңыз ауырады ма?
Dialogue: 0,0:21:11.25,0:21:11.85,Default,,0,0,0,,О
Dialogue: 0,0:21:12.25,0:21:14.77,Default,,0,0,0,,Мен суға түскенде ауыратынына сенімдімін.
Dialogue: 0,0:21:15.80,0:21:16.59,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:21:20.24,0:21:20.93,Default,,0,0,0,,Нағиса
Dialogue: 0,0:21:21.27,0:21:21.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:21.98,0:21:22.92,Default,,0,0,0,,Ағаш қоршауға барып, оны ұстап, бір-бірімізден ажырайық.
Dialogue: 0,0:21:24.94,0:21:25.47,Default,,0,0,0,,Иә
Dialogue: 0,0:21:31.14,0:21:31.89,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:21:32.30,0:21:36.64,Default,,0,0,0,,Мен де әрқашан Томоядан басқа ешкім жоқ деп ойлайтынмын.
Dialogue: 0,0:21:37.69,0:21:40.84,Default,,0,0,0,,Мынадай, мен аяныштымын...
Dialogue: 0,0:21:40.93,0:21:42.77,Default,,0,0,0,,Мен де аяныштымын.
Dialogue: 0,0:21:43.24,0:21:47.63,Default,,0,0,0,,Бірақ біз бірге күшті бола аламыз.
Dialogue: 0,0:21:53.55,0:21:56.65,Default,,0,0,0,,Менің қасымда мәңгі қаласың ба?
Dialogue: 0,0:21:57.91,0:22:00.54,Default,,0,0,0,,Иә, мен әрқашан сенің жаныңда боламын.
Dialogue: 0,0:22:01.47,0:22:04.55,Default,,0,0,0,,Кез келген уақытта және мәңгі
Dialogue: 0,0:22:18.60,0:22:25.82,Default,,0,0,0,,Мен өтіп бара жатқан бұлттарға қарап тұрдым
Dialogue: 0,0:22:26.12,0:22:32.75,Default,,0,0,0,,Аспан түсінің өзгергенін сезіндім
Dialogue: 0,0:22:33.63,0:22:40.96,Default,,0,0,0,,Тоқтаған біз, түсіндік
Dialogue: 0,0:22:41.29,0:22:48.15,Default,,0,0,0,,Өзгермелі дүние иірген ән
Dialogue: 0,0:22:48.24,0:22:55.42,Default,,0,0,0,,Саусақтарын созып тартқандай
Dialogue: 0,0:22:55.63,0:23:03.88,Default,,0,0,0,,Бір өзгеріссіз қалатын нәрсені іздеңіз
Dialogue: 0,0:23:04.37,0:23:11.58,Default,,0,0,0,,Сіз ұстаған қолыңыздағы шам
Dialogue: 0,0:23:11.73,0:23:19.39,Default,,0,0,0,,Ертеңге апаратын шағын бағдаршам
Dialogue: 0,0:23:19.39,0:23:26.63,Default,,0,0,0,,Ол әлі күнге дейін жаңғырып тұр
Dialogue: 0,0:23:26.91,0:23:34.26,Default,,0,0,0,,Сол күнгі сөздерді антқа өзгертіңіз
Dialogue: 0,0:23:34.37,0:23:39.11,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:23:40.43,0:23:42.66,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:23:43.12,0:23:45.93,Default,,0,0,0,,Бұған ешкім мән бермейді.
Dialogue: 0,0:23:46.49,0:23:49.03,Default,,0,0,0,,Нагиса, мен және Акио-сан.
Dialogue: 0,0:23:49.77,0:23:51.41,Default,,0,0,0,,Бірақ әлем қамқорлық жасайды
Dialogue: 0,0:23:52.18,0:23:55.53,Default,,0,0,0,,Негізі мен жұмысымнан айырылдым.
Dialogue: 0,0:23:56.06,0:23:59.13,Default,,0,0,0,,Бірақ бір ғана жол емес.
Dialogue: 0,0:24:00.34,0:24:02.96,Default,,0,0,0,,Хмф, мынау маған ұқсайды.
Dialogue: 0,0:24:03.56,0:24:06.27,Default,,0,0,0,,Мен ересек болғым келгендіктен қатты толқыдым.
Dialogue: 0,0:24:06.48,0:24:08.23,Default,,0,0,0,,Мен әлі бала болсам да
Dialogue: 0,0:24:09.73,0:24:14.73,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
