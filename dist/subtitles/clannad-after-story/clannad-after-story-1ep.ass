Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Біз ғимараттан шықтық.
Dialogue: 0,0:00:08.30,0:00:10.33,Default,,0,0,0,,Алысқа бармаңыз
Dialogue: 0,0:00:12.15,0:00:14.58,Default,,0,0,0,,Сіз үйге бара алмайсыз.
Dialogue: 0,0:00:16.17,0:00:18.68,Default,,0,0,0,,Бұл біткен дүние
Dialogue: 0,0:00:19.43,0:00:21.53,Default,,0,0,0,,Бізден басқа ешкім жоқ
Dialogue: 0,0:00:22.77,0:00:26.76,Default,,0,0,0,,Біз өмір сүруге көмектесетін қоқыстарды іздедік.
Dialogue: 0,0:00:28.14,0:00:32.35,Default,,0,0,0,,Олар да өмірлік құралдарды өздері табуы керек.
Dialogue: 0,0:00:35.50,0:00:38.47,Default,,0,0,0,,Мынаны да, мынаны да алайық.
Dialogue: 0,0:01:40.63,0:01:41.59,Default,,0,0,0,,Бұл қорқынышты болды ма?
Dialogue: 0,0:01:45.90,0:01:47.39,Default,,0,0,0,,Эрен сияқты, бронясымен және Коллоссал Титанмен
Dialogue: 0,0:01:50.58,0:01:51.39,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:00.65,0:02:01.73,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:02:05.25,0:02:07.16,Default,,0,0,0,,Жұмсақ иіс шықты.
Dialogue: 0,0:02:28.03,0:02:33.47,Default,,0,0,0,,Сен ғана өткен төбеден түсіп келе жатқанда
Dialogue: 0,0:02:33.61,0:02:39.04,Default,,0,0,0,,Көптеген жылы күн дақтары пайда болды.
Dialogue: 0,0:02:39.17,0:02:44.32,Default,,0,0,0,,Мен ғана мейірімдімін.
Dialogue: 0,0:02:44.46,0:02:51.62,Default,,0,0,0,,Жылылықты еске түсіру
Dialogue: 0,0:02:52.08,0:02:59.92,Default,,0,0,0,,Тек сен, тек сен
Dialogue: 0,0:02:59.92,0:03:05.77,Default,,0,0,0,,Мен сені сүйдім
Dialogue: 0,0:03:05.91,0:03:13.59,Default,,0,0,0,,Жел көзімді бұлдыратады
Dialogue: 0,0:03:13.71,0:03:20.21,Default,,0,0,0,,Ол алыс болады
Dialogue: 0,0:03:20.50,0:03:23.02,Default,,0,0,0,,Мен сені мәңгі есте сақтаймын
Dialogue: 0,0:03:22.62,0:03:25.04,Default,,0,0,0,,Бәрі өзгерсе де
Dialogue: 0,0:03:24.64,0:03:27.10,Default,,0,0,0,,Бір ғана Бір ғана
Dialogue: 0,0:03:26.70,0:03:29.79,Default,,0,0,0,,Қарапайым болса да
Dialogue: 0,0:03:29.39,0:03:34.00,Default,,0,0,0,,Мен сендерге жарқыраған бір нәрсені көрсетемін
Dialogue: 0,0:03:33.50,0:03:38.81,Default,,0,0,0,,Мен сені мәңгілікке қорғаймын.
Dialogue: 0,0:03:46.00,0:03:47.91,Default,,0,0,0,,Бүгін тағы да мектеп асханасында түскі ас ішіп жатырсыз ба?
Dialogue: 0,0:03:48.33,0:03:50.69,Default,,0,0,0,,Сіз жаңа ғана келдіңіз.
Dialogue: 0,0:03:50.76,0:03:51.29,Default,,0,0,0,,Иә
Dialogue: 0,0:03:51.72,0:03:53.91,Default,,0,0,0,,Сөйлеу алдында дұрыс тербеліңіз
Dialogue: 0,0:03:54.17,0:03:55.80,Default,,0,0,0,,Әйтпесе ол істен шығады.
Dialogue: 0,0:03:59.28,0:04:01.75,Default,,0,0,0,,Жарайды, қайталап көрейік.
Dialogue: 0,0:04:03.13,0:04:04.96,Default,,0,0,0,,Сәлем Оказаки Сәлем.
Dialogue: 0,0:04:05.38,0:04:07.08,Default,,0,0,0,,Бүгін тағы да мектеп асханасында түскі ас ішіп отырсыз ба?
Dialogue: 0,0:04:08.37,0:04:09.66,Default,,0,0,0,,Бұл сергітеді.
Dialogue: 0,0:04:09.92,0:04:10.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.12,0:04:13.30,Default,,0,0,0,,Сіз үшін тым сергітеді
Dialogue: 0,0:04:13.56,0:04:15.85,Default,,0,0,0,,Кейіпкерлердің әртүрлі болғаны сонша, маған ұнамай қалды.
Dialogue: 0,0:04:15.87,0:04:17.43,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:04:17.56,0:04:20.50,Default,,0,0,0,,Сөйлемнің соңына әрқашан «және дәретхана орындықтарының қақпағын» қосыңыз.
Dialogue: 0,0:04:20.86,0:04:24.28,Default,,0,0,0,,Осылай жасасаң, балғындық өшіп, өзіңе ұқсайсың.
Dialogue: 0,0:04:26.91,0:04:27.85,Default,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:04:28.41,0:04:30.22,Default,,0,0,0,,Маған ұнаса, мен мұны істеймін ...
Dialogue: 0,0:04:33.24,0:04:37.26,Default,,0,0,0,,Е, Мэй тағы Нагиса-чанмен қалды ма?
Dialogue: 0,0:04:37.67,0:04:39.84,Default,,0,0,0,,Мен бұған мүлдем қарсы емеспін.
Dialogue: 0,0:04:40.03,0:04:42.18,Default,,0,0,0,,Мей Чанды бәрі жақсы көреді
Dialogue: 0,0:04:43.24,0:04:47.35,Default,,0,0,0,,Ол ұсыныстан бас тарту үшін үйіне және мектебіне телефон соққанға ұқсайды.
Dialogue: 0,0:04:47.71,0:04:49.93,Default,,0,0,0,,Мен сені уайымдап отырмын.
Dialogue: 0,0:04:50.11,0:04:50.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:51.31,0:04:53.74,Default,,0,0,0,,Үлкен аға, үшінші курстың екінші семестрі.
Dialogue: 0,0:04:53.74,0:04:55.74,Default,,0,0,0,,Мен мансап жолымды әлі шешкен жоқпын.
Dialogue: 0,0:04:56.42,0:04:58.91,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, мен үйге бара алмаймын.
Dialogue: 0,0:04:59.29,0:05:03.10,Default,,0,0,0,,Мэй Чан әңгімені кейінірек тыңдағысы келетінін айтты.
Dialogue: 0,0:05:03.30,0:05:08.31,Default,,0,0,0,,Сунохара мырза, сіздің болашақ мақсаттарыңыз немесе орындағыңыз келетін істеріңіз бар ма?
Dialogue: 0,0:05:09.54,0:05:11.64,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:05:12.03,0:05:13.75,Default,,0,0,0,,Өйткені жоғары оқу орнына түсу мүмкін емес
Dialogue: 0,0:05:13.83,0:05:16.93,Default,,0,0,0,,Жұмысқа орналасып, дұрыс жұмыс істе
Dialogue: 0,0:05:19.23,0:05:22.81,Default,,0,0,0,,Менің де бір ғашығым болса ғой.
Dialogue: 0,0:05:22.88,0:05:25.24,Default,,0,0,0,,Менің әпкемнің де жеңіл боларына сенімдімін.
Dialogue: 0,0:05:26.02,0:05:26.82,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:05:28.86,0:05:34.24,Default,,0,0,0,,Басқаша айтқанда, сізге болашақты уәде еткен сүйіктіңіз бар деп болжасаңыз болғаны.
Dialogue: 0,0:05:34.32,0:05:36.62,Default,,0,0,0,,Сонда Мэй Чан өзін еркін сезінеді.
Dialogue: 0,0:05:36.85,0:05:38.75,Default,,0,0,0,,Өтірік айту жақсы емес деп ойлаймын.
Dialogue: 0,0:05:38.79,0:05:41.19,Default,,0,0,0,,Бұл жұмыс істей ме?
Dialogue: 0,0:05:41.36,0:05:45.12,Default,,0,0,0,,Мен саған айтамын, сен онша ұсқынсыз емессің.
Dialogue: 0,0:05:45.33,0:05:48.77,Default,,0,0,0,,Оның сәби жүзі бар және сіздің аналық бейнеқосылғыларыңызды қытықтайтын түрі.
Dialogue: 0,0:05:48.94,0:05:51.02,Default,,0,0,0,,Біздің мектептегі ең жақсы сәби тұлға
Dialogue: 0,0:05:51.19,0:05:52.69,Default,,0,0,0,,Бала Сунохара
Dialogue: 0,0:05:53.42,0:05:54.85,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:05:55.28,0:05:56.62,Default,,0,0,0,,Тіпті жалған дос қыз
Dialogue: 0,0:05:56.64,0:06:00.17,Default,,0,0,0,,Бұл шын мәнінде танысуды бастауға мүмкіндік болуы мүмкін.
Dialogue: 0,0:06:00.21,0:06:02.54,Default,,0,0,0,,О, Оказаки Сиқыр?
Dialogue: 0,0:06:02.72,0:06:05.05,Default,,0,0,0,,Мен әйтеуір ынталы сезінемін.
Dialogue: 0,0:06:06.27,0:06:09.93,Default,,0,0,0,,Томоя-кун, сен жай ғана көңіл көтеріп жатқан жоқсың ба?
Dialogue: 0,0:06:10.29,0:06:12.23,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:06:12.27,0:06:13.64,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:06:13.64,0:06:16.61,Default,,0,0,0,,Айтқаныңызды бірден тыңдайтын сияқты, тыныш қыз.
Dialogue: 0,0:06:16.65,0:06:18.75,Default,,0,0,0,,Сіз шынымен сорақысыз.
Dialogue: 0,0:06:18.79,0:06:20.67,Default,,0,0,0,,Аа, мен дәл таптым.
Dialogue: 0,0:06:22.31,0:06:22.93,Default,,0,0,0,,Міне!
Dialogue: 0,0:06:22.97,0:06:25.23,Default,,0,0,0,,Бір минут күте тұрыңыз, сіз одан сұрап жатырсыз ба?
Dialogue: 0,0:06:31.52,0:06:33.65,Default,,0,0,0,,Сіз соншалықты таң қалмас едіңіз, солай ма?
Dialogue: 0,0:06:33.72,0:06:36.14,Default,,0,0,0,,Жалғыз сыңай таныту, жай кейіп көрсету~
Dialogue: 0,0:06:36.14,0:06:38.84,Default,,0,0,0,,Егер қолыңнан келмесе, бас тартуға болады.
Dialogue: 0,0:06:39.22,0:06:43.19,Default,,0,0,0,,Мұның қандай жігіт екенін жақсы білесіз.
Dialogue: 0,0:06:43.96,0:06:45.48,Default,,0,0,0,,Мүмкін емес Бұл мүмкін емес
Dialogue: 0,0:06:45.52,0:06:47.69,Default,,0,0,0,,Бұл мен үшін тым ауыр
Dialogue: 0,0:06:48.29,0:06:50.85,Default,,0,0,0,,Мен бұл туралы ойлаған сайын ыңғайсызданамын.
Dialogue: 0,0:06:51.78,0:06:52.66,Default,,0,0,0,,…
Dialogue: 0,0:06:54.19,0:06:56.31,Default,,0,0,0,,Муку-чан, өтінемін, жылама.
Dialogue: 0,0:06:58.89,0:07:03.03,Default,,0,0,0,,Мен мұндай нәрселерді көргенде, өзімді одан сайын күштеп алғым келеді.
Dialogue: 0,0:07:03.58,0:07:05.93,Default,,0,0,0,,Сіз осындай нәрселерді айтып жатырсыз ...
Dialogue: 0,0:07:16.17,0:07:17.38,Default,,0,0,0,,Амансың ба? Муку
Dialogue: 0,0:07:17.42,0:07:18.45,Default,,0,0,0,,Сізді қорлады ма?
Dialogue: 0,0:07:19.27,0:07:22.04,Default,,0,0,0,,Жарайды, олай емес.
Dialogue: 0,0:07:22.08,0:07:25.62,Default,,0,0,0,,Балалар, менің сүйкімді әпкемді не істедіңдер?
Dialogue: 0,0:07:27.07,0:07:28.63,Default,,0,0,0,,Бұл түсінбеушілік, Ан-чан.
Dialogue: 0,0:07:29.11,0:07:32.39,Default,,0,0,0,,Негізі Суохара мырзаның жалған ғашығы бар еді...
Dialogue: 0,0:07:32.79,0:07:34.80,Default,,0,0,0,,Бұл туралы Анзудан сұрауым керек пе?
Dialogue: 0,0:07:35.57,0:07:38.15,Default,,0,0,0,,Сіз келісесіз деп ойлаймын.
Dialogue: 0,0:07:38.37,0:07:40.38,Default,,0,0,0,,Оның осындай мінезі бар...
Dialogue: 0,0:07:40.46,0:07:42.40,Default,,0,0,0,,Ол қатыгез және тез ашуланады.
Dialogue: 0,0:07:42.46,0:07:45.38,Default,,0,0,0,,Ақылға сыймайтын сөздер айтып, мені жұмыс ретінде пайдаланады.
Dialogue: 0,0:07:45.42,0:07:47.73,Default,,0,0,0,,Сіз оны мүмкіндігінше қатты ести аласыз, солай ма?
Dialogue: 0,0:07:49.16,0:07:50.61,Default,,0,0,0,,Қайта айтайын ба?
Dialogue: 0,0:07:50.96,0:07:52.34,Default,,0,0,0,,Айтып алсаң, сауап.
Dialogue: 0,0:07:52.44,0:07:56.03,Default,,0,0,0,,Мен қолымды тамағыңнан төмен түсіріп, дауыс байламыңды жұлып аламын.
Dialogue: 0,0:07:56.07,0:07:57.74,Default,,0,0,0,,SUBIBAZEN
Dialogue: 0,0:07:58.50,0:07:59.85,Default,,0,0,0,,Сіз кешірім сұрадыңыз!
Dialogue: 0,0:08:01.19,0:08:04.23,Default,,0,0,0,,Кешірім сұраған бетте ақау бар.
Dialogue: 0,0:08:06.13,0:08:07.15,Default,,0,0,0,,Кеттік, Мұку.
Dialogue: 0,0:08:07.17,0:08:08.99,Default,,0,0,0,,Қасымда болсаң мен сені ақымақ ұстаймын.
Dialogue: 0,0:08:09.16,0:08:10.15,Default,,0,0,0,,Иә
Dialogue: 0,0:08:13.45,0:08:16.53,Default,,0,0,0,,Неліктен еркектерде мұндай нәзіктік болмайды?
Dialogue: 0,0:08:16.73,0:08:17.76,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:08:20.99,0:08:24.49,Default,,0,0,0,,Сунохара мырза, сіз жақсы екеніңізге сенімдісіз бе?
Dialogue: 0,0:08:24.66,0:08:25.61,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:08:25.75,0:08:30.08,Default,,0,0,0,,Студент қыздар оны қорлаған кезде бұл жігіт ең көп жарқырайды.
Dialogue: 0,0:08:30.12,0:08:32.18,Default,,0,0,0,,Жаңылыстыратын сөздерді айтпа
Dialogue: 0,0:08:32.97,0:08:35.84,Default,,0,0,0,,Бірақ егер Фудзибаяши мен Анзу сәтсіздікке ұшыраса.
Dialogue: 0,0:08:35.98,0:08:38.42,Default,,0,0,0,,Тағы кім қабылдауға дайын болуы мүмкін...
Dialogue: 0,0:08:42.15,0:08:45.37,Default,,0,0,0,,Неліктен Томойо-саннан сұрамасқа?
Dialogue: 0,0:08:45.96,0:08:46.59,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:08:46.81,0:08:51.35,Default,,0,0,0,,Менің ойымша, ол әдемі, қамқор және тамаша адам.
Dialogue: 0,0:08:51.58,0:08:53.25,Default,,0,0,0,,Оны тоқтатқан дұрыс.
Dialogue: 0,0:08:53.27,0:08:54.63,Default,,0,0,0,,Мына жігіт те қорқады
Dialogue: 0,0:08:54.67,0:08:57.72,Default,,0,0,0,,Кім шошып кетті?
Dialogue: 0,0:08:57.79,0:08:59.40,Default,,0,0,0,,Тағы бір «би» бар
Dialogue: 0,0:08:59.84,0:09:02.21,Default,,0,0,0,,Әзірше терең дем алып, тынышталыңыз.
Dialogue: 0,0:09:06.47,0:09:08.00,Default,,0,0,0,,Жарайды, мен жақсы бала туамын.
Dialogue: 0,0:09:08.23,0:09:10.56,Default,,0,0,0,,Сунохара мырза, мен абдырап қалдым.
Dialogue: 0,0:09:10.77,0:09:14.60,Default,,0,0,0,,Ойлап қарасаңыз, ол жігіт екеуміз тағдырлас бақталас едік.
Dialogue: 0,0:09:15.18,0:09:17.70,Default,,0,0,0,,Бетпе-бет кездескенде ылғи ұрысатынбыз.
Dialogue: 0,0:09:21.79,0:09:22.48,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:22.73,0:09:24.69,Default,,0,0,0,,Сіз әдеттен тыс уайымдап тұрған сияқтысыз.
Dialogue: 0,0:09:24.92,0:09:27.32,Default,,0,0,0,,Хмф, оның сізге қатысы жоқ.
Dialogue: 0,0:09:28.55,0:09:29.96,Default,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:09:31.73,0:09:32.53,Default,,0,0,0,,Бірақ білесің бе—
Dialogue: 0,0:09:34.97,0:09:38.92,Default,,0,0,0,,Сенің менен басқа ешкім өлтіргеніңді көргім келмейді.
Dialogue: 0,0:09:42.99,0:09:45.33,Default,,0,0,0,,Бір-бірінің қабілетін танитын адамдар
Dialogue: 0,0:09:45.46,0:09:49.08,Default,,0,0,0,,Ішіміздің түбінде біз жылы сезіммен бөлісеміз.
Dialogue: 0,0:09:49.13,0:09:50.34,Default,,0,0,0,,Мен таңдандым
Dialogue: 0,0:09:50.94,0:09:52.55,Default,,0,0,0,,Сондықтан мен барамын
Dialogue: 0,0:09:56.10,0:09:58.57,Default,,0,0,0,,Шайдың ащысы – танин деп аталатын зат.
Dialogue: 0,0:09:58.77,0:10:02.83,Default,,0,0,0,,Мен оны кетіру үшін ас содасын жиі қолданамын, бірақ егер...
Dialogue: 0,0:10:06.82,0:10:09.02,Default,,0,0,0,,Олай болмаса, сірке суы жақсы болар еді деп ойлаймын.
Dialogue: 0,0:10:09.10,0:10:10.56,Default,,0,0,0,,Оны елемеңіз!
Dialogue: 0,0:10:10.68,0:10:13.24,Default,,0,0,0,,Сакагами мырза, сіз бұл адамды танисыз ба?
Dialogue: 0,0:10:13.44,0:10:14.55,Default,,0,0,0,,Алыс болыңыз
Dialogue: 0,0:10:14.59,0:10:16.19,Default,,0,0,0,,Көзге тию қауіпті
Dialogue: 0,0:10:17.01,0:10:19.17,Default,,0,0,0,,Адамдарды хайуан деп атама!
Dialogue: 0,0:10:19.27,0:10:22.18,Default,,0,0,0,,Томойо-сан, мені тыңдашы.
Dialogue: 0,0:10:22.69,0:10:26.37,Default,,0,0,0,,Кога мырза, кеше бейсбол қызықты болды.
Dialogue: 0,0:10:27.22,0:10:30.33,Default,,0,0,0,,Иә, Томойо-сан жақсы болды.
Dialogue: 0,0:10:31.68,0:10:34.55,Default,,0,0,0,,Мен сені бірінші рет Кога-сан деп атадым.
Dialogue: 0,0:10:35.20,0:10:36.39,Default,,0,0,0,,Қарсысыз ба?
Dialogue: 0,0:10:36.56,0:10:39.12,Default,,0,0,0,,Әрине, мен бақыттымын.
Dialogue: 0,0:10:39.17,0:10:41.78,Default,,0,0,0,,Екеумізді қуанта алмайсыз ба?
Dialogue: 0,0:10:41.83,0:10:43.87,Default,,0,0,0,,Не, сен әлі осындасың ба?
Dialogue: 0,0:10:44.12,0:10:47.52,Default,,0,0,0,,Мен сенің менен бір жақсылығың бар деп естідім. Тыңдап жібересің бе?
Dialogue: 0,0:10:49.42,0:10:54.05,Default,,0,0,0,,Балалар сендер менен ештеңе сұрамайсыңдар.
Dialogue: 0,0:10:55.84,0:10:58.07,Default,,0,0,0,,Мен қазір уайымдап тұрмын.
Dialogue: 0,0:10:58.54,0:11:01.28,Default,,0,0,0,,Бұл әдеттегі ауа райы сияқты?
Dialogue: 0,0:11:01.59,0:11:04.01,Default,,0,0,0,,Хмф, оның сізге қатысы жоқ.
Dialogue: 0,0:11:04.05,0:11:05.61,Default,,0,0,0,,Олай болса, мүлде жоқ.
Dialogue: 0,0:11:05.65,0:11:06.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:06.69,0:11:10.18,Default,,0,0,0,,Айтыңызшы: «Менен басқа ешкім сені өлтіргенін көргім келмейді!
Dialogue: 0,0:11:10.22,0:11:11.18,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:11:11.21,0:11:12.90,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:11:12.94,0:11:15.44,Default,,0,0,0,,Айтыңызшы, әңгіме өрбімейді.
Dialogue: 0,0:11:18.03,0:11:22.16,Default,,0,0,0,,Сенің менен басқа ешкім өлтіргеніңді көргім келмейді.
Dialogue: 0,0:11:22.91,0:11:24.47,Default,,0,0,0,,Кім өлтіріледі?
Dialogue: 0,0:11:24.76,0:11:25.96,Default,,0,0,0,,Неге мұнда...
Dialogue: 0,0:11:27.37,0:11:30.03,Default,,0,0,0,,Ұрыс таңдағыңыз келсе, айтыңыз.
Dialogue: 0,0:11:30.53,0:11:33.74,Default,,0,0,0,,Олай болса, Кога Оказаки мырза
Dialogue: 0,0:11:35.66,0:11:36.90,Default,,0,0,0,,Өте керемет~
Dialogue: 0,0:11:36.97,0:11:38.55,Default,,0,0,0,,Сакагами мырза күткендей
Dialogue: 0,0:11:41.46,0:11:43.92,Default,,0,0,0,,Жарайды, мен саған көмектесемін.
Dialogue: 0,0:11:43.98,0:11:44.58,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:11:44.80,0:11:46.88,Default,,0,0,0,,Котоми-чан мейірімді
Dialogue: 0,0:11:47.13,0:11:49.99,Default,,0,0,0,,Мен досыма көмектескім келеді.
Dialogue: 0,0:11:50.16,0:11:52.67,Default,,0,0,0,,Маған не істеу керектігін айтқаныңызды қалаймын.
Dialogue: 0,0:11:53.01,0:11:54.55,Default,,0,0,0,,Егер сіз кездесіп жүрсеңіз
Dialogue: 0,0:11:54.59,0:11:58.42,Default,,0,0,0,,Менің ойымша, біз бірге ойнаймыз және әр түрлі қызықты нәрселер жасаймыз.
Dialogue: 0,0:11:58.62,0:11:59.50,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:11:59.88,0:12:00.95,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:12:01.97,0:12:02.94,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:12:05.84,0:12:08.38,Default,,0,0,0,,Өйткені сіз ақымақ нәрсе айтасыз
Dialogue: 0,0:12:08.68,0:12:11.27,Default,,0,0,0,,Скрипка Сіз оны жөндеген жоқсыз ба?
Dialogue: 0,0:12:11.31,0:12:14.42,Default,,0,0,0,,Иә, мен бұрынғыдан да жақсы дыбыс шығара аламын.
Dialogue: 0,0:12:14.44,0:12:16.89,Default,,0,0,0,,Дәлірек айтсақ, ол қосылды, солай ма?
Dialogue: 0,0:12:18.83,0:12:21.03,Default,,0,0,0,,Сунохара мырза, жақсысыз ба?
Dialogue: 0,0:12:21.17,0:12:23.78,Default,,0,0,0,,Мен ОК алғаныма қарамастан.
Dialogue: 0,0:12:24.22,0:12:27.54,Default,,0,0,0,,Менің ол дыбысқа шыдауға батылым жетпейді.
Dialogue: 0,0:12:27.97,0:12:29.02,Default,,0,0,0,,Көңіліңізді түсірмеңіз
Dialogue: 0,0:12:29.06,0:12:31.25,Default,,0,0,0,,Әлі де үміт бар
Dialogue: 0,0:12:32.15,0:12:33.41,Default,,0,0,0,,Миязава сонда ма?
Dialogue: 0,0:12:34.54,0:12:39.08,Default,,0,0,0,,Оказаки мырза, Кога мырза және Суохара мырза, біраз уақыт өтті.
Dialogue: 0,0:12:39.31,0:12:42.26,Default,,0,0,0,,Иә, біраз уақыт болды, Миадзава-сан.
Dialogue: 0,0:12:42.30,0:12:43.50,Default,,0,0,0,,Юкине-чан?
Dialogue: 0,0:12:43.98,0:12:47.49,Default,,0,0,0,,Менің айтқанымды тыңдайтыныңызға сенімдімін.
Dialogue: 0,0:12:48.91,0:12:51.16,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:12:52.41,0:12:54.28,Default,,0,0,0,,Бұл жалған қыз ба?
Dialogue: 0,0:12:54.34,0:12:56.48,Default,,0,0,0,,Бұл қиын сияқты.
Dialogue: 0,0:12:56.57,0:12:58.22,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:12:58.28,0:13:00.65,Default,,0,0,0,,Мен сені дұрыс жолға саламын.
Dialogue: 0,0:13:00.90,0:13:01.64,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:13:01.93,0:13:02.45,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:03.06,0:13:04.88,Default,,0,0,0,,Сіз мұны біраздан бері сұрап жатырсыз.
Dialogue: 0,0:13:06.34,0:13:07.74,Default,,0,0,0,,Біздің Юки-ниге
Dialogue: 0,0:13:07.74,0:13:10.79,Default,,0,0,0,,Сіз маған өте батыл жақсылық сұрайсыз, солай емес пе?
Dialogue: 0,0:13:10.80,0:13:12.06,Default,,0,0,0,,О? Кола!
Dialogue: 0,0:13:13.47,0:13:14.91,Default,,0,0,0,,Біздің Юки, солай ма?
Dialogue: 0,0:13:15.23,0:13:17.13,Default,,0,0,0,,Миязава мырза, бұл кім?
Dialogue: 0,0:13:17.17,0:13:22.53,Default,,0,0,0,,Бұл менің тұтынушым. Белгілі бір жағдайға байланысты осында жасырынып жүрдім.
Dialogue: 0,0:13:22.57,0:13:24.05,Default,,0,0,0,,Түсінікті айтайын
Dialogue: 0,0:13:24.14,0:13:26.30,Default,,0,0,0,,Юки-ниге қиындық тудырсаңыз
Dialogue: 0,0:13:26.40,0:13:28.05,Default,,0,0,0,,Біз үндемейміз
Dialogue: 0,0:13:28.30,0:13:28.96,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:13:33.44,0:13:36.26,Default,,0,0,0,,А, жоқ, мен өзімді әшкереледім.
Dialogue: 0,0:13:38.41,0:13:40.96,Default,,0,0,0,,Эй Юки, саған бірдеңе керек болса, маған хабарлас.
Dialogue: 0,0:13:41.20,0:13:42.67,Default,,0,0,0,,Мен сол жерде боламын.
Dialogue: 0,0:13:43.64,0:13:45.57,Default,,0,0,0,,Әлі сыртқа шықпаңыз.
Dialogue: 0,0:13:45.61,0:13:46.80,Default,,0,0,0,,Жасырын болуы керек
Dialogue: 0,0:13:47.03,0:13:49.01,Default,,0,0,0,,Кешіріңіз, бұл мен де.
Dialogue: 0,0:13:53.13,0:13:55.22,Default,,0,0,0,,Енді не болды?
Dialogue: 0,0:13:55.56,0:13:58.43,Default,,0,0,0,,Оның да бір ақауы бар сияқты.
Dialogue: 0,0:14:02.05,0:14:04.50,Default,,0,0,0,,Алдын ала кешірім сұраймын.
Dialogue: 0,0:14:04.76,0:14:07.82,Default,,0,0,0,,Мен кешкі ас әзірлеуге көмектесуім керек, сондықтан
Dialogue: 0,0:14:08.23,0:14:10.83,Default,,0,0,0,,Сәттілік, Сунохара-сан.
Dialogue: 0,0:14:14.87,0:14:17.14,Default,,0,0,0,,Қолымнан келгеннің бәрін істе десең де,
Dialogue: 0,0:14:18.32,0:14:21.67,Default,,0,0,0,,Біріншіден, мен оны тегін сұрауға тым құлықсыз болдым.
Dialogue: 0,0:14:21.95,0:14:23.60,Default,,0,0,0,,Сыйлық берейік
Dialogue: 0,0:14:23.80,0:14:25.85,Default,,0,0,0,,Иә? Менде ақша жоқ
Dialogue: 0,0:14:26.11,0:14:27.61,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:14:27.63,0:14:30.78,Default,,0,0,0,,Сенің сүйкімділігің мені бәрібір саған ғашық етеді, солай ма?
Dialogue: 0,0:14:30.86,0:14:33.07,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:14:33.40,0:14:35.29,Default,,0,0,0,,Біріншіден, басқа адамға жағымпаздану.
Dialogue: 0,0:14:35.46,0:14:38.79,Default,,0,0,0,,Сондай-ақ бұл күндері қыздар жасырын.
Dialogue: 0,0:14:38.83,0:14:40.64,Default,,0,0,0,,Мен бұл туралы жеңілдеп қалдым.
Dialogue: 0,0:14:41.15,0:14:43.21,Default,,0,0,0,,Соңында топтық психологияны қолдану
Dialogue: 0,0:14:43.33,0:14:45.55,Default,,0,0,0,,Барлығының не істеп жатқанын белгілеңіз
Dialogue: 0,0:14:46.74,0:14:47.47,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:14:47.70,0:14:48.78,Default,,0,0,0,,Онда мен барамын.
Dialogue: 0,0:14:48.91,0:14:50.09,Default,,0,0,0,,Сәлем құрбым
Dialogue: 0,0:14:50.19,0:14:51.28,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:14:51.43,0:14:52.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.07,0:14:56.41,Default,,0,0,0,,Қазір боссың ба? Мен тек менің әңгімемді тыңдауларыңызды қалаймын.
Dialogue: 0,0:14:56.46,0:14:59.70,Default,,0,0,0,,Шындығында, кейбір жақсы толық емес жұмыс уақыты бар.
Dialogue: 0,0:14:59.88,0:15:02.19,Default,,0,0,0,,Мм, мен асығып тұрмын.
Dialogue: 0,0:15:02.64,0:15:04.62,Default,,0,0,0,,Мен сенің атыңды айтпаймын.
Dialogue: 0,0:15:04.66,0:15:07.63,Default,,0,0,0,,Сондай-ақ, мен сенің ата-анаңа да құпия хат беремін.
Dialogue: 0,0:15:07.63,0:15:11.07,Default,,0,0,0,,Жарайды, барлығы бірдей әрекеттермен айналысады.
Dialogue: 0,0:15:12.43,0:15:15.10,Default,,0,0,0,,Бұл күдікті барлаушы сияқты.
Dialogue: 0,0:15:15.90,0:15:16.61,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:17.70,0:15:19.41,Default,,0,0,0,,Ах, Санае-сан
Dialogue: 0,0:15:20.10,0:15:22.71,Default,,0,0,0,,Сізде қиындық бар ма?
Dialogue: 0,0:15:25.15,0:15:28.83,Default,,0,0,0,,Мен сізге көмектесе аламын ба?
Dialogue: 0,0:15:30.81,0:15:32.55,Default,,0,0,0,,Санаэ-сан, шын айтасың ба?
Dialogue: 0,0:15:33.01,0:15:36.26,Default,,0,0,0,,Бұл Мэйдің ағасынан басқа ешкімге арналған.
Dialogue: 0,0:15:36.44,0:15:38.98,Default,,0,0,0,,Көмектессем қуанар едім.
Dialogue: 0,0:15:39.19,0:15:41.39,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:15:42.28,0:15:45.60,Default,,0,0,0,,Оказаки: Ол адам Нагиса-чанның әпкесі.
Dialogue: 0,0:15:45.73,0:15:46.83,Default,,0,0,0,,Әпке?
Dialogue: 0,0:15:47.13,0:15:49.89,Default,,0,0,0,,А, сен кеше солай айттың.
Dialogue: 0,0:15:50.06,0:15:52.91,Default,,0,0,0,,Яби Нагиса-чанның әпкесі күткендей
Dialogue: 0,0:15:53.12,0:15:55.78,Default,,0,0,0,,Мұқият қарасаңыз, ол шынымен әдемі.
Dialogue: 0,0:15:56.24,0:15:58.51,Default,,0,0,0,,Бұл қызықты болғандықтан, мен сізді адастыруға рұқсат етіңіз.
Dialogue: 0,0:15:59.65,0:16:00.53,Default,,0,0,0,,Ум...
Dialogue: 0,0:16:01.22,0:16:02.96,Default,,0,0,0,,Маған жақсы ма?
Dialogue: 0,0:16:03.41,0:16:04.65,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:16:04.77,0:16:06.30,Default,,0,0,0,,Бірақ Санаэ-сан
Dialogue: 0,0:16:06.41,0:16:09.12,Default,,0,0,0,,Оның жалған қыз екенін бірден білмейсің бе?
Dialogue: 0,0:16:09.44,0:16:12.20,Default,,0,0,0,,Жарайды, бетпердесін киемін.
Dialogue: 0,0:16:13.23,0:16:15.29,Default,,0,0,0,,Сонымен, Санаэ-сан, шын айтасың ба?
Dialogue: 0,0:16:15.52,0:16:17.98,Default,,0,0,0,,Цуки… Цуки…
Dialogue: 0,0:16:23.65,0:16:25.50,Default,,0,0,0,,Менің ағамның қызы бар ма?
Dialogue: 0,0:16:25.88,0:16:28.06,Default,,0,0,0,,Бір-біріне болашақты уәде еткен ғашықтар
Dialogue: 0,0:16:28.37,0:16:30.69,Default,,0,0,0,,Ол керемет сұлу және берік адам.
Dialogue: 0,0:16:32.68,0:16:36.34,Default,,0,0,0,,Мен де жай өмір сүріп жатқан жоқпын.
Dialogue: 0,0:16:36.63,0:16:40.09,Default,,0,0,0,,Мен ересектік баспалдақтарымен бір-бірлеп көтерілемін.
Dialogue: 0,0:16:40.61,0:16:41.57,Default,,0,0,0,,Сізбен танысуға рұқсат етіңіз
Dialogue: 0,0:16:43.05,0:16:44.82,Default,,0,0,0,,Мені де таныстырыңыз
Dialogue: 0,0:16:45.08,0:16:49.57,Default,,0,0,0,,Мен сіңілім ретінде ағамның қандай адамға тұрмысқа шығатынын білгім келеді.
Dialogue: 0,0:16:49.80,0:16:53.10,Default,,0,0,0,,Жарайды, мен одан жоспарлары туралы сұраймын.
Dialogue: 0,0:17:00.04,0:17:03.61,Default,,0,0,0,,Драма үйірмесі әртүрлі костюмдер дайындайды, солай ма?
Dialogue: 0,0:17:03.94,0:17:05.84,Default,,0,0,0,,Мен Мэй Чанмен келесі күні кездесемін.
Dialogue: 0,0:17:06.12,0:17:08.83,Default,,0,0,0,,Ертең датаға репетиция.
Dialogue: 0,0:17:09.06,0:17:10.71,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:17:11.87,0:17:14.28,Default,,0,0,0,,Менің сезімдерім аралас.
Dialogue: 0,0:17:14.76,0:17:18.18,Default,,0,0,0,,Менің анам – менің сыныптасымның сүйіктісі.
Dialogue: 0,0:17:19.43,0:17:20.85,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:17:21.22,0:17:23.87,Default,,0,0,0,,Сунохара жігіті қалықтап келеді.
Dialogue: 0,0:17:23.99,0:17:27.22,Default,,0,0,0,,Менің ойымша Санаэ-сан Нағисаның үлкен әпкесі.
Dialogue: 0,0:17:28.23,0:17:31.89,Default,,0,0,0,,Сіз өзіңіздің әпкеңізсіз бе? Сізге көп рахмет
Dialogue: 0,0:17:31.94,0:17:33.84,Default,,0,0,0,,Жоқ, мен сені мақтап тұрған жоқпын.
Dialogue: 0,0:17:34.22,0:17:39.16,Default,,0,0,0,,Анашым, бәлкім, қайта ойлану керек шығар?
Dialogue: 0,0:17:41.99,0:17:46.41,Default,,0,0,0,,Мен Сунохара мырзаға бейсбол ойнаған кезімізден бері қызығатынмын.
Dialogue: 0,0:17:47.06,0:17:49.62,Default,,0,0,0,,Бір қарағанда ебедейсіз және сәтсіздіктерге толы болып көрінеді, бірақ
Dialogue: 0,0:17:49.89,0:17:52.56,Default,,0,0,0,,Ол шынымен ақ жүректі бала емес пе?
Dialogue: 0,0:17:53.05,0:17:57.65,Default,,0,0,0,,Мүмкіндік болса, іс дұрыс бағытта жүретініне сенімдімін.
Dialogue: 0,0:17:59.48,0:18:02.54,Default,,0,0,0,,Мен сізге көмектескім келеді.
Dialogue: 0,0:18:03.03,0:18:08.64,Default,,0,0,0,,Жарайды, анаң айтса, мен ынтымақтасамын.
Dialogue: 0,0:18:09.00,0:18:11.56,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:18:12.04,0:18:13.26,Default,,0,0,0,,Тек бір нәрсені тексеріңіз
Dialogue: 0,0:18:13.71,0:18:16.74,Default,,0,0,0,,Қарт туралы үндеме, солай ма?
Dialogue: 0,0:18:17.02,0:18:18.21,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:18:19.96,0:18:22.10,Default,,0,0,0,,Сана басқаларға көмектесуге тырысса да,
Dialogue: 0,0:18:22.48,0:18:24.82,Default,,0,0,0,,Қарт адам туралы болғандықтан, ол жынды болып барады.
Dialogue: 0,0:18:24.93,0:18:27.63,Default,,0,0,0,,Ол Сунохараны ұрып-соғуы мүмкін.
Dialogue: 0,0:18:29.45,0:18:33.06,Default,,0,0,0,,Бұл Сунохараның қауіпсіздігінің құпиясы.
Dialogue: 0,0:18:39.29,0:18:42.39,Default,,0,0,0,,Сунохара мырза, мен қатты қобалжыдым.
Dialogue: 0,0:18:42.56,0:18:44.78,Default,,0,0,0,,Қандай жиіркенішті көрініс.
Dialogue: 0,0:18:45.48,0:18:46.87,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:18:48.79,0:18:52.68,Default,,0,0,0,,Томояның да анасын ұната бастағанына сене алар емеспін...
Dialogue: 0,0:18:53.12,0:18:55.77,Default,,0,0,0,,Не айтасың, ақымақ?
Dialogue: 0,0:18:57.02,0:18:57.86,Default,,0,0,0,,Ум...
Dialogue: 0,0:18:58.26,0:18:58.80,Default,,0,0,0,,Иә
Dialogue: 0,0:18:59.22,0:19:03.06,Default,,0,0,0,,Ғашық болсаң да, сені Сунохара-кун деп айту біртүрлі.
Dialogue: 0,0:19:03.26,0:19:05.27,Default,,0,0,0,,Мен сені Йохэй-кун деп атаймын.
Dialogue: 0,0:19:05.39,0:19:07.65,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:08.93,0:19:10.11,Default,,0,0,0,,Йохай-кун
Dialogue: 0,0:19:10.99,0:19:12.68,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:19:16.01,0:19:18.69,Default,,0,0,0,,Ябе, маған бұл Йохэй-кун екенін айтты.
Dialogue: 0,0:19:20.22,0:19:22.67,Default,,0,0,0,,Алдымен қатарласып жүрейік.
Dialogue: 0,0:19:23.28,0:19:23.81,Default,,0,0,0,,Иә
Dialogue: 0,0:19:29.96,0:19:32.06,Default,,0,0,0,,Сіз жақындай аласыз.
Dialogue: 0,0:19:32.64,0:19:34.25,Default,,0,0,0,,Біз ғашықпыз.
Dialogue: 0,0:19:38.25,0:19:40.50,Default,,0,0,0,,Яби, жақсы иіс шықты.
Dialogue: 0,0:19:41.45,0:19:44.45,Default,,0,0,0,,Олай болса, жеңіл заттарды қосамыз.
Dialogue: 0,0:19:46.54,0:19:48.77,Default,,0,0,0,,Яби, тым жұмсақ.
Dialogue: 0,0:19:48.78,0:19:50.47,Default,,0,0,0,,Әр кезде келіп есеп бермеңіз.
Dialogue: 0,0:19:53.91,0:19:56.94,Default,,0,0,0,,Біз дұрыс бағытта келе жатырмыз ба?
Dialogue: 0,0:19:57.23,0:19:59.83,Default,,0,0,0,,Мен күрделімін.
Dialogue: 0,0:20:06.38,0:20:07.61,Default,,0,0,0,,Және сол күні
Dialogue: 0,0:20:09.12,0:20:11.15,Default,,0,0,0,,Суохара мырза қазірдің өзінде осында.
Dialogue: 0,0:20:11.33,0:20:13.99,Default,,0,0,0,,Мэй-чан, артынан қоңырау шалып көріңіз.
Dialogue: 0,0:20:14.33,0:20:16.78,Default,,0,0,0,,Оны ол деп ойласаңыз, таң қаласыз.
Dialogue: 0,0:20:19.07,0:20:21.36,Default,,0,0,0,,Олай болса, мен байқап көрейін.
Dialogue: 0,0:20:25.00,0:20:26.21,Default,,0,0,0,,Күттіңіз бе?
Dialogue: 0,0:20:27.26,0:20:30.05,Default,,0,0,0,,Жоқ, мен жаңа ғана келдім.
Dialogue: 0,0:20:30.05,0:20:30.71,Default,,0,0,0,,Мей!
Dialogue: 0,0:20:31.89,0:20:34.22,Default,,0,0,0,,Сунохара мырза, мына бос банка ше?
Dialogue: 0,0:20:35.50,0:20:36.60,Default,,0,0,0,,Бұл да стратегия
Dialogue: 0,0:20:37.15,0:20:39.29,Default,,0,0,0,,Ол келіп, мұны көреді.
Dialogue: 0,0:20:39.79,0:20:40.52,Default,,0,0,0,,Мен осындамын, Коичи.
Dialogue: 0,0:20:41.23,0:20:46.21,Default,,0,0,0,,Сунохара мырза, сіз осынша уақыт күттіңіз.
Dialogue: 0,0:20:49.74,0:20:51.15,Default,,0,0,0,,Міне, осылай болады.
Dialogue: 0,0:20:51.39,0:20:53.78,Default,,0,0,0,,Сіз шынымен сорақысыз.
Dialogue: 0,0:20:53.94,0:20:56.87,Default,,0,0,0,,Бұл ер адамдар ойнайтын махаббат деп аталатын ойын
Dialogue: 0,0:20:57.55,0:21:00.99,Default,,0,0,0,,Менің ойымша, бұл баланың махаббат ойыны.
Dialogue: 0,0:21:01.03,0:21:02.70,Default,,0,0,0,,Себебі мағынасы басқа.
Dialogue: 0,0:21:03.26,0:21:05.99,Default,,0,0,0,,Ябей мен көп іштім, енді дәретханаға баруым керек.
Dialogue: 0,0:21:12.63,0:21:15.60,Default,,0,0,0,,Ынтымағы жоқ болса, әуре болады емес пе?
Dialogue: 0,0:21:16.10,0:21:18.38,Default,,0,0,0,,Дұрыс, оны тазалап көрейік.
Dialogue: 0,0:21:18.79,0:21:19.36,Default,,0,0,0,,Иә
Dialogue: 0,0:21:23.56,0:21:25.47,Default,,0,0,0,,Мен де саған көмектесемін.
Dialogue: 0,0:21:26.02,0:21:27.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:27.19,0:21:27.96,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:21:36.79,0:21:38.14,Default,,0,0,0,,Бұл өте...
Dialogue: 0,0:21:38.59,0:21:41.47,Default,,0,0,0,,Томоя-кун, сенің жүзің қызарып тұрған жоқ па?
Dialogue: 0,0:21:44.46,0:21:45.88,Default,,0,0,0,,Сергіту~
Dialogue: 0,0:21:46.75,0:21:47.69,Default,,0,0,0,,Йохай-кун
Dialogue: 0,0:21:50.37,0:21:52.39,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз?
Dialogue: 0,0:21:52.71,0:21:55.73,Default,,0,0,0,,Кешіріңіз, кешіріңіз...
Dialogue: 0,0:21:53.04,0:21:55.73,Default,,0,0,0,,Жоқ, мен мұнда жаңа келдім.
Dialogue: 0,0:22:02.82,0:22:05.11,Default,,0,0,0,,Бұл адам менің ағамның құрбысы
Dialogue: 0,0:22:18.69,0:22:25.91,Default,,0,0,0,,Мен өтіп бара жатқан бұлттарға қарап тұрдым
Dialogue: 0,0:22:26.21,0:22:32.84,Default,,0,0,0,,Аспан түсінің өзгергенін сезіндім
Dialogue: 0,0:22:33.72,0:22:41.05,Default,,0,0,0,,Тоқтаған біз, түсіндік
Dialogue: 0,0:22:41.38,0:22:48.24,Default,,0,0,0,,Өзгермелі дүние иірген ән
Dialogue: 0,0:22:48.33,0:22:55.51,Default,,0,0,0,,Саусақтарын созып тартқандай
Dialogue: 0,0:22:55.72,0:23:03.97,Default,,0,0,0,,Бір өзгеріссіз қалатын затты табыңыз
Dialogue: 0,0:23:04.46,0:23:11.67,Default,,0,0,0,,Сіз ұстаған қолыңыздағы шам
Dialogue: 0,0:23:11.82,0:23:19.48,Default,,0,0,0,,Ертеңге апаратын шағын бағдаршам
Dialogue: 0,0:23:19.48,0:23:26.72,Default,,0,0,0,,Қазір де жаңғырық
Dialogue: 0,0:23:27.00,0:23:34.35,Default,,0,0,0,,Сол күнгі сөздерді ант етіп өзгертіңіз
Dialogue: 0,0:23:34.46,0:23:39.20,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:23:40.30,0:23:43.07,Default,,0,0,0,,Сіздің ағаңыз да үлкендердің сүйіспеншілігіне ие болады деп үміттенемін.
Dialogue: 0,0:23:43.83,0:23:45.31,Default,,0,0,0,,Мэй, сәл күте тұрыңыз.
Dialogue: 0,0:23:45.63,0:23:49.81,Default,,0,0,0,,Аа... Бірақ маған Санае-саннан қоңырау шалу керек.
Dialogue: 0,0:23:50.37,0:23:52.22,Default,,0,0,0,,Бірақ махаббат тегін, солай емес пе?
Dialogue: 0,0:23:54.69,0:23:55.74,Default,,0,0,0,,Бір минут.
Dialogue: 0,0:23:57.24,0:24:02.24,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
