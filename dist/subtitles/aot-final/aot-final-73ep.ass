Dialogue: 0,0:28:58.13,0:29:02.13,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:29:04.70,0:29:08.20,Default,,0000,0000,0000,,Бірақ сен есіңде сақтайсың ғой
Dialogue: 0,0:29:11.01,0:29:12.94,Default,,0000,0000,0000,,сол жер мен сол уақытты, иә, Эрен...?
Dialogue: 0,0:29:12.94,0:29:17.15,Default,,0000,0000,0000,,Һмм? …!!
Dialogue: 0,0:29:12.94,0:29:17.15,Default,,0000,0000,0000,,Гггг!!! Алғаааа!!!
Dialogue: 0,0:29:17.15,0:29:19.25,Default,,0000,0000,0000,,Бұл Мереден сирек кездесетін нәрсе!
Dialogue: 0,0:29:25.86,0:29:28.06,Default,,0000,0000,0000,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:29:25.86,0:29:28.06,Default,,0000,0000,0000,,Қара шай бар ғой, иә?
Dialogue: 0,0:29:30.26,0:29:32.26,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:29:35.90,0:29:38.00,Default,,0000,0000,0000,,Капитан, оооох!!
Dialogue: 0,0:29:44.48,0:29:47.71,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:29:47.71,0:29:49.78,Default,,0000,0000,0000,,Жарай бер, ал.
Dialogue: 0,0:29:49.78,0:29:55.82,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:29:55.82,0:29:58.79,Default,,0000,0000,0000,,(Қыңқылдау дыбысы)
Dialogue: 0,0:29:55.82,0:29:58.79,Default,,0000,0000,0000,,Әке!
Dialogue: 0,0:29:55.82,0:29:58.79,Default,,0000,0000,0000,,Бл…ээ…!!
Dialogue: 0,0:29:58.79,0:30:01.03,Default,,0000,0000,0000,,<Шарапқа Зиктің жұлын сұйығы…
Dialogue: 0,0:30:01.03,0:30:05.33,Default,,0000,0000,0000,,Қашаннан бері араластырылған…?
Dialogue: 0,0:30:01.03,0:30:05.33,Default,,0000,0000,0000,,Денемнің қатып қалатынына ешқандай белгі болмады…
Dialogue: 0,0:30:05.33,0:30:08.03,Default,,0000,0000,0000,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:30:08.03,0:30:13.27,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:30:08.03,0:30:13.27,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:30:13.27,0:30:15.67,Default,,0000,0000,0000,,Құдай-ай!! Өте жылдам…
Dialogue: 0,0:30:15.67,0:30:19.48,Default,,0000,0000,0000,,Оның қозғалысы қалыпты емес…
Dialogue: 0,0:30:15.67,0:30:19.48,Default,,0000,0000,0000,,Бұл да Зигтің ісі ме?
Dialogue: 0,0:30:19.48,0:30:24.42,Default,,0000,0000,0000,,Чх!! Барис…!!
Dialogue: 0,0:30:19.48,0:30:24.42,Default,,0000,0000,0000,,<Сен… әлі де барсың ба…?>
Dialogue: 0,0:30:24.42,0:30:29.69,Default,,0000,0000,0000,,<Сендер…>
