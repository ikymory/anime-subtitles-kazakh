Dialogue: 0,0:43:08.51,0:43:13.72,Default,,0000,0000,0000,,Һмм? …!!
Dialogue: 0,0:43:08.51,0:43:13.72,Default,,0000,0000,0000,,Гггг!!! Алғаааа!!!
Dialogue: 0,0:43:13.72,0:43:19.82,Default,,0000,0000,0000,,Бұл Мереден сирек кездесетін нәрсе!
Dialogue: 0,0:43:13.72,0:43:19.82,Rubi,,0000,0000,0000,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:43:13.72,0:43:19.82,Default,,0000,0000,0000,,Қара шай бар ғой, иә?
Dialogue: 0,0:43:19.82,0:43:25.10,Default,,0000,0000,0000,,Капитан, оооох!!
Dialogue: 0,0:43:19.82,0:43:25.10,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:43:25.10,0:43:30.30,Default,,0000,0000,0000,,Жарай бер, ал.
Dialogue: 0,0:43:25.10,0:43:30.30,Default,,0000,0000,0000,,Бл…ээ…!!
Dialogue: 0,0:43:30.30,0:43:32.87,Default,,0000,0000,0000,,<Шарапқа Зиктің жұлын сұйығы…
Dialogue: 0,0:43:32.87,0:43:37.74,Default,,0000,0000,0000,,Қашаннан бері араластырылған…?
Dialogue: 0,0:43:32.87,0:43:37.74,Default,,0000,0000,0000,,Денемнің қатып қалатынына ешқандай белгі болмады…
Dialogue: 0,0:43:37.74,0:43:45.22,Default,,0000,0000,0000,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:43:37.74,0:43:45.22,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:43:45.22,0:43:49.22,Default,,0000,0000,0000,,Құдай-ай!! Өте жылдам…
Dialogue: 0,0:43:49.22,0:43:51.39,Default,,0000,0000,0000,,Мен – Тайбар әулетінің басшысы Уиллимін.
Dialogue: 0,0:43:51.39,0:43:55.33,Default,,0000,0000,0000,,Оның қозғалысы қалыпты емес…
Dialogue: 0,0:43:51.39,0:43:55.33,Default,,0000,0000,0000,,Бұл да Зигтің ісі ме?
Dialogue: 0,0:43:55.33,0:43:58.90,Default,,0000,0000,0000,,Чх!! Барис…!!
Dialogue: 0,0:43:58.90,0:44:04.30,Default,,0000,0000,0000,,<Сен… әлі де барсың ба…?>
Dialogue: 0,0:43:58.90,0:44:04.30,Default,,0000,0000,0000,,<Сендер…>
Dialogue: 0,0:44:04.30,0:44:08.51,Default,,0000,0000,0000,,Соңы…
Dialogue: 0,0:44:04.30,0:44:08.51,Default,,0000,0000,0000,,Біз бір-бірімізге сенім арта алмадық.
Dialogue: 0,0:44:08.51,0:44:13.34,Default,,0000,0000,0000,,Жер бетінің түкпір-түкпірінен күштер жақында
Dialogue: 0,0:44:08.51,0:44:13.34,Default,,0000,0000,0000,,осы аралға жиналады.
Dialogue: 0,0:44:13.34,0:44:18.72,Default,,0000,0000,0000,,Сен оның не екенін түсінбейсің.
Dialogue: 0,0:44:13.34,0:44:18.72,Default,,0000,0000,0000,,Бізде күш бар; бізде уақыт бар.
Dialogue: 0,0:44:18.72,0:44:21.35,Default,,0000,0000,0000,,Біз сол қате түсініктің астында болғанымыз…
Dialogue: 0,0:44:21.35,0:44:25.99,Default,,0000,0000,0000,,Леви… бұл сенің кінәң.
Dialogue: 0,0:44:21.35,0:44:25.99,Default,,0000,0000,0000,,Жарайды, тіпті мен саған шынайы ниетімді айтсам да,
Dialogue: 0,0:44:25.99,0:44:28.99,Default,,0000,0000,0000,,сен оны ешқашан түсінбес едің, иә…?
Dialogue: 0,0:44:28.99,0:44:31.29,Default,,0000,0000,0000,,Эй, Эрен…
Dialogue: 0,0:44:34.60,0:44:37.07,Default,,0000,0000,0000,,Тек біз ғана мұны түсіне аламыз, иә?
Dialogue: 0,0:44:37.07,0:44:39.70,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:44:39.70,0:44:42.61,Default,,0000,0000,0000,,Бірақ сен есіңде сақтайсың ғой
Dialogue: 0,0:44:42.61,0:44:46.94,Default,,0000,0000,0000,,сол жер мен сол уақытты, иә, Эрен...?
Dialogue: 0,0:44:42.61,0:44:46.94,Default,,0000,0000,0000,,Һмм? …!!
Dialogue: 0,0:44:46.94,0:44:50.75,Default,,0000,0000,0000,,Гггг!!! Алғаааа!!!
Dialogue: 0,0:44:50.75,0:44:54.95,Default,,0000,0000,0000,,Бұл Мереден сирек кездесетін нәрсе!
Dialogue: 0,0:44:57.52,0:44:59.76,Default,,0000,0000,0000,,(Жаңбыр дыбысы)
