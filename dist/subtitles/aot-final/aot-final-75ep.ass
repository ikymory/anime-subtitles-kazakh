Dialogue: 0,0:00:05.12,0:00:08.02,Default,,0000,0000,0000,,(Жаңбыр дыбысы)
Dialogue: 0,0:00:08.02,0:00:11.99,Rubi,,0000,0000,0000,,Есті жойып жіберердей үркіреу
Dialogue: 0,0:00:08.02,0:00:11.99,Default,,0000,0000,0000,,Демек, бұл… Парадис аралының Шайтаны!!
Dialogue: 0,0:00:11.99,0:00:14.26,Default,,0000,0000,0000,,Бұ… бұл не еді?
Dialogue: 0,0:00:14.26,0:00:16.96,Default,,0000,0000,0000,,Қазіргі дыбыс…
Dialogue: 0,0:00:14.26,0:00:16.96,Default,,0000,0000,0000,,Найзағайдың гүрсірі ме?
Dialogue: 0,0:00:19.50,0:00:22.27,Rubi,,0000,0000,0000,,Солай сияқты.
Dialogue: 0,0:00:19.50,0:00:22.27,Default,,0000,0000,0000,,<Бұл найзағай жебесі…
Dialogue: 0,0:00:22.27,0:00:24.67,Default,,0000,0000,0000,,Бұл не өзі…?>
Dialogue: 0,0:00:28.14,0:00:31.38,Default,,0000,0000,0000,,Сол дыбыс келген жақта бірдеңе бар шығар.
Dialogue: 0,0:00:31.38,0:00:36.61,Default,,0000,0000,0000,,(Жаңбыр дыбысы)
Dialogue: 0,0:00:36.61,0:00:38.55,Default,,0000,0000,0000,,Жынға қалай сенуге болады!!
Dialogue: 0,0:00:38.55,0:00:43.65,Default,,0000,0000,0000,,(Жаңбыр дыбысы)
Dialogue: 0,0:00:50.19,0:00:53.59,Default,,0000,0000,0000,,<Тыныш… иә…>
Dialogue: 0,0:00:55.97,0:00:58.97,Default,,0000,0000,0000,,<Мен... өліп бара жатырмын ба...?>
Dialogue: 0,0:01:01.21,0:01:04.48,Default,,0000,0000,0000,,(Жаңбыр дыбысы)
Dialogue: 0,0:01:04.48,0:01:14.78,Rubi,,0000,0000,0000,,●
Dialogue: 0,0:01:04.48,0:01:14.78,Default,,0000,0000,0000,,(Титан бізге қарай өрмелеп келе жатқан дыбыс)
Dialogue: 0,0:01:27.27,0:01:32.04,Default,,0000,0000,0000,,(Жаңбыр дыбысы)
Dialogue: 0,0:01:32.04,0:01:58.30,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:58.30,0:02:02.03,Default,,0000,0000,0000,,・'Қараңғылықтан жаңа өмір бастайық'
Dialogue: 0,0:01:58.30,0:02:02.03,Default,,0000,0000,0000,,from the darkness
Dialogue: 0,0:02:02.03,0:02:05.24,Default,,0000,0000,0000,,・'Жарық соңын көрсеткенше'
Dialogue: 0,0:02:05.24,0:02:08.87,Default,,0000,0000,0000,,・'Зұлым жүздер, өсіп жатқан қарғыстар'
Dialogue: 0,0:02:08.87,0:02:12.44,Default,,0000,0000,0000,,・'Бұл менің соңғы соғысым'
Dialogue: 0,0:02:12.44,0:02:19.22,Default,,0000,0000,0000,,・'Жындар бейнесіндегі періштелер'
Dialogue: 0,0:02:12.44,0:02:19.22,Default,,0000,0000,0000,,шайтан бейнесінде'
Dialogue: 0,0:02:19.22,0:02:25.92,Default,,0000,0000,0000,,даналығын сығып шығарады'
Dialogue: 0,0:02:19.22,0:02:25.92,Default,,0000,0000,0000,,squeezing out their wisdom
Dialogue: 0,0:02:25.92,0:02:32.56,Default,,0000,0000,0000,,・'Жасырын түрде жоспар құрған періштелер
Dialogue: 0,0:02:25.92,0:02:32.56,Default,,0000,0000,0000,,шайтан бейнесінде'
Dialogue: 0,0:02:32.56,0:02:39.14,Default,,0000,0000,0000,,・'Балалар өздерінің
Dialogue: 0,0:02:32.56,0:02:39.14,Default,,0000,0000,0000,,соңғы тиындарына жабысып қалады'
Dialogue: 0,0:02:39.14,0:02:45.51,Default,,0000,0000,0000,,・'Құрту мен жаңғыру
Dialogue: 0,0:02:39.14,0:02:45.51,Default,,0000,0000,0000,,Сен – нағыз жаусың'
Dialogue: 0,0:02:45.51,0:03:00.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:14.04,0:03:19.24,Default,,0000,0000,0000,,Жақында, тағы да,
Dialogue: 0,0:03:14.04,0:03:19.24,Default,,0000,0000,0000,,олар бізбен бір үстелге отыратын күн келеді.
Dialogue: 0,0:03:19.24,0:03:24.58,Default,,0000,0000,0000,,Мен айтқандай-ақ болды, иә?
Dialogue: 0,0:03:19.24,0:03:24.58,Default,,0000,0000,0000,,Командир Пиксис.
Dialogue: 0,0:03:24.58,0:03:27.35,Default,,0000,0000,0000,,Жылдам әрекет еткеніңіз үшін рахмет.
Dialogue: 0,0:03:27.35,0:03:31.92,Default,,0000,0000,0000,,Сіз барлық полктарда қарсылық көрсетуге тыйым салып,
Dialogue: 0,0:03:27.35,0:03:31.92,Default,,0000,0000,0000,,біз талап еткендей,
Dialogue: 0,0:03:31.92,0:03:35.79,Default,,0000,0000,0000,,сарбаздарыңызды
Dialogue: 0,0:03:31.92,0:03:35.79,Default,,0000,0000,0000,,осы Шинганшина ауданына жинадыңыз.
Dialogue: 0,0:03:35.79,0:03:40.36,Default,,0000,0000,0000,,Егер оларға жұлын сұйықтығы енгізілген болса,
Dialogue: 0,0:03:35.79,0:03:40.36,Default,,0000,0000,0000,,басқа амал қалмайды.
Dialogue: 0,0:03:40.36,0:03:43.00,Default,,0000,0000,0000,,Олар қашан Титанға айналуы мүмкін екенін біз білмейміз.
Dialogue: 0,0:03:43.00,0:03:47.91,Default,,0000,0000,0000,,Осы жерден басқа, барлық бейбіт тұрғындар шығарылған,
Dialogue: 0,0:03:43.00,0:03:47.91,Default,,0000,0000,0000,,бізді орналастыра алатын басқа орын жоқ.
Dialogue: 0,0:03:47.91,0:03:52.51,Default,,0000,0000,0000,,Ең бастысы, соншама сарбаздарымыз
Dialogue: 0,0:03:47.91,0:03:52.51,Default,,0000,0000,0000,,біздің арқамызға мылтықтарын кезеп тұрғанда…
Dialogue: 0,0:03:52.51,0:03:54.45,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:03:52.51,0:03:54.45,Rubi,,0000,0000,0000,,біз
Dialogue: 0,0:03:52.51,0:03:54.45,Default,,0000,0000,0000,,ештеңе істей алмаймыз.
Dialogue: 0,0:03:54.45,0:03:57.28,Default,,0000,0000,0000,,Кешіріңіз, командир…
Dialogue: 0,0:03:57.28,0:04:01.25,Default,,0000,0000,0000,,Мен және ұлым
Dialogue: 0,0:03:57.28,0:04:01.25,Default,,0000,0000,0000,,екеуміз де шараптан бір-бір жұтым татып қойдық…
Dialogue: 0,0:04:01.25,0:04:03.39,Default,,0000,0000,0000,,Қашаннан бері бізді сатып жүрсің?
Dialogue: 0,0:04:03.39,0:04:05.32,Default,,0000,0000,0000,,Жауап берудің қажеті жоқ.
Dialogue: 0,0:04:05.32,0:04:08.93,Default,,0000,0000,0000,,…!! Кешіріңізші…
Dialogue: 0,0:04:08.93,0:04:14.47,Default,,0000,0000,0000,,Көрінгендей, жақ ауыстырған сайын жақсы екен
Dialogue: 0,0:04:08.93,0:04:14.47,Default,,0000,0000,0000,,Бұ… бұл не еді?
Dialogue: 0,0:04:14.47,0:04:17.74,Default,,0000,0000,0000,,Қазіргі дыбыс…
Dialogue: 0,0:04:14.47,0:04:17.74,Default,,0000,0000,0000,,Найзағайдың гүрсірі ме?
Dialogue: 0,0:04:17.74,0:04:21.11,Default,,0000,0000,0000,,Солай сияқты.
