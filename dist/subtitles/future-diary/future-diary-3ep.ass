Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:20.33,0:00:23.00,Default,,0,0,0,,Аспан неге көк?
Dialogue: 0,0:00:33.30,0:00:36.34,Default,,0,0,0,,Уау, раушан гүлі ашылмайды.
Dialogue: 0,0:00:36.47,0:00:38.97,Default,,0,0,0,,Кя, маған көмектес
Dialogue: 0,0:00:44.35,0:00:47.56,Default,,0,0,0,,Юно Келесі жолы азырақ қорқынышты нәрсемен жүру керек.
Dialogue: 0,0:00:47.77,0:00:48.90,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:00:49.69,0:00:51.32,Default,,0,0,0,,Мен жай тыңдап тұрмын.
Dialogue: 0,0:00:51.44,0:00:52.53,Default,,0,0,0,,Ол еріп кетеді
Dialogue: 0,0:00:54.57,0:00:56.86,Default,,0,0,0,,Келесі жолы, Юккиге мін.
Dialogue: 0,0:00:59.66,0:01:03.04,Default,,0,0,0,,Мен неге мұндамын?
Dialogue: 0,0:02:42.89,0:02:46.56,Default,,0,0,0,,Мен кішкентай кезімде Құдайдың бар екеніне сенетінмін.
Dialogue: 0,0:03:06.20,0:03:08.83,Default,,0,0,0,,Мен сендерден стратегияға көмектесулеріңді сұраймын.
Dialogue: 0,0:03:09.00,0:03:09.71,Default,,0,0,0,,Стратегия
Dialogue: 0,0:03:10.25,0:03:12.83,Default,,0,0,0,,Менің мақсатым - бұл ақымақ ойын
Dialogue: 0,0:03:13.00,0:03:16.13,Default,,0,0,0,,Бұдан әрі кісі өлтірудің алдын алу үшін.
Dialogue: 0,0:03:16.25,0:03:21.76,Default,,0,0,0,,Ол үшін алдымен Future Diary басқа иелерінің жеке басын анықтауымыз керек.
Dialogue: 0,0:03:21.93,0:03:24.18,Default,,0,0,0,,Қазіргі иесі
Dialogue: 0,0:03:24.35,0:03:26.64,Default,,0,0,0,,Міне, мен 1-ші Юкитеру Аманомын
Dialogue: 0,0:03:26.76,0:03:28.39,Default,,0,0,0,,2-ші Юно Агацума
Dialogue: 0,0:03:28.56,0:03:32.81,Default,,0,0,0,,Ал 4-ші мен, Кейго Курусу
Dialogue: 0,0:03:32.98,0:03:36.27,Default,,0,0,0,,Ал өлген 3-ші Қазан Такао
Dialogue: 0,0:03:36.44,0:03:40.49,Default,,0,0,0,,Бұл қашып кеткен 5 9-шы Минене Амагаре.
Dialogue: 0,0:03:40.61,0:03:45.37,Default,,0,0,0,,Барлығы 12 иесі бар, тағы 7 иесі белгісіз.
Dialogue: 0,0:03:45.49,0:03:47.41,Default,,0,0,0,,Жоспар - оларды табу.
Dialogue: 0,0:03:47.49,0:03:49.29,Default,,0,0,0,,Керемет стратегия
Dialogue: 0,0:03:49.45,0:03:52.21,Default,,0,0,0,,Мектеп бәрібір біраз уақытқа жабылады.
Dialogue: 0,0:03:52.33,0:03:56.25,Default,,0,0,0,,Сонымен қатар, 9-ын басып алу керек.
Dialogue: 0,0:03:56.38,0:04:01.59,Default,,0,0,0,,Демек, 9-шы Минене Амагаре әлі қолға түскен жоқ.
Dialogue: 0,0:04:01.76,0:04:06.97,Default,,0,0,0,,9-шы болашақ күнделік - қашу жолын қамтамасыз ететін қашу күнделігі.
Dialogue: 0,0:04:07.10,0:04:09.93,Default,,0,0,0,,Бұл мен ойлағаннан да қиындау сияқты.
Dialogue: 0,0:04:10.10,0:04:13.69,Default,,0,0,0,,Сонда мен не істеуім керек?
Dialogue: 0,0:04:13.85,0:04:15.90,Default,,0,0,0,,О, солай.
Dialogue: 0,0:04:19.57,0:04:23.36,Default,,0,0,0,,Ол қашып жүрсе де, 9-шы әлі де сізді нысанаға алады.
Dialogue: 0,0:04:23.53,0:04:27.99,Default,,0,0,0,,Мен сіздің қадамдарыңызды растамайынша, екеуіңіз біраз уақыт алаяқ ретінде әрекет етесіз.
Dialogue: 0,0:04:31.08,0:04:35.29,Default,,0,0,0,,Бірақ бұл жай ғана ойнау емес пе?
Dialogue: 0,0:04:35.46,0:04:37.50,Default,,0,0,0,,Стратегия дегеніміз не?
Dialogue: 0,0:04:37.67,0:04:41.71,Default,,0,0,0,,Оның полиция бөлімшесінің жанында болғанын қаламайсыз ба?
Dialogue: 0,0:04:42.84,0:04:45.76,Default,,0,0,0,,Бірақ бұл жақсы мүмкіндік болуы мүмкін.
Dialogue: 0,0:04:45.89,0:04:47.68,Default,,0,0,0,,Мені әрқашан қызықтыратын нәрсе
Dialogue: 0,0:04:47.80,0:04:49.39,Default,,0,0,0,,Мүмкін бұл сіздің Юнодан сұрау мүмкіндігіңіз.
Dialogue: 0,0:04:50.43,0:04:55.39,Default,,0,0,0,,Иә, Юно неге мені қуып жүр?
Dialogue: 0,0:04:59.32,0:05:01.32,Default,,0,0,0,,Күткеніңізге рахмет, Юкки
Dialogue: 0,0:05:02.19,0:05:03.90,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:08.28,0:05:09.91,Default,,0,0,0,,Эй Юно, неге?
Dialogue: 0,0:05:10.08,0:05:11.04,Default,,0,0,0,,Бірге ішейік
Dialogue: 0,0:05:12.20,0:05:12.91,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:05:30.05,0:05:32.97,Default,,0,0,0,,Біртүрлі еркелер ойнамаңыз
Dialogue: 0,0:06:01.25,0:06:04.01,Default,,0,0,0,,Ештеңе емес, сіз әлі қашып кете аласыз.
Dialogue: 0,0:06:13.60,0:06:17.23,Default,,0,0,0,,Мұндай жерде құлау скучно ма?
Dialogue: 0,0:06:19.02,0:06:20.52,Default,,0,0,0,,Минене аман қалды
Dialogue: 0,0:06:20.73,0:06:25.86,Default,,0,0,0,,Осы аман қалу ойынында аман қалыңыз және жеңіңіз
Dialogue: 0,0:06:30.74,0:06:32.70,Default,,0,0,0,,Жаңбыр тамшылап тұр
Dialogue: 0,0:06:34.37,0:06:37.75,Default,,0,0,0,,Бұрышта 50 метр жерде екі полиция қызметкері бар.
Dialogue: 0,0:06:37.96,0:06:41.38,Default,,0,0,0,,Қауіпті болдырмау үшін осы жерден оңға бұрылыңыз.
Dialogue: 0,0:06:43.84,0:06:44.42,Default,,0,0,0,,Сен
Dialogue: 0,0:06:44.46,0:06:45.38,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:06:46.21,0:06:46.96,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:06:47.13,0:06:47.80,Default,,0,0,0,,Томаре
Dialogue: 0,0:06:49.47,0:06:51.09,Default,,0,0,0,,Эй, күте тұрыңыз
Dialogue: 0,0:07:01.23,0:07:02.56,Default,,0,0,0,,Юкки Енді не болады?
Dialogue: 0,0:07:06.61,0:07:07.86,Default,,0,0,0,,Юноның жігіті
Dialogue: 0,0:07:08.07,0:07:10.32,Default,,0,0,0,,Менің қорқатынымды білсең де
Dialogue: 0,0:07:20.04,0:07:21.58,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:07:22.38,0:07:24.00,Default,,0,0,0,,Біз Юномен тым жақынбыз
Dialogue: 0,0:07:24.17,0:07:28.51,Default,,0,0,0,,О, Юно, сен қорқатын шығарсың.
Dialogue: 0,0:07:36.76,0:07:39.77,Default,,0,0,0,,Мұнда не болып жатыр?
Dialogue: 0,0:07:39.93,0:07:44.02,Default,,0,0,0,,Менің ойымша, Юно да қыз.
Dialogue: 0,0:07:44.19,0:07:46.98,Default,,0,0,0,,Бұл қорқынышты болды.
Dialogue: 0,0:07:51.53,0:07:52.57,Default,,0,0,0,,Яба
Dialogue: 0,0:07:53.24,0:07:55.78,Default,,0,0,0,,Мен әңгімені Юнодан алуды жоспарладым.
Dialogue: 0,0:07:55.95,0:07:59.29,Default,,0,0,0,,Юно бүгін өте сүйкімді көрінеді
Dialogue: 0,0:08:05.58,0:08:07.67,Default,,0,0,0,,Юкки, келесі жерге кіріңіз.
Dialogue: 0,0:08:08.84,0:08:10.01,Default,,0,0,0,,Кеттік, Юкки
Dialogue: 0,0:08:10.13,0:08:12.47,Default,,0,0,0,,Бұл жер жаман, Юно.
Dialogue: 0,0:08:15.80,0:08:19.43,Default,,0,0,0,,Yukki that
Dialogue: 0,0:08:20.89,0:08:23.02,Default,,0,0,0,,ұятқа қалдырады
Dialogue: 0,0:08:23.19,0:08:24.77,Default,,0,0,0,,Сондықтан мен кете алмаймын.
Dialogue: 0,0:08:24.94,0:08:27.86,Default,,0,0,0,,Бұл әдетте керісінше болады, Юкки.
Dialogue: 0,0:08:32.90,0:08:34.03,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:08:34.20,0:08:38.28,Default,,0,0,0,,Бұл купальник маған жараспайды.
Dialogue: 0,0:08:40.70,0:08:42.54,Default,,0,0,0,,Үлкен
Dialogue: 0,0:08:42.83,0:08:44.67,Default,,0,0,0,,Біз не туралы сөйлесуіміз керек?
Dialogue: 0,0:08:45.62,0:08:48.75,Default,,0,0,0,,Мұндай жерлерде жиі зәр түсіретін адамдар бар.
Dialogue: 0,0:08:50.80,0:08:52.34,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:08:56.34,0:08:59.43,Default,,0,0,0,,Менің купальникімді су шайып кетті
Dialogue: 0,0:08:59.64,0:09:01.02,Default,,0,0,0,,Уау
Dialogue: 0,0:09:02.73,0:09:03.39,Default,,0,0,0,,Мен барып аламын.
Dialogue: 0,0:09:03.39,0:09:04.10,Default,,0,0,0,,Жоқ, мен оны аламын.
Dialogue: 0,0:09:04.10,0:09:04.60,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:09:04.60,0:09:07.10,Default,,0,0,0,,Юкки барса, мен жалғыз қаламын.
Dialogue: 0,0:09:07.27,0:09:09.82,Default,,0,0,0,,Жауапты адамға қоңырау шалыңыз.
Dialogue: 0,0:09:10.19,0:09:12.65,Default,,0,0,0,,Юно әдеттен тыс ашулы.
Dialogue: 0,0:09:12.82,0:09:17.36,Default,,0,0,0,,Кешіріңіз, мен аздап алданып қалдым.
Dialogue: 0,0:09:17.53,0:09:18.57,Default,,0,0,0,,А, жақсы
Dialogue: 0,0:09:28.96,0:09:30.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:38.68,0:09:39.47,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:09:40.18,0:09:41.35,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:09:41.51,0:09:43.52,Default,,0,0,0,,Оны басқа адамдар көре алады
Dialogue: 0,0:09:47.77,0:09:49.69,Default,,0,0,0,,Тұтынушы Бұл ма?
Dialogue: 0,0:09:50.15,0:09:51.52,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:56.45,0:09:57.78,Default,,0,0,0,,Бұл пайдалы болды.
Dialogue: 0,0:10:08.83,0:10:10.50,Default,,0,0,0,,Әрі қарай қайда барамыз?
Dialogue: 0,0:10:12.50,0:10:14.80,Default,,0,0,0,,Юкки: Планетарий бар.
Dialogue: 0,0:10:14.92,0:10:16.09,Default,,0,0,0,,Келесі жолы осында кірейік.
Dialogue: 0,0:10:16.09,0:10:16.67,Default,,0,0,0,,Жарайды, келесі жолы осында кірейік.
Dialogue: 0,0:10:16.67,0:10:17.17,Default,,0,0,0,,Жақсы көрінеді
Dialogue: 0,0:10:18.26,0:10:19.59,Default,,0,0,0,,Бұл жер жақсы көрінеді
Dialogue: 0,0:10:38.40,0:10:40.57,Default,,0,0,0,,Әдемі
Dialogue: 0,0:10:40.87,0:10:41.57,Default,,0,0,0,,Иә
Dialogue: 0,0:10:42.58,0:10:45.62,Default,,0,0,0,,Сакурами қаласын түгелдей көруге болады.
Dialogue: 0,0:10:47.62,0:10:49.33,Default,,0,0,0,,Сәлем Юно
Dialogue: 0,0:10:51.63,0:10:55.38,Default,,0,0,0,,Юно неге мені қуып жүр?
Dialogue: 0,0:10:59.63,0:11:03.22,Default,,0,0,0,,Юкки, сен неге ертерек планетарийден қаштың?
Dialogue: 0,0:11:04.93,0:11:06.43,Default,,0,0,0,,Сізге Юкки ұнайды.
Dialogue: 0,0:11:06.64,0:11:07.22,Default,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:11:08.31,0:11:09.39,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:12.69,0:11:13.90,Default,,0,0,0,,Бұл қорқынышты. Тағы да күнделікте.
Dialogue: 0,0:11:14.02,0:11:14.69,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:15.02,0:11:16.98,Default,,0,0,0,,Бұл туралы маған Юкки айтты.
Dialogue: 0,0:11:17.11,0:11:18.15,Default,,0,0,0,,Юкки
Dialogue: 0,0:11:18.99,0:11:20.11,Default,,0,0,0,,Бір жыл бұрын
Dialogue: 0,0:11:35.88,0:11:37.13,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:11:39.80,0:11:41.59,Default,,0,0,0,,Сіз де жаза алмайсыз
Dialogue: 0,0:11:43.59,0:11:48.56,Default,,0,0,0,,Мен бүкіл отбасыммен жұлдыздарды көруге барғым келеді.
Dialogue: 0,0:11:48.85,0:11:52.56,Default,,0,0,0,,Менің әкем мен анам өткен аптада ажырасып кетті.
Dialogue: 0,0:11:52.73,0:11:55.06,Default,,0,0,0,,Мен телескоп сатып алдым.
Dialogue: 0,0:11:55.23,0:11:57.90,Default,,0,0,0,,Жұлдыздарды көруге уәде берді
Dialogue: 0,0:12:00.03,0:12:00.82,Default,,0,0,0,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:12:01.11,0:12:02.07,Default,,0,0,0,,Оны өшірейік
Dialogue: 0,0:12:03.70,0:12:04.87,Default,,0,0,0,,Бұл таңқаларлық емес.
Dialogue: 0,0:12:05.28,0:12:06.91,Default,,0,0,0,,Бұл әлі де біртүрлі.
Dialogue: 0,0:12:07.08,0:12:09.04,Default,,0,0,0,,Мұғалімге тапсыру
Dialogue: 0,0:12:10.37,0:12:12.33,Default,,0,0,0,,Онда неге менімен бірге жұлдыздарды көруге бармайсың?
Dialogue: 0,0:12:12.54,0:12:15.58,Default,,0,0,0,,Обсерватория дәл жақын жерде.
Dialogue: 0,0:12:15.71,0:12:17.59,Default,,0,0,0,,Әй, жақсы идея.
Dialogue: 0,0:12:17.75,0:12:21.22,Default,,0,0,0,,Жоқ, мен отбасыммен барғым келеді дедім.
Dialogue: 0,0:12:21.38,0:12:23.55,Default,,0,0,0,,Бұл қазірдің өзінде тым ресми.
Dialogue: 0,0:12:23.76,0:12:25.68,Default,,0,0,0,,Сонда бұл туралы не деуге болады?
Dialogue: 0,0:12:26.80,0:12:29.72,Default,,0,0,0,,Мен сенің болашақ жарың боламын.
Dialogue: 0,0:12:30.64,0:12:33.31,Default,,0,0,0,,Мен бұл жай әзіл деп ойладым.
Dialogue: 0,0:12:34.44,0:12:36.61,Default,,0,0,0,,Мен өскенде
Dialogue: 0,0:12:37.77,0:12:38.65,Default,,0,0,0,,Иә
Dialogue: 0,0:12:41.74,0:12:43.20,Default,,0,0,0,,Мұның себебі
Dialogue: 0,0:12:44.20,0:12:45.91,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:12:46.49,0:12:47.66,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:12:54.33,0:12:58.92,Default,,0,0,0,,Юно әлі нені жасырып жүр?
Dialogue: 0,0:13:20.65,0:13:21.94,Default,,0,0,0,,Құпия
Dialogue: 0,0:13:41.55,0:13:43.17,Default,,0,0,0,,Әй, жаңбыр
Dialogue: 0,0:13:50.80,0:13:52.06,Default,,0,0,0,,Бір бөлік жақсы.
Dialogue: 0,0:14:17.12,0:14:20.17,Default,,0,0,0,,Бұл Юноның үйі
Dialogue: 0,0:14:20.38,0:14:21.38,Default,,0,0,0,,Иә
Dialogue: 0,0:14:22.13,0:14:24.55,Default,,0,0,0,,Бұл мен үшін.
Dialogue: 0,0:14:28.34,0:14:30.51,Default,,0,0,0,,Мен саған жақындамаймын.
Dialogue: 0,0:14:31.60,0:14:33.35,Default,,0,0,0,,Ято-сама, өтінемін, солай істеңіз
Dialogue: 0,0:14:34.35,0:14:39.35,Default,,0,0,0,,Иә, еңбегіңіз үшін рахмет. Амано-кун қайтып келгенде, маған хабарласыңыз.
Dialogue: 0,0:14:39.52,0:14:40.35,Default,,0,0,0,,Секір!!
Dialogue: 0,0:14:44.23,0:14:47.36,Default,,0,0,0,,Қауіпсіздік тобы үйіңізге келді.
Dialogue: 0,0:14:47.53,0:14:48.20,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:48.82,0:14:51.99,Default,,0,0,0,,Олардың қауіпсіздігіне қатысты сіз адам санын көбейткіңіз келе ме?
Dialogue: 0,0:14:52.16,0:14:53.49,Default,,0,0,0,,Жоқ, маған бәрібір.
Dialogue: 0,0:14:54.24,0:14:56.50,Default,,0,0,0,,Ол неге бүгін келмейді?
Dialogue: 0,0:14:56.66,0:15:01.13,Default,,0,0,0,,«Алыс бол» деген белгі жеткілікті.
Dialogue: 0,0:15:22.52,0:15:23.48,Default,,0,0,0,,Күлкілі
Dialogue: 0,0:15:24.27,0:15:27.65,Default,,0,0,0,,Ол қашу күнделігіне сәйкес қашып кетті.
Dialogue: 0,0:15:33.62,0:15:34.83,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:15:36.83,0:15:38.45,Default,,0,0,0,,Сіз әлі де қозғала аласыз ба?
Dialogue: 0,0:15:43.58,0:15:44.84,Default,,0,0,0,,Не
Dialogue: 0,0:15:45.63,0:15:47.25,Default,,0,0,0,,Маған көмектесуге рұқсат етіңіз
Dialogue: 0,0:15:47.71,0:15:48.71,Default,,0,0,0,,Мм! Аузың қызық болса да—
Dialogue: 0,0:15:50.47,0:15:53.26,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:53.30,0:15:57.01,Default,,0,0,0,,Енді саған басқа таңдау жоқ.
Dialogue: 0,0:16:09.40,0:16:10.74,Default,,0,0,0,,Кешіріңіз Юкки
Dialogue: 0,0:16:10.86,0:16:12.61,Default,,0,0,0,,Қазір электр қуаты өшірілген.
Dialogue: 0,0:16:12.78,0:16:13.78,Default,,0,0,0,,Иә
Dialogue: 0,0:16:17.24,0:16:20.04,Default,,0,0,0,,Әй, мынау мен бақшаға еккен алма.
Dialogue: 0,0:16:24.50,0:16:25.75,Default,,0,0,0,,​​Мен оны қазір тазалаймын.
Dialogue: 0,0:16:29.38,0:16:31.84,Default,,0,0,0,,Электр алма
Dialogue: 0,0:16:35.43,0:16:36.68,Default,,0,0,0,,Маған дәретхананы пайдалануға рұқсат етіңіз.
Dialogue: 0,0:16:48.86,0:16:52.82,Default,,0,0,0,,Бұл ауруды басатын дәрі. Мұны қабылдау сізді жақсы сезінеді.
Dialogue: 0,0:16:52.99,0:16:56.28,Default,,0,0,0,,Сол ғана. Осы мәлімдеменің мазмұнында қателіктер бар ма?
Dialogue: 0,0:16:56.49,0:16:57.45,Default,,0,0,0,,Мен Кира емеспін. Мені мұнда тез арада шығар.
Dialogue: 0,0:16:58.28,0:17:01.70,Default,,0,0,0,,Егер солай айту керек болса, мен әділдіктің одақтасымын.
Dialogue: 0,0:17:03.50,0:17:07.79,Default,,0,0,0,,Сонда сіз маған көмектесу үшін дұрыс емес жердесіз.
Dialogue: 0,0:17:08.09,0:17:12.38,Default,,0,0,0,,Мен өзімнің әділдігіме сенемін және соған сәйкес әрекет етемін.
Dialogue: 0,0:17:12.63,0:17:14.68,Default,,0,0,0,,Ештеңе дұрыс емес.
Dialogue: 0,0:17:14.84,0:17:18.72,Default,,0,0,0,,Кейін өкінетінімді білмеймін.
Dialogue: 0,0:17:18.89,0:17:22.98,Default,,0,0,0,,Мен өкінетін бірдеңе болса, ол сенсің.
Dialogue: 0,0:17:32.36,0:17:37.74,Default,,0,0,0,,Күнделікте ешқандай өзгеріс жоқ. Жарайды ма?
Dialogue: 0,0:17:43.83,0:17:48.67,Default,,0,0,0,,Ол кезде мен жай ғана дәретхана іздеп жүрдім.
Dialogue: 0,0:17:51.88,0:17:52.63,Default,,0,0,0,,Қандай
Dialogue: 0,0:17:53.96,0:17:57.84,Default,,0,0,0,,Дәретхананы тауып, күнделік бойынша кері қайтыңыз.
Dialogue: 0,0:18:05.81,0:18:07.14,Default,,0,0,0,,Мен сен тұрған жерге дүрлігіп барамын
Dialogue: 0,0:18:12.32,0:18:15.11,Default,,0,0,0,,Бұл қандай бөлме?
Dialogue: 0,0:18:31.71,0:18:32.63,Default,,0,0,0,,Ачи
Dialogue: 0,0:18:32.79,0:18:35.46,Default,,0,0,0,,Маған не сусын бердіңіз?
Dialogue: 0,0:18:38.30,0:18:40.59,Default,,0,0,0,,Бұл емдеуге қажетті дәрі.
Dialogue: 0,0:18:41.89,0:18:42.60,Default,,0,0,0,,Куруна
Dialogue: 0,0:18:48.64,0:18:51.81,Default,,0,0,0,,Ешқандай қашу күнделігі жазылмаған.
Dialogue: 0,0:18:51.98,0:18:55.98,Default,,0,0,0,,Жүр, қазір оянуға болады.
Dialogue: 0,0:18:56.61,0:18:59.24,Default,,0,0,0,,9-шы Амагаре Минене
Dialogue: 0,0:18:59.40,0:19:02.24,Default,,0,0,0,,Сіз күнделіктің иесісіз бе?
Dialogue: 0,0:19:02.32,0:19:05.45,Default,,0,0,0,,3 2 1
Dialogue: 0,0:19:09.37,0:19:12.00,Default,,0,0,0,,Енді бірінші сұраққа.
Dialogue: 0,0:19:12.75,0:19:17.09,Default,,0,0,0,,Сіз білетін күнделік иесі туралы ақпаратты маған хабарлаңыз.
Dialogue: 0,0:19:19.13,0:19:19.63,Default,,0,0,0,,Енді 1-ші нақты тұлға кім?
Dialogue: 0,0:19:19.59,0:19:20.34,Default,,0,0,0,,Тоқта, енді 1-ші адам кім?
Dialogue: 0,0:19:20.34,0:19:23.93,Default,,0,0,0,,Енді 1-ші нақты тұлға кім?
Dialogue: 0,0:19:33.94,0:19:36.90,Default,,0,0,0,,Болашақ күнделік бөлменің ішінде не бар екенін жазбайды.
Dialogue: 0,0:19:37.19,0:19:39.78,Default,,0,0,0,,Бұл сіз мұны ашсаңыз дегенді білдіреді
Dialogue: 0,0:19:39.95,0:19:41.32,Default,,0,0,0,,Болашақ өзгереді
Dialogue: 0,0:19:43.70,0:19:44.62,Default,,0,0,0,,Мен бұған сене алмадым
Dialogue: 0,0:19:45.20,0:19:51.00,Default,,0,0,0,,Бұл біздің болашағымызды мұншалықты өзгертеді деп ойламадым.
Dialogue: 0,0:20:30.87,0:20:33.62,Default,,0,0,0,,Себеп-салдар заңы күйреді.
Dialogue: 0,0:20:35.08,0:20:37.09,Default,,0,0,0,,Юкитеру Амано
Dialogue: 0,0:20:38.80,0:20:40.51,Default,,0,0,0,,Сіз мұны аштыңыз ба?
Dialogue: 0,0:20:41.84,0:20:45.68,Default,,0,0,0,,Сакурами қаласының миниатюралық бағында себеп-салдар заңын бұрмалау
Dialogue: 0,0:20:45.84,0:20:48.31,Default,,0,0,0,,12 иесін ұйымдастырды
Dialogue: 0,0:20:48.43,0:20:52.52,Default,,0,0,0,,Нәтиже: Ешқашан болмауы тиіс ғажайып екі рет қайталанды.
Dialogue: 0,0:20:52.64,0:20:55.31,Default,,0,0,0,,Болашақ түбегейлі өзгереді.
Dialogue: 0,0:20:57.48,0:21:00.07,Default,,0,0,0,,Қызықты Юкитеру Амано
Dialogue: 0,0:21:00.19,0:21:04.28,Default,,0,0,0,,Сізді таңдағаным қате болған жоқ
Dialogue: 0,0:21:10.83,0:21:13.91,Default,,0,0,0,,Барлығы жақсы жүріп жатты.
Dialogue: 0,0:21:14.71,0:21:18.63,Default,,0,0,0,,Неге ашып жатырсың, Юкки?
Dialogue: 0,0:21:43.03,0:21:45.07,Default,,0,0,0,,Юноның үйіндегі сол бөлме
Dialogue: 0,0:21:46.07,0:21:48.24,Default,,0,0,0,,Ол сонда болды
Dialogue: 0,0:21:49.16,0:21:49.70,Default,,0,0,0,,Яғни
Dialogue: 0,0:21:54.66,0:21:55.66,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:22:01.67,0:22:03.88,Default,,0,0,0,,Қайырлы түн Юкки
Dialogue: 0,0:22:05.38,0:22:10.38,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
