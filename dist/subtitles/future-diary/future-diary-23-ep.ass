Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.15,0:00:11.95,Default,,0,0,0,,Жоюдың алдында Деустың өзегін ғана қалдыру
Dialogue: 0,0:00:12.07,0:00:13.49,Default,,0,0,0,,Сіз өміріңізді ұзартқыңыз келе ме?
Dialogue: 0,0:00:14.07,0:00:17.49,Default,,0,0,0,,Енді 28 шілдеге дейін күтуге тура келеді.
Dialogue: 0,0:00:17.66,0:00:19.45,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:00:20.08,0:00:23.33,Default,,0,0,0,,Егер сен менің қызметшім болсаң
Dialogue: 0,0:00:23.46,0:00:26.88,Default,,0,0,0,,Күшіңізді рұқсатсыз пайдалана алмайсыз.
Dialogue: 0,0:00:27.04,0:00:30.96,Default,,0,0,0,,Ол екі қолдағы сақиналармен басқарылады.
Dialogue: 0,0:00:31.67,0:00:33.34,Default,,0,0,0,,Сол уақыт келгенше
Dialogue: 0,0:00:33.47,0:00:35.97,Default,,0,0,0,,Шоуды арнайы орындардан қарауға болмайды.
Dialogue: 0,0:00:46.52,0:00:47.44,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:00:48.77,0:00:51.86,Default,,0,0,0,,Бұл жойылып бара жатқан дүниені сенің орныңа басқаратын адам
Dialogue: 0,0:00:51.94,0:00:53.03,Default,,0,0,0,,Бұл қыран
Dialogue: 0,0:00:54.95,0:00:56.61,Default,,0,0,0,,Содан кейін Мурумуру
Dialogue: 0,0:02:33.38,0:02:36.34,Default,,0,0,0,,Дүниенің ақыры 28 шілдеде болады
Dialogue: 0,0:02:36.51,0:02:39.26,Default,,0,0,0,,Менің телефонымда болжам бар.
Dialogue: 0,0:02:39.38,0:02:42.18,Default,,0,0,0,,Менің ойымша, біз оны Юккидің күнделігінен көре аламыз.
Dialogue: 0,0:02:43.47,0:02:46.06,Default,,0,0,0,,Бұл жақын арада емес пе?
Dialogue: 0,0:02:46.39,0:02:51.52,Default,,0,0,0,,Иә, бірақ бұл 28-ге дейін бар болғаны емес, Юкки.
Dialogue: 0,0:02:52.31,0:02:54.77,Default,,0,0,0,,Мен үшін ең маңызды күн
Dialogue: 0,0:02:57.61,0:03:00.57,Default,,0,0,0,,Юкки екеуміз байланған күн
Dialogue: 0,0:03:23.39,0:03:24.47,Default,,0,0,0,,Судың дыбысы
Dialogue: 0,0:03:28.43,0:03:29.68,Default,,0,0,0,,Мен соңғы рет келдім
Dialogue: 0,0:03:29.89,0:03:32.77,Default,,0,0,0,,Электр және суды өшіру керек еді.
Dialogue: 0,0:03:33.69,0:03:36.40,Default,,0,0,0,,Бәлкім оны өз бетімен шығарып алған шығар?
Dialogue: 0,0:03:38.40,0:03:41.11,Default,,0,0,0,,Бәрібір дүние бітеді.
Dialogue: 0,0:03:41.70,0:03:43.28,Default,,0,0,0,,Ешкім шағымданбайды ма?
Dialogue: 0,0:03:45.70,0:03:48.58,Default,,0,0,0,,Дұрыс, бәрі бітті.
Dialogue: 0,0:03:50.20,0:03:52.04,Default,,0,0,0,,Юно қайда?
Dialogue: 0,0:03:56.13,0:03:57.67,Default,,0,0,0,,Қайырлы таң Юкки
Dialogue: 0,0:03:58.88,0:04:00.88,Default,,0,0,0,,Неге шомылып жатырсың?
Dialogue: 0,0:04:01.05,0:04:03.09,Default,,0,0,0,,Менімен бірге кір, Юкки.
Dialogue: 0,0:04:03.26,0:04:04.64,Default,,0,0,0,,Өтінемін, алға жүріңіз.
Dialogue: 0,0:04:04.76,0:04:06.43,Default,,0,0,0,,Бұл жақсы сезінеді
Dialogue: 0,0:04:06.85,0:04:07.85,Default,,0,0,0,,Чо
Dialogue: 0,0:04:12.10,0:04:14.90,Default,,0,0,0,,Қараңызшы, бұл купальник.
Dialogue: 0,0:04:17.98,0:04:19.73,Default,,0,0,0,,Сіз мені жалаңаш деп ойладыңыз.
Dialogue: 0,0:04:20.19,0:04:21.11,Default,,0,0,0,,Бөлек
Dialogue: 0,0:04:21.24,0:04:22.20,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:04:22.40,0:04:24.41,Default,,0,0,0,,Юккидің өтірік айтқанын оңай анықтауға болады.
Dialogue: 0,0:04:25.57,0:04:26.57,Default,,0,0,0,,Мені күт
Dialogue: 0,0:04:26.74,0:04:28.24,Default,,0,0,0,,Мен оны қазір қайтадан қайнатамын.
Dialogue: 0,0:04:28.45,0:04:29.54,Default,,0,0,0,,Жарайды, проблема жоқ.
Dialogue: 0,0:04:29.74,0:04:33.21,Default,,0,0,0,,Сен күнде ваннаға түсесің, Юкки.
Dialogue: 0,0:04:35.42,0:04:37.54,Default,,0,0,0,,Басқа иелер жоқ.
Dialogue: 0,0:04:38.04,0:04:40.13,Default,,0,0,0,,Өлтіремін деп уайымдаудың қажеті жоқ.
Dialogue: 0,0:04:41.71,0:04:44.34,Default,,0,0,0,,Бұл шынымен де аяқталды
Dialogue: 0,0:04:46.26,0:04:48.39,Default,,0,0,0,,Өлген адамдар қайта тірілмейді.
Dialogue: 0,0:04:48.60,0:04:51.02,Default,,0,0,0,,Мүмкін бәрі дұрыс шығар.
Dialogue: 0,0:04:51.64,0:04:54.06,Default,,0,0,0,,Юно өтірік айтады.
Dialogue: 0,0:04:54.94,0:04:56.85,Default,,0,0,0,,Күте тұрыңыз, Юкки.
Dialogue: 0,0:04:58.40,0:05:00.19,Default,,0,0,0,,Юно өтірік айтады
Dialogue: 0,0:05:00.40,0:05:02.07,Default,,0,0,0,,Бірақ не үшін?
Dialogue: 0,0:05:02.69,0:05:04.86,Default,,0,0,0,,Ол да сені өлтіргісі келеді.
Dialogue: 0,0:05:05.91,0:05:08.78,Default,,0,0,0,,Аман қалу ойынында бір адам ғана аман қалады
Dialogue: 0,0:05:10.79,0:05:12.16,Default,,0,0,0,,(Бұрынғы патша) Мұндай даналыққа ие адам міндетті түрде бар.
Dialogue: 0,0:05:12.58,0:05:14.54,Default,,0,0,0,,Юно мені ешқашан өлтірмейді
Dialogue: 0,0:05:26.55,0:05:28.14,Default,,0,0,0,,Мен Юноға күмәнданбаймын, бірақ
Dialogue: 0,0:05:28.97,0:05:31.31,Default,,0,0,0,,Күнделікті тексеруді жалғастырыңыз.
Dialogue: 0,0:05:32.43,0:05:34.81,Default,,0,0,0,,Мен әкемнің заттарын жинадым.
Dialogue: 0,0:05:35.77,0:05:37.35,Default,,0,0,0,,Қараңызшы, бұл тамаша.
Dialogue: 0,0:05:38.85,0:05:39.94,Default,,0,0,0,,Сәлем Юкки
Dialogue: 0,0:05:40.15,0:05:41.94,Default,,0,0,0,,Бүгін бірге шомылайық
Dialogue: 0,0:05:42.15,0:05:44.69,Default,,0,0,0,,Бір минут күте тұрыңыз.
Dialogue: 0,0:05:44.90,0:05:46.15,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:46.53,0:05:47.74,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:47.95,0:05:49.24,Default,,0,0,0,,Моншалардың арасында
Dialogue: 0,0:05:49.37,0:05:50.99,Default,,0,0,0,,Егер күнделігімді босатып алсам, мен қорғансыз боламын.
Dialogue: 0,0:05:53.04,0:05:56.41,Default,,0,0,0,,Сіз маған күмәнданасыз ба, Юкки?
Dialogue: 0,0:05:56.62,0:05:58.46,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:05.05,0:06:05.84,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:06:07.88,0:06:09.43,Default,,0,0,0,,Мен бүгін ұйықтаймын
Dialogue: 0,0:06:11.22,0:06:12.35,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:06:23.32,0:06:24.90,Default,,0,0,0,,Идиот, ақымақ, ақымақ Юккидің ақымақ
Dialogue: 0,0:06:24.90,0:06:25.86,Default,,0,0,0,,Юно Юно Идиот, ақымақ, ақымақ, Юккидің ақымақ
Dialogue: 0,0:06:25.86,0:06:26.36,Default,,0,0,0,,Юно Юно
Dialogue: 0,0:06:26.57,0:06:30.41,Default,,0,0,0,,Мен тек өлтіре алатын әйелмін.
Dialogue: 0,0:06:30.57,0:06:33.62,Default,,0,0,0,,Мүмкін бұл жай ғана менің тартымды еместігімнен шығар.
Dialogue: 0,0:06:33.83,0:06:36.33,Default,,0,0,0,,Бірақ бәрі біткенде
Dialogue: 0,0:06:36.50,0:06:38.96,Default,,0,0,0,,Мен сені жақсы көресің деп ойладым
Dialogue: 0,0:06:39.17,0:06:42.84,Default,,0,0,0,,Юкки менімен ешқашан араласпайды.
Dialogue: 0,0:06:43.88,0:06:44.59,Default,,0,0,0,,Юно
Dialogue: 0,0:06:46.76,0:06:50.55,Default,,0,0,0,,Мүмкін сондықтан мені шомылуға шақырдың.
Dialogue: 0,0:07:04.69,0:07:09.65,Default,,0,0,0,,Юно мені әлі де жақсы көреді.
Dialogue: 0,0:07:12.45,0:07:15.16,Default,,0,0,0,,Бірақ сен мені өлтірмексің
Dialogue: 0,0:07:17.24,0:07:19.62,Default,,0,0,0,,Юкки ояу
Dialogue: 0,0:07:22.38,0:07:25.50,Default,,0,0,0,,Юно шынымен мені өлтірмекші ме?
Dialogue: 0,0:07:26.21,0:07:29.17,Default,,0,0,0,,Егер менде мүмкіндік болса, мен сені әрқашан өлтірер едім.
Dialogue: 0,0:07:30.34,0:07:31.09,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:07:59.70,0:08:02.46,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:08:13.84,0:08:15.85,Default,,0,0,0,,Юномен қалай бетпе-бет келуім керек?
Dialogue: 0,0:08:17.76,0:08:20.47,Default,,0,0,0,,Мен өзімді қалай сезінетінімді білмеймін
Dialogue: 0,0:08:22.73,0:08:23.60,Default,,0,0,0,,Амано-кун
Dialogue: 0,0:08:26.11,0:08:30.07,Default,,0,0,0,,Біз бірінші рет сыныпта сөйлестік, Юкки.
Dialogue: 0,0:08:30.65,0:08:31.40,Default,,0,0,0,,Юно
Dialogue: 0,0:08:31.61,0:08:34.36,Default,,0,0,0,,Юнода тек Юкки бар
Dialogue: 0,0:08:34.57,0:08:36.07,Default,,0,0,0,,Э? Мен сені естімеймін!
Dialogue: 0,0:08:36.24,0:08:40.95,Default,,0,0,0,,Юно ұзақ уақыт бойы тек Юккиге қарап тұрды.
Dialogue: 0,0:08:44.12,0:08:45.08,Default,,0,0,0,,Юно
Dialogue: 0,0:08:50.80,0:08:52.59,Default,,0,0,0,,Ертең дүниенің ақыры болады
Dialogue: 0,0:08:53.88,0:08:55.22,Default,,0,0,0,,Мен ақымақ болдым
Dialogue: 0,0:08:55.89,0:08:58.39,Default,,0,0,0,,Юно мені үнемі бақылап отырды
Dialogue: 0,0:08:59.43,0:09:00.60,Default,,0,0,0,,Кешіріңіз Юно
Dialogue: 0,0:09:02.43,0:09:03.85,Default,,0,0,0,,Мен де Юноны көргім келеді
Dialogue: 0,0:09:04.56,0:09:05.94,Default,,0,0,0,,Мен сенің шынайы сезімдеріңді білгім келеді
Dialogue: 0,0:09:07.48,0:09:08.94,Default,,0,0,0,,Шамамен уақыт қалды
Dialogue: 0,0:09:09.23,0:09:11.86,Default,,0,0,0,,Мен Юноны дұрыс сүюім керек.
Dialogue: 0,0:09:13.69,0:09:14.61,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:09:18.28,0:09:18.91,Default,,0,0,0,,Юно
Dialogue: 0,0:09:22.54,0:09:24.79,Default,,0,0,0,,Бірге шомылайық.
Dialogue: 0,0:09:27.67,0:09:29.88,Default,,0,0,0,,28 шілдедегі бақытты аяқталу
Dialogue: 0,0:09:31.13,0:09:32.38,Default,,0,0,0,,Бір күн алға жылжу
Dialogue: 0,0:09:42.85,0:09:44.35,Default,,0,0,0,,Ю Юкки
Dialogue: 0,0:09:45.35,0:09:46.60,Default,,0,0,0,,Қандай Юно
Dialogue: 0,0:09:46.77,0:09:49.77,Default,,0,0,0,,Суық болмай тұрып, оны футоныңызға қойыңыз
Dialogue: 0,0:09:50.69,0:09:52.27,Default,,0,0,0,,Иә
Dialogue: 0,0:09:57.95,0:09:58.61,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:59.62,0:10:01.87,Default,,0,0,0,,Не, Юкки?
Dialogue: 0,0:10:02.03,0:10:04.37,Default,,0,0,0,,Ю Юно деген не?
Dialogue: 0,0:10:04.58,0:10:09.50,Default,,0,0,0,,Бұл менің бірінші рет, сондықтан жұмсақ болыңыз.
Dialogue: 0,0:10:10.88,0:10:14.09,Default,,0,0,0,,​​Иә, бұл мен де бірінші рет.
Dialogue: 0,0:10:20.68,0:10:23.68,Default,,0,0,0,,Кел, Юкки
Dialogue: 0,0:10:25.27,0:10:26.18,Default,,0,0,0,,Юно
Dialogue: 0,0:10:28.98,0:10:31.61,Default,,0,0,0,,Юкки сәбиге ұқсайды
Dialogue: 0,0:10:41.12,0:10:41.74,Default,,0,0,0,,Юно
Dialogue: 0,0:10:46.83,0:10:48.29,Default,,0,0,0,,Мен сені жақсы көремін Юно
Dialogue: 0,0:10:49.16,0:10:52.75,Default,,0,0,0,,Иә, мен де, Юкки.
Dialogue: 0,0:11:01.59,0:11:03.43,Default,,0,0,0,,Мен ұзақ айналма жолмен жүрдім, бірақ
Dialogue: 0,0:11:03.68,0:11:07.10,Default,,0,0,0,,Мен Юномен басынан бері солай болған сияқтымын.
Dialogue: 0,0:11:09.10,0:11:10.31,Default,,0,0,0,,Сонымен Юно
Dialogue: 0,0:11:10.48,0:11:12.73,Default,,0,0,0,,Маған шындықты айтуыңды қалаймын.
Dialogue: 0,0:11:14.02,0:11:18.11,Default,,0,0,0,,Әкең мен шешеңнің өмірге оралуы туралы неге өтірік айттың?
Dialogue: 0,0:11:19.70,0:11:21.16,Default,,0,0,0,,Мен де сені өлтіремін.
Dialogue: 0,0:11:21.16,0:11:22.91,Default,,0,0,0,,Бұл өтірік Юно
Dialogue: 0,0:11:27.20,0:11:27.87,Default,,0,0,0,,Юно
Dialogue: 0,0:11:29.04,0:11:30.62,Default,,0,0,0,,Кешіріңіз Юкки
Dialogue: 0,0:11:32.04,0:11:34.04,Default,,0,0,0,,Мен өтірік айттым
Dialogue: 0,0:11:34.34,0:11:36.96,Default,,0,0,0,,Тәңір болсаң, бәрі қайта тіріледі.
Dialogue: 0,0:11:37.38,0:11:40.67,Default,,0,0,0,,Мен Юккиді көтергім келді.
Dialogue: 0,0:11:41.72,0:11:44.85,Default,,0,0,0,,Тәңір болсам да, оны қайта тірілте алмаймын.
Dialogue: 0,0:11:45.01,0:11:49.02,Default,,0,0,0,,Мен ойынға қосылып, алдымен Деусты сұрадым.
Dialogue: 0,0:11:50.31,0:11:52.90,Default,,0,0,0,,Мен жеткілікті бақыттымын
Dialogue: 0,0:11:53.90,0:11:56.94,Default,,0,0,0,,Сондықтан мені Юкки өлтір
Dialogue: 0,0:11:57.86,0:11:59.11,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:11:59.28,0:12:00.44,Default,,0,0,0,,Егер мен Юноны өлтірсем
Dialogue: 0,0:12:00.61,0:12:02.61,Default,,0,0,0,,Мен құдайға айналуым мүмкін, бірақ
Dialogue: 0,0:12:02.78,0:12:05.24,Default,,0,0,0,,Сонда Юно қайта тірілмейді.
Dialogue: 0,0:12:05.41,0:12:07.70,Default,,0,0,0,,Бірақ Юкки аман қалады.
Dialogue: 0,0:12:07.87,0:12:08.62,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:12:09.50,0:12:10.70,Default,,0,0,0,,Мен Юноны өлтіргім келеді.
Dialogue: 0,0:12:10.83,0:12:12.21,Default,,0,0,0,,Мен құдай болмаймын
Dialogue: 0,0:12:12.37,0:12:13.62,Default,,0,0,0,,Юномен бірге өліңіз
Dialogue: 0,0:12:15.96,0:12:18.50,Default,,0,0,0,,Сіз мұны тағы айтасыз.
Dialogue: 0,0:12:19.84,0:12:21.42,Default,,0,0,0,,Бірақ бәрі жақсы болды.
Dialogue: 0,0:12:21.59,0:12:24.18,Default,,0,0,0,,Енді менің күмәнім жойылды.
Dialogue: 0,0:12:24.34,0:12:27.10,Default,,0,0,0,,Акисе-кунның оғаш хабарынан басқасы.
Dialogue: 0,0:12:27.26,0:12:28.72,Default,,0,0,0,,Хабар
Dialogue: 0,0:12:28.89,0:12:32.48,Default,,0,0,0,,Төтенше оқиға, мүмкін емес
Dialogue: 0,0:12:32.64,0:12:34.65,Default,,0,0,0,,Эй, не?
Dialogue: 0,0:12:34.81,0:12:37.40,Default,,0,0,0,,Ол кезде Акисенің ұялы телефонында ештеңе болмаған.
Dialogue: 0,0:12:37.69,0:12:39.23,Default,,0,0,0,,Юно туралы жазылған.
Dialogue: 0,0:12:40.44,0:12:42.86,Default,,0,0,0,,Юно бір рет құдайға айналды.
Dialogue: 0,0:12:43.49,0:12:47.66,Default,,0,0,0,,Бұл әлем уақыт кері қайтарылған екінші әлем.
Dialogue: 0,0:12:51.62,0:12:52.37,Default,,0,0,0,,Юно
Dialogue: 0,0:12:52.58,0:12:54.71,Default,,0,0,0,,Әлі ерте, Юкки.
Dialogue: 0,0:12:56.63,0:12:58.50,Default,,0,0,0,,Юно не болды?
Dialogue: 0,0:12:58.96,0:13:00.00,Default,,0,0,0,,Титан туралы сөйлесіп отырдық, иә?
Dialogue: 0,0:13:00.38,0:13:01.51,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:13:02.97,0:13:04.59,Default,,0,0,0,,Кем дегенде бүгін үшін
Dialogue: 0,0:13:04.88,0:13:07.76,Default,,0,0,0,,Мен Юккимен бақытты болғым келді.
Dialogue: 0,0:13:23.57,0:13:25.36,Default,,0,0,0,,Әйтеуір, әзірше бұл жерден кетейік.
Dialogue: 0,0:13:33.50,0:13:35.21,Default,,0,0,0,,Дәл осы уақытқа дейін
Dialogue: 0,0:13:36.25,0:13:36.87,Default,,0,0,0,,Кираны қолдайтын жолдастар,
Dialogue: 0,0:13:41.75,0:13:43.30,Default,,0,0,0,,Неге, Юно
Dialogue: 0,0:13:52.01,0:13:53.89,Default,,0,0,0,,Білгіңіз келе ме? Юкитеру
Dialogue: 0,0:13:56.56,0:13:58.27,Default,,0,0,0,,Тоқта
Dialogue: 0,0:14:01.02,0:14:02.02,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:14:05.94,0:14:08.41,Default,,0,0,0,,Мұнда Сынып бөлмесі
Dialogue: 0,0:14:18.46,0:14:19.37,Default,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:14:21.34,0:14:22.80,Default,,0,0,0,,Юно
Dialogue: 0,0:14:29.51,0:14:32.26,Default,,0,0,0,,Не болды, сіз де жаза алмайсыз ба?
Dialogue: 0,0:14:33.01,0:14:36.60,Default,,0,0,0,,​​Менің әкем мен анам өткен аптада ажырасып кетті.
Dialogue: 0,0:14:36.73,0:14:38.60,Default,,0,0,0,,Әрине, сен маған тиісе алмайсың.
Dialogue: 0,0:14:38.60,0:14:39.27,Default,,0,0,0,,(Мен телескоп сатып алдым)
Dialogue: 0,0:14:39.56,0:14:40.40,Default,,0,0,0,,Мурумуру
Dialogue: 0,0:14:40.85,0:14:44.07,Default,,0,0,0,,Бұл сіздің және 2-нің өткені туралы көрініс.
Dialogue: 0,0:14:44.57,0:14:45.94,Default,,0,0,0,,Бұл сіздің әрекетіңіз бе?
Dialogue: 0,0:14:46.78,0:14:50.70,Default,,0,0,0,,Бұл кезде 2-ші ата-анасын өлтіріп қойған.
Dialogue: 0,0:14:50.86,0:14:51.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.24,0:14:55.45,Default,,0,0,0,,Онда неге менімен бірге жұлдыздарды көруге бармайсың?
Dialogue: 0,0:14:55.54,0:14:56.50,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:56.50,0:14:57.00,Default,,0,0,0,,(Осында обсерватория бар.)
Dialogue: 0,0:14:56.75,0:14:57.96,Default,,0,0,0,,Менің болашаққа деген арманым жоқ (дәл сол жерде обсерватория бар)
Dialogue: 0,0:14:57.96,0:14:58.46,Default,,0,0,0,,Менің болашаққа деген арманым жоқ.
Dialogue: 0,0:14:59.04,0:15:02.92,Default,,0,0,0,,Екiншiге үмiт берген — Жаратқан Иеден басқа.
Dialogue: 0,0:15:03.17,0:15:04.34,Default,,0,0,0,,I
Dialogue: 0,0:15:04.59,0:15:07.92,Default,,0,0,0,,Мен сенің болашақ жарың боламын.
Dialogue: 0,0:15:08.13,0:15:10.13,Default,,0,0,0,,Мен өскенде
Dialogue: 0,0:15:10.30,0:15:11.05,Default,,0,0,0,,Иә
Dialogue: 0,0:15:11.47,0:15:12.59,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:15:12.76,0:15:14.72,Default,,0,0,0,,Менімен бірге Юкитеру
Dialogue: 0,0:15:14.72,0:15:16.56,Default,,0,0,0,,Е, қайда?
Dialogue: 0,0:15:16.72,0:15:18.73,Default,,0,0,0,,Сіз білгіңіз келеді.
Dialogue: 0,0:15:18.93,0:15:22.52,Default,,0,0,0,,Неліктен екінші сізді өлтірмекші?
Dialogue: 0,0:15:23.06,0:15:24.98,Default,,0,0,0,,Жоқ, маған қарама, Юкки.
Dialogue: 0,0:15:26.15,0:15:28.03,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:15:29.49,0:15:31.45,Default,,0,0,0,,Қарама, тоқта.
Dialogue: 0,0:15:31.57,0:15:33.66,Default,,0,0,0,,Өтінемін, оған қарамаңыз.
Dialogue: 0,0:15:38.58,0:15:40.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:40.50,0:15:44.00,Default,,0,0,0,,Бұл жерде бізде өткеннен болашаққа деген көзқарас бар.
Dialogue: 0,0:15:45.67,0:15:47.00,Default,,0,0,0,,Бұл не бейне?
Dialogue: 0,0:15:48.42,0:15:50.63,Default,,0,0,0,,Сіз нені айтасыз, Мурумуру?
Dialogue: 0,0:15:50.76,0:15:53.80,Default,,0,0,0,,Менің рөлім ойынды қызықты ету.
Dialogue: 0,0:15:53.80,0:15:55.30,Default,,0,0,0,,Бұл жай ғана шоу.
Dialogue: 0,0:15:55.43,0:15:56.22,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:15:58.27,0:16:00.06,Default,,0,0,0,,Әкем ана
Dialogue: 0,0:16:00.73,0:16:04.23,Default,,0,0,0,,Келесі жолы мен болашақ күйеуімді таныстырамын.
Dialogue: 0,0:16:06.23,0:16:09.36,Default,,0,0,0,,Мен Юноға эмоционалды қолдау болдым деп ойлаймын.
Dialogue: 0,0:16:09.90,0:16:11.03,Default,,0,0,0,,Мен естігенімдей
Dialogue: 0,0:16:11.20,0:16:14.99,Default,,0,0,0,,Менің екінші арманым - Юкитеру Аманоның әйелі болу.
Dialogue: 0,0:16:15.16,0:16:17.37,Default,,0,0,0,,Бұл орындалмайтын арман.
Dialogue: 0,0:16:17.53,0:16:18.37,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:18.54,0:16:21.83,Default,,0,0,0,,Аман қалу ойыны осыдан кейін басталады.
Dialogue: 0,0:16:21.96,0:16:25.13,Default,,0,0,0,,Ол жерде бір ғана адам аман қалатыны сөзсіз.
Dialogue: 0,0:16:26.96,0:16:30.01,Default,,0,0,0,,Бірақ 2-ші риза болды.
Dialogue: 0,0:16:30.17,0:16:34.22,Default,,0,0,0,,Бұдан былай мен Юкитерумен көбірек уақыт өткізе аламын.
Dialogue: 0,0:16:34.34,0:16:38.06,Default,,0,0,0,,Ойынның соңында біреуіміз өлуіміз керек.
Dialogue: 0,0:16:39.26,0:16:42.73,Default,,0,0,0,,Юкитеру, сен не істемекші едің?
Dialogue: 0,0:16:42.94,0:16:45.40,Default,,0,0,0,,Мен
Dialogue: 0,0:16:46.23,0:16:50.44,Default,,0,0,0,,Иә, уәде беремін, мен бәрін бүлдіремін.
Dialogue: 0,0:16:51.94,0:16:55.03,Default,,0,0,0,,Егер құдай болсаң, барлығын тірілт
Dialogue: 0,0:16:55.36,0:16:57.78,Default,,0,0,0,,Мен Юноны бақытты еткім келді
Dialogue: 0,0:16:59.45,0:17:02.70,Default,,0,0,0,,Бірақ қазір мен бұл мүмкін емес екенін білемін
Dialogue: 0,0:17:02.83,0:17:04.54,Default,,0,0,0,,Мен өз-өзіме қол жұмсағанды жөн көремін
Dialogue: 0,0:17:04.67,0:17:07.33,Default,,0,0,0,,Екіншісі мені өлтірсе, бәрібір деп ойлаймын.
Dialogue: 0,0:17:09.29,0:17:11.51,Default,,0,0,0,,Енді басты тақырып
Dialogue: 0,0:17:11.84,0:17:15.18,Default,,0,0,0,,Бірінші дүние қалай аяқталды?
Dialogue: 0,0:17:16.05,0:17:17.34,Default,,0,0,0,,Бірінші раунд
Dialogue: 0,0:17:17.47,0:17:18.22,Default,,0,0,0,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:17:18.35,0:17:21.52,Default,,0,0,0,,Оны Акисе хабарлаған жоқ па?
Dialogue: 0,0:17:22.14,0:17:23.93,Default,,0,0,0,,Көрініске мұқият қараңыз.
Dialogue: 0,0:17:27.94,0:17:32.28,Default,,0,0,0,,​​А, бұл мен білетін бұрынғыдан сәл өзгеше.
Dialogue: 0,0:17:32.32,0:17:34.07,Default,,0,0,0,,Байқадыңыз ба?
Dialogue: 0,0:17:34.74,0:17:37.99,Default,,0,0,0,,Мен дәл қазір қарап отырған дүниенің бірінші раунды болды.
Dialogue: 0,0:17:38.16,0:17:41.99,Default,,0,0,0,,Сіз шынымен екінші әлемде өмір сүріп жатырсыз.
Dialogue: 0,0:17:42.16,0:17:43.58,Default,,0,0,0,,Екінші раунд
Dialogue: 0,0:18:00.89,0:18:04.47,Default,,0,0,0,,1-ші және 2-ші раундта барлық иелерді жеңіңіз
Dialogue: 0,0:18:04.64,0:18:05.68,Default,,0,0,0,,Аман қалды
Dialogue: 0,0:18:05.98,0:18:08.52,Default,,0,0,0,,Ал сен суицидті таңдадың.
Dialogue: 0,0:18:08.69,0:18:10.31,Default,,0,0,0,,Сен әлі күнге дейін қылмыскерлердің өлтіріліп жатқанын Цукиге айтпағансың ба?
Dialogue: 0,0:18:10.52,0:18:13.53,Default,,0,0,0,,Бұл 2-ші қатенің біріншісі
Dialogue: 0,0:18:34.50,0:18:36.26,Default,,0,0,0,,Күте тұрыңыз, Амано-кун.
Dialogue: 0,0:18:37.09,0:18:40.68,Default,,0,0,0,,Мен құдай болып, сені тірілтемін.
Dialogue: 0,0:18:43.72,0:18:47.18,Default,,0,0,0,,Бұл біртүрлі. Болып жатқан жоқ.
Dialogue: 0,0:18:47.60,0:18:48.31,Default,,0,0,0,,Тәнді тірілту мүмкін болса да, жанды тірілту мүмкін емес.
Dialogue: 0,0:18:48.31,0:18:50.81,Default,,0,0,0,,Эй, оян. Ұйқыдан тұрсаң, тәнің қайта тірілсе де, жаның тірілмейді.
Dialogue: 0,0:18:50.81,0:18:51.31,Default,,0,0,0,,Тәнді тірілту мүмкін болса да, жанды тірілту мүмкін емес.
Dialogue: 0,0:18:51.73,0:18:55.23,Default,,0,0,0,,Бірінші раундтағы 2-ші осы уақытқа дейін мұны білмеді.
Dialogue: 0,0:18:55.82,0:18:58.49,Default,,0,0,0,,Юно Деустан сұрау арқылы білді.
Dialogue: 0,0:18:58.61,0:19:00.78,Default,,0,0,0,,Жоқ, мен ештеңе естіген жоқпын.
Dialogue: 0,0:19:00.95,0:19:04.12,Default,,0,0,0,,Мен оны іс жүзінде қолданып көргеннен кейін ғана білдім.
Dialogue: 0,0:19:05.08,0:19:06.66,Default,,0,0,0,,Шын мәнінде
Dialogue: 0,0:19:07.25,0:19:12.46,Default,,0,0,0,,2-ші содан кейін құдай болды және уақыт пен кеңістікті басқаруға күшке ие болды және
Dialogue: 0,0:19:13.75,0:19:16.51,Default,,0,0,0,,Мен бастапқы Юкитеру болған ескі күндерге оралғым келеді.
Dialogue: 0,0:19:16.80,0:19:19.26,Default,,0,0,0,,Бұл менің екінші қателігім болды.
Dialogue: 0,0:19:19.47,0:19:20.59,Default,,0,0,0,,Қайда бару керек
Dialogue: 0,0:19:29.06,0:19:29.94,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:33.90,0:19:36.98,Default,,0,0,0,,Бұл жақсы, міне, солай
Dialogue: 0,0:19:38.53,0:19:40.86,Default,,0,0,0,,Маған екеуің де керек емессіңдер.
Dialogue: 0,0:19:41.74,0:19:43.49,Default,,0,0,0,,Түсінесің бе, Юкитеру?
Dialogue: 0,0:19:43.66,0:19:48.37,Default,,0,0,0,,Бұл 2-ші Жаратқан Иеге танылудан қорқатын факт.
Dialogue: 0,0:19:55.42,0:19:58.05,Default,,0,0,0,,Юно қазір осында.
Dialogue: 0,0:19:58.46,0:20:01.09,Default,,0,0,0,,Юно өткенге қайтады және екі рет айналады
Dialogue: 0,0:20:01.59,0:20:03.09,Default,,0,0,0,,Үшінші мәйіт
Dialogue: 0,0:20:03.30,0:20:06.39,Default,,0,0,0,,Бұл дүниеде басынан бері болған Юно еді.
Dialogue: 0,0:20:06.97,0:20:10.27,Default,,0,0,0,,Мен өзім өлтірдім, себебі ол көшірме болды.
Dialogue: 0,0:20:12.27,0:20:16.31,Default,,0,0,0,,Екеуі де шынайы емес пе?
Dialogue: 0,0:20:18.86,0:20:19.82,Default,,0,0,0,,Юно
Dialogue: 0,0:20:20.49,0:20:22.78,Default,,0,0,0,,Юноны оят
Dialogue: 0,0:20:24.61,0:20:26.24,Default,,0,0,0,,Мен саған Юкитеру айттым
Dialogue: 0,0:20:26.41,0:20:28.08,Default,,0,0,0,,Өйткені, бұл өткеннің көрінісі.
Dialogue: 0,0:20:28.20,0:20:30.54,Default,,0,0,0,,Ұстауға немесе кедергі жасауға болмайды.
Dialogue: 0,0:20:30.70,0:20:31.91,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:20:32.37,0:20:36.63,Default,,0,0,0,,Сол кезде сен маған әйелім болатыныңды айттың.
Dialogue: 0,0:20:36.75,0:20:37.88,Default,,0,0,0,,Бұл Юно емес пе?
Dialogue: 0,0:20:38.04,0:20:42.30,Default,,0,0,0,,Өздігінен өлтірілді.
Dialogue: 0,0:20:43.93,0:20:44.63,Default,,0,0,0,,Юно
Dialogue: 0,0:20:45.34,0:20:46.51,Default,,0,0,0,,Юно
Dialogue: 0,0:20:49.64,0:20:51.31,Default,,0,0,0,,Ко
Dialogue: 0,0:20:52.93,0:20:57.65,Default,,0,0,0,,А, мен ол баланың даусын естіп тұрмын.
Dialogue: 0,0:20:59.94,0:21:01.65,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:21:11.24,0:21:27.39,Default,,0,0,0,,Маған көмектесші... көмектесші... аа... Амано-кун
Dialogue: 0,0:21:29.55,0:21:31.97,Default,,0,0,0,,Юно
Dialogue: 0,0:21:37.98,0:21:42.36,Default,,0,0,0,,Юно
Dialogue: 0,0:21:43.86,0:21:48.86,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
