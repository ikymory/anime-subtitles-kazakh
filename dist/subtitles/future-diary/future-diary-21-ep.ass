Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.98,0:00:09.94,Default,,0,0,0,,Юно Жоспарлағандай үлкен шу шығарып жатқанда
Dialogue: 0,0:00:10.07,0:00:11.57,Default,,0,0,0,,25-қабатқа келіңіз.
Dialogue: 0,0:00:11.74,0:00:15.66,Default,,0,0,0,,Юкки мен сені жақсы көремін
Dialogue: 0,0:00:15.99,0:00:18.41,Default,,0,0,0,,Иә, мен де.
Dialogue: 0,0:00:29.21,0:00:32.09,Default,,0,0,0,,Екіншісі жапон семсерімен жан-жаққа жүгіріп барады.
Dialogue: 0,0:00:32.22,0:00:34.59,Default,,0,0,0,,Иә, бірақ мен оны қазір жоғалтып алдым...
Dialogue: 0,0:00:35.89,0:00:36.97,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:00:37.10,0:00:39.56,Default,,0,0,0,,Бұл оқиға болған жер, төрт мұнара ғимараты.
Dialogue: 0,0:00:39.72,0:00:41.14,Default,,0,0,0,,Қылмыс туралы хабарламаға сәйкес
Dialogue: 0,0:00:41.22,0:00:42.93,Default,,0,0,0,,Қылмыскер кепілді қалқан ретінде пайдаланады
Dialogue: 0,0:00:43.06,0:00:45.27,Default,,0,0,0,,Олар Сакурами қаласының мэріне бара жатқан сияқты.
Dialogue: 0,0:00:45.77,0:00:48.61,Default,,0,0,0,,Содан кейін ол телеарнаға жеткізілді.
Dialogue: 0,0:00:48.82,0:00:51.48,Default,,0,0,0,,Қылмыскердің әкімге жазған өтінішін оқыңыз.
Dialogue: 0,0:00:52.19,0:00:55.86,Default,,0,0,0,,Ханзада Косака Хино Хината Мао Нонозака
Dialogue: 0,0:00:55.99,0:00:59.28,Default,,0,0,0,,Үшеуінің босатылуы және мэр Джон Бакстың өзін-өзі өлтіруі
Dialogue: 0,0:01:00.20,0:01:03.45,Default,,0,0,0,,Бұл жігіт 11-ші қозғалысты насихаттау үшін бұқаралық ақпарат құралдарын пайдаланады.
Dialogue: 0,0:01:04.58,0:01:07.25,Default,,0,0,0,,Юно Косака-кунды және басқаларды босатады.
Dialogue: 0,0:01:07.46,0:01:09.04,Default,,0,0,0,,Иә, Юкки
Dialogue: 0,0:01:11.63,0:01:13.80,Default,,0,0,0,,Мен 11-ді жеңемін
Dialogue: 0,0:01:17.18,0:01:19.68,Default,,0,0,0,,Бұл жігіттің көздері осындай болды ма?
Dialogue: 0,0:01:20.43,0:01:23.64,Default,,0,0,0,,Мен құдай болып, әке-шешемді құтқарамын...
Dialogue: 0,0:01:38.41,0:01:40.07,Default,,0,0,0,,Кешіріңіз, Нишижима
Dialogue: 0,0:01:40.91,0:01:44.58,Default,,0,0,0,,Мен әлі де лаңкестерді тоқтата алмаймын деп ойлаймын.
Dialogue: 0,0:03:25.10,0:03:26.22,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:03:26.35,0:03:28.47,Default,,0,0,0,,Полиция бір сағаттан кейін келеді.
Dialogue: 0,0:03:30.73,0:03:32.10,Default,,0,0,0,,Сәлем 1-ші
Dialogue: 0,0:03:33.56,0:03:35.31,Default,,0,0,0,,Біз ұмытып, емделеміз бе?
Dialogue: 0,0:03:35.48,0:03:37.23,Default,,0,0,0,,Осы сол көз туралы
Dialogue: 0,0:03:37.36,0:03:41.95,Default,,0,0,0,,Ал сіз қалдырған Нисидзима туралы.
Dialogue: 0,0:03:44.82,0:03:47.33,Default,,0,0,0,,Мен сені 11-ші өлтіргенше тірі қалдырамын.
Dialogue: 0,0:03:48.04,0:03:50.37,Default,,0,0,0,,Бірақ бұл стратегия сәтсіз болса
Dialogue: 0,0:03:52.04,0:03:54.13,Default,,0,0,0,,Мен сені өлтіремін.
Dialogue: 0,0:04:03.93,0:04:06.43,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:04:06.60,0:04:08.06,Default,,0,0,0,,Қолдарыңызды көтеріңіз!
Dialogue: 0,0:04:08.18,0:04:10.31,Default,,0,0,0,,Сіз мұнымен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:04:10.43,0:04:13.73,Default,,0,0,0,,Бұл дұрыс. Маған не қалдыра аласыз?
Dialogue: 0,0:04:13.90,0:04:18.23,Default,,0,0,0,,Түнгі аспандағы жұлдызға айналып, жарқыраудың мәні жоқ.
Dialogue: 0,0:04:18.36,0:04:20.94,Default,,0,0,0,,Хахаха бұл әзіл ең жақсы
Dialogue: 0,0:04:22.40,0:04:24.11,Default,,0,0,0,,Эй, бұл жігіттерді не істейміз?
Dialogue: 0,0:04:24.24,0:04:26.57,Default,,0,0,0,,Маған жоғары жақтағылар бұлардан құтылу керектігін айтады.
Dialogue: 0,0:04:26.66,0:04:28.16,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:04:28.33,0:04:30.45,Default,,0,0,0,,Біз жай ғана баламыз
Dialogue: 0,0:04:30.58,0:04:33.25,Default,,0,0,0,,Холон туралы ешкімге айтпаймын.
Dialogue: 0,0:04:35.67,0:04:37.75,Default,,0,0,0,,Бұл жігіт оңай сөйлейтін сияқты.
Dialogue: 0,0:04:37.92,0:04:39.21,Default,,0,0,0,,Мен сені өлтіруім керек пе?
Dialogue: 0,0:04:40.92,0:04:41.84,Default,,0,0,0,,Аху
Dialogue: 0,0:04:51.81,0:04:52.39,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:04:52.52,0:04:53.39,Default,,0,0,0,,Екі адам қаза тапты.
Dialogue: 0,0:04:53.56,0:04:54.06,Default,,0,0,0,,Жау
Dialogue: 0,0:04:58.06,0:04:58.94,Default,,0,0,0,,11
Dialogue: 0,0:05:03.15,0:05:04.07,Default,,0,0,0,,Агацума банкі
Dialogue: 0,0:05:06.70,0:05:09.12,Default,,0,0,0,,Бұл өткен жылы банкротқа ұшыраған банк.
Dialogue: 0,0:05:09.33,0:05:12.20,Default,,0,0,0,,Осы жылы қала өз билігін алды.
Dialogue: 0,0:05:12.37,0:05:16.17,Default,,0,0,0,,Бастапқыда бұл менің 2-ші ата-анама тиесілі болғанына сенімдімін.
Dialogue: 0,0:05:16.62,0:05:18.54,Default,,0,0,0,,11-ші күтіңіз
Dialogue: 0,0:05:21.84,0:05:23.46,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,0:05:23.84,0:05:26.80,Default,,0,0,0,,Енді бұл менің қалқаным
Dialogue: 0,0:05:27.59,0:05:30.68,Default,,0,0,0,,Мені жаулардан қорғау үшін «Болат қалқан».
Dialogue: 0,0:05:34.18,0:05:36.39,Default,,0,0,0,,Өкініштісі, олар өздерін жауып тастайды.
Dialogue: 0,0:05:36.56,0:05:37.35,Default,,0,0,0,,Рух толқындарын қолдануды да ұмытып кеткенмін
Dialogue: 0,0:05:48.11,0:05:49.20,Default,,0,0,0,,PIN нөмірі
Dialogue: 0,0:05:49.87,0:05:50.66,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:05:53.79,0:05:56.12,Default,,0,0,0,,Өлгің келмесе, тез жауап бер.
Dialogue: 0,0:06:22.23,0:06:24.90,Default,,0,0,0,,Бұл қос есік екені өкінішті.
Dialogue: 0,0:06:30.41,0:06:31.57,Default,,0,0,0,,Сәлем Агацума
Dialogue: 0,0:06:31.74,0:06:33.45,Default,,0,0,0,,Холон ондай емес.
Dialogue: 0,0:06:33.62,0:06:35.08,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:06:38.16,0:06:39.33,Default,,0,0,0,,Агацума банкіне
Dialogue: 0,0:06:45.59,0:06:48.09,Default,,0,0,0,,Мен карта кілтін немесе PIN нөмірін пайдалана алмаймын.
Dialogue: 0,0:06:49.84,0:06:52.60,Default,,0,0,0,,Оны ашу оңай болмайды.
Dialogue: 0,0:06:58.18,0:06:59.31,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:07:00.44,0:07:04.15,Default,,0,0,0,,Егер тапсырма орындалмаса, мен сені өлтіремін деп айттым.
Dialogue: 0,0:07:04.69,0:07:07.32,Default,,0,0,0,,Есікті ашудың әлі де жолы бар.
Dialogue: 0,0:07:07.44,0:07:08.28,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:07:10.66,0:07:11.82,Default,,0,0,0,,Бұл шамамен 11-і.
Dialogue: 0,0:07:12.03,0:07:14.24,Default,,0,0,0,,Бұл болады деп күтілген болатын.
Dialogue: 0,0:07:17.83,0:07:18.95,Default,,0,0,0,,Нишижима
Dialogue: 0,0:07:19.75,0:07:24.17,Default,,0,0,0,,Ол мені бақытты ететінін айтқан жалғыз адам болды.
Dialogue: 0,0:07:25.59,0:07:28.63,Default,,0,0,0,,Мен сені өлтіріп, Нишижима үшін кек аламын.
Dialogue: 0,0:07:31.05,0:07:34.35,Default,,0,0,0,,Мен тез арада 8-ді өлтіріп, Юккиге оралуым керек.
Dialogue: 0,0:07:34.68,0:07:38.56,Default,,0,0,0,,Қашқын әйел қайда бара жатыр?
Dialogue: 0,0:07:40.52,0:07:41.85,Default,,0,0,0,,Акиседен қоңырау шалу
Dialogue: 0,0:07:47.82,0:07:49.40,Default,,0,0,0,,Қашпа 1-ші
Dialogue: 0,0:07:52.36,0:07:54.24,Default,,0,0,0,,Юно осында қайтып келгенше
Dialogue: 0,0:07:55.32,0:07:56.95,Default,,0,0,0,,Мен оған дейін шыдауым керек.
Dialogue: 0,0:07:58.66,0:07:59.45,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:08:01.00,0:08:02.21,Default,,0,0,0,,Шық!
Dialogue: 0,0:08:03.46,0:08:05.75,Default,,0,0,0,,Мен тым көп қан жоғалттым
Dialogue: 0,0:08:06.46,0:08:08.59,Default,,0,0,0,,Мен тек сені өлтіру ғана
Dialogue: 0,0:08:09.46,0:08:12.30,Default,,0,0,0,,Бұл негізінен ата-анаңызды өмірге қайтару туралы.
Dialogue: 0,0:08:12.76,0:08:15.68,Default,,0,0,0,,Құдай болып, әке-шешеңді құтқар
Dialogue: 0,0:08:16.85,0:08:18.51,Default,,0,0,0,,Өзімшіл болма.
Dialogue: 0,0:08:19.01,0:08:20.89,Default,,0,0,0,,Егер бұл себеп жұмыс істесе
Dialogue: 0,0:08:21.02,0:08:24.15,Default,,0,0,0,,Бүкіл дүние жүзіндегі адамдар құдай болуды мақсат етеді.
Dialogue: 0,0:08:25.23,0:08:30.19,Default,,0,0,0,,Менің бала кезім туралы естідіңіз бе?
Dialogue: 0,0:08:31.57,0:08:35.28,Default,,0,0,0,,Біз тіпті тіл білмейтін Таяу Шығыстағы алыс елде
Dialogue: 0,0:08:35.91,0:08:37.62,Default,,0,0,0,,Мен ата-анамнан айырылдым
Dialogue: 0,0:08:39.29,0:08:42.04,Default,,0,0,0,,Содан бері әр күнім өмірімді қатерге тіге бастады.
Dialogue: 0,0:08:42.79,0:08:44.62,Default,,0,0,0,,Бір бөлке нанды ұрлама.
Dialogue: 0,0:08:44.83,0:08:48.38,Default,,0,0,0,,Шын мәнінде, сәтсіздікке ұшырап, қайтыс болғандар көп болды.
Dialogue: 0,0:08:50.50,0:08:52.01,Default,,0,0,0,,Шынымды айтсам,
Dialogue: 0,0:08:53.51,0:08:55.59,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:08:59.68,0:09:01.89,Default,,0,0,0,,Мина алаңында жүгіру сияқты.
Dialogue: 0,0:09:02.22,0:09:04.77,Default,,0,0,0,,Улы газдың үстіне құлаған адамның бейнесі.
Dialogue: 0,0:09:04.94,0:09:08.27,Default,,0,0,0,,Қандай тітіркендіргішсің, ата-анаңнан айырылғаннан кейін шарасыз.
Dialogue: 0,0:09:08.40,0:09:11.86,Default,,0,0,0,,Көрінісің сонша, маған қарап тұрғандайсың
Dialogue: 0,0:09:12.23,0:09:14.11,Default,,0,0,0,,Сондықтан мен саған айтамын.
Dialogue: 0,0:09:14.24,0:09:15.61,Default,,0,0,0,,Сіздің армандарыңыз орындалмайды
Dialogue: 0,0:09:16.41,0:09:17.57,Default,,0,0,0,,Бұл орындалмайды
Dialogue: 0,0:09:23.50,0:09:25.87,Default,,0,0,0,,Сіз бірде-бір шу шығармайсыз.
Dialogue: 0,0:09:26.67,0:09:28.58,Default,,0,0,0,,Ал, менің қайда екенім белгілі болады.
Dialogue: 0,0:09:29.92,0:09:31.84,Default,,0,0,0,,Бізге жақын арада болашақты өзгерту керек
Dialogue: 0,0:09:32.17,0:09:33.67,Default,,0,0,0,,Біз болашақты өзгертуіміз керек
Dialogue: 0,0:09:33.80,0:09:36.05,Default,,0,0,0,,Сізді тауып өлтіресіз.
Dialogue: 0,0:09:36.43,0:09:40.64,Default,,0,0,0,,Бірақ болашақты өзгертсек те, біздің орнымыз бәрібір шу арқылы анықталады.
Dialogue: 0,0:09:41.89,0:09:42.93,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:09:59.91,0:10:01.91,Default,,0,0,0,,Хаха, бұл оңай.
Dialogue: 0,0:10:02.41,0:10:05.33,Default,,0,0,0,,Маған осында қалып, қарау керек.
Dialogue: 0,0:10:06.50,0:10:08.21,Default,,0,0,0,,Екінші есік
Dialogue: 0,0:10:08.54,0:10:11.38,Default,,0,0,0,,Тор қабықтың аутентификация құлпын кім аша алады?
Dialogue: 0,0:10:11.75,0:10:16.34,Default,,0,0,0,,Мен және Ушио Агацума Нисика Агацума тіркелдім
Dialogue: 0,0:10:19.22,0:10:22.18,Default,,0,0,0,,Тек менің қызым Юно Агацума
Dialogue: 0,0:10:23.68,0:10:26.85,Default,,0,0,0,,Әрине, егер бұл жалған болса, бұл орындалмайды.
Dialogue: 0,0:10:34.98,0:10:35.78,Default,,0,0,0,,8-ші
Dialogue: 0,0:10:39.24,0:10:41.03,Default,,0,0,0,,Егер мен бұл жігітті өлтірсем
Dialogue: 0,0:10:45.45,0:10:46.58,Default,,0,0,0,,Ақисе Ару
Dialogue: 0,0:10:48.16,0:10:51.46,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:10:57.46,0:10:59.47,Default,,0,0,0,,Юноға кешірім сұраймын.
Dialogue: 0,0:10:59.63,0:11:03.14,Default,,0,0,0,,Мен өлсем, әкем мен шешем
Dialogue: 0,0:11:03.85,0:11:04.97,Default,,0,0,0,,Ерік
Dialogue: 0,0:11:11.06,0:11:12.90,Default,,0,0,0,,Қысымға төтеп бере алмадыңыз ба?
Dialogue: 0,0:11:15.02,0:11:16.61,Default,,0,0,0,,Бұл да сен сияқты.
Dialogue: 0,0:11:17.74,0:11:18.40,Default,,0,0,0,,1-ші
Dialogue: 0,0:11:20.03,0:11:23.70,Default,,0,0,0,,Мен сені соншалықты ұсқынсыз болғаның үшін жек көрмедім.
Dialogue: 0,0:11:27.95,0:11:28.87,Default,,0,0,0,,Тек ұялы телефон
Dialogue: 0,0:11:32.08,0:11:34.25,Default,,0,0,0,,Мен Юноға әдейі өсиет жаздым.
Dialogue: 0,0:11:34.79,0:11:37.50,Default,,0,0,0,,Егер мен мұны істесем, Юно дүрбелеңге түседі.
Dialogue: 0,0:11:37.67,0:11:38.71,Default,,0,0,0,,Болашақ өзгерді
Dialogue: 0,0:11:38.88,0:11:40.05,Default,,0,0,0,,Шулы дыбыс бар
Dialogue: 0,0:11:40.67,0:11:41.51,Default,,0,0,0,,1-ші
Dialogue: 0,0:11:43.05,0:11:47.60,Default,,0,0,0,,Мен әкем мен анамды тірілтудің өзімшілдік екенін білемін.
Dialogue: 0,0:11:48.52,0:11:49.73,Default,,0,0,0,,Неге атпайсың?
Dialogue: 0,0:11:51.19,0:11:52.85,Default,,0,0,0,,Мен сені өлтіргім келмейді
Dialogue: 0,0:11:52.90,0:11:53.77,Default,,0,0,0,,болып табылады
Dialogue: 0,0:11:56.11,0:11:59.99,Default,,0,0,0,,Мен де ешкімді өлтіргім келмеді.
Dialogue: 0,0:12:00.69,0:12:03.16,Default,,0,0,0,,Бірақ оған көмектесу мүмкін емес.
Dialogue: 0,0:12:03.36,0:12:05.53,Default,,0,0,0,,Басқа амал жоқ еді.
Dialogue: 0,0:12:06.28,0:12:07.28,Default,,0,0,0,,Сен
Dialogue: 0,0:12:07.58,0:12:08.95,Default,,0,0,0,,Олай болса, маған хабарлаңыз.
Dialogue: 0,0:12:09.29,0:12:11.50,Default,,0,0,0,,Мен не істеуім керек еді?
Dialogue: 0,0:12:14.79,0:12:16.04,Default,,0,0,0,,Бұзбаңыз
Dialogue: 0,0:12:17.34,0:12:21.42,Default,,0,0,0,,Әркім өз бақытсыздығы мен өмірімен келісімге келді.
Dialogue: 0,0:12:25.55,0:12:26.26,Default,,0,0,0,,Мылтық
Dialogue: 0,0:12:28.14,0:12:30.02,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:12:31.02,0:12:33.60,Default,,0,0,0,,Мен бір сәтте жеңдім.
Dialogue: 0,0:12:34.19,0:12:44.99,Default,,0,0,0,,А, түсіндім. Дәл солай.
Dialogue: 0,0:12:49.24,0:12:51.58,Default,,0,0,0,,Мен және бірінші балам ата-анамыздан айырылғандықтан.
Dialogue: 0,0:12:52.71,0:12:54.46,Default,,0,0,0,,Маған ешкім көмектеспеді.
Dialogue: 0,0:12:59.04,0:13:00.17,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:04.93,0:13:07.93,Default,,0,0,0,,Хмм, топтан бөлек болу ыңғайлы.
Dialogue: 0,0:13:13.60,0:13:15.89,Default,,0,0,0,,​​Сіз бас тарттыңыз ба? 1-ші
Dialogue: 0,0:13:17.10,0:13:21.32,Default,,0,0,0,,Балалар, сіздердің арқасында біз адам мінез-құлқының әртүрлі үлгілерін жинай алдық.
Dialogue: 0,0:13:22.03,0:13:25.78,Default,,0,0,0,,1-ші Бұл үлгі туралы не ойлайсыз?
Dialogue: 0,0:13:26.49,0:13:30.16,Default,,0,0,0,,Ол әкесі мен анасын жоғалтып, олардан кек алуға тырысады, бірақ
Dialogue: 0,0:13:30.45,0:13:33.66,Default,,0,0,0,,Күш-қуатының жоқтығынан көрегендігін пайдалана алмай, жеңіледі.
Dialogue: 0,0:13:35.41,0:13:37.08,Default,,0,0,0,,Бұл қызық емес деп ойлайсыз ба?
Dialogue: 0,0:13:37.37,0:13:38.92,Default,,0,0,0,,Көрсететін ештеңе жоқ.
Dialogue: 0,0:13:39.13,0:13:43.88,Default,,0,0,0,,Бұл жағдайда көмекке шақыру үшін қашып кетсе, қызық болар еді.
Dialogue: 0,0:13:45.26,0:13:50.01,Default,,0,0,0,,Сіз және сіздің отбасыңыз өте қызық үлгі болдыңыз.
Dialogue: 0,0:13:50.55,0:13:51.56,Default,,0,0,0,,11
Dialogue: 0,0:13:51.97,0:13:55.35,Default,,0,0,0,,Оның 9-шыны өлтіруі аздап таң қалдырды.
Dialogue: 0,0:13:55.81,0:13:59.44,Default,,0,0,0,,Ол да қызықсыз террорист еді.
Dialogue: 0,0:14:03.94,0:14:06.70,Default,,0,0,0,,Жалықтыратын террорист кім?
Dialogue: 0,0:14:08.07,0:14:09.24,Default,,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:14:10.49,0:14:13.20,Default,,0,0,0,,Шу, рұқсатсыз өлтірме
Dialogue: 0,0:14:14.45,0:14:17.62,Default,,0,0,0,,Жер асты әлемінен кәдесый: жүрек соғысы бомбасы
Dialogue: 0,0:14:19.08,0:14:22.54,Default,,0,0,0,,Бұл жігіт менің жүрегім тоқтаған кезде жарылып кетеді.
Dialogue: 0,0:14:22.71,0:14:24.92,Default,,0,0,0,,Sashimono қос есіктері де
Dialogue: 0,0:14:25.09,0:14:28.05,Default,,0,0,0,,Егер сіз кіріп, оны жарсаңыз, қауіпсіз болмайсыз.
Dialogue: 0,0:14:28.80,0:14:29.59,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:29.93,0:14:31.30,Default,,0,0,0,,Өзіңізді жоюды жоспарлап отырсыз ба?
Dialogue: 0,0:14:32.01,0:14:36.89,Default,,0,0,0,,1-ші Сенің істеп жүргенің өзімшілдік.
Dialogue: 0,0:14:39.98,0:14:40.81,Default,,0,0,0,,Дана
Dialogue: 0,0:14:41.56,0:14:45.19,Default,,0,0,0,,Мен де бұл сезімді түсінбейтін сияқтымын.
Dialogue: 0,0:14:45.98,0:14:47.90,Default,,0,0,0,,Сондықтан мен саған жол ашамын.
Dialogue: 0,0:14:49.45,0:14:52.45,Default,,0,0,0,,Бұдан тыс жауапкершіліктер анық.
Dialogue: 0,0:14:53.08,0:14:53.78,Default,,0,0,0,,Юкитеру
Dialogue: 0,0:15:09.22,0:15:10.43,Default,,0,0,0,,Тіпті күнделіктің жойылуымен
Dialogue: 0,0:15:10.80,0:15:13.05,Default,,0,0,0,,Егер жүрек соғысы тоқтаса, ол жарылуы керек.
Dialogue: 0,0:15:23.52,0:15:24.61,Default,,0,0,0,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:15:28.24,0:15:30.53,Default,,0,0,0,,Мен саған қалауың бойынша көмектестім.
Dialogue: 0,0:15:31.45,0:15:32.78,Default,,0,0,0,,Сізді қанағаттандырды.
Dialogue: 0,0:15:35.08,0:15:36.95,Default,,0,0,0,,Сондықтан мен қазір саған еремін
Dialogue: 0,0:15:50.30,0:15:51.68,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:54.30,0:15:56.43,Default,,0,0,0,,А, түсіндім.
Dialogue: 0,0:15:59.35,0:16:01.56,Default,,0,0,0,,Мен де құтқарылғым келді.
Dialogue: 0,0:16:03.77,0:16:08.36,Default,,0,0,0,,Мен адам және әйел ретінде өле аламын.
Dialogue: 0,0:16:10.61,0:16:11.70,Default,,0,0,0,,Нишижима
Dialogue: 0,0:16:30.30,0:16:31.26,Default,,0,0,0,,Зақымданбаған
Dialogue: 0,0:16:31.76,0:16:34.43,Default,,0,0,0,,Хахаха мен бекер өлдім.
Dialogue: 0,0:16:34.55,0:16:37.55,Default,,0,0,0,,Бұл менің 9-шы өмірімдегі толық босқа өтті
Dialogue: 0,0:16:38.51,0:16:39.56,Default,,0,0,0,,Кимисама
Dialogue: 0,0:16:46.06,0:16:49.57,Default,,0,0,0,,9-шы Юно мен үшін өзін-өзі жояды
Dialogue: 0,0:16:50.11,0:16:51.07,Default,,0,0,0,,Және де
Dialogue: 0,0:16:51.74,0:16:55.61,Default,,0,0,0,,Юкки Алдымен оңтүстік мұнарадағы Холонды жойайық.
Dialogue: 0,0:16:56.41,0:16:59.79,Default,,0,0,0,,9-ның өлімі босқа кетпеу үшін.
Dialogue: 0,0:17:02.20,0:17:04.96,Default,,0,0,0,,Yes, that's right.
Dialogue: 0,0:17:05.37,0:17:07.67,Default,,0,0,0,,Мен 11-ден жоғары қарайтын боламын.
Dialogue: 0,0:17:08.34,0:17:09.04,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:14.51,0:17:18.35,Default,,0,0,0,,Бұл холонның өзі менің жоспарыма кедергі болмайды.
Dialogue: 0,0:17:22.60,0:17:24.48,Default,,0,0,0,,Хаха не?
Dialogue: 0,0:17:44.12,0:17:45.96,Default,,0,0,0,,Бұл галлюцинация ма?
Dialogue: 0,0:17:46.75,0:17:48.71,Default,,0,0,0,,Ол не үшін мұнда?
Dialogue: 0,0:18:02.93,0:18:04.98,Default,,0,0,0,,Юно 11-ін өлтірді
Dialogue: 0,0:18:07.14,0:18:09.48,Default,,0,0,0,,Жер бетінде қалай?
Dialogue: 0,0:18:28.83,0:18:30.17,Default,,0,0,0,,Уау
Dialogue: 0,0:18:32.21,0:18:34.09,Default,,0,0,0,,Қайырлы таң Юкки
Dialogue: 0,0:18:34.30,0:18:35.88,Default,,0,0,0,,Бірінші қабатта ұйықтау керек еді.
Dialogue: 0,0:18:38.63,0:18:40.14,Default,,0,0,0,,Қалай болғанда да, бірдеңе киіңіз.
Dialogue: 0,0:18:40.55,0:18:41.35,Default,,0,0,0,,Иә
Dialogue: 0,0:18:44.06,0:18:46.68,Default,,0,0,0,,Юноның жіберіп алған 8-і ғана қалды.
Dialogue: 0,0:18:47.64,0:18:50.69,Default,,0,0,0,,​​Бірақ, менің ойымша, Акисе шамамен 8-де бірдеңе жасайды.
Dialogue: 0,0:18:51.61,0:18:52.86,Default,,0,0,0,,Болашақ жарқын болатын сияқты
Dialogue: 0,0:18:56.69,0:19:01.32,Default,,0,0,0,,8-ші Мен сені Юкитеруге тапсыруды ойлап жүрмін.
Dialogue: 0,0:19:02.12,0:19:05.20,Default,,0,0,0,,Егер мен құдай болатын болсам, Юкитеру ең жақсы болар еді деп ойлаймын.
Dialogue: 0,0:19:05.37,0:19:07.83,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:19:08.37,0:19:08.87,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:19:13.17,0:19:16.17,Default,,0,0,0,,Құлыпты ашу расталды
Dialogue: 0,0:19:20.55,0:19:22.93,Default,,0,0,0,,Тек Юно Агацумаға ғана сенуге болмайды.
Dialogue: 0,0:19:24.26,0:19:26.39,Default,,0,0,0,,Юкитеру-кунның құдайға айналуының мақсаты қандай?
Dialogue: 0,0:19:26.77,0:19:30.44,Default,,0,0,0,,Ата-анаңды тірілтіп, бәрін әзілге айналдыру
Dialogue: 0,0:19:31.02,0:19:35.27,Default,,0,0,0,,Екінші жағынан, Агацума мырза нені, оның ішінде оның шынайы тұлғасын жасырады?
Dialogue: 0,0:19:37.94,0:19:39.07,Default,,0,0,0,,Жер
Dialogue: 0,0:19:40.57,0:19:42.74,Default,,0,0,0,,Камадо мырза, менің бір өтінішім бар.
Dialogue: 0,0:19:50.83,0:19:52.04,Default,,0,0,0,,Сіз не жазып жатырсыз?
Dialogue: 0,0:19:52.50,0:19:55.46,Default,,0,0,0,,Мен осы уақытқа дейін өлтірген адамдарымды жазып жатырмын.
Dialogue: 0,0:19:56.25,0:19:58.17,Default,,0,0,0,,Біз оны кейінірек тірілтуіміз керек.
Dialogue: 0,0:19:58.67,0:20:01.05,Default,,0,0,0,,Юкки құдайға айналуы керек
Dialogue: 0,0:20:01.97,0:20:06.51,Default,,0,0,0,,9-ын өлтір, 11-ін өлтір, 8-ін өлтір
Dialogue: 0,0:20:07.06,0:20:08.77,Default,,0,0,0,,Мен де сені өлтіремін
Dialogue: 0,0:20:10.48,0:20:11.23,Default,,0,0,0,,Юно
Dialogue: 0,0:20:12.48,0:20:16.73,Default,,0,0,0,,Ана мен әкені өмірге қайтару үшін қажет нәрсе
Dialogue: 0,0:20:17.57,0:20:18.94,Default,,0,0,0,,Барлығы әзіл
Dialogue: 0,0:20:19.65,0:20:21.61,Default,,0,0,0,,Юккидің мақсаты осы болса керек.
Dialogue: 0,0:20:32.16,0:20:33.37,Default,,0,0,0,,Көрдіңіз бе? Мен айтқанымдай болды ғой, иә?
Dialogue: 0,0:20:39.38,0:20:41.21,Default,,0,0,0,,Әлем бұзыла бастады
Dialogue: 0,0:20:42.80,0:20:46.30,Default,,0,0,0,,Бұл иелердің жоғалу құбылысына ұқсас, бірақ не?
Dialogue: 0,0:20:46.72,0:20:51.68,Default,,0,0,0,,Бәлкім, Дейстің өмірі мен бұл дүниенің ғұмыры.
Dialogue: 0,0:20:52.43,0:20:56.19,Default,,0,0,0,,Дейдің орнына біреу жаңа құдай болмаса.
Dialogue: 0,0:20:56.48,0:20:58.15,Default,,0,0,0,,Әлемді енді құтқару мүмкін емес.
Dialogue: 0,0:21:02.82,0:21:05.99,Default,,0,0,0,,Мен саған уәде беремін, мен бәрін күлдіремін.
Dialogue: 0,0:21:07.24,0:21:08.95,Default,,0,0,0,,Юноны бақытты ету үшін
Dialogue: 0,0:21:10.74,0:21:11.87,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:21:12.25,0:21:15.17,Default,,0,0,0,,Деустың өлімі жоспарланғаннан тезірек келеді.
Dialogue: 0,0:21:15.87,0:21:17.71,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:21:19.09,0:21:23.34,Default,,0,0,0,,Дүниежүзілік аннигиляция күні 28 шілде болуы керек
Dialogue: 0,0:21:23.51,0:21:25.76,Default,,0,0,0,,Мен оны сол уақытқа дейін ұстауым керек.
Dialogue: 0,0:21:26.30,0:21:27.89,Default,,0,0,0,,Хонра Кокодабе
Dialogue: 0,0:21:29.85,0:21:32.06,Default,,0,0,0,,8-ші Қазіргі уақытта жүктелуде
Dialogue: 0,0:21:33.98,0:21:35.06,Default,,0,0,0,,Ақисе Ару
Dialogue: 0,0:21:36.19,0:21:38.10,Default,,0,0,0,,Мен оны осында қойдым деген сөз
Dialogue: 0,0:21:38.27,0:21:41.36,Default,,0,0,0,,Сонда сізге Құдайдың алдында тыңдаушылар берілді ме?
Dialogue: 0,0:21:41.82,0:21:44.36,Default,,0,0,0,,Қарапайым халық болғанымен Құдайдың патшалығы
Dialogue: 0,0:21:45.40,0:21:47.16,Default,,0,0,0,,Мен кетемін
Dialogue: 0,0:21:49.49,0:21:52.87,Default,,0,0,0,,Құдайым, жомарттығың үшін рахмет.
Dialogue: 0,0:21:53.16,0:21:55.00,Default,,0,0,0,,Тек бір талап
Dialogue: 0,0:21:55.16,0:21:59.33,Default,,0,0,0,,Егер сен құдайға айналсаң, шынымен де бәрі былыққа айнала ма?
Dialogue: 0,0:22:00.83,0:22:05.83,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
