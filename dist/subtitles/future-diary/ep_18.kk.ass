Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.23,Default,,0,0,0,,Бұл жай ғана кездейсоқтық еді
Dialogue: 0,0:00:07.40,0:00:10.78,Default,,0,0,0,,Мен әдеттегідей Амано-кунды қудым.
Dialogue: 0,0:00:12.11,0:00:13.74,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:00:14.70,0:00:16.45,Default,,0,0,0,,Ау, ауыр.
Dialogue: 0,0:00:16.82,0:00:18.62,Default,,0,0,0,,Махаббат хаты ма?
Dialogue: 0,0:01:57.09,0:01:59.34,Default,,0,0,0,,Агацума-сан шынымен сүйкімді.
Dialogue: 0,0:02:02.64,0:02:04.64,Default,,0,0,0,,Маған айтпайсың ба?
Dialogue: 0,0:02:04.81,0:02:07.14,Default,,0,0,0,,Маған мұндай ұқыпсыз шақыру ұнамайды.
Dialogue: 0,0:02:07.27,0:02:09.19,Default,,0,0,0,,Қанша өмірің болса да, ол ешқашан жетпейді
Dialogue: 0,0:02:09.35,0:02:11.11,Default,,0,0,0,,Ей, бұл тауық.
Dialogue: 0,0:02:11.27,0:02:12.15,Default,,0,0,0,,Шулы
Dialogue: 0,0:02:16.57,0:02:17.78,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:02:17.95,0:02:20.99,Default,,0,0,0,,Балалар, сендермен кім танысады?
Dialogue: 0,0:02:21.16,0:02:23.33,Default,,0,0,0,,Тек бетін көре алатындар
Dialogue: 0,0:02:23.53,0:02:27.16,Default,,0,0,0,,Маған ұнайтын жалғыз адам - сол адам.
Dialogue: 0,0:02:33.84,0:02:35.30,Default,,0,0,0,,Юкитеру Амано
Dialogue: 0,0:02:38.80,0:02:41.68,Default,,0,0,0,,Мен оны байқай бастадым
Dialogue: 0,0:02:41.84,0:02:43.68,Default,,0,0,0,,Тек бір апта бұрын
Dialogue: 0,0:02:46.39,0:02:51.73,Default,,0,0,0,,Белгілі бір себептермен мен «болашақ арман» сауалнамасын толтыруда қиналдым.
Dialogue: 0,0:02:51.94,0:02:55.61,Default,,0,0,0,,Ол да сыныпта қалды.
Dialogue: 0,0:02:56.32,0:02:58.07,Default,,0,0,0,,Мен белгілі бір уәде бердім.
Dialogue: 0,0:02:59.03,0:03:01.99,Default,,0,0,0,,Мен сенің болашақ жарың боламын.
Dialogue: 0,0:03:02.99,0:03:04.45,Default,,0,0,0,,Мен өскенде
Dialogue: 0,0:03:05.08,0:03:06.37,Default,,0,0,0,,Иә
Dialogue: 0,0:03:07.91,0:03:09.00,Default,,0,0,0,,Енді есеп аяқталды
Dialogue: 0,0:03:09.12,0:03:10.96,Default,,0,0,0,,Жарияланған нәтижелерді қазір оқыңыз.
Dialogue: 0,0:03:11.08,0:03:15.96,Default,,0,0,0,,Амано-кун мені қазіргі үмітсіз жағдайымнан құтқара алатын жалғыз адам.
Dialogue: 0,0:03:16.67,0:03:17.46,Default,,0,0,0,,Сонымен
Dialogue: 0,0:03:22.59,0:03:23.64,Default,,0,0,0,,Сол махаббат хаты
Dialogue: 0,0:03:23.72,0:03:24.76,Default,,0,0,0,,Оны маған беруге рұқсат ете алмаймын.
Dialogue: 0,0:03:25.30,0:03:26.39,Default,,0,0,0,,Сонымен
Dialogue: 0,0:03:26.51,0:03:29.06,Default,,0,0,0,,Менің сабағым қызметші кафеде өтеді.
Dialogue: 0,0:03:29.31,0:03:33.56,Default,,0,0,0,,Мен біреудің сабақтан кейін қажетті заттарды сатып алуын қалаймын.
Dialogue: 0,0:03:34.31,0:03:37.19,Default,,0,0,0,,Енді кезекші Амано мырза мен Агацума мырзаға.
Dialogue: 0,0:03:37.65,0:03:38.23,Default,,0,0,0,,Ах
Dialogue: 0,0:03:39.40,0:03:43.28,Default,,0,0,0,,Ойланып қарасақ, Агацума-санның үйінде қатаң коменданттық сағат болған.
Dialogue: 0,0:03:44.20,0:03:46.24,Default,,0,0,0,,Басқа біреуден сұрау
Dialogue: 0,0:03:46.41,0:03:49.58,Default,,0,0,0,,Егер солай болса, сэр, мен барамын.
Dialogue: 0,0:03:49.75,0:03:53.96,Default,,0,0,0,,Ал, Вакаба мырза, сізге көп рахмет.
Dialogue: 0,0:03:54.33,0:03:54.96,Default,,0,0,0,,Иә
Dialogue: 0,0:03:57.04,0:03:59.34,Default,,0,0,0,,Сынып президенті Мо Вакаба
Dialogue: 0,0:04:00.01,0:04:03.05,Default,,0,0,0,,Амано-кунның махаббат хатының серіктесі
Dialogue: 0,0:04:04.64,0:04:06.39,Default,,0,0,0,,Осы жігітке көбірек ұқсайды
Dialogue: 0,0:04:07.43,0:04:08.64,Default,,0,0,0,,Тоқтату керек
Dialogue: 0,0:04:08.81,0:04:12.27,Default,,0,0,0,,Осы қарқынмен Амано сізге махаббат хатын береді.
Dialogue: 0,0:04:14.69,0:04:16.69,Default,,0,0,0,,Мұнда барлығын таба аласыз.
Dialogue: 0,0:04:16.90,0:04:18.15,Default,,0,0,0,,Иә
Dialogue: 0,0:04:19.19,0:04:22.11,Default,,0,0,0,,Мектепте тіпті достарым да жоқ.
Dialogue: 0,0:04:22.28,0:04:24.99,Default,,0,0,0,,Сол Вакаба-сан екеуміз бірге сауда жасадық.
Dialogue: 0,0:04:25.95,0:04:28.28,Default,,0,0,0,,Тіпті мен өзімді ұстай алмаймын.
Dialogue: 0,0:04:28.87,0:04:30.70,Default,,0,0,0,,Жарайды, бүгін сөзсіз.
Dialogue: 0,0:04:31.50,0:04:33.62,Default,,0,0,0,,Амано-кун, тез барайық
Dialogue: 0,0:04:34.50,0:04:36.71,Default,,0,0,0,,Иә
Dialogue: 0,0:04:43.09,0:04:45.26,Default,,0,0,0,,Таң
Dialogue: 0,0:04:54.39,0:04:56.27,Default,,0,0,0,,Уф, бұл қауіпті болды.
Dialogue: 0,0:04:57.15,0:04:59.52,Default,,0,0,0,,О, ана, қоян бар.
Dialogue: 0,0:05:00.69,0:05:04.20,Default,,0,0,0,,Біз жақсы көңіл-күйге ие болдық.
Dialogue: 0,0:05:04.57,0:05:06.70,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:06.91,0:05:08.07,Default,,0,0,0,,​​Иә, иә.
Dialogue: 0,0:05:14.87,0:05:15.67,Default,,0,0,0,,болды
Dialogue: 0,0:05:15.92,0:05:18.96,Default,,0,0,0,,Енді бізде бәрі бар, оны сатып алайық.
Dialogue: 0,0:05:19.13,0:05:19.71,Default,,0,0,0,,Иә
Dialogue: 0,0:05:21.75,0:05:24.30,Default,,0,0,0,,Жарайды, мен саған осы жерден сусын сатып аламын.
Dialogue: 0,0:05:24.51,0:05:25.68,Default,,0,0,0,,Көңіл-күйді көтерейік
Dialogue: 0,0:05:30.05,0:05:31.97,Default,,0,0,0,,Э-э-э—
Dialogue: 0,0:05:35.35,0:05:36.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:40.36,0:05:42.98,Default,,0,0,0,,Не істеп жатырсың, бейбақ?
Dialogue: 0,0:05:43.78,0:05:46.03,Default,,0,0,0,,Бұл қандай қоян?
Dialogue: 0,0:05:46.15,0:05:47.99,Default,,0,0,0,,Сен менің жолыма кедергі боласың
Dialogue: 0,0:05:48.57,0:05:50.37,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:05:51.16,0:05:53.49,Default,,0,0,0,,Ол көңіл-күйді көтеру үшін сусын сатып алғысы келетінін айтты.
Dialogue: 0,0:05:53.62,0:05:54.87,Default,,0,0,0,,Бұл болмайды.
Dialogue: 0,0:05:57.08,0:05:58.42,Default,,0,0,0,,Бұл қорқынышты болды
Dialogue: 0,0:05:58.58,0:06:01.09,Default,,0,0,0,,Жылама, енді оғаштық жоқ.
Dialogue: 0,0:06:01.21,0:06:03.59,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:06:03.63,0:06:04.13,Default,,0,0,0,,Қалай болғанда да, сіз хатты тапсыратындай жағдай жасай алмайсыз.
Dialogue: 0,0:06:03.75,0:06:05.01,Default,,0,0,0,,Жүр, кеттік. Әйтеуір, мен хатты тапсыратындай жағдай жасай алмаймын.
Dialogue: 0,0:06:05.01,0:06:07.09,Default,,0,0,0,,Қалай болғанда да, сіз хатты тапсыратындай жағдай жасай алмайсыз.
Dialogue: 0,0:06:08.43,0:06:11.05,Default,,0,0,0,,Жарайды, дәретхананы пайдалануды аяқтағаннан кейін.
Dialogue: 0,0:06:11.22,0:06:13.47,Default,,0,0,0,,Мен сізге бұл жолы хатты беремін.
Dialogue: 0,0:06:18.02,0:06:18.85,Default,,0,0,0,,На
Dialogue: 0,0:06:24.15,0:06:24.82,Default,,0,0,0,,Иә
Dialogue: 0,0:06:24.94,0:06:28.45,Default,,0,0,0,,Қазір не істеп жатырсыз?
Dialogue: 0,0:06:40.33,0:06:42.92,Default,,0,0,0,,Сізге бұл хат керек пе?
Dialogue: 0,0:06:49.01,0:06:51.05,Default,,0,0,0,,Күзетші, бұл бұзық.
Dialogue: 0,0:06:54.89,0:06:55.39,Default,,0,0,0,,Егер бұл орын алса, оны күшпен алып кетуден басқа амалым қалмайды.
Dialogue: 0,0:06:55.06,0:06:57.35,Default,,0,0,0,,Сол қоянды күтіңізші. Егер бұл орын алса, оны күштеп алудан басқа амалымыз қалмайды.
Dialogue: 0,0:06:57.35,0:06:57.85,Default,,0,0,0,,Сол қоянды күтіңізші.
Dialogue: 0,0:07:04.94,0:07:08.15,Default,,0,0,0,,Амано-кун, ол хатты маған берме.
Dialogue: 0,0:07:08.15,0:07:08.90,Default,,0,0,0,,Вакаба мырза
Dialogue: 0,0:07:09.07,0:07:10.32,Default,,0,0,0,,Амано-кун
Dialogue: 0,0:07:12.70,0:07:13.62,Default,,0,0,0,,Амано-кун
Dialogue: 0,0:07:14.91,0:07:16.62,Default,,0,0,0,,Әйелдер бұл рөлге жарамайды; ол спикер ретіндегі рөлін түсінуде жеткіліксіз санаға ие болған деген қорытындыға келуге тура келеді
Dialogue: 0,0:07:17.33,0:07:18.83,Default,,0,0,0,,Аманоны алып кетсе ше?
Dialogue: 0,0:07:19.71,0:07:22.04,Default,,0,0,0,,Менің болашағым жоқ
Dialogue: 0,0:07:23.42,0:07:24.34,Default,,0,0,0,,Вакаба мырза
Dialogue: 0,0:07:24.63,0:07:25.75,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:07:26.34,0:07:27.59,Default,,0,0,0,,Сен оны ұрладың ба?
Dialogue: 0,0:07:31.47,0:07:33.89,Default,,0,0,0,,Менің сезімдерімді қабыл алыңыз
Dialogue: 0,0:07:51.40,0:07:55.99,Default,,0,0,0,,А, коменданттық сағат өтті.
Dialogue: 0,0:08:05.54,0:08:06.13,Default,,0,0,0,,Бірақ
Dialogue: 0,0:08:09.05,0:08:09.76,Default,,0,0,0,,Бірақ
Dialogue: 0,0:08:13.80,0:08:15.30,Default,,0,0,0,,Бұл енді маңызды ма?
Dialogue: 0,0:08:16.72,0:08:18.68,Default,,0,0,0,,Оны тексеретін ешкім жоқ.
Dialogue: 0,0:08:22.18,0:08:24.56,Default,,0,0,0,,Мен үйдемін, анам мен әкем.
Dialogue: 0,0:08:29.15,0:08:31.36,Default,,0,0,0,,Анасы мен әкесі қайтыс болғанына бір ай
Dialogue: 0,0:08:32.40,0:08:35.70,Default,,0,0,0,,Баға кітапшасының калориялары кестесі
Dialogue: 0,0:08:35.91,0:08:39.54,Default,,0,0,0,,Жауап бергендер саны Кешігіп келгендер саны
Dialogue: 0,0:08:40.49,0:08:42.62,Default,,0,0,0,,нөмірі
Dialogue: 0,0:08:43.29,0:08:43.79,Default,,0,0,0,,(Кешіріңіз, кешіріңіз...)
Dialogue: 0,0:08:43.71,0:08:46.08,Default,,0,0,0,,Егер сіз коменданттық сағатты бұзсаңыз, сіз жазаланасыз (кешіріңіз, кешіріңіз...)
Dialogue: 0,0:08:46.08,0:08:47.75,Default,,0,0,0,,(Кешіріңіз, кешіріңіз...)
Dialogue: 0,0:08:47.75,0:08:49.38,Default,,0,0,0,,Мен тіпті Рокуды жей алмаймын (кешіріңіз, кешіріңіз...)
Dialogue: 0,0:08:49.38,0:08:50.25,Default,,0,0,0,,(Кешіріңіз, кешіріңіз...)
Dialogue: 0,0:08:53.88,0:08:57.18,Default,,0,0,0,,Мен сияқты жағдайда болу қандай сезімде болады?
Dialogue: 0,0:08:59.01,0:09:04.02,Default,,0,0,0,,«Таңдаулы адамдар» атанған анам мен әкемнің біліміне ілесе алмадым.
Dialogue: 0,0:09:04.44,0:09:05.81,Default,,0,0,0,,(Юно Юно күтіңіз)
Dialogue: 0,0:09:05.81,0:09:06.94,Default,,0,0,0,,Керісінше, мен анам мен әкемді қамауға алуды шештім (Юно, Юно, күте тұрыңыз)
Dialogue: 0,0:09:06.94,0:09:08.19,Default,,0,0,0,,Керісінше, мен анам мен әкемді қамауға алуды шештім.
Dialogue: 0,0:09:08.19,0:09:08.69,Default,,0,0,0,,(Не істеп жатырсың?)
Dialogue: 0,0:09:08.56,0:09:10.07,Default,,0,0,0,,(Не істеп жатқаныңызды білесіз бе?)
Dialogue: 0,0:09:10.11,0:09:12.57,Default,,0,0,0,,Себебі сен менің дертімді білсең
Dialogue: 0,0:09:12.74,0:09:14.61,Default,,0,0,0,,Маған жақсы қарайтыныңызға сенімдімін
Dialogue: 0,0:09:14.95,0:09:16.11,Default,,0,0,0,,Бұл жын
Dialogue: 0,0:09:16.24,0:09:17.87,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:09:17.99,0:09:20.37,Default,,0,0,0,,Мен бақытты боламын деп ойладым.
Dialogue: 0,0:09:24.33,0:09:27.67,Default,,0,0,0,,Мен оянған кезде анам да, әкем де өліп қалды.
Dialogue: 0,0:09:31.75,0:09:36.34,Default,,0,0,0,,Аманоның хатынан бас тартқаныңызға қуаныштымын.
Dialogue: 0,0:09:41.81,0:09:43.81,Default,,0,0,0,,Менің әлі болашағым бар
Dialogue: 0,0:09:45.06,0:09:47.19,Default,,0,0,0,,Оны қорғай бергенше
Dialogue: 0,0:09:47.77,0:09:50.48,Default,,0,0,0,,Менің Амано-кунның әйелі бола алатын болашағым бар.
Dialogue: 0,0:09:51.77,0:09:55.03,Default,,0,0,0,,Бұл менің болашағым
Dialogue: 0,0:10:15.76,0:10:19.30,Default,,0,0,0,,Ол маған анамды тірілтуді бұйырды.
Dialogue: 0,0:10:19.55,0:10:23.26,Default,,0,0,0,,Иә, құдай ретінде бұл сізге оңай болуы керек.
Dialogue: 0,0:10:23.43,0:10:24.56,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:10:24.72,0:10:25.56,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:10:25.72,0:10:31.98,Default,,0,0,0,,Менде қазір қалыптасқан себеп пен салдарды бұрмалауға күшім жоқ.
Dialogue: 0,0:10:32.15,0:10:34.94,Default,,0,0,0,,Менің өмірім жақында аяқталады
Dialogue: 0,0:10:35.53,0:10:40.03,Default,,0,0,0,,Егер Иеміз өлсе, бұл дүние себеп-салдар заңын бақылаудан айырылады.
Dialogue: 0,0:10:40.20,0:10:42.32,Default,,0,0,0,,Және құрдымға кет
Dialogue: 0,0:10:42.99,0:10:48.37,Default,,0,0,0,,Иә, сенің анаң ғана өлмейді.
Dialogue: 0,0:10:48.58,0:10:51.04,Default,,0,0,0,,Барлығы өледі, сен де өлесің.
Dialogue: 0,0:10:51.21,0:10:54.38,Default,,0,0,0,,Бірақ көмектесудің бір ғана жолы бар.
Dialogue: 0,0:10:54.50,0:10:58.42,Default,,0,0,0,,Барлығын құтқарып, тілектеріңізді орындауға мүмкіндік жоқ.
Dialogue: 0,0:11:04.56,0:11:06.02,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:11:12.65,0:11:13.56,Default,,0,0,0,,Әке.
Dialogue: 0,0:11:15.52,0:11:16.28,Default,,0,0,0,,Қашан?
Dialogue: 0,0:11:18.74,0:11:20.91,Default,,0,0,0,,Мен біраз жұмыс үшін тоқтадым.
Dialogue: 0,0:11:21.32,0:11:23.28,Default,,0,0,0,,Қараңғылықтан кенет шабуыл жасады
Dialogue: 0,0:11:23.41,0:11:25.78,Default,,0,0,0,,Менің ойымша, бұл қарызға байланысты болуы мүмкін.
Dialogue: 0,0:11:27.45,0:11:28.87,Default,,0,0,0,,Жақсы нәрселер
Dialogue: 0,0:11:29.58,0:11:30.46,Default,,0,0,0,,Әке.
Dialogue: 0,0:11:31.87,0:11:34.34,Default,,0,0,0,,Анаңды пышақтап кеткен әкең болды ғой?
Dialogue: 0,0:11:35.38,0:11:36.25,Default,,0,0,0,,Өзіңізді тапсырыңыз.
Dialogue: 0,0:11:37.84,0:11:39.80,Default,,0,0,0,,Ха ха ха ха мүмкін емес
Dialogue: 0,0:11:39.97,0:11:40.93,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:11:41.09,0:11:45.47,Default,,0,0,0,,Юки-кун, сенде дәлел бар ма?
Dialogue: 0,0:11:45.68,0:11:48.18,Default,,0,0,0,,Менің анамды пышақтап алғаным туралы дәлелдер бар.
Dialogue: 0,0:11:48.68,0:11:50.31,Default,,0,0,0,,Уақыт аса маңызды.
Dialogue: 0,0:11:50.52,0:11:53.02,Default,,0,0,0,,Онсыз бұл жай ғана сылтау.
Dialogue: 0,0:11:56.77,0:11:58.36,Default,,0,0,0,,Ломбард түбіртегі
Dialogue: 0,0:11:59.11,0:12:00.74,Default,,0,0,0,,Сіз ломбардқа бірдеңе қалдырып жатырсыз ба?
Dialogue: 0,0:12:01.57,0:12:02.86,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:12:09.12,0:12:12.00,Default,,0,0,0,,Ломбарда бірдеңе қалуы мүмкін бе?
Dialogue: 0,0:12:13.87,0:12:15.50,Default,,0,0,0,,Сақтау мерзімі ертең.
Dialogue: 0,0:12:16.00,0:12:19.13,Default,,0,0,0,,Егер бұл бірдеңенің дәлелі болса, мен оны ертең барып жинап алуым керек.
Dialogue: 0,0:12:20.59,0:12:22.34,Default,,0,0,0,,Әкемнің соңынан еріп, жүкті ұрлап алайық.
Dialogue: 0,0:12:22.55,0:12:26.14,Default,,0,0,0,,Мен сізге дәлелдерді көрсетіп, әкемді өз кінәсін мойындауға мәжбүр етемін.
Dialogue: 0,0:12:29.89,0:12:33.60,Default,,0,0,0,,Агацума мырза, сізден сұрайын дегенім бар.
Dialogue: 0,0:12:33.81,0:12:36.52,Default,,0,0,0,,Бұл сіздің үйіңізден табылған сүйек сүйегі туралы.
Dialogue: 0,0:12:36.73,0:12:40.40,Default,,0,0,0,,Стоматологиялық әсерлерден олардың екеуі сіздің ата-анаңыз екенін білеміз.
Dialogue: 0,0:12:41.19,0:12:42.36,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:12:42.57,0:12:44.32,Default,,0,0,0,,Мәселе үшіншіде.
Dialogue: 0,0:12:44.49,0:12:48.45,Default,,0,0,0,,Біз оның кім екенін де білмейміз.
Dialogue: 0,0:12:50.24,0:12:51.00,Default,,0,0,0,,Агацума мырза
Dialogue: 0,0:12:56.13,0:12:59.75,Default,,0,0,0,,Барлығы ДНҚ сынағы басталғаннан кейін белгілі болады.
Dialogue: 0,0:13:01.05,0:13:03.26,Default,,0,0,0,,Сондықтан бұған дейін
Dialogue: 0,0:13:10.06,0:13:12.06,Default,,0,0,0,,Шүкір, мен ұйықтап қалдым.
Dialogue: 0,0:13:14.14,0:13:15.23,Default,,0,0,0,,Әкем хабарсыз кетті
Dialogue: 0,0:13:15.94,0:13:17.31,Default,,0,0,0,,Мен ломбардқа бет алдым.
Dialogue: 0,0:13:17.44,0:13:18.44,Default,,0,0,0,,Егер сен мені қазір қусаң
Dialogue: 0,0:13:20.61,0:13:21.44,Default,,0,0,0,,Уақытында емес
Dialogue: 0,0:13:22.99,0:13:23.61,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:13:29.53,0:13:31.58,Default,,0,0,0,,Жоқ, күнделікте ешқандай өзгеріс жоқ.
Dialogue: 0,0:13:31.74,0:13:33.00,Default,,0,0,0,,Жетті, Конни
Dialogue: 0,0:13:33.37,0:13:35.04,Default,,0,0,0,,Иә, төте жол бар.
Dialogue: 0,0:13:43.21,0:13:44.76,Default,,0,0,0,,Жарайды, күнделік өзгерді.
Dialogue: 0,0:13:52.31,0:13:53.06,Default,,0,0,0,,Егер қаласаңыз, мен оны сіздің атыңыздан жеткізе аламын.
Dialogue: 0,0:13:55.81,0:13:56.73,Default,,0,0,0,,Сөмке
Dialogue: 0,0:13:59.86,0:14:01.77,Default,,0,0,0,,Егер біз оны қазір жіберсек, дәлелдерді жоғалтып аламыз.
Dialogue: 0,0:14:02.94,0:14:04.65,Default,,0,0,0,,Қарғыс атқыр, қайда бара жатырсың?
Dialogue: 0,0:14:05.86,0:14:06.65,Default,,0,0,0,,Ғибадатхана
Dialogue: 0,0:14:07.99,0:14:09.32,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін
Dialogue: 0,0:14:22.63,0:14:26.01,Default,,0,0,0,,Мен мұнда соңғы рет келгенде осыншама қиын болды ма деп ойлаймын.
Dialogue: 0,0:14:30.22,0:14:33.35,Default,,0,0,0,,Бүгін жалғыз болғандықтан ба?
Dialogue: 0,0:14:36.68,0:14:38.02,Default,,0,0,0,,Алдын ала тексеру Алдын ала тексеру
Dialogue: 0,0:14:38.56,0:14:42.65,Default,,0,0,0,,Әке, егер сіз жұлдыздарды көргіңіз келсе, жоғарыдағы ғибадатхана ең жақсы жер.
Dialogue: 0,0:14:46.86,0:14:50.20,Default,,0,0,0,,Соңында бұл жай ғана алдын ала қарау болды және нақты өнімділік болмады.
Dialogue: 0,0:14:55.99,0:14:57.62,Default,,0,0,0,,Мен таптым, әке.
Dialogue: 0,0:14:59.29,0:15:01.58,Default,,0,0,0,,Юки-кун, біз не үшін келдік?
Dialogue: 0,0:15:05.42,0:15:08.05,Default,,0,0,0,,Бұл әкемнің анамды өлтіргенінің дәлелі.
Dialogue: 0,0:15:10.80,0:15:11.84,Default,,0,0,0,,Телескоп?
Dialogue: 0,0:15:12.85,0:15:13.85,Default,,0,0,0,,Әке.
Dialogue: 0,0:15:15.43,0:15:19.06,Default,,0,0,0,,Мен мұны үшеуміз жұлдыздарға қарауымыз үшін сатып алдым.
Dialogue: 0,0:15:19.23,0:15:20.89,Default,,0,0,0,,Бұл мен сақтадым.
Dialogue: 0,0:15:25.73,0:15:27.11,Default,,0,0,0,,Тіпті мен білемін
Dialogue: 0,0:15:27.78,0:15:30.90,Default,,0,0,0,,Жақында мені полиция тұтқындайды
Dialogue: 0,0:15:31.57,0:15:32.24,Default,,0,0,0,,Әке.
Dialogue: 0,0:15:32.82,0:15:37.08,Default,,0,0,0,,Сондықтан маған дайындалу үшін уақыт қажет болды.
Dialogue: 0,0:15:37.91,0:15:39.58,Default,,0,0,0,,Анаңнан кешірім сұра
Dialogue: 0,0:15:40.62,0:15:44.08,Default,,0,0,0,,Мен кепілге қойған қымбат телескопымды қайтарғым келді.
Dialogue: 0,0:15:46.75,0:15:47.42,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:15:48.21,0:15:50.51,Default,,0,0,0,,Менде артық естеліктер жоқ
Dialogue: 0,0:15:51.38,0:15:53.26,Default,,0,0,0,,Кешіріңіз, Юки-кун
Dialogue: 0,0:16:01.81,0:16:06.11,Default,,0,0,0,,Фестиваль маусымында мұнда көптеген дүңгіршектер бар.
Dialogue: 0,0:16:07.07,0:16:09.53,Default,,0,0,0,,Келесі жолы осында бірге келейік.
Dialogue: 0,0:16:14.66,0:16:16.16,Default,,0,0,0,,Үкім аяқталғаннан кейін.
Dialogue: 0,0:16:16.41,0:16:17.12,Default,,0,0,0,,Иә
Dialogue: 0,0:16:17.66,0:16:21.66,Default,,0,0,0,,Бәрін өтеп болған соң, әке, мен қайталап көргім келеді.
Dialogue: 0,0:16:21.87,0:16:25.42,Default,,0,0,0,,Ендеше неге біз қайтадан бірге тұрмаймыз, Юки-кун?
Dialogue: 0,0:16:26.96,0:16:28.63,Default,,0,0,0,,Сіз көп жұмыс жасайсыз деп үміттенемін.
Dialogue: 0,0:16:28.88,0:16:31.51,Default,,0,0,0,,Хахаха Жарайды, мен тырысамын.
Dialogue: 0,0:16:31.92,0:16:33.30,Default,,0,0,0,,Мен бұған ешқашан жол бере алмаймын.
Dialogue: 0,0:16:36.35,0:16:52.15,Default,,0,0,0,,Бұл не күнделік, әке?
Dialogue: 0,0:16:53.82,0:16:56.32,Default,,0,0,0,,Жарайды, онда жалғастырайық.
Dialogue: 0,0:17:04.87,0:17:06.08,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:06.67,0:17:08.42,Default,,0,0,0,,Әкем кешірім сұрады.
Dialogue: 0,0:17:08.59,0:17:13.13,Default,,0,0,0,,Ол өз кінәсін мойындап, менімен істі басынан бастайтынын айтты.
Dialogue: 0,0:17:16.47,0:17:17.84,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:19.22,0:17:19.97,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:21.35,0:17:23.98,Default,,0,0,0,,Көмек берудің бір ғана жолы бар.
Dialogue: 0,0:17:24.10,0:17:27.94,Default,,0,0,0,,Барлығын құтқарып, тілектеріңізді орындауға мүмкіндік жоқ.
Dialogue: 0,0:17:30.11,0:17:33.44,Default,,0,0,0,,Юкитеру Амано сенің құдай болғаныңды қалаймын
Dialogue: 0,0:17:35.82,0:17:37.61,Default,,0,0,0,,Сен бәрін өлтірдің
Dialogue: 0,0:17:37.78,0:17:40.45,Default,,0,0,0,,Барлығын сақтау керек.
Dialogue: 0,0:17:53.96,0:17:55.51,Default,,0,0,0,,Don't feel bad
Dialogue: 0,0:18:01.18,0:18:02.85,Default,,0,0,0,,​​Сәлем, әке.
Dialogue: 0,0:18:04.06,0:18:05.02,Default,,0,0,0,,Бұл бала
Dialogue: 0,0:18:05.23,0:18:07.06,Default,,0,0,0,,Жау сізді артыңыздан тартып алуға тырысады
Dialogue: 0,0:18:07.77,0:18:08.85,Default,,0,0,0,,Не
Dialogue: 0,0:18:09.19,0:18:10.52,Default,,0,0,0,,Оң жақтағы жау оқ жаудырады.
Dialogue: 0,0:18:10.52,0:18:11.02,Default,,0,0,0,,Ей, оң жақтағы жау оқ жаудырып жатыр.
Dialogue: 0,0:18:10.73,0:18:11.23,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:18:16.74,0:18:19.70,Default,,0,0,0,,Бұл бала қалқан ретінде нені пайдаланды?
Dialogue: 0,0:18:27.66,0:18:29.21,Default,,0,0,0,,Жарайды Юкки
Dialogue: 0,0:18:30.04,0:18:30.63,Default,,0,0,0,,Юно
Dialogue: 0,0:18:48.14,0:18:49.64,Default,,0,0,0,,Мұны ішіп, тынышталыңыз
Dialogue: 0,0:19:05.87,0:19:07.29,Default,,0,0,0,,Мен шешім қабылдадым.
Dialogue: 0,0:19:08.91,0:19:10.96,Default,,0,0,0,,Мен Құдайды мақсат етемін
Dialogue: 0,0:19:12.08,0:19:13.88,Default,,0,0,0,,Барлық иелерді өлтіріңіз
Dialogue: 0,0:19:14.46,0:19:18.51,Default,,0,0,0,,Құдай болып, әкем мен шешемді тірілт.
Dialogue: 0,0:19:19.67,0:19:21.89,Default,,0,0,0,,Сондықтан Юно менің жауым.
Dialogue: 0,0:19:23.18,0:19:24.10,Default,,0,0,0,,Иә
Dialogue: 0,0:19:24.85,0:19:26.52,Default,,0,0,0,,Сіз мұны жалғыз жасай аласыз
Dialogue: 0,0:19:27.02,0:19:29.23,Default,,0,0,0,,Мен 8-нің қайда екенін білемін.
Dialogue: 0,0:19:29.39,0:19:32.60,Default,,0,0,0,,9-шы оның жүзінде білгір көзқарас бар және сақтығын төмендетеді.
Dialogue: 0,0:19:34.23,0:19:36.98,Default,,0,0,0,,11-ші
Dialogue: 0,0:19:37.32,0:19:38.32,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:19:39.32,0:19:41.82,Default,,0,0,0,,Мен сені қазір өлтіремін
Dialogue: 0,0:20:09.06,0:20:11.02,Default,,0,0,0,,Мен әрқашан өле аламын
Dialogue: 0,0:20:12.19,0:20:15.15,Default,,0,0,0,,Өйткені бұл менің болашағым
Dialogue: 0,0:20:41.76,0:20:44.22,Default,,0,0,0,,11-і де қозғала бастаған сияқты.
Dialogue: 0,0:22:34.87,0:22:36.16,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:22:38.37,0:22:40.21,Default,,0,0,0,,Қызықты нәрсе болды ма?
Dialogue: 0,0:22:43.17,0:22:45.17,Default,,0,0,0,,Егер солай болса, Мелло Нианы айналып өтіп, дәптерді қолға түсіру үшін барын салған болар еді
Dialogue: 0,0:22:46.26,0:22:47.17,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:22:47.30,0:22:49.01,Default,,0,0,0,,Неге мені қуып жүрсің?
Dialogue: 0,0:22:49.22,0:22:51.34,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:22:54.89,0:22:56.56,Default,,0,0,0,,Бұл қандай костюм?
Dialogue: 0,0:22:56.85,0:22:59.02,Default,,0,0,0,,Менің мұндай нәрселерге алаңдауға уақытым жоқ.
Dialogue: 0,0:22:59.19,0:23:00.77,Default,,0,0,0,,Біз Амано-кунды тоқтатуымыз керек.
Dialogue: 0,0:23:04.73,0:23:07.57,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:23:17.25,0:23:19.71,Default,,0,0,0,,Ей, неге тоқтамайсың?
Dialogue: 0,0:23:23.84,0:23:25.59,Default,,0,0,0,,әй
Dialogue: 0,0:23:25.75,0:23:29.22,Default,,0,0,0,,Неліктен қазір импорттап жатырсыз...
Dialogue: 0,0:23:30.72,0:23:35.72,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
