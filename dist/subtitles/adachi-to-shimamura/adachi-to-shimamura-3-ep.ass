Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.60,0:00:26.17,Default,,0,0,0,,Үш крокет, өтінемін.
Dialogue: 0,0:00:28.54,0:00:31.23,Default,,0,0,0,,Арнайы тапсырыс Иә 240 иен
Dialogue: 0,0:00:33.03,0:00:34.92,Default,,0,0,0,,Ыстық ыстық...
Dialogue: 0,0:00:36.89,0:00:38.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:41.35,0:00:44.52,Default,,0,0,0,,Гочи Гочи Гочисусама~
Dialogue: 0,0:00:53.54,0:00:55.46,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:00:56.41,0:01:00.08,Default,,0,0,0,,<Мен мұндай тамаша қашуды бірінші рет көріп тұрмын.>
Dialogue: 0,0:01:01.08,0:01:05.02,Default,,0,0,0,,<Адачи бірдеңе айтқысы келді, бірақ тұншығып бара жатқандай сезінді.>
Dialogue: 0,0:01:05.79,0:01:08.91,Default,,0,0,0,,<Адачиге айту қиын болып көрінетін нәрселер...>
Dialogue: 0,0:01:10.72,0:01:11.62,Default,,0,0,0,,Хмм, жоқ, сене алар емеспін.
Dialogue: 0,0:01:12.90,0:01:14.14,Default,,0,0,0,,Ол жоқ! Иә
Dialogue: 0,0:01:15.34,0:01:16.47,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:18.06,0:01:19.58,Default,,0,0,0,,Әпке, ойын ойнайық!
Dialogue: 0,0:01:20.71,0:01:21.93,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:01:22.25,0:01:23.69,Default,,0,0,0,,Кел, барымызды салайық!
Dialogue: 0,0:01:26.62,0:01:28.97,Default,,0,0,0,,Бұрынғы адам ерте кетті.
Dialogue: 0,0:01:29.24,0:01:29.97,Default,,0,0,0,,Иә.
Dialogue: 0,0:01:30.47,0:01:31.87,Default,,0,0,0,,Бұл қатардағы үзіліс пе?
Dialogue: 0,0:01:32.27,0:01:34.65,Default,,0,0,0,,Хмм, мен де білмеймін.
Dialogue: 0,0:01:36.16,0:01:39.08,Default,,0,0,0,,<Мүмкін мен Адачимен осылай ойнауым керек еді>
Dialogue: 0,0:01:39.46,0:01:41.21,Default,,0,0,0,,<Ал енді мен оны ойлай аламын>
Dialogue: 0,0:01:42.38,0:01:46.25,Default,,0,0,0,,＜Мен мұндай өкінішті көптен бері бастан өткердім＞
Dialogue: 0,0:01:46.86,0:01:49.28,Default,,0,0,0,,＜Және оны мүлдем пайдаланбау＞
Dialogue: 0,0:01:50.65,0:01:54.90,Default,,0,0,0,,<Қызығушылығымды аздап түсіндім.>
Dialogue: 0,0:01:55.74,0:01:59.46,Default,,0,0,0,,<Кейде менің саусақ ұшым жіңішке және жұқа болып көрінеді>
Dialogue: 0,0:02:00.58,0:02:02.78,Default,,0,0,0,,<Осындай кезде өзімді үнемі жаман сезінемін>
Dialogue: 0,0:02:03.65,0:02:04.84,Default,,0,0,0,,<Қазір ше?>
Dialogue: 0,0:02:05.95,0:02:08.73,Default,,0,0,0,,<Таңдау сізді ешқайда жеткізе алмайды>
Dialogue: 0,0:02:09.24,0:02:11.53,Default,,0,0,0,,<Тұйыққа ұқсаған саусақ па?>
Dialogue: 0,0:02:13.66,0:02:14.04,Default,,0,0,0,,Эй
Dialogue: 0,0:02:14.46,0:02:15.94,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:02:17.88,0:02:18.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:19.90,0:02:22.25,Default,,0,0,0,,Жоқ, ұсталу оңай.
Dialogue: 0,0:02:22.57,0:02:24.46,Default,,0,0,0,,Өлімді бас!
Dialogue: 0,0:04:04.47,0:04:06.38,Default,,0,0,0,,<Адачи әлі келген жоқ>
Dialogue: 0,0:04:07.09,0:04:10.49,Default,,0,0,0,,<Ол мектепке келмей қалса, мен кінәлі ме?>
Dialogue: 0,0:04:11.71,0:04:14.94,Default,,0,0,0,,<Жоқ, Адачи толқып, өз бетімен шыңға көтерілді>
Dialogue: 0,0:04:15.64,0:04:20.39,Default,,0,0,0,,<Мен өзімді ағаштан түсе алмайтын мысықтай сезінбеймін.>
Dialogue: 0,0:04:22.70,0:04:25.01,Default,,0,0,0,,Сен әлсізсің, Адачи.
Dialogue: 0,0:04:25.93,0:04:28.08,Default,,0,0,0,,Уау~ Шынайы ма?
Dialogue: 0,0:04:29.24,0:04:30.44,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:30.44,0:04:31.53,Default,,0,0,0,,Қайырлы таң~
Dialogue: 0,0:04:31.70,0:04:33.00,Default,,0,0,0,,Эй, сен осындасың.
Dialogue: 0,0:04:33.20,0:04:34.54,Default,,0,0,0,,Мен партаны жалға алып жатырмын.
Dialogue: 0,0:04:34.97,0:04:35.53,Default,,0,0,0,,Иә
Dialogue: 0,0:04:36.73,0:04:38.46,Default,,0,0,0,,Адачи, келмедің бе?
Dialogue: 0,0:04:38.76,0:04:40.57,Default,,0,0,0,,Иә, бүгін демалыс күні.
Dialogue: 0,0:04:40.84,0:04:41.83,Default,,0,0,0,,Бұл болды ма?
Dialogue: 0,0:04:42.18,0:04:43.73,Default,,0,0,0,,Ол суық тигенін айтты.
Dialogue: 0,0:04:44.28,0:04:45.73,Default,,0,0,0,,А, жалған ауру?
Dialogue: 0,0:04:46.02,0:04:49.20,Default,,0,0,0,,Мен тағы да бірге жаттығу залында демалып жатырмыз деп ойладым.
Dialogue: 0,0:04:49.59,0:04:52.80,Default,,0,0,0,,Бүгін мен жалғызбын, өйткені мен сенімен бірге емеспін
Dialogue: 0,0:04:53.32,0:04:56.47,Default,,0,0,0,,Иә? Менің ойымша, олар негізінен бір-біріне жабысады.
Dialogue: 0,0:05:02.34,0:05:03.40,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:03.86,0:05:04.89,Default,,0,0,0,,Шима-чан
Dialogue: 0,0:05:04.89,0:05:06.07,Default,,0,0,0,,Сіз бірдеңе жедіңіз бе?
Dialogue: 0,0:05:06.23,0:05:07.31,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:05:07.93,0:05:10.59,Default,,0,0,0,,Ойланып қарасам, әлі жемеген шығармын.
Dialogue: 0,0:05:11.05,0:05:14.66,Default,,0,0,0,,Жарайды, қарным ашты. Иә.
Dialogue: 0,0:05:14.79,0:05:16.10,Default,,0,0,0,,Тағы бір сәбіз?
Dialogue: 0,0:05:16.29,0:05:18.54,Default,,0,0,0,,Ұнамаса, кіргізбе деп айт.
Dialogue: 0,0:05:19.74,0:05:22.61,Default,,0,0,0,,Маған ұнамайтын ештеңе жоқ...
Dialogue: 0,0:05:23.03,0:05:27.20,Default,,0,0,0,,Мені жаяу жүретін қоқыс жәшігі деп ойлайсың ба?
Dialogue: 0,0:05:27.36,0:05:30.58,Default,,0,0,0,,Жоқ, мен Шимамураны әлі де жақсы көремін
Dialogue: 0,0:05:31.32,0:05:32.10,Default,,0,0,0,,Тағдырымыз тоғысса екен.
Dialogue: 0,0:05:33.35,0:05:34.65,Default,,0,0,0,,Иә, Нагато.
Dialogue: 0,0:05:34.65,0:05:37.80,Default,,0,0,0,,Жақында көрген біртүрлі тұтынушы туралы айтып беріңізші.
Dialogue: 0,0:05:37.96,0:05:39.36,Default,,0,0,0,,Не?
Dialogue: 0,0:05:39.54,0:05:40.58,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:05:40.58,0:05:43.96,Default,,0,0,0,,Ашық көк шашы бар біртүрлі қыз бар...
Dialogue: 0,0:05:44.27,0:05:46.17,Default,,0,0,0,,Бұл өтірік болды ма?
Dialogue: 0,0:05:46.17,0:05:48.46,Default,,0,0,0,,Ах~ Бұл рас, бұл рас.
Dialogue: 0,0:05:49.11,0:05:51.47,Default,,0,0,0,,<Егер Адачи сізді елемейді>
Dialogue: 0,0:05:51.78,0:05:55.29,Default,,0,0,0,,<Тіпті мен бір дәрежеде күйзелетін едім>
Dialogue: 0,0:05:55.95,0:06:01.32,Default,,0,0,0,,<Бірақ олар мұны үш күннен кейін қабылдап, әрі қарай жалғастырады деп ойлаймын.>
Dialogue: 0,0:06:02.28,0:06:05.27,Default,,0,0,0,,<Олай айтсам ренжімеймін>
Dialogue: 0,0:06:05.58,0:06:08.12,Default,,0,0,0,,<Себебі бұл жағымсыз сезім тудыратынын білемін>
Dialogue: 0,0:06:08.63,0:06:10.74,Default,,0,0,0,,<Ешкімге айтар сөзім жоқ болса да>
Dialogue: 0,0:06:15.33,0:06:16.31,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:30.90,0:06:32.81,Default,,0,0,0,,Не? Қайсысы?
Dialogue: 0,0:06:33.11,0:06:35.34,Default,,0,0,0,,Әй, түсінбейсің бе?
Dialogue: 0,0:06:35.73,0:06:37.23,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:06:37.41,0:06:38.28,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:06:38.39,0:06:39.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:53.21,0:06:55.58,Default,,0,0,0,,Бұл мазмұн болды.
Dialogue: 0,0:06:55.72,0:06:59.12,Default,,0,0,0,,Сенде бұл болмаса да, дауыспен түсінгеніңді қалаймын.
Dialogue: 0,0:06:59.58,0:07:03.96,Default,,0,0,0,,Енді жүзің бар екен, мен бір қарап көрейін деп ойладым.
Dialogue: 0,0:07:04.29,0:07:05.10,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:07:05.44,0:07:06.28,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:07:07.26,0:07:08.78,Default,,0,0,0,,Менен сұрамайсыз деп үміттенемін.
Dialogue: 0,0:07:09.56,0:07:12.21,Default,,0,0,0,,Жер адамының бетіне ұқсату үшін жасалған.
Dialogue: 0,0:07:12.69,0:07:14.25,Default,,0,0,0,,Жерді мазақ етесің бе?
Dialogue: 0,0:07:14.91,0:07:18.23,Default,,0,0,0,,Сонымен, у... скафандрдан бас тарттыңыз ба?
Dialogue: 0,0:07:19.84,0:07:21.32,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:21.59,0:07:25.74,Default,,0,0,0,,Мен жер бетіндегі барлық адамдар осылай киінген деп ойладым.
Dialogue: 0,0:07:25.74,0:07:27.41,Default,,0,0,0,,Сіз оны көп көрмейсіз, солай ма?
Dialogue: 0,0:07:28.36,0:07:30.98,Default,,0,0,0,,Мен онша көп немесе мүлде ойламаймын.
Dialogue: 0,0:07:31.21,0:07:33.65,Default,,0,0,0,,Дұрыс, солай
Dialogue: 0,0:07:39.66,0:07:40.84,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:41.50,0:07:44.24,Default,,0,0,0,,Менен сұрасаң жаман болар еді, құлағыңды салшы.
Dialogue: 0,0:07:45.46,0:07:46.32,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:51.10,0:07:53.30,Default,,0,0,0,,Сіз сондасыз ба? Мұндай алғы сөз
Dialogue: 0,0:07:53.53,0:07:57.52,Default,,0,0,0,,Егер олар менің бөтен адам екенімді білсе, маған шабуыл жасалады.
Dialogue: 0,0:07:57.89,0:07:58.63,Default,,0,0,0,,Анатомия?
Dialogue: 0,0:07:58.95,0:08:02.54,Default,,0,0,0,,Жер тұрғындарына деген тым көп теріс пікіріңіз бар емес пе?
Dialogue: 0,0:08:02.92,0:08:04.17,Default,,0,0,0,,Сондықтан ерекшеленбеңіз
Dialogue: 0,0:08:04.17,0:08:07.02,Default,,0,0,0,,Мен сол киімдерді шешіп, әрекет етуді шештім.
Dialogue: 0,0:08:09.13,0:08:10.44,Default,,0,0,0,,Эй, эй...
Dialogue: 0,0:08:10.44,0:08:13.61,Default,,0,0,0,,Бүгін онша жақсы иіс жоқ.
Dialogue: 0,0:08:13.61,0:08:14.20,Default,,0,0,0,,Сіз...
Dialogue: 0,0:08:14.20,0:08:15.03,Default,,0,0,0,,Донут!
Dialogue: 0,0:08:15.03,0:08:19.92,Default,,0,0,0,,пончик пончик пончик…
Dialogue: 0,0:08:20.20,0:08:21.02,Default,,0,0,0,,Эй, жібер!
Dialogue: 0,0:08:26.20,0:08:29.90,Default,,0,0,0,,Бірақ мен сенімен бірге болу тағдырыма жазылғандай сезінемін.
Dialogue: 0,0:08:30.03,0:08:31.37,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:08:31.84,0:08:36.36,Default,,0,0,0,,Мүмкін сен менімен кездесу үшін туған шығарсың.
Dialogue: 0,0:08:37.85,0:08:39.24,Default,,0,0,0,,Не? Мен ше?
Dialogue: 0,0:08:39.57,0:08:42.04,Default,,0,0,0,,Бұл жағдайға сен емессің бе?
Dialogue: 0,0:08:42.57,0:08:46.97,Default,,0,0,0,,Жоқ, менің басқа да тапсырмаларым бар.
Dialogue: 0,0:08:48.26,0:08:49.82,Default,,0,0,0,,Содан кейін мен...
Dialogue: 0,0:08:49.82,0:08:52.70,Default,,0,0,0,,Басқа шаруасы жоқ жалқаусың ба?
Dialogue: 0,0:08:53.70,0:08:55.37,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:08:56.39,0:08:58.15,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:08:58.41,0:09:01.98,Default,,0,0,0,,Жоқ, мен кешкі ас ішуге бара жатыр едім.
Dialogue: 0,0:09:06.65,0:09:09.17,Default,,0,0,0,,Мүмкін тағы кездесерміз
Dialogue: 0,0:09:09.39,0:09:13.37,Default,,0,0,0,,Келесі кездескенше.
Dialogue: 0,0:09:17.33,0:09:18.86,Default,,0,0,0,,Иә
Dialogue: 0,0:09:22.48,0:09:22.79,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:09:24.49,0:09:24.84,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:09:36.24,0:09:37.43,Default,,0,0,0,,Аа, 15 минут күтіңіз.
Dialogue: 0,0:09:38.80,0:09:40.14,Default,,0,0,0,,Ұзақ
Dialogue: 0,0:09:41.90,0:09:43.68,Default,,0,0,0,,Адачи~
Dialogue: 0,0:09:43.68,0:09:45.89,Default,,0,0,0,,Маған көмектесіңіз~ Оны ашыңыз~
Dialogue: 0,0:09:46.24,0:09:47.89,Default,,0,0,0,,Уф, енді жоқ...
Dialogue: 0,0:09:49.19,0:09:52.65,Default,,0,0,0,,<15 минут Киім ауыстыру? Ұйқы әдеттерін жою? ＞
Dialogue: 0,0:09:53.35,0:09:56.07,Default,,0,0,0,,<Менімен жай ғана сөйлесіп тұрсаң да, асыра айтып отырсың.>
Dialogue: 0,0:09:56.62,0:10:01.21,Default,,0,0,0,,<Бірақ мен сіздің достарыңыздың сізді жалқаулықпен көргенін қаламайтыныңызды да түсінемін.>
Dialogue: 0,0:10:02.05,0:10:06.49,Default,,0,0,0,,<Сыныптың бейнесін бұзу немесе оны бұзу алаңдатады.>
Dialogue: 0,0:10:09.21,0:10:10.53,Default,,0,0,0,,Неліктен форма?
Dialogue: 0,0:10:10.72,0:10:12.00,Default,,0,0,0,,Кенеттен
Dialogue: 0,0:10:15.22,0:10:18.37,Default,,0,0,0,,Сондай-ақ, пілге арналған жейдені қайдан сатып алуға болады?
Dialogue: 0,0:10:18.44,0:10:19.58,Default,,0,0,0,,Сұрамаңыз
Dialogue: 0,0:10:21.72,0:10:23.74,Default,,0,0,0,,Кенеттен келіп мені қорқытпа.
Dialogue: 0,0:10:24.12,0:10:25.11,Default,,0,0,0,,Байланысты
Dialogue: 0,0:10:25.56,0:10:26.21,Default,,0,0,0,,Байланыс? Ах
Dialogue: 0,0:10:27.83,0:10:29.85,Default,,0,0,0,,Сен оны көрмедің бе?
Dialogue: 0,0:10:30.20,0:10:32.13,Default,,0,0,0,,Телефоным сөмкемде.
Dialogue: 0,0:10:32.32,0:10:35.51,Default,,0,0,0,,Мм...Мен оны Шимамураның үйіне қалдырдым.
Dialogue: 0,0:10:37.42,0:10:40.78,Default,,0,0,0,,А, солай ма?
Dialogue: 0,0:10:41.29,0:10:43.50,Default,,0,0,0,,Мен көремін. Сондықтан мектепке келмедің бе?
Dialogue: 0,0:10:44.61,0:10:46.94,Default,,0,0,0,,Менде сөмке жоқ болғандықтан бара алмаймын.
Dialogue: 0,0:10:47.29,0:10:49.30,Default,,0,0,0,,Эй... Мен жай ғана ұйықтағым келді.
Dialogue: 0,0:10:50.04,0:10:54.20,Default,,0,0,0,,Бірақ бұл ішінара Шимамураға байланысты...
Dialogue: 0,0:10:55.00,0:10:55.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:57.08,0:10:59.10,Default,,0,0,0,,Сіз не жібердіңіз? хабар
Dialogue: 0,0:10:59.85,0:11:02.45,Default,,0,0,0,,Бұл... сау ма? Немесе бірдеңе
Dialogue: 0,0:11:03.47,0:11:05.74,Default,,0,0,0,,Олай болса, Генки.
Dialogue: 0,0:11:07.71,0:11:08.56,Default,,0,0,0,,Қайталап көріңіз
Dialogue: 0,0:11:09.24,0:11:09.62,Default,,0,0,0,,Яда
Dialogue: 0,0:11:10.33,0:11:12.33,Default,,0,0,0,,Мен қазір көтеріле аламын ба?
Dialogue: 0,0:11:12.68,0:11:14.44,Default,,0,0,0,,Аа, мен бүгін толық емес жұмыс күнім бар...
Dialogue: 0,0:11:14.91,0:11:16.20,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:11:17.01,0:11:17.77,Default,,0,0,0,,Онда мен үйге барамын
Dialogue: 0,0:11:18.25,0:11:18.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:19.36,0:11:21.63,Default,,0,0,0,,Бізде сөйлесуге уақыт бар.
Dialogue: 0,0:11:22.56,0:11:24.04,Default,,0,0,0,,Айтарыңыз бар ма?
Dialogue: 0,0:11:25.84,0:11:27.47,Default,,0,0,0,,Адачи: Маған бірдеңе айтшы...
Dialogue: 0,0:11:34.12,0:11:35.93,Default,,0,0,0,,...
Dialogue: 0,0:11:37.27,0:11:38.57,Default,,0,0,0,,Genki
Dialogue: 0,0:11:40.20,0:11:44.40,Default,,0,0,0,,Айтпақшы, сіз ыстық тиюге байланысты демалыс алдыңыз ба? Сіз әлі қалпына келдіңіз бе?
Dialogue: 0,0:11:46.74,0:11:48.27,Default,,0,0,0,,Сұрағанда, кенет...
Dialogue: 0,0:11:48.65,0:11:52.33,Default,,0,0,0,,Адачи жұқтырса мұңаяды, үйге ерте қайтайық.
Dialogue: 0,0:11:53.02,0:11:54.83,Default,,0,0,0,,О, өтірік, мен емделдім.
Dialogue: 0,0:11:55.61,0:11:57.55,Default,,0,0,0,,Қара, Адачи, келесі тақырып.
Dialogue: 0,0:12:06.84,0:12:08.90,Default,,0,0,0,,Аноса Шимамура...
Dialogue: 0,0:12:16.52,0:12:18.30,Default,,0,0,0,,Менімен қыдырғың келе ме?
Dialogue: 0,0:12:18.54,0:12:20.13,Default,,0,0,0,,Сенбі немесе басқасы
Dialogue: 0,0:12:25.05,0:12:27.44,Default,,0,0,0,,Тэко, қазір қайтуға болады.
Dialogue: 0,0:12:35.92,0:12:38.02,Default,,0,0,0,,Эй, сен оралдың ба, Нагато?
Dialogue: 0,0:12:38.70,0:12:39.66,Default,,0,0,0,,Қайта толтырыңыз!
Dialogue: 0,0:12:40.86,0:12:43.13,Default,,0,0,0,,Return
Dialogue: 0,0:12:43.50,0:12:46.97,Default,,0,0,0,,<Неге бұл жігіт бірінші кезекте менің үйімде тұрады?>
Dialogue: 0,0:12:54.48,0:12:55.71,Default,,0,0,0,,Хино сәл
Dialogue: 0,0:12:56.49,0:12:58.54,Default,,0,0,0,,Иә? Маған бірдеңе бере аласыз ба?
Dialogue: 0,0:12:58.90,0:13:00.09,Default,,0,0,0,,Иә, мен саған беремін.
Dialogue: 0,0:13:00.68,0:13:02.10,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:13:03.15,0:13:05.74,Default,,0,0,0,,Не? Саған не керек?
Dialogue: 0,0:13:06.54,0:13:06.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:23.00,0:13:24.79,Default,,0,0,0,,Не! кенеттен
Dialogue: 0,0:13:24.79,0:13:27.88,Default,,0,0,0,,Бала кезімде мұны көп жасайтыным есімде.
Dialogue: 0,0:13:28.58,0:13:30.70,Default,,0,0,0,,Мен күні бойы бірдеңе істеп жүргендей сезінемін.
Dialogue: 0,0:13:31.13,0:13:32.79,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:13:32.93,0:13:35.76,Default,,0,0,0,,Бірақ өткен өткен болды, ал қазір...
Dialogue: 0,0:13:37.37,0:13:38.38,Default,,0,0,0,,Бірдеңе өзгерді ме?
Dialogue: 0,0:13:41.19,0:13:42.68,Default,,0,0,0,,Ол өзгермейді ме?
Dialogue: 0,0:13:43.26,0:13:44.34,Default,,0,0,0,,Бір-біріне
Dialogue: 0,0:14:00.54,0:14:02.22,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз...
Dialogue: 0,0:14:02.36,0:14:07.08,Default,,0,0,0,,Әйтеуір мен келдім, сен сонда болдың.
Dialogue: 0,0:14:08.69,0:14:09.86,Default,,0,0,0,,Бұл тағдыр.
Dialogue: 0,0:14:10.34,0:14:11.34,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:14:13.06,0:14:14.85,Default,,0,0,0,,О, сен...
Dialogue: 0,0:14:16.00,0:14:17.05,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:17.55,0:14:18.87,Default,,0,0,0,,Білемін, бірақ шынымен сабырымды сақтай аламын ба?
Dialogue: 0,0:14:18.87,0:14:20.20,Default,,0,0,0,,Оған дайындалыңыз
Dialogue: 0,0:14:21.00,0:14:22.50,Default,,0,0,0,,Ха! Сәл күте тұрыңыз
Dialogue: 0,0:14:22.50,0:14:24.55,Default,,0,0,0,,Не?
Dialogue: 0,0:14:27.80,0:14:28.86,Default,,0,0,0,,<Симамура…>
Dialogue: 0,0:14:29.40,0:14:33.68,Default,,0,0,0,,<Симамура күнделікті киімінде өте сүйкімді>
Dialogue: 0,0:14:39.93,0:14:40.92,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:14:40.92,0:14:43.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:45.92,0:14:48.66,Default,,0,0,0,,Сонымен, басқа күні, бөтен
Dialogue: 0,0:14:48.66,0:14:49.87,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:58.22,0:14:58.74,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:15:00.86,0:15:03.50,Default,,0,0,0,,Шимамураның жақсылығы мүлде көрсетілмейді.
Dialogue: 0,0:15:03.81,0:15:04.44,Default,,0,0,0,,Иә
Dialogue: 0,0:15:04.92,0:15:05.64,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:05.64,0:15:07.83,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:15:08.57,0:15:12.23,Default,,0,0,0,,Адачи, бірақ сен... Ал сен ше?
Dialogue: 0,0:15:12.42,0:15:17.06,Default,,0,0,0,,Қысқасы, мен болашақтан келген адаммын және бөтен адаммын...
Dialogue: 0,0:15:19.62,0:15:21.56,Default,,0,0,0,,Шимамура аудармасы
Dialogue: 0,0:15:22.23,0:15:25.48,Default,,0,0,0,,Егер сіз оны көршінің сәл оғаш баласы деп ойласаңыз.
Dialogue: 0,0:15:25.90,0:15:28.40,Default,,0,0,0,,Бұл сіз күткен досыңыз ба?
Dialogue: 0,0:15:28.82,0:15:29.62,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:15:30.04,0:15:32.16,Default,,0,0,0,,Олай болса барайық.
Dialogue: 0,0:15:32.72,0:15:36.52,Default,,0,0,0,,Өткен күні алған пончиктеріңіз үшін рахмет айтуға рұқсат етіңіздер. Мен саған біреуін сатып аламын.
Dialogue: 0,0:15:37.13,0:15:39.05,Default,,0,0,0,,Жоқ. Келесің бе?
Dialogue: 0,0:15:49.22,0:15:50.72,Default,,0,0,0,,Не?
Dialogue: 0,0:15:51.01,0:15:52.68,Default,,0,0,0,,Мен қашып кетуім мүмкін деп ойладым.
Dialogue: 0,0:15:55.34,0:15:57.18,Default,,0,0,0,,Мен қашпаймын, бірақ...
Dialogue: 0,0:15:57.90,0:16:00.51,Default,,0,0,0,,Әзірге барайық.
Dialogue: 0,0:16:01.47,0:16:04.66,Default,,0,0,0,,Саса Шимамура-сан
Dialogue: 0,0:16:09.44,0:16:11.45,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:16:11.59,0:16:13.56,Default,,0,0,0,,Тез, тез~
Dialogue: 0,0:16:13.56,0:16:14.54,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:16:16.03,0:16:17.84,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:16:18.65,0:16:19.72,Default,,0,0,0,,Оны аздап толтырыңыз
Dialogue: 0,0:16:21.57,0:16:22.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:22.61,0:16:24.65,Default,,0,0,0,,Жоқ, жоқ, бұл біртүрлі.
Dialogue: 0,0:16:25.00,0:16:27.82,Default,,0,0,0,,Мен бұл үлпілдек омлет суфлесін жасаймын.
Dialogue: 0,0:16:28.36,0:16:30.26,Default,,0,0,0,,Шимамура мырза не істейді?
Dialogue: 0,0:16:32.89,0:16:34.65,Default,,0,0,0,,Бұл дәмді көрінеді.
Dialogue: 0,0:16:34.84,0:16:36.00,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:36.28,0:16:37.61,Default,,0,0,0,,Адачи не істейді?
Dialogue: 0,0:16:38.01,0:16:39.60,Default,,0,0,0,,Жарайды, өйткені маған ұнайды.
Dialogue: 0,0:16:40.73,0:16:41.84,Default,,0,0,0,,Маған мәзірді беріңіз
Dialogue: 0,0:16:42.83,0:16:43.65,Default,,0,0,0,,Айо, иә... иә?
Dialogue: 0,0:16:46.46,0:16:48.06,Default,,0,0,0,,Шимамура үшін қайсысын таңдауым керек?
Dialogue: 0,0:16:49.76,0:16:52.73,Default,,0,0,0,,Ендеше неге бір пицца мен бір макаронға тапсырыс беріп, оларды бөліп бермейміз?
Dialogue: 0,0:16:52.99,0:16:53.70,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:59.76,0:17:01.66,Default,,0,0,0,,Менің бос уақытым болды
Dialogue: 0,0:17:01.79,0:17:05.58,Default,,0,0,0,,Бос уақыттарыңызда адамдардың өмірлік маңызды нүктелерін саусағыңызбен қағасыз ба?
Dialogue: 0,0:17:08.02,0:17:11.50,Default,,0,0,0,,Шимамура пиццаны, мен макаронды таңдаймын.
Dialogue: 0,0:17:13.14,0:17:14.32,Default,,0,0,0,,Адачи
Dialogue: 0,0:17:16.38,0:17:18.04,Default,,0,0,0,,Не болды~?
Dialogue: 0,0:17:18.76,0:17:20.44,Default,,0,0,0,,Жоқ... бұл ештеңе емес.
Dialogue: 0,0:17:22.06,0:17:24.03,Default,,0,0,0,,Олай болса солай істе және күл
Dialogue: 0,0:17:24.36,0:17:26.26,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:17:26.75,0:17:29.25,Default,,0,0,0,,Келесі күні, иә, мен тыңдаймын.
Dialogue: 0,0:17:29.38,0:17:30.87,Default,,0,0,0,,Дені сау ма?
Dialogue: 0,0:17:32.29,0:17:34.10,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:17:36.03,0:17:38.46,Default,,0,0,0,,Ге... Генки!
Dialogue: 0,0:17:42.54,0:17:45.28,Default,,0,0,0,,Келді, келді!
Dialogue: 0,0:17:54.45,0:17:57.65,Default,,0,0,0,,Ой!
Dialogue: 0,0:17:57.80,0:17:59.07,Default,,0,0,0,,Маған бір тістеп беріңізші.
Dialogue: 0,0:17:59.75,0:18:00.62,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:18:01.80,0:18:02.82,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:18:04.46,0:18:05.74,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:18:06.20,0:18:07.18,Default,,0,0,0,,Бөлек
Dialogue: 0,0:18:07.26,0:18:10.10,Default,,0,0,0,,Хаякуши Текудасай
Dialogue: 0,0:18:10.35,0:18:13.82,Default,,0,0,0,,Дәлірек айтқанда, сіз қалай сөйлейсіз.
Dialogue: 0,0:18:19.37,0:18:21.94,Default,,0,0,0,,Тәтті! Тым көп сироп!
Dialogue: 0,0:18:22.06,0:18:23.89,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:26.89,0:18:30.16,Default,,0,0,0,,Адачидің бүйірін шымшуды тоқтата аласыз ба?
Dialogue: 0,0:18:30.16,0:18:31.41,Default,,0,0,0,,А... иә
Dialogue: 0,0:18:34.79,0:18:37.02,Default,,0,0,0,,Мен де саған тістеп берейін.
Dialogue: 0,0:18:37.74,0:18:40.46,Default,,0,0,0,,Бастапқыда жарты өлшемді емес пе еді?
Dialogue: 0,0:18:40.46,0:18:41.77,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:18:41.97,0:18:44.17,Default,,0,0,0,,Бұл... қосымша жұтым.
Dialogue: 0,0:18:44.65,0:18:45.90,Default,,0,0,0,,Секір!!
Dialogue: 0,0:18:49.53,0:18:51.15,Default,,0,0,0,,Unme~
Dialogue: 0,0:18:53.53,0:18:56.49,Default,,0,0,0,,Мен мұны сізге жасай аламын ба?
Dialogue: 0,0:18:57.08,0:18:57.98,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:18:59.32,0:19:01.32,Default,,0,0,0,,Мен жақсы нәрсе ойладым.
Dialogue: 0,0:19:01.52,0:19:02.73,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:19:06.41,0:19:07.50,Default,,0,0,0,,Қашпа
Dialogue: 0,0:19:09.34,0:19:10.62,Default,,0,0,0,,Қашпасаң...
Dialogue: 0,0:19:10.90,0:19:11.88,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:13.47,0:19:15.67,Default,,0,0,0,,Шимамура өте қамқор, солай емес пе?
Dialogue: 0,0:19:15.87,0:19:20.61,Default,,0,0,0,,Мен сіңіліммен мұндай нәрселерді қалдыруға дағдыланғанмын.
Dialogue: 0,0:19:21.85,0:19:23.95,Default,,0,0,0,,Мен де Шимамураның әпкесімін бе?
Dialogue: 0,0:19:25.93,0:19:27.93,Default,,0,0,0,,Сіз мені әпке деп атай аласыз.
Dialogue: 0,0:19:32.39,0:19:33.26,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:19:36.39,0:19:38.60,Default,,0,0,0,,Жоқ... Бұл не, әпке?
Dialogue: 0,0:19:41.97,0:19:43.37,Default,,0,0,0,,Шимамура артында...
Dialogue: 0,0:19:45.14,0:19:46.79,Default,,0,0,0,,Е! ?
Dialogue: 0,0:19:48.84,0:19:50.42,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:19:50.42,0:19:52.07,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:19:52.38,0:19:53.98,Default,,0,0,0,,Мен оны көргенде түсіндім.
Dialogue: 0,0:19:54.22,0:19:56.30,Default,,0,0,0,,Алыста болғандықтан қиын.
Dialogue: 0,0:19:56.30,0:19:57.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:57.55,0:19:59.58,Default,,0,0,0,,Бұл жерден оңай.
Dialogue: 0,0:20:00.41,0:20:02.61,Default,,0,0,0,,Ха, бұл ақылды.
Dialogue: 0,0:20:02.73,0:20:06.69,Default,,0,0,0,,Айтпақшы, жеңіс жақсы нәрсе әкеле ме?
Dialogue: 0,0:20:08.22,0:20:13.79,Default,,0,0,0,,Ал...қарсыласыңды жеңгеніңді сезбейсің бе?
Dialogue: 0,0:20:14.40,0:20:16.71,Default,,0,0,0,,Жеңіске жетсем де, рахаттана алмаймын.
Dialogue: 0,0:20:17.18,0:20:19.45,Default,,0,0,0,,Өйткені маған Шимамура-сан ұнайды
Dialogue: 0,0:20:23.92,0:20:24.81,Default,,0,0,0,,Сакуражима сенпай саған жек көреді. Мен солай десем, ол міндетті түрде мені ұрып жіберер еді.
Dialogue: 0,0:20:25.37,0:20:26.52,Default,,0,0,0,,олар ондағы жазбаларды сақтау үшін көшіріп жазады—
Dialogue: 0,0:20:26.97,0:20:28.57,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:20:28.65,0:20:32.91,Default,,0,0,0,,Олай болса менімен жарысайық.
Dialogue: 0,0:20:33.30,0:20:33.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:35.59,0:20:38.74,Default,,0,0,0,,Мені, кәсіпқой боулиншіні жеңуді жоспарлап отырсыз ба?
Dialogue: 0,0:20:39.55,0:20:41.55,Default,,0,0,0,,Әрине, жеңіске жетуге ниетім бар.
Dialogue: 0,0:20:42.38,0:20:43.64,Default,,0,0,0,,Егер мен жеңсем
Dialogue: 0,0:20:43.92,0:20:44.86,Default,,0,0,0,,Адачи?
Dialogue: 0,0:20:45.06,0:20:45.97,Default,,0,0,0,,Маған құлағыңды сал
Dialogue: 0,0:20:54.06,0:20:55.10,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:21:11.91,0:21:13.72,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:21:14.58,0:21:17.26,Default,,0,0,0,,Сіз маған еліктей аласыз.
Dialogue: 0,0:21:18.46,0:21:20.95,Default,,0,0,0,,Қалыпты лақтырсаң өзгермейді деп ойлаймын.
Dialogue: 0,0:21:21.24,0:21:23.92,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:21:24.08,0:21:25.80,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:21:26.11,0:21:27.73,Default,,0,0,0,,Аяғың тырналған жоқ па?
Dialogue: 0,0:21:29.39,0:21:32.15,Default,,0,0,0,,Сіз қай жағын қолдайсыз, Шимамура?
Dialogue: 0,0:21:33.74,0:21:35.25,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:21:36.64,0:21:37.58,Default,,0,0,0,,Шимамурашима
Dialogue: 0,0:21:38.32,0:21:39.60,Default,,0,0,0,,Шимамура Шимамура-сан!
Dialogue: 0,0:21:47.01,0:21:49.21,Default,,0,0,0,,<Қайсысын сұрамаңыз>
Dialogue: 0,0:21:50.42,0:21:53.43,Default,,0,0,0,,＜Осының бәрі жалғаса бергеннен кейін мен шаршамаймын＞
Dialogue: 0,0:21:54.18,0:21:58.37,Default,,0,0,0,,<Мен бірте-бірте тозып, тозып бара жатқандай сезінемін.>
Dialogue: 0,0:21:59.32,0:22:01.50,Default,,0,0,0,,<Бірақ жалғыз қызықсыз>
Dialogue: 0,0:22:02.22,0:22:06.00,Default,,0,0,0,,<Бұл жалғыздықтан әлдеқайда ауыр және шыдамсыз ауру.>
Dialogue: 0,0:22:06.91,0:22:12.92,Default,,0,0,0,,<Оған қарсы тұратын жалғыз дәрі - адамдар арасындағы көрінбейтін нәрселер.>
Dialogue: 0,0:22:13.92,0:22:17.03,Default,,0,0,0,,＜Сонымен мен тозуды жалғастырамын＞
Dialogue: 0,0:22:17.72,0:22:21.56,Default,,0,0,0,,<Өзімді сақтап қалу үшін оны біртіндеп жоғалтып аламын>
Dialogue: 0,0:22:23.26,0:22:27.40,Default,,0,0,0,,Іс жақсы болмай, мен қатты қиналсам, ашуланба.
Dialogue: 0,0:23:58.77,0:24:00.93,Default,,0,0,0,,Адажимапедия боулинг
Dialogue: 0,0:24:00.99,0:24:02.55,Default,,0,0,0,,Жарайды, ұр!
Dialogue: 0,0:24:02.55,0:24:03.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:03.72,0:24:05.69,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,0:24:05.69,0:24:06.81,Default,,0,0,0,,Біз жарысып жатырмыз, солай ма?
Dialogue: 0,0:24:06.81,0:24:08.40,Default,,0,0,0,,Жарайды, ұр!
Dialogue: 0,0:24:08.40,0:24:10.08,Default,,0,0,0,,Уау~ Мен жеңілмеймін!
Dialogue: 0,0:24:10.15,0:24:11.19,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:24:11.61,0:24:12.20,Default,,0,0,0,,Міне осы
Dialogue: 0,0:24:12.20,0:24:13.03,Default,,0,0,0,,Міне.
Dialogue: 0,0:24:14.53,0:24:20.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
