Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.40,0:00:12.67,Default,,0,0,0,,<Бір күні, иә, бір күні>
Dialogue: 0,0:00:12.67,0:00:17.51,Default,,0,0,0,,<Мен қаламасам да, гүлдеген шие гүлдеріне қарап>
Dialogue: 0,0:00:17.51,0:00:20.51,Default,,0,0,0,,<Көктемнің жолымен жүретін күн туады>
Dialogue: 0,0:00:23.02,0:00:25.85,Default,,0,0,0,,<(Адачи) Мен қарапайым адаммын>
Dialogue: 0,0:00:25.85,0:00:29.19,Default,,0,0,0,,<Көрмейтінді ұстайтын күшім жоқ>
Dialogue: 0,0:00:29.19,0:00:32.69,Default,,0,0,0,,<Алдыңда болып жатқан нәрсеге араласуға болмайды.>
Dialogue: 0,0:00:32.69,0:00:35.03,Default,,0,0,0,,<Мен осыдан қорқамын>
Dialogue: 0,0:00:35.03,0:00:37.86,Default,,0,0,0,,<Симамура менімен болмаған кезде>
Dialogue: 0,0:00:37.86,0:00:40.46,Default,,0,0,0,,<Белгісіз нәрсеге өзгерту>
Dialogue: 0,0:00:41.53,0:00:43.87,Default,,0,0,0,,＜Ендеше, бұдан былай мен кіммін＞
Dialogue: 0,0:00:43.87,0:00:48.37,Default,,0,0,0,,<Симамураны бір сәтке де бақылап отыруға бел байладым>
Dialogue: 0,0:00:50.54,0:00:53.55,Default,,0,0,0,,Адачи?
Dialogue: 0,0:00:53.55,0:00:55.55,Default,,0,0,0,,Не? (Хино/Нагато) Шуш Шуш Шуш
Dialogue: 0,0:00:55.55,0:00:58.62,Default,,0,0,0,,Ал, жоқ (Хино) Иә, Шима-чан→
Dialogue: 0,0:00:58.62,0:01:02.62,Default,,0,0,0,,Эй, Адачи-чи де бар (Нагафуджи) Чи-чи.
Dialogue: 0,0:01:02.62,0:01:06.16,Default,,0,0,0,,Хино мен Нагато, біраз уақыт өтті.
Dialogue: 0,0:01:06.16,0:01:09.16,Default,,0,0,0,,Хисахиса~ Иә?
Dialogue: 0,0:01:11.23,0:01:13.23,Default,,0,0,0,,Нагато: Сусабын ауыстырдыңыз ба?
Dialogue: 0,0:01:13.23,0:01:16.84,Default,,0,0,0,,А, мен кеше Хино-Нчиде қалдым →
Dialogue: 0,0:01:16.84,0:01:20.67,Default,,0,0,0,,Не керек, мен де таңертең шомылдым.
Dialogue: 0,0:01:20.67,0:01:24.74,Default,,0,0,0,,Сіз бұл туралы келесі жолы айта аласыз.
Dialogue: 0,0:01:24.74,0:01:28.18,Default,,0,0,0,,Қараңдаршы, біздің кезегіміз.
Dialogue: 0,0:01:28.18,0:01:30.68,Default,,0,0,0,,Шуш шуш шуш Сәттілік~
Dialogue: 0,0:01:30.68,0:01:32.69,Default,,0,0,0,,<Басқаның үйінде болу>
Dialogue: 0,0:01:32.69,0:01:37.19,Default,,0,0,0,,<Түнеңіз, шомылыңыз, сосын мектепке барыңыз>
Dialogue: 0,0:01:38.19,0:01:42.53,Default,,0,0,0,,Уау! Мен де бара аламын ба?
Dialogue: 0,0:01:42.53,0:01:45.03,Default,,0,0,0,,Иә? Түнде тұру
Dialogue: 0,0:01:45.03,0:01:48.03,Default,,0,0,0,,Иә? Хиноның үйінде ме?
Dialogue: 0,0:01:49.87,0:01:52.37,Default,,0,0,0,,Ши... Шимамураның үйі!
Dialogue: 0,0:01:53.37,0:01:56.67,Default,,0,0,0,,Неліктен? Ой, бұл...
Dialogue: 0,0:01:59.98,0:02:02.99,Default,,0,0,0,,Егер сіз түнеп жатсаңыз, біздің жуынатын бөлме кішкентай.
Dialogue: 0,0:02:02.99,0:02:05.99,Default,,0,0,0,,Мен ваннаға мүлдем мән бермеймін...
Dialogue: 0,0:02:05.99,0:02:10.19,Default,,0,0,0,,<Бұл маңызды ма? Жоқ, бұл жақсы емес деп ойлаймын.
Dialogue: 0,0:02:17.33,0:02:20.43,Default,,0,0,0,,＜Жаман ванна＞
Dialogue: 0,0:02:21.40,0:02:23.41,Default,,0,0,0,,Адачи? Ах
Dialogue: 0,0:02:23.41,0:02:26.41,Default,,0,0,0,,Маған бәрібір, бірақ түнде қалғым келеді!
Dialogue: 0,0:02:26.41,0:02:28.91,Default,,0,0,0,,Хмм, неге?
Dialogue: 0,0:02:30.01,0:02:34.02,Default,,0,0,0,,Өйткені... мен Шимамурамен дос болғым келеді.
Dialogue: 0,0:02:34.02,0:02:38.35,Default,,0,0,0,,Жаман қарым-қатынастасыз ба? Мен мұны білмедім.
Dialogue: 0,0:02:38.35,0:02:41.19,Default,,0,0,0,,А, жарайды, жарайды!
Dialogue: 0,0:02:41.19,0:02:43.26,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:02:43.26,0:02:46.26,Default,,0,0,0,,Мен көбірек болғым келеді
Dialogue: 0,0:02:46.26,0:02:49.70,Default,,0,0,0,,Түнде қалсақ жақсы араласамыз ба деп ойлаймын.
Dialogue: 0,0:02:49.70,0:02:51.90,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:54.30,0:02:56.90,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:03:00.14,0:03:03.64,Default,,0,0,0,,Хмм... Адачи?
Dialogue: 0,0:03:06.65,0:03:09.15,Default,,0,0,0,,<Түнгі консультация атынан>
Dialogue: 0,0:03:09.15,0:03:11.99,Default,,0,0,0,,<Сабақтан кейін Шимамурамен айналма жол>
Dialogue: 0,0:03:11.99,0:03:14.99,Default,,0,0,0,,＜Таңғажайып түнеу＞
Dialogue: 0,0:03:14.99,0:03:20.33,Default,,0,0,0,,Олай болса, сен менің үйіме осы аптаның сенбі немесе жексенбісінде келесің бе?
Dialogue: 0,0:03:20.33,0:03:24.67,Default,,0,0,0,,Қайта… дәйекті мерекелер қатарынан түндер
Dialogue: 0,0:03:24.67,0:03:27.34,Default,,0,0,0,,Сіз сонша ұзақ қалғыңыз келе ме?
Dialogue: 0,0:03:27.34,0:03:30.44,Default,,0,0,0,,Мен сізге айтайын, біз қонақ үй емеспіз.
Dialogue: 0,0:03:31.67,0:03:33.68,Default,,0,0,0,,А, сенің толық емес жұмыс күнің ше?
Dialogue: 0,0:03:33.68,0:03:37.75,Default,,0,0,0,,Менің толық емес жұмыс уақытым Шимамурадағы үйімнен шығады.
Dialogue: 0,0:03:37.75,0:03:39.75,Default,,0,0,0,,Ммм
Dialogue: 0,0:03:39.75,0:03:44.52,Default,,0,0,0,,Қайтып келсем тағы біреуі бар сияқты, хахаха...
Dialogue: 0,0:03:44.52,0:03:46.52,Default,,0,0,0,,Маған қызық, бұл не~
Dialogue: 0,0:03:46.52,0:03:50.42,Default,,0,0,0,,Соңғы кездері өзімнен екі-үш сіңілім бар сияқты болып жүр.
Dialogue: 0,0:03:51.59,0:03:53.96,Default,,0,0,0,,Мен де?
Dialogue: 0,0:03:53.96,0:03:58.03,Default,,0,0,0,,Пуууу ахахахха...
Dialogue: 0,0:03:58.03,0:04:02.04,Default,,0,0,0,,<Әпке ана Сакура Шимамура>
Dialogue: 0,0:04:02.04,0:04:04.64,Default,,0,0,0,,<Ұнтақтап тұрған сияқты.>
Dialogue: 0,0:04:04.64,0:04:07.64,Default,,0,0,0,,<Біз достардан әлдеқайда жақынбыз>
Dialogue: 0,0:04:07.64,0:04:10.48,Default,,0,0,0,,<Бұл жақсы>
Dialogue: 0,0:04:10.48,0:04:13.15,Default,,0,0,0,,＜Күрсін... тым жақындап қалды＞
Dialogue: 0,0:04:13.15,0:04:16.45,Default,,0,0,0,,<Адамдар көрмейтін жерлер көп болатын сияқты.>
Dialogue: 0,0:04:17.49,0:04:20.16,Default,,0,0,0,,Не сатып алу керек:
Dialogue: 0,0:04:20.16,0:04:23.83,Default,,0,0,0,,Шимамураның жалықпайтынына көз жеткізіңіз.
Dialogue: 0,0:04:23.83,0:04:25.83,Default,,0,0,0,,Ойнайтын нәрсе
Dialogue: 0,0:04:30.17,0:04:34.00,Default,,0,0,0,,Бұл емес, хмм.
Dialogue: 0,0:04:34.00,0:04:38.84,Default,,0,0,0,,<Егер шынымен де шаруамыз болмаса, теледидарды бірге көре аламыз ба?>
Dialogue: 0,0:04:38.84,0:04:41.51,Default,,0,0,0,,Ах
Dialogue: 0,0:04:41.51,0:04:44.51,Default,,0,0,0,,<Баяғы күндегідей болуы мүмкін>
Dialogue: 0,0:04:44.51,0:04:46.58,Default,,0,0,0,,<Дәл солай болды>
Dialogue: 0,0:04:46.58,0:04:49.52,Default,,0,0,0,,<Осы жолы қашып құтыла аламын ба?>
Dialogue: 0,0:04:49.52,0:04:52.52,Default,,0,0,0,,Умм...
Dialogue: 0,0:04:53.52,0:04:55.52,Default,,0,0,0,,Хмф!
Dialogue: 0,0:04:57.53,0:05:01.73,Default,,0,0,0,,Мен қашпаймын!
Dialogue: 0,0:05:03.47,0:05:06.97,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:05:06.97,0:05:09.31,Default,,0,0,0,,Ах
Dialogue: 0,0:05:09.31,0:05:13.14,Default,,0,0,0,,Бұл... Менің айтайын дегенім...
Dialogue: 0,0:05:13.14,0:05:15.14,Default,,0,0,0,,Сіздің жүгіңіз көп емес пе?
Dialogue: 0,0:05:15.14,0:05:19.15,Default,,0,0,0,,Қозғалып жатқан сияқты емес пе?
Dialogue: 0,0:05:19.15,0:05:21.65,Default,,0,0,0,,Миста, бізді аңдап жүрген жоқ па?
Dialogue: 0,0:05:21.65,0:05:24.99,Default,,0,0,0,,Мен солай ойлаймын. Әлі ерте емес пе?
Dialogue: 0,0:05:24.99,0:05:28.49,Default,,0,0,0,,А... Сағат небәрі 8 болды.
Dialogue: 0,0:05:28.49,0:05:30.99,Default,,0,0,0,,Кешіріңіз... Кешіріңіз. Сіз ұйықтап қалдыңыз ба?
Dialogue: 0,0:05:30.99,0:05:34.06,Default,,0,0,0,,Иә, мен сізді ояттым, кешіріңіз.
Dialogue: 0,0:05:34.06,0:05:36.50,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:05:36.50,0:05:41.34,Default,,0,0,0,,Адачи өте ұқыпты, бұл тамаша.
Dialogue: 0,0:05:41.34,0:05:46.68,Default,,0,0,0,,<Шынында мен сағат 7-де келдім, бірақ әлі ерте деп ойладым.>
Dialogue: 0,0:05:46.68,0:05:50.48,Default,,0,0,0,,<Мен мұнда велосипедпен кезіп жүрдім деп айта алмаймын>
Dialogue: 0,0:05:51.51,0:05:54.52,Default,,0,0,0,,Иә, менің ойымша, бұл біртүрлі бөлік.
Dialogue: 0,0:05:54.52,0:05:57.69,Default,,0,0,0,,Олай болса, тағы да қош келдіңіз.
Dialogue: 0,0:05:57.69,0:06:01.29,Default,,0,0,0,,Өтінемін... онда.
Dialogue: 0,0:06:02.46,0:06:04.66,Default,,0,0,0,,Ах
Dialogue: 0,0:06:07.30,0:06:10.63,Default,,0,0,0,,Сіздің әпкеңіздің досы есіңізде ме?
Dialogue: 0,0:06:10.63,0:06:13.14,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:06:13.14,0:06:15.34,Default,,0,0,0,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,0:06:16.21,0:06:19.48,Default,,0,0,0,,Хм... Сіз жақсы қыз маскасын киіп алғансыз.
Dialogue: 0,0:06:19.48,0:06:21.48,Default,,0,0,0,,Екінші қабаттағы бөлме жақсы ма?
Dialogue: 0,0:06:21.48,0:06:25.38,Default,,0,0,0,,Дәлірек айтсақ, бұл жалғыз бос орын.
Dialogue: 0,0:06:27.15,0:06:29.49,Default,,0,0,0,,Иә? Сіз екінші қабатты жек көресіз бе?
Dialogue: 0,0:06:29.49,0:06:31.55,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:06:31.55,0:06:35.83,Default,,0,0,0,,Мен Шимамурамен бір бөлмеде емеспін деп ойлаймын.
Dialogue: 0,0:06:35.83,0:06:38.33,Default,,0,0,0,,Бөлмені бөліскіңіз келе ме?
Dialogue: 0,0:06:40.50,0:06:43.50,Default,,0,0,0,,Жақсы, менде бәрі жақсы.
Dialogue: 0,0:06:43.50,0:06:47.70,Default,,0,0,0,,Кешіріңіз, менің ойымша, бұл әпкеме ұнамайтын шығар.
Dialogue: 0,0:06:51.57,0:06:55.95,Default,,0,0,0,,<Бәрі ойлағандай бола алмайды>
Dialogue: 0,0:06:55.95,0:07:01.02,Default,,0,0,0,,<Тіпті Шимамура маған өз бөлмесінде ұйықтауға рұқсат береді>
Dialogue: 0,0:07:01.02,0:07:05.62,Default,,0,0,0,,《Мен онымен жақсымын, бірақ бұл менің әпкем ұнамайды деп ойлаймын》
Dialogue: 0,0:07:05.62,0:07:09.99,Default,,0,0,0,,《Мен тілеймін》
Dialogue: 0,0:07:11.63,0:07:13.70,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:07:13.70,0:07:16.30,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:07:16.30,0:07:18.97,Default,,0,0,0,,Таңғы асқа не ішесіз? Сен тамақ іштің бе?
Dialogue: 0,0:07:18.97,0:07:23.04,Default,,0,0,0,,А... жарайды, мен саған дайындап қойдым.
Dialogue: 0,0:07:23.04,0:07:25.98,Default,,0,0,0,,Эй, эй, эй →
Dialogue: 0,0:07:25.98,0:07:28.98,Default,,0,0,0,,Әй, менің тамағымды жей алмайсың ба?
Dialogue: 0,0:07:28.98,0:07:30.98,Default,,0,0,0,,А... жоқ
Dialogue: 0,0:07:30.98,0:07:33.48,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:07:33.48,0:07:35.68,Default,,0,0,0,,Өзіңізге қажетін алыңыз
Dialogue: 0,0:07:36.55,0:07:38.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.55,0:07:41.32,Default,,0,0,0,,Адачи-чан менікінен бөлек.
Dialogue: 0,0:07:41.32,0:07:43.66,Default,,0,0,0,,Сіз мектепке баруға шындап қарайсыз ба?
Dialogue: 0,0:07:43.66,0:07:46.00,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:07:46.00,0:07:49.50,Default,,0,0,0,,Адачи де солай сезінеді (Шимамураның анасы) Солай ма?
Dialogue: 0,0:07:49.50,0:07:52.50,Default,,0,0,0,,Ол тыныш және жақсы бала сияқты.
Dialogue: 0,0:07:52.50,0:07:54.44,Default,,0,0,0,,Менің жаман қызымнан артық
Dialogue: 0,0:07:54.44,0:07:56.51,Default,,0,0,0,,Қараңыз, міне осы ғой?
Dialogue: 0,0:07:56.51,0:08:01.44,Default,,0,0,0,,Шимамура маған қарағанда жақсырақ қыз.
Dialogue: 0,0:08:01.44,0:08:03.45,Default,,0,0,0,,Жақсы қыз? Күшік…
Dialogue: 0,0:08:03.45,0:08:06.45,Default,,0,0,0,,Ахахаха мен көрдім.
Dialogue: 0,0:08:06.45,0:08:09.29,Default,,0,0,0,,Сонда Адачи-чан үлкен апа ма?
Dialogue: 0,0:08:09.29,0:08:11.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.29,0:08:13.39,Default,,0,0,0,,А...
Dialogue: 0,0:08:16.79,0:08:18.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:25.87,0:08:27.87,Default,,0,0,0,,Тамақ бергеніңізге рахмет~
Dialogue: 0,0:08:28.87,0:08:31.77,Default,,0,0,0,,Өтінемін~
Dialogue: 0,0:08:33.64,0:08:36.31,Default,,0,0,0,,Мм, сен ашулысың ба?
Dialogue: 0,0:08:36.31,0:08:39.82,Default,,0,0,0,,Не? Аа, бұрынғыдан
Dialogue: 0,0:08:39.82,0:08:42.89,Default,,0,0,0,,Менің анам әрқашан солай.
Dialogue: 0,0:08:42.89,0:08:45.82,Default,,0,0,0,,Ашуланғаннан пайда жоқ, хаха
Dialogue: 0,0:08:45.82,0:08:48.89,Default,,0,0,0,,<Адамдардың қарым-қатынасы осындай.>
Dialogue: 0,0:08:48.89,0:08:51.49,Default,,0,0,0,,Сол Адачиден
Dialogue: 0,0:08:51.49,0:08:55.56,Default,,0,0,0,,Енді не істейміз? Ах...
Dialogue: 0,0:08:55.56,0:08:58.57,Default,,0,0,0,,<Мерекелер ерекше сезімге бөленді>
Dialogue: 0,0:08:58.57,0:09:00.57,Default,,0,0,0,,<Қашаннан бері?>
Dialogue: 0,0:09:04.00,0:09:06.00,Default,,0,0,0,,<Кеше менің келгенімнің бірінші күні болды>
Dialogue: 0,0:09:06.00,0:09:09.50,Default,,0,0,0,,＜Ол шынымен ештеңемен аяқталды＞
Dialogue: 0,0:09:10.51,0:09:14.51,Default,,0,0,0,,Жарайды... онда мен барамын.
Dialogue: 0,0:09:15.51,0:09:18.35,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:09:18.35,0:09:20.45,Default,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:09:21.42,0:09:26.36,Default,,0,0,0,,＜  ＞
Dialogue: 0,0:09:26.36,0:09:29.36,Default,,0,0,0,,<Жай ғана бірге болу>
Dialogue: 0,0:09:29.36,0:09:31.86,Default,,0,0,0,,＜Тек бірге＞
Dialogue: 0,0:09:31.86,0:09:35.36,Default,,0,0,0,,<Мүмкін бұл менің идеалым шығар>
Dialogue: 0,0:09:36.70,0:09:38.70,Default,,0,0,0,,<Бірақ…>
Dialogue: 0,0:09:42.70,0:09:45.70,Default,,0,0,0,,Бірақ... Мен бар күшімді саламын!
Dialogue: 0,0:09:47.04,0:09:49.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:49.38,0:09:51.38,Default,,0,0,0,,Пуф... Ухуфу
Dialogue: 0,0:09:51.38,0:09:54.32,Default,,0,0,0,,Хмм, бар күшіңізді салыңыз.
Dialogue: 0,0:09:54.32,0:09:56.65,Default,,0,0,0,,<Симамура күлді>
Dialogue: 0,0:09:56.65,0:09:59.85,Default,,0,0,0,,<Бүгін жақсы күн болуы мүмкін>
Dialogue: 0,0:10:01.16,0:10:03.83,Default,,0,0,0,,<Ах, бірақ кеше>
Dialogue: 0,0:10:03.83,0:10:07.33,Default,,0,0,0,,<Мүлдем ештеңе болмаған сияқты>
Dialogue: 0,0:10:07.33,0:10:09.43,Default,,0,0,0,,<Шын мәнінде емес>
Dialogue: 0,0:10:11.33,0:10:14.67,Default,,0,0,0,,Хозуки, тездетіп шомыл.
Dialogue: 0,0:10:14.67,0:10:17.34,Default,,0,0,0,,Ішің ісіп кеткен бойда ұйықтайсың.
Dialogue: 0,0:10:17.34,0:10:20.84,Default,,0,0,0,,Иә, иә, дұрыс.
Dialogue: 0,0:10:20.84,0:10:23.84,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет.
Dialogue: 0,0:10:29.85,0:10:32.52,Default,,0,0,0,,<Симамураның бөлмесі бірінші қабатта болса да>
Dialogue: 0,0:10:32.52,0:10:35.52,Default,,0,0,0,,<Маған табиғи түрде келген>
Dialogue: 0,0:10:35.52,0:10:38.59,Default,,0,0,0,,＜Мен өзімді бақытты сезінемін＞
Dialogue: 0,0:10:38.59,0:10:44.20,Default,,0,0,0,,<Мен ешкім туралы білмедім, бірақ өзімді тіпті артық сезіндім.>
Dialogue: 0,0:10:44.20,0:10:46.20,Default,,0,0,0,,<Сонымен...>
Dialogue: 0,0:10:46.20,0:10:49.20,Default,,0,0,0,,<Мен сол кезде>
Dialogue: 0,0:10:49.20,0:10:52.54,Default,,0,0,0,,<Кішкене батыл бол>
Dialogue: 0,0:10:52.54,0:10:55.14,Default,,0,0,0,,Аяқ арасы...
Dialogue: 0,0:10:55.14,0:10:57.14,Default,,0,0,0,,Мен отыра аламын ба?
Dialogue: 0,0:10:58.21,0:11:02.81,Default,,0,0,0,,Өткендегідей қашпасаң.
Dialogue: 0,0:11:04.22,0:11:06.22,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:11:06.22,0:11:09.22,Default,,0,0,0,,А... у... иә
Dialogue: 0,0:11:11.16,0:11:13.96,Default,,0,0,0,,Сонымен... жарайды
Dialogue: 0,0:11:17.23,0:11:19.84,Default,,0,0,0,,Маған сүйенбейсің бе?
Dialogue: 0,0:11:19.84,0:11:22.34,Default,,0,0,0,,Олай болса, кешіріңіз.
Dialogue: 0,0:11:23.34,0:11:26.01,Default,,0,0,0,,Иа, үлпілдек...
Dialogue: 0,0:11:26.01,0:11:29.01,Default,,0,0,0,,<Бол... үрейленетін ештеңе жоқ>
Dialogue: 0,0:11:29.01,0:11:33.51,Default,,0,0,0,,＜Өйткені Шимамура қыз, мен де әйелмін＞
Dialogue: 0,0:11:39.09,0:11:41.36,Default,,0,0,0,,Ши… Шимамура
Dialogue: 0,0:11:41.36,0:11:43.46,Default,,0,0,0,,(Симамураның ұйқысы)
Dialogue: 0,0:11:46.70,0:11:49.90,Default,,0,0,0,,<Тамақ ішкеннен кейін бірден ұйықтайсыз ба...>
Dialogue: 0,0:11:55.30,0:11:57.37,Default,,0,0,0,,(есік ашылады)
Dialogue: 0,0:11:57.37,0:11:59.37,Default,,0,0,0,,Ах
Dialogue: 0,0:12:00.38,0:12:02.38,Default,,0,0,0,,Хмм?
Dialogue: 0,0:12:02.38,0:12:07.38,Default,,0,0,0,,Не болды? Ағаш киім әкел
Dialogue: 0,0:12:07.38,0:12:09.82,Default,,0,0,0,,А, ванна?
Dialogue: 0,0:12:09.82,0:12:13.82,Default,,0,0,0,,Бірінші кіргіңіз келе ме? Бұл сирек
Dialogue: 0,0:12:13.82,0:12:16.66,Default,,0,0,0,,Әпке, менімен бірге кіріңіз.
Dialogue: 0,0:12:16.66,0:12:18.99,Default,,0,0,0,,Иә? не? кенеттен
Dialogue: 0,0:12:18.99,0:12:21.00,Default,,0,0,0,,Сіз бұрын ұялшақ едіңіз.
Dialogue: 0,0:12:21.00,0:12:24.33,Default,,0,0,0,,Анда-санда жарайды. Жүр, кеттік.
Dialogue: 0,0:12:24.33,0:12:28.40,Default,,0,0,0,,Е, сәл күте тұрыңыз...
Dialogue: 0,0:12:28.40,0:12:30.90,Default,,0,0,0,,Жарайды, мен барамын.
Dialogue: 0,0:12:34.18,0:12:36.18,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:39.85,0:12:42.35,Default,,0,0,0,,Шимамура
Dialogue: 0,0:12:42.35,0:12:45.85,Default,,0,0,0,,Алаңдамаңыз~ Ха... Иә.
Dialogue: 0,0:12:47.69,0:12:51.53,Default,,0,0,0,,Мазалағаным үшін кешіріңіз. Мен қазір үйдемін.
Dialogue: 0,0:12:51.53,0:12:54.96,Default,,0,0,0,,О, Адачи-чан? Иә... иә
Dialogue: 0,0:12:54.96,0:12:57.97,Default,,0,0,0,,Окаока Қош келдіңіз~
Dialogue: 0,0:12:57.97,0:13:00.80,Default,,0,0,0,,Мен... үйге енді келдім.
Dialogue: 0,0:13:00.80,0:13:04.87,Default,,0,0,0,,Ол сыртқа шығатынын айтты. Ол дүкенге баратынын айтты.
Dialogue: 0,0:13:04.87,0:13:06.88,Default,,0,0,0,,Эден академиясының нәтижелері.
Dialogue: 0,0:13:06.88,0:13:11.88,Default,,0,0,0,,Мен көп ұзамай келемін, сен алаңдайсың.
Dialogue: 0,0:13:12.88,0:13:17.15,Default,,0,0,0,,Жарайды, бала кезімнен ұйқым қашады.
Dialogue: 0,0:13:17.15,0:13:20.85,Default,,0,0,0,,Ол шынымен коала сияқты ұйықтады.
Dialogue: 0,0:13:22.49,0:13:26.39,Default,,0,0,0,,А, дұрыс. Менің балам мектепте қалай жүр?
Dialogue: 0,0:13:27.33,0:13:30.33,Default,,0,0,0,,Сіз сабаққа дұрыс қатысасыз ба? Иә... иә
Dialogue: 0,0:13:30.33,0:13:35.17,Default,,0,0,0,,Бұл жақсы болар еді, бірақ бұл бала мазалайды.
Dialogue: 0,0:13:35.17,0:13:37.24,Default,,0,0,0,,Оны тарту қиын, солай емес пе?
Dialogue: 0,0:13:37.24,0:13:41.24,Default,,0,0,0,,Е, жоқ, бұл мүлдем керісінше.
Dialogue: 0,0:13:41.24,0:13:44.51,Default,,0,0,0,,Кері? Мен әрқашан жетекшімін
Dialogue: 0,0:13:44.51,0:13:47.35,Default,,0,0,0,,Қорғасын? болды
Dialogue: 0,0:13:47.35,0:13:49.35,Default,,0,0,0,,О, бұл таңқаларлық.
Dialogue: 0,0:13:49.35,0:13:53.52,Default,,0,0,0,,Мен үйдемін~ Эй, Адачи, қош келдің~
Dialogue: 0,0:13:53.52,0:13:56.79,Default,,0,0,0,,Мен қазір үйдемін.
Dialogue: 0,0:13:56.79,0:14:01.63,Default,,0,0,0,,Біз бірге жақсы данго уақытын өткіздік. Біртүрлі нәрсе айттыңыз ба?
Dialogue: 0,0:14:01.63,0:14:03.63,Default,,0,0,0,,кекекекеке
Dialogue: 0,0:14:04.63,0:14:08.30,Default,,0,0,0,,Хмм, екінші қабатқа барсам болады ма?
Dialogue: 0,0:14:08.30,0:14:10.31,Default,,0,0,0,,Ах
Dialogue: 0,0:14:10.31,0:14:12.31,Default,,0,0,0,,<Осылай қараңыз>
Dialogue: 0,0:14:12.31,0:14:16.14,Default,,0,0,0,,<"Қорғасын" өрнегі дұрыс болуы мүмкін>
Dialogue: 0,0:14:16.14,0:14:19.48,Default,,0,0,0,,<Мен тура Шимамураның иті сияқтымын>
Dialogue: 0,0:14:19.48,0:14:21.98,Default,,0,0,0,,<Себебі мен оның артынан қуып келемін>
Dialogue: 0,0:14:21.98,0:14:26.32,Default,,0,0,0,,А, отыр... Иә.
Dialogue: 0,0:14:26.32,0:14:29.99,Default,,0,0,0,,Ал, басыңды иіп, сәл еңкей.
Dialogue: 0,0:14:29.99,0:14:32.83,Default,,0,0,0,,Бұл не... сияқты?
Dialogue: 0,0:14:32.83,0:14:35.33,Default,,0,0,0,,Оны сол күйінде қалдырыңыз.
Dialogue: 0,0:14:39.84,0:14:43.84,Default,,0,0,0,,Хмм, осылай істе
Dialogue: 0,0:14:47.51,0:14:51.18,Default,,0,0,0,,Міне.
Dialogue: 0,0:14:51.18,0:14:54.62,Default,,0,0,0,,Мм, мен сияқты шаш үлгісі.
Dialogue: 0,0:14:54.62,0:14:56.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:57.69,0:15:00.96,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:15:00.96,0:15:03.46,Default,,0,0,0,,Иә, ә
Dialogue: 0,0:15:03.46,0:15:05.53,Default,,0,0,0,,Өйткені қазір шашымыздың түстері ұқсас
Dialogue: 0,0:15:05.53,0:15:09.03,Default,,0,0,0,,Мен сенің де мен сияқты боламын деп ойладым.
Dialogue: 0,0:15:11.80,0:15:14.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:14.64,0:15:17.14,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:17.14,0:15:20.14,Default,,0,0,0,,Бір қызығы, олар бір-біріне ұқсамайды.
Dialogue: 0,0:15:20.14,0:15:23.48,Default,,0,0,0,,Аа, дұрыс, мен саған шаш қыстырғышты беремін.
Dialogue: 0,0:15:23.48,0:15:25.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:25.48,0:15:27.55,Default,,0,0,0,,<Бұл>
Dialogue: 0,0:15:27.55,0:15:30.32,Default,,0,0,0,,<Бұл...>
Dialogue: 0,0:15:30.32,0:15:34.62,Default,,0,0,0,,<Бұл олардың сәйкес келетінін білдірмейді ме?>
Dialogue: 0,0:15:44.00,0:15:46.84,Default,,0,0,0,,...
Dialogue: 0,0:15:46.84,0:15:50.51,Default,,0,0,0,,Шимамура...
Dialogue: 0,0:15:50.51,0:15:53.44,Default,,0,0,0,,Шимамурага
Dialogue: 0,0:15:53.44,0:15:56.45,Default,,0,0,0,,Шу…
Dialogue: 0,0:15:56.45,0:15:59.85,Default,,0,0,0,,Өшіріңіз!
Dialogue: 0,0:16:01.78,0:16:03.79,Default,,0,0,0,,Шаттл
Dialogue: 0,0:16:03.79,0:16:06.62,Default,,0,0,0,,Керемет Иә
Dialogue: 0,0:16:06.62,0:16:10.12,Default,,0,0,0,,Сондай-ақ, мен бұрын осындай нәрсені жасадым.
Dialogue: 0,0:16:11.29,0:16:13.29,Default,,0,0,0,,Иә
Dialogue: 0,0:16:17.97,0:16:21.67,Default,,0,0,0,,Поо... Хмм, қызық.
Dialogue: 0,0:16:22.64,0:16:25.14,Default,,0,0,0,,Не? Нён беті
Dialogue: 0,0:16:25.14,0:16:28.98,Default,,0,0,0,,Сонымен... бұл жақсы, бірақ иә?
Dialogue: 0,0:16:28.98,0:16:31.48,Default,,0,0,0,,Шимамура Иә
Dialogue: 0,0:16:33.82,0:16:37.82,Default,,0,0,0,,Бүгін... Иә?
Dialogue: 0,0:16:37.82,0:16:40.82,Default,,0,0,0,,Бүгін менімен ұйықтағың келе ме?
Dialogue: 0,0:16:41.89,0:16:45.49,Default,,0,0,0,,Маған бәрібір, бірақ иә?
Dialogue: 0,0:16:45.49,0:16:47.56,Default,,0,0,0,,<Оңай>
Dialogue: 0,0:16:47.56,0:16:50.57,Default,,0,0,0,,<Олай болса>
Dialogue: 0,0:16:50.57,0:16:55.37,Default,,0,0,0,,<Мен оны кеше де ұсынуым керек еді! ＞
Dialogue: 0,0:16:58.27,0:17:02.94,Default,,0,0,0,,Бірақ жақсы ма? Не?
Dialogue: 0,0:17:02.94,0:17:06.62,Default,,0,0,0,,Шимамураның әпкесі жалғыз ұйықтайды.
Dialogue: 0,0:17:06.62,0:17:08.62,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:08.62,0:17:12.62,Default,,0,0,0,,Бүгін сол жерде менің де досым бар.
Dialogue: 0,0:17:14.69,0:17:17.29,Default,,0,0,0,,Шо-сан (Шимамура Имуто) Иә?
Dialogue: 0,0:17:17.29,0:17:21.36,Default,,0,0,0,,Шо мырзаға ғаламды үйретейік.
Dialogue: 0,0:17:21.36,0:17:25.37,Default,,0,0,0,,Хмм... бос орын? Иә.
Dialogue: 0,0:17:25.37,0:17:30.81,Default,,0,0,0,,Біріншіден, менің отбасымның орташа өмір сүру ұзақтығы шамамен 800 миллион жыл.
Dialogue: 0,0:17:30.81,0:17:36.48,Default,,0,0,0,,Мен салыстырмалы түрде ұзақ өмір сүретін түрге жататынмын, бірақ...
Dialogue: 0,0:17:36.48,0:17:39.38,Default,,0,0,0,,Содан кейін мен оны жоямын. Иә.
Dialogue: 0,0:17:40.48,0:17:44.18,Default,,0,0,0,,Қайырлы түн ~ Қайырлы түн
Dialogue: 0,0:17:55.56,0:17:58.26,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:18:24.86,0:18:27.93,Default,,0,0,0,,Хмм... мм.
Dialogue: 0,0:18:27.93,0:18:30.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:30.37,0:18:32.87,Default,,0,0,0,,Не болды? Ах!
Dialogue: 0,0:18:32.87,0:18:36.37,Default,,0,0,0,,Хмм... Мен оны шынымен ұйықтап жатыр деп ойладым.
Dialogue: 0,0:18:36.37,0:18:40.04,Default,,0,0,0,,Жарайды, ұйықтайсың. Менде футон бар.
Dialogue: 0,0:18:40.04,0:18:42.38,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:18:42.38,0:18:45.45,Default,,0,0,0,,<Мен Шимамура екеуінің арасын ұзартқым келмейді>
Dialogue: 0,0:18:45.45,0:18:50.45,Default,,0,0,0,,<3 2 1 Батылдық баруға бұйырады>
Dialogue: 0,0:18:50.45,0:18:54.45,Default,,0,0,0,,<Батылдық алға тартып, тепкілейді>
Dialogue: 0,0:18:57.16,0:18:59.36,Default,,0,0,0,,Ах! Уау
Dialogue: 0,0:19:01.23,0:19:04.33,Default,,0,0,0,,Ұшатын жәндік сияқты құлады.
Dialogue: 0,0:19:07.17,0:19:10.01,Default,,0,0,0,,Бірге ұйықтайық ба?
Dialogue: 0,0:19:10.01,0:19:15.21,Default,,0,0,0,,Ғалам - бұл ғалам
Dialogue: 0,0:19:16.68,0:19:20.18,Default,,0,0,0,,Әпкеңнің қол жастығы ше?
Dialogue: 0,0:19:20.18,0:19:22.18,Default,,0,0,0,,Жоқ... не?
Dialogue: 0,0:19:22.18,0:19:24.38,Default,,0,0,0,,Мен жылағым келеді
Dialogue: 0,0:19:26.52,0:19:31.36,Default,,0,0,0,,Шаш әлі де сәл дымқыл Иә.
Dialogue: 0,0:19:31.36,0:19:36.70,Default,,0,0,0,,Ылғалды жылу ерекше және жақсы сезінеді, солай емес пе?
Dialogue: 0,0:19:36.70,0:19:39.70,Default,,0,0,0,,Мен қазір қолымды тартып аламын ба?
Dialogue: 0,0:19:39.70,0:19:43.20,Default,,0,0,0,,Қашанға дейін?
Dialogue: 0,0:19:43.20,0:19:46.21,Default,,0,0,0,,Мен ұйықтағанша
Dialogue: 0,0:19:46.21,0:19:48.28,Default,,0,0,0,,Қандай үмітсіз бала.
Dialogue: 0,0:19:48.28,0:19:50.88,Default,,0,0,0,,Ойланып қарашы, мен ертең орын ауыстырамын.
Dialogue: 0,0:19:50.88,0:19:53.38,Default,,0,0,0,,Ә? Шынында ма?
Dialogue: 0,0:19:53.38,0:19:57.32,Default,,0,0,0,,А, Адачи әлсіреп қалды, сондықтан мен тыңдамадым.
Dialogue: 0,0:19:57.32,0:19:59.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:59.32,0:20:01.39,Default,,0,0,0,,Иә? Адачи?
Dialogue: 0,0:20:01.39,0:20:04.99,Default,,0,0,0,,Осылай жақын болғанымызды қалаймын.
Dialogue: 0,0:20:04.99,0:20:10.19,Default,,0,0,0,,Ал, егер бұл жақын болса, онда мәселе көп.
Dialogue: 0,0:20:12.67,0:20:15.37,Default,,0,0,0,,Ол қандай болса, солай болады.
Dialogue: 0,0:20:21.68,0:20:25.35,Default,,0,0,0,,Ертең де бірге түскі ас ішейік.
Dialogue: 0,0:20:25.35,0:20:27.35,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:20:27.35,0:20:30.19,Default,,0,0,0,,Сондықтан тыныш ұйықтаңыз.
Dialogue: 0,0:20:30.19,0:20:32.69,Default,,0,0,0,,Иә
Dialogue: 0,0:20:32.69,0:20:36.39,Default,,0,0,0,,Қайырлы түн Адачи
Dialogue: 0,0:20:37.53,0:20:39.53,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:20:50.61,0:20:53.04,Default,,0,0,0,,Кеттік
Dialogue: 0,0:20:53.04,0:20:55.24,Default,,0,0,0,,Күте тұр, кішкентай қыз.
Dialogue: 0,0:20:56.21,0:20:59.48,Default,,0,0,0,,Мұны өзіңізбен бірге алыңыз.
Dialogue: 0,0:20:59.48,0:21:03.99,Default,,0,0,0,,Не? Сіз мұны көрмейсіз бе?
Dialogue: 0,0:21:03.99,0:21:06.82,Default,,0,0,0,,Түскі ас Фуккатсу!
Dialogue: 0,0:21:06.82,0:21:11.12,Default,,0,0,0,,Кенеттен не болды? О, өте қиын!
Dialogue: 0,0:21:14.66,0:21:17.00,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:21:17.00,0:21:20.34,Default,,0,0,0,,Бұл сіздің мектепке бірінші рет бірге баруыңыз емес пе?
Dialogue: 0,0:21:20.34,0:21:22.64,Default,,0,0,0,,(үшін төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:21:30.18,0:21:43.02,Default,,0,0,0,,《Мен Шимамурадағы орынның жанында бола аламын деп үміттенемін》
Dialogue: 0,0:21:43.02,0:21:45.22,Default,,0,0,0,,《Симамура...》
Dialogue: 0,0:21:46.53,0:21:48.53,Default,,0,0,0,,<Намаз дегеніміз не>
Dialogue: 0,0:21:48.53,0:21:51.53,Default,,0,0,0,,<Шындықпен қаншалықты жақсы бетпе-бет келуге болады?>
Dialogue: 0,0:21:52.87,0:21:56.30,Default,,0,0,0,,Адачи асыға күтіңіз Ах...
Dialogue: 0,0:21:56.30,0:21:59.37,Default,,0,0,0,,<Оның әсер ету дәрежесін білуді қосқанда>
Dialogue: 0,0:21:59.37,0:22:01.37,Default,,0,0,0,,<Мен нәтижелерді асыға күтемін>
Dialogue: 0,0:22:05.31,0:22:09.15,Default,,0,0,0,,<Мм, бұл өте қарапайым көрінеді>
Dialogue: 0,0:22:09.15,0:22:12.15,Default,,0,0,0,,<Біз өте жақын емеспіз.>
Dialogue: 0,0:22:12.15,0:22:15.35,Default,,0,0,0,,<Өте алыс емес>
Dialogue: 0,0:22:18.49,0:22:20.56,Default,,0,0,0,,<Екінші жыл басталғаннан кейін>
Dialogue: 0,0:22:20.56,0:22:24.83,Default,,0,0,0,,<Көзімді жұмғанша бір ай өтті>
Dialogue: 0,0:22:24.83,0:22:29.50,Default,,0,0,0,,<Жоғары сынып оқушылары үшін сәуір тағы бір рет келеді>
Dialogue: 0,0:22:29.50,0:22:32.51,Default,,0,0,0,,<Мамырдың өзінде, маусымның өзінде>
Dialogue: 0,0:22:32.51,0:22:35.34,Default,,0,0,0,,<Күнделікті алаңсыз өткізуге болатын уақыт>
Dialogue: 0,0:22:35.34,0:22:37.68,Default,,0,0,0,,<Бұл сөзсіз шексіз емес>
Dialogue: 0,0:22:37.68,0:22:41.48,Default,,0,0,0,,Ммммм!
Dialogue: 0,0:22:42.52,0:22:45.52,Default,,0,0,0,,<Бір күні, иә, бір күні>
Dialogue: 0,0:22:45.52,0:22:48.19,Default,,0,0,0,,<Сен оны анық елестете алмасаң да>
Dialogue: 0,0:22:48.19,0:22:52.53,Default,,0,0,0,,<Еріксіз болашақ: Көктемгі үзіліссіз әлем>
Dialogue: 0,0:22:52.53,0:22:56.70,Default,,0,0,0,,<Мүмкін қасыңда ешкім жоқ болашақ>
Dialogue: 0,0:22:56.70,0:22:58.70,Default,,0,0,0,,<Мен де>
Dialogue: 0,0:22:58.70,0:23:01.97,Default,,0,0,0,,<Қаламасам да, гүлдеген шие гүлдеріне қарап>
Dialogue: 0,0:23:01.97,0:23:05.17,Default,,0,0,0,,<Көктемнің жолымен жүретін күн туар>
Dialogue: 0,0:23:08.81,0:23:10.81,Default,,0,0,0,,Шимамура!
Dialogue: 0,0:23:16.89,0:23:23.16,Default,,0,0,0,,<Оған дейін дәл алдыңызда жайқалған шие гүлдеріне қанағаттану жаман емес.>
Dialogue: 0,0:23:23.16,0:23:26.16,Default,,0,0,0,,<Жаман емес екеніне көз жеткізіңіз>
Dialogue: 0,0:23:27.23,0:23:32.17,Default,,0,0,0,,<Сәуір айының соңында шие гүлдері енді еш жерде гүлдемейді.>
Dialogue: 0,0:23:32.17,0:23:37.37,Default,,0,0,0,,<Сондықтан мен Адачиден шие гүлдерін сұраймын>
Dialogue: 0,0:23:45.51,0:23:49.01,Default,,0,0,0,,<Мен бұл профильге сенімдімін...>
Dialogue: 0,0:23:50.51,0:23:56.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
