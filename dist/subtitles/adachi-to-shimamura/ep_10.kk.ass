Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.79,0:00:13.30,Default,,0,0,0,,<(Адачи) Осыдан тура бір жыл бұрын кіру рәсімі өткен күн>
Dialogue: 0,0:00:13.30,0:00:16.63,Default,,0,0,0,,<Сыныптың классификациялық жұмыстары хабарландыру тақтасында ілінеді>
Dialogue: 0,0:00:16.63,0:00:19.83,Default,,0,0,0,,<Жаңа студенттер көп жиналған кезде>
Dialogue: 0,0:00:20.70,0:00:22.71,Default,,0,0,0,,<Дәл мен сияқты>
Dialogue: 0,0:00:22.71,0:00:26.31,Default,,0,0,0,,<Көптен қашық жүретін бір қыз болды>
Dialogue: 0,0:00:26.31,0:00:30.81,Default,,0,0,0,,<Ол кезде мен көрген адам Шимамура болатын>
Dialogue: 0,0:00:30.81,0:00:33.15,Default,,0,0,0,,<Әрине ол кезде мен болдым>
Dialogue: 0,0:00:33.15,0:00:35.99,Default,,0,0,0,,<Мені басқа адамдар қызықтырмайды>
Dialogue: 0,0:00:35.99,0:00:39.82,Default,,0,0,0,,<Мен тіпті: «Маған қарама» деп ойладым.
Dialogue: 0,0:00:39.82,0:00:41.89,Default,,0,0,0,,<Содан бері бір жыл өтті>
Dialogue: 0,0:00:41.89,0:00:45.39,Default,,0,0,0,,<Симамура да, мен де екінші курс студенті болдық>
Dialogue: 0,0:00:49.50,0:00:52.57,Default,,0,0,0,,<Бұл дүниеде Құдай бар ма?>
Dialogue: 0,0:00:52.57,0:00:57.34,Default,,0,0,0,,<Менің үнсіз дұғамды еститін нәрсе бар ма?>
Dialogue: 0,0:00:57.34,0:01:00.01,Default,,0,0,0,,Біз тағы да біргеміз бе? Қанша жыл?
Dialogue: 0,0:01:00.01,0:01:04.01,Default,,0,0,0,,10 жылға жуық? Қалғанының бәрі біршама бұзылды.
Dialogue: 0,0:01:04.01,0:01:06.95,Default,,0,0,0,,Шимамура т.б.
Dialogue: 0,0:01:06.95,0:01:09.79,Default,,0,0,0,,<Егер сыныптар бөлек болса>
Dialogue: 0,0:01:09.79,0:01:14.12,Default,,0,0,0,,<Симамура менімен кездесуге әуре болмайтын шығар>
Dialogue: 0,0:01:14.12,0:01:17.46,Default,,0,0,0,,<Егер мен сізге барсам, бас тартпайтыныңызға сенімдімін.>
Dialogue: 0,0:01:17.46,0:01:19.80,Default,,0,0,0,,<Бірақ мен өз бетімше қозғалмаймын>
Dialogue: 0,0:01:19.80,0:01:21.80,Default,,0,0,0,,<Симамура сонда>
Dialogue: 0,0:01:21.80,0:01:24.80,Default,,0,0,0,,<Себебі мен саған керек емеспін>
Dialogue: 0,0:01:26.87,0:01:31.88,Default,,0,0,0,,<Мен мақтауға лайық жақсы адам емеспін.>
Dialogue: 0,0:01:31.88,0:01:34.31,Default,,0,0,0,,<Сұрағаныңызды ала аласыз>
Dialogue: 0,0:01:34.31,0:01:38.11,Default,,0,0,0,,<Мен оған лайықты ештеңе жинадым деп ойламаймын.>
Dialogue: 0,0:01:39.15,0:01:43.99,Default,,0,0,0,,<Бірақ бұл дүниеде Құдай бар ма?>
Dialogue: 0,0:01:43.99,0:01:48.49,Default,,0,0,0,,<Менің үнсіз дұғамды еститін нәрсе бар ма?>
Dialogue: 0,0:01:49.83,0:01:52.83,Default,,0,0,0,,<Тілеймін, сұраймын>
Dialogue: 0,0:01:52.83,0:01:55.93,Default,,0,0,0,,<Арқаны созып, ат қой...>
Dialogue: 0,0:01:58.34,0:02:00.34,Default,,0,0,0,,О
Dialogue: 0,0:02:00.34,0:02:05.28,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:02:05.28,0:02:09.11,Default,,0,0,0,,Ахаха... Иә! Алақай!
Dialogue: 0,0:02:09.11,0:02:11.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:45.21,0:03:50.02,Default,,0,0,0,,<Екінші курс студенті болған кезде шашымды бұрынғы түсіне ауыстырдым.>
Dialogue: 0,0:03:50.02,0:03:52.02,Default,,0,0,0,,<Жаңа сабақтарда>
Dialogue: 0,0:03:52.02,0:03:54.89,Default,,0,0,0,,<Сыныптастарым мен отыру тәртібі өзгерсе де>
Dialogue: 0,0:03:54.89,0:04:00.09,Default,,0,0,0,,<Әдеттегідей тек Адачи ғана алдымда>
Dialogue: 0,0:04:01.96,0:04:04.90,Default,,0,0,0,,Адачидің аты Сакура?
Dialogue: 0,0:04:04.90,0:04:07.73,Default,,0,0,0,,Иә, сіз мұны бұрын естідіңіз бе?
Dialogue: 0,0:04:07.73,0:04:10.57,Default,,0,0,0,,А... А, мүмкін.
Dialogue: 0,0:04:10.57,0:04:12.64,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:04:12.64,0:04:15.58,Default,,0,0,0,,Я~
Dialogue: 0,0:04:15.58,0:04:18.08,Default,,0,0,0,,Сакура-чан, ә! ?
Dialogue: 0,0:04:18.08,0:04:20.58,Default,,0,0,0,,Әлде Сакура-сан ба?
Dialogue: 0,0:04:20.58,0:04:22.58,Default,,0,0,0,,А...
Dialogue: 0,0:04:23.58,0:04:26.65,Default,,0,0,0,,Не болды? Адачи: Жарайды...
Dialogue: 0,0:04:26.65,0:04:29.66,Default,,0,0,0,,Бол... Әсіресе бұл...
Dialogue: 0,0:04:29.66,0:04:32.09,Default,,0,0,0,,Хмм, аа
Dialogue: 0,0:04:32.09,0:04:36.16,Default,,0,0,0,,А... жоқ, не...?
Dialogue: 0,0:04:36.16,0:04:39.60,Default,,0,0,0,,Ештеңе емес, мен Адачиге қарап тұрдым.
Dialogue: 0,0:04:39.60,0:04:43.44,Default,,0,0,0,,Сонымен... иә, мен.
Dialogue: 0,0:04:43.44,0:04:45.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:49.28,0:04:51.78,Default,,0,0,0,,Адачи, сен неге менің соңымнан жүрсің?
Dialogue: 0,0:04:51.78,0:04:55.28,Default,,0,0,0,,Иә? Бұл...
Dialogue: 0,0:04:56.22,0:04:59.22,Default,,0,0,0,,Өйткені бұл велосипед!
Dialogue: 0,0:04:59.22,0:05:01.89,Default,,0,0,0,,Міне... Солай...
Dialogue: 0,0:05:01.89,0:05:04.89,Default,,0,0,0,,Ахахаха... Шимамура?
Dialogue: 0,0:05:04.89,0:05:08.73,Default,,0,0,0,,Адачи кейде итке ұқсайды.
Dialogue: 0,0:05:08.73,0:05:10.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:10.73,0:05:13.07,Default,,0,0,0,,《Бір》
Dialogue: 0,0:05:13.07,0:05:16.14,Default,,0,0,0,,Жоқ, мүлде емес пе?
Dialogue: 0,0:05:16.14,0:05:19.57,Default,,0,0,0,,Мен... мен велосипедімді аламын.
Dialogue: 0,0:05:19.57,0:05:23.87,Default,,0,0,0,,<Мен иттерді жақсы көремін, дегенмен>
Dialogue: 0,0:05:24.91,0:05:29.25,Default,,0,0,0,,Бұл әлі үлкен үй →
Dialogue: 0,0:05:29.25,0:05:36.09,Default,,0,0,0,,...
Dialogue: 0,0:05:36.09,0:05:38.09,Default,,0,0,0,,Бұл көңілді ме?
Dialogue: 0,0:05:38.09,0:05:41.39,Default,,0,0,0,,Татами төсеніштерінің иісі керемет, солай емес пе?
Dialogue: 0,0:05:42.76,0:05:45.10,Default,,0,0,0,,Маған айтқандай, мен киімімді ауыстырдым.
Dialogue: 0,0:05:45.10,0:05:47.17,Default,,0,0,0,,Бұл жақсы, солай ма?
Dialogue: 0,0:05:47.17,0:05:49.67,Default,,0,0,0,,О!
Dialogue: 0,0:05:52.11,0:05:54.54,Default,,0,0,0,,Иә? Иә?
Dialogue: 0,0:05:54.54,0:05:56.84,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:06:05.39,0:06:08.05,Default,,0,0,0,,Хино сүйкімді
Dialogue: 0,0:06:08.05,0:06:10.06,Default,,0,0,0,,Не... Кенеттен не болды?
Dialogue: 0,0:06:10.06,0:06:13.06,Default,,0,0,0,,Мен сені көргенде солай ойладым...
Dialogue: 0,0:06:13.06,0:06:15.73,Default,,0,0,0,,Енді мен де киімімді ауыстыруым керек сияқты.
Dialogue: 0,0:06:15.73,0:06:17.80,Default,,0,0,0,,О? Киім ауыстыру?
Dialogue: 0,0:06:17.80,0:06:21.23,Default,,0,0,0,,Бүгін Хиноның үйінде болуды жоспарлап отырсыз ба?
Dialogue: 0,0:06:21.23,0:06:23.24,Default,,0,0,0,,Иә? қалу?
Dialogue: 0,0:06:23.24,0:06:27.07,Default,,0,0,0,,Үй үлкен, мен аралассам да, байқамайсың.→
Dialogue: 0,0:06:27.07,0:06:31.14,Default,,0,0,0,,Иә, иә, бұл сенсің, алдымен айт.
Dialogue: 0,0:06:31.14,0:06:33.15,Default,,0,0,0,,Олай десеңіз, мен қарсы боламын.
Dialogue: 0,0:06:33.15,0:06:36.08,Default,,0,0,0,,Сіз жақсырақ білуіңіз керек, солай емес пе?
Dialogue: 0,0:06:36.08,0:06:38.92,Default,,0,0,0,,Акира, жақсысың ба? →
Dialogue: 0,0:06:38.92,0:06:41.99,Default,,0,0,0,,О, мм, бұл Тэ Сан болды, солай ма?
Dialogue: 0,0:06:41.99,0:06:45.93,Default,,0,0,0,,Дұрыс, дұрыс, сен Тэкосың.
Dialogue: 0,0:06:45.93,0:06:47.93,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:06:47.93,0:06:49.93,Default,,0,0,0,,Сонда не?
Dialogue: 0,0:06:49.93,0:06:52.00,Default,,0,0,0,,Егер сіз киіміңізді ауыстырып жатсаңыз, бұл жақсы.
Dialogue: 0,0:06:52.00,0:06:54.87,Default,,0,0,0,,Тұтынушыларыңызбен де сәлемдесу
Dialogue: 0,0:06:54.87,0:06:58.20,Default,,0,0,0,,Иә~ Мен де қатыстым ба?
Dialogue: 0,0:06:58.20,0:07:01.00,Default,,0,0,0,,Сіз де осы отбасының баласы болуыңыз керек.
Dialogue: 0,0:07:02.88,0:07:04.88,Default,,0,0,0,,Ахсо
Dialogue: 0,0:07:05.88,0:07:11.28,Default,,0,0,0,,Аа, мен мұндай нәрсеге байланысты үйге ерте барғым келмейді.
Dialogue: 0,0:07:19.39,0:07:21.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:21.46,0:07:25.40,Default,,0,0,0,,Шимамура-сан, солай ма? Иә иә
Dialogue: 0,0:07:25.40,0:07:29.24,Default,,0,0,0,,Қаласаңыз, бізбен түскі ас ішуді қалайсыз ба?
Dialogue: 0,0:07:29.24,0:07:32.24,Default,,0,0,0,,Иә?Ах... бұл...
Dialogue: 0,0:07:32.24,0:07:34.24,Default,,0,0,0,,Уәде бар ма?
Dialogue: 0,0:07:34.24,0:07:37.31,Default,,0,0,0,,Жақсы, олай емес.
Dialogue: 0,0:07:37.31,0:07:41.25,Default,,0,0,0,,Орнымызға бірге отырсақ жақсы болар еді.
Dialogue: 0,0:07:41.25,0:07:43.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:46.75,0:07:49.82,Default,,0,0,0,,Олай болса... онда иә!
Dialogue: 0,0:07:49.82,0:07:51.82,Default,,0,0,0,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,0:07:51.82,0:07:54.53,Default,,0,0,0,,Олай болса мұнда келіңіз, Шимамура мырза.
Dialogue: 0,0:07:54.53,0:07:57.23,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:07:59.87,0:08:03.20,Default,,0,0,0,,О, бұл менің түскі ас қорабым емес.
Dialogue: 0,0:08:03.20,0:08:06.21,Default,,0,0,0,,Мен оны сатып аламын.
Dialogue: 0,0:08:06.21,0:08:08.31,Default,,0,0,0,,Иә? Эх...
Dialogue: 0,0:08:11.04,0:08:13.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:13.11,0:08:15.88,Default,,0,0,0,,<Адачи…>
Dialogue: 0,0:08:15.88,0:08:17.95,Default,,0,0,0,,Барлығыңыз біраз уақыт жақын болдыңыз ба?
Dialogue: 0,0:08:17.95,0:08:20.95,Default,,0,0,0,,Жоқ, екінші курс студенті болғаннан бері.
Dialogue: 0,0:08:20.95,0:08:22.96,Default,,0,0,0,,Дұрыс, Шимамура-сан.
Dialogue: 0,0:08:22.96,0:08:24.96,Default,,0,0,0,,Сізде үйірме жұмыстары бар ма?
Dialogue: 0,0:08:24.96,0:08:28.56,Default,,0,0,0,,Жоқ, мүлде емес. Е, таңқаларлық→
Dialogue: 0,0:08:28.56,0:08:30.63,Default,,0,0,0,,Мен жарық бөліміндемін.
Dialogue: 0,0:08:30.63,0:08:33.63,Default,,0,0,0,,<Үшеуі бірден өздерін таныстырды>
Dialogue: 0,0:08:33.63,0:08:36.40,Default,,0,0,0,,<Тым тез сөйлегендіктен түсіне алмадым>
Dialogue: 0,0:08:36.40,0:08:40.07,Default,,0,0,0,,<Әрине Панчо Санчо Делос>
Dialogue: 0,0:08:40.07,0:08:42.91,Default,,0,0,0,,<Осылай болды деп ойлаймын>
Dialogue: 0,0:08:42.91,0:08:46.98,Default,,0,0,0,,<Ендеше, бұл саяхатшы ойын-сауық тобының бір түрі.>
Dialogue: 0,0:08:46.98,0:08:49.58,Default,,0,0,0,,<Бұлай атауға болмайды>
Dialogue: 0,0:08:49.58,0:08:52.92,Default,,0,0,0,,<Бұдан кейін бос әңгіме жалғасты.>
Dialogue: 0,0:08:52.92,0:08:54.92,Default,,0,0,0,,<Шынымды айтсам, қайта ойласам да>
Dialogue: 0,0:08:54.92,0:08:58.32,Default,,0,0,0,,<Не туралы айтқанымды есіме түсіре алмадым>
Dialogue: 0,0:09:02.76,0:09:07.43,Default,,0,0,0,,Шимамура-сан, біз вокзал алдындағы кафеге барамыз.
Dialogue: 0,0:09:07.43,0:09:11.27,Default,,0,0,0,,Бірге ше? Эх...
Dialogue: 0,0:09:11.27,0:09:13.94,Default,,0,0,0,,Құймақ шынымен дәмді.
Dialogue: 0,0:09:13.94,0:09:17.01,Default,,0,0,0,,Дүкеннің атмосферасы да өте жақсы.
Dialogue: 0,0:09:17.01,0:09:19.61,Default,,0,0,0,,Сіз қалай ойлайсыз? Ах, мм
Dialogue: 0,0:09:19.61,0:09:21.81,Default,,0,0,0,,Бүгін аз...
Dialogue: 0,0:09:24.45,0:09:28.29,Default,,0,0,0,,<Сынып өзгерді, Хино мен Нагато да жоғалып кетті>
Dialogue: 0,0:09:28.29,0:09:31.62,Default,,0,0,0,,<Жаңа дос дүниеге келді>
Dialogue: 0,0:09:31.62,0:09:34.96,Default,,0,0,0,,<Ал, Хино мен Нагато қызық жігіттер>
Dialogue: 0,0:09:34.96,0:09:36.96,Default,,0,0,0,,<Сыныптарды ауыстырған кезде>
Dialogue: 0,0:09:36.96,0:09:40.36,Default,,0,0,0,,<Менің ойымша, олар бірге белсенді ойнауға жақын емес.>
Dialogue: 0,0:09:41.63,0:09:45.97,Default,,0,0,0,,<Артқа қарасам, жалғастырмаймын>
Dialogue: 0,0:09:45.97,0:09:48.47,Default,,0,0,0,,<Адамдық қарым-қатынасты әрең өткізіңіз>
Dialogue: 0,0:09:48.47,0:09:51.14,Default,,0,0,0,,＜Мүмкін ол жүрексіз адам＞
Dialogue: 0,0:09:51.14,0:09:54.58,Default,,0,0,0,,<Бірақ менің ойымша, бұл>
Dialogue: 0,0:09:54.58,0:09:57.65,Default,,0,0,0,,<Соғұрлым біз мәңгі бірге ағамыз>
Dialogue: 0,0:09:57.65,0:10:00.75,Default,,0,0,0,,<Қатты қарым-қатынас сирек кездеседі>
Dialogue: 0,0:10:02.42,0:10:05.26,Default,,0,0,0,,<Тағдыр өзеніне көп сіңсең>
Dialogue: 0,0:10:05.26,0:10:09.56,Default,,0,0,0,,<Байланыс та әлсіреп, үзіледі.>
Dialogue: 0,0:10:14.77,0:10:18.27,Default,,0,0,0,,<Адачидің сабаққа келмей қалуының себебі>
Dialogue: 0,0:10:18.27,0:10:21.57,Default,,0,0,0,,<Ол мерекеден кейінгі дүйсенбіде басталды>
Dialogue: 0,0:10:29.28,0:10:31.88,Default,,0,0,0,,<Мен баруым керек пе?>
Dialogue: 0,0:10:33.28,0:10:38.08,Default,,0,0,0,,<Адачи де мұны күтіп отырған шығар.>
Dialogue: 0,0:10:39.29,0:10:43.79,Default,,0,0,0,,＜Бірақ мен оны нашар көруге барсам және мұғалім оны байқаса ше?
Dialogue: 0,0:10:43.79,0:10:48.63,Default,,0,0,0,,Айтпақшы, Сашимамура-сан мен Адачи-сан жақсы достар ма?
Dialogue: 0,0:10:48.63,0:10:52.13,Default,,0,0,0,,Ух... иә, бәрібір біз жай ғана доспыз.
Dialogue: 0,0:10:52.13,0:10:56.07,Default,,0,0,0,,Дұрыс, мен сіздің бұл туралы өткен жылы біраз сөйлескеніңізді көрдім.
Dialogue: 0,0:10:56.07,0:10:59.14,Default,,0,0,0,,Бүгін суық тиіп қалдыңыз ба? Келіңіздер...
Dialogue: 0,0:10:59.14,0:11:03.08,Default,,0,0,0,,Мен Адачи мырзамен бір мектепте оқыдым.
Dialogue: 0,0:11:03.08,0:11:06.75,Default,,0,0,0,,Атмосфера әйтеуір өзгерді, солай емес пе?
Dialogue: 0,0:11:06.75,0:11:10.25,Default,,0,0,0,,Иә, бірақ мен сыныпта ешкіммен сөйлеспеймін.
Dialogue: 0,0:11:10.25,0:11:13.92,Default,,0,0,0,,Бірдеңе қиынырақ сезілді.
Dialogue: 0,0:11:13.92,0:11:16.42,Default,,0,0,0,,Менің ойымша, бүгінгі күнге дейін ұқсас.
Dialogue: 0,0:11:16.42,0:11:19.49,Default,,0,0,0,,Жоқ, бірдеңе дұрыс емес пе деп ойлаймын →
Dialogue: 0,0:11:19.49,0:11:23.50,Default,,0,0,0,,Мен тыныштық интеллектін сезінбейтін сияқтымын ...
Dialogue: 0,0:11:23.50,0:11:27.70,Default,,0,0,0,,<Қысқаша айтқанда, бұл тікенді емес сияқты.>
Dialogue: 0,0:11:28.77,0:11:31.60,Default,,0,0,0,,<Кем дегенде мен байланысқан адачи>
Dialogue: 0,0:11:31.60,0:11:33.67,Default,,0,0,0,,＜Тікенекті бермей＞
Dialogue: 0,0:11:33.67,0:11:36.61,Default,,0,0,0,,＜Ол жай ғана қатып, еңкейіп қалады＞
Dialogue: 0,0:11:36.61,0:11:41.11,Default,,0,0,0,,<Адачидің бас тартуы қатаң емес, қыңыр>
Dialogue: 0,0:11:42.11,0:11:44.12,Default,,0,0,0,,<Ақыр соңында, мен>
Dialogue: 0,0:11:44.12,0:11:47.62,Default,,0,0,0,,<Гимназияның екінші қабатын тексерген жоқ>
Dialogue: 0,0:11:48.62,0:11:59.40,Default,,0,0,0,,(Кіріс ұялы қоңырау)
Dialogue: 0,0:11:59.40,0:12:01.60,Default,,0,0,0,,Таруми…
Dialogue: 0,0:12:02.47,0:12:06.47,Default,,0,0,0,,～
Dialogue: 0,0:12:06.47,0:12:09.08,Default,,0,0,0,,Оссу Шима-чан
Dialogue: 0,0:12:09.08,0:12:12.91,Default,,0,0,0,,…
Dialogue: 0,0:12:12.91,0:12:15.75,Default,,0,0,0,,Бірде далаға шыққыңыз келе ме? иә?
Dialogue: 0,0:12:15.75,0:12:17.75,Default,,0,0,0,,...
Dialogue: 0,0:12:17.75,0:12:19.75,Default,,0,0,0,,...
Dialogue: 0,0:12:19.75,0:12:21.75,Default,,0,0,0,,...
Dialogue: 0,0:12:21.75,0:12:24.76,Default,,0,0,0,,А, мен бар күшімді саламын.
Dialogue: 0,0:12:24.76,0:12:27.06,Default,,0,0,0,,...
Dialogue: 0,0:12:28.76,0:12:32.26,Default,,0,0,0,,...
Dialogue: 0,0:12:32.26,0:12:35.60,Default,,0,0,0,,Иә, келесі сенбі ше?
Dialogue: 0,0:12:35.60,0:12:37.94,Default,,0,0,0,,...
Dialogue: 0,0:12:37.94,0:12:40.61,Default,,0,0,0,,～
Dialogue: 0,0:12:40.61,0:12:43.61,Default,,0,0,0,,А... анау Тару-чан?
Dialogue: 0,0:12:43.61,0:12:47.11,Default,,0,0,0,,Мен осылай жүруді ойлап жүрмін.
Dialogue: 0,0:12:47.11,0:12:50.12,Default,,0,0,0,,...
Dialogue: 0,0:12:50.12,0:12:54.29,Default,,0,0,0,,Сіз сабырлырақ нәрсені қалайсыз ба? · иә?
Dialogue: 0,0:12:54.29,0:12:56.72,Default,,0,0,0,,...
Dialogue: 0,0:12:56.72,0:12:58.72,Default,,0,0,0,,(Қоңырау жабылады)
Dialogue: 0,0:12:58.72,0:13:01.79,Default,,0,0,0,,Бұл жағынан батылдық таныту жақсы.
Dialogue: 0,0:13:01.79,0:13:04.73,Default,,0,0,0,,Әңгімелесейік. Әңгімелесейік →
Dialogue: 0,0:13:04.73,0:13:07.40,Default,,0,0,0,,Маған үлкен ванна ұнайды.
Dialogue: 0,0:13:07.40,0:13:11.07,Default,,0,0,0,,Маған сенің үйіңдей үлкен нәрсе ұнайды.
Dialogue: 0,0:13:11.07,0:13:14.57,Default,,0,0,0,,Бұл сәнді, бірақ үнемді.
Dialogue: 0,0:13:14.57,0:13:17.41,Default,,0,0,0,,Ол кішкентай үйлерді ұнататынын айтады.
Dialogue: 0,0:13:17.41,0:13:21.08,Default,,0,0,0,,көремін. Үй айырбастаймыз ба?
Dialogue: 0,0:13:21.08,0:13:25.08,Default,,0,0,0,,О~ Бұл жақсы.
Dialogue: 0,0:13:25.08,0:13:29.78,Default,,0,0,0,,Мен кетсем де, бәрібір ештеңе өзгермейді.
Dialogue: 0,0:13:41.43,0:13:43.63,Default,,0,0,0,,Ах
Dialogue: 0,0:13:49.44,0:13:51.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:54.45,0:13:57.05,Default,,0,0,0,,Маған анда-санда қол тигізуге рұқсат етіңіз
Dialogue: 0,0:13:57.05,0:14:00.39,Default,,0,0,0,,Хино Сізге ұнайды, солай ма? Ха...ха! ?
Dialogue: 0,0:14:00.39,0:14:02.39,Default,,0,0,0,,Мен жақсы адаммын.
Dialogue: 0,0:14:02.39,0:14:06.06,Default,,0,0,0,,Бірақ саусақтарыңызды көп қозғалтпаңыз
Dialogue: 0,0:14:06.06,0:14:10.06,Default,,0,0,0,,Бұл көңілді ме? Сондай-ақ... бұл жеткілікті
Dialogue: 0,0:14:10.06,0:14:12.13,Default,,0,0,0,,Рахмет... Уау!
Dialogue: 0,0:14:12.13,0:14:15.90,Default,,0,0,0,,Хино өте сүйкімді~
Dialogue: 0,0:14:15.90,0:14:20.24,Default,,0,0,0,,Сен мені қатты ұнатасың.
Dialogue: 0,0:14:20.24,0:14:22.74,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:22.74,0:14:24.74,Default,,0,0,0,,<Кездескенде не болар екен деп ойлаймын>
Dialogue: 0,0:14:24.74,0:14:27.84,Default,,0,0,0,,＜Егер мен солай ойлайтын болсам, бұл жақсы болмас еді＞
Dialogue: 0,0:14:28.81,0:14:33.42,Default,,0,0,0,,<Мен Адачимен жүргенде бұл туралы ойламаймын>
Dialogue: 0,0:14:33.42,0:14:36.32,Default,,0,0,0,,Менің ойымша, әртүрлі нәрселер бар.
Dialogue: 0,0:14:39.49,0:14:41.49,Default,,0,0,0,,Уау, бұл тез!
Dialogue: 0,0:14:41.49,0:14:45.76,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:14:45.76,0:14:49.27,Default,,0,0,0,,Бір минут күте тұрыңыз ха ха
Dialogue: 0,0:14:49.27,0:14:51.27,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:14:52.27,0:14:55.44,Default,,0,0,0,,<Қытай көйлегін киген адам түрі>
Dialogue: 0,0:14:55.44,0:14:58.14,Default,,0,0,0,,<Тек Адачи емес пе?>
Dialogue: 0,0:14:59.21,0:15:01.21,Default,,0,0,0,,Неге күлесің? иә?
Dialogue: 0,0:15:01.21,0:15:03.28,Default,,0,0,0,,Мен біртүрлі болып тұрмын ба?
Dialogue: 0,0:15:03.28,0:15:06.22,Default,,0,0,0,,Ой... мен күлдім бе?
Dialogue: 0,0:15:06.22,0:15:10.22,Default,,0,0,0,,А, мен досымды есіме түсірдім.
Dialogue: 0,0:15:10.22,0:15:14.23,Default,,0,0,0,,Түсіндім, кешікпейсің ғой? мен
Dialogue: 0,0:15:14.23,0:15:18.30,Default,,0,0,0,,Мен тым ерте келдім. (Таруми) Жақсы нәрсе.
Dialogue: 0,0:15:18.30,0:15:21.23,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:15:21.23,0:15:23.24,Default,,0,0,0,,Жасайық
Dialogue: 0,0:15:23.24,0:15:25.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:26.31,0:15:28.57,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:28.57,0:15:32.41,Default,,0,0,0,,Yahoi Shimachan!
Dialogue: 0,0:15:32.41,0:15:34.41,Default,,0,0,0,,Жылдам, бізді Диоға апар.
Dialogue: 0,0:15:35.41,0:15:37.75,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:15:37.75,0:15:40.42,Default,,0,0,0,,А, қайда бара жатырсың?
Dialogue: 0,0:15:40.42,0:15:43.12,Default,,0,0,0,,Әлі де құпия
Dialogue: 0,0:15:54.03,0:15:56.54,Default,,0,0,0,,Сіз қалай ойлайсыз? Иә?
Dialogue: 0,0:15:56.54,0:15:58.54,Default,,0,0,0,,Маған бірдеңе айтыңыз
Dialogue: 0,0:15:58.54,0:16:02.21,Default,,0,0,0,,Хм... Аа, мен солай ойладым.
Dialogue: 0,0:16:02.21,0:16:04.28,Default,,0,0,0,,Тару-чан, тіпті осылай күлетін бала.
Dialogue: 0,0:16:04.28,0:16:06.28,Default,,0,0,0,,есімде
Dialogue: 0,0:16:06.28,0:16:09.18,Default,,0,0,0,,Шима-чанға қатысты бір нәрсе сексуалды...
Dialogue: 0,0:16:10.22,0:16:14.55,Default,,0,0,0,,Жоқ, бұл дұрыс емес. Аа, мен сөздерді таба алмаймын→
Dialogue: 0,0:16:14.55,0:16:18.85,Default,,0,0,0,,Мен «өстім» деген сияқты бірдеңе айтқым келетін шығар.
Dialogue: 0,0:16:20.39,0:16:23.90,Default,,0,0,0,,Бұл менің жолым, бірақ...
Dialogue: 0,0:16:23.90,0:16:26.90,Default,,0,0,0,,(Екі адам бірге күледі)
Dialogue: 0,0:16:26.90,0:16:30.97,Default,,0,0,0,,Менің ойымша, сіз өзіңізді қатты итермелеудің қажеті жоқ, бірақ сол жоғары кернеу сезімі
Dialogue: 0,0:16:30.97,0:16:35.27,Default,,0,0,0,,Жарайды, оның жартысына жуығы әрекет етпейді.
Dialogue: 0,0:16:38.98,0:16:42.58,Default,,0,0,0,,(Таруми гуілдейді)
Dialogue: 0,0:16:42.58,0:16:45.58,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:45.58,0:16:47.59,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:16:47.59,0:16:50.59,Default,,0,0,0,,Бет-әлпет Мен шаршадым
Dialogue: 0,0:16:50.59,0:16:53.59,Default,,0,0,0,,Жоқ, бұл маңызды.
Dialogue: 0,0:16:53.59,0:16:57.20,Default,,0,0,0,,Маңызды деп ойлаймын... →
Dialogue: 0,0:16:57.20,0:16:59.70,Default,,0,0,0,,Шима-чан, соңғы кездері байсалды болдыңыз ба?
Dialogue: 0,0:16:59.70,0:17:01.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:01.70,0:17:05.77,Default,,0,0,0,,Шима-чанның анасы кейде менің анама телефон соғады.
Dialogue: 0,0:17:05.77,0:17:08.54,Default,,0,0,0,,Мен оны сол жерден естідім
Dialogue: 0,0:17:08.54,0:17:13.38,Default,,0,0,0,,Алайда анда-санда ғана саңылаулардың болатыны рас.
Dialogue: 0,0:17:13.38,0:17:17.72,Default,,0,0,0,,Мен Шима-чанның өзінен естігім келеді →
Dialogue: 0,0:17:17.72,0:17:19.72,Default,,0,0,0,,Менің бүгінгі мақсатым осы
Dialogue: 0,0:17:19.72,0:17:21.72,Default,,0,0,0,,№ Мақсаты? Жоқ...
Dialogue: 0,0:17:21.72,0:17:26.22,Default,,0,0,0,,Оны айтудың жұмсақ жолы бар ма? Эххе...
Dialogue: 0,0:17:27.79,0:17:30.40,Default,,0,0,0,,<Әртүрлі соңғы жағдайлар туралы сөйлескенде>
Dialogue: 0,0:17:30.40,0:17:33.23,Default,,0,0,0,,<Окономиякимен абай болыңыз>
Dialogue: 0,0:17:33.23,0:17:35.90,Default,,0,0,0,,<Тару-чанның көзқарасы таңғаларлық кең>
Dialogue: 0,0:17:35.90,0:17:37.90,Default,,0,0,0,,<Егер бұл Адачи болса>
Dialogue: 0,0:17:37.90,0:17:40.57,Default,,0,0,0,,<Артқы жағы күйіп қалған шығар>
Dialogue: 0,0:17:40.57,0:17:43.58,Default,,0,0,0,,＜Көп болғаны сонша, мен бұл туралы ойланбай тұра алмаймын＞
Dialogue: 0,0:17:43.58,0:17:47.41,Default,,0,0,0,,<Тару-чанның әңгімесі ойыма кірмеді>
Dialogue: 0,0:17:47.41,0:17:50.75,Default,,0,0,0,,<Мен жүрексіз адаммын>
Dialogue: 0,0:17:50.75,0:17:52.82,Default,,0,0,0,,<Бетпе-бет болсаң да>
Dialogue: 0,0:17:52.82,0:17:56.76,Default,,0,0,0,,<Бір жерде сенен қашық тұратын менің бір бөлігім бар>
Dialogue: 0,0:17:56.76,0:18:00.76,Default,,0,0,0,,Қысқасы, мен сізді бұрыннан білемін.
Dialogue: 0,0:18:00.76,0:18:02.76,Default,,0,0,0,,Сіз біреуді танисыз ба? жылы
Dialogue: 0,0:18:02.76,0:18:07.56,Default,,0,0,0,,Мен әлі де алдыңда тұрғанымды айтқым келеді.
Dialogue: 0,0:18:08.60,0:18:10.60,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:18:10.60,0:18:15.11,Default,,0,0,0,,Сіз не туралы айтып отырсыз? мен...
Dialogue: 0,0:18:15.11,0:18:17.18,Default,,0,0,0,,Фухёхёхё...
Dialogue: 0,0:18:17.18,0:18:20.45,Default,,0,0,0,,Енді қайда барасыз?
Dialogue: 0,0:18:20.45,0:18:24.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:24.45,0:18:28.79,Default,,0,0,0,,А, ана жерде дүкен бар.
Dialogue: 0,0:18:28.79,0:18:32.86,Default,,0,0,0,,Менің ойымша, бұл жалпы дүкен (Таруми)... Дұрыс →
Dialogue: 0,0:18:32.86,0:18:36.63,Default,,0,0,0,,Біраз жүрейік, а?
Dialogue: 0,0:18:36.63,0:18:40.13,Default,,0,0,0,,Уау~ Баулар өте көп →
Dialogue: 0,0:18:40.13,0:18:43.80,Default,,0,0,0,,Ей, дәл солай сатып алғың келе ме? Жарайды бірақ
Dialogue: 0,0:18:43.80,0:18:48.30,Default,,0,0,0,,Қайсысы жақсы? Мен саған не ұнатсаң да жақсымын, Шима-чан.
Dialogue: 0,0:18:50.31,0:18:52.31,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:18:52.31,0:18:55.08,Default,,0,0,0,,Шима-чан, сөмкеме салсам болады ма?
Dialogue: 0,0:18:55.08,0:18:57.08,Default,,0,0,0,,Сізді уайымдап отырған жеріңіз осы ма?
Dialogue: 0,0:18:57.08,0:18:59.92,Default,,0,0,0,,Оны кигізсем де, көп ұзамай жоғалтатын сияқтымын.
Dialogue: 0,0:18:59.92,0:19:02.25,Default,,0,0,0,,Бұл не? Кешіріңіз.
Dialogue: 0,0:19:02.25,0:19:07.25,Default,,0,0,0,,Шима-чан, сен заттарға немесе адамдарға үйір болмайсың, солай ма?
Dialogue: 0,0:19:08.76,0:19:11.10,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:19:11.10,0:19:13.60,Default,,0,0,0,,Маған жақсы қарайсың ба деп уайымдаймын.
Dialogue: 0,0:19:13.60,0:19:16.27,Default,,0,0,0,,Сонда бұл
Dialogue: 0,0:19:16.27,0:19:18.77,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:19:19.77,0:19:23.07,Default,,0,0,0,,Шынымен бе? Мен оған сенбеймін
Dialogue: 0,0:19:24.11,0:19:27.18,Default,,0,0,0,,Шима-чанның жүзі қазір бозарып кетті.
Dialogue: 0,0:19:27.18,0:19:30.18,Default,,0,0,0,,Иә? Жұқа?
Dialogue: 0,0:19:30.18,0:19:35.12,Default,,0,0,0,,Бірақ мен Шима-чанның жұқа көрінетін профиліне қарасам,
Dialogue: 0,0:19:35.12,0:19:38.82,Default,,0,0,0,,Маған қызық, ол не ойлап отыр.
Dialogue: 0,0:19:40.19,0:19:42.49,Default,,0,0,0,,Егер бұл орын алса, сіз ұтыласыз.
Dialogue: 0,0:19:44.46,0:19:47.86,Default,,0,0,0,,Жоқ, бұл жерде жеңіс бар.
Dialogue: 0,0:19:49.54,0:19:53.04,Default,,0,0,0,,Аа... Айтайын дегенім, солай.
Dialogue: 0,0:19:56.24,0:19:59.75,Default,,0,0,0,,Олай болса, міне.
Dialogue: 0,0:19:59.75,0:20:01.75,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:01.75,0:20:04.82,Default,,0,0,0,,Тағы бір жерге шығасың ба?
Dialogue: 0,0:20:04.82,0:20:06.82,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:20:12.83,0:20:17.33,Default,,0,0,0,,Қайтадан дос болайық! Шима-чан
Dialogue: 0,0:20:20.43,0:20:26.33,Default,,0,0,0,,<Түсіндім, сен мені бүгін осыны айтқың келгендіктен шақырдың.>
Dialogue: 0,0:20:27.77,0:20:29.77,Default,,0,0,0,,Иә
Dialogue: 0,0:20:32.61,0:20:35.45,Default,,0,0,0,,Ах, Шимамура-сан→
Dialogue: 0,0:20:35.45,0:20:38.45,Default,,0,0,0,,Шимамура мырза болды.
Dialogue: 0,0:20:38.45,0:20:41.29,Default,,0,0,0,,Шимамурасан!
Dialogue: 0,0:20:41.29,0:20:45.62,Default,,0,0,0,,Жарайды... онда, Шимамура-сан.
Dialogue: 0,0:20:45.62,0:20:49.92,Default,,0,0,0,,Не болды? Мен аздап шаршадым
Dialogue: 0,0:20:52.13,0:20:54.73,Default,,0,0,0,,<Тару-чан бұрын солай болған>
Dialogue: 0,0:20:54.73,0:20:58.03,Default,,0,0,0,,<Мен де сол кезде ұстанатынмын>
Dialogue: 0,0:20:59.07,0:21:03.07,Default,,0,0,0,,<Мүмкін бұл мен үшін табиғи емес шығар>
Dialogue: 0,0:21:05.14,0:21:09.08,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:21:09.08,0:21:12.58,Default,,0,0,0,,Шимамура мырза - Шимамура мырза.
Dialogue: 0,0:21:17.59,0:21:21.43,Default,,0,0,0,,Иә, бұл кейде пайдалы.
Dialogue: 0,0:21:21.43,0:21:24.26,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:21:24.26,0:21:26.76,Default,,0,0,0,,(Екі адам бірге күледі)
Dialogue: 0,0:21:34.61,0:21:37.61,Default,,0,0,0,,<бірінші семестр басталғаннан кейін 2 аптадан кейін>
Dialogue: 0,0:21:37.61,0:21:41.95,Default,,0,0,0,,<Әдеттегідей сабақ алыңыз және азық-түлік дүкенінен нан сатып алыңыз>
Dialogue: 0,0:21:41.95,0:21:44.62,Default,,0,0,0,,<Достармен тамақтану>
Dialogue: 0,0:21:44.62,0:21:47.45,Default,,0,0,0,,<Уақыт әдеттегідей өтеді>
Dialogue: 0,0:21:47.45,0:21:51.29,Default,,0,0,0,,<Айырмашылық жалғыз менің алдымда>
Dialogue: 0,0:21:51.29,0:21:54.39,Default,,0,0,0,,<Адачи көрсетілмегенде>
Dialogue: 0,0:21:56.30,0:22:00.23,Default,,0,0,0,,Айтпақшы, бүгін үйге қайтар жолда құймақ жегіңіз келе ме?
Dialogue: 0,0:22:00.23,0:22:03.33,Default,,0,0,0,,Келісемін! Мен қызық...
Dialogue: 0,0:22:05.57,0:22:07.57,Default,,0,0,0,,Шимамура
Dialogue: 0,0:22:10.91,0:22:13.25,Default,,0,0,0,,<Санчо Тару-чан>
Dialogue: 0,0:22:13.25,0:22:16.08,Default,,0,0,0,,<Сәуірдегі үшінші қоңырау>
Dialogue: 0,0:22:16.08,0:22:19.15,Default,,0,0,0,,<Адалдықты үшінші рет айту керек шығар>
Dialogue: 0,0:22:19.15,0:22:21.75,Default,,0,0,0,,<Қалай айту керек>
Dialogue: 0,0:22:21.75,0:22:25.55,Default,,0,0,0,,<Басқа адам бұл жолы Адачи болды>
Dialogue: 0,0:23:58.38,0:24:02.61,Default,,0,0,0,,Адажимапедия Жаңа семестр (Хино) Біз тағы да сізбен бір сыныпта оқимыз ба?
Dialogue: 0,0:24:02.61,0:24:04.95,Default,,0,0,0,,Төбеден шығып, бірінші рет өзіңіз қалаған денені алыңыз
Dialogue: 0,0:24:04.95,0:24:06.95,Default,,0,0,0,,Танысқаныма қуаныштымын (Хино) Нагато-сан→
Dialogue: 0,0:24:06.95,0:24:09.62,Default,,0,0,0,,Бұл өте жетілген және керемет. (Нагато) Хино мырза →
Dialogue: 0,0:24:09.62,0:24:11.62,Default,,0,0,0,,Сен сондай сүйкімдісің (Хино/Нагафуджи) Уфуфу... Уау!
Dialogue: 0,0:24:13.12,0:24:19.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
