Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.92,0:00:10.53,Default,,0,0,0,,<Симамура - Шимамура>
Dialogue: 0,0:00:11.07,0:00:14.18,Default,,0,0,0,,<Мүмкін бұл менде әрқашан Шимамура болған шығар>
Dialogue: 0,0:00:15.00,0:00:18.82,Default,,0,0,0,,<Мен бұл нені білдіретінін білмеймін, бірақ бұл маған қауіпсіздік сезімін береді>
Dialogue: 0,0:00:19.60,0:00:21.47,Default,,0,0,0,,<Кенеттен босаңсыған дыбыс естіледі>
Dialogue: 0,0:00:22.36,0:00:24.70,Default,,0,0,0,,<Бұл өте жақсы>
Dialogue: 0,0:00:29.48,0:00:30.97,Default,,0,0,0,,Өйткені, мен де бүгін келдім.
Dialogue: 0,0:00:31.42,0:00:32.57,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:00:33.09,0:00:35.40,Default,,0,0,0,,Ол сол Шимамура
Dialogue: 0,0:00:36.04,0:00:37.50,Default,,0,0,0,,Қай Шимамура?
Dialogue: 0,0:00:37.74,0:00:40.06,Default,,0,0,0,,Хохо сен...
Dialogue: 0,0:00:40.30,0:00:42.63,Default,,0,0,0,,Атың кім?
Dialogue: 0,0:00:42.76,0:00:45.46,Default,,0,0,0,,Хехехе ақымақ Дохоға ұқсамайды
Dialogue: 0,0:00:45.46,0:00:47.80,Default,,0,0,0,,Есімді алдын ала дайындап қойдым.
Dialogue: 0,0:00:47.95,0:00:50.38,Default,,0,0,0,,Бізді Чигамася деп атаңыз.
Dialogue: 0,0:00:51.34,0:00:54.21,Default,,0,0,0,,Мен Жерге Дохоны іздеп келдім.
Dialogue: 0,0:00:55.77,0:00:56.85,Default,,0,0,0,,Дохо?
Dialogue: 0,0:02:27.89,0:02:28.95,Default,,0,0,0,,Дохо?
Dialogue: 0,0:02:29.11,0:02:31.64,Default,,0,0,0,,А, жерлестер, жолдастар?
Dialogue: 0,0:02:32.04,0:02:33.44,Default,,0,0,0,,Не? Бұл сенің досың ба?
Dialogue: 0,0:02:34.16,0:02:36.02,Default,,0,0,0,,Дәлірек айтқанда, сіз жаңа ғана Жер дедіңіз бе?
Dialogue: 0,0:02:36.60,0:02:40.04,Default,,0,0,0,,Дохо миссиямен осында қонды.
Dialogue: 0,0:02:40.28,0:02:42.02,Default,,0,0,0,,Мен ешқашан оралмаймын
Dialogue: 0,0:02:42.56,0:02:45.15,Default,,0,0,0,,Сені іздеп келуден басқа амалым қалмады.
Dialogue: 0,0:02:45.48,0:02:47.66,Default,,0,0,0,,Мен дұрыс емес жерден түскен сияқтымын.
Dialogue: 0,0:02:48.01,0:02:49.34,Default,,0,0,0,,Олай болса, Шимамура
Dialogue: 0,0:02:49.45,0:02:50.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:50.09,0:02:54.62,Default,,0,0,0,,Менімен сөйлесуге уақыт бөліңіз және осы белгісіз қарым-қатынастан ләззат алыңыз.
Dialogue: 0,0:02:54.62,0:02:55.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:56.23,0:02:57.95,Default,,0,0,0,,Ой, мен ана жақта балықтың көлеңкесін сезіп тұрмын.
Dialogue: 0,0:02:58.65,0:02:59.29,Default,,0,0,0,,Біраз
Dialogue: 0,0:03:01.67,0:03:02.86,Default,,0,0,0,,Хином
Dialogue: 0,0:03:03.03,0:03:05.45,Default,,0,0,0,,Мені балық аулауға шақырған...
Dialogue: 0,0:03:07.51,0:03:10.86,Default,,0,0,0,,Сіздің атыңыз Шимамура-сан.
Dialogue: 0,0:03:11.13,0:03:13.45,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:03:14.41,0:03:18.87,Default,,0,0,0,,Бұл жерге танымал болғаны сонша, жергілікті тұрғындар мұнда үнемі келеді деп естідім.
Dialogue: 0,0:03:19.60,0:03:21.52,Default,,0,0,0,,Бұл Шимамураның түрі емес.
Dialogue: 0,0:03:21.86,0:03:23.14,Default,,0,0,0,,Өзіңізді кішірейтіңіз
Dialogue: 0,0:03:23.50,0:03:26.33,Default,,0,0,0,,Өйткені мен болашақтанмын
Dialogue: 0,0:03:26.52,0:03:28.45,Default,,0,0,0,,Жергілікті емес
Dialogue: 0,0:03:28.74,0:03:29.48,Default,,0,0,0,,Хиёри, бұл шынымен де түсініспеушілік
Dialogue: 0,0:03:29.84,0:03:33.12,Default,,0,0,0,,Күрсін... Мен өткенненмін. Сәлем.
Dialogue: 0,0:03:34.65,0:03:36.90,Default,,0,0,0,,Сіз кәдімгі жерлік сияқтысыз.
Dialogue: 0,0:03:37.24,0:03:38.36,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:41.01,0:03:42.16,Default,,0,0,0,,Егер сіз оны шешіп алсаңыз, ол
Dialogue: 0,0:03:42.81,0:03:46.21,Default,,0,0,0,,Бет әлі біткен жоқ, сондықтан біраз күтіңіз.
Dialogue: 0,0:03:46.83,0:03:49.90,Default,,0,0,0,,Наубайханадан жаңа тұлға келе ме?
Dialogue: 0,0:03:51.53,0:03:55.89,Default,,0,0,0,,Дос іздеу керек емес пе, дәлірек айтқанда отандастар?
Dialogue: 0,0:03:56.89,0:03:59.03,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:04:00.17,0:04:00.99,Default,,0,0,0,,Философия?
Dialogue: 0,0:04:01.67,0:04:05.05,Default,,0,0,0,,Дохоның қауіпсіз екені расталды.
Dialogue: 0,0:04:05.05,0:04:07.49,Default,,0,0,0,,Мен мұны жеңілдетемін деп ойлаймын.
Dialogue: 0,0:04:08.07,0:04:09.72,Default,,0,0,0,,Байланыс болды ма?
Dialogue: 0,0:04:10.04,0:04:12.54,Default,,0,0,0,,Міне, ұқсас.
Dialogue: 0,0:04:12.93,0:04:15.73,Default,,0,0,0,,Егер сізбен байланыса алсам, жақын арада кездесетінімізге сенімдімін.
Dialogue: 0,0:04:15.94,0:04:18.06,Default,,0,0,0,,Мұны мүмкін емес ететін жағдайлар бар!
Dialogue: 0,0:04:19.46,0:04:21.16,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:04:21.55,0:04:22.22,Default,,0,0,0,,Тас
Dialogue: 0,0:04:25.73,0:04:27.62,Default,,0,0,0,,Балық аулау оңай емес.
Dialogue: 0,0:04:28.94,0:04:31.90,Default,,0,0,0,,Ең алдымен, осылай ойлану маңызды.
Dialogue: 0,0:04:32.19,0:04:32.92,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:04:33.38,0:04:35.93,Default,,0,0,0,,Балық аулау қиын. Жақсы жүрмейді.
Dialogue: 0,0:04:36.44,0:04:40.06,Default,,0,0,0,,Бұл бір нәрсені бастау дегенді білдіреді
Dialogue: 0,0:04:47.47,0:04:48.81,Default,,0,0,0,,Сіз жаңа ғана қолданып көрдіңіз бе?
Dialogue: 0,0:04:50.68,0:04:51.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:55.15,0:04:58.53,Default,,0,0,0,,Жақсы болашаққа үміттену ғана қалды.
Dialogue: 0,0:05:00.63,0:05:02.45,Default,,0,0,0,,Жай ғана жіпті тастаңыз
Dialogue: 0,0:05:06.60,0:05:08.82,Default,,0,0,0,,Міне, солай болды.
Dialogue: 0,0:05:10.88,0:05:12.06,Default,,0,0,0,,Бұл маңызды болды ма?
Dialogue: 0,0:05:12.27,0:05:13.72,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:05:14.53,0:05:16.69,Default,,0,0,0,,Менен бұлай сұрауды доғарғаныңызды қалаймын.
Dialogue: 0,0:05:16.94,0:05:17.93,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:05:18.82,0:05:20.05,Default,,0,0,0,,Бір нәрседен шаршадыңыз ба?
Dialogue: 0,0:05:20.44,0:05:23.17,Default,,0,0,0,,Ал, мен кеше толық емес жұмыс күніммен айналыстым.
Dialogue: 0,0:05:23.40,0:05:25.46,Default,,0,0,0,,Иә? Адачи, оның толық емес жұмыс күні бар ма?
Dialogue: 0,0:05:26.01,0:05:26.55,Default,,0,0,0,,Қайда?
Dialogue: 0,0:05:28.35,0:05:29.22,Default,,0,0,0,,Мен сізге айтпаймын
Dialogue: 0,0:05:29.92,0:05:30.92,Default,,0,0,0,,Шыгандшинаға баратын жолды іздеуге аттанған Зерттеу корпусы,
Dialogue: 0,0:05:31.83,0:05:33.80,Default,,0,0,0,,Айтсаңыз, олар келетін шығар.
Dialogue: 0,0:05:34.14,0:05:34.92,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:05:36.80,0:05:38.60,Default,,0,0,0,,Жоқ, бұл ұят.
Dialogue: 0,0:05:39.54,0:05:40.84,Default,,0,0,0,,Мен ұялмаймын
Dialogue: 0,0:05:41.64,0:05:43.48,Default,,0,0,0,,Жұмыс таң қалдырады.
Dialogue: 0,0:05:46.14,0:05:48.73,Default,,0,0,0,,<Адачи бір кездері мені мысық тәрізді> деп атаған
Dialogue: 0,0:05:49.35,0:05:52.56,Default,,0,0,0,,<Шамасы, мысықтар адамдармен тіл табыса алмайтын сияқты.>
Dialogue: 0,0:05:54.33,0:05:57.93,Default,,0,0,0,,<Менің ойымша, басқаларды кешірмейтін кейбір бөліктерім бар.>
Dialogue: 0,0:05:59.68,0:06:03.00,Default,,0,0,0,,<Бірақ Адачи ұқсас емес пе?>
Dialogue: 0,0:06:04.56,0:06:06.77,Default,,0,0,0,,<Адачи менің тіземде ұйықтап жатыр>
Dialogue: 0,0:06:07.29,0:06:08.97,Default,,0,0,0,,<Бұл мысыққа ұқсайтыны сөзсіз>
Dialogue: 0,0:06:13.71,0:06:15.05,Default,,0,0,0,,Хмм... не?
Dialogue: 0,0:06:16.29,0:06:17.74,Default,,0,0,0,,Бұл жақсырақ болуы мүмкін
Dialogue: 0,0:06:18.26,0:06:18.77,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:06:19.93,0:06:23.41,Default,,0,0,0,,Егер сіз осылай қарап ұйықтасаңыз, Шимамураның иісін сезесіз.
Dialogue: 0,0:06:24.17,0:06:26.08,Default,,0,0,0,,Не, менде жағымсыз иіс бар ма?
Dialogue: 0,0:06:26.68,0:06:28.56,Default,,0,0,0,,Менің айтқым келгені бұл емес еді.
Dialogue: 0,0:06:30.35,0:06:31.35,Default,,0,0,0,,Онда мен мұны істемеймін.
Dialogue: 0,0:06:32.48,0:06:34.77,Default,,0,0,0,,Шимамурада атмосфера жеткіліксіз болуы мүмкін.
Dialogue: 0,0:06:35.84,0:06:39.50,Default,,0,0,0,,Талғампаздық Хмм, талғампаздық.
Dialogue: 0,0:06:40.46,0:06:42.62,Default,,0,0,0,,Маған бұлай бұрын ешқашан айтылмаған.
Dialogue: 0,0:06:44.23,0:06:45.18,Default,,0,0,0,,Сәлем Адачи
Dialogue: 0,0:06:45.48,0:06:45.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:47.39,0:06:49.36,Default,,0,0,0,,Түстен кейін менімен сабаққа барғың келе ме?
Dialogue: 0,0:06:52.86,0:06:53.83,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:54.56,0:06:56.35,Default,,0,0,0,,Жоқ, оқу күндерінің саны және т.б.
Dialogue: 0,0:06:58.00,0:07:00.74,Default,,0,0,0,,Хмм, мен екінші жыл бірге болсақ қызық болар еді.
Dialogue: 0,0:07:02.22,0:07:03.08,Default,,0,0,0,,...
Dialogue: 0,0:07:04.97,0:07:06.27,Default,,0,0,0,,Мүмкін анда-санда
Dialogue: 0,0:07:06.27,0:07:07.37,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:08.14,0:07:11.06,Default,,0,0,0,,Ал, сабақтан кейін бір жерге барайық.
Dialogue: 0,0:07:11.26,0:07:11.72,Default,,0,0,0,,А...
Dialogue: 0,0:07:13.29,0:07:14.64,Default,,0,0,0,,Жоспарланған нәрсе бар ма?
Dialogue: 0,0:07:15.01,0:07:16.03,Default,,0,0,0,,Бүгін емес
Dialogue: 0,0:07:16.51,0:07:18.33,Default,,0,0,0,,Дәлірек айтқанда, әрқашан дерлік.
Dialogue: 0,0:07:18.68,0:07:19.83,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:21.53,0:07:23.42,Default,,0,0,0,,Бүгінгі балық аулау жақсы болды деп сенемін.
Dialogue: 0,0:07:25.61,0:07:29.96,Default,,0,0,0,,<Мектеп бірегей қоғам ретінде қызмет етеді>
Dialogue: 0,0:07:30.47,0:07:33.61,Default,,0,0,0,,<Сол атмосфера сыртқа шығарылғанда мен өзімді шатастырамын>
Dialogue: 0,0:07:34.60,0:07:40.15,Default,,0,0,0,,<Сондықтан болар, кейбір адамдар мектепте мәңгі қалуды қалайды.>
Dialogue: 0,0:07:41.16,0:07:44.38,Default,,0,0,0,,＜Оны былай қойғанда, мен жақсы болашаққа ие болғым келеді＞
Dialogue: 0,0:07:45.18,0:07:48.79,Default,,0,0,0,,<Ол үшін алдымен балық аулау жіпін түсіру керек.>
Dialogue: 0,0:07:50.44,0:07:51.53,Default,,0,0,0,,Сабақ қалай өтті?
Dialogue: 0,0:07:51.93,0:07:53.45,Default,,0,0,0,,Жапон тарихы жақсы
Dialogue: 0,0:07:53.61,0:07:56.60,Default,,0,0,0,,Мен енді математиканы мүлде түсінбей қалдым.
Dialogue: 0,0:07:56.72,0:08:02.70,Default,,0,0,0,,Хаха...Мен Адачиге қарағанда көбірек сабақ алуым керек, сондықтан екеуі де сергіп қалды...
Dialogue: 0,0:08:03.56,0:08:06.22,Default,,0,0,0,,Шимамура, бірдеңе назар аударып тұрды.
Dialogue: 0,0:08:06.42,0:08:08.52,Default,,0,0,0,,Жоқ, бұл Адачи емес пе?
Dialogue: 0,0:08:09.87,0:08:11.00,Default,,0,0,0,,Жоқ, бұл Шимамура болатын.
Dialogue: 0,0:08:11.92,0:08:13.98,Default,,0,0,0,,Бәлкім ол әдемі болғандықтан шығар.
Dialogue: 0,0:08:14.19,0:08:14.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:15.98,0:08:16.78,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:17.47,0:08:21.10,Default,,0,0,0,,Мені бірінші рет сұлу деп атады.
Dialogue: 0,0:08:21.54,0:08:25.66,Default,,0,0,0,,Иә? Жігітіме келсек...
Dialogue: 0,0:08:25.66,0:08:27.57,Default,,0,0,0,,Мен мұны ешқашан істей алмадым.
Dialogue: 0,0:08:30.46,0:08:33.13,Default,,0,0,0,,үшін көре алмайды.
Dialogue: 0,0:08:34.81,0:08:35.98,Default,,0,0,0,,Не? Велосипед ше?
Dialogue: 0,0:08:36.80,0:08:37.95,Default,,0,0,0,,Жөндеуге жіберілді
Dialogue: 0,0:08:39.23,0:08:41.77,Default,,0,0,0,,Жаяу келсең де керемет емес пе?
Dialogue: 0,0:08:42.10,0:08:44.33,Default,,0,0,0,,Мен Шимамура келе жатыр деп ойладым.
Dialogue: 0,0:08:47.90,0:08:49.50,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:08:57.42,0:08:58.60,Default,,0,0,0,,Ами~!
Dialogue: 0,0:08:59.08,0:09:01.56,Default,,0,0,0,,Шимамура ертең сабақ болады ма?
Dialogue: 0,0:09:02.71,0:09:06.17,Default,,0,0,0,,Жарайды, мен үш күндік монах болмауға бар күшімді саламын.
Dialogue: 0,0:09:06.98,0:09:07.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:09.68,0:09:12.97,Default,,0,0,0,,Сіз қалай ойлайсыз? Адачи мырза, сіз бірге бар күшіңізді салғыңыз келе ме?
Dialogue: 0,0:09:15.32,0:09:17.48,Default,,0,0,0,,Олай болса, тағы біраз.
Dialogue: 0,0:09:19.93,0:09:20.94,Default,,0,0,0,,Тістеп алдың ба?
Dialogue: 0,0:09:21.26,0:09:21.59,Default,,0,0,0,,Иә
Dialogue: 0,0:09:22.04,0:09:24.20,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:09:32.16,0:09:32.92,Default,,0,0,0,,Өз кезегінде
Dialogue: 0,0:09:38.15,0:09:38.71,Default,,0,0,0,,Адачи?
Dialogue: 0,0:09:39.88,0:09:41.34,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:09:43.73,0:09:46.14,Default,,0,0,0,,Иә Крем, бұл дегеніңіз, солай ма?
Dialogue: 0,0:09:48.52,0:09:49.77,Default,,0,0,0,,А, онда...
Dialogue: 0,0:09:56.46,0:09:57.66,Default,,0,0,0,,Тамақтанып болған соң, қайда барасың?
Dialogue: 0,0:09:58.92,0:10:02.14,Default,,0,0,0,,<Адамдармен бірге болу аздап ауырады>
Dialogue: 0,0:10:03.00,0:10:05.40,Default,,0,0,0,,<Нені түсінбейсіз және не мазалайтыны>
Dialogue: 0,0:10:05.56,0:10:09.59,Default,,0,0,0,,<Қатынастардың шиеленісуіне байланысты жөндеу және бөлшектеу әрекеттері>
Dialogue: 0,0:10:10.34,0:10:14.81,Default,,0,0,0,,＜Алайда бақыт осы жағымсыз аспектілердің арасында жатыр＞
Dialogue: 0,0:10:16.02,0:10:19.81,Default,,0,0,0,,<Бала кезіңізде жоғалтқан кішкентай допты кенеттен тапқандай>
Dialogue: 0,0:10:20.46,0:10:23.35,Default,,0,0,0,,<Адачимен кездесу жақсы болашаққа әкеледі>
Dialogue: 0,0:10:23.35,0:10:25.17,Default,,0,0,0,,<Мен сенгім келеді>
Dialogue: 0,0:10:55.08,0:10:56.49,Default,,0,0,0,,Ум...а, ұнамаса, жібер!
Dialogue: 0,0:10:56.57,0:10:57.54,Default,,0,0,0,,Қазір жіберіңіз!
Dialogue: 0,0:10:58.53,0:11:00.54,Default,,0,0,0,,Дұрысы, мен таң қалдым.
Dialogue: 0,0:11:01.55,0:11:02.65,Default,,0,0,0,,Тоқтаймыз ба?
Dialogue: 0,0:11:02.94,0:11:04.90,Default,,0,0,0,,Жоқ, жақсы, кеттік.
Dialogue: 0,0:11:05.72,0:11:07.53,Default,,0,0,0,,Адачи таң қаларлықтай еркелете ме?
Dialogue: 0,0:11:07.95,0:11:09.85,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:11:10.29,0:11:11.51,Default,,0,0,0,,Күтпеген нәрсе.
Dialogue: 0,0:11:12.17,0:11:14.25,Default,,0,0,0,,Мен үшін емес
Dialogue: 0,0:11:15.41,0:11:17.19,Default,,0,0,0,,Таңқаларлық емес
Dialogue: 0,0:11:19.56,0:11:19.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:27.09,0:11:28.08,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:29.43,0:11:29.90,Default,,0,0,0,,Ах... иә
Dialogue: 0,0:11:30.54,0:11:33.26,Default,,0,0,0,,Мен сені көрдім, сондықтан мен сені шақырдым.
Dialogue: 0,0:11:33.70,0:11:36.60,Default,,0,0,0,,Сіз вокзал алдында қалыпты жүресіз бе?
Dialogue: 0,0:11:36.88,0:11:38.23,Default,,0,0,0,,Бұл аздап созылу, солай ма?
Dialogue: 0,0:11:40.47,0:11:44.25,Default,,0,0,0,,Саусақтарыңыздың иісі керемет тәтті.
Dialogue: 0,0:11:44.43,0:11:47.47,Default,,0,0,0,,Бұл жақсы. Ол қандай иіс?
Dialogue: 0,0:11:48.84,0:11:52.07,Default,,0,0,0,,Бұл пончиктің иісі, солай ма? Мен оларды жай ғана жедім.
Dialogue: 0,0:11:52.96,0:11:54.50,Default,,0,0,0,,пончик?
Dialogue: 0,0:11:57.61,0:11:58.63,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:59.15,0:12:00.65,Default,,0,0,0,,Мен мұны істеймін деп ойладым.
Dialogue: 0,0:12:01.03,0:12:03.84,Default,,0,0,0,,менің радарыма жауап берді
Dialogue: 0,0:12:03.84,0:12:06.25,Default,,0,0,0,,Онда пончиктер бар!
Dialogue: 0,0:12:06.25,0:12:07.69,Default,,0,0,0,,Иә, бірақ қабылдамаңыз.
Dialogue: 0,0:12:09.28,0:12:10.93,Default,,0,0,0,,Маған бір тоқаш берсеңіз...
Dialogue: 0,0:12:10.93,0:12:16.38,Default,,0,0,0,,Оның орнына ғаламның бір сырын айтайын!
Dialogue: 0,0:12:16.97,0:12:19.93,Default,,0,0,0,,Иә? Білесің бе, бұл менің әпкемдікі!
Dialogue: 0,0:12:22.14,0:12:24.98,Default,,0,0,0,,<Дону жейтін дулыға алыңыз>
Dialogue: 0,0:12:24.98,0:12:26.43,Default,,0,0,0,,<Бет көрінетін>
Dialogue: 0,0:12:28.51,0:12:30.15,Default,,0,0,0,,Оған көмектесу мүмкін емес, бір ғана.
Dialogue: 0,0:12:31.93,0:12:33.40,Default,,0,0,0,,Олай болса, осылай.
Dialogue: 0,0:12:33.93,0:12:36.02,Default,,0,0,0,,Бұл пончик пе?
Dialogue: 0,0:12:47.77,0:12:49.62,Default,,0,0,0,,Сыртта дулыға!
Dialogue: 0,0:12:55.01,0:12:58.39,Default,,0,0,0,,Бұл жақсы! тәтті тәтті
Dialogue: 0,0:12:58.39,0:12:59.82,Default,,0,0,0,,Мен пончиктерді білмеймін
Dialogue: 0,0:13:00.31,0:13:01.65,Default,,0,0,0,,Бұл қандай би?
Dialogue: 0,0:13:02.41,0:13:04.71,Default,,0,0,0,,Сізде тәттірек нәрсе бар ма?
Dialogue: 0,0:13:05.03,0:13:05.97,Default,,0,0,0,,Оны өзіңіз сатып алыңыз
Dialogue: 0,0:13:05.97,0:13:08.12,Default,,0,0,0,,Ақша жоқ
Dialogue: 0,0:13:08.12,0:13:09.70,Default,,0,0,0,,Сіз қалай өмір сүресіз...
Dialogue: 0,0:13:09.70,0:13:10.18,Default,,0,0,0,,Шимамура
Dialogue: 0,0:13:12.00,0:13:13.66,Default,,0,0,0,,Мен велосипед алып келейін.
Dialogue: 0,0:13:14.41,0:13:17.13,Default,,0,0,0,,Алдымен, ертең кездескенше.
Dialogue: 0,0:13:18.64,0:13:21.10,Default,,0,0,0,,Мүмкін сіз бір нәрсеге ашуланған шығарсыз?
Dialogue: 0,0:13:21.69,0:13:26.28,Default,,0,0,0,,Ғалам сырларының орнына жаңа болған оқиғаны айтайын ба?
Dialogue: 0,0:13:26.77,0:13:27.46,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:13:29.01,0:13:31.70,Default,,0,0,0,,Мен пончик алмағандықтан ашуландым.
Dialogue: 0,0:13:32.05,0:13:32.59,Default,,0,0,0,,Үйге қайт
Dialogue: 0,0:13:33.25,0:13:35.42,Default,,0,0,0,,<Бұл өзін болашақ адам деп атаған>
Dialogue: 0,0:13:35.77,0:13:40.04,Default,,0,0,0,,<Бұл болашақта менің өмірімді айтарлықтай өзгерте ме, білмеймін>
Dialogue: 0,0:13:40.93,0:13:43.51,Default,,0,0,0,,＜Біріншіден, өмір еш нәрсеге қарамастан өзгермейді＞
Dialogue: 0,0:13:44.14,0:13:45.98,Default,,0,0,0,,<Себебі болашақты ешкім білмейді>
Dialogue: 0,0:13:46.65,0:13:47.80,Default,,0,0,0,,<Оны өзгерту мүмкін емес>
Dialogue: 0,0:13:49.00,0:13:52.59,Default,,0,0,0,,күрсіну~ Адамдармен араласу өте қиын.
Dialogue: 0,0:13:53.00,0:13:54.38,Default,,0,0,0,,Мен түсіндім, түсінемін
Dialogue: 0,0:13:54.68,0:13:55.57,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:59.24,0:14:00.63,Default,,0,0,0,,...
Dialogue: 0,0:14:00.63,0:14:03.48,Default,,0,0,0,,<Ол мені әдемірек деп ойлайтын сияқты>
Dialogue: 0,0:14:04.54,0:14:07.25,Default,,0,0,0,,<Бұл үлкен түсінбеушілік деуге болады>
Dialogue: 0,0:14:08.30,0:14:12.38,Default,,0,0,0,,<Менің көзқарасым бойынша, Шимамура әлдеқайда сүйкімді>
Dialogue: 0,0:14:13.48,0:14:17.00,Default,,0,0,0,,<Жалқау көз және қарапайым қозғалатын ауыз>
Dialogue: 0,0:14:18.00,0:14:21.00,Default,,0,0,0,,<Мен Шимамураның бетін ғана көремін>
Dialogue: 0,0:14:22.05,0:14:24.19,Default,,0,0,0,,<Әсіресе ауыздың айналасы>
Dialogue: 0,0:14:40.76,0:14:43.46,Default,,0,0,0,,<Мен Шимамураны сүйсем деп армандадым>
Dialogue: 0,0:14:46.15,0:14:48.77,Default,,0,0,0,,<Мен ондай адам емеспін>
Dialogue: 0,0:14:49.42,0:14:53.50,Default,,0,0,0,,<Симамураға жақынырақ болғысы келетінін білдіретін шығар>
Dialogue: 0,0:14:54.04,0:14:56.65,Default,,0,0,0,,<Демек, олай емес>
Dialogue: 0,0:14:57.31,0:14:59.77,Default,,0,0,0,,＜Сүйісудің де мағынасы көп...＞
Dialogue: 0,0:15:06.54,0:15:07.74,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:15:08.41,0:15:10.59,Default,,0,0,0,,<Мен мүлде қаламаймын деп айтпаймын>
Dialogue: 0,0:15:11.22,0:15:15.27,Default,,0,0,0,,<Бірақ сіз мұны міндетті түрде қаламайсыз ба? ＞
Dialogue: 0,0:15:16.50,0:15:20.42,Default,,0,0,0,,<Симамураның айналасында 5км радиуста ешкім жоқ>
Dialogue: 0,0:15:20.89,0:15:23.17,Default,,0,0,0,,<Симамура терең ұйқыда>
Dialogue: 0,0:15:23.17,0:15:27.29,Default,,0,0,0,,<Егер Құдіретті және Құдіретті Құдай алдағы 24 сағатта бұл ешқашан болмайтынына кепілдік берсе>
Dialogue: 0,0:15:27.53,0:15:33.69,Default,,0,0,0,,<Кем дегенде бір рет, шамамен 23 сағаттан кейін мен бұдан былай зерігуге шыдай алмадым...>
Dialogue: 0,0:15:35.28,0:15:37.08,Default,,0,0,0,,<Иә? Күлкілі＞
Dialogue: 0,0:15:38.49,0:15:40.63,Default,,0,0,0,,<Бірақ мен ондай емеспін>
Dialogue: 0,0:15:41.05,0:15:43.49,Default,,0,0,0,,<Маған Шимамура басымдық бергенін қалаймын>
Dialogue: 0,0:15:44.09,0:15:46.84,Default,,0,0,0,,<Симамура «дос» сөзін естігенде>
Dialogue: 0,0:15:46.97,0:15:49.27,Default,,0,0,0,,<Алдымен мені ойлағаныңды қалаймын>
Dialogue: 0,0:15:50.10,0:15:54.36,Default,,0,0,0,,<Монополиялық қалаудың қандай да бір дәрежесі бар екенін мойындаймын.>
Dialogue: 0,0:15:55.50,0:16:01.96,Default,,0,0,0,,<Шынында, мен Шимамураның мені қаншалықты дос санайтынына таң қалдым>
Dialogue: 0,0:16:02.81,0:16:05.21,Default,,0,0,0,,<Басқа достардан айырмашылығың жоқ па?>
Dialogue: 0,0:16:05.81,0:16:09.02,Default,,0,0,0,,<Әлде сіз бұл туралы аз да болса хабардарсыз ба?>
Dialogue: 0,0:16:12.86,0:16:14.87,Default,,0,0,0,,Қош келдіңіз... Ах!
Dialogue: 0,0:16:16.35,0:16:16.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:28.70,0:16:30.68,Default,,0,0,0,,Сондықтан мен ұялдым дедім.
Dialogue: 0,0:16:31.29,0:16:32.89,Default,,0,0,0,,Жарайды, бұл сізге сәйкес келеді.
Dialogue: 0,0:16:34.38,0:16:35.69,Default,,0,0,0,,Хмм, досым?
Dialogue: 0,0:16:35.69,0:16:39.71,Default,,0,0,0,,Қарашы, сен мектеп оқушысы болған соң, менің үйіме жиі келмейсің.
Dialogue: 0,0:16:41.75,0:16:43.40,Default,,0,0,0,,Жақсы, уайымдама.
Dialogue: 0,0:16:44.92,0:16:45.94,Default,,0,0,0,,Иә~ Бір сынып па?
Dialogue: 0,0:16:46.07,0:16:47.18,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:16:47.49,0:16:48.89,Default,,0,0,0,,Не? Жарайды.
Dialogue: 0,0:16:49.28,0:16:51.92,Default,,0,0,0,,Сонымен, қазір тапсырыс беріңіз.
Dialogue: 0,0:16:51.92,0:16:53.32,Default,,0,0,0,,I Тантанмен!
Dialogue: 0,0:16:53.32,0:16:54.78,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:16:55.81,0:16:59.32,Default,,0,0,0,,<Симамура мені онша түсінбейтін сияқты.>
Dialogue: 0,0:16:59.63,0:17:00.54,Default,,0,0,0,,＜Бір-бірі＞
Dialogue: 0,0:17:01.32,0:17:03.49,Default,,0,0,0,,<Егер сен оған еңкейсең, ол оны қабылдайды.>
Dialogue: 0,0:17:03.90,0:17:06.29,Default,,0,0,0,,...
Dialogue: 0,0:17:06.99,0:17:10.22,Default,,0,0,0,,<Бұл менің қолымда тұрған Шимамураның бейнесі еді>
Dialogue: 0,0:17:10.67,0:17:13.60,Default,,0,0,0,,Мен аздап байсалды болдым деп ойлағанымда, міне, осы.
Dialogue: 0,0:17:16.18,0:17:17.24,Default,,0,0,0,,Біреудің көшірмесі?
Dialogue: 0,0:17:17.48,0:17:19.70,Default,,0,0,0,,Сынып жетекшісі, бүгін не істеп жатырсың?
Dialogue: 0,0:17:19.89,0:17:21.58,Default,,0,0,0,,Менен сұрасаң бәрібір.
Dialogue: 0,0:17:24.12,0:17:24.67,Default,,0,0,0,,Не?
Dialogue: 0,0:17:25.49,0:17:28.74,Default,,0,0,0,,Мен кеше Адачиді сүйкімді деп ойладым.
Dialogue: 0,0:17:30.97,0:17:32.78,Default,,0,0,0,,Шимамура да сүйкімді
Dialogue: 0,0:17:33.82,0:17:35.78,Default,,0,0,0,,Жоқ, мен ештеңе істеген жоқпын.
Dialogue: 0,0:17:37.54,0:17:39.67,Default,,0,0,0,,Мүмкін келесі жолы тағы тамақ ішуіміз керек.
Dialogue: 0,0:17:40.08,0:17:41.92,Default,,0,0,0,,Тоқтаңыз, тоқтаңыз.
Dialogue: 0,0:17:42.35,0:17:46.03,Default,,0,0,0,,Қалжың болсын, мен де ол жаққа отбасыммен бармаймын...
Dialogue: 0,0:17:47.85,0:17:50.53,Default,,0,0,0,,Сіздің отбасыңызда ұят нәрсе бар...
Dialogue: 0,0:17:50.53,0:17:51.31,Default,,0,0,0,,О, Шимамуражан
Dialogue: 0,0:17:52.21,0:17:54.22,Default,,0,0,0,,Ол келе жатыр.
Dialogue: 0,0:17:54.37,0:17:55.36,Default,,0,0,0,,Көрші үй жақсы ма?
Dialogue: 0,0:17:55.75,0:17:57.34,Default,,0,0,0,,(Юки) Бірақ Хори, сен мықтысың ғой, иә? (Хидэ Иура) Һмм…
Dialogue: 0,0:17:59.04,0:18:00.21,Default,,0,0,0,,Ум, бұл...
Dialogue: 0,0:18:01.86,0:18:02.68,Default,,0,0,0,,мырза.
Dialogue: 0,0:18:03.24,0:18:05.51,Default,,0,0,0,,Адачи Бұл Адачи.
Dialogue: 0,0:18:05.51,0:18:09.13,Default,,0,0,0,,Мен сенің атыңды ұмытып қалдым, бірақ сыбырлап алдап кетесің деп ойладым.
Dialogue: 0,0:18:11.37,0:18:12.57,Default,,0,0,0,,Сонымен, Адачи мырза?
Dialogue: 0,0:18:13.97,0:18:14.57,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:18:15.16,0:18:16.62,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:18:17.32,0:18:19.13,Default,,0,0,0,,Мектеп асханасы сирек кездеседі.
Dialogue: 0,0:18:19.13,0:18:20.47,Default,,0,0,0,,<Мен де мұндайды жек көрмеймін>
Dialogue: 0,0:18:21.26,0:18:24.09,Default,,0,0,0,,<Екеуінің шулы атмосферасы жаман емес>
Dialogue: 0,0:18:24.77,0:18:28.46,Default,,0,0,0,,<Бастауыш сыныптағы түскі асын есіме түсіріп, аздап сағыныш сезіндім>
Dialogue: 0,0:18:29.58,0:18:34.97,Default,,0,0,0,,＜Алайда мен Шимамурамен оңаша қалғанда маған кедергі болғанын сезіндім.＞
Dialogue: 0,0:18:37.74,0:18:39.00,Default,,0,0,0,,<Бұл басқаша>
Dialogue: 0,0:18:39.64,0:18:43.05,Default,,0,0,0,,<Мен жайсыздықты сезінгенім рас болды.>
Dialogue: 0,0:18:45.40,0:18:47.96,Default,,0,0,0,,Адачи: Түстен кейін не істейсің?
Dialogue: 0,0:18:48.73,0:18:51.44,Default,,0,0,0,,Мм, мен сабаққа барамын.
Dialogue: 0,0:18:51.82,0:18:52.43,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:53.82,0:18:55.26,Default,,0,0,0,,Ах Шимамура
Dialogue: 0,0:18:57.90,0:19:02.59,Default,,0,0,0,,Бүгін Шимамураның үйіне бара аламын ба?
Dialogue: 0,0:19:07.54,0:19:09.62,Default,,0,0,0,,Сонда бұл.
Dialogue: 0,0:19:12.17,0:19:13.18,Default,,0,0,0,,Қош келдіңіз, әпке...
Dialogue: 0,0:19:14.74,0:19:15.84,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:19:16.49,0:19:20.02,Default,,0,0,0,,Мен үйдемін Ах, кешегі досым.
Dialogue: 0,0:19:25.87,0:19:26.81,Default,,0,0,0,,Бір нәрсе үшін кешіріңіз
Dialogue: 0,0:19:27.19,0:19:29.85,Default,,0,0,0,,...
Dialogue: 0,0:19:32.15,0:19:34.36,Default,,0,0,0,,Бөлме бірінші қабатта.
Dialogue: 0,0:19:35.32,0:19:36.60,Default,,0,0,0,,Онда отырыңыз.
Dialogue: 0,0:19:41.28,0:19:42.51,Default,,0,0,0,,А... сонда мен не істеуім керек?
Dialogue: 0,0:19:55.64,0:19:56.55,Default,,0,0,0,,Сол Шимамура
Dialogue: 0,0:19:56.76,0:19:57.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:57.72,0:20:00.33,Default,,0,0,0,,<Айтпа, айтпа, айтпа>
Dialogue: 0,0:20:00.94,0:20:03.42,Default,,0,0,0,,Мен отыра аламын ба?
Dialogue: 0,0:20:05.34,0:20:08.58,Default,,0,0,0,,Шимамураның аяқтарының арасы.
Dialogue: 0,0:20:09.26,0:20:13.13,Default,,0,0,0,,＜  ＞
Dialogue: 0,0:20:13.85,0:20:14.73,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:20:14.85,0:20:16.01,Default,,0,0,0,,＜Жарайды ма? ＞
Dialogue: 0,0:20:18.86,0:20:21.60,Default,,0,0,0,,<Бұл жақсы ма? ＞
Dialogue: 0,0:20:21.94,0:20:25.22,Default,,0,0,0,,<Бұл түс пе? Бұл арман ба? Жарайды ма? ＞
Dialogue: 0,0:20:26.11,0:20:29.24,Default,,0,0,0,,＜…＞
Dialogue: 0,0:20:35.36,0:20:36.28,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:37.26,0:20:38.81,Default,,0,0,0,,Жоқ, себебі...
Dialogue: 0,0:20:46.06,0:20:50.41,Default,,0,0,0,,...
Dialogue: 0,0:20:50.83,0:20:52.46,Default,,0,0,0,,А... бұл қалыпты жағдай.
Dialogue: 0,0:20:53.37,0:20:57.26,Default,,0,0,0,,<Біртүрлі екен, шынымен де біртүрлі! Менің сүйегім ауырады! ＞
Dialogue: 0,0:20:57.58,0:21:02.18,Default,,0,0,0,,＜Әдетте мен кеудемде ауырсынуды сезінемін, бірақ менің жағдайда ол сүйектерімде ауырады＞
Dialogue: 0,0:21:02.52,0:21:07.21,Default,,0,0,0,,＜ ＞
Dialogue: 0,0:21:07.90,0:21:09.08,Default,,0,0,0,,<Мен жайлы болғым келеді>
Dialogue: 0,0:21:10.29,0:21:11.02,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:21:11.55,0:21:12.31,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:21:13.32,0:21:17.35,Default,,0,0,0,,＜＞
Dialogue: 0,0:21:19.85,0:21:21.53,Default,,0,0,0,,《Маған ұнайды》
Dialogue: 0,0:21:24.47,0:21:28.35,Default,,0,0,0,,＜  ＞
Dialogue: 0,0:21:30.80,0:21:33.95,Default,,0,0,0,,《Маған Шимамура ұнайды》
Dialogue: 0,0:21:34.66,0:21:37.61,Default,,0,0,0,,<Мұны істеу мүмкін емес, сен оны істей алмайсың, сен ақымақсың ба?>
Dialogue: 0,0:21:38.08,0:21:40.62,Default,,0,0,0,,<Бұл...>
Dialogue: 0,0:21:41.44,0:21:46.61,Default,,0,0,0,,《Мен... Маған ұнайтын сияқты, мүмкін, мүмкін》
Dialogue: 0,0:21:46.94,0:21:49.16,Default,,0,0,0,,《Ұнады ма? Бұл》 сияқты
Dialogue: 0,0:21:49.88,0:21:51.66,Default,,0,0,0,,<Үлкен ақымақ осылай істейтін еді>
Dialogue: 0,0:21:58.02,0:22:00.14,Default,,0,0,0,,Мм, жақсысың ба?
Dialogue: 0,0:22:00.77,0:22:03.12,Default,,0,0,0,,Тыныс алып жатырсыз ба? Менің бетім ашық қызыл
Dialogue: 0,0:22:12.77,0:22:14.97,Default,,0,0,0,,Нандабашаааа~
Dialogue: 0,0:22:17.17,0:22:20.62,Default,,0,0,0,,Nandabashaa~!
Dialogue: 0,0:22:20.71,0:22:22.70,Default,,0,0,0,,...
Dialogue: 0,0:22:22.70,0:22:25.15,Default,,0,0,0,,<Күн батып, шыққанда>
Dialogue: 0,0:22:25.15,0:22:27.97,Default,,0,0,0,,<Ертең маған келе ме?>
Dialogue: 0,0:23:58.73,0:24:00.89,Default,,0,0,0,,Адашипедия бөтен
Dialogue: 0,0:24:00.89,0:24:02.28,Default,,0,0,0,,Біз жат планеталықтармыз
Dialogue: 0,0:24:02.28,0:24:04.65,Default,,0,0,0,,Шетелдіктердің өздерін жат планеталықтар деп атауы біртүрлі.
Dialogue: 0,0:24:04.65,0:24:05.82,Default,,0,0,0,,(Мицури) Осынша уақыт бойы жынданып кеткен қарындасын қорғап келгенін қарашы…
Dialogue: 0,0:24:05.82,0:24:07.00,Default,,0,0,0,,нақтырақ
Dialogue: 0,0:24:07.00,0:24:09.62,Default,,0,0,0,,Біз емшек жатпыз, кеудеңізді емеміз.
Dialogue: 0,0:24:09.64,0:24:10.78,Default,,0,0,0,,Мен оны қайтарамын.
Dialogue: 0,0:24:11.58,0:24:12.78,Default,,0,0,0,,Мені ұрып-соқты~
Dialogue: 0,0:24:14.28,0:24:20.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
