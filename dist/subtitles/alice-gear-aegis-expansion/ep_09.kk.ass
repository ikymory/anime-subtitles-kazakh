Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:07.17,Default,,0,0,0,,<Уақыт - болашақ, адамзатқа механикалық тіршілік формасы «Вейс» шабуыл жасайды⇒
Dialogue: 0,0:00:07.17,0:00:10.84,Default,,0,0,0,,Жерден қашуға мәжбүр болды.
Dialogue: 0,0:00:10.84,0:00:14.34,Default,,0,0,0,,«Шард» ғарыш кемесі ⇒ тобының қашу процесі кезінде
Dialogue: 0,0:00:14.34,0:00:19.01,Default,,0,0,0,,Вайсқа қарсы тұруға қабілетті «Алиса Тісті» қаруын әзірлеуге қол жеткізді.
Dialogue: 0,0:00:19.01,0:00:23.19,Default,,0,0,0,,Оны манипуляциялай алатын әйелдерді «Актрисалар»⇒ деп атайды
Dialogue: 0,0:00:23.19,0:00:26.52,Default,,0,0,0,,Вайсқа қарсы «AEGiS» ұйымымен бекітілген⇒
Dialogue: 0,0:00:26.52,0:00:31.03,Default,,0,0,0,,Жеке компаниялар Вейсті бағындыра бастады.
Dialogue: 0,0:00:31.03,0:00:36.87,Default,,0,0,0,,Бұл "Алиса Гир" киген қыздар...
Dialogue: 0,0:00:36.87,0:00:39.37,Default,,0,0,0,,Төтенше жағдайдағы арнайы нөмір.
Dialogue: 0,0:00:39.37,0:00:41.70,Default,,0,0,0,,Рин-чан экспедициясы.
Dialogue: 0,0:00:41.70,0:00:44.21,Default,,0,0,0,,Ежелгі жұмбақ тіршілік иесі⇒
Dialogue: 0,0:00:44.21,0:00:46.21,Default,,0,0,0,,Сассиді қу! ! ＞
Dialogue: 0,0:00:48.38,0:00:50.71,Default,,0,0,0,,<Күннен де ыстық капитан!
Dialogue: 0,0:00:50.71,0:00:53.05,Default,,0,0,0,,Хината Рин!
Dialogue: 0,0:00:53.05,0:00:57.39,Default,,0,0,0,,Арнайы техниканы сатып алу мен пайдалануды бізге қалдырыңыз.
Dialogue: 0,0:00:57.39,0:00:59.89,Default,,0,0,0,,Райя Кавасака.
Dialogue: 0,0:00:59.89,0:01:02.82,Default,,0,0,0,,Бейнемаман.
Dialogue: 0,0:01:02.82,0:01:05.83,Default,,0,0,0,,Цзингудзи Мари.
Dialogue: 0,0:01:05.83,0:01:12.17,Default,,0,0,0,,соңғы қатар, топтың жаңа мүшесі Narukozaka Manufacturing-те Kakko PR-ға қатысты.
Dialogue: 0,0:01:12.17,0:01:16.17,Default,,0,0,0,,Йоро Хиразака Нодока Такахата.
Dialogue: 0,0:01:16.17,0:01:20.51,Default,,0,0,0,,Рин-чан экспедициясы әртүрлі жорықтарға шықты.
Dialogue: 0,0:01:20.51,0:01:24.35,Default,,0,0,0,,Бұл жолы олардың зерттейтіні⇒
Dialogue: 0,0:01:24.35,0:01:29.85,Default,,0,0,0,,Сасси, Чичибу Сакура көлінде өмір сүретінін айтқан жұмбақ ежелгі тіршілік иесі! ＞
Dialogue: 0,0:01:29.85,0:01:34.36,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:01:34.36,0:01:38.19,Default,,0,0,0,,<Сасси шынымен бар ма? ?
Dialogue: 0,0:01:38.19,0:01:40.53,Default,,0,0,0,,Осы ғасырдың ең үлкен жұмбағы⇒
Dialogue: 0,0:01:40.53,0:01:43.87,Default,,0,0,0,,Рин-чан экспедициясы жақындады! ＞
Dialogue: 0,0:01:43.87,0:01:46.07,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:01:48.20,0:01:52.04,Default,,0,0,0,,Не? Бұл жерде ерекше қызықты ештеңе жоқ ...
Dialogue: 0,0:01:52.04,0:01:55.38,Default,,0,0,0,,Сасси? Қорқынышты көрінетін құбыжық⇒
Dialogue: 0,0:01:55.38,0:01:58.88,Default,,0,0,0,,Жаман сөз айтуды доғар, доғар.
Dialogue: 0,0:01:58.88,0:02:01.08,Default,,0,0,0,,Бір! (Дубляж) Бұл қауіпті!
Dialogue: 0,0:03:42.35,0:03:45.52,Default,,0,0,0,,<Сайтама Шард Чичибу таулары⇒
Dialogue: 0,0:03:45.52,0:03:48.19,Default,,0,0,0,,Осы зерттелмеген үлкен зерттелмеген аймақта⇒
Dialogue: 0,0:03:48.19,0:03:51.53,Default,,0,0,0,,Рин-чан экспедициясы шығып жатты.
Dialogue: 0,0:03:51.53,0:03:55.70,Default,,0,0,0,,Осы таудың терең жерінде Сасси бар ма?
Dialogue: 0,0:03:55.70,0:03:59.97,Default,,0,0,0,,Мүшелер арасындағы шиеленіс не болса да күшейе берді! ＞
Dialogue: 0,0:03:59.97,0:04:02.30,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:04:02.30,0:04:04.47,Default,,0,0,0,,Тамақ ішейік!
Dialogue: 0,0:04:04.47,0:04:06.81,Default,,0,0,0,,Сіз жаңа ғана түскі ас іштіңіз.
Dialogue: 0,0:04:06.81,0:04:08.81,Default,,0,0,0,,Тамақты күту керек.
Dialogue: 0,0:04:08.81,0:04:10.98,Default,,0,0,0,,Сіз не болатынын ешқашан білмейсіз.
Dialogue: 0,0:04:10.98,0:04:12.98,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:12.98,0:04:16.65,Default,,0,0,0,,Дұрыс! Болашақта бізді қандай дағдарыс күтіп тұр?
Dialogue: 0,0:04:16.65,0:04:19.65,Default,,0,0,0,,Адам жейтін жылан немесе басқа нәрсе. ((Nodoka: Kya~!))
Dialogue: 0,0:04:19.65,0:04:22.49,Default,,0,0,0,,Адам қоректенетін өсімдіктер. ((Сәлем~!))
Dialogue: 0,0:04:22.49,0:04:25.49,Default,,0,0,0,,Каннибал батпағы немесе басқасы. ((Обобо…))
Dialogue: 0,0:04:25.49,0:04:28.83,Default,,0,0,0,,Ым, неге мен ғана жей аламын?
Dialogue: 0,0:04:28.83,0:04:32.50,Default,,0,0,0,,Сонда оны жемей тұрып жеу керек.
Dialogue: 0,0:04:32.50,0:04:34.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:34.50,0:04:36.51,Default,,0,0,0,,Олай болса бәріміз тамақтанайық!
Dialogue: 0,0:04:38.51,0:04:42.84,Default,,0,0,0,,Бәріңе сәлем, мен қатты қобалжымаймын... күрсініп.
Dialogue: 0,0:04:42.84,0:04:45.68,Default,,0,0,0,,Ха! Ах~!
Dialogue: 0,0:04:45.68,0:04:47.85,Default,,0,0,0,,Міне!
Dialogue: 0,0:04:47.85,0:04:50.02,Default,,0,0,0,,<Экспедиция тобын біздің ізашарларымыз құрған⇒
Dialogue: 0,0:04:50.02,0:04:53.36,Default,,0,0,0,,Мен өз өмірімді қатерге тіккен хабарды таптым.
Dialogue: 0,0:04:53.36,0:04:56.36,Default,,0,0,0,,Мүшелер арасында шиеленіс болды>
Dialogue: 0,0:04:56.36,0:04:58.66,Default,,0,0,0,,Хмм….
Dialogue: 0,0:05:00.63,0:05:04.13,Default,,0,0,0,,Түсінемін, бұл қызықтырақ көрінеді!
Dialogue: 0,0:05:04.13,0:05:06.13,Default,,0,0,0,,Эй... Эй, Рин-чан!
Dialogue: 0,0:05:06.13,0:05:08.47,Default,,0,0,0,,Жол көрсеткіші бар, солай ма?
Dialogue: 0,0:05:08.47,0:05:10.64,Default,,0,0,0,,Жабайы Канг шықты!
Dialogue: 0,0:05:10.64,0:05:13.48,Default,,0,0,0,,Хинатачи айтса, бұл рас болуы мүмкін!
Dialogue: 0,0:05:13.48,0:05:15.64,Default,,0,0,0,,Біз де капитанның артынан барамыз!
Dialogue: 0,0:05:15.64,0:05:17.65,Default,,0,0,0,,О! Джулили!
Dialogue: 0,0:05:17.65,0:05:21.48,Default,,0,0,0,,Сондықтан! қарақат….
Dialogue: 0,0:05:21.48,0:05:24.82,Default,,0,0,0,,Мүлдем... Кадрларды дайындаудың мәні неде?
Dialogue: 0,0:05:24.82,0:05:26.82,Default,,0,0,0,,Иә! ? Вахахаха!
Dialogue: 0,0:05:26.82,0:05:29.82,Default,,0,0,0,,Вахахаха!
Dialogue: 0,0:05:29.82,0:05:33.33,Default,,0,0,0,,Хаха... кесіртке?
Dialogue: 0,0:05:33.33,0:05:36.00,Default,,0,0,0,,Аа~ Тағы мені таң қалдырмаңыз~.
Dialogue: 0,0:05:36.00,0:05:38.83,Default,,0,0,0,,<Бір секундта не болатынын білмейміз.
Dialogue: 0,0:05:38.83,0:05:40.84,Default,,0,0,0,,Бұл шытырман оқиға>
Dialogue: 0,0:05:40.84,0:05:44.67,Default,,0,0,0,,Бір минут күтіңіз! ♪ «Рин-чан барлау тобына барыңыз»
Dialogue: 0,0:05:44.67,0:05:50.01,Default,,0,0,0,,♪ "Қыз жылан, улы өрмекші, бұл не? Иә!"
Dialogue: 0,0:05:50.01,0:05:52.01,Default,,0,0,0,,Кя!
Dialogue: 0,0:05:52.01,0:05:54.02,Default,,0,0,0,,Нодока-сан!
Dialogue: 0,0:05:54.02,0:05:59.52,Default,,0,0,0,,Тамақтану~! Іш~!
Dialogue: 0,0:05:59.52,0:06:01.46,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:01.46,0:06:05.13,Default,,0,0,0,,Иә, Жарайды! (Түнгі шық) Иә!
Dialogue: 0,0:06:05.13,0:06:09.30,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:09.30,0:06:11.30,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:06:11.30,0:06:13.64,Default,,0,0,0,,Аю!
Dialogue: 0,0:06:13.64,0:06:16.81,Default,,0,0,0,,Иә! Джули!
Dialogue: 0,0:06:16.81,0:06:20.81,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:20.81,0:06:22.81,Default,,0,0,0,,Аю?
Dialogue: 0,0:06:22.81,0:06:26.82,Default,,0,0,0,,♪～
Dialogue: 0,0:06:26.82,0:06:28.82,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:28.82,0:06:31.99,Default,,0,0,0,,Гурул!
Dialogue: 0,0:06:31.99,0:06:35.29,Default,,0,0,0,,Аю!
Dialogue: 0,0:06:37.49,0:06:40.83,Default,,0,0,0,,Жарайды, жарайды... сүйкімді, сүйкімді. (тәтті дауыс)
Dialogue: 0,0:06:40.83,0:06:44.17,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:06:44.17,0:06:46.17,Default,,0,0,0,,шілде….
Dialogue: 0,0:06:46.17,0:06:49.67,Default,,0,0,0,,♬~
Dialogue: 0,0:06:51.67,0:06:56.68,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:06:56.68,0:06:58.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:58.85,0:07:01.15,Default,,0,0,0,,Қалалық стильдегі ниндзюцу!
Dialogue: 0,0:07:05.12,0:07:07.12,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:07:07.12,0:07:11.79,Default,,0,0,0,,Аспанның қанаты! Вахахаха!
Dialogue: 0,0:07:11.79,0:07:16.63,Default,,0,0,0,,<Көптеген қиындықтардан өткеннен кейін, Рин-Чан экспедициясы ақыры жетті⇒
Dialogue: 0,0:07:16.63,0:07:18.63,Default,,0,0,0,,Біз Сакура көліне келдік.
Dialogue: 0,0:07:18.63,0:07:21.30,Default,,0,0,0,,Бір қарағанда кәдімгі көл сияқты⇒
Dialogue: 0,0:07:21.30,0:07:25.81,Default,,0,0,0,,Бұл жерде ежелгі жаратылыс Сасси жасырынып жатыр>
Dialogue: 0,0:07:25.81,0:07:27.81,Default,,0,0,0,,Ух... хаха...
Dialogue: 0,0:07:27.81,0:07:30.98,Default,,0,0,0,,Бұл қайда! Сасси шығыңыз!
Dialogue: 0,0:07:30.98,0:07:34.82,Default,,0,0,0,,Жоспарланған маршрут бойынша жүрсем, оңайырақ болар еді.
Dialogue: 0,0:07:34.82,0:07:37.82,Default,,0,0,0,,көрсетілмейді...
Dialogue: 0,0:07:37.82,0:07:40.66,Default,,0,0,0,,Оны қалай ұстауға болады? Хмм….
Dialogue: 0,0:07:40.66,0:07:43.33,Default,,0,0,0,,Онда бәрібір! иә? Джули?
Dialogue: 0,0:07:43.33,0:07:45.33,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:45.33,0:07:50.50,Default,,0,0,0,,♪ (халық музыкасы)
Dialogue: 0,0:07:50.50,0:07:52.83,Default,,0,0,0,,♪ «Ақылсыз».
Dialogue: 0,0:07:52.83,0:07:55.34,Default,,0,0,0,,♪ «Ақылсыз».
Dialogue: 0,0:07:55.34,0:07:58.01,Default,,0,0,0,,♪ «Келіңіз».
Dialogue: 0,0:07:58.01,0:08:00.78,Default,,0,0,0,,♪ «Қош келдіңіз»
Dialogue: 0,0:08:00.78,0:08:04.78,Default,,0,0,0,,♪ «Донғара бақылаушы чача»
Dialogue: 0,0:08:04.78,0:08:07.28,Default,,0,0,0,,♪ «Хоньяра»
Dialogue: 0,0:08:07.28,0:08:10.79,Default,,0,0,0,,Ақыры солай бола бастады.
Dialogue: 0,0:08:13.46,0:08:17.46,Default,,0,0,0,,((Таза қыз дұға етеді.
Dialogue: 0,0:08:17.46,0:08:23.63,Default,,0,0,0,,Сол ойға Сасси шығады))
Dialogue: 0,0:08:23.63,0:08:26.47,Default,,0,0,0,,Ақсақал да осылай деді.
Dialogue: 0,0:08:26.47,0:08:28.97,Default,,0,0,0,,Өзіңізді қыз сияқты сезініңіз!
Dialogue: 0,0:08:28.97,0:08:31.47,Default,,0,0,0,,Жақсы, жақсы, екеуің де! ♪ "Сасси"
Dialogue: 0,0:08:31.47,0:08:34.98,Default,,0,0,0,,Мұны қанша уақыт істеуім керек?
Dialogue: 0,0:08:34.98,0:08:37.48,Default,,0,0,0,,Нодока-сан. иә?
Dialogue: 0,0:08:37.48,0:08:39.81,Default,,0,0,0,,Қолымыздан келгеннің бәрін жасайық.
Dialogue: 0,0:08:39.81,0:08:43.65,Default,,0,0,0,,Иә! ♪ "Мұнда кел!"
Dialogue: 0,0:08:43.65,0:08:45.65,Default,,0,0,0,,♪ «Ақылсыз»
Dialogue: 0,0:08:45.65,0:08:48.16,Default,,0,0,0,,Хехе, бұл қызық көрінеді!
Dialogue: 0,0:08:48.16,0:08:50.99,Default,,0,0,0,,Мен де істеймін!
Dialogue: 0,0:08:50.99,0:08:53.50,Default,,0,0,0,,А? (Райя) А, бұл! (қатты дыбыс)
Dialogue: 0,0:08:55.66,0:08:57.67,Default,,0,0,0,,Сасси!
Dialogue: 0,0:08:57.67,0:09:00.60,Default,,0,0,0,,Ли Сасси шынымен де болған.
Dialogue: 0,0:09:00.60,0:09:03.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:03.44,0:09:05.94,Default,,0,0,0,,Ах! А, жоқ, бұл...
Dialogue: 0,0:09:05.94,0:09:08.28,Default,,0,0,0,,Ей, біз ақыры кездестік, Сасси!
Dialogue: 0,0:09:08.28,0:09:10.28,Default,,0,0,0,,Қане, бәріміз ұстайық!
Dialogue: 0,0:09:10.28,0:09:12.28,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:09:12.28,0:09:16.79,Default,,0,0,0,,< Ақырында Сасси пайда болады. Адамзат табиғатқа қарсы!
Dialogue: 0,0:09:16.79,0:09:20.12,Default,,0,0,0,,Енді шайқас шымылдығы кесілді>
Dialogue: 0,0:09:20.12,0:09:23.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:23.63,0:09:25.79,Default,,0,0,0,,Уау, бұл мүлдем жұмыс істемейді.
Dialogue: 0,0:09:25.79,0:09:28.96,Default,,0,0,0,,Шикараба! Қалалық стильдегі ниндзюцу!
Dialogue: 0,0:09:28.96,0:09:32.47,Default,,0,0,0,,6 ұңғылы ату! Жіберу!
Dialogue: 0,0:09:38.47,0:09:41.98,Default,,0,0,0,,Жоқ! Тіпті қалалық стильдегі ниндзюцу да сәйкес келмейді!
Dialogue: 0,0:09:41.98,0:09:43.98,Default,,0,0,0,,Біз де күресейік!
Dialogue: 0,0:09:43.98,0:09:46.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:51.99,0:09:53.99,Default,,0,0,0,,Асықпаңыз.
Dialogue: 0,0:09:53.99,0:09:56.16,Default,,0,0,0,,Балық аулау – табиғатпен күрес.
Dialogue: 0,0:09:56.16,0:09:58.16,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:58.16,0:10:01.66,Default,,0,0,0,,Набула мен құстар отарын қалай құруға болады ⇒
Dialogue: 0,0:10:01.66,0:10:05.00,Default,,0,0,0,,Атап айтқанда, балықшылардың қозғалысы ең маңызды...
Dialogue: 0,0:10:05.00,0:10:07.50,Default,,0,0,0,,Ах. Джули!
Dialogue: 0,0:10:10.00,0:10:12.01,Default,,0,0,0,,Джулили!
Dialogue: 0,0:10:12.01,0:10:15.51,Default,,0,0,0,,Юри? Цуририри!
Dialogue: 0,0:10:15.51,0:10:19.51,Default,,0,0,0,,Саймон! иә!
Dialogue: 0,0:10:19.51,0:10:21.52,Default,,0,0,0,,Гуоо~.
Dialogue: 0,0:10:24.19,0:10:27.39,Default,,0,0,0,,Хмм... Даа~!
Dialogue: 0,0:10:29.52,0:10:33.63,Default,,0,0,0,,Уууу! Мен оны түсіндім!
Dialogue: 0,0:10:36.36,0:10:39.20,Default,,0,0,0,,Қосымша~. Юрири~.
Dialogue: 0,0:10:39.20,0:10:43.04,Default,,0,0,0,,Иә! Бірақ бұл мысық балық...
Dialogue: 0,0:10:43.04,0:10:46.04,Default,,0,0,0,,Юрири….
Dialogue: 0,0:10:46.04,0:10:49.88,Default,,0,0,0,,<Соңында біз Сассын таба алмадық.
Dialogue: 0,0:10:49.88,0:10:54.05,Default,,0,0,0,,Бірақ бізде белгісізге батылдықпен кіру керек⇒
Dialogue: 0,0:10:54.05,0:10:57.22,Default,,0,0,0,,Бір күні кездесетінімізге сенімдімін.
Dialogue: 0,0:10:57.22,0:11:01.49,Default,,0,0,0,,Сол күнге дейін Рин-чан экспедициясының шақыруы жалғасады! ＞
Dialogue: 0,0:11:01.49,0:11:04.99,Default,,0,0,0,,Иә, иә, мен бұл жолы да жақсы суретке түсіре алдым.
Dialogue: 0,0:11:04.99,0:11:07.66,Default,,0,0,0,,Не? Вахахаха!
Dialogue: 0,0:11:07.66,0:11:11.00,Default,,0,0,0,,Вахахаха!
Dialogue: 0,0:11:11.00,0:11:14.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:14.00,0:11:16.60,Default,,0,0,0,,Осы уақытқа дейін менің соңымнан жүрдің бе?
Dialogue: 0,0:11:19.51,0:11:21.51,Default,,0,0,0,,Бұл қызықты болды.
Dialogue: 0,0:11:21.51,0:11:23.51,Default,,0,0,0,,Тағы бірге зерттейік!
Dialogue: 0,0:11:23.51,0:11:25.51,Default,,0,0,0,,Келесі жолы қайда барамыз?
Dialogue: 0,0:11:25.51,0:11:27.85,Default,,0,0,0,,Сол кезде бізге қосылыңыз!
Dialogue: 0,0:11:27.85,0:11:31.19,Default,,0,0,0,,Йоро-сан кетсе, мен де кетемін! Юрири!
Dialogue: 0,0:11:31.19,0:11:34.39,Default,,0,0,0,,Келесі жолы дайындықты назардан тыс қалдырмайсыз деп үміттенемін.
Dialogue: 0,0:11:36.36,0:11:39.36,Default,,0,0,0,,...
Dialogue: 0,0:11:46.53,0:11:48.54,Default,,0,0,0,,Гуоооо.
Dialogue: 0,0:11:48.54,0:11:50.54,Default,,0,0,0,,Күйкүй.
Dialogue: 0,0:11:50.54,0:11:53.04,Default,,0,0,0,,<Рин-чан экспедициясы жолға шықты!
Dialogue: 0,0:11:53.04,0:11:56.21,Default,,0,0,0,,Ол жерде белгісіз тіршілік иелері бар болса!
Dialogue: 0,0:11:56.21,0:11:59.41,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, берілме, Рин-чан экспедиция командасы! ＞
Dialogue: 0,0:12:01.32,0:12:03.99,Default,,0,0,0,,Уау~ Бұл не?
Dialogue: 0,0:12:03.99,0:12:07.32,Default,,0,0,0,,Жүні үлпілдек. (Түнгі шық) Тұлыпқа ұқсайды.
Dialogue: 0,0:12:07.32,0:12:09.99,Default,,0,0,0,,Бәріңе сәлем. иә?
Dialogue: 0,0:12:09.99,0:12:12.49,Default,,0,0,0,,Сіз әлі осындасыз ба?
Dialogue: 0,0:12:12.49,0:12:15.83,Default,,0,0,0,,Бүгін бәріміз кеңсені жинаймыз...
Dialogue: 0,0:12:15.83,0:12:18.03,Default,,0,0,0,,Мофф?
Dialogue: 0,0:12:20.00,0:12:23.00,Default,,0,0,0,,《…》
Dialogue: 0,0:12:23.00,0:12:25.51,Default,,0,0,0,,Сүйкімді….
Dialogue: 0,0:12:25.51,0:12:28.84,Default,,0,0,0,,Бұл өте жұмсақ.
Dialogue: 0,0:12:28.84,0:12:32.35,Default,,0,0,0,,Йоро-сан, сен бұл қызды қашан кездестірдің?
Dialogue: 0,0:12:32.35,0:12:36.52,Default,,0,0,0,,Расында, Рин және басқалармен бірге экспедициядан қайтар жолда.
Dialogue: 0,0:12:36.52,0:12:39.02,Default,,0,0,0,,Мен жалғыз және өте әлсіз болдым⇒
Dialogue: 0,0:12:39.02,0:12:41.69,Default,,0,0,0,,Мен оны аядым...
Dialogue: 0,0:12:41.69,0:12:44.19,Default,,0,0,0,,Мен оны үйге жасырын алып келдім.
Dialogue: 0,0:12:44.19,0:12:46.86,Default,,0,0,0,,Сәлем, Мофф. Мофф!
Dialogue: 0,0:12:46.86,0:12:49.03,Default,,0,0,0,,Бұл баланың аты Мофу ма?
Dialogue: 0,0:12:49.03,0:12:51.87,Default,,0,0,0,,Иә, бұл үлпілдек болғандықтан, бұл үлпілдек!
Dialogue: 0,0:12:51.87,0:12:55.20,Default,,0,0,0,,Оңай! Бірақ маған ұнайтыны сол.
Dialogue: 0,0:12:55.20,0:12:59.04,Default,,0,0,0,,Ой, жабайы жануарларды рұқсатсыз әкелуге болмайды.
Dialogue: 0,0:12:59.04,0:13:00.98,Default,,0,0,0,,Оны тезірек тауға қайтар.
Dialogue: 0,0:13:00.98,0:13:03.81,Default,,0,0,0,,Жақсы, өте сүйкімді.
Dialogue: 0,0:13:03.81,0:13:06.31,Default,,0,0,0,,Мофф-чан сізді сауықтырсын.
Dialogue: 0,0:13:06.31,0:13:08.82,Default,,0,0,0,,Ihi ~ Демалу ~. Мофф~
Dialogue: 0,0:13:08.82,0:13:13.49,Default,,0,0,0,,Хмм... Жарайды, мен Каоруко-санға жақсылап айтамын.
Dialogue: 0,0:13:13.49,0:13:16.16,Default,,0,0,0,,Рахмет, Фумика мырза.
Dialogue: 0,0:13:16.16,0:13:18.83,Default,,0,0,0,,Ал егер Мофф тұмарға айналса⇒
Dialogue: 0,0:13:18.83,0:13:21.16,Default,,0,0,0,,Бұл Сейкозака үшін PR болады.
Dialogue: 0,0:13:21.16,0:13:24.00,Default,,0,0,0,,Бір станция бастығының мысығы сияқты.
Dialogue: 0,0:13:24.00,0:13:28.00,Default,,0,0,0,,Жоқ, жоқ, егер Сейкозаканың бойтұмары туралы айтып жатсаңыз, Саймон Чан бар!
Dialogue: 0,0:13:28.00,0:13:30.17,Default,,0,0,0,,Сиририри! Ах.
Dialogue: 0,0:13:30.17,0:13:32.84,Default,,0,0,0,,Мофф~.
Dialogue: 0,0:13:32.84,0:13:35.34,Default,,0,0,0,,《Тунк… Какеру 2…》
Dialogue: 0,0:13:35.34,0:13:37.35,Default,,0,0,0,,күрсіну. Джули?
Dialogue: 0,0:13:37.35,0:13:41.35,Default,,0,0,0,,Уау.
Dialogue: 0,0:13:41.35,0:13:43.35,Default,,0,0,0,,Джули~! ?
Dialogue: 0,0:13:43.35,0:13:45.35,Default,,0,0,0,,Хмм….
Dialogue: 0,0:13:45.35,0:13:47.36,Default,,0,0,0,,Маған да сені ұстауға рұқсат бересің бе?
Dialogue: 0,0:13:47.36,0:13:49.36,Default,,0,0,0,,Иә, өтінемін!
Dialogue: 0,0:13:49.36,0:13:52.69,Default,,0,0,0,,Мофф! Мо! иә? Мофф?
Dialogue: 0,0:13:52.69,0:13:57.20,Default,,0,0,0,,Хаха~ Көзілдірік киген қыздар ұнатпайтын сияқты.
Dialogue: 0,0:13:57.20,0:14:01.47,Default,,0,0,0,,Хмм... Одан гөрі тазалағаным артық.
Dialogue: 0,0:14:01.47,0:14:04.14,Default,,0,0,0,,Жарайды, жарайды, сен жақсы қызсың, Мофф.
Dialogue: 0,0:14:04.14,0:14:07.98,Default,,0,0,0,,Хмм…. Енді менің кезегім, Яро-сан!
Dialogue: 0,0:14:07.98,0:14:11.48,Default,,0,0,0,,《Осылайша, жұмбақ жануар Мофф⇒
Dialogue: 0,0:14:11.48,0:14:13.65,Default,,0,0,0,,Мен Сейкозакаға келдім.
Dialogue: 0,0:14:13.65,0:14:17.49,Default,,0,0,0,,Сүйкімді мофу барған сайын қызыға бастады.
Dialogue: 0,0:14:17.49,0:14:20.49,Default,,0,0,0,,Бірақ мен қандаймын...》
Dialogue: 0,0:14:25.16,0:14:28.66,Default,,0,0,0,,Саған көзілдірік киген қыздың несі ұнамайды?
Dialogue: 0,0:14:28.66,0:14:31.57,Default,,0,0,0,,Сізге сәл ғана қол тигізуге рұқсат етсеңіз ғой!
Dialogue: 0,0:14:33.50,0:14:36.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:36.00,0:14:39.51,Default,,0,0,0,,Сондай-ақ! Қосалқы жуғыш зат сақтаңыз...
Dialogue: 0,0:14:39.51,0:14:42.61,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:14:45.18,0:14:47.18,Default,,0,0,0,,Хмм?
Dialogue: 0,0:14:49.18,0:14:51.19,Default,,0,0,0,,Мофф?
Dialogue: 0,0:14:53.19,0:14:55.69,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:55.69,0:14:57.69,Default,,0,0,0,,бұл….
Dialogue: 0,0:14:59.69,0:15:02.46,Default,,0,0,0,,Иә? Мофф-чан!
Dialogue: 0,0:15:02.46,0:15:05.47,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:15:05.47,0:15:07.57,Default,,0,0,0,,Мофф~!
Dialogue: 0,0:15:10.14,0:15:12.64,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:15:15.14,0:15:19.15,Default,,0,0,0,,Мофф-чан өте ащы адам.
Dialogue: 0,0:15:19.15,0:15:21.65,Default,,0,0,0,,Чили соусын қатты жақсы көретініме сене алар емеспін.
Dialogue: 0,0:15:21.65,0:15:25.15,Default,,0,0,0,,Бұл да сүйкімді. Бұл дұрыс.
Dialogue: 0,0:15:25.15,0:15:28.49,Default,,0,0,0,,Юрири~! Джулили!
Dialogue: 0,0:15:28.49,0:15:30.49,Default,,0,0,0,,үшін…. иә?
Dialogue: 0,0:15:30.49,0:15:34.50,Default,,0,0,0,,Меніңше, соншалықты үлпілдек боламын деп уайымдамаған дұрыс.
Dialogue: 0,0:15:34.50,0:15:37.00,Default,,0,0,0,,Мазаламау деген нені білдіреді?
Dialogue: 0,0:15:37.00,0:15:39.00,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,0:15:39.00,0:15:42.00,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:15:42.00,0:15:44.01,Default,,0,0,0,,үшін...
Dialogue: 0,0:15:44.01,0:15:46.01,Default,,0,0,0,,Иә? иә….
Dialogue: 0,0:15:46.01,0:15:48.01,Default,,0,0,0,,Моффқа не болды?
Dialogue: 0,0:15:48.01,0:15:50.51,Default,,0,0,0,,Иә! Қараңдар, қараңдар! иә?
Dialogue: 0,0:15:50.51,0:15:53.01,Default,,0,0,0,,Бұл не? Эй! Қараңдар, қараңдар!
Dialogue: 0,0:15:53.01,0:15:56.52,Default,,0,0,0,,Хмм... мм... хмм?
Dialogue: 0,0:15:56.52,0:15:59.85,Default,,0,0,0,,Не? Фумика: Моффпен флирт жасағың келе ме?
Dialogue: 0,0:15:59.85,0:16:02.46,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:16:02.46,0:16:06.29,Default,,0,0,0,,Көңілсіздік! Қанша дегенмен Мофф маған үйренбейді!
Dialogue: 0,0:16:06.29,0:16:08.80,Default,,0,0,0,,Бұл қорқынышты, Фумика-сан! Мофф...
Dialogue: 0,0:16:08.80,0:16:11.80,Default,,0,0,0,,Уф….
Dialogue: 0,0:16:11.80,0:16:13.80,Default,,0,0,0,,Мофф…. 《Фумика: Бірақ⇒
Dialogue: 0,0:16:13.80,0:16:16.80,Default,,0,0,0,,Бұл оғашлықтың соңы емес еді.
Dialogue: 0,0:16:16.80,0:16:19.81,Default,,0,0,0,,Жоқ, бұл бастама болды》
Dialogue: 0,0:16:22.98,0:16:24.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:24.98,0:16:27.32,Default,,0,0,0,,Бәріңе?
Dialogue: 0,0:16:27.32,0:16:30.82,Default,,0,0,0,,Мофф…. а….
Dialogue: 0,0:16:30.82,0:16:32.82,Default,,0,0,0,,Мофф….
Dialogue: 0,0:16:32.82,0:16:35.49,Default,,0,0,0,,Мофф….
Dialogue: 0,0:16:35.49,0:16:38.83,Default,,0,0,0,,Мофф….
Dialogue: 0,0:16:38.83,0:16:41.66,Default,,0,0,0,,Цуририри! Саймон! ?
Dialogue: 0,0:16:41.66,0:16:43.66,Default,,0,0,0,,Ағаш….
Dialogue: 0,0:16:43.66,0:16:46.57,Default,,0,0,0,,Иә? Бұл қандай жүн?
Dialogue: 0,0:16:51.34,0:16:53.34,Default,,0,0,0,,бұл….
Dialogue: 0,0:16:57.35,0:17:00.28,Default,,0,0,0,,Мофф….
Dialogue: 0,0:17:00.28,0:17:02.62,Default,,0,0,0,,Бұл Моффтың жұмысы болса керек.
Dialogue: 0,0:17:02.62,0:17:04.62,Default,,0,0,0,,Чупичупи.
Dialogue: 0,0:17:04.62,0:17:09.29,Default,,0,0,0,,📱 (Полиция) А? Чили соусындағы пушистый ма? Сен не туралы айтып тұрсың?
Dialogue: 0,0:17:09.29,0:17:12.63,Default,,0,0,0,,Сонымен! Құбыжықтар Сейкозакада барлығына шабуыл жасайды!
Dialogue: 0,0:17:12.63,0:17:15.13,Default,,0,0,0,,Бұлай жалғаса берсе, бәрі жынды болады...
Dialogue: 0,0:17:15.13,0:17:20.13,Default,,0,0,0,,📱 (Полиция) Полицияның да уақыты жоқ. Басқа жерде қалжыңдық қоңырауларды өңдеңіз.
Dialogue: 0,0:17:20.13,0:17:22.80,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:17:22.80,0:17:24.81,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:17:24.81,0:17:26.81,Default,,0,0,0,,Бұл үшін бірдеңе істеуден басқа амалымыз жоқ.
Dialogue: 0,0:17:26.81,0:17:28.81,Default,,0,0,0,,Юрири!
Dialogue: 0,0:17:33.48,0:17:35.98,Default,,0,0,0,,Мұнда ешкім жоқ. Джули...
Dialogue: 0,0:17:39.49,0:17:41.59,Default,,0,0,0,,Хмм….
Dialogue: 0,0:17:46.99,0:17:49.00,Default,,0,0,0,,Мофф, сен қайда бардың...
Dialogue: 0,0:17:49.00,0:17:51.00,Default,,0,0,0,,Уау! Джули! ? Мофф...
Dialogue: 0,0:17:51.00,0:17:53.00,Default,,0,0,0,,Ситара! ?
Dialogue: 0,0:17:53.00,0:17:55.00,Default,,0,0,0,,Мофу… Мофу….
Dialogue: 0,0:17:55.00,0:17:57.67,Default,,0,0,0,,Яро-сан мен Нодока-сан да Уау!
Dialogue: 0,0:17:57.67,0:18:00.27,Default,,0,0,0,,Балалар, ояныңдар!
Dialogue: 0,0:18:00.27,0:18:02.61,Default,,0,0,0,,үшінн Мофф басқарады!
Dialogue: 0,0:18:02.61,0:18:05.61,Default,,0,0,0,,Хмм! Юри~!
Dialogue: 0,0:18:05.61,0:18:07.95,Default,,0,0,0,,Мофф! Юрири!
Dialogue: 0,0:18:07.95,0:18:10.25,Default,,0,0,0,,Мофф! Джули!
Dialogue: 0,0:18:13.45,0:18:15.46,Default,,0,0,0,,Чупи….
Dialogue: 0,0:18:15.46,0:18:18.29,Default,,0,0,0,,(Жылаған дауыс)
Dialogue: 0,0:18:18.29,0:18:21.80,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,0:18:21.80,0:18:23.80,Default,,0,0,0,,Мофф…. иә?
Dialogue: 0,0:18:23.80,0:18:26.63,Default,,0,0,0,,Мофф….
Dialogue: 0,0:18:26.63,0:18:38.81,Default,,0,0,0,,♪～
Dialogue: 0,0:18:38.81,0:18:40.82,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:18:43.65,0:18:47.32,Default,,0,0,0,,Бумуу~!
Dialogue: 0,0:18:47.32,0:18:50.52,Default,,0,0,0,,Ха! Буммомо…
Dialogue: 0,0:18:53.66,0:18:57.50,Default,,0,0,0,,Ууу~!
Dialogue: 0,0:18:57.50,0:19:03.10,Default,,0,0,0,,(Тыныс алу жүгіру)
Dialogue: 0,0:19:03.10,0:19:05.11,Default,,0,0,0,,Бумо…. (Тыныс алу жүгіру)
Dialogue: 0,0:19:05.11,0:19:07.11,Default,,0,0,0,,(Тыныс алу жүгіру)
Dialogue: 0,0:19:07.11,0:19:09.11,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:19:09.11,0:19:12.28,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:19:12.28,0:19:15.28,Default,,0,0,0,,《Мен бұлай жалғастыра алмаймын... Ол туралы бірдеңе істе...⇒
Dialogue: 0,0:19:15.28,0:19:17.62,Default,,0,0,0,,Мен Моффты жеңуім керек...
Dialogue: 0,0:19:17.62,0:19:19.95,Default,,0,0,0,,Бірақ қалай...
Dialogue: 0,0:19:19.95,0:19:21.96,Default,,0,0,0,,А, мүмкін...》
Dialogue: 0,0:19:24.13,0:19:27.13,Default,,0,0,0,,Бумо….
Dialogue: 0,0:19:27.13,0:19:30.13,Default,,0,0,0,,Буммомо….
Dialogue: 0,0:19:30.13,0:19:32.53,Default,,0,0,0,,Бағана. ➡
Dialogue: 0,0:19:34.47,0:19:36.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:36.47,0:19:39.97,Default,,0,0,0,,Бумомо! Апыр-ай!
Dialogue: 0,0:19:39.97,0:19:43.64,Default,,0,0,0,,Хмм….
Dialogue: 0,0:19:43.64,0:19:46.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:46.65,0:19:48.65,Default,,0,0,0,,Бар!
Dialogue: 0,0:19:48.65,0:19:54.66,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:19:54.66,0:19:58.33,Default,,0,0,0,,Күтілгендей! Сіздің әлсіздігіңіз жуғыш зат болды!
Dialogue: 0,0:19:58.33,0:20:01.83,Default,,0,0,0,,Бәрін ертерек көргенде, мүмкін деп ойладым.
Dialogue: 0,0:20:01.83,0:20:05.50,Default,,0,0,0,,Ол кезде де жуғыш заты бар қолғапты жек көретінсіз!
Dialogue: 0,0:20:05.50,0:20:11.51,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:20:11.51,0:20:14.34,Default,,0,0,0,,Енді ол таза және сергітеді!
Dialogue: 0,0:20:14.34,0:20:19.85,Default,,0,0,0,,Ууу~!
Dialogue: 0,0:20:19.85,0:20:22.52,Default,,0,0,0,,Буммо… Буммо….
Dialogue: 0,0:20:22.52,0:20:26.02,Default,,0,0,0,,Бумо….
Dialogue: 0,0:20:26.02,0:20:29.02,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:20:29.02,0:20:32.03,Default,,0,0,0,,Хмм…. (Фумика) Жақсысың ба?
Dialogue: 0,0:20:32.03,0:20:34.36,Default,,0,0,0,,Фумика мырза….
Dialogue: 0,0:20:34.36,0:20:38.03,Default,,0,0,0,,Иә? Мен неге мұндамын?
Dialogue: 0,0:20:38.03,0:20:40.03,Default,,0,0,0,,Ештеңе есіңде жоқ сияқты.
Dialogue: 0,0:20:40.03,0:20:42.20,Default,,0,0,0,,Өйткені қиын болды. Мен жақсы ұйықтаған сияқтымын ...
Dialogue: 0,0:20:42.20,0:20:44.21,Default,,0,0,0,,Джулили. О Саймон.
Dialogue: 0,0:20:44.21,0:20:47.21,Default,,0,0,0,,Хахаха…. Ах.
Dialogue: 0,0:20:47.21,0:20:50.04,Default,,0,0,0,,бастап!
Dialogue: 0,0:20:50.04,0:20:54.22,Default,,0,0,0,,Сіз шынымен оянған сияқтысыз.
Dialogue: 0,0:20:54.22,0:20:58.05,Default,,0,0,0,,Хмм, Фумика-сан, қазір ойлап қарасам, Мофф қайда?
Dialogue: 0,0:20:58.05,0:20:59.99,Default,,0,0,0,,Иә... (Түнгі шық және т.б.) Иә?
Dialogue: 0,0:20:59.99,0:21:03.79,Default,,0,0,0,,Ол тауға қайтып келген болуы керек...
Dialogue: 0,0:21:06.16,0:21:09.66,Default,,0,0,0,,《Бунка: Осылайша Сейкозаканың қорқынышты түсі аяқталды.
Dialogue: 0,0:21:09.66,0:21:13.67,Default,,0,0,0,,Бірақ барлығыңыз сақ болыңыздар.
Dialogue: 0,0:21:13.67,0:21:17.51,Default,,0,0,0,,Сүйкімді болғандықтан сіз білмейтін жануарлар⇒
Dialogue: 0,0:21:17.51,0:21:20.34,Default,,0,0,0,,Мені рұқсатсыз үйге апармаңыз》
Dialogue: 0,0:21:20.34,0:21:22.34,Default,,0,0,0,,Муф.
Dialogue: 0,0:22:55.70,0:22:58.04,Default,,0,0,0,,Менің арқам кенет жарылғанда ⇒
Dialogue: 0,0:22:58.04,0:23:01.98,Default,,0,0,0,,Сол кезде қорқынышты құбыжық пайда болды!
Dialogue: 0,0:23:01.98,0:23:04.65,Default,,0,0,0,,Әй, солай болды.
Dialogue: 0,0:23:04.65,0:23:07.31,Default,,0,0,0,,Әлгі құбыжық маған шабуыл жасады⇒
Dialogue: 0,0:23:07.31,0:23:10.82,Default,,0,0,0,,Көмек келмеді, жағдай қиындап кетті.
Dialogue: 0,0:23:10.82,0:23:13.65,Default,,0,0,0,,Әй, солай болды.
Dialogue: 0,0:23:13.65,0:23:17.49,Default,,0,0,0,,Сенесің бе? менің оқиғам.
Dialogue: 0,0:23:17.49,0:23:20.10,Default,,0,0,0,,Оның орнына мен жаңа мәзір жасадым⇒
Dialogue: 0,0:23:20.10,0:23:23.33,Default,,0,0,0,,Біреуін қалайсыз ба?
Dialogue: 0,0:23:23.33,0:23:26.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:26.17,0:23:29.17,Default,,0,0,0,,А... мүмкін емес.
Dialogue: 0,0:23:31.84,0:23:33.84,Default,,0,0,0,,Мофф.
Dialogue: 0,0:23:35.34,0:23:41.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
