Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:06.82,0:02:08.82,Default,,0000,0000,0000,,Қазір жаз...
Dialogue: 0,0:02:10.02,0:02:14.55,Default,,0000,0000,0000,,Өлгім келеді... Қараңғы, Тоору.
Dialogue: 0,0:02:14.55,0:02:17.55,Default,,0000,0000,0000,,Жаз болып қалды, ендеше жағажайға барайық! Эй.
Dialogue: 0,0:02:18.76,0:02:22.30,Default,,0000,0000,0000,,Мен өзімнің бейшара денемді көпшілік алдында осылай көрсеткім келмейді.
Dialogue: 0,0:02:22.30,0:02:25.50,Default,,0000,0000,0000,,Қазірдің өзінде! Сіз тым көп көңіл бөлесіз.
Dialogue: 0,0:02:25.50,0:02:27.85,Default,,0000,0000,0000,,Өйткені әр адамның өзіндік даралық →
Dialogue: 0,0:02:27.85,0:02:32.73,Default,,0000,0000,0000,,Сізге тек осы мүмкіндікті пайдалану керек. Run-chan...
Dialogue: 0,0:02:32.73,0:02:35.93,Default,,0000,0000,0000,,Кейбір маньяктар айтады.
Dialogue: 0,0:02:35.93,0:02:37.12,Default,,0000,0000,0000,,Сізге бұл қажет емес!
Dialogue: 0,0:02:37.12,0:02:50.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:52.77,0:03:03.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:03.05,0:03:08.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:11.46,0:03:18.36,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:18.36,0:03:22.36,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:24.76,0:03:35.37,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:35.37,0:03:43.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:43.11,0:03:50.02,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:50.02,0:03:54.02,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:58.60,0:04:07.60,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:08.20,0:04:10.55,Default,,0000,0000,0000,,Я~! Мұндай Торуға →
Dialogue: 0,0:04:10.55,0:04:14.26,Default,,0000,0000,0000,,Мен купальник сатып алдым! Ха!
Dialogue: 0,0:04:14.26,0:04:17.62,Default,,0000,0000,0000,,Мен ең кіші өлшемді таңдадым →
Dialogue: 0,0:04:17.62,0:04:19.31,Default,,0000,0000,0000,,Енді теңізге барайық.
Dialogue: 0,0:04:19.31,0:04:21.31,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:04:23.51,0:04:27.88,Default,,0000,0000,0000,,Бұл сізге міндетті түрде сәйкес келуі керек! Әй, байқап көріңіз.
Dialogue: 0,0:04:27.88,0:04:30.25,Default,,0000,0000,0000,,Ух... иә.
Dialogue: 0,0:04:30.25,0:04:33.78,Default,,0000,0000,0000,,Уау, бұл тамаша!
Dialogue: 0,0:04:33.78,0:04:37.78,Default,,0000,0000,0000,,Бірақ бұл сәл бос...
Dialogue: 0,0:04:40.18,0:04:44.56,Default,,0000,0000,0000,,Кешіріңіз. Мен балмұздақ сатып алдым. Сонымен...
Dialogue: 0,0:04:44.56,0:04:46.56,Default,,0000,0000,0000,,Уау... (Юко) Не?
Dialogue: 0,0:04:48.26,0:04:51.12,Default,,0000,0000,0000,,Тоору! Тіпті балмұздақ.
Dialogue: 0,0:04:51.12,0:04:53.14,Default,,0000,0000,0000,,Жоқ... енді... ештеңе кірмейді.
Dialogue: 0,0:04:53.14,0:04:55.17,Default,,0000,0000,0000,,Эй Тоору, не болды?
Dialogue: 0,0:04:55.17,0:04:58.87,Default,,0000,0000,0000,,Хмм, аздап. Әй, мына балмұздақ→
Dialogue: 0,0:04:58.87,0:05:02.40,Default,,0000,0000,0000,,Биыл шыққаны, солай ма? Мен оны сынап көргім келді.
Dialogue: 0,0:05:02.40,0:05:04.76,Default,,0000,0000,0000,,Сатып алғанда мен де солай ойладым.
Dialogue: 0,0:05:04.76,0:05:08.13,Default,,0000,0000,0000,,Қандай таңғаларлық сәйкестік. (Юко) Жартысын қалайсыз ба?
Dialogue: 0,0:05:08.13,0:05:10.13,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:05:12.17,0:05:14.36,Default,,0000,0000,0000,,Мен кіремін ғой!
Dialogue: 0,0:05:14.36,0:05:16.36,Default,,0000,0000,0000,,Ахаха. Аа!?→
Dialogue: 0,0:05:18.23,0:05:21.09,Default,,0000,0000,0000,,Не... неге жалаңашсың?
Dialogue: 0,0:05:21.09,0:05:23.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:30.85,0:05:32.71,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:32.71,0:05:35.73,Default,,0000,0000,0000,,Бұл бассейн!
Dialogue: 0,0:05:35.73,0:05:37.75,Default,,0000,0000,0000,,Киіміңді тез ауыстыр! Мүлдем емес…→
Dialogue: 0,0:05:37.75,0:05:40.62,Default,,0000,0000,0000,,Мен мектеп оқушысы болсам да, бассейнде көңіл көтере аламын→
Dialogue: 0,0:05:40.62,0:05:44.49,Default,,0000,0000,0000,,Ютака қуанады. Сен не айтып тұрсың?
Dialogue: 0,0:05:44.49,0:05:46.68,Default,,0000,0000,0000,,Жаздың бәрі бассейнге қатысты!
Dialogue: 0,0:05:46.68,0:05:50.22,Default,,0000,0000,0000,,Сіз сабағыңызды ұмытып қалдыңыз ба? Бассейн - бұл бассейн. →
Dialogue: 0,0:05:50.22,0:05:53.91,Default,,0000,0000,0000,,Иә? Тоорунның купальнигі→
Dialogue: 0,0:05:53.91,0:05:56.91,Default,,0000,0000,0000,,Мұндағыдан басқа түс солып тұр. Қолдан келген нәрсе ме?
Dialogue: 0,0:05:58.63,0:06:00.81,Default,,0000,0000,0000,,Бұл...→
Dialogue: 0,0:06:00.81,0:06:04.85,Default,,0000,0000,0000,,Мен оны бастауыш мектепте оқып жүрген кезімнен бастап қолданамын. (2 адам) Иә!?
Dialogue: 0,0:06:04.85,0:06:06.04,Default,,0000,0000,0000,,Хмф! Ол аурады!
Dialogue: 0,0:06:06.04,0:06:09.57,Default,,0000,0000,0000,,Сәлем! Башан!
Dialogue: 0,0:06:09.57,0:06:13.44,Default,,0000,0000,0000,,Уау! Бұл енді қауіпті емес!
Dialogue: 0,0:06:13.44,0:06:16.14,Default,,0000,0000,0000,,Бұл өте жақсы!
Dialogue: 0,0:06:16.14,0:06:19.17,Default,,0000,0000,0000,,Ютаканың кеудесі үлкен, солай ма?
Dialogue: 0,0:06:19.17,0:06:21.86,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:06:21.86,0:06:26.07,Default,,0000,0000,0000,,Қарғыс атқыр... Анау май оны қалқып жібереді, сондықтан жақсы және жүзу оңай.
Dialogue: 0,0:06:26.07,0:06:29.10,Default,,0000,0000,0000,,Оның тікенегі бар. Сіз депрессиядасыз ба?
Dialogue: 0,0:06:29.10,0:06:31.79,Default,,0000,0000,0000,,Ал... бұл шындық болуы мүмкін емес... иә?
Dialogue: 0,0:06:31.79,0:06:33.15,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:33.15,0:06:35.15,Default,,0000,0000,0000,,Иә? →
Dialogue: 0,0:06:37.18,0:06:40.88,Default,,0000,0000,0000,,Иә! Көпіршікті….
Dialogue: 0,0:06:40.88,0:06:45.26,Default,,0000,0000,0000,,Буккаку…. (2 адам) Майсыз!
Dialogue: 0,0:06:45.26,0:06:48.63,Default,,0000,0000,0000,,Дыбыстық сигнал! (Ысқырық дыбысы) (Юко) Хаа, ха, ха.
Dialogue: 0,0:06:48.63,0:06:51.99,Default,,0000,0000,0000,,Ыстық! (Юко) Иә. →
Dialogue: 0,0:06:51.99,0:06:54.02,Default,,0000,0000,0000,,Негізі жазғы дене шынықтыру өте қиын. Хахаха….
Dialogue: 0,0:06:54.02,0:06:57.72,Default,,0000,0000,0000,,（） ～ （２）
Dialogue: 0,0:06:57.72,0:07:02.77,Default,,0000,0000,0000,,Хаха! (Юко) 1 курс студенттерінің бассейн сабағы бар.
Dialogue: 0,0:07:02.77,0:07:05.47,Default,,0000,0000,0000,,А, бұл Тоору! (Юко) Бұл рас. →
Dialogue: 0,0:07:05.47,0:07:08.47,Default,,0000,0000,0000,,Бассейн керемет көрінеді. иә?
Dialogue: 0,0:07:10.18,0:07:13.88,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:13.88,0:07:16.74,Default,,0000,0000,0000,,Дыбыстық сигнал!
Dialogue: 0,0:07:16.74,0:07:18.10,Default,,0000,0000,0000,,Иә, орнатыңыз~.
Dialogue: 0,0:07:18.10,0:07:23.48,Default,,0000,0000,0000,,А... бұл жақсы. (Юко жүгіру) Иә?
Dialogue: 0,0:07:23.48,0:07:26.34,Default,,0000,0000,0000,,Мен қызғанамын. Не, Наги→
Dialogue: 0,0:07:26.34,0:07:28.19,Default,,0000,0000,0000,,Сіз бассейндерді жек көресіз бе?
Dialogue: 0,0:07:28.19,0:07:31.05,Default,,0000,0000,0000,,Мен бассейнді ұнатпаймын. Немесе →
Dialogue: 0,0:07:31.05,0:07:34.09,Default,,0000,0000,0000,,Мен купальник кигенді ұнатпаймын. Бірақ... →
Dialogue: 0,0:07:34.09,0:07:36.11,Default,,0000,0000,0000,,Тоору~! (Юко) Иә?
Dialogue: 0,0:07:36.11,0:07:39.14,Default,,0000,0000,0000,,Су себіңіз! Шелекпен!
Dialogue: 0,0:07:39.14,0:07:42.84,Default,,0000,0000,0000,,Наги ыстықтан өліп жатыр!
Dialogue: 0,0:07:42.84,0:07:44.19,Default,,0000,0000,0000,,Иә? (Юко) Тоқта, Наги!
Dialogue: 0,0:07:44.19,0:07:47.21,Default,,0000,0000,0000,,Жібер, жібер! Тоору!
Dialogue: 0,0:07:47.21,0:07:50.08,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:07:50.08,0:07:52.43,Default,,0000,0000,0000,,Иә? Теңіз? иә!
Dialogue: 0,0:07:52.43,0:07:56.64,Default,,0000,0000,0000,,Келесі аптада жазғы каникул басталады, ендеше бәріміз кеттік!
Dialogue: 0,0:07:56.64,0:07:58.50,Default,,0000,0000,0000,,Мен келісемін! →
Dialogue: 0,0:07:58.50,0:08:03.38,Default,,0000,0000,0000,,Не? Менде жағада киетін купальник жоқ...
Dialogue: 0,0:08:03.38,0:08:05.57,Default,,0000,0000,0000,,Мен купальник кигім келмейді...
Dialogue: 0,0:08:05.57,0:08:07.76,Default,,0000,0000,0000,,А... Екеуің не айтып тұрсыңдар!? →
Dialogue: 0,0:08:07.76,0:08:10.28,Default,,0000,0000,0000,,Бұл дұрыс емес. →
Dialogue: 0,0:08:10.28,0:08:13.28,Default,,0000,0000,0000,,Уау... Не... не?
Dialogue: 0,0:08:15.16,0:08:19.20,Default,,0000,0000,0000,,Сіз бірдеңе естідіңіз бе? Менің денем әдемі болғандықтан.
Dialogue: 0,0:08:19.20,0:08:23.24,Default,,0000,0000,0000,,Сенің ақшыл болғаның үшін. (Юко) Не ​​айтып тұрсың? →
Dialogue: 0,0:08:23.24,0:08:26.78,Default,,0000,0000,0000,,Бұл дұрыс емес! Кішіпейіл бол.
Dialogue: 0,0:08:26.78,0:08:28.78,Default,,0000,0000,0000,,Иә, иә. (Юко) Қазірдің өзінде!
Dialogue: 0,0:08:30.64,0:08:33.64,Default,,0000,0000,0000,,Барлығымен бірге теңізге барғым келеді.
Dialogue: 0,0:08:35.70,0:08:37.72,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:08:37.72,0:08:42.93,Default,,0000,0000,0000,,Күрсін! Жаяу жүргеннен кейін ыстық.
Dialogue: 0,0:08:42.93,0:08:46.14,Default,,0000,0000,0000,,Сізбен сөйлескенім үшін кешіріңіз. Жоқ, мен де сатып алдым.
Dialogue: 0,0:08:46.14,0:08:50.51,Default,,0000,0000,0000,,Бір жерде демалуға бола ма? иә?
Dialogue: 0,0:08:50.51,0:08:53.54,Default,,0000,0000,0000,,Хмм... Наги? →
Dialogue: 0,0:08:53.54,0:08:56.74,Default,,0000,0000,0000,,Не болды? Ауырып тұрсыз ба?
Dialogue: 0,0:08:56.74,0:08:59.44,Default,,0000,0000,0000,,Бұл жерде суық ауа жиналып қалғандықтан салқын. →
Dialogue: 0,0:08:59.44,0:09:02.63,Default,,0000,0000,0000,,Мен осында демаламын. (Юко) Ах! Ах...→
Dialogue: 0,0:09:02.63,0:09:06.50,Default,,0000,0000,0000,,Сәлем! Наги, тұр! өтінемін!
Dialogue: 0,0:09:06.50,0:09:09.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:09.20,0:09:11.23,Default,,0000,0000,0000,,Бүгінгі адамдар Бұл үлкен. Ах.
Dialogue: 0,0:09:11.23,0:09:14.92,Default,,0000,0000,0000,,（） １７０
Dialogue: 0,0:09:14.92,0:09:18.29,Default,,0000,0000,0000,,Менің ойымша, адамдар мені үлкен әйел деп ойлайды.
Dialogue: 0,0:09:18.29,0:09:21.49,Default,,0000,0000,0000,,Мен қызғанамын. Юуко сымбатты→
Dialogue: 0,0:09:21.49,0:09:25.20,Default,,0000,0000,0000,,Менің арқам да, кеудем де үлкен. (Юко) Кеудеде қосымша жұмыс жасаңыз. →
Dialogue: 0,0:09:25.20,0:09:28.06,Default,,0000,0000,0000,,Тіпті бұл көп қиындық тудыруы мүмкін.
Dialogue: 0,0:09:28.06,0:09:30.42,Default,,0000,0000,0000,,Шынымен бе? Ах. →
Dialogue: 0,0:09:30.42,0:09:32.10,Default,,0000,0000,0000,,Бұл көкірекше керемет!
Dialogue: 0,0:09:32.10,0:09:35.63,Default,,0000,0000,0000,,Бұл арзан, сондықтан мен оны сатып аламын.
Dialogue: 0,0:09:35.63,0:09:38.83,Default,,0000,0000,0000,,Шынымен! Мен де біреуін қалаймын.
Dialogue: 0,0:09:38.83,0:09:41.19,Default,,0000,0000,0000,,Ах. иә? Не болды?
Dialogue: 0,0:09:41.19,0:09:44.72,Default,,0000,0000,0000,,Бұл D дейінгі өлшемдерде қол жетімді.
Dialogue: 0,0:09:44.72,0:09:47.08,Default,,0000,0000,0000,,Өйткені, кішірек ыңғайлырақ.
Dialogue: 0,0:09:47.08,0:09:49.08,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:09:51.79,0:09:55.67,Default,,0000,0000,0000,,Уау! Үйге ерте қайтайық.
Dialogue: 0,0:09:55.67,0:09:57.19,Default,,0000,0000,0000,,Әй, қарағың келе ме?
Dialogue: 0,0:09:57.19,0:10:01.89,Default,,0000,0000,0000,,Не? Теңізге бармау туралы шешім қабылданған жоқ па?
Dialogue: 0,0:10:01.89,0:10:03.89,Default,,0000,0000,0000,,Иә, сүйкімді.
Dialogue: 0,0:10:05.09,0:10:07.09,Default,,0000,0000,0000,,Өйткені мен оны сатып алмаймын.
Dialogue: 0,0:10:10.48,0:10:13.48,Default,,0000,0000,0000,,Ммм... ммм.
Dialogue: 0,0:10:15.69,0:10:18.90,Default,,0000,0000,0000,,Уфуфу... Уфуфуфу! Хехе. →
Dialogue: 0,0:10:18.90,0:10:20.90,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:10:22.77,0:10:24.29,Default,,0000,0000,0000,,（）
Dialogue: 0,0:10:24.29,0:10:27.48,Default,,0000,0000,0000,,Бұл туралы не деуге болады? Жақсы емес пе?
Dialogue: 0,0:10:27.48,0:10:30.84,Default,,0000,0000,0000,,Шынымен бе? Жарайды, мен оны киіп көремін.
Dialogue: 0,0:10:30.84,0:10:32.20,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:10:32.20,0:10:35.73,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Бұл тамаша.
Dialogue: 0,0:10:35.73,0:10:37.73,Default,,0000,0000,0000,,Шынымен бе? Сонда...
Dialogue: 0,0:10:40.45,0:10:43.98,Default,,0000,0000,0000,,Бұл туралы не деуге болады? Дұрыс.
Dialogue: 0,0:10:43.98,0:10:45.98,Default,,0000,0000,0000,,（）→
Dialogue: 0,0:10:47.85,0:10:50.04,Default,,0000,0000,0000,,Бұл туралы не деуге болады? Бұл тамаша.
Dialogue: 0,0:10:50.04,0:10:54.04,Default,,0000,0000,0000,,Иә~ Мен абдырап қалдым. Біраз уақыт басқасына қарамаңыз.
Dialogue: 0,0:10:55.77,0:10:57.12,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:10:57.12,0:11:01.82,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:11:01.82,0:11:03.82,Default,,0000,0000,0000,,Ах…. Күрсін.
Dialogue: 0,0:11:06.20,0:11:08.73,Default,,0000,0000,0000,,Бір минут күтіңіз. о.
Dialogue: 0,0:11:08.73,0:11:15.29,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:11:15.29,0:11:17.48,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:17.48,0:11:22.03,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:11:22.03,0:11:24.55,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:11:24.55,0:11:28.25,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:11:28.25,0:11:30.44,Default,,0000,0000,0000,,Иә. →
Dialogue: 0,0:11:30.44,0:11:32.14,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:11:32.14,0:11:35.00,Default,,0000,0000,0000,,Наги Күткеніңізге рахмет. иә?
Dialogue: 0,0:11:35.00,0:11:45.76,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:11:45.76,0:11:47.28,Default,,0000,0000,0000,,Иә! →
Dialogue: 0,0:11:47.28,0:11:50.15,Default,,0000,0000,0000,,О... жоқ! Мынау... мынау~→
Dialogue: 0,0:11:50.15,0:11:53.84,Default,,0000,0000,0000,,Қарап тұрсам... Хехе.
Dialogue: 0,0:11:53.84,0:11:55.84,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:57.05,0:11:59.05,Default,,0000,0000,0000,,Байқап көріңіз…. (Юко) Иә!
Dialogue: 0,0:12:01.75,0:12:03.44,Default,,0000,0000,0000,,Мен оны сатып алдым... (Юко) Иә! →
Dialogue: 0,0:12:03.44,0:12:07.81,Default,,0000,0000,0000,,Бұл сізге өте ұнады. рақмет сізге.
Dialogue: 0,0:12:07.81,0:12:09.67,Default,,0000,0000,0000,,А, дұрыс!
Dialogue: 0,0:12:09.67,0:12:11.02,Default,,0000,0000,0000,,А, электрондық пошта? Иә.
Dialogue: 0,0:12:11.02,0:12:15.89,Default,,0000,0000,0000,,Жүгіру мен Тооруға теңізге барайық! Ха!
Dialogue: 0,0:12:15.89,0:12:17.89,Default,,0000,0000,0000,,Хэхе!
Dialogue: 0,0:12:18.93,0:12:21.12,Default,,0000,0000,0000,,Оны асыға күтемін!
Dialogue: 0,0:12:21.12,0:12:23.65,Default,,0000,0000,0000,,Ах... Хехехе.
Dialogue: 0,0:12:23.65,0:12:26.84,Default,,0000,0000,0000,,Хмм…. →
Dialogue: 0,0:12:26.84,0:12:29.86,Default,,0000,0000,0000,,Екі шақырым қалды. Бұл мүмкін емес пе...
Dialogue: 0,0:12:29.86,0:12:32.86,Default,,0000,0000,0000,,Жарайды, орында.
Dialogue: 0,0:12:34.75,0:12:37.78,Default,,0000,0000,0000,,Дәл қазір. үйге қош келдіңіз.
Dialogue: 0,0:12:37.78,0:12:40.65,Default,,0000,0000,0000,,Жаңа ғана Рун-чан келді. Не? Сіз әлі үйге бардыңыз ба?
Dialogue: 0,0:12:40.65,0:12:44.18,Default,,0000,0000,0000,,Иә, менің жеткізуім керек нәрсе болғандықтан.
Dialogue: 0,0:12:44.18,0:12:48.56,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:12:48.56,0:12:50.91,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:12:50.91,0:12:54.95,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:12:54.95,0:12:57.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:57.48,0:12:59.17,Default,,0000,0000,0000,,«Бұл мен пайдаланған купальник.→
Dialogue: 0,0:12:59.17,0:13:02.17,Default,,0000,0000,0000,,Менің ойымша, бұл Тооруға өте қолайлы.''
Dialogue: 0,0:13:03.71,0:13:06.24,Default,,0000,0000,0000,,Уау! Ах~.
Dialogue: 0,0:13:06.24,0:13:08.76,Default,,0000,0000,0000,,Хе хехе.
Dialogue: 0,0:13:08.76,0:13:11.96,Default,,0000,0000,0000,,Мм. Хехе.
Dialogue: 0,0:13:11.96,0:13:15.66,Default,,0000,0000,0000,,Ju! (Грильдегі еттің пошталық қоңырау үні)
Dialogue: 0,0:13:15.66,0:13:18.86,Default,,0000,0000,0000,,Хмм... мм.
Dialogue: 0,0:13:18.86,0:13:22.56,Default,,0000,0000,0000,,Хмм... Ол аралға жарыс →
Dialogue: 0,0:13:22.56,0:13:24.58,Default,,0000,0000,0000,,Тоору. Хехе.
Dialogue: 0,0:13:24.58,0:13:27.11,Default,,0000,0000,0000,,Соқ! (құлап түскен дыбыс)
Dialogue: 0,0:13:27.11,0:13:31.49,Default,,0000,0000,0000,,Жақсы ойна, жақсы оқы және жаңа оқу жылында →
Dialogue: 0,0:13:31.49,0:13:35.53,Default,,0000,0000,0000,,Күш-қуатқа толы барлықтарыңызбен кездесуді асыға күтемін.
Dialogue: 0,0:13:35.53,0:13:40.53,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:15:46.51,0:15:49.53,Default,,0000,0000,0000,,Пуруруру... (кету қоңырауы) (Юко Наги) Ха, ха, ха...
Dialogue: 0,0:15:49.53,0:15:51.55,Default,,0000,0000,0000,,Күте тұрыңыз! Хахаха….
Dialogue: 0,0:15:51.55,0:15:56.55,Default,,0000,0000,0000,,…
Dialogue: 0,0:15:58.13,0:16:08.56,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:08.56,0:16:11.75,Default,,0000,0000,0000,,...
Dialogue: 0,0:16:11.75,0:16:14.95,Default,,0000,0000,0000,,...
Dialogue: 0,0:16:14.95,0:16:17.31,Default,,0000,0000,0000,,Балалар? · теңіз теңізі
Dialogue: 0,0:16:17.31,0:16:19.50,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:19.50,0:16:21.86,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:21.86,0:16:23.21,Default,,0000,0000,0000,,Теңіз! теңіз!
Dialogue: 0,0:16:23.21,0:16:26.57,Default,,0000,0000,0000,,Иә!?→
Dialogue: 0,0:16:26.57,0:16:29.57,Default,,0000,0000,0000,,Уау! Бұл әдемі.
Dialogue: 0,0:16:32.13,0:16:34.48,Default,,0000,0000,0000,,Уау. Ах.
Dialogue: 0,0:16:34.48,0:16:38.19,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:38.19,0:16:40.04,Default,,0000,0000,0000,,Жолда жүру.
Dialogue: 0,0:16:40.04,0:16:43.74,Default,,0000,0000,0000,,Бұл трамвай сияқты. (Юко) Бұл рас.
Dialogue: 0,0:16:43.74,0:16:48.62,Default,,0000,0000,0000,,Бұл керемет! Ол жолда жүгіреді.
Dialogue: 0,0:16:48.62,0:16:50.14,Default,,0000,0000,0000,,Қызық, олар оны қашан өзгертті?
Dialogue: 0,0:16:50.14,0:16:53.50,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:16:53.50,0:16:55.69,Default,,0000,0000,0000,,Ал, бұл шиналар.
Dialogue: 0,0:16:55.69,0:16:57.69,Default,,0000,0000,0000,,Шиналар жоқ.
Dialogue: 0,0:17:00.07,0:17:03.60,Default,,0000,0000,0000,,Хаха! Hiyaho!
Dialogue: 0,0:17:03.60,0:17:05.46,Default,,0000,0000,0000,,Ха ха ха!
Dialogue: 0,0:17:05.46,0:17:07.82,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:17:07.82,0:17:10.51,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:10.51,0:17:12.51,Default,,0000,0000,0000,,Теңіз осында!
Dialogue: 0,0:17:14.21,0:17:16.40,Default,,0000,0000,0000,,Жүр, жүзейік!
Dialogue: 0,0:17:16.40,0:17:18.42,Default,,0000,0000,0000,,Теңіз мені қатты толқытады!
Dialogue: 0,0:17:18.42,0:17:20.28,Default,,0000,0000,0000,,Мен де! Хехе.
Dialogue: 0,0:17:20.28,0:17:23.80,Default,,0000,0000,0000,,Run-chan. мм... хмм?
Dialogue: 0,0:17:23.80,0:17:25.83,Default,,0000,0000,0000,,Маған купальникті қарызға бергеніңіз үшін рахмет.
Dialogue: 0,0:17:25.83,0:17:28.86,Default,,0000,0000,0000,,Иә! Бұл дұрыс өлшем болғанына қуаныштымын.
Dialogue: 0,0:17:28.86,0:17:31.72,Default,,0000,0000,0000,,Балалық дизайн үшін кешіріңіз.
Dialogue: 0,0:17:31.72,0:17:34.58,Default,,0000,0000,0000,,Жоқ. Өйткені...→
Dialogue: 0,0:17:34.58,0:17:36.44,Default,,0000,0000,0000,,Себебі бұл менің бастауыш сыныпта оқып жүргенімде болды.
Dialogue: 0,0:17:36.44,0:17:40.47,Default,,0000,0000,0000,,（）～ →
Dialogue: 0,0:17:40.47,0:17:42.50,Default,,0000,0000,0000,,～ ～
Dialogue: 0,0:17:42.50,0:17:45.53,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:45.53,0:17:47.53,Default,,0000,0000,0000,,≪Бастауыш сынып оқушылары...≫
Dialogue: 0,0:17:50.07,0:17:52.59,Default,,0000,0000,0000,,Хаха! Ахахахаха!
Dialogue: 0,0:17:52.59,0:17:55.59,Default,,0000,0000,0000,,Хаха! Хаха! Апыр-ай. Хахаха!
Dialogue: 0,0:17:57.48,0:18:00.17,Default,,0000,0000,0000,,Міне! Кяах!
Dialogue: 0,0:18:00.17,0:18:04.21,Default,,0000,0000,0000,,Сіз мұны жасадыңыз! Ммм!
Dialogue: 0,0:18:04.21,0:18:06.74,Default,,0000,0000,0000,,Кяа! Хахахаха!
Dialogue: 0,0:18:06.74,0:18:09.10,Default,,0000,0000,0000,,Хаха! Эй!
Dialogue: 0,0:18:09.10,0:18:12.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:18:12.13,0:18:15.49,Default,,0000,0000,0000,,Қазірдің өзінде! Қылық емес пе?
Dialogue: 0,0:18:15.49,0:18:18.19,Default,,0000,0000,0000,,Хехе. Уф... Уау!
Dialogue: 0,0:18:18.19,0:18:20.71,Default,,0000,0000,0000,,Ха~хахахаха! →
Dialogue: 0,0:18:20.71,0:18:23.08,Default,,0000,0000,0000,,Қараңыз! Биік, биік! Ой... бұл не!?
Dialogue: 0,0:18:23.08,0:18:27.78,Default,,0000,0000,0000,,Керемет, Тоору. Мені жіберіңізші!
Dialogue: 0,0:18:27.78,0:18:29.14,Default,,0000,0000,0000,,Уау! Уаау... Хахахаха!
Dialogue: 0,0:18:29.14,0:18:31.32,Default,,0000,0000,0000,,Иә? Апыр-ай! иә?
Dialogue: 0,0:18:31.32,0:18:34.51,Default,,0000,0000,0000,,Башан!
Dialogue: 0,0:18:34.51,0:18:36.51,Default,,0000,0000,0000,,Иә! Тоору! Наги!
Dialogue: 0,0:18:38.89,0:18:41.42,Default,,0000,0000,0000,,Иә? Жылы...
Dialogue: 0,0:18:41.42,0:18:43.27,Default,,0000,0000,0000,,Пуф! Хахаха! →
Dialogue: 0,0:18:43.27,0:18:45.27,Default,,0000,0000,0000,,Не, анау бас! иә?
Dialogue: 0,0:18:47.14,0:18:49.50,Default,,0000,0000,0000,,Не? Теңіз балдыры....
Dialogue: 0,0:18:49.50,0:18:53.53,Default,,0000,0000,0000,,Не? Апыр-ай!
Dialogue: 0,0:18:53.53,0:18:55.06,Default,,0000,0000,0000,,Саған жақсы көрінеді, Наги. Сізге жарасады!
Dialogue: 0,0:18:55.06,0:18:57.41,Default,,0000,0000,0000,,Теңіз балдырлары. (Юко) Хехехе.
Dialogue: 0,0:18:57.41,0:18:59.93,Default,,0000,0000,0000,,Kii~! (Юко) Хаха!
Dialogue: 0,0:18:59.93,0:19:03.98,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:03.98,0:19:06.17,Default,,0000,0000,0000,,Хаа хаа ха...→
Dialogue: 0,0:19:06.17,0:19:11.05,Default,,0000,0000,0000,,Бір сәт. Не, Наги, сен шаршадың ба?
Dialogue: 0,0:19:11.05,0:19:15.59,Default,,0000,0000,0000,,Таңертеңгі сағат 5-те ояндым... Физикалық күшім азайып кетті...
Dialogue: 0,0:19:15.59,0:19:19.96,Default,,0000,0000,0000,,Бізде бәрі жақсы. Мен сүйкімдімін.
Dialogue: 0,0:19:19.96,0:19:23.67,Default,,0000,0000,0000,,Олай болса, үзіліс жасайық! Мен шырын сатып аламын.
Dialogue: 0,0:19:23.67,0:19:25.52,Default,,0000,0000,0000,,А, онда қауын содасы, өтінемін.
Dialogue: 0,0:19:25.52,0:19:28.05,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:19:28.05,0:19:32.76,Default,,0000,0000,0000,,Спорттық сусындар…. Жақсы.
Dialogue: 0,0:19:32.76,0:19:34.76,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:35.79,0:19:39.17,Default,,0000,0000,0000,,Мен қатты шаршадым.
Dialogue: 0,0:19:39.17,0:19:43.20,Default,,0000,0000,0000,,Қош келдіңіз! Апыр-ай.
Dialogue: 0,0:19:43.20,0:19:45.20,Default,,0000,0000,0000,,Олар өте көп. Қайсысын таңдауым керек?
Dialogue: 0,0:19:47.41,0:19:49.93,Default,,0000,0000,0000,,Арун-чан. иә?
Dialogue: 0,0:19:49.93,0:19:51.93,Default,,0000,0000,0000,,Бұл. иә?
Dialogue: 0,0:19:53.80,0:19:55.82,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:19:55.82,0:19:58.52,Default,,0000,0000,0000,,Амал жоқ, мұндай жерде→
Dialogue: 0,0:19:58.52,0:20:00.70,Default,,0000,0000,0000,,Фантом тасбақа кәмпит шырынына→
Dialogue: 0,0:20:00.70,0:20:03.40,Default,,0000,0000,0000,,Біз нені кездестіре аламыз? Иә иә.
Dialogue: 0,0:20:03.40,0:20:06.77,Default,,0000,0000,0000,,Наги-чан, мен оны сатып алдым. Апыр-ай.
Dialogue: 0,0:20:06.77,0:20:09.77,Default,,0000,0000,0000,,Иә? Юко ұйықтап жатыр.
Dialogue: 0,0:20:11.48,0:20:14.84,Default,,0000,0000,0000,,Бұл рас. Біраз бұрын →
Dialogue: 0,0:20:14.84,0:20:16.37,Default,,0000,0000,0000,,«Бәріміз жақсы» десем де →
Dialogue: 0,0:20:16.37,0:20:18.22,Default,,0000,0000,0000,,Отырған бойда мынау.
Dialogue: 0,0:20:18.22,0:20:21.42,Default,,0000,0000,0000,,Жақсы сезінетін сияқты. Бұл дұрыс!
Dialogue: 0,0:20:21.42,0:20:23.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:23.94,0:20:28.49,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:28.49,0:20:31.69,Default,,0000,0000,0000,,Хмм! Иә, бұл өте жақсы сезінеді!
Dialogue: 0,0:20:31.69,0:20:37.24,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:37.24,0:20:40.27,Default,,0000,0000,0000,,Адамдар көп емес және тыныш →
Dialogue: 0,0:20:40.27,0:20:42.27,Default,,0000,0000,0000,,Оңтүстік аралдар ең жақсысы!
Dialogue: 0,0:20:43.97,0:20:46.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:46.33,0:20:48.19,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:48.19,0:20:50.19,Default,,0000,0000,0000,,Не? Не... не?
Dialogue: 0,0:20:51.22,0:20:53.07,Default,,0000,0000,0000,,Жапырақтары?
Dialogue: 0,0:20:53.07,0:20:57.11,Default,,0000,0000,0000,,Хмм…. Не болды, Тоору!
Dialogue: 0,0:20:57.11,0:20:59.11,Default,,0000,0000,0000,,Қытықтау... Иә!?
Dialogue: 0,0:21:01.15,0:21:05.15,Default,,0000,0000,0000,,Соқ! (Юко) Уф! Ой... ауыр... →
Dialogue: 0,0:21:06.54,0:21:08.72,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:08.72,0:21:13.72,Default,,0000,0000,0000,,Соқ! Соқ! (Юко) Ой... ауыр екен!
Dialogue: 0,0:21:14.11,0:21:16.47,Default,,0000,0000,0000,,Иә! →
Dialogue: 0,0:21:16.47,0:21:19.47,Default,,0000,0000,0000,,Иә? Ю... арман?
Dialogue: 0,0:21:20.51,0:21:22.53,Default,,0000,0000,0000,,Сіз ұйықтадыңыз ба?
Dialogue: 0,0:21:22.53,0:21:26.53,Default,,0000,0000,0000,,Хмм... хмм?
Dialogue: 0,0:21:30.60,0:21:33.80,Default,,0000,0000,0000,,О... Castle~!?→
Dialogue: 0,0:21:33.80,0:21:35.82,Default,,0000,0000,0000,,Мен оны жек көремін!
Dialogue: 0,0:21:35.82,0:21:38.86,Default,,0000,0000,0000,,Қозғалма, аяқталуға жақын.
Dialogue: 0,0:21:38.86,0:21:41.86,Default,,0000,0000,0000,,Жолдан тез кет!
Dialogue: 0,0:21:43.74,0:21:45.59,Default,,0000,0000,0000,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:21:45.59,0:21:48.45,Default,,0000,0000,0000,,Шабуыл! Эй!
Dialogue: 0,0:21:48.45,0:21:51.64,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:51.64,0:21:53.83,Default,,0000,0000,0000,,Ха! О!
Dialogue: 0,0:21:53.83,0:21:55.52,Default,,0000,0000,0000,,Нашар! Уайымдама, уайымдама!
Dialogue: 0,0:21:55.52,0:21:59.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:59.06,0:22:01.58,Default,,0000,0000,0000,,Забар!
Dialogue: 0,0:22:01.58,0:22:05.79,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:05.79,0:22:08.32,Default,,0000,0000,0000,,О! (Юко) Не ​​болды?
Dialogue: 0,0:22:08.32,0:22:11.02,Default,,0000,0000,0000,,Мені бір нәрсеге тартып тұрғандай сезіну қызық!
Dialogue: 0,0:22:11.02,0:22:14.71,Default,,0000,0000,0000,,Забар!
Dialogue: 0,0:22:14.71,0:22:17.58,Default,,0000,0000,0000,,Забар!
Dialogue: 0,0:22:17.58,0:22:21.45,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:21.45,0:22:24.48,Default,,0000,0000,0000,,О! Апыр-ай!
Dialogue: 0,0:22:24.48,0:22:28.85,Default,,0000,0000,0000,,Бұл қызық емес пе? (Тору жүгіру) О!
Dialogue: 0,0:22:28.85,0:22:31.88,Default,,0000,0000,0000,,Иә, Наги?
Dialogue: 0,0:22:31.88,0:22:33.07,Default,,0000,0000,0000,,Забар!
Dialogue: 0,0:22:33.07,0:22:36.26,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:36.26,0:22:38.78,Default,,0000,0000,0000,,О! →
Dialogue: 0,0:22:38.78,0:22:43.83,Default,,0000,0000,0000,,О! Ух... мен де!
Dialogue: 0,0:22:43.83,0:22:45.18,Default,,0000,0000,0000,,Забар!
Dialogue: 0,0:22:45.18,0:22:48.88,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:48.88,0:22:50.57,Default,,0000,0000,0000,,О! (Юко) Ах! →
Dialogue: 0,0:22:50.57,0:22:52.57,Default,,0000,0000,0000,,Уау. иә?
Dialogue: 0,0:22:53.27,0:22:56.29,Default,,0000,0000,0000,,Түскі ас~!
Dialogue: 0,0:22:56.29,0:22:59.83,Default,,0000,0000,0000,,Теңізді ойлағанда, рамен елестейді. Якисоба.
Dialogue: 0,0:22:59.83,0:23:03.87,Default,,0000,0000,0000,,Тропикалық стильдегі тако күріш. (Юко) Түскі ас ішеміз.
Dialogue: 0,0:23:03.87,0:23:06.57,Default,,0000,0000,0000,,Бұл әдеттегідей. (Юко) Солай ма?
Dialogue: 0,0:23:06.57,0:23:09.43,Default,,0000,0000,0000,,Жарайды, маған қалдырыңыз!
Dialogue: 0,0:23:09.43,0:23:11.78,Default,,0000,0000,0000,,Не, не істеуіміз керек?
Dialogue: 0,0:23:11.78,0:23:14.78,Default,,0000,0000,0000,,Өйткені бұл мұхит! Мұхит! иә!
Dialogue: 0,0:23:15.16,0:23:18.85,Default,,0000,0000,0000,,Балық~! (Юко) Иә!
Dialogue: 0,0:23:18.85,0:23:37.54,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:37.54,0:23:55.72,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:55.72,0:24:02.95,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:02.95,0:24:18.45,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:18.45,0:24:20.45,Default,,0000,0000,0000,,Адамдардың саны айтарлықтай азайды.
Dialogue: 0,0:24:21.82,0:24:24.18,Default,,0000,0000,0000,,Кеш болды. →
Dialogue: 0,0:24:24.18,0:24:26.70,Default,,0000,0000,0000,,Мен өзімді көп қызық көргендей сезінемін.
Dialogue: 0,0:24:26.70,0:24:30.57,Default,,0000,0000,0000,,Таңертең ерте келгеніңізге қуаныштымын. Дұрыс па?
Dialogue: 0,0:24:30.57,0:24:33.44,Default,,0000,0000,0000,,Теңіз Бұл көңілді болды.
Dialogue: 0,0:24:33.44,0:24:36.13,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:24:36.13,0:24:38.82,Default,,0000,0000,0000,,Ал... қызық болды.
Dialogue: 0,0:24:38.82,0:24:41.18,Default,,0000,0000,0000,,Қайтадан жиналайық.
Dialogue: 0,0:24:41.18,0:24:44.04,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:24:44.04,0:24:46.90,Default,,0000,0000,0000,,Пурулуру…
Dialogue: 0,0:24:46.90,0:24:50.43,Default,,0000,0000,0000,,Юуко, асығыңыз! (Юко) Эй... сәл күте тұрыңыз!
Dialogue: 0,0:24:50.43,0:24:53.30,Default,,0000,0000,0000,,Асығыңыз, асығыңыз!
Dialogue: 0,0:24:53.30,0:24:56.30,Default,,0000,0000,0000,,Уф, мен оны уақытында жасадым! Бұл тыртық.
Dialogue: 0,0:24:57.51,0:24:59.51,Default,,0000,0000,0000,,Хмм... О, не?
Dialogue: 0,0:25:02.89,0:25:05.09,Default,,0000,0000,0000,,Иә? Юко-чан, отырмайсың ба?
Dialogue: 0,0:25:05.09,0:25:07.44,Default,,0000,0000,0000,,А... жоқ, мұнда істей алмайсың.
Dialogue: 0,0:25:07.44,0:25:10.80,Default,,0000,0000,0000,,Біз әлі келген жоқпыз.
Dialogue: 0,0:25:10.80,0:25:13.33,Default,,0000,0000,0000,,Қараңдаршы, менде энергия көп.
Dialogue: 0,0:25:13.33,0:25:15.68,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:25:15.68,0:25:20.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:20.07,0:25:24.94,Default,,0000,0000,0000,,Амансың ба? Юко. (Юко) Иә, ол жақсы сияқты.
Dialogue: 0,0:25:24.94,0:25:26.79,Default,,0000,0000,0000,,Кутикула! (Юко) Иә?
Dialogue: 0,0:25:26.79,0:25:29.82,Default,,0000,0000,0000,,Кутикула дұрыс па? Юко-чан.
Dialogue: 0,0:25:29.82,0:25:32.52,Default,,0000,0000,0000,,Сіз оны көре алмайсыз. (Юко)... Жарайды деп ойлаймын.
Dialogue: 0,0:25:32.52,0:25:35.38,Default,,0000,0000,0000,,Өйткені Юко-чанның шашы ұзын әрі әдемі→
Dialogue: 0,0:25:35.38,0:25:38.91,Default,,0000,0000,0000,,Сақ болу керек. Менің де терім ақ.
Dialogue: 0,0:25:38.91,0:25:41.45,Default,,0000,0000,0000,,Ах, рахмет. Дұрыс →
Dialogue: 0,0:25:41.45,0:25:45.15,Default,,0000,0000,0000,,Күнге аздап күйіп қалдыңыз ба? Жоқ, маған бәрібір.
Dialogue: 0,0:25:45.15,0:25:47.17,Default,,0000,0000,0000,,Күннен қорғайтын крем жағуды көздедім.
Dialogue: 0,0:25:47.17,0:25:50.87,Default,,0000,0000,0000,,Мен көремін. Run ше?
Dialogue: 0,0:25:50.87,0:25:53.56,Default,,0000,0000,0000,,Иә? (Юко) Бұл мүлде күйген жоқ.
Dialogue: 0,0:25:53.56,0:25:56.43,Default,,0000,0000,0000,,Жүгір, сен қандай күннен қорғайтын крем қолдандың?
Dialogue: 0,0:25:56.43,0:25:58.45,Default,,0000,0000,0000,,Мен оны қолданбаймын. (2 адам) Иә!?
Dialogue: 0,0:25:58.45,0:26:02.49,Default,,0000,0000,0000,,Мен күннен қорғайтын крем қолданбаймын, сондықтан менің терім неге осылай көрінеді?
Dialogue: 0,0:26:02.49,0:26:05.52,Default,,0000,0000,0000,,Мен сене алар емеспін. Хаха! Қықылдайды.
Dialogue: 0,0:26:05.52,0:26:07.21,Default,,0000,0000,0000,,Ах…. Хаха! Хахаха! Апыр-ай.
Dialogue: 0,0:26:07.21,0:26:11.92,Default,,0000,0000,0000,,А... Мен күнге күймеймін.
Dialogue: 0,0:26:11.92,0:26:15.12,Default,,0000,0000,0000,,Шынымен бе? Сіз бөтен адамсыз ба?
Dialogue: 0,0:26:15.12,0:26:19.15,Default,,0000,0000,0000,,Иә! Жоқ. Жүгір... Рун-чан - жерлік.
Dialogue: 0,0:26:19.15,0:26:21.18,Default,,0000,0000,0000,,Шынымен бе? ШЫН!
Dialogue: 0,0:26:21.18,0:26:25.18,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:27.57,0:26:37.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:37.84,0:26:41.88,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:41.88,0:26:55.86,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:55.86,0:27:09.99,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:09.99,0:27:28.02,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:28.02,0:27:35.02,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:45.85,0:27:54.85,Default,,0000,0000,0000,,Сен
