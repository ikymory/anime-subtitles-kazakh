Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:02.14,0:02:06.68,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:06.68,0:02:09.71,Default,,0000,0000,0000,,Тонна… (аяқ дыбысы)
Dialogue: 0,0:02:09.71,0:02:14.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:14.10,0:02:16.45,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:02:16.45,0:02:23.52,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:23.52,0:02:25.70,Default,,0000,0000,0000,,Баршаңызға~!
Dialogue: 0,0:02:25.70,0:02:27.23,Default,,0000,0000,0000,,Хехе. Ах!
Dialogue: 0,0:02:27.23,0:02:34.63,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:34.63,0:02:36.63,Default,,0000,0000,0000,,Хэхехе!
Dialogue: 0,0:02:39.01,0:02:41.54,Default,,0000,0000,0000,,Хехе. сәуле! Пэйлин!
Dialogue: 0,0:02:41.54,0:02:45.74,Default,,0000,0000,0000,,Хехе. сәуле! Пэйлин!
Dialogue: 0,0:02:45.74,0:02:47.10,Default,,0000,0000,0000,,Хаха! Хехе.
Dialogue: 0,0:02:47.10,0:02:49.95,Default,,0000,0000,0000,,～（）
Dialogue: 0,0:02:49.95,0:02:52.48,Default,,0000,0000,0000,,Ей! Пэйлин!
Dialogue: 0,0:02:52.48,0:02:55.50,Default,,0000,0000,0000,,Ха! Пэйлин!
Dialogue: 0,0:02:55.50,0:02:57.86,Default,,0000,0000,0000,,Сәлем! Пэйлин!
Dialogue: 0,0:02:57.86,0:03:00.22,Default,,0000,0000,0000,,Хэхехе! Пэйлин!
Dialogue: 0,0:03:00.22,0:03:02.07,Default,,0000,0000,0000,,О!
Dialogue: 0,0:03:02.07,0:03:05.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:05.11,0:03:07.46,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:03:07.46,0:03:09.98,Default,,0000,0000,0000,,Хмм…. Мияу!
Dialogue: 0,0:03:09.98,0:03:13.52,Default,,0000,0000,0000,,Ах. Ах~! Ня~ Ня~ Ня~!
Dialogue: 0,0:03:13.52,0:03:15.87,Default,,0000,0000,0000,,Ня~
Dialogue: 0,0:03:15.87,0:03:18.90,Default,,0000,0000,0000,,Хун хун хун хун! Парин Парин Парин Парин!
Dialogue: 0,0:03:18.90,0:03:21.76,Default,,0000,0000,0000,,～ ～
Dialogue: 0,0:03:21.76,0:03:24.96,Default,,0000,0000,0000,,～
Dialogue: 0,0:03:24.96,0:03:26.96,Default,,0000,0000,0000,,Ах. аа….
Dialogue: 0,0:03:28.50,0:03:40.50,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:42.98,0:03:54.26,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:54.26,0:03:58.26,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:01.50,0:04:09.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:09.41,0:04:13.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:14.80,0:04:25.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:25.41,0:04:33.99,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:33.99,0:04:40.39,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:40.39,0:04:44.39,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:48.81,0:04:57.81,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:03.78,0:05:08.78,Default,,0000,0000,0000,,Кин Хон Хан…
Dialogue: 0,0:05:09.85,0:05:13.85,Default,,0000,0000,0000,,Жүгіру~! иә? Не?
Dialogue: 0,0:05:17.09,0:05:20.78,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:05:20.78,0:05:22.81,Default,,0000,0000,0000,,Иә? Ах...
Dialogue: 0,0:05:22.81,0:05:25.34,Default,,0000,0000,0000,,Бұл кешегі күн туралы... Иә.
Dialogue: 0,0:05:25.34,0:05:29.38,Default,,0000,0000,0000,,Орындау жазбасы құлады. иә? →
Dialogue: 0,0:05:29.38,0:05:31.38,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:05:36.28,0:05:38.80,Default,,0000,0000,0000,,А... Не?
Dialogue: 0,0:05:38.80,0:05:40.99,Default,,0000,0000,0000,,Хмм... Гого... Кешіріңіз! иә?
Dialogue: 0,0:05:40.99,0:05:43.52,Default,,0000,0000,0000,,Жадыңды өшіремін, мені өлтірме! →
Dialogue: 0,0:05:43.52,0:05:46.21,Default,,0000,0000,0000,,Ух... Кешіріңіз... Не айтып тұрсыз?
Dialogue: 0,0:05:46.21,0:05:49.25,Default,,0000,0000,0000,,Өйткені бұл кек сақтаған адамға қарғыс айту деп аталады→
Dialogue: 0,0:05:49.25,0:05:52.61,Default,,0000,0000,0000,,Бұл мысалдағы ескерту емес пе? Бұл дұрыс емес.
Dialogue: 0,0:05:52.61,0:05:55.80,Default,,0000,0000,0000,,Бұл Тоорумен алмасу жазбасы.
Dialogue: 0,0:05:55.80,0:06:00.85,Default,,0000,0000,0000,,Онда Тоору парағы. Жарайды, бұл топтың аты қалай?
Dialogue: 0,0:06:00.85,0:06:03.55,Default,,0000,0000,0000,,Жад сынағы. Осы уақытқа дейін кездестірген адамдардың есімдері →
Dialogue: 0,0:06:03.55,0:06:06.75,Default,,0000,0000,0000,,Біз қанша жаза алатынымызды білу үшін жарысамыз.
Dialogue: 0,0:06:06.75,0:06:09.61,Default,,0000,0000,0000,,≪Неге олай істедің? ≫
Dialogue: 0,0:06:09.61,0:06:11.13,Default,,0000,0000,0000,,Дегенмен, сіздің есте сақтау қабілетіңіз тамаша.
Dialogue: 0,0:06:11.13,0:06:13.65,Default,,0000,0000,0000,,Мен оған сәйкес келмейтін шығармын.
Dialogue: 0,0:06:13.65,0:06:17.52,Default,,0000,0000,0000,,Оның үстіне әңгіменің ортасынан бастап аты катакана → толығады
Dialogue: 0,0:06:17.52,0:06:19.88,Default,,0000,0000,0000,,Тоору оралушы ма?
Dialogue: 0,0:06:19.88,0:06:23.58,Default,,0000,0000,0000,,Жоқ. Содан бері бұл мен оқып жүрген манга кейіпкері болды.
Dialogue: 0,0:06:23.58,0:06:26.62,Default,,0000,0000,0000,,Ах~ Не деген оғаш есім... →
Dialogue: 0,0:06:26.62,0:06:28.80,Default,,0000,0000,0000,,«Джастин»?
Dialogue: 0,0:06:28.80,0:06:32.50,Default,,0000,0000,0000,,Әй, «Мишель Ричейн»!
Dialogue: 0,0:06:32.50,0:06:34.86,Default,,0000,0000,0000,,Жюль Огюст Гийом.
Dialogue: 0,0:06:34.86,0:06:36.88,Default,,0000,0000,0000,,Мари-Франсуа Виктория!
Dialogue: 0,0:06:36.88,0:06:41.10,Default,,0000,0000,0000,,Уа, ау. Доботчекенович!
Dialogue: 0,0:06:41.10,0:06:44.29,Default,,0000,0000,0000,,Граф Франсуаза Полониак!
Dialogue: 0,0:06:44.29,0:06:46.15,Default,,0000,0000,0000,,Мишель Бонпарнасс!
Dialogue: 0,0:06:46.15,0:06:48.84,Default,,0000,0000,0000,,О’Брайен Вукович!
Dialogue: 0,0:06:48.84,0:06:51.87,Default,,0000,0000,0000,,（）
Dialogue: 0,0:06:51.87,0:06:55.07,Default,,0000,0000,0000,,Пол Линарес! Эндрюс Бандерас!
Dialogue: 0,0:06:55.07,0:06:58.60,Default,,0000,0000,0000,,Гладиос Андретти! (Юко) Не?
Dialogue: 0,0:06:58.60,0:07:00.12,Default,,0000,0000,0000,,Сальвадор Андреа! (Юко) Ах.
Dialogue: 0,0:07:00.12,0:07:02.47,Default,,0000,0000,0000,,Хайсель Пончо! Юко.
Dialogue: 0,0:07:02.47,0:07:04.47,Default,,0000,0000,0000,,Рука, сен күнде қылыш айналдыру жаттығуын жасап жүрсің ғой?
Dialogue: 0,0:07:07.52,0:07:09.54,Default,,0000,0000,0000,,Сонымен Тоору деген не?
Dialogue: 0,0:07:09.54,0:07:12.91,Default,,0000,0000,0000,,Менің сізге көрсеткім келетін бір нәрсе бар, сондықтан менің үйіме келіңіз.
Dialogue: 0,0:07:12.91,0:07:14.76,Default,,0000,0000,0000,,Хмм, бұл не екені қызық.
Dialogue: 0,0:07:14.76,0:07:17.46,Default,,0000,0000,0000,,Бірақ Тоорун отбасына бірінші рет баруым →
Dialogue: 0,0:07:17.46,0:07:20.48,Default,,0000,0000,0000,,Мен оны асыға күтемін. Мен де. →
Dialogue: 0,0:07:20.48,0:07:24.52,Default,,0000,0000,0000,,Сіз қайда тұрасыз? Жақында білесіз.
Dialogue: 0,0:07:24.52,0:07:27.56,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:27.56,0:07:30.42,Default,,0000,0000,0000,,Бұл осында. (Юко) Ах~!
Dialogue: 0,0:07:30.42,0:07:34.12,Default,,0000,0000,0000,,Тоору жақсы пәтерде тұрады.
Dialogue: 0,0:07:34.12,0:07:36.65,Default,,0000,0000,0000,,Кеттік. Иә.
Dialogue: 0,0:07:36.65,0:07:40.02,Default,,0000,0000,0000,,Егер мен тым алыс кетсем, үйді тазалаймын деп алдымен үйге барудың қажеті жоқ.
Dialogue: 0,0:07:40.02,0:07:43.38,Default,,0000,0000,0000,,Көрмеу керек нәрселер бар емес пе?
Dialogue: 0,0:07:43.38,0:07:45.57,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:07:45.57,0:07:48.60,Default,,0000,0000,0000,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:07:48.60,0:07:50.12,Default,,0000,0000,0000,,Хо хо хо хо хо...
Dialogue: 0,0:07:50.12,0:07:53.65,Default,,0000,0000,0000,,Бұл жерде жасыл бамбукты басқандай әсер қалдырады.
Dialogue: 0,0:07:53.65,0:07:56.85,Default,,0000,0000,0000,,Ақымақ болма, кеттік!
Dialogue: 0,0:07:56.85,0:08:00.85,Default,,0000,0000,0000,,Пинг-понг Тоору~ Міне~!
Dialogue: 0,0:08:02.41,0:08:05.10,Default,,0000,0000,0000,,Ашық, ендеше кіріңіз.
Dialogue: 0,0:08:05.10,0:08:07.95,Default,,0000,0000,0000,,Иә. Гача (есік дыбысы)
Dialogue: 0,0:08:07.95,0:08:09.95,Default,,0000,0000,0000,,Кешіріңіз. (Юко Наги) Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:08:14.53,0:08:19.24,Default,,0000,0000,0000,,Мен кіремін.
Dialogue: 0,0:08:19.24,0:08:21.24,Default,,0000,0000,0000,,Уау! Ха!
Dialogue: 0,0:08:23.12,0:08:26.82,Default,,0000,0000,0000,,Лас!
Dialogue: 0,0:08:26.82,0:08:29.84,Default,,0000,0000,0000,,Тоору тазармайтын бала ма?
Dialogue: 0,0:08:29.84,0:08:33.22,Default,,0000,0000,0000,,Жоқ. Ол соншалықты әдемі, әдетте өте әдісті.
Dialogue: 0,0:08:33.22,0:08:35.40,Default,,0000,0000,0000,,Сонымен, бұл...
Dialogue: 0,0:08:35.40,0:08:37.59,Default,,0000,0000,0000,,Лас бөлме...→
Dialogue: 0,0:08:37.59,0:08:41.96,Default,,0000,0000,0000,,Адам жоқ... ал кілт ішінен шығады....
Dialogue: 0,0:08:41.96,0:08:44.66,Default,,0000,0000,0000,,Бөлмедегі құпия кісі өлтіру! Алдыңғы есік ашық болды.
Dialogue: 0,0:08:44.66,0:08:48.37,Default,,0000,0000,0000,,Иә? Бұл оның лас екенін білдірмейді.
Dialogue: 0,0:08:48.37,0:08:52.40,Default,,0000,0000,0000,,Мұқият қарасаңыз, қоқыс жәшігінің ішіндегісі жай ғана бейберекет екенін көресіз.
Dialogue: 0,0:08:52.40,0:08:54.43,Default,,0000,0000,0000,,Басқаша айтқанда, қоқыс өздігінен жүрді.
Dialogue: 0,0:08:54.43,0:08:57.12,Default,,0000,0000,0000,,Олардың аяқ-қолы да жоқ сияқты.
Dialogue: 0,0:08:57.12,0:09:00.49,Default,,0000,0000,0000,,Кяккья! Кяккяккя!
Dialogue: 0,0:09:00.49,0:09:03.85,Default,,0000,0000,0000,,Гача Кьяа! Адам!
Dialogue: 0,0:09:03.85,0:09:06.54,Default,,0000,0000,0000,,Қайырлы күн!
Dialogue: 0,0:09:06.54,0:09:08.57,Default,,0000,0000,0000,,көремін. Фу. →
Dialogue: 0,0:09:08.57,0:09:11.59,Default,,0000,0000,0000,,Оны әзірге қалдырайық. (Юко) Иә.
Dialogue: 0,0:09:11.59,0:09:13.29,Default,,0000,0000,0000,,...
Dialogue: 0,0:09:13.29,0:09:17.32,Default,,0000,0000,0000,,Иә? Кешіріңіз, ол лас.
Dialogue: 0,0:09:17.32,0:09:19.51,Default,,0000,0000,0000,,Бұл бала бөлмені қоқысқа тастады.
Dialogue: 0,0:09:19.51,0:09:21.51,Default,,0000,0000,0000,,Бұл бала?
Dialogue: 0,0:09:23.21,0:09:27.75,Default,,0000,0000,0000,,Ня~ (3 адам) Уау~! сүйкімді!
Dialogue: 0,0:09:27.75,0:09:29.27,Default,,0000,0000,0000,,Не болды? Бұл мысық.
Dialogue: 0,0:09:29.27,0:09:31.63,Default,,0000,0000,0000,,Мен оны бүгін таңертең алдым.
Dialogue: 0,0:09:31.63,0:09:33.15,Default,,0000,0000,0000,,Оны тастап кеткен сияқты.
Dialogue: 0,0:09:33.15,0:09:36.52,Default,,0000,0000,0000,,Ня~ Ня~
Dialogue: 0,0:09:36.52,0:09:41.23,Default,,0000,0000,0000,,Түсіндім! Мысықтың аяқ-қолы да болады. Неге екенін түсінбеймін.
Dialogue: 0,0:09:41.23,0:09:45.10,Default,,0000,0000,0000,,Мысықтар да антропоморфизацияланған. Сен не туралы айтып тұрсың?
Dialogue: 0,0:09:45.10,0:09:48.80,Default,,0000,0000,0000,,Сонда Тоору болады деп ойлаймын. Сонымен...→
Dialogue: 0,0:09:48.80,0:09:52.33,Default,,0000,0000,0000,,Бұл мағыналы болуы мүмкін. Дұрыс па?
Dialogue: 0,0:09:52.33,0:09:54.33,Default,,0000,0000,0000,,Бұл нені білдіреді!?
Dialogue: 0,0:09:57.55,0:10:00.75,Default,,0000,0000,0000,,Тағы да! Ертең кездескенше!
Dialogue: 0,0:10:00.75,0:10:02.61,Default,,0000,0000,0000,,Мысықтар үшін де жақсы деп үміттенемін.
Dialogue: 0,0:10:02.61,0:10:04.61,Default,,0000,0000,0000,,Жақында кездескенше.
Dialogue: 0,0:10:05.64,0:10:10.18,Default,,0000,0000,0000,,Күн суып барады. Тору жақсысың ба? Иә.
Dialogue: 0,0:10:10.18,0:10:13.05,Default,,0000,0000,0000,,Иә! Үйге қайтып бара жатқанда тамақ ішеміз бе?
Dialogue: 0,0:10:13.05,0:10:15.57,Default,,0000,0000,0000,,Иә, мен тәтті нәрсе алғым келеді.
Dialogue: 0,0:10:15.57,0:10:18.43,Default,,0000,0000,0000,,Менің ойымша, отбасылық мейрамхана жақсы болар еді.
Dialogue: 0,0:10:18.43,0:10:20.28,Default,,0000,0000,0000,,Сауда көшесімен жүрейік.
Dialogue: 0,0:10:20.28,0:10:24.16,Default,,0000,0000,0000,,Сауда ауданы...? Сонымен, мен аздап айналма жолмен жүре аламын ба?
Dialogue: 0,0:10:24.16,0:10:28.53,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:28.53,0:10:31.56,Default,,0000,0000,0000,,Мен оны осы жерде деп ойладым, бірақ...
Dialogue: 0,0:10:31.56,0:10:34.42,Default,,0000,0000,0000,,Қайда бара жатырсың? Мен жаға сатып алғым келеді.
Dialogue: 0,0:10:34.42,0:10:36.78,Default,,0000,0000,0000,,А~ Түсіндім! Бұл ретте →
Dialogue: 0,0:10:36.78,0:10:39.31,Default,,0000,0000,0000,,Маған мысық ойыншықтары және басқа заттар керек.
Dialogue: 0,0:10:39.31,0:10:42.00,Default,,0000,0000,0000,,Ойыншықтар….
Dialogue: 0,0:10:42.00,0:10:44.00,Default,,0000,0000,0000,,Сонда мен білемін!
Dialogue: 0,0:10:46.87,0:10:49.91,Default,,0000,0000,0000,,Олар оны міндетті түрде осында сатады!
Dialogue: 0,0:10:49.91,0:10:52.91,Default,,0000,0000,0000,,Мен сенімдімін... бірақ сіз қателесесіз!
Dialogue: 0,0:10:54.95,0:10:56.31,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:10:56.31,0:11:02.54,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:11:02.54,0:11:05.24,Default,,0000,0000,0000,,≪Бұл ақ мысық, оған қандай түс жарасады? ≫
Dialogue: 0,0:11:05.24,0:11:08.26,Default,,0000,0000,0000,,≪Қызыл көк…≫
Dialogue: 0,0:11:08.26,0:11:10.45,Default,,0000,0000,0000,,≪Мен байсалды болдым≫
Dialogue: 0,0:11:10.45,0:11:14.32,Default,,0000,0000,0000,,Сіз бұл мысыққа мән бересіз, солай емес пе?
Dialogue: 0,0:11:14.32,0:11:18.86,Default,,0000,0000,0000,,Мен де Рун-чанға көңіл бөлемін. Апыр-ай! аа….
Dialogue: 0,0:11:18.86,0:11:20.86,Default,,0000,0000,0000,,Мен білемін. Ку... қытықтайды!
Dialogue: 0,0:11:22.07,0:11:26.78,Default,,0000,0000,0000,,«Гунилерге» қош келдіңіз! Сізді күткенім үшін кешіріңіз. →
Dialogue: 0,0:11:26.78,0:11:30.49,Default,,0000,0000,0000,,Осы жерді басыңыз. Тору диван жағы.
Dialogue: 0,0:11:30.49,0:11:32.49,Default,,0000,0000,0000,,Жоқ, Ран-чан, өтінемін.
Dialogue: 0,0:11:35.03,0:11:38.03,Default,,0000,0000,0000,,Бірге отыруымыз керек емес пе? Аа….
Dialogue: 0,0:11:40.42,0:11:45.47,Default,,0000,0000,0000,,Аа, дұрыс, бұл менің мысығым...
Dialogue: 0,0:11:45.47,0:11:47.82,Default,,0000,0000,0000,,Ішетін барларға келгенде түсініксіз.
Dialogue: 0,0:11:47.82,0:11:50.35,Default,,0000,0000,0000,,Дыбыстық сигнал! (операция дыбысы) Бип!
Dialogue: 0,0:11:50.35,0:11:53.04,Default,,0000,0000,0000,,Дыбыстық сигнал! Бип!
Dialogue: 0,0:11:53.04,0:11:55.91,Default,,0000,0000,0000,,Неше түрі бар? Бірден бес дәмді рет →
Dialogue: 0,0:11:55.91,0:11:59.60,Default,,0000,0000,0000,,Аралас шырын!
Dialogue: 0,0:11:59.60,0:12:02.47,Default,,0000,0000,0000,,Біз мысықтың атын әлі шешкен жоқпыз.
Dialogue: 0,0:12:02.47,0:12:05.50,Default,,0000,0000,0000,,Хм, мен жақсы ештеңе ойлай алмаймын.
Dialogue: 0,0:12:05.50,0:12:07.52,Default,,0000,0000,0000,,Тәттілер мен шырындар қалай аталады?
Dialogue: 0,0:12:07.52,0:12:10.22,Default,,0000,0000,0000,,Сізге Тоору ұнайды, солай ма? Әй, бұл жақсы.
Dialogue: 0,0:12:10.22,0:12:15.27,Default,,0000,0000,0000,,Бұнда қазір кола, сидр және рамуна бар→
Dialogue: 0,0:12:15.27,0:12:19.97,Default,,0000,0000,0000,,Зімбір але Себебі бұл қауын содасы…→
Dialogue: 0,0:12:19.97,0:12:22.97,Default,,0000,0000,0000,,Барлығы бірге: «көмір қышқылы»! Уф...
Dialogue: 0,0:12:26.54,0:12:28.06,Default,,0000,0000,0000,,Ня~ Мен үйдемін~!
Dialogue: 0,0:12:28.06,0:12:30.41,Default,,0000,0000,0000,,Қалайсың? Бүгіннен бастап→
Dialogue: 0,0:12:30.41,0:12:33.28,Default,,0000,0000,0000,,Сіздің атыңыз көміртек.
Dialogue: 0,0:12:33.28,0:12:35.63,Default,,0000,0000,0000,,Бұл бала тыныш.
Dialogue: 0,0:12:35.63,0:12:38.83,Default,,0000,0000,0000,,Менің зорлық-зомбылық көрсететін кездерім болады.
Dialogue: 0,0:12:38.83,0:12:40.52,Default,,0000,0000,0000,,Газдалған жаға сізге жарасады.
Dialogue: 0,0:12:40.52,0:12:43.88,Default,,0000,0000,0000,,Ня~ Сүйкімді~ Сүйкімді~.
Dialogue: 0,0:12:43.88,0:12:45.23,Default,,0000,0000,0000,,Хмм…. (Газдалған) Ня~
Dialogue: 0,0:12:45.23,0:12:48.93,Default,,0000,0000,0000,,Иә? Күріш пе? Мен оны қазір саған беремін.
Dialogue: 0,0:12:48.93,0:12:51.12,Default,,0000,0000,0000,,А, мен содаға ойыншықтар сатып алдым→
Dialogue: 0,0:12:51.12,0:12:54.32,Default,,0000,0000,0000,,Кешкі астан кейін ойнайық. Хмм….
Dialogue: 0,0:12:54.32,0:12:56.51,Default,,0000,0000,0000,,Мияу! Рун-чан, сөйлесейік!
Dialogue: 0,0:12:56.51,0:12:59.04,Default,,0000,0000,0000,,Мияу
Dialogue: 0,0:12:59.04,0:13:02.04,Default,,0000,0000,0000,,Соңында Рун-чанды алып кетті...
Dialogue: 0,0:15:12.37,0:15:14.89,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:15:14.89,0:15:18.59,Default,,0000,0000,0000,,Хмм... мммм.
Dialogue: 0,0:15:18.59,0:15:20.59,Default,,0000,0000,0000,,Ха! иә….
Dialogue: 0,0:15:21.96,0:15:23.15,Default,,0000,0000,0000,,Ня~
Dialogue: 0,0:15:23.15,0:15:25.15,Default,,0000,0000,0000,,Хмм... хмм?
Dialogue: 0,0:15:27.35,0:15:29.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:29.54,0:15:31.54,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:34.26,0:15:38.96,Default,,0000,0000,0000,,Ня~ Қайырлы таң газдалған.
Dialogue: 0,0:15:38.96,0:15:41.66,Default,,0000,0000,0000,,Ня~ Ня~
Dialogue: 0,0:15:41.66,0:15:44.35,Default,,0000,0000,0000,,Кочо Кочо… Кочо Кочо Кочо Кочо….
Dialogue: 0,0:15:44.35,0:15:46.54,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:15:46.54,0:15:49.40,Default,,0000,0000,0000,,Аа, бұл ұзақ болды.
Dialogue: 0,0:15:49.40,0:15:51.40,Default,,0000,0000,0000,,Мен киімімді ауыстыруым керек. Мия~ Мия~
Dialogue: 0,0:15:54.78,0:15:56.78,Default,,0000,0000,0000,,Ня~
Dialogue: 0,0:15:58.99,0:16:02.20,Default,,0000,0000,0000,,Мияу! Мия~ Мия~
Dialogue: 0,0:16:02.20,0:16:05.56,Default,,0000,0000,0000,,Жоқ, ол сіздің формаңызға шаш түседі.
Dialogue: 0,0:16:05.56,0:16:07.59,Default,,0000,0000,0000,,Менің жалқаулыққа уақытым жоқ.
Dialogue: 0,0:16:07.59,0:16:11.79,Default,,0000,0000,0000,,Бүгін таңертеңнен бастап өте суық күн болады. →
Dialogue: 0,0:16:11.79,0:16:13.48,Default,,0000,0000,0000,,Күндіз қар жауу ықтималдығы жоғары →
Dialogue: 0,0:16:13.48,0:16:16.51,Default,,0000,0000,0000,,Сыртқа шыққанда абай болыңыз.
Dialogue: 0,0:16:16.51,0:16:20.51,Default,,0000,0000,0000,,Ня~ Ня~ Мен көмектесе алмаймын.
Dialogue: 0,0:16:21.39,0:16:23.58,Default,,0000,0000,0000,,Ня~
Dialogue: 0,0:16:23.58,0:16:29.47,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:29.47,0:16:32.84,Default,,0000,0000,0000,,Онда мен барамын. Мяу~
Dialogue: 0,0:16:32.84,0:16:35.87,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:35.87,0:16:38.23,Default,,0000,0000,0000,,Ах... Мяу~
Dialogue: 0,0:16:38.23,0:16:40.58,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:16:40.58,0:16:44.95,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:44.95,0:16:48.95,Default,,0000,0000,0000,,Хмм…. Ха! мм... хмм!
Dialogue: 0,0:16:50.18,0:16:53.88,Default,,0000,0000,0000,,Қарғыс атсын! Хмф!
Dialogue: 0,0:16:53.88,0:16:56.58,Default,,0000,0000,0000,,Ня~
Dialogue: 0,0:16:56.58,0:16:59.58,Default,,0000,0000,0000,,Хохо хохо...
Dialogue: 0,0:17:01.29,0:17:03.32,Default,,0000,0000,0000,,...
Dialogue: 0,0:17:03.32,0:17:06.51,Default,,0000,0000,0000,,Қайырлы таң Тоору. Көрініс~ (жел дыбысы)
Dialogue: 0,0:17:06.51,0:17:10.51,Default,,0000,0000,0000,,Уф... бүгін күн одан сайын салқындап барады.
Dialogue: 0,0:17:13.24,0:17:16.94,Default,,0000,0000,0000,,Бүгін қар жауатын сияқты, Рун-чан, болжам бойынша.
Dialogue: 0,0:17:16.94,0:17:19.94,Default,,0000,0000,0000,,Иә! Бір минут күтіңіз! Аа….
Dialogue: 0,0:17:27.72,0:17:29.57,Default,,0000,0000,0000,,Хаа хаа ха....
Dialogue: 0,0:17:29.57,0:17:31.57,Default,,0000,0000,0000,,Не болды? Хахаха….
Dialogue: 0,0:17:33.61,0:17:36.61,Default,,0000,0000,0000,,Я~! Мен сироп әкелдім.
Dialogue: 0,0:17:38.83,0:17:40.83,Default,,0000,0000,0000,,Қарда? иә!
Dialogue: 0,0:17:45.73,0:17:48.76,Default,,0000,0000,0000,,（）→
Dialogue: 0,0:17:48.76,0:17:52.13,Default,,0000,0000,0000,,Бүгін де таңертең күн суытады. Иә.
Dialogue: 0,0:17:52.13,0:17:55.13,Default,,0000,0000,0000,,Қайырлы таң…. (3 адам) Әй, қайырлы таң... Әй!
Dialogue: 0,0:17:56.84,0:17:59.54,Default,,0000,0000,0000,,Наги! Бұл қандай көрінеді?
Dialogue: 0,0:17:59.54,0:18:02.24,Default,,0000,0000,0000,,Мен болжамда қар жауады деп естідім, солай істедім.
Dialogue: 0,0:18:02.24,0:18:05.09,Default,,0000,0000,0000,,Ассасинге ұқсайды, өте керемет!
Dialogue: 0,0:18:05.09,0:18:07.09,Default,,0000,0000,0000,,Бұл азғынның қателігі емес пе?
Dialogue: 0,0:18:09.97,0:18:12.83,Default,,0000,0000,0000,,Неге сонша суық→
Dialogue: 0,0:18:12.83,0:18:15.53,Default,,0000,0000,0000,,Мен мектепке дейін жетуім керек пе?
Dialogue: 0,0:18:15.53,0:18:17.53,Default,,0000,0000,0000,,Студент болған соң, көрініп тұр.
Dialogue: 0,0:18:19.57,0:18:22.94,Default,,0000,0000,0000,,күрсіну…. Күз біткен соң, көктемге дейін →
Dialogue: 0,0:18:22.94,0:18:25.30,Default,,0000,0000,0000,,Қысқы демалысты алған дұрыс емес пе?
Dialogue: 0,0:18:25.30,0:18:28.82,Default,,0000,0000,0000,,Қыс жек көремін. Жаз – жаз →
Dialogue: 0,0:18:28.82,0:18:30.35,Default,,0000,0000,0000,,Сіз үнемі ыстық деп айттыңыз.
Dialogue: 0,0:18:30.35,0:18:32.53,Default,,0000,0000,0000,,Енді қар жауатын күндері →
Dialogue: 0,0:18:32.53,0:18:36.90,Default,,0000,0000,0000,,Өмір сүруге сенімім жоқ... Немене, қараңғы болып барады!
Dialogue: 0,0:18:36.90,0:18:39.27,Default,,0000,0000,0000,,Қар қызыққа толы! иә?
Dialogue: 0,0:18:39.27,0:18:41.13,Default,,0000,0000,0000,,Ақшақар жасау немесе камакура жасау→
Dialogue: 0,0:18:41.13,0:18:43.31,Default,,0000,0000,0000,,Бізде қарлы төбелес болады!
Dialogue: 0,0:18:43.31,0:18:47.02,Default,,0000,0000,0000,,Ендеше, Наги-чан да қар үшін дұға ет!
Dialogue: 0,0:18:47.02,0:18:49.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:49.54,0:18:51.89,Default,,0000,0000,0000,,Ах! Апыр-ай!
Dialogue: 0,0:18:51.89,0:18:55.26,Default,,0000,0000,0000,,Сіз мені тыңдамадыңыз ба?!
Dialogue: 0,0:18:55.26,0:18:57.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:57.62,0:19:05.53,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:05.53,0:19:08.39,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:08.39,0:19:11.59,Default,,0000,0000,0000,,Ешқашан жаңбыр жаумайды.
Dialogue: 0,0:19:11.59,0:19:13.28,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:19:13.28,0:19:18.83,Default,,0000,0000,0000,,Кин Хон Хан…
Dialogue: 0,0:19:18.83,0:19:21.86,Default,,0000,0000,0000,,Сіз әлі бас тартқан жоқсыз.
Dialogue: 0,0:19:21.86,0:19:25.89,Default,,0000,0000,0000,,Мен оның жартысынан бас тарттым. Бәрінен бас тарт.
Dialogue: 0,0:19:25.89,0:19:27.58,Default,,0000,0000,0000,,… （）～→
Dialogue: 0,0:19:27.58,0:19:29.94,Default,,0000,0000,0000,,（  ）
Dialogue: 0,0:19:29.94,0:19:31.46,Default,,0000,0000,0000,,А... ә!
Dialogue: 0,0:19:31.46,0:19:34.15,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:19:34.15,0:19:37.18,Default,,0000,0000,0000,,Керемет! Көп болады ма деп ойлаймын!
Dialogue: 0,0:19:37.18,0:19:40.21,Default,,0000,0000,0000,,Рас, қар жауып тұр. Апыр-ай! →
Dialogue: 0,0:19:40.21,0:19:42.56,Default,,0000,0000,0000,,Ауа райы тез өзгереді.
Dialogue: 0,0:19:42.56,0:19:44.09,Default,,0000,0000,0000,,Жүгір, бұл жақсы болды... иә?
Dialogue: 0,0:19:44.09,0:19:46.44,Default,,0000,0000,0000,,Онда жоқ!
Dialogue: 0,0:19:46.44,0:19:50.48,Default,,0000,0000,0000,,Міне! Күріш, күріш! Қардың орнына түскі ас ішіңіз!
Dialogue: 0,0:19:50.48,0:20:06.31,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:06.31,0:20:08.83,Default,,0000,0000,0000,,Бұл жиналып қалатын сияқты.
Dialogue: 0,0:20:08.83,0:20:11.35,Default,,0000,0000,0000,,Импульс Бұл таңқаларлық.
Dialogue: 0,0:20:11.35,0:20:15.89,Default,,0000,0000,0000,,Мен осындай нәрсені бір рет көргім келеді.
Dialogue: 0,0:20:15.89,0:20:17.08,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:20:17.08,0:20:20.95,Default,,0000,0000,0000,,Толғаны сонша, түбі көрінбейді.
Dialogue: 0,0:20:20.95,0:20:23.97,Default,,0000,0000,0000,,Ахаха, мангаға ұқсайды.
Dialogue: 0,0:20:23.97,0:20:27.85,Default,,0000,0000,0000,,Мен осы жерден ұша аламын ба? Ха! Жоқ, бұл...
Dialogue: 0,0:20:27.85,0:20:31.72,Default,,0000,0000,0000,,А, сонда төбеден! Ах…→
Dialogue: 0,0:20:31.72,0:20:33.24,Default,,0000,0000,0000,,Менің ойымша, бұл мүмкін емес.
Dialogue: 0,0:20:33.24,0:20:51.59,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:51.59,0:20:53.94,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:20:53.94,0:20:56.97,Default,,0000,0000,0000,,Үйіліп қалды! Бұл керемет!
Dialogue: 0,0:20:56.97,0:20:59.97,Default,,0000,0000,0000,,Жарайды, кеттік! О!
Dialogue: 0,0:21:01.86,0:21:04.55,Default,,0000,0000,0000,,Хаха! Алақай!
Dialogue: 0,0:21:04.55,0:21:06.07,Default,,0000,0000,0000,,Thud!
Dialogue: 0,0:21:06.07,0:21:10.95,Default,,0000,0000,0000,,Ах! Жүгір... Жүгір-чан. Сіз өлдіңіз бе?
Dialogue: 0,0:21:10.95,0:21:14.82,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:14.82,0:21:18.69,Default,,0000,0000,0000,,Әму Аму…. (Юко) Е, мен жеймін!
Dialogue: 0,0:21:18.69,0:21:22.90,Default,,0000,0000,0000,,Рун-чан, жоқ! Ей, бәріміз, секірейік!
Dialogue: 0,0:21:22.90,0:21:24.25,Default,,0000,0000,0000,,Иә! Эй!
Dialogue: 0,0:21:24.25,0:21:26.44,Default,,0000,0000,0000,,Уау! Ах! Аа….
Dialogue: 0,0:21:26.44,0:21:28.96,Default,,0000,0000,0000,,Ахаха... ахахха!
Dialogue: 0,0:21:28.96,0:21:32.00,Default,,0000,0000,0000,,Кенеттен тоқтайтын кез келді. (2 адам) Иә?
Dialogue: 0,0:21:32.00,0:21:36.04,Default,,0000,0000,0000,,Сіз кенеттен не істеп жатырсыз? Бұл қауіпті емес пе?
Dialogue: 0,0:21:36.04,0:21:38.23,Default,,0000,0000,0000,,Ах! Не?
Dialogue: 0,0:21:38.23,0:21:41.92,Default,,0000,0000,0000,,Ахаха Юуко-чан, біртүрлі поза.
Dialogue: 0,0:21:41.92,0:21:43.77,Default,,0000,0000,0000,,Иә? Жасайық, Юуко.
Dialogue: 0,0:21:43.77,0:21:45.63,Default,,0000,0000,0000,,Бұл жәндік емес.
Dialogue: 0,0:21:45.63,0:21:47.63,Default,,0000,0000,0000,,Қар... (3 адам) Иә?
Dialogue: 0,0:21:49.50,0:21:52.36,Default,,0000,0000,0000,,Қар жылы, солай емес пе?
Dialogue: 0,0:21:52.36,0:21:54.89,Default,,0000,0000,0000,,Наги?
Dialogue: 0,0:21:54.89,0:21:57.25,Default,,0000,0000,0000,,Ой... ой...
Dialogue: 0,0:21:57.25,0:22:00.27,Default,,0000,0000,0000,,Наги, жақсысың ба? ой... у...
Dialogue: 0,0:22:00.27,0:22:02.79,Default,,0000,0000,0000,,Суық көрінеді. Бұл дұрыс!
Dialogue: 0,0:22:02.79,0:22:05.79,Default,,0000,0000,0000,,Иә? Мен Наги-чанды жылытамын!
Dialogue: 0,0:22:08.36,0:22:10.55,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Жүгіру-чан.
Dialogue: 0,0:22:10.55,0:22:13.58,Default,,0000,0000,0000,,Мен Наги-чанға камакура жасауды ойладым.
Dialogue: 0,0:22:13.58,0:22:16.11,Default,,0000,0000,0000,,Аа, өте жылы. →
Dialogue: 0,0:22:16.11,0:22:18.29,Default,,0000,0000,0000,,Мен сізге көмектесемін!
Dialogue: 0,0:22:18.29,0:22:21.49,Default,,0000,0000,0000,,Хмм… мм….
Dialogue: 0,0:22:21.49,0:22:23.49,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:22:26.20,0:22:28.20,Default,,0000,0000,0000,,Ей! Ха!
Dialogue: 0,0:22:30.92,0:22:33.11,Default,,0000,0000,0000,,Ммм!
Dialogue: 0,0:22:33.11,0:22:36.97,Default,,0000,0000,0000,,Хмм. (Юко) Хмм... Ха!
Dialogue: 0,0:22:36.97,0:22:38.49,Default,,0000,0000,0000,,Уф~ Ха...
Dialogue: 0,0:22:38.49,0:22:41.19,Default,,0000,0000,0000,,Уф! Жақсы!
Dialogue: 0,0:22:41.19,0:22:43.19,Default,,0000,0000,0000,,Наги-чан, болды!
Dialogue: 0,0:22:45.22,0:22:48.26,Default,,0000,0000,0000,,Тар сияқты... Наги: Жылы ма?
Dialogue: 0,0:22:48.26,0:22:51.26,Default,,0000,0000,0000,,А, сырттан. (Юко) Жақсы.
Dialogue: 0,0:22:52.30,0:22:54.65,Default,,0000,0000,0000,,Иә! (2 адам) Иә?
Dialogue: 0,0:22:54.65,0:22:58.03,Default,,0000,0000,0000,,Хэхехе~ Мүмкіндік бар, Юко-чан. сәуле!
Dialogue: 0,0:22:58.03,0:23:01.56,Default,,0000,0000,0000,,Ха! Апыр-ай!
Dialogue: 0,0:23:01.56,0:23:04.58,Default,,0000,0000,0000,,Ха! Апыр-ай! Хехе.
Dialogue: 0,0:23:04.58,0:23:08.29,Default,,0000,0000,0000,,Хехехе. Біз де барайық! сәуле!
Dialogue: 0,0:23:08.29,0:23:10.48,Default,,0000,0000,0000,,Иә! Ха!
Dialogue: 0,0:23:10.48,0:23:13.84,Default,,0000,0000,0000,,Уау! Хахаха!
Dialogue: 0,0:23:13.84,0:23:15.53,Default,,0000,0000,0000,,Ура! Хаха!
Dialogue: 0,0:23:15.53,0:23:26.80,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:26.80,0:23:45.82,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:45.82,0:23:51.55,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:51.55,0:24:05.86,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:05.86,0:24:25.39,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:25.39,0:24:45.59,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:45.59,0:24:54.59,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:00.74,0:25:02.93,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:25:02.93,0:25:06.97,Default,,0000,0000,0000,,Сыртта көп ойнасам да, бір ғажабым, суық тиген жоқпын.
Dialogue: 0,0:25:06.97,0:25:08.97,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:25:14.22,0:25:17.92,Default,,0000,0000,0000,,Неге тартып жатырсың? (пошта қоңырау үні)
Dialogue: 0,0:25:17.92,0:25:19.92,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:25:23.64,0:25:25.64,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:25:27.68,0:25:30.38,Default,,0000,0000,0000,,«Мен суық тиіп қалдым деп ойлаймын».
Dialogue: 0,0:25:30.38,0:25:33.38,Default,,0000,0000,0000,,Ах... иә...
Dialogue: 0,0:25:42.66,0:25:52.27,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:52.27,0:25:57.48,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:57.48,0:26:11.62,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:11.62,0:26:24.75,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:24.75,0:26:44.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:44.11,0:26:51.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:01.62,0:27:10.62,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:18.62,0:27:20.62,Default,,0000,0000,0000,,Ня~
Dialogue: 0,0:27:22.99,0:27:24.99,Default,,0000,0000,0000,,Иә? Мяу~
Dialogue: 0,0:27:28.22,0:27:30.91,Default,,0000,0000,0000,,Келіңіздер.
Dialogue: 0,0:27:30.91,0:27:32.91,Default,,0000,0000,0000,,Ня~
Dialogue: 0,0:27:34.78,0:27:36.30,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:27:36.30,0:27:38.30,Default,,0000,0000,0000,,Жылы.
Dialogue: 0,0:27:41.19,0:27:43.19,Default,,0000,0000,0000,,Бұл... суық...
Dialogue: 0,0:27:45.89,0:27:47.58,Default,,0000,0000,0000,,Иә! сәуле.
Dialogue: 0,0:27:47.58,0:27:50.11,Default,,0000,0000,0000,,Кәне, бәріміз, бар күшімізді салып, қарды тазалайық!
Dialogue: 0,0:27:50.11,0:27:53.14,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:27:53.14,0:27:55.14,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:27:56.64,0:28:02.64,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory