Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:08:08.59,0:08:14.60,Default,,0,0,0,,Аударма / Кеш кезең: natsukage Өңдеу: Сенрен Субтитр шығару: SweetSub
Dialogue: 0,0:08:08.59,0:08:14.60,Default,,0,0,0,,Бірінші жол
Dialogue: 0,0:00:18.62,0:00:20.00,Default,,0,0,0,,Шығу...
Dialogue: 0,0:00:40.77,0:00:43.02,Default,,0,0,0,,…Мейтенко Жорай
Dialogue: 0,0:00:43.48,0:00:45.52,Default,,0,0,0,,Қолайсыз ниет Директор
Dialogue: 0,0:00:45.52,0:00:50.03,Default,,0,0,0,,Түпнұсқа кескіндеменің соңында жартылай айна бар ма?
Dialogue: 0,0:00:50.32,0:00:51.91,Default,,0,0,0,,Көп уақыт болды ма?
Dialogue: 0,0:00:51.91,0:00:55.53,Default,,0,0,0,,Басқа суреттерді аяқтап, көптеген іс-шараларды аяқтады...
Dialogue: 0,0:00:55.91,0:00:59.08,Default,,0,0,0,,Бұл бет әлі боялмаған.
Dialogue: 0,0:00:59.08,0:01:01.62,Default,,0,0,0,,Кейінірек біреудің салған суретін қайта қарады
Dialogue: 0,0:01:03.63,0:01:05.54,Default,,0,0,0,,Дүние жүзінің картасы
Dialogue: 0,0:01:08.01,0:01:11.55,Default,,0,0,0,,Үш қылыш аяқталды
Dialogue: 0,0:01:19.68,0:01:21.06,Default,,0,0,0,,Қазірге дейін
Dialogue: 0,0:01:22.44,0:01:23.06,Default,,0,0,0,,ол ешқашан да жақсы ана болған жоқ
Dialogue: 0,0:01:23.81,0:01:26.44,Default,,0,0,0,,...
Dialogue: 0,0:01:26.44,0:01:29.07,Default,,0,0,0,,Сурет салуға қабілетіңіз бар ма?
Dialogue: 0,0:01:40.54,0:01:41.83,Default,,0,0,0,,Ол саған ұнайды ма?
Dialogue: 0,0:01:43.42,0:01:45.00,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:01:46.34,0:01:51.01,Default,,0,0,0,,...
Dialogue: 0,0:01:51.01,0:01:53.97,Default,,0,0,0,,Толық өзін-өзі бақылауды жартылай бояу
Dialogue: 0,0:01:55.64,0:01:57.22,Default,,0,0,0,,...
Dialogue: 0,0:02:02.35,0:02:03.73,Default,,0,0,0,,...
Dialogue: 0,0:02:04.60,0:02:07.73,Default,,0,0,0,,Жақсы
Dialogue: 0,0:02:08.07,0:02:10.73,Default,,0,0,0,,Әңгіменің соңғы бөлімі
Dialogue: 0,0:02:13.32,0:02:14.49,Default,,0,0,0,,Тайшаку хиро
Dialogue: 0,0:02:14.49,0:02:16.37,Default,,0,0,0,,Жаңа адам келді!
Dialogue: 0,0:02:16.37,0:02:17.49,Default,,0,0,0,,Жабық тұмсық
Dialogue: 0,0:02:17.49,0:02:21.20,Default,,0,0,0,,Санкио суретін жақсы бастау оңай.
Dialogue: 0,0:02:30.63,0:02:31.96,Default,,0,0,0,,Келу
Dialogue: 0,0:02:31.96,0:02:35.55,Default,,0,0,0,,Сіздің саяхатыңыздың қысқаша мазмұны Жеке әсерлер мен ойлар
Dialogue: 0,0:02:35.55,0:02:38.22,Default,,0,0,0,,Пайдалануға арналған өздігінен құрастырылған сымдар
Dialogue: 0,0:02:38.22,0:02:41.27,Default,,0,0,0,,Өлім тесігінің бөлек айнасы
Dialogue: 0,0:02:41.27,0:02:43.52,Default,,0,0,0,,Мейтенко Жорай
Dialogue: 0,0:02:43.52,0:02:44.89,Default,,0,0,0,,Мейтен?!
Dialogue: 0,0:02:44.89,0:02:47.52,Default,,0,0,0,,Бұл сома...
Dialogue: 0,0:02:47.52,0:02:49.36,Default,,0,0,0,,Түсінбеңіз
Dialogue: 0,0:02:49.36,0:02:51.90,Default,,0,0,0,,Бұрын сіз сенімді едіңіз.
Dialogue: 0,0:02:51.90,0:02:55.49,Default,,0,0,0,,Бұрын суретке түсуімнің себебі астананың жоғалуы...
Dialogue: 0,0:02:55.49,0:02:56.78,Default,,0,0,0,,Айтқыңыз келгені осы ма?
Dialogue: 0,0:02:56.78,0:02:58.12,Default,,0,0,0,,Сіз келмедіңіз бе?
Dialogue: 0,0:02:58.12,0:02:59.62,Default,,0,0,0,,Сенімсіз бе?
Dialogue: 0,0:02:59.62,0:03:01.49,Default,,0,0,0,,Сіз қажет емес адамсыз ба?
Dialogue: 0,0:03:01.49,0:03:03.00,Default,,0,0,0,,Сізде сұрақтар жоқ екеніне сенімдісіз бе?
Dialogue: 0,0:03:03.00,0:03:06.96,Default,,0,0,0,,Біліксіз адам!
Dialogue: 0,0:03:06.96,0:03:08.42,Default,,0,0,0,,Ганого!
Dialogue: 0,0:03:10.17,0:03:13.09,Default,,0,0,0,,Бұл бөлім менің суретім!
Dialogue: 0,0:03:41.70,0:03:42.58,Default,,0,0,0,,ол ешқашан да жақсы ана болған жоқ
Dialogue: 0,0:03:43.33,0:03:44.70,Default,,0,0,0,,Сізге не ұнайды?
Dialogue: 0,0:03:45.37,0:03:46.71,Default,,0,0,0,,...
Dialogue: 0,0:03:47.04,0:03:48.71,Default,,0,0,0,,Нұсқау сипаты
Dialogue: 0,0:03:48.71,0:03:51.34,Default,,0,0,0,,Басқа Kikin кескіндеменің ерекше нүктесі
Dialogue: 0,0:03:51.63,0:03:54.09,Default,,0,0,0,,Қозғалыс бағыты табиғи түрде аяқталды.
Dialogue: 0,0:03:55.21,0:03:56.97,Default,,0,0,0,,Гоган…
Dialogue: 0,0:04:05.85,0:04:06.98,Default,,0,0,0,,...
Dialogue: 0,0:04:08.48,0:04:12.86,Default,,0,0,0,,Сіздің кейіпкеріңіз туралы ойыңыздың салмағы қандай?
Dialogue: 0,0:04:12.86,0:04:14.98,Default,,0,0,0,,Салмақ сезімі...
Dialogue: 0,0:04:18.11,0:04:19.41,Default,,0,0,0,,Сізге бір дөрекі сурет бар ма?
Dialogue: 0,0:04:19.41,0:04:20.78,Default,,0,0,0,,Сыртқы келбеті...
Dialogue: 0,0:04:20.78,0:04:22.70,Default,,0,0,0,,Жағдайды растау…
Dialogue: 0,0:04:22.70,0:04:24.66,Default,,0,0,0,,Бұзатын жел бар ма?
Dialogue: 0,0:04:39.76,0:04:40.63,Default,,0,0,0,,Ол саған ұнайды ма?
Dialogue: 0,0:04:41.51,0:04:45.51,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:55.27,0:04:56.90,Default,,0,0,0,,...
Dialogue: 0,0:05:18.80,0:05:21.30,Default,,0,0,0,,Бұл суреттің түпнұсқасы ма?
Dialogue: 0,0:05:23.05,0:05:25.05,Default,,0,0,0,,Дұрыс…
Dialogue: 0,0:05:28.06,0:05:30.52,Default,,0,0,0,,Бұл картинаның астанасы шағын.
Dialogue: 0,0:05:31.56,0:05:34.31,Default,,0,0,0,,Мен сіздермен ақпарат алмастым.
Dialogue: 0,0:05:34.31,0:05:39.61,Default,,0,0,0,,...
Dialogue: 0,0:05:50.29,0:05:52.08,Default,,0,0,0,,Махо суреті...
Dialogue: 0,0:05:56.71,0:05:57.63,Default,,0,0,0,,Енді олар жай ғана кішігірім бандиттер тобы
Dialogue: 0,0:06:01.76,0:06:02.93,Default,,0,0,0,,Макото
Dialogue: 0,0:06:19.73,0:06:25.24,Default,,0,0,0,,Қаланың негізгі мүмкіндігін түсінетін резидент емес адам қайта-қайта тырысады.
Dialogue: 0,0:06:25.24,0:06:27.66,Default,,0,0,0,,Бұл менің қиялымның бөлігі
Dialogue: 0,0:06:33.71,0:06:35.62,Default,,0,0,0,,Қайда... сонша алыста
Dialogue: 0,0:06:36.33,0:06:37.63,Default,,0,0,0,,Кездесуді ұйымдастыру
Dialogue: 0,0:06:38.38,0:06:39.92,Default,,0,0,0,,Мына суретті қараңыз!
Dialogue: 0,0:06:43.26,0:06:47.39,Default,,0,0,0,,Нәтижесінде сурет менің ниетімнің шығысы мен батысында пайда болмады.
Dialogue: 0,0:06:51.39,0:06:53.89,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:07:28.18,0:07:32.47,Default,,0,0,0,,Кескіндеме кескіндеме Кескіндеменің шығу тегі!
Dialogue: 0,0:07:32.85,0:07:34.73,Default,,0,0,0,,Тоқтаудың қажеті жоқ
Dialogue: 0,0:07:34.73,0:07:36.35,Default,,0,0,0,,Сапты жазалаңыз!
Dialogue: 0,0:07:36.35,0:07:38.98,Default,,0,0,0,,Суреттің төменгі жағы кетіп қалды Суреттің төменгі жағы қалды Суреттің төменгі жағы тоқтатылмайды!
Dialogue: 0,0:07:59.42,0:08:00.21,Default,,0,0,0,,Қазірге дейін
Dialogue: 0,0:00:18.62,0:00:20.00,Default,,0,0,0,,Мен шығаруым керек пе...
Dialogue: 0,0:00:40.77,0:00:43.02,Default,,0,0,0,,…Соңғы мерзім ертең.
Dialogue: 0,0:00:43.48,0:00:45.52,Default,,0,0,0,,Кешіріңіз, директор.
Dialogue: 0,0:00:45.52,0:00:50.03,Default,,0,0,0,,Сюжеттік тақтаның соңғы бөлігі Аниматор бар ма?
Dialogue: 0,0:00:50.32,0:00:51.91,Default,,0,0,0,,Нагасеге не болды?
Dialogue: 0,0:00:51.91,0:00:55.53,Default,,0,0,0,,Алдыңғы қолымды көтеріп жатқанда, құлап қалдым...
Dialogue: 0,0:00:55.91,0:00:59.08,Default,,0,0,0,,Бұл кесу, ауада қалқып жүру қиын.
Dialogue: 0,0:00:59.08,0:01:01.62,Default,,0,0,0,,Кімді кейін ұру керектігін ойланыңыз.
Dialogue: 0,0:01:03.63,0:01:05.54,Default,,0,0,0,,Тексеріңіз
Dialogue: 0,0:01:08.01,0:01:11.55,Default,,0,0,0,,Мито Ақырында тұрдың ба?
Dialogue: 0,0:01:19.68,0:01:21.06,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:22.44,0:01:23.06,Default,,0,0,0,,Ум...
Dialogue: 0,0:01:23.81,0:01:26.44,Default,,0,0,0,,Түзетілуі керек нәрсе болса...
Dialogue: 0,0:01:26.44,0:01:29.07,Default,,0,0,0,,Мен қалай жақсара аламын?
Dialogue: 0,0:01:40.54,0:01:41.83,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:01:43.42,0:01:45.00,Default,,0,0,0,,Бұл мен Май-санды енді ешқашан көре алмайтынымды білдіре ме?
Dialogue: 0,0:01:46.34,0:01:51.01,Default,,0,0,0,,Түзелгің келмесе, түзелгің келсе
Dialogue: 0,0:01:51.01,0:01:53.97,Default,,0,0,0,,Менің сюжеттік тақтаға сәйкес сурет салмаңыз
Dialogue: 0,0:01:55.64,0:01:57.22,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:02:02.35,0:02:03.73,Default,,0,0,0,,Иә
Dialogue: 0,0:02:04.60,0:02:07.73,Default,,0,0,0,,Жарайды, осы кесу жеткілікті.
Dialogue: 0,0:02:08.07,0:02:10.73,Default,,0,0,0,,Соңғы бөлім, сіз мұны жасайсыз.
Dialogue: 0,0:02:13.32,0:02:14.49,Default,,0,0,0,,Бұл абайсызда.
Dialogue: 0,0:02:14.49,0:02:16.37,Default,,0,0,0,,Жаңадан бастаушылар үшін тым көп!
Dialogue: 0,0:02:16.37,0:02:17.49,Default,,0,0,0,,Акселераторға да қолым жетпейді – орындық тым үлкен.
Dialogue: 0,0:02:17.49,0:02:21.20,Default,,0,0,0,,Жақсы болмаса да, оны түзету оңай.
Dialogue: 0,0:02:30.63,0:02:31.96,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:02:31.96,0:02:35.55,Default,,0,0,0,,Бұл жолы не сезіндіңіз, не ойладыңыз
Dialogue: 0,0:02:35.55,0:02:38.22,Default,,0,0,0,,Оны өз сызығымен айналдыр
Dialogue: 0,0:02:38.22,0:02:41.27,Default,,0,0,0,,Сюжетті сюжетті орындаудың орнына орындап көріңіз.
Dialogue: 0,0:02:41.27,0:02:43.52,Default,,0,0,0,,Соңғы мерзім ертең.
Dialogue: 0,0:02:43.52,0:02:44.89,Default,,0,0,0,,Ертең!?
Dialogue: 0,0:02:44.89,0:02:47.52,Default,,0,0,0,,А, жоқ, бұл сома...
Dialogue: 0,0:02:47.52,0:02:49.36,Default,,0,0,0,,…Күте тұр, біз шын мәнінде оларды атуымыз керек пе?!
Dialogue: 0,0:02:49.36,0:02:51.90,Default,,0,0,0,,Қарт, сіз мұны істей алуыңыз керек.
Dialogue: 0,0:02:51.90,0:02:55.49,Default,,0,0,0,,Ол кезде мен ештеңені ойламаған едім, сондықтан ерте еді...
Dialogue: 0,0:02:55.49,0:02:56.78,Default,,0,0,0,,Оу? Оооох!
Dialogue: 0,0:02:56.78,0:02:58.12,Default,,0,0,0,,Сіз алмайсыз ба?
Dialogue: 0,0:02:58.12,0:02:59.62,Default,,0,0,0,,Маған сенбейсің бе?
Dialogue: 0,0:02:59.62,0:03:01.49,Default,,0,0,0,,Сіз бұл сайтта қажет емес адамсыз ба?
Dialogue: 0,0:03:01.49,0:03:03.00,Default,,0,0,0,,Бұл мүшелерге айналуы мүмкін емес пе?
Dialogue: 0,0:03:03.00,0:03:06.96,Default,,0,0,0,,Сурет сала алмайтындар мұнда керек емес!
Dialogue: 0,0:03:06.96,0:03:08.42,Default,,0,0,0,,Сіз сурет сала аласыз!
Dialogue: 0,0:03:10.17,0:03:13.09,Default,,0,0,0,,Бұл бөлімді мен өзім жасаймын!
Dialogue: 0,0:03:41.70,0:03:42.58,Default,,0,0,0,,Ум...
Dialogue: 0,0:03:43.33,0:03:44.70,Default,,0,0,0,,Бұл туралы не ойлайсыз?
Dialogue: 0,0:03:45.37,0:03:46.71,Default,,0,0,0,,Дәмі жеткіліксіз!
Dialogue: 0,0:03:47.04,0:03:48.71,Default,,0,0,0,,Қадағалауға қатысты
Dialogue: 0,0:03:48.71,0:03:51.34,Default,,0,0,0,,Мен мұндай нәрселердің тиімді болғанын қалаймын.
Dialogue: 0,0:03:51.63,0:03:54.09,Default,,0,0,0,,Егер сіз біреуді бұрыннан танитын болсаңыз, онда сіз оның негізін білетін боласыз.
Dialogue: 0,0:03:55.21,0:03:56.97,Default,,0,0,0,,Керен дәмі…
Dialogue: 0,0:04:05.85,0:04:06.98,Default,,0,0,0,,Әй, Сенпай
Dialogue: 0,0:04:08.48,0:04:12.86,Default,,0,0,0,,Әлгі директор бұл жерде салмақ салғысы келмей ме?
Dialogue: 0,0:04:12.86,0:04:14.98,Default,,0,0,0,,Салмағы…
Dialogue: 0,0:04:18.11,0:04:19.41,Default,,0,0,0,,Бұл жерде шикі болып көрінбейді ме?
Dialogue: 0,0:04:19.41,0:04:20.78,Default,,0,0,0,,Масштаб сезімін берген дұрыс болар еді...
Dialogue: 0,0:04:20.78,0:04:22.70,Default,,0,0,0,,Міне, іші...
Dialogue: 0,0:04:22.70,0:04:24.66,Default,,0,0,0,,Оны желдей сезіну жақсы емес пе?
Dialogue: 0,0:04:39.76,0:04:40.63,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:04:41.51,0:04:45.51,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:04:55.27,0:04:56.90,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:05:18.80,0:05:21.30,Default,,0,0,0,,Сіз бұл түпнұсқа суретті салдыңыз ба?
Dialogue: 0,0:05:23.05,0:05:25.05,Default,,0,0,0,,Майури қабірге баруды бір күн де өткізіп көрген жоқ
Dialogue: 0,0:05:28.06,0:05:30.52,Default,,0,0,0,,Мен оны мүлде сала алмаймын.
Dialogue: 0,0:05:31.56,0:05:34.31,Default,,0,0,0,,Мен мұны сізге қалдырдым.
Dialogue: 0,0:05:34.31,0:05:39.61,Default,,0,0,0,,Сонда да маған айналамдағылардың айла-амалдарына еліктеп сурет салуды тапсырды.
Dialogue: 0,0:05:50.29,0:05:52.08,Default,,0,0,0,,Сіз бұған жақсы емессіз...
Dialogue: 0,0:05:56.71,0:05:57.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:01.76,0:06:02.93,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:06:19.73,0:06:25.24,Default,,0,0,0,,Бір мүмкіндікті пайдалана алмайтындар қанша тырысса да пайдасыз.
Dialogue: 0,0:06:25.24,0:06:27.66,Default,,0,0,0,,Мен бұл бөлік туралы бірдеңе істеймін.
Dialogue: 0,0:06:33.71,0:06:35.62,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:06:36.33,0:06:37.63,Default,,0,0,0,,Уақыт бөлу
Dialogue: 0,0:06:38.38,0:06:39.92,Default,,0,0,0,,Маған орындауға рұқсат етіңіз!
Dialogue: 0,0:06:43.26,0:06:47.39,Default,,0,0,0,,Егер мен өзімді қанағаттандыратын нәрсеге қол жеткізе алмасам, келесі қадам болмайды.
Dialogue: 0,0:06:51.39,0:06:53.89,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:07:28.18,0:07:32.47,Default,,0,0,0,,Сурет сал, сурет сал!
Dialogue: 0,0:07:32.85,0:07:34.73,Default,,0,0,0,,Тоқтамаңыз
Dialogue: 0,0:07:34.73,0:07:36.35,Default,,0,0,0,,Жолды іске қосыңыз!
Dialogue: 0,0:07:36.35,0:07:38.98,Default,,0,0,0,,Сурет сал, сыз, сыза бер!
Dialogue: 0,0:07:59.42,0:08:00.21,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:16.10,0:08:22.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
