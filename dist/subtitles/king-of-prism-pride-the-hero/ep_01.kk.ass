Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:28.23,0:00:32.44,Default,,0,0,0,,♪「ｐｒｉｄｅ」
Dialogue: 0,0:00:44.41,0:00:45.54,Default,,0,0,0,,«Мақтаныш» сөзін қолдана алмайсыз ба?
Dialogue: 0,0:00:46.54,0:00:48.29,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:00:48.92,0:00:49.92,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:50.25,0:00:51.46,Default,,0,0,0,,Әнді пайдалану құқығы -
Dialogue: 0,0:00:51.59,0:00:53.88,Default,,0,0,0,,Шварц басып алды
Dialogue: 0,0:00:54.22,0:00:55.26,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:00:55.76,0:00:57.55,Default,,0,0,0,,Қазіргідей бұл «мақтаныш»-
Dialogue: 0,0:00:57.68,0:01:00.51,Default,,0,0,0,,Призма патшасының кубогымен күресуге болмайды.
Dialogue: 0,0:01:00.68,0:01:01.97,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:02.18,0:01:04.02,Default,,0,0,0,,Құмарлық! Ыстық ауа!
Dialogue: 0,0:01:04.14,0:01:05.56,Default,,0,0,0,,Жұлдыз жарығы…
Dialogue: 0,0:01:06.85,0:01:07.69,Default,,0,0,0,,Поцелу!
Dialogue: 0,0:01:08.73,0:01:09.65,Default,,0,0,0,,Сәттілік…
Dialogue: 0,0:01:17.82,0:01:19.24,Default,,0,0,0,,Неліктен Шварцтың бейбақы?
Dialogue: 0,0:01:19.37,0:01:21.28,Default,,0,0,0,,Коджи жасаған «Мақтаныш».
Dialogue: 0,0:01:21.45,0:01:22.62,Default,,0,0,0,,Руи-кун
Dialogue: 0,0:01:22.95,0:01:25.62,Default,,0,0,0,,Бұл Шварцроздың Призма жұлдызы болды.
Dialogue: 0,0:01:25.75,0:01:26.79,Default,,0,0,0,,Бұл керемет~
Dialogue: 0,0:01:26.92,0:01:28.00,Default,,0,0,0,,Уау... Ухуфуфу...
Dialogue: 0,0:01:28.12,0:01:31.34,Default,,0,0,0,,Лев, сенің жаның бір-біріне жабысып қалды.
Dialogue: 0,0:01:31.88,0:01:33.34,Default,,0,0,0,,Бірақ бұл жігіт...
Dialogue: 0,0:01:33.71,0:01:35.05,Default,,0,0,0,,Бұл монофон.
Dialogue: 0,0:01:33.71,0:01:35.05,Default,,0,0,0,,«мақтаныш» бастапқыда...
Dialogue: 0,0:01:35.17,0:01:37.88,Default,,0,0,0,,Өйткені бұл маған қатты ұнаған ән болды.
Dialogue: 0,0:01:38.01,0:01:39.43,Default,,0,0,0,,Біздің перспективалы акцияларымыздың бірі болыңыз.
Dialogue: 0,0:01:39.55,0:01:41.97,Default,,0,0,0,,Мен сені ән салғым келді.
Dialogue: 0,0:01:42.10,0:01:44.93,Default,,0,0,0,,Мен оны Коудзи Камихамадан алдым ба?
Dialogue: 0,0:01:45.06,0:01:46.85,Default,,0,0,0,,Төтенше
Dialogue: 0,0:01:46.98,0:01:50.77,Default,,0,0,0,,Хиро Хаями ән мәтінін өзі жазбай тұра алмайды...
Dialogue: 0,0:01:50.90,0:01:53.48,Default,,0,0,0,,Олай болмаса, сахнада тұруым керек.
Dialogue: 0,0:01:53.61,0:01:55.86,Default,,0,0,0,,Менің Хайами-кунның дәлелін қабылдаудан басқа амалым қалмады...
Dialogue: 0,0:01:55.99,0:01:58.82,Default,,0,0,0,,Lucky дегеніміз не?Жұлдыз Джоның ұмытылған естелігі?
Dialogue: 0,0:01:58.95,0:02:04.49,Default,,0,0,0,,Аа, мен оны көптен бері сабағы бар деп ойладым.
Dialogue: 0,0:02:05.16,0:02:08.83,Default,,0,0,0,,Хаха~! Зама Миягаре!
Dialogue: 0,0:02:09.29,0:02:14.09,Default,,0,0,0,,Қасиетті! «Мақтаныш» пайдаланғыңыз келсе, ақшаны қайтарыңыз!
Dialogue: 0,0:02:14.34,0:02:16.55,Default,,0,0,0,,10 миллиард ~!
Dialogue: 0,0:02:16.67,0:02:19.18,Default,,0,0,0,,«Мақтаныш сезімін» білдірудің ең жақсы тәсілі қандай?
Dialogue: 0,0:02:19.30,0:02:20.34,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:02:20.55,0:02:21.97,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:22.10,0:02:23.68,Default,,0,0,0,,Сол жақтағы кішкентайлардың бірі қателесіп қолы тисе, қауіпті болар еді ғой, иә?
Dialogue: 0,0:02:24.43,0:02:30.19,Default,,0,0,0,,Ең керемет айдол махаббат♡СІЗДІ ЖАҚСЫ КӨРЕМІН!
Dialogue: 0,0:02:32.11,0:02:34.52,Default,,0,0,0,,Мені өзіңдікі ет
Dialogue: 0,0:02:35.07,0:02:36.82,Default,,0,0,0,,Мәңгі!
Dialogue: 0,0:02:37.19,0:02:38.65,Default,,0,0,0,,～♪
Dialogue: 0,0:02:38.65,0:02:42.20,Default,,0,0,0,,～♪
Dialogue: 0,0:02:38.65,0:02:42.20,Default,,0,0,0,,Мен Коудзидің әнін енді айта алмаймын...
Dialogue: 0,0:02:43.91,0:02:48.91,Default,,0,0,0,,♪～
Dialogue: 0,0:03:04.26,0:03:09.27,Default,,0,0,0,,～♪
Dialogue: 0,0:03:09.98,0:03:12.10,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:03:13.86,0:03:15.32,Default,,0,0,0,,Бүгінгі мәзір -
Dialogue: 0,0:03:15.52,0:03:19.28,Default,,0,0,0,,Көкөніс пен жеті шөптен жасалған салаты бар тауық еті.
Dialogue: 0,0:03:19.61,0:03:23.03,Default,,0,0,0,,Дәмді көрінеді! Минато-сан, бұл да?
Dialogue: 0,0:03:23.28,0:03:25.16,Default,,0,0,0,,Балдыркөк қосылған.
Dialogue: 0,0:03:25.28,0:03:26.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:26.83,0:03:28.37,Default,,0,0,0,,Хмм... дәмді!
Dialogue: 0,0:03:28.49,0:03:30.46,Default,,0,0,0,,Сузуно! Мен таң қалдым...
Dialogue: 0,0:03:30.62,0:03:34.42,Default,,0,0,0,,Табақтың артына тығылған сәбізді жеу.
Dialogue: 0,0:03:34.71,0:03:36.54,Default,,0,0,0,,Ең соңғы сүйікті тағамыңызды жеңіз!
Dialogue: 0,0:03:36.67,0:03:38.59,Default,,0,0,0,,Сайонжи~ Ха!
Dialogue: 0,0:03:38.80,0:03:43.09,Default,,0,0,0,,Ащы бұрышты тез жемесең, дәмі ащы болады.
Dialogue: 0,0:03:43.30,0:03:45.80,Default,,0,0,0,,Иә... Мм
Dialogue: 0,0:03:46.01,0:03:46.22,Default,,0,0,0,,Қазір Akamaru-ның танымалдығы тез өсіп келеді!
Dialogue: 0,0:03:46.22,0:03:47.31,Default,,0,0,0,,Қазір Akamaru-ның танымалдығы тез өсіп келеді!
Dialogue: 0,0:03:46.22,0:03:47.31,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:03:47.31,0:03:47.43,Default,,0,0,0,,Қазір Akamaru-ның танымалдығы тез өсіп келеді!
Dialogue: 0,0:03:47.43,0:03:48.26,Default,,0,0,0,,Қазір Akamaru-ның танымалдығы тез өсіп келеді!
Dialogue: 0,0:03:47.43,0:03:48.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:48.60,0:03:50.89,Default,,0,0,0,,Міне, Шварц қатты итермелейді...
Dialogue: 0,0:03:51.02,0:03:52.98,Default,,0,0,0,,Призма жұлдыз бірлігі?
Dialogue: 0,0:03:53.19,0:03:56.44,Default,,0,0,0,,Барлығын күлімдеп жарқыратыңыз!
Dialogue: 0,0:03:56.86,0:03:59.90,Default,,0,0,0,,Жарылыңыз! Тура арманда!
Dialogue: 0,0:04:00.28,0:04:01.57,Default,,0,0,0,,Сіздің але
Dialogue: 0,0:04:01.69,0:04:03.36,Default,,0,0,0,,Ең жақсы толық үй!
Dialogue: 0,0:04:03.66,0:04:06.91,Default,,0,0,0,,Жылы сезіммен төрт түрлі!
Dialogue: 0,0:04:07.33,0:04:08.66,Default,,0,0,0,,Менің ең күшті есте сақтау қабілетім
Dialogue: 0,0:04:08.79,0:04:10.83,Default,,0,0,0,,Мен мұны саған жасаймын, ха!
Dialogue: 0,0:04:10.95,0:04:12.71,Default,,0,0,0,,Аралас!
Dialogue: 0,0:04:12.83,0:04:16.58,Default,,0,0,0,,Махаббаттың Корольдік Тікелей Флюш!
Dialogue: 0,0:04:16.71,0:04:19.13,Default,,0,0,0,,Аха, керемет!
Dialogue: 0,0:04:19.25,0:04:20.51,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:04:20.80,0:04:22.05,Default,,0,0,0,,Байланыс -
Dialogue: 0,0:04:22.17,0:04:25.47,Default,,0,0,0,,Ақымақтардың істеген ісін жұлып жатырмын.
Dialogue: 0,0:04:25.59,0:04:28.10,Default,,0,0,0,,Маған ұнамайды... иә?
Dialogue: 0,0:04:32.68,0:04:34.39,Default,,0,0,0,,Тайга Иә!
Dialogue: 0,0:04:34.85,0:04:38.52,Default,,0,0,0,,Мен сізге Эдель Роуздың көше стилін қалдырамын.
Dialogue: 0,0:04:38.94,0:04:40.02,Default,,0,0,0,,Кадзуки мырза?
Dialogue: 0,0:04:42.44,0:04:45.82,Default,,0,0,0,,Бұл не? Тайга-кюн өзін жақсы сезінбейді.
Dialogue: 0,0:04:45.95,0:04:46.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:46.74,0:04:47.74,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:47.87,0:04:50.45,Default,,0,0,0,,Хмм... иә? Ой...
Dialogue: 0,0:04:51.37,0:04:52.91,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:04:53.04,0:04:54.29,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:04:54.41,0:04:55.42,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:55.54,0:04:57.38,Default,,0,0,0,,Минатокки толтыру~
Dialogue: 0,0:04:57.54,0:04:59.71,Default,,0,0,0,,Иә, иә... Иә?
Dialogue: 0,0:05:00.04,0:05:01.92,Default,,0,0,0,,Хиро-сан, қош келдіңіз
Dialogue: 0,0:05:02.05,0:05:02.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:02.88,0:05:04.55,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:05:04.67,0:05:06.59,Default,,0,0,0,,Қайта қош келдіңіз Қайта қош келдіңіз~
Dialogue: 0,0:05:06.72,0:05:08.72,Default,,0,0,0,,Кешкі ас дайын.
Dialogue: 0,0:05:08.85,0:05:10.72,Default,,0,0,0,,Мұнда бұрынғы obare-
Dialogue: 0,0:05:08.85,0:05:10.72,Default,,0,0,0,,Кешіріңіз, менің тәбетім онша емес.
Dialogue: 0,0:05:10.72,0:05:10.85,Default,,0,0,0,,Кешіріңіз, менің тәбетім онша емес.
Dialogue: 0,0:05:10.85,0:05:11.89,Default,,0,0,0,,Кешіріңіз, менің тәбетім онша емес.
Dialogue: 0,0:05:10.85,0:05:11.89,Default,,0,0,0,,Коудзи Камихама жанкүйерлері үшін -
Dialogue: 0,0:05:11.89,0:05:12.02,Default,,0,0,0,,Кешіріңіз, менің тәбетім онша емес.
Dialogue: 0,0:05:12.02,0:05:12.77,Default,,0,0,0,,Кешіріңіз, менің тәбетім көп емес.
Dialogue: 0,0:05:12.02,0:05:12.77,Default,,0,0,0,,Біз сізге үлкен жаңалық әкелеміз.
Dialogue: 0,0:05:12.77,0:05:12.89,Default,,0,0,0,,Біз сізге үлкен жаңалық әкелеміз.
Dialogue: 0,0:05:12.89,0:05:13.93,Default,,0,0,0,,Біз сізге үлкен жаңалық әкелеміз.
Dialogue: 0,0:05:12.89,0:05:13.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:13.93,0:05:14.23,Default,,0,0,0,,Біз сізге үлкен жаңалық әкелеміз.
Dialogue: 0,0:05:14.85,0:05:17.10,Default,,0,0,0,,The Shuffle тобының келесі синглы –
Dialogue: 0,0:05:17.23,0:05:20.06,Default,,0,0,0,,Голливудта өте белсенді Коджи Камихама...
Dialogue: 0,0:05:20.19,0:05:22.23,Default,,0,0,0,,Ол маған жасауды шешті!
Dialogue: 0,0:05:22.44,0:05:23.61,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:24.15,0:05:27.16,Default,,0,0,0,,Коудзидің Шварцқа ән жазуы мүмкін емес!
Dialogue: 0,0:05:27.53,0:05:32.12,Default,,0,0,0,,Мен ең күшті Призма патшасы Хироға қарсы теріс жорық жасап жатырмын.
Dialogue: 0,0:05:32.29,0:05:34.54,Default,,0,0,0,,Егер мен осындай нәрседен сәтсіздікке ұшырасам ...
Dialogue: 0,0:05:34.66,0:05:37.00,Default,,0,0,0,,Мен кумир бола алмаймын.
Dialogue: 0,0:05:38.29,0:05:39.83,Default,,0,0,0,,Хиро-сан...
Dialogue: 0,0:05:41.09,0:05:42.38,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:05:43.13,0:05:44.80,Default,,0,0,0,,Мені өзіңе шәкірт етші
Dialogue: 0,0:05:44.92,0:05:48.76,Default,,0,0,0,,Уф... Сізді көп рет келгенім үшін кешіріңіз.
Dialogue: 0,0:05:49.18,0:05:51.89,Default,,0,0,0,,Мен саған ештеңе үйрете алмаймын.
Dialogue: 0,0:05:52.01,0:05:54.97,Default,,0,0,0,,Ах... жарайды жасы
Dialogue: 0,0:05:55.31,0:05:57.64,Default,,0,0,0,,Сіз аштыңыз ба?
Dialogue: 0,0:05:57.77,0:05:58.90,Default,,0,0,0,,(Теледидарды өшіру дыбысы)
Dialogue: 0,0:05:59.06,0:06:00.15,Default,,0,0,0,,Хаха...
Dialogue: 0,0:06:00.94,0:06:01.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:02.32,0:06:06.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:07.11,0:06:09.45,Default,,0,0,0,,Хмф! Уф...
Dialogue: 0,0:06:09.61,0:06:11.20,Default,,0,0,0,,Тозаққа кет!
Dialogue: 0,0:06:11.32,0:06:13.62,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:13.74,0:06:15.16,Default,,0,0,0,,Өзіңізді жоюды жоспарлап отырсыз ба?
Dialogue: 0,0:06:15.29,0:06:17.33,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:06:18.04,0:06:19.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:19.12,0:06:23.13,Default,,0,0,0,,Казуки Нишина Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:06:30.13,0:06:32.30,Default,,0,0,0,,Ах... (Ямада) Кешіріңіз~
Dialogue: 0,0:06:32.43,0:06:33.35,Default,,0,0,0,,Иә
Dialogue: 0,0:06:34.51,0:06:35.72,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:36.22,0:06:38.98,Default,,0,0,0,,Мен мұндай нәрсеге көптен бері үйреніп қалғанмын.
Dialogue: 0,0:06:39.31,0:06:41.69,Default,,0,0,0,,Джиннің маған істегенімен салыстырғанда...
Dialogue: 0,0:06:41.81,0:06:43.82,Default,,0,0,0,,Бұл әлі біраз күрделі.
Dialogue: 0,0:06:45.73,0:06:48.44,Default,,0,0,0,,Сізге қарсы тұратын барлық нәрсені жойыңыз
Dialogue: 0,0:06:50.07,0:06:51.78,Default,,0,0,0,,Бұл Джиннің жолы
Dialogue: 0,0:06:53.20,0:06:54.53,Default,,0,0,0,,Ямада мырза...
Dialogue: 0,0:06:55.62,0:06:57.33,Default,,0,0,0,,Алдыңғы төлем үшін...
Dialogue: 0,0:06:57.45,0:07:00.67,Default,,0,0,0,,Мерзімді ұзартамын дедіңіз!
Dialogue: 0,0:07:00.92,0:07:04.17,Default,,0,0,0,,Кешіріңіз, бұл жоғарыдан келген бұйрық еді.
Dialogue: 0,0:07:04.38,0:07:06.17,Default,,0,0,0,,Призма патшасының кубогында
Dialogue: 0,0:07:06.30,0:07:09.97,Default,,0,0,0,,Егер мен Эдельроузымнан жеңімпаз шығара алмасам...
Dialogue: 0,0:07:10.22,0:07:13.34,Default,,0,0,0,,Несиені толық қайтарып алсаңыз ше!? Уф...
Dialogue: 0,0:07:13.85,0:07:17.43,Default,,0,0,0,,Бас банкке қысым көрсетеміз.
Dialogue: 0,0:07:17.56,0:07:20.81,Default,,0,0,0,,Егер біз сауданы тоқтатамыз деп қорқытсақ...
Dialogue: 0,0:07:20.94,0:07:23.69,Default,,0,0,0,,Кез келген компания таң қалады.
Dialogue: 0,0:07:23.81,0:07:27.53,Default,,0,0,0,,Эдельроузда мұндай монах бар ма?
Dialogue: 0,0:07:27.65,0:07:31.49,Default,,0,0,0,,Сондықтан біз әрбір бонбонды ұсақтайтын боламыз.
Dialogue: 0,0:07:31.70,0:07:34.78,Default,,0,0,0,,Егер компания мәңгілікке мұрагерлік жолмен басқарылатын болса.
Dialogue: 0,0:07:34.91,0:07:37.49,Default,,0,0,0,,Juoin тобы құлады
Dialogue: 0,0:07:37.70,0:07:42.96,Default,,0,0,0,,Я, маған сіздің көмегіңіз керек, басқарушы директор Санада.
Dialogue: 0,0:07:43.25,0:07:45.59,Default,,0,0,0,,Даңқты Шварц
Dialogue: 0,0:07:46.79,0:07:49.30,Default,,0,0,0,,Даңқты Шварц
Dialogue: 0,0:07:50.21,0:07:53.84,Default,,0,0,0,,Хахаха... Ахахаха...!
Dialogue: 0,0:07:54.09,0:07:56.30,Default,,0,0,0,,Призма патшасының кубогында-
Dialogue: 0,0:07:56.55,0:08:00.27,Default,,0,0,0,,Біздің Edel Rose командасынан үш адам қатыса алады.
Dialogue: 0,0:08:00.56,0:08:03.90,Default,,0,0,0,,Қауіпсіздікке жол бермеңіз және көрінетіндей жаттығу жасаңыз.
Dialogue: 0,0:08:04.02,0:08:04.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:05.23,0:08:08.57,Default,,0,0,0,,Жарайды~ Енді сіздің Хироды жеңу мүмкіндігіңіз бар!
Dialogue: 0,0:08:08.82,0:08:11.90,Default,,0,0,0,,Сіздің жаттықтырушыңыз Ямада мырза болады.
Dialogue: 0,0:08:12.03,0:08:14.99,Default,,0,0,0,,Барлығы~ Танысқаныма қуаныштымын!
Dialogue: 0,0:08:15.11,0:08:19.70,Default,,0,0,0,,Е! Ямада мырза, призмалық шоу жасай аласыз ба?
Dialogue: 0,0:08:19.83,0:08:21.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:21.12,0:08:23.92,Default,,0,0,0,,Не айтып тұрсың, ақымақ?
Dialogue: 0,0:08:24.29,0:08:27.04,Default,,0,0,0,,Ямада мырза Призма патшасының соңғы кубогында
Dialogue: 0,0:08:27.17,0:08:28.29,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:08:28.42,0:08:29.96,Default,,0,0,0,,Эх!
Dialogue: 0,0:08:30.38,0:08:32.42,Default,,0,0,0,,Шамасы... Ио!
Dialogue: 0,0:08:32.80,0:08:34.88,Default,,0,0,0,,Айтпақшы, Хироға не болды?
Dialogue: 0,0:08:35.43,0:08:37.43,Default,,0,0,0,,Мен сені таңнан бері көрмедім.
Dialogue: 0,0:08:37.55,0:08:39.47,Default,,0,0,0,,Осындай маңызды уақытта...
Dialogue: 0,0:08:39.60,0:08:41.35,Default,,0,0,0,,Маған кейінірек келіңіз (Ямада) Иә.
Dialogue: 0,0:08:41.47,0:08:42.68,Default,,0,0,0,,Ум... иә?
Dialogue: 0,0:08:42.81,0:08:47.52,Default,,0,0,0,,Юкиноджо-сан мен Тайга-кун Мен Какеру-санды да көрмедім...
Dialogue: 0,0:08:47.65,0:08:51.15,Default,,0,0,0,,Тачибана жаттығуда, Кадзуо жұмыс істейді
Dialogue: 0,0:08:51.69,0:08:53.15,Default,,0,0,0,,Кагами...
Dialogue: 0,0:08:53.36,0:08:56.11,Default,,0,0,0,,Иә? Қайда бардың?
Dialogue: 0,0:08:57.11,0:08:59.45,Default,,0,0,0,,Сонымен... күнде, күнде -
Dialogue: 0,0:08:59.58,0:09:02.54,Default,,0,0,0,,Осындай сәнді дүкенге не үшін келер едіңіз?
Dialogue: 0,0:09:02.79,0:09:03.83,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:09:03.96,0:09:05.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:08.04,0:09:09.21,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:09.92,0:09:12.42,Default,,0,0,0,,Хехе, біраз қыдыр.
Dialogue: 0,0:09:12.76,0:09:15.09,Default,,0,0,0,,Олар студент болғанымен, тағылымдамаға келгеннен кейін олар баға жетпес ресурс.
Dialogue: 0,0:09:16.68,0:09:17.97,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:21.85,0:09:23.27,Default,,0,0,0,,Жүр, жүр.
Dialogue: 0,0:09:23.39,0:09:24.43,Default,,0,0,0,,Иә! Кешіріңіз
Dialogue: 0,0:09:24.56,0:09:25.89,Default,,0,0,0,,Уау! мм...
Dialogue: 0,0:09:26.52,0:09:28.15,Default,,0,0,0,,Сәлем такси!
Dialogue: 0,0:09:40.12,0:09:40.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:41.24,0:09:44.08,Default,,0,0,0,,Сіз репетицияға мүлдем құштар емес сияқтысыз.
Dialogue: 0,0:09:44.25,0:09:46.75,Default,,0,0,0,,Көп жұмыс істе
Dialogue: 0,0:09:46.87,0:09:48.92,Default,,0,0,0,,Мен сенің жасыңда...
Dialogue: 0,0:09:49.17,0:09:50.79,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:51.09,0:09:53.71,Default,,0,0,0,,Бүгін бізде призма көрсету тәжірибесі бар, сондықтан...
Dialogue: 0,0:09:53.84,0:09:55.34,Default,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:09:55.46,0:09:56.88,Default,,0,0,0,,Күте тұрыңыз, Юкиноджо!
Dialogue: 0,0:09:57.01,0:09:57.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:01.60,0:10:02.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:03.97,0:10:05.89,Default,,0,0,0,,Сізде 200 триллион иендегі жалпы активтеріңіз бар.
Dialogue: 0,0:10:06.02,0:10:08.48,Default,,0,0,0,,Джуоин Зайбацу мұрагері.
Dialogue: 0,0:10:08.98,0:10:10.73,Default,,0,0,0,,Мәңгілік флирт жасама.
Dialogue: 0,0:10:10.86,0:10:13.73,Default,,0,0,0,,Осы елді иығыңда көтеріп жүргеніңді біл.
Dialogue: 0,0:10:14.36,0:10:16.53,Default,,0,0,0,,P.R.I.S.M ЖҮЙЕСІН тәжірибеде қолдану -
Dialogue: 0,0:10:16.65,0:10:20.70,Default,,0,0,0,,Көңіл көтеру әлемін қамтитын үлкен деректер индустриясын бақылауға алыңыз
Dialogue: 0,0:10:21.03,0:10:22.62,Default,,0,0,0,,Тыңда, Казуо.
Dialogue: 0,0:10:23.16,0:10:26.58,Default,,0,0,0,,Елдің тірегі болат пен бетон.
Dialogue: 0,0:10:27.04,0:10:29.17,Default,,0,0,0,,Басқарушы директор Санададан аздап үйреніңіз.
Dialogue: 0,0:10:30.17,0:10:34.38,Default,,0,0,0,,Қазіргі кезде де тұқым қуалаушылық жүйесіне қарсылық күшті.
Dialogue: 0,0:10:34.71,0:10:36.84,Default,,0,0,0,,Ең кішкентай мүмкіндікті көрсетсеңіз...
Dialogue: 0,0:10:37.17,0:10:38.72,Default,,0,0,0,,(Идзуми) Уау! Бұл өте қызықты естіледі.
Dialogue: 0,0:10:38.84,0:10:39.80,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:39.80,0:10:40.18,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:39.80,0:10:40.18,Default,,0,0,0,,А... Мазаладым, мазасыздандым
Dialogue: 0,0:10:40.18,0:10:40.89,Default,,0,0,0,,А... Мазаладым, мазасыздандым
Dialogue: 0,0:10:40.89,0:10:41.39,Default,,0,0,0,,А... Мазаладым, мазасыздандым
Dialogue: 0,0:10:40.89,0:10:41.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:41.39,0:10:42.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:49.27,0:10:50.48,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:50.60,0:10:53.77,Default,,0,0,0,,Маған осындай жерге қоңырау шалып, такси ақысын беруімді сұраңыз.
Dialogue: 0,0:10:53.90,0:10:55.15,Default,,0,0,0,,Тынш! сурет?
Dialogue: 0,0:10:58.61,0:11:02.49,Default,,0,0,0,,Кадзуки-кун, сен неге призма шоуын қойып жатырсың?
Dialogue: 0,0:11:02.74,0:11:06.70,Default,,0,0,0,,Бұл сіздің жүрегіңізді жылытады дегенді білдіре ме?
Dialogue: 0,0:11:07.16,0:11:10.00,Default,,0,0,0,,Мен еркіндік сезімін сезіне аламын...
Dialogue: 0,0:11:11.25,0:11:15.17,Default,,0,0,0,,Мен бұрын үмітсіз адам едім.
Dialogue: 0,0:11:15.59,0:11:16.84,Default,,0,0,0,,Бостандық дегеніміз не?
Dialogue: 0,0:11:16.96,0:11:19.76,Default,,0,0,0,,Мен қалаған нәрсені істей аламын деген кезде қате аяқ киім кидім.
Dialogue: 0,0:11:20.30,0:11:23.39,Default,,0,0,0,,Сені басатынның бәрі – жау...
Dialogue: 0,0:11:23.51,0:11:26.18,Default,,0,0,0,,Ол олардың әрқайсысын жоюға тырысты.
Dialogue: 0,0:11:27.47,0:11:31.14,Default,,0,0,0,,Мен Призма шоуына тап болдым.
Dialogue: 0,0:11:32.35,0:11:36.07,Default,,0,0,0,,Алғашында сахна ережелерімен байланысты болды...
Dialogue: 0,0:11:36.19,0:11:38.11,Default,,0,0,0,,Білем деп ойладым.
Dialogue: 0,0:11:38.82,0:11:40.57,Default,,0,0,0,,Бірақ бір рет...
Dialogue: 0,0:11:40.69,0:11:43.11,Default,,0,0,0,,Мен керемет жігітті кездестірдім.
Dialogue: 0,0:11:44.24,0:11:48.45,Default,,0,0,0,,Бір сахнада жекпе-жек өткізгісі келетіндерге
Dialogue: 0,0:11:52.16,0:11:53.17,Default,,0,0,0,,Кадзуки-кун
Dialogue: 0,0:11:53.50,0:11:54.58,Default,,0,0,0,,Иә
Dialogue: 0,0:11:55.46,0:11:58.13,Default,,0,0,0,,Курокава, салқын болғың келе ме?
Dialogue: 0,0:11:58.34,0:11:59.55,Default,,0,0,0,,Ах...!
Dialogue: 0,0:12:00.97,0:12:03.05,Default,,0,0,0,,Бұл суық, Курокава!
Dialogue: 0,0:12:03.55,0:12:06.01,Default,,0,0,0,,Бұл көше харизмасы?
Dialogue: 0,0:12:06.14,0:12:07.18,Default,,0,0,0,,Ууух!
Dialogue: 0,0:12:13.23,0:12:14.85,Default,,0,0,0,,А...
Dialogue: 0,0:12:16.23,0:12:19.19,Default,,0,0,0,,Ямада мырзаның сабағы ауыр болды.
Dialogue: 0,0:12:19.48,0:12:20.53,Default,,0,0,0,,Сіз бірдеңе шақырдыңыз ба?
Dialogue: 0,0:12:20.65,0:12:21.32,Default,,0,0,0,,Ах... Жақсы!
Dialogue: 0,0:12:21.74,0:12:22.95,Default,,0,0,0,,А, жоқ.
Dialogue: 0,0:12:23.07,0:12:24.78,Default,,0,0,0,,Шинге хат келді.
Dialogue: 0,0:12:24.99,0:12:25.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:25.99,0:12:27.49,Default,,0,0,0,,Бұл махаббат хаты ма?
Dialogue: 0,0:12:27.62,0:12:28.74,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:12:29.12,0:12:31.70,Default,,0,0,0,,Әйелдермен абай болыңыз~ Иә
Dialogue: 0,0:12:32.25,0:12:33.91,Default,,0,0,0,,Бұл еркектен!
Dialogue: 0,0:12:34.12,0:12:36.38,Default,,0,0,0,,Ер адамдар абай болу керек!
Dialogue: 0,0:12:36.50,0:12:37.88,Default,,0,0,0,,IBN 5100 — ол
Dialogue: 0,0:12:38.00,0:12:39.09,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:12:39.21,0:12:40.59,Default,,0,0,0,,Мм... иә?
Dialogue: 0,0:12:40.71,0:12:41.84,Default,,0,0,0,,Ахаха... (Ямада) Қараңдар!
Dialogue: 0,0:12:42.13,0:12:44.84,Default,,0,0,0,,Лайк, тамаша және тамаша! Мен, мен…
Dialogue: 0,0:12:48.55,0:12:49.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:52.43,0:12:53.64,Default,,0,0,0,,Руи-кун!
Dialogue: 0,0:12:53.77,0:12:55.69,Default,,0,0,0,,Уау, біраз уақыт өтті.
Dialogue: 0,0:12:56.98,0:12:58.98,Default,,0,0,0,,<Кодзи! Сіз данышпансыз! 〉
Dialogue: 0,0:12:59.36,0:13:01.48,Default,,0,0,0,,<Мен Коудзиге ғашық боламын деп ойлаймын! 〉
Dialogue: 0,0:13:01.86,0:13:02.74,Default,,0,0,0,,<Рахмет! 〉
Dialogue: 0,0:13:03.11,0:13:05.86,Default,,0,0,0,,〈Бірақ сүйкімді Steady сізді Жапонияда күтуде〉
Dialogue: 0,0:13:06.32,0:13:08.57,Default,,0,0,0,,〈Бұл ұят...〉
Dialogue: 0,0:13:08.95,0:13:09.62,Default,,0,0,0,,<Әй, бұдан былай...>
Dialogue: 0,0:13:09.74,0:13:10.95,Default,,0,0,0,,〈Үйде той жасап жатырмыз.Келесіздер ме? 〉
Dialogue: 0,0:13:11.29,0:13:12.70,Default,,0,0,0,,<Қуырылған күркетауық үшін>
Dialogue: 0,0:13:12.83,0:13:14.41,Default,,0,0,0,,〈Бізде Калифорния орамдары да бар! 〉
Dialogue: 0,0:13:14.66,0:13:15.62,Default,,0,0,0,,〈Ұнайды! 〉
Dialogue: 0,0:13:15.75,0:13:17.17,Default,,0,0,0,,〈Шие пирогын да қойыңыз! 〉
Dialogue: 0,0:13:17.71,0:13:18.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:19.08,0:13:20.54,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:13:21.13,0:13:22.42,Default,,0,0,0,,Ах... Хиро
Dialogue: 0,0:13:22.55,0:13:23.59,Default,,0,0,0,,N?
Dialogue: 0,0:13:24.17,0:13:27.68,Default,,0,0,0,,Мен оны теледидардан көрдім. Бұл керемет, Руикун.
Dialogue: 0,0:13:27.80,0:13:30.30,Default,,0,0,0,,Шин де тамаша өнер көрсетеді.
Dialogue: 0,0:13:30.60,0:13:31.97,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:13:32.10,0:13:33.43,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:13:33.56,0:13:36.44,Default,,0,0,0,,Бірақ мен Руикунға мүлдем тең келер емеспін.
Dialogue: 0,0:13:36.56,0:13:37.52,Default,,0,0,0,,Уау
Dialogue: 0,0:13:37.94,0:13:38.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:39.81,0:13:42.44,Default,,0,0,0,,Ұзақ уақыт бойы қайтармағаным үшін кешіріңіз.
Dialogue: 0,0:13:43.48,0:13:45.07,Default,,0,0,0,,Ішінде не бар екенін көрдің бе?
Dialogue: 0,0:13:45.19,0:13:46.40,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:13:46.78,0:13:47.91,Default,,0,0,0,,Қарап шығуға болады.
Dialogue: 0,0:13:48.03,0:13:49.24,Default,,0,0,0,,А... жарайды.
Dialogue: 0,0:13:49.37,0:13:50.74,Default,,0,0,0,,Мен оны көргім келеді.
Dialogue: 0,0:13:50.87,0:13:53.12,Default,,0,0,0,,Иә? Иә...
Dialogue: 0,0:13:56.21,0:13:57.54,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:58.62,0:13:59.46,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:13:59.58,0:14:00.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:00.54,0:14:02.04,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:14:02.17,0:14:03.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:03.13,0:14:06.55,Default,,0,0,0,,Эй, қазір менімен призма шоуын жасағың келе ме?
Dialogue: 0,0:14:06.67,0:14:07.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:08.59,0:14:11.47,Default,,0,0,0,,Шварц Роузға баратыныңыз рас па?
Dialogue: 0,0:14:12.47,0:14:16.18,Default,,0,0,0,,Соны сұрау үшін осынша жолмен келдің бе?
Dialogue: 0,0:14:16.31,0:14:17.18,Default,,0,0,0,,А...
Dialogue: 0,0:14:18.94,0:14:22.23,Default,,0,0,0,,Хиро, неге біз мұны біраз уақыттан кейін бірінші рет жасамасқа?
Dialogue: 0,0:14:22.36,0:14:23.23,Default,,0,0,0,,А...
Dialogue: 0,0:14:23.65,0:14:25.69,Default,,0,0,0,,Сондай-ақ... Әрине!
Dialogue: 0,0:14:26.11,0:14:29.45,Default,,0,0,0,,Не, сіз осындай жерде призма шоуын өткізесіз бе?
Dialogue: 0,0:14:29.57,0:14:30.61,Default,,0,0,0,,Иә
Dialogue: 0,0:14:31.20,0:14:32.03,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:36.79,0:14:38.33,Default,,0,0,0,,Уау...
Dialogue: 0,0:14:38.62,0:14:41.83,Default,,0,0,0,,Руи-кун, сен кімсің?
Dialogue: 0,0:14:42.33,0:14:43.84,Default,,0,0,0,,мені тістемек болғанда Розваал мені құтқарды…
Dialogue: 0,0:14:44.13,0:14:47.80,Default,,0,0,0,,Мен сіздермен 1000 жыл уақыт пен кеңістікте кездесуге келдім.
Dialogue: 0,0:14:48.17,0:14:49.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:49.30,0:14:51.93,Default,,0,0,0,,Ухуху... бұл әзіл.
Dialogue: 0,0:14:52.05,0:14:53.30,Default,,0,0,0,,А... енді би билейік
Dialogue: 0,0:14:53.43,0:14:54.76,Default,,0,0,0,,А... иә
Dialogue: 0,0:14:55.06,0:15:00.06,Default,,0,0,0,,♪「ЖЫНДЫҚ БОЛАДЫ」
Dialogue: 0,0:15:25.67,0:15:27.84,Default,,0,0,0,,Оны жең! (Көрермендер) Барыңыз!
Dialogue: 0,0:15:27.96,0:15:28.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:30.63,0:15:32.55,Default,,0,0,0,,Мен мұндай жердің болғанына сене алмаймын
Dialogue: 0,0:16:04.71,0:16:05.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:06.34,0:16:08.55,Default,,0,0,0,,Жұлдыздың шашырауы!
Dialogue: 0,0:16:09.46,0:16:10.76,Default,,0,0,0,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:16:10.88,0:16:12.01,Default,,0,0,0,,Хехе…
Dialogue: 0,0:16:13.01,0:16:15.84,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:16.85,0:16:19.60,Default,,0,0,0,,Асыл тасты айналдыру!
Dialogue: 0,0:16:19.72,0:16:20.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:21.06,0:16:22.10,Default,,0,0,0,,Гах...
Dialogue: 0,0:16:22.31,0:16:25.77,Default,,0,0,0,,Осында келсең жұбатармын деп ойладың ба?
Dialogue: 0,0:16:25.90,0:16:26.81,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:26.94,0:16:27.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:28.36,0:16:29.78,Default,,0,0,0,,Казуки-сенпай!
Dialogue: 0,0:16:37.20,0:16:38.16,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:38.28,0:16:39.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:40.04,0:16:42.08,Default,,0,0,0,,Фуфуфуфуфуфу…
Dialogue: 0,0:16:42.33,0:16:43.54,Default,,0,0,0,,Сіз...
Dialogue: 0,0:16:43.79,0:16:45.96,Default,,0,0,0,,Джин! (Джин) Хахаха...
Dialogue: 0,0:16:46.08,0:16:49.50,Default,,0,0,0,,100% таза таза жебе!
Dialogue: 0,0:16:49.80,0:16:51.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:51.76,0:16:53.80,Default,,0,0,0,,Уууу... Бақытты болыңыз!
Dialogue: 0,0:16:54.17,0:16:56.39,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:01.72,0:17:06.27,Default,,0,0,0,,Жану! Grand X Spin!
Dialogue: 0,0:17:07.02,0:17:08.11,Default,,0,0,0,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,0:17:08.27,0:17:10.19,Default,,0,0,0,,Уф... уау!
Dialogue: 0,0:17:10.32,0:17:12.15,Default,,0,0,0,,♬~
Dialogue: 0,0:17:12.28,0:17:14.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:14.28,0:17:16.91,Default,,0,0,0,,Махаббаттың дірілдеген гүлдері!
Dialogue: 0,0:17:19.24,0:17:21.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:21.87,0:17:26.87,Default,,0,0,0,,～♪
Dialogue: 0,0:17:27.08,0:17:28.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:28.58,0:17:31.46,Default,,0,0,0,,Руи-кун, бұл не?
Dialogue: 0,0:17:32.17,0:17:33.59,Default,,0,0,0,,Жарыс әлі аяқталған жоқ, білесің бе!
Dialogue: 0,0:17:33.84,0:17:36.93,Default,,0,0,0,,Сіз бұл дүниені құртып жібере жаздаған шайтансыз.
Dialogue: 0,0:17:37.34,0:17:38.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:39.26,0:17:40.51,Default,,0,0,0,,Не үшін келдің?
Dialogue: 0,0:17:40.76,0:17:44.02,Default,,0,0,0,,Маусым Хижириді тастап, маған кел.
Dialogue: 0,0:17:44.27,0:17:46.98,Default,,0,0,0,,Джин кет мына жерден!
Dialogue: 0,0:17:47.10,0:17:49.81,Default,,0,0,0,,Менде бәрі бар
Dialogue: 0,0:17:50.19,0:17:53.40,Default,,0,0,0,,Ондағы адамның енді ештеңесі жоқ!
Dialogue: 0,0:17:56.70,0:17:59.11,Default,,0,0,0,,Мен сенімен бір рет болса да кездескім келді.
Dialogue: 0,0:18:00.24,0:18:02.70,Default,,0,0,0,,Мен сіздің призма шоуыңызды қайта көргім келді.
Dialogue: 0,0:18:02.83,0:18:04.58,Default,,0,0,0,,А... а...
Dialogue: 0,0:18:06.46,0:18:07.75,Default,,0,0,0,,Руи-кун...
Dialogue: 0,0:18:08.12,0:18:10.25,Default,,0,0,0,,Уау! Гуаааа...
Dialogue: 0,0:18:10.42,0:18:13.71,Default,,0,0,0,,Хиро тұр!
Dialogue: 0,0:18:14.00,0:18:15.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:15.96,0:18:18.63,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:18:19.09,0:18:20.05,Default,,0,0,0,,Генет
Dialogue: 0,0:18:21.10,0:18:22.10,Default,,0,0,0,,маусым!
Dialogue: 0,0:18:22.22,0:18:24.56,Default,,0,0,0,,О... ой...!
Dialogue: 0,0:18:24.81,0:18:26.98,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:18:28.35,0:18:31.44,Default,,0,0,0,,Хахаха... Аххахаха...!
Dialogue: 0,0:18:31.56,0:18:33.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:33.65,0:18:35.44,Default,,0,0,0,,Хэхехе хахахаха
Dialogue: 0,0:18:35.57,0:18:39.61,Default,,0,0,0,,Көрдің бе, әулие Генет мені таңдады?
Dialogue: 0,0:18:39.74,0:18:40.91,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:18:41.20,0:18:43.20,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:18:43.33,0:18:44.45,Default,,0,0,0,,маусым...
Dialogue: 0,0:18:45.08,0:18:47.58,Default,,0,0,0,,маусым~!
Dialogue: 0,0:18:50.54,0:18:51.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:54.29,0:18:55.59,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:19:03.64,0:19:04.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:06.56,0:19:07.85,Default,,0,0,0,,Руи-кун...?
Dialogue: 0,0:19:08.18,0:19:09.85,Default,,0,0,0,,Мен сені сүйемін, а...
Dialogue: 0,0:19:10.27,0:19:13.15,Default,,0,0,0,,Сыбырлаған Лунамистік аспан
Dialogue: 0,0:19:13.27,0:19:15.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:28.62,0:19:31.71,Default,,0,0,0,,Сіз осындай бос сөзбен патша бола аласыз деп ойлайсыз ба!
Dialogue: 0,0:19:32.25,0:19:35.13,Default,,0,0,0,,Сіз мұздағы ханзадасыз
Dialogue: 0,0:19:35.25,0:19:37.21,Default,,0,0,0,,Сіз ешқашан патша болмайсыз!
Dialogue: 0,0:19:38.17,0:19:39.21,Default,,0,0,0,,Кожи…
Dialogue: 0,0:19:39.97,0:19:42.76,Default,,0,0,0,,Үйге қайт, енді сенің жүзіңді көргім келмейді.
Dialogue: 0,0:19:42.93,0:19:43.97,Default,,0,0,0,,Кожи…
Dialogue: 0,0:19:45.72,0:19:46.76,Default,,0,0,0,,Коджи!
Dialogue: 0,0:19:47.81,0:19:49.56,Default,,0,0,0,,Коджи~!
Dialogue: 0,0:19:52.60,0:19:57.11,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:20:00.07,0:20:03.16,Default,,0,0,0,,Мен қолдарымның соншалықты әлсірегенін күтпедім.
Dialogue: 0,0:20:03.36,0:20:04.91,Default,,0,0,0,,Уау...
Dialogue: 0,0:20:06.12,0:20:08.08,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:20:08.41,0:20:10.50,Default,,0,0,0,,Бұл... бұл жер...
Dialogue: 0,0:20:12.33,0:20:15.00,Default,,0,0,0,,А... Бұл түс пе?
Dialogue: 0,0:20:20.96,0:20:23.01,Default,,0,0,0,,Тайга Кюн Такси бағасы әлі?
Dialogue: 0,0:20:23.13,0:20:24.47,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:20:24.84,0:20:26.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:26.93,0:20:29.14,Default,,0,0,0,,Жұлдыздың шашырауы!
Dialogue: 0,0:20:29.56,0:20:30.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:30.97,0:20:32.56,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:20:32.77,0:20:34.56,Default,,0,0,0,,Не болды? Шин
Dialogue: 0,0:20:34.77,0:20:37.86,Default,,0,0,0,,Призмалық секіру... ұша алмайсыз ба?
Dialogue: 0,0:20:37.98,0:20:41.15,Default,,0,0,0,,Иә? Бұл... қиын!
Dialogue: 0,0:20:42.15,0:20:43.99,Default,,0,0,0,,Мынаны қара.
Dialogue: 0,0:20:44.28,0:20:45.20,Default,,0,0,0,,Не!
Dialogue: 0,0:20:45.74,0:20:48.74,Default,,0,0,0,,♪「Қайта жүктеу」
Dialogue: 0,0:21:01.67,0:21:02.51,Default,,0,0,0,,Уф... (Еркек) О!
Dialogue: 0,0:21:02.84,0:21:05.84,Default,,0,0,0,,<Теме, қайда көздеп тұрсың!? 〉
Dialogue: 0,0:21:07.09,0:21:08.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:33.54,0:21:35.96,Default,,0,0,0,,Мен Эдельроуздың жоғалып кететініне сене алмаймын...
Dialogue: 0,0:22:01.23,0:22:04.61,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:22:05.32,0:22:06.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:12.70,0:22:16.50,Default,,0,0,0,,Жоқ, жарысқа қатысу жақсы идея емес.
Dialogue: 0,0:22:16.91,0:22:20.08,Default,,0,0,0,,Канаваның жанындағы призма шоуынан аяғыңызды жуыңыз
Dialogue: 0,0:22:20.42,0:22:21.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:22.13,0:22:24.55,Default,,0,0,0,,♬~
Dialogue: 0,0:22:28.47,0:22:31.34,Default,,0,0,0,,Олай болса, біз топтамыз...
Dialogue: 0,0:22:31.47,0:22:34.06,Default,,0,0,0,,Қарасам, жалға берілген.
Dialogue: 0,0:22:34.06,0:22:34.60,Default,,0,0,0,,Түсіндім, жалға беремін.
Dialogue: 0,0:22:34.06,0:22:34.60,Default,,0,0,0,,～♪
Dialogue: 0,0:22:34.60,0:22:34.93,Default,,0,0,0,,～♪
Dialogue: 0,0:22:34.93,0:22:39.06,Default,,0,0,0,,～♪
Dialogue: 0,0:22:34.93,0:22:39.06,Default,,0,0,0,,Оның үстіне менің банкім қысымда...
Dialogue: 0,0:22:40.48,0:22:42.02,Default,,0,0,0,,Тұтынушыға байланысты...
Dialogue: 0,0:22:46.74,0:22:48.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:50.07,0:22:51.03,Default,,0,0,0,,Иә
Dialogue: 0,0:22:52.99,0:22:54.28,Default,,0,0,0,,Әулие
Dialogue: 0,0:22:55.91,0:22:58.21,Default,,0,0,0,,Кешіріңіз, төрағалық етуші Химуро.
Dialogue: 0,0:22:58.66,0:23:02.33,Default,,0,0,0,,Мен енді сахнада тұра алмаймын.
Dialogue: 0,0:23:02.92,0:23:06.00,Default,,0,0,0,,Призма патшасының кубогы басқа мүшелерге беріледі...
Dialogue: 0,0:23:07.17,0:23:11.72,Default,,0,0,0,,Джин...бұрын менің ағам өте жылтырақ болатын.
Dialogue: 0,0:23:13.43,0:23:15.31,Default,,0,0,0,,Хиро да есіңізде, солай ма?
Dialogue: 0,0:23:15.72,0:23:18.89,Default,,0,0,0,,Джин Призма патшасы болған кездегі шоу
Dialogue: 0,0:23:19.02,0:23:19.89,Default,,0,0,0,,Иә
Dialogue: 0,0:23:20.27,0:23:22.31,Default,,0,0,0,,Мен ағамды құрметтеймін
Dialogue: 0,0:23:22.44,0:23:25.23,Default,,0,0,0,,Бір күні ағамдай болғым келді.
Dialogue: 0,0:23:25.77,0:23:28.82,Default,,0,0,0,,Бірақ менің ағам өзгерді.
Dialogue: 0,0:23:29.40,0:23:31.78,Default,,0,0,0,,Мен ағам мені еске алсын деймін.
Dialogue: 0,0:23:31.91,0:23:34.53,Default,,0,0,0,,Призманың сол кездегі жарқырауы
Dialogue: 0,0:23:36.95,0:23:37.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:38.29,0:23:41.12,Default,,0,0,0,,Мен енді призма шоуын жасай алмаймын.
Dialogue: 0,0:23:41.33,0:23:44.71,Default,,0,0,0,,Бірақ сіз әлі де жасай аласыз
Dialogue: 0,0:23:45.00,0:23:47.38,Default,,0,0,0,,Мен Джиннің оянғанын қалаймын.
Dialogue: 0,0:23:49.71,0:23:50.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:52.01,0:23:54.26,Default,,0,0,0,,Келіңіздер, Призма патшасының кубогы-
Dialogue: 0,0:23:54.39,0:23:58.01,Default,,0,0,0,,Егер мен Эдельроузымнан жеңімпаз шығара алмасам...
Dialogue: 0,0:23:58.14,0:24:00.27,Default,,0,0,0,,Наурыздың аяғында таратылды
Dialogue: 0,0:24:00.89,0:24:03.31,Default,,0,0,0,,Бірақ қалғандары үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:24:03.44,0:24:06.44,Default,,0,0,0,,Мен сіздің мансап жолыңыз үшін жауапкершілікті аламын.
Dialogue: 0,0:24:06.86,0:24:08.23,Default,,0,0,0,,Енді...
Dialogue: 0,0:24:08.36,0:24:12.03,Default,,0,0,0,,Призма патшасы кубогының 3 қатысушыларын жариялау
Dialogue: 0,0:24:12.20,0:24:13.70,Default,,0,0,0,,Бірінші, Хиро Хаями!
Dialogue: 0,0:24:14.74,0:24:15.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:18.16,0:24:19.33,Default,,0,0,0,,Екінші тұлға –
Dialogue: 0,0:24:19.87,0:24:21.25,Default,,0,0,0,,Когами Тайга!
Dialogue: 0,0:24:21.37,0:24:23.54,Default,,0,0,0,,Не? Иә!
Dialogue: 0,0:24:23.67,0:24:27.17,Default,,0,0,0,,Тайга таңдауы өткен жылдың соңында жүргізілді.
Dialogue: 0,0:24:27.29,0:24:29.88,Default,,0,0,0,,Рождестволық тікелей эфирде жанкүйерлердің дауыс беру нәтижелеріне қосымша
Dialogue: 0,0:24:30.01,0:24:31.55,Default,,0,0,0,,Сондай-ақ Кадзуки ұсынған
Dialogue: 0,0:24:32.01,0:24:33.26,Default,,0,0,0,,Кадзуки-сан!?
Dialogue: 0,0:24:33.72,0:24:35.01,Default,,0,0,0,,Үшінші тұлға...
Dialogue: 0,0:24:37.26,0:24:39.22,Default,,0,0,0,,Тачибана Юкиноджо! (Барлығы) Ах...
Dialogue: 0,0:24:39.35,0:24:40.18,Default,,0,0,0,,3 адамнан көп...
Dialogue: 0,0:24:40.72,0:24:41.56,Default,,0,0,0,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:24:41.77,0:24:42.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:43.19,0:24:47.52,Default,,0,0,0,,Мен қатысудан бас тартамын және Шин Ичиджоның қатысуын қалаймын.
Dialogue: 0,0:24:47.65,0:24:48.57,Default,,0,0,0,,Не!
Dialogue: 0,0:24:48.77,0:24:51.03,Default,,0,0,0,,Алайда Шин призма секірді...
Dialogue: 0,0:24:51.28,0:24:53.57,Default,,0,0,0,,Бұл барлық мүшелердің тілегі
Dialogue: 0,0:24:53.70,0:24:54.57,Default,,0,0,0,,А...
Dialogue: 0,0:24:57.95,0:24:59.24,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:24:59.62,0:25:01.20,Default,,0,0,0,,Бір мақалаға рахмет
Dialogue: 0,0:25:01.33,0:25:04.54,Default,,0,0,0,,Өйткені біз бөлек болдық, бірақ бір болдық.
Dialogue: 0,0:25:05.17,0:25:08.25,Default,,0,0,0,,Жарайды, Шин міндетті түрде жасай алады.
Dialogue: 0,0:25:08.59,0:25:09.42,Default,,0,0,0,,О
Dialogue: 0,0:25:09.54,0:25:11.96,Default,,0,0,0,,Мен оны сұрадым, Шинчуван!
Dialogue: 0,0:25:12.63,0:25:14.05,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:25:14.59,0:25:17.09,Default,,0,0,0,,Мен Хироды басқа жолы жеңуге тырысамын.
Dialogue: 0,0:25:17.22,0:25:19.10,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:25:19.89,0:25:23.10,Default,,0,0,0,,Бұл еш өкінбейтін шешім!
Dialogue: 0,0:25:25.64,0:25:26.65,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:25:26.98,0:25:28.77,Default,,0,0,0,,Үшінші адам - ​​Шин Ичижо!
Dialogue: 0,0:25:30.36,0:25:31.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:25:31.32,0:25:34.90,Default,,0,0,0,,Жақсы! Қалған мүшелер, сақтық көшірме жасау үшін бар күшіңізді салыңыз.
Dialogue: 0,0:25:35.03,0:25:35.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:25:44.66,0:25:45.91,Default,,0,0,0,,Хиро? Ах
Dialogue: 0,0:25:47.42,0:25:48.58,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,0:25:50.00,0:25:53.84,Default,,0,0,0,,Қалайсың? Сіз дұрыс тамақтанып жатырсыз ба?
Dialogue: 0,0:25:53.96,0:25:54.80,Default,,0,0,0,,Иә
Dialogue: 0,0:25:55.80,0:25:59.22,Default,,0,0,0,,Prism Show Сіз шығуды жоспарлап отырсыз ба?
Dialogue: 0,0:25:59.34,0:26:00.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:01.81,0:26:03.39,Default,,0,0,0,,Кешіріңіз Хиро
Dialogue: 0,0:26:04.10,0:26:07.73,Default,,0,0,0,,Қорқынышты анамның кесірінен мен оны жаман сезіндім.
Dialogue: 0,0:26:08.69,0:26:11.69,Default,,0,0,0,,Анам қателескен жоқ.
Dialogue: 0,0:26:11.98,0:26:13.78,Default,,0,0,0,,Хиро... аа...
Dialogue: 0,0:26:14.28,0:26:15.90,Default,,0,0,0,,Уф... Хиро!
Dialogue: 0,0:26:16.24,0:26:17.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:18.82,0:26:21.74,Default,,0,0,0,,Әкең әдепті адам.
Dialogue: 0,0:26:21.87,0:26:22.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:23.16,0:26:28.29,Default,,0,0,0,,Өйткені ол менің шын сүйетін адамым.
Dialogue: 0,0:26:29.83,0:26:31.17,Default,,0,0,0,,Жо-жоқ… мүмкін емес… осы сөмкенің ішінде не бар!
Dialogue: 0,0:26:32.21,0:26:34.71,Default,,0,0,0,,Мен бұл туралы қазір айта алмаймын.
Dialogue: 0,0:26:35.17,0:26:38.72,Default,,0,0,0,,Сөйлесетін кез келсе, міндетті түрде сөйлеймін.
Dialogue: 0,0:26:39.80,0:26:41.09,Default,,0,0,0,,Жо-жоқ… мүмкін емес… осы сөмкенің ішінде не бар!
Dialogue: 0,0:26:42.85,0:26:44.01,Default,,0,0,0,,Рахмет
Dialogue: 0,0:26:44.72,0:26:46.02,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:26:47.18,0:26:48.14,Default,,0,0,0,,Иә
Dialogue: 0,0:26:52.69,0:26:55.07,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:26:55.48,0:26:57.07,Default,,0,0,0,,Көңіл-күйлеріңіз көтеріңкі болсын!
Dialogue: 0,0:26:57.19,0:26:58.95,Default,,0,0,0,,Иә! Usu!
Dialogue: 0,0:26:59.99,0:27:00.82,Default,,0,0,0,,Әулие!
Dialogue: 0,0:27:00.95,0:27:02.03,Default,,0,0,0,,Ха... (Ямада) Әй?
Dialogue: 0,0:27:02.82,0:27:03.91,Default,,0,0,0,,Хиро!
Dialogue: 0,0:27:04.74,0:27:07.41,Default,,0,0,0,,Ах... (Барлығы) Хиро-сан!
Dialogue: 0,0:27:11.46,0:27:13.79,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:27:13.92,0:27:16.25,Default,,0,0,0,,Хиро! Немен айналысып жатырсың?
Dialogue: 0,0:27:16.38,0:27:18.26,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:27:18.38,0:27:19.63,Default,,0,0,0,,Не болды, Хиро?
Dialogue: 0,0:27:19.76,0:27:22.72,Default,,0,0,0,,Бұлай жарқырай алмайсың.
Dialogue: 0,0:27:22.84,0:27:26.18,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:27:27.02,0:27:30.10,Default,,0,0,0,,Тезірек, тезірек!
Dialogue: 0,0:27:30.23,0:27:32.35,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:27:32.48,0:27:33.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:33.98,0:27:36.36,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:27:36.48,0:27:38.11,Default,,0,0,0,,Ақымақ! Хе-хе-хе! ➡
Dialogue: 0,0:27:42.91,0:27:47.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:27:47.41,0:27:48.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:48.37,0:27:50.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:52.75,0:27:55.17,Default,,0,0,0,,Пухаха боқ...
Dialogue: 0,0:27:55.29,0:27:56.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:57.84,0:28:00.51,Default,,0,0,0,,Бұл ән бастапқыда Коджи жасаған дөрекі эскиз болды.
Dialogue: 0,0:28:00.63,0:28:02.84,Default,,0,0,0,,Оны әпкем екеуміз бітірдік.
Dialogue: 0,0:28:03.43,0:28:05.64,Default,,0,0,0,,Сіз Коудзидің әнінде болғыңыз келеді, солай ма?
Dialogue: 0,0:28:05.76,0:28:06.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:28:07.89,0:28:11.27,Default,,0,0,0,,Мен сені әлсіз күйіңде жеңсем де, Белл айналып кетпейді.
Dialogue: 0,0:28:11.52,0:28:12.60,Default,,0,0,0,,Ю…
Dialogue: 0,0:28:15.48,0:28:17.15,Default,,0,0,0,,(Минатоның гуілдеуі)
Dialogue: 0,0:28:17.27,0:28:19.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:21.57,0:28:22.65,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:28:22.78,0:28:25.16,Default,,0,0,0,,Уау! Арх...
Dialogue: 0,0:28:25.28,0:28:28.03,Default,,0,0,0,,Менің айтқанымды неге орындай алмайсың?
Dialogue: 0,0:28:28.16,0:28:31.54,Default,,0,0,0,,Сіз Призма патшасы бола аласыз деп ойлайсыз ба?
Dialogue: 0,0:28:31.66,0:28:33.50,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:28:34.29,0:28:36.46,Default,,0,0,0,,Руиден аздап үйрен!
Dialogue: 0,0:28:36.58,0:28:37.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:28:39.63,0:28:41.26,Default,,0,0,0,,Оны орындағанша қайта-қайта орындаңыз.
Dialogue: 0,0:28:41.38,0:28:43.47,Default,,0,0,0,,Қарғыс атсын... (Кокоро Мицуба) Уау!
Dialogue: 0,0:28:44.05,0:28:46.93,Default,,0,0,0,,Дұрыс~ Хозуки командирі
Dialogue: 0,0:28:47.05,0:28:49.39,Default,,0,0,0,,Джордж Сәттілік Джой!
Dialogue: 0,0:28:49.51,0:28:51.85,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:28:51.98,0:28:55.35,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:28:56.40,0:29:00.32,Default,,0,0,0,,Бұл өте пайдалы емес, бірақ пайдасыз.
Dialogue: 0,0:29:00.57,0:29:03.78,Default,,0,0,0,,Барлығы~ Кешкі ас дайын~
Dialogue: 0,0:29:04.11,0:29:05.74,Default,,0,0,0,,Иә
Dialogue: 0,0:29:06.28,0:29:08.32,Default,,0,0,0,,Бүгін түнде карри.
Dialogue: 0,0:29:08.99,0:29:11.62,Default,,0,0,0,,Мен қазір осындамын
Dialogue: 0,0:29:11.75,0:29:14.16,Default,,0,0,0,,Хмм, бұл дәмді!
Dialogue: 0,0:29:14.29,0:29:15.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:29:15.33,0:29:16.54,Default,,0,0,0,,Дәмді! Эй~
Dialogue: 0,0:29:16.67,0:29:17.83,Default,,0,0,0,,Уми!
Dialogue: 0,0:29:22.38,0:29:24.51,Default,,0,0,0,,Хиро, сенің де жегің келе ме?
Dialogue: 0,0:29:24.84,0:29:27.76,Default,,0,0,0,,Жоқ, мен... Ах.
Dialogue: 0,0:29:31.18,0:29:32.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:39.65,0:29:40.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:41.19,0:29:44.19,Default,,0,0,0,,Иә? Бұл карри әдеттегіден ерекшеленеді.
Dialogue: 0,0:29:44.32,0:29:45.82,Default,,0,0,0,,Бүгін сиыр еті ме?
Dialogue: 0,0:29:46.07,0:29:48.28,Default,,0,0,0,,Сіз дәмдеуіштер қоспасын да өзгерттіңіз бе?
Dialogue: 0,0:29:50.53,0:29:53.66,Default,,0,0,0,,Алма және бал…
Dialogue: 0,0:29:57.29,0:29:59.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:30:01.59,0:30:02.63,Default,,0,0,0,,(Хироның айқайы)
Dialogue: 0,0:30:08.89,0:30:09.89,Default,,0,0,0,,Пуха!
Dialogue: 0,0:30:15.56,0:30:17.14,Default,,0,0,0,,Хаха...
Dialogue: 0,0:30:17.69,0:30:18.90,Default,,0,0,0,,Тезірек!
Dialogue: 0,0:30:19.44,0:30:21.82,Default,,0,0,0,,жылдамырақ
Dialogue: 0,0:30:21.94,0:30:23.82,Default,,0,0,0,,Сіз мұны істей аласыз. Сіз мүлдем аласыз!
Dialogue: 0,0:30:23.94,0:30:25.99,Default,,0,0,0,,♬~
Dialogue: 0,0:30:26.11,0:30:26.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:27.03,0:30:28.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:30.49,0:30:31.74,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:30:34.95,0:30:35.91,Default,,0,0,0,,менің, Иида мен Тодорокидің есімдері жарияланбады—
Dialogue: 0,0:30:36.83,0:30:37.91,Default,,0,0,0,,Иә, Шин.
Dialogue: 0,0:30:38.33,0:30:39.87,Default,,0,0,0,,Икемді болыңыз!
Dialogue: 0,0:30:40.00,0:30:40.83,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:30:41.04,0:30:44.80,Default,,0,0,0,,Уф уф уф...
Dialogue: 0,0:30:44.96,0:30:46.76,Default,,0,0,0,,ғұн хун хун…
Dialogue: 0,0:30:47.13,0:30:48.30,Default,,0,0,0,,Жарайды
Dialogue: 0,0:30:55.93,0:30:58.77,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:30:58.89,0:31:01.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:31:01.15,0:31:03.02,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:31:05.07,0:31:06.40,Default,,0,0,0,,♬~
Dialogue: 0,0:31:06.53,0:31:09.40,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:31:10.99,0:31:13.12,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:31:13.24,0:31:15.12,Default,,0,0,0,,♬~
Dialogue: 0,0:31:18.16,0:31:19.75,Default,,0,0,0,,КЕРЕМЕТ!
Dialogue: 0,0:31:19.87,0:31:23.25,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:31:23.96,0:31:24.88,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:31:25.04,0:31:26.84,Default,,0,0,0,,Жарқырау! (Әулие) Иә!
Dialogue: 0,0:31:26.96,0:31:28.05,Default,,0,0,0,,Ханым…
Dialogue: 0,0:31:28.17,0:31:29.84,Default,,0,0,0,,Ұшқын!
Dialogue: 0,0:31:32.93,0:31:34.64,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:31:34.76,0:31:38.60,Default,,0,0,0,,Жүрегің басқарса...
Dialogue: 0,0:31:38.73,0:31:40.56,Default,,0,0,0,,Сіз патшасыз
Dialogue: 0,0:31:40.85,0:31:44.81,Default,,0,0,0,,Денең басқарса, құлсың.
Dialogue: 0,0:31:45.65,0:31:48.57,Default,,0,0,0,,Патшалықты мықтылар иеленсін
Dialogue: 0,0:31:48.69,0:31:52.28,Default,,0,0,0,,Призма патшасы кубогының найзағай сеансы!
Dialogue: 0,0:31:52.41,0:31:53.87,Default,,0,0,0,,Ақырында бұл ашылу!
Dialogue: 0,0:32:00.71,0:32:04.50,Default,,0,0,0,,Schwartz SS Мен бар күшімді саламын!
Dialogue: 0,0:32:04.83,0:32:08.42,Default,,0,0,0,,Енді Prism Show қауымдастығының төрағасы Танакадан.
Dialogue: 0,0:32:08.55,0:32:10.21,Default,,0,0,0,,Ашылу туралы мәлімдеме беріледі.
Dialogue: 0,0:32:13.05,0:32:14.18,Default,,0,0,0,,Бұл Танака!
Dialogue: 0,0:32:14.30,0:32:17.64,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:32:17.76,0:32:18.81,Default,,0,0,0,,♪「ＬＯＶＥ♥ＭＩＸ」
Dialogue: 0,0:32:18.81,0:32:20.14,Default,,0,0,0,,♪「ＬＯＶＥ♥ＭＩＸ」
Dialogue: 0,0:32:18.81,0:32:20.14,Default,,0,0,0,,Үстіңгі қамыр
Dialogue: 0,0:32:20.14,0:32:20.48,Default,,0,0,0,,♪「ＬＯＶＥ♥ＭＩＸ」
Dialogue: 0,0:32:20.48,0:32:22.35,Default,,0,0,0,,♪「ＬＯＶＥ♥ＭＩＸ」
Dialogue: 0,0:32:20.48,0:32:22.35,Default,,0,0,0,,Schwarzrose тиесілігі -
Dialogue: 0,0:32:22.35,0:32:22.77,Default,,0,0,0,,♪「ＬＯＶＥ♥ＭＩＸ」
Dialogue: 0,0:32:22.94,0:32:26.27,Default,,0,0,0,,Джордж Такадаобабаны таныстыру!
Dialogue: 0,0:32:37.58,0:32:39.45,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:32:39.58,0:32:41.62,Default,,0,0,0,,Такадаобаба~!
Dialogue: 0,0:32:41.75,0:32:44.12,Default,,0,0,0,,Джордж~!
Dialogue: 0,0:32:45.50,0:32:46.46,Default,,0,0,0,,Бұл не!?
Dialogue: 0,0:32:46.92,0:32:48.96,Default,,0,0,0,,Керемет қолдау!
Dialogue: 0,0:32:49.09,0:32:50.88,Default,,0,0,0,,Бұл ерекше сан.
Dialogue: 0,0:32:51.01,0:32:53.26,Default,,0,0,0,,Ача~! иә?
Dialogue: 0,0:32:53.38,0:32:56.64,Default,,0,0,0,,Бұл біздің серіктестеріміздің бірі емес пе?
Dialogue: 0,0:32:56.76,0:32:57.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:57.68,0:32:59.22,Default,,0,0,0,,Шварц жігіттері -
Dialogue: 0,0:32:59.35,0:33:03.10,Default,,0,0,0,,Менің ойымша, сіз аудиторияның көпшілігін сатып алу арқылы жеңе аласыз деп ойлайсыз...
Dialogue: 0,0:33:03.23,0:33:05.35,Default,,0,0,0,,Міне, осы сайысқа төрелік ету әдісі.
Dialogue: 0,0:33:05.48,0:33:06.40,Default,,0,0,0,,Түсіндіріңіз
Dialogue: 0,0:33:07.36,0:33:10.61,Default,,0,0,0,,Бұл жолы бес төрешінің қатаң ұпайларымен қатар,
Dialogue: 0,0:33:11.11,0:33:12.94,Default,,0,0,0,,Барлық көрермендер жабдықталған
Dialogue: 0,0:33:13.07,0:33:16.20,Default,,0,0,0,,Соңғы технологияны толық пайдалана отырып, Juoin Group әзірлеген.
Dialogue: 0,0:33:16.32,0:33:18.12,Default,,0,0,0,,Призмалық сағатты пайдаланып пайымдау да ұпай қосады.
Dialogue: 0,0:33:18.91,0:33:21.58,Default,,0,0,0,,Барлығы 20 000 карат даулы.
Dialogue: 0,0:33:21.74,0:33:25.12,Default,,0,0,0,,Уау! Біздің сату командамыз тамаша
Dialogue: 0,0:33:25.50,0:33:27.79,Default,,0,0,0,,Аудиториядағылардың барлығы – төреші.
Dialogue: 0,0:33:27.92,0:33:30.00,Default,,0,0,0,,Бұл Шварц үшін артықшылық емес пе?
Dialogue: 0,0:33:30.17,0:33:32.09,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ, солай ма?
Dialogue: 0,0:33:32.21,0:33:32.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:33.09,0:33:34.80,Default,,0,0,0,,Призма сағатының шешімі
Dialogue: 0,0:33:34.92,0:33:37.93,Default,,0,0,0,,Өйткені маған үстірт эмоциялар әсер етпейді.
Dialogue: 0,0:33:38.34,0:33:39.55,Default,,0,0,0,,3 қатарынан!
Dialogue: 0,0:33:39.97,0:33:45.06,Default,,0,0,0,,Ләззат! Таусылмас махаббат душы!
Dialogue: 0,0:33:45.18,0:33:48.10,Default,,0,0,0,,Маған душ беріңіз~! (Шварц SS) Бұл ақылсыз!
Dialogue: 0,0:33:48.44,0:33:51.90,Default,,0,0,0,,Енді Джордж Такадаобабаның ұпайы...
Dialogue: 0,0:33:52.73,0:33:53.61,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:33:53.74,0:33:55.86,Default,,0,0,0,,14,450 карат!
Dialogue: 0,0:33:56.07,0:33:57.78,Default,,0,0,0,,Керемет ұпай! (Джордж) Рахмет~
Dialogue: 0,0:33:56.07,0:33:57.78,Default,,0,0,0,,～♪
Dialogue: 0,0:33:57.78,0:33:57.91,Default,,0,0,0,,～♪
Dialogue: 0,0:33:57.91,0:33:59.57,Default,,0,0,0,,～♪
Dialogue: 0,0:33:57.91,0:33:59.57,Default,,0,0,0,,Барлығына рахмет... Ахаха...
Dialogue: 0,0:33:59.57,0:34:00.12,Default,,0,0,0,,Барлығына рахмет~ Ахахха...
Dialogue: 0,0:34:00.24,0:34:02.33,Default,,0,0,0,,Бұл шынымен де тамаша шоу болды ма?
Dialogue: 0,0:34:02.95,0:34:06.04,Default,,0,0,0,,Төрешілердің ұпайлары әдеттен тыс жоғары.
Dialogue: 0,0:34:06.33,0:34:10.00,Default,,0,0,0,,Мүмкін оны Шварцроуз сатып алған шығар.
Dialogue: 0,0:34:10.79,0:34:13.00,Default,,0,0,0,,Мен сенің риза болғаныңды қалаймын.
Dialogue: 0,0:34:13.34,0:34:15.42,Default,,0,0,0,,Менің Жуоинімнің күші
Dialogue: 0,0:34:15.55,0:34:18.13,Default,,0,0,0,,Егер мен ілгекті ұстай алсам
Dialogue: 0,0:34:18.26,0:34:20.55,Default,,0,0,0,,Келесі - ЕҢ ҮЗДІКТЕРДЕН АРТЫ.
Dialogue: 0,0:34:20.68,0:34:22.51,Default,,0,0,0,,Юто Казаманы таныстыру!
Dialogue: 0,0:34:22.64,0:34:23.56,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:34:23.68,0:34:25.48,Default,,0,0,0,,Бұл Танака.
Dialogue: 0,0:34:25.60,0:34:27.39,Default,,0,0,0,,Перри және Люксманмен байланысты -
Dialogue: 0,0:34:27.52,0:34:29.77,Default,,0,0,0,,Гашин Огамидің ұпайы...
Dialogue: 0,0:34:30.15,0:34:34.32,Default,,0,0,0,,8870 карат Балл көтерілмеді
Dialogue: 0,0:34:35.94,0:34:38.53,Default,,0,0,0,,Келесі орында Шварцроз.
Dialogue: 0,0:34:38.65,0:34:41.82,Default,,0,0,0,,Александр Яматомен таныстыру!
Dialogue: 0,0:34:41.95,0:34:42.83,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:34:42.95,0:34:45.83,Default,,0,0,0,,Алек~ Сенің бұлшық еттеріңді тигізуге рұқсат ет!
Dialogue: 0,0:34:45.95,0:34:47.79,Default,,0,0,0,,Шулы!
Dialogue: 0,0:34:47.91,0:34:49.29,Default,,0,0,0,,Эй!
Dialogue: 0,0:34:49.92,0:34:51.50,Default,,0,0,0,,Казуки Нишина!
Dialogue: 0,0:34:54.96,0:34:58.38,Default,,0,0,0,,Мен сізге бірінші нөмірлі екенімді көрсетемін!
Dialogue: 0,0:34:59.97,0:35:00.93,Default,,0,0,0,,Тайга
Dialogue: 0,0:35:01.59,0:35:04.39,Default,,0,0,0,,Go to…
Dialogue: 0,0:35:05.01,0:35:07.89,Default,,0,0,0,,тозақ!
Dialogue: 0,0:35:08.35,0:35:11.69,Default,,0,0,0,,♪「EZ DO DANCE」
Dialogue: 0,0:35:11.81,0:35:13.69,Default,,0,0,0,,Ақымақ адамдарға хабар
Dialogue: 0,0:35:13.82,0:35:16.19,Default,,0,0,0,,Жұмсақ призма көрсетілімі аяқталды
Dialogue: 0,0:35:16.57,0:35:18.07,Default,,0,0,0,,Бұдан былай мен-
Dialogue: 0,0:35:18.19,0:35:20.86,Default,,0,0,0,,Осы шіріген призма шоу әлемін тазартыңыз.
Dialogue: 0,0:35:21.11,0:35:24.62,Default,,0,0,0,,Осы арқылы біз басқарамыз деп қаулы етеміз.
Dialogue: 0,0:36:05.16,0:36:08.24,Default,,0,0,0,,Ол нені жоспарлап отыр?
Dialogue: 0,0:36:08.37,0:36:09.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:09.33,0:36:11.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:36:11.33,0:36:14.83,Default,,0,0,0,,Ай!
Dialogue: 0,0:36:18.42,0:36:20.01,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз!?
Dialogue: 0,0:36:20.17,0:36:21.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:36:21.76,0:36:25.68,Default,,0,0,0,,Жазықсыз призма шоуларына қатаң тыйым салынады!
Dialogue: 0,0:36:26.39,0:36:31.06,Default,,0,0,0,,666 Аян!
Dialogue: 0,0:36:36.40,0:36:37.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:42.99,0:36:45.07,Default,,0,0,0,,Мен сені құлыма айналдырамын.
Dialogue: 0,0:36:45.62,0:36:51.79,Default,,0,0,0,,Қорқыныш! Анголмоис түрме рок!
Dialogue: 0,0:36:51.91,0:36:53.83,Default,,0,0,0,,Ай!
Dialogue: 0,0:36:54.46,0:36:56.92,Default,,0,0,0,,Бұл көшелердің күші
Dialogue: 0,0:36:57.42,0:37:00.17,Default,,0,0,0,,Казуки Нишина! Шығу
Dialogue: 0,0:37:00.30,0:37:03.34,Default,,0,0,0,,Мұндағы жігіттердің жағдайы не боларын білмеймін!
Dialogue: 0,0:37:03.59,0:37:04.93,Default,,0,0,0,,Бұлай жалғаса берсе қауіпті!
Dialogue: 0,0:37:05.05,0:37:06.97,Default,,0,0,0,,Няру! Тайга!
Dialogue: 0,0:37:07.39,0:37:10.85,Default,,0,0,0,,Ямато Александр! Мен сенің қарсыласыңмын!
Dialogue: 0,0:37:12.02,0:37:14.23,Default,,0,0,0,,Мен кек аламын!
Dialogue: 0,0:37:16.35,0:37:17.44,Default,,0,0,0,,Тайга-кун!?
Dialogue: 0,0:37:17.56,0:37:19.23,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:37:19.44,0:37:21.90,Default,,0,0,0,,Уау! Ха!
Dialogue: 0,0:37:22.28,0:37:24.49,Default,,0,0,0,,Жанып тұрған шашырау!
Dialogue: 0,0:37:26.24,0:37:27.24,Default,,0,0,0,,Тайганың қолы басым!
Dialogue: 0,0:37:28.12,0:37:29.24,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:37:29.41,0:37:30.70,Default,,0,0,0,,Әй!
Dialogue: 0,0:37:31.12,0:37:32.70,Default,,0,0,0,,Кел, досым!
Dialogue: 0,0:37:32.83,0:37:35.87,Default,,0,0,0,,Тенжо Тенка Юига Доксон!
Dialogue: 0,0:37:39.34,0:37:42.88,Default,,0,0,0,,Әй, сен не ойлап тұрсың?!
Dialogue: 0,0:37:43.63,0:37:45.01,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:37:45.72,0:37:47.72,Default,,0,0,0,,Нуа~!
Dialogue: 0,0:37:47.84,0:37:51.81,Default,,0,0,0,,Болат 6 Пак-Core Керемет!
Dialogue: 0,0:37:51.93,0:37:53.60,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:37:53.81,0:37:57.23,Default,,0,0,0,,Ағаш қылыштай тәтті!
Dialogue: 0,0:37:57.81,0:37:59.15,Default,,0,0,0,,Иә! Не...
Dialogue: 0,0:38:01.27,0:38:02.32,Default,,0,0,0,,Хмф!
Dialogue: 0,0:38:03.15,0:38:04.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:04.78,0:38:06.70,Default,,0,0,0,,А... Жоқ!
Dialogue: 0,0:38:10.28,0:38:11.70,Default,,0,0,0,,Абай бол, ДжоДжо!
Dialogue: 0,0:38:13.79,0:38:15.96,Default,,0,0,0,,Керемет Тайга-кюн!
Dialogue: 0,0:38:16.46,0:38:17.37,Default,,0,0,0,,Ммм! Уау
Dialogue: 0,0:38:17.50,0:38:18.54,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:38:18.67,0:38:23.55,Default,,0,0,0,,Турнирді де жойыңыз!
Dialogue: 0,0:38:23.80,0:38:25.05,Default,,0,0,0,,Әй!
Dialogue: 0,0:38:25.30,0:38:27.30,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:38:27.43,0:38:28.97,Default,,0,0,0,,Өлім!
Dialogue: 0,0:38:29.51,0:38:33.22,Default,,0,0,0,,Жанкүйерлердің күшімен хаос нөлге оралады!
Dialogue: 0,0:38:34.81,0:38:38.73,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:38:40.27,0:38:41.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:42.02,0:38:43.73,Default,,0,0,0,,Арсыз!
Dialogue: 0,0:38:43.86,0:38:46.94,Default,,0,0,0,,Найзағай!
Dialogue: 0,0:38:47.07,0:38:52.87,Default,,0,0,0,,Құмарлыққа толы! Көтеріп бара жатқан жолбарыс дауылы!
Dialogue: 0,0:38:56.54,0:38:57.83,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:38:57.96,0:38:59.37,Default,,0,0,0,,♬~
Dialogue: 0,0:38:59.58,0:39:04.34,Default,,0,0,0,,Шектеуді бұзыңыз! Бякко жояды!
Dialogue: 0,0:39:04.46,0:39:08.22,Default,,0,0,0,,Мен сені мысықтай шайнаймын!
Dialogue: 0,0:39:08.38,0:39:13.39,Default,,0,0,0,,～♪
Dialogue: 0,0:39:13.72,0:39:19.85,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:39:21.98,0:39:24.90,Default,,0,0,0,,Каа~ Сурет салу~
Dialogue: 0,0:39:25.02,0:39:26.53,Default,,0,0,0,,Сонымен... иә?
Dialogue: 0,0:39:27.65,0:39:29.74,Default,,0,0,0,,Сахна тым-тырыс...
Dialogue: 0,0:39:30.07,0:39:32.74,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:39:32.87,0:39:35.99,Default,,0,0,0,,Хмф, бұл қандай ретсіз турнир.
Dialogue: 0,0:39:36.12,0:39:37.33,Default,,0,0,0,,Мұны істеудің мағынасы жоқ
Dialogue: 0,0:39:37.62,0:39:39.41,Default,,0,0,0,,Сен бейбақ! Хмм...
Dialogue: 0,0:39:39.54,0:39:40.71,Default,,0,0,0,,Осымен
Dialogue: 0,0:39:41.04,0:39:42.29,Default,,0,0,0,,Кадзуки мырза?
Dialogue: 0,0:39:42.83,0:39:44.75,Default,,0,0,0,,Емтихан нәтижелері жарияланады.
Dialogue: 0,0:39:45.13,0:39:49.59,Default,,0,0,0,,Ямато Александр вандализм үшін жарыстан шеттетілді.
Dialogue: 0,0:39:49.88,0:39:54.97,Default,,0,0,0,,Сонымен қатар, Яматоның шоуына кедергі келтірген Тайга Кагами де дисквалификацияланады.
Dialogue: 0,0:39:55.18,0:39:56.26,Default,,0,0,0,,Эх!
Dialogue: 0,0:39:56.39,0:39:58.81,Default,,0,0,0,,Тайга-кун мені тоқтатпақ болды!
Dialogue: 0,0:39:59.39,0:40:02.14,Default,,0,0,0,,Қазылар алқасы осы жерде хабарландыру жасайды.
Dialogue: 0,0:40:03.31,0:40:05.23,Default,,0,0,0,,Мен барлығыңызға түсіндіргім келеді.
Dialogue: 0,0:40:05.40,0:40:07.69,Default,,0,0,0,,Өткізілетін орынның қатты зақымдалуына байланысты -
Dialogue: 0,0:40:07.82,0:40:11.15,Default,,0,0,0,,Жарысты одан әрі жалғастыру мүмкін еместігі анықталды.
Dialogue: 0,0:40:11.57,0:40:13.11,Default,,0,0,0,,Алдыңғы конкурс нәтижелері бойынша-
Dialogue: 0,0:40:13.24,0:40:16.16,Default,,0,0,0,,Жеңімпазды анықтау туралы шешім қабылданды.
Dialogue: 0,0:40:16.28,0:40:17.99,Default,,0,0,0,,Сондықтан жеңімпаз –
Dialogue: 0,0:40:18.12,0:40:20.00,Default,,0,0,0,,Бұл Джордж Такадаобаба!
Dialogue: 0,0:40:20.25,0:40:22.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:40:22.62,0:40:25.42,Default,,0,0,0,,Міне! Әлі жартысы да біткен жоқ
Dialogue: 0,0:40:26.50,0:40:28.80,Default,,0,0,0,,Казуки-сенпай, кешіріңіз.
Dialogue: 0,0:40:29.71,0:40:32.55,Default,,0,0,0,,Мен турнирді шатастырдым.
Dialogue: 0,0:40:32.68,0:40:34.59,Default,,0,0,0,,Бұл дұрыс емес, Тайга.
Dialogue: 0,0:40:34.72,0:40:35.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:36.05,0:40:39.60,Default,,0,0,0,,Сіздің призма шоуыңыз өте еркін болды!
Dialogue: 0,0:40:41.02,0:40:42.27,Default,,0,0,0,,Казуки-сан...
Dialogue: 0,0:40:42.77,0:40:47.06,Default,,0,0,0,,Осымен Призма патшасы кубогы аяқталады.
Dialogue: 0,0:40:47.19,0:40:48.02,Default,,0,0,0,,(Танжиро) Тұр, тұр! Тоқта, Иносукэ~!
Dialogue: 0,0:40:48.15,0:40:48.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:50.94,0:40:54.53,Default,,0,0,0,,Мен осы сахнада шоу көрсетемін.
Dialogue: 0,0:40:54.70,0:40:56.12,Default,,0,0,0,,Олар көз ілеспес шақта кішірейіп, ауада жоғалып кетті.
Dialogue: 0,0:40:56.24,0:40:57.49,Default,,0,0,0,,Танака…
Dialogue: 0,0:40:58.08,0:40:59.12,Default,,0,0,0,,Мен онымен екеуміз ғана, бір рет болса да сөйлескенді қатты қалаймын. Хехе.
Dialogue: 0,0:41:00.04,0:41:01.45,Default,,0,0,0,,Бұл Танака.
Dialogue: 0,0:41:01.58,0:41:04.37,Default,,0,0,0,,Аха! Сізге көп рахмет
Dialogue: 0,0:41:05.67,0:41:06.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:06.63,0:41:08.38,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:41:08.50,0:41:10.50,Default,,0,0,0,,Мен мұндай жұмысты істемеймін.
Dialogue: 0,0:41:10.63,0:41:12.38,Default,,0,0,0,,Уф... Үмітсіздік
Dialogue: 0,0:41:12.67,0:41:13.67,Default,,0,0,0,,Мм...!
Dialogue: 0,0:41:14.43,0:41:16.47,Default,,0,0,0,,Турнир жалғасуда!
Dialogue: 0,0:41:16.68,0:41:19.05,Default,,0,0,0,,Келесі - Призмалық тастың мүшесі.
Dialogue: 0,0:41:19.18,0:41:21.31,Default,,0,0,0,,Казуки Нишинаны таныстыру!
Dialogue: 0,0:41:25.73,0:41:30.32,Default,,0,0,0,,♪「Бостандық」
Dialogue: 0,0:41:50.75,0:41:52.84,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:41:53.09,0:41:54.63,Default,,0,0,0,,Ах... (Ескендір) О...
Dialogue: 0,0:41:55.05,0:41:56.26,Default,,0,0,0,,Казуки...
Dialogue: 0,0:42:37.59,0:42:39.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:42:39.68,0:42:40.97,Default,,0,0,0,,Уау! (Александр) А?
Dialogue: 0,0:42:41.10,0:42:42.47,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:42:42.60,0:42:45.02,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:42:55.03,0:42:55.90,Default,,0,0,0,,Әй!
Dialogue: 0,0:42:56.82,0:42:59.03,Default,,0,0,0,,Бостандық шашырауы!
Dialogue: 0,0:42:59.49,0:43:01.91,Default,,0,0,0,,Ойыңызды босатыңыз!
Dialogue: 0,0:43:02.12,0:43:03.62,Default,,0,0,0,,Уа!
Dialogue: 0,0:43:03.87,0:43:05.12,Default,,0,0,0,,Қатарынан екі!
Dialogue: 0,0:43:05.95,0:43:08.58,Default,,0,0,0,,Әділдік жүрек ешқашан жеңілмейді!
Dialogue: 0,0:43:08.79,0:43:11.38,Default,,0,0,0,,Ха!
Dialogue: 0,0:43:11.50,0:43:12.67,Default,,0,0,0,,Аспанға күркіре!
Dialogue: 0,0:43:18.55,0:43:21.34,Default,,0,0,0,,Призмалық шоу өте көңілді және керемет!
Dialogue: 0,0:43:22.09,0:43:23.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:23.68,0:43:25.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:28.77,0:43:30.89,Default,,0,0,0,,Біздің шайқас ешқашан бітпейді!
Dialogue: 0,0:43:31.02,0:43:36.19,Default,,0,0,0,,Призма жұлдызы кейіпкерінің аңызы! Батылдар стадионы!
Dialogue: 0,0:43:36.82,0:43:38.69,Default,,0,0,0,,Жоқ... Ха!
Dialogue: 0,0:43:39.28,0:43:40.57,Default,,0,0,0,,3 қатарынан!
Dialogue: 0,0:43:41.61,0:43:43.70,Default,,0,0,0,,Халықтың призмасы!
Dialogue: 0,0:43:43.82,0:43:45.03,Default,,0,0,0,,халықпен!
Dialogue: 0,0:43:45.16,0:43:47.16,Default,,0,0,0,,халық үшін!
Dialogue: 0,0:43:48.37,0:43:52.92,Default,,0,0,0,,Жанкүйерлер, жанкүйерлер, жанкүйерлер үшін призмалық шоу!
Dialogue: 0,0:43:54.63,0:43:56.42,Default,,0,0,0,,Жану!
Dialogue: 0,0:43:57.34,0:44:00.22,Default,,0,0,0,,Prismshow-ды қайтадан керемет етіңіз!
Dialogue: 0,0:44:00.34,0:44:03.76,Default,,0,0,0,,Әрбір призмалық шоу - еркіндік!
Dialogue: 0,0:44:03.89,0:44:06.93,Default,,0,0,0,,Призмалық шоу жанкүйерлерін босату туралы декларация!
Dialogue: 0,0:44:07.06,0:44:10.48,Default,,0,0,0,,Бостандық Бостандық Бостандық!
Dialogue: 0,0:44:10.60,0:44:13.35,Default,,0,0,0,,Не! Кадзуки Нишина
Dialogue: 0,0:44:13.48,0:44:13.65,Default,,0,0,0,,Өтетін орны қайта салынды!
Dialogue: 0,0:44:13.65,0:44:17.19,Default,,0,0,0,,Өтетін орны қайта салынды!
Dialogue: 0,0:44:13.65,0:44:17.19,Default,,0,0,0,,～♪
Dialogue: 0,0:44:17.19,0:44:17.32,Default,,0,0,0,,～♪
Dialogue: 0,0:44:17.32,0:44:18.65,Default,,0,0,0,,～♪
Dialogue: 0,0:44:17.32,0:44:18.65,Default,,0,0,0,,КЕРЕМЕТ!
Dialogue: 0,0:44:19.44,0:44:22.24,Default,,0,0,0,,Сенгісіз…
Dialogue: 0,0:44:22.45,0:44:23.61,Default,,0,0,0,,Казуки-сан!
Dialogue: 0,0:44:23.74,0:44:25.87,Default,,0,0,0,,Енді сіздің ұпайыңыз қанша?
Dialogue: 0,0:44:26.95,0:44:30.37,Default,,0,0,0,,Дисквалификация! Бұл не...
Dialogue: 0,0:44:30.58,0:44:32.21,Default,,0,0,0,,Не!? Не!?
Dialogue: 0,0:44:32.37,0:44:35.92,Default,,0,0,0,,Е... Казуки Нишинаның дәл қазір орындауы...
Dialogue: 0,0:44:36.04,0:44:40.42,Default,,0,0,0,,Ережелерден айтарлықтай ауытқығаныңыз үшін сіз дисквалификацияланасыз...
Dialogue: 0,0:44:40.55,0:44:41.88,Default,,0,0,0,,Мен өмір бойы кек сақтаймын!
Dialogue: 0,0:44:42.01,0:44:43.43,Default,,0,0,0,,Араласпаңыз!
Dialogue: 0,0:44:44.05,0:44:47.93,Default,,0,0,0,,Көше түрі және т.б. Шынымен лас
Dialogue: 0,0:44:53.56,0:44:55.69,Default,,0,0,0,,Ах...хехе
Dialogue: 0,0:44:56.86,0:45:00.28,Default,,0,0,0,,Казуки-сан! Мен мұндай рейтингті қабылдай алмаймын.
Dialogue: 0,0:45:00.82,0:45:01.82,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:45:01.94,0:45:02.95,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:45:03.07,0:45:06.45,Default,,0,0,0,,Біздің көше шоуларымызды санмен жеткізу мүмкін емес!
Dialogue: 0,0:45:06.57,0:45:08.45,Default,,0,0,0,,А... (Ескендір) А...
Dialogue: 0,0:45:08.78,0:45:10.20,Default,,0,0,0,,Дұрыс па? Алек
Dialogue: 0,0:45:10.33,0:45:11.16,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:45:11.58,0:45:12.66,Default,,0,0,0,,Чи…
Dialogue: 0,0:45:13.71,0:45:16.29,Default,,0,0,0,,Турнирді бұдан былай жалғастыруға бола ма?
Dialogue: 0,0:45:16.42,0:45:18.63,Default,,0,0,0,,Біз өтетін орынды растаймыз.
Dialogue: 0,0:45:19.00,0:45:20.63,Default,,0,0,0,,Сәл күте тұрыңыз
Dialogue: 0,0:45:23.13,0:45:23.97,Default,,0,0,0,,Иә
Dialogue: 0,0:45:24.47,0:45:25.30,Default,,0,0,0,,Иә
Dialogue: 0,0:45:25.80,0:45:26.84,Default,,0,0,0,,Иә
Dialogue: 0,0:45:27.72,0:45:28.55,Default,,0,0,0,,Иә
Dialogue: 0,0:45:29.01,0:45:29.85,Default,,0,0,0,,Иә
Dialogue: 0,0:45:30.39,0:45:31.27,Default,,0,0,0,,Иә
Dialogue: 0,0:45:32.56,0:45:34.06,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:45:34.89,0:45:36.94,Default,,0,0,0,,Енді мұны істейік!
Dialogue: 0,0:45:37.27,0:45:40.27,Default,,0,0,0,,Не... аа! иә!
Dialogue: 0,0:45:40.44,0:45:43.44,Default,,0,0,0,,Олай болса, бәріміз кеттік!
Dialogue: 0,0:45:44.36,0:45:45.20,Default,,0,0,0,,Бір!
Dialogue: 0,0:45:45.32,0:45:46.91,Default,,0,0,0,,Екі! Үш!
Dialogue: 0,0:45:47.03,0:45:48.62,Default,,0,0,0,,Төрт! Бес!
Dialogue: 0,0:45:48.74,0:45:50.78,Default,,0,0,0,,Алты! Жеті!
Dialogue: 0,0:45:52.08,0:45:54.79,Default,,0,0,0,,Эдель Роуз! Музыка!
Dialogue: 0,0:45:54.91,0:45:57.33,Default,,0,0,0,,Ханым…
Dialogue: 0,0:45:57.62,0:45:59.38,Default,,0,0,0,,Ұшқын!
Dialogue: 0,0:45:59.50,0:46:01.67,Default,,0,0,0,,Біз өткізілетін орынның қауіпсіз екенін растадық.
Dialogue: 0,0:46:01.80,0:46:02.80,Default,,0,0,0,,Турнирді жалғастыру
Dialogue: 0,0:46:02.92,0:46:04.47,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:46:04.59,0:46:06.26,Default,,0,0,0,,Эдельроузға тиесілі -
Dialogue: 0,0:46:06.38,0:46:09.18,Default,,0,0,0,,Шин Ичиджомен таныстыру!
Dialogue: 0,0:46:12.18,0:46:14.73,Default,,0,0,0,,Шин Ичижо призмасының шоуы
Dialogue: 0,0:46:14.85,0:46:17.23,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:46:18.77,0:46:23.78,Default,,0,0,0,,♪「Күн сәулесінің үстінде!」
Dialogue: 0,0:47:00.56,0:47:04.78,Default,,0,0,0,,Қазір менің керемет достарым бар.
Dialogue: 0,0:47:05.15,0:47:08.28,Default,,0,0,0,,Мұның бәрі Prism Show арқасында.
Dialogue: 0,0:47:08.78,0:47:12.37,Default,,0,0,0,,Мен мүшелермен кездесе алдым, себебі призма көрсетілімі болды.
Dialogue: 0,0:47:13.24,0:47:16.75,Default,,0,0,0,,Мен бәрімен мәңгі байланыста болғым келеді!
Dialogue: 0,0:47:16.87,0:47:18.29,Default,,0,0,0,,Призмалық шоу!
Dialogue: 0,0:48:02.75,0:48:04.75,Default,,0,0,0,,Призманың шапшаңдығы!
Dialogue: 0,0:48:04.88,0:48:06.21,Default,,0,0,0,,Сен мені көруге келдің!
Dialogue: 0,0:48:06.34,0:48:08.55,Default,,0,0,0,,Шин-кун, осылай! (Көрермендер) Міне! Мен мұнда!
Dialogue: 0,0:48:08.67,0:48:09.80,Default,,0,0,0,,Ах~ Шин-кун!
Dialogue: 0,0:48:09.92,0:48:11.22,Default,,0,0,0,,Шин-кун, маған көбірек беріңізші!
Dialogue: 0,0:48:11.34,0:48:16.35,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:48:18.39,0:48:21.10,Default,,0,0,0,,Бұл призманың жарқырауы!
Dialogue: 0,0:48:22.89,0:48:23.73,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:48:24.27,0:48:25.56,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:48:27.48,0:48:28.36,Default,,0,0,0,,Ха!
Dialogue: 0,0:48:29.15,0:48:31.40,Default,,0,0,0,,Жарқыраған шашырау!
Dialogue: 0,0:48:31.78,0:48:32.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:48:32.74,0:48:33.91,Default,,0,0,0,,Мен секірдім!
Dialogue: 0,0:48:34.49,0:48:35.70,Default,,0,0,0,,Екі қатардан!
Dialogue: 0,0:48:36.20,0:48:40.83,Default,,0,0,0,,Шин Муген құшақтау!
Dialogue: 0,0:48:42.66,0:48:45.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:48:45.54,0:48:47.04,Default,,0,0,0,,3 қатарынан!
Dialogue: 0,0:48:53.38,0:48:54.30,Default,,0,0,0,,Хехехе
Dialogue: 0,0:48:54.43,0:48:56.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:48:57.43,0:49:00.56,Default,,0,0,0,,Кеңістік пен уақыттың 1000 жарық жылынан тыс!
Dialogue: 0,0:49:06.06,0:49:06.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:07.73,0:49:09.86,Default,,0,0,0,,Күн шуағы!
Dialogue: 0,0:49:15.07,0:49:18.16,Default,,0,0,0,,Мен тудым, хехе!
Dialogue: 0,0:49:20.04,0:49:23.46,Default,,0,0,0,,～♪
Dialogue: 0,0:49:23.46,0:49:25.04,Default,,0,0,0,,～♪
Dialogue: 0,0:49:23.46,0:49:25.04,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:49:25.04,0:49:27.25,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:49:27.38,0:49:30.25,Default,,0,0,0,,Кя~! Шинчуван!
Dialogue: 0,0:49:30.38,0:49:32.17,Default,,0,0,0,,Сәлем! Сен істедің Шин!
Dialogue: 0,0:49:32.30,0:49:34.01,Default,,0,0,0,,Шин! Құттықтаймыз!
Dialogue: 0,0:49:34.26,0:49:36.43,Default,,0,0,0,,Ал егер... Тесси? Сізге көп рахмет
Dialogue: 0,0:49:36.55,0:49:39.26,Default,,0,0,0,,Шин-кун, мен сені жақсы көремін!
Dialogue: 0,0:49:40.93,0:49:43.93,Default,,0,0,0,,Енді мен де сен сияқтымын.
Dialogue: 0,0:49:44.35,0:49:46.52,Default,,0,0,0,,Енді маңызды ұпай ...
Dialogue: 0,0:49:47.85,0:49:50.57,Default,,0,0,0,,I... 14 380 карат?
Dialogue: 0,0:49:51.11,0:49:53.94,Default,,0,0,0,,А... Мен қазір 2-орындамын.
Dialogue: 0,0:49:54.61,0:49:56.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:49:56.32,0:49:58.45,Default,,0,0,0,,Төрешінің ұпайы тым төмен!
Dialogue: 0,0:49:58.57,0:49:59.78,Default,,0,0,0,,Ақымақ болма! (Шварц С.С.) Не қарап тұрсың?!
Dialogue: 0,0:49:59.91,0:50:01.37,Default,,0,0,0,,Біртүрлі емес пе!? (Шварц С.С.) Не болып жатыр!?
Dialogue: 0,0:50:01.49,0:50:02.41,Default,,0,0,0,,Қап!
Dialogue: 0,0:50:02.54,0:50:04.91,Default,,0,0,0,,Мына жігіттер, жұмысқа кірісіңдер!
Dialogue: 0,0:50:06.96,0:50:10.38,Default,,0,0,0,,Е...
Dialogue: 0,0:50:10.92,0:50:14.42,Default,,0,0,0,,Келесі орында Шварцроза.
Dialogue: 0,0:50:14.55,0:50:16.80,Default,,0,0,0,,Руи Кисарагимен таныстыру!
Dialogue: 0,0:50:16.93,0:50:18.34,Default,,0,0,0,,Даңқты Шварц!
Dialogue: 0,0:50:18.47,0:50:21.39,Default,,0,0,0,,Даңқты Шварц! Даңқты Шварц!
Dialogue: 0,0:50:21.68,0:50:26.56,Default,,0,0,0,,Луи, маған әдемі биіңді көрсет.
Dialogue: 0,0:50:28.02,0:50:31.36,Default,,0,0,0,,Сізге призманың жарқырауын беріңіз!
Dialogue: 0,0:50:32.36,0:50:37.36,Default,,0,0,0,,♪ «Лунатикалық ТАҒДЫР»
Dialogue: 0,0:50:47.12,0:50:49.83,Default,,0,0,0,,Неліктен «мақтаныш» сөзін қолданбайсыз?
Dialogue: 0,0:50:50.13,0:50:50.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:52.15,0:51:53.15,Default,,0,0,0,,Әй!
Dialogue: 0,0:51:54.11,0:51:57.40,Default,,0,0,0,,Аврора көтеріледі!
Dialogue: 0,0:51:57.57,0:51:58.74,Default,,0,0,0,,Қатарынан екі!
Dialogue: 0,0:51:59.74,0:52:03.66,Default,,0,0,0,,Кемпірқосақ құйрығын қағып тұр!
Dialogue: 0,0:52:03.99,0:52:05.41,Default,,0,0,0,,3 қатарынан!
Dialogue: 0,0:52:06.28,0:52:07.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:10.29,0:52:13.96,Default,,0,0,0,,Мәңгілік шексіз құшақ!
Dialogue: 0,0:52:14.67,0:52:15.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:52:16.88,0:52:18.17,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:52:18.30,0:52:23.01,Default,,0,0,0,,Призма хабаршысы орталық сахнаға шықпауы керек.
Dialogue: 0,0:52:23.13,0:52:25.68,Default,,0,0,0,,Мен бұл әлемде барған сайын
Dialogue: 0,0:52:25.80,0:52:28.31,Default,,0,0,0,,Мен тек призманың жарқырауын таратқым келеді
Dialogue: 0,0:52:28.43,0:52:29.27,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:52:29.39,0:52:32.69,Default,,0,0,0,,Ринне, сен де менімен ынтымақтасасың ба?
Dialogue: 0,0:52:32.81,0:52:36.27,Default,,0,0,0,,Бірақ егер сіз бәріне ұнайтын болсаңыз...
Dialogue: 0,0:52:36.40,0:52:37.48,Default,,0,0,0,,Бұл дүние...
Dialogue: 0,0:52:37.61,0:52:40.99,Default,,0,0,0,,Хехе, саған да ұнайды, солай ма?
Dialogue: 0,0:52:41.44,0:52:42.82,Default,,0,0,0,,Мен туралы
Dialogue: 0,0:52:44.07,0:52:47.24,Default,,0,0,0,,Уф... мынау несі...
Dialogue: 0,0:52:47.37,0:52:52.25,Default,,0,0,0,,Кешіріңіз, мен де сенімен бірге өлемін.
Dialogue: 0,0:52:52.62,0:52:54.29,Default,,0,0,0,,Мен уәде беремін ...
Dialogue: 0,0:52:54.42,0:52:55.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:56.84,0:52:57.67,Default,,0,0,0,,Ха…
Dialogue: 0,0:52:57.92,0:52:59.42,Default,,0,0,0,,4 қатарынан!
Dialogue: 0,0:53:00.17,0:53:02.67,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:53:02.88,0:53:05.22,Default,,0,0,0,,Ах... Уф...
Dialogue: 0,0:53:05.34,0:53:07.43,Default,,0,0,0,,(Night Eye) Не істесең де, олар бізді сол жақта байқамай қалсын.
Dialogue: 0,0:53:07.55,0:53:11.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:14.64,0:53:15.56,Default,,0,0,0,,Тыйым салынған...
Dialogue: 0,0:53:18.11,0:53:19.82,Default,,0,0,0,,Тоқтату мүмкін емес...
Dialogue: 0,0:53:23.90,0:53:26.99,Default,,0,0,0,,Құлаған аспан!
Dialogue: 0,0:53:35.67,0:53:36.50,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:53:36.75,0:53:38.38,Default,,0,0,0,,4 қатарынан!
Dialogue: 0,0:53:38.50,0:53:39.84,Default,,0,0,0,,Руи Кисараги
Dialogue: 0,0:53:39.96,0:53:45.68,Default,,0,0,0,,Ол ерлер тарихында алғаш рет ресми жарыста қатарынан 4 рет секірді!
Dialogue: 0,0:53:47.97,0:53:48.80,Default,,0,0,0,,Ұпай –...
Dialogue: 0,0:53:49.60,0:53:50.01,Default,,0,0,0,,～♪
Dialogue: 0,0:53:50.01,0:53:51.39,Default,,0,0,0,,～♪ 20 000 карат!
Dialogue: 0,0:53:51.39,0:53:51.51,Default,,0,0,0,,～♪
Dialogue: 0,0:53:51.51,0:53:54.60,Default,,0,0,0,,~♪ Толық балл Мен тамаша балл алдым!
Dialogue: 0,0:53:55.02,0:53:57.60,Default,,0,0,0,,Призма патшасы расталды!
Dialogue: 0,0:53:58.98,0:54:00.23,Default,,0,0,0,,Руи-кун...
Dialogue: 0,0:54:00.77,0:54:04.03,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:54:04.32,0:54:07.70,Default,,0,0,0,,Сіз қалай ойлайсыз? Маусым, бұл менің күшім.
Dialogue: 0,0:54:07.82,0:54:08.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:09.66,0:54:11.33,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:54:11.45,0:54:12.58,Default,,0,0,0,,маусым?
Dialogue: 0,0:54:12.83,0:54:16.62,Default,,0,0,0,,Енді Хиро Хаями ғана қалды.
Dialogue: 0,0:54:17.29,0:54:20.29,Default,,0,0,0,,Олар қандай шоу көрсетеді?
Dialogue: 0,0:54:24.92,0:54:27.47,Default,,0,0,0,,Неліктен «мақтаныш» әнін айтпадың?
Dialogue: 0,0:54:29.55,0:54:30.97,Default,,0,0,0,,Мен мұны істей аламын.
Dialogue: 0,0:54:31.10,0:54:33.89,Default,,0,0,0,,Өйткені мен ең жақсы призма шоуын қойғым келді
Dialogue: 0,0:54:36.48,0:54:37.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:54:40.61,0:54:43.44,Default,,0,0,0,,Призма патшасы кубогының финалдық орындаушысы
Dialogue: 0,0:54:43.65,0:54:47.86,Default,,0,0,0,,Эдел Роуздан Хиро Хаямимен таныстыру!
Dialogue: 0,0:54:47.99,0:54:49.16,Default,,0,0,0,,Бас тарту!
Dialogue: 0,0:54:49.28,0:54:51.95,Default,,0,0,0,,Даңқты Шварц! Даңқты Шварц!
Dialogue: 0,0:54:52.08,0:54:55.16,Default,,0,0,0,,Даңқты Шварц! Даңқты Шварц!
Dialogue: 0,0:54:55.29,0:54:59.12,Default,,0,0,0,,Даңқты Шварц! Даңқты Шварц...!
Dialogue: 0,0:54:59.25,0:55:00.46,Default,,0,0,0,,Уау...
Dialogue: 0,0:55:00.58,0:55:02.71,Default,,0,0,0,,Барлығың тыныш болыңдар!
Dialogue: 0,0:55:02.84,0:55:04.84,Default,,0,0,0,,Соңына дейін тыңдаңыз!
Dialogue: 0,0:55:04.96,0:55:07.88,Default,,0,0,0,,Хиро-сан, барыңды сал!
Dialogue: 0,0:55:08.38,0:55:11.47,Default,,0,0,0,,Даңқты Шварц! Даңқты Шварц!
Dialogue: 0,0:55:11.59,0:55:13.89,Default,,0,0,0,,Даңқты Шварц! Даңқты…
Dialogue: 0,0:55:14.10,0:55:15.06,Default,,0,0,0,,Әй!
Dialogue: 0,0:55:15.47,0:55:18.39,Default,,0,0,0,,Даңқты Шварц… Даңқты Шварц…
Dialogue: 0,0:55:18.52,0:55:19.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:21.86,0:55:23.77,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:55:24.48,0:55:29.49,Default,,0,0,0,,♪「мақтаныш」
Dialogue: 0,0:55:39.25,0:55:42.08,Default,,0,0,0,,Уха! Ақымақ!
Dialogue: 0,0:55:42.21,0:55:44.42,Default,,0,0,0,,«мақтаныш» Шварцрозға тиесілі
Dialogue: 0,0:55:44.75,0:55:48.09,Default,,0,0,0,,Сіз дисквалификациясыз!
Dialogue: 0,0:56:04.19,0:56:08.49,Default,,0,0,0,,Хироның бейбақ, сен ән шығаруға қиналдың.
Dialogue: 0,0:56:08.82,0:56:11.28,Default,,0,0,0,,Сіз «мақтаныш» сөзін пайдалана алмағаныңызға сенімдімін
Dialogue: 0,0:56:12.41,0:56:13.62,Default,,0,0,0,,Сіз дисквалификацияланасыз...
Dialogue: 0,0:56:13.74,0:56:15.95,Default,,0,0,0,,А... (Әулие) Ә...
Dialogue: 0,0:56:33.55,0:56:34.59,Default,,0,0,0,,Кадзуки-сан!?
Dialogue: 0,0:56:34.76,0:56:35.64,Default,,0,0,0,,Коджи-сан да!?
Dialogue: 0,0:56:35.76,0:56:37.22,Default,,0,0,0,,Жапонияға қашан келдіңіз?
Dialogue: 0,0:56:37.35,0:56:40.64,Default,,0,0,0,,Бұл Хироның жарқырауының көрінісі.
Dialogue: 0,0:56:40.77,0:56:41.60,Default,,0,0,0,,Иә!?
Dialogue: 0,0:56:41.98,0:56:45.15,Default,,0,0,0,,Хмф, қазір не істесем де, мен дисквалификацияландым.
Dialogue: 0,0:56:45.27,0:56:47.11,Default,,0,0,0,,Хозуки командир! (Джин) Аа!?
Dialogue: 0,0:56:47.48,0:56:49.94,Default,,0,0,0,,Эдельроуз менің қарызымды өтеді!
Dialogue: 0,0:56:50.07,0:56:52.15,Default,,0,0,0,,Goyou қарызға кепілдік береді...
Dialogue: 0,0:56:52.28,0:56:53.36,Default,,0,0,0,,Нуах!
Dialogue: 0,0:56:54.11,0:56:57.37,Default,,0,0,0,,Әр адамның жүрегін ең көп жарқырататын нәрсе...
Dialogue: 0,0:56:57.87,0:56:59.12,Default,,0,0,0,,оның қан тамырларының қабырғаларынан шығып келе жатқанын—
Dialogue: 0,0:57:06.67,0:57:07.59,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:57:08.13,0:57:10.34,Default,,0,0,0,,Әулие шашырау!
Dialogue: 0,0:57:10.51,0:57:11.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:12.22,0:57:13.84,Default,,0,0,0,,Мен келдім.
Dialogue: 0,0:57:14.01,0:57:15.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:15.93,0:57:18.85,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:57:19.22,0:57:20.31,Default,,0,0,0,,Екі қатардан!
Dialogue: 0,0:57:20.56,0:57:22.81,Default,,0,0,0,,Мен сені міндетті түрде бақытты етемін!
Dialogue: 0,0:57:22.93,0:57:26.06,Default,,0,0,0,,Мен Хироды бақытты етемін!
Dialogue: 0,0:57:26.19,0:57:28.69,Default,,0,0,0,,Ол қазірдің өзінде бар! (Көрермендер) Хиро-сама!
Dialogue: 0,0:57:28.82,0:57:31.23,Default,,0,0,0,,Мен сені жақсы көремін~! (Көрермендер) Бақытты!
Dialogue: 0,0:57:31.86,0:57:35.95,Default,,0,0,0,,Батыр патшалық, күн батпайтын патшалық!
Dialogue: 0,0:57:36.32,0:57:39.16,Default,,0,0,0,,〈Жер сары болды! 〉
Dialogue: 0,0:57:39.58,0:57:40.70,Default,,0,0,0,,3 қатарынан!
Dialogue: 0,0:57:41.66,0:57:45.58,Default,,0,0,0,,Күн жүйесінде жаңа тыныштық пен тәртіп орнатамын!
Dialogue: 0,0:57:50.25,0:57:52.13,Default,,0,0,0,,Galaxy Break Shot Legend!
Dialogue: 0,0:57:52.26,0:57:55.43,Default,,0,0,0,,Абсолюттік монархия! Пакс Герона!
Dialogue: 0,0:57:55.72,0:57:56.72,Default,,0,0,0,,4 қатарынан!
Dialogue: 0,0:57:56.84,0:57:57.93,Default,,0,0,0,,Хиро! Хиро! Хиро! Хиро! Хиро!
Dialogue: 0,0:57:57.93,0:58:02.18,Default,,0,0,0,,Хиро! Хиро! Хиро! Хиро! Хиро!
Dialogue: 0,0:57:57.93,0:58:02.18,Default,,0,0,0,,Барлығының қолдауымен мен қазір Жерге қонамын!
Dialogue: 0,0:58:02.31,0:58:06.10,Default,,0,0,0,,Ахахахха хахахаха ахахха...
Dialogue: 0,0:58:06.64,0:58:10.27,Default,,0,0,0,,Хиро! Хиро! Хиро! Хиро!
Dialogue: 0,0:58:10.40,0:58:12.82,Default,,0,0,0,,Фуфу Ахахха Фуфу...
Dialogue: 0,0:58:12.94,0:58:15.86,Default,,0,0,0,,Ахахха хехехе...
Dialogue: 0,0:58:16.40,0:58:18.87,Default,,0,0,0,,Бәріңе сәлем! Фуфуфу…
Dialogue: 0,0:58:21.99,0:58:22.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:34.84,0:58:35.88,Default,,0,0,0,,Әй!
Dialogue: 0,0:58:47.98,0:58:50.77,Default,,0,0,0,,Уху-у-у-у-у-у-у...
Dialogue: 0,0:58:51.06,0:58:54.28,Default,,0,0,0,,Призма құдайы жаңа патшаға батасын беруде!
Dialogue: 0,0:58:59.53,0:59:01.28,Default,,0,0,0,,Енді мұны орындаңыз
Dialogue: 0,0:59:07.50,0:59:09.04,Default,,0,0,0,,Мен призма шоумын!
Dialogue: 0,0:59:09.42,0:59:11.25,Default,,0,0,0,,Хаха!
Dialogue: 0,0:59:11.38,0:59:13.88,Default,,0,0,0,,Ха... хаха!
Dialogue: 0,0:59:14.00,0:59:17.67,Default,,0,0,0,,Жоқ... Мақұлдамаймын... Арх!
Dialogue: 0,0:59:17.88,0:59:21.01,Default,,0,0,0,,А... Мен мұны ешқашан мойындамаймын!
Dialogue: 0,0:59:21.18,0:59:22.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:59:23.01,0:59:25.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:59:25.97,0:59:27.68,Default,,0,0,0,,Хаха!
Dialogue: 0,0:59:28.06,0:59:29.64,Default,,0,0,0,,Тақтың тәж киюі!
Dialogue: 0,0:59:30.10,0:59:33.19,Default,,0,0,0,,Призма патшасы!
Dialogue: 0,0:59:36.90,0:59:39.82,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:59:39.95,0:59:44.83,Default,,0,0,0,,Хиро Хаями бізге тамаша қойылым көрсетті!
Dialogue: 0,0:59:39.95,0:59:44.83,Default,,0,0,0,,～♪
Dialogue: 0,0:59:46.45,0:59:48.96,Default,,0,0,0,,Енді назар аударарлық ұпай қандай!?
Dialogue: 0,0:59:50.79,0:59:52.17,Default,,0,0,0,,Қолжетімсіз!
Dialogue: 0,0:59:52.50,0:59:55.30,Default,,0,0,0,,Не істеп жатырсың! (Шварц SS) Оны тезірек шығарыңыз!
Dialogue: 0,0:59:55.88,0:59:58.21,Default,,0,0,0,,Біз осындай толық емес жүйені енгіздік.
Dialogue: 0,0:59:58.34,1:00:01.26,Default,,0,0,0,,Толық жауапкершілік жауапты офицерге жүктеледі...
Dialogue: 0,1:00:01.38,1:00:03.05,Default,,0,0,0,,Сақтық көшірме бар.
Dialogue: 0,1:00:03.18,1:00:04.05,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:00:04.30,1:00:06.72,Default,,0,0,0,,P.R.I.S.M ЖҮЙЕСІ – бұл
Dialogue: 0,1:00:06.85,1:00:10.14,Default,,0,0,0,,Біз Wuyu тобының ынтымақтастығын алуды шештік.
Dialogue: 0,1:00:10.94,1:00:12.44,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,1:00:12.73,1:00:14.31,Default,,0,0,0,,Не!?
Dialogue: 0,1:00:14.48,1:00:17.32,Default,,0,0,0,,Не болды! Тез ұпай жинаңыз!
Dialogue: 0,1:00:17.78,1:00:19.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:24.74,1:00:25.78,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:00:26.99,1:00:30.25,Default,,0,0,0,,Патша сіз Хиро Хаямисіз
Dialogue: 0,1:00:30.75,1:00:31.96,Default,,0,0,0,,Сіздің ұпайыңыз бар!
Dialogue: 0,1:00:32.08,1:00:35.34,Default,,0,0,0,,20 000 карат! Толық баға!
Dialogue: 0,1:00:35.67,1:00:38.13,Default,,0,0,0,,Бірақ Prism Watch ұпайымен...
Dialogue: 0,1:00:38.25,1:00:41.34,Default,,0,0,0,,Хиро Хаями әлдеқайда жоғары.
Dialogue: 0,1:00:41.72,1:00:44.26,Default,,0,0,0,,Төраға Танаканың арнайы қаулысымен
Dialogue: 0,1:00:44.39,1:00:45.43,Default,,0,0,0,,Призма патшасы -
Dialogue: 0,1:00:45.55,1:00:48.31,Default,,0,0,0,,Хиро Хаями таңдалды!
Dialogue: 0,1:00:48.43,1:00:53.44,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:00:54.98,1:00:57.69,Default,,0,0,0,,Мен... Патшамын!
Dialogue: 0,1:00:57.94,1:00:59.57,Default,,0,0,0,,Хиро! Ах!
Dialogue: 0,1:00:59.69,1:01:01.32,Default,,0,0,0,,Ах, а... Хиро!
Dialogue: 0,1:01:08.12,1:01:09.29,Default,,0,0,0,,Коджи…
Dialogue: 0,1:01:10.45,1:01:11.79,Default,,0,0,0,,Кожи~!
Dialogue: 0,1:01:12.25,1:01:13.75,Default,,0,0,0,,Құттықтаймыз Хиро!
Dialogue: 0,1:01:18.75,1:01:20.96,Default,,0,0,0,,Неліктен? Ал фильм ше?
Dialogue: 0,1:01:21.55,1:01:24.55,Default,,0,0,0,,Мен данышпан суретші Коджи Камихамамын
Dialogue: 0,1:01:24.93,1:01:26.84,Default,,0,0,0,,Мен барлығын жасап біттім.
Dialogue: 0,1:01:27.43,1:01:28.72,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,1:01:29.60,1:01:31.85,Default,,0,0,0,,Бұл біз қайтадан бірге жұмыс істей аламыз дегенді білдіреді.
Dialogue: 0,1:01:32.48,1:01:35.40,Default,,0,0,0,,Казуки... Коудзи!
Dialogue: 0,1:01:36.19,1:01:40.78,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:01:42.03,1:01:43.74,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:01:44.36,1:01:45.20,Default,,0,0,0,,Иә
Dialogue: 0,1:01:45.86,1:01:46.86,Default,,0,0,0,,Ахх...
Dialogue: 0,1:01:47.57,1:01:50.45,Default,,0,0,0,,Барлығына! рақмет сізге!
Dialogue: 0,1:01:50.58,1:01:52.58,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:01:52.70,1:01:53.96,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:01:57.79,1:02:00.29,Default,,0,0,0,,Мен Хиро-сан сияқты болғым келеді
Dialogue: 0,1:02:01.05,1:02:03.97,Default,,0,0,0,,Өзіңізді алдамаңыз! Мұндай турнир жарамсыз!
Dialogue: 0,1:02:04.42,1:02:05.47,Default,,0,0,0,,Бұл Танака!
Dialogue: 0,1:02:05.80,1:02:06.63,Default,,0,0,0,,Уф...
Dialogue: 0,1:02:09.85,1:02:11.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:13.22,1:02:14.77,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,1:02:15.98,1:02:16.81,Default,,0,0,0,,Ха…
Dialogue: 0,1:02:16.94,1:02:21.65,Default,,0,0,0,,Жарайды, сені сүйетін адам міндетті түрде шығады.
Dialogue: 0,1:02:21.77,1:02:22.69,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:23.36,1:02:24.61,Default,,0,0,0,,Я...
Dialogue: 0,1:02:25.65,1:02:27.41,Default,,0,0,0,,Қасиетті! (Әулие) А?
Dialogue: 0,1:02:28.20,1:02:30.12,Default,,0,0,0,,Қасиетті!
Dialogue: 0,1:02:30.32,1:02:31.16,Default,,0,0,0,,маусым...
Dialogue: 0,1:02:31.70,1:02:32.83,Default,,0,0,0,,Хехе…
Dialogue: 0,1:02:33.16,1:02:34.79,Default,,0,0,0,,Жоқ маусым...
Dialogue: 0,1:02:34.91,1:02:37.29,Default,,0,0,0,,Мен сені сүйемін, Хиджири-сан.
Dialogue: 0,1:02:38.42,1:02:40.50,Default,,0,0,0,,…
Dialogue: 0,1:02:40.63,1:02:42.04,Default,,0,0,0,,Ахаха…
Dialogue: 0,1:02:42.59,1:02:45.05,Default,,0,0,0,,А...
Dialogue: 0,1:02:46.26,1:02:49.93,Default,,0,0,0,,Мен сенің жаныңдамын
Dialogue: 0,1:02:50.39,1:02:51.55,Default,,0,0,0,,Ки-иииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииии
Dialogue: 0,1:02:52.64,1:02:54.27,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:57.48,1:03:00.27,Default,,0,0,0,,Суретке түсейік! Иә ірімшік!
Dialogue: 0,1:03:00.61,1:03:02.27,Default,,0,0,0,,Ірімшік!
Dialogue: 0,1:03:02.57,1:03:04.69,Default,,0,0,0,,Призма патшасының тәжі...
Dialogue: 0,1:03:04.82,1:03:09.86,Default,,0,0,0,,Эдель Роузды Хиро Хаями жеңді!
Dialogue: 0,1:03:10.11,1:03:13.91,Default,,0,0,0,,Мен Призма патшасымын!
Dialogue: 0,1:03:17.79,1:03:22.79,Default,,0,0,0,,♪～
Dialogue: 0,1:06:19.68,1:06:24.68,Default,,0,0,0,,～♪
Dialogue: 0,1:06:29.77,1:06:33.28,Default,,0,0,0,,Жақсы көр! Еңсеріңіз!
Dialogue: 0,1:06:33.40,1:06:36.82,Default,,0,0,0,,Жақсы көр! Еңсеріңіз!
Dialogue: 0,1:06:36.95,1:06:40.41,Default,,0,0,0,,Жақсы көр! Еңсеріңіз!
Dialogue: 0,1:06:40.53,1:06:42.41,Default,,0,0,0,,Жақсы көр!
Dialogue: 0,1:06:42.54,1:06:47.54,Default,,0,0,0,,♪ «Кемпірқосақ тәжі»
Dialogue: 0,1:07:59.57,1:08:00.78,Default,,0,0,0,,Ха!
Dialogue: 0,1:08:06.37,1:08:08.29,Default,,0,0,0,,Ей, жылама
Dialogue: 0,1:08:12.04,1:08:13.42,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:08:13.71,1:08:15.88,Default,,0,0,0,,Мен сенің жалғыздығыңды азайтатын сиқыр жасаймын.
Dialogue: 0,1:08:17.71,1:08:20.09,Default,,0,0,0,,Пурипури призмасы...
Dialogue: 0,1:08:27.68,1:08:28.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:32.44,1:08:33.27,Default,,0,0,0,,Әрине
Dialogue: 0,1:08:36.02,1:08:37.48,Default,,0,0,0,,Маған да алуға болады ма?
Dialogue: 0,1:08:38.90,1:08:40.49,Default,,0,0,0,,Сіздің ерніңіз
Dialogue: 0,1:08:42.61,1:08:43.45,Default,,0,0,0,,Хмм...
Dialogue: 0,1:08:51.50,1:08:52.33,Default,,0,0,0,,Хмм...
Dialogue: 0,1:08:52.96,1:08:53.87,Default,,0,0,0,,Крест!
Dialogue: 0,1:08:56.54,1:08:57.38,Default,,0,0,0,,Сузуно!
Dialogue: 0,1:09:01.67,1:09:02.80,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,1:09:07.64,1:09:08.76,Default,,0,0,0,,Ха!
Dialogue: 0,1:09:08.89,1:09:11.43,Default,,0,0,0,,Диплом ломбарды!
Dialogue: 0,1:09:12.81,1:09:15.27,Default,,0,0,0,,Бір сүйісу әлемді өзгерте алады
Dialogue: 0,1:09:15.40,1:09:16.31,Default,,0,0,0,,Хмм...
Dialogue: 0,1:09:16.73,1:09:20.94,Default,,0,0,0,,Сіз де менімен махаббатты бастағыңыз келе ме?
Dialogue: 0,1:09:21.94,1:09:25.95,Default,,0,0,0,,Мен жүрегімдегі бұл толқуды ешқашан ұмытпаймын
Dialogue: 0,1:09:26.07,1:09:26.99,Default,,0,0,0,,Хмм...
Dialogue: 0,1:09:27.45,1:09:29.91,Default,,0,0,0,,Тәтті де азапты махаббат мұрасы!
Dialogue: 0,1:09:30.24,1:09:31.33,Default,,0,0,0,,Уф!
Dialogue: 0,1:09:31.45,1:09:37.17,Default,,0,0,0,,Мен бергім келеді! Жүректі соғып тұрған алғашқы сүйіспеншілік!
Dialogue: 0,1:09:45.05,1:09:50.06,Default,,0,0,0,,～♪
