Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.30,0:00:17.30,Default,,0,0,0,,♪〜
Dialogue: 0,0:01:20.66,0:01:26.66,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:29.04,0:01:29.75,Default,,0,0,0,,Хмм!
Dialogue: 0,0:01:42.43,0:01:43.93,Default,,0,0,0,,Бұл жер...
Dialogue: 0,0:01:44.39,0:01:48.85,Default,,0,0,0,,Біздің араши тайпасының киелі мекені, құдайлар мекені.
Dialogue: 0,0:01:49.10,0:01:49.90,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:01:52.32,0:01:57.57,Default,,0,0,0,,...
Dialogue: 0,0:01:59.20,0:02:01.53,Default,,0,0,0,,Хехехе, солай.
Dialogue: 0,0:02:02.03,0:02:02.91,Default,,0,0,0,,Міне.
Dialogue: 0,0:02:07.41,0:02:08.12,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:02:11.46,0:02:12.42,Default,,0,0,0,,Хехехе
Dialogue: 0,0:02:14.00,0:02:15.38,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:02:15.67,0:02:18.05,Default,,0,0,0,,Уау, аа, ой?
Dialogue: 0,0:02:19.80,0:02:20.72,Default,,0,0,0,,Уау
Dialogue: 0,0:02:23.26,0:02:26.72,Default,,0,0,0,,Ах ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха
Dialogue: 0,0:02:26.85,0:02:27.93,Default,,0,0,0,,О
Dialogue: 0,0:02:28.89,0:02:30.15,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:02:30.35,0:02:31.19,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:02:37.11,0:02:38.11,Default,,0,0,0,,Уф аа
Dialogue: 0,0:02:38.24,0:02:42.12,Default,,0,0,0,,Иә, мен оны жоғалтып алдым. Мен оны сағындым ба?
Dialogue: 0,0:02:46.12,0:02:47.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:47.70,0:02:49.54,Default,,0,0,0,,Довааааааааааааааааааааааа
Dialogue: 0,0:02:55.21,0:02:57.34,Default,,0,0,0,,Хахаха
Dialogue: 0,0:03:02.51,0:03:03.64,Default,,0,0,0,,Уау
Dialogue: 0,0:03:03.89,0:03:05.35,Default,,0,0,0,,Уау уау уау уау
Dialogue: 0,0:03:07.85,0:03:09.52,Default,,0,0,0,,(Энн) Хахаха (Жан) Иә!
Dialogue: 0,0:03:10.39,0:03:15.15,Default,,0,0,0,,Ой-оу
Dialogue: 0,0:03:15.27,0:03:20.95,Default,,0,0,0,,Ой-оу
Dialogue: 0,0:03:44.34,0:03:46.22,Default,,0,0,0,,Бүгін тайфун өтті.
Dialogue: 0,0:03:46.35,0:03:49.85,Default,,0,0,0,,Ашық көк аспан жайылып, күні бойы ыстық...
Dialogue: 0,0:03:50.14,0:03:51.89,Default,,0,0,0,,Хэхе ха
Dialogue: 0,0:03:52.89,0:03:53.77,Default,,0,0,0,,Ой
Dialogue: 0,0:03:54.65,0:03:55.77,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:03:56.19,0:03:58.15,Default,,0,0,0,,...
Dialogue: 0,0:03:58.36,0:03:59.15,Default,,0,0,0,,Ой
Dialogue: 0,0:04:02.90,0:04:04.57,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:04:07.41,0:04:11.50,Default,,0,0,0,,Юбе тайфуны кезінде бір жерден футбол добы маған ұшып келді ме?
Dialogue: 0,0:04:11.75,0:04:13.08,Default,,0,0,0,,О, ау!
Dialogue: 0,0:04:16.00,0:04:19.13,Default,,0,0,0,,Оле Оле Оле Оле! Оле!
Dialogue: 0,0:04:21.38,0:04:22.05,Default,,0,0,0,,Оле!
Dialogue: 0,0:04:28.97,0:04:29.89,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:31.27,0:04:32.89,Default,,0,0,0,,Бұл футбол добы емес пе?
Dialogue: 0,0:04:34.27,0:04:35.19,Default,,0,0,0,,Га
Dialogue: 0,0:04:35.52,0:04:37.48,Default,,0,0,0,,Уаааааааааааааааааа
Dialogue: 0,0:04:39.11,0:04:41.53,Default,,0,0,0,,Әй, менің радиобасқаруым
Dialogue: 0,0:04:41.94,0:04:43.78,Default,,0,0,0,,Хамф
Dialogue: 0,0:04:44.24,0:04:45.82,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:04:46.24,0:04:47.57,Default,,0,0,0,,Ху (Сунео) Уау
Dialogue: 0,0:04:49.08,0:04:49.74,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:50.16,0:04:51.70,Default,,0,0,0,,Ухухухухуху
Dialogue: 0,0:04:52.16,0:04:53.71,Default,,0,0,0,,Ах хехехе
Dialogue: 0,0:04:54.79,0:04:55.96,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:04:59.42,0:05:01.63,Default,,0,0,0,,Әй, жүр, кел
Dialogue: 0,0:05:02.26,0:05:03.26,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:05:03.38,0:05:05.22,Default,,0,0,0,,Ей, міне, осында, осында.
Dialogue: 0,0:05:06.76,0:05:10.35,Default,,0,0,0,,Ей Күтші уаааааааааааа.
Dialogue: 0,0:05:11.39,0:05:12.31,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:05:12.43,0:05:14.06,Default,,0,0,0,,Уф, мен оны ұстадым.
Dialogue: 0,0:05:14.77,0:05:17.98,Default,,0,0,0,,Сен менің қызметшім боласың. Ой... уау.
Dialogue: 0,0:05:18.73,0:05:21.19,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:05:22.03,0:05:24.82,Default,,0,0,0,,Уау, о, о, иә, Уау!
Dialogue: 0,0:05:26.03,0:05:26.53,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:05:26.53,0:05:28.45,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:05:26.53,0:05:28.45,Default,,0,0,0,,Сунечама, не болып жатыр?
Dialogue: 0,0:05:28.45,0:05:28.49,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:05:28.57,0:05:29.37,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:05:29.53,0:05:31.91,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:05:32.04,0:05:32.83,Default,,0,0,0,,Ху (Сунеоның анасы) Иә!
Dialogue: 0,0:05:33.58,0:05:37.29,Default,,0,0,0,,Эй, аа, а, сен не істеп жатырсың? аа...
Dialogue: 0,0:05:37.96,0:05:38.75,Default,,0,0,0,,Ах
Dialogue: 0,0:05:39.58,0:05:40.29,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:05:41.25,0:05:43.21,Default,,0,0,0,,... шабуылды күтіңіз
Dialogue: 0,0:05:46.80,0:05:48.26,Default,,0,0,0,,(Әйелдің айғайы)
Dialogue: 0,0:05:48.97,0:05:49.80,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:05:50.93,0:05:51.93,Default,,0,0,0,,Иә? (күшік) wan wan
Dialogue: 0,0:05:52.22,0:05:53.81,Default,,0,0,0,,Ал оның Регалияларының көбі шын мәнінде Нора болып шықты.
Dialogue: 0,0:05:55.77,0:05:57.31,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:05:58.69,0:06:01.11,Default,,0,0,0,,Мм, суық дәмді.
Dialogue: 0,0:06:03.15,0:06:04.78,Default,,0,0,0,,Фу? Хуиии
Dialogue: 0,0:06:08.15,0:06:08.91,Default,,0,0,0,,Ах
Dialogue: 0,0:06:09.03,0:06:09.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:10.41,0:06:11.49,Default,,0,0,0,,Біраз
Dialogue: 0,0:06:12.33,0:06:13.79,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:14.41,0:06:16.04,Default,,0,0,0,,Хаха... Нобита
Dialogue: 0,0:06:19.37,0:06:21.38,Default,,0,0,0,,Ха ха ха! Ха ха
Dialogue: 0,0:06:22.88,0:06:24.09,Default,,0,0,0,,Пичифуу
Dialogue: 0,0:06:24.50,0:06:27.63,Default,,0,0,0,,А, менің жұмсақ балмұздағым
Dialogue: 0,0:06:28.09,0:06:29.51,Default,,0,0,0,,Менікі!
Dialogue: 0,0:06:33.93,0:06:34.85,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:06:35.22,0:06:36.47,Default,,0,0,0,,Уаааааааааааааааааааа
Dialogue: 0,0:06:36.60,0:06:39.19,Default,,0,0,0,,«Менің жұмсақ балмұздағым»?
Dialogue: 0,0:06:39.31,0:06:43.90,Default,,0,0,0,,Нобита-кун, менің басымдағы бұл не?
Dialogue: 0,0:06:44.02,0:06:48.61,Default,,0,0,0,,Жұмсақ балмұздақ қалпақ әдемі көрінеді~
Dialogue: 0,0:06:49.40,0:06:51.07,Default,,0,0,0,,Конняро (Нобита) Ахх
Dialogue: 0,0:06:51.20,0:06:52.49,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:52.87,0:06:54.87,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:06:54.99,0:06:55.62,Default,,0,0,0,,Ах
Dialogue: 0,0:06:55.74,0:06:56.66,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:56.79,0:06:57.95,Default,,0,0,0,,Бұл мен емес
Dialogue: 0,0:06:58.16,0:06:59.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:59.50,0:07:00.62,Default,,0,0,0,,Енді, а
Dialogue: 0,0:07:01.12,0:07:03.71,Default,,0,0,0,,Бұл құйын, күт!
Dialogue: 0,0:07:04.79,0:07:06.67,Default,,0,0,0,,Алдау жақсы емес.
Dialogue: 0,0:07:06.88,0:07:10.01,Default,,0,0,0,,Нобита, мен оны саған қайтарамын.
Dialogue: 0,0:07:10.13,0:07:11.84,Default,,0,0,0,,Хааа (Нобита) Уф
Dialogue: 0,0:07:13.05,0:07:15.68,Default,,0,0,0,,Хмф, не?
Dialogue: 0,0:07:17.47,0:07:19.06,Default,,0,0,0,,Ой... а
Dialogue: 0,0:07:19.43,0:07:20.94,Default,,0,0,0,,Ах (Нобита) Уф
Dialogue: 0,0:07:21.31,0:07:24.02,Default,,0,0,0,,А, мен жасадым.
Dialogue: 0,0:07:24.27,0:07:26.27,Default,,0,0,0,,Қаш (Фуко) Хун
Dialogue: 0,0:07:26.57,0:07:28.94,Default,,0,0,0,,Жа... Джиан, жақсысың ба?
Dialogue: 0,0:07:29.49,0:07:31.57,Default,,0,0,0,,Хмм (Сунео) Ах!
Dialogue: 0,0:07:32.53,0:07:34.32,Default,,0,0,0,,Бұл жігіт керемет
Dialogue: 0,0:07:34.49,0:07:37.03,Default,,0,0,0,,Маған көмектескеніңізге қуаныштымын.
Dialogue: 0,0:07:37.16,0:07:38.95,Default,,0,0,0,,Хамф! (Нобита) Уа, уах, уах
Dialogue: 0,0:07:39.16,0:07:40.54,Default,,0,0,0,,Бұл не? Сен... неге мені қуалап жүрсің?
Dialogue: 0,0:07:41.29,0:07:45.21,Default,,0,0,0,,Сіз не істеп жатырсыз? Сіз кімсіз?
Dialogue: 0,0:07:45.46,0:07:46.25,Default,,0,0,0,,Хамф?
Dialogue: 0,0:07:46.75,0:07:50.47,Default,,0,0,0,,А-а-а, оны Дораемон шығарды.
Dialogue: 0,0:07:50.97,0:07:52.43,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:07:52.68,0:07:55.60,Default,,0,0,0,,Жұмсақ балмұздақ пен Джиан туралы...
Dialogue: 0,0:07:55.72,0:07:59.14,Default,,0,0,0,,Бұл сізсіз, барлығыңыз. Оны кейінірек дәлелдеңіз.
Dialogue: 0,0:07:59.27,0:08:00.31,Default,,0,0,0,,Иә
Dialogue: 0,0:08:00.43,0:08:02.06,Default,,0,0,0,,Менің артымнан ерме
Dialogue: 0,0:08:02.48,0:08:04.23,Default,,0,0,0,,Менің артымнан ерме!
Dialogue: 0,0:08:05.19,0:08:06.48,Default,,0,0,0,,Фуфуфуфуфу
Dialogue: 0,0:08:06.94,0:08:08.98,Default,,0,0,0,,Мен шаршадым
Dialogue: 0,0:08:09.28,0:08:11.36,Default,,0,0,0,,Сіз не істеп жатырсыз? Ол аурады.
Dialogue: 0,0:08:11.49,0:08:14.32,Default,,0,0,0,,Хехехехехехехехехехе
Dialogue: 0,0:08:14.53,0:08:17.28,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:08:18.49,0:08:22.71,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:08:23.71,0:08:24.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:25.42,0:08:32.30,Default,,0,0,0,,♪〜
Dialogue: 0,0:09:34.11,0:09:38.49,Default,,0,0,0,,〜♪
Dialogue: 0,0:09:39.12,0:09:41.99,Default,,0,0,0,,Иә? Мен ештеңе шығарған жоқпын
Dialogue: 0,0:09:42.20,0:09:44.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:44.70,0:09:48.29,Default,,0,0,0,,Үй жануарыңды алсаң, анаң саған тағы ашуланады.
Dialogue: 0,0:09:48.42,0:09:50.04,Default,,0,0,0,,Мен сізге рұқсатсыз ердім.
Dialogue: 0,0:09:50.17,0:09:51.42,Default,,0,0,0,,Ваааааааааааааа?
Dialogue: 0,0:09:51.67,0:09:52.96,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:09:53.55,0:09:58.63,Default,,0,0,0,,Бұл не? Мен оны бұрын ешқашан көрген емеспін. Оны анализатормен зерттеп көрейік.
Dialogue: 0,0:09:59.01,0:10:02.01,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:10:02.31,0:10:04.02,Default,,0,0,0,,Уау! не істеп жатырсың
Dialogue: 0,0:10:04.14,0:10:06.43,Default,,0,0,0,,Да... Жұмыс істемесе, уау.
Dialogue: 0,0:10:07.23,0:10:08.89,Default,,0,0,0,,Шынымен біртүрлі
Dialogue: 0,0:10:09.10,0:10:12.27,Default,,0,0,0,,Бұл ақылды, азапты тайфун.
Dialogue: 0,0:10:12.61,0:10:15.78,Default,,0,0,0,,Тайфун балалары? А, қазірдің өзінде
Dialogue: 0,0:10:16.57,0:10:17.78,Default,,0,0,0,,Корра (фууко) фуууу
Dialogue: 0,0:10:18.82,0:10:19.74,Default,,0,0,0,,Уау
Dialogue: 0,0:10:20.03,0:10:21.91,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:10:22.53,0:10:25.04,Default,,0,0,0,,Тоқтасаң, Фуко
Dialogue: 0,0:10:26.20,0:10:28.58,Default,,0,0,0,,Иә? Хехехе
Dialogue: 0,0:10:29.21,0:10:31.79,Default,,0,0,0,,Фуко қыз ба?
Dialogue: 0,0:10:31.92,0:10:35.05,Default,,0,0,0,,Ол тайфунның баласы болғандықтан, оны Фуко деп атауға болмайды.
Dialogue: 0,0:10:35.63,0:10:37.55,Default,,0,0,0,,Ху Ху Хун
Dialogue: 0,0:10:37.92,0:10:41.26,Default,,0,0,0,,Қыз болсаң, кішкентай қыз бала екенсің.
Dialogue: 0,0:10:41.39,0:10:42.26,Default,,0,0,0,,Уау! Ахх
Dialogue: 0,0:10:42.51,0:10:44.51,Default,,0,0,0,,Жарайды, қыз бала болғаны дұрыс.
Dialogue: 0,0:10:44.64,0:10:46.10,Default,,0,0,0,,Ахахха хехехе
Dialogue: 0,0:10:46.39,0:10:47.52,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:10:48.18,0:10:51.10,Default,,0,0,0,,Бірақ анам білсе, үлкен әбігер болады.
Dialogue: 0,0:10:51.23,0:10:53.19,Default,,0,0,0,,Мен сені қуып шыға алмаймын.
Dialogue: 0,0:10:53.31,0:10:54.90,Default,,0,0,0,,Уу (Нобита) Ах, Фуко
Dialogue: 0,0:10:55.73,0:10:56.94,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:10:57.74,0:11:00.40,Default,,0,0,0,,Хун Хун
Dialogue: 0,0:11:05.66,0:11:08.29,Default,,0,0,0,,Хамф.
Dialogue: 0,0:11:11.37,0:11:12.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:13.29,0:11:14.67,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:11:14.96,0:11:15.96,Default,,0,0,0,,О
Dialogue: 0,0:11:16.30,0:11:19.38,Default,,0,0,0,,Ал, оны бір нәрсенің ішіне сал.
Dialogue: 0,0:11:19.51,0:11:22.39,Default,,0,0,0,,Ахаха Фуко ақылды
Dialogue: 0,0:11:22.89,0:11:24.18,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:24.80,0:11:26.39,Default,,0,0,0,,Ноби-чан ах
Dialogue: 0,0:11:26.51,0:11:27.43,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:11:27.89,0:11:29.89,Default,,0,0,0,,Шәйнекті әкелдің ғой, солай ма?
Dialogue: 0,0:11:31.14,0:11:33.23,Default,,0,0,0,,А-а, жоқ, иә.
Dialogue: 0,0:11:33.35,0:11:35.65,Default,,0,0,0,,Өтінемін, үндемеңіз және қабылдамаңыз.
Dialogue: 0,0:11:35.77,0:11:36.44,Default,,0,0,0,,Иә
Dialogue: 0,0:11:36.82,0:11:39.19,Default,,0,0,0,,Нобита-кунды алып кетті.
Dialogue: 0,0:11:39.32,0:11:40.82,Default,,0,0,0,,Не... не істеуім керек, Дораемон?
Dialogue: 0,0:11:41.20,0:11:43.11,Default,,0,0,0,,Мен оны қайтаруым керек (Нобита) Иә.
Dialogue: 0,0:11:46.58,0:11:47.66,Default,,0,0,0,,А, аа!
Dialogue: 0,0:11:49.54,0:11:51.04,Default,,0,0,0,,Анашым, бұл...
Dialogue: 0,0:11:51.79,0:11:53.29,Default,,0,0,0,,Шәйнекте не болды?
Dialogue: 0,0:11:53.87,0:11:55.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:56.00,0:11:57.71,Default,,0,0,0,,Аххх (Фууко) Уау!
Dialogue: 0,0:12:00.46,0:12:02.22,Default,,0,0,0,,Уау Уау уау
Dialogue: 0,0:12:02.63,0:12:06.64,Default,,0,0,0,,Вааааааааааааааааааааа...
Dialogue: 0,0:12:07.30,0:12:08.14,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:12:08.39,0:12:09.39,Default,,0,0,0,,Дораемон
Dialogue: 0,0:12:09.52,0:12:10.47,Default,,0,0,0,,Нобита
Dialogue: 0,0:12:11.39,0:12:14.52,Default,,0,0,0,,Мақта кәмпиттерін үй жануарларын ұстамаңыз!
Dialogue: 0,0:12:15.98,0:12:16.77,Default,,0,0,0,,Хааа
Dialogue: 0,0:12:18.19,0:12:20.48,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:12:27.32,0:12:29.87,Default,,0,0,0,,Мен не істеуім керек, Дорэмон?
Dialogue: 0,0:12:30.41,0:12:34.67,Default,,0,0,0,,Мен не істесем де, оны бір нәрсеге салуым керек.
Dialogue: 0,0:12:35.08,0:12:38.34,Default,,0,0,0,,Хмм, иә, сонда болды.
Dialogue: 0,0:12:38.50,0:12:41.92,Default,,0,0,0,,Тегін өлшемді жануарларға арналған камера!
Dialogue: 0,0:12:42.59,0:12:45.59,Default,,0,0,0,,Мұны Фуко-чанға дене беру үшін пайдаланыңыз.
Dialogue: 0,0:12:45.72,0:12:47.14,Default,,0,0,0,,Қай түрі жақсы?
Dialogue: 0,0:12:47.34,0:12:49.64,Default,,0,0,0,,Олай болса. Хмм.
Dialogue: 0,0:12:49.76,0:12:51.72,Default,,0,0,0,,А, бұл туралы не деуге болады?
Dialogue: 0,0:12:52.10,0:12:55.85,Default,,0,0,0,,Сүйкімді емес пе? Маған бұл манга ұнайды.
Dialogue: 0,0:12:56.10,0:12:59.73,Default,,0,0,0,,Иә, жақсы. Тек осы камерамен суретке түсіріңіз.
Dialogue: 0,0:13:01.36,0:13:03.57,Default,,0,0,0,,Сіз тұлыптар жасай аласыз.
Dialogue: 0,0:13:04.82,0:13:05.78,Default,,0,0,0,,Ах (Фууко) Иә?
Dialogue: 0,0:13:08.49,0:13:10.12,Default,,0,0,0,,Дайын!
Dialogue: 0,0:13:10.45,0:13:11.12,Default,,0,0,0,,Кім кім?
Dialogue: 0,0:13:11.45,0:13:14.21,Default,,0,0,0,,Жүр, Фуко-чан, ішке кір.
Dialogue: 0,0:13:14.41,0:13:15.33,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:13:15.46,0:13:18.58,Default,,0,0,0,,Оны дене өлшеміңізге қарамастан киюге болады.
Dialogue: 0,0:13:18.75,0:13:19.96,Default,,0,0,0,,Ху Хун
Dialogue: 0,0:13:20.96,0:13:22.51,Default,,0,0,0,,Ах, ахахха, күшік
Dialogue: 0,0:13:22.63,0:13:23.88,Default,,0,0,0,,Бұл төңкерілген
Dialogue: 0,0:13:24.76,0:13:29.80,Default,,0,0,0,,иә иә иә иә иә иә иә иә иә иә иә һә иә иә иә иә һә иә иә иә иә иә иә һә иә иә һә иә иә һә иә һә иә һә иә һә иә һә иә һә иә һә иә һә иә иә һә иә һә иә
Dialogue: 0,0:13:30.22,0:13:32.26,Default,,0,0,0,,Фуко, бұл қаншалықты ыңғайлы?
Dialogue: 0,0:13:32.56,0:13:35.94,Default,,0,0,0,,(Фуконың қуанышты дауысы)
Dialogue: 0,0:13:37.81,0:13:39.81,Default,,0,0,0,,Уау, сен бақыттысың.
Dialogue: 0,0:13:39.94,0:13:42.32,Default,,0,0,0,,Осылай жасасаң, анам сені таппайды.
Dialogue: 0,0:13:42.94,0:13:46.99,Default,,0,0,0,,Эй, мен Фуконы Шизука-чанмен таныстыра аламын ба?
Dialogue: 0,0:13:47.11,0:13:49.95,Default,,0,0,0,,Жоқ десем де, өзіңмен бірге аласың.
Dialogue: 0,0:13:50.07,0:13:53.33,Default,,0,0,0,,Бірақ алдымен мына жерді тазалау керек.
Dialogue: 0,0:13:53.45,0:13:55.45,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:13:56.00,0:13:58.71,Default,,0,0,0,,Хехехехехехехехе
Dialogue: 0,0:13:59.08,0:14:02.67,Default,,0,0,0,,Иә, Фуко мен үшін тазалап бере ме?
Dialogue: 0,0:14:04.05,0:14:05.80,Default,,0,0,0,,Аа.
Dialogue: 0,0:14:06.22,0:14:10.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:11.26,0:14:12.89,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:14:19.19,0:14:21.15,Default,,0,0,0,,Ой!
Dialogue: 0,0:14:25.44,0:14:27.03,Default,,0,0,0,,О, бұл тамаша.
Dialogue: 0,0:14:27.15,0:14:28.45,Default,,0,0,0,,Фуко керемет
Dialogue: 0,0:14:28.78,0:14:30.24,Default,,0,0,0,,Фу Хун
Dialogue: 0,0:14:31.12,0:14:33.45,Default,,0,0,0,,Ал, Шидзука-чанның үйіне барайық.
Dialogue: 0,0:14:33.91,0:14:35.54,Default,,0,0,0,,Иә Takecopter
Dialogue: 0,0:14:36.08,0:14:37.45,Default,,0,0,0,,Менімен жүр, Фуко.
Dialogue: 0,0:14:37.58,0:14:38.83,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:40.50,0:14:41.38,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:14:42.17,0:14:43.88,Default,,0,0,0,,Хун Хун
Dialogue: 0,0:14:44.04,0:14:47.46,Default,,0,0,0,,Бұл Takecopter деп аталады және ол 22 ғасырдан...
Dialogue: 0,0:14:47.97,0:14:51.68,Default,,0,0,0,,Аа, мен қиын нәрсе айтсам да, Фуко түсінбейді.
Dialogue: 0,0:14:52.09,0:14:53.05,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:14:53.18,0:14:55.43,Default,,0,0,0,,Фуфуфуфуфу... (Фууко) Хамф?
Dialogue: 0,0:15:02.06,0:15:03.56,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:04.44,0:15:06.57,Default,,0,0,0,,Мен оны міндетті түрде табамын.
Dialogue: 0,0:15:07.40,0:15:09.57,Default,,0,0,0,,Дұрыс, Фуко, жарай ма?
Dialogue: 0,0:15:09.70,0:15:13.66,Default,,0,0,0,,Сіз ешқашан Шизука-чанда еркелік ойнамауыңыз керек.
Dialogue: 0,0:15:14.03,0:15:15.99,Default,,0,0,0,,А... иә, иә
Dialogue: 0,0:15:16.33,0:15:18.04,Default,,0,0,0,,Мен тыныш отырмын.
Dialogue: 0,0:15:18.16,0:15:19.16,Default,,0,0,0,,Ғұн ғұн
Dialogue: 0,0:15:19.29,0:15:21.58,Default,,0,0,0,,Түсінді ме? (Фуко) ғұн ғұн
Dialogue: 0,0:15:21.92,0:15:23.54,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:15:23.67,0:15:26.30,Default,,0,0,0,,Фуууууууууууууууу!
Dialogue: 0,0:15:26.75,0:15:30.59,Default,,0,0,0,,Хехехе, дәл Нобитаның қарындасы сияқты
Dialogue: 0,0:15:34.09,0:15:35.76,Default,,0,0,0,,Сіздің атыңыз Фуко-чан ба?
Dialogue: 0,0:15:36.06,0:15:38.60,Default,,0,0,0,,Иә, тайфунның баласындай.
Dialogue: 0,0:15:38.81,0:15:40.68,Default,,0,0,0,,Тайфун балалары?
Dialogue: 0,0:15:41.27,0:15:46.15,Default,,0,0,0,,Мен көп зерттеулер жасадым, бірақ ғылым оны түсіндіре алмайды.
Dialogue: 0,0:15:46.27,0:15:48.69,Default,,0,0,0,,Жарайды, Фуко - Фуко.
Dialogue: 0,0:15:49.19,0:15:50.28,Default,,0,0,0,,Ол да ақылды.
Dialogue: 0,0:15:50.65,0:15:52.74,Default,,0,0,0,,Я, бұл біртүрлі.
Dialogue: 0,0:15:53.07,0:15:54.24,Default,,0,0,0,,Хухун
Dialogue: 0,0:15:54.62,0:15:58.12,Default,,0,0,0,,Иә, менің тұлыпым дос бола ала ма?
Dialogue: 0,0:15:58.45,0:16:00.87,Default,,0,0,0,,Әрине, Фуко.
Dialogue: 0,0:16:01.00,0:16:02.04,Default,,0,0,0,,Хамф?
Dialogue: 0,0:16:03.04,0:16:05.00,Default,,0,0,0,,Оны маған анам сатып алды.
Dialogue: 0,0:16:07.54,0:16:11.01,Default,,0,0,0,,Сәлем Коала-чан
Dialogue: 0,0:16:11.42,0:16:14.97,Default,,0,0,0,,Уау, сен сүйкімдісің, көрсетші
Dialogue: 0,0:16:15.68,0:16:16.30,Default,,0,0,0,,Иә
Dialogue: 0,0:16:16.43,0:16:18.51,Default,,0,0,0,,Өте жақсы (Фууко) Ха!
Dialogue: 0,0:16:19.26,0:16:21.10,Default,,0,0,0,,Ол үлпілдек және жұмсақ.
Dialogue: 0,0:16:21.23,0:16:22.27,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:16:22.64,0:16:23.64,Default,,0,0,0,,Ой!
Dialogue: 0,0:16:23.81,0:16:25.98,Default,,0,0,0,,Аххх (Нобита) Ахххххх
Dialogue: 0,0:16:26.36,0:16:27.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:27.82,0:16:28.65,Default,,0,0,0,,Фуко!
Dialogue: 0,0:16:29.48,0:16:30.86,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:30.99,0:16:31.61,Default,,0,0,0,,Иә
Dialogue: 0,0:16:31.74,0:16:33.36,Default,,0,0,0,,Мен саған көп айттым
Dialogue: 0,0:16:33.57,0:16:34.74,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:34.99,0:16:36.62,Default,,0,0,0,,Мен сені енді кешірмеймін
Dialogue: 0,0:16:36.74,0:16:38.53,Default,,0,0,0,,А... Мм.
Dialogue: 0,0:16:39.03,0:16:41.29,Default,,0,0,0,,Бұл жай еркелік
Dialogue: 0,0:16:41.41,0:16:43.12,Default,,0,0,0,,Кешіріңіз, Шизука-чан
Dialogue: 0,0:16:43.25,0:16:45.17,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:16:45.29,0:16:46.71,Default,,0,0,0,,Фуко-чан кетіп қалды.
Dialogue: 0,0:16:47.04,0:16:50.55,Default,,0,0,0,,Е, жарайды, ол жігітті жайына қалдыр.
Dialogue: 0,0:16:51.05,0:16:54.01,Default,,0,0,0,,Мен сенің қайда бара жатқаныңды білмеймін, Нобита-кун.
Dialogue: 0,0:16:54.63,0:16:56.97,Default,,0,0,0,,Мен оның үйіне бармағанына сенімдімін.
Dialogue: 0,0:16:57.26,0:16:58.72,Default,,0,0,0,,Үй қайда?
Dialogue: 0,0:16:59.35,0:17:01.93,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:17:02.27,0:17:04.23,Default,,0,0,0,,Нобита-сан (Нобита) Уф
Dialogue: 0,0:17:07.52,0:17:08.73,Default,,0,0,0,,Фуко
Dialogue: 0,0:17:14.15,0:17:15.32,Default,,0,0,0,,Фуко!
Dialogue: 0,0:17:16.16,0:17:18.32,Default,,0,0,0,,Мен мұның бәрін саған айтқан болсам да.
Dialogue: 0,0:17:21.12,0:17:21.83,Default,,0,0,0,,Фуко
Dialogue: 0,0:17:23.04,0:17:23.95,Default,,0,0,0,,Фуко
Dialogue: 0,0:17:24.66,0:17:25.41,Default,,0,0,0,,Фуко
Dialogue: 0,0:17:25.79,0:17:28.00,Default,,0,0,0,,Фуфуфуфухуху
Dialogue: 0,0:17:32.92,0:17:35.17,Default,,0,0,0,,Мама Фуко, сіз білмейсіз бе?
Dialogue: 0,0:17:35.80,0:17:38.05,Default,,0,0,0,,Фуко? Амал жоқ, дәл алдында...
Dialogue: 0,0:17:38.18,0:17:41.97,Default,,0,0,0,,А, жоқ, олай емес. Толтырылған ойыншықтың аты.
Dialogue: 0,0:17:42.97,0:17:44.52,Default,,0,0,0,,Толтырылған жануар?
Dialogue: 0,0:17:45.73,0:17:46.98,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:17:47.64,0:17:49.65,Default,,0,0,0,,Фуко Ах...
Dialogue: 0,0:18:00.53,0:18:02.99,Default,,0,0,0,,Қайда бардың, Фуко?
Dialogue: 0,0:18:03.58,0:18:04.58,Default,,0,0,0,,Ах Нобита
Dialogue: 0,0:18:09.00,0:18:11.21,Default,,0,0,0,,Терең! Өте сау-саламат көрінесің! Бір жақсы жаңалық болды ма?
Dialogue: 0,0:18:29.77,0:18:32.02,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:18:33.19,0:18:34.11,Default,,0,0,0,,Фуко
Dialogue: 0,0:18:34.94,0:18:36.65,Default,,0,0,0,,Хаха!
Dialogue: 0,0:18:38.95,0:18:39.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:41.99,0:18:45.58,Default,,0,0,0,,Не, бұл жел ғана ма?
Dialogue: 0,0:18:46.83,0:18:48.29,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:18:51.29,0:18:52.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:54.09,0:18:54.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:55.13,0:18:55.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:55.96,0:18:58.51,Default,,0,0,0,,Фуко! (Фууко) Хехехехе
Dialogue: 0,0:19:01.18,0:19:04.76,Default,,0,0,0,,Сіз қайда болдыңыз? Сіз уайымдаған болуыңыз керек.
Dialogue: 0,0:19:05.06,0:19:06.72,Default,,0,0,0,,Иа... Ммм.
Dialogue: 0,0:19:06.89,0:19:09.14,Default,,0,0,0,,Енді ешқайда бара алмайсың.
Dialogue: 0,0:19:09.27,0:19:10.14,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:19:10.77,0:19:12.31,Default,,0,0,0,,Олай болса, үйге қайтайық.
Dialogue: 0,0:19:12.44,0:19:13.69,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:19:13.81,0:19:16.86,Default,,0,0,0,,Ах ха ха тұлып
Dialogue: 0,0:19:17.78,0:19:20.78,Default,,0,0,0,,Аа, Фуко, сіз аздап кішірейіп қалдыңыз ба?
Dialogue: 0,0:19:21.11,0:19:23.16,Default,,0,0,0,,Иә, қарныңыз ашты ма?
Dialogue: 0,0:19:23.32,0:19:24.37,Default,,0,0,0,,Ғұн ғұн
Dialogue: 0,0:19:25.03,0:19:26.62,Default,,0,0,0,,Мен де
Dialogue: 0,0:19:26.79,0:19:29.54,Default,,0,0,0,,Әй, менің құйыным
Dialogue: 0,0:19:31.83,0:19:33.83,Default,,0,0,0,,Нобита...
Dialogue: 0,0:19:33.96,0:19:35.92,Default,,0,0,0,,Ааааааааааааааа...
Dialogue: 0,0:19:36.04,0:19:38.05,Default,,0,0,0,,Хмм, сіз біреуге қоңырау шалдыңыз ба?
Dialogue: 0,0:19:38.17,0:19:39.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:39.97,0:19:42.89,Default,,0,0,0,,Бұл менің қиялым ғана ма? Ал, үйге қайтайық.
Dialogue: 0,0:19:43.01,0:19:43.93,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:19:51.64,0:19:53.98,Default,,0,0,0,,Ха, йойо, йо, ха!
Dialogue: 0,0:19:54.15,0:19:56.98,Default,,0,0,0,,Мен сол құйынды таптым.
Dialogue: 0,0:19:57.65,0:19:59.90,Default,,0,0,0,,Мен оны міндетті түрде қайтарамын.
Dialogue: 0,0:20:03.95,0:20:06.41,Default,,0,0,0,,Шизука-чан Фуко табылды
Dialogue: 0,0:20:06.58,0:20:09.58,Default,,0,0,0,,Иә, сізді алаңдатқаным үшін кешіріңіз. Иә иә.
Dialogue: 0,0:20:10.29,0:20:12.71,Default,,0,0,0,,Енді мен саған бірдеңе беруім керек.
Dialogue: 0,0:20:12.83,0:20:14.88,Default,,0,0,0,,Ертең кездескенше, хехехе
Dialogue: 0,0:20:16.25,0:20:19.05,Default,,0,0,0,,Ноби-чан, Дора-чан, тамақ ішейік.
Dialogue: 0,0:20:19.21,0:20:20.21,Default,,0,0,0,,Иә
Dialogue: 0,0:20:21.63,0:20:22.80,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:20:23.05,0:20:25.80,Default,,0,0,0,,«Ғарыш энциклопедиясына» сәйкес тайфундар —
Dialogue: 0,0:20:26.14,0:20:28.76,Default,,0,0,0,,Жылы ауа тамаққа айналғандай
Dialogue: 0,0:20:28.89,0:20:30.27,Default,,0,0,0,,Ғұн ғұн
Dialogue: 0,0:20:30.56,0:20:32.43,Default,,0,0,0,,Жылы ауа
Dialogue: 0,0:20:32.68,0:20:34.44,Default,,0,0,0,,Иә, жақсы нәрсе бар.
Dialogue: 0,0:20:34.69,0:20:37.02,Default,,0,0,0,,Қарапайым шаш кептіргіш!
Dialogue: 0,0:20:37.31,0:20:40.61,Default,,0,0,0,,Неліктен сізде «қалыпты шаш кептіргіш!» бар?
Dialogue: 0,0:20:40.73,0:20:42.44,Default,,0,0,0,,Оның болғаны жақсы емес пе?
Dialogue: 0,0:20:43.03,0:20:46.45,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:20:46.82,0:20:48.16,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:20:48.28,0:20:49.08,Default,,0,0,0,,Бұл дәмді болды ма?
Dialogue: 0,0:20:49.20,0:20:51.16,Default,,0,0,0,,Хухун
Dialogue: 0,0:20:52.08,0:20:56.00,Default,,0,0,0,,иә иә иә
Dialogue: 0,0:20:56.46,0:20:57.79,Default,,0,0,0,,Қазір өзіңізді жақсы сезінесіз.
Dialogue: 0,0:20:57.92,0:20:58.54,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:20:58.71,0:21:00.38,Default,,0,0,0,,Ноби-чан Дора-чан Уау
Dialogue: 0,0:21:00.50,0:21:03.09,Default,,0,0,0,,Бұл ана. Не істеуім керек? Не істеуім керек? Ах...
Dialogue: 0,0:21:03.80,0:21:07.05,Default,,0,0,0,,Тыңда, тұлып сияқты тыныш бол.
Dialogue: 0,0:21:07.80,0:21:09.68,Default,,0,0,0,,Сіз не істеп жатырсыз? (Нобита) А... А?
Dialogue: 0,0:21:09.81,0:21:10.93,Default,,0,0,0,,Арама
Dialogue: 0,0:21:12.02,0:21:14.18,Default,,0,0,0,,Бұл сіз іздеген Фуко-чан ба?
Dialogue: 0,0:21:14.43,0:21:15.69,Default,,0,0,0,,Ах... иә
Dialogue: 0,0:21:15.94,0:21:17.56,Default,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:21:17.69,0:21:18.69,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:21:19.02,0:21:23.19,Default,,0,0,0,,Аа, тірі сияқты, өте жақсы жасалған.
Dialogue: 0,0:21:23.32,0:21:24.65,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:21:24.78,0:21:27.20,Default,,0,0,0,,Екеуіңе не болды? (Нобита) Иә?
Dialogue: 0,0:21:28.95,0:21:30.95,Default,,0,0,0,,Тамақтың уақыты келді. Асықшы.
Dialogue: 0,0:21:31.08,0:21:32.33,Default,,0,0,0,,Иә Иә Иә Иә
Dialogue: 0,0:21:32.49,0:21:33.83,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:33.95,0:21:36.12,Default,,0,0,0,,Фуко, сен керемет жасадың.
Dialogue: 0,0:21:36.33,0:21:37.54,Default,,0,0,0,,Иә
Dialogue: 0,0:21:37.71,0:21:39.67,Default,,0,0,0,,Иә? Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:21:41.30,0:21:42.92,Default,,0,0,0,,Әй, көзіңді қысып жібермедің бе?
Dialogue: 0,0:21:43.05,0:21:45.55,Default,,0,0,0,,Жоқ Жоқ Жоқ Жоқ Мұның бәрі менің қиялым Бұл менің қиялым
Dialogue: 0,0:21:47.34,0:21:48.97,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:21:49.09,0:21:50.30,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:21:59.19,0:22:02.52,Default,,0,0,0,,Дораэмон Typhoon балалары да ұйықтайды, солай ма?
Dialogue: 0,0:22:02.90,0:22:05.44,Default,,0,0,0,,Атмосфералық қысым тұрақты, солай ма?
Dialogue: 0,0:22:09.07,0:22:13.45,Default,,0,0,0,,Эй, ертең мен саған үлкен жерде ойнауға рұқсат етемін.
Dialogue: 0,0:22:13.70,0:22:18.29,Default,,0,0,0,,Дұрыс, шөл, дала сияқты жерлер жақсы.
Dialogue: 0,0:22:18.62,0:22:21.79,Default,,0,0,0,,Иә, жақсы. Шизука-чанды да шақырыңыз.
Dialogue: 0,0:22:22.04,0:22:25.71,Default,,0,0,0,,Мен білемін. Хуаааааааааааааааааааааа
Dialogue: 0,0:22:25.84,0:22:28.05,Default,,0,0,0,,Олай болса, қайырлы түн Нобита-кун.
Dialogue: 0,0:22:28.18,0:22:29.51,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:22:29.63,0:22:32.39,Default,,0,0,0,,Қайырлы түн Фуко
Dialogue: 0,0:22:38.85,0:22:43.57,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:22:43.69,0:22:46.74,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:22:46.90,0:22:49.95,Default,,0,0,0,,Дұрыс, Джанды өз жағымызға алайық.
Dialogue: 0,0:22:59.12,0:23:02.17,Default,,0,0,0,,(ұйқыда сөйлесу)
Dialogue: 0,0:23:04.75,0:23:07.13,Default,,0,0,0,,Барлық жерде есіктер!
Dialogue: 0,0:23:08.26,0:23:10.13,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:23:10.68,0:23:11.80,Default,,0,0,0,,Кез келген жерде жақсы.
Dialogue: 0,0:23:12.14,0:23:13.30,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:23:12.14,0:23:13.30,Default,,0,0,0,,Кең өріске
Dialogue: 0,0:23:13.30,0:23:15.35,Default,,0,0,0,,Кең өріске
Dialogue: 0,0:23:17.10,0:23:19.64,Default,,0,0,0,,Бұл рас па? Мені лақтырып жіберген...
Dialogue: 0,0:23:19.77,0:23:22.52,Default,,0,0,0,,Бұл Нобитаның тұлыпының ішінде болды, солай ма?
Dialogue: 0,0:23:22.69,0:23:24.15,Default,,0,0,0,,Неге? Хм?
Dialogue: 0,0:23:24.31,0:23:26.73,Default,,0,0,0,,Жақсы! Мен оны жұмсақ етіп жасаймын
Dialogue: 0,0:23:26.98,0:23:29.65,Default,,0,0,0,,Дау-дамай жасама, ұстап алайық
Dialogue: 0,0:23:29.78,0:23:31.78,Default,,0,0,0,,Мен сені ұстап алсам не істеуім керек?
Dialogue: 0,0:23:31.91,0:23:35.37,Default,,0,0,0,,Ол өте күшті.
Dialogue: 0,0:23:36.12,0:23:37.20,Default,,0,0,0,,Сунео (Сунео) Иә?
Dialogue: 0,0:23:38.16,0:23:40.54,Default,,0,0,0,,Мен зорлық-зомбылықтан шаршадым.
Dialogue: 0,0:23:40.83,0:23:42.37,Default,,0,0,0,,Өтірік
Dialogue: 0,0:23:44.38,0:23:46.96,Default,,0,0,0,,Уау керемет Уау
Dialogue: 0,0:23:47.09,0:23:50.17,Default,,0,0,0,,Бұл өте кең (Фууко) Уау!
Dialogue: 0,0:23:54.59,0:23:56.43,Default,,0,0,0,,Фуко
Dialogue: 0,0:23:56.97,0:23:59.68,Default,,0,0,0,,Ой-ау
Dialogue: 0,0:23:59.93,0:24:01.69,Default,,0,0,0,,Фуко-чан, бұл керемет болды.
Dialogue: 0,0:24:02.02,0:24:03.98,Default,,0,0,0,,Ей, бірге барайық...
Dialogue: 0,0:24:04.10,0:24:05.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:05.36,0:24:06.61,Default,,0,0,0,,Вааах!
Dialogue: 0,0:24:06.86,0:24:08.48,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:24:08.94,0:24:11.57,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:24:14.28,0:24:17.08,Default,,0,0,0,,Екі бетке жиырма минут деді ме? Дұрыс естімеген шығармын?
Dialogue: 0,0:24:19.20,0:24:21.66,Default,,0,0,0,,Апай, сізді мазалағаным үшін кешіріңіз.
Dialogue: 0,0:24:22.16,0:24:23.87,Default,,0,0,0,,Нобита-кун, сен осындасың ба?
Dialogue: 0,0:24:24.00,0:24:26.46,Default,,0,0,0,,Иә, Шидзука-чан да келе жатыр.
Dialogue: 0,0:24:26.63,0:24:28.17,Default,,0,0,0,,Маған көтерілуге ​​рұқсат етіңіз.
Dialogue: 0,0:24:28.30,0:24:29.38,Default,,0,0,0,,Марс
Dialogue: 0,0:24:29.80,0:24:31.97,Default,,0,0,0,,Онда ештеңе жоқ. Екі жағы да бос.
Dialogue: 0,0:24:32.67,0:24:35.14,Default,,0,0,0,,Онда ештеңе жоқ. Екі жағы да бос.
Dialogue: 0,0:24:35.26,0:24:37.60,Default,,0,0,0,,Уау Уау Уау Уау
Dialogue: 0,0:24:38.31,0:24:40.64,Default,,0,0,0,,суға бату, суға бату, батып кету
Dialogue: 0,0:24:40.93,0:24:42.31,Default,,0,0,0,,Хамф
Dialogue: 0,0:24:42.48,0:24:45.23,Default,,0,0,0,,Ах... Рахмет. Дораэмон ше?
Dialogue: 0,0:24:45.35,0:24:48.61,Default,,0,0,0,,Шизука-чан құтқарылды ма?
Dialogue: 0,0:24:48.73,0:24:50.19,Default,,0,0,0,,Енот ит! иә?
Dialogue: 0,0:24:50.32,0:24:52.61,Default,,0,0,0,,Шизука-чан Мен мысық тәрізді роботпын...
Dialogue: 0,0:24:53.03,0:24:54.61,Default,,0,0,0,,Мұнда енот ит бар.
Dialogue: 0,0:24:54.74,0:24:55.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:55.74,0:24:57.87,Default,,0,0,0,,Иә, Ойшо.
Dialogue: 0,0:24:59.45,0:25:01.95,Default,,0,0,0,,Қараңызшы, көп (Нобита) Уау
Dialogue: 0,0:25:03.29,0:25:05.33,Default,,0,0,0,,Бұл рас, сүйкімді.
Dialogue: 0,0:25:05.46,0:25:06.75,Default,,0,0,0,,Фуфуфуфуфу
Dialogue: 0,0:25:06.88,0:25:07.54,Default,,0,0,0,,Фуко
Dialogue: 0,0:25:08.88,0:25:10.30,Default,,0,0,0,,Пон Пон Пон Пон
Dialogue: 0,0:25:11.34,0:25:13.26,Default,,0,0,0,,Пешка! (Фууко) Фуфуфу?
Dialogue: 0,0:25:13.84,0:25:17.97,Default,,0,0,0,,Хахаха Шар сияқты Ухуху Расында Ухуху
Dialogue: 0,0:25:18.14,0:25:19.05,Default,,0,0,0,,Хехехе
Dialogue: 0,0:25:19.30,0:25:20.10,Default,,0,0,0,,Иә
Dialogue: 0,0:25:20.22,0:25:22.68,Default,,0,0,0,,Алысқа бармаңыз.
Dialogue: 0,0:25:23.23,0:25:24.98,Default,,0,0,0,,Қараңдар! Жел диірмені
Dialogue: 0,0:25:31.11,0:25:34.53,Default,,0,0,0,,Уау, анау биік жарда бір үй бар.
Dialogue: 0,0:25:35.15,0:25:37.66,Default,,0,0,0,,Эй, мен бұл қой бұлт деп ойладым...
Dialogue: 0,0:25:37.91,0:25:39.70,Default,,0,0,0,,Бұл нағыз қой
Dialogue: 0,0:25:39.82,0:25:40.70,Default,,0,0,0,,Ой
Dialogue: 0,0:25:41.24,0:25:42.62,Default,,0,0,0,,Дануки шары және—
Dialogue: 0,0:25:42.99,0:25:46.58,Default,,0,0,0,,Ұшатын қой, айдаһар кіреберіс
Dialogue: 0,0:25:47.25,0:25:49.92,Default,,0,0,0,,Бұл жердің қай жері?
Dialogue: 0,0:25:50.96,0:25:53.84,Default,,0,0,0,,Аа, сіз Дораэмонмен бірге шыққан сияқтысыз.
Dialogue: 0,0:25:53.96,0:25:55.38,Default,,0,0,0,,Біз де кеттік
Dialogue: 0,0:25:55.51,0:25:56.63,Default,,0,0,0,,Сунео (Сунео) Иә?
Dialogue: 0,0:25:57.01,0:25:59.01,Default,,0,0,0,,Барып аяқ киіміңді ал (Сунео) Иә.
Dialogue: 0,0:26:00.18,0:26:02.97,Default,,0,0,0,,Кяааааааааааааааааааааааааааааааааа (араши тайпасы Б)
Dialogue: 0,0:26:03.14,0:26:04.43,Default,,0,0,0,,Kyaaaahhh
Dialogue: 0,0:26:04.56,0:26:05.31,Default,,0,0,0,,Хехехе
Dialogue: 0,0:26:05.98,0:26:07.64,Default,,0,0,0,,Хохохохо
Dialogue: 0,0:26:07.77,0:26:09.65,Default,,0,0,0,,Текестер
Dialogue: 0,0:26:09.81,0:26:10.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:10.69,0:26:11.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:12.23,0:26:15.44,Default,,0,0,0,,Хмм... (араши тайпасы С) Эхехе хе
Dialogue: 0,0:26:16.15,0:26:17.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:18.41,0:26:20.53,Default,,0,0,0,,Хехехе
Dialogue: 0,0:26:21.28,0:26:22.87,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:26:22.99,0:26:23.87,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:26:24.04,0:26:25.91,Default,,0,0,0,,(Сунның айқайы)
Dialogue: 0,0:26:26.04,0:26:27.87,Default,,0,0,0,,Бірдеңе бар ма? Бірдеңе бар ма? Бірдеңе...
Dialogue: 0,0:26:28.00,0:26:30.67,Default,,0,0,0,,Көтерілетін төсеніш!
Dialogue: 0,0:26:30.92,0:26:31.71,Default,,0,0,0,,Еш күмән жоқ… сол сұм!
Dialogue: 0,0:26:31.84,0:26:35.01,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:26:36.97,0:26:40.64,Default,,0,0,0,,А, жақсы. Сенімен бәрі жақсы ма?
Dialogue: 0,0:26:40.97,0:26:42.89,Default,,0,0,0,,Сокуууу
Dialogue: 0,0:26:43.35,0:26:44.89,Default,,0,0,0,,Танаа Реда?
Dialogue: 0,0:26:45.10,0:26:46.73,Default,,0,0,0,,«Леда»
Dialogue: 0,0:26:46.98,0:26:49.81,Default,,0,0,0,,Не болып жатыр? Уау
Dialogue: 0,0:26:51.27,0:26:52.69,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:26:52.81,0:26:54.90,Default,,0,0,0,,Джан Сунео
Dialogue: 0,0:26:55.03,0:26:56.90,Default,,0,0,0,,А, бұл қайда?
Dialogue: 0,0:26:57.03,0:26:58.15,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:26:58.36,0:27:00.57,Default,,0,0,0,,Түн! Ах уау
Dialogue: 0,0:27:00.78,0:27:02.53,Default,,0,0,0,,Кабуйо Дзидат
Dialogue: 0,0:27:02.66,0:27:04.99,Default,,0,0,0,,Ызма (Дауыл тайпасы В) Дагея Кихи
Dialogue: 0,0:27:08.50,0:27:10.79,Default,,0,0,0,,Чик Каташи крабы
Dialogue: 0,0:27:11.21,0:27:12.29,Default,,0,0,0,,Күн
Dialogue: 0,0:27:12.67,0:27:13.84,Default,,0,0,0,,Темучин
Dialogue: 0,0:27:14.34,0:27:17.01,Default,,0,0,0,,Әй, осындай кездерде таныс...
Dialogue: 0,0:27:17.13,0:27:19.51,Default,,0,0,0,,Шынымен конняку!
Dialogue: 0,0:27:19.97,0:27:21.26,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:27:21.38,0:27:24.47,Default,,0,0,0,,Эй, эй, эй, мен Дораемонмын.
Dialogue: 0,0:27:24.60,0:27:27.43,Default,,0,0,0,,Менің әпкем Күнге көмектескеніңіз үшін рахмет.
Dialogue: 0,0:27:28.06,0:27:30.69,Default,,0,0,0,,Бұл жігіттер шынымен де қатыгез.
Dialogue: 0,0:27:31.73,0:27:33.27,Default,,0,0,0,,I Темучин
Dialogue: 0,0:27:33.40,0:27:35.36,Default,,0,0,0,,Ямджин Томджинге Иә.
Dialogue: 0,0:27:35.48,0:27:36.98,Default,,0,0,0,,Бұл Кунджин Иә.
Dialogue: 0,0:27:37.11,0:27:38.03,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:27:38.28,0:27:39.69,Default,,0,0,0,,Мен Нобитамын.
Dialogue: 0,0:27:39.82,0:27:42.07,Default,,0,0,0,,Мен Шизукамын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:27:42.36,0:27:44.12,Default,,0,0,0,,Менің атым Сунео Хонекава.
Dialogue: 0,0:27:44.24,0:27:46.95,Default,,0,0,0,,Такеши Гота, мені Джан деп атаңыз.
Dialogue: 0,0:27:47.08,0:27:47.87,Default,,0,0,0,,(Нобита мен оның достарының күлкісі)
Dialogue: 0,0:27:47.99,0:27:49.33,Default,,0,0,0,,Шамасы, балалар...
Dialogue: 0,0:27:49.50,0:27:52.00,Default,,0,0,0,,Оны «жел тынысы» сорып алған сияқты.
Dialogue: 0,0:27:52.58,0:27:55.25,Default,,0,0,0,,Темучин, бұл қайда?
Dialogue: 0,0:27:58.55,0:28:00.09,Default,,0,0,0,,Жел ауылы
Dialogue: 0,0:28:06.72,0:28:10.89,Default,,0,0,0,,Біз, жел адамдары, ежелден желді басқарып келеміз.
Dialogue: 0,0:28:11.10,0:28:14.52,Default,,0,0,0,,Желмен бірге өмір сүрген жел пайдаланушылар отбасы.
Dialogue: 0,0:28:22.07,0:28:23.70,Default,,0,0,0,,Мама, қош келдіңіз
Dialogue: 0,0:28:23.82,0:28:25.49,Default,,0,0,0,,Анашым
Dialogue: 0,0:28:25.74,0:28:27.45,Default,,0,0,0,,Сәлем
Dialogue: 0,0:28:31.29,0:28:32.50,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:28:32.62,0:28:33.96,Default,,0,0,0,,Са… Сэм Сэм Сэм
Dialogue: 0,0:28:34.62,0:28:36.67,Default,,0,0,0,,Уау, о, өте жылы екен
Dialogue: 0,0:28:37.09,0:28:39.34,Default,,0,0,0,,Уау, бұл саған жақсы көрінеді, солай ма?
Dialogue: 0,0:28:39.80,0:28:43.05,Default,,0,0,0,,Хуан Хуан Хуан
Dialogue: 0,0:28:43.59,0:28:45.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:46.01,0:28:47.30,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:28:48.93,0:28:52.35,Default,,0,0,0,,Хуан Хуан
Dialogue: 0,0:28:55.48,0:28:58.86,Default,,0,0,0,,Біз өмір сүру үшін желдің күшіне сүйенеміз.
Dialogue: 0,0:28:58.98,0:29:01.03,Default,,0,0,0,,Эй, су сорып жатыр...
Dialogue: 0,0:29:01.15,0:29:02.74,Default,,0,0,0,,Өсімдіктер –
Dialogue: 0,0:29:03.03,0:29:07.41,Default,,0,0,0,,Мал, балық және барлық азық-түлік желді басқару арқылы жасалады.
Dialogue: 0,0:29:07.53,0:29:09.28,Default,,0,0,0,,Иә
Dialogue: 0,0:29:12.00,0:29:15.12,Default,,0,0,0,,Бұл үлкен жел диірмені Ақсақал жел диірмені деп аталады.
Dialogue: 0,0:29:16.12,0:29:19.29,Default,,0,0,0,,Уау, үлкен ұлу!
Dialogue: 0,0:29:19.59,0:29:21.42,Default,,0,0,0,,Бұл ұлу
Dialogue: 0,0:29:21.59,0:29:22.76,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:29:22.88,0:29:24.92,Default,,0,0,0,,Сирек кездесетін тіршілік иелері
Dialogue: 0,0:29:25.18,0:29:26.89,Default,,0,0,0,,Бұл сүйкімді
Dialogue: 0,0:29:27.01,0:29:27.89,Default,,0,0,0,,Рас
Dialogue: 0,0:29:28.09,0:29:30.35,Default,,0,0,0,,Уау, біртүрлі жылан
Dialogue: 0,0:29:30.47,0:29:31.85,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:29:31.97,0:29:35.10,Default,,0,0,0,,Қалыпты тасбақалар да бар. Уау, ұшып кетті.
Dialogue: 0,0:29:35.89,0:29:38.27,Default,,0,0,0,,Қара аю мен қоян
Dialogue: 0,0:29:38.86,0:29:39.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:40.57,0:29:41.69,Default,,0,0,0,,Уау
Dialogue: 0,0:29:41.82,0:29:44.36,Default,,0,0,0,,Yahoo! Апыр-ай!
Dialogue: 0,0:29:44.53,0:29:46.70,Default,,0,0,0,,Ахх (барлығы күледі)
Dialogue: 0,0:29:48.78,0:29:50.03,Default,,0,0,0,,Уау
Dialogue: 0,0:29:55.21,0:29:58.04,Default,,0,0,0,,Олардың барлығы біз бұрын ешқашан көрмеген жануарлар.
Dialogue: 0,0:29:58.58,0:30:02.63,Default,,0,0,0,,Ол тек осы ауылдың ішінде ғана дамыған болуы мүмкін.
Dialogue: 0,0:30:03.00,0:30:07.13,Default,,0,0,0,,Жер бетінде әлі де біз білмейтін әлем бар.
Dialogue: 0,0:30:07.55,0:30:10.55,Default,,0,0,0,,Бірақ жел энергия ретінде пайдаланылады...
Dialogue: 0,0:30:10.93,0:30:12.18,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:30:12.31,0:30:13.26,Default,,0,0,0,,Иә
Dialogue: 0,0:30:13.93,0:30:14.85,Default,,0,0,0,,Әй, Темучин
Dialogue: 0,0:30:14.97,0:30:17.85,Default,,0,0,0,,Қазір ғана Күнді қуған жел адамдары ма?
Dialogue: 0,0:30:17.98,0:30:19.73,Default,,0,0,0,,Олар Араши тайпасы.
Dialogue: 0,0:30:20.44,0:30:21.82,Default,,0,0,0,,Жел адамдарынан өзгеше
Dialogue: 0,0:30:21.94,0:30:24.11,Default,,0,0,0,,Темучин (барлығы) Ах.
Dialogue: 0,0:30:26.40,0:30:27.90,Default,,0,0,0,,Жел оғымен доп ойнаймыз
Dialogue: 0,0:30:28.03,0:30:29.99,Default,,0,0,0,,Иә, барлығы ше?
Dialogue: 0,0:30:30.11,0:30:31.70,Default,,0,0,0,,Иә, не?
Dialogue: 0,0:30:31.91,0:30:34.37,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ қызық көрінеді
Dialogue: 0,0:30:35.08,0:30:38.92,Default,,0,0,0,,Джан, біз мұнда не үшін келгенімізді ұмыттық па?
Dialogue: 0,0:30:39.04,0:30:41.13,Default,,0,0,0,,Иә? Мен ұмыттым
Dialogue: 0,0:30:41.92,0:30:42.79,Default,,0,0,0,,Джан
Dialogue: 0,0:30:43.09,0:30:44.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:44.92,0:30:47.76,Default,,0,0,0,,Желді мына жартастағы нысанаға ат
Dialogue: 0,0:30:53.76,0:30:54.76,Default,,0,0,0,,Бұраңыз!
Dialogue: 0,0:30:55.81,0:30:57.06,Default,,0,0,0,,Маған жасап көрейін.
Dialogue: 0,0:31:01.48,0:31:02.36,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:31:04.52,0:31:05.53,Default,,0,0,0,,Тори
Dialogue: 0,0:31:06.99,0:31:08.03,Default,,0,0,0,,Тори
Dialogue: 0,0:31:08.49,0:31:09.95,Default,,0,0,0,,Тори Тори
Dialogue: 0,0:31:10.95,0:31:11.82,Default,,0,0,0,,Уау
Dialogue: 0,0:31:11.95,0:31:13.28,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:31:13.58,0:31:15.45,Default,,0,0,0,,Ей, мен де істейін.
Dialogue: 0,0:31:15.58,0:31:17.08,Default,,0,0,0,,Нобита nya мүмкін емес мүмкін емес
Dialogue: 0,0:31:17.20,0:31:19.25,Default,,0,0,0,,Мен мұндай нәрсеге жақсымын.
Dialogue: 0,0:31:19.62,0:31:21.96,Default,,0,0,0,,Жел адамдар үшін де қиын.
Dialogue: 0,0:31:22.08,0:31:24.46,Default,,0,0,0,,Бір оқ болса да өтіп кетесің.
Dialogue: 0,0:31:25.00,0:31:27.67,Default,,0,0,0,,Нобита Көріп көрейік (Нобита) Иә.
Dialogue: 0,0:31:28.01,0:31:29.63,Default,,0,0,0,,Сәттілік Нобита-сан
Dialogue: 0,0:31:30.05,0:31:31.68,Default,,0,0,0,,Кеттік (Нобита) Жарайды.
Dialogue: 0,0:31:32.18,0:31:33.76,Default,,0,0,0,,Жақсы мақсат қой (Нобита) Иә
Dialogue: 0,0:31:34.35,0:31:35.26,Default,,0,0,0,,Қазір (Нобита) taaa
Dialogue: 0,0:31:35.72,0:31:36.68,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:31:37.10,0:31:38.43,Default,,0,0,0,,Міне (Нобита) Осымен
Dialogue: 0,0:31:41.39,0:31:42.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:42.40,0:31:44.23,Default,,0,0,0,,Керемет, мүмкін емес
Dialogue: 0,0:31:44.36,0:31:45.61,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:31:45.73,0:31:47.32,Default,,0,0,0,,Нобита-сан күткендей
Dialogue: 0,0:31:47.44,0:31:48.61,Default,,0,0,0,,Бірінші рет
Dialogue: 0,0:31:48.74,0:31:49.74,Default,,0,0,0,,Бұл Декү.
Dialogue: 0,0:31:50.24,0:31:51.61,Default,,0,0,0,,Темучинге рахмет
Dialogue: 0,0:31:51.78,0:31:56.16,Default,,0,0,0,,Жоқ, Нобита керемет. Мен сізге бұл шумақты беремін.
Dialogue: 0,0:31:56.70,0:31:57.70,Default,,0,0,0,,Рахмет
Dialogue: 0,0:31:57.83,0:31:59.20,Default,,0,0,0,,Менде жақсы
Dialogue: 0,0:31:59.33,0:32:01.21,Default,,0,0,0,,Бірінші мен, мен де
Dialogue: 0,0:32:01.41,0:32:05.54,Default,,0,0,0,,Сонымен Фуко жұмыртқа кезінде тайфунмен ұшып кетті.
Dialogue: 0,0:32:05.96,0:32:08.38,Default,,0,0,0,,Мен оны бірінші таптым.
Dialogue: 0,0:32:08.71,0:32:10.67,Default,,0,0,0,,кейде өз қабілетіңді көрсету керек — тіпті басқаларды құлатып тастауға тура келсе де —
Dialogue: 0,0:32:13.26,0:32:15.64,Default,,0,0,0,,Дора де батпырауық!
Dialogue: 0,0:32:16.72,0:32:18.77,Default,,0,0,0,,Өте жақсы көрініс Уау
Dialogue: 0,0:32:18.89,0:32:22.44,Default,,0,0,0,,Дораэмон шынымен жұмбақ құралға ие.
Dialogue: 0,0:32:25.52,0:32:26.36,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:32:26.61,0:32:28.40,Default,,0,0,0,,Фуко, жүр.
Dialogue: 0,0:32:29.40,0:32:30.99,Default,,0,0,0,,Фуко-чан
Dialogue: 0,0:32:31.11,0:32:32.95,Default,,0,0,0,,Әй, мына тұлып
Dialogue: 0,0:32:33.20,0:32:34.41,Default,,0,0,0,,Ху Хун
Dialogue: 0,0:32:34.57,0:32:37.24,Default,,0,0,0,,Я... Джан Ну... тұлып
Dialogue: 0,0:32:37.37,0:32:38.41,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:32:38.53,0:32:39.83,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:32:39.95,0:32:40.66,Default,,0,0,0,,Хахаха
Dialogue: 0,0:32:40.79,0:32:43.12,Default,,0,0,0,,Жоқ, мен мұны істей алмаймын.
Dialogue: 0,0:32:43.71,0:32:45.75,Default,,0,0,0,,Эй, Фуко-чан, Нобитан-чиден.
Dialogue: 0,0:32:45.88,0:32:48.71,Default,,0,0,0,,Көптеген тағамдар мен комикстер бар.
Dialogue: 0,0:32:49.00,0:32:50.96,Default,,0,0,0,,Ендеше маған кел
Dialogue: 0,0:32:51.09,0:32:52.17,Default,,0,0,0,,Иә
Dialogue: 0,0:32:52.30,0:32:53.55,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:32:54.05,0:32:55.26,Default,,0,0,0,,Раббым!
Dialogue: 0,0:32:55.68,0:32:57.39,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:33:08.44,0:33:09.52,Default,,0,0,0,,Біздің қолжазбалар бөлімінің қызметкерлері
Dialogue: 0,0:33:09.65,0:33:10.48,Default,,0,0,0,,Әрине
Dialogue: 0,0:33:10.61,0:33:11.65,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:33:12.03,0:33:13.28,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:33:13.40,0:33:15.11,Default,,0,0,0,,Қош бол, көріскенше
Dialogue: 0,0:33:15.28,0:33:16.95,Default,,0,0,0,,Фуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:33:17.12,0:33:18.53,Default,,0,0,0,,Фуко мен үйге бара жатырмын
Dialogue: 0,0:33:18.95,0:33:20.45,Default,,0,0,0,,Мен әлі жеткілікті ойнамаған сияқтымын.
Dialogue: 0,0:33:20.58,0:33:22.87,Default,,0,0,0,,Бірақ мен оны осында қалдырам ба деп уайымдап отырмын.
Dialogue: 0,0:33:23.00,0:33:26.50,Default,,0,0,0,,Ууху Нобита-сан Фуко-чанның әкесіне ұқсайды
Dialogue: 0,0:33:26.71,0:33:28.96,Default,,0,0,0,,Ториоз сөмкесі!
Dialogue: 0,0:33:29.50,0:33:31.67,Default,,0,0,0,,Кез келген жерде есікке тапсырыс беріңіз
Dialogue: 0,0:33:32.05,0:33:34.76,Default,,0,0,0,,Есікті осында ұстауға болады.
Dialogue: 0,0:33:34.92,0:33:35.88,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:33:36.43,0:33:39.76,Default,,0,0,0,,Фуко, бірдеңе болып қалса, дереу үйге кел.
Dialogue: 0,0:33:39.89,0:33:40.51,Default,,0,0,0,,Уау
Dialogue: 0,0:33:40.64,0:33:43.68,Default,,0,0,0,,Ғұн һұн һұх хун
Dialogue: 0,0:33:45.64,0:33:46.73,Default,,0,0,0,,Хмм!
Dialogue: 0,0:33:49.77,0:33:50.65,Default,,0,0,0,,Мен қала беремін
Dialogue: 0,0:33:51.40,0:33:53.15,Default,,0,0,0,,Фуко қалса, мен де қалады.
Dialogue: 0,0:33:53.40,0:33:56.40,Default,,0,0,0,,Сіз әлі де солай айтасыз ба? Кәне!
Dialogue: 0,0:33:56.53,0:33:57.99,Default,,0,0,0,,Уау...
Dialogue: 0,0:33:59.87,0:34:06.00,Default,,0,0,0,,(Қасқыр үреді)
Dialogue: 0,0:34:06.54,0:34:08.12,Default,,0,0,0,,Бұл қызықты болды
Dialogue: 0,0:34:08.25,0:34:10.33,Default,,0,0,0,,Ертең кездескенше (Нобита) Иә, ертең кездескенше.
Dialogue: 0,0:34:12.42,0:34:13.30,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:34:21.47,0:34:22.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:29.77,0:34:30.86,Default,,0,0,0,,​​О?
Dialogue: 0,0:34:33.40,0:34:34.32,Default,,0,0,0,,Twyer
Dialogue: 0,0:34:43.03,0:34:44.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:44.99,0:34:46.12,Default,,0,0,0,,Жалпы алғанда, сол хабар тарату мұнарасынан өткеннен кейін сигнал әдетте жақсы болады
Dialogue: 0,0:34:46.45,0:34:48.04,Default,,0,0,0,,Қанша рет айтсаң да түсінбейтін ақымақтар әрқашан болады.
Dialogue: 0,0:34:49.04,0:34:50.29,Default,,0,0,0,,Гун
Dialogue: 0,0:34:51.50,0:34:52.63,Default,,0,0,0,,Хамф, ах
Dialogue: 0,0:34:58.30,0:34:59.22,Default,,0,0,0,,Джотаро Куджо
Dialogue: 0,0:35:14.73,0:35:19.99,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:35:21.20,0:35:24.66,Default,,0,0,0,,Пайдасыз Джанды шақырмауым керек еді.
Dialogue: 0,0:35:24.95,0:35:28.41,Default,,0,0,0,,А, мен қатты ренжідім. Мен сені осы жолы қызметші етіп аламын.
Dialogue: 0,0:35:28.50,0:35:30.04,Default,,0,0,0,,Гааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:35:30.04,0:35:30.92,Default,,0,0,0,,Гяаааааааааааааааааааааааааааа
Dialogue: 0,0:35:30.04,0:35:30.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:30.92,0:35:32.29,Default,,0,0,0,,Гааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:35:32.29,0:35:33.21,Default,,0,0,0,,Гяааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:35:32.29,0:35:33.21,Default,,0,0,0,,Бұл Фуко ма?
Dialogue: 0,0:35:33.21,0:35:34.63,Default,,0,0,0,,Гяааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:35:34.75,0:35:36.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:36.55,0:35:38.84,Default,,0,0,0,,Мүмкін сіз менің артымнан келе жатқан боларсыз?
Dialogue: 0,0:35:39.38,0:35:40.30,Default,,0,0,0,,Фуко
Dialogue: 0,0:35:41.84,0:35:43.05,Default,,0,0,0,,Фуко-чан
Dialogue: 0,0:35:43.18,0:35:45.76,Default,,0,0,0,,(Қасқыр үреді)
Dialogue: 0,0:35:45.93,0:35:49.35,Default,,0,0,0,,Ой, бұл не, қасқыр?
Dialogue: 0,0:35:49.81,0:35:51.39,Default,,0,0,0,,Әй, қасқыр!
Dialogue: 0,0:35:52.73,0:35:53.65,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:35:55.90,0:35:57.44,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:35:57.86,0:35:59.32,Default,,0,0,0,,Не... не?
Dialogue: 0,0:35:59.57,0:36:01.40,Default,,0,0,0,,Бұл сіздің денеңіз.
Dialogue: 0,0:36:01.53,0:36:02.57,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:36:04.12,0:36:05.83,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:36:06.16,0:36:10.20,Default,,0,0,0,,Фуко сол шашыраңқы шарлардың бірі болды.
Dialogue: 0,0:36:10.91,0:36:13.67,Default,,0,0,0,,Мен сол жерге қайта оралуым керек.
Dialogue: 0,0:36:13.88,0:36:16.71,Default,,0,0,0,,Оны кешкі асқа дейін жеткізуге қалай дәтің бар?
Dialogue: 0,0:36:16.84,0:36:19.55,Default,,0,0,0,,Анам адамдарға қатал.
Dialogue: 0,0:36:19.67,0:36:22.05,Default,,0,0,0,,Сіз мұны істейсіз.
Dialogue: 0,0:36:22.80,0:36:23.55,Default,,0,0,0,,Уау
Dialogue: 0,0:36:24.09,0:36:26.35,Default,,0,0,0,,Уау, бұл қауіпті!
Dialogue: 0,0:36:26.64,0:36:30.22,Default,,0,0,0,,О, бұл Сунео емес пе? Ал... күте тұрыңыз.
Dialogue: 0,0:36:30.77,0:36:32.81,Default,,0,0,0,,Неге білмеймін деп тұрсың?
Dialogue: 0,0:36:33.48,0:36:34.27,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:36:35.23,0:36:37.23,Default,,0,0,0,,Шошқа горилласынан қолдарыңызды алыңыз
Dialogue: 0,0:36:37.52,0:36:38.61,Default,,0,0,0,,Не?
Dialogue: 0,0:36:38.73,0:36:41.19,Default,,0,0,0,,Айтшы, жіберейін, шошқа горилла
Dialogue: 0,0:36:41.36,0:36:44.91,Default,,0,0,0,,Сунео, сіз зорлық-зомбылықтан шаршадым деп айттыңыз.
Dialogue: 0,0:36:45.03,0:36:46.07,Default,,0,0,0,,Дәл бүгінге.
Dialogue: 0,0:36:47.62,0:36:48.58,Default,,0,0,0,,Бубубу…
Dialogue: 0,0:36:48.74,0:36:49.83,Default,,0,0,0,,Ураааааа
Dialogue: 0,0:36:50.08,0:36:54.12,Default,,0,0,0,,Ааааааааааааааааааа
Dialogue: 0,0:36:56.79,0:36:57.63,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:36:58.92,0:37:00.09,Default,,0,0,0,,Brrrrrrrrr
Dialogue: 0,0:37:00.67,0:37:02.88,Default,,0,0,0,,және басқа да байланыс құралдарын—өшіріп, сол үстелге қойыңыз.
Dialogue: 0,0:37:21.07,0:37:22.03,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:37:22.40,0:37:23.74,Default,,0,0,0,,Хмм
Dialogue: 0,0:37:23.86,0:37:25.53,Default,,0,0,0,,О, бұл кім?
Dialogue: 0,0:37:25.95,0:37:28.16,Default,,0,0,0,,Дора-чан, кешіріңіз, бірақ ол келмейді.
Dialogue: 0,0:37:28.66,0:37:29.58,Default,,0,0,0,,Иә
Dialogue: 0,0:37:30.83,0:37:32.08,Default,,0,0,0,,Жаман жаман емес
Dialogue: 0,0:37:32.79,0:37:35.08,Default,,0,0,0,,Бұрын бір жерде бір нәрсені ұмытып кетіппін.
Dialogue: 0,0:37:35.21,0:37:37.08,Default,,0,0,0,,Иә, бұл қиын.
Dialogue: 0,0:37:37.38,0:37:40.59,Default,,0,0,0,,Кешіріңіз, бірақ сіз оны өзіңіз ала аласыз ба?
Dialogue: 0,0:37:40.71,0:37:42.21,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:37:42.38,0:37:44.01,Default,,0,0,0,,Сіз кімсіз? Сунео-кун
Dialogue: 0,0:37:44.13,0:37:45.42,Default,,0,0,0,,Мен сенің бір нәрсені ұмытып кеткеніңді естідім.
Dialogue: 0,0:37:45.93,0:37:47.64,Default,,0,0,0,,Хехе, сен ақымақсың.
Dialogue: 0,0:37:48.09,0:37:49.14,Default,,0,0,0,,Хехе
Dialogue: 0,0:37:54.02,0:37:55.06,Default,,0,0,0,,Хехе
Dialogue: 0,0:37:58.40,0:38:00.36,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:38:26.34,0:38:31.30,Default,,0,0,0,,Біз Араши тайпасы бұл күнді қанша күттік?
Dialogue: 0,0:38:32.14,0:38:35.10,Default,,0,0,0,,Осы кулонды қабылдаңыз.
Dialogue: 0,0:38:39.31,0:38:44.36,Default,,0,0,0,,Қуаныңдар, бәрің, Ұлы Ұландар көтерілді.
Dialogue: 0,0:38:44.98,0:38:48.90,Default,,0,0,0,,Дауылды тайпам үшін тағы да даңқ уақыты келеді!
Dialogue: 0,0:38:49.03,0:38:51.07,Default,,0,0,0,,Оу!
Dialogue: 0,0:38:55.70,0:38:59.75,Default,,0,0,0,,(Джианның ауыр тыныс алуы)
Dialogue: 0,0:39:05.50,0:39:08.55,Default,,0,0,0,,Не? Сунео-кун үйде емес пе?
Dialogue: 0,0:39:09.01,0:39:11.26,Default,,0,0,0,,Юбэдегі Сунеода біртүрлі нәрсе бар.
Dialogue: 0,0:39:11.55,0:39:13.26,Default,,0,0,0,,Мен жаңа ғана тоқтадым.
Dialogue: 0,0:39:13.64,0:39:16.22,Default,,0,0,0,,А, сен маған не істедің
Dialogue: 0,0:39:16.47,0:39:18.56,Default,,0,0,0,,Мен ұмытып кеткен нәрсені алу үшін бардым.
Dialogue: 0,0:39:18.77,0:39:21.44,Default,,0,0,0,,Оның қайтып оралғанына сенімді болмады
Dialogue: 0,0:39:22.10,0:39:24.07,Default,,0,0,0,,Дора-чан, тез барайық.
Dialogue: 0,0:39:24.19,0:39:24.98,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:39:25.78,0:39:28.28,Default,,0,0,0,,Дұрыс, кеттік! (Нобита/Джиан) Иә
Dialogue: 0,0:39:33.24,0:39:35.33,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:39:35.66,0:39:36.95,Default,,0,0,0,,Фуко
Dialogue: 0,0:39:37.08,0:39:38.37,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:39:39.96,0:39:42.33,Default,,0,0,0,,Эй Фуко, сен Сунеоны көрмедің бе?
Dialogue: 0,0:39:42.46,0:39:43.50,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:39:43.63,0:39:46.38,Default,,0,0,0,,Бұл рас па? Сіз мұнда келуіңіз керек еді.
Dialogue: 0,0:39:46.88,0:39:48.63,Default,,0,0,0,,Хун Хун
Dialogue: 0,0:39:49.55,0:39:51.18,Default,,0,0,0,,А, солай.
Dialogue: 0,0:39:51.30,0:39:52.13,Default,,0,0,0,,Ах
Dialogue: 0,0:39:52.43,0:39:53.64,Default,,0,0,0,,Араши тайпасы
Dialogue: 0,0:39:58.06,0:40:00.85,Default,,0,0,0,,Ұландардың соңынан ергендер
Dialogue: 0,0:40:00.98,0:40:03.10,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:40:03.31,0:40:04.52,Default,,0,0,0,,Ахх!
Dialogue: 0,0:40:04.65,0:40:05.90,Default,,0,0,0,,Жоқ! күйеу!
Dialogue: 0,0:40:06.02,0:40:06.73,Default,,0,0,0,,!
Dialogue: 0,0:40:06.86,0:40:08.32,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:40:14.16,0:40:16.83,Default,,0,0,0,,Эй Нобита, маған Фуконы берші.
Dialogue: 0,0:40:16.99,0:40:18.24,Default,,0,0,0,,А? (Нобита) Фуко?
Dialogue: 0,0:40:18.83,0:40:20.96,Default,,0,0,0,,Сіз әлі де солай айтасыз ба?
Dialogue: 0,0:40:21.37,0:40:22.92,Default,,0,0,0,,Хе, аузыңды жап, шошқа горилла
Dialogue: 0,0:40:23.08,0:40:24.88,Default,,0,0,0,,Такеши Сунео
Dialogue: 0,0:40:25.00,0:40:26.46,Default,,0,0,0,,Конняроме
Dialogue: 0,0:40:27.21,0:40:29.34,Default,,0,0,0,,Қабыл ал! Фуконы алып кетіңіз
Dialogue: 0,0:40:29.51,0:40:30.55,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:40:31.51,0:40:33.26,Default,,0,0,0,,Увааааааааааааааааааааааа
Dialogue: 0,0:40:34.97,0:40:36.89,Default,,0,0,0,,Бірдеңе бар ма? Бірдеңе бар ма?
Dialogue: 0,0:40:37.76,0:40:39.68,Default,,0,0,0,,Ол өте қатыгез.
Dialogue: 0,0:40:39.81,0:40:40.98,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:40:41.10,0:40:43.31,Default,,0,0,0,,Кішкентай шабақтарды жалғыз қалдырыңыз (Боран) Иә
Dialogue: 0,0:40:43.73,0:40:45.86,Default,,0,0,0,,Ух... Яй Сунео
Dialogue: 0,0:40:45.98,0:40:46.65,Default,,0,0,0,,Ұландер мырза
Dialogue: 0,0:40:47.19,0:40:48.61,Default,,0,0,0,,Сунео, оян
Dialogue: 0,0:40:49.40,0:40:51.07,Default,,0,0,0,,Мен ояумын
Dialogue: 0,0:40:52.36,0:40:54.03,Default,,0,0,0,,Ура уа уа уа уә
Dialogue: 0,0:40:54.16,0:40:55.57,Default,,0,0,0,,Арья!
Dialogue: 0,0:40:55.82,0:40:57.78,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:40:57.95,0:40:58.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:00.12,0:41:02.58,Default,,0,0,0,,Тацумаки Строу!
Dialogue: 0,0:41:03.12,0:41:05.04,Default,,0,0,0,,Иә Нобита-кун (Нобита) Йоши
Dialogue: 0,0:41:10.55,0:41:12.13,Default,,0,0,0,,Уау (Нобита/Шидзука) Уау
Dialogue: 0,0:41:12.26,0:41:13.59,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:41:15.72,0:41:17.34,Default,,0,0,0,,Иә, ұятсыз
Dialogue: 0,0:41:17.64,0:41:19.89,Default,,0,0,0,,Фуджин фанаты!
Dialogue: 0,0:41:20.60,0:41:21.39,Default,,0,0,0,,А, анау, анау, анау, анау.
Dialogue: 0,0:41:21.39,0:41:23.23,Default,,0,0,0,,А, анау, анау, анау, анау.
Dialogue: 0,0:41:21.39,0:41:23.23,Default,,0,0,0,,Васшои Васшои Васшои Васшои
Dialogue: 0,0:41:23.23,0:41:23.35,Default,,0,0,0,,Васшои Васшои Васшои Васшои
Dialogue: 0,0:41:23.35,0:41:26.60,Default,,0,0,0,,Васшои Васшои Васшои Васшои
Dialogue: 0,0:41:23.35,0:41:26.60,Default,,0,0,0,,Иә? Ах, мен қателік жасадым. Бұл фестивальдің жанкүйері болды.
Dialogue: 0,0:41:26.60,0:41:26.73,Default,,0,0,0,,Иә? Ах, мен қателік жасадым. Бұл фестивальдің жанкүйері болды.
Dialogue: 0,0:41:26.73,0:41:27.94,Default,,0,0,0,,Иә? Ах, мен қателік жасадым. Бұл фестивальдің жанкүйері болды.
Dialogue: 0,0:41:26.73,0:41:27.94,Default,,0,0,0,,Васшои Васшои Васшои Васшои
Dialogue: 0,0:41:27.94,0:41:28.06,Default,,0,0,0,,Васшои Васшои Васшои Васшои
Dialogue: 0,0:41:28.06,0:41:30.94,Default,,0,0,0,,Васшои Васшои Васшои Васшои
Dialogue: 0,0:41:28.06,0:41:30.94,Default,,0,0,0,,Васшои вашой
Dialogue: 0,0:41:31.69,0:41:33.57,Default,,0,0,0,,Олар не істеп жатыр?
Dialogue: 0,0:41:33.90,0:41:35.91,Default,,0,0,0,,Уф... бұл қиын.
Dialogue: 0,0:41:36.20,0:41:38.49,Default,,0,0,0,,Ұлы айдаһар
Dialogue: 0,0:41:38.99,0:41:43.75,Default,,0,0,0,,Тынысыңызбен жерді жабыңыз!
Dialogue: 0,0:41:54.76,0:41:56.09,Default,,0,0,0,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:41:56.22,0:41:57.47,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:41:57.72,0:41:58.93,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:41:59.30,0:42:02.22,Default,,0,0,0,,Не... Мен ештеңе көрмеймін.
Dialogue: 0,0:42:03.43,0:42:04.81,Default,,0,0,0,,Хокс та керемет болды.
Dialogue: 0,0:42:05.68,0:42:08.23,Default,,0,0,0,,Нобита-кун Шизука-чан
Dialogue: 0,0:42:08.44,0:42:10.36,Default,,0,0,0,,Нобита-сан қайда орналасқан?
Dialogue: 0,0:42:10.73,0:42:13.82,Default,,0,0,0,,Фуко Фуко
Dialogue: 0,0:42:15.19,0:42:16.53,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:42:16.86,0:42:19.20,Default,,0,0,0,,Фуко (Фуко) Фууууууууун
Dialogue: 0,0:42:21.41,0:42:26.33,Default,,0,0,0,,Мен оны ақыры ұстап алдым Хэхехехехе...
Dialogue: 0,0:42:27.33,0:42:29.38,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:42:29.50,0:42:30.25,Default,,0,0,0,,Хмм
Dialogue: 0,0:42:30.38,0:42:34.88,Default,,0,0,0,,Тышқан Уау... О, жоқ...
Dialogue: 0,0:42:39.05,0:42:45.06,Default,,0,0,0,,Хехехе... Мысық тәріздес робот, мен сенің жолыңа бұлай бола алмаймын.
Dialogue: 0,0:42:45.85,0:42:50.27,Default,,0,0,0,,Дораемон, тұман сейілді.
Dialogue: 0,0:42:50.98,0:42:52.27,Default,,0,0,0,,Фуко
Dialogue: 0,0:42:52.48,0:42:53.69,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:42:54.69,0:42:56.53,Default,,0,0,0,,Шизука-чан Дора-чан
Dialogue: 0,0:42:56.65,0:42:58.49,Default,,0,0,0,,Е, Дораемон, мықты бол.
Dialogue: 0,0:42:58.61,0:42:59.95,Default,,0,0,0,,Не...не...не...тышқан
Dialogue: 0,0:43:00.07,0:43:02.20,Default,,0,0,0,,Жаса... Дораемон!
Dialogue: 0,0:43:03.03,0:43:04.95,Default,,0,0,0,,О, Дора-чан, қалтаң ше?
Dialogue: 0,0:43:05.12,0:43:08.58,Default,,0,0,0,,Не? Ах! ұрланған
Dialogue: 0,0:43:09.21,0:43:10.37,Default,,0,0,0,,А-ли
Dialogue: 0,0:43:10.50,0:43:15.34,Default,,0,0,0,,Қалтасыз, мен қарапайым роботпын...
Dialogue: 0,0:43:15.80,0:43:20.05,Default,,0,0,0,,Сабыр ет, үйге келсем бос қалтам бар.
Dialogue: 0,0:43:20.68,0:43:22.09,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:43:22.30,0:43:23.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:43:24.51,0:43:25.93,Default,,0,0,0,,Барлық жерде есіктер
Dialogue: 0,0:43:26.06,0:43:28.43,Default,,0,0,0,,Мен бұлай үйге бара алмаймын.
Dialogue: 0,0:43:28.98,0:43:31.06,Default,,0,0,0,,Оны біреу бұзған сияқты.
Dialogue: 0,0:43:31.19,0:43:31.90,Default,,0,0,0,,Иә
Dialogue: 0,0:43:32.15,0:43:35.57,Default,,0,0,0,,Дұрыс Фуко Фуко
Dialogue: 0,0:43:37.15,0:43:39.15,Default,,0,0,0,,Нобита
Dialogue: 0,0:43:40.57,0:43:41.53,Default,,0,0,0,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:43:42.16,0:43:43.32,Default,,0,0,0,,Фуко мұнда жоқ.
Dialogue: 0,0:43:43.70,0:43:45.95,Default,,0,0,0,,А, енді ойлап қарасам, Такеши мырза ше?
Dialogue: 0,0:43:46.08,0:43:50.33,Default,,0,0,0,,Әй, екеуін де араши тайпасы алған.
Dialogue: 0,0:43:50.71,0:43:52.00,Default,,0,0,0,,Араши тайпасына?
Dialogue: 0,0:43:52.12,0:43:54.63,Default,,0,0,0,,Темүжін Дауыл тайпасы қайда?
Dialogue: 0,0:43:55.25,0:43:58.34,Default,,0,0,0,,Бұл алқаптың арғы жағында. Мен сізге жол көрсетемін.
Dialogue: 0,0:43:59.21,0:44:00.09,Default,,0,0,0,,Кеттік
Dialogue: 0,0:44:01.13,0:44:01.84,Default,,0,0,0,,барлығын бірге орналастырыңыз.
Dialogue: 0,0:44:02.72,0:44:04.80,Default,,0,0,0,,Қазір барсам, қамауға алатын сияқтымын.
Dialogue: 0,0:44:05.01,0:44:06.93,Default,,0,0,0,,Ал сен дәл солай киінгенсің...
Dialogue: 0,0:44:07.06,0:44:09.27,Default,,0,0,0,,Әйтеуір, күннің батуын күтейік.
Dialogue: 0,0:44:09.85,0:44:10.98,Default,,0,0,0,,Фуко
Dialogue: 0,0:44:11.14,0:44:12.65,Default,,0,0,0,,Такеши мырза
Dialogue: 0,0:44:12.77,0:44:15.36,Default,,0,0,0,,Сунео-кун
Dialogue: 0,0:44:28.87,0:44:34.88,Default,,0,0,0,,(Дауыл тайпасының дыбысы)
Dialogue: 0,0:44:43.93,0:44:47.81,Default,,0,0,0,,Ұландер мырза, бізде қазір бәрі бар.
Dialogue: 0,0:44:48.47,0:44:53.89,Default,,0,0,0,,Сізге тек «Махуга допты» алып, оны сиқырыңызбен жандандыру жеткілікті.
Dialogue: 0,0:44:54.02,0:44:56.52,Default,,0,0,0,,Бұл араши тайпасының жері...
Dialogue: 0,0:44:56.86,0:45:02.44,Default,,0,0,0,,Дауыл Сен де өте зұлымсың хахаха...
Dialogue: 0,0:45:04.07,0:45:05.86,Default,,0,0,0,,Ертең кетеді
Dialogue: 0,0:45:05.99,0:45:06.82,Default,,0,0,0,,Хмм
Dialogue: 0,0:45:16.25,0:45:19.13,Default,,0,0,0,,(Дауыл тайпасының дыбысы)
Dialogue: 0,0:45:22.92,0:45:25.59,Default,,0,0,0,,Мен Дора де Кайтоны артта қалдырғаныма қуаныштымын.
Dialogue: 0,0:45:25.76,0:45:27.97,Default,,0,0,0,,Ішіне жасырын кіріп кету тым байқалмайды ма?
Dialogue: 0,0:45:28.10,0:45:29.76,Default,,0,0,0,,Хехехе
Dialogue: 0,0:45:33.52,0:45:34.39,Default,,0,0,0,,Міне.
Dialogue: 0,0:45:44.19,0:45:47.16,Default,,0,0,0,,(Дауыл тайпасының дыбысы)
Dialogue: 0,0:45:51.16,0:45:52.74,Default,,0,0,0,,Жақсы өтті (Нобита) хаха хаа
Dialogue: 0,0:45:53.12,0:45:55.16,Default,,0,0,0,,Джан мен Фуко қайда?
Dialogue: 0,0:45:56.29,0:45:58.88,Default,,0,0,0,,Бұл жерде құлыптаулы болуы мүмкін.
Dialogue: 0,0:46:01.00,0:46:03.80,Default,,0,0,0,,Сторм-сама пайда болғаннан бері...
Dialogue: 0,0:46:03.92,0:46:06.97,Default,,0,0,0,,Дауыл тайпасының империясы мұнша тез келеді деп ойламадым.
Dialogue: 0,0:46:07.09,0:46:09.01,Default,,0,0,0,,Бұл шынымен де үлкен мәселе.
Dialogue: 0,0:46:13.52,0:46:15.06,Default,,0,0,0,,Ха… Ха…
Dialogue: 0,0:46:16.81,0:46:17.85,Default,,0,0,0,,Бұл кім? (Нобита) О, кетті.
Dialogue: 0,0:46:17.98,0:46:21.61,Default,,0,0,0,,Қаш! Әй... қалтам болса ғой
Dialogue: 0,0:46:24.36,0:46:25.86,Default,,0,0,0,,Хехехе
Dialogue: 0,0:46:26.40,0:46:27.57,Default,,0,0,0,,Ой
Dialogue: 0,0:46:29.41,0:46:30.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:31.49,0:46:33.49,Default,,0,0,0,,О, бұл.
Dialogue: 0,0:46:36.16,0:46:37.75,Default,,0,0,0,,Аххххх
Dialogue: 0,0:46:38.25,0:46:39.25,Default,,0,0,0,,Ау, ауырып тұр...
Dialogue: 0,0:46:39.37,0:46:41.25,Default,,0,0,0,,Шизука-чан, жақсысың ба?
Dialogue: 0,0:46:41.38,0:46:43.34,Default,,0,0,0,,Уау, уау, Нобита-сан
Dialogue: 0,0:46:44.38,0:46:46.72,Default,,0,0,0,,Нобита-кун Нобита-кун
Dialogue: 0,0:46:46.84,0:46:48.63,Default,,0,0,0,,Біреу қақпанға түсіп қалды.
Dialogue: 0,0:46:49.38,0:46:50.30,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:46:50.80,0:46:51.55,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:46:52.51,0:46:53.60,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:46:53.72,0:46:55.31,Default,,0,0,0,,Қазір емес. Кәне.
Dialogue: 0,0:46:58.02,0:46:58.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:00.52,0:47:01.48,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:47:01.86,0:47:03.73,Default,,0,0,0,,Джан Такеши
Dialogue: 0,0:47:04.07,0:47:05.48,Default,,0,0,0,,Тыныш
Dialogue: 0,0:47:05.61,0:47:09.32,Default,,0,0,0,,Мен Сунео туралы бірдеңе істеу үшін Араши тайпасына қосылдым.
Dialogue: 0,0:47:09.45,0:47:10.86,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:47:11.41,0:47:13.41,Default,,0,0,0,,Барлығы, шығу осында. Асығыңыз.
Dialogue: 0,0:47:13.62,0:47:15.37,Default,,0,0,0,,Бірақ Нобита-сан
Dialogue: 0,0:47:15.49,0:47:16.91,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:47:17.33,0:47:20.37,Default,,0,0,0,,Ақсақал жел диірменінде кездесейік, жарай ма?
Dialogue: 0,0:47:20.50,0:47:21.79,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,0:47:22.29,0:47:23.38,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:47:24.88,0:47:26.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:26.84,0:47:29.13,Default,,0,0,0,,Эй, мұнда біреу келді ме?
Dialogue: 0,0:47:29.42,0:47:31.34,Default,,0,0,0,,Ол сол жаққа кеткен сияқты.
Dialogue: 0,0:47:31.80,0:47:33.10,Default,,0,0,0,,Жарайды, ана жақта.
Dialogue: 0,0:47:34.35,0:47:37.35,Default,,0,0,0,,Хмм хи хи о
Dialogue: 0,0:47:38.18,0:47:41.14,Default,,0,0,0,,Әй, иә! Ах!
Dialogue: 0,0:47:42.10,0:47:43.36,Default,,0,0,0,,Фуко!
Dialogue: 0,0:47:44.86,0:47:46.44,Default,,0,0,0,,Фуко
Dialogue: 0,0:47:47.32,0:47:48.32,Default,,0,0,0,,Фуко
Dialogue: 0,0:47:48.74,0:47:51.82,Default,,0,0,0,,Ху-ххун
Dialogue: 0,0:47:52.32,0:47:53.87,Default,,0,0,0,,Фуко, жақсысың ба?
Dialogue: 0,0:47:54.24,0:47:57.62,Default,,0,0,0,,А-а, шу болды.
Dialogue: 0,0:47:58.91,0:48:00.75,Default,,0,0,0,,Бұл оны бұзуы мүмкін.
Dialogue: 0,0:48:01.67,0:48:02.67,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:48:04.54,0:48:05.46,Default,,0,0,0,,Міне!
Dialogue: 0,0:48:05.71,0:48:07.00,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:48:09.13,0:48:09.76,Default,,0,0,0,,Ах
Dialogue: 0,0:48:12.84,0:48:13.80,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:48:14.01,0:48:14.89,Default,,0,0,0,,Фуко
Dialogue: 0,0:48:15.72,0:48:16.39,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:48:16.60,0:48:19.52,Default,,0,0,0,,А, Фуко, мен уайымдадым.
Dialogue: 0,0:48:19.68,0:48:21.64,Default,,0,0,0,,Аа, біреу келе жатыр.
Dialogue: 0,0:48:21.77,0:48:23.60,Default,,0,0,0,,Йоттой…
Dialogue: 0,0:48:24.52,0:48:27.27,Default,,0,0,0,,Осындай кездердің өзінде мен күзетте тұрғаныма сене алар емеспін.
Dialogue: 0,0:48:27.57,0:48:31.07,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:48:31.19,0:48:33.49,Default,,0,0,0,,Щаракачанто ой
Dialogue: 0,0:48:33.86,0:48:36.87,Default,,0,0,0,,О, Дауылды құттықтаймын.
Dialogue: 0,0:48:37.62,0:48:40.58,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:48:43.46,0:48:45.58,Default,,0,0,0,,Фуко, кілтті ал.
Dialogue: 0,0:48:51.67,0:48:53.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:58.18,0:49:00.18,Default,,0,0,0,,Жарайсың, тамаша
Dialogue: 0,0:49:03.60,0:49:04.39,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:49:05.85,0:49:07.23,Default,,0,0,0,,Сәлем! (Нобита) Уф
Dialogue: 0,0:49:07.40,0:49:10.03,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:49:10.15,0:49:11.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:11.94,0:49:13.07,Default,,0,0,0,,Өзгеріс күштері!
Dialogue: 0,0:49:13.36,0:49:15.11,Default,,0,0,0,,Джан (Фуко) Хун
Dialogue: 0,0:49:15.24,0:49:17.28,Default,,0,0,0,,Ауылға баратын жол сол жақта.
Dialogue: 0,0:49:17.78,0:49:20.99,Default,,0,0,0,,Біз Дораемонмен және басқалармен Ақсақал жел диірменінде кездесеміз.
Dialogue: 0,0:49:21.24,0:49:22.12,Default,,0,0,0,,Иә
Dialogue: 0,0:49:22.45,0:49:23.50,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:49:24.46,0:49:25.79,Default,,0,0,0,,О, Джиан ше?
Dialogue: 0,0:49:25.92,0:49:27.29,Default,,0,0,0,,Мен Сунеомен кейін барамын.
Dialogue: 0,0:49:28.29,0:49:30.59,Default,,0,0,0,,Сунеомен бірге ме? Бұл жақсы
Dialogue: 0,0:49:30.75,0:49:31.96,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:49:32.09,0:49:33.26,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:49:34.38,0:49:37.34,Default,,0,0,0,,Тез барайық.
Dialogue: 0,0:49:41.56,0:49:42.97,Default,,0,0,0,,Хмм? (Нобита) Иә?
Dialogue: 0,0:49:43.31,0:49:45.23,Default,,0,0,0,,Бұл қайсысы? (Фуко) Хамф?
Dialogue: 0,0:49:46.44,0:49:49.44,Default,,0,0,0,,О, о... бұл
Dialogue: 0,0:49:50.02,0:49:51.44,Default,,0,0,0,,Хамф
Dialogue: 0,0:49:51.57,0:49:53.36,Default,,0,0,0,,Не болып жатыр? (сарқыраманың дыбысы)
Dialogue: 0,0:49:53.53,0:49:54.74,Default,,0,0,0,,Кім? (Нобита) Иә?
Dialogue: 0,0:49:54.86,0:49:56.95,Default,,0,0,0,,Бұл сарқырама. Сіз сыртқа шыға аласыз.
Dialogue: 0,0:49:57.57,0:49:58.57,Default,,0,0,0,,Кеттік
Dialogue: 0,0:50:10.09,0:50:12.63,Default,,0,0,0,,Бұл жер асты сарқырамасы ма?
Dialogue: 0,0:50:12.92,0:50:16.13,Default,,0,0,0,,...
Dialogue: 0,0:50:16.55,0:50:18.80,Default,,0,0,0,,Сіз адасып кеткен сияқтысыз (Фуко) Хамф
Dialogue: 0,0:50:19.93,0:50:21.39,Default,,0,0,0,,Рахмет Фуко
Dialogue: 0,0:50:24.10,0:50:27.02,Default,,0,0,0,,Күн суытып бара жатқан сияқты.
Dialogue: 0,0:50:27.52,0:50:31.06,Default,,0,0,0,,Бұл жел, келе жатыр, шығуы мүмкін.
Dialogue: 0,0:50:31.19,0:50:32.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:33.15,0:50:33.82,Default,,0,0,0,,Фуко?
Dialogue: 0,0:50:34.40,0:50:36.28,Default,,0,0,0,,Фуко, не болды?
Dialogue: 0,0:50:36.61,0:50:37.53,Default,,0,0,0,,Хмм…
Dialogue: 0,0:50:37.74,0:50:40.82,Default,,0,0,0,,Түсіндім, Фуко суықты ұнатпады.
Dialogue: 0,0:50:41.41,0:50:42.78,Default,,0,0,0,,Бәрібір сыртқа шығайық
Dialogue: 0,0:50:45.87,0:50:48.17,Default,,0,0,0,,Уау, ақыры шықты.
Dialogue: 0,0:50:49.29,0:50:51.54,Default,,0,0,0,,Тайтер айтты
Dialogue: 0,0:50:52.63,0:50:55.88,Default,,0,0,0,,Уау... аа... а...
Dialogue: 0,0:50:58.63,0:51:00.43,Default,,0,0,0,,Уау Фуко
Dialogue: 0,0:51:03.47,0:51:05.22,Default,,0,0,0,,Фуко, қолыңнан келгеннің бәрін істе.
Dialogue: 0,0:51:07.60,0:51:09.02,Default,,0,0,0,,Қай жолмен жүруім керек?
Dialogue: 0,0:51:09.35,0:51:10.98,Default,,0,0,0,,Дораемон
Dialogue: 0,0:51:13.69,0:51:15.48,Default,,0,0,0,,Мен күшті болуым керек
Dialogue: 0,0:51:16.44,0:51:20.07,Default,,0,0,0,,...
Dialogue: 0,0:51:31.96,0:51:33.84,Default,,0,0,0,,Бұл осында. Рақмет сізге.
Dialogue: 0,0:51:34.00,0:51:37.13,Default,,0,0,0,,Ха... аман-есен шықтық.
Dialogue: 0,0:51:37.26,0:51:38.63,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:51:38.76,0:51:42.30,Default,,0,0,0,,Қалай болғанда да, Сунео-кун неліктен араши тайпасына қосылды?
Dialogue: 0,0:51:42.80,0:51:45.10,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:51:45.39,0:51:48.89,Default,,0,0,0,,Ха куку ха куку
Dialogue: 0,0:51:49.02,0:51:50.56,Default,,0,0,0,,...
Dialogue: 0,0:51:51.06,0:51:54.61,Default,,0,0,0,,Кешіріңіз, мен жақсырақ болуым керек еді.
Dialogue: 0,0:51:55.94,0:51:59.49,Default,,0,0,0,,Фуко Мұндай кезде ұйықтамау керек.
Dialogue: 0,0:52:05.20,0:52:06.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:52:07.04,0:52:11.00,Default,,0,0,0,,Нобита-кун, мұндай уақытта ұйықтамау керек.
Dialogue: 0,0:52:11.50,0:52:14.50,Default,,0,0,0,,Дораемон, сен неге маған көмектеспейсің?
Dialogue: 0,0:52:14.84,0:52:17.46,Default,,0,0,0,,Өйткені менің қалтам ұрланған.
Dialogue: 0,0:52:17.84,0:52:20.92,Default,,0,0,0,,Жарайды, мен өзім бірдеңе істеймін.
Dialogue: 0,0:52:21.68,0:52:25.93,Default,,0,0,0,,Керемет, хмм, құралдарға сүйенбей.
Dialogue: 0,0:52:26.56,0:52:29.56,Default,,0,0,0,,Бірақ бірдеңе жасаңыз, тіпті бұл жай Фуко болса да.
Dialogue: 0,0:52:29.68,0:52:32.73,Default,,0,0,0,,Сондықтан анам үй жануарлары болғанды ​​ұнатпайды.
Dialogue: 0,0:52:32.85,0:52:34.94,Default,,0,0,0,,Соңына дейін өзіңді күт
Dialogue: 0,0:52:35.44,0:52:37.15,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:52:53.37,0:52:58.09,Default,,0,0,0,,Бала, мен саған бір нәрсе айтқым келеді.
Dialogue: 0,0:52:58.38,0:53:03.05,Default,,0,0,0,,Мыңдаған жылдар бойы желдің адамдары желді пайдаланып келеді.
Dialogue: 0,0:53:03.17,0:53:07.89,Default,,0,0,0,,Желді басқаруға тырысқан Дауыл тайпасы қақтығысты.
Dialogue: 0,0:53:08.22,0:53:13.39,Default,,0,0,0,,Дауыл тайпасының бақсысы Уландер өзінің қорқынышты дағдыларын ...
Dialogue: 0,0:53:13.60,0:53:19.52,Default,,0,0,0,,Махуга деп аталатын үлкен күшке ие жел құбыжығын жасады.
Dialogue: 0,0:53:20.69,0:53:24.36,Default,,0,0,0,,Махуга қаһарланып, дүние 40 күндік.
Dialogue: 0,0:53:24.61,0:53:26.99,Default,,0,0,0,,Қатты дауылға ұшырады
Dialogue: 0,0:53:27.49,0:53:31.37,Default,,0,0,0,,Жел адамдарының жетекшісі Ноазин Махугаға қарсы шықты.
Dialogue: 0,0:53:41.55,0:53:47.30,Default,,0,0,0,,Тығыздағыш қылышпен Махуга үш бөлікке бөлініп, допқа қамалды.
Dialogue: 0,0:53:47.43,0:53:51.47,Default,,0,0,0,,Жел адамдар Ұландермен бірге екеуін де көрге қойды.
Dialogue: 0,0:53:51.64,0:53:55.48,Default,,0,0,0,,Екіншісі қылышпен мәңгілікке мөрленді.
Dialogue: 0,0:53:55.69,0:53:59.15,Default,,0,0,0,,Бірақ қабірді Дауыл тайпасы ашты...
Dialogue: 0,0:53:59.27,0:54:02.03,Default,,0,0,0,,Екі доп өмірге келді.
Dialogue: 0,0:54:02.73,0:54:06.86,Default,,0,0,0,,Мүмкін олардың бірі Фуко шығар?
Dialogue: 0,0:54:06.99,0:54:08.41,Default,,0,0,0,,А... Иә.
Dialogue: 0,0:54:08.53,0:54:12.62,Default,,0,0,0,,Фуко: Ааа, құтқарылғанымызға қуаныштымын.
Dialogue: 0,0:54:12.87,0:54:14.00,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:54:14.45,0:54:17.42,Default,,0,0,0,,Балалар сендер маған көмектестіңдер, рахмет.
Dialogue: 0,0:54:18.00,0:54:19.46,Default,,0,0,0,,Ал енді сіздің армандарыңыз ше?
Dialogue: 0,0:54:19.58,0:54:21.17,Default,,0,0,0,,Мен (Нобита) Иә?
Dialogue: 0,0:54:22.05,0:54:23.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:54:23.55,0:54:27.43,Default,,0,0,0,,Қорқудың қажеті жоқ. Менің атым Яак.
Dialogue: 0,0:54:27.80,0:54:30.55,Default,,0,0,0,,Жүрегіңе тіке айттым.
Dialogue: 0,0:54:31.01,0:54:33.10,Default,,0,0,0,,Сонда басқа доп қайда?
Dialogue: 0,0:54:33.47,0:54:36.23,Default,,0,0,0,,Боран тайпасының қолына түсті
Dialogue: 0,0:54:37.06,0:54:38.56,Default,,0,0,0,,Фукомен не болады?
Dialogue: 0,0:54:38.94,0:54:41.40,Default,,0,0,0,,Егер бәрі бұрынғыдай болса, алаңдаудың қажеті жоқ.
Dialogue: 0,0:54:41.65,0:54:44.65,Default,,0,0,0,,А, жақсы. (Фууко) Хамф.
Dialogue: 0,0:54:44.78,0:54:48.53,Default,,0,0,0,,Оңтүстік аралда картоп қылышпен жабылған.
Dialogue: 0,0:54:48.66,0:54:51.41,Default,,0,0,0,,Қалған шарларға жақындамаңыз
Dialogue: 0,0:54:51.62,0:54:55.16,Default,,0,0,0,,Бала, сен ғана Фуконы қорғай аласың.
Dialogue: 0,0:54:55.37,0:54:56.58,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:54:57.41,0:54:59.54,Default,,0,0,0,,Оған ешқашан жақындамаңыз.
Dialogue: 0,0:54:59.83,0:55:00.58,Default,,0,0,0,,Иә
Dialogue: 0,0:55:01.00,0:55:04.21,Default,,0,0,0,,Бүгін түнде демалуға болады.
Dialogue: 0,0:55:04.42,0:55:05.26,Default,,0,0,0,,Иә
Dialogue: 0,0:55:16.93,0:55:20.23,Default,,0,0,0,,Сізге көп рахмет, сау болыңыз.
Dialogue: 0,0:55:21.44,0:55:23.61,Default,,0,0,0,,Яак мырзаға сәлем айтыңыз.
Dialogue: 0,0:55:23.82,0:55:25.19,Default,,0,0,0,,Олай болса, Фуко, кеттік.
Dialogue: 0,0:55:25.32,0:55:26.99,Default,,0,0,0,,Фуфу (Нобита) Уфуфуфу
Dialogue: 0,0:55:30.53,0:55:32.91,Default,,0,0,0,,Барлығы күтеді, иә?
Dialogue: 0,0:55:33.70,0:55:34.95,Default,,0,0,0,,Иә
Dialogue: 0,0:55:39.50,0:55:43.59,Default,,0,0,0,,Әдепсіз жырау, барып Фуконы алып кел.
Dialogue: 0,0:55:45.09,0:55:47.51,Default,,0,0,0,,Ах аа ахахахах
Dialogue: 0,0:55:47.71,0:55:49.26,Default,,0,0,0,,Хун хун?
Dialogue: 0,0:55:49.38,0:55:50.55,Default,,0,0,0,,Бум
Dialogue: 0,0:55:50.72,0:55:51.84,Default,,0,0,0,,Фуко
Dialogue: 0,0:55:53.47,0:55:54.55,Default,,0,0,0,,Фуко
Dialogue: 0,0:55:57.22,0:55:58.52,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:55:59.93,0:56:03.10,Default,,0,0,0,,Жүр, оңтүстік аралға бірге барайық.
Dialogue: 0,0:56:04.23,0:56:07.03,Default,,0,0,0,,Сунео, Фуконы қайтар
Dialogue: 0,0:56:07.40,0:56:08.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:16.58,0:56:17.79,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:56:27.75,0:56:29.92,Default,,0,0,0,,Дораемон
Dialogue: 0,0:56:32.97,0:56:37.31,Default,,0,0,0,,Иә? Бұл Нұхтың ұлы топан суы туралы емес пе?
Dialogue: 0,0:56:37.89,0:56:40.31,Default,,0,0,0,,Бірақ бұл Киелі кітаптағы оқиға, солай емес пе?
Dialogue: 0,0:56:40.60,0:56:42.06,Default,,0,0,0,,Алайда, шын мәнінде...
Dialogue: 0,0:56:42.35,0:56:45.94,Default,,0,0,0,,Үлкен су тасқынының іздері табылды.
Dialogue: 0,0:56:46.48,0:56:48.19,Default,,0,0,0,,Эй... Мен бірдеңе істеуім керек.
Dialogue: 0,0:56:48.53,0:56:50.32,Default,,0,0,0,,Махуга қайта тірілгенде —
Dialogue: 0,0:56:50.82,0:56:53.99,Default,,0,0,0,,Нұхтың ұлы топан суы жер бетінде қайтадан болады.
Dialogue: 0,0:56:54.66,0:56:58.37,Default,,0,0,0,,Дораэмон Фуко мен Сунеоны қайтарып алайық.
Dialogue: 0,0:56:58.83,0:57:00.62,Default,,0,0,0,,Мен де Таке-сан үшін алаңдаймын.
Dialogue: 0,0:57:00.95,0:57:02.50,Default,,0,0,0,,Сіз айттыңыз -
Dialogue: 0,0:57:02.62,0:57:06.08,Default,,0,0,0,,Оңтүстік аралдың қай жерде екенін білмеймін.
Dialogue: 0,0:57:08.09,0:57:11.88,Default,,0,0,0,,(Дауыл тайпасының қорылдауы)
Dialogue: 0,0:57:12.01,0:57:14.76,Default,,0,0,0,,Дауылды уау
Dialogue: 0,0:57:17.18,0:57:18.47,Default,,0,0,0,,Рюгаку аралы
Dialogue: 0,0:57:18.64,0:57:19.72,Default,,0,0,0,,Иә
Dialogue: 0,0:57:20.10,0:57:21.81,Default,,0,0,0,,Үлкендер біле ме?
Dialogue: 0,0:57:22.06,0:57:25.77,Default,,0,0,0,,Онда қылышпен мөрленген доп бар.
Dialogue: 0,0:57:26.02,0:57:27.23,Default,,0,0,0,,Фуко да сонда ма?
Dialogue: 0,0:57:28.82,0:57:30.90,Default,,0,0,0,,Темүжин Барлығын жина.
Dialogue: 0,0:57:31.07,0:57:31.78,Default,,0,0,0,,Иә
Dialogue: 0,0:57:31.90,0:57:34.95,Default,,0,0,0,,Канжин жел кемесі
Dialogue: 0,0:57:35.41,0:57:37.37,Default,,0,0,0,,Асықпа (Кандзин Тэмүжин) Иә.
Dialogue: 0,0:57:43.37,0:57:48.08,Default,,0,0,0,,Жел адамдарының атынан Махуга қайта тірілмеуі керек.
Dialogue: 0,0:57:48.54,0:57:52.13,Default,,0,0,0,,Қазір жел кемесі қозғалатын кез
Dialogue: 0,0:57:52.26,0:57:55.22,Default,,0,0,0,,Ооо
Dialogue: 0,0:58:12.73,0:58:14.74,Default,,0,0,0,,Жел кемесі дегеніміз не?
Dialogue: 0,0:58:16.78,0:58:18.53,Default,,0,0,0,,Уф
Dialogue: 0,0:58:22.70,0:58:24.54,Default,,0,0,0,,Уау, үлкен
Dialogue: 0,0:58:27.04,0:58:28.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:31.50,0:58:33.76,Default,,0,0,0,,Бұл жел кемесі
Dialogue: 0,0:58:37.68,0:58:39.47,Default,,0,0,0,,Желкенді жібер!
Dialogue: 0,0:58:39.93,0:58:43.72,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:58:52.69,0:58:54.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:56.11,0:58:57.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:16.42,0:59:17.38,Default,,0,0,0,,Хехе
Dialogue: 0,0:59:22.01,0:59:23.68,Default,,0,0,0,,А, бұл арал.
Dialogue: 0,0:59:23.81,0:59:24.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:29.19,0:59:30.60,Default,,0,0,0,,Уау, жел
Dialogue: 0,0:59:32.69,0:59:33.57,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:59:34.07,0:59:36.78,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:59:37.65,0:59:38.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:59:38.61,0:59:40.74,Default,,0,0,0,,Біртүрлі, жел соқты.
Dialogue: 0,0:59:41.57,0:59:44.99,Default,,0,0,0,,Түсіндім, біз экваторлық күйзеліске кірдік.
Dialogue: 0,0:59:46.04,0:59:49.04,Default,,0,0,0,,О, қарашы, бұл Айдаһар аралы!
Dialogue: 0,0:59:49.46,0:59:50.50,Default,,0,0,0,,Иә
Dialogue: 0,0:59:59.09,1:00:03.72,Default,,0,0,0,,Мен Махуганы тірілтетін осы сәтті көптен күттім.
Dialogue: 0,1:00:04.22,1:00:07.02,Default,,0,0,0,,Тыңда, Фуконың қашып кетуіне жол бере алмайсың.
Dialogue: 0,1:00:07.14,1:00:08.18,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,1:00:12.23,1:00:14.40,Default,,0,0,0,,Мен Сунеоның соңынан еремін.
Dialogue: 0,1:00:14.94,1:00:17.65,Default,,0,0,0,,Нобита-кун мен оның достары Фуконы ала алды
Dialogue: 0,1:00:17.78,1:00:18.48,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:00:18.82,1:00:22.16,Default,,0,0,0,,Жарайсың ба? Менде құрал жоқ, бірақ жер тағдыры...
Dialogue: 0,1:00:22.28,1:00:24.07,Default,,0,0,0,,Бұл өзімізге байланысты
Dialogue: 0,1:00:24.32,1:00:25.12,Default,,0,0,0,,Иә, иә
Dialogue: 0,1:00:26.03,1:00:27.16,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,1:00:29.62,1:00:34.13,Default,,0,0,0,,Ха жақсы ха ха жақсы
Dialogue: 0,1:00:37.30,1:00:39.88,Default,,0,0,0,,Оишо Оишо
Dialogue: 0,1:00:44.34,1:00:46.51,Default,,0,0,0,,Жақсы жұмыс...
Dialogue: 0,1:00:46.76,1:00:48.26,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:00:49.18,1:00:51.02,Default,,0,0,0,,Абайлаңыз, Дораемон
Dialogue: 0,1:00:52.06,1:00:54.69,Default,,0,0,0,,Уау алпауыт тым-тырыс
Dialogue: 0,1:00:55.69,1:00:56.94,Default,,0,0,0,,Рахмет
Dialogue: 0,1:01:08.20,1:01:09.79,Default,,0,0,0,,Фуко, күте тұрыңыз.
Dialogue: 0,1:01:12.00,1:01:15.88,Default,,0,0,0,,Әй, бұл қалпақ Доремонның төрт өлшемді қалтасы.
Dialogue: 0,1:01:16.00,1:01:17.09,Default,,0,0,0,,Рас
Dialogue: 0,1:01:17.21,1:01:20.05,Default,,0,0,0,,Тэмужин Бум-бумда оны қайтарудың жолы жоқ па?
Dialogue: 0,1:01:20.42,1:01:23.51,Default,,0,0,0,,Арзан жұмыстарды не істейсіз?
Dialogue: 0,1:01:23.63,1:01:24.80,Default,,0,0,0,,Хори, көмектесіп жібересің бе?
Dialogue: 0,1:01:30.43,1:01:32.43,Default,,0,0,0,,Не болды?
Dialogue: 0,1:01:36.19,1:01:39.98,Default,,0,0,0,,Бұл жабық доп. Сол қылышты суырып алсаң, қиналып қаласың.
Dialogue: 0,1:01:40.15,1:01:40.82,Default,,0,0,0,,Қылыш?
Dialogue: 0,1:01:41.57,1:01:42.90,Default,,0,0,0,,Міне, осында
Dialogue: 0,1:01:43.19,1:01:45.91,Default,,0,0,0,,Махуганың қайта тірілген күні келді!
Dialogue: 0,1:01:46.66,1:01:48.57,Default,,0,0,0,,Тоқта, Сунео.
Dialogue: 0,1:01:48.70,1:01:50.33,Default,,0,0,0,,Уф, сен не істеп жатырсың?
Dialogue: 0,1:01:50.54,1:01:56.50,Default,,0,0,0,,Қалыптыға оралыңыз, Сунео, қалыпты жағдайға оралыңыз. Уф...
Dialogue: 0,1:01:56.62,1:01:59.29,Default,,0,0,0,,Менің шошқа гориллам
Dialogue: 0,1:02:00.17,1:02:01.38,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,1:02:02.09,1:02:04.38,Default,,0,0,0,,Ура! (2 адам) Уау, о
Dialogue: 0,1:02:04.84,1:02:06.72,Default,,0,0,0,,Хессунео
Dialogue: 0,1:02:06.84,1:02:08.39,Default,,0,0,0,,Ууааааааа
Dialogue: 0,1:02:08.51,1:02:10.14,Default,,0,0,0,,Сунео, тоқтат.
Dialogue: 0,1:02:10.26,1:02:12.35,Default,,0,0,0,,Сіз Сунеокун емессіз.
Dialogue: 0,1:02:12.77,1:02:14.89,Default,,0,0,0,,Сунео, менің әнімді тыңда
Dialogue: 0,1:02:15.02,1:02:15.77,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:15.89,1:02:18.31,Default,,0,0,0,,Артқа оралу
Dialogue: 0,1:02:20.23,1:02:22.32,Default,,0,0,0,,♪ Мен Джанмын
Dialogue: 0,1:02:22.32,1:02:23.53,Default,,0,0,0,,♪ Мен Джанмын
Dialogue: 0,1:02:22.32,1:02:23.53,Default,,0,0,0,,Қарқынды
Dialogue: 0,1:02:23.53,1:02:23.78,Default,,0,0,0,,Қарқынды
Dialogue: 0,1:02:23.78,1:02:24.36,Default,,0,0,0,,Қарқынды
Dialogue: 0,1:02:23.78,1:02:24.36,Default,,0,0,0,,♪ Гаки генералы
Dialogue: 0,1:02:24.36,1:02:25.19,Default,,0,0,0,,♪ Гаки генералы
Dialogue: 0,1:02:25.19,1:02:26.40,Default,,0,0,0,,♪ Гаки генералы
Dialogue: 0,1:02:25.19,1:02:26.40,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:26.65,1:02:32.54,Default,,0,0,0,,♪ Ол жеңілмейтін адам.
Dialogue: 0,1:02:33.62,1:02:34.54,Default,,0,0,0,,Ei
Dialogue: 0,1:02:34.87,1:02:35.83,Default,,0,0,0,,Ах!
Dialogue: 0,1:02:37.33,1:02:38.17,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,1:02:41.67,1:02:42.84,Default,,0,0,0,,Сунео
Dialogue: 0,1:02:44.59,1:02:46.26,Default,,0,0,0,,А, а...
Dialogue: 0,1:02:46.38,1:02:47.88,Default,,0,0,0,,Сунео... Сунео...
Dialogue: 0,1:02:50.01,1:02:52.47,Default,,0,0,0,,Хехехе
Dialogue: 0,1:03:01.69,1:03:03.86,Default,,0,0,0,,Ах, қалпақ
Dialogue: 0,1:03:04.90,1:03:06.44,Default,,0,0,0,,Эй, күт, қалпақ
Dialogue: 0,1:03:06.57,1:03:09.20,Default,,0,0,0,,(Дауыл тайпасының күлкісі)
Dialogue: 0,1:03:18.37,1:03:19.67,Default,,0,0,0,,Иә? (Нобита) О, менің!
Dialogue: 0,1:03:22.84,1:03:23.67,Default,,0,0,0,,Бұл сигнал.
Dialogue: 0,1:03:24.42,1:03:26.13,Default,,0,0,0,,Мешіт гранатасы!
Dialogue: 0,1:03:27.01,1:03:28.09,Default,,0,0,0,,Иә, солай.
Dialogue: 0,1:03:29.97,1:03:32.09,Default,,0,0,0,,Уау!
Dialogue: 0,1:03:35.31,1:03:36.52,Default,,0,0,0,,Фуко
Dialogue: 0,1:03:39.14,1:03:40.56,Default,,0,0,0,,Нобита Фуко
Dialogue: 0,1:03:40.90,1:03:44.61,Default,,0,0,0,,А? Күте тұрыңыз, бұл жай ғана қауіп. Күте тұрыңыз!
Dialogue: 0,1:03:44.86,1:03:47.78,Default,,0,0,0,,Бірдеңе бар ма?
Dialogue: 0,1:03:47.94,1:03:49.24,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:03:49.86,1:03:52.49,Default,,0,0,0,,Сонымен... Бұл не?
Dialogue: 0,1:03:52.62,1:03:53.91,Default,,0,0,0,,Әй, қаш.
Dialogue: 0,1:03:55.33,1:03:56.74,Default,,0,0,0,,Оо?
Dialogue: 0,1:03:57.04,1:03:58.75,Default,,0,0,0,,Бұл қандай қорап?
Dialogue: 0,1:03:59.66,1:04:01.04,Default,,0,0,0,,(Дауыл тайпасының айқайы)
Dialogue: 0,1:04:03.67,1:04:06.71,Default,,0,0,0,,Хахаха Бұл Цузура елесі еді.
Dialogue: 0,1:04:06.84,1:04:08.80,Default,,0,0,0,,Барлығы (Нобита) Ах
Dialogue: 0,1:04:09.05,1:04:10.42,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,1:04:11.22,1:04:13.97,Default,,0,0,0,,Махуганың добы менің қолымда.
Dialogue: 0,1:04:14.39,1:04:17.93,Default,,0,0,0,,Қазір Махуганың қайта тірілу уақыты!
Dialogue: 0,1:04:18.18,1:04:18.93,Default,,0,0,0,,Ах!
Dialogue: 0,1:04:19.06,1:04:24.44,Default,,0,0,0,,Урина Аринара Вимана
Dialogue: 0,1:04:25.82,1:04:29.78,Default,,0,0,0,,Махуганы тірілт!
Dialogue: 0,1:04:32.41,1:04:33.45,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,1:04:35.74,1:04:38.45,Default,,0,0,0,,Фуко!
Dialogue: 0,1:04:49.63,1:04:51.47,Default,,0,0,0,,Ой
Dialogue: 0,1:04:51.67,1:04:53.89,Default,,0,0,0,,Не болды?
Dialogue: 0,1:05:04.23,1:05:05.98,Default,,0,0,0,,Соңғы жаңалықтар
Dialogue: 0,1:05:06.44,1:05:08.36,Default,,0,0,0,,Экваторда кенеттен пайда болды—
Dialogue: 0,1:05:08.48,1:05:11.78,Default,,0,0,0,,Супер тайфунды метеорологиялық спутник түсірді
Dialogue: 0,1:05:12.32,1:05:13.82,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,1:05:14.61,1:05:16.78,Default,,0,0,0,,Бұл тайфун ең күшті...
Dialogue: 0,1:05:17.03,1:05:17.53,Default,,0,0,0,,Арама
Dialogue: 0,1:05:17.53,1:05:18.24,Default,,0,0,0,,Арама
Dialogue: 0,1:05:17.53,1:05:18.24,Default,,0,0,0,,Болашақ бағытына байланысты айтарлықтай зиян болады деп күтілуде.
Dialogue: 0,1:05:18.24,1:05:21.58,Default,,0,0,0,,Болашақ бағытына байланысты үлкен залал күтіледі.
Dialogue: 0,1:05:27.50,1:05:30.42,Default,,0,0,0,,Сунео, оян, Сунео.
Dialogue: 0,1:05:30.55,1:05:31.67,Default,,0,0,0,,Сунео-кун
Dialogue: 0,1:05:32.01,1:05:33.13,Default,,0,0,0,,Уф...
Dialogue: 0,1:05:33.38,1:05:34.34,Default,,0,0,0,,Ах, Сунео
Dialogue: 0,1:05:34.47,1:05:36.97,Default,,0,0,0,,Сіз байқадыңыз ба? Жақсы
Dialogue: 0,1:05:37.09,1:05:40.06,Default,,0,0,0,,Уф, екеуің не істеп жатырсыңдар?
Dialogue: 0,1:05:40.26,1:05:42.77,Default,,0,0,0,,А, бұл қайда?
Dialogue: 0,1:05:43.06,1:05:46.19,Default,,0,0,0,,Мен Сунео-кун, сол қылышпен кейін түсіндіремін.
Dialogue: 0,1:05:46.77,1:05:48.36,Default,,0,0,0,,Қылышпен не істейсің?
Dialogue: 0,1:05:48.48,1:05:51.28,Default,,0,0,0,,Тамырларды тез кесіңіз.
Dialogue: 0,1:05:52.07,1:05:57.11,Default,,0,0,0,,Не? Сіз маған тапсырыс бересіз бе? «Өтінемін, оны кесіңіз» солай ма?
Dialogue: 0,1:05:57.32,1:05:59.91,Default,,0,0,0,,Сіз Арашизоку тобының құрамында қанша уақыт болдыңыз?
Dialogue: 0,1:06:00.37,1:06:02.04,Default,,0,0,0,,Араши тайпасы?
Dialogue: 0,1:06:03.00,1:06:06.71,Default,,0,0,0,,Неге екенін білмеймін, бірақ мен жақсы түс көргендей болдым
Dialogue: 0,1:06:06.96,1:06:10.75,Default,,0,0,0,,Сунео, тез өшіріп тасташы...
Dialogue: 0,1:06:10.88,1:06:13.80,Default,,0,0,0,,Түсіндім, ой, ой, ой.
Dialogue: 0,1:06:13.97,1:06:16.68,Default,,0,0,0,,Уаааааааааааааа
Dialogue: 0,1:06:17.93,1:06:23.02,Default,,0,0,0,,Ухахаха, Дауыл, менің ұлылығымды көрдің бе?
Dialogue: 0,1:06:23.27,1:06:26.52,Default,,0,0,0,,Бұл араши тайпасының жері.
Dialogue: 0,1:06:28.98,1:06:30.82,Default,,0,0,0,,Еңбегіңізге рахмет, Ұландер!
Dialogue: 0,1:06:31.15,1:06:33.94,Default,,0,0,0,,Бірақ сіздің рөліңіз аяқталды.
Dialogue: 0,1:06:34.24,1:06:35.32,Default,,0,0,0,,Не?
Dialogue: 0,1:06:36.40,1:06:38.78,Default,,0,0,0,,Уау...
Dialogue: 0,1:06:44.08,1:06:47.54,Default,,0,0,0,,А-а, бұл төрт өлшемді пластикалық бөтелке.
Dialogue: 0,1:06:47.75,1:06:49.79,Default,,0,0,0,,Ал бұл НЛО –
Dialogue: 0,1:06:50.00,1:06:51.84,Default,,0,0,0,,Тек осы серверде оғаш дерекқор бар…
Dialogue: 0,1:06:52.46,1:06:54.17,Default,,0,0,0,,Көк дануки пайда болды.
Dialogue: 0,1:06:54.42,1:06:58.47,Default,,0,0,0,,Жоқ, мен мысық тәрізді роботпын. Сен кімсің?
Dialogue: 0,1:06:58.93,1:07:01.22,Default,,0,0,0,,Сізге айтайын, менің атым-
Dialogue: 0,1:07:01.64,1:07:03.39,Default,,0,0,0,,Доктор Дауыл
Dialogue: 0,1:07:03.81,1:07:06.06,Default,,0,0,0,,22 ғасыр археологы
Dialogue: 0,1:07:06.39,1:07:08.56,Default,,0,0,0,,Неліктен 22 ғасырдан?
Dialogue: 0,1:07:08.81,1:07:11.36,Default,,0,0,0,,Мен бұл кулонды таптым.
Dialogue: 0,1:07:11.65,1:07:15.11,Default,,0,0,0,,Мұнда «Мафуға биыл қайта тіріледі»—
Dialogue: 0,1:07:15.48,1:07:17.70,Default,,0,0,0,,Пайғамбарлық ойып жазылған
Dialogue: 0,1:07:17.95,1:07:21.66,Default,,0,0,0,,Егер сіз 22-ғасырдан болсаңыз, онда пайғамбарлық деген сөз жоқ.
Dialogue: 0,1:07:22.03,1:07:25.58,Default,,0,0,0,,Иә, пайғамбарлық орындалмады.
Dialogue: 0,1:07:25.95,1:07:30.08,Default,,0,0,0,,Сондықтан мен осыны жүзеге асыру үшін келдім.
Dialogue: 0,1:07:30.21,1:07:33.17,Default,,0,0,0,,Бұл өте ұятсыз!
Dialogue: 0,1:07:33.54,1:07:36.05,Default,,0,0,0,,Жер шар болады.
Dialogue: 0,1:07:36.55,1:07:39.47,Default,,0,0,0,,Осы ластанған әлемді тазартыңыз.
Dialogue: 0,1:07:39.68,1:07:43.10,Default,,0,0,0,,Мен жаңа дәуір жасаймын.
Dialogue: 0,1:07:43.55,1:07:48.43,Default,,0,0,0,,Махуга, бар күшіңмен жабайы жүр хахаха
Dialogue: 0,1:08:00.45,1:08:02.45,Default,,0,0,0,,Мен оны енді қаламаймын (Нобита және т.б.) Уау
Dialogue: 0,1:08:07.16,1:08:08.79,Default,,0,0,0,,Бұл Махуга ма?
Dialogue: 0,1:08:09.41,1:08:11.62,Default,,0,0,0,,(Дауыл тайпасының үрейлі дауыстары)
Dialogue: 0,1:08:11.79,1:08:13.67,Default,,0,0,0,,Құрметті Дауылды, Ах!
Dialogue: 0,1:08:15.21,1:08:16.30,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,1:08:16.46,1:08:17.59,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,1:08:26.14,1:08:27.97,Default,,0,0,0,,Биік толқындар келе жатыр!
Dialogue: 0,1:08:28.43,1:08:32.19,Default,,0,0,0,,Канджин, барлығы жер бетіне күш береді.
Dialogue: 0,1:08:32.35,1:08:34.23,Default,,0,0,0,,Ооо
Dialogue: 0,1:08:38.23,1:08:40.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:46.08,1:08:47.41,Default,,0,0,0,,Уау
Dialogue: 0,1:08:47.54,1:08:50.45,Default,,0,0,0,,Құрметті Дауыл, маған көмектесіңізші.
Dialogue: 0,1:08:53.67,1:08:56.88,Default,,0,0,0,,Хехехе, енді сендерге пайда жоқ.
Dialogue: 0,1:08:57.00,1:08:59.30,Default,,0,0,0,,(Жел адамдарының үрейлі дауысы)
Dialogue: 0,1:08:59.46,1:09:01.05,Default,,0,0,0,,Ооо аааа
Dialogue: 0,1:09:04.09,1:09:06.01,Default,,0,0,0,,О... аааа
Dialogue: 0,1:09:09.06,1:09:09.97,Default,,0,0,0,,Дораемон
Dialogue: 0,1:09:10.10,1:09:11.52,Default,,0,0,0,,Ооо аааа
Dialogue: 0,1:09:11.64,1:09:13.69,Default,,0,0,0,,Әй, бәрі аман ба?
Dialogue: 0,1:09:15.35,1:09:17.98,Default,,0,0,0,,Бұны кім істеді?
Dialogue: 0,1:09:18.40,1:09:20.32,Default,,0,0,0,,Бұл сенсің. (Сунео) Осымен.
Dialogue: 0,1:09:20.86,1:09:22.70,Default,,0,0,0,,Дораэмон Фуко
Dialogue: 0,1:09:23.24,1:09:25.95,Default,,0,0,0,,Мен білемін, бірақ мен бұл туралы бірдеңе істегім келеді.
Dialogue: 0,1:09:26.41,1:09:28.41,Default,,0,0,0,,Ah Дораэмон қалтасы
Dialogue: 0,1:09:28.58,1:09:32.83,Default,,0,0,0,,А, оны қайтарғаныңызға рахмет.
Dialogue: 0,1:09:33.08,1:09:37.25,Default,,0,0,0,,Жарайды, енді бұл пайдаланылған робот емес.
Dialogue: 0,1:09:37.54,1:09:39.50,Default,,0,0,0,,Дораемон, бірдеңе істе!
Dialogue: 0,1:09:39.63,1:09:42.51,Default,,0,0,0,,Маған қалдырыңыз Бірдеңе бар ма? Бірдеңе бар ма?
Dialogue: 0,1:09:42.76,1:09:43.76,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:47.09,1:09:49.05,Default,,0,0,0,,Тағы бір үлкен толқын
Dialogue: 0,1:09:49.35,1:09:50.81,Default,,0,0,0,,Барлығын бортқа отырғызыңыз
Dialogue: 0,1:09:51.02,1:09:52.14,Default,,0,0,0,,Ооо
Dialogue: 0,1:09:56.19,1:09:58.27,Default,,0,0,0,,(Араши тайпасының үрейленген дауыстары)
Dialogue: 0,1:10:01.73,1:10:03.86,Default,,0,0,0,,Әуе зеңбірегі!
Dialogue: 0,1:10:04.36,1:10:06.20,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,1:10:06.41,1:10:07.57,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,1:10:07.87,1:10:09.99,Default,,0,0,0,,Үлкен жарық!
Dialogue: 0,1:10:10.33,1:10:13.16,Default,,0,0,0,,Нобита-кун, мені осымен үлкейт
Dialogue: 0,1:10:13.33,1:10:14.00,Default,,0,0,0,,Иә
Dialogue: 0,1:10:14.12,1:10:14.96,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,1:10:19.25,1:10:20.21,Default,,0,0,0,,Жоқ, бұл тыңшылық емес
Dialogue: 0,1:10:21.42,1:10:22.09,Default,,0,0,0,,(Серо) Тіпті бастауыш сынып оқушысы кенеттен «Қорықпа!» деп айқайлады.
Dialogue: 0,1:10:28.97,1:10:30.01,Default,,0,0,0,,Хун
Dialogue: 0,1:10:30.64,1:10:33.77,Default,,0,0,0,,Ғұн ғұн
Dialogue: 0,1:10:34.85,1:10:37.44,Default,,0,0,0,,Махуга, мен сенің қарсыласыңмын.
Dialogue: 0,1:10:38.98,1:10:39.90,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,1:10:42.48,1:10:45.28,Default,,0,0,0,,Дио…
Dialogue: 0,1:10:48.24,1:10:50.28,Default,,0,0,0,,Доккаан!
Dialogue: 0,1:10:54.33,1:10:56.33,Default,,0,0,0,,Уау, иә!
Dialogue: 0,1:10:56.50,1:10:59.63,Default,,0,0,0,,Жарайсың!
Dialogue: 0,1:10:59.92,1:11:00.79,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:01.17,1:11:03.25,Default,,0,0,0,,Сіз қалай ойлайсыз? Жақсы өтті, солай ма?
Dialogue: 0,1:11:03.38,1:11:04.38,Default,,0,0,0,,Ой
Dialogue: 0,1:11:09.59,1:11:10.34,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:10.47,1:11:11.43,Default,,0,0,0,,Дораемон
Dialogue: 0,1:11:12.35,1:11:14.35,Default,,0,0,0,,Не? Уау
Dialogue: 0,1:11:15.81,1:11:17.60,Default,,0,0,0,,(Барлығы дүрбелең)
Dialogue: 0,1:11:19.73,1:11:23.07,Default,,0,0,0,,Хахаха не істесем де пайдасы жоқ.
Dialogue: 0,1:11:23.19,1:11:24.28,Default,,0,0,0,,(Барлығы айғайлайды)
Dialogue: 0,1:11:24.44,1:11:25.94,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,1:11:27.19,1:11:29.20,Default,,0,0,0,,Уау (Сунео) Джан
Dialogue: 0,1:11:31.07,1:11:31.74,Default,,0,0,0,,Ах
Dialogue: 0,1:11:31.87,1:11:37.45,Default,,0,0,0,,Ноазин мөрленген қылышпен Махуганы үш бөлікке бөлді.
Dialogue: 0,1:11:38.83,1:11:40.46,Default,,0,0,0,,Иә, осы қылышпен.
Dialogue: 0,1:11:40.87,1:11:42.79,Default,,0,0,0,,Шизука-чан, ұста, иә.
Dialogue: 0,1:11:42.92,1:11:43.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:44.04,1:11:47.72,Default,,0,0,0,,Темучин, мені Махугаға апар.
Dialogue: 0,1:11:48.09,1:11:49.22,Default,,0,0,0,,Иә
Dialogue: 0,1:11:49.84,1:11:51.34,Default,,0,0,0,,Фуконы қайтару
Dialogue: 0,1:11:52.55,1:11:53.93,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,1:11:55.85,1:11:56.60,Default,,0,0,0,,Twyer!
Dialogue: 0,1:11:56.77,1:11:57.64,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:57.93,1:11:58.85,Default,,0,0,0,,Нобита
Dialogue: 0,1:11:59.48,1:12:00.23,Default,,0,0,0,,Иә
Dialogue: 0,1:12:00.73,1:12:01.56,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:01.85,1:12:03.90,Default,,0,0,0,,Нобита-сан, абай бол
Dialogue: 0,1:12:04.65,1:12:06.73,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:12:10.82,1:12:12.57,Default,,0,0,0,,Нобита осында (Нобита) Уф
Dialogue: 0,1:12:18.66,1:12:20.04,Default,,0,0,0,,Қазір! (Нобита) Уф
Dialogue: 0,1:12:20.37,1:12:22.83,Default,,0,0,0,,Уф, уф
Dialogue: 0,1:12:23.33,1:12:25.71,Default,,0,0,0,,Гуаа... Фуко!
Dialogue: 0,1:12:31.51,1:12:32.93,Default,,0,0,0,,Артқа қайт!
Dialogue: 0,1:12:39.81,1:12:40.73,Default,,0,0,0,,Уау
Dialogue: 0,1:12:42.52,1:12:45.52,Default,,0,0,0,,Мен мұны Нобита жасадым
Dialogue: 0,1:12:45.90,1:12:46.82,Default,,0,0,0,,Ахаха, жарайсың
Dialogue: 0,1:12:46.94,1:12:47.86,Default,,0,0,0,,Нобита-сан
Dialogue: 0,1:12:51.20,1:12:52.20,Default,,0,0,0,,Ахх (Сунео/Джиан) Уау
Dialogue: 0,1:12:56.37,1:12:57.62,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,1:12:57.79,1:12:59.50,Default,,0,0,0,,Фуко-чан (Фуко) Хун
Dialogue: 0,1:12:59.70,1:13:01.12,Default,,0,0,0,,Бұл керемет Нобита хахаха хаха
Dialogue: 0,1:13:01.46,1:13:02.54,Default,,0,0,0,,А-а-а
Dialogue: 0,1:13:10.01,1:13:11.13,Default,,0,0,0,,Салқын
Dialogue: 0,1:13:16.30,1:13:17.10,Default,,0,0,0,,Уау
Dialogue: 0,1:13:17.22,1:13:18.10,Default,,0,0,0,,Нобита
Dialogue: 0,1:13:18.31,1:13:19.26,Default,,0,0,0,,Уау
Dialogue: 0,1:13:23.31,1:13:24.06,Default,,0,0,0,,Нобита-сан
Dialogue: 0,1:13:24.19,1:13:26.44,Default,,0,0,0,,А, енді жоқ!
Dialogue: 0,1:13:27.69,1:13:29.02,Default,,0,0,0,,Хамф!
Dialogue: 0,1:13:29.44,1:13:31.40,Default,,0,0,0,,Хун Фуко-чан
Dialogue: 0,1:13:33.95,1:13:36.95,Default,,0,0,0,,Хамф
Dialogue: 0,1:13:43.46,1:13:46.17,Default,,0,0,0,,Фуууууууууууу...
Dialogue: 0,1:13:50.17,1:13:51.34,Default,,0,0,0,,Иә
Dialogue: 0,1:13:51.84,1:13:52.97,Default,,0,0,0,,Фуко
Dialogue: 0,1:13:54.97,1:13:57.22,Default,,0,0,0,,Иә
Dialogue: 0,1:13:58.22,1:13:59.14,Default,,0,0,0,,Фуко ше?
Dialogue: 0,1:13:59.26,1:14:00.10,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін қойылмаған шығар, иә?
Dialogue: 0,1:14:00.35,1:14:01.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:01.18,1:14:02.98,Default,,0,0,0,,Иә
Dialogue: 0,1:14:06.35,1:14:07.44,Default,,0,0,0,,Фуко?
Dialogue: 0,1:14:16.70,1:14:17.78,Default,,0,0,0,,Бұл жебе аса бағалы — олардың тек біреуі ғана бар.
Dialogue: 0,1:14:18.24,1:14:21.24,Default,,0,0,0,,Махуга тағы бір рет қабылданады.
Dialogue: 0,1:14:23.16,1:14:25.37,Default,,0,0,0,,А-а-а-а-а-а
Dialogue: 0,1:14:29.50,1:14:30.63,Default,,0,0,0,,Иә
Dialogue: 0,1:14:35.80,1:14:37.51,Default,,0,0,0,,Дора-чан, жақсысың ба?
Dialogue: 0,1:14:37.63,1:14:41.43,Default,,0,0,0,,Иә, Фуко-чан құйынға қарама-қарсы бағытта айналады.
Dialogue: 0,1:14:41.56,1:14:44.60,Default,,0,0,0,,Мен Махуганы жоғалтып алуға тырысамын.
Dialogue: 0,1:14:46.19,1:14:48.06,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:14:48.44,1:14:51.48,Default,,0,0,0,,Иә? Сондықтан біз біргеміз...
Dialogue: 0,1:14:52.15,1:14:54.86,Default,,0,0,0,,Мүмкін, Фуко да шығар...
Dialogue: 0,1:14:55.32,1:14:56.36,Default,,0,0,0,,Иә
Dialogue: 0,1:14:59.53,1:15:00.95,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:15:02.37,1:15:05.29,Default,,0,0,0,,Тоқта, Фуко!
Dialogue: 0,1:15:06.96,1:15:08.25,Default,,0,0,0,,Иә
Dialogue: 0,1:15:08.54,1:15:10.75,Default,,0,0,0,,Яй Фуко...
Dialogue: 0,1:15:14.59,1:15:16.51,Default,,0,0,0,,Сәттілік Фуко
Dialogue: 0,1:15:17.34,1:15:18.09,Default,,0,0,0,,Сунео
Dialogue: 0,1:15:18.22,1:15:20.30,Default,,0,0,0,,Махугадан жеңілме
Dialogue: 0,1:15:20.68,1:15:22.72,Default,,0,0,0,,Сәттілік Фуко-чан
Dialogue: 0,1:15:23.01,1:15:25.43,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, барыңды істе
Dialogue: 0,1:15:31.94,1:15:34.36,Default,,0,0,0,,Иә
Dialogue: 0,1:15:43.16,1:15:47.96,Default,,0,0,0,,Ұлы жел, бізге күш бер.
Dialogue: 0,1:15:48.58,1:15:52.21,Default,,0,0,0,,Желдің баласына күш бер
Dialogue: 0,1:15:59.68,1:16:02.39,Default,,0,0,0,,Фуко, жақсы жұмыс (Сунео/Тэмүжин) Сәттілік
Dialogue: 0,1:16:05.14,1:16:07.31,Default,,0,0,0,,Ақымақ... Сене алар емеспін.
Dialogue: 0,1:16:09.02,1:16:12.06,Default,,0,0,0,,Фуко!
Dialogue: 0,1:16:15.07,1:16:19.53,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:16:27.37,1:16:28.33,Default,,0,0,0,,Ах
Dialogue: 0,1:16:28.79,1:16:29.66,Default,,0,0,0,,Дио…
Dialogue: 0,1:16:29.96,1:16:30.62,Default,,0,0,0,,Ой
Dialogue: 0,1:16:30.79,1:16:34.59,Default,,0,0,0,,Уф уф... уф
Dialogue: 0,1:16:36.42,1:16:39.09,Default,,0,0,0,,Эх, у...
Dialogue: 0,1:16:50.85,1:16:52.35,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:52.81,1:16:54.31,Default,,0,0,0,,Ой
Dialogue: 0,1:16:56.11,1:16:56.98,Default,,0,0,0,,Ах
Dialogue: 0,1:17:03.24,1:17:04.36,Default,,0,0,0,,Фуко
Dialogue: 0,1:17:08.20,1:17:11.58,Default,,0,0,0,,О, құдайым...
Dialogue: 0,1:17:11.91,1:17:13.17,Default,,0,0,0,,Хехехе
Dialogue: 0,1:17:13.29,1:17:14.63,Default,,0,0,0,,Хехе
Dialogue: 0,1:17:14.75,1:17:16.38,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,1:17:16.71,1:17:18.00,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:18.25,1:17:20.01,Default,,0,0,0,,Фуко (Фуко) Фуфу Фуфу Фуфу
Dialogue: 0,1:17:22.09,1:17:23.93,Default,,0,0,0,,Бұл сарқырама. Сіз сыртқа шыға аласыз.
Dialogue: 0,1:17:24.89,1:17:25.89,Default,,0,0,0,,Фуко
Dialogue: 0,1:17:26.14,1:17:27.26,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,1:17:42.78,1:17:45.53,Default,,0,0,0,,Уф...
Dialogue: 0,1:17:46.66,1:17:47.95,Default,,0,0,0,,Фуко
Dialogue: 0,1:17:49.58,1:17:55.37,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,1:18:00.55,1:18:02.01,Default,,0,0,0,,Ноби... (Сунео) Джан
Dialogue: 0,1:18:02.59,1:18:04.63,Default,,0,0,0,,Оны жайына қалдырайық.
Dialogue: 0,1:18:04.76,1:18:05.97,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:18:06.18,1:18:07.80,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:18:07.93,1:18:09.26,Default,,0,0,0,,Нобита-сан
Dialogue: 0,1:18:09.72,1:18:12.27,Default,,0,0,0,,Қарғыс атқыр, не айтып тұрсың?
Dialogue: 0,1:18:14.31,1:18:15.89,Default,,0,0,0,,А, дауыл.
Dialogue: 0,1:18:16.40,1:18:18.06,Default,,0,0,0,,Дораэмон пневматикалық зеңбірегі
Dialogue: 0,1:18:18.19,1:18:19.44,Default,,0,0,0,,Сеніп тапсырылған
Dialogue: 0,1:18:19.65,1:18:20.86,Default,,0,0,0,,Темучин өтінемін
Dialogue: 0,1:18:21.02,1:18:21.98,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:18:25.99,1:18:28.03,Default,,0,0,0,,Дауыл Мен саған қашып кетуге жол бермеймін
Dialogue: 0,1:18:28.16,1:18:29.78,Default,,0,0,0,,Доккан
Dialogue: 0,1:18:32.74,1:18:34.25,Default,,0,0,0,,Керемет Джиан
Dialogue: 0,1:18:34.50,1:18:34.79,Default,,0,0,0,,Хэ-хэ-хэ, бұл қандай нәрсе?
Dialogue: 0,1:18:34.79,1:18:36.92,Default,,0,0,0,,Хэ-хэ-хэ, бұл қандай нәрсе?
Dialogue: 0,1:18:34.79,1:18:36.92,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,1:18:36.92,1:18:37.25,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,1:18:38.42,1:18:40.29,Default,,0,0,0,,Жаңалық келді.
Dialogue: 0,1:18:40.54,1:18:44.67,Default,,0,0,0,,болған супер тайфун кенеттен жоғалып кетті.
Dialogue: 0,1:18:45.42,1:18:47.05,Default,,0,0,0,,Осы жұмбақ тайфун туралы—
Dialogue: 0,1:18:47.18,1:18:49.43,Default,,0,0,0,,Болашақ зерттеулер күтілуде.
Dialogue: 0,1:18:49.93,1:18:50.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:18:51.10,1:18:52.06,Default,,0,0,0,,Иә, қош келдіңіз.
Dialogue: 0,1:18:52.18,1:18:55.39,Default,,0,0,0,,Сіз мұны естідіңіз бе? Сізге ханым
Dialogue: 0,1:19:05.57,1:19:07.32,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:10.78,1:19:12.20,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:12.74,1:19:15.33,Default,,0,0,0,,Дауыл 22 ғасырда соттайды
Dialogue: 0,1:19:16.29,1:19:17.29,Default,,0,0,0,,Тохохо
Dialogue: 0,1:19:18.25,1:19:19.75,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,1:19:25.92,1:19:28.68,Default,,0,0,0,,Жел ауылына жол тартайық!
Dialogue: 0,1:19:29.05,1:19:31.97,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,1:19:40.19,1:19:43.73,Default,,0,0,0,,Мен Уландер Сунео Хонекава емеспін
Dialogue: 0,1:19:44.15,1:19:46.53,Default,,0,0,0,,Ұландер деген жақсырақ есім.
Dialogue: 0,1:19:46.65,1:19:47.40,Default,,0,0,0,,Хахахаха (Сунео) Қазірдің өзінде!
Dialogue: 0,1:19:47.94,1:19:49.49,Default,,0,0,0,,Бізге тағы да келіңіз
Dialogue: 0,1:19:49.61,1:19:50.57,Default,,0,0,0,,Иә
Dialogue: 0,1:19:50.95,1:19:52.16,Default,,0,0,0,,Көңіл көтеру
Dialogue: 0,1:19:52.28,1:19:53.87,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,1:19:58.21,1:20:00.67,Default,,0,0,0,,Фуко жоғалып кетті
Dialogue: 0,1:20:00.87,1:20:02.96,Default,,0,0,0,,Бірақ мен жалғыз емеспін
Dialogue: 0,1:20:03.67,1:20:07.05,Default,,0,0,0,,Фуко әрқашан менің жанымда.
Dialogue: 0,1:20:08.67,1:20:10.26,Default,,0,0,0,,Бұл өнер жабдықтары дүкендерінде сатылатын өмірден сурет салуға арналған манекендердің бірі ме?
Dialogue: 0,1:20:10.47,1:20:12.14,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,1:20:12.30,1:20:14.01,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Нобита.
Dialogue: 0,1:20:14.14,1:20:16.18,Default,,0,0,0,,Мен Фукомен сол жерде таныстым.
Dialogue: 0,1:20:16.31,1:20:17.10,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:17.22,1:20:19.18,Default,,0,0,0,,Нобита, сен кеше де солай айттың.
Dialogue: 0,1:20:19.31,1:20:21.81,Default,,0,0,0,,Дұрыс (Нобита) Бұл жолы рас.
Dialogue: 0,1:20:21.98,1:20:23.73,Default,,0,0,0,,Сіз армандаған жоқсыз ба?
Dialogue: 0,1:20:23.86,1:20:25.52,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,1:20:25.65,1:20:30.15,Default,,0,0,0,,Нобита-кун, сіздің бетіңізде татами іздері бар.
Dialogue: 0,1:20:30.28,1:20:33.16,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,1:20:33.45,1:20:39.45,Default,,0,0,0,,♪〜
Dialogue: 0,1:23:34.38,1:23:40.39,Default,,0,0,0,,〜♪
