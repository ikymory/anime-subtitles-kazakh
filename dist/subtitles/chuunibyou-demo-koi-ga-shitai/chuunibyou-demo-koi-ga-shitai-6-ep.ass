Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.91,0:00:03.33,Default,,0,0,0,,Уау аааа
Dialogue: 0,0:00:03.42,0:00:06.21,Default,,0,0,0,,Мен біраз уақыт жалғыз қалдым, сондықтан мен сенімен мүлдем ілесе алмаймын.
Dialogue: 0,0:00:06.96,0:00:08.88,Default,,0,0,0,,Бұл мүлде қиналады.
Dialogue: 0,0:00:08.96,0:00:10.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:11.46,0:00:12.59,Default,,0,0,0,,Эй, маған кедергі жасама.
Dialogue: 0,0:00:12.67,0:00:13.88,Default,,0,0,0,,(Үстіңгі қабаттағы шулар)
Dialogue: 0,0:00:13.97,0:00:14.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:16.47,0:00:17.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:17.72,0:00:18.89,Default,,0,0,0,,(Төбені түрту дыбысы)
Dialogue: 0,0:00:19.64,0:00:20.72,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:21.47,0:00:23.85,Default,,0,0,0,,- (Рикка) Юта Юта - (Юта) Иә?
Dialogue: 0,0:00:23.94,0:00:26.44,Default,,0,0,0,,Yuta қолдауы...
Dialogue: 0,0:00:26.52,0:00:27.40,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:00:29.65,0:00:30.48,Default,,0,0,0,,Уф
Dialogue: 0,0:00:31.44,0:00:33.99,Default,,0,0,0,,Тезірек менің бір ісім бар.
Dialogue: 0,0:00:34.07,0:00:35.74,Default,,0,0,0,,Оны қалай қолдану дұрыс емес.
Dialogue: 0,0:00:35.82,0:00:38.03,Default,,0,0,0,,Мен ұйымға арналған киім үлгісін жасадым.
Dialogue: 0,0:00:38.12,0:00:38.99,Default,,0,0,0,,Біркелкі?
Dialogue: 0,0:00:39.99,0:00:42.16,Default,,0,0,0,,Мұны әрекет кезінде киіңіз.
Dialogue: 0,0:00:42.25,0:00:44.33,Default,,0,0,0,,«Қара жалын» деп оқыңыз
Dialogue: 0,0:00:44.41,0:00:45.83,Default,,0,0,0,,Мен мынамын
Dialogue: 0,0:00:47.38,0:00:49.50,Default,,0,0,0,,«жаман көз» деп айтылады
Dialogue: 0,0:00:49.96,0:00:51.59,Default,,0,0,0,,Ертеңгі іс-әрекетімізді бастайық
Dialogue: 0,0:00:51.67,0:00:52.71,Default,,0,0,0,,- (Юта) Оны киесің бе? - (Рикка) А.
Dialogue: 0,0:00:52.80,0:00:55.97,Default,,0,0,0,,Айттым ғой, мен ондай мамандықты бітіріп қойғанмын.
Dialogue: 0,0:00:57.39,0:00:59.93,Default,,0,0,0,,- (Рикка) Бұл Ютаның мінезі ме? -(Юта) Жарайды.
Dialogue: 0,0:01:00.01,0:01:01.56,Default,,0,0,0,,Аты «Сецуна»
Dialogue: 0,0:01:01.64,0:01:03.56,Default,,0,0,0,,Ойында бәрі жақсы!
Dialogue: 0,0:01:03.64,0:01:05.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:06.56,0:01:09.02,Default,,0,0,0,,Міне, діни қызметкер қайтып келді.
Dialogue: 0,0:01:09.65,0:01:13.40,Default,,0,0,0,,Ертең таңғы сағат 7-де В кездесу нүктесінде.
Dialogue: 0,0:01:14.78,0:01:15.86,Default,,0,0,0,,Уф
Dialogue: 0,0:01:16.74,0:01:18.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:23.83,0:01:25.00,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:01:25.08,0:01:27.08,Default,,0,0,0,,♪～
Dialogue: 0,0:02:52.63,0:02:54.96,Default,,0,0,0,,～♪
Dialogue: 0,0:02:56.38,0:02:59.26,Default,,0,0,0,,Сен, қазір шілде айы.
Dialogue: 0,0:02:59.72,0:03:00.76,Default,,0,0,0,,Параметрлеріңіз
Dialogue: 0,0:03:00.84,0:03:02.05,Default,,0,0,0,,Себебі мен ғана түсінемін
Dialogue: 0,0:03:02.14,0:03:04.05,Default,,0,0,0,,Мүмкін оған көмектесу мүмкін емес.
Dialogue: 0,0:03:04.85,0:03:07.39,Default,,0,0,0,,Басқа жігіттермен сөйлесіп көріңіз.
Dialogue: 0,0:03:08.35,0:03:12.73,Default,,0,0,0,,Мен Юутадан басқа Декомори, Кумин және Нибутанимен де сөйлесіп жатырмын.
Dialogue: 0,0:03:12.81,0:03:15.36,Default,,0,0,0,,Бұл дұрыс, бірақ басқа да нәрселер бар.
Dialogue: 0,0:03:15.44,0:03:20.24,Default,,0,0,0,,Юта да сабақта тек менімен және Исшики Нибутанимен сөйлеседі... бірдей.
Dialogue: 0,0:03:20.32,0:03:21.57,Default,,0,0,0,,Ол енді ғана тозақтан оралды.
Dialogue: 0,0:03:21.65,0:03:24.03,Default,,0,0,0,,Мен бірінші кезекте көп жиналуды ұнатпаймын.
Dialogue: 0,0:03:24.57,0:03:25.83,Default,,0,0,0,,Фу~
Dialogue: 0,0:03:25.91,0:03:28.45,Default,,0,0,0,,Бұл қиын, бірақ оны жайына қалдырыңыз.
Dialogue: 0,0:03:29.08,0:03:33.92,Default,,0,0,0,,Қазіргі кеңістікте мені танитын жалғыз мен ғана.
Dialogue: 0,0:03:34.88,0:03:35.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:36.42,0:03:39.17,Default,,0,0,0,,- (Тоджи) Тогаши-кун, сен жақсы сурет саласың - (Юта) А?
Dialogue: 0,0:03:39.26,0:03:41.13,Default,,0,0,0,,Бұл Которию-сан сүйкімді
Dialogue: 0,0:03:41.22,0:03:42.55,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:03:42.63,0:03:45.18,Default,,0,0,0,,Қайсысы? Аа, бұл рас
Dialogue: 0,0:03:45.26,0:03:47.39,Default,,0,0,0,,Тогаши-кун, сен манга саласың ба?
Dialogue: 0,0:03:47.47,0:03:49.35,Default,,0,0,0,,Аа, жоқ, жоқ, шын мәнінде емес.
Dialogue: 0,0:03:49.93,0:03:53.02,Default,,0,0,0,,Мен орта мектепте ауырған кезде мен көптеген иллюстрациялар салатынмын.
Dialogue: 0,0:03:53.10,0:03:55.27,Default,,0,0,0,,Дайын, жақсы
Dialogue: 0,0:03:55.36,0:03:56.19,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:03:56.27,0:03:57.65,Default,,0,0,0,,- (Хираката) Көрсет, көрсет маған - (Рикка) Уф.
Dialogue: 0,0:03:57.73,0:04:00.61,Default,,0,0,0,,А... Мынау Тоғаши-кун ба?
Dialogue: 0,0:04:00.69,0:04:01.74,Default,,0,0,0,,Шайқаста
Dialogue: 0,0:04:01.82,0:04:03.95,Default,,0,0,0,,- (Хираката) Шайқаста? -(Юта) Ммм.
Dialogue: 0,0:04:06.57,0:04:07.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:07.99,0:04:11.20,Default,,0,0,0,,Өлімге жақын күйден шыққан қараңғы жалын!
Dialogue: 0,0:04:11.29,0:04:12.16,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:04:12.75,0:04:14.46,Default,,0,0,0,,Қараңғы жалын?
Dialogue: 0,0:04:14.54,0:04:16.25,Default,,0,0,0,,Мен оны дауыстап айта алмаймын, бірақ
Dialogue: 0,0:04:16.33,0:04:19.13,Default,,0,0,0,,Қараңғы жалын - Ютаның ең үлкен шабуыл сиқыры
Dialogue: 0,0:04:19.21,0:04:21.34,Default,,0,0,0,,Осымен, Юта...!
Dialogue: 0,0:04:21.42,0:04:22.63,Default,,0,0,0,,Әу
Dialogue: 0,0:04:23.80,0:04:24.63,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:04:24.72,0:04:26.14,Default,,0,0,0,,- (Декомори) Уау - (Нибутани) Уау
Dialogue: 0,0:04:26.22,0:04:28.93,Default,,0,0,0,,Уф, ауырды...
Dialogue: 0,0:04:29.01,0:04:32.14,Default,,0,0,0,,Кез келген уақытта сақтығыңызды төмендетпеңіз, жалған Морисама
Dialogue: 0,0:04:32.23,0:04:33.69,Default,,0,0,0,,Морисама деп айтпа
Dialogue: 0,0:04:34.14,0:04:37.56,Default,,0,0,0,,- (Тоцуги) Жақсысың ба? Нибутани-сан - (Нюя) Ах иә.
Dialogue: 0,0:04:37.65,0:04:38.65,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:04:38.73,0:04:40.15,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:04:40.23,0:04:42.15,Default,,0,0,0,,Оны кішілер де жақсы көреді.
Dialogue: 0,0:04:42.24,0:04:43.65,Default,,0,0,0,,Ахахаха... хаха...
Dialogue: 0,0:04:43.74,0:04:45.32,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:45.41,0:04:46.74,Default,,0,0,0,,- (Исшики) Юта - (Юта) А?
Dialogue: 0,0:04:47.32,0:04:49.03,Default,,0,0,0,,Уау! Не?
Dialogue: 0,0:04:49.12,0:04:52.29,Default,,0,0,0,,Сабақтан кейін біраз уақыт аламын ба?
Dialogue: 0,0:04:53.20,0:04:55.67,Default,,0,0,0,,Не!? Сізге махаббат хаты келді ме?
Dialogue: 0,0:04:55.75,0:04:57.17,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:04:57.25,0:05:00.25,Default,,0,0,0,,Ал, көптен күткен жоқсың ба?
Dialogue: 0,0:05:00.34,0:05:01.59,Default,,0,0,0,,Неге үрейленіп жатырсыз?
Dialogue: 0,0:05:01.67,0:05:04.80,Default,,0,0,0,,Өйткені мен бұл шынымен келеді деп ешқашан ойламадым.
Dialogue: 0,0:05:04.88,0:05:07.01,Default,,0,0,0,,Сіз мое ретінде нені тартқыңыз келеді?
Dialogue: 0,0:05:07.09,0:05:08.76,Default,,0,0,0,,Бұл гитара ғой, солай ма?
Dialogue: 0,0:05:08.85,0:05:11.64,Default,,0,0,0,,Егер сізді бағалап жатса, бұл музыкамен айналысқаныңыз үшін, солай емес пе?
Dialogue: 0,0:05:11.72,0:05:15.02,Default,,0,0,0,,Бірақ мен әлі де көп ойнай алмаймын, не істеуім керек?
Dialogue: 0,0:05:15.10,0:05:17.48,Default,,0,0,0,,Әзірше кете аласыз ба?
Dialogue: 0,0:05:17.65,0:05:18.02,Default,,0,0,0,,(Студент қыздың сыбырлаған дауысы)
Dialogue: 0,0:05:18.02,0:05:19.61,Default,,0,0,0,,(Студент қыздың сыбырлаған дауысы)
Dialogue: 0,0:05:18.02,0:05:19.61,Default,,0,0,0,,Барлығы артта қалды.
Dialogue: 0,0:05:19.69,0:05:21.19,Default,,0,0,0,,Бұл кішігірім.
Dialogue: 0,0:05:21.27,0:05:23.90,Default,,0,0,0,,Әйелдер туралы айтатын болсам, бұл кіші аккорд!
Dialogue: 0,0:05:23.99,0:05:25.61,Default,,0,0,0,,Бұл қандай білім!? Тынышталыңыз.
Dialogue: 0,0:05:25.70,0:05:27.20,Default,,0,0,0,,Бұл мүмкін емес деп айтпа!
Dialogue: 0,0:05:27.70,0:05:28.74,Default,,0,0,0,,Сабырлы болайық.
Dialogue: 0,0:05:28.82,0:05:32.08,Default,,0,0,0,,1-сұрақ Бұл шынымен махаббат хаты ма?
Dialogue: 0,0:05:32.16,0:05:34.16,Default,,0,0,0,,Демек, сіз иә дейсіз.
Dialogue: 0,0:05:34.25,0:05:37.67,Default,,0,0,0,,2-сұрақ Бұл баланың еркелігі емес пе?
Dialogue: 0,0:05:37.75,0:05:39.50,Default,,0,0,0,,Мына шеңбер кейіпкеріне қараңыз.
Dialogue: 0,0:05:39.58,0:05:41.84,Default,,0,0,0,,«Осы сенбіде мектептен кейін»
Dialogue: 0,0:05:41.92,0:05:44.21,Default,,0,0,0,,«Мен гинкго ағашының астында күтемін».
Dialogue: 0,0:05:44.30,0:05:45.67,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:05:47.34,0:05:48.43,Default,,0,0,0,,3-сұрақ
Dialogue: 0,0:05:48.51,0:05:51.97,Default,,0,0,0,,Бұл ұлдар мен қыздар сөз байласып жатыр деген сөз емес пе?
Dialogue: 0,0:05:52.51,0:05:54.85,Default,,0,0,0,,Сіз адамдарға сенесіз бе?
Dialogue: 0,0:05:54.93,0:05:57.02,Default,,0,0,0,,Уф, көп нәрсе болды.
Dialogue: 0,0:05:57.10,0:05:59.15,Default,,0,0,0,,Эй, бұл кім деп ойлайсың?
Dialogue: 0,0:05:59.23,0:06:02.15,Default,,0,0,0,,Хатта біз сыныптаспыз деп жазылған.
Dialogue: 0,0:06:02.23,0:06:04.53,Default,,0,0,0,,Ең бастысы менің атым жоқ.
Dialogue: 0,0:06:04.61,0:06:06.36,Default,,0,0,0,,Сіздің ойыңыз жоқ па?
Dialogue: 0,0:06:06.44,0:06:07.32,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:08.45,0:06:09.53,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:09.61,0:06:12.66,Default,,0,0,0,,Хираката Икутенмокугайказе…
Dialogue: 0,0:06:12.74,0:06:14.70,Default,,0,0,0,,Жоқ, бұл мүмкін емес.
Dialogue: 0,0:06:14.79,0:06:16.75,Default,,0,0,0,,Бірақ мен оны айту керек болсам
Dialogue: 0,0:06:16.83,0:06:18.62,Default,,0,0,0,,- (Юта) Мен не айтуым керек? -(Исшики) Нибутани?
Dialogue: 0,0:06:18.71,0:06:20.42,Default,,0,0,0,,- (Юта) Уф - (Исшики) О, жоқ, қара!
Dialogue: 0,0:06:20.50,0:06:23.09,Default,,0,0,0,,Бір-бірімізбен кездескенде Нибутани қандай болады?
Dialogue: 0,0:06:23.17,0:06:25.00,Default,,0,0,0,,Бұл сізді күлдіреді.
Dialogue: 0,0:06:25.09,0:06:28.55,Default,,0,0,0,,Сіздің мінезіңіз туралы не айта аламын? Сіз байсалды және дұрыссыз, солай ма?
Dialogue: 0,0:06:28.63,0:06:32.35,Default,,0,0,0,,Міне, сондықтан да мені музыкалық жігіттердің жабайылығы қызықтырды...
Dialogue: 0,0:06:32.43,0:06:33.76,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:06:33.85,0:06:35.39,Default,,0,0,0,,Неліктен талап етесіз?
Dialogue: 0,0:06:35.47,0:06:36.68,Default,,0,0,0,,Біреуі жоқ.
Dialogue: 0,0:06:36.77,0:06:38.48,Default,,0,0,0,,Мен дәл осыны айта аламын.
Dialogue: 0,0:06:38.56,0:06:40.10,Default,,0,0,0,,Неліктен? Ха!
Dialogue: 0,0:06:40.19,0:06:43.19,Default,,0,0,0,,Күте тұрыңыз, сіз Нибутанимен біргесіз.
Dialogue: 0,0:06:43.27,0:06:44.98,Default,,0,0,0,,Аа, олай емес.
Dialogue: 0,0:06:46.03,0:06:49.86,Default,,0,0,0,,Нибутани екеуіңіз, әрине, жақсы сәйкестік емессіздер.
Dialogue: 0,0:06:49.95,0:06:51.11,Default,,0,0,0,,Сіз айтасыз.
Dialogue: 0,0:06:51.20,0:06:54.62,Default,,0,0,0,,Әйтеуір, маған хат жіберген қыздың кім екенін білгім келеді.
Dialogue: 0,0:06:54.70,0:06:57.62,Default,,0,0,0,,Қараңдаршы, мен олардан тікелей сұрасам, олай болмай ма?
Dialogue: 0,0:06:57.70,0:06:59.29,Default,,0,0,0,,Менде жалғыз сенсің
Dialogue: 0,0:06:59.37,0:07:01.37,Default,,0,0,0,,Бұл күні асыға күтетін нәрсе бар емес пе?
Dialogue: 0,0:07:01.46,0:07:03.67,Default,,0,0,0,,Ақымақ, қызбен алғаш танысқанда
Dialogue: 0,0:07:03.75,0:07:07.13,Default,,0,0,0,,Қалай ойлайсың, мен импровизация жасап, жақсы жұмыс істей аламын ба?
Dialogue: 0,0:07:07.21,0:07:08.01,Default,,0,0,0,,Мен Киодоның сәтсіздікке ұшырайтынына сенімдімін!
Dialogue: 0,0:07:08.01,0:07:09.47,Default,,0,0,0,,Киодоның сәтсіздікке ұшырайтыны анық!
Dialogue: 0,0:07:08.01,0:07:09.47,Default,,0,0,0,,Кяах!
Dialogue: 0,0:07:09.55,0:07:10.63,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:07:10.72,0:07:13.68,Default,,0,0,0,,Сенімсіздігіңізді көрсету үшін тым сенімді болмаңыз!
Dialogue: 0,0:07:14.47,0:07:17.27,Default,,0,0,0,,Қап қараңғымен қоршалған уау
Dialogue: 0,0:07:17.35,0:07:19.68,Default,,0,0,0,,Қараңғылық күші төмендейтін өлім
Dialogue: 0,0:07:19.77,0:07:20.64,Default,,0,0,0,,Түнгі киімге сай ма?
Dialogue: 0,0:07:20.64,0:07:22.48,Default,,0,0,0,,Түнгі киімге сай ма?
Dialogue: 0,0:07:20.64,0:07:22.48,Default,,0,0,0,,Дегенмен, бұл жігіттер білмейді деп ойлаймын.
Dialogue: 0,0:07:22.48,0:07:23.65,Default,,0,0,0,,Дегенмен, бұл жігіттер тіпті білмейді деп ойлаймын.
Dialogue: 0,0:07:24.52,0:07:27.98,Default,,0,0,0,,Мұны киген кезде, өзіңізді дұрыс көрсетіңіз.
Dialogue: 0,0:07:28.69,0:07:30.70,Default,,0,0,0,,Evil King True Eye пайдаланушысы
Dialogue: 0,0:07:30.78,0:07:34.16,Default,,0,0,0,,Қоғамның нөлдік нөмірі Рикка Которию
Dialogue: 0,0:07:34.24,0:07:37.79,Default,,0,0,0,,Зұлым патша шынайы көздің қызметшісі Мжолнир Хаммер Пайдаланушы
Dialogue: 0,0:07:37.87,0:07:41.29,Default,,0,0,0,,Қоғамның нөлдік нөмірі Санае Декомори
Dialogue: 0,0:07:41.37,0:07:44.25,Default,,0,0,0,,«Қорқынышты… Түнгі сиеста»
Dialogue: 0,0:07:44.33,0:07:47.34,Default,,0,0,0,,Қоғам Нөл 7 мамыр Кумин
Dialogue: 0,0:07:47.42,0:07:49.42,Default,,0,0,0,,- (Рикка) Шешім - (Декомори) Өлім
Dialogue: 0,0:07:49.51,0:07:51.47,Default,,0,0,0,,Нөмірлеудің мағынасы бар ма?
Dialogue: 0,0:07:51.55,0:07:54.09,Default,,0,0,0,,Нөл саны өте жақсы
Dialogue: 0,0:07:54.18,0:07:56.55,Default,,0,0,0,,Нөлден басқа, ойға келмейтін өлім
Dialogue: 0,0:07:56.64,0:07:59.02,Default,,0,0,0,,Мен шынымен білмеймін, бірақ бұл керемет шығар
Dialogue: 0,0:07:59.10,0:08:00.43,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:08:00.52,0:08:01.35,Default,,0,0,0,,​​О?
Dialogue: 0,0:08:01.85,0:08:04.81,Default,,0,0,0,,Нөлге қайсысы сәйкес келетінін осы жерден шешіңіз!
Dialogue: 0,0:08:04.90,0:08:06.69,Default,,0,0,0,,Қалаған өлім!
Dialogue: 0,0:08:07.94,0:08:08.86,Default,,0,0,0,,...Сенің қолыңнан келеді!
Dialogue: 0,0:08:08.94,0:08:10.36,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:10.44,0:08:12.32,Default,,0,0,0,,Үлкендеріңізге мінбеңіздер.
Dialogue: 0,0:08:12.40,0:08:15.41,Default,,0,0,0,,Не? Бірақ қарашы, бұл Тоғаши-кун.
Dialogue: 0,0:08:15.49,0:08:16.78,Default,,0,0,0,,Сол көйлек астында
Dialogue: 0,0:08:16.87,0:08:20.24,Default,,0,0,0,,Жоқ, менде киім жоқ болып қалды.
Dialogue: 0,0:08:20.33,0:08:21.83,Default,,0,0,0,,- (Рикка) Ой, Юта, сен оны киіп жүрсің! -(Юта) Уау!
Dialogue: 0,0:08:21.91,0:08:22.75,Default,,0,0,0,,(Танжиро) Ой… (Чунтарo) Чип, чип
Dialogue: 0,0:08:22.83,0:08:24.33,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:24.42,0:08:26.96,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:08:27.04,0:08:28.92,Default,,0,0,0,,Әй, ақыры Ажал келді.
Dialogue: 0,0:08:29.00,0:08:32.13,Default,,0,0,0,,Ақымақтардың есіне салудан басқа амалымыз жоқ шығар.
Dialogue: 0,0:08:32.22,0:08:33.80,Default,,0,0,0,,Фува, бұл...
Dialogue: 0,0:08:33.88,0:08:35.09,Default,,0,0,0,,Ақ су!
Dialogue: 0,0:08:35.18,0:08:36.80,Default,,0,0,0,,Оны көп қыздырыңыз
Dialogue: 0,0:08:36.89,0:08:40.64,Default,,0,0,0,,Дәмі мен хош иісі аузыңа таралады.
Dialogue: 0,0:08:40.72,0:08:42.77,Default,,0,0,0,,Сен шайтансың ба?
Dialogue: 0,0:08:42.85,0:08:45.90,Default,,0,0,0,,А, жоқ, бұл жағдайда Декомори қараңғы өлімнен шыққан ~
Dialogue: 0,0:08:45.98,0:08:48.27,Default,,0,0,0,,А, сен періштесің!
Dialogue: 0,0:08:48.36,0:08:50.94,Default,,0,0,0,,- (Нибутани) Екінің бірі жақсы - (Декомори) Уау!
Dialogue: 0,0:08:51.03,0:08:52.65,Default,,0,0,0,,Жүр, іш! Іш!
Dialogue: 0,0:08:52.74,0:08:54.15,Default,,0,0,0,,Тоқта! Тоқта!
Dialogue: 0,0:08:54.24,0:08:55.57,Default,,0,0,0,,Сәттілік Деко-чан
Dialogue: 0,0:08:55.66,0:08:57.28,Default,,0,0,0,,- (Нюя) Хоорахо хора хора - Деко-чан
Dialogue: 0,0:08:57.37,0:08:58.66,Default,,0,0,0,,Эй Нибутани
Dialogue: 0,0:08:58.74,0:09:00.99,Default,,0,0,0,,Не? Мен қазір бос емеспін. Ауызыңды жап.
Dialogue: 0,0:09:01.08,0:09:02.58,Default,,0,0,0,,Жоқ, а... бірақ, қараңызшы.
Dialogue: 0,0:09:02.66,0:09:06.21,Default,,0,0,0,,Не, сен сонша шулысың ба? Егер мен сізді алаңдатсам, сіз...
Dialogue: 0,0:09:07.42,0:09:09.25,Default,,0,0,0,,- (Нибутани) Иә? -(Исшики) Эй.
Dialogue: 0,0:09:09.34,0:09:11.80,Default,,0,0,0,,Ой, Исшики-кун, не болды?
Dialogue: 0,0:09:12.26,0:09:13.21,Default,,0,0,0,,- (Исшики) Иә? -(Юта) А?
Dialogue: 0,0:09:13.30,0:09:15.93,Default,,0,0,0,,А... жоқ, мен Ютамен аздап кеңесіп көрдім.
Dialogue: 0,0:09:16.01,0:09:19.64,Default,,0,0,0,,Аа, дұрыс. Мен таң қалдым... Уау!
Dialogue: 0,0:09:19.72,0:09:22.93,Default,,0,0,0,,Хехехехе Жарайсың Өлім.
Dialogue: 0,0:09:23.02,0:09:26.48,Default,,0,0,0,,Сіздің ақ суыңыз жоғалып кетті!
Dialogue: 0,0:09:26.56,0:09:27.48,Default,,0,0,0,,Пуха~
Dialogue: 0,0:09:27.94,0:09:30.27,Default,,0,0,0,,Мен саған қарап тұрмын, Жалған Морисамер.
Dialogue: 0,0:09:30.36,0:09:33.48,Default,,0,0,0,,Өлім сені шексіз күш көкжиегіне жетелейді.
Dialogue: 0,0:09:33.57,0:09:34.69,Default,,0,0,0,,«Мори-сама»?
Dialogue: 0,0:09:34.78,0:09:38.32,Default,,0,0,0,,Аха, ойлайсың ба? Ол қызық бала.
Dialogue: 0,0:09:38.41,0:09:43.12,Default,,0,0,0,,Мабиногион Жеті түсті қолжазба 3-тарау 1-бөлім
Dialogue: 0,0:09:43.20,0:09:44.12,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:09:44.12,0:09:44.58,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:09:44.12,0:09:44.58,Default,,0,0,0,,Рухтың сыбыры
Dialogue: 0,0:09:44.58,0:09:45.87,Default,,0,0,0,,Рухтың сыбыры
Dialogue: 0,0:09:45.96,0:09:49.29,Default,,0,0,0,,Жарық пен су туралы ойлар бізге жеткенде
Dialogue: 0,0:09:49.38,0:09:50.96,Default,,0,0,0,,Ақ дүние ашылады
Dialogue: 0,0:09:51.04,0:09:52.21,Default,,0,0,0,,- (Нибутани)... Хаха... - (Исшики) Иә?
Dialogue: 0,0:09:52.30,0:09:54.05,Default,,0,0,0,,400 жыл бойы
Dialogue: 0,0:09:54.13,0:09:57.26,Default,,0,0,0,,Мен әлемді бақылап отырдым, сондықтан түсіндім.
Dialogue: 0,0:09:57.34,0:10:00.89,Default,,0,0,0,,Бұл әлемге ең қажет нәрсе...
Dialogue: 0,0:10:02.89,0:10:03.85,Default,,0,0,0,,Махаббат!
Dialogue: 0,0:10:03.93,0:10:05.10,Default,,0,0,0,,- (Нибутани) Тоқта! -(Исшики) Уау.
Dialogue: 0,0:10:05.18,0:10:06.18,Default,,0,0,0,,Мен мұны естігім келмейді!
Dialogue: 0,0:10:06.27,0:10:07.85,Default,,0,0,0,,Не? Болды
Dialogue: 0,0:10:07.94,0:10:09.90,Default,,0,0,0,,Хехехе, бұл күткендей жалған
Dialogue: 0,0:10:09.98,0:10:12.90,Default,,0,0,0,,Шын сөзді естігеннен кейін ажал бұзылды.
Dialogue: 0,0:10:12.98,0:10:14.32,Default,,0,0,0,,Морисама-чан қатты
Dialogue: 0,0:10:14.40,0:10:16.03,Default,,0,0,0,,Морисама деп айтпа, а
Dialogue: 0,0:10:16.11,0:10:18.82,Default,,0,0,0,,Нибутани сен...
Dialogue: 0,0:10:19.41,0:10:21.82,Default,,0,0,0,,Ура!
Dialogue: 0,0:10:21.91,0:10:25.16,Default,,0,0,0,,Жаңа көргенімді сабақта айттым
Dialogue: 0,0:10:27.08,0:10:28.58,Default,,0,0,0,,Мен сені өлгенше қарғаймын
Dialogue: 0,0:10:28.66,0:10:30.08,Default,,0,0,0,,(Доп соққан жарғанақтың дыбысы)
Dialogue: 0,0:10:28.66,0:10:30.08,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:30.08,0:10:30.17,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:30.17,0:10:31.46,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:30.17,0:10:31.46,Default,,0,0,0,,(Бейсбол командасы мүшелерінің дауыстары)
Dialogue: 0,0:10:31.46,0:10:33.09,Default,,0,0,0,,(Бейсбол командасы мүшелерінің дауыстары)
Dialogue: 0,0:10:33.17,0:10:37.21,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:10:44.56,0:10:45.64,Default,,0,0,0,,Жел
Dialogue: 0,0:10:46.68,0:10:47.73,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:10:57.19,0:10:58.94,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:59.78,0:11:02.20,Default,,0,0,0,,Мүмкін бұл еркелік шығар?
Dialogue: 0,0:11:02.28,0:11:05.95,Default,,0,0,0,,Жоқ, оны шынымен де әйел жазған шығар.
Dialogue: 0,0:11:06.04,0:11:07.41,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:11:08.45,0:11:11.42,Default,,0,0,0,,- (Юта) Оны кім жазғанын білесің бе? -(Нибутани) Оған дейін...
Dialogue: 0,0:11:12.12,0:11:14.09,Default,,0,0,0,,Бір көргеннен ғашық болу мүмкін бе?
Dialogue: 0,0:11:14.17,0:11:16.55,Default,,0,0,0,,Бұл мүмкін деп ойлайсыз ба?
Dialogue: 0,0:11:16.63,0:11:18.96,Default,,0,0,0,,- (Юта) Жоқ - (Исшики) Сіз жауап бермейсіз!
Dialogue: 0,0:11:19.05,0:11:21.47,Default,,0,0,0,,Басқаша айтқанда, бұл баланың жағдайы жақсы бола ма, жоқ па.
Dialogue: 0,0:11:21.55,0:11:23.39,Default,,0,0,0,,Енді не маңызды
Dialogue: 0,0:11:24.80,0:11:26.14,Default,,0,0,0,,- (Исшики) Уау - (Нибутани) Дұрыс.
Dialogue: 0,0:11:26.22,0:11:29.27,Default,,0,0,0,,Сіз бүгін көргеніңізді ұмытып қалдыңыз, солай ма?
Dialogue: 0,0:11:29.35,0:11:30.52,Default,,0,0,0,,бұл... иә
Dialogue: 0,0:11:30.60,0:11:32.77,Default,,0,0,0,,Аа, сізге жақсы.
Dialogue: 0,0:11:32.85,0:11:34.27,Default,,0,0,0,,Жақында кездескенше~
Dialogue: 0,0:11:34.36,0:11:35.69,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:11:36.23,0:11:38.07,Default,,0,0,0,,Сонымен, біз не істейміз?
Dialogue: 0,0:11:40.24,0:11:42.74,Default,,0,0,0,,Дұрыс, орындаңыз. Мен тырысамын.
Dialogue: 0,0:11:42.82,0:11:45.83,Default,,0,0,0,,- (Юта) Әй? -(Исшики) Кез келген адам келсін деп.
Dialogue: 0,0:11:45.91,0:11:49.87,Default,,0,0,0,,Сенбіге дейін сыныбыңыздағы барлық қыздарға модельдеу жасаңыз.
Dialogue: 0,0:11:49.95,0:11:52.25,Default,,0,0,0,,Жауап беруге дайын болыңыз
Dialogue: 0,0:11:52.33,0:11:53.50,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:11:53.58,0:11:54.88,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:11:54.96,0:11:56.54,Default,,0,0,0,,Кавайко-чан чемпионатында
Dialogue: 0,0:11:56.63,0:12:00.63,Default,,0,0,0,,Қыздар туралы барлық ақпаратты мен өз сыныбымдағы ұлдардан алдым.
Dialogue: 0,0:12:01.38,0:12:03.80,Default,,0,0,0,,Қазір бастасаңыз, міндетті түрде уақытында боласыз
Dialogue: 0,0:12:04.34,0:12:05.30,Default,,0,0,0,,Исшики…
Dialogue: 0,0:12:04.34,0:12:05.30,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:12:05.30,0:12:09.14,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:12:09.22,0:12:11.85,Default,,0,0,0,,Жарайды, менің уақытым жоқ, мен мынаны мінемін.
Dialogue: 0,0:12:11.93,0:12:12.94,Default,,0,0,0,,Кездескенше!
Dialogue: 0,0:12:17.61,0:12:18.65,Default,,0,0,0,,Иә
Dialogue: 0,0:12:23.61,0:12:25.95,Default,,0,0,0,,Не болды? Мен үйге бара жатырмын
Dialogue: 0,0:12:27.37,0:12:28.45,Default,,0,0,0,,Юта
Dialogue: 0,0:12:29.03,0:12:29.87,Default,,0,0,0,,Бұл — Они руының салты—
Dialogue: 0,0:12:29.95,0:12:31.95,Default,,0,0,0,,Не? қол?
Dialogue: 0,0:12:34.25,0:12:36.33,Default,,0,0,0,,- (Юта) Не!? - (Рикка) Тыныш қал.
Dialogue: 0,0:12:56.81,0:12:58.36,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:12:58.44,0:12:59.65,Default,,0,0,0,,Мен желді оқып отырдым
Dialogue: 0,0:12:59.73,0:13:02.65,Default,,0,0,0,,Әлде жел ме? О, сен білесің...
Dialogue: 0,0:13:02.74,0:13:04.45,Default,,0,0,0,,Жел шулы
Dialogue: 0,0:13:04.53,0:13:06.36,Default,,0,0,0,,Иә, бұл пойыздың дыбысы болуы керек.
Dialogue: 0,0:13:21.34,0:13:22.46,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:22.55,0:13:26.72,Default,,0,0,0,,Осы дәптерде Иномат мырзаның тапқаны рас болса.
Dialogue: 0,0:13:27.38,0:13:28.80,Default,,0,0,0,,Осы сыныптағы бала
Dialogue: 0,0:13:28.89,0:13:32.35,Default,,0,0,0,,Бұл оның қыздарды рұқсатсыз рейтингке қойғанын білдіреді.
Dialogue: 0,0:13:32.43,0:13:34.93,Default,,0,0,0,,Шынында да, бәрі жақсы
Dialogue: 0,0:13:35.02,0:13:37.60,Default,,0,0,0,,Сол кезде, станциядағы кешегі орындық
Dialogue: 0,0:13:37.69,0:13:40.23,Default,,0,0,0,,Иә, мүмкін.
Dialogue: 0,0:13:40.31,0:13:43.44,Default,,0,0,0,,Бірақ иесінің кім екенін әлі білмедік.
Dialogue: 0,0:13:43.53,0:13:44.36,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:13:44.44,0:13:48.70,Default,,0,0,0,,Мен бұл туралы бір адамнан естігім келеді.
Dialogue: 0,0:13:53.29,0:13:55.37,Default,,0,0,0,,- (Нюя) Йонеёси-кун - (Мера) Иә!
Dialogue: 0,0:13:56.62,0:13:57.62,Default,,0,0,0,,Йошикунха
Dialogue: 0,0:13:57.71,0:14:01.50,Default,,0,0,0,,Сіз осындай рейтинг құруға қатыстыңыз ба?
Dialogue: 0,0:14:01.59,0:14:05.71,Default,,0,0,0,,А, жоқ, уф, а, а...
Dialogue: 0,0:14:05.80,0:14:06.63,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:14:06.72,0:14:07.55,Default,,0,0,0,,«Арима»?
Dialogue: 0,0:14:07.63,0:14:10.05,Default,,0,0,0,,Аа, онша емес...
Dialogue: 0,0:14:10.14,0:14:12.64,Default,,0,0,0,,- (Мера) Ах! Ки... - (Нибутани) «Ки»?
Dialogue: 0,0:14:13.14,0:14:14.64,Default,,0,0,0,,Менің есімде жоқ!
Dialogue: 0,0:14:14.72,0:14:16.23,Default,,0,0,0,,(Студент қыздардың шуы)
Dialogue: 0,0:14:16.31,0:14:18.31,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті
Dialogue: 0,0:14:18.39,0:14:19.60,Default,,0,0,0,,Жағдайларды ескере отырып
Dialogue: 0,0:14:19.69,0:14:23.15,Default,,0,0,0,,Мен ұйымдастырушы екенім белгілі болғанша, бұл уақыт мәселесі.
Dialogue: 0,0:14:23.23,0:14:27.11,Default,,0,0,0,,Олай болса, әлі басталмаған махаббатым бітеді.
Dialogue: 0,0:14:27.19,0:14:29.99,Default,,0,0,0,,Ойлан, ойлан.
Dialogue: 0,0:14:30.07,0:14:33.41,Default,,0,0,0,,Умм, менің ойымша, сіз Тоғаши-куннан сұраңыз.
Dialogue: 0,0:14:33.49,0:14:36.16,Default,,0,0,0,,- (Юта) Иә!? - (Рейден) Иә, мен төрағамын.
Dialogue: 0,0:14:36.25,0:14:37.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:37.25,0:14:38.71,Default,,0,0,0,,Қалай ойлайсың, Тоғашы-күн?
Dialogue: 0,0:14:38.79,0:14:41.46,Default,,0,0,0,,Не? Жоқ, мен...
Dialogue: 0,0:14:41.54,0:14:42.84,Default,,0,0,0,,...
Dialogue: 0,0:14:42.92,0:14:46.21,Default,,0,0,0,,Им, жоқ, бұл...
Dialogue: 0,0:14:46.30,0:14:47.72,Default,,0,0,0,,А, анау... (Орыннан шыққан дыбыс)
Dialogue: 0,0:14:47.80,0:14:48.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.34,0:14:51.72,Default,,0,0,0,,- (Исшики) Бұл менмін - (Юта) Не!?
Dialogue: 0,0:14:51.80,0:14:54.10,Default,,0,0,0,,Мен мұны жаздым
Dialogue: 0,0:14:55.10,0:14:57.68,Default,,0,0,0,,Мен де рейтинг жасадым.
Dialogue: 0,0:14:57.77,0:15:01.02,Default,,0,0,0,,(Студент қыздардың сын дауыстары)
Dialogue: 0,0:15:01.10,0:15:03.69,Default,,0,0,0,,- (Юта) Исшики! -(Нибутани) Исшики-кун, бұл рас па?
Dialogue: 0,0:15:03.77,0:15:07.44,Default,,0,0,0,,Иә, бірақ мені қате түсінбеңіз.
Dialogue: 0,0:15:07.53,0:15:09.86,Default,,0,0,0,,Біз сабақта дауыс бермейміз.
Dialogue: 0,0:15:09.95,0:15:12.91,Default,,0,0,0,,Мен мұны өзім жаздым!
Dialogue: 0,0:15:15.49,0:15:18.79,Default,,0,0,0,,Кешіріңіз, бұл жай ғана көңіл көтеру үшін болды.
Dialogue: 0,0:15:18.87,0:15:20.91,Default,,0,0,0,,Басқа ұлдар маңызды емес.
Dialogue: 0,0:15:21.00,0:15:23.04,Default,,0,0,0,,Бәрі менікі, тек менікі
Dialogue: 0,0:15:23.13,0:15:26.55,Default,,0,0,0,,Жалғыз мен кінәлімін!
Dialogue: 0,0:15:27.46,0:15:31.01,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:15:31.55,0:15:32.59,Default,,0,0,0,,Ой...
Dialogue: 0,0:15:34.68,0:15:37.39,Default,,0,0,0,,- (Көшедегі самал) Қол соғатын жеріміз осы ма? -(Миябе) Дұрыс па?
Dialogue: 0,0:15:37.47,0:15:39.77,Default,,0,0,0,,Олай болса мұның бәрі Исшики-кун туралы.
Dialogue: 0,0:15:39.85,0:15:41.69,Default,,0,0,0,,Бұл сіз мұны жалғыз жасадыңыз дегенді білдіре ме?
Dialogue: 0,0:15:42.27,0:15:43.77,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:15:43.85,0:15:47.15,Default,,0,0,0,,Біліп, қызды ренжіткенім рас.
Dialogue: 0,0:15:47.23,0:15:48.73,Default,,0,0,0,,Енді осылай болған соң, мен
Dialogue: 0,0:15:48.82,0:15:51.24,Default,,0,0,0,,Мен кішіпейілділікпен кешірім сұраймын!
Dialogue: 0,0:15:51.32,0:15:52.32,Default,,0,0,0,,Ха~
Dialogue: 0,0:15:52.40,0:15:53.91,Default,,0,0,0,,Исшики сен...
Dialogue: 0,0:15:53.99,0:15:57.24,Default,,0,0,0,,Сіз соншалықты көп істеуіңіз керек, солай ма? адам ретінде
Dialogue: 0,0:15:57.33,0:15:58.54,Default,,0,0,0,,Бірақ монах!?
Dialogue: 0,0:15:58.62,0:16:01.41,Default,,0,0,0,,Иә, көп нәрсе істеудің қажеті жоқ.
Dialogue: 0,0:16:02.37,0:16:06.59,Default,,0,0,0,,Жоқ, еркек осылай істеу керек.
Dialogue: 0,0:16:06.67,0:16:09.34,Default,,0,0,0,,Уа, сен кімсің?
Dialogue: 0,0:16:10.17,0:16:12.01,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:16:12.09,0:16:14.51,Default,,0,0,0,,Оттан каштан алуға батыл болсаң
Dialogue: 0,0:16:14.59,0:16:16.93,Default,,0,0,0,,Бұл стратегия өте керемет көрінеді!
Dialogue: 0,0:16:17.01,0:16:17.85,Default,,0,0,0,,Жақсы
Dialogue: 0,0:16:17.93,0:16:21.56,Default,,0,0,0,,Не керек, бұл еркектік еркектерді қорғап, кінәні өзіне алады.
Dialogue: 0,0:16:21.64,0:16:25.02,Default,,0,0,0,,Бірақ ол баспен не істейсің?
Dialogue: 0,0:16:25.10,0:16:27.15,Default,,0,0,0,,Не? Бұл монах туралы ма?
Dialogue: 0,0:16:27.23,0:16:30.36,Default,,0,0,0,,Жоқ, солай дедім.
Dialogue: 0,0:16:30.44,0:16:32.95,Default,,0,0,0,,Мен сізге осындай шешімді көрсетуім керек.
Dialogue: 0,0:16:33.03,0:16:35.78,Default,,0,0,0,,Бірақ сіз: «Бұл масқара» дедіңіз.
Dialogue: 0,0:16:35.86,0:16:37.24,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:16:37.32,0:16:39.24,Default,,0,0,0,,Мен бәрінің бұл туралы байыпты екеніне сене алмаймын ...
Dialogue: 0,0:16:39.33,0:16:41.16,Default,,0,0,0,,- (Нибутани) Ойланып жатырмын - (Исшики) Уау! Уф\NНибутанидегі
Dialogue: 0,0:16:41.25,0:16:43.08,Default,,0,0,0,,Қашан?
Dialogue: 0,0:16:43.58,0:16:46.17,Default,,0,0,0,,Мен саған айтамын, қыздарда әлі де күмән бар.
Dialogue: 0,0:16:46.25,0:16:48.92,Default,,0,0,0,,- (Исшики) Иә? -(Нибутани) Қанша айтсаң да,
Dialogue: 0,0:16:49.00,0:16:50.80,Default,,0,0,0,,Саған ешкім сенбейді.
Dialogue: 0,0:16:50.88,0:16:53.22,Default,,0,0,0,,Исшики-кун шешпегенше.
Dialogue: 0,0:16:53.30,0:16:54.47,Default,,0,0,0,,О, мен?
Dialogue: 0,0:16:54.55,0:16:55.93,Default,,0,0,0,,Бұл анық емес пе?
Dialogue: 0,0:16:56.01,0:16:58.30,Default,,0,0,0,,Исшики-кун осылай деді.
Dialogue: 0,0:16:58.97,0:17:02.02,Default,,0,0,0,,Бұл өтірік! Бұл өтірік!
Dialogue: 0,0:17:03.31,0:17:05.98,Default,,0,0,0,,Мен сізден тағы сұрайын, сіз байсалдысыз ба?
Dialogue: 0,0:17:06.06,0:17:08.56,Default,,0,0,0,,Маған ұнамайды, маған ұнамайды.
Dialogue: 0,0:17:08.65,0:17:12.86,Default,,0,0,0,,Кіші мектепте үш жыл бойы қырылған бас өміріне шыдап, ақыры алған шашым.
Dialogue: 0,0:17:12.94,0:17:13.94,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:17:14.03,0:17:16.99,Default,,0,0,0,,Егер солай болса, кешіріңіз және ертең кешірім сұраңыз...
Dialogue: 0,0:17:17.07,0:17:21.49,Default,,0,0,0,,Егер мен мұны істесем, мен мүлде ақымақ болар едім.
Dialogue: 0,0:17:21.58,0:17:25.12,Default,,0,0,0,,Нибутани айтқандай, мен бұл жерде кінәні өз мойныма алуым керек.
Dialogue: 0,0:17:25.21,0:17:27.83,Default,,0,0,0,,Сыныптағы қызға және маған махаббат хатын жіберген қызға.
Dialogue: 0,0:17:27.92,0:17:29.71,Default,,0,0,0,,Сіз, әрине, сәтсіздікке ұқсайсыз.
Dialogue: 0,0:17:29.79,0:17:32.67,Default,,0,0,0,,Жоқ, егер мен мұны бұрын айтқан болсам.
Dialogue: 0,0:17:32.76,0:17:35.42,Default,,0,0,0,,Барлық ұлдар тағы да күдіктенеді.
Dialogue: 0,0:17:35.51,0:17:36.34,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:17:36.43,0:17:39.30,Default,,0,0,0,,Мен дауыс сұраған адам болдым.
Dialogue: 0,0:17:39.39,0:17:41.60,Default,,0,0,0,,Оны алып тастамас бұрын оны өзіңіз қолданған дұрыс.
Dialogue: 0,0:17:42.35,0:17:43.56,Default,,0,0,0,,Ол да еркек, солай ма?
Dialogue: 0,0:17:43.64,0:17:44.73,Default,,0,0,0,,Дарн Яан
Dialogue: 0,0:17:44.81,0:17:45.73,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:45.81,0:17:47.77,Default,,0,0,0,,Jan~n dadada~
Dialogue: 0,0:17:47.85,0:17:50.73,Default,,0,0,0,,Нуо, қанша адам өлді? Бұл
Dialogue: 0,0:17:50.81,0:17:52.57,Default,,0,0,0,,Мүмкін жапондық Харакири?
Dialogue: 0,0:17:52.65,0:17:53.48,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:53.57,0:17:54.69,Default,,0,0,0,,Ұқсас емес
Dialogue: 0,0:17:54.78,0:17:56.53,Default,,0,0,0,,Тез кесіңіз!
Dialogue: 0,0:17:56.61,0:17:57.86,Default,,0,0,0,,Мм, балалар.
Dialogue: 0,0:17:58.32,0:17:59.66,Default,,0,0,0,,Сіз жолға түсіп қалдыңыз, сондықтан кетіңіз!
Dialogue: 0,0:17:59.74,0:18:01.91,Default,,0,0,0,,Бұл қоғамның жасырынған жері. Меншік құқығы - бұл...
Dialogue: 0,0:18:01.99,0:18:03.62,Default,,0,0,0,,- (Юта) Жақында бітеді - (Декомори) Бір минут күтіңіз Өлім
Dialogue: 0,0:18:03.70,0:18:04.95,Default,,0,0,0,,Ууууууууууууууууу!
Dialogue: 0,0:18:05.04,0:18:06.75,Default,,0,0,0,,Ма, менің қызметшім!
Dialogue: 0,0:18:06.83,0:18:07.96,Default,,0,0,0,,Сен шынымен де тамаша ФБР агенті болдың.
Dialogue: 0,0:18:08.46,0:18:09.37,Default,,0,0,0,,Пломба?
Dialogue: 0,0:18:13.46,0:18:15.05,Default,,0,0,0,,Сәлем Юта
Dialogue: 0,0:18:15.13,0:18:16.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:16.09,0:18:18.26,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,0:18:18.76,0:18:22.51,Default,,0,0,0,,Сізбен кіру салтанатында сөйлескеніме қуаныштымын.
Dialogue: 0,0:18:22.60,0:18:24.43,Default,,0,0,0,,- (Юта) Ах - (Исшики) Менің қариям.
Dialogue: 0,0:18:24.52,0:18:27.52,Default,,0,0,0,,Менің шашым 35 жаста бітті
Dialogue: 0,0:18:27.60,0:18:28.85,Default,,0,0,0,,Егер ол тұқым қуалайтын болса
Dialogue: 0,0:18:28.94,0:18:32.31,Default,,0,0,0,,Шаш үлгісін өзгерткеніме 20 жылдай болды.
Dialogue: 0,0:18:32.82,0:18:36.32,Default,,0,0,0,,Сол жылдың үш жылын монах ретінде өткізді және
Dialogue: 0,0:18:36.40,0:18:39.95,Default,,0,0,0,,Осындай жағдайдың қайталануы ақымақтық.
Dialogue: 0,0:18:40.03,0:18:41.74,Default,,0,0,0,,Исшики!
Dialogue: 0,0:18:41.82,0:18:44.74,Default,,0,0,0,,О, мен... Уф.
Dialogue: 0,0:18:45.37,0:18:47.70,Default,,0,0,0,,Неге жылайсың, Юта?
Dialogue: 0,0:18:48.50,0:18:51.21,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:18:51.29,0:18:53.29,Default,,0,0,0,,Енді өз қалауыңыз бойынша жасаңыз.
Dialogue: 0,0:18:53.38,0:18:55.17,Default,,0,0,0,,Қолдарыңызбен!
Dialogue: 0,0:18:55.25,0:18:56.67,Default,,0,0,0,,Исшики!
Dialogue: 0,0:18:56.67,0:18:58.09,Default,,0,0,0,,Исшики!
Dialogue: 0,0:18:56.67,0:18:58.09,Default,,0,0,0,,- (Жүзу үйірмесінің мүшелері) А? - (Студент қыз) А?
Dialogue: 0,0:18:58.09,0:19:00.80,Default,,0,0,0,,Исшики~!
Dialogue: 0,0:19:01.64,0:19:04.05,Default,,0,0,0,,Иә? Барлығына не болды?
Dialogue: 0,0:19:04.14,0:19:05.56,Default,,0,0,0,,Мөрленген
Dialogue: 0,0:19:05.64,0:19:07.22,Default,,0,0,0,,- (Декомори) Әй? -(Рикка) Шешілді
Dialogue: 0,0:19:08.02,0:19:09.43,Default,,0,0,0,,- (Нибутани) Бұл аяқталды ма? -(Декомори) Ах.
Dialogue: 0,0:19:09.52,0:19:10.73,Default,,0,0,0,,Менің қызметшілерім!
Dialogue: 0,0:19:10.81,0:19:12.69,Default,,0,0,0,,Әй, бітті.
Dialogue: 0,0:19:12.77,0:19:15.82,Default,,0,0,0,,Бірақ дәл қазір Исшики қатты қобалжыды.
Dialogue: 0,0:19:15.90,0:19:16.98,Default,,0,0,0,,Барлығыңыз өтінемін
Dialogue: 0,0:19:17.07,0:19:19.19,Default,,0,0,0,,Сіз оның көңілін көтере аласыз ба?
Dialogue: 0,0:19:20.90,0:19:23.57,Default,,0,0,0,,- (Нибутани) Дұрыс - (Рикка) Түсіндім. Мен саған сиқырлы күш беремін.
Dialogue: 0,0:19:23.66,0:19:25.37,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ маған қалдырыңыз.
Dialogue: 0,0:19:25.45,0:19:26.29,Default,,0,0,0,,Демек, бұл… иллюзия.
Dialogue: 0,0:19:26.37,0:19:29.37,Default,,0,0,0,,Бұған дейін бірдеңе айтайын.
Dialogue: 0,0:19:30.04,0:19:31.00,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:19:32.25,0:19:33.21,Default,,0,0,0,,Күлме
Dialogue: 0,0:19:33.79,0:19:34.84,Default,,0,0,0,,Иә
Dialogue: 0,0:19:36.04,0:19:37.46,Default,,0,0,0,,Ха~хахахаха!
Dialogue: 0,0:19:37.55,0:19:38.46,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:38.55,0:19:40.47,Default,,0,0,0,,Сіз мені тыңдамадыңыз ба?
Dialogue: 0,0:19:40.55,0:19:41.68,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:41.76,0:19:43.59,Default,,0,0,0,,- (Рикка) Исшики - (Исшики) О О
Dialogue: 0,0:19:44.05,0:19:46.97,Default,,0,0,0,,Ерлігіңе қуат бергім келеді. Мында басыңыз.
Dialogue: 0,0:19:47.06,0:19:48.14,Default,,0,0,0,,О
Dialogue: 0,0:19:48.72,0:19:50.98,Default,,0,0,0,,Мұнда қараңғылық күштері жиналады.
Dialogue: 0,0:19:51.06,0:19:54.19,Default,,0,0,0,,Осыны менің өміріммен жарылқа
Dialogue: 0,0:19:56.94,0:20:00.82,Default,,0,0,0,,- (Декомори/Нибутани) Ахахахха - (Юта) Эй! Әй, жігіттер!
Dialogue: 0,0:20:00.90,0:20:02.61,Default,,0,0,0,,Өйткені, өйткені
Dialogue: 0,0:20:02.70,0:20:04.57,Default,,0,0,0,,Тым көп жойқын күші бар өлім
Dialogue: 0,0:20:04.66,0:20:06.53,Default,,0,0,0,,(Декомори мен Нибутанидің күлкісі)
Dialogue: 0,0:20:06.62,0:20:07.62,Default,,0,0,0,,Дегенмен, не болып жатқанын түсінбеймін.
Dialogue: 0,0:20:07.70,0:20:08.87,Default,,0,0,0,,Күлме!
Dialogue: 0,0:20:07.70,0:20:08.87,Default,,0,0,0,,Сүйкімді қыздың рейтингі мәселесі қандай да бір жолмен шешілді.
Dialogue: 0,0:20:08.87,0:20:08.95,Default,,0,0,0,,Сүйкімді қыздың рейтингі мәселесі қандай да бір жолмен шешілді.
Dialogue: 0,0:20:08.95,0:20:11.37,Default,,0,0,0,,Сүйкімді қыздың рейтингі мәселесі шешілді.
Dialogue: 0,0:20:08.95,0:20:11.37,Default,,0,0,0,,Балалар, сендерде адамның жүрегі жоқ па?
Dialogue: 0,0:20:12.37,0:20:15.33,Default,,0,0,0,,Және гинкго ағашының астында
Dialogue: 0,0:20:15.42,0:20:17.59,Default,,0,0,0,,Махаббат хатындағы қыз шығады.
Dialogue: 0,0:20:17.67,0:20:20.26,Default,,0,0,0,,Мен біраз үмітпен келдім.
Dialogue: 0,0:20:20.34,0:20:22.01,Default,,0,0,0,,Тағдырлы сенбі
Dialogue: 0,0:20:22.80,0:20:24.30,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:20:24.38,0:20:27.47,Default,,0,0,0,,Исшики-кун
Dialogue: 0,0:20:27.55,0:20:28.85,Default,,0,0,0,,Исшики
Dialogue: 0,0:20:28.93,0:20:30.60,Default,,0,0,0,,Менің сыныбымдағы ұлдардан
Dialogue: 0,0:20:28.93,0:20:30.60,Default,,0,0,0,,Эй
Dialogue: 0,0:20:30.68,0:20:33.60,Default,,0,0,0,,Біз күтпеген ынталы қолдауға ие болдық.
Dialogue: 0,0:20:33.69,0:20:36.61,Default,,0,0,0,,Фуфууууууууууууууууууу
Dialogue: 0,0:20:38.86,0:20:40.65,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:20:40.73,0:20:43.61,Default,,0,0,0,,Сонымен махаббат хатының иесі ешқашан келмеді.
Dialogue: 0,0:20:44.20,0:20:46.57,Default,,0,0,0,,Нибутани Ешкім білмейді ме?
Dialogue: 0,0:20:46.66,0:20:49.33,Default,,0,0,0,,Білсеңіз де, бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:20:49.95,0:20:51.08,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:51.79,0:20:52.87,Default,,0,0,0,,Бірақ жақсы
Dialogue: 0,0:20:52.96,0:20:55.54,Default,,0,0,0,,Баланы қорғап, қырынған дұрыс бала еттім.
Dialogue: 0,0:20:55.62,0:20:58.09,Default,,0,0,0,,Бұл сезім жаман емес, солай ма?
Dialogue: 0,0:20:58.17,0:21:00.17,Default,,0,0,0,,Ойлайтын қыздар бар шығар...
Dialogue: 0,0:21:00.25,0:21:01.09,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:21:01.17,0:21:03.51,Default,,0,0,0,,Сіз ақымақ бола алмайсыз.
Dialogue: 0,0:21:03.97,0:21:05.18,Default,,0,0,0,,- (Исшики) Мені қалжыңдап тұрсың ба!? - Әй?
Dialogue: 0,0:21:05.26,0:21:06.59,Default,,0,0,0,,Ха, ха, ха!
Dialogue: 0,0:21:06.68,0:21:08.60,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:21:08.68,0:21:12.02,Default,,0,0,0,,Мен оған қарсы тұра алмадым.
Dialogue: 0,0:21:12.10,0:21:14.56,Default,,0,0,0,,Өтінемін, Исшики-кун, мен саған тиісейін.
Dialogue: 0,0:21:15.27,0:21:16.94,Default,,0,0,0,,Ха... Ах ха
Dialogue: 0,0:21:17.44,0:21:19.90,Default,,0,0,0,,ше? Эй, эй, сен
Dialogue: 0,0:21:20.82,0:21:23.74,Default,,0,0,0,,Жазғы демалыс келе жатыр
Dialogue: 0,0:21:28.66,0:21:30.20,Default,,0,0,0,,Эй Юта, не істеуіміз керек?
Dialogue: 0,0:21:30.28,0:21:31.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:31.20,0:21:32.41,Default,,0,0,0,,Әкем
Dialogue: 0,0:21:32.49,0:21:35.62,Default,,0,0,0,,Ол биыл Жапонияға қайта келе алмайтынын айтады.
Dialogue: 0,0:21:35.71,0:21:38.58,Default,,0,0,0,,Мен Джакартаға баратын сияқтымын.
Dialogue: 0,0:21:38.67,0:21:40.84,Default,,0,0,0,,Хмм, мен бұл туралы ойланамын.
Dialogue: 0,0:21:43.17,0:21:44.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:44.63,0:21:45.63,Default,,0,0,0,,Юта
Dialogue: 0,0:21:45.72,0:21:48.39,Default,,0,0,0,,Менің сенен бір жақсылығым бар.
Dialogue: 0,0:21:48.47,0:21:49.72,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:21:49.80,0:21:52.93,Default,,0,0,0,,Жазғы демалысқа Риккамен бірге келгеніңізді қалаймын.
Dialogue: 0,0:21:53.02,0:21:54.64,Default,,0,0,0,,бұл...
Dialogue: 0,0:21:54.73,0:21:58.19,Default,,0,0,0,,Маған сен керексің...
Dialogue: 0,0:21:59.86,0:22:02.86,Default,,0,0,0,,Жаз басталады
Dialogue: 0,0:22:06.57,0:22:08.57,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.99,0:23:36.03,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.53,0:23:43.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory