Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.40,0:00:43.99,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:00:53.68,0:00:55.23,Default,,0,0,0,,(Курокири) Шигараки, күткен нәтижеңді алдың ба?
Dialogue: 0,0:00:56.08,0:00:57.91,Default,,0,0,0,,Менің атым Изуми Назэ.
Dialogue: 0,0:00:58.00,0:00:59.86,Default,,0,0,0,,Назе? Наз отбасы
Dialogue: 0,0:01:00.13,0:01:01.27,Default,,0,0,0,,Иә
Dialogue: 0,0:01:01.36,0:01:04.39,Default,,0,0,0,,Мен саған бірдеңе айтайын деп телефон соқтым.
Dialogue: 0,0:01:14.84,0:01:38.99,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:02:12.20,0:02:13.83,Default,,0,0,0,,Мираи Курияма?
Dialogue: 0,0:02:15.20,0:02:17.83,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Изуми Назимін.
Dialogue: 0,0:02:18.68,0:02:19.75,Default,,0,0,0,,Мираи Курияма
Dialogue: 0,0:02:20.24,0:02:22.99,Default,,0,0,0,,Ол қарғыс атқан қанды заңды түрде мұра еткен бөтен жауынгер.
Dialogue: 0,0:02:23.20,0:02:28.22,Default,,0,0,0,,Басқа көптеген шетелдіктер жек көретін отбасы?
Dialogue: 0,0:02:28.41,0:02:29.51,Default,,0,0,0,,Иә
Dialogue: 0,0:02:30.12,0:02:31.39,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:02:41.52,0:02:44.47,Default,,0,0,0,,Шабуыл жасау үшін өз қанын басқарады
Dialogue: 0,0:02:44.60,0:02:47.71,Default,,0,0,0,,Ол қатайып қана қоймайды, сонымен бірге күшті уы да бар.
Dialogue: 0,0:02:47.84,0:02:50.67,Default,,0,0,0,,Қарсыластың ішкі тіндерін де жоюға болады
Dialogue: 0,0:02:50.76,0:02:53.04,Default,,0,0,0,,Сіз оны жеңе аласыз ба?
Dialogue: 0,0:02:53.04,0:02:54.83,Default,,0,0,0,,Қазіргі уақытта ештеңе мүмкін емес.
Dialogue: 0,0:02:54.92,0:02:57.11,Default,,0,0,0,,Бірақ біз бұл мүмкін деп ойлаймыз
Dialogue: 0,0:02:57.36,0:03:00.79,Default,,0,0,0,,Субъекті өлмейтін деп айтады, солай ма?
Dialogue: 0,0:03:00.88,0:03:01.95,Default,,0,0,0,,Иә
Dialogue: 0,0:03:02.80,0:03:03.79,Default,,0,0,0,,Өлмейтіндік?
Dialogue: 0,0:03:03.88,0:03:07.91,Default,,0,0,0,,Шындығында, регенерация қабілеті қорқынышты түрде жылдам.
Dialogue: 0,0:03:08.64,0:03:10.39,Default,,0,0,0,,«Өлмейтін жартылай жын»
Dialogue: 0,0:03:10.48,0:03:13.27,Default,,0,0,0,,Айналадағы жат планеталықтар осылай дейді.
Dialogue: 0,0:03:13.52,0:03:15.55,Default,,0,0,0,,«Өлмейтін жартылай жын»?
Dialogue: 0,0:03:16.16,0:03:17.23,Default,,0,0,0,,Мен саған көрсетемін
Dialogue: 0,0:03:19.60,0:03:21.07,Default,,0,0,0,,Жын ұстаудан айырмашылығы
Dialogue: 0,0:03:21.16,0:03:25.63,Default,,0,0,0,,Жартылай адам, жартылай йоумның мүмкін емес және қауіпті болуы
Dialogue: 0,0:03:25.76,0:03:30.23,Default,,0,0,0,,Мен оны қарасам, youmu бөлігі шекарадан тыс жерде тұрған сияқты.
Dialogue: 0,0:03:30.60,0:03:34.67,Default,,0,0,0,,Менің інім осы шайқаста қаза тапты.
Dialogue: 0,0:03:34.76,0:03:36.95,Default,,0,0,0,,Мен ауыр жарақат алдым, өлім аузында.
Dialogue: 0,0:03:38.80,0:03:42.23,Default,,0,0,0,,Сізден сұрайтын жалғыз өтінішім
Dialogue: 0,0:03:43.28,0:03:48.59,Default,,0,0,0,,Бұл шекараның екінші жағы, осы адам
Dialogue: 0,0:03:49.60,0:03:53.79,Default,,0,0,0,,Сізді осындай ресми орынға отырғызғаным үшін кешіріңіз.
Dialogue: 0,0:03:53.96,0:03:57.75,Default,,0,0,0,,Бәлкім, бұл жер көне жер болғандықтан, әдет-ғұрыптар көп.
Dialogue: 0,0:03:57.92,0:03:58.73,Default,,0,0,0,,Бонсай?
Dialogue: 0,0:03:58.73,0:03:59.83,Default,,0,0,0,,Иә
Dialogue: 0,0:03:59.96,0:04:01.24,Default,,0,0,0,,Одан да көп
Dialogue: 0,0:04:01.24,0:04:02.19,Default,,0,0,0,,Не?
Dialogue: 0,0:04:02.28,0:04:05.09,Default,,0,0,0,,Сонымен... шекарадан қай жерде?
Dialogue: 0,0:04:05.12,0:04:08.43,Default,,0,0,0,,Уайымдама, мен сені қадағалаймын.
Dialogue: 0,0:04:08.56,0:04:11.59,Default,,0,0,0,,Қалай болғанда да, мен оны өлтіруім керек.
Dialogue: 0,0:04:11.80,0:04:13.20,Default,,0,0,0,,Неғұрлым тезірек болса, соғұрлым жақсы
Dialogue: 0,0:04:13.20,0:04:13.98,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:04:15.04,0:04:17.51,Default,,0,0,0,,Мұны түсіну мүмкін емес!
Dialogue: 0,0:04:17.64,0:04:18.79,Default,,0,0,0,,Жаңа ғана айттыңыз... (Изуми) Жоқ.
Dialogue: 0,0:04:19.64,0:04:23.19,Default,,0,0,0,,«Дайынсың ба?» дегенді білдіреді.
Dialogue: 0,0:04:30.44,0:04:34.15,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:04:34.48,0:04:37.63,Default,,0,0,0,,Жартылай жынның аты – «Акихито Канбара»
Dialogue: 0,0:04:47.48,0:04:48.59,Default,,0,0,0,,Егер солай болса, онда онда бір із бар шығар.
Dialogue: 0,0:04:49.84,0:04:55.83,Default,,0,0,0,,Сөздікте «өз өмірін қию» деген мағынада берілген.
Dialogue: 0,0:04:56.44,0:05:00.51,Default,,0,0,0,,Бұл мен ешқашан әрекет етпейтін нәрсе шығар.
Dialogue: 0,0:05:03.12,0:05:05.99,Default,,0,0,0,,Бұл моральдық идея емес
Dialogue: 0,0:05:06.08,0:05:09.51,Default,,0,0,0,,Бұл негізгі себепке байланысты.
Dialogue: 0,0:05:09.76,0:05:12.19,Default,,0,0,0,,Бұл туралы кейінірек сөйлесейік.
Dialogue: 0,0:05:12.88,0:05:15.39,Default,,0,0,0,,Әйтеуір, ол қазір өлетін болды.
Dialogue: 0,0:05:16.64,0:05:19.27,Default,,0,0,0,,Ол кезде маған солай көрінді.
Dialogue: 0,0:05:19.88,0:05:24.27,Default,,0,0,0,,Мұнда әңгіме кең түрде екі бөлікке бөлінеді.
Dialogue: 0,0:05:24.68,0:05:30.19,Default,,0,0,0,,Бір бағыт – кейіпкердің оқиғаға және прогреске белсенді қатысуы.
Dialogue: 0,0:05:30.32,0:05:36.11,Default,,0,0,0,,Бірі – басты кейіпкер пассивті және оқиға өздігінен өрбиді.
Dialogue: 0,0:05:36.68,0:05:39.39,Default,,0,0,0,,Мен соңғы типте болдым.
Dialogue: 0,0:05:39.52,0:05:42.95,Default,,0,0,0,,Неге екені белгісіз, мен бұл жолы біріншісін таңдадым.
Dialogue: 0,0:05:44.56,0:05:45.79,Default,,0,0,0,,А... бұл!
Dialogue: 0,0:05:50.52,0:05:53.40,Default,,0,0,0,,Қандай сөздер қолданылғанын қалдырамын.
Dialogue: 0,0:05:53.84,0:05:58.07,Default,,0,0,0,,Әйтеуір, сіз сияқты көзілдірікпен жақсы көрінетіндер бар.
Dialogue: 0,0:05:58.20,0:05:59.55,Default,,0,0,0,,Өлме!
Dialogue: 0,0:06:00.08,0:06:02.99,Default,,0,0,0,,...
Dialogue: 0,0:06:04.32,0:06:08.19,Default,,0,0,0,,Ақырында бар жүрегіммен айқайладым.
Dialogue: 0,0:06:08.40,0:06:10.47,Default,,0,0,0,,Қысқасы, мен көзілдірікті жақсы көремін!
Dialogue: 0,0:06:12.24,0:06:13.35,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:06:23.84,0:06:24.99,Default,,0,0,0,,Сен... Уау!
Dialogue: 0,0:06:30.16,0:06:32.87,Default,,0,0,0,,А...екінші жақ жаман болды.
Dialogue: 0,0:06:36.08,0:06:37.63,Default,,0,0,0,,Осымен
Dialogue: 0,0:06:37.76,0:06:41.25,Default,,0,0,0,,Бұл туралы бірдеңе істей аласыз ба?
Dialogue: 0,0:06:41.86,0:06:42.89,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:06:48.24,0:06:51.75,Default,,0,0,0,,Мирай Курияма екеуміз осылай таныстық.
Dialogue: 0,0:06:52.32,0:06:56.27,Default,,0,0,0,,Егер бұл екі адам уақытша қарым-қатынаста болса ше?
Dialogue: 0,0:06:56.96,0:07:01.03,Default,,0,0,0,,Бұл әлемде барлық оқиғалар болуы мүмкін емес.
Dialogue: 0,0:07:25.20,0:07:26.47,Default,,0,0,0,,Сіз оны шашыңыз ба?
Dialogue: 0,0:07:26.80,0:07:28.83,Default,,0,0,0,,Уау! қайдан келе жатырсың
Dialogue: 0,0:07:40.16,0:07:41.83,Default,,0,0,0,,Эй...шелекті сындырайын деп жатырмын.
Dialogue: 0,0:07:46.40,0:07:49.31,Default,,0,0,0,,Ита...қазірдің өзінде!
Dialogue: 0,0:08:15.04,0:08:17.64,Default,,0,0,0,,Мен мұны қазір аяқтаған дұрыс деп ойлаймын.
Dialogue: 0,0:08:18.76,0:08:19.83,Default,,0,0,0,,Бұл қорқынышты фильм бе?
Dialogue: 0,0:08:23.36,0:08:26.19,Default,,0,0,0,,Бұл... қараңғы. Не істеп жатырсың, Сенпай? ?
Dialogue: 0,0:08:26.32,0:08:28.19,Default,,0,0,0,,Бұл шелек.
Dialogue: 0,0:08:32.84,0:08:34.23,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:08:36.08,0:08:38.23,Default,,0,0,0,,Сіздің қарныңыз ашты ма?
Dialogue: 0,0:08:38.68,0:08:41.41,Default,,0,0,0,,Жақсы, ол азаймайды!
Dialogue: 0,0:08:41.41,0:08:44.54,Default,,0,0,0,,Ол азаяды! Жүрегің шегіне жетеді!
Dialogue: 0,0:08:44.56,0:08:48.63,Default,,0,0,0,,Мен айттым ғой! Сіз ауырсынуды сезінесіз дейсіз, бірақ қаншалықты ауырады деп ойлайсыз?
Dialogue: 0,0:08:48.72,0:08:52.15,Default,,0,0,0,,Өлмейтін болғаныңыз үшін қалағаныңызды жасай аласыз деу - өлмейтіндерді кемсіту!
Dialogue: 0,0:08:52.24,0:08:53.75,Default,,0,0,0,,Оны айналаңыздағы адамдар ести алады.
Dialogue: 0,0:08:53.88,0:08:56.84,Default,,0,0,0,,Жарайды. Мен айналада ешкімнің жоқтығына көз жеткіздім.
Dialogue: 0,0:08:56.92,0:08:58.59,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:08:58.84,0:09:00.87,Default,,0,0,0,,Мұнда қосымша буррито және
Dialogue: 0,0:09:00.96,0:09:03.51,Default,,0,0,0,,Моль поблано және чили кон-карне жиынтығы
Dialogue: 0,0:09:03.88,0:09:04.91,Default,,0,0,0,,Уақытыңызды бөліңіз.
Dialogue: 0,0:09:05.20,0:09:06.91,Default,,0,0,0,,Сіз әлі сұрадыңыз ба?
Dialogue: 0,0:09:07.04,0:09:08.08,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:09:08.08,0:09:10.19,Default,,0,0,0,,Бұл жағымсыз.
Dialogue: 0,0:09:10.32,0:09:13.95,Default,,0,0,0,,Оны тек жаттығу үстелі ретінде пайдаланған жоқ, сонымен қатар оған тамақ берілді.
Dialogue: 0,0:09:14.08,0:09:17.99,Default,,0,0,0,,Тару? Бұл мәміленің шарты, солай ма?
Dialogue: 0,0:09:18.08,0:09:21.07,Default,,0,0,0,,Мен бүгін бұдан былай ұрыспайтыным үшін.
Dialogue: 0,0:09:21.16,0:09:22.75,Default,,0,0,0,,Күріш сатып алу
Dialogue: 0,0:09:22.88,0:09:26.27,Default,,0,0,0,,Бұл ертең тағы да шабуыл жасайды дегенді білдіре ме?
Dialogue: 0,0:09:26.36,0:09:27.81,Default,,0,0,0,,Олай емес пе?
Dialogue: 0,0:09:37.48,0:09:38.86,Default,,0,0,0,,Жарайсың ба, Курияма-сан?
Dialogue: 0,0:09:40.40,0:09:42.75,Default,,0,0,0,,Ештеңе етпейді, қан аздығым бар.
Dialogue: 0,0:09:43.12,0:09:45.47,Default,,0,0,0,,Қан қолданылады...
Dialogue: 0,0:09:47.96,0:09:53.43,Default,,0,0,0,,Ертең Аяқаның орнына апарайық. Мен оны таңертең алып кетемін.
Dialogue: 0,0:09:54.28,0:09:59.99,Default,,0,0,0,,Кеткеніңіз дұрыс, өйткені сіз ұстап тұрған күш бәрібір босап қалады.
Dialogue: 0,0:10:00.16,0:10:03.47,Default,,0,0,0,,Өлмейтін болсаң да, тиіссең де бекер емес.
Dialogue: 0,0:10:03.96,0:10:06.79,Default,,0,0,0,,Бірақ қан қан, солай ма?
Dialogue: 0,0:10:09.52,0:10:11.07,Default,,0,0,0,,Қатысыңыз
Dialogue: 0,0:10:13.24,0:10:14.70,Default,,0,0,0,,Сіз мұны өзіңіз жасай аласыз
Dialogue: 0,0:10:14.70,0:10:15.83,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:10:20.28,0:10:22.83,Default,,0,0,0,,Курияма-сан, сен клубтық іс-шараларға қатыспайсың ба?
Dialogue: 0,0:10:23.16,0:10:25.14,Default,,0,0,0,,Бізде ондай сән-салтанат жоқ.
Dialogue: 0,0:10:25.14,0:10:27.11,Default,,0,0,0,,Сіз әдебиет үйірмесіне қызығасыз ба?
Dialogue: 0,0:10:27.20,0:10:28.07,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:10:28.52,0:10:30.31,Default,,0,0,0,,Себебі мен көзілдірік киген әдемі қызды қалаймын
Dialogue: 0,0:10:30.64,0:10:31.83,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:10:32.52,0:10:36.35,Default,,0,0,0,,Жарайды, мен қосылдым, демек шын мәнінде екі ғана мүше бар.
Dialogue: 0,0:10:37.08,0:10:41.87,Default,,0,0,0,,А, екіншісі де бөтен адам, сондықтан жұмысқа көп жағынан пайдалы болатынына сенімдімін.
Dialogue: 0,0:10:43.92,0:10:45.28,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:10:45.28,0:10:46.99,Default,,0,0,0,,Не? Неліктен?
Dialogue: 0,0:10:47.36,0:10:50.19,Default,,0,0,0,,Мен басқалармен қарым-қатынаста болғым келмейді.
Dialogue: 0,0:10:55.64,0:11:00.19,Default,,0,0,0,,Өйткені, өлместік сипаттарын түсіну оңай емес.
Dialogue: 0,0:11:00.28,0:11:01.27,Default,,0,0,0,,Иә
Dialogue: 0,0:11:01.36,0:11:03.56,Default,,0,0,0,,Мен қарап шыққаным жөн.
Dialogue: 0,0:11:03.92,0:11:07.63,Default,,0,0,0,,Соқыр шабуыл жасасаң да, қайта-қайта солай болады.
Dialogue: 0,0:11:07.72,0:11:08.73,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:08.73,0:11:10.47,Default,,0,0,0,,Хиромидің уақыты сияқты
Dialogue: 0,0:11:10.56,0:11:13.79,Default,,0,0,0,,Бетінде әрқашан шекарадан тыс нәрсе пайда болады.
Dialogue: 0,0:11:14.28,0:11:15.81,Default,,0,0,0,,Сол сәтті мақсат ету
Dialogue: 0,0:11:16.32,0:11:17.55,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:18.04,0:11:19.27,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:11:21.24,0:11:22.55,Default,,0,0,0,,Дегенмен, алдын ала ескертемін —
Dialogue: 0,0:11:23.28,0:11:26.79,Default,,0,0,0,,Акито-куннан қашық болған дұрыс.
Dialogue: 0,0:11:28.52,0:11:30.40,Default,,0,0,0,,Аа, дұрыс, Курияма-сан.
Dialogue: 0,0:11:30.40,0:11:31.39,Default,,0,0,0,,Иә
Dialogue: 0,0:11:31.92,0:11:34.23,Default,,0,0,0,,Кешегі күн туралы не ойлайсың?
Dialogue: 0,0:11:34.36,0:11:37.23,Default,,0,0,0,,Мен сені бір рет әдебиет үйірмесіне шақырайын деп жатырмын, солай ма?
Dialogue: 0,0:11:37.96,0:11:42.39,Default,,0,0,0,,Ол ешбір үйірмеге қатыспайды және сол мектептен басқа әлемде көп адамдар жоқ.
Dialogue: 0,0:11:42.48,0:11:43.82,Default,,0,0,0,,Ол жаңа ғана осында келді.
Dialogue: 0,0:11:43.82,0:11:46.79,Default,,0,0,0,,Мен жоқ дедім.
Dialogue: 0,0:11:50.40,0:11:51.75,Default,,0,0,0,,Мен қорқамын
Dialogue: 0,0:11:52.60,0:11:54.27,Default,,0,0,0,,Жан алу
Dialogue: 0,0:11:55.88,0:11:57.91,Default,,0,0,0,,Олай болса, неге жат планеталық болуды тоқтатпайсың?
Dialogue: 0,0:11:59.28,0:12:00.95,Default,,0,0,0,,Егер сіз бас тарта алсаңыз
Dialogue: 0,0:12:01.60,0:12:03.83,Default,,0,0,0,,Мен тастайтын болсам, баяғыда тастар едім!
Dialogue: 0,0:12:04.60,0:12:06.43,Default,,0,0,0,,Мен тіпті тастауға тырыстым.
Dialogue: 0,0:12:06.52,0:12:09.91,Default,,0,0,0,,Бөтен болуды доғар және Юмуды жеңуді доғар.
Dialogue: 0,0:12:10.08,0:12:12.03,Default,,0,0,0,,Мен қалыпты өмір сүруге тырыстым.
Dialogue: 0,0:12:13.12,0:12:16.27,Default,,0,0,0,,Бірақ менің ішімде ағып жатқан бұл қарғыс қан
Dialogue: 0,0:12:17.04,0:12:19.11,Default,,0,0,0,,Бұл ерекше күш
Dialogue: 0,0:12:20.44,0:12:22.84,Default,,0,0,0,,Мен үшін де солай.
Dialogue: 0,0:12:29.96,0:12:32.88,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:12:34.12,0:12:35.51,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:37.40,0:12:40.13,Default,,0,0,0,,Жерден тыс қауымдастықтың инспекция бөлімінің инспекторы
Dialogue: 0,0:12:40.44,0:12:44.79,Default,,0,0,0,,Иә, менің атым Мироку Фудзи. Изуми Назе мырза.
Dialogue: 0,0:12:45.44,0:12:47.31,Default,,0,0,0,,Сізге қандай кәсіп керек?
Dialogue: 0,0:12:47.84,0:12:49.63,Default,,0,0,0,,Бұл «қуыс көлеңке».
Dialogue: 0,0:12:49.72,0:12:52.91,Default,,0,0,0,,Бұл сыныптан сіз сирек кездеседі.
Dialogue: 0,0:12:53.04,0:12:55.16,Default,,0,0,0,,Тексеруге жатады
Dialogue: 0,0:12:56.20,0:12:58.23,Default,,0,0,0,,Арман - жер асты әлеміндегі белес
Dialogue: 0,0:12:59.00,0:13:00.55,Default,,0,0,0,,Армандағы құбыжық
Dialogue: 0,0:13:00.64,0:13:03.99,Default,,0,0,0,,Сондай-ақ, youmu адам ренішінің массасы деп айтылады.
Dialogue: 0,0:13:04.64,0:13:08.91,Default,,0,0,0,,Адам жүрегіндегі бұрмаланған өшпенділік, қызғаныш пен кісі өлтіру ниеті
Dialogue: 0,0:13:09.00,0:13:12.27,Default,,0,0,0,,Адамдар бар болғанша, сен бар боласың.
Dialogue: 0,0:13:12.36,0:13:15.23,Default,,0,0,0,,Сіз оны көре алатындықтан, оны жеңе бересіз.
Dialogue: 0,0:13:15.52,0:13:18.79,Default,,0,0,0,,Шетелдіктер де себептік бизнес деп ойламайсыз ба?
Dialogue: 0,0:13:22.68,0:13:24.75,Default,,0,0,0,,Сіз қызықты нәрселер туралы ойлайсыз.
Dialogue: 0,0:13:25.36,0:13:27.39,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:27.52,0:13:31.48,Default,,0,0,0,,Ежелден ұрпақтар жын-шайтандармен күресіп өмір сүрген.
Dialogue: 0,0:13:31.48,0:13:35.79,Default,,0,0,0,,Бөтен жауынгердің қызының көзқарасы бойынша, Youmu - фермерлер үшін күріш.
Dialogue: 0,0:13:35.88,0:13:38.19,Default,,0,0,0,,Балықшыға балық сияқты.
Dialogue: 0,0:13:38.28,0:13:40.63,Default,,0,0,0,,Оның не екені маған бәрібір.
Dialogue: 0,0:13:40.72,0:13:42.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:43.16,0:13:45.22,Default,,0,0,0,,Мен сізге сұрақ қоя аламын ба?
Dialogue: 0,0:13:45.56,0:13:46.51,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:13:47.44,0:13:50.03,Default,,0,0,0,,Сіз үшін Youmu деген не?
Dialogue: 0,0:13:51.64,0:13:53.03,Default,,0,0,0,,Бұл қазірдің өзінде шешілген жоқ па?
Dialogue: 0,0:13:54.08,0:13:55.77,Default,,0,0,0,,Бұл жай ғана құбыжық.
Dialogue: 0,0:13:57.32,0:13:58.75,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:13:59.40,0:14:01.19,Default,,0,0,0,,Қарапайым адамға
Dialogue: 0,0:14:02.56,0:14:04.03,Default,,0,0,0,,Сіз оны көре аласыз ба?
Dialogue: 0,0:14:10.24,0:14:11.03,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:14:11.60,0:14:14.31,Default,,0,0,0,,Ол тек көзілдірік киген әдемі қызға ұқсайды.
Dialogue: 0,0:14:23.20,0:14:25.15,Default,,0,0,0,,Не...?
Dialogue: 0,0:14:26.28,0:14:28.39,Default,,0,0,0,,Қуыс көлеңке
Dialogue: 0,0:14:29.08,0:14:30.75,Default,,0,0,0,,(Акихитоның мазасыз дауысы)
Dialogue: 0,0:14:38.08,0:14:39.91,Default,,0,0,0,,Курияма...
Dialogue: 0,0:14:40.40,0:14:43.75,Default,,0,0,0,,Тез... тез пышақтап сал!
Dialogue: 0,0:14:45.29,0:14:47.59,Default,,0,0,0,,Бұл жігіт әлсіз болуы керек.
Dialogue: 0,0:14:47.68,0:14:51.27,Default,,0,0,0,,Денемнен қуып жіберсең, сенімдімін
Dialogue: 0,0:14:51.60,0:14:53.26,Default,,0,0,0,,Бірақ менің ағам
Dialogue: 0,0:14:53.28,0:14:56.59,Default,,0,0,0,,Мен өлмеймін, өйткені мен өлмейтінмін.
Dialogue: 0,0:15:02.20,0:15:03.19,Default,,0,0,0,,Мотанай
Dialogue: 0,0:15:03.60,0:15:04.38,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:15:04.58,0:15:05.90,Default,,0,0,0,,Бірақ... бірақ
Dialogue: 0,0:15:05.96,0:15:08.95,Default,,0,0,0,,Міне, осында келдің ғой, солай ма?
Dialogue: 0,0:15:09.36,0:15:12.23,Default,,0,0,0,,Сіздің мұнда келуіңіздің бірден-бір себебі, солай емес пе?
Dialogue: 0,0:15:12.32,0:15:14.43,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:15:14.80,0:15:16.27,Default,,0,0,0,,Олай болса, оны ұстаныңыз!
Dialogue: 0,0:15:16.72,0:15:18.63,Default,,0,0,0,,Сіз оны жеңсеңіз де, ештеңе өзгермейді.
Dialogue: 0,0:15:18.76,0:15:22.07,Default,,0,0,0,,Оның денесінде ағып жатқан қан және оның жатқан жері
Dialogue: 0,0:15:22.16,0:15:24.07,Default,,0,0,0,,Ештеңе өзгермейді
Dialogue: 0,0:15:24.52,0:15:28.31,Default,,0,0,0,,Бірақ Курияма-сан бәрібір осында келді.
Dialogue: 0,0:15:28.44,0:15:32.63,Default,,0,0,0,,Олай болса, оны ұстаныңыз! Қуыс көлеңкеге берілме!
Dialogue: 0,0:15:32.72,0:15:35.35,Default,,0,0,0,,Егер сіз берілсеңіз, ештеңе маңызды емес.
Dialogue: 0,0:15:35.80,0:15:36.63,Default,,0,0,0,,Шабу!
Dialogue: 0,0:15:37.28,0:15:38.52,Default,,0,0,0,,Мен өлмейтінмін
Dialogue: 0,0:15:41.20,0:15:41.84,Default,,0,0,0,,Сонымен
Dialogue: 0,0:15:42.20,0:15:43.43,Default,,0,0,0,,Сонымен
Dialogue: 0,0:15:45.64,0:15:46.63,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:15:47.60,0:15:48.90,Default,,0,0,0,,Аға
Dialogue: 0,0:16:00.52,0:16:02.72,Default,,0,0,0,,Қанды босатыңыз...
Dialogue: 0,0:16:14.04,0:16:15.35,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:16:56.28,0:16:57.79,Default,,0,0,0,,Аға
Dialogue: 0,0:16:58.80,0:17:00.19,Default,,0,0,0,,Қазірше тек сен мен мен ғана оралдық.
Dialogue: 0,0:17:01.72,0:17:02.86,Default,,0,0,0,,Төмен
Dialogue: 0,0:17:13.92,0:17:16.91,Default,,0,0,0,,Неліктен? Қарсылас – қуыс көлеңке.
Dialogue: 0,0:17:17.08,0:17:19.07,Default,,0,0,0,,Бұлай болады деп ойламадың ба?
Dialogue: 0,0:17:20.16,0:17:21.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:22.24,0:17:23.93,Default,,0,0,0,,Мен сенің өміріңе кепілдік бермеймін.
Dialogue: 0,0:17:24.16,0:17:25.59,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:17:36.96,0:17:39.11,Default,,0,0,0,,Қанбара-кунның жартылай жын екенін білесіз бе?
Dialogue: 0,0:17:39.56,0:17:41.95,Default,,0,0,0,,Денеге аса қауіп төнген кезде
Dialogue: 0,0:17:42.12,0:17:44.15,Default,,0,0,0,,Юмудың санасы оянады
Dialogue: 0,0:17:46.60,0:17:48.75,Default,,0,0,0,,Қалай болғанда да, бұл қиын.
Dialogue: 0,0:17:49.32,0:17:55.11,Default,,0,0,0,,(Жүгірген толқындардың дыбысы)
Dialogue: 0,0:18:21.60,0:18:23.59,Default,,0,0,0,,Сенпай...
Dialogue: 0,0:18:23.80,0:18:25.79,Default,,0,0,0,,((шу)
Dialogue: 0,0:18:29.06,0:18:29.85,Default,,0,0,0,,Тор
Dialogue: 0,0:18:30.10,0:18:31.91,Default,,0,0,0,,Табиғаттан тыс күштерді жоққа шығару
Dialogue: 0,0:18:32.12,0:18:32.84,Default,,0,0,0,,Аяка-сан!
Dialogue: 0,0:18:32.84,0:18:33.63,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:18:40.40,0:18:42.83,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:18:57.16,0:18:58.51,Default,,0,0,0,,Өтірік
Dialogue: 0,0:18:58.88,0:18:59.87,Default,,0,0,0,,Нино-сан!
Dialogue: 0,0:19:02.68,0:19:04.91,Default,,0,0,0,,Бұл жай ғана жайлылық!
Dialogue: 0,0:19:06.96,0:19:08.07,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:19:13.64,0:19:14.67,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:19:16.84,0:19:19.03,Default,,0,0,0,,Жоқ... ол бұзылады!
Dialogue: 0,0:19:19.48,0:19:20.31,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:19:52.08,0:19:53.59,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:19:54.40,0:19:56.63,Default,,0,0,0,,Қарапайым адамға
Dialogue: 0,0:19:57.80,0:19:59.47,Default,,0,0,0,,Сіз оны көре аласыз ба?
Dialogue: 0,0:20:00.76,0:20:02.75,Default,,0,0,0,,Мен үшін де солай.
Dialogue: 0,0:20:03.20,0:20:04.91,Default,,0,0,0,,(болашақ жылау)
Dialogue: 0,0:20:05.24,0:20:06.87,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:07.56,0:20:11.35,Default,,0,0,0,,Мен туралы ештеңе жоқ
Dialogue: 0,0:20:12.64,0:20:13.91,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:15.88,0:20:16.83,Default,,0,0,0,,Тоқтау керек
Dialogue: 0,0:20:31.76,0:20:37.19,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:21:00.60,0:21:01.63,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:21:14.60,0:21:16.11,Default,,0,0,0,,Сондай-ақ I
Dialogue: 0,0:21:16.56,0:21:19.39,Default,,0,0,0,,Аа, Курияма мырза.
Dialogue: 0,0:21:30.00,0:21:32.23,Default,,0,0,0,,А...сенпай
Dialogue: 0,0:21:34.56,0:21:35.71,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:40.84,0:21:42.47,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:44.04,0:21:49.67,Default,,0,0,0,,(Болашақ жылау)
Dialogue: 0,0:21:50.44,0:21:51.31,Default,,0,0,0,,Итадакимасу!
Dialogue: 0,0:21:54.60,0:21:56.03,Default,,0,0,0,,Баяу тамақтансаңыз ше?
Dialogue: 0,0:21:56.12,0:21:58.39,Default,,0,0,0,,Маған қан жетпейтін сияқты.
Dialogue: 0,0:21:58.52,0:22:00.35,Default,,0,0,0,,Темір қоспасы
Dialogue: 0,0:22:00.44,0:22:03.87,Default,,0,0,0,,Мен бұл қуыс көлеңке емес екеніне сене алар емеспін.
Dialogue: 0,0:22:04.32,0:22:07.07,Default,,0,0,0,,Бұл небәрі 200 иен, бұл мүмкін емес!
Dialogue: 0,0:22:07.20,0:22:09.51,Default,,0,0,0,,Аяка өтірік айтпайды деп ойлаймын.
Dialogue: 0,0:22:10.04,0:22:11.85,Default,,0,0,0,,Сонымен бұл не?
Dialogue: 0,0:22:13.91,0:22:15.62,Default,,0,0,0,,Менің білуім мүмкін емес.
Dialogue: 0,0:22:20.92,0:22:23.64,Default,,0,0,0,,Сенің ағаң тамақ ішпей ме?
Dialogue: 0,0:22:24.53,0:22:25.26,Default,,0,0,0,,Иә
Dialogue: 0,0:22:27.84,0:22:29.10,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:22:29.37,0:22:30.39,Default,,0,0,0,,Дәретхана
Dialogue: 0,0:22:33.14,0:22:34.02,Default,,0,0,0,,Осымен
Dialogue: 0,0:22:34.32,0:22:34.97,Default,,0,0,0,,Иә
Dialogue: 0,0:22:35.28,0:22:38.71,Default,,0,0,0,,Мен... қарапайым адамға ұқсаймын ба?
Dialogue: 0,0:22:43.24,0:22:44.51,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:22:45.56,0:22:49.39,Default,,0,0,0,,Ол жай ғана мінезі нашар, көзілдірікті ұнататын ағаға ұқсайды.
Dialogue: 0,0:22:54.08,0:22:55.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:22:58.48,0:23:01.11,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:23:18.24,0:23:22.43,Default,,0,0,0,,Содан бері мен адасудан пайда жоқ деп ойладым.
Dialogue: 0,0:23:23.12,0:23:24.95,Default,,0,0,0,,Мен ағамын
Dialogue: 0,0:23:25.60,0:23:28.43,Default,,0,0,0,,Шекарадан тыс соғысудан басқа амалымыз жоқ дейді.
Dialogue: 0,0:23:29.84,0:23:32.27,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:23:33.36,0:23:37.27,Default,,0,0,0,,Мен ағамды өлтіргім келмейді.
Dialogue: 0,0:23:38.24,0:23:41.11,Default,,0,0,0,,Мен сені өлтіргім келмейді...
Dialogue: 0,0:23:45.00,0:23:50.31,Default,,0,0,0,,Тыныштық дәл түн ортасында басталады деп естідім.
Dialogue: 0,0:23:50.84,0:23:56.11,Default,,0,0,0,,Ауаның ауыр екені рас.
Dialogue: 0,0:23:58.32,0:24:01.31,Default,,0,0,0,,Ауыр... әлде тоқтады ма?
Dialogue: 0,0:24:01.44,0:24:03.79,Default,,0,0,0,,Наги...олай айту біртүрлі.
Dialogue: 0,0:24:04.48,0:24:09.31,Default,,0,0,0,,Осындай сәттерде Ю екеуің үйге қатар барғандарың дұрыс болар еді деп ойлаймын.
Dialogue: 0,0:24:09.60,0:24:11.51,Default,,0,0,0,,Ол әлдеқашан кетіп қалды.
Dialogue: 0,0:24:12.52,0:24:13.28,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:24:13.28,0:24:15.47,Default,,0,0,0,,Себебі мен Хироми мен Казукиге қайта барғым келмейді.
Dialogue: 0,0:24:15.56,0:24:16.25,Default,,0,0,0,,Неліктен? Ро
Dialogue: 0,0:24:16.25,0:24:17.43,Default,,0,0,0,,Себебі мен сені жек көремін.
Dialogue: 0,0:24:17.76,0:24:18.54,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:24:18.54,0:24:20.42,Default,,0,0,0,,Өйткені әрқашан осындай көзқарас!
Dialogue: 0,0:24:20.42,0:24:21.59,Default,,0,0,0,,Әй, сенпай!
Dialogue: 0,0:24:21.68,0:24:24.23,Default,,0,0,0,,Мен оны супермаркеттегі жеңілдетілген түскі ас қорабының бағасына уақытында жеткізе алмаймын.
Dialogue: 0,0:24:24.32,0:24:25.46,Default,,0,0,0,,Әрі қарай жүрейік!
Dialogue: 0,0:24:24.32,0:24:27.99,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:24:29.36,0:24:30.05,Default,,0,0,0,,Акки
Dialogue: 0,0:24:30.76,0:24:31.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:31.76,0:24:34.83,Default,,0,0,0,,Жеңіл қабылдамаңыз, бұл мені қобалжытады
Dialogue: 0,0:24:37.12,0:24:38.51,Default,,0,0,0,,Махаббат?
Dialogue: 0,0:24:53.48,0:24:55.01,Default,,0,0,0,,Сіз серуендеуге барғыңыз келе ме?
Dialogue: 0,0:24:55.86,0:24:57.18,Default,,0,0,0,,Мен оны сізге жіберемін.
Dialogue: 0,0:25:01.56,0:25:03.15,Default,,0,0,0,,Наги?
Dialogue: 0,0:25:07.56,0:25:08.71,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:25:09.12,0:25:12.83,Default,,0,0,0,,Жоқ, мен көлікте келе жатып сөйлесу керек деп ойладым.
Dialogue: 0,0:25:17.60,0:25:19.55,Default,,0,0,0,,Бұл сен бе?
Dialogue: 0,0:25:19.64,0:25:24.03,Default,,0,0,0,,Иә, бұл қуыс көлеңкелерге де қатысты, бірақ күшті жындар да бар.
Dialogue: 0,0:25:24.12,0:25:27.07,Default,,0,0,0,,Көптеген заттардың физикалық формасы болмайды.
Dialogue: 0,0:25:28.12,0:25:32.31,Default,,0,0,0,,Бұл елес көп жылдар бойы әлемге жіберілді.
Dialogue: 0,0:25:32.40,0:25:36.71,Default,,0,0,0,,Сансыз адамдардың кектері мен бұралған жүректері айналады.
Dialogue: 0,0:25:36.80,0:25:39.95,Default,,0,0,0,,Бір қалыпта туады дейді.
Dialogue: 0,0:25:40.08,0:25:43.71,Default,,0,0,0,,Егер бақылаусыз қалса, ол әлемді жойылуға әкеледі.
Dialogue: 0,0:25:45.28,0:25:50.59,Default,,0,0,0,,Эпидемиялар мен табиғи апат соғыстарының шығуы осы youmu әсерінен деп айтылады.
Dialogue: 0,0:25:50.68,0:25:54.15,Default,,0,0,0,,Әдетте «Шекарадан тыс» деп аталады
Dialogue: 0,0:25:55.44,0:25:59.39,Default,,0,0,0,,Бақытымызға орай, олардың кейбіреулері ғана пайда болуда.
Dialogue: 0,0:25:59.48,0:26:00.59,Default,,0,0,0,,Әсері жоқ
Dialogue: 0,0:26:01.48,0:26:03.67,Default,,0,0,0,,Сен мұны маған не үшін айтып тұрсың?
Dialogue: 0,0:26:04.24,0:26:08.95,Default,,0,0,0,,А...мәліметтің қолында болғандай Назе әулеті өте сақ.
Dialogue: 0,0:26:09.40,0:26:12.59,Default,,0,0,0,,Мен сенен бірдеңе аламын ба деп ойладым.
Dialogue: 0,0:26:12.68,0:26:15.83,Default,,0,0,0,,Юн-санға ештеңе хабарланбаған сияқты.
Dialogue: 0,0:26:16.88,0:26:18.11,Default,,0,0,0,,Якиимо
Dialogue: 0,0:26:20.45,0:26:21.79,Default,,0,0,0,,Бұл дұрыс емес пе!
Dialogue: 0,0:26:22.50,0:26:23.30,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:26:23.64,0:26:27.19,Default,,0,0,0,,Юмудың осы шекарадан тыс шайқасында не болып жатыр?
Dialogue: 0,0:26:27.76,0:26:30.63,Default,,0,0,0,,Назе жанұясы мұнымен жасырын жұмыс істеп жатқан болуы мүмкін бе?
Dialogue: 0,0:26:32.68,0:26:34.39,Default,,0,0,0,,Білгіңіз келе ме?
Dialogue: 0,0:26:39.48,0:26:43.59,Default,,0,0,0,,Курияма-санның «Шекарадан тыс» фильміне қатысы бар дейсіз бе?
Dialogue: 0,0:26:44.16,0:26:45.35,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:26:45.68,0:26:49.43,Default,,0,0,0,,Бірақ солай болса қызық емес пе?
Dialogue: 0,0:26:57.16,0:26:58.11,Default,,0,0,0,,Тұрақты түрде құрмет көрсет, Анджело.
Dialogue: 0,0:26:58.56,0:26:59.95,Default,,0,0,0,,О, ау
Dialogue: 0,0:27:05.84,0:27:08.83,Default,,0,0,0,,Ю-ның соңынан ондай жерге келгеніме сене алар емеспін.
Dialogue: 0,0:27:10.00,0:27:11.51,Default,,0,0,0,,Cisco жүйесіне ұқсайды.
Dialogue: 0,0:27:11.76,0:27:14.99,Default,,0,0,0,,Бұл күтпеген жағдай, «ұнату» артық!
Dialogue: 0,0:27:21.68,0:27:22.63,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:27:23.12,0:27:25.35,Default,,0,0,0,,Юн мырзадан сұрау керек.
Dialogue: 0,0:27:33.32,0:27:34.59,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:27:37.12,0:27:40.19,Default,,0,0,0,,Мен жақсы «үлкен аға» алдым
Dialogue: 0,0:27:48.28,0:27:51.19,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:27:53.32,0:27:56.00,Default,,0,0,0,,Акито-кунды көлік қағып кетті.
Dialogue: 0,0:27:56.00,0:27:57.82,Default,,0,0,0,,Жарақат қалай пайда болды?
Dialogue: 0,0:27:58.72,0:28:00.00,Default,,0,0,0,,Ал... бұл
Dialogue: 0,0:27:59.56,0:28:00.99,Default,,0,0,0,,Мені өлтірме!
Dialogue: 0,0:28:01.08,0:28:03.79,Default,,0,0,0,,Өтінемін, мені өлтірме!
Dialogue: 0,0:28:04.24,0:28:07.55,Default,,0,0,0,,Не... неге олай дейсің?
Dialogue: 0,0:28:28.00,0:28:29.71,Default,,0,0,0,,Изуми мырза
Dialogue: 0,0:28:31.08,0:28:32.59,Default,,0,0,0,,Сіз шаршадыңыз.
Dialogue: 0,0:28:35.24,0:28:37.11,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:28:39.20,0:28:42.51,Default,,0,0,0,,Кішкене демалыңыз.
Dialogue: 0,0:28:48.92,0:28:53.11,Default,,0,0,0,,«Ұшаққа келгеніңіз үшін рахмет, бұл Ханаджи Хананодера».
Dialogue: 0,0:28:53.24,0:28:55.67,Default,,0,0,0,,«Пойыздан түскенде ештеңе қалдырмағаныңызға көз жеткізіңіз».
Dialogue: 0,0:28:59.52,0:29:02.43,Default,,0,0,0,,Тыныштықтың әсері туралы ойланбау заңдылық еді.
Dialogue: 0,0:29:02.96,0:29:05.47,Default,,0,0,0,,Тек Youmu бөлігі
Dialogue: 0,0:29:05.60,0:29:08.75,Default,,0,0,0,,Менің ойымша, адам жағы да өте әлсіз.
Dialogue: 0,0:29:09.08,0:29:11.55,Default,,0,0,0,,Жақсы болу жолы бар ма?
Dialogue: 0,0:29:12.36,0:29:15.95,Default,,0,0,0,,Ол адам болсын, юму болсын, онымен күресудің жолдары бар.
Dialogue: 0,0:29:16.56,0:29:19.75,Default,,0,0,0,,Канбару-кун – жартылай жын, тым сирек.
Dialogue: 0,0:29:19.84,0:29:23.07,Default,,0,0,0,,Шынымды айтсам, оның не екенін білмеймін.
Dialogue: 0,0:29:23.96,0:29:25.47,Default,,0,0,0,,Аға
Dialogue: 0,0:29:29.52,0:29:32.91,Default,,0,0,0,,Қанбара-сенпай мен Мирай қашан кездесті?
Dialogue: 0,0:29:33.04,0:29:35.87,Default,,0,0,0,,Жарайды...Мен егжей-тегжейін білмеймін, бірақ
Dialogue: 0,0:29:36.00,0:29:39.23,Default,,0,0,0,,Менің ойымша, бұл Мирай-чан келген соң шығар.
Dialogue: 0,0:29:42.40,0:29:45.47,Default,,0,0,0,,Уақыт келді, махаббат, сақ бол.
Dialogue: 0,0:29:45.56,0:29:46.39,Default,,0,0,0,,Иә
Dialogue: 0,0:29:46.80,0:29:49.00,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:29:49.00,0:29:51.55,Default,,0,0,0,,Мен ойлаған кезде,
Dialogue: 0,0:29:51.70,0:29:54.58,Default,,0,0,0,,Уайымдама, Қанбара-сенпай
Dialogue: 0,0:29:54.58,0:29:55.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:55.84,0:30:00.23,Default,,0,0,0,,Егер сіз сұрасаңыз, олар сізге олардың қасында қалуға болатынын айтуы мүмкін.
Dialogue: 0,0:30:01.60,0:30:04.99,Default,,0,0,0,,Бірақ бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:30:05.08,0:30:07.11,Default,,0,0,0,,Сонда да мен сенің жаныңда болғым келеді
Dialogue: 0,0:30:08.96,0:30:10.71,Default,,0,0,0,,Сонымен... болды.
Dialogue: 0,0:30:11.40,0:30:12.39,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:30:12.52,0:30:14.79,Default,,0,0,0,,«Бұл жағымсыз» жағымсыз емес.
Dialogue: 0,0:30:16.32,0:30:17.51,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:30:17.60,0:30:19.79,Default,,0,0,0,,Қазір шынымен жағымсыз.
Dialogue: 0,0:30:19.92,0:30:21.67,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:30:22.12,0:30:26.35,Default,,0,0,0,,Болашақта Қанбара-сенпайдың қасында болғым келсе, мені ешкім тоқтатпайды.
Dialogue: 0,0:30:26.44,0:30:31.03,Default,,0,0,0,,Мен сенің жаныңда болғым келеді ме, жоқ па, бәрібір.
Dialogue: 0,0:30:31.16,0:30:32.71,Default,,0,0,0,,Мен жай ғана
Dialogue: 0,0:30:32.84,0:30:34.95,Default,,0,0,0,,Қанбара-сенпай көзілдірікті жақсы көреді
Dialogue: 0,0:30:35.04,0:30:37.63,Default,,0,0,0,,Демек олай емес!
Dialogue: 0,0:30:37.72,0:30:40.87,Default,,0,0,0,,Бұл жай... қалыпты.
Dialogue: 0,0:30:41.48,0:30:44.71,Default,,0,0,0,,Қарғыс атқан қанды ру болсам да
Dialogue: 0,0:30:44.80,0:30:47.59,Default,,0,0,0,,Сізде осы табиғаттан тыс күш болса да
Dialogue: 0,0:30:47.72,0:30:48.87,Default,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:30:49.56,0:30:51.87,Default,,0,0,0,,Басынан бері
Dialogue: 0,0:30:54.92,0:30:56.02,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:30:58.76,0:30:59.91,Default,,0,0,0,,Біз кездестік
Dialogue: 0,0:31:06.40,0:31:07.31,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:31:08.28,0:31:10.39,Default,,0,0,0,,Қазіргісі де жағымсыз емес.
Dialogue: 0,0:31:23.48,0:31:25.15,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,0:31:42.84,0:31:43.82,Default,,0,0,0,,Изуми мырза!
Dialogue: 0,0:31:50.96,0:31:53.03,Default,,0,0,0,,Аға
Dialogue: 0,0:31:53.12,0:31:54.27,Default,,0,0,0,,қашып кетті
Dialogue: 0,0:31:59.32,0:32:02.19,Default,,0,0,0,,Бірақ неге Акито юмуға айналды?
Dialogue: 0,0:32:04.56,0:32:08.91,Default,,0,0,0,,Аяка-сан мұны ағасы құлап қалғанда айтты.
Dialogue: 0,0:32:09.00,0:32:11.71,Default,,0,0,0,,«Адам бөлігі де өте әлсіз».
Dialogue: 0,0:32:12.80,0:32:16.79,Default,,0,0,0,,Юмудан гөрі тыныштық әлсіреген шығар.
Dialogue: 0,0:32:16.88,0:32:19.91,Default,,0,0,0,,Өйткені адам бөлігі бұрынғыдан да әлсіреп қалды
Dialogue: 0,0:32:20.44,0:32:25.03,Default,,0,0,0,,Нәтижесінде Юму бөлігі алдынан шықты.
Dialogue: 0,0:32:25.16,0:32:26.11,Default,,0,0,0,,Иә
Dialogue: 0,0:32:26.20,0:32:30.99,Default,,0,0,0,,Сондықтан енді ғана елеске айналған Акито-кун бұрынғыдан әлсіздеу болды.
Dialogue: 0,0:32:31.44,0:32:32.99,Default,,0,0,0,,Мен қашып кеттім
Dialogue: 0,0:32:37.72,0:32:40.11,Default,,0,0,0,,Ах! Кешіріңіз
Dialogue: 0,0:32:42.29,0:32:44.51,Default,,0,0,0,,«135 саны»?
Dialogue: 0,0:32:45.56,0:32:47.51,Default,,0,0,0,,«Шағын шолу 83 ұпай»
Dialogue: 0,0:32:47.60,0:32:51.71,Default,,0,0,0,,«Көзілдірік киген әдемі қыздарға ғана тән нәрсені қамтитын мистицизм бар».
Dialogue: 0,0:32:51.84,0:32:54.99,Default,,0,0,0,,«Мимика шамадан тыс жасалған және табиғи емес».
Dialogue: 0,0:32:55.18,0:32:56.46,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:32:56.46,0:32:58.43,Default,,0,0,0,,Қораптың ішіне де қараңыз.
Dialogue: 0,0:33:00.24,0:33:01.55,Default,,0,0,0,,...бұзық!
Dialogue: 0,0:33:01.68,0:33:05.75,Default,,0,0,0,,Бұл әлемдегі ең сирек кездесетін жартылай жынның шынайы тұлғасы екені өте өкінішті.
Dialogue: 0,0:33:05.84,0:33:09.71,Default,,0,0,0,,Рұқсатсыз үйіңді тінтіп, сені бұзық деп айту дұрыс емес деп ойлаймын.
Dialogue: 0,0:33:09.88,0:33:11.91,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:33:24.96,0:33:26.51,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:33:30.40,0:33:33.79,Default,,0,0,0,,Электрондық хатта не жазылған... бұл рас па?
Dialogue: 0,0:33:34.04,0:33:37.59,Default,,0,0,0,,Иә, бұл youmu болғандықтан, бұл Нагидің әсерінен.
Dialogue: 0,0:33:37.72,0:33:40.23,Default,,0,0,0,,Шекараның арғы жағында жүрсең де, әлсіз шығарсың.
Dialogue: 0,0:33:41.12,0:33:45.87,Default,,0,0,0,,Егер сіз бүкіл қаныңыз бен денеңізді пайдалансаңыз, Акито-кунның өмірін қимаңыз.
Dialogue: 0,0:33:46.04,0:33:50.51,Default,,0,0,0,,Бетінде пайда болатын шекарадан тыс сүйреп апару мүмкіндігі болуы керек.
Dialogue: 0,0:33:51.20,0:33:56.31,Default,,0,0,0,,Дегенмен, бұл сіз туралы барлық нәрсені шекараның екінші жағы басып алатынын білдіреді.
Dialogue: 0,0:33:56.88,0:33:59.64,Default,,0,0,0,,Бірақ үлкендер көмектесе алады, солай ма?
Dialogue: 0,0:33:59.92,0:34:02.19,Default,,0,0,0,,Сіз шешім қабылдадыңыз ба?
Dialogue: 0,0:34:03.56,0:34:04.35,Default,,0,0,0,,Иә
Dialogue: 0,0:34:06.80,0:34:10.27,Default,,0,0,0,,Акито-кунның орны. Ол бір күні оянады.
Dialogue: 0,0:34:10.44,0:34:14.39,Default,,0,0,0,,Егер сіз Акито-кунға шындап көмектескіңіз келсе, соғұрлым тезірек жақсы.
Dialogue: 0,0:34:17.44,0:34:18.71,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:34:19.88,0:34:22.27,Default,,0,0,0,,Акито-кун сенің өмір сүргеніңді қалайды.
Dialogue: 0,0:34:23.20,0:34:25.75,Default,,0,0,0,,Мені өлтіру арқылы өмір сүргеніңді қалаймын
Dialogue: 0,0:34:25.88,0:34:27.95,Default,,0,0,0,,Мен міндетті түрде солай ойлаймын.
Dialogue: 0,0:34:28.28,0:34:29.75,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:34:30.16,0:34:33.87,Default,,0,0,0,,Сонда да сен Акито-кунға көмектесіп жатырсың.
Dialogue: 0,0:34:33.96,0:34:34.79,Default,,0,0,0,,Иә
Dialogue: 0,0:34:35.76,0:34:39.03,Default,,0,0,0,,Мен ағам ашуланатынына сенімдімін.
Dialogue: 0,0:34:39.12,0:34:44.27,Default,,0,0,0,,Менің бұлай істегенімді естігенде, олар: «Ештеңе жоқ» деді.
Dialogue: 0,0:34:44.40,0:34:46.23,Default,,0,0,0,,Сол кездегідей
Dialogue: 0,0:34:51.32,0:34:52.87,Default,,0,0,0,,Бұл Зама-Миро
Dialogue: 0,0:35:11.48,0:35:12.31,Default,,0,0,0,,Аға
Dialogue: 0,0:35:38.08,0:35:41.79,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:35:42.60,0:35:43.50,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:35:43.50,0:35:44.99,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:35:47.68,0:35:49.59,Default,,0,0,0,,Мен ағамның алдындамын.
Dialogue: 0,0:35:51.52,0:35:52.51,Default,,0,0,0,,Акки
Dialogue: 0,0:35:53.00,0:35:54.39,Default,,0,0,0,,Сен мені өлтіресің бе...?
Dialogue: 0,0:35:59.32,0:36:00.43,Default,,0,0,0,,Иә
Dialogue: 0,0:36:03.88,0:36:06.51,Default,,0,0,0,,Ах, сәлем! ? сәлем! ?
Dialogue: 0,0:36:12.60,0:36:15.71,Default,,0,0,0,,(терең тыныс алу дыбысы)
Dialogue: 0,0:36:35.56,0:36:37.43,Default,,0,0,0,,Табиғаттан тыс күшті өшіріңіз
Dialogue: 0,0:37:18.72,0:37:21.55,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:37:34.64,0:37:37.91,Default,,0,0,0,,Мен... қарапайым адамға ұқсаймын ба?
Dialogue: 0,0:37:39.92,0:37:40.87,Default,,0,0,0,,Өлтіру
Dialogue: 0,0:37:41.00,0:37:42.03,Default,,0,0,0,,Сен мені өлтіресің бе...?
Dialogue: 0,0:37:45.72,0:37:46.71,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:38:15.52,0:38:17.27,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:38:18.60,0:38:19.91,Default,,0,0,0,,Курияма мырза?
Dialogue: 0,0:38:26.16,0:38:27.61,Default,,0,0,0,,Сенпай?
Dialogue: 0,0:38:28.36,0:38:29.75,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:38:34.20,0:38:36.12,Default,,0,0,0,,Бұл болды ма?
Dialogue: 0,0:38:36.12,0:38:37.43,Default,,0,0,0,,Иә
Dialogue: 0,0:38:37.68,0:38:39.72,Default,,0,0,0,,Елеске айналу қиын болды.
Dialogue: 0,0:38:39.72,0:38:42.59,Default,,0,0,0,,Бақытымызға орай, ешкім зардап шеккен жоқ.
Dialogue: 0,0:38:42.68,0:38:44.19,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:38:47.24,0:38:52.35,Default,,0,0,0,,Тыныштық әсерінен болса керек деп ойлаймын, өйткені тыртықтар ұзақ сақталды.
Dialogue: 0,0:38:53.20,0:38:54.91,Default,,0,0,0,,Егер сіз тыныш кезеңде шабуыл жасасаңыз
Dialogue: 0,0:38:55.04,0:38:58.03,Default,,0,0,0,,Сенпайымның өлуі мүмкін екенін айтты.
Dialogue: 0,0:38:58.12,0:39:00.17,Default,,0,0,0,,Сондықтан мен де қорқамын
Dialogue: 0,0:39:04.68,0:39:06.55,Default,,0,0,0,,Оған тимеңіз
Dialogue: 0,0:39:06.68,0:39:09.23,Default,,0,0,0,,Тыныштық біткеннен кейін ол тез жазылуы керек.
Dialogue: 0,0:39:09.72,0:39:12.91,Default,,0,0,0,,«Ұлттық тағамдарда жақсы ештеңе жоқ», солай ма?
Dialogue: 0,0:39:13.04,0:39:15.48,Default,,0,0,0,,Уф...бұл омлет күріш!
Dialogue: 0,0:39:15.48,0:39:16.87,Default,,0,0,0,,Омлет күріш?
Dialogue: 0,0:39:17.00,0:39:18.07,Default,,0,0,0,,Иә
Dialogue: 0,0:39:18.60,0:39:19.99,Default,,0,0,0,,Жұмыртқа туралы не деуге болады?
Dialogue: 0,0:39:20.08,0:39:21.35,Default,,0,0,0,,Мұнда
Dialogue: 0,0:39:22.64,0:39:23.47,Default,,0,0,0,,Қайнатылған! ?
Dialogue: 0,0:39:25.16,0:39:26.83,Default,,0,0,0,,Толығымен жойылды ма?
Dialogue: 0,0:39:29.84,0:39:31.59,Default,,0,0,0,,Нанана...бұл не! ?
Dialogue: 0,0:39:31.76,0:39:33.62,Default,,0,0,0,,Шие гүлдері қалпына келу мерекесі.
Dialogue: 0,0:39:33.62,0:39:34.95,Default,,0,0,0,,Бұл салт қай жерде?
Dialogue: 0,0:39:35.08,0:39:38.71,Default,,0,0,0,,Біреудің тоңазытқышын рұқсатсыз ашпаңыз, олар қанша ес-түссіз болса да!
Dialogue: 0,0:39:38.80,0:39:40.31,Default,,0,0,0,,Шошқаның басын қоспаңыз!
Dialogue: 0,0:39:40.44,0:39:42.71,Default,,0,0,0,,Жарайды, Сенпай, ұйықта.
Dialogue: 0,0:39:42.96,0:39:45.35,Default,,0,0,0,,Мен дүкенге барып, оны қайтадан дұрыстап жасаймын.
Dialogue: 0,0:39:45.79,0:39:46.77,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:39:46.90,0:39:49.55,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:39:49.64,0:39:50.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:39:50.50,0:39:51.93,Default,,0,0,0,,№
Dialogue: 0,0:39:51.93,0:39:53.75,Default,,0,0,0,,Сіз мұны білмейсіз бе?
Dialogue: 0,0:39:53.84,0:39:54.28,Default,,0,0,0,,Шие гүлдері! ?
Dialogue: 0,0:39:54.28,0:39:55.35,Default,,0,0,0,,Юкине, сонда ісіңді бітірген соң дүкенге қара.
Dialogue: 0,0:39:56.16,0:39:59.76,Default,,0,0,0,,Қанбара-сенпай күйрегеннен бері болашақ бір сәтке де арамыздан кеткен жоқ.
Dialogue: 0,0:39:59.76,0:40:01.47,Default,,0,0,0,,Мен оған үнемі қамқорлық жасадым.
Dialogue: 0,0:40:02.56,0:40:04.07,Default,,0,0,0,,Сіз әлі байқамадыңыз ба?
Dialogue: 0,0:40:04.19,0:40:05.01,Default,,0,0,0,,Не?
Dialogue: 0,0:40:05.20,0:40:07.59,Default,,0,0,0,,Бұл адам болашақта жақсы болмауы мүмкін
Dialogue: 0,0:40:08.84,0:40:11.27,Default,,0,0,0,,Не айтып тұрсың! Сен не туралы айтып тұрсың?
Dialogue: 0,0:40:11.36,0:40:12.55,Default,,0,0,0,,Оны анық айтқан дұрыс
Dialogue: 0,0:40:12.68,0:40:14.87,Default,,0,0,0,,Не істеп жатырсың! Сен не істеп жатырсың?
Dialogue: 0,0:40:14.96,0:40:15.95,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:40:17.52,0:40:18.69,Default,,0,0,0,,Күн ыстық!
Dialogue: 0,0:40:18.92,0:40:21.83,Default,,0,0,0,,Ал... жаз мезгілі.
Dialogue: 0,0:40:25.48,0:40:26.91,Default,,0,0,0,,Жаз?
Dialogue: 0,0:40:30.48,0:40:32.47,Default,,0,0,0,,Не? Сіз осындай жерде болдыңыз ба?
Dialogue: 0,0:40:32.56,0:40:34.03,Default,,0,0,0,,О! Көзілдірік!
Dialogue: 0,0:40:36.40,0:40:39.71,Default,,0,0,0,,Мен Акихитоның дауысын естіп тұрғаным біртүрлі.
Dialogue: 0,0:40:39.96,0:40:41.11,Default,,0,0,0,,Бұл есту галлюцинациясы ма?
Dialogue: 0,0:40:41.20,0:40:44.15,Default,,0,0,0,,Бұл үлкен мәселе! Көзілдіріктерге қарағанда күннен қорғайтын көзілдірік жақсырақ.
Dialogue: 0,0:40:45.56,0:40:47.15,Default,,0,0,0,,Бұл шынайы сияқты
Dialogue: 0,0:40:48.04,0:40:50.31,Default,,0,0,0,,Олай болса тез кет.
Dialogue: 0,0:40:50.44,0:40:53.55,Default,,0,0,0,,Мен Акихитоға купальникімді қалай тегін көрсете аламын?
Dialogue: 0,0:40:53.68,0:40:55.83,Default,,0,0,0,,Өйткені бұл қорлаудан басқа ештеңе емес
Dialogue: 0,0:40:55.96,0:40:59.11,Default,,0,0,0,,Мизуки өз бетімен купальник киіп алған!
Dialogue: 0,0:40:59.20,0:41:00.09,Default,,0,0,0,,Акито
Dialogue: 0,0:41:00.32,0:41:01.06,Default,,0,0,0,,Не?
Dialogue: 0,0:41:01.20,0:41:05.11,Default,,0,0,0,,Осыдан сабақ алып, өзіңізге қайта қараңыз.
Dialogue: 0,0:41:05.76,0:41:09.75,Default,,0,0,0,,Мен мұндай сезімнен шаршадым.
Dialogue: 0,0:41:14.68,0:41:18.19,Default,,0,0,0,,Сол азғынды да клуб бөлмесіне апарыңыз.
Dialogue: 0,0:41:18.36,0:41:19.58,Default,,0,0,0,,Эй, бұзық
Dialogue: 0,0:41:20.08,0:41:21.46,Default,,0,0,0,,Қандай бұзық
Dialogue: 0,0:41:24.32,0:41:27.03,Default,,0,0,0,,Күндер қысқарып барады.
Dialogue: 0,0:41:27.44,0:41:29.83,Default,,0,0,0,,Жазғы бөлме маусым айында.
Dialogue: 0,0:41:29.92,0:41:31.20,Default,,0,0,0,,Тағы біраз оқығыңыз келе ме?
Dialogue: 0,0:41:31.44,0:41:32.53,Default,,0,0,0,,Жоқ
Dialogue: 0,0:41:32.86,0:41:35.38,Default,,0,0,0,,Хироми мен Мизуки баяу.
Dialogue: 0,0:41:35.52,0:41:36.88,Default,,0,0,0,,Мен үйге қайттым.
Dialogue: 0,0:41:36.88,0:41:37.87,Default,,0,0,0,,Өтірік?
Dialogue: 0,0:41:37.96,0:41:42.03,Default,,0,0,0,,Не болды, адам өмір мен өлім арасында адасып, ақыры қайтып келді?
Dialogue: 0,0:41:42.40,0:41:47.07,Default,,0,0,0,,Сол себепті емес пе? Мен оның ұялғанына сенімдімін.
Dialogue: 0,0:41:49.60,0:41:50.56,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:41:50.56,0:41:52.55,Default,,0,0,0,,Жоқ
Dialogue: 0,0:41:55.88,0:41:58.05,Default,,0,0,0,,Курияма мырза, уақытыңыз бар ма?
Dialogue: 0,0:41:58.72,0:42:01.71,Default,,0,0,0,,Жоқ, менің ойымша, тамақ алуға бару керек.
Dialogue: 0,0:42:01.84,0:42:04.03,Default,,0,0,0,,Аа, менде ақша жоқ болса, мен саған бірдеңе сатып аламын.
Dialogue: 0,0:42:04.24,0:42:05.39,Default,,0,0,0,,Ах...хаа
Dialogue: 0,0:42:05.72,0:42:10.23,Default,,0,0,0,,Қараңыз, менде ештеңе жоқ, бірақ мен сіз көп қиындық тудырғаныңызға сенімдімін, солай ма?
Dialogue: 0,0:42:16.44,0:42:18.89,Default,,0,0,0,,Маған тезірек айтқаныңызды қалаймын.
Dialogue: 0,0:42:18.89,0:42:19.87,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:42:20.32,0:42:21.43,Default,,0,0,0,,Иә
Dialogue: 0,0:42:22.08,0:42:25.59,Default,,0,0,0,,Күн батқанда бітетін шығар.
Dialogue: 0,0:42:26.08,0:42:27.43,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:42:29.60,0:42:30.83,Default,,0,0,0,,Үлкендер
Dialogue: 0,0:42:31.44,0:42:34.83,Default,,0,0,0,,Маған неге сонша мейірімдісің?
Dialogue: 0,0:42:35.00,0:42:35.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:40.08,0:42:42.39,Default,,0,0,0,,Өйткені сен маған ұқсайсың
Dialogue: 0,0:42:43.88,0:42:46.68,Default,,0,0,0,,Олай десеңіз, Курияма мырза ашуланады.
Dialogue: 0,0:42:46.68,0:42:48.24,Default,,0,0,0,,Сізге бұл ұнамайды! ?
Dialogue: 0,0:42:48.24,0:42:50.27,Default,,0,0,0,,Ал... бұл дұрыс емес, солай ма?
Dialogue: 0,0:42:50.36,0:42:52.95,Default,,0,0,0,,Сіз шынымен ашуланған сияқтысыз!
Dialogue: 0,0:42:53.53,0:42:54.62,Default,,0,0,0,,А... сен бақыттысың ба?
Dialogue: 0,0:42:54.62,0:42:55.97,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:42:56.08,0:42:57.95,Default,,0,0,0,,Жоқ, Мизуки-сенпайдан.
Dialogue: 0,0:42:58.08,0:43:03.15,Default,,0,0,0,,Қанбара-сенпай езілгеннен қатты ләззат алады деген.
Dialogue: 0,0:43:03.28,0:43:06.11,Default,,0,0,0,,Бірақ істер әрқашан жақсы бола бермейді.
Dialogue: 0,0:43:06.20,0:43:08.26,Default,,0,0,0,,Бұл жақсы болуы керек емес!
Dialogue: 0,0:43:08.26,0:43:10.28,Default,,0,0,0,,Мизукидің сізге айтқанын ұмытыңыз!
Dialogue: 0,0:43:10.28,0:43:10.97,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:43:10.97,0:43:11.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:11.92,0:43:15.79,Default,,0,0,0,,Ұмытпаймын...Ұмытпаймын
Dialogue: 0,0:43:20.68,0:43:22.31,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:43:23.48,0:43:24.57,Default,,0,0,0,,Мен ағамын.
Dialogue: 0,0:43:24.57,0:43:25.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:25.88,0:43:27.31,Default,,0,0,0,,«Шекарадан тыс»
Dialogue: 0,0:43:27.92,0:43:32.63,Default,,0,0,0,,Дүниені бұзады делінетін адам санасындағы бұрмалаулар жинағы.
Dialogue: 0,0:43:33.64,0:43:37.03,Default,,0,0,0,,Бұл менің аға сыныптағы Юму болатын.
Dialogue: 0,0:43:37.16,0:43:39.07,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:43:39.56,0:43:43.43,Default,,0,0,0,,Мен о бастан шекараның арғы бетін жеңгім келді.
Dialogue: 0,0:43:43.52,0:43:44.67,Default,,0,0,0,,Мен осы қалаға келдім.
Dialogue: 0,0:43:45.80,0:43:48.95,Default,,0,0,0,,Бірақ нәтиже болмады.
Dialogue: 0,0:43:49.52,0:43:54.15,Default,,0,0,0,,Мен ағамды өлтіре алмадым. Мен оны өлтіргім келмеді.
Dialogue: 0,0:43:54.68,0:43:55.51,Default,,0,0,0,,Сонымен
Dialogue: 0,0:43:56.96,0:43:57.83,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:44:05.72,0:44:09.19,Default,,0,0,0,,Осы тыныш уақытта, қанымды пайдалансаң
Dialogue: 0,0:44:09.32,0:44:13.35,Default,,0,0,0,,Үлкендеріңіздің шегінен шыққандарды қуып шығуға болады деп естідім.
Dialogue: 0,0:44:13.44,0:44:16.67,Default,,0,0,0,,Мен мұны шынымен істегім келеді
Dialogue: 0,0:44:28.28,0:44:30.85,Default,,0,0,0,,Курияма мырзаға не болды?
Dialogue: 0,0:44:31.45,0:44:32.32,Default,,0,0,0,,Жоғалып кетті
Dialogue: 0,0:44:33.17,0:44:33.80,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:44:34.52,0:44:37.23,Default,,0,0,0,,Сонда Курияма мырза мұнда кім?
Dialogue: 0,0:44:37.40,0:44:40.58,Default,,0,0,0,,Сенпай, ол әлі оянған жоқ.
Dialogue: 0,0:44:40.73,0:44:41.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:41.52,0:44:44.75,Default,,0,0,0,,Мен мұнда әлі армандамын.
Dialogue: 0,0:44:45.48,0:44:49.31,Default,,0,0,0,,Сенің ішіңде қалған менің қанымның кішкене бөлігі
Dialogue: 0,0:44:49.40,0:44:50.87,Default,,0,0,0,,Мен саған бұл түсімді көрсетіп тұрмын.
Dialogue: 0,0:44:55.36,0:44:59.99,Default,,0,0,0,,Бірақ енді бітті, Сенпай, оянғалы тұрсың.
Dialogue: 0,0:45:00.12,0:45:01.12,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:45:01.44,0:45:04.15,Default,,0,0,0,,(терең тыныс алу дыбысы)
Dialogue: 0,0:45:17.28,0:45:22.59,Default,,0,0,0,,Мен мұны істей аламын деп ойладым, себебі бұл арман болды, бірақ бәрібір қиын.
Dialogue: 0,0:45:24.44,0:45:25.43,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:45:39.36,0:45:40.63,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:45:55.92,0:46:00.07,Default,,0,0,0,,Қайырлы таң, Сенпай, бүгін тағы суық.
Dialogue: 0,0:46:26.16,0:46:26.99,Default,,0,0,0,,Аға
Dialogue: 0,0:46:30.16,0:46:31.47,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:46:37.00,0:46:37.99,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:46:38.20,0:46:40.27,Default,,0,0,0,,Күте тұрыңыз, Сенпай.
Dialogue: 0,0:46:41.36,0:46:44.10,Default,,0,0,0,,Күте тұрыңыз... өтінемін
Dialogue: 0,0:47:03.52,0:47:04.77,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:47:22.36,0:47:23.87,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:47:44.56,0:47:47.23,Default,,0,0,0,,(Шекарадан тыс дыбыс)
Dialogue: 0,0:47:57.60,0:48:01.95,Default,,0,0,0,,Аруақ біреудің кекінен қалыптасатын нәрсе болса.
Dialogue: 0,0:48:02.08,0:48:06.23,Default,,0,0,0,,Бұл адамның өшпенділігінің массасы.
Dialogue: 0,0:48:06.56,0:48:11.03,Default,,0,0,0,,Бұл маған сәйкес келеді.
Dialogue: 0,0:48:11.36,0:48:12.75,Default,,0,0,0,,3 ай?
Dialogue: 0,0:48:12.88,0:48:15.75,Default,,0,0,0,,Иә, мен көптен бері комада болдым.
Dialogue: 0,0:48:16.16,0:48:17.43,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:48:17.76,0:48:20.95,Default,,0,0,0,,Әрине, сен енді өлмейтін емессің.
Dialogue: 0,0:48:21.04,0:48:25.43,Default,,0,0,0,,Бұрын сіздің ішіңізде өмір сүрген шекара жойылды.
Dialogue: 0,0:48:25.52,0:48:27.23,Default,,0,0,0,,Оның әлі тірі екендігі таңқаларлық.
Dialogue: 0,0:48:27.60,0:48:29.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:48:29.20,0:48:32.23,Default,,0,0,0,,Менің өлмейтіндігім жартылай жын болудан емес пе еді?
Dialogue: 0,0:48:32.60,0:48:35.71,Default,,0,0,0,,Мүмкін, бірақ мен сенімді емеспін.
Dialogue: 0,0:48:37.44,0:48:39.79,Default,,0,0,0,,Анаңмен сөйлесіп көр.
Dialogue: 0,0:48:41.04,0:48:43.59,Default,,0,0,0,,Сонымен, Курияма мырза ше?
Dialogue: 0,0:48:45.64,0:48:47.59,Default,,0,0,0,,Мираи Курияма жоғалып кетті.
Dialogue: 0,0:48:48.48,0:48:51.11,Default,,0,0,0,,Мен сені құтқару үшін бар қанымды жұмсаймын
Dialogue: 0,0:48:51.24,0:48:55.23,Default,,0,0,0,,Шекараның арғы бетімен бірге бұл дүниеден ғайып болды.
Dialogue: 0,0:48:57.32,0:48:59.27,Default,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,0:49:11.32,0:49:14.83,Default,,0,0,0,,Міне, мен үш айдан бері ештеңе жеген жоқпын.
Dialogue: 0,0:49:14.92,0:49:16.87,Default,,0,0,0,,Сонымен, сіз қалай ойлайсыз?
Dialogue: 0,0:49:17.00,0:49:19.67,Default,,0,0,0,,Акки аспаннан дыбыс шыққанын айтады.
Dialogue: 0,0:49:20.00,0:49:22.31,Default,,0,0,0,,Қанбара-кунның басында не болған
Dialogue: 0,0:49:22.48,0:49:24.15,Default,,0,0,0,,Шекарадан тыс
Dialogue: 0,0:49:25.52,0:49:29.35,Default,,0,0,0,,Денемнен соншалықты шектен шыққан нәрсе шыққанына сене алар емеспін.
Dialogue: 0,0:49:29.44,0:49:32.95,Default,,0,0,0,,Егер біз естімейтін дыбысты еститін болсақ ше?
Dialogue: 0,0:49:33.04,0:49:36.19,Default,,0,0,0,,Мен мұны тек шекарадан шыққан әсер деп есептей аламын.
Dialogue: 0,0:49:37.74,0:49:40.75,Default,,0,0,0,,Хироми Изуми қайда орналасқан?
Dialogue: 0,0:49:42.72,0:49:43.99,Default,,0,0,0,,Шекарадан тыс
Dialogue: 0,0:49:44.76,0:49:48.15,Default,,0,0,0,,Бұл қарғыс атқан қанды ру ғана жеңе алатын жын еді.
Dialogue: 0,0:49:48.24,0:49:49.67,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:49:51.92,0:49:52.99,Default,,0,0,0,,Бірақ мәселе туындады
Dialogue: 0,0:49:54.04,0:49:56.59,Default,,0,0,0,,Мираи Курияма сені өлтіргісі келмейтінін айтты.
Dialogue: 0,0:49:57.56,0:50:00.19,Default,,0,0,0,,Сондықтан сізге қалай көмектесетінімді көрсетуден басқа амалым қалмады.
Dialogue: 0,0:50:01.16,0:50:03.91,Default,,0,0,0,,Тыныштық кезінде ғана қолдануға болатын әдіс
Dialogue: 0,0:50:04.04,0:50:07.35,Default,,0,0,0,,Мен мұндай түсініктемеге қанағаттанамын деп ойлайсыз ба?
Dialogue: 0,0:50:07.48,0:50:10.63,Default,,0,0,0,,Курияма мырзаның бұл әдісті таңдайтынын білуім керек еді!
Dialogue: 0,0:50:11.92,0:50:14.83,Default,,0,0,0,,Ал... кек сақтағың келсе, кек сақта.
Dialogue: 0,0:50:14.92,0:50:18.63,Default,,0,0,0,,Бірақ мен Назенің адамы ретінде барлығын қорғауға міндетті едім.
Dialogue: 0,0:50:19.28,0:50:21.39,Default,,0,0,0,,Мен бұл дүниені қорғауға міндеттімін.
Dialogue: 0,0:50:21.88,0:50:25.07,Default,,0,0,0,,Мираи Курияманың да қорғағысы келетін бірдеңесі бар еді.
Dialogue: 0,0:50:26.00,0:50:27.91,Default,,0,0,0,,Өз өміріңізден маңыздырақ не бар
Dialogue: 0,0:50:28.72,0:50:31.63,Default,,0,0,0,,Өлсем де қорғағым келетін нәрсе
Dialogue: 0,0:50:32.48,0:50:35.19,Default,,0,0,0,,Оны өз еркімен сақтады.
Dialogue: 0,0:50:36.16,0:50:38.59,Default,,0,0,0,,Мен Мираи Куриямаға ризамын.
Dialogue: 0,0:50:38.76,0:50:41.43,Default,,0,0,0,,Егер ол бұл әдісті таңдамаған болса
Dialogue: 0,0:50:41.60,0:50:44.79,Default,,0,0,0,,Біз бұл жерде ешқашан тұрмас едік.
Dialogue: 0,0:50:45.40,0:50:49.23,Default,,0,0,0,,Жоқ, бұл дүниенің өзі жоғалып кетуі керек еді.
Dialogue: 0,0:50:49.88,0:50:51.47,Default,,0,0,0,,Соңында ол
Dialogue: 0,0:50:51.60,0:50:54.43,Default,,0,0,0,,Оянғанда ашуланасың деді.
Dialogue: 0,0:50:55.12,0:50:57.51,Default,,0,0,0,,Бұл «Зама-миро»
Dialogue: 0,0:50:57.60,0:50:59.23,Default,,0,0,0,,(Шекарадан тыс дыбыс)
Dialogue: 0,0:51:08.00,0:51:10.35,Default,,0,0,0,,Күндер қысқарып барады.
Dialogue: 0,0:51:11.92,0:51:17.11,Default,,0,0,0,,Мен мұны істей аламын деп ойладым, себебі бұл арман болды, бірақ бәрібір қиын.
Dialogue: 0,0:51:19.00,0:51:19.87,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:51:23.72,0:51:24.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:51:32.04,0:51:34.19,Default,,0,0,0,,Егер болашақта болса, мен үйге оралмас едім.
Dialogue: 0,0:51:34.96,0:51:35.90,Default,,0,0,0,,Инами мырза
Dialogue: 0,0:51:36.09,0:51:37.19,Default,,0,0,0,,Болашақ қайда?
Dialogue: 0,0:51:41.16,0:51:43.15,Default,,0,0,0,,Жауап! Болашақ қайда? ?
Dialogue: 0,0:51:59.32,0:52:00.47,Default,,0,0,0,,Мұндай арқа
Dialogue: 0,0:52:03.16,0:52:05.99,Default,,0,0,0,,Арқаңды олай көрсетпе.
Dialogue: 0,0:52:31.80,0:52:35.79,Default,,0,0,0,,«Бұл электрондық пошта менің ағама жетеді ме, жоқ па?»
Dialogue: 0,0:52:36.04,0:52:39.03,Default,,0,0,0,,«Менің ағам мұны оқи ма?»
Dialogue: 0,0:52:39.12,0:52:43.43,Default,,0,0,0,,«Мен мұны қазір де түсінбеймін».
Dialogue: 0,0:52:43.80,0:52:46.67,Default,,0,0,0,,«Бұл Мирай Курияма, менің ағам».
Dialogue: 0,0:52:48.00,0:52:52.19,Default,,0,0,0,,«Енді мен ағама барамын».
Dialogue: 0,0:52:53.00,0:52:56.55,Default,,0,0,0,,«Барып, шекараның екінші жағын жеңіңіз».
Dialogue: 0,0:53:01.56,0:53:05.59,Default,,0,0,0,,«Мен өзімді қазір біртүрлі сезінемін».
Dialogue: 0,0:53:06.32,0:53:09.23,Default,,0,0,0,,«Мен аздап бақыттымын».
Dialogue: 0,0:53:10.96,0:53:15.51,Default,,0,0,0,,«Мен қарғыс атқан қанның руында тудым».
Dialogue: 0,0:53:15.60,0:53:18.03,Default,,0,0,0,,«Бұл әрқашан маған ұнамайтын нәрсе болды».
Dialogue: 0,0:53:18.56,0:53:22.23,Default,,0,0,0,,«Мен әрқашан қалай дүниеге келдім деп ойлаймын».
Dialogue: 0,0:53:22.56,0:53:25.39,Default,,0,0,0,,«Бір жерде мен өлгім келеді деп ойладым...».
Dialogue: 0,0:53:26.08,0:53:29.31,Default,,0,0,0,,«Бірақ бұл қате болды».
Dialogue: 0,0:53:29.80,0:53:33.07,Default,,0,0,0,,«Мен туғаныма қуаныштымын».
Dialogue: 0,0:53:33.84,0:53:37.95,Default,,0,0,0,,«Маған бұл билік қарғысқа ұшырағанын айтты».
Dialogue: 0,0:53:38.08,0:53:42.91,Default,,0,0,0,,«Бұл жеккөрінішті күш ешкімге зиян тигізбеуі керек».
Dialogue: 0,0:53:43.04,0:53:46.27,Default,,0,0,0,,«Мен біреуді құтқаруға күшім бар екенін түсіндім».
Dialogue: 0,0:53:46.56,0:53:50.95,Default,,0,0,0,,«Мен осы уақытқа дейін өмір сүріп, өлмегеніме өте қуаныштымын».
Dialogue: 0,0:53:51.68,0:53:57.27,Default,,0,0,0,,«Мен осы қалаға келгеніме және үлкендермен танысқаныма өте қуаныштымын».
Dialogue: 0,0:53:57.56,0:54:00.75,Default,,0,0,0,,«Мен ойлағаннан да көп»
Dialogue: 0,0:54:00.92,0:54:03.35,Default,,0,0,0,,«Мен мәңгі бақытты болдым».
Dialogue: 0,0:54:03.68,0:54:06.23,Default,,0,0,0,,«Мен қарғысқа ұшыраған жоқпын».
Dialogue: 0,0:54:07.96,0:54:14.23,Default,,0,0,0,,«Аға-сенпай, кәдімгідей өлесің.
Dialogue: 0,0:54:15.84,0:54:17.11,Default,,0,0,0,,«Сонымен...»
Dialogue: 0,0:54:18.04,0:54:22.03,Default,,0,0,0,,«Олай болса, қазірден бастап қалыпты өмір сүріңіз.»
Dialogue: 0,0:54:22.68,0:54:26.63,Default,,0,0,0,,«Сол кезде ағамның айтқанындай...»
Dialogue: 0,0:54:27.32,0:54:29.47,Default,,0,0,0,,«Сенпай, мен...»
Dialogue: 0,0:54:31.52,0:54:33.23,Default,,0,0,0,,(Акихитоның жылаған дауысы)
Dialogue: 0,0:54:51.92,0:54:55.27,Default,,0,0,0,,Сенпай! Дұрыс жасырмасаң жақсы емес!
Dialogue: 0,0:55:07.52,0:55:08.91,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:55:10.32,0:55:11.67,Default,,0,0,0,,Аға
Dialogue: 0,0:55:13.36,0:55:15.15,Default,,0,0,0,,Мен ағамын
Dialogue: 0,0:55:16.80,0:55:18.63,Default,,0,0,0,,Мен қорғаймын
Dialogue: 0,0:55:39.00,0:55:42.67,Default,,0,0,0,,(Шектен тыс дыбыс)
Dialogue: 0,0:55:54.60,0:55:56.15,Default,,0,0,0,,Аспанда не көріп тұрсың?
Dialogue: 0,0:56:00.84,0:56:01.83,Default,,0,0,0,,Сен!
Dialogue: 0,0:56:04.16,0:56:05.23,Default,,0,0,0,,Нино-сан
Dialogue: 0,0:56:05.32,0:56:07.91,Default,,0,0,0,,Бұл кезекті фестиваль сияқты.
Dialogue: 0,0:56:09.08,0:56:11.23,Default,,0,0,0,,Бұл не сұмдық?
Dialogue: 0,0:56:14.44,0:56:15.71,Default,,0,0,0,,Инами мырза
Dialogue: 0,0:56:15.80,0:56:16.75,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:56:17.60,0:56:18.75,Default,,0,0,0,,Акки
Dialogue: 0,0:56:18.84,0:56:21.91,Default,,0,0,0,,Хироми, балалар мұнда неге келдіңдер?
Dialogue: 0,0:56:22.48,0:56:23.77,Default,,0,0,0,,Мұны біреу жасады
Dialogue: 0,0:56:23.77,0:56:25.15,Default,,0,0,0,,Сен!
Dialogue: 0,0:56:28.44,0:56:30.43,Default,,0,0,0,,Тартымды болу
Dialogue: 0,0:56:32.72,0:56:34.07,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,0:56:38.56,0:56:41.64,Default,,0,0,0,,Е! Күте тұрыңыз! Күтіңіз, күтіңіз, күтіңіз...! Жоқ, түс!
Dialogue: 0,0:56:41.64,0:56:42.63,Default,,0,0,0,,Не? (Сакура) Сен бе?
Dialogue: 0,0:56:42.76,0:56:43.63,Default,,0,0,0,,Мөңке балығы! ? (Мидзуки) Жоқ!
Dialogue: 0,0:56:43.76,0:56:45.75,Default,,0,0,0,,Ендеше артқа тұрыңыз!
Dialogue: 0,0:56:51.04,0:56:51.87,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:56:52.28,0:56:53.95,Default,,0,0,0,,Оған тимеңіз, бұл қауіпті!
Dialogue: 0,0:56:54.32,0:56:55.75,Default,,0,0,0,,(Ер адамның үрген дауысы)
Dialogue: 0,0:56:58.00,0:56:59.12,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:57:00.80,0:57:03.47,Default,,0,0,0,,Не істеп жатырсың! Жағдайды ойлаңыз! Жағдайды ойлаңыз!
Dialogue: 0,0:57:03.72,0:57:06.35,Default,,0,0,0,,Сіз не істеп жатырсыз? Yacchan керемет көрініс береді
Dialogue: 0,0:57:07.44,0:57:10.79,Default,,0,0,0,,Ұзақ уақыттан кейін шықты деп ойладым, сонда ше? Ол хат сен де болды ма?
Dialogue: 0,0:57:10.88,0:57:13.27,Default,,0,0,0,,Қаншама күрделі істер атқардың! ақымақ!
Dialogue: 0,0:57:13.36,0:57:14.29,Default,,0,0,0,,Кім?
Dialogue: 0,0:57:14.29,0:57:15.15,Default,,0,0,0,,Аккидің анасы
Dialogue: 0,0:57:14.78,0:57:17.23,Default,,0,0,0,,Ақымақ деп айту одан да ақымақ~
Dialogue: 0,0:57:17.76,0:57:20.95,Default,,0,0,0,,Бұл рас па? Курияма-сан шынымен де тірі.
Dialogue: 0,0:57:21.68,0:57:24.11,Default,,0,0,0,,Иә, Йоро тірі.
Dialogue: 0,0:57:24.20,0:57:26.67,Default,,0,0,0,,Мираи-чан әлі жалғыз соғысуда.
Dialogue: 0,0:57:26.80,0:57:28.63,Default,,0,0,0,,Негізі мен сізге көмектесе алмаймын.
Dialogue: 0,0:57:28.72,0:57:32.19,Default,,0,0,0,,Егер шекарадан тыс адамдар жеңіске жете берсе, әлем жойылады.
Dialogue: 0,0:57:32.32,0:57:36.23,Default,,0,0,0,,Сондықтан мен төтенше жағдай болғандықтан икемді жауап беруді шештім.
Dialogue: 0,0:57:36.68,0:57:39.03,Default,,0,0,0,,Сонымен мен Курияма мырзаға қалай көмектесе аламын?
Dialogue: 0,0:57:39.16,0:57:42.23,Default,,0,0,0,,Осының алдында бір нәрсе сұрайын.
Dialogue: 0,0:57:43.56,0:57:46.79,Default,,0,0,0,,Барлығына! Мен Мираи Курияманың орнына барғым келеді.
Dialogue: 0,0:57:48.08,0:57:51.51,Default,,0,0,0,,Жақсы, тез айт! (Яйои) Түсіндім, Йоро.
Dialogue: 0,0:57:51.76,0:57:53.25,Default,,0,0,0,,Ши...төменгі жағы
Dialogue: 0,0:57:53.46,0:57:53.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:55.20,0:57:56.91,Default,,0,0,0,,Сіз тассыз ба?
Dialogue: 0,0:57:59.64,0:58:01.79,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:58:03.60,0:58:05.03,Default,,0,0,0,,Ах! Амал жоқ
Dialogue: 0,0:58:05.52,0:58:09.03,Default,,0,0,0,,Дұрыс, бұл тас Аккунның (Акихито) бөлігі.
Dialogue: 0,0:58:09.16,0:58:13.51,Default,,0,0,0,,Басқаша айтқанда, шекарадан тыс бөлік те бар.
Dialogue: 0,0:58:13.84,0:58:16.79,Default,,0,0,0,,(Шектен тыс дыбыстар)
Dialogue: 0,0:58:33.88,0:58:36.47,Default,,0,0,0,,Шекарадан тыс туындыны Мираи Аваяма жасаған
Dialogue: 0,0:58:37.24,0:58:41.39,Default,,0,0,0,,Акитоның күшті сезімінен жасалған қуыршақ бар.
Dialogue: 0,0:58:41.80,0:58:44.39,Default,,0,0,0,,Оны бар күшіңізбен ұстаңыз
Dialogue: 0,0:58:45.20,0:58:47.83,Default,,0,0,0,,Қалғанын Юму тасы шешеді.
Dialogue: 0,0:58:48.64,0:58:51.91,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,0:58:55.08,0:58:59.39,Default,,0,0,0,,Білесің бе, сенің анаң Яйой Канбара.
Dialogue: 0,0:59:04.76,0:59:08.35,Default,,0,0,0,,Мен сені бір күні мен туралы дұрыс айтуды сұраймын.
Dialogue: 0,0:59:11.96,0:59:13.95,Default,,0,0,0,,Сондай-ақ! Мен таң қалдым~
Dialogue: 0,0:59:14.08,0:59:15.07,Default,,0,0,0,,Яйои Канбара
Dialogue: 0,0:59:15.20,0:59:16.91,Default,,0,0,0,,Мені шошытпа, Изумин!
Dialogue: 0,0:59:17.00,0:59:18.59,Default,,0,0,0,,Жүр, тезірек!
Dialogue: 0,0:59:18.72,0:59:22.03,Default,,0,0,0,,Тоқта, сен не істейсің? сен қазірдің өзінде
Dialogue: 0,0:59:22.40,0:59:23.55,Default,,0,0,0,,Өлмейтін
Dialogue: 0,0:59:25.28,0:59:26.55,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:59:26.64,0:59:30.07,Default,,0,0,0,,Бірақ мен көзілдірік пен көзілдірікті әдемі қыздарға жасаймын.
Dialogue: 0,0:59:30.16,0:59:31.27,Default,,0,0,0,,мысық жартылай тірі, жартылай өлі.
Dialogue: 0,0:59:31.60,0:59:32.75,Default,,0,0,0,,Ол бұзық!
Dialogue: 0,0:59:37.68,0:59:38.71,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:59:39.02,0:59:40.41,Default,,0,0,0,,Енді біздің кезегіміз
Dialogue: 0,0:59:43.08,0:59:46.24,Default,,0,0,0,,Тартуыңыз әдеттен тыс.
Dialogue: 0,0:59:46.58,0:59:47.94,Default,,0,0,0,,Қанбара Сенпай
Dialogue: 0,0:59:47.94,0:59:50.17,Default,,0,0,0,,Оны соғуға дайын болыңыз
Dialogue: 0,0:59:50.17,0:59:52.02,Default,,0,0,0,,Мен сені міндетті түрде қайтарамын.
Dialogue: 0,0:59:52.98,0:59:53.76,Default,,0,0,0,,Иә
Dialogue: 0,1:00:42.70,1:00:43.84,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:59:32.88,0:59:34.87,Song,,0,0,0,,~Жалғыздық бетімді сулайды
Dialogue: 0,0:59:36.36,0:59:38.48,Song,,0,0,0,,~Мен оны ылғалдандырамын
Dialogue: 0,0:59:38.72,0:59:40.27,Song,,0,0,0,,~Таңның ату белгісі
Dialogue: 0,0:59:40.92,0:59:43.83,Song,,0,0,0,,～Үнсіздікке толы
Dialogue: 0,0:59:43.84,0:59:49.11,Default,,0,0,0,,~Мені аспанға шақыр
Dialogue: 0,0:59:49.12,0:59:51.43,Song,,0,0,0,,~Арғы жақта үміт күтіп тұр
Dialogue: 0,0:59:52.28,0:59:53.95,Song,,0,0,0,,~Иә, кеттік!
Dialogue: 0,0:59:58.84,0:59:59.83,Song,,0,0,0,,～Адасқаныммен
Dialogue: 0,1:00:01.08,1:00:03.59,Song,,0,0,0,,~ Сізді табу үшін саяхат
Dialogue: 0,1:00:04.72,1:00:05.71,Song,,0,0,0,,~ Сананың өтуі
Dialogue: 0,1:00:13.72,1:00:15.07,Song,,0,0,0,,～нақты
Dialogue: 0,1:00:16.32,1:00:17.83,Song,,0,0,0,,～Өзара тілектің жүрегі
Dialogue: 0,1:00:19.28,1:00:23.79,Song,,0,0,0,,~Бұл арманның дәлелі
Dialogue: 0,1:00:30.88,1:00:31.87,Song,,0,0,0,,～Қайғылы күндер
Dialogue: 0,1:00:33.08,1:00:34.39,Song,,0,0,0,,~Маған бұл енді керек емес
Dialogue: 0,1:00:35.28,1:00:37.31,Song,,0,0,0,,～Бір-бірін қабылдау
Dialogue: 0,1:00:42.88,1:00:47.19,Song,,0,0,0,,~Екеуміз де оянамыз
Dialogue: 0,1:01:15.60,1:01:17.27,Default,,0,0,0,,Аға
Dialogue: 0,1:01:21.84,1:01:22.79,Default,,0,0,0,,Курияма мырза
Dialogue: 0,1:01:24.92,1:01:26.55,Default,,0,0,0,,Зама~Миро
Dialogue: 0,1:01:29.64,1:01:33.23,Default,,0,0,0,,Сенпай, неге... неге келдің!? ?
Dialogue: 0,1:01:33.72,1:01:36.95,Default,,0,0,0,,Егер қарт адамдар келсе, оның мағынасы жоқ!
Dialogue: 0,1:01:37.08,1:01:38.48,Default,,0,0,0,,Мен не үшінмін?
Dialogue: 0,1:01:38.48,1:01:39.71,Default,,0,0,0,,Шу!
Dialogue: 0,1:01:40.36,1:01:42.39,Default,,0,0,0,,«Өтінемін, өмір сүріңіз»?
Dialogue: 0,1:01:42.96,1:01:45.91,Default,,0,0,0,,«Аға, кәдімгі адам болыңызшы»?
Dialogue: 0,1:01:46.24,1:01:47.67,Default,,0,0,0,,Кім мұны қалайды!
Dialogue: 0,1:01:47.88,1:01:50.07,Default,,0,0,0,,Оны кім және қашан сұрады?
Dialogue: 0,1:01:51.00,1:01:52.19,Default,,0,0,0,,Бұл жағымсыз!
Dialogue: 0,1:01:52.28,1:01:54.39,Default,,0,0,0,,Өте жағымсыз!
Dialogue: 0,1:01:54.56,1:01:56.55,Default,,0,0,0,,Мен ыңғайсызданамын!
Dialogue: 0,1:01:56.64,1:01:58.75,Default,,0,0,0,,Мен мұны бәрібір мойындамаймын!
Dialogue: 0,1:01:58.88,1:02:01.71,Default,,0,0,0,,Курияма-санның құрбандығына салынған өмір.
Dialogue: 0,1:02:02.00,1:02:04.75,Default,,0,0,0,,Болашақ... мағынасы жоқ.
Dialogue: 0,1:02:05.60,1:02:07.59,Default,,0,0,0,,Сіз мұны түсінбейсіз бе?
Dialogue: 0,1:02:08.84,1:02:11.75,Default,,0,0,0,,Сіз мұны білмедіңіз бе?
Dialogue: 0,1:02:15.76,1:02:20.03,Default,,0,0,0,,(Шекарадан тыс дыбыс)
Dialogue: 0,1:02:23.16,1:02:26.07,Default,,0,0,0,,Оны Youmu деп айту тым бос сөз.
Dialogue: 0,1:02:26.16,1:02:27.15,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,1:02:27.28,1:02:29.79,Default,,0,0,0,,Бастапқыда мен үлкендер арасында болдым.
Dialogue: 0,1:02:30.96,1:02:32.27,Default,,0,0,0,,Бұл орталық
Dialogue: 0,1:02:32.36,1:02:35.47,Default,,0,0,0,,Ішінде не бар, мұнда бардың бәрі бар.
Dialogue: 0,1:02:41.96,1:02:44.67,Default,,0,0,0,,Сенпай, бірдеңе түсіндің бе?
Dialogue: 0,1:02:44.80,1:02:45.63,Default,,0,0,0,,Не?
Dialogue: 0,1:02:45.76,1:02:47.11,Default,,0,0,0,,Бұл әлсіздік.
Dialogue: 0,1:02:47.24,1:02:50.87,Default,,0,0,0,,Мысалы, менің ағам сияқты менің қолтығым әлсіз.
Dialogue: 0,1:02:51.48,1:02:54.11,Default,,0,0,0,,Оның қолтығы қайда?
Dialogue: 0,1:02:54.48,1:02:57.79,Default,,0,0,0,,Сонда сізге ұнамайтын нәрсе жоқ па?
Dialogue: 0,1:02:57.88,1:02:58.99,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,1:02:59.24,1:03:01.15,Default,,0,0,0,,Бұл сіз жек көретін нәрсе ме?
Dialogue: 0,1:03:03.00,1:03:04.07,Default,,0,0,0,,Шишамо балалармен?
Dialogue: 0,1:03:05.12,1:03:08.99,Default,,0,0,0,,Шишамо балалармен!
Dialogue: 0,1:03:09.70,1:03:10.94,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,1:03:10.94,1:03:11.91,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,1:03:24.56,1:03:25.83,Default,,0,0,0,,Курияма мырза!
Dialogue: 0,1:03:40.00,1:03:41.72,Default,,0,0,0,,Сіздің қазіргі аға буыныңыз кім?
Dialogue: 0,1:03:41.72,1:03:42.99,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,1:03:43.98,1:03:46.43,Default,,0,0,0,,Мүмкін сол қол елеске айналған шығар?
Dialogue: 0,1:03:49.52,1:03:55.03,Default,,0,0,0,,Бұл тас менің ағамның бір бөлігі болды... шекарадан тыс...
Dialogue: 0,1:03:55.12,1:03:56.27,Default,,0,0,0,,Иә
Dialogue: 0,1:03:56.36,1:04:00.79,Default,,0,0,0,,Сенпай шекарасынан тыс биліктің бір бөлігі сіздің қолыңызда.
Dialogue: 0,1:04:01.56,1:04:03.11,Default,,0,0,0,,Мен қалай екенін білмеймін
Dialogue: 0,1:04:03.20,1:04:06.87,Default,,0,0,0,,Бірақ ағаның қабілеті тең болса
Dialogue: 0,1:04:07.52,1:04:10.59,Default,,0,0,0,,Бұл мұқият қарап шығуға тұрарлық сияқты.
Dialogue: 0,1:04:16.20,1:04:16.94,Default,,0,0,0,,Міне! ?
Dialogue: 0,1:04:17.68,1:04:19.31,Default,,0,0,0,,Менің алдымда Юму тұр.
Dialogue: 0,1:04:19.40,1:04:21.11,Default,,0,0,0,,Сондай-ақ төменде! ?
Dialogue: 0,1:04:28.24,1:04:32.47,Default,,0,0,0,,Сіз күткендей, Курияма мырза, осылай жалғастыруым керек пе?
Dialogue: 0,1:04:32.56,1:04:36.21,Default,,0,0,0,,Мен бұл туралы білмеймін, бірақ мен толық дроссельдемін!
Dialogue: 0,1:04:36.32,1:04:36.75,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:36.88,1:04:37.69,Default,,0,0,0,,Ойласам, ол бәріне белгілі нәрсе ғой.
Dialogue: 0,1:04:38.24,1:04:41.35,Default,,0,0,0,,Тоқтасақ та, уақытында жете алмаймыз~!
Dialogue: 0,1:04:43.90,1:04:44.67,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,1:05:01.36,1:05:04.23,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,1:05:15.20,1:05:16.47,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,1:05:22.80,1:05:24.19,Default,,0,0,0,,Тым көп ақымақтық
Dialogue: 0,1:05:24.28,1:05:26.91,Default,,0,0,0,,Бұл жердің бар болуының өзі ақымақтық.
Dialogue: 0,1:05:27.00,1:05:29.51,Default,,0,0,0,,Нақтырақ айтсам, менің ағам ақымақ.
Dialogue: 0,1:05:29.64,1:05:30.95,Default,,0,0,0,,Мен бе!
Dialogue: 0,1:05:34.40,1:05:36.27,Default,,0,0,0,,Бірақ әйтеуір мен сонда жеттім.
Dialogue: 0,1:05:37.36,1:05:38.63,Default,,0,0,0,,Бұл
Dialogue: 0,1:05:39.64,1:05:40.55,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:43.76,1:05:44.99,Default,,0,0,0,,Арғы жағы да шыдамсыз.
Dialogue: 0,1:05:45.08,1:05:45.96,Default,,0,0,0,,Түсінесіз бе!
Dialogue: 0,1:05:45.96,1:05:47.27,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:05:47.48,1:05:50.47,Default,,0,0,0,,Бірақ мен солай сезінемін.
Dialogue: 0,1:05:51.32,1:05:52.91,Default,,0,0,0,,Мен мұның қалай болатынына сенімдімін.
Dialogue: 0,1:05:53.20,1:05:56.07,Default,,0,0,0,,Бірдеңе Курияма-санға ұқсамайды.
Dialogue: 0,1:05:56.16,1:06:00.03,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,1:06:03.08,1:06:04.63,Default,,0,0,0,,Авайаманың болашағы қазір
Dialogue: 0,1:06:04.72,1:06:07.83,Default,,0,0,0,,Мазалағаны сонша, жиіркенішті!
Dialogue: 0,1:06:25.56,1:06:26.71,Default,,0,0,0,,Ха!
Dialogue: 0,1:06:34.04,1:06:36.51,Default,,0,0,0,,Курияма-сан, жүр!
Dialogue: 0,1:06:54.52,1:07:00.95,Default,,0,0,0,,(Шекарадан тыс дыбыс)
Dialogue: 0,1:07:06.24,1:07:07.39,Default,,0,0,0,,Курияма мырза
Dialogue: 0,1:07:07.72,1:07:08.71,Default,,0,0,0,,Акки
Dialogue: 0,1:07:15.52,1:07:17.91,Default,,0,0,0,,Курияма мырза Курияма мырза
Dialogue: 0,1:07:18.88,1:07:20.55,Default,,0,0,0,,Курияма мырза
Dialogue: 0,1:07:24.12,1:07:26.39,Default,,0,0,0,,Мені өлтірме (Б бала) Бұл жиіркенішті.
Dialogue: 0,1:07:26.56,1:07:29.07,Default,,0,0,0,,Мен құбыжықтардан қорқамын. Мен оларды өлтірмей өлсем ғой.
Dialogue: 0,1:07:29.16,1:07:30.75,Default,,0,0,0,,Бұл менікі
Dialogue: 0,1:07:31.44,1:07:34.67,Default,,0,0,0,,Мм...сенпай...
Dialogue: 0,1:07:35.56,1:07:37.67,Default,,0,0,0,,Не...? Бұл
Dialogue: 0,1:07:38.44,1:07:43.15,Default,,0,0,0,,Бұл қуыс көлеңкеде пайда болғанға ұқсайтын шығар.
Dialogue: 0,1:07:43.88,1:07:45.59,Default,,0,0,0,,Курияма-сан, көзіңді жұмы!
Dialogue: 0,1:07:45.68,1:07:47.59,Default,,0,0,0,,Не? (Акихито) Жарайды.
Dialogue: 0,1:07:48.36,1:07:49.67,Default,,0,0,0,,Иә!
Dialogue: 0,1:07:52.20,1:07:53.67,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,1:07:54.52,1:08:00.03,Default,,0,0,0,,Юму адамның жүрегіндегі бұрмалаушылық пен жек көрушіліктің көрінісі деп айтылады.
Dialogue: 0,1:08:00.52,1:08:04.75,Default,,0,0,0,,Жүрегіміздің әлсіздігі формада көрінеді.
Dialogue: 0,1:08:05.88,1:08:07.79,Default,,0,0,0,,Мен мұны алғаш кездескенімізде айтқанмын.
Dialogue: 0,1:08:08.72,1:08:10.63,Default,,0,0,0,,«Мен де»
Dialogue: 0,1:08:11.60,1:08:14.63,Default,,0,0,0,,Мен Курияма-санның жағындамын.
Dialogue: 0,1:08:15.36,1:08:17.07,Default,,0,0,0,,Біз кездестік
Dialogue: 0,1:08:17.96,1:08:19.47,Default,,0,0,0,,Енді жалғыз емес
Dialogue: 0,1:08:21.56,1:08:22.47,Default,,0,0,0,,Аға
Dialogue: 0,1:08:23.64,1:08:24.99,Default,,0,0,0,,Көзіңді аш
Dialogue: 0,1:08:30.72,1:08:34.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:08:38.32,1:08:41.63,Default,,0,0,0,,Мен сені жеңемін (болашақ) Иә? Мұның бәрі ме?
Dialogue: 0,1:08:41.76,1:08:43.47,Default,,0,0,0,,Басқа жол бар ма?
Dialogue: 0,1:08:48.48,1:08:49.91,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,1:09:55.06,1:09:57.95,Default,,0,0,0,,Сіз олардың бәрін жеңдіңіз бе?
Dialogue: 0,1:09:58.08,1:09:59.19,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:10:05.76,1:10:07.51,Default,,0,0,0,,Бұл әдемі, солай емес пе?
Dialogue: 0,1:10:17.60,1:10:19.95,Default,,0,0,0,,Сіз неден қорқасыз?
Dialogue: 0,1:10:20.68,1:10:24.35,Default,,0,0,0,,Уайымдама, сен менікісің.
Dialogue: 0,1:10:25.56,1:10:28.43,Default,,0,0,0,,Мұның бәрі менің ішімде болды.
Dialogue: 0,1:10:29.40,1:10:32.11,Default,,0,0,0,,Сол қара қызғаныш та
Dialogue: 0,1:10:33.60,1:10:37.27,Default,,0,0,0,,Ешқашан адам болмай қалудан үміт үзу!
Dialogue: 0,1:10:37.40,1:10:41.43,Default,,0,0,0,,Тастап кетудің мұңы және біреуді ренжіткеннің өкініші!
Dialogue: 0,1:10:42.00,1:10:42.79,Default,,0,0,0,,Аға
Dialogue: 0,1:10:42.96,1:10:45.39,Default,,0,0,0,,Өзімшілдік, күдік, жек көрушілік
Dialogue: 0,1:10:45.48,1:10:48.19,Default,,0,0,0,,Отставка, қулық және өзін-өзі сақтау!
Dialogue: 0,1:10:49.88,1:10:52.59,Default,,0,0,0,,Ештеңені сыртқа шығармаңыз!
Dialogue: 0,1:10:52.68,1:10:55.07,Default,,0,0,0,,Мұның бәрі менікі
Dialogue: 0,1:10:55.36,1:10:58.59,Default,,0,0,0,,Мен бәрін аламын!
Dialogue: 0,1:11:00.48,1:11:04.39,Default,,0,0,0,,Мен өлмейтін жартылай жынмын.
Dialogue: 0,1:11:16.32,1:11:17.75,Default,,0,0,0,,Аға
Dialogue: 0,1:11:28.16,1:11:32.67,Default,,0,0,0,,Сенпай, осында келе аласыз ба?
Dialogue: 0,1:11:35.40,1:11:36.27,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:11:37.28,1:11:40.99,Default,,0,0,0,,Мм...м...
Dialogue: 0,1:11:41.56,1:11:44.11,Default,,0,0,0,,Менің өтінішім бар...
Dialogue: 0,1:11:46.16,1:11:47.83,Default,,0,0,0,,Өтінемін?
Dialogue: 0,1:11:49.04,1:11:53.75,Default,,0,0,0,,Мм...қолыңызды беріңізші.
Dialogue: 0,1:11:53.84,1:11:54.38,Default,,0,0,0,,Қол?
Dialogue: 0,1:11:55.42,1:11:56.36,Default,,0,0,0,,Иә
Dialogue: 0,1:12:05.04,1:12:06.51,Default,,0,0,0,,Мені сипаңызшы...
Dialogue: 0,1:12:07.70,1:12:09.51,Default,,0,0,0,,Мені сипағаныңды қалаймын...
Dialogue: 0,1:12:21.48,1:12:22.99,Default,,0,0,0,,Курияма мырза
Dialogue: 0,1:12:23.48,1:12:26.35,Default,,0,0,0,,«рахмет» деп айтыңыз
Dialogue: 0,1:12:28.56,1:12:32.55,Default,,0,0,0,,Рахмет (болашақ) Мен шын жүректен емеспін.
Dialogue: 0,1:12:34.72,1:12:35.79,Default,,0,0,0,,Рахмет
Dialogue: 0,1:12:41.56,1:12:46.39,Default,,0,0,0,,Мен бақыттымын, мен бақыттымын
Dialogue: 0,1:12:46.88,1:12:48.55,Default,,0,0,0,,Курияма мырза...?
Dialogue: 0,1:12:48.92,1:12:51.91,Default,,0,0,0,,Мен бақыттымын... Мен бақыттымын.
Dialogue: 0,1:12:53.40,1:12:55.39,Default,,0,0,0,,Курияманың аяғы
Dialogue: 0,1:12:55.48,1:12:59.23,Default,,0,0,0,,Шекараның арғы беті менің сенпайыма оралды.
Dialogue: 0,1:13:00.16,1:13:02.59,Default,,0,0,0,,Бұл жер құлағалы тұр.
Dialogue: 0,1:13:02.80,1:13:05.19,Default,,0,0,0,,Мен де жоғалып кететін шығармын (Акихито) А...!
Dialogue: 0,1:13:05.96,1:13:09.39,Default,,0,0,0,,Енді шекараның арғы жағы қарттардың арасына оралды
Dialogue: 0,1:13:09.52,1:13:11.91,Default,,0,0,0,,Мен өмір сүре алмауым керек
Dialogue: 0,1:13:12.28,1:13:15.75,Default,,0,0,0,,Нағыз мен баяғыда кетті.
Dialogue: 0,1:13:16.28,1:13:19.43,Default,,0,0,0,,Мен ағамды кездестіргеніме өте қуаныштымын.
Dialogue: 0,1:13:19.52,1:13:20.35,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:13:20.44,1:13:23.95,Default,,0,0,0,,Сенпайыма шын ғашық болғаныма қуаныштымын.
Dialogue: 0,1:13:24.20,1:13:26.23,Default,,0,0,0,,Тоқта! Айтпа!
Dialogue: 0,1:13:27.68,1:13:30.95,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:13:32.52,1:13:34.07,Default,,0,0,0,,Курияма мырза!
Dialogue: 0,1:13:34.16,1:13:36.27,Default,,0,0,0,,Бұл өтірік! Күтіңіз, күтіңіз!
Dialogue: 0,1:13:36.40,1:13:38.91,Default,,0,0,0,,Курияма-сан!
Dialogue: 0,1:13:39.92,1:13:41.79,Default,,0,0,0,,Курияма мырза!
Dialogue: 0,1:13:43.48,1:13:46.91,Default,,0,0,0,,Уау!
Dialogue: 0,1:13:58.24,1:14:00.87,Default,,0,0,0,,Ол алдын ала анықталды ма?
Dialogue: 0,1:14:00.96,1:14:04.55,Default,,0,0,0,,Әлде Курияма мырзаның еңбекқорлығынан ба, білмеймін.
Dialogue: 0,1:14:05.60,1:14:08.67,Default,,0,0,0,,Мен соңғысын міндетті түрде ұсынар едім.
Dialogue: 0,1:14:09.16,1:14:12.31,Default,,0,0,0,,Қалай болғанда да, шекараның екінші жағы менің ішімде қайтады.
Dialogue: 0,1:14:13.00,1:14:15.43,Default,,0,0,0,,Дүниеде тыныштық орнады.
Dialogue: 0,1:14:15.68,1:14:18.39,Default,,0,0,0,,100 иен деген ұғым жоқ. 100 иен
Dialogue: 0,1:14:18.48,1:14:19.99,Default,,0,0,0,,Мен барамын
Dialogue: 0,1:14:20.12,1:14:21.99,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:14:22.08,1:14:23.91,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:14:24.24,1:14:25.35,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,1:14:25.88,1:14:28.31,Default,,0,0,0,,Күткеніңізге рахмет~ Иә? Ұйықтап жатыр! ?
Dialogue: 0,1:14:28.48,1:14:30.03,Default,,0,0,0,,Мо~Сакура-чан, оян!
Dialogue: 0,1:14:30.16,1:14:32.55,Default,,0,0,0,,Youmu әлі де бар
Dialogue: 0,1:14:32.68,1:14:36.91,Default,,0,0,0,,Басқа әлем оны жеңіп, өмірін әдеттегідей жалғастырады.
Dialogue: 0,1:14:37.00,1:14:40.59,Default,,0,0,0,,Аяка мен Ай да бұрынғы үйлеріне қайтты.
Dialogue: 0,1:14:42.28,1:14:44.35,Default,,0,0,0,,Мироку Фудзиманың қайда екені белгісіз.
Dialogue: 0,1:14:44.84,1:14:48.59,Default,,0,0,0,,Назэ отбасында Хироми Изуми мырзаның орнына жауапты.
Dialogue: 0,1:14:48.68,1:14:51.11,Default,,0,0,0,,Бұл ұстанымда өзгеріс болғанымен.
Dialogue: 0,1:14:51.52,1:14:53.87,Default,,0,0,0,,Өмірде ерекше өзгеріс болмайды.
Dialogue: 0,1:14:54.00,1:14:54.87,Default,,0,0,0,,Апа
Dialogue: 0,1:14:55.88,1:14:59.11,Default,,0,0,0,,Сен де түсінетін уақыт келеді.
Dialogue: 0,1:15:00.12,1:15:01.43,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:15:01.88,1:15:05.67,Default,,0,0,0,,Мизуки әлі де клуб бөлмесінде отыр және мені балағаттап жатыр.
Dialogue: 0,1:15:05.88,1:15:10.43,Default,,0,0,0,,Зұлымдықтың ақырында жойылатынын білсеңіз де, оқуды неге жалғастыру керек?
Dialogue: 0,1:15:10.56,1:15:15.03,Default,,0,0,0,,Бұл уақытты босқа кетіру емес пе? (Акихито) Бұл ойын-сауық, солай ма?
Dialogue: 0,1:15:15.16,1:15:16.39,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:15:16.52,1:15:20.91,Default,,0,0,0,,Қыс – қолды жылыту мезгілі. Бұл жерде табиғи емес ештеңе жоқ.
Dialogue: 0,1:15:21.04,1:15:22.41,Default,,0,0,0,,Бұл алып құмырсқа жегіш!
Dialogue: 0,1:15:22.41,1:15:23.17,Default,,0,0,0,,3 ұпай
Dialogue: 0,1:15:27.08,1:15:29.83,Default,,0,0,0,,Бірақ Мираи Курияма жоқ.
Dialogue: 0,1:15:30.52,1:15:33.83,Default,,0,0,0,,Соңында мен жеңілдім.
Dialogue: 0,1:15:34.32,1:15:37.23,Default,,0,0,0,,«Болашақ Мираи Курияманың құрбандығына негізделген».
Dialogue: 0,1:15:37.32,1:15:38.47,Default,,0,0,0,,«Бұл ештеңені білдірмейді».
Dialogue: 0,1:15:39.40,1:15:44.71,Default,,0,0,0,,Мен айқайладым, енді мен өмір сүріп жатырмын және сол болашақты қабылдаймын.
Dialogue: 0,1:15:45.00,1:15:47.95,Default,,0,0,0,,Курияма мырза осы уақытқа дейін айтқан болуы керек.
Dialogue: 0,1:15:48.24,1:15:50.43,Default,,0,0,0,,«Зама-ми-ро»
Dialogue: 0,1:15:51.20,1:15:52.71,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,1:15:57.96,1:16:01.39,Default,,0,0,0,,Мен... сен
Dialogue: 0,1:16:08.05,1:16:10.08,Default,,0,0,0,,Түнде де жарық болсын
Dialogue: 0,1:16:10.74,1:16:12.80,Default,,0,0,0,,Күндіз де қараңғылық болатыны сияқты
Dialogue: 0,1:16:13.28,1:16:16.16,Default,,0,0,0,,Дүниеден қараңғылық ешқашан жоғалмайды
Dialogue: 0,1:16:16.78,1:16:19.86,Default,,0,0,0,,Сонымен бірге дүниені қараңғылық толтырмайды.
Dialogue: 0,1:16:20.92,1:16:22.80,Default,,0,0,0,,Осындай екіұшты түстермен
Dialogue: 0,1:16:23.18,1:16:26.48,Default,,0,0,0,,Барлығы ілгерілей береді және шешіледі.
Dialogue: 0,1:16:27.77,1:16:30.46,Default,,0,0,0,,Олардың ішінде И
Dialogue: 0,1:16:51.17,1:16:52.85,Default,,0,0,0,,2-эпизод: Буггарати келеді
Dialogue: 0,1:16:55.61,1:16:56.40,Default,,0,0,0,,Көзілдірік
Dialogue: 0,1:16:46.61,1:16:51.82,Song,,0,0,0,,Тыныштықты кесуге келген адам болды
Dialogue: 0,1:16:52.29,1:16:57.48,Song,,0,0,0,,Біз үшін сөзсіз кездесу
Dialogue: 0,1:16:58.01,1:17:02.71,Song,,0,0,0,,Өкінішті көздеріңде осылай көрінесің
Dialogue: 0,1:17:02.96,1:17:09.02,Song,,0,0,0,,Әдемі гүлдеді, Мұңға оранып
Dialogue: 0,1:17:09.66,1:17:13.64,Song,,0,0,0,,Біреудің өміріне балқыған гүл
Dialogue: 0,1:17:13.90,1:17:19.34,Song,,0,0,0,,Эй, сен де көресің.
Dialogue: 0,1:17:19.85,1:17:21.34,Song,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,1:17:23.44,1:17:28.83,Song,,0,0,0,,Қайталанатын қателер, қайта бояп көрейік
Dialogue: 0,1:17:29.05,1:17:34.17,Song,,0,0,0,,Бастапқы жолды қалағаныңызша қайталаңыз
Dialogue: 0,1:17:34.69,1:17:40.11,Song,,0,0,0,,Өткеннен өзгеше ертең
Dialogue: 0,1:17:40.41,1:17:45.62,Song,,0,0,0,,Біз өз үмітімізді сызатын бастапқы сызық
Dialogue: 0,1:17:46.37,1:17:49.57,Song,,0,0,0,,Мен ешқашан қоштаспаймын
Dialogue: 0,1:17:49.92,1:17:51.93,Song,,0,0,0,,Әрқашан солай
Dialogue: 0,1:18:02.94,1:18:06.13,Song,,0,0,0,,Жалғастырушы дәлел ретінде кристалдар
Dialogue: 0,1:18:06.13,1:18:08.74,Song,,0,0,0,,Әлсіз тербелетін шамды ұстау
Dialogue: 0,1:18:08.96,1:18:14.33,Song,,0,0,0,,Жарқыраған болашаққа жанған көздерің аздап мұңды көрінеді.
Dialogue: 0,1:18:14.60,1:18:17.26,Song,,0,0,0,,Менің көзіме қарашы
Dialogue: 0,1:18:17.27,1:18:20.00,Song,,0,0,0,,Соңғы тамшыны сүртіңіз
Dialogue: 0,1:18:20.23,1:18:22.75,Song,,0,0,0,,Көргіңіз келген сайын маған қоңырау шалыңыз
Dialogue: 0,1:18:22.89,1:18:25.64,Song,,0,0,0,,Біз алғаш кездескен жерде.
Dialogue: 0,1:18:25.87,1:18:29.92,Song,,0,0,0,,Шашыраудың тағдырына қарсы
Dialogue: 0,1:18:30.07,1:18:35.51,Song,,0,0,0,,Гүлдей жарқын
Dialogue: 0,1:18:36.15,1:18:38.21,Song,,0,0,0,,Әрқашан
Dialogue: 0,1:18:39.64,1:18:45.01,Song,,0,0,0,,Өлеңдеген дауысыңызбен қосылу үшін
Dialogue: 0,1:18:45.29,1:18:50.30,Song,,0,0,0,,Менің үнім жүрегімнің түбінде жаңғырды
Dialogue: 0,1:18:50.94,1:18:56.29,Song,,0,0,0,,Намазда ойға келетін ертеңгі күн
Dialogue: 0,1:18:56.61,1:19:01.76,Song,,0,0,0,,Өйткені ол өмірдің мәнін үмітке өзгертеді
Dialogue: 0,1:19:02.58,1:19:06.42,Song,,0,0,0,,Мен сенімен бірге болғым келеді
Dialogue: 0,1:19:07.07,1:19:09.69,Song,,0,0,0,,Енді ешқашан қайталанбайтын қазіргі шындық
Dialogue: 0,1:19:09.89,1:19:12.36,Song,,0,0,0,,Оны алу үшін қандай құрбандық шалу керек?
Dialogue: 0,1:19:12.36,1:19:14.98,Song,,0,0,0,,Жалғыздықтан ешқашан арыла алмайсың
Dialogue: 0,1:19:15.21,1:19:17.12,Song,,0,0,0,,Мен оны қазір өлшей алмаймын.
Dialogue: 0,1:19:17.28,1:19:18.88,Song,,0,0,0,,Жарайды.
Dialogue: 0,1:19:19.15,1:19:21.71,Song,,0,0,0,,Дұғаларыңыз жаңғырық
Dialogue: 0,1:19:21.89,1:19:25.24,Song,,0,0,0,,Ән айтып жатқан даусымыз жаңғырық
Dialogue: 0,1:19:25.45,1:19:27.69,Song,,0,0,0,,Жарық сәулесін бояды
Dialogue: 0,1:19:27.90,1:19:30.62,Song,,0,0,0,,Жарқыраған жалғыз гүл
Dialogue: 0,1:19:30.84,1:19:33.80,Song,,0,0,0,,Сізбен қол ұстасу
Dialogue: 0,1:19:34.36,1:19:36.20,Song,,0,0,0,,Мен мәңгі қалғым келеді
Dialogue: 0,1:16:58.36,1:17:01.21,Default,,0,0,0,,Қысқасы, көзілдірік киген Курияма мырза
Dialogue: 0,1:17:01.88,1:17:03.26,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:17:16.70,1:17:17.76,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,1:17:18.49,1:17:20.73,Default,,0,0,0,,Ол алдын ала анықталды ма?
Dialogue: 0,1:17:21.04,1:17:24.17,Default,,0,0,0,,Әлде Курияма мырзаның еңбекқорлығынан ба, білмеймін.
Dialogue: 0,1:17:24.85,1:17:28.36,Default,,0,0,0,,Әлде Курияма мырзаға деген сезімім сізге жетті ме?
Dialogue: 0,1:17:29.57,1:17:32.16,Default,,0,0,0,,Мираи Курияма екеуміз осылай қайта қауыштық.
Dialogue: 0,1:17:32.98,1:17:36.46,Default,,0,0,0,,Егер бұл екі адам бір реттік қарым-қатынаста болса,
Dialogue: 0,1:17:37.29,1:17:40.77,Default,,0,0,0,,Бұл әлемде барлық оқиғалар болуы мүмкін емес.
Dialogue: 0,1:20:36.88,1:20:38.35,Default,,0,0,0,,Естімейді
Dialogue: 0,1:20:46.08,1:20:47.63,Default,,0,0,0,,Естімейді
Dialogue: 0,1:21:06.88,1:21:08.23,Default,,0,0,0,,Мен
Dialogue: 0,1:21:15.92,1:21:17.39,Default,,0,0,0,,Курияма мырза...?
Dialogue: 0,1:21:20.92,1:21:23.87,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,1:21:30.76,1:21:32.35,Default,,0,0,0,,Курияма-сан... (Болашақ) Сен
Dialogue: 0,1:21:34.60,1:21:35.87,Default,,0,0,0,,Жоқ, бұл тек қана тәжірибе.
Dialogue: 0,1:21:37.20,1:21:38.67,Default,,0,0,0,,Курияма мырза
Dialogue: 0,1:21:40.17,1:21:46.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory