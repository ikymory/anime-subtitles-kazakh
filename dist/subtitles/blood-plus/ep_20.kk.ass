Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:31.47,0:00:33.81,Default,,0,0,0,,(құлаққаптан опера ойнайды)
Dialogue: 0,0:00:51.76,0:00:57.78,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:18.65,0:02:24.66,Default,,0,0,0,,~♪
Dialogue: 0,0:02:29.84,0:02:32.84,Default,,0,0,0,,(әртүрлі адамдардың ыңырануы)
Dialogue: 0,0:02:46.03,0:02:47.96,Default,,0,0,0,,Мен Исландияға бару туралы айтып отырмын.
Dialogue: 0,0:02:48.04,0:02:50.46,Default,,0,0,0,,Өйткені сен екеуміз барамыз деп шештік.
Dialogue: 0,0:02:50.79,0:02:53.09,Default,,0,0,0,,Ах... түсіндім.
Dialogue: 0,0:02:53.17,0:02:55.72,Default,,0,0,0,,Мүмкін болса, 2-кезең есебін беріңіз.
Dialogue: 0,0:02:55.80,0:02:58.06,Default,,0,0,0,,Мен оны аяқтаған соң барғым келді.
Dialogue: 0,0:02:59.23,0:03:02.15,Default,,0,0,0,,Барар алдында оны аяқтау керек.
Dialogue: 0,0:03:02.23,0:03:05.07,Default,,0,0,0,,2-кезең жақсы өтіп жатқан сияқты.
Dialogue: 0,0:03:05.41,0:03:06.91,Default,,0,0,0,,Мәселе жоқ, солай ма?
Dialogue: 0,0:03:07.45,0:03:11.25,Default,,0,0,0,,Вьетнаммен салыстырғанда зоантропия ауруы
Dialogue: 0,0:03:11.33,0:03:14.09,Default,,0,0,0,,Ол 30%-ға төмендеді.
Dialogue: 0,0:03:14.17,0:03:15.97,Default,,0,0,0,,Иә, бұл керемет
Dialogue: 0,0:03:18.77,0:03:22.73,Default,,0,0,0,,Сонымен... ауру тудырған ақаулы өнім туралы.
Dialogue: 0,0:03:23.44,0:03:25.61,Default,,0,0,0,,Сізде кәдеге жарату жоспары бар ма?
Dialogue: 0,0:03:27.03,0:03:28.83,Default,,0,0,0,,Әзірше бұл жалғыз жол...
Dialogue: 0,0:03:29.12,0:03:32.00,Default,,0,0,0,,Сіз оны осылайша Атлант мұхитына батырғыңыз келе ме?
Dialogue: 0,0:03:32.08,0:03:36.55,Default,,0,0,0,,Алайда тышқанды өлтіретін жалғыз нәрсе – самурай адамы.
Dialogue: 0,0:03:36.64,0:03:37.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:38.60,0:03:40.31,Default,,0,0,0,,Оқшауланған аймақтағы бұзушы
Dialogue: 0,0:03:40.39,0:03:42.27,Default,,0,0,0,,D1 блогына қарай жылжу
Dialogue: 0,0:03:42.36,0:03:44.32,Default,,0,0,0,,Барлық жерде сақшылар асығуы керек.
Dialogue: 0,0:03:44.44,0:03:45.44,Default,,0,0,0,,Төменде?
Dialogue: 0,0:03:53.96,0:03:55.59,Default,,0,0,0,,Не?
Dialogue: 0,0:03:59.31,0:04:00.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:14.25,0:04:15.25,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:04:15.34,0:04:16.88,Default,,0,0,0,,Өзгеріс жоқ
Dialogue: 0,0:04:16.97,0:04:18.47,Default,,0,0,0,,Бұл әлі де Шевалье ме?
Dialogue: 0,0:04:18.55,0:04:19.89,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:23.52,0:04:24.86,Default,,0,0,0,,Кеттік, о
Dialogue: 0,0:04:35.04,0:04:37.26,Default,,0,0,0,,Бұл не? Сол жігіттер...
Dialogue: 0,0:04:46.73,0:04:49.03,Default,,0,0,0,,Сіз мені қайда апаруды жоспарлап отырсыз?
Dialogue: 0,0:04:49.53,0:04:51.87,Default,,0,0,0,,Саяны іздеу керек емес пе?
Dialogue: 0,0:04:51.95,0:04:52.83,Default,,0,0,0,,Бұл менің ниетім.
Dialogue: 0,0:04:52.91,0:04:56.00,Default,,0,0,0,,Ондай жағдайда осы тікұшақты іздеуге пайдаланған дұрыс болар еді...
Dialogue: 0,0:04:56.09,0:04:57.26,Default,,0,0,0,,Ах! а?
Dialogue: 0,0:04:59.93,0:05:01.10,Default,,0,0,0,,Кеме?
Dialogue: 0,0:05:01.22,0:05:04.73,Default,,0,0,0,,Дүние жүзінен Чиротани туралы ақпарат жиналатын орын.
Dialogue: 0,0:05:05.19,0:05:06.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:06.11,0:05:07.44,Default,,0,0,0,,Қызыл қалқанның штаб-пәтері.
Dialogue: 0,0:05:14.12,0:05:14.96,Default,,0,0,0,,Дэвид
Dialogue: 0,0:05:15.04,0:05:16.79,Default,,0,0,0,,Мен оқшауландым.
Dialogue: 0,0:05:16.88,0:05:18.51,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:18.92,0:05:20.09,Default,,0,0,0,,Дэвид
Dialogue: 0,0:05:20.22,0:05:21.34,Default,,0,0,0,,Джоэл
Dialogue: 0,0:05:21.80,0:05:24.81,Default,,0,0,0,,Элизабет жалаңаш күйінде табылды.
Dialogue: 0,0:05:25.19,0:05:26.77,Default,,0,0,0,,Элизабет туралы не деуге болады?
Dialogue: 0,0:05:27.52,0:05:28.86,Default,,0,0,0,,Бұл анықталды
Dialogue: 0,0:05:28.94,0:05:32.87,Default,,0,0,0,,Екатеринбургтен шығысқа қарай 300 шақырымдай жерде, темір жолдың дәл жанында.
Dialogue: 0,0:05:33.24,0:05:37.29,Default,,0,0,0,,Өлімнің болжамды күні мен уақыты 10 күннен астам бұрын болған сияқты.
Dialogue: 0,0:05:37.42,0:05:41.84,Default,,0,0,0,,Алайда Элизабетаның қимылдары соңғы рет расталды
Dialogue: 0,0:05:41.93,0:05:45.31,Default,,0,0,0,,Мен бір апта бұрын қонақүйге кірдім.
Dialogue: 0,0:05:45.39,0:05:48.23,Default,,0,0,0,,Бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:05:48.65,0:05:51.07,Default,,0,0,0,,Біз кездескен Лиза еді
Dialogue: 0,0:05:51.53,0:05:55.58,Default,,0,0,0,,Мен Транссібір темір жолының ортасында біреумен орын ауыстырдым.
Dialogue: 0,0:05:55.71,0:05:56.92,Default,,0,0,0,,Бұл... болуы мүмкін.
Dialogue: 0,0:05:57.00,0:05:58.00,Default,,0,0,0,,Иә
Dialogue: 0,0:05:58.54,0:06:01.38,Default,,0,0,0,,Күнделікті ашсаңыз, жауабын табасыз.
Dialogue: 0,0:06:02.89,0:06:05.52,Default,,0,0,0,,Шевалье адамдарға еліктейді
Dialogue: 0,0:06:05.60,0:06:09.23,Default,,0,0,0,,Сіз кездескен Лиза шевалье болатын.
Dialogue: 0,0:06:10.86,0:06:13.87,Default,,0,0,0,,Сізге 72 сағаттық тестілеу кезеңі беріледі.
Dialogue: 0,0:06:13.95,0:06:14.79,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:15.16,0:06:17.79,Default,,0,0,0,,Бұл кезеңдегі қозғалыстар шектелген.
Dialogue: 0,0:06:17.87,0:06:19.09,Default,,0,0,0,,Коллинзді күтіңіз
Dialogue: 0,0:06:19.80,0:06:20.88,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:06:20.96,0:06:22.80,Default,,0,0,0,,Қызыл қалқан №2
Dialogue: 0,0:06:23.22,0:06:27.39,Default,,0,0,0,,Қанатсыз екеніңіз дәлелденген кезде.
Dialogue: 0,0:06:27.48,0:06:29.31,Default,,0,0,0,,Сіз босатыласыз.
Dialogue: 0,0:06:29.77,0:06:30.78,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:31.32,0:06:33.32,Default,,0,0,0,,Дэвид, кешіріңіз.
Dialogue: 0,0:06:33.41,0:06:36.58,Default,,0,0,0,,Мен сізге күмәндануым керек.
Dialogue: 0,0:06:44.01,0:06:45.68,Default,,0,0,0,,6 зардап шеккендер
Dialogue: 0,0:06:45.76,0:06:48.77,Default,,0,0,0,,АҚШ-тың ядролық ұшақ тасығышында жарылыс болды.
Dialogue: 0,0:06:49.65,0:06:53.28,Default,,0,0,0,,Бұл экипаждың операциялық қателігінен болғаны жарияланды.
Dialogue: 0,0:06:53.95,0:06:55.91,Default,,0,0,0,,Бір кезде ол кеменің ішінде жасырынып қалды.
Dialogue: 0,0:06:55.99,0:06:58.62,Default,,0,0,0,,Қылмысты террористер жасады деген теория да болды.
Dialogue: 0,0:06:59.62,0:07:02.05,Default,,0,0,0,,АҚШ Әскери-теңіз күштері мұны жоққа шығарады.
Dialogue: 0,0:07:03.22,0:07:05.51,Default,,0,0,0,,Мен оны жүргізушіден алдым.
Dialogue: 0,0:07:11.48,0:07:14.49,Default,,0,0,0,,Мен үш күннен бері ештеңе қабылдаған жоқпын.
Dialogue: 0,0:07:15.11,0:07:18.04,Default,,0,0,0,,Тағамдық қолдауды жіберіп алмаған дұрыс
Dialogue: 0,0:07:18.12,0:07:20.12,Default,,0,0,0,,Саған қанаттар қашан шабуыл жасайды...
Dialogue: 0,0:07:20.42,0:07:22.21,Default,,0,0,0,,Олар сізге шабуыл жасамайды.
Dialogue: 0,0:07:22.29,0:07:24.59,Default,,0,0,0,,Өйткені мен, сол адамдар...
Dialogue: 0,0:07:24.68,0:07:27.26,Default,,0,0,0,,Сіз Chiroten мүшесісіз бе?
Dialogue: 0,0:07:31.77,0:07:33.48,Default,,0,0,0,,Неге үндемедің?
Dialogue: 0,0:07:34.49,0:07:36.95,Default,,0,0,0,,Сая олардан бөлек.
Dialogue: 0,0:07:37.32,0:07:39.33,Default,,0,0,0,,Маған жұбаныш керек емес
Dialogue: 0,0:07:39.71,0:07:41.00,Default,,0,0,0,,Лиза мырза...
Dialogue: 0,0:07:41.08,0:07:43.25,Default,,0,0,0,,Шевалье айтқан
Dialogue: 0,0:07:43.34,0:07:45.42,Default,,0,0,0,,Мен қанатты адаммын
Dialogue: 0,0:07:48.89,0:07:50.81,Default,,0,0,0,,Хироман дегеніміз не?
Dialogue: 0,0:07:51.06,0:07:52.40,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:07:52.77,0:07:54.61,Default,,0,0,0,,Бұл сіз...
Dialogue: 0,0:07:55.03,0:07:57.62,Default,,0,0,0,,Мен есте сақтауым керек, солай ма?
Dialogue: 0,0:07:58.24,0:07:59.66,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:00.04,0:08:01.54,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:08:01.62,0:08:04.05,Default,,0,0,0,,Сіз бұл үшін бара жатқан жоқсыз! хайуанаттар бағына
Dialogue: 0,0:08:05.01,0:08:07.59,Default,,0,0,0,,Қазір... жалғыз өзім жақсымын.
Dialogue: 0,0:08:23.46,0:08:25.55,Default,,0,0,0,,Сіз уақытындасыз.
Dialogue: 0,0:08:26.09,0:08:28.55,Default,,0,0,0,,Әрине. Ал қалған екеуі ше?
Dialogue: 0,0:08:29.30,0:08:32.81,Default,,0,0,0,,Аншель хён маған сәл кешігіп келетінін айтты.
Dialogue: 0,0:08:33.10,0:08:35.65,Default,,0,0,0,,Мен көп нәрсемен айналысатын бос адаммын.
Dialogue: 0,0:08:35.90,0:08:37.11,Default,,0,0,0,,Натанға не болды?
Dialogue: 0,0:08:37.19,0:08:38.82,Default,,0,0,0,,Әлі де байланыста...
Dialogue: 0,0:08:38.91,0:08:40.24,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:40.58,0:08:42.79,Default,,0,0,0,,Мен осындамын.
Dialogue: 0,0:08:42.91,0:08:44.25,Default,,0,0,0,,Қош келдіңіз, Натан.
Dialogue: 0,0:08:44.67,0:08:46.63,Default,,0,0,0,,Сүлеймен, қалайсың?
Dialogue: 0,0:08:46.71,0:08:48.97,Default,,0,0,0,,Мен сені сағындым, Джеймс.
Dialogue: 0,0:08:49.05,0:08:50.43,Default,,0,0,0,,Шулы, алыстаңыз
Dialogue: 0,0:08:51.01,0:08:53.85,Default,,0,0,0,,Қазірдің өзінде! Әскерилер қатал
Dialogue: 0,0:08:55.52,0:08:57.48,Default,,0,0,0,,Бала сияқты әрекет етпеңіз
Dialogue: 0,0:08:57.57,0:08:58.65,Default,,0,0,0,,(Танжиро) Бұған дейін кірген жебелер мені бұрын-соңды болмағандай күшпен тартып жатыр.
Dialogue: 0,0:08:58.74,0:09:02.66,Default,,0,0,0,,Алдыңғы қатарда жүргеніме біраз болды, сондықтан сіз өзіңізді жалқау сезінесіз деп ойлаймын.
Dialogue: 0,0:09:05.79,0:09:06.63,Default,,0,0,0,,О.
Dialogue: 0,0:09:08.17,0:09:09.38,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:09.47,0:09:11.64,Default,,0,0,0,,Бұл аздап көңілсіз болып көрінеді.
Dialogue: 0,0:09:12.06,0:09:14.90,Default,,0,0,0,,Таку... Қайсысы бала?
Dialogue: 0,0:09:15.40,0:09:17.82,Default,,0,0,0,,Хехе, не болды?
Dialogue: 0,0:09:19.32,0:09:22.37,Default,,0,0,0,,Десе де, бұл әлі де сүйкімді бақ.
Dialogue: 0,0:09:22.45,0:09:23.29,Default,,0,0,0,,Смитсондық
Dialogue: 0,0:09:23.37,0:09:25.83,Default,,0,0,0,,Осыншама әзіл болғанын қалаймын.
Dialogue: 0,0:09:26.79,0:09:29.26,Default,,0,0,0,,Мен опера театрының продюсері ретінде жұмысымды тастадым.
Dialogue: 0,0:09:29.34,0:09:31.85,Default,,0,0,0,,Сіз мұражай директоры болғыңыз келе ме?
Dialogue: 0,0:09:31.93,0:09:32.81,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:09:33.52,0:09:36.56,Default,,0,0,0,,Мен бұл туралы 100 жылдан кейін ойлай аламын ба?
Dialogue: 0,0:09:36.69,0:09:39.99,Default,,0,0,0,,Сіздің миыңыз дәл қазір келесі спектакль туралы ойларға толы.
Dialogue: 0,0:09:40.07,0:09:41.57,Default,,0,0,0,,Ах, дұрыс
Dialogue: 0,0:09:41.66,0:09:45.75,Default,,0,0,0,,Келесі спектакль, Cinq Fresh де демеуші ретінде қамтылған.
Dialogue: 0,0:09:45.83,0:09:47.21,Default,,0,0,0,,Тағы да?
Dialogue: 0,0:09:47.29,0:09:50.97,Default,,0,0,0,,Қарсы емеспін, бірақ келесі жолы алдымен бірдеңе айтыңызшы.
Dialogue: 0,0:09:51.05,0:09:54.56,Default,,0,0,0,,Менде де басқарушы қызметі бар, сондықтан
Dialogue: 0,0:09:55.23,0:09:56.64,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:09:56.73,0:10:00.36,Default,,0,0,0,,Менің ойымша, АҚШ әскери ұшақ тасығышына бару қызықты ма?
Dialogue: 0,0:10:00.95,0:10:03.53,Default,,0,0,0,,Соғыс кезінде ойын-сауықтың қажеті жоқ.
Dialogue: 0,0:10:03.78,0:10:07.00,Default,,0,0,0,,Бірақ борттағы адамдар адам ғой, солай ма?
Dialogue: 0,0:10:07.08,0:10:08.46,Default,,0,0,0,,Адамдарға арналған
Dialogue: 0,0:10:08.54,0:10:11.26,Default,,0,0,0,,Соғыс та ойын-сауықтың бір түрі емес пе?
Dialogue: 0,0:10:13.47,0:10:17.31,Default,,0,0,0,,Ал біз өмір сүріп жатқан елдердің басшылары кім екенін шешеміз.
Dialogue: 0,0:10:17.39,0:10:20.28,Default,,0,0,0,,Бұл ойын-сауықтан басқа ештеңе емес.
Dialogue: 0,0:10:20.36,0:10:22.36,Default,,0,0,0,,Айтпақшы, Дива оянады
Dialogue: 0,0:10:22.45,0:10:24.62,Default,,0,0,0,,Бұл қиын емес сияқты.
Dialogue: 0,0:10:25.79,0:10:26.75,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:10:26.83,0:10:29.96,Default,,0,0,0,,Біздің Диваның жағдайы қалай?
Dialogue: 0,0:10:30.30,0:10:33.97,Default,,0,0,0,,Мен сені әлі кездестірмеген жалғыз адаммын ба?
Dialogue: 0,0:10:34.05,0:10:36.18,Default,,0,0,0,,Аншель-нии-сан да әлі жоқ.
Dialogue: 0,0:10:37.02,0:10:38.85,Default,,0,0,0,,Олай болса, Дива
Dialogue: 0,0:10:38.94,0:10:42.15,Default,,0,0,0,,Оянудың қанын әлі татқан жоқсың.
Dialogue: 0,0:10:49.41,0:10:51.71,Default,,0,0,0,,(Жапырақтардың өліп жатқан дыбысы)
Dialogue: 0,0:11:03.90,0:11:05.03,Default,,0,0,0,,(Итадори) «Ха! Кугисаки, сол қанға тиме!»
Dialogue: 0,0:11:05.40,0:11:08.33,Default,,0,0,0,,Бар күшіммен инені шаншып алдым
Dialogue: 0,0:11:08.41,0:11:09.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:10.46,0:11:12.00,Default,,0,0,0,,Қалғандары ше?
Dialogue: 0,0:11:13.00,0:11:14.67,Default,,0,0,0,,Басқа жерде шығар
Dialogue: 0,0:11:18.05,0:11:19.18,Default,,0,0,0,,Эй
Dialogue: 0,0:11:20.02,0:11:24.15,Default,,0,0,0,,«Өтірікші» деп жазылған.
Dialogue: 0,0:11:24.57,0:11:26.11,Default,,0,0,0,,Саяны айтып тұрсың ба?
Dialogue: 0,0:11:26.19,0:11:27.95,Default,,0,0,0,,Тағы не бар?
Dialogue: 0,0:11:28.37,0:11:32.92,Default,,0,0,0,,Сен маған бәрін айтасың деп айттым.
Dialogue: 0,0:11:33.08,0:11:34.92,Default,,0,0,0,,Осы жолы айтып берейін.
Dialogue: 0,0:11:36.84,0:11:39.18,Default,,0,0,0,,Сая туралы бәрін білгің келе ме?
Dialogue: 0,0:11:39.51,0:11:40.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:40.77,0:11:42.44,Default,,0,0,0,,Мен сияқты ақымақ болсаң да
Dialogue: 0,0:11:42.52,0:11:45.15,Default,,0,0,0,,Мен оның қалыпты емес екенін айта аламын.
Dialogue: 0,0:11:45.57,0:11:49.62,Default,,0,0,0,,Бірақ онымен бірге өткізген жыл өтірік емес.
Dialogue: 0,0:11:49.70,0:11:53.92,Default,,0,0,0,,Ол қандай болса да, ол менің асыл отбасым.
Dialogue: 0,0:11:55.04,0:11:59.30,Default,,0,0,0,,Осы мақсатта Чиротенмен күресуді жалғастыра аласыз ба?
Dialogue: 0,0:12:01.93,0:12:03.19,Default,,0,0,0,,О
Dialogue: 0,0:12:08.28,0:12:10.83,Default,,0,0,0,,«Джоэлдің күнделігі» деп аталатын нәрсе бар.
Dialogue: 0,0:12:11.24,0:12:12.41,Default,,0,0,0,,Джоэл?
Dialogue: 0,0:12:12.50,0:12:16.04,Default,,0,0,0,,Мен мұндағы үлкен жігіттің есімі бар екеніне сенімдімін.
Dialogue: 0,0:12:16.55,0:12:19.68,Default,,0,0,0,,Бұл біз бен Қанатшылар арасындағы шайқастың жазбасы.
Dialogue: 0,0:12:19.76,0:12:21.89,Default,,0,0,0,,Сонымен бірге ол Саяның да тарихы.
Dialogue: 0,0:12:21.97,0:12:22.81,Default,,0,0,0,,Тарих?
Dialogue: 0,0:12:23.23,0:12:26.73,Default,,0,0,0,,Қанатшылармен күресуді жалғастыруға ерік-жігері барлар ғана
Dialogue: 0,0:12:26.82,0:12:29.86,Default,,0,0,0,,«Джоэлдің күнделігін» оқуға рұқсат
Dialogue: 0,0:12:29.99,0:12:32.24,Default,,0,0,0,,Бірақ қысқаша айтсаңыз
Dialogue: 0,0:12:33.58,0:12:36.29,Default,,0,0,0,,Бізге ешқашан қалыпты өмірге қайта оралуға рұқсат етілмейді.
Dialogue: 0,0:12:37.71,0:12:39.26,Default,,0,0,0,,Әлі де жақсы ма?
Dialogue: 0,0:12:40.93,0:12:43.52,Default,,0,0,0,,Маған сол күнделікті көрсет.
Dialogue: 0,0:13:01.80,0:13:05.48,Default,,0,0,0,,Енді ойлап қарасам, түнде Шевальемен кездескеніңізді естідім.
Dialogue: 0,0:13:05.56,0:13:08.44,Default,,0,0,0,,Иә, мен Вьетнамда көрдім.
Dialogue: 0,0:13:08.77,0:13:10.15,Default,,0,0,0,,Белгілі
Dialogue: 0,0:13:10.53,0:13:12.57,Default,,0,0,0,,Оның аты Қажы болатын.
Dialogue: 0,0:13:13.78,0:13:17.42,Default,,0,0,0,,Джеймс екеуміз ешқашан кездескен емеспіз.
Dialogue: 0,0:13:17.50,0:13:20.34,Default,,0,0,0,,Маған оның қандай адам екені өте қызық.
Dialogue: 0,0:13:20.63,0:13:22.30,Default,,0,0,0,,Қызық емес
Dialogue: 0,0:13:22.72,0:13:24.64,Default,,0,0,0,,Саған бәрібір емес пе?
Dialogue: 0,0:13:24.72,0:13:27.56,Default,,0,0,0,,Ол Диваның күйеу жігіті.
Dialogue: 0,0:13:27.85,0:13:30.53,Default,,0,0,0,,Diva-мен жұпталатын мақсат
Dialogue: 0,0:13:30.61,0:13:33.24,Default,,0,0,0,,Түсіру әдісінен басқа
Dialogue: 0,0:13:33.32,0:13:34.79,Default,,0,0,0,,Қызық емес
Dialogue: 0,0:13:34.91,0:13:37.16,Default,,0,0,0,,Сая сізді қызықтырмай ма?
Dialogue: 0,0:13:38.46,0:13:41.51,Default,,0,0,0,,Ол біздің қалыңдық
Dialogue: 0,0:13:41.76,0:13:43.68,Default,,0,0,0,,Дұрыс? Сүлеймен
Dialogue: 0,0:13:44.18,0:13:45.01,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:45.56,0:13:46.60,Default,,0,0,0,,Иә...
Dialogue: 0,0:13:46.68,0:13:47.85,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:13:48.14,0:13:50.27,Default,,0,0,0,,Бұл менің тағдырым.
Dialogue: 0,0:13:50.40,0:13:53.20,Default,,0,0,0,,Сонымен қатар ол қауіп нысанасы болып табылады.
Dialogue: 0,0:13:53.28,0:13:55.74,Default,,0,0,0,,Түнгі қан бізге өлім әкеледі.
Dialogue: 0,0:13:55.99,0:13:57.91,Default,,0,0,0,,Мен мұны да білемін.
Dialogue: 0,0:13:58.00,0:14:03.59,Default,,0,0,0,,Дегенмен, біз және ол негізінен бір түрміз.
Dialogue: 0,0:14:04.39,0:14:06.18,Default,,0,0,0,,Біз бір-бірімізді түсінуіміз керек.
Dialogue: 0,0:14:06.64,0:14:08.94,Default,,0,0,0,,Бірақ бұл ережені бұзған нәрсе...
Dialogue: 0,0:14:09.35,0:14:10.86,Default,,0,0,0,,Қызыл қалқан
Dialogue: 0,0:14:11.48,0:14:12.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:27.14,0:14:29.06,Default,,0,0,0,,Мен сенбеймін...
Dialogue: 0,0:14:31.53,0:14:34.20,Default,,0,0,0,,Бұл біз білетін шындық
Dialogue: 0,0:14:35.25,0:14:38.46,Default,,0,0,0,,Сонда да Саяны отбасы деп атай аласыз ба?
Dialogue: 0,0:14:42.39,0:14:44.35,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:45.18,0:14:47.65,Default,,0,0,0,,Олай болса, Сайо-ничан, мені іздейсің бе?
Dialogue: 0,0:14:47.73,0:14:48.57,Default,,0,0,0,,О
Dialogue: 0,0:14:48.90,0:14:49.74,Default,,0,0,0,,Тексеруден кейін
Dialogue: 0,0:14:49.82,0:14:51.86,Default,,0,0,0,,Кай мен оны бірден қараймын.
Dialogue: 0,0:14:54.83,0:14:55.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:57.21,0:14:58.50,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:15:01.47,0:15:02.68,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:02.84,0:15:03.68,Default,,0,0,0,,Бөлек
Dialogue: 0,0:15:04.22,0:15:05.60,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:15:13.62,0:15:15.08,Default,,0,0,0,,Барлығы дайын ба?
Dialogue: 0,0:15:16.00,0:15:17.58,Default,,0,0,0,,Карлдан басқа.
Dialogue: 0,0:15:25.22,0:15:27.73,Default,,0,0,0,,Сіз тіпті менімен байланысудан бас тарттыңыз. Қайда бардыңыз?
Dialogue: 0,0:15:27.81,0:15:29.65,Default,,0,0,0,,Ресей? Ресей?
Dialogue: 0,0:15:30.07,0:15:32.11,Default,,0,0,0,,Мен Саяны кездестірдім.
Dialogue: 0,0:15:33.53,0:15:36.29,Default,,0,0,0,,Саяны көзбен көретініме сене алар емеспін.
Dialogue: 0,0:15:36.37,0:15:39.67,Default,,0,0,0,,Бұрынғыдай батыл, Әншел.
Dialogue: 0,0:15:39.75,0:15:42.76,Default,,0,0,0,,Өз көзіммен көргім келді.
Dialogue: 0,0:15:43.01,0:15:45.35,Default,,0,0,0,,Қазіргі дәуірдің шағын түні
Dialogue: 0,0:15:45.43,0:15:46.77,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:15:47.14,0:15:51.82,Default,,0,0,0,,Бұл мен көрген ең адамға ұқсас түн болды.
Dialogue: 0,0:15:55.16,0:15:57.58,Default,,0,0,0,,Бірақ бұл қан бізді өлтіреді
Dialogue: 0,0:15:58.00,0:16:00.84,Default,,0,0,0,,Қажыны да растай алдың.
Dialogue: 0,0:16:01.55,0:16:04.51,Default,,0,0,0,,Сайо қайда жүрсе де, оның соңынан еріңіз.
Dialogue: 0,0:16:04.59,0:16:07.39,Default,,0,0,0,,Иә, бұл кішкентай ит сияқты.
Dialogue: 0,0:16:07.47,0:16:10.06,Default,,0,0,0,,Қажыны сол жерде неге ұстамадың?
Dialogue: 0,0:16:10.40,0:16:13.32,Default,,0,0,0,,Заттардың реті бар.
Dialogue: 0,0:16:13.40,0:16:16.16,Default,,0,0,0,,Ал мен қан төккім келмеді.
Dialogue: 0,0:16:16.24,0:16:17.08,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:16:17.16,0:16:18.29,Default,,0,0,0,,Иә
Dialogue: 0,0:16:18.37,0:16:21.04,Default,,0,0,0,,Бір нәсілдің адамдары бірін-бірі түсінуге де тырыспайды
Dialogue: 0,0:16:21.46,0:16:24.88,Default,,0,0,0,,Төгілген қанның мөлшеріне қарап шешім қабылдамайсың ба?
Dialogue: 0,0:16:24.97,0:16:28.60,Default,,0,0,0,,Адамның істегені сияқты емес пе?
Dialogue: 0,0:16:29.18,0:16:32.40,Default,,0,0,0,,Олай болса, қазірден бастап қандай шара қолданамыз?
Dialogue: 0,0:16:32.48,0:16:34.36,Default,,0,0,0,,Саяны сендіргің келе ме?
Dialogue: 0,0:16:34.44,0:16:37.37,Default,,0,0,0,,Дива да оянып, Қажы да табылды.
Dialogue: 0,0:16:37.45,0:16:41.79,Default,,0,0,0,,Бізде сақтық көшірмелердің орнатылғаны өте жақсы.
Dialogue: 0,0:16:42.21,0:16:45.26,Default,,0,0,0,,Саяның жағдайы Әншель айтқандай болса.
Dialogue: 0,0:16:45.34,0:16:47.18,Default,,0,0,0,,Мен бұл мүмкіндікті жіберіп алмаймын
Dialogue: 0,0:16:47.26,0:16:49.18,Default,,0,0,0,,Бұл.
Dialogue: 0,0:16:49.64,0:16:52.23,Default,,0,0,0,,Сайоны хайуанаттар бағына шақырды
Dialogue: 0,0:16:53.02,0:16:54.44,Default,,0,0,0,,Пайдасыз нәрселер
Dialogue: 0,0:16:54.53,0:16:57.20,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,0:16:57.62,0:17:00.25,Default,,0,0,0,,Сенің ағаңның айтқанына сенімдімін.
Dialogue: 0,0:17:00.33,0:17:03.17,Default,,0,0,0,,Барлығы осыдан басталды
Dialogue: 0,0:17:03.42,0:17:04.42,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:04.50,0:17:06.22,Default,,0,0,0,,Барлығы осыдан басталады
Dialogue: 0,0:17:06.30,0:17:08.55,Default,,0,0,0,,Және ол аяқталады
Dialogue: 0,0:17:09.26,0:17:12.06,Default,,0,0,0,,(бөтелкенің сықырлауы)
Dialogue: 0,0:17:12.69,0:17:18.62,Default,,0,0,0,,(Пики Пики)
Dialogue: 0,0:17:19.20,0:17:22.21,Default,,0,0,0,,(Пики Пики Пики)
Dialogue: 0,0:17:22.58,0:17:23.58,Default,,0,0,0,,(Паки!)
Dialogue: 0,0:17:25.63,0:17:26.47,Default,,0,0,0,,Иә
Dialogue: 0,0:17:26.84,0:17:30.26,Default,,0,0,0,,Маған классикалық спектакльдер ұнайды.
Dialogue: 0,0:17:30.35,0:17:32.52,Default,,0,0,0,,Классикалық музыка танымал, солай ма?
Dialogue: 0,0:17:32.60,0:17:35.90,Default,,0,0,0,,Ендеше Қажыны сол жерде ұстайсың.
Dialogue: 0,0:17:36.32,0:17:39.24,Default,,0,0,0,,Мүмкін болса, Қажының ниетімен келгеніңізді қалаймын.
Dialogue: 0,0:17:39.32,0:17:41.24,Default,,0,0,0,,Мен мұны істегім келеді.
Dialogue: 0,0:17:41.33,0:17:45.17,Default,,0,0,0,,Сондықтан мен Сайоны хайуанаттар бағына шақырдым.
Dialogue: 0,0:17:47.09,0:17:49.18,Default,,0,0,0,,Ал біз не істеуіміз керек
Dialogue: 0,0:17:49.80,0:17:52.98,Default,,0,0,0,,Кедергі болуы мүмкін кішкентай түндерді жою
Dialogue: 0,0:17:54.56,0:17:56.19,Default,,0,0,0,,Бауырым, бұл...
Dialogue: 0,0:17:56.61,0:17:58.15,Default,,0,0,0,,Өлтіремін дейсің бе?
Dialogue: 0,0:17:58.24,0:18:00.53,Default,,0,0,0,,Сіз байсалдысыз ба? аншел
Dialogue: 0,0:18:00.62,0:18:02.95,Default,,0,0,0,,Сая біздің келін, солай ма?
Dialogue: 0,0:18:03.33,0:18:06.50,Default,,0,0,0,,Біз дивалар үшін бармыз
Dialogue: 0,0:18:06.59,0:18:08.88,Default,,0,0,0,,Диваны өлтірмек болған тіршілік иесі
Dialogue: 0,0:18:08.97,0:18:10.43,Default,,0,0,0,,Мен сені кешіре алмаймын
Dialogue: 0,0:18:18.78,0:18:20.82,Default,,0,0,0,,Мен Әншелдің өсиетін орындаймын.
Dialogue: 0,0:18:21.24,0:18:22.70,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:23.95,0:18:26.92,Default,,0,0,0,,Шын мәнінде, қарсылық білдіруге ешқандай себеп жоқ.
Dialogue: 0,0:18:27.00,0:18:29.09,Default,,0,0,0,,Мен Қажыға қызығамын.
Dialogue: 0,0:18:29.97,0:18:33.60,Default,,0,0,0,,Сүлеймен, сен ше?
Dialogue: 0,0:18:33.72,0:18:34.93,Default,,0,0,0,,Менің ағама
Dialogue: 0,0:18:35.02,0:18:37.77,Default,,0,0,0,,Саяны аралайтын ойың жоқ, солай ма?
Dialogue: 0,0:18:39.19,0:18:40.53,Default,,0,0,0,,Әрине
Dialogue: 0,0:18:42.45,0:18:43.87,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:18:43.95,0:18:47.29,Default,,0,0,0,,Ағаның сөзі менің де ниетім.
Dialogue: 0,0:18:52.18,0:18:54.02,Default,,0,0,0,,Дива үшін
Dialogue: 0,0:18:55.52,0:18:57.40,Default,,0,0,0,,Дива үшін
Dialogue: 0,0:19:17.06,0:19:19.40,Default,,0,0,0,,Бауырым, мен...
Dialogue: 0,0:19:41.36,0:19:43.16,Default,,0,0,0,,Менен не керек?
Dialogue: 0,0:19:43.53,0:19:45.16,Default,,0,0,0,,Шевалье, солай ма?
Dialogue: 0,0:19:45.62,0:19:47.12,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:47.20,0:19:48.33,Default,,0,0,0,,Біз Шиффпіз
Dialogue: 0,0:19:48.42,0:19:49.71,Default,,0,0,0,,Мен сенің қаныңды аламын!
Dialogue: 0,0:20:20.73,0:20:21.69,Default,,0,0,0,,Иә
Dialogue: 0,0:20:23.44,0:20:24.28,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:24.70,0:20:26.03,Default,,0,0,0,,Бірақ бұған дейін осы жолы талқылауымыз керек бірнеше мәселе бар.
Dialogue: 0,0:20:26.37,0:20:28.83,Default,,0,0,0,,Ұстаудың қажеті жоқ.
Dialogue: 0,0:20:47.62,0:20:49.95,Default,,0,0,0,,Қорғау аяқталды
Dialogue: 0,0:20:50.04,0:20:51.67,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:20:52.71,0:20:54.55,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:55.05,0:20:56.47,Default,,0,0,0,,Олай болса
Dialogue: 0,0:20:56.55,0:20:59.18,Default,,0,0,0,,Маған Сүлеймен телефон соғып, келдім.
Dialogue: 0,0:20:59.35,0:21:01.44,Default,,0,0,0,,Тышқандар лагеріне шабуыл жасағандар
Dialogue: 0,0:21:02.06,0:21:04.40,Default,,0,0,0,,Ол өлі болды.
Dialogue: 0,0:21:04.48,0:21:06.61,Default,,0,0,0,,Мен де оны тыңдағым келеді.
Dialogue: 0,0:21:17.64,0:21:19.06,Default,,0,0,0,,Аға
Dialogue: 0,0:21:19.14,0:21:22.10,Default,,0,0,0,,Мен Саяны көремін.
Dialogue: 0,0:21:55.25,0:22:01.26,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:24.22,0:23:30.23,Default,,0,0,0,,~♪
Dialogue: 0,0:23:32.24,0:23:33.53,Default,,0,0,0,,Айға қараған сайын есіме түседі
Dialogue: 0,0:23:34.24,0:23:37.08,Default,,0,0,0,,Біздің өміріміздің шектеулі екендігі
Dialogue: 0,0:23:37.46,0:23:38.50,Default,,0,0,0,,Таң сәулесінен қорқу
Dialogue: 0,0:23:39.17,0:23:41.21,Default,,0,0,0,,Денемде басылған өлім таңбасынан қорқып
Dialogue: 0,0:23:41.88,0:23:43.84,Default,,0,0,0,,Салқын кешкі қараңғыда қалтырап
Dialogue: 0,0:23:44.51,0:23:46.35,Default,,0,0,0,,Сиқырды бұзу
Dialogue: 0,0:23:46.43,0:23:49.81,Default,,0,0,0,,Біз от пен мұз елінен құтылдық.
Dialogue: 0,0:23:49.90,0:23:52.78,Default,,0,0,0,,Өмір сүру, оны алу.
Dialogue: 0,0:23:52.99,0:23:55.20,Default,,0,0,0,,Келесі жолы «Blood Plus»
Dialogue: 0,0:23:55.28,0:23:56.29,Default,,0,0,0,,«Қышқыл жүзім»
Dialogue: 0,0:23:56.87,0:23:59.79,Default,,0,0,0,,Сайо, біз сені өлтіреміз.
Dialogue: 0,0:24:01.29,0:24:07.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory