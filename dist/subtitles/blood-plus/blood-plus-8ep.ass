Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.52,0:00:04.94,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:05.15,0:00:07.40,Default,,0,0,0,,Уфуфу Кеш кеш!
Dialogue: 0,0:00:07.90,0:00:09.02,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:09.11,0:00:10.98,Default,,0,0,0,,Дәлізде тыныш болыңыз
Dialogue: 0,0:00:11.07,0:00:12.99,Default,,0,0,0,,Қайырлы таң (оқушы қыз) Ли ханым
Dialogue: 0,0:00:13.82,0:00:15.32,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:20.62,0:00:23.41,Default,,0,0,0,,Биылғы күз өте ыстық.
Dialogue: 0,0:00:23.50,0:00:24.58,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:00:34.55,0:00:40.56,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:01.93,0:02:07.94,Default,,0,0,0,,~♪
Dialogue: 0,0:02:13.44,0:02:15.40,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:02:26.04,0:02:28.00,Default,,0,0,0,,(кеме ысқырығы)
Dialogue: 0,0:02:50.10,0:02:52.65,Default,,0,0,0,,``Осы картамен танктерді де сатып алуға болады.''
Dialogue: 0,0:02:53.90,0:02:55.19,Default,,0,0,0,,«Льюис»
Dialogue: 0,0:02:55.32,0:02:56.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:56.78,0:02:57.61,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:02:58.03,0:03:01.70,Default,,0,0,0,,Сіздің жолдасыңыз кеш шықты.
Dialogue: 0,0:03:02.57,0:03:03.57,Default,,0,0,0,,Төлем де
Dialogue: 0,0:03:03.66,0:03:06.33,Default,,0,0,0,,Сол кезде барлығын бірден аяқтаймыз.
Dialogue: 0,0:03:08.66,0:03:09.91,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:03:10.21,0:03:13.21,Default,,0,0,0,,Бұл кеме Филиппиннен кеше ғана келді.
Dialogue: 0,0:03:13.75,0:03:16.25,Default,,0,0,0,,Бортта бірде-бір жапондық болған жоқ.
Dialogue: 0,0:03:16.34,0:03:19.17,Default,,0,0,0,,Біз ертең Австралияға кетеміз.
Dialogue: 0,0:03:19.72,0:03:23.97,Default,,0,0,0,,Егер сіз Жапониядан кеме іздеп жатсаңыз, кеңсеге барып, сұраңыз.
Dialogue: 0,0:03:25.26,0:03:26.68,Default,,0,0,0,,Кездескенше, монах
Dialogue: 0,0:03:30.10,0:03:31.44,Default,,0,0,0,,(Тодороки) Камино… (Камино) Жарайды, алдым.
Dialogue: 0,0:03:32.69,0:03:35.52,Default,,0,0,0,,Артында қалды ма? біз
Dialogue: 0,0:03:39.07,0:03:40.49,Default,,0,0,0,,
Dialogue: 0,0:03:41.86,0:03:42.78,Default,,0,0,0,,Min?
Dialogue: 0,0:03:42.86,0:03:44.74,Default,,0,0,0,,Қызық, қайда бардың?
Dialogue: 0,0:03:49.29,0:03:52.08,Default,,0,0,0,,Төсегіңіз бен үстеліңіз сол жақта
Dialogue: 0,0:03:52.16,0:03:53.42,Default,,0,0,0,,Пакет түстен кейін келген бойда
Dialogue: 0,0:03:53.79,0:03:56.17,Default,,0,0,0,,Мен сені мына бөлмеге апарайын.
Dialogue: 0,0:03:56.71,0:03:59.25,Default,,0,0,0,,Жатақханада ояту 6:30.
Dialogue: 0,0:03:59.34,0:04:01.17,Default,,0,0,0,,Таңғы ас 7-де
Dialogue: 0,0:04:01.26,0:04:06.01,Default,,0,0,0,,Құлшылық сағат 8-де, сабақ сағат 9-да басталады.
Dialogue: 0,0:04:06.09,0:04:10.06,Default,,0,0,0,,Кешкі ас 7-де, жарық 10-да сөнеді...
Dialogue: 0,0:04:13.94,0:04:15.44,Default,,0,0,0,,Түсіндің бе? (Saya) Huh?
Dialogue: 0,0:04:15.69,0:04:18.57,Default,,0,0,0,,Бұл мектеп ақыл мен мінезді біріктіреді.
Dialogue: 0,0:04:18.65,0:04:22.11,Default,,0,0,0,,Біздің негізгі саясатымыз – әйелдерді өсіру.
Dialogue: 0,0:04:22.19,0:04:24.45,Default,,0,0,0,,Барлық ережелерді сақтаңыз... (есіктің ашылған дыбысы)
Dialogue: 0,0:04:24.82,0:04:27.49,Default,,0,0,0,,Sorry I'm late! Хаа...
Dialogue: 0,0:04:27.78,0:04:29.95,Default,,0,0,0,,Сая Бұл бір бөлмеде отырған Мин.
Dialogue: 0,0:04:30.70,0:04:31.87,Default,,0,0,0,,This is Min.
Dialogue: 0,0:04:34.79,0:04:36.50,Default,,0,0,0,,My name is Saya. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:04:37.04,0:04:39.46,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:04:40.71,0:04:42.76,Default,,0,0,0,,Сіз картаны қарадыңыз ба? (Saya) Yeah.
Dialogue: 0,0:04:42.84,0:04:45.68,Default,,0,0,0,,Жапон таңбаларын іздеу қиын болды.
Dialogue: 0,0:04:45.76,0:04:46.59,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:46.97,0:04:51.89,Default,,0,0,0,,Гонконг пен Шанхайдан келген балалар бар, бірақ жапондар сирек.
Dialogue: 0,0:04:51.97,0:04:54.56,Default,,0,0,0,,Сіздің әкеңіз де Ханойға тағайындалды ма?
Dialogue: 0,0:04:55.81,0:04:59.02,Default,,0,0,0,,Өткенде әкем қайтыс болды...
Dialogue: 0,0:04:59.31,0:05:01.98,Default,,0,0,0,,А... Түсіндім, кешіріңіз.
Dialogue: 0,0:05:02.07,0:05:03.03,Default,,0,0,0,,Сонда анаңмен бе?
Dialogue: 0,0:05:04.15,0:05:05.49,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:05:06.49,0:05:09.70,Default,,0,0,0,,Кешіріңіз... Кешіріңіз, түсіндім.
Dialogue: 0,0:05:10.74,0:05:14.96,Default,,0,0,0,,Мұнда әртүрлі жағдайларға байланысты қабылданған балалар көп.
Dialogue: 0,0:05:15.75,0:05:20.92,Default,,0,0,0,,Қараңызшы, ауқатты отбасының балалары көп, сондықтан отбасы құрылымы қиын...
Dialogue: 0,0:05:21.17,0:05:23.09,Default,,0,0,0,,Біз мүлікті іздеп жатырмыз.
Dialogue: 0,0:05:23.17,0:05:26.01,Default,,0,0,0,,Ағайынды ма, жоқ па білмеймін, ренжітті.
Dialogue: 0,0:05:26.09,0:05:29.76,Default,,0,0,0,,Оның үстіне, мүлікті басқаратын адам сараң балауса...
Dialogue: 0,0:05:34.14,0:05:36.27,Default,,0,0,0,,Минмен бір бөлмені бөлісу қиын.
Dialogue: 0,0:05:36.35,0:05:38.23,Default,,0,0,0,,Маған еркін сөйлесуге рұқсат етіңіз.
Dialogue: 0,0:05:38.35,0:05:39.90,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:40.11,0:05:42.15,Default,,0,0,0,,Эй, сен Жапонияның қай жеріненсің?
Dialogue: 0,0:05:42.52,0:05:43.36,Default,,0,0,0,,Okinawa
Dialogue: 0,0:05:43.44,0:05:46.82,Default,,0,0,0,,Мен жапон тілін оқығандықтан мұхит бар.
Dialogue: 0,0:05:46.90,0:05:48.16,Default,,0,0,0,,Liar! сүйкімді!
Dialogue: 0,0:05:48.41,0:05:49.82,Default,,0,0,0,,Оны қалай аштыңыз?
Dialogue: 0,0:05:49.91,0:05:51.16,Default,,0,0,0,,Өткен демалыс күндері Ханойда
Dialogue: 0,0:05:51.24,0:05:52.41,Default,,0,0,0,,Doesn't it hurt? (Студент қыз) Иә.
Dialogue: 0,0:05:52.49,0:05:54.33,Default,,0,0,0,,Шынымен бе? (Оқушы қыз) Оны қалай естідің?
Dialogue: 0,0:05:54.41,0:05:55.58,Default,,0,0,0,,Ережеге қайшы емес пе?
Dialogue: 0,0:05:56.00,0:05:58.08,Default,,0,0,0,,Мені тапсаң, рефлексия бөлмесіне бар.
Dialogue: 0,0:05:58.58,0:06:00.00,Default,,0,0,0,,Не, сен маған айтайын деп тұрсың ба?
Dialogue: 0,0:06:00.42,0:06:02.84,Default,,0,0,0,,Қалай ойлайсың, мен соншалықты өрескел нәрсе істеймін бе?
Dialogue: 0,0:06:02.92,0:06:04.50,Default,,0,0,0,,(Starting bell)
Dialogue: 0,0:06:09.09,0:06:10.84,Default,,0,0,0,,Бұрынғысы - Аннамари.
Dialogue: 0,0:06:10.93,0:06:12.55,Default,,0,0,0,,It's Ms. Lee's favorite.
Dialogue: 0,0:06:12.64,0:06:14.93,Default,,0,0,0,,Жақында сізге хабар беріледі, сондықтан сақ болыңыз.
Dialogue: 0,0:06:26.40,0:06:30.53,Default,,0,0,0,,Иә, біз жоспарлағандай лицейге еніп үлгердік.
Dialogue: 0,0:06:30.99,0:06:35.24,Default,,0,0,0,,Лицейде болған өткен оқиғалар мен қанаттар арасындағы байланысты зерттеуге рұқсат етіңіздер.
Dialogue: 0,0:06:37.37,0:06:38.41,Default,,0,0,0,,Are you a diva?
Dialogue: 0,0:06:39.12,0:06:41.92,Default,,0,0,0,,Бұл өте мүмкін
Dialogue: 0,0:06:42.58,0:06:44.71,Default,,0,0,0,,Бұл жолы күшейткіштерді дайындаңыз
Dialogue: 0,0:06:45.09,0:06:45.92,Default,,0,0,0,,Иә
Dialogue: 0,0:06:46.76,0:06:49.67,Default,,0,0,0,,This follows the line of delta 67.
Dialogue: 0,0:06:50.68,0:06:51.89,Default,,0,0,0,,Иә (операция дыбысы)
Dialogue: 0,0:06:57.02,0:06:58.31,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:06:59.23,0:07:00.14,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:07:00.23,0:07:01.14,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:07:01.98,0:07:02.81,Default,,0,0,0,,Әлі ештеңе жоқ
Dialogue: 0,0:07:03.94,0:07:08.99,Default,,0,0,0,,Льюис дәл қазір тергеуде, бірақ Лиздің айналасында қанаттар болуы ықтимал.
Dialogue: 0,0:07:09.07,0:07:09.99,Default,,0,0,0,,Сақ бол.
Dialogue: 0,0:07:10.24,0:07:11.11,Default,,0,0,0,,Иә
Dialogue: 0,0:07:11.20,0:07:12.24,Default,,0,0,0,,Оны тапқан бойда өлтіріңіз.
Dialogue: 0,0:07:12.32,0:07:13.62,Default,,0,0,0,,You there
Dialogue: 0,0:07:14.24,0:07:16.49,Default,,0,0,0,,Мектеп ішінде телефон соғуға ережемен тыйым салынады.
Dialogue: 0,0:07:16.58,0:07:18.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:18.70,0:07:22.58,Default,,0,0,0,,Мектепке ұялы телефон әкелінсе, дереу тәркіленеді.
Dialogue: 0,0:07:22.83,0:07:25.46,Default,,0,0,0,,Бірақ осы жолы ғана кешіруге рұқсат етіңіз.
Dialogue: 0,0:07:25.84,0:07:28.55,Default,,0,0,0,,Мен маусымнан тыс ауыспалы студентпін.
Dialogue: 0,0:07:33.43,0:07:34.51,Default,,0,0,0,,I was here
Dialogue: 0,0:07:35.01,0:07:36.51,Default,,0,0,0,,Өйткені ол мүлде қайтып келмейді.
Dialogue: 0,0:07:36.60,0:07:39.18,Default,,0,0,0,,Мен мені елес ұрлап кетті деп ойладым.
Dialogue: 0,0:07:39.27,0:07:40.10,Default,,0,0,0,,Фантом?
Dialogue: 0,0:07:40.35,0:07:44.06,Default,,0,0,0,,Фантом Сая сияқты қара шашты ұнатады...
Dialogue: 0,0:07:47.40,0:07:50.57,Default,,0,0,0,,Бұл лицей әлі монастырь болған кезде
Dialogue: 0,0:07:50.65,0:07:53.53,Default,,0,0,0,,Роза деген қара шашты монах әйел болған.
Dialogue: 0,0:07:53.95,0:07:56.45,Default,,0,0,0,,Раушан раушан гүлдеріне қамқорлық жасады.
Dialogue: 0,0:07:56.53,0:07:59.45,Default,,0,0,0,,Бастапқыда бұл жер Фантом зұлым рухының қарғысына ұшырады.
Dialogue: 0,0:07:59.54,0:08:02.04,Default,,0,0,0,,Бұл раушан гүл өсетін жер емес еді.
Dialogue: 0,0:08:02.58,0:08:06.54,Default,,0,0,0,,Десе де, Роуз оны күні-түні махаббатпен сусындатты.
Dialogue: 0,0:08:06.63,0:08:08.55,Default,,0,0,0,,Раушан гүлдеріңізге күтім жасауды жалғастырыңыз
Dialogue: 0,0:08:08.63,0:08:11.51,Default,,0,0,0,,Олар әдемі гүлдерді гүлдей алды.
Dialogue: 0,0:08:12.47,0:08:16.97,Default,,0,0,0,,Фантом раушан гүлінің сұлулығы мен раушанның сыртқы көрінісіне тәнті болды.
Dialogue: 0,0:08:17.05,0:08:19.68,Default,,0,0,0,,Сіз кенет ғашық болып қалдыңыз.
Dialogue: 0,0:08:19.81,0:08:21.98,Default,,0,0,0,,Ал жарты айдың бір түні
Dialogue: 0,0:08:22.06,0:08:25.90,Default,,0,0,0,,Ол Роуздың алдына шығып, оған ұсыныс жасады.
Dialogue: 0,0:08:26.19,0:08:27.40,Default,,0,0,0,,Бірақ Роуз
Dialogue: 0,0:08:27.48,0:08:31.90,Default,,0,0,0,,«Маған бір көк раушан гүлін бер, мен саған үйленемін».
Dialogue: 0,0:08:31.99,0:08:33.40,Default,,0,0,0,,Мен жауап бердім...
Dialogue: 0,0:08:34.45,0:08:38.20,Default,,0,0,0,,Фантом көк раушан гүлдерін іздеп бүкіл әлемді шарлады, бірақ
Dialogue: 0,0:08:38.28,0:08:40.91,Default,,0,0,0,,Оны таба алмадым
Dialogue: 0,0:08:41.29,0:08:45.71,Default,,0,0,0,,Ал мен көк раушан гүлін іздеп жүргенімде көп жылдар өтті.
Dialogue: 0,0:08:45.79,0:08:49.09,Default,,0,0,0,,Ақыры Роуз да үйіне оралмаған адамға айналды.
Dialogue: 0,0:08:50.42,0:08:52.76,Default,,0,0,0,,Қайғылы зұлым рух Фантом
Dialogue: 0,0:08:52.84,0:08:56.26,Default,,0,0,0,,Розаның өлімі мені бірінші рет жылатты.
Dialogue: 0,0:08:56.34,0:08:59.51,Default,,0,0,0,,Фантомның көз жасы қурап қалған жерді ылғалдандырады.
Dialogue: 0,0:08:59.60,0:09:02.39,Default,,0,0,0,,Бай өлкеге ​​айналдырдым.
Dialogue: 0,0:09:02.89,0:09:05.56,Default,,0,0,0,,Ал соңғы тамшы түскенде
Dialogue: 0,0:09:05.64,0:09:08.69,Default,,0,0,0,,Сол жерден көк раушан гүлдей бастады.
Dialogue: 0,0:09:09.02,0:09:11.86,Default,,0,0,0,,Фантом көк раушан гүлін жұлып алды
Dialogue: 0,0:09:11.94,0:09:13.94,Default,,0,0,0,,Оны Роуздың бейітіне ұсын.
Dialogue: 0,0:09:14.03,0:09:17.11,Default,,0,0,0,,Ол бір жерде жоғалып кетті.
Dialogue: 0,0:09:17.70,0:09:21.79,Default,,0,0,0,,Сонымен, лицейге Розаға қатты ұқсайтын қара шашты қыз келді.
Dialogue: 0,0:09:21.87,0:09:24.04,Default,,0,0,0,,Фантом қайтадан оралады
Dialogue: 0,0:09:24.12,0:09:27.54,Default,,0,0,0,,Мен саған көк раушан гүлін ұсынамын, сені бір жерге апарамын.
Dialogue: 0,0:09:27.62,0:09:29.00,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:09:30.79,0:09:32.84,Default,,0,0,0,,Мына жерде қоңырау мұнарасы бар, солай ма?
Dialogue: 0,0:09:33.55,0:09:37.34,Default,,0,0,0,,Қазірдің өзінде жарты айдың түнінде раушан гүлдер гүлдеген кезде, Фантом
Dialogue: 0,0:09:37.43,0:09:39.80,Default,,0,0,0,,Ол сол мұнарада пайда болады.
Dialogue: 0,0:09:40.89,0:09:42.14,Default,,0,0,0,,Мына жерде?
Dialogue: 0,0:09:42.22,0:09:43.06,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:09:43.68,0:09:47.06,Default,,0,0,0,,Менің ойымша, ол Фантом.
Dialogue: 0,0:09:49.48,0:09:51.69,Default,,0,0,0,,Дұрыс па? Бұл шынымен керемет, солай емес пе?
Dialogue: 0,0:09:51.77,0:09:53.53,Default,,0,0,0,,Мен жақында жалданған бағбанмын.
Dialogue: 0,0:09:53.82,0:09:57.49,Default,,0,0,0,,Ол кісі келгеннен бері барлығына қиын болды.
Dialogue: 0,0:09:58.61,0:09:59.45,Default,,0,0,0,,Кя~!
Dialogue: 0,0:10:00.20,0:10:02.58,Default,,0,0,0,,Қазірдің өзінде! егер ол елес болса
Dialogue: 0,0:10:02.66,0:10:04.95,Default,,0,0,0,,Қалағанымша мәңгілік махаббатқа ант етемін
Dialogue: 0,0:10:05.54,0:10:06.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:07.87,0:10:10.38,Default,,0,0,0,,Қазірдің өзінде! Сіз дұрыс тыңдайсыз ба?
Dialogue: 0,0:10:10.46,0:10:11.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:11.67,0:10:12.67,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:13.17,0:10:16.67,Default,,0,0,0,,Бірақ мен олай ойламаймын.
Dialogue: 0,0:10:16.88,0:10:17.84,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:17.92,0:10:21.51,Default,,0,0,0,,Оның раушан гүлін ұстаған бейнесі сондай тамаша.
Dialogue: 0,0:10:22.43,0:10:25.06,Default,,0,0,0,,Эй, сен оны қиып алмайсың.
Dialogue: 0,0:10:26.39,0:10:28.18,Default,,0,0,0,,А... тіпті солай ма?
Dialogue: 0,0:10:28.27,0:10:29.60,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:10:29.69,0:10:32.19,Default,,0,0,0,,Салқын болғанша кез келген нәрсеге рұқсат етіледі.
Dialogue: 0,0:10:32.27,0:10:35.32,Default,,0,0,0,,Фантом-сама, мені ұрлап кет!
Dialogue: 0,0:10:36.69,0:10:40.24,Default,,0,0,0,,Бірақ «Фантом» ескі әңгіме, солай емес пе?
Dialogue: 0,0:10:40.86,0:10:42.03,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:10:42.12,0:10:44.45,Default,,0,0,0,,Мен мұны осы жердегі түлектен естідім.
Dialogue: 0,0:10:44.99,0:10:47.75,Default,,0,0,0,,Маған 10 жыл бұрын көк раушан гүлі жіберілген.
Dialogue: 0,0:10:47.83,0:10:50.42,Default,,0,0,0,,Бір бала жоғалып кетті.
Dialogue: 0,0:10:51.25,0:10:52.79,Default,,0,0,0,,Көк раушан гүлі?
Dialogue: 0,0:11:07.21,0:11:08.71,Default,,0,0,0,,Тамаша тәбет.
Dialogue: 0,0:11:09.21,0:11:11.92,Default,,0,0,0,,Ах... Мен әдетте осы мөлшерден екі еседей жеймін.
Dialogue: 0,0:11:12.00,0:11:13.71,Default,,0,0,0,,Иә? Сіз салмақ қосып жатқан жоқсыз ба?
Dialogue: 0,0:11:13.80,0:11:16.55,Default,,0,0,0,,Мен диета ұстасам да
Dialogue: 0,0:11:18.22,0:11:19.88,Default,,0,0,0,,Не болды? (Сая) Ухх.
Dialogue: 0,0:11:20.84,0:11:26.47,Default,,0,0,0,,Бұрын Окинавада осыған ұқсас бірдеңе айтқан досымның болғаны есіме түсті.
Dialogue: 0,0:11:28.52,0:11:31.10,Default,,0,0,0,,Эй, жапон мектептері қандай?
Dialogue: 0,0:11:32.23,0:11:34.15,Default,,0,0,0,,Бұл кәдімгі орта мектеп.
Dialogue: 0,0:11:34.23,0:11:35.27,Default,,0,0,0,,Жатақхана өмірі?
Dialogue: 0,0:11:35.36,0:11:37.49,Default,,0,0,0,,Жоқ, мен үйден келе жатыр едім.
Dialogue: 0,0:11:38.19,0:11:40.20,Default,,0,0,0,,Мен әрқашан кешігіп қалатындай сезінемін.
Dialogue: 0,0:11:40.28,0:11:42.82,Default,,0,0,0,,Маған Кайдың велосипедін айдауға рұқсат етіңіз...
Dialogue: 0,0:11:42.91,0:11:43.74,Default,,0,0,0,,Кай деген не?
Dialogue: 0,0:11:43.99,0:11:45.16,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:11:45.28,0:11:46.62,Default,,0,0,0,,Менің ағам бар
Dialogue: 0,0:11:46.70,0:11:48.96,Default,,0,0,0,,Иә, менің де бір інім бар.
Dialogue: 0,0:11:49.58,0:11:52.33,Default,,0,0,0,,Екеуің Вьетнамға бірге келдіңдер ме?
Dialogue: 0,0:11:52.42,0:11:53.42,Default,,0,0,0,,Иә
Dialogue: 0,0:11:54.25,0:11:55.84,Default,,0,0,0,,Мүмкін бұл мектеп?
Dialogue: 0,0:11:56.71,0:11:57.71,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:58.05,0:12:00.17,Default,,0,0,0,,Олай болса өзіңізді таныстырыңыз! аға
Dialogue: 0,0:12:00.26,0:12:01.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:01.63,0:12:03.89,Default,,0,0,0,,А, жоқ, бұл...
Dialogue: 0,0:12:04.18,0:12:06.51,Default,,0,0,0,,Қаласаңыз, менікі де жеуге болады.
Dialogue: 0,0:12:07.06,0:12:09.27,Default,,0,0,0,,А... рахмет, жарай ма?
Dialogue: 0,0:12:09.35,0:12:12.44,Default,,0,0,0,,Біз бөлмелеспіз, сондықтан ұялмаңыз.
Dialogue: 0,0:12:14.11,0:12:18.65,Default,,0,0,0,,Менің ойымша, Сайоның ағасы екеуміз жақсы араласамыз.
Dialogue: 0,0:12:18.73,0:12:20.70,Default,,0,0,0,,Ой, оны құлатып тастады
Dialogue: 0,0:12:20.78,0:12:22.20,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:27.37,0:12:29.83,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:31.71,0:12:32.54,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:12:32.62,0:12:35.46,Default,,0,0,0,,Мен бұл порт туралы басқа ештеңе білмеймін.
Dialogue: 0,0:12:36.34,0:12:39.51,Default,,0,0,0,,Әзірше осы жердегі ең үлкен қалаға барайық.
Dialogue: 0,0:12:39.59,0:12:40.42,Default,,0,0,0,,Қала дегеніміз не?
Dialogue: 0,0:12:41.47,0:12:43.38,Default,,0,0,0,,Вьетнамның астанасы қай жерде?
Dialogue: 0,0:12:43.63,0:12:44.47,Default,,0,0,0,,Ханой
Dialogue: 0,0:12:44.55,0:12:45.89,Default,,0,0,0,,Олай болса сонда барайық.
Dialogue: 0,0:12:46.51,0:12:48.14,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:12:48.51,0:12:49.77,Default,,0,0,0,,Саяны іздеңіз
Dialogue: 0,0:12:50.89,0:12:51.98,Default,,0,0,0,,Өзіңізді жалқау сезінгенде
Dialogue: 0,0:12:52.06,0:12:55.02,Default,,0,0,0,,Сая одан сайын алыстап бара жатқандай сезінемін.
Dialogue: 0,0:12:55.56,0:12:58.48,Default,,0,0,0,,Сондықтан біз қолымыздан келгенді істеуіміз керек.
Dialogue: 0,0:13:00.53,0:13:02.99,Default,,0,0,0,,Бірақ алдымен тамақтанып алайық.
Dialogue: 0,0:13:03.49,0:13:06.07,Default,,0,0,0,,Мен сол жерден дәмді көрінетін тамақ дүңгіршегін таптым.
Dialogue: 0,0:13:06.16,0:13:07.41,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:10.45,0:13:13.79,Default,,0,0,0,,Оқушылар ешбір қиындықсыз жақсы оқиды.
Dialogue: 0,0:13:13.87,0:13:14.79,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:15.29,0:13:17.84,Default,,0,0,0,,Құжаттар сізге берілді деп ойлаймын.
Dialogue: 0,0:13:17.92,0:13:22.63,Default,,0,0,0,,Біз алдағы іс-шара ретінде Ханойға оқу сапарын жоспарлап отырмыз.
Dialogue: 0,0:13:23.42,0:13:27.39,Default,,0,0,0,,Соғыс мұражайына экскурсияға арналған мазмұн
Dialogue: 0,0:13:27.47,0:13:30.01,Default,,0,0,0,,Өткенді біліп, болашақты ойлау
Dialogue: 0,0:13:30.60,0:13:32.35,Default,,0,0,0,,Лицейдің білім беру философиясы негізінде...
Dialogue: 0,0:13:32.43,0:13:33.39,Default,,0,0,0,,Ли ханым
Dialogue: 0,0:13:33.68,0:13:36.19,Default,,0,0,0,,Толық ақпаратты жазбаша түрде беруге болады.
Dialogue: 0,0:13:37.02,0:13:39.11,Default,,0,0,0,,Әрі қарай, ауыспалы студенттерге тоқталайық...
Dialogue: 0,0:13:39.19,0:13:41.69,Default,,0,0,0,,Мұны кейінірек қарастырамыз.
Dialogue: 0,0:13:42.07,0:13:43.36,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:43.95,0:13:46.28,Default,,0,0,0,,Сіз бұл жерде өзіңізді көрсете аласыз.
Dialogue: 0,0:13:49.37,0:13:53.08,Default,,0,0,0,,Жоқ, мен сенбеймін! (Студент қыз) Өтірік айтасың~
Dialogue: 0,0:13:53.16,0:13:54.71,Default,,0,0,0,,Төраға мырза!
Dialogue: 0,0:13:55.50,0:13:57.04,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:57.25,0:13:58.67,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:11.93,0:14:12.77,Default,,0,0,0,,Ууух!
Dialogue: 0,0:14:13.56,0:14:14.73,Default,,0,0,0,,Бұл бойтұмар
Dialogue: 0,0:14:15.23,0:14:16.56,Default,,0,0,0,,Лицей іші
Dialogue: 0,0:14:16.64,0:14:18.90,Default,,0,0,0,,Мен қылыш көтере алмаймын.
Dialogue: 0,0:14:19.69,0:14:20.90,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:21.07,0:14:22.11,Default,,0,0,0,,Айтпақшы, Қажы
Dialogue: 0,0:14:22.19,0:14:24.90,Default,,0,0,0,,Бұл жерде көк раушан гүлдердің қай жерде гүлдейтінін білмейсің бе?
Dialogue: 0,0:14:25.28,0:14:28.36,Default,,0,0,0,,Көк раушан гүлдері табиғатта жоқ
Dialogue: 0,0:14:28.99,0:14:31.53,Default,,0,0,0,,Фантом көк раушан гүлін ұсынады.
Dialogue: 0,0:14:32.16,0:14:33.24,Default,,0,0,0,,Фантом?
Dialogue: 0,0:14:33.37,0:14:36.21,Default,,0,0,0,,Осы мектептің мұнарасында пайда болған құбыжық
Dialogue: 0,0:14:37.08,0:14:39.21,Default,,0,0,0,,Менің ойымша, бұл қанатты адам шығар.
Dialogue: 0,0:14:39.83,0:14:41.63,Default,,0,0,0,,Сабақтан кейін мұнараға шығып, зерттеңіз.
Dialogue: 0,0:14:41.71,0:14:44.34,Default,,0,0,0,,Олай болса мен сабаққа барамын.
Dialogue: 0,0:14:46.80,0:14:47.72,Default,,0,0,0,,Қажы!
Dialogue: 0,0:14:48.30,0:14:50.09,Default,,0,0,0,,Мына көйлек саған жарасады!
Dialogue: 0,0:14:53.81,0:14:54.72,Default,,0,0,0,,Хмм…
Dialogue: 0,0:14:55.81,0:14:57.98,Default,,0,0,0,,Сонда сен бағбанға бардың ба, Фантом?
Dialogue: 0,0:14:58.10,0:14:58.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:59.23,0:15:01.94,Default,,0,0,0,,Маған жалғыз серуендейтініңді айт
Dialogue: 0,0:15:02.36,0:15:04.32,Default,,0,0,0,,Аннамари ашулы.
Dialogue: 0,0:15:04.78,0:15:07.28,Default,,0,0,0,,Ол да Фантомды көздеп отыр.
Dialogue: 0,0:15:07.90,0:15:09.61,Default,,0,0,0,,Сонымен, оның кім екенін естідің бе?
Dialogue: 0,0:15:09.70,0:15:12.78,Default,,0,0,0,,Жоқ, мен жай ғана көк раушан гүлдері туралы айттым.
Dialogue: 0,0:15:13.45,0:15:17.20,Default,,0,0,0,,Оның айтуынша, көк раушан гүлі жоқ.
Dialogue: 0,0:15:17.29,0:15:18.12,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:15:18.21,0:15:20.75,Default,,0,0,0,,Бірақ сіз қазір осындай нәрсені жасай алатын сияқтысыз.
Dialogue: 0,0:15:21.29,0:15:22.13,Default,,0,0,0,,Фармацевтикалық компаниялар
Dialogue: 0,0:15:22.21,0:15:25.46,Default,,0,0,0,,Мен естідім, олар осындай нәрсе жасайды.
Dialogue: 0,0:15:26.42,0:15:30.26,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:15:41.94,0:15:43.44,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:43.86,0:15:46.19,Default,,0,0,0,,Студенттерге кіруге рұқсат етілмейді.
Dialogue: 0,0:15:47.03,0:15:48.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:52.91,0:15:54.78,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:15:59.29,0:16:00.37,Default,,0,0,0,,Оны өшіріңіз.
Dialogue: 0,0:16:03.46,0:16:04.34,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:16:04.42,0:16:05.63,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:16:14.72,0:16:15.55,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:16.10,0:16:16.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:19.27,0:16:21.23,Default,,0,0,0,,Әй, тағы біраз сөйлескің келе ме?
Dialogue: 0,0:16:21.69,0:16:24.52,Default,,0,0,0,,Мен ұзақ уақыт жалғыз болдым, сондықтан көңілім көтерілді ...
Dialogue: 0,0:16:25.77,0:16:27.48,Default,,0,0,0,,Ал, сәл ғана.
Dialogue: 0,0:16:28.11,0:16:29.57,Default,,0,0,0,,Сая сені сүйді ме?
Dialogue: 0,0:16:32.82,0:16:34.16,Default,,0,0,0,,Жоқ... жоқ.
Dialogue: 0,0:16:38.33,0:16:39.16,Default,,0,0,0,,Бар
Dialogue: 0,0:16:39.70,0:16:43.29,Default,,0,0,0,,А... жоқ, бұл сүйіспеншілік емес деп ойлаймын.
Dialogue: 0,0:16:43.92,0:16:45.21,Default,,0,0,0,,Жігітіңіз ше?
Dialogue: 0,0:16:45.29,0:16:46.13,Default,,0,0,0,,Онда жоқ!
Dialogue: 0,0:16:46.75,0:16:47.84,Default,,0,0,0,,Жақсы
Dialogue: 0,0:16:47.92,0:16:52.09,Default,,0,0,0,,Бұл тек мен және Аннамари сабақта ешқашан сүйіспегенбіз.
Dialogue: 0,0:16:52.34,0:16:54.05,Default,,0,0,0,,Демек, бұл түсінбеушілік!
Dialogue: 0,0:16:54.14,0:16:57.10,Default,,0,0,0,,Сүйісу кездейсоқ оқиға сияқты болды...
Dialogue: 0,0:16:57.18,0:17:00.10,Default,,0,0,0,,Хм, одан да көп, қараңызшы! Gardener Phantom туралы не деуге болады?
Dialogue: 0,0:17:00.47,0:17:02.85,Default,,0,0,0,,Жоқ! Жоқ, жоқ! Мүлдем жоқ!
Dialogue: 0,0:17:02.94,0:17:04.56,Default,,0,0,0,,Деңгей тым жоғары
Dialogue: 0,0:17:05.10,0:17:07.06,Default,,0,0,0,,Аа~ Жоқ, жоқ, жоқ!
Dialogue: 0,0:17:07.69,0:17:10.23,Default,,0,0,0,,Шыны керек, мен тезірек үйленгім келеді!
Dialogue: 0,0:17:10.32,0:17:13.61,Default,,0,0,0,,Бірақ мен мұны әкем сияқты үш рет жасағым келмейді.
Dialogue: 0,0:17:13.70,0:17:17.24,Default,,0,0,0,,Маған үш бала мен жігіт керек.
Dialogue: 0,0:17:17.32,0:17:19.45,Default,,0,0,0,,Сонда...
Dialogue: 0,0:17:20.41,0:17:23.71,Default,,0,0,0,,Тұрмысқа шыға алмасам не істеуім керек?
Dialogue: 0,0:17:23.96,0:17:25.21,Default,,0,0,0,,Сая не істейді?
Dialogue: 0,0:17:26.46,0:17:27.96,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:30.05,0:17:34.18,Default,,0,0,0,,Мен қазір қолымнан келгенін істеп жатырмын
Dialogue: 0,0:17:38.22,0:17:39.26,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:45.10,0:17:47.86,Default,,0,0,0,,Эй Сая (Сая) Эй?
Dialogue: 0,0:17:48.48,0:17:51.15,Default,,0,0,0,,Мәңгілік дос болайық
Dialogue: 0,0:17:52.44,0:17:53.53,Default,,0,0,0,,Иә
Dialogue: 0,0:18:01.49,0:18:02.33,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:18:11.96,0:18:13.01,Default,,0,0,0,,Сая...
Dialogue: 0,0:18:14.84,0:18:17.64,Default,,0,0,0,,Осыншама жесең, семіресің.
Dialogue: 0,0:18:20.93,0:18:24.10,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:19:03.97,0:19:04.81,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:20:05.28,0:20:06.74,Default,,0,0,0,,(шу)
Dialogue: 0,0:20:09.83,0:20:10.66,Default,,0,0,0,,Who?
Dialogue: 0,0:20:13.29,0:20:14.13,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:22.55,0:20:23.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:23.76,0:20:25.22,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:20:50.25,0:20:51.08,Default,,0,0,0,,Хироман
Dialogue: 0,0:21:02.80,0:21:03.68,Default,,0,0,0,,Қажы!
Dialogue: 0,0:21:04.39,0:21:05.22,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:06.10,0:21:06.97,Default,,0,0,0,,Дио…
Dialogue: 0,0:21:27.24,0:21:29.62,Default,,0,0,0,,Хэхе... Хахахаха!
Dialogue: 0,0:21:32.45,0:21:35.04,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:21:40.84,0:21:42.17,Default,,0,0,0,,Оқ жаудырыңдар! Бүйіріне нысана ал!
Dialogue: 0,0:21:56.40,0:22:02.40,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:19.31,0:23:25.32,Default,,0,0,0,,~♪
Dialogue: 0,0:23:30.03,0:23:33.53,Default,,0,0,0,,Мен және Кай-ни-чан Вьетнамда Сайо-ничанды іздеп жатырмыз
Dialogue: 0,0:23:33.62,0:23:34.99,Default,,0,0,0,,Мен қайда қарауым керек?
Dialogue: 0,0:23:35.37,0:23:38.12,Default,,0,0,0,,Мен Сайо-ни-чанды шынымен таба аламын ба?
Dialogue: 0,0:23:38.50,0:23:40.96,Default,,0,0,0,,Мен Окинаваға қайтқым келеді
Dialogue: 0,0:23:41.46,0:23:43.63,Default,,0,0,0,,Біздің алдымызда пайда болған нәрсе болды
Dialogue: 0,0:23:43.71,0:23:47.05,Default,,0,0,0,,Балдаққа ілінген Муи деген қыз еді.
Dialogue: 0,0:23:47.67,0:23:49.55,Default,,0,0,0,,Келесі жолы «Blood Plus»
Dialogue: 0,0:23:49.63,0:23:51.14,Default,,0,0,0,,«Әр кемпірқосақ»
Dialogue: 0,0:23:52.14,0:23:55.81,Default,,0,0,0,,Кешіріңіз, Муи, мен ештеңе білмедім.
Dialogue: 0,0:23:57.31,0:24:03.31,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory