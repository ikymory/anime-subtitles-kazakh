Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.28,0:00:15.58,Default,,0,0,0,,Уау! Менің тынысым ақ!
Dialogue: 0,0:00:15.66,0:00:17.75,Default,,0,0,0,,Қараңдар! Қар жауды! Қар жауды!
Dialogue: 0,0:00:18.29,0:00:21.96,Default,,0,0,0,,Ендеше, бұл суық болса, қар жауатын шығар.
Dialogue: 0,0:00:29.13,0:00:31.47,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:00:47.86,0:00:49.90,Default,,0,0,0,,Ресейге қош келдіңіз
Dialogue: 0,0:00:57.91,0:00:58.87,Default,,0,0,0,,Бұл Дэвид.
Dialogue: 0,0:01:00.04,0:01:02.38,Default,,0,0,0,,Элизабета Мен Лизамен жақсымын.
Dialogue: 0,0:01:03.13,0:01:05.17,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:01:07.09,0:01:08.09,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:01:08.67,0:01:10.22,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:01:12.30,0:01:13.93,Default,,0,0,0,,А... Нуа!
Dialogue: 0,0:01:14.80,0:01:16.81,Default,,0,0,0,,А-а-а~?
Dialogue: 0,0:01:17.56,0:01:18.72,Default,,0,0,0,,Кай-нии-чан
Dialogue: 0,0:01:18.81,0:01:20.64,Default,,0,0,0,,Бұл жай ғана сәлемдесу, иә?
Dialogue: 0,0:01:21.19,0:01:22.10,Default,,0,0,0,,Сәлем
Dialogue: 0,0:01:23.19,0:01:24.56,Default,,0,0,0,,Сіз Саясыз ба?
Dialogue: 0,0:01:25.23,0:01:26.07,Default,,0,0,0,,Иә
Dialogue: 0,0:01:29.61,0:01:30.95,Default,,0,0,0,,Не?
Dialogue: 0,0:01:31.99,0:01:33.24,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:01:44.50,0:01:46.17,Default,,0,0,0,,Егер сіз қатты толқысаңыз
Dialogue: 0,0:01:46.25,0:01:48.34,Default,,0,0,0,,Мен оны Вьетнамдағыдай қалдырамын.
Dialogue: 0,0:01:48.59,0:01:49.55,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:01:49.67,0:01:51.97,Default,,0,0,0,,Нахаха…
Dialogue: 0,0:01:52.05,0:01:52.93,Default,,0,0,0,,Tsk
Dialogue: 0,0:01:54.30,0:01:55.51,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:01:56.30,0:01:59.10,Default,,0,0,0,,Бұл ауа райында біз әуеде ұша алмаймыз.
Dialogue: 0,0:01:59.81,0:02:02.06,Default,,0,0,0,,Екатеринбургке қалай жетуге болады?
Dialogue: 0,0:02:03.10,0:02:04.65,Default,,0,0,0,,Транссібір темір жолы
Dialogue: 0,0:02:05.10,0:02:11.11,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:31.48,0:03:37.49,Default,,0,0,0,,~♪
Dialogue: 0,0:03:47.00,0:03:48.25,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:03:54.46,0:03:58.51,Default,,0,0,0,,Көліктер Ауыр техника Оқ-дәрілер Дәрілер Азық-түлік
Dialogue: 0,0:03:59.22,0:04:01.47,Default,,0,0,0,,Маған хабарласқаныңыздың барлығын жинадым.
Dialogue: 0,0:04:01.97,0:04:02.93,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:04.10,0:04:06.77,Default,,0,0,0,,Екатеринбургке жету үшін 6 күн керек пе?
Dialogue: 0,0:04:06.98,0:04:08.31,Default,,0,0,0,,Транссібір темір жолы
Dialogue: 0,0:04:08.39,0:04:11.94,Default,,0,0,0,,Владивостоктан Мәскеуге жету үшін жеті күн қажет.
Dialogue: 0,0:04:12.11,0:04:16.15,Default,,0,0,0,,Әр екі күнде бір ғана пойыз жүреді, сондықтан оны жіберіп алмау керек.
Dialogue: 0,0:04:16.78,0:04:19.11,Default,,0,0,0,,Рику Сіз көп нәрсені білесіз.
Dialogue: 0,0:04:19.66,0:04:21.45,Default,,0,0,0,,Мен мұны біраз бұрын кітаптан оқығанмын.
Dialogue: 0,0:04:21.53,0:04:23.87,Default,,0,0,0,,Бірақ мен пойызға бірінші рет мініп отырмын.
Dialogue: 0,0:04:23.95,0:04:25.62,Default,,0,0,0,,Мүмкін мен біраз қобалжыған шығармын.
Dialogue: 0,0:04:25.83,0:04:26.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:27.04,0:04:29.67,Default,,0,0,0,,Окинавада мұндай теміржол болмаған.
Dialogue: 0,0:04:29.87,0:04:31.17,Default,,0,0,0,,Қажыға мініп көрдің бе?
Dialogue: 0,0:04:33.92,0:04:36.38,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,0:04:39.97,0:04:42.43,Default,,0,0,0,,Әже, мен сізге көмектесемін!
Dialogue: 0,0:04:42.60,0:04:45.68,Default,,0,0,0,,Аа, мейірімділігіңіз үшін рахмет.
Dialogue: 0,0:04:46.10,0:04:47.48,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:48.81,0:04:49.73,Default,,0,0,0,,(Демін ала-шала)
Dialogue: 0,0:04:51.23,0:04:52.61,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:04:56.61,0:04:58.40,Default,,0,0,0,,Әженің қолы
Dialogue: 0,0:04:58.53,0:05:00.45,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:05:06.91,0:05:08.50,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:05:21.05,0:05:23.51,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:05:24.26,0:05:26.22,Default,,0,0,0,,Іші жылы, солай емес пе?
Dialogue: 0,0:05:26.76,0:05:28.02,Default,,0,0,0,,Уау~
Dialogue: 0,0:05:30.68,0:05:32.27,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:05:32.35,0:05:33.85,Default,,0,0,0,,Бұл бөлменің тапсырмасы қандай?
Dialogue: 0,0:05:33.94,0:05:35.31,Default,,0,0,0,,Ешқандай проблема болмауы керек.
Dialogue: 0,0:05:35.61,0:05:38.32,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл керемет емес пе!
Dialogue: 0,0:05:38.40,0:05:41.32,Default,,0,0,0,,Ол неге Саяның бөлмесінде?
Dialogue: 0,0:05:41.40,0:05:43.36,Default,,0,0,0,,Қажы – Саяның соңынан ерген адам.
Dialogue: 0,0:05:43.61,0:05:45.37,Default,,0,0,0,,Менің ойымша, бұл анық.
Dialogue: 0,0:05:45.53,0:05:47.41,Default,,0,0,0,,Бұл маңызды емес, солай ма?
Dialogue: 0,0:05:47.49,0:05:48.99,Default,,0,0,0,,Түсінуіңізді сұраймыз
Dialogue: 0,0:05:49.12,0:05:51.66,Default,,0,0,0,,Кай Саямен бір бөлмеде болғысы келеді, солай ма?
Dialogue: 0,0:05:52.04,0:05:54.54,Default,,0,0,0,,Не... анау... мынаны айтқым келген.
Dialogue: 0,0:05:55.04,0:05:57.84,Default,,0,0,0,,Немесе сізге Лиза сияқты нәрсе керек пе?
Dialogue: 0,0:05:57.92,0:05:59.46,Default,,0,0,0,,(ДжоДжо) Какёин (Анн) Ааах!
Dialogue: 0,0:05:59.55,0:06:00.46,Default,,0,0,0,,О~ қорқынышты
Dialogue: 0,0:06:02.22,0:06:03.26,Default,,0,0,0,,Қалай болғанда да!
Dialogue: 0,0:06:03.43,0:06:06.01,Default,,0,0,0,,Мен бұл бөлме тапсырмасын қабылдай алмаймын!
Dialogue: 0,0:06:10.81,0:06:13.27,Default,,0,0,0,,Неге кенеттен бөлмені ауыстырдың?
Dialogue: 0,0:06:13.56,0:06:14.52,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:06:24.07,0:06:25.82,Default,,0,0,0,,Мен әлі де келіспеймін.
Dialogue: 0,0:06:26.24,0:06:28.49,Default,,0,0,0,,Шизуку Каваками, Курона Анку, Наширо
Dialogue: 0,0:06:28.74,0:06:31.33,Default,,0,0,0,,Кайдың жігіті, оны мазақ ету қызық
Dialogue: 0,0:06:31.50,0:06:34.12,Default,,0,0,0,,Льюис Шиеленіс жеткіліксіз.
Dialogue: 0,0:06:34.62,0:06:37.63,Default,,0,0,0,,Жарайды, мұндай ауыр сөз айтпа.
Dialogue: 0,0:06:38.00,0:06:40.34,Default,,0,0,0,,Сібірде қанаттылар жоқ емес пе?
Dialogue: 0,0:06:40.59,0:06:44.84,Default,,0,0,0,,1918 жылдан бері бірде-бір оқиға тіркелген жоқ.
Dialogue: 0,0:06:45.01,0:06:48.43,Default,,0,0,0,,Бұл орыс революциясының қызған кезі еді, солай ма?
Dialogue: 0,0:06:48.89,0:06:52.81,Default,,0,0,0,,«Джоэлдің күнделігінде» де Кеңес Одағы кезіндегі жазбалар аз.
Dialogue: 0,0:06:52.98,0:06:54.19,Default,,0,0,0,,Сақтықты төмендетпеңіз
Dialogue: 0,0:06:55.10,0:06:56.19,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:59.82,0:07:03.40,Default,,0,0,0,,(виолончельде орындау)
Dialogue: 0,0:08:08.72,0:08:09.97,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:08:10.84,0:08:12.93,Default,,0,0,0,,Hmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm
Dialogue: 0,0:08:13.31,0:08:16.27,Default,,0,0,0,,Уууу, оны қайдан сатып алдың?
Dialogue: 0,0:08:17.31,0:08:18.60,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:08:24.15,0:08:26.36,Default,,0,0,0,,Бұл екеуі Парижге барады.
Dialogue: 0,0:08:26.44,0:08:29.20,Default,,0,0,0,,Ол менен таныстыруымды өтінді.
Dialogue: 0,0:08:29.95,0:08:33.37,Default,,0,0,0,,Неліктен біздің жолдама төлеміміз тек бір шоколадты батончик?
Dialogue: 0,0:08:33.91,0:08:35.87,Default,,0,0,0,,Жоқ, ондаған
Dialogue: 0,0:08:36.79,0:08:39.46,Default,,0,0,0,,Жарайсың ба? Бірге тамақтану сияқты
Dialogue: 0,0:08:39.58,0:08:40.46,Default,,0,0,0,,Хаа…
Dialogue: 0,0:08:41.46,0:08:42.67,Default,,0,0,0,,(Нисимура) Цубасаның кеудесі өте үлкен, сондықтан ол жүгіргенде әр жаққа секіріп тұрады.
Dialogue: 0,0:08:43.25,0:08:44.34,Default,,0,0,0,,Хё~ Хо~ (2-адам) Жарайды!
Dialogue: 0,0:08:47.51,0:08:48.72,Default,,0,0,0,,Ах~
Dialogue: 0,0:08:49.22,0:08:50.93,Default,,0,0,0,,Марлей әскері емес.
Dialogue: 0,0:08:51.01,0:08:51.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:54.22,0:08:55.06,Default,,0,0,0,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:08:55.60,0:08:56.64,Default,,0,0,0,,Әже!
Dialogue: 0,0:08:56.97,0:08:59.98,Default,,0,0,0,,Сол уақыт үшін рахмет, балам.
Dialogue: 0,0:09:00.06,0:09:02.48,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:09:02.90,0:09:04.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:06.07,0:09:07.07,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:09:07.40,0:09:08.99,Default,,0,0,0,,Қажы, кешіріңіз.
Dialogue: 0,0:09:09.90,0:09:10.86,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:17.16,0:09:20.66,Default,,0,0,0,,Дұрыс, шайды ішіп ал.
Dialogue: 0,0:09:25.04,0:09:26.80,Default,,0,0,0,,Тәтті және дәмді!
Dialogue: 0,0:09:27.30,0:09:28.55,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:09:29.26,0:09:31.43,Default,,0,0,0,,Көп тамақ ішпеу
Dialogue: 0,0:09:32.51,0:09:34.97,Default,,0,0,0,,Аха, әже, сіз не жейсіз?
Dialogue: 0,0:09:35.35,0:09:37.64,Default,,0,0,0,,Бұл маған жеткілікті
Dialogue: 0,0:09:37.72,0:09:40.73,Default,,0,0,0,,Жасы ұлғайған сайын диета жұқа болады.
Dialogue: 0,0:09:40.85,0:09:42.73,Default,,0,0,0,,Хмм, солай ма?
Dialogue: 0,0:09:43.60,0:09:46.48,Default,,0,0,0,,Балалар, сендер қанша жерге барасыңдар?
Dialogue: 0,0:09:46.98,0:09:48.23,Default,,0,0,0,,Екатеринбург
Dialogue: 0,0:09:48.48,0:09:50.19,Default,,0,0,0,,Кемпір қанша жерде?
Dialogue: 0,0:09:50.44,0:09:51.65,Default,,0,0,0,,Мәскеу
Dialogue: 0,0:09:52.03,0:09:55.16,Default,,0,0,0,,Шөберем дүниеге келгенде жүзін көргім келеді.
Dialogue: 0,0:09:55.70,0:09:57.12,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:09:57.41,0:09:59.54,Default,,0,0,0,,Аха рахмет
Dialogue: 0,0:09:59.66,0:10:04.12,Default,,0,0,0,,Мен ұлдарға әрқашан ризамын.
Dialogue: 0,0:10:04.38,0:10:06.09,Default,,0,0,0,,Ойланып көрейікші, иә.
Dialogue: 0,0:10:06.25,0:10:08.17,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:10:11.38,0:10:14.72,Default,,0,0,0,,Ол Вингменді жеңе алатын жалғыз жауынгер...
Dialogue: 0,0:10:15.34,0:10:16.68,Default,,0,0,0,,Олай емес сияқты, солай ма?
Dialogue: 0,0:10:18.31,0:10:20.06,Default,,0,0,0,,«Джоэлдің күнделігін» оқығанша...
Dialogue: 0,0:10:21.31,0:10:23.52,Default,,0,0,0,,Меніңше, мұндай жүзбен күлуге болмайды.
Dialogue: 0,0:10:25.06,0:10:27.48,Default,,0,0,0,,Бірақ бұл маңызды емес.
Dialogue: 0,0:10:28.15,0:10:31.44,Default,,0,0,0,,Саяның Чиротенмен күресуге күші жетсе
Dialogue: 0,0:10:32.15,0:10:34.99,Default,,0,0,0,,Мен тек қалқан ретіндегі миссиямды орындаймын.
Dialogue: 0,0:10:36.16,0:10:37.87,Default,,0,0,0,,Бұл Ауғанстан болды.
Dialogue: 0,0:10:38.49,0:10:44.00,Default,,0,0,0,,1989 жылы шегіну алдында шекара маңында қанатты адам пайда болды.
Dialogue: 0,0:10:44.62,0:10:47.42,Default,,0,0,0,,Мен болған бөлімше жойылды.
Dialogue: 0,0:10:48.13,0:10:50.25,Default,,0,0,0,,Мен бір адамнан басқа
Dialogue: 0,0:10:52.51,0:10:54.63,Default,,0,0,0,,Сондықтан мен мұндамын
Dialogue: 0,0:10:59.01,0:10:59.93,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:11:00.06,0:11:03.02,Default,,0,0,0,,Мен Екатеринбургке ертең кешке жетемін.
Dialogue: 0,0:11:04.35,0:11:05.27,Default,,0,0,0,,Бірінші
Dialogue: 0,0:11:17.04,0:11:20.59,Default,,0,0,0,,(Ағып жатқан судың дыбысы)
Dialogue: 0,0:12:00.96,0:12:02.63,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:12:09.80,0:12:10.97,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:12:14.22,0:12:15.43,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:12:16.23,0:12:17.14,Default,,0,0,0,,Иә
Dialogue: 0,0:12:21.31,0:12:22.15,Default,,0,0,0,,Ум...
Dialogue: 0,0:12:22.23,0:12:23.07,Default,,0,0,0,,Не?
Dialogue: 0,0:12:23.15,0:12:27.65,Default,,0,0,0,,30 жыл бұрын Вьетнамда не болды?
Dialogue: 0,0:12:27.82,0:12:28.66,Default,,0,0,0,,Вьетнам?
Dialogue: 0,0:12:28.99,0:12:30.91,Default,,0,0,0,,Сол жерде бірдеңе болды.
Dialogue: 0,0:12:31.28,0:12:33.87,Default,,0,0,0,,Бірақ бұл шынымен солай ма?
Dialogue: 0,0:12:34.20,0:12:35.75,Default,,0,0,0,,Мен сенімді емеспін.
Dialogue: 0,0:12:36.58,0:12:38.62,Default,,0,0,0,,Қайта-қайта түс көруді ұнатады
Dialogue: 0,0:12:39.46,0:12:41.00,Default,,0,0,0,,Міне, солай сезіледі.
Dialogue: 0,0:12:42.21,0:12:44.46,Default,,0,0,0,,Бұл біртүрлі емес пе?
Dialogue: 0,0:12:44.96,0:12:47.55,Default,,0,0,0,,30 жыл бұрынғы естеліктер болса ше?
Dialogue: 0,0:12:47.72,0:12:51.34,Default,,0,0,0,,Бұл менің әлі тірі екенімді білдіре ме?
Dialogue: 0,0:12:53.97,0:12:56.39,Default,,0,0,0,,Егер бұл рас болса...
Dialogue: 0,0:12:58.73,0:13:02.06,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:13:05.11,0:13:07.53,Default,,0,0,0,,Неліктен мұны білгің келді?
Dialogue: 0,0:13:10.15,0:13:13.62,Default,,0,0,0,,Мен Вьетнамда ән естідім.
Dialogue: 0,0:13:13.70,0:13:14.53,Default,,0,0,0,,Ән?
Dialogue: 0,0:13:15.03,0:13:16.62,Default,,0,0,0,,Сол әнді естігенде
Dialogue: 0,0:13:17.29,0:13:18.79,Default,,0,0,0,,Менің басымда
Dialogue: 0,0:13:18.91,0:13:21.54,Default,,0,0,0,,Мен көрмеген көріністер айналады...
Dialogue: 0,0:13:22.67,0:13:25.04,Default,,0,0,0,,Юлия, маған айтыңызшы.
Dialogue: 0,0:13:25.80,0:13:27.88,Default,,0,0,0,,Юлия біледі, солай ма?
Dialogue: 0,0:13:28.38,0:13:30.97,Default,,0,0,0,,Менің білетінім сенің рекордың.
Dialogue: 0,0:13:31.38,0:13:32.72,Default,,0,0,0,,Бұл естелік емес.
Dialogue: 0,0:13:33.39,0:13:35.47,Default,,0,0,0,,Сондықтан маған оның рас па, жоқ па бәрібір.
Dialogue: 0,0:13:35.56,0:13:37.10,Default,,0,0,0,,Айта алмаймын
Dialogue: 0,0:13:38.18,0:13:40.27,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:13:40.35,0:13:42.73,Default,,0,0,0,,Мен өзімді еске түсіруім керек
Dialogue: 0,0:13:44.15,0:13:46.40,Default,,0,0,0,,Мен мұны істеуім керек
Dialogue: 0,0:13:46.86,0:13:50.61,Default,,0,0,0,,Мен барлығын қорғауым керек...
Dialogue: 0,0:13:53.36,0:13:56.20,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:13:58.41,0:14:02.58,Default,,0,0,0,,(виолончельде орындау)
Dialogue: 0,0:14:11.84,0:14:14.09,Default,,0,0,0,,Сағыныш сезімін тудырады
Dialogue: 0,0:14:15.64,0:14:16.47,Default,,0,0,0,,Қажы?
Dialogue: 0,0:14:17.35,0:14:19.43,Default,,0,0,0,,Түн болды, мен сені тоқтатамын.
Dialogue: 0,0:14:19.72,0:14:20.77,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:14:35.41,0:14:37.53,Default,,0,0,0,,Не? Мен оны ойнай аламын ба?
Dialogue: 0,0:14:40.24,0:14:41.25,Default,,0,0,0,,Демалу
Dialogue: 0,0:14:41.83,0:14:42.71,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:14:42.91,0:14:43.79,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:14:44.08,0:14:45.25,Default,,0,0,0,,Не? бұл сияқты?
Dialogue: 0,0:14:49.05,0:14:50.38,Default,,0,0,0,,Тағы біраз тұрыңыз
Dialogue: 0,0:14:51.51,0:14:53.84,Default,,0,0,0,,(сүрінді виолончель дыбысы)
Dialogue: 0,0:15:02.77,0:15:04.77,Default,,0,0,0,,Маған төсегіңізді пайдалануға рұқсат етілді.
Dialogue: 0,0:15:05.31,0:15:06.60,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:08.02,0:15:09.07,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:15:11.82,0:15:14.95,Default,,0,0,0,,Ух... аа... у...
Dialogue: 0,0:15:15.61,0:15:18.20,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:15:21.79,0:15:23.04,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:15:25.96,0:15:28.96,Default,,0,0,0,,Тұрақты түрде қан құю өте қиын.
Dialogue: 0,0:15:31.13,0:15:32.51,Default,,0,0,0,,Мен үйреніп қалдым
Dialogue: 0,0:15:34.38,0:15:36.09,Default,,0,0,0,,Сен осылай ұрыспақсың, солай ма?
Dialogue: 0,0:15:39.01,0:15:40.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:40.30,0:15:41.89,Default,,0,0,0,,Ах! бұл дауыс
Dialogue: 0,0:15:42.52,0:15:43.35,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:48.77,0:15:49.69,Default,,0,0,0,,Сонымен қатар, сыртта Реммен сөйлескенде,
Dialogue: 0,0:15:57.20,0:15:58.07,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:58.20,0:15:59.32,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:15:59.70,0:16:00.49,Default,,0,0,0,,Қанатшы!
Dialogue: 0,0:16:00.58,0:16:01.45,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:16:01.91,0:16:03.79,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:16:15.42,0:16:16.42,Default,,0,0,0,,Артқа тұрыңыз!
Dialogue: 0,0:16:18.30,0:16:19.43,Default,,0,0,0,,Қажы
Dialogue: 0,0:16:32.69,0:16:34.28,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:36.24,0:16:37.24,Default,,0,0,0,,болуы тиіс
Dialogue: 0,0:16:40.41,0:16:41.37,Default,,0,0,0,,Ол қайдан пайда болды?
Dialogue: 0,0:16:44.16,0:16:45.08,Default,,0,0,0,,Бұл олар!
Dialogue: 0,0:16:50.46,0:16:51.71,Default,,0,0,0,,Басқасы бар ма?
Dialogue: 0,0:16:58.38,0:16:59.63,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:17:11.19,0:17:12.06,Default,,0,0,0,,Ха! а!
Dialogue: 0,0:17:13.40,0:17:14.57,Default,,0,0,0,,О!
Dialogue: 0,0:17:14.98,0:17:15.82,Default,,0,0,0,,Сая!
Dialogue: 0,0:17:15.90,0:17:18.40,Default,,0,0,0,,Мұндағы шайқаста тым көп кедергілер бар!
Dialogue: 0,0:17:18.65,0:17:19.86,Default,,0,0,0,,Жүк вагонына өтіңіз!
Dialogue: 0,0:17:20.91,0:17:21.86,Default,,0,0,0,,Алға!
Dialogue: 0,0:17:24.99,0:17:25.83,Default,,0,0,0,,Льюис!
Dialogue: 0,0:17:26.04,0:17:26.95,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:17:33.33,0:17:35.17,Default,,0,0,0,,Мен саған бірінші бар дедім.
Dialogue: 0,0:17:35.25,0:17:36.84,Default,,0,0,0,,Мен сіздің тапсырысыңызды қабылдамаймын!
Dialogue: 0,0:17:40.34,0:17:41.18,Default,,0,0,0,,Эй
Dialogue: 0,0:17:41.30,0:17:42.22,Default,,0,0,0,,Не?
Dialogue: 0,0:17:42.34,0:17:43.97,Default,,0,0,0,,Маған қарттың мылтығын қайтар.
Dialogue: 0,0:17:44.60,0:17:46.06,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,0:17:46.47,0:17:48.47,Default,,0,0,0,,Ал, мен оны сынап көруім керек...
Dialogue: 0,0:17:52.52,0:17:53.35,Default,,0,0,0,,Мен жақында ораламын!
Dialogue: 0,0:17:57.86,0:17:58.78,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:59.03,0:18:00.65,Default,,0,0,0,,Жүгіру! тез!
Dialogue: 0,0:18:01.53,0:18:02.53,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:18:07.41,0:18:09.20,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:18:16.54,0:18:17.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:37.36,0:18:38.82,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:18:45.11,0:18:46.74,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:18:56.71,0:18:57.71,Default,,0,0,0,,Қажы!
Dialogue: 0,0:19:07.22,0:19:08.26,Default,,0,0,0,,Егер шайқаста жеңілсең—
Dialogue: 0,0:19:19.94,0:19:21.44,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:19:26.20,0:19:27.95,Default,,0,0,0,,Саяның... қаны...
Dialogue: 0,0:19:28.24,0:19:29.08,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:19:40.84,0:19:41.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:42.00,0:19:42.84,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:19:54.18,0:19:56.52,Default,,0,0,0,,(жаншылған дыбыс)
Dialogue: 0,0:20:02.61,0:20:03.78,Default,,0,0,0,,Періштенің нұры
Dialogue: 0,0:20:06.15,0:20:07.45,Default,,0,0,0,,Неліктен Хироман?
Dialogue: 0,0:20:07.53,0:20:08.36,Default,,0,0,0,,Бірақ бұл демондарға да қатысты.
Dialogue: 0,0:20:09.32,0:20:10.87,Default,,0,0,0,,Уау ха ха Уау...
Dialogue: 0,0:20:18.33,0:20:19.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:19.58,0:20:20.42,Default,,0,0,0,,Рику!
Dialogue: 0,0:20:21.25,0:20:22.59,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:20:22.92,0:20:23.75,Default,,0,0,0,,Рику!
Dialogue: 0,0:20:29.26,0:20:30.30,Default,,0,0,0,,Рику~!
Dialogue: 0,0:20:30.80,0:20:31.64,Default,,0,0,0,,Сая~!
Dialogue: 0,0:20:38.81,0:20:40.86,Default,,0,0,0,,Жібер! Мені жіберіңізші!
Dialogue: 0,0:20:40.94,0:20:42.57,Default,,0,0,0,,Барғанда не істейсің?
Dialogue: 0,0:20:43.27,0:20:44.23,Default,,0,0,0,,Лиза!
Dialogue: 0,0:20:54.33,0:20:56.62,Default,,0,0,0,,Льюис! Пойызды тоқтатыңыз!
Dialogue: 0,0:20:56.70,0:20:58.08,Default,,0,0,0,,Мен... түсіндім!
Dialogue: 0,0:21:01.92,0:21:03.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:03.92,0:21:07.13,Default,,0,0,0,,Не... не болып жатыр?
Dialogue: 0,0:21:19.06,0:21:20.60,Default,,0,0,0,,Рику~!
Dialogue: 0,0:21:20.81,0:21:22.36,Default,,0,0,0,,Сая~!
Dialogue: 0,0:21:22.81,0:21:25.65,Default,,0,0,0,,Рику~! Сау~!
Dialogue: 0,0:21:26.19,0:21:29.28,Default,,0,0,0,,Рику~! Сау~!
Dialogue: 0,0:21:54.89,0:22:00.89,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:23.31,0:23:29.32,Default,,0,0,0,,~♪
Dialogue: 0,0:23:32.74,0:23:34.74,Default,,0,0,0,,Бұл бұрыннан келе жатқан оқиға
Dialogue: 0,0:23:34.99,0:23:36.82,Default,,0,0,0,,Ақ қар жауып тұрғанда
Dialogue: 0,0:23:37.07,0:23:39.83,Default,,0,0,0,,Сарғыш жалын Сайоның ұйықтап жатқан бетін нұрландырады.
Dialogue: 0,0:23:40.37,0:23:42.29,Default,,0,0,0,,Сая нені армандайды?
Dialogue: 0,0:23:42.49,0:23:45.92,Default,,0,0,0,,Менің қолымнан келгені сенің ұйқыңды қадағалау.
Dialogue: 0,0:23:46.62,0:23:50.92,Default,,0,0,0,,Өйткені Саяның ізбасары ретінде бақытқа кенелетін кез.
Dialogue: 0,0:23:51.75,0:23:53.63,Default,,0,0,0,,Келесі жолы «Blood Plus»
Dialogue: 0,0:23:53.92,0:23:55.80,Default,,0,0,0,,«Уәдеңіз есіңізде ме?»
Dialogue: 0,0:23:56.01,0:23:58.55,Default,,0,0,0,,Сая мен ұмытпаймын
Dialogue: 0,0:24:00.05,0:24:06.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory