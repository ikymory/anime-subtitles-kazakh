Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.91,0:00:12.91,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:54.87,0:00:56.37,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:36.25,0:01:42.25,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:03.96,0:03:09.97,Default,,0,0,0,,~♪
Dialogue: 0,0:03:15.14,0:03:17.14,Default,,0,0,0,,(цикада дауысы)
Dialogue: 0,0:03:17.22,0:03:21.23,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:03:23.65,0:03:24.73,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:31.20,0:03:32.49,Default,,0,0,0,,Сооооо
Dialogue: 0,0:03:33.36,0:03:34.87,Default,,0,0,0,,Сәттілік Sayo!
Dialogue: 0,0:04:00.64,0:04:01.52,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:04:02.23,0:04:04.06,Default,,0,0,0,,Бұл дәмді
Dialogue: 0,0:04:04.44,0:04:06.31,Default,,0,0,0,,Бұл сәл көбірек болды
Dialogue: 0,0:04:06.40,0:04:08.48,Default,,0,0,0,,Бұл шынымен ұят.
Dialogue: 0,0:04:09.65,0:04:12.28,Default,,0,0,0,,Менің бөксем 2 метрден асып кетті.
Dialogue: 0,0:04:12.36,0:04:13.82,Default,,0,0,0,,Бұл орта мектептің рекорды.
Dialogue: 0,0:04:13.91,0:04:14.91,Default,,0,0,0,,Кори
Dialogue: 0,0:04:14.99,0:04:15.91,Default,,0,0,0,,Сая?
Dialogue: 0,0:04:22.87,0:04:24.08,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:04:25.58,0:04:27.21,Default,,0,0,0,,Түскі ас уақыты
Dialogue: 0,0:04:30.92,0:04:32.97,Default,,0,0,0,,Мен қазір осындамын
Dialogue: 0,0:04:33.76,0:04:36.22,Default,,0,0,0,,Ммм~
Dialogue: 0,0:04:39.35,0:04:40.18,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:04:40.89,0:04:41.81,Default,,0,0,0,,Иә? не?
Dialogue: 0,0:04:41.89,0:04:44.94,Default,,0,0,0,,Қарным сонша, бар күшімді жұмсай алмаймын.
Dialogue: 0,0:04:45.02,0:04:46.15,Default,,0,0,0,,Саяға ұқсайды деп ойлаймын.
Dialogue: 0,0:04:46.69,0:04:48.61,Default,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:04:49.19,0:04:51.90,Default,,0,0,0,,Менің денем оған барымды бергенімді қаламайтын сияқты.
Dialogue: 0,0:04:51.99,0:04:53.82,Default,,0,0,0,,Бұл сондай сезім, солай емес пе?
Dialogue: 0,0:04:54.03,0:04:55.11,Default,,0,0,0,,Ммм
Dialogue: 0,0:04:55.20,0:04:58.20,Default,,0,0,0,,Егер ол болмаса, сен қазірге дейін ұлттық саясатқа қатысар ма едің?
Dialogue: 0,0:04:58.58,0:05:00.37,Default,,0,0,0,,Одан да көп (Сая) Одан да көп пе?
Dialogue: 0,0:05:00.87,0:05:03.25,Default,,0,0,0,,Осыншама көп жесең, семірмейсің.
Dialogue: 0,0:05:03.33,0:05:04.62,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:05:04.71,0:05:06.83,Default,,0,0,0,,Келіңіздер ме? Неге деп ойлаймын
Dialogue: 0,0:05:06.92,0:05:11.21,Default,,0,0,0,,Сіз мені қатты қызғанасыз, өйткені мен диетам туралы алаңдаймын!
Dialogue: 0,0:05:11.30,0:05:13.46,Default,,0,0,0,,Ах~ Эй... Эй, Каори, түскі ас қорабы...
Dialogue: 0,0:05:13.55,0:05:14.76,Default,,0,0,0,,Аа~ менің...
Dialogue: 0,0:05:14.84,0:05:18.85,Default,,0,0,0,,(Ұшақ реактивті дыбысы)
Dialogue: 0,0:05:29.69,0:05:31.15,Default,,0,0,0,,Үлкен ұшақ
Dialogue: 0,0:05:31.23,0:05:32.98,Default,,0,0,0,,Бұл бомбалаушы.
Dialogue: 0,0:05:33.07,0:05:34.24,Default,,0,0,0,,бомбалаушы?
Dialogue: 0,0:05:34.94,0:05:36.78,Default,,0,0,0,,Ұшақ бомба тастайды
Dialogue: 0,0:05:36.86,0:05:39.20,Default,,0,0,0,,Олар бір жерге соғыспақ па?
Dialogue: 0,0:05:39.87,0:05:40.87,Default,,0,0,0,,Соғысқа?
Dialogue: 0,0:05:40.95,0:05:45.12,Default,,0,0,0,,Иә, мен оны баста жұмыс істейтін анамнан естідім.
Dialogue: 0,0:05:45.20,0:05:48.00,Default,,0,0,0,,Окинавадан барлығы соғысқа барады.
Dialogue: 0,0:05:48.08,0:05:52.34,Default,,0,0,0,,Біз өмір сүре аламыз, өйткені бізде бұрын да, қазір де база бар.
Dialogue: 0,0:05:52.42,0:05:53.88,Default,,0,0,0,,Анам айтады
Dialogue: 0,0:05:54.21,0:05:56.30,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:05:57.63,0:06:00.01,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:06:00.09,0:06:02.31,Default,,0,0,0,,Дұрыс, солай емес пе?
Dialogue: 0,0:06:02.39,0:06:05.77,Default,,0,0,0,,Сая бір жыл бұрынғысын есіне түсіре алмайды.
Dialogue: 0,0:06:05.85,0:06:08.77,Default,,0,0,0,,Иә, бірақ бұл ұшақ
Dialogue: 0,0:06:11.48,0:06:14.19,Default,,0,0,0,,Мен оны бұрын көрген сияқтымын...
Dialogue: 0,0:06:15.28,0:06:16.19,Default,,0,0,0,,Сая!
Dialogue: 0,0:06:17.78,0:06:19.41,Default,,0,0,0,,Ауруханадағы жұмыс уақыты
Dialogue: 0,0:06:19.49,0:06:20.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:21.66,0:06:24.79,Default,,0,0,0,,Қай-сенпайдың маған жібергені жақсы.
Dialogue: 0,0:06:24.87,0:06:25.70,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:06:25.79,0:06:28.04,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:06:28.12,0:06:30.33,Default,,0,0,0,,Артында жүрген қыздар көп.
Dialogue: 0,0:06:30.50,0:06:33.00,Default,,0,0,0,,Мен көп нәрсені көрген жоқпын
Dialogue: 0,0:06:33.09,0:06:35.21,Default,,0,0,0,,Сыртта төбелес көп сияқты.
Dialogue: 0,0:06:36.13,0:06:38.97,Default,,0,0,0,,Өткен күні мен түнде үйге жарақаттанып келдім.
Dialogue: 0,0:06:39.05,0:06:40.89,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:06:41.09,0:06:41.93,Default,,0,0,0,,Кете бар! Мен сені тыңдамаймын!
Dialogue: 0,0:06:42.64,0:06:43.89,Default,,0,0,0,,Мен төбелескенді жек көремін
Dialogue: 0,0:06:44.89,0:06:45.89,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:06:45.97,0:06:48.81,Default,,0,0,0,,Сенпай, сен енді бейсбол ойнамайсың деп ойлаймын.
Dialogue: 0,0:06:48.89,0:06:50.40,Default,,0,0,0,,Сіз бұрын жақсы орындадыңыз ба?
Dialogue: 0,0:06:50.48,0:06:53.73,Default,,0,0,0,,Бейсбол клубының бұрынғы ойыншысы, эйс құмыра
Dialogue: 0,0:06:53.82,0:06:54.90,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:06:57.24,0:06:58.82,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:06:59.70,0:07:01.32,Default,,0,0,0,,Бұған әлі де уақыт керек пе?
Dialogue: 0,0:07:01.66,0:07:03.16,Default,,0,0,0,,Жаңадан шыққан батыр Mt. Lady –
Dialogue: 0,0:07:04.20,0:07:07.29,Default,,0,0,0,,Ертеңгі жарыс, ұйықтамай, кешігіп қал.
Dialogue: 0,0:07:07.70,0:07:09.41,Default,,0,0,0,,Иә! Ертең кездескенше
Dialogue: 0,0:07:18.46,0:07:19.76,Default,,0,0,0,,Мен әрқашан кешірім сұраймын
Dialogue: 0,0:07:19.84,0:07:21.84,Default,,0,0,0,,О, бұл туралы уайымдама.
Dialogue: 0,0:07:21.93,0:07:23.89,Default,,0,0,0,,Мен үйге автобуспен барамын.
Dialogue: 0,0:07:23.97,0:07:24.80,Default,,0,0,0,,О
Dialogue: 0,0:07:27.85,0:07:30.44,Default,,0,0,0,,Кай: Мен сенің бейсбол ойнағаныңды естідім.
Dialogue: 0,0:07:30.52,0:07:33.15,Default,,0,0,0,,Сая менің үйіме келгенше шығып кеттім.
Dialogue: 0,0:07:33.73,0:07:36.90,Default,,0,0,0,,Әкемнің қолына түскеніме бір жыл болды.
Dialogue: 0,0:07:36.98,0:07:39.49,Default,,0,0,0,,Мен білмейтін нәрселер өте көп.
Dialogue: 0,0:07:39.74,0:07:41.53,Default,,0,0,0,,Өткеннің маңызы жоқ
Dialogue: 0,0:07:41.99,0:07:43.78,Default,,0,0,0,,Иә, қария осылай дейді.
Dialogue: 0,0:07:43.95,0:07:45.20,Default,,0,0,0,,Біздің отбасы
Dialogue: 0,0:07:45.28,0:07:47.74,Default,,0,0,0,,Біз қандас емеспіз, бірақ қазір отбасымыз.
Dialogue: 0,0:07:48.95,0:07:50.25,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:51.33,0:07:55.33,Default,,0,0,0,,Ауруханаға барар алдында мен сенің сүйікті жағаңнан өтемін.
Dialogue: 0,0:07:56.67,0:07:57.71,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:29.66,0:08:31.58,Default,,0,0,0,,Тышқан қалай әрекет етеді?
Dialogue: 0,0:08:31.75,0:08:34.04,Default,,0,0,0,,Қарсыластың іздеу аймағы кеңейтілді.
Dialogue: 0,0:08:34.12,0:08:35.75,Default,,0,0,0,,Әлі хит жоқ
Dialogue: 0,0:08:36.71,0:08:37.71,Default,,0,0,0,,(Яо) Камина-сан… (Мибори) Бізді алдап қалды.
Dialogue: 0,0:08:38.38,0:08:40.63,Default,,0,0,0,,Тінтуірді табу үшін қолдан келгеннің бәрін жасап жатырмыз.
Dialogue: 0,0:08:41.34,0:08:44.55,Default,,0,0,0,,Дегенмен, қол жетімді персонал санына да шектеу бар.
Dialogue: 0,0:08:44.80,0:08:47.26,Default,,0,0,0,,Осыны түсінгеніңізді қалаймын.
Dialogue: 0,0:08:47.35,0:08:48.55,Default,,0,0,0,,Мырза...
Dialogue: 0,0:08:49.43,0:08:51.35,Default,,0,0,0,,Ван Алььяно
Dialogue: 0,0:08:51.43,0:08:54.48,Default,,0,0,0,,Өзімнің өз ұлыммен құрдас кезімде.
Dialogue: 0,0:08:54.56,0:08:56.81,Default,,0,0,0,,Сіз оны ұстанғыңыз келмеуі мүмкін.
Dialogue: 0,0:08:57.06,0:09:00.61,Default,,0,0,0,,Менің сөзім де бастығыңның сөзі.
Dialogue: 0,0:09:00.69,0:09:03.74,Default,,0,0,0,,Ал екі тышқан қашып кетті.
Dialogue: 0,0:09:03.82,0:09:05.91,Default,,0,0,0,,Бұл сіздің жауапкершілігіңіз.
Dialogue: 0,0:09:06.91,0:09:08.12,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:09:08.53,0:09:09.95,Default,,0,0,0,,жақсы.
Dialogue: 0,0:09:10.62,0:09:14.08,Default,,0,0,0,,Сонымен... Қызық, қазір В типі қайда?
Dialogue: 0,0:09:14.50,0:09:16.58,Default,,0,0,0,,Қоза болса керек
Dialogue: 0,0:09:17.29,0:09:19.50,Default,,0,0,0,,Коза? Хмм
Dialogue: 0,0:09:21.00,0:09:22.46,Default,,0,0,0,,Окинава қаласы?
Dialogue: 0,0:09:22.96,0:09:24.30,Default,,0,0,0,,Келесі жаңалық
Dialogue: 0,0:09:24.38,0:09:27.68,Default,,0,0,0,,Бұл Наго-Ситиде орын алған көше қылмыстары туралы кейінгі есеп.
Dialogue: 0,0:09:28.14,0:09:32.31,Default,,0,0,0,,Полицияның тергеуіне сәйкес, қылмыскер жәбірленуші әйелді алып кеткен.
Dialogue: 0,0:09:32.39,0:09:35.85,Default,,0,0,0,,Оған шабуыл жасап, өткір пышақпен өлтірген көрінеді.
Dialogue: 0,0:09:36.10,0:09:39.69,Default,,0,0,0,,Өйткені мәйіт табылған жерде қан дақтары қалмады.
Dialogue: 0,0:09:39.77,0:09:42.82,Default,,0,0,0,,Жәбірленуші басқа жерде өлтірілді...
Dialogue: 0,0:09:42.94,0:09:43.73,Default,,0,0,0,,Отонаши-сан
Dialogue: 0,0:09:43.82,0:09:44.65,Default,,0,0,0,,Иә
Dialogue: 0,0:09:46.24,0:09:49.74,Default,,0,0,0,,Өзіңізді қалай сезінесіз? Есіңде бірдеңе бар ма?
Dialogue: 0,0:09:50.49,0:09:52.24,Default,,0,0,0,,Атап айтқанда, ештеңе жоқ
Dialogue: 0,0:09:52.66,0:09:53.58,Default,,0,0,0,,Иә
Dialogue: 0,0:09:54.08,0:09:57.71,Default,,0,0,0,,Енді көктамыр ішіне тамшылатып енгізу аяқталғанша сабырлы болыңыз.
Dialogue: 0,0:09:58.25,0:09:59.08,Default,,0,0,0,,Иә
Dialogue: 0,0:10:04.59,0:10:06.01,Default,,0,0,0,,Жад?
Dialogue: 0,0:10:06.63,0:10:09.05,Default,,0,0,0,,Ол болған жағдайда ғана болуы мүмкін.
Dialogue: 0,0:10:13.01,0:10:17.14,Default,,0,0,0,,(виолончель орындауы)
Dialogue: 0,0:10:17.23,0:10:18.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:18.98,0:10:21.94,Default,,0,0,0,,(виолончельде орындау)
Dialogue: 0,0:11:10.28,0:11:12.57,Default,,0,0,0,,Не? таңқаларлық
Dialogue: 0,0:11:38.43,0:11:39.60,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:40.85,0:11:42.69,Default,,0,0,0,,Әй? сурет?
Dialogue: 0,0:11:51.15,0:11:53.45,Default,,0,0,0,,Бұл балаға не болды?
Dialogue: 0,0:11:53.53,0:11:54.37,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:12:01.61,0:12:05.45,Default,,0,0,0,,Қараңыз, оны білегіңізден иығыңызға дейін жалғанған деп ойлаңыз.
Dialogue: 0,0:12:06.12,0:12:08.37,Default,,0,0,0,,Ойламасаң да, қосыласың!
Dialogue: 0,0:12:09.37,0:12:10.33,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:12:10.41,0:12:13.54,Default,,0,0,0,,Жай ғана допты өзі қалаған бағытқа қарай итеріңіз.
Dialogue: 0,0:12:16.00,0:12:16.84,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:12:17.46,0:12:18.30,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:12:18.71,0:12:21.13,Default,,0,0,0,,О? Сіз осында барғыңыз келді ме?
Dialogue: 0,0:12:21.59,0:12:22.84,Default,,0,0,0,,Допты сұрау
Dialogue: 0,0:12:22.93,0:12:24.39,Default,,0,0,0,,Жолдан кет! Эй!
Dialogue: 0,0:12:26.30,0:12:28.39,Default,,0,0,0,,Саябақта қармақ ойнауға тыйым салынады.
Dialogue: 0,0:12:28.81,0:12:30.85,Default,,0,0,0,,Сайо-ничан, қош келдіңіз
Dialogue: 0,0:12:30.93,0:12:31.94,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:12:32.02,0:12:34.35,Default,,0,0,0,,Жоқ, ол жерде ешкім болған жоқ.
Dialogue: 0,0:12:34.44,0:12:36.61,Default,,0,0,0,,Менің әкем қазірдің өзінде
Dialogue: 0,0:12:36.69,0:12:38.61,Default,,0,0,0,,Ол жерде ешкім болмаса, бәрібір
Dialogue: 0,0:12:39.78,0:12:42.28,Default,,0,0,0,,О! қиын курс
Dialogue: 0,0:12:44.70,0:12:47.53,Default,,0,0,0,,Сайо, түскі астың бос қорабын шығар.
Dialogue: 0,0:12:48.20,0:12:50.04,Default,,0,0,0,,Бүгін өзім жуамын.
Dialogue: 0,0:12:50.12,0:12:51.50,Default,,0,0,0,,Оны суға салып қойыңыз, солай ма?
Dialogue: 0,0:12:51.58,0:12:52.41,Default,,0,0,0,,О...
Dialogue: 0,0:12:52.83,0:12:54.17,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:12:54.25,0:12:56.04,Default,,0,0,0,,Әсіресе, қалай болғанда да
Dialogue: 0,0:12:56.13,0:12:57.88,Default,,0,0,0,,Сіз өзіңізді перзенттік сезінесіз бе?
Dialogue: 0,0:12:57.96,0:13:01.38,Default,,0,0,0,,Иә? Менде жарысқа арналған аяқ киім жоқ
Dialogue: 0,0:13:01.80,0:13:03.63,Default,,0,0,0,,Тағы бір нәрсені ұмыттыңыз ба?
Dialogue: 0,0:13:04.26,0:13:07.68,Default,,0,0,0,,Бұл клуб бөлмесі ме? Жоқ. Бұл ағаш па?
Dialogue: 0,0:13:07.76,0:13:09.39,Default,,0,0,0,,Мен біраз уақытқа мектепке барамын.
Dialogue: 0,0:13:09.47,0:13:10.77,Default,,0,0,0,,Не? қазірден?
Dialogue: 0,0:13:10.85,0:13:12.89,Default,,0,0,0,,Жарыс ертең таңертең басталады.
Dialogue: 0,0:13:12.98,0:13:13.81,Default,,0,0,0,,30 минут
Dialogue: 0,0:13:14.27,0:13:17.94,Default,,0,0,0,,Мен 30 минуттан кейін келемін, тамақты бастамаңыз, күте тұрыңыз.
Dialogue: 0,0:13:18.02,0:13:18.94,Default,,0,0,0,,О
Dialogue: 0,0:13:19.02,0:13:20.15,Default,,0,0,0,,Әрине, Рику
Dialogue: 0,0:13:20.82,0:13:22.90,Default,,0,0,0,,Жарайды, көп жүгірме.
Dialogue: 0,0:13:23.32,0:13:25.32,Default,,0,0,0,,Жоғары сынып оқушыларына қандай жолдар айтар едіңіз?
Dialogue: 0,0:13:25.41,0:13:27.32,Default,,0,0,0,,29 минут қалды
Dialogue: 0,0:13:27.41,0:13:28.62,Default,,0,0,0,,Ой
Dialogue: 0,0:13:29.37,0:13:30.83,Default,,0,0,0,,Апа, құлап қалмаңыз.
Dialogue: 0,0:13:30.95,0:13:31.79,Default,,0,0,0,,Құлап қалмаңыз
Dialogue: 0,0:13:32.79,0:13:34.46,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:13:35.21,0:13:37.63,Default,,0,0,0,,Қош келдіңіз, Дэвид.
Dialogue: 0,0:13:44.01,0:13:47.18,Default,,0,0,0,,Менің қызымның не істегенін қалайсың? Дэвид
Dialogue: 0,0:13:48.10,0:13:49.51,Default,,0,0,0,,Менің бір оқиғам бар.
Dialogue: 0,0:13:50.39,0:13:52.85,Default,,0,0,0,,Рику Жоғарыдағы теледидардан қараңыз.
Dialogue: 0,0:13:53.02,0:13:53.85,Default,,0,0,0,,Иә
Dialogue: 0,0:13:54.23,0:13:55.35,Default,,0,0,0,,Әке?
Dialogue: 0,0:13:55.77,0:13:59.31,Default,,0,0,0,,Сіз ұмытып кеткен нәрсені алуға барасыз. Тез жүріңіз.
Dialogue: 0,0:13:59.82,0:14:02.11,Default,,0,0,0,,Иә, барамын.
Dialogue: 0,0:14:16.92,0:14:20.71,Default,,0,0,0,,Ұйымның Саяны саған сеніп тапсырғанына бір жылдай болды.
Dialogue: 0,0:14:20.79,0:14:22.00,Default,,0,0,0,,Ешқандай өзгеріс жоқ па?
Dialogue: 0,0:14:22.42,0:14:24.97,Default,,0,0,0,,Бар болса да, мен сендерге бермеймін.
Dialogue: 0,0:14:25.59,0:14:26.80,Default,,0,0,0,,Ол менікі...
Dialogue: 0,0:14:26.88,0:14:28.43,Default,,0,0,0,,Қайтыс болған қызымның орнын басатын ба?
Dialogue: 0,0:14:29.09,0:14:30.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:35.35,0:14:36.64,Default,,0,0,0,,Осы айдың бөлігі
Dialogue: 0,0:14:36.73,0:14:40.06,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:14:40.15,0:14:42.57,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:14:50.16,0:14:54.04,Default,,0,0,0,,Ол жабылды, мен не істеуім керек?
Dialogue: 0,0:15:40.71,0:15:43.00,Default,,0,0,0,,Ақыры біз кездестік
Dialogue: 0,0:15:43.42,0:15:44.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:57.06,0:15:57.89,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:15:58.31,0:15:59.35,Default,,0,0,0,,О, не?
Dialogue: 0,0:16:02.15,0:16:04.02,Default,,0,0,0,,Мұғалім, сіз қалай ойлайсыз?
Dialogue: 0,0:16:04.19,0:16:05.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:07.90,0:16:08.74,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:12.36,0:16:13.99,Default,,0,0,0,,Мұнда ешкім жоқ
Dialogue: 0,0:16:14.07,0:16:16.28,Default,,0,0,0,,Бірақ ол пышақ тәрізді бірдеңені ұстап тұрды.
Dialogue: 0,0:16:16.70,0:16:19.25,Default,,0,0,0,,Бұл Нагодан келген көше ұры болуы керек.
Dialogue: 0,0:16:19.91,0:16:21.75,Default,,0,0,0,,Полицияға хабарлау керек...
Dialogue: 0,0:16:23.58,0:16:28.09,Default,,0,0,0,,(Бір нәрсенің сынған және жарылған дыбысы)
Dialogue: 0,0:16:30.09,0:16:31.47,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:16:32.97,0:16:35.18,Default,,0,0,0,,Мұғалім...
Dialogue: 0,0:16:38.52,0:16:41.77,Default,,0,0,0,,Ха! Күрсін... Се... Алдымен...
Dialogue: 0,0:17:02.66,0:17:06.50,Default,,0,0,0,,(Хиротенің шайқас айқайы)
Dialogue: 0,0:17:10.26,0:17:11.21,Default,,0,0,0,,Чарлиден Браво
Dialogue: 0,0:17:11.76,0:17:14.80,Default,,0,0,0,,C5 - C7 Jelly тінтуірінің реакциясын растау
Dialogue: 0,0:17:14.88,0:17:16.72,Default,,0,0,0,,Мұнда да расталған
Dialogue: 0,0:17:16.80,0:17:18.93,Default,,0,0,0,,Түсіндім, Томкотты асығыңыз.
Dialogue: 0,0:17:36.70,0:17:38.70,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:38.78,0:17:39.91,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:17:39.99,0:17:41.29,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:17:41.95,0:17:43.66,Default,,0,0,0,,Не болды? Кори-чан
Dialogue: 0,0:17:43.75,0:17:45.83,Default,,0,0,0,,Мм, бұл Сайоның аяқ киімі.
Dialogue: 0,0:17:46.37,0:17:47.50,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым
Dialogue: 0,0:17:47.58,0:17:51.00,Default,,0,0,0,,Иә? Сайо оны алуға мектепке кетті.
Dialogue: 0,0:17:51.46,0:17:53.55,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:17:53.63,0:17:54.63,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:17:54.72,0:17:56.55,Default,,0,0,0,,Бұл не, қария, енді...
Dialogue: 0,0:17:58.85,0:18:02.47,Default,,0,0,0,,Жарайды, тезірек Саяға ұялы телефон сатып ал.
Dialogue: 0,0:18:03.52,0:18:05.35,Default,,0,0,0,,Таку, қиын
Dialogue: 0,0:18:05.77,0:18:06.98,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:18:08.40,0:18:10.36,Default,,0,0,0,,Мұнда біреу бар ма?
Dialogue: 0,0:18:21.41,0:18:24.45,Default,,0,0,0,,(Хироманның ырылдауы)
Dialogue: 0,0:18:38.97,0:18:40.55,Default,,0,0,0,,Ха ха ха... Ах!
Dialogue: 0,0:18:57.11,0:18:58.11,Default,,0,0,0,,Сая
Dialogue: 0,0:19:05.87,0:19:07.08,Default,,0,0,0,,Не болды? Бірге
Dialogue: 0,0:19:07.16,0:19:08.00,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:19:25.68,0:19:27.14,Default,,0,0,0,,Соққы
Dialogue: 0,0:19:27.81,0:19:29.27,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:19:29.73,0:19:30.73,Default,,0,0,0,,Хироман
Dialogue: 0,0:19:31.48,0:19:33.19,Default,,0,0,0,,Ал... Шу?
Dialogue: 0,0:19:34.98,0:19:36.94,Default,,0,0,0,,Тірі қанды жейтін аң
Dialogue: 0,0:19:37.61,0:19:39.03,Default,,0,0,0,,Қан сорады ма?
Dialogue: 0,0:19:52.71,0:19:55.00,Default,,0,0,0,,Мм... не істеп жатырсың?
Dialogue: 0,0:19:59.55,0:20:00.38,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:00.93,0:20:02.39,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:20:11.10,0:20:12.85,Default,,0,0,0,,А... не?
Dialogue: 0,0:20:16.36,0:20:17.32,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:19.40,0:20:20.82,Default,,0,0,0,,Артық емес
Dialogue: 0,0:20:38.42,0:20:40.92,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:20:57.90,0:20:58.98,Default,,0,0,0,,Сая!
Dialogue: 0,0:21:03.57,0:21:04.49,Default,,0,0,0,,Сая...
Dialogue: 0,0:21:04.61,0:21:07.66,Default,,0,0,0,,(Хиротенің ұрыс айқайы)
Dialogue: 0,0:21:08.62,0:21:09.58,Default,,0,0,0,,Бұл тек қана достық теннис матчы.
Dialogue: 0,0:21:12.71,0:21:13.54,Default,,0,0,0,,Сая
Dialogue: 0,0:21:15.17,0:21:16.54,Default,,0,0,0,,Жекпе-жек
Dialogue: 0,0:21:42.90,0:21:43.86,Default,,0,0,0,,No
Dialogue: 0,0:21:56.37,0:22:02.38,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:18.71,0:23:24.71,Default,,0,0,0,,~♪
Dialogue: 0,0:23:28.93,0:23:31.01,Default,,0,0,0,,«Сая шайқасы»
Dialogue: 0,0:23:32.05,0:23:33.97,Default,,0,0,0,,Сол адам твиттерде осылай жазды.
Dialogue: 0,0:23:34.60,0:23:38.14,Default,,0,0,0,,Оның сүйісімен ыстық қан ағады
Dialogue: 0,0:23:38.23,0:23:40.65,Default,,0,0,0,,Мені шайқаста билеуге мәжбүр ет
Dialogue: 0,0:23:41.23,0:23:43.69,Default,,0,0,0,,Мен өзгеремін Мен өзгеремін
Dialogue: 0,0:23:44.11,0:23:47.94,Default,,0,0,0,,Қолымдағы жүздің салмағы мені шайқасқа шақырады.
Dialogue: 0,0:23:48.70,0:23:50.41,Default,,0,0,0,,Келесі жолы «Blood Plus»
Dialogue: 0,0:23:50.49,0:23:51.82,Default,,0,0,0,,«Сиқырлы сөздер»
Dialogue: 0,0:23:53.12,0:23:54.74,Default,,0,0,0,,Маған көмектесші, Кай!
Dialogue: 0,0:23:56.24,0:24:02.24,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory