Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.03,0:00:13.07,Default,,0,0,0,,Сая
Dialogue: 0,0:00:13.70,0:00:14.82,Default,,0,0,0,,Сая!
Dialogue: 0,0:00:16.28,0:00:17.37,Default,,0,0,0,,Сая!
Dialogue: 0,0:00:17.99,0:00:24.00,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:44.87,0:01:50.88,Default,,0,0,0,,~♪
Dialogue: 0,0:01:56.88,0:02:01.09,Default,,0,0,0,,(Оттың шуы)
Dialogue: 0,0:02:01.18,0:02:02.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:16.36,0:02:17.28,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:17.49,0:02:19.03,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:02:19.99,0:02:22.82,Default,,0,0,0,,Мен қарда жаттым.
Dialogue: 0,0:02:22.95,0:02:23.78,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:02:25.16,0:02:26.24,Default,,0,0,0,,Сая
Dialogue: 0,0:02:26.62,0:02:29.29,Default,,0,0,0,,Сізге маңызды рөл ойнау керек.
Dialogue: 0,0:02:29.37,0:02:30.67,Default,,0,0,0,,Бұл туралы ескертіңіз.
Dialogue: 0,0:02:30.87,0:02:32.63,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:02:33.54,0:02:35.59,Default,,0,0,0,,Бірақ... мен мұны істеп жатқанда...
Dialogue: 0,0:02:35.67,0:02:37.59,Default,,0,0,0,,Нысана қашып кетуі мүмкін, солай ма?
Dialogue: 0,0:02:38.21,0:02:41.55,Default,,0,0,0,,Жығылып қалсаң, ештеңе қалмайды.
Dialogue: 0,0:02:42.22,0:02:45.14,Default,,0,0,0,,Бірінші Бұл боранда
Dialogue: 0,0:02:45.22,0:02:47.97,Default,,0,0,0,,Өз бетімен шығу тым абайсызда.
Dialogue: 0,0:02:48.72,0:02:49.93,Default,,0,0,0,,Сен
Dialogue: 0,0:02:50.02,0:02:53.90,Default,,0,0,0,,Мен бұрын-соңды қар жауатын жерде тұрған емеспін.
Dialogue: 0,0:02:55.61,0:02:58.40,Default,,0,0,0,,Неліктен ол жерде жатты?
Dialogue: 0,0:02:58.90,0:03:00.78,Default,,0,0,0,,Мен кенеттен ұйықтап кеттім.
Dialogue: 0,0:03:00.86,0:03:01.70,Default,,0,0,0,,Ұйқыңыз келе ме?
Dialogue: 0,0:03:04.28,0:03:05.32,Default,,0,0,0,,Жұм, кеудең жалпақ сиыр.
Dialogue: 0,0:03:06.37,0:03:07.79,Default,,0,0,0,,Дене қызуыңыз төмендейді.
Dialogue: 0,0:03:10.62,0:03:12.21,Default,,0,0,0,,Оянғаныңа үш жыл болды ма?
Dialogue: 0,0:03:13.33,0:03:15.17,Default,,0,0,0,,Келесі рет оянғанда
Dialogue: 0,0:03:15.25,0:03:19.38,Default,,0,0,0,,Мені ешкім есіне түсірмейтін шығар
Dialogue: 0,0:03:19.63,0:03:21.34,Default,,0,0,0,,Мен күтемін
Dialogue: 0,0:03:21.47,0:03:23.30,Default,,0,0,0,,мәңгі
Dialogue: 0,0:03:24.01,0:03:24.89,Default,,0,0,0,,Иә
Dialogue: 0,0:03:26.05,0:03:28.81,Default,,0,0,0,,Баратын ауылға ертең жетеміз.
Dialogue: 0,0:03:28.89,0:03:30.43,Default,,0,0,0,,Сіз әлі ұйықтап жатырсыз ба?
Dialogue: 0,0:03:30.52,0:03:32.06,Default,,0,0,0,,Мен жақсымын.
Dialogue: 0,0:03:32.14,0:03:35.23,Default,,0,0,0,,Одан гөрі, қажы, сәл демалыңыз.
Dialogue: 0,0:03:35.86,0:03:37.02,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:37.11,0:03:39.40,Default,,0,0,0,,Мен ұйықтай алмаймын
Dialogue: 0,0:03:39.48,0:03:40.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:40.40,0:03:41.74,Default,,0,0,0,,Бірлесіп әрекет етіп жатыр ма?
Dialogue: 0,0:03:42.20,0:03:43.49,Default,,0,0,0,,Мен ұйықтап қалғанша
Dialogue: 0,0:03:43.57,0:03:45.70,Default,,0,0,0,,Сен бізге үйреткен әнді орындайық.
Dialogue: 0,0:03:46.28,0:03:50.37,Default,,0,0,0,,Сен ұйықтап жатқанда мен жаттығатынмын.
Dialogue: 0,0:03:51.12,0:03:55.88,Default,,0,0,0,,(виолончель орындауы)
Dialogue: 0,0:03:59.75,0:04:02.84,Default,,0,0,0,,Әлі онша жақсы емес.
Dialogue: 0,0:04:03.72,0:04:05.68,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:04:06.76,0:04:09.81,Default,,0,0,0,,(виолончель орындауы)
Dialogue: 0,0:04:23.65,0:04:24.65,Default,,0,0,0,,Сіз оны қалай оқисыз?
Dialogue: 0,0:04:25.20,0:04:27.07,Default,,0,0,0,,Покровское
Dialogue: 0,0:04:27.16,0:04:29.78,Default,,0,0,0,,Бұл Григорийдің туған ауылы.
Dialogue: 0,0:04:29.91,0:04:31.37,Default,,0,0,0,,Сіз көздеген ауыл осы ма?
Dialogue: 0,0:04:31.87,0:04:32.91,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:33.00,0:04:35.83,Default,,0,0,0,,Ауылдың қасында, одан сәл ғана сыртта
Dialogue: 0,0:04:35.92,0:04:38.88,Default,,0,0,0,,Григорий жасырынып жатыр деген жаңалық бар.
Dialogue: 0,0:04:38.96,0:04:41.00,Default,,0,0,0,,Мен оның қайтыс болғанын естідім.
Dialogue: 0,0:04:42.30,0:04:46.88,Default,,0,0,0,,Бұл ел қазір төңкеріске ұшырап, күйзеліс үстінде.
Dialogue: 0,0:04:47.22,0:04:51.14,Default,,0,0,0,,Расында да, қанаттылар біздің тордан құтылды.
Dialogue: 0,0:04:51.22,0:04:54.10,Default,,0,0,0,,Бұл жасырынуға ыңғайлы жер.
Dialogue: 0,0:04:55.69,0:05:01.11,Default,,0,0,0,,Баяндамада айтылған ауылға бір рет тоқтап, Григорий туралы мәлімет жинаңыз.
Dialogue: 0,0:05:01.65,0:05:02.73,Default,,0,0,0,,Анастасия ше?
Dialogue: 0,0:05:03.15,0:05:07.61,Default,,0,0,0,,Ол әлі де осы елдің бір жерінде жасырынып жүрген шығар.
Dialogue: 0,0:05:07.82,0:05:11.41,Default,,0,0,0,,Бірақ Анастасия Григорийге сенді.
Dialogue: 0,0:05:11.78,0:05:12.99,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:13.08,0:05:14.50,Default,,0,0,0,,Григорийден бастайық.
Dialogue: 0,0:05:15.12,0:05:16.12,Default,,0,0,0,,Иә
Dialogue: 0,0:05:25.42,0:05:27.09,Default,,0,0,0,,Григорий?
Dialogue: 0,0:05:28.01,0:05:31.35,Default,,0,0,0,,Жиырма жыл бұрын мен Покровское ауылында болдым.
Dialogue: 0,0:05:31.43,0:05:36.89,Default,,0,0,0,,Ефимович байдың екінші ұлы сияқты.
Dialogue: 0,0:05:37.52,0:05:38.98,Default,,0,0,0,,Себебі менің басым айналады
Dialogue: 0,0:05:39.06,0:05:41.40,Default,,0,0,0,,«Распутцво» деп аталды.
Dialogue: 0,0:05:41.48,0:05:43.36,Default,,0,0,0,,Распутсво?
Dialogue: 0,0:05:43.48,0:05:45.69,Default,,0,0,0,,Бұл ысырапшыл деген сөз.
Dialogue: 0,0:05:46.11,0:05:47.40,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:05:48.36,0:05:51.91,Default,,0,0,0,,Әр ауылда жастар ауылдан тұрақсыз кетеді.
Dialogue: 0,0:05:52.99,0:05:55.41,Default,,0,0,0,,Барлығы Распутсво
Dialogue: 0,0:05:55.79,0:05:58.62,Default,,0,0,0,,Ешкім қалмады ма?
Dialogue: 0,0:05:58.71,0:06:01.21,Default,,0,0,0,,Менің Соня есімді қызым бар.
Dialogue: 0,0:06:01.29,0:06:02.13,Default,,0,0,0,,Соня?
Dialogue: 0,0:06:02.75,0:06:07.34,Default,,0,0,0,,Юрий ауыл шетіндегі саятшылықта тұратын ғұламаның қызы болған.
Dialogue: 0,0:06:08.17,0:06:11.72,Default,,0,0,0,,Ол көптеген қорқынышты тәжірибелер жасаған ғалым болды.
Dialogue: 0,0:06:12.47,0:06:16.68,Default,,0,0,0,,Тіпті ауыл адамдары да ол жерге жақындаған жоқ.
Dialogue: 0,0:06:18.02,0:06:21.06,Default,,0,0,0,,Мен Екатеринбургке көштім.
Dialogue: 0,0:06:21.15,0:06:25.40,Default,,0,0,0,,Төңкеріс болды деп осы ауылға қайтып келдім.
Dialogue: 0,0:06:27.03,0:06:29.49,Default,,0,0,0,,Қараңызшы, бұл Соня.
Dialogue: 0,0:06:34.83,0:06:36.74,Default,,0,0,0,,Сәлеметсіз бе, әже
Dialogue: 0,0:06:39.37,0:06:40.66,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:41.25,0:06:43.29,Default,,0,0,0,,Онда мен барамын.
Dialogue: 0,0:06:50.01,0:06:52.68,Default,,0,0,0,,Бұл ауылға бірдеңе керек пе?
Dialogue: 0,0:06:52.76,0:06:54.10,Default,,0,0,0,,Біреуді іздеу
Dialogue: 0,0:06:54.18,0:06:55.18,Default,,0,0,0,,Адамдар?
Dialogue: 0,0:06:55.43,0:06:57.39,Default,,0,0,0,,Григорий есімді адам.
Dialogue: 0,0:06:57.47,0:06:58.31,Default,,0,0,0,,Григорий?
Dialogue: 0,0:06:58.85,0:07:00.81,Default,,0,0,0,,Иә, ол кісі.
Dialogue: 0,0:07:01.23,0:07:02.27,Default,,0,0,0,,No
Dialogue: 0,0:07:02.90,0:07:04.86,Default,,0,0,0,,Ауылға келгеніме екі жылдай болды.
Dialogue: 0,0:07:04.94,0:07:06.90,Default,,0,0,0,,Өткенді көп білмеймін.
Dialogue: 0,0:07:07.57,0:07:08.61,Default,,0,0,0,,Иә
Dialogue: 0,0:07:10.32,0:07:12.86,Default,,0,0,0,,Эй, сен бүгін түнде қайдасың?
Dialogue: 0,0:07:12.95,0:07:13.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:14.16,0:07:17.03,Default,,0,0,0,,Өзіме жақын қызбен танысқаныма көп болды.
Dialogue: 0,0:07:17.12,0:07:20.04,Default,,0,0,0,,Мен сіздермен әртүрлі нәрселер туралы сөйлескім келеді.
Dialogue: 0,0:07:20.16,0:07:22.33,Default,,0,0,0,,Эй, сен менің үйімде тұра аласың ба?
Dialogue: 0,0:07:24.00,0:07:25.71,Default,,0,0,0,,Сіз де.
Dialogue: 0,0:07:25.79,0:07:29.96,Default,,0,0,0,,Сенің әкеңде төсек бар, сондықтан оны ұстаудың қажеті жоқ.
Dialogue: 0,0:07:30.46,0:07:33.72,Default,,0,0,0,,Бірақ әкең қиыншылыққа тап болмай ма?
Dialogue: 0,0:07:34.80,0:07:36.89,Default,,0,0,0,,Сенің әкең енді жоқ.
Dialogue: 0,0:07:37.22,0:07:38.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:38.31,0:07:41.14,Default,,0,0,0,,Ол толығымен ақ түсті.
Dialogue: 0,0:07:41.31,0:07:45.35,Default,,0,0,0,,Денесіндегі қан түгел ағылып кеткендей ағарып, өлді.
Dialogue: 0,0:07:51.44,0:07:53.82,Default,,0,0,0,,Екі ай болды.
Dialogue: 0,0:07:54.07,0:07:57.24,Default,,0,0,0,,Сонда сен Хаджи-санмен бірге жүрсің бе?
Dialogue: 0,0:07:57.32,0:07:58.16,Default,,0,0,0,,Иә
Dialogue: 0,0:07:58.66,0:08:03.50,Default,,0,0,0,,Екеуің мәңгі бірге болдыңдар. Сіз ғашық болуыңыз мүмкін бе?
Dialogue: 0,0:08:03.87,0:08:04.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:05.25,0:08:06.50,Default,,0,0,0,,Қажы...
Dialogue: 0,0:08:06.63,0:08:08.34,Default,,0,0,0,,Бұл бір отбасы сияқты
Dialogue: 0,0:08:09.21,0:08:10.38,Default,,0,0,0,,Сонымен қатар, дәптерге қол тимейінше Шinigami-ді көре алмайсың – онда қалай…
Dialogue: 0,0:08:10.96,0:08:12.30,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:16.84,0:08:18.51,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:08:18.60,0:08:20.51,Default,,0,0,0,,Онда жалғызсың ба? (Соня) Иә.
Dialogue: 0,0:08:21.10,0:08:23.27,Default,,0,0,0,,Амансың ба? бұл көпір
Dialogue: 0,0:08:23.52,0:08:26.02,Default,,0,0,0,,Бұл бұрын әлдеқайда жақсы көпір болды.
Dialogue: 0,0:08:26.10,0:08:29.48,Default,,0,0,0,,Бірақ әкем өмірден озғалы, жастар болған жоқ.
Dialogue: 0,0:08:29.90,0:08:33.74,Default,,0,0,0,,Оны түзететін ешкім қалмады, сондықтан мен әлі біраз қорқамын.
Dialogue: 0,0:08:34.24,0:08:35.95,Default,,0,0,0,,Бірақ бүгін жақсы!
Dialogue: 0,0:08:36.03,0:08:37.07,Default,,0,0,0,,Өйткені мен сенімен біргемін!
Dialogue: 0,0:08:37.53,0:08:38.62,Default,,0,0,0,,Олар Жапонияда, анамды күтіп, оны қауіпсіз ұстап отыр ➡
Dialogue: 0,0:08:38.70,0:08:40.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:42.45,0:08:44.21,Default,,0,0,0,,Келіңіздер! кеттік
Dialogue: 0,0:08:47.25,0:08:48.08,Default,,0,0,0,,Ей!
Dialogue: 0,0:08:48.17,0:08:50.42,Default,,0,0,0,,Олар осылай жабысса қауіпті.
Dialogue: 0,0:08:50.50,0:08:52.80,Default,,0,0,0,,Бірақ бұл қорқынышты.
Dialogue: 0,0:08:54.30,0:08:55.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:55.72,0:08:56.63,Default,,0,0,0,,Сая! (Зап~н!)
Dialogue: 0,0:08:56.97,0:08:58.39,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:09:23.08,0:09:23.91,Default,,0,0,0,,Тәтті...
Dialogue: 0,0:09:24.54,0:09:25.79,Default,,0,0,0,,Збычный
Dialogue: 0,0:09:25.87,0:09:27.62,Default,,0,0,0,,Бұл бал шайы.
Dialogue: 0,0:09:27.71,0:09:31.13,Default,,0,0,0,,Бұл ас үйде болды, сондықтан оны рұқсатсыз пайдалануға рұқсат етілді.
Dialogue: 0,0:09:31.67,0:09:32.88,Default,,0,0,0,,Бұл жоғары сапалы зат.
Dialogue: 0,0:09:32.96,0:09:33.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:33.92,0:09:36.30,Default,,0,0,0,,Қажы! сен сонда бардың
Dialogue: 0,0:09:36.84,0:09:37.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:37.84,0:09:39.84,Default,,0,0,0,,Қыздың алдында, солай ма?
Dialogue: 0,0:09:39.97,0:09:41.26,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:09:41.35,0:09:43.26,Default,,0,0,0,,Жақсы емес нәрсе жақсы емес!
Dialogue: 0,0:09:43.97,0:09:46.48,Default,,0,0,0,,Күрсін... (Соня) Ухухуху
Dialogue: 0,0:09:46.98,0:09:48.02,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:09:48.10,0:09:48.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:56.40,0:09:58.07,Default,,0,0,0,,Бұл сенің әкеңнің кітабы.
Dialogue: 0,0:09:58.99,0:10:00.16,Default,,0,0,0,,Ғалым?
Dialogue: 0,0:10:00.24,0:10:01.07,Default,,0,0,0,,Иә
Dialogue: 0,0:10:01.16,0:10:04.62,Default,,0,0,0,,Мен жыл бойы үйде болдым, тек зерттеумен айналыстым.
Dialogue: 0,0:10:04.95,0:10:06.12,Default,,0,0,0,,Қандай зерттеу?
Dialogue: 0,0:10:07.29,0:10:09.62,Default,,0,0,0,,Адамды жарату
Dialogue: 0,0:10:29.67,0:10:31.72,Default,,0,0,0,,Григорий Ефимович
Dialogue: 0,0:10:32.59,0:10:33.97,Default,,0,0,0,,(шу)
Dialogue: 0,0:10:34.05,0:10:34.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:45.98,0:10:46.86,Default,,0,0,0,,Григорий!
Dialogue: 0,0:11:06.25,0:11:07.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:09.26,0:11:10.13,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:14.80,0:11:16.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:19.27,0:11:20.52,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:11:23.56,0:11:26.61,Default,,0,0,0,,Ах! Бүгін де ауа райы жақсы
Dialogue: 0,0:11:26.94,0:11:27.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:28.52,0:11:30.24,Default,,0,0,0,,Сәлем Сайо-сан
Dialogue: 0,0:11:30.65,0:11:32.20,Default,,0,0,0,,Сая жақсы.
Dialogue: 0,0:11:32.28,0:11:35.07,Default,,0,0,0,,Сайо, менімен осында тұрғың келе ме?
Dialogue: 0,0:11:35.16,0:11:35.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:36.41,0:11:37.91,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:11:37.99,0:11:40.25,Default,,0,0,0,,Бірақ Саямен бірге бола аламыз.
Dialogue: 0,0:11:40.33,0:11:43.04,Default,,0,0,0,,Мен бірге өмір сүретінімізге сенімдімін.
Dialogue: 0,0:11:43.12,0:11:45.08,Default,,0,0,0,,Мен әйтеуір соған тартылдым.
Dialogue: 0,0:11:45.46,0:11:46.79,Default,,0,0,0,,Не...
Dialogue: 0,0:11:47.09,0:11:48.46,Default,,0,0,0,,Сонымен
Dialogue: 0,0:11:49.05,0:11:49.88,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:51.09,0:11:54.38,Default,,0,0,0,,Жалғыз болсаңыз, ауылда адамдар бар ғой, солай ма?
Dialogue: 0,0:11:54.88,0:11:56.80,Default,,0,0,0,,Ауыл тұрғындары жоқ
Dialogue: 0,0:11:56.93,0:11:59.14,Default,,0,0,0,,Мені жек көреді
Dialogue: 0,0:11:59.43,0:12:00.85,Default,,0,0,0,,Сіз тым көп ойлайсыз ба?
Dialogue: 0,0:12:03.89,0:12:07.40,Default,,0,0,0,,Мұндағылар бізді жек көреді.
Dialogue: 0,0:12:07.48,0:12:09.23,Default,,0,0,0,,Біздің зерттеуіміз
Dialogue: 0,0:12:09.32,0:12:12.57,Default,,0,0,0,,Ауыл адамдарына шайтанның зерттеуі сияқты көрінсе керек.
Dialogue: 0,0:12:16.66,0:12:19.12,Default,,0,0,0,,Адамның адамды жаратуында қандай қате бар?
Dialogue: 0,0:12:19.20,0:12:22.00,Default,,0,0,0,,Адамдар бидайды суыққа төзімді ету үшін жақсартады.
Dialogue: 0,0:12:22.58,0:12:25.46,Default,,0,0,0,,Ет пен сүтті көбірек алу үшін мал шаруашылығын жақсарту
Dialogue: 0,0:12:25.54,0:12:28.00,Default,,0,0,0,,Біз оларды жұмыртқа шығаратын малға айналдырдық.
Dialogue: 0,0:12:28.08,0:12:30.50,Default,,0,0,0,,Жылқылар жүйрік, ал иттер мойынсұнғыш!
Dialogue: 0,0:12:30.88,0:12:34.84,Default,,0,0,0,,Маған Құдайдың патшалығына кіруге және одан асып кетуге рұқсат етілсе де.
Dialogue: 0,0:12:34.92,0:12:36.22,Default,,0,0,0,,Адамдар адамдардан артық
Dialogue: 0,0:12:36.30,0:12:38.80,Default,,0,0,0,,Оның үстіне Құдайдан да асып түсесің.
Dialogue: 0,0:12:39.55,0:12:40.39,Default,,0,0,0,,​​Не үшін?
Dialogue: 0,0:12:40.72,0:12:41.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:41.64,0:12:44.85,Default,,0,0,0,,Жаратылған ештеңені қаламайды.
Dialogue: 0,0:12:45.31,0:12:46.73,Default,,0,0,0,,Сіз шынымен қалайсыз...
Dialogue: 0,0:12:50.32,0:12:51.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:51.82,0:12:53.78,Default,,0,0,0,,Кешіріңіз, бұл ештеңе емес.
Dialogue: 0,0:12:54.32,0:12:56.24,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:12:56.90,0:12:58.82,Default,,0,0,0,,Әй, қарның аш па?
Dialogue: 0,0:12:59.49,0:13:00.78,Default,,0,0,0,,Бұл Шехер астрономиялық басқармасы—
Dialogue: 0,0:13:00.87,0:13:02.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:02.79,0:13:04.58,Default,,0,0,0,,Уау! Жарайды
Dialogue: 0,0:13:04.66,0:13:06.62,Default,,0,0,0,,Мен саған таңғы ас дайындаймын.
Dialogue: 0,0:13:09.33,0:13:11.09,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:13:16.47,0:13:18.05,Default,,0,0,0,,Ш… Шынында да.
Dialogue: 0,0:13:34.53,0:13:35.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.07,0:13:38.03,Default,,0,0,0,,Неге бұлай істедің...
Dialogue: 0,0:13:39.41,0:13:42.78,Default,,0,0,0,,Бұл әйел шайтан! Бұл құбыжық!
Dialogue: 0,0:13:43.87,0:13:45.20,Default,,0,0,0,,Мен көрдім
Dialogue: 0,0:13:45.29,0:13:48.71,Default,,0,0,0,,Бұл әйел ауыл тұрғындарының қанын жұтады!
Dialogue: 0,0:13:48.79,0:13:49.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:52.67,0:13:55.30,Default,,0,0,0,,(Джозеф) Бір, екі. (Абдул) Бір, екі.
Dialogue: 0,0:14:08.73,0:14:10.35,Default,,0,0,0,,Дәмі жер сияқты
Dialogue: 0,0:14:11.90,0:14:12.94,Default,,0,0,0,,Сен оны білесің бе?
Dialogue: 0,0:14:13.02,0:14:16.23,Default,,0,0,0,,Қалада тұратын адамдар ақшаның иісін сезеді.
Dialogue: 0,0:14:16.32,0:14:18.40,Default,,0,0,0,,Асылдар шараптың дәмін татады
Dialogue: 0,0:14:19.57,0:14:20.41,Default,,0,0,0,,Хироман?
Dialogue: 0,0:14:21.03,0:14:23.74,Default,,0,0,0,,Балалар, мені осылай атайсыңдар.
Dialogue: 0,0:14:23.83,0:14:25.79,Default,,0,0,0,,Бірақ сіз түсінбедіңіз бе?
Dialogue: 0,0:14:26.41,0:14:28.62,Default,,0,0,0,,Мен сені кездестіргеннен бері
Dialogue: 0,0:14:28.96,0:14:29.96,Default,,0,0,0,,Білсем де
Dialogue: 0,0:14:30.75,0:14:31.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:34.42,0:14:38.55,Default,,0,0,0,,Мен мұндай нәрсеге сүйенбесем, мен бір қоянды көтере алмаймын.
Dialogue: 0,0:14:38.63,0:14:41.13,Default,,0,0,0,,Қандай қызық жаратылыс.
Dialogue: 0,0:14:41.93,0:14:46.51,Default,,0,0,0,,Уақыттың өтуі және қоршаған орта аңдарға азу тістер мен тырнақтар береді.
Dialogue: 0,0:14:46.93,0:14:49.31,Default,,0,0,0,,Гүлге тікен бердім
Dialogue: 0,0:14:49.85,0:14:52.77,Default,,0,0,0,,Бірақ адамдар одан өз еркімен бас тартты.
Dialogue: 0,0:14:52.85,0:14:56.40,Default,,0,0,0,,Табиғатпен серуендеуден бас тарттым.
Dialogue: 0,0:14:56.48,0:14:59.28,Default,,0,0,0,,Ал сіз оның орнына не алдым деп ойлайсыз?
Dialogue: 0,0:15:03.20,0:15:04.03,Default,,0,0,0,,Сая!
Dialogue: 0,0:15:08.49,0:15:09.50,Default,,0,0,0,,Соня!
Dialogue: 0,0:15:13.08,0:15:14.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:15.29,0:15:16.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:20.97,0:15:25.47,Default,,0,0,0,,Соняның әкесі Юрий Грегориге зерттеу жұмыстарына көмектесуде.
Dialogue: 0,0:15:25.55,0:15:29.81,Default,,0,0,0,,1916 жылы Григорий өлтірілгеннен кейін
Dialogue: 0,0:15:29.89,0:15:31.81,Default,,0,0,0,,Мен осы ауылға қайтып келдім.
Dialogue: 0,0:15:32.14,0:15:34.10,Default,,0,0,0,,Сол кезде Соня қазірдің өзінде...
Dialogue: 0,0:15:34.77,0:15:36.90,Default,,0,0,0,,Бұл Григорий болды.
Dialogue: 0,0:15:37.23,0:15:38.07,Default,,0,0,0,,Иә
Dialogue: 0,0:15:38.15,0:15:39.44,Default,,0,0,0,,Соняға еріңіз
Dialogue: 0,0:15:39.53,0:15:42.28,Default,,0,0,0,,Бұдан басқа Анастасия болуы мүмкін.
Dialogue: 0,0:15:42.99,0:15:43.91,Default,,0,0,0,,Сая
Dialogue: 0,0:15:44.70,0:15:45.99,Default,,0,0,0,,Иә, бар.
Dialogue: 0,0:16:27.16,0:16:29.53,Default,,0,0,0,,Григорий, қазір жабыңыз.
Dialogue: 0,0:16:29.78,0:16:31.79,Default,,0,0,0,,Дива ұйықтағысы келеді
Dialogue: 0,0:16:32.45,0:16:35.04,Default,,0,0,0,,Үлкен аға Әншел
Dialogue: 0,0:16:35.29,0:16:38.17,Default,,0,0,0,,Сізге шабуыл жасап, Даеваны көздеген аңшы
Dialogue: 0,0:16:38.25,0:16:40.25,Default,,0,0,0,,Сая дәл менің алдымда.
Dialogue: 0,0:16:40.42,0:16:43.34,Default,,0,0,0,,Диваны барлық кедергілерден қорғау
Dialogue: 0,0:16:43.42,0:16:45.59,Default,,0,0,0,,Шевальерлердің тағдыры солай ма?
Dialogue: 0,0:16:46.51,0:16:47.93,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:50.64,0:16:51.47,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:16:53.81,0:16:55.81,Default,,0,0,0,,Ха! (Соня) Уууу
Dialogue: 0,0:17:01.82,0:17:02.98,Default,,0,0,0,,Сая!
Dialogue: 0,0:17:03.90,0:17:04.78,Default,,0,0,0,,Уф
Dialogue: 0,0:17:08.57,0:17:11.24,Default,,0,0,0,,Сая мен сені осы жерден тоқтатамын.
Dialogue: 0,0:17:11.87,0:17:12.99,Default,,0,0,0,,Соня…
Dialogue: 0,0:17:13.08,0:17:14.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:14.08,0:17:16.83,Default,,0,0,0,,Григорий Ефимович Распутин
Dialogue: 0,0:17:17.33,0:17:18.33,Default,,0,0,0,,Фуфу
Dialogue: 0,0:17:18.88,0:17:19.75,Default,,0,0,0,,Ол жай ғана біреудің оны кешіруін қалады ғой, иә?
Dialogue: 0,0:17:19.88,0:17:20.84,Default,,0,0,0,,Кесу!
Dialogue: 0,0:17:21.09,0:17:22.46,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:22.55,0:17:23.38,Default,,0,0,0,,Сіздермен бірге
Dialogue: 0,0:17:23.46,0:17:25.59,Default,,0,0,0,,Мен достасамыз деп ойладым.
Dialogue: 0,0:17:25.67,0:17:27.09,Default,,0,0,0,,Минерва біз үшін осындай қауіпсіз орын дайындап қойған еді
Dialogue: 0,0:17:45.94,0:17:47.03,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:53.66,0:17:54.54,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:18:04.09,0:18:07.51,Default,,0,0,0,,Өкінішке орай, Дива ұйықтап жатыр.
Dialogue: 0,0:18:07.59,0:18:11.22,Default,,0,0,0,,Мен сенің аяғыңды аламын, сен мені қуа алма
Dialogue: 0,0:18:11.30,0:18:12.14,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:17.48,0:18:18.31,Default,,0,0,0,,Уф
Dialogue: 0,0:18:26.61,0:18:27.53,Default,,0,0,0,,Қажы!
Dialogue: 0,0:18:27.61,0:18:28.65,Default,,0,0,0,,Сая! Қазір!
Dialogue: 0,0:18:38.16,0:18:40.08,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,0:18:41.42,0:18:43.46,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:09.44,0:19:10.28,Default,,0,0,0,,Сая!
Dialogue: 0,0:19:11.65,0:19:14.66,Default,,0,0,0,,Мен қатты ұйықтаймын...
Dialogue: 0,0:19:15.66,0:19:18.04,Default,,0,0,0,,Қажы – ауыр жара
Dialogue: 0,0:19:18.54,0:19:20.41,Default,,0,0,0,,Жақында жабылады
Dialogue: 0,0:19:21.25,0:19:23.21,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:19:24.63,0:19:26.29,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:19:28.38,0:19:29.59,Default,,0,0,0,,Сая...
Dialogue: 0,0:19:32.47,0:19:33.80,Default,,0,0,0,,Ах! Құдай-ай!
Dialogue: 0,0:19:34.22,0:19:37.14,Default,,0,0,0,,Мен енді көзімді аша алмаймын
Dialogue: 0,0:19:38.97,0:19:41.27,Default,,0,0,0,,Сол кездегідей
Dialogue: 0,0:19:41.35,0:19:45.02,Default,,0,0,0,,Ұзақ ұйқы келер ме екен
Dialogue: 0,0:19:46.73,0:19:48.23,Default,,0,0,0,,Күту
Dialogue: 0,0:19:48.98,0:19:50.19,Default,,0,0,0,,Иә
Dialogue: 0,0:19:52.11,0:19:55.28,Default,,0,0,0,,Уәде есіңізде ме?
Dialogue: 0,0:19:55.87,0:19:57.07,Default,,0,0,0,,Иә
Dialogue: 0,0:19:58.12,0:20:01.75,Default,,0,0,0,,Егер мен Даеваны ауласам...
Dialogue: 0,0:20:03.83,0:20:06.17,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:20:08.34,0:20:11.01,Default,,0,0,0,,Мен сені әрқашан бақылап отырамын
Dialogue: 0,0:20:11.09,0:20:15.47,Default,,0,0,0,,Басқа нәрсеге өзгерген болсаңыз да
Dialogue: 0,0:20:15.55,0:20:19.35,Default,,0,0,0,,Мен сенен бөлек кетсем де
Dialogue: 0,0:20:19.43,0:20:22.89,Default,,0,0,0,,Мен сені міндетті түрде табамын
Dialogue: 0,0:20:23.02,0:20:24.10,Default,,0,0,0,,Сонымен
Dialogue: 0,0:20:25.06,0:20:26.90,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:20:28.36,0:20:29.57,Default,,0,0,0,,Сая
Dialogue: 0,0:20:46.37,0:20:47.46,Default,,0,0,0,,Сая
Dialogue: 0,0:20:47.96,0:20:49.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:49.88,0:20:51.34,Default,,0,0,0,,Қажы
Dialogue: 0,0:20:51.42,0:20:52.80,Default,,0,0,0,,Сіз қозғала аласыз ба?
Dialogue: 0,0:20:58.72,0:20:59.85,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:21:00.30,0:21:01.47,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:21:03.64,0:21:04.98,Default,,0,0,0,,Қажы да күледі.
Dialogue: 0,0:21:05.64,0:21:06.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:07.19,0:21:08.77,Default,,0,0,0,,Мен түс көрдім
Dialogue: 0,0:21:09.73,0:21:11.86,Default,,0,0,0,,Сіздің күлімсіреген арманыңыз
Dialogue: 0,0:21:11.94,0:21:15.78,Default,,0,0,0,,Менің саған уәдем бар еді.
Dialogue: 0,0:21:16.24,0:21:17.78,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,0:21:18.41,0:21:19.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:19.53,0:21:20.74,Default,,0,0,0,,Секір!!
Dialogue: 0,0:21:20.83,0:21:23.37,Default,,0,0,0,,Мен саған қандай уәде бердім?
Dialogue: 0,0:21:24.37,0:21:26.79,Default,,0,0,0,,Уақыты келгенде білетін боламыз.
Dialogue: 0,0:21:35.05,0:21:36.59,Default,,0,0,0,,Сайо-ни-чан!
Dialogue: 0,0:21:36.67,0:21:37.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:37.88,0:21:40.26,Default,,0,0,0,,Сайо-ничан, жақсысың ба?
Dialogue: 0,0:21:43.18,0:21:45.43,Default,,0,0,0,,Иә! Уайымдама!
Dialogue: 0,0:21:45.85,0:21:46.81,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:21:54.86,0:22:00.87,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:23.78,0:23:29.79,Default,,0,0,0,,~♪
Dialogue: 0,0:23:32.58,0:23:34.50,Default,,0,0,0,,Сая да, Рику да аман қалды.
Dialogue: 0,0:23:34.58,0:23:37.67,Default,,0,0,0,,Олар ертең Екатеринбургке жетеді.
Dialogue: 0,0:23:37.92,0:23:39.71,Default,,0,0,0,,Бірақ Давидтің бейбақ
Dialogue: 0,0:23:39.88,0:23:42.47,Default,,0,0,0,,Тедті табу үшін мені күштеп шығарып сал
Dialogue: 0,0:23:42.59,0:23:45.84,Default,,0,0,0,,Алайда, мен қиылған әріптерді қалпына келтіруге мәжбүр болдым.
Dialogue: 0,0:23:45.93,0:23:48.06,Default,,0,0,0,,Сіз мінген көлікті бақылаңыз.
Dialogue: 0,0:23:48.43,0:23:51.35,Default,,0,0,0,,Бұл жігіт маған бала сияқты қарайды.
Dialogue: 0,0:23:52.10,0:23:53.69,Default,,0,0,0,,Келесі жолы «Blood Plus»
Dialogue: 0,0:23:54.10,0:23:55.77,Default,,0,0,0,,«Екатеринбург айы»
Dialogue: 0,0:23:56.40,0:23:58.82,Default,,0,0,0,,Жүр, мені таны!
Dialogue: 0,0:24:00.32,0:24:06.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory