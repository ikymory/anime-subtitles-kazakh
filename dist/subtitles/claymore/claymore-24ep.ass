Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Сол қыранды аз уақыттың ішінде өзіңдікі қылдың ба?
Dialogue: 0,0:00:06.03,0:00:07.07,Default,,0,0,0,,Керемет
Dialogue: 0,0:00:14.06,0:00:15.06,Default,,0,0,0,,Ригалдо
Dialogue: 0,0:00:16.01,0:00:17.03,Default,,0,0,0,,(Әйелдің айғайы)
Dialogue: 0,0:02:03.08,0:02:06.01,Default,,0,0,0,,жасадыңыз
Dialogue: 0,0:02:07.04,0:02:08.05,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:02:10.02,0:02:11.03,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:02:15.03,0:02:18.00,Default,,0,0,0,,Жарайсың Денев Милия
Dialogue: 0,0:02:18.00,0:02:19.08,Default,,0,0,0,,Клэр мұны жасады
Dialogue: 0,0:02:20.05,0:02:24.01,Default,,0,0,0,,Мені әрқашан таң қалдырады
Dialogue: 0,0:02:25.04,0:02:27.05,Default,,0,0,0,,Әпке, қазір бәрі жақсы.
Dialogue: 0,0:02:27.09,0:02:30.04,Default,,0,0,0,,Сіз ұйықтап жатқанда емес.
Dialogue: 0,0:02:33.01,0:02:34.06,Default,,0,0,0,,Бәріңе
Dialogue: 0,0:02:34.06,0:02:37.00,Default,,0,0,0,,Клэр арыстан жігітті жеңді.
Dialogue: 0,0:02:37.06,0:02:38.07,Default,,0,0,0,,Хоша
Dialogue: 0,0:02:38.07,0:02:40.02,Default,,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:02:44.09,0:02:45.07,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:03:01.01,0:03:04.04,Default,,0,0,0,,Сол күміс көзді арыстан патшаны жеңу
Dialogue: 0,0:03:05.01,0:03:06.08,Default,,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:03:11.00,0:03:12.00,Default,,0,0,0,,Прискила
Dialogue: 0,0:03:12.09,0:03:14.00,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:27.04,0:03:30.01,Default,,0,0,0,,Ол мүлде мазасыз бала.
Dialogue: 0,0:03:39.08,0:03:41.03,Default,,0,0,0,,Клэр, жеткілікті.
Dialogue: 0,0:03:41.03,0:03:42.04,Default,,0,0,0,,Ұстаңыз
Dialogue: 0,0:03:47.06,0:03:48.06,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:49.00,0:03:51.06,Default,,0,0,0,,Маған жақындама
Dialogue: 0,0:03:52.08,0:03:58.02,Default,,0,0,0,,Бұл дене енді менің санамда емес.
Dialogue: 0,0:03:58.08,0:03:59.07,Default,,0,0,0,,Клэр
Dialogue: 0,0:04:00.06,0:04:01.05,Default,,0,0,0,,Хелен
Dialogue: 0,0:04:02.07,0:04:04.09,Default,,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:04:07.02,0:04:10.08,Default,,0,0,0,,Менің басымды кес
Dialogue: 0,0:04:12.09,0:04:18.04,Default,,0,0,0,,Дененің оянуы оны тоқтатуға болмайтын дәрежеге жетті.
Dialogue: 0,0:04:18.08,0:04:21.08,Default,,0,0,0,,Мен енді қайтып бара алмаймын.
Dialogue: 0,0:04:22.02,0:04:25.06,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:04:26.00,0:04:30.04,Default,,0,0,0,,Соңғы күшіммен қылыштың қозғалуын тоқтатамын.
Dialogue: 0,0:04:31.01,0:04:35.01,Default,,0,0,0,,Осы арада менің басымды кесіп алсаңыз екен деймін.
Dialogue: 0,0:04:36.08,0:04:38.06,Default,,0,0,0,,Клэр
Dialogue: 0,0:04:39.01,0:04:40.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:41.04,0:04:43.03,Default,,0,0,0,,Біреуді ұнамсыз рөлге айналдыру
Dialogue: 0,0:04:43.03,0:04:44.07,Default,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:04:44.07,0:04:48.04,Default,,0,0,0,,Оның толық оянатыны әлі шешілген жоқ деп ойлаймын.
Dialogue: 0,0:04:49.01,0:04:50.04,Default,,0,0,0,,Хеленнен сұраңыз
Dialogue: 0,0:04:51.01,0:04:53.00,Default,,0,0,0,,бірақ мұнда қатты шу, иә?
Dialogue: 0,0:04:53.00,0:04:54.01,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:04:54.01,0:04:56.09,Default,,0,0,0,,Өздігінен бас тартпа.
Dialogue: 0,0:04:57.05,0:05:03.03,Default,,0,0,0,,Артқа қайта алмайтыныңды өзің ғана білесің.
Dialogue: 0,0:05:10.03,0:05:11.02,Default,,0,0,0,,Клэр
Dialogue: 0,0:06:26.03,0:06:27.07,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:06:59.06,0:07:00.01,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:07:06.05,0:07:08.02,Default,,0,0,0,,Көңілсіз болмаңыз
Dialogue: 0,0:07:08.02,0:07:12.03,Default,,0,0,0,,Артыңнан ермегенімізде басың түсіп қалар еді.
Dialogue: 0,0:07:12.08,0:07:14.09,Default,,0,0,0,,Сізде бар күшпен
Dialogue: 0,0:07:14.09,0:07:17.05,Default,,0,0,0,,Терезаны өлтіру туралы ойланыңыз.
Dialogue: 0,0:07:25.06,0:07:26.06,Default,,0,0,0,,Тереза
Dialogue: 0,0:07:28.05,0:07:30.08,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:07:42.01,0:07:43.03,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:07:48.09,0:07:52.02,Default,,0,0,0,,Ол сондай мейірімді әке еді.
Dialogue: 0,0:07:53.01,0:07:55.09,Default,,0,0,0,,Әкемді жақсы көрсем де
Dialogue: 0,0:07:56.03,0:07:58.00,Default,,0,0,0,,Мен оны жедім.
Dialogue: 0,0:07:59.03,0:08:02.00,Default,,0,0,0,,Менің алдымда
Dialogue: 0,0:08:02.00,0:08:06.09,Default,,0,0,0,,Барлығының ішкі мүшелерін жедім.
Dialogue: 0,0:08:08.00,0:08:11.00,Default,,0,0,0,,Сондықтан мен оны өлтірдім.
Dialogue: 0,0:08:11.00,0:08:13.07,Default,,0,0,0,,Әпкемді жеп жатқанда
Dialogue: 0,0:08:13.07,0:08:18.06,Default,,0,0,0,,Мен әкемнің басын кесіп алдым
Dialogue: 0,0:08:20.03,0:08:21.09,Default,,0,0,0,,Қайтару жоқ
Dialogue: 0,0:08:22.07,0:08:24.06,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:08:25.03,0:08:27.02,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:08:27.04,0:08:34.03,Default,,0,0,0,,Менің қолымнан келетіні – жынға айналмай тұрып, басыңды кесіп тастау.
Dialogue: 0,0:08:37.08,0:08:40.03,Default,,0,0,0,,Жоқ, бұл мен емес.
Dialogue: 0,0:08:41.00,0:08:42.02,Default,,0,0,0,,Мен емес
Dialogue: 0,0:08:47.08,0:08:49.03,Default,,0,0,0,,Не?
Dialogue: 0,0:08:49.09,0:08:53.08,Default,,0,0,0,,Ешқашан ештеңені ұстап тұрудың қажеті болмады.
Dialogue: 0,0:08:54.07,0:08:59.09,Default,,0,0,0,,Оның соншалықты жақсы болғанына сене алар емеспін
Dialogue: 0,0:09:06.03,0:09:10.02,Default,,0,0,0,,Мен сенің әпкеңді қалаймын
Dialogue: 0,0:09:10.02,0:09:12.01,Default,,0,0,0,,Папаның жауы
Dialogue: 0,0:09:30.00,0:09:32.03,Default,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:09:45.01,0:09:46.02,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:09:48.00,0:09:49.03,Default,,0,0,0,,Біз ойлағаннан ертерек кездесе аламыз.
Dialogue: 0,0:09:50.06,0:09:52.03,Default,,0,0,0,,Оның арқасында
Dialogue: 0,0:10:01.02,0:10:02.03,Default,,0,0,0,,Клэр
Dialogue: 0,0:10:02.07,0:10:04.05,Default,,0,0,0,,Хеленнен сұраңыз
Dialogue: 0,0:10:06.06,0:10:10.05,Default,,0,0,0,,Өтінемін, адамдық сана-сезім бұзылмай өлуге рұқсат етіңіз.
Dialogue: 0,0:10:16.07,0:10:17.06,Default,,0,0,0,,Раки
Dialogue: 0,0:10:18.01,0:10:20.01,Default,,0,0,0,,Уәдесінде тұрмады
Dialogue: 0,0:10:21.02,0:10:24.04,Default,,0,0,0,,Мен сені қайта көргім келді
Dialogue: 0,0:10:34.06,0:10:36.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:10:42.02,0:10:43.06,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:10:43.06,0:10:45.08,Default,,0,0,0,,Сізге осылай еліктеп көрейін
Dialogue: 0,0:10:46.09,0:10:47.07,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:48.03,0:10:50.05,Default,,0,0,0,,Мен сені ешқашан кешірмеймін
Dialogue: 0,0:10:51.02,0:10:54.04,Default,,0,0,0,,Кешіріңіз, Хелен
Dialogue: 0,0:10:58.01,0:11:00.01,Default,,0,0,0,,Жоқ, Хелен.
Dialogue: 0,0:11:00.06,0:11:01.09,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:11:11.02,0:11:12.04,Default,,0,0,0,,Не?
Dialogue: 0,0:11:16.04,0:11:18.06,Default,,0,0,0,,Сен шынымен де тамаша ФБР агенті болдың.
Dialogue: 0,0:11:37.05,0:11:38.04,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:39.02,0:11:42.07,Default,,0,0,0,,Қалай тірісің?
Dialogue: 0,0:11:44.03,0:11:48.09,Default,,0,0,0,,Мен оны сол кезде өлтіруім керек еді.
Dialogue: 0,0:11:50.00,0:11:51.07,Default,,0,0,0,,(Жануарлар дүкенінің қызметкері) Хмм… Таныс өсірушімнен сұрайын ба?
Dialogue: 0,0:11:52.01,0:11:54.03,Default,,0,0,0,,Ұйымға қарсы шыққанына қарамастан
Dialogue: 0,0:11:55.04,0:11:58.07,Default,,0,0,0,,Сен мені осылай сезіндірсең де
Dialogue: 0,0:12:05.09,0:12:07.02,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:12:07.09,0:12:09.02,Default,,0,0,0,,Біз ойлағаннан ертерек кездесе аламыз.
Dialogue: 0,0:12:09.05,0:12:12.08,Default,,0,0,0,,Сондықтан мен сені тағы да өлтіремін.
Dialogue: 0,0:12:12.08,0:12:14.04,Default,,0,0,0,,Сол кездегідей
Dialogue: 0,0:12:20.03,0:12:21.06,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:12:22.02,0:12:23.06,Default,,0,0,0,,Тек сен
Dialogue: 0,0:12:24.02,0:12:27.04,Default,,0,0,0,,Кеше… Ах…
Dialogue: 0,0:12:41.04,0:12:42.05,Default,,0,0,0,,Клэр
Dialogue: 0,0:13:03.00,0:13:04.05,Default,,0,0,0,,Өтінемін, Ятоны құтқарыңдар!
Dialogue: 0,0:13:06.06,0:13:08.02,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:13:10.00,0:13:11.07,Default,,0,0,0,,Бұл жағдай
Dialogue: 0,0:13:12.01,0:13:14.00,Default,,0,0,0,,Бізде жұмыс күші жетіспейді.
Dialogue: 0,0:13:14.09,0:13:16.09,Default,,0,0,0,,Бағыну отряды деп те аталады.
Dialogue: 0,0:13:17.03,0:13:19.02,Default,,0,0,0,,Солтүстікке қарай жүріңіз
Dialogue: 0,0:13:20.03,0:13:24.05,Default,,0,0,0,,Сіздің жұмысыңыз барлау ғана.
Dialogue: 0,0:13:26.01,0:13:29.07,Default,,0,0,0,,Басқа кез келген нәрсе ұйымға опасыздық болып саналады.
Dialogue: 0,0:13:30.09,0:13:32.08,Default,,0,0,0,,Сіз оянған сияқтысыз.
Dialogue: 0,0:13:33.07,0:13:36.04,Default,,0,0,0,,Менің ойымша, біреу біледі.
Dialogue: 0,0:13:37.05,0:13:42.04,Default,,0,0,0,,Мұны тек сіз түсіне аласыз.
Dialogue: 0,0:13:49.04,0:13:52.02,Default,,0,0,0,,Прискила сіздің де есіңізде ме?
Dialogue: 0,0:13:53.06,0:13:57.01,Default,,0,0,0,,Бүгінде көп нәрсе болып жатыр.
Dialogue: 0,0:13:59.00,0:14:00.04,Default,,0,0,0,,«Шағып алған» деген сөзді әдемі айтыпсың, иә?
Dialogue: 0,0:14:01.00,0:14:02.02,Default,,0,0,0,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:14:15.02,0:14:17.00,Default,,0,0,0,,Мұны істеудің қажеті жоқ.
Dialogue: 0,0:14:17.06,0:14:20.07,Default,,0,0,0,,Мен қазірдің өзінде көңілді болдым.
Dialogue: 0,0:14:22.04,0:14:24.04,Default,,0,0,0,,Рұқсатсыз өлмейсің.
Dialogue: 0,0:14:24.09,0:14:27.09,Default,,0,0,0,,Маған тағы біраз қарап көрейін.
Dialogue: 0,0:14:33.05,0:14:37.02,Default,,0,0,0,,Синтия мен Табита жарақат алған серіктерімен бірге сеніп тапсырылды.
Dialogue: 0,0:14:37.09,0:14:38.08,Default,,0,0,0,,Клэр
Dialogue: 0,0:14:40.00,0:14:42.04,Default,,0,0,0,,Менің жын іздеуден басқа амалым жоқ шығар.
Dialogue: 0,0:14:43.00,0:14:47.03,Default,,0,0,0,,Бұл қиын тапсырма, бірақ басқа амал жоқ.
Dialogue: 0,0:14:49.04,0:14:51.08,Default,,0,0,0,,Сіз Клэрді қуып жете аламын деп ойлайсыз ба?
Dialogue: 0,0:14:53.07,0:14:56.02,Default,,0,0,0,,Қиын десем ше?
Dialogue: 0,0:14:56.04,0:14:57.06,Default,,0,0,0,,Мені жалғыз қалдырмаңыз
Dialogue: 0,0:14:57.06,0:14:59.09,Default,,0,0,0,,Клэрді кез келген жағдайда табыңыз
Dialogue: 0,0:15:04.00,0:15:07.04,Default,,0,0,0,,Ол да солай ойласа керек.
Dialogue: 0,0:15:13.07,0:15:18.04,Default,,0,0,0,,Қабір маркеріне досымның бір қылышы жетеді.
Dialogue: 0,0:15:20.02,0:15:21.06,Default,,0,0,0,,Капитан Ундин
Dialogue: 0,0:15:24.02,0:15:27.01,Default,,0,0,0,,Кешіріңіз, бірақ мен сізді аламын.
Dialogue: 0,0:15:33.00,0:15:34.04,Default,,0,0,0,,Бұл сіздікі ме?
Dialogue: 0,0:15:47.03,0:15:48.07,Default,,0,0,0,,Хелен, кеттік.
Dialogue: 0,0:15:51.06,0:15:53.04,Default,,0,0,0,,Ол енді келмейді.
Dialogue: 0,0:16:06.05,0:16:08.07,Default,,0,0,0,,Осыған сенімдісіз бе?
Dialogue: 0,0:16:09.02,0:16:10.00,Default,,0,0,0,,О
Dialogue: 0,0:16:10.05,0:16:11.06,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:16:12.01,0:16:12.51,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:16:14.00,0:16:15.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:16:16.00,0:16:18.02,Default,,0,0,0,,Елес үзік-үзік.
Dialogue: 0,0:16:18.07,0:16:20.03,Default,,0,0,0,,Қарлы боранның салдарынан ба?
Dialogue: 0,0:16:20.03,0:16:22.03,Default,,0,0,0,,Немесе қазірдің өзінде
Dialogue: 0,0:16:24.02,0:16:25.02,Default,,0,0,0,,Яғни
Dialogue: 0,0:16:27.00,0:16:30.00,Default,,0,0,0,,№3 Галатея
Dialogue: 0,0:16:32.04,0:16:37.01,Default,,0,0,0,,Менің ойымша, сендер ондай қулық жасай алмайсыңдар.
Dialogue: 0,0:16:37.07,0:16:39.05,Default,,0,0,0,,Біздің барлаушы?
Dialogue: 0,0:16:40.04,0:16:41.09,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:16:43.07,0:16:48.02,Default,,0,0,0,,Кешіріңіз, бірақ мен Клэрді табу үшін қолдан келгеннің бәрін жасаймын.
Dialogue: 0,0:16:51.08,0:16:52.09,Default,,0,0,0,,Хо
Dialogue: 0,0:16:53.02,0:16:56.06,Default,,0,0,0,,Сіз осында өлуді жоспарлап отырған сияқтысыз.
Dialogue: 0,0:17:06.00,0:17:08.02,Default,,0,0,0,,Уақытты тиімді пайдаланыңыз
Dialogue: 0,0:17:14.06,0:17:17.04,Default,,0,0,0,,Ол оңай жеңілетін қарсылас емес.
Dialogue: 0,0:17:20.03,0:17:21.06,Default,,0,0,0,,Галатея
Dialogue: 0,0:17:25.06,0:17:27.00,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:17:27.09,0:17:32.02,Default,,0,0,0,,Мен ғана басқа адамды Йокимен өлшей аламын.
Dialogue: 0,0:17:32.08,0:17:34.06,Default,,0,0,0,,Жоқ, Мирия
Dialogue: 0,0:17:35.01,0:17:38.01,Default,,0,0,0,,Клэр оны жеңе ала ма?
Dialogue: 0,0:17:38.04,0:17:40.01,Default,,0,0,0,,Саана
Dialogue: 0,0:17:40.01,0:17:42.08,Default,,0,0,0,,Бірақ бұл өте қиын.
Dialogue: 0,0:17:42.08,0:17:43.09,Default,,0,0,0,,Екінші тарап
Dialogue: 0,0:17:43.09,0:17:45.07,Default,,0,0,0,,Екінші тарап кім?
Dialogue: 0,0:17:47.02,0:17:48.08,Default,,0,0,0,,Менің атым Присцилла
Dialogue: 0,0:17:50.01,0:17:56.05,Default,,0,0,0,,Ол бір кездері ең күшті деп аталып кеткен №1 `` Күлімсіреу Терезасын '' өлтірген әйел.
Dialogue: 0,0:17:57.06,0:17:58.07,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:17:59.05,0:18:00.04,Default,,0,0,0,,Тездетіңіз
Dialogue: 0,0:18:00.08,0:18:02.07,Default,,0,0,0,,Мені құтқарғың келсе.
Dialogue: 0,0:18:04.09,0:18:07.09,Default,,0,0,0,,Галатея Кешіріңіз.
Dialogue: 0,0:18:08.04,0:18:09.03,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:18:17.02,0:18:19.04,Default,,0,0,0,,Егер сізде керемет естеліктер болмаса
Dialogue: 0,0:18:19.04,0:18:21.02,Default,,0,0,0,,Басынан бастап жылама
Dialogue: 0,0:18:22.05,0:18:25.03,Default,,0,0,0,,Асықпасақ, Клэр өледі.
Dialogue: 0,0:18:26.01,0:18:27.09,Default,,0,0,0,,Бұл сөзсіз дұрыс
Dialogue: 0,0:18:29.08,0:18:31.07,Default,,0,0,0,,Өйткені, И
Dialogue: 0,0:18:32.04,0:18:33.09,Default,,0,0,0,,Бұл менің аузым ғана болды.
Dialogue: 0,0:18:36.00,0:18:37.09,Default,,0,0,0,,Маған талай рет көмектессең де.
Dialogue: 0,0:18:39.00,0:18:41.00,Default,,0,0,0,,Сен маған талай рет жақсы қарадың.
Dialogue: 0,0:18:41.06,0:18:43.06,Default,,0,0,0,,Мен ештеңе істей алмадым
Dialogue: 0,0:18:45.01,0:18:46.04,Default,,0,0,0,,Мен қорқып кеттім
Dialogue: 0,0:18:47.06,0:18:50.01,Default,,0,0,0,,Мен тек өз өмірімді ойладым
Dialogue: 0,0:18:51.08,0:18:53.03,Default,,0,0,0,,Менің өлгім келмеді
Dialogue: 0,0:18:55.02,0:18:56.07,Default,,0,0,0,,Мен ең нашармын
Dialogue: 0,0:18:59.03,0:19:00.06,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:19:03.07,0:19:05.03,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:19:05.03,0:19:07.07,Default,,0,0,0,,Не болса да
Dialogue: 0,0:19:09.09,0:19:10.07,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:12.04,0:19:15.03,Default,,0,0,0,,Себебі мен Клэрге көмектескім келеді.
Dialogue: 0,0:19:36.01,0:19:39.02,Default,,0,0,0,,I am I am
Dialogue: 0,0:19:46.04,0:19:47.04,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:20:18.02,0:20:19.03,Default,,0,0,0,,Клэр
Dialogue: 0,0:20:20.00,0:20:23.05,Default,,0,0,0,,Біз жеткенше өлмеңдер.
Dialogue: 0,0:21:03.02,0:21:07.00,Default,,0,0,0,,Маған қарап көрейін, Присцилла.
Dialogue: 0,0:21:10.00,0:21:11.03,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:21:13.00,0:21:14.06,Default,,0,0,0,,Тек сен
Dialogue: 0,0:21:15.08,0:21:19.07,Default,,0,0,0,,Ешқашан кешірме
Dialogue: 0,0:21:24.01,0:21:28.01,Default,,0,0,0,,Прискила
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Өткенмен өмір сүру
Dialogue: 0,0:22:42.03,0:22:43.08,Default,,0,0,0,,Өткенде өлу
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Талғампаз күлкі
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
