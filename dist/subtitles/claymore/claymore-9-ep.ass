Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.05,Default,,0,0,0,,Біз алғаш танысқан кезден бері
Dialogue: 0,0:00:08.07,0:00:10.05,Default,,0,0,0,,Оның көздері ауырды.
Dialogue: 0,0:00:14.03,0:00:17.00,Default,,0,0,0,,Қиындыққа, азапқа шыдай алмасаң
Dialogue: 0,0:00:17.04,0:00:19.01,Default,,0,0,0,,Айқайлады.
Dialogue: 0,0:00:33.07,0:00:35.02,Default,,0,0,0,,Ой
Dialogue: 0,0:00:35.02,0:00:35.52,Default,,0,0,0,,Не?
Dialogue: 0,0:00:36.07,0:00:37.04,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:00:42.00,0:00:44.09,Default,,0,0,0,,Мен Терезамен алғаш танысқан кезден бастап
Dialogue: 0,0:00:45.08,0:00:47.08,Default,,0,0,0,,Оның көзі менімен бірдей болатын.
Dialogue: 0,0:01:08.04,0:01:09.06,Default,,0,0,0,,Маған
Dialogue: 0,0:01:13.04,0:01:14.09,Default,,0,0,0,,Менің ішімде
Dialogue: 0,0:01:15.05,0:01:17.01,Default,,0,0,0,,Терезаның қаны мен еті
Dialogue: 0,0:02:38.07,0:02:42.03,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:02:42.03,0:02:45.06,Default,,0,0,0,,Бұлай қашудың қажеті жоқ.
Dialogue: 0,0:02:55.06,0:02:57.00,Default,,0,0,0,,Клеймор
Dialogue: 0,0:02:57.09,0:02:59.06,Default,,0,0,0,,Ол Трилло қаласынан.
Dialogue: 0,0:03:00.00,0:03:01.09,Default,,0,0,0,,Қаладағы жағдай қандай?
Dialogue: 0,0:03:02.04,0:03:04.02,Default,,0,0,0,,Қалада
Dialogue: 0,0:03:30.08,0:03:31.05,Default,,0,0,0,,Клэр
Dialogue: 0,0:03:31.05,0:03:32.06,Default,,0,0,0,,Сіз дос емессіз бе?
Dialogue: 0,0:03:33.01,0:03:34.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:34.04,0:03:36.02,Default,,0,0,0,,Мен олардың бесеуі болғанын естідім.
Dialogue: 0,0:03:36.02,0:03:38.01,Default,,0,0,0,,Төртеуін өзің өлтірдің бе?
Dialogue: 0,0:03:38.06,0:03:40.05,Default,,0,0,0,,Бірақ біреуі қашып кетті.
Dialogue: 0,0:03:40.05,0:03:42.05,Default,,0,0,0,,Құрбандыққа шалынғалы жатқан әйел.
Dialogue: 0,0:03:43.02,0:03:46.00,Default,,0,0,0,,Бұл туралы не айтасыз?
Dialogue: 0,0:03:46.06,0:03:49.07,Default,,0,0,0,,Бұл сендер келе жатқан бағыт еді.
Dialogue: 0,0:03:49.07,0:03:52.05,Default,,0,0,0,,Кешіктірмесем уақытында жетемін деп ойладым.
Dialogue: 0,0:03:53.07,0:03:57.00,Default,,0,0,0,,Ұйымға сәйкес адамның қалыпты тәбетінің болуы мүмкін.
Dialogue: 0,0:03:57.04,0:04:00.08,Default,,0,0,0,,Артыңыздан келе жатқан екі адаммен қосылып, төртеуіңізбен бірге шығарып салыңыз. Бұйрық
Dialogue: 0,0:04:01.06,0:04:03.05,Default,,0,0,0,,болуы керек еді.
Dialogue: 0,0:04:04.05,0:04:06.09,Default,,0,0,0,,Өкінішке орай, бұл жай ғана жын болды.
Dialogue: 0,0:04:06.09,0:04:09.02,Default,,0,0,0,,Бақытымызға орай, мен қателесіппін.
Dialogue: 0,0:04:09.05,0:04:13.08,Default,,0,0,0,,Егер сіздің тәбетіңіз қалыптан тыс болса, сіз қазірге дейін осында жатқан боларсыз.
Dialogue: 0,0:04:15.03,0:04:17.04,Default,,0,0,0,,Батыр болғың келді ме?
Dialogue: 0,0:04:17.08,0:04:18.08,Default,,0,0,0,,Бөлек
Dialogue: 0,0:04:19.04,0:04:24.08,Default,,0,0,0,,Мен ол жерге сәл ертерек келдім, сондықтан мен жай ғана әрекетке кірістім.
Dialogue: 0,0:04:26.09,0:04:28.02,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:28.02,0:04:31.05,Default,,0,0,0,,Бұйрықтарды елемеу жағдайын хабарлаймын.
Dialogue: 0,0:04:36.01,0:04:37.01,Default,,0,0,0,,Клэр
Dialogue: 0,0:04:37.01,0:04:41.02,Default,,0,0,0,,Менің ойымша, тәбеті бұзылған адамдар қалыпты жындарға қарағанда күштірек.
Dialogue: 0,0:04:41.02,0:04:42.00,Default,,0,0,0,,Ах
Dialogue: 0,0:04:42.00,0:04:44.07,Default,,0,0,0,,Мен жәй жынмын деп айтпа
Dialogue: 0,0:04:44.07,0:04:46.08,Default,,0,0,0,,Егер сіз соншалықты абайсызда әрекет етсеңіз жақсы емес пе?
Dialogue: 0,0:04:50.01,0:04:51.02,Default,,0,0,0,,That's right.
Dialogue: 0,0:04:51.07,0:04:53.04,Default,,0,0,0,,Келесі жолы мұқият боламын
Dialogue: 0,0:04:55.00,0:04:56.07,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:04:56.07,0:04:58.08,Default,,0,0,0,,Ол бұрынғыдай ұқыпсыз.
Dialogue: 0,0:04:59.05,0:05:02.03,Default,,0,0,0,,Егер сіздің тәбетіңіз қалыптан тыс болса, не істер едіңіз?
Dialogue: 0,0:05:03.02,0:05:07.03,Default,,0,0,0,,Жоқ, менің үмітім осы болды.
Dialogue: 0,0:05:08.04,0:05:11.03,Default,,0,0,0,,Мен сіздің амбицияңызға таңданамын, бірақ оны тоқтатыңыз.
Dialogue: 0,0:05:11.08,0:05:15.03,Default,,0,0,0,,Тәбеті бұзылған адам дегенді түсінбедім.
Dialogue: 0,0:05:15.06,0:05:17.09,Default,,0,0,0,,Соборда бір рет шайқасты
Dialogue: 0,0:05:18.02,0:05:20.02,Default,,0,0,0,,Бұл жай ғана жын
Dialogue: 0,0:05:20.06,0:05:24.08,Default,,0,0,0,,Еліктеу үшін жай ғана көп мөлшердегі тағамды қажет ететін шағын заттар
Dialogue: 0,0:05:26.07,0:05:29.07,Default,,0,0,0,,Тәбеті бұзылған адамды атауға болатын жаргон термин.
Dialogue: 0,0:05:30.03,0:05:35.02,Default,,0,0,0,,Сырттан келгендерге түсіндіру үшін берілген орынды атау.
Dialogue: 0,0:05:36.05,0:05:39.09,Default,,0,0,0,,Шын мәні – оянған.
Dialogue: 0,0:05:50.01,0:05:53.00,Default,,0,0,0,,Күтілгендей, бұл отбасынан шыққан дұрыс емес басқару.
Dialogue: 0,0:05:53.06,0:05:58.03,Default,,0,0,0,,Дүниенің көз алдында оны ұзақ өмір сүретін жын ретінде қарау ыңғайлырақ болар еді.
Dialogue: 0,0:05:59.04,0:06:03.08,Default,,0,0,0,,Егер басқа адам нағыз тәбеті бұзылған немесе оянған адам болса.
Dialogue: 0,0:06:04.04,0:06:06.08,Default,,0,0,0,,Мен сені бірнеше секундта жұлып аламын.
Dialogue: 0,0:06:09.08,0:06:12.00,Default,,0,0,0,,Әңгіменің бәрі осы болса, мен үйге барамын.
Dialogue: 0,0:06:15.04,0:06:16.03,Default,,0,0,0,,Прискила
Dialogue: 0,0:06:18.04,0:06:20.07,Default,,0,0,0,,Прискиланың басын алғың келе ме?
Dialogue: 0,0:06:22.07,0:06:24.00,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:06:24.07,0:06:28.01,Default,,0,0,0,,Не істесең де, оны жеңе аласың.
Dialogue: 0,0:06:28.06,0:06:31.03,Default,,0,0,0,,Бұл бірінші дәрежелі оянған адам.
Dialogue: 0,0:06:32.05,0:06:38.00,Default,,0,0,0,,Өйткені мен Терезадан асып түсетін әлеуетті ашу үшін ояндым.
Dialogue: 0,0:06:48.02,0:06:53.01,Default,,0,0,0,,Негізінде біз оянған адамдарға белсенді түрде ештеңе жасамаймыз.
Dialogue: 0,0:06:53.04,0:06:55.02,Default,,0,0,0,,Жын сияқты қарады
Dialogue: 0,0:06:55.02,0:06:57.04,Default,,0,0,0,,Сұраныс болмаса, жалғыз қалдырыңыз
Dialogue: 0,0:06:59.05,0:07:02.08,Default,,0,0,0,,Присцилланы жою туралы өтініш алсаңыз
Dialogue: 0,0:07:03.02,0:07:07.08,Default,,0,0,0,,Ұйымымыздың толық күшін және Присцилланың күшін таразылай отырып,
Dialogue: 0,0:07:08.07,0:07:10.08,Default,,0,0,0,,Уақытты бастық шешеді.
Dialogue: 0,0:07:12.00,0:07:13.00,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:07:13.04,0:07:17.08,Default,,0,0,0,,Қазіргі No1-де де, No2-де де белгілі бір қабілет бар.
Dialogue: 0,0:07:18.07,0:07:21.06,Default,,0,0,0,,Әр дәуірдің сүйіктілері әрқашан болады.
Dialogue: 0,0:07:23.01,0:07:26.04,Default,,0,0,0,,Өкініштісі, сен емессің.
Dialogue: 0,0:07:28.02,0:07:28.52,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:30.01,0:07:33.04,Default,,0,0,0,,Мен сені Оянғандардың бағынышты тобына қосамын.
Dialogue: 0,0:07:35.01,0:07:37.07,Default,,0,0,0,,Бұл мен осы жерден батыста келген өтініш.
Dialogue: 0,0:07:38.03,0:07:41.05,Default,,0,0,0,,Бұл белгілі бір жауынгердің өлу мүмкіндігін жоғалтуының нәтижесі сияқты.
Dialogue: 0,0:07:41.08,0:07:46.08,Default,,0,0,0,,Өзіңіздің қабілетіңізді ұнатпайтын дәрежеге дейін сезіну жақсы идея болуы мүмкін.
Dialogue: 0,0:08:01.05,0:08:02.04,Default,,0,0,0,,Тереза
Dialogue: 0,0:08:14.07,0:08:16.06,Default,,0,0,0,,Осы қалада танысыңыз
Dialogue: 0,0:08:16.06,0:08:17.02,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:19.04,0:08:22.02,Default,,0,0,0,,Клэрдің бұл жолы расында да тәбеті қалыпты емес.
Dialogue: 0,0:08:23.08,0:08:25.00,Default,,0,0,0,,Раки не болды?
Dialogue: 0,0:08:25.00,0:08:26.00,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:08:27.02,0:08:29.05,Default,,0,0,0,,Жарайды, Клэр.
Dialogue: 0,0:08:37.09,0:08:38.07,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:08:47.08,0:08:49.00,Default,,0,0,0,,Сіз соңғысысыз
Dialogue: 0,0:08:49.07,0:08:51.00,Default,,0,0,0,,Қалғаны аяқталды.
Dialogue: 0,0:08:58.01,0:08:59.02,Default,,0,0,0,,Не?
Dialogue: 0,0:08:59.02,0:09:00.07,Default,,0,0,0,,Баланы өзіңізбен бірге ала аласыз ба?
Dialogue: 0,0:09:01.02,0:09:03.05,Default,,0,0,0,,Жәкең болмау керек, солай ма?
Dialogue: 0,0:09:03.05,0:09:05.02,Default,,0,0,0,,Сіз оны бір жерден алдыңыз ба?
Dialogue: 0,0:09:05.09,0:09:09.00,Default,,0,0,0,,Бірге төбелесеміз деп ойламаймын.
Dialogue: 0,0:09:09.03,0:09:11.00,Default,,0,0,0,,Мына жігітті қалада қалдыр
Dialogue: 0,0:09:11.04,0:09:13.05,Default,,0,0,0,,Мен қазір баспана іздеуге кірісемін.
Dialogue: 0,0:09:15.02,0:09:16.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:18.03,0:09:20.09,Default,,0,0,0,,Бос уақытыңды түзейтін ойыншық.
Dialogue: 0,0:09:25.00,0:09:27.04,Default,,0,0,0,,Жұлдыздан басыңа қан жүгірді ме?
Dialogue: 0,0:09:27.04,0:09:28.08,Default,,0,0,0,,Қандай масқара әйел.
Dialogue: 0,0:09:31.04,0:09:34.04,Default,,0,0,0,,Кешігіп келсең де, мінезің керемет еді.
Dialogue: 0,0:09:34.08,0:09:38.01,Default,,0,0,0,,Мен бір аптадан бері тығырыққа тіреліп, ренжіп қалдым.
Dialogue: 0,0:09:39.03,0:09:40.03,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:09:40.07,0:09:43.00,Default,,0,0,0,,Қалғанын саған қалдырамын, Мирия.
Dialogue: 0,0:09:45.05,0:09:46.07,Default,,0,0,0,,Біраз
Dialogue: 0,0:09:47.07,0:09:49.03,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:09:51.08,0:09:53.05,Default,,0,0,0,,Хелен Денев
Dialogue: 0,0:09:53.05,0:09:54.08,Default,,0,0,0,,Қылышыңды таста
Dialogue: 0,0:09:59.04,0:10:03.04,Default,,0,0,0,,Өткен жолы мен өзімді озып кеттім деп ойладым.
Dialogue: 0,0:10:03.04,0:10:04.09,Default,,0,0,0,,Бұл жолы кешігіп қалдыңыз ба?
Dialogue: 0,0:10:05.04,0:10:07.00,Default,,0,0,0,,Ол бос емес жігіт.
Dialogue: 0,0:10:08.05,0:10:11.07,Default,,0,0,0,,Қалай болғанда да, қазір бәріміз осындамыз.
Dialogue: 0,0:10:12.03,0:10:16.06,Default,,0,0,0,,Аң аулау мақсаты осы жерден оңтүстікке қарай Пабло тауы тауларында.
Dialogue: 0,0:10:16.06,0:10:18.02,Default,,0,0,0,,Ертең таңертең кетеді
Dialogue: 0,0:10:18.06,0:10:22.02,Default,,0,0,0,,Мен әр адамның аты мен дәрежесін естігім келеді.
Dialogue: 0,0:10:22.02,0:10:25.07,Default,,0,0,0,,Тәбеті бұзылған адамдарды аулау тәжірибесі жоқ.
Dialogue: 0,0:10:26.04,0:10:28.00,Default,,0,0,0,,Менің атым Мирия
Dialogue: 0,0:10:28.05,0:10:31.02,Default,,0,0,0,,Мен бұл аңның басшысы боламын.
Dialogue: 0,0:10:31.05,0:10:33.00,Default,,0,0,0,,саны 6
Dialogue: 0,0:10:33.05,0:10:36.04,Default,,0,0,0,,Бұл менің тәбеті бұзылған адамдарды аулаудағы жетінші тәжірибем.
Dialogue: 0,0:10:37.02,0:10:38.05,Default,,0,0,0,,Мен Хеленмін
Dialogue: 0,0:10:38.05,0:10:40.01,Default,,0,0,0,,саны 22
Dialogue: 0,0:10:40.01,0:10:42.04,Default,,0,0,0,,Тәбеті бұзылған адамдарды аулауда тәжірибем жоқ.
Dialogue: 0,0:10:43.02,0:10:44.07,Default,,0,0,0,,Менің атым Денев
Dialogue: 0,0:10:45.01,0:10:46.06,Default,,0,0,0,,саны 15
Dialogue: 0,0:10:46.06,0:10:47.09,Default,,0,0,0,,Екі рет тәжірибе
Dialogue: 0,0:10:48.05,0:10:50.03,Default,,0,0,0,,Рейтинг бар ма?
Dialogue: 0,0:10:50.09,0:10:52.04,Default,,0,0,0,,Содан кейін Клэр
Dialogue: 0,0:10:52.04,0:10:53.06,Default,,0,0,0,,Бұл Клэр.
Dialogue: 0,0:10:54.01,0:10:56.05,Default,,0,0,0,,Менің тәбеті бұзылған адамдарды аулауда тәжірибем жоқ.
Dialogue: 0,0:10:57.00,0:10:59.02,Default,,0,0,0,,саны 47
Dialogue: 0,0:11:00.01,0:11:01.02,Default,,0,0,0,,Хаа
Dialogue: 0,0:11:06.00,0:11:07.09,Default,,0,0,0,,Сіз мұны естідіңіз бе? Денев
Dialogue: 0,0:11:07.09,0:11:10.00,Default,,0,0,0,,Бұл жігіттің саны 47.
Dialogue: 0,0:11:10.04,0:11:11.07,Default,,0,0,0,,Қандай таң қалдырды!
Dialogue: 0,0:11:11.07,0:11:13.06,Default,,0,0,0,,Мен мұндай адамды кездестіргеніме сене алар емеспін.
Dialogue: 0,0:11:15.00,0:11:16.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:16.09,0:11:18.08,Default,,0,0,0,,Балалар, сендерде не қызық?
Dialogue: 0,0:11:18.08,0:11:20.01,Default,,0,0,0,,Клэрді мазақ етпе
Dialogue: 0,0:11:20.05,0:11:21.08,Default,,0,0,0,,Бұл не, бала?
Dialogue: 0,0:11:21.08,0:11:23.01,Default,,0,0,0,,Сіз білмедіңіз бе?
Dialogue: 0,0:11:24.03,0:11:25.07,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:11:26.02,0:11:30.09,Default,,0,0,0,,Тыңдаңдар, біздің біріміз осы материктің әр ауданында орналасады.
Dialogue: 0,0:11:31.05,0:11:34.03,Default,,0,0,0,,Персонал саны ұлғайған жағдайлар болуы мүмкін немесе
Dialogue: 0,0:11:34.03,0:11:36.04,Default,,0,0,0,,Негізінен бір палатаға бір адамнан келеді.
Dialogue: 0,0:11:36.09,0:11:40.05,Default,,0,0,0,,Сонда сан адамның күшін білдіреді.
Dialogue: 0,0:11:40.05,0:11:41.03,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:11:42.06,0:11:46.04,Default,,0,0,0,,Иә, бұл құрлықтағы аудандардың саны қырық жеті.
Dialogue: 0,0:11:47.04,0:11:53.04,Default,,0,0,0,,Басқаша айтқанда, оның 47 саны барлық жауынгерлердің ең әлсізін білдіреді.
Dialogue: 0,0:11:56.02,0:11:56.52,Default,,0,0,0,,Клэр
Dialogue: 0,0:12:09.00,0:12:12.06,Default,,0,0,0,,Клэр Клеоморлардың ең әлсізі.
Dialogue: 0,0:12:24.06,0:12:26.05,Default,,0,0,0,,Әзірге қалдырыңыз.
Dialogue: 0,0:12:27.00,0:12:29.03,Default,,0,0,0,,Мен жоқта не қаласаң соны істе
Dialogue: 0,0:12:30.02,0:12:32.06,Default,,0,0,0,,Бұл миссия қанша уақытқа созылады?
Dialogue: 0,0:12:32.09,0:12:36.01,Default,,0,0,0,,Бір аптаға жуық.
Dialogue: 0,0:12:38.03,0:12:40.09,Default,,0,0,0,,Ал, мен үш нәрсені ғана сақтаймын.
Dialogue: 0,0:12:41.03,0:12:43.02,Default,,0,0,0,,Бұл бір аптаға жетеді.
Dialogue: 0,0:12:45.02,0:12:48.02,Default,,0,0,0,,Бір аптадан кейін қайтасыз, солай ма?
Dialogue: 0,0:12:51.01,0:12:52.03,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:12:53.03,0:12:54.05,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:54.08,0:12:56.05,Default,,0,0,0,,Көп уайымдамаңыз
Dialogue: 0,0:12:57.05,0:12:58.06,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:12:59.00,0:13:01.08,Default,,0,0,0,,Менің айтқаныма сеніңіз, жарайды.
Dialogue: 0,0:13:13.02,0:13:14.09,Default,,0,0,0,,Қайтадан асығыңыз
Dialogue: 0,0:13:15.06,0:13:16.03,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:40.09,0:13:44.05,Default,,0,0,0,,Сәлем, Клэр, сен тынышсың.
Dialogue: 0,0:13:44.05,0:13:47.09,Default,,0,0,0,,Маған сол қыз бұрынғыдай жылыту керек.
Dialogue: 0,0:13:49.05,0:13:50.05,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:13:51.00,0:13:52.03,Default,,0,0,0,,Бұл дене күшін босқа жұмсау.
Dialogue: 0,0:13:52.07,0:13:55.05,Default,,0,0,0,,Тіпті басқалардан төмен болу
Dialogue: 0,0:13:55.05,0:13:57.01,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,0:13:57.01,0:13:57.51,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:13:58.05,0:14:01.01,Default,,0,0,0,,Сабыр ет, Хелен Денев.
Dialogue: 0,0:14:01.05,0:14:03.05,Default,,0,0,0,,Біз бір командамыз
Dialogue: 0,0:14:03.05,0:14:06.01,Default,,0,0,0,,Ұсақ-түйек нәрселерге кедергі жасама.
Dialogue: 0,0:14:06.05,0:14:08.06,Default,,0,0,0,,Өйткені, Мирия-ни-сан
Dialogue: 0,0:14:08.06,0:14:10.03,Default,,0,0,0,,Бұл жігіт төменгі жағында.
Dialogue: 0,0:14:10.03,0:14:11.06,Default,,0,0,0,,Ең төменгі сан
Dialogue: 0,0:14:11.06,0:14:12.09,Default,,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:14:13.06,0:14:19.04,Default,,0,0,0,,30 жастан асқан адамдардың тәбеті бұзылған адамдарды іздеуге қатысушылар ретінде таңдалуы сирек.
Dialogue: 0,0:14:19.04,0:14:21.09,Default,,0,0,0,,Қырық жеті болып шықты.
Dialogue: 0,0:14:22.04,0:14:24.07,Default,,0,0,0,,Ұйым не ойлады?
Dialogue: 0,0:14:25.07,0:14:27.06,Default,,0,0,0,,Жоғарыда шешім қабылданды.
Dialogue: 0,0:14:27.09,0:14:30.04,Default,,0,0,0,,Бұл біздің болжауымыз емес.
Dialogue: 0,0:14:32.09,0:14:34.00,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:14:34.00,0:14:36.05,Default,,0,0,0,,Ең дұрысы, мені ұстамағаныңызды қалаймын.
Dialogue: 0,0:14:58.02,0:15:00.02,Default,,0,0,0,,Мен бүгін осында түнеймін.
Dialogue: 0,0:15:00.05,0:15:03.02,Default,,0,0,0,,Біз ертең тақырыппен байланыста болуымыз керек.
Dialogue: 0,0:15:03.02,0:15:04.03,Default,,0,0,0,,Wies
Dialogue: 0,0:15:09.03,0:15:10.05,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:15:10.09,0:15:12.06,Default,,0,0,0,,Мен тамақ алып келейін бе?
Dialogue: 0,0:15:12.08,0:15:14.00,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:15:14.05,0:15:17.02,Default,,0,0,0,,Сіз сияқты тамақтанатын адамдар сирек.
Dialogue: 0,0:15:17.02,0:15:18.09,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:15:18.09,0:15:21.00,Default,,0,0,0,,Саған да алып берейін бе?
Dialogue: 0,0:15:21.05,0:15:22.09,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:15:22.09,0:15:24.03,Default,,0,0,0,,Осы жерде демалайық
Dialogue: 0,0:15:25.03,0:15:26.03,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:15:36.02,0:15:37.04,Default,,0,0,0,,Осы уақытқа дейін менімен бірге бол.
Dialogue: 0,0:15:38.02,0:15:39.04,Default,,0,0,0,,Уақытты қажет ететін спираль
Dialogue: 0,0:15:52.08,0:15:54.07,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге келісім жасауыңызды қалаймын.
Dialogue: 0,0:15:55.04,0:15:58.06,Default,,0,0,0,,Мен жай ғана әркімнің қабілетін білгім келеді.
Dialogue: 0,0:16:00.00,0:16:03.09,Default,,0,0,0,,47 санының рейтингі жеткіліксіз бе?
Dialogue: 0,0:16:04.03,0:16:07.06,Default,,0,0,0,,Шынымды айтсам, сенің төменгі жақта тұрғаның мені мазалайды.
Dialogue: 0,0:16:08.01,0:16:10.09,Default,,0,0,0,,Сізді алғаш көргендегі әсерім
Dialogue: 0,0:16:11.02,0:16:15.04,Default,,0,0,0,,Мен ең күшті адамның алдында тұрған сияқтымын.
Dialogue: 0,0:16:18.05,0:16:19.06,Default,,0,0,0,,Мен растағым келеді
Dialogue: 0,0:16:21.00,0:16:21.50,Default,,0,0,0,,Кеттік
Dialogue: 0,0:16:46.00,0:16:48.04,Default,,0,0,0,,О, сен істеп жатырсың.
Dialogue: 0,0:16:49.02,0:16:50.00,Default,,0,0,0,,Оны жегің келе ме?
Dialogue: 0,0:16:50.04,0:16:51.02,Default,,0,0,0,,шайқастан барынша аулақ болуға тырысқанымызға қарамастан, әскеріміздің шамамен жиырма пайызын жоғалттық.
Dialogue: 0,0:16:59.00,0:17:01.01,Default,,0,0,0,,Бұл өте ұят.
Dialogue: 0,0:17:01.08,0:17:04.02,Default,,0,0,0,,А, бұл өте ұят.
Dialogue: 0,0:17:05.02,0:17:07.02,Default,,0,0,0,,Бұл тым қатыгез
Dialogue: 0,0:17:22.08,0:17:23.07,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:24.02,0:17:26.00,Default,,0,0,0,,Бүгін жақсылап демалыңыз.
Dialogue: 0,0:17:26.00,0:17:28.05,Default,,0,0,0,,Ертеңге дейін күшіңізді қалпына келтіріңіз.
Dialogue: 0,0:17:37.01,0:17:38.07,Default,,0,0,0,,Құрметті Мирия-нисан
Dialogue: 0,0:17:38.07,0:17:40.00,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:17:40.00,0:17:42.00,Default,,0,0,0,,Егер солай болса, ол күш болмайды.
Dialogue: 0,0:17:42.04,0:17:45.08,Default,,0,0,0,,Міне, осы уақытқа дейін аман қалғаным бір ғажап.
Dialogue: 0,0:17:46.08,0:17:50.03,Default,,0,0,0,,Бұл шын мәнінде үш адамдық шайқас болатынына күмән жоқ.
Dialogue: 0,0:17:51.03,0:17:53.05,Default,,0,0,0,,Сіз миссияңызды жалғастырасыз ба?
Dialogue: 0,0:17:53.05,0:17:54.06,Default,,0,0,0,,Мен саған айттым
Dialogue: 0,0:17:54.09,0:17:56.05,Default,,0,0,0,,Жоғарыда аталған шешім қабылданды.
Dialogue: 0,0:17:56.08,0:17:58.08,Default,,0,0,0,,Біз оны орындаймыз.
Dialogue: 0,0:18:00.09,0:18:03.05,Default,,0,0,0,,Маған оба құдайы таңылды.
Dialogue: 0,0:18:10.05,0:18:11.05,Default,,0,0,0,,Кеттік
Dialogue: 0,0:18:12.01,0:18:14.08,Default,,0,0,0,,Осылай өле берсек те операцияға еш кедергі болмайды.
Dialogue: 0,0:18:56.02,0:18:57.05,Default,,0,0,0,,Тереза
Dialogue: 0,0:19:01.01,0:19:03.07,Default,,0,0,0,,О, мен тірімін, мен тірімін
Dialogue: 0,0:19:04.01,0:19:07.04,Default,,0,0,0,,Сонда ол түні бойы ес-түссіз жатты?
Dialogue: 0,0:19:07.04,0:19:08.08,Default,,0,0,0,,Бейбойн
Dialogue: 0,0:19:09.05,0:19:10.09,Default,,0,0,0,,Дайын бол
Dialogue: 0,0:19:10.09,0:19:12.03,Default,,0,0,0,,Эрен...
Dialogue: 0,0:19:15.01,0:19:16.07,Default,,0,0,0,,Себебі мен алдамын.
Dialogue: 0,0:19:16.07,0:19:18.04,Default,,0,0,0,,Өміріңді жоғалтқың келмесе, келме.
Dialogue: 0,0:19:18.09,0:19:20.03,Default,,0,0,0,,Біз де құтқарыламыз.
Dialogue: 0,0:19:49.09,0:19:51.04,Default,,0,0,0,,Қалғанның бәрі жақсы.
Dialogue: 0,0:19:52.04,0:19:54.07,Default,,0,0,0,,Эй, сен шынымен оларды төбелестіргің келе ме?
Dialogue: 0,0:19:54.07,0:19:56.04,Default,,0,0,0,,Өліп бара жатқандай
Dialogue: 0,0:19:56.04,0:19:58.01,Default,,0,0,0,,Мені қайта-қайта айтуға мәжбүрлеме
Dialogue: 0,0:19:58.01,0:19:59.07,Default,,0,0,0,,Бұл жоғарыдағы нұсқау
Dialogue: 0,0:19:59.07,0:20:00.09,Default,,0,0,0,,(Панда) Бірінші курс студентін жіберуді қамтитын Арнайы сынып ісі — бұл төтенше жағдай.
Dialogue: 0,0:20:12.09,0:20:14.09,Default,,0,0,0,,Эй
Dialogue: 0,0:20:16.09,0:20:18.09,Default,,0,0,0,,Мен саған кешпеймін…
Dialogue: 0,0:20:18.09,0:20:21.04,Default,,0,0,0,,Мен сені күттім, Клейморс.
Dialogue: 0,0:20:22.09,0:20:24.04,Default,,0,0,0,,Бұл қарт кім?
Dialogue: 0,0:20:25.00,0:20:27.00,Default,,0,0,0,,Ол Лидо қаласынан.
Dialogue: 0,0:20:27.00,0:20:30.02,Default,,0,0,0,,Бұл өтінішті жасаған өзіміз.
Dialogue: 0,0:20:31.00,0:20:34.07,Default,,0,0,0,,Жоқ, ерте келгеніңізге қуаныштымын.
Dialogue: 0,0:20:37.00,0:20:38.09,Default,,0,0,0,,Біз сізге орын туралы хабарлаймыз.
Dialogue: 0,0:20:38.09,0:20:40.00,Default,,0,0,0,,Осы жерді басыңыз
Dialogue: 0,0:20:42.08,0:20:43.05,Default,,0,0,0,,Милия
Dialogue: 0,0:20:49.00,0:20:50.01,Default,,0,0,0,,Милия
Dialogue: 0,0:20:51.05,0:20:53.07,Default,,0,0,0,,Ақпараттық қате.
Dialogue: 0,0:20:54.01,0:20:58.04,Default,,0,0,0,,Тәбеті қалыпты деңгейде емес деп естідім.
Dialogue: 0,0:21:01.04,0:21:02.07,Default,,0,0,0,,Өте көп
Dialogue: 0,0:21:04.06,0:21:06.05,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:21:06.05,0:21:09.01,Default,,0,0,0,,Сіз маған осы мүшемен айналысуды айтасыз ба?
Dialogue: 0,0:21:11.09,0:21:12.06,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:21:15.08,0:21:17.09,Default,,0,0,0,,Мен қалжыңдап тұрмын.
Dialogue: 0,0:21:20.00,0:21:21.09,Default,,0,0,0,,Ол оянған адам.
Dialogue: 0,0:22:40.04,0:22:43.08,Default,,0,0,0,,Күдіктің артуы, қауіп-қатердің артуы
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Шындық қайда жатыр
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
