Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.08,0:00:17.06,Default,,0,0,0,,Ол өзінің шегіне жақындады ма?
Dialogue: 0,0:00:21.00,0:00:23.01,Default,,0,0,0,,Бүгінгі күннің бәрі осы.
Dialogue: 0,0:00:23.08,0:00:25.03,Default,,0,0,0,,Суға шомылуға болады.
Dialogue: 0,0:00:25.08,0:00:27.06,Default,,0,0,0,,Жоқ, бәрібір.
Dialogue: 0,0:00:27.06,0:00:29.04,Default,,0,0,0,,Қайыр сұрай беріңіз
Dialogue: 0,0:00:30.09,0:00:32.01,Default,,0,0,0,,Оны асыра пайдаланбаңыз
Dialogue: 0,0:00:33.00,0:00:36.08,Default,,0,0,0,,Алынған жаралар әлі толық жазылмаған болуы керек.
Dialogue: 0,0:00:37.07,0:00:38.06,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:00:39.01,0:00:43.04,Default,,0,0,0,,Жаттығудың жартысы, ал демалыстың жартысы жаттығу деп есептеңіз.
Dialogue: 0,0:00:49.04,0:00:53.06,Default,,0,0,0,,Мен жоғары жылдамдықтағы қылыштың шегін өз бетімше ұстай алдым.
Dialogue: 0,0:00:55.06,0:00:56.07,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:02:14.00,0:02:16.05,Default,,0,0,0,,Жан-жағы таулармен қоршалған алап па?
Dialogue: 0,0:02:17.07,0:02:18.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:19.01,0:02:21.00,Default,,0,0,0,,Бұл шегінуге жақсы орын
Dialogue: 0,0:02:32.06,0:02:33.04,Default,,0,0,0,,О
Dialogue: 0,0:02:34.02,0:02:36.03,Default,,0,0,0,,Көлемі онша өзгеше емес сияқты.
Dialogue: 0,0:02:37.07,0:02:40.04,Default,,0,0,0,,Бұл сол кезден бе?
Dialogue: 0,0:02:42.03,0:02:43.01,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:51.00,0:02:52.08,Default,,0,0,0,,Сол жеңі жоқ болса да
Dialogue: 0,0:02:52.08,0:02:55.03,Default,,0,0,0,,Сіздікінен жақсырақ.
Dialogue: 0,0:02:55.06,0:02:56.09,Default,,0,0,0,,Мен оны саған беремін.
Dialogue: 0,0:02:56.09,0:02:57.07,Default,,0,0,0,,Отырыңыз
Dialogue: 0,0:03:01.04,0:03:02.00,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:03:04.04,0:03:05.09,Default,,0,0,0,,Тіпті қаламасаңыз да
Dialogue: 0,0:03:05.09,0:03:08.01,Default,,0,0,0,,Оны денеңізге күштеп салу керек.
Dialogue: 0,0:03:22.09,0:03:23.09,Default,,0,0,0,,Өзгеріс жоқ.
Dialogue: 0,0:03:24.07,0:03:26.07,Default,,0,0,0,,Бәрі сол кездегідей қалады.
Dialogue: 0,0:03:27.05,0:03:29.03,Default,,0,0,0,,Менің ойымша, сіз білесіз.
Dialogue: 0,0:03:29.03,0:03:33.00,Default,,0,0,0,,Біз, жартылай адам, жартылай жын, өсеміз, бірақ қартаймаймыз.
Dialogue: 0,0:03:33.07,0:03:38.00,Default,,0,0,0,,Ол шайқаста өлгенше немесе жынға айналғанша осы қалпында қалады.
Dialogue: 0,0:03:39.03,0:03:41.03,Default,,0,0,0,,Тереза тірі болса
Dialogue: 0,0:03:41.07,0:03:44.03,Default,,0,0,0,,Сол кездегідей болса керек.
Dialogue: 0,0:03:49.08,0:03:54.01,Default,,0,0,0,,Терезаның өлгеніне өзің кінәлі деп ойлайтын шығарсың.
Dialogue: 0,0:03:55.06,0:03:57.08,Default,,0,0,0,,Бұл бір мағынада қате емес, бірақ
Dialogue: 0,0:03:58.06,0:04:02.00,Default,,0,0,0,,Тереза сізді кездестірді және саяхаттады.
Dialogue: 0,0:04:02.00,0:04:04.03,Default,,0,0,0,,Жауынгер ретінде күшіңді жоғалт
Dialogue: 0,0:04:04.03,0:04:06.07,Default,,0,0,0,,Нәтижесінде оны Присцилла өлтірді.
Dialogue: 0,0:04:06.07,0:04:08.00,Default,,0,0,0,,Бұл факт
Dialogue: 0,0:04:10.00,0:04:10.50,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:11.04,0:04:13.03,Default,,0,0,0,,Менің ойымша, Тереза ​​бақытты болды.
Dialogue: 0,0:04:14.08,0:04:16.09,Default,,0,0,0,,Сізбен бірге өткізген уақыт
Dialogue: 0,0:04:17.05,0:04:20.02,Default,,0,0,0,,Қаншалықты қысқа болса да
Dialogue: 0,0:04:24.02,0:04:25.06,Default,,0,0,0,,Тереза жалғыз қалды
Dialogue: 0,0:04:26.06,0:04:28.09,Default,,0,0,0,,тым күшті және асыл
Dialogue: 0,0:04:28.09,0:04:32.01,Default,,0,0,0,,Сондықтан Терезаның айналасындағы адамдар оны құрметтейтін.
Dialogue: 0,0:04:32.01,0:04:33.06,Default,,0,0,0,,Және қорқады
Dialogue: 0,0:04:35.01,0:04:37.01,Default,,0,0,0,,Иә, сен оны жақсы көресің.
Dialogue: 0,0:04:37.08,0:04:39.08,Default,,0,0,0,,Ол да оны қабылдады.
Dialogue: 0,0:04:42.04,0:04:46.00,Default,,0,0,0,,Тереза үшін сізбен уақыт өткізу - бұл
Dialogue: 0,0:04:46.04,0:04:48.04,Default,,0,0,0,,Бейбіт және орындалған
Dialogue: 0,0:04:48.08,0:04:52.02,Default,,0,0,0,,Бәрінен бұрын, бұл өте қарқынды және адамға ұқсас уақыт болса керек.
Dialogue: 0,0:04:56.07,0:04:58.05,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,0:05:43.02,0:05:44.01,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:44.06,0:05:47.05,Default,,0,0,0,,Мен енді өз шектеулерімді түсіне аламын.
Dialogue: 0,0:05:48.01,0:05:50.00,Default,,0,0,0,,Бұл сезімді ұмытпа
Dialogue: 0,0:05:51.04,0:05:52.05,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:05:53.00,0:05:55.01,Default,,0,0,0,,Мен Айриннің жылдам семсерімін
Dialogue: 0,0:05:55.01,0:05:56.07,Default,,0,0,0,,Сіз қаншалықты жақынсыз?
Dialogue: 0,0:05:57.08,0:06:01.07,Default,,0,0,0,,Жылдам семсер үшін күшті ақыл күші қажет
Dialogue: 0,0:06:02.03,0:06:05.08,Default,,0,0,0,,Ең бастысы - әрқашан сабырлы болу.
Dialogue: 0,0:06:06.07,0:06:08.07,Default,,0,0,0,,Бұл сізге сәйкес болуы мүмкін деп ойладым.
Dialogue: 0,0:06:09.04,0:06:10.04,Default,,0,0,0,,Қате
Dialogue: 0,0:06:10.08,0:06:15.01,Default,,0,0,0,,Жүрегіңде ылғи бір жалын бар
Dialogue: 0,0:06:16.01,0:06:18.06,Default,,0,0,0,,Жылдам қылыш мұндай адамдарға жарамайды.
Dialogue: 0,0:06:19.01,0:06:24.02,Default,,0,0,0,,Себебі, оны шығара бастаған бойда рухыңды бір қолдың тылсым энергиясы тартып алады.
Dialogue: 0,0:06:25.02,0:06:28.07,Default,,0,0,0,,Факт: Сіздің жоғары жылдамдықтағы қылышыңыз бір минутқа шыдамайды.
Dialogue: 0,0:06:29.09,0:06:33.09,Default,,0,0,0,,Күш пен жылдамдық ең жақсы жағдайда менің оннан аз.
Dialogue: 0,0:06:34.06,0:06:37.07,Default,,0,0,0,,Басқаша айтқанда, бұл пайдасыз.
Dialogue: 0,0:06:38.06,0:06:41.09,Default,,0,0,0,,Маа Дегенмен, сіз жақсы орындадыңыз.
Dialogue: 0,0:06:42.04,0:06:44.00,Default,,0,0,0,,Мен саған мақтау айтамын.
Dialogue: 0,0:06:46.00,0:06:46.50,Default,,0,0,0,,Тұру
Dialogue: 0,0:07:00.05,0:07:02.00,Default,,0,0,0,,Не
Dialogue: 0,0:07:02.00,0:07:04.06,Default,,0,0,0,,Жара жабылып қойған.
Dialogue: 0,0:07:05.04,0:07:09.01,Default,,0,0,0,,Кешіріңіз, бірақ мен кесілген бетті қайтадан жасауға тура келді.
Dialogue: 0,0:07:14.05,0:07:16.02,Default,,0,0,0,,Айрин сен
Dialogue: 0,0:07:17.00,0:07:18.00,Default,,0,0,0,,Қоштасу
Dialogue: 0,0:07:18.05,0:07:19.04,Default,,0,0,0,,Оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:07:19.06,0:07:21.06,Default,,0,0,0,,Егер ол белгілі бір дәрежеде бар күшін салмайтын болса—
Dialogue: 0,0:07:21.06,0:07:22.06,Default,,0,0,0,,Бұл ақылға қонымсыз
Dialogue: 0,0:07:22.06,0:07:24.00,Default,,0,0,0,,Жылдам қосылыңыз
Dialogue: 0,0:07:24.00,0:07:25.01,Default,,0,0,0,,тым кеш болады
Dialogue: 0,0:07:26.02,0:07:29.00,Default,,0,0,0,,Содан кейін жоғары жылдамдықты қылышты қолдануға болады.
Dialogue: 0,0:07:29.07,0:07:32.01,Default,,0,0,0,,Бұл сізге қазір керек.
Dialogue: 0,0:07:32.06,0:07:33.09,Default,,0,0,0,,Бірақ Айрин
Dialogue: 0,0:07:34.08,0:07:37.03,Default,,0,0,0,,Мен үшін шайқастан алыс
Dialogue: 0,0:07:37.03,0:07:39.01,Default,,0,0,0,,Бұл пайдасыз нәрсе
Dialogue: 0,0:07:39.09,0:07:42.06,Default,,0,0,0,,Бұл маған бұрыннан қажет болмай қалған нәрсе.
Dialogue: 0,0:07:42.06,0:07:43.06,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:07:44.02,0:07:45.01,Default,,0,0,0,,Қабылдау
Dialogue: 0,0:07:45.06,0:07:47.01,Default,,0,0,0,,Сіздің өмір сүруіңіз үшін
Dialogue: 0,0:07:47.08,0:07:50.03,Default,,0,0,0,,Бұл Терезаның тірі болғанының дәлелі.
Dialogue: 0,0:08:29.05,0:08:30.08,Default,,0,0,0,,Барлығы орындалған кезде
Dialogue: 0,0:08:30.08,0:08:31.09,Default,,0,0,0,,Қайтып кел
Dialogue: 0,0:08:32.05,0:08:35.03,Default,,0,0,0,,Сондықтан аман қалуыңызды өтінемін.
Dialogue: 0,0:08:35.07,0:08:37.06,Default,,0,0,0,,Үмітсіз күтемін
Dialogue: 0,0:08:38.02,0:08:41.08,Default,,0,0,0,,Уайымдама, мен оңай өлмеймін.
Dialogue: 0,0:08:50.07,0:08:52.02,Default,,0,0,0,,Тікелей Клэр
Dialogue: 0,0:08:54.09,0:08:57.02,Default,,0,0,0,,Басқа адам бар сияқты болды.
Dialogue: 0,0:08:57.08,0:08:59.03,Default,,0,0,0,,Ол кетті ме?
Dialogue: 0,0:08:59.03,0:09:00.02,Default,,0,0,0,,Ах
Dialogue: 0,0:09:00.06,0:09:02.06,Default,,0,0,0,,Мен біраз уақыт бұрын кетіп қалдым.
Dialogue: 0,0:09:03.07,0:09:05.04,Default,,0,0,0,,Маа, маған бәрібір.
Dialogue: 0,0:09:05.04,0:09:08.01,Default,,0,0,0,,Сіз мен іздеген адамсыз
Dialogue: 0,0:09:09.09,0:09:14.05,Default,,0,0,0,,Мен оны таба алмадым, өйткені мен көптен бері жындарды толығымен өшірдім.
Dialogue: 0,0:09:15.04,0:09:18.01,Default,,0,0,0,,Жылдам семсерді қолдану қателік болды.
Dialogue: 0,0:09:18.08,0:09:23.09,Default,,0,0,0,,Сізге рахмет, менің жын-шайтандық энергиям қазір кәдімгі жауынгер сияқты ағып жатыр.
Dialogue: 0,0:09:24.06,0:09:27.04,Default,,0,0,0,,Сіздің атыңызды сұрауым керек пе?
Dialogue: 0,0:09:28.02,0:09:29.02,Default,,0,0,0,,Рафаэла
Dialogue: 0,0:09:29.07,0:09:31.04,Default,,0,0,0,,Ұйымның № 5
Dialogue: 0,0:09:34.01,0:09:35.07,Default,,0,0,0,,Бұл жараға не болды?
Dialogue: 0,0:09:36.03,0:09:39.04,Default,,0,0,0,,Бұл оның жартылай адам, жартылай жын болғанға дейін алған жарақаты ма?
Dialogue: 0,0:09:39.04,0:09:44.01,Default,,0,0,0,,Қазір өліп жатқан адамға мұны үйретуге негіз бар ма?
Dialogue: 0,0:09:44.09,0:09:46.06,Default,,0,0,0,,Дефектор Айрин
Dialogue: 0,0:09:46.06,0:09:49.01,Default,,0,0,0,,Сіздің өміріңіз ұйымға байланысты.
Dialogue: 0,0:09:50.01,0:09:52.09,Default,,0,0,0,,Мен оның бір ғана қолы бар деп естідім, бірақ оның екеуі де жоқ сияқты.
Dialogue: 0,0:09:53.05,0:09:56.08,Default,,0,0,0,,Өте жаман, бақытсыздық.
Dialogue: 0,0:09:57.02,0:10:01.06,Default,,0,0,0,,Жоқ, екі қолым болса, қолымнан бірдеңе келер еді.
Dialogue: 0,0:10:02.01,0:10:06.06,Default,,0,0,0,,Неліктен сен соншалықты күштісің және 5-ші нөмірде қаласың?
Dialogue: 0,0:10:07.05,0:10:10.09,Default,,0,0,0,,Кешіріңіз, бірақ бұған да жауап беруге негіз жоқ.
Dialogue: 0,0:10:17.08,0:10:18.06,Default,,0,0,0,,Айрин
Dialogue: 0,0:10:20.02,0:10:22.05,Default,,0,0,0,,Менің оң қолыма бірдеңе дұрыс емес.
Dialogue: 0,0:10:27.08,0:10:28.05,Default,,0,0,0,,Не?
Dialogue: 0,0:10:31.07,0:10:35.05,Default,,0,0,0,,Бір қорқынышты нәрсе келе жатыр
Dialogue: 0,0:10:40.09,0:10:43.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:43.05,0:10:44.09,Default,,0,0,0,,Қандай сәйкестік.
Dialogue: 0,0:10:44.09,0:10:47.02,Default,,0,0,0,,Біздің мұндай жерде кездесетінімізге сене алар емеспін.
Dialogue: 0,0:10:47.08,0:10:51.01,Default,,0,0,0,,Әй, мына оң қол не болды?
Dialogue: 0,0:10:51.01,0:10:53.06,Default,,0,0,0,,Мен оны кесіп тастауым керек еді.
Dialogue: 0,0:10:53.06,0:10:54.08,Default,,0,0,0,,Офелия
Dialogue: 0,0:10:55.02,0:10:56.06,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:10:56.06,0:11:01.01,Default,,0,0,0,,Мен сізді көптен бері көрмедім, сондықтан ұмытып кеттім.
Dialogue: 0,0:11:01.05,0:11:02.08,Default,,0,0,0,,Ауырды
Dialogue: 0,0:11:03.04,0:11:06.02,Default,,0,0,0,,Сіз өте қорқынышты адамсыз.
Dialogue: 0,0:11:06.04,0:11:08.06,Default,,0,0,0,,немесе Оянған
Dialogue: 0,0:11:08.07,0:11:09.05,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:11:09.05,0:11:10.06,Default,,0,0,0,,Не?
Dialogue: 0,0:11:10.06,0:11:13.01,Default,,0,0,0,,Қайдасың, Оян?
Dialogue: 0,0:11:14.05,0:11:16.08,Default,,0,0,0,,Не? Сіз жоқсыз.
Dialogue: 0,0:11:16.08,0:11:18.09,Default,,0,0,0,,Мұндай бейқам сөздерді айтпа
Dialogue: 0,0:11:19.09,0:11:23.06,Default,,0,0,0,,Әй, менің басқа жейтін ештеңем жоқ.
Dialogue: 0,0:11:23.06,0:11:26.01,Default,,0,0,0,,Мен өзімді үнемі аш жүргендей сезінемін.
Dialogue: 0,0:11:26.01,0:11:28.00,Default,,0,0,0,,Мүмкін болса, ет алғым келеді.
Dialogue: 0,0:11:28.05,0:11:30.06,Default,,0,0,0,,Жұмсақ және жанды
Dialogue: 0,0:11:31.00,0:11:34.07,Default,,0,0,0,,Иә, бұл ішкі ағзалар жүйесі деп ойлаймын.
Dialogue: 0,0:11:34.07,0:11:38.02,Default,,0,0,0,,Хмм, жоқ, бұл адам емес.
Dialogue: 0,0:11:38.02,0:11:40.00,Default,,0,0,0,,Мен оянған адам емеспін.
Dialogue: 0,0:11:40.05,0:11:45.00,Default,,0,0,0,,Бірақ адамдарға қаншалықты жақын болсаң, соғұрлым дәмді болатынын сеземін.
Dialogue: 0,0:11:46.02,0:11:47.02,Default,,0,0,0,,Сіз
Dialogue: 0,0:11:47.07,0:11:50.09,Default,,0,0,0,,Егер бірдеңе болса, бұл адам емес.
Dialogue: 0,0:11:54.04,0:11:55.09,Default,,0,0,0,,О сен
Dialogue: 0,0:11:55.09,0:11:58.04,Default,,0,0,0,,Күш пен жылдамдық аздап жоғарылады
Dialogue: 0,0:12:01.00,0:12:02.03,Default,,0,0,0,,Не?
Dialogue: 0,0:12:02.03,0:12:05.02,Default,,0,0,0,,Кейбір ішкі мүшелерді жеген дұрыс емес пе?
Dialogue: 0,0:12:08.08,0:12:14.05,Default,,0,0,0,,Өйткені, сіздің күшіңіз бен жылдамдығыңыз бұрынғымен салыстырғанда теңдессіз өсті.
Dialogue: 0,0:12:15.00,0:12:16.07,Default,,0,0,0,,Қызық, не болды?
Dialogue: 0,0:12:17.01,0:12:19.05,Default,,0,0,0,,Маа, маған бәрібір.
Dialogue: 0,0:12:26.05,0:12:27.06,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:12:27.06,0:12:29.01,Default,,0,0,0,,Бұл өте дәмді емес.
Dialogue: 0,0:12:38.00,0:12:39.09,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:12:39.09,0:12:42.06,Default,,0,0,0,,Ішкі мүшелер болмаса дәмді емес шығар.
Dialogue: 0,0:12:43.02,0:12:44.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:44.04,0:12:47.00,Default,,0,0,0,,Мен бұл сен болмағаныңды қалаймын.
Dialogue: 0,0:12:47.00,0:12:49.05,Default,,0,0,0,,Менің қарным ашты, қолымнан ештеңе келмейді.
Dialogue: 0,0:12:50.05,0:12:54.03,Default,,0,0,0,,Негізі мен оның тірі кезінде ішкі мүшелерін алып тастағым келеді.
Dialogue: 0,0:12:54.03,0:12:56.06,Default,,0,0,0,,Мен сені бірінші өлтіремін, сосын жеймін.
Dialogue: 0,0:13:15.05,0:13:18.08,Default,,0,0,0,,Клеймор атты жауынгер суға батып кетті.
Dialogue: 0,0:13:18.08,0:13:21.01,Default,,0,0,0,,Бұл қайғылы оқиға, солай емес пе?
Dialogue: 0,0:13:21.01,0:13:22.08,Default,,0,0,0,,Тіпті әзіл-оспақ
Dialogue: 0,0:13:24.01,0:13:27.03,Default,,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:13:27.06,0:13:28.07,Default,,0,0,0,,Не?
Dialogue: 0,0:13:28.07,0:13:29.09,Default,,0,0,0,,1 4 0 0
Dialogue: 0,0:13:30.07,0:13:32.02,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:13:38.04,0:13:39.08,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:13:39.08,0:13:40.06,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:13:40.09,0:13:42.03,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:13:42.07,0:13:43.05,Default,,0,0,0,,I
Dialogue: 0,0:13:44.04,0:13:46.04,Default,,0,0,0,,Мен ояумын дейсіз бе?
Dialogue: 0,0:13:47.06,0:13:51.06,Default,,0,0,0,,Жооооо
Dialogue: 0,0:13:51.06,0:13:54.00,Default,,0,0,0,,Неліктен? Неге мен?
Dialogue: 0,0:13:54.00,0:13:57.04,Default,,0,0,0,,Ағамды жау еткім келді.
Dialogue: 0,0:13:57.05,0:14:02.07,Default,,0,0,0,,Бірақ мен неге сол құбыжық болуым керек?
Dialogue: 0,0:14:02.07,0:14:06.07,Default,,0,0,0,,Мұның бәрі сол бір мүйізді құбыжықтың кесірінен.
Dialogue: 0,0:14:21.09,0:14:23.04,Default,,0,0,0,,1 4 0 0
Dialogue: 0,0:14:23.08,0:14:25.07,Default,,0,0,0,,Оң қолымнан айырылдым.
Dialogue: 0,0:14:26.03,0:14:27.06,Default,,0,0,0,,Сіз мұны істедіңіз
Dialogue: 0,0:14:28.01,0:14:29.01,Default,,0,0,0,,Не?
Dialogue: 0,0:14:29.01,0:14:30.09,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:14:31.05,0:14:34.02,Default,,0,0,0,,Көбінесе сіз кінәлісіз.
Dialogue: 0,0:14:34.02,0:14:37.04,Default,,0,0,0,,Сенсіз мұның ешқайсысы болмас еді.
Dialogue: 0,0:14:37.09,0:14:40.02,Default,,0,0,0,,Бәріне сен кінәлісің.
Dialogue: 0,0:14:40.02,0:14:43.01,Default,,0,0,0,,Сен болмасаң, ағам да өлмес еді.
Dialogue: 0,0:14:43.01,0:14:45.09,Default,,0,0,0,,Мен де ешқашан мұндай болған емеспін.
Dialogue: 0,0:14:55.02,0:14:57.02,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:14:57.07,0:15:01.00,Default,,0,0,0,,Ұйым нөмірі 47 Клэр
Dialogue: 0,0:15:01.07,0:15:03.08,Default,,0,0,0,,Терезаның еті мен қанын мұра етті
Dialogue: 0,0:15:03.08,0:15:05.07,Default,,0,0,0,,Айриннің оң қолымен
Dialogue: 0,0:15:06.06,0:15:10.07,Default,,0,0,0,,Жалғыз мүйізді құбыжық Прискиланың басын аулайды.
Dialogue: 0,0:15:12.01,0:15:16.02,Default,,0,0,0,,Кешіріңіз, жаныңызды өзіммен бірге алып кетемін.
Dialogue: 0,0:15:26.01,0:15:27.08,Default,,0,0,0,,Ку шитга
Dialogue: 0,0:15:43.05,0:15:45.02,Default,,0,0,0,,Сыну нүктесін назардан тыс қалдырған
Dialogue: 0,0:15:45.07,0:15:49.08,Default,,0,0,0,,Жоқ, Айриннің қолы оған әлі толық үйренген жоқ.
Dialogue: 0,0:15:51.04,0:15:52.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:52.08,0:15:55.04,Default,,0,0,0,,Бұл несие.
Dialogue: 0,0:15:55.04,0:15:58.03,Default,,0,0,0,,Мен мұны бұрын бір жерден көрдім деп ойладым.
Dialogue: 0,0:15:58.03,0:15:59.05,Default,,0,0,0,,Бұл ол.
Dialogue: 0,0:15:59.05,0:16:02.08,Default,,0,0,0,,Әлгі қарғыс атқан әйел, Айриннің оң қолы.
Dialogue: 0,0:16:03.03,0:16:06.08,Default,,0,0,0,,Демек, сіз қысқа мерзімде соншалықты мықты бола алдыңыз ба?
Dialogue: 0,0:16:08.01,0:16:11.04,Default,,0,0,0,,Бір қолдың сиқырлы күшін толық босату
Dialogue: 0,0:16:11.04,0:16:17.07,Default,,0,0,0,,Бар болғаны сол бір қолды басқару және қолыңыздағы қылыш туралы ешқашан айтпау керек.
Dialogue: 0,0:16:17.07,0:16:19.01,Default,,0,0,0,,сияқты нәрсе
Dialogue: 0,0:16:19.07,0:16:21.09,Default,,0,0,0,,Әрең, сен.
Dialogue: 0,0:16:22.04,0:16:25.00,Default,,0,0,0,,Менің пропорционалды емес оң қолымның арқасында
Dialogue: 0,0:16:25.00,0:16:27.00,Default,,0,0,0,,Менің бүкіл денем дірілдеп тұр.
Dialogue: 0,0:16:48.05,0:16:53.07,Default,,0,0,0,,Мен адам ретінде барымды құйрығымның ұшына шоғырландырдым.
Dialogue: 0,0:16:53.07,0:16:56.06,Default,,0,0,0,,Демек, бұл менің әлсіз жерім.
Dialogue: 0,0:16:57.07,0:17:00.01,Default,,0,0,0,,Саа Ойын ойнайық
Dialogue: 0,0:17:00.06,0:17:04.04,Default,,0,0,0,,Осы жерге жету үшін мен туралы барлығын кесіп тастасаң
Dialogue: 0,0:17:04.04,0:17:05.06,Default,,0,0,0,,Сіз жеңдіңіз
Dialogue: 0,0:17:06.03,0:17:08.08,Default,,0,0,0,,Керісінше, жарты жолда энергиям таусылды.
Dialogue: 0,0:17:08.08,0:17:10.07,Default,,0,0,0,,Оянғанда
Dialogue: 0,0:17:10.07,0:17:12.01,Default,,0,0,0,,Менің жеңісім
Dialogue: 0,0:17:12.01,0:17:16.06,Default,,0,0,0,,Сіз бір мүйізді құбыжықпен күресуге жарамсыз едіңіз.
Dialogue: 0,0:17:16.09,0:17:17.08,Default,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:17:17.08,0:17:18.09,Default,,0,0,0,,Қызық көрінеді, солай ма?
Dialogue: 0,0:17:21.09,0:17:26.09,Default,,0,0,0,,Жеңілсем, мойынсұнып өз еркімді саған тапсырамын.
Dialogue: 0,0:17:36.00,0:17:37.04,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:17:37.04,0:17:39.07,Default,,0,0,0,,Менің айтқанымды елемеу
Dialogue: 0,0:17:39.07,0:17:41.07,Default,,0,0,0,,Мен осында тікелей көздейтінімді қалаймын.
Dialogue: 0,0:17:42.04,0:17:44.05,Default,,0,0,0,,Сен неге сонша үмітсізсің?
Dialogue: 0,0:17:45.02,0:17:47.00,Default,,0,0,0,,Өзін-өзі бұзушы
Dialogue: 0,0:17:47.00,0:17:51.00,Default,,0,0,0,,Артында қалғандар қалай сезінетінін ойламаңыз.
Dialogue: 0,0:17:51.07,0:17:52.03,Default,,0,0,0,,Бұл
Dialogue: 0,0:17:53.02,0:17:55.04,Default,,0,0,0,,Бұл кім туралы?
Dialogue: 0,0:17:58.00,0:17:59.07,Default,,0,0,0,,Енді тез қаш.
Dialogue: 0,0:18:00.02,0:18:01.07,Default,,0,0,0,,Мен оны тартамын
Dialogue: 0,0:18:04.07,0:18:07.04,Default,,0,0,0,,Қазір қашу керек.
Dialogue: 0,0:18:07.04,0:18:09.04,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:18:09.09,0:18:11.01,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:18:11.01,0:18:14.02,Default,,0,0,0,,Сіз мені қорғау үшін оған қарай бет алдыңыз ба?
Dialogue: 0,0:18:22.04,0:18:25.02,Default,,0,0,0,,Қолымнан келмесе де, жалғыз тұрамын
Dialogue: 0,0:18:25.06,0:18:27.06,Default,,0,0,0,,Өздігінен өледі
Dialogue: 0,0:18:30.08,0:18:32.07,Default,,0,0,0,,Мен оны қатты жек көремін.
Dialogue: 0,0:18:39.05,0:18:40.04,Default,,0,0,0,,Бұл, сөзсіз, қоңырау шалған жігіт сияқты. Ол «Юхамон» қолданушысы да, жау да емес.
Dialogue: 0,0:18:40.04,0:18:41.09,Default,,0,0,0,,Енді бітті
Dialogue: 0,0:18:41.09,0:18:43.07,Default,,0,0,0,,Бұл бәрінен бұрын.
Dialogue: 0,0:18:43.08,0:18:45.07,Default,,0,0,0,,Құтты болсын
Dialogue: 0,0:18:45.07,0:18:48.07,Default,,0,0,0,,Қозғалу, қозғалу, қозғалу
Dialogue: 0,0:18:51.00,0:18:52.00,Default,,0,0,0,,Жылжыту
Dialogue: 0,0:18:58.07,0:19:00.05,Default,,0,0,0,,Менің қолым кетіп қалды
Dialogue: 0,0:19:04.05,0:19:06.08,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:06.08,0:19:09.00,Default,,0,0,0,,Өз бетімен өлсең
Dialogue: 0,0:19:09.00,0:19:11.05,Default,,0,0,0,,Артында қалғандар не істеу керек?
Dialogue: 0,0:19:23.06,0:19:26.03,Default,,0,0,0,,Не? Мен мұны істей алмаймын.
Dialogue: 0,0:19:28.09,0:19:31.01,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:19:51.08,0:19:52.08,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:19:53.03,0:19:54.08,Default,,0,0,0,,Сіз жеңдіңіз
Dialogue: 0,0:19:55.04,0:19:58.04,Default,,0,0,0,,Уәде еткендей мен бәрін саған сеніп тапсырамын.
Dialogue: 0,0:19:59.00,0:20:02.03,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмадым.
Dialogue: 0,0:20:02.09,0:20:04.05,Default,,0,0,0,,Бұл мүлдем жиіркенішті.
Dialogue: 0,0:20:05.01,0:20:09.08,Default,,0,0,0,,Маған сен сияқты өмірін қатерге тіккендер ұнамайды.
Dialogue: 0,0:20:11.04,0:20:13.06,Default,,0,0,0,,Саа, аяқта.
Dialogue: 0,0:20:14.02,0:20:16.03,Default,,0,0,0,,Асықпасаң, қайта жанданады.
Dialogue: 0,0:20:17.02,0:20:18.05,Default,,0,0,0,,Офелия
Dialogue: 0,0:20:24.02,0:20:26.04,Default,,0,0,0,,Менің орнымда төбелесесің.
Dialogue: 0,0:20:26.08,0:20:28.07,Default,,0,0,0,,Егер жеңілсең, мен оны қабылдамаймын.
Dialogue: 0,0:20:36.08,0:20:38.08,Default,,0,0,0,,A. Түсінемін.
Dialogue: 0,0:20:39.01,0:20:41.03,Default,,0,0,0,,Үлкен ағаның соңғы күлкісі
Dialogue: 0,0:20:42.05,0:20:47.07,Default,,0,0,0,,Ағам мені қорғай алатынын растап жымиды.
Dialogue: 0,0:20:48.08,0:20:49.09,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:50.06,0:20:54.02,Default,,0,0,0,,Мен мұны қалай ұмыта бердім деп ойлаймын.
Dialogue: 0,0:20:55.08,0:20:58.02,Default,,0,0,0,,Кешіріңіз, аға.
Dialogue: 0,0:21:06.05,0:21:11.00,Default,,0,0,0,,Сол жерде тағы бірге ойнайық, ағайын.
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Қаңғыбас ойлар
Dialogue: 0,0:22:42.03,0:22:43.08,Default,,0,0,0,,Қаңғыбас жауынгер
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Қауіптердің пайда болуы
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
