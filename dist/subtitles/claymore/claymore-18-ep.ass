Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.05,Default,,0,0,0,,Төмен түсіңіз Төмен түсу Төмен түсу
Dialogue: 0,0:00:07.05,0:00:08.04,Default,,0,0,0,,Хауа
Dialogue: 0,0:00:08.04,0:00:09.09,Default,,0,0,0,,Кейт жеңілді
Dialogue: 0,0:00:11.07,0:00:13.00,Default,,0,0,0,,Люсия
Dialogue: 0,0:00:16.08,0:00:19.00,Default,,0,0,0,,Не?
Dialogue: 0,0:00:20.09,0:00:22.05,Default,,0,0,0,,Ақыры қылмыскер автобустан секіріп түсіп, көлік астында қалыпты.
Dialogue: 0,0:00:24.05,0:00:28.05,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:01:44.00,0:01:46.01,Default,,0,0,0,,Қашанға дейін менің соңымнан жүрмек ойың бар?
Dialogue: 0,0:01:48.03,0:01:51.04,Default,,0,0,0,,Мен саған сол жақсылығымды қайтармайынша.
Dialogue: 0,0:01:51.04,0:01:53.08,Default,,0,0,0,,Сенің жаныңнан кететін ойым жоқ.
Dialogue: 0,0:01:55.09,0:01:57.03,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:01:57.03,0:02:00.01,Default,,0,0,0,,Бұл өмір сенікі.
Dialogue: 0,0:02:03.09,0:02:07.01,Default,,0,0,0,,Мен де осындай жәрдемақы алдым.
Dialogue: 0,0:02:15.02,0:02:16.09,Default,,0,0,0,,Бұл керемет.
Dialogue: 0,0:02:18.03,0:02:20.09,Default,,0,0,0,,Мен бұл дағдыны сенен алдым.
Dialogue: 0,0:02:21.04,0:02:22.04,Default,,0,0,0,,Менен
Dialogue: 0,0:02:22.08,0:02:27.08,Default,,0,0,0,,Осы уақытқа дейін мен жоғары жылдамдықты қылышты басқаруға болады деп ешқашан ойлаған емеспін.
Dialogue: 0,0:02:28.03,0:02:31.09,Default,,0,0,0,,Бірақ мен сені сол жертөледе көргенде
Dialogue: 0,0:02:31.09,0:02:34.02,Default,,0,0,0,,Менің барлық ойым өзгерді
Dialogue: 0,0:02:35.08,0:02:38.01,Default,,0,0,0,,Денеңді оятсаң да
Dialogue: 0,0:02:38.05,0:02:40.06,Default,,0,0,0,,Адамның еркі қалады дейді
Dialogue: 0,0:02:40.06,0:02:43.07,Default,,0,0,0,,Сіз біздің санамыз бойынша мүмкін емес нәрсені жасадыңыз.
Dialogue: 0,0:02:45.02,0:02:46.07,Default,,0,0,0,,Бұл таң қалдырды.
Dialogue: 0,0:02:47.04,0:02:50.07,Default,,0,0,0,,Адамның ерік-жігерінің күші үлкен күшке айналады.
Dialogue: 0,0:02:52.02,0:02:54.06,Default,,0,0,0,,Сондықтан мен оны байқап көрейін деп ойладым.
Dialogue: 0,0:02:55.05,0:02:57.03,Default,,0,0,0,,Елес энергияға әрекет ету
Dialogue: 0,0:02:57.03,0:03:00.08,Default,,0,0,0,,Күшті ерік күшімен басқарылатын жоғары жылдамдықты қылыш.
Dialogue: 0,0:03:02.03,0:03:04.02,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:03:06.00,0:03:09.02,Default,,0,0,0,,Осыны жасағаным сіздің арқаңызда.
Dialogue: 0,0:03:10.07,0:03:12.06,Default,,0,0,0,,Бұл бетті жасамаңыз
Dialogue: 0,0:03:13.00,0:03:14.08,Default,,0,0,0,,Егер ол жоғалып кетсе, мен оны іздеймін.
Dialogue: 0,0:03:14.08,0:03:16.02,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:16.02,0:03:17.03,Default,,0,0,0,,Лувр
Dialogue: 0,0:03:21.03,0:03:22.02,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:03:22.06,0:03:23.09,Default,,0,0,0,,Қатысу сияқты
Dialogue: 0,0:03:27.02,0:03:28.06,Default,,0,0,0,,№ 5
Dialogue: 0,0:03:29.01,0:03:31.02,Default,,0,0,0,,Рафаэла Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:03:31.02,0:03:32.08,Default,,0,0,0,,Сіз таң қалған болуыңыз керек.
Dialogue: 0,0:03:33.03,0:03:36.04,Default,,0,0,0,,Бұл жігіт жындарды өшіруге шебер.
Dialogue: 0,0:03:37.05,0:03:40.01,Default,,0,0,0,,Жасырын операциялар үшін өте қолайлы.
Dialogue: 0,0:03:40.07,0:03:42.01,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:03:42.05,0:03:45.05,Default,,0,0,0,,Бұл жігітті екі адам да жеңе алмайды.
Dialogue: 0,0:03:46.00,0:03:48.02,Default,,0,0,0,,Бұл аздап ерекше.
Dialogue: 0,0:03:48.08,0:03:49.09,Default,,0,0,0,,Галатея
Dialogue: 0,0:03:50.04,0:03:52.00,Default,,0,0,0,,Галатеяға не болды?
Dialogue: 0,0:03:52.09,0:03:55.03,Default,,0,0,0,,Бастапқы міндеттерінен бас тарту
Dialogue: 0,0:03:55.03,0:03:58.07,Default,,0,0,0,,Ол тіпті осындай өтірік айтатын.
Dialogue: 0,0:03:59.07,0:04:01.07,Default,,0,0,0,,Есепті алғаннан кейін бірден
Dialogue: 0,0:04:01.07,0:04:03.07,Default,,0,0,0,,Мен оның басын бірден кесіп тастадым.
Dialogue: 0,0:04:06.03,0:04:08.05,Default,,0,0,0,,Мен мұны айтқым келеді
Dialogue: 0,0:04:08.05,0:04:11.07,Default,,0,0,0,,Бұл өте пайдалы жігіт.
Dialogue: 0,0:04:12.02,0:04:14.08,Default,,0,0,0,,Мен сенің өміріңді аядым.
Dialogue: 0,0:04:15.04,0:04:18.08,Default,,0,0,0,,Қиын миссиялар біраз уақытқа жалғасады.
Dialogue: 0,0:04:22.03,0:04:23.06,Default,,0,0,0,,Клэр
Dialogue: 0,0:04:23.06,0:04:26.05,Default,,0,0,0,,Мен сендерге тапсырма беруге келдім.
Dialogue: 0,0:04:26.09,0:04:28.07,Default,,0,0,0,,Егер бұл миссия болса
Dialogue: 0,0:04:29.01,0:04:31.09,Default,,0,0,0,,Солтүстікте бірнеше оянған адамдар пайда болды
Dialogue: 0,0:04:32.02,0:04:36.05,Default,,0,0,0,,7 және одан төмен сандар бірнеше жауынгердің өмірін қиды.
Dialogue: 0,0:04:37.02,0:04:41.02,Default,,0,0,0,,Сіздің ендігі міндетіңіз - бұл оятуды жою.
Dialogue: 0,0:04:42.09,0:04:45.04,Default,,0,0,0,,Ұйым белгілі бір адамдарды да дайындайды.
Dialogue: 0,0:04:46.01,0:04:48.06,Default,,0,0,0,,Демек, сен солардың бірісің.
Dialogue: 0,0:04:49.06,0:04:55.01,Default,,0,0,0,,Осы тапсырманы орындасаңыз, сізге ерекше кешірім жасалуы мүмкін сияқты.
Dialogue: 0,0:04:55.06,0:04:58.09,Default,,0,0,0,,Қашып жүрген сендерге жақсы мүмкіндік.
Dialogue: 0,0:04:59.06,0:05:02.05,Default,,0,0,0,,Маа, қорытынды жасауға асықпа.
Dialogue: 0,0:05:03.01,0:05:10.08,Default,,0,0,0,,Егер қаласақ, біз сізді кез келген уақытта тауып, өлтіретінімізді білуіңіз керек.
Dialogue: 0,0:05:11.09,0:05:13.06,Default,,0,0,0,,Ах, және
Dialogue: 0,0:05:14.04,0:05:16.06,Default,,0,0,0,,Сіз бірге болған бала
Dialogue: 0,0:05:17.00,0:05:19.04,Default,,0,0,0,,Олар солтүстікке қарай бет алған сияқты.
Dialogue: 0,0:05:22.09,0:05:25.05,Default,,0,0,0,,Мүмкін мен сені әлі іздеп жүрген шығармын
Dialogue: 0,0:05:25.09,0:05:27.01,Default,,0,0,0,,Рахи
Dialogue: 0,0:05:28.02,0:05:33.00,Default,,0,0,0,,Баланы қайта көргің келсе
Dialogue: 0,0:05:33.05,0:05:39.09,Default,,0,0,0,,Бақытымызға орай, солтүстік аймақ осы мақсат үшін өте қолайлы аймақ болып табылады.
Dialogue: 0,0:05:41.03,0:05:42.05,Default,,0,0,0,,Лувр
Dialogue: 0,0:05:56.06,0:05:57.08,Default,,0,0,0,,Ой
Dialogue: 0,0:05:59.01,0:06:00.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:01.00,0:06:04.04,Default,,0,0,0,,Неден басталады?
Dialogue: 0,0:06:05.08,0:06:08.00,Default,,0,0,0,,Солтүстік Құрлық Альфонс
Dialogue: 0,0:06:08.07,0:06:10.07,Default,,0,0,0,,Пьета, бастаулар қаласы?
Dialogue: 0,0:06:11.07,0:06:14.09,Default,,0,0,0,,Мен саған енді артымнан ерудің қажеті жоқ дедім.
Dialogue: 0,0:06:17.04,0:06:20.04,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:06:21.09,0:06:25.03,Default,,0,0,0,,Сен тірісің бе?
Dialogue: 0,0:06:25.03,0:06:26.02,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:06:26.07,0:06:28.07,Default,,0,0,0,,Біраз уақыт болды, Клэр.
Dialogue: 0,0:06:29.02,0:06:30.00,Default,,0,0,0,,Хелен
Dialogue: 0,0:06:36.03,0:06:39.00,Default,,0,0,0,,Ұзақ уақыттан кейін ескі доспен кездескеннен сәлем.
Dialogue: 0,0:06:39.05,0:06:41.03,Default,,0,0,0,,Кедергі жасамаңыз
Dialogue: 0,0:06:41.08,0:06:42.06,Default,,0,0,0,,Денев
Dialogue: 0,0:06:45.08,0:06:48.00,Default,,0,0,0,,Бұл сәлемдесу сынды емес.
Dialogue: 0,0:06:48.05,0:06:51.02,Default,,0,0,0,,Тіпті ескі таныстарыңызға да құрмет көрсетіңіз.
Dialogue: 0,0:06:51.07,0:06:53.05,Default,,0,0,0,,Бұл не, Клэр?
Dialogue: 0,0:06:53.05,0:06:56.01,Default,,0,0,0,,Сіз тағы да қыңыр болып көрінетін адаммен бірігіп жатырсыз.
Dialogue: 0,0:06:56.08,0:06:58.07,Default,,0,0,0,,Эй, сенің номерің қанша?
Dialogue: 0,0:06:59.00,0:07:00.09,Default,,0,0,0,,Айтайын дегенім, мен 22 жастамын.
Dialogue: 0,0:07:00.09,0:07:03.01,Default,,0,0,0,,Бұл жігіт 15 жаста.
Dialogue: 0,0:07:03.01,0:07:07.01,Default,,0,0,0,,Менің атым Джин, менің нөмірім 9.
Dialogue: 0,0:07:07.01,0:07:08.04,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:07:08.04,0:07:10.04,Default,,0,0,0,,Сан бір ғана цифр емес пе?
Dialogue: 0,0:07:11.00,0:07:13.04,Default,,0,0,0,,Клэр 47 саны.
Dialogue: 0,0:07:14.00,0:07:16.05,Default,,0,0,0,,Менің өмірімді Клэр сақтап қалды.
Dialogue: 0,0:07:17.00,0:07:20.04,Default,,0,0,0,,Оның сандарға қатысы бар ма?
Dialogue: 0,0:07:22.06,0:07:27.01,Default,,0,0,0,,Бір таңбалы сан әркімде болмайтын сияқты.
Dialogue: 0,0:07:29.03,0:07:31.00,Default,,0,0,0,,Менің атым Денев
Dialogue: 0,0:07:31.03,0:07:32.06,Default,,0,0,0,,Бұрын болған оқиға үшін кешіріңіз.
Dialogue: 0,0:07:32.09,0:07:37.00,Default,,0,0,0,,Бірақ маған сеніңіз, Хелен ешқандай зиян келтірмеді.
Dialogue: 0,0:07:37.06,0:07:40.02,Default,,0,0,0,,Жоқ, мен де үнсіз қалдым.
Dialogue: 0,0:07:41.00,0:07:44.02,Default,,0,0,0,,Бұл менің қасымда соғысып жатқан жолдастарыма айтатын сөздерім емес еді.
Dialogue: 0,0:07:44.02,0:07:47.05,Default,,0,0,0,,Жоқ, кешіріңіз, Джин.
Dialogue: 0,0:07:48.00,0:07:50.03,Default,,0,0,0,,Барлығың жиналыңдар.
Dialogue: 0,0:07:51.09,0:07:55.03,Default,,0,0,0,,Мен енді стратегияның контурын түсіндіремін.
Dialogue: 0,0:07:55.09,0:07:57.05,Default,,0,0,0,,Менің атым Флора
Dialogue: 0,0:07:58.00,0:08:00.02,Default,,0,0,0,,Ұйым нөмірі 8
Dialogue: 0,0:08:01.06,0:08:03.08,Default,,0,0,0,,Бұл 8 саны ма?
Dialogue: 0,0:08:04.05,0:08:08.00,Default,,0,0,0,,Иә, егер бір таңбалы сандары бар екі немесе одан да көп адам болса.
Dialogue: 0,0:08:08.00,0:08:10.07,Default,,0,0,0,,Көшбасшысың, себебі сен жассың.
Dialogue: 0,0:08:10.07,0:08:15.00,Default,,0,0,0,,Жоқ, менен кіші адамдар бар.
Dialogue: 0,0:08:16.03,0:08:18.02,Default,,0,0,0,,Ол көшбасшы
Dialogue: 0,0:08:26.07,0:08:27.06,Default,,0,0,0,,Милия
Dialogue: 0,0:08:42.03,0:08:45.00,Default,,0,0,0,,Бұл 6 саны
Dialogue: 0,0:08:45.05,0:08:47.02,Default,,0,0,0,,Мирия фантом
Dialogue: 0,0:08:48.08,0:08:52.06,Default,,0,0,0,,Әркім өз саласынан аянбай еңбек етті.
Dialogue: 0,0:08:53.00,0:08:56.05,Default,,0,0,0,,Менің атым Мирия, менің нөмірім 6.
Dialogue: 0,0:08:57.01,0:08:59.09,Default,,0,0,0,,Бұл жолғы миссия - осы солтүстік елде, Альфонста топырлап жүрген бірнеше Оянғандарды жою.
Dialogue: 0,0:09:02.01,0:09:08.07,Default,,0,0,0,,Бұл жолғы миссия солтүстіктегі Альфонста толып жатқан көптеген Оянған адамдарды жою.
Dialogue: 0,0:09:09.00,0:09:10.07,Default,,0,0,0,,Сондықтан бұл адам саны
Dialogue: 0,0:09:12.06,0:09:13.07,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:09:14.00,0:09:15.08,Default,,0,0,0,,Бірнеше оятқыш болса
Dialogue: 0,0:09:16.02,0:09:19.09,Default,,0,0,0,,Оның үстіне оянғандардың бірігіп топ құруы мүмкін емес.
Dialogue: 0,0:09:19.09,0:09:21.08,Default,,0,0,0,,Бірақ бұл рас
Dialogue: 0,0:09:24.07,0:09:26.08,Default,,0,0,0,,Бірнеше оятқыштар
Dialogue: 0,0:09:27.04,0:09:31.07,Default,,0,0,0,,Қорықсаң қашасың, қыздар.
Dialogue: 0,0:09:32.07,0:09:37.02,Default,,0,0,0,,Біздің міндетіміз жындармен және оянған адамдармен күресіп, оларды жеңу.
Dialogue: 0,0:09:37.06,0:09:40.08,Default,,0,0,0,,Егер сіз басқа адамға қарап, қорқып көрінсеңіз, бұл жақсы емес.
Dialogue: 0,0:09:41.02,0:09:42.09,Default,,0,0,0,,Енді тоқтамаңыз
Dialogue: 0,0:09:44.08,0:09:46.03,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:46.06,0:09:48.07,Default,,0,0,0,,Сіз өте иісшілсіз.
Dialogue: 0,0:09:48.07,0:09:51.04,Default,,0,0,0,,Жапония да үлкен қылышты арқасына көтереді.
Dialogue: 0,0:09:51.04,0:09:54.05,Default,,0,0,0,,11 саны. Болдырмау
Dialogue: 0,0:09:54.08,0:09:57.05,Default,,0,0,0,,Ол жауынгердің күші бар дейді.
Dialogue: 0,0:09:57.05,0:09:58.08,Default,,0,0,0,,Сол қос қолдар.
Dialogue: 0,0:10:00.03,0:10:03.00,Default,,0,0,0,,Менен сұрасаңыз
Dialogue: 0,0:10:03.00,0:10:07.02,Default,,0,0,0,,Төбелестен басқа ешнәрсеге қажет емес бұлшық еттерді көрсетіп жатқан кезде.
Dialogue: 0,0:10:07.08,0:10:10.00,Default,,0,0,0,,Мен өзімді шынымен кішкентай адам сияқты сезінемін.
Dialogue: 0,0:10:10.00,0:10:11.08,Default,,0,0,0,,Мен осылай айтамын.
Dialogue: 0,0:10:12.05,0:10:13.03,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:10:13.08,0:10:15.03,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:15.07,0:10:18.05,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:10:18.05,0:10:19.07,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:10:20.02,0:10:23.04,Default,,0,0,0,,Сіз мені естімеу үшін сөйлеп тұрмын деп ойладым.
Dialogue: 0,0:10:23.07,0:10:25.07,Default,,0,0,0,,Дауысы қатты шыққан сияқты
Dialogue: 0,0:10:27.01,0:10:29.07,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:10:29.07,0:10:32.03,Default,,0,0,0,,Әй, Денев, тоқтат.
Dialogue: 0,0:10:44.00,0:10:45.08,Default,,0,0,0,,Барлығың тыныш болыңдар.
Dialogue: 0,0:10:45.08,0:10:48.01,Default,,0,0,0,,Әңгіме әлі біткен жоқ
Dialogue: 0,0:10:48.06,0:10:50.09,Default,,0,0,0,,Әлі де шу шығарғың келсе
Dialogue: 0,0:10:52.02,0:10:54.09,Default,,0,0,0,,Мен сенің серігің боламын.
Dialogue: 0,0:11:01.09,0:11:03.04,Default,,0,0,0,,Жел флорасы
Dialogue: 0,0:11:03.08,0:11:05.05,Default,,0,0,0,,Ұйым нөмірі 8
Dialogue: 0,0:11:05.08,0:11:09.07,Default,,0,0,0,,Қылышты суырып, оны кесіп, қайтадан қынап алудың жалғыз әрекеті
Dialogue: 0,0:11:09.07,0:11:12.07,Default,,0,0,0,,Басқалардан жылдам және жақсы жауынгер
Dialogue: 0,0:11:13.05,0:11:14.09,Default,,0,0,0,,Джин мырза
Dialogue: 0,0:11:14.09,0:11:17.03,Default,,0,0,0,,Сіз де бір таңбалы сансыз.
Dialogue: 0,0:11:17.03,0:11:18.05,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:11:21.09,0:11:25.06,Default,,0,0,0,,және 11 саны Undine
Dialogue: 0,0:11:26.04,0:11:28.03,Default,,0,0,0,,13 саны Вероника
Dialogue: 0,0:11:28.03,0:11:29.04,Default,,0,0,0,,Алға шық.
Dialogue: 0,0:11:31.02,0:11:36.02,Default,,0,0,0,,Мені қосқанда, бұл бес адамның әрқайсысы капитан болады.
Dialogue: 0,0:11:36.09,0:11:39.08,Default,,0,0,0,,Барлығы 24 адам жиналды.
Dialogue: 0,0:11:39.08,0:11:42.07,Default,,0,0,0,,Ендеше бес команда құрыңдар.
Dialogue: 0,0:11:43.02,0:11:45.08,Default,,0,0,0,,Бір командадағы адам саны 45 адам.
Dialogue: 0,0:11:45.08,0:11:50.00,Default,,0,0,0,,Басқаша айтқанда, ол қалыпты ояту аңшылығы сияқты құрылымға ие.
Dialogue: 0,0:11:50.00,0:11:52.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:53.00,0:11:56.02,Default,,0,0,0,,Бұл стратегия ретінде ерекше ештеңе жоқ.
Dialogue: 0,0:11:56.05,0:11:59.03,Default,,0,0,0,,Бір команда бір оянған адамға қарсы
Dialogue: 0,0:11:59.07,0:12:00.09,Default,,0,0,0,,Бұл негіз
Dialogue: 0,0:12:02.02,0:12:03.06,Default,,0,0,0,,Ертең орындалады
Dialogue: 0,0:12:05.02,0:12:07.00,Default,,0,0,0,,Содан кейін командаларды бөліңіз.
Dialogue: 0,0:12:07.03,0:12:08.08,Default,,0,0,0,,Қарсылықтар қабылданбады
Dialogue: 0,0:12:09.07,0:12:11.06,Default,,0,0,0,,Сан 14 Синтия
Dialogue: 0,0:12:12.07,0:12:13.06,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:12:13.06,0:12:14.06,Default,,0,0,0,,Вероника командасы
Dialogue: 0,0:12:15.04,0:12:19.01,Default,,0,0,0,,№ 15 Денев Ундине командасы
Dialogue: 0,0:12:19.06,0:12:23.04,Default,,0,0,0,,№ 17 Элиза Джин командасы
Dialogue: 0,0:12:23.08,0:12:26.09,Default,,0,0,0,,№ 18 Лилия Флора командасы
Dialogue: 0,0:12:27.05,0:12:30.07,Default,,0,0,0,,№20 Queenie Milia командасы
Dialogue: 0,0:12:31.01,0:12:34.09,Default,,0,0,0,,№ 22 Хелен Вероника командасы
Dialogue: 0,0:12:34.09,0:12:37.08,Default,,0,0,0,,Бұл не? Бұл Мирия командасы емес пе?
Dialogue: 0,0:12:35.03,0:12:39.01,Default,,0,0,0,,№ 24 Zelda Undine командасы
Dialogue: 0,0:12:39.06,0:12:43.02,Default,,0,0,0,,№ 27 Emelia Gene Team
Dialogue: 0,0:12:59.07,0:13:02.08,Default,,0,0,0,,Мен оны кие алмас едім.
Dialogue: 0,0:13:02.08,0:13:03.09,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:13:04.04,0:13:07.07,Default,,0,0,0,,Қайда бара жатқаның ешкімді қызықтырмайды.
Dialogue: 0,0:13:08.08,0:13:10.07,Default,,0,0,0,,Барлығы жиналып қалды.
Dialogue: 0,0:13:14.05,0:13:16.08,Default,,0,0,0,,Тағы бір соңғы келу.
Dialogue: 0,0:13:18.02,0:13:19.02,Default,,0,0,0,,Милия
Dialogue: 0,0:13:20.02,0:13:21.07,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:13:28.09,0:13:30.05,Default,,0,0,0,,Бұл кездесуді еске алу.
Dialogue: 0,0:13:39.07,0:13:42.02,Default,,0,0,0,,Барлығы жақсы өмір сүрді.
Dialogue: 0,0:13:42.09,0:13:44.02,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:13:47.09,0:13:49.07,Default,,0,0,0,,Онда кім бар?
Dialogue: 0,0:13:54.00,0:13:56.01,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру— Клэр
Dialogue: 0,0:13:56.01,0:13:57.08,Default,,0,0,0,,Міне солай болды.
Dialogue: 0,0:13:57.08,0:13:59.06,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:14:00.01,0:14:02.03,Default,,0,0,0,,Ген бізбен бірдей позицияда.
Dialogue: 0,0:14:04.04,0:14:08.08,Default,,0,0,0,,Мен ескі достардың кездесуіне кедергі келтіргім келмеді.
Dialogue: 0,0:14:08.08,0:14:12.03,Default,,0,0,0,,Мен де туыс емес сияқтымын.
Dialogue: 0,0:14:16.02,0:14:19.04,Default,,0,0,0,,Дене оянған күйден оралу?
Dialogue: 0,0:14:20.00,0:14:23.01,Default,,0,0,0,,Ерекше психикалық күштің арқасында болуы мүмкін
Dialogue: 0,0:14:23.01,0:14:24.05,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:14:25.02,0:14:28.06,Default,,0,0,0,,Клэр Мен мұны алғаш кездескен кезде байқадым.
Dialogue: 0,0:14:28.06,0:14:30.08,Default,,0,0,0,,Бұл оң қол да басқа.
Dialogue: 0,0:14:31.03,0:14:35.00,Default,,0,0,0,,Мен оны айтарлықтай күшке ие біреудің оң қолы ретінде көрдім.
Dialogue: 0,0:14:36.00,0:14:37.01,Default,,0,0,0,,Кімнің?
Dialogue: 0,0:14:37.01,0:14:39.02,Default,,0,0,0,,Оң қол
Dialogue: 0,0:14:39.06,0:14:41.04,Default,,0,0,0,,Кешіріңіз, бірақ мен олай айта алмаймын.
Dialogue: 0,0:14:42.01,0:14:46.03,Default,,0,0,0,,Жағдайыңыз жақсармай тұрған сияқты.
Dialogue: 0,0:14:46.03,0:14:48.05,Default,,0,0,0,,Бұл тек мен емес
Dialogue: 0,0:14:49.03,0:14:53.05,Default,,0,0,0,,Осы жолы жиналған барлық 24 адам туралы да солай айтуға болады.
Dialogue: 0,0:14:55.06,0:15:00.07,Default,,0,0,0,,Бұл стратегияның сәтті болу ықтималдығы қандай?
Dialogue: 0,0:15:03.04,0:15:06.09,Default,,0,0,0,,Бұл стратегияда табысқа жету ықтималдығы нөлге тең.
Dialogue: 0,0:15:07.05,0:15:08.00,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:15:09.05,0:15:11.06,Default,,0,0,0,,Тек бірнеше оянған адамдар болса
Dialogue: 0,0:15:11.06,0:15:14.06,Default,,0,0,0,,Табыстың ықтималдығы нөлге тең емес
Dialogue: 0,0:15:14.06,0:15:18.07,Default,,0,0,0,,Бірақ олардың артында біреу күтіп тұр.
Dialogue: 0,0:15:19.01,0:15:21.04,Default,,0,0,0,,Барлық әрекеттер бекер
Dialogue: 0,0:15:21.04,0:15:23.09,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:24.07,0:15:27.06,Default,,0,0,0,,Солтүстік жерді билеуші күміс патша
Dialogue: 0,0:15:28.01,0:15:30.08,Default,,0,0,0,,Тұңғиықтағы Исли
Dialogue: 0,0:15:31.05,0:15:33.03,Default,,0,0,0,,Бірінші абиссаль
Dialogue: 0,0:15:34.00,0:15:35.04,Default,,0,0,0,,Эйсли
Dialogue: 0,0:15:36.00,0:15:37.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:37.05,0:15:46.07,Default,,0,0,0,,Бұл операцияның мәні солтүстіктегі барлық Оянғандарды және оларды сахнаның артында басқаратын Абиссалды Ислиді бағындыру болып табылады.
Dialogue: 0,0:15:47.02,0:15:48.00,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:15:49.01,0:15:51.03,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:15:51.03,0:15:53.08,Default,,0,0,0,,Ұйым не ойлады?
Dialogue: 0,0:15:54.05,0:15:55.02,Default,,0,0,0,,Хелен
Dialogue: 0,0:16:00.08,0:16:05.03,Default,,0,0,0,,Ұйымның мақсаты қарсы шараларды әзірлеу үшін уақытты ұту болуы мүмкін.
Dialogue: 0,0:16:06.00,0:16:07.01,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:16:07.06,0:16:09.02,Default,,0,0,0,,Жай ғана лақтырылатын бөлік
Dialogue: 0,0:16:13.07,0:16:16.08,Default,,0,0,0,,Бұл Пиета қаласы ма?
Dialogue: 0,0:16:16.08,0:16:19.04,Default,,0,0,0,,Бірақ біз бірге жиналдық.
Dialogue: 0,0:16:19.04,0:16:20.05,Default,,0,0,0,,Неше адам бар?
Dialogue: 0,0:16:20.09,0:16:22.01,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:16:24.00,0:16:25.05,Default,,0,0,0,,24 адам.
Dialogue: 0,0:16:27.02,0:16:30.00,Default,,0,0,0,,Қанша адам болса да, бәріміз бірдейміз.
Dialogue: 0,0:16:30.05,0:16:32.00,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:16:32.00,0:16:33.03,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:16:33.03,0:16:35.09,Default,,0,0,0,,Біздің рөліміз алдыңғы шептегі барлау болады.
Dialogue: 0,0:16:36.09,0:16:40.08,Default,,0,0,0,,Менің алдымда сүйкімді жасөспірімдер жиналып қалды.
Dialogue: 0,0:16:41.01,0:16:43.06,Default,,0,0,0,,Сіз араласпауыңыз керек.
Dialogue: 0,0:16:43.06,0:16:45.06,Default,,0,0,0,,Кем дегенде сәлемдесу
Dialogue: 0,0:16:47.06,0:16:50.00,Default,,0,0,0,,Мен оны жоғалттым, бірінші қадам жасалды.
Dialogue: 0,0:16:58.02,0:16:59.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:00.03,0:17:02.02,Default,,0,0,0,,Содан кейін бірінші барыңыз.
Dialogue: 0,0:17:04.02,0:17:06.08,Default,,0,0,0,,А, мен кеттім.
Dialogue: 0,0:17:06.08,0:17:09.03,Default,,0,0,0,,Оған мүлдем көмектесу мүмкін емес.
Dialogue: 0,0:17:14.02,0:17:15.08,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:17:15.08,0:17:17.09,Default,,0,0,0,,Пиета қаласының тұрғындары
Dialogue: 0,0:17:21.05,0:17:23.09,Default,,0,0,0,,Ал қош бол
Dialogue: 0,0:17:25.00,0:17:26.00,Default,,0,0,0,,Канжу Нагаре
Dialogue: 0,0:17:37.05,0:17:39.07,Default,,0,0,0,,Ол өте жақсы қозғалады.
Dialogue: 0,0:17:41.02,0:17:43.02,Default,,0,0,0,,Барлық мүшелер жиналыңдар.
Dialogue: 0,0:17:47.00,0:17:50.00,Default,,0,0,0,,Бұл керемет.
Dialogue: 0,0:17:50.03,0:17:54.05,Default,,0,0,0,,Осыншама қыздың ортасында жүрген сирек.
Dialogue: 0,0:17:55.00,0:17:58.03,Default,,0,0,0,,Алдағы жауды біздің Милия командасы басқарады.
Dialogue: 0,0:17:58.06,0:18:00.06,Default,,0,0,0,,Флора командасы оң жақ төбеде
Dialogue: 0,0:18:00.06,0:18:04.00,Default,,0,0,0,,Ген тобына сол жақтағы тас бағананың үстіндегі адам шабуыл жасады.
Dialogue: 0,0:18:04.05,0:18:07.00,Default,,0,0,0,,Undine Veronica командасы күту режимінде
Dialogue: 0,0:18:07.00,0:18:09.07,Default,,0,0,0,,Жағдайға байланысты әлсіз топқа барыңыз.
Dialogue: 0,0:18:10.02,0:18:11.03,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:18:11.07,0:18:15.01,Default,,0,0,0,,Мен кенеттен шабуылға ұшырадым деп ойладым.
Dialogue: 0,0:18:15.01,0:18:17.02,Default,,0,0,0,,Сіз таңқаларлық сабырлы болдыңыз.
Dialogue: 0,0:18:17.02,0:18:21.00,Default,,0,0,0,,Мен абыржуды пайдаланып, дәмді нәрсе әкелуді жоспарладым.
Dialogue: 0,0:18:21.00,0:18:22.08,Default,,0,0,0,,Әлдеқашан тозған
Dialogue: 0,0:18:22.08,0:18:26.05,Default,,0,0,0,,Менің ойымша, ол бірнеше рет көп ретсіздікті басынан өткерді.
Dialogue: 0,0:18:26.09,0:18:28.02,Default,,0,0,0,,Ол жақсы көшбасшы.
Dialogue: 0,0:18:28.07,0:18:29.05,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:32.08,0:18:39.03,Default,,0,0,0,,Оянушыларға бәрі бірдей үйренбегенін ұмытасың.
Dialogue: 0,0:18:39.03,0:18:40.03,Default,,0,0,0,,Кеттік
Dialogue: 0,0:18:47.01,0:18:48.04,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:18:49.02,0:18:50.06,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:18:50.06,0:18:52.06,Default,,0,0,0,,Кішкене қозғалыс
Dialogue: 0,0:18:55.01,0:18:55.51,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:18:56.09,0:19:02.02,Default,,0,0,0,,39 47 саны менің командама пайдалы емес шығар.
Dialogue: 0,0:19:05.03,0:19:08.05,Default,,0,0,0,,Оянған денеге айналмас бұрын ойынды шешіңіз
Dialogue: 0,0:19:11.00,0:19:12.00,Default,,0,0,0,,Яғни
Dialogue: 0,0:19:13.00,0:19:14.08,Default,,0,0,0,,Қылыш траекториясы майысқан
Dialogue: 0,0:19:20.04,0:19:22.02,Default,,0,0,0,,Бұл жігіт жындарды басқарады.
Dialogue: 0,0:19:22.02,0:19:25.00,Default,,0,0,0,,Денеңізді басқа адамның сиқырлы энергиясымен үйлестіре отырып, манипуляциялаңыз.
Dialogue: 0,0:19:26.04,0:19:27.05,Default,,0,0,0,,Дене
Dialogue: 0,0:19:31.08,0:19:34.00,Default,,0,0,0,,Дененің қозғалуы
Dialogue: 0,0:19:37.00,0:19:39.00,Default,,0,0,0,,Өтінемін, қашыңыз
Dialogue: 0,0:19:39.07,0:19:42.08,Default,,0,0,0,,Мен денемнің айтқанын тыңдамаймын
Dialogue: 0,0:19:46.04,0:19:48.08,Default,,0,0,0,,Тез қашыңыз
Dialogue: 0,0:19:54.01,0:19:56.02,Default,,0,0,0,,Айриннен сұраңыз
Dialogue: 0,0:20:02.08,0:20:04.04,Default,,0,0,0,,Не?
Dialogue: 0,0:20:04.04,0:20:06.05,Default,,0,0,0,,Оның оң қолы ерекше.
Dialogue: 0,0:20:13.05,0:20:15.04,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:20:15.04,0:20:17.06,Default,,0,0,0,,Бұл өте қызық болып барады.
Dialogue: 0,0:20:17.06,0:20:20.04,Default,,0,0,0,,Өйткені бұл
Dialogue: 0,0:20:20.04,0:20:22.06,Default,,0,0,0,,Сіз құбыжық болуды тоқтата алмайсыз.
Dialogue: 0,0:20:27.09,0:20:31.03,Default,,0,0,0,,Бәрің де бөлініп кетті.
Dialogue: 0,0:20:35.01,0:20:37.07,Default,,0,0,0,,Ей, сен басшы болмайсың.
Dialogue: 0,0:20:38.03,0:20:41.07,Default,,0,0,0,,Сіз оны пайдалана алмайтыныңызды басынан бастап білуіңіз керек еді.
Dialogue: 0,0:20:42.02,0:20:45.03,Default,,0,0,0,,Мен оны қимаймын, соңына дейін қорғауға тырысамын
Dialogue: 0,0:20:45.03,0:20:47.04,Default,,0,0,0,,Нашар үйлестіру
Dialogue: 0,0:20:47.04,0:20:49.03,Default,,0,0,0,,Нәтиже – бұл
Dialogue: 0,0:20:49.06,0:20:52.07,Default,,0,0,0,,О дүниеде достарыңнан кешірім сұрама.
Dialogue: 0,0:20:57.01,0:21:00.09,Default,,0,0,0,,Сіздің ұрысыңыз оны қару ретінде пайдаланып жатқан сияқты.
Dialogue: 0,0:21:00.09,0:21:02.01,Default,,0,0,0,,Мен көмекке келдім.
Dialogue: 0,0:21:02.05,0:21:03.06,Default,,0,0,0,,Хелен
Dialogue: 0,0:21:10.01,0:21:11.00,Default,,0,0,0,,Денев
Dialogue: 0,0:21:11.04,0:21:13.01,Default,,0,0,0,,Қаһарлы жауға ұқсайды.
Dialogue: 0,0:21:13.01,0:21:14.03,Default,,0,0,0,,Көмекке келді
Dialogue: 0,0:21:14.03,0:21:16.01,Default,,0,0,0,,Өздеріңізді бекітіңіздер
Dialogue: 0,0:21:16.05,0:21:18.03,Default,,0,0,0,,Барлығын бірден аяқтаймын.
Dialogue: 0,0:21:22.08,0:21:24.01,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Ақ жер
Dialogue: 0,0:22:42.03,0:22:43.08,Default,,0,0,0,,Ақ түн
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Қошмар ашылды
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
