Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.05,0:00:20.08,Default,,0,0,0,,Қандай да бір себепті,
Dialogue: 0,0:00:21.03,0:00:24.05,Default,,0,0,0,,Неге менің басым анық?
Dialogue: 0,0:00:25.01,0:00:27.01,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:00:58.09,0:01:00.08,Default,,0,0,0,,Тек сен
Dialogue: 0,0:01:01.01,0:01:03.07,Default,,0,0,0,,Тек сен
Dialogue: 0,0:01:11.02,0:01:14.00,Default,,0,0,0,,Ол кездегіден басқаша.
Dialogue: 0,0:01:14.05,0:01:15.07,Default,,0,0,0,,Мен
Dialogue: 0,0:01:19.06,0:01:22.04,Default,,0,0,0,,Мен сенен қорықпаймын
Dialogue: 0,0:01:23.07,0:01:26.00,Default,,0,0,0,,Сіз
Dialogue: 0,0:01:30.03,0:01:32.00,Default,,0,0,0,,Сіз
Dialogue: 0,0:02:47.08,0:02:49.07,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:02:50.01,0:02:51.08,Default,,0,0,0,,Әке немесе ана
Dialogue: 0,0:02:51.08,0:02:53.02,Default,,0,0,0,,Барлығы
Dialogue: 0,0:02:53.07,0:02:55.03,Default,,0,0,0,,Сол сияқты
Dialogue: 0,0:03:07.07,0:03:12.03,Default,,0,0,0,,Сатқынды өлтірме
Dialogue: 0,0:03:12.08,0:03:13.08,Default,,0,0,0,,Жындар
Dialogue: 0,0:03:20.01,0:03:23.09,Default,,0,0,0,,Сіз біз кездескен кездегі Присциллаға қайта оралған сияқтысыз.
Dialogue: 0,0:03:26.00,0:03:29.07,Default,,0,0,0,,Бірақ оянғалы тұрған балшық
Dialogue: 0,0:03:30.03,0:03:33.01,Default,,0,0,0,,Бұл біртүрлі күш тепе-теңдігі, бірақ
Dialogue: 0,0:03:42.02,0:03:43.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:44.01,0:03:46.06,Default,,0,0,0,,Ұйымдар да әртүрлі істермен айналысады.
Dialogue: 0,0:03:47.04,0:03:48.05,Default,,0,0,0,,Қызықты
Dialogue: 0,0:03:49.01,0:03:51.06,Default,,0,0,0,,Маған жақынырақ қарап көрейін.
Dialogue: 0,0:03:53.08,0:03:55.03,Default,,0,0,0,,Прискила
Dialogue: 0,0:03:56.00,0:03:57.04,Default,,0,0,0,,Тек сен
Dialogue: 0,0:04:05.02,0:04:06.04,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:04:06.04,0:04:08.07,Default,,0,0,0,,Клэрдің күші қайтадан өсті.
Dialogue: 0,0:04:10.01,0:04:11.04,Default,,0,0,0,,Прискила?
Dialogue: 0,0:04:11.08,0:04:14.03,Default,,0,0,0,,Мен бұл туралы естігенмін, бірақ қазір оны көруге шыдамаймын.
Dialogue: 0,0:04:14.06,0:04:16.09,Default,,0,0,0,,«Күліп тұрған Терезаны» өлтірген ол.
Dialogue: 0,0:04:17.04,0:04:19.04,Default,,0,0,0,,Оның тірі болуы ғажап емес.
Dialogue: 0,0:04:19.04,0:04:20.06,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:04:20.06,0:04:24.02,Default,,0,0,0,,Клэр Присциллаға неге сонша құмар?
Dialogue: 0,0:04:25.00,0:04:27.05,Default,,0,0,0,,Клэр оянып кеткен болатын.
Dialogue: 0,0:04:27.09,0:04:31.03,Default,,0,0,0,,Төңкеру көп нәрсені білдіреді
Dialogue: 0,0:04:33.04,0:04:35.03,Default,,0,0,0,,Біз не білеміз?
Dialogue: 0,0:04:38.01,0:04:39.04,Default,,0,0,0,,Мирия-нисан
Dialogue: 0,0:04:41.06,0:04:44.04,Default,,0,0,0,,Ұйымды зерттеу кезінде
Dialogue: 0,0:04:44.04,0:04:46.01,Default,,0,0,0,,Мен мұны кездейсоқ білдім.
Dialogue: 0,0:04:48.01,0:04:53.03,Default,,0,0,0,,Балалар, сендер Клэрдің саны 47, ең әлсіз дәрежесіңдер.
Dialogue: 0,0:04:53.03,0:04:57.06,Default,,0,0,0,,Уақытты көрсететін күш тепе-теңдігі біртүрлі деп ойладыңыз ба?
Dialogue: 0,0:04:58.08,0:04:59.09,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:59.09,0:05:02.01,Default,,0,0,0,,Мен оны тұрақсыз деп ойладым.
Dialogue: 0,0:05:02.07,0:05:04.06,Default,,0,0,0,,Оның себебі бар еді.
Dialogue: 0,0:05:05.01,0:05:08.01,Default,,0,0,0,,Клэр біз сияқты жартылай адам және жартылай жын емес.
Dialogue: 0,0:05:08.08,0:05:13.03,Default,,0,0,0,,Ол денеге сіңген нәрсе жынның еті мен қаны емес еді.
Dialogue: 0,0:05:13.03,0:05:14.07,Default,,0,0,0,,Жауынгер.
Dialogue: 0,0:05:19.06,0:05:21.03,Default,,0,0,0,,Жауынгердің аты кім?
Dialogue: 0,0:05:30.00,0:05:31.05,Default,,0,0,0,,«Күліп тұрған Тереза»
Dialogue: 0,0:05:36.05,0:05:37.09,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:05:37.09,0:05:39.02,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:05:40.01,0:05:42.05,Default,,0,0,0,,Клэр мұны өзі қаласа керек.
Dialogue: 0,0:05:44.06,0:05:48.08,Default,,0,0,0,,Терезамен байланысы болған шығар.
Dialogue: 0,0:05:50.06,0:05:53.08,Default,,0,0,0,,Әрине, ұйымдар жанашырлықпен әрекет ете алмайды.
Dialogue: 0,0:05:54.04,0:05:56.03,Default,,0,0,0,,Бұл жаңа эксперимент болды.
Dialogue: 0,0:05:57.01,0:06:00.07,Default,,0,0,0,,Жындардың орнына жауынгерлерден жауынгер жасай аламыз ба?
Dialogue: 0,0:06:03.03,0:06:05.00,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:06:05.00,0:06:07.01,Default,,0,0,0,,Ұйым осылай істейтін еді.
Dialogue: 0,0:06:07.06,0:06:08.08,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:09.05,0:06:13.03,Default,,0,0,0,,Клэр Присцилланы кек алу ретінде көздеп отыр ма?
Dialogue: 0,0:06:13.03,0:06:15.00,Default,,0,0,0,,(Изуку) Урарака ханым. (Урарака) Иә!
Dialogue: 0,0:06:15.06,0:06:18.09,Default,,0,0,0,,Бірақ Клэрдің қазіргі күйінде
Dialogue: 0,0:06:19.03,0:06:22.07,Default,,0,0,0,,Шайқас аяқталмай тұрып, толық ояныңыз
Dialogue: 0,0:06:24.02,0:06:26.06,Default,,0,0,0,,Тіпті оянсаңыз да
Dialogue: 0,0:06:26.06,0:06:28.05,Default,,0,0,0,,Сіз Присцилланы жеңе аласыз ба?
Dialogue: 0,0:06:30.09,0:06:32.00,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:06:35.08,0:06:37.03,Default,,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:06:37.09,0:06:41.04,Default,,0,0,0,,Сенің адам болып өлуіңе келіскен мен едім.
Dialogue: 0,0:06:41.08,0:06:43.08,Default,,0,0,0,,Оянғандарды бірдеңе жасауға мәжбүрлеуім керек пе?
Dialogue: 0,0:06:44.05,0:06:47.05,Default,,0,0,0,,Бұл болмайды, Клэр.
Dialogue: 0,0:07:14.08,0:07:15.07,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:07:21.03,0:07:25.05,Default,,0,0,0,,Мирия мен басқалары бізге баратын жерді тастап кеткен сияқты.
Dialogue: 0,0:07:42.01,0:07:44.03,Default,,0,0,0,,Сұрауға бола ма?
Dialogue: 0,0:07:48.00,0:07:50.06,Default,,0,0,0,,Неліктен сен Клэрді сонша уайымдайсың?
Dialogue: 0,0:07:52.01,0:07:54.01,Default,,0,0,0,,Өйткені бұл өмірді сақтап қалды.
Dialogue: 0,0:07:57.02,0:08:00.03,Default,,0,0,0,,Мен адам емес, басқа нәрсе болуға тырыстым.
Dialogue: 0,0:08:01.00,0:08:03.03,Default,,0,0,0,,Клэр мені құтқарды
Dialogue: 0,0:08:05.07,0:08:09.06,Default,,0,0,0,,Клэрге ол сақтап қалған өмірін қайтарыңыз.
Dialogue: 0,0:08:10.02,0:08:11.04,Default,,0,0,0,,Осымен
Dialogue: 0,0:08:13.09,0:08:14.09,Default,,0,0,0,,Жоспар
Dialogue: 0,0:08:15.06,0:08:17.07,Default,,0,0,0,,Клэр мені де құтқарды.
Dialogue: 0,0:08:18.08,0:08:22.09,Default,,0,0,0,,Сондықтан мен Клэрге көмектескім келді.
Dialogue: 0,0:08:24.03,0:08:25.04,Default,,0,0,0,,Клэр
Dialogue: 0,0:08:32.04,0:08:33.08,Default,,0,0,0,,бір нәрсе үшін
Dialogue: 0,0:08:34.01,0:08:36.03,Default,,0,0,0,,Кім біреу үшін күресіп жатыр?
Dialogue: 0,0:08:36.07,0:08:38.02,Default,,0,0,0,,Клэр де менімен бірге.
Dialogue: 0,0:08:41.04,0:08:44.07,Default,,0,0,0,,Клэр қазір күресіп жатқан Оянған
Dialogue: 0,0:08:44.07,0:08:47.06,Default,,0,0,0,,Ол Клэрден маңызды нәрсені ұрлады.
Dialogue: 0,0:08:48.03,0:08:52.06,Default,,0,0,0,,Бірақ Клэрді тірі қалдырған адамдар бар.
Dialogue: 0,0:08:54.09,0:08:55.09,Default,,0,0,0,,Клэр
Dialogue: 0,0:08:56.08,0:08:59.03,Default,,0,0,0,,Мен жоғалтқаным үшін
Dialogue: 0,0:08:59.07,0:09:03.04,Default,,0,0,0,,Және жоғалтқыңыз келмейтін нәрсе үшін күресіңіз
Dialogue: 0,0:09:04.02,0:09:06.03,Default,,0,0,0,,Бұл Клэрдің айтқан сөздері.
Dialogue: 0,0:09:08.01,0:09:11.00,Default,,0,0,0,,Мүмкін бәрі осылай өмір сүретін шығар.
Dialogue: 0,0:09:13.02,0:09:17.01,Default,,0,0,0,,Клэр жынға айналмайды.
Dialogue: 0,0:09:19.01,0:09:19.51,Default,,0,0,0,,О
Dialogue: 0,0:09:33.09,0:09:34.09,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:09:36.03,0:09:38.08,Default,,0,0,0,,Бұл әлсіз болды ма?
Dialogue: 0,0:09:41.06,0:09:45.02,Default,,0,0,0,,Шынында не болды?
Dialogue: 0,0:09:46.05,0:09:47.07,Default,,0,0,0,,Тереза
Dialogue: 0,0:09:48.08,0:09:50.07,Default,,0,0,0,,Тереза
Dialogue: 0,0:10:01.04,0:10:02.02,Default,,0,0,0,,Тереза
Dialogue: 0,0:10:05.00,0:10:05.50,Default,,0,0,0,,О.
Dialogue: 0,0:10:06.05,0:10:09.06,Default,,0,0,0,,Бұл есімді айтпайсыз ба
Dialogue: 0,0:10:10.09,0:10:13.01,Default,,0,0,0,,Бұл сен кінәлі, солай емес пе?
Dialogue: 0,0:10:13.06,0:10:18.03,Default,,0,0,0,,Әкем, анам, ағаларым және Айрин
Dialogue: 0,0:10:19.03,0:10:22.02,Default,,0,0,0,,Барлығына осындай қорқынышты істер жасау
Dialogue: 0,0:10:25.03,0:10:28.01,Default,,0,0,0,,Бұл Терезаның кінәсі.
Dialogue: 0,0:10:28.01,0:10:31.07,Default,,0,0,0,,Айтпа деп тұрмын.
Dialogue: 0,0:11:10.09,0:11:13.09,Default,,0,0,0,,Енді осымен аяқтаймыз.
Dialogue: 0,0:11:16.00,0:11:19.01,Default,,0,0,0,,сіз
Dialogue: 0,0:11:24.04,0:11:29.04,Default,,0,0,0,,Мен сізді неге қорқынышты деп ойладым деп ойлаймын.
Dialogue: 0,0:11:32.03,0:11:35.04,Default,,0,0,0,,Сіз мені оңай өлтіре аласыз
Dialogue: 0,0:11:40.08,0:11:43.09,Default,,0,0,0,,Қош бол Тереза
Dialogue: 0,0:11:52.08,0:11:54.05,Default,,0,0,0,,Бұл ауырмайды.
Dialogue: 0,0:12:11.07,0:12:13.01,Default,,0,0,0,,Клэр
Dialogue: 0,0:12:13.01,0:12:14.09,Default,,0,0,0,,Сіз өзіңіз сияқтысыз.
Dialogue: 0,0:12:15.04,0:12:17.07,Default,,0,0,0,,Сен кетсең, мен түсінбеймін.
Dialogue: 0,0:12:19.09,0:12:20.07,Default,,0,0,0,,Хелен
Dialogue: 0,0:12:21.06,0:12:22.05,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:12:30.05,0:12:31.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:31.06,0:12:33.00,Default,,0,0,0,,Бұл Присцилла ма?
Dialogue: 0,0:12:33.08,0:12:36.00,Default,,0,0,0,,Бұндай ештеңе жоқ
Dialogue: 0,0:12:36.03,0:12:37.03,Default,,0,0,0,,О.
Dialogue: 0,0:12:37.03,0:12:39.03,Default,,0,0,0,,Баршаңызға сәттілік.
Dialogue: 0,0:12:39.08,0:12:42.02,Default,,0,0,0,,Ол білмейтін сияқты.
Dialogue: 0,0:12:42.02,0:12:46.00,Default,,0,0,0,,Сіз жаңа жауынгерсіз бе?
Dialogue: 0,0:12:47.01,0:12:50.05,Default,,0,0,0,,Мен №2 Присцилламын.
Dialogue: 0,0:12:50.08,0:12:51.07,Default,,0,0,0,,Не?
Dialogue: 0,0:12:52.04,0:12:53.09,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:12:54.05,0:12:57.07,Default,,0,0,0,,Жад ояту алдында тоқтайды
Dialogue: 0,0:12:58.05,0:13:01.07,Default,,0,0,0,,Жоқ, сіз абдырап қалдым дедіңіз.
Dialogue: 0,0:13:02.07,0:13:05.08,Default,,0,0,0,,Хелен Денев Оңға және солға бұрылыңыз.
Dialogue: 0,0:13:06.03,0:13:08.03,Default,,0,0,0,,Мен майданнан барамын
Dialogue: 0,0:13:08.03,0:13:09.02,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:09.07,0:13:10.08,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:13:11.04,0:13:12.02,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:20.04,0:13:25.07,Default,,0,0,0,,Балалар, сендер де мені өлтірмексіңдер ме?
Dialogue: 0,0:13:25.07,0:13:26.06,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:13:27.02,0:13:31.04,Default,,0,0,0,,Барлығы, жындарды осылай көресіңдер.
Dialogue: 0,0:13:31.04,0:13:34.00,Default,,0,0,0,,Юма - құбыжық
Dialogue: 0,0:13:34.00,0:13:36.02,Default,,0,0,0,,Жын кім?
Dialogue: 0,0:13:47.02,0:13:48.02,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:13:54.05,0:13:56.06,Default,,0,0,0,,Мен бұл жағдайда одан аулақ болдым.
Dialogue: 0,0:13:57.01,0:13:59.03,Default,,0,0,0,,Құбыжық күткендей.
Dialogue: 0,0:14:00.01,0:14:01.08,Default,,0,0,0,,Сақтығыңызды түсірмеңіз
Dialogue: 0,0:14:02.07,0:14:06.02,Default,,0,0,0,,Сіз құбыжықтар емессіз бе?
Dialogue: 0,0:14:07.00,0:14:09.03,Default,,0,0,0,,Осындай сұмдық әрекет жаса
Dialogue: 0,0:14:09.09,0:14:13.03,Default,,0,0,0,,Ана мен әкені және барлығын өлтіріңіз.
Dialogue: 0,0:14:14.08,0:14:18.05,Default,,0,0,0,,Мен жаңа ғана ішімдік жедім.
Dialogue: 0,0:14:19.04,0:14:21.06,Default,,0,0,0,,Бұл құбыжық емес
Dialogue: 0,0:14:24.03,0:14:27.08,Default,,0,0,0,,Сондықтан да бұл жын.
Dialogue: 0,0:14:28.03,0:14:29.03,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:14:30.07,0:14:37.07,Default,,0,0,0,,Мен бәрін өлтіремін.
Dialogue: 0,0:14:41.03,0:14:43.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:01.03,0:15:02.06,Default,,0,0,0,,Бұл күш
Dialogue: 0,0:15:06.06,0:15:07.05,Default,,0,0,0,,Клэр
Dialogue: 0,0:15:08.04,0:15:09.06,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:15:10.05,0:15:12.09,Default,,0,0,0,,Егер сіз мұны істесеңіз, сіз әлі де зардап шегесіз.
Dialogue: 0,0:15:12.09,0:15:13.09,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:15:14.09,0:15:18.02,Default,,0,0,0,,Мен басынан-ақ аз-аздап қалпына келе бастадым.
Dialogue: 0,0:15:20.07,0:15:22.09,Default,,0,0,0,,Ол Клэрге көмектесуі керек емес пе еді?
Dialogue: 0,0:15:32.05,0:15:35.03,Default,,0,0,0,,Клэрге жету керек
Dialogue: 0,0:15:35.06,0:15:36.09,Default,,0,0,0,,Оған дейін күтіңіз.
Dialogue: 0,0:15:44.00,0:15:44.50,Default,,0,0,0,,Клэр
Dialogue: 0,0:16:00.07,0:16:01.07,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:16:03.03,0:16:04.02,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:16:05.05,0:16:08.08,Default,,0,0,0,,Бұл әлі де мінсіз емес пе еді?
Dialogue: 0,0:16:12.08,0:16:17.06,Default,,0,0,0,,Сен бәрінен де жақсысың, Присцилла.
Dialogue: 0,0:16:18.01,0:16:19.06,Default,,0,0,0,,Wonderful
Dialogue: 0,0:16:39.05,0:16:42.00,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:16:42.00,0:16:44.00,Default,,0,0,0,,Барлығы
Dialogue: 0,0:17:11.08,0:17:13.06,Default,,0,0,0,,Иллюзия
Dialogue: 0,0:17:16.00,0:17:19.06,Default,,0,0,0,,Мен бір ақымақ нәрсені білемін.
Dialogue: 0,0:17:28.06,0:17:30.09,Default,,0,0,0,,Сағыныш қылыш
Dialogue: 0,0:17:34.04,0:17:35.03,Default,,0,0,0,,Хелен
Dialogue: 0,0:17:44.02,0:17:45.03,Default,,0,0,0,,Денев
Dialogue: 0,0:17:46.03,0:17:47.02,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:17:52.06,0:17:53.08,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:18:02.04,0:18:03.02,Default,,0,0,0,,Хелен
Dialogue: 0,0:18:11.04,0:18:15.04,Default,,0,0,0,,Бұл Тереза Смайлзды жеңді.
Dialogue: 0,0:18:15.09,0:18:17.07,Default,,0,0,0,,Оянғандардың күші
Dialogue: 0,0:18:28.09,0:18:34.04,Default,,0,0,0,,Менің ойымша, Ригалдоны жеңген Клейморлар аяқталды.
Dialogue: 0,0:18:50.06,0:18:53.00,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:18:54.05,0:18:55.09,Default,,0,0,0,,Осындай жерде
Dialogue: 0,0:19:02.09,0:19:05.02,Default,,0,0,0,,Менің достарым да көмектесе алмайды
Dialogue: 0,0:19:20.04,0:19:21.06,Default,,0,0,0,,Тереза
Dialogue: 0,0:19:24.02,0:19:26.04,Default,,0,0,0,,Мен не үшінмін?
Dialogue: 0,0:19:30.03,0:19:31.03,Default,,0,0,0,,Клэр
Dialogue: 0,0:19:31.08,0:19:33.05,Default,,0,0,0,,Клэр ше?
Dialogue: 0,0:19:46.09,0:19:47.09,Default,,0,0,0,,Прискила
Dialogue: 0,0:19:51.07,0:19:52.08,Default,,0,0,0,,өлтіру
Dialogue: 0,0:19:53.08,0:19:54.09,Default,,0,0,0,,Прискила
Dialogue: 0,0:19:57.04,0:20:00.01,Default,,0,0,0,,Сол себепті мен жауынгер атандым
Dialogue: 0,0:20:03.04,0:20:05.07,Default,,0,0,0,,Прискиланы өлтіре алмасаң
Dialogue: 0,0:20:07.04,0:20:09.01,Default,,0,0,0,,Мұның бәрі мағынасыз
Dialogue: 0,0:20:14.07,0:20:15.08,Default,,0,0,0,,Прискила
Dialogue: 0,0:20:20.08,0:20:22.02,Default,,0,0,0,,Прискила
Dialogue: 0,0:20:26.03,0:20:29.02,Default,,0,0,0,,Прискиланы өлтіріңіз
Dialogue: 0,0:20:31.00,0:20:32.08,Default,,0,0,0,,Осы мақсатқа арналған қуат
Dialogue: 0,0:20:33.03,0:20:36.05,Default,,0,0,0,,Көбірек қуат
Dialogue: 0,0:20:38.01,0:20:39.09,Default,,0,0,0,,Қуат
Dialogue: 0,0:20:51.00,0:20:53.06,Default,,0,0,0,,Клэр сен
Dialogue: 0,0:20:58.05,0:21:00.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:21:02.06,0:21:03.08,Default,,0,0,0,,өлтіру
Dialogue: 0,0:21:07.09,0:21:08.08,Default,,0,0,0,,өлтіру
Dialogue: 0,0:21:14.00,0:21:15.05,Default,,0,0,0,,Жын
Dialogue: 0,0:21:16.03,0:21:17.07,Default,,0,0,0,,өлтіру
Dialogue: 0,0:21:20.00,0:21:22.05,Default,,0,0,0,,Клэр
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Алыс көкжиек
Dialogue: 0,0:22:42.03,0:22:43.08,Default,,0,0,0,,Алыстағы таң
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Аралас ойлар
