Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Буггарати мен басқалары шынында да осы пойызға мініпті
Dialogue: 0,0:00:07.05,0:00:08.03,Default,,0,0,0,,Төрт
Dialogue: 0,0:00:09.00,0:00:09.50,Default,,0,0,0,,Бес
Dialogue: 0,0:00:10.03,0:00:12.02,Default,,0,0,0,,Бес мықты адам
Dialogue: 0,0:00:13.00,0:00:17.08,Default,,0,0,0,,Бұл бес адам жеке мүшелерді шайқасқа апара ма?
Dialogue: 0,0:00:19.08,0:00:21.01,Default,,0,0,0,,Жын емес
Dialogue: 0,0:00:21.04,0:00:22.09,Default,,0,0,0,,Оянған адам.
Dialogue: 0,0:00:23.03,0:00:25.02,Default,,0,0,0,,Адамдар қандай болды
Dialogue: 0,0:00:29.01,0:00:30.05,Default,,0,0,0,,Тым көп
Dialogue: 0,0:00:31.04,0:00:32.06,Default,,0,0,0,,Хаа… Хаа… Хаа…
Dialogue: 0,0:00:39.05,0:00:41.09,Default,,0,0,0,,А, қайда бардың?
Dialogue: 0,0:00:42.08,0:00:44.00,Default,,0,0,0,,Не?
Dialogue: 0,0:00:44.00,0:00:45.00,Default,,0,0,0,,бірдеңе
Dialogue: 0,0:00:46.00,0:00:49.05,Default,,0,0,0,,Бір қорқынышты нәрсе келе жатыр.
Dialogue: 0,0:00:53.02,0:00:54.02,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:00:56.05,0:00:59.03,Default,,0,0,0,,Бұл Ригардо
Dialogue: 0,0:01:00.04,0:01:02.03,Default,,0,0,0,,Күміс көзді арыстан патша
Dialogue: 0,0:01:03.00,0:01:04.01,Default,,0,0,0,,Ригалдо
Dialogue: 0,0:01:07.07,0:01:09.03,Default,,0,0,0,,Вероника
Dialogue: 0,0:01:11.00,0:01:12.05,Default,,0,0,0,,Артыңызда, капитан.
Dialogue: 0,0:01:16.01,0:01:17.06,Default,,0,0,0,,Ол үлкен мәселе.
Dialogue: 0,0:01:18.04,0:01:19.02,Default,,0,0,0,,Бірақ
Dialogue: 0,0:02:11.03,0:02:13.01,Default,,0,0,0,,Маған артқа шегінуге рұқсат етіңіз.
Dialogue: 0,0:02:13.06,0:02:15.09,Default,,0,0,0,,Мен кішкентай шабақтарға қызықпаймын.
Dialogue: 0,0:04:29.03,0:04:30.03,Default,,0,0,0,,өлтіру
Dialogue: 0,0:04:31.01,0:04:32.01,Default,,0,0,0,,Э? Қайда?
Dialogue: 0,0:04:34.00,0:04:36.07,Default,,0,0,0,,Ол жақсы сөйлейді.
Dialogue: 0,0:04:44.00,0:04:46.06,Default,,0,0,0,,Кешіріңіз, бірақ мен сізді өлуге рұқсат етемін.
Dialogue: 0,0:04:57.06,0:04:59.05,Default,,0,0,0,,Клэр Денев
Dialogue: 0,0:04:59.05,0:05:00.04,Default,,0,0,0,,Артқа қалыңыз.
Dialogue: 0,0:05:00.07,0:05:02.08,Default,,0,0,0,,Оның нысанасы сенсің, Мирия.
Dialogue: 0,0:05:03.03,0:05:04.09,Default,,0,0,0,,Барлығы жеңілді
Dialogue: 0,0:05:04.09,0:05:06.03,Default,,0,0,0,,Барлық капитандар.
Dialogue: 0,0:05:06.08,0:05:08.01,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:05:08.06,0:05:12.02,Default,,0,0,0,,Мен сені кешірмеймін, тек сені ғана.
Dialogue: 0,0:05:12.02,0:05:14.00,Default,,0,0,0,,Мен сенің өлуге жол бермеймін.
Dialogue: 0,0:05:25.07,0:05:26.09,Default,,0,0,0,,Деневтен аулақ болыңыз
Dialogue: 0,0:05:29.03,0:05:30.03,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:37.05,0:05:38.09,Default,,0,0,0,,Хо
Dialogue: 0,0:05:39.04,0:05:41.07,Default,,0,0,0,,Ол дана адам.
Dialogue: 0,0:05:42.05,0:05:44.02,Default,,0,0,0,,Көрінетін
Dialogue: 0,0:05:44.02,0:05:48.05,Default,,0,0,0,,Мен сеземін деп айту дұрысырақ па?
Dialogue: 0,0:05:50.03,0:05:51.09,Default,,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:05:52.06,0:05:53.09,Default,,0,0,0,,Э? Қайда?
Dialogue: 0,0:06:18.05,0:06:19.06,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:06:19.09,0:06:21.05,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:06:21.05,0:06:22.09,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:06:23.09,0:06:25.08,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:06:33.01,0:06:34.03,Default,,0,0,0,,Прискила
Dialogue: 0,0:06:35.05,0:06:37.06,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:06:43.05,0:06:46.00,Default,,0,0,0,,Өйткені ол қайғылы болады.
Dialogue: 0,0:06:48.03,0:06:51.04,Default,,0,0,0,,Бұлай таң қалудың қажеті жоқ.
Dialogue: 0,0:06:51.09,0:06:55.03,Default,,0,0,0,,Ол үшін бұл қалыпты жағдай.
Dialogue: 0,0:06:59.06,0:07:01.06,Default,,0,0,0,,Тамақ ішпей өмір сүре алмайсың
Dialogue: 0,0:07:02.08,0:07:08.00,Default,,0,0,0,,Ол үшін бұл жай ғана адам болды.
Dialogue: 0,0:07:09.05,0:07:10.04,Default,,0,0,0,,Бірақ
Dialogue: 0,0:07:12.03,0:07:14.04,Default,,0,0,0,,Ол бала оянған адам.
Dialogue: 0,0:07:14.09,0:07:16.02,Default,,0,0,0,,Жоғарыда айтқанымдай
Dialogue: 0,0:07:17.07,0:07:19.06,Default,,0,0,0,,Бұл Присцилла
Dialogue: 0,0:07:20.07,0:07:23.05,Default,,0,0,0,,Прискила осыны қалайды ма?
Dialogue: 0,0:07:26.00,0:07:28.03,Default,,0,0,0,,Мен оны да білмеймін.
Dialogue: 0,0:07:28.07,0:07:32.08,Default,,0,0,0,,Бірақ бір жерде шайқаста ол өзінің шегінен шықты.
Dialogue: 0,0:07:34.00,0:07:36.05,Default,,0,0,0,,Бұл балшықтардың тағдыры.
Dialogue: 0,0:07:36.05,0:07:39.03,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:07:39.03,0:07:40.09,Default,,0,0,0,,Клеймор қазір
Dialogue: 0,0:07:41.05,0:07:42.02,Default,,0,0,0,,Иә
Dialogue: 0,0:07:42.09,0:07:46.04,Default,,0,0,0,,Оянғандар – Клеймордың соңы.
Dialogue: 0,0:07:50.01,0:07:51.01,Default,,0,0,0,,Олай болса
Dialogue: 0,0:07:52.00,0:07:57.03,Default,,0,0,0,,Присцилла әке, шеше және ағасына айтты.
Dialogue: 0,0:07:58.08,0:08:02.04,Default,,0,0,0,,Адам болған кездегі естелік шығар.
Dialogue: 0,0:08:04.07,0:08:05.09,Default,,0,0,0,,Адамдарға
Dialogue: 0,0:08:06.05,0:08:09.04,Default,,0,0,0,,Прискила адам болып қайта орала алмайды ма?
Dialogue: 0,0:08:10.05,0:08:11.06,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:08:15.00,0:08:18.01,Default,,0,0,0,,Бұған қайта оралудың қажеті жоқ.
Dialogue: 0,0:08:19.07,0:08:21.09,Default,,0,0,0,,Бірақ Прискила
Dialogue: 0,0:08:31.00,0:08:34.08,Default,,0,0,0,,Мен оның дәл қазір қандай түс көріп жатқанын білмеймін.
Dialogue: 0,0:08:36.04,0:08:39.03,Default,,0,0,0,,Оның тағдыры осылай болды.
Dialogue: 0,0:08:39.09,0:08:43.03,Default,,0,0,0,,Сен де, менің де қолымнан ештеңе келмейді.
Dialogue: 0,0:08:50.06,0:08:52.07,Default,,0,0,0,,Мен біраз уақыттан кейін осы жерден кетемін.
Dialogue: 0,0:08:53.06,0:08:56.02,Default,,0,0,0,,Оған дейін жақсылап демалыңыз.
Dialogue: 0,0:08:58.07,0:09:02.01,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:09:03.01,0:09:05.06,Default,,0,0,0,,Біраз уақыттан кейін түсінесіз.
Dialogue: 0,0:09:05.06,0:09:07.01,Default,,0,0,0,,Мен ғой, мен…-сан ба?
Dialogue: 0,0:09:14.01,0:09:15.01,Default,,0,0,0,,Клэр
Dialogue: 0,0:09:24.07,0:09:26.08,Default,,0,0,0,,Ол ешқашан үйренбейтін адам.
Dialogue: 0,0:09:26.08,0:09:30.03,Default,,0,0,0,,Тек абайсызда ішке кіру ештеңеге әкелмейді.
Dialogue: 0,0:09:35.08,0:09:36.06,Default,,0,0,0,,Милия
Dialogue: 0,0:09:41.00,0:09:41.50,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:42.03,0:09:43.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:44.03,0:09:45.07,Default,,0,0,0,,Бұл иллюзия ма?
Dialogue: 0,0:09:51.04,0:09:53.07,Default,,0,0,0,,Капитанға тән жақсы қимыл.
Dialogue: 0,0:10:05.04,0:10:06.05,Default,,0,0,0,,Жоқ, Клэр.
Dialogue: 0,0:10:06.05,0:10:08.01,Default,,0,0,0,,Оны Мирияға қалдырыңыз.
Dialogue: 0,0:10:15.01,0:10:16.00,Default,,0,0,0,,Денев
Dialogue: 0,0:10:21.03,0:10:22.03,Default,,0,0,0,,Денев
Dialogue: 0,0:10:23.01,0:10:24.02,Default,,0,0,0,,Наранция Гилго 1984 жылы, Арыстан белгісінің астында дүниеге келген
Dialogue: 0,0:10:26.07,0:10:28.02,Default,,0,0,0,,Денев Денев
Dialogue: 0,0:10:29.04,0:10:30.02,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:10:31.02,0:10:32.04,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:10:32.09,0:10:34.03,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:10:34.03,0:10:35.01,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:10:35.01,0:10:37.01,Default,,0,0,0,,Жай ғана берілмеңіз
Dialogue: 0,0:10:42.02,0:10:43.05,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:10:44.01,0:10:46.06,Default,,0,0,0,,Милия мен Клэрге көмекке кел.
Dialogue: 0,0:10:47.00,0:10:48.09,Default,,0,0,0,,Ол екеуі өлмесін.
Dialogue: 0,0:10:49.03,0:10:50.04,Default,,0,0,0,,Денев
Dialogue: 0,0:10:51.02,0:10:54.05,Default,,0,0,0,,Осы екеуі бұл шайқастың кілті.
Dialogue: 0,0:10:55.04,0:10:57.04,Default,,0,0,0,,Ұрыс нәтижесін шешу
Dialogue: 0,0:10:57.04,0:10:58.08,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:10:58.08,0:11:01.08,Default,,0,0,0,,Сондықтан сол жерде қалып, жараларыңызды емдеңіз.
Dialogue: 0,0:11:01.08,0:11:02.07,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:11:11.04,0:11:13.08,Default,,0,0,0,,Қозғалмай отырыңыз.
Dialogue: 0,0:11:16.01,0:11:17.05,Default,,0,0,0,,Титанның денесіне киінген адам
Dialogue: 0,0:11:18.05,0:11:21.02,Default,,0,0,0,,15 саны мұны естіп шошып кетті.
Dialogue: 0,0:11:23.02,0:11:25.07,Default,,0,0,0,,«Жалғыз қобалжыма» дегеннің мәні неде?
Dialogue: 0,0:11:27.01,0:11:31.05,Default,,0,0,0,,Неліктен сенің достарың бар?
Dialogue: 0,0:11:38.08,0:11:43.01,Default,,0,0,0,,Undine-ны қорғаудан алыс,
Dialogue: 0,0:11:43.09,0:11:49.02,Default,,0,0,0,,Ол жау сізге зиян тигізе де алмайды.
Dialogue: 0,0:11:53.09,0:11:55.04,Default,,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:11:56.04,0:11:57.07,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:11:57.07,0:12:00.03,Default,,0,0,0,,Бұлай оған жақындай да алмайсың.
Dialogue: 0,0:12:04.04,0:12:05.05,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:12:05.08,0:12:09.05,Default,,0,0,0,,Әлгі адам Мирияның иллюзиясына оңай ереді.
Dialogue: 0,0:12:10.01,0:12:14.03,Default,,0,0,0,,Жоқ, Мирия әйтеуір оған ілесіп жүр ме?
Dialogue: 0,0:12:17.02,0:12:18.07,Default,,0,0,0,,Жоқ, тым кеш.
Dialogue: 0,0:12:19.05,0:12:22.05,Default,,0,0,0,,Менің денем неге сонша баяу?
Dialogue: 0,0:12:36.06,0:12:38.05,Default,,0,0,0,,Бұл сіздің еркіндігіңіз
Dialogue: 0,0:12:38.05,0:12:39.08,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:12:41.06,0:12:42.05,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:12:54.02,0:12:57.03,Default,,0,0,0,,Енді сол жерден өтсек
Dialogue: 0,0:12:57.03,0:12:58.05,Default,,0,0,0,,Тырнақтарыңды қадалама.
Dialogue: 0,0:13:20.03,0:13:21.08,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:21.08,0:13:23.07,Default,,0,0,0,,Қозғалыс баяулады.
Dialogue: 0,0:13:24.01,0:13:26.01,Default,,0,0,0,,Бұл шектеуге жақын ба?
Dialogue: 0,0:13:34.03,0:13:37.01,Default,,0,0,0,,Сіз әлі де бара аласыз ба?
Dialogue: 0,0:13:45.07,0:13:48.02,Default,,0,0,0,,Мен мұны айтқым келеді
Dialogue: 0,0:13:58.05,0:14:02.05,Default,,0,0,0,,Одан толық құтылу мүмкін болмай қалды ма?
Dialogue: 0,0:14:04.00,0:14:05.05,Default,,0,0,0,,Өте жаман.
Dialogue: 0,0:14:05.09,0:14:08.00,Default,,0,0,0,,Аяқтауға жақын
Dialogue: 0,0:14:10.05,0:14:12.04,Default,,0,0,0,,Кішкентай шабақтардың келуіне жол бермеңіз
Dialogue: 0,0:14:12.09,0:14:14.03,Default,,0,0,0,,Қозуды жоғалту
Dialogue: 0,0:14:22.05,0:14:23.06,Default,,0,0,0,,Клэр
Dialogue: 0,0:14:28.01,0:14:29.02,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:29.02,0:14:30.02,Default,,0,0,0,,Бұлай емес
Dialogue: 0,0:14:31.07,0:14:33.00,Default,,0,0,0,,Жылдамырақ
Dialogue: 0,0:14:33.05,0:14:34.05,Default,,0,0,0,,Түпнұсқа
Dialogue: 0,0:14:47.02,0:14:49.04,Default,,0,0,0,,Эй, жоқ, жоқ, жоқ.
Dialogue: 0,0:14:49.04,0:14:51.03,Default,,0,0,0,,Ары қарай жүрме
Dialogue: 0,0:14:51.03,0:14:52.06,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:14:52.06,0:14:54.06,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:14:54.06,0:14:56.06,Default,,0,0,0,,Бұл сенің мұндай жерде болатын уақыт емес.
Dialogue: 0,0:14:56.06,0:14:57.05,Default,,0,0,0,,Кенеттен татами төсегі жарылып кетті.
Dialogue: 0,0:14:57.05,0:14:59.01,Default,,0,0,0,,Қаш
Dialogue: 0,0:14:59.01,0:15:01.00,Default,,0,0,0,,Жын болуы керек
Dialogue: 0,0:15:01.00,0:15:03.00,Default,,0,0,0,,Олар көптеп пайда болды.
Dialogue: 0,0:15:03.04,0:15:05.05,Default,,0,0,0,,Келген жақтан
Dialogue: 0,0:15:05.05,0:15:06.06,Default,,0,0,0,,Бұл Пиета.
Dialogue: 0,0:15:07.05,0:15:09.09,Default,,0,0,0,,Клеймор да шайқаса алады.
Dialogue: 0,0:15:09.09,0:15:13.07,Default,,0,0,0,,Жоқ, жындардың саны аман қалуы мүмкін емес.
Dialogue: 0,0:15:13.07,0:15:14.05,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:14.05,0:15:15.07,Default,,0,0,0,,Сіз де қашыңыз.
Dialogue: 0,0:15:15.07,0:15:16.08,Default,,0,0,0,,жүрегі жұмсақ жандар әлі де басқаларға көмектеседі ғой, иә?
Dialogue: 0,0:15:16.08,0:15:18.09,Default,,0,0,0,,Мен барлық адамдарды ең төменгі санға дейін жұмылдырамын.
Dialogue: 0,0:15:18.09,0:15:20.07,Default,,0,0,0,,Тым көп болса жарамайды
Dialogue: 0,0:15:21.08,0:15:23.00,Default,,0,0,0,,Ең төменгі сан
Dialogue: 0,0:15:23.05,0:15:24.09,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:15:24.09,0:15:26.03,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:15:26.03,0:15:28.01,Default,,0,0,0,,Ендеше тез қашайық.
Dialogue: 0,0:15:33.00,0:15:34.00,Default,,0,0,0,,Бұл Клэр.
Dialogue: 0,0:15:34.08,0:15:35.09,Default,,0,0,0,,Клэр осында.
Dialogue: 0,0:15:50.01,0:15:54.02,Default,,0,0,0,,Зақым келтіру кезінде тым көп сиқырлы күш қолданылды
Dialogue: 0,0:15:54.02,0:15:58.07,Default,,0,0,0,,Мен бұл қобалжуды өзім тоқтата алмаймын деп ойлаймын.
Dialogue: 0,0:15:59.09,0:16:03.06,Default,,0,0,0,,Демек, біз адам ретінде саналы болсақ,
Dialogue: 0,0:16:03.06,0:16:05.09,Default,,0,0,0,,Өз өмірін қию
Dialogue: 0,0:16:09.00,0:16:10.08,Default,,0,0,0,,Сол кезде мен оны тоқтатпасам
Dialogue: 0,0:16:11.06,0:16:12.07,Default,,0,0,0,,Тіпті Клэр
Dialogue: 0,0:16:16.01,0:16:17.02,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:16:17.06,0:16:18.07,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:16:19.01,0:16:20.05,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:16:21.06,0:16:23.04,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:16:29.00,0:16:29.50,Default,,0,0,0,,Раки
Dialogue: 0,0:16:32.01,0:16:33.09,Default,,0,0,0,,Күшсіздік - күнә
Dialogue: 0,0:16:41.00,0:16:42.04,Default,,0,0,0,,Рақидан сұра
Dialogue: 0,0:16:42.08,0:16:43.09,Default,,0,0,0,,Мені жіберіңізші
Dialogue: 0,0:16:44.02,0:16:45.02,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:16:45.06,0:16:46.08,Default,,0,0,0,,бетін таныған адамның атын жазсаң, сол адам өліп қалады деген дәптер екенін айтты
Dialogue: 0,0:16:46.08,0:16:48.07,Default,,0,0,0,,Мен адам санасынан хабардармын.
Dialogue: 0,0:16:55.01,0:16:55.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:56.04,0:16:59.02,Default,,0,0,0,,Мен енді жеңілгім келмейді
Dialogue: 0,0:17:22.03,0:17:24.01,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:17:24.07,0:17:28.01,Default,,0,0,0,,Жүр, біз де барайық.
Dialogue: 0,0:17:40.04,0:17:43.02,Default,,0,0,0,,Егер сіз өтірік айтқыңыз келсе
Dialogue: 0,0:17:43.02,0:17:44.07,Default,,0,0,0,,Өшірілген.
Dialogue: 0,0:17:57.03,0:18:01.03,Default,,0,0,0,,Бұл жолы елес емес сияқты.
Dialogue: 0,0:18:03.01,0:18:04.04,Default,,0,0,0,,Милия
Dialogue: 0,0:18:19.00,0:18:21.00,Default,,0,0,0,,Оның басын кесіңіз
Dialogue: 0,0:18:21.06,0:18:22.09,Default,,0,0,0,,Бітті
Dialogue: 0,0:18:32.02,0:18:33.01,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:18:34.00,0:18:35.07,Default,,0,0,0,,Неліктен менің денем
Dialogue: 0,0:18:36.04,0:18:37.07,Default,,0,0,0,,Өте баяу
Dialogue: 0,0:18:39.04,0:18:40.04,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:18:44.01,0:18:45.03,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:18:45.07,0:18:47.04,Default,,0,0,0,,Мен өлмеймін
Dialogue: 0,0:18:47.04,0:18:50.05,Default,,0,0,0,,Мен міндетті түрде өмір сүремін және сенімен қайта қауышамын.
Dialogue: 0,0:18:51.05,0:18:53.04,Default,,0,0,0,,Сондықтан Рақи да өлмейді.
Dialogue: 0,0:18:54.01,0:18:55.08,Default,,0,0,0,,Мен оны міндетті түрде табамын.
Dialogue: 0,0:18:56.01,0:18:58.00,Default,,0,0,0,,Оған дейін аман қаласыз.
Dialogue: 0,0:18:59.00,0:19:00.01,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:19:02.04,0:19:04.01,Default,,0,0,0,,(Дон) Дегенмен, сыртта бәрі де соншалықты алып, иә?
Dialogue: 0,0:19:04.01,0:19:05.02,Default,,0,0,0,,Мен сенімен тірі кездесемін
Dialogue: 0,0:19:06.04,0:19:08.08,Default,,0,0,0,,Сонымен, бұл жолы
Dialogue: 0,0:19:09.03,0:19:10.07,Default,,0,0,0,,Мен оны қорғаймын
Dialogue: 0,0:19:25.08,0:19:26.08,Default,,0,0,0,,Клэр
Dialogue: 0,0:19:46.05,0:19:48.04,Default,,0,0,0,,Мен жылдамырақ болсам
Dialogue: 0,0:19:49.04,0:19:51.05,Default,,0,0,0,,Ген де, флора да сақталды.
Dialogue: 0,0:19:53.03,0:19:54.06,Default,,0,0,0,,I көбірек
Dialogue: 0,0:19:56.08,0:19:58.01,Default,,0,0,0,,I көбірек
Dialogue: 0,0:19:58.09,0:19:59.07,Default,,0,0,0,,Қосымша
Dialogue: 0,0:20:00.04,0:20:02.07,Default,,0,0,0,,Қосымша
Dialogue: 0,0:20:03.03,0:20:04.02,Default,,0,0,0,,Қосымша
Dialogue: 0,0:20:05.07,0:20:07.03,Default,,0,0,0,,Қосымша
Dialogue: 0,0:20:09.05,0:20:13.03,Default,,0,0,0,,Мен көбірек
Dialogue: 0,0:20:35.05,0:20:36.06,Default,,0,0,0,,Не?
Dialogue: 0,0:20:37.01,0:20:37.51,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:21:02.01,0:21:05.07,Default,,0,0,0,,Клэр
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Толып жатқан мұң
Dialogue: 0,0:22:42.03,0:22:43.08,Default,,0,0,0,,Толып жатқан құштарлық
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Арыстанның ақыруы
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
