Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.09,0:00:11.06,Default,,0,0,0,,Мен ат алдым
Dialogue: 0,0:00:13.09,0:00:14.06,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:00:16.08,0:00:20.06,Default,,0,0,0,,Егер сіз бізбен бірге барсаңыз, бұл шынымен көмектесер еді.
Dialogue: 0,0:00:20.06,0:00:22.09,Default,,0,0,0,,Бұл қыздың есімі Присцилла.
Dialogue: 0,0:00:22.09,0:00:26.00,Default,,0,0,0,,Адамдарға мұншалықты байланып қалуым жиі емес.
Dialogue: 0,0:00:26.04,0:00:30.05,Default,,0,0,0,,Сіздің оңтүстік иісіңіз менің отбасымды еске түсіре ме деп ойлаймын.
Dialogue: 0,0:00:31.07,0:00:32.05,Default,,0,0,0,,Отбасы
Dialogue: 0,0:00:32.09,0:00:33.08,Default,,0,0,0,,О
Dialogue: 0,0:00:33.08,0:00:36.00,Default,,0,0,0,,Оны жын жеп қойған көрінеді.
Dialogue: 0,0:00:41.02,0:00:42.01,Default,,0,0,0,,Бұл бала да
Dialogue: 0,0:00:45.02,0:00:46.02,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:00:47.09,0:00:50.02,Default,,0,0,0,,Жылқыда бірдеңе бар ма?
Dialogue: 0,0:00:50.02,0:00:52.07,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:00:52.07,0:00:54.04,Default,,0,0,0,,жақсы болар еді.
Dialogue: 0,0:00:54.04,0:00:56.07,Default,,0,0,0,,Егер сіз осыдан асып кетуді жоспарласаңыз.
Dialogue: 0,0:00:56.07,0:00:59.01,Default,,0,0,0,,Пьетадан алыс болғаныңыз жөн.
Dialogue: 0,0:00:59.06,0:01:03.06,Default,,0,0,0,,Шамасы, бұл жерде саз балшықтары көп жиналды.
Dialogue: 0,0:01:05.02,0:01:08.01,Default,,0,0,0,,Балшық бар жерде жын бар.
Dialogue: 0,0:01:08.01,0:01:09.07,Default,,0,0,0,,Қатыспағаның дұрыс.
Dialogue: 0,0:01:10.06,0:01:11.08,Default,,0,0,0,,Олай болса
Dialogue: 0,0:01:14.00,0:01:15.07,Default,,0,0,0,,Клеймор Пиетаға айналады
Dialogue: 0,0:01:20.06,0:01:23.06,Default,,0,0,0,,Кешіріңіз, мен сізбен бірге бара алмаймын.
Dialogue: 0,0:01:24.01,0:01:25.07,Default,,0,0,0,,Мен Пиетаға баруым керек
Dialogue: 0,0:01:25.07,0:01:26.06,Default,,0,0,0,,Олай болса
Dialogue: 0,0:01:26.06,0:01:28.00,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:01:28.04,0:01:31.02,Default,,0,0,0,,Біздің де саяхатты тоқтату ниетіміз жоқ.
Dialogue: 0,0:01:31.06,0:01:36.08,Default,,0,0,0,,Егер бұл Пьета болса, біз бір бағытта келе жатырмыз, сондықтан Прискила үшін, менімен бірге бара аласыз ба?
Dialogue: 0,0:01:38.07,0:01:39.07,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:01:40.01,0:01:42.06,Default,,0,0,0,,Пьетаға дейін әлі көп жол бар.
Dialogue: 0,0:01:42.06,0:01:44.08,Default,,0,0,0,,Меніңше, асыққанның қажеті жоқ.
Dialogue: 0,0:02:55.00,0:02:59.01,Default,,0,0,0,,Менімен бірге келгеніңіз үшін мен өзімді толығымен жеңілдеттім.
Dialogue: 0,0:03:00.09,0:03:04.06,Default,,0,0,0,,"Клейморды" бұрын естігенде жүзіңіз өзгерді.
Dialogue: 0,0:03:05.02,0:03:08.03,Default,,0,0,0,,Сіз іздеп жүрген адам балшық па?
Dialogue: 0,0:03:08.08,0:03:09.05,Default,,0,0,0,,Иә
Dialogue: 0,0:03:10.08,0:03:12.08,Default,,0,0,0,,Неліктен лаймор?
Dialogue: 0,0:03:13.03,0:03:19.00,Default,,0,0,0,,Ол бұрынғыдай жігіт емес, бірақ ол біреумен араласа алмайтын адам емес пе?
Dialogue: 0,0:03:19.05,0:03:21.03,Default,,0,0,0,,Мен үшін емес
Dialogue: 0,0:03:23.00,0:03:25.01,Default,,0,0,0,,Мен үшін Клэр
Dialogue: 0,0:03:25.01,0:03:27.03,Default,,0,0,0,,Клэр?
Dialogue: 0,0:03:31.08,0:03:32.09,Default,,0,0,0,,Клэр
Dialogue: 0,0:03:41.03,0:03:45.04,Default,,0,0,0,,Егер Клэр болмаса, мен қазір бұл жерде болмас едім.
Dialogue: 0,0:03:47.00,0:03:49.02,Default,,0,0,0,,Клэр үнемі маған қарайды
Dialogue: 0,0:03:51.00,0:03:53.07,Default,,0,0,0,,Сонымен, бұл жолы мен
Dialogue: 0,0:03:55.09,0:03:59.00,Default,,0,0,0,,Мен Клэрді қорғауды шештім.
Dialogue: 0,0:04:00.01,0:04:01.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:01.07,0:04:05.01,Default,,0,0,0,,Бұл аздап қайғылы адамдық шешім.
Dialogue: 0,0:04:06.05,0:04:08.06,Default,,0,0,0,,Жасалғаннан гөрі айту оңай
Dialogue: 0,0:04:08.06,0:04:11.02,Default,,0,0,0,,Бірақ сізде ондай күш бар ма?
Dialogue: 0,0:04:31.01,0:04:33.02,Default,,0,0,0,,Аспанда не болып жатыр?
Dialogue: 0,0:04:37.03,0:04:40.06,Default,,0,0,0,,Әлсіздер әрқашан сөзге жабысады
Dialogue: 0,0:04:41.01,0:04:45.06,Default,,0,0,0,,Ал күштілер әлсіздер үшін өледі.
Dialogue: 0,0:04:46.05,0:04:48.04,Default,,0,0,0,,Ортақ әңгіме
Dialogue: 0,0:04:51.04,0:04:52.07,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:04:52.07,0:04:56.09,Default,,0,0,0,,Күшсіздік - күнә
Dialogue: 0,0:05:00.08,0:05:01.09,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:02.03,0:05:04.04,Default,,0,0,0,,Маған қылышты үйрете аласыз ба?
Dialogue: 0,0:05:05.01,0:05:05.51,Default,,0,0,0,,Қылыш
Dialogue: 0,0:05:06.06,0:05:08.09,Default,,0,0,0,,Сенің қылышың ғажап екенін көріп тұрмын.
Dialogue: 0,0:05:09.03,0:05:12.01,Default,,0,0,0,,Қылыш ағыны әдемі, босқа қимыл жоқ.
Dialogue: 0,0:05:12.01,0:05:14.02,Default,,0,0,0,,Толық деп айтасыз ба?
Dialogue: 0,0:05:14.05,0:05:15.04,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:05:16.04,0:05:18.06,Default,,0,0,0,,Мен мұны аздап жасайтынмын.
Dialogue: 0,0:05:19.03,0:05:20.05,Default,,0,0,0,,Аз
Dialogue: 0,0:05:21.00,0:05:22.01,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:05:22.05,0:05:28.00,Default,,0,0,0,,Мен Пиетаға бармас бұрын барынша күшті болғым келеді. өтінемін
Dialogue: 0,0:05:31.09,0:05:33.09,Default,,0,0,0,,Сенің көздерің жақсы.
Dialogue: 0,0:05:33.09,0:05:36.00,Default,,0,0,0,,Мүмкін сіз күшейерсіз
Dialogue: 0,0:05:39.07,0:05:43.01,Default,,0,0,0,,Жақсы, мен саған үйрете аламын.
Dialogue: 0,0:05:44.00,0:05:45.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:51.09,0:05:53.07,Default,,0,0,0,,ұшы бекітілмеген.
Dialogue: 0,0:05:54.02,0:05:56.04,Default,,0,0,0,,Қолыңызбен емес, денеңізбен тербеліңіз
Dialogue: 0,0:05:56.04,0:05:57.04,Default,,0,0,0,,Иә
Dialogue: 0,0:06:00.05,0:06:03.04,Default,,0,0,0,,Клэр Мен сені жақын арада көретінімізге сенімдімін.
Dialogue: 0,0:06:04.05,0:06:07.02,Default,,0,0,0,,Мен сені бұл жолы міндетті түрде қорғаймын
Dialogue: 0,0:06:15.06,0:06:18.05,Default,,0,0,0,,Раки, аман болыңыз.
Dialogue: 0,0:06:30.06,0:06:36.01,Default,,0,0,0,,Мен дайындалдым деп ойладым, бірақ Оянғандармен шайқас мұндай ауыр болады деп ешқашан ойламадым.
Dialogue: 0,0:06:36.04,0:06:39.07,Default,,0,0,0,,Біздің аман қалғанымыз ғажайып дерлік.
Dialogue: 0,0:06:39.07,0:06:41.03,Default,,0,0,0,,Ары қарай не боларын білмеймін
Dialogue: 0,0:06:41.07,0:06:45.06,Default,,0,0,0,,Бірақ ең қорқыныштысы өлу емес.
Dialogue: 0,0:06:45.06,0:06:49.00,Default,,0,0,0,,Бұл сіздің шекараңыздың шетінде тұрған шайқаста ояну туралы.
Dialogue: 0,0:06:49.05,0:06:51.05,Default,,0,0,0,,Сіз немен айналысып жатырсыз?
Dialogue: 0,0:06:53.03,0:06:56.00,Default,,0,0,0,,Осындай ұрыс сізді оята ма?
Dialogue: 0,0:06:56.00,0:06:57.04,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:06:57.07,0:06:59.03,Default,,0,0,0,,Таку
Dialogue: 0,0:06:59.03,0:07:01.08,Default,,0,0,0,,Мен мұндай ащы жерде ұйықтай алмаймын.
Dialogue: 0,0:07:03.06,0:07:05.00,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:07:05.00,0:07:07.02,Default,,0,0,0,,Капитан жай ғана қобалжыды.
Dialogue: 0,0:07:08.00,0:07:11.04,Default,,0,0,0,,Егер дұрыс есімде болсам, ауыстырылатын жабдық келуі керек еді.
Dialogue: 0,0:07:12.00,0:07:15.01,Default,,0,0,0,,Ах, шығыс қонақ үйдегі қойма.
Dialogue: 0,0:07:24.01,0:07:25.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:25.05,0:07:28.07,Default,,0,0,0,,Жабдықпен толық қамтылғаныңызға сенімдісіз бе?
Dialogue: 0,0:07:29.00,0:07:29.50,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:07:31.03,0:07:32.05,Default,,0,0,0,,Капитан?
Dialogue: 0,0:07:32.05,0:07:33.05,Default,,0,0,0,,Бұл Денев.
Dialogue: 0,0:07:34.00,0:07:36.02,Default,,0,0,0,,Мен бүлінген жабдықты ауыстыруға келдім.
Dialogue: 0,0:07:36.09,0:07:38.09,Default,,0,0,0,,Мен қазір өзгеріп жатырмын.
Dialogue: 0,0:07:39.00,0:07:40.00,Default,,0,0,0,,Ұялшақ бол
Dialogue: 0,0:07:41.00,0:07:43.08,Default,,0,0,0,,Достар бір-біріне оғаш сөздер айтады.
Dialogue: 0,0:07:43.08,0:07:45.00,Default,,0,0,0,,Жарайды, шық.
Dialogue: 0,0:07:48.06,0:07:50.02,Default,,0,0,0,,Мен сізден бірнәрсе сұрайын деп едім.
Dialogue: 0,0:07:51.01,0:07:53.06,Default,,0,0,0,,Мына басқа қылышқа не болды?
Dialogue: 0,0:07:53.09,0:07:56.02,Default,,0,0,0,,Белгілер басқаша сияқты.
Dialogue: 0,0:07:56.02,0:07:57.02,Default,,0,0,0,,Нормадан тыс Титан.
Dialogue: 0,0:07:57.02,0:08:00.02,Default,,0,0,0,,Мен оны өлтірген жігіттен алдым. Шағымдарыңыз бар ма?
Dialogue: 0,0:08:00.07,0:08:04.04,Default,,0,0,0,,Жауынгер өлсе, қылышымыз құлпытасқа айналады.
Dialogue: 0,0:08:05.01,0:08:07.02,Default,,0,0,0,,Сіз мұны білмейтін сияқтысыз.
Dialogue: 0,0:08:08.07,0:08:10.06,Default,,0,0,0,,Өлген адамға керегі жоқ шығар.
Dialogue: 0,0:08:11.01,0:08:14.01,Default,,0,0,0,,Бұл бәрібір ешкім білмейтін төмен дәрежелі жауынгердің қылышы.
Dialogue: 0,0:08:16.02,0:08:23.00,Default,,0,0,0,,Оны басым қолымен мықтап ұстаған сияқты, мен оны қуып жіберсем де жібермеді.
Dialogue: 0,0:08:23.09,0:08:24.08,Default,,0,0,0,,На
Dialogue: 0,0:08:24.08,0:08:26.06,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:08:27.00,0:08:31.06,Default,,0,0,0,,Сіздің мінез-құлқыңыз бір қарағанда жабайы адамға ұқсайды.
Dialogue: 0,0:08:32.00,0:08:35.00,Default,,0,0,0,,Мұның бәрі достарымның игілігі үшін деп ойламаймын.
Dialogue: 0,0:08:36.03,0:08:37.06,Default,,0,0,0,,Келме.
Dialogue: 0,0:08:37.06,0:08:40.05,Default,,0,0,0,,Әй, капитанның айтқанын тыңдай алмайсың ба?
Dialogue: 0,0:08:40.05,0:08:41.08,Default,,0,0,0,,Келме
Dialogue: 0,0:08:46.05,0:08:48.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:48.00,0:08:51.07,Default,,0,0,0,,Бұл сіздің шынайы формаңыз ба?
Dialogue: 0,0:09:03.06,0:09:07.04,Default,,0,0,0,,Мен сенімен біраз уақыт араласқым келеді.
Dialogue: 0,0:09:08.06,0:09:10.04,Default,,0,0,0,,Капитан Флора
Dialogue: 0,0:09:16.09,0:09:18.03,Default,,0,0,0,,Ки-сама
Dialogue: 0,0:09:19.02,0:09:20.01,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:20.07,0:09:24.01,Default,,0,0,0,,Сіздің шектен шығып кете жаздағаныңыз қорқынышты болды ма?
Dialogue: 0,0:09:28.06,0:09:29.05,Default,,0,0,0,,Кім
Dialogue: 0,0:09:29.05,0:09:31.02,Default,,0,0,0,,Ұят болма
Dialogue: 0,0:09:31.02,0:09:32.06,Default,,0,0,0,,Мұны кез келген адам жасай алады.
Dialogue: 0,0:09:33.00,0:09:34.08,Default,,0,0,0,,Билікке ұмтылу
Dialogue: 0,0:09:34.08,0:09:36.08,Default,,0,0,0,,Қан мен ет құмарлығы
Dialogue: 0,0:09:36.08,0:09:39.09,Default,,0,0,0,,Ішімдегі шіркін қара кесек
Dialogue: 0,0:09:40.05,0:09:43.04,Default,,0,0,0,,Оны анық сезінген сәт.
Dialogue: 0,0:09:44.07,0:09:49.06,Default,,0,0,0,,Сіз тереңірек нәрсені басынан өткергендейсіз.
Dialogue: 0,0:09:49.06,0:09:51.04,Default,,0,0,0,,Жалпылау.
Dialogue: 0,0:09:51.04,0:09:52.04,Default,,0,0,0,,Екінші болжам жасамаңыз
Dialogue: 0,0:09:53.04,0:09:59.08,Default,,0,0,0,,Қалай болғанда да, бұл әлсіз және ұялшақ жауынгер үшін ауыр тәжірибе болса керек.
Dialogue: 0,0:09:59.08,0:10:00.09,Default,,0,0,0,,Вамуу сияқты біреу үшін де —
Dialogue: 0,0:10:00.09,0:10:02.05,Default,,0,0,0,,Сіз не туралы айтып тұрсыз?
Dialogue: 0,0:10:03.05,0:10:09.08,Default,,0,0,0,,Бастапқыда ол ең жақын одақтастарына жабысып аман қала алған әлсіз жауынгер болған, бірақ
Dialogue: 0,0:10:09.08,0:10:13.05,Default,,0,0,0,,Жақын жауынгер шайқаста өледі.
Dialogue: 0,0:10:14.04,0:10:17.01,Default,,0,0,0,,Бұл да менің күшім болмағандықтан.
Dialogue: 0,0:10:19.01,0:10:22.08,Default,,0,0,0,,Қалған жауынгер семсерін ұстап, шешеді.
Dialogue: 0,0:10:24.00,0:10:26.02,Default,,0,0,0,,Сіз басқалардан күшті болған кезде
Dialogue: 0,0:10:27.08,0:10:31.07,Default,,0,0,0,,Ол әрқашан өзінің сиқырлы күштерін босатып, өзін бұлшықетті етіп көрсетті.
Dialogue: 0,0:10:31.07,0:10:34.08,Default,,0,0,0,,Бұл ұйымды қосарлы пайдалануға рұқсат ету үшін ме?
Dialogue: 0,0:10:35.02,0:10:37.06,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:38.01,0:10:40.01,Default,,0,0,0,,Мен ештеңе білмедім.
Dialogue: 0,0:10:40.08,0:10:45.01,Default,,0,0,0,,Бұл біздің әлемде сирек емес, бұл қарапайым оқиға.
Dialogue: 0,0:10:45.01,0:10:45.51,Default,,0,0,0,,Карс Супер Ажаны іздеді —
Dialogue: 0,0:10:46.00,0:10:48.02,Default,,0,0,0,,О, міне, мынау.
Dialogue: 0,0:10:48.06,0:10:50.09,Default,,0,0,0,,Ия, сіз өте таңдаулысыз.
Dialogue: 0,0:10:50.09,0:10:53.02,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:10:54.04,0:10:56.02,Default,,0,0,0,,Артқы жағында кім бар?
Dialogue: 0,0:10:56.07,0:10:57.07,Default,,0,0,0,,Мен ондай адамды білмеймін.
Dialogue: 0,0:10:58.02,0:11:00.04,Default,,0,0,0,,Бұл не, Денев?
Dialogue: 0,0:11:00.04,0:11:01.07,Default,,0,0,0,,Сен де келдің бе?
Dialogue: 0,0:11:01.07,0:11:02.03,Default,,0,0,0,,О
Dialogue: 0,0:11:02.08,0:11:04.05,Default,,0,0,0,,Ішінде не бар?
Dialogue: 0,0:11:04.05,0:11:07.02,Default,,0,0,0,,Жоқ, тек мал материалдары болды.
Dialogue: 0,0:11:09.05,0:11:11.00,Default,,0,0,0,,Не?
Dialogue: 0,0:11:11.00,0:11:12.02,Default,,0,0,0,,Сонда мен киімімді ауыстырайын ба?
Dialogue: 0,0:11:14.02,0:11:19.02,Default,,0,0,0,,Киімімді ауыстырсам да, бәрібір тез арада ыдырайтынына сенімдімін.
Dialogue: 0,0:11:20.01,0:11:22.02,Default,,0,0,0,,Бұл жақсы, міне, солай
Dialogue: 0,0:11:23.06,0:11:25.01,Default,,0,0,0,,Жана Денев
Dialogue: 0,0:11:25.01,0:11:26.07,Default,,0,0,0,,Жақсы ұйықтайық
Dialogue: 0,0:11:26.07,0:11:27.06,Default,,0,0,0,,(Шукуна) Бұл жалықтырады. Егер менің орнымды алмақ болсаң, іске кіріс.
Dialogue: 0,0:11:28.05,0:11:29.05,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:11:37.03,0:11:39.01,Default,,0,0,0,,Сіз маған жақсылық жасағыңыз келе ме?
Dialogue: 0,0:11:39.01,0:11:41.00,Default,,0,0,0,,Бұл менің ниетім емес.
Dialogue: 0,0:11:41.06,0:11:44.02,Default,,0,0,0,,Хелен жақсы адам, бірақ жұмсақ сөйлейді.
Dialogue: 0,0:11:44.07,0:11:50.05,Default,,0,0,0,,Егер сіздің командаңыздағы адамдар сіз туралы қазір білсе, олар ұрысудан көбірек қорқуы мүмкін.
Dialogue: 0,0:11:50.05,0:11:53.03,Default,,0,0,0,,Мен одан артық ештеңе білмеймін.
Dialogue: 0,0:11:53.03,0:11:57.04,Default,,0,0,0,,Тағы бір оқиғаны айтып берейін.
Dialogue: 0,0:11:59.03,0:12:02.04,Default,,0,0,0,,Бір қыздың өзінен үлкен әпкесі бар еді.
Dialogue: 0,0:12:02.09,0:12:05.03,Default,,0,0,0,,Үйге жындар шабуыл жасағанда
Dialogue: 0,0:12:05.03,0:12:08.02,Default,,0,0,0,,Үлкен апа сіңлісін кереует астына лақтырып жіберді.
Dialogue: 0,0:12:09.04,0:12:12.04,Default,,0,0,0,,Қыздың қолынан келгені қарау ғана болды.
Dialogue: 0,0:12:13.00,0:12:19.04,Default,,0,0,0,,Менің қолымнан келгені – әпкемді жындар бөліп-жарып жатқанын көру.
Dialogue: 0,0:12:21.01,0:12:24.08,Default,,0,0,0,,Қыз ақыры жартылай адам, жартылай жын жауынгерге айналады.
Dialogue: 0,0:12:24.08,0:12:27.09,Default,,0,0,0,,Әпкемнің өлімі үшін кек алғысы келсе де
Dialogue: 0,0:12:27.09,0:12:30.02,Default,,0,0,0,,Қорғаныс жауынгері болды
Dialogue: 0,0:12:31.01,0:12:35.00,Default,,0,0,0,,Жүрегімде өлгім келмеді.
Dialogue: 0,0:12:35.04,0:12:40.03,Default,,0,0,0,,Сол төсек астында да, апамды құрбандыққа шалғанда да.
Dialogue: 0,0:12:40.03,0:12:41.08,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:12:43.08,0:12:51.00,Default,,0,0,0,,Өз-өзінен үмітін үзіп, шарасыз шайқасқа түскен адамға ашуланған жауынгер осылай деді.
Dialogue: 0,0:12:51.00,0:12:55.09,Default,,0,0,0,,Ей, не болса да өмір сүргісі келетіні табиғи нәрсе.
Dialogue: 0,0:12:55.09,0:12:57.08,Default,,0,0,0,,Біз адамбыз.
Dialogue: 0,0:13:00.01,0:13:05.09,Default,,0,0,0,,Бәрі де желдей ұшып кеткен жоқ, бірақ соның арқасында жауынгер әлі тірі сияқты.
Dialogue: 0,0:13:10.00,0:13:12.04,Default,,0,0,0,,Мұнда біздің достарымыз бар.
Dialogue: 0,0:13:12.04,0:13:16.00,Default,,0,0,0,,Егер сіз мұны жалғыз жасай алмасаңыз, біз сізге қолдау көрсетеміз.
Dialogue: 0,0:13:16.00,0:13:21.04,Default,,0,0,0,,Сондықтан өзіңізді көп уайымдамаңыз, капитан Ундин.
Dialogue: 0,0:13:25.00,0:13:28.08,Default,,0,0,0,,Сізді бұл жерге әкелудегі мақсат не?
Dialogue: 0,0:13:29.08,0:13:32.04,Default,,0,0,0,,Мен әрқашан өзімді жайсыз сезінетінмін.
Dialogue: 0,0:13:32.04,0:13:34.03,Default,,0,0,0,,Сіздің оң қолыңыз
Dialogue: 0,0:13:34.07,0:13:36.07,Default,,0,0,0,,Бұл менікі емес.
Dialogue: 0,0:13:40.04,0:13:41.05,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:13:43.00,0:13:45.00,Default,,0,0,0,,Мен мұны бұрын естігенмін
Dialogue: 0,0:13:45.05,0:13:49.02,Default,,0,0,0,,Сіздікіндей қылышты қолданатын жауынгер туралы әңгіме.
Dialogue: 0,0:13:49.07,0:13:53.02,Default,,0,0,0,,Бұрынғы №2 жоғары жылдамдықты қылыш Айрин
Dialogue: 0,0:13:54.04,0:13:57.09,Default,,0,0,0,,Сол кездегі Терезаны бағындыратын бірінші топтың бірі
Dialogue: 0,0:13:58.04,0:14:02.01,Default,,0,0,0,,Содан бері оның қайда кеткенін ешкім білмейді.
Dialogue: 0,0:14:02.01,0:14:06.09,Default,,0,0,0,,2-ші нөмірге жеткен адам оңай өлмейді деп ойлаймын.
Dialogue: 0,0:14:08.06,0:14:10.06,Default,,0,0,0,,Қолыңызды қайда қойдыңыз?
Dialogue: 0,0:14:12.01,0:14:14.01,Default,,0,0,0,,Жауап беріңізші
Dialogue: 0,0:14:17.04,0:14:21.06,Default,,0,0,0,,Жауап бере алмайтындай етіп қойдым деп ойлағаным дұрыс шығар.
Dialogue: 0,0:14:24.03,0:14:27.00,Default,,0,0,0,,Мен оны кем дегенде бір рет сынап көргім келді.
Dialogue: 0,0:14:27.03,0:14:33.01,Default,,0,0,0,,Менің жел сызығым бұрынғы №2 жылдам семсерге жақындай алады ма?
Dialogue: 0,0:14:37.08,0:14:38.05,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:14:42.05,0:14:43.08,Default,,0,0,0,,Джин мырза
Dialogue: 0,0:14:44.02,0:14:46.06,Default,,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,0:14:46.06,0:14:49.00,Default,,0,0,0,,Маған кедергі жасамаңыз
Dialogue: 0,0:14:49.03,0:14:51.04,Default,,0,0,0,,Мен Клэрге қарыздармын.
Dialogue: 0,0:14:51.08,0:14:54.00,Default,,0,0,0,,Мен сені үнсіз өлтіруге рұқсат ете алмаймын
Dialogue: 0,0:14:54.07,0:14:57.07,Default,,0,0,0,,Тіпті оны өлтіруге себеп болса да
Dialogue: 0,0:14:58.00,0:14:59.00,Default,,0,0,0,,Сәйкес емес
Dialogue: 0,0:14:59.04,0:15:04.05,Default,,0,0,0,,Егер біреу Клэрге қылыш сілтесе, бұл менің қылышты суыруға жеткілікті себеп.
Dialogue: 0,0:15:04.05,0:15:05.07,Default,,0,0,0,,Ген, тоқтат.
Dialogue: 0,0:15:08.00,0:15:09.03,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:15:09.03,0:15:16.08,Default,,0,0,0,,Қалай болғанда да, мен келесі шабуылдың қашан болатынын білмегендіктен, бір-бірімді қатты ұрып-соғу ниетім болмады.
Dialogue: 0,0:15:17.03,0:15:21.04,Default,,0,0,0,,Бірақ мен сенімен күресе алмаймын, өйткені мен саған сенбеймін.
Dialogue: 0,0:15:22.04,0:15:24.07,Default,,0,0,0,,Сізді бағынышты командадан шығару үшін
Dialogue: 0,0:15:24.07,0:15:28.02,Default,,0,0,0,,Бұл қол Айриннен алынған.
Dialogue: 0,0:15:30.02,0:15:32.08,Default,,0,0,0,,Ол ұйымнан жасырынып жүр.
Dialogue: 0,0:15:32.08,0:15:34.09,Default,,0,0,0,,Мен бұл туралы мүмкіндігінше айтқым келмеді.
Dialogue: 0,0:15:35.03,0:15:40.03,Default,,0,0,0,,Мен шайқаста басым қолымды жоғалтқаннан кейін Айрин мені құтқарды.
Dialogue: 0,0:15:40.03,0:15:41.02,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:15:43.05,0:15:47.05,Default,,0,0,0,,Және мен ешқашан жоғалтқым келмейтін нәрсе үшін
Dialogue: 0,0:15:59.00,0:16:01.04,Default,,0,0,0,,Әдетте мен оны алмас едім.
Dialogue: 0,0:16:01.07,0:16:05.00,Default,,0,0,0,,Бірақ мен күресуді жалғастыруым керек еді
Dialogue: 0,0:16:05.07,0:16:06.07,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:16:07.03,0:16:08.00,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:16:09.09,0:16:13.00,Default,,0,0,0,,Сол кезде жоғалтқаным үшін
Dialogue: 0,0:16:15.03,0:16:20.09,Default,,0,0,0,,Мен соғысып, аман қалып, Оянған Присцилланың басын кесемін.
Dialogue: 0,0:16:21.03,0:16:23.04,Default,,0,0,0,,Оянған Прискила
Dialogue: 0,0:16:25.00,0:16:30.03,Default,,0,0,0,,Сен қазір қайда екенін де білмейтін Прискиланы жеңесің бе?
Dialogue: 0,0:16:31.03,0:16:34.06,Default,,0,0,0,,Сол себепті мен жауынгер атандым.
Dialogue: 0,0:16:37.07,0:16:42.04,Default,,0,0,0,,Менің ішімдегі Терезаның қаны мен еті
Dialogue: 0,0:16:48.08,0:16:52.03,Default,,0,0,0,,Әркімнің төбелесудің өзіндік себептері бар.
Dialogue: 0,0:16:55.04,0:16:59.05,Default,,0,0,0,,Осы шайқастан бірге аман өтейік.
Dialogue: 0,0:17:00.04,0:17:01.06,Default,,0,0,0,,Флора
Dialogue: 0,0:17:11.02,0:17:14.04,Default,,0,0,0,,Капитан, бұрын шағымданғаныма мен кінәлімін.
Dialogue: 0,0:17:14.07,0:17:16.02,Default,,0,0,0,,Мен ешқашан қорықпадым.
Dialogue: 0,0:17:16.02,0:17:17.03,Default,,0,0,0,,О
Dialogue: 0,0:17:17.03,0:17:18.07,Default,,0,0,0,,есімде жоқ.
Dialogue: 0,0:17:19.09,0:17:22.06,Default,,0,0,0,,Жара одан да тез жазылсын.
Dialogue: 0,0:17:22.06,0:17:27.00,Default,,0,0,0,,Мен бұл отрядтан бір адамның да өлуіне жол бермеймін.
Dialogue: 0,0:17:27.09,0:17:29.03,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:17:29.03,0:17:30.07,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:17:51.04,0:17:55.07,Default,,0,0,0,,Тамақ ішпей жақсы болу мен тамақтан рахат алудың айырмашылығы бар.
Dialogue: 0,0:17:56.05,0:17:59.06,Default,,0,0,0,,Мен тамақ ішкенде басқа ештеңені ойлаудың қажеті жоқ.
Dialogue: 0,0:18:00.05,0:18:06.04,Default,,0,0,0,,Бұл шайқас аяқталғанда, мен бүкіл команданы өзім сақтаған нәрсемен сыйлаймын.
Dialogue: 0,0:18:08.06,0:18:11.04,Default,,0,0,0,,Сіз оны жемейінше өлмейтін сияқтысыз.
Dialogue: 0,0:18:13.03,0:18:14.02,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:14.09,0:18:17.04,Default,,0,0,0,,Шамасы оны қорқақтық жел соқты.
Dialogue: 0,0:18:17.04,0:18:18.06,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:18:18.09,0:18:21.00,Default,,0,0,0,,Өйткені, біз адамбыз.
Dialogue: 0,0:18:22.09,0:18:24.00,Default,,0,0,0,,Айтамын ғой, қой!
Dialogue: 0,0:18:24.00,0:18:24.50,Default,,0,0,0,,О
Dialogue: 0,0:18:26.03,0:18:27.05,Default,,0,0,0,,That's right.
Dialogue: 0,0:18:35.06,0:18:41.00,Default,,0,0,0,,Мүмкін болса, осында жиналған барлық жауынгерлер аман қалады.
Dialogue: 0,0:18:42.06,0:18:45.01,Default,,0,0,0,,Мирия, сен осында болдың ба?
Dialogue: 0,0:18:45.01,0:18:48.03,Default,,0,0,0,,Жоқ, менде де бір ақау бар.
Dialogue: 0,0:18:48.03,0:18:51.01,Default,,0,0,0,,Сиынатын құдай жоқ.
Dialogue: 0,0:18:53.07,0:18:55.09,Default,,0,0,0,,Бұл тағы да ұрыс алаңы болады
Dialogue: 0,0:18:55.09,0:18:56.06,Default,,0,0,0,,О
Dialogue: 0,0:18:57.04,0:19:01.05,Default,,0,0,0,,Бүгінгі жекпе-жек тек андеркард шығар.
Dialogue: 0,0:19:02.00,0:19:06.00,Default,,0,0,0,,Бір рет тұңғиықтан бірдеңені кездестірсеңіз, түсінесіз.
Dialogue: 0,0:19:08.06,0:19:10.02,Default,,0,0,0,,Бұлай емес
Dialogue: 0,0:19:10.06,0:19:15.01,Default,,0,0,0,,Сол тұңғиықтағы нәрсе, егер Солтүстік Исли байыпты болса.
Dialogue: 0,0:19:30.03,0:19:31.09,Default,,0,0,0,,Маған ұйықтауға рұқсат етіңіз
Dialogue: 0,0:19:32.03,0:19:35.07,Default,,0,0,0,,Мен бар күшімді соңына дейін жұмсаған сияқтымын.
Dialogue: 0,0:19:38.04,0:19:40.09,Default,,0,0,0,,Адамдар біртүрлі нәрсе ғой, солай емес пе?
Dialogue: 0,0:19:41.04,0:19:46.04,Default,,0,0,0,,Сіз қаншалықты шектен шықпасаңыз да, сіз алатын қуат күлкілі аз.
Dialogue: 0,0:19:48.09,0:19:50.01,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:19:50.04,0:19:55.09,Default,,0,0,0,,Прискила ұнаса, мен саған қанша қаласаң, сонша қылыш үйретемін.
Dialogue: 0,0:20:00.08,0:20:05.00,Default,,0,0,0,,Прискила, үндемеші, сен қонақ сияқтысың.
Dialogue: 0,0:20:18.07,0:20:19.05,Default,,0,0,0,,Ригалдо
Dialogue: 0,0:20:23.06,0:20:27.02,Default,,0,0,0,,Сіз сияқты біреудің мұндай жерде лагерьде тұруы нені білдіреді?
Dialogue: 0,0:20:28.06,0:20:30.08,Default,,0,0,0,,Жақсы, кейде
Dialogue: 0,0:20:31.01,0:20:32.04,Default,,0,0,0,,Менің көңіл-күйім өзгереді
Dialogue: 0,0:20:33.02,0:20:33.52,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:20:34.02,0:20:35.06,Default,,0,0,0,,Пьетаның күйі қандай?
Dialogue: 0,0:20:36.02,0:20:36.52,Default,,0,0,0,,Иә
Dialogue: 0,0:20:45.06,0:20:46.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:48.08,0:20:50.04,Default,,0,0,0,,Әскерді жинаңыз
Dialogue: 0,0:20:53.01,0:21:00.06,Default,,0,0,0,,Солтүстік армия, барлығы 27, Альфонс бастаған қала Пиетаны жойды.
Dialogue: 0,0:21:00.06,0:21:05.08,Default,,0,0,0,,Бұл өмір жоқ қала болар.
Dialogue: 0,0:21:05.08,0:21:08.06,Default,,0,0,0,,Менің Эйсли есімімен
Dialogue: 0,0:21:08.06,0:21:13.05,Default,,0,0,0,,Тіпті бір тышқанның немесе жәндіктің өмірін жою.
Dialogue: 0,0:21:23.04,0:21:24.00,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Мейірімсіз патша
Dialogue: 0,0:22:42.03,0:22:43.08,Default,,0,0,0,,Мейірімсіз тәртіп
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Кісі өлтіру түні
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
