Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:00:55.88,0:01:00.89,Default,,0,0,0,,～♪
Dialogue: 0,0:01:10.86,0:01:12.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:18.11,0:01:19.53,Default,,0,0,0,,Мичиру иә?
Dialogue: 0,0:01:19.66,0:01:21.87,Default,,0,0,0,,Джеки, сен мұнда не үшін келдің?
Dialogue: 0,0:01:21.99,0:01:24.25,Default,,0,0,0,,Мына нан құлақтары дәмді.
Dialogue: 0,0:01:24.37,0:01:27.79,Default,,0,0,0,,Бұл жай ғана қоңыр аймақтар емес, ақ аймақтар да бар.
Dialogue: 0,0:01:28.21,0:01:30.04,Default,,0,0,0,,Нанның құлағын ғана білдің бе?
Dialogue: 0,0:01:30.17,0:01:30.79,Default,,0,0,0,,Уау! Бұл өте дәмді нан құлақтары.
Dialogue: 0,0:01:30.79,0:01:32.92,Default,,0,0,0,,Керемет! Бұл өте дәмді нан құлақтары.
Dialogue: 0,0:01:30.79,0:01:32.92,Default,,0,0,0,,Хмм... хахаха...
Dialogue: 0,0:01:32.92,0:01:33.05,Default,,0,0,0,,Хмм... хахаха...
Dialogue: 0,0:01:33.05,0:01:33.34,Default,,0,0,0,,Хмм... хахаха...
Dialogue: 0,0:01:33.05,0:01:33.34,Default,,0,0,0,,Ерекше нан құлақтары.
Dialogue: 0,0:01:33.34,0:01:33.67,Default,,0,0,0,,Ерекше нан құлақтары.
Dialogue: 0,0:01:33.67,0:01:35.13,Default,,0,0,0,,Ерекше нан құлақтары
Dialogue: 0,0:01:33.67,0:01:35.13,Default,,0,0,0,,А... өте... ғажап
Dialogue: 0,0:01:35.26,0:01:37.55,Default,,0,0,0,,Иісінен басқа.
Dialogue: 0,0:01:37.68,0:01:38.76,Default,,0,0,0,,Кунга кунга Кунга кунга
Dialogue: 0,0:01:38.76,0:01:39.59,Default,,0,0,0,,Кунга кунга Кунга кунга
Dialogue: 0,0:01:38.76,0:01:39.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:40.14,0:01:42.64,Default,,0,0,0,,А, Мичирудың досы ма?
Dialogue: 0,0:01:42.76,0:01:46.06,Default,,0,0,0,,Иә, өте шулы болғаным үшін кешіріңіз.
Dialogue: 0,0:01:47.44,0:01:49.85,Default,,0,0,0,,Сіз шынымен де кез келген жерде достар таба аласыз.
Dialogue: 0,0:01:50.27,0:01:51.98,Default,,0,0,0,,Не? (Джеки) Джинро-сама!
Dialogue: 0,0:01:52.36,0:01:52.86,Default,,0,0,0,,Бұл Джинро-сама (Аң адам) Джинро-сама
Dialogue: 0,0:01:52.86,0:01:54.19,Default,,0,0,0,,Бұл Джинро-сама (Аң адам) Джинро-сама
Dialogue: 0,0:01:52.86,0:01:54.19,Default,,0,0,0,,Джинро-сама
Dialogue: 0,0:01:54.53,0:01:57.49,Default,,0,0,0,,Super Pan Ears Рахмет
Dialogue: 0,0:01:57.61,0:02:01.16,Default,,0,0,0,,Егер сіз аш болсаңыз, кез келген уақытта шіркеуге келіңіз.
Dialogue: 0,0:02:01.28,0:02:02.87,Default,,0,0,0,,Джинро-сама~!
Dialogue: 0,0:02:03.66,0:02:04.95,Default,,0,0,0,,Жақсы аң соусы
Dialogue: 0,0:02:05.33,0:02:08.08,Default,,0,0,0,,Жақсы аң соусы
Dialogue: 0,0:02:11.75,0:02:12.79,Default,,0,0,0,,Иә
Dialogue: 0,0:02:13.46,0:02:17.26,Default,,0,0,0,,Бірақ, концертке аңдардың көп жиналуы дұрыс па?
Dialogue: 0,0:02:17.88,0:02:21.76,Default,,0,0,0,,Фестиваль сияқты көңілді сезімге ие болу маңызды.
Dialogue: 0,0:02:21.89,0:02:22.89,Default,,0,0,0,,Алан айтты
Dialogue: 0,0:02:23.22,0:02:26.14,Default,,0,0,0,,Ойлап қарасам, мен келген бірінші күні фестиваль өтіп жатыр екен.
Dialogue: 0,0:02:27.10,0:02:28.73,Default,,0,0,0,,Ол тікелей эфирде де көрсетіледі.
Dialogue: 0,0:02:28.85,0:02:31.69,Default,,0,0,0,,Әзірше мен оны көңілді әндермен шығаруға тырыстым.
Dialogue: 0,0:02:31.81,0:02:33.48,Default,,0,0,0,,Сіз қалай ойлайсыз? Хмм...
Dialogue: 0,0:02:35.73,0:02:38.53,Default,,0,0,0,,Не, сен мына әнді айтасың ба? Жоқ?
Dialogue: 0,0:02:38.65,0:02:41.95,Default,,0,0,0,,Назуна, сен бұл әнді айтсаң, әдемі көрінесің.
Dialogue: 0,0:02:42.07,0:02:42.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:43.03,0:02:45.54,Default,,0,0,0,,Бұл өтірік емес пе? Бұл кірмейді.
Dialogue: 0,0:02:45.91,0:02:49.71,Default,,0,0,0,,Хмм, бұл рас, бірақ менің ойымша, бұл тірі қойылымдар үшін өте қолайлы емес.
Dialogue: 0,0:02:49.83,0:02:51.08,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:02:51.21,0:02:54.38,Default,,0,0,0,,Солай ма? Иә, мен оны естігім келеді.
Dialogue: 0,0:02:55.21,0:02:57.09,Default,,0,0,0,,Ммм
Dialogue: 0,0:02:58.01,0:02:59.80,Default,,0,0,0,,Үйрет бізге.
Dialogue: 0,0:03:00.22,0:03:04.05,Default,,0,0,0,,Бұл түнде жыпылықтайды
Dialogue: 0,0:03:04.18,0:03:08.18,Default,,0,0,0,,Қалағаныңызша ұшыңыз
Dialogue: 0,0:03:08.31,0:03:12.35,Default,,0,0,0,,Еркінірек жүгірейік
Dialogue: 0,0:03:12.48,0:03:16.07,Default,,0,0,0,,Жұлдыздарға қара
Dialogue: 0,0:03:16.19,0:03:19.49,Default,,0,0,0,,(Мичиру мен Назунаның күлкісі)
Dialogue: 0,0:03:20.11,0:03:21.57,Default,,0,0,0,,Қазір шешілді.
Dialogue: 0,0:03:21.70,0:03:24.82,Default,,0,0,0,,Мен Мичирудың сүйікті әнін таңдамаймын.
Dialogue: 0,0:03:24.95,0:03:26.45,Default,,0,0,0,,Иә? Эй
Dialogue: 0,0:03:26.95,0:03:29.91,Default,,0,0,0,,МК бөлімінде жазылған «мойындау» дегеніміз не?
Dialogue: 0,0:03:30.25,0:03:34.63,Default,,0,0,0,,О, бұл? «Негізі мен адаммын» деп айтатыным сол.
Dialogue: 0,0:03:34.75,0:03:35.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:36.13,0:03:38.92,Default,,0,0,0,,Бұлай айту дұрыс па?
Dialogue: 0,0:03:39.05,0:03:41.26,Default,,0,0,0,,Алан дәрі ішіп болған кезде...
Dialogue: 0,0:03:41.38,0:03:45.30,Default,,0,0,0,,Айуандардың күйзелісін сәл де болса жеңілдету керек.
Dialogue: 0,0:03:46.18,0:03:48.89,Default,,0,0,0,,Сонымен... не...
Dialogue: 0,0:03:49.72,0:03:54.23,Default,,0,0,0,,Аңдар мен адамдар айырмашылығы жоқ; олар бірдей өмір сүре алады.
Dialogue: 0,0:03:54.60,0:03:57.65,Default,,0,0,0,,Соны көп айта алатын біз емеспіз бе?
Dialogue: 0,0:03:57.77,0:04:00.19,Default,,0,0,0,,Хмм... иә
Dialogue: 0,0:04:10.16,0:04:11.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:13.16,0:04:14.50,Default,,0,0,0,,Ах
Dialogue: 0,0:04:15.67,0:04:16.63,Default,,0,0,0,,Төбе!
Dialogue: 0,0:04:26.05,0:04:27.51,Default,,0,0,0,,Қозғалмаңыз! Ах...
Dialogue: 0,0:04:28.22,0:04:29.68,Default,,0,0,0,,Уф... уау (мүше) Ах.
Dialogue: 0,0:04:29.81,0:04:31.85,Default,,0,0,0,,Уау! (Ишизаки) Мен осындамын.
Dialogue: 0,0:04:31.98,0:04:33.18,Default,,0,0,0,,Анима қаласына тез жетіңіз
Dialogue: 0,0:04:34.02,0:04:36.56,Default,,0,0,0,,Рахмет Ишизаки
Dialogue: 0,0:04:41.78,0:04:43.11,Default,,0,0,0,,Кемені қалай дайындау керек?
Dialogue: 0,0:04:43.57,0:04:46.45,Default,,0,0,0,,Біріншіден, сіз қазір отырған жүк кемесінде 1000 адам.
Dialogue: 0,0:04:46.57,0:04:49.41,Default,,0,0,0,,5 күн ішінде үлкен круиздік кемеде 5000 адам
Dialogue: 0,0:04:49.53,0:04:52.58,Default,,0,0,0,,Осылайша сіз табынушылықтан алған соманы азайта аласыз.
Dialogue: 0,0:04:52.95,0:04:54.46,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:54.58,0:04:58.29,Default,,0,0,0,,Бұл қала жоғалып кетсе, біз де қиындыққа тап боламыз.
Dialogue: 0,0:04:58.42,0:05:02.05,Default,,0,0,0,,Ху~ Мен сені қол ұстасып кетеді деп ойламаппын.
Dialogue: 0,0:05:02.59,0:05:05.80,Default,,0,0,0,,Мен «Күміс қасқыр» культінің қозғалысын зерттедім.
Dialogue: 0,0:05:06.38,0:05:08.01,Default,,0,0,0,,Мұны кім сұрады?
Dialogue: 0,0:05:08.47,0:05:12.18,Default,,0,0,0,,Жақсы ақша табасыз, себебі сіз сұрағанға дейін әрекет етесіз.
Dialogue: 0,0:05:12.31,0:05:14.98,Default,,0,0,0,,Тануки-чанның да қатысы жоқ сияқты.
Dialogue: 0,0:05:15.10,0:05:16.73,Default,,0,0,0,,Оны естігің келмесе, жақсы.
Dialogue: 0,0:05:19.11,0:05:20.73,Default,,0,0,0,,Тез сөйле
Dialogue: 0,0:05:20.86,0:05:24.53,Default,,0,0,0,,Мен гуру-самамен тікелей эфирде кездесу өткіздім.
Dialogue: 0,0:05:24.65,0:05:27.70,Default,,0,0,0,,Құрылтайшы адам дейді.
Dialogue: 0,0:05:28.24,0:05:30.70,Default,,0,0,0,,Дәрі біткендегі жануардың күйзелісі.
Dialogue: 0,0:05:30.83,0:05:32.66,Default,,0,0,0,,Бұл тыныштандыру мақсатында ма?
Dialogue: 0,0:05:33.12,0:05:34.16,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:05:39.71,0:05:42.88,Default,,0,0,0,,Эй, Назуна, сен мұны шынымен мойындайсың ба?
Dialogue: 0,0:05:43.80,0:05:44.92,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:05:45.05,0:05:48.38,Default,,0,0,0,,Нирвазир синдромының алдын алу үшін не қажет?
Dialogue: 0,0:05:49.64,0:05:50.76,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:50.89,0:05:53.85,Default,,0,0,0,,Бірақ егер Ширу-сан мұны естісе, ол ашуланады деп ойлаймын.
Dialogue: 0,0:05:54.35,0:05:57.52,Default,,0,0,0,,Неліктен? Өйткені мен мұны хайуанаттар үшін жасауға тырысамын...
Dialogue: 0,0:05:57.64,0:05:58.60,Default,,0,0,0,,Ашулануға болмайды, солай ма?
Dialogue: 0,0:05:59.40,0:06:01.06,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:01.19,0:06:02.57,Default,,0,0,0,,Құрметті Де Лув
Dialogue: 0,0:06:02.98,0:06:04.90,Default,,0,0,0,,Қарсы болмасаңыз, кетіңіз.
Dialogue: 0,0:06:05.03,0:06:07.11,Default,,0,0,0,,Мичиру менімен бірге келгені дұрыс емес пе?
Dialogue: 0,0:06:07.78,0:06:09.49,Default,,0,0,0,,Екінші адам да бар.
Dialogue: 0,0:06:09.61,0:06:11.99,Default,,0,0,0,,Бүгінгідей жақсы емес...
Dialogue: 0,0:06:12.12,0:06:15.04,Default,,0,0,0,,Жарайды, менің бір немере ағам бар, мен сәл тоқтап кетейін.
Dialogue: 0,0:06:15.66,0:06:16.54,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:06:17.87,0:06:20.25,Default,,0,0,0,,Қатысушылар үшін қабылдау бөлімінде түсіндіремін.
Dialogue: 0,0:06:20.37,0:06:22.63,Default,,0,0,0,,Кешігіп қалмас үшін келіңіз.
Dialogue: 0,0:06:22.75,0:06:24.46,Default,,0,0,0,,Кейін кездескенше.
Dialogue: 0,0:06:57.54,0:07:00.58,Default,,0,0,0,,Сол фестивальге қарағанда адам көп болуы мүмкін.
Dialogue: 0,0:07:00.71,0:07:02.17,Default,,0,0,0,,Бұл қашан болды...
Dialogue: 0,0:07:02.29,0:07:03.58,Default,,0,0,0,,Мичиру-чан!
Dialogue: 0,0:07:03.71,0:07:04.88,Default,,0,0,0,,Иә? Ха! ?
Dialogue: 0,0:07:05.50,0:07:08.09,Default,,0,0,0,,Мен сені таң қалдырдым ба?
Dialogue: 0,0:07:08.21,0:07:09.05,Default,,0,0,0,,Джем мырза?
Dialogue: 0,0:07:09.17,0:07:11.26,Default,,0,0,0,,Өйткені бұл Джинро-саманың жанды орындауы.
Dialogue: 0,0:07:11.38,0:07:13.39,Default,,0,0,0,,Бұл фестиваль, бұл фестиваль, хехехе~
Dialogue: 0,0:07:13.51,0:07:15.05,Default,,0,0,0,,Джем мырза, Мелисса мырза
Dialogue: 0,0:07:15.60,0:07:17.18,Default,,0,0,0,,Мұны екі адам істеп тұрды.
Dialogue: 0,0:07:17.64,0:07:20.94,Default,,0,0,0,,Бұл менің Джинро-самаға деген алғыс сезімім.
Dialogue: 0,0:07:21.06,0:07:24.81,Default,,0,0,0,,Бұл қала салынбайынша, хайуандардың есіне алғылары да келмейді...
Dialogue: 0,0:07:24.94,0:07:30.11,Default,,0,0,0,,Бәрімізде бір-екі ауыр сезім жарасы бар.
Dialogue: 0,0:07:30.95,0:07:32.53,Default,,0,0,0,,Әрине, бізге де.
Dialogue: 0,0:07:33.16,0:07:33.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:34.37,0:07:37.41,Default,,0,0,0,,Мұндай жағдайда Джинро-сама туралы аңыз қанша?
Dialogue: 0,0:07:37.54,0:07:39.95,Default,,0,0,0,,Бұл сізге эмоционалды қолдау көрсетті ме?
Dialogue: 0,0:07:40.08,0:07:42.71,Default,,0,0,0,,Сондықтан бәріміз бірге жасадық.
Dialogue: 0,0:07:42.83,0:07:43.71,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:07:44.21,0:07:47.67,Default,,0,0,0,,Иә, Анима қаласының барлық аңдары.
Dialogue: 0,0:07:48.13,0:07:52.09,Default,,0,0,0,,Аңдарды 1000 жыл бойы қорғағаныңыз үшін ризашылығыңызды білдіріңіз.
Dialogue: 0,0:07:52.22,0:07:56.10,Default,,0,0,0,,Бұл Джинро-самаға жеткізілмеген болуы мүмкін.
Dialogue: 0,0:07:59.35,0:08:02.81,Default,,0,0,0,,Мен әркімнің сезімін жеткізіп жатқанына сенімдімін.
Dialogue: 0,0:08:02.94,0:08:06.11,Default,,0,0,0,,Джинро-саманың қуанғаны сонша, жылап жіберді.
Мен бұл
Dialogue: 0,0:08:07.48,0:08:09.61,Default,,0,0,0,,хехе деп үміттенемін
Dialogue: 0,0:08:10.03,0:08:10.99,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:08:11.53,0:08:13.11,Default,,0,0,0,,Мичиру-чанға рахмет
Dialogue: 0,0:08:14.66,0:08:15.87,Default,,0,0,0,,Ах
Dialogue: 0,0:08:20.75,0:08:22.37,Default,,0,0,0,,А... Мичиру-чан?
Dialogue: 0,0:08:23.00,0:08:23.83,Default,,0,0,0,,Мичиру ше?
Dialogue: 0,0:08:24.17,0:08:26.88,Default,,0,0,0,,Келіңіздер ме? Әлі келмеген сияқты
Dialogue: 0,0:08:27.00,0:08:30.80,Default,,0,0,0,,Уақытыммен тым бос жүргенім өзгерген жоқ.
Dialogue: 0,0:08:32.59,0:08:33.76,Default,,0,0,0,,Қайда?
Dialogue: 0,0:08:39.39,0:08:40.77,Default,,0,0,0,,Широ-сан...
Dialogue: 0,0:08:44.85,0:08:45.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:47.77,0:08:51.28,Default,,0,0,0,,Әзірге Куромаки отбасы мүшелерін кемеге отырғызуда.
Dialogue: 0,0:08:51.40,0:08:53.44,Default,,0,0,0,,Қалғандары шалғайдағы адамдар.
Dialogue: 0,0:08:53.57,0:08:55.70,Default,,0,0,0,,Оларға ақша жинау оңай
Dialogue: 0,0:08:56.07,0:08:58.66,Default,,0,0,0,,Мари, сіз жақсы нәрсе айтасыз...
Dialogue: 0,0:08:58.78,0:09:00.83,Default,,0,0,0,,Мүмкіндігінше көп адам өтетін жерден қашып кетсін
Dialogue: 0,0:09:01.49,0:09:02.54,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:09:04.71,0:09:08.63,Default,,0,0,0,,Бұл қажет пе? (Широу) Сәтсіздік опция емес.
Dialogue: 0,0:09:08.75,0:09:10.67,Default,,0,0,0,,Онда біз де барамыз.
Dialogue: 0,0:09:10.80,0:09:13.59,Default,,0,0,0,,Жылтырлықпен тұтынушыларды арандату да жаман.
Dialogue: 0,0:09:13.71,0:09:15.93,Default,,0,0,0,,Сізден төтенше жағдайды жою сұралады.
Dialogue: 0,0:09:16.63,0:09:18.43,Default,,0,0,0,,Құрылтайшыны өзім тоқтата аламын.
Dialogue: 0,0:09:23.52,0:09:25.73,Default,,0,0,0,,Угх, угх, ах…
Dialogue: 0,0:09:27.81,0:09:29.69,Default,,0,0,0,,(Мичирудың иіскеу дыбысы)
Dialogue: 0,0:09:54.13,0:09:55.38,Default,,0,0,0,,Ширу-сан!
Dialogue: 0,0:09:56.05,0:09:57.93,Default,,0,0,0,,Уақыт таяп қалды
Dialogue: 0,0:09:58.05,0:09:59.84,Default,,0,0,0,,Жоғалған аңдар...
Dialogue: 0,0:09:59.97,0:10:02.72,Default,,0,0,0,,Мен сені көруге шыдамаймын.
Dialogue: 0,0:10:02.85,0:10:04.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:04.68,0:10:08.06,Default,,0,0,0,,Жасай бер, Назуна, шын бол.
Dialogue: 0,0:10:13.69,0:10:14.86,Default,,0,0,0,,Мұндағы жолдар-
Dialogue: 0,0:10:14.98,0:10:15.86,Default,,0,0,0,,Полиция мен аң-адамды басу күштері барлық жерде.
Dialogue: 0,0:10:15.86,0:10:17.15,Default,,0,0,0,,Полиция мен аң-адамды басу күштері барлық жерде.
Dialogue: 0,0:10:15.86,0:10:17.15,Default,,0,0,0,,Ах
Dialogue: 0,0:10:17.15,0:10:18.03,Default,,0,0,0,,Полиция мен аң-адамды басу күштері барлық жерде.
Dialogue: 0,0:10:18.82,0:10:21.99,Default,,0,0,0,,Оның үстіне Анима Ситидің алдында көптеген бақылау бекеттері бар.
Dialogue: 0,0:10:22.28,0:10:25.29,Default,,0,0,0,,Менің ойымша, бұл жүру мүмкін емес, мэр мырза.
Dialogue: 0,0:10:26.20,0:10:28.21,Default,,0,0,0,,Сіз кездейсоқ Пингасыз ба?
Dialogue: 0,0:10:28.33,0:10:31.46,Default,,0,0,0,,Күткендей, мэр мырза, сіз өте жақсы түсіндіңіз.
Dialogue: 0,0:10:35.92,0:10:37.17,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:10:37.30,0:10:39.09,Default,,0,0,0,,Егер сіз үкіметтік хабарламаларды тыңдасаңыз...
Dialogue: 0,0:10:39.22,0:10:40.72,Default,,0,0,0,,Бұл қиынға соғатын сияқты...
Dialogue: 0,0:10:40.84,0:10:42.35,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:42.47,0:10:43.80,Default,,0,0,0,,Қызығып, қайтып келсеңіз...
Dialogue: 0,0:10:43.93,0:10:46.56,Default,,0,0,0,,Мен сені адамдар қуып бара жатқанын көріп тұрмын.
Dialogue: 0,0:10:46.68,0:10:48.06,Default,,0,0,0,,Досымның бейітін жасағанша...
Dialogue: 0,0:10:48.18,0:10:49.94,Default,,0,0,0,,Әкім боқтық берсе, қиналып қалар едім.
Dialogue: 0,0:10:50.73,0:10:53.40,Default,,0,0,0,,Енот қыздың еңбегін зая кеткім келмейді.
Dialogue: 0,0:10:54.65,0:10:55.86,Default,,0,0,0,,Ах
Dialogue: 0,0:10:57.36,0:10:59.82,Default,,0,0,0,,Иә, бұл аңдарға қарсы қозғалмалы қару.
Dialogue: 0,0:10:59.95,0:11:00.78,Default,,0,0,0,,Қарулар?
Dialogue: 0,0:11:01.20,0:11:03.70,Default,,0,0,0,,А, аңға қарсы күштермен шайқаста...
Dialogue: 0,0:11:03.82,0:11:05.16,Default,,0,0,0,,Соғысқан
Dialogue: 0,0:11:05.28,0:11:07.91,Default,,0,0,0,,Болды... Анима Ситиге асығыңыз!
Dialogue: 0,0:11:08.54,0:11:10.37,Default,,0,0,0,,Менің айтқым келгені осы!
Dialogue: 0,0:11:13.42,0:11:14.88,Default,,0,0,0,,Я...
Dialogue: 0,0:11:15.21,0:11:17.38,Default,,0,0,0,,Енді не істеу керек... Ах.
Dialogue: 0,0:11:21.13,0:11:22.64,Default,,0,0,0,,Га
Dialogue: 0,0:11:23.01,0:11:24.26,Default,,0,0,0,,Уф
Dialogue: 0,0:11:28.18,0:11:29.31,Default,,0,0,0,,Ха...
Dialogue: 0,0:11:30.73,0:11:32.65,Default,,0,0,0,,Неге...
Dialogue: 0,0:11:33.23,0:11:34.36,Default,,0,0,0,,Широ-сан
Dialogue: 0,0:11:36.19,0:11:37.11,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:11:48.20,0:11:51.79,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:11:51.91,0:11:56.59,Default,,0,0,0,,♪～
Dialogue: 0,0:12:20.94,0:12:24.36,Default,,0,0,0,,Енді нұр жауған жерге
Dialogue: 0,0:12:24.49,0:12:27.24,Default,,0,0,0,,Жүре бастаған жан
Dialogue: 0,0:12:27.37,0:12:30.87,Default,,0,0,0,,Жанашырлықпен бірге
Dialogue: 0,0:12:31.00,0:12:35.67,Default,,0,0,0,,Таусылмас арман болсын
Dialogue: 0,0:12:40.42,0:12:44.01,Default,,0,0,0,,Кешіріңіз! Ширудың аңшыларға деген құмарлығы
Dialogue: 0,0:12:44.13,0:12:46.01,Default,,0,0,0,,Мен бірінші болып түсінуім керек еді.
Dialogue: 0,0:12:47.26,0:12:49.51,Default,,0,0,0,,Адамнан хайуан болдым.
Dialogue: 0,0:12:49.64,0:12:52.98,Default,,0,0,0,,Мен өзім болмау қорқынышын ең жақсы білдім.
Dialogue: 0,0:12:53.52,0:12:56.98,Default,,0,0,0,,Бірақ мен Ширудың сезімін байқамадым.
Dialogue: 0,0:12:57.10,0:12:59.32,Default,,0,0,0,,Сондықтан мен кешірім сұрауым керек
Dialogue: 0,0:13:00.61,0:13:01.44,Default,,0,0,0,,Сіз...
Dialogue: 0,0:13:02.03,0:13:03.90,Default,,0,0,0,,Бірақ мен тағы да түсінбеймін.
Dialogue: 0,0:13:04.61,0:13:08.91,Default,,0,0,0,,Ширу-сан, сен не істемексің? Неге мылтық...
Dialogue: 0,0:13:09.03,0:13:11.37,Default,,0,0,0,,Айтпасаң түсінбеймін.
Dialogue: 0,0:13:11.83,0:13:14.75,Default,,0,0,0,,Назуна менің досым!
Dialogue: 0,0:13:15.12,0:13:18.46,Default,,0,0,0,,Ширу Назунаға неге берді...
Dialogue: 0,0:13:19.04,0:13:20.42,Default,,0,0,0,,Неге...
Dialogue: 0,0:13:27.68,0:13:29.97,Default,,0,0,0,,Бұл жаман болды, иә?
Dialogue: 0,0:13:30.51,0:13:32.68,Default,,0,0,0,,Досыңды ренжіткім келмейді.
Dialogue: 0,0:13:32.81,0:13:34.73,Default,,0,0,0,,Бірақ бұл тірі...
Dialogue: 0,0:13:35.48,0:13:39.10,Default,,0,0,0,,Жоқ, бұл мойындауды тоқтату керек.
Dialogue: 0,0:13:39.81,0:13:42.44,Default,,0,0,0,,Құрылтайшы өзінің адам екенін мойындаса...
Dialogue: 0,0:13:42.57,0:13:45.40,Default,,0,0,0,,Нирвазир синдромын қоздырады
Dialogue: 0,0:13:47.82,0:13:50.28,Default,,0,0,0,,Гуру өзінің шынайы болмысын қашан ашады?
Dialogue: 0,0:13:50.78,0:13:52.87,Default,,0,0,0,,Мойындау шынымен триггер ме?
Dialogue: 0,0:13:53.29,0:13:56.54,Default,,0,0,0,,Айуандардың қыңыр екені даусыз.
Dialogue: 0,0:13:56.66,0:14:00.29,Default,,0,0,0,,Адамдарға қарағанда жанашырлық пен күшті жорамалда тереңірек
Dialogue: 0,0:14:00.42,0:14:03.05,Default,,0,0,0,,Сенген нәрсеге алданғаныңды білсең...
Dialogue: 0,0:14:03.17,0:14:05.38,Default,,0,0,0,,Ол кездегі дүмпу адамдармен салыстыруға келмейтін.
Dialogue: 0,0:14:05.97,0:14:07.47,Default,,0,0,0,,Әрқашан бақылаудан шығады
Dialogue: 0,0:14:07.59,0:14:10.64,Default,,0,0,0,,Бұл Назунаның Аланнан естігеніне керісінше дегенді білдіре ме?
Dialogue: 0,0:14:11.22,0:14:12.89,Default,,0,0,0,,Алан мұны біліп, істеген болуы керек.
Dialogue: 0,0:14:13.35,0:14:15.14,Default,,0,0,0,,А... не үшін?
Dialogue: 0,0:14:15.60,0:14:16.85,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:14:16.98,0:14:20.06,Default,,0,0,0,,Ең алдымен мойындауды тоқтату керек.
Dialogue: 0,0:14:20.19,0:14:22.69,Default,,0,0,0,,Сіз мені көндіре алмайсыз ба?
Dialogue: 0,0:14:22.82,0:14:24.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:24.19,0:14:24.73,Default,,0,0,0,,Кенет төңкерілді
Dialogue: 0,0:14:24.73,0:14:25.78,Default,,0,0,0,,Кенет төңкерілді
Dialogue: 0,0:14:24.73,0:14:25.78,Default,,0,0,0,,Ах
Dialogue: 0,0:14:25.78,0:14:27.57,Default,,0,0,0,,Кенет төңкерілді
Dialogue: 0,0:14:27.70,0:14:30.32,Default,,0,0,0,,Әлем өзгеруде
Dialogue: 0,0:14:30.45,0:14:32.53,Default,,0,0,0,,Осы әнмен тыңдармандардың үстінен ұшып бара жатқанда...
Dialogue: 0,0:14:32.91,0:14:37.00,Default,,0,0,0,,Қарсы сахнаға өтіп, костюмдерді ауыстырыңыз...
Dialogue: 0,0:14:37.83,0:14:38.96,Default,,0,0,0,,Екінші жағынан...
Dialogue: 0,0:14:39.42,0:14:41.33,Default,,0,0,0,,Ұшу Ол жылдамырақ
Dialogue: 0,0:14:41.46,0:14:44.42,Default,,0,0,0,,Аудиторияны арандатпаңыз. Мен де кейін келемін.
Dialogue: 0,0:14:44.55,0:14:45.71,Default,,0,0,0,,Иә
Dialogue: 0,0:14:46.09,0:14:46.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:47.59,0:14:53.30,Default,,0,0,0,,Жылағым келеді, бірақ жеңілгім келмейді
Dialogue: 0,0:14:53.43,0:14:55.26,Default,,0,0,0,,Үйрет бізге.
Dialogue: 0,0:14:55.39,0:14:58.85,Default,,0,0,0,,Бұл түнде жыпылықтайды
Dialogue: 0,0:14:58.98,0:15:00.98,Default,,0,0,0,,Қалауыңызша...
Dialogue: 0,0:15:01.60,0:15:02.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:04.48,0:15:05.69,Default,,0,0,0,,Га
Dialogue: 0,0:15:07.19,0:15:08.03,Default,,0,0,0,,Инспектор…
Dialogue: 0,0:15:08.53,0:15:12.03,Default,,0,0,0,,Төраға Алан сіздің мұнда міндетті түрде келетініңізді айтты.
Dialogue: 0,0:15:12.41,0:15:13.24,Default,,0,0,0,,Алан?
Dialogue: 0,0:15:13.70,0:15:16.12,Default,,0,0,0,,Бұл болғаны үшін кешірім сұраймын.
Dialogue: 0,0:15:16.24,0:15:19.04,Default,,0,0,0,,Инспектор, бізде уақыт жоқ, маған осы жерден өтуге рұқсат етіңіз.
Dialogue: 0,0:15:19.16,0:15:22.58,Default,,0,0,0,,Жоқ, сізді іздеудесіз.
Dialogue: 0,0:15:22.71,0:15:25.09,Default,,0,0,0,,Мен ол қылмысты біткен соң төлеймін.
Dialogue: 0,0:15:25.21,0:15:26.55,Default,,0,0,0,,Бұл қала қазір қауіпті.
Dialogue: 0,0:15:27.09,0:15:29.26,Default,,0,0,0,,Егер біз бұл тірі қойылымды тоқтатпасақ, Анима қаласы жойылады.
Dialogue: 0,0:15:30.09,0:15:31.22,Default,,0,0,0,,Бірақ егер біз мұнда сүрінсек, Құрылтайшы Титанға қарсы ешқашан мүмкіндігіміз болмайды.
Dialogue: 0,0:15:31.68,0:15:35.18,Default,,0,0,0,,Мен тек хайуандарды қорғағым келеді, бар болғаны.
Dialogue: 0,0:15:35.80,0:15:39.27,Default,,0,0,0,,Өтінемін, бұл қаланы тозаққа айналдырмаңыз!
Dialogue: 0,0:15:40.31,0:15:41.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:42.35,0:15:44.73,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:15:45.15,0:15:46.44,Default,,0,0,0,,Жарайды, уақытында келдің.
Dialogue: 0,0:15:49.99,0:15:50.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:50.95,0:15:54.87,Default,,0,0,0,,Жоспарларды өзгерту. Осы жерде мойындаңыз.
Dialogue: 0,0:15:54.99,0:15:55.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:56.24,0:15:59.29,Default,,0,0,0,,Көрермендер күткендегіден де толқып кетті.
Dialogue: 0,0:15:59.66,0:16:03.00,Default,,0,0,0,,Қауіпсіз жақта болу үшін алға жылжыңыз.
Dialogue: 0,0:16:03.42,0:16:04.25,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:05.29,0:16:09.17,Default,,0,0,0,,Барлығы~ Көңілдің ба?
Dialogue: 0,0:16:09.30,0:16:11.17,Default,,0,0,0,,Не? жоспарланғаннан өзгеше
Dialogue: 0,0:16:12.93,0:16:14.43,Default,,0,0,0,,Мен де толқып тұрмын.
Dialogue: 0,0:16:14.43,0:16:15.93,Default,,0,0,0,,Мен де толқып тұрмын.
Dialogue: 0,0:16:14.43,0:16:15.93,Default,,0,0,0,,Қауіпті, қауіпті, қауіпті... А!
Dialogue: 0,0:16:15.93,0:16:16.39,Default,,0,0,0,,Қауіпті, қауіпті, қауіпті... А!
Dialogue: 0,0:16:19.06,0:16:24.27,Default,,0,0,0,,Бүгін көп адам жиналғанына ризамын...
Dialogue: 0,0:16:24.40,0:16:27.61,Default,,0,0,0,,Барлығыңызға көп рахмет!
Dialogue: 0,0:16:27.73,0:16:29.65,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:16:29.78,0:16:31.82,Default,,0,0,0,,Жақсы кемонобито соусы!
Dialogue: 0,0:16:31.94,0:16:34.07,Default,,0,0,0,,Жақсы кемонобито соусы!
Dialogue: 0,0:16:34.53,0:16:36.66,Default,,0,0,0,,Жақсы жануар!
Dialogue: 0,0:16:36.78,0:16:39.54,Default,,0,0,0,,Жақсы кемонобито соусы!
Dialogue: 0,0:16:39.66,0:16:44.67,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:16:51.17,0:16:52.84,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:16:52.97,0:16:56.30,Default,,0,0,0,,Бүгін саған бір нәрсе айтқым келеді.
Dialogue: 0,0:16:56.43,0:16:59.01,Default,,0,0,0,,Иә? (Көрермендер) Не? Не?
Dialogue: 0,0:16:59.68,0:17:01.18,Default,,0,0,0,,Бұл... а
Dialogue: 0,0:17:01.31,0:17:04.18,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,0:17:13.57,0:17:14.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:17.20,0:17:19.12,Default,,0,0,0,,Мичиру Назуна! ?
Dialogue: 0,0:17:19.58,0:17:21.54,Default,,0,0,0,,Мойындауды доғар, а?
Dialogue: 0,0:17:21.66,0:17:25.29,Default,,0,0,0,,(аудитория шуы)
Dialogue: 0,0:17:25.62,0:17:27.79,Default,,0,0,0,,Маған сеніңіз
Dialogue: 0,0:17:30.59,0:17:33.42,Default,,0,0,0,,Мен барлығына не айтқым келеді
Dialogue: 0,0:17:34.09,0:17:35.63,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:36.55,0:17:41.60,Default,,0,0,0,,Осы үлкен күміс қасқырды жасағандардың барлығына алғысымды білдіргім келеді.
Dialogue: 0,0:17:42.06,0:17:43.39,Default,,0,0,0,,Ах! рақмет сізге!
Dialogue: 0,0:17:43.52,0:17:46.64,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:17:46.77,0:17:48.52,Default,,0,0,0,,Кейінірек дұрыс түсіндіріңіз.
Dialogue: 0,0:17:49.19,0:17:50.36,Default,,0,0,0,,Иә
Dialogue: 0,0:17:52.52,0:17:55.19,Default,,0,0,0,,Ха... сен мұны істедің бе?
Dialogue: 0,0:17:56.32,0:17:57.15,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:57.28,0:18:00.41,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,0:18:00.53,0:18:02.28,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:18:03.41,0:18:04.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:07.66,0:18:10.00,Default,,0,0,0,,(полиция қызметкерлері айқайлайды)
Dialogue: 0,0:18:10.50,0:18:11.96,Default,,0,0,0,,Бұл... Ха (механикалық дыбыс)
Dialogue: 0,0:18:14.67,0:18:15.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:16.05,0:18:17.09,Default,,0,0,0,,Оками-кун!
Dialogue: 0,0:18:17.59,0:18:18.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:21.01,0:18:22.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:28.81,0:18:32.65,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:33.02,0:18:34.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:34.23,0:18:35.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:37.40,0:18:38.82,Default,,0,0,0,,Барлығы, алданбаңдар!
Dialogue: 0,0:18:39.28,0:18:42.41,Default,,0,0,0,,Ол Джинро-сама емес! Бұл адам!
Dialogue: 0,0:18:43.28,0:18:44.12,Default,,0,0,0,,Борис?
Dialogue: 0,0:18:44.54,0:18:46.75,Default,,0,0,0,,Мен де алданып қалдым
Dialogue: 0,0:18:46.87,0:18:50.79,Default,,0,0,0,,Ол Сильвастаның дәрі-дәрмегімен аңға айналды.
Dialogue: 0,0:18:50.92,0:18:54.34,Default,,0,0,0,,Ал сен Джинро-сама болып, бізді алдадың!
Dialogue: 0,0:18:54.92,0:18:57.34,Default,,0,0,0,,Адамдар қасиетті Күміс Қасқырға өтірік айтты!
Dialogue: 0,0:18:57.34,0:18:59.26,Default,,0,0,0,,Адамдар қасиетті Күміс Қасқырға өтірік айтты!
Dialogue: 0,0:18:57.34,0:18:59.26,Default,,0,0,0,,Соңында соққы алмасқан адамның сен болғаныңа қуаныштымын
Dialogue: 0,0:19:00.38,0:19:03.14,Default,,0,0,0,,Адам? (Жыртқыш) Джинро-сама – адам...
Dialogue: 0,0:19:03.26,0:19:05.26,Default,,0,0,0,,Әйтеуір... (Айуан адам) Мені алдадың ба?
Dialogue: 0,0:19:05.89,0:19:09.39,Default,,0,0,0,,Асыл хайуандарды алдауға тырыстық.
Dialogue: 0,0:19:09.52,0:19:13.23,Default,,0,0,0,,Біз алданып қалдық! Никкуки адамы бол!
Dialogue: 0,0:19:13.36,0:19:15.73,Default,,0,0,0,,Осындай нәрсеге рұқсат етілген бе?
Dialogue: 0,0:19:16.94,0:19:20.15,Default,,0,0,0,,(Көрермендердің айқайы)
Dialogue: 0,0:19:20.61,0:19:22.11,Default,,0,0,0,,Бұл адамның жұмысы!
Dialogue: 0,0:19:22.24,0:19:24.87,Default,,0,0,0,,Адамдар аңдарды қарумен жоюға ниетті!
Dialogue: 0,0:19:25.33,0:19:27.83,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:19:27.95,0:19:29.54,Default,,0,0,0,,(Айуан адамның ырылдауы)
Dialogue: 0,0:19:29.66,0:19:32.75,Default,,0,0,0,,Ах... (Аңдар ырылдады)
Dialogue: 0,0:19:32.88,0:19:34.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:37.71,0:19:40.72,Default,,0,0,0,,(Айуан адамның ырылдауы)
Dialogue: 0,0:19:42.76,0:19:44.51,Default,,0,0,0,,(Айуанның ыңырсыуы)
Dialogue: 0,0:19:45.60,0:19:47.97,Default,,0,0,0,,(Ауандардың ырылдауы)
Dialogue: 0,0:19:48.81,0:19:50.64,Default,,0,0,0,,Хмф!
Dialogue: 0,0:19:52.52,0:19:54.10,Default,,0,0,0,,А... А-а!
Dialogue: 0,0:19:54.98,0:19:57.57,Default,,0,0,0,,(Айуан адамның ырылдауы)
Dialogue: 0,0:19:58.07,0:19:59.40,Default,,0,0,0,,Ха... аа
Dialogue: 0,0:20:01.36,0:20:03.28,Default,,0,0,0,,Уф... уф... уау
Dialogue: 0,0:20:03.41,0:20:04.57,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:05.16,0:20:06.70,Default,,0,0,0,,Назуна!
Dialogue: 0,0:20:08.79,0:20:09.62,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:09.95,0:20:11.54,Default,,0,0,0,,Ой... Уау!
Dialogue: 0,0:20:11.66,0:20:13.50,Default,,0,0,0,,Ааааааааааааааааааааа!
Dialogue: 0,0:20:13.62,0:20:16.00,Default,,0,0,0,,(Айуандардың ырылдауы)
Dialogue: 0,0:20:16.46,0:20:17.71,Default,,0,0,0,,Иә
Dialogue: 0,0:20:18.84,0:20:20.21,Default,,0,0,0,,Жоспарланғандай
Dialogue: 0,0:20:24.47,0:20:26.85,Default,,0,0,0,,Шіркін, соңы жоқ... Иә?
Dialogue: 0,0:20:27.51,0:20:29.18,Default,,0,0,0,,Уф... (Широу) Иә!
Dialogue: 0,0:20:29.56,0:20:30.81,Default,,0,0,0,,Оками!
Dialogue: 0,0:20:31.89,0:20:32.77,Default,,0,0,0,,Хмм!
Dialogue: 0,0:20:33.14,0:20:35.15,Default,,0,0,0,,Ух... у... Уау!
Dialogue: 0,0:20:35.56,0:20:36.65,Default,,0,0,0,,А... иә?
Dialogue: 0,0:20:39.98,0:20:40.82,Default,,0,0,0,,Га
Dialogue: 0,0:20:40.94,0:20:44.57,Default,,0,0,0,,(Айуандардың ырылдауы)
Dialogue: 0,0:20:46.70,0:20:47.78,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:50.79,0:20:52.16,Default,,0,0,0,,Мен тағы да...
Dialogue: 0,0:20:53.75,0:20:55.62,Default,,0,0,0,,Сіз мені құтқара алмайсыз ба?
Dialogue: 0,0:20:56.33,0:20:59.09,Default,,0,0,0,,Аңшылардың қамқоршысы кім?
Dialogue: 0,0:21:02.63,0:21:04.01,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:05.72,0:21:07.84,Default,,0,0,0,,Бірақ мен ештеңе істей алмаймын.
Dialogue: 0,0:21:09.35,0:21:13.81,Default,,0,0,0,,Мен... мен...!
Dialogue: 0,0:21:13.93,0:21:18.94,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:21:19.31,0:21:20.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:20.86,0:21:21.69,Default,,0,0,0,,Ширу мырза?
Dialogue: 0,0:21:21.82,0:21:23.40,Default,,0,0,0,,Қарғыс атсын... Оками...
Dialogue: 0,0:21:23.53,0:21:27.91,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:21:28.57,0:21:29.91,Default,,0,0,0,,Кел, Огами!
Dialogue: 0,0:21:32.66,0:21:33.83,Default,,0,0,0,,(Широудың ыңырануы)
Dialogue: 0,0:21:33.95,0:21:36.58,Default,,0,0,0,,Ширу-сан, жоқ! Уф!
Dialogue: 0,0:21:37.04,0:21:40.04,Default,,0,0,0,,(Широудың ырылдауы)
Dialogue: 0,0:21:40.75,0:21:42.00,Default,,0,0,0,,Ширу...
Dialogue: 0,0:21:46.30,0:21:47.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:48.05,0:21:50.30,Default,,0,0,0,,Мичиру!
Dialogue: 0,0:21:51.47,0:21:56.48,Default,,0,0,0,,♪～
Dialogue: 0,0:22:45.48,0:22:50.49,Default,,0,0,0,,～♪
