Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.71,0:00:03.87,Default,,0,0,0,,Мичиру!
Dialogue: 0,0:00:04.29,0:00:05.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:09.80,0:00:11.92,Default,,0,0,0,,Мичиру! Бұл өтірік...
Dialogue: 0,0:00:14.18,0:00:15.84,Default,,0,0,0,,Оками... Иә?
Dialogue: 0,0:00:26.19,0:00:27.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:28.23,0:00:31.99,Default,,0,0,0,,Эй... Эй, Мичиру
Dialogue: 0,0:00:32.11,0:00:33.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:35.03,0:00:36.32,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:36.91,0:00:41.91,Default,,0,0,0,,Ол Арнайы сыныпқа тең Қарғыс рухына айналуы күтіледі.
Dialogue: 0,0:00:46.42,0:00:47.33,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:00:47.33,0:00:48.92,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:00:47.33,0:00:48.92,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:00:48.92,0:00:49.50,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:00:49.50,0:00:50.84,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:00:49.50,0:00:50.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:50.84,0:00:52.05,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:00:56.34,0:00:59.01,Default,,0,0,0,,Ах... Тағы бір өтініш.
Dialogue: 0,0:00:59.14,0:01:01.14,Default,,0,0,0,,Ширудың айқайы өте қауіпті
Dialogue: 0,0:01:01.26,0:01:02.89,Default,,0,0,0,,Мичиру! Уф
Dialogue: 0,0:01:03.02,0:01:04.60,Default,,0,0,0,,Ой! Аа кешір
Dialogue: 0,0:01:06.02,0:01:08.02,Default,,0,0,0,,А... аа
Dialogue: 0,0:01:09.94,0:01:11.98,Default,,0,0,0,,Жара жақсы ма? Иә
Dialogue: 0,0:01:12.11,0:01:14.44,Default,,0,0,0,,Бірақ егер горилланың қолдары болмаса, бұл қауіпті болар еді.
Dialogue: 0,0:01:14.82,0:01:17.70,Default,,0,0,0,,Кешіріңіз, сіз мені құтқардыңыз.
Dialogue: 0,0:01:17.82,0:01:18.70,Default,,0,0,0,,Мичируға рахмет
Dialogue: 0,0:01:18.82,0:01:20.20,Default,,0,0,0,,Не? Оками-кун!
Dialogue: 0,0:01:20.83,0:01:22.91,Default,,0,0,0,,Әкім! Пинга да
Dialogue: 0,0:01:23.04,0:01:23.91,Default,,0,0,0,,Қалалық әкімдікке!
Dialogue: 0,0:01:25.46,0:01:26.75,Default,,0,0,0,,Жүр!
Dialogue: 0,0:01:33.96,0:01:36.51,Default,,0,0,0,,Уәде етілгендей, Анима қаласы жабылды.
Dialogue: 0,0:01:36.63,0:01:40.05,Default,,0,0,0,,Бұл адамдардың қауіпсіздігіне кепілдік береді, солай ма?
Dialogue: 0,0:01:40.18,0:01:41.81,Default,,0,0,0,,Уайымдамаңыз, премьер-министр.
Dialogue: 0,0:01:42.47,0:01:45.10,Default,,0,0,0,,Жақында айуан адамдар айуан болудан қалады.
Dialogue: 0,0:01:45.23,0:01:49.98,Default,,0,0,0,,Жапония хайуан-адам мәселесін шешуде әлемді басқарады.
Dialogue: 0,0:01:50.73,0:01:54.03,Default,,0,0,0,,Сонымен, Огами-кунда басқалар сияқты белгілер пайда болды...
Dialogue: 0,0:01:54.15,0:01:56.61,Default,,0,0,0,,Ол сізді тістегеннен кейін өзгерді ме?
Dialogue: 0,0:01:56.99,0:01:58.36,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:01:58.49,0:01:59.70,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:01.66,0:02:03.33,Default,,0,0,0,,«бәріміз тартынған оқиға орнына бардық —»
Dialogue: 0,0:02:04.70,0:02:05.54,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:02:06.04,0:02:09.04,Default,,0,0,0,,Бұл мұздатылған Ябаның қан үлгісі.
Dialogue: 0,0:02:09.67,0:02:12.09,Default,,0,0,0,,Бұған Мичирудың қанын беріп көріңіз.
Dialogue: 0,0:02:14.80,0:02:17.76,Default,,0,0,0,,Аң факторы басқа жануарлар факторларын қайта жазуда.
Dialogue: 0,0:02:18.13,0:02:21.05,Default,,0,0,0,,Мен бақылаудан шығып кеткен аң факторын қалпына келтіріп жатырмын.
Dialogue: 0,0:02:21.18,0:02:23.10,Default,,0,0,0,,Басқаша айтқанда, Огами-кун қалыпты жағдайға оралды...
Dialogue: 0,0:02:23.22,0:02:24.93,Default,,0,0,0,,Мичиру-санға рахмет, иә?
Dialogue: 0,0:02:25.06,0:02:27.06,Default,,0,0,0,,Екеуіңнің араларыңдағы жануар факторы-
Dialogue: 0,0:02:27.18,0:02:30.19,Default,,0,0,0,,Өз қалауы бойынша сыртқы түрін өзгерте алатын ерекше зат.
Dialogue: 0,0:02:30.60,0:02:35.36,Default,,0,0,0,,Ол басқа хайуандық факторларға әсер еткенде, ол хайуандардың өзгеруін және ашулануын басатын әсерге ие.
Dialogue: 0,0:02:35.48,0:02:37.53,Default,,0,0,0,,Сарысу жасасаңыз, Нирвазил синдромын аласыз.
Dialogue: 0,0:02:37.65,0:02:39.07,Default,,0,0,0,,Оны емдеуге болады! ?
Dialogue: 0,0:02:39.20,0:02:42.07,Default,,0,0,0,,Жапон үкіметі бізге көмектеспейді.
Dialogue: 0,0:02:42.20,0:02:43.83,Default,,0,0,0,,Бұл сіздің соңғы мүмкіндігіңіз
Dialogue: 0,0:02:44.20,0:02:47.25,Default,,0,0,0,,Медисенге барайық. Ол жерде сарысу жасауға болады.
Dialogue: 0,0:02:47.37,0:02:48.41,Default,,0,0,0,,Асығу керек
Dialogue: 0,0:02:48.54,0:02:50.71,Default,,0,0,0,,Мен бармаймын, иә?
Dialogue: 0,0:02:50.83,0:02:54.13,Default,,0,0,0,,Стресстен аулақ болсаңыз, ауру дамымайды, солай ма?
Dialogue: 0,0:02:54.25,0:02:57.01,Default,,0,0,0,,Қалаға барғың келе ме? тым қауіпті
Dialogue: 0,0:02:57.13,0:03:01.84,Default,,0,0,0,,Күміс қасқырмын деп сенген жұртқа өтірік айттым.
Dialogue: 0,0:03:01.97,0:03:03.89,Default,,0,0,0,,Бұлай жалғаса берсе мен өзімді кешіре алмаймын.
Dialogue: 0,0:03:06.51,0:03:08.39,Default,,0,0,0,,Мен де жас ханымға көмектесемін.
Dialogue: 0,0:03:08.52,0:03:11.14,Default,,0,0,0,,Сарысуды маған қалдырыңыз. Иә.
Dialogue: 0,0:03:11.27,0:03:12.81,Default,,0,0,0,,Мен қаланы қорғаймын
Dialogue: 0,0:03:12.94,0:03:14.52,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:03:15.06,0:03:16.73,Default,,0,0,0,,Иә! Ол аяқталған кезде...
Dialogue: 0,0:03:16.86,0:03:18.82,Default,,0,0,0,,Іске қосайық (Широу) Кеттік.
Dialogue: 0,0:03:28.79,0:03:31.08,Default,,0,0,0,,Мен қан сорайын деп жатырмын. Оны дайындаңыз.
Dialogue: 0,0:03:31.21,0:03:32.92,Default,,0,0,0,,Иә (Широу) Бұл қанша уақытты алады?
Dialogue: 0,0:03:33.25,0:03:34.83,Default,,0,0,0,,Маған 8 сағат беріңіз
Dialogue: 0,0:03:34.96,0:03:38.55,Default,,0,0,0,,Жануар факторын сөндіретін препарат оған дейін таратылса, ол бітеді.
Dialogue: 0,0:03:38.67,0:03:40.09,Default,,0,0,0,,Мен Аланды тоқтатамын.
Dialogue: 0,0:03:40.42,0:03:42.13,Default,,0,0,0,,Бұл жерді жабыңыз және ешкімді кіргізбеңіз.
Dialogue: 0,0:03:42.26,0:03:43.09,Default,,0,0,0,,Ширу-сан!
Dialogue: 0,0:03:44.55,0:03:46.30,Default,,0,0,0,,А, сен қалдың.
Dialogue: 0,0:03:46.43,0:03:48.68,Default,,0,0,0,,Жоқ! Мен күте алмаймын
Dialogue: 0,0:03:48.81,0:03:51.68,Default,,0,0,0,,Түсініңіз. (Широу) Аа...
Dialogue: 0,0:03:53.77,0:03:57.40,Default,,0,0,0,,(Айуандардың ырылдауы)
Dialogue: 0,0:03:58.02,0:03:58.86,Default,,0,0,0,,Ах
Dialogue: 0,0:04:03.36,0:04:04.45,Default,,0,0,0,,Ана мен әке ше?
Dialogue: 0,0:04:07.03,0:04:11.08,Default,,0,0,0,,Жарайды, мен қазір дәрі жасап жатырмын, сонда бәрі жазылады.
Dialogue: 0,0:04:11.20,0:04:13.08,Default,,0,0,0,,Бірден қалыпты жағдайға оралыңыз (Бала) Шынымен бе?
Dialogue: 0,0:04:13.79,0:04:16.88,Default,,0,0,0,,Оған дейін мен музыка тыңдап, сурет салып жүрдім...
Dialogue: 0,0:04:17.00,0:04:21.26,Default,,0,0,0,,Сезімдеріңіз бақылаудан шығып кетпес үшін жүрегіңізді өзіңізге ұнайтын нәрселермен толтырыңыз.
Dialogue: 0,0:04:21.38,0:04:23.55,Default,,0,0,0,,Сіз мұны істей аласыз ба? (Бала) Иә.
Dialogue: 0,0:04:25.13,0:04:28.22,Default,,0,0,0,,Жүр, достарыңмен далаға шығайық.
Dialogue: 0,0:04:28.35,0:04:30.31,Default,,0,0,0,,Мен бұл баланы өзіммен бірге алып кетемін.
Dialogue: 0,0:04:30.43,0:04:31.39,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:34.35,0:04:35.52,Default,,0,0,0,,Құрметті Де Лув
Dialogue: 0,0:04:36.77,0:04:38.11,Default,,0,0,0,,Борис…
Dialogue: 0,0:04:38.56,0:04:41.99,Default,,0,0,0,,Мені кешіріңіз. Барлығы Аланның бұйрығы.
Dialogue: 0,0:04:42.11,0:04:45.82,Default,,0,0,0,,Біз хайуандар Сильвастаға қарсы шыға алмаймыз.
Dialogue: 0,0:04:46.24,0:04:49.28,Default,,0,0,0,,Бірақ біз енді боспыз, бірге барайық.
Dialogue: 0,0:04:49.62,0:04:53.16,Default,,0,0,0,,Сіз баратын жол жоқ. Енді менің өміріме араласпа!
Dialogue: 0,0:04:53.29,0:04:55.75,Default,,0,0,0,,Сен менікісің, Де Лув.
Dialogue: 0,0:04:55.87,0:04:56.79,Default,,0,0,0,,Жібер!
Dialogue: 0,0:04:56.92,0:04:59.00,Default,,0,0,0,,Менімен жүр, Дес Лув!
Dialogue: 0,0:04:59.25,0:05:03.21,Default,,0,0,0,,Мен Дес Лув емеспін, мен Назунамын!
Dialogue: 0,0:05:03.34,0:05:04.26,Default,,0,0,0,,Хебу!
Dialogue: 0,0:05:08.89,0:05:10.26,Default,,0,0,0,,Бұл өте өрескел.
Dialogue: 0,0:05:11.93,0:05:12.97,Default,,0,0,0,,Ах
Dialogue: 0,0:05:14.39,0:05:17.81,Default,,0,0,0,,Де Лувр... неге аааааааааааааааа!
Dialogue: 0,0:05:17.94,0:05:19.06,Default,,0,0,0,,Ай…
Dialogue: 0,0:05:20.40,0:05:22.78,Default,,0,0,0,,Қазірдің өзінде! Мен сенімен араласқым келмейді!
Dialogue: 0,0:05:27.41,0:05:28.45,Default,,0,0,0,,Ах
Dialogue: 0,0:05:29.78,0:05:31.24,Default,,0,0,0,,Енді, өтінемін, сондағы орындыққа отырыңыз.
Dialogue: 0,0:05:31.37,0:05:32.62,Default,,0,0,0,,Жануарлар факторын жоюға арналған препараттармен жабдықталған дрондар
Dialogue: 0,0:05:32.62,0:05:34.08,Default,,0,0,0,,Жануарлар факторын жоюға арналған препараттармен жабдықталған дрондар
Dialogue: 0,0:05:32.62,0:05:34.08,Default,,0,0,0,,Ах
Dialogue: 0,0:05:34.08,0:05:34.87,Default,,0,0,0,,Жануарлар факторын жоюға арналған препараттармен жабдықталған дрондар
Dialogue: 0,0:05:35.00,0:05:36.16,Default,,0,0,0,,Алан!
Dialogue: 0,0:05:36.29,0:05:40.29,Default,,0,0,0,,Бұны бүкіл Анима қаласына таратыңыз және шабуылдаған аңшыларды емдеңіз.
Dialogue: 0,0:05:40.42,0:05:43.67,Default,,0,0,0,,Айуандардың ессіз кетуіне сен себепкер болдың!
Dialogue: 0,0:05:43.80,0:05:45.09,Default,,0,0,0,,Жердегі мақсат не?
Dialogue: 0,0:05:45.34,0:05:47.76,Default,,0,0,0,,Мұның бәрі қажетті процесс.
Dialogue: 0,0:05:47.88,0:05:50.89,Default,,0,0,0,,Нирвазир синдромының сұмдықтары туралы әлемге хабарлау.
Dialogue: 0,0:05:51.01,0:05:53.85,Default,,0,0,0,,Жануарлар факторын жойатын есірткілерді қолданудың заңдылығына шағымдану
Dialogue: 0,0:05:54.39,0:05:56.31,Default,,0,0,0,,Бұл былайша айтқанда демонстрация.
Dialogue: 0,0:05:56.43,0:05:59.81,Default,,0,0,0,,Анима Ситиге осы себепті қауіп төндіңіз бе?
Dialogue: 0,0:05:59.94,0:06:02.15,Default,,0,0,0,,Кешіріңіз! Тынышталыңыз
Dialogue: 0,0:06:02.27,0:06:06.69,Default,,0,0,0,,Жануар факторын жою үшін аннигиляциялық препаратты қолдансаңыз, бәрі шешіледі.
Dialogue: 0,0:06:06.82,0:06:08.03,Default,,0,0,0,,Шешім емес!
Dialogue: 0,0:06:08.15,0:06:10.78,Default,,0,0,0,,Жануар факторын өшірмей сарысумен тоқтатуға болады!
Dialogue: 0,0:06:11.16,0:06:11.99,Default,,0,0,0,,Сарысу?
Dialogue: 0,0:06:12.12,0:06:14.62,Default,,0,0,0,,Назунаның қаны мен менің қанымды дәрі ретінде қолдануға болады.
Dialogue: 0,0:06:14.74,0:06:18.25,Default,,0,0,0,,Егер сарысу жасай алсақ, хайуандарды адам болуға мәжбүрлеудің қажеті жоқ!
Dialogue: 0,0:06:18.37,0:06:21.38,Default,,0,0,0,,Бұл... Мен мұны болжай алмадым.
Dialogue: 0,0:06:21.50,0:06:23.96,Default,,0,0,0,,Менде де ауру пайда болды, бірақ мен жазылдым.
Dialogue: 0,0:06:24.09,0:06:27.22,Default,,0,0,0,,Сондықтан аннигиляциялық дәрі қолданбаңыз!
Dialogue: 0,0:06:27.34,0:06:29.97,Default,,0,0,0,,Түсіндім, әңгімені жақсы түсіндім.
Dialogue: 0,0:06:30.47,0:06:32.68,Default,,0,0,0,,Қалғанын маған қалдырыңыз.
Dialogue: 0,0:06:37.64,0:06:40.06,Default,,0,0,0,,Иә! ? (Широу) Қарғыс атқыр... тоқтат!
Dialogue: 0,0:06:41.35,0:06:44.94,Default,,0,0,0,,Ах~ Ах~ мен енді көмектесе алмаймын.
Dialogue: 0,0:06:50.53,0:06:52.07,Default,,0,0,0,,Ширу-сан!
Dialogue: 0,0:06:53.07,0:06:56.29,Default,,0,0,0,,О, операцияны тоқтатыңыз!
Dialogue: 0,0:06:57.20,0:06:58.70,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,0:06:58.83,0:07:02.04,Default,,0,0,0,,Мен сені сәл ақылдырақ деп ойладым.
Dialogue: 0,0:07:02.29,0:07:05.88,Default,,0,0,0,,Ең жақсысы емес пе? Мен сенген күміс қасқыр шын мәнінде адам...
Dialogue: 0,0:07:06.00,0:07:08.38,Default,,0,0,0,,Осыны естіп, есінен танып, есінен танып қалды.
Dialogue: 0,0:07:08.51,0:07:11.55,Default,,0,0,0,,Өздері адамға айналған аңдар
Dialogue: 0,0:07:12.34,0:07:13.72,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:07:13.85,0:07:17.47,Default,,0,0,0,,Сіз мені тістеңіз бе? Бұл қорқынышты
Dialogue: 0,0:07:26.69,0:07:27.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:32.36,0:07:36.20,Default,,0,0,0,,Тей! те те... те те!
Dialogue: 0,0:07:43.29,0:07:44.46,Default,,0,0,0,,Иә
Dialogue: 0,0:07:45.21,0:07:46.63,Default,,0,0,0,,Ябба! Қарғыс атқыр...
Dialogue: 0,0:07:47.13,0:07:49.88,Default,,0,0,0,,Мені бұдан былай мазаламайсыз деп үміттенемін.
Dialogue: 0,0:07:51.51,0:07:53.13,Default,,0,0,0,,Сіздерге, адамдар...
Dialogue: 0,0:07:53.97,0:07:55.64,Default,,0,0,0,,Жыртқыштарды жою мүмкін емес!
Dialogue: 0,0:07:56.01,0:07:59.22,Default,,0,0,0,,Сіз лас қолдарыңызды жібере аласыз ба?
Dialogue: 0,0:07:59.35,0:08:02.19,Default,,0,0,0,,Уф... не! ?
Dialogue: 0,0:08:03.10,0:08:05.94,Default,,0,0,0,,Дүние туралы шындықты айтайын!
Dialogue: 0,0:08:06.06,0:08:08.07,Default,,0,0,0,,Уф! Гуаа!
Dialogue: 0,0:08:08.19,0:08:09.48,Default,,0,0,0,,Гах...
Dialogue: 0,0:08:10.28,0:08:12.32,Default,,0,0,0,,А... хайуан?
Dialogue: 0,0:08:12.45,0:08:15.24,Default,,0,0,0,,Оның иісі толығымен адамға тән.
Dialogue: 0,0:08:15.36,0:08:19.08,Default,,0,0,0,,Сильваста отбасы адам әлеміне ертеден кіріктірілген.
Dialogue: 0,0:08:19.20,0:08:20.75,Default,,0,0,0,,Билік етті
Dialogue: 0,0:08:20.87,0:08:23.75,Default,,0,0,0,,Жануарлардың болуын жою оңай.
Dialogue: 0,0:08:24.12,0:08:26.71,Default,,0,0,0,,Сіз гибридті аңдар сияқтысыз...
Dialogue: 0,0:08:26.83,0:08:29.75,Default,,0,0,0,,Біз, асыл тұқымдылар нағыз хайуанбыз.
Dialogue: 0,0:08:30.09,0:08:34.09,Default,,0,0,0,,Қараңдаршы, бұл Құдайдың нағыз қасқыры.
Dialogue: 0,0:08:34.22,0:08:38.64,Default,,0,0,0,,(Аланның қабығы)
Dialogue: 0,0:08:38.76,0:08:40.10,Default,,0,0,0,,А... а...
Dialogue: 0,0:08:40.22,0:08:41.60,Default,,0,0,0,,Бастапқыда аңдар...
Dialogue: 0,0:08:41.72,0:08:44.14,Default,,0,0,0,,Елде тамыр жайған хайуандарға құдай деп табын.
Dialogue: 0,0:08:44.27,0:08:46.10,Default,,0,0,0,,Бұл күш оның денесінде болды.
Dialogue: 0,0:08:46.23,0:08:49.07,Default,,0,0,0,,Ешқашан басқа хайуанға ұқсас аңдармен араласпаңыз.
Dialogue: 0,0:08:49.19,0:08:51.57,Default,,0,0,0,,Аң табиғатыңды қорға
Dialogue: 0,0:08:51.69,0:08:53.53,Default,,0,0,0,,Бұл асыл тұқымды.
Dialogue: 0,0:08:53.65,0:08:56.57,Default,,0,0,0,,Көптеген аңдар адамдармен қарым-қатынас жасауды ұнатпайды...
Dialogue: 0,0:08:56.70,0:09:01.45,Default,,0,0,0,,Менің ата-бабам ежелгі жерін тастап, басқа хайуанаттармен балалы болған.
Dialogue: 0,0:09:01.58,0:09:04.66,Default,,0,0,0,,Сіз және осы қалада тұратын аңдар сияқты.
Dialogue: 0,0:09:05.33,0:09:06.42,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:06.54,0:09:08.96,Default,,0,0,0,,Аз ғана мақтаншақ айуан...
Dialogue: 0,0:09:09.09,0:09:13.30,Default,,0,0,0,,Өзге хайуанның қанына жол бермей, намысын қорғады.
Dialogue: 0,0:09:13.42,0:09:17.34,Default,,0,0,0,,Бұл көрініс мақтаншақ асыл тұқымдылықтың дәлелі.
Dialogue: 0,0:09:17.47,0:09:20.81,Default,,0,0,0,,Сіз сияқты гибрид өзіңізді қамқоршы деп атайды...
Dialogue: 0,0:09:20.93,0:09:23.81,Default,,0,0,0,,Надандық деген... қорқынышты!
Dialogue: 0,0:09:25.14,0:09:28.02,Default,,0,0,0,,Неғұрлым мойын болсаң, сонша сөйлейсің!
Dialogue: 0,0:09:28.15,0:09:29.52,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:30.23,0:09:31.44,Default,,0,0,0,,Ох… Хахаха
Dialogue: 0,0:09:31.57,0:09:33.19,Default,,0,0,0,,Сен де өлмейтінсің бе?
Dialogue: 0,0:09:33.32,0:09:35.53,Default,,0,0,0,,Өлмейтіндік - Сильвастаның артықшылығы
Dialogue: 0,0:09:35.65,0:09:38.86,Default,,0,0,0,,Таңдалғандар ғана жасай алатын өлместік рәсімі.
Dialogue: 0,0:09:38.99,0:09:43.04,Default,,0,0,0,,1000 қасқырдың қанын жинап, денелеріне құйыңыз.
Dialogue: 0,0:09:43.16,0:09:45.62,Default,,0,0,0,,Осылайша сіз бұл күшті аласыз
Dialogue: 0,0:09:45.75,0:09:48.67,Default,,0,0,0,,Дәл осындай құбылыс сіздің басыңыздан да өткен сияқты.
Dialogue: 0,0:09:48.79,0:09:51.50,Default,,0,0,0,,Бірақ ол будандардың қанын жинау арқылы жасалған.
Dialogue: 0,0:09:51.63,0:09:53.05,Default,,0,0,0,,Жалған
Dialogue: 0,0:09:53.17,0:09:54.67,Default,,0,0,0,,Бұл жалған! ?
Dialogue: 0,0:09:54.80,0:09:57.34,Default,,0,0,0,,Гибридті аңдар айуан емес.
Dialogue: 0,0:09:57.47,0:09:59.68,Default,,0,0,0,,Нирвазил синдромы сияқты аурулар...
Dialogue: 0,0:09:59.80,0:10:01.55,Default,,0,0,0,,Тек гибридті болса
Dialogue: 0,0:10:01.89,0:10:03.60,Default,,0,0,0,,Әртүрлі жануарлар факторларының қоспасы...
Dialogue: 0,0:10:03.72,0:10:06.43,Default,,0,0,0,,Стресс сізді бақылаудан шығаруы мүмкін.
Dialogue: 0,0:10:06.56,0:10:08.89,Default,,0,0,0,,Біз асыл тұқымдылар қабылдамаймыз.
Dialogue: 0,0:10:09.02,0:10:13.61,Default,,0,0,0,,Ал, әдеттегідей, біз таза қандылар әлемді билейтін боламыз.
Dialogue: 0,0:10:13.73,0:10:16.40,Default,,0,0,0,,Адамдарды қараңғылықтан манипуляциялау
Dialogue: 0,0:10:16.53,0:10:18.65,Default,,0,0,0,,Бұл дүниенің шындығы!
Dialogue: 0,0:10:19.49,0:10:22.62,Default,,0,0,0,,(Аландар айқайы)
Dialogue: 0,0:10:23.33,0:10:25.16,Default,,0,0,0,,Ха! Апыр-ай!
Dialogue: 0,0:10:30.50,0:10:32.08,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:33.00,0:10:35.71,Default,,0,0,0,,Бұл менің жолыма түскенің үшін сыйлығың.
Dialogue: 0,0:10:41.89,0:10:44.26,Default,,0,0,0,,Ах (аңдардың ырылдауы)
Dialogue: 0,0:10:45.18,0:10:46.47,Default,,0,0,0,,А, жоқ!
Dialogue: 0,0:10:51.85,0:10:53.48,Default,,0,0,0,,Уваах! Көзім…
Dialogue: 0,0:10:54.61,0:10:55.86,Default,,0,0,0,,Я...
Dialogue: 0,0:10:55.98,0:10:58.49,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:58.61,0:11:00.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:01.28,0:11:03.41,Default,,0,0,0,,Ай…
Dialogue: 0,0:11:03.41,0:11:04.08,Default,,0,0,0,,Ай…
Dialogue: 0,0:11:03.41,0:11:04.08,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:11:04.08,0:11:04.20,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:11:04.20,0:11:05.33,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:11:04.20,0:11:05.33,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:05.33,0:11:06.99,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:11:06.99,0:11:08.20,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:11:06.99,0:11:08.20,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:11:08.20,0:11:08.87,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:11:10.67,0:11:13.75,Default,,0,0,0,,(Назунаның ауыр тыныс алуы)
Dialogue: 0,0:11:13.88,0:11:15.50,Default,,0,0,0,,Шынымен табанды!
Dialogue: 0,0:11:17.76,0:11:20.01,Default,,0,0,0,,Уф... уф... Де Лув
Dialogue: 0,0:11:21.38,0:11:22.55,Default,,0,0,0,,Ах
Dialogue: 0,0:11:23.59,0:11:25.93,Default,,0,0,0,,Саған көмектессем, пайдасы тиетін шығар.
Dialogue: 0,0:11:26.06,0:11:29.35,Default,,0,0,0,,Мен саған жақсылық жасаймын...
Dialogue: 0,0:11:29.48,0:11:30.77,Default,,0,0,0,,Монгус? (Мари) Минк!
Dialogue: 0,0:11:30.89,0:11:32.02,Default,,0,0,0,,Мари күзен!
Dialogue: 0,0:11:32.14,0:11:34.02,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:36.32,0:11:37.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:37.02,0:11:37.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:37.02,0:11:37.48,Default,,0,0,0,,Жақсы кемонобито соусы~
Dialogue: 0,0:11:37.48,0:11:40.90,Default,,0,0,0,,Жақсы кемонобито соусы~
Dialogue: 0,0:11:41.03,0:11:42.61,Default,,0,0,0,,Джинро-сама~
Dialogue: 0,0:11:42.74,0:11:44.32,Default,,0,0,0,,Ах... (Джеки) Міне, міне.
Dialogue: 0,0:11:44.45,0:11:45.83,Default,,0,0,0,,Уау, ақша! (Джеки) Ахаха
Dialogue: 0,0:11:45.95,0:11:47.95,Default,,0,0,0,,Ехо, мен Джинро емеспін.
Dialogue: 0,0:11:48.08,0:11:50.50,Default,,0,0,0,,Гуру-сама, сіз маған керемет нан құлақтарын бердіңіз!
Dialogue: 0,0:11:50.62,0:11:51.62,Default,,0,0,0,,Біздің көзқарасымыз бойынша...
Dialogue: 0,0:11:51.75,0:11:55.54,Default,,0,0,0,,Ашыққанда ас берген адам – Құдай.
Dialogue: 0,0:11:55.67,0:11:56.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:57.00,0:11:59.00,Default,,0,0,0,,Мен қауіпті жерге жүгірдім!
Dialogue: 0,0:11:59.13,0:12:00.13,Default,,0,0,0,,Осы жолмен!
Dialogue: 0,0:12:00.26,0:12:02.38,Default,,0,0,0,,Уау! Қоршалған!
Dialogue: 0,0:12:02.72,0:12:05.80,Default,,0,0,0,,Мен біреуге көмектескім келді, осылай болды!
Dialogue: 0,0:12:05.93,0:12:08.47,Default,,0,0,0,,(Джекидің қорқынышты дауысы)
Dialogue: 0,0:12:08.60,0:12:09.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:11.43,0:12:13.31,Default,,0,0,0,,Тұр, Качан (Бакуго), маған ерме!
Dialogue: 0,0:12:14.06,0:12:15.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:16.61,0:12:18.69,Default,,0,0,0,,Амансың ба? Пинга мырза!
Dialogue: 0,0:12:18.82,0:12:22.19,Default,,0,0,0,,Тоқта! Оның құрамында хайуандарды адамға айналдыратын дәрі бар.
Dialogue: 0,0:12:22.32,0:12:23.95,Default,,0,0,0,,Не! ? Ах
Dialogue: 0,0:12:24.07,0:12:26.74,Default,,0,0,0,,Назуна!
Dialogue: 0,0:12:26.87,0:12:28.91,Default,,0,0,0,,Пинга мырза, мына жақтағы дронды жіберіңізші.
Dialogue: 0,0:12:29.03,0:12:30.04,Default,,0,0,0,,Оны маған қалдыр!
Dialogue: 0,0:12:35.29,0:12:36.50,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:37.50,0:12:40.34,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:12:40.34,0:12:41.46,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:12:40.34,0:12:41.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:42.30,0:12:44.09,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:12:44.22,0:12:45.05,Default,,0,0,0,,Мичиру! ?
Dialogue: 0,0:12:46.59,0:12:48.30,Default,,0,0,0,,Мичиру! Назуна
Dialogue: 0,0:12:48.43,0:12:50.06,Default,,0,0,0,,Тей!
Dialogue: 0,0:12:51.68,0:12:54.06,Default,,0,0,0,,(Джекидің айқайы)
Dialogue: 0,0:12:54.69,0:12:56.77,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:12:57.23,0:13:01.90,Default,,0,0,0,,Білмеймін, айқайлаған дауысты естігенде, мен хайуандық түйсігіммен әрекет ететін сияқтымын.
Dialogue: 0,0:13:02.03,0:13:03.15,Default,,0,0,0,,Ах
Dialogue: 0,0:13:05.24,0:13:07.62,Default,,0,0,0,,(Ауандардың айқайы)
Dialogue: 0,0:13:07.95,0:13:11.45,Default,,0,0,0,,Ол тек хайуандарды ашуға мүдделі сияқты.
Dialogue: 0,0:13:11.58,0:13:13.20,Default,,0,0,0,,Анима Ситиде бұл айқай...
Dialogue: 0,0:13:13.33,0:13:15.92,Default,,0,0,0,,Оны жеткізудің жолы болса екен.
Dialogue: 0,0:13:17.37,0:13:19.46,Default,,0,0,0,,О, тікелей эфир!
Dialogue: 0,0:13:19.79,0:13:21.25,Default,,0,0,0,,Жарайсың ба? Джеки және басқалар -
Dialogue: 0,0:13:21.38,0:13:23.51,Default,,0,0,0,,Қалада мүмкіндігінше көп теледидарды қосыңыз.
Dialogue: 0,0:13:23.63,0:13:27.47,Default,,0,0,0,,Мен, Назуна және Мари тікелей эфирге барып, бейнені ойнатамыз.
Dialogue: 0,0:13:31.97,0:13:33.81,Default,,0,0,0,,Сендер тітіркендіргіш өрмекші балалар.
Dialogue: 0,0:13:34.18,0:13:36.35,Default,,0,0,0,,Мына нәрсені қайда жасырдың! ?
Dialogue: 0,0:13:36.48,0:13:38.77,Default,,0,0,0,,Бұл атыс қаруы мен қылыш туралы заңның бұзылуы!
Dialogue: 0,0:13:38.90,0:13:41.65,Default,,0,0,0,,Иә? Қарсылас ұшақтарының шабуылы! Қарсылас ұшақтарының шабуылы!
Dialogue: 0,0:13:41.77,0:13:44.32,Default,,0,0,0,,Жау шапса, адам боласың!
Dialogue: 0,0:13:45.32,0:13:46.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:46.86,0:13:49.49,Default,,0,0,0,,Өрмекшілерден кейін аралар тұр ма?
Dialogue: 0,0:13:50.16,0:13:51.83,Default,,0,0,0,,Бұзғаныңыз үшін риза болыңыз!
Dialogue: 0,0:13:52.33,0:13:55.00,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:13:57.08,0:13:58.42,Default,,0,0,0,,Саса
Dialogue: 0,0:13:58.54,0:13:59.46,Default,,0,0,0,,30 минут ішінде бұл 50/50 мүмкіндік, иә?
Dialogue: 0,0:13:59.58,0:14:01.96,Default,,0,0,0,,Жақсы кемонобито соусы~
Dialogue: 0,0:14:06.30,0:14:07.59,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:08.43,0:14:10.09,Default,,0,0,0,,А, солай.
Dialogue: 0,0:14:10.47,0:14:11.85,Default,,0,0,0,,Мари, асығыңыз.
Dialogue: 0,0:14:11.97,0:14:13.81,Default,,0,0,0,,Күте тұрыңыз, бұл оңай емес.
Dialogue: 0,0:14:13.93,0:14:15.22,Default,,0,0,0,,Ах
Dialogue: 0,0:14:18.19,0:14:20.48,Default,,0,0,0,,Пайдасыз істермен айналысуды доғар
Dialogue: 0,0:14:20.60,0:14:21.69,Default,,0,0,0,,Алан…
Dialogue: 0,0:14:21.81,0:14:24.44,Default,,0,0,0,,Мен не жоспарлап жатқаныңызды білмеймін, бірақ...
Dialogue: 0,0:14:24.57,0:14:25.94,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:14:26.32,0:14:28.24,Default,,0,0,0,,Анима қаласы аяқталды.
Dialogue: 0,0:14:28.36,0:14:31.37,Default,,0,0,0,,Сарысу пайда болғанға дейін аңдар бір-бірін өлтірді.
Dialogue: 0,0:14:31.49,0:14:37.04,Default,,0,0,0,,Қала қирап, артта қалғандардың бәрі хайуандық факторды жоюға арналған дәрімен адамға айналады.
Dialogue: 0,0:14:37.16,0:14:38.54,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:41.33,0:14:45.21,Default,,0,0,0,,Қыздың қолы мұндай әдемі емес.
Dialogue: 0,0:14:45.34,0:14:48.22,Default,,0,0,0,,Сіз адамсыз, тез адам болып қайта оралыңыз...
Dialogue: 0,0:14:48.34,0:14:50.43,Default,,0,0,0,,Қалыпты өмір сүрген дұрыс емес пе?
Dialogue: 0,0:14:50.55,0:14:54.01,Default,,0,0,0,,Қыздар, хайуандар, адамдар, т.б.
Dialogue: 0,0:14:54.14,0:14:57.10,Default,,0,0,0,,Бұл шынымен де маңызды емес!
Dialogue: 0,0:14:57.60,0:15:00.02,Default,,0,0,0,,Ненің қалыпты екенін өзіңіз шешесіз...
Dialogue: 0,0:15:00.14,0:15:03.81,Default,,0,0,0,,Қалай өмір сүру керектігін және ненің әдемі екенін өзіңіз шешіңіз!
Dialogue: 0,0:15:04.19,0:15:08.28,Default,,0,0,0,,Адам болғысы келетін хайуандар болса, адам болу керек.
Dialogue: 0,0:15:08.40,0:15:11.78,Default,,0,0,0,,Бірақ таңдау құқығын алып тастау әдісіңіз...
Dialogue: 0,0:15:12.11,0:15:14.24,Default,,0,0,0,,Шынымен! Ең жақсы!
Dialogue: 0,0:15:14.74,0:15:15.95,Default,,0,0,0,,Өйткені бұл өрескел!
Dialogue: 0,0:15:17.91,0:15:19.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:19.66,0:15:21.12,Default,,0,0,0,,Бұл ұят
Dialogue: 0,0:15:21.62,0:15:25.59,Default,,0,0,0,,Қош бол, шіркін шіркін!
Dialogue: 0,0:15:28.88,0:15:29.84,Default,,0,0,0,,Уау
Dialogue: 0,0:15:32.34,0:15:34.60,Default,,0,0,0,,Уф... Широ-сан! ?
Dialogue: 0,0:15:36.47,0:15:38.10,Default,,0,0,0,,Мен оның тірі екенін білмедім.
Dialogue: 0,0:15:39.14,0:15:44.06,Default,,0,0,0,,Менің ішімде тұратын адамдар әлі құлама деп айтып жатыр.
Dialogue: 0,0:15:44.19,0:15:47.23,Default,,0,0,0,,Сені жалмауыз деп келеке еткендер!
Dialogue: 0,0:15:47.82,0:15:51.74,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:15:52.99,0:15:57.70,Default,,0,0,0,,Ха! Ааааааааа!
Dialogue: 0,0:15:57.83,0:16:01.21,Default,,0,0,0,,Алан... ол хайуан ба еді?
Dialogue: 0,0:16:03.83,0:16:04.92,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:05.71,0:16:06.67,Default,,0,0,0,,Уау
Dialogue: 0,0:16:07.09,0:16:09.17,Default,,0,0,0,,Хе... Хе!
Dialogue: 0,0:16:11.26,0:16:13.43,Default,,0,0,0,,Уақыт ұтып алғыңыз келе ме?
Dialogue: 0,0:16:13.97,0:16:15.39,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:16:15.51,0:16:18.89,Default,,0,0,0,,Сол техниканы меңгергенше!
Dialogue: 0,0:16:20.47,0:16:21.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:22.27,0:16:27.31,Default,,0,0,0,,Таза емес саған, Тәңірдің зары...
Dialogue: 0,0:16:28.32,0:16:30.57,Default,,0,0,0,,Мүмкін болуы керек...
Dialogue: 0,0:16:31.15,0:16:32.99,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:16:33.11,0:16:35.24,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:16:36.37,0:16:37.70,Default,,0,0,0,,Ах
Dialogue: 0,0:16:39.20,0:16:45.00,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:16:50.09,0:16:51.05,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:16:51.38,0:16:52.51,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:16:53.67,0:16:56.47,Default,,0,0,0,,1000 жыл өмір сүрудің қажеті жоқ!
Dialogue: 0,0:16:56.84,0:16:59.68,Default,,0,0,0,,Бұл... ақымақ!
Dialogue: 0,0:17:04.14,0:17:05.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:10.61,0:17:11.98,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:17:12.36,0:17:15.20,Default,,0,0,0,,Бұл Құдайдың айқайы немесе басқа нәрсе емес.
Dialogue: 0,0:17:15.32,0:17:17.53,Default,,0,0,0,,Бұл қарсыласты өлтіру әдісі.
Dialogue: 0,0:17:17.66,0:17:20.03,Default,,0,0,0,,Мен жасап көрейін бе? тағы бір рет!
Dialogue: 0,0:17:20.16,0:17:21.95,Default,,0,0,0,,Тоқта... Тоқта.
Dialogue: 0,0:17:22.33,0:17:24.37,Default,,0,0,0,,Тоқта, тоқта... а
Dialogue: 0,0:17:24.50,0:17:26.62,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:17:27.12,0:17:28.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:29.21,0:17:31.55,Default,,0,0,0,,Нирвазир синдромы! ?
Dialogue: 0,0:17:31.88,0:17:35.09,Default,,0,0,0,,Не? Мен! ? Мүмкін емес!
Dialogue: 0,0:17:35.22,0:17:40.30,Default,,0,0,0,,Кеш болды, Алан, «таза тұқымдыларға әсер етпейді» дегеніңіз не?
Dialogue: 0,0:17:40.43,0:17:42.01,Default,,0,0,0,,Себепті жоғалтпастан бұрын-
Dialogue: 0,0:17:42.14,0:17:44.22,Default,,0,0,0,,Мен соңғы соққыны беремін! Тоқта!
Dialogue: 0,0:17:44.35,0:17:46.77,Default,,0,0,0,,А... көмектесіңізші! сұраңыз!
Dialogue: 0,0:17:49.02,0:17:49.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:52.36,0:17:56.82,Default,,0,0,0,,(Аланның ырылдауы)
Dialogue: 0,0:17:57.70,0:17:59.28,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:17:59.53,0:18:01.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:03.24,0:18:04.75,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:18:05.50,0:18:09.25,Default,,0,0,0,,Оның қанынан менде антиденелер бар.
Dialogue: 0,0:18:09.37,0:18:14.38,Default,,0,0,0,,(Аланның ыңырануы)
Dialogue: 0,0:18:20.22,0:18:22.85,Default,,0,0,0,,Неге... көмектестің?
Dialogue: 0,0:18:23.47,0:18:26.02,Default,,0,0,0,,Мен енді өкінгім келмейді
Dialogue: 0,0:18:27.98,0:18:29.19,Default,,0,0,0,,Иә
Dialogue: 0,0:18:30.31,0:18:32.27,Default,,0,0,0,,Хе, иә.
Dialogue: 0,0:18:32.69,0:18:35.78,Default,,0,0,0,,Мичиру! Дайын, жарайды, бұрынғы бейнені шығарыңыз.
Dialogue: 0,0:18:36.61,0:18:37.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:38.61,0:18:40.70,Default,,0,0,0,,Батарея біткен! ?
Dialogue: 0,0:18:41.03,0:18:43.91,Default,,0,0,0,,Шынымен! ? Мен оны зарядтауым керек. Мен оны зарядтауым керек. Мен оны зарядтауым керек.
Dialogue: 0,0:18:44.03,0:18:44.91,Default,,0,0,0,,Ах
Dialogue: 0,0:18:45.83,0:18:47.12,Default,,0,0,0,,Ширу-сан!
Dialogue: 0,0:18:47.41,0:18:48.96,Default,,0,0,0,,Айқайлаңыз
Dialogue: 0,0:18:49.08,0:18:52.88,Default,,0,0,0,,Анима қаласын тек Джинро қорғай алады!
Dialogue: 0,0:18:53.00,0:18:54.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:55.25,0:19:00.01,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,0:19:00.13,0:19:01.97,Default,,0,0,0,,Нағыз керемет
Dialogue: 0,0:19:02.09,0:19:03.68,Default,,0,0,0,,(Маридің айқайы)
Dialogue: 0,0:19:03.80,0:19:07.89,Default,,0,0,0,,(Ауандардың айқайы)
Dialogue: 0,0:19:21.03,0:19:23.28,Default,,0,0,0,,Осы сәтте мен түсіндім
Dialogue: 0,0:19:23.41,0:19:25.66,Default,,0,0,0,,Мен және Назуна олардан бөлек.
Dialogue: 0,0:19:26.33,0:19:27.79,Default,,0,0,0,,Бірақ Ширу-сан...
Dialogue: 0,0:19:27.91,0:19:30.62,Default,,0,0,0,,Мен өзімді мұңсыз және дәрменсіз сезінемін...
Dialogue: 0,0:19:31.29,0:19:35.21,Default,,0,0,0,,Сонда да мен біреуге деген қамқорлық сезімін сезінемін...
Dialogue: 0,0:19:43.89,0:19:45.72,Default,,0,0,0,,Бақылаудан шығып кеткен аңдар――
Dialogue: 0,0:19:45.85,0:19:49.02,Default,,0,0,0,,Біраз уақыт қажет болды, бірақ ол бастапқы түріне оралды.
Dialogue: 0,0:19:49.35,0:19:54.02,Default,,0,0,0,,Anima City жаңа символы NAZUNA бромиді 5 данамен шектелген!
Dialogue: 0,0:19:55.02,0:19:56.40,Default,,0,0,0,,Бұл қауіпсіздік камерасына түсіп қалған.
Dialogue: 0,0:19:56.52,0:19:58.86,Default,,0,0,0,,Менің баланы құтқарған видео желіде тарады...
Dialogue: 0,0:19:58.98,0:20:01.78,Default,,0,0,0,,Назуна аңдармен де, адамдармен де танымал болды.
Dialogue: 0,0:20:02.61,0:20:05.45,Default,,0,0,0,,Назуна: «Мен камера бар екенін білмедім», - дейді.
Dialogue: 0,0:20:05.57,0:20:07.95,Default,,0,0,0,,Мен міндетті түрде білдім деп ойлаймын.
Dialogue: 0,0:20:08.08,0:20:11.79,Default,,0,0,0,,Назуна Мұндай нәрсе өте керемет.
Dialogue: 0,0:20:13.67,0:20:16.13,Default,,0,0,0,,Мен Анима қаласының автономиясын қорғадым.
Dialogue: 0,0:20:16.54,0:20:18.88,Default,,0,0,0,,Сильваста қорымен сөз байласуға қатысты...
Dialogue: 0,0:20:19.00,0:20:22.51,Default,,0,0,0,,Премьер-министрді сілкіп тастадым, ол құлықсыз мойындады.
Dialogue: 0,0:20:23.09,0:20:26.39,Default,,0,0,0,,Алан сонымен қатар Silvasta Pharmaceuticals төрағасы қызметінен кетеді
Dialogue: 0,0:20:26.51,0:20:29.72,Default,,0,0,0,,Ол біраз уақытқа көпшіліктің көзінен ғайып болуы мүмкін.
Dialogue: 0,0:20:30.97,0:20:32.77,Default,,0,0,0,,Бұл қаланы өзгертіңіз
Dialogue: 0,0:20:32.89,0:20:36.40,Default,,0,0,0,,Адамдарға біздің кім екенімізді түсінуге көмектесу.
Dialogue: 0,0:20:36.52,0:20:38.77,Default,,0,0,0,,Осы қалаға адамдарды да шақыр.
Dialogue: 0,0:20:38.90,0:20:42.36,Default,,0,0,0,,Ал аңдар адамдар туралы да білсін.
Dialogue: 0,0:20:42.74,0:20:44.57,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:20:44.70,0:20:46.62,Default,,0,0,0,,Бұл қиын болуы керек.
Dialogue: 0,0:20:46.99,0:20:49.03,Default,,0,0,0,,Бірақ мұны шыдамдылықпен жасаңыз
Dialogue: 0,0:20:49.16,0:20:51.58,Default,,0,0,0,,Бақытымызға орай, менің уақытым бар.
Dialogue: 0,0:20:52.20,0:20:53.71,Default,,0,0,0,,Бір-біріңе.
Dialogue: 0,0:20:56.25,0:20:57.54,Default,,0,0,0,,Ах
Dialogue: 0,0:20:59.04,0:21:00.13,Default,,0,0,0,,Широ-сан
Dialogue: 0,0:21:01.51,0:21:03.09,Default,,0,0,0,,Қазір иығың жақсы ма?
Dialogue: 0,0:21:03.47,0:21:04.47,Default,,0,0,0,,Иә
Dialogue: 0,0:21:05.55,0:21:06.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:11.01,0:21:12.39,Default,,0,0,0,,Дәл осылай!
Dialogue: 0,0:21:12.72,0:21:14.85,Default,,0,0,0,,Бәрі үшін кешірім сұраймын.
Dialogue: 0,0:21:14.98,0:21:16.85,Default,,0,0,0,,Бұл Ширудың кінәсі емес.
Dialogue: 0,0:21:17.31,0:21:20.15,Default,,0,0,0,,Менің естуімше, олар жануарлар мен адам ауруларына да дәрі жасай алады.
Dialogue: 0,0:21:20.48,0:21:22.57,Default,,0,0,0,,Жақсы, мен үйге бара аламын.
Dialogue: 0,0:21:24.90,0:21:28.82,Default,,0,0,0,,Менде бәрі жақсы, әзірше осында қаламын.
Dialogue: 0,0:21:30.91,0:21:32.79,Default,,0,0,0,,Адамдар мен аңдар арасындағы тәжірибе қандай?
Dialogue: 0,0:21:32.91,0:21:35.08,Default,,0,0,0,,Тек мен және Назуна
Dialogue: 0,0:21:35.21,0:21:38.92,Default,,0,0,0,,Менің ойымша, бұл менің қазір кім болғаныма байланысты.
Dialogue: 0,0:21:40.09,0:21:44.34,Default,,0,0,0,,Ал мен қазір өзімді жақсы көремін.
Dialogue: 0,0:21:47.22,0:21:49.30,Default,,0,0,0,,Сен бұл қалада не істеп жүрсің?
Dialogue: 0,0:21:49.43,0:21:51.68,Default,,0,0,0,,Мен әлі шешкен жоқпын...
Dialogue: 0,0:21:51.81,0:21:54.06,Default,,0,0,0,,Мен өзім ғана істей алатын нәрсені іздеймін.
Dialogue: 0,0:21:54.18,0:21:56.56,Default,,0,0,0,,Баскетбол ойнап, Назунаға көмектесу
Dialogue: 0,0:21:56.94,0:21:59.52,Default,,0,0,0,,Әрине, Ширу-санның да көмегі.
Dialogue: 0,0:21:59.65,0:22:02.02,Default,,0,0,0,,Ааа, сұрағаным есімде жоқ.
Dialogue: 0,0:22:03.90,0:22:05.03,Default,,0,0,0,,Хехехе
Dialogue: 0,0:22:05.15,0:22:08.32,Default,,0,0,0,,Эй, мен бұл қалаға алғаш келген түні...
Dialogue: 0,0:22:08.45,0:22:10.66,Default,,0,0,0,,Мен Джинроны (Широу) көрдім, иә?
Dialogue: 0,0:22:11.07,0:22:12.24,Default,,0,0,0,,Сол фестиваль-
Dialogue: 0,0:22:12.37,0:22:15.33,Default,,0,0,0,,Ширу-сан, сен шынымен бақытты болдың.
Dialogue: 0,0:22:15.45,0:22:18.17,Default,,0,0,0,,Сондықтан мен күміс бөрі кейіпте тойлағым келді.
Dialogue: 0,0:22:18.58,0:22:20.67,Default,,0,0,0,,Бірақ қазірден бастап, қашан қаласаңыз...
Dialogue: 0,0:22:20.79,0:22:22.92,Default,,0,0,0,,Өзіңе ұнайтын нәрсенің болуы дұрыс емес пе?
Dialogue: 0,0:22:23.38,0:22:24.88,Default,,0,0,0,,Мичиру! иә?
Dialogue: 0,0:22:25.01,0:22:26.63,Default,,0,0,0,,Шайға барайық
Dialogue: 0,0:22:27.05,0:22:28.51,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:22:28.63,0:22:30.34,Default,,0,0,0,,Мен сонда барамын.
Dialogue: 0,0:22:31.22,0:22:32.39,Default,,0,0,0,,Әй!
Dialogue: 0,0:22:37.10,0:22:38.64,Default,,0,0,0,,Мүмкін ол өзгеруі мүмкін
Dialogue: 0,0:22:42.69,0:22:44.19,Default,,0,0,0,,Бұл қала да
Dialogue: 0,0:22:45.69,0:22:51.69,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory