Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:00:55.88,0:01:00.89,Default,,0,0,0,,～♪
Dialogue: 0,0:01:13.57,0:01:17.49,Default,,0,0,0,,(жүгіру)
Dialogue: 0,0:01:25.46,0:01:27.54,Default,,0,0,0,,Га
Dialogue: 0,0:01:44.64,0:01:47.31,Default,,0,0,0,,Хэ (аңшылар аңшыларының күлкісі)
Dialogue: 0,0:01:59.16,0:02:01.32,Default,,0,0,0,,(желдету қақпағының құлау дыбысы)
Dialogue: 0,0:02:11.67,0:02:13.75,Default,,0,0,0,,Beastman арнайы аймағының күшіне енгеніне 10 жыл
Dialogue: 0,0:02:13.88,0:02:16.63,Default,,0,0,0,,Бестмен автономиялық аймағына әлі де қатты антипатия бар.
Dialogue: 0,0:02:16.76,0:02:20.59,Default,,0,0,0,,Диетаның алдында аңшыларға қарсы демонстрация өтуде.
Dialogue: 0,0:02:23.05,0:02:23.22,Default,,0,0,0,,Пойыз кетіп бара жатыр. Тұрғандар үшін...
Dialogue: 0,0:02:23.22,0:02:25.06,Default,,0,0,0,,Пойыз кетіп бара жатыр. Тұрғандар үшін...
Dialogue: 0,0:02:23.22,0:02:25.06,Default,,0,0,0,,А... Шаршаған күн.
Dialogue: 0,0:02:25.18,0:02:28.02,Default,,0,0,0,,Тұтқаны ұстаңыз.
Dialogue: 0,0:02:28.14,0:02:30.06,Default,,0,0,0,,(қозғалтқыштың іске қосу дыбысы)
Dialogue: 0,0:02:49.00,0:02:49.75,Default,,0,0,0,,Әй
Dialogue: 0,0:02:53.54,0:02:55.34,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:02:55.96,0:02:57.17,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:15.02,0:03:17.61,Default,,0,0,0,,Beastmen арнайы аймағы туралы заң қабылданғаннан бері -
Dialogue: 0,0:03:18.44,0:03:22.70,Default,,0,0,0,,Анима қаласы - аңдар аңдар сияқты өмір сүретін қала.
Dialogue: 0,0:03:22.82,0:03:24.82,Default,,0,0,0,,дамыды
Dialogue: 0,0:03:27.20,0:03:28.54,Default,,0,0,0,,Осымен.
Dialogue: 0,0:03:29.54,0:03:31.79,Default,,0,0,0,,Біз жануардың арнайы аймағын дамыту жобасындамыз.
Dialogue: 0,0:03:31.92,0:03:33.54,Default,,0,0,0,,Демеуші
Dialogue: 0,0:03:33.67,0:03:36.34,Default,,0,0,0,,Жаңа заман аңы: Сильваста фармацевтикасы
Dialogue: 0,0:03:39.01,0:03:40.13,Default,,0,0,0,,Ах
Dialogue: 0,0:03:43.84,0:03:44.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:46.85,0:03:48.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:49.97,0:03:50.89,Default,,0,0,0,,Я...
Dialogue: 0,0:03:54.27,0:03:55.10,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:03:59.15,0:04:00.53,Default,,0,0,0,,Жоқ! Уф
Dialogue: 0,0:04:00.86,0:04:02.03,Default,,0,0,0,,Ой…
Dialogue: 0,0:04:02.61,0:04:04.20,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:04:07.24,0:04:08.33,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:09.16,0:04:10.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:16.96,0:04:18.42,Default,,0,0,0,,Ауырды... Ха!
Dialogue: 0,0:04:21.01,0:04:22.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:22.17,0:04:23.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:30.18,0:04:31.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:31.64,0:04:34.10,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,0:04:35.69,0:04:38.02,Default,,0,0,0,,Мына хайуан!
Dialogue: 0,0:04:38.56,0:04:41.40,Default,,0,0,0,,Мен сенің не ойлайтыныңды білмеймін.
Dialogue: 0,0:04:41.90,0:04:44.70,Default,,0,0,0,,Бұл Анима қаласына қашатындар үшін жол.
Dialogue: 0,0:04:44.82,0:04:47.37,Default,,0,0,0,,Осы жерде шыдасаңыз, ештеңесіз қаласыз.
Dialogue: 0,0:04:47.49,0:04:50.49,Default,,0,0,0,,Темера сияқты құбыжықтар көбейгенде...
Dialogue: 0,0:04:50.62,0:04:52.41,Default,,0,0,0,,Бұл көз ауыртады!
Dialogue: 0,0:04:52.83,0:04:54.83,Default,,0,0,0,,Бля саған! Қарғыс атқыр...
Dialogue: 0,0:04:54.96,0:04:57.58,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:57.71,0:04:58.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:59.29,0:05:02.80,Default,,0,0,0,,Маған соншалықты бере аласыз ба?
Dialogue: 0,0:05:03.21,0:05:06.09,Default,,0,0,0,,Бұл бала біздің маңызды тұтынушымыз.
Dialogue: 0,0:05:06.22,0:05:08.97,Default,,0,0,0,,Маған жұмсақ болыңыз...
Dialogue: 0,0:05:13.02,0:05:16.06,Default,,0,0,0,,Жебені кенеттен қалай атуға болады?
Dialogue: 0,0:05:17.06,0:05:20.61,Default,,0,0,0,,Бұл сәл... дөрекі емес пе?
Dialogue: 0,0:05:20.73,0:05:21.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:22.82,0:05:23.65,Default,,0,0,0,,Ах
Dialogue: 0,0:05:24.82,0:05:28.57,Default,,0,0,0,,Мына жігіттерден тез құтылайық.
Dialogue: 0,0:05:28.70,0:05:30.66,Default,,0,0,0,,(гиенаның дауысы)
Dialogue: 0,0:05:31.12,0:05:35.08,Default,,0,0,0,,Біреуді өлтірсең, қалғаны қиынға соғады, сондықтан оны қалыпты жағдайда істе.
Dialogue: 0,0:05:35.91,0:05:36.96,Default,,0,0,0,,Хмф! (Аңшы аңшы) Ух...
Dialogue: 0,0:05:37.08,0:05:39.08,Default,,0,0,0,,Қарғыс атсын... Аххххх!
Dialogue: 0,0:05:39.46,0:05:41.46,Default,,0,0,0,,Тынш! (Аңшы аңшы) Уф
Dialogue: 0,0:05:41.59,0:05:42.59,Default,,0,0,0,,Уау
Dialogue: 0,0:05:42.71,0:05:44.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:44.67,0:05:47.72,Default,,0,0,0,,(қақтығыс дыбысы)
Dialogue: 0,0:05:49.76,0:05:53.56,Default,,0,0,0,,Анима қаласына апаратын жолды аңшылар аңшылар жауып тастады.
Dialogue: 0,0:05:54.10,0:05:57.60,Default,,0,0,0,,Бірақ уайымдама, мен сенімен боламын.
Dialogue: 0,0:05:57.73,0:05:59.52,Default,,0,0,0,,А... сен ше?
Dialogue: 0,0:06:00.10,0:06:03.90,Default,,0,0,0,,Мм, қиналған аңшыларға көмек қолын созу.
Dialogue: 0,0:06:04.03,0:06:07.40,Default,,0,0,0,,Махаббат еріктісі Мари Итами
Dialogue: 0,0:06:09.20,0:06:10.57,Default,,0,0,0,,Күдікті нәрсе
Dialogue: 0,0:06:10.99,0:06:12.78,Default,,0,0,0,,Ау, ауырып тұр.
Dialogue: 0,0:06:12.91,0:06:15.16,Default,,0,0,0,,Бұл қанша тұрады?
Dialogue: 0,0:06:15.29,0:06:17.54,Default,,0,0,0,,Сіз өзіңізді волонтер деп айтасыз.
Dialogue: 0,0:06:17.66,0:06:20.21,Default,,0,0,0,,Сіз ақшаны кейін алатын адамсыз.
Dialogue: 0,0:06:20.58,0:06:22.42,Default,,0,0,0,,Қандай аянышты бала.
Dialogue: 0,0:06:22.54,0:06:25.05,Default,,0,0,0,,Егер менде сүйкімділік болса, осыншама ұзақ өмір сүрмес едім.
Dialogue: 0,0:06:25.17,0:06:26.46,Default,,0,0,0,,Ең маңыздысы
Dialogue: 0,0:06:26.59,0:06:29.22,Default,,0,0,0,,Олай болса, қолыңыздағы барлық ақшаны алыңыз.
Dialogue: 0,0:06:29.34,0:06:30.59,Default,,0,0,0,,Шынымен! ?
Dialogue: 0,0:06:30.72,0:06:31.51,Default,,0,0,0,,Иә! (Аңшы аңшы) Ах!
Dialogue: 0,0:06:31.64,0:06:36.64,Default,,0,0,0,,Бұл сіздің өміріңіздің құны, сондықтан өзіңізді төмендетпеңіз.
Dialogue: 0,0:06:36.77,0:06:38.35,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:06:38.98,0:06:41.73,Default,,0,0,0,,Жақсы әңгіме құрастырма
Dialogue: 0,0:06:59.54,0:07:02.92,Default,,0,0,0,,Бұл қала шынымен тек аңдар үшін ме?
Dialogue: 0,0:07:03.04,0:07:05.00,Default,,0,0,0,,Иә Анима қаласы
Dialogue: 0,0:07:05.13,0:07:06.55,Default,,0,0,0,,Сенің де себебің бар ма?
Dialogue: 0,0:07:19.77,0:07:21.56,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:07:22.15,0:07:24.98,Default,,0,0,0,,Енді тыныш ұйықтайтын күнім келеді
Dialogue: 0,0:07:26.27,0:07:27.32,Default,,0,0,0,,Иә
Dialogue: 0,0:07:30.78,0:07:32.36,Default,,0,0,0,,Иә Келу
Dialogue: 0,0:07:32.49,0:07:36.28,Default,,0,0,0,,Кемеден түскенде екеуміз де бейтаныс едік.
Dialogue: 0,0:07:37.16,0:07:39.58,Default,,0,0,0,,Түсіндім, рахмет
Dialogue: 0,0:08:07.23,0:08:10.61,Default,,0,0,0,,Бұл не? Тым тыныш...
Dialogue: 0,0:08:11.24,0:08:12.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:21.08,0:08:21.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:22.04,0:08:22.50,Default,,0,0,0,,Ол Арнайы сыныпқа тең Қарғыс рухына айналуы күтіледі.
Dialogue: 0,0:08:22.50,0:08:23.50,Default,,0,0,0,,Ол Арнайы сыныпқа тең Қарғыс рухына айналуы күтіледі.
Dialogue: 0,0:08:22.50,0:08:23.50,Default,,0,0,0,,Ах
Dialogue: 0,0:08:23.50,0:08:27.00,Default,,0,0,0,,Ол Арнайы сыныпқа тең Қарғыс рухына айналуы күтіледі.
Dialogue: 0,0:08:27.13,0:08:29.55,Default,,0,0,0,,Сәлем
Dialogue: 0,0:08:29.67,0:08:35.01,Default,,0,0,0,,(Ауандардың айқайы)
Dialogue: 0,0:08:44.69,0:08:48.86,Default,,0,0,0,,А... а... а...
Dialogue: 0,0:08:50.73,0:08:55.74,Default,,0,0,0,,(Айуандардың қошеметі)
Dialogue: 0,0:09:11.92,0:09:13.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.51,0:09:15.34,Default,,0,0,0,,Бұл фестиваль!
Dialogue: 0,0:09:17.59,0:09:19.18,Default,,0,0,0,,Бұл әкім!
Dialogue: 0,0:09:19.76,0:09:20.93,Default,,0,0,0,,Мэр Роуз! (Айуан адам) Бұл әкім.
Dialogue: 0,0:09:21.06,0:09:22.14,Default,,0,0,0,,Мэр Банзай
Dialogue: 0,0:09:22.56,0:09:25.31,Default,,0,0,0,,Анима қаласының салынғанына 10 жыл
Dialogue: 0,0:09:25.43,0:09:29.11,Default,,0,0,0,,Аңдар мен адамдар арасындағы алшақтық әлі жойылған жоқ.
Dialogue: 0,0:09:29.73,0:09:34.32,Default,,0,0,0,,Десе де бұл қала хайуандардың баспанасы болып қала береді.
Dialogue: 0,0:09:34.82,0:09:37.82,Default,,0,0,0,,Соңғы 10 жыл және келесі 10 жыл...
Dialogue: 0,0:09:37.95,0:09:40.78,Default,,0,0,0,,Жоқ, одан кейінгі болашақ үшін...
Dialogue: 0,0:09:41.28,0:09:43.37,Default,,0,0,0,,Мерейтойыңызды тойлаңыз!
Dialogue: 0,0:09:43.49,0:09:48.50,Default,,0,0,0,,(Айуандардың қошеметі)
Dialogue: 0,0:09:49.21,0:09:51.67,Default,,0,0,0,,Біз бәріміз айуанбыз!
Dialogue: 0,0:09:53.46,0:09:55.55,Default,,0,0,0,,Енді жүгіруге болмайды!
Dialogue: 0,0:09:55.67,0:09:58.84,Default,,0,0,0,,(топ өнімділігі)
Dialogue: 0,0:09:59.09,0:10:00.80,Default,,0,0,0,,Ахаха ахахха
Dialogue: 0,0:10:06.60,0:10:08.60,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:10:09.69,0:10:12.52,Default,,0,0,0,,Ахаха хаха хахаха...
Dialogue: 0,0:10:13.40,0:10:15.15,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:10:15.99,0:10:17.70,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:10:19.28,0:10:21.66,Default,,0,0,0,,Ахахах... Уф
Dialogue: 0,0:10:22.03,0:10:24.54,Default,,0,0,0,,Ой, кешіріңіз... Иә?
Dialogue: 0,0:10:28.62,0:10:29.46,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:30.42,0:10:32.25,Default,,0,0,0,,Жақсы иіс шығады.
Dialogue: 0,0:10:32.38,0:10:36.05,Default,,0,0,0,,Қуаныш пен шаттыққа толы аңдардың иісі.
Dialogue: 0,0:10:36.59,0:10:37.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:37.84,0:10:42.18,Default,,0,0,0,,Ләззат алыңыз! Бұл біз 1000 жыл күткен аңдар фестивалі.
Dialogue: 0,0:10:42.30,0:10:43.89,Default,,0,0,0,,Міне, дәл осылай мүлдем әлсіз болу дегенді айтады, иә, Польнарефф?
Dialogue: 0,0:10:44.93,0:10:46.85,Default,,0,0,0,,Адамдардың әр түрі бар...
Dialogue: 0,0:10:46.97,0:10:49.48,Default,,0,0,0,,Мен жылап жатырмын... Мен қорқамын
Dialogue: 0,0:10:51.60,0:10:52.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:55.36,0:10:56.90,Default,,0,0,0,,Бұл зейінімді басқа жаққа бұрады, сондықтан кетші.
Dialogue: 0,0:11:05.24,0:11:08.37,Default,,0,0,0,,Мэр: Бұл премьер-министр Ширамизудан.
Dialogue: 0,0:11:09.54,0:11:13.04,Default,,0,0,0,,Сізді 10 жылдық мерейтойыңызбен Мэр Роуз құттықтаймыз
Dialogue: 0,0:11:13.54,0:11:16.00,Default,,0,0,0,,Премьер-министрге түсіністікпен қарағаны үшін рахмет.
Dialogue: 0,0:11:16.46,0:11:19.88,Default,,0,0,0,,Ах, бірақ мені қате түсінбеңіз.
Dialogue: 0,0:11:20.01,0:11:22.59,Default,,0,0,0,,Айуан адамының арнайы аймағы қатты емес.
Dialogue: 0,0:11:22.72,0:11:25.68,Default,,0,0,0,,Егер сіз хайуанаттар қауіпті нәрсе жасасаңыз...
Dialogue: 0,0:11:25.81,0:11:29.64,Default,,0,0,0,,Қашан және не болатынын білмеуіміз...
Dialogue: 0,0:11:32.98,0:11:35.44,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:11:36.61,0:11:37.90,Default,,0,0,0,,Я...
Dialogue: 0,0:11:38.48,0:11:42.91,Default,,0,0,0,,Әдеттегідей, сіз тойлайсыз ба немесе қорқытып жатырсыз ба?
Dialogue: 0,0:11:43.03,0:11:45.57,Default,,0,0,0,,Сонда да 10 жыл өтті
Dialogue: 0,0:11:48.79,0:11:51.66,Default,,0,0,0,,Барбарей Роуз үшін он жылдық күрес
Dialogue: 0,0:11:51.79,0:11:54.83,Default,,0,0,0,,Анима қаласының келесі 10 жылында
Dialogue: 0,0:12:07.18,0:12:09.18,Default,,0,0,0,,Фааа
Dialogue: 0,0:12:09.72,0:12:11.93,Default,,0,0,0,,Бұл тиімді~
Dialogue: 0,0:12:12.06,0:12:15.60,Default,,0,0,0,,О, сатып ал, жейсің бе? Мен оны жасырып қойдым
Dialogue: 0,0:12:16.44,0:12:17.48,Default,,0,0,0,,Қасқыр адам!
Dialogue: 0,0:12:17.61,0:12:19.61,Default,,0,0,0,,Итачи емес! күзен!
Dialogue: 0,0:12:19.73,0:12:20.82,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:20.94,0:12:24.16,Default,,0,0,0,,Оны әлгі арзан жүнді жігіттермен араластырма.
Dialogue: 0,0:12:24.28,0:12:25.49,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:12:25.87,0:12:28.33,Default,,0,0,0,,Сізде бар ақшаны айттыңыз.
Dialogue: 0,0:12:28.45,0:12:31.20,Default,,0,0,0,,Шынында да, бұл күндері кішкентай балалар сақ болуы керек.
Dialogue: 0,0:12:31.33,0:12:33.08,Default,,0,0,0,,Мен енді төлемеймін.
Dialogue: 0,0:12:33.62,0:12:35.67,Default,,0,0,0,,Кемеден түскенде бейтаныс адамсың, солай ма?
Dialogue: 0,0:12:35.79,0:12:39.09,Default,,0,0,0,,Мен сондай аянышты әйелге ұқсаймын ба?
Dialogue: 0,0:12:39.21,0:12:42.05,Default,,0,0,0,,Әй, қайғылы... қайғылы...
Dialogue: 0,0:12:43.09,0:12:44.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:44.76,0:12:46.01,Default,,0,0,0,,Әй, ұры!
Dialogue: 0,0:12:46.51,0:12:48.14,Default,,0,0,0,,О, бейшара.
Dialogue: 0,0:12:48.26,0:12:52.68,Default,,0,0,0,,Сақ болыңыз, Анима қаласы - тірі жылқы аңдары көзіңізді жауып алатын қала.
Dialogue: 0,0:12:52.81,0:12:55.02,Default,,0,0,0,,Мен саған сенбеймін... (Мари) Жақсысың ба?
Dialogue: 0,0:12:55.14,0:12:57.10,Default,,0,0,0,,Жүр, қалта ұры...
Dialogue: 0,0:12:58.40,0:13:00.27,Default,,0,0,0,,Хмм... қазірдің өзінде!
Dialogue: 0,0:13:00.40,0:13:04.11,Default,,0,0,0,,Біреу~! Қалта ұрысын ұстаңыз!
Dialogue: 0,0:13:12.50,0:13:13.75,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:13:14.12,0:13:16.96,Default,,0,0,0,,Уф... иә?
Dialogue: 0,0:13:25.97,0:13:28.34,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:13:30.35,0:13:31.31,Default,,0,0,0,,Сіз қайда бардыңыз?
Dialogue: 0,0:13:32.64,0:13:33.85,Default,,0,0,0,,Я...
Dialogue: 0,0:13:34.31,0:13:36.48,Default,,0,0,0,,Хмм, қазірдің өзінде!
Dialogue: 0,0:13:37.27,0:13:38.35,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:38.48,0:13:41.07,Default,,0,0,0,,(Ауандардың айқайы)
Dialogue: 0,0:13:42.15,0:13:43.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:43.94,0:13:46.15,Default,,0,0,0,,(Болаттың сықырлаған дыбысы)
Dialogue: 0,0:13:47.78,0:13:49.24,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:13:52.66,0:13:55.75,Default,,0,0,0,,(Ауандардың айқайы)
Dialogue: 0,0:13:56.33,0:13:58.33,Default,,0,0,0,,Ахх... ахх
Dialogue: 0,0:13:58.46,0:13:59.21,Default,,0,0,0,,...
Dialogue: 0,0:13:59.92,0:14:01.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:03.92,0:14:05.30,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:14:07.09,0:14:08.80,Default,,0,0,0,,Ата, асығыңыз!
Dialogue: 0,0:14:11.51,0:14:13.18,Default,,0,0,0,,Ябаяба Ябаяба...
Dialogue: 0,0:14:13.31,0:14:15.68,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:14:25.03,0:14:26.90,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:14:27.49,0:14:28.90,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:14:29.45,0:14:31.07,Default,,0,0,0,,Жылап тұрған адам
Dialogue: 0,0:14:33.28,0:14:35.24,Default,,0,0,0,,Эй, сен тағы да жылайсың...
Dialogue: 0,0:14:35.70,0:14:37.62,Default,,0,0,0,,Ах... уау
Dialogue: 0,0:14:37.75,0:14:41.38,Default,,0,0,0,,Бұл сенсің! ? Айуандардың мерекесін жойған
Dialogue: 0,0:14:41.50,0:14:45.13,Default,,0,0,0,,Мен емес! Мен бағанаға сәл ғана соқтым
Dialogue: 0,0:14:45.38,0:14:46.76,Default,,0,0,0,,Ол жарылып кете ме?
Dialogue: 0,0:14:46.88,0:14:48.42,Default,,0,0,0,,Жоқ, солай емес пе?
Dialogue: 0,0:14:48.55,0:14:50.93,Default,,0,0,0,,Демек, бұл мен емес!
Dialogue: 0,0:14:51.47,0:14:52.76,Default,,0,0,0,,Иә? (Широу) А?
Dialogue: 0,0:14:53.43,0:14:54.85,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:14:55.39,0:14:57.60,Default,,0,0,0,,Бағананың қасында жасырынып жүрді.
Dialogue: 0,0:14:57.73,0:14:58.81,Default,,0,0,0,,Бұл жігіт пе?
Dialogue: 0,0:14:58.93,0:15:00.81,Default,,0,0,0,,Уау (Мичирудың құлаған дыбысы)
Dialogue: 0,0:15:01.10,0:15:03.27,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:15:06.15,0:15:07.23,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:15:36.31,0:15:39.22,Default,,0,0,0,,Мен қате түсінген сияқтымын. Кешіріңіз.
Dialogue: 0,0:15:39.35,0:15:40.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:43.56,0:15:45.90,Default,,0,0,0,,Нақты не?
Dialogue: 0,0:15:46.61,0:15:48.90,Default,,0,0,0,,А... А?
Dialogue: 0,0:15:49.03,0:15:51.20,Default,,0,0,0,,Иә, қалта ұрылары!
Dialogue: 0,0:16:02.92,0:16:04.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:08.34,0:16:09.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:12.17,0:16:13.63,Default,,0,0,0,,Не?
Dialogue: 0,0:16:14.76,0:16:18.35,Default,,0,0,0,,Өкінішке орай, бұл иіссіз бомба.
Dialogue: 0,0:16:18.81,0:16:21.43,Default,,0,0,0,,Тіпті аңдар да байқамайды.
Dialogue: 0,0:16:22.23,0:16:23.39,Default,,0,0,0,,Уау
Dialogue: 0,0:16:24.06,0:16:26.23,Default,,0,0,0,,Уау! Бұл не?
Dialogue: 0,0:16:26.36,0:16:27.40,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,0:16:29.15,0:16:30.86,Default,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,0:16:36.28,0:16:37.70,Default,,0,0,0,,Ауырды.
Dialogue: 0,0:16:38.12,0:16:39.91,Default,,0,0,0,,Бұл жігіт өлмейтін!
Dialogue: 0,0:16:40.49,0:16:43.87,Default,,0,0,0,,Айт, сен неге мерекені бұздың?
Dialogue: 0,0:16:44.42,0:16:45.33,Default,,0,0,0,,Қарғыс атсын... хаха...
Dialogue: 0,0:16:45.71,0:16:48.29,Default,,0,0,0,,Ауырды... Уф...
Dialogue: 0,0:17:00.60,0:17:03.60,Default,,0,0,0,,Эй, бұл тез.
Dialogue: 0,0:17:03.73,0:17:06.73,Default,,0,0,0,,Не болды, Сато, тұзағың сәтсіз болды ма?
Dialogue: 0,0:17:07.15,0:17:08.23,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:17:08.36,0:17:11.69,Default,,0,0,0,,Әлгі қасқыр жігіт менің бомбамнан аман қалды.
Dialogue: 0,0:17:13.15,0:17:15.36,Default,,0,0,0,,Кәсіби маманға ұқсайды
Dialogue: 0,0:17:30.09,0:17:31.67,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:17:31.84,0:17:33.76,Default,,0,0,0,,Адам!
Dialogue: 0,0:17:33.88,0:17:35.34,Default,,0,0,0,,(Широудың ырылдауы)
Dialogue: 0,0:17:37.80,0:17:40.30,Default,,0,0,0,,Сізді адамдар сатып алды ма?
Dialogue: 0,0:17:40.85,0:17:43.31,Default,,0,0,0,,Сіз қайдан білдіңіз? а?
Dialogue: 0,0:17:45.27,0:17:48.85,Default,,0,0,0,,Сол денеге енген адам иісін өшіру мүмкін емес.
Dialogue: 0,0:17:48.98,0:17:49.81,Default,,0,0,0,,Ах
Dialogue: 0,0:17:50.23,0:17:52.32,Default,,0,0,0,,Ол өте жақсы мұрны бар адам.
Dialogue: 0,0:17:53.19,0:17:56.20,Default,,0,0,0,,Сізді хайуанға қарсы топ сатып алды.
Dialogue: 0,0:17:57.95,0:18:00.41,Default,,0,0,0,,Сатып алғанын естісем де бас тарта алмаймын.
Dialogue: 0,0:18:00.99,0:18:03.87,Default,,0,0,0,,Айуансың ба, адамсың ба бәрібір.
Dialogue: 0,0:18:04.37,0:18:06.79,Default,,0,0,0,,Мен қабылдаған жұмыс...
Dialogue: 0,0:18:07.25,0:18:08.75,Default,,0,0,0,,Дұрыс орындаңыз
Dialogue: 0,0:18:09.00,0:18:11.38,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:11.92,0:18:16.22,Default,,0,0,0,,Мерекенің ластанғаны осыдан ба?
Dialogue: 0,0:18:17.17,0:18:19.18,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:18:19.55,0:18:20.39,Default,,0,0,0,,Гуах
Dialogue: 0,0:18:20.72,0:18:22.81,Default,,0,0,0,,Мынау... ей! Авава...
Dialogue: 0,0:18:22.93,0:18:24.43,Default,,0,0,0,,Уф... (Широу) Бұл қылмыс...
Dialogue: 0,0:18:24.56,0:18:26.39,Default,,0,0,0,,Өз өміріңізбен төлеңіз
Dialogue: 0,0:18:26.52,0:18:27.60,Default,,0,0,0,,Уау
Dialogue: 0,0:18:28.64,0:18:29.52,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:30.69,0:18:31.81,Default,,0,0,0,,Хмм... Шаа!
Dialogue: 0,0:18:31.94,0:18:32.77,Default,,0,0,0,,Фугия!
Dialogue: 0,0:18:33.73,0:18:34.61,Default,,0,0,0,,Уф... уау
Dialogue: 0,0:18:36.32,0:18:40.53,Default,,0,0,0,,Айуан адамыңның жанын адамға сатқан айуансың.
Dialogue: 0,0:18:40.99,0:18:45.29,Default,,0,0,0,,Балалар сендер бұл тырнаққа да лайық емессіңдер.
Dialogue: 0,0:18:46.62,0:18:48.25,Default,,0,0,0,,Жұдырық жеткілікті!
Dialogue: 0,0:18:48.96,0:18:50.83,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:18:51.33,0:18:53.88,Default,,0,0,0,,Өкінбе!
Dialogue: 0,0:18:54.00,0:18:55.46,Default,,0,0,0,,(Танаканың ырылдауы)
Dialogue: 0,0:18:55.59,0:19:01.76,Default,,0,0,0,,(Танака мен Ямаданың айқайы)
Dialogue: 0,0:19:02.64,0:19:04.85,Default,,0,0,0,,Уууу!
Dialogue: 0,0:19:04.97,0:19:07.43,Default,,0,0,0,,Уау! Гау!
Dialogue: 0,0:19:07.56,0:19:12.19,Default,,0,0,0,,Адамдар өмір бойы жүрек тереңдерін өзгелерден жасырып өтеді.
Dialogue: 0,0:19:12.31,0:19:13.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:13.52,0:19:15.90,Default,,0,0,0,,Таяааааааааааааааааааа!
Dialogue: 0,0:19:16.02,0:19:18.15,Default,,0,0,0,,Уау (Широу) Уа!
Dialogue: 0,0:19:18.49,0:19:19.32,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:19:19.70,0:19:22.66,Default,,0,0,0,,Аңның намысынан айырылған саған...
Dialogue: 0,0:19:22.78,0:19:25.16,Default,,0,0,0,,Бұғы мақтаныштың қажеті жоқ
Dialogue: 0,0:19:25.28,0:19:26.54,Default,,0,0,0,,Тоқта... тоқта!
Dialogue: 0,0:19:26.95,0:19:30.29,Default,,0,0,0,,Бұрышқа келетін болсақ... тек бұрыш... у...
Dialogue: 0,0:19:30.41,0:19:32.00,Default,,0,0,0,,Хмм! Ааааа!
Dialogue: 0,0:19:33.17,0:19:35.59,Default,,0,0,0,,Міне, жас жігіт.
Dialogue: 0,0:19:37.00,0:19:39.34,Default,,0,0,0,,Мені жас жігіт деп айтпа.
Dialogue: 0,0:19:41.93,0:19:43.01,Default,,0,0,0,,Хмф! Уау
Dialogue: 0,0:19:43.14,0:19:45.26,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:19:45.51,0:19:46.93,Default,,0,0,0,,менің, Иида мен Тодорокидің есімдері жарияланбады—
Dialogue: 0,0:19:48.77,0:19:51.73,Default,,0,0,0,,Иә! Уф!
Dialogue: 0,0:19:55.52,0:19:56.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:57.07,0:19:57.90,Default,,0,0,0,,Қозғалмаңыз!
Dialogue: 0,0:19:58.03,0:19:58.94,Default,,0,0,0,,Га
Dialogue: 0,0:19:59.53,0:20:02.36,Default,,0,0,0,,Көшіп кетсең бұл бала аман қалмайды.
Dialogue: 0,0:20:03.11,0:20:06.33,Default,,0,0,0,,Кімнің өмірі... жоғалды?
Dialogue: 0,0:20:06.45,0:20:07.41,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:20:07.53,0:20:09.20,Default,,0,0,0,,Аһ!
Dialogue: 0,0:20:09.33,0:20:10.79,Default,,0,0,0,,Уау...
Dialogue: 0,0:20:11.37,0:20:13.25,Default,,0,0,0,,Хмм! Бір минут күтіңіз
Dialogue: 0,0:20:13.37,0:20:15.25,Default,,0,0,0,,Ха! Бұл қорқынышты
Dialogue: 0,0:20:15.38,0:20:16.21,Default,,0,0,0,,Хмф! Ааааааааааааааааааа
Dialogue: 0,0:20:16.34,0:20:18.42,Default,,0,0,0,,Ууууууууууууууууууууууу!
Dialogue: 0,0:20:24.38,0:20:26.85,Default,,0,0,0,,Жетер, мен сені аяймын!
Dialogue: 0,0:20:27.76,0:20:31.14,Default,,0,0,0,,Тоқтатпа мына балалар фестивальді бұзды.
Dialogue: 0,0:20:31.27,0:20:35.06,Default,,0,0,0,,Бірақ бұл баяғы хайуан, солай ма? Осылай...
Dialogue: 0,0:20:35.56,0:20:38.11,Default,,0,0,0,,Бұл жігіттерді адамдар жалдаған.
Dialogue: 0,0:20:38.23,0:20:40.53,Default,,0,0,0,,Жыртқыштың желіне қарсы қоюға болмайды.
Dialogue: 0,0:20:41.07,0:20:42.90,Default,,0,0,0,,Бұл табиғи нәрсе.
Dialogue: 0,0:20:43.03,0:20:44.45,Default,,0,0,0,,Фугия!
Dialogue: 0,0:20:44.57,0:20:46.03,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:20:47.62,0:20:51.08,Default,,0,0,0,,Уф... тоқта!
Dialogue: 0,0:20:51.83,0:20:53.25,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:20:54.00,0:20:55.08,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:04.68,0:21:06.22,Default,,0,0,0,,Жетеді, солай ма?
Dialogue: 0,0:21:06.76,0:21:09.30,Default,,0,0,0,,Неліктен аңдар бір-бірімен соғысады?
Dialogue: 0,0:21:09.43,0:21:12.77,Default,,0,0,0,,Бұл қала хайуандардың жұмақ жері емес пе еді?
Dialogue: 0,0:21:15.85,0:21:17.81,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:21:17.94,0:21:20.23,Default,,0,0,0,,Адамдар бұл қаланың жауы.
Dialogue: 0,0:21:20.36,0:21:22.94,Default,,0,0,0,,Адамдар жалдаған аңдар да солай.
Dialogue: 0,0:21:23.53,0:21:25.40,Default,,0,0,0,,Бәрі де ондай емес!
Dialogue: 0,0:21:26.66,0:21:28.87,Default,,0,0,0,,Барлық адамдар бірдей
Dialogue: 0,0:21:29.32,0:21:30.74,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:31.33,0:21:32.70,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:21:34.08,0:21:35.58,Default,,0,0,0,,Мен де адаммын
Dialogue: 0,0:21:37.96,0:21:39.25,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:40.54,0:21:41.71,Default,,0,0,0,,Мен адаммын
Dialogue: 0,0:21:44.51,0:21:46.38,Default,,0,0,0,,Ол адам еді!
