Dialogue: 0,0:00:00.48,0:00:01.81,Staff,,0,0,0,,Бұл субтитр Yu KitaUji субтитр жұбын жеткізу алмасу сынағы көру үшін шығару Топты қарау 884738299 Шақыру тобы 232487445 TG@KitaUji
Dialogue: 0,0:00:01.81,0:00:03.44,Staff,,0,0,0,,Аударма: Шағын бизнес сиқырлы әйел Орики Ихей Занен HL Коикано Цуёси Кисара FFU2 Козо Хироши Фуказо Көк харуру
Dialogue: 0,0:00:03.44,0:00:05.40,Staff,,0,0,0,,Субтитрлерді дайындаған: ikymory
Dialogue: 0,0:01:41.37,0:01:43.67,OP - CN,,0,0,0,,келді
Dialogue: 0,0:01:43.67,0:01:46.17,OP - CN,,0,0,0,,Жүріп бара жатқан аяқтың дауысы
Dialogue: 0,0:01:46.17,0:01:50.50,OP - CN,,0,0,0,,Дұрыс адам кім?
Dialogue: 0,0:01:50.50,0:01:53.71,OP - CN,,0,0,0,,Мұздай салқын күн тесігі
Dialogue: 0,0:01:53.71,0:01:56.67,OP - CN,,0,0,0,,Сіздің құқықтық мәртебеңіз қандай?
Dialogue: 0,0:01:56.67,0:02:01.02,OP - CN,,0,0,0,,Әңгіменің соңы
Dialogue: 0,0:02:02.94,0:02:05.71,OP - CN,,0,0,0,,Өздігінен ұқсас сөздер
Dialogue: 0,0:02:05.71,0:02:09.61,OP - CN,,0,0,0,,Сен енді менсің мен енді сенмін
Dialogue: 0,0:02:09.61,0:02:13.11,OP - CN,,0,0,0,,...
Dialogue: 0,0:02:13.11,0:02:15.83,OP - CN,,0,0,0,,Терең тыныс алып, демді шығару
Dialogue: 0,0:02:15.83,0:02:18.41,OP - CN,,0,0,0,,Бұл процестің басы.
Dialogue: 0,0:02:18.41,0:02:22.71,OP - CN,,0,0,0,,Тасталудан іштей қорқу
Dialogue: 0,0:02:22.71,0:02:29.20,OP - CN,,0,0,0,,Өткеннен құтылу
Dialogue: 0,0:02:35.51,0:02:39.31,OP - CN,,0,0,0,,Юя Йогамен айналысыңыз
Dialogue: 0,0:02:40.56,0:02:44.81,OP - CN,,0,0,0,,Мен саған батамды беремін
Dialogue: 0,0:01:41.37,0:01:43.67,OP - JP,,0,0,0,,Жақындау
Dialogue: 0,0:01:43.67,0:01:46.17,OP - JP,,0,0,0,,Мен аяқ дыбыстарын естимін
Dialogue: 0,0:01:46.17,0:01:50.50,OP - JP,,0,0,0,,Артыңызда кім тұр?
Dialogue: 0,0:01:50.50,0:01:53.71,OP - JP,,0,0,0,,Дөңгелек тұмсық ғибадатханаларды салқындатады.
Dialogue: 0,0:01:53.71,0:01:56.67,OP - JP,,0,0,0,,Жүректің қалпын тексергенде
Dialogue: 0,0:01:56.67,0:02:01.02,OP - JP,,0,0,0,,Ақыры оның жүзін көрдім
Dialogue: 0,0:02:02.94,0:02:05.71,OP - JP,,0,0,0,,қосшы айтты
Dialogue: 0,0:02:05.71,0:02:09.61,OP - JP,,0,0,0,,Сен менсің, мен сенмін
Dialogue: 0,0:02:09.61,0:02:13.11,OP - JP,,0,0,0,,Эй, мен сені ауыстырамын.
Dialogue: 0,0:02:13.11,0:02:15.83,OP - JP,,0,0,0,,Эй, дем ал, дем ал.
Dialogue: 0,0:02:15.83,0:02:18.41,OP - JP,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:02:18.41,0:02:22.71,OP - JP,,0,0,0,,Сіз қорқынышты жүрегіңізді тастай аласыз.
Dialogue: 0,0:02:22.71,0:02:29.20,OP - JP,,0,0,0,,Мен сені құтқарамын
Dialogue: 0,0:02:35.51,0:02:39.31,OP - JP,,0,0,0,,Сен және мен
Dialogue: 0,0:02:40.56,0:02:44.81,OP - JP,,0,0,0,,Мен және сен
Dialogue: 0,1:11:18.80,1:11:20.34,ED - CN,,0,0,0,,Мені күт
Dialogue: 0,1:11:20.34,1:11:21.88,ED - CN,,0,0,0,,Мен оны киетін адаммын.
Dialogue: 0,1:11:21.88,1:11:24.97,ED - CN,,0,0,0,,Ертең шексіз болады
Dialogue: 0,1:11:24.97,1:11:28.10,ED - CN,,0,0,0,,Премьер-Министрдің тоқтап, жүруді сұрауы
Dialogue: 0,1:11:28.10,1:11:31.18,ED - CN,,0,0,0,,Тыныссыз енді
Dialogue: 0,1:11:31.18,1:11:34.31,ED - CN,,0,0,0,,Мәңгілік жады
Dialogue: 0,1:11:34.31,1:11:37.36,ED - CN,,0,0,0,,Гая Акечи Заң сақталмайды
Dialogue: 0,1:11:37.36,1:11:40.48,ED - CN,,0,0,0,,Бұл баяғыда болды.
Dialogue: 0,1:11:40.48,1:11:42.74,ED - CN,,0,0,0,,Зашинран Иссуми Ракутен
Dialogue: 0,1:11:42.74,1:11:46.49,ED - CN,,0,0,0,,Қажетсіз ұмыту
Dialogue: 0,1:11:46.49,1:11:49.58,ED - CN,,0,0,0,,Көтерілген көпірдің астынан өткендегі тамаша уақыт
Dialogue: 0,1:11:49.58,1:11:56.63,ED - CN,,0,0,0,,Мен де өкінемін.
Dialogue: 0,1:12:08.35,1:12:11.47,ED - CN,,0,0,0,,Мен өте ризамын
Dialogue: 0,1:12:11.47,1:12:14.52,ED - CN,,0,0,0,,Жүректегі сезімдер
Dialogue: 0,1:12:14.52,1:12:17.65,ED - CN,,0,0,0,,Менің істеп жатқаным осы.
Dialogue: 0,1:12:17.65,1:12:20.77,ED - CN,,0,0,0,,Шағын капитал жойылды.
Dialogue: 0,1:12:20.77,1:12:23.82,ED - CN,,0,0,0,,Уақыт және шектеулер
Dialogue: 0,1:12:23.82,1:12:26.95,ED - CN,,0,0,0,,Менің терең таным өмірім мәңгілік.
Dialogue: 0,1:12:26.95,1:12:30.03,ED - CN,,0,0,0,,Бұл баяғыда болды.
Dialogue: 0,1:12:30.03,1:12:32.29,ED - CN,,0,0,0,,Өкініш - енді баратын жол
Dialogue: 0,1:12:32.29,1:12:36.04,ED - CN,,0,0,0,,Қажетсіз ұмыту
Dialogue: 0,1:12:36.04,1:12:39.13,ED - CN,,0,0,0,,Көтерілген көпірдің астынан өткендегі тамаша уақыт
Dialogue: 0,1:12:39.13,1:12:46.13,ED - CN,,0,0,0,,Мен де сонда болған соң тәубе еттім.
Dialogue: 0,1:13:28.84,1:13:30.43,ED - CN,,0,0,0,,Мені күт
Dialogue: 0,1:13:30.43,1:13:31.97,ED - CN,,0,0,0,,Мен оны киетін адаммын.
Dialogue: 0,1:13:31.97,1:13:35.06,ED - CN,,0,0,0,,Ертең қызмет көрсетуде шектеу болмайды.
Dialogue: 0,1:13:35.06,1:13:38.19,ED - CN,,0,0,0,,Бұл баяғыда болды.
Dialogue: 0,1:13:38.19,1:13:42.61,ED - CN,,0,0,0,,Ұмытудың тыртықтары
Dialogue: 0,1:13:45.86,1:13:50.32,ED - CN,,0,0,0,,Мен саған тиесілі емеспін
Dialogue: 0,1:11:18.80,1:11:20.34,ED - JP,,0,0,0,,Мен сені күттім
Dialogue: 0,1:11:20.34,1:11:21.88,ED - JP,,0,0,0,,Мен күттім
Dialogue: 0,1:11:21.88,1:11:24.97,ED - JP,,0,0,0,,Ертең үзіліссіз өтеді
Dialogue: 0,1:11:24.97,1:11:28.10,ED - JP,,0,0,0,,Тоқта және артқа қара
Dialogue: 0,1:11:28.10,1:11:31.18,ED - JP,,0,0,0,,Бұл бітпейтін күнге зар айттық
Dialogue: 0,1:11:31.18,1:11:34.31,ED - JP,,0,0,0,,Естеліктер мәңгілік
Dialogue: 0,1:11:34.31,1:11:37.36,ED - JP,,0,0,0,,Ештеңе қалмайтынын есте сақтаңыз
Dialogue: 0,1:11:37.36,1:11:40.48,ED - JP,,0,0,0,,Мен тырнап жүремін
Dialogue: 0,1:11:40.48,1:11:42.74,ED - JP,,0,0,0,,Жүректің бір бұрышында жыладым
Dialogue: 0,1:11:42.74,1:11:46.49,ED - JP,,0,0,0,,Өтінемін, оны жоғалтпаңыз
Dialogue: 0,1:11:46.49,1:11:49.58,ED - JP,,0,0,0,,Эстакаданың астында күндер өтеді
Dialogue: 0,1:11:49.58,1:11:56.63,ED - JP,,0,0,0,,Сол күні мен өкінетінімді айта алмадым
Dialogue: 0,1:12:08.35,1:12:11.47,ED - JP,,0,0,0,,Бір-бірімен байланысқан кездер де болды
Dialogue: 0,1:12:11.47,1:12:14.52,ED - JP,,0,0,0,,Шешілмеген сезімдерді біріктіру
Dialogue: 0,1:12:14.52,1:12:17.65,ED - JP,,0,0,0,,Менде бар болғаны осы болды
Dialogue: 0,1:12:17.65,1:12:20.77,ED - JP,,0,0,0,,Мен оны да жоғалтып алдым.
Dialogue: 0,1:12:20.77,1:12:23.82,ED - JP,,0,0,0,,Уақыт өте келе пішіні де өзгереді
Dialogue: 0,1:12:23.82,1:12:26.95,ED - JP,,0,0,0,,Заттардың өзгеріп жатқанын есте сақтаңыз.
Dialogue: 0,1:12:26.95,1:12:30.03,ED - JP,,0,0,0,,Мен тырнап жүремін
Dialogue: 0,1:12:30.03,1:12:32.29,ED - JP,,0,0,0,,Мен бүгін блокталғаным үшін жек көрдім.
Dialogue: 0,1:12:32.29,1:12:36.04,ED - JP,,0,0,0,,Өтінемін, оны жоғалтпаңыз
Dialogue: 0,1:12:36.04,1:12:39.13,ED - JP,,0,0,0,,Эстакаданың астында күндер өтеді
Dialogue: 0,1:12:39.13,1:12:46.13,ED - JP,,0,0,0,,Сол күні мен өкінетінімді айта алмадым
Dialogue: 0,1:13:28.84,1:13:30.43,ED - JP,,0,0,0,,Мен сені күттім
Dialogue: 0,1:13:30.43,1:13:31.97,ED - JP,,0,0,0,,Мен күттім
Dialogue: 0,1:13:31.97,1:13:35.06,ED - JP,,0,0,0,,Ертең үзіліссіз өтеді
Dialogue: 0,1:13:35.06,1:13:38.19,ED - JP,,0,0,0,,Мен де бүгін тырнап жатырмын
Dialogue: 0,1:13:38.19,1:13:42.61,ED - JP,,0,0,0,,Сіз ұмытпайтын тыртық қалдырасыз.
Dialogue: 0,1:13:45.86,1:13:50.32,ED - JP,,0,0,0,,Егер бұл сіз болмасаңыз
Dialogue: 6,0:11:26.67,0:11:31.00,Insert - CN,,0,0,0,,Енді жыл соңы
Dialogue: 6,0:11:31.00,0:11:36.59,Insert - CN,,0,0,0,,Уақыты келгенде мен ұйықтап жатқандай боламын.
Dialogue: 6,0:11:36.59,0:11:41.14,Insert - CN,,0,0,0,,Жастар енді ешқашан келмейді.
Dialogue: 6,0:11:41.14,0:11:46.44,Insert - CN,,0,0,0,,Менің денемнің физикалық дәретхана кездесу байланысы алынды.
Dialogue: 6,0:11:46.83,0:11:51.82,Insert - CN,,0,0,0,,Мен туралы естеліктер жазылған мұхиттың бір бөлігі.
Dialogue: 6,0:11:51.82,0:11:57.02,Insert - CN,,0,0,0,,Аспанда барлық адамдардың қол жеткізуі мүмкін емес жетістік
Dialogue: 6,0:11:57.02,0:12:02.08,Insert - CN,,0,0,0,,Әлі белгісіз адам.
Dialogue: 6,0:12:02.08,0:12:07.94,Insert - CN,,0,0,0,,Мен мұхитты айналып өте алатын ең аз су мөлшері.
Dialogue: 6,0:12:08.74,0:12:13.30,Insert - CN,,0,0,0,,Елшіні бірден қабылдадыңыз, нөсер жаңбыр жалғыз болды, дүрбелең шыдамсыз болды.
Dialogue: 6,0:12:13.30,0:12:19.03,Insert - CN,,0,0,0,,Менің жүрегімде аз да болса тілек бар.
Dialogue: 6,0:12:19.03,0:12:23.52,Insert - CN,,0,0,0,,Менің де өсіп, мүсін алуыма көп уақыт бар.
Dialogue: 6,0:12:23.52,0:12:29.65,Insert - CN,,0,0,0,,Жас кезіңде болашақта тағы да емделесің.
Dialogue: 5,0:11:26.67,0:11:31.00,Insert - JP,,0,0,0,,Әй, бүгін әлі біткен жоқ.
Dialogue: 5,0:11:31.00,0:11:36.59,Insert - JP,,0,0,0,,Ине тиеді, бірақ менің ұйқым келмейді
Dialogue: 5,0:11:36.59,0:11:41.14,Insert - JP,,0,0,0,,Таң болмаса
Dialogue: 5,0:11:41.14,0:11:46.44,Insert - JP,,0,0,0,,Дөңгеленген арқам қайтадан кішірейеді.
Dialogue: 5,0:11:46.83,0:11:51.82,Insert - JP,,0,0,0,,Мен үнемі бір бұрышқа тығылып, мұхит жасап жүретінмін
Dialogue: 5,0:11:51.82,0:11:57.02,Insert - JP,,0,0,0,,Мен тамаша кейіпкер сияқты бола алмаймын.
Dialogue: 5,0:11:57.02,0:12:02.08,Insert - JP,,0,0,0,,Ауылдың мұндай адамдарына мен ештеңе істей алмаймын.
Dialogue: 5,0:12:02.08,0:12:07.94,Insert - JP,,0,0,0,,Ең болмаса мына теңізде жүзуге рұқсат етіңіз
Dialogue: 5,0:12:08.74,0:12:13.30,Insert - JP,,0,0,0,,Жаңбыр көп жауса да күлемін
Dialogue: 5,0:12:13.30,0:12:19.03,Insert - JP,,0,0,0,,Мен сені қызғанамын.
Dialogue: 5,0:12:19.03,0:12:23.52,Insert - JP,,0,0,0,,Мен де сіз сияқты бірте-бірте күшейіп келемін.
Dialogue: 5,0:12:23.52,0:12:29.65,Insert - JP,,0,0,0,,Бір күні алыс жерде кездессек, қол бұлғаңыз.
Dialogue: 6,0:29:46.22,0:29:51.48,Insert - CN,,0,0,0,,...
Dialogue: 6,0:29:51.76,0:30:00.20,Insert - CN,,0,0,0,,Адасып кеткен бала, шақырған бала, армандай аспан
Dialogue: 6,0:30:02.28,0:30:06.99,Insert - CN,,0,0,0,,Нари - Нари
Dialogue: 6,0:30:06.99,0:30:13.14,Insert - CN,,0,0,0,,Батареяның қызмет ету мерзімі, станцияға келуді күту және т.б., кеш
Dialogue: 6,0:30:13.14,0:30:23.41,Insert - CN,,0,0,0,,Шебердің иесі – ұлы махаббат иесі.
Dialogue: 6,0:30:24.01,0:30:26.65,Insert - CN,,0,0,0,,Секіру биі
Dialogue: 6,0:30:26.65,0:30:29.62,Insert - CN,,0,0,0,,Бірінен соң бірі
Dialogue: 6,0:30:29.62,0:30:34.85,Insert - CN,,0,0,0,,...
Dialogue: 6,0:30:34.85,0:30:39.11,Insert - CN,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 5,0:29:46.22,0:29:51.48,Insert - JP,,0,0,0,,Айырмашылық іздеп кеш тұру О, қызық екен
Dialogue: 5,0:29:51.76,0:30:00.20,Insert - JP,,0,0,0,,Адасып кеткен бала арман еліне шақырады
Dialogue: 5,0:30:02.28,0:30:06.99,Insert - JP,,0,0,0,,Бұл қайсысы?
Dialogue: 5,0:30:06.99,0:30:13.14,Insert - JP,,0,0,0,,Батареямен өмір, той жасайық күтеміз
Dialogue: 5,0:30:13.14,0:30:23.41,Insert - JP,,0,0,0,,Барша филантроптарға жарайсың.
Dialogue: 5,0:30:24.01,0:30:26.65,Insert - JP,,0,0,0,,Айналып билейміз
Dialogue: 5,0:30:26.65,0:30:29.62,Insert - JP,,0,0,0,,жабысқақ жабысқақ
Dialogue: 5,0:30:29.62,0:30:34.85,Insert - JP,,0,0,0,,Өтірікке толы тост алғыңыз келе ме?
Dialogue: 5,0:30:34.85,0:30:39.11,Insert - JP,,0,0,0,,Мен жалғыз елеспін
Dialogue: 6,0:40:21.34,0:40:26.63,Insert - CN,,0,0,0,,Үздіксіз басып шығарудың күнделікті өмірі
Dialogue: 6,0:40:26.63,0:40:31.83,Insert - CN,,0,0,0,,Ыстық қақпа әнінің мәтіні
Dialogue: 6,0:40:31.83,0:40:36.44,Insert - CN,,0,0,0,,Бірақ бұл шындық. Бұл жалған.
Dialogue: 6,0:40:36.44,0:40:42.13,Insert - CN,,0,0,0,,Бұл тұрарлық емес.
Dialogue: 6,0:40:42.25,0:40:54.30,Insert - CN,,0,0,0,,Менің жеке құпия базам
Dialogue: 6,0:40:54.30,0:41:00.42,Insert - CN,,0,0,0,,Бір адам айқайлап айқайлап айқайлайды
Dialogue: 6,0:41:00.42,0:41:05.37,Insert - CN,,0,0,0,,Әлсіз, жеңіл дауыс.
Dialogue: 6,0:41:05.37,0:41:07.94,Insert - CN,,0,0,0,,...
Dialogue: 6,0:41:07.94,0:41:16.00,Insert - CN,,0,0,0,,Бейнесіз құмарлық, үнемі шаншып ауыру
Dialogue: 6,0:41:16.00,0:41:20.44,Insert - CN,,0,0,0,,Шығыс пен Батыстың махаббат жырлары
Dialogue: 6,0:41:31.40,0:41:33.80,Insert - CN,,0,0,0,,...
Dialogue: 5,0:40:21.34,0:40:26.63,Insert - JP,,0,0,0,,Күнделікті сырғыту
Dialogue: 5,0:40:26.63,0:40:31.83,Insert - JP,,0,0,0,,Мен тіпті сөзін де білмейтін ән танымал.
Dialogue: 5,0:40:31.83,0:40:36.44,Insert - JP,,0,0,0,,Нақты немесе жалған деген не?
Dialogue: 5,0:40:36.44,0:40:42.13,Insert - JP,,0,0,0,,Маңызды емес, махаббат деген не?
Dialogue: 5,0:40:42.25,0:40:54.30,Insert - JP,,0,0,0,,Шураба да оянбайды, бұл менің өзімнің құпия базам
Dialogue: 5,0:40:54.30,0:41:00.42,Insert - JP,,0,0,0,,Жалғыз-ақ айқайладым
Dialogue: 5,0:41:00.42,0:41:05.37,Insert - JP,,0,0,0,,Мен кішкентай, бірақ үлкен дауыспен күресіп жаттым.
Dialogue: 5,0:41:05.37,0:41:07.94,Insert - JP,,0,0,0,,Әй, маған ұнамайды, маған ұнамайды, маған ұнамайды.
Dialogue: 5,0:41:07.94,0:41:16.00,Insert - JP,,0,0,0,,Тоқтамайтын, ауыртпайтын пішінсіз құмарлық
Dialogue: 5,0:41:16.00,0:41:20.44,Insert - JP,,0,0,0,,Енді махаббат әндері жоқ
Dialogue: 5,0:41:31.40,0:41:33.80,Insert - JP,,0,0,0,,Әй, маған ұнамайды, маған ұнамайды, маған ұнамайды.
Dialogue: 6,0:55:44.85,0:55:47.48,Insert - CN,,0,0,0,,Олардың барлығы қолжетімді.
Dialogue: 6,0:55:47.48,0:55:50.09,Insert - CN,,0,0,0,,Шаршау сезімі
Dialogue: 6,0:55:50.09,0:55:54.22,Insert - CN,,0,0,0,,Күннің шығуы
Dialogue: 6,0:55:55.32,0:55:57.89,Insert - CN,,0,0,0,,Шексіз пойыз
Dialogue: 6,0:55:57.89,0:56:00.57,Insert - CN,,0,0,0,,Жедел пойыз
Dialogue: 6,0:56:00.57,0:56:05.55,Insert - CN,,0,0,0,,...
Dialogue: 6,0:56:05.55,0:56:08.34,Insert - CN,,0,0,0,,「」
Dialogue: 6,0:56:08.34,0:56:10.93,Insert - CN,,0,0,0,,Ең дұрыс жауап?
Dialogue: 6,0:56:11.44,0:56:15.94,Insert - CN,,0,0,0,,Әннің негізгі нұсқасы
Dialogue: 6,0:56:15.94,0:56:21.23,Insert - CN,,0,0,0,,Көк түсті көктемгі аспан
Dialogue: 6,0:56:21.23,0:56:26.36,Insert - CN,,0,0,0,,Йога бір нүкте және сәйкес емес
Dialogue: 6,0:56:26.36,0:56:31.74,Insert - CN,,0,0,0,,Бірден жеткізу, сонымен қатар қысқа мерзімде білім
Dialogue: 6,0:56:31.74,0:56:36.91,Insert - CN,,0,0,0,,Жүктілік туралы қысқаша арман
Dialogue: 6,0:56:36.91,0:56:39.70,Insert - CN,,0,0,0,,Мен бұрын-соңды кездескен емеспін.
Dialogue: 6,0:56:39.70,0:56:42.42,Insert - CN,,0,0,0,,Өлмес бұрын менде бірнеше естеліктер бар
Dialogue: 6,0:56:42.42,0:56:47.43,Insert - CN,,0,0,0,,``Бұрын мен мұнда бұрын болғанмын'' Мұны қалай айту керек
Dialogue: 6,0:56:57.77,0:57:03.11,Insert - CN,,0,0,0,,Бірден жеткізу, ессіздік, рахат және күйреу
Dialogue: 6,0:57:03.11,0:57:08.24,Insert - CN,,0,0,0,,Жерді бекіту
Dialogue: 6,0:57:08.24,0:57:13.49,Insert - CN,,0,0,0,,Өткеннің үні естілді деген сөз жоқ.
Dialogue: 6,0:57:13.49,0:57:18.78,Insert - CN,,0,0,0,,Бұл сыныптың ішкі талғамы.
Dialogue: 6,0:57:18.78,0:57:21.39,Insert - CN,,0,0,0,,Мен бұрын-соңды кездескен емеспін.
Dialogue: 6,0:57:21.39,0:57:24.16,Insert - CN,,0,0,0,,Өлмес бұрын менде бірнеше естеліктер бар
Dialogue: 6,0:57:24.16,0:57:29.47,Insert - CN,,0,0,0,,``Бұрын мен мұнда бұрын болғанмын'' Мұны қалай айту керек
Dialogue: 5,0:55:44.85,0:55:47.48,Insert - JP,,0,0,0,,Мұның бәрі ауа райына байланысты.
Dialogue: 5,0:55:47.48,0:55:50.09,Insert - JP,,0,0,0,,Бұл ыңғайсыздық пен шаршау
Dialogue: 5,0:55:50.09,0:55:54.22,Insert - JP,,0,0,0,,Күн жасырын, бірақ белгісіз
Dialogue: 5,0:55:55.32,0:55:57.89,Insert - JP,,0,0,0,,Толып жатқан пойыздың шайқалуы
Dialogue: 5,0:55:57.89,0:56:00.57,Insert - JP,,0,0,0,,Бірінен-бірі өтіп бара жатқан пойыз жартылай жүріс пойыз.
Dialogue: 5,0:56:00.57,0:56:05.55,Insert - JP,,0,0,0,,Контурсыз бұлттың өрнегін іздеңіз
Dialogue: 5,0:56:05.55,0:56:08.34,Insert - JP,,0,0,0,,«Автордың сезіміне жауап беріңізші?»
Dialogue: 5,0:56:08.34,0:56:10.93,Insert - JP,,0,0,0,,Жер бетінде қандай жауап дұрыс?
Dialogue: 5,0:56:11.44,0:56:15.94,Insert - JP,,0,0,0,,Алдын ала белгіленген үйлесімділік сценарийінен шығу
Dialogue: 5,0:56:15.94,0:56:21.23,Insert - JP,,0,0,0,,Көк бұлақ дегеніміз не?
Dialogue: 5,0:56:21.23,0:56:26.36,Insert - JP,,0,0,0,,Бұл маған сәйкес келмейді
Dialogue: 5,0:56:26.36,0:56:31.74,Insert - JP,,0,0,0,,Дегенмен, мен бұл сәттің тек бір рет болатынын білемін
Dialogue: 5,0:56:31.74,0:56:36.91,Insert - JP,,0,0,0,,Өтпелілігі бар
Dialogue: 5,0:56:36.91,0:56:39.70,Insert - JP,,0,0,0,,Мен оны ешқашан ұмытпаймын
Dialogue: 5,0:56:39.70,0:56:42.42,Insert - JP,,0,0,0,,Бір күні өлгенше қанша рет болса да
Dialogue: 5,0:56:42.42,0:56:47.43,Insert - JP,,0,0,0,,``Осындай нәрсе болғанымен'', күлмеңіз.
Dialogue: 5,0:56:57.77,0:57:03.11,Insert - JP,,0,0,0,,Мен өзімді жел ұшырып кететіндей сезінемін
Dialogue: 5,0:57:03.11,0:57:08.24,Insert - JP,,0,0,0,,Шарасыз тамақ ішу
Dialogue: 5,0:57:08.24,0:57:13.49,Insert - JP,,0,0,0,,Кәдімгі қоңырау үні мен терезенің жанына үйілген шаң
Dialogue: 5,0:57:13.49,0:57:18.78,Insert - JP,,0,0,0,,Тіпті сыныптың иісі
Dialogue: 5,0:57:18.78,0:57:21.39,Insert - JP,,0,0,0,,Мен оны ешқашан ұмытпаймын
Dialogue: 5,0:57:21.39,0:57:24.16,Insert - JP,,0,0,0,,Бір күні өлгенше қанша рет болса да
Dialogue: 5,0:57:24.16,0:57:29.47,Insert - JP,,0,0,0,,``Осындай нәрсе болғанымен'', күлмеңіз.
Dialogue: 6,0:59:27.11,0:59:30.50,Insert - CN,,0,0,0,,6 ұпайға жету үшін қажетті уақыт
Dialogue: 6,0:59:31.12,0:59:34.09,Insert - CN,,0,0,0,,Бірінші планета кенеттен пайда болады
Dialogue: 6,0:59:34.41,0:59:42.51,Insert - CN,,0,0,0,,Лак-қара түннің лак-қара түні
Dialogue: 6,0:59:44.56,0:59:52.34,Insert - CN,,0,0,0,,Шын махаббат, үй иесін сүйесің.
Dialogue: 6,0:59:52.34,0:59:59.78,Insert - CN,,0,0,0,,«Мен жалғызбын және жалғызбын».
Dialogue: 6,0:59:59.78,1:00:03.79,Insert - CN,,0,0,0,,...
Dialogue: 6,1:00:03.79,1:00:08.44,Insert - CN,,0,0,0,,Берекелі жұлдыз түскен түн, өткінші тілек
Dialogue: 6,1:00:08.71,1:00:15.50,Insert - CN,,0,0,0,,Сигнал эфирге қойылғанда
Dialogue: 6,1:00:15.50,1:00:19.29,Insert - CN,,0,0,0,,...
Dialogue: 6,1:00:19.29,1:00:24.06,Insert - CN,,0,0,0,,Басқа біреуге, жерге бағытталған шоқжұлдызға қарап тұрған жұлдызды аспанды елестету
Dialogue: 6,1:00:24.26,1:00:28.22,Insert - CN,,0,0,0,,Бізбен байланысудың қажеті жоқ.
Dialogue: 6,1:00:28.22,1:00:33.19,Insert - CN,,0,0,0,,Менің көзіме еш күмәнім жоқ
Dialogue: 6,1:01:02.81,1:01:08.75,Insert - CN,,0,0,0,,Біз бір-бірімізден алшақпыз.
Dialogue: 6,1:01:10.73,1:01:16.58,Insert - CN,,0,0,0,,Бұл біздің тағдырымыз болғандықтан, біздің генералдарымыз бірнеше рет өзара әрекеттеседі.
Dialogue: 6,1:01:17.95,1:01:21.32,Insert - CN,,0,0,0,,...
Dialogue: 6,1:01:22.81,1:01:26.73,Insert - CN,,0,0,0,,...
Dialogue: 6,1:01:26.73,1:01:31.39,Insert - CN,,0,0,0,,Қара түнгі аспанды кеңейту
Dialogue: 6,1:01:31.61,1:01:38.41,Insert - CN,,0,0,0,,Сізге дереу жеткізу
Dialogue: 6,1:01:38.41,1:01:42.39,Insert - CN,,0,0,0,,Мені сен және сенің серігің туралы ойландырған шоқжұлдыз
Dialogue: 6,1:01:42.39,1:01:46.68,Insert - CN,,0,0,0,,Жарқыраған жарықтың шашыраңқы ағындары
Dialogue: 6,1:01:47.14,1:01:51.06,Insert - CN,,0,0,0,,Бізбен байланысудың қажеті жоқ.
Dialogue: 6,1:01:51.06,1:01:56.39,Insert - CN,,0,0,0,,Сенің көзіңе күмән жоқ
Dialogue: 5,0:59:27.11,0:59:30.50,Insert - JP,,0,0,0,,Сағат 6-ға таяп қалды.
Dialogue: 5,0:59:31.12,0:59:34.09,Insert - JP,,0,0,0,,Бірінші жұлдыз қазірдің өзінде бар
Dialogue: 5,0:59:34.41,0:59:42.51,Insert - JP,,0,0,0,,Көлеңкеге қадам басып, үйге бара жатқанда түнде жоғалып кеткім келеді
Dialogue: 5,0:59:44.56,0:59:52.34,Insert - JP,,0,0,0,,Жақсы, сені бәрі жақсы көреді.
Dialogue: 5,0:59:52.34,0:59:59.78,Insert - JP,,0,0,0,,«Жоқ, мен әрқашан жалғыз боламын».
Dialogue: 5,0:59:59.78,1:00:03.79,Insert - JP,,0,0,0,,Сенімен жиналып, шоқжұлдыз болып кетсем
Dialogue: 5,1:00:03.79,1:00:08.44,Insert - JP,,0,0,0,,Жұлдызды түндегі бір сәттік тілек
Dialogue: 5,1:00:08.71,1:00:15.50,Insert - JP,,0,0,0,,Жарқыраған, жыпылықтаған, дірілдеген сигнал
Dialogue: 5,1:00:15.50,1:00:19.29,Insert - JP,,0,0,0,,Сенімен жиналып, шоқжұлдыз болып кетсем
Dialogue: 5,1:00:19.29,1:00:24.06,Insert - JP,,0,0,0,,Аспанға қарасам, маған біреу нұсқап тұрғандай
Dialogue: 5,1:00:24.26,1:00:28.22,Insert - JP,,0,0,0,,Қосылған сызықтарды шешпеңіз
Dialogue: 5,1:00:28.22,1:00:33.19,Insert - JP,,0,0,0,,Қанша тамсандырсам да
Dialogue: 5,1:01:02.81,1:01:08.75,Insert - JP,,0,0,0,,Алыста кездесіп қалдық
Dialogue: 5,1:01:10.73,1:01:16.58,Insert - JP,,0,0,0,,Бұл карма болғандықтан, біз қайта-қайта кездесеміз.
Dialogue: 5,1:01:17.95,1:01:21.32,Insert - JP,,0,0,0,,Бұлттардың арасындағы аралықта
Dialogue: 5,1:01:22.81,1:01:26.73,Insert - JP,,0,0,0,,Сенімен жиналып, шоқжұлдыз болып кетсем
Dialogue: 5,1:01:26.73,1:01:31.39,Insert - JP,,0,0,0,,Түнді жайып, аспанның суретін салайық
Dialogue: 5,1:01:31.61,1:01:38.41,Insert - JP,,0,0,0,,Қараңғылықты нұрландыратын толық ай болмаса да
Dialogue: 5,1:01:38.41,1:01:42.39,Insert - JP,,0,0,0,,Сондықтан мен жиналып, шоқжұлдыз болғым келеді.
Dialogue: 5,1:01:42.39,1:01:46.68,Insert - JP,,0,0,0,,Түрлі-түсті жарық шығаратын сияқты
Dialogue: 5,1:01:47.14,1:01:51.06,Insert - JP,,0,0,0,,Қосылған жолдарды аша алмаймын
Dialogue: 5,1:01:51.06,1:01:56.39,Insert - JP,,0,0,0,,Қаншалықты тамсандыратын болсаң да
Dialogue: 6,1:06:34.80,1:06:38.53,Insert - CN,,0,0,0,,Тамыз ай аспаны
Dialogue: 6,1:06:38.53,1:06:42.23,Insert - CN,,0,0,0,,Бейненің тақырыбы кім?
Dialogue: 6,1:06:42.23,1:06:48.75,Insert - CN,,0,0,0,,Құстың даусы құлағыма жетті.
Dialogue: 6,1:06:49.69,1:06:53.30,Insert - CN,,0,0,0,,T
Dialogue: 6,1:06:53.30,1:06:57.08,Insert - CN,,0,0,0,,Пойыз орталығындағы Йонин тобы
Dialogue: 6,1:06:57.08,1:07:03.19,Insert - CN,,0,0,0,,Пойыз пойызда болғанда
Dialogue: 6,1:07:03.19,1:07:08.06,Insert - CN,,0,0,0,,Отты құстай боялған
Dialogue: 6,1:07:08.06,1:07:11.04,Insert - CN,,0,0,0,,Нишику йогасы
Dialogue: 6,1:07:11.04,1:07:19.74,Insert - CN,,0,0,0,,Ауада ұшуға арналған шағылыстыратын жарық шоғы
Dialogue: 6,1:07:22.84,1:07:26.52,Insert - CN,,0,0,0,,Бірінші орынбасардың табиғи көрінісі
Dialogue: 6,1:07:26.52,1:07:30.20,Insert - CN,,0,0,0,,Тест тапсыру әрекеті
Dialogue: 6,1:07:30.20,1:07:33.92,Insert - CN,,0,0,0,,Намидо Мухи тәтті бал Кайо Шога балқыту
Dialogue: 6,1:07:33.92,1:07:37.70,Insert - CN,,0,0,0,,Алайда химиялық токсин
Dialogue: 6,1:07:37.70,1:07:41.32,Insert - CN,,0,0,0,,Үздіксіз кеңейтілген көлеңке
Dialogue: 6,1:07:41.32,1:07:45.00,Insert - CN,,0,0,0,,Үйге оралу
Dialogue: 6,1:07:45.00,1:07:51.34,Insert - CN,,0,0,0,,Дүние осындай кішкентай.
Dialogue: 5,1:06:34.80,1:06:38.53,Insert - JP,,0,0,0,,Тамыздағы көк аспан
Dialogue: 5,1:06:38.53,1:06:42.23,Insert - JP,,0,0,0,,Араластыру сияқты
Dialogue: 5,1:06:42.23,1:06:48.75,Insert - JP,,0,0,0,,Мен ұшқан құстардың сайрағанын естідім.
Dialogue: 5,1:06:49.69,1:06:53.30,Insert - JP,,0,0,0,,Терлеген футболка
Dialogue: 5,1:06:53.30,1:06:57.08,Insert - JP,,0,0,0,,Ортасынан шымшу
Dialogue: 5,1:06:57.08,1:07:03.19,Insert - JP,,0,0,0,,Желді оятып, пойыз шайқасын
Dialogue: 5,1:07:03.19,1:07:08.06,Insert - JP,,0,0,0,,Қоқиқаз түсіне боялған
Dialogue: 5,1:07:08.06,1:07:11.04,Insert - JP,,0,0,0,,Батыс аспан және мен
Dialogue: 5,1:07:11.04,1:07:19.74,Insert - JP,,0,0,0,,Ауада қалқып тұрған шаң жарқырап шағылысады.
Dialogue: 5,1:07:22.84,1:07:26.52,Insert - JP,,0,0,0,,Бұл анық сияқты
Dialogue: 5,1:07:26.52,1:07:30.20,Insert - JP,,0,0,0,,Көк бұлақты жеуге тырыстым
Dialogue: 5,1:07:30.20,1:07:33.92,Insert - JP,,0,0,0,,Тәтті болғаны сонша, еріп кете жаздады
Dialogue: 5,1:07:33.92,1:07:37.70,Insert - JP,,0,0,0,,Бірақ ол улы да болуы мүмкін.
Dialogue: 5,1:07:37.70,1:07:41.32,Insert - JP,,0,0,0,,Өсіп келе жатқан көлеңкеге басу
Dialogue: 5,1:07:41.32,1:07:45.00,Insert - JP,,0,0,0,,Тез үйге қайтайық.
Dialogue: 5,1:07:45.00,1:07:51.34,Insert - JP,,0,0,0,,Дүние кішкентай деген үлкен өтірік
