Dialogue: 0,0:07:35.79,0:07:40.16,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:07:35.79,0:07:40.16,Default,,0000,0000,0000,,Бұл осылай аталады.
Dialogue: 0,0:07:40.16,0:07:44.80,Default,,0000,0000,0000,,Сайкё
Dialogue: 0,0:07:40.16,0:07:44.80,Default,,0000,0000,0000,,Мадоши
Dialogue: 0,0:07:40.16,0:07:44.80,Default,,0000,0000,0000,,Ертегінің ең күшті сиқыршысы
Dialogue: 0,0:07:40.16,0:07:44.80,Default,,0000,0000,0000,,Тіпті Гилдарт...＞
Dialogue: 0,0:07:44.80,0:07:48.13,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:44.80,0:07:48.13,Default,,0000,0000,0000,,100 жылдық квест
Dialogue: 0,0:07:44.80,0:07:48.13,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:07:44.80,0:07:48.13,Default,,0000,0000,0000,,Бұл не туралы?
Dialogue: 0,0:07:48.13,0:07:50.47,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:07:48.13,0:07:50.47,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:48.13,0:07:50.47,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:07:48.13,0:07:50.47,Default,,0000,0000,0000,,Айтуға болмайды деген ереже.
Dialogue: 0,0:07:50.47,0:07:53.14,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:07:50.47,0:07:53.14,Default,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:07:50.47,0:07:53.14,Default,,0000,0000,0000,,Таши
Dialogue: 0,0:07:50.47,0:07:53.14,Default,,0000,0000,0000,,Келіңіздер, өзіңіз көріңіз.
Dialogue: 0,0:07:53.14,0:07:57.14,Default,,0000,0000,0000,,Зецубу
Dialogue: 0,0:07:53.14,0:07:57.14,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:07:53.14,0:07:57.14,Default,,0000,0000,0000,,Және үмітсіздіктен ләззат алыңыз.
Dialogue: 0,0:07:59.48,0:08:01.45,Default,,0000,0000,0000,,Атта!
Dialogue: 0,0:07:59.48,0:08:01.45,Default,,0000,0000,0000,,Уф… Бұған қуануым керек пе?
Dialogue: 0,0:08:01.45,0:08:04.12,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:08:01.45,0:08:04.12,Default,,0000,0000,0000,,Ең алдымен, сен—
Dialogue: 0,0:08:01.45,0:08:04.12,Default,,0000,0000,0000,,Керемет ойнау!
Dialogue: 0,0:08:04.12,0:08:07.12,Default,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:08:04.12,0:08:07.12,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:04.12,0:08:07.12,Default,,0000,0000,0000,,Толық
Dialogue: 0,0:08:04.12,0:08:07.12,Default,,0000,0000,0000,,Мен жалғыз барғандықтан сәтсіздікке ұшырадым.
Dialogue: 0,0:08:07.12,0:08:09.12,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:08:07.12,0:08:09.12,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:08:07.12,0:08:09.12,Default,,0000,0000,0000,,Мен емес.
Dialogue: 0,0:08:09.12,0:08:13.13,Default,,0000,0000,0000,,Достар
Dialogue: 0,0:08:09.12,0:08:13.13,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:09.12,0:08:13.13,Default,,0000,0000,0000,,Достармен барыңыз.
Dialogue: 0,0:08:09.12,0:08:13.13,Default,,0000,0000,0000,,Зецубу
Dialogue: 0,0:08:09.12,0:08:13.13,Default,,0000,0000,0000,,Сондықтан үмітіңізді үзбеңіз.
Dialogue: 0,0:08:13.13,0:08:15.46,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:08:15.46,0:08:18.13,Default,,0000,0000,0000,,болды
Dialogue: 0,0:08:15.46,0:08:18.13,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:08:15.46,0:08:18.13,Default,,0000,0000,0000,,Ой! Сен не істеп жатырсың?
Dialogue: 0,0:08:18.13,0:08:20.80,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:18.13,0:08:20.80,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:08:18.13,0:08:20.80,Default,,0000,0000,0000,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,0:08:18.13,0:08:20.80,Default,,0000,0000,0000,,Бұл ертегінің қайтарымы, бейбақ!
Dialogue: 0,0:08:20.80,0:08:23.14,Default,,0000,0000,0000,,Сәлем, Гилдартс!
Dialogue: 0,0:08:20.80,0:08:23.14,Default,,0000,0000,0000,,Джото
Dialogue: 0,0:08:20.80,0:08:23.14,Default,,0000,0000,0000,,Өте жақсы!
Dialogue: 0,0:08:23.14,0:08:25.44,Default,,0000,0000,0000,,Ей!
Dialogue: 0,0:08:23.14,0:08:25.44,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:08:23.14,0:08:25.44,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:08:23.14,0:08:25.44,Default,,0000,0000,0000,,Біреу тоқтатсын!
Dialogue: 0,0:08:25.44,0:08:27.77,Default,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:08:25.44,0:08:27.77,Default,,0000,0000,0000,,Гильдияны жоймаңыз!
Dialogue: 0,0:08:27.77,0:08:31.48,Default,,0000,0000,0000,,Магия Айдаһар.
Dialogue: 0,0:08:27.77,0:08:31.48,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:08:27.77,0:08:31.48,Default,,0000,0000,0000,,Мен келдім...
Dialogue: 0,0:08:31.48,0:08:36.15,Default,,0000,0000,0000,,Қараңдаршы, айдаһар бар!
Dialogue: 0,0:08:31.48,0:08:36.15,Default,,0000,0000,0000,,Секизо
Dialogue: 0,0:08:31.48,0:08:36.15,Default,,0000,0000,0000,,Бұл тас мүсін.
Dialogue: 0,0:08:36.15,0:08:39.12,Default,,0000,0000,0000,,Эй, бұл қандай гильдия?
Dialogue: 0,0:08:36.15,0:08:39.12,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:08:36.15,0:08:39.12,Default,,0000,0000,0000,,Әлі де адамдар бар ма?
Dialogue: 0,0:08:39.12,0:08:42.12,Default,,0000,0000,0000,,Егер жоқ болса
Dialogue: 0,0:08:39.12,0:08:42.12,Default,,0000,0000,0000,,Жұмыс
Dialogue: 0,0:08:39.12,0:08:42.12,Default,,0000,0000,0000,,Джучу
Dialogue: 0,0:08:39.12,0:08:42.12,Default,,0000,0000,0000,,Мен жұмысқа тапсырыстарды қабылдай алмаймын.
Dialogue: 0,0:08:48.13,0:08:51.46,Default,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:08:48.13,0:08:51.46,Default,,0000,0000,0000,,Иә? Ішінде эфир нано да бар.
Dialogue: 0,0:08:51.46,0:08:53.47,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:08:51.46,0:08:53.47,Default,,0000,0000,0000,,Мұнда ешкім жоқ.
Dialogue: 0,0:08:53.47,0:08:55.80,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:08:53.47,0:08:55.80,Default,,0000,0000,0000,,Жоқ, осылай...
Dialogue: 0,0:08:55.80,0:08:57.84,Default,,0000,0000,0000,,Иә, мен.
Dialogue: 0,0:08:57.84,0:08:59.91,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:08:57.84,0:08:59.91,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:08:59.91,0:09:02.28,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:04.48,0:09:09.15,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:09:04.48,0:09:09.15,Default,,0000,0000,0000,,Банме
Dialogue: 0,0:09:04.48,0:09:09.15,Default,,0000,0000,0000,,Юуша
Dialogue: 0,0:09:04.48,0:09:09.15,Default,,0000,0000,0000,,Қош келдіңіз, 99-шы батыр.
Dialogue: 0,0:09:09.15,0:09:11.55,Default,,0000,0000,0000,,Йонин
Dialogue: 0,0:09:09.15,0:09:11.55,Default,,0000,0000,0000,,Айдаһар! ?
Dialogue: 0,0:09:11.55,0:09:15.45,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:11.55,0:09:15.45,Default,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:09:11.55,0:09:15.45,Default,,0000,0000,0000,,Тірі қалғандар бар ма?
Dialogue: 0,0:09:11.55,0:09:15.45,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:09:15.45,0:09:19.49,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:09:15.45,0:09:19.49,Default,,0000,0000,0000,,На
Dialogue: 0,0:09:15.45,0:09:19.49,Default,,0000,0000,0000,,Хорюу
Dialogue: 0,0:09:15.45,0:09:19.49,Default,,0000,0000,0000,,Менің атым заң айдаһары Элефтерия.
Dialogue: 0,0:09:19.49,0:09:23.46,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:09:19.49,0:09:23.46,Default,,0000,0000,0000,,Теріс
Dialogue: 0,0:09:19.49,0:09:23.46,Default,,0000,0000,0000,,Джожу
Dialogue: 0,0:09:19.49,0:09:23.46,Default,,0000,0000,0000,,Мадоши
Dialogue: 0,0:09:19.49,0:09:23.46,Default,,0000,0000,0000,,Тілегімді орында, сиқыршы.
Dialogue: 0,0:09:23.46,0:09:25.50,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:09:23.46,0:09:25.50,Default,,0000,0000,0000,,(иісті дыбыс)
Dialogue: 0,0:09:25.50,0:09:30.14,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:09:25.50,0:09:30.14,Default,,0000,0000,0000,,...
Dialogue: 0,0:09:25.50,0:09:30.14,Default,,0000,0000,0000,,Ит балық
Dialogue: 0,0:09:25.50,0:09:30.14,Default,,0000,0000,0000,,Сіз 100 жылдық квест сұраған адамсыз ба?
Dialogue: 0,0:09:25.50,0:09:30.14,Default,,0000,0000,0000,,Шынымен.
Dialogue: 0,0:09:30.14,0:09:35.54,Default,,0000,0000,0000,,Абайлаңыз
Dialogue: 0,0:09:30.14,0:09:35.54,Default,,0000,0000,0000,,Кучо
Dialogue: 0,0:09:30.14,0:09:35.54,Default,,0000,0000,0000,,Қара, Нацу, сыпайы бол.
Dialogue: 0,0:09:30.14,0:09:35.54,Default,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:09:30.14,0:09:35.54,Default,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:09:30.14,0:09:35.54,Default,,0000,0000,0000,,Әңгімелесейік. Мен қорқып тұрмын.
Dialogue: 0,0:09:35.54,0:09:37.81,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:09:35.54,0:09:37.81,Default,,0000,0000,0000,,Какунин
Dialogue: 0,0:09:35.54,0:09:37.81,Default,,0000,0000,0000,,Мен бір нәрсені растағым келеді.
Dialogue: 0,0:09:37.81,0:09:43.22,Default,,0000,0000,0000,,Мадоши
Dialogue: 0,0:09:37.81,0:09:43.22,Default,,0000,0000,0000,,Бұл сиқыршылар гильдиясы болуы керек, бірақ...
Dialogue: 0,0:09:37.81,0:09:43.22,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:09:37.81,0:09:43.22,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:09:37.81,0:09:43.22,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:09:43.22,0:09:45.22,Default,,0000,0000,0000,,Мадоши
Dialogue: 0,0:09:43.22,0:09:45.22,Default,,0000,0000,0000,,Сиқыршылар гильдиясына
Dialogue: 0,0:09:43.22,0:09:45.22,Default,,0000,0000,0000,,Мадоши
Dialogue: 0,0:09:43.22,0:09:45.22,Default,,0000,0000,0000,,Сиқыршы жоқ➡
Dialogue: 0,0:09:45.22,0:09:47.12,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:09:45.22,0:09:47.12,Default,,0000,0000,0000,,Маған қызық.
Dialogue: 0,0:09:47.12,0:09:49.82,Default,,0000,0000,0000,,және т.б.
Dialogue: 0,0:09:47.12,0:09:49.82,Default,,0000,0000,0000,,Мадоши
Dialogue: 0,0:09:47.12,0:09:49.82,Default,,0000,0000,0000,,Басқа шеберлер бар ма?
Dialogue: 0,0:09:49.82,0:09:55.83,Default,,0000,0000,0000,,I
Dialogue: 0,0:09:49.82,0:09:55.83,Default,,0000,0000,0000,,Мұнда жалғыз мен ғанамын
Dialogue: 0,0:09:49.82,0:09:55.83,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:09:49.82,0:09:55.83,Default,,0000,0000,0000,,Мина
Dialogue: 0,0:09:49.82,0:09:55.83,Default,,0000,0000,0000,,О.
Dialogue: 0,0:09:49.82,0:09:55.83,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:09:49.82,0:09:55.83,Default,,0000,0000,0000,,Барлық адамдар қартайып өлді.
Dialogue: 0,0:09:55.83,0:09:59.83,Default,,0000,0000,0000,,О.
Dialogue: 0,0:09:55.83,0:09:59.83,Default,,0000,0000,0000,,Орын
Dialogue: 0,0:09:55.83,0:09:59.83,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:09:55.83,0:09:59.83,Default,,0000,0000,0000,,Қартайсаң... жаңа біреу керек.
Dialogue: 0,0:09:55.83,0:09:59.83,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:55.83,0:09:59.83,Default,,0000,0000,0000,,Сіз кірген жоқсыз ба?
Dialogue: 0,0:09:59.83,0:10:01.83,Default,,0000,0000,0000,,Тауық
Dialogue: 0,0:09:59.83,0:10:01.83,Default,,0000,0000,0000,,Қандай оғаш гильдия.
Dialogue: 0,0:10:01.83,0:10:03.84,Default,,0000,0000,0000,,Джидай
Dialogue: 0,0:10:01.83,0:10:03.84,Default,,0000,0000,0000,,Бұл күндер еді.
Dialogue: 0,0:10:03.84,0:10:09.48,Default,,0000,0000,0000,,Орын
Dialogue: 0,0:10:03.84,0:10:09.48,Default,,0000,0000,0000,,Бірінен соң бірі
Dialogue: 0,0:10:03.84,0:10:09.48,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:10:03.84,0:10:09.48,Default,,0000,0000,0000,,Жаңа гильдиялар бірінен соң бірі дүниеге келеді
Dialogue: 0,0:10:03.84,0:10:09.48,Default,,0000,0000,0000,,Вакамоно
Dialogue: 0,0:10:03.84,0:10:09.48,Default,,0000,0000,0000,,Орын
Dialogue: 0,0:10:03.84,0:10:09.48,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,0:10:03.84,0:10:09.48,Default,,0000,0000,0000,,Жастар жаңа гильдияларға жиналады.
Dialogue: 0,0:10:09.48,0:10:13.81,Default,,0000,0000,0000,,Dice
Dialogue: 0,0:10:09.48,0:10:13.81,Default,,0000,0000,0000,,Ақырында, ең көне гильдия
Dialogue: 0,0:10:09.48,0:10:13.81,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:10:09.48,0:10:13.81,Default,,0000,0000,0000,,Ылғау
