Dialogue: 0,0:18:52.87,0:18:54.87,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:18:52.87,0:18:54.87,Default,,0000,0000,0000,,Бірақ мен бұған мүлдем шыдай алмаймын➡
Dialogue: 0,0:18:54.87,0:18:58.10,Default,,0000,0000,0000,,Гошинрю
Dialogue: 0,0:18:54.87,0:18:58.10,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:18:54.87,0:18:58.10,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:18:54.87,0:18:58.10,Default,,0000,0000,0000,,Кім бес құдайлық айдаһарды жеңе алады
Dialogue: 0,0:18:54.87,0:18:58.10,Default,,0000,0000,0000,,О, құдайым
Dialogue: 0,0:18:54.87,0:18:58.10,Default,,0000,0000,0000,,Шин
Dialogue: 0,0:18:54.87,0:18:58.10,Default,,0000,0000,0000,,Оның пайда болатынына сеніңіз➡
Dialogue: 0,0:18:58.10,0:19:01.77,Default,,0000,0000,0000,,Оны квест жасады.
Dialogue: 0,0:19:01.77,0:19:05.44,Default,,0000,0000,0000,,Балалар үйі
Dialogue: 0,0:19:01.77,0:19:05.44,Default,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:19:01.77,0:19:05.44,Default,,0000,0000,0000,,Бұл 100 жылдан астам уақыт бұрын болды＞
Dialogue: 0,0:19:05.44,0:19:09.11,Default,,0000,0000,0000,,Гошинрю
Dialogue: 0,0:19:05.44,0:19:09.11,Default,,0000,0000,0000,,Ибашо
Dialogue: 0,0:19:05.44,0:19:09.11,Default,,0000,0000,0000,,Барлық бес айдаһар қайда?
Dialogue: 0,0:19:05.44,0:19:09.11,Default,,0000,0000,0000,,Мен білмеймін➡
Dialogue: 0,0:19:09.11,0:19:13.12,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:19:09.11,0:19:13.12,Default,,0000,0000,0000,,Солардың бірі
Dialogue: 0,0:19:09.11,0:19:13.12,Default,,0000,0000,0000,,Сүйджинрю
Dialogue: 0,0:19:09.11,0:19:13.12,Default,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:19:09.11,0:19:13.12,Default,,0000,0000,0000,,Су құдайы Айдаһар Мелкфобия туралы білгіңіз келсе➡
Dialogue: 0,0:19:13.12,0:19:15.09,Default,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:19:13.12,0:19:15.09,Default,,0000,0000,0000,,қалады.
Dialogue: 0,0:19:15.09,0:19:20.09,Default,,0000,0000,0000,,Чихо
Dialogue: 0,0:19:15.09,0:19:20.09,Default,,0000,0000,0000,,Бір нәрсе
Dialogue: 0,0:19:15.09,0:19:20.09,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:19:15.09,0:19:20.09,Default,,0000,0000,0000,,Валерия аймағында оңтүстік-батысқа қарай
Dialogue: 0,0:19:15.09,0:19:20.09,Default,,0000,0000,0000,,Минато қаласы
Dialogue: 0,0:19:15.09,0:19:20.09,Default,,0000,0000,0000,,Эльмина деген порттық қала бар.
Dialogue: 0,0:19:20.09,0:19:24.43,Default,,0000,0000,0000,,Қала
Dialogue: 0,0:19:20.09,0:19:24.43,Default,,0000,0000,0000,,Бұл қала бұрын болған
Dialogue: 0,0:19:20.09,0:19:24.43,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:19:20.09,0:19:24.43,Default,,0000,0000,0000,,Мацу
Dialogue: 0,0:19:20.09,0:19:24.43,Default,,0000,0000,0000,,Мелкфобия құдайға табынатын.
Dialogue: 0,0:19:24.43,0:19:27.10,Default,,0000,0000,0000,,Бұл Эльмина, жарайды!
Dialogue: 0,0:19:27.10,0:19:30.44,Default,,0000,0000,0000,,Қорытынды
Dialogue: 0,0:19:27.10,0:19:30.44,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:19:27.10,0:19:30.44,Default,,0000,0000,0000,,Хошу
Dialogue: 0,0:19:27.10,0:19:30.44,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:19:27.10,0:19:30.44,Default,,0000,0000,0000,,Өтемақы туралы соңғы бір нәрсе.
Dialogue: 0,0:19:27.10,0:19:30.44,Default,,0000,0000,0000,,О!
Dialogue: 0,0:19:30.44,0:19:33.07,Default,,0000,0000,0000,,Васу
Dialogue: 0,0:19:30.44,0:19:33.07,Default,,0000,0000,0000,,О! Иә, ұмытып қалдым.
Dialogue: 0,0:19:33.07,0:19:35.11,Default,,0000,0000,0000,,Қанша?
Dialogue: 0,0:19:35.11,0:19:38.08,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:19:35.11,0:19:38.08,Default,,0000,0000,0000,,Бір нәрсе...
Dialogue: 0,0:19:35.11,0:19:38.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:38.08,0:19:40.75,Default,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:19:38.08,0:19:40.75,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:19:38.08,0:19:40.75,Default,,0000,0000,0000,,Ata
Dialogue: 0,0:19:38.08,0:19:40.75,Default,,0000,0000,0000,,Қалағаныңды беремін.
Dialogue: 0,0:19:40.75,0:19:44.42,Default,,0000,0000,0000,,Барлық түрлері
Dialogue: 0,0:19:40.75,0:19:44.42,Default,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:19:40.75,0:19:44.42,Default,,0000,0000,0000,,Барлық нәрселерден➡
Dialogue: 0,0:19:44.42,0:19:47.12,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:19:44.42,0:19:47.12,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:19:44.42,0:19:47.12,Default,,0000,0000,0000,,Ata
Dialogue: 0,0:19:44.42,0:19:47.12,Default,,0000,0000,0000,,Мен саған барлығының бірін беремін.
Dialogue: 0,0:19:52.42,0:19:55.39,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:19:52.42,0:19:55.39,Default,,0000,0000,0000,,Барлығына қатысты
Dialogue: 0,0:19:52.42,0:19:55.39,Default,,0000,0000,0000,,Бұл тым көп.
Dialogue: 0,0:19:55.39,0:19:57.70,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:55.39,0:19:57.70,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:19:55.39,0:19:57.70,Default,,0000,0000,0000,,Мысалы, егер мен...
Dialogue: 0,0:20:01.73,0:20:04.10,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:20:01.73,0:20:04.10,Default,,0000,0000,0000,,Ылғау
Dialogue: 0,0:20:01.73,0:20:04.10,Default,,0000,0000,0000,,Сізге бірдеңе керек пе?
Dialogue: 0,0:20:04.10,0:20:06.77,Default,,0000,0000,0000,,Ячин Исшобун
Dialogue: 0,0:20:04.10,0:20:06.77,Default,,0000,0000,0000,,Жарайды, өмір бойы жалдау ақысы!
Dialogue: 0,0:20:06.77,0:20:08.77,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:20:06.77,0:20:08.77,Default,,0000,0000,0000,,Онда мен үй аламын!
Dialogue: 0,0:20:08.77,0:20:11.44,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:20:08.77,0:20:11.44,Default,,0000,0000,0000,,Мен болсам
Dialogue: 0,0:20:08.77,0:20:11.44,Default,,0000,0000,0000,,Мыс
Dialogue: 0,0:20:08.77,0:20:11.44,Default,,0000,0000,0000,,Ылғау
Dialogue: 0,0:20:08.77,0:20:11.44,Default,,0000,0000,0000,,Маған қытырлақ мысық керек.
Dialogue: 0,0:20:11.44,0:20:13.75,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:20:11.44,0:20:13.75,Default,,0000,0000,0000,,Ағын да солай ойлайды.
Dialogue: 0,0:20:13.75,0:20:17.42,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:20:13.75,0:20:17.42,Default,,0000,0000,0000,,Сүт безі
Dialogue: 0,0:20:13.75,0:20:17.42,Default,,0000,0000,0000,,Мен... Менің кеудем...
Dialogue: 0,0:20:17.42,0:20:19.42,Default,,0000,0000,0000,,жақсы
Dialogue: 0,0:20:17.42,0:20:19.42,Default,,0000,0000,0000,,Сен сараңсың, Венди!
Dialogue: 0,0:20:19.42,0:20:22.42,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:20:19.42,0:20:22.42,Default,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:20:19.42,0:20:22.42,Default,,0000,0000,0000,,Теріс
Dialogue: 0,0:20:19.42,0:20:22.42,Default,,0000,0000,0000,,Бұл өте сараң өтініш!
Dialogue: 0,0:20:22.42,0:20:25.42,Default,,0000,0000,0000,,Таши
Dialogue: 0,0:20:22.42,0:20:25.42,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:20:22.42,0:20:25.42,Default,,0000,0000,0000,,Шынында да, кез келген нәрсе бар
Dialogue: 0,0:20:22.42,0:20:25.42,Default,,0000,0000,0000,,Котомуукей
Dialogue: 0,0:20:22.42,0:20:25.42,Default,,0000,0000,0000,,Бұл күлкілі➡
Dialogue: 0,0:20:25.42,0:20:27.46,Default,,0000,0000,0000,,Хошу
Dialogue: 0,0:20:25.42,0:20:27.46,Default,,0000,0000,0000,,Қол жетпес сыйлық.
Dialogue: 0,0:20:27.46,0:20:32.43,Default,,0000,0000,0000,,Тітіркену
Dialogue: 0,0:20:27.46,0:20:32.43,Default,,0000,0000,0000,,Тассей
Dialogue: 0,0:20:27.46,0:20:32.43,Default,,0000,0000,0000,,Бірақ барлығын орындау керек.
Dialogue: 0,0:20:27.46,0:20:32.43,Default,,0000,0000,0000,,Кавазанью
Dialogue: 0,0:20:27.46,0:20:32.43,Default,,0000,0000,0000,,Тек есептеу мақсатында.
Dialogue: 0,0:20:32.43,0:20:35.80,Default,,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:20:32.43,0:20:35.80,Default,,0000,0000,0000,,Хошу
Dialogue: 0,0:20:32.43,0:20:35.80,Default,,0000,0000,0000,,Мұндай сыйлық жақсы➡
Dialogue: 0,0:20:35.80,0:20:38.40,Default,,0000,0000,0000,,...
Dialogue: 0,0:20:35.80,0:20:38.40,Default,,0000,0000,0000,,Бұл 100 жылдық квест сияқты.
Dialogue: 0,0:20:35.80,0:20:38.40,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:20:38.40,0:20:41.07,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:20:38.40,0:20:41.07,Default,,0000,0000,0000,,О, мен оны көріп тұрмын.
Dialogue: 0,0:20:41.07,0:20:44.04,Default,,0000,0000,0000,,Қала
Dialogue: 0,0:20:41.07,0:20:44.04,Default,,0000,0000,0000,,Эльмина қаласы!
Dialogue: 0,0:20:53.79,0:20:58.16,Default,,0000,0000,0000,,Көкек
Dialogue: 0,0:20:53.79,0:20:58.16,Default,,0000,0000,0000,,Не болды? Гаджил-кун, бұл түрі.
Dialogue: 0,0:20:53.79,0:20:58.16,Default,,0000,0000,0000,,Лилияға дейін...
Dialogue: 0,0:20:58.16,0:21:01.76,Default,,0000,0000,0000,,Тантей
Dialogue: 0,0:20:58.16,0:21:01.76,Default,,0000,0000,0000,,Детективтерге келгенде
Dialogue: 0,0:20:58.16,0:21:01.76,Default,,0000,0000,0000,,Бұл пальто шығар. Гуихи!
Dialogue: 0,0:21:01.76,0:21:03.80,Default,,0000,0000,0000,,Тантей
Dialogue: 0,0:21:01.76,0:21:03.80,Default,,0000,0000,0000,,Детектив?
Dialogue: 0,0:21:03.80,0:21:06.43,Default,,0000,0000,0000,,Орын
Dialogue: 0,0:21:03.80,0:21:06.43,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:03.80,0:21:06.43,Default,,0000,0000,0000,,Жаңа келу
Dialogue: 0,0:21:03.80,0:21:06.43,Default,,0000,0000,0000,,Әйел
Dialogue: 0,0:21:03.80,0:21:06.43,Default,,0000,0000,0000,,Тука есімді әйел➡
Dialogue: 0,0:21:06.43,0:21:08.80,Default,,0000,0000,0000,,На
Dialogue: 0,0:21:06.43,0:21:08.80,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:21:06.43,0:21:08.80,Default,,0000,0000,0000,,Мен Брияның атын білетінмін.
Dialogue: 0,0:21:08.80,0:21:13.11,Default,,0000,0000,0000,,Бір
Dialogue: 0,0:21:08.80,0:21:13.11,Default,,0000,0000,0000,,Аватар мүшесі...
Dialogue: 0,0:21:08.80,0:21:13.11,Default,,0000,0000,0000,,Қорқыныш
Dialogue: 0,0:21:08.80,0:21:13.11,Default,,0000,0000,0000,,Тора
Dialogue: 0,0:21:08.80,0:21:13.11,Default,,0000,0000,0000,,Бір жыл бұрын қолға түсіргенім.
Dialogue: 0,0:21:13.11,0:21:17.11,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:21:13.11,0:21:17.11,Default,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:21:13.11,0:21:17.11,Default,,0000,0000,0000,,Қандай қатыгез қимыл…
Dialogue: 0,0:21:13.11,0:21:17.11,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:21:13.11,0:21:17.11,Default,,0000,0000,0000,,Айром
Dialogue: 0,0:21:13.11,0:21:17.11,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:21:13.11,0:21:17.11,Default,,0000,0000,0000,,Мен Грэй-самаға осылай қарадым...
Dialogue: 0,0:21:17.11,0:21:20.08,Default,,0000,0000,0000,,На
Dialogue: 0,0:21:17.11,0:21:20.08,Default,,0000,0000,0000,,Оның аты
Dialogue: 0,0:21:17.11,0:21:20.08,Default,,0000,0000,0000,,Иппантеки
Dialogue: 0,0:21:17.11,0:21:20.08,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:21:17.11,0:21:20.08,Default,,0000,0000,0000,,Жалпы белгілі емес.
Dialogue: 0,0:21:20.08,0:21:22.78,Default,,0000,0000,0000,,На
Dialogue: 0,0:21:20.08,0:21:22.78,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:21:20.08,0:21:22.78,Default,,0000,0000,0000,,Тука бұл есімді білетін.
Dialogue: 0,0:21:22.78,0:21:26.42,Default,,0000,0000,0000,,Hyōgiinjidai
Dialogue: 0,0:21:22.78,0:21:26.42,Default,,0000,0000,0000,,Міне! Кеңес дәуірі
Dialogue: 0,0:21:22.78,0:21:26.42,Default,,0000,0000,0000,,Суирирёку
Dialogue: 0,0:21:22.78,0:21:26.42,Default,,0000,0000,0000,,Ойлау қабілеті бар➡
Dialogue: 0,0:21:26.42,0:21:28.75,Default,,0000,0000,0000,,Хоса
Dialogue: 0,0:21:26.42,0:21:28.75,Default,,0000,0000,0000,,Туканы зерттеңіз.
Dialogue: 0,0:21:26.42,0:21:28.75,Default,,0000,0000,0000,,Сансей
Dialogue: 0,0:21:26.42,0:21:28.75,Default,,0000,0000,0000,,Мен келісемін!
Dialogue: 0,0:21:28.75,0:21:31.89,Default,,0000,0000,0000,,Ювия да, Тука-сан.
Dialogue: 0,0:21:28.75,0:21:31.89,Default,,0000,0000,0000,,Ая
Dialogue: 0,0:21:28.75,0:21:31.89,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:21:28.75,0:21:31.89,Default,,0000,0000,0000,,Менің ойымша, бірдеңе күдікті!
Dialogue: 0,0:21:31.89,0:21:35.43,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:21:31.89,0:21:35.43,Default,,0000,0000,0000,,Суирирёку
Dialogue: 0,0:21:31.89,0:21:35.43,Default,,0000,0000,0000,,Гихи! Менің ойлау қабілетім келеді.
Dialogue: 0,0:21:35.43,0:21:39.10,Default,,0000,0000,0000,,Кейінірек
Dialogue: 0,0:21:35.43,0:21:39.10,Default,,0000,0000,0000,,Алдымен, маған ер!
Dialogue: 0,0:21:35.43,0:21:39.10,Default,,0000,0000,0000,,Мейсури
Dialogue: 0,0:21:35.43,0:21:39.10,Default,,0000,0000,0000,,Бұл керемет шегерім!
Dialogue: 0,0:21:39.10,0:21:41.13,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:41.13,0:21:44.80,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:21:41.13,0:21:44.80,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:21:41.13,0:21:44.80,Default,,0000,0000,0000,,Мен бір нәрсені айтқым келеді.
Dialogue: 0,0:21:41.13,0:21:44.80,Default,,0000,0000,0000,,Суири
Dialogue: 0,0:21:41.13,0:21:44.80,Default,,0000,0000,0000,,Бұл болжам емес.
Dialogue: 0,0:21:44.80,0:21:47.47,Default,,0000,0000,0000,,Ән
Dialogue: 0,0:21:44.80,0:21:47.47,Default,,0000,0000,0000,,Мүшелерге күмәндануға қалай дәтің бар...
Dialogue: 0,0:21:49.44,0:21:52.81,Default,,0000,0000,0000,,Теңіз
Dialogue: 0,0:21:49.44,0:21:52.81,Default,,0000,0000,0000,,Келгеніңе қуаныштымын.
Dialogue: 0,0:21:49.44,0:21:52.81,Default,,0000,0000,0000,,О, теңіздің иісі бар.
Dialogue: 0,0:21:52.81,0:21:54.81,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:21:52.81,0:21:54.81,Default,,0000,0000,0000,,Қабырға
Dialogue: 0,0:21:52.81,0:21:54.81,Default,,0000,0000,0000,,Тайбар әулеті келді!!
Dialogue: 0,0:21:52.81,0:21:54.81,Default,,0000,0000,0000,,Ғимараттың қабырғалары лас.
Dialogue: 0,0:21:54.81,0:21:57.12,Default,,0000,0000,0000,,Фуру
Dialogue: 0,0:21:54.81,0:21:57.12,Default,,0000,0000,0000,,Қала
Dialogue: 0,0:21:54.81,0:21:57.12,Default,,0000,0000,0000,,Бұл ескі қала, мен сенімдімін.
Dialogue: 0,0:21:57.12,0:22:01.12,Default,,0000,0000,0000,,Майго
Dialogue: 0,0:21:57.12,0:22:01.12,Default,,0000,0000,0000,,Жоғалмаңыз
Dialogue: 0,0:21:57.12,0:22:01.12,Default,,0000,0000,0000,,Току
Dialogue: 0,0:21:57.12,0:22:01.12,Default,,0000,0000,0000,,Әсіресе Нацу мен Бақытты.
Dialogue: 0,0:22:01.12,0:22:03.76,Default,,0000,0000,0000,,Минато қаласы
Dialogue: 0,0:22:01.12,0:22:03.76,Default,,0000,0000,0000,,Балық балығы
Dialogue: 0,0:22:01.12,0:22:03.76,Default,,0000,0000,0000,,Порт қалаларындағы балық тағамдары
Dialogue: 0,0:22:01.12,0:22:03.76,Default,,0000,0000,0000,,Көп пе?
Dialogue: 0,0:22:03.76,0:22:05.76,Default,,0000,0000,0000,,Кьюми
Dialogue: 0,0:22:03.76,0:22:05.76,Default,,0000,0000,0000,,Маған қызық емес.
Dialogue: 0,0:22:05.76,0:22:08.76,Default,,0000,0000,0000,,Ядо
Dialogue: 0,0:22:05.76,0:22:08.76,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:22:05.76,0:22:08.76,Default,,0000,0000,0000,,Алдымен, тұратын жерді тауып алайық.
Dialogue: 0,0:22:05.76,0:22:08.76,Default,,0000,0000,0000,,Меши
Dialogue: 0,0:22:05.76,0:22:08.76,Default,,0000,0000,0000,,Алдымен тамақ ішейік!
Dialogue: 0,0:22:08.76,0:22:11.76,Default,,0000,0000,0000,,Балық
Dialogue: 0,0:22:08.76,0:22:11.76,Default,,0000,0000,0000,,Балық
Dialogue: 0,0:22:08.76,0:22:11.76,Default,,0000,0000,0000,,Балық Балықты іздейік!
Dialogue: 0,0:22:11.76,0:22:15.80,Default,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:22:11.76,0:22:15.80,Default,,0000,0000,0000,,Табибито
Dialogue: 0,0:22:11.76,0:22:15.80,Default,,0000,0000,0000,,Саяхатшы келді.
Dialogue: 0,0:22:15.80,0:22:19.44,Default,,0000,0000,0000,,Яғни
Dialogue: 0,0:22:15.80,0:22:19.44,Default,,0000,0000,0000,,Минами
Dialogue: 0,0:22:15.80,0:22:19.44,Default,,0000,0000,0000,,Тайрику
Dialogue: 0,0:22:15.80,0:22:19.44,Default,,0000,0000,0000,,Мадоши
Dialogue: 0,0:22:15.80,0:22:19.44,Default,,0000,0000,0000,,Мен оңтүстік континенттен келген сиқыршымын➡
Dialogue: 0,0:22:19.44,0:22:21.41,Default,,0000,0000,0000,,Сүйджин-сама
Dialogue: 0,0:22:19.44,0:22:21.41,Default,,0000,0000,0000,,Су құдайы.
Dialogue: 0,0:22:22.91,0:22:28.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory