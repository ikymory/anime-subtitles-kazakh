Dialogue: 0,0:00:06.84,0:00:09.21,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:00:13.11,0:00:17.12,Default,,0000,0000,0000,,Сиқыр
Dialogue: 0,0:00:13.11,0:00:17.12,Default,,0000,0000,0000,,Қуат
Dialogue: 0,0:00:13.11,0:00:17.12,Default,,0000,0000,0000,,Сиқыр – зұлым күш емес.
Dialogue: 0,0:00:17.12,0:00:22.12,Default,,0000,0000,0000,,Оқиға
Dialogue: 0,0:00:17.12,0:00:22.12,Default,,0000,0000,0000,,Мадоши
Dialogue: 0,0:00:17.12,0:00:22.12,Default,,0000,0000,0000,,Біз шеберлерді қорғауымыз керек.
Dialogue: 0,0:00:22.12,0:00:25.13,Default,,0000,0000,0000,,Қуат
Dialogue: 0,0:00:22.12,0:00:25.13,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:00:22.12,0:00:25.13,Default,,0000,0000,0000,,Бірге жұмыс жасамасақ...
Dialogue: 0,0:00:25.13,0:00:30.73,Default,,0000,0000,0000,,...
Dialogue: 0,0:00:25.13,0:00:30.73,Default,,0000,0000,0000,,Дүние
Dialogue: 0,0:00:25.13,0:00:30.73,Default,,0000,0000,0000,,Қорытынды
Dialogue: 0,0:00:25.13,0:00:30.73,Default,,0000,0000,0000,,<X633 Әлемдегі бірінші
Dialogue: 0,0:00:25.13,0:00:30.73,Default,,0000,0000,0000,,Мадоши
Dialogue: 0,0:00:25.13,0:00:30.73,Default,,0000,0000,0000,,Танджо
Dialogue: 0,0:00:25.13,0:00:30.73,Default,,0000,0000,0000,,Сиқыршылар гильдиясы дүниеге келді>
Dialogue: 0,0:00:33.20,0:00:40.21,Default,,0000,0000,0000,,Ақша
Dialogue: 0,0:00:33.20,0:00:40.21,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:00:33.20,0:00:40.21,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:00:44.84,0:00:47.78,Default,,0000,0000,0000,,Хонджитсу
Dialogue: 0,0:00:44.84,0:00:47.78,Default,,0000,0000,0000,,Бүгіннен бастап
Dialogue: 0,0:00:44.84,0:00:47.78,Default,,0000,0000,0000,,Канюу
Dialogue: 0,0:00:44.84,0:00:47.78,Default,,0000,0000,0000,,Қосылған Fairy Tail➡
Dialogue: 0,0:00:47.78,0:00:53.19,Default,,0000,0000,0000,,Шинжин
Dialogue: 0,0:00:47.78,0:00:53.19,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:00:47.78,0:00:53.19,Default,,0000,0000,0000,,Үш жаңадан келген адам!
Dialogue: 0,0:00:47.78,0:00:53.19,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:00:53.19,0:00:56.46,Default,,0000,0000,0000,,(Изуку) Мүмкін. Оятып алғаным үшін кешір.
Dialogue: 0,0:00:53.19,0:00:56.46,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:00:53.19,0:00:56.46,Default,,0000,0000,0000,,Ей, мына бала сүйкімді екен.
Dialogue: 0,0:00:56.46,0:00:58.46,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:00:56.46,0:00:58.46,Default,,0000,0000,0000,,Тоу
Dialogue: 0,0:00:56.46,0:00:58.46,Default,,0000,0000,0000,,Әке!
Dialogue: 0,0:00:58.46,0:01:01.13,Default,,0000,0000,0000,,Fairy Tail ойынына қош келдіңіз.
Dialogue: 0,0:01:01.13,0:01:03.80,Default,,0000,0000,0000,,Бұл ертегі ме?
Dialogue: 0,0:01:03.80,0:01:06.17,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:01:03.80,0:01:06.17,Default,,0000,0000,0000,,О
Dialogue: 0,0:01:03.80,0:01:06.17,Default,,0000,0000,0000,,Адамдар... көп.
Dialogue: 0,0:01:06.17,0:01:08.80,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:01:06.17,0:01:08.80,Default,,0000,0000,0000,,Иә? Тек үш адам?
Dialogue: 0,0:01:08.80,0:01:11.81,Default,,0000,0000,0000,,О
Dialogue: 0,0:01:08.80,0:01:11.81,Default,,0000,0000,0000,,Шеберлер тым көп
Dialogue: 0,0:01:08.80,0:01:11.81,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:01:08.80,0:01:11.81,Default,,0000,0000,0000,,Себебі мен айтамын➡
Dialogue: 0,0:01:11.81,0:01:15.14,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:01:11.81,0:01:15.14,Default,,0000,0000,0000,,Шибо
Dialogue: 0,0:01:11.81,0:01:15.14,Default,,0000,0000,0000,,Мен оны үш адамға дейін қысқарттым.
Dialogue: 0,0:01:11.81,0:01:15.14,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:01:15.14,0:01:17.81,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:01:15.14,0:01:17.81,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:15.14,0:01:17.81,Default,,0000,0000,0000,,Жеткілікті
Dialogue: 0,0:01:15.14,0:01:17.81,Default,,0000,0000,0000,,Олардың үшеуі де жеткілікті қабілетті.
Dialogue: 0,0:01:17.81,0:01:20.18,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:01:17.81,0:01:20.18,Default,,0000,0000,0000,,Хошо
Dialogue: 0,0:01:17.81,0:01:20.18,Default,,0000,0000,0000,,А, біз оған кепілдік береміз.
Dialogue: 0,0:01:20.18,0:01:23.48,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:20.18,0:01:23.48,Default,,0000,0000,0000,,Өнімділік тестінде
Dialogue: 0,0:01:20.18,0:01:23.48,Default,,0000,0000,0000,,Сізге қатты соққы болған сияқты.
Dialogue: 0,0:01:23.48,0:01:27.15,Default,,0000,0000,0000,,Шини
Dialogue: 0,0:01:23.48,0:01:27.15,Default,,0000,0000,0000,,Сіз жаңасыз ба?
Dialogue: 0,0:01:23.48,0:01:27.15,Default,,0000,0000,0000,,Ылғау
Dialogue: 0,0:01:23.48,0:01:27.15,Default,,0000,0000,0000,,Қатыспа, Гаджил.
Dialogue: 0,0:01:27.15,0:01:30.52,Default,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:01:27.15,0:01:30.52,Default,,0000,0000,0000,,Ерлер арасындағы ерлер гильдиясында
Dialogue: 0,0:01:27.15,0:01:30.52,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:01:27.15,0:01:30.52,Default,,0000,0000,0000,,Енді келдіңіз!
Dialogue: 0,0:01:30.52,0:01:33.13,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:01:30.52,0:01:33.13,Default,,0000,0000,0000,,Ән
Dialogue: 0,0:01:30.52,0:01:33.13,Default,,0000,0000,0000,,Ішіп, ән айт
Dialogue: 0,0:01:30.52,0:01:33.13,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:01:30.52,0:01:33.13,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:01:30.52,0:01:33.13,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:01:30.52,0:01:33.13,Default,,0000,0000,0000,,Іш, же, іш~!
Dialogue: 0,0:01:33.13,0:01:35.43,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:01:33.13,0:01:35.43,Default,,0000,0000,0000,,Тек іш, Кана.
Dialogue: 0,0:01:35.43,0:01:37.46,Default,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:01:35.43,0:01:37.46,Default,,0000,0000,0000,,Тату болайық.
Dialogue: 0,0:01:37.46,0:01:39.80,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:01:37.46,0:01:39.80,Default,,0000,0000,0000,,Өйткені бұл өте қарапайым гильдия.
Dialogue: 0,0:01:39.80,0:01:41.84,Default,,0000,0000,0000,,Достар
Dialogue: 0,0:01:39.80,0:01:41.84,Default,,0000,0000,0000,,Достар
Dialogue: 0,0:01:39.80,0:01:41.84,Default,,0000,0000,0000,,Достар Достар!
Dialogue: 0,0:01:41.84,0:01:43.84,Default,,0000,0000,0000,,Өзіңізді үйде сезінесіз бе?
Dialogue: 0,0:01:43.84,0:01:45.87,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:01:43.84,0:01:45.87,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:01:45.87,0:01:48.11,Default,,0000,0000,0000,,Сайкё
Dialogue: 0,0:01:45.87,0:01:48.11,Default,,0000,0000,0000,,Ең күшті гильдия!
Dialogue: 0,0:01:45.87,0:01:48.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:01:48.11,0:01:50.14,Default,,0000,0000,0000,,Фиоре Ичи!
Dialogue: 0,0:01:50.14,0:01:52.15,Default,,0000,0000,0000,,және т.б.
Dialogue: 0,0:01:50.14,0:01:52.15,Default,,0000,0000,0000,,Басқа гильдиялар босқа.
Dialogue: 0,0:01:52.15,0:01:54.15,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:52.15,0:01:54.15,Default,,0000,0000,0000,,Fairy Tail - әлемдегі ең күшті!
Dialogue: 0,0:01:54.15,0:01:56.82,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:01:54.15,0:01:56.82,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:01:54.15,0:01:56.82,Default,,0000,0000,0000,,Жұмыс
Dialogue: 0,0:01:54.15,0:01:56.82,Default,,0000,0000,0000,,Маған кез келген жұмысты беріңізші.
Dialogue: 0,0:01:56.82,0:01:58.82,Default,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:01:56.82,0:01:58.82,Default,,0000,0000,0000,,Бұл гильдияны күшейтіңіз➡
Dialogue: 0,0:01:58.82,0:02:01.52,Default,,0000,0000,0000,,Сайкё
Dialogue: 0,0:01:58.82,0:02:01.52,Default,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:01:58.82,0:02:01.52,Default,,0000,0000,0000,,Ең мықтылар қатарында
Dialogue: 0,0:01:58.82,0:02:01.52,Default,,0000,0000,0000,,Сайкё
Dialogue: 0,0:01:58.82,0:02:01.52,Default,,0000,0000,0000,,Мен сені ең күшті етемін!
Dialogue: 0,0:02:01.52,0:02:04.92,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:02:01.52,0:02:04.92,Default,,0000,0000,0000,,Ашығын айтқанда
Dialogue: 0,0:02:01.52,0:02:04.92,Default,,0000,0000,0000,,Сенпай
Dialogue: 0,0:02:01.52,0:02:04.92,Default,,0000,0000,0000,,Мұндай ағадан жақсы➡
Dialogue: 0,0:02:04.92,0:02:07.83,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:02:04.92,0:02:07.83,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:02:04.92,0:02:07.83,Default,,0000,0000,0000,,Ол мен оны жақсырақ пайдалана аламын дейді.
Dialogue: 0,0:02:04.92,0:02:07.83,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,0:02:04.92,0:02:07.83,Default,,0000,0000,0000,,Гаан!
Dialogue: 0,0:02:07.83,0:02:11.46,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:02:07.83,0:02:11.46,Default,,0000,0000,0000,,Мен, бір күні
Dialogue: 0,0:02:07.83,0:02:11.46,Default,,0000,0000,0000,,Fairy Tail шебері бол...
Dialogue: 0,0:02:11.46,0:02:13.43,Default,,0000,0000,0000,,Буха~!
Dialogue: 0,0:02:15.80,0:02:18.10,Default,,0000,0000,0000,,Шулы.
Dialogue: 0,0:02:18.10,0:02:21.11,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,0:02:18.10,0:02:21.11,Default,,0000,0000,0000,,Эй, қайтып келдің, Лаксус?
Dialogue: 0,0:02:21.11,0:02:23.11,Default,,0000,0000,0000,,О.
Dialogue: 0,0:02:23.11,0:02:25.81,Default,,0000,0000,0000,,Немесе….
Dialogue: 0,0:02:25.81,0:02:28.45,Default,,0000,0000,0000,,Достар
Dialogue: 0,0:02:25.81,0:02:28.45,Default,,0000,0000,0000,,Микуда
Dialogue: 0,0:02:25.81,0:02:28.45,Default,,0000,0000,0000,,Хатсуген
Dialogue: 0,0:02:25.81,0:02:28.45,Default,,0000,0000,0000,,Басқа мүшелерге төмен қарайтын пікірлер
Dialogue: 0,0:02:25.81,0:02:28.45,Default,,0000,0000,0000,,№.
Dialogue: 0,0:02:28.45,0:02:30.45,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:02:28.45,0:02:30.45,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:02:28.45,0:02:30.45,Default,,0000,0000,0000,,Сіз айтасыз ба?
Dialogue: 0,0:02:30.45,0:02:33.12,Default,,0000,0000,0000,,және т.б.
Dialogue: 0,0:02:30.45,0:02:33.12,Default,,0000,0000,0000,,Кейши
Dialogue: 0,0:02:30.45,0:02:33.12,Default,,0000,0000,0000,,Басқа гильдияларды құрметтемеу
Dialogue: 0,0:02:30.45,0:02:33.12,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:02:30.45,0:02:33.12,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:02:30.45,0:02:33.12,Default,,0000,0000,0000,,Оны елемеңіз.
Dialogue: 0,0:02:33.12,0:02:37.09,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:02:33.12,0:02:37.09,Default,,0000,0000,0000,,Сіз үшін Fairy Tail
Dialogue: 0,0:02:33.12,0:02:37.09,Default,,0000,0000,0000,,Нано
Dialogue: 0,0:02:33.12,0:02:37.09,Default,,0000,0000,0000,,...
Dialogue: 0,0:02:33.12,0:02:37.09,Default,,0000,0000,0000,,Мен өз есімімді айта алмаймын.
Dialogue: 0,0:02:37.09,0:02:39.79,Default,,0000,0000,0000,,Хи хи.
Dialogue: 0,0:02:39.79,0:02:41.79,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:41.79,0:02:44.46,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:02:41.79,0:02:44.46,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:02:41.79,0:02:44.46,Default,,0000,0000,0000,,Бұны кім әкелді?
Dialogue: 0,0:02:44.46,0:02:46.47,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:02:44.46,0:02:46.47,Default,,0000,0000,0000,,Бұл Мира-чан болды! ?
Dialogue: 0,0:02:46.47,0:02:49.10,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:02:46.47,0:02:49.10,Default,,0000,0000,0000,,Балалар сендер неліктен Fairy Tail-ге қосылдыңдар?
Dialogue: 0,0:02:49.10,0:02:51.14,Default,,0000,0000,0000,,Сәлем...
Dialogue: 0,0:02:51.14,0:02:55.14,Default,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:02:51.14,0:02:55.14,Default,,0000,0000,0000,,Бұл жерде қорқынышты!
Dialogue: 0,0:02:51.14,0:02:55.14,Default,,0000,0000,0000,,Қай жерде өз үйіндей сезінеді?
Dialogue: 0,0:02:55.14,0:02:59.11,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:02:55.14,0:02:59.11,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,0:02:55.14,0:02:59.11,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:02:55.14,0:02:59.11,Default,,0000,0000,0000,,Кірген соң бірден екі адам шығып кетті.
Dialogue: 0,0:02:55.14,0:02:59.11,Default,,0000,0000,0000,,Лаксустың арқасында.
Dialogue: 0,0:02:59.11,0:03:01.11,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:02:59.11,0:03:01.11,Default,,0000,0000,0000,,Бұл менің кінәм!
