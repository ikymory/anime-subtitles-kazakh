Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.29,0:00:02.58,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:04.79,0:00:06.04,Default,,0,0,0,,Теңіз екіге бөлінеді...
Dialogue: 0,0:00:06.13,0:00:08.25,Default,,0,0,0,,- (Люси) Бұл не! -(Бақытты) Ах!
Dialogue: 0,0:00:11.26,0:00:14.43,Default,,0,0,0,,Менің теңізім шулы.
Dialogue: 0,0:00:21.43,0:00:24.31,Default,,0,0,0,,Су құдайы Айдаһар...
Dialogue: 0,0:00:24.39,0:00:27.56,Default,,0,0,0,,Айдаһар қанын іздеушілер
Dialogue: 0,0:00:27.65,0:00:29.27,Default,,0,0,0,,Бұл жерден қазір кетіңіз.
Dialogue: 0,0:00:29.36,0:00:31.65,Default,,0,0,0,,Ақыры шықты
Dialogue: 0,0:00:31.74,0:00:33.49,Default,,0,0,0,,Мен осы сәтті күттім.
Dialogue: 0,0:00:33.95,0:00:37.45,Default,,0,0,0,,Кирия ешқандай стратегиясыз жеңе алатын қарсылас емес.
Dialogue: 0,0:00:37.53,0:00:40.49,Default,,0,0,0,,Жоқ, мен қия алмайтын ештеңе жоқ.
Dialogue: 0,0:00:40.58,0:00:41.41,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:41.49,0:00:42.62,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:43.96,0:00:45.17,Default,,0,0,0,,Не?
Dialogue: 0,0:00:45.25,0:00:47.33,Default,,0,0,0,,- (Люси) Олардың денелері... - Күл! ?
Dialogue: 0,0:00:47.42,0:00:50.25,Default,,0,0,0,,Скульон! Бұл қажет емес!
Dialogue: 0,0:00:50.34,0:00:52.63,Default,,0,0,0,,Су құдайы Айдаһар менің алдымда!
Dialogue: 0,0:00:52.71,0:00:55.51,Default,,0,0,0,,Мен қайтып оралсам, мен сені жалғыз қалдырмаймын, Сарымсақ!
Dialogue: 0,0:00:55.59,0:00:57.22,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:00:58.68,0:01:01.14,Default,,0,0,0,,Бұл не болды? Қазіргісі
Dialogue: 0,0:01:01.22,0:01:04.06,Default,,0,0,0,,- Күл сиқыры? -Достарыңды күлге айналдырдың ба?
Dialogue: 0,0:01:04.14,0:01:07.56,Default,,0,0,0,,Бұл орындарды жылжытуға мүмкіндік беретін сиқырдың бір түрі сияқты.
Dialogue: 0,0:01:07.65,0:01:10.90,Default,,0,0,0,,Бірақ Айдаһар жегіштің сиқырына келгенде...
Dialogue: 0,0:01:10.98,0:01:12.03,Default,,0,0,0,,Сұр айдаһар?
Dialogue: 0,0:01:12.73,0:01:14.49,Default,,0,0,0,,Айдаһар өлтіруші ме?
Dialogue: 0,0:01:15.07,0:01:17.70,Default,,0,0,0,,Сен мені құртуға келдің бе?
Dialogue: 0,0:01:17.78,0:01:19.70,Default,,0,0,0,,Сен шынымен де жалықтырасың.
Dialogue: 0,0:01:20.45,0:01:23.41,Default,,0,0,0,,Бес айдаһарға мөр басуды сұрау.
Dialogue: 0,0:01:23.50,0:01:26.66,Default,,0,0,0,,Мен сен жақсы жігіт болсаң не істер едім?
Dialogue: 0,0:01:26.75,0:01:28.71,Default,,0,0,0,,Сіз өте өрескел сөйлейсіз.
Dialogue: 0,0:01:28.79,0:01:31.80,Default,,0,0,0,,Түсіндім, Элефтерия.
Dialogue: 0,0:01:31.88,0:01:33.59,Default,,0,0,0,,Сіз әлі бас тартқан жоқсыз ба?
Dialogue: 0,0:01:33.67,0:01:35.72,Default,,0,0,0,,Сіз Элефтерияны білесіз бе?
Dialogue: 0,0:01:35.80,0:01:40.51,Default,,0,0,0,,Олар 100 жыл бойы бірінен соң бірі өлтірушілерді жібере алса.
Dialogue: 0,0:01:40.60,0:01:44.56,Default,,0,0,0,,Сонда сен жақсы жігітсің бе? Ол жаман жігіт пе?
Dialogue: 0,0:01:44.64,0:01:46.02,Default,,0,0,0,,Тікелей...
Dialogue: 0,0:01:46.56,0:01:49.19,Default,,0,0,0,,Енді... Екі жағын да айта алмаймын.
Dialogue: 0,0:01:49.27,0:01:52.57,Default,,0,0,0,,Менің сендерге ешбір дұшпандығым жоқ.
Dialogue: 0,0:01:52.65,0:01:53.73,Default,,0,0,0,,Әзірге
Dialogue: 0,0:01:53.82,0:01:55.86,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:01:55.94,0:01:58.53,Default,,0,0,0,,100 жылдық квест кенет сәтсіз аяқталды, солай ма?
Dialogue: 0,0:01:58.61,0:01:59.66,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:01:59.74,0:02:03.62,Default,,0,0,0,,Егер адамдарға дұшпандық болмаса, онда бұл апат емес!
Dialogue: 0,0:02:03.70,0:02:06.83,Default,,0,0,0,,Бұл біз үшін серуен бола ма деп ойлаймын.
Dialogue: 0,0:02:07.50,0:02:10.54,Default,,0,0,0,,Расында да, оны жеңуге негіз болмаса, оны мөрлеуге жол жоқ!
Dialogue: 0,0:02:10.63,0:02:12.79,Default,,0,0,0,,Жоқ, ол мөрленуі керек.
Dialogue: 0,0:02:13.75,0:02:15.80,Default,,0,0,0,,Мен мөрленуім керек
Dialogue: 0,0:02:16.26,0:02:17.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:17.88,0:02:18.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:18.88,0:02:23.18,Default,,0,0,0,,Балалар, сендер бұрынғы өлтірушілерден аздап ерекшеленетін сияқтысыңдар.
Dialogue: 0,0:02:24.85,0:02:26.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:26.64,0:02:29.64,Default,,0,0,0,,-Су~! - (Бақытты) Тағы да су асты!
Dialogue: 0,0:02:29.73,0:02:30.69,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:30.77,0:02:32.02,Default,,0,0,0,,-Кашима -Ха...
Dialogue: 0,0:02:32.61,0:02:35.07,Default,,0,0,0,,Бұл менің қонақтарым.
Dialogue: 0,0:02:35.28,0:02:37.03,Default,,0,0,0,,Болашақта еліктеуден аулақ болыңыз
Dialogue: 0,0:02:37.11,0:02:38.49,Default,,0,0,0,,бұл... Иә~!
Dialogue: 0,0:02:38.57,0:02:39.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:40.28,0:02:41.99,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:02:42.62,0:02:45.29,Default,,0,0,0,,Маған ғибадатханама апаруға рұқсат етіңіз
Dialogue: 0,0:02:46.45,0:02:52.46,Default,,0,0,0,,♪~
Dialogue: 0,0:04:09.37,0:04:14.62,Default,,0,0,0,,~♪
Dialogue: 0,0:04:23.47,0:04:25.89,Default,,0,0,0,,Уау! Керемет!
Dialogue: 0,0:04:26.43,0:04:28.14,Default,,0,0,0,,Мұнда ауа бар
Dialogue: 0,0:04:28.22,0:04:29.76,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:04:29.85,0:04:31.85,Default,,0,0,0,,Теңізде осындай жер бар
Dialogue: 0,0:04:31.93,0:04:34.48,Default,,0,0,0,,Не? Сол тас мүсін
Dialogue: 0,0:04:34.56,0:04:36.31,Default,,0,0,0,,Сіз жартылай су перісісіз бе?
Dialogue: 0,0:04:36.40,0:04:39.94,Default,,0,0,0,,Мен қашанға дейін осылай тұрамын?
Dialogue: 0,0:04:40.02,0:04:41.28,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:04:41.65,0:04:43.90,Default,,0,0,0,,Ах! Қайтып келді!
Dialogue: 0,0:04:44.57,0:04:49.03,Default,,0,0,0,,Суйшинрю-санның сиқырды жою күші бар, солай ма?
Dialogue: 0,0:04:49.24,0:04:50.87,Default,,0,0,0,,Осы деңгейдегі сиқырмен.
Dialogue: 0,0:04:51.66,0:04:52.70,Default,,0,0,0,,Су құдайы Айдаһар
Dialogue: 0,0:04:53.50,0:04:54.96,Default,,0,0,0,,Неліктен мұндай адамдар
Dialogue: 0,0:04:55.04,0:04:56.87,Default,,0,0,0,,Қасиетті ғибадатханаға?
Dialogue: 0,0:04:57.71,0:04:59.42,Default,,0,0,0,,Ол Карамир
Dialogue: 0,0:04:59.50,0:05:01.88,Default,,0,0,0,,Ол маған жан-жақты қамқорлық жасайды.
Dialogue: 0,0:05:02.34,0:05:03.51,Default,,0,0,0,,Танысайық
Dialogue: 0,0:05:03.59,0:05:05.72,Default,,0,0,0,,Ишгардан келген сиқыршылар.
Dialogue: 0,0:05:05.80,0:05:06.84,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:06.93,0:05:09.39,Default,,0,0,0,,Біз сиқыршылар гильдиясы ертегілерміз...
Dialogue: 0,0:05:09.47,0:05:10.68,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:05:10.76,0:05:12.93,Default,,0,0,0,,Бұл бәрібір Элефтерияның ақшасы шығар.
Dialogue: 0,0:05:13.02,0:05:15.14,Default,,0,0,0,,Міне, солай деп ойлаймын.
Dialogue: 0,0:05:15.23,0:05:16.52,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:16.60,0:05:19.81,Default,,0,0,0,,Су құдайы Айдаһарға қарсы шыққыңыз келсе, қазір жасаңыз.
Dialogue: 0,0:05:19.90,0:05:22.48,Default,,0,0,0,,Өйткені сендер маған тең келер емессіңдер.
Dialogue: 0,0:05:22.57,0:05:25.19,Default,,0,0,0,,Жарайды, күте тұр, Карамир.
Dialogue: 0,0:05:25.36,0:05:27.78,Default,,0,0,0,,Мен олармен сөйлесе аламын деп ойлаймын.
Dialogue: 0,0:05:27.86,0:05:29.95,Default,,0,0,0,,Мен сенімен сөйлесе аламын ба?
Dialogue: 0,0:05:30.87,0:05:31.91,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:31.99,0:05:34.41,Default,,0,0,0,,Мен сенен орныңнан кетуіңді сұраймын.
Dialogue: 0,0:05:34.50,0:05:38.37,Default,,0,0,0,,Хмф! Өтінемін, олардан құтылуды ұмытпаңыз!
Dialogue: 0,0:05:39.13,0:05:40.84,Default,,0,0,0,,Жою…
Dialogue: 0,0:05:40.92,0:05:44.92,Default,,0,0,0,,Ол кісінің қызы ғой.
Dialogue: 0,0:05:45.01,0:05:47.97,Default,,0,0,0,,Барлығы мен теңізде адасып қалған адамды құтқарған кезде басталды.
Dialogue: 0,0:05:48.05,0:05:49.84,Default,,0,0,0,,Бұл реттелді.
Dialogue: 0,0:05:49.93,0:05:51.60,Default,,0,0,0,,Ол жаман бала емес.
Dialogue: 0,0:05:52.68,0:05:55.14,Default,,0,0,0,,Бұл біздің мақтан тұтатын су асты фермасы.
Dialogue: 0,0:05:55.22,0:05:59.60,Default,,0,0,0,,Мұнда өсірілген көкөністер мен жемістер Эльминада барлығына ортақ болады.
Dialogue: 0,0:05:59.69,0:06:01.61,Default,,0,0,0,,Бұл медициналық мекеме
Dialogue: 0,0:06:01.69,0:06:04.57,Default,,0,0,0,,Теңізде жарақат алған балықтар емделетін орын.
Dialogue: 0,0:06:05.07,0:06:06.44,Default,,0,0,0,,Бұл қарауыл мұнарасы
Dialogue: 0,0:06:06.53,0:06:07.65,Default,,0,0,0,,Карамир сияқты
Dialogue: 0,0:06:07.74,0:06:11.53,Default,,0,0,0,,Біз зардап шеккендерді тезірек тауып, құтқаруымыз керек.
Dialogue: 0,0:06:11.62,0:06:14.91,Default,,0,0,0,,Сіз шынымен су құдайы айдаһар мелкфобиясыз! ?
Dialogue: 0,0:06:14.99,0:06:16.08,Default,,0,0,0,,Ол өте жақсы!
Dialogue: 0,0:06:16.16,0:06:19.54,Default,,0,0,0,,Айдаһар қаптаған адамды құтқарғанда жылап жіберемін!
Dialogue: 0,0:06:19.62,0:06:20.92,Default,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:06:21.00,0:06:22.79,Default,,0,0,0,,Сонымен... солай ма?
Dialogue: 0,0:06:22.88,0:06:25.38,Default,,0,0,0,,Бірақ апат өтірік емес пе?
Dialogue: 0,0:06:25.46,0:06:27.88,Default,,0,0,0,,Иә, бұл мүлдем зиянды емес сияқты.
Dialogue: 0,0:06:27.97,0:06:29.76,Default,,0,0,0,,-Бұл дұрыс емес.-(2 адам) Иә?
Dialogue: 0,0:06:30.22,0:06:35.10,Default,,0,0,0,,Бұлай көрінгенмен, өткенде талай адамды өлтірдік.
Dialogue: 0,0:06:35.18,0:06:37.23,Default,,0,0,0,,Бұл жәндік сияқты
Dialogue: 0,0:06:37.31,0:06:38.31,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:06:38.39,0:06:41.73,Default,,0,0,0,,Элефтерияның мені нысанаға алуы табиғи нәрсе.
Dialogue: 0,0:06:41.81,0:06:46.94,Default,,0,0,0,,Мен өлтірген адамдардың кейбірі оның достары мен отбасы болуы мүмкін.
Dialogue: 0,0:06:47.03,0:06:48.95,Default,,0,0,0,,Менің ақтауға ниетім жоқ.
Dialogue: 0,0:06:49.03,0:06:52.82,Default,,0,0,0,,Ол кезде мен үшін бұл табиғи нәрсе еді.
Dialogue: 0,0:06:53.03,0:06:57.04,Default,,0,0,0,,Күштілердің әлсізді аулайтыны қалыпты жағдай болған.
Dialogue: 0,0:06:57.70,0:07:00.08,Default,,0,0,0,,Сіз бір жерде ойыңызды өзгерттіңіз бе?
Dialogue: 0,0:07:00.16,0:07:03.92,Default,,0,0,0,,Дұрыс, бәрі Карамирден басталды.
Dialogue: 0,0:07:04.00,0:07:07.84,Default,,0,0,0,,Негізі мен оған көмектескім келген жоқ.
Dialogue: 0,0:07:07.92,0:07:11.30,Default,,0,0,0,,Мен оны тек теңізден тапқан тамақ деп ойладым.
Dialogue: 0,0:07:11.38,0:07:14.05,Default,,0,0,0,,Мен бұған біртүрлі ностальгия сезінемін.
Dialogue: 0,0:07:14.14,0:07:16.81,Default,,0,0,0,,Мен мұны білмей тұрып, бірге өмір сүру жолында болдым.
Dialogue: 0,0:07:17.27,0:07:18.14,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:07:18.22,0:07:19.48,Default,,0,0,0,,Мәңгі осылай болыңыз—
Dialogue: 0,0:07:19.56,0:07:21.64,Default,,0,0,0,,Мен осылай қалғым келетін сияқты, бірақ...
Dialogue: 0,0:07:21.73,0:07:25.23,Default,,0,0,0,,Мен бұл дүниеден тез арада жоғалып кетуім керек.
Dialogue: 0,0:07:25.31,0:07:26.36,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:07:26.44,0:07:28.78,Default,,0,0,0,,Эльмина қаласын көрдіңіз бе?
Dialogue: 0,0:07:28.86,0:07:32.20,Default,,0,0,0,,Қалалардың мұхит түбіне батып кету құбылысы сол қалыптан тыс жоғары толқындардың әсерінен...
Dialogue: 0,0:07:32.28,0:07:34.53,Default,,0,0,0,,Бұл менің күшімнің арқасында.
Dialogue: 0,0:07:34.62,0:07:36.83,Default,,0,0,0,,Күшті басқару мүмкін емес
Dialogue: 0,0:07:38.20,0:07:40.66,Default,,0,0,0,,Бұл қаладағы балықтар да бастапқыда адамдар.
Dialogue: 0,0:07:41.16,0:07:45.63,Default,,0,0,0,,Мен сендерге су астында бейімделулерің үшін балыққа айналу үшін сиқыр жасадым.
Dialogue: 0,0:07:45.71,0:07:49.26,Default,,0,0,0,,Ах! Сол себепті мен өз келбетімді қалпына келтіре алдым.
Dialogue: 0,0:07:49.34,0:07:52.97,Default,,0,0,0,,Сол қаланың жігіттері неге кетпейді?
Dialogue: 0,0:07:53.13,0:07:55.47,Default,,0,0,0,,Су құдайы сенімі
Dialogue: 0,0:07:55.55,0:07:58.39,Default,,0,0,0,,Өткенде мен жасаған көптеген қиянат...
Dialogue: 0,0:07:58.47,0:08:02.44,Default,,0,0,0,,Мен қалай қателестім? Өзінің көптеген кереметтерімен танымал қалада.
Dialogue: 0,0:08:03.06,0:08:05.27,Default,,0,0,0,,Егер сіздің сеніміңіз күшті болса,
Dialogue: 0,0:08:05.35,0:08:08.19,Default,,0,0,0,,Су құдайы бір ауыз сөз айтса, «Шық»...
Dialogue: 0,0:08:08.27,0:08:11.19,Default,,0,0,0,,Сіз олардың күнкөрісін тартып алмақшысыз ба?
Dialogue: 0,0:08:11.28,0:08:14.61,Default,,0,0,0,,Оның үстіне қалада адам болмаса да, ештеңе шешілмейді.
Dialogue: 0,0:08:15.16,0:08:20.20,Default,,0,0,0,,Менің күшім ақырында келесі қалаға тарайды.
Dialogue: 0,0:08:20.29,0:08:23.58,Default,,0,0,0,,Бұл күш мен өлгенше бітпейді.
Dialogue: 0,0:08:23.66,0:08:25.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:25.12,0:08:26.83,Default,,0,0,0,,Басқа амал жоқ па?
Dialogue: 0,0:08:26.92,0:08:28.29,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:08:29.00,0:08:31.42,Default,,0,0,0,,Сондықтан мен біреудің келіп өлтіргенін қаламаймын...
Dialogue: 0,0:08:31.51,0:08:32.80,Default,,0,0,0,,Мен күттім.
Dialogue: 0,0:08:32.88,0:08:34.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:34.13,0:08:35.97,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:08:36.05,0:08:38.35,Default,,0,0,0,,Сізге бір ғана нәрсе істеу керек.
Dialogue: 0,0:08:38.80,0:08:43.73,Default,,0,0,0,,Бұл ең үлкен қателік және ең нашар үлкен мәселе.
Dialogue: 0,0:08:46.06,0:08:47.98,Default,,0,0,0,,Сіз нені айтып тұрсыз, Сарымсақ?
Dialogue: 0,0:08:48.06,0:08:50.02,Default,,0,0,0,,Менің алдымда су құдайы айдаһар болды!
Dialogue: 0,0:08:50.11,0:08:52.24,Default,,0,0,0,,Ал, тынышталыңыз.
Dialogue: 0,0:08:52.32,0:08:55.32,Default,,0,0,0,,Сіз неге әдейі қамауға алынды деп ойлайсыз?
Dialogue: 0,0:08:55.40,0:08:57.70,Default,,0,0,0,,-Жағдай өзгерді -Ха…
Dialogue: 0,0:08:57.78,0:09:01.66,Default,,0,0,0,,Мен Су құдайы Айдаһардың күшін сезіне алмаймын.
Dialogue: 0,0:09:02.29,0:09:04.12,Default,,0,0,0,,Мұны жеуге болмайды.
Dialogue: 0,0:09:05.21,0:09:08.71,Default,,0,0,0,,Айдаһар жегішті алдай аламын деп ойладың ба?
Dialogue: 0,0:09:08.79,0:09:11.84,Default,,0,0,0,,Жалған су құдайы Айдаһар
Dialogue: 0,0:09:19.64,0:09:21.76,Default,,0,0,0,,монах… монах…
Dialogue: 0,0:09:22.22,0:09:24.02,Default,,0,0,0,,- (Бір түн) Бір түн! -Бір түн!
Dialogue: 0,0:09:24.10,0:09:26.02,Default,,0,0,0,,-(Бір түн) Би! -Биле!
Dialogue: 0,0:09:26.10,0:09:27.85,Default,,0,0,0,,- (түнде) Сусын! -Іш!
Dialogue: 0,0:09:27.94,0:09:29.77,Default,,0,0,0,,Міне! Васшои вашой!
Dialogue: 0,0:09:29.86,0:09:30.94,Default,,0,0,0,,Васшои Васшои!
Dialogue: 0,0:09:31.98,0:09:34.40,Default,,0,0,0,,Сізге ерекше күлкі иісін беріңіз
Dialogue: 0,0:09:34.94,0:09:36.36,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:09:36.45,0:09:38.20,Default,,0,0,0,,Маған бетіңізді көрсеткеніңізге сене алар емеспін.
Dialogue: 0,0:09:38.28,0:09:39.49,Default,,0,0,0,,Бұл сирек.
Dialogue: 0,0:09:39.57,0:09:41.41,Default,,0,0,0,,Неге қазір менің үйіме кірмейсің?
Dialogue: 0,0:09:41.49,0:09:42.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:42.62,0:09:43.74,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:43.83,0:09:45.12,Default,,0,0,0,,Ичия-сандай жақсы болмаса да...
Dialogue: 0,0:09:45.20,0:09:46.29,Default,,0,0,0,,Ол әдемі жігіт.
Dialogue: 0,0:09:46.37,0:09:48.87,Default,,0,0,0,,Мен оның қосылғанын қаламаймын...
Dialogue: 0,0:09:48.96,0:09:51.29,Default,,0,0,0,,Мен сізді аға деп атауға болады ма?
Dialogue: 0,0:09:51.38,0:09:53.38,Default,,0,0,0,,Керісінше, бұл әйел туралы.
Dialogue: 0,0:09:53.46,0:09:56.72,Default,,0,0,0,,Егер менде ешқандай ақпарат болмаса, мен көп тұрмаймын.
Dialogue: 0,0:09:56.80,0:09:57.84,Default,,0,0,0,,Негізгі
Dialogue: 0,0:09:57.93,0:09:59.76,Default,,0,0,0,,Кешіріңіз, бірақ...
Dialogue: 0,0:09:59.84,0:10:02.22,Default,,0,0,0,,Осындай сүйкімді қызды көргенде, оны ешқашан ұмытпайсың.
Dialogue: 0,0:10:02.31,0:10:04.06,Default,,0,0,0,,Біздің тұтынушыларымыздың ешқайсысы.
Dialogue: 0,0:10:04.14,0:10:07.18,Default,,0,0,0,,Сіз кімсіз? Бұл әйел
Dialogue: 0,0:10:07.27,0:10:09.52,Default,,0,0,0,,Жоқ, егер сізде ешқандай ақпарат болмаса, жақсы.
Dialogue: 0,0:10:10.06,0:10:13.48,Default,,0,0,0,,Алайда, егер сіз оны көрсеңіз, оған жақындамаңыз.
Dialogue: 0,0:10:13.57,0:10:15.44,Default,,0,0,0,,-(Бір түн) Негізгі... -Аа...
Dialogue: 0,0:10:19.49,0:10:21.28,Default,,0,0,0,,Қаланың шетіне барайық.
Dialogue: 0,0:10:21.37,0:10:22.87,Default,,0,0,0,,Бұл күдікті.
Dialogue: 0,0:10:23.87,0:10:25.29,Default,,0,0,0,,Мен мұнда бір нәрсе бар екеніне сенімдімін...
Dialogue: 0,0:10:25.37,0:10:28.79,Default,,0,0,0,,Эй, достарыңа жазылуды доғар.
Dialogue: 0,0:10:28.87,0:10:30.33,Default,,0,0,0,,Олар дос па, жоқ па —
Dialogue: 0,0:10:30.42,0:10:32.79,Default,,0,0,0,,Мен оның Широ екенін білгеннен кейін шешемін.
Dialogue: 0,0:10:32.88,0:10:34.75,Default,,0,0,0,,Гильдия - барлық отбасы!
Dialogue: 0,0:10:34.84,0:10:37.01,Default,,0,0,0,,Мен сол отбасына қосылғанда
Dialogue: 0,0:10:37.09,0:10:38.76,Default,,0,0,0,,Мен үшін не істедің?
Dialogue: 0,0:10:38.84,0:10:41.01,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:10:41.09,0:10:43.18,Default,,0,0,0,,Мен қосылғанға дейін ең нашар болғаны үшін шығар!
Dialogue: 0,0:10:43.26,0:10:45.64,Default,,0,0,0,,-Нұх... -Не?
Dialogue: 0,0:10:45.72,0:10:48.98,Default,,0,0,0,,Екеуің де жақсы емессіңдер ме? Бұл ұрыс сияқты емес.
Dialogue: 0,0:10:49.06,0:10:50.31,Default,,0,0,0,,-Тыныш! -Ауызыңды жап!
Dialogue: 0,0:10:50.39,0:10:51.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:51.52,0:10:53.36,Default,,0,0,0,,Мен енді білмеймін!
Dialogue: 0,0:10:54.19,0:10:55.23,Default,,0,0,0,,Хмф!
Dialogue: 0,0:10:55.32,0:10:57.61,Default,,0,0,0,,Әй, бұл ойлауға кедергі.
Dialogue: 0,0:10:57.69,0:10:59.07,Default,,0,0,0,,Кетіңіз
Dialogue: 0,0:10:59.15,0:11:00.91,Default,,0,0,0,,Жарайды ма? Гаджил-кун
Dialogue: 0,0:11:00.99,0:11:02.03,Default,,0,0,0,,​​Жарайды!
Dialogue: 0,0:11:02.78,0:11:05.99,Default,,0,0,0,,Егер ол Куро болса, тіпті Левиге де қауіп төнеді.
Dialogue: 0,0:11:06.54,0:11:08.95,Default,,0,0,0,,Мен саған ешқашан Левиді ренжітуге жол бермеймін.
Dialogue: 0,0:11:09.04,0:11:10.41,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:11:10.50,0:11:13.42,Default,,0,0,0,,Менің жүрегім ауырып тұрғандай...
Dialogue: 0,0:11:15.96,0:11:19.09,Default,,0,0,0,,Бұл саламандра мен көк мысықтың үйі емес пе?
Dialogue: 0,0:11:19.55,0:11:21.30,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:11:22.13,0:11:24.89,Default,,0,0,0,,Аха! Ууууууу…
Dialogue: 0,0:11:24.97,0:11:26.26,Default,,0,0,0,,А...
Dialogue: 0,0:11:26.35,0:11:29.18,Default,,0,0,0,,Нацу-сама, тезірек оралыңыз.
Dialogue: 0,0:11:29.27,0:11:32.23,Default,,0,0,0,,Ал мені сол жалынмен өртеп жібер!
Dialogue: 0,0:11:32.31,0:11:34.77,Default,,0,0,0,,А... тіпті фамилиясының өзі сондай тәтті!
Dialogue: 0,0:11:34.86,0:11:36.19,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:11:36.27,0:11:39.65,Default,,0,0,0,,Мен ұқсас біреуді білетін сияқтымын.
Dialogue: 0,0:11:44.82,0:11:45.87,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:11:45.95,0:11:47.79,Default,,0,0,0,,Люсидің үйі
Dialogue: 0,0:11:49.58,0:11:51.16,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:11:51.25,0:11:53.00,Default,,0,0,0,,-Мен үйдемін! -(3 адам) А?
Dialogue: 0,0:11:53.79,0:11:54.92,Default,,0,0,0,,Сіз қазір үйдесіз бе?
Dialogue: 0,0:11:59.42,0:12:01.55,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:12:02.05,0:12:04.51,Default,,0,0,0,,...Бірақ мен жалғыз тұрдым.
Dialogue: 0,0:12:05.51,0:12:07.14,Default,,0,0,0,,Күтпеген жерден...
Dialogue: 0,0:12:07.60,0:12:10.47,Default,,0,0,0,,Ол Люси бөлмесінің қарсысында тұра ма? ?
Dialogue: 0,0:12:10.93,0:12:15.44,Default,,0,0,0,,Ювия, мен дәл қазір хаостың қорқынышты көрінісін елестетіп отырмын.
Dialogue: 0,0:12:16.56,0:12:17.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:20.44,0:12:21.86,Default,,0,0,0,,Жоқ, Гаджил-кун.
Dialogue: 0,0:12:21.94,0:12:24.28,Default,,0,0,0,,Ал... күте тұрыңыз! Бұл маған дәлел үшін керек!
Dialogue: 0,0:12:24.36,0:12:26.03,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:12:26.12,0:12:27.24,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:27.32,0:12:30.49,Default,,0,0,0,,Бұл қандай дыбыс? …Таку
Dialogue: 0,0:12:34.00,0:12:36.83,Default,,0,0,0,,А... жоқ, бұл...
Dialogue: 0,0:12:36.92,0:12:39.13,Default,,0,0,0,,Жоқ... бұл дұрыс емес, Леви-сан!
Dialogue: 0,0:12:40.34,0:12:41.96,Default,,0,0,0,,Өзіңіз қалағандай жасаңыз.
Dialogue: 0,0:12:42.05,0:12:43.92,Default,,0,0,0,,Эй... күте тұр!
Dialogue: 0,0:12:44.01,0:12:45.97,Default,,0,0,0,,Ювия махаббат бәсекелесіне айналады!
Dialogue: 0,0:12:46.05,0:12:49.97,Default,,0,0,0,,Жоқ! Джувиа Грей-самаға берілген!
Dialogue: 0,0:12:50.93,0:12:53.31,Default,,0,0,0,,Хмм... ақымақ
Dialogue: 0,0:12:54.10,0:12:56.15,Default,,0,0,0,,Не істеу керек?
Dialogue: 0,0:12:56.23,0:12:57.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:57.35,0:13:02.23,Default,,0,0,0,,Айдаһардай құдіретімді біреу тартып алды.
Dialogue: 0,0:13:02.32,0:13:04.70,Default,,0,0,0,,- (Люси) А... - Менің күш-қуатымды тартып алды! ?
Dialogue: 0,0:13:04.78,0:13:07.16,Default,,0,0,0,,Бұл Айдаһар жегішпен бірдей жігіт пе?
Dialogue: 0,0:13:07.24,0:13:08.49,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:13:08.57,0:13:11.95,Default,,0,0,0,,Олар мені билікке ие деп ойлайды және мені аңдыды.
Dialogue: 0,0:13:12.04,0:13:16.12,Default,,0,0,0,,Мен өлмес бұрын, мен қандай болса да сол күш-қуатты қайтаруым керек.
Dialogue: 0,0:13:16.96,0:13:18.54,Default,,0,0,0,,Егер бұл қуат дұрыс пайдаланылмаса —
Dialogue: 0,0:13:18.63,0:13:21.09,Default,,0,0,0,,Бұл апат деп аталатын жағдай болар еді.
Dialogue: 0,0:13:21.59,0:13:23.05,Default,,0,0,0,,Оны кім ұрлады?
Dialogue: 0,0:13:23.63,0:13:26.01,Default,,0,0,0,,Оны «Ақ сиқыршы» деп атайды.
Dialogue: 0,0:13:26.09,0:13:27.51,Default,,0,0,0,,Ақ сиқыршы?
Dialogue: 0,0:13:27.59,0:13:29.47,Default,,0,0,0,,Зерефке қарама-қарсы сияқты.
Dialogue: 0,0:13:29.55,0:13:34.06,Default,,0,0,0,,Мен өз күшімді қайтарамын және бұл қаланы қалпына келтіремін.
Dialogue: 0,0:13:34.14,0:13:36.44,Default,,0,0,0,,Оған дейін мен өле алмаймын.
Dialogue: 0,0:13:36.52,0:13:38.23,Default,,0,0,0,,Сонда біз...
Dialogue: 0,0:13:38.31,0:13:39.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:39.23,0:13:40.98,Default,,0,0,0,,-Ой... -Не?
Dialogue: 0,0:13:43.53,0:13:44.65,Default,,0,0,0,,Күл
Dialogue: 0,0:13:45.44,0:13:46.49,Default,,0,0,0,,Су құдай!
Dialogue: 0,0:13:46.57,0:13:48.45,Default,,0,0,0,,-Келме! -(Карамиэл) А...
Dialogue: 0,0:13:48.53,0:13:50.95,Default,,0,0,0,,Карамир! Барлығын эвакуациялаңыз.
Dialogue: 0,0:13:51.03,0:13:52.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:56.25,0:13:57.92,Default,,0,0,0,,Біз тағы кездестік
Dialogue: 0,0:13:58.00,0:13:59.58,Default,,0,0,0,,2 сағат болды
Dialogue: 0,0:13:59.67,0:14:00.92,Default,,0,0,0,,(Сора) Сол жақтағы қарт кітапханада мені бақылап тұрды—
Dialogue: 0,0:14:01.00,0:14:02.25,Default,,0,0,0,,Бір адам көбейді!
Dialogue: 0,0:14:02.34,0:14:04.67,Default,,0,0,0,,Маған оқиғаны айтып берді.
Dialogue: 0,0:14:04.76,0:14:06.72,Default,,0,0,0,,Көремін, көремін...
Dialogue: 0,0:14:06.80,0:14:09.39,Default,,0,0,0,,Менің күшімді ұрлаған...
Dialogue: 0,0:14:09.47,0:14:12.22,Default,,0,0,0,,Тек ақ сиқыршыны жеп ал.
Dialogue: 0,0:14:12.30,0:14:15.64,Default,,0,0,0,,Жоқ, мен су құдайы Айдаһарға билікті қайтарамын.
Dialogue: 0,0:14:15.72,0:14:17.48,Default,,0,0,0,,Балалар мен сендерге бермеймін!
Dialogue: 0,0:14:19.40,0:14:22.90,Default,,0,0,0,,Оның Fairy Tail тобының жаңа мүшесі екеніне күмән жоқ.
Dialogue: 0,0:14:22.98,0:14:26.40,Default,,0,0,0,,Маған оны кеше Магнолияға барғанымда таныстырды.
Dialogue: 0,0:14:26.49,0:14:27.65,Default,,0,0,0,,Не!?
Dialogue: 0,0:14:27.74,0:14:29.61,Default,,0,0,0,,Тағы да Fairy Tail!
Dialogue: 0,0:14:29.70,0:14:32.28,Default,,0,0,0,,Сіз кімсіз? Бұл жігіт
Dialogue: 0,0:14:33.16,0:14:34.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:35.74,0:14:39.00,Default,,0,0,0,,Ол Зереф сияқты қауіпті болуы мүмкін.
Dialogue: 0,0:14:39.08,0:14:41.96,Default,,0,0,0,,100 жыл өмір сүретін ұлы бақсы...
Dialogue: 0,0:14:42.59,0:14:44.84,Default,,0,0,0,,Ақ сиқыршы Тука
Dialogue: 0,0:14:48.51,0:14:50.84,Default,,0,0,0,,Менің ғибадатханамды қорлайтын сенсің
Dialogue: 0,0:14:50.93,0:14:52.39,Default,,0,0,0,,Қазір кетіңіз!
Dialogue: 0,0:14:54.97,0:14:56.35,Default,,0,0,0,,Су күлге айналады!
Dialogue: 0,0:14:56.43,0:14:59.69,Default,,0,0,0,,Сіз енді су құдайы айдаһар емессіз.
Dialogue: 0,0:14:59.77,0:15:01.81,Default,,0,0,0,,Тамақ ішуге болмайды!
Dialogue: 0,0:15:03.90,0:15:05.07,Default,,0,0,0,,Незуко! Мен төмен түсемін
Dialogue: 0,0:15:05.15,0:15:06.53,Default,,0,0,0,,Су құдай!
Dialogue: 0,0:15:07.28,0:15:09.53,Default,,0,0,0,,Люси Венди, олардан сұра!
Dialogue: 0,0:15:09.61,0:15:10.65,Default,,0,0,0,,- (Люси) Иә! -иә!
Dialogue: 0,0:15:10.74,0:15:13.37,Default,,0,0,0,,Күлді жаққанда не болады?
Dialogue: 0,0:15:13.45,0:15:16.70,Default,,0,0,0,,Жүр, одан да күл болып кетпей ме?
Dialogue: 0,0:15:16.79,0:15:18.12,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:15:18.20,0:15:20.54,Default,,0,0,0,,Мұнда отты қолдануға болады!
Dialogue: 0,0:15:22.08,0:15:23.21,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:23.88,0:15:24.92,Default,,0,0,0,,Жоғал
Dialogue: 0,0:15:25.00,0:15:26.38,Default,,0,0,0,,Күлге айналды
Dialogue: 0,0:15:27.67,0:15:29.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:29.13,0:15:31.51,Default,,0,0,0,,Мына жігіттің шабуылы нәтиже бермей ме?
Dialogue: 0,0:15:32.01,0:15:34.01,Default,,0,0,0,,Сонда бұл менің олжам.
Dialogue: 0,0:15:34.68,0:15:36.47,Default,,0,0,0,,Мұздату!
Dialogue: 0,0:15:37.26,0:15:39.06,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:15:39.14,0:15:40.31,Default,,0,0,0,,Хохо…
Dialogue: 0,0:15:43.48,0:15:45.86,Default,,0,0,0,,Менің қарсыласым – мен!
Dialogue: 0,0:15:45.94,0:15:46.86,Default,,0,0,0,,(Дыбыс алынды)
Dialogue: 0,0:15:47.57,0:15:50.69,Default,,0,0,0,,Пышақтардың бір-бірімен соқтығысқан дыбысы...
Dialogue: 0,0:15:50.78,0:15:52.32,Default,,0,0,0,,Бұл мені тоңазытады!
Dialogue: 0,0:15:52.82,0:15:55.28,Default,,0,0,0,,Сонда менің қарсыласым сол жігіт!
Dialogue: 0,0:15:55.78,0:15:57.79,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:15:57.87,0:16:00.04,Default,,0,0,0,,Өртеп жібер!
Dialogue: 0,0:16:00.75,0:16:02.12,Default,,0,0,0,,От айдаһар қылыш мүйізі!
Dialogue: 0,0:16:05.38,0:16:06.84,Default,,0,0,0,,Өте қызба!
Dialogue: 0,0:16:06.92,0:16:08.42,Default,,0,0,0,,Жүр! Нацу!
Dialogue: 0,0:16:11.22,0:16:12.59,Default,,0,0,0,,Бұл жұмыс істемейді
Dialogue: 0,0:16:12.68,0:16:13.88,Default,,0,0,0,,(Изунаның ырылы)
Dialogue: 0,0:16:13.97,0:16:15.55,Default,,0,0,0,,Жалын айдаһар патшасы...
Dialogue: 0,0:16:15.64,0:16:17.68,Default,,0,0,0,,Коукен!
Dialogue: 0,0:16:18.06,0:16:19.06,Default,,0,0,0,,Незуко! Мен төмен түсемін
Dialogue: 0,0:16:19.14,0:16:20.64,Default,,0,0,0,,Бұл жұмыс істемейді
Dialogue: 0,0:16:20.72,0:16:22.85,Default,,0,0,0,,Жақсы... Мына жігіт не болып жатыр?
Dialogue: 0,0:16:22.94,0:16:25.85,Default,,0,0,0,,Бронды айдаһардың таразылары ешқашан зақымданбауы керек.
Dialogue: 0,0:16:26.44,0:16:27.82,Default,,0,0,0,,Сіз мұны көре аласыз ба?
Dialogue: 0,0:16:28.27,0:16:29.27,Default,,0,0,0,,Әй, кеме! ?
Dialogue: 0,0:16:29.36,0:16:30.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:31.49,0:16:32.44,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:16:32.53,0:16:34.41,Default,,0,0,0,,Керемет кадр
Dialogue: 0,0:16:35.95,0:16:37.07,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:16:40.24,0:16:43.25,Default,,0,0,0,,Қарғыс атсын... Шүкір... Қандай қиын?
Dialogue: 0,0:16:43.33,0:16:44.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:44.29,0:16:48.42,Default,,0,0,0,,А... жаман... кеме дірілдеп жатыр...
Dialogue: 0,0:16:49.00,0:16:51.42,Default,,0,0,0,,- (Ақылсыз мең) Әзірге - Ах...
Dialogue: 0,0:16:54.05,0:16:55.34,Default,,0,0,0,,Цуриизо
Dialogue: 0,0:16:55.43,0:17:01.35,Default,,0,0,0,,Жарайды, сен де айдаһар өлтірушісің, неге кемеде жүрсің...
Dialogue: 0,0:17:01.43,0:17:05.35,Default,,0,0,0,,Ежелгі ұрпақ айдаһар өлтірушілер қиыншылықта.
Dialogue: 0,0:17:05.44,0:17:06.81,Default,,0,0,0,,(бір-бірін соғу дыбысы)
Dialogue: 0,0:17:08.15,0:17:09.40,Default,,0,0,0,,Сен екеуің алда барыңдар!
Dialogue: 0,0:17:09.48,0:17:10.57,Default,,0,0,0,,Хаа!
Dialogue: 0,0:17:15.20,0:17:16.57,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:17.49,0:17:18.74,Default,,0,0,0,,-Хмф! -Хахаха!
Dialogue: 0,0:17:20.87,0:17:21.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:24.66,0:17:25.50,Default,,0,0,0,,Хаа!
Dialogue: 0,0:17:29.33,0:17:30.34,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:17:31.71,0:17:32.84,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:17:34.80,0:17:35.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:35.72,0:17:39.09,Default,,0,0,0,,О, жоқ... бұл қауіпті болды!
Dialogue: 0,0:17:39.85,0:17:42.22,Default,,0,0,0,,Мен күштімін.
Dialogue: 0,0:17:43.06,0:17:46.52,Default,,0,0,0,,Достарыңды қорғау үшін қылышта әлсіздік қажет емес.
Dialogue: 0,0:17:46.60,0:17:48.73,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:17:48.81,0:17:52.98,Default,,0,0,0,,Мен мұндай күшті адамдармен төбелескенді жек көрмеймін...
Dialogue: 0,0:17:53.07,0:17:55.94,Default,,0,0,0,,Мен аздап дөрекімін.
Dialogue: 0,0:17:57.03,0:17:59.45,Default,,0,0,0,,Мен өзімнің басқа нұсқамды көргім келеді
Dialogue: 0,0:17:59.53,0:18:00.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:01.99,0:18:02.87,Default,,0,0,0,,Хаа!
Dialogue: 0,0:18:05.20,0:18:06.58,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:18:08.42,0:18:09.33,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:18:10.17,0:18:12.84,Default,,0,0,0,,Соққы толқыны! ? Бірақ...
Dialogue: 0,0:18:12.92,0:18:14.55,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:18:15.59,0:18:19.30,Default,,0,0,0,,Эй... сәл күте тұрыңыз! Не? Бұл көрініс!
Dialogue: 0,0:18:19.38,0:18:21.47,Default,,0,0,0,,Ми... бұл купальник!
Dialogue: 0,0:18:21.55,0:18:22.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:22.47,0:18:24.43,Default,,0,0,0,,Содан бері ол купальник киіп жүр.
Dialogue: 0,0:18:24.52,0:18:28.14,Default,,0,0,0,,Иә... Иә! Қарама! Ұят...
Dialogue: 0,0:18:28.23,0:18:29.98,Default,,0,0,0,,Не болды? Эльза
Dialogue: 0,0:18:30.06,0:18:31.61,Default,,0,0,0,,Бірдеңе дұрыс емес!
Dialogue: 0,0:18:31.69,0:18:34.86,Default,,0,0,0,,Енді жалғастырайық.
Dialogue: 0,0:18:34.94,0:18:35.94,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:18:36.03,0:18:39.40,Default,,0,0,0,,Та... маған көмектес! Мені өлтірме!
Dialogue: 0,0:18:39.49,0:18:41.37,Default,,0,0,0,,- (Люси) Аа... - Эльза!
Dialogue: 0,0:18:41.45,0:18:45.16,Default,,0,0,0,,«Маған көмектесші, Кирия-сама», солай ма?
Dialogue: 0,0:18:45.24,0:18:48.37,Default,,0,0,0,,Маған көмектесші, Кирия-сама.
Dialogue: 0,0:18:48.46,0:18:49.58,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:18:49.67,0:18:52.54,Default,,0,0,0,,Эльза... не болды?
Dialogue: 0,0:18:52.63,0:18:54.50,Default,,0,0,0,,Мен оны кесіп алдым.
Dialogue: 0,0:18:54.59,0:18:56.30,Default,,0,0,0,,«Күш»
Dialogue: 0,0:18:57.05,0:19:01.09,Default,,0,0,0,,Ууууу... мені кешірші... өтінемін...
Dialogue: 0,0:19:01.18,0:19:03.22,Default,,0,0,0,,Эльза-сан, мықты бол!
Dialogue: 0,0:19:03.30,0:19:04.35,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:19:04.43,0:19:08.23,Default,,0,0,0,,Мықты қылышшы да осындай болып кетсе сүйкімді болар еді.
Dialogue: 0,0:19:08.31,0:19:09.39,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:19:10.02,0:19:13.69,Default,,0,0,0,,Сіз ұзын емессіз бе?
Dialogue: 0,0:19:14.86,0:19:16.11,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:19:16.86,0:19:20.24,Default,,0,0,0,,Ой... ауырады... ауырады
Dialogue: 0,0:19:20.32,0:19:23.20,Default,,0,0,0,,Эльзадан аулақ болыңыз!
Dialogue: 0,0:19:24.83,0:19:25.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:25.78,0:19:28.66,Default,,0,0,0,,Айдаһар өлтіруші! ? Осындай бала ма?
Dialogue: 0,0:19:28.75,0:19:29.87,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:30.46,0:19:34.08,Default,,0,0,0,,Кішкентай болса да, Вэнди керемет сиқыршы!
Dialogue: 0,0:19:35.21,0:19:36.96,Default,,0,0,0,,Кіші болу маңызды емес!
Dialogue: 0,0:19:37.05,0:19:37.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:38.51,0:19:39.63,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:40.84,0:19:42.59,Default,,0,0,0,,Бұл кішкентай қулық
Dialogue: 0,0:19:42.68,0:19:46.05,Default,,0,0,0,,Мм... «Кішкентай, кішкентай» Бұл аздап шулы.
Dialogue: 0,0:19:47.47,0:19:48.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:48.97,0:19:50.98,Default,,0,0,0,,Айдаһардың жыртылуы!
Dialogue: 0,0:19:51.48,0:19:54.15,Default,,0,0,0,,- (Люси) Ах! -Эльза!
Dialogue: 0,0:19:54.23,0:19:55.48,Default,,0,0,0,,- (Карамир) Ахх... - (Бақытты) Ахх!
Dialogue: 0,0:19:55.56,0:19:56.61,Default,,0,0,0,,Карамир Қауіпті!
Dialogue: 0,0:19:56.69,0:19:58.53,Default,,0,0,0,,Су құдай!
Dialogue: 0,0:20:05.28,0:20:08.45,Default,,0,0,0,,Мен қия алмайтын ештеңе жоқ дедім.
Dialogue: 0,0:20:09.24,0:20:10.62,Default,,0,0,0,,Мұздағы макияж...
Dialogue: 0,0:20:10.70,0:20:12.00,Default,,0,0,0,,Лансерлер!
Dialogue: 0,0:20:12.71,0:20:13.83,Default,,0,0,0,,Балға!
Dialogue: 0,0:20:16.38,0:20:20.51,Default,,0,0,0,,Күлді күлге айналдырады Менің жыным бәрін күлге айналдырады...
Dialogue: 0,0:20:23.05,0:20:24.93,Default,,0,0,0,,Не? Бұл сиқыр
Dialogue: 0,0:20:25.01,0:20:25.84,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:20:26.93,0:20:28.60,Default,,0,0,0,,Hyuma Zero no Tachi!
Dialogue: 0,0:20:31.06,0:20:34.52,Default,,0,0,0,,Күл немесе басқасы, қатқанның бәрі қатып қалады.
Dialogue: 0,0:20:35.02,0:20:36.27,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:20:36.36,0:20:38.98,Default,,0,0,0,,Бірақ бұл теңіз немесе мұз болсын -
Dialogue: 0,0:20:39.07,0:20:42.74,Default,,0,0,0,,Пішіні бар заттар да күлге айналады
Dialogue: 0,0:20:43.57,0:20:45.41,Default,,0,0,0,,Айдаһар қаңқасының күлі!
Dialogue: 0,0:20:47.45,0:20:48.62,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:20:48.70,0:20:52.08,Default,,0,0,0,,Бәрі жоғалып, күлге айналып, шіриді!
Dialogue: 0,0:20:52.16,0:20:54.21,Default,,0,0,0,,Қандай сиқыр!
Dialogue: 0,0:20:54.29,0:20:56.58,Default,,0,0,0,,Бұлай жалғаса берсе, Эльмина да жоқ болады!
Dialogue: 0,0:20:57.58,0:20:58.75,Default,,0,0,0,,Мұздағы макияж...
Dialogue: 0,0:20:59.38,0:21:00.63,Default,,0,0,0,,Күміс әлем (Күміс)!
Dialogue: 0,0:21:00.71,0:21:02.13,Default,,0,0,0,,Мұз күлге айналады
Dialogue: 0,0:21:02.21,0:21:04.22,Default,,0,0,0,,Мына күлді қатыр!
Dialogue: 0,0:21:04.30,0:21:06.30,Default,,0,0,0,,Бұл сиқырлы күш...
Dialogue: 0,0:21:06.39,0:21:09.18,Default,,0,0,0,,Жын факторы? Қызық
Dialogue: 0,0:21:09.26,0:21:13.68,Default,,0,0,0,,Бірақ біздің негізгі тамағымыз – жындар емес, айдаһар.
Dialogue: 0,0:21:13.77,0:21:17.65,Default,,0,0,0,,Тамақ ішпей дастарханнан шығуыма рұқсат етіңіз.
Dialogue: 0,0:21:20.77,0:21:23.07,Default,,0,0,0,,Қара күл!
Dialogue: 0,0:21:23.15,0:21:25.78,Default,,0,0,0,,Ах! Ах... Ах...
Dialogue: 0,0:21:34.50,0:21:36.87,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:21:37.67,0:21:39.84,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:21:39.92,0:21:41.25,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:21:41.34,0:21:44.46,Default,,0,0,0,,Ювия! Жаңбыр, бірдеңе істе!
Dialogue: 0,0:21:44.55,0:21:46.47,Default,,0,0,0,,Бұл Ювияның кінәсі емес!
Dialogue: 0,0:21:46.55,0:21:48.39,Default,,0,0,0,,Бұл да Ювияның кінәсі емес!
Dialogue: 0,0:21:48.47,0:21:49.76,Default,,0,0,0,,Жетеді
Dialogue: 0,0:21:49.85,0:21:51.18,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:21:51.60,0:21:53.14,Default,,0,0,0,,Ммм... Хмф!
Dialogue: 0,0:21:53.22,0:21:54.22,Default,,0,0,0,,Ахх...
Dialogue: 0,0:21:54.31,0:21:57.06,Default,,0,0,0,,Менің болжауымша, ол ұзақ уақытқа созылады.
Dialogue: 0,0:21:57.14,0:21:58.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:01.15,0:22:02.57,Default,,0,0,0,,♪ Нацу-сама
