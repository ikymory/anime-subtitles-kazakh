Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.25,0:00:05.88,Default,,0,0,0,,Венди! Тез бірдеңе жасаңыз!
Dialogue: 0,0:00:05.96,0:00:07.29,Default,,0,0,0,,Жоқ! Мен қимылдай алмаймын!
Dialogue: 0,0:00:07.75,0:00:08.75,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:00:08.84,0:00:11.09,Default,,0,0,0,,Өз күшіңізді алыңыз
Dialogue: 0,0:00:11.17,0:00:13.34,Default,,0,0,0,,Жел айдаһары жейді
Dialogue: 0,0:00:13.43,0:00:16.14,Default,,0,0,0,,Бұл жел емес, Тенрю!
Dialogue: 0,0:00:16.22,0:00:18.10,Default,,0,0,0,,Гуру Гуру Гуру…
Dialogue: 0,0:00:18.18,0:00:19.81,Default,,0,0,0,,Ахх...
Dialogue: 0,0:00:20.35,0:00:21.77,Default,,0,0,0,,Гуру Гуру…
Dialogue: 0,0:00:21.85,0:00:23.52,Default,,0,0,0,,Шар…
Dialogue: 0,0:00:24.10,0:00:25.27,Default,,0,0,0,,Венди!
Dialogue: 0,0:00:25.35,0:00:27.90,Default,,0,0,0,,Қараңызшы, мен енді тыныс ала алмаймын.
Dialogue: 0,0:00:27.98,0:00:30.23,Default,,0,0,0,,Венди! (Вэнди жылайды)
Dialogue: 0,0:00:30.32,0:00:32.19,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:00:33.19,0:00:34.57,Default,,0,0,0,,Венди!
Dialogue: 0,0:00:35.61,0:00:36.53,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:00:36.61,0:00:39.49,Default,,0,0,0,,-Ах! -Бұл жігіт...
Dialogue: 0,0:00:40.33,0:00:41.91,Default,,0,0,0,,Иә! Хмм!
Dialogue: 0,0:00:42.41,0:00:43.37,Default,,0,0,0,,Ннн…
Dialogue: 0,0:00:44.91,0:00:46.79,Default,,0,0,0,,Пуха~!
Dialogue: 0,0:00:47.25,0:00:49.04,Default,,0,0,0,,Енді менің кезегім!
Dialogue: 0,0:00:49.13,0:00:51.50,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:00:51.59,0:00:52.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:52.84,0:00:54.84,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:00:54.92,0:00:56.84,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,0:00:56.93,0:00:59.30,Default,,0,0,0,,Мен бар күшімді саламын...
Dialogue: 0,0:00:59.39,0:01:01.01,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:01:01.10,0:01:04.98,Default,,0,0,0,,Айналса да бұл жігіт қозғалды.
Dialogue: 0,0:01:05.73,0:01:07.90,Default,,0,0,0,,Хаха!
Dialogue: 0,0:01:08.40,0:01:14.40,Default,,0,0,0,,♪~
Dialogue: 0,0:02:31.31,0:02:36.57,Default,,0,0,0,,~♪
Dialogue: 0,0:02:40.49,0:02:41.82,Default,,0,0,0,,(тілді жалау дыбысы)
Dialogue: 0,0:02:41.91,0:02:45.03,Default,,0,0,0,,-Мына жігіт дәмді көрінеді -Ой?
Dialogue: 0,0:02:45.12,0:02:47.33,Default,,0,0,0,,Араласпаңыз
Dialogue: 0,0:02:47.41,0:02:50.29,Default,,0,0,0,,Эльзаны нысанаға алсаң, мен де сені жау санаймын.
Dialogue: 0,0:02:50.96,0:02:53.25,Default,,0,0,0,,Ол неге бұл қалада...
Dialogue: 0,0:02:53.75,0:02:56.55,Default,,0,0,0,,Ха... Сіз Олдронды жеуді жоспарлап отырсыз ба?
Dialogue: 0,0:02:57.55,0:03:00.51,Default,,0,0,0,,...Бұл қалада басқа адамдар да бар деген сөз.
Dialogue: 0,0:03:01.01,0:03:06.26,Default,,0,0,0,,Екі гильдия, Fairy Tail және Diabolos, орбитаға ұмтылуда...
Dialogue: 0,0:03:06.89,0:03:08.47,Default,,0,0,0,,Іс күрделене түсуде.
Dialogue: 0,0:03:09.43,0:03:11.23,Default,,0,0,0,,Иә... Орб?
Dialogue: 0,0:03:13.65,0:03:16.27,Default,,0,0,0,,Оның көлемін ескерсек, оны қолыңызға алып жүруге болатын сияқты.
Dialogue: 0,0:03:17.69,0:03:20.78,Default,,0,0,0,,Олар бір-біріне қарап тұрғанда оны бекітіңіз!
Dialogue: 0,0:03:24.16,0:03:25.95,Default,,0,0,0,,Кешіріңіз Люси
Dialogue: 0,0:03:26.41,0:03:29.08,Default,,0,0,0,,Сіз қиындата аласыз ба?
Dialogue: 0,0:03:29.16,0:03:30.25,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:03:30.33,0:03:33.42,Default,,0,0,0,,Енді Люсидің кезегі.
Dialogue: 0,0:03:33.50,0:03:35.50,Default,,0,0,0,,Бұл Ханның жазасы!
Dialogue: 0,0:03:35.96,0:03:36.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:37.05,0:03:39.09,Default,,0,0,0,,Локи мен Варгоны жабыңыз!
Dialogue: 0,0:03:39.17,0:03:40.17,Default,,0,0,0,,Af…
Dialogue: 0,0:03:40.26,0:03:41.88,Default,,0,0,0,,Толығырақ!
Dialogue: 0,0:03:42.68,0:03:45.09,Default,,0,0,0,,Ашық! Алтын өгіз сарайының есігі!
Dialogue: 0,0:03:45.89,0:03:46.97,Default,,0,0,0,,Телец!
Dialogue: 0,0:03:47.68,0:03:49.52,Default,,0,0,0,,NMO!
Dialogue: 0,0:03:51.43,0:03:54.48,Default,,0,0,0,,Күтілгендей, Tauros пішіні ең жақсы!
Dialogue: 0,0:03:54.65,0:03:57.44,Default,,0,0,0,,Эльфман үшін бірдей қуат түріндегі жұлдызды рухты пайдаланыңыз!
Dialogue: 0,0:03:57.52,0:03:59.19,Default,,0,0,0,,Мира - Егіздер!
Dialogue: 0,0:03:59.65,0:04:00.99,Default,,0,0,0,,Пири Пири!
Dialogue: 0,0:04:01.53,0:04:02.82,Default,,0,0,0,,Лизаннаға айналдыр!
Dialogue: 0,0:04:02.90,0:04:04.24,Default,,0,0,0,,Пили!
Dialogue: 0,0:04:05.45,0:04:06.78,Default,,0,0,0,,Мира әпке
Dialogue: 0,0:04:06.87,0:04:08.24,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:09.33,0:04:11.50,Default,,0,0,0,,Мираның жалғыз кемшілігі!
Dialogue: 0,0:04:11.58,0:04:15.42,Default,,0,0,0,,Мен оның жалған екенін білсем де, шабуыл жасай алмаймын!
Dialogue: 0,0:04:15.50,0:04:17.92,Default,,0,0,0,,Мира-ни!
Dialogue: 0,0:04:19.84,0:04:20.92,Default,,0,0,0,,Пиккири!
Dialogue: 0,0:04:21.01,0:04:22.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:22.30,0:04:23.38,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:23.47,0:04:24.84,Default,,0,0,0,,MO fu!
Dialogue: 0,0:04:25.59,0:04:27.30,Default,,0,0,0,,Тағы кездесейік
Dialogue: 0,0:04:27.85,0:04:31.47,Default,,0,0,0,,Сіз айдаһар тұрған жердесіз бе?
Dialogue: 0,0:04:31.56,0:04:33.23,Default,,0,0,0,,Fairy Tail (Fairy Tail)
Dialogue: 0,0:04:33.31,0:04:34.52,Default,,0,0,0,,Диаболос...
Dialogue: 0,0:04:35.23,0:04:36.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:39.98,0:04:43.74,Default,,0,0,0,,Сіз Лизаннаны өшірдіңіз.
Dialogue: 0,0:04:44.36,0:04:45.70,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:04:45.78,0:04:47.37,Default,,0,0,0,,Мира-сан...
Dialogue: 0,0:04:49.58,0:04:50.66,Default,,0,0,0,,Хаа!
Dialogue: 0,0:04:52.00,0:04:53.20,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:54.41,0:04:56.33,Default,,0,0,0,,Гуаааа!
Dialogue: 0,0:04:56.42,0:04:57.79,Default,,0,0,0,,(Итеру дыбысы)
Dialogue: 0,0:04:59.88,0:05:02.30,Default,,0,0,0,,Не? Бұл қаттылық
Dialogue: 0,0:05:02.38,0:05:03.92,Default,,0,0,0,,Құрыш айдаһар
Dialogue: 0,0:05:07.68,0:05:08.89,Default,,0,0,0,,Хаа!
Dialogue: 0,0:05:14.06,0:05:17.65,Default,,0,0,0,,Ха... Ол шапқан жер күлге айналды!
Dialogue: 0,0:05:19.69,0:05:20.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:21.48,0:05:23.53,Default,,0,0,0,,Шабуылдар күлге әсер етпейді.
Dialogue: 0,0:05:24.61,0:05:25.99,Default,,0,0,0,,Хааа...
Dialogue: 0,0:05:28.53,0:05:30.07,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:05:32.95,0:05:34.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:34.41,0:05:35.54,Default,,0,0,0,,Мира!
Dialogue: 0,0:05:36.96,0:05:38.04,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:05:39.29,0:05:41.84,Default,,0,0,0,,Мен Люсиді ұстадым!
Dialogue: 0,0:05:41.92,0:05:43.30,Default,,0,0,0,,Уф... у...
Dialogue: 0,0:05:43.38,0:05:44.59,Default,,0,0,0,,Лисанна!
Dialogue: 0,0:05:44.67,0:05:47.13,Default,,0,0,0,,Жануардың жаны жылан
Dialogue: 0,0:05:47.22,0:05:50.22,Default,,0,0,0,,Бұл маған ұнамайды.
Dialogue: 0,0:05:50.72,0:05:53.51,Default,,0,0,0,,Уф... бұлай жасайтын уақыт емес!
Dialogue: 0,0:05:53.97,0:05:57.73,Default,,0,0,0,,Бұл жігіттер айбатты жаулар! Бірге жұмыс жасамасақ...
Dialogue: 0,0:05:57.81,0:05:58.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:58.98,0:06:04.98,Default,,0,0,0,,Ақ доктринаңызды бұзған адаммен күресудің екі жолы бар.
Dialogue: 0,0:06:05.57,0:06:07.49,Default,,0,0,0,,Бірі - орындау.
Dialogue: 0,0:06:07.57,0:06:11.95,Default,,0,0,0,,Көп жылдар бойы қуаныш пен қайғыны бөліскен достарыма айту батылдықты қажет ететін шешім.
Dialogue: 0,0:06:12.03,0:06:14.33,Default,,0,0,0,,Уф... ауырады...
Dialogue: 0,0:06:14.66,0:06:16.91,Default,,0,0,0,,Екіншісі – ақ түске бояу.
Dialogue: 0,0:06:17.00,0:06:19.21,Default,,0,0,0,,Қайтадан дос болайық
Dialogue: 0,0:06:19.29,0:06:20.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:21.79,0:06:24.63,Default,,0,0,0,,-(Лисанна) Маған екіншісі ұнайды -(Люси) А...
Dialogue: 0,0:06:24.71,0:06:26.51,Default,,0,0,0,,Сәлем Люси
Dialogue: 0,0:06:26.59,0:06:29.26,Default,,0,0,0,,Менің көзіме қара, олар ағарсын
Dialogue: 0,0:06:30.09,0:06:31.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:32.18,0:06:33.76,Default,,0,0,0,,Ақ...
Dialogue: 0,0:06:33.85,0:06:36.10,Default,,0,0,0,,Иә, Люси
Dialogue: 0,0:06:36.18,0:06:37.73,Default,,0,0,0,,Ақ бірге...
Dialogue: 0,0:06:38.73,0:06:39.56,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:06:39.64,0:06:41.02,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:41.85,0:06:43.36,Default,,0,0,0,,Жүзді айдаһар...
Dialogue: 0,0:06:44.15,0:06:45.53,Default,,0,0,0,,Жырт!
Dialogue: 0,0:06:45.61,0:06:46.65,Default,,0,0,0,,Ах…
Dialogue: 0,0:06:47.07,0:06:48.32,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:06:50.86,0:06:52.78,Default,,0,0,0,,Мен қия алмайтын ештеңе жоқ!
Dialogue: 0,0:06:57.66,0:06:59.04,Default,,0,0,0,,Қазір!
Dialogue: 0,0:07:00.21,0:07:01.25,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:03.42,0:07:04.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:04.59,0:07:05.71,Default,,0,0,0,,Жыланды байлау
Dialogue: 0,0:07:05.80,0:07:07.00,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:07.71,0:07:11.13,Default,,0,0,0,,Сіздің физикалық еркіндігіңіз алынып тасталды.
Dialogue: 0,0:07:11.22,0:07:14.18,Default,,0,0,0,,- (Джерар) Екеуміз кеттік! -Қайда! ?
Dialogue: 0,0:07:14.26,0:07:16.93,Default,,0,0,0,,Мұндай нәрсені істеу немесе жасау ...
Dialogue: 0,0:07:17.01,0:07:20.35,Default,,0,0,0,,Жүр, мен сені ақ түске бояймын!
Dialogue: 0,0:07:21.19,0:07:23.94,Default,,0,0,0,,Кел, Жерар! Жіберу!
Dialogue: 0,0:07:24.40,0:07:27.44,Default,,0,0,0,,Иә! Сіздің мақсатыңыз шарды жою болуы мүмкін.
Dialogue: 0,0:07:28.07,0:07:29.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:30.53,0:07:33.53,Default,,0,0,0,,Ойланып қарасам, мақсаты да сол еді.
Dialogue: 0,0:07:33.95,0:07:35.07,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:35.37,0:07:38.12,Default,,0,0,0,,Дәл қазір сізді ақ түске бояу маңыздырақ.
Dialogue: 0,0:07:38.20,0:07:41.08,Default,,0,0,0,,Шүкір... Мен қозғала алмаймын!
Dialogue: 0,0:07:41.16,0:07:44.04,Default,,0,0,0,,Жеті жұлдыздың сүйіспеншілігіне бөлен!
Dialogue: 0,0:07:44.13,0:07:46.50,Default,,0,0,0,,Ha~hahaha!
Dialogue: 0,0:07:46.59,0:07:49.96,Default,,0,0,0,,Бұл жігіт енді... жақсы емес.
Dialogue: 0,0:07:50.05,0:07:52.05,Default,,0,0,0,,(Бақыттының үрейлі дауысы)
Dialogue: 0,0:07:52.93,0:07:54.64,Default,,0,0,0,,Бұл елес пе?
Dialogue: 0,0:07:54.72,0:07:56.47,Default,,0,0,0,,Сіз өліп қалдыңыз ба?
Dialogue: 0,0:07:56.55,0:07:57.60,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:58.10,0:08:01.56,Default,,0,0,0,,Нацу кіммен сөйлесіп тұрсың...
Dialogue: 0,0:08:01.64,0:08:04.44,Default,,0,0,0,,- Мм... - (Бақытты) Не істеп жатырсың? Нацу
Dialogue: 0,0:08:04.81,0:08:06.86,Default,,0,0,0,,Елесті басу
Dialogue: 0,0:08:06.94,0:08:08.86,Default,,0,0,0,,Сіз оны көре алмайтыныңызға сенімдісіз бе? бақытты
Dialogue: 0,0:08:08.94,0:08:10.65,Default,,0,0,0,,Мен ештеңе көрмеймін!
Dialogue: 0,0:08:10.74,0:08:12.15,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,0:08:12.24,0:08:15.49,Default,,0,0,0,,Егер шынымен елес болса, қарғысқа ұшырайсың!
Dialogue: 0,0:08:15.57,0:08:18.66,Default,,0,0,0,,Шынымен сіз ғана көре аласыз ба?
Dialogue: 0,0:08:19.66,0:08:22.62,Default,,0,0,0,,Оны Айдаһар өлтіруші көріп тұрған сияқты.
Dialogue: 0,0:08:22.87,0:08:25.21,Default,,0,0,0,,Сондықтан мен Диаболостамын
Dialogue: 0,0:08:25.83,0:08:27.96,Default,,0,0,0,,Елестер аш бола ма?
Dialogue: 0,0:08:28.04,0:08:31.96,Default,,0,0,0,,Ол азаймайды. Мен айдаһарларды жеймін, өйткені мен билік алғым келеді.
Dialogue: 0,0:08:32.88,0:08:35.93,Default,,0,0,0,,Нацу шынымен бірдеңе туралы айтып жатыр...
Dialogue: 0,0:08:36.01,0:08:39.68,Default,,0,0,0,,Мұны айтудың мәні неде? Буддалыққа барыңыз.
Dialogue: 0,0:08:39.93,0:08:41.27,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:08:42.02,0:08:45.77,Default,,0,0,0,,Өмірімді алған адамды тапқанша.
Dialogue: 0,0:08:45.85,0:08:49.77,Default,,0,0,0,,Мен оған дейін күштірек болуым керек...
Dialogue: 0,0:08:51.73,0:08:53.11,Default,,0,0,0,,Айдаһар рухы
Dialogue: 0,0:08:54.65,0:08:56.11,Default,,0,0,0,,Ах... Ха! ?
Dialogue: 0,0:08:56.99,0:08:58.37,Default,,0,0,0,,Ақыры ұстадым сені, Дио!
Dialogue: 0,0:08:58.45,0:08:59.74,Default,,0,0,0,,Нацу~!
Dialogue: 0,0:08:59.83,0:09:03.29,Default,,0,0,0,,Бұл не? Кенет ақ жалын...
Dialogue: 0,0:09:03.79,0:09:05.71,Default,,0,0,0,,От емес, жан
Dialogue: 0,0:09:05.79,0:09:09.34,Default,,0,0,0,,Бірақ сен мені ести алмайсың
Dialogue: 0,0:09:09.42,0:09:11.80,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:09:11.88,0:09:15.26,Default,,0,0,0,,Жан... жылап жатыр
Dialogue: 0,0:09:15.34,0:09:17.18,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:21.26,0:09:23.14,Default,,0,0,0,,Нацу~!
Dialogue: 0,0:09:25.77,0:09:26.60,Default,,0,0,0,,Нацу...
Dialogue: 0,0:09:27.69,0:09:29.02,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:31.61,0:09:34.74,Default,,0,0,0,,Сенің күшің менікі болады.
Dialogue: 0,0:09:37.78,0:09:39.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:40.20,0:09:43.41,Default,,0,0,0,,Нацу... Соққыға ұшырадың ба?
Dialogue: 0,0:09:44.04,0:09:47.37,Default,,0,0,0,,Қайда? жау қайда?
Dialogue: 0,0:09:48.04,0:09:51.34,Default,,0,0,0,,Сіз көрмейсіз және естімейсіз
Dialogue: 0,0:09:52.13,0:09:55.80,Default,,0,0,0,,Жүр, оның жанын алайық.
Dialogue: 0,0:09:55.88,0:09:59.26,Default,,0,0,0,,Нацу! Оян, Нацу!
Dialogue: 0,0:09:59.34,0:10:02.22,Default,,0,0,0,,Нацу! Нацу!
Dialogue: 0,0:10:03.06,0:10:05.68,Default,,0,0,0,,Ол әлдеқашан өлген
Dialogue: 0,0:10:17.40,0:10:18.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:19.11,0:10:19.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:20.03,0:10:22.41,Default,,0,0,0,,Иә? Бұл қайда? мұнда
Dialogue: 0,0:10:23.33,0:10:26.16,Default,,0,0,0,,Хмм... бұл не? бұл жер
Dialogue: 0,0:10:26.25,0:10:27.20,Default,,0,0,0,,Бұлттардың үстінде?
Dialogue: 0,0:10:27.29,0:10:30.25,Default,,0,0,0,,(секіру дыбысы)
Dialogue: 0,0:10:31.13,0:10:33.50,Default,,0,0,0,,Уау, жақсы сезінеді...
Dialogue: 0,0:10:33.59,0:10:34.96,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:10:35.05,0:10:36.46,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:10:36.55,0:10:39.93,Default,,0,0,0,,-Елеспен күресу -Ха...
Dialogue: 0,0:10:40.01,0:10:42.89,Default,,0,0,0,,Біраз уақыт болды, Нацу.
Dialogue: 0,0:10:43.39,0:10:45.35,Default,,0,0,0,,Ха... Зереф!
Dialogue: 0,0:10:45.43,0:10:47.48,Default,,0,0,0,,Не... Иә?
Dialogue: 0,0:10:47.85,0:10:51.06,Default,,0,0,0,,Сіз өлген болуыңыз керек сияқтысыз.
Dialogue: 0,0:10:51.60,0:10:53.31,Default,,0,0,0,,Иә, ол қайтыс болды.
Dialogue: 0,0:10:53.81,0:10:56.40,Default,,0,0,0,,Өлместіктің қарғысынан құтыл.
Dialogue: 0,0:10:56.48,0:10:58.78,Default,,0,0,0,,Мм... мм?
Dialogue: 0,0:10:58.86,0:11:02.28,Default,,0,0,0,,Өлген адамдарды кездестіруге болатын жерлер туралы айтсақ...
Dialogue: 0,0:11:02.37,0:11:05.99,Default,,0,0,0,,Түсіндің бе? бұл қайда
Dialogue: 0,0:11:06.08,0:11:06.91,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:11:06.99,0:11:08.45,Default,,0,0,0,,Тозақ! ?
Dialogue: 0,0:11:08.95,0:11:11.79,Default,,0,0,0,,Сіз аспан туралы білмейсіз бе?
Dialogue: 0,0:11:11.87,0:11:13.83,Default,,0,0,0,,Өйткені сіз осындасыз!
Dialogue: 0,0:11:14.71,0:11:17.71,Default,,0,0,0,,Бұл жұмақ та емес, тозақ та емес...
Dialogue: 0,0:11:17.80,0:11:19.55,Default,,0,0,0,,Ұқсас орын
Dialogue: 0,0:11:19.63,0:11:22.64,Default,,0,0,0,,Бұл менің осында екенімді білдіреді...
Dialogue: 0,0:11:23.68,0:11:26.06,Default,,0,0,0,,Мен өлдім бе?
Dialogue: 0,0:11:26.14,0:11:28.93,Default,,0,0,0,,Хмм... сіз қалай ойлайсыз?
Dialogue: 0,0:11:29.02,0:11:31.85,Default,,0,0,0,,Сіз өлімге өте жақын күйде тұрған сияқтысыз...
Dialogue: 0,0:11:31.94,0:11:34.06,Default,,0,0,0,,Ол әрең өлген сияқты.
Dialogue: 0,0:11:34.15,0:11:36.90,Default,,0,0,0,,Не! Сол нәзік сезім!
Dialogue: 0,0:11:37.40,0:11:40.24,Default,,0,0,0,,Мен оны тек осылай айта аламын.
Dialogue: 0,0:11:41.28,0:11:44.41,Default,,0,0,0,,Расында да бұл өлілер жиналатын дүние.
Dialogue: 0,0:11:44.49,0:11:45.53,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:45.62,0:11:47.03,Default,,0,0,0,,Бірақ сирек жағдайларда—
Dialogue: 0,0:11:47.12,0:11:50.96,Default,,0,0,0,,Кейбір адамдар, егер олардың болашағы әлі шешілмеген болса, бізге келуі мүмкін.
Dialogue: 0,0:11:51.54,0:11:53.92,Default,,0,0,0,,Нацу сен сияқты
Dialogue: 0,0:11:55.00,0:11:56.88,Default,,0,0,0,,(Жан) Не…
Dialogue: 0,0:11:59.42,0:12:01.30,Default,,0,0,0,,-Бірінші ұрпақ~! -Апыр-ай!
Dialogue: 0,0:12:01.84,0:12:03.05,Default,,0,0,0,,Ол тірі еді!
Dialogue: 0,0:12:03.13,0:12:06.01,Default,,0,0,0,,Жоқ, мен өліп қалдым.
Dialogue: 0,0:12:06.10,0:12:08.76,Default,,0,0,0,,Менің әйеліме тіл тигізбе.
Dialogue: 0,0:12:09.27,0:12:11.06,Default,,0,0,0,,А... әйелі?
Dialogue: 0,0:12:12.31,0:12:13.39,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:12:13.48,0:12:14.31,Default,,0,0,0,,Иә
Dialogue: 0,0:12:15.56,0:12:19.78,Default,,0,0,0,,Эй, сәлем айтшы, Август Ларкейд.
Dialogue: 0,0:12:19.86,0:12:21.78,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:12:21.86,0:12:23.74,Default,,0,0,0,,Танысқаныма қуаныштымын, ағай.
Dialogue: 0,0:12:23.82,0:12:25.70,Default,,0,0,0,,Нгаа!
Dialogue: 0,0:12:25.78,0:12:28.16,Default,,0,0,0,,- (Ларкад) Хэхехехе... -Ол біздің бала.
Dialogue: 0,0:12:28.66,0:12:30.62,Default,,0,0,0,,- (тамыз) Хахаха... -Екеуі де бұзылған балалар.
Dialogue: 0,0:12:32.16,0:12:33.58,Default,,0,0,0,,(Жан) Не…
Dialogue: 0,0:12:36.71,0:12:41.80,Default,,0,0,0,,Мен тірі кезімде саған осындай сұмдық жасадым.
Dialogue: 0,0:12:41.88,0:12:45.59,Default,,0,0,0,,Бұл дүниеде мен бақытты өмір сүремін.
Dialogue: 0,0:12:46.05,0:12:48.35,Default,,0,0,0,,Бұл күрделі сезім болуы керек.
Dialogue: 0,0:12:48.64,0:12:50.18,Default,,0,0,0,,Мен шынымен...
Dialogue: 0,0:12:50.26,0:12:53.93,Default,,0,0,0,,Бірақ сен мені кешірдің деп ойлаймын.
Dialogue: 0,0:12:54.02,0:12:55.52,Default,,0,0,0,,Өйткені ол мейірімді адам
Dialogue: 0,0:12:56.23,0:12:59.90,Default,,0,0,0,,Бірақ сіз мені кешірсеңіз де...
Dialogue: 0,0:12:59.98,0:13:02.82,Default,,0,0,0,,Менің кесірімнен бақытсыз болған адам.
Dialogue: 0,0:13:02.90,0:13:06.11,Default,,0,0,0,,Өлген адамдар мені кешіре алмайды
Dialogue: 0,0:13:06.41,0:13:07.91,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:13:07.99,0:13:10.87,Default,,0,0,0,,Бұл менің күнәм
Dialogue: 0,0:13:11.29,0:13:14.16,Default,,0,0,0,,Менің ойымша, ол мұнда жоқ әлемде сотталып жатыр.
Dialogue: 0,0:13:14.91,0:13:18.42,Default,,0,0,0,,Ха... Не айтып тұрғаныңызды мүлде түсінбеймін.
Dialogue: 0,0:13:19.25,0:13:22.17,Default,,0,0,0,,Бұл жер жұмақ та емес, тозақ та емес
Dialogue: 0,0:13:22.25,0:13:24.59,Default,,0,0,0,,Ақырғы өмір болмаса...
Dialogue: 0,0:13:24.67,0:13:29.39,Default,,0,0,0,,Арғы дүние, тозақ елі, ол тіпті ондай жер емес.
Dialogue: 0,0:13:30.10,0:13:31.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:31.43,0:13:35.98,Default,,0,0,0,,Тек саған... Нацудың рухани аспаны
Dialogue: 0,0:13:36.44,0:13:38.81,Default,,0,0,0,,Оны «Бета аспан» деп атаймыз ба?
Dialogue: 0,0:13:40.65,0:13:44.28,Default,,0,0,0,,Бұл сіздің санаңызда ұйықтап жатқан аспан бейнесі.
Dialogue: 0,0:13:45.36,0:13:49.74,Default,,0,0,0,,Демек, қанша адам болса, сонша бета аспан бар деп айтуға болады.
Dialogue: 0,0:13:50.57,0:13:53.91,Default,,0,0,0,,Менің шын жаным, Мавис, т.б.
Dialogue: 0,0:13:53.99,0:13:56.96,Default,,0,0,0,,Өлгеннен кейін не болатынын білмейміз.
Dialogue: 0,0:13:57.29,0:14:00.71,Default,,0,0,0,,Сіз осы Бета аспан сияқты өмір сүріп жатырсыз ба?
Dialogue: 0,0:14:00.79,0:14:02.67,Default,,0,0,0,,Ол жоғалып кетті ме?
Dialogue: 0,0:14:02.75,0:14:06.63,Default,,0,0,0,,-Менің аспан бейнесі? -Дұрыс.
Dialogue: 0,0:14:06.72,0:14:08.76,Default,,0,0,0,,Бұл біртүрлі болуы керек.
Dialogue: 0,0:14:08.84,0:14:10.47,Default,,0,0,0,,Мен елестететін аспан –
Dialogue: 0,0:14:10.55,0:14:13.93,Default,,0,0,0,,Ол көбірек жалынға оранып, айдаһарлар көбірек...
Dialogue: 0,0:14:14.01,0:14:16.48,Default,,0,0,0,,Бұл тозаққа ұқсайды.
Dialogue: 0,0:14:16.98,0:14:17.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:17.98,0:14:19.10,Default,,0,0,0,,Айдаһар!
Dialogue: 0,0:14:20.35,0:14:22.57,Default,,0,0,0,,осында болады
Dialogue: 0,0:14:22.65,0:14:24.57,Default,,0,0,0,,Ха... Игниль
Dialogue: 0,0:14:24.65,0:14:29.03,Default,,0,0,0,,Бұл бейсаналық әлем екенін айттым.
Dialogue: 0,0:14:29.11,0:14:31.20,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,0:14:31.28,0:14:35.70,Default,,0,0,0,,Сенің жүрегіңде мен, Зереф және Мавис...
Dialogue: 0,0:14:35.79,0:14:38.16,Default,,0,0,0,,Барлығы бақытты өмір сүреді
Dialogue: 0,0:14:38.25,0:14:42.63,Default,,0,0,0,,Сондай-ақ бұл жерде Атлас жалыны мен цирконис бар.
Dialogue: 0,0:14:43.13,0:14:44.88,Default,,0,0,0,,Люсидің ата-анасы...
Dialogue: 0,0:14:44.96,0:14:48.59,Default,,0,0,0,,Менің кейбір достарым шайқаста қаза тапты.
Dialogue: 0,0:14:48.67,0:14:53.05,Default,,0,0,0,,Акнология да бар шығар.
Dialogue: 0,0:14:53.14,0:14:54.93,Default,,0,0,0,,(Нацудың айқайы)
Dialogue: 0,0:14:55.01,0:14:58.18,Default,,0,0,0,,Сіз шынымен мейірімді баласыз.
Dialogue: 0,0:14:58.27,0:14:59.81,Default,,0,0,0,,Сондықтан да күшті
Dialogue: 0,0:14:59.89,0:15:03.23,Default,,0,0,0,,Енді кеттік, Нацу.
Dialogue: 0,0:15:03.48,0:15:04.98,Default,,0,0,0,,Сіз әрқашан
Dialogue: 0,0:15:05.07,0:15:08.57,Default,,0,0,0,,Біз дағдарысты мүмкіндікке айналдырып, жағдайды өзгерттік.
Dialogue: 0,0:15:08.65,0:15:12.53,Default,,0,0,0,,Бірақ бұл жолы жау елес.
Dialogue: 0,0:15:12.62,0:15:13.82,Default,,0,0,0,,Шабуыл тимейді
Dialogue: 0,0:15:13.91,0:15:16.79,Default,,0,0,0,,Не айтып тұрсың, Нацу?
Dialogue: 0,0:15:16.87,0:15:20.29,Default,,0,0,0,,Сен қазір елес сияқтысың, солай емес пе?
Dialogue: 0,0:15:20.37,0:15:21.33,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:21.83,0:15:23.92,Default,,0,0,0,,Сіз өзіңіздің бастапқы әлеміңізге оралғанда—
Dialogue: 0,0:15:24.00,0:15:27.13,Default,,0,0,0,,Мұндағы барлық естеліктер жойылады.
Dialogue: 0,0:15:27.21,0:15:30.05,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені бұл бейсаналық дүние.
Dialogue: 0,0:15:30.13,0:15:32.80,Default,,0,0,0,,Дегенмен, жадыңызды жоғалтсаңыз да—
Dialogue: 0,0:15:32.89,0:15:36.01,Default,,0,0,0,,Біз әрқашан сенің жүрегіңде боламыз
Dialogue: 0,0:15:36.76,0:15:38.89,Default,,0,0,0,,Ах... Рахмет, Игнил.
Dialogue: 0,0:15:38.97,0:15:39.98,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:15:40.06,0:15:41.77,Default,,0,0,0,,Ал бірінші буын
Dialogue: 0,0:15:41.85,0:15:44.86,Default,,0,0,0,,тамыз Ларкад та
Dialogue: 0,0:15:45.61,0:15:46.82,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:15:49.15,0:15:51.78,Default,,0,0,0,,Менің ағам да Мэвиспен жақсы дос.
Dialogue: 0,0:15:53.36,0:15:54.87,Default,,0,0,0,,Сен…
Dialogue: 0,0:15:55.24,0:15:56.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:57.12,0:15:58.70,Default,,0,0,0,,Әлі тірі
Dialogue: 0,0:15:59.50,0:16:00.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:00.96,0:16:03.54,Default,,0,0,0,,Менің жанымды жеме!
Dialogue: 0,0:16:03.62,0:16:05.50,Default,,0,0,0,,Дұрыс, болды!
Dialogue: 0,0:16:05.58,0:16:07.96,Default,,0,0,0,,Қарғыс атсын… бұл… бұл…
Dialogue: 0,0:16:08.05,0:16:10.80,Default,,0,0,0,,Нацу! Оян!
Dialogue: 0,0:16:11.63,0:16:13.26,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:13.76,0:16:14.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:14.68,0:16:18.47,Default,,0,0,0,,Бұл не?! Мен құлап жатырмын!
Dialogue: 0,0:16:19.47,0:16:20.64,Default,,0,0,0,,Ой денесі?
Dialogue: 0,0:16:20.72,0:16:22.10,Default,,0,0,0,,Нару Ходо
Dialogue: 0,0:16:22.18,0:16:25.65,Default,,0,0,0,,Мен түсінбеймін, бірақ мен де елестерді көретін шығармын.
Dialogue: 0,0:16:25.73,0:16:28.48,Default,,0,0,0,,Егер сіз менің денеме кірсеңіз, бәрі қалпына келеді ...
Dialogue: 0,0:16:28.98,0:16:30.44,Default,,0,0,0,,Жоқ, күте тұрыңыз.
Dialogue: 0,0:16:30.53,0:16:31.36,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:31.44,0:16:34.41,Default,,0,0,0,,Егер бұл елестер болса, олар бір-біріне шабуыл жасай алады!
Dialogue: 0,0:16:34.49,0:16:35.86,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,0:16:35.95,0:16:37.45,Default,,0,0,0,,Кааааа!
Dialogue: 0,0:16:37.53,0:16:41.95,Default,,0,0,0,,Менің есімде көп жоқ, бірақ маған біреу айтқан сияқты.
Dialogue: 0,0:16:42.04,0:16:44.04,Default,,0,0,0,,Сізді ойлау нысанына айналдыратын сиқыр!
Dialogue: 0,0:16:44.58,0:16:47.00,Default,,0,0,0,,Ойлау объектісіне айналып, мені...
Dialogue: 0,0:16:47.08,0:16:49.75,Default,,0,0,0,,Шабуыл! Кааааааааааааааааааааааааа!
Dialogue: 0,0:16:50.38,0:16:51.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:51.30,0:16:53.17,Default,,0,0,0,,Шабуыл жерге түседі!
Dialogue: 0,0:16:53.67,0:16:55.13,Default,,0,0,0,,Бұрынғы күйзеліс...
Dialogue: 0,0:16:55.22,0:16:58.72,Default,,0,0,0,,Оны басып, шешіңіз!
Dialogue: 0,0:16:59.30,0:17:00.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:00.43,0:17:03.68,Default,,0,0,0,,Мен таң қалдым... Мен мұндай адамды бұрын-соңды кездестірген емеспін.
Dialogue: 0,0:17:03.77,0:17:04.81,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:06.48,0:17:07.56,Default,,0,0,0,,(Бақытты жылау)
Dialogue: 0,0:17:07.65,0:17:08.86,Default,,0,0,0,,Иелену!
Dialogue: 0,0:17:09.57,0:17:10.65,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:12.74,0:17:14.49,Default,,0,0,0,,Мен адаммын...
Dialogue: 0,0:17:14.57,0:17:16.20,Default,,0,0,0,,Бұл мысық...
Dialogue: 0,0:17:16.70,0:17:19.74,Default,,0,0,0,,Адамның денесіне ие бола алады
Dialogue: 0,0:17:19.83,0:17:22.75,Default,,0,0,0,,Сіз оны еркін басқара аласыз.
Dialogue: 0,0:17:23.20,0:17:24.50,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:17:24.58,0:17:27.37,Default,,0,0,0,,Сіз Happy-ге ауыссаңыз да, мені жеңе алмайсыз!
Dialogue: 0,0:17:27.46,0:17:31.13,Default,,0,0,0,,Бірақ сіз достарыңызды ұра алмайсыз.
Dialogue: 0,0:17:31.21,0:17:33.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:33.88,0:17:36.43,Default,,0,0,0,,- Кешіріңіз Бақытты - (Бақытты дауыс) Иә?
Dialogue: 0,0:17:36.51,0:17:38.84,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:17:42.31,0:17:45.68,Default,,0,0,0,,А... мына жігіт, өз жолдастары...
Dialogue: 0,0:17:46.31,0:17:47.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:47.69,0:17:48.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:48.73,0:17:50.56,Default,,0,0,0,,Мияу!
Dialogue: 0,0:17:50.65,0:17:54.23,Default,,0,0,0,,Ауырды! Мен кенеттен жұдырық ала бергендей ауырып тұрмын!
Dialogue: 0,0:17:54.94,0:17:59.49,Default,,0,0,0,,Бұл дүниеде сіз сияқты қоқыс иелері үй жануарларын қорлайды.
Dialogue: 0,0:17:59.57,0:18:03.24,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бақытты менің досым
Dialogue: 0,0:18:03.33,0:18:05.50,Default,,0,0,0,,Олар төбелесіп, жаман сөздер айтады.
Dialogue: 0,0:18:06.16,0:18:09.92,Default,,0,0,0,,Егер мені бейтаныс адам ұстап алса, мен оны жұдырықпен ұрып, қуып жіберемін.
Dialogue: 0,0:18:10.00,0:18:11.88,Default,,0,0,0,,Мені ренжіткен адамды кешірмеймін
Dialogue: 0,0:18:11.96,0:18:14.51,Default,,0,0,0,,Оны ұрған мен болсам да...
Dialogue: 0,0:18:14.59,0:18:16.59,Default,,0,0,0,,Қандай ақылсыз адам.
Dialogue: 0,0:18:16.67,0:18:18.30,Default,,0,0,0,,Ештеңе айтпасаң, мен білмеймін.
Dialogue: 0,0:18:18.38,0:18:19.43,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:18:19.84,0:18:20.89,Default,,0,0,0,,Незуко! Мен төмен түсемін
Dialogue: 0,0:18:21.76,0:18:24.72,Default,,0,0,0,,Бұл жігіттің күші Mad Mole-мен тең! ?
Dialogue: 0,0:18:25.31,0:18:26.68,Default,,0,0,0,,Өте күшті
Dialogue: 0,0:18:27.52,0:18:29.14,Default,,0,0,0,,Бір рет сызылған
Dialogue: 0,0:18:29.23,0:18:32.40,Default,,0,0,0,,Сізде күштірек адам болмаса, сіз жеңе алмайсыз.
Dialogue: 0,0:18:33.23,0:18:36.11,Default,,0,0,0,,Ой! Қашып кетесің бе, бейбақ?
Dialogue: 0,0:18:36.19,0:18:38.20,Default,,0,0,0,,Күтіңіз~!
Dialogue: 0,0:18:38.28,0:18:39.61,Default,,0,0,0,,(Бақытты жылау)
Dialogue: 0,0:18:39.70,0:18:42.53,Default,,0,0,0,,Ауырды, ал Нацу оянбайды...
Dialogue: 0,0:18:42.62,0:18:44.66,Default,,0,0,0,,- (Бақытты) Ой, не істеймін... -Аа...
Dialogue: 0,0:18:44.74,0:18:46.41,Default,,0,0,0,,Бұл ауырады...
Dialogue: 0,0:18:46.50,0:18:49.58,Default,,0,0,0,,(Бақытты жылау)
Dialogue: 0,0:18:52.21,0:18:54.71,Default,,0,0,0,,- Уайымдама Бақытты - (Бақытты) Гах!
Dialogue: 0,0:18:55.30,0:18:59.22,Default,,0,0,0,,Ей, мен де елестерді көре аламын, мен олармен күресемін.
Dialogue: 0,0:18:59.30,0:19:01.22,Default,,0,0,0,,Өтінемін, менің денемді қорғаңыз.
Dialogue: 0,0:19:01.30,0:19:02.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:02.76,0:19:06.14,Default,,0,0,0,,Уау! Күте тұрыңыз!
Dialogue: 0,0:19:07.81,0:19:09.60,Default,,0,0,0,,Тек күшті болу жеткіліксіз
Dialogue: 0,0:19:10.52,0:19:13.48,Default,,0,0,0,,Менімен ынтымақтасатын біреуді қалаймын.
Dialogue: 0,0:19:14.82,0:19:17.57,Default,,0,0,0,,Синхрондау жылдамдығы неғұрлым жоғары болса—
Dialogue: 0,0:19:17.65,0:19:22.78,Default,,0,0,0,,Мені иеленген адам және менің сиқырлы күшім пропорционалды түрде артады.
Dialogue: 0,0:19:24.07,0:19:28.33,Default,,0,0,0,,Ол ғимараттарды аралап жүр, мен де істей аламын ба?
Dialogue: 0,0:19:28.41,0:19:30.29,Default,,0,0,0,,Асылды!
Dialogue: 0,0:19:31.21,0:19:34.21,Default,,0,0,0,,О! Орындалды!
Dialogue: 0,0:19:34.92,0:19:39.17,Default,,0,0,0,,Заттар бұзылмайды, атаң да саған ашуланбайды!
Dialogue: 0,0:19:40.38,0:19:43.51,Default,,0,0,0,,Синхрондау жылдамдығын арттырудың үш шарты
Dialogue: 0,0:19:43.59,0:19:48.72,Default,,0,0,0,,Бір... Сиқырлы күші маған тең немесе одан үлкен біреу.
Dialogue: 0,0:19:48.81,0:19:52.77,Default,,0,0,0,,Екі... Ажалдың шетін бір көрген адам.
Dialogue: 0,0:19:52.85,0:19:56.23,Default,,0,0,0,,Үш нәрсе... Қандас болуы керек
Dialogue: 0,0:19:57.02,0:19:58.73,Default,,0,0,0,,Менің отбасым жоқ
Dialogue: 0,0:19:58.82,0:20:01.86,Default,,0,0,0,,Сондықтан бұл шарт жойылады.
Dialogue: 0,0:20:02.95,0:20:06.28,Default,,0,0,0,,1 және 2 шарттарға сәйкес келетін адамды табыңыз.
Dialogue: 0,0:20:06.37,0:20:08.83,Default,,0,0,0,,Бұл үлкен қала, мен сенімдімін...
Dialogue: 0,0:20:10.41,0:20:11.62,Default,,0,0,0,,Таптым!
Dialogue: 0,0:20:12.16,0:20:13.96,Default,,0,0,0,,Иә! Хаха...
Dialogue: 0,0:20:14.75,0:20:16.54,Default,,0,0,0,,Сен қайда бардың? Әлгі жігіт!
Dialogue: 0,0:20:19.09,0:20:20.63,Default,,0,0,0,,Бұл дене...
Dialogue: 0,0:20:21.13,0:20:24.59,Default,,0,0,0,,Бұл дененің синхрондау жылдамдығы таңқаларлық.
Dialogue: 0,0:20:25.05,0:20:26.18,Default,,0,0,0,,Ха... Ата!
Dialogue: 0,0:20:27.01,0:20:29.47,Default,,0,0,0,,Сіз атаға ауыстыңыз ба?
Dialogue: 0,0:20:29.56,0:20:32.14,Default,,0,0,0,,Атам Альвареспен соғыста аяғынан айырылды...
Dialogue: 0,0:20:32.85,0:20:34.31,Default,,0,0,0,,Толып жатқан сиқырлы күш
Dialogue: 0,0:20:34.98,0:20:37.61,Default,,0,0,0,,Ал өлім аузына аттанғандар
Dialogue: 0,0:20:39.15,0:20:42.03,Default,,0,0,0,,Сонда менің сиқырлы күшім қосылады...
Dialogue: 0,0:20:42.11,0:20:44.86,Default,,0,0,0,,Жеңілмейтін сиқырлы күшке айналды
Dialogue: 0,0:20:46.07,0:20:48.12,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:20:48.58,0:20:50.74,Default,,0,0,0,,Әпке, мына жігіттер...
Dialogue: 0,0:20:50.83,0:20:52.62,Default,,0,0,0,,Пайдасы жоқ.
Dialogue: 0,0:20:53.08,0:20:55.12,Default,,0,0,0,,Кел, Люси
Dialogue: 0,0:20:55.21,0:20:56.92,Default,,0,0,0,,Ақ түске боялған
Dialogue: 0,0:20:57.00,0:20:59.42,Default,,0,0,0,,Бізбен…
Dialogue: 0,0:21:00.00,0:21:01.42,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:21:02.05,0:21:06.76,Default,,0,0,0,,Бұл не... Басым айналып, ес-түссіз жатырмын...
Dialogue: 0,0:21:06.84,0:21:08.68,Default,,0,0,0,,Ойланып қарашы, Қана...
Dialogue: 0,0:21:08.76,0:21:12.35,Default,,0,0,0,,Ішімдік ішуге мəжбүр болған кезде солай болады...
Dialogue: 0,0:21:12.43,0:21:13.31,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:13.85,0:21:15.44,Default,,0,0,0,,Козерог пішіні!
Dialogue: 0,0:21:16.85,0:21:18.40,Default,,0,0,0,,Бұл қауіпті болды!
Dialogue: 0,0:21:18.48,0:21:20.73,Default,,0,0,0,,Бұл сенің көзіңнен алатын сиқыр.
Dialogue: 0,0:21:20.82,0:21:22.69,Default,,0,0,0,,күннен қорғайтын көзілдірік…
Dialogue: 0,0:21:22.78,0:21:25.65,Default,,0,0,0,,Екінші рет кешіріңіз, Лисанна.
Dialogue: 0,0:21:25.74,0:21:28.28,Default,,0,0,0,,Біраз уақыт есінен танып қаласыз.
Dialogue: 0,0:21:28.37,0:21:30.53,Default,,0,0,0,,Жақсы... Ах...
Dialogue: 0,0:21:31.16,0:21:33.33,Default,,0,0,0,,Көмегің үшін рахмет, Козерог
Dialogue: 0,0:21:33.41,0:21:37.79,Default,,0,0,0,,Жоқ, Люси-саманың тапқырлығы таң қалдырды.
Dialogue: 0,0:21:39.08,0:21:40.54,Default,,0,0,0,,Диаболос жігіттері
Dialogue: 0,0:21:40.63,0:21:42.75,Default,,0,0,0,,Мира-сан мен Эльфманға қалдырыңыз...
Dialogue: 0,0:21:43.46,0:21:44.97,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:21:45.05,0:21:46.30,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:47.09,0:21:51.26,Default,,0,0,0,,Сіз бәріне көмектесудің жолдарын ойлаған шығарсыз.
Dialogue: 0,0:21:51.72,0:21:54.18,Default,,0,0,0,,Алдымен мен Кананы табуым керек!
Dialogue: 0,0:21:56.10,0:21:57.19,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:21:57.27,0:21:58.52,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:21:58.60,0:22:01.19,Default,,0,0,0,,Ой... бұл өтірік.
Dialogue: 0,0:22:01.27,0:22:04.48,Default,,0,0,0,,Осындай мықты жігіт қайдан болсын...
Dialogue: 0,0:22:05.78,0:22:08.16,Default,,0,0,0,,Әлі емес пе? Не Чан
Dialogue: 0,0:22:09.07,0:22:10.62,Default,,0,0,0,,Бірақ бұл жақсы!
Dialogue: 0,0:22:11.24,0:22:14.33,Default,,0,0,0,,Оны қалай кесемін!
Dialogue: 0,0:22:15.12,0:22:19.46,Default,,0,0,0,,♪~
Dialogue: 0,0:23:39.00,0:23:45.00,Default,,0,0,0,,~♪
Dialogue: 0,0:23:46.50,0:23:52.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory