Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.13,0:00:04.10,Default,,0,0,0,,｟Юме: Эй, эй, мені тыңда.
Dialogue: 0,0:00:04.10,0:00:07.10,Default,,0,0,0,,Хошино-чан! Бұл не?
Dialogue: 0,0:00:07.10,0:00:10.11,Default,,0,0,0,,Джажан! Мынаны қараңыз.
Dialogue: 0,0:00:10.11,0:00:12.11,Default,,0,0,0,,Құм фестивалі?
Dialogue: 0,0:00:12.11,0:00:17.18,Default,,0,0,0,,Бұл кезде оазис әлі көлдей кеңейіп жатқан.
Dialogue: 0,0:00:17.18,0:00:19.45,Default,,0,0,0,,А, мен мұны саған естелік ретінде беремін.
Dialogue: 0,0:00:19.45,0:00:22.45,Default,,0,0,0,,Эххе, ғажап емес пе?
Dialogue: 0,0:00:22.45,0:00:24.82,Default,,0,0,0,,Егер қандай да бір керемет орын алса➡
Dialogue: 0,0:00:24.82,0:00:27.86,Default,,0,0,0,,Тағы да осы күндердей көп адам жиналды...
Dialogue: 0,0:00:27.86,0:00:30.76,Default,,0,0,0,,Ғажайыптар болмайды, Сенпай. Ха! ?
Dialogue: 0,0:00:30.76,0:00:33.76,Default,,0,0,0,,Мұндай нәрсенің болуы мүмкін емес, солай ма?
Dialogue: 0,0:00:33.76,0:00:37.77,Default,,0,0,0,,Оның орнына шындыққа қараңыз. Ха… ха….
Dialogue: 0,0:00:37.77,0:00:41.40,Default,,0,0,0,,Көптеген адамдар шөлдің ортасына осылай келуі мүмкін емес, солай ма?
Dialogue: 0,0:00:41.40,0:00:44.27,Default,,0,0,0,,Армандағы әңгімелерге алаңдамаңыз.
Dialogue: 0,0:00:44.27,0:00:48.84,Default,,0,0,0,,Ал... Кешіріңіз.
Dialogue: 0,0:00:48.84,0:00:53.12,Default,,0,0,0,,Ол сондай үлпілдек, ғажайып.
Dialogue: 0,0:00:53.12,0:00:56.12,Default,,0,0,0,,Сіз Abydos студенттік кеңесінің президентісіз! ?
Dialogue: 0,0:00:56.12,0:01:00.09,Default,,0,0,0,,Біздің мойнымызға жүктелетін жауапкершілікті аздап түсінсек ше? ｠
Dialogue: 0,0:02:47.16,0:02:49.26,Default,,0,0,0,,Қайырлы таң, Широко-чан.
Dialogue: 0,0:02:49.26,0:02:51.43,Default,,0,0,0,,Хошино-сенпай.
Dialogue: 0,0:02:54.40,0:02:58.11,Default,,0,0,0,,Эй, Широко-чан, жарай ма?
Dialogue: 0,0:03:00.58,0:03:03.75,Default,,0,0,0,,Кеше... Кешіріңіз.
Dialogue: 0,0:03:03.75,0:03:06.75,Default,,0,0,0,,Жоқ, мен де біржақтымын...
Dialogue: 0,0:03:06.75,0:03:10.12,Default,,0,0,0,,Ағаңның қамын ойладың, солай ма?
Dialogue: 0,0:03:10.12,0:03:12.65,Default,,0,0,0,,Бұл табиғи нәрсе.
Dialogue: 0,0:03:12.65,0:03:16.76,Default,,0,0,0,,Біз бесеуміз де Абыдос жұмыс тобының бір бөлігіміз.
Dialogue: 0,0:03:16.76,0:03:20.76,Default,,0,0,0,,Ухехе Жақсы нәрсе айтасыз.
Dialogue: 0,0:03:20.76,0:03:23.10,Default,,0,0,0,,Эй, Хошино-сенпай.
Dialogue: 0,0:03:23.10,0:03:27.07,Default,,0,0,0,,Мен ағам не жасырып тұрғанын білмеймін➡
Dialogue: 0,0:03:27.07,0:03:29.57,Default,,0,0,0,,Мен ағама сенемін.
Dialogue: 0,0:03:33.11,0:03:37.08,Default,,0,0,0,,Менде өте жақсы кенже бала болды.
Dialogue: 0,0:03:39.15,0:03:42.75,Default,,0,0,0,,үшін, бұрын Абыдос автономиялық аймағындағы жер➡
Dialogue: 0,0:03:42.75,0:03:46.42,Default,,0,0,0,,Сіз оның үшінші тараптың қолында екенін айттыңыз, солай ма?
Dialogue: 0,0:03:46.42,0:03:49.29,Default,,0,0,0,,Оны тексеру нәтижесінде➡
Dialogue: 0,0:03:49.29,0:03:52.86,Default,,0,0,0,,Қазіргі уақытта Абыдос автономиялық ауданындағы жер кімге тиесілі?
Dialogue: 0,0:03:52.86,0:03:56.93,Default,,0,0,0,,Қайзер Констракшн деген компания болып шықты.
Dialogue: 0,0:03:56.93,0:04:01.10,Default,,0,0,0,,Сонымен... (Мұғалім) Кайзер корпорациясы ғой?
Dialogue: 0,0:04:01.10,0:04:04.51,Default,,0,0,0,,Иә Осы мектеп ғимараты мен оның айналасындағы аумақтардан басқа➡
Dialogue: 0,0:04:04.51,0:04:07.74,Default,,0,0,0,,Шөлмен жабылған Абыдос орта мектебінің бас ғимараты ➡
Dialogue: 0,0:04:07.74,0:04:11.11,Default,,0,0,0,,Айналасы Он миллиондаған қаңырап бос жатқан жер.
Dialogue: 0,0:04:11.11,0:04:14.12,Default,,0,0,0,,Тіпті қала ішіндегі ғимараттар мен жер телімдері➡
Dialogue: 0,0:04:14.12,0:04:16.42,Default,,0,0,0,,Меншік құқығы қайта жазылды.
Dialogue: 0,0:04:16.42,0:04:19.42,Default,,0,0,0,,Міне... Бірақ неге?
Dialogue: 0,0:04:19.42,0:04:22.79,Default,,0,0,0,,Автономиялық аймақтағы жерді саудаға ұсыну әдетте мүмкін емес.
Dialogue: 0,0:04:22.79,0:04:25.56,Default,,0,0,0,,Бұл Абыдос студенттер кеңесі. Ха! ?
Dialogue: 0,0:04:25.56,0:04:29.90,Default,,0,0,0,,Дұрыс. Мәміленің негізгі органы студенттік кеңес болды.
Dialogue: 0,0:04:29.90,0:04:32.73,Default,,0,0,0,,Расымен де, студенттік кеңесте не істеп жүрсің?!
Dialogue: 0,0:04:32.73,0:04:36.74,Default,,0,0,0,,Абыдос елін оларға беруге қалай дәтің бар!
Dialogue: 0,0:04:36.74,0:04:41.21,Default,,0,0,0,,Әр мектептің автономиялық округі сол мектепке қарайды.
Dialogue: 0,0:04:41.21,0:04:43.61,Default,,0,0,0,,Бұл ақылға қонымды.
Dialogue: 0,0:04:43.61,0:04:46.75,Default,,0,0,0,,Біз қарызға қатты көңіл бөлеміз➡
Dialogue: 0,0:04:46.75,0:04:50.09,Default,,0,0,0,,Мен бұл жағдайды байқай алмадым.
Dialogue: 0,0:04:50.09,0:04:54.26,Default,,0,0,0,,Кешіріңіз, ертерек байқағаным ғой...
Dialogue: 0,0:04:54.26,0:04:57.69,Default,,0,0,0,,Бұл Аяне-чанның көңілінен шығатын нәрсе емес.
Dialogue: 0,0:04:57.69,0:05:00.43,Default,,0,0,0,,Бұл барлығы мектепке кірер алдында болды...
Dialogue: 0,0:05:00.43,0:05:02.43,Default,,0,0,0,,Ааа, енді ойлап қарасам➡
Dialogue: 0,0:05:02.43,0:05:05.60,Default,,0,0,0,,Хошино-сенпай да студенттер кеңесіне кірді, солай ма?
Dialogue: 0,0:05:05.60,0:05:07.57,Default,,0,0,0,,О, дұрыс! ?
Dialogue: 0,0:05:07.57,0:05:11.51,Default,,0,0,0,,Есімде болса, ол вице-президент болған.
Dialogue: 0,0:05:11.51,0:05:14.78,Default,,0,0,0,,Ухехе Бұл да болды.
Dialogue: 0,0:05:14.78,0:05:18.78,Default,,0,0,0,,Алайда, төраға мен мен екі адам ғана болды.
Dialogue: 0,0:05:18.78,0:05:20.78,Default,,0,0,0,,Не? Тек екеуміз...
Dialogue: 0,0:05:20.78,0:05:26.29,Default,,0,0,0,,Иә... Ол кезде қазіргі студенттердің саны екі таңбалы санға тең еді➡
Dialogue: 0,0:05:26.29,0:05:30.46,Default,,0,0,0,,Мұғалімдер жоқ, сабақ әлдеқашан тоқтап қалған.
Dialogue: 0,0:05:30.46,0:05:34.13,Default,,0,0,0,,Студенттік кеңес бөлмесі жай ғана қоймаға айналды➡
Dialogue: 0,0:05:34.13,0:05:39.00,Default,,0,0,0,,Президент абайсыз және мектептегі ең үлкен ақымақ.
Dialogue: 0,0:05:39.00,0:05:43.10,Default,,0,0,0,,Мен жағымсыз мінезді жаңадан келген оқушымын.
Dialogue: 0,0:05:43.10,0:05:45.94,Default,,0,0,0,,Бәрі бір ретсіз болды.
Dialogue: 0,0:05:45.94,0:05:48.44,Default,,0,0,0,,Бұл не? Қандай студенттік кеңес?
Dialogue: 0,0:05:48.44,0:05:50.95,Default,,0,0,0,,Ал, жай ғана тақырып➡
Dialogue: 0,0:05:50.95,0:05:54.48,Default,,0,0,0,,Бірге жиналған екі ақымақ.
Dialogue: 0,0:05:54.48,0:05:58.45,Default,,0,0,0,,Жарайды, мен ол кезде жан-жағын кезіп жүрдім➡
Dialogue: 0,0:05:58.45,0:06:02.42,Default,,0,0,0,,Шынымен, ақымақ сияқты мен ештеңе білмеймін.
Dialogue: 0,0:06:05.53,0:06:09.60,Default,,0,0,0,,Хошино-сенпай бұл үшін жауапкершілікті сезінетін нәрсе емес.
Dialogue: 0,0:06:09.60,0:06:12.10,Default,,0,0,0,,Бұрынғы жағдайларды білмеймін➡
Dialogue: 0,0:06:12.10,0:06:16.24,Default,,0,0,0,,Жұмыс тобы Хошино-сенпайдың арқасында құрылды.
Dialogue: 0,0:06:16.24,0:06:19.24,Default,,0,0,0,,Не? Хошино-сенпай жалқау➡
Dialogue: 0,0:06:19.24,0:06:21.61,Default,,0,0,0,,Мен әртүрлі нәрселерден жалтаруға тырыстым➡
Dialogue: 0,0:06:21.61,0:06:23.58,Default,,0,0,0,,Жаман тұстары болса да➡
Dialogue: 0,0:06:23.58,0:06:27.08,Default,,0,0,0,,Бірақ маңызды кезде мен барлығының алдында тұрамын➡
Dialogue: 0,0:06:27.08,0:06:31.09,Default,,0,0,0,,Мен сізді құрметтеймін. Апыр-ай! ? Не болды, Широко-чан?
Dialogue: 0,0:06:31.09,0:06:34.62,Default,,0,0,0,,Сіз кенет осындай жастық лебізді айттыңыз.
Dialogue: 0,0:06:34.62,0:06:38.19,Default,,0,0,0,,Айтпақшы, студенттік кеңес неге ➡
Dialogue: 0,0:06:38.19,0:06:41.10,Default,,0,0,0,,Сіз жерді Кайзер корпорациясына саттыңыз, солай ма?
Dialogue: 0,0:06:41.10,0:06:44.50,Default,,0,0,0,,Басында қарызын өтеуге тырысатын шығар➡\NМенің ойымша, бұл
Dialogue: 0,0:06:44.50,0:06:47.00,Default,,0,0,0,,сияқты нәрсе.
Dialogue: 0,0:06:47.00,0:06:50.94,Default,,0,0,0,,Менің қатысым жоқ, сондықтан бұл жай ғана болжам.
Dialogue: 0,0:06:50.94,0:06:54.08,Default,,0,0,0,,Мектеп туралы ойланып, еңбектену➡
Dialogue: 0,0:06:54.08,0:06:56.75,Default,,0,0,0,,Менің ойымша, бұл болған болуы керек.
Dialogue: 0,0:06:56.75,0:06:58.78,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:06:58.78,0:07:03.95,Default,,0,0,0,,Алайда құм басқан Абыдоста жердің қымбатқа түсуі мүмкін емес➡
Dialogue: 0,0:07:03.95,0:07:06.59,Default,,0,0,0,,Тек пайызды өтеңіз ➡
Dialogue: 0,0:07:06.59,0:07:09.09,Default,,0,0,0,,Қарыздың өзі азайған жоқ.
Dialogue: 0,0:07:09.09,0:07:12.46,Default,,0,0,0,,Сөйтіп ол жерді қайта-қайта сатады➡
Dialogue: 0,0:07:12.46,0:07:15.10,Default,,0,0,0,,Бұл тұйық цикл дегенді білдіре ме?
Dialogue: 0,0:07:15.10,0:07:19.07,Default,,0,0,0,,Бұл не! ? Мен басынан бастап ештеңе істей алмадым.
Dialogue: 0,0:07:19.07,0:07:21.94,Default,,0,0,0,,Бұндай айлалар да бар. иә?
Dialogue: 0,0:07:21.94,0:07:24.84,Default,,0,0,0,,Өтеу мүмкіндігі жоқ несие алу➡
Dialogue: 0,0:07:24.84,0:07:27.41,Default,,0,0,0,,Сізге тіпті пайызды қайтару үшін ➡
Dialogue: 0,0:07:27.41,0:07:30.78,Default,,0,0,0,,Ғимараттарды немесе жерді сатуға шақыру.
Dialogue: 0,0:07:30.78,0:07:35.18,Default,,0,0,0,,Мен сенімдімін. Ал Абыдос автономиялық облысының өзі➡
Dialogue: 0,0:07:35.18,0:07:38.42,Default,,0,0,0,,Біртіндеп Kaiser корпорациясының меншігіне айналу.
Dialogue: 0,0:07:38.42,0:07:40.42,Default,,0,0,0,,Шынында да.
Dialogue: 0,0:07:40.42,0:07:43.59,Default,,0,0,0,,Мүмкін бұл бастапқы есеп шығар.
Dialogue: 0,0:07:43.59,0:07:47.10,Default,,0,0,0,,Абыдосқа несие бергенде солай болады...
Dialogue: 0,0:07:47.10,0:07:51.57,Default,,0,0,0,,Мүмкін бұл баяғыда салынған тұзақ шығар.
Dialogue: 0,0:07:51.57,0:07:54.54,Default,,0,0,0,,Бұл ондаған жылдар бойы болды.
Dialogue: 0,0:07:54.54,0:07:57.44,Default,,0,0,0,,Бұл жай ғана ойыншық!
Dialogue: 0,0:07:57.44,0:08:00.08,Default,,0,0,0,,Мен бұл алдамшы әдіске алданып қалдым.
Dialogue: 0,0:08:00.08,0:08:02.08,Default,,0,0,0,,Сабыр ет, Селика.
Dialogue: 0,0:08:02.08,0:08:05.25,Default,,0,0,0,,Менің ойымша, алдаудан гөрі алданған жаман.
Dialogue: 0,0:08:05.25,0:08:07.58,Default,,0,0,0,,Мен... Мен мұны білемін!
Dialogue: 0,0:08:07.58,0:08:09.58,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:11.65,0:08:15.92,Default,,0,0,0,,Адамдар кептеліп қалғанда, олар қалағанын жасайды.
Dialogue: 0,0:08:15.92,0:08:19.93,Default,,0,0,0,,Одан да нашарлайтынын білсем де, бар күшімді сынаймын.
Dialogue: 0,0:08:19.93,0:08:24.33,Default,,0,0,0,,Мұның бәрі бар, Селика-чан.
Dialogue: 0,0:08:24.33,0:08:28.94,Default,,0,0,0,,Мектеп қарызы Абыдос отырған жағдай➡
Dialogue: 0,0:08:28.94,0:08:32.57,Default,,0,0,0,,Ал біз сіздермен бірге не аштық➡
Dialogue: 0,0:08:32.57,0:08:36.08,Default,,0,0,0,,Мен бәрі бірте-бірте қосыла бастағандай сезінемін.
Dialogue: 0,0:08:36.08,0:08:39.08,Default,,0,0,0,,Абыдос орта мектебінің студенттер кеңесінің жойылуымен➡
Dialogue: 0,0:08:39.08,0:08:41.75,Default,,0,0,0,,Жерді сатуға жол жоқ➡
Dialogue: 0,0:08:41.75,0:08:44.75,Default,,0,0,0,,Бұл мен әлі алмаған соңғы жер учаскесі➡
Dialogue: 0,0:08:44.75,0:08:48.26,Default,,0,0,0,,Мен бұл мектепті тонау үшін Team Helmet жалдадым.
Dialogue: 0,0:08:48.26,0:08:52.76,Default,,0,0,0,,Мүмкін Kaiser корпорациясының мақсаты ақша емес шығар➡
Dialogue: 0,0:08:52.76,0:08:57.27,Default,,0,0,0,,Әуелден Абыдос елі деп ойлаймын.
Dialogue: 0,0:08:57.27,0:08:59.57,Default,,0,0,0,,Бұл мақсат ретінде мүмкін болуы мүмкін.
Dialogue: 0,0:08:59.57,0:09:02.44,Default,,0,0,0,,Келесі сұрақ туындайды.
Dialogue: 0,0:09:02.44,0:09:06.47,Default,,0,0,0,,Бұл шөлейтті жер не үшін пайдаланылады?
Dialogue: 0,0:09:06.47,0:09:10.55,Default,,0,0,0,,Ал... Мен қазіргі Абыдосымды алдым➡
Dialogue: 0,0:09:10.55,0:09:14.08,Default,,0,0,0,,Ешқандай пайда жоқ деп ойлаймын.
Dialogue: 0,0:09:14.08,0:09:16.62,Default,,0,0,0,,Міне.
Dialogue: 0,0:09:16.62,0:09:20.19,Default,,0,0,0,,Шөл туралы айтсақ, тозақпен шайқастан кейін...
Dialogue: 0,0:09:20.19,0:09:22.76,Default,,0,0,0,,｟Хина: Абидостың қараусыз қалған шөлі.
Dialogue: 0,0:09:22.76,0:09:27.43,Default,,0,0,0,,Kaiser корпорациясы сол жерде бірдеңе жоспарлап отыр.
Dialogue: 0,0:09:27.43,0:09:32.07,Default,,0,0,0,,Гееннаның қоғамдық моральдық комитетінің төрағасы қалай осылай айта алды?
Dialogue: 0,0:09:32.07,0:09:34.67,Default,,0,0,0,,Мұғалім, сен неге үндемедің?
Dialogue: 0,0:09:34.67,0:09:37.61,Default,,0,0,0,,Жоқ... жоқ, қара! Сол кезде көп нәрсе болды➡
Dialogue: 0,0:09:37.61,0:09:40.44,Default,,0,0,0,,Мен ақпаратты қалай өңдеу керектігін анықтауда қиындықтарға тап болдым...
Dialogue: 0,0:09:40.44,0:09:43.61,Default,,0,0,0,,О, қазірдің өзінде! Менімен сөйлесе алсаңыз жақсы болар еді.
Dialogue: 0,0:09:43.61,0:09:45.61,Default,,0,0,0,,Кешіріңіз. Қалай болғанда да➡
Dialogue: 0,0:09:45.61,0:09:48.52,Default,,0,0,0,,Kaiser корпорациясы жерді сатып алды.
Dialogue: 0,0:09:48.52,0:09:50.95,Default,,0,0,0,,Егер олар осылай жоспарлап жатса...
Dialogue: 0,0:09:50.95,0:09:52.95,Default,,0,0,0,,Селика-чан дұрыс айтады.
Dialogue: 0,0:09:52.95,0:09:55.82,Default,,0,0,0,,Барлық жауаптарды Абыдос шөлінен табуға болады.
Dialogue: 0,0:09:55.82,0:09:57.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:57.86,0:10:00.46,Default,,0,0,0,,Иә, дұрыс. Иә.
Dialogue: 0,0:10:00.46,0:10:04.13,Default,,0,0,0,,Иә... Абыдос шөліне барайық!
Dialogue: 0,0:10:08.10,0:10:12.74,Default,,0,0,0,,Уау~ Бұдан былай жүруден басқа амалымыз жоқ~.
Dialogue: 0,0:10:12.74,0:10:15.58,Default,,0,0,0,,Жолда құлап қалсам, қиындық туар еді.
Dialogue: 0,0:10:15.58,0:10:18.75,Default,,0,0,0,,Мұны бізге қалдырыңыз.
Dialogue: 0,0:10:18.75,0:10:22.18,Default,,0,0,0,,Ум, барлығы, кешіріңіздер.
Dialogue: 0,0:10:22.18,0:10:25.75,Default,,0,0,0,,Міне, мен бұл көріністі көрмегелі біраз болды.
Dialogue: 0,0:10:25.75,0:10:28.06,Default,,0,0,0,,Сіздің ағаңыз келді ме?
Dialogue: 0,0:10:28.06,0:10:30.93,Default,,0,0,0,,Студенттік кеңес жұмысына байланысты бірнеше рет.
Dialogue: 0,0:10:30.93,0:10:35.10,Default,,0,0,0,,Егер сіз ары қарай жүрсеңіз, сіз кең оазис таба аласыз!
Dialogue: 0,0:10:35.10,0:10:38.40,Default,,0,0,0,,О, оазис! ? Иә жақсы➡
Dialogue: 0,0:10:38.40,0:10:41.60,Default,,0,0,0,,Қазір бәрі кеуіп қалды.
Dialogue: 0,0:10:41.60,0:10:45.57,Default,,0,0,0,,Бір кездері сонда Абыдос құм фестивалі өткен.
Dialogue: 0,0:10:45.57,0:10:49.08,Default,,0,0,0,,Құм фестивалі. Мен ол туралы естідім.
Dialogue: 0,0:10:49.08,0:10:53.75,Default,,0,0,0,,Абыдоста атақты фестивальге көп адам жиналды.
Dialogue: 0,0:10:53.75,0:10:58.42,Default,,0,0,0,,Дұрыс, оны көруге басқа автономиялық облыстардан келгендер көп➡
Dialogue: 0,0:10:58.42,0:11:01.42,Default,,0,0,0,,Бұл үлкен мереке болған сияқты.
Dialogue: 0,0:11:01.42,0:11:04.09,Default,,0,0,0,,Осындай шөлдің ортасында?
Dialogue: 0,0:11:04.09,0:11:08.60,Default,,0,0,0,,Бұл жер бұрын өмір сүруге қолайлы жер болған көрінеді.
Dialogue: 0,0:11:08.60,0:11:10.57,Default,,0,0,0,,Эй.
Dialogue: 0,0:11:13.77,0:11:17.67,Default,,0,0,0,,｟Юме: Қараңдаршы, Хошино-чан! Міне!
Dialogue: 0,0:11:17.67,0:11:20.07,Default,,0,0,0,,Оған сенуге бола ма?
Dialogue: 0,0:11:20.07,0:11:22.28,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:22.28,0:11:27.18,Default,,0,0,0,,Ол жер шынымен де құм фестивалі өткен оазис.
Dialogue: 0,0:11:39.06,0:11:42.80,Default,,0,0,0,,Алда үлкен нысан бар.
Dialogue: 0,0:11:42.80,0:11:45.90,Default,,0,0,0,,Иә? Осындай жерде ме? 📱Мүмкін➡
Dialogue: 0,0:11:45.90,0:11:48.37,Default,,0,0,0,,Хинаның айтқаны осы болуы мүмкін.
Dialogue: 0,0:11:48.37,0:11:51.07,Default,,0,0,0,,үшін, мен не болып жатқанын білмеймін.
Dialogue: 0,0:11:51.07,0:11:53.41,Default,,0,0,0,,📱Тергеуіңізді абайлап жүргізіңіз.
Dialogue: 0,0:11:53.41,0:11:55.41,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:11:59.38,0:12:01.38,Default,,0,0,0,,Қауіпсіздіктің үлкен көлемі...
Dialogue: 0,0:12:01.38,0:12:04.39,Default,,0,0,0,,Бұл жердегі қандай нысан? ?
Dialogue: 0,0:12:04.39,0:12:06.79,Default,,0,0,0,,Kaiser PMC…. (3 адам) Иә?
Dialogue: 0,0:12:06.79,0:12:11.06,Default,,0,0,0,,Шамасы, бұл да Kaiser корпорациясының еншілес компаниясы.
Dialogue: 0,0:12:11.06,0:12:13.73,Default,,0,0,0,,PMC…. Сен білесің бе?
Dialogue: 0,0:12:13.73,0:12:17.70,Default,,0,0,0,,Иә Жеке әскери рота, яғни➡
Dialogue: 0,0:12:17.70,0:12:20.20,Default,,0,0,0,,Жеке әскери рота.
Dialogue: 0,0:12:20.20,0:12:26.37,Default,,0,0,0,,Бұл Дулыға командасынан басқа деңгейдегі кәсіби жауынгерлік топ.
Dialogue: 0,0:12:26.37,0:12:28.78,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:28.78,0:12:32.38,Default,,0,0,0,,Ах... (ескерту)
Dialogue: 0,0:12:32.38,0:12:35.08,Default,,0,0,0,,Күдікті адам табылды! Өзіңізді қоршаңыз!
Dialogue: 0,0:12:38.05,0:12:41.49,Default,,0,0,0,,Уау, бұл сан өте қиын.
Dialogue: 0,0:12:41.49,0:12:44.06,Default,,0,0,0,,Егер сен жақсы болмасаң, тәртіптік комитеттен де қиынырақ боласың.
Dialogue: 0,0:12:44.06,0:12:48.10,Default,,0,0,0,,Не істеуіміз керек, Хошино-сенпай?
Dialogue: 0,0:12:48.10,0:12:50.67,Default,,0,0,0,,Әркім, ойланбаңдар және ол жерден шегініңдер!
Dialogue: 0,0:12:52.73,0:12:55.40,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:13:05.05,0:13:07.08,Default,,0,0,0,,Мынау...
Dialogue: 0,0:13:07.08,0:13:09.72,Default,,0,0,0,,Мен сізді қаскүнем деп естідім➡
Dialogue: 0,0:13:09.72,0:13:13.39,Default,,0,0,0,,Мен оның Абыдос орта мектебінің оқушысы екенін білмедім.
Dialogue: 0,0:13:13.39,0:13:16.72,Default,,0,0,0,,Бұл сан күтпеген жерден шықты! ?
Dialogue: 0,0:13:16.72,0:13:20.40,Default,,0,0,0,,О? Сізді сол Гематрия➡ нысанаға алды
Dialogue: 0,0:13:20.40,0:13:25.07,Default,,0,0,0,,Студенттік кеңестің төрағасы... жоқ, вице-президент болды ма?
Dialogue: 0,0:13:25.07,0:13:27.37,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:13:27.37,0:13:32.07,Default,,0,0,0,,О, сен мені танымайтыныңа сене алар емеспін.
Dialogue: 0,0:13:32.07,0:13:34.04,Default,,0,0,0,,Мен➡
Dialogue: 0,0:13:34.04,0:13:38.05,Default,,0,0,0,,Ол Kaiser корпорациясының директоры.
Dialogue: 0,0:13:38.05,0:13:40.72,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:40.72,0:13:42.72,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:13:42.72,0:13:47.39,Default,,0,0,0,,«Абыдос» студенттік кеңесін алдап, жерін пайдаланған адам?
Dialogue: 0,0:13:47.39,0:13:53.06,Default,,0,0,0,,Ха ха ха Сөйлегеніңізге абай болғаныңыз жөн.
Dialogue: 0,0:13:53.06,0:13:58.43,Default,,0,0,0,,Сіз қазір Kaiser PMC жеке меншігіндесіз➡
Dialogue: 0,0:13:58.43,0:14:04.04,Default,,0,0,0,,Сіз шекараны бұзып жатқаныңызды түсінуіңіз керек.
Dialogue: 0,0:14:04.04,0:14:06.71,Default,,0,0,0,,Енді тақырыпқа қайта оралайық.
Dialogue: 0,0:14:06.71,0:14:09.11,Default,,0,0,0,,Абидос автономиялық ауданындағы жер....
Dialogue: 0,0:14:09.11,0:14:12.05,Default,,0,0,0,,А, мен оны сатып алғаныма сенімдімін.
Dialogue: 0,0:14:12.05,0:14:18.05,Default,,0,0,0,,Барлық транзакциялар заңды және жақсы құжатталған.
Dialogue: 0,0:14:18.05,0:14:23.06,Default,,0,0,0,,Неліктен бұл жер құммен жабылған? Сіз осылай айттыңыз.
Dialogue: 0,0:14:23.06,0:14:25.73,Default,,0,0,0,,Олай болса, мен сізге хабарлаймын.
Dialogue: 0,0:14:25.73,0:14:29.40,Default,,0,0,0,,Бізді Абыдостың бір жерінде жерленген дейді➡
Dialogue: 0,0:14:29.40,0:14:32.07,Default,,0,0,0,,Мен қазына іздеймін.
Dialogue: 0,0:14:32.07,0:14:34.40,Default,,0,0,0,,Ах... 📱Өтірік айтпа!
Dialogue: 0,0:14:34.40,0:14:37.04,Default,,0,0,0,,Бұған сену мүмкін емес! ?
Dialogue: 0,0:14:37.04,0:14:39.37,Default,,0,0,0,,Олай болса, бұл әскери күш қандай?
Dialogue: 0,0:14:39.37,0:14:44.05,Default,,0,0,0,,Біздің мектепті күшпен басып алу үшін, солай емес пе?
Dialogue: 0,0:14:44.05,0:14:46.71,Default,,0,0,0,,Хахаха мен қалжыңдап тұрған жоқпын.
Dialogue: 0,0:14:46.71,0:14:48.72,Default,,0,0,0,,Бұл жай ғана ➡
Dialogue: 0,0:14:48.72,0:14:51.89,Default,,0,0,0,,Сіздің қазына іздеуіңіз үзілген кезде.
Dialogue: 0,0:14:51.89,0:14:55.39,Default,,0,0,0,,Бұл сіз үшін дайындалмаған.
Dialogue: 0,0:14:55.39,0:15:00.06,Default,,0,0,0,,Балалар, сіз қалаған уақытта қалағаныңызды жасай аласыз.
Dialogue: 0,0:15:00.06,0:15:02.73,Default,,0,0,0,,Мысалы...
Dialogue: 0,0:15:02.73,0:15:04.73,Default,,0,0,0,,📱
Dialogue: 0,0:15:04.73,0:15:08.37,Default,,0,0,0,,Бұл менмін. не? Кенеттен қоңырау шалыңыз ба?
Dialogue: 0,0:15:08.37,0:15:13.04,Default,,0,0,0,,Иә, жалғастырыңыз.
Dialogue: 0,0:15:13.04,0:15:15.71,Default,,0,0,0,,Бұл өте өкінішті жаңалық.
Dialogue: 0,0:15:15.71,0:15:18.71,Default,,0,0,0,,Ах... Жерде не?
Dialogue: 0,0:15:18.71,0:15:20.72,Default,,0,0,0,,Иә! ? 📱
Dialogue: 0,0:15:20.72,0:15:23.12,Default,,0,0,0,,Неліктен? ?
Dialogue: 0,0:15:23.12,0:15:26.72,Default,,0,0,0,,📱Келесі айдан бастап пайыздық мөлшерлемелер 3000%-ға өсті!
Dialogue: 0,0:15:26.72,0:15:28.72,Default,,0,0,0,,Иә! ? Бұл не! ?
Dialogue: 0,0:15:28.72,0:15:33.06,Default,,0,0,0,,Фуфуфуфуфу... Енді түсіндің бе?
Dialogue: 0,0:15:33.06,0:15:36.70,Default,,0,0,0,,Мойындағы жіп қазір➡
Dialogue: 0,0:15:36.70,0:15:39.40,Default,,0,0,0,,Ол кімге тиесілі?
Dialogue: 0,0:15:39.40,0:15:41.37,Default,,0,0,0,,Қорқынышты…. Бұл пайыздық мөлшерлеме➡
Dialogue: 0,0:15:41.37,0:15:43.37,Default,,0,0,0,,Төлеуге мүмкіндік жоқ! ?
Dialogue: 0,0:15:43.37,0:15:47.07,Default,,0,0,0,,Олай болса неге мектепті тастап, кетіп қалмасқа?
Dialogue: 0,0:15:47.07,0:15:50.04,Default,,0,0,0,,📱Сіз өз еркіңізбен мектептен шығып, басқа мектепке ауыса аласыз.
Dialogue: 0,0:15:50.04,0:15:54.05,Default,,0,0,0,,Біріншіден, бұл мектеп жауапты болуы керек қарыз.
Dialogue: 0,0:15:54.05,0:15:59.05,Default,,0,0,0,,Сізге иығыңызда ештеңе алып жүрудің қажеті жоқ, солай ма?
Dialogue: 0,0:15:59.05,0:16:02.09,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:16:02.09,0:16:04.73,Default,,0,0,0,,Дұрыс, мен сені тастап кете алмаймын!
Dialogue: 0,0:16:04.73,0:16:08.36,Default,,0,0,0,,Абыдос – мектебіміз, қаламыз.
Dialogue: 0,0:16:08.36,0:16:12.07,Default,,0,0,0,,Олай болса, не істеуіміз керек? Сіз жасай алатын тағы бір нәрсе бар ма?
Dialogue: 0,0:16:12.07,0:16:16.07,Default,,0,0,0,,Қарғыс атсын, бұл...
Dialogue: 0,0:16:16.07,0:16:18.44,Default,,0,0,0,,үшінмыз үйге қайтайық. (3 адам) Әй...
Dialogue: 0,0:16:18.44,0:16:20.51,Default,,0,0,0,,Хошино?
Dialogue: 0,0:16:20.51,0:16:23.21,Default,,0,0,0,,📱Бұл жерде ары қарай дауласудың қажеті жоқ.
Dialogue: 0,0:16:23.21,0:16:25.38,Default,,0,0,0,,Сізбен жай ғана ойыншық.
Dialogue: 0,0:16:25.38,0:16:29.38,Default,,0,0,0,,Хехехе... Студенттік кеңес төрағасының орынбасары күткендей.
Dialogue: 0,0:16:29.38,0:16:32.39,Default,,0,0,0,,Сіз ақылды сияқтысыз.
Dialogue: 0,0:16:32.39,0:16:34.82,Default,,0,0,0,,есімде.
Dialogue: 0,0:16:34.82,0:16:37.39,Default,,0,0,0,,Ақылды көрінген сенімен бірге болдым➡
Dialogue: 0,0:16:37.39,0:16:41.10,Default,,0,0,0,,Бұл мүлдем ақымақ студенттік кеңестің президенті туралы.
Dialogue: 0,0:16:45.57,0:16:47.64,Default,,0,0,0,,Сендер, үндемеңдер!➡
Dialogue: 0,0:16:54.08,0:16:57.38,Default,,0,0,0,,Аа...
Dialogue: 0,0:16:57.38,0:16:59.38,Default,,0,0,0,,Хехехехе….
Dialogue: 0,0:16:59.38,0:17:06.79,Default,,0,0,0,,Енді сізден келесі айдан бастап өтеуге көмектесуіңізді өтінемін, тұтынушы.
Dialogue: 0,0:17:06.79,0:17:12.46,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:17:16.03,0:17:19.03,Default,,0,0,0,,Хаа…. Жер бетінде не болып жатыр! ?
Dialogue: 0,0:17:19.03,0:17:22.40,Default,,0,0,0,,Сіз қазына іздеймін дедіңіз...
Dialogue: 0,0:17:22.40,0:17:26.04,Default,,0,0,0,,Сол шөлде ақшаға пайдалануға болатын мұнай сияқты жер асты байлықтары бар➡
Dialogue: 0,0:17:26.04,0:17:28.04,Default,,0,0,0,,Ештеңе қалмады.
Dialogue: 0,0:17:28.04,0:17:31.05,Default,,0,0,0,,Мұндай зерттеу баяғыда пайда болды.
Dialogue: 0,0:17:31.05,0:17:34.12,Default,,0,0,0,,А, Широко? (тұрған дауысы)
Dialogue: 0,0:17:34.12,0:17:37.08,Default,,0,0,0,,Мен тағы барамын. Ол жақта не істеп жүрсің➡
Dialogue: 0,0:17:37.08,0:17:40.76,Default,,0,0,0,,Мен оны қарауым керек. иә? Мен енді шөлде боламын деп ойламадым! ?
Dialogue: 0,0:17:40.76,0:17:45.13,Default,,0,0,0,,Мұқият дайындалсақ, әйтеуір сіңіп кете аламыз деп ойлаймын.
Dialogue: 0,0:17:45.13,0:17:47.43,Default,,0,0,0,,Күте тұрыңыз, әзірге➡
Dialogue: 0,0:17:47.43,0:17:49.43,Default,,0,0,0,,Бұл қарыз туралы көбірек...
Dialogue: 0,0:17:49.43,0:17:53.40,Default,,0,0,0,,Қарыздарды бұдан былай заңды түрде өтеу мүмкін емес.
Dialogue: 0,0:17:53.40,0:17:57.44,Default,,0,0,0,,Жоқ, Широко-чан! Мен Широко-сенпаймен келісемін.
Dialogue: 0,0:17:57.44,0:17:59.41,Default,,0,0,0,,Иә! ? Мектеп біткен кезде➡
Dialogue: 0,0:17:59.41,0:18:02.58,Default,,0,0,0,,Бәрі бітті! ? Мен енді кейіп көрсете алмаймын!
Dialogue: 0,0:18:02.58,0:18:04.58,Default,,0,0,0,,Сабыр ет, Селика-чан!
Dialogue: 0,0:18:04.58,0:18:07.45,Default,,0,0,0,,Сонда қара банкті тонаған кездегідей!
Dialogue: 0,0:18:07.45,0:18:10.08,Default,,0,0,0,,Адамдардан ұрлаған ақшаңызды қарыздарыңызды өтеу үшін пайдаланыңыз➡
Dialogue: 0,0:18:10.08,0:18:13.09,Default,,0,0,0,,Сіз шынымен Абыдос орта мектебіне қайта оралдым деп айта аласыз ба? ?
Dialogue: 0,0:18:13.09,0:18:15.42,Default,,0,0,0,,Бірақ... Мен сенің дүрбелеңді түсінемін, бірақ➡
Dialogue: 0,0:18:15.42,0:18:18.43,Default,,0,0,0,,Біз сізді қылмыскерге айналдыра алмаймыз.
Dialogue: 0,0:18:18.43,0:18:22.43,Default,,0,0,0,,Сонымен не істеуіміз керек? Уф, бұл...
Dialogue: 0,0:18:24.40,0:18:27.10,Default,,0,0,0,,Әй, эй, бәрі тынышталсын.
Dialogue: 0,0:18:27.10,0:18:31.07,Default,,0,0,0,,Сенің басыңнан бу шығып жатыр~ Эй, Широко-чан.
Dialogue: 0,0:18:31.07,0:18:34.74,Default,,0,0,0,,Кешіріңіз, мен бұлай істегім келмеді.
Dialogue: 0,0:18:34.74,0:18:37.75,Default,,0,0,0,,Иә, иә, барлығы түсінеді.
Dialogue: 0,0:18:37.75,0:18:40.75,Default,,0,0,0,,Оны бүгінге қалдырайық.
Dialogue: 0,0:18:40.75,0:18:44.75,Default,,0,0,0,,Бір рет суытып, ертең тағы кездесейік.
Dialogue: 0,0:18:44.75,0:18:47.42,Default,,0,0,0,,Бұл төрағаның бұйрығы.
Dialogue: 0,0:18:47.42,0:18:50.09,Default,,0,0,0,,Иә. Бұл менің ағам айтқандай.
Dialogue: 0,0:18:50.09,0:18:52.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:54.06,0:18:56.50,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:56.50,0:19:00.60,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:19:00.60,0:19:19.79,Default,,0,0,0,,♬～
Dialogue: 0,0:19:19.79,0:19:25.79,Default,,0,0,0,,Ғажайып па, әлде бақыт па деп ойлаймын...
Dialogue: 0,0:19:27.70,0:19:29.73,Default,,0,0,0,,Хошино. Иә?
Dialogue: 0,0:19:29.73,0:19:34.40,Default,,0,0,0,,Бұл не, мұғалім? Бұл қорқынышты.
Dialogue: 0,0:19:34.40,0:19:37.41,Default,,0,0,0,,Енді ойлап отырсам, менің сүйкімді Широко-чан➡
Dialogue: 0,0:19:37.41,0:19:40.04,Default,,0,0,0,,Біз мұны білмей тұрып, көзбен сөйлесе алдық➡
Dialogue: 0,0:19:40.04,0:19:45.05,Default,,0,0,0,,Не болды? Өйткені, ұстаз – кемсітуге болмайтын ересек адам.
Dialogue: 0,0:19:48.45,0:19:50.72,Default,,0,0,0,,Хошино, сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:19:50.72,0:19:52.72,Default,,0,0,0,,Иә, не?
Dialogue: 0,0:19:52.72,0:19:54.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:54.72,0:19:56.72,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:56.72,0:19:59.69,Default,,0,0,0,,Сізден бірдеңе сұрасам болады ма?
Dialogue: 0,0:19:59.69,0:20:02.73,Default,,0,0,0,,Ха, мен көмектесе алмаймын.
Dialogue: 0,0:20:02.73,0:20:05.73,Default,,0,0,0,,Бетпе-бет нені білдіреді?
Dialogue: 0,0:20:05.73,0:20:10.34,Default,,0,0,0,,Мұғалім, сол жерде біраз қыдырғың келе ме?
Dialogue: 0,0:20:10.34,0:20:13.04,Default,,0,0,0,,Сәлем, мұғалім➡
Dialogue: 0,0:20:13.04,0:20:16.74,Default,,0,0,0,,Менің жоғары мектептегі қымбат өмірім құм түсті болды➡
Dialogue: 0,0:20:16.74,0:20:19.55,Default,,0,0,0,,Сіз бұл туралы ештеңе істей алмайсыз деп ойламайсыз ба?
Dialogue: 0,0:20:19.55,0:20:23.52,Default,,0,0,0,,Бірақ Хошино бұл мектепті ұнатады.
Dialogue: 0,0:20:25.72,0:20:29.72,Default,,0,0,0,,Шөлдену басталғанға дейін Абыдос өте үлкен болды➡
Dialogue: 0,0:20:29.72,0:20:32.39,Default,,0,0,0,,Құдіретті мектеп болған деседі.
Dialogue: 0,0:20:32.39,0:20:35.80,Default,,0,0,0,,Бірақ сол естеліктер мен сезімдер➡
Dialogue: 0,0:20:35.80,0:20:38.07,Default,,0,0,0,,Ағайда мүлде жоқ.
Dialogue: 0,0:20:38.07,0:20:40.73,Default,,0,0,0,,Әу бастан бәрі былық болды➡
Dialogue: 0,0:20:40.73,0:20:44.74,Default,,0,0,0,,Ештеңесі жоқ мектеп болды.
Dialogue: 0,0:20:44.74,0:20:47.37,Default,,0,0,0,,Сонда да Хошино оны жақсы көреді➡
Dialogue: 0,0:20:47.37,0:20:49.71,Default,,0,0,0,,Бір ғана алмаматер, солай ма?
Dialogue: 0,0:20:49.71,0:20:53.75,Default,,0,0,0,,Мм, ағам оқуға түскен Абыдостың бас ғимараты➡
Dialogue: 0,0:20:53.75,0:20:57.38,Default,,0,0,0,,Ол шөл далада көмілген, солай ма?
Dialogue: 0,0:20:57.38,0:21:00.05,Default,,0,0,0,,Қазір қай жерде, шөлден аулақ болыңыз➡
Dialogue: 0,0:21:00.05,0:21:04.73,Default,,0,0,0,,Бірнеше рет көшкеннен кейін біз тек қосымшамен аяқталдық.
Dialogue: 0,0:21:04.73,0:21:07.39,Default,,0,0,0,,Бірақ мұнда кел➡
Dialogue: 0,0:21:07.39,0:21:10.36,Default,,0,0,0,,Себебі мен жұмыс тобында барлығымен кездесе алдым...
Dialogue: 0,0:21:10.36,0:21:14.67,Default,,0,0,0,,Хехе, бұл маған ұнайтын сияқты.
Dialogue: 0,0:21:20.04,0:21:22.41,Default,,0,0,0,,Мұғалім.
Dialogue: 0,0:21:22.41,0:21:24.68,Default,,0,0,0,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,0:21:27.05,0:21:29.72,Default,,0,0,0,,Уау~ Мен өзімді сергек сезінемін.
Dialogue: 0,0:21:29.72,0:21:32.09,Default,,0,0,0,,Осы оқиғаны барлығына айтып болған соң➡
Dialogue: 0,0:21:32.09,0:21:34.39,Default,,0,0,0,,Бұл сізді алаңдатады.
Dialogue: 0,0:21:34.39,0:21:36.42,Default,,0,0,0,,Бірақ менің сүйкімді жасөспірімдерге➡
Dialogue: 0,0:21:36.42,0:21:40.39,Default,,0,0,0,,Құпияларды мәңгілікке жасыру жақсы емес➡
Dialogue: 0,0:21:40.39,0:21:43.73,Default,,0,0,0,,Ертең бәріне түсіндіремін.
Dialogue: 0,0:21:43.73,0:21:46.77,Default,,0,0,0,,Білсем де, қиналып қалатын шығармын.
Dialogue: 0,0:21:46.77,0:21:49.40,Default,,0,0,0,,Жоқ, менімен сөйлескеніңізге рахмет.
Dialogue: 0,0:21:49.40,0:21:53.04,Default,,0,0,0,,Хошиноның уайымын бәрі қабылдайтынына сенімдімін.
Dialogue: 0,0:21:53.04,0:21:55.41,Default,,0,0,0,,Мәселе көп болса да, жарайды➡
Dialogue: 0,0:21:55.41,0:21:58.71,Default,,0,0,0,,Бірге болсақ бәрі жақсы болады!
Dialogue: 0,0:21:58.71,0:22:01.38,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:22:01.38,0:22:04.39,Default,,0,0,0,,Мен бір ғажайып орын алса екен...
Dialogue: 0,0:22:04.39,0:22:07.35,Default,,0,0,0,,Мен оны барлығымен бірге оята алатынымызға сенімдімін.
Dialogue: 0,0:22:09.39,0:22:13.56,Default,,0,0,0,,Міне, әңгімеміз аяқталды.
Dialogue: 0,0:22:13.56,0:22:15.70,Default,,0,0,0,,Кездескенше, мұғалім.
Dialogue: 0,0:22:15.70,0:22:19.10,Default,,0,0,0,,Иә, ертең кездескенше.
Dialogue: 0,0:22:20.60,0:22:26.60,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
