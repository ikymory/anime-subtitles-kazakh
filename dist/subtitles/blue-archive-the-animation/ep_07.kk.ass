Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.67,0:00:09.61,Default,,0,0,0,,｟Қара киім: Мен көптен күткенім осы еді➡
Dialogue: 0,0:00:09.61,0:00:12.94,Default,,0,0,0,,Таңның тесігі... Жоқ➡
Dialogue: 0,0:00:12.94,0:00:15.21,Default,,0,0,0,,Бұл Хошино Которию болды.
Dialogue: 0,0:00:17.28,0:00:19.28,Default,,0,0,0,,Бұл жолы не керек?
Dialogue: 0,0:00:19.28,0:00:22.85,Default,,0,0,0,,Хехе, жағдай өзгерді.
Dialogue: 0,0:00:22.85,0:00:26.46,Default,,0,0,0,,Бұл жолы менде Абыдос➡ туралы ең үлкен жұмбақтар тағы бар
Dialogue: 0,0:00:26.46,0:00:29.96,Default,,0,0,0,,Мен Хошино мырзаға бір ұсыныс айтқым келеді.
Dialogue: 0,0:00:29.96,0:00:31.99,Default,,0,0,0,,Өзіңізді алдамаңыз! Жарайды➡
Dialogue: 0,0:00:31.99,0:00:35.13,Default,,0,0,0,,Тынышталыңыз. Сізге➡
Dialogue: 0,0:00:35.13,0:00:38.13,Default,,0,0,0,,Мен ешқашан бас тартпайтын бір ұсыныс...
Dialogue: 0,0:00:40.27,0:00:43.81,Default,,0,0,0,,Бұл қызықты ұсыныс деп ойлаймын.
Dialogue: 0,0:00:43.81,0:00:45.81,Default,,0,0,0,,Хехехе...｠
Dialogue: 0,0:00:45.81,0:00:48.48,Default,,0,0,0,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,0:02:41.16,0:02:44.59,Default,,0,0,0,,📺Енді, бүгін біз сізге Абыдос автономиялық аймағынан кейбір кадрларды көрсетеміз➡
Dialogue: 0,0:02:44.59,0:02:47.43,Default,,0,0,0,,Қоштасу. Қандай да бір жарылыс➡
Dialogue: 0,0:02:47.43,0:02:49.93,Default,,0,0,0,,Ақаулық болған сияқты, бірақ ол әдеттегідей➡
Dialogue: 0,0:02:49.93,0:02:52.43,Default,,0,0,0,,Сіз шөлді аймақты көре аласыз.
Dialogue: 0,0:02:52.43,0:02:55.80,Default,,0,0,0,,📺Бәрі бүгінгі жаңалықтар үшін.
Dialogue: 0,0:02:55.80,0:02:57.77,Default,,0,0,0,,📺Ертең кездескенше.
Dialogue: 0,0:02:57.77,0:03:14.09,Default,,0,0,0,,♬～
Dialogue: 0,0:03:14.09,0:03:17.93,Default,,0,0,0,,Хмм….
Dialogue: 0,0:03:17.93,0:03:21.00,Default,,0,0,0,,Уф. Мен бұлай болады деп күтпеген едім...
Dialogue: 0,0:03:21.00,0:03:23.27,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба? Эй!
Dialogue: 0,0:03:23.27,0:03:26.40,Default,,0,0,0,,Төраға... Бұны қанша уақыт жазуым керек➡
Dialogue: 0,0:03:26.40,0:03:30.07,Default,,0,0,0,,Жарайды ма? Қазір 200-ге жуық дана бар.
Dialogue: 0,0:03:30.07,0:03:32.91,Default,,0,0,0,,Өзіңіз 1000 дана жазамын деп айтпадыңыз ба?
Dialogue: 0,0:03:32.91,0:03:36.08,Default,,0,0,0,,Соған қатты өкінемін➡
Dialogue: 0,0:03:36.08,0:03:39.58,Default,,0,0,0,,Бұл метафора... Аузыңнан гөрі қолыңды қимылда.
Dialogue: 0,0:03:39.58,0:03:41.68,Default,,0,0,0,,Мен бар күшімді саламын.
Dialogue: 0,0:03:44.75,0:03:48.12,Default,,0,0,0,,Ойлап қарасам, Абыдостық Хошино деген кісі➡
Dialogue: 0,0:03:48.12,0:03:51.93,Default,,0,0,0,,Бір-біріңді білесіңдер ме? Жоқ, барлау бөлімінде жүргенімде➡
Dialogue: 0,0:03:51.93,0:03:55.93,Default,,0,0,0,,Мен біраз зерттеу жасадым, бірақ мен оны бірінші рет кездестіруім еді.
Dialogue: 0,0:03:55.93,0:03:59.60,Default,,0,0,0,,Солай болды ма? Мен білетін адам сияқты ➡
Dialogue: 0,0:03:59.60,0:04:03.41,Default,,0,0,0,,Өйткені ол айтылған. Хошино Которию….
Dialogue: 0,0:04:03.41,0:04:06.24,Default,,0,0,0,,Данышпан деп аталатын нағыз элита.
Dialogue: 0,0:04:06.24,0:04:08.91,Default,,0,0,0,,2 жыл бұрын Барлау бөлімінің талдауы бойынша ➡
Dialogue: 0,0:04:08.91,0:04:11.91,Default,,0,0,0,,Гееннаға ықтимал қауіп ретінде➡
Dialogue: 0,0:04:11.91,0:04:14.08,Default,,0,0,0,,көрсетілген.
Dialogue: 0,0:04:14.08,0:04:17.59,Default,,0,0,0,,Бұл мүлде олай емес еді...
Dialogue: 0,0:04:17.59,0:04:21.09,Default,,0,0,0,,Ако: Біреуді сырт келбетіне қарап бағаламау керек.
Dialogue: 0,0:04:21.09,0:04:24.53,Default,,0,0,0,,Хмм... Бірақ, әрине➡
Dialogue: 0,0:04:24.53,0:04:27.93,Default,,0,0,0,,Ол екі жыл бұрынғыдан басқа адам сияқты көрінді.
Dialogue: 0,0:04:27.93,0:04:30.83,Default,,0,0,0,,Бастапқыда шабуыл тактикасына маманданған➡
Dialogue: 0,0:04:30.83,0:04:33.37,Default,,0,0,0,,Өте ұрысқақ тип➡
Dialogue: 0,0:04:33.37,0:04:39.57,Default,,0,0,0,,Мен оны пышақ сияқты өрескел және өткір деп ойладым.
Dialogue: 0,0:04:39.57,0:04:43.51,Default,,0,0,0,,Одан бөлек, егер біз шайқаста жүре берсек➡
Dialogue: 0,0:04:43.51,0:04:47.12,Default,,0,0,0,,Тәртіптік комиссия мүшелерінің көпшілігі әрекетке қабілетсіз болуы керек еді.
Dialogue: 0,0:04:47.12,0:04:49.95,Default,,0,0,0,,Ако Сіз өте жылдамсыз.
Dialogue: 0,0:04:49.95,0:04:53.42,Default,,0,0,0,,Олар өздерінің әскери күштерін мұқият талдауы керек еді➡
Dialogue: 0,0:04:53.42,0:04:56.59,Default,,0,0,0,,Мұндай ақпарат... Ал, бір күні кенеттен➡
Dialogue: 0,0:04:56.59,0:04:59.13,Default,,0,0,0,,Әрекет туралы есептер де тоқтатылды.
Dialogue: 0,0:04:59.13,0:05:03.27,Default,,0,0,0,,Барлау бөлімі оны әу бастан қауіп деп санамаған шығар.
Dialogue: 0,0:05:03.27,0:05:05.27,Default,,0,0,0,,Толығырақ білгіңіз келсе ➡
Dialogue: 0,0:05:05.27,0:05:07.74,Default,,0,0,0,,Ескі құжат болса да, оны келесі күні іздеп көріңіз.
Dialogue: 0,0:05:09.74,0:05:13.28,Default,,0,0,0,,Ако Қол тоқтатылды. Ха, иә!
Dialogue: 0,0:05:13.28,0:05:16.58,Default,,0,0,0,,Хошино Которию... Абыдостан әлі кеткен жоқ➡
Dialogue: 0,0:05:16.58,0:05:18.68,Default,,0,0,0,,Ол қалды.
Dialogue: 0,0:05:25.09,0:05:29.26,Default,,0,0,0,,Мм... мұны қайда апаруым керек...?
Dialogue: 0,0:05:29.26,0:05:32.13,Default,,0,0,0,,Хмм? Әй, Аль-Чан➡
Dialogue: 0,0:05:32.13,0:05:36.20,Default,,0,0,0,,Бұл өзінің табиғи талантын танытқан каллиграфиясының қалдығы.
Dialogue: 0,0:05:36.20,0:05:39.77,Default,,0,0,0,,Ол жақтағы жанғыш қоқыс жақсы. Бұл жақсы ма?
Dialogue: 0,0:05:39.77,0:05:42.77,Default,,0,0,0,,Каллиграфия сабағында осылай жаздыңыз, солай ма?
Dialogue: 0,0:05:42.77,0:05:46.91,Default,,0,0,0,,Президент оны өзімен бірге алып кеткісі келетінін айтуы мүмкін.
Dialogue: 0,0:05:46.91,0:05:49.08,Default,,0,0,0,,Аа...
Dialogue: 0,0:05:49.08,0:05:53.08,Default,,0,0,0,,Құрметті Әл…. Мен қозғалуды шынымен жек көремін.
Dialogue: 0,0:05:53.08,0:05:55.45,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін, бірақ тәртіптік комитетке➡
Dialogue: 0,0:05:55.45,0:05:58.75,Default,,0,0,0,,Менің орным белгілі болды және менің миссиям сәтсіз болды, сондықтан клиент те білді➡
Dialogue: 0,0:05:58.75,0:06:01.92,Default,,0,0,0,,Сіз мақсатты боласыз, сондықтан бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:06:01.92,0:06:04.43,Default,,0,0,0,,Уф... Айтпақшы➡
Dialogue: 0,0:06:04.43,0:06:07.83,Default,,0,0,0,,Неге екені белгісіз, Абыдостағы қақтығыс жартылай ғана аяқталды.
Dialogue: 0,0:06:07.83,0:06:11.43,Default,,0,0,0,,Олай болса айта алмаймын!
Dialogue: 0,0:06:11.43,0:06:13.97,Default,,0,0,0,,Бізбен бірге соғысып, артымызды тастап кеткендер➡
Dialogue: 0,0:06:13.97,0:06:17.51,Default,,0,0,0,,Енді мен оны мақсат ете алмаймын!
Dialogue: 0,0:06:17.51,0:06:20.11,Default,,0,0,0,,Мен көрдім. Қосқыш сонда ➡
Dialogue: 0,0:06:20.11,0:06:22.91,Default,,0,0,0,,Заңсыз адам ретінде... иә!
Dialogue: 0,0:06:22.91,0:06:26.28,Default,,0,0,0,,Сондықтан дұрыс қозғалуымыз керек, солай ма?
Dialogue: 0,0:06:26.28,0:06:28.28,Default,,0,0,0,,Уф….
Dialogue: 0,0:06:28.28,0:06:30.59,Default,,0,0,0,,Кайоко-чан, мұнымен не істеуіміз керек?
Dialogue: 0,0:06:30.59,0:06:32.59,Default,,0,0,0,,Бұл сізге керек пе?
Dialogue: 0,0:06:32.59,0:06:36.09,Default,,0,0,0,,Бұл міндетті түрде қажет! Смартфон жеткілікті болса да.
Dialogue: 0,0:06:36.09,0:06:38.46,Default,,0,0,0,,Бұл ыңғайлылық емес, эмоция мәселесі!
Dialogue: 0,0:06:38.46,0:06:41.23,Default,,0,0,0,,Бұл не? Бұл ретро дизайн!
Dialogue: 0,0:06:41.23,0:06:43.27,Default,,0,0,0,,Құқық бұзушының кеңсесі үшін орынды болар еді! ?
Dialogue: 0,0:06:43.27,0:06:45.93,Default,,0,0,0,,Уау, түсіндім!
Dialogue: 0,0:06:45.93,0:06:50.44,Default,,0,0,0,,А... бұл тамаша, солай емес пе?
Dialogue: 0,0:06:52.81,0:06:55.08,Default,,0,0,0,,Сіз күткендей, Харука.
Dialogue: 0,0:06:55.08,0:06:59.08,Default,,0,0,0,,Бұл шегіну емес, келесі қадамға жасалған қадам!
Dialogue: 0,0:06:59.08,0:07:01.75,Default,,0,0,0,,Кез келген қиындықтан қайт!
Dialogue: 0,0:07:01.75,0:07:04.92,Default,,0,0,0,,Мен бұл кеңсеге тағы бір рет қайтамын!
Dialogue: 0,0:07:04.92,0:07:09.59,Default,,0,0,0,,Өйткені! Біз нағыз заңсыздықтармыз➡
Dialogue: 0,0:07:09.59,0:07:12.93,Default,,0,0,0,,Ол шебер 68! (ысырма дыбысы)
Dialogue: 0,0:07:12.93,0:07:17.97,Default,,0,0,0,,А... Мен ертең бұл жермен қоштасамын.
Dialogue: 0,0:07:17.97,0:07:21.00,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:21.00,0:07:23.57,Default,,0,0,0,,📱
Dialogue: 0,0:07:23.57,0:07:26.74,Default,,0,0,0,,Президент, мен өткен айдың пәтер ақысын да төлеген жоқпын➡
Dialogue: 0,0:07:26.74,0:07:28.91,Default,,0,0,0,,Бүгінге дейін кетуі керек деді.
Dialogue: 0,0:07:28.91,0:07:31.41,Default,,0,0,0,,Иә! Ахаха... Құрметті Аль...
Dialogue: 0,0:07:31.41,0:07:34.28,Default,,0,0,0,,Сонымен, кемпинг расталды! Нана...
Dialogue: 0,0:07:34.28,0:07:38.49,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:46.90,0:07:50.00,Default,,0,0,0,,Енді бәрі жүктелді. Иә.
Dialogue: 0,0:07:50.00,0:07:53.23,Default,,0,0,0,,Аа... Көңіліңді көтер, Аль-Чан.
Dialogue: 0,0:07:53.23,0:07:56.07,Default,,0,0,0,,Бұл жабайы табиғатта алғаш рет кемпингке шығуым емес.
Dialogue: 0,0:07:56.07,0:07:58.74,Default,,0,0,0,,Ол біраз бұрынғы күйіне қайтады.
Dialogue: 0,0:07:58.74,0:08:01.24,Default,,0,0,0,,Артқа... Ха!
Dialogue: 0,0:08:01.24,0:08:03.75,Default,,0,0,0,,Артқа емес Артқа емес! Бұл прогресс!
Dialogue: 0,0:08:03.75,0:08:07.58,Default,,0,0,0,,Ахаха, дұрыс! Сонда қайда барамыз?
Dialogue: 0,0:08:07.58,0:08:11.25,Default,,0,0,0,,Хмм. Бұл өте дәл емес сияқты➡
Dialogue: 0,0:08:11.25,0:08:13.25,Default,,0,0,0,,Жаһаннамға қайта оралу керек пе? (велосипед дыбысы)
Dialogue: 0,0:08:15.26,0:08:18.39,Default,,0,0,0,,Сіз бір жерге көшіп жатырсыз ба? Ах.
Dialogue: 0,0:08:18.39,0:08:23.26,Default,,0,0,0,,Мм... Бұл Құм қасқыр Широко-чан, солай ма?
Dialogue: 0,0:08:23.26,0:08:26.30,Default,,0,0,0,,Хмм…. Неге мұндасың?
Dialogue: 0,0:08:26.30,0:08:28.90,Default,,0,0,0,,Жоқ, мен тағы бір шайқас жасауды жоспарлап отырмын! ?
Dialogue: 0,0:08:28.90,0:08:33.91,Default,,0,0,0,,Жоқ, мен оны жақын жерде келе жатып кездейсоқ көрдім.
Dialogue: 0,0:08:33.91,0:08:36.21,Default,,0,0,0,,Аа….
Dialogue: 0,0:08:42.08,0:08:46.09,Default,,0,0,0,,А-а... өткен күні...
Dialogue: 0,0:08:48.42,0:08:50.63,Default,,0,0,0,,Көмегің үшін көп рахмет!
Dialogue: 0,0:08:55.10,0:08:58.27,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:08:58.27,0:09:00.44,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:04.64,0:09:07.18,Default,,0,0,0,,О, рамен дүкені туралы ...
Dialogue: 0,0:09:07.18,0:09:10.08,Default,,0,0,0,,Бұл рұқсат етілмейді!
Dialogue: 0,0:09:10.08,0:09:14.08,Default,,0,0,0,,Бірақ ол өкінетін сияқты➡
Dialogue: 0,0:09:14.08,0:09:16.25,Default,,0,0,0,,Қарыз беру арқылы.
Dialogue: 0,0:09:16.25,0:09:20.42,Default,,0,0,0,,Балалар, сендер сөмкені сонда қалдырдыңдар, солай ма?
Dialogue: 0,0:09:20.42,0:09:22.76,Default,,0,0,0,,Нана Нана Сіз нені айтып тұрсыз?
Dialogue: 0,0:09:22.76,0:09:25.59,Default,,0,0,0,,Мен сөмке толы ақша дегенді естімеппін! ?
Dialogue: 0,0:09:25.59,0:09:28.23,Default,,0,0,0,,Мен оны ешқашан көрген де, естіген де емеспін! ?
Dialogue: 0,0:09:28.23,0:09:30.77,Default,,0,0,0,,Га. Әл: «Менде ақша бар» деді➡
Dialogue: 0,0:09:30.77,0:09:36.24,Default,,0,0,0,,Айтқан бойда бұл туралы айтуға жарамайсың.
Dialogue: 0,0:09:36.24,0:09:40.28,Default,,0,0,0,,А, бұл! Банк тонаудан ұрлаған ақшаң осы!
Dialogue: 0,0:09:40.28,0:09:42.81,Default,,0,0,0,,Мен оны көтергендіктен, мен оны өзіме айналдырдым➡
Dialogue: 0,0:09:42.81,0:09:44.91,Default,,0,0,0,,Мен бас тарта алмаймын! Сондай-ақ заң бұзушылар үшін➡
Dialogue: 0,0:09:44.91,0:09:46.95,Default,,0,0,0,,Кежиме деген бар ғой!
Dialogue: 0,0:09:46.95,0:09:49.92,Default,,0,0,0,,Ах, ол қайта ашылды. Сол сөмке➡
Dialogue: 0,0:09:49.92,0:09:53.76,Default,,0,0,0,,Мен оны генералға жеткіздім. Мен түсінемін. Рақмет сізге.
Dialogue: 0,0:09:53.76,0:09:56.26,Default,,0,0,0,,Хмм….
Dialogue: 0,0:09:56.26,0:09:59.93,Default,,0,0,0,,Қайда бара жатырсың? Аа…. Фуфуфуфуфу….
Dialogue: 0,0:09:59.93,0:10:03.70,Default,,0,0,0,,Ұстаз 68 іздейтін клиенттерге барыңыз!
Dialogue: 0,0:10:06.07,0:10:08.77,Default,,0,0,0,,Аль-чан, кететін уақыт болды.
Dialogue: 0,0:10:08.77,0:10:11.94,Default,,0,0,0,,Иә, дұрыс. Сондай-ақ, бүгін кешке қай жерде лагерьге баруға болады➡
Dialogue: 0,0:10:11.94,0:10:16.11,Default,,0,0,0,,Мен оны табуым керек... Дұрыс...
Dialogue: 0,0:10:19.41,0:10:21.42,Default,,0,0,0,,Дұрыс емес пе?
Dialogue: 0,0:10:21.42,0:10:24.75,Default,,0,0,0,,Эй, мен сенімен енді таныс болмаймын!
Dialogue: 0,0:10:24.75,0:10:28.59,Default,,0,0,0,,Аа... өйткені... Өйткені ол заңнан тыс адам.
Dialogue: 0,0:10:28.59,0:10:31.39,Default,,0,0,0,,Біз тағы кездесеміз бе? Әй, анау рамен дүкені➡
Dialogue: 0,0:10:31.39,0:10:36.10,Default,,0,0,0,,Қайтадан дүкен ашсаң, сонда кездесеміз деп ойлаймын.
Dialogue: 0,0:10:36.10,0:10:38.40,Default,,0,0,0,,Хмм... Мен күтемін.
Dialogue: 0,0:10:38.40,0:10:40.94,Default,,0,0,0,,Келіңіздер! Біз де кетеміз!
Dialogue: 0,0:10:40.94,0:10:43.10,Default,,0,0,0,,Қайда? Күн батқанға қарай!
Dialogue: 0,0:10:43.10,0:10:45.07,Default,,0,0,0,,Әлі түскі ме?
Dialogue: 0,0:10:45.07,0:10:47.38,Default,,0,0,0,,Жақсы! Барайық!
Dialogue: 0,0:10:59.09,0:11:01.12,Default,,0,0,0,,Сәлеметсіз бе. иә?
Dialogue: 0,0:11:01.12,0:11:03.26,Default,,0,0,0,,Генерал, мен сізді көруге келдім!
Dialogue: 0,0:11:03.26,0:11:05.76,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:11:05.76,0:11:08.43,Default,,0,0,0,,Эй, мен оны аздап ысқылап жібердім.
Dialogue: 0,0:11:08.43,0:11:11.10,Default,,0,0,0,,Оның үстіне бұл керемет жарылыс болды➡
Dialogue: 0,0:11:11.10,0:11:14.60,Default,,0,0,0,,Менен басқа ешкім зардап шекпегеніне өте қуаныштымын.
Dialogue: 0,0:11:14.60,0:11:16.77,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:11:16.77,0:11:19.61,Default,,0,0,0,,Шибасеки рамен... Ах....
Dialogue: 0,0:11:19.61,0:11:22.44,Default,,0,0,0,,Мен енді толық емес жұмыс күнімен жұмыс істей алмайтыныма өкінемін, Селика-чан.
Dialogue: 0,0:11:22.44,0:11:25.95,Default,,0,0,0,,Жалпы: Мәселе мынада... Жарайды.
Dialogue: 0,0:11:25.95,0:11:29.35,Default,,0,0,0,,Біріншіден, мен жақын арада дүкенді жабуды жоспарладым.
Dialogue: 0,0:11:29.35,0:11:32.09,Default,,0,0,0,,Ах. Эй, менің біраз жоспарларым бар➡
Dialogue: 0,0:11:32.09,0:11:35.59,Default,,0,0,0,,Бұл жылдамырақ. Сізде дүкен бар ма?
Dialogue: 0,0:11:35.59,0:11:39.49,Default,,0,0,0,,Ах. Біраз бұрын үйден шығару туралы хабарлама алдым.
Dialogue: 0,0:11:39.49,0:11:42.10,Default,,0,0,0,,Көшіру туралы хабарлама дегенді қалай түсінесіз?
Dialogue: 0,0:11:42.10,0:11:46.60,Default,,0,0,0,,Абыдос автономиялық аймағындағы ғимараттардың меншігі Абыдос орта мектебі болып табылады….
Dialogue: 0,0:11:46.60,0:11:51.17,Default,,0,0,0,,Балалар, сендер білмедіңдер.
Dialogue: 0,0:11:51.17,0:11:53.41,Default,,0,0,0,,Бірнеше жыл бұрын Абыдос студенттік кеңесінен➡
Dialogue: 0,0:11:53.41,0:11:56.41,Default,,0,0,0,,Ғимарат пен жер учаскесіне меншік құқығы берілді.
Dialogue: 0,0:11:56.41,0:11:58.95,Default,,0,0,0,,Абыдос автономиялық аймағы болса да?
Dialogue: 0,0:11:58.95,0:12:01.35,Default,,0,0,0,,Селика-чан, сен білесің бе?
Dialogue: 0,0:12:01.35,0:12:04.25,Default,,0,0,0,,Жоқ, мен оны бірінші рет естіп тұрмын.
Dialogue: 0,0:12:04.25,0:12:07.76,Default,,0,0,0,,Бұл біз төлегеннен гөрі көп ақша қарыз екенімізді білдіре ме?
Dialogue: 0,0:12:07.76,0:12:09.76,Default,,0,0,0,,Мен де білмедім.
Dialogue: 0,0:12:09.76,0:12:13.66,Default,,0,0,0,,Енді ол кімдікі? ?
Dialogue: 0,0:12:13.66,0:12:18.23,Default,,0,0,0,,Мүмкін... Kaiser корпорациясы.
Dialogue: 0,0:12:18.23,0:12:21.90,Default,,0,0,0,,Хмм, мен бұл атау сияқты сезінемін ...
Dialogue: 0,0:12:21.90,0:12:25.34,Default,,0,0,0,,анық есімде жоқ.
Dialogue: 0,0:12:25.34,0:12:30.41,Default,,0,0,0,,Хм... Бір рет егжей-тегжейлі зерттеген дұрыс деп ойлаймын.
Dialogue: 0,0:12:30.41,0:12:32.78,Default,,0,0,0,,Аяне-чан! Маған да көмектесуге рұқсат етіңіз!
Dialogue: 0,0:12:32.78,0:12:35.42,Default,,0,0,0,,Мен де! Маған бірдеңе айтыңызшы!
Dialogue: 0,0:12:35.42,0:12:38.59,Default,,0,0,0,,Бұл біртүрлі. Біртүрлі болды.
Dialogue: 0,0:12:38.59,0:12:42.09,Default,,0,0,0,,Жоқ. Өйткені бұл бәріміз үшін проблема.
Dialogue: 0,0:12:42.09,0:12:45.49,Default,,0,0,0,,Керісінше, генерал, зейнетке шығу туралы әлі ойламаңыз!
Dialogue: 0,0:12:45.49,0:12:48.30,Default,,0,0,0,,Түсіндім! ? О, ой.
Dialogue: 0,0:12:48.30,0:12:51.43,Default,,0,0,0,,Ах! Ал, кереуеттің астында не жатқанын көрейік➡
Dialogue: 0,0:12:51.43,0:12:54.94,Default,,0,0,0,,Сіз мені шығарып ала аласыз ба? (3 адам) Иә?
Dialogue: 0,0:12:54.94,0:12:58.11,Default,,0,0,0,,Не?
Dialogue: 0,0:12:58.11,0:13:00.07,Default,,0,0,0,,Сіз бірдеңе білесіз бе?
Dialogue: 0,0:13:00.07,0:13:02.78,Default,,0,0,0,,Иә, жоқ, бұл... Айтайын дегенім, мен білемін...
Dialogue: 0,0:13:02.78,0:13:05.45,Default,,0,0,0,,Бұл... Жоқ, дәл қазір➡
Dialogue: 0,0:13:05.45,0:13:07.62,Default,,0,0,0,,Широко-чан маған әкелді.
Dialogue: 0,0:13:07.62,0:13:10.62,Default,,0,0,0,,Өртеніп кеткен дүкеннің алдында қалды деді.
Dialogue: 0,0:13:10.62,0:13:13.76,Default,,0,0,0,,Болды деп іштей ойланып, аштым➡
Dialogue: 0,0:13:13.76,0:13:17.09,Default,,0,0,0,,Мені таң қалдырғаны, ол көп ақшаға толы болды.
Dialogue: 0,0:13:17.09,0:13:19.43,Default,,0,0,0,,Бұл шынымен жай әзіл ме?
Dialogue: 0,0:13:19.43,0:13:23.97,Default,,0,0,0,,Бұл дұрыс емес! Бұл жақсы ниетті үшінші жақтан болуы керек!
Dialogue: 0,0:13:23.97,0:13:27.10,Default,,0,0,0,,Иә! Бұл Shibaseki Ramen➡ қайта іске қосу
Dialogue: 0,0:13:27.10,0:13:29.94,Default,,0,0,0,,Менің ойымша, сіз оны пайдалана аласыз! иә!
Dialogue: 0,0:13:29.94,0:13:32.97,Default,,0,0,0,,Бұл ақшаны бергендер міндетті түрде Шибасеки Рамен дәмін татады➡
Dialogue: 0,0:13:32.97,0:13:37.11,Default,,0,0,0,,Мен қатты әсер еттім деп ойлаймын! Сатан алғыр….
Dialogue: 0,0:13:37.11,0:13:41.12,Default,,0,0,0,,Егер солай болса, онда рамен дүкені уақытты босқа өткізеді.
Dialogue: 0,0:13:41.12,0:13:43.25,Default,,0,0,0,,Мен жай ғана аш тұтынушымын➡
Dialogue: 0,0:13:43.25,0:13:46.19,Default,,0,0,0,,Мен сенің дәмді раменді көп жегеніңді қалаймын➡
Dialogue: 0,0:13:46.19,0:13:49.29,Default,,0,0,0,,Өйткені мен солай ойладым және көп еңбек еттім.
Dialogue: 0,0:13:49.29,0:13:52.09,Default,,0,0,0,,Барлығы генералдың раменін күтуде!
Dialogue: 0,0:13:52.09,0:13:55.46,Default,,0,0,0,,Тезірек сауығып, дүкеніңізді қалпына келтіріңіз!
Dialogue: 0,0:13:55.46,0:13:59.10,Default,,0,0,0,,Олай болса мені тағы да толық емес жұмысшы етіп ал! ? Генерал!
Dialogue: 0,0:13:59.10,0:14:02.44,Default,,0,0,0,,О! Маған қалдырыңыз! Біз қайта ашқан бойда ➡
Dialogue: 0,0:14:02.44,0:14:04.81,Default,,0,0,0,,Маған көп жеуге рұқсат етіңіз!
Dialogue: 0,0:14:04.81,0:14:07.48,Default,,0,0,0,,Иә! Мен оны асыға күтемін!
Dialogue: 0,0:14:13.61,0:14:15.58,Default,,0,0,0,,Сәлем Хошино.
Dialogue: 0,0:14:15.58,0:14:18.99,Default,,0,0,0,,Ауа-райы жақсы. Бүгін төбеде ұйықтаймыз ба?
Dialogue: 0,0:14:18.99,0:14:21.26,Default,,0,0,0,,Ух... иә.
Dialogue: 0,0:14:21.26,0:14:25.09,Default,,0,0,0,,Мен солай деп ойлаймын. Мұндай мұғалім кім?
Dialogue: 0,0:14:25.09,0:14:28.26,Default,,0,0,0,,Мен де біраз демалсам ба деп ойлаймын.
Dialogue: 0,0:14:28.26,0:14:30.26,Default,,0,0,0,,Ммм.
Dialogue: 0,0:14:30.26,0:14:33.94,Default,,0,0,0,,Сіздің келгеніңізге біраз уақыт болды.
Dialogue: 0,0:14:33.94,0:14:37.81,Default,,0,0,0,,Иә? Менен сұрасаңыз, бұл рас.
Dialogue: 0,0:14:37.81,0:14:41.34,Default,,0,0,0,,Басында мен біртүрлі ересек адам келді деп ойладым, бірақ...
Dialogue: 0,0:14:41.34,0:14:44.45,Default,,0,0,0,,Сіз сенімді болдыңыз, солай ма? Мүмкін емес.
Dialogue: 0,0:14:44.45,0:14:46.45,Default,,0,0,0,,Ол ебедейсіз және жалқау.
Dialogue: 0,0:14:46.45,0:14:49.25,Default,,0,0,0,,Хахаха…. Бірақ ➡
Dialogue: 0,0:14:49.25,0:14:53.42,Default,,0,0,0,,Жұмыс тобында барлығы бұрынғыға қарағанда белсендірек.
Dialogue: 0,0:14:53.42,0:14:56.29,Default,,0,0,0,,Мен емес, әркім мақсатқа қарай ұмтылады➡
Dialogue: 0,0:14:56.29,0:14:58.86,Default,,0,0,0,,Менің ойымша, бұл менің алға қарай бастадым.
Dialogue: 0,0:14:58.86,0:15:02.10,Default,,0,0,0,,Ухехе... Бұл рас шығар.
Dialogue: 0,0:15:02.10,0:15:05.50,Default,,0,0,0,,Селика-чан барлығына арқа сүйейтін болды➡
Dialogue: 0,0:15:05.50,0:15:08.04,Default,,0,0,0,,Аяне-чанның ➡ қарауға уақыты бар
Dialogue: 0,0:15:08.04,0:15:11.41,Default,,0,0,0,,Ол өсті ме? Нономи-чан ешкімге арналмаған➡
Dialogue: 0,0:15:11.41,0:15:14.41,Default,,0,0,0,,Маған шын күлетіндер көбейді.
Dialogue: 0,0:15:14.41,0:15:18.95,Default,,0,0,0,,Широко-чан... Иә. Мен тереңірек дем алып жатырмын деп ойлаймын.
Dialogue: 0,0:15:18.95,0:15:21.58,Default,,0,0,0,,Хаха. Хошино да барын салып жатыр.
Dialogue: 0,0:15:21.58,0:15:23.62,Default,,0,0,0,,Барлығы да маған сенеді.
Dialogue: 0,0:15:23.62,0:15:27.79,Default,,0,0,0,,Қарт тек әр адамның өмірін қорғағысы келеді.
Dialogue: 0,0:15:27.79,0:15:30.26,Default,,0,0,0,,Аа... Дұрыс.
Dialogue: 0,0:15:38.10,0:15:41.70,Default,,0,0,0,,Барлығын күлдіретін де осы.
Dialogue: 0,0:15:45.51,0:15:48.61,Default,,0,0,0,,Ол үшін алға ұмтылудан басқа амалымыз жоқ...
Dialogue: 0,0:15:48.61,0:15:50.78,Default,,0,0,0,,Иә? Ал, ұстазға➡
Dialogue: 0,0:15:50.78,0:15:54.95,Default,,0,0,0,,Олай десеңіз, мен тыныштықпен ұйықтай аламын.
Dialogue: 0,0:15:54.95,0:15:57.85,Default,,0,0,0,,Мен сирек кездесетін және байсалды әңгіме болды деп ойладым➡
Dialogue: 0,0:15:57.85,0:16:00.52,Default,,0,0,0,,Сен баласың... Ухехе....
Dialogue: 0,0:16:06.29,0:16:09.63,Default,,0,0,0,,Сәлем Алона. Эххехехе....
Dialogue: 0,0:16:09.63,0:16:13.20,Default,,0,0,0,,Иә? Міне бітті! ? Аронаның құлпынай кастелласы! ?
Dialogue: 0,0:16:13.20,0:16:16.40,Default,,0,0,0,,Банан кастелла! ? Өйткені мен бірден екі жеуге тырыстым➡
Dialogue: 0,0:16:16.40,0:16:18.77,Default,,0,0,0,,Барабан соқты ма? Арона?
Dialogue: 0,0:16:18.77,0:16:22.58,Default,,0,0,0,,Тым болмаса бір тістеп жесеңші... Әй, ұстаз! ?
Dialogue: 0,0:16:22.58,0:16:24.61,Default,,0,0,0,,Мен келесі жолы кастелла сатып аламын.
Dialogue: 0,0:16:24.61,0:16:29.08,Default,,0,0,0,,Құлпынай мен банан. Уф, бұл ұят...
Dialogue: 0,0:16:29.08,0:16:33.09,Default,,0,0,0,,Бірақ рахмет! Мен оны асыға күтемін!
Dialogue: 0,0:16:33.09,0:16:35.92,Default,,0,0,0,,Айтпақшы, бүгінде қандай кәсіппен айналысасыз?
Dialogue: 0,0:16:35.92,0:16:38.89,Default,,0,0,0,,А, мені бір нәрсе алаңдатады...
Dialogue: 0,0:16:38.89,0:16:42.13,Default,,0,0,0,,Kaiser корпорациясын қарап шыға аласыз ба?
Dialogue: 0,0:16:42.13,0:16:46.27,Default,,0,0,0,,Kaiser корпорациясы? Шамасы Абыдос шөлінде➡
Dialogue: 0,0:16:46.27,0:16:49.77,Default,,0,0,0,,Ол бірдеңе істеп жатқан сияқты. Менде бар!
Dialogue: 0,0:16:49.77,0:16:52.17,Default,,0,0,0,,Тағы бір нәрсені зерттеу керек➡
Dialogue: 0,0:16:52.17,0:16:55.78,Default,,0,0,0,,Жақсы нәрселер бар ма? Хошино...
Dialogue: 0,0:16:55.78,0:16:58.45,Default,,0,0,0,,Иә? (Мұғалім) А... жоқ➡
Dialogue: 0,0:16:58.45,0:17:00.58,Default,,0,0,0,,Ештеңе. Күткендей➡
Dialogue: 0,0:17:00.58,0:17:04.42,Default,,0,0,0,,Мен бұл туралы бірдеңе істеуім керек.
Dialogue: 0,0:17:04.42,0:17:07.99,Default,,0,0,0,,Себебі мен мұғаліммін.
Dialogue: 0,0:17:07.99,0:17:12.26,Default,,0,0,0,,Хмм, солай ма? Мұғалім солай айтса.
Dialogue: 0,0:17:12.26,0:17:14.93,Default,,0,0,0,,Рахмет. Мен әрқашан саған сенемін.
Dialogue: 0,0:17:14.93,0:17:18.43,Default,,0,0,0,,Маған қалдырыңыз. Өйткені➡
Dialogue: 0,0:17:18.43,0:17:22.10,Default,,0,0,0,,Alona - Shittemu's Box➡ үшін тамаша жүйелік әкімші
Dialogue: 0,0:17:22.10,0:17:25.01,Default,,0,0,0,,Негізгі ОЖ және ➡
Dialogue: 0,0:17:25.01,0:17:27.48,Default,,0,0,0,,Ол мұғалімге көмектесетін хатшы!
Dialogue: 0,0:17:31.08,0:17:33.75,Default,,0,0,0,,Меніңше, барлығы осында.
Dialogue: 0,0:17:33.75,0:17:37.42,Default,,0,0,0,,Сәлеметсіз бе, сэр.
Dialogue: 0,0:17:37.42,0:17:40.76,Default,,0,0,0,,Барлығыңызға қош келдіңіздер. Генералдың жағдайы қалай болды?
Dialogue: 0,0:17:40.76,0:17:43.59,Default,,0,0,0,,Иә, мен физикалық жағынан да, психикалық жағынан да жақсы болдым.
Dialogue: 0,0:17:43.59,0:17:46.76,Default,,0,0,0,,Шибасеки Рамен де жақында қайта ашылады.
Dialogue: 0,0:17:46.76,0:17:49.10,Default,,0,0,0,,көремін. Бұл жақсы.
Dialogue: 0,0:17:49.10,0:17:52.93,Default,,0,0,0,,Иә…. иә? не болды?
Dialogue: 0,0:17:52.93,0:17:56.07,Default,,0,0,0,,Негізі тағы бір мәселе туындады...
Dialogue: 0,0:17:56.07,0:17:59.27,Default,,0,0,0,,Мен бұл туралы айтайын деп едім.
Dialogue: 0,0:17:59.27,0:18:03.28,Default,,0,0,0,,Қарапайым тілмен айтқанда, бұл аймақтағы меншік құқығы ➡
Dialogue: 0,0:18:03.28,0:18:07.62,Default,,0,0,0,,Бұл Абыдос орта мектебінде жоқ сияқты. А... неге! ?
Dialogue: 0,0:18:07.62,0:18:10.62,Default,,0,0,0,,Автономиялық округтегі жер сол округтегі мектептікі емес пе?
Dialogue: 0,0:18:10.62,0:18:14.26,Default,,0,0,0,,Генералдың айтуынша, Шибасеки Рамен тұрған ғимарат та сол жерде➡
Dialogue: 0,0:18:14.26,0:18:16.96,Default,,0,0,0,,Ол енді Абыдос орта мектебіне жатпайды.
Dialogue: 0,0:18:19.13,0:18:22.40,Default,,0,0,0,,Бұл қашан басталды? Түсінікті болу үшін...
Dialogue: 0,0:18:22.40,0:18:25.60,Default,,0,0,0,,Бірақ генерал: ``Бірнеше жыл бұрын.'' деді.
Dialogue: 0,0:18:25.60,0:18:28.10,Default,,0,0,0,,Сонда ол қазір кім...?
Dialogue: 0,0:18:28.10,0:18:30.57,Default,,0,0,0,,Kaiser корпорациясы….
Dialogue: 0,0:18:33.27,0:18:35.94,Default,,0,0,0,,Бұл жақында болған оқиға ғана емес.
Dialogue: 0,0:18:35.94,0:18:39.85,Default,,0,0,0,,Ұсталар мен дулыға бригадасы бұдан бұрын да➡
Dialogue: 0,0:18:39.85,0:18:43.08,Default,,0,0,0,,Біз әрқашан Kaiser корпорациясының қолында болдық...
Dialogue: 0,0:18:43.08,0:18:45.59,Default,,0,0,0,,Ах! Мен қатты ашуланып барамын!
Dialogue: 0,0:18:45.59,0:18:48.26,Default,,0,0,0,,Нәтижесін көрмейінше білмейміз.
Dialogue: 0,0:18:48.26,0:18:52.26,Default,,0,0,0,,Әйтпесе деген жол да бар... Хм.
Dialogue: 0,0:18:52.26,0:18:55.76,Default,,0,0,0,,Уау…. Соңғы кездері➡
Dialogue: 0,0:18:55.76,0:18:59.43,Default,,0,0,0,,Қанша ұйықтасам да, өзімді ұйықтағандай сезінбеймін.
Dialogue: 0,0:18:59.43,0:19:02.90,Default,,0,0,0,,Ой, сен қартайдың ғой, солай ма?
Dialogue: 0,0:19:02.90,0:19:07.44,Default,,0,0,0,,Ой! Ей, қараңдар! Бұл бұлт китке ұқсамайды ма?
Dialogue: 0,0:19:07.44,0:19:10.41,Default,,0,0,0,,Ым... Хошино-сенпай? Қараңдар, қараңдар➡
Dialogue: 0,0:19:10.41,0:19:13.75,Default,,0,0,0,,Анау үлкені. Аянаның позициясынан➡
Dialogue: 0,0:19:13.75,0:19:16.42,Default,,0,0,0,,Сіз оны көре алмайсыз. Мында кел.
Dialogue: 0,0:19:16.42,0:19:20.42,Default,,0,0,0,,Бұл зиян тигізбейді. Өтінемін, тартпаңыз!
Dialogue: 0,0:19:20.42,0:19:22.82,Default,,0,0,0,,Біз байыпты сөйлесіп жатырмыз, бірақ қазір➡
Dialogue: 0,0:19:22.82,0:19:25.43,Default,,0,0,0,,Солай етсең... Қара, қара➡
Dialogue: 0,0:19:25.43,0:19:30.26,Default,,0,0,0,,Селика-чанды да көргіңіз келе ме? Жоқ, Нономи-сенпайға не болды?
Dialogue: 0,0:19:30.26,0:19:32.90,Default,,0,0,0,,Бұл бұлттар, солай ма? Киттен гөрі➡
Dialogue: 0,0:19:32.90,0:19:36.60,Default,,0,0,0,,Дельфинге ұқсамайды ма? Иә, солай деп ойлаймын?
Dialogue: 0,0:19:36.60,0:19:40.78,Default,,0,0,0,,Хошино-сенпайдың айтып отырғаны жоғарыда, солай емес пе?
Dialogue: 0,0:19:40.78,0:19:45.11,Default,,0,0,0,,Егер сіз осылай ойласаңыз, астындағы нәрсе дельфинге ұқсауы мүмкін.
Dialogue: 0,0:19:45.11,0:19:49.15,Default,,0,0,0,,Олай болса, одан әрі төменде медузаның несі бар?
Dialogue: 0,0:19:49.15,0:19:51.69,Default,,0,0,0,,Медуза осылай болды ма?
Dialogue: 0,0:19:51.69,0:19:54.92,Default,,0,0,0,,Мұндай түрлері болуы мүмкін.
Dialogue: 0,0:19:54.92,0:19:57.09,Default,,0,0,0,,Олай болса, бұл үлкен мәселе➡
Dialogue: 0,0:19:57.09,0:19:59.59,Default,,0,0,0,,Барлығымыз аквариумға барамыз ба?
Dialogue: 0,0:19:59.59,0:20:03.60,Default,,0,0,0,,Бірақ... Сіз қазір ештеңе білмейсіз ғой?
Dialogue: 0,0:20:03.60,0:20:06.73,Default,,0,0,0,,Уф... Жүзің мұңайып күтсең де➡
Dialogue: 0,0:20:06.73,0:20:09.77,Default,,0,0,0,,Нәтиже өзгермейді, солай ма?
Dialogue: 0,0:20:09.77,0:20:13.27,Default,,0,0,0,,Кем дегенде мен➡
Dialogue: 0,0:20:13.27,0:20:15.64,Default,,0,0,0,,Күткім келеді күлімдеп.
Dialogue: 0,0:20:19.78,0:20:21.92,Default,,0,0,0,,Және Селика-чан. Апыр-ай.
Dialogue: 0,0:20:21.92,0:20:25.32,Default,,0,0,0,,Егер сіз аквариумға барсаңыз, көптеген медузаларды көресіз.
Dialogue: 0,0:20:25.32,0:20:28.09,Default,,0,0,0,,Толқып тұрған қандай әдемі.
Dialogue: 0,0:20:28.09,0:20:30.93,Default,,0,0,0,,Ағаймен барайық. Сәл ғана жақсы.
Dialogue: 0,0:20:30.93,0:20:33.49,Default,,0,0,0,,Түсіндім! Сіз жай ғана баруыңыз керек!
Dialogue: 0,0:20:33.49,0:20:36.30,Default,,0,0,0,,Бір кезде жақсы болуы мүмкін.
Dialogue: 0,0:20:36.30,0:20:39.27,Default,,0,0,0,,Иә, үзіліс жасау да маңызды!
Dialogue: 0,0:20:39.27,0:20:41.77,Default,,0,0,0,,Мұғалім де барады, солай ма? иә?
Dialogue: 0,0:20:41.77,0:20:43.90,Default,,0,0,0,,«Не?» Келмеуді жоспарлап отырсыз ба?
Dialogue: 0,0:20:43.90,0:20:47.24,Default,,0,0,0,,Мұғалімнің сыныпқа жетекшілік етуі қажет деп ойлаймын.
Dialogue: 0,0:20:47.24,0:20:50.61,Default,,0,0,0,,Дұрыс. Жарайды, бәріміз кеттік!
Dialogue: 0,0:20:50.61,0:20:52.61,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:20:52.61,0:20:56.08,Default,,0,0,0,,Ухехе, асыға күтемін.
Dialogue: 0,0:22:29.08,0:22:47.06,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:22:50.40,0:22:54.10,Default,,0,0,0,,Аа...
Dialogue: 0,0:22:54.10,0:22:56.10,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,0:22:56.10,0:23:18.76,Default,,0,0,0,,♬～
Dialogue: 0,0:23:18.76,0:23:20.76,Default,,0,0,0,,Ах.
Dialogue: 0,0:23:29.60,0:23:31.61,Default,,0,0,0,,Уф….
Dialogue: 0,0:23:31.61,0:23:47.09,Default,,0,0,0,,♬～
