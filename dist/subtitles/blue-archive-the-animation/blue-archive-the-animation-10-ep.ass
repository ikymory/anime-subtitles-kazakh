Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.17,0:00:06.17,Default,,0,0,0,,Аа... Еңбегіңізге рахмет.
Dialogue: 0,0:00:06.17,0:00:09.14,Default,,0,0,0,,Иә? Мен біріншімін бе?
Dialogue: 0,0:00:11.44,0:00:13.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:15.48,0:00:17.98,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:17.98,0:00:19.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:19.98,0:00:22.28,Default,,0,0,0,,Өтірік... Аяна Чан, қайырлы таң...
Dialogue: 0,0:00:22.28,0:00:25.15,Default,,0,0,0,,Неге! ? Неге!
Dialogue: 0,0:02:09.09,0:02:12.43,Default,,0,0,0,,«Абыдос жұмыс тобының барлық мүшелеріне.
Dialogue: 0,0:02:12.43,0:02:14.53,Default,,0,0,0,,Ең алдымен мынаны орындаңыз...''
Dialogue: 0,0:02:14.53,0:02:17.00,Default,,0,0,0,,｟Хошино: Мен хат арқылы қоштасуды шештім➡
Dialogue: 0,0:02:17.00,0:02:19.77,Default,,0,0,0,,Мені кешіріңіз. Аға үшін➡
Dialogue: 0,0:02:19.77,0:02:23.11,Default,,0,0,0,,Бұл ескі әдіс маған жарасады.
Dialogue: 0,0:02:23.11,0:02:27.94,Default,,0,0,0,,Негізі, мен көптен бері барлау жүргіздім.
Dialogue: 0,0:02:27.94,0:02:31.45,Default,,0,0,0,,Кайзер ПМК сияқты сарбаз болып жұмыс жасаңыз.
Dialogue: 0,0:02:31.45,0:02:36.85,Default,,0,0,0,,Оның орнына Абыдос қарызының көп бөлігін мойнына алады.
Dialogue: 0,0:02:36.85,0:02:40.46,Default,,0,0,0,,Бұл оқиға. Ағай осылай көрінеді➡
Dialogue: 0,0:02:40.46,0:02:44.13,Default,,0,0,0,,Негізі менің қабілеттерім біршама сатып алынды.
Dialogue: 0,0:02:44.13,0:02:47.26,Default,,0,0,0,,Қара базарда жүргенде, кенеттен сыпайы әрекет етіңіз ➡
Dialogue: 0,0:02:47.26,0:02:50.80,Default,,0,0,0,,Мен бұл сөздерді айттым➡
Dialogue: 0,0:02:50.80,0:02:53.70,Default,,0,0,0,,Мен сені қорғай алмағаным үшін кешір.
Dialogue: 0,0:02:53.70,0:02:58.81,Default,,0,0,0,,Бірақ бұл жұмыс тобының жұмысын біршама жеңілдетуі керек.
Dialogue: 0,0:02:58.81,0:03:03.11,Default,,0,0,0,,Мұның бәрі менің жауапкершілігім.
Dialogue: 0,0:03:03.11,0:03:05.58,Default,,0,0,0,,Мен Абыдостанмын➡
Dialogue: 0,0:03:05.58,0:03:08.28,Default,,0,0,0,,Өйткені ол студенттік кеңестің соңғы мүшесі.
Dialogue: 0,0:03:08.28,0:03:10.25,Default,,0,0,0,,Мен осында қоштасамын｠
Dialogue: 0,0:03:14.79,0:03:16.79,Default,,0,0,0,,«Мұғалімге...».
Dialogue: 0,0:03:16.79,0:03:20.80,Default,,0,0,0,,｟Негізі мен үлкендерді жек көретінмін.
Dialogue: 0,0:03:20.80,0:03:24.30,Default,,0,0,0,,Широко-чан мұғалімін алып келген кездің өзінде➡
Dialogue: 0,0:03:24.30,0:03:28.60,Default,,0,0,0,,Мен өзімді жақсы емес ересек адам келгендей сезіндім.
Dialogue: 0,0:03:28.60,0:03:32.11,Default,,0,0,0,,Бірақ мұғалім барған сайын бәріне ашты➡
Dialogue: 0,0:03:32.11,0:03:35.54,Default,,0,0,0,,Бір-бірімізге сенетін дос болдық.
Dialogue: 0,0:03:35.54,0:03:39.65,Default,,0,0,0,,Олай болса қалғанын мұғалімге тапсырамын.
Dialogue: 0,0:03:39.65,0:03:42.15,Default,,0,0,0,,Барлығы сенетін ұстаз болсаңыз➡
Dialogue: 0,0:03:42.15,0:03:45.19,Default,,0,0,0,,Мен бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:03:45.19,0:03:48.22,Default,,0,0,0,,Ақыры сендей үлкенді кездестірдім➡
Dialogue: 0,0:03:48.22,0:03:50.63,Default,,0,0,0,,Мен... жоқ➡
Dialogue: 0,0:03:50.63,0:03:54.30,Default,,0,0,0,,Осындай әдепті сөздер жеткілікті.
Dialogue: 0,0:03:54.30,0:03:56.80,Default,,0,0,0,,Широко-чан Нономи-чан➡
Dialogue: 0,0:03:56.80,0:03:59.97,Default,,0,0,0,,Селика-чан Аяне-чан.
Dialogue: 0,0:03:59.97,0:04:04.87,Default,,0,0,0,,Өтінемін. Мектебімізді қорғағаныңызды қалаймын.
Dialogue: 0,0:04:04.87,0:04:07.38,Default,,0,0,0,,Құмға толы осындай жер➡
Dialogue: 0,0:04:07.38,0:04:12.31,Default,,0,0,0,,Өйткені ол мен үшін жалғыз мағыналы орын қалды.
Dialogue: 0,0:04:12.31,0:04:15.75,Default,,0,0,0,,Сонда мен болсам, болашақта бір жерде➡
Dialogue: 0,0:04:15.75,0:04:18.99,Default,,0,0,0,,Егер сіз кездейсоқ бір-біріңізге жау болып қалсаңыз➡
Dialogue: 0,0:04:18.99,0:04:22.39,Default,,0,0,0,,Сол кезде менің галом➡
Dialogue: 0,0:04:22.39,0:04:24.99,Default,,0,0,0,,Бұзыңыз. Танысқаныма қуаныштымын｠
Dialogue: 0,0:04:24.99,0:04:27.00,Default,,0,0,0,,(үстелді түрту дыбысы)
Dialogue: 0,0:04:27.00,0:04:29.83,Default,,0,0,0,,Не! ? Егер мен кептеліп қалсам, мен бәрін істеймін ➡
Dialogue: 0,0:04:29.83,0:04:31.80,Default,,0,0,0,,Өзім білсем де!
Dialogue: 0,0:04:31.80,0:04:34.47,Default,,0,0,0,,Бұны қабылдау мүмкін емес!
Dialogue: 0,0:04:34.47,0:04:37.64,Default,,0,0,0,,Уф... (Мұғалім) Широко!
Dialogue: 0,0:04:37.64,0:04:41.01,Default,,0,0,0,,Мен барамын. Мен бәрібір көмектесуім керек ...
Dialogue: 0,0:04:41.01,0:04:43.15,Default,,0,0,0,,Тынышталыңыз, Широко-чан!
Dialogue: 0,0:04:43.15,0:04:46.08,Default,,0,0,0,,Иә. Алдымен жағдайды тексеріңіз ...
Dialogue: 0,0:04:46.08,0:04:49.65,Default,,0,0,0,,Бірақ Хошино-сенпай... (ескерту)
Dialogue: 0,0:04:49.65,0:04:54.19,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:04:54.19,0:04:56.96,Default,,0,0,0,,Осы аймақты басқармайынша атуды жалғастырыңыз!
Dialogue: 0,0:04:56.96,0:05:03.37,Default,,0,0,0,,Хехехе... Студенттік кеңестің соңғы мүшесі Абыдос орта мектебінен шығарылды.
Dialogue: 0,0:05:03.37,0:05:07.14,Default,,0,0,0,,Енді біз, Kaiser Corporation➡
Dialogue: 0,0:05:07.14,0:05:10.31,Default,,0,0,0,,Абыдос орта мектебін қабыл алыңыз!
Dialogue: 0,0:05:10.31,0:05:13.48,Default,,0,0,0,,Кайзер ПМК-ның жүздеген сарбаздары алға жылжуда!
Dialogue: 0,0:05:13.48,0:05:15.98,Default,,0,0,0,,Қалалық жерлерге бейтарап шабуылдар!
Dialogue: 0,0:05:15.98,0:05:18.48,Default,,0,0,0,,Неліктен дәл осы уақытта? ?
Dialogue: 0,0:05:18.48,0:05:21.98,Default,,0,0,0,,Қарсыласпасақ... Бірақ Хошино-сенпай...
Dialogue: 0,0:05:21.98,0:05:25.95,Default,,0,0,0,,Барлығыңыз тынышталыңыздар! Азаматтарды эвакуациялау қазір басты міндет!
Dialogue: 0,0:05:34.06,0:05:36.30,Default,,0,0,0,,«Уф! Дау-дамай жұртты жинап қойды…»
Dialogue: 0,0:05:36.30,0:05:39.30,Default,,0,0,0,,Амансың ба? ? Әй, қалай болғанда да.
Dialogue: 0,0:05:39.30,0:05:41.67,Default,,0,0,0,,Жер бетінде кенеттен не болды?
Dialogue: 0,0:05:41.67,0:05:44.74,Default,,0,0,0,,Бізде әлі де жағдай бар...
Dialogue: 0,0:05:44.74,0:05:47.81,Default,,0,0,0,,Жоқ! Abydos жұмыс тобын тапты!
Dialogue: 0,0:05:47.81,0:05:51.65,Default,,0,0,0,,Осы жолмен! Широко-сенпай! Хмм.
Dialogue: 0,0:05:51.65,0:05:53.98,Default,,0,0,0,,Қалай болғанда да, қазір эвакуациялаңыз!
Dialogue: 0,0:05:53.98,0:05:55.98,Default,,0,0,0,,А, аа.
Dialogue: 0,0:05:58.05,0:06:00.16,Default,,0,0,0,,Уау! Гах!
Dialogue: 0,0:06:00.16,0:06:02.32,Default,,0,0,0,,Иә! Қарғыс атсын!
Dialogue: 0,0:06:02.32,0:06:04.66,Default,,0,0,0,,Широко-сенпай!
Dialogue: 0,0:06:04.66,0:06:06.83,Default,,0,0,0,,Ха! Мен оны түсіндім!
Dialogue: 0,0:06:06.83,0:06:09.33,Default,,0,0,0,,Уау! Сен не істеп жатырсың?
Dialogue: 0,0:06:09.33,0:06:11.50,Default,,0,0,0,,Қарғыс атсын! Арх!
Dialogue: 0,0:06:14.30,0:06:16.97,Default,,0,0,0,,Өтінемін! Иә.
Dialogue: 0,0:06:16.97,0:06:20.48,Default,,0,0,0,,Бәле! Олар керемет!
Dialogue: 0,0:06:20.48,0:06:23.98,Default,,0,0,0,,Әй, Нономи! иә!
Dialogue: 0,0:06:23.98,0:06:25.95,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:06:29.15,0:06:34.09,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:06:34.09,0:06:37.99,Default,,0,0,0,,Амансың ба? Хмм... қалай болғанда да.
Dialogue: 0,0:06:37.99,0:06:40.50,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:40.50,0:06:42.50,Default,,0,0,0,,Мұның соңы жоқ...
Dialogue: 0,0:06:46.43,0:06:49.44,Default,,0,0,0,,Сонда да біз оны қорғауымыз керек.
Dialogue: 0,0:06:51.81,0:06:56.81,Default,,0,0,0,,Мм. Мен мектепке барамын деп ойладым, бірақ...
Dialogue: 0,0:06:56.81,0:06:59.21,Default,,0,0,0,,...
Dialogue: 0,0:06:59.21,0:07:01.62,Default,,0,0,0,,Құрметті Абыдос орта мектебінің оқушылары.
Dialogue: 0,0:07:01.62,0:07:04.32,Default,,0,0,0,,Қалаға шабуыл жасаған компания...
Dialogue: 0,0:07:04.32,0:07:06.99,Default,,0,0,0,,Жердің иесі болсаң да➡
Dialogue: 0,0:07:06.99,0:07:10.63,Default,,0,0,0,,➡
Dialogue: 0,0:07:10.63,0:07:12.63,Default,,0,0,0,,Біз Абыдосқа тиесіліміз!
Dialogue: 0,0:07:12.63,0:07:15.33,Default,,0,0,0,,Мұндай шабуылдың заңсыз екені анық!
Dialogue: 0,0:07:15.33,0:07:18.30,Default,,0,0,0,,...
Dialogue: 0,0:07:18.30,0:07:21.97,Default,,0,0,0,,...
Dialogue: 0,0:07:21.97,0:07:25.14,Default,,0,0,0,,«Сороимо Соромо» дегенді қалай түсінесіңдер?
Dialogue: 0,0:07:25.14,0:07:28.01,Default,,0,0,0,,...
Dialogue: 0,0:07:28.01,0:07:31.05,Default,,0,0,0,,...
Dialogue: 0,0:07:31.05,0:07:33.15,Default,,0,0,0,,➡
Dialogue: 0,0:07:33.15,0:07:36.32,Default,,0,0,0,,Оның мүшкіл халін саған талай рет айттым.
Dialogue: 0,0:07:36.32,0:07:41.96,Default,,0,0,0,,Нәтижесінде қарыз мәселесі шешілді ме?
Dialogue: 0,0:07:41.96,0:07:44.13,Default,,0,0,0,,Сіз қазірге дейін түсінуіңіз керек еді.
Dialogue: 0,0:07:44.13,0:07:46.29,Default,,0,0,0,,Қалай күрессең де➡
Dialogue: 0,0:07:46.29,0:07:49.13,Default,,0,0,0,,...
Dialogue: 0,0:07:49.13,0:07:52.13,Default,,0,0,0,,Абыдостың соңғы студенттік кеңес мүшесі➡
Dialogue: 0,0:07:52.13,0:07:54.80,Default,,0,0,0,,...
Dialogue: 0,0:07:54.80,0:07:58.97,Default,,0,0,0,,Abydos студенттік кеңесі енді жоқ.
Dialogue: 0,0:07:58.97,0:08:02.81,Default,,0,0,0,,Сен енді ештеңе емессің.
Dialogue: 0,0:08:02.81,0:08:05.95,Default,,0,0,0,,➡
Dialogue: 0,0:08:05.95,0:08:08.12,Default,,0,0,0,,Абыдоста жұмыс тобы бар!
Dialogue: 0,0:08:08.12,0:08:10.62,Default,,0,0,0,,Егер біз әлі де осында болсақ, мұндай сылтаулар мүмкін болар еді...
Dialogue: 0,0:08:10.62,0:08:13.12,Default,,0,0,0,,Жұмыс тобы ресми рұқсат алды➡
Dialogue: 0,0:08:13.12,0:08:15.52,Default,,0,0,0,,Комитет емес. иә?
Dialogue: 0,0:08:15.52,0:08:18.29,Default,,0,0,0,,➡
Dialogue: 0,0:08:18.29,0:08:21.26,Default,,0,0,0,,Енді Абыдоста студенттер кеңесі болмады...
Dialogue: 0,0:08:21.26,0:08:24.20,Default,,0,0,0,,Не? Бұл дұрыс.
Dialogue: 0,0:08:24.20,0:08:26.27,Default,,0,0,0,,Бұл бейресми комитет.
Dialogue: 0,0:08:26.27,0:08:29.27,Default,,0,0,0,,Ешқандай ресми құжат бекітілмеген.
Dialogue: 0,0:08:29.27,0:08:34.14,Default,,0,0,0,,Басқаша айтқанда, сіздің бар екендігіңізді көрсететін ештеңе жоқ.
Dialogue: 0,0:08:34.14,0:08:37.61,Default,,0,0,0,,➡
Dialogue: 0,0:08:37.61,0:08:43.12,Default,,0,0,0,,Бәріңіз де сол қарыздан құтыласыз.
Dialogue: 0,0:08:43.12,0:08:47.46,Default,,0,0,0,,Егер мұндай жағдай орын алса, біздің күш-жігеріміз осы уақытқа дейін...
Dialogue: 0,0:08:47.46,0:08:50.83,Default,,0,0,0,,Жоқ, мен жүздеген жылдарды шындап өткіздім➡
Dialogue: 0,0:08:50.83,0:08:53.96,Default,,0,0,0,,Сіз қарызды өтеуді ойладыңыз ба?
Dialogue: 0,0:08:53.96,0:08:57.93,Default,,0,0,0,,「」➡
Dialogue: 0,0:08:57.93,0:09:02.30,Default,,0,0,0,,Соңында өзімді жұбату үшін сылтау айту деп ойладым.
Dialogue: 0,0:09:02.30,0:09:05.14,Default,,0,0,0,,➡
Dialogue: 0,0:09:05.14,0:09:08.44,Default,,0,0,0,,...
Dialogue: 0,0:09:08.44,0:09:11.11,Default,,0,0,0,,…
Dialogue: 0,0:09:11.11,0:09:13.11,Default,,0,0,0,,Түсіру.
Dialogue: 0,0:09:13.11,0:09:15.12,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:09:15.12,0:09:18.62,Default,,0,0,0,,Енді мұндағы шайқас ештеңені өзгерте ме?
Dialogue: 0,0:09:18.62,0:09:22.29,Default,,0,0,0,,➡
Dialogue: 0,0:09:22.29,0:09:24.96,Default,,0,0,0,,Осыдан кейін не істеуім керек?
Dialogue: 0,0:09:24.96,0:09:27.83,Default,,0,0,0,,Мектепті қайтарып алсам да➡
Dialogue: 0,0:09:27.83,0:09:31.30,Default,,0,0,0,,Бізде әлі орасан зор қарыз қалды.
Dialogue: 0,0:09:33.44,0:09:36.60,Default,,0,0,0,,Тіпті сатылған жерді қайтаруға болмайды.
Dialogue: 0,0:09:36.60,0:09:39.31,Default,,0,0,0,,Ең бастысы, Хошино-сенпай да жоқ.
Dialogue: 0,0:09:39.31,0:09:42.71,Default,,0,0,0,,Студенттік кеңес жоқ. Бұл жағдайда➡
Dialogue: 0,0:09:42.71,0:09:45.95,Default,,0,0,0,,Біз сияқты бейресми комитеттер➡
Dialogue: 0,0:09:45.95,0:09:48.65,Default,,0,0,0,,Тағы не...?
Dialogue: 0,0:09:51.82,0:09:55.12,Default,,0,0,0,,Аяне-чан... Неге... неге?➡
Dialogue: 0,0:09:55.12,0:09:57.63,Default,,0,0,0,,Тек біз осындаймыз...
Dialogue: 0,0:09:57.63,0:10:02.10,Default,,0,0,0,,Хошино-сенпай... Не істеуіміз керек...?
Dialogue: 0,0:10:02.10,0:10:04.13,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:10:04.13,0:10:06.57,Default,,0,0,0,,Ах! Солтүстікте➡
Dialogue: 0,0:10:06.57,0:10:09.64,Default,,0,0,0,,Үлкен жарылыс расталды! Браво взводының бізге қосылуы жоспарланған➡
Dialogue: 0,0:10:09.64,0:10:11.64,Default,,0,0,0,,Ұстап қалу... не! ?
Dialogue: 0,0:10:11.64,0:10:14.64,Default,,0,0,0,,Шығыста да тексеріңіз! Майк взводтары да➡
Dialogue: 0,0:10:14.64,0:10:17.18,Default,,0,0,0,,Үлкен көлемдегі С4 жарылуымен... Вау!
Dialogue: 0,0:10:17.18,0:10:20.65,Default,,0,0,0,,Қарғыс атсын... не болып жатыр! ?
Dialogue: 0,0:10:20.65,0:10:23.99,Default,,0,0,0,,Тыныш тыңдасаңыз➡
Dialogue: 0,0:10:23.99,0:10:26.55,Default,,0,0,0,,Сіз үнемі нені айтып жылайсыз?
Dialogue: 0,0:10:26.55,0:10:29.92,Default,,0,0,0,,Ах. Көзге көз, тіске тіс.
Dialogue: 0,0:10:29.92,0:10:35.83,Default,,0,0,0,,Қауіпсіз және жалғыз, Мен жындар патшалығын өз жолым сияқты басып өтемін.
Dialogue: 0,0:10:35.83,0:10:38.33,Default,,0,0,0,,Бұл сенсің, маскалы купальник командасы➡
Dialogue: 0,0:10:38.33,0:10:42.20,Default,,0,0,0,,Бұл сіздің ұраныңыз емес пе еді? Хехе.
Dialogue: 0,0:10:44.17,0:10:47.94,Default,,0,0,0,,Ой, балалар...
Dialogue: 0,0:10:47.94,0:10:51.31,Default,,0,0,0,,Мұндай аянышты тұлғаға сүйсінгенім есімде жоқ.
Dialogue: 0,0:10:51.31,0:10:55.12,Default,,0,0,0,,Ал, Аль-Чан, маған бұл туралы үзіліс беріңіз.
Dialogue: 0,0:10:55.12,0:10:59.09,Default,,0,0,0,,Көзілдірік киген қыздар сезімтал, сондықтан мұндай кездер болады.
Dialogue: 0,0:10:59.09,0:11:03.29,Default,,0,0,0,,Не, неге, балалар? Ахаха бәрібір➡
Dialogue: 0,0:11:03.29,0:11:06.66,Default,,0,0,0,,Көзілдірікті қызды жылату ауыр қылмыс емес пе?
Dialogue: 0,0:11:06.66,0:11:09.30,Default,,0,0,0,,Міне, осылай➡
Dialogue: 0,0:11:09.30,0:11:11.43,Default,,0,0,0,,Менің сені өлтіруден басқа амалым жоқ!
Dialogue: 0,0:11:11.43,0:11:13.80,Default,,0,0,0,,Бұл 68-ұстаз!
Dialogue: 0,0:11:13.80,0:11:16.80,Default,,0,0,0,,Қарғыс атсын! Не істеуім керек➡
Dialogue: 0,0:11:16.80,0:11:19.11,Default,,0,0,0,,Мен не істерімді де білмеймін.
Dialogue: 0,0:11:19.11,0:11:21.78,Default,,0,0,0,,Менің барлық істерім сәтсіздікпен аяқталады.
Dialogue: 0,0:11:21.78,0:11:23.78,Default,,0,0,0,,Осы жерден өткеннен кейін➡
Dialogue: 0,0:11:23.78,0:11:26.71,Default,,0,0,0,,Алда қиыншылық пен қиыншылықтан басқа ештеңе жоқ. (тікұшақ дыбысы)
Dialogue: 0,0:11:26.71,0:11:30.29,Default,,0,0,0,,Ах. Ха, келдің!
Dialogue: 0,0:11:30.29,0:11:32.69,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:11:38.36,0:11:40.33,Default,,0,0,0,,Эй. Декудың квиркі бар екен ғой?
Dialogue: 0,0:11:42.30,0:11:44.93,Default,,0,0,0,,Менің достарыма қауіп төніп тұрған шығар! ?
Dialogue: 0,0:11:44.93,0:11:48.14,Default,,0,0,0,,Дегенмен, мен тек ақымақ нәрселер туралы ойлаймын➡
Dialogue: 0,0:11:48.14,0:11:52.27,Default,,0,0,0,,Бәрі осылай алынып тасталса, мен оны түсінемін! ?
Dialogue: 0,0:11:52.27,0:11:55.61,Default,,0,0,0,,Балалар, сендер сондай аянышты топ болдыңдар! ?
Dialogue: 0,0:11:55.61,0:11:57.81,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:11:57.81,0:12:00.18,Default,,0,0,0,,Қарғыс атсын, қолөнерші!
Dialogue: 0,0:12:00.18,0:12:03.72,Default,,0,0,0,,Балалар, иттеріңе қамқор болыңдар!
Dialogue: 0,0:12:03.72,0:12:05.79,Default,,0,0,0,,Шулы. Бұл балалар жақсырақ➡
Dialogue: 0,0:12:05.79,0:12:08.96,Default,,0,0,0,,Бірге жұмыс істеу оңай болды. Бар болғаны!
Dialogue: 0,0:12:08.96,0:12:11.43,Default,,0,0,0,,Аа, жұмыс берушіге опасыздық жасаудан басқа ештеңе жоқ➡
Dialogue: 0,0:12:11.43,0:12:13.86,Default,,0,0,0,,Жаман адам үшін бұл табиғи нәрсе, солай емес пе?
Dialogue: 0,0:12:13.86,0:12:16.26,Default,,0,0,0,,Барлығы... Мен келісемін.
Dialogue: 0,0:12:16.26,0:12:18.77,Default,,0,0,0,,Бұл, әрине, зұлым адам ретінде дұрыс.
Dialogue: 0,0:12:18.77,0:12:20.94,Default,,0,0,0,,Сізге рахмет, мен ояндым.
Dialogue: 0,0:12:20.94,0:12:23.30,Default,,0,0,0,,Бізде адасып кетуге уақыт жоқ.
Dialogue: 0,0:12:23.30,0:12:26.64,Default,,0,0,0,,Иә! Бейресми екенін білмеймін➡
Dialogue: 0,0:12:26.64,0:12:29.64,Default,,0,0,0,,Бұл енді маңызды емес!
Dialogue: 0,0:12:29.64,0:12:32.11,Default,,0,0,0,,Хошино-сенпайға көмектес.
Dialogue: 0,0:12:32.11,0:12:34.55,Default,,0,0,0,,Қазір маңыздысы осы.
Dialogue: 0,0:12:34.55,0:12:37.45,Default,,0,0,0,,Бұл мағынасыз қарсылық кезеңі!
Dialogue: 0,0:12:37.45,0:12:41.46,Default,,0,0,0,,Жарайсың! (Мұғалім) Жарайсың асыл шәкіртім.
Dialogue: 0,0:12:41.46,0:12:44.86,Default,,0,0,0,,Хошино туралы Мен оны қайтарамын.
Dialogue: 0,0:12:44.86,0:12:48.30,Default,,0,0,0,,Өзіңізді алдамаңыз! Бұл ересектерге ұқсайтын көрініс!
Dialogue: 0,0:12:48.30,0:12:50.47,Default,,0,0,0,,Сіздің ондай құқығыңыз жоқ...
Dialogue: 0,0:12:55.80,0:12:58.77,Default,,0,0,0,,Қарғыс атсын! Егер бұл орын алса, оны қолданыңыз!
Dialogue: 0,0:12:58.77,0:13:01.64,Default,,0,0,0,,Бірақ бұл әлі реттелуде...
Dialogue: 0,0:13:01.64,0:13:04.65,Default,,0,0,0,,Қазір пайдалану өте қауіпті! Маған бәрі бір!
Dialogue: 0,0:13:04.65,0:13:08.12,Default,,0,0,0,,Егер бұл орын алса, сізге мұқият еске түсіруге рұқсат етіңіз!
Dialogue: 0,0:13:10.62,0:13:12.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:15.46,0:13:19.13,Default,,0,0,0,,Қараңдар! Біздің технологияның ең жақсысын жинау➡
Dialogue: 0,0:13:19.13,0:13:21.46,Default,,0,0,0,,Өте күшейтілген экзоскелет!
Dialogue: 0,0:13:21.46,0:13:26.13,Default,,0,0,0,,Ең жоғары тазалықтағы материалдардан жасалған сауыттармен және жетектермен жабдықталған➡
Dialogue: 0,0:13:26.13,0:13:29.44,Default,,0,0,0,,Соңғы қару!
Dialogue: 0,0:13:29.44,0:13:31.44,Default,,0,0,0,,Уау, бұл үлкен.
Dialogue: 0,0:13:31.44,0:13:33.78,Default,,0,0,0,,Біз не істеуіміз керек! ?
Dialogue: 0,0:13:33.78,0:13:36.31,Default,,0,0,0,,Бұл сәл қатал емес пе?
Dialogue: 0,0:13:36.31,0:13:38.61,Default,,0,0,0,,Бұл, әрине, қиын.
Dialogue: 0,0:13:38.61,0:13:42.28,Default,,0,0,0,,Әйтсе де, төртеуіміз ғана болса➡\NМен
Dialogue: 0,0:13:42.28,0:13:45.95,Default,,0,0,0,,туралы айтып отырмын.
Dialogue: 0,0:13:45.95,0:13:48.29,Default,,0,0,0,,Сәйкестік.
Dialogue: 0,0:13:48.29,0:13:50.86,Default,,0,0,0,,Сіз мұны істей аласыз, солай ма?
Dialogue: 0,0:13:50.86,0:13:53.36,Default,,0,0,0,,Хмм. Олай болса➡
Dialogue: 0,0:13:53.36,0:13:55.73,Default,,0,0,0,,Жақсы ату!
Dialogue: 0,0:14:00.94,0:14:04.51,Default,,0,0,0,,Қатты. Хмф, ол жұмыс істемейді!
Dialogue: 0,0:14:04.51,0:14:06.41,Default,,0,0,0,,(Оқушы) Қайырлы таң. (Оқушы) Қайырлы таң. Ой, күйіп кеткен екен!
Dialogue: 0,0:14:06.41,0:14:09.28,Default,,0,0,0,,Не деген сұмдық күш.
Dialogue: 0,0:14:09.28,0:14:12.11,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:14:12.11,0:14:14.95,Default,,0,0,0,,Тікелей соқса жаман болар еді.
Dialogue: 0,0:14:14.95,0:14:17.49,Default,,0,0,0,,Бір амал бар ма...
Dialogue: 0,0:14:17.49,0:14:21.76,Default,,0,0,0,,Қанша бомба қалды?
Dialogue: 0,0:14:21.76,0:14:24.46,Default,,0,0,0,,Жеңіске мүмкіндігім болса, мінемін.
Dialogue: 0,0:14:24.46,0:14:28.43,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:14:28.43,0:14:31.93,Default,,0,0,0,,Сіздің бәс тігуіңіз қаншалықты жаман болғаны маңызды емес.
Dialogue: 0,0:14:31.93,0:14:34.80,Default,,0,0,0,,Құқық бұзушы деген осы!
Dialogue: 0,0:14:34.80,0:14:38.47,Default,,0,0,0,,Қарғыс атсын! Қандай ақымақтық!
Dialogue: 0,0:14:38.47,0:14:40.74,Default,,0,0,0,,Қарғыс атсын! Бар!
Dialogue: 0,0:14:42.84,0:14:45.71,Default,,0,0,0,,Біз де барайық! Жақсы!
Dialogue: 0,0:14:51.62,0:14:54.62,Default,,0,0,0,,Ха, жасырын өтуге тырысу өте аңғал!
Dialogue: 0,0:14:54.62,0:14:56.79,Default,,0,0,0,,Сіз кедергісіз. Шығуыңызды өтінемін!
Dialogue: 0,0:14:56.79,0:14:58.79,Default,,0,0,0,,Уф! Апыр-ай! Хаха!
Dialogue: 0,0:14:58.79,0:15:01.66,Default,,0,0,0,,Арх! иә! рақмет сізге!
Dialogue: 0,0:15:01.66,0:15:03.97,Default,,0,0,0,,Жоқ, жоқ... у...
Dialogue: 0,0:15:03.97,0:15:06.83,Default,,0,0,0,,Жарайды, алға қара!
Dialogue: 0,0:15:06.83,0:15:09.87,Default,,0,0,0,,Иә! Шүкір, мен оны міндетті түрде тоқтатамын!
Dialogue: 0,0:15:09.87,0:15:11.94,Default,,0,0,0,,Ах! Біз не істеуіміз керек?
Dialogue: 0,0:15:11.94,0:15:15.98,Default,,0,0,0,,Дүкенді қиратуға шамасы жоқ... Куфуфуфуфуфу.
Dialogue: 0,0:15:15.98,0:15:18.11,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:15:18.11,0:15:22.28,Default,,0,0,0,,Бомба...? иә! Бірақ бәрібір!
Dialogue: 0,0:15:22.28,0:15:25.95,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:15:25.95,0:15:28.62,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:15:28.62,0:15:31.13,Default,,0,0,0,,Керемет! Бұл қызық!
Dialogue: 0,0:15:31.13,0:15:34.30,Default,,0,0,0,,Дұрыс? Қалғанын маған қалдыр.
Dialogue: 0,0:15:34.30,0:15:38.20,Default,,0,0,0,,Рахмет! Іске сәт!
Dialogue: 0,0:15:40.80,0:15:44.31,Default,,0,0,0,,Сәлем! Олар бас тартуға өте нашар!
Dialogue: 0,0:15:46.77,0:15:50.31,Default,,0,0,0,,Хамф!
Dialogue: 0,0:15:50.31,0:15:54.45,Default,,0,0,0,,Жақында болуы керек... Не ойлап жатқаныңызды білмеймін➡
Dialogue: 0,0:15:54.45,0:15:58.12,Default,,0,0,0,,Енді мұны аяқтаймыз ба?
Dialogue: 0,0:15:58.12,0:16:00.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:04.03,0:16:06.13,Default,,0,0,0,,Сіз сонда болдыңыз ба?
Dialogue: 0,0:16:06.13,0:16:08.80,Default,,0,0,0,,Селика-чан! иә!
Dialogue: 0,0:16:08.80,0:16:11.63,Default,,0,0,0,,Чит Чокомакато!
Dialogue: 0,0:16:11.63,0:16:14.80,Default,,0,0,0,,Су... хуу....
Dialogue: 0,0:16:14.80,0:16:17.97,Default,,0,0,0,,Су... хуу....
Dialogue: 0,0:16:17.97,0:16:22.34,Default,,0,0,0,,Су…. Менің ойымша, бұл өте қауіпті ...
Dialogue: 0,0:16:22.34,0:16:26.85,Default,,0,0,0,,Сонда да мен жай ғана қорғана алмаймын.
Dialogue: 0,0:16:32.62,0:16:34.99,Default,,0,0,0,,Барыңыз. Ха!
Dialogue: 0,0:16:34.99,0:16:37.49,Default,,0,0,0,,Абайлаңыз. Біз сізді қолдаймыз!
Dialogue: 0,0:16:40.76,0:16:44.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:44.27,0:16:47.44,Default,,0,0,0,,Сіздің қарсыласыңыз – мен.
Dialogue: 0,0:16:47.44,0:16:51.11,Default,,0,0,0,,Құрметті...
Dialogue: 0,0:16:51.11,0:16:53.77,Default,,0,0,0,,Басталған сияқты.
Dialogue: 0,0:16:53.77,0:16:58.28,Default,,0,0,0,,Ал, мұны да істейік, Харука-чан.
Dialogue: 0,0:16:58.28,0:17:00.45,Default,,0,0,0,,Иә. Мен жасаймын!
Dialogue: 0,0:17:04.19,0:17:06.69,Default,,0,0,0,,Муцуки мен Харука да жақсы ойнайтын сияқты.
Dialogue: 0,0:17:09.79,0:17:13.33,Default,,0,0,0,,Арх! Мен саған рұқсат бермеймін.
Dialogue: 0,0:17:13.33,0:17:16.93,Default,,0,0,0,,Сіз шынымен жолға түскіңіз келетін сияқты➡
Dialogue: 0,0:17:16.93,0:17:21.14,Default,,0,0,0,,Өтінемін, мұндай ыңғайсыз істерді доғара аласыз ба?
Dialogue: 0,0:17:23.77,0:17:27.44,Default,,0,0,0,,егеуқұйрық! Біраз қозғалыңыз!
Dialogue: 0,0:17:27.44,0:17:29.94,Default,,0,0,0,,Сізге бар болғаны тесікте қалу керек!
Dialogue: 0,0:17:35.85,0:17:39.55,Default,,0,0,0,,Қарғыс атсын... анау тітіркендіргіш жігіттер!
Dialogue: 0,0:17:42.76,0:17:45.59,Default,,0,0,0,,Кя! Апыр-ай!
Dialogue: 0,0:17:45.59,0:17:47.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:47.66,0:17:59.61,Default,,0,0,0,,♬～
Dialogue: 0,0:17:59.61,0:18:02.61,Default,,0,0,0,,Бұл соңғы қару ма?
Dialogue: 0,0:18:02.61,0:18:05.75,Default,,0,0,0,,Хе... Мен қалжыңдап тұрмын!
Dialogue: 0,0:18:05.75,0:18:07.95,Default,,0,0,0,,Сіз бәрін тастадым деп ойладыңыз ба?
Dialogue: 0,0:18:07.95,0:18:10.59,Default,,0,0,0,,Сіздікіндей денемен➡
Dialogue: 0,0:18:10.59,0:18:14.09,Default,,0,0,0,,Бұл 12860 ат күші бар ұшақ ➡
Dialogue: 0,0:18:14.09,0:18:16.56,Default,,0,0,0,,Тоқтату мүмкін емес!
Dialogue: 0,0:18:16.56,0:18:19.43,Default,,0,0,0,,《Міне, басталды!》
Dialogue: 0,0:18:19.43,0:18:21.43,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:21.43,0:18:24.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:24.30,0:18:26.43,Default,,0,0,0,,Операция сәтті аяқталды!
Dialogue: 0,0:18:26.43,0:18:28.44,Default,,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:18:30.44,0:18:32.71,Default,,0,0,0,,Ха... Широко! Ха….
Dialogue: 0,0:18:37.61,0:18:41.58,Default,,0,0,0,,Ааа... Бұл соққыны көріп, сонда да қашуға тырыспағаныңа сене алар емеспін➡
Dialogue: 0,0:18:41.58,0:18:44.75,Default,,0,0,0,,Жақсы батылдық!
Dialogue: 0,0:18:44.75,0:18:47.25,Default,,0,0,0,,Мақтаса да риза емеспін.
Dialogue: 0,0:18:47.25,0:18:50.73,Default,,0,0,0,,Маған тек ми керек болды.
Dialogue: 0,0:18:50.73,0:18:53.76,Default,,0,0,0,,Ең болмағанда әлгі Хошино жігіті ұнайды!
Dialogue: 0,0:18:53.76,0:18:57.20,Default,,0,0,0,,Неге бас тартпайсың!
Dialogue: 0,0:18:57.20,0:18:59.53,Default,,0,0,0,,Жоқ! 📱(Мұғалім) Широко➡
Dialogue: 0,0:18:59.53,0:19:01.44,Default,,0,0,0,,5 метр қалды!
Dialogue: 0,0:19:01.44,0:19:03.74,Default,,0,0,0,,Қайда қарап тұрсың?
Dialogue: 0,0:19:06.44,0:19:09.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:09.11,0:19:11.91,Default,,0,0,0,,Міне!
Dialogue: 0,0:19:14.08,0:19:17.59,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:19:17.59,0:19:20.42,Default,,0,0,0,,Қарғыс атсын... Сенсей!
Dialogue: 0,0:19:20.42,0:19:23.22,Default,,0,0,0,,Уф! Широко!
Dialogue: 0,0:19:30.10,0:19:32.77,Default,,0,0,0,,Хошино Сенпай➡
Dialogue: 0,0:19:32.77,0:19:35.94,Default,,0,0,0,,Авангард болу қиын.
Dialogue: 0,0:19:41.24,0:19:43.28,Default,,0,0,0,,Не! ?
Dialogue: 0,0:19:43.28,0:19:47.48,Default,,0,0,0,,Өте ақымақ!
Dialogue: 0,0:19:47.48,0:19:50.65,Default,,0,0,0,,Эй. Декудың квиркі бар екен ғой?
Dialogue: 0,0:19:54.46,0:19:56.76,Default,,0,0,0,,Широко-чан! Сенімен бәрі жақсы ма! ?
Dialogue: 0,0:19:56.76,0:20:01.96,Default,,0,0,0,,Хмм... проблема жоқ. Жақсы өткеніне қуаныштымын.
Dialogue: 0,0:20:01.96,0:20:03.96,Default,,0,0,0,,Рахмет Аяна.
Dialogue: 0,0:20:03.96,0:20:07.44,Default,,0,0,0,,Нономи мен Селика да.
Dialogue: 0,0:20:07.44,0:20:09.60,Default,,0,0,0,,Жоспарланғандай... Дегенмен➡
Dialogue: 0,0:20:09.60,0:20:11.61,Default,,0,0,0,,Сіз қауіпті нәрсе істеп жатырсыз.
Dialogue: 0,0:20:11.61,0:20:13.77,Default,,0,0,0,,Жарайды, мен соншалықты көп істеймін деп ойладым.
Dialogue: 0,0:20:13.77,0:20:16.24,Default,,0,0,0,,Сол балалар.
Dialogue: 0,0:20:16.24,0:20:18.91,Default,,0,0,0,,Директор! Сіз амансыз деп үміттенемін! ?
Dialogue: 0,0:20:18.91,0:20:21.58,Default,,0,0,0,,Ug…. Дереу емделіңіз!
Dialogue: 0,0:20:21.58,0:20:24.09,Default,,0,0,0,,Неге қазір бас тартпайсың? ?
Dialogue: 0,0:20:24.09,0:20:26.75,Default,,0,0,0,,Бірақ бәрібір...
Dialogue: 0,0:20:26.75,0:20:28.92,Default,,0,0,0,,Не? Сіз мұны әлі де жасайсыз ба?
Dialogue: 0,0:20:28.92,0:20:32.43,Default,,0,0,0,,Куфуфуфу Жалғастырсаң, мен сенімен шығамын, жарай ма?
Dialogue: 0,0:20:32.43,0:20:35.46,Default,,0,0,0,,Қарғыс атсын... Шегін!
Dialogue: 0,0:20:35.46,0:20:38.33,Default,,0,0,0,,Әскеріңізді қайта құруды бастаңыз! Ха, иә!
Dialogue: 0,0:20:38.33,0:20:41.37,Default,,0,0,0,,Шегінуге бұйрық! Директор шегінуге бұйрық береді!
Dialogue: 0,0:20:41.37,0:20:44.57,Default,,0,0,0,,Қайталау. Директор бізге шегінуді бұйырды!
Dialogue: 0,0:20:44.57,0:20:50.08,Default,,0,0,0,,Есте сақта. Бұл жоғары бағамен келеді.
Dialogue: 0,0:20:50.08,0:20:53.08,Default,,0,0,0,,Жау әскерлері шегінеді.
Dialogue: 0,0:20:53.08,0:20:57.12,Default,,0,0,0,,Аа... О, аяқталды.
Dialogue: 0,0:20:57.12,0:20:59.92,Default,,0,0,0,,Жоқ, «есте сақта~» сөздері➡
Dialogue: 0,0:20:59.92,0:21:02.59,Default,,0,0,0,,Мен мұны бірінші рет естіп тұрмын.
Dialogue: 0,0:21:02.59,0:21:04.93,Default,,0,0,0,,Барлығыңызға жақсы жұмыс.
Dialogue: 0,0:21:04.93,0:21:06.96,Default,,0,0,0,,Сол бұрыштық жағдайдан➡
Dialogue: 0,0:21:06.96,0:21:10.10,Default,,0,0,0,,Бұл мені шынымен шабыттандырды. Хмм.
Dialogue: 0,0:21:10.10,0:21:13.27,Default,,0,0,0,,Қауіпті жағдайда маған барлық шеберлер де көмектесті➡
Dialogue: 0,0:21:13.27,0:21:15.90,Default,,0,0,0,,Сізге көп рахмет. Осыншама➡
Dialogue: 0,0:21:15.90,0:21:19.11,Default,,0,0,0,,Бұл үлкен мәселе емес. Не айтсаң да➡
Dialogue: 0,0:21:19.11,0:21:22.74,Default,,0,0,0,,Ол бірінші дәрежелі заңсыз. Аль-Чан басынан бастап керемет болды➡
Dialogue: 0,0:21:22.74,0:21:27.62,Default,,0,0,0,,Сізде рух болған шығар! Бұлай айтудың қажеті жоқ!
Dialogue: 0,0:21:27.62,0:21:29.58,Default,,0,0,0,,Енді, келесі...
Dialogue: 0,0:21:32.92,0:21:35.69,Default,,0,0,0,,《Күт, Хошино-сенпай》
Dialogue: 0,0:21:41.30,0:21:43.90,Default,,0,0,0,,Неліктен...?
Dialogue: 0,0:21:43.90,0:21:45.93,Default,,0,0,0,,Неге Абыдос! ? (Қара киім) Неге?➡
Dialogue: 0,0:21:45.93,0:21:48.77,Default,,0,0,0,,Солай десең де... Бұл жерде оғаш ештеңе жоқ➡
Dialogue: 0,0:21:48.77,0:21:51.74,Default,,0,0,0,,Жоқ. Бұл қарыздың көп бөлігі➡
Dialogue: 0,0:21:51.74,0:21:55.18,Default,,0,0,0,,Мен саған лайықты түрде өтемін.
Dialogue: 0,0:21:55.18,0:22:00.92,Default,,0,0,0,,Бұл біздің арамызда берілген уәде.
Dialogue: 0,0:22:00.92,0:22:04.82,Default,,0,0,0,,Айтпақшы, сіздің шығарылуыңызбен➡
Dialogue: 0,0:22:04.82,0:22:08.26,Default,,0,0,0,,Енді Абыдос орта мектебінің оқушылар кеңесінің бірде-бір мүшесі жоқ.
Dialogue: 0,0:22:08.26,0:22:11.09,Default,,0,0,0,,Мектеп бұлай жұмыс істей алмайды.
Dialogue: 0,0:22:11.09,0:22:14.60,Default,,0,0,0,,Қарғыс атсын... Абыдоста жағдай ➡
Dialogue: 0,0:22:14.60,0:22:17.93,Default,,0,0,0,,Бұл жай ғана жанама көрініс.
Dialogue: 0,0:22:17.93,0:22:22.60,Default,,0,0,0,,Хошино мырза, біздің мақсатымыз әу бастан сіз болдыңыз.
Dialogue: 0,0:22:25.57,0:22:27.94,Default,,0,0,0,,Келісімшартқа қол қою➡
Dialogue: 0,0:22:27.94,0:22:32.08,Default,,0,0,0,,Сізге қатысты барлық құқықтарды алыңыз.
Dialogue: 0,0:22:32.08,0:22:36.78,Default,,0,0,0,,Осы мақсатта ол Kaiser корпорациясымен ынтымақтасады.
Dialogue: 0,0:22:36.78,0:22:40.12,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:22:40.12,0:22:42.96,Default,,0,0,0,,Егер түсінбеушілік тудырған болса, кешірім сұраңыз.
Dialogue: 0,0:22:42.96,0:22:45.33,Default,,0,0,0,,Бірақ мен басынан бастадым➡
Dialogue: 0,0:22:45.33,0:22:48.90,Default,,0,0,0,,Мен ол ақымақ компанияға тиесілі емеспін.
Dialogue: 0,0:22:48.90,0:22:51.63,Default,,0,0,0,,Сіз сияқты Кивотостың ең үлкен құпиясы➡
Dialogue: 0,0:22:51.63,0:22:55.30,Default,,0,0,0,,Сіз оны алсаңыз да, оны солдат ретінде пайдаланасыз➡
Dialogue: 0,0:22:55.30,0:22:57.97,Default,,0,0,0,,Мен ондай ысырап қылмаймын.
Dialogue: 0,0:23:01.94,0:23:04.61,Default,,0,0,0,,Бұл қызықты эксперименттің өзі➡
Dialogue: 0,0:23:04.61,0:23:08.82,Default,,0,0,0,,Біз нені аңсадық.
Dialogue: 0,0:23:08.82,0:23:11.19,Default,,0,0,0,,Оның мағынасы осы.
Dialogue: 0,0:23:13.45,0:23:16.36,Default,,0,0,0,,《Мен түсінемін. Мен➡
Dialogue: 0,0:23:16.36,0:23:19.46,Default,,0,0,0,,Мені тағы да үлкен кісі алдап кетті.
Dialogue: 0,0:23:19.46,0:23:25.50,Default,,0,0,0,,Барлығын кешіріңіз. Бәріне менің кінәм...
Dialogue: 0,0:23:25.50,0:23:28.27,Default,,0,0,0,,Широко-чан Нономи-чан➡
Dialogue: 0,0:23:28.27,0:23:32.91,Default,,0,0,0,,Селика-чан Аяне-чан Мұғалім...》
Dialogue: 0,0:23:32.91,0:23:36.11,Default,,0,0,0,,Юме-сенпай, кешіріңіз...
Dialogue: 0,0:23:37.61,0:23:43.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
