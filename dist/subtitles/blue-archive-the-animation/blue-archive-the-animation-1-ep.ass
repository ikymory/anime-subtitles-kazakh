Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.47,0:00:10.17,Default,,0,0,0,,Бұл менің қателігім болды.
Dialogue: 0,0:00:10.17,0:00:14.31,Default,,0,0,0,,Менің таңдауым және менің шақыруым➡
Dialogue: 0,0:00:14.31,0:00:16.28,Default,,0,0,0,,Бұл барлық жағдайлар.
Dialogue: 0,0:00:20.75,0:00:24.95,Default,,0,0,0,,Соңында мен бұл нәтижеге бірінші рет келдім➡
Dialogue: 0,0:00:24.95,0:00:28.16,Default,,0,0,0,,Сіз дұрыс болғаныңызды түсінесіз...
Dialogue: 0,0:00:42.50,0:00:47.64,Default,,0,0,0,,Біз не үшін жауапты екенімізді айттық.
Dialogue: 0,0:00:47.64,0:00:50.61,Default,,0,0,0,,Мен оны сол кезде түсінбедім➡
Dialogue: 0,0:00:50.61,0:00:53.45,Default,,0,0,0,,Енді түсіндім.
Dialogue: 0,0:00:53.45,0:00:57.09,Default,,0,0,0,,Маңыздысы тәжірибе емес, таңдау.
Dialogue: 0,0:00:57.09,0:01:00.96,Default,,0,0,0,,Тек сіз жасай алатын көптеген таңдаулар.
Dialogue: 0,0:01:00.96,0:01:04.29,Default,,0,0,0,,Ересек адам ретіндегі жауапкершілік пен міндеттер.
Dialogue: 0,0:01:04.29,0:01:08.16,Default,,0,0,0,,Егер сіз ересек болсаңыз, мен сене аламын➡
Dialogue: 0,0:01:08.16,0:01:10.97,Default,,0,0,0,,Бұл бұрмалау мен бұрмалаудан кейінгі соңғы баратын жер қандай?
Dialogue: 0,0:01:10.97,0:01:13.60,Default,,0,0,0,,Тағы бір нәтиже...
Dialogue: 0,0:01:13.60,0:01:18.61,Default,,0,0,0,,Сізді сол жерге апаратын нұсқаны табасыз.
Dialogue: 0,0:01:18.61,0:01:20.78,Default,,0,0,0,,Сонымен, мұғалім➡
Dialogue: 0,0:01:20.78,0:01:22.81,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:01:22.81,0:01:34.19,Default,,0,0,0,,♬～
Dialogue: 0,0:01:49.10,0:02:00.62,Default,,0,0,0,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,0:02:04.25,0:02:06.22,Default,,0,0,0,,Хмм….
Dialogue: 0,0:02:19.30,0:02:21.37,Default,,0,0,0,,Бұл жақсы сезінеді.
Dialogue: 0,0:02:21.37,0:02:57.51,Default,,0,0,0,,♬～
Dialogue: 0,0:02:57.51,0:03:02.24,Default,,0,0,0,,📺Федерация Студенттік Кеңесі төрағасының кенет жоғалып кетуіне байланысты Федерация Студенттік кеңесі әбігерге түсті➡
Dialogue: 0,0:03:02.24,0:03:04.75,Default,,0,0,0,,Санктум мұнарасының шамдары қайта жанды, үкімет те ➡
Dialogue: 0,0:03:04.75,0:03:07.35,Default,,0,0,0,,Қайта ашылып жатыр дейді.
Dialogue: 0,0:03:07.35,0:03:10.45,Default,,0,0,0,,📺Енді Кивотос академиялық қаласында хаос болады➡
Dialogue: 0,0:03:10.45,0:03:13.12,Default,,0,0,0,,Жағдай бірте-бірте басылатын сияқты.
Dialogue: 0,0:03:13.12,0:03:18.69,Default,,0,0,0,,♬ (мырылдау)
Dialogue: 0,0:03:25.40,0:03:27.57,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:03:27.57,0:03:29.74,Default,,0,0,0,,Мияу.
Dialogue: 0,0:03:29.74,0:03:32.07,Default,,0,0,0,,Мияу.
Dialogue: 0,0:03:32.07,0:03:35.11,Default,,0,0,0,,Мияу мияу.
Dialogue: 0,0:03:37.15,0:03:40.72,Default,,0,0,0,,🔊Келесі Абыдос орта мектебінің алдында. Ах.
Dialogue: 0,0:03:40.72,0:03:43.62,Default,,0,0,0,,Енді түсейік!
Dialogue: 0,0:04:00.24,0:04:03.07,Default,,0,0,0,,Широко-сенпай: Бұл рас! ?
Dialogue: 0,0:04:03.07,0:04:05.24,Default,,0,0,0,,Хмм…. Абыдос өнеркәсіп аймағына➡
Dialogue: 0,0:04:05.24,0:04:07.24,Default,,0,0,0,,Велосипедпен жүру және қайту➡
Dialogue: 0,0:04:07.24,0:04:10.41,Default,,0,0,0,,Оның ұзындығы жүздеген шақырым. Қайсысы туралы айтатын болсақ➡
Dialogue: 0,0:04:10.41,0:04:13.05,Default,,0,0,0,,Мен оны ешқашан дұрыс көрмеген шығармын.
Dialogue: 0,0:04:13.05,0:04:15.55,Default,,0,0,0,,Бұл жай ғана ыңғайлы қашықтықта болды.
Dialogue: 0,0:04:15.55,0:04:19.05,Default,,0,0,0,,А... Расымен де, Широко-сенпай...
Dialogue: 0,0:04:19.05,0:04:21.72,Default,,0,0,0,,Селика демалыс күні не істеді? Ха! ?
Dialogue: 0,0:04:21.72,0:04:25.89,Default,,0,0,0,,Мен... Кітапханада кітап оқып отырдым...
Dialogue: 0,0:04:25.89,0:04:28.73,Default,,0,0,0,,Селика-чан да сонда болды ма? Ха!
Dialogue: 0,0:04:28.73,0:04:31.27,Default,,0,0,0,,Мен де кеше кітапханада болдым.
Dialogue: 0,0:04:31.27,0:04:34.57,Default,,0,0,0,,Дұрыс! ? Мен оны байқамадым.
Dialogue: 0,0:04:34.57,0:04:37.27,Default,,0,0,0,,Айтпақшы, Аяне не оқыды?
Dialogue: 0,0:04:37.27,0:04:40.64,Default,,0,0,0,,Мен мұны кеше мектеп ғимаратын жөндеу кезінде тауып алдым➡
Dialogue: 0,0:04:40.64,0:04:43.91,Default,,0,0,0,,Мен DOHC-ті қарауым керек деп ойлаймын.
Dialogue: 0,0:04:43.91,0:04:48.32,Default,,0,0,0,,Ах, DOHC дегеніміз не? Үстіңгі қос камера➡
Dialogue: 0,0:04:48.32,0:04:50.92,Default,,0,0,0,,Бұл қозғалтқыш туралы, бірақ болашақта болуы мүмкін➡
Dialogue: 0,0:04:50.92,0:04:53.92,Default,,0,0,0,,Менің ойымша, бұл бірдеңе үшін пайдалы болуы мүмкін... Аа...
Dialogue: 0,0:04:53.92,0:04:56.42,Default,,0,0,0,,Ым, Хошино-сенпай ше?
Dialogue: 0,0:04:56.42,0:04:58.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:58.76,0:05:02.43,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,0:05:02.43,0:05:05.60,Default,,0,0,0,,Әрине, қарт кәдімгідей.
Dialogue: 0,0:05:05.60,0:05:08.97,Default,,0,0,0,,Дұрыс. Фуфуфу... Барлығына➡
Dialogue: 0,0:05:08.97,0:05:12.07,Default,,0,0,0,,Демалыс күндеріңіз көңілді өткен сияқты.
Dialogue: 0,0:05:12.07,0:05:15.58,Default,,0,0,0,,Бүргелердің бұл түрлері туралы не деуге болады? Мен бе?
Dialogue: 0,0:05:15.58,0:05:19.11,Default,,0,0,0,,Мен шоппинг жасап жатырмын.
Dialogue: 0,0:05:19.11,0:05:22.68,Default,,0,0,0,,Тәттілер сияқты жаңа өнімдер➡
Dialogue: 0,0:05:22.68,0:05:26.59,Default,,0,0,0,,Жетіспейтін тұрмыстық заттар➡
Dialogue: 0,0:05:26.59,0:05:30.29,Default,,0,0,0,,Мен де 40 шақты гантель сатып алдым.
Dialogue: 0,0:05:30.29,0:05:32.76,Default,,0,0,0,,Аа... Жарайды онда➡
Dialogue: 0,0:05:32.76,0:05:35.20,Default,,0,0,0,,Кезекті жиналысты бастайық па?
Dialogue: 0,0:05:35.20,0:05:38.73,Default,,0,0,0,,Алдымен соңғы кездегі маңызды оқиғаларға тоқталайық.
Dialogue: 0,0:05:38.73,0:05:43.84,Default,,0,0,0,,Кивотос – әртүрлі мектептер жиналатын академиялық қала.
Dialogue: 0,0:05:43.84,0:05:47.11,Default,,0,0,0,,Осы мектепке жататын әрбір мектептің тепе-теңдігін сақтайтын нәрсе –➡
Dialogue: 0,0:05:47.11,0:05:50.98,Default,,0,0,0,,Федерация Студенттік Кеңесінің төрағасы басқаратын Федералдық студенттік кеңес.
Dialogue: 0,0:05:50.98,0:05:53.72,Default,,0,0,0,,Бірақ Федерация Студенттік Кеңесінің төрағасы➡
Dialogue: 0,0:05:53.72,0:05:56.92,Default,,0,0,0,,Ол өткен күннен бері жоғалып кеткен сияқты.
Dialogue: 0,0:05:56.92,0:06:00.06,Default,,0,0,0,,Әртүрлі мектеп автономиялық округтерінде шатасушылық орын алуда➡
Dialogue: 0,0:06:00.06,0:06:02.06,Default,,0,0,0,,Бұл себеп болуы мүмкін.
Dialogue: 0,0:06:04.73,0:06:08.93,Default,,0,0,0,,Федерация Студенттік Кеңесі туралы айтқанда, сіз не айттыңыз...?
Dialogue: 0,0:06:08.93,0:06:12.90,Default,,0,0,0,,Trinity General Academy және Gehenna Academy арасында байланысқан➡
Dialogue: 0,0:06:12.90,0:06:15.90,Default,,0,0,0,,Шабуыл жасамау шарты…. Едем келісімі?
Dialogue: 0,0:06:15.90,0:06:18.07,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:06:18.07,0:06:20.78,Default,,0,0,0,,Бұл әлі де бар ма?
Dialogue: 0,0:06:20.78,0:06:23.25,Default,,0,0,0,,Бұл идея Федералды студенттік кеңестің президенті➡ болды
Dialogue: 0,0:06:23.25,0:06:27.92,Default,,0,0,0,,Ол жоғалғандықтан, оның не боларын білмейміз.
Dialogue: 0,0:06:27.92,0:06:32.59,Default,,0,0,0,,Солай ма? Ойланып қарашы, эй Айане-чан➡
Dialogue: 0,0:06:32.59,0:06:35.59,Default,,0,0,0,,Катака дулыға бандысы маңайда қайтадан шабуылдауда➡
Dialogue: 0,0:06:35.59,0:06:38.23,Default,,0,0,0,,Бұл туралы Шисеки Раменнің иесі айтты.
Dialogue: 0,0:06:38.23,0:06:41.40,Default,,0,0,0,,Бұл рамен дәмді. иә?
Dialogue: 0,0:06:41.40,0:06:45.07,Default,,0,0,0,,Широко-сенпай: Сен ол жаққа жиі барасың ба? кейде.
Dialogue: 0,0:06:45.07,0:06:47.90,Default,,0,0,0,,Не болды? Онша емес.
Dialogue: 0,0:06:47.90,0:06:53.01,Default,,0,0,0,,Соған қарамастан, Абыдоста қауіпсіздік жағдайы нашарлап барады.
Dialogue: 0,0:06:53.01,0:06:57.01,Default,,0,0,0,,Мен қиындыққа тап болдым. Федералдық студенттік кеңес үшін➡
Dialogue: 0,0:06:57.01,0:07:00.92,Default,,0,0,0,,Мен саған талай рет біздің қиын жағдайымызды айттым...
Dialogue: 0,0:07:00.92,0:07:05.42,Default,,0,0,0,,Федерация Студенттік Кеңесінің президенті де жоқ, сондықтан оларда мұндай сән-салтанат жоқ шығар.
Dialogue: 0,0:07:05.42,0:07:08.76,Default,,0,0,0,,Ха... Жарайды, қолымнан келмейді➡
Dialogue: 0,0:07:08.76,0:07:11.59,Default,,0,0,0,,Мен де.
Dialogue: 0,0:07:11.59,0:07:15.76,Default,,0,0,0,,Kaiser Loan-мен бизнес жүргізгеніңіз үшін рахмет.
Dialogue: 0,0:07:15.76,0:07:20.90,Default,,0,0,0,,Бұл мөлшерлеме бойынша ол өтелгенше 309 жыл 2 ай болады.
Dialogue: 0,0:07:20.90,0:07:24.91,Default,,0,0,0,,Келесі айда кездесеміз.
Dialogue: 0,0:07:24.91,0:07:29.61,Default,,0,0,0,,Қарызды өтеуге 309 жыл 2 ай қалды...
Dialogue: 0,0:07:29.61,0:07:33.38,Default,,0,0,0,,А... Бұл ұзақ жол.
Dialogue: 0,0:07:35.78,0:07:39.45,Default,,0,0,0,,Ертең кездескенше. Тағы да иә. Қош бол.
Dialogue: 0,0:08:07.12,0:08:09.78,Default,,0,0,0,,Аа...
Dialogue: 0,0:08:09.78,0:08:11.79,Default,,0,0,0,,Хмм….
Dialogue: 0,0:08:34.94,0:08:37.15,Default,,0,0,0,,Біраз уақыт қажет болды.
Dialogue: 0,0:08:43.05,0:08:46.59,Default,,0,0,0,,Эй, сен мені қате естідің, солай ма?
Dialogue: 0,0:08:46.59,0:08:48.96,Default,,0,0,0,,Қаскөй қыздар.
Dialogue: 0,0:08:48.96,0:08:51.56,Default,,0,0,0,,Сіз кездейсоқ «дасе» деп айттыңыз ба?➡
Dialogue: 0,0:08:51.56,0:08:55.03,Default,,0,0,0,,Әй, мына регент!
Dialogue: 0,0:08:55.03,0:08:58.43,Default,,0,0,0,,Банчо Керемет! Банчо: Мен ессіз қалдым!
Dialogue: 0,0:08:58.43,0:09:01.94,Default,,0,0,0,,Хаха! Дұрыс, мен оны білдім! ...Міне бітті.
Dialogue: 0,0:09:01.94,0:09:04.81,Default,,0,0,0,,An! ? ''Daseemon'' ➡ деңіз
Dialogue: 0,0:09:04.81,0:09:07.84,Default,,0,0,0,,Не болды? Ах! ?
Dialogue: 0,0:09:07.84,0:09:11.08,Default,,0,0,0,,Қарғыс атсын! Сіз тағы айттыңыз.
Dialogue: 0,0:09:11.08,0:09:13.88,Default,,0,0,0,,Теме және т.б., жасаңыз! (Ағайындар) Еркек!
Dialogue: 0,0:09:16.75,0:09:20.92,Default,,0,0,0,,Хахахаха... енді аузым бітті...
Dialogue: 0,0:09:20.92,0:09:24.29,Default,,0,0,0,,Сәлем! Теменің және басқалардың ақымақ оқтарымен...
Dialogue: 0,0:09:24.29,0:09:28.66,Default,,0,0,0,,Бұл біз…. Олардың мұны істеуге мүмкіндігі жоқ!
Dialogue: 0,0:09:32.10,0:09:36.07,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:09:44.61,0:09:46.58,Default,,0,0,0,,Ах.
Dialogue: 0,0:09:58.89,0:10:02.53,Default,,0,0,0,,Ух... Әй, ол тірі еді.
Dialogue: 0,0:10:02.53,0:10:05.53,Default,,0,0,0,,Күнге күйесің бе? Уф….
Dialogue: 0,0:10:05.53,0:10:08.87,Default,,0,0,0,,Құлап қалдыңыз ба? Уф...
Dialogue: 0,0:10:08.87,0:10:11.07,Default,,0,0,0,,Су….
Dialogue: 0,0:10:13.21,0:10:17.91,Default,,0,0,0,,Уф... Иә, бұл энергетикалық сусын.
Dialogue: 0,0:10:17.91,0:10:21.42,Default,,0,0,0,,Сусын? (ішу дыбысы)
Dialogue: 0,0:10:21.42,0:10:24.92,Default,,0,0,0,,Даха! Жақсы, бұл пайдалы болды!
Dialogue: 0,0:10:24.92,0:10:28.06,Default,,0,0,0,,Рахмет! Широко-чан, мынау➡
Dialogue: 0,0:10:28.06,0:10:30.09,Default,,0,0,0,,Сізді ұрлап кетті ме? ?
Dialogue: 0,0:10:30.09,0:10:33.76,Default,,0,0,0,,Широко-сенпай ақыры қылмыс жасайды деп ешқашан күткен емеспін! ?
Dialogue: 0,0:10:33.76,0:10:36.23,Default,,0,0,0,,Барлығы тынышталсын! Ақаулық туындамас бұрын ➡
Dialogue: 0,0:10:36.23,0:10:39.67,Default,,0,0,0,,Біз мұны қалай да жасыруымыз керек! Ахаха….
Dialogue: 0,0:10:39.67,0:10:44.11,Default,,0,0,0,,Жоқ. Бұл адамның менің мектебімде жұмысы бар.
Dialogue: 0,0:10:44.11,0:10:46.77,Default,,0,0,0,,Не? Бұл сіздің клиент екеніңізді білдіре ме?
Dialogue: 0,0:10:46.77,0:10:50.25,Default,,0,0,0,,Иә, тұтынушы. Эй. Солай болды ма?
Dialogue: 0,0:10:54.92,0:10:58.09,Default,,0,0,0,,Ахахаха... Абыдос шөлді аймақ➡
Dialogue: 0,0:10:58.09,0:11:01.59,Default,,0,0,0,,Мен мұны білдім, бірақ мен жүріп келе жатқанда өте ыстық болды➡
Dialogue: 0,0:11:01.59,0:11:06.66,Default,,0,0,0,,Менің басым айналып кетті. Мен білмей тұрып құлап кеткен сияқтымын.
Dialogue: 0,0:11:08.90,0:11:11.60,Default,,0,0,0,,Хмм…. Ой...
Dialogue: 0,0:11:11.60,0:11:14.60,Default,,0,0,0,,Хмм…. иә? (Аяне/Селика) Иә.
Dialogue: 0,0:11:14.60,0:11:18.74,Default,,0,0,0,,Хмм... Жарайды, қарсы болмасаңыз➡
Dialogue: 0,0:11:18.74,0:11:21.24,Default,,0,0,0,,Сіз туралы сұрасам бола ма?
Dialogue: 0,0:11:21.24,0:11:23.41,Default,,0,0,0,,Аа, дұрыс!
Dialogue: 0,0:11:23.41,0:11:26.92,Default,,0,0,0,,Мен Федералдық Тергеу Бюросының Петри табақшасының ''мұғалімімін''.
Dialogue: 0,0:11:26.92,0:11:29.32,Default,,0,0,0,,Танысқаныма қуаныштымын! иә! ?
Dialogue: 0,0:11:29.32,0:11:32.09,Default,,0,0,0,,Бұл Федерация Студенттік Кеңесіне қатысты дегенді білдіреді! ?
Dialogue: 0,0:11:32.09,0:11:34.72,Default,,0,0,0,,Иә! Ақырында қолдау сұрауы келді➡
Dialogue: 0,0:11:34.72,0:11:39.09,Default,,0,0,0,,Осылайша қабылданды. Жарайсың, Аяне-чан!
Dialogue: 0,0:11:39.09,0:11:41.23,Default,,0,0,0,,Иә. Өтініштерді жіберіп тұрдыңыз ба➡
Dialogue: 0,0:11:41.23,0:11:45.40,Default,,0,0,0,,Иә! Енді сіз керек-жарақтарды ала аласыз!
Dialogue: 0,0:11:45.40,0:11:48.90,Default,,0,0,0,,Айтпақшы, бәрі жақсы ма?
Dialogue: 0,0:11:48.90,0:11:52.94,Default,,0,0,0,,Міне! Мен мұны сендерге бергім келді.
Dialogue: 0,0:11:52.94,0:11:57.08,Default,,0,0,0,,Ах, рахмет! Бұл оқ-дәрілер мен керек-жарақтарға көмектеседі➡
Dialogue: 0,0:11:57.08,0:12:00.28,Default,,0,0,0,,Иә. Әй, Хошино-сенпай да➡
Dialogue: 0,0:12:00.28,0:12:03.38,Default,,0,0,0,,Мен сізге айтуым керек. Мүмкін сіз үлкен болсаңыз➡
Dialogue: 0,0:12:03.38,0:12:05.75,Default,,0,0,0,,Менің ойымша, ол әдеттегі орнында ұйықтап жатыр.
Dialogue: 0,0:12:05.75,0:12:10.29,Default,,0,0,0,,Мен... мен сені оятамын. (Есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:12:10.29,0:12:12.93,Default,,0,0,0,,Иә, сэр. иә?
Dialogue: 0,0:12:12.93,0:12:15.10,Default,,0,0,0,,Барлығы әлі таныстырылған жоқ.
Dialogue: 0,0:12:17.23,0:12:20.37,Default,,0,0,0,,Бұл қыз Селика Куроми, бірінші курс студенті.
Dialogue: 0,0:12:20.37,0:12:24.41,Default,,0,0,0,,Менің атым Нономи Изайой, мен екінші курс студентімін.
Dialogue: 0,0:12:24.41,0:12:29.04,Default,,0,0,0,,Сәлеметсіз бе, бұл Айане Окусора, бірінші курс студенті.
Dialogue: 0,0:12:29.04,0:12:32.25,Default,,0,0,0,,Мен Широкомын, екінші жыл құмды қасқырмын.
Dialogue: 0,0:12:32.25,0:12:36.72,Default,,0,0,0,,Менің ойымша, сіз мұны бірінші рет кездестіргендіктен білесіз.
Dialogue: 0,0:12:36.72,0:12:40.92,Default,,0,0,0,,Аа, мен тауды алып жатқан сияқты емеспін.
Dialogue: 0,0:12:40.92,0:12:44.56,Default,,0,0,0,,Тағы бір адам, жұмыс тобының төрағасы➡
Dialogue: 0,0:12:44.56,0:12:47.06,Default,,0,0,0,,Хошино Котори-сенпай.
Dialogue: 0,0:12:47.06,0:12:50.06,Default,,0,0,0,,Абыдос орта мектебінен 5-тен астам адам➡
Dialogue: 0,0:12:50.06,0:12:53.57,Default,,0,0,0,,Мектепті жабу жөніндегі жұмыс тобы. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:12:53.57,0:12:57.37,Default,,0,0,0,,Танысқаныма қуаныштымын. Селика-чан➡
Dialogue: 0,0:12:57.37,0:12:59.74,Default,,0,0,0,,Қартқа мейірімді болу керек...
Dialogue: 0,0:12:59.74,0:13:02.91,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сіз төрағасыз, келіңіз➡
Dialogue: 0,0:13:02.91,0:13:07.35,Default,,0,0,0,,Дұрыс орындаңыз! Эй, бұл Хошино Которию.
Dialogue: 0,0:13:07.35,0:13:09.22,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:13:09.22,0:13:12.62,Default,,0,0,0,,Мен Петри табақшасының мұғалімімін. сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:13:14.62,0:13:18.39,Default,,0,0,0,,Иә? Сәлем, ұстаз➡
Dialogue: 0,0:13:18.39,0:13:21.20,Default,,0,0,0,,Мен қазір саған мектепті көрсетемін.
Dialogue: 0,0:13:27.87,0:13:32.07,Default,,0,0,0,,Абыдос төңірегінде шөлейттену қарқынды жүріп жатыр.
Dialogue: 0,0:13:32.07,0:13:36.94,Default,,0,0,0,,Хмм... бұл мектеп мен оқуға түскен кезде де болды➡
Dialogue: 0,0:13:36.94,0:13:40.05,Default,,0,0,0,,Бұл бұрыннан солай болған.
Dialogue: 0,0:13:40.05,0:13:43.22,Default,,0,0,0,,Басқа оқушылар жоқ сияқты➡
Dialogue: 0,0:13:43.22,0:13:45.89,Default,,0,0,0,,Мүмкін бұл Широко мен бесеуміз шығар?
Dialogue: 0,0:13:45.89,0:13:49.76,Default,,0,0,0,,Хмм... Иә. Негізі бұл мектеп➡
Dialogue: 0,0:13:49.76,0:13:54.86,Default,,0,0,0,,Қарыз көп, енді біз ғана қалдық.
Dialogue: 0,0:13:54.86,0:13:58.90,Default,,0,0,0,,Жұмыс тобы ретінде бізге түрлі сұраныстар түсті➡
Dialogue: 0,0:13:58.90,0:14:01.54,Default,,0,0,0,,Сыйақы өтеу үшін пайдаланылады.
Dialogue: 0,0:14:01.54,0:14:04.21,Default,,0,0,0,,Бұл қиын көрінеді.
Dialogue: 0,0:14:04.21,0:14:07.71,Default,,0,0,0,,Күні кеше бәріміз гимназияны жинадық.
Dialogue: 0,0:14:07.71,0:14:12.21,Default,,0,0,0,,Аа, ол кезде Аяна ауырып жатқан болатын, сондықтан біз төртеуміз.
Dialogue: 0,0:14:12.21,0:14:16.05,Default,,0,0,0,,Қоқыс мен күткеннен де көп болды, сондықтан біраз уақыт кетті ➡
Dialogue: 0,0:14:16.05,0:14:18.02,Default,,0,0,0,,Ешқандай проблема болған жоқ.
Dialogue: 0,0:14:18.02,0:14:21.02,Default,,0,0,0,,Осыдан кейін Аяна маған қатты ашуланды.
Dialogue: 0,0:14:21.02,0:14:24.69,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:14:24.69,0:14:28.23,Default,,0,0,0,,Бұл қай жерде? Тек бос бөлме.
Dialogue: 0,0:14:28.23,0:14:31.73,Default,,0,0,0,,Бұдан былай бұл жерді мұғалімнің бөлмесі ретінде пайдаланыңыз.
Dialogue: 0,0:14:31.73,0:14:36.60,Default,,0,0,0,,О, жақсысың ба? Хмм... Қызметкерлер бөлмесінде құм көп.
Dialogue: 0,0:14:40.41,0:14:44.31,Default,,0,0,0,,Бұл сәл тар ма? Бұл жеткілікті, рахмет.
Dialogue: 0,0:14:44.31,0:14:46.28,Default,,0,0,0,,Хмм….
Dialogue: 0,0:14:53.22,0:14:57.23,Default,,0,0,0,,Широко, сен неге бұл мектепті қорғағың келеді?
Dialogue: 0,0:14:57.23,0:14:59.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:59.39,0:15:03.06,Default,,0,0,0,,Түсіру! ? Құрметті Абыдос орта мектебінің оқушылары!
Dialogue: 0,0:15:03.06,0:15:07.07,Default,,0,0,0,,Бүгін біз сенің мектебіңді аламыз!
Dialogue: 0,0:15:07.07,0:15:09.77,Default,,0,0,0,,Бұл Катаката дулыға тобы!
Dialogue: 0,0:15:09.77,0:15:12.07,Default,,0,0,0,,Осындай уақытта...
Dialogue: 0,0:15:12.07,0:15:16.41,Default,,0,0,0,,Уау, мен мұнымен ұйықтай да алмаймын.
Dialogue: 0,0:15:16.41,0:15:21.08,Default,,0,0,0,,Хмф, мен кәдімгідей кек аламын!
Dialogue: 0,0:15:21.08,0:15:25.09,Default,,0,0,0,,Барлығымыз мектеп ауласына асығайық!
Dialogue: 0,0:15:25.09,0:15:27.09,Default,,0,0,0,,Мұғалім осында тығылып отыр.
Dialogue: 0,0:15:27.09,0:15:29.06,Default,,0,0,0,,Широко! ? Ах!
Dialogue: 0,0:15:31.76,0:15:35.66,Default,,0,0,0,,Аа... 🔊Қауіпті! Апыр-ай!
Dialogue: 0,0:15:35.66,0:15:39.77,Default,,0,0,0,,Алона рахмет. 🔊Қош келдіңіз, ұстаз.
Dialogue: 0,0:15:42.77,0:15:46.31,Default,,0,0,0,,Широко-сенпай Бұл. Хмм... Рахмет.
Dialogue: 0,0:15:46.31,0:15:48.91,Default,,0,0,0,,Сонда да олар табанды.
Dialogue: 0,0:15:48.91,0:15:52.95,Default,,0,0,0,,Менде көп оқ-дәрі қалмады ма деп уайымдап отырмын.
Dialogue: 0,0:15:52.95,0:15:55.45,Default,,0,0,0,,Мен көбірек көмек алар едім...
Dialogue: 0,0:15:55.45,0:15:58.65,Default,,0,0,0,,Мәселе жоқ. Сәлем, Широко-чан! ?
Dialogue: 0,0:16:04.26,0:16:07.63,Default,,0,0,0,,Қалдық, қалдық! Сіздің оқ-дәрілеріңіз таусылуда.
Dialogue: 0,0:16:07.63,0:16:11.73,Default,,0,0,0,,Мен білемін! Ха! ? Неге мұндай ақпарат...
Dialogue: 0,0:16:11.73,0:16:14.24,Default,,0,0,0,,Жарайды, Аяне-чан! Дулыға бандасы➡
Dialogue: 0,0:16:14.24,0:16:17.77,Default,,0,0,0,,Біздің жауымыз емес! Широко-чанды қолдаңыз!
Dialogue: 0,0:16:17.77,0:16:20.31,Default,,0,0,0,,Иә! Ораораора!
Dialogue: 0,0:16:20.31,0:16:23.18,Default,,0,0,0,,Мен саған Абыдос орта мектебін бермеймін!
Dialogue: 0,0:16:26.08,0:16:28.22,Default,,0,0,0,,Әй, Широко-чан! ? иә?
Dialogue: 0,0:16:28.22,0:16:31.39,Default,,0,0,0,,Кя! Широко-чан Нономи-чан!
Dialogue: 0,0:16:31.39,0:16:33.52,Default,,0,0,0,,Ах…. Хошино-сенпай! ?
Dialogue: 0,0:16:33.52,0:16:36.52,Default,,0,0,0,,Барлығымыз, жолымызға оралайық!
Dialogue: 0,0:16:36.52,0:16:40.93,Default,,0,0,0,,Аххххххххх... Олар үйлестіре алмайтын сияқты!
Dialogue: 0,0:16:40.93,0:16:44.97,Default,,0,0,0,,Олардың оқтары таусылды деген ақпарат рас сияқты.
Dialogue: 0,0:16:44.97,0:16:49.54,Default,,0,0,0,,Фуфуфуфуфу Бірдеңені шешетін кез келген сияқты.
Dialogue: 0,0:16:49.54,0:16:52.71,Default,,0,0,0,,Жарайды, барлығын бірден бүктеп алайық!
Dialogue: 0,0:16:52.71,0:16:55.54,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:55.54,0:16:59.35,Default,,0,0,0,,🔊Ұстаз, іс осылай жалғаса берсе, Абыдос орта мектебінің оқушылары...
Dialogue: 0,0:17:01.55,0:17:03.82,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:17:06.89,0:17:10.56,Default,,0,0,0,,Барлығы жақсы ма? иә…. Иә, қалай болғанда да.
Dialogue: 0,0:17:10.56,0:17:14.03,Default,,0,0,0,,Әркім, бір-біріңе жабыспаңдар, жайылып, төбелесіңдер!
Dialogue: 0,0:17:14.03,0:17:16.40,Default,,0,0,0,,Эй, сен әлі де мотивациясың ба?
Dialogue: 0,0:17:16.40,0:17:19.23,Default,,0,0,0,,Балалар, сізде жеңу мүмкіндігі жоқ!
Dialogue: 0,0:17:19.23,0:17:23.04,Default,,0,0,0,,Әрі қарай жүрейік!
Dialogue: 0,0:17:23.04,0:17:25.87,Default,,0,0,0,,Бұл жаман. Бұлай жалғаса берсе, сізді итеріп жібереді.
Dialogue: 0,0:17:25.87,0:17:29.08,Default,,0,0,0,,Қат! Мұндай жағдайға мәжбүр болу...
Dialogue: 0,0:17:33.05,0:17:36.05,Default,,0,0,0,,Барлығына! иә?
Dialogue: 0,0:17:36.05,0:17:42.76,Default,,0,0,0,,Ол кім? Ха ха ха ха….
Dialogue: 0,0:17:42.76,0:17:46.26,Default,,0,0,0,,Балалар, бұл мектепті неге қорғағыларың келеді?
Dialogue: 0,0:17:46.26,0:17:49.23,Default,,0,0,0,,Мұғалім…. (Мұғалім) Неге! ?
Dialogue: 0,0:17:57.91,0:18:01.58,Default,,0,0,0,,Бұл➡
Dialogue: 0,0:18:01.58,0:18:06.45,Default,,0,0,0,,Өйткені, бұл біз тиесілі жер.
Dialogue: 0,0:18:06.45,0:18:08.48,Default,,0,0,0,,Барлығы бірдей ме?
Dialogue: 0,0:18:08.48,0:18:10.92,Default,,0,0,0,,Әрине!
Dialogue: 0,0:18:10.92,0:18:14.42,Default,,0,0,0,,Кенеттен пайда болған Теме деген кім?
Dialogue: 0,0:18:14.42,0:18:17.59,Default,,0,0,0,,Мен мұғаліммін. мұғалім?
Dialogue: 0,0:18:17.59,0:18:21.43,Default,,0,0,0,,Мен оларға көмектесу үшін келдім.
Dialogue: 0,0:18:21.43,0:18:24.73,Default,,0,0,0,,Кешіріңіз, мен сізден кетуіңізді сұраймын.
Dialogue: 0,0:18:24.73,0:18:27.27,Default,,0,0,0,,Ол кенет пайда болып, бастық болып көрінді!
Dialogue: 0,0:18:27.27,0:18:29.74,Default,,0,0,0,,Мен сені ара ұясына айналдырамын!
Dialogue: 0,0:18:29.74,0:18:31.74,Default,,0,0,0,,Кәне, кеттік, бәріміз!
Dialogue: 0,0:18:35.44,0:18:37.91,Default,,0,0,0,,Nonomi! Қарсыласыңызға оқ жаудырыңыз!
Dialogue: 0,0:18:37.91,0:18:40.11,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,0:18:43.22,0:18:46.39,Default,,0,0,0,,Селика, мақсат қой! Шүкір, мен айналамды көре алмаймын!
Dialogue: 0,0:18:46.39,0:18:49.09,Default,,0,0,0,,Уа, тыныштал! (мылтық)
Dialogue: 0,0:18:49.09,0:18:51.59,Default,,0,0,0,,Мен мұны сен айтпасаң да білемін!
Dialogue: 0,0:18:51.59,0:18:54.26,Default,,0,0,0,,Иә! Керемет, Нономи-чан, Селика-чан!
Dialogue: 0,0:18:54.26,0:18:58.13,Default,,0,0,0,,Жер бетінде бұл қалай болады...? Ах!
Dialogue: 0,0:18:58.13,0:19:01.70,Default,,0,0,0,,Кәрілер де кішілерден ұтыла алмайды!
Dialogue: 0,0:19:10.78,0:19:13.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:13.31,0:19:15.42,Default,,0,0,0,,Координаталар түсірілді.
Dialogue: 0,0:19:15.42,0:19:19.42,Default,,0,0,0,,Қабыл алыңыз, Широко-сенпай!
Dialogue: 0,0:19:19.42,0:19:22.42,Default,,0,0,0,,Керемет уақыт Аяна.
Dialogue: 0,0:19:22.42,0:19:24.43,Default,,0,0,0,,Гяа! Гах! Ах!
Dialogue: 0,0:19:24.43,0:19:27.56,Default,,0,0,0,,Жоқ! Апыр-ай!
Dialogue: 0,0:19:27.56,0:19:31.23,Default,,0,0,0,,Не? Жыл! Эй, өзіңді ұста!
Dialogue: 0,0:19:31.23,0:19:34.20,Default,,0,0,0,,Уф! Ха, бұл ұят!
Dialogue: 0,0:19:39.24,0:19:42.11,Default,,0,0,0,,Ах! Кя! О, о... Эй!
Dialogue: 0,0:19:44.05,0:19:48.72,Default,,0,0,0,,Цк, жақындама! (Мұғалім) Шахмат, Широко!
Dialogue: 0,0:19:48.72,0:19:52.55,Default,,0,0,0,,Бұл келе жатыр! Ах, аа!
Dialogue: 0,0:19:52.55,0:19:56.12,Default,,0,0,0,,Уф... Ах! Уф….
Dialogue: 0,0:19:56.12,0:19:58.69,Default,,0,0,0,,Күтіңіз... Күтіңіз! Бағыну!
Dialogue: 0,0:19:58.69,0:20:00.90,Default,,0,0,0,,Міне.
Dialogue: 0,0:20:00.90,0:20:04.23,Default,,0,0,0,,Эй….
Dialogue: 0,0:20:04.23,0:20:07.80,Default,,0,0,0,,Аа….
Dialogue: 0,0:20:07.80,0:20:11.91,Default,,0,0,0,,Ита! Бұл... Иә! Тек тоқтаңыз...
Dialogue: 0,0:20:11.91,0:20:15.74,Default,,0,0,0,,Олай болса тез үйге қайт. Түсінікті! Мен үйге бара жатырмын! Мен үйге бара жатырмын!
Dialogue: 0,0:20:15.74,0:20:19.58,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:20:19.58,0:20:22.68,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:20:24.72,0:20:27.22,Default,,0,0,0,,Сен істедің, Широко-чан.
Dialogue: 0,0:20:27.22,0:20:30.89,Default,,0,0,0,,Еңбектеріңіз үшін рахмет. Сол жағдайдан➡
Dialogue: 0,0:20:30.89,0:20:35.30,Default,,0,0,0,,Оның кері кеткеніне сене алар емеспін. Бұл да ұстазымның арқасы.
Dialogue: 0,0:20:35.30,0:20:38.40,Default,,0,0,0,,Жоқ, менде ештеңе жоқ...
Dialogue: 0,0:20:38.40,0:20:41.40,Default,,0,0,0,,Мен мұғалім ретінде қиналған оқушыларға көмектесемін➡
Dialogue: 0,0:20:41.40,0:20:44.94,Default,,0,0,0,,Мен оны жалғыз қалдыра алмадым. Хмф! Жігіттерге ұнайды➡
Dialogue: 0,0:20:44.94,0:20:47.58,Default,,0,0,0,,Біз бар күшімізбен жеңіске жететін едік.
Dialogue: 0,0:20:47.58,0:20:50.74,Default,,0,0,0,,Селика-чан әлі де цундере.
Dialogue: 0,0:20:50.74,0:20:53.88,Default,,0,0,0,,Уф, шу! Сүйкімді Селика Чан.
Dialogue: 0,0:20:53.88,0:20:55.92,Default,,0,0,0,,Біз батылдық танытуымыз керек пе?
Dialogue: 0,0:20:55.92,0:20:58.89,Default,,0,0,0,,Бәрің аузыңды жап! ? Апыр-ай.
Dialogue: 0,0:20:58.89,0:21:02.32,Default,,0,0,0,,Бір секундқа оралыңыз, Хошино-сенпай! Бұл менің ұстазым...
Dialogue: 0,0:21:02.32,0:21:40.83,Default,,0,0,0,,♬～
Dialogue: 0,0:23:30.07,0:23:32.64,Default,,0,0,0,,Хмм, құлпынай сүті….
Dialogue: 0,0:23:38.05,0:23:40.95,Default,,0,0,0,,Сәлем Алона. иә….
Dialogue: 0,0:23:40.95,0:23:42.95,Default,,0,0,0,,А, аа!
Dialogue: 0,0:23:46.39,0:23:49.06,Default,,0,0,0,,Мен сізді күттім, ұстаз!
Dialogue: 0,0:23:50.56,0:23:56.56,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
