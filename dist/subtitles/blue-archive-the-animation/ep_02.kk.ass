Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.13,0:00:12.77,Default,,0,0,0,,♬～
Dialogue: 0,0:00:12.77,0:00:16.81,Default,,0,0,0,,Сіз Петри ғимаратын сәтті басып алған сияқтысыз, профессор.
Dialogue: 0,0:00:16.81,0:00:19.45,Default,,0,0,0,,Барлығына рахмет, Рин.
Dialogue: 0,0:00:19.45,0:00:21.62,Default,,0,0,0,,Енді маған еріңіз.
Dialogue: 0,0:00:25.32,0:00:27.62,Default,,0,0,0,,Міне, Федерация Студенттік Кеңесінің төрағасының артында қалдырғандары➡
Dialogue: 0,0:00:27.62,0:00:29.59,Default,,0,0,0,,Сақталады.
Dialogue: 0,0:00:31.79,0:00:34.63,Default,,0,0,0,,Оны алыңыз, сэр. (Мұғалім) А?
Dialogue: 0,0:00:34.63,0:00:37.30,Default,,0,0,0,,Планшеттік құрылғы? Бұл➡
Dialogue: 0,0:00:37.30,0:00:40.44,Default,,0,0,0,,Федерация Студенттік кеңесінің президенті сізге не сеніп тапсырды➡
Dialogue: 0,0:00:40.44,0:00:42.60,Default,,0,0,0,,Шиттемнің жәшігі.
Dialogue: 0,0:00:42.60,0:00:46.64,Default,,0,0,0,,ОЖ, жүйе құрылымы және басқалары белгісіз.
Dialogue: 0,0:00:46.64,0:00:49.78,Default,,0,0,0,,Біз оны бастай да алмадық.
Dialogue: 0,0:00:49.78,0:00:52.48,Default,,0,0,0,,Бірақ егер сіз мұғалім болсаңыз, мүмкін...
Dialogue: 0,0:01:04.29,0:01:07.46,Default,,0,0,0,,Муня... Кастелла үшін➡
Dialogue: 0,0:01:07.46,0:01:12.23,Default,,0,0,0,,Банан сүті құлпынай сүтінен жақсы.
Dialogue: 0,0:01:16.94,0:01:19.78,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:01:19.78,0:01:22.78,Default,,0,0,0,,Иә! ? иә? Бұл солай ма?
Dialogue: 0,0:01:22.78,0:01:26.65,Default,,0,0,0,,Менің бұл кеңістікке келуім күтпеген жерден болды...
Dialogue: 0,0:01:26.65,0:01:30.02,Default,,0,0,0,,Иә, мен Петри табақшасының мұғалімімін.
Dialogue: 0,0:01:30.02,0:01:33.12,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:01:33.12,0:01:37.13,Default,,0,0,0,,Тыныш, тыныш... у...
Dialogue: 0,0:01:37.13,0:01:41.03,Default,,0,0,0,,Тағы, тағы!
Dialogue: 0,0:01:41.03,0:01:44.80,Default,,0,0,0,,Мен Алонамын. Мен Shittem's box➡ жүйелік әкімшісімін
Dialogue: 0,0:01:44.80,0:01:48.20,Default,,0,0,0,,Негізгі ОЖ. Ал қазірден бастап➡
Dialogue: 0,0:01:48.20,0:01:52.11,Default,,0,0,0,,Мұғалімге көмекші хатшы. Танысқаныма қуаныштымын, Алона.
Dialogue: 0,0:01:52.11,0:01:55.71,Default,,0,0,0,,Иә! Сізге көп рахмет, ұстаз!
Dialogue: 0,0:03:38.15,0:03:42.58,Default,,0,0,0,,Ей, қаш! Шегіну!
Dialogue: 0,0:03:42.58,0:03:45.19,Default,,0,0,0,,📱Баршаңызға еңбектеріңіз үшін рахмет.
Dialogue: 0,0:03:45.19,0:03:47.76,Default,,0,0,0,,📱Енді бізде Team Helmet➡ үшін тағы бір база бар
Dialogue: 0,0:03:47.76,0:03:51.26,Default,,0,0,0,,басылуы мүмкін. Хмм... Дұрыс.
Dialogue: 0,0:03:51.26,0:03:57.77,Default,,0,0,0,,🔊Еңбегіңізге рахмет, ұстаз. Алона рахмет.
Dialogue: 0,0:03:57.77,0:04:01.27,Default,,0,0,0,,Ой... Қария мен шаршадым.
Dialogue: 0,0:04:01.27,0:04:04.44,Default,,0,0,0,,Үйге барып ұйықтағым келеді. Әй.
Dialogue: 0,0:04:04.44,0:04:06.84,Default,,0,0,0,,Олай болса, мектепке қайтайық.
Dialogue: 0,0:04:06.84,0:04:09.01,Default,,0,0,0,,Fai. иә.
Dialogue: 0,0:04:11.58,0:04:15.75,Default,,0,0,0,,Команданың дулығасына қатысты олардың соңғы базасы жойылды ➡
Dialogue: 0,0:04:15.75,0:04:18.09,Default,,0,0,0,,Біраз уақыт тыныш болады.
Dialogue: 0,0:04:18.09,0:04:22.26,Default,,0,0,0,,Бұл да мұғалімнің алғысы. Мен көп нәрсе жасаған жоқпын.
Dialogue: 0,0:04:22.26,0:04:26.19,Default,,0,0,0,,Міне, тағы барамыз. Петри ыдысының шебері күткендей.
Dialogue: 0,0:04:26.19,0:04:31.10,Default,,0,0,0,,Ахаха…. Енді сіз қарызыңызды өтеуге назар аудара аласыз.
Dialogue: 0,0:04:31.10,0:04:34.10,Default,,0,0,0,,Ойланып қарасақ, қарыз қанша?
Dialogue: 0,0:04:34.10,0:04:36.77,Default,,0,0,0,,Хмм, шамамен 900 миллион?
Dialogue: 0,0:04:36.77,0:04:38.94,Default,,0,0,0,,Уф... 900 миллион! ?
Dialogue: 0,0:04:38.94,0:04:43.45,Default,,0,0,0,,Нақтырақ айтсақ, 962 350 000.
Dialogue: 0,0:04:43.45,0:04:46.21,Default,,0,0,0,,Неліктен мен тағы да сонша ақша қарызмын?
Dialogue: 0,0:04:50.12,0:04:53.62,Default,,0,0,0,,Осыдан бірнеше онжылдықтар бұрын Абыдос шетіндегі шөлде➡
Dialogue: 0,0:04:53.62,0:04:56.79,Default,,0,0,0,,Үлкен құмды дауыл соқты.
Dialogue: 0,0:04:56.79,0:04:59.76,Default,,0,0,0,,Құмды дауылды елестету мүмкін емес еді➡
Dialogue: 0,0:04:59.76,0:05:04.13,Default,,0,0,0,,Абыдостың барлық жері құмға көмілген.
Dialogue: 0,0:05:04.13,0:05:07.07,Default,,0,0,0,,Қалпына келтіру үшін үлкен сома қажет.
Dialogue: 0,0:05:07.07,0:05:11.04,Default,,0,0,0,,Алайда маған несие беретін банк таба алмадым...
Dialogue: 0,0:05:11.04,0:05:14.24,Default,,0,0,0,,Соңында мен Kaiser Loan деп аталатын жосықсыз қаржы компаниясына тап болдым➡
Dialogue: 0,0:05:14.24,0:05:17.28,Default,,0,0,0,,Менің оған сенуден басқа амалым қалмады.
Dialogue: 0,0:05:17.28,0:05:22.28,Default,,0,0,0,,Бастапқыда оны тез қайтарған дұрыс деп ойлаймын.
Dialogue: 0,0:05:22.28,0:05:24.79,Default,,0,0,0,,Дегенмен➡
Dialogue: 0,0:05:24.79,0:05:29.32,Default,,0,0,0,,Осыдан кейін Абыдоста үлкен құмды дауылдар талай рет соғыла берді➡
Dialogue: 0,0:05:29.32,0:05:34.63,Default,,0,0,0,,Ақырында Абыдостың жартысынан көбі құмға жұтылды.
Dialogue: 0,0:05:34.63,0:05:37.50,Default,,0,0,0,,Оқушылар түңіліп, нәтижесі➡ болды
Dialogue: 0,0:05:37.50,0:05:40.77,Default,,0,0,0,,Бар болғаны шардың қарызы ғана қалды.
Dialogue: 0,0:05:40.77,0:05:45.14,Default,,0,0,0,,Егер қарызды өтеу мүмкін болмаса, мектеп банкке өтеді➡
Dialogue: 0,0:05:45.14,0:05:48.44,Default,,0,0,0,,Мектепте мектепті жабу процедурасынан басқа таңдау болмайды.
Dialogue: 0,0:05:48.44,0:05:51.31,Default,,0,0,0,,Дегенмен, оны іс жүзінде өтеу мүмкіндігі ➡
Dialogue: 0,0:05:51.31,0:05:53.58,Default,,0,0,0,,0%-ға жақын...
Dialogue: 0,0:05:53.58,0:05:58.29,Default,,0,0,0,,Оқушылардың көпшілігі бұл мектепті тастап кетті.
Dialogue: 0,0:05:58.29,0:06:01.46,Default,,0,0,0,,Ал біз ғана қалдық.
Dialogue: 0,0:06:03.43,0:06:06.39,Default,,0,0,0,,Бұл қызықсыз әңгіме.
Dialogue: 0,0:06:09.43,0:06:12.57,Default,,0,0,0,,Маған әңгімеңізді тыңдауға рұқсат бергеніңіз үшін рахмет.
Dialogue: 0,0:06:12.57,0:06:17.07,Default,,0,0,0,,Мен де әркім нені көтеріп жүргенін аздап түсінемін.
Dialogue: 0,0:06:17.07,0:06:19.51,Default,,0,0,0,,Қарыз сомасы, әрине, үлкен.
Dialogue: 0,0:06:19.51,0:06:22.54,Default,,0,0,0,,Бірақ біз жай ғана бас тарта алмаймыз.
Dialogue: 0,0:06:22.54,0:06:26.11,Default,,0,0,0,,Сіз қалай ойлайсыз? Баршаңызға, мен қазірден бастап сіздердің ұстаздарыңыз боламын➡
Dialogue: 0,0:06:26.11,0:06:30.15,Default,,0,0,0,,Маған ынтымақтасуға рұқсат бересіз бе? Бұл дұрыс...
Dialogue: 0,0:06:30.15,0:06:33.69,Default,,0,0,0,,Иә! рақмет сізге.
Dialogue: 0,0:06:33.69,0:06:35.59,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:06:35.59,0:06:39.13,Default,,0,0,0,,Өйткені мұғалім сырттан келген адам.
Dialogue: 0,0:06:39.13,0:06:42.00,Default,,0,0,0,,Бірақ сол себепті біздің көзқарасымыз басқаша➡
Dialogue: 0,0:06:42.00,0:06:45.77,Default,,0,0,0,,Мүмкін сіз маған көмектесе аласыз. дегенмен!
Dialogue: 0,0:06:45.77,0:06:48.17,Default,,0,0,0,,Осы уақытқа дейін мектеп мәселесі тек бізде болатын ➡
Dialogue: 0,0:06:48.17,0:06:51.27,Default,,0,0,0,,Сіз бірдеңе істей алдыңыз! Бірақ кенеттен ересек адам келді➡
Dialogue: 0,0:06:51.27,0:06:54.44,Default,,0,0,0,,Мойынсұнуға қалай батылы бардың. Мен барлығына мән беремін➡
Dialogue: 0,0:06:54.44,0:06:58.28,Default,,0,0,0,,Мен жай ғана көмектескім келеді... Жоғарыдан қандай көрініс!
Dialogue: 0,0:06:58.28,0:07:01.92,Default,,0,0,0,,Мен мақұлдамаймын!
Dialogue: 0,0:07:01.92,0:07:06.62,Default,,0,0,0,,Селика-чан! (Есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:07:06.62,0:07:09.89,Default,,0,0,0,,《Бәрі ақымақ! Ұстаз Ұстаз! 》
Dialogue: 0,0:07:14.03,0:07:16.70,Default,,0,0,0,,А…?
Dialogue: 0,0:07:27.24,0:07:31.11,Default,,0,0,0,,Аа...
Dialogue: 0,0:07:31.11,0:07:36.79,Default,,0,0,0,,Мұғалім, не болды? Бұл кеше сабақтан кейін...
Dialogue: 0,0:07:36.79,0:07:38.99,Default,,0,0,0,,｟Сәлеметсіз бе Селика. Енді үйге барасың ба?
Dialogue: 0,0:07:42.59,0:07:46.06,Default,,0,0,0,,Сәлем Селика. Неге кафеге барып сөйлеспейміз?
Dialogue: 0,0:07:48.60,0:07:51.53,Default,,0,0,0,,Эй, эй, Селика. Кішкене сөйлесейік...
Dialogue: 0,0:07:51.53,0:07:53.80,Default,,0,0,0,,Сіз өте табандысыз! Бұл аңдыушы! ｠
Dialogue: 0,0:07:53.80,0:07:56.24,Default,,0,0,0,,Уф…. Яғни➡
Dialogue: 0,0:07:56.24,0:08:00.91,Default,,0,0,0,,Цундер қызы Селика-чан болмаса да ашуланады.
Dialogue: 0,0:08:00.91,0:08:04.58,Default,,0,0,0,,Ойланып қарасам, Селика сабақтан кейін бірден үйіне кетеді➡
Dialogue: 0,0:08:04.58,0:08:07.45,Default,,0,0,0,,Қайда бара жатырсың? Менен сұрасаңыз➡
Dialogue: 0,0:08:07.45,0:08:10.25,Default,,0,0,0,,Momotalk жауаптары да баяу.
Dialogue: 0,0:08:10.25,0:08:14.26,Default,,0,0,0,,Шынымен. А, онда барлығы➡
Dialogue: 0,0:08:14.26,0:08:18.26,Default,,0,0,0,,Мектептен кейін Селика-чанның соңынан еруге қалай қарайсыз?
Dialogue: 0,0:08:18.26,0:08:21.93,Default,,0,0,0,,Не? келісім! (есіктің ашылған дыбысы)
Dialogue: 0,0:08:21.93,0:08:23.93,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:08:23.93,0:08:27.44,Default,,0,0,0,,Ах.
Dialogue: 0,0:08:27.44,0:08:29.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:29.44,0:08:40.78,Default,,0,0,0,,♬～
Dialogue: 0,0:08:40.78,0:08:44.12,Default,,0,0,0,,А нысана нүктесінен өту.
Dialogue: 0,0:08:44.12,0:08:48.09,Default,,0,0,0,,Мақсатты бақылау. Мен сізді осылай жалғастырамын.
Dialogue: 0,0:08:56.43,0:08:58.43,Default,,0,0,0,,Иттерді ауыстыру.
Dialogue: 0,0:08:58.43,0:09:02.77,Default,,0,0,0,,Түсінікті. Бақылауды жалғастырыңыз.
Dialogue: 0,0:09:02.77,0:09:15.58,Default,,0,0,0,,♬～
Dialogue: 0,0:09:15.58,0:09:18.59,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:09:18.59,0:09:22.59,Default,,0,0,0,,Бұл... Шибасеки Рамен бе?
Dialogue: 0,0:09:22.59,0:09:24.69,Default,,0,0,0,,Бұл туралы айтатын болсақ...
Dialogue: 0,0:09:24.69,0:09:27.26,Default,,0,0,0,,｟Бұл рамен дәмді｠
Dialogue: 0,0:09:30.77,0:09:32.90,Default,,0,0,0,,⚟Мереке-сан.
Dialogue: 0,0:09:32.90,0:09:35.90,Default,,0,0,0,,Бұл дәмді болды.
Dialogue: 0,0:09:35.90,0:09:38.61,Default,,0,0,0,,Генерал, мен тағы келдім.
Dialogue: 0,0:09:38.61,0:09:40.58,Default,,0,0,0,,Селика Ол шықпайды.
Dialogue: 0,0:09:40.58,0:09:43.48,Default,,0,0,0,,Мен олар ашкөздікпен айналысып жатыр ма деп ойлаймын.
Dialogue: 0,0:09:43.48,0:09:47.25,Default,,0,0,0,,Барлығымыз аштық, ендеше ішке кірейік.
Dialogue: 0,0:09:47.25,0:09:50.42,Default,,0,0,0,,Келісемін! Хмм. Мен келісемін.
Dialogue: 0,0:09:50.42,0:09:52.42,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:09:52.42,0:09:55.42,Default,,0,0,0,,Сәлем, қош келдіңіз! Қош келдіңіз...
Dialogue: 0,0:09:55.42,0:09:58.86,Default,,0,0,0,,О. Селика-чан, яху.
Dialogue: 0,0:09:58.86,0:10:02.60,Default,,0,0,0,,Бірыңғай киім Өте сүйкімді. Нана...
Dialogue: 0,0:10:02.60,0:10:04.97,Default,,0,0,0,,Сіз Абыдос орта мектебінің оқушысысыз ба?
Dialogue: 0,0:10:04.97,0:10:08.27,Default,,0,0,0,,Егер сіз Селиканың досы болсаңыз, мен сізге қызмет етуім керек.
Dialogue: 0,0:10:08.27,0:10:12.14,Default,,0,0,0,,Ах! Ух... Онда➡
Dialogue: 0,0:10:12.14,0:10:15.44,Default,,0,0,0,,Міне... осында келіңізші.
Dialogue: 0,0:10:15.44,0:10:18.58,Default,,0,0,0,,Селика форма киіп, толық емес жұмыс күнін алатын түрі ме?
Dialogue: 0,0:10:18.58,0:10:22.78,Default,,0,0,0,,Жетеді! Сондықтан… тапсырыс беріңіз! ? (Тапсырыс беру дауысы)
Dialogue: 0,0:10:22.78,0:10:26.42,Default,,0,0,0,,Бәрін бірден айтпа! Мұғалімдерден қалыс қалмаңыз➡
Dialogue: 0,0:10:26.42,0:10:29.16,Default,,0,0,0,,Жанжанды сұраңыз. Ах, ах.
Dialogue: 0,0:10:29.16,0:10:31.66,Default,,0,0,0,,Олай болса, мен...
Dialogue: 0,0:10:33.93,0:10:36.23,Default,,0,0,0,,Жоқ, хахаха….
Dialogue: 0,0:10:38.60,0:10:41.87,Default,,0,0,0,,Мен оны аламын. Уууу.
Dialogue: 0,0:10:46.51,0:10:50.25,Default,,0,0,0,,Сіз қалай ойлайсыз? Дәмі қалай? дәмді.
Dialogue: 0,0:10:50.25,0:10:54.25,Default,,0,0,0,,Дұрыс, дұрыс! Селика-чанның досы күткендей.
Dialogue: 0,0:10:54.25,0:10:57.92,Default,,0,0,0,,Ол өркендеп жатқан сияқты. Міне, міне➡
Dialogue: 0,0:10:57.92,0:11:02.09,Default,,0,0,0,,Тұтынушылар саны азайған жоқ. иә? Бұл...
Dialogue: 0,0:11:02.09,0:11:04.43,Default,,0,0,0,,Жарайды, бұл туралы уайымдағаннан пайда жоқ!
Dialogue: 0,0:11:04.43,0:11:07.46,Default,,0,0,0,,Әй, аш келген тұтынушыларға➡
Dialogue: 0,0:11:07.46,0:11:09.76,Default,,0,0,0,,Мен саған дәмді тамақ беремін!
Dialogue: 0,0:11:09.76,0:11:11.93,Default,,0,0,0,,Бұл менің ұраным!
Dialogue: 0,0:11:14.27,0:11:17.74,Default,,0,0,0,,Керемет! Мен де генералды ➡ қадағалаймын
Dialogue: 0,0:11:17.74,0:11:20.74,Default,,0,0,0,,Біз бұл балаларға қолдау көрсетуіміз керек!
Dialogue: 0,0:11:20.74,0:11:22.61,Default,,0,0,0,,Әй, мұғалім де стильді көрінеді!
Dialogue: 0,0:11:22.61,0:11:24.58,Default,,0,0,0,,Тағы да рахмет. Тағы бір ерекше сусын➡
Dialogue: 0,0:11:24.58,0:11:30.42,Default,,0,0,0,,Маған қызмет ет! (күлкі)
Dialogue: 0,0:11:30.42,0:11:33.42,Default,,0,0,0,,Селика-чан, ертең кездескенше.
Dialogue: 0,0:11:33.42,0:11:35.42,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:11:37.59,0:11:40.56,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:11:48.10,0:11:50.77,Default,,0,0,0,,Селика-чан, сен бүгін көтеріле аласың.
Dialogue: 0,0:11:50.77,0:11:52.94,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:55.64,0:11:59.18,Default,,0,0,0,,Сәлем, Селика-чан. Сол мұғалім➡
Dialogue: 0,0:11:59.18,0:12:01.95,Default,,0,0,0,,Ол өте мұқият ересек адам, солай емес пе?
Dialogue: 0,0:12:01.95,0:12:04.42,Default,,0,0,0,,Не? Мен солай деп ойлаймын.
Dialogue: 0,0:12:07.82,0:12:10.02,Default,,0,0,0,,Алдын ала кешірім сұраймын.
Dialogue: 0,0:12:21.50,0:12:23.77,Default,,0,0,0,,(Сауда автоматының дыбысы)
Dialogue: 0,0:12:23.77,0:12:26.44,Default,,0,0,0,,Хмм... Уау!
Dialogue: 0,0:12:26.44,0:12:28.41,Default,,0,0,0,,Жақсы жұмыс. Енді үйге барасың ба?
Dialogue: 0,0:12:35.58,0:12:38.42,Default,,0,0,0,,Бұрынғы рамен дәмді болды.
Dialogue: 0,0:12:38.42,0:12:43.59,Default,,0,0,0,,Генерал да жақсы адам, мен оған сүйенемін деп ойлаймын.
Dialogue: 0,0:12:43.59,0:12:45.59,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:51.77,0:12:55.17,Default,,0,0,0,,Сәлем Селика. иә?
Dialogue: 0,0:12:55.17,0:12:59.07,Default,,0,0,0,,Мұғалімдер де сенімді ересектер деп ойлаймын.
Dialogue: 0,0:12:59.07,0:13:01.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:04.25,0:13:06.71,Default,,0,0,0,,Көріскенше, Селика. Ертең кездескенше.
Dialogue: 0,0:13:10.08,0:13:15.42,Default,,0,0,0,,Широко-сенпай да генералмен бірдей.
Dialogue: 0,0:13:15.42,0:13:18.59,Default,,0,0,0,,Мұғалім...?
Dialogue: 0,0:13:18.59,0:13:22.23,Default,,0,0,0,,Бәлкім, мен сізге шын көңілмен сенуім керек шығар.
Dialogue: 0,0:13:22.23,0:13:24.93,Default,,0,0,0,,Жоқ, сіз мұны істей алмайсыз!
Dialogue: 0,0:13:24.93,0:13:27.74,Default,,0,0,0,,Өйткені Абыдос орта мектебі...
Dialogue: 0,0:13:27.74,0:13:30.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:30.91,0:13:32.91,Default,,0,0,0,,Гехо Гехо...
Dialogue: 0,0:13:32.91,0:13:35.21,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:13:43.05,0:13:46.75,Default,,0,0,0,,Жоқ! ? Селика жоғалып кетті! ?
Dialogue: 0,0:13:46.75,0:13:48.76,Default,,0,0,0,,Дұрыс! Қоңырауды ➡ бассаңыз да
Dialogue: 0,0:13:48.76,0:13:50.73,Default,,0,0,0,,Мен қызық болдым, өйткені жауап жоқ➡
Dialogue: 0,0:13:50.73,0:13:54.06,Default,,0,0,0,,Мен бөлмеге кірдім...
Dialogue: 0,0:13:54.06,0:13:56.90,Default,,0,0,0,,Менде форма да, сөмке де болмады...
Dialogue: 0,0:13:56.90,0:13:59.23,Default,,0,0,0,,Сіз қоңырау шалып көрдіңіз бе? иә.
Dialogue: 0,0:13:59.23,0:14:01.24,Default,,0,0,0,,Бірақ ол қосылмайды.
Dialogue: 0,0:14:01.24,0:14:03.57,Default,,0,0,0,,Мен кеше түнде болғанына сене алар емеспін...
Dialogue: 0,0:14:03.57,0:14:05.57,Default,,0,0,0,,Барлығы тынышталсын.
Dialogue: 0,0:14:10.55,0:14:14.72,Default,,0,0,0,,Теңіз менің рухани үйім. (судың дыбысы)
Dialogue: 0,0:14:14.72,0:14:19.09,Default,,0,0,0,,Айқай? Аа, еңбегіңіз үшін рахмет... Алона менің сізден бір жақсылығым бар.
Dialogue: 0,0:14:19.09,0:14:21.89,Default,,0,0,0,,Селиканың орнын жылдам табыңыз.
Dialogue: 0,0:14:21.89,0:14:24.39,Default,,0,0,0,,Иә? Ха, иә!
Dialogue: 0,0:14:26.56,0:14:30.57,Default,,0,0,0,,Селиканың орналасқан жері анықталды! Е... қалай?
Dialogue: 0,0:14:30.57,0:14:34.07,Default,,0,0,0,,Федерация студенттік кеңесі басқаратын орталық желіге қол жеткізіңіз➡
Dialogue: 0,0:14:34.07,0:14:37.91,Default,,0,0,0,,Селиканың смартфонының орны анықталды. Тіпті мұндай билік...
Dialogue: 0,0:14:37.91,0:14:40.54,Default,,0,0,0,,Одан гөрі Селика қайда? Ах.
Dialogue: 0,0:14:40.54,0:14:42.88,Default,,0,0,0,,Олар әлі қозғалыста болса керек.
Dialogue: 0,0:14:42.88,0:14:46.55,Default,,0,0,0,,Қала маңындағы шөлді аймақ? О, бұл бұрын➡
Dialogue: 0,0:14:46.55,0:14:51.22,Default,,0,0,0,,Бұл Катаката дулыға тобының келіп-кететіндігі расталған жердің жанында.
Dialogue: 0,0:14:51.22,0:14:54.39,Default,,0,0,0,,Сіз бұл жолы барымтаға алып, бопсалауды жоспарлап отырсыз ба?
Dialogue: 0,0:14:54.39,0:14:56.56,Default,,0,0,0,,Бұл туралы ойлаудың қажеті жоқ.
Dialogue: 0,0:14:56.56,0:14:59.06,Default,,0,0,0,,Тездетіп, Селика-чанға көмектесейік.
Dialogue: 0,0:14:59.06,0:15:01.26,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:01.26,0:15:03.43,Default,,0,0,0,,Не істеймін… не істеймін!
Dialogue: 0,0:15:10.74,0:15:13.11,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:15:18.41,0:15:21.88,Default,,0,0,0,,Бұл... көлікте ме?
Dialogue: 0,0:15:21.88,0:15:25.39,Default,,0,0,0,,О, мен... ұрлап кетті ме?
Dialogue: 0,0:15:25.39,0:15:27.39,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:27.39,0:15:31.23,Default,,0,0,0,,Бәлкім, бұл жер шөлді шығар?
Dialogue: 0,0:15:31.23,0:15:36.13,Default,,0,0,0,,⚟Бұл көлік командасы. Катаката дулыға бригадасының штабы, жауап беріңіз.
Dialogue: 0,0:15:36.13,0:15:38.53,Default,,0,0,0,,📱Бұл Катаката дулыға бригадасының штаб-пәтері.
Dialogue: 0,0:15:38.53,0:15:41.57,Default,,0,0,0,,Сіз кешігіп қалдыңыз, тасымалдау тобы. Сен не істеп жатырсың!
Dialogue: 0,0:15:41.57,0:15:43.57,Default,,0,0,0,,Жақында екінші тарап келеді.
Dialogue: 0,0:15:43.57,0:15:46.24,Default,,0,0,0,,Жеткізу уақытында орындалмаса не істеуім керек?
Dialogue: 0,0:15:46.24,0:15:49.91,Default,,0,0,0,,📱Уайымдамаңыз. Ол шамамен 10 минутта келеді деп күтілуде.
Dialogue: 0,0:15:49.91,0:15:53.41,Default,,0,0,0,,📱Жарайды, асығыңыз! сізді түсіндім.
Dialogue: 0,0:15:53.41,0:15:56.05,Default,,0,0,0,,Тез қашып кетпесек...
Dialogue: 0,0:15:56.05,0:15:59.25,Default,,0,0,0,,Мм! қазірдің өзінде!
Dialogue: 0,0:15:59.25,0:16:03.72,Default,,0,0,0,,《Мен не істеуім керек? Барлығы уайымдаса керек...
Dialogue: 0,0:16:03.72,0:16:09.23,Default,,0,0,0,,Мен бір жерге көміліп кете ме деп ойлаймын...
Dialogue: 0,0:16:09.23,0:16:12.40,Default,,0,0,0,,Мен барлығымен танысқым келеді...》
Dialogue: 0,0:16:18.31,0:16:20.78,Default,,0,0,0,,Уф! Не! ?
Dialogue: 0,0:16:25.88,0:16:28.42,Default,,0,0,0,,Керемет, Широко-чан!
Dialogue: 0,0:16:28.42,0:16:30.95,Default,,0,0,0,,Тездетіп, Селиканы құтқарыңыз!
Dialogue: 0,0:16:30.95,0:16:33.99,Default,,0,0,0,,Аяна Бұл арба қайда?
Dialogue: 0,0:16:33.99,0:16:37.06,Default,,0,0,0,,Мен оны қоймада шаң жинап жатқанын көрдім.
Dialogue: 0,0:16:37.06,0:16:39.89,Default,,0,0,0,,Мен мұндай жерде пайдалы болады деп ойламаппын...
Dialogue: 0,0:16:39.89,0:16:43.56,Default,,0,0,0,,Ах! Өтінемін, күте тұрыңыз!
Dialogue: 0,0:16:43.56,0:16:48.17,Default,,0,0,0,,Ой... ⚟Ат, ат!
Dialogue: 0,0:16:54.88,0:16:58.38,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:16:58.38,0:17:03.28,Default,,0,0,0,,Тоқта! Арх! Гайя!
Dialogue: 0,0:17:03.28,0:17:07.89,Default,,0,0,0,,Не? не болып жатыр?
Dialogue: 0,0:17:07.89,0:17:10.86,Default,,0,0,0,,Жылап жатқан Селиканы тапты.
Dialogue: 0,0:17:10.86,0:17:12.56,Default,,0,0,0,,📱Селика-чан!
Dialogue: 0,0:17:12.56,0:17:16.06,Default,,0,0,0,,Сүйкімді Селика-чан, сен сондай жалғыз болған шығарсың.
Dialogue: 0,0:17:16.06,0:17:19.23,Default,,0,0,0,,📱Шулы! 📱Жылама, Селика-чан.
Dialogue: 0,0:17:19.23,0:17:21.74,Default,,0,0,0,,📱Көз жасыңды сүртеміз.
Dialogue: 0,0:17:21.74,0:17:23.91,Default,,0,0,0,,Жыламасаңыз болды!
Dialogue: 0,0:17:23.91,0:17:27.04,Default,,0,0,0,,📱 (Мұғалім) Селика, сенің аман жүргеніңе көңілім толды.
Dialogue: 0,0:17:27.04,0:17:30.71,Default,,0,0,0,,📱Неге тіпті мұғалім? ? Мен аңдыушы емеспін!
Dialogue: 0,0:17:30.71,0:17:33.08,Default,,0,0,0,,Уфуфу…. 📱Бұл не?
Dialogue: 0,0:17:33.08,0:17:35.92,Default,,0,0,0,,Мұндай кезде ақымақ болма.
Dialogue: 0,0:17:35.92,0:17:38.29,Default,,0,0,0,,📱Сен ақымақ емессің! ?
Dialogue: 0,0:17:38.29,0:17:40.56,Default,,0,0,0,,📱 (Мұғалім) Жарайды, қалғанын бәрі біледі.
Dialogue: 0,0:17:40.56,0:17:42.56,Default,,0,0,0,,📱Иә.
Dialogue: 0,0:17:42.56,0:17:44.66,Default,,0,0,0,,📱 (Мұғалім) Қарсы шабуыл басталды!
Dialogue: 0,0:17:46.99,0:17:50.06,Default,,0,0,0,,(Амон) Нагачика? (Хайд) Ах, Амон-сан.
Dialogue: 0,0:17:50.06,0:17:52.07,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:17:52.07,0:17:54.60,Default,,0,0,0,,Мен саған бұдан былай істеуге рұқсат бермеймін!
Dialogue: 0,0:17:54.60,0:17:56.57,Default,,0,0,0,,Мен енді өзімді ұстамаймын.
Dialogue: 0,0:18:01.08,0:18:03.14,Default,,0,0,0,,Бұл оңай болмайды!
Dialogue: 0,0:18:05.75,0:18:09.58,Default,,0,0,0,,Мені ұрлап кеткенің үшін жарайсың!
Dialogue: 0,0:18:09.58,0:18:12.55,Default,,0,0,0,,Қарғыс атсын! Олай болса!
Dialogue: 0,0:18:18.39,0:18:20.73,Default,,0,0,0,,Сен істедің, Широко-сенпай.
Dialogue: 0,0:18:20.73,0:18:22.90,Default,,0,0,0,,Жаман Аяне! Ах!
Dialogue: 0,0:18:25.27,0:18:27.80,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:27.80,0:18:31.04,Default,,0,0,0,,Ахахаха... Аяғыңызды ұрлап алдым!
Dialogue: 0,0:18:31.04,0:18:33.74,Default,,0,0,0,,Бұлай қашуға да, жасыруға да болмайды!
Dialogue: 0,0:18:33.74,0:18:38.21,Default,,0,0,0,,Амансыз ба, сэр? ? А, бұл пайдалы болды.
Dialogue: 0,0:18:38.21,0:18:40.21,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:18:47.89,0:18:49.89,Default,,0,0,0,,Гвуууух!
Dialogue: 0,0:18:54.80,0:19:00.00,Default,,0,0,0,,Нахахахаха... Ондай оқ бұл сауыттан қозғалмайды!
Dialogue: 0,0:19:00.00,0:19:01.94,Default,,0,0,0,,Бұл мен ойлағаннан да қорқынышты. 📱(Мұғалім) Барлығына➡
Dialogue: 0,0:19:01.94,0:19:08.58,Default,,0,0,0,,Менің бір ұсынысым бар. Жасырынба, шық!
Dialogue: 0,0:19:08.58,0:19:10.91,Default,,0,0,0,,Бұл менің ұсыныстарым.
Dialogue: 0,0:19:10.91,0:19:12.91,Default,,0,0,0,,📱 (Мұғалім) Сіз қалай ойлайсыз? Барлығы.
Dialogue: 0,0:19:12.91,0:19:15.28,Default,,0,0,0,,Иә. Менің ойымша, бұл жақсы.
Dialogue: 0,0:19:15.28,0:19:17.59,Default,,0,0,0,,Иә, әрі қарай жүрейік.
Dialogue: 0,0:19:17.59,0:19:19.55,Default,,0,0,0,,📱Қолдауыңызды бізге қалдырыңыз!
Dialogue: 0,0:19:19.55,0:19:22.56,Default,,0,0,0,,Мен мұны сұрадым, Селика-чан.
Dialogue: 0,0:19:22.56,0:19:25.89,Default,,0,0,0,,Иә, мен жасап көремін!
Dialogue: 0,0:19:25.89,0:19:31.27,Default,,0,0,0,,Дайын. Әрекет етуді бастаңыз!
Dialogue: 0,0:19:31.27,0:19:33.57,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:19:33.57,0:19:36.74,Default,,0,0,0,,Қанша қашсаң да, пайдасы жоқ!
Dialogue: 0,0:19:36.74,0:19:40.24,Default,,0,0,0,,Аяна Қазір уақыт келді! түсіндім!
Dialogue: 0,0:19:42.74,0:19:46.18,Default,,0,0,0,,Хахахаха... қалдық қалдықтар!
Dialogue: 0,0:19:46.18,0:19:48.58,Default,,0,0,0,,Бас тарту және берілу уақыты келді!
Dialogue: 0,0:19:48.58,0:20:04.23,Default,,0,0,0,,♬～
Dialogue: 0,0:20:04.23,0:20:06.27,Default,,0,0,0,,Тег ойыны аяқталды ма?
Dialogue: 0,0:20:06.27,0:20:13.91,Default,,0,0,0,,Ойлану! (күлкі)
Dialogue: 0,0:20:13.91,0:20:16.81,Default,,0,0,0,,１０… ９… ８➡
Dialogue: 0,0:20:16.81,0:20:19.75,Default,,0,0,0,,７… ６… ５➡
Dialogue: 0,0:20:19.75,0:20:22.75,Default,,0,0,0,,４… ３… ２➡
Dialogue: 0,0:20:22.75,0:20:25.42,Default,,0,0,0,,1…. Енді Селика!
Dialogue: 0,0:20:33.56,0:20:35.63,Default,,0,0,0,,Иә? Өтірік! ?
Dialogue: 0,0:20:42.07,0:20:44.57,Default,,0,0,0,,Шығу!
Dialogue: 0,0:20:44.57,0:20:49.08,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:20:49.08,0:20:53.38,Default,,0,0,0,,Хмф! Сіз мені ұрлағаныңызға өкінуіңіз керек!
Dialogue: 0,0:20:55.88,0:20:58.89,Default,,0,0,0,,Жақсы, менің ойымша, бұл қандай да бір жолмен жүзеге асады.
Dialogue: 0,0:20:58.89,0:21:03.39,Default,,0,0,0,,Барлығына жақсы жұмыс. Ұстазға еңбегіңіз үшін рахмет.
Dialogue: 0,0:21:03.39,0:21:06.59,Default,,0,0,0,,Міне, біздің мұғалім керемет.
Dialogue: 0,0:21:06.59,0:21:10.10,Default,,0,0,0,,О, жоқ хахаха…. Бұл орындайтынына сенімдімін➡
Dialogue: 0,0:21:10.10,0:21:14.07,Default,,0,0,0,,Дулыға бригадасы да жазаланған болуы керек. Хмм... Дұрыс.
Dialogue: 0,0:21:18.74,0:21:20.74,Default,,0,0,0,,Селика Рахмет.
Dialogue: 0,0:21:20.74,0:21:24.75,Default,,0,0,0,,Е, у, у... шу!
Dialogue: 0,0:21:24.75,0:21:27.88,Default,,0,0,0,,Ешбір көмексіз өз күшіммен қашып құтылдым➡
Dialogue: 0,0:21:27.88,0:21:31.05,Default,,0,0,0,,Мен Дулыға командасының жалғыз мүшесімін...
Dialogue: 0,0:21:31.05,0:21:34.76,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:34.76,0:21:38.39,Default,,0,0,0,,Маған көмектескеніңіз үшін рахмет➡
Dialogue: 0,0:21:38.39,0:21:41.90,Default,,0,0,0,,Рахмет, сэр.
Dialogue: 0,0:21:41.90,0:21:45.30,Default,,0,0,0,,Иә. О, Селика-чан жынды.
Dialogue: 0,0:21:45.30,0:21:48.30,Default,,0,0,0,,Жоқ, жоқ! Шынымен бе?
Dialogue: 0,0:21:48.30,0:21:52.41,Default,,0,0,0,,Бұл емес! Мен енді шыншыл емеспін.
Dialogue: 0,0:21:52.41,0:21:56.11,Default,,0,0,0,,Бірақ мен сені сол үшін де жақсы көремін. Уф….
Dialogue: 0,0:23:26.10,0:23:29.40,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:23:35.24,0:23:38.41,Default,,0,0,0,,Те... Темее, сен кімсің?
Dialogue: 0,0:23:38.41,0:23:41.82,Default,,0,0,0,,Біз шеберміз68.
Dialogue: 0,0:23:41.82,0:23:45.39,Default,,0,0,0,,Мен ақша алғанша бәрін істеймін.
Dialogue: 0,0:23:45.39,0:23:47.69,Default,,0,0,0,,Барлық сауда-саттықтың ұясы.
Dialogue: 0,0:23:49.19,0:23:55.19,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
