Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.16,0:01:09.16,Default,,0,0,0,,Енді саған болашақтың кілтін беруім керек.
Dialogue: 0,0:01:09.16,0:01:11.20,Default,,0,0,0,,Бір сәт жеткілікті
Dialogue: 0,0:01:11.20,0:01:14.82,Default,,0,0,0,,Оян, Куроно Доран!
Dialogue: 0,0:01:14.82,0:01:17.52,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:01:17.52,0:01:27.21,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:27.21,0:01:31.21,Default,,0,0,0,,《Болашақты түсін... Хроно...》
Dialogue: 0,0:01:40.24,0:01:43.24,Default,,0,0,0,,Бұл менің алға бара алатынымды білдіре ме?
Dialogue: 0,0:01:52.52,0:01:55.12,Default,,0,0,0,,ｸﾛﾉ･ﾄﾞﾗﾝ！
Dialogue: 0,0:02:01.88,0:02:03.83,Default,,0,0,0,,Мен қайтып келдім!
Dialogue: 0,0:02:03.83,0:02:08.82,Default,,0,0,0,,Түсінемін, Хроно Доран қайтып келді, сондықтан балалар да қайтып келдіңіздер.
Dialogue: 0,0:02:08.82,0:02:11.72,Default,,0,0,0,,Балалар сендермен біз ешқашан жеңілмейміз
Dialogue: 0,0:02:11.72,0:02:14.02,Default,,0,0,0,,Күте тұрыңыз, Льюз.
Dialogue: 0,0:02:16.24,0:02:19.34,Default,,0,0,0,,Бірақ неге...
Dialogue: 0,0:02:21.35,0:02:24.57,Default,,0,0,0,,Мен оны... деп ойламадым.
Dialogue: 0,0:02:24.57,0:02:35.17,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:04.59,0:06:06.59,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:10.16,0:06:13.75,Default,,0,0,0,,Төрешінің жекпе-жегінен адым күшінің асып түсуі➡
Dialogue: 0,0:06:13.75,0:06:16.85,Default,,0,0,0,,Сіз бізді бейнелер әлемінен шындыққа қайтардыңыз.
Dialogue: 0,0:06:27.68,0:06:29.68,Default,,0,0,0,,ｸﾛﾉ…
Dialogue: 0,0:06:47.35,0:06:49.92,Default,,0,0,0,,《Бәрі не болып жатыр?
Dialogue: 0,0:06:49.92,0:06:52.82,Default,,0,0,0,,Сот шешімі басталып кетті ме?
Dialogue: 0,0:06:52.82,0:06:56.37,Default,,0,0,0,,Біткеніне сене алар емеспін...
Dialogue: 0,0:06:56.37,0:07:00.87,Default,,0,0,0,,Қарғыс атсын, бәрі біткенше ештеңе түсінбейсің! 》
Dialogue: 0,0:07:03.66,0:07:05.87,Default,,0,0,0,,Ибуки!
Dialogue: 0,0:07:05.87,0:07:09.37,Default,,0,0,0,,Ибуки! Ибуки Сәлем! Неге...
Dialogue: 0,0:07:15.86,0:07:18.00,Default,,0,0,0,,Эй, эй! Кәне!
Dialogue: 0,0:07:18.00,0:07:20.83,Default,,0,0,0,,Мықты бол, эй!!
Dialogue: 0,0:07:20.83,0:07:23.38,Default,,0,0,0,,(енеді)
Dialogue: 0,0:07:23.38,0:07:26.74,Default,,0,0,0,,Ибуки Сіз мені естисіз бе? Ибуки!
Dialogue: 0,0:07:26.74,0:07:30.26,Default,,0,0,0,,ｸﾛﾉ…
Dialogue: 0,0:07:30.26,0:07:34.36,Default,,0,0,0,,А, бұл менмін. Неге сен... неге!?
Dialogue: 0,0:07:37.01,0:07:40.18,Default,,0,0,0,,Айдаһар бар ма?
Dialogue: 0,0:07:40.18,0:07:43.02,Default,,0,0,0,,О... Мен келдім.
Dialogue: 0,0:07:43.02,0:07:45.32,Default,,0,0,0,,Мен жаңа ғана оралдым.
Dialogue: 0,0:07:45.32,0:07:48.16,Default,,0,0,0,,Chrono Джет және келесі кезең, барлығы
Dialogue: 0,0:07:48.16,0:07:52.23,Default,,0,0,0,,Түсінемін, бұл жақсы...
Dialogue: 0,0:07:52.23,0:07:57.43,Default,,0,0,0,,Жоқ, сіз осы үшін келдіңіз!?
Dialogue: 0,0:07:57.43,0:08:00.53,Default,,0,0,0,,Неге! Неліктен бұлай болды?
Dialogue: 0,0:08:02.51,0:08:04.49,Default,,0,0,0,,Бару...
Dialogue: 0,0:08:04.49,0:08:09.13,Default,,0,0,0,,Мен өз болашағымды саған сеніп тапсырамын...
Dialogue: 0,0:08:09.13,0:08:13.63,Default,,0,0,0,,Жүр! Хроно...
Dialogue: 0,0:08:18.81,0:08:22.61,Default,,0,0,0,,Күте тұрыңыз, мен оны бірден аяқтаймын.
Dialogue: 0,0:08:54.17,0:09:00.97,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:09:06.84,0:09:13.01,Default,,0,0,0,,Зодиак уақытының жануары сізге басынан бастап оралды ма?
Dialogue: 0,0:09:13.01,0:09:18.02,Default,,0,0,0,,Маған бәрібір. Миджин Роуз...
Dialogue: 0,0:09:18.02,0:09:22.84,Default,,0,0,0,,Менің өмірім кетсе де, мен сені тоқтатамын!
Dialogue: 0,0:09:22.84,0:09:28.83,Default,,0,0,0,,Егер қаласаңыз, мен де өз өмірімді қатерге тігемін.
Dialogue: 0,0:09:28.83,0:09:32.03,Default,,0,0,0,,Тілегімді орындау үшін...
Dialogue: 0,0:09:32.03,0:09:38.00,Default,,0,0,0,,Сен екеуміздің арамыздағы төбелестің нәтижесі болашақта бәрін анықтайды!
Dialogue: 0,0:09:38.00,0:09:45.08,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:45.08,0:09:48.03,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:09:48.03,0:09:52.92,Default,,0,0,0,,Біз есікті ашып, кемел келешек құрдық➡
Dialogue: 0,0:09:52.92,0:09:56.70,Default,,0,0,0,,Бұл дүниеге келген
Dialogue: 0,0:09:56.70,0:09:59.67,Default,,0,0,0,,Осы ағымдағы жағдайды мәңгілік етіңіз➡
Dialogue: 0,0:09:59.67,0:10:05.70,Default,,0,0,0,,Ғаламның шындығын мойындау үшін бір ғана жеңіс жеткілікті.
Dialogue: 0,0:10:05.70,0:10:11.99,Default,,0,0,0,,Авангард шындыққа жетелейді. Біздің әлем және Крей планетасы➡
Dialogue: 0,0:10:11.99,0:10:17.67,Default,,0,0,0,,Әр қағазда екі дүниенің тағдыры жазылған.
Dialogue: 0,0:10:17.67,0:10:22.86,Default,,0,0,0,,Күрестің нәтижесі әлемнің болашағын шайқап, болашақты қайта жазады➡
Dialogue: 0,0:10:22.86,0:10:27.48,Default,,0,0,0,,Біз сол бейнемен жаңа әлем жасаймыз...
Dialogue: 0,0:10:27.48,0:10:32.16,Default,,0,0,0,,Бұл Авангардтың осы әлемде туылуының шынайы мағынасы.
Dialogue: 0,0:10:32.16,0:10:36.59,Default,,0,0,0,,Болашақты ұрыс түрінде ашатын күш➡
Dialogue: 0,0:10:36.59,0:10:39.18,Default,,0,0,0,,Не заттайды
Dialogue: 0,0:10:39.18,0:10:45.18,Default,,0,0,0,,Ал енді біздің күресіміз болашақты жаңа көкжиектерге жетелейді.
Dialogue: 0,0:10:47.99,0:10:50.67,Default,,0,0,0,,Мен болашағымызды қорғаймын!
Dialogue: 0,0:10:50.67,0:10:55.11,Default,,0,0,0,,Осы уақытқа дейін бізді қолдағандардың барлығын еске аламыз!
Dialogue: 0,0:10:55.11,0:10:57.48,Default,,0,0,0,,Мен саған қалағаныңды істеуге рұқсат бермеймін!!
Dialogue: 0,0:10:57.48,0:11:03.59,Default,,0,0,0,,Боу?
Dialogue: 0,0:11:03.59,0:11:08.39,Default,,0,0,0,,Бұл нағыз ақырғы сот
Dialogue: 0,0:11:10.34,0:11:12.81,Default,,0,0,0,,Кемелді болашақ үшін
Dialogue: 0,0:11:12.81,0:11:15.88,Default,,0,0,0,,Болашақты біз таңдаймыз!
Dialogue: 0,0:11:15.88,0:11:19.18,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:13:00.55,0:13:05.05,Default,,0,0,0,,ｸﾛﾉ･ﾄﾞﾗﾝ！ (ﾘｭｰｽﾞ)ｸﾛﾉ･ﾃｨｶﾞｰ
Dialogue: 0,0:13:07.49,0:13:09.53,Default,,0,0,0,,ｸﾛﾉ･ﾄﾞﾗﾝ！
Dialogue: 0,0:13:09.53,0:13:12.08,Default,,0,0,0,,Амигоның қолына оралды ма?
Dialogue: 0,0:13:12.08,0:13:16.68,Default,,0,0,0,,Сонымен, Амигостың соңғы шайқасы басталды.
Dialogue: 0,0:13:18.69,0:13:20.84,Default,,0,0,0,,ｸﾛﾉ！
Dialogue: 0,0:13:20.84,0:13:24.56,Default,,0,0,0,,ﾗｲﾄﾞ！ ﾀｲﾑﾌﾞﾚｲｸ･ﾄﾞﾗｺﾞﾝ!!
Dialogue: 0,0:13:24.56,0:13:29.16,Default,,0,0,0,,ﾗｲﾄﾞ｡ ﾎﾞﾙﾀｰﾛ･ｲﾃﾞｱﾄﾞﾛｰﾝ ｱﾀｯｸ！
Dialogue: 0,0:13:31.17,0:13:34.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:34.20,0:13:37.16,Default,,0,0,0,,Ах...｡ Хэхехе
Dialogue: 0,0:13:37.16,0:13:44.00,Default,,0,0,0,,Бұл Крей планетасының әлемі және біздің әлем. Екі кеңістік-уақыт араласатын кеңістік...
Dialogue: 0,0:13:44.00,0:13:49.65,Default,,0,0,0,,Сонымен қатар, Зодиак уақыты құбыжығы шындыққа енді.
Dialogue: 0,0:13:49.65,0:13:52.69,Default,,0,0,0,,Бұл шайқас табиғи➡
Dialogue: 0,0:13:52.69,0:13:55.69,Default,,0,0,0,,бізге де әсер етеді
Dialogue: 0,0:13:57.66,0:13:59.65,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:13:59.65,0:14:02.87,Default,,0,0,0,,ﾗｲﾄﾞ！ ﾋｽﾄﾘｰﾒｰｶｰ･ﾄﾞﾗｺﾞﾝ!!
Dialogue: 0,0:14:02.87,0:14:06.85,Default,,0,0,0,,Жылжыту Chrono Dran Хабарды шақырыңыз!
Dialogue: 0,0:14:06.85,0:14:11.65,Default,,0,0,0,,History Maker көмегімен Авангардқа шабуыл жасаңыз! (Re) Күзетші
Dialogue: 0,0:14:15.21,0:14:18.18,Default,,0,0,0,,ｸﾛﾉ･ﾄﾞﾗﾝ！
Dialogue: 0,0:14:18.18,0:14:21.17,Default,,0,0,0,,Құт
Dialogue: 0,0:14:21.17,0:14:23.82,Default,,0,0,0,,Неліктен алысқа бардың➡
Dialogue: 0,0:14:23.82,0:14:27.84,Default,,0,0,0,,Менің саған берген болашақтан бас тартасың деп ойлаймын.
Dialogue: 0,0:14:27.84,0:14:31.53,Default,,0,0,0,,Сенің әкең де солай болды.
Dialogue: 0,0:14:31.53,0:14:34.90,Default,,0,0,0,,ﾗｲﾄﾞ ｹﾙｺﾞﾒｲ･ｲﾃﾞｱﾄﾞﾛｰﾝ
Dialogue: 0,0:14:34.90,0:14:39.50,Default,,0,0,0,,Жолбарысты жылжытыңыз, алитиноза жаялығын шақырыңыз
Dialogue: 0,0:14:39.50,0:14:41.49,Default,,0,0,0,,Жаялықпен шабуыл
Dialogue: 0,0:14:41.49,0:14:44.34,Default,,0,0,0,,Оның әкеме қатысы жоқ!
Dialogue: 0,0:14:44.34,0:14:48.71,Default,,0,0,0,,Бұл менің өз еркім!
Dialogue: 0,0:14:48.71,0:14:52.83,Default,,0,0,0,,Крей планетасы есебінен біз ғана қалайтын әлемде➡
Dialogue: 0,0:14:52.83,0:14:55.17,Default,,0,0,0,,Бақытты бол...
Dialogue: 0,0:14:55.17,0:14:58.16,Default,,0,0,0,,Мен мұны қабылдай алмаймын!
Dialogue: 0,0:14:58.16,0:15:02.59,Default,,0,0,0,,Кельгомеймен бірге Авангардқа шабуыл жасаңыз
Dialogue: 0,0:15:02.59,0:15:06.21,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:15:06.21,0:15:09.83,Default,,0,0,0,,Құрбан шалу?
Dialogue: 0,0:15:09.83,0:15:13.49,Default,,0,0,0,,Мен бұл туралы бұрын да айтқанмын.
Dialogue: 0,0:15:13.49,0:15:16.41,Default,,0,0,0,,Әлемді құтқарудың жолы бар➡
Dialogue: 0,0:15:16.41,0:15:20.21,Default,,0,0,0,,Егер сізде мұны істеуге күшіңіз болса...
Dialogue: 0,0:15:23.16,0:15:26.07,Default,,0,0,0,,Оны істемеу күнә
Dialogue: 0,0:15:26.07,0:15:30.50,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:15:30.50,0:15:33.17,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:15:33.17,0:15:37.01,Default,,0,0,0,,ｸﾛﾉｼﾞｪｯﾄ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:15:37.01,0:15:41.38,Default,,0,0,0,,ｺｰﾙ ﾃﾞｨﾚｲﾄﾞﾌﾞﾚｲｻﾞｰ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:15:41.38,0:15:47.70,Default,,0,0,0,,Менің ойымша, бұл қақпа әлемді құтқара алмайды.
Dialogue: 0,0:15:47.70,0:15:51.84,Default,,0,0,0,,Бұл жай ғана елес!
Dialogue: 0,0:15:51.84,0:15:57.00,Default,,0,0,0,,Chrono Джет көмегімен Авангардқа шабуыл жасаңыз! Бұл Ногард
Dialogue: 0,0:15:57.00,0:16:01.90,Default,,0,0,0,,Қос жетекті жылу триггері. 1 зақымдарды қалпына келтіреді
Dialogue: 0,0:16:01.90,0:16:04.50,Default,,0,0,0,,Су төгетін қуат
Dialogue: 0,0:16:04.50,0:16:07.87,Default,,0,0,0,,Сен бәрін шешіп, маған мәжбүрлейсің!
Dialogue: 0,0:16:07.87,0:16:11.47,Default,,0,0,0,,Бұл біз қалаған болашақ емес!
Dialogue: 0,0:16:15.50,0:16:21.71,Default,,0,0,0,,Балалар, сендерде кішкене түсініспеушілік бар.
Dialogue: 0,0:16:21.71,0:16:25.18,Default,,0,0,0,,Сізге Stride Gate ұсынған бейнелер әлемі➡
Dialogue: 0,0:16:25.18,0:16:29.48,Default,,0,0,0,,Бұл адамның жүрегінің түбінде іздегені.
Dialogue: 0,0:16:35.87,0:16:40.36,Default,,0,0,0,,Әрине, азап, азап, зорлық, т.б.➡
Dialogue: 0,0:16:40.36,0:16:42.66,Default,,0,0,0,,Барлығы алынып тасталды
Dialogue: 0,0:16:42.66,0:16:45.68,Default,,0,0,0,,Бірақ мен ешқашан қаламаған нәрсе➡
Dialogue: 0,0:16:45.68,0:16:48.18,Default,,0,0,0,,Мен саған ештеңе таңып жатқан жоқпын.
Dialogue: 0,0:16:51.32,0:16:53.50,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:16:53.50,0:16:57.16,Default,,0,0,0,,Бұны сенен кім сұрады!
Dialogue: 0,0:16:57.16,0:17:03.11,Default,,0,0,0,,Рұқсатсыз жүрегіме қара, Рұқсатсыз ауруды өшір!
Dialogue: 0,0:17:03.11,0:17:07.67,Default,,0,0,0,,Біздің қалағанымыз...
Dialogue: 0,0:17:07.67,0:17:13.41,Default,,0,0,0,,Бұл ауырмайтын дүние емес! Гуха!
Dialogue: 0,0:17:13.41,0:17:17.21,Default,,0,0,0,,Өзім үшін таңдап алған дүнием!
Dialogue: 0,0:17:20.93,0:17:24.35,Default,,0,0,0,,Ал, жақсы...
Dialogue: 0,0:17:24.35,0:17:28.71,Default,,0,0,0,,Мұндай сөздерді айту оңай.
