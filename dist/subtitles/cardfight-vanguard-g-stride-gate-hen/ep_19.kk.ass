Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:05.96,0:01:11.90,Default,,0,0,0,,Орындалды. Бұл жылдам, бірақ мен сіздің тапсырысыңызды орындадым деп ойладым.
Dialogue: 0,0:01:11.90,0:01:13.90,Default,,0,0,0,,Gears-да жинақталған➡
Dialogue: 0,0:01:13.90,0:01:16.99,Default,,0,0,0,,Shindo Chrono және Chrono Dran толқын ұзындығы деректерін шығарып алыңыз➡
Dialogue: 0,0:01:16.99,0:01:19.51,Default,,0,0,0,,Талданады
Dialogue: 0,0:01:19.51,0:01:21.44,Default,,0,0,0,,Құрылғы шығаратын толқын ұзындығы ➡
Dialogue: 0,0:01:21.44,0:01:24.85,Default,,0,0,0,,Цилиндр ішіндегі қадамдық зат арқылы кедергі...
Dialogue: 0,0:01:24.85,0:01:27.90,Default,,0,0,0,,Хроно Доранды бір сәт оятады
Dialogue: 0,0:01:27.90,0:01:30.83,Default,,0,0,0,,Бұл былайша айтқанда, ерекше оятқыш.
Dialogue: 0,0:01:30.83,0:01:36.63,Default,,0,0,0,,Жалғыз нәрсе - Зодиак уақытының құдіретін алу.
Dialogue: 0,0:04:55.22,0:04:57.44,Default,,0,0,0,,Мен мәселені шешемін.
Dialogue: 0,0:04:57.44,0:04:59.94,Default,,0,0,0,,Сіздің амбицияңыз осы жерде және қазір аяқталады.
Dialogue: 0,0:05:02.73,0:05:05.40,Default,,0,0,0,,Төреші ретінде таңдалмаған адам →
Dialogue: 0,0:05:05.40,0:05:08.95,Default,,0,0,0,,Мен сені мына жер бетінде тұрғаның үшін жазалаймын.
Dialogue: 0,0:05:08.95,0:05:12.76,Default,,0,0,0,,Жазасын алатын адам сенсің. Миджин Роуз
Dialogue: 0,0:05:12.76,0:05:15.56,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！ ｽﾀﾝﾄﾞｱｯﾌﾟ ｻﾞ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:05:18.16,0:05:20.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:20.08,0:05:23.22,Default,,0,0,0,,ﾈｵﾝﾒｻｲｱ
Dialogue: 0,0:05:23.22,0:05:25.22,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:05:25.22,0:05:27.42,Default,,0,0,0,,ﾎﾞﾙﾀｰﾛ･ｲﾃﾞｱﾄﾞﾛｰﾝ
Dialogue: 0,0:05:27.42,0:05:29.99,Default,,0,0,0,,Ішінде ұрыс басталып жатыр.
Dialogue: 0,0:05:29.99,0:05:31.99,Default,,0,0,0,,Бұл сурет пайда болады
Dialogue: 0,0:05:34.58,0:05:37.13,Default,,0,0,0,,Артында Луна бар...
Dialogue: 0,0:05:37.13,0:05:39.07,Default,,0,0,0,,Компания жігіттері де.
Dialogue: 0,0:05:39.07,0:05:42.40,Default,,0,0,0,,Мен осы уақытқа дейін болғанның бәріне нүкте қоямын.
Dialogue: 0,0:05:42.40,0:05:45.32,Default,,0,0,0,,Бар күшіммен жасаймын!
Dialogue: 0,0:05:45.32,0:05:48.92,Default,,0,0,0,,Мұнда міндетті түрде бірге оралайық!
Dialogue: 0,0:06:03.41,0:06:06.39,Default,,0,0,0,,Амал жоқ, ертеңгі күннің арқасы емес күнәһар➡
Dialogue: 0,0:06:06.39,0:06:08.91,Default,,0,0,0,,Мен оның бортқа мінетінін күтпедім.
Dialogue: 0,0:06:08.91,0:06:13.98,Default,,0,0,0,,Бұл жекпе-жекте Авангард сізді бағалайды.
Dialogue: 0,0:06:13.98,0:06:17.07,Default,,0,0,0,,ﾗｲﾄﾞ ｹﾙｺﾞﾒｲ･ｲﾃﾞｱﾄﾞﾛｰﾝ
Dialogue: 0,0:06:17.07,0:06:19.57,Default,,0,0,0,,ｱﾅｰｷｱ･ｲﾃﾞｱﾄﾞﾛｰﾝ
Dialogue: 0,0:06:19.57,0:06:22.46,Default,,0,0,0,,Diaperno Idea Drone-ге қоңырау шалыңыз
Dialogue: 0,0:06:22.46,0:06:24.91,Default,,0,0,0,,Жаялықпен шабуыл
Dialogue: 0,0:06:24.91,0:06:30.10,Default,,0,0,0,,Дағдыны белсендіру. Палубаның жоғарғы жағынан бір картаны байлаңыз
Dialogue: 0,0:06:30.10,0:06:33.02,Default,,0,0,0,,Пауэр Plus 2000. (Ибуки) Күзетші!
Dialogue: 0,0:06:33.02,0:06:35.02,Default,,0,0,0,,Кергомеймен шабуыл
Dialogue: 0,0:06:36.92,0:06:39.39,Default,,0,0,0,,ﾄﾞﾗｲﾌﾞﾁｪｯｸ ﾋｰﾙﾄﾘｶﾞｰ
Dialogue: 0,0:06:39.39,0:06:42.90,Default,,0,0,0,,Күш жаялыққа шабуыл жасайды
Dialogue: 0,0:06:42.90,0:06:44.93,Default,,0,0,0,,Жаялық шеберлігі
Dialogue: 0,0:06:44.93,0:06:47.58,Default,,0,0,0,,Палубаның жоғарғы жағынан бір картаны байлаңыз
Dialogue: 0,0:06:47.58,0:06:59.45,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:59.45,0:07:04.74,Default,,0,0,0,,Сіз мұны естідіңіз бе? Тағдырды ойға алған дыбыс
Dialogue: 0,0:07:04.74,0:07:10.12,Default,,0,0,0,,Нәтижесінде Пауэр Plus 2000 болады
Dialogue: 0,0:07:10.12,0:07:14.39,Default,,0,0,0,,Шабуыл сәтті болғандықтан, мен палубадан бір картаны тастадым.
Dialogue: 0,0:07:14.39,0:07:16.91,Default,,0,0,0,,Тағы бір картаны байлау
Dialogue: 0,0:07:16.91,0:07:22.27,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:22.27,0:07:26.17,Default,,0,0,0,,Сіз Зодиак уақытының жыртқышын тежеп, оның күшін алған кезде➡
Dialogue: 0,0:07:26.17,0:07:29.59,Default,,0,0,0,,Бұл жекпе-жекке де кемел келешек келеді.
Dialogue: 0,0:07:29.59,0:07:31.89,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:07:33.98,0:07:35.88,Default,,0,0,0,,《Жер бетінде не...?
Dialogue: 0,0:07:35.88,0:07:39.05,Default,,0,0,0,,Жоқ, не болғаны маңызды емес.
Dialogue: 0,0:07:39.05,0:07:42.92,Default,,0,0,0,,Мен өз миссиямды орындамайынша》
Dialogue: 0,0:07:42.92,0:07:45.03,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:07:45.03,0:07:46.91,Default,,0,0,0,,ｱﾛｰｻﾞﾙ･ﾒｻｲｱ
Dialogue: 0,0:07:46.91,0:07:49.90,Default,,0,0,0,,Гравитациялық ұңғыма жүргізуші әйелді шақырыңыз
Dialogue: 0,0:07:49.90,0:07:52.80,Default,,0,0,0,,Аллозалмен бірге Авангардқа шабуыл жасаңыз
Dialogue: 0,0:07:52.80,0:08:03.58,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:03.58,0:08:06.63,Default,,0,0,0,,Неге...
Dialogue: 0,0:08:06.63,0:08:10.17,Default,,0,0,0,,Сіз армандадыңыз ба? Неге...
Dialogue: 0,0:08:10.17,0:08:19.89,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:19.89,0:08:21.95,Default,,0,0,0,,Амиголардың осында екеніне сене алмаймын.
Dialogue: 0,0:08:21.95,0:08:25.23,Default,,0,0,0,,Ей, біз неге ұйықтап қалдық?
Dialogue: 0,0:08:25.23,0:08:27.78,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:08:27.78,0:08:29.74,Default,,0,0,0,,[ТЕЛ] (Камуи) Сәлем Мамору-сан
Dialogue: 0,0:08:29.74,0:08:31.74,Default,,0,0,0,,Камуи-кун, жақсысың ба?
Dialogue: 0,0:08:31.74,0:08:33.96,Default,,0,0,0,,[ТЕЛ] Иә, бірақ біз➡
Dialogue: 0,0:08:33.96,0:08:37.08,Default,,0,0,0,,Мен білмей жатып ұйықтап қалдым.
Dialogue: 0,0:08:37.08,0:08:39.11,Default,,0,0,0,,Біз де солай.
Dialogue: 0,0:08:39.11,0:08:42.58,Default,,0,0,0,,Осы уақытқа дейін ұйықтап жатқан сияқтымын.
Dialogue: 0,0:08:42.58,0:08:44.77,Default,,0,0,0,,[ТЕЛ] (Мамору) А, мүмкін➡
Dialogue: 0,0:08:44.77,0:08:47.77,Default,,0,0,0,,Мені оятқан сол жекпе-жектің әсері болды деп ойлаймын.
Dialogue: 0,0:08:51.58,0:08:55.23,Default,,0,0,0,,Дүниенің құтқарылғанына бірге куә болайық...
Dialogue: 0,0:08:55.23,0:08:57.23,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:08:57.23,0:08:59.90,Default,,0,0,0,,ｸﾛﾉﾌｧﾝｸﾞ･ﾀｲｶﾞｰ！
Dialogue: 0,0:08:59.90,0:09:02.65,Default,,0,0,0,,Хронофанг жолбарыстың шеберлігі
Dialogue: 0,0:09:02.65,0:09:05.15,Default,,0,0,0,,Қолыңызға бір картаны байлаңыз
Dialogue: 0,0:09:09.73,0:09:13.96,Default,,0,0,0,,Бір қарсыластың артқы күзетін палубаға жылжытыңыз
Dialogue: 0,0:09:13.96,0:09:15.90,Default,,0,0,0,,Хронофанг жолбарысы бар шабуыл
Dialogue: 0,0:09:15.90,0:09:23.24,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:23.24,0:09:25.29,Default,,0,0,0,,Жаялықпен шабуыл!
Dialogue: 0,0:09:25.29,0:09:29.25,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:29.25,0:09:33.98,Default,,0,0,0,,Қарғыс атсын, біз ештеңе істей алмаймыз!
Dialogue: 0,0:09:33.98,0:09:36.78,Default,,0,0,0,,ｱﾐｰｺﾞ！
Dialogue: 0,0:09:43.98,0:09:48.43,Default,,0,0,0,,ﾗｲﾄﾞ ｵﾙﾀｰｴｺﾞ･ﾒｻｲｱ
Dialogue: 0,0:09:48.43,0:09:52.35,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:09:52.35,0:09:56.91,Default,,0,0,0,,Жаратылыс Айдаһар Радиолет Мәсіх
Dialogue: 0,0:09:56.91,0:10:02.53,Default,,0,0,0,,Қадам дағдыларын құлыптау. Радиолеттегі қуат плюс 5000
Dialogue: 0,0:10:02.53,0:10:07.10,Default,,0,0,0,,Қоңырау шалыңыз! Тұтқындаушы Мәсіхпен шабуыл
Dialogue: 0,0:10:07.10,0:10:09.15,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:10:09.15,0:10:12.24,Default,,0,0,0,,Қамаушы Мәсіхтің шеберлігі
Dialogue: 0,0:10:12.24,0:10:16.79,Default,,0,0,0,,Радиолетпен Авангардқа шабуыл
Dialogue: 0,0:10:16.79,0:10:20.61,Default,,0,0,0,,Тұтқындаушы мен Неомессия құлпын ашыңыз
Dialogue: 0,0:10:20.61,0:10:23.08,Default,,0,0,0,,Омегалок жөргек және жолбарыс
Dialogue: 0,0:10:23.08,0:10:26.60,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ ﾋｰﾙﾄﾘｶﾞｰ
Dialogue: 0,0:10:26.60,0:10:32.41,Default,,0,0,0,,Қуат разрядтағышқа түседі. Тағы да шабуыл!
Dialogue: 0,0:10:32.41,0:10:34.71,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:10:37.83,0:10:42.57,Default,,0,0,0,,Құлыптау және құлыпты ашу арқылы жаңа қуат алыңыз
Dialogue: 0,0:10:42.57,0:10:44.96,Default,,0,0,0,,Мәсіхтің саны 18
Dialogue: 0,0:10:44.96,0:10:48.74,Default,,0,0,0,,Бірақ басқаларды босатуға қанша тырыссақ та➡
Dialogue: 0,0:10:48.74,0:10:53.25,Default,,0,0,0,,Сізді байлаған күнәлардан ешқашан құтылмайсыз.
Dialogue: 0,0:10:53.25,0:10:58.47,Default,,0,0,0,,Тіпті сен де кемел болашақта құтқарыласың.
Dialogue: 0,0:10:58.47,0:11:03.47,Default,,0,0,0,,Бұл осы мақсатқа арналған мисоги. Transcend!
Dialogue: 0,0:11:07.23,0:11:10.95,Default,,0,0,0,,ﾃﾞｳｽｴｸｽﾏｷﾅ ｴﾙｺﾞｽ
Dialogue: 0,0:11:10.95,0:11:13.40,Default,,0,0,0,,Anarchia Idea Drone Skills➡
Dialogue: 0,0:11:13.40,0:11:17.44,Default,,0,0,0,,Палубаның жоғарғы үш картасына қараңыз және біреуін қолыңызға қойыңыз➡
Dialogue: 0,0:11:17.44,0:11:21.24,Default,,0,0,0,,1 карта жанда 1 картаны байлау
Dialogue: 0,0:11:26.08,0:11:28.43,Default,,0,0,0,,Chronospin Жыланды шақырыңыз
Dialogue: 0,0:11:28.43,0:11:31.03,Default,,0,0,0,,Эргоспен шабуыл
Dialogue: 0,0:11:39.06,0:11:43.73,Default,,0,0,0,,Ергос шеберлігі Палубаның жоғарғы жағынан бір картаны байлаңыз
Dialogue: 0,0:11:43.73,0:11:48.22,Default,,0,0,0,,Содан кейін байланған бу тынысын қолыңызға қайтарыңыз➡
Dialogue: 0,0:11:48.22,0:11:50.72,Default,,0,0,0,,Одан әрі байланыстыру
Dialogue: 0,0:11:54.76,0:11:58.11,Default,,0,0,0,,Сәт сайын жақындап келеді
Dialogue: 0,0:11:58.11,0:12:01.08,Default,,0,0,0,,Сенің жазаң сол кезде келеді.
Dialogue: 0,0:12:01.08,0:12:04.28,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:12:04.28,0:12:09.56,Default,,0,0,0,,Жаза, мен үміттенемін.
Dialogue: 0,0:12:09.56,0:12:14.56,Default,,0,0,0,,《Баяғыда мен қайтарылмайтын күнә жасадым.
Dialogue: 0,0:12:14.56,0:12:19.57,Default,,0,0,0,,Барлығын жек көріп, Авангардты жоюға тырысты
Dialogue: 0,0:12:19.57,0:12:24.69,Default,,0,0,0,,Күнәларымның ауыртпалығын көтере алмай, дүниені кезіп жүргенімде➡
Dialogue: 0,0:12:24.69,0:12:32.61,Default,,0,0,0,,Shindo Live-пен кездесу, Авангардтың... Әлемдегі дағдарыс туралы білдік
Dialogue: 0,0:12:32.61,0:12:35.73,Default,,0,0,0,,Мен мұны тағдыр деп ойладым》
Dialogue: 0,0:12:35.73,0:12:39.65,Default,,0,0,0,,((Мен мұны істеймін! Мені тоқтатсаңыз да жасаймын)
Dialogue: 0,0:12:39.65,0:12:44.15,Default,,0,0,0,,Мен мұны істеуім керек! ))
Dialogue: 0,0:12:46.76,0:12:51.40,Default,,0,0,0,,《Ибуки: Авангард оны маған күнәларымды өтеу үшін берді➡
Dialogue: 0,0:12:51.40,0:12:53.95,Default,,0,0,0,,Құқық бұзушылық жасау мүмкіндігі
Dialogue: 0,0:12:53.95,0:12:59.74,Default,,0,0,0,,Gear Chronic Бұл менің тағдырым
Dialogue: 0,0:12:59.74,0:13:03.28,Default,,0,0,0,,Маған берілген тапсырманың бәрі➡
Dialogue: 0,0:13:03.28,0:13:08.73,Default,,0,0,0,,Өзіңе айналатын баланы бақылаңыз, тәрбиелеңіз және бағыттаңыз.
Dialogue: 0,0:13:08.73,0:13:13.92,Default,,0,0,0,,Бірақ біріншіден, егер бұл жігіт оны пайдалана алмаса, мен оған жасай аламын.
Dialogue: 0,0:13:13.92,0:13:16.39,Default,,0,0,0,,Шынымды айтсам, мен солай ойладым.
Dialogue: 0,0:13:16.39,0:13:21.23,Default,,0,0,0,,Жүрегімді жауып, жалғызбын деп ойлайтын арқам➡
