Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.77,0:01:05.81,Default,,0,0,0,,((ﾀﾞﾒｰｼﾞﾁｪｯｸ！
Dialogue: 0,0:01:05.81,0:01:07.75,Default,,0,0,0,,Ах, мен тағы да жеңілдім.
Dialogue: 0,0:01:07.75,0:01:10.63,Default,,0,0,0,,Сатору-кун, сен күшті болып кеттің.
Dialogue: 0,0:01:10.63,0:01:13.73,Default,,0,0,0,,Мен енді оны жеңе алмаймын
Dialogue: 0,0:01:13.73,0:01:15.79,Default,,0,0,0,,Сәлем➡
Dialogue: 0,0:01:15.79,0:01:19.67,Default,,0,0,0,,Осы картаның дағдыларын қалай тиімді пайдалана аламын?
Dialogue: 0,0:01:19.67,0:01:22.17,Default,,0,0,0,,Ең алдымен...
Dialogue: 0,0:01:34.51,0:01:36.51,Default,,0,0,0,,ｸｯ…))
Dialogue: 0,0:01:42.63,0:01:47.43,Default,,0,0,0,,Мен сені бұл жолы міндетті түрде қорғаймын
Dialogue: 0,0:05:02.45,0:05:05.95,Default,,0,0,0,,Вакамизу мырза маған хабарласты.
Dialogue: 0,0:05:05.95,0:05:09.14,Default,,0,0,0,,Stride Force жинағы аяқталуға жақын сияқты.
Dialogue: 0,0:05:09.14,0:05:11.09,Default,,0,0,0,,Иә
Dialogue: 0,0:05:11.09,0:05:15.91,Default,,0,0,0,,Біз Тәуелді картаны қалпына келтірдік, ал Бейбітшілік жасаушы біздің қолымызда.
Dialogue: 0,0:05:15.91,0:05:18.91,Default,,0,0,0,,Жақында бөлімшенің соңғы шақыруы өтеді➡
Dialogue: 0,0:05:18.91,0:05:22.92,Default,,0,0,0,,Жоба ақыры соңғы кезеңге өтуде.
Dialogue: 0,0:05:22.92,0:05:26.92,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:05:28.79,0:05:30.82,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:05:30.82,0:05:33.12,Default,,0,0,0,,Қысқа серуендеуге арналған
Dialogue: 0,0:05:44.59,0:05:47.32,Default,,0,0,0,,《Жоба соңғы кезеңге жеткенде➡
Dialogue: 0,0:05:47.32,0:05:49.32,Default,,0,0,0,,Луна қазірдің өзінде...》
Dialogue: 0,0:05:52.95,0:05:56.45,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:05:56.45,0:05:58.47,Default,,0,0,0,,ﾙｰﾅ…
Dialogue: 0,0:05:58.47,0:06:02.26,Default,,0,0,0,,Күте тұрыңыз, мен сізді бірден алып кетемін.
Dialogue: 0,0:06:02.26,0:06:05.46,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:06:05.46,0:06:07.46,Default,,0,0,0,,Цзянси…
Dialogue: 0,0:06:07.46,0:06:09.45,Default,,0,0,0,,Мен оған қол тигізуге рұқсат бермеймін
Dialogue: 0,0:06:09.45,0:06:13.78,Default,,0,0,0,,Луна - Stride Gate жоспарының маңызды бөлігі.
Dialogue: 0,0:06:13.78,0:06:16.42,Default,,0,0,0,,Егер мен тыныштық орнататын қызымнан айырылсам➡
Dialogue: 0,0:06:16.42,0:06:20.84,Default,,0,0,0,,Біздің мұраттарымыз ешқашан орындалмайды.
Dialogue: 0,0:06:20.84,0:06:23.13,Default,,0,0,0,,Сіздің де тілектеріңіз
Dialogue: 0,0:06:23.13,0:06:28.03,Default,,0,0,0,,Сонда да мен Лунаға көмектесуді шештім.
Dialogue: 0,0:06:28.03,0:06:33.29,Default,,0,0,0,,Біздің мұратымызға кедергі болған кез келген адамды жоямын.
Dialogue: 0,0:06:33.29,0:06:37.21,Default,,0,0,0,,Әрине, сіз де ерекше емессіз.
Dialogue: 0,0:06:37.21,0:06:39.13,Default,,0,0,0,,Олай болса➡
Dialogue: 0,0:06:39.13,0:06:43.60,Default,,0,0,0,,Сіз және мен: Әлемді басқаратын шындықты кім ұстайды➡
Dialogue: 0,0:06:43.60,0:06:45.78,Default,,0,0,0,,Сотқа барайық
Dialogue: 0,0:06:45.78,0:06:49.92,Default,,0,0,0,,Бұл жерде солай емес пе?
Dialogue: 0,0:06:49.92,0:06:51.96,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:51.96,0:06:54.61,Default,,0,0,0,,Мен жеңсем, Лунаны босат.
Dialogue: 0,0:06:54.61,0:06:57.53,Default,,0,0,0,,Егер жоғалтсаңыз ше?
Dialogue: 0,0:06:57.53,0:07:01.13,Default,,0,0,0,,Сіз бәрін өз қалауыңызша жасай аласыз.
Dialogue: 0,0:07:09.07,0:07:11.76,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:07:11.76,0:07:14.96,Default,,0,0,0,,Өлмеген өлі Грунасшу!
Dialogue: 0,0:07:14.96,0:07:18.48,Default,,0,0,0,,ｴﾆｸﾞﾏﾃｨｯｸ･ｱｻｼﾝ ﾗｲﾄﾞ
Dialogue: 0,0:07:18.48,0:07:20.75,Default,,0,0,0,,ｴｯｼﾞ･ｲﾝ･ｻﾞ･ﾀﾞｰｸﾈｽ
Dialogue: 0,0:07:20.75,0:07:22.97,Default,,0,0,0,,ﾗｲﾄﾞ！ ﾊﾟｰﾃｨﾝｸﾞ･ｼｪｲﾄﾞ
Dialogue: 0,0:07:22.97,0:07:25.42,Default,,0,0,0,,Пионер ретінде Грунашқа көшіңіз
Dialogue: 0,0:07:25.42,0:07:27.46,Default,,0,0,0,,Елес Томи бауырларына қоңырау шалыңыз!
Dialogue: 0,0:07:27.46,0:07:29.48,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:07:29.48,0:07:31.76,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:07:31.76,0:07:35.62,Default,,0,0,0,,Қоштасу көлеңкесі бар шабуыл!
Dialogue: 0,0:07:35.62,0:07:37.68,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:07:37.68,0:07:39.62,Default,,0,0,0,,ﾃﾞﾓﾝﾃｯﾄﾞｴｸｾｷｭｰｼｮﾅｰ
Dialogue: 0,0:07:39.62,0:07:41.59,Default,,0,0,0,,Қосымша қоңырау
Dialogue: 0,0:07:41.59,0:07:43.62,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:07:43.62,0:07:45.59,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:07:45.59,0:07:48.63,Default,,0,0,0,,Артқы күзетшімен шабуыл
Dialogue: 0,0:07:48.63,0:07:51.15,Default,,0,0,0,,Уф... Жүр!
Dialogue: 0,0:07:51.15,0:07:53.92,Default,,0,0,0,,Қарақшы семсерші Коламбар!
Dialogue: 0,0:07:53.92,0:07:55.92,Default,,0,0,0,,Дөңес теңіздің баншиін шақыр!
Dialogue: 0,0:07:55.92,0:07:58.27,Default,,0,0,0,,Баншиді шеберлікпен Сеулге апарыңыз
Dialogue: 0,0:07:58.27,0:08:00.62,Default,,0,0,0,,1 карта ұтысы
Dialogue: 0,0:08:00.62,0:08:02.98,Default,,0,0,0,,Move Tomy Bros.
Dialogue: 0,0:08:02.98,0:08:05.51,Default,,0,0,0,,Rambling Shade шақырыңыз!
Dialogue: 0,0:08:05.51,0:08:08.67,Default,,0,0,0,,Коламбардағы авангардқа шабуыл жасаңыз!
Dialogue: 0,0:08:08.67,0:08:10.77,Default,,0,0,0,,Рамблингпен шабуыл!
Dialogue: 0,0:08:15.34,0:08:20.44,Default,,0,0,0,,《Ам: Сол күні күшін пайдаланғаннан кейін Луна ұйықтап қалды...》
Dialogue: 0,0:08:23.36,0:08:25.78,Default,,0,0,0,,《Руна қазір ес-түссіз жатыр➡
Dialogue: 0,0:08:25.78,0:08:29.78,Default,,0,0,0,,Бұл қадам қақпасын ашатын құрал болды》
Dialogue: 0,0:08:32.44,0:08:34.44,Default,,0,0,0,,《Сол Луна...》
Dialogue: 0,0:08:40.10,0:08:42.10,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:08:42.10,0:08:44.13,Default,,0,0,0,,ｼｬﾙﾊﾛｰﾄ･ｳﾞｧﾝﾋﾟｰｱ
Dialogue: 0,0:08:44.13,0:08:46.07,Default,,0,0,0,,Глендейл Ван Пирге қоңырау шалыңыз
Dialogue: 0,0:08:46.07,0:08:48.10,Default,,0,0,0,,Берілген дағдылар
Dialogue: 0,0:08:48.10,0:08:50.07,Default,,0,0,0,,Палубаның жоғарғы бес картасын қараңыз➡
Dialogue: 0,0:08:50.07,0:08:52.94,Default,,0,0,0,,Даркнесс➡ көмегімен қалағаныңызша карталарды таңдаңыз
Dialogue: 0,0:08:52.94,0:08:54.96,Default,,0,0,0,,Жандағы орын
Dialogue: 0,0:08:54.96,0:08:57.36,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000
Dialogue: 0,0:08:57.36,0:08:59.25,Default,,0,0,0,,Бір көзді суккубусты шақырыңыз
Dialogue: 0,0:08:59.25,0:09:01.75,Default,,0,0,0,,Грентендегі Авангардқа шабуыл
Dialogue: 0,0:09:01.75,0:09:03.79,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:09:03.79,0:09:05.77,Default,,0,0,0,,Шалхаротпен шабуыл
Dialogue: 0,0:09:05.77,0:09:09.74,Default,,0,0,0,,Бір көзді суккубус шеберлігі Жанға салып, 1 картаны сал
Dialogue: 0,0:09:09.74,0:09:11.96,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ5000
Dialogue: 0,0:09:11.96,0:09:13.91,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:09:13.91,0:09:15.95,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:09:15.95,0:09:17.93,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:09:17.93,0:09:20.07,Default,,0,0,0,,Қуат көрсетіледі
Dialogue: 0,0:09:20.07,0:09:22.11,Default,,0,0,0,,Маңызды мәселелер үшін Шалхаротқа барыңыз
Dialogue: 0,0:09:22.11,0:09:24.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:24.09,0:09:26.09,Default,,0,0,0,,ﾃﾞﾓﾝﾃｯﾄﾞ！
Dialogue: 0,0:09:28.80,0:09:31.15,Default,,0,0,0,,ｹﾞｯﾄ ﾋｰﾙﾄﾘｶﾞｰ
Dialogue: 0,0:09:31.15,0:09:36.30,Default,,0,0,0,,Зақым толығымен біркелкі, 3-тен 3-ке дейін...
Dialogue: 0,0:09:36.30,0:09:38.80,Default,,0,0,0,,Бірақ бәрі осы.
Dialogue: 0,0:09:41.36,0:09:43.63,Default,,0,0,0,,Сіз ұмытпағаныңызға сенімдімін.
Dialogue: 0,0:09:43.63,0:09:46.00,Default,,0,0,0,,Мен де бітімгермін.
Dialogue: 0,0:09:46.00,0:09:48.77,Default,,0,0,0,,Оның күші сенікінен әлдеқайда жоғары!
Dialogue: 0,0:09:48.77,0:09:50.78,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:09:50.78,0:09:53.25,Default,,0,0,0,,Түнгі тұманның вампир ханшайымы түнгі раушан!
Dialogue: 0,0:09:53.25,0:09:56.46,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:09:56.46,0:09:59.64,Default,,0,0,0,,Дауыл шақыратын қарақшы патша Гаш!
Dialogue: 0,0:09:59.64,0:10:02.00,Default,,0,0,0,,Найтроздың қадам жасау шеберлігі
Dialogue: 0,0:10:02.00,0:10:04.78,Default,,0,0,0,,Құлау аймағының газ айдаһарын шақырыңыз
Dialogue: 0,0:10:04.78,0:10:07.45,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000
Dialogue: 0,0:10:07.45,0:10:09.62,Default,,0,0,0,,Шұңқырдағы айдаһар
Dialogue: 0,0:10:09.62,0:10:11.60,Default,,0,0,0,,Гаш шеберлігі іске қосылды!
Dialogue: 0,0:10:11.60,0:10:14.62,Default,,0,0,0,,Екі жанды құлау аймағына тастаңыз!
Dialogue: 0,0:10:14.62,0:10:18.78,Default,,0,0,0,,Және түсіру аймағынан бірдей бірлік санын шақырыңыз
Dialogue: 0,0:10:18.78,0:10:20.80,Default,,0,0,0,,Қуат плюс әрқайсысы 1000
Dialogue: 0,0:10:20.80,0:10:22.78,Default,,0,0,0,,Грунас шегінді
Dialogue: 0,0:10:22.78,0:10:26.75,Default,,0,0,0,,Лақтырсаң да қайта тірілесің, күшейесің.
Dialogue: 0,0:10:26.75,0:10:29.05,Default,,0,0,0,,Бұл үлкен көк!
Dialogue: 0,0:10:31.12,0:10:34.01,Default,,0,0,0,,Мен Лунаға міндетті түрде көмектесемін
Dialogue: 0,0:10:34.01,0:10:36.05,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:10:36.05,0:10:38.78,Default,,0,0,0,,Дағдыны белсендіру қуаты плюс 3000
Dialogue: 0,0:10:38.78,0:10:41.78,Default,,0,0,0,,Сонымен қатар, қуыс бойынша қуат плюс 5000
Dialogue: 0,0:10:43.97,0:10:46.84,Default,,0,0,0,,Лунаның күлкісін қайтарыңыз!
Dialogue: 0,0:10:46.84,0:10:49.38,Default,,0,0,0,,Авангардқа Гашпен шабуыл жасаңыз!
Dialogue: 0,0:10:49.38,0:10:51.63,Default,,0,0,0,,Rampage шеберлігін белсендіру
Dialogue: 0,0:10:51.63,0:10:53.58,Default,,0,0,0,,Сеулге бару
Dialogue: 0,0:10:53.58,0:10:55.58,Default,,0,0,0,,1 карта ұтысы
Dialogue: 0,0:10:55.58,0:10:57.93,Default,,0,0,0,,Гашқа қуат плюс 5000
Dialogue: 0,0:10:57.93,0:11:01.09,Default,,0,0,0,,Толық нұсқаулық. Көкек...
Dialogue: 0,0:11:01.09,0:11:03.41,Default,,0,0,0,,Rambling Shade көмегімен шабуыл!
Dialogue: 0,0:11:03.41,0:11:06.13,Default,,0,0,0,,Пауэр Plus 2000 дағдыларын белсендіру
Dialogue: 0,0:11:06.13,0:11:08.08,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:11:08.08,0:11:11.13,Default,,0,0,0,,Қарғыс атсын, тек 1 зиян?
Dialogue: 0,0:11:11.13,0:11:13.73,Default,,0,0,0,,Лунаға көмектес
Dialogue: 0,0:11:13.73,0:11:17.15,Default,,0,0,0,,Бұл болашаққа есікті жабу дегенді білдіреді.
Dialogue: 0,0:11:17.15,0:11:21.11,Default,,0,0,0,,Сіздің ата-анаңыз құтқарылмайды.
Dialogue: 0,0:11:21.11,0:11:24.11,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:11:29.78,0:11:33.45,Default,,0,0,0,,Ақылсыз сатқындарға қатаң жаза!
Dialogue: 0,0:11:33.45,0:11:36.09,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:11:36.09,0:11:40.46,Default,,0,0,0,,Жаңа қанды сатқын Фредерик
Dialogue: 0,0:11:40.46,0:11:44.13,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｿｳﾙﾁｬｰｼﾞ
Dialogue: 0,0:11:44.13,0:11:46.45,Default,,0,0,0,,Фредерик шабуыл жасағанда➡
Dialogue: 0,0:11:46.45,0:11:50.45,Default,,0,0,0,,Қарсылас өзінің артқы қорғаушыларының бірін таңдап, оны шығарып салады.
Dialogue: 0,0:11:50.45,0:11:53.76,Default,,0,0,0,,Өлшем Creeper Skill Soul Charge
Dialogue: 0,0:11:53.76,0:11:58.18,Default,,0,0,0,,Тағы да өлшем Creeper шеберлігі Жан заряды
Dialogue: 0,0:11:58.18,0:12:03.45,Default,,0,0,0,,Сонымен қатар, Фредериктің шеберлігі. Қолыңыздан бір картаны таңдап, оны жаныңызға салыңыз.
Dialogue: 0,0:12:03.45,0:12:07.45,Default,,0,0,0,,Қуат плюс 12000, барлығы 12 жан
Dialogue: 0,0:12:07.45,0:12:11.74,Default,,0,0,0,,Алдыңғы қатардың артқы қорғаушысы үшін Пауэр Plus 5000
Dialogue: 0,0:12:11.74,0:12:15.78,Default,,0,0,0,,Сонымен қатар, Demonted Даркнесс. Пауэр Plus 5000
Dialogue: 0,0:12:15.78,0:12:17.78,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:12:17.78,0:12:22.07,Default,,0,0,0,,Енді ата-анаңнан бас тартасың ба?
Dialogue: 0,0:12:22.07,0:12:27.11,Default,,0,0,0,,Кесу! Қалқан плюс шеберлігі бар 5000!
Dialogue: 0,0:12:27.11,0:12:31.43,Default,,0,0,0,,Фредерикпен бірге Авангардқа шабуыл. Дағдыны белсендіру.
Dialogue: 0,0:12:31.43,0:12:35.92,Default,,0,0,0,,Қарсылас өзінің артқы қорғаушыларының бірін таңдап, оны шығарып салады.
Dialogue: 0,0:12:35.92,0:12:37.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:44.52,0:12:46.79,Default,,0,0,0,,ｸｯ ﾉｰｶﾞｰﾄﾞ！
Dialogue: 0,0:12:46.79,0:12:51.76,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ｡ ｹﾞｯﾄ ｽﾀﾝﾄﾞﾄﾘｶﾞｰ
Dialogue: 0,0:12:51.76,0:12:55.14,Default,,0,0,0,,Пауэр Plus 5000 тірегі
Dialogue: 0,0:12:55.14,0:12:57.12,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:12:57.12,0:13:01.44,Default,,0,0,0,,ｻｰﾄﾞﾁｪｯｸ｡ ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:13:01.44,0:13:04.16,Default,,0,0,0,,Демонстранттар үшін қуат плюс 5000
Dialogue: 0,0:13:04.16,0:13:06.46,Default,,0,0,0,,Маңызды мәселелер бойынша Фредерикке хабарласыңыз
Dialogue: 0,0:13:08.47,0:13:12.50,Default,,0,0,0,,Тек ата-анама көмектесу үшін➡
Dialogue: 0,0:13:12.50,0:13:17.80,Default,,0,0,0,,Сіз бұл дүниеде бәріне қарсы күрескен жоқсыз ба?
Dialogue: 0,0:13:20.09,0:13:25.17,Default,,0,0,0,,Сіздің өміріңіз осылай өткен емес пе?
Dialogue: 0,0:13:25.17,0:13:27.17,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:13:29.20,0:13:34.09,Default,,0,0,0,,Зақым 5... Әлі екі тыл сақшысы бар...
Dialogue: 0,0:13:34.09,0:13:36.41,Default,,0,0,0,,Демонтпен шабуыл
Dialogue: 0,0:13:36.41,0:13:38.80,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:13:38.80,0:13:41.50,Default,,0,0,0,,Терең Корпус Айдаһары!
Dialogue: 0,0:13:41.50,0:13:44.50,Default,,0,0,0,,Грензентпен шабуыл. Күзетші!
Dialogue: 0,0:13:47.75,0:13:51.44,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:13:51.44,0:13:54.41,Default,,0,0,0,,Мен осылай өмір сүрдім
Dialogue: 0,0:13:54.41,0:13:58.46,Default,,0,0,0,,Мен не қажет болса, соны істедім. Мен ата-анама көмектескім келді.
Dialogue: 0,0:13:58.46,0:14:03.10,Default,,0,0,0,,Үмітсіздік жеп, тұр! Мен қазір осындамын!
Dialogue: 0,0:14:03.10,0:14:05.81,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:14:05.81,0:14:10.46,Default,,0,0,0,,Найроз, тұман қарақшы патша!
Dialogue: 0,0:14:10.46,0:14:12.80,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:14:12.80,0:14:15.47,Default,,0,0,0,,Құлау аймағының газ айдаһарына қоңырау шалыңыз!
Dialogue: 0,0:14:15.47,0:14:18.79,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000！ ﾎﾛｳ！
Dialogue: 0,0:14:18.79,0:14:22.41,Default,,0,0,0,,Содан кейін қолыңыздан Gast Dragon-ды шақырыңыз Hollow!
Dialogue: 0,0:14:22.41,0:14:24.81,Default,,0,0,0,,Томи бауырларына қоңырау шалыңыз!
Dialogue: 0,0:14:24.81,0:14:28.41,Default,,0,0,0,,Қазір де солай. Мен бұл екеуіне міндетті түрде көмектесемін.
Dialogue: 0,0:14:28.41,0:14:30.86,Default,,0,0,0,,Ешқашан берілме!
Dialogue: 0,0:14:30.86,0:14:33.43,Default,,0,0,0,,Дағды іске қосылды! Қуат плюс 3000!
Dialogue: 0,0:14:33.43,0:14:36.45,Default,,0,0,0,,Плюс 5000 қуыс күйде!
Dialogue: 0,0:14:36.45,0:14:38.52,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:14:38.52,0:14:42.43,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ｡ ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:14:42.43,0:14:45.08,Default,,0,0,0,,Шалхарот үшін қуат плюс 5000
Dialogue: 0,0:14:45.08,0:14:48.80,Default,,0,0,0,,Тұманды қарақшы король Найрозбен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:14:48.80,0:14:50.78,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:14:50.78,0:14:54.20,Default,,0,0,0,,Тамшы аймағына газ айдаһары мен Негробонды шақырыңыз!
Dialogue: 0,0:14:54.20,0:14:56.46,Default,,0,0,0,,Газ айдаһарын қуысқа айналдыр!
Dialogue: 0,0:14:56.46,0:14:58.49,Default,,0,0,0,,Бірақ мен түсіндім
Dialogue: 0,0:14:58.49,0:15:02.79,Default,,0,0,0,,Ол үшін Лунаны құрбан ету дұрыс емес!
Dialogue: 0,0:16:47.77,0:16:50.07,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,0:16:59.51,0:17:02.81,Default,,0,0,0,,Ах! Сіз... Сіз...
Dialogue: 0,0:17:05.08,0:17:07.79,Default,,0,0,0,,Күтіңіз... күтіңіз!? иә?
Dialogue: 0,0:17:07.79,0:17:10.76,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:17:10.76,0:17:14.09,Default,,0,0,0,,А, мен оны аламын.
Dialogue: 0,0:17:14.09,0:17:17.48,Default,,0,0,0,,Оның сізге пайдасы жоқ.
Dialogue: 0,0:17:17.48,0:17:20.78,Default,,0,0,0,,Не? сурет? Сол сияқты...
Dialogue: 0,0:17:23.45,0:17:25.84,Default,,0,0,0,,Бірақ мен түсіндім
Dialogue: 0,0:17:25.84,0:17:29.08,Default,,0,0,0,,Ата-анасын құтқару үшін Лунаны құрбан ету - ➡
Dialogue: 0,0:17:29.08,0:17:31.11,Default,,0,0,0,,Дұрыс емес!
Dialogue: 0,0:17:31.11,0:17:33.11,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:17:33.11,0:17:36.10,Default,,0,0,0,,Сен-Жермен, түннің көлеңкесіндегі джентльмен
Dialogue: 0,0:17:36.10,0:17:38.75,Default,,0,0,0,,Өйткені жанның 10 немесе одан да көп картасы бар➡
Dialogue: 0,0:17:38.75,0:17:40.80,Default,,0,0,0,,ｼｰﾙﾄﾞﾌﾟﾗｽ10000
Dialogue: 0,0:17:40.80,0:17:43.40,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:17:45.79,0:17:48.43,Default,,0,0,0,,ｸｿ！ ｻｰﾄﾞﾁｪｯｸ！
Dialogue: 0,0:17:48.43,0:17:50.46,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:17:50.46,0:17:53.43,Default,,0,0,0,,Барлық әсерлер Gast Dragon-да
Dialogue: 0,0:17:53.43,0:17:55.45,Default,,0,0,0,,《Бір ғана зақым қалды.
Dialogue: 0,0:17:55.45,0:17:58.42,Default,,0,0,0,,Қалған екі шабуылмен шешіңіз! 》
Dialogue: 0,0:17:58.42,0:18:01.12,Default,,0,0,0,,Қуат плюс 8000 шеберлікпен!
Dialogue: 0,0:18:01.12,0:18:04.79,Default,,0,0,0,,Бейбітшілік жасаушыға барлық үміткерлер, соның ішінде сіз➡
Dialogue: 0,0:18:04.79,0:18:07.75,Default,,0,0,0,,Дене өзгерді.
Dialogue: 0,0:18:07.75,0:18:11.10,Default,,0,0,0,,Тіпті Миджин руы да солай болды.
Dialogue: 0,0:18:11.10,0:18:15.12,Default,,0,0,0,,Осының ішінде жалғыз Луна өз ойын жауып тастады.
Dialogue: 0,0:18:15.12,0:18:17.12,Default,,0,0,0,,​​Неліктен?
Dialogue: 0,0:18:17.12,0:18:20.79,Default,,0,0,0,,Дәл осыны қалайды емес пе?
Dialogue: 0,0:18:20.79,0:18:23.45,Default,,0,0,0,,Міне...
Dialogue: 0,0:18:23.45,0:18:28.45,Default,,0,0,0,,Чоно Амудың арманын орындау үшін біз Stride Gate-ті қорғауды жалғастыруымыз керек➡
Dialogue: 0,0:18:28.45,0:18:32.12,Default,,0,0,0,,Бұл Лунаның қалауы.
Dialogue: 0,0:18:32.12,0:18:36.51,Default,,0,0,0,,Барлығы бақытты болатын асыл болашақ үшін➡
Dialogue: 0,0:18:36.51,0:18:40.13,Default,,0,0,0,,Ол өз құнын төледі.
Dialogue: 0,0:18:40.13,0:18:44.42,Default,,0,0,0,,Бұл – сауапты іс.
Dialogue: 0,0:18:44.42,0:18:46.45,Default,,0,0,0,,Шулы, үндеме!
Dialogue: 0,0:18:46.45,0:18:49.17,Default,,0,0,0,,Gast Dragon көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:49.17,0:18:52.17,Default,,0,0,0,,Плюс шеберлікпен тағы 5000 қуат!
Dialogue: 0,0:18:55.41,0:18:58.10,Default,,0,0,0,,Иә! Не!?
Dialogue: 0,0:18:58.10,0:19:00.10,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:19:03.10,0:19:07.10,Default,,0,0,0,,Қандай жағдай болмасын, мен Лунаны қорғаймын.
Dialogue: 0,0:19:10.13,0:19:14.43,Default,,0,0,0,,Бұл да менің ең ауыр күнәм.
Dialogue: 0,0:19:14.43,0:19:16.43,Default,,0,0,0,,Қылмыстық күнә...?
Dialogue: 0,0:19:18.43,0:19:20.43,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:22.46,0:19:27.49,Default,,0,0,0,,Жас кезімде ауырдым.
Dialogue: 0,0:19:27.49,0:19:30.11,Default,,0,0,0,,Тірі қалу деңгейі 50 пайыз
Dialogue: 0,0:19:30.11,0:19:34.12,Default,,0,0,0,,Сүйектерді лақтыр, тақ сан шығады ма, әлде жұп сан ба...
Dialogue: 0,0:19:34.12,0:19:36.75,Default,,0,0,0,,Бірдей ықтималдық
Dialogue: 0,0:19:36.75,0:19:40.81,Default,,0,0,0,,Бала кезімде Алланың қалауымен болдым➡
Dialogue: 0,0:19:40.81,0:19:44.81,Default,,0,0,0,,Менің тағдырым шешілгендей болды.
Dialogue: 0,0:19:44.81,0:19:48.10,Default,,0,0,0,,Бұл күндер бір күні жалғасты
Dialogue: 0,0:19:48.10,0:19:50.10,Default,,0,0,0,,((Уау!
Dialogue: 0,0:19:50.10,0:19:52.10,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:19:55.49,0:19:57.49,Default,,0,0,0,,Рахмет))
Dialogue: 0,0:20:02.98,0:20:07.12,Default,,0,0,0,,Ол да мен сияқты дертке шалдыққан.
Dialogue: 0,0:20:07.12,0:20:11.45,Default,,0,0,0,,Екеуміздің дос болғанымызға көп уақыт болмады.
Dialogue: 0,0:20:11.45,0:20:36.10,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:36.10,0:20:38.83,Default,,0,0,0,,Ал біз ➡
Dialogue: 0,0:20:38.83,0:20:42.13,Default,,0,0,0,,Мен әрқашан өлімге жақын болдым
Dialogue: 0,0:20:45.42,0:20:47.77,Default,,0,0,0,,((Ертең кездескенше
Dialogue: 0,0:20:47.77,0:20:50.33,Default,,0,0,0,,Ертең...
Dialogue: 0,0:20:50.33,0:20:54.78,Default,,0,0,0,,Оған қанша уақыт кетеді?
Dialogue: 0,0:20:54.78,0:20:58.38,Default,,0,0,0,,Бізді бақытты болашақ күтіп тұр ма?
Dialogue: 0,0:21:03.26,0:21:06.46,Default,,0,0,0,,Иә, мүлде!
Dialogue: 0,0:21:06.46,0:21:11.30,Default,,0,0,0,,Уайымдама, мен сені қорғаймын! ))
Dialogue: 0,0:21:11.30,0:21:13.83,Default,,0,0,0,,Ол оны құтқарғысы келеді➡
Dialogue: 0,0:21:13.83,0:21:16.13,Default,,0,0,0,,Шарасыздан сөз шықты.
Dialogue: 0,0:21:18.17,0:21:20.47,Default,,0,0,0,,Бірақ ол...
Dialogue: 0,0:21:24.13,0:21:33.47,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:33.47,0:21:39.14,Default,,0,0,0,,Кейінірек ауруымды жеңуге көмектескен жаңа препарат жасалды.
Dialogue: 0,0:21:39.14,0:21:43.64,Default,,0,0,0,,Мен оның өмірінің құнына аман қалдым.
Dialogue: 0,0:21:47.08,0:21:49.95,Default,,0,0,0,,Мен қорғауға ант еткен қыз...
Dialogue: 0,0:21:49.95,0:21:55.39,Default,,0,0,0,,Бірақ мен қорғандым.
Dialogue: 0,0:21:55.39,0:22:01.55,Default,,0,0,0,,Ол маған өз құнына көмектесті.
Dialogue: 0,0:22:01.55,0:22:06.35,Default,,0,0,0,,Сен маған ертең, болашақты осылай сыйладың!
Dialogue: 0,0:22:11.69,0:22:16.91,Default,,0,0,0,,Содан кейін мен Миджин мырзамен танысып, оның философиясымен таныстым.
Dialogue: 0,0:22:16.91,0:22:20.43,Default,,0,0,0,,Кез келген адам Vanguard➡-мен бақытты бола алады
Dialogue: 0,0:22:20.43,0:22:24.45,Default,,0,0,0,,Кемел болашақты жүзеге асыру идеясы
Dialogue: 0,0:22:24.45,0:22:29.79,Default,,0,0,0,,Егер мұндай дүние шындыққа айналса, ол сияқты ешкім өмірінен айырылмас еді➡
Dialogue: 0,0:22:29.79,0:22:36.63,Default,,0,0,0,,Кетті, әркім бейбіт болашаққа ие болады.
Dialogue: 0,0:22:36.63,0:22:41.04,Default,,0,0,0,,Онда мен оны жүзеге асыру үшін бар күшімді саламын!
Dialogue: 0,0:22:41.04,0:22:46.79,Default,,0,0,0,,Қандай құрбандық болса да, мен оны міндетті түрде жүзеге асырамын!
Dialogue: 0,0:22:46.79,0:22:50.73,Default,,0,0,0,,Енді менің алдымда Луна Юдзуки тұр.
Dialogue: 0,0:22:50.73,0:22:55.45,Default,,0,0,0,,Қыз өзі қалаған болашағы үшін өзін құрбан етеді.
Dialogue: 0,0:22:55.45,0:22:57.47,Default,,0,0,0,,Мен сені қорғаймын!
Dialogue: 0,0:22:57.47,0:22:59.76,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ！
Dialogue: 0,0:22:59.76,0:23:03.33,Default,,0,0,0,,《Есайдың қолы нөл
Dialogue: 0,0:23:03.33,0:23:05.63,Default,,0,0,0,,Мен оны міндетті түрде қорғаймын! 》
Dialogue: 0,0:23:07.61,0:23:11.71,Default,,0,0,0,,Бұл дүниені басқаратын ақиқат маған мұны істеуді де айтады.
Dialogue: 0,0:23:13.77,0:23:16.29,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:23:16.29,0:23:19.79,Default,,0,0,0,,Күнәкар адам Шалхарот!
Dialogue: 0,0:23:19.79,0:23:22.95,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｿｳﾙﾁｬｰｼﾞ
Dialogue: 0,0:23:22.95,0:23:25.58,Default,,0,0,0,,Drop Soul's Dimension Creeper
Dialogue: 0,0:23:25.58,0:23:29.45,Default,,0,0,0,,Жан заряды жұмбақ өлтіруші қараңғылығы!
Dialogue: 0,0:23:29.45,0:23:32.00,Default,,0,0,0,,Ұрыс басында жанның шақыруы
Dialogue: 0,0:23:32.00,0:23:36.09,Default,,0,0,0,,Қуат плюс 15000 сіздің жаныңызда 15 немесе одан да көп карталармен!
Dialogue: 0,0:23:36.09,0:23:38.61,Default,,0,0,0,,Неге Лунаның жолына түсесің?
Dialogue: 0,0:23:38.61,0:23:41.26,Default,,0,0,0,,Оның қаншалықты қымбат екенін неге түсінбейсің?
Dialogue: 0,0:23:41.26,0:23:46.45,Default,,0,0,0,,Дүниенің болашағы үшін, сенің болашағың үшін өзін құрбан етті➡
Dialogue: 0,0:23:46.45,0:23:48.45,Default,,0,0,0,,Сіз оны алуға тырысып жатырсыз!
Dialogue: 0,0:23:48.45,0:23:50.46,Default,,0,0,0,,Мен мұны қаламаймын!
Dialogue: 0,0:23:50.46,0:23:53.46,Default,,0,0,0,,Мен Луна құрбан болған болашақты қаламаймын!
Dialogue: 0,0:23:53.46,0:23:57.28,Default,,0,0,0,,Мен... Лунаның қайтып келгенін қалаймын!
Dialogue: 0,0:23:57.28,0:24:02.79,Default,,0,0,0,,Себептің мәні мен құндылығын түсіне алмау...
Dialogue: 0,0:24:02.79,0:24:05.12,Default,,0,0,0,,Сіз бұл орынға жарамайсыз!
Dialogue: 0,0:24:05.12,0:24:08.77,Default,,0,0,0,,Күнәкар Шалхаротпен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:24:08.77,0:24:12.24,Default,,0,0,0,,Қараңғылық! Барлық тыл сақшылары Сеулге
Dialogue: 0,0:24:12.24,0:24:14.25,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ10000！
Dialogue: 0,0:24:14.25,0:24:17.12,Default,,0,0,0,,Қарсыласыңыздың барлық сақшыларын шегіндіріңіз.
Dialogue: 0,0:24:17.12,0:24:19.12,Default,,0,0,0,,Не!?
Dialogue: 0,0:24:19.12,0:24:22.34,Default,,0,0,0,,Бұл шабуылды Сентинел қорғай алмайды.
Dialogue: 0,0:24:22.34,0:24:24.94,Default,,0,0,0,,Толық күзет... пайдалануға болмайды!
Dialogue: 0,0:24:30.45,0:24:33.62,Default,,0,0,0,,Мен ешқашан жеңілмеймін...
Dialogue: 0,0:24:33.62,0:24:37.54,Default,,0,0,0,,Мен жеңілгім келмейді!
Dialogue: 0,0:24:37.54,0:24:43.41,Default,,0,0,0,,Мен сол қолдардың жылуын сеземін...
Dialogue: 0,0:24:43.41,0:24:48.66,Default,,0,0,0,,Луна...
Dialogue: 0,0:24:48.66,0:24:50.96,Default,,0,0,0,,Мен оны жоғалтқым келмейді!
Dialogue: 0,0:24:59.91,0:25:02.44,Default,,0,0,0,,Сот үкімі шықты
Dialogue: 0,0:25:02.44,0:25:07.37,Default,,0,0,0,,Аму Чоно Кимидің компанияда болу біліктілігі немесе күші жоқ.
Dialogue: 0,0:25:07.37,0:25:09.47,Default,,0,0,0,,Қазір бұл жерден кет.
Dialogue: 0,0:25:14.32,0:25:16.32,Default,,0,0,0,,ﾙ ﾙｰﾅ…
Dialogue: 0,0:25:19.14,0:25:22.14,Default,,0,0,0,,Дүние шындығына қарсы шығуға болмайды
Dialogue: 0,0:25:27.94,0:25:30.94,Default,,0,0,0,,Енді тезірек кет.
Dialogue: 0,0:25:35.63,0:25:40.02,Default,,0,0,0,,Қазір қиын болса да, жақын арада кемел болашақ келеді.
Dialogue: 0,0:25:40.02,0:25:42.28,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:25:42.28,0:25:45.27,Default,,0,0,0,,Сіз Луна қалағандайсыз➡
Dialogue: 0,0:25:45.27,0:25:47.87,Default,,0,0,0,,Бақытты бол
Dialogue: 0,0:25:49.96,0:25:55.16,Default,,0,0,0,,Енді мен Kiba Holdings-тің жаңа өкілдері болатын барлық басшыларға алғыс айтқым келеді➡
Dialogue: 0,0:25:55.16,0:25:58.16,Default,,0,0,0,,Біз тағайындалған адамды таныстырғымыз келеді.
Dialogue: 0,0:26:00.29,0:26:02.34,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:26:02.34,0:26:04.84,Default,,0,0,0,,Бұл Шоума Шинономе.
Dialogue: 0,0:27:44.19,0:27:47.99,Default,,0,0,0,,《Баратын жер жоқ》
Dialogue: 0,0:27:57.27,0:28:00.77,Default,,0,0,0,,Біреу маған көмектесіңізші...
Dialogue: 0,0:30:39.83,0:30:42.33,Default,,0,0,0,,<Эдоның үш үлкен фестивалі туралы айту...>
Dialogue: 0,0:30:49.09,0:30:51.16,Default,,0,0,0,,< Енді басқасы ше?
Dialogue: 0,0:30:51.16,0:30:54.76,Default,,0,0,0,,Ал Жапонияның үш ірі фестивалі туралы айтатын болсақ...>
Dialogue: 0,0:30:57.28,0:30:59.78,Default,,0,0,0,,<Киото жазын бояу→
Dialogue: 0,0:31:01.28,0:31:07.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory