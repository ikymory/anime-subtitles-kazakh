Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:06.37,0:01:10.37,Default,,0,0,0,,((Хронодран: Кім? Кім бар?
Dialogue: 0,0:01:16.02,0:01:19.59,Default,,0,0,0,,Сіз ше? (Куроно)Куроно
Dialogue: 0,0:01:19.59,0:01:23.72,Default,,0,0,0,,Түсіндім, сені Куроно деп те атайды.
Dialogue: 0,0:01:23.72,0:01:26.82,Default,,0,0,0,,Мен...))
Dialogue: 0,0:01:41.03,0:01:42.94,Default,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:01:42.94,0:01:45.46,Default,,0,0,0,,Мен мұндай кезде жиі ұйықтап қаламын.
Dialogue: 0,0:01:45.46,0:01:47.42,Default,,0,0,0,,Бұл шынымен де сендіреді.
Dialogue: 0,0:01:47.42,0:01:50.28,Default,,0,0,0,,Сын сәттерде ұйықтап қалмау.
Dialogue: 0,0:01:50.28,0:01:53.28,Default,,0,0,0,,О
Dialogue: 0,0:01:58.29,0:02:00.89,Default,,0,0,0,,《Бұл не арман еді...?》
Dialogue: 0,0:05:12.92,0:05:16.14,Default,,0,0,0,,Мұсашинодайдан көлік өтті!
Dialogue: 0,0:05:16.14,0:05:19.26,Default,,0,0,0,,Мақсатты нүктеге дейінгі қашықтық 3000!
Dialogue: 0,0:05:19.26,0:05:21.43,Default,,0,0,0,,Маршрут күйінде өзгеріс жоқ
Dialogue: 0,0:05:21.43,0:05:23.88,Default,,0,0,0,,Жаудың қимылын да көрмеймін.
Dialogue: 0,0:05:23.88,0:05:25.88,Default,,0,0,0,,Іс жақсы жүріп жатыр.
Dialogue: 0,0:05:30.59,0:05:33.81,Default,,0,0,0,,((Ибуки: Бұдан былай біз шақырылған бөлімшенің қауіпсіздігін қамтамасыз етеміз➡
Dialogue: 0,0:05:33.81,0:05:35.93,Default,,0,0,0,,Тәуелділік картасын жинаңыз
Dialogue: 0,0:05:35.93,0:05:39.48,Default,,0,0,0,,Льюесті қамауға алыңыз.
Dialogue: 0,0:05:39.48,0:05:42.08,Default,,0,0,0,,Күте аласыз ба, Ибуки-кун?
Dialogue: 0,0:05:42.08,0:05:44.42,Default,,0,0,0,,Аға
Dialogue: 0,0:05:44.42,0:05:46.69,Default,,0,0,0,,Мен оларды жіберуге келіспеймін.
Dialogue: 0,0:05:46.69,0:05:48.99,Default,,0,0,0,,Тым қауіпті!
Dialogue: 0,0:05:51.41,0:05:55.98,Default,,0,0,0,,Сіз соншалықты алысқа келіп, бізді тастап кете алмайсыз.
Dialogue: 0,0:05:55.98,0:05:58.92,Default,,0,0,0,,Біз оны соңғы кезеңнен өттік.
Dialogue: 0,0:05:58.92,0:06:00.95,Default,,0,0,0,,жарамды болуы керек
Dialogue: 0,0:06:00.95,0:06:04.27,Default,,0,0,0,,Бізде енді күресуге себеп бар.
Dialogue: 0,0:06:04.27,0:06:06.27,Default,,0,0,0,,тиісінше))
Dialogue: 0,0:06:17.65,0:06:20.77,Default,,0,0,0,,《Соңында мен оларды жібердім.
Dialogue: 0,0:06:20.77,0:06:25.16,Default,,0,0,0,,Мен қауіпсіз жердемін》
Dialogue: 0,0:06:25.16,0:06:28.46,Default,,0,0,0,,Менің де кетуім керек еді.
Dialogue: 0,0:06:28.46,0:06:30.60,Default,,0,0,0,,Мен саған бірнеше қосымша киім мен бір күрте дайындап қоямын.
Dialogue: 0,0:06:30.60,0:06:34.13,Default,,0,0,0,,Маморудың ғана қолынан келетін істер бар.
Dialogue: 0,0:06:34.13,0:06:37.59,Default,,0,0,0,,Мұнда болу сіздің ұстанымыңызды қорғайды➡
Dialogue: 0,0:06:37.59,0:06:41.78,Default,,0,0,0,,Ассоциацияны кестеден қалыпқа келтіруге болады.
Dialogue: 0,0:06:41.78,0:06:43.83,Default,,0,0,0,,Крис
Dialogue: 0,0:06:43.83,0:06:47.78,Default,,0,0,0,,Сіз де біздің триггерсіз
Dialogue: 0,0:06:47.78,0:06:51.79,Default,,0,0,0,,Бірақ...Әпкелерің үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:06:51.79,0:06:54.09,Default,,0,0,0,,Кай, Ибуки және т.б.
Dialogue: 0,0:06:54.09,0:06:58.79,Default,,0,0,0,,Сорю қоры ұйымдастырған бұл салада көптеген кәсіпқойлар бар.
Dialogue: 0,0:06:58.79,0:07:03.09,Default,,0,0,0,,Ең бастысы, олар жақсы болады.
Dialogue: 0,0:07:20.93,0:07:23.97,Default,,0,0,0,,Көлік құралы белгіленген нүктеге жетті!
Dialogue: 0,0:07:23.97,0:07:25.97,Default,,0,0,0,,Басталып жатыр.
Dialogue: 0,0:07:56.28,0:07:58.28,Default,,0,0,0,,Тез кіріңіз!
Dialogue: 0,0:08:04.02,0:08:06.02,Default,,0,0,0,,Ішке кірді!
Dialogue: 0,0:08:13.52,0:08:17.47,Default,,0,0,0,,Жаудың қарсылығы жоқ. Тым тыныш.
Dialogue: 0,0:08:17.47,0:08:20.42,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:08:20.42,0:08:23.64,Default,,0,0,0,,Мен бұрын жасырынған жерім де осындай болатын.
Dialogue: 0,0:08:23.64,0:08:27.44,Default,,0,0,0,,Олай болса, пайда болған адам...
Dialogue: 0,0:08:32.94,0:08:35.09,Default,,0,0,0,,Өйткені, бұл балалар.
Dialogue: 0,0:08:35.09,0:08:37.31,Default,,0,0,0,,Қарсыластың қорғанысы және кездесулері
Dialogue: 0,0:08:37.31,0:08:39.26,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,0:08:39.26,0:08:43.08,Default,,0,0,0,,Ей, мен жабайы боламын.
Dialogue: 0,0:08:43.08,0:08:45.08,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:08:45.08,0:08:48.50,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:08:48.50,0:08:51.30,Default,,0,0,0,,Қарсыластың Робо гвардиялық топтарымен әрекеттесу!
Dialogue: 0,0:08:54.58,0:08:56.94,Default,,0,0,0,,Серпіліс!
Dialogue: 0,0:08:56.94,0:08:59.28,Default,,0,0,0,,Тек алға ұмтыл, Ибуки.
Dialogue: 0,0:08:59.28,0:09:01.60,Default,,0,0,0,,Жоғары қадамдық күш реакциясы
Dialogue: 0,0:09:01.60,0:09:05.10,Default,,0,0,0,,[Радио] (Крис) Шақырылған бөлімше алда болуы керек.
Dialogue: 0,0:09:12.36,0:09:14.36,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:28.98,0:09:32.63,Default,,0,0,0,,Бұл... Шақырылған бірлік
Dialogue: 0,0:09:32.63,0:09:34.77,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:09:34.77,0:09:37.80,Default,,0,0,0,,Біз оны қорғаймыз!
Dialogue: 0,0:09:37.80,0:09:40.77,Default,,0,0,0,,Абсолюттік әділдік орнады!
Dialogue: 0,0:09:40.77,0:09:42.94,Default,,0,0,0,,Қозғалмаңдар, жауыздар!
Dialogue: 0,0:09:42.94,0:09:45.86,Default,,0,0,0,,Ол рұқсатсыз кіріп кетті!
Dialogue: 0,0:09:45.86,0:09:48.58,Default,,0,0,0,,Сіз оны біреудің желіне қарсы қоя алмайсыз!
Dialogue: 0,0:09:48.58,0:09:52.13,Default,,0,0,0,,Мынау кім? Сіз Льюздің досысыз ба?
Dialogue: 0,0:09:52.13,0:09:56.59,Default,,0,0,0,,Мен компанияның мүшесімін! Және ақымақ болма!
Dialogue: 0,0:09:56.59,0:09:59.11,Default,,0,0,0,,Абсолютті әділеттілік!
Dialogue: 0,0:09:59.11,0:10:01.81,Default,,0,0,0,,Абсолютті қаһарман!
Dialogue: 0,0:10:01.81,0:10:07.78,Default,,0,0,0,,Әділет елшісі Хироку Морияма!
Dialogue: 0,0:10:07.78,0:10:09.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:09.97,0:10:11.99,Default,,0,0,0,,Иә! Сіз қорқып кеттіңіз бе?
Dialogue: 0,0:10:11.99,0:10:14.97,Default,,0,0,0,,Құрылғыны бір саусақпен ұстауға рұқсат етпеңіз!
Dialogue: 0,0:10:14.97,0:10:17.97,Default,,0,0,0,,Абсолютті қорғаныстың пайда болуы!
Dialogue: 0,0:10:30.10,0:10:33.47,Default,,0,0,0,,Хахаха...! Сіз қалай ойлайсыз?
Dialogue: 0,0:10:33.47,0:10:36.56,Default,,0,0,0,,Мен осы дүниені құтқаратын батыр боламын!
Dialogue: 0,0:10:36.56,0:10:39.66,Default,,0,0,0,,Мен сендерді мазалағандарыңа шыдай алмаймын!
Dialogue: 0,0:10:41.63,0:10:44.95,Default,,0,0,0,,《Рюзу еш жерде көрінбейді...》 (Кай) Бар.
Dialogue: 0,0:10:44.95,0:10:47.05,Default,,0,0,0,,Мұны бізге қалдырыңыз.
Dialogue: 0,0:10:49.86,0:10:54.31,Default,,0,0,0,,Балалар, сендер де барыңдар! (3 адам) Иә!
Dialogue: 0,0:10:54.31,0:10:56.43,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе. Ури~!
Dialogue: 0,0:10:56.43,0:11:00.30,Default,,0,0,0,,Камуи мырза өте керемет! Шулы!
Dialogue: 0,0:11:00.30,0:11:03.25,Default,,0,0,0,,Катсураги сен де бар! иә?
Dialogue: 0,0:11:03.25,0:11:05.44,Default,,0,0,0,,Олар жақсы болады!
Dialogue: 0,0:11:05.44,0:11:07.47,Default,,0,0,0,,Жарайды, кеттік! Ол аурады!
Dialogue: 0,0:11:07.47,0:11:10.93,Default,,0,0,0,,Бұл жігіттер біздің триггерлеріміз.
Dialogue: 0,0:11:10.93,0:11:14.98,Default,,0,0,0,,Мен мұны сұрадым. Алақай!
Dialogue: 0,0:11:14.98,0:11:19.09,Default,,0,0,0,,Ей, бұл блокты қалай қорғаймыз?
Dialogue: 0,0:11:19.09,0:11:22.59,Default,,0,0,0,,Мен мұндай үлкен нәрсені үйге апара алмаймын.
Dialogue: 0,0:11:22.59,0:11:25.68,Default,,0,0,0,,Олай болса, біз осы орынды алғанша.
Dialogue: 0,0:11:25.68,0:11:31.77,Default,,0,0,0,,Ибуки Катсураги Трисли Нысанның ең ішкі бөлігіне қарай жылжу
Dialogue: 0,0:11:31.77,0:11:34.38,Default,,0,0,0,,《Өтінемін, Ибуки-кун...
Dialogue: 0,0:11:34.38,0:11:36.38,Default,,0,0,0,,Льюесті қалай болса да ұстап алыңыз.
Dialogue: 0,0:11:40.11,0:11:42.91,Default,,0,0,0,,Бұл қандай бөлме?
Dialogue: 0,0:11:49.47,0:11:53.10,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:11:53.10,0:11:57.81,Default,,0,0,0,,Танысқаныма қуаныштымын, менің атым Сосуке Вакамизу.
Dialogue: 0,0:11:57.81,0:12:01.26,Default,,0,0,0,,Не... ол жігіт?
Dialogue: 0,0:12:01.26,0:12:06.48,Default,,0,0,0,,Бұдан былай Вакамизу сізді қабылдайды!
Dialogue: 0,0:12:06.48,0:12:08.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:18.91,0:12:22.42,Default,,0,0,0,,Ибуки жоғалды!
Dialogue: 0,0:12:22.42,0:12:25.15,Default,,0,0,0,,Қарғыс атсын... Байланыс үзілді!
Dialogue: 0,0:12:25.15,0:12:28.11,Default,,0,0,0,,Ибуки Сіз мені естисіз бе! Ибуки!
Dialogue: 0,0:12:28.11,0:12:30.61,Default,,0,0,0,,Жоқ... жауап жоқ
Dialogue: 0,0:12:37.25,0:12:39.58,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:12:39.58,0:12:41.64,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:12:41.64,0:12:44.61,Default,,0,0,0,,Білмес бұрын... Сізге қалай ұнайды?
Dialogue: 0,0:12:44.61,0:12:47.77,Default,,0,0,0,,Тісті беріліс жүйесінің технологиясын қолдану➡
Dialogue: 0,0:12:47.77,0:12:51.70,Default,,0,0,0,,Вакамизу жасаған бұл кескін кеңістігі
Dialogue: 0,0:12:51.70,0:12:53.76,Default,,0,0,0,,Кескін кеңістігі?
Dialogue: 0,0:12:53.76,0:12:56.15,Default,,0,0,0,,Бұл тамаша болар еді!
Dialogue: 0,0:12:56.15,0:12:58.60,Default,,0,0,0,,Бұл шынымен дала сияқты!
Dialogue: 0,0:12:58.60,0:13:02.76,Default,,0,0,0,,Жоқ, біз Крей планетасында жүрген сияқтымыз, солай емес пе?
Dialogue: 0,0:13:02.76,0:13:05.36,Default,,0,0,0,,《Мен Куроно мен басқаларды көре алмаймын.
Dialogue: 0,0:13:05.36,0:13:08.46,Default,,0,0,0,,Цк... Бөлініп қалды ма?》
Dialogue: 0,0:13:13.08,0:13:16.64,Default,,0,0,0,,Сіз... Darkzon филиалының бастығысыз ба?
Dialogue: 0,0:13:16.64,0:13:18.76,Default,,0,0,0,,Есай Сатору
Dialogue: 0,0:13:18.76,0:13:23.76,Default,,0,0,0,,Мен Миджин Русе мырзаның идеалдарымен келісетін компанияның мүшесімін.
Dialogue: 0,0:13:23.76,0:13:25.86,Default,,0,0,0,,ｶﾝﾊﾟﾆｰ
Dialogue: 0,0:13:33.92,0:13:38.68,Default,,0,0,0,,Сізбен қайта кездескеніме қуаныштымын. Сіз екеуміздің байланысымыз бар сияқты.
Dialogue: 0,0:13:38.68,0:13:40.68,Default,,0,0,0,,ｸｯ！
Dialogue: 0,0:13:43.76,0:13:46.68,Default,,0,0,0,,Бұл жерде зорлық-зомбылыққа тыйым салынады.
Dialogue: 0,0:13:46.68,0:13:50.59,Default,,0,0,0,,Барлық шешімдер Авангардқа қалдырылады.
Dialogue: 0,0:13:50.59,0:13:53.61,Default,,0,0,0,,Бұл Миджин Роуздың философиясы.
Dialogue: 0,0:13:53.61,0:13:55.64,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:13:55.64,0:14:02.75,Default,,0,0,0,,Ал қазір мен сол философияны ұстанатын компанияның мүшесімін.
Dialogue: 0,0:14:02.75,0:14:07.65,Default,,0,0,0,,Көп уақыттан кейін жасайық.
Dialogue: 0,0:14:07.65,0:14:11.29,Default,,0,0,0,,Не болып жатыр? Барлығы ше?
Dialogue: 0,0:14:11.29,0:14:13.89,Default,,0,0,0,,Байланыс да үзілді ме?
Dialogue: 0,0:14:18.68,0:14:20.68,Default,,0,0,0,,Не?
Dialogue: 0,0:14:31.43,0:14:35.28,Default,,0,0,0,,Миджин Роуз!
Dialogue: 0,0:14:35.28,0:14:38.45,Default,,0,0,0,,Сізді осында көргеніме қуаныштымын.
Dialogue: 0,0:14:38.45,0:14:41.95,Default,,0,0,0,,Мен жол көрсеткендер
Dialogue: 0,0:16:33.25,0:16:35.47,Default,,0,0,0,,Миоджин Роуз…
Dialogue: 0,0:16:35.47,0:16:37.57,Default,,0,0,0,,Егер сен осы екеуін қорғасаң, мен шабуылға көңіл бөле аламын
Dialogue: 0,0:16:41.24,0:16:43.24,Default,,0,0,0,,Дене…
Dialogue: 0,0:16:43.24,0:16:47.91,Default,,0,0,0,,Бірлікті шақыру Бұл баға.
Dialogue: 0,0:16:47.91,0:16:53.34,Default,,0,0,0,,Мен енді бұл құрылғыларға сене алмаймын➡
Dialogue: 0,0:16:53.34,0:16:56.64,Default,,0,0,0,,Денем ауырып, әлсіреп қалды.
Dialogue: 0,0:16:58.66,0:17:04.26,Default,,0,0,0,,Мен сізді осында сыйлағаным үшін әкелдім.
Dialogue: 0,0:17:04.26,0:17:08.32,Default,,0,0,0,,Беріліс дағдарысы... сендер балалар➡
Dialogue: 0,0:17:08.32,0:17:15.93,Default,,0,0,0,,Мен қалған бір бөлімшенің шақыруын тоқтатып, өзімнің тұрған жерімді білдім.
Dialogue: 0,0:17:15.93,0:17:18.45,Default,,0,0,0,,Керемет
Dialogue: 0,0:17:18.45,0:17:21.25,Default,,0,0,0,,Бірақ менің көңілім қалды.
Dialogue: 0,0:17:21.25,0:17:25.95,Default,,0,0,0,,Коудзи Ибуки… Ең соңында➡
Dialogue: 0,0:17:25.95,0:17:29.55,Default,,0,0,0,,Сіз ең ақымақ таңдау жасадыңыз.
Dialogue: 0,0:17:32.64,0:17:38.93,Default,,0,0,0,,Көптеген адамдарды басқарып, олар менің сарайыма кіріп, зорлық-зомбылық көрсетті➡
Dialogue: 0,0:17:38.93,0:17:43.14,Default,,0,0,0,,Мұны бақылауға тырысыңыз
Dialogue: 0,0:17:43.14,0:17:49.44,Default,,0,0,0,,Бұл мен жек көретін ең ақымақ нәрсе.
Dialogue: 0,0:17:49.44,0:17:54.61,Default,,0,0,0,,Мен сені аяймын
Dialogue: 0,0:17:54.61,0:17:57.61,Default,,0,0,0,,және менсінбеу
Dialogue: 0,0:17:59.99,0:18:02.04,Default,,0,0,0,,Уфф хахахахаха
Dialogue: 0,0:18:02.04,0:18:04.47,Default,,0,0,0,,Құрылғыны өз амбицияларыңыз үшін пайдаланыңыз➡
Dialogue: 0,0:18:04.47,0:18:10.60,Default,,0,0,0,,Авангардтың болашағын ұрлағысы келген жігіт намыстанып сөйлеп тұрған жоқ!
Dialogue: 0,0:18:10.60,0:18:14.65,Default,,0,0,0,,Менің әкем де... сенің кесіріңнен өлген жоқ па?
Dialogue: 0,0:18:14.65,0:18:20.42,Default,,0,0,0,,Хмм... түсіндім.
Dialogue: 0,0:18:20.42,0:18:25.48,Default,,0,0,0,,Авангард… Иә, Авангард➡ сияқты
Dialogue: 0,0:18:25.48,0:18:31.78,Default,,0,0,0,,Шешім ұтымды және қисынды түрде қабылдануы керек.
Dialogue: 0,0:18:33.99,0:18:36.76,Default,,0,0,0,,Камуи-сан Шион Токоха!
Dialogue: 0,0:18:36.76,0:18:39.43,Default,,0,0,0,,Вакамизу техникалық қабілетінің алдында➡
Dialogue: 0,0:18:39.43,0:18:44.31,Default,,0,0,0,,Сіз тым кішкентайсыз.
Dialogue: 0,0:18:44.31,0:18:46.98,Default,,0,0,0,,Ха~!!
Dialogue: 0,0:18:46.98,0:18:49.59,Default,,0,0,0,,Уау!!
Dialogue: 0,0:18:49.59,0:18:51.64,Default,,0,0,0,,Біздің себебіміз бар!
Dialogue: 0,0:18:51.64,0:18:53.64,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:18:57.66,0:19:02.10,Default,,0,0,0,,Авангардтың арқасында әлем өзгереді
Dialogue: 0,0:19:02.10,0:19:06.30,Default,,0,0,0,,Geacronic Zodiac Time Beast ➡
Dialogue: 0,0:19:06.30,0:19:12.09,Default,,0,0,0,,Олармен жасалған шарттың дәлелі: 12 тәуелді карточка
Dialogue: 0,0:19:12.09,0:19:18.63,Default,,0,0,0,,Осының бәрі орнында болғанда, Зодиак уақытының құдіретімен➡
Dialogue: 0,0:19:18.63,0:19:21.42,Default,,0,0,0,,Қадам қақпасы ашылды➡
Dialogue: 0,0:19:21.42,0:19:26.84,Default,,0,0,0,,Әлемді кемел болашаққа жетелей алады
Dialogue: 0,0:19:26.84,0:19:32.08,Default,,0,0,0,,Дау-дамай, өшпенділік, мұң жоқ➡
Dialogue: 0,0:19:32.08,0:19:37.93,Default,,0,0,0,,Ақыл мен парасат қолдайтын мінсіз әлем➡
Dialogue: 0,0:19:37.93,0:19:41.29,Default,,0,0,0,,Бұл жер бетінде жүзеге асырылды
Dialogue: 0,0:19:41.29,0:19:46.96,Default,,0,0,0,,Бұл менің тілегім, мұратым...
Dialogue: 0,0:19:46.96,0:19:49.46,Default,,0,0,0,,Менің әділдігім!
Dialogue: 0,0:19:53.52,0:19:56.27,Default,,0,0,0,,Балалар, Am қолданып жатырсыңдар, солай ма?
Dialogue: 0,0:19:56.27,0:19:59.27,Default,,0,0,0,,Оның сізге қатысы жоқ.
Dialogue: 0,0:19:59.27,0:20:01.27,Default,,0,0,0,,Ештеңе етпейді, біз доспыз!
Dialogue: 0,0:20:01.27,0:20:05.08,Default,,0,0,0,,Жолдан кет! Лами лабиринтіне араласпаңыз!
Dialogue: 0,0:20:05.08,0:20:10.13,Default,,0,0,0,,Олар туралы не білесіз?
Dialogue: 0,0:20:10.13,0:20:13.94,Default,,0,0,0,,Достар? Бұл уақытша танысу сезімі.
Dialogue: 0,0:20:13.94,0:20:18.84,Default,,0,0,0,,Иә? Біз туралы не білесіз?
Dialogue: 0,0:20:18.84,0:20:30.09,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:30.09,0:20:33.27,Default,,0,0,0,,Сол уақытша сезімді біліңіз➡
Dialogue: 0,0:20:33.27,0:20:36.29,Default,,0,0,0,,Сіз өзіңізге қауіп төндіресіз.
Dialogue: 0,0:20:36.29,0:20:39.93,Default,,0,0,0,,Көмек көрсеткеніңіз үшін рахмет! Екеуімен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:20:39.93,0:20:43.93,Default,,0,0,0,,Шығындардың жақсы себеппен төленуі сөзсіз.
Dialogue: 0,0:20:43.93,0:20:46.42,Default,,0,0,0,,Ха... минимум
Dialogue: 0,0:20:46.42,0:20:49.77,Default,,0,0,0,,Балалар, мен сендердің қандай адамдар екендеріңді енді білдім.
Dialogue: 0,0:20:49.77,0:20:53.19,Default,,0,0,0,,Мен сенің қалағаныңды істеуге ешқашан рұқсат етпеймін.
Dialogue: 0,0:20:53.19,0:20:56.43,Default,,0,0,0,,Мен Ам мен Лунаны қорғаймын!
Dialogue: 0,0:20:56.43,0:21:03.09,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:03.09,0:21:06.31,Default,,0,0,0,,Льюестің философиясына қызығушылық танытпайтыныңызға сенімдімін.
Dialogue: 0,0:21:06.31,0:21:09.68,Default,,0,0,0,,Сонда да сен неге Льюеспен араласып жүрсің!
Dialogue: 0,0:21:09.68,0:21:11.73,Default,,0,0,0,,Сіздің шын ниетіңіз қандай?
Dialogue: 0,0:21:11.73,0:21:16.10,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:16.10,0:21:18.44,Default,,0,0,0,,Айтыңызшы, неге Киба?
Dialogue: 0,0:21:18.44,0:21:24.14,Default,,0,0,0,,Тынымсыз ашу, қайнаған ыза, бұралаң күдік
Dialogue: 0,0:21:24.14,0:21:27.44,Default,,0,0,0,,Және барлық эмоцияларға жабысады➡
Dialogue: 0,0:21:27.44,0:21:29.53,Default,,0,0,0,,Жіңішке қорқыныш
Dialogue: 0,0:21:29.53,0:21:33.13,Default,,0,0,0,,Жүрегіңде не бар екенін сеземін.
Dialogue: 0,0:21:36.09,0:21:39.16,Default,,0,0,0,,Мен сіздің барлық ойларыңызды сезінемін
Dialogue: 0,0:21:39.16,0:21:41.94,Default,,0,0,0,,Мен елестеткендей.
Dialogue: 0,0:21:41.94,0:21:43.94,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:21:43.94,0:21:46.38,Default,,0,0,0,,Мен салған жолмен жүресің
Dialogue: 0,0:21:46.38,0:21:49.88,Default,,0,0,0,,Кел, кел, Киба Шион!
Dialogue: 0,0:21:52.59,0:21:57.06,Default,,0,0,0,,Әділеттілік дегеніміз не? Кемелді әлемді жүзеге асыру?
Dialogue: 0,0:21:57.06,0:21:58.93,Default,,0,0,0,,Бұл бос сөз!
Dialogue: 0,0:21:58.93,0:22:03.15,Default,,0,0,0,,Шақырылған бөлімшелер де серіктермен қамтамасыз етілуі керек.
Dialogue: 0,0:22:03.15,0:22:10.10,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:10.10,0:22:12.17,Default,,0,0,0,,Бірлікті аламыз!
Dialogue: 0,0:22:12.17,0:22:14.47,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:22:14.47,0:22:16.83,Default,,0,0,0,,Барлық тәуелді карталар да тәркіленеді.
Dialogue: 0,0:22:16.83,0:22:20.30,Default,,0,0,0,,Сіздің амбицияларыңыз ешқашан орындалмайды.
Dialogue: 0,0:22:20.30,0:22:25.75,Default,,0,0,0,,Миоджин Русе мен сені қамауға аламын!
Dialogue: 0,0:22:25.75,0:22:28.77,Default,,0,0,0,,Алып кетпе, жігіт.
Dialogue: 0,0:22:28.77,0:22:33.41,Default,,0,0,0,,Бұл сіз сияқты біреу айтатын сөздер ме?
Dialogue: 0,0:22:33.41,0:22:35.71,Default,,0,0,0,,Өз жағдайыңызды біліңіз!
Dialogue: 0,0:22:37.60,0:22:40.82,Default,,0,0,0,,Менің идеалдарым ешқашан жойылмайды
Dialogue: 0,0:22:40.82,0:22:48.12,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:48.12,0:22:50.22,Default,,0,0,0,,Не...
Dialogue: 0,0:22:52.80,0:22:54.75,Default,,0,0,0,,Не!?
Dialogue: 0,0:22:54.75,0:23:00.30,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:00.30,0:23:02.32,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:23:02.32,0:23:04.42,Default,,0,0,0,,ﾊﾊﾊﾊ…
Dialogue: 0,0:23:04.42,0:23:09.43,Default,,0,0,0,,Мұқият есте сақтаңыз! Әділдік әрқашан зұлымдықты жеңеді!
Dialogue: 0,0:23:09.43,0:23:11.50,Default,,0,0,0,,ﾊﾊﾊ…
Dialogue: 0,0:23:11.50,0:23:13.52,Default,,0,0,0,,Аняру!
Dialogue: 0,0:23:13.52,0:23:16.27,Default,,0,0,0,,ﾌﾌﾌﾌ…
Dialogue: 0,0:23:16.27,0:23:18.27,Default,,0,0,0,,Не болды?
Dialogue: 0,0:23:18.27,0:23:20.42,Default,,0,0,0,,Балалар сендер де бар күшіңді салдыңдар➡
Dialogue: 0,0:23:20.42,0:23:23.43,Default,,0,0,0,,Біз бір ойында жақсырақ болдық.
Dialogue: 0,0:23:23.43,0:23:25.46,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:23:25.46,0:23:29.27,Default,,0,0,0,,Бірлік жаңа ғана басқа орынға ауыстырылды.
Dialogue: 0,0:23:29.27,0:23:31.27,Default,,0,0,0,,Не? Трансфер!?
Dialogue: 0,0:23:31.27,0:23:35.26,Default,,0,0,0,,Біздің компанияда тасымалдау үшін қажетті қадам күші бар➡
Dialogue: 0,0:23:35.26,0:23:38.42,Default,,0,0,0,,Олар уақытты толтырғанша сатып алды.
Dialogue: 0,0:23:38.42,0:23:40.48,Default,,0,0,0,,Не...
Dialogue: 0,0:23:40.48,0:23:42.43,Default,,0,0,0,,Осымен операция аяқталады. Сондықтан➡
Dialogue: 0,0:23:42.43,0:23:44.41,Default,,0,0,0,,Кешіріңіз, бірақ➡
Dialogue: 0,0:23:44.41,0:23:48.80,Default,,0,0,0,,Бүгінгі жекпе-жек осында аяқталады.
Dialogue: 0,0:23:48.80,0:23:51.79,Default,,0,0,0,,Бәрі бір күні, бір жерде шешіледі.
Dialogue: 0,0:23:51.79,0:23:54.29,Default,,0,0,0,,Ақымақ болма!!
Dialogue: 0,0:23:58.16,0:24:00.16,Default,,0,0,0,,(Адамдардың айғайлауы)
Dialogue: 0,0:24:03.47,0:24:06.07,Default,,0,0,0,,Бірлік жоғалып кетті...
Dialogue: 0,0:24:09.92,0:24:12.43,Default,,0,0,0,,Аа... Не айтып тұрсың?
Dialogue: 0,0:24:12.43,0:24:15.13,Default,,0,0,0,,Осы уақытқа дейін ұрысып жүрсек те
Dialogue: 0,0:24:15.13,0:24:17.93,Default,,0,0,0,,Бізден басқа ешкім жоқ сияқты.
Dialogue: 0,0:24:17.93,0:24:23.47,Default,,0,0,0,,Бізге солай қарады. Қарғыс атсын.
Dialogue: 0,0:24:23.47,0:24:27.94,Default,,0,0,0,,Шақыру үшін тағы бір бірлік қалды.
Dialogue: 0,0:24:27.94,0:24:33.01,Default,,0,0,0,,Бірақ бұған дейін сотқа көшейік.
Dialogue: 0,0:24:33.01,0:24:38.48,Default,,0,0,0,,Кім дұрыс, мен бе, сен бе?
Dialogue: 0,0:24:38.48,0:24:42.47,Default,,0,0,0,,Бұл дүниені басқаратын шындық ашылды...
Dialogue: 0,0:24:42.47,0:24:44.47,Default,,0,0,0,,ｳｯ…
Dialogue: 0,0:24:48.14,0:24:50.61,Default,,0,0,0,,Біз шегіне жақындап қалған сияқтымыз.
Dialogue: 0,0:24:50.61,0:24:57.91,Default,,0,0,0,,Бірақ бұл тәнім жойылса да, менің идеалдарым ешқашан өлмейді.
Dialogue: 0,0:25:01.26,0:25:06.08,Default,,0,0,0,,…себебі әділ адам жеті рет құласа да….
Dialogue: 0,0:25:06.08,0:25:09.15,Default,,0,0,0,,ол қайтадан тұрады...
Dialogue: 0,0:25:09.15,0:25:19.26,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:19.26,0:25:21.29,Default,,0,0,0,,ｳ… ｜｜ Дұрыс па?
Dialogue: 0,0:25:21.29,0:25:38.89,Default,,0,0,0,,♪♪～
Dialogue: 0,0:27:11.95,0:28:05.25,Default,,0,0,0,,♪♪～
