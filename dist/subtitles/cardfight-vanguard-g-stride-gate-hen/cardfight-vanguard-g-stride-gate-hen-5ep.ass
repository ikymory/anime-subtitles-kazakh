Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.99,0:01:08.13,Default,,0,0,0,,Осында кездескенімізге 100 жыл болды. Біз оны еңсереміз!
Dialogue: 0,0:01:08.13,0:01:10.32,Default,,0,0,0,,Сол қылмыскер... қайтыс болды ма?
Dialogue: 0,0:01:10.32,0:01:14.27,Default,,0,0,0,,Жеңіске жетсем, компания туралы бәрін айтып беруіңізді сұраймын.
Dialogue: 0,0:01:14.27,0:01:17.62,Default,,0,0,0,,Күте тұрыңыз, Куроно-сан.
Dialogue: 0,0:01:17.62,0:01:20.51,Default,,0,0,0,,Маған төбелесуге рұқсат етіңіз
Dialogue: 0,0:01:20.51,0:01:23.56,Default,,0,0,0,,ﾀｲﾖｳ？
Dialogue: 0,0:01:23.56,0:01:26.06,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:04:44.28,0:04:46.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:46.51,0:04:48.85,Default,,0,0,0,,ﾙｰﾅ
Dialogue: 0,0:04:48.85,0:04:50.77,Default,,0,0,0,,ｱﾑ！
Dialogue: 0,0:04:50.77,0:04:54.49,Default,,0,0,0,,Жоқ! Жұмысыма көңілім толмағандықтан емес➡
Dialogue: 0,0:04:54.49,0:04:56.96,Default,,0,0,0,,Себебі мен кенет сенімен байланысымды үзіп қалдым➡
Dialogue: 0,0:04:56.96,0:04:59.99,Default,,0,0,0,,Токоха және басқалары уайымдап жатыр...
Dialogue: 0,0:04:59.99,0:05:02.13,Default,,0,0,0,,ｱﾑ？
Dialogue: 0,0:05:02.13,0:05:04.23,Default,,0,0,0,,Бізге бір нәрсе туралы айту керек.
Dialogue: 0,0:05:10.82,0:05:15.21,Default,,0,0,0,,Кеттік, жауыздар! Мен саған әділдіктің күшін көрсетемін
Dialogue: 0,0:05:15.21,0:05:18.28,Default,,0,0,0,,Grand Beat көмегімен шабуыл!
Dialogue: 0,0:05:18.28,0:05:20.85,Default,,0,0,0,,Үлкен көлікпен шабуыл!
Dialogue: 0,0:05:20.85,0:05:23.94,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:05:23.94,0:05:26.34,Default,,0,0,0,,Бұл Голпара ма?
Dialogue: 0,0:05:26.34,0:05:28.44,Default,,0,0,0,,Мен жеңілетініме сенімдімін
Dialogue: 0,0:05:28.44,0:05:31.33,Default,,0,0,0,,Зұлымдық әділдікті жеңе алмайды!
Dialogue: 0,0:05:31.33,0:05:36.13,Default,,0,0,0,,《Білгім келеді. Бұл бала неге олай ойлайды?》
Dialogue: 0,0:05:38.95,0:05:41.37,Default,,0,0,0,,((Канзаки: картаның дауысын тыңдаңыз.
Dialogue: 0,0:05:41.37,0:05:45.37,Default,,0,0,0,,Осылай жасасаңыз, алдағы жолды көресіз))
Dialogue: 0,0:05:48.44,0:05:52.61,Default,,0,0,0,,《Егер төбелессең түсінуің мүмкін》
Dialogue: 0,0:05:52.61,0:05:56.65,Default,,0,0,0,,Жүр! Таңның жарығы рыцарь Яго
Dialogue: 0,0:05:56.65,0:05:58.94,Default,,0,0,0,,Буруругаруға қоңырау шалыңыз
Dialogue: 0,0:05:58.94,0:06:00.97,Default,,0,0,0,,Grand Beat-ке шабуыл
Dialogue: 0,0:06:00.97,0:06:03.64,Default,,0,0,0,,Иә? Артқы күзетші үшін бе?
Dialogue: 0,0:06:03.64,0:06:06.94,Default,,0,0,0,,Менің ойымша, бұл Күзетсіз болуды шешті.
Dialogue: 0,0:06:10.03,0:06:12.28,Default,,0,0,0,,Әділдік қымбатқа түседі.
Dialogue: 0,0:06:12.28,0:06:16.96,Default,,0,0,0,,Тіпті мен, батыр, тек күшті болуым керек.
Dialogue: 0,0:06:16.96,0:06:20.17,Default,,0,0,0,,《Ол өткен күні осылай деді》
Dialogue: 0,0:06:20.17,0:06:23.11,Default,,0,0,0,,((Нағыз бір ғана күшті батыр бар!
Dialogue: 0,0:06:23.11,0:06:26.16,Default,,0,0,0,,Сізге тек мен керек))
Dialogue: 0,0:06:26.16,0:06:30.80,Default,,0,0,0,,《Бұрын мен де мықты болғым келетін.
Dialogue: 0,0:06:30.80,0:06:33.10,Default,,0,0,0,,Мен жалғыз қалудан қорқамын》
Dialogue: 0,0:06:36.17,0:06:39.61,Default,,0,0,0,,《Мен сенің ойыңда бірдеңе бар екенін көремін, Таййо.》
Dialogue: 0,0:06:39.61,0:06:44.43,Default,,0,0,0,,Жүр! Ғарыш қаһарманының үлкен добы
Dialogue: 0,0:06:44.43,0:06:47.60,Default,,0,0,0,,Авангард шынымен де ең жақсы.
Dialogue: 0,0:06:47.60,0:06:51.32,Default,,0,0,0,,Мен зұлымдықты қанағат тұтқанша жеңе аламын.
Dialogue: 0,0:06:51.32,0:06:55.32,Default,,0,0,0,,Гранд Булверге қоңырау шалыңыз. Авангардпен шабуыл
Dialogue: 0,0:06:57.26,0:07:00.11,Default,,0,0,0,,Қанша тырыссақ та, әділдік жеңеді!
Dialogue: 0,0:07:00.11,0:07:02.45,Default,,0,0,0,,Осылайша орындалды.
Dialogue: 0,0:07:02.45,0:07:06.62,Default,,0,0,0,,Күзетші! Жеңілсең жаман деп айту тым зорлық
Dialogue: 0,0:07:06.62,0:07:08.62,Default,,0,0,0,,Иә! Ақымақ
Dialogue: 0,0:07:08.62,0:07:12.33,Default,,0,0,0,,Дүниенің ақиқаты мен нақылы осы.
Dialogue: 0,0:07:12.33,0:07:16.63,Default,,0,0,0,,Шындық? Оракл? Ол нені білдіреді?
Dialogue: 0,0:07:16.63,0:07:20.13,Default,,0,0,0,,? мм...
Dialogue: 0,0:07:22.32,0:07:25.77,Default,,0,0,0,,Ух... өте шулы! Ештене етпейді!
Dialogue: 0,0:07:25.77,0:07:28.51,Default,,0,0,0,,Қалай болғанда да, шайқастың нәтижесі анық!
Dialogue: 0,0:07:28.51,0:07:30.45,Default,,0,0,0,,Льюес мырза осылай деді.
Dialogue: 0,0:07:30.45,0:07:35.03,Default,,0,0,0,,Күрделі мәселелер былай тұрсын, мен қатты әсер еттім.
Dialogue: 0,0:07:35.03,0:07:39.83,Default,,0,0,0,,Егер сіз сол адамның соңынан ерсеңіз, сізде толық әділеттілік болады!
Dialogue: 0,0:07:41.77,0:07:44.21,Default,,0,0,0,,《Себебі қандай болса да➡
Dialogue: 0,0:07:44.21,0:07:46.51,Default,,0,0,0,,Сіз мұндай нәрсені жасай алмайсыз.
Dialogue: 0,0:07:48.68,0:07:52.78,Default,,0,0,0,,Манифест! Бұл денеде жаңа күш бар
Dialogue: 0,0:07:52.78,0:07:58.99,Default,,0,0,0,,Жүр! Көтерілген жарық рыцарь Гулгвинт
Dialogue: 0,0:07:58.99,0:08:01.66,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:08:01.66,0:08:03.66,Default,,0,0,0,,Буруругару!
Dialogue: 0,0:08:05.66,0:08:10.47,Default,,0,0,0,,Ха! Мен 1 зақым алғандықтан өзімді жақсы сезінбеймін.
Dialogue: 0,0:08:10.47,0:08:14.19,Default,,0,0,0,,Бұл ашулы әділет оқиғасы.
Dialogue: 0,0:08:14.19,0:08:19.69,Default,,0,0,0,,ТЕК ҒАРЫШ ҚАТЫРЫ РАНГА арқанына мін!
Dialogue: 0,0:08:21.63,0:08:26.25,Default,,0,0,0,,Осымен, әділеттіліктің алға ұрпағы
Dialogue: 0,0:08:26.25,0:08:31.96,Default,,0,0,0,,Super Space Hero Extiger!
Dialogue: 0,0:08:31.96,0:08:34.11,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:08:34.11,0:08:36.83,Default,,0,0,0,,Extiger үшін қуат плюс 4000
Dialogue: 0,0:08:36.83,0:08:40.70,Default,,0,0,0,,Әже өнері. Пауэр Plus 4000
Dialogue: 0,0:08:40.70,0:08:43.17,Default,,0,0,0,,Гранхоп дағдылары
Dialogue: 0,0:08:43.17,0:08:48.96,Default,,0,0,0,,Сонымен қатар, қуат плюс 4000, Extiger қуаты 38000
Dialogue: 0,0:08:48.96,0:08:51.11,Default,,0,0,0,,Үлкен көлікті шақыру
Dialogue: 0,0:08:51.11,0:08:53.78,Default,,0,0,0,,ﾊﾞｰｽﾄ！
Dialogue: 0,0:08:53.78,0:08:57.65,Default,,0,0,0,,Grand Vehicle және Extiger үшін Пауэр Plus 4000
Dialogue: 0,0:08:57.65,0:08:59.98,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:08:59.98,0:09:02.62,Default,,0,0,0,,Сіз қалай ойлайсыз? Бір ғана батыр жеткілікті
Dialogue: 0,0:09:02.62,0:09:07.53,Default,,0,0,0,,Сенімді болыңыз, тыныштық сақталады!
Dialogue: 0,0:09:07.53,0:09:10.51,Default,,0,0,0,,Кеттік! Экстижер дағдылары
Dialogue: 0,0:09:10.51,0:09:14.88,Default,,0,0,0,,Пауэр Plus 4000 G аймағы кестесіндегі карталардың санына тең
Dialogue: 0,0:09:14.88,0:09:20.17,Default,,0,0,0,,Енді Extiger қуаты 57000 және критикалық 2
Dialogue: 0,0:09:20.17,0:09:23.11,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:09:23.11,0:09:25.69,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:09:25.69,0:09:29.19,Default,,0,0,0,,Күш - үлкен доп жолағы Критикалық - төтенше!
Dialogue: 0,0:09:33.28,0:09:35.90,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:09:35.90,0:09:39.70,Default,,0,0,0,,Критикалық триггер күші топтық салмаққа өтеді
Dialogue: 0,0:09:43.11,0:09:46.60,Default,,0,0,0,,Цк... Триггердің кесірінен мен Авангардқа жете алмаймын.
Dialogue: 0,0:09:46.60,0:09:50.67,Default,,0,0,0,,Олай болса, оны әзірше тыл сақшыларымен жояық.
Dialogue: 0,0:09:50.67,0:09:52.67,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:09:54.79,0:09:58.51,Default,,0,0,0,,Ей, эй, мені тылдағы күзетшіңмен қорғама➡
Dialogue: 0,0:09:58.51,0:10:00.61,Default,,0,0,0,,Күзетіңізді сақтаңыз.
Dialogue: 0,0:10:00.61,0:10:03.01,Default,,0,0,0,,«Міне, тағы басталды…»
Dialogue: 0,0:10:03.01,0:10:07.80,Default,,0,0,0,,《Төбелесте адамның бәрі көріне ме...?
Dialogue: 0,0:10:07.80,0:10:13.30,Default,,0,0,0,,Сіз оны түсінуге тырысасыз ба, Таййо?
Dialogue: 0,0:10:23.89,0:10:26.64,Default,,0,0,0,,Луна? Ах!
Dialogue: 0,0:10:26.64,0:10:29.14,Default,,0,0,0,,Эхехе...
Dialogue: 0,0:10:34.35,0:10:39.28,Default,,0,0,0,,О, білесің бе, мен сенімен бірдеңені талқылағым келеді...
Dialogue: 0,0:10:39.28,0:10:44.12,Default,,0,0,0,,Бұл мен туралы емес, менің досым туралы ...
Dialogue: 0,0:10:44.12,0:10:50.11,Default,,0,0,0,,Досының досы шынымен қорқынышты нәрсе жасамақ болды...
Dialogue: 0,0:10:50.11,0:10:52.78,Default,,0,0,0,,Бұл болуы мүмкін... Иә?
Dialogue: 0,0:10:52.78,0:10:57.19,Default,,0,0,0,,Луна жеткілікті
Dialogue: 0,0:10:57.19,0:11:00.12,Default,,0,0,0,,ｱﾑ…
Dialogue: 0,0:11:00.12,0:11:04.53,Default,,0,0,0,,Токоха менің де Миджин Роузға байланғанымды біледі➡
Dialogue: 0,0:11:04.53,0:11:06.86,Default,,0,0,0,,Мен осы уақытқа дейін не істедім ...
Dialogue: 0,0:11:06.86,0:11:08.96,Default,,0,0,0,,Осы себептен басқа.
Dialogue: 0,0:12:54.69,0:12:59.19,Default,,0,0,0,,Мынау анамның маған тоқып бергені
Dialogue: 0,0:13:03.78,0:13:08.67,Default,,0,0,0,,Бірақ екіншісі ешқашан тоқылған емес...
Dialogue: 0,0:13:08.67,0:13:11.29,Default,,0,0,0,,(Кенет тежеу дыбысы)
Dialogue: 0,0:13:11.29,0:13:13.29,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:13:18.21,0:13:20.44,Default,,0,0,0,,Қадамдық қақпа ашылады➡
Dialogue: 0,0:13:20.44,0:13:23.66,Default,,0,0,0,,Осы дүниеге кемел келешекке жете алсақ➡
Dialogue: 0,0:13:23.66,0:13:27.32,Default,,0,0,0,,Әкесі де, анасы да оянады.
Dialogue: 0,0:13:27.32,0:13:30.62,Default,,0,0,0,,Өткен бақытсыздықтар жойылады.
Dialogue: 0,0:13:34.51,0:13:38.40,Default,,0,0,0,,Мен ол үшін қандай да бір қорқынышты әрекет жасаймын.
Dialogue: 0,0:13:38.40,0:13:42.50,Default,,0,0,0,,Жоқ... Мен мұны істегім келмейді, бірақ мені мәжбүрлеп жатыр, солай ма?
Dialogue: 0,0:13:45.65,0:13:49.96,Default,,0,0,0,,Мен Шион Кибаны қақпанға түсіргенде көңілді болдым.
Dialogue: 0,0:13:49.96,0:13:54.96,Default,,0,0,0,,Шындық туралы ештеңе білмейтін монах: «Кел, бір қарап көрейік» деп ойлады.
Dialogue: 0,0:13:54.96,0:13:58.32,Default,,0,0,0,,Бұл менің шынайы ниетім
Dialogue: 0,0:13:58.32,0:14:00.97,Default,,0,0,0,,Мен бейбітшілікті сақтаушымын
Dialogue: 0,0:14:00.97,0:14:04.89,Default,,0,0,0,,Крэй планетасынан шақырылған блокты басқарыңыз➡
Dialogue: 0,0:14:04.89,0:14:08.13,Default,,0,0,0,,Қадам қақпасын ашқан...
Dialogue: 0,0:14:08.13,0:14:12.73,Default,,0,0,0,,Лами Лабиринт сол дарынды балалардың арасынан таңдалды.
Dialogue: 0,0:14:14.83,0:14:17.77,Default,,0,0,0,,Бірақ мен ғана жеткілікті
Dialogue: 0,0:14:17.77,0:14:20.94,Default,,0,0,0,,Сізге қажет емес
Dialogue: 0,0:14:20.94,0:14:23.51,Default,,0,0,0,,Екеуің кездескенше.
Dialogue: 0,0:14:23.51,0:14:26.31,Default,,0,0,0,,Біз енді ешқашан кездеспейтін шығармыз.
Dialogue: 0,0:14:33.12,0:14:35.77,Default,,0,0,0,,Ол мұны бұрын да айтқан.
Dialogue: 0,0:14:35.77,0:14:40.96,Default,,0,0,0,,Сахнаға шыққанда маған бұл ұнайды деймін бе?
Dialogue: 0,0:14:40.96,0:14:43.99,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:14:43.99,0:14:48.97,Default,,0,0,0,,Мен түсіндім. Бұл өтірік емес.
Dialogue: 0,0:14:48.97,0:14:52.57,Default,,0,0,0,,Өйткені сен әрқашан қасымда болдың
Dialogue: 0,0:14:55.04,0:14:57.44,Default,,0,0,0,,Мүмкін Ам жаман нәрсе жасаған шығар.
Dialogue: 0,0:14:57.44,0:15:01.31,Default,,0,0,0,,Бұдан былай жағдай нашарлауы мүмкін.
Dialogue: 0,0:15:01.31,0:15:05.10,Default,,0,0,0,,Бірақ мен Амға көмектескім келеді
Dialogue: 0,0:15:05.10,0:15:08.29,Default,,0,0,0,,Мен сенің жаныңда болғым келеді!
Dialogue: 0,0:15:08.29,0:15:13.84,Default,,0,0,0,,Луна көп ойланып жатса, мен ештеңе айта алмаймын.
