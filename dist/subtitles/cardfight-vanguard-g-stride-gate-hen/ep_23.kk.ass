Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.71,0:01:06.16,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:01:06.16,0:01:08.26,Default,,0,0,0,,Қайтып барсам, мен қызбын!
Dialogue: 0,0:01:10.73,0:01:12.72,Default,,0,0,0,,Бұрылыс және аяқтау
Dialogue: 0,0:01:12.72,0:01:17.32,Default,,0,0,0,,Тек 3 қалды. Барлығы жақын арада аяқталады.
Dialogue: 0,0:01:17.32,0:01:22.62,Default,,0,0,0,,Сот келе жатыр. Сіз және бұл әлем ...
Dialogue: 0,0:01:25.75,0:01:28.65,Default,,0,0,0,,Жоғалтпа
Dialogue: 0,0:01:28.65,0:01:32.45,Default,,0,0,0,,Менің ойымша, бұл жалғыз жол.
Dialogue: 0,0:01:34.47,0:01:37.77,Default,,0,0,0,,Мен сенің болашағыңды ешқашан қабылдамаймын!
Dialogue: 0,0:04:49.77,0:04:51.75,Default,,0,0,0,,Мен сенің болашағыңды қабылдамаймын
Dialogue: 0,0:04:51.75,0:04:59.43,Default,,0,0,0,,Vanguard және менің әлемімді ашқан Planet Cray-дегі барлық адамдар үшін...
Dialogue: 0,0:04:59.43,0:05:03.03,Default,,0,0,0,,Сол рухпен күресіп жатқан достарыма!
Dialogue: 0,0:05:05.25,0:05:07.70,Default,,0,0,0,,Ия, бұл елес.
Dialogue: 0,0:05:07.70,0:05:09.79,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:05:09.79,0:05:11.79,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ！
Dialogue: 0,0:05:15.23,0:05:18.43,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:05:20.40,0:05:23.10,Default,,0,0,0,,Иә? Біз неге?
Dialogue: 0,0:05:23.10,0:05:25.09,Default,,0,0,0,,Сіз ұйықтадыңыз ба?
Dialogue: 0,0:05:25.09,0:05:27.07,Default,,0,0,0,,Керемет! Бұл шын ба?
Dialogue: 0,0:05:27.07,0:05:29.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.11,0:05:32.39,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:32.39,0:05:35.88,Default,,0,0,0,,Не... Бұл не?!
Dialogue: 0,0:05:35.88,0:05:39.77,Default,,0,0,0,,А, бұл Курононың бірлігі.
Dialogue: 0,0:05:39.77,0:05:46.07,Default,,0,0,0,,Сонымен, Камуи-сан айтып отырған бірліктер осы ма?
Dialogue: 0,0:05:53.43,0:05:55.75,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:05:55.75,0:05:59.70,Default,,0,0,0,,ｸﾛﾉﾄﾞﾗｺﾞﾝ･ﾈｸｽﾃｰｼﾞ！
Dialogue: 0,0:05:59.70,0:06:02.81,Default,,0,0,0,,Chronoetos Jackal палубаның төменгі жағына қадам басуға дағдыландыру
Dialogue: 0,0:06:02.81,0:06:05.61,Default,,0,0,0,,ｺｰﾙ ｱｯﾌﾟｽﾄﾘｰﾑ･ﾄﾞﾗｺﾞﾝ
Dialogue: 0,0:06:07.54,0:06:11.25,Default,,0,0,0,,Ақырында түсінеріңізге сенімдімін.
Dialogue: 0,0:06:11.25,0:06:14.10,Default,,0,0,0,,Бейнеңізге қанша жұмыс жасасаңыз да➡
Dialogue: 0,0:06:14.10,0:06:17.07,Default,,0,0,0,,Біз бір-бірімізді шынымен түсіне алмаймыз➡
Dialogue: 0,0:06:17.07,0:06:20.07,Default,,0,0,0,,Облигациялар мәңгі бола алмайды
Dialogue: 0,0:06:22.06,0:06:24.26,Default,,0,0,0,,Мен де біраздан бері ойланып жүрмін.
Dialogue: 0,0:06:24.26,0:06:26.30,Default,,0,0,0,,Неге соншалықты ұзаққа бардың➡
Dialogue: 0,0:06:26.30,0:06:28.90,Default,,0,0,0,,Сіз кемел болашақты қалайсыз ба...
Dialogue: 0,0:06:30.88,0:06:33.09,Default,,0,0,0,,Бірақ мен түсінбеймін.
Dialogue: 0,0:06:33.09,0:06:35.76,Default,,0,0,0,,Мен қалай болғанда да түсінгендей болдым➡
Dialogue: 0,0:06:35.76,0:06:38.63,Default,,0,0,0,,Мен де солаймын.
Dialogue: 0,0:06:38.63,0:06:40.66,Default,,0,0,0,,Менің сезімімді жеткіздім деп ойласаңыз да➡
Dialogue: 0,0:06:40.66,0:06:43.16,Default,,0,0,0,,Шындық, мен білмеймін.
Dialogue: 0,0:06:45.58,0:06:48.07,Default,,0,0,0,,Палубаға жоғары қарай
Dialogue: 0,0:06:48.07,0:06:50.59,Default,,0,0,0,,Қалған жағдайда Cosality Dragon деп атаңыз
Dialogue: 0,0:06:50.59,0:06:52.59,Default,,0,0,0,,Қарсылық дағдылары➡
Dialogue: 0,0:06:52.59,0:06:55.76,Default,,0,0,0,,Delay Blazer Dragon үшін Пауэр Plus 2000
Dialogue: 0,0:06:55.76,0:07:00.55,Default,,0,0,0,,Бірақ сол себепті біз ұрысамыз
Dialogue: 0,0:07:00.55,0:07:03.73,Default,,0,0,0,,Қалағаныңызша! Жақсы...
Dialogue: 0,0:07:03.73,0:07:06.92,Default,,0,0,0,,Nexus сахнасында Авангард шабуылы
Dialogue: 0,0:07:06.92,0:07:08.92,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:07:08.92,0:07:10.92,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:07:10.92,0:07:13.93,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:07:13.93,0:07:16.58,Default,,0,0,0,,Блейзерді кешіктіретін қуат!
Dialogue: 0,0:07:16.58,0:07:22.02,Default,,0,0,0,,Мен Авангардты кездестірмейінше бұл туралы ешқашан ойладым.
Dialogue: 0,0:07:22.02,0:07:25.32,Default,,0,0,0,,Бірақ қазір мен көбірек білгім келеді!
Dialogue: 0,0:07:30.54,0:07:32.63,Default,,0,0,0,,Nexus кезеңі шеберлігін белсендіру!
Dialogue: 0,0:07:32.63,0:07:34.63,Default,,0,0,0,,Chronojet стенді!
Dialogue: 0,0:07:36.90,0:07:40.45,Default,,0,0,0,,Достарым туралы білмеген жайттар➡
Dialogue: 0,0:07:40.45,0:07:43.05,Default,,0,0,0,,Мен білмейтін дүние...
Dialogue: 0,0:07:45.91,0:07:49.41,Default,,0,0,0,,Мен өзім туралы білмеген нәрселер!
Dialogue: 0,0:07:51.42,0:07:54.28,Default,,0,0,0,,Бізге кемел болашақ керек емес!
Dialogue: 0,0:07:54.28,0:07:58.47,Default,,0,0,0,,Онда жаңа ештеңе жоқ
Dialogue: 0,0:07:58.47,0:08:02.47,Default,,0,0,0,,Бұл менің қазір білетін дүниемнен құралған дүние!
Dialogue: 0,0:08:04.56,0:08:08.60,Default,,0,0,0,,Chrono Джет көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:08:08.60,0:08:14.05,Default,,0,0,0,,Біз қазір білмейтін келесі болашақты түсінгіміз келеді!
Dialogue: 0,0:08:14.05,0:08:16.11,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:08:16.11,0:08:19.74,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ！ ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:08:19.74,0:08:22.60,Default,,0,0,0,,Барлық әсерлер кешіктірілді!
Dialogue: 0,0:08:22.60,0:08:24.97,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:08:24.97,0:08:30.07,Default,,0,0,0,,(ﾘｭｰｽﾞ)ｶﾞｰﾄﾞ！ ｴﾒﾙｱﾝﾅ！ ｸｲﾝﾃｯﾄｳｫｰﾙ！
Dialogue: 0,0:08:32.09,0:08:34.49,Default,,0,0,0,,Эмериананың шеберлігі
Dialogue: 0,0:08:34.49,0:08:38.96,Default,,0,0,0,,Түсіру аймағынан 1 картаны байлап, палубаға 2 картаны салыңыз
Dialogue: 0,0:08:38.96,0:08:41.26,Default,,0,0,0,,ｸﾛﾉﾎﾞﾚｰ･ﾗﾋﾞｯﾄ！
Dialogue: 0,0:08:44.72,0:08:49.42,Default,,0,0,0,,Келесі болашақ... немесе...
Dialogue: 0,0:08:49.42,0:08:53.06,Default,,0,0,0,,Бағасы – азап пен қасірет➡
Dialogue: 0,0:08:53.06,0:08:58.75,Default,,0,0,0,,Зорлық-зомбылық пен жанжал Бұл шексіз үмітсіздік пе?
Dialogue: 0,0:08:58.75,0:09:00.73,Default,,0,0,0,,Хронофанг дағдылары
Dialogue: 0,0:09:00.73,0:09:04.76,Default,,0,0,0,,Kurono Claw Monkey таңдап, Transcendence Cost-ке қосылыңыз.
Dialogue: 0,0:09:04.76,0:09:09.76,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:09.76,0:09:11.80,Default,,0,0,0,,1 тағы да
Dialogue: 0,0:09:11.80,0:09:13.76,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:09:13.76,0:09:18.25,Default,,0,0,0,,Егер сіз жаңа нәрсе іздесеңіз, сіз ештеңе ала алмайсыз.
Dialogue: 0,0:09:18.25,0:09:21.47,Default,,0,0,0,,Осындай белгісіздіктің орнына➡
Dialogue: 0,0:09:21.47,0:09:25.07,Default,,0,0,0,,Төленетін баға тым ауыр.
Dialogue: 0,0:09:27.71,0:09:32.27,Default,,0,0,0,,Қазір әкеліңіз! Әлемді құтқаратын тамаша болашақ!
Dialogue: 0,0:09:32.27,0:09:34.43,Default,,0,0,0,,Transcend!
Dialogue: 0,0:09:34.43,0:09:40.04,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:40.04,0:09:44.59,Default,,0,0,0,,ﾃﾞｳｽｴｸｽﾏｷﾅ ﾃﾞﾐｳﾙｺﾞｽ
Dialogue: 0,0:09:44.59,0:09:47.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:47.90,0:09:50.43,Default,,0,0,0,,Тек үміт бар деп ойламаңыз!
Dialogue: 0,0:09:50.43,0:09:54.44,Default,,0,0,0,,ｺｰﾙ ｱﾅｰｷｱ･ｲﾃﾞｱﾄﾞﾛｰﾝ！
Dialogue: 0,0:09:54.44,0:09:57.72,Default,,0,0,0,,Мен бұл жетілмеген дүниені қайта жасаймын➡
Dialogue: 0,0:09:57.72,0:10:00.43,Default,,0,0,0,,Кемел болашаққа жетелейді!
Dialogue: 0,0:10:00.43,0:10:03.26,Default,,0,0,0,,Анархияның шеберлігі іске қосылды!
Dialogue: 0,0:10:03.26,0:10:07.05,Default,,0,0,0,,Жан және түсіру аймағынан бір тісті доңғалақты таңдаңыз➡
Dialogue: 0,0:10:07.05,0:10:11.09,Default,,0,0,0,,Оны өзіңізбен бірге палубаға қайтарыңыз және араластырыңыз➡
Dialogue: 0,0:10:11.09,0:10:16.06,Default,,0,0,0,,Палубаның жоғарғы үш картасына қараңыз, біреуін қолыңызға, екіншісін жаныңызға салыңыз➡
Dialogue: 0,0:10:16.06,0:10:18.56,Default,,0,0,0,,Және бір картаны байлаңыз!
Dialogue: 0,0:10:24.08,0:10:27.70,Default,,0,0,0,,Сіз Курононы түсінбейсіз
Dialogue: 0,0:10:27.70,0:10:29.76,Default,,0,0,0,,Хроно Дранды байлаңыз!
Dialogue: 0,0:10:29.76,0:10:35.23,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:35.23,0:10:37.93,Default,,0,0,0,,ｺｰﾙ ｸﾛﾉﾌｧﾝｸﾞ･ﾀｲｶﾞｰ！
Dialogue: 0,0:10:37.93,0:10:40.92,Default,,0,0,0,,Demiurgos шеберлігі іске қосылды!
Dialogue: 0,0:10:40.92,0:10:44.37,Default,,0,0,0,,12 зодиак уақытындағы Биндзонның әртүрлі есімдері бар аңдар➡
Dialogue: 0,0:10:44.37,0:10:46.44,Default,,0,0,0,,Түсіру аймағына
Dialogue: 0,0:10:46.44,0:10:57.72,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:57.72,0:11:01.42,Default,,0,0,0,,Содан кейін палубаның жоғарғы жағына түсіру аймағынан 12 картаны қойыңыз➡
Dialogue: 0,0:11:01.42,0:11:03.41,Default,,0,0,0,,Кез келген ретпен орналастырыңыз
Dialogue: 0,0:11:03.41,0:11:08.06,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:08.06,0:11:12.13,Default,,0,0,0,,ﾃﾘｵｽ･ﾊﾟﾗﾃﾞｨｿｽ
Dialogue: 0,0:11:12.13,0:11:14.73,Default,,0,0,0,,Болашақ енді шешілді.
Dialogue: 0,0:12:55.75,0:13:07.31,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:07.31,0:13:13.92,Default,,0,0,0,,Әр адам жаңа болашаққа сену үмітін ұстанғысы келеді.
Dialogue: 0,0:13:13.92,0:13:19.43,Default,,0,0,0,,Бұл орындалмайтындықтан, бұл үмітсіздік деп аталады.
Dialogue: 0,0:13:19.43,0:13:22.88,Default,,0,0,0,,Жассың, түсінбейсің.
Dialogue: 0,0:13:22.88,0:13:27.43,Default,,0,0,0,,Осы арқылы ғана құтқарылатын үмітсіздіктер бар!
Dialogue: 0,0:13:27.43,0:13:32.06,Default,,0,0,0,,Өтірік немесе қашу деп ойласаңыз, қаласаңыз күліңіз!
Dialogue: 0,0:13:32.06,0:13:36.98,Default,,0,0,0,,Менің жалғыз үмітімде осы кемел келешекке деген сағынышым➡
Dialogue: 0,0:13:36.98,0:13:40.48,Default,,0,0,0,,Сіз оны жоққа шығара аласыз ба, Синдо Куроно!
Dialogue: 0,0:13:42.40,0:13:48.89,Default,,0,0,0,,Ата-бабамыз құрлыққа аттанды, әрең дем алып, шекараға бет алды.
Dialogue: 0,0:13:48.89,0:13:51.94,Default,,0,0,0,,Бірақ ол жерде ештеңе болған жоқ.
Dialogue: 0,0:13:51.94,0:13:54.54,Default,,0,0,0,,Үмітсіздік пен азаптан басқа ештеңе жоқ
Dialogue: 0,0:13:54.54,0:13:57.96,Default,,0,0,0,,Ендеше бәрі бейнелер теңізіне батып кетсін
Dialogue: 0,0:13:57.96,0:14:03.09,Default,,0,0,0,,Мен бізді қорғайтын мейірімді әлемде мәңгі өмір сүргім келеді!
Dialogue: 0,0:14:03.09,0:14:05.21,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:14:05.21,0:14:07.79,Default,,0,0,0,,Сонда да мен бармын, біз бармыз➡
Dialogue: 0,0:14:07.79,0:14:09.79,Default,,0,0,0,,Әлі де осында!
Dialogue: 0,0:14:11.73,0:14:13.78,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ
Dialogue: 0,0:14:13.78,0:14:16.92,Default,,0,0,0,,Кеңістік-уақыт айдаһары Гетероайналы Айдаһар!
Dialogue: 0,0:14:16.92,0:14:19.30,Default,,0,0,0,,Әр түрлі дағдыларды белсендіру!
Dialogue: 0,0:14:19.30,0:14:21.90,Default,,0,0,0,,Хронофанг жолбарыстарын палубаға салыңыз!
Dialogue: 0,0:14:24.93,0:14:28.43,Default,,0,0,0,,Ой, ақымақ күрес
Dialogue: 0,0:14:28.43,0:14:32.72,Default,,0,0,0,,Егер сіз оны палубаға жіберсеңіз, палубаны араластырыңыз!
Dialogue: 0,0:14:32.72,0:14:39.41,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:39.41,0:14:41.88,Default,,0,0,0,,Егер бұл араластыру болса...
Dialogue: 0,0:14:41.88,0:14:47.76,Default,,0,0,0,,Сонымен қатар, ең жақсысы - Superior Call!
Dialogue: 0,0:14:47.76,0:14:49.92,Default,,0,0,0,,Ештеңе тасқа басылған жоқ!
Dialogue: 0,0:14:49.92,0:14:52.25,Default,,0,0,0,,Біз өмір сүргенше!
Dialogue: 0,0:14:52.25,0:14:56.09,Default,,0,0,0,,Одан да сақ болыңыз! Кесу!
Dialogue: 0,0:14:56.09,0:15:00.76,Default,,0,0,0,,Тіпті... Болашақ жойылса да➡
Dialogue: 0,0:15:00.76,0:15:05.67,Default,,0,0,0,,Жиналған үміттер триггер ретінде осында қалады
Dialogue: 0,0:15:05.67,0:15:09.77,Default,,0,0,0,,Сонда да тағдыр өз қолымызда!
Dialogue: 0,0:15:11.79,0:15:15.54,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:15:15.54,0:15:18.90,Default,,0,0,0,,Барлық әсерлер демиургозды
Dialogue: 0,0:15:18.90,0:15:21.56,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:15:21.56,0:15:24.57,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:15:24.57,0:15:26.92,Default,,0,0,0,,Қуат – демиург
Dialogue: 0,0:15:26.92,0:15:29.92,Default,,0,0,0,,Маңызды мәселелер үшін маннанды бу уақыты бөліміне өтіңіз!
Dialogue: 0,0:15:29.92,0:15:32.63,Default,,0,0,0,,Мен сені қорғаймын!
Dialogue: 0,0:15:32.63,0:15:34.73,Default,,0,0,0,,Кемелді болашақ
Dialogue: 0,0:15:38.23,0:15:40.87,Default,,0,0,0,,Барлығы күлетін әлем!
Dialogue: 0,0:15:40.87,0:16:00.07,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:00.07,0:16:02.42,Default,,0,0,0,,ｱﾀｯｸ！ ｶﾞｰﾄﾞ！
Dialogue: 0,0:16:02.42,0:16:08.42,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:10.76,0:16:13.77,Default,,0,0,0,,Сіз солай айттыңыз.
Dialogue: 0,0:16:13.77,0:16:16.77,Default,,0,0,0,,«Бейненің күші шексіз».
Dialogue: 0,0:16:16.77,0:16:20.41,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:16:20.41,0:16:23.74,Default,,0,0,0,,Сондықтан мен бас тартқым келмейді
Dialogue: 0,0:16:23.74,0:16:28.04,Default,,0,0,0,,Оның әдемі екеніне күлетін шығарсыз, бірақ
Dialogue: 0,0:16:35.07,0:16:37.07,Default,,0,0,0,,ﾄｺﾊ…
Dialogue: 0,0:16:39.81,0:16:41.81,Default,,0,0,0,,ｼｵﾝ…
Dialogue: 0,0:16:44.73,0:16:46.73,Default,,0,0,0,,ﾀｲﾖｳ…
Dialogue: 0,0:16:48.82,0:16:52.82,Default,,0,0,0,,ｱﾑ… ﾙｰﾅ…
Dialogue: 0,0:16:55.48,0:16:57.48,Default,,0,0,0,,Ибуки...
Dialogue: 0,0:17:00.75,0:17:04.08,Default,,0,0,0,,Бір жыл ғана болды.
Dialogue: 0,0:17:04.08,0:17:08.79,Default,,0,0,0,,Мен Авангардпен таныстым, сол жігіттермен таныстым...
Dialogue: 0,0:17:08.79,0:17:12.39,Default,,0,0,0,,Мен дәл қазір осында тұрмын
Dialogue: 0,0:17:14.43,0:17:17.75,Default,,0,0,0,,Әлемді өзгертуге болады
Dialogue: 0,0:17:17.75,0:17:21.38,Default,,0,0,0,,Ол жұмыс істемеуі мүмкін
Dialogue: 0,0:17:21.38,0:17:26.46,Default,,0,0,0,,Ауырсыну мен азап ешқашан кетпеуі мүмкін
Dialogue: 0,0:17:26.46,0:17:31.76,Default,,0,0,0,,Сонда да мен өз әлеуетімізге сенгім келеді!
Dialogue: 0,0:17:36.05,0:17:38.08,Default,,0,0,0,,Біз алға!
Dialogue: 0,0:17:38.08,0:17:41.70,Default,,0,0,0,,Бұдан әрі жалғасатын жаңа болашаққа!
Dialogue: 0,0:17:41.70,0:17:54.10,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:54.10,0:17:57.12,Default,,0,0,0,,А, дұрыс, Куроно!
Dialogue: 0,0:17:57.12,0:18:01.12,Default,,0,0,0,,Амигос таңдайтын әлем - біз сенетін әлем!
Dialogue: 0,0:18:06.40,0:18:09.42,Default,,0,0,0,,Жаңа әлемді қабылдаңыз!
Dialogue: 0,0:18:09.42,0:18:12.05,Default,,0,0,0,,Сіз сенетін жол!
Dialogue: 0,0:18:12.05,0:18:16.09,Default,,0,0,0,,Бірге бола алмасақ та, ойымыз бір
Dialogue: 0,0:18:16.09,0:18:20.71,Default,,0,0,0,,Авангардпен байланыстырылған әлем мағынасыз емес!
Dialogue: 0,0:18:20.71,0:18:33.09,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:33.09,0:18:36.46,Default,,0,0,0,,Мен саған дәмді тамақ әкелдім.
Dialogue: 0,0:18:36.46,0:18:39.05,Default,,0,0,0,,Сәлем, Куроно-сан!
Dialogue: 0,0:18:39.05,0:18:42.43,Default,,0,0,0,,Біздің ойымызды қабыл алыңыз!
Dialogue: 0,0:18:42.43,0:18:45.07,Default,,0,0,0,,Осымен жеңілсең, мен сені кешірмеймін!
Dialogue: 0,0:18:45.07,0:18:48.42,Default,,0,0,0,,Зұлым ұйымдарды бөлшектеңіз!
Dialogue: 0,0:18:48.42,0:18:50.76,Default,,0,0,0,,Ал тез үйге кел.
Dialogue: 0,0:18:50.76,0:18:54.41,Default,,0,0,0,,Сізді жеңетін біз... (Цунето және т.б.) Тринит айдаһары!
Dialogue: 0,0:18:54.41,0:18:56.41,Default,,0,0,0,,Тек біз ғана мұны түсіне аламыз, иә?
Dialogue: 0,0:18:59.47,0:19:03.47,Default,,0,0,0,,Токоха-чан Аму-чан Луна-чан
Dialogue: 0,0:19:08.12,0:19:11.12,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:19:15.10,0:19:18.17,Default,,0,0,0,,Бәрінен де асып түсетін ғажайып күшпен➡
Dialogue: 0,0:19:18.17,0:19:21.80,Default,,0,0,0,,Бұл сіз сұраған нәрсе ме?
Dialogue: 0,0:19:21.80,0:19:27.10,Default,,0,0,0,,Өз қолыңмен ұстамасаң, қандай жеңіс бар!
Dialogue: 0,0:19:37.09,0:19:42.14,Default,,0,0,0,,Stride Force әлемнің түкпір-түкпірінен келген жауынгерлерден жиналады
Dialogue: 0,0:19:42.14,0:19:48.05,Default,,0,0,0,,Сізге сеніп тапсырған таңдауымыз қате болған жоқ.
Dialogue: 0,0:19:48.05,0:20:40.07,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:40.07,0:20:44.72,Default,,0,0,0,,Сіз шынымен... жақсы күрескер болып өстіңіз.
Dialogue: 0,0:20:44.72,0:20:48.73,Default,,0,0,0,,Ұстаз, сіздің ұлыңыз...
Dialogue: 0,0:20:48.73,0:21:08.76,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:08.76,0:21:10.71,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:21:10.71,0:21:20.77,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:20.77,0:21:22.84,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:21:22.84,0:21:41.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:46.43,0:22:31.74,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:31.74,0:22:36.88,Default,,0,0,0,,Қазір маған шынымен қалайтын әлемді көрсететін кез келді!
Dialogue: 0,0:22:36.88,0:22:42.09,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ!!
Dialogue: 0,0:22:42.09,0:22:49.05,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:49.05,0:22:53.15,Default,,0,0,0,,ｸﾛﾉﾄﾞﾗｺﾞﾝ･ｷﾞｱｸﾞﾙｰﾋﾞｰ！
Dialogue: 0,0:22:53.15,0:23:03.06,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:03.06,0:23:08.26,Default,,0,0,0,,Егер бұл жаңа бірлік болса...
Dialogue: 0,0:23:08.26,0:23:12.40,Default,,0,0,0,,Корсалықты жылжыту. Gear Wolf-ке қоңырау шалыңыз!
Dialogue: 0,0:23:12.40,0:23:14.59,Default,,0,0,0,,Gear Group Ruby шеберлігі іске қосылды!
Dialogue: 0,0:23:14.59,0:23:18.47,Default,,0,0,0,,G аймағынан 2 тісті айдаһарға дейін таңдаңыз!
Dialogue: 0,0:23:18.47,0:23:24.05,Default,,0,0,0,,Gear тобы Chronos Command және келесі кезең үшін әрқайсысы бір дағдыға ие болады!
Dialogue: 0,0:23:24.05,0:23:29.22,Default,,0,0,0,,Жинақталған өткен жаңа болашаққа апаратын күшке айналады!
Dialogue: 0,0:23:29.22,0:23:33.32,Default,,0,0,0,,Көбірек беріліс тобының дағдылары! Қуат плюс 5000
Dialogue: 0,0:23:36.56,0:23:39.10,Default,,0,0,0,,ﾘｭｰｽﾞ
Dialogue: 0,0:23:39.10,0:23:46.40,Default,,0,0,0,,Бейнелердің күшіне көп сенбейтін сіз шығарсыз.
Dialogue: 0,0:23:46.40,0:23:49.77,Default,,0,0,0,,Gear тобымен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:23:49.77,0:23:52.09,Default,,0,0,0,,Cronos командалық дағдылары!
Dialogue: 0,0:23:52.09,0:23:55.73,Default,,0,0,0,,Бұл шабуыл жасалғанда, қарсыласыңыздың барлық артқы күзетшілерін жойыңыз➡
Dialogue: 0,0:23:55.73,0:23:58.93,Default,,0,0,0,,Палубаға оралыңыз! Қарғыс атсын...!
Dialogue: 0,0:23:58.93,0:24:02.30,Default,,0,0,0,,《Артқы қорғаушы палубаға қайта оралса➡
Dialogue: 0,0:24:02.30,0:24:06.76,Default,,0,0,0,,Gear Wolf осы санмен қуаттанады...》
Dialogue: 0,0:24:06.76,0:24:10.36,Default,,0,0,0,,ｶﾞｰﾄﾞ！ ｴﾒﾙｱﾝﾅ ｸｲﾝﾃｯﾄｳｫｰﾙ
Dialogue: 0,0:24:13.40,0:24:16.77,Default,,0,0,0,,Эмеранна шеберлігі 1 дана байлау
Dialogue: 0,0:24:16.77,0:24:18.94,Default,,0,0,0,,Палубаға 2 картаны салыңыз
Dialogue: 0,0:24:18.94,0:24:22.39,Default,,0,0,0,,Сіз оны жоққа шығарасыз ба! Керемет болашаққа➡
Dialogue: 0,0:24:22.39,0:24:25.42,Default,,0,0,0,,Түпкілікті құтқарылуды іздейтіндер!
Dialogue: 0,0:24:25.42,0:24:29.75,Default,,0,0,0,,Келесі кезең дағдысы іске қосылды! Chronojet тірегі
Dialogue: 0,0:24:29.75,0:24:32.72,Default,,0,0,0,,Болашақты құтқаратын жалғыз үміт➡
Dialogue: 0,0:24:32.72,0:24:38.30,Default,,0,0,0,,Оны өз қолыңмен құртпақсың ба? Үміт бар!
Dialogue: 0,0:24:38.30,0:24:43.10,Default,,0,0,0,,Біз берілмесек, ол жоғалмайды!
Dialogue: 0,0:24:46.41,0:24:49.10,Default,,0,0,0,,Болашақта қандай ауыртпалық болмасын➡
Dialogue: 0,0:24:49.10,0:24:52.08,Default,,0,0,0,,Біз жинаған уақыт➡
Dialogue: 0,0:24:52.08,0:24:56.71,Default,,0,0,0,,Бізді байланыстыратын байланыстар... алға ұмтылуға күш береді!
Dialogue: 0,0:24:56.71,0:24:59.91,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:24:59.91,0:25:02.09,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:25:02.09,0:25:06.25,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ｡ ﾌｧｰｽﾄﾁｪｯｸ！
Dialogue: 0,0:25:06.25,0:25:10.20,Default,,0,0,0,,Кеттік... бәріміз➡
Dialogue: 0,0:25:10.20,0:25:14.76,Default,,0,0,0,,Келесі болашаққа!
Dialogue: 0,0:25:14.76,0:25:19.08,Default,,0,0,0,,Критикалық триггер! Барлық әсерлер Chronojet-те !!
Dialogue: 0,0:25:19.08,0:25:28.39,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:28.39,0:25:31.59,Default,,0,0,0,,Әлі біткен жоқ...
Dialogue: 0,0:25:31.59,0:25:35.75,Default,,0,0,0,,Ол аяқталса не болады?
Dialogue: 0,0:25:35.75,0:25:37.88,Default,,0,0,0,,ﾋｰﾙﾄﾘｶﾞｰ
Dialogue: 0,0:25:37.88,0:25:42.82,Default,,0,0,0,,Менің болашағым тамаша...
Dialogue: 0,0:25:42.82,0:25:53.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:53.01,0:25:56.62,Default,,0,0,0,,Неге!!
Dialogue: 0,0:25:56.62,0:26:33.72,Default,,0,0,0,,♪♪～
Dialogue: 0,0:30:38.70,0:30:43.77,Default,,0,0,0,,<Қалада жаздың ыстық болғаны сонша, енді шыдай алмаймын
Dialogue: 0,0:30:43.77,0:30:46.89,Default,,0,0,0,,Ендеше солтүстік елге секірейік.
Dialogue: 0,0:30:46.89,0:30:49.24,Default,,0,0,0,,Жаңа Хитоза әуежайының жанында→
Dialogue: 0,0:30:49.24,0:30:52.63,Default,,0,0,0,,Танымал порт қаласына барайық
Dialogue: 0,0:30:52.63,0:30:55.75,Default,,0,0,0,,Мұнда сізді қызықты пейзаж күтіп тұр →
Dialogue: 0,0:30:55.75,0:30:57.75,Default,,0,0,0,,Экзотикалық қала пейзажы
Dialogue: 0,0:30:59.25,0:31:05.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory