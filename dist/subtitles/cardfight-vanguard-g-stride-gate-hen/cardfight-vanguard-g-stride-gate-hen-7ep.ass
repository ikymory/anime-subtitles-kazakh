Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:12.94,0:01:18.13,Default,,0,0,0,,Уау...
Dialogue: 0,0:01:18.13,0:01:20.46,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:01:20.46,0:01:23.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:23.70,0:01:26.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:28.96,0:01:32.44,Default,,0,0,0,,((Льюс: Куроно Жақындарыңызға➡
Dialogue: 0,0:01:32.44,0:01:36.54,Default,,0,0,0,,Шын болашағыңызды құрбан еткіңіз келмейді ме? ))
Dialogue: 0,0:01:48.96,0:01:50.96,Default,,0,0,0,,Ағай...
Dialogue: 0,0:05:06.42,0:05:08.48,Default,,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:05:08.48,0:05:12.48,Default,,0,0,0,,Біз оны көрдік. Құрылғы шынымен пайда болды➡
Dialogue: 0,0:05:12.48,0:05:15.98,Default,,0,0,0,,Мен жынды болдым...
Dialogue: 0,0:05:15.98,0:05:18.67,Default,,0,0,0,,Жарайсыңдар, балалар аман-есен болғандарыңа қуаныштымын.
Dialogue: 0,0:05:18.67,0:05:20.67,Default,,0,0,0,,Камуи мырза!
Dialogue: 0,0:05:22.61,0:05:27.48,Default,,0,0,0,,《Компания жігіттері Юна-санның соңынан Доранға барады
Dialogue: 0,0:05:27.48,0:05:29.63,Default,,0,0,0,,ｸｿ…》
Dialogue: 0,0:05:29.63,0:05:33.82,Default,,0,0,0,,«Себебі белгісіз жұмбақ апат»?
Dialogue: 0,0:05:33.82,0:05:37.49,Default,,0,0,0,,Көптеген жарақат алды, ғимарат жартылай қирады
Dialogue: 0,0:05:37.49,0:05:41.59,Default,,0,0,0,,Дораен тармақ ретіндегі қызметін толығымен жоғалтты.
Dialogue: 0,0:05:41.59,0:05:44.85,Default,,0,0,0,,Жалпы жұртшылықтың басынан өтпеген жалғыз нәрсе ➡ болды
Dialogue: 0,0:05:44.85,0:05:47.35,Default,,0,0,0,,Бақытымызға орай
Dialogue: 0,0:05:53.42,0:05:55.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:55.51,0:05:57.81,Default,,0,0,0,,Сен
Dialogue: 0,0:06:03.10,0:06:06.57,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:06:06.57,0:06:08.42,Default,,0,0,0,,Аурухана
Dialogue: 0,0:06:08.42,0:06:10.82,Default,,0,0,0,,Аурухана…
Dialogue: 0,0:06:10.82,0:06:15.96,Default,,0,0,0,,Мен көремін. Токоха жақсысың ба?
Dialogue: 0,0:06:15.96,0:06:20.00,Default,,0,0,0,,Иә, өйткені мені ағам қорғады.
Dialogue: 0,0:06:20.00,0:06:22.10,Default,,0,0,0,,Жақсы
Dialogue: 0,0:06:36.96,0:06:39.02,Default,,0,0,0,,Луна неге?
Dialogue: 0,0:06:39.02,0:06:43.32,Default,,0,0,0,,Іске қосу экспериментінен кейін бірден модуляция белгілері байқалды.
Dialogue: 0,0:06:45.64,0:06:50.93,Default,,0,0,0,,Құрылғыны басқару үшін үлкен қадам күші қажет.
Dialogue: 0,0:06:50.93,0:06:54.13,Default,,0,0,0,,Әрқашан қадам күшін беріңіз➡
Dialogue: 0,0:06:54.13,0:06:57.52,Default,,0,0,0,,Борышкерді күштеп салыңыз
Dialogue: 0,0:06:57.52,0:07:00.47,Default,,0,0,0,,Борышкердің денесі жүктемеге төтеп бере алмайды➡
Dialogue: 0,0:07:00.47,0:07:04.48,Default,,0,0,0,,Айқай
Dialogue: 0,0:07:04.48,0:07:10.10,Default,,0,0,0,,Бірақ Луна Юдзуки басқаша болды.
Dialogue: 0,0:07:10.10,0:07:29.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:29.92,0:07:35.02,Default,,0,0,0,,((Луна: Ух...
Dialogue: 0,0:07:38.14,0:07:43.14,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:07:46.30,0:07:50.95,Default,,0,0,0,,ﾙｰﾅ ﾙｰﾅ！))
Dialogue: 0,0:07:50.95,0:07:57.68,Default,,0,0,0,,Өзгеріс тәнге емес, рухқа келді.
Dialogue: 0,0:07:57.68,0:08:00.48,Default,,0,0,0,,)
Dialogue: 0,0:08:04.28,0:08:07.97,Default,,0,0,0,,Ал іс жүзінде тәуелді картаны қолданыңыз→
Dialogue: 0,0:08:07.97,0:08:10.32,Default,,0,0,0,,Күшті көрсету арқылы➡
Dialogue: 0,0:08:10.32,0:08:12.79,Default,,0,0,0,,Луна Юдзуки өз сезімін жоғалтады➡
Dialogue: 0,0:08:12.79,0:08:17.87,Default,,0,0,0,,Ол тек құрылғыны іске қосу үшін ғана бар болды.
Dialogue: 0,0:08:17.87,0:08:22.87,Default,,0,0,0,,Ол нағыз бітімгер болды
Dialogue: 0,0:08:31.65,0:08:35.63,Default,,0,0,0,,♬~
Dialogue: 0,0:08:35.63,0:08:41.34,Default,,0,0,0,,Менің күшім жоқ болғандықтан, Луна...
Dialogue: 0,0:08:41.34,0:08:46.34,Default,,0,0,0,,Кешіріңіз Луна, кешіріңіз
Dialogue: 0,0:08:52.67,0:08:58.17,Default,,0,0,0,,)
Dialogue: 0,0:09:01.23,0:09:04.29,Default,,0,0,0,,Ахахха! Күте тұрыңыз! Амал жоқ!
Dialogue: 0,0:09:04.29,0:09:12.44,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:12.44,0:09:17.17,Default,,0,0,0,,((Мен сенімен шынайы болашақты түсінгім келеді.
Dialogue: 0,0:09:17.17,0:09:21.77,Default,,0,0,0,,Мен ертең осы уақытта осы жерде күтемін))
Dialogue: 0,0:09:23.95,0:09:31.14,Default,,0,0,0,,《Егер менің барлығы бақытты болатын болашағым болса, мен...》
Dialogue: 0,0:09:31.14,0:09:43.77,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:43.77,0:09:48.82,Default,,0,0,0,,《Неге, неге бұлай болды?》
Dialogue: 0,0:09:48.82,0:09:52.48,Default,,0,0,0,,ﾄｺﾊ ﾄｺﾊ
Dialogue: 0,0:09:52.48,0:09:55.11,Default,,0,0,0,,Кешіріңіз, су алғыңыз келе ме?
Dialogue: 0,0:09:55.11,0:09:58.03,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:09:58.03,0:10:01.47,Default,,0,0,0,,(ﾉｯｸ)
Dialogue: 0,0:10:01.47,0:10:03.97,Default,,0,0,0,,Ибуки мырза
Dialogue: 0,0:10:05.97,0:10:10.98,Default,,0,0,0,,Мен таза ауа жұтып алайын.
Dialogue: 0,0:10:10.98,0:10:14.31,Default,,0,0,0,,ертең оны үйіңізге әкеліп береміз.
Dialogue: 0,0:10:14.31,0:10:16.70,Default,,0,0,0,,Сіз әбден шаршаған сияқтысыз.
Dialogue: 0,0:10:16.70,0:10:21.10,Default,,0,0,0,,Ол Лами Лабиринттің екі мүшесімен жақын болған сияқты.
Dialogue: 0,0:10:21.10,0:10:23.69,Default,,0,0,0,,Бұл шындықты қалай қабылдауымыз керек➡
Dialogue: 0,0:10:23.69,0:10:26.49,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:10:32.30,0:10:36.80,Default,,0,0,0,,《Рин: Не... Токоха Анжу. Неге кенеттен!?》
Dialogue: 0,0:10:39.31,0:10:42.41,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:10:45.13,0:10:48.52,Default,,0,0,0,,Елеусіз!?
Dialogue: 0,0:10:48.52,0:10:51.79,Default,,0,0,0,,Ибуки-кун, Кега ше?
Dialogue: 0,0:10:51.79,0:10:54.82,Default,,0,0,0,,Көріп отырғаныңыздай, сізбен салыстырғанда➡
Dialogue: 0,0:10:54.82,0:10:56.96,Default,,0,0,0,,Оны кега деп те атауға болмайды.
Dialogue: 0,0:10:56.96,0:11:03.16,Default,,0,0,0,,Ибуки-кун күткендей
Dialogue: 0,0:11:03.16,0:11:06.32,Default,,0,0,0,,Бәріне менің кінәм
Dialogue: 0,0:11:06.32,0:11:08.77,Default,,0,0,0,,Менің түсінігімнің аңғалдығы➡
Dialogue: 0,0:11:08.77,0:11:12.97,Default,,0,0,0,,Бірінен соң бірі шабуылдарына жол беруі осы жағдайға әкелді.
Dialogue: 0,0:11:12.97,0:11:14.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:14.96,0:11:18.65,Default,,0,0,0,,Ибуки-кун... өтінемін.
Dialogue: 0,0:11:18.65,0:11:21.53,Default,,0,0,0,,Менің үлкен артықшылығым болса да➡
Dialogue: 0,0:11:21.53,0:11:24.35,Default,,0,0,0,,Барлығын қорғай алмады
Dialogue: 0,0:11:24.35,0:11:27.15,Default,,0,0,0,,Бұл сіздің жауапкершілігіңіз ғана емес.
Dialogue: 0,0:11:29.49,0:11:31.86,Default,,0,0,0,,《Егер сол уақытта➡
Dialogue: 0,0:11:31.86,0:11:35.16,Default,,0,0,0,,Егер мен оларды дұрыс тоқтатқан болсам...》
Dialogue: 0,0:11:40.15,0:11:43.82,Default,,0,0,0,,《Жоқ, менің басым мүлдем айнала алмайды.
Dialogue: 0,0:11:43.82,0:11:46.42,Default,,0,0,0,,Менің ойыма ештеңе келмейді.
Dialogue: 0,0:11:51.43,0:11:54.30,Default,,0,0,0,,Осы Рин Хашиманы елемеуге қалай дәтің бар?
Dialogue: 0,0:11:54.30,0:11:57.68,Default,,0,0,0,,Сен маған көп өтірік айтасың.
Dialogue: 0,0:11:57.68,0:12:02.48,Default,,0,0,0,,Ұрпақ ұстазы болған соң өзіңізді жақсы сезінбейсіз бе?
Dialogue: 0,0:12:05.13,0:12:07.98,Default,,0,0,0,,Ей!
Dialogue: 0,0:12:07.98,0:12:10.96,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:12:10.96,0:12:13.38,Default,,0,0,0,,Сіз мені екі рет елемедіңіз.
Dialogue: 0,0:12:13.38,0:12:15.80,Default,,0,0,0,,Мен сені ұрыс-керіспен жазалаймын.
Dialogue: 0,0:12:15.80,0:12:17.92,Default,,0,0,0,,(ﾉｯｸ)
Dialogue: 0,0:12:17.92,0:12:21.98,Default,,0,0,0,,Иә
Dialogue: 0,0:12:21.98,0:12:23.96,Default,,0,0,0,,ｸﾛﾉ…
Dialogue: 0,0:12:23.96,0:12:26.00,Default,,0,0,0,,Осы уақытқа дейін қайда болдың?
Dialogue: 0,0:12:26.00,0:12:28.35,Default,,0,0,0,,Мен онымен байланыса алмаймын және ол сабаққа келмейді➡
Dialogue: 0,0:12:28.35,0:12:30.65,Default,,0,0,0,,Микуру-сан да қобалжыды...
Dialogue: 0,0:12:34.71,0:12:36.71,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:12:38.93,0:12:42.46,Default,,0,0,0,,Жүрекпен шабуыл!
Dialogue: 0,0:12:42.46,0:12:48.44,Default,,0,0,0,,Авангардқа Гавриэльмен шабуыл жасаңыз!
Dialogue: 0,0:12:48.44,0:12:52.59,Default,,0,0,0,,《Мен неге ұрысып жатырмын?》
Dialogue: 0,0:12:52.59,0:12:56.64,Default,,0,0,0,,《Төбелес басталғаннан кейін де мотивациясыз қатынас
Dialogue: 0,0:12:56.64,0:12:59.26,Default,,0,0,0,,Бұл Анджо Токоха ма?
Dialogue: 0,0:12:59.26,0:13:03.97,Default,,0,0,0,,Мен істеп жатқаныма қарамастан, сіз аттарды алып жатырсыз ба?
Dialogue: 0,0:13:03.97,0:13:08.71,Default,,0,0,0,,Армандарды айналдыратын Ranunculus Earthsha
Dialogue: 0,0:13:08.71,0:13:12.31,Default,,0,0,0,,Эльмиге қадам жасау шеберлігімен қоңырау шалыңыз
Dialogue: 0,0:13:14.33,0:13:18.00,Default,,0,0,0,,《Мына жігіттің көңілі қалды ма? 》
Dialogue: 0,0:13:18.00,0:13:21.10,Default,,0,0,0,,Dream-Spinning Asher көмегімен Авангардқа шабуыл жасаңыз
Dialogue: 0,0:13:21.10,0:13:24.50,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ｡ ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:13:24.50,0:13:28.78,Default,,0,0,0,,Драен филиалы Бұл үлкен мәселе.
Dialogue: 0,0:13:28.78,0:13:33.46,Default,,0,0,0,,Мен Мамору Анджоның да шашы шыққанын естідім.
Dialogue: 0,0:13:33.46,0:13:39.25,Default,,0,0,0,,Мүмкін сен кінәлісің?
Dialogue: 0,0:13:39.25,0:13:45.48,Default,,0,0,0,,Иә, ағам мені қорғайды...
Dialogue: 0,0:13:45.48,0:13:47.98,Default,,0,0,0,,《соғу》
Dialogue: 0,0:15:29.93,0:15:34.13,Default,,0,0,0,,Авангардқа жүрегіңізбен шабуыл жасаңыз!
Dialogue: 0,0:15:34.13,0:15:36.14,Default,,0,0,0,,Дағдыларды белсендіру
Dialogue: 0,0:15:36.14,0:15:41.96,Default,,0,0,0,,Зақымдану аймағының жараланған жүрегінің медбикесін шақырыңыз!
Dialogue: 0,0:15:41.96,0:15:45.15,Default,,0,0,0,,Эй, Драенге не болды?
Dialogue: 0,0:15:45.15,0:15:48.77,Default,,0,0,0,,Жаңалық себебі белгісіз➡ дейді
Dialogue: 0,0:15:48.77,0:15:51.80,Default,,0,0,0,,Іс жүзінде не болып жатыр?
Dialogue: 0,0:15:51.80,0:15:53.80,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:15:53.80,0:15:55.97,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:55.97,0:16:00.93,Default,,0,0,0,,Ух... сенің де кінәң бар шығар.
Dialogue: 0,0:16:00.93,0:16:02.93,Default,,0,0,0,,《Тағы да жеңесің бе?》
Dialogue: 0,0:16:02.93,0:16:05.52,Default,,0,0,0,,Не болды, Токоха Анджо?
Dialogue: 0,0:16:05.52,0:16:07.52,Default,,0,0,0,,Сонша қобалжымайсың ба!
Dialogue: 0,0:16:09.62,0:16:11.64,Default,,0,0,0,,немесе толық карта
Dialogue: 0,0:16:11.64,0:16:13.64,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:16:13.64,0:16:15.69,Default,,0,0,0,,ﾋｰﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:16:15.69,0:16:18.93,Default,,0,0,0,,Барлық әсерлер жаралы жүрекке түседі
Dialogue: 0,0:16:18.93,0:16:22.13,Default,,0,0,0,,《Бұл менің кінәм бе?
Dialogue: 0,0:16:22.13,0:16:28.93,Default,,0,0,0,,Егер мен оларды тоқтатқанымда, бұлай болмас еді...》
Dialogue: 0,0:16:31.64,0:16:36.61,Default,,0,0,0,,《Бірақ Амның өз жағдайлары бар.
Dialogue: 0,0:16:36.61,0:16:42.69,Default,,0,0,0,,Луна Амға жақын болуды таңдады.
Dialogue: 0,0:16:42.69,0:16:46.69,Default,,0,0,0,,Онда мен ештеңе айта алмаймын.
Dialogue: 0,0:16:50.93,0:16:55.88,Default,,0,0,0,,《Неге жалғыз өзің жылайсың?》
Dialogue: 0,0:16:55.88,0:16:57.95,Default,,0,0,0,,Қызық
Dialogue: 0,0:16:57.95,0:17:01.25,Default,,0,0,0,,Менде әлі біраз шабуылдар қалды.
Dialogue: 0,0:17:05.14,0:17:07.31,Default,,0,0,0,,Дұрыс күрес, Токоха Анджо!
Dialogue: 0,0:17:07.31,0:17:09.31,Default,,0,0,0,,Жоғары қара!
Dialogue: 0,0:17:14.35,0:17:16.35,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:19.36,0:17:21.29,Default,,0,0,0,,Сынған сүйек, солай ма?
Dialogue: 0,0:17:21.29,0:17:23.78,Default,,0,0,0,,Оны жеп, тез сауығып кет.
Dialogue: 0,0:17:23.78,0:17:25.78,Default,,0,0,0,,Көп нәрсе істеу керек
Dialogue: 0,0:17:27.80,0:17:29.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:29.80,0:17:31.97,Default,,0,0,0,,Мен ештеңе істей алмадым
Dialogue: 0,0:17:31.97,0:17:35.01,Default,,0,0,0,,Оны осылай қалдыру дұрыс па? мен
Dialogue: 0,0:17:35.01,0:17:37.01,Default,,0,0,0,,Сіз...
Dialogue: 0,0:17:42.55,0:17:44.48,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:44.48,0:17:46.47,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:17:46.47,0:17:50.57,Default,,0,0,0,,Сізде біздің басымыз бар! Маған сонша аянышты екеніңді көрсетпе!!
Dialogue: 0,0:18:05.94,0:18:09.02,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:18:09.02,0:18:12.02,Default,,0,0,0,,Толық гүлдейтін ранункулус
Dialogue: 0,0:18:14.29,0:18:16.76,Default,,0,0,0,,Ғұн, мен араластым.
Dialogue: 0,0:18:16.76,0:18:18.80,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ
Dialogue: 0,0:18:18.80,0:18:21.97,Default,,0,0,0,,Эйнеске қоңырау шалыңыз. Ашияның өнері гүлдеп тұр.
Dialogue: 0,0:18:21.97,0:18:24.47,Default,,0,0,0,,Гүл қызды Ашер деп ата
Dialogue: 0,0:18:24.47,0:18:27.26,Default,,0,0,0,,Екі күлте үшін қуат плюс 15000
Dialogue: 0,0:18:27.26,0:18:30.94,Default,,0,0,0,,Гүлденген Азия үшін сыни плюс 1
Dialogue: 0,0:18:30.94,0:18:32.93,Default,,0,0,0,,Сіз әлі де ақымақ болып жүрсіз бе?
Dialogue: 0,0:18:32.93,0:18:36.58,Default,,0,0,0,,Авангардқа Эйнеспен шабуыл жасаңыз!
Dialogue: 0,0:18:36.58,0:18:38.64,Default,,0,0,0,,Бұл не шайқас?
Dialogue: 0,0:18:38.64,0:18:40.64,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:18:40.64,0:18:43.24,Default,,0,0,0,,Мені уақыттан тыс қорға!
Dialogue: 0,0:18:47.48,0:18:50.36,Default,,0,0,0,,ﾎｰﾘｰｾﾗﾌｽﾘｴﾙ！
Dialogue: 0,0:18:50.36,0:18:52.27,Default,,0,0,0,,Суриэльді құтқару
Dialogue: 0,0:18:52.27,0:18:54.65,Default,,0,0,0,,Палубаның жоғарғы жағынан бір картаға қараңыз➡
Dialogue: 0,0:18:54.65,0:18:58.46,Default,,0,0,0,,Палубаның астына қойып, 1 зақымдарды қалпына келтіріңіз.
Dialogue: 0,0:18:58.46,0:19:00.46,Default,,0,0,0,,және зақымдануды тексеру
Dialogue: 0,0:19:00.46,0:19:02.48,Default,,0,0,0,,ｽﾀﾝﾄﾞﾄﾘｶﾞｰ
Dialogue: 0,0:19:02.48,0:19:04.86,Default,,0,0,0,,Гауриель үшін қуат плюс 5000
Dialogue: 0,0:19:04.86,0:19:08.48,Default,,0,0,0,,Doctroid Lifloss зақымдалған аймаққа орналастырылғандықтан➡
Dialogue: 0,0:19:08.48,0:19:10.63,Default,,0,0,0,,Сынған жүрек дағдысын белсендіру
Dialogue: 0,0:19:10.63,0:19:14.44,Default,,0,0,0,,Өзіңіз бен Гаури үшін қуат плюс 2000
Dialogue: 0,0:19:14.44,0:19:17.09,Default,,0,0,0,,Жалпы қуаты 33000!
Dialogue: 0,0:19:17.09,0:19:22.01,Default,,0,0,0,,Зақымдану аймағының карталарын ауыстыру арқылы зақымдану триггерлерін анықтау➡
Dialogue: 0,0:19:22.01,0:19:24.98,Default,,0,0,0,,Анхель Фессердің барлық мүмкіндіктерін көрсетіңіз
Dialogue: 0,0:19:24.98,0:19:26.97,Default,,0,0,0,,Бұл Лески
Dialogue: 0,0:19:26.97,0:19:29.99,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:19:29.99,0:19:31.94,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:19:31.94,0:19:34.26,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:19:34.26,0:19:36.31,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:19:36.31,0:19:39.66,Default,,0,0,0,,Барлық әсерлер Гүлші қыз Эшерге арналған
Dialogue: 0,0:19:39.66,0:19:41.70,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:19:41.70,0:19:44.32,Default,,0,0,0,,Бұл да гүл қыз Ашерге
Dialogue: 0,0:19:44.32,0:19:47.60,Default,,0,0,0,,Сондықтан бұл мүлдем қызық емес.
Dialogue: 0,0:19:47.60,0:19:50.31,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:19:50.31,0:19:54.26,Default,,0,0,0,,《Бұл жігіт алдындағы картаға қарап тұр➡
Dialogue: 0,0:19:54.26,0:19:56.98,Default,,0,0,0,,Ұрыс》
Dialogue: 0,0:19:56.98,0:19:58.98,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:19:58.98,0:20:00.95,Default,,0,0,0,,Мен не болғанын білмеймін➡
Dialogue: 0,0:20:00.95,0:20:04.02,Default,,0,0,0,,Бұл шындықтан құтылу үшін күресу сияқты, сондықтан мен жеңе аламын➡
Dialogue: 0,0:20:04.02,0:20:07.02,Default,,0,0,0,,Рин Хашима онша жақсы емес!
Dialogue: 0,0:20:09.03,0:20:12.31,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:20:12.31,0:20:14.30,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:20:14.30,0:20:17.32,Default,,0,0,0,,Генерация аймағы шығарылды!
Dialogue: 0,0:20:17.32,0:20:19.59,Default,,0,0,0,,О осал➡
Dialogue: 0,0:20:19.59,0:20:22.62,Default,,0,0,0,,Құдай бұйырғандай, жоғал!
Dialogue: 0,0:20:22.62,0:20:25.64,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:20:25.64,0:20:28.60,Default,,0,0,0,,ﾌﾞﾗｯｸ･ｾﾗﾌｶﾞｳﾘｰﾙ！
Dialogue: 0,0:20:28.60,0:20:30.60,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ
Dialogue: 0,0:20:30.60,0:20:34.68,Default,,0,0,0,,Палубаның жоғарғы үш картасына қараңыз және біреуін зақымдану аймағына қойыңыз➡
Dialogue: 0,0:20:34.68,0:20:38.59,Default,,0,0,0,,Оның орнына Black Bombermalik қолданбасын Жоғары қоңырау ретінде пайдаланыңыз.
Dialogue: 0,0:20:38.59,0:20:40.92,Default,,0,0,0,,Жарылған жүрек дағдылары
Dialogue: 0,0:20:40.92,0:20:45.60,Default,,0,0,0,,Сынған жүрек пен Қара Сераф Гауриге арналған Пауэр Plus 2000!
Dialogue: 0,0:20:45.60,0:20:48.97,Default,,0,0,0,,Жүрекке қоңырау шалыңыз!
Dialogue: 0,0:20:48.97,0:20:52.35,Default,,0,0,0,,Мәліктің жарылған жүрегімен шабуыл!
Dialogue: 0,0:20:52.35,0:20:55.59,Default,,0,0,0,,Эй~!
Dialogue: 0,0:20:55.59,0:20:58.64,Default,,0,0,0,,Күзетші! Мәлікті құтқару
Dialogue: 0,0:20:58.64,0:21:01.31,Default,,0,0,0,,ﾚｽｷｭｰﾁｪｯｸ
Dialogue: 0,0:21:01.31,0:21:03.98,Default,,0,0,0,,Триггер емес пе?
Dialogue: 0,0:21:03.98,0:21:06.40,Default,,0,0,0,,Сынған жүрек дағдысын белсендіру
Dialogue: 0,0:21:06.40,0:21:10.40,Default,,0,0,0,,Өзіңізге және Қара Сераф Гауриге қуат плюс 2000!
Dialogue: 0,0:21:12.64,0:21:15.01,Default,,0,0,0,,Қара Сераф Горилдің шеберлігі!
Dialogue: 0,0:21:15.01,0:21:18.28,Default,,0,0,0,,Өзіңізге және Хартқа қуат плюс 2000!
Dialogue: 0,0:21:18.28,0:21:21.31,Default,,0,0,0,,Жалпы қуаты 37000!
Dialogue: 0,0:21:21.31,0:21:25.95,Default,,0,0,0,,Қандай аянышты шайқас! Сіз жеңілген!
Dialogue: 0,0:21:25.95,0:21:27.95,Default,,0,0,0,,Мазасыздық!
Dialogue: 0,0:21:29.97,0:21:32.94,Default,,0,0,0,,ﾘﾙｶﾞ！
Dialogue: 0,0:21:32.94,0:21:36.31,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:21:36.31,0:21:38.31,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:21:38.31,0:21:42.60,Default,,0,0,0,,Тірек триггері. Барлық әсерлер жараланған жүрекке түседі.
Dialogue: 0,0:21:42.60,0:21:44.64,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:21:44.64,0:21:47.61,Default,,0,0,0,,Мұндағы барлық әсерлер жараланған жүрекке де барады.
Dialogue: 0,0:21:47.61,0:21:50.03,Default,,0,0,0,,Қара Сераф Горилдің шеберлігі
Dialogue: 0,0:21:50.03,0:21:53.68,Default,,0,0,0,,Ұрыс соңында егіз жарыс
Dialogue: 0,0:21:53.68,0:21:55.68,Default,,0,0,0,,ﾁｪｯｸ！
Dialogue: 0,0:21:57.68,0:22:01.65,Default,,0,0,0,,Критикалық триггер. Барлық әсерлер Сынған жүрекке өтеді.
Dialogue: 0,0:22:01.65,0:22:04.26,Default,,0,0,0,,Сынған жүрек дағдысы іске қосылды!
Dialogue: 0,0:22:04.26,0:22:06.66,Default,,0,0,0,,Пауэр Plus 2000 екі рет!
Dialogue: 0,0:22:06.66,0:22:09.93,Default,,0,0,0,,Жалпы қуаты 32000!
Dialogue: 0,0:22:09.93,0:22:14.97,Default,,0,0,0,,Бұл кездейсоқтық, кездейсоқтық, ғажайып немесе бір ғана қателік болса да➡
Dialogue: 0,0:22:14.97,0:22:19.27,Default,,0,0,0,,Мені жеңген күрескер керемет болды!
Dialogue: 0,0:22:19.27,0:22:21.57,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:22:23.98,0:22:26.70,Default,,0,0,0,,Бұл менің дәрежемді төмендетеді!
Dialogue: 0,0:22:26.70,0:22:28.70,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:22:34.35,0:22:36.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:46.62,0:22:50.92,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:22:57.98,0:23:01.35,Default,,0,0,0,,Аспан көк...
Dialogue: 0,0:23:01.35,0:23:03.27,Default,,0,0,0,,Қазір не істеп жатырсыз?
Dialogue: 0,0:23:03.27,0:23:07.30,Default,,0,0,0,,Бүгін таңертеңнен бері күн ашық. Аспан үнемі көк.
Dialogue: 0,0:23:07.30,0:23:09.71,Default,,0,0,0,,Мен...
Dialogue: 0,0:23:09.71,0:23:13.98,Default,,0,0,0,,Мм. Мен сені бүгінгі жекпе-жекке қалдырамын.
Dialogue: 0,0:23:13.98,0:23:17.60,Default,,0,0,0,,Мм...Не? Сізде шағымданатын нәрсе бар ма?
Dialogue: 0,0:23:17.60,0:23:19.93,Default,,0,0,0,,Жоқ, олай емес➡
Dialogue: 0,0:23:19.93,0:23:23.04,Default,,0,0,0,,Рин мырза, сіз неге ауруханадасыз?
Dialogue: 0,0:23:23.04,0:23:27.64,Default,,0,0,0,,Бұл... Маған бәрібір!
Dialogue: 0,0:23:35.63,0:23:40.02,Default,,0,0,0,,Жақсы. Филиал басшылары мен ойлағаннан да жақсы жұмыс істеп жатқан сияқты.
Dialogue: 0,0:23:40.02,0:23:43.59,Default,,0,0,0,,Промоушн қауымдастығы... Жоқ, бұл Vanguard үшін үлкен мәселе.
Dialogue: 0,0:23:43.59,0:23:47.66,Default,,0,0,0,,Маған тезірек ауруханадан шығып, бос емес болуым керек!
Dialogue: 0,0:23:47.66,0:24:04.63,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:04.63,0:24:07.93,Default,,0,0,0,,Мен Драен тармағын қалпына келтіремін➡
Dialogue: 0,0:24:07.93,0:24:09.97,Default,,0,0,0,,Менің үлкен жұмысым бар.
Dialogue: 0,0:24:09.97,0:24:13.27,Default,,0,0,0,,Маған да Токоха-чан көмектессін.
Dialogue: 0,0:24:15.67,0:24:17.67,Default,,0,0,0,,Иә
Dialogue: 0,0:24:21.34,0:24:25.34,Default,,0,0,0,,Осындай үлкен мәміле болғаным жақсы...
Dialogue: 0,0:24:34.96,0:24:38.26,Default,,0,0,0,,Мен ол жерде біреу жүргендей болдым.
Dialogue: 0,0:24:43.97,0:24:46.64,Default,,0,0,0,,Компания және Lami Lab туралы не деуге болады?
Dialogue: 0,0:24:46.64,0:24:49.62,Default,,0,0,0,,Әй, олар шығарған үкім.
Dialogue: 0,0:24:49.62,0:24:53.62,Default,,0,0,0,,Мамору-сан мен филиал менеджері Ибуки-сан да ауыр жарақаттармен ауруханада жатыр.
Dialogue: 0,0:25:13.63,0:25:16.62,Default,,0,0,0,,((Ертең кездескенше
Dialogue: 0,0:25:16.62,0:25:21.22,Default,,0,0,0,,Ертең қанша уақыт келеді?
Dialogue: 0,0:25:23.72,0:25:27.72,Default,,0,0,0,,Бізді бақытты болашақ күтіп тұр ма?
Dialogue: 0,0:25:33.35,0:25:37.35,Default,,0,0,0,,Иә. Мүлдем.
Dialogue: 0,0:25:37.35,0:25:40.95,Default,,0,0,0,,Уайымдама мен сені қорғаймын))
Dialogue: 0,0:25:48.28,0:25:52.69,Default,,0,0,0,,Түсіндім... бұл дұрыс...
Dialogue: 0,0:25:52.69,0:25:55.99,Default,,0,0,0,,Сіз қыз болдыңыз, солай ма?
Dialogue: 0,0:25:58.96,0:26:03.26,Default,,0,0,0,,Олай болса, бұл жолы мен сенің рыцарың боламын.
Dialogue: 0,0:26:07.62,0:26:11.22,Default,,0,0,0,,Мен сен қалаған болашақты аламын
Dialogue: 0,0:26:18.31,0:26:23.98,Default,,0,0,0,,Мен сені күттім. Келгеніңізге көп рахмет, Куроно.
Dialogue: 0,0:26:23.98,0:26:26.92,Default,,0,0,0,,Мен сіздің шешіміңізге қуаныштымын.
Dialogue: 0,0:26:26.92,0:26:29.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:29.01,0:26:32.01,Default,,0,0,0,,Менімен күрес, Миджин Роуз
Dialogue: 0,0:30:38.97,0:30:41.94,Default,,0,0,0,,<Бильярд алаңында болу➡
Dialogue: 0,0:30:41.94,0:30:45.95,Default,,0,0,0,,Джаз кафесіне шомылыңыз және➡
Dialogue: 0,0:30:45.95,0:30:49.98,Default,,0,0,0,,Менің жастық шағым махжонг ойнаумен өтті
Dialogue: 0,0:30:49.98,0:30:53.52,Default,,0,0,0,,Сол мектеп кезімнен естеліктер➡
Dialogue: 0,0:30:53.52,0:30:56.29,Default,,0,0,0,,Қайта жаңғырған қала...
Dialogue: 0,0:30:56.29,0:30:59.14,Default,,0,0,0,,...
