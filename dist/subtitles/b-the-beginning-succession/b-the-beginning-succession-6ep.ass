Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,‎NETFLIX түпнұсқа аниме сериясы
Dialogue: 0,0:00:12.01,0:00:18.01,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:00:20.89,0:00:26.90,Default,,0,0,0,,‎〜♪
Dialogue: 0,0:00:27.02,0:00:30.02,Default,,0,0,0,,‎(толқындар дыбысы)
Dialogue: 0,0:01:08.44,0:01:09.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:20.03,0:01:21.24,Default,,0,0,0,,Мен қателік жасадым
Dialogue: 0,0:01:22.16,0:01:25.25,Default,,0,0,0,,Мен сәл ұзағырақ жүруім керек еді.
Dialogue: 0,0:01:26.62,0:01:28.96,Default,,0,0,0,,Бұл жеткілікті күшті емес пе?
Dialogue: 0,0:01:36.30,0:01:39.34,Default,,0,0,0,,‎Бұл уақыт мәселесі
Dialogue: 0,0:01:43.77,0:01:45.81,Default,,0,0,0,,‎Ааа...
Dialogue: 0,0:01:56.65,0:01:57.49,Default,,0,0,0,,‎(сықырлаған дыбыс)
Dialogue: 0,0:01:58.36,0:01:59.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:00.03,0:02:01.53,Default,,0,0,0,,‎(Тежегіш дыбысы)
Dialogue: 0,0:02:02.66,0:02:03.49,Default,,0,0,0,,О!
Dialogue: 0,0:02:03.95,0:02:06.50,Default,,0,0,0,,Сіз қайда бардыңыз?
Dialogue: 0,0:02:07.16,0:02:08.08,Default,,0,0,0,,‎(Тісті берілістердің ауысу дыбысы)
Dialogue: 0,0:02:08.87,0:02:10.33,Default,,0,0,0,,‎(Қоңырау үні)
Dialogue: 0,0:02:11.33,0:02:13.25,Default,,0,0,0,,‎Куроба-кун? Не болды?
Dialogue: 0,0:02:13.84,0:02:15.09,Default,,0,0,0,,‎(Радио: Куробане) Мен Китті таптым.
Dialogue: 0,0:02:15.21,0:02:17.51,Default,,0,0,0,,Шынымен бе? Жақсы!
Dialogue: 0,0:02:18.34,0:02:20.22,Default,,0,0,0,,Олай болса солай істеңіз.
Dialogue: 0,0:02:20.34,0:02:22.47,Default,,0,0,0,,Мұнда да көп нәрсе болып жатыр...
Dialogue: 0,0:02:23.14,0:02:24.22,Default,,0,0,0,,‎(Куроба) Өтінемін, дереу келіңіз.
Dialogue: 0,0:02:24.47,0:02:25.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:26.43,0:02:28.77,Default,,0,0,0,,‎Е, бірақ сіз құтқарылдыңыз, солай ма?
Dialogue: 0,0:02:29.14,0:02:30.23,Default,,0,0,0,,‎(Куроба) Бұл...
Dialogue: 0,0:02:33.52,0:02:36.19,Default,,0,0,0,,Ол дем алып жатыр, бірақ оянбайды.
Dialogue: 0,0:02:36.78,0:02:38.15,Default,,0,0,0,,‎Дене температурасы тым төмен
Dialogue: 0,0:02:39.28,0:02:40.53,Default,,0,0,0,,‎(Радио: Лилия) Жедел жәрдем бар ма?
Dialogue: 0,0:02:41.11,0:02:42.24,Default,,0,0,0,,‎(Куроба) шақырды
Dialogue: 0,0:02:42.37,0:02:43.53,Default,,0,0,0,,Егер солай болса, онда жақсы... (Куроба) Бірақ
Dialogue: 0,0:02:44.91,0:02:46.54,Default,,0,0,0,,‎(Куроба) Мүмкін осылай қалар...
Dialogue: 0,0:02:48.50,0:02:49.33,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:02:50.62,0:02:53.00,Default,,0,0,0,,‎Жарайды, мен бірден барамын.
Dialogue: 0,0:02:56.00,0:02:58.34,Default,,0,0,0,,Маған осы уақытқа дейінгі егжей-тегжейлі жағдайды айтып беріңізші.
Dialogue: 0,0:03:44.30,0:03:46.10,Default,,0,0,0,,‎(Ханзада) Жақсы, аман бол.
Dialogue: 0,0:03:46.93,0:03:48.10,Default,,0,0,0,,‎(Король) Ақ
Dialogue: 0,0:03:49.06,0:03:50.10,Default,,0,0,0,,‎(Ханзада) Мәселе неде?
Dialogue: 0,0:03:50.43,0:03:53.73,Default,,0,0,0,,Оны бірнеше полиция қызметкері көрген.
Dialogue: 0,0:03:53.85,0:03:55.36,Default,,0,0,0,,Сіз уайымдап жатырсыз ба?
Dialogue: 0,0:03:56.19,0:03:57.11,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:03:58.82,0:04:03.57,Default,,0,0,0,,Енді сіз менімен жасырын түрде сөйлесе аласыз ба?
Dialogue: 0,0:04:03.95,0:04:05.45,Default,,0,0,0,,Міне, бұл.
Dialogue: 0,0:04:05.57,0:04:09.08,Default,,0,0,0,,‎Курс менің сценарийіме түзетілді.
Dialogue: 0,0:04:10.20,0:04:13.16,Default,,0,0,0,,‎Күтілгендей Кирисаме
Dialogue: 0,0:04:14.83,0:04:17.38,Default,,0,0,0,,‎Ол менің тамаша пәнім.
Dialogue: 0,0:04:17.84,0:04:20.34,Default,,0,0,0,,Барлығы сіз оқығанда.
Dialogue: 0,0:04:20.84,0:04:23.22,Default,,0,0,0,,Қалғанын маған қалдырыңыз.
Dialogue: 0,0:04:25.05,0:04:26.14,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:57.00,0:04:58.42,Default,,0,0,0,,Ақыры оянды
Dialogue: 0,0:04:58.84,0:04:59.71,Default,,0,0,0,,‎(Кит) Ах...
Dialogue: 0,0:05:03.59,0:05:04.80,Default,,0,0,0,,А...
Dialogue: 0,0:05:06.05,0:05:07.14,Default,,0,0,0,,А...
Dialogue: 0,0:05:09.18,0:05:10.18,Default,,0,0,0,,А?
Dialogue: 0,0:05:10.72,0:05:11.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:12.64,0:05:14.48,Default,,0,0,0,,‎(ТД: Кастер) Өткен күнгі шабуылдан бері
Dialogue: 0,0:05:14.60,0:05:17.15,Default,,0,0,0,,Мәртебелі патшаның қайда екені белгісіз...
Dialogue: 0,0:05:17.27,0:05:19.56,Default,,0,0,0,,(Кит) Әй, сен осылай айтып тұрсың ба?
Dialogue: 0,0:05:20.44,0:05:21.52,Default,,0,0,0,,Сіз білесіз...
Dialogue: 0,0:05:22.03,0:05:24.90,Default,,0,0,0,,«Бұл қайда?» «Не болды!»
Dialogue: 0,0:05:25.03,0:05:26.95,Default,,0,0,0,,‎...Сен үрейленбейсің бе?
Dialogue: 0,0:05:29.41,0:05:31.70,Default,,0,0,0,,‎(Кит) Неге? Түсінді.
Dialogue: 0,0:05:32.16,0:05:33.33,Default,,0,0,0,,‎Өзіңізді қалай сезінесіз?
Dialogue: 0,0:05:33.70,0:05:35.08,Default,,0,0,0,,‎(Кит) Жоқ...
Dialogue: 0,0:05:35.66,0:05:36.87,Default,,0,0,0,,А...
Dialogue: 0,0:05:38.46,0:05:39.71,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:05:39.83,0:05:41.29,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:05:41.42,0:05:42.25,Default,,0,0,0,,‎Hehe...
Dialogue: 0,0:05:45.72,0:05:47.09,Default,,0,0,0,,Мынаны қараңыз.
Dialogue: 0,0:05:47.51,0:05:48.51,Default,,0,0,0,,Не?
Dialogue: 0,0:05:48.68,0:05:52.10,Default,,0,0,0,,Сіз келесі жолы бірге тамақтанамыз деп уәде бергенсіз.
Dialogue: 0,0:05:52.56,0:05:53.93,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,0:05:54.68,0:05:58.73,Default,,0,0,0,,‎Тамақ жеуге болмайды, сен ауру адамсың.
Dialogue: 0,0:05:59.15,0:06:00.40,Default,,0,0,0,,Ертең тамақтаныңыз
Dialogue: 0,0:06:00.81,0:06:02.11,Default,,0,0,0,,Қазір тамақтаныңыз
Dialogue: 0,0:06:02.23,0:06:03.23,Default,,0,0,0,,‎(Кит) Хмм...
Dialogue: 0,0:06:09.57,0:06:10.41,Default,,0,0,0,,Қалай?
Dialogue: 0,0:06:11.82,0:06:13.16,Default,,0,0,0,,Иә, өте жақсы
Dialogue: 0,0:06:13.83,0:06:14.95,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:06:19.83,0:06:21.88,Default,,0,0,0,,Бұдан былай жеке әрекеттерге рұқсат етілмейді!
Dialogue: 0,0:06:22.96,0:06:23.80,Default,,0,0,0,,нәжіс
Dialogue: 0,0:06:24.42,0:06:26.88,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:06:29.09,0:06:32.89,Default,,0,0,0,,‎(Кастер) Мен Мәртебелі Корольді алып бара жатқан көлікті растай алдым.
Dialogue: 0,0:06:34.68,0:06:35.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:38.73,0:06:41.10,Default,,0,0,0,,Мен уайымдадым, бірақ сенің жақсы болғаныңа қуаныштымын.
Dialogue: 0,0:06:41.23,0:06:42.69,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:43.02,0:06:46.03,Default,,0,0,0,,‎(аяқ дыбысы)
Dialogue: 0,0:07:14.30,0:07:15.60,Default,,0,0,0,,‎(жүгірген аяқ дыбысы)
Dialogue: 0,0:07:16.06,0:07:16.93,Default,,0,0,0,,‎(әйнек қағу дыбысы)
Dialogue: 0,0:07:17.06,0:07:18.68,Default,,0,0,0,,Мені бұл жерден кетіріңіз!
Dialogue: 0,0:07:18.89,0:07:21.19,Default,,0,0,0,,‎Хахаха...
Dialogue: 0,0:07:22.44,0:07:23.94,Default,,0,0,0,,Бұл басқа әңгіме емес пе?
Dialogue: 0,0:07:24.44,0:07:25.36,Default,,0,0,0,,Әңгіме?
Dialogue: 0,0:07:25.48,0:07:26.94,Default,,0,0,0,,‎(Ханзада) Реджиді жою
Dialogue: 0,0:07:27.07,0:07:31.61,Default,,0,0,0,,Менің патшалығымды Канонның күшімен қолдауға ант берген сенсің!
Dialogue: 0,0:07:31.74,0:07:33.70,Default,,0,0,0,,О... бұл өтірік
Dialogue: 0,0:07:33.91,0:07:34.91,Default,,0,0,0,,На...
Dialogue: 0,0:07:36.53,0:07:39.04,Default,,0,0,0,,Реджи бұрынғыдай қолданыла береді.
Dialogue: 0,0:07:40.58,0:07:42.67,Default,,0,0,0,,Сіз ештеңе түсінбейсіз.
Dialogue: 0,0:07:42.79,0:07:45.79,Default,,0,0,0,,Ақылсыз ел билеу ескі.
Dialogue: 0,0:07:45.92,0:07:47.17,Default,,0,0,0,,Қазір реформа жасаңыз!
Dialogue: 0,0:07:47.50,0:07:49.55,Default,,0,0,0,,Түсінбейтін сенсің.
Dialogue: 0,0:07:49.67,0:07:52.13,Default,,0,0,0,,Канон мен Реджи екеуі де қажет.
Dialogue: 0,0:07:52.93,0:07:53.93,Default,,0,0,0,,А...
Dialogue: 0,0:07:54.80,0:07:57.81,Default,,0,0,0,,Бір нәрсені жойсаң, ол түзеледі, т.б.
Dialogue: 0,0:07:57.93,0:07:59.43,Default,,0,0,0,,Балалық идеялар
Dialogue: 0,0:07:59.56,0:08:01.18,Default,,0,0,0,,Тіпті қарама-қайшы болмыста
Dialogue: 0,0:08:01.31,0:08:03.73,Default,,0,0,0,,Екеуі бір-бірін қолдайды.
Dialogue: 0,0:08:04.23,0:08:05.40,Default,,0,0,0,,‎(Ханзада) Хмм...
Dialogue: 0,0:08:06.48,0:08:10.23,Default,,0,0,0,,Ашық және бұлтты ішу - нағыз патша.
Dialogue: 0,0:08:10.44,0:08:12.49,Default,,0,0,0,,А...
Dialogue: 0,0:08:13.57,0:08:17.33,Default,,0,0,0,,Сондықтан уайымдама, мен де сені қабылдаймын.
Dialogue: 0,0:08:17.45,0:08:19.08,Default,,0,0,0,,Мен сені өлтірмеймін
Dialogue: 0,0:08:20.24,0:08:21.50,Default,,0,0,0,,Сол себепті де
Dialogue: 0,0:08:21.62,0:08:25.25,Default,,0,0,0,,Біріншіден, мен жоғары мәртебелі сатқын ретінде жасаған қылмысын өтеуін қалаймын.
Dialogue: 0,0:08:25.54,0:08:26.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:28.34,0:08:32.97,Default,,0,0,0,,‎Киллер В көмегімен ұлы мәртебеліге қастандық жасау жоспарының ұйымдастырушысы ретінде
Dialogue: 0,0:08:33.09,0:08:36.26,Default,,0,0,0,,Ақымақ болма. Мұны «қабылдаудың» мәні неде?
Dialogue: 0,0:08:38.39,0:08:39.60,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:39.85,0:08:42.43,Default,,0,0,0,,‎Егер мені алып тастасаңыз, корольдік отбасы жойылады.
Dialogue: 0,0:08:42.56,0:08:43.77,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:08:46.27,0:08:48.94,Default,,0,0,0,,Қаншалықты таяз...
Dialogue: 0,0:08:50.07,0:08:52.44,Default,,0,0,0,,‎Сен маған тиісе алмайсың
Dialogue: 0,0:08:56.03,0:08:57.16,Default,,0,0,0,,‎(Ханзада) Ах...
Dialogue: 0,0:08:57.28,0:08:58.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:58.24,0:09:00.66,Default,,0,0,0,,‎Эй, тыңдап тұрсың ба! Сатқын!
Dialogue: 0,0:09:00.79,0:09:02.29,Default,,0,0,0,,Сәлем! Күте тұрыңыз!
Dialogue: 0,0:09:02.41,0:09:04.21,Default,,0,0,0,,Мені бұл жерден кетіріңіз!
Dialogue: 0,0:09:06.87,0:09:08.21,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:09.34,0:09:12.26,Default,,0,0,0,,Патша мен Кирисамэ қол ұстасып тұр.
Dialogue: 0,0:09:12.42,0:09:15.38,Default,,0,0,0,,Бізді билеуге мәжбүр етті.
Dialogue: 0,0:09:18.39,0:09:20.18,Default,,0,0,0,,‎Енді не істейсіз?
Dialogue: 0,0:09:21.14,0:09:22.68,Default,,0,0,0,,Енді...
Dialogue: 0,0:09:24.43,0:09:28.52,Default,,0,0,0,,Әзірше біз ештеңе істей алмаймыз.
Dialogue: 0,0:09:29.11,0:09:31.15,Default,,0,0,0,,‎Жоқ, мен айтамын.
Dialogue: 0,0:09:31.27,0:09:33.44,Default,,0,0,0,,Куроба және басқалары тағы да нысанаға алынуы мүмкін.
Dialogue: 0,0:09:39.74,0:09:41.08,Default,,0,0,0,,Мен уайымдап тұрмын
Dialogue: 0,0:09:42.41,0:09:43.49,Default,,0,0,0,,‎Куробане ше?
Dialogue: 0,0:09:44.95,0:09:46.79,Default,,0,0,0,,Енді жоғалып кетті
Dialogue: 0,0:09:47.16,0:09:50.84,Default,,0,0,0,,‎B өлтіруші Куроба емес, қуылған адам.
Dialogue: 0,0:09:51.75,0:09:54.59,Default,,0,0,0,,Мен бұл жақсы дедім, өйткені мен білмеймін, бірақ...
Dialogue: 0,0:09:55.21,0:09:57.59,Default,,0,0,0,,Мені осы іс бойынша көп нәрсе алаңдатады.
Dialogue: 0,0:09:57.72,0:09:59.14,Default,,0,0,0,,Оған ұқсайды.
Dialogue: 0,0:10:00.09,0:10:03.60,Default,,0,0,0,,Патша сарайына шабуыл туралы жалған айыптау. Бірдеңені тез жасау керек.
Dialogue: 0,0:10:15.69,0:10:19.53,Default,,0,0,0,,О, түсіндім. Мен оларға да айтамын.
Dialogue: 0,0:10:19.66,0:10:20.66,Default,,0,0,0,,Хонжа
Dialogue: 0,0:10:21.91,0:10:23.41,Default,,0,0,0,,‎Бұл туралы не істеуім керек?
Dialogue: 0,0:10:24.91,0:10:27.37,Default,,0,0,0,,Мен Генидің есін жиғанын естідім.
Dialogue: 0,0:10:28.12,0:10:30.29,Default,,0,0,0,,Мәртебелі Король де аман.
Dialogue: 0,0:10:30.42,0:10:32.00,Default,,0,0,0,,Мұның бәрі шешілді ме?
Dialogue: 0,0:10:32.13,0:10:33.42,Default,,0,0,0,,Құттықтаймыз! Құттықтаймыз!
Dialogue: 0,0:10:33.54,0:10:34.38,Default,,0,0,0,,Кебек
Dialogue: 0,0:10:35.34,0:10:38.01,Default,,0,0,0,,‎В өлтіруші әлі де бос.
Dialogue: 0,0:10:38.26,0:10:39.88,Default,,0,0,0,,Сіз оны тұтқындағанша, сақтықты төмендетпеңіз.
Dialogue: 0,0:10:40.80,0:10:42.47,Default,,0,0,0,,Әрине
Dialogue: 0,0:10:43.05,0:10:45.18,Default,,0,0,0,,‎Мұрынның дөрекі болғаны дұрыс.
Dialogue: 0,0:10:45.31,0:10:47.35,Default,,0,0,0,,Содан бері тергеу тоқтап қалды.
Dialogue: 0,0:10:48.06,0:10:48.93,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:10:51.73,0:10:55.15,Default,,0,0,0,,‎Ешқандай ілгерілеушілік болмағандықтан, мені басқа мәселе бойынша шығарып жіберді.
Dialogue: 0,0:10:55.40,0:10:58.57,Default,,0,0,0,,‎Ой, оғаш оқиғалар қайтадан көбейіп барады.
Dialogue: 0,0:10:58.82,0:10:59.74,Default,,0,0,0,,Бұл менің қиялым ғана ма?
Dialogue: 0,0:11:00.11,0:11:04.16,Default,,0,0,0,,‎Соңғы уақытта зорлық-зомбылық қылмыстары көбейіп келеді.
Dialogue: 0,0:11:04.28,0:11:05.53,Default,,0,0,0,,табиғи емес
Dialogue: 0,0:11:05.87,0:11:07.62,Default,,0,0,0,,Менің кездесуге уақытым жоқ
Dialogue: 0,0:11:07.75,0:11:10.54,Default,,0,0,0,,Иә? Басқа адамды тапқан соң маған айт.
Dialogue: 0,0:11:17.80,0:11:18.80,Default,,0,0,0,,шықты
Dialogue: 0,0:11:19.47,0:11:21.80,Default,,0,0,0,,‎Міне, кеттік.
Dialogue: 0,0:11:33.90,0:11:35.69,Default,,0,0,0,,Марио сонда барды.
Dialogue: 0,0:11:36.36,0:11:38.57,Default,,0,0,0,,Мен оны осы жерден көремін. Мен оны шымшып аламын.
Dialogue: 0,0:11:38.69,0:11:39.57,Default,,0,0,0,,Түсінді
Dialogue: 0,0:11:53.00,0:11:53.83,Default,,0,0,0,,‎(Ер) Ку...
Dialogue: 0,0:11:56.96,0:11:59.38,Default,,0,0,0,,‎Хахаха... Күте тұрыңыз!
Dialogue: 0,0:12:03.18,0:12:05.97,Default,,0,0,0,,‎Бұл Браннан шығысқа қарай 30 метр болатын!
Dialogue: 0,0:12:06.30,0:12:07.72,Default,,0,0,0,,‎(Ер) Хахаха...
Dialogue: 0,0:12:07.85,0:12:08.76,Default,,0,0,0,,А...
Dialogue: 0,0:12:10.39,0:12:13.10,Default,,0,0,0,,‎(Марио Борис) Хахаха...
Dialogue: 0,0:12:13.31,0:12:14.60,Default,,0,0,0,,‎(Ер) Хахаха...
Dialogue: 0,0:12:14.90,0:12:16.02,Default,,0,0,0,,‎Хахаха...
Dialogue: 0,0:12:16.23,0:12:19.86,Default,,0,0,0,,‎Хахаха...
Dialogue: 0,0:12:20.73,0:12:21.69,Default,,0,0,0,,А...
Dialogue: 0,0:12:22.57,0:12:26.37,Default,,0,0,0,,‎Хахаха...
Dialogue: 0,0:12:26.78,0:12:27.62,Default,,0,0,0,,‎Ку...
Dialogue: 0,0:12:31.50,0:12:32.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:34.50,0:12:36.21,Default,,0,0,0,,‎Хи-хи!
Dialogue: 0,0:12:36.75,0:12:37.92,Default,,0,0,0,,‎Хи хи...
Dialogue: 0,0:12:38.04,0:12:39.00,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:42.84,0:12:44.30,Default,,0,0,0,,‎Хи хи хи!
Dialogue: 0,0:12:48.97,0:12:49.85,Default,,0,0,0,,‎Тайя!
Dialogue: 0,0:12:54.94,0:12:55.77,Default,,0,0,0,,‎Хи-хи!
Dialogue: 0,0:12:58.15,0:13:01.19,Default,,0,0,0,,(күлді)
Dialogue: 0,0:13:01.94,0:13:02.82,Default,,0,0,0,,Бір күн бұрын...
Dialogue: 0,0:13:03.28,0:13:04.57,Default,,0,0,0,,‎Хия~!
Dialogue: 0,0:13:05.15,0:13:06.28,Default,,0,0,0,,‎(металл дыбыс)
Dialogue: 0,0:13:08.99,0:13:09.99,Default,,0,0,0,,‎(M) Ах!
Dialogue: 0,0:13:11.41,0:13:12.24,Default,,0,0,0,,‎(Соққы дыбысы)
Dialogue: 0,0:13:15.50,0:13:16.33,Default,,0,0,0,,‎(Соққы дыбысы)
Dialogue: 0,0:13:17.67,0:13:19.38,Default,,0,0,0,,‎(Ер) Хахаха... Ха!
Dialogue: 0,0:13:23.34,0:13:24.51,Default,,0,0,0,,А...
Dialogue: 0,0:13:25.72,0:13:26.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:27.47,0:13:28.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:37.10,0:13:38.56,Default,,0,0,0,,О! Ах...
Dialogue: 0,0:13:47.91,0:13:49.62,Default,,0,0,0,,‎Бұл нені білдіреді?
Dialogue: 0,0:13:50.74,0:13:53.29,Default,,0,0,0,,‎Хмм? Эй, бұл...
Dialogue: 0,0:13:53.70,0:13:54.54,Default,,0,0,0,,‎Хмм?
Dialogue: 0,0:13:55.75,0:13:56.58,Default,,0,0,0,,А...
Dialogue: 0,0:14:16.52,0:14:19.48,Default,,0,0,0,,‎Аа... Барлығы жиналды.
Dialogue: 0,0:14:19.69,0:14:21.06,Default,,0,0,0,,Қатеге ұқсайды
Dialogue: 0,0:14:24.82,0:14:27.82,Default,,0,0,0,,Әсер, әрине, керемет.
Dialogue: 0,0:14:27.95,0:14:30.45,Default,,0,0,0,,Сіз басқа жолды білмейсіз бе?
Dialogue: 0,0:14:32.32,0:14:34.37,Default,,0,0,0,,Сіз ебедейсіз.
Dialogue: 0,0:14:38.33,0:14:41.04,Default,,0,0,0,,‎Эй, мұның дұрыс екеніне сенімдісің бе?
Dialogue: 0,0:14:51.64,0:14:52.76,Default,,0,0,0,,‎Куроба...
Dialogue: 0,0:14:53.14,0:14:54.89,Default,,0,0,0,,Учаскедегі ғимарат қабырғасында
Dialogue: 0,0:14:55.10,0:14:57.89,Default,,0,0,0,,Үлкен Killer B белгісі қалады.
Dialogue: 0,0:14:58.14,0:14:59.94,Default,,0,0,0,,Әзірге полициядан ресми мәлімдеме жоқ...
Dialogue: 0,0:15:00.06,0:15:00.90,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:15:01.31,0:15:02.90,Default,,0,0,0,,Айналадағы тұрғындардың әңгімелерінен
Dialogue: 0,0:15:03.02,0:15:05.98,Default,,0,0,0,,Жәбірленуші 30-40 жас аралығындағы ер адам...
Dialogue: 0,0:15:06.32,0:15:08.57,Default,,0,0,0,,‎Ол неге бұлай істеді...
Dialogue: 0,0:15:08.74,0:15:10.86,Default,,0,0,0,,‎Мүмкін мен үмітсіз болдым ба?
Dialogue: 0,0:15:11.24,0:15:13.62,Default,,0,0,0,,‎Мен сені тым қатты итеріп жіберген шығармын?
Dialogue: 0,0:15:13.74,0:15:15.37,Default,,0,0,0,,Байыпты ойлан
Dialogue: 0,0:15:15.49,0:15:16.91,Default,,0,0,0,,Иә иә
Dialogue: 0,0:15:17.62,0:15:18.83,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:15:28.05,0:15:29.09,Default,,0,0,0,,‎(Қазан күрсінуі)
Dialogue: 0,0:15:30.09,0:15:30.93,Default,,0,0,0,,‎(Юкиказэ күрсінуі)
Dialogue: 0,0:15:31.26,0:15:33.93,Default,,0,0,0,,Бұл ескі қаладағы Виа Данте.
Dialogue: 0,0:15:34.26,0:15:36.93,Default,,0,0,0,,Корольдік полиция бұл қылмыстың әдісін растады.
Dialogue: 0,0:15:37.43,0:15:39.68,Default,,0,0,0,,Оқиға орнында қалдырылған «Б» белгісінен
Dialogue: 0,0:15:39.81,0:15:43.02,Default,,0,0,0,,Оған сериялық өлтіруші Killer B себеп болғаны жарияланды...
Dialogue: 0,0:15:43.15,0:15:44.44,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:15:46.52,0:15:48.28,Default,,0,0,0,,Маған қоңырау шалу
Dialogue: 0,0:16:50.71,0:16:52.84,Default,,0,0,0,,Хабарлама алынды
Dialogue: 0,0:16:53.17,0:16:55.01,Default,,0,0,0,,«Мен осындамын»
Dialogue: 0,0:17:16.20,0:17:18.62,Default,,0,0,0,,Менің де сізге айтқым келетін бір нәрсе бар.
Dialogue: 0,0:17:20.66,0:17:23.41,Default,,0,0,0,,Мен сенің күшіңді түсіндім.
Dialogue: 0,0:17:24.20,0:17:27.75,Default,,0,0,0,,‎Бір мағынада Юкиказэ гипотезасы дұрыс болды.
Dialogue: 0,0:17:31.34,0:17:36.05,Default,,0,0,0,,‎Қанша қиын жағдай болса да, сіз әрқашан аман қалдыңыз.
Dialogue: 0,0:17:41.35,0:17:44.89,Default,,0,0,0,,Бастапқыда оның Асагириге қарсы жеңіске жету мүмкіндігі болмады.
Dialogue: 0,0:17:45.02,0:17:49.77,Default,,0,0,0,,‎Ол Фаула Бланканың зерттеулері негізінде жасалған келесі ұрпақ.
Dialogue: 0,0:17:49.94,0:17:52.57,Default,,0,0,0,,‎Спецификациялар біздікінен бірнеше саты жоғары.
Dialogue: 0,0:17:57.40,0:17:58.82,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:18:03.08,0:18:05.00,Default,,0,0,0,,‎Сізді құрайтын ұяшықтар
Dialogue: 0,0:18:05.12,0:18:09.92,Default,,0,0,0,,Кез келген ортаға бірден бейімделіп, дамиды
Dialogue: 0,0:18:10.21,0:18:11.71,Default,,0,0,0,,Ерікке қарамастан
Dialogue: 0,0:18:14.80,0:18:18.72,Default,,0,0,0,,Демек, деректердің өзі айнымалы және өлшемнің мағынасы жоқ.
Dialogue: 0,0:18:19.38,0:18:22.22,Default,,0,0,0,,‎Сонымен, егер сіз сан жағынан басым Канонмен күрессеңіз де,
Dialogue: 0,0:18:22.35,0:18:24.01,Default,,0,0,0,,‎Одан сәл асып кету
Dialogue: 0,0:18:24.77,0:18:27.73,Default,,0,0,0,,‎Тамаша жылдам бейімделу уақыты
Dialogue: 0,0:18:29.27,0:18:31.36,Default,,0,0,0,,Бұл тек ұрыс туралы ғана емес.
Dialogue: 0,0:18:31.86,0:18:34.48,Default,,0,0,0,,‎Егер сізде мұндай күш болса, сіз бәрін жасай аласыз.
Dialogue: 0,0:18:37.19,0:18:39.32,Default,,0,0,0,,‎Бірегей қуат
Dialogue: 0,0:18:40.91,0:18:43.41,Default,,0,0,0,,‎Сен біздің патшамызсың ғой.
Dialogue: 0,0:18:45.08,0:18:48.33,Default,,0,0,0,,‎Куроба, сен бізге керексің.
Dialogue: 0,0:18:48.50,0:18:49.50,Default,,0,0,0,,Менімен бірге жүр.
Dialogue: 0,0:19:01.59,0:19:03.64,Default,,0,0,0,,‎Ха-а...
Dialogue: 0,0:19:04.39,0:19:06.14,Default,,0,0,0,,‎Мен не айтсам да пайдасыз
Dialogue: 0,0:19:08.93,0:19:09.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:10.77,0:19:13.02,Default,,0,0,0,,‎(Куроба) Біз өз жолымызбен барамыз
Dialogue: 0,0:19:13.65,0:19:15.40,Default,,0,0,0,,Келіңіздер, Кирисамемен аяқтаймыз
Dialogue: 0,0:19:17.36,0:19:18.28,Default,,0,0,0,,‎Фу...
Dialogue: 0,0:19:21.61,0:19:22.82,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:19:33.63,0:19:35.79,Default,,0,0,0,,‎Бұл басынан бастап шешілді.
Dialogue: 0,0:19:36.17,0:19:37.00,Default,,0,0,0,,О
Dialogue: 0,0:19:38.51,0:19:39.34,Default,,0,0,0,,‎Фу...
Dialogue: 0,0:19:41.13,0:19:45.14,Default,,0,0,0,,Сіздің жауаптарыңыз әрқашан көңілімді қалдырады
Dialogue: 0,0:20:05.45,0:20:06.33,Default,,0,0,0,,‎(металл дыбыс)
Dialogue: 0,0:20:24.89,0:20:27.68,Default,,0,0,0,,‎Иә, нені білмейсің
Dialogue: 0,0:20:28.22,0:20:30.47,Default,,0,0,0,,Әлі де көп.
Dialogue: 0,0:20:35.35,0:20:36.19,Default,,0,0,0,,‎(Куроба) Ах...
Dialogue: 0,0:20:38.19,0:20:44.20,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:22:22.25,0:22:28.26,Default,,0,0,0,,‎〜♪
