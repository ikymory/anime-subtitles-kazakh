Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,‎NETFLIX түпнұсқа аниме сериясы
Dialogue: 0,0:00:34.07,0:00:34.90,Default,,0,0,0,,‎(Захари) Ах.
Dialogue: 0,0:00:35.66,0:00:40.29,Default,,0,0,0,,‎Уф... Уф...
Dialogue: 0,0:00:41.08,0:00:43.62,Default,,0,0,0,,‎(Жақындау)
Dialogue: 0,0:01:00.56,0:01:06.56,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:01:09.48,0:01:15.49,Default,,0,0,0,,‎〜♪
Dialogue: 0,0:01:17.16,0:01:19.07,Default,,0,0,0,,‎(Куроба) Не істегенімді қалайсыз?
Dialogue: 0,0:01:19.20,0:01:20.70,Default,,0,0,0,,Жұмыста көмек алу
Dialogue: 0,0:01:21.24,0:01:22.41,Default,,0,0,0,,Жұмыс?
Dialogue: 0,0:01:24.08,0:01:25.21,Default,,0,0,0,,бас тарту
Dialogue: 0,0:01:25.58,0:01:28.42,Default,,0,0,0,,‎Кит Фрикпен не болғаны маңызды ма?
Dialogue: 0,0:01:28.54,0:01:30.50,Default,,0,0,0,,‎(Куроба) Мен үшін уайымдама!
Dialogue: 0,0:01:30.67,0:01:33.21,Default,,0,0,0,,Бұл жақсы, бірақ ол өлсе...
Dialogue: 0,0:01:34.34,0:01:37.22,Default,,0,0,0,,Біз келесі кезекте Юнаға ұмтыламыз, солай ма?
Dialogue: 0,0:01:37.59,0:01:38.59,Default,,0,0,0,,‎(Куроба) Алданба!
Dialogue: 0,0:01:38.72,0:01:41.55,Default,,0,0,0,,‎Егер сіз оны қабылдамасаңыз, Канопус сізді өлтіреді.
Dialogue: 0,0:01:41.68,0:01:44.22,Default,,0,0,0,,‎Мен оны жалғыз қалдырсам да, ол 4 күннен кейін өледі.
Dialogue: 0,0:01:44.85,0:01:46.81,Default,,0,0,0,,‎Сосын Юна
Dialogue: 0,0:01:46.94,0:01:49.81,Default,,0,0,0,,Лили Хошина және оның отбасы
Dialogue: 0,0:01:50.10,0:01:53.23,Default,,0,0,0,,Сізді білетіндердің барлығын өлтіріңіз
Dialogue: 0,0:01:53.36,0:01:54.73,Default,,0,0,0,,‎(Куроба) Ку...
Dialogue: 0,0:01:54.86,0:01:55.99,Default,,0,0,0,,Куроба
Dialogue: 0,0:01:57.36,0:02:00.24,Default,,0,0,0,,Мен сені Құдайды өлтіруді сұраймын.
Dialogue: 0,0:02:01.16,0:02:01.99,Default,,0,0,0,,Құдай...
Dialogue: 0,0:02:02.70,0:02:05.16,Default,,0,0,0,,‎Барлығы елестететін символ
Dialogue: 0,0:02:07.29,0:02:10.13,Default,,0,0,0,,‎Операция туралы мәліметтер сонда қамтылған.
Dialogue: 0,0:02:10.63,0:02:15.88,Default,,0,0,0,,Мен тағайындаған адам 48 сағат ішінде жойылды.
Dialogue: 0,0:02:16.38,0:02:19.38,Default,,0,0,0,,Орындалса, Кит Фрик босатылады.
Dialogue: 0,0:02:19.59,0:02:21.14,Default,,0,0,0,,‎Егер мүмкін болмаса, қажетінше жаңартыңыз
Dialogue: 0,0:02:21.97,0:02:23.68,Default,,0,0,0,,Басқа адамды өлтіру
Dialogue: 0,0:02:23.81,0:02:24.64,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:02:25.18,0:02:26.02,Default,,0,0,0,,Мысалы
Dialogue: 0,0:02:26.43,0:02:27.27,Default,,0,0,0,,‎Ку
Dialogue: 0,0:02:27.68,0:02:28.52,Default,,0,0,0,,Қорқыныш
Dialogue: 0,0:02:28.64,0:02:31.52,Default,,0,0,0,,‎Сен бізді өлтірсең де, Юна құтқарылмайды.
Dialogue: 0,0:02:34.02,0:02:36.78,Default,,0,0,0,,‎Оны құтқару сенің міндетің.
Dialogue: 0,0:02:36.90,0:02:38.36,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:02:42.37,0:02:44.53,Default,,0,0,0,,‎(Захари) Неге мұны істемейсің?
Dialogue: 0,0:02:46.74,0:02:48.83,Default,,0,0,0,,‎Фаура Бланка каноны.
Dialogue: 0,0:02:48.96,0:02:50.92,Default,,0,0,0,,Қылышыңызды төмен түсіріңіз
Dialogue: 0,0:02:51.08,0:02:55.55,Default,,0,0,0,,Мен шабуылға бұйрық берген күннен бастап дайындалдым.
Dialogue: 0,0:02:55.92,0:02:59.05,Default,,0,0,0,,‎Бірақ мен күлге айналмаймын.
Dialogue: 0,0:02:59.80,0:03:00.63,Default,,0,0,0,,‎(Куроба) Хмм...
Dialogue: 0,0:03:20.49,0:03:21.61,Default,,0,0,0,,‎(Куроба) Уф...
Dialogue: 0,0:03:22.70,0:03:24.32,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:03:30.08,0:03:30.91,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:03:37.92,0:03:40.22,Default,,0,0,0,,‎ Әй, ол өзгерген жоқ.
Dialogue: 0,0:03:40.92,0:03:42.72,Default,,0,0,0,,‎Сондықтан мен айттым, солай ма?
Dialogue: 0,0:03:42.84,0:03:46.51,Default,,0,0,0,,Алдымен бір адамды өлтірмейінше, шындық жоқ.
Dialogue: 0,0:03:46.97,0:03:49.85,Default,,0,0,0,,Сіз бізді жалап жатырсыз.
Dialogue: 0,0:03:52.35,0:03:54.56,Default,,0,0,0,,Сіз мейірімді және әлсізсіз.
Dialogue: 0,0:03:55.61,0:03:58.90,Default,,0,0,0,,Ақырында бізді тастап кет
Dialogue: 0,0:03:59.61,0:04:01.15,Default,,0,0,0,,‎(қоңырау дыбысы)
Dialogue: 0,0:04:01.78,0:04:03.45,Default,,0,0,0,,‎(Автокөлік қозғалтқышының дыбысы)
Dialogue: 0,0:04:04.24,0:04:07.33,Default,,0,0,0,,‎(қуаныш)
Dialogue: 0,0:04:14.29,0:04:15.71,Default,,0,0,0,,‎(Халық) Мәртебелі Король!
Dialogue: 0,0:04:15.83,0:04:17.50,Default,,0,0,0,,Мәртебелі Патша аман болсын!
Dialogue: 0,0:04:20.92,0:04:22.51,Default,,0,0,0,,Жауапкершілігіңізді орындаңыз!
Dialogue: 0,0:04:24.13,0:04:26.26,Default,,0,0,0,,‎Дұрыс түсіндіріп беріңізші!
Dialogue: 0,0:04:26.64,0:04:28.18,Default,,0,0,0,,Жауапкершілік!
Dialogue: 0,0:04:30.39,0:04:33.27,Default,,0,0,0,,Король жауап беруі керек!
Dialogue: 0,0:04:33.39,0:04:34.23,Default,,0,0,0,,Өз міндеттеріңізден қашпаңыз!
Dialogue: 0,0:04:34.35,0:04:35.77,Default,,0,0,0,,‎Дұрыс түсіндіріп беріңізші!
Dialogue: 0,0:04:35.90,0:04:37.27,Default,,0,0,0,,‎Ей, қашпа!
Dialogue: 0,0:04:41.40,0:04:42.65,Default,,0,0,0,,(Патша) Захария ше?
Dialogue: 0,0:04:42.78,0:04:44.57,Default,,0,0,0,,‎(Ханзада) Бұл әлі ештеңе емес...
Dialogue: 0,0:04:45.03,0:04:48.74,Default,,0,0,0,,‎Жауапкершілікті талап ету немесе төлемді талап ету жоқ
Dialogue: 0,0:04:49.03,0:04:50.54,Default,,0,0,0,,Біреуі болуы мүмкін емес.
Dialogue: 0,0:04:50.66,0:04:53.75,Default,,0,0,0,,Бұл Фаула Бланканың баласы болса ше?
Dialogue: 0,0:04:57.67,0:04:59.50,Default,,0,0,0,,‎Кек...
Dialogue: 0,0:04:59.92,0:05:03.80,Default,,0,0,0,,‎(Халықтың айқайы)
Dialogue: 0,0:05:04.17,0:05:05.09,Default,,0,0,0,,Мәртебелі (Жүргізуші)
Dialogue: 0,0:05:05.22,0:05:06.05,Default,,0,0,0,,‎(Ханзада) Барыңыз
Dialogue: 0,0:05:19.36,0:05:20.57,Default,,0,0,0,,‎(Ханзада) Мәртебелі
Dialogue: 0,0:05:21.44,0:05:24.82,Default,,0,0,0,,‎Халық... жоқ, дүние байқай бастады.
Dialogue: 0,0:05:24.94,0:05:29.24,Default,,0,0,0,,‎Біз неғұрлым жетілдірілген жүйені мүмкіндігінше тезірек құруымыз керек.
Dialogue: 0,0:05:29.45,0:05:32.83,Default,,0,0,0,,‎Қарап жатқан бұл ел осы уақытқа дейін қалпына келді.
Dialogue: 0,0:05:32.95,0:05:36.71,Default,,0,0,0,,‎Захари мен доктор Альберто Росстың жұмысына рахмет
Dialogue: 0,0:05:36.83,0:05:38.50,Default,,0,0,0,,Сіз білуіңіз керек
Dialogue: 0,0:05:38.88,0:05:40.25,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:41.09,0:05:44.21,Default,,0,0,0,,‎Кенет өзгерістер шатасуды тудырады
Dialogue: 0,0:05:44.34,0:05:46.72,Default,,0,0,0,,‎Сіз сізге уақыт керек дейсіз.
Dialogue: 0,0:05:46.84,0:05:47.84,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:48.51,0:05:50.68,Default,,0,0,0,,‎(Король) Жақында болған төңкеріс жанжал
Dialogue: 0,0:05:50.80,0:05:52.60,Default,,0,0,0,,‎Отты тудырған сен болдың ғой?
Dialogue: 0,0:05:58.10,0:06:01.81,Default,,0,0,0,,Гилберт Росстың ашуы және Реджи
Dialogue: 0,0:06:01.94,0:06:05.32,Default,,0,0,0,,‎Өткеннің жәдігеріне айналып бара жатқаны
Dialogue: 0,0:06:05.57,0:06:07.40,Default,,0,0,0,,Барлығын білу
Dialogue: 0,0:06:07.53,0:06:09.86,Default,,0,0,0,,‎Менің сіз қабылдаған шараларды жоққа шығару ниетім жоқ.
Dialogue: 0,0:06:10.95,0:06:13.99,Default,,0,0,0,,‎Бірақ мен әлі де Реджи тудыратын қорқынышты сезінемін.
Dialogue: 0,0:06:14.12,0:06:18.41,Default,,0,0,0,,Патша сарайының билігінің сақталатыны да рас.
Dialogue: 0,0:06:18.54,0:06:21.08,Default,,0,0,0,,‎(Ханзада) Ыңғайлы түсіндіру сияқты.
Dialogue: 0,0:06:21.54,0:06:25.88,Default,,0,0,0,,‎Елді табандылықпен қиын жағдайда қалдыру мүмкіндігі бар.
Dialogue: 0,0:06:26.26,0:06:27.63,Default,,0,0,0,,Казума
Dialogue: 0,0:06:28.26,0:06:30.64,Default,,0,0,0,,Оны өз уақытында орындаңыз
Dialogue: 0,0:06:30.76,0:06:33.39,Default,,0,0,0,,Болашақта алыс емес
Dialogue: 0,0:06:33.51,0:06:35.64,Default,,0,0,0,,Бірақ қазір бұл менің елім
Dialogue: 0,0:06:36.52,0:06:38.89,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:06:39.02,0:06:40.52,Default,,0,0,0,,‎(діріл дыбысы)
Dialogue: 0,0:06:43.90,0:06:44.98,Default,,0,0,0,,Не?
Dialogue: 0,0:06:47.53,0:06:49.15,Default,,0,0,0,,‎(Ханзада) Мәртебелі (Патша) иә?
Dialogue: 0,0:06:49.28,0:06:51.36,Default,,0,0,0,,Захари табылды
Dialogue: 0,0:06:56.58,0:07:00.54,Default,,0,0,0,,‎(TV:Репортер) Бұл бұрынғы сенатор Захаридің денесі табылған жерден.
Dialogue: 0,0:07:00.67,0:07:02.54,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:07:02.67,0:07:05.25,Default,,0,0,0,,‎Оқиға орнында біраз уақыт дыбыс шықпады.
Dialogue: 0,0:07:05.38,0:07:07.63,Default,,0,0,0,,‎«Киллер В» белгісі қалады
Dialogue: 0,0:07:07.76,0:07:11.26,Default,,0,0,0,,Сериялық кісі өлтіру қайта жалғасуы мүмкін дейді.
Dialogue: 0,0:07:11.38,0:07:12.68,Default,,0,0,0,,Кейбір дауыстар алаңдаушылық білдіруде.
Dialogue: 0,0:07:12.80,0:07:14.05,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,0:07:15.18,0:07:16.93,Default,,0,0,0,,Расталмаған ақпарат
Dialogue: 0,0:07:17.06,0:07:19.93,Default,,0,0,0,,Кейбір куәгерлер оларға қанатты құбыжық шабуыл жасағанын айтады.
Dialogue: 0,0:07:20.31,0:07:21.56,Default,,0,0,0,,‎О, құдай-ау (Репортер) Сол кездегі полиция...
Dialogue: 0,0:07:21.69,0:07:23.94,Default,,0,0,0,,‎Тіпті мәйіттің суреті де жүктелді
Dialogue: 0,0:07:24.56,0:07:25.94,Default,,0,0,0,,Ағып кетті
Dialogue: 0,0:07:26.65,0:07:28.57,Default,,0,0,0,,Марио Борис, кел.
Dialogue: 0,0:07:28.69,0:07:29.69,Default,,0,0,0,,‎Үстіне көбейту
Dialogue: 0,0:07:29.82,0:07:31.03,Default,,0,0,0,,‎Түсіндім Түсіндім
Dialogue: 0,0:07:31.24,0:07:32.57,Default,,0,0,0,,‎Каэла Блан
Dialogue: 0,0:07:32.78,0:07:35.62,Default,,0,0,0,,Ақпаратты қайдан алғаныңызды табыңыз.
Dialogue: 0,0:07:35.74,0:07:36.95,Default,,0,0,0,,Бұл заңсыз ба?
Dialogue: 0,0:07:37.45,0:07:38.54,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:07:38.83,0:07:40.71,Default,,0,0,0,,Лилия! Китті табыңыз.
Dialogue: 0,0:07:41.33,0:07:42.17,Default,,0,0,0,,А?
Dialogue: 0,0:07:42.29,0:07:44.21,Default,,0,0,0,,‎ Тек сіз түсінесіз, өтінемін!
Dialogue: 0,0:07:44.33,0:07:45.67,Default,,0,0,0,,‎Аа... Иә!
Dialogue: 0,0:07:46.25,0:07:47.96,Default,,0,0,0,,‎Қайда бардың...
Dialogue: 0,0:07:48.71,0:07:49.59,Default,,0,0,0,,Кебек!
Dialogue: 0,0:07:49.71,0:07:52.09,Default,,0,0,0,,Мен кішкентай бөлмеге барамын, сондықтан осы жерді қабылдаңыз.
Dialogue: 0,0:07:52.22,0:07:53.34,Default,,0,0,0,,‎Иә~
Dialogue: 0,0:07:55.26,0:07:56.51,Default,,0,0,0,,Ух...
Dialogue: 0,0:07:57.97,0:07:59.27,Default,,0,0,0,,‎Қауіпсіздік коды дегеніміз не?
Dialogue: 0,0:07:59.39,0:08:00.85,Default,,0,0,0,,Менің үш өлшемім
Dialogue: 0,0:08:00.98,0:08:02.02,Default,,0,0,0,,Бұрынғыдай?
Dialogue: 0,0:08:02.14,0:08:03.98,Default,,0,0,0,,Менің белім 2 см өсті
Dialogue: 0,0:08:04.10,0:08:06.65,Default,,0,0,0,,‎Себебі бұл алкоголь мен көмірсулар көп...
Dialogue: 0,0:08:06.77,0:08:08.36,Default,,0,0,0,,Іш қатып қалды! (Есік жабылған дыбыс)
Dialogue: 0,0:08:08.98,0:08:10.19,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:08:15.03,0:08:17.37,Default,,0,0,0,,‎(діріл дыбысы)
Dialogue: 0,0:08:41.39,0:08:43.10,Default,,0,0,0,,‎(Ханзада) Мәселе бар ма?
Dialogue: 0,0:08:43.68,0:08:45.90,Default,,0,0,0,,‎Бізде барлығы бақылауда.
Dialogue: 0,0:08:46.02,0:08:47.31,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:08:47.94,0:08:50.40,Default,,0,0,0,,Мәртебелі туралы не ойлайсыз?
Dialogue: 0,0:08:50.90,0:08:52.53,Default,,0,0,0,,Маған бас тартылды.
Dialogue: 0,0:08:52.65,0:08:56.41,Default,,0,0,0,,Қартайған адамға «өткенді таста» деп айту қатыгездік.
Dialogue: 0,0:08:56.53,0:08:57.87,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:08:59.66,0:09:02.16,Default,,0,0,0,,‎(Ханзада) жоспарланғандай әрекет етіңіз.
Dialogue: 0,0:09:02.29,0:09:03.79,Default,,0,0,0,,‎Күтуге уақыт жоқ
Dialogue: 0,0:09:04.16,0:09:08.29,Default,,0,0,0,,‎Біз мүмкіндігінше тезірек екінші ұрпақ туралы зерттеулерді алға жылжытуымыз керек...
Dialogue: 0,0:09:08.46,0:09:13.34,Default,,0,0,0,,‎ Шығыстың ұлы державалары Канон жобасына орасан зор қаржы салады деген ақпарат бар.
Dialogue: 0,0:09:13.46,0:09:16.18,Default,,0,0,0,,‎(Ханзада) Ол ел шығыстың жолбарысы.
Dialogue: 0,0:09:16.55,0:09:18.43,Default,,0,0,0,,‎Егер сен тартынсаң, тез жетесің.
Dialogue: 0,0:09:19.30,0:09:21.85,Default,,0,0,0,,‎Барлық құқықтар монополияланған
Dialogue: 0,0:09:22.06,0:09:24.06,Default,,0,0,0,,‎Жоғалуға уақыт жоқ
Dialogue: 0,0:09:25.81,0:09:27.23,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:50.63,0:09:51.79,Default,,0,0,0,,‎(күрсініп)
Dialogue: 0,0:10:15.07,0:10:15.90,Default,,0,0,0,,‎(Кит) Ах!
Dialogue: 0,0:10:16.32,0:10:18.24,Default,,0,0,0,,‎Аа... Ах!
Dialogue: 0,0:10:19.53,0:10:21.74,Default,,0,0,0,,‎Хаа ха...
Dialogue: 0,0:10:25.41,0:10:26.58,Default,,0,0,0,,Қауіп
Dialogue: 0,0:10:29.37,0:10:31.42,Default,,0,0,0,,‎Сусыздану белгілері...
Dialogue: 0,0:10:31.88,0:10:34.34,Default,,0,0,0,,Бар болғаны 12 сағат қалды.
Dialogue: 0,0:10:34.46,0:10:35.92,Default,,0,0,0,,‎(Іштің ырылдаған дыбысы)
Dialogue: 0,0:10:38.47,0:10:41.34,Default,,0,0,0,,‎Мм... жаңбыр?
Dialogue: 0,0:10:55.40,0:10:58.78,Default,,0,0,0,,‎Уау~ Осы уақытқа дейін келе ме?
Dialogue: 0,0:11:50.45,0:11:51.83,Default,,0,0,0,,‎(Ханзада) Сіз сенімдісіз бе?
Dialogue: 0,0:11:52.33,0:11:55.33,Default,,0,0,0,,‎Қарақшылар бос тұрған жағдайда, осындай нәрсе...
Dialogue: 0,0:11:55.92,0:11:59.63,Default,,0,0,0,,Көпшілікке шыққан сайын мен өлуге дайынмын.
Dialogue: 0,0:11:59.84,0:12:03.68,Default,,0,0,0,,Әрқашан асқақ патша болып өмір сүріп, өле бер
Dialogue: 0,0:12:04.34,0:12:07.68,Default,,0,0,0,,Ел иесінің тағдыры сол.
Dialogue: 0,0:12:07.81,0:12:10.98,Default,,0,0,0,,Менің әкем патшадан үйренгенім осы.
Dialogue: 0,0:12:11.10,0:12:12.27,Default,,0,0,0,,‎(Ханзада) Ммм...
Dialogue: 0,0:12:13.23,0:12:15.56,Default,,0,0,0,,‎(Жел дыбысы)
Dialogue: 0,0:12:42.47,0:12:43.30,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:13:09.12,0:13:11.62,Default,,0,0,0,,‎(қоңырау дыбысы)
Dialogue: 0,0:13:20.29,0:13:24.63,Default,,0,0,0,,‎(жылау)
Dialogue: 0,0:14:02.46,0:14:04.46,Default,,0,0,0,,‎(Жақындаған аяқ дыбысы)
Dialogue: 0,0:14:05.59,0:14:06.42,Default,,0,0,0,,‎(SP)Уау
Dialogue: 0,0:14:06.63,0:14:07.47,Default,,0,0,0,,Жылжы!
Dialogue: 0,0:14:07.72,0:14:09.51,Default,,0,0,0,,‎(мылтық) ‎(SPs) Уф...
Dialogue: 0,0:14:10.47,0:14:11.35,Default,,0,0,0,,‎(SP)Ах!
Dialogue: 0,0:14:12.14,0:14:12.97,Default,,0,0,0,,‎(мылтық ату)
Dialogue: 0,0:14:13.47,0:14:14.31,Default,,0,0,0,,Ах
Dialogue: 0,0:14:14.72,0:14:15.56,Default,,0,0,0,,‎Ку...
Dialogue: 0,0:14:28.86,0:14:29.70,Default,,0,0,0,,‎(SP) Мәртебелі
Dialogue: 0,0:14:38.71,0:14:40.04,Default,,0,0,0,,‎(Патша) Не болып жатыр?
Dialogue: 0,0:14:40.21,0:14:41.96,Default,,0,0,0,,‎(SP) Қамалда қаскүнем бар.
Dialogue: 0,0:14:42.21,0:14:45.50,Default,,0,0,0,,Захарияға шабуыл жасаған адам сияқты.
Dialogue: 0,0:14:46.09,0:14:47.97,Default,,0,0,0,,Ақымақ! Ол қайдан шықты?
Dialogue: 0,0:14:48.09,0:14:49.88,Default,,0,0,0,,‎(SP) Дереу қауіпсіз жерге барыңыз
Dialogue: 0,0:14:50.01,0:14:51.14,Default,,0,0,0,,Жүрейік
Dialogue: 0,0:14:51.26,0:14:53.64,Default,,0,0,0,,‎Жоқ, осылай жалғастырыңыз
Dialogue: 0,0:14:54.22,0:14:58.60,Default,,0,0,0,,‎Мәртебелі, мен сіздің сезімдеріңізді түсінемін, бірақ қазіргі жағдайда қатысушыларға да қауіп төніп тұр.
Dialogue: 0,0:14:58.73,0:15:01.73,Default,,0,0,0,,‎Рәсім уақытша тоқтатылады және барлығы эвакуацияланады.
Dialogue: 0,0:15:01.85,0:15:05.23,Default,,0,0,0,,Мәртебелі, қауіпсіз жерге барыңыз.
Dialogue: 0,0:15:05.61,0:15:06.90,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,0:15:07.03,0:15:07.99,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:15:11.32,0:15:12.16,Default,,0,0,0,,‎(Жарылыс дыбысы)
Dialogue: 0,0:15:12.28,0:15:13.62,Default,,0,0,0,,‎(Адамдардың айқайы)
Dialogue: 0,0:15:14.33,0:15:15.49,Default,,0,0,0,,‎(Ер адам) Бұл бомба ма?
Dialogue: 0,0:15:44.19,0:15:45.02,Default,,0,0,0,,Ах
Dialogue: 0,0:15:49.90,0:15:51.24,Default,,0,0,0,,‎(оқ ату)
Dialogue: 0,0:16:06.29,0:16:07.50,Default,,0,0,0,,‎(SP)Ах (SP)Ух...
Dialogue: 0,0:16:09.00,0:16:10.59,Default,,0,0,0,,‎(Ханзада)... ‎(СП еңіреп)
Dialogue: 0,0:16:12.13,0:16:13.05,Default,,0,0,0,,‎(Патша) Ах...
Dialogue: 0,0:16:18.85,0:16:19.68,Default,,0,0,0,,‎(Ханзада)
Dialogue: 0,0:16:21.14,0:16:22.64,Default,,0,0,0,,‎(оқ ату)
Dialogue: 0,0:16:33.57,0:16:34.57,Default,,0,0,0,,Ах
Dialogue: 0,0:16:42.12,0:16:43.91,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:16:50.42,0:16:52.13,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:16:52.92,0:16:53.88,Default,,0,0,0,,Не?
Dialogue: 0,0:16:54.38,0:16:58.39,Default,,0,0,0,,Мәселе шешілгенше жасырыңыз
Dialogue: 0,0:16:58.93,0:16:59.76,Default,,0,0,0,,‎(Патша) Хмм...
Dialogue: 0,0:16:59.89,0:17:03.18,Default,,0,0,0,,‎(Куроба) Егер сіз момындықпен орындасаңыз, сіздің қауіпсіздігіңізге кепілдік беріледі.
Dialogue: 0,0:17:03.31,0:17:05.81,Default,,0,0,0,,‎(Патша) О, сен маған сенуімді сұрап тұрсың ба?
Dialogue: 0,0:17:05.94,0:17:08.11,Default,,0,0,0,,‎Сен Захарияны өлтірдің!
Dialogue: 0,0:17:08.23,0:17:09.15,Default,,0,0,0,,‎(Куроба) Бұл мен емес!
Dialogue: 0,0:17:10.69,0:17:11.65,Default,,0,0,0,,‎(күрсініп)
Dialogue: 0,0:17:12.90,0:17:15.40,Default,,0,0,0,,‎(Ханзада) Өкінішке орай, Кирисаменің оқуы дұрыс деп ойлаймын.
Dialogue: 0,0:17:15.82,0:17:16.66,Default,,0,0,0,,‎(Куроба) Ха!
Dialogue: 0,0:17:17.74,0:17:21.62,Default,,0,0,0,,Сіз біз жақта болуға дайын емес сияқтысыз.
Dialogue: 0,0:17:22.75,0:17:23.91,Default,,0,0,0,,‎Сен не туралы айтып тұрсың?
Dialogue: 0,0:17:24.91,0:17:26.83,Default,,0,0,0,,‎(Ханзада) Жоспар қозғала бастады.
Dialogue: 0,0:17:27.04,0:17:30.38,Default,,0,0,0,,Менің уақытым жоқ, сондықтан мен жалғастыруға мәжбүрмін.
Dialogue: 0,0:17:32.42,0:17:33.26,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:17:37.43,0:17:38.14,Default,,0,0,0,,Ах
Dialogue: 0,0:17:48.77,0:17:50.94,Default,,0,0,0,,‎Сен неге бұл жігітті қорғайсың?
Dialogue: 0,0:17:51.07,0:17:53.57,Default,,0,0,0,,‎Кирисамеге «өлтіруге» бұйрық берілді, солай ма?
Dialogue: 0,0:18:41.03,0:18:41.87,Default,,0,0,0,,‎Хмм.
Dialogue: 0,0:18:42.87,0:18:44.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:44.91,0:18:48.62,Default,,0,0,0,,‎(Ханзада) Күткендей, дәл сіз айтқандай болды.
Dialogue: 0,0:18:50.75,0:18:52.25,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:18:52.38,0:18:55.00,Default,,0,0,0,,‎Мәселе жоқ, мұны өзіңіз жасаңыз
Dialogue: 0,0:19:31.08,0:19:31.92,Default,,0,0,0,,Ах
Dialogue: 0,0:19:33.83,0:19:34.88,Default,,0,0,0,,Куроба...
Dialogue: 0,0:19:42.93,0:19:43.76,Default,,0,0,0,,A...
Dialogue: 0,0:19:47.51,0:19:48.35,Default,,0,0,0,,Сіз
Dialogue: 0,0:19:51.98,0:19:53.02,Default,,0,0,0,,А...
Dialogue: 0,0:19:59.40,0:20:00.53,Default,,0,0,0,,‎Қуғудың қажеті жоқ
Dialogue: 0,0:20:45.32,0:20:51.33,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:22:29.26,0:22:35.27,Default,,0,0,0,,‎〜♪
