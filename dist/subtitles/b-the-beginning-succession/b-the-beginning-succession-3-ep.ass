Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,‎NETFLIX түпнұсқа аниме сериясы
Dialogue: 0,0:00:13.68,0:00:16.05,Default,,0,0,0,,‎(Кит) Ол әлі тірі ме?
Dialogue: 0,0:00:16.47,0:00:18.47,Default,,0,0,0,,Менің кім екенімді білесің бе?
Dialogue: 0,0:00:19.85,0:00:21.39,Default,,0,0,0,,‎(Кейт) Кирисаме-кун
Dialogue: 0,0:00:23.60,0:00:27.31,Default,,0,0,0,,Соңғы күндері Реджи өлімі өсті.
Dialogue: 0,0:00:27.48,0:00:28.65,Default,,0,0,0,,Бұл сіздің операцияңыз ба?
Dialogue: 0,0:00:29.19,0:00:33.15,Default,,0,0,0,,‎ «Ұйымды қайта құру кезінде барлық реггилерді жойыңыз»
Dialogue: 0,0:00:33.28,0:00:34.70,Default,,0,0,0,,‎Бұл тапсырыс болғандықтан...
Dialogue: 0,0:00:34.82,0:00:35.91,Default,,0,0,0,,‎(Кит) Сіз қай жақтансыз?
Dialogue: 0,0:00:38.49,0:00:40.66,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:00:41.49,0:00:43.20,Default,,0,0,0,,Ол қиын адам.
Dialogue: 0,0:00:43.33,0:00:44.16,Default,,0,0,0,,‎(Кит)?
Dialogue: 0,0:00:44.50,0:00:46.46,Default,,0,0,0,,‎Бұл жолы не болды?
Dialogue: 0,0:00:46.58,0:00:49.92,Default,,0,0,0,,‎Менде әлі де кейбір пайдалану құндылығы бар деп айту дұрыс па?
Dialogue: 0,0:00:50.04,0:00:52.30,Default,,0,0,0,,Сіз шынымен қызықсыз
Dialogue: 0,0:00:52.55,0:00:54.51,Default,,0,0,0,,‎(Кит) Ах~ Бұл жиі айтылады.
Dialogue: 0,0:00:54.63,0:00:56.76,Default,,0,0,0,,‎
Dialogue: 0,0:00:57.26,0:01:00.01,Default,,0,0,0,,‎Сіз де әр уақытта көп еңбек еттіңіз.
Dialogue: 0,0:01:00.51,0:01:01.68,Default,,0,0,0,,‎Қажырлы еңбегіңіз үшін рахмет
Dialogue: 0,0:01:01.93,0:01:02.77,Default,,0,0,0,,Е...
Dialogue: 0,0:01:03.77,0:01:05.81,Default,,0,0,0,,Әрине, сіз қайда барсаңыз да
Dialogue: 0,0:01:05.94,0:01:09.69,Default,,0,0,0,,‎Мен ғана сен түсінетін қолтаңба қалдырдым.
Dialogue: 0,0:01:10.32,0:01:11.86,Default,,0,0,0,,‎(Кит) Жазықсыз науқас Гилбертке
Dialogue: 0,0:01:11.98,0:01:15.07,Default,,0,0,0,,Сіз егжей-тегжейлі белгіні жасай алмайсыз.
Dialogue: 0,0:01:15.74,0:01:18.91,Default,,0,0,0,,‎Бұл керемет жұмыс болды, Кирисаме-кун.
Dialogue: 0,0:01:19.99,0:01:23.20,Default,,0,0,0,,‎ Кит Казама Мен оны біраз уақыттан бері естігім келді.
Dialogue: 0,0:01:23.50,0:01:25.41,Default,,0,0,0,,Мұның бәрі тұзақ екенін білгеннен кейін
Dialogue: 0,0:01:25.54,0:01:27.71,Default,,0,0,0,,‎Сен неге әрқашан осындасың?
Dialogue: 0,0:01:28.29,0:01:30.08,Default,,0,0,0,,Мен жай ғана білгім келеді
Dialogue: 0,0:01:32.05,0:01:36.97,Default,,0,0,0,,«Құдай өлтіруші шайтанға айналады, ал шайтан өлтіруші патша болады».
Dialogue: 0,0:01:38.64,0:01:40.35,Default,,0,0,0,,Эй, сен қалай ойлайсың?
Dialogue: 0,0:01:41.18,0:01:44.10,Default,,0,0,0,,Мен тастар билейтін адаммын ба?
Dialogue: 0,0:01:44.60,0:01:45.64,Default,,0,0,0,,Балалар сендер?
Dialogue: 0,0:01:45.93,0:01:51.94,Default,,0,0,0,,‎♪~
Dialogue: 0,0:01:54.78,0:02:00.78,Default,,0,0,0,,‎~♪
Dialogue: 0,0:02:02.20,0:02:03.74,Default,,0,0,0,,‎(аяқ дыбысы)
Dialogue: 0,0:02:29.27,0:02:30.40,Default,,0,0,0,,‎Хмм~
Dialogue: 0,0:03:05.89,0:03:07.77,Default,,0,0,0,,‎Бұл тұзақ
Dialogue: 0,0:03:07.89,0:03:08.81,Default,,0,0,0,,‎(шу)
Dialogue: 0,0:03:09.43,0:03:10.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:13.19,0:03:15.44,Default,,0,0,0,,‎Куроба... сен бе?
Dialogue: 0,0:03:43.26,0:03:45.43,Default,,0,0,0,,‎(Өрт сөндіруші) Сәл оңға қарай, оңға жылжытыңыз.
Dialogue: 0,0:03:45.93,0:03:48.22,Default,,0,0,0,,‎Иә, иә, иә, жарайды, жарайды!
Dialogue: 0,0:04:07.20,0:04:08.16,Default,,0,0,0,,‎(SP) Жоқ, жоқ, жоқ
Dialogue: 0,0:04:08.28,0:04:11.00,Default,,0,0,0,,‎(Полиция қызметкері) Егер мұндай шектеулер болса, тергеу болмас еді.
Dialogue: 0,0:04:12.04,0:04:14.50,Default,,0,0,0,,‎(Сот-медициналық қызметкер) Саусақ іздерін осы жерден және осы жерден жинаңыз.
Dialogue: 0,0:04:15.08,0:04:16.67,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:04:16.79,0:04:18.21,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:04:18.34,0:04:21.97,Default,,0,0,0,,‎Корольдік отбасының мүшесіне сараптама жасау үшін сізге арнайы рұқсат қажет.
Dialogue: 0,0:04:22.09,0:04:24.26,Default,,0,0,0,,‎Егер солай болса, оны алу керек.
Dialogue: 0,0:04:24.97,0:04:26.22,Default,,0,0,0,,Мен төмен түспеймін.
Dialogue: 0,0:04:26.34,0:04:27.51,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:04:37.15,0:04:41.11,Default,,0,0,0,,Сіз жәбірленушінің жағдайын білмей тергеу жүргізе аласыз ба?
Dialogue: 0,0:04:41.23,0:04:43.44,Default,,0,0,0,,‎Өлімнің себебі не болды? Кісі өлтіру қаруы қандай болды?
Dialogue: 0,0:04:43.57,0:04:46.28,Default,,0,0,0,,Біз нені және қалай зерттеуіміз керек?
Dialogue: 0,0:04:46.61,0:04:47.49,Default,,0,0,0,,Борис
Dialogue: 0,0:04:47.62,0:04:49.78,Default,,0,0,0,,Бұл біртүрлі деп ойламайсыз ба?
Dialogue: 0,0:04:52.66,0:04:55.79,Default,,0,0,0,,‎(Сот-медициналық қызметкер) Абайлаңыз. Бұл менің жұмысыма жақсы емес.
Dialogue: 0,0:04:56.17,0:04:57.00,Default,,0,0,0,,‎Хмм?
Dialogue: 0,0:04:57.42,0:04:58.38,Default,,0,0,0,,‎Мм~
Dialogue: 0,0:04:59.63,0:05:03.17,Default,,0,0,0,,Біздің жұмысымыз осында болу.
Dialogue: 0,0:05:03.38,0:05:04.26,Default,,0,0,0,,‎
Dialogue: 0,0:05:04.38,0:05:08.01,Default,,0,0,0,,‎Ал келесіде әдеттегі Император штабының хабарландыруы.
Dialogue: 0,0:05:08.43,0:05:09.68,Default,,0,0,0,,‎Ммм~
Dialogue: 0,0:05:11.01,0:05:11.97,Default,,0,0,0,,‎(Ысырма дыбысы)
Dialogue: 0,0:05:12.10,0:05:13.89,Default,,0,0,0,,Сіз Лилиден естідіңіз бе?
Dialogue: 0,0:05:14.02,0:05:14.93,Default,,0,0,0,,№.
Dialogue: 0,0:05:15.27,0:05:16.89,Default,,0,0,0,,‎Тұрақты байланыс жоқ па?
Dialogue: 0,0:05:17.02,0:05:18.90,Default,,0,0,0,,Бұл әдеттегі нәрсе, солай ма?
Dialogue: 0,0:05:19.02,0:05:20.57,Default,,0,0,0,,‎Шпинат – жұмыстың негізі...
Dialogue: 0,0:05:20.69,0:05:21.90,Default,,0,0,0,,‎(Брэндон: сыбырлап) Хаа~ Шулы, шулы...
Dialogue: 0,0:05:22.03,0:05:24.53,Default,,0,0,0,,‎Толығымен заманауи жас адам
Dialogue: 0,0:05:24.65,0:05:26.90,Default,,0,0,0,,Мен қиындыққа тап болдым. (Брэндон: Сыбырлап) Өте тітіркендіргіш...
Dialogue: 0,0:05:27.16,0:05:28.45,Default,,0,0,0,,‎Хмм~? мен...!
Dialogue: 0,0:05:28.57,0:05:31.20,Default,,0,0,0,,‎(көліктің жүгіру дыбысы)
Dialogue: 0,0:05:46.05,0:05:50.68,Default,,0,0,0,,Басқаша айтқанда, Китті Кирисаме ұрлап кеткен болуы мүмкін.
Dialogue: 0,0:05:50.80,0:05:52.01,Default,,0,0,0,,‎...бұл дегеніміз бе?
Dialogue: 0,0:05:52.14,0:05:53.14,Default,,0,0,0,,‎(Куроба) Иә
Dialogue: 0,0:05:54.56,0:05:56.77,Default,,0,0,0,,Мен солай ойлаймын (Куроба) Иә?
Dialogue: 0,0:05:58.06,0:06:01.48,Default,,0,0,0,,Кит, оны ұрлап кететін шығар.
Dialogue: 0,0:06:01.69,0:06:02.57,Default,,0,0,0,,‎(Куроба) Иә?
Dialogue: 0,0:06:02.82,0:06:06.19,Default,,0,0,0,,Мен бұлай болатынын біле тұра бардым.
Dialogue: 0,0:06:06.32,0:06:07.49,Default,,0,0,0,,Не үшін?
Dialogue: 0,0:06:08.07,0:06:09.82,Default,,0,0,0,,Мен егжей-тегжейлерін білмеймін
Dialogue: 0,0:06:10.07,0:06:12.08,Default,,0,0,0,,‎Бірақ мен бір нәрсені іздедім.
Dialogue: 0,0:06:12.20,0:06:14.95,Default,,0,0,0,,Мен ол «жауап» деп атаған нәрсені таптым
Dialogue: 0,0:06:15.08,0:06:19.17,Default,,0,0,0,,Содан кейін мен әдеттегідей «растау» үшін оқиға орнына бардым.
Dialogue: 0,0:06:19.33,0:06:23.09,Default,,0,0,0,,‎Ұрлану мүмкіндігі «растау» ретінде қарастырылды.
Dialogue: 0,0:06:25.30,0:06:27.13,Default,,0,0,0,,Тек бір сөз айтыңыз
Dialogue: 0,0:06:28.67,0:06:32.55,Default,,0,0,0,,‎Егер сізде нәжіс, диарея немесе іш қату болса, олар қажетсіз ақпаратты жібереді.
Dialogue: 0,0:06:32.68,0:06:34.51,Default,,0,0,0,,Қажетті ештеңе айтпаңыз
Dialogue: 0,0:06:34.64,0:06:35.77,Default,,0,0,0,,‎(Куроба) Лили-сан?
Dialogue: 0,0:06:36.60,0:06:39.85,Default,,0,0,0,,‎Өз көзімен көрмейінше, ол ештеңеге сенбейді.
Dialogue: 0,0:06:40.23,0:06:43.27,Default,,0,0,0,,‎Ақылды болсам да, менде ақылды адамның менталитеті жоқ.
Dialogue: 0,0:06:43.61,0:06:47.24,Default,,0,0,0,,Оның мінезі ақымақ және бесінші сынып оқушысына тән!
Dialogue: 0,0:06:47.36,0:06:49.03,Default,,0,0,0,,‎Жоқ, бұл 3-сынып.
Dialogue: 0,0:06:49.53,0:06:50.78,Default,,0,0,0,,Мен шынымен солай ойлаймын.
Dialogue: 0,0:06:51.11,0:06:53.28,Default,,0,0,0,,Менің ішкі мүшелерім жеп, өлемін деп үміттенемін!
Dialogue: 0,0:06:54.62,0:06:57.66,Default,,0,0,0,,Сіздің балағат сөздерге арналған сөздік қорыңыз керемет.
Dialogue: 0,0:06:58.12,0:06:59.29,Default,,0,0,0,,Қандай болса да
Dialogue: 0,0:06:59.75,0:07:02.92,Default,,0,0,0,,‎Бізде ізбен жүруден басқа амал жоқ.
Dialogue: 0,0:07:40.12,0:07:41.21,Default,,0,0,0,,‎(иіскеу дыбысы)
Dialogue: 0,0:07:43.58,0:07:46.34,Default,,0,0,0,,‎Бұл көгерген жоқ, бұл жерде.
Dialogue: 0,0:08:00.31,0:08:03.06,Default,,0,0,0,,‎Әзірше оны дұрыстап қарап, өзімізбен бірге алып кетейік.
Dialogue: 0,0:08:03.31,0:08:04.44,Default,,0,0,0,,‎(Куроба) Мен түсіндім.
Dialogue: 0,0:08:05.19,0:08:06.02,Default,,0,0,0,,А...
Dialogue: 0,0:08:10.90,0:08:12.61,Default,,0,0,0,,‎Эй, мынаны қарашы.
Dialogue: 0,0:08:13.36,0:08:15.49,Default,,0,0,0,,‎Бұл Куроба-кун шығар?
Dialogue: 0,0:08:15.95,0:08:17.37,Default,,0,0,0,,Иә
Dialogue: 0,0:08:17.49,0:08:19.12,Default,,0,0,0,,Бұл өте сүйкімді
Dialogue: 0,0:08:19.99,0:08:21.66,Default,,0,0,0,,Бұл Юна Чан, солай ма?
Dialogue: 0,0:08:24.08,0:08:24.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:26.46,0:08:28.21,Default,,0,0,0,,‎(Куроба) Бұл Кирисаме
Dialogue: 0,0:08:29.17,0:08:30.42,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:08:31.84,0:08:34.55,Default,,0,0,0,,‎Кирисаме не істегісі келеді?
Dialogue: 0,0:08:34.88,0:08:38.64,Default,,0,0,0,,‎Мұны істеудің қажеті жоқ, сіз осы ақымақ істерді істеп жатырсыз.
Dialogue: 0,0:08:39.56,0:08:42.27,Default,,0,0,0,,‎Егер сіз патшаны өлтіргіңіз келсе, оны жасаңыз.
Dialogue: 0,0:08:42.98,0:08:46.10,Default,,0,0,0,,Мен Куроба-кун мен Китті қатыстырудың мәнін түсінбеймін.
Dialogue: 0,0:08:46.23,0:08:48.98,Default,,0,0,0,,‎Қажет емес элементтерді қосу
Dialogue: 0,0:08:49.11,0:08:51.86,Default,,0,0,0,,Сіз өз жоспарларыңызға қауіп төндіріп жатырсыз.
Dialogue: 0,0:08:52.86,0:08:54.61,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:08:54.74,0:08:57.66,Default,,0,0,0,,Менің ойымша, мақсат патшаның өмірі емес.
Dialogue: 0,0:08:57.99,0:08:58.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:00.08,0:09:03.75,Default,,0,0,0,,Менің мақсатым патшаны өлтіру деп ойлаймын.
Dialogue: 0,0:09:07.96,0:09:09.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:09.34,0:09:10.38,Default,,0,0,0,,Хехе! Қарғыс атсын.
Dialogue: 0,0:09:10.50,0:09:12.00,Default,,0,0,0,,Хехе! G...
Dialogue: 0,0:09:13.51,0:09:14.51,Default,,0,0,0,,Йойшо
Dialogue: 0,0:09:15.42,0:09:18.09,Default,,0,0,0,,Мен біраз түсінік таба аламын деп үміттенемін.
Dialogue: 0,0:09:23.06,0:09:24.10,Default,,0,0,0,,‎Фу...
Dialogue: 0,0:09:24.81,0:09:25.64,Default,,0,0,0,,‎Хмм?
Dialogue: 0,0:09:33.53,0:09:35.95,Default,,0,0,0,,‎(қозғалтқыштың іске қосылу дыбысы)
Dialogue: 0,0:09:37.99,0:09:40.62,Default,,0,0,0,,‎Эй, сен Куроба-кун (Куроба)сың ба?
Dialogue: 0,0:09:41.24,0:09:42.20,Default,,0,0,0,,‎Бұл не?
Dialogue: 0,0:09:47.29,0:09:48.83,Default,,0,0,0,,‎(қозғалтқыштың іске қосылу дыбысы)
Dialogue: 0,0:09:51.00,0:09:52.38,Default,,0,0,0,,‎(сықырлаған дыбыс)
Dialogue: 0,0:09:53.00,0:09:55.17,Default,,0,0,0,,Не? (Куроба) Лили-сан, мені шығар!
Dialogue: 0,0:09:55.46,0:09:56.67,Default,,0,0,0,,‎(сықырлаған дыбыс)
Dialogue: 0,0:10:03.35,0:10:05.22,Default,,0,0,0,,Ах! Ой!
Dialogue: 0,0:10:27.12,0:10:28.41,Default,,0,0,0,,‎(2 адам) Уф...
Dialogue: 0,0:10:28.71,0:10:30.37,Default,,0,0,0,,‎Көбірек ұшыңыз!
Dialogue: 0,0:10:30.58,0:10:32.13,Default,,0,0,0,,‎Түртіп алу!
Dialogue: 0,0:10:33.50,0:10:35.42,Default,,0,0,0,,‎«Сол пішін»
Dialogue: 0,0:10:35.80,0:10:38.47,Default,,0,0,0,,«Таңғажайып қауырсын сияқты жас»
Dialogue: 0,0:10:38.67,0:10:41.14,Default,,0,0,0,,«Юрю но Йосай»
Dialogue: 0,0:10:46.31,0:10:47.14,Default,,0,0,0,,‎(мылтық ату)
Dialogue: 0,0:10:47.39,0:10:48.73,Default,,0,0,0,,‎(сықырлаған дыбыс)
Dialogue: 0,0:10:55.44,0:10:59.65,Default,,0,0,0,,«Даңқты күзгі хризантемалар, гүлденген көктемгі қарағайлар»
Dialogue: 0,0:11:00.53,0:11:04.08,Default,,0,0,0,,«Ашық бұлттағы жас айды еске түсіреді»
Dialogue: 0,0:11:04.37,0:11:08.16,Default,,0,0,0,,‎«Бақабақ желдің бұрылуы сияқты көрінеді»
Dialogue: 0,0:11:23.26,0:11:24.89,Default,,0,0,0,,‎Енді не істейсіз?
Dialogue: 0,0:11:25.51,0:11:27.06,Default,,0,0,0,,Өзгерістер жоқ
Dialogue: 0,0:11:27.43,0:11:30.18,Default,,0,0,0,,‎(аяқ дыбысы)
Dialogue: 0,0:11:32.02,0:11:33.19,Default,,0,0,0,,О...
Dialogue: 0,0:11:42.03,0:11:43.36,Default,,0,0,0,,‎Хмм~?
Dialogue: 0,0:11:45.78,0:11:46.70,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:49.04,0:11:49.95,Default,,0,0,0,,Кім?
Dialogue: 0,0:11:50.54,0:11:51.66,Default,,0,0,0,,Көптен бері көрмегелі
Dialogue: 0,0:11:51.79,0:11:53.71,Default,,0,0,0,,‎(Куроба) Аяқтар? Сонда кім?
Dialogue: 0,0:11:55.08,0:11:56.88,Default,,0,0,0,,Мен оған біраз үйреніп қалдым.
Dialogue: 0,0:12:19.61,0:12:20.44,Default,,0,0,0,,‎(Куроба) Жақсы.
Dialogue: 0,0:12:20.78,0:12:21.74,Default,,0,0,0,,А...
Dialogue: 0,0:12:22.11,0:12:23.03,Default,,0,0,0,,‎Фу...
Dialogue: 0,0:12:23.95,0:12:29.58,Default,,0,0,0,,‎Аяқ киім табу қиын, себебі өлшемдері мүлдем басқаша.
Dialogue: 0,0:12:31.29,0:12:33.46,Default,,0,0,0,,‎Жоқ, менің уақытым жоқ.
Dialogue: 0,0:12:33.87,0:12:36.17,Default,,0,0,0,,Олар байқамай тұрып барайық.
Dialogue: 0,0:12:36.29,0:12:38.46,Default,,0,0,0,,‎(Куроба) О, сонда кім?
Dialogue: 0,0:12:39.63,0:12:40.46,Default,,0,0,0,,‎(электрондық дыбыс)
Dialogue: 0,0:12:40.67,0:12:44.01,Default,,0,0,0,,‎(есіктің ашылған дыбысы)
Dialogue: 0,0:12:45.43,0:12:47.72,Default,,0,0,0,,‎Осы жерді басыңыз.
Dialogue: 0,0:13:04.61,0:13:06.07,Default,,0,0,0,,А...
Dialogue: 0,0:13:06.20,0:13:07.11,Default,,0,0,0,,Юна-чан!
Dialogue: 0,0:13:07.62,0:13:08.45,Default,,0,0,0,,Лили-сан
Dialogue: 0,0:13:08.57,0:13:10.87,Default,,0,0,0,,Жақсы! Сіз қауіпсізсіз.
Dialogue: 0,0:13:11.45,0:13:14.33,Default,,0,0,0,,Иә, Лилидің де қауіпсіз екеніне көңілім толды.
Dialogue: 0,0:13:14.46,0:13:18.33,Default,,0,0,0,,‎ A~ Сүйкімді A~ Сүйкімді Бұл Куроба-кун үшін босқа
Dialogue: 0,0:13:18.46,0:13:21.96,Default,,0,0,0,,‎О, у... өтінемін, мені жіберіңізші.
Dialogue: 0,0:13:26.72,0:13:28.64,Default,,0,0,0,,‎Эй, бұл қай жер?
Dialogue: 0,0:13:29.22,0:13:32.64,Default,,0,0,0,,‎Бұл біз маркет-мейкерлер пайдаланатын кеңсе.
Dialogue: 0,0:13:32.97,0:13:35.60,Default,,0,0,0,,‎Бұл жерде Кирисамені бақылау туралы алаңдамаудың қажеті жоқ.
Dialogue: 0,0:13:35.73,0:13:36.89,Default,,0,0,0,,‎Ах~
Dialogue: 0,0:13:37.98,0:13:42.40,Default,,0,0,0,,Менің ойымша, жиналған багажды тексеру уақыты келді.
Dialogue: 0,0:13:43.11,0:13:43.98,Default,,0,0,0,,‎(Куроба)...
Dialogue: 0,0:13:45.82,0:13:46.90,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:52.54,0:13:54.41,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:13:55.00,0:13:57.12,Default,,0,0,0,,Бір минут күте тұрыңыз! Қалай әлі тірісің?
Dialogue: 0,0:13:57.25,0:13:58.87,Default,,0,0,0,,Жоқ, «тірі» ме?
Dialogue: 0,0:13:59.00,0:14:01.92,Default,,0,0,0,,‎Ух... мұндай жағдайда мен не айтуым керек?
Dialogue: 0,0:14:02.25,0:14:03.63,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:14:03.75,0:14:05.42,Default,,0,0,0,,‎Ой... Сабыр етіңіз.
Dialogue: 0,0:14:06.51,0:14:07.42,Default,,0,0,0,,‎(Патша) Ах...
Dialogue: 0,0:14:07.76,0:14:08.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:09.01,0:14:11.35,Default,,0,0,0,,‎Маған неге көмектестің?
Dialogue: 0,0:14:12.72,0:14:13.76,Default,,0,0,0,,‎(Пышақ жыртылған дыбыс) ‎(Ханзада) Хе!
Dialogue: 0,0:14:14.06,0:14:15.22,Default,,0,0,0,,‎(Патша) Ух...
Dialogue: 0,0:14:20.23,0:14:21.52,Default,,0,0,0,,А...
Dialogue: 0,0:14:26.15,0:14:27.11,Default,,0,0,0,,‎(Ханзада) Ха...
Dialogue: 0,0:14:28.90,0:14:29.74,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:30.24,0:14:31.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:31.41,0:14:32.32,Default,,0,0,0,,‎G...
Dialogue: 0,0:14:33.20,0:14:34.49,Default,,0,0,0,,А...
Dialogue: 0,0:14:35.58,0:14:37.04,Default,,0,0,0,,A...
Dialogue: 0,0:14:37.62,0:14:38.50,Default,,0,0,0,,‎Хмм?
Dialogue: 0,0:14:47.09,0:14:50.89,Default,,0,0,0,,Фаула Бланкаға шабуыл жасауға кім бұйрық берді?
Dialogue: 0,0:14:51.14,0:14:52.80,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:14:57.39,0:15:01.06,Default,,0,0,0,,‎Иә, бұл жақсы мүмкіндік. Біраздан бері сенен осыны сұрайын деп едім.
Dialogue: 0,0:15:04.15,0:15:05.61,Default,,0,0,0,,Неліктен? (Патша) А...
Dialogue: 0,0:15:06.65,0:15:09.82,Default,,0,0,0,,Сіз доктор Казамадан ештеңе естіген жоқсыз ба?
Dialogue: 0,0:15:13.53,0:15:15.12,Default,,0,0,0,,‎(күрсіну)
Dialogue: 0,0:15:17.41,0:15:20.04,Default,,0,0,0,,Енді оны жасырудың қажеті жоқ.
Dialogue: 0,0:15:20.41,0:15:23.58,Default,,0,0,0,,‎Бұл мен оның тікелей өзінен естідім.
Dialogue: 0,0:15:24.00,0:15:25.59,Default,,0,0,0,,‎Доктор Казамадан?
Dialogue: 0,0:15:27.67,0:15:32.26,Default,,0,0,0,,Барлығы сенің туғаныңнан басталады...
Dialogue: 0,0:15:33.18,0:15:36.76,Default,,0,0,0,,Сіздің ұяшықтарыңыз барлығын инициализациялап, қайта жасай алады.
Dialogue: 0,0:15:37.06,0:15:38.81,Default,,0,0,0,,Және бірден
Dialogue: 0,0:15:38.93,0:15:41.52,Default,,0,0,0,,Бұл панацея болуы мүмкін
Dialogue: 0,0:15:42.56,0:15:45.19,Default,,0,0,0,,‎Бірақ сіз тек одақтастарыңызға ауыса аласыз.
Dialogue: 0,0:15:45.81,0:15:49.57,Default,,0,0,0,,‎Өйткені кез келген басқа дене бірнеше минут ішінде қатерлі ісікке айналады.
Dialogue: 0,0:15:50.49,0:15:54.82,Default,,0,0,0,,‎Бұл түрді қорғауға арналған қауіпсіздік құралы деп аталатын сияқты.
Dialogue: 0,0:15:55.74,0:15:59.20,Default,,0,0,0,,‎Бірақ оның құлпын ашу үшін кілт бар.
Dialogue: 0,0:16:00.70,0:16:03.96,Default,,0,0,0,,‎Белгілі бір шарттарға сәйкес келетін бейтараптар каноны
Dialogue: 0,0:16:04.75,0:16:08.84,Default,,0,0,0,,‎Сіз таңдау арқылы бұл канон әйелге айналады.
Dialogue: 0,0:16:08.96,0:16:12.68,Default,,0,0,0,,‎Бір уақытта ол сізді құлпын ашатын кілтке айналады.
Dialogue: 0,0:16:13.80,0:16:19.56,Default,,0,0,0,,‎Айысып өткен келесі ұрпақ жасушаларын адамдарға да трансплантациялауға болады.
Dialogue: 0,0:16:19.93,0:16:23.19,Default,,0,0,0,,‎Сонымен қатар, қан тамыры мәңгілікке жалғасады.
Dialogue: 0,0:16:24.48,0:16:30.07,Default,,0,0,0,,Басқаша айтқанда, регенеративті медицина үйлесімділік туралы ойланбастан бірнеше минут ішінде мүмкін болады.
Dialogue: 0,0:16:30.23,0:16:34.32,Default,,0,0,0,,‎Бұл бәрі өзгеретін түс сияқты.
Dialogue: 0,0:16:34.66,0:16:37.62,Default,,0,0,0,,‎Барлық дерлік ауруларды емдеуге болады
Dialogue: 0,0:16:40.33,0:16:43.46,Default,,0,0,0,,Үлкен пайда болады
Dialogue: 0,0:16:44.75,0:16:48.25,Default,,0,0,0,,‎Өмірді тек байлар ғана сатып алатын уақыт келеді.
Dialogue: 0,0:16:49.13,0:16:51.17,Default,,0,0,0,,‎Егер бұл менің өмірім болса, бәрі жақсы.
Dialogue: 0,0:16:52.38,0:16:56.18,Default,,0,0,0,,Бірақ тіпті уақытты сіздің жасушаларыңыз басқарады.
Dialogue: 0,0:16:56.80,0:16:59.81,Default,,0,0,0,,Жартылай мәңгілік өмір мүмкін емес
Dialogue: 0,0:17:00.18,0:17:03.56,Default,,0,0,0,,Құдайдың құқықтарын ақшаға да сатып алуға болады.
Dialogue: 0,0:17:05.27,0:17:09.52,Default,,0,0,0,,‎Бұл мүддеге қатысты қайшылықты елестету мүмкін емес.
Dialogue: 0,0:17:10.02,0:17:13.15,Default,,0,0,0,,‎Бұл ел күлден енді ғана қалпына келді...
Dialogue: 0,0:17:13.28,0:17:15.11,Default,,0,0,0,,Бұл әскери жағынан артта қалған ел.
Dialogue: 0,0:17:16.32,0:17:20.03,Default,,0,0,0,,‎Жеңілген ел тармағы дұрыс қаруды жасауға кедергі жасайды
Dialogue: 0,0:17:20.33,0:17:23.83,Default,,0,0,0,,Сондықтан мен Реджи деп аталатын адам қаруын қолдандым.
Dialogue: 0,0:17:25.04,0:17:28.83,Default,,0,0,0,,‎Редги - қажетті зұлымдық, канон - шектен тыс
Dialogue: 0,0:17:30.04,0:17:31.96,Default,,0,0,0,,Бұл сіздің қорытындыңыз ба?
Dialogue: 0,0:17:35.30,0:17:38.76,Default,,0,0,0,,‎Бізден құтылсаң, дау-дамай болмайды.
Dialogue: 0,0:17:39.05,0:17:42.10,Default,,0,0,0,,‎Ел қорғау... этика
Dialogue: 0,0:17:42.68,0:17:44.31,Default,,0,0,0,,Сонымен, шабуыл?
Dialogue: 0,0:17:45.27,0:17:46.44,Default,,0,0,0,,Сіз...
Dialogue: 0,0:17:46.56,0:17:49.65,Default,,0,0,0,,Мен сен қорғау керек нәрсені қорғауға тырыстым.
Dialogue: 0,0:17:49.98,0:17:50.81,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:54.07,0:17:58.45,Default,,0,0,0,,Біз оның да өмір екенін түсінбедік...
Dialogue: 0,0:18:02.53,0:18:06.50,Default,,0,0,0,,Әділдік бір жағынан көрінеді. Бұл рас болуы мүмкін.
Dialogue: 0,0:18:07.16,0:18:11.25,Default,,0,0,0,,Мәртебелі, сіздің істегеніңіз кісі өлтіруден басқа ештеңе емес.
Dialogue: 0,0:18:15.96,0:18:19.59,Default,,0,0,0,,‎«Сезімтал жандар реинкарнацияланады және алты әлемде туады»
Dialogue: 0,0:18:19.72,0:18:23.39,Default,,0,0,0,,«Бұл ешқашан бітпейтін дөңгелек сияқты»
Dialogue: 0,0:18:24.77,0:18:28.39,Default,,0,0,0,,Бұл енді сіздің күнәларыңызды өтеу үшін ештеңе жасамайды.
Dialogue: 0,0:18:28.52,0:18:30.85,Default,,0,0,0,,Маған да ынтымақтасуға рұқсат етіңіз.
Dialogue: 0,0:18:30.98,0:18:32.65,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:18:33.57,0:18:38.24,Default,,0,0,0,,‎Осыдан кейін мен саған өмірімді тағы бір рет тапсырамын.
Dialogue: 0,0:18:42.87,0:18:44.08,Default,,0,0,0,,‎Кит қайда?
Dialogue: 0,0:18:44.20,0:18:46.54,Default,,0,0,0,,‎Патша сарайының ішінде ше?
Dialogue: 0,0:18:46.66,0:18:48.91,Default,,0,0,0,,Төтенше жағдайда
Dialogue: 0,0:18:49.04,0:18:51.29,Default,,0,0,0,,‎Мен өзімнің козир картамды қолымда ұстаймын деп ойлаймын.
Dialogue: 0,0:18:51.63,0:18:55.25,Default,,0,0,0,,‎(Куроба) Мен алдын ала зерттедім, бірақ оның белгісі жоқ.
Dialogue: 0,0:18:55.38,0:18:56.26,Default,,0,0,0,,A...
Dialogue: 0,0:18:58.47,0:19:00.80,Default,,0,0,0,,‎Қолымызда болмаса да
Dialogue: 0,0:19:00.93,0:19:03.47,Default,,0,0,0,,‎Оны алып кетпейтініне сенімді болатын жер
Dialogue: 0,0:19:04.39,0:19:06.06,Default,,0,0,0,,Олардың өз аумағы бар.
Dialogue: 0,0:19:06.64,0:19:07.72,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:19:09.27,0:19:10.81,Default,,0,0,0,,‎Амо аймағы туралы не деуге болады?
Dialogue: 0,0:19:10.94,0:19:12.02,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:19:13.40,0:19:15.61,Default,,0,0,0,,‎(Патша) Бұл әскерилер басқаратын аймақ.
Dialogue: 0,0:19:16.07,0:19:21.45,Default,,0,0,0,,‎Ол әскери жаттығулар үшін пайдаланылғандықтан, бейбіт тұрғындардың кіруіне тыйым салынады.
Dialogue: 0,0:19:21.57,0:19:25.08,Default,,0,0,0,,‎Бұл айналада ешкім жоқ табиғи түрме сияқты.
Dialogue: 0,0:19:25.33,0:19:26.54,Default,,0,0,0,,Бұл жақсы жол болуы мүмкін.
Dialogue: 0,0:19:26.87,0:19:29.66,Default,,0,0,0,,‎Сендер Кирисамені түсінбейсіңдер.
Dialogue: 0,0:19:29.83,0:19:30.75,Default,,0,0,0,,‎Бұл нені білдіреді?
Dialogue: 0,0:19:31.96,0:19:36.42,Default,,0,0,0,,‎Ол рационалды романтикалық қос стандарт
Dialogue: 0,0:19:37.09,0:19:39.09,Default,,0,0,0,,‎Егер сіз бұл туралы дұрыс ойласаңыз, олай емес.
Dialogue: 0,0:19:39.97,0:19:42.76,Default,,0,0,0,,‎Қандай керемет тұспал.
Dialogue: 0,0:19:43.34,0:19:44.64,Default,,0,0,0,,‎Қазір~
Dialogue: 0,0:19:44.76,0:19:47.85,Default,,0,0,0,,‎Неге менің айналам осылай?
Dialogue: 0,0:19:48.52,0:19:51.02,Default,,0,0,0,,‎Юна-чан, сен жалғыз үміт нұрысың...
Dialogue: 0,0:19:51.14,0:19:52.06,Default,,0,0,0,,Лили-сан
Dialogue: 0,0:19:53.27,0:19:56.36,Default,,0,0,0,,Кирисаме Куробаға қастандық жасауды қалады.
Dialogue: 0,0:19:56.77,0:19:57.61,Default,,0,0,0,,A...
Dialogue: 0,0:19:59.36,0:20:03.03,Default,,0,0,0,,Түсінемін, бұл қамау туралы ғана емес.
Dialogue: 0,0:20:03.24,0:20:05.78,Default,,0,0,0,,‎Куроба-кунның қатысуында мағына бар.
Dialogue: 0,0:20:06.66,0:20:08.99,Default,,0,0,0,,‎Ол біздің патшамыз
Dialogue: 0,0:20:09.24,0:20:12.66,Default,,0,0,0,,Кирисаме басқалардан гөрі Джет Блэкке сенетін.
Dialogue: 0,0:20:17.50,0:20:19.17,Default,,0,0,0,,Қандай көне қирандылар әлі де бар?
Dialogue: 0,0:20:20.21,0:20:21.80,Default,,0,0,0,,‎Бұлар өте аз.
Dialogue: 0,0:20:21.92,0:20:24.89,Default,,0,0,0,,‎Әрқайсысын оң жаққа соғуға уақыт жоқ, егер сіз оны тарылтпасаңыз.
Dialogue: 0,0:20:25.55,0:20:26.64,Default,,0,0,0,,‎Егер
Dialogue: 0,0:20:26.76,0:20:30.64,Default,,0,0,0,,Қара қауырсындардың патшасымен ең жақын жері осы емес пе?
Dialogue: 0,0:20:31.02,0:20:32.27,Default,,0,0,0,,‎Қазан...
Dialogue: 0,0:20:32.56,0:20:35.40,Default,,0,0,0,,‎"Дәл қазір мен ерекше жерде демалып жатырмын."
Dialogue: 0,0:20:35.73,0:20:38.77,Default,,0,0,0,,‎«Жақсы жері теңізге жақын»
Dialogue: 0,0:20:39.07,0:20:41.65,Default,,0,0,0,,‎«Егер оның қанаттары болса, ең жақсы жер болар еді»
Dialogue: 0,0:20:41.78,0:20:42.90,Default,,0,0,0,,‎Бұл не?
Dialogue: 0,0:20:44.07,0:20:45.41,Default,,0,0,0,,‎(Куроба) Ол солай деді.
Dialogue: 0,0:20:45.95,0:20:46.78,Default,,0,0,0,,‎(Патша) Ах...
Dialogue: 0,0:20:48.28,0:20:52.91,Default,,0,0,0,,‎Джит Блэктің солтүстігін, оңтүстігін, шығысын және батысын қорғау үшін салынған төрт мұнара
Dialogue: 0,0:20:53.79,0:20:57.50,Default,,0,0,0,,‎Мен бұл қара қауырсындардың патшасына қатысты қасиетті жер деп естідім.
Dialogue: 0,0:20:58.38,0:21:00.05,Default,,0,0,0,,Бұл жерде ше?
Dialogue: 0,0:21:02.71,0:21:03.63,Default,,0,0,0,,А...
Dialogue: 0,0:21:20.82,0:21:22.07,Default,,0,0,0,,‎(Кит) Уф...
Dialogue: 0,0:21:31.74,0:21:32.87,Default,,0,0,0,,Ух...
Dialogue: 0,0:21:36.25,0:21:42.25,Default,,0,0,0,,‎♪~
Dialogue: 0,0:23:20.31,0:23:26.32,Default,,0,0,0,,‎~♪
Dialogue: 0,0:23:27.82,0:23:33.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory