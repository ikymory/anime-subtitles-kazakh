Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.96,0:00:04.33,Default,,0,0,0,,Дамокл Құлау жылдамдығы артады
Dialogue: 0,0:00:04.42,0:00:05.33,Default,,0,0,0,,Хаа… Хаа… Хаа…
Dialogue: 0,0:00:05.42,0:00:08.50,Default,,0,0,0,,Эбетсу қаласында орналасқан бөлімшелер қатысады.
Dialogue: 0,0:00:08.59,0:00:09.75,Default,,0,0,0,,Қалған қалқыма
Dialogue: 0,0:00:09.84,0:00:11.55,Default,,0,0,0,,Бэк есіктен басқарып көріңіз
Dialogue: 0,0:00:12.42,0:00:13.30,Default,,0,0,0,,қою
Dialogue: 0,0:00:13.38,0:00:16.47,Default,,0,0,0,,Ах... барған сайын көбірек энергия бөлініп жатыр.
Dialogue: 0,0:00:16.55,0:00:18.43,Default,,0,0,0,,Құлау сөзсіз
Dialogue: 0,0:00:18.51,0:00:20.35,Default,,0,0,0,,Уақытты сатып алуға бола ма?
Dialogue: 0,0:00:20.43,0:00:22.39,Default,,0,0,0,,Егер сіз энергия ағынын реттей алсаңыз
Dialogue: 0,0:00:22.48,0:00:23.64,Default,,0,0,0,,Біраз...
Dialogue: 0,0:00:23.73,0:00:24.56,Default,,0,0,0,,Жасаңыз.
Dialogue: 0,0:00:24.64,0:00:25.60,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:00:25.69,0:00:29.69,Default,,0,0,0,,Зақым аз болған жерде құлау нүктесін басқарғым келеді.
Dialogue: 0,0:00:29.77,0:00:30.61,Default,,0,0,0,,«Лайт» жарайды.
Dialogue: 0,0:00:30.69,0:00:31.99,Default,,0,0,0,,Мен сені жақсы көремін.
Dialogue: 0,0:00:32.07,0:00:34.53,Default,,0,0,0,,Синджо мырза, деректеріңізді бөлісіңіз.
Dialogue: 0,0:00:37.53,0:00:39.37,Default,,0,0,0,,Уф... Иә?
Dialogue: 0,0:00:39.45,0:00:41.41,Default,,0,0,0,,Оларды эвакуациялауға көмектесу
Dialogue: 0,0:00:41.49,0:00:42.62,Default,,0,0,0,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:00:43.37,0:00:45.83,Default,,0,0,0,,Харуканың командасы Ортегердің артынан жүруі керек.
Dialogue: 0,0:00:45.92,0:00:46.88,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:00:46.96,0:00:47.92,Default,,0,0,0,,Курото мырза
Dialogue: 0,0:00:48.00,0:00:50.67,Default,,0,0,0,,Окахоро саябағында Дамоклдың құлау нүктесі туралы не айтасыз?
Dialogue: 0,0:00:50.75,0:00:52.46,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:52.55,0:00:54.76,Default,,0,0,0,,Monobe Monobe Iwamoto Iwamoto жасағы 3 сағат бағытында.
Dialogue: 0,0:00:54.84,0:00:57.26,Default,,0,0,0,,Ода Мунемори Мунемори командасы сағат 8-ге қарай жылжиды
Dialogue: 0,0:00:57.34,0:00:58.64,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:00:58.72,0:01:00.72,Default,,0,0,0,,Сен не ойлайсың, Цуки?
Dialogue: 0,0:01:00.81,0:01:02.02,Default,,0,0,0,,Барлығы асығыңыздар
Dialogue: 0,0:01:07.48,0:01:10.32,Default,,0,0,0,,Барлық бөлімшелер қауіпсіз аймаққа көшірілді.
Dialogue: 0,0:01:10.40,0:01:12.03,Default,,0,0,0,,Қалқымалы реакция жоғалды
Dialogue: 0,0:01:12.11,0:01:13.61,Default,,0,0,0,,Дамокл құлауы
Dialogue: 0,0:01:13.69,0:01:16.95,Default,,0,0,0,,Қонуға күтілетін құлау нүктесінен ертерек кіріңіз.
Dialogue: 0,0:01:32.84,0:01:34.51,Default,,0,0,0,,Фу…
Dialogue: 0,0:01:35.92,0:01:37.76,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:01:38.26,0:01:39.55,Default,,0,0,0,,Кишибе Рохан секілді күші бар біреу!
Dialogue: 0,0:01:42.01,0:01:47.02,Default,,0,0,0,,♪～
Dialogue: 0,0:03:07.85,0:03:11.90,Default,,0,0,0,,～♪
Dialogue: 0,0:03:13.90,0:03:14.90,Default,,0,0,0,,Мемлекеттік кеңседен
Dialogue: 0,0:03:14.98,0:03:15.94,Default,,0,0,0,,Хабарландыру болды——
Dialogue: 0,0:03:16.02,0:03:16.98,Default,,0,0,0,,Дамокл бойынша
Dialogue: 0,0:03:17.07,0:03:19.15,Default,,0,0,0,,Саппороны жою миссиясы...
Dialogue: 0,0:03:20.86,0:03:23.57,Default,,0,0,0,,Дамокл және Дивок баласы
Dialogue: 0,0:03:23.66,0:03:27.20,Default,,0,0,0,,Нәтижелер баға бойынша жақсы болмады.
Dialogue: 0,0:03:27.29,0:03:29.20,Default,,0,0,0,,Жоқ, жеткілікті.
Dialogue: 0,0:03:29.29,0:03:30.75,Default,,0,0,0,,Сіз тұруға болады.
Dialogue: 0,0:03:30.83,0:03:32.25,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:36.21,0:03:39.01,Default,,0,0,0,,Сонымен... әрі қарай не болады?
Dialogue: 0,0:03:39.09,0:03:41.13,Default,,0,0,0,,Ол бір нәрсе туралы ойлап отырған болуы керек.
Dialogue: 0,0:03:42.26,0:03:44.39,Default,,0,0,0,,Сіз оны пайдалана аласыз деп ойлайсыз ба?
Dialogue: 0,0:03:44.47,0:03:45.85,Default,,0,0,0,,Саппоро геттосында
Dialogue: 0,0:03:45.93,0:03:48.51,Default,,0,0,0,,Он бірлерді қашып құтылмақ болған солдат.
Dialogue: 0,0:03:48.60,0:03:50.73,Default,,0,0,0,,Біраз адамдарды ұстады
Dialogue: 0,0:03:51.35,0:03:53.69,Default,,0,0,0,,Абашири сияқты белгілер.
Dialogue: 0,0:03:53.77,0:03:56.15,Default,,0,0,0,,Есімде жоқ деп айқайлап жатырмын.
Dialogue: 0,0:03:57.40,0:03:59.61,Default,,0,0,0,,Оларды миллиметрмен іздеу керек пе...
Dialogue: 0,0:04:03.11,0:04:04.41,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:04:04.49,0:04:07.28,Default,,0,0,0,,Аман-есен оралғанымызға қуаныштымыз.
Dialogue: 0,0:04:07.37,0:04:08.83,Default,,0,0,0,,Шынымен де рас
Dialogue: 0,0:04:08.91,0:04:11.91,Default,,0,0,0,,Зақым нөлге тең болмаса да
Dialogue: 0,0:04:12.00,0:04:15.21,Default,,0,0,0,,Бірақ олардың бәрі жойылып кетсе, бұл таң қалмас еді.
Dialogue: 0,0:04:15.29,0:04:16.67,Default,,0,0,0,,Бұл ғажайып, солай емес пе?
Dialogue: 0,0:04:16.75,0:04:19.50,Default,,0,0,0,,Нанашидің жалдамалы Йохеи ағаларына рахмет... мүмкін бе?
Dialogue: 0,0:04:20.09,0:04:21.46,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:21.55,0:04:24.84,Default,,0,0,0,,Қоқыстарды түсіру немесе қалтқыларды жылжыту
Dialogue: 0,0:04:24.93,0:04:27.26,Default,,0,0,0,,Айтпақшы, бұл екеуі ше?
Dialogue: 0,0:04:27.35,0:04:30.43,Default,,0,0,0,,Доктор Эйнштейнді Курото мырзамен шығарып салу
Dialogue: 0,0:04:30.52,0:04:32.06,Default,,0,0,0,,Дәл солай, мен бірнеше күн демалыс аламын.
Dialogue: 0,0:04:32.14,0:04:34.60,Default,,0,0,0,,Бұл не? Бұл ауыр!
Dialogue: 0,0:04:34.69,0:04:37.27,Default,,0,0,0,,Олар бізбен келісімшарт бойынша жалдамалылар.
Dialogue: 0,0:04:37.36,0:04:39.52,Default,,0,0,0,,Мен осында жұмыс істеп жүрсем де.
Dialogue: 0,0:04:39.61,0:04:41.44,Default,,0,0,0,,Сіз жұмыс істемейсіз, солай ма?
Dialogue: 0,0:04:41.53,0:04:42.65,Default,,0,0,0,,Жұмысыңызды дұрыс орындаңыз
Dialogue: 0,0:04:42.74,0:04:44.95,Default,,0,0,0,,Мен жұмыс істеймін!
Dialogue: 0,0:04:45.95,0:04:47.49,Default,,0,0,0,,Сен сияқты жігіт тазаруға тиіс.
Dialogue: 0,0:04:47.57,0:04:49.03,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:04:49.12,0:04:52.87,Default,,0,0,0,,Freya Eliminator біздің өмірімізді сақтап қалды.
Dialogue: 0,0:04:52.95,0:04:54.21,Default,,0,0,0,,Мен ризамын.
Dialogue: 0,0:04:54.29,0:04:56.42,Default,,0,0,0,,Бұл менің жолым
Dialogue: 0,0:04:56.50,0:04:58.21,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:04:58.29,0:05:01.34,Default,,0,0,0,,Біз Фрейяны әлемнен жоя алдық.
Dialogue: 0,0:05:05.09,0:05:07.39,Default,,0,0,0,,Сақай Сақайға да рахмет
Dialogue: 0,0:05:07.47,0:05:10.22,Default,,0,0,0,,Жоқ, сенімен бірге болу құрмет болды.
Dialogue: 0,0:05:11.14,0:05:15.27,Default,,0,0,0,,Мен мұнда қара рыцарлармен байланысшы ретінде қала беремін.
Dialogue: 0,0:05:16.39,0:05:17.52,Default,,0,0,0,,Сонымен
Dialogue: 0,0:05:23.53,0:05:26.65,Default,,0,0,0,,Әр адамның тілегі орындалсын деп дұға етемін.
Dialogue: 0,0:05:26.74,0:05:29.53,Default,,0,0,0,,Мен де аз болса да көмектесемін.
Dialogue: 0,0:05:29.62,0:05:32.24,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:05:38.88,0:05:40.21,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:05:40.29,0:05:43.84,Default,,0,0,0,,Операция сәтсіз болған сияқты.
Dialogue: 0,0:05:43.92,0:05:49.01,Default,,0,0,0,,Ди соншалықты амбициялы болғаны үшін сіздің бос сөзіңіз сізді өлтірді ме?
Dialogue: 0,0:05:49.09,0:05:50.30,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:50.93,0:05:54.14,Default,,0,0,0,,Осымен есеп аяқталды.
Dialogue: 0,0:05:54.22,0:05:55.60,Default,,0,0,0,,Сонымен
Dialogue: 0,0:05:57.60,0:05:59.02,Default,,0,0,0,,Ум...
Dialogue: 0,0:05:59.10,0:06:00.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:00.23,0:06:02.77,Default,,0,0,0,,Әскерде қаза тапқандар кімдер?
Dialogue: 0,0:06:02.86,0:06:07.78,Default,,0,0,0,,Жарайды, шайқас болды, сондықтан біраз шығын болады.
Dialogue: 0,0:06:07.86,0:06:09.41,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:10.03,0:06:12.78,Default,,0,0,0,,Қайтыс болғандарға көңіл айту
Dialogue: 0,0:06:13.37,0:06:16.79,Default,,0,0,0,,Және зардап шеккен жапондықтарға көмектесу.
Dialogue: 0,0:06:16.87,0:06:18.54,Default,,0,0,0,,Мен сұрау жасай аламын ба?
Dialogue: 0,0:06:18.62,0:06:20.38,Default,,0,0,0,,Оны тоқтатыңыз.
Dialogue: 0,0:06:20.46,0:06:22.46,Default,,0,0,0,,Сіз әшекейлердің императорысыз.
Dialogue: 0,0:06:22.54,0:06:24.55,Default,,0,0,0,,Кедергі жасамаңыз
Dialogue: 0,0:06:24.63,0:06:26.92,Default,,0,0,0,,Менің жұмысым артады, солай ма?
Dialogue: 0,0:06:27.63,0:06:29.80,Default,,0,0,0,,Тоқтау деген нені білдіреді?
Dialogue: 0,0:06:29.88,0:06:32.14,Default,,0,0,0,,Бұл мұны істеу мүмкін емес дегенді білдірмейді.
Dialogue: 0,0:06:32.22,0:06:33.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:34.14,0:06:37.56,Default,,0,0,0,,Менің күшім жоқ шығар, бірақ
Dialogue: 0,0:06:37.64,0:06:39.69,Default,,0,0,0,,Қолымнан келгенін істегім келеді.
Dialogue: 0,0:06:39.77,0:06:42.98,Default,,0,0,0,,Сондықтан мұндай нәрселерді күшті адамдар ойлайды...
Dialogue: 0,0:06:43.06,0:06:45.36,Default,,0,0,0,,Мен күшті болғым келеді
Dialogue: 0,0:06:47.19,0:06:49.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:49.20,0:06:51.61,Default,,0,0,0,,Не!
Dialogue: 0,0:06:51.70,0:06:53.66,Default,,0,0,0,,Бұл жай әшекей болса да!
Dialogue: 0,0:06:55.33,0:06:56.49,Default,,0,0,0,,Уолтер
Dialogue: 0,0:06:57.12,0:06:58.96,Default,,0,0,0,,Императордың тұмары Сіздің атыңыздан!
Dialogue: 0,0:06:59.04,0:07:01.08,Default,,0,0,0,,Бүгіннен ертеңге дейін (Уолтер) Иә?
Dialogue: 0,0:07:01.17,0:07:02.92,Default,,0,0,0,,Өйткені мен күштімін
Dialogue: 0,0:07:03.00,0:07:04.67,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:07:04.75,0:07:06.09,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:07:06.67,0:07:08.67,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:07:10.97,0:07:13.80,Default,,0,0,0,,Бүгін Джуго Джугоның қайтыс болған күні.
Dialogue: 0,0:07:15.85,0:07:19.18,Default,,0,0,0,,Мен сені көруге келмесем болды ма?
Dialogue: 0,0:07:19.98,0:07:23.69,Default,,0,0,0,,Бұл шайқаста көптеген құрбандар болды.
Dialogue: 0,0:07:23.77,0:07:26.77,Default,,0,0,0,,Осындай уақытта мен ата-анамның бейітіне баруды елестете алмаймын.
Dialogue: 0,0:07:26.86,0:07:28.48,Default,,0,0,0,,Бұл тым өзімшілдік болар еді.
Dialogue: 0,0:07:29.07,0:07:30.74,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:07:32.57,0:07:34.49,Default,,0,0,0,,Оған тәнті болды, солай емес пе?
Dialogue: 0,0:07:35.20,0:07:37.95,Default,,0,0,0,,Лорд Джуго қайырымды адам болған.
Dialogue: 0,0:07:38.62,0:07:41.96,Default,,0,0,0,,Жапондықтар мен британдықтар бірдей.
Dialogue: 0,0:07:42.04,0:07:45.13,Default,,0,0,0,,Жан-жағымнан күлкі кетпейтін.
Dialogue: 0,0:07:45.21,0:07:47.38,Default,,0,0,0,,Шерриге де солай.
Dialogue: 0,0:07:47.46,0:07:50.67,Default,,0,0,0,,Екеуің өте жарасымды жұп болдыңдар.
Dialogue: 0,0:07:50.76,0:07:51.67,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:51.76,0:07:54.72,Default,,0,0,0,,Шерри жас кезінде ауырып қалды.
Dialogue: 0,0:07:54.80,0:07:57.93,Default,,0,0,0,,Лорд Джуго мұны өлім жазасына кесу деп атады.
Dialogue: 0,0:07:58.01,0:08:01.43,Default,,0,0,0,,Оны необританиялық сарбаздар өлтірді...
Dialogue: 0,0:08:04.19,0:08:08.82,Default,,0,0,0,,Мен Сумераги Сумераги Джугоны өлтірдім...
Dialogue: 0,0:08:11.32,0:08:12.65,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:08:13.49,0:08:14.82,Default,,0,0,0,,Өлтірілді
Dialogue: 0,0:08:16.74,0:08:18.66,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:08:21.75,0:08:23.50,Default,,0,0,0,,Бұл шайқас аяқталғанда
Dialogue: 0,0:08:23.58,0:08:27.50,Default,,0,0,0,,Олардың бейіттерін сол жерге көшіргім келеді.
Dialogue: 0,0:08:27.59,0:08:28.88,Default,,0,0,0,,(Шира) Ой! (Сора) Бұл не?
Dialogue: 0,0:08:28.96,0:08:31.38,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:08:33.30,0:08:34.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:36.59,0:08:37.89,Default,,0,0,0,,Доктор Эйнштейн
Dialogue: 0,0:08:37.97,0:08:40.89,Default,,0,0,0,,Штабқа аман-есен жеткен сияқтысыз.
Dialogue: 0,0:08:40.97,0:08:42.31,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:08:42.81,0:08:45.35,Default,,0,0,0,,Прапорщик Сақай Сакуя-саманың...
Dialogue: 0,0:08:45.44,0:08:47.65,Default,,0,0,0,,Сіз Роуздың шынайы тұлғасын білмейсіз бе?
Dialogue: 0,0:08:48.36,0:08:50.73,Default,,0,0,0,,О, мен саған айтқан жоқпын.
Dialogue: 0,0:08:51.32,0:08:53.95,Default,,0,0,0,,Ол салмақты, шыншыл жігіт.
Dialogue: 0,0:08:54.03,0:08:58.78,Default,,0,0,0,,Мен сол құпияны арқалап жүріп, әдеттегідей тапсырмамды орындай алмаймын.
Dialogue: 0,0:09:00.24,0:09:02.50,Default,,0,0,0,,Өте біртұтас ұлт – Жаңа Британия.
Dialogue: 0,0:09:02.58,0:09:05.33,Default,,0,0,0,,Дамокл мен Фрейяның жоғалуымен
Dialogue: 0,0:09:05.41,0:09:09.25,Default,,0,0,0,,Бейбітшілік келіссөздерінің тағы бір тобын жіберу жоспарлануда.
Dialogue: 0,0:09:09.88,0:09:12.96,Default,,0,0,0,,Біз үшін жағдай қай жаққа бұрылса да,
Dialogue: 0,0:09:13.05,0:09:17.13,Default,,0,0,0,,Бірден жауап беруге дайын болыңыз.
Dialogue: 0,0:09:17.76,0:09:21.64,Default,,0,0,0,,Хоккайдо жағымен бұрынғыдан да тығыз байланыста болыңыз.
Dialogue: 0,0:09:21.72,0:09:23.43,Default,,0,0,0,,Сақай сол үшін.
Dialogue: 0,0:09:23.52,0:09:25.39,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:25.48,0:09:27.40,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:09:29.36,0:09:31.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:31.98,0:09:35.86,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:35.95,0:09:38.74,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:09:40.53,0:09:43.79,Default,,0,0,0,,Ах, төлеу уақыты келді. Сәл күте тұрыңыз.
Dialogue: 0,0:09:43.87,0:09:45.12,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:09:45.20,0:09:46.66,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:09:46.75,0:09:48.92,Default,,0,0,0,,№1 мырзаға май сэндвичі
Dialogue: 0,0:09:49.00,0:09:50.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:53.38,0:09:55.21,Default,,0,0,0,,Ол өркендеп жатыр.
Dialogue: 0,0:09:55.30,0:09:57.05,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:09:57.93,0:09:59.47,Default,,0,0,0,,...
Dialogue: 0,0:10:00.47,0:10:02.35,Default,,0,0,0,,Ах, Мэй Чан, маған су беріңізші.
Dialogue: 0,0:10:02.43,0:10:03.60,Default,,0,0,0,,Сондай-ақ, сүлгілер
Dialogue: 0,0:10:03.68,0:10:04.64,Default,,0,0,0,,Иә
Dialogue: 0,0:10:04.72,0:10:06.52,Default,,0,0,0,,Ах, шотыңызды төлеңіз.
Dialogue: 0,0:10:06.60,0:10:07.89,Default,,0,0,0,,Иә, мен үйдемін.
Dialogue: 0,0:10:07.98,0:10:10.31,Default,,0,0,0,,Мамыр, жарайды, мен істеймін.
Dialogue: 0,0:10:10.40,0:10:12.27,Default,,0,0,0,,Кешіріңіз, ұстаз.
Dialogue: 0,0:10:12.86,0:10:14.73,Default,,0,0,0,,Қайта келіңіз
Dialogue: 0,0:10:15.36,0:10:17.78,Default,,0,0,0,,Ондай жағдайда... мен сізге көмектесе аламын ба?
Dialogue: 0,0:10:17.86,0:10:21.28,Default,,0,0,0,,Жарайды, бұл сенің жұмысың.
Dialogue: 0,0:10:21.37,0:10:23.24,Default,,0,0,0,,Ол әрқашан бола бермейді.
Dialogue: 0,0:10:23.33,0:10:25.12,Default,,0,0,0,,Бұл жай ғана сатып алу болса, жақсы.
Dialogue: 0,0:10:25.20,0:10:27.08,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:10:29.00,0:10:30.92,Default,,0,0,0,,Неге бұлай киініп жүрсің?
Dialogue: 0,0:10:31.00,0:10:33.67,Default,,0,0,0,,Бұл сізге шынымен сәйкес келеді.
Dialogue: 0,0:10:34.59,0:10:35.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:35.50,0:10:36.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:37.01,0:10:38.67,Default,,0,0,0,,Күл?
Dialogue: 0,0:10:39.30,0:10:40.55,Default,,0,0,0,,Бір минут, Ұсуке.
Dialogue: 0,0:10:40.64,0:10:43.01,Default,,0,0,0,,Қандай нашар уақыт?
Dialogue: 0,0:10:43.10,0:10:44.89,Default,,0,0,0,,Әзірше, осыдан өтейік...
Dialogue: 0,0:10:44.97,0:10:46.35,Default,,0,0,0,,Қандай кездейсоқтық! Эй!
Dialogue: 0,0:10:47.60,0:10:49.39,Default,,0,0,0,,Сіз де таңқурай сатып алып жүрсіз бе?
Dialogue: 0,0:10:49.48,0:10:50.56,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:50.65,0:10:52.27,Default,,0,0,0,,О, жоқ... иә
Dialogue: 0,0:10:55.73,0:10:59.45,Default,,0,0,0,,Ум...Аш-сан, сен сол жаққа барасың ба?
Dialogue: 0,0:10:59.53,0:11:01.53,Default,,0,0,0,,Сондай-ақ Мэй-сан мәселесі де бар.
Dialogue: 0,0:11:01.61,0:11:03.49,Default,,0,0,0,,Өтінемін, мен үшін алаңдамаңыз.
Dialogue: 0,0:11:03.57,0:11:04.83,Default,,0,0,0,,Егер сіз
Dialogue: 0,0:11:03.57,0:11:05.83,Default,,0,0,0,,Бұл жерде мен өзімді әбігерге салғандай сезінсем де.
Dialogue: 0,0:11:04.91,0:11:06.66,Default,,0,0,0,,Бірдеңе болып қалса, біз қиындыққа тап боламыз.
Dialogue: 0,0:11:05.91,0:11:09.21,Default,,0,0,0,,Бұл адам өз пайдасына тура келеді, солай емес пе?
Dialogue: 0,0:11:06.74,0:11:08.50,Default,,0,0,0,,Мен осында болғанша, сен аман бол.
Dialogue: 0,0:11:10.08,0:11:12.88,Default,,0,0,0,,Қазір ойлап қарасам, соңғы кездері дүкенге бармаған сияқтысың.
Dialogue: 0,0:11:12.96,0:11:15.04,Default,,0,0,0,,Өзіңізді физикалық нашар сезінесіз бе?
Dialogue: 0,0:11:15.13,0:11:16.80,Default,,0,0,0,,Мен бұрынғыдаймын
Dialogue: 0,0:11:16.88,0:11:18.76,Default,,0,0,0,,Сіз алатын жалғыз нәрсе - күшті.
Dialogue: 0,0:11:18.84,0:11:20.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:20.13,0:11:21.97,Default,,0,0,0,,Келесі жолы құнарлы нәрсе әкелейік.
Dialogue: 0,0:11:22.05,0:11:23.59,Default,,0,0,0,,Сіз жақсы емес нәрсе бар ма?
Dialogue: 0,0:11:23.68,0:11:25.97,Default,,0,0,0,,Жеуге болмайтын тағамдар, аллергия және т.б.
Dialogue: 0,0:11:26.06,0:11:29.85,Default,,0,0,0,,Негізі менің қасапшым тунец дәмі бар қытырлақ тағамды ғана жейді.
Dialogue: 0,0:11:27.89,0:11:29.85,Default,,0,0,0,,(Барлығы) Ах… (Алтыншы Төменгі Ай) Ол қозғалды!
Dialogue: 0,0:11:29.93,0:11:31.52,Default,,0,0,0,,Сондай-ақ, бұл жақында болған нәрсе...
Dialogue: 0,0:11:31.60,0:11:32.73,Default,,0,0,0,,Ах
Dialogue: 0,0:11:33.90,0:11:35.19,Default,,0,0,0,,Эш мырза?
Dialogue: 0,0:11:36.65,0:11:37.94,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:11:38.53,0:11:40.70,Default,,0,0,0,,Эйнбергтік Нала Вон?
Dialogue: 0,0:11:41.32,0:11:43.95,Default,,0,0,0,,Кешіріңіз, менің есіме шұғыл бір нәрсе түсті.
Dialogue: 0,0:11:44.03,0:11:45.62,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:11:45.70,0:11:47.70,Default,,0,0,0,,Таңқурай мырза, абай болыңыз.
Dialogue: 0,0:11:47.79,0:11:48.79,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:50.25,0:11:51.41,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:11:51.50,0:11:54.54,Default,,0,0,0,,Өйткені сіз әрқашан біздің дүкенге келесіз.
Dialogue: 0,0:11:54.63,0:11:56.25,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:56.75,0:11:58.55,Default,,0,0,0,,Қайта келіңіз.
Dialogue: 0,0:11:58.63,0:12:00.05,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:00.13,0:12:01.80,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:12:03.05,0:12:04.18,Default,,0,0,0,,Жақында кездескенше!
Dialogue: 0,0:12:05.05,0:12:07.30,Default,,0,0,0,,Менің баратын жерім бар
Dialogue: 0,0:12:07.39,0:12:08.85,Default,,0,0,0,,Балалар сендер бірінші барыңдар.
Dialogue: 0,0:12:08.93,0:12:10.22,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:12:25.91,0:12:27.78,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:27.87,0:12:30.91,Default,,0,0,0,,Соңғы рет осылай сөйлескенімізге біраз болды.
Dialogue: 0,0:12:31.00,0:12:32.16,Default,,0,0,0,,Күл
Dialogue: 0,0:12:33.00,0:12:34.25,Default,,0,0,0,,О
Dialogue: 0,0:12:35.17,0:12:38.46,Default,,0,0,0,,Мен Ноландтан кеткеннен бері.
Dialogue: 0,0:12:38.54,0:12:40.30,Default,,0,0,0,,Бұл шамамен 2 жыл болады ма?
Dialogue: 0,0:12:40.80,0:12:43.47,Default,,0,0,0,,Біраз бұрын болған сияқты.
Dialogue: 0,0:12:45.51,0:12:48.72,Default,,0,0,0,,Осы екі адам түсінді ме?
Dialogue: 0,0:13:04.53,0:13:06.53,Default,,0,0,0,,Сэр Уолтер Линдстедт...
Dialogue: 0,0:13:07.11,0:13:09.99,Default,,0,0,0,,Бүгін мен ұлы мәртебелі императордың оққағары ретінде әрекет етемін.
Dialogue: 0,0:13:10.49,0:13:12.45,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:13:15.12,0:13:18.92,Default,,0,0,0,,Біраз уақыт өтті. Екі жыл болды ма?
Dialogue: 0,0:13:19.00,0:13:21.42,Default,,0,0,0,,Әдеттегідей сау көрінеді.
Dialogue: 0,0:13:26.18,0:13:29.05,Default,,0,0,0,,Линдстедт отбасы және Люксембург отбасы
Dialogue: 0,0:13:29.14,0:13:34.06,Default,,0,0,0,,Шерридің үйленуімен бір уақытта ол көмекші ретінде осы аймаққа көшті.
Dialogue: 0,0:13:35.85,0:13:38.73,Default,,0,0,0,,Сіз жапондарды арнайы палаталарда қорғайсыз.
Dialogue: 0,0:13:38.81,0:13:42.98,Default,,0,0,0,,Нео-Британдық сарбаз ретінде мен жапондарды өлтіремін.
Dialogue: 0,0:13:43.53,0:13:46.95,Default,,0,0,0,,Жол өтті, болды.
Dialogue: 0,0:13:53.33,0:13:54.45,Default,,0,0,0,,Мәртебелі Сакуя
Dialogue: 0,0:13:54.54,0:13:56.04,Default,,0,0,0,,Наталья
Dialogue: 0,0:13:56.12,0:13:57.67,Default,,0,0,0,,Бұл не өзі…?>
Dialogue: 0,0:13:57.75,0:14:00.96,Default,,0,0,0,,Иә, мен оны қатты сағындым...
Dialogue: 0,0:14:01.79,0:14:03.92,Default,,0,0,0,,Маған әртүрлі оқиғаларды айтып беріңізші.
Dialogue: 0,0:14:04.00,0:14:05.09,Default,,0,0,0,,Иә
Dialogue: 0,0:14:08.18,0:14:10.39,Default,,0,0,0,,Сіздің жақсы екеніңізді көріп, көңілім көтерілді.
Dialogue: 0,0:14:10.47,0:14:12.89,Default,,0,0,0,,Наталья өзгеріссіз қалады.
Dialogue: 0,0:14:12.97,0:14:14.52,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:14:14.60,0:14:17.73,Default,,0,0,0,,Жақында үйіме мысық келе бастады.
Dialogue: 0,0:14:17.81,0:14:18.81,Default,,0,0,0,,Мысық па?
Dialogue: 0,0:14:20.40,0:14:21.56,Default,,0,0,0,,Иә
Dialogue: 0,0:14:21.65,0:14:24.90,Default,,0,0,0,,Өте ұйқышыл және шулы мысық
Dialogue: 0,0:14:24.98,0:14:28.20,Default,,0,0,0,,Ол әдемі, жақсы тәрбие алған сияқты.
Dialogue: 0,0:14:28.28,0:14:30.49,Default,,0,0,0,,Келесі жолы кездескім келеді.
Dialogue: 0,0:14:30.57,0:14:31.45,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:14:32.45,0:14:33.66,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:14:33.74,0:14:38.50,Default,,0,0,0,,Мен сіздің аумақта енгізіп жатқан арнайы палата жүйесі туралы естідім.
Dialogue: 0,0:14:38.58,0:14:42.04,Default,,0,0,0,,Жапон халқын қорғағаныңыз үшін рахмет.
Dialogue: 0,0:14:42.13,0:14:44.96,Default,,0,0,0,,Қорқыныш өте көп...
Dialogue: 0,0:14:45.05,0:14:48.84,Default,,0,0,0,,Сол жүйені бір күні ел ішінде енгізуді ойлап жүрмін.
Dialogue: 0,0:14:48.92,0:14:51.64,Default,,0,0,0,,Менде дәл қазір ондай күш жоқ.
Dialogue: 0,0:14:51.72,0:14:54.72,Default,,0,0,0,,Бірақ мен қолымнан келгенін істеймін.
Dialogue: 0,0:14:55.22,0:14:58.56,Default,,0,0,0,,Бірте-бірте болса да өзгертуге күш салыңыз.
Dialogue: 0,0:14:58.64,0:15:01.77,Default,,0,0,0,,Біреудің тілегі мен қуанышына жетелейтін болса
Dialogue: 0,0:15:01.85,0:15:03.44,Default,,0,0,0,,Мен сенемін
Dialogue: 0,0:15:04.02,0:15:05.23,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:15:05.32,0:15:08.15,Default,,0,0,0,,Сол тілегіңізді орындаңыз.
Dialogue: 0,0:15:08.24,0:15:09.57,Default,,0,0,0,,Иә
Dialogue: 0,0:15:12.91,0:15:13.74,Default,,0,0,0,,Күл
Dialogue: 0,0:15:14.78,0:15:17.83,Default,,0,0,0,,Тірі болса, неге хабарласпадың?
Dialogue: 0,0:15:18.83,0:15:21.04,Default,,0,0,0,,Неліктен террористер...
Dialogue: 0,0:15:21.12,0:15:24.29,Default,,0,0,0,,Неге мұнда Ноландтың астында жүрсің?
Dialogue: 0,0:15:24.38,0:15:26.84,Default,,0,0,0,,Сіз мұны қазір сұрап тұрсыз ба?
Dialogue: 0,0:15:31.18,0:15:33.22,Default,,0,0,0,,Мен саған әскерге қайта бар деп айтпаймын.
Dialogue: 0,0:15:33.76,0:15:36.47,Default,,0,0,0,,Бірақ дұшпандық танытуды доғар.
Dialogue: 0,0:15:37.22,0:15:40.60,Default,,0,0,0,,Енді мен сені елден шығару үшін өз күшімді пайдалана аламын.
Dialogue: 0,0:15:40.68,0:15:42.52,Default,,0,0,0,,Сондай-ақ Британ Республикасына өтуге болады...
Dialogue: 0,0:15:42.60,0:15:43.44,Default,,0,0,0,,Бас тарт!
Dialogue: 0,0:15:43.52,0:15:44.44,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:15:44.52,0:15:45.77,Default,,0,0,0,,Ауқымнан тыс па?
Dialogue: 0,0:15:45.86,0:15:47.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:49.74,0:15:51.20,Default,,0,0,0,,Эй, сәл күте тұрыңыз!
Dialogue: 0,0:15:51.28,0:15:52.74,Default,,0,0,0,,Маған кілтті беріңіз
Dialogue: 0,0:15:52.82,0:15:55.37,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:15:56.08,0:15:57.87,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:16:01.71,0:16:03.17,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:16:03.25,0:16:06.42,Default,,0,0,0,,Ноландты кешіре алмайсың ба?
Dialogue: 0,0:16:06.50,0:16:08.13,Default,,0,0,0,,Әлде өзің бе?
Dialogue: 0,0:16:08.84,0:16:10.13,Default,,0,0,0,,Екеуі де.
Dialogue: 0,0:16:10.97,0:16:12.88,Default,,0,0,0,,Мен мұны бұрын да айтқанмын.
Dialogue: 0,0:16:12.97,0:16:16.39,Default,,0,0,0,,Император Джугоның өліміне сіз кінәлі емессіз.
Dialogue: 0,0:16:17.18,0:16:19.52,Default,,0,0,0,,Фактілерді өзіңіз бұрмаламаңыз.
Dialogue: 0,0:16:21.18,0:16:23.89,Default,,0,0,0,,Сіз император Джугоны өлтірген жоқсыз.
Dialogue: 0,0:16:23.98,0:16:26.15,Default,,0,0,0,,Ой... сен мені өлтірген жоқсың ба?
Dialogue: 0,0:16:26.73,0:16:28.77,Default,,0,0,0,,Күнәларыңызды өтеуге тырыссаңыз, бұл мағынасыз.
Dialogue: 0,0:16:28.86,0:16:31.57,Default,,0,0,0,,Жоқ, бұл ант.
Dialogue: 0,0:16:31.65,0:16:32.65,Default,,0,0,0,,Ант?
Dialogue: 0,0:16:37.83,0:16:41.00,Default,,0,0,0,,Ноландтың қол астында болмасаңыз да
Dialogue: 0,0:16:41.08,0:16:43.08,Default,,0,0,0,,Басқа жол болуы керек
Dialogue: 0,0:16:43.16,0:16:44.00,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:44.08,0:16:46.58,Default,,0,0,0,,Мен бұл ең жақсы нұсқа деп шештім.
Dialogue: 0,0:16:46.67,0:16:47.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:47.88,0:16:49.96,Default,,0,0,0,,Мұны сіз де білетін шығарсыз.
Dialogue: 0,0:16:50.05,0:16:52.26,Default,,0,0,0,,Британ империясы ыдырағаннан кейін
Dialogue: 0,0:16:52.34,0:16:55.51,Default,,0,0,0,,Бейбіт болып көрінетін бұл дүниенің көлеңкесінде не болды?
Dialogue: 0,0:16:55.59,0:16:58.30,Default,,0,0,0,,Британияны қатты ұру.
Dialogue: 0,0:17:00.06,0:17:04.27,Default,,0,0,0,,Зорлық-зомбылық Тонау Кемсітушілік Линчинг
Dialogue: 0,0:17:04.35,0:17:08.69,Default,,0,0,0,,Лаванда үйінің құрбандары да болды.
Dialogue: 0,0:17:09.82,0:17:13.40,Default,,0,0,0,,Сен екеуміз тұрған сол үйдің балалары.
Dialogue: 0,0:17:15.45,0:17:17.57,Default,,0,0,0,,Сондықтан мен ант бердім
Dialogue: 0,0:17:17.66,0:17:20.16,Default,,0,0,0,,Норланд мені пайдаланса да
Dialogue: 0,0:17:20.24,0:17:22.79,Default,,0,0,0,,Біз сол балалар үшін қауіпсіз баспана жасағанша.
Dialogue: 0,0:17:22.87,0:17:26.00,Default,,0,0,0,,Нео-Британдық сарбаз ретінде мен бар күшімді саламын.
Dialogue: 0,0:17:27.29,0:17:29.38,Default,,0,0,0,,Менімен төбелесуге тура келсе қарсы ма?
Dialogue: 0,0:17:29.46,0:17:31.13,Default,,0,0,0,,Басқа таңдау жоқ
Dialogue: 0,0:17:31.21,0:17:33.96,Default,,0,0,0,,Адамның уәдесінде тұруы мүмкін емес!
Dialogue: 0,0:17:34.05,0:17:37.80,Default,,0,0,0,,Ол мені асырап алған кезде не істегенін ұмытты ма?
Dialogue: 0,0:17:37.89,0:17:39.97,Default,,0,0,0,,Сіз және Ноландтың өмірі...
Dialogue: 0,0:17:40.05,0:17:42.31,Default,,0,0,0,,Мен оның қандай болғанын білемін.
Dialogue: 0,0:17:43.56,0:17:44.68,Default,,0,0,0,,Әлі де?
Dialogue: 0,0:17:46.56,0:17:47.98,Default,,0,0,0,,Әлі де
Dialogue: 0,0:17:53.44,0:17:55.44,Default,,0,0,0,,Бір-бірімізден шегініс жасай алмайтын сияқтымыз.
Dialogue: 0,0:17:56.70,0:17:58.66,Default,,0,0,0,,Мен сіздің ниетіңізді түсінемін.
Dialogue: 0,0:17:59.45,0:18:00.74,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:03.49,0:18:05.83,Default,,0,0,0,,Ол адамды сен өлтірген жоқсың ба?
Dialogue: 0,0:18:06.41,0:18:09.58,Default,,0,0,0,,Және Ноландтың асырап алған ұлы.
Dialogue: 0,0:18:10.46,0:18:12.67,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:18:19.59,0:18:23.60,Default,,0,0,0,,(котяттардың айқайы)
Dialogue: 0,0:18:23.68,0:18:25.68,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:18:25.77,0:18:27.68,Default,,0,0,0,,Тамағың осыдан кейін.
Dialogue: 0,0:18:27.77,0:18:30.77,Default,,0,0,0,,Сіз мұны кейінірек айтып тұрған шығарсыз.
Dialogue: 0,0:18:32.56,0:18:35.69,Default,,0,0,0,,Орындалды. Кестені тазалаңыз.
Dialogue: 0,0:18:35.78,0:18:38.32,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:18:39.11,0:18:41.28,Default,,0,0,0,,Қараңыз (котята мияулайды)
Dialogue: 0,0:18:41.87,0:18:43.28,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:18:46.83,0:18:48.12,Default,,0,0,0,,Мияу...
Dialogue: 0,0:18:48.21,0:18:50.50,Default,,0,0,0,,А... білесің бе, аға.
Dialogue: 0,0:18:50.58,0:18:51.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:53.17,0:18:54.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:54.09,0:18:55.55,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:18:55.63,0:18:57.76,Default,,0,0,0,,Маған таң қалдым, сен бүгін не істеп жүрсің.
Dialogue: 0,0:18:57.84,0:18:58.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:59.05,0:19:00.63,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:19:00.72,0:19:03.14,Default,,0,0,0,,Қаруыңызды жаттықтырыңыз және күтіңіз
Dialogue: 0,0:19:03.22,0:19:04.89,Default,,0,0,0,,Мен біраз уақытқа қалаға шықтым.
Dialogue: 0,0:19:05.39,0:19:06.22,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:19:07.81,0:19:10.64,Default,,0,0,0,,Мен де әдеттегідей.
Dialogue: 0,0:19:10.73,0:19:13.81,Default,,0,0,0,,Әріптестермен кездесіп, ақпарат жинаңыз...
Dialogue: 0,0:19:13.90,0:19:15.32,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:15.40,0:19:16.40,Default,,0,0,0,,Иә
Dialogue: 0,0:19:18.40,0:19:19.53,Default,,0,0,0,,Титанның алдында сарбаздар бірінен соң бірі құлады.
Dialogue: 0,0:19:19.61,0:19:22.66,Default,,0,0,0,,Сіз асырап алған кезіңізде мені не істеуге мәжбүрлегеніңізді ұмыттыңыз ба?
Dialogue: 0,0:19:23.37,0:19:26.79,Default,,0,0,0,,Сіз император Джугоны өлтірген жоқсыз.
Dialogue: 0,0:19:30.87,0:19:32.42,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:19:32.50,0:19:34.21,Default,,0,0,0,,Tsk, бұл дұрыс емес!
Dialogue: 0,0:19:34.29,0:19:36.67,Default,,0,0,0,,Иә, бұл есімде.
Dialogue: 0,0:19:36.75,0:19:38.80,Default,,0,0,0,,Маған біреу тапсырыс берді...
Dialogue: 0,0:19:38.88,0:19:40.22,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:40.30,0:19:42.59,Default,,0,0,0,,Бұл... жоқ!
Dialogue: 0,0:19:42.68,0:19:44.43,Default,,0,0,0,,Э?
Dialogue: 0,0:19:44.51,0:19:48.02,Default,,0,0,0,,Маған сеніңіз, Кристоф мырза...
Dialogue: 0,0:19:48.10,0:19:50.98,Default,,0,0,0,,Хмм, бұл қызық.
Dialogue: 0,0:19:51.56,0:19:53.73,Default,,0,0,0,,Geass-қа қатысты деректер жойылды
Dialogue: 0,0:19:53.81,0:19:57.36,Default,,0,0,0,,Қазылған снаряд болған дейді.
Dialogue: 0,0:19:59.32,0:20:00.24,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:20:00.32,0:20:03.86,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:20:03.95,0:20:05.82,Default,,0,0,0,,Гррр… аа…
Dialogue: 0,0:20:05.91,0:20:07.70,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:20:07.78,0:20:10.25,Default,,0,0,0,,Сәлем... Сәлем...
Dialogue: 0,0:20:10.33,0:20:11.62,Default,,0,0,0,,Хе... һ...
Dialogue: 0,0:20:11.71,0:20:12.96,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:20:13.04,0:20:15.25,Default,,0,0,0,,Ахх...
Dialogue: 0,0:20:15.33,0:20:18.75,Default,,0,0,0,,Айт, саған кім бұйырды?
Dialogue: 0,0:20:18.84,0:20:20.09,Default,,0,0,0,,Ахх...
Dialogue: 0,0:20:20.17,0:20:24.64,Default,,0,0,0,,А... мынау аққұба...
Dialogue: 0,0:20:27.05,0:20:28.76,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:20:29.93,0:20:33.10,Default,,0,0,0,,Әлі де реттеу қажет.
Dialogue: 0,0:20:33.19,0:20:35.35,Default,,0,0,0,,Бірақ ол жұмыс істеді.
Dialogue: 0,0:20:35.44,0:20:37.90,Default,,0,0,0,,Әлі де сынақтан өтушілер бар.
Dialogue: 0,0:20:37.98,0:20:40.40,Default,,0,0,0,,Мен не шығатынын асыға күтемін...
Dialogue: 0,0:20:40.48,0:20:41.44,Default,,0,0,0,,Маған көбірек беріңіз
Dialogue: 0,0:20:43.24,0:20:44.74,Default,,0,0,0,,Қосымша
Dialogue: 0,0:20:50.91,0:20:52.20,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:20:52.29,0:20:55.67,Default,,0,0,0,,Жақында үйіме мысық келе бастады.
Dialogue: 0,0:20:55.75,0:20:56.96,Default,,0,0,0,,Мысық па?
Dialogue: 0,0:20:57.04,0:20:58.04,Default,,0,0,0,,Иә
Dialogue: 0,0:20:58.13,0:21:01.30,Default,,0,0,0,,Өте ұйқышыл және шулы мысық
Dialogue: 0,0:21:01.38,0:21:04.55,Default,,0,0,0,,Ол әдемі, жақсы тәрбие алған сияқты.
Dialogue: 0,0:21:04.63,0:21:06.09,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:21:09.30,0:21:11.97,Default,,0,0,0,,Ха... (Вальтер) Әшекейленген император
Dialogue: 0,0:21:14.94,0:21:16.98,Default,,0,0,0,,Император Сакуя
Dialogue: 0,0:21:18.98,0:21:20.32,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:21:20.40,0:21:21.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:21.48,0:21:22.32,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:21:23.07,0:21:25.61,Default,,0,0,0,,Бұл да өтірік емес.
Dialogue: 0,0:21:27.32,0:21:28.78,Default,,0,0,0,,Мүмкін солай шығар
Dialogue: 0,0:21:29.66,0:21:31.99,Default,,0,0,0,,Харуянагиномия Сакура
Dialogue: 0,0:21:33.08,0:21:38.08,Default,,0,0,0,,♪～
Dialogue: 0,0:22:57.91,0:23:02.92,Default,,0,0,0,,～♪
