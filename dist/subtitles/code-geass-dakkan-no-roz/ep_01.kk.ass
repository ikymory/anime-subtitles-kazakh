Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.62,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:09.38,0:00:10.84,Default,,0,0,0,,Бинго!
Dialogue: 0,0:00:10.92,0:00:13.09,Default,,0,0,0,,Жақсы сувенир жасайды
Dialogue: 0,0:00:15.30,0:00:17.51,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:17.60,0:00:20.47,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:20.56,0:00:21.64,Default,,0,0,0,,Ах
Dialogue: 0,0:00:21.73,0:00:22.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:51.96,0:00:56.72,Default,,0,0,0,,Кезінде дүниенің үштен бір бөлігін алып жатқан алпауыт держава
Dialogue: 0,0:00:56.80,0:00:59.30,Default,,0,0,0,,Қасиетті Британ империясы
Dialogue: 0,0:00:59.39,0:01:01.35,Default,,0,0,0,,99-шы император
Dialogue: 0,0:01:01.43,0:01:03.93,Default,,0,0,0,,Лелуш ви Британия соңғы рет
Dialogue: 0,0:01:04.02,0:01:06.48,Default,,0,0,0,,Оның ұзақ тарихы аяқталды
Dialogue: 0,0:01:07.77,0:01:11.52,Default,,0,0,0,,Ел бірнеше шағын елдерге бөлініп кеткен аласапыран кезең болды.
Dialogue: 0,0:01:11.61,0:01:14.40,Default,,0,0,0,,Шнайзел Эль-Британия басшылығымен
Dialogue: 0,0:01:14.49,0:01:16.57,Default,,0,0,0,,Көптеген елдер интеграцияланған
Dialogue: 0,0:01:16.65,0:01:20.78,Default,,0,0,0,,Британ Республикасының супербіріккен ұлтқа қосылуы
Dialogue: 0,0:01:20.87,0:01:23.41,Default,,0,0,0,,Жаңа қадам жасау
Dialogue: 0,0:01:24.00,0:01:27.33,Default,,0,0,0,,Дүние тыныштық орнағандай болды.
Dialogue: 0,0:01:27.42,0:01:29.04,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:40.30,0:01:41.97,Default,,0,0,0,,Кова Кова 3 курс
Dialogue: 0,0:01:42.06,0:01:46.27,Default,,0,0,0,,Кейбір британдық күштер кенеттен соғыс жариялады.
Dialogue: 0,0:01:46.35,0:01:50.48,Default,,0,0,0,,Америка Құрама Штаттары Жапония Хоккайдо блогына рейд
Dialogue: 0,0:01:50.56,0:01:52.07,Default,,0,0,0,,Күшпен басу
Dialogue: 0,0:01:52.15,0:01:56.44,Default,,0,0,0,,Сол елде Нео-Британ империясының құрылғаны жарияланды.
Dialogue: 0,0:01:57.24,0:02:01.49,Default,,0,0,0,,Осылайша жапондықтар тағы да қысымға ұшырады.
Dialogue: 0,0:02:02.28,0:02:05.20,Default,,0,0,0,,Жапония Британияның тәуелді аумағына айналды
Dialogue: 0,0:02:05.29,0:02:09.92,Default,,0,0,0,,11-аймақ деп аталды
Dialogue: 0,0:02:10.00,0:02:15.00,Default,,0,0,0,,♪～
Dialogue: 0,0:03:35.84,0:03:39.92,Default,,0,0,0,,～♪
Dialogue: 0,0:03:43.01,0:03:45.89,Default,,0,0,0,,Шитумпе мұнарасы бекітілген
Dialogue: 0,0:03:46.47,0:03:50.06,Default,,0,0,0,,Сонымен, бұл аумақ мақсатты аумақ па?
Dialogue: 0,0:03:50.14,0:03:52.60,Default,,0,0,0,,Бауырым, Nightmare ойынын қалай реттеп жатырсың?
Dialogue: 0,0:03:53.69,0:03:55.40,Default,,0,0,0,,11 минутта аяқтаңыз
Dialogue: 0,0:03:56.36,0:03:58.36,Default,,0,0,0,,Біз бүгін осында лагерьде тұрамыз.
Dialogue: 0,0:03:58.44,0:04:01.07,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:04:02.99,0:04:04.41,Default,,0,0,0,,Ня~
Dialogue: 0,0:04:05.28,0:04:07.53,Default,,0,0,0,,Хмм... қарныңыз ашты ма?
Dialogue: 0,0:04:07.62,0:04:09.41,Default,,0,0,0,,Ньяа
Dialogue: 0,0:04:09.99,0:04:10.87,Default,,0,0,0,,Уау
Dialogue: 0,0:04:10.95,0:04:13.29,Default,,0,0,0,,Ей, эй, қозғалма, қозғалма.
Dialogue: 0,0:04:13.37,0:04:16.08,Default,,0,0,0,,Бөтен жерге соқса да, білмейсің.
Dialogue: 0,0:04:16.17,0:04:19.25,Default,,0,0,0,,Уф... біз ештеңе білмейміз
Dialogue: 0,0:04:19.34,0:04:21.01,Default,,0,0,0,,Мен террорист емеспін, сондықтан ынтымақтастықта болыңыз...
Dialogue: 0,0:04:21.09,0:04:22.63,Default,,0,0,0,,Он бір
Dialogue: 0,0:04:22.72,0:04:23.72,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:04:23.80,0:04:26.76,Default,,0,0,0,,Со/Ұ/Айт/Ұ
Dialogue: 0,0:04:26.84,0:04:28.64,Default,,0,0,0,,Оны сонда қалдырыңыз, әже.
Dialogue: 0,0:04:28.72,0:04:30.10,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:30.18,0:04:31.43,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:04:31.52,0:04:33.39,Default,,0,0,0,,Ой (әйелдің айқайы)
Dialogue: 0,0:04:34.02,0:04:35.81,Default,,0,0,0,,Сен!
Dialogue: 0,0:04:36.60,0:04:39.94,Default,,0,0,0,,Өзіңіз айтқандай, сонда қалдырдым, аға.
Dialogue: 0,0:04:40.86,0:04:44.07,Default,,0,0,0,,Бұл кішкентай қателік болды. Өтінемін, мені кешірші.
Dialogue: 0,0:04:44.15,0:04:45.24,Default,,0,0,0,,(Түкіру дыбысы)
Dialogue: 0,0:04:46.86,0:04:48.70,Default,,0,0,0,,Ешқандай араласудың қажеті жоқ.
Dialogue: 0,0:04:51.41,0:04:54.29,Default,,0,0,0,,Мейірімді болсаң тез өтерсің.
Dialogue: 0,0:04:54.37,0:04:56.58,Default,,0,0,0,,Сондықтан миы төмен маймылдар...
Dialogue: 0,0:04:56.67,0:04:59.42,Default,,0,0,0,,Бұл балаларды шын мәнінде тәрбиелеуіміз керек.
Dialogue: 0,0:05:00.04,0:05:05.22,Default,,0,0,0,,Тыңдаңдар, мен сендерге көрсетемін, он бір, не істеу керек екеніңді.
Dialogue: 0,0:05:05.30,0:05:06.59,Default,,0,0,0,,Ол сіздің мырзаңыз болды...
Dialogue: 0,0:05:06.68,0:05:08.85,Default,,0,0,0,,Сумераги сумераги Джуго өлді!
Dialogue: 0,0:05:08.93,0:05:12.22,Default,,0,0,0,,Менің қызым Сакуя түрмеде.
Dialogue: 0,0:05:13.22,0:05:16.48,Default,,0,0,0,,Шитумп қабырғалары Британияға қарсы пайдалану үшін жасалған
Dialogue: 0,0:05:16.56,0:05:20.65,Default,,0,0,0,,Енді біз Нео-Британ империясын қорғайтын қабырғамыз.
Dialogue: 0,0:05:20.73,0:05:23.15,Default,,0,0,0,,Қара рыцарьлардың шапқыншылық операциясы
Dialogue: 0,0:05:23.23,0:05:26.07,Default,,0,0,0,,Екі рет нокдаунға түсті
Dialogue: 0,0:05:26.86,0:05:29.53,Default,,0,0,0,,Ең күшті торда тұратын мал
Dialogue: 0,0:05:29.62,0:05:32.16,Default,,0,0,0,,Сізден үміт жоқ
Dialogue: 0,0:05:32.91,0:05:34.83,Default,,0,0,0,,Пайдасыз нәрселер туралы ойламаңыз
Dialogue: 0,0:05:34.91,0:05:36.54,Default,,0,0,0,,Мақсатсыз өмір сүру
Dialogue: 0,0:05:36.62,0:05:39.96,Default,,0,0,0,,Сіздің сезімдеріңіз бен құқықтарыңыз сәйкес келмейтінін біліңіз.
Dialogue: 0,0:05:40.46,0:05:44.34,Default,,0,0,0,,Мылтықтың нысанасына айналудың өзі бір бақыт.
Dialogue: 0,0:05:44.42,0:05:45.38,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:05:45.47,0:05:48.89,Default,,0,0,0,,Қауіпсіздік күштері Қалған қоқысты тазалаңыз.
Dialogue: 0,0:05:48.97,0:05:50.72,Default,,0,0,0,,Иса менің Ием!
Dialogue: 0,0:05:50.80,0:05:54.60,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:05:57.64,0:05:59.10,Default,,0,0,0,,Түскі ас жаңалықтары
Dialogue: 0,0:05:59.19,0:06:01.98,Default,,0,0,0,,Кеше Куширо геттосының Цурмай аймағында
Dialogue: 0,0:06:02.07,0:06:05.36,Default,,0,0,0,,Қауіпсіздік күштері жүргізген лаңкестікке қарсы операция
Dialogue: 0,0:06:05.44,0:06:07.86,Default,,0,0,0,,Осымен Кирквейн қауіпсіздік күштері
Dialogue: 0,0:06:07.95,0:06:09.28,Default,,0,0,0,,Нөлдік өлім
Dialogue: 0,0:06:08.57,0:06:09.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:09.36,0:06:13.37,Default,,0,0,0,,Террорист деген күдікпен 11-де 36 адам қаза тапты
Dialogue: 0,0:06:11.28,0:06:12.70,Default,,0,0,0,,Кирквейн?
Dialogue: 0,0:06:15.45,0:06:17.58,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:06:17.66,0:06:20.54,Default,,0,0,0,,Толық зарядталған кілемді майлау және энергиямен толтыру
Dialogue: 0,0:06:23.63,0:06:25.42,Default,,0,0,0,,Не істеп жатырсың, ақымақ? (соққы дыбысы)
Dialogue: 0,0:06:25.51,0:06:26.76,Default,,0,0,0,,Сол қыз бұл нәрсені анық қалаймайды!
Dialogue: 0,0:06:26.84,0:06:28.97,Default,,0,0,0,,Сіз төгіп тастаған бір тамшы май
Dialogue: 0,0:06:29.05,0:06:31.30,Default,,0,0,0,,Менің ойымша, бұл Он бірдің өмірінен де қымбат.
Dialogue: 0,0:06:31.39,0:06:32.30,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:32.39,0:06:35.18,Default,,0,0,0,,Кешірсең, тез тұр!
Dialogue: 0,0:06:35.26,0:06:37.73,Default,,0,0,0,,Күтсең, тағы да жейді...
Dialogue: 0,0:06:39.52,0:06:40.98,Default,,0,0,0,,Сен мені неге ұрдың?
Dialogue: 0,0:06:41.06,0:06:42.69,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:06:42.77,0:06:44.32,Default,,0,0,0,,Соғудың мәні бар ма?
Dialogue: 0,0:06:44.40,0:06:45.94,Default,,0,0,0,,Бұл мен жұмыс істейтін он бір.
Dialogue: 0,0:06:46.03,0:06:47.36,Default,,0,0,0,,Мен не істесем де...
Dialogue: 0,0:06:47.44,0:06:49.07,Default,,0,0,0,,Гуааааааатта...
Dialogue: 0,0:06:49.15,0:06:53.07,Default,,0,0,0,,Солай-сондай, солай-олай, әзірше, әзірше.
Dialogue: 0,0:06:53.16,0:06:54.66,Default,,0,0,0,,Бауырым, қайнау температурасы тым төмен.
Dialogue: 0,0:06:54.74,0:06:55.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:55.66,0:06:57.87,Default,,0,0,0,,Кешіріңіз, мен ашуланшақпын.
Dialogue: 0,0:06:57.95,0:06:59.54,Default,,0,0,0,,Сіз қандай ақшасыз?
Dialogue: 0,0:06:59.62,0:07:01.46,Default,,0,0,0,,Мен шықсам да...
Dialogue: 0,0:07:01.54,0:07:03.50,Default,,0,0,0,,Олай болса, жеңіл жүрейік.
Dialogue: 0,0:07:03.58,0:07:05.96,Default,,0,0,0,,Төбелес екі жаққа да тиімді емес.
Dialogue: 0,0:07:06.05,0:07:07.63,Default,,0,0,0,,Артқы жағында бұл туралы ақырын айтыңыз
Dialogue: 0,0:07:08.26,0:07:09.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:10.01,0:07:11.01,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:11.09,0:07:12.76,Default,,0,0,0,,Не? Сіз тұра аласыз ба?
Dialogue: 0,0:07:12.84,0:07:16.39,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:07:17.31,0:07:19.89,Default,,0,0,0,,Бауырым, амансың ба?
Dialogue: 0,0:07:20.56,0:07:21.60,Default,,0,0,0,,О
Dialogue: 0,0:07:23.35,0:07:24.94,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:07:25.61,0:07:27.94,Default,,0,0,0,,Алдында болғаныма кешірім сұраймын.
Dialogue: 0,0:07:28.03,0:07:28.99,Default,,0,0,0,,Ауырмайды ма?
Dialogue: 0,0:07:29.07,0:07:31.07,Default,,0,0,0,,Шаршасаңыз, артта демалыңыз.
Dialogue: 0,0:07:31.15,0:07:34.41,Default,,0,0,0,,Жапондар – британдықтардың қазынасы.
Dialogue: 0,0:07:34.49,0:07:35.95,Default,,0,0,0,,А... иә
Dialogue: 0,0:07:36.03,0:07:37.79,Default,,0,0,0,,Осы уақытқа дейін не болғанын ойлаңыз.
Dialogue: 0,0:07:37.87,0:07:39.83,Default,,0,0,0,,Алимент пен үстеме жұмыс ақысын төлеу
Dialogue: 0,0:07:39.91,0:07:41.37,Default,,0,0,0,,Ақылы демалыстарды қамтамасыз ету
Dialogue: 0,0:07:41.46,0:07:43.08,Default,,0,0,0,,Қош келдіңіз~
Dialogue: 0,0:07:43.17,0:07:46.21,Default,,0,0,0,,Мен барамын, сен сабыр ет.
Dialogue: 0,0:07:46.29,0:07:47.84,Default,,0,0,0,,Бұл қазына. (Сатушы) Иә?
Dialogue: 0,0:07:47.92,0:07:50.21,Default,,0,0,0,,Аяғынан шалынған қыздар
Dialogue: 0,0:07:50.30,0:07:52.30,Default,,0,0,0,,Мен онымен сөйлескенімде, ол түсінді.
Dialogue: 0,0:07:52.38,0:07:54.47,Default,,0,0,0,,Ол шынымен жақсы адам болды ма?
Dialogue: 0,0:07:55.51,0:07:57.26,Default,,0,0,0,,Бұл сиқыр сияқты
Dialogue: 0,0:07:57.89,0:08:00.81,Default,,0,0,0,,Сіз сиқыршысыз ба? Жақсы
Dialogue: 0,0:08:02.44,0:08:04.60,Default,,0,0,0,,(Қара құйрықты шағаланың дыбысы)
Dialogue: 0,0:08:05.48,0:08:06.77,Default,,0,0,0,,Сол жақтағы диванға отыр—
Dialogue: 0,0:08:06.86,0:08:09.65,Default,,0,0,0,,Неге қол жеткізгіңіз келетінін білмейтін осындай адамға сенесіз бе?
Dialogue: 0,0:08:09.73,0:08:11.36,Default,,0,0,0,,Бірақ тәжірибе бар.
Dialogue: 0,0:08:11.44,0:08:14.03,Default,,0,0,0,,Кутчан крикет стадионындағы шабуыл оқиғасы
Dialogue: 0,0:08:14.11,0:08:16.74,Default,,0,0,0,,Ралманайдам Энива феодалының кісі өлтіру ісі
Dialogue: 0,0:08:16.82,0:08:19.91,Default,,0,0,0,,Niseko Panorama Line шабуыл оқиғасы?
Dialogue: 0,0:08:19.99,0:08:24.17,Default,,0,0,0,,Иә, олардың барлығы тирандық және британдық шенеуніктерді және дворяндарды құлатады.
Dialogue: 0,0:08:24.25,0:08:26.38,Default,,0,0,0,,Жапон халқын құтқару
Dialogue: 0,0:08:26.46,0:08:28.25,Default,,0,0,0,,Нанашидің жалдамалы Йохеи...
Dialogue: 0,0:08:28.34,0:08:31.92,Default,,0,0,0,,Иә, мен өз іс-әрекетімді өткен жылы бастадым.
Dialogue: 0,0:08:32.01,0:08:36.39,Default,,0,0,0,,Олардың жас британдық ағайындылардан басқа, кім екені белгісіз.
Dialogue: 0,0:08:36.47,0:08:39.01,Default,,0,0,0,,Маған сенуге болмайды.
Dialogue: 0,0:08:39.10,0:08:42.27,Default,,0,0,0,,Шынында да, мен саған сенгеннен кейін де, кенет артымнан шабуыл жасадым.
Dialogue: 0,0:08:42.35,0:08:43.89,Default,,0,0,0,,Бұл қорқынышты емес.
Dialogue: 0,0:08:43.98,0:08:46.48,Default,,0,0,0,,Бірақ қауесеттер рас болса, бұл айтарлықтай күш болады.
Dialogue: 0,0:08:47.06,0:08:49.32,Default,,0,0,0,,Менің ойымша, бұл туралы ойлану керек.
Dialogue: 0,0:08:50.32,0:08:51.61,Default,,0,0,0,,(котяттардың айқайы)
Dialogue: 0,0:08:51.69,0:08:53.15,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:08:53.24,0:08:56.20,Default,,0,0,0,,Мен оның өзенде қалқып жүргенін көрдім
Dialogue: 0,0:08:56.28,0:08:58.16,Default,,0,0,0,,Бұл жақын қоңырау болды.
Dialogue: 0,0:08:58.24,0:09:00.33,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:09:01.12,0:09:03.75,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:03.83,0:09:06.75,Default,,0,0,0,,Жоқ, одан да көбейтсем не істеуім керек?
Dialogue: 0,0:09:06.83,0:09:08.29,Default,,0,0,0,,Мен сені жақсы көремін.
Dialogue: 0,0:09:08.38,0:09:10.50,Default,,0,0,0,,Жоқ, жоқ, мен саған қамқормын.
Dialogue: 0,0:09:10.59,0:09:12.51,Default,,0,0,0,,Менің ағам тамақ сатып алады.
Dialogue: 0,0:09:14.01,0:09:16.13,Default,,0,0,0,,Бұл рұқсат етілмейді, солай ма? сурет?
Dialogue: 0,0:09:16.72,0:09:17.93,Default,,0,0,0,,Балалар сендерге жақсы.
Dialogue: 0,0:09:18.01,0:09:19.10,Default,,0,0,0,,Сіздің отбасыңыз өседі
Dialogue: 0,0:09:19.18,0:09:21.39,Default,,0,0,0,,Мұның астарында қандай логика жатыр?
Dialogue: 0,0:09:21.47,0:09:22.68,Default,,0,0,0,,Маған оны тағы лақтырам деп тұрсың ба?
Dialogue: 0,0:09:22.77,0:09:24.39,Default,,0,0,0,,Бұл адам ретінде жақсы емес.
Dialogue: 0,0:09:24.48,0:09:25.52,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:09:25.60,0:09:27.77,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:09:30.57,0:09:31.82,Default,,0,0,0,,Олар ағайынды ма?
Dialogue: 0,0:09:31.90,0:09:32.94,Default,,0,0,0,,Бұл балалар
Dialogue: 0,0:09:33.03,0:09:34.40,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:09:34.49,0:09:36.53,Default,,0,0,0,,Жарайды, патронаттық тәрбиешіні тіркеу аяқталды
Dialogue: 0,0:09:38.03,0:09:40.32,Default,,0,0,0,,Сізге лайықты патронаттық тәрбиеші таба аласыз деп үміттенемін.
Dialogue: 0,0:09:40.41,0:09:41.78,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:41.87,0:09:44.70,Default,,0,0,0,,Осы қарқынмен трейлер үй жануарларына толып кетеді.
Dialogue: 0,0:09:44.79,0:09:47.16,Default,,0,0,0,,Жұмысымды ауыстырып, үй жануарлары дүкенінде жұмыс істеуім керек пе?
Dialogue: 0,0:09:47.83,0:09:49.29,Default,,0,0,0,,Олай болса мен сізге қалдырамын.
Dialogue: 0,0:09:49.38,0:09:51.04,Default,,0,0,0,,Мен мұны істей алмаймын
Dialogue: 0,0:09:51.13,0:09:53.30,Default,,0,0,0,,Егер сіз тырыссаңыз, мұны істей аласыз.
Dialogue: 0,0:09:55.51,0:09:58.59,Default,,0,0,0,,Хмм, бұл өте қызық.
Dialogue: 0,0:09:58.68,0:10:00.85,Default,,0,0,0,,Біз қызықты нәрсе көретін сияқтымыз
Dialogue: 0,0:10:00.93,0:10:02.14,Default,,0,0,0,,Бұл Миками растағанының белгісі
Dialogue: 0,0:10:02.22,0:10:04.14,Default,,0,0,0,,Бұл жер жабық.
Dialogue: 0,0:10:04.22,0:10:06.89,Default,,0,0,0,,Бірінші фильмді көруге болатынын естідім.
Dialogue: 0,0:10:06.98,0:10:09.15,Default,,0,0,0,,Көп жылдар бойы көрсетпедім.
Dialogue: 0,0:10:09.23,0:10:10.65,Default,,0,0,0,,Мені шақырды.
Dialogue: 0,0:10:10.73,0:10:12.65,Default,,0,0,0,,Жұмыс коды алтыға тоғыз
Dialogue: 0,0:10:12.73,0:10:14.15,Default,,0,0,0,,Қос төрт алты бес
Dialogue: 0,0:10:16.07,0:10:18.15,Default,,0,0,0,,Мен клиентмін, Куронеко Куронеко.
Dialogue: 0,0:10:18.24,0:10:21.07,Default,,0,0,0,,Көмегіңе рахмет, мен Розамын.
Dialogue: 0,0:10:21.16,0:10:22.07,Default,,0,0,0,,Бұл күл.
Dialogue: 0,0:10:22.66,0:10:24.95,Default,,0,0,0,,Толығырақ
Dialogue: 0,0:10:25.04,0:10:26.62,Default,,0,0,0,,Сіз қалай ойлайсыз? Аға
Dialogue: 0,0:10:26.70,0:10:28.75,Default,,0,0,0,,Менде кісі өлтіру ниеті жоқ.
Dialogue: 0,0:10:28.83,0:10:30.25,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:10:33.29,0:10:34.67,Default,,0,0,0,,Ашкөздік Кирквейн
Dialogue: 0,0:10:34.75,0:10:38.09,Default,,0,0,0,,Эйнберг стратегтерінің бірі
Dialogue: 0,0:10:38.17,0:10:40.05,Default,,0,0,0,,Кіші ағасы Гран Кирквейн
Dialogue: 0,0:10:40.13,0:10:41.93,Default,,0,0,0,,Сондай-ақ Эйнбергтің бірі
Dialogue: 0,0:10:42.01,0:10:45.18,Default,,0,0,0,,Территориядағы түнгі шайқас жетекшісі
Dialogue: 0,0:10:46.35,0:10:47.85,Default,,0,0,0,,Олар қауіпсіздік операцияларын жүзеге асырады және
Dialogue: 0,0:10:47.93,0:10:50.19,Default,,0,0,0,,Олар терроризмге қарсы қауіпсіздікті қамтамасыз ететінін айтады.
Dialogue: 0,0:10:50.27,0:10:51.85,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:10:51.94,0:10:54.65,Default,,0,0,0,,Көңіл-күйіне қарай көптеген жапондарды бауыздайды.
Dialogue: 0,0:10:56.40,0:10:59.61,Default,,0,0,0,,Менің отбасым да екі жыл бұрын өлтірілді.
Dialogue: 0,0:10:59.70,0:11:02.62,Default,,0,0,0,,Бірдей сезімдегі адамдар жиналып...
Dialogue: 0,0:11:02.70,0:11:05.20,Default,,0,0,0,,Осы екі адамды өлтіруді талап ету.
Dialogue: 0,0:11:05.79,0:11:07.50,Default,,0,0,0,,Қалай ойлайсың, ағайын?
Dialogue: 0,0:11:07.58,0:11:09.21,Default,,0,0,0,,Мен мұны сізге қалдырамын
Dialogue: 0,0:11:09.29,0:11:11.96,Default,,0,0,0,,Мен тек сіздің стратегияңыз бойынша әрекет етемін.
Dialogue: 0,0:11:12.58,0:11:14.17,Default,,0,0,0,,Сіз оны қабылдай аласыз ба?
Dialogue: 0,0:11:15.92,0:11:18.01,Default,,0,0,0,,Қарсыластар – Эйнбергтен келген екі адам.
Dialogue: 0,0:11:18.09,0:11:20.88,Default,,0,0,0,,Бұл Жаңа Британияның әскери орталығының бөлігі.
Dialogue: 0,0:11:20.97,0:11:23.68,Default,,0,0,0,,Жартылай қарсылас емес.
Dialogue: 0,0:11:23.76,0:11:26.47,Default,,0,0,0,,Дегенмен, одан алатын нәрсе көп.
Dialogue: 0,0:11:26.56,0:11:27.68,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:11:27.77,0:11:31.56,Default,,0,0,0,,Өтінішті ағаларымыз қабылдады.
Dialogue: 0,0:11:34.40,0:11:35.69,Default,,0,0,0,,(Байланыс шуы)
Dialogue: 0,0:11:35.77,0:11:37.69,Default,,0,0,0,,Маңайдағы полиция қызметінен қоңырау шалыңыз
Dialogue: 0,0:11:37.78,0:11:41.07,Default,,0,0,0,,Жапондық лаңкестік топтарға қарсылық танытып отыр
Dialogue: 0,0:11:41.15,0:11:42.49,Default,,0,0,0,,Айнала таза
Dialogue: 0,0:11:43.16,0:11:45.12,Default,,0,0,0,,Түсіндім, түсіндім
Dialogue: 0,0:11:45.20,0:11:47.49,Default,,0,0,0,,Қандай аянышты полиция күші.
Dialogue: 0,0:11:48.08,0:11:50.54,Default,,0,0,0,,Сіз жай ғана Eleven сияқты нәрсені жасай алмайсыз ба?
Dialogue: 0,0:11:50.62,0:11:52.75,Default,,0,0,0,,Сондықтан біз осындамыз
Dialogue: 0,0:11:52.83,0:11:54.88,Default,,0,0,0,,Ең бастысы, лаңкестерден құтылсақ.
Dialogue: 0,0:11:54.96,0:11:57.17,Default,,0,0,0,,Ноланд мырза риза болады.
Dialogue: 0,0:11:57.25,0:11:58.96,Default,,0,0,0,,Иә
Dialogue: 0,0:11:59.46,0:12:01.26,Default,,0,0,0,,Капитан Гран алға
Dialogue: 0,0:12:01.34,0:12:02.76,Default,,0,0,0,,О? Бұл не?
Dialogue: 0,0:12:02.84,0:12:05.01,Default,,0,0,0,,Не болды? Видеоға түсіріңіз
Dialogue: 0,0:12:05.09,0:12:06.10,Default,,0,0,0,,Га
Dialogue: 0,0:12:06.76,0:12:07.76,Default,,0,0,0,,Егер біз Бастың кім екенін нақты анықтап, оны өлтіруді жүзеге асырмасақ, біз оған жеңілеміз.
Dialogue: 0,0:12:07.85,0:12:08.85,Default,,0,0,0,,Га
Dialogue: 0,0:12:10.81,0:12:11.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:17.02,0:12:19.40,Default,,0,0,0,,Эй, эй, эй
Dialogue: 0,0:12:20.03,0:12:22.78,Default,,0,0,0,,Құрметті Кирквейн қауіпсіздік күштері
Dialogue: 0,0:12:22.86,0:12:26.24,Default,,0,0,0,,Сіздерге дайындаған қойылым сахнасына қош келдіңіздер.
Dialogue: 0,0:12:26.32,0:12:29.08,Default,,0,0,0,,Бұл мен бұрын көрмеген қорқынышты кадр.
Dialogue: 0,0:12:29.16,0:12:30.91,Default,,0,0,0,,Ол кім? Тексеріңіз
Dialogue: 0,0:12:31.00,0:12:31.83,Default,,0,0,0,,Га
Dialogue: 0,0:12:31.91,0:12:34.00,Default,,0,0,0,,Сіз кімсіз? Балалар сендер
Dialogue: 0,0:12:34.08,0:12:36.96,Default,,0,0,0,,Сіз сұрағанда еркін жауап беремін деп ойлайсыз ба?
Dialogue: 0,0:12:37.79,0:12:41.71,Default,,0,0,0,,Шикараба Шикараба Шикараба Біз...
Dialogue: 0,0:12:41.80,0:12:44.68,Default,,0,0,0,,Нанашидің жалдамалы
Dialogue: 0,0:12:49.60,0:12:53.18,Default,,0,0,0,,Мен сендерді құртамын.
Dialogue: 0,0:12:57.73,0:12:59.23,Default,,0,0,0,,Нанашидің жалдамалысы?
Dialogue: 0,0:12:59.32,0:13:00.90,Default,,0,0,0,,Мен мұны бұрын естігенмін.
Dialogue: 0,0:13:00.98,0:13:03.57,Default,,0,0,0,,Он бірдің өтініші бойынша террористік әрекеттерді жүргізу.
Dialogue: 0,0:13:03.65,0:13:05.91,Default,,0,0,0,,Сіздің британдық ағаңыз бар деп естідім.
Dialogue: 0,0:13:05.99,0:13:08.57,Default,,0,0,0,,Сіз тым көп жапонды өлтірдіңіз.
Dialogue: 0,0:13:08.66,0:13:10.33,Default,,0,0,0,,Сұраныс сол себепті келді.
Dialogue: 0,0:13:10.41,0:13:12.33,Default,,0,0,0,,Менен құтылуыңды қалаймын.
Dialogue: 0,0:13:12.41,0:13:13.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:13.33,0:13:15.00,Default,,0,0,0,,Сіз істей аламын деп ойлайсыз ба?
Dialogue: 0,0:13:15.08,0:13:17.54,Default,,0,0,0,,Сіз мүмкін емес деп ойлайсыз ба?
Dialogue: 0,0:13:20.46,0:13:22.80,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:13:23.59,0:13:24.59,Default,,0,0,0,,Жоғалып кетті ме?
Dialogue: 0,0:13:24.67,0:13:26.30,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:13:27.01,0:13:28.80,Default,,0,0,0,,Ату! (Солдат) Ха!
Dialogue: 0,0:13:37.23,0:13:39.40,Default,,0,0,0,,Шынайы, қадамсыз!
Dialogue: 0,0:13:39.48,0:13:40.94,Default,,0,0,0,,Екінші және үшінші бірліктер
Dialogue: 0,0:13:41.02,0:13:43.11,Default,,0,0,0,,Басқыншы Nightmare кадрына соғыңыз
Dialogue: 0,0:13:43.19,0:13:45.03,Default,,0,0,0,,Қауіпсіздік күштері баланы іздеп жатыр
Dialogue: 0,0:13:45.11,0:13:46.53,Default,,0,0,0,,Үлкен аға, мен де келемін.
Dialogue: 0,0:13:46.61,0:13:47.95,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:48.03,0:13:51.45,Default,,0,0,0,,Бір ұшақ бізді сынады, мұрнын сындырады.
Dialogue: 0,0:13:56.62,0:14:00.08,Default,,0,0,0,,Осы уақытқа дейін тіпті жақындау қиын болатын.
Dialogue: 0,0:14:00.17,0:14:01.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:04.46,0:14:05.67,Default,,0,0,0,,Сол адамдар...
Dialogue: 0,0:14:05.76,0:14:08.05,Default,,0,0,0,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:14:12.64,0:14:14.89,Default,,0,0,0,,Негізгі қоршауға кіру жолы бекітілді.
Dialogue: 0,0:14:14.97,0:14:17.02,Default,,0,0,0,,Иә, абай боламын
Dialogue: 0,0:14:17.10,0:14:19.14,Default,,0,0,0,,Ал, қалғаны жоспарлағандай болады.
Dialogue: 0,0:14:19.23,0:14:20.27,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:21.94,0:14:23.15,Default,,0,0,0,,Екінші үшінші блок
Dialogue: 0,0:14:23.23,0:14:25.28,Default,,0,0,0,,Мақсатты орналастырыңыз және бекітіңіз
Dialogue: 0,0:14:25.36,0:14:28.74,Default,,0,0,0,,Эй, эй, маған қалдыр.
Dialogue: 0,0:14:28.82,0:14:31.87,Default,,0,0,0,,Алдын ала команда! Мен сені қуып келе жатырмын
Dialogue: 0,0:14:31.95,0:14:34.99,Default,,0,0,0,,Дәмді бөліктерді маған қалдырыңыз
Dialogue: 0,0:14:36.37,0:14:37.87,Default,,0,0,0,,Екінші блокты іске қосу
Dialogue: 0,0:14:39.12,0:14:42.17,Default,,0,0,0,,Үшінші бірлік, В15 нүктесіне барыңыз.
Dialogue: 0,0:14:42.25,0:14:44.75,Default,,0,0,0,,Екінші бөлімше ескерту оқтарын атуды жалғастыруы керек.
Dialogue: 0,0:14:56.31,0:14:59.27,Default,,0,0,0,,Сақтығыңызды түсірмеңіз, қарсыластың ұшқышы өте жақсы жұмыс істей алады.
Dialogue: 0,0:14:59.35,0:15:01.77,Default,,0,0,0,,Сіздің мақтауларыңызға ортақ болу – мәртебе.
Dialogue: 0,0:15:01.85,0:15:03.27,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:15:03.36,0:15:06.73,Default,,0,0,0,,Күдікті адам туралы хабар болса да, сіз абайсыздасыз.
Dialogue: 0,0:15:06.82,0:15:08.32,Default,,0,0,0,,Қауіпсіздік күштері менің бөлмеме
Dialogue: 0,0:15:08.40,0:15:09.82,Default,,0,0,0,,Ол келмейді.
Dialogue: 0,0:15:09.90,0:15:12.03,Default,,0,0,0,,Егер сіз мені мылтық сейфіне апарсаңыз
Dialogue: 0,0:15:12.11,0:15:13.82,Default,,0,0,0,,Өйткені ұйықтайтын уақыт келді...
Dialogue: 0,0:15:13.91,0:15:15.78,Default,,0,0,0,,Барлығы ұйықтап қалды.
Dialogue: 0,0:15:16.37,0:15:17.29,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:15:18.83,0:15:20.66,Default,,0,0,0,,Мені өлтіресің бе?
Dialogue: 0,0:15:20.75,0:15:23.38,Default,,0,0,0,,Хмм, мен шахматты жақсы көремін.
Dialogue: 0,0:15:23.46,0:15:26.09,Default,,0,0,0,,Эй, стратегия ойынын ойнағың келе ме?
Dialogue: 0,0:15:26.17,0:15:27.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:27.09,0:15:30.51,Default,,0,0,0,,Шахмат фигураларын қорқынышты жақтаулар ретінде пайдаланатын ойын
Dialogue: 0,0:15:30.59,0:15:33.22,Default,,0,0,0,,Егер жеңсең, мен сені жіберемін.
Dialogue: 0,0:15:33.30,0:15:35.76,Default,,0,0,0,,Сізді біраз мазақ етті.
Dialogue: 0,0:15:36.43,0:15:38.89,Default,,0,0,0,,Жақсы, мен аламын.
Dialogue: 0,0:15:38.97,0:15:41.10,Default,,0,0,0,,Брат, Браво 1-1 арнасында——
Dialogue: 0,0:15:41.19,0:15:42.39,Default,,0,0,0,,Карта синхрондалғандықтан
Dialogue: 0,0:15:42.48,0:15:44.15,Default,,0,0,0,,Ондағы нұсқауларға сәйкес жылжытыңыз.
Dialogue: 0,0:15:44.23,0:15:45.31,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:05.38,0:16:07.04,Default,,0,0,0,,Білмес бұрын, тұзақтар, т.б.
Dialogue: 0,0:16:07.13,0:16:08.75,Default,,0,0,0,,Мүмкін біз
Dialogue: 0,0:16:08.84,0:16:11.26,Default,,0,0,0,,Сіз жай ғана олар сізді тұтқындап жатыр деп ойладыңыз ба?
Dialogue: 0,0:16:11.34,0:16:13.01,Default,,0,0,0,,Ағай, келесі қадам
Dialogue: 0,0:16:13.09,0:16:14.34,Default,,0,0,0,,О
Dialogue: 0,0:16:14.43,0:16:16.68,Default,,0,0,0,,Стратегия осында.
Dialogue: 0,0:16:16.76,0:16:18.43,Default,,0,0,0,,Мұнда барлығы бірден
Dialogue: 0,0:16:23.69,0:16:24.69,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:24.77,0:16:26.98,Default,,0,0,0,,Сіз оны сызықпен итересіз бе?
Dialogue: 0,0:16:27.06,0:16:29.19,Default,,0,0,0,,Ей, істейтін ештеңе қалмады.
Dialogue: 0,0:16:29.27,0:16:31.44,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:16:31.53,0:16:32.61,Default,,0,0,0,,Хехехе
Dialogue: 0,0:16:32.70,0:16:35.99,Default,,0,0,0,,Өзіңді тұйыққа апарсаң, тығырыққа тіреледі деп ойлайсың ба?
Dialogue: 0,0:16:36.07,0:16:37.70,Default,,0,0,0,,Иә? Дұрыс па?
Dialogue: 0,0:16:37.78,0:16:40.33,Default,,0,0,0,,Себебі мен сені осылай ойлауға жетеледім.
Dialogue: 0,0:16:40.41,0:16:42.54,Default,,0,0,0,,Ғұн тауын алғың келсе
Dialogue: 0,0:16:42.62,0:16:43.91,Default,,0,0,0,,Нәтижелерді алғаннан кейін ғана
Dialogue: 0,0:16:44.00,0:16:44.83,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:16:46.75,0:16:47.92,Default,,0,0,0,,Аға
Dialogue: 0,0:16:48.00,0:16:49.96,Default,,0,0,0,,Мат
Dialogue: 0,0:16:50.05,0:16:51.17,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:01.56,0:17:02.85,Default,,0,0,0,,Хун
Dialogue: 0,0:17:03.43,0:17:04.60,Default,,0,0,0,,Түсіру
Dialogue: 0,0:17:22.91,0:17:24.08,Default,,0,0,0,,Ах
Dialogue: 0,0:17:24.83,0:17:25.71,Default,,0,0,0,,Гах...
Dialogue: 0,0:17:30.88,0:17:32.96,Default,,0,0,0,,Уф... уау!
Dialogue: 0,0:17:37.34,0:17:38.64,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:39.26,0:17:40.89,Default,,0,0,0,,А, келе жатыр! Бұл келе жатыр!
Dialogue: 0,0:17:40.97,0:17:42.01,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:17:42.10,0:17:44.14,Default,,0,0,0,,Капитан... (Байланыс шуы)
Dialogue: 0,0:17:44.22,0:17:45.06,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:47.44,0:17:49.02,Default,,0,0,0,,Сіз соңғысысыз
Dialogue: 0,0:17:49.10,0:17:50.65,Default,,0,0,0,,Істейтін ештеңе қалмады.
Dialogue: 0,0:17:50.73,0:17:51.90,Default,,0,0,0,,Ах
Dialogue: 0,0:17:51.98,0:17:52.90,Default,,0,0,0,,Хун
Dialogue: 0,0:17:52.98,0:17:54.53,Default,,0,0,0,,Оны жалама
Dialogue: 0,0:17:54.61,0:17:58.24,Default,,0,0,0,,Мен Гран Кирквейнмін, Эйнбергтердің бірі.
Dialogue: 0,0:17:58.32,0:18:00.74,Default,,0,0,0,,Аты жоқ адамға жеңілу мүмкін емес.
Dialogue: 0,0:18:01.37,0:18:05.83,Default,,0,0,0,,Сіз қауіпсіз жерден басқаларды жарақаттайтындай күресесіз.
Dialogue: 0,0:18:05.91,0:18:09.33,Default,,0,0,0,,Егер мен ауыруды біліп, тәжірибе жинасам, мен күшейе алар едім.
Dialogue: 0,0:18:11.50,0:18:13.42,Default,,0,0,0,,Бұл мүмкіндік енді ешқашан келмейді.
Dialogue: 0,0:18:13.50,0:18:15.59,Default,,0,0,0,,Қозаке!
Dialogue: 0,0:18:22.93,0:18:23.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:25.22,0:18:26.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:37.07,0:18:39.07,Default,,0,0,0,,Иә, тұрып қалды
Dialogue: 0,0:18:39.15,0:18:40.86,Default,,0,0,0,,және алғашқы жарық сигналда… (Әйел турист 2) Ах! Мен білгенмін.
Dialogue: 0,0:18:40.95,0:18:42.07,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:18:42.16,0:18:45.41,Default,,0,0,0,,Келесі кезек сізде.
Dialogue: 0,0:18:45.49,0:18:47.50,Default,,0,0,0,,Эй, түсіндің бе?
Dialogue: 0,0:18:47.58,0:18:49.58,Default,,0,0,0,,Егер Эйнбергті осы жерде өлтірсек
Dialogue: 0,0:18:49.67,0:18:51.58,Default,,0,0,0,,Жаңа Британияның жаулары
Dialogue: 0,0:18:51.67,0:18:55.42,Default,,0,0,0,,Лорд Ноланд сізді міндетті түрде тауып, бәріңізді талқандайды.
Dialogue: 0,0:18:55.50,0:18:57.38,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:18:59.72,0:19:00.76,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:01.43,0:19:03.01,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:19:14.31,0:19:16.90,Default,,0,0,0,,Сакуя Сумераги?
Dialogue: 0,0:19:16.98,0:19:19.57,Default,,0,0,0,,Ей, ақымақ, сен қазір Абашириде тұрып қалдың...
Dialogue: 0,0:19:19.65,0:19:21.82,Default,,0,0,0,,Эйнберг ақпараты
Dialogue: 0,0:19:21.91,0:19:24.70,Default,,0,0,0,,Рахмет, мен сенімдімін.
Dialogue: 0,0:19:24.78,0:19:26.03,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:27.74,0:19:28.70,Default,,0,0,0,,Кирквейндер отбасы
Dialogue: 0,0:19:28.79,0:19:32.46,Default,,0,0,0,,Анам Шерри Ме Британнианың жақын көмекшісі ретінде.
Dialogue: 0,0:19:32.54,0:19:33.46,Default,,0,0,0,,Хоккайдоға көшті
Dialogue: 0,0:19:34.25,0:19:36.55,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:19:36.63,0:19:38.59,Default,,0,0,0,,Ал, ағайындар
Dialogue: 0,0:19:38.67,0:19:41.76,Default,,0,0,0,,Мен оның жапондықтарды жек көретінін де білемін.
Dialogue: 0,0:19:41.84,0:19:44.47,Default,,0,0,0,,Жапонияны Британия басқарған кезде
Dialogue: 0,0:19:44.55,0:19:47.85,Default,,0,0,0,,Жапон халқын да артынша езген.
Dialogue: 0,0:19:48.43,0:19:50.39,Default,,0,0,0,,Необритания бұл жерге басып кірген кезде
Dialogue: 0,0:19:50.48,0:19:52.06,Default,,0,0,0,,Ішінен нұсқау
Dialogue: 0,0:19:52.14,0:19:55.19,Default,,0,0,0,,Сонымен қатар, Жаңа Британияға көшкендер
Dialogue: 0,0:19:56.02,0:19:58.65,Default,,0,0,0,,Сол күні мен Сакура екеумізді бұрышқа тығып қалдым.
Dialogue: 0,0:19:59.78,0:20:01.15,Default,,0,0,0,,жыртылған
Dialogue: 0,0:20:01.99,0:20:06.16,Default,,0,0,0,,Ха...егер сен шынымен Сакуя Сумераги болсаң.
Dialogue: 0,0:20:06.24,0:20:08.66,Default,,0,0,0,,Сонымен Қагемүшені қолға түсіруге мәжбүр болдық.
Dialogue: 0,0:20:08.74,0:20:09.58,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:10.58,0:20:12.29,Default,,0,0,0,,Достар
Dialogue: 0,0:20:12.37,0:20:13.87,Default,,0,0,0,,Мені тез өлтір
Dialogue: 0,0:20:13.96,0:20:15.38,Default,,0,0,0,,Ескі әңгімелер т.б. қазір...
Dialogue: 0,0:20:16.04,0:20:17.88,Default,,0,0,0,,Мен саған мүмкіндік беремін
Dialogue: 0,0:20:19.96,0:20:23.05,Default,,0,0,0,,Не болды? Қазір жағдай керісінше.
Dialogue: 0,0:20:28.72,0:20:30.97,Default,,0,0,0,,Император Сакуя бұйрық береді
Dialogue: 0,0:20:31.06,0:20:32.89,Default,,0,0,0,,Сіз осы уақытқа дейін бас тарттыңыз
Dialogue: 0,0:20:32.98,0:20:36.27,Default,,0,0,0,,Егер сіз жапондықтарды 100 есе көп құтқаруға ант етсеңіз.
Dialogue: 0,0:20:36.36,0:20:37.69,Default,,0,0,0,,Аман бол
Dialogue: 0,0:20:37.77,0:20:39.90,Default,,0,0,0,,Бірақ бас тартсаң өлесің.
Dialogue: 0,0:20:50.04,0:20:52.29,Default,,0,0,0,,100 рет ақымақ?
Dialogue: 0,0:20:52.37,0:20:55.54,Default,,0,0,0,,Егер сіз триггерді осылай тартсаңыз, аман қаласыз...
Dialogue: 0,0:20:55.62,0:20:58.17,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:21:05.68,0:21:07.64,Default,,0,0,0,,Бауырым, бітті.
Dialogue: 0,0:21:07.72,0:21:08.85,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:21:16.35,0:21:20.27,Default,,0,0,0,,Сіздің сұранысыңыз орындалды.
Dialogue: 0,0:21:20.36,0:21:22.36,Default,,0,0,0,,Бұл маған сенім артты ма?
Dialogue: 0,0:21:22.44,0:21:24.99,Default,,0,0,0,,Хоккайдодағы ең үлкен қарсылық ұйымы
Dialogue: 0,0:21:25.07,0:21:27.70,Default,,0,0,0,,Жеті жарқыраған жұлдыз Шичико Сейданнан Рутака Рютака Харука
Dialogue: 0,0:21:27.78,0:21:29.83,Default,,0,0,0,,А... неге олай істедің?
Dialogue: 0,0:21:29.91,0:21:32.95,Default,,0,0,0,,Адамдар біздің ақпараттық желіні төмен бағаласа, бұл мәселе болар еді.
Dialogue: 0,0:21:33.04,0:21:34.45,Default,,0,0,0,,Бұл сынақ болды, солай ма?
Dialogue: 0,0:21:34.54,0:21:36.92,Default,,0,0,0,,Біз оны пайдалана аламыз ба, жоқ па
Dialogue: 0,0:21:38.04,0:21:40.04,Default,,0,0,0,,Енді бір нәрсе сұрасам болады ма?
Dialogue: 0,0:21:40.13,0:21:43.05,Default,,0,0,0,,Сіздің сүйікті сұрауыңыз қандай?
Dialogue: 0,0:21:50.01,0:21:51.31,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:51.39,0:21:54.14,Default,,0,0,0,,Тырысып жатырмын деп жүргенім үшін кешіріңіз.
Dialogue: 0,0:21:54.22,0:21:55.43,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:21:55.52,0:21:57.06,Default,,0,0,0,,Кіріспе хатты алмастырады.
Dialogue: 0,0:21:58.77,0:22:02.11,Default,,0,0,0,,Ол Абашили концлагері ме?
Dialogue: 0,0:22:02.19,0:22:04.82,Default,,0,0,0,,Ол жерде достар көп.
Dialogue: 0,0:22:04.90,0:22:06.28,Default,,0,0,0,,Мен сені еш нәрсеге қарамастан құтқарғым келеді.
Dialogue: 0,0:22:07.28,0:22:08.66,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:22:11.91,0:22:14.16,Default,,0,0,0,,Ақырында, біз осы уақытқа дейін жеттік.
Dialogue: 0,0:22:17.75,0:22:21.75,Default,,0,0,0,,Менің бала күнгі досым және жақын досым
Dialogue: 0,0:22:23.05,0:22:24.88,Default,,0,0,0,,Міндетті түрде құтқарыңыз
Dialogue: 0,0:22:25.67,0:22:26.55,Default,,0,0,0,,Күте тұрыңыз...
Dialogue: 0,0:22:27.59,0:22:28.97,Default,,0,0,0,,Сакура-чан
Dialogue: 0,0:22:31.01,0:22:36.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:55.89,0:24:00.89,Default,,0,0,0,,～♪
