Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.01,0:00:18.68,Default,,0,0,0,,Розэ, жағдайың қандай?
Dialogue: 0,0:00:19.26,0:00:20.52,Default,,0,0,0,,Қозғалыс үстінде
Dialogue: 0,0:00:23.60,0:00:25.73,Default,,0,0,0,,Ол жерге жету үшін біраз уақыт кетуі мүмкін.
Dialogue: 0,0:00:25.81,0:00:28.65,Default,,0,0,0,,Түсіндім, абай бол
Dialogue: 0,0:00:37.95,0:00:39.28,Default,,0,0,0,,Ноланд
Dialogue: 0,0:00:40.04,0:00:45.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:05.87,0:02:09.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:12.92,0:02:13.75,Default,,0,0,0,,Розе
Dialogue: 0,0:02:13.84,0:02:16.34,Default,,0,0,0,,Император сарайының бір бөлігі көтеріле бастады.
Dialogue: 0,0:02:16.42,0:02:18.17,Default,,0,0,0,,Бақылау
Dialogue: 0,0:02:20.22,0:02:22.22,Default,,0,0,0,,Әуе шайқасында жалғыз Аполлонның қолайсыз жағдайы.
Dialogue: 0,0:02:22.30,0:02:24.01,Default,,0,0,0,,Мен де Артемидамен бірге саған еремін.
Dialogue: 0,0:02:24.10,0:02:26.27,Default,,0,0,0,,Егер сіз мұны өткізіп алсаңыз, сіз ештеңе істей алмайсыз
Dialogue: 0,0:02:29.56,0:02:32.77,Default,,0,0,0,,Ноландты жеңіңіз!
Dialogue: 0,0:02:33.82,0:02:34.82,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:41.07,0:02:46.08,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:02:47.25,0:02:49.12,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:02:49.21,0:02:51.46,Default,,0,0,0,,Уф!Қарғыс атқыр...
Dialogue: 0,0:02:54.54,0:02:55.38,Default,,0,0,0,,Ах
Dialogue: 0,0:02:55.46,0:02:57.88,Default,,0,0,0,,Бұлай болмауы керек...
Dialogue: 0,0:03:02.72,0:03:05.22,Default,,0,0,0,,Ол бұрын Необританиядан жіберілген.
Dialogue: 0,0:03:05.31,0:03:07.64,Default,,0,0,0,,Деректерді талдау аяқталды
Dialogue: 0,0:03:07.72,0:03:10.23,Default,,0,0,0,,Белгісіз машинаның аты - Локи
Dialogue: 0,0:03:10.31,0:03:12.52,Default,,0,0,0,,Жаңа кошмар кадры
Dialogue: 0,0:03:12.60,0:03:16.02,Default,,0,0,0,,Фоулбутпен бірге жасалған стратегиялық қару.
Dialogue: 0,0:03:16.11,0:03:18.07,Default,,0,0,0,,Жаңа Nightmare кадры?
Dialogue: 0,0:03:18.15,0:03:22.74,Default,,0,0,0,,Дүние жүзіндегі Локилер осы машинаның бақылауында сияқты.
Dialogue: 0,0:03:22.82,0:03:26.12,Default,,0,0,0,,Ұшқыш Норланд фон Люнеберг болды.
Dialogue: 0,0:03:26.20,0:03:28.45,Default,,0,0,0,,Бұл ақпаратты мүше мемлекеттерге жіберіңіз
Dialogue: 0,0:03:28.54,0:03:31.12,Default,,0,0,0,,Хоккайдоға сұрыптауға рұқсат алыңыз.
Dialogue: 0,0:03:31.21,0:03:32.37,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:34.00,0:03:37.67,Default,,0,0,0,,Асығыңыз, қорғаныс шегі жақын жерде.
Dialogue: 0,0:03:46.55,0:03:49.14,Default,,0,0,0,,Біраз күтуден шаршадым.
Dialogue: 0,0:03:49.64,0:03:50.85,Default,,0,0,0,,Ноланд мырза...
Dialogue: 0,0:03:52.23,0:03:53.94,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:03:56.06,0:03:57.82,Default,,0,0,0,,Күштің мағынасы...
Dialogue: 0,0:03:59.28,0:04:00.61,Default,,0,0,0,,Маған
Dialogue: 0,0:04:03.78,0:04:05.99,Default,,0,0,0,,Бұдан кейін не істейсіз?
Dialogue: 0,0:04:06.62,0:04:08.70,Default,,0,0,0,,Бұл жерде тұрудың пайдасы жоқ.
Dialogue: 0,0:04:08.79,0:04:13.54,Default,,0,0,0,,Мен алдыңғы сарайда қолымнан келгеннің бәрін жасауға ниеттемін.
Dialogue: 0,0:04:30.89,0:04:31.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:33.14,0:04:36.06,Default,,0,0,0,,Не болды? Шықпайды ма?
Dialogue: 0,0:04:38.98,0:04:43.53,Default,,0,0,0,,Келесі стратегия: Мен оны екінші найза ретінде қолданғым келеді.
Dialogue: 0,0:04:44.11,0:04:45.53,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:04:45.61,0:04:47.53,Default,,0,0,0,,Неге екенін сұрамайсыз ба?
Dialogue: 0,0:04:48.03,0:04:49.45,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:04:49.95,0:04:53.41,Default,,0,0,0,,Менің қызым болғандықтан, ерекше күтімге қаражатым жетпейді...
Dialogue: 0,0:04:53.50,0:04:57.21,Default,,0,0,0,,Бұл «Жеті жарқыраған жұлдыздар шоғырының» Шичико Сейданының жетекшісі ретінде менің шешімім.
Dialogue: 0,0:04:57.29,0:04:59.34,Default,,0,0,0,,Басқа мағынасы жоқ
Dialogue: 0,0:05:03.13,0:05:04.88,Default,,0,0,0,,Ум... (Курото) Харука
Dialogue: 0,0:05:05.47,0:05:08.89,Default,,0,0,0,,Тірі қайтып келгеніңізге көз жеткізіңіз.
Dialogue: 0,0:05:11.39,0:05:12.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:29.66,0:05:31.91,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:31.99,0:05:35.04,Default,,0,0,0,,Сіздің күшіңізге...
Dialogue: 0,0:05:35.79,0:05:37.42,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:05:41.79,0:05:46.51,Default,,0,0,0,,Мен сенген күш қате емес еді...
Dialogue: 0,0:05:47.59,0:05:49.18,Default,,0,0,0,,Дәлелдеңіз!
Dialogue: 0,0:05:56.64,0:06:00.73,Default,,0,0,0,,Иә? Сіз энергияны жоғалттыңыз ба?
Dialogue: 0,0:06:00.81,0:06:03.02,Default,,0,0,0,,Бұл Ситумпеден алынған.
Dialogue: 0,0:06:04.32,0:06:06.44,Default,,0,0,0,,Бұл алдау
Dialogue: 0,0:06:06.53,0:06:08.99,Default,,0,0,0,,Күштің оған еш қатысы жоқ.
Dialogue: 0,0:06:09.07,0:06:12.41,Default,,0,0,0,,Мен емделмегендей сезінемін бе?
Dialogue: 0,0:06:12.49,0:06:16.54,Default,,0,0,0,,Эй, Ноланд мырза, бұл дұрыс емес.
Dialogue: 0,0:06:16.62,0:06:19.75,Default,,0,0,0,,Мен олардың бұлай емес, шынайы күрескенін қаладым!
Dialogue: 0,0:06:19.83,0:06:22.04,Default,,0,0,0,,Шулы жәндіктер
Dialogue: 0,0:06:29.38,0:06:31.34,Default,,0,0,0,,Я...
Dialogue: 0,0:06:32.39,0:06:33.76,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:06:39.35,0:06:42.86,Default,,0,0,0,,Ха ха ха... Мен әбден кешігіп қалдым.
Dialogue: 0,0:06:43.48,0:06:44.90,Default,,0,0,0,,Бізге асығу керек
Dialogue: 0,0:06:49.32,0:06:53.03,Default,,0,0,0,,Күл Артемида ұшып кетті. Онда жағдай қандай?
Dialogue: 0,0:06:54.53,0:06:56.95,Default,,0,0,0,,Әлі шыңға жеткен жоқ
Dialogue: 0,0:06:57.04,0:06:58.20,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:11.76,0:07:14.51,Default,,0,0,0,,Келесі кезеңге өту
Dialogue: 0,0:07:36.41,0:07:37.24,Default,,0,0,0,,Капитан
Dialogue: 0,0:07:37.33,0:07:39.16,Default,,0,0,0,,Ситумпевария бізге жақындап келеді.
Dialogue: 0,0:07:39.75,0:07:40.66,Default,,0,0,0,,Төменгі биіктік
Dialogue: 0,0:07:40.75,0:07:43.17,Default,,0,0,0,,Шлагбаумның жылдамдығы сонша, мен оны айналып өте алмаймын!
Dialogue: 0,0:07:44.25,0:07:45.59,Default,,0,0,0,,Жүйе өшірілді!
Dialogue: 0,0:07:45.67,0:07:48.30,Default,,0,0,0,,Шүкір, резервтік жүйе де жұмыс істемейді?
Dialogue: 0,0:07:48.38,0:07:49.76,Default,,0,0,0,,Апат!
Dialogue: 0,0:07:51.88,0:07:53.76,Default,,0,0,0,,А... бұл не?
Dialogue: 0,0:07:57.10,0:07:59.14,Default,,0,0,0,,Ситумпевария?
Dialogue: 0,0:08:02.44,0:08:04.02,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:06.69,0:08:08.61,Default,,0,0,0,,Күл Жағдай қандай?
Dialogue: 0,0:08:08.69,0:08:09.98,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:08:10.07,0:08:12.53,Default,,0,0,0,,Бұл аумақты Шитумпебария құрлықтың ішінде алып жатыр.
Dialogue: 0,0:08:12.61,0:08:14.24,Default,,0,0,0,,Мен ол жаққа бара алмаймын.
Dialogue: 0,0:08:14.32,0:08:16.24,Default,,0,0,0,,Мүмкіндігінше тезірек шараларды қарастырыңыз
Dialogue: 0,0:08:16.32,0:08:17.41,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:39.72,0:08:43.31,Default,,0,0,0,,Неліктен Ситумпе қабырғасы мұншама ішкі жағына созылып жатыр?
Dialogue: 0,0:08:44.06,0:08:47.77,Default,,0,0,0,,Қалай болғанда да, мен бұлай Ноландқа бара алмаймын.
Dialogue: 0,0:08:47.86,0:08:50.15,Default,,0,0,0,,Мен біраз серпіліс туралы ойлануым керек.
Dialogue: 0,0:08:51.11,0:08:54.70,Default,,0,0,0,,Біріншіден, Хоккайдодағы Шитумпе мұнарасының қирауы?
Dialogue: 0,0:08:54.78,0:08:57.03,Default,,0,0,0,,Егер қазір мүмкін болмаса...
Dialogue: 0,0:08:57.11,0:08:59.45,Default,,0,0,0,,Басқару құрылғысын бассаңыз
Dialogue: 0,0:08:59.53,0:09:02.12,Default,,0,0,0,,Есімде болса, оны бұрын әр облыс басқарған.
Dialogue: 0,0:09:02.70,0:09:05.08,Default,,0,0,0,,Жүйе сол күйінде қалуы мүмкін емес пе?
Dialogue: 0,0:09:05.16,0:09:08.71,Default,,0,0,0,,Іздеу тәсілін өзгертіңіз, көзқарасыңызды жылжытыңыз
Dialogue: 0,0:09:09.21,0:09:12.38,Default,,0,0,0,,А, мен бұл кісінің...
Dialogue: 0,0:09:15.01,0:09:16.26,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:16.93,0:09:20.14,Default,,0,0,0,,Ноланд Ситумпевариядан да жақсы ма?
Dialogue: 0,0:09:20.22,0:09:22.47,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:09:22.56,0:09:25.48,Default,,0,0,0,,Ағымдағы жағдайда кедергіні жоюға болатын болса да
Dialogue: 0,0:09:25.56,0:09:28.48,Default,,0,0,0,,Сол биіктікке жете алатын қорқынышты кадр
Dialogue: 0,0:09:28.56,0:09:30.94,Default,,0,0,0,,Дүниеде санаулы ғана
Dialogue: 0,0:09:31.02,0:09:32.82,Default,,0,0,0,,Дегенмен, сен бір сәт бұрын өзіңді жеңімпаз деп жариялаған едің.
Dialogue: 0,0:09:32.90,0:09:34.86,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, бәрі анық болмайды.
Dialogue: 0,0:09:34.94,0:09:37.45,Default,,0,0,0,,Бір ғана үміт болса...
Dialogue: 0,0:09:38.57,0:09:39.57,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:39.66,0:09:40.95,Default,,0,0,0,,Кездесу кезінде кешіріңіз.
Dialogue: 0,0:09:41.03,0:09:42.08,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:09:42.83,0:09:45.79,Default,,0,0,0,,Командир Роуз маған хабарласты.
Dialogue: 0,0:09:45.87,0:09:47.37,Default,,0,0,0,,Бұл жеке желі ме?
Dialogue: 0,0:09:47.46,0:09:51.09,Default,,0,0,0,,Осы жерде мүшелерге қоңырау шалу
Dialogue: 0,0:09:51.17,0:09:52.13,Default,,0,0,0,,Көрсету
Dialogue: 0,0:09:52.21,0:09:53.34,Default,,0,0,0,,Иә
Dialogue: 0,0:09:54.92,0:09:56.42,Default,,0,0,0,,Нала Вон сонда ма?
Dialogue: 0,0:09:56.51,0:09:59.51,Default,,0,0,0,,Маған Шитумпет мұнарасы туралы мәлімет беруіңізді қалаймын.
Dialogue: 0,0:09:59.59,0:10:01.39,Default,,0,0,0,,Сіз кімсіз? ол
Dialogue: 0,0:10:01.47,0:10:04.31,Default,,0,0,0,,Лорд Вон, маған көмектесе аласыз ба?
Dialogue: 0,0:10:04.39,0:10:05.81,Default,,0,0,0,,Нені білгің келеді?
Dialogue: 0,0:10:05.89,0:10:08.56,Default,,0,0,0,,Мен басқару құрылғысының орнын білгім келеді.
Dialogue: 0,0:10:08.64,0:10:09.60,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:10:10.19,0:10:12.65,Default,,0,0,0,,Тосқауылды алып, Ноландты тоқтатыңыз
Dialogue: 0,0:10:12.73,0:10:15.82,Default,,0,0,0,,Біздің Nightmare сол биіктікте күресуге қабілетті болуы керек.
Dialogue: 0,0:10:18.90,0:10:21.49,Default,,0,0,0,,Маемия Бас ғимараттың жоғарғы қабаты
Dialogue: 0,0:10:22.07,0:10:24.08,Default,,0,0,0,,Басқару бөлмесі сонда.
Dialogue: 0,0:10:24.16,0:10:27.54,Default,,0,0,0,,Сондай-ақ мен сізге ғимараттың ұшуы мен кетуіне рұқсат кодын жіберемін.
Dialogue: 0,0:10:27.62,0:10:29.54,Default,,0,0,0,,Нара-санға рахмет
Dialogue: 0,0:10:29.62,0:10:32.29,Default,,0,0,0,,Мен сізден сұрадым, Нанашидің жалдамалы Йохеи.
Dialogue: 0,0:10:32.88,0:10:33.71,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:34.88,0:10:35.71,Default,,0,0,0,,Шизука
Dialogue: 0,0:10:36.30,0:10:38.97,Default,,0,0,0,,Сонымен қатар біз сұрыптауға дайындықты жалғастырамыз.
Dialogue: 0,0:10:39.05,0:10:39.93,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:10:40.01,0:10:43.72,Default,,0,0,0,,Ей, мен сенің ерікті қозғалыстарыңды қаламаймын.
Dialogue: 0,0:10:43.80,0:10:48.23,Default,,0,0,0,,Біріккен Ұлттық Ассамблея мұндай нәрсеге келіспейді деп ойлаймын.
Dialogue: 0,0:10:47.39,0:10:48.23,Default,,0,0,0,,(мониторды ауыстыру дыбысы)
Dialogue: 0,0:10:48.31,0:10:51.44,Default,,0,0,0,,Мен Конгрессті сендіремін.
Dialogue: 0,0:10:51.52,0:10:53.94,Default,,0,0,0,,Ах, Кагура-сама
Dialogue: 0,0:10:54.52,0:10:55.65,Default,,0,0,0,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,0:10:55.73,0:11:00.49,Default,,0,0,0,,Сол кішкене үмітке сенейік.
Dialogue: 0,0:11:18.46,0:11:21.63,Default,,0,0,0,,Мүлдем көмекке оралыңыз
Dialogue: 0,0:11:21.72,0:11:23.34,Default,,0,0,0,,Бізге асығу керек
Dialogue: 0,0:11:23.97,0:11:25.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:26.35,0:11:27.26,Default,,0,0,0,,Ескерту
Dialogue: 0,0:11:27.35,0:11:30.27,Default,,0,0,0,,Ноланд фон Люнебергті тоқтатқаны үшін
Dialogue: 0,0:11:30.35,0:11:32.60,Default,,0,0,0,,Биометрия қажет
Dialogue: 0,0:11:32.69,0:11:35.65,Default,,0,0,0,,3 секунд ішінде аутентификация жасаңыз
Dialogue: 0,0:11:35.73,0:11:38.57,Default,,0,0,0,,３ ２ １
Dialogue: 0,0:11:39.24,0:11:40.82,Default,,0,0,0,,Техникалық қызмет көрсету бағдарламасын белсендіру
Dialogue: 0,0:11:40.90,0:11:44.32,Default,,0,0,0,,Алдыңғы храмдағы барлық қуат көздерін өшіріңіз
Dialogue: 0,0:11:44.41,0:11:46.08,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:11:48.66,0:11:50.29,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:50.37,0:11:52.33,Default,,0,0,0,,Біз қазірдің өзінде тығырыққа тірелдік пе?
Dialogue: 0,0:11:53.62,0:11:57.25,Default,,0,0,0,,Қуат болмаса, бұл жерден қозғала да алмайсың.
Dialogue: 0,0:11:57.34,0:11:58.34,Default,,0,0,0,,Сіз мені естисіз бе? раушан
Dialogue: 0,0:11:58.42,0:11:59.26,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:59.80,0:12:01.01,Default,,0,0,0,,Синдзо мырза?
Dialogue: 0,0:12:01.09,0:12:03.34,Default,,0,0,0,,Курото мырза қосылды.
Dialogue: 0,0:12:03.43,0:12:05.22,Default,,0,0,0,,Тасымалдау арналары
Dialogue: 0,0:12:05.80,0:12:08.56,Default,,0,0,0,,Бұл Курото, мені естисің бе? раушан
Dialogue: 0,0:12:08.64,0:12:09.52,Default,,0,0,0,,Иә
Dialogue: 0,0:12:09.60,0:12:12.64,Default,,0,0,0,,Жақында Жеті жарқыраған жұлдыз шоғыры келеді.
Dialogue: 0,0:12:12.73,0:12:15.48,Default,,0,0,0,,Маған кедергіні алып тастауға көмектесуіңізді қалаймын.
Dialogue: 0,0:12:15.56,0:12:16.94,Default,,0,0,0,,Неге мұнда?
Dialogue: 0,0:12:17.02,0:12:19.94,Default,,0,0,0,,Қара рыцарьлар берген ақпарат.
Dialogue: 0,0:12:20.03,0:12:23.20,Default,,0,0,0,,Барлық мүшелер сізге көмектесуге ерікті болды.
Dialogue: 0,0:12:24.82,0:12:26.45,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,0:12:27.32,0:12:29.41,Default,,0,0,0,,Бұл өте пайдалы.
Dialogue: 0,0:12:29.49,0:12:32.25,Default,,0,0,0,,Сонымен... мен сізге қалай көмектесе аламын?
Dialogue: 0,0:12:32.33,0:12:35.79,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім...
Dialogue: 0,0:12:38.09,0:12:42.76,Default,,0,0,0,,Курото мырза, визуалды тексеру арқылы сыртқы периферияда айтарлықтай көп Локилерді көруге болады.
Dialogue: 0,0:12:42.84,0:12:44.26,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:12:45.51,0:12:48.47,Default,,0,0,0,,Қазіргі күшпен бұл өте қиын, бірақ...
Dialogue: 0,0:12:49.72,0:12:54.14,Default,,0,0,0,,Maemiya қуатын қалпына келтіру операциясы енді басталады.
Dialogue: 0,0:12:54.23,0:12:58.19,Default,,0,0,0,,Диверсиялық күш - Браво Чарли Дельта
Dialogue: 0,0:12:58.27,0:13:00.23,Default,,0,0,0,,Әр нүктеге дейін кеңейтіңіз
Dialogue: 0,0:13:00.32,0:13:01.53,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:01.61,0:13:04.74,Default,,0,0,0,,Негізгі блок сыртқы перифериядағы Альфа нүктесінде күтуде.
Dialogue: 0,0:13:04.82,0:13:06.49,Default,,0,0,0,,Маршруттың қорғалғанын күтіңіз
Dialogue: 0,0:13:06.57,0:13:08.45,Default,,0,0,0,,Негізгі блок кез келген уақытта шыға алады
Dialogue: 0,0:13:08.53,0:13:11.45,Default,,0,0,0,,Диверсиялық күш операциясы басталады
Dialogue: 0,0:13:11.54,0:13:13.16,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:20.67,0:13:23.34,Default,,0,0,0,,Жарайды, жүгірейік! (мүше) Иә!
Dialogue: 0,0:13:25.01,0:13:27.22,Default,,0,0,0,,Міне, осында, осында
Dialogue: 0,0:13:27.30,0:13:28.51,Default,,0,0,0,,Мен түсемін
Dialogue: 0,0:13:28.59,0:13:31.10,Default,,0,0,0,,Локилерді мүмкіндігінше көп тартыңыз.
Dialogue: 0,0:13:31.18,0:13:32.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:35.27,0:13:37.02,Default,,0,0,0,,Фукай Фукай!
Dialogue: 0,0:13:37.10,0:13:38.60,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:13:39.19,0:13:40.36,Default,,0,0,0,,Чарли Жоғалған 1
Dialogue: 0,0:13:40.44,0:13:42.61,Default,,0,0,0,,Дегенмен, негізгі блоктың бағыты анық
Dialogue: 0,0:13:42.69,0:13:43.78,Default,,0,0,0,,Сіз бара аласыз!
Dialogue: 0,0:13:43.86,0:13:45.03,Default,,0,0,0,,Негізгі күш алға жылжуда!
Dialogue: 0,0:13:45.11,0:13:46.49,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:53.04,0:13:54.20,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:13:54.29,0:13:55.33,Default,,0,0,0,,Ұсталды!
Dialogue: 0,0:13:55.41,0:13:56.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:58.08,0:13:58.92,Default,,0,0,0,,Харука
Dialogue: 0,0:13:59.71,0:14:02.21,Default,,0,0,0,,Бұл жағдайда алда жүргендер тоқтаса
Dialogue: 0,0:14:02.29,0:14:05.55,Default,,0,0,0,,Әскерилер тоқтап, барлығына қауіп төндіреді.
Dialogue: 0,0:14:05.63,0:14:06.84,Default,,0,0,0,,Кешіріңіз, бірақ...
Dialogue: 0,0:14:06.92,0:14:08.80,Default,,0,0,0,,Сен енді екінші найзасың.
Dialogue: 0,0:14:08.88,0:14:10.55,Default,,0,0,0,,Жауапты болыңыз
Dialogue: 0,0:14:10.64,0:14:13.93,Default,,0,0,0,,Бұл отрядты басқаратын адамның рөлі.
Dialogue: 0,0:14:14.01,0:14:15.18,Default,,0,0,0,,Кеттік
Dialogue: 0,0:14:16.02,0:14:17.14,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:22.82,0:14:24.94,Default,,0,0,0,,Сіз жақында орталыққа жетесіз
Dialogue: 0,0:14:25.03,0:14:26.28,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:14:26.36,0:14:28.15,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:14:28.24,0:14:29.78,Default,,0,0,0,,Жоқ, сәл күте тұрыңыз.
Dialogue: 0,0:14:29.86,0:14:32.58,Default,,0,0,0,,Кіреберістің айналасында көптеген Локилер пайда болады.
Dialogue: 0,0:14:33.24,0:14:34.45,Default,,0,0,0,,Не?
Dialogue: 0,0:14:35.62,0:14:40.25,Default,,0,0,0,,Уау, рас, біз де келе жатырмыз.
Dialogue: 0,0:14:40.33,0:14:42.50,Default,,0,0,0,,Бұл оның енгізілгенін білдіре ме...
Dialogue: 0,0:14:42.59,0:14:43.79,Default,,0,0,0,,Мұнда секіріңіз
Dialogue: 0,0:14:43.88,0:14:46.34,Default,,0,0,0,,Құрыш сындыратын бомбаларды орнату мүмкін емес.
Dialogue: 0,0:14:46.42,0:14:48.13,Default,,0,0,0,,Олай болса, бұрылып үйге баруым керек пе?
Dialogue: 0,0:14:48.22,0:14:50.55,Default,,0,0,0,,Жоқ, бұл тым көп.
Dialogue: 0,0:14:50.63,0:14:52.34,Default,,0,0,0,,…
Dialogue: 0,0:14:52.93,0:14:53.85,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:55.81,0:14:56.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:59.06,0:15:01.65,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:26.55,0:15:27.38,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:28.01,0:15:30.05,Default,,0,0,0,,Оларды біріктіру ғана қалды.
Dialogue: 0,0:15:30.13,0:15:31.84,Default,,0,0,0,,Мононобе-сан, не?
Dialogue: 0,0:15:31.93,0:15:33.14,Default,,0,0,0,,Серпіліс жасау
Dialogue: 0,0:15:33.22,0:15:34.18,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:15:34.26,0:15:36.39,Default,,0,0,0,,Талқылауға уақыт жоқ
Dialogue: 0,0:15:36.47,0:15:40.81,Default,,0,0,0,,Мұндай жағдайларда жауапты адам тезірек әрекет етеді.
Dialogue: 0,0:15:46.48,0:15:49.78,Default,,0,0,0,,Сәл шыдаңызшы, Юкка Секка.
Dialogue: 0,0:15:50.90,0:15:51.78,Default,,0,0,0,,Моноб
Dialogue: 0,0:15:51.86,0:15:52.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:54.03,0:15:56.24,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:57.33,0:15:59.91,Default,,0,0,0,,...
Dialogue: 0,0:16:07.09,0:16:08.80,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:08.88,0:16:09.71,Default,,0,0,0,,Ha
Dialogue: 0,0:16:16.47,0:16:17.68,Default,,0,0,0,,Бұл қылыш
Dialogue: 0,0:16:18.31,0:16:19.81,Default,,0,0,0,,Жауапты болыңыз
Dialogue: 0,0:16:19.89,0:16:22.60,Default,,0,0,0,,...
Dialogue: 0,0:16:26.40,0:16:29.44,Default,,0,0,0,,Жол ашық, әрі қарай жүрейік!
Dialogue: 0,0:16:35.53,0:16:38.28,Default,,0,0,0,,...
Dialogue: 0,0:16:38.37,0:16:41.16,Default,,0,0,0,,Біз соңғы бөлімге жеттік.
Dialogue: 0,0:16:43.12,0:16:45.62,Default,,0,0,0,,Қуатты енді қалпына келтіру керек.
Dialogue: 0,0:16:53.30,0:16:54.34,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:55.01,0:16:56.43,Default,,0,0,0,,Бұл тапсырманы енгізіңіз.
Dialogue: 0,0:16:57.09,0:16:58.22,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:58.89,0:17:02.22,Default,,0,0,0,,Мәліметтер бойынша тосқауылдың шығуы шекке жақын және жоғары.
Dialogue: 0,0:17:02.81,0:17:04.73,Default,,0,0,0,,...
Dialogue: 0,0:17:04.81,0:17:06.81,Default,,0,0,0,,Егер толып кету орын алса
Dialogue: 0,0:17:07.90,0:17:09.57,Default,,0,0,0,,Егер сіз оны тоқтата алмасаңыз
Dialogue: 0,0:17:10.15,0:17:11.86,Default,,0,0,0,,Маған жабайы жүгіруге рұқсат етіңіз...
Dialogue: 0,0:17:12.65,0:17:14.28,Default,,0,0,0,,Жою!
Dialogue: 0,0:17:28.96,0:17:30.46,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:17:30.54,0:17:31.46,Default,,0,0,0,,Төртінші бағыт
Dialogue: 0,0:17:31.55,0:17:33.84,Default,,0,0,0,,Шитумпебария жойыла бастады
Dialogue: 0,0:17:33.92,0:17:38.22,Default,,0,0,0,,Алға 27-ден 30-ға дейін Situmpet Tower Жауап жоқ
Dialogue: 0,0:17:42.01,0:17:43.81,Default,,0,0,0,,...
Dialogue: 0,0:17:44.48,0:17:47.06,Default,,0,0,0,,Роуздың миссиясы сәтті болған сияқты.
Dialogue: 0,0:17:47.14,0:17:48.69,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:48.77,0:17:51.40,Default,,0,0,0,,...
Dialogue: 0,0:17:51.48,0:17:52.65,Default,,0,0,0,,...
Dialogue: 0,0:17:52.73,0:17:54.90,Default,,0,0,0,,Локи әлі...
Dialogue: 0,0:17:54.99,0:17:56.24,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:17:56.32,0:17:59.74,Default,,0,0,0,,Мен оны тірі қалдыратыныма сенімді емес шығармын.
Dialogue: 0,0:17:59.82,0:18:02.03,Default,,0,0,0,,...
Dialogue: 0,0:18:02.12,0:18:04.75,Default,,0,0,0,,Менің мұндай жерде өлгім келмейді.
Dialogue: 0,0:18:08.92,0:18:10.71,Default,,0,0,0,,Бірінші рет кездесу
Dialogue: 0,0:18:11.29,0:18:13.50,Default,,0,0,0,,Біз де көмектесеміз
Dialogue: 0,0:18:14.55,0:18:17.26,Default,,0,0,0,,Барлық необританиялық күштерге шығарылды.
Dialogue: 0,0:18:18.30,0:18:22.97,Default,,0,0,0,,Жеті жарқыраған жұлдызмен жұмыс істеп, Локиді жоюға тырысыңыз.
Dialogue: 0,0:18:24.52,0:18:26.64,Default,,0,0,0,,...
Dialogue: 0,0:18:26.73,0:18:30.52,Default,,0,0,0,,Ол енді ұлт сатқыны, жоқ, ол адамзатқа жалмауыз.
Dialogue: 0,0:18:30.60,0:18:32.77,Default,,0,0,0,,Норланд фон Люнебергке қарсы
Dialogue: 0,0:18:32.86,0:18:34.44,Default,,0,0,0,,Көрсету
Dialogue: 0,0:18:34.98,0:18:37.07,Default,,0,0,0,,Біздің шынайы әлеуетіміз!
Dialogue: 0,0:18:49.96,0:18:52.25,Default,,0,0,0,,Кедергі жойылды
Dialogue: 0,0:18:52.84,0:18:54.92,Default,,0,0,0,,Бұл сіздің де соңыңыз.
Dialogue: 0,0:18:55.50,0:18:57.88,Default,,0,0,0,,Кедергілер жоспарды орындауға арналған.
Dialogue: 0,0:18:57.97,0:19:00.51,Default,,0,0,0,,Уақытты сатып алу үшін
Dialogue: 0,0:19:00.59,0:19:04.26,Default,,0,0,0,,Ситумпе жүйесі бұл жекпе-жекте де бар.
Dialogue: 0,0:19:05.43,0:19:09.94,Default,,0,0,0,,Негізгі блок бірегей энергетикалық жүйеден тұрады.
Dialogue: 0,0:19:10.02,0:19:14.82,Default,,0,0,0,,Қолданыстағы жүйе менің алдымдағы күшсіз тіршіліктен басқа ештеңе емес.
Dialogue: 0,0:19:16.07,0:19:20.99,Default,,0,0,0,,Басқаша айтқанда, жеңіс туы саған көтерілмейді.
Dialogue: 0,0:19:23.70,0:19:25.20,Default,,0,0,0,,Кеттік
Dialogue: 0,0:19:26.91,0:19:30.33,Default,,0,0,0,,Бұл мен қазір жасай алатын ең жақсы нәрсе.
Dialogue: 0,0:19:30.83,0:19:33.29,Default,,0,0,0,,Түсінгеніңізге рахмет.
Dialogue: 0,0:19:36.38,0:19:37.80,Default,,0,0,0,,Ноланд
Dialogue: 0,0:19:38.80,0:19:41.22,Default,,0,0,0,,Мен сені өз қолыммен жеңемін.
Dialogue: 0,0:20:06.78,0:20:07.83,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:12.21,0:20:13.58,Default,,0,0,0,,Иә
Dialogue: 0,0:20:14.21,0:20:19.46,Default,,0,0,0,,Бұл жерде уақыт босқа кететін сияқты.
Dialogue: 0,0:20:19.96,0:20:22.55,Default,,0,0,0,,Ұрыс толқынын жылжытайық
Dialogue: 0,0:20:28.18,0:20:29.18,Default,,0,0,0,,Цк
Dialogue: 0,0:20:29.26,0:20:32.10,Default,,0,0,0,,Мен сенің қалай күресетініңді білемін.
Dialogue: 0,0:20:32.73,0:20:35.98,Default,,0,0,0,,Қанша талпынсаң да, мені жеңе алмайсың.
Dialogue: 0,0:20:50.99,0:20:53.12,Default,,0,0,0,,айтқан жоқпын ба?
Dialogue: 0,0:20:57.00,0:20:58.29,Default,,0,0,0,,Тамақ ішпесеңіз...
Dialogue: 0,0:20:59.25,0:21:01.17,Default,,0,0,0,,Жеңіске жету мүмкіндігі бар
Dialogue: 0,0:21:04.17,0:21:05.47,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:38.25,0:21:39.88,Default,,0,0,0,,Бітті
Dialogue: 0,0:21:40.59,0:21:43.05,Default,,0,0,0,,Бұл жерден кет!
Dialogue: 0,0:22:04.99,0:22:05.90,Default,,0,0,0,,Күл
