Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.12,0:00:04.54,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:05.25,0:00:09.67,Default,,0,0,0,,Енді біз жапондық рельеф жүйесін жалғастыра аламыз
Dialogue: 0,0:00:09.75,0:00:12.30,Default,,0,0,0,,Үздіксіз ынтымақтастық үшін рахмет.
Dialogue: 0,0:00:12.38,0:00:14.80,Default,,0,0,0,,Ах... хаха...
Dialogue: 0,0:00:15.39,0:00:18.14,Default,,0,0,0,,Менің ойымша, бұл үрдіс жаман емес.
Dialogue: 0,0:00:19.60,0:00:23.52,Default,,0,0,0,,Бұл қарапайым әдіс, бірақ егер сіз одақтастарыңызды осылай көбейтсеңіз
Dialogue: 0,0:00:23.60,0:00:25.77,Default,,0,0,0,,Ішкі саясат Ноландты төңкеруі мүмкін.
Dialogue: 0,0:00:25.85,0:00:28.65,Default,,0,0,0,,Біз рельеф жүйесіне мән береміз.
Dialogue: 0,0:00:29.23,0:00:30.61,Default,,0,0,0,,Әрине.
Dialogue: 0,0:00:30.69,0:00:34.07,Default,,0,0,0,,Жеміс-жидек жоқ жерлерге адам тартпайды.
Dialogue: 0,0:00:34.15,0:00:35.49,Default,,0,0,0,,Иә
Dialogue: 0,0:00:37.78,0:00:38.66,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:00:39.24,0:00:41.12,Default,,0,0,0,,Өтінемін, мен Сакураға көмектескенше.
Dialogue: 0,0:00:42.16,0:00:44.71,Default,,0,0,0,,Маған көмек бере аласыз ба?
Dialogue: 0,0:00:49.25,0:00:50.75,Default,,0,0,0,,Аға, аға!
Dialogue: 0,0:00:50.84,0:00:52.26,Default,,0,0,0,,Сен
Dialogue: 0,0:00:52.34,0:00:54.76,Default,,0,0,0,,Қараңызшы, ол өте үлкен болып кетті!
Dialogue: 0,0:00:54.84,0:00:56.51,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:00:56.59,0:00:58.89,Default,,0,0,0,,Өйткені біз бәріміз бір отбасымыз
Dialogue: 0,0:00:58.97,0:00:59.80,Default,,0,0,0,,Біз тағы кездесеміз
Dialogue: 0,0:00:59.89,0:01:00.72,Default,,0,0,0,,Хехехе
Dialogue: 0,0:01:00.81,0:01:03.48,Default,,0,0,0,,Сізге лайықты патронаттық тәрбиеші таба аласыз деп үміттенемін.
Dialogue: 0,0:01:03.56,0:01:06.39,Default,,0,0,0,,Осы қарқынмен трейлер үй жануарларына толып кетеді.
Dialogue: 0,0:01:06.48,0:01:08.44,Default,,0,0,0,,Кешіріңіз—
Dialogue: 0,0:01:08.52,0:01:10.02,Default,,0,0,0,,Мен көлік компаниясымын.
Dialogue: 0,0:01:10.61,0:01:12.40,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:01:14.24,0:01:15.15,Default,,0,0,0,,Сәлем, аға.
Dialogue: 0,0:01:15.82,0:01:18.49,Default,,0,0,0,,Сіз үшін маңызды біреу...
Dialogue: 0,0:01:18.57,0:01:19.41,Default,,0,0,0,,Кім?
Dialogue: 0,0:01:20.41,0:01:23.75,Default,,0,0,0,,Бұл сен екенсің, Роза.
Dialogue: 0,0:01:26.79,0:01:28.21,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:28.29,0:01:29.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:34.13,0:01:36.63,Default,,0,0,0,,Мені інім деп алдадың.
Dialogue: 0,0:01:37.26,0:01:39.01,Default,,0,0,0,,Мен рұқсат бермеймін.
Dialogue: 0,0:01:40.22,0:01:41.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:48.06,0:01:49.98,Default,,0,0,0,,Жоқ, бұл қауіпті, бұл қауіпті
Dialogue: 0,0:01:50.06,0:01:52.65,Default,,0,0,0,,Қызымды өлтіремін бе деп қорықтым.
Dialogue: 0,0:01:53.23,0:01:57.53,Default,,0,0,0,,Кішкентай Күл інісіне қатты қамқор болды.
Dialogue: 0,0:01:58.11,0:02:01.45,Default,,0,0,0,,Тартылып кетсем де, інім үшін
Dialogue: 0,0:02:01.53,0:02:03.49,Default,,0,0,0,,Бұл болмашы нәрсе болды.
Dialogue: 0,0:02:04.08,0:02:07.29,Default,,0,0,0,,Жас ханымның білуге ​​мүмкіндігі жоқ.
Dialogue: 0,0:02:07.37,0:02:08.29,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:09.17,0:02:12.75,Default,,0,0,0,,Енді мен жаңа теңіз шошқасын дайындадым.
Dialogue: 0,0:02:12.84,0:02:14.84,Default,,0,0,0,,Бұл күйде эксперименттерді орындау мүмкін емес.
Dialogue: 0,0:02:15.63,0:02:17.30,Default,,0,0,0,,Ах... Уф!
Dialogue: 0,0:02:17.38,0:02:20.80,Default,,0,0,0,,Кешіріңіз, бірақ сізден көмек сұрауға болады ма?
Dialogue: 0,0:02:21.39,0:02:24.18,Default,,0,0,0,,Жоқ, эксперименттен бас тартсаңыз ше?
Dialogue: 0,0:02:24.26,0:02:28.18,Default,,0,0,0,,Бұл балалар қоқыс ретінде жойылады.
Dialogue: 0,0:02:28.27,0:02:31.15,Default,,0,0,0,,Келу-келмеу өз еркіңіз.
Dialogue: 0,0:02:31.23,0:02:34.94,Default,,0,0,0,,Кухахаха...!
Dialogue: 0,0:02:35.02,0:02:40.03,Default,,0,0,0,,♪～
Dialogue: 0,0:04:00.86,0:04:04.91,Default,,0,0,0,,～♪
Dialogue: 0,0:04:08.45,0:04:09.70,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:04:10.41,0:04:11.91,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:04:14.83,0:04:15.75,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:04:16.38,0:04:18.13,Default,,0,0,0,,Сумераги шумераги сакуя
Dialogue: 0,0:04:18.21,0:04:20.00,Default,,0,0,0,,Сакуя-сама? (Әйел) Сакуя-сама!
Dialogue: 0,0:04:20.09,0:04:21.01,Default,,0,0,0,,Неге мұндай жерде...
Dialogue: 0,0:04:21.09,0:04:25.47,Default,,0,0,0,,Жарайды, барлық тыртықтар үшін кешірім сұраймын.
Dialogue: 0,0:04:25.55,0:04:28.55,Default,,0,0,0,,Ұялмайсың ба бұлай істеуге?
Dialogue: 0,0:04:28.64,0:04:31.85,Default,,0,0,0,,Жарайды, маған көрсетші.
Dialogue: 0,0:04:31.93,0:04:33.35,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:04:33.43,0:04:35.44,Default,,0,0,0,,Мүмкін болса, мені күлдіретін нәрсе алғым келеді...
Dialogue: 0,0:04:35.52,0:04:36.73,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:36.81,0:04:38.52,Default,,0,0,0,,Біз ынтымақтастық жасаймыз.
Dialogue: 0,0:04:39.15,0:04:41.19,Default,,0,0,0,,Мен де саған Геастың сырын айтамын
Dialogue: 0,0:04:41.28,0:04:43.19,Default,,0,0,0,,Сонымен, бұған дейін бұл адамдар...
Dialogue: 0,0:04:43.28,0:04:44.45,Default,,0,0,0,,Сонымен (ер) Ах!
Dialogue: 0,0:04:44.53,0:04:45.53,Default,,0,0,0,,Кя!
Dialogue: 0,0:04:46.36,0:04:48.20,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:04:48.28,0:04:52.95,Default,,0,0,0,,Бірақ Геастың сыры қызық.
Dialogue: 0,0:04:53.04,0:04:55.83,Default,,0,0,0,,Әлде сіз уақытты ұтып алғыңыз келе ме?
Dialogue: 0,0:04:55.92,0:04:58.38,Default,,0,0,0,,Пайдасы жоқ, бас тарт.
Dialogue: 0,0:04:59.00,0:05:00.71,Default,,0,0,0,,Ол келмейді.
Dialogue: 0,0:05:01.71,0:05:06.38,Default,,0,0,0,,Геастың күші арқылы сенімге қол жеткізу мүмкін емес.
Dialogue: 0,0:05:06.47,0:05:07.64,Default,,0,0,0,,Сакуя-сама!
Dialogue: 0,0:05:07.72,0:05:10.26,Default,,0,0,0,,Бізде бәрі жақсы, тек сен болсаң да...
Dialogue: 0,0:05:11.18,0:05:12.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:12.10,0:05:13.98,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:05:14.06,0:05:15.77,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:05:15.85,0:05:18.31,Default,,0,0,0,,Барлығын қалпына келтіріп, орындарды жылжытуым керек пе...
Dialogue: 0,0:05:18.40,0:05:20.06,Default,,0,0,0,,Жоқ! Өтінемін тоқта!
Dialogue: 0,0:05:26.03,0:05:27.07,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:27.70,0:05:30.99,Default,,0,0,0,,Енді... көрсетейін.
Dialogue: 0,0:05:33.08,0:05:35.00,Default,,0,0,0,,Сакуя-сама (Бала) Сакуя-сама
Dialogue: 0,0:05:36.54,0:05:37.75,Default,,0,0,0,,Император…
Dialogue: 0,0:05:40.25,0:05:42.17,Default,,0,0,0,,Император Сакуя...
Dialogue: 0,0:05:44.34,0:05:45.63,Default,,0,0,0,,Бұйрық!
Dialogue: 0,0:05:51.80,0:05:53.64,Default,,0,0,0,,Күл!
Dialogue: 0,0:05:53.72,0:05:57.48,Default,,0,0,0,,Император Сакуя Кристоф Скиссорменге бұйрық береді!
Dialogue: 0,0:05:58.23,0:05:59.40,Default,,0,0,0,,Сен менің қол-аяғымсың...
Dialogue: 0,0:05:59.48,0:06:00.61,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:06:01.44,0:06:02.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:05.36,0:06:07.99,Default,,0,0,0,,Кім...
Dialogue: 0,0:06:08.07,0:06:12.28,Default,,0,0,0,,Сенің... қуыршақтарың...
Dialogue: 0,0:06:40.52,0:06:41.94,Default,,0,0,0,,Күл... I
Dialogue: 0,0:06:43.73,0:06:46.65,Default,,0,0,0,,Мен әлі бәрін кешіре алмаймын
Dialogue: 0,0:06:47.61,0:06:48.44,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:49.57,0:06:51.24,Default,,0,0,0,,Сен мені құтқардың——
Dialogue: 0,0:06:51.95,0:06:54.24,Default,,0,0,0,,Мен император Джуго Джугоның сөзіне сенемін.
Dialogue: 0,0:06:55.12,0:06:58.75,Default,,0,0,0,,Мейірімді қызмын деген кісінің сөзі.
Dialogue: 0,0:06:58.83,0:06:59.87,Default,,0,0,0,,Сол себепті!
Dialogue: 0,0:07:01.21,0:07:04.84,Default,,0,0,0,,Сіз нені таңдайсыз және енді не істейсіз?
Dialogue: 0,0:07:04.92,0:07:06.42,Default,,0,0,0,,Өз көзіммен анықтадым
Dialogue: 0,0:07:07.17,0:07:08.97,Default,,0,0,0,,Уәденің орындалуы
Dialogue: 0,0:07:13.64,0:07:14.51,Default,,0,0,0,,Мен
Dialogue: 0,0:07:15.93,0:07:17.68,Default,,0,0,0,,Сізді қорғау
Dialogue: 0,0:07:18.27,0:07:20.06,Default,,0,0,0,,Өйткені мен ол кісіге ант бердім
Dialogue: 0,0:07:27.36,0:07:29.28,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:34.45,0:07:35.95,Default,,0,0,0,,Болашаққа келетін болсақ
Dialogue: 0,0:07:36.53,0:07:39.83,Default,,0,0,0,,Екеуміз бірге әрекет етуіміз үшін Роуздың қатысуы қажет.
Dialogue: 0,0:07:39.91,0:07:43.62,Default,,0,0,0,,Бұл біткенше Розе болып қалғаныңыз жөн.
Dialogue: 0,0:07:43.71,0:07:44.67,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:45.33,0:07:46.84,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:49.17,0:07:50.72,Default,,0,0,0,,Есеп беру!
Dialogue: 0,0:07:50.80,0:07:54.26,Default,,0,0,0,,Бұл шабуылда Хоккайдодағы террористік ұйымдардың арасында
Dialogue: 0,0:07:54.34,0:07:56.76,Default,,0,0,0,,Екі жою әрекеті сәтті болды.
Dialogue: 0,0:07:57.35,0:08:01.27,Default,,0,0,0,,Жеті жарқыраған жұлдыз шоғырындағы Шичико Сейданның бекіністері де жойылды.
Dialogue: 0,0:08:01.35,0:08:05.27,Default,,0,0,0,,Қалған егеуқұйрықтардан құтылу уақыт мәселесі.
Dialogue: 0,0:08:05.35,0:08:07.65,Default,,0,0,0,,Эш Феникс және лаңкестердің қалдықтары
Dialogue: 0,0:08:08.23,0:08:11.65,Default,,0,0,0,,Мына Арнольд оны міндетті түрде жерлейді.
Dialogue: 0,0:08:11.74,0:08:13.28,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:08:13.36,0:08:15.24,Default,,0,0,0,,Иса менің Ием!
Dialogue: 0,0:08:17.74,0:08:21.83,Default,,0,0,0,,Шығыс таңының Акацуки бригадасы: Хокуро моль армиясы жойылды.
Dialogue: 0,0:08:21.91,0:08:24.46,Default,,0,0,0,,Біз де күшіміздің көп бөлігін жоғалттық.
Dialogue: 0,0:08:25.17,0:08:27.67,Default,,0,0,0,,Бұл менің жауапкершілігім.
Dialogue: 0,0:08:27.75,0:08:29.34,Default,,0,0,0,,Роза?
Dialogue: 0,0:08:29.42,0:08:31.46,Default,,0,0,0,,Бұл мен өзіммен бірге ала алған қарулар тізімі.
Dialogue: 0,0:08:31.55,0:08:32.88,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:08:32.97,0:08:36.18,Default,,0,0,0,,Бақытымызға орай, мен қосалқы бөлшектерді басқа жерде сақтадым.
Dialogue: 0,0:08:36.80,0:08:38.64,Default,,0,0,0,,Оларды жинап, келесі шайқасқа өтіңіз...
Dialogue: 0,0:08:38.72,0:08:42.18,Default,,0,0,0,,Ештеңе... Мен ештеңе істей алмадым.
Dialogue: 0,0:08:43.64,0:08:45.06,Default,,0,0,0,,Өзім
Dialogue: 0,0:08:46.02,0:08:47.19,Default,,0,0,0,,Мен оны Солтүстік-Шығыс әскери театрдан алдым.
Dialogue: 0,0:08:47.27,0:08:48.61,Default,,0,0,0,,Роза Ах...
Dialogue: 0,0:08:49.19,0:08:50.86,Default,,0,0,0,,Роуз не ойлайды?
Dialogue: 0,0:08:50.94,0:08:53.86,Default,,0,0,0,,Әй...
Dialogue: 0,0:08:55.49,0:08:57.11,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:08:57.70,0:08:59.70,Default,,0,0,0,,Осындай тозығы жеткен жағдайда
Dialogue: 0,0:08:59.78,0:09:02.62,Default,,0,0,0,,Мен қандай стратегия ойлап тапсам да, бұл мағынасыз деп ойлаймын...
Dialogue: 0,0:09:03.58,0:09:06.00,Default,,0,0,0,,Олай деуге болмайды!
Dialogue: 0,0:09:06.62,0:09:08.04,Default,,0,0,0,,Сіз де қамауға алындыңыз.
Dialogue: 0,0:09:08.13,0:09:10.88,Default,,0,0,0,,Менің жасырынған жерімді білгеніңіз үшін мен сізді кінәламаймын.
Dialogue: 0,0:09:11.46,0:09:12.46,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:09:12.55,0:09:13.67,Default,,0,0,0,,Бізді тірі қалдыру үшін
Dialogue: 0,0:09:13.76,0:09:16.13,Default,,0,0,0,,Құрбандар бар екенін ұмытпаңыз!
Dialogue: 0,0:09:16.72,0:09:18.09,Default,,0,0,0,,Және де
Dialogue: 0,0:09:18.18,0:09:21.01,Default,,0,0,0,,Сіз, стратегияны жоспарлайтын адамсыз, мағынасыз.
Dialogue: 0,0:09:21.10,0:09:22.85,Default,,0,0,0,,Мұндай нәрсе... (Курото) Мононобе
Dialogue: 0,0:09:22.93,0:09:24.23,Default,,0,0,0,,Ах
Dialogue: 0,0:09:25.02,0:09:25.98,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:26.69,0:09:30.23,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:09:30.82,0:09:32.94,Default,,0,0,0,,Бүгін екеуің де демалуларың керек.
Dialogue: 0,0:09:33.61,0:09:35.44,Default,,0,0,0,,Бірақ ертеңнен бастап
Dialogue: 0,0:09:36.15,0:09:38.95,Default,,0,0,0,,Алға ойлау
Dialogue: 0,0:09:39.03,0:09:42.95,Default,,0,0,0,,Біздің қолымыздан келетіні осы.
Dialogue: 0,0:09:44.70,0:09:47.42,Default,,0,0,0,,Тоқта, күте тұр, кешігіп қалдым кешір.
Dialogue: 0,0:09:47.50,0:09:49.92,Default,,0,0,0,,Уа... секірме.
Dialogue: 0,0:09:50.00,0:09:51.92,Default,,0,0,0,,Геасси де
Dialogue: 0,0:09:52.00,0:09:55.67,Default,,0,0,0,,Менің шынайы болмысым Ноландқа да белгілі.
Dialogue: 0,0:09:56.55,0:09:57.80,Default,,0,0,0,,Мұндай жағдайда...
Dialogue: 0,0:09:57.88,0:09:59.47,Default,,0,0,0,,Жақында дайын болады.
Dialogue: 0,0:09:59.55,0:10:00.93,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:10:01.01,0:10:02.43,Default,,0,0,0,,Не істегің келеді?
Dialogue: 0,0:10:02.51,0:10:04.18,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:06.06,0:10:07.31,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:10:07.39,0:10:11.73,Default,,0,0,0,,Сіз супер интеграцияланған елге жіберілесіз.
Dialogue: 0,0:10:11.81,0:10:15.65,Default,,0,0,0,,Менің бір ойым бар. Маған қалдыра аласыз ба?
Dialogue: 0,0:10:15.74,0:10:17.11,Default,,0,0,0,,О
Dialogue: 0,0:10:19.07,0:10:21.41,Default,,0,0,0,,Басында өз құлағыма өзім сенбедім.
Dialogue: 0,0:10:21.49,0:10:26.12,Default,,0,0,0,,Мен необританиялық тарап бейбіт келіссөздер жүргізуге ұсыныс жасайды деп ешқашан күткен емеспін.
Dialogue: 0,0:10:27.25,0:10:29.62,Default,,0,0,0,,Қоңырлардың рыцарлары болған адам ретінде
Dialogue: 0,0:10:29.71,0:10:31.63,Default,,0,0,0,,Мен Ноланд туралы білемін, бірақ
Dialogue: 0,0:10:32.50,0:10:35.17,Default,,0,0,0,,Император Чарльздың бұйрығын ғана тыңда
Dialogue: 0,0:10:35.25,0:10:37.42,Default,,0,0,0,,Көп шықпады.
Dialogue: 0,0:10:38.09,0:10:41.64,Default,,0,0,0,,Мен сенің не ойлағаныңды оқи алмаймын.
Dialogue: 0,0:10:42.80,0:10:44.31,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:10:44.39,0:10:47.22,Default,,0,0,0,,Біз барлық жағдайға дайындалуымыз керек.
Dialogue: 0,0:10:47.31,0:10:49.06,Default,,0,0,0,,Шын ниетіне қарамастан
Dialogue: 0,0:10:49.14,0:10:51.73,Default,,0,0,0,,Мен өзімнің күшті ұстанымымнан бас тарта алмаймын.
Dialogue: 0,0:10:51.81,0:10:54.23,Default,,0,0,0,,Келіссөздер өтетін орын Хачинохе базасы болып шешілді.
Dialogue: 0,0:10:54.32,0:10:56.03,Default,,0,0,0,,Өтінемін, толқындар
Dialogue: 0,0:10:56.11,0:10:57.74,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:57.82,0:11:01.16,Default,,0,0,0,,Бейбіт шешімге қол жеткізілсе, бұл жақсы.
Dialogue: 0,0:11:01.24,0:11:04.66,Default,,0,0,0,,Бірақ бұл да бізге бұғау.
Dialogue: 0,0:11:05.66,0:11:08.41,Default,,0,0,0,,Мен кейбір қиын карталарды кесіп алатынмын.
Dialogue: 0,0:11:09.37,0:11:10.75,Default,,0,0,0,,Бейбітшілік келіссөздері?
Dialogue: 0,0:11:10.83,0:11:11.87,Default,,0,0,0,,О
Dialogue: 0,0:11:11.96,0:11:15.29,Default,,0,0,0,,Нала-сама Супер Біріккен елге арнайы елші ретінде барады.
Dialogue: 0,0:11:15.88,0:11:19.47,Default,,0,0,0,,Бұл біздің әрекетіміз өз жемісін берді дегенді білдіре ме?
Dialogue: 0,0:11:20.30,0:11:21.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:22.72,0:11:25.35,Default,,0,0,0,,Мүмкін емес! Ноланд - бейбітшілік.
Dialogue: 0,0:11:25.43,0:11:26.64,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:11:26.72,0:11:30.06,Default,,0,0,0,,Ол біз білмейтін нәрсені жоспарлап отыр.
Dialogue: 0,0:11:30.14,0:11:31.85,Default,,0,0,0,,Бұл өте ықтимал.
Dialogue: 0,0:11:32.48,0:11:36.19,Default,,0,0,0,,Бірақ бейбітшілік жырланса, мен абайсызда араласа алмаймын.
Dialogue: 0,0:11:36.27,0:11:40.36,Default,,0,0,0,,Садағыңды бірінші тартсаң, тыныштықты бұзған жаман адам осы.
Dialogue: 0,0:11:40.44,0:11:43.36,Default,,0,0,0,,Чикшо Ол қорқақ жігіт.
Dialogue: 0,0:11:43.45,0:11:46.08,Default,,0,0,0,,Ей, не істеуіміз керек, Роза!
Dialogue: 0,0:11:46.16,0:11:47.54,Default,,0,0,0,,Хмм (Мунемори Мунемори) Даусыңыз өте қатты.
Dialogue: 0,0:11:47.62,0:11:48.45,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:11:47.62,0:11:50.62,Default,,0,0,0,,Қалай болғанда да, ақпарат жеткіліксіз.
Dialogue: 0,0:11:48.54,0:11:50.62,Default,,0,0,0,,Сонда сізде жақсы идея бар ма?
Dialogue: 0,0:11:50.71,0:11:52.16,Default,,0,0,0,,Розе үшін ештеңе жоқ па? Эй, айтшы.
Dialogue: 0,0:11:52.25,0:11:55.29,Default,,0,0,0,,А... иә, әзірге.
Dialogue: 0,0:11:56.00,0:11:57.55,Default,,0,0,0,,Мен тергеуді жалғастырамын.
Dialogue: 0,0:11:57.63,0:12:00.67,Default,,0,0,0,,Бұрынғыдан да тереңірек, мүмкіндігінше
Dialogue: 0,0:12:00.76,0:12:03.01,Default,,0,0,0,,О! Мен оны сұрадым
Dialogue: 0,0:12:03.88,0:12:05.51,Default,,0,0,0,,Онда мен бірінші барамын.
Dialogue: 0,0:12:05.59,0:12:07.05,Default,,0,0,0,,Қазіргіден жақсы
Dialogue: 0,0:12:05.59,0:12:08.51,Default,,0,0,0,,Бұл қару ғой. Бұл өте күшті қару.
Dialogue: 0,0:12:07.14,0:12:08.51,Default,,0,0,0,,Бұл сізге сәйкес емес пе?
Dialogue: 0,0:12:11.56,0:12:13.98,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:12:14.06,0:12:15.86,Default,,0,0,0,,Әдеттегідей мен оны дұрыс орындауым керек.
Dialogue: 0,0:12:15.94,0:12:17.31,Default,,0,0,0,,(әйелдер мен ерлер жылайды)
Dialogue: 0,0:12:17.40,0:12:18.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:18.32,0:12:21.65,Default,,0,0,0,,(әйелдер мен ерлер жылайды)
Dialogue: 0,0:12:22.86,0:12:25.95,Default,,0,0,0,,Шығыс таң бригадасының Солтүстік Қасқыр армиясы жойылды
Dialogue: 0,0:12:26.03,0:12:26.87,Default,,0,0,0,,Гррр…
Dialogue: 0,0:12:26.95,0:12:28.87,Default,,0,0,0,,Эй, түсіндің бе?
Dialogue: 0,0:12:28.95,0:12:31.08,Default,,0,0,0,,Міне, егер біз Эйнбергті өлтірсек
Dialogue: 0,0:12:31.16,0:12:32.33,Default,,0,0,0,,Жаңа Британияның жаулары
Dialogue: 0,0:12:32.41,0:12:33.50,Default,,0,0,0,,Соғыс және оны қайтарыңыз
Dialogue: 0,0:12:33.58,0:12:34.67,Default,,0,0,0,,Сіз істей аламын деп ойлайсыз ба?
Dialogue: 0,0:12:34.75,0:12:36.00,Default,,0,0,0,,Мен Фрейяны тоқтатқым келеді!
Dialogue: 0,0:12:36.08,0:12:37.38,Default,,0,0,0,,Сіз мүмкін емес деп ойлайсыз ба?
Dialogue: 0,0:12:37.46,0:12:39.25,Default,,0,0,0,,Менімен бірге келші (Курото) Уилл
Dialogue: 0,0:12:39.34,0:12:40.55,Default,,0,0,0,,Сакуя-сама? (Әйел) Сакуя-сама
Dialogue: 0,0:12:40.63,0:12:42.55,Default,,0,0,0,,Неліктен мұндай орын?
Dialogue: 0,0:12:42.63,0:12:46.26,Default,,0,0,0,,Бізді құтқарыңыз!
Dialogue: 0,0:12:46.34,0:12:48.26,Default,,0,0,0,,Хаха...
Dialogue: 0,0:12:50.77,0:12:52.27,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:12:53.60,0:12:54.48,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:55.14,0:12:56.02,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:13:01.36,0:13:02.78,Default,,0,0,0,,Сакура...
Dialogue: 0,0:13:02.86,0:13:04.74,Default,,0,0,0,,Жапон...
Dialogue: 0,0:13:04.82,0:13:07.32,Default,,0,0,0,,Ұрланғанның бәрі...
Dialogue: 0,0:13:07.41,0:13:08.82,Default,,0,0,0,,Қайта алу!
Dialogue: 0,0:13:10.24,0:13:14.29,Default,,0,0,0,,Бұл менің шешімім!
Dialogue: 0,0:13:20.42,0:13:24.55,Default,,0,0,0,,(Стэнли гуілдейді)
Dialogue: 0,0:13:24.63,0:13:25.97,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:13:26.05,0:13:26.97,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:27.55,0:13:29.72,Default,,0,0,0,,Барлық орналастыру аяқталды
Dialogue: 0,0:13:30.35,0:13:32.14,Default,,0,0,0,,Оған қорек қажет болады, иә?
Dialogue: 0,0:13:32.77,0:13:35.73,Default,,0,0,0,,Ақырында біз құтқарылдық.
Dialogue: 0,0:13:38.73,0:13:39.73,Default,,0,0,0,,Я...
Dialogue: 0,0:13:39.81,0:13:42.11,Default,,0,0,0,,Бірдеңе болды ма? күл
Dialogue: 0,0:13:42.86,0:13:44.86,Default,,0,0,0,,Мен сені соңғы уақытта мүлдем көрмедім.
Dialogue: 0,0:13:44.94,0:13:46.20,Default,,0,0,0,,Таңқурай мырзаға
Dialogue: 0,0:13:46.28,0:13:47.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:47.20,0:13:50.03,Default,,0,0,0,,Мен өткен сайын дүкеннің жанына тоқтаймын.
Dialogue: 0,0:13:50.12,0:13:52.24,Default,,0,0,0,,Сіз тастап кеттіңіз бе?
Dialogue: 0,0:13:52.33,0:13:54.37,Default,,0,0,0,,Егер мен сіздің байланыс ақпаратыңызды сол кезде сұраған болсам...
Dialogue: 0,0:13:54.45,0:13:56.37,Default,,0,0,0,,Неге менен сұрамадың?
Dialogue: 0,0:13:56.46,0:13:58.33,Default,,0,0,0,,Мен... Таңқурай!
Dialogue: 0,0:14:00.25,0:14:02.13,Default,,0,0,0,,Бұл менмін...
Dialogue: 0,0:14:02.21,0:14:06.26,Default,,0,0,0,,Қараңдаршы, мен ол кезде өзімді жасырып жүргенмін.
Dialogue: 0,0:14:08.38,0:14:09.68,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:11.80,0:14:13.06,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,0:14:13.56,0:14:15.98,Default,,0,0,0,,Басынан бастап...?
Dialogue: 0,0:14:17.14,0:14:17.98,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:14:18.56,0:14:20.15,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:14:20.23,0:14:21.36,Default,,0,0,0,,(мысықтар мияулау)
Dialogue: 0,0:14:24.15,0:14:26.78,Default,,0,0,0,,Мақсатты нүктеге жетуге 5 минут қалды
Dialogue: 0,0:14:26.86,0:14:27.74,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:27.82,0:14:28.90,Default,,0,0,0,,Айналаны таза
Dialogue: 0,0:14:28.99,0:14:30.49,Default,,0,0,0,,Әрбір мән Аномалия жоқ
Dialogue: 0,0:14:30.57,0:14:32.83,Default,,0,0,0,,Situmpebaria Ішінара босату туралы сұрау
Dialogue: 0,0:14:32.91,0:14:36.08,Default,,0,0,0,,Сұраныс қабылдау Situmpebaria ішінара босату
Dialogue: 0,0:14:36.16,0:14:39.12,Default,,0,0,0,,Ішінара босату Түсінікті кедергіні босату
Dialogue: 0,0:14:41.71,0:14:43.92,Default,,0,0,0,,Өткізу аяқталды Аномалия жоқ
Dialogue: 0,0:14:44.00,0:14:45.50,Default,,0,0,0,,Situmpevaria қайта орналастыру
Dialogue: 0,0:14:46.09,0:14:48.30,Default,,0,0,0,,Situmpevaria қайта орналастыру
Dialogue: 0,0:14:51.47,0:14:53.80,Default,,0,0,0,,Енді бейбіт келісімге келу
Dialogue: 0,0:14:53.89,0:14:57.27,Default,,0,0,0,,Бірінші бейбіт келісімді талқылау басталады
Dialogue: 0,0:14:57.35,0:15:00.98,Default,,0,0,0,,Алдымен необритания жағынан өз пікіріңізді білдіріңіз.
Dialogue: 0,0:15:02.44,0:15:04.48,Default,,0,0,0,,Олай болса... (Төраға) Кешіріңіз.
Dialogue: 0,0:15:05.23,0:15:08.90,Default,,0,0,0,,Алдымен өз пікірімізді білдірейік.
Dialogue: 0,0:15:08.99,0:15:13.32,Default,,0,0,0,,Хоккайдо алғашында АҚШ-тағы Жапонияның территориясы болды.
Dialogue: 0,0:15:13.91,0:15:16.12,Default,,0,0,0,,Өзін Neo Britannia деп атайтын ұйым арқылы.
Dialogue: 0,0:15:16.20,0:15:20.04,Default,,0,0,0,,Қарулы оккупация болып жатқанын түсінеміз.
Dialogue: 0,0:15:20.66,0:15:24.59,Default,,0,0,0,,Дегенмен, қазіргі тығырыққа тірелген күй ұзақ уақыт бойы жалғасуда.
Dialogue: 0,0:15:24.67,0:15:26.55,Default,,0,0,0,,Біз де болғымыз келетін жерде емес.
Dialogue: 0,0:15:27.55,0:15:29.63,Default,,0,0,0,,Бейбітшілік келісімін қарастырыңыз
Dialogue: 0,0:15:29.72,0:15:33.14,Default,,0,0,0,,Дегенмен, Необритания жағына тиімді шарттар
Dialogue: 0,0:15:33.22,0:15:35.35,Default,,0,0,0,,Бұл мүмкін емес деп есептеңіз.
Dialogue: 0,0:15:36.01,0:15:37.68,Default,,0,0,0,,Сіздің тарапыңызда қандай шарттар бар?
Dialogue: 0,0:15:38.27,0:15:40.73,Default,,0,0,0,,Біздің екі шартымыз бар.
Dialogue: 0,0:15:40.81,0:15:44.90,Default,,0,0,0,,Хоккайдо блогын қарусыздандыру арқылы аумақтық талаптарды қайтарып алу
Dialogue: 0,0:15:44.98,0:15:47.65,Default,,0,0,0,,және қазіргі үкіметтің таратылуы.
Dialogue: 0,0:15:48.23,0:15:50.53,Default,,0,0,0,,Необритания қалай пайда болады?
Dialogue: 0,0:15:51.74,0:15:53.57,Default,,0,0,0,,Тарату
Dialogue: 0,0:15:54.95,0:15:57.91,Default,,0,0,0,,Мен де осы оқиғамен келдім.
Dialogue: 0,0:15:58.87,0:16:01.16,Default,,0,0,0,,Бұрын болған Британдық ұрыс
Dialogue: 0,0:16:01.25,0:16:02.79,Default,,0,0,0,,Қауіпсіздіктің нашарлауы туралы алаңдаушылық
Dialogue: 0,0:16:03.37,0:16:07.21,Default,,0,0,0,,«Британия жағында туындайтын мәселелер» туралы сыпайы болыңыз.
Dialogue: 0,0:16:07.29,0:16:08.30,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:16:08.38,0:16:09.67,Default,,0,0,0,,Иә
Dialogue: 0,0:16:09.76,0:16:11.76,Default,,0,0,0,,Шағымды болжағаннан кейін
Dialogue: 0,0:16:11.84,0:16:14.72,Default,,0,0,0,,Берілген материалдарда олқылықтар жоқ.
Dialogue: 0,0:16:14.80,0:16:18.18,Default,,0,0,0,,Бұл жолағы сынған пішін.
Dialogue: 0,0:16:18.26,0:16:20.27,Default,,0,0,0,,Менің ойымша, бұл бәрі емес.
Dialogue: 0,0:16:20.35,0:16:21.98,Default,,0,0,0,,Иә
Dialogue: 0,0:16:22.06,0:16:26.44,Default,,0,0,0,,Нео-Британдық жағына тиімді шарттар ақылды түрде енгізілді.
Dialogue: 0,0:16:26.52,0:16:29.94,Default,,0,0,0,,Мұны бір қарағанда көру қиын.
Dialogue: 0,0:16:30.69,0:16:31.99,Default,,0,0,0,,Қалай ойлайсың, Джино?
Dialogue: 0,0:16:32.90,0:16:35.32,Default,,0,0,0,,Бұл өте қиын сезінеді.
Dialogue: 0,0:16:35.41,0:16:36.87,Default,,0,0,0,,Мұқият дайындық үшін де солай.
Dialogue: 0,0:16:36.95,0:16:38.95,Default,,0,0,0,,Әңгімелеу өнері де бар.
Dialogue: 0,0:16:40.87,0:16:43.41,Default,,0,0,0,,Қолыңыздан келген қимылдарды жасау керек пе?
Dialogue: 0,0:16:44.25,0:16:47.38,Default,,0,0,0,,(Кэтриннің гуілдеуі)
Dialogue: 0,0:16:49.67,0:16:50.75,Default,,0,0,0,,күрсіну
Dialogue: 0,0:16:51.55,0:16:55.68,Default,,0,0,0,,Олай болса, кешірім сұраймын.
Dialogue: 0,0:16:55.76,0:16:57.68,Default,,0,0,0,,Ым, сәл қарсы болмайсыз ба?
Dialogue: 0,0:16:57.76,0:16:58.85,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:16:59.43,0:17:01.64,Default,,0,0,0,,3-тармақта жазылған ескертулерге қатысты
Dialogue: 0,0:17:02.31,0:17:04.56,Default,,0,0,0,,Алдыңғы сарайда қамауда отырған Лорд Люксембургке...
Dialogue: 0,0:17:04.64,0:17:05.81,Default,,0,0,0,,Мен темекі шегуді тастадым
Dialogue: 0,0:17:05.89,0:17:09.06,Default,,0,0,0,,Менің жұмысым артады, солай ма?
Dialogue: 0,0:17:09.15,0:17:10.98,Default,,0,0,0,,Сіз артық ештеңе жасамайсыз.
Dialogue: 0,0:17:11.07,0:17:13.57,Default,,0,0,0,,Жүйені құрғандай кейіп танытыңыз.
Dialogue: 0,0:17:14.86,0:17:16.11,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:16.70,0:17:20.41,Default,,0,0,0,,Сіз өзіңізден өте алмайсыз. Мен сізден тікелей сұраймын.
Dialogue: 0,0:17:20.49,0:17:22.45,Default,,0,0,0,,Иә? сен не туралы айтып тұрсың
Dialogue: 0,0:17:22.54,0:17:23.41,Default,,0,0,0,,Ей!
Dialogue: 0,0:17:23.50,0:17:25.46,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:28.67,0:17:31.55,Default,,0,0,0,,Бұл сіз айтып отырған күш пе?
Dialogue: 0,0:17:31.63,0:17:35.80,Default,,0,0,0,,Әшекейлер әшекейлер сияқты болуы керек және күштілердің артынан жүруі керек.
Dialogue: 0,0:17:36.38,0:17:37.97,Default,,0,0,0,,Зорлық-зомбылықпен бағындыру
Dialogue: 0,0:17:38.05,0:17:40.64,Default,,0,0,0,,Басқаларға мойынсұну күшті ме?
Dialogue: 0,0:17:40.72,0:17:42.14,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:17:42.22,0:17:44.77,Default,,0,0,0,,Оны еңкейтіп, алып кет
Dialogue: 0,0:17:44.85,0:17:46.35,Default,,0,0,0,,Таза қуат
Dialogue: 0,0:17:47.27,0:17:50.86,Default,,0,0,0,,Бірақ бұл жалғыз күш.
Dialogue: 0,0:17:50.94,0:17:53.15,Default,,0,0,0,,Бұл күш.
Dialogue: 0,0:17:53.23,0:17:56.40,Default,,0,0,0,,Мен нағыз күшті білемін
Dialogue: 0,0:18:00.53,0:18:02.99,Default,,0,0,0,,Бірақ мен әлсіз жақтарын да білемін.
Dialogue: 0,0:18:03.08,0:18:04.58,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:18:04.66,0:18:06.04,Default,,0,0,0,,Әй, не?
Dialogue: 0,0:18:08.33,0:18:11.84,Default,,0,0,0,,Адамдардың әлсіз жақтарын жек көрме
Dialogue: 0,0:18:13.55,0:18:16.55,Default,,0,0,0,,Адамдардың әлсіз жақтарын жек көрме
Dialogue: 0,0:18:24.22,0:18:25.85,Default,,0,0,0,,Мен өлемін...
Dialogue: 0,0:18:27.23,0:18:28.60,Default,,0,0,0,,Әлсіз
Dialogue: 0,0:18:34.53,0:18:37.95,Default,,0,0,0,,Келіссөздердің екінші раунды необританиялық тарапты да алға тартты.
Dialogue: 0,0:18:38.03,0:18:42.62,Default,,0,0,0,,Біріккен елдер пайдалы шарттарды ұсына алмады
Dialogue: 0,0:18:42.70,0:18:44.62,Default,,0,0,0,,Бұл эссе ойыны дерлік.
Dialogue: 0,0:18:44.70,0:18:47.50,Default,,0,0,0,,Бұл оңай емес...
Dialogue: 0,0:18:47.58,0:18:51.58,Default,,0,0,0,,Әй, осылай жалғаса берсе, тек атымен тыныштық болады.
Dialogue: 0,0:18:51.67,0:18:56.09,Default,,0,0,0,,Сіз мені супербіріккен елдердің өкілі ретінде қалпына келтіре аласыз ба?
Dialogue: 0,0:18:56.17,0:18:57.30,Default,,0,0,0,,Кагурая
Dialogue: 0,0:19:13.86,0:19:16.57,Default,,0,0,0,,Кя! (ит үреді)
Dialogue: 0,0:19:30.79,0:19:31.79,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:31.87,0:19:33.46,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:19:33.54,0:19:36.09,Default,,0,0,0,,Әр елмен байланыс үзілді.
Dialogue: 0,0:19:36.17,0:19:37.42,Default,,0,0,0,,Суреттер қосылған ба?
Dialogue: 0,0:19:37.50,0:19:39.09,Default,,0,0,0,,Қазіргі уақытта ақпараттық топ
Dialogue: 0,0:19:39.17,0:19:42.05,Default,,0,0,0,,Әр қаладағы бейнебақылау камераларының жазбаларын талдау
Dialogue: 0,0:19:43.14,0:19:44.89,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:19:44.97,0:19:47.85,Default,,0,0,0,,Біз кадрларды сақтауды аяқтадық.
Dialogue: 0,0:19:47.93,0:19:50.35,Default,,0,0,0,,Сурет сапасы өрескел, бірақ мен оны жариялаймын.
Dialogue: 0,0:19:50.43,0:19:51.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:00.40,0:20:02.40,Default,,0,0,0,,Кескін сапасын біршама жақсарта алмайсыз ба?
Dialogue: 0,0:20:05.91,0:20:06.99,Default,,0,0,0,,Бейнені қайтарыңыз
Dialogue: 0,0:20:07.08,0:20:08.24,Default,,0,0,0,,Иә
Dialogue: 0,0:20:10.70,0:20:13.42,Default,,0,0,0,,Мынау не жігіт...
Dialogue: 0,0:20:16.79,0:20:19.42,Default,,0,0,0,,Аса біртұтас мемлекеттің өкілі ауыстырылды.
Dialogue: 0,0:20:20.59,0:20:22.42,Default,,0,0,0,,Император Кагурая
Dialogue: 0,0:20:22.51,0:20:25.18,Default,,0,0,0,,Мен бұрынғы қарсыластарымдай болмаймын.
Dialogue: 0,0:20:25.26,0:20:27.26,Default,,0,0,0,,Келіссөздер 3 күннен кейін жалғасады...
Dialogue: 0,0:20:27.35,0:20:28.72,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:20:31.14,0:20:32.23,Default,,0,0,0,,Не?
Dialogue: 0,0:20:32.31,0:20:33.60,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:20:36.15,0:20:39.57,Default,,0,0,0,,Көптеген белгісіз ұшақтар ғимаратқа кірді!
Dialogue: 0,0:20:39.65,0:20:41.82,Default,,0,0,0,,Өкілдердің қауіпсіздігін қамтамасыз ету – біздің басты міндетіміз!
Dialogue: 0,0:20:41.90,0:20:43.28,Default,,0,0,0,,Баспана туралы нұсқаулық!
Dialogue: 0,0:20:43.36,0:20:46.62,Default,,0,0,0,,Сұрыптай алатындардың бәрі сұрыптасын!
Dialogue: 0,0:20:48.41,0:20:50.04,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:20:51.08,0:20:53.25,Default,,0,0,0,,Бұл Ноландтың жұмысы ма...
Dialogue: 0,0:20:54.75,0:20:56.71,Default,,0,0,0,,Енді бүгін Киотоға барайық.
Dialogue: 0,0:20:56.79,0:20:58.34,Default,,0,0,0,,Мен Киёмизу-дера храмына барғым келеді
Dialogue: 0,0:20:58.42,0:21:00.59,Default,,0,0,0,,Сіз қанша уақыт серуендейсіз?
Dialogue: 0,0:21:00.67,0:21:05.18,Default,,0,0,0,,Жақсы, мен уәде бойынша Жапонияға келдім.
Dialogue: 0,0:21:05.26,0:21:06.22,Default,,0,0,0,,Акито?
Dialogue: 0,0:21:06.30,0:21:07.72,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:21:08.60,0:21:09.47,Default,,0,0,0,,Не?
Dialogue: 0,0:21:09.55,0:21:10.97,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:21:15.73,0:21:17.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:17.73,0:21:20.36,Default,,0,0,0,,Өте сүйкімді! Мен сені еркелете аламын ба?
Dialogue: 0,0:21:20.44,0:21:21.90,Default,,0,0,0,,Сәлем мысық
Dialogue: 0,0:21:24.99,0:21:26.20,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:33.16,0:21:34.00,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:21:34.08,0:21:35.12,Default,,0,0,0,,Барлығың тынышталыңдар
Dialogue: 0,0:21:35.21,0:21:36.79,Default,,0,0,0,,Сабыр сақтаңыз.
Dialogue: 0,0:21:37.71,0:21:40.29,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:43.21,0:21:44.72,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:44.80,0:21:45.63,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:21:45.72,0:21:47.13,Default,,0,0,0,,Бұл жол жабық!
Dialogue: 0,0:21:47.76,0:21:49.51,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:21:53.02,0:21:54.35,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:21:54.43,0:21:56.14,Default,,0,0,0,,Көптеген оғаш машиналар пайда болды
Dialogue: 0,0:21:56.23,0:21:58.27,Default,,0,0,0,,Көптеген адамдарды өлтіріңіз!
Dialogue: 0,0:21:58.35,0:21:59.77,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:21:59.86,0:22:02.90,Default,,0,0,0,,Сіз кенеттен осындай бірдеңе айтып қалсаңыз да, мен не болғанын білмеймін.
Dialogue: 0,0:22:02.98,0:22:04.32,Default,,0,0,0,,Оған сеніңіз!
Dialogue: 0,0:22:04.40,0:22:07.45,Default,,0,0,0,,Жәндік тәрізді үлкен машина адамдарды жұтады...
Dialogue: 0,0:22:07.53,0:22:09.61,Default,,0,0,0,,Жаңа Nightmare кадры?
Dialogue: 0,0:22:09.70,0:22:11.45,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:22:11.53,0:22:12.74,Default,,0,0,0,,—умеренділермен қақтығысып жатыр.
Dialogue: 0,0:22:13.62,0:22:15.25,Default,,0,0,0,,А... Мэй?
Dialogue: 0,0:22:15.33,0:22:16.75,Default,,0,0,0,,мамыр!
Dialogue: 0,0:22:21.21,0:22:22.09,Default,,0,0,0,,(Монитор: соққы дыбысы)
Dialogue: 0,0:22:22.17,0:22:23.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:24.42,0:22:25.92,Default,,0,0,0,,мамыр!
Dialogue: 0,0:22:27.84,0:22:29.93,Default,,0,0,0,,Неден басталды?
Dialogue: 0,0:22:31.01,0:22:36.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:55.89,0:24:00.89,Default,,0,0,0,,～♪
Dialogue: 0,0:24:02.39,0:24:08.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory