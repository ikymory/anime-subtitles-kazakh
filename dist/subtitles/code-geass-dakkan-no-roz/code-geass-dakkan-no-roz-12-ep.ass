Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.58,0:00:08.80,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:00:16.64,0:00:18.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:18.22,0:00:19.06,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:00:22.77,0:00:24.56,Default,,0,0,0,,Локи көлігі түсірілді
Dialogue: 0,0:00:24.64,0:00:25.56,Default,,0,0,0,,Торпедо дайындау
Dialogue: 0,0:00:31.32,0:00:33.03,Default,,0,0,0,,Локи 50 санына жақындайды
Dialogue: 0,0:00:33.11,0:00:34.24,Default,,0,0,0,,Торпедо ұшыру
Dialogue: 0,0:00:34.32,0:00:35.66,Default,,0,0,0,,Торпедо ұшыру
Dialogue: 0,0:00:43.29,0:00:46.42,Default,,0,0,0,,Торпедоның жарылысы расталды, әлі де көптеген Локилер
Dialogue: 0,0:00:46.50,0:00:49.50,Default,,0,0,0,,Мұнымен көлік кемесін соғуға болмайды.
Dialogue: 0,0:01:00.72,0:01:03.68,Default,,0,0,0,,Мен машиналарға адамдарды өлтіруге рұқсат бере алмаймын.
Dialogue: 0,0:01:03.77,0:01:05.77,Default,,0,0,0,,Елдер Локидің шабуылы
Dialogue: 0,0:01:05.85,0:01:08.27,Default,,0,0,0,,Жағалаудан ішкі аймақтарға таралу
Dialogue: 0,0:01:08.35,0:01:11.19,Default,,0,0,0,,Бұл жаман. Қорғаныс сызығыңызды қайта қарастырыңыз.
Dialogue: 0,0:01:11.86,0:01:15.45,Default,,0,0,0,,Қазіргі күшімізбен қанша уақытқа шыдай аламыз?
Dialogue: 0,0:01:15.53,0:01:16.86,Default,,0,0,0,,Аймаққа байланысты айырмашылықтар болғанымен
Dialogue: 0,0:01:17.57,0:01:19.91,Default,,0,0,0,,Бар болғаны, Nightmare Frame 3 күнде аяқталады.
Dialogue: 0,0:01:19.99,0:01:21.53,Default,,0,0,0,,Ол жойылады деп есептелді.
Dialogue: 0,0:01:21.62,0:01:24.62,Default,,0,0,0,,Бұл біздің жеңу мүмкіндігіміз жоқ дегенді білдіреді.
Dialogue: 0,0:01:24.70,0:01:26.08,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:01:26.16,0:01:29.04,Default,,0,0,0,,Дүние тек бір адамның жоспарымен жойылуы мүмкін.
Dialogue: 0,0:01:29.13,0:01:30.59,Default,,0,0,0,,Мен қабылдай алмаймын
Dialogue: 0,0:01:30.67,0:01:33.17,Default,,0,0,0,,Мен толықтай келісемін.
Dialogue: 0,0:01:33.96,0:01:37.80,Default,,0,0,0,,Шикаши бірінен соң бірі аяқталмай
Dialogue: 0,0:01:37.88,0:01:40.01,Default,,0,0,0,,Локи, тағы да келдің бе?
Dialogue: 0,0:01:40.10,0:01:41.89,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:01:41.97,0:01:44.97,Default,,0,0,0,,Біз Ноландты тез жеңіп, бұл жігіттерді тоқтатуымыз керек.
Dialogue: 0,0:01:45.06,0:01:48.44,Default,,0,0,0,,Біз адамдар жер бетінен жойыламыз.
Dialogue: 0,0:01:50.31,0:01:53.36,Default,,0,0,0,,Жер тазартылуда
Dialogue: 0,0:01:55.07,0:01:57.57,Default,,0,0,0,,Шынымен сергітеді
Dialogue: 0,0:01:58.61,0:02:03.91,Default,,0,0,0,,Осы бақытты сәттен бір сәт ләззат алайық.
Dialogue: 0,0:02:03.99,0:02:09.00,Default,,0,0,0,,♪～
Dialogue: 0,0:03:29.87,0:03:33.92,Default,,0,0,0,,～♪
Dialogue: 0,0:03:41.09,0:03:42.01,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:03:42.09,0:03:45.30,Default,,0,0,0,,Жарайды, 30 минуттан кейін бастаңыз.
Dialogue: 0,0:03:46.43,0:03:51.02,Default,,0,0,0,,Кагуя Кагуяның мәлімдемесі негізгі конференц-залда өтеді.
Dialogue: 0,0:03:51.10,0:03:52.60,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:57.94,0:04:02.95,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:04:12.54,0:04:16.58,Default,,0,0,0,,(машинаның өшіп жатқан дыбысы)
Dialogue: 0,0:04:16.67,0:04:18.04,Default,,0,0,0,,Білемін, білемін!
Dialogue: 0,0:04:19.21,0:04:20.42,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:22.34,0:04:24.84,Default,,0,0,0,,Әлі де оның қолында
Dialogue: 0,0:04:30.01,0:04:30.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:32.93,0:04:34.02,Default,,0,0,0,,Күл
Dialogue: 0,0:04:42.90,0:04:44.95,Default,,0,0,0,,Амансың ба? Эй
Dialogue: 0,0:04:45.66,0:04:47.87,Default,,0,0,0,,Күл, сен мені естисің бе?
Dialogue: 0,0:04:47.95,0:04:49.28,Default,,0,0,0,,Күл!
Dialogue: 0,0:04:51.83,0:04:52.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:58.54,0:05:01.46,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:05:02.67,0:05:07.05,Default,,0,0,0,,Хмф, ештеңе өзгермейді.
Dialogue: 0,0:05:12.52,0:05:13.35,Default,,0,0,0,,(Кокпиттің ашылу дыбысы)
Dialogue: 0,0:05:17.31,0:05:19.40,Default,,0,0,0,,Аш, жақсысың ба?
Dialogue: 0,0:05:20.57,0:05:21.77,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:22.48,0:05:24.15,Default,,0,0,0,,…
Dialogue: 0,0:05:24.24,0:05:26.53,Default,,0,0,0,,Аполлонды іске қосу мүмкін болмаса
Dialogue: 0,0:05:26.61,0:05:28.07,Default,,0,0,0,,Мен Артемида ретінде көрінемін...
Dialogue: 0,0:05:28.16,0:05:31.08,Default,,0,0,0,,Жоқ, мен сені жібере алмаймын.
Dialogue: 0,0:05:31.16,0:05:32.99,Default,,0,0,0,,Әкеңе берген уәдең үшін бе?
Dialogue: 0,0:05:35.29,0:05:38.12,Default,,0,0,0,,Сіз мені жақсы қорғадыңыз.
Dialogue: 0,0:05:38.21,0:05:39.58,Default,,0,0,0,,Енді сіз...
Dialogue: 0,0:05:39.67,0:05:43.09,Default,,0,0,0,,Жоқ, мен барлығын қорғағым келеді.
Dialogue: 0,0:05:44.67,0:05:46.59,Default,,0,0,0,,Сакураға көмектесу үшін——
Dialogue: 0,0:05:46.67,0:05:48.22,Default,,0,0,0,,Біз осы уақытқа дейін күрестік
Dialogue: 0,0:05:49.68,0:05:54.06,Default,,0,0,0,,Мен мұны істеуге күшім мен шешімім бар деп ойладым.
Dialogue: 0,0:05:54.68,0:05:58.85,Default,,0,0,0,,Дегенмен, мен бұл қуатты қалай пайдалану керектігін дұрыс түсінбедім.
Dialogue: 0,0:06:00.23,0:06:05.19,Default,,0,0,0,,Ол тек өз күшіне сүйеніп, көп адамды құрбандыққа шалды.
Dialogue: 0,0:06:05.94,0:06:07.36,Default,,0,0,0,,Мен мұны түсінбедім.
Dialogue: 0,0:06:08.74,0:06:11.70,Default,,0,0,0,,Мені әу бастан қорғаған
Dialogue: 0,0:06:12.58,0:06:14.33,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:06:14.41,0:06:17.41,Default,,0,0,0,,Мен бастаған жекпе-жек үшін өз жауапкершілігімді орындау
Dialogue: 0,0:06:17.50,0:06:19.42,Default,,0,0,0,,Барлығын қорғаңыз
Dialogue: 0,0:06:20.83,0:06:22.75,Default,,0,0,0,,Бірінші, Күл
Dialogue: 0,0:06:23.34,0:06:25.80,Default,,0,0,0,,Мен сені қорғауға рұқсат етемін
Dialogue: 0,0:06:34.35,0:06:35.52,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:06:36.93,0:06:38.56,Default,,0,0,0,,Мен саған бір нәрсе сұрағым келеді
Dialogue: 0,0:06:40.81,0:06:42.27,Default,,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:06:42.98,0:06:44.69,Default,,0,0,0,,Геассты маған тағы да лақтырыңыз.
Dialogue: 0,0:06:45.57,0:06:48.15,Default,,0,0,0,,А... Не айттың...
Dialogue: 0,0:06:48.24,0:06:51.66,Default,,0,0,0,,Оған қолданылған Геассты Арнольд сындырды.
Dialogue: 0,0:06:51.74,0:06:53.91,Default,,0,0,0,,Сізге қайта қоңырау шала аламын ба?
Dialogue: 0,0:06:54.49,0:06:55.99,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:56.95,0:06:59.21,Default,,0,0,0,,Мүмкін болуы мүмкін, бірақ
Dialogue: 0,0:06:59.96,0:07:03.00,Default,,0,0,0,,Мен саған Геассты қайта қолданғым келмейді.
Dialogue: 0,0:07:03.08,0:07:05.42,Default,,0,0,0,,Мен сізді осы күшпен басқара аламын ...
Dialogue: 0,0:07:05.50,0:07:07.42,Default,,0,0,0,,Қазір маған керегі осы
Dialogue: 0,0:07:08.71,0:07:11.01,Default,,0,0,0,,Сіз Ноландты жеңе алмайсыз.
Dialogue: 0,0:07:11.09,0:07:12.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:12.51,0:07:13.34,Default,,0,0,0,,Және…
Dialogue: 0,0:07:14.18,0:07:16.89,Default,,0,0,0,,Мен Ноландты жалғыз жеңе алмадым.
Dialogue: 0,0:07:18.43,0:07:21.27,Default,,0,0,0,,Николь де, Джуго-сан да
Dialogue: 0,0:07:21.89,0:07:24.27,Default,,0,0,0,,Ол кезде мен сені қорғай алмадым.
Dialogue: 0,0:07:26.86,0:07:28.07,Default,,0,0,0,,Мен үшін де солай
Dialogue: 0,0:07:29.03,0:07:32.99,Default,,0,0,0,,Мен де біреуді қорғай алатын адам болғым келеді.
Dialogue: 0,0:07:33.49,0:07:36.99,Default,,0,0,0,,Мен бұл үшін өзімді беруге дайынмын.
Dialogue: 0,0:07:38.29,0:07:42.17,Default,,0,0,0,,Егер сіз де осы шайқасты аяқтауға бел бусаңыз.
Dialogue: 0,0:07:42.25,0:07:44.25,Default,,0,0,0,,Сол жүкті иығыңда көтер
Dialogue: 0,0:07:44.33,0:07:47.80,Default,,0,0,0,,Гиссті сізге түсіру деген осы.
Dialogue: 0,0:07:48.38,0:07:49.59,Default,,0,0,0,,О
Dialogue: 0,0:07:49.67,0:07:51.05,Default,,0,0,0,,Геастың күші
Dialogue: 0,0:07:51.13,0:07:53.63,Default,,0,0,0,,Сіздің ниетіңіз бен сеніміңіз
Dialogue: 0,0:07:53.72,0:07:56.72,Default,,0,0,0,,Тіпті естеліктерді де қайта жазуға болады.
Dialogue: 0,0:07:56.80,0:07:58.43,Default,,0,0,0,,Сонда да... маңызды емес.
Dialogue: 0,0:07:58.51,0:08:00.43,Default,,0,0,0,,Егер сіз Geass қолданбасын қолдансаңыз
Dialogue: 0,0:08:00.52,0:08:01.52,Default,,0,0,0,,Екінші форма: Суиша!
Dialogue: 0,0:08:01.60,0:08:04.90,Default,,0,0,0,,Мен бастапқы Эш Феникске орала алмауым мүмкін.
Dialogue: 0,0:08:05.94,0:08:07.32,Default,,0,0,0,,Әлі де
Dialogue: 0,0:08:09.28,0:08:11.44,Default,,0,0,0,,Өмір бойы Гиастың қарғысына шыда...
Dialogue: 0,0:08:11.53,0:08:12.61,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:12.70,0:08:13.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:15.07,0:08:15.91,Default,,0,0,0,,Қарғыс емес
Dialogue: 0,0:08:16.57,0:08:17.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:18.70,0:08:20.33,Default,,0,0,0,,Бұл ант
Dialogue: 0,0:08:21.33,0:08:23.62,Default,,0,0,0,,Мен де сенің жауапкершілігіңді аламын.
Dialogue: 0,0:08:23.71,0:08:27.54,Default,,0,0,0,,Сондықтан менің де шешімімді көтергеніңізді қалаймын.
Dialogue: 0,0:08:28.67,0:08:30.21,Default,,0,0,0,,Сумераги шумераги сакуя
Dialogue: 0,0:08:30.30,0:08:33.01,Default,,0,0,0,,Менімен соңына дейін күрес.
Dialogue: 0,0:08:45.81,0:08:47.94,Default,,0,0,0,,Император Сакуя бұйрық береді
Dialogue: 0,0:08:48.02,0:08:49.77,Default,,0,0,0,,Күлді Феникс
Dialogue: 0,0:08:49.86,0:08:54.07,Default,,0,0,0,,Менің рыцарым ретінде Ноландқа қарсы бірге шайқас.
Dialogue: 0,0:08:54.15,0:08:58.95,Default,,0,0,0,,Ал біз міндетті түрде жеңеміз, әлемді қорғау үшін.
Dialogue: 0,0:09:10.00,0:09:12.63,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:09:17.13,0:09:18.93,Default,,0,0,0,,Қазіргі уақытта біз
Dialogue: 0,0:09:19.01,0:09:21.47,Default,,0,0,0,,Бұрын-соңды болмаған қауіп астында
Dialogue: 0,0:09:22.06,0:09:27.10,Default,,0,0,0,,Он мыңдаған, жүздеген мың адам өлді.
Dialogue: 0,0:09:27.19,0:09:33.11,Default,,0,0,0,,Әрине, біртұтас ел ретінде біз бұған назар аудара алмаймыз.
Dialogue: 0,0:09:33.78,0:09:37.95,Default,,0,0,0,,Әртүрлі елдердегі адамдарға шабуыл жасайтын қарудың аты - Локи.
Dialogue: 0,0:09:38.03,0:09:42.49,Default,,0,0,0,,Оның өндірісін басқаратын және оны жалғыз басқаратын шебер бар.
Dialogue: 0,0:09:42.58,0:09:45.50,Default,,0,0,0,,Ноланд фон Люнеберг
Dialogue: 0,0:09:45.58,0:09:48.12,Default,,0,0,0,,Локиді тоқтатудың бір ғана жолы бар
Dialogue: 0,0:09:48.21,0:09:50.21,Default,,0,0,0,,Байланыстырылған және синхрондалған——
Dialogue: 0,0:09:50.29,0:09:54.51,Default,,0,0,0,,Ноландтың Nightmare Frame Foulbout-ын жеңіңіз
Dialogue: 0,0:09:55.17,0:09:59.51,Default,,0,0,0,,Қазіргі уақытта Ноландқа қарсы қозғалыстар да реттелген.
Dialogue: 0,0:09:59.59,0:10:03.01,Default,,0,0,0,,Барлығыңыз, осы шайқас аяқталғанша өтінемін.
Dialogue: 0,0:10:03.10,0:10:05.73,Default,,0,0,0,,Міндетті түрде аман қал
Dialogue: 0,0:10:07.35,0:10:09.90,Default,,0,0,0,,Артемидамен энергия бөлісу аяқталды.
Dialogue: 0,0:10:09.98,0:10:12.82,Default,,0,0,0,,Түсінді, қайта бастаңыз
Dialogue: 0,0:10:17.90,0:10:19.95,Default,,0,0,0,,Сәтті қайта жүктеу
Dialogue: 0,0:10:20.03,0:10:21.62,Default,,0,0,0,,Қондыру
Dialogue: 0,0:10:21.70,0:10:22.74,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:23.45,0:10:24.66,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:10:41.59,0:10:44.39,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:10:47.85,0:10:48.68,Default,,0,0,0,,Хун
Dialogue: 0,0:10:49.94,0:10:52.69,Default,,0,0,0,,Сіз сөгіссіз келдіңіз бе?
Dialogue: 0,0:11:00.49,0:11:03.45,Default,,0,0,0,,Күлді шақыру желісі құпия режимде
Dialogue: 0,0:11:03.53,0:11:04.62,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:05.28,0:11:06.62,Default,,0,0,0,,Режимді өзгерту аяқталды
Dialogue: 0,0:11:06.70,0:11:07.54,Default,,0,0,0,,Қате жекпе-жек
Dialogue: 0,0:11:07.62,0:11:10.54,Default,,0,0,0,,Оның жүйесі Шитумпебария сияқты, солай ма?
Dialogue: 0,0:11:10.62,0:11:14.13,Default,,0,0,0,,Иә және кем дегенде 10 инъекция порты бар.
Dialogue: 0,0:11:14.21,0:11:15.50,Default,,0,0,0,,10…
Dialogue: 0,0:11:15.59,0:11:18.34,Default,,0,0,0,,Алдымен инъекция портын тексеру керек.
Dialogue: 0,0:11:18.42,0:11:20.17,Default,,0,0,0,,Менің қозғалыстарымның үлгісі бар.
Dialogue: 0,0:11:20.26,0:11:21.55,Default,,0,0,0,,Ноланд оқыған
Dialogue: 0,0:11:21.63,0:11:24.60,Default,,0,0,0,,Содан кейін қозғалыс үлгісін жіберемін
Dialogue: 0,0:11:24.68,0:11:26.43,Default,,0,0,0,,Оны сызып, жылжытыңыз
Dialogue: 0,0:11:26.51,0:11:27.64,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:28.22,0:11:31.27,Default,,0,0,0,,Ортегерді басқаруды сізге қалдырамын.
Dialogue: 0,0:11:31.35,0:11:32.60,Default,,0,0,0,,Есте сақтау
Dialogue: 0,0:11:32.69,0:11:35.31,Default,,0,0,0,,Деректерді алғанша кез келген уақытта шарлауды қалаймын.
Dialogue: 0,0:11:35.40,0:11:36.23,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:44.53,0:11:45.70,Default,,0,0,0,,Келесі
Dialogue: 0,0:11:45.78,0:11:47.20,Default,,0,0,0,,Иә
Dialogue: 0,0:11:48.87,0:11:51.21,Default,,0,0,0,,Ұшқыш өзгерді ме?
Dialogue: 0,0:11:51.29,0:11:55.71,Default,,0,0,0,,Жоқ, Күлдің қозғалыс үлгісі әлі де сақталады.
Dialogue: 0,0:11:55.79,0:11:59.21,Default,,0,0,0,,Егер солай болса, сізді навигациялауда тұрғандай сезінесіз бе?
Dialogue: 0,0:11:59.30,0:12:00.13,Default,,0,0,0,,Күл
Dialogue: 0,0:12:00.21,0:12:01.97,Default,,0,0,0,,Мен деректерді алдым.
Dialogue: 0,0:12:02.05,0:12:03.05,Default,,0,0,0,,Бір рет тартыңыз
Dialogue: 0,0:12:03.13,0:12:04.51,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:04.59,0:12:07.18,Default,,0,0,0,,Барлығы 14 сәулелік іске қосу порты бар.
Dialogue: 0,0:12:07.26,0:12:09.06,Default,,0,0,0,,Соқыр нүктелер дерлік жоқ
Dialogue: 0,0:12:09.14,0:12:12.14,Default,,0,0,0,,Мен бір уақытта екі жерге дейін ату мүмкіндігін алғым келеді.
Dialogue: 0,0:12:12.23,0:12:14.19,Default,,0,0,0,,Содан кейін кез келген позициядан
Dialogue: 0,0:12:14.27,0:12:15.40,Default,,0,0,0,,Жалтаруға болады
Dialogue: 0,0:12:15.48,0:12:17.48,Default,,0,0,0,,Мәселе сізде бар қаруда.
Dialogue: 0,0:12:17.57,0:12:20.57,Default,,0,0,0,,Сіз жақындамайынша зақым келтіре алмайсыз.
Dialogue: 0,0:12:20.65,0:12:23.78,Default,,0,0,0,,Ағымдағы жағдай Біз қаншалықты жақындай алатынымызды көруге тырысуымыз керек пе?
Dialogue: 0,0:12:23.86,0:12:24.74,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:24.82,0:12:26.99,Default,,0,0,0,,Навигацияны да түсініңіз
Dialogue: 0,0:12:37.21,0:12:40.42,Default,,0,0,0,,Қарғыс атсын... Амансың ба, Сакуя-сан?
Dialogue: 0,0:12:41.92,0:12:43.30,Default,,0,0,0,,Сакуя-сан?
Dialogue: 0,0:12:43.38,0:12:45.26,Default,,0,0,0,,Сакуя, жақсысың ба!?
Dialogue: 0,0:12:46.68,0:12:47.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:48.80,0:12:51.72,Default,,0,0,0,,Кешіріңіз, мен ес-түссіз жатырмын...
Dialogue: 0,0:12:59.44,0:13:03.65,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:13:06.16,0:13:07.66,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:13:08.41,0:13:10.45,Default,,0,0,0,,Мен ол адамды жеңе алмаймын.
Dialogue: 0,0:13:10.53,0:13:11.95,Default,,0,0,0,,Жұтылып қалмаңыз
Dialogue: 0,0:13:12.54,0:13:13.75,Default,,0,0,0,,Біз жеңілмейміз
Dialogue: 0,0:13:15.79,0:13:17.96,Default,,0,0,0,,Сен қазір не білесің?
Dialogue: 0,0:13:18.04,0:13:21.75,Default,,0,0,0,,Сіздің қозғалыстарыңызға реакция жылдамдығы өте жылдам.
Dialogue: 0,0:13:21.84,0:13:24.34,Default,,0,0,0,,Бұл жай ғана жоғары өнімділік пе немесе
Dialogue: 0,0:13:24.42,0:13:28.05,Default,,0,0,0,,Қондырғы кадрын ешбір кіріс қозғалыссыз, тек ойлармен басқару.
Dialogue: 0,0:13:28.14,0:13:31.26,Default,,0,0,0,,Олай болса, реакция жылдамдығын арттыра аламыз.
Dialogue: 0,0:13:31.35,0:13:33.56,Default,,0,0,0,,Сәлем, Фоулбут.
Dialogue: 0,0:13:33.64,0:13:35.98,Default,,0,0,0,,Ақпаратты енгізуді өшіре алсаңыз
Dialogue: 0,0:13:36.06,0:13:38.69,Default,,0,0,0,,Біз өз тарапымызға шабуыл жасау үшін саңылау жасай аламыз ба?
Dialogue: 0,0:13:38.77,0:13:39.61,Default,,0,0,0,,Б-бірақ егер бұл орын түсіп қалса…
Dialogue: 0,0:13:40.19,0:13:42.32,Default,,0,0,0,,Сакурадит стандарттарына негізделген есептеу
Dialogue: 0,0:13:42.40,0:13:46.32,Default,,0,0,0,,Егер сіз сәулені 60 секунд бойы атуды жалғастырсаңыз, үздіксіз ату мүмкін болмайды.
Dialogue: 0,0:13:46.90,0:13:50.16,Default,,0,0,0,,Олай болса, оны жақын арадағы шабуыл ретінде пайдалануға болады.
Dialogue: 0,0:13:50.24,0:13:53.33,Default,,0,0,0,,Ortegear жүйесінде Megisthus Zeta режиміне кіріңіз
Dialogue: 0,0:13:53.41,0:13:54.54,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:58.83,0:13:59.96,Default,,0,0,0,,Хо
Dialogue: 0,0:14:00.54,0:14:02.34,Default,,0,0,0,,Сіз бірдеңе істейсіз бе?
Dialogue: 0,0:14:05.34,0:14:06.67,Default,,0,0,0,,Түнгі көрініс туралы не деуге болады?
Dialogue: 0,0:14:06.76,0:14:07.97,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:14:08.05,0:14:09.43,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:09.51,0:14:12.60,Default,,0,0,0,,Әр 10 секунд сайын шарлау және кері санақ Сұраныс
Dialogue: 0,0:14:12.68,0:14:13.97,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:14.81,0:14:16.23,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:14:17.56,0:14:19.69,Default,,0,0,0,,Кері санаққа 3 секунд қалғанда
Dialogue: 0,0:14:19.77,0:14:22.94,Default,,0,0,0,,2 1 Бастау
Dialogue: 0,0:14:26.99,0:14:28.07,Default,,0,0,0,,Келесі
Dialogue: 0,0:14:31.99,0:14:33.41,Default,,0,0,0,,50 қалды
Dialogue: 0,0:14:40.79,0:14:41.83,Default,,0,0,0,,Келесі
Dialogue: 0,0:14:43.92,0:14:45.09,Default,,0,0,0,,40 қалды
Dialogue: 0,0:14:46.88,0:14:47.92,Default,,0,0,0,,Келесі
Dialogue: 0,0:14:55.39,0:14:56.81,Default,,0,0,0,,30 қалды
Dialogue: 0,0:15:02.44,0:15:03.65,Default,,0,0,0,,Келесі
Dialogue: 0,0:15:06.32,0:15:07.69,Default,,0,0,0,,20 қалды
Dialogue: 0,0:15:09.28,0:15:10.61,Default,,0,0,0,,Келесі
Dialogue: 0,0:15:17.04,0:15:22.12,Default,,0,0,0,,Қалған 10 9 8 7 6
Dialogue: 0,0:15:22.21,0:15:27.34,Default,,0,0,0,,５ ４ ３ ２ １
Dialogue: 0,0:15:27.42,0:15:28.71,Default,,0,0,0,,Өрттің жылдамдығы қандай?
Dialogue: 0,0:15:28.80,0:15:30.51,Default,,0,0,0,,47% төмендеді
Dialogue: 0,0:15:30.59,0:15:31.68,Default,,0,0,0,,Бар
Dialogue: 0,0:15:35.05,0:15:37.68,Default,,0,0,0,,Өрт жылдамдығы 50%-ға төмендеді
Dialogue: 0,0:15:37.77,0:15:39.18,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:40.18,0:15:42.14,Default,,0,0,0,,Енді бұл мат!
Dialogue: 0,0:15:48.98,0:15:50.57,Default,,0,0,0,,Бас тарту?
Dialogue: 0,0:15:52.40,0:15:54.03,Default,,0,0,0,,ақымақ
Dialogue: 0,0:15:59.41,0:16:00.83,Default,,0,0,0,,Бұл жалған ба?
Dialogue: 0,0:16:03.25,0:16:04.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:10.42,0:16:11.38,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:30.99,0:16:32.53,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,0:16:34.41,0:16:39.41,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:16:48.92,0:16:49.75,Default,,0,0,0,,(♪ «Twinkle, Twinkle, Little Star» әніне варияциялар»)
Dialogue: 0,0:16:49.84,0:16:54.13,Default,,0,0,0,,Біз Ноландты жеңе алдық.
Dialogue: 0,0:16:54.76,0:16:55.76,Default,,0,0,0,,О
Dialogue: 0,0:16:57.18,0:17:01.27,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:17:04.77,0:17:07.48,Default,,0,0,0,,А... Күл?
Dialogue: 0,0:17:07.56,0:17:09.40,Default,,0,0,0,,Егер біз энергияны бөлісуді жалғастырсақ
Dialogue: 0,0:17:09.48,0:17:11.65,Default,,0,0,0,,Жерге оралу үшін шыдамаймын
Dialogue: 0,0:17:11.73,0:17:13.90,Default,,0,0,0,,Сізде әлі жұмыс бар.
Dialogue: 0,0:17:13.99,0:17:15.03,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:14.36,0:17:16.66,Default,,0,0,0,,Ноланд мақтаншақ адам.
Dialogue: 0,0:17:17.20,0:17:20.16,Default,,0,0,0,,Жеңілген өзіңнен қалғанның бәрін өшіру керек.
Dialogue: 0,0:17:21.16,0:17:25.00,Default,,0,0,0,,Мен сені бұған араластыруға шыдай алмаймын.
Dialogue: 0,0:17:25.08,0:17:27.88,Default,,0,0,0,,Онда сен... Бұл жақсы.
Dialogue: 0,0:17:28.67,0:17:30.42,Default,,0,0,0,,Бұл ең жақсысы
Dialogue: 0,0:17:33.55,0:17:36.18,Default,,0,0,0,,(Күлдің жылағаны)
Dialogue: 0,0:17:36.26,0:17:40.64,Default,,0,0,0,,Енді мен Джуго-санның сезімін түсіндім.
Dialogue: 0,0:17:41.97,0:17:44.60,Default,,0,0,0,,Мен өлуден қорықпаймын
Dialogue: 0,0:17:46.19,0:17:49.61,Default,,0,0,0,,Мен сені енді көре алмаймын деген ойдың өзі ауырады.
Dialogue: 0,0:17:50.31,0:17:52.98,Default,,0,0,0,,Бұл өте қиын...
Dialogue: 0,0:17:53.07,0:17:54.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:05.29,0:18:12.04,Default,,0,0,0,,(Сакуяның жылағаны)
Dialogue: 0,0:18:31.56,0:18:34.11,Default,,0,0,0,,Жарайды, бүгін жолға шығайық! (Бала) Бүгін мен батырмын~
Dialogue: 0,0:18:34.19,0:18:37.24,Default,,0,0,0,,Ей, алысқа барма.
Dialogue: 0,0:18:37.78,0:18:39.70,Default,,0,0,0,,Ум... иә?
Dialogue: 0,0:18:39.78,0:18:42.95,Default,,0,0,0,,Маған осында жұмыс істеуге рұқсат бере аласыз ба?
Dialogue: 0,0:18:43.03,0:18:46.37,Default,,0,0,0,,А... тыңдайық.
Dialogue: 0,0:18:46.45,0:18:48.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:53.00,0:18:55.42,Default,,0,0,0,,Көптеген адамдар өлген күннен бастап
Dialogue: 0,0:18:55.50,0:18:57.55,Default,,0,0,0,,Бірнеше ай өтті, әлі де
Dialogue: 0,0:18:57.63,0:19:02.55,Default,,0,0,0,,Локи келтірген залалды қалпына келтіру бүкіл әлемде жүріп жатыр.
Dialogue: 0,0:19:03.14,0:19:07.06,Default,,0,0,0,,Бұл естелік, екі аты жоқ жалдамалы Йохеи қорғаған ертеңгі күн.
Dialogue: 0,0:19:07.14,0:19:09.94,Default,,0,0,0,,Біз ешқашан ұмытпаймыз
Dialogue: 0,0:19:10.02,0:19:13.69,Default,,0,0,0,,Біз болашақта тыныштықта өмір сүруіміз керек.
Dialogue: 0,0:19:14.23,0:19:17.61,Default,,0,0,0,,Ал бүгін сол татулықтың белгісі ретінде
Dialogue: 0,0:19:17.69,0:19:21.28,Default,,0,0,0,,Біріктірілген елдердің юрисдикциясындағы Жаңа Хоккайдо блогы
Dialogue: 0,0:19:21.36,0:19:24.32,Default,,0,0,0,,Оны ерекше автономиялы облыс ету туралы шешім қабылданды.
Dialogue: 0,0:19:25.12,0:19:27.33,Default,,0,0,0,,Бұдан былай автономиялық облыстың бірінші өкілі
Dialogue: 0,0:19:27.41,0:19:29.16,Default,,0,0,0,,Император Сакуямен
Dialogue: 0,0:19:27.41,0:19:30.54,Default,,0,0,0,,Бұл соғыстан кейінгі жағдайды уақытша шешеді.
Dialogue: 0,0:19:29.25,0:19:32.00,Default,,0,0,0,,Өзара жағымды болашаққа
Dialogue: 0,0:19:30.62,0:19:32.54,Default,,0,0,0,,Саяси жағына келсек...
Dialogue: 0,0:19:32.08,0:19:35.13,Default,,0,0,0,,Шешу жолдарын талқылаймыз.
Dialogue: 0,0:19:32.62,0:19:33.88,Default,,0,0,0,,Я...
Dialogue: 0,0:19:33.96,0:19:37.38,Default,,0,0,0,,Ал біз бүгін тағы да әлемді тазартамыз.
Dialogue: 0,0:19:37.46,0:19:41.13,Default,,0,0,0,,Бұл біздің Қара Рыцарлар ретіндегі рөліміз.
Dialogue: 0,0:19:41.84,0:19:43.47,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:43.55,0:19:45.89,Default,,0,0,0,,♪～
Dialogue: 0,0:19:46.76,0:19:48.14,Default,,0,0,0,,Екінші лейтенант Минато Сакай
Dialogue: 0,0:19:48.22,0:19:51.69,Default,,0,0,0,,Бүгіннен бастап мен бастапқы бірлікке оралдым.
Dialogue: 0,0:19:51.77,0:19:52.64,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:19:52.73,0:19:54.40,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:19:54.48,0:19:55.77,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:19:56.36,0:19:59.69,Default,,0,0,0,,Бұрынғы жеті жұлдыз кластері Шичико Сейданның техникалық қызмет көрсету бөлімінің қызметкері Юрий Сано
Dialogue: 0,0:19:59.78,0:20:02.65,Default,,0,0,0,,Мен Қара Рыцарларға қосылғым келеді!
Dialogue: 0,0:20:03.36,0:20:05.24,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:05.91,0:20:09.29,Default,,0,0,0,,Сано-чан, жұмысыңды ауыстырғаныңа қуаныштымын.
Dialogue: 0,0:20:09.37,0:20:12.41,Default,,0,0,0,,Бейбіт әлемде қарсылықтың қажеті жоқ.
Dialogue: 0,0:20:12.50,0:20:15.33,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:20:15.42,0:20:16.71,Default,,0,0,0,,Бәрі де болады.
Dialogue: 0,0:20:16.79,0:20:17.96,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:18.05,0:20:21.30,Default,,0,0,0,,Ал, әзірше, бүгін көп ішейік!
Dialogue: 0,0:20:21.38,0:20:23.88,Default,,0,0,0,,Маған сенің сүйкімділігің ұнамайды, сондықтан мен өтемін.
Dialogue: 0,0:20:23.97,0:20:25.80,Default,,0,0,0,,Мен кәмелетке толмағанмын, сондықтан өтемін
Dialogue: 0,0:20:25.89,0:20:27.89,Default,,0,0,0,,Сіз байсалдысыз ба? ол
Dialogue: 0,0:20:28.68,0:20:29.81,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:20:29.89,0:20:31.27,Default,,0,0,0,,Иә
Dialogue: 0,0:20:32.10,0:20:34.39,Default,,0,0,0,,Анаңмен не туралы сөйлестің?
Dialogue: 0,0:20:34.48,0:20:38.40,Default,,0,0,0,,Иә? Хехе, бұл әкеңнің құпиясы ғой.
Dialogue: 0,0:20:38.48,0:20:41.32,Default,,0,0,0,,Не? Тіпті біреудің мұны істеуі мүмкін болды ма?
Dialogue: 0,0:20:41.40,0:20:44.57,Default,,0,0,0,,Ей... сен қашан "мен сені сүйемін" дедің?
Dialogue: 0,0:20:45.78,0:20:47.62,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:20:49.28,0:20:52.12,Default,,0,0,0,,Бүгін жаңа автономиялық аймақтың бірінші императоры.
Dialogue: 0,0:20:52.20,0:20:53.21,Default,,0,0,0,,Сакуя Сумераги мен Британия...
Dialogue: 0,0:20:53.29,0:20:54.83,Default,,0,0,0,,Бүгін сағат 19.00-ден бастап
Dialogue: 0,0:20:54.92,0:20:57.13,Default,,0,0,0,,Сакуя Сумераги мен Британ императоры
Dialogue: 0,0:20:57.21,0:20:59.80,Default,,0,0,0,,Күтілетін ұстаным туралы мәлімдеме
Dialogue: 0,0:21:07.47,0:21:09.85,Default,,0,0,0,,Император Сакуяға бұйрық
Dialogue: 0,0:21:09.93,0:21:12.06,Default,,0,0,0,,Геастың күшін жою үшін
Dialogue: 0,0:21:12.14,0:21:15.73,Default,,0,0,0,,Өмір бойы дыбыс шығара алмайсың
Dialogue: 0,0:21:23.32,0:21:25.65,Default,,0,0,0,,Бұл менің шешімім
Dialogue: 0,0:21:28.82,0:21:31.08,Default,,0,0,0,,Құрметті Сакуя, уақыт келді.
Dialogue: 0,0:21:34.16,0:21:38.04,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:23:18.85,0:23:23.86,Default,,0,0,0,,～♪
Dialogue: 0,0:23:25.23,0:23:27.61,Default,,0,0,0,,Кофе жақсы болды ма?
Dialogue: 0,0:23:29.69,0:23:32.82,Default,,0,0,0,,Ол балалар әрқашан Сакуя-самамен бірге.
Dialogue: 0,0:23:32.91,0:23:34.37,Default,,0,0,0,,Няа~
Dialogue: 0,0:23:34.87,0:23:37.79,Default,,0,0,0,,Біз бір отбасы сияқтымыз.
Dialogue: 0,0:23:45.46,0:23:50.26,Default,,0,0,0,,Артында қалдырған орны толмас отбасы
Dialogue: 0,0:23:54.64,0:23:55.80,Default,,0,0,0,,Барлығы жақсы.
Dialogue: 0,0:23:57.22,0:23:58.52,Default,,0,0,0,,Күл
Dialogue: 0,0:24:00.02,0:24:06.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory