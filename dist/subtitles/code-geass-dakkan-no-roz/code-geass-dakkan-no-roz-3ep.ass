Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.04,0:00:07.21,Default,,0,0,0,,Майор… Майор Гилберт
Dialogue: 0,0:00:07.29,0:00:09.50,Default,,0,0,0,,Белсенді Nightmare шайқасы!
Dialogue: 0,0:00:19.85,0:00:22.35,Default,,0,0,0,,Ғұн, оған тұрарлық емес.
Dialogue: 0,0:00:22.43,0:00:25.35,Default,,0,0,0,,Бұл машина Нала Воган ба?
Dialogue: 0,0:00:25.44,0:00:28.06,Default,,0,0,0,,Шіркін, шегін.
Dialogue: 0,0:00:28.15,0:00:30.15,Default,,0,0,0,,Толық шығару!
Dialogue: 0,0:00:31.69,0:00:33.32,Default,,0,0,0,,Негізден бас тарту
Dialogue: 0,0:00:33.40,0:00:35.16,Default,,0,0,0,,Тез арада эвакуациялаңыз
Dialogue: 0,0:00:35.24,0:00:36.32,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:00:44.91,0:00:45.87,Default,,0,0,0,,Қайшы!
Dialogue: 0,0:00:45.96,0:00:48.33,Default,,0,0,0,,О? Ол шығып жатыр ма?
Dialogue: 0,0:00:49.54,0:00:50.75,Default,,0,0,0,,Құрметті Кристоф
Dialogue: 0,0:00:50.84,0:00:53.72,Default,,0,0,0,,Қашудағы террорист туралы не деуге болады?
Dialogue: 0,0:00:53.80,0:00:57.43,Default,,0,0,0,,Ах, оны дұрыстап ұсақтаңыз.
Dialogue: 0,0:00:58.22,0:01:00.43,Default,,0,0,0,,Ринко көшесімен оңтүстікке қарай жылжыған жау әскерлері
Dialogue: 0,0:01:00.51,0:01:01.72,Default,,0,0,0,,Жақында Накахаши Накабашиге келеді
Dialogue: 0,0:01:02.64,0:01:05.73,Default,,0,0,0,,Жарайды, Ода Ода Мунемори Мунемори тобы белгіленген нүктеге жылжиды.
Dialogue: 0,0:01:05.81,0:01:07.06,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:01:08.52,0:01:10.36,Default,,0,0,0,,Алдыңғы жағы келеді
Dialogue: 0,0:01:15.57,0:01:17.78,Default,,0,0,0,,Мен Эйнбергтің бірімін.
Dialogue: 0,0:01:17.86,0:01:19.03,Default,,0,0,0,,Хит Лотт
Dialogue: 0,0:01:19.62,0:01:22.91,Default,,0,0,0,,Балалар, Жеті жарқыраған жұлдыз шоғырының Шичико Сейданын жеңіңдер.
Dialogue: 0,0:01:22.99,0:01:24.91,Default,,0,0,0,,Олар бірден қозғала бастады.
Dialogue: 0,0:01:25.00,0:01:26.33,Default,,0,0,0,,Тек оны тартыңыз.
Dialogue: 0,0:01:26.41,0:01:27.92,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:01:28.54,0:01:31.42,Default,,0,0,0,,Роуз, ол жақта жағдай қалай?
Dialogue: 0,0:01:31.50,0:01:33.84,Default,,0,0,0,,Кез келген уақытта осында келуіңізге болады.
Dialogue: 0,0:01:34.51,0:01:35.84,Default,,0,0,0,,бастайық
Dialogue: 0,0:01:35.92,0:01:36.93,Default,,0,0,0,,Иә
Dialogue: 0,0:01:37.72,0:01:40.60,Default,,0,0,0,,Жарайды, тінтуірдің жұмыс сөмкесі.
Dialogue: 0,0:01:40.68,0:01:42.06,Default,,0,0,0,,Қазір мен сөйлесіп тұрған адам – басқа емес,
Dialogue: 0,0:01:42.14,0:01:43.22,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:01:47.02,0:01:52.02,Default,,0,0,0,,♪～
Dialogue: 0,0:03:12.85,0:03:16.90,Default,,0,0,0,,～♪
Dialogue: 0,0:03:18.32,0:03:21.49,Default,,0,0,0,,Солтүстік Қасқыр армиясы мен Шығыс Акацуки бригадасы жойылды
Dialogue: 0,0:03:21.57,0:03:23.53,Default,,0,0,0,,Енді Хоккайдодағы қарсылық күштері
Dialogue: 0,0:03:23.62,0:03:25.70,Default,,0,0,0,,Екі ұсақталған
Dialogue: 0,0:03:25.78,0:03:27.58,Default,,0,0,0,,Необритания
Dialogue: 0,0:03:27.66,0:03:28.79,Default,,0,0,0,,Әскери қуатты бағаламауға болмайды
Dialogue: 0,0:03:28.87,0:03:29.91,Default,,0,0,0,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:03:30.66,0:03:35.34,Default,,0,0,0,,Кенсей Курото бастаған жеті жарқыраған жұлдыз жауға тойтарыс беруде.
Dialogue: 0,0:03:35.42,0:03:38.30,Default,,0,0,0,,Алайда қайтыс болған үш Эйнберг
Dialogue: 0,0:03:38.38,0:03:39.88,Default,,0,0,0,,тек бағыныңқы
Dialogue: 0,0:03:39.96,0:03:41.47,Default,,0,0,0,,Жоғарғы Эйнберг және
Dialogue: 0,0:03:41.55,0:03:44.89,Default,,0,0,0,,Нео-Британия армиясының көпшілігі әлі де тірі.
Dialogue: 0,0:03:44.97,0:03:45.97,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:46.05,0:03:51.77,Default,,0,0,0,,Біз Қара Рыцарларды азат етудің екі сәтсіз әрекетін ұмытқан жоқпыз.
Dialogue: 0,0:03:52.39,0:03:53.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:54.19,0:03:56.27,Default,,0,0,0,,Хоккайдоны босату кілті——
Dialogue: 0,0:03:56.36,0:03:58.15,Default,,0,0,0,,Ситумпе қабырғалары ше?
Dialogue: 0,0:03:58.23,0:04:00.03,Default,,0,0,0,,Талдау жүргізілуде
Dialogue: 0,0:04:00.65,0:04:04.45,Default,,0,0,0,,Басқаша айтқанда, онымен күресудің бекітілген әдісі жоқ.
Dialogue: 0,0:04:05.16,0:04:07.91,Default,,0,0,0,,Бұл жолы Норланд фон Люнеберг
Dialogue: 0,0:04:07.99,0:04:10.58,Default,,0,0,0,,Мен оны жай ғана сілкіп жіберді деп ойламадым.
Dialogue: 0,0:04:10.66,0:04:12.33,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:04:12.41,0:04:14.08,Default,,0,0,0,,Ренден
Dialogue: 0,0:04:14.17,0:04:19.80,Default,,0,0,0,,Бейбітшілік келіссөздеріне жіберілген арнайы уәкілдерді жинап алып, сөмкеге салып қайтарған жынды.
Dialogue: 0,0:04:19.88,0:04:23.51,Default,,0,0,0,,Біз бір-бірімізге қарама-қарсы тұрғанымызды есте ұстағандарыңызды қалаймын.
Dialogue: 0,0:04:26.76,0:04:29.43,Default,,0,0,0,,Сайып келгенде, статус-кво сақталады ма?
Dialogue: 0,0:04:29.51,0:04:31.77,Default,,0,0,0,,Егер Кагуя Кагуя және басқалары ескі лагерьден болса.
Dialogue: 0,0:04:31.85,0:04:35.27,Default,,0,0,0,,Мен күтпеген едім.
Dialogue: 0,0:04:36.10,0:04:38.69,Default,,0,0,0,,Бізге көмек көрсетілді.
Dialogue: 0,0:04:38.77,0:04:41.65,Default,,0,0,0,,Бұл бата болды, бірақ...
Dialogue: 0,0:04:43.19,0:04:45.32,Default,,0,0,0,,Құрметті Сакуя...
Dialogue: 0,0:04:46.20,0:04:48.78,Default,,0,0,0,,(шешініп жатқан дыбыс)
Dialogue: 0,0:04:51.41,0:04:53.25,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:04:54.04,0:04:56.50,Default,,0,0,0,,Өмірге қайта оралыңыз~
Dialogue: 0,0:04:56.58,0:04:59.21,Default,,0,0,0,,Хмм!
Dialogue: 0,0:05:00.55,0:05:02.21,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:05:02.30,0:05:03.51,Default,,0,0,0,,Мен және Нала ханым
Dialogue: 0,0:05:03.59,0:05:07.51,Default,,0,0,0,,Біз лаңкестердің базасын жойдық.
Dialogue: 0,0:05:07.59,0:05:08.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:09.01,0:05:11.35,Default,,0,0,0,,Мені оқ жаудырды.
Dialogue: 0,0:05:11.43,0:05:13.73,Default,,0,0,0,,Ақсақ... (Хит) Цк, бұл дұрыс емес.
Dialogue: 0,0:05:13.81,0:05:16.44,Default,,0,0,0,,Бұл олардың қорқақтық тактикасын қолданғаны және...
Dialogue: 0,0:05:16.52,0:05:18.19,Default,,0,0,0,,Қой, әуре болмаңыз.
Dialogue: 0,0:05:18.27,0:05:21.65,Default,,0,0,0,,Мен ең жек көретін жігіт түрі.
Dialogue: 0,0:05:21.73,0:05:23.65,Default,,0,0,0,,Жас Арнольдты ауыстыруды мақсат ету
Dialogue: 0,0:05:23.74,0:05:26.61,Default,,0,0,0,,Мен өз еркімен жүгіруге бардым, бірақ...
Dialogue: 0,0:05:26.70,0:05:31.03,Default,,0,0,0,,Жағдайды алға басып, бақылауға алудың орнына қарсылас бақылайды.
Dialogue: 0,0:05:31.12,0:05:37.46,Default,,0,0,0,,Мұның бәрі Кенсей Курото басқаратын Жеті жарқыраған жұлдыздың атын айту ғана болып шықты.
Dialogue: 0,0:05:37.54,0:05:42.55,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:05:43.55,0:05:45.59,Default,,0,0,0,,Есеп берудің бәрі осы ма?
Dialogue: 0,0:05:47.34,0:05:48.63,Default,,0,0,0,,Хит
Dialogue: 0,0:05:49.76,0:05:52.10,Default,,0,0,0,,Бұл жерден кет!
Dialogue: 0,0:05:55.10,0:05:58.14,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:05:58.23,0:05:59.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:59.48,0:06:00.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:05.49,0:06:07.36,Default,,0,0,0,,Хит өз-өзіне қол жұмсады.
Dialogue: 0,0:06:07.45,0:06:08.91,Default,,0,0,0,,Қазір 4 адам із-түзсіз жоғалып кетті...
Dialogue: 0,0:06:08.99,0:06:11.03,Default,,0,0,0,,Бос орындарды толтыру қиын.
Dialogue: 0,0:06:11.12,0:06:12.16,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:06:12.24,0:06:14.87,Default,,0,0,0,,Маған қиыншылықтар арта бер
Dialogue: 0,0:06:14.95,0:06:15.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:16.45,0:06:19.54,Default,,0,0,0,,Сізге Наталья қызық па?
Dialogue: 0,0:06:20.29,0:06:22.59,Default,,0,0,0,,Мен Шерри-саманың көмекшісі ретінде көшіп келдім.
Dialogue: 0,0:06:22.67,0:06:25.55,Default,,0,0,0,,Люксембург отбасының жалғыз қызы
Dialogue: 0,0:06:25.63,0:06:29.38,Default,,0,0,0,,Сіз қалауыңыз бойынша бекіткен он бір арнайы палата.
Dialogue: 0,0:06:29.47,0:06:32.80,Default,,0,0,0,,Өтініш берген сол қыз.
Dialogue: 0,0:06:32.89,0:06:34.06,Default,,0,0,0,,Әлі жасөспірім
Dialogue: 0,0:06:34.14,0:06:37.35,Default,,0,0,0,,Науқас әкенің орнына отағасының мұрагер болуы
Dialogue: 0,0:06:37.43,0:06:41.31,Default,,0,0,0,,Оны енді әкімшілік саладағы орталық тұлға ретінде қарастыруға болады.
Dialogue: 0,0:06:41.98,0:06:45.19,Default,,0,0,0,,Айтпақшы, ұлы мәртебелі император қажылыққа барғанда.
Dialogue: 0,0:06:45.27,0:06:48.28,Default,,0,0,0,,Ол ұлы мәртебелі он бірдің лаңкестік әрекетінен қорғады.
Dialogue: 0,0:06:48.36,0:06:52.45,Default,,0,0,0,,Содан бері ұлы мәртебелі Чарис әлгі қызға құмар болды.
Dialogue: 0,0:06:52.53,0:06:54.70,Default,,0,0,0,,Сізді қызықтыру үшін көп күш жұмсау керек.
Dialogue: 0,0:06:54.78,0:06:58.04,Default,,0,0,0,,Хе хе хе...
Dialogue: 0,0:06:59.16,0:07:00.50,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:07:00.58,0:07:02.54,Default,,0,0,0,,Тағы да немқұрайлы?
Dialogue: 0,0:07:03.50,0:07:05.17,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:07:05.25,0:07:06.75,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:07:06.84,0:07:08.26,Default,,0,0,0,,Эй, бұл керемет емес пе?
Dialogue: 0,0:07:08.34,0:07:10.59,Default,,0,0,0,,Біз Эйнбергті жеңдік.
Dialogue: 0,0:07:10.68,0:07:13.39,Default,,0,0,0,,Дұрыс, Курото мырзаның бұйрығы.
Dialogue: 0,0:07:13.47,0:07:14.80,Default,,0,0,0,,Роуздың стратегиясы
Dialogue: 0,0:07:14.89,0:07:17.72,Default,,0,0,0,,Бұл тек Эштің жауынгерлік күшіне байланысты емес.
Dialogue: 0,0:07:17.81,0:07:19.68,Default,,0,0,0,,Эй, мен ше?
Dialogue: 0,0:07:19.77,0:07:22.27,Default,,0,0,0,,Иә, өте сәтті өтті.
Dialogue: 0,0:07:23.23,0:07:25.27,Default,,0,0,0,,Отарудың негізі жоғалды, бірақ
Dialogue: 0,0:07:25.36,0:07:29.19,Default,,0,0,0,,Көптеген жаңа түнгі түндерді қабылдай алатын орын табылды.
Dialogue: 0,0:07:29.28,0:07:30.45,Default,,0,0,0,,Аня нәжіске батты.
Dialogue: 0,0:07:30.53,0:07:31.70,Default,,0,0,0,,О
Dialogue: 0,0:07:31.78,0:07:35.74,Default,,0,0,0,,Ах~ Күтілетін ұшақтар өте көп.
Dialogue: 0,0:07:35.83,0:07:38.16,Default,,0,0,0,,Айтпақшы, анау аға ше?
Dialogue: 0,0:07:38.24,0:07:41.16,Default,,0,0,0,,Ол бірнеше күн демалыс алатынын айтты.
Dialogue: 0,0:07:41.25,0:07:44.50,Default,,0,0,0,,Тиісті демалу – жұмыстың бір бөлігі
Dialogue: 0,0:07:45.25,0:07:46.92,Default,,0,0,0,,197…
Dialogue: 0,0:07:47.55,0:07:52.43,Default,,0,0,0,,198 199 200
Dialogue: 0,0:07:53.38,0:07:54.89,Default,,0,0,0,,Мияу Ах
Dialogue: 0,0:07:55.47,0:07:58.60,Default,,0,0,0,,Иә, бұл сіздің қызықты уақытыңыз.
Dialogue: 0,0:07:59.52,0:08:01.56,Default,,0,0,0,,(Қасапшының айқайы)
Dialogue: 0,0:08:01.64,0:08:02.94,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:08:03.52,0:08:04.69,Default,,0,0,0,,Мен оны қазір ашамын.
Dialogue: 0,0:08:04.77,0:08:05.98,Default,,0,0,0,,Ньяа
Dialogue: 0,0:08:11.86,0:08:14.16,Default,,0,0,0,,Наталья ханым пайда болды.
Dialogue: 0,0:08:14.24,0:08:15.91,Default,,0,0,0,,Фалько…
Dialogue: 0,0:08:16.66,0:08:19.83,Default,,0,0,0,,Біз оны қайта жоспарлаймыз ба?
Dialogue: 0,0:08:19.91,0:08:23.92,Default,,0,0,0,,Жоқ, жарайды, мен бірден дайындалайын.
Dialogue: 0,0:08:24.00,0:08:26.54,Default,,0,0,0,,(Ит пен мысықтың үруі)
Dialogue: 0,0:08:26.63,0:08:28.00,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:08:28.09,0:08:29.92,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:08:30.00,0:08:32.47,Default,,0,0,0,,Иә? Тамағым таусылып барады
Dialogue: 0,0:08:33.47,0:08:35.43,Default,,0,0,0,,(Ит пен мысықтың үруі)
Dialogue: 0,0:08:35.51,0:08:36.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:38.30,0:08:39.72,Default,,0,0,0,,Қайырлы таң Наталья
Dialogue: 0,0:08:39.81,0:08:41.31,Default,,0,0,0,,Қайырлы таң Роза
Dialogue: 0,0:08:41.39,0:08:44.19,Default,,0,0,0,,Вален Дүкенді жалға бергенім дұрыс па?
Dialogue: 0,0:08:44.27,0:08:46.06,Default,,0,0,0,,Әсіресе басқа елдің күшіне сүйенген адамға.
Dialogue: 0,0:08:46.94,0:08:48.86,Default,,0,0,0,,Наталья иесі болса да
Dialogue: 0,0:08:48.94,0:08:51.57,Default,,0,0,0,,Кешіріңіз, мұны тез бітірейік.
Dialogue: 0,0:08:53.74,0:08:54.57,Default,,0,0,0,,Иә
Dialogue: 0,0:08:54.65,0:08:56.95,Default,,0,0,0,,Көздің түсі де байланысты.
Dialogue: 0,0:08:57.03,0:08:59.12,Default,,0,0,0,,Бұл біртүрлі сезілмейді, солай ма?
Dialogue: 0,0:08:59.20,0:09:00.83,Default,,0,0,0,,Иә, хехе
Dialogue: 0,0:09:00.91,0:09:01.83,Default,,0,0,0,,Сакуя-сама
Dialogue: 0,0:09:01.91,0:09:04.00,Default,,0,0,0,,Шай ішкіңіз келе ме?
Dialogue: 0,0:09:04.08,0:09:05.58,Default,,0,0,0,,Иә, мен аламын.
Dialogue: 0,0:09:05.67,0:09:07.04,Default,,0,0,0,,Сіз десертті қалайсыз ба?
Dialogue: 0,0:09:07.12,0:09:08.83,Default,,0,0,0,,Енді Raspberry Pi үшін
Dialogue: 0,0:09:08.92,0:09:10.88,Default,,0,0,0,,Біз өте өкінеміз.
Dialogue: 0,0:09:10.96,0:09:12.96,Default,,0,0,0,,Бізде қазір қоймада жоқ.
Dialogue: 0,0:09:13.05,0:09:15.34,Default,,0,0,0,,Мен бірдеңе сатып алайын деп жатырмын.
Dialogue: 0,0:09:17.30,0:09:18.26,Default,,0,0,0,,Наталья
Dialogue: 0,0:09:18.34,0:09:21.18,Default,,0,0,0,,Сакура туралы ақпарат алдың ба?
Dialogue: 0,0:09:21.26,0:09:24.64,Default,,0,0,0,,Ол қазір мемлекеттік кеңседе екені анық.
Dialogue: 0,0:09:25.31,0:09:28.40,Default,,0,0,0,,Бірақ мен нақты қайда екенін білмедім.
Dialogue: 0,0:09:28.48,0:09:31.40,Default,,0,0,0,,Өйткені әскери фракция оны құпия түрде сақтайды.
Dialogue: 0,0:09:31.48,0:09:35.61,Default,,0,0,0,,Мен ұлы мәртебелі императордан кездесуді сұрауды ойладым.
Dialogue: 0,0:09:35.70,0:09:37.15,Default,,0,0,0,,Тоқтаған дұрыс сияқты.
Dialogue: 0,0:09:37.91,0:09:39.91,Default,,0,0,0,,Жыланға айналуы мүмкін
Dialogue: 0,0:09:39.99,0:09:42.79,Default,,0,0,0,,Әсіресе сол Ноландқа қарсы.
Dialogue: 0,0:09:44.25,0:09:47.42,Default,,0,0,0,,Міне, осының бәрі құпия.
Dialogue: 0,0:09:47.50,0:09:49.17,Default,,0,0,0,,Мұнда жақсы демалдыңыз ба?
Dialogue: 0,0:09:49.25,0:09:53.05,Default,,0,0,0,,Иә, оның қаншалықты дыбыс екеніне сене алар емеспін.
Dialogue: 0,0:09:53.13,0:09:56.67,Default,,0,0,0,,Балшық боп ұйықтаймын дегенің осы.
Dialogue: 0,0:09:56.76,0:09:59.97,Default,,0,0,0,,Өйткені сіз жалған сылтаумен қарсылық әрекеттерін жасап жатырсыз.
Dialogue: 0,0:10:00.05,0:10:02.10,Default,,0,0,0,,Шиеленіс жойылды.
Dialogue: 0,0:10:02.18,0:10:04.18,Default,,0,0,0,,Иә, солай болуы мүмкін.
Dialogue: 0,0:10:04.27,0:10:06.68,Default,,0,0,0,,Иида-кун, э-э… Ах. (Иида) Егер ағам туралы болса, уайымдама.
Dialogue: 0,0:10:07.23,0:10:11.02,Default,,0,0,0,,Абсолютті мойынсұну күші Геастың күші
Dialogue: 0,0:10:11.69,0:10:13.52,Default,,0,0,0,,Ол кісі айтты
Dialogue: 0,0:10:13.61,0:10:16.86,Default,,0,0,0,,Патшаның құдіреті мені жалғыз етеді
Dialogue: 0,0:10:17.90,0:10:20.28,Default,,0,0,0,,Шынында да солай болуы мүмкін.
Dialogue: 0,0:10:20.36,0:10:23.99,Default,,0,0,0,,Бұл ешкімге айта алмайтын сыр
Dialogue: 0,0:10:24.58,0:10:26.20,Default,,0,0,0,,Амансың ба? Ах...
Dialogue: 0,0:10:26.29,0:10:29.00,Default,,0,0,0,,Басқа уайымдайтын нәрсе жоқ па?
Dialogue: 0,0:10:29.08,0:10:30.96,Default,,0,0,0,,Егер ол оны өзінің Қабілетімен көтерсе, бастаманы өз қолына алады
Dialogue: 0,0:10:31.04,0:10:35.17,Default,,0,0,0,,Әй, сен неге көңіл-күйіңді өзгертпейсің?
Dialogue: 0,0:10:36.63,0:10:38.55,Default,,0,0,0,,Бұл... бұл
Dialogue: 0,0:10:38.63,0:10:42.22,Default,,0,0,0,,Кейде қыз сияқты киіну керек.
Dialogue: 0,0:10:42.30,0:10:44.64,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:10:44.72,0:10:46.85,Default,,0,0,0,,Сіз жайлы өмір сүре аласыз.
Dialogue: 0,0:10:46.93,0:10:48.81,Default,,0,0,0,,Мен жұмыс күшін аламын
Dialogue: 0,0:10:48.89,0:10:50.94,Default,,0,0,0,,Өзара пайда екеуіңізді де бақытты етеді
Dialogue: 0,0:10:51.02,0:10:53.73,Default,,0,0,0,,Хехе, бұл сіздің ойыңыз.
Dialogue: 0,0:10:53.81,0:10:55.23,Default,,0,0,0,,Ах
Dialogue: 0,0:10:55.32,0:10:57.78,Default,,0,0,0,,Мені үкімет кеңсесі шақырды.
Dialogue: 0,0:10:59.65,0:11:00.57,Default,,0,0,0,,Эй
Dialogue: 0,0:11:00.66,0:11:03.74,Default,,0,0,0,,Аа, көп жұмыс істеңіз.
Dialogue: 0,0:11:03.82,0:11:05.20,Default,,0,0,0,,Сакуя-сама
Dialogue: 0,0:11:05.28,0:11:06.49,Default,,0,0,0,,Сонымен
Dialogue: 0,0:11:07.16,0:11:09.96,Default,,0,0,0,,Қош келдіңіз Наталья
Dialogue: 0,0:11:10.04,0:11:12.04,Default,,0,0,0,,Мына көйлек сүйкімді екен.
Dialogue: 0,0:11:12.12,0:11:13.54,Default,,0,0,0,,Бір дүкеннен келген форма?
Dialogue: 0,0:11:13.63,0:11:15.84,Default,,0,0,0,,Он бірде лайықты жұмыс бар.
Dialogue: 0,0:11:15.92,0:11:17.30,Default,,0,0,0,,Сен сондай тәкаппарсың, жігітім.
Dialogue: 0,0:11:17.38,0:11:18.30,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:11:18.38,0:11:19.47,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:11:19.55,0:11:21.88,Default,,0,0,0,,Бұл арнайы палата жапондықтардың құқықтарын да мойындайды...
Dialogue: 0,0:11:21.97,0:11:23.43,Default,,0,0,0,,Иә? (Еркек) Ол жапон емес.
Dialogue: 0,0:11:23.51,0:11:24.35,Default,,0,0,0,,Он бір
Dialogue: 0,0:11:24.43,0:11:25.76,Default,,0,0,0,,Уайымдамаңыз! Эй!
Dialogue: 0,0:11:25.85,0:11:26.68,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:11:26.76,0:11:27.77,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,0:11:28.60,0:11:29.93,Default,,0,0,0,,Ой~!
Dialogue: 0,0:11:30.02,0:11:31.19,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:11:31.64,0:11:32.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:34.98,0:11:37.11,Default,,0,0,0,,Мәселе жойылды
Dialogue: 0,0:11:37.19,0:11:39.15,Default,,0,0,0,,Бұл жерден тезірек кеткен дұрыс.
Dialogue: 0,0:11:39.24,0:11:40.49,Default,,0,0,0,,Сонымен
Dialogue: 0,0:11:41.15,0:11:42.36,Default,,0,0,0,,Ах
Dialogue: 0,0:11:42.45,0:11:44.03,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:11:44.12,0:11:45.12,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:46.41,0:11:47.62,Default,,0,0,0,,Бұл көрініс
Dialogue: 0,0:11:47.70,0:11:49.25,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,0:11:49.33,0:11:51.41,Default,,0,0,0,,Бұл сізге жарасады.
Dialogue: 0,0:11:53.54,0:11:55.08,Default,,0,0,0,,Кеш болды!
Dialogue: 0,0:11:55.67,0:11:57.84,Default,,0,0,0,,Жолда бейтаныс адаммен араласып кеттім.
Dialogue: 0,0:11:57.92,0:12:00.67,Default,,0,0,0,,А, бірақ... бұл адам маған көмектесті.
Dialogue: 0,0:12:00.76,0:12:02.26,Default,,0,0,0,,Құтқарушы
Dialogue: 0,0:12:02.34,0:12:03.97,Default,,0,0,0,,Бұл Аш!
Dialogue: 0,0:12:05.34,0:12:06.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:07.10,0:12:08.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:08.18,0:12:11.39,Default,,0,0,0,,Осындай уақытта...
Dialogue: 0,0:12:11.48,0:12:13.89,Default,,0,0,0,,Иә? Жаңадан ба? (Вален) Иә
Dialogue: 0,0:12:13.98,0:12:15.90,Default,,0,0,0,,Дүкенде бүгіннен бастап
Dialogue: 0,0:12:16.48,0:12:18.86,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:12:18.94,0:12:20.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:26.20,0:12:27.20,Default,,0,0,0,,Құрметті Наталья
Dialogue: 0,0:12:27.87,0:12:30.16,Default,,0,0,0,,Сізге қоңырау шалғаным үшін кешіріңіз.
Dialogue: 0,0:12:30.24,0:12:32.62,Default,,0,0,0,,Мәртебелі император Чарис туралы бірдеңе?
Dialogue: 0,0:12:40.21,0:12:42.30,Default,,0,0,0,,Наталья ханым пайда болды.
Dialogue: 0,0:12:42.38,0:12:43.22,Default,,0,0,0,,Ах
Dialogue: 0,0:12:44.22,0:12:45.89,Default,,0,0,0,,Наталья!
Dialogue: 0,0:12:45.97,0:12:47.97,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:12:48.80,0:12:50.68,Default,,0,0,0,,Иә! Ол кісі Сакуя-сама!?
Dialogue: 0,0:12:50.77,0:12:51.68,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:12:51.77,0:12:52.81,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:52.89,0:12:55.44,Default,,0,0,0,,Мен мұны білмедім, бірақ мен оны өзіммен бірге алып келдім.
Dialogue: 0,0:12:56.48,0:12:57.61,Default,,0,0,0,,Ах
Dialogue: 0,0:12:57.69,0:12:59.19,Default,,0,0,0,,Мен оны көп көремін.
Dialogue: 0,0:12:59.27,0:13:02.57,Default,,0,0,0,,Сұрауды орындау сұрауы
Dialogue: 0,0:13:02.65,0:13:04.07,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:13:05.15,0:13:06.74,Default,,0,0,0,,Қайта толтыру туралы не деуге болады?
Dialogue: 0,0:13:06.82,0:13:09.07,Default,,0,0,0,,Өтінемін, иә
Dialogue: 0,0:13:10.45,0:13:12.70,Default,,0,0,0,,А... сенің атың кім?
Dialogue: 0,0:13:12.79,0:13:14.08,Default,,0,0,0,,Аа... Бұл таңқурай-чан!
Dialogue: 0,0:13:14.16,0:13:16.75,Default,,0,0,0,,Жоқ, мұндай бақылау емес.
Dialogue: 0,0:13:16.83,0:13:18.79,Default,,0,0,0,,Таңқурай
Dialogue: 0,0:13:18.88,0:13:20.00,Default,,0,0,0,,Бұл жақсы есім.
Dialogue: 0,0:13:20.09,0:13:21.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:21.09,0:13:22.84,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:13:22.92,0:13:24.72,Default,,0,0,0,,Сіздің сүйікті тағамыңыз қандай?
Dialogue: 0,0:13:24.80,0:13:26.84,Default,,0,0,0,,Мен тамақ ішкенді және тамақ жасағанды ұнатамын
Dialogue: 0,0:13:26.93,0:13:28.97,Default,,0,0,0,,Мен дала гүлдерін пісіруге ерекше сенімдімін.
Dialogue: 0,0:13:29.05,0:13:31.18,Default,,0,0,0,,Менің үйімде ит пен мысық бар.
Dialogue: 0,0:13:31.26,0:13:33.52,Default,,0,0,0,,Тамақ жедім деп ойлаймын, бірақ ол тез жоғалып кетті.
Dialogue: 0,0:13:33.60,0:13:35.39,Default,,0,0,0,,Мен көп шығамын, сондықтан
Dialogue: 0,0:13:35.48,0:13:38.02,Default,,0,0,0,,Осылайша сіз оларды жаппай сатып аласыз.
Dialogue: 0,0:13:38.10,0:13:40.11,Default,,0,0,0,,Адамның тағамы оларға зиянды болғандықтан...
Dialogue: 0,0:13:40.19,0:13:44.11,Default,,0,0,0,,Ой, ол сондай әңгімешіл еді.
Dialogue: 0,0:13:44.19,0:13:47.91,Default,,0,0,0,,Мен Роузбен бірге болғанымда, ол маған қажет нәрсені ғана айтты.
Dialogue: 0,0:13:48.70,0:13:51.78,Default,,0,0,0,,Әзірше сен мені байқамайтын сияқтысың.
Dialogue: 0,0:13:51.87,0:13:52.91,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:13:52.99,0:13:55.00,Default,,0,0,0,,Сіз мейірімді адамсыз, солай емес пе?
Dialogue: 0,0:13:55.08,0:13:57.25,Default,,0,0,0,,Сіз қалай мұқият бола аласыз?
Dialogue: 0,0:13:57.75,0:13:59.58,Default,,0,0,0,,Бірден ыстық кофе ішіңіз!
Dialogue: 0,0:13:59.67,0:14:01.34,Default,,0,0,0,,Пуха! Ауыстыру!
Dialogue: 0,0:14:01.42,0:14:03.17,Default,,0,0,0,,бастап үшінші толтыру!
Dialogue: 0,0:14:03.80,0:14:06.01,Default,,0,0,0,,Сен ата-анаңмен біргесің бе?
Dialogue: 0,0:14:06.09,0:14:07.72,Default,,0,0,0,,Мен отбасыммен келдім.
Dialogue: 0,0:14:07.80,0:14:10.80,Default,,0,0,0,,Менің анам қайтыс болды, менің бір інім бар.
Dialogue: 0,0:14:10.89,0:14:11.89,Default,,0,0,0,,Сіздің бауырларыңыз бар ма?
Dialogue: 0,0:14:11.97,0:14:13.10,Default,,0,0,0,,Иә? Іздеу керек пе?
Dialogue: 0,0:14:13.18,0:14:15.60,Default,,0,0,0,,Жалғыз бала Менің екінші немере ағам!
Dialogue: 0,0:14:15.68,0:14:18.27,Default,,0,0,0,,Уау, бұл шындық пен фантастиканың араласуы.
Dialogue: 0,0:14:18.35,0:14:19.60,Default,,0,0,0,,Тағдыр
Dialogue: 0,0:14:19.69,0:14:21.65,Default,,0,0,0,,Ол сенің екінші немере ағаң болды.
Dialogue: 0,0:14:21.73,0:14:24.44,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:14:25.36,0:14:27.74,Default,,0,0,0,,Артымнан ергеніңіз үшін рахмет, маған енді қажет емес
Dialogue: 0,0:14:27.82,0:14:28.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:28.90,0:14:30.20,Default,,0,0,0,,Ум...
Dialogue: 0,0:14:31.53,0:14:32.74,Default,,0,0,0,,Ауыстыру
Dialogue: 0,0:14:32.83,0:14:34.66,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:14:34.74,0:14:35.74,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:35.83,0:14:39.21,Default,,0,0,0,,Бұл кофехана қызық жер сияқты.
Dialogue: 0,0:14:39.29,0:14:42.67,Default,,0,0,0,,Кез келген уақытта келіңіз. Біз сізді қарсы аламыз.
Dialogue: 0,0:14:43.79,0:14:47.26,Default,,0,0,0,,Бірақ жапондықтар бар, солай ма?
Dialogue: 0,0:14:47.34,0:14:49.84,Default,,0,0,0,,Мен жапондықтардан қорқамын
Dialogue: 0,0:14:49.93,0:14:54.31,Default,,0,0,0,,Жоқ, одан да қорқыныштысы Ноланд болуы мүмкін.
Dialogue: 0,0:14:54.39,0:14:55.72,Default,,0,0,0,,Ол маған қараған кезде
Dialogue: 0,0:14:55.81,0:14:58.48,Default,,0,0,0,,Жүрегім езіліп кетті
Dialogue: 0,0:14:58.56,0:14:59.81,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:15:00.90,0:15:03.86,Default,,0,0,0,,Осы жерде ұлы мәртебеліге кофехана ашайық.
Dialogue: 0,0:15:04.90,0:15:06.11,Default,,0,0,0,,Мистер Столкер
Dialogue: 0,0:15:06.19,0:15:09.07,Default,,0,0,0,,Мен ыстық какао мен тәттілер алғым келеді.
Dialogue: 0,0:15:09.15,0:15:11.78,Default,,0,0,0,,Иә, Мәртебелі мырзаның өзін жақсы сезіну үшін.
Dialogue: 0,0:15:11.86,0:15:13.70,Default,,0,0,0,,Қонақжайлық көрсетеміз.
Dialogue: 0,0:15:14.37,0:15:15.99,Default,,0,0,0,,Кофе толтыру
Dialogue: 0,0:15:16.08,0:15:16.91,Default,,0,0,0,,Иә
Dialogue: 0,0:15:16.99,0:15:18.54,Default,,0,0,0,,10-шы толтыру!
Dialogue: 0,0:15:18.62,0:15:22.00,Default,,0,0,0,,Таңқурай мырзаны жануарлар ұнататын сияқты.
Dialogue: 0,0:15:22.08,0:15:24.08,Default,,0,0,0,,Саған байлану маған қиын
Dialogue: 0,0:15:24.17,0:15:26.50,Default,,0,0,0,,Мен үнемі ініме барамын.
Dialogue: 0,0:15:26.59,0:15:28.84,Default,,0,0,0,,Мен сені маған ғашық етудің түрлі жолдарын зерттедім, бірақ...
Dialogue: 0,0:15:28.92,0:15:31.51,Default,,0,0,0,,Бұл адам жаман адам...
Dialogue: 0,0:15:32.64,0:15:35.35,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:15:36.39,0:15:40.98,Default,,0,0,0,,Мен император Джуго Сумерагижугоны өлтірдім.
Dialogue: 0,0:15:44.40,0:15:47.40,Default,,0,0,0,,Сізді мазалайтын нәрсе бар ма?
Dialogue: 0,0:15:48.78,0:15:50.07,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:50.15,0:15:51.61,Default,,0,0,0,,Ах
Dialogue: 0,0:15:52.24,0:15:54.28,Default,,0,0,0,,Маған тезірек үйге бару керек.
Dialogue: 0,0:15:55.20,0:15:57.53,Default,,0,0,0,,Мм, тағы келе аласыз ба?
Dialogue: 0,0:15:58.70,0:16:00.29,Default,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:16:06.21,0:16:09.34,Default,,0,0,0,,Сәлеметсіз бе, император Сакуя-сама
Dialogue: 0,0:16:09.42,0:16:13.34,Default,,0,0,0,,Бүгіннен бастап мен Сакуя-саманың ерекше сері болдым.
Dialogue: 0,0:16:13.43,0:16:15.18,Default,,0,0,0,,Эйнберг ақ патшайымы
Dialogue: 0,0:16:15.26,0:16:18.39,Default,,0,0,0,,Кэтрин Савасра
Dialogue: 0,0:16:19.01,0:16:21.39,Default,,0,0,0,,Кейінірек кездескенше
Dialogue: 0,0:16:22.14,0:16:24.19,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:16:24.27,0:16:25.40,Default,,0,0,0,,Осымен
Dialogue: 0,0:16:25.48,0:16:28.90,Default,,0,0,0,,Мен бұл кадрлық өзгеріске көңілім толмайды.
Dialogue: 0,0:16:28.98,0:16:31.78,Default,,0,0,0,,Себебі сен он бір жарымдасың.
Dialogue: 0,0:16:31.86,0:16:33.82,Default,,0,0,0,,Ханшайым қорғайтын адам
Dialogue: 0,0:16:33.90,0:16:35.07,Default,,0,0,0,,Көтерілген жеріміз – құлайтын жеріміз.
Dialogue: 0,0:16:35.16,0:16:37.41,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:16:38.33,0:16:40.24,Default,,0,0,0,,Бірақ Ноланд мырза мықты.
Dialogue: 0,0:16:40.33,0:16:41.45,Default,,0,0,0,,онда Цуки-кунге қатысты күдік мүлде сейіледі.
Dialogue: 0,0:16:41.54,0:16:43.00,Default,,0,0,0,,Ұнады
Dialogue: 0,0:16:43.87,0:16:45.75,Default,,0,0,0,,Сондықтан мен жұмыс істеймін
Dialogue: 0,0:16:45.83,0:16:48.96,Default,,0,0,0,,Бұл сіз үшін күшті хит болуы мүмкін, бірақ
Dialogue: 0,0:16:49.04,0:16:51.09,Default,,0,0,0,,Бұл туралы уайымдамаңыз.
Dialogue: 0,0:16:51.71,0:16:52.92,Default,,0,0,0,,Иә
Dialogue: 0,0:16:53.01,0:16:55.93,Default,,0,0,0,,Олай болса, бүгін үшін кешіріңіз.
Dialogue: 0,0:16:56.01,0:16:57.47,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:16:59.81,0:17:03.23,Default,,0,0,0,,Менің Қагемүше екенімді әлі түсінбеген сияқтысың.
Dialogue: 0,0:17:03.81,0:17:06.06,Default,,0,0,0,,Қагемүшені ойнай берсем,
Dialogue: 0,0:17:06.15,0:17:08.40,Default,,0,0,0,,Бұл сэрдің қауіпсіздігіне әкелуі керек.
Dialogue: 0,0:17:09.61,0:17:11.15,Default,,0,0,0,,Соған сеніңіз
Dialogue: 0,0:17:12.74,0:17:14.03,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:17:14.11,0:17:16.57,Default,,0,0,0,,Орындау 87%
Dialogue: 0,0:17:14.11,0:17:19.37,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:17:16.66,0:17:19.37,Default,,0,0,0,,Өйткені біз әрбір жағдайды қабылдауымыз керек
Dialogue: 0,0:17:19.45,0:17:20.58,Default,,0,0,0,,«Мен… мен адаммын.»
Dialogue: 0,0:17:20.66,0:17:21.87,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:21.95,0:17:24.62,Default,,0,0,0,,Мен уақыт табамын
Dialogue: 0,0:17:24.71,0:17:28.71,Default,,0,0,0,,(Стэнли гуілдейді)
Dialogue: 0,0:17:29.75,0:17:32.59,Default,,0,0,0,,Сіз қалай ойлайсыз? Көңілді болдыңыз ба?
Dialogue: 0,0:17:32.67,0:17:34.34,Default,,0,0,0,,жеткілікті.
Dialogue: 0,0:17:34.92,0:17:38.51,Default,,0,0,0,,Шындығында, мен олардың қарсылық әрекеттерін тоқтатқанын қалаймын.
Dialogue: 0,0:17:39.14,0:17:41.39,Default,,0,0,0,,Менің ойымша, оны тоқтатудың қажеті жоқ.
Dialogue: 0,0:17:49.61,0:17:50.44,Default,,0,0,0,,Эй
Dialogue: 0,0:17:50.52,0:17:52.23,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:17:52.32,0:17:54.57,Default,,0,0,0,,Мен Сакура-чанға көмектескім келеді
Dialogue: 0,0:17:58.95,0:18:01.41,Default,,0,0,0,,Мен сіздермен ынтымақтастықта боламын
Dialogue: 0,0:18:01.49,0:18:02.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:02.99,0:18:04.41,Default,,0,0,0,,Мен де!
Dialogue: 0,0:18:04.50,0:18:06.08,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:18:06.16,0:18:08.67,Default,,0,0,0,,Екеуіңізге де рахмет.
Dialogue: 0,0:18:10.46,0:18:13.09,Default,,0,0,0,,Сәлем Наталья, иә?
Dialogue: 0,0:18:13.96,0:18:16.47,Default,,0,0,0,,Сізге тағы да қонаққа келе аламын ба?
Dialogue: 0,0:18:17.05,0:18:18.63,Default,,0,0,0,,Әрине.
Dialogue: 0,0:18:18.72,0:18:20.39,Default,,0,0,0,,Кез келген уақытта қош келдіңіз
Dialogue: 0,0:18:20.47,0:18:23.35,Default,,0,0,0,,Бұл сенің үйің.
Dialogue: 0,0:18:25.10,0:18:28.23,Default,,0,0,0,,(Чаристің ауыр тыныс алуы)
Dialogue: 0,0:18:28.31,0:18:30.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:39.36,0:18:40.82,Default,,0,0,0,,Мәртебелі император!
Dialogue: 0,0:18:40.91,0:18:42.37,Default,,0,0,0,,Дәрігерді тез шақырыңыз! Бірден!
Dialogue: 0,0:18:42.45,0:18:44.66,Default,,0,0,0,,Мәртебелі император, мені тыңдай аласыз ба?
Dialogue: 0,0:18:44.74,0:18:46.41,Default,,0,0,0,,Мәртебелі император Чарис!
Dialogue: 0,0:18:47.54,0:18:49.00,Default,,0,0,0,,Мереке аяқталды ма?
Dialogue: 0,0:18:49.08,0:18:50.92,Default,,0,0,0,,Ах, кезекшілікке оралу.
Dialogue: 0,0:18:51.00,0:18:53.13,Default,,0,0,0,,Сіз тапсырыс берген жабдықтар келді.
Dialogue: 0,0:18:53.21,0:18:55.25,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:18:56.76,0:18:59.30,Default,,0,0,0,,Қара рыцарьлардың жаңа машинасы Юкка Секка
Dialogue: 0,0:18:59.38,0:19:02.59,Default,,0,0,0,,Хотаруки Кейсетсу үшін реттелетін Эйс машинасы
Dialogue: 0,0:19:02.68,0:19:05.51,Default,,0,0,0,,Эйс машинасы сізді қызықтырады ма?
Dialogue: 0,0:19:05.60,0:19:06.81,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:19:06.89,0:19:10.52,Default,,0,0,0,,Бұл жаңа модель Акацукиге қарағанда айтарлықтай жоғары сипаттамаларға ие.
Dialogue: 0,0:19:10.60,0:19:12.35,Default,,0,0,0,,Қалыпты машина жеткілікті.
Dialogue: 0,0:19:12.44,0:19:13.81,Default,,0,0,0,,Романтика жоқ.
Dialogue: 0,0:19:14.52,0:19:16.90,Default,,0,0,0,,Егер сіз ұшқыш болсаңыз, оны барынша теңшей аласыз.
Dialogue: 0,0:19:16.98,0:19:17.94,Default,,0,0,0,,Ace ұшағы – менің арманым
Dialogue: 0,0:19:18.03,0:19:21.24,Default,,0,0,0,,Әй, біздің ұшқыш кім?
Dialogue: 0,0:19:21.32,0:19:25.08,Default,,0,0,0,,Курото мырза, ұшқыштың аты шешілді ме?
Dialogue: 0,0:19:25.16,0:19:26.66,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:27.16,0:19:29.91,Default,,0,0,0,,Шешімді кім қабылдаса да, қайшылық болатын сияқты.
Dialogue: 0,0:19:30.00,0:19:32.75,Default,,0,0,0,,Сырттан келген адам ретінде мен объективті түрде таңдасам ше?
Dialogue: 0,0:19:32.83,0:19:34.42,Default,,0,0,0,,Бұл керемет идея.
Dialogue: 0,0:19:34.50,0:19:36.75,Default,,0,0,0,,Сіз қалай ойлайсыз? Үкімді артта қалдыру
Dialogue: 0,0:19:38.01,0:19:39.13,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:39.21,0:19:40.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:41.55,0:19:44.97,Default,,0,0,0,,Жарайды, келіспесеңіз, өзгертіңіз.
Dialogue: 0,0:19:45.05,0:19:47.01,Default,,0,0,0,,Роза! иә?
Dialogue: 0,0:19:47.10,0:19:49.64,Default,,0,0,0,,Артемида да келді.
Dialogue: 0,0:19:49.73,0:19:53.31,Default,,0,0,0,,Бұл менің Nightmare ұшатын түрін бірінші рет ұстауым.
Dialogue: 0,0:19:53.40,0:19:55.15,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,0:19:55.23,0:19:56.86,Default,,0,0,0,,Ол аяқталды.
Dialogue: 0,0:19:56.94,0:20:00.03,Default,,0,0,0,,Енді мен ініме тікелей қолдау көрсете аламын.
Dialogue: 0,0:20:00.11,0:20:03.28,Default,,0,0,0,,Аполлонмен тандем үшін кешірім сұраймын.
Dialogue: 0,0:20:03.36,0:20:05.24,Default,,0,0,0,,Мен бұзып кетейін
Dialogue: 0,0:20:05.32,0:20:07.28,Default,,0,0,0,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:20:21.38,0:20:24.68,Default,,0,0,0,,Бауырым, үзіліс кезінде бірдеңе болды ма?
Dialogue: 0,0:20:24.76,0:20:26.85,Default,,0,0,0,,Жоқ, әсіресе
Dialogue: 0,0:20:27.55,0:20:28.39,Default,,0,0,0,,(Ранпа) Зұлымдар Альянсы, иә? Тамаша! Кел, байқап көрейік!
Dialogue: 0,0:20:28.47,0:20:30.81,Default,,0,0,0,,Иә, жұмыс істеді.
Dialogue: 0,0:20:30.89,0:20:34.23,Default,,0,0,0,,Келесі операцияға тұрақты дайындалу
Dialogue: 0,0:20:34.73,0:20:35.94,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:39.15,0:20:40.36,Default,,0,0,0,,Сәлем Роза
Dialogue: 0,0:20:40.44,0:20:41.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:42.57,0:20:45.70,Default,,0,0,0,,Мен өзіме ұнайтын адамды таптым
Dialogue: 0,0:20:45.78,0:20:47.24,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:48.33,0:20:49.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:49.24,0:20:50.87,Default,,0,0,0,,Иә? (котята мияулайды)
Dialogue: 0,0:20:50.95,0:20:53.08,Default,,0,0,0,,Жоқ, жоқ, сәл күте тұрыңыз, бұл...
Dialogue: 0,0:20:53.16,0:20:55.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:55.46,0:20:57.88,Default,,0,0,0,,Император сарайынан хабарландыру
Dialogue: 0,0:20:58.63,0:21:02.01,Default,,0,0,0,,100-ші император Чарис аль-Британия
Dialogue: 0,0:21:02.09,0:21:03.01,Default,,0,0,0,,Қайтыс болды
Dialogue: 0,0:21:03.09,0:21:04.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:05.47,0:21:06.47,Default,,0,0,0,,Бақылау есебі
Dialogue: 0,0:21:07.09,0:21:10.22,Default,,0,0,0,,Император сарайы 101-ші император ретінде
Dialogue: 0,0:21:10.31,0:21:15.23,Default,,0,0,0,,Сакуя Сумераги Ме Британия император тағына ие болады деп жарияланды.
Dialogue: 0,0:21:15.31,0:21:17.19,Default,,0,0,0,,Шынымен! (Монобе) Сакуя-сама
Dialogue: 0,0:21:17.27,0:21:21.15,Default,,0,0,0,,Қайталап айтамын, бұған дейін император сарайынан хабарландыру келді.
Dialogue: 0,0:21:21.23,0:21:24.82,Default,,0,0,0,,100-ші император Чарис аль-Британия
Dialogue: 0,0:21:22.07,0:21:23.61,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:21:24.90,0:21:26.36,Default,,0,0,0,,Қайтыс болды
Dialogue: 0,0:21:26.45,0:21:29.62,Default,,0,0,0,,Тиісінше, 101-ші император ретінде
Dialogue: 0,0:21:29.70,0:21:34.25,Default,,0,0,0,,Лорд Сакуя Сумераги Ме Британия таққа отырды.
Dialogue: 0,0:21:50.80,0:21:53.27,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:21:57.48,0:21:59.27,Default,,0,0,0,,Сакура
Dialogue: 0,0:21:59.35,0:22:02.48,Default,,0,0,0,,Мен жақындап қалдым деп ойладым...
Dialogue: 0,0:22:03.78,0:22:04.82,Default,,0,0,0,,Ha
Dialogue: 0,0:22:07.28,0:22:09.28,Default,,0,0,0,,Сізге билік керек пе?
Dialogue: 0,0:22:09.91,0:22:12.74,Default,,0,0,0,,Патшаның құдіреті сені жалғыз етеді
Dialogue: 0,0:22:13.49,0:22:16.79,Default,,0,0,0,,Мен сенен маңызды нәрсені аулақ ұстаймын
Dialogue: 0,0:22:18.96,0:22:20.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:23.25,0:22:25.26,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:22:26.88,0:22:30.93,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:22:31.01,0:22:36.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:55.89,0:24:00.89,Default,,0,0,0,,～♪
Dialogue: 0,0:24:02.39,0:24:08.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory