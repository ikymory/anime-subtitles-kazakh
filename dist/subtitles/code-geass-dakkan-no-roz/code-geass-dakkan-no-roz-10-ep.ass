Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.75,0:00:04.75,Default,,0,0,0,,(Стэнли ызылдайды)
Dialogue: 0,0:00:04.83,0:00:07.46,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:07.54,0:00:11.30,Default,,0,0,0,,Loki және Foulbout енді синхрондалған
Dialogue: 0,0:00:11.38,0:00:13.22,Default,,0,0,0,,Бұл қызық~
Dialogue: 0,0:00:13.30,0:00:16.59,Default,,0,0,0,,Сіздің ізденісіңіз жарық көрген сәт
Dialogue: 0,0:00:16.68,0:00:20.35,Default,,0,0,0,,Осыдан кейін біз Neo Britannia жауларын автоматты түрде анықтаймыз.
Dialogue: 0,0:00:20.43,0:00:23.56,Default,,0,0,0,,Өлтіретін бағдарламаны іске қоссаңыз...
Dialogue: 0,0:00:23.64,0:00:26.60,Default,,0,0,0,,Дұрыс, мен сайттағы деректерді де байқадым...
Dialogue: 0,0:00:26.69,0:00:27.81,Default,,0,0,0,,Іс аяқталды.
Dialogue: 0,0:00:27.90,0:00:29.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:29.61,0:00:32.32,Default,,0,0,0,,Бұл жерден кет!
Dialogue: 0,0:00:32.40,0:00:33.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:34.99,0:00:36.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:36.91,0:00:39.83,Default,,0,0,0,,Жоқ... бұл мүмкін емес.
Dialogue: 0,0:01:08.98,0:01:13.86,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:01:34.76,0:01:36.59,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:01:46.89,0:01:49.52,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:01:49.60,0:01:52.65,Default,,0,0,0,,Қалай қарасаң да, дұшпан екені анық.
Dialogue: 0,0:01:52.73,0:01:54.11,Default,,0,0,0,,Жәндіктердің сілекейі жүгіреді
Dialogue: 0,0:01:54.94,0:01:55.78,Default,,0,0,0,,Ләйлә
Dialogue: 0,0:01:55.86,0:01:57.36,Default,,0,0,0,,Нұсқаулар
Dialogue: 0,0:01:57.45,0:01:59.61,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:02:00.41,0:02:02.16,Default,,0,0,0,,Бұл жігіттер кімдер...
Dialogue: 0,0:02:04.49,0:02:07.91,Default,,0,0,0,,Қарғыс атқыр... халықтың тыныштығына қауіп төндірмекші.
Dialogue: 0,0:02:09.50,0:02:10.63,Default,,0,0,0,,Келесі жолақтағы жігіт
Dialogue: 0,0:02:10.71,0:02:12.17,Default,,0,0,0,,Мен олардың бәрін жеңдім, бірақ
Dialogue: 0,0:02:12.25,0:02:14.63,Default,,0,0,0,,Мұның соңы жоқ.
Dialogue: 0,0:02:14.71,0:02:17.42,Default,,0,0,0,,Ағымдағы жағдай туралы бақылау бөлмесінің есебі
Dialogue: 0,0:02:18.09,0:02:20.51,Default,,0,0,0,,Шығыстан жақындап келе жатқан көптеген ұшақтар
Dialogue: 0,0:02:20.59,0:02:22.64,Default,,0,0,0,,Бұл белгісіз ұшақтарға арналған күшейткіштер сияқты.
Dialogue: 0,0:02:22.72,0:02:25.43,Default,,0,0,0,,Не? Сіз күшейтушілерсіз бе?
Dialogue: 0,0:02:25.52,0:02:27.93,Default,,0,0,0,,Бұл жігіт қатал болуы мүмкін
Dialogue: 0,0:02:28.98,0:02:29.81,Default,,0,0,0,,Осы сәтте——
Dialogue: 0,0:02:29.89,0:02:33.27,Default,,0,0,0,,48 ірі қалада белгісіз ұшақтармен әрекет ету
Dialogue: 0,0:02:33.36,0:02:34.77,Default,,0,0,0,,Британ Республикасының жағалауы
Dialogue: 0,0:02:34.86,0:02:37.69,Default,,0,0,0,,Зақымның артуына байланысты кейбір алдыңғы шептер шегінеді
Dialogue: 0,0:02:37.78,0:02:39.24,Default,,0,0,0,,Қошмар кадрды орналастыру
Dialogue: 0,0:02:39.32,0:02:41.74,Default,,0,0,0,,Жұқа жерлер қираған
Dialogue: 0,0:02:42.32,0:02:43.37,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:02:43.45,0:02:47.54,Default,,0,0,0,,PMC Сондай-ақ, ардагерлерден ынтымақтастықты сұраңыз.
Dialogue: 0,0:02:47.62,0:02:49.79,Default,,0,0,0,,Кобусты айдай алатын мүмкіндігінше көп адам
Dialogue: 0,0:02:49.87,0:02:50.92,Default,,0,0,0,,Оны жинаңыз
Dialogue: 0,0:02:51.00,0:02:52.17,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:02:52.25,0:02:54.25,Default,,0,0,0,,Қарулы әскери әрекет Америка Құрама Штаттарының Жарғысына қайшы келеді...
Dialogue: 0,0:02:54.34,0:02:55.88,Default,,0,0,0,,Осыны айтып тұрсыз ба?
Dialogue: 0,0:02:55.96,0:03:00.30,Default,,0,0,0,,Қарсыластың кім екенін білмегендіктен, апаттан қорғану ретінде әрекет етіңіз.
Dialogue: 0,0:03:01.09,0:03:03.47,Default,,0,0,0,,Мен барлық жауапкершілікті аламын!
Dialogue: 0,0:03:06.22,0:03:08.98,Default,,0,0,0,,Жаңа ақпарат келді ме?
Dialogue: 0,0:03:09.06,0:03:13.86,Default,,0,0,0,,Люксембург аумағында көптеген белгісіз ұшақтар пайда болған сияқты.
Dialogue: 0,0:03:13.94,0:03:16.40,Default,,0,0,0,,Жаудың мөлшері әлі белгісіз.
Dialogue: 0,0:03:16.48,0:03:17.32,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:03:17.40,0:03:18.32,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:03:18.40,0:03:19.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:19.36,0:03:21.03,Default,,0,0,0,,Наталья?
Dialogue: 0,0:03:22.32,0:03:23.91,Default,,0,0,0,,Жақсы, қосылған
Dialogue: 0,0:03:23.99,0:03:26.58,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:03:26.66,0:03:29.91,Default,,0,0,0,,Иә, әйтеуір әскери баспанада...
Dialogue: 0,0:03:30.00,0:03:31.21,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:03:31.29,0:03:34.83,Default,,0,0,0,,Егер бұлай көрінсе, олар бей-берекет шабуыл жасап жатқан сияқты.
Dialogue: 0,0:03:34.92,0:03:38.50,Default,,0,0,0,,Жаңа Британдық армиядан басқа күш бар ма?
Dialogue: 0,0:03:38.59,0:03:40.22,Default,,0,0,0,,Олай болса, Император сарайы...
Dialogue: 0,0:03:40.30,0:03:42.55,Default,,0,0,0,,Мәртебелі императордың сарайына да қауіп төнуі мүмкін.
Dialogue: 0,0:03:42.63,0:03:43.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:43.68,0:03:47.01,Default,,0,0,0,,Біз жақсы боламыз, сондықтан асығыңыз және Мәртебелі мырзаны құтқарыңыз...
Dialogue: 0,0:03:47.89,0:03:50.18,Default,,0,0,0,,Наталья!
Dialogue: 0,0:04:02.99,0:04:07.99,Default,,0,0,0,,♪～
Dialogue: 0,0:05:28.91,0:05:32.91,Default,,0,0,0,,～♪
Dialogue: 0,0:05:28.91,0:05:32.91,Default,,0,0,0,,～♪
Dialogue: 0,0:05:34.75,0:05:35.66,Default,,0,0,0,,Белгісіз ұшақ
Dialogue: 0,0:05:35.75,0:05:37.21,Default,,0,0,0,,Штабқа жақындау
Dialogue: 0,0:05:37.29,0:05:38.88,Default,,0,0,0,,3 ұпаймен шеңбер құрып, жойыңыз.
Dialogue: 0,0:05:38.96,0:05:39.88,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:05:52.68,0:05:53.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:02.27,0:06:03.52,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:06:03.61,0:06:04.98,Default,,0,0,0,,Және ацетилендік факелмен кесіліп ашылған темір қорап—
Dialogue: 0,0:06:05.57,0:06:08.86,Default,,0,0,0,,Бұл Жаңа Британияның жұмысы ма? Лорд Вон
Dialogue: 0,0:06:08.95,0:06:10.87,Default,,0,0,0,,Не айтып тұрсың... (мүше) Ол жаққа көшпе!
Dialogue: 0,0:06:10.95,0:06:14.20,Default,,0,0,0,,Бір қадам қозғалсаң, мен сені осы жерде атуым керек.
Dialogue: 0,0:06:14.29,0:06:15.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:15.58,0:06:17.25,Default,,0,0,0,,Мылтықты қойыңыз!
Dialogue: 0,0:06:17.87,0:06:19.21,Default,,0,0,0,,бірақ онымен бәсекеге түсер ешкім қалмады ма?
Dialogue: 0,0:06:19.29,0:06:23.00,Default,,0,0,0,,Лорд Вонның бұрын не істегенін көрмедің бе?
Dialogue: 0,0:06:23.71,0:06:27.51,Default,,0,0,0,,Топ мүшесінің өмірін сақтап қалғаны үшін алғыс ретінде оған мылтық бағыттау.
Dialogue: 0,0:06:27.59,0:06:29.88,Default,,0,0,0,,Бейбітшілік – алыс болашақ.
Dialogue: 0,0:06:29.97,0:06:33.30,Default,,0,0,0,,Назар аударғаныңызға рахмет, Рен-доно.
Dialogue: 0,0:06:33.39,0:06:34.85,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:06:34.93,0:06:37.52,Default,,0,0,0,,Мен сенің жауың емеспін
Dialogue: 0,0:06:38.10,0:06:40.65,Default,,0,0,0,,Болашақ әрекеттеріңізге қарап баға беріңіз.
Dialogue: 0,0:06:43.65,0:06:45.23,Default,,0,0,0,,Не болды? раушан
Dialogue: 0,0:06:45.82,0:06:49.65,Default,,0,0,0,,Осындай уақытта өзімшілдікпен әрекет ету дұрыс па?
Dialogue: 0,0:06:49.74,0:06:51.24,Default,,0,0,0,,Бұл маңызды миссия.
Dialogue: 0,0:06:51.32,0:06:55.28,Default,,0,0,0,,Роуз, дереу Сумераги Сумерагиге барып, Сакуяны құтқар.
Dialogue: 0,0:06:55.87,0:06:56.70,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:56.79,0:06:58.08,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:06:58.16,0:07:01.50,Default,,0,0,0,,Люксембургті бізге қалдырыңыз.
Dialogue: 0,0:07:01.58,0:07:04.46,Default,,0,0,0,,Уайымдамаңыз, біз қазірдің өзінде жолға шықтық.
Dialogue: 0,0:07:05.04,0:07:07.63,Default,,0,0,0,,Мен сені керемет түрде құтқарамын.
Dialogue: 0,0:07:07.71,0:07:10.17,Default,,0,0,0,,Кейде мен сізге жақсы жақтарын көрсетуге тура келеді.
Dialogue: 0,0:07:10.26,0:07:11.30,Default,,0,0,0,,Шу!
Dialogue: 0,0:07:11.38,0:07:14.51,Default,,0,0,0,,Артемида, жоқ, Ортегия.
Dialogue: 0,0:07:14.60,0:07:16.35,Default,,0,0,0,,Бұл Император сарайына жылдам саяхат.
Dialogue: 0,0:07:16.43,0:07:18.68,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:07:18.77,0:07:21.31,Default,,0,0,0,,Екеуің уайымдамаңдар, ұлы мәртебелі императорды құтқарыңдар.
Dialogue: 0,0:07:21.89,0:07:23.52,Default,,0,0,0,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:07:23.60,0:07:24.98,Default,,0,0,0,,Раушан
Dialogue: 0,0:07:25.06,0:07:27.53,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,0:07:28.57,0:07:29.99,Default,,0,0,0,,Секір!!
Dialogue: 0,0:07:30.07,0:07:31.90,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:07:44.67,0:07:47.17,Default,,0,0,0,,Мәртебелі, күте тұрыңыз.
Dialogue: 0,0:07:48.42,0:07:50.92,Default,,0,0,0,,Лорд Линдстедт те естіген шығар.
Dialogue: 0,0:07:51.01,0:07:52.84,Default,,0,0,0,,Люксембург территориясының ісі
Dialogue: 0,0:07:52.93,0:07:56.80,Default,,0,0,0,,Егер рас болса, Ноланд бірдеңені білуі керек.
Dialogue: 0,0:07:56.89,0:07:58.68,Default,,0,0,0,,Тіпті солай болса да
Dialogue: 0,0:07:58.76,0:08:01.81,Default,,0,0,0,,Қалай ойлайсың, бұл адам мұны адал мойындайды ма?
Dialogue: 0,0:08:01.89,0:08:05.69,Default,,0,0,0,,Екінші жағынан, егер сіз сабырлы болсаңыз, сізге қауіп төнуі мүмкін.
Dialogue: 0,0:08:05.77,0:08:07.02,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:07.11,0:08:12.20,Default,,0,0,0,,Сіз Сакуя-саманың орынбасары болсаңыз да, сіз бұл елдегі ең жоғарғы биліксіз.
Dialogue: 0,0:08:12.28,0:08:15.57,Default,,0,0,0,,Өз позицияңыздан мұны істеудің басқа жолдарын ойластырыңыз.
Dialogue: 0,0:08:16.53,0:08:18.87,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:18.95,0:08:20.75,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:21.29,0:08:23.87,Default,,0,0,0,,Енді қолымнан келгенін істейік
Dialogue: 0,0:08:23.96,0:08:25.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:26.83,0:08:27.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:33.26,0:08:35.18,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:08:46.31,0:08:48.31,Default,,0,0,0,,Жарайды, енді екінші қабатқа бар!
Dialogue: 0,0:08:48.40,0:08:49.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:49.61,0:08:50.98,Default,,0,0,0,,Хаха...
Dialogue: 0,0:08:51.07,0:08:52.65,Default,,0,0,0,,Кя!
Dialogue: 0,0:08:52.74,0:08:55.03,Default,,0,0,0,,мамыр! Сакуя-саманың бөлмесіне
Dialogue: 0,0:08:55.11,0:08:55.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:57.99,0:08:59.87,Default,,0,0,0,,Шебер Сіздің қаруларыңыз қандай?
Dialogue: 0,0:08:59.95,0:09:01.49,Default,,0,0,0,,Таусылды
Dialogue: 0,0:09:01.58,0:09:03.25,Default,,0,0,0,,Бұл жер мәңгілік бола ма деп ойлаймын
Dialogue: 0,0:09:03.33,0:09:07.00,Default,,0,0,0,,Өтінемін, олай айтпа.
Dialogue: 0,0:09:09.00,0:09:10.29,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:09:10.38,0:09:11.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:15.30,0:09:16.47,Default,,0,0,0,,Сізді күтуге мәжбүрлегенім үшін кешіріңіз.
Dialogue: 0,0:09:16.55,0:09:19.05,Default,,0,0,0,,Енді оны қалай пісіру керек?
Dialogue: 0,0:09:19.14,0:09:22.06,Default,,0,0,0,,Базука шынымен жұмыс істемейді.
Dialogue: 0,0:09:22.14,0:09:23.39,Default,,0,0,0,,Тіпті егер...
Dialogue: 0,0:09:23.47,0:09:25.60,Default,,0,0,0,,Бұл жігіт сондай үлкен және жалқау.
Dialogue: 0,0:09:25.69,0:09:26.56,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:09:26.64,0:09:28.19,Default,,0,0,0,,Келеді! (Мунемори) Ах.
Dialogue: 0,0:09:29.36,0:09:30.86,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:30.94,0:09:32.36,Default,,0,0,0,,Мунемори!
Dialogue: 0,0:09:33.44,0:09:34.86,Default,,0,0,0,,Бұл жаман!
Dialogue: 0,0:09:44.66,0:09:47.46,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:09:47.54,0:09:49.71,Default,,0,0,0,,Мен өлемін деп ойладым
Dialogue: 0,0:09:49.79,0:09:52.42,Default,,0,0,0,,Бір ғана машинаның сонша күші бар ма?
Dialogue: 0,0:09:52.50,0:09:54.88,Default,,0,0,0,,Жоқ, шындап.
Dialogue: 0,0:09:55.51,0:09:56.84,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:56.92,0:10:00.72,Default,,0,0,0,,Бұл оның дүние жүзіне шашыраңқы екенін білдіре ме?
Dialogue: 0,0:10:06.10,0:10:07.18,Default,,0,0,0,,А... (Уолтер) А-а!
Dialogue: 0,0:10:08.19,0:10:09.27,Default,,0,0,0,,Жертөлеге қашу
Dialogue: 0,0:10:09.35,0:10:10.56,Default,,0,0,0,,Иә
Dialogue: 0,0:10:11.27,0:10:14.73,Default,,0,0,0,,Бұл ұшақ жер бетінде кімдікі?
Dialogue: 0,0:10:17.40,0:10:18.65,Default,,0,0,0,,Жақында
Dialogue: 0,0:10:18.74,0:10:20.62,Default,,0,0,0,,Бірде мен бақылауды сізге қалдырамын.
Dialogue: 0,0:10:20.70,0:10:22.03,Default,,0,0,0,,Түсінген күл
Dialogue: 0,0:10:24.08,0:10:25.04,Default,,0,0,0,,Ах
Dialogue: 0,0:10:25.62,0:10:27.29,Default,,0,0,0,,Императордың сарайы...
Dialogue: 0,0:10:28.21,0:10:29.83,Default,,0,0,0,,Жойылған
Dialogue: 0,0:10:30.71,0:10:33.38,Default,,0,0,0,,Олардың басқа жерге эвакуациялану мүмкіндігі бар.
Dialogue: 0,0:10:33.46,0:10:35.55,Default,,0,0,0,,Түсіп, ізденейік.
Dialogue: 0,0:10:38.63,0:10:41.72,Default,,0,0,0,,О, ол әлі тірі.
Dialogue: 0,0:10:41.80,0:10:46.06,Default,,0,0,0,,Я... жоғарыда біртүрлі машина жұмыс істеп жатыр.
Dialogue: 0,0:10:46.14,0:10:49.06,Default,,0,0,0,,Сізбен кездесу - ең жаманы
Dialogue: 0,0:10:49.14,0:10:50.77,Default,,0,0,0,,Лорд Сабасура…
Dialogue: 0,0:10:51.35,0:10:53.98,Default,,0,0,0,,Мен қатты ренжідім, тезірек бір жерге бара аласыз ба?
Dialogue: 0,0:10:54.07,0:10:58.57,Default,,0,0,0,,Бізбен ынтымақтаса аласыз ба?
Dialogue: 0,0:10:58.65,0:10:59.70,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:59.78,0:11:00.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:00.99,0:11:03.20,Default,,0,0,0,,Мәртебелі мырза, сіз не істеп жатырсыз?
Dialogue: 0,0:11:03.28,0:11:07.29,Default,,0,0,0,,Мен әлі өле алмаймын.
Dialogue: 0,0:11:07.37,0:11:08.58,Default,,0,0,0,,Га
Dialogue: 0,0:11:08.66,0:11:12.92,Default,,0,0,0,,Егер мен өлетін болсам, маған көмектесе аласыз ба?
Dialogue: 0,0:11:13.00,0:11:15.80,Default,,0,0,0,,Сондықтан әлсіз адамдар
Dialogue: 0,0:11:15.88,0:11:19.59,Default,,0,0,0,,Мен декорация императоры болуым мүмкін
Dialogue: 0,0:11:19.67,0:11:22.39,Default,,0,0,0,,Бірақ мен қазір көшсем
Dialogue: 0,0:11:22.47,0:11:25.47,Default,,0,0,0,,Мүмкін мүмкіндігінше көп адамды құтқаруға болады.
Dialogue: 0,0:11:26.18,0:11:30.48,Default,,0,0,0,,Мен өз миссиямды орындағым келеді.
Dialogue: 0,0:11:30.56,0:11:34.23,Default,,0,0,0,,Жоқ, мен мұны істеуім керек.
Dialogue: 0,0:11:35.77,0:11:38.32,Default,,0,0,0,,Сіз аздап өзгердіңіз.
Dialogue: 0,0:11:38.40,0:11:39.53,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:39.61,0:11:41.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:41.90,0:11:43.53,Default,,0,0,0,,Бұл жерде болу қауіпті.
Dialogue: 0,0:11:43.61,0:11:44.95,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:11:45.03,0:11:46.66,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:11:47.24,0:11:50.62,Default,,0,0,0,,Мен сендерді өте алмайтын жерге апарамын.
Dialogue: 0,0:11:50.71,0:11:51.62,Default,,0,0,0,,Е...
Dialogue: 0,0:11:53.46,0:11:56.34,Default,,0,0,0,,Сіз не істеп жатырсыз? Мен оны сонда қалдырамын.
Dialogue: 0,0:12:17.31,0:12:18.98,Default,,0,0,0,,Күл…
Dialogue: 0,0:12:23.24,0:12:24.53,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:26.24,0:12:28.20,Default,,0,0,0,,Сакура қайда...
Dialogue: 0,0:12:29.87,0:12:31.20,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:31.83,0:12:33.41,Default,,0,0,0,,Мен бір жерде сенімдімін ...
Dialogue: 0,0:12:36.75,0:12:40.42,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:12:40.50,0:12:43.67,Default,,0,0,0,,Императордың сарайында ешкім болған жоқ.
Dialogue: 0,0:12:44.88,0:12:46.26,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:12:46.84,0:12:48.89,Default,,0,0,0,,Мұнда күл...
Dialogue: 0,0:12:48.97,0:12:50.64,Default,,0,0,0,,Ноланд бөлмесі.
Dialogue: 0,0:12:50.72,0:12:51.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:55.64,0:12:56.94,Default,,0,0,0,,Күл
Dialogue: 0,0:12:57.02,0:13:00.48,Default,,0,0,0,,Егер Ноланд ішінде болса, дереу Geass қолданыңыз.
Dialogue: 0,0:13:00.57,0:13:02.86,Default,,0,0,0,,Бұл жағдайда құлағыңызды жабыңыз.
Dialogue: 0,0:13:03.36,0:13:04.36,Default,,0,0,0,,О
Dialogue: 0,0:13:10.70,0:13:11.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:12.12,0:13:13.91,Default,,0,0,0,,Жасырын үзінді?
Dialogue: 0,0:13:19.25,0:13:20.50,Default,,0,0,0,,Локи?
Dialogue: 0,0:13:21.34,0:13:24.05,Default,,0,0,0,,Бұл ұшақ осында жасалған ба?
Dialogue: 0,0:13:24.55,0:13:27.13,Default,,0,0,0,,Бірақ неге император сарайына да шабуыл жасалды...
Dialogue: 0,0:13:28.14,0:13:28.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:29.55,0:13:31.35,Default,,0,0,0,,Жер астында бірдеңе бар
Dialogue: 0,0:13:31.43,0:13:33.10,Default,,0,0,0,,Мұның астында Ноланд болуы мүмкін.
Dialogue: 0,0:13:33.18,0:13:34.89,Default,,0,0,0,,Сакура да сонда...
Dialogue: 0,0:13:35.48,0:13:37.35,Default,,0,0,0,,А... а...
Dialogue: 0,0:13:44.65,0:13:49.32,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:14:00.46,0:14:02.09,Default,,0,0,0,,Зорлық-зомбылық арқылы бағындыру
Dialogue: 0,0:14:02.17,0:14:05.30,Default,,0,0,0,,Басқаларға мойынсұну күшті ме?
Dialogue: 0,0:14:37.75,0:14:40.46,Default,,0,0,0,,Өте керемет болды...
Dialogue: 0,0:14:40.96,0:14:43.42,Default,,0,0,0,,Сол кездегі Ноланд мырза
Dialogue: 0,0:14:45.55,0:14:49.63,Default,,0,0,0,,Бірақ бұл жалғыз күш.
Dialogue: 0,0:14:50.72,0:14:52.64,Default,,0,0,0,,Осы уақытқа дейін абсолютті билік
Dialogue: 0,0:14:52.72,0:14:55.81,Default,,0,0,0,,Мен өзімді ең күшті күшке ие болғандай сезіндім
Dialogue: 0,0:14:56.39,0:14:59.89,Default,,0,0,0,,Иә? Мен енді түсінбеймін
Dialogue: 0,0:15:00.48,0:15:03.52,Default,,0,0,0,,Мен нағыз күшті білемін
Dialogue: 0,0:15:05.73,0:15:08.69,Default,,0,0,0,,Сіз мұны айттыңыз.
Dialogue: 0,0:15:08.78,0:15:11.11,Default,,0,0,0,,Сіз өзіңіздің шынайы күшіңізді білесіз
Dialogue: 0,0:15:11.20,0:15:12.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:12.57,0:15:14.74,Default,,0,0,0,,Сіз айтып отырған күш
Dialogue: 0,0:15:14.83,0:15:16.20,Default,,0,0,0,,Не?
Dialogue: 0,0:15:19.79,0:15:22.50,Default,,0,0,0,,Мен әлсіз болуым мүмкін
Dialogue: 0,0:15:22.58,0:15:23.46,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:23.54,0:15:26.09,Default,,0,0,0,,Тіпті кішкентай күш
Dialogue: 0,0:15:26.17,0:15:28.30,Default,,0,0,0,,Өзіңнен басқа біреу үшін
Dialogue: 0,0:15:28.38,0:15:29.92,Default,,0,0,0,,Бір нәрсені істей алатын жүрек
Dialogue: 0,0:15:30.80,0:15:32.89,Default,,0,0,0,,Бұл нағыз күш
Dialogue: 0,0:15:33.47,0:15:35.30,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:15:37.01,0:15:39.56,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:15:41.56,0:15:44.69,Default,,0,0,0,,...
Dialogue: 0,0:15:45.61,0:15:46.82,Default,,0,0,0,,Онда
Dialogue: 0,0:15:46.90,0:15:49.69,Default,,0,0,0,,Бұл шығу, сондықтан мен кеттім.
Dialogue: 0,0:15:49.78,0:15:50.99,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:15:51.07,0:15:51.95,Default,,0,0,0,,Қай жолмен?
Dialogue: 0,0:15:52.03,0:15:55.28,Default,,0,0,0,,...
Dialogue: 0,0:15:55.37,0:15:57.45,Default,,0,0,0,,Қалғанын қалауыңызша орындаңыз.
Dialogue: 0,0:15:57.53,0:16:01.46,Default,,0,0,0,,...
Dialogue: 0,0:16:01.54,0:16:03.37,Default,,0,0,0,,Лорд Сабасура…
Dialogue: 0,0:16:04.33,0:16:07.75,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:16:07.84,0:16:11.51,Default,,0,0,0,,Мен бір нәрсеге алаңдаймын.
Dialogue: 0,0:16:13.68,0:16:14.51,Default,,0,0,0,,Күл
Dialogue: 0,0:16:15.43,0:16:16.64,Default,,0,0,0,,Күл?
Dialogue: 0,0:16:17.43,0:16:18.89,Default,,0,0,0,,Күл!
Dialogue: 0,0:16:19.89,0:16:20.72,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:16:20.81,0:16:23.60,Default,,0,0,0,,Хехехе мен білмеймін.
Dialogue: 0,0:16:24.31,0:16:26.48,Default,,0,0,0,,...
Dialogue: 0,0:16:27.27,0:16:28.11,Default,,0,0,0,,Йосе
Dialogue: 0,0:16:28.94,0:16:30.11,Default,,0,0,0,,Қол тигізбеңіз
Dialogue: 0,0:16:31.36,0:16:32.57,Default,,0,0,0,,Маған өз ісіңді айт
Dialogue: 0,0:16:33.15,0:16:35.28,Default,,0,0,0,,Бұл қысқаша әңгіме.
Dialogue: 0,0:16:35.36,0:16:40.08,Default,,0,0,0,,...
Dialogue: 0,0:16:41.66,0:16:44.92,Default,,0,0,0,,Бұл сіздің естеліктеріңізден алынған сыйлық.
Dialogue: 0,0:16:45.67,0:16:49.09,Default,,0,0,0,,...
Dialogue: 0,0:16:49.17,0:16:50.30,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:50.38,0:16:51.76,Default,,0,0,0,,Тез жетіңіз
Dialogue: 0,0:16:51.84,0:16:55.34,Default,,0,0,0,,Қарғыс атсын... Қылышты ал, Аш!
Dialogue: 0,0:16:59.76,0:17:04.14,Default,,0,0,0,,Куфуфу... Ақыры екеуміз жалғызбыз!
Dialogue: 0,0:17:08.11,0:17:11.48,Default,,0,0,0,,Ой, мен ол қолды жемеймін.
Dialogue: 0,0:17:30.09,0:17:33.84,Default,,0,0,0,,Император Сакуя маған еріп жүруді бұйырады!
Dialogue: 0,0:17:35.55,0:17:37.84,Default,,0,0,0,,Барлық шаралар қабылданды.
Dialogue: 0,0:17:37.93,0:17:40.22,Default,,0,0,0,,Сіздің Geass жұмыс істемейді.
Dialogue: 0,0:17:40.30,0:17:41.35,Default,,0,0,0,,Ах
Dialogue: 0,0:17:47.19,0:17:48.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:53.11,0:17:57.36,Default,,0,0,0,,…
Dialogue: 0,0:17:57.86,0:17:59.20,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:00.66,0:18:04.29,Default,,0,0,0,,Адамдарды еріксіз өлтіру
Dialogue: 0,0:18:08.00,0:18:09.83,Default,,0,0,0,,Неге бұлай істеп жатырсың...
Dialogue: 0,0:18:09.92,0:18:11.75,Default,,0,0,0,,Адамдарды жою
Dialogue: 0,0:18:11.84,0:18:13.34,Default,,0,0,0,,Жою?
Dialogue: 0,0:18:14.96,0:18:16.97,Default,,0,0,0,,Адамдарға жәндіктер сияқты қарау...
Dialogue: 0,0:18:17.88,0:18:20.30,Default,,0,0,0,,Адам?
Dialogue: 0,0:18:24.18,0:18:26.35,Default,,0,0,0,,Ойланып қарашы, сен
Dialogue: 0,0:18:26.43,0:18:29.73,Default,,0,0,0,,...
Dialogue: 0,0:18:29.81,0:18:31.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:36.99,0:18:38.32,Default,,0,0,0,,А...
Dialogue: 0,0:18:45.70,0:18:47.08,Default,,0,0,0,,Чарльз…
Dialogue: 0,0:18:47.70,0:18:49.75,Default,,0,0,0,,Ата?
Dialogue: 0,0:18:52.29,0:18:53.54,Default,,0,0,0,,Урья!
Dialogue: 0,0:19:00.63,0:19:04.18,Default,,0,0,0,,...
Dialogue: 0,0:19:04.26,0:19:07.27,Default,,0,0,0,,Соңында кім жеңсе, сол жеңімпаз!
Dialogue: 0,0:19:12.10,0:19:13.44,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:13.52,0:19:14.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:16.86,0:19:19.86,Default,,0,0,0,,Бұл менің жеңісім.
Dialogue: 0,0:19:21.66,0:19:24.41,Default,,0,0,0,,Күл!
Dialogue: 0,0:19:29.08,0:19:30.62,Default,,0,0,0,,Сіз…
Dialogue: 0,0:19:31.21,0:19:33.21,Default,,0,0,0,,Сен шынымен қартсың ба?
Dialogue: 0,0:19:33.79,0:19:38.59,Default,,0,0,0,,...
Dialogue: 0,0:19:38.67,0:19:41.51,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:41.59,0:19:43.59,Default,,0,0,0,,･･
Dialogue: 0,0:19:43.68,0:19:45.43,Default,,0,0,0,,Жаңа ыдыс ретінде
Dialogue: 0,0:19:45.51,0:19:46.76,Default,,0,0,0,,Адамдар жасаған
Dialogue: 0,0:19:48.06,0:19:50.02,Default,,0,0,0,,Клондау дегенді қалай түсінесіңдер?
Dialogue: 0,0:19:50.60,0:19:54.61,Default,,0,0,0,,...
Dialogue: 0,0:19:54.69,0:19:57.73,Default,,0,0,0,,...
Dialogue: 0,0:19:57.82,0:20:00.32,Default,,0,0,0,,Мен ыдыс болып қалдым.
Dialogue: 0,0:20:00.40,0:20:02.40,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:02.49,0:20:05.49,Default,,0,0,0,,Сіз қорқыныш патшалығын қайта құруға тырысасыз ба?
Dialogue: 0,0:20:05.57,0:20:06.95,Default,,0,0,0,,Мен бір нәрсеге сенімдімін: полиция араласқан күнде де өзімді қорғай аламын.
Dialogue: 0,0:20:07.03,0:20:09.20,Default,,0,0,0,,Сонда Локи не үшін қажет?
Dialogue: 0,0:20:09.29,0:20:11.04,Default,,0,0,0,,Осындай қорқынышты машина...
Dialogue: 0,0:20:11.71,0:20:15.42,Default,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:20:15.50,0:20:18.55,Default,,0,0,0,,Сіз «жою» деп айттыңыз ба?
Dialogue: 0,0:20:18.63,0:20:19.80,Default,,0,0,0,,Яғни
Dialogue: 0,0:20:19.88,0:20:22.93,Default,,0,0,0,,Барлық адамзатты жою
Dialogue: 0,0:20:24.01,0:20:25.47,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:20:26.39,0:20:28.56,Default,,0,0,0,,Сіз де бір адам емессіз.
Dialogue: 0,0:20:28.64,0:20:31.93,Default,,0,0,0,,Дәл солай... жоқ
Dialogue: 0,0:20:33.44,0:20:37.19,Default,,0,0,0,,Бұл адам өзін адамшылықтан ажырата ма?
Dialogue: 0,0:20:38.40,0:20:40.61,Default,,0,0,0,,Неліктен адамзатқа дұшпандық керек?
Dialogue: 0,0:20:41.32,0:20:43.82,Default,,0,0,0,,«Дұшпандық» дұрыс емес
Dialogue: 0,0:20:43.90,0:20:45.99,Default,,0,0,0,,Керемет мәжбүрлі суицид?
Dialogue: 0,0:20:46.07,0:20:47.62,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:47.70,0:20:49.66,Default,,0,0,0,,Өркениетті шектен тыс сынау?
Dialogue: 0,0:20:49.74,0:20:50.62,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:51.37,0:20:52.96,Default,,0,0,0,,Табиғатқа табыну?
Dialogue: 0,0:20:53.04,0:20:54.33,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:54.41,0:20:55.83,Default,,0,0,0,,Гедонизм?
Dialogue: 0,0:20:55.92,0:20:57.38,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:57.46,0:20:59.04,Default,,0,0,0,,Руинизм?
Dialogue: 0,0:20:59.13,0:21:00.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:01.05,0:21:04.51,Default,,0,0,0,,Жоқ, түсінбеймін.
Dialogue: 0,0:21:05.18,0:21:06.55,Default,,0,0,0,,Адамдардан кек алу?
Dialogue: 0,0:21:06.64,0:21:07.80,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:07.89,0:21:08.85,Default,,0,0,0,,Таңдану?
Dialogue: 0,0:21:08.93,0:21:10.01,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:10.10,0:21:11.81,Default,,0,0,0,,Танылғыңыз келді ме?
Dialogue: 0,0:21:11.89,0:21:13.23,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:14.14,0:21:15.73,Default,,0,0,0,,Физиологиялық...
Dialogue: 0,0:21:15.81,0:21:17.44,Default,,0,0,0,,Жирену?
Dialogue: 0,0:21:21.65,0:21:22.65,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:22.73,0:21:24.03,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:28.78,0:21:30.08,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:39.67,0:21:41.55,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:21:42.75,0:21:46.59,Default,,0,0,0,,Фаул жекпе-жегіндегі барлық ақпарат
Dialogue: 0,0:21:46.68,0:21:49.39,Default,,0,0,0,,менің ішіме кіріңіз
Dialogue: 0,0:22:10.53,0:22:11.70,Default,,0,0,0,,Бұл ұшақ...
Dialogue: 0,0:22:12.62,0:22:14.20,Default,,0,0,0,,Бұл Ноланд па?
Dialogue: 0,0:22:26.97,0:22:31.01,Default,,0,0,0,,Мен енді ұйықтай аламын деп ойлаймын.
Dialogue: 0,0:22:31.09,0:22:36.10,Default,,0,0,0,,♪～
Dialogue: 0,0:23:55.97,0:24:00.98,Default,,0,0,0,,～♪
Dialogue: 0,0:24:02.48,0:24:08.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory