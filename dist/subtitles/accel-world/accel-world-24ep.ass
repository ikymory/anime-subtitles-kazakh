Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.79,0:00:05.42,Default,,0,0,0,,Жүріңдер, тұрыңдар Күміс қарға
Dialogue: 0,0:00:05.67,0:00:07.50,Default,,0,0,0,,Мен оны бақылауда ұстаймын.
Dialogue: 0,0:00:08.34,0:00:10.21,Default,,0,0,0,,Сен сенің жауыңсың
Dialogue: 0,0:00:11.30,0:00:13.26,Default,,0,0,0,,Dusk Taker-ді жеңіңіз!
Dialogue: 0,0:00:13.80,0:00:14.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:20.14,0:00:24.81,Default,,0,0,0,,Хехехе... Саған қайтарамын, бірақ олар сұмдық адамдар.
Dialogue: 0,0:00:25.85,0:00:27.31,Default,,0,0,0,,Достар мен байланыстар...
Dialogue: 0,0:00:27.44,0:00:30.82,Default,,0,0,0,,Мұндай сылауды қанша уақытқа дейін жалғастыруды жоспарлайсыз?
Dialogue: 0,0:00:31.15,0:00:32.53,Default,,0,0,0,,үшінңыз жиналыңыздар!
Dialogue: 0,0:00:35.16,0:00:37.99,Default,,0,0,0,,Мен сені қатты қинаймын, өлтіремін.
Dialogue: 0,0:00:38.24,0:00:41.95,Default,,0,0,0,,Дәл өзі сияқты
Dialogue: 0,0:00:42.20,0:00:44.83,Default,,0,0,0,,Хехе...
Dialogue: 0,0:00:45.62,0:00:46.62,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:46.75,0:00:49.63,Default,,0,0,0,,Номи, сен қателестің.
Dialogue: 0,0:00:50.04,0:00:52.88,Default,,0,0,0,,Иә? Не және қашан?
Dialogue: 0,0:00:53.72,0:00:55.84,Default,,0,0,0,,Бәрі басынан бастап
Dialogue: 0,0:00:56.13,0:00:58.43,Default,,0,0,0,,Сіз Умесато орта мектебіне түскен кезде...
Dialogue: 0,0:00:58.55,0:01:01.85,Default,,0,0,0,,Біздің кез келгеніміз жақсы, жай ғана сәйкестікке өтініш беріңіз.
Dialogue: 0,0:01:01.97,0:01:05.10,Default,,0,0,0,,Танысқаныма қуаныштымын десең, жақсы болар еді.
Dialogue: 0,0:01:05.23,0:01:06.44,Default,,0,0,0,,Содан кейін-
Dialogue: 0,0:01:06.56,0:01:09.61,Default,,0,0,0,,Сіз шынымен қалаған нәрсеге қол жеткізе аласыз.
Dialogue: 0,0:01:09.94,0:01:11.94,Default,,0,0,0,,Достар мен достық
Dialogue: 0,0:01:12.65,0:01:14.36,Default,,0,0,0,,Біз шындықтан зардап шеккендер...
Dialogue: 0,0:01:14.61,0:01:18.24,Default,,0,0,0,,Мен әрқашан қалаған шынайы байланыс
Dialogue: 0,0:01:19.45,0:01:22.45,Default,,0,0,0,,Сонымен, сіз осылай айтып тұрсыз ба?
Dialogue: 0,0:01:22.58,0:01:24.87,Default,,0,0,0,,Мен сені аядым, сондықтан мен сені дос қылайын деп шештім...
Dialogue: 0,0:01:25.54,0:01:28.83,Default,,0,0,0,,Мен бұл қызметшіге көмек қолын созамын.
Dialogue: 0,0:01:29.29,0:01:29.96,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:01:30.96,0:01:34.30,Default,,0,0,0,,Сен екеуміз енді бір-бірімізді түсінбейміз.
Dialogue: 0,0:01:34.63,0:01:35.63,Default,,0,0,0,,Мәселені шешейік
Dialogue: 0,0:01:36.09,0:01:37.38,Default,,0,0,0,,Сэйдзи Номи
Dialogue: 0,0:01:37.68,0:01:40.39,Default,,0,0,0,,Мұны естігенде мен жеңілдеп қалдым.
Dialogue: 0,0:01:40.60,0:01:44.10,Default,,0,0,0,,Мәселені шешейік Харуюки Арита
Dialogue: 0,0:01:44.47,0:01:47.31,Default,,0,0,0,,Бұл әлемге екі флайер қажет емес!
Dialogue: 0,0:01:48.56,0:01:49.56,Default,,0,0,0,,Киіңіз!
Dialogue: 0,0:01:50.02,0:01:52.11,Default,,0,0,0,,Дауыл соғу құралы!
Dialogue: 0,0:01:59.82,0:02:02.95,Default,,0,0,0,,Жүр!
Dialogue: 0,0:02:06.25,0:02:07.50,Default,,0,0,0,,Чей!
Dialogue: 0,0:02:07.62,0:02:09.50,Default,,0,0,0,,Лазерлік қылыш!
Dialogue: 0,0:02:15.13,0:02:15.96,Default,,0,0,0,,Елестетіп көріңізші
Dialogue: 0,0:02:16.38,0:02:18.51,Default,,0,0,0,,Қозғағыштарды қайта зарядтаңыз
Dialogue: 0,0:02:21.97,0:02:23.81,Default,,0,0,0,,Сурет!
Dialogue: 0,0:02:26.93,0:02:28.14,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:02:30.02,0:02:30.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:33.48,0:02:34.15,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:02:35.90,0:02:39.32,Default,,0,0,0,,Жүр!
Dialogue: 0,0:02:41.07,0:02:43.91,Default,,0,0,0,,Лазерлік қылыш!
Dialogue: 0,0:02:51.67,0:02:52.63,Default,,0,0,0,,Тағы да...
Dialogue: 0,0:02:53.42,0:02:54.38,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:02:55.30,0:02:56.42,Default,,0,0,0,,Ақырында, бұл жігіт...
Dialogue: 0,0:02:56.84,0:02:57.63,Default,,0,0,0,,келді!
Dialogue: 0,0:03:06.10,0:03:09.27,Default,,0,0,0,,Жүріңіз, мистер Қарға, тағы біраз.
Dialogue: 0,0:03:09.39,0:03:11.02,Default,,0,0,0,,Жарайды, енді бірнеше күн бұрын өткізген қысқа тарих тестін қайтарып беремін.
Dialogue: 0,0:03:11.35,0:03:12.81,Default,,0,0,0,,Тағы біраз
Dialogue: 0,0:03:17.94,0:03:20.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:20.49,0:03:22.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:22.61,0:03:25.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:28.37,0:03:30.91,Default,,0,0,0,,Тағы бір соққы!
Dialogue: 0,0:03:31.62,0:03:32.33,Default,,0,0,0,,Цитрон…
Dialogue: 0,0:03:34.21,0:03:35.00,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:03:37.59,0:03:38.50,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:39.01,0:03:41.22,Default,,0,0,0,,Қоңырау шалыңыз!
Dialogue: 0,0:03:49.68,0:03:51.52,Default,,0,0,0,,Бұл өтірік, Чию!
Dialogue: 0,0:04:04.16,0:04:04.95,Default,,0,0,0,,Хахаха
Dialogue: 0,0:04:05.41,0:04:08.87,Default,,0,0,0,,Қараңызшы, бұл мүлде аз ғана адалдық емес пе?
Dialogue: 0,0:04:09.16,0:04:11.16,Default,,0,0,0,,Бұл бақылау.
Dialogue: 0,0:04:11.29,0:04:12.54,Default,,0,0,0,,Достық? байланыс?
Dialogue: 0,0:04:13.12,0:04:17.84,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:04:19.30,0:04:25.09,Default,,0,0,0,,Енді шешім қабылдау уақыты келді!
Dialogue: 0,0:04:32.89,0:04:33.56,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:34.23,0:04:35.98,Default,,0,0,0,,Не!
Dialogue: 0,0:04:55.04,0:04:56.33,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:04:59.54,0:05:01.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:11.18,0:05:11.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:12.43,0:05:13.10,Default,,0,0,0,,Харюки-кун
Dialogue: 0,0:05:15.39,0:05:16.85,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:18.44,0:05:19.61,Default,,0,0,0,,Корпус…
Dialogue: 0,0:05:23.61,0:05:24.40,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:05:27.66,0:05:30.03,Default,,0,0,0,,Енді аяқтайық
Dialogue: 0,0:05:37.62,0:05:41.84,Default,,0,0,0,,Жүр!
Dialogue: 0,0:05:42.34,0:05:44.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:44.42,0:05:47.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:12.08,0:06:15.79,Default,,0,0,0,,Менің қанаттарым неге...
Dialogue: 0,0:06:16.20,0:06:19.79,Default,,0,0,0,,Себебі менің күшім емдемейді.
Dialogue: 0,0:06:19.92,0:06:21.46,Default,,0,0,0,,Не!
Dialogue: 0,0:06:21.58,0:06:23.92,Default,,0,0,0,,Мен әрқашан ойланып келемін
Dialogue: 0,0:06:24.30,0:06:26.84,Default,,0,0,0,,Менің күшім неге емдейді?
Dialogue: 0,0:06:27.84,0:06:30.13,Default,,0,0,0,,Бірақ сен мені қорқыттың...
Dialogue: 0,0:06:30.26,0:06:32.60,Default,,0,0,0,,Мен сені бірінші рет емдегеннен кейін түсіндім
Dialogue: 0,0:06:34.60,0:06:36.27,Default,,0,0,0,,Тіпті қару да табылды...
Dialogue: 0,0:06:36.39,0:06:38.64,Default,,0,0,0,,Өкше емес, жөндеуге ұқсайды.
Dialogue: 0,0:06:38.77,0:06:39.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:39.89,0:06:41.31,Default,,0,0,0,,Мен оны осылай алдым
Dialogue: 0,0:06:41.44,0:06:44.02,Default,,0,0,0,,Менің күшім қалпына келтіру емес.
Dialogue: 0,0:06:44.19,0:06:46.69,Default,,0,0,0,,Бұл уақытты кері айналдыру күші.
Dialogue: 0,0:06:47.28,0:06:51.03,Default,,0,0,0,,Осы күшті пайдалансам, Харудың қанатын қайтарып алатыныма сенімдімін.
Dialogue: 0,0:06:51.24,0:06:53.78,Default,,0,0,0,,Күміс қарғаның қабілеті жойылғанға дейін...
Dialogue: 0,0:06:54.16,0:06:58.20,Default,,0,0,0,,Уақытты кері қайтарып, ол ешқашан болмағандай кейіптеуге болады.
Dialogue: 0,0:07:00.12,0:07:02.33,Default,,0,0,0,,Мен сізге ердім...
Dialogue: 0,0:07:02.46,0:07:06.46,Default,,0,0,0,,Арнайы қозғалысты деңгейге көтеру және кері айналдыру уақытын ұзарту.
Dialogue: 0,0:07:06.59,0:07:07.30,Default,,0,0,0,,Және-
Dialogue: 0,0:07:07.71,0:07:09.80,Default,,0,0,0,,Бүгін мен осы бір мүмкіндікті мақсат етіп отырмын!
Dialogue: 0,0:07:10.47,0:07:11.97,Default,,0,0,0,,Мен ешқашан...
Dialogue: 0,0:07:12.09,0:07:13.93,Default,,0,0,0,,Мен сенімен ешқашан дос болған емеспін!
Dialogue: 0,0:07:18.39,0:07:19.85,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:20.06,0:07:24.36,Default,,0,0,0,,Олардың бәрі ақымақ па?
Dialogue: 0,0:07:24.81,0:07:27.73,Default,,0,0,0,,Жүздеріңді көруден шаршадым.
Dialogue: 0,0:07:27.98,0:07:29.53,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:07:29.65,0:07:33.07,Default,,0,0,0,,Артқа қайтып, барлығыңыз туралы нақты ақпаратты таратыңыз...
Dialogue: 0,0:07:33.53,0:07:35.78,Default,,0,0,0,,Мен онымен айналысуды басқа біреуге тапсырамын.
Dialogue: 0,0:07:36.08,0:07:39.66,Default,,0,0,0,,Жүр, вице, тез мені алып кет!
Dialogue: 0,0:07:40.25,0:07:41.29,Default,,0,0,0,,Қандай жағдай болмасын—
Dialogue: 0,0:07:41.41,0:07:43.92,Default,,0,0,0,,Бұл жағдайда мүмкін емес, Такер мырза.
Dialogue: 0,0:07:44.25,0:07:45.92,Default,,0,0,0,,Олай болса күш сал!
Dialogue: 0,0:07:46.09,0:07:47.59,Default,,0,0,0,,Әйтпесе, оқу тобы...
Dialogue: 0,0:07:47.71,0:07:50.21,Default,,0,0,0,,Мен ми имплантаты чипі туралы ақпаратты ашамын!
Dialogue: 0,0:07:50.34,0:07:51.72,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:07:52.47,0:07:54.22,Default,,0,0,0,,Ми имплантаты чипі –
Dialogue: 0,0:07:54.34,0:07:57.10,Default,,0,0,0,,Мен ми жарылысының жоғалып кеткенін сезгенде...
Dialogue: 0,0:07:57.22,0:08:00.06,Default,,0,0,0,,Цереброспинальды сұйықтықта ериді және жоғалады.
Dialogue: 0,0:08:00.18,0:08:01.64,Default,,0,0,0,,Бұрынғы жеделдету қабілеті бар адам -
Dialogue: 0,0:08:01.77,0:08:03.98,Default,,0,0,0,,Мидың жарылуына қарсы әлем...
Dialogue: 0,0:08:04.10,0:08:06.19,Default,,0,0,0,,Ешқандай кедергі жасауға болмайды
Dialogue: 0,0:08:06.40,0:08:08.48,Default,,0,0,0,,Мұны сіз де білесіз.
Dialogue: 0,0:08:09.11,0:08:12.82,Default,,0,0,0,,Сондықтан мен бұл үшін кешірім сұраймын.
Dialogue: 0,0:08:12.95,0:08:15.36,Default,,0,0,0,,Әрине, сізге қосатын ештеңе жоқ...
Dialogue: 0,0:08:15.66,0:08:17.91,Default,,0,0,0,,Мен нақты ақпарат естіген жоқпын.
Dialogue: 0,0:08:18.74,0:08:20.87,Default,,0,0,0,,Қазір Қара патшамен соғысуда...
Dialogue: 0,0:08:21.00,0:08:24.62,Default,,0,0,0,,Мүмкін болса, мен онымен қайта айналысқым келмейтінін түсіндім.
Dialogue: 0,0:08:24.75,0:08:26.17,Default,,0,0,0,,Қайырлы күн
Dialogue: 0,0:08:26.50,0:08:27.25,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:08:37.18,0:08:38.01,Default,,0,0,0,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:08:39.43,0:08:40.52,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:08:41.27,0:08:42.93,Default,,0,0,0,,Қат! Қарғы сатқыр!
Dialogue: 0,0:08:43.06,0:08:46.23,Default,,0,0,0,,Рұқсат етілмейді! Мен мұндай дамуға жол бермеймін!
Dialogue: 0,0:08:46.35,0:08:49.65,Default,,0,0,0,,Біреу! Кез келген адам маған көмектесе алады!
Dialogue: 0,0:08:49.77,0:08:52.86,Default,,0,0,0,,Ұпайлар... Иә, мен ұпай жинаймын!
Dialogue: 0,0:08:53.61,0:08:54.28,Default,,0,0,0,,Корпус
Dialogue: 0,0:08:55.40,0:08:57.45,Default,,0,0,0,,Енді аяқтайық
Dialogue: 0,0:08:58.45,0:09:00.28,Default,,0,0,0,,Қат! Қарғы сатқыр!
Dialogue: 0,0:09:02.16,0:09:02.83,Default,,0,0,0,,О
Dialogue: 0,0:09:05.96,0:09:07.50,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:09:07.63,0:09:09.25,Default,,0,0,0,,Менің барлық ойымды орындаңыз!
Dialogue: 0,0:09:09.38,0:09:11.34,Default,,0,0,0,,Легионға қосылып, қалағаныңызды жасай аласыз.
Dialogue: 0,0:09:11.46,0:09:12.38,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:14.76,0:09:16.88,Default,,0,0,0,,Уау! Тоқта! Мен оны ұнатпаймын!
Dialogue: 0,0:09:17.01,0:09:19.18,Default,,0,0,0,,Мен оны жоғалтқым келмейді! Бұл менің күшім!
Dialogue: 0,0:09:19.47,0:09:22.01,Default,,0,0,0,,Бұл менің жеделдетуім. Мен оны ұнатпаймын. Маған ұнамайды...
Dialogue: 0,0:09:22.22,0:09:25.48,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:09:27.02,0:09:30.19,Default,,0,0,0,,Тоқташы... о...
Dialogue: 0,0:09:47.21,0:09:51.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:08.35,0:10:09.40,Default,,0,0,0,,Харюки-кун
Dialogue: 0,0:10:10.86,0:10:11.52,Default,,0,0,0,,Аға
Dialogue: 0,0:10:12.86,0:10:14.78,Default,,0,0,0,,Сенпай, мен...
Dialogue: 0,0:10:15.57,0:10:16.78,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:17.03,0:10:18.65,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:10:19.28,0:10:21.12,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:10:21.24,0:10:24.41,Default,,0,0,0,,Толық ақпаратты Токиоға оралған соң айтамын.
Dialogue: 0,0:10:25.16,0:10:27.12,Default,,0,0,0,,Такуму-кун да барын салды.
Dialogue: 0,0:10:27.58,0:10:28.58,Default,,0,0,0,,Және Курашима-кун-
Dialogue: 0,0:10:29.42,0:10:31.13,Default,,0,0,0,,Жоқ, Чиюри-кун
Dialogue: 0,0:10:36.13,0:10:37.63,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:10:38.17,0:10:39.88,Default,,0,0,0,,Маған хабарламасаңыз...
Dialogue: 0,0:10:40.01,0:10:42.72,Default,,0,0,0,,Мен мұнда асықпаймын
Dialogue: 0,0:10:43.14,0:10:45.14,Default,,0,0,0,,Жоқ! Не!
Dialogue: 0,0:10:45.60,0:10:48.48,Default,,0,0,0,,Мм... мм, шынында...
Dialogue: 0,0:10:48.60,0:10:51.94,Default,,0,0,0,,Мені өз еркіңе тастап кетесің бе деп уайымдадым...
Dialogue: 0,0:10:52.06,0:10:53.77,Default,,0,0,0,,I Дуэль шешілгенде...
Dialogue: 0,0:10:53.90,0:10:56.28,Default,,0,0,0,,Мен ағама болған оқиғаның барлығын электрондық пошта арқылы жібердім.
Dialogue: 0,0:10:56.69,0:10:57.99,Default,,0,0,0,,Не?!
Dialogue: 0,0:10:58.57,0:11:00.66,Default,,0,0,0,,Сосын мен даладан жүгіремін.
Dialogue: 0,0:11:00.78,0:11:03.16,Default,,0,0,0,,Уақытты көрсетуімді сұраған жауап алдым.
Dialogue: 0,0:11:04.83,0:11:07.24,Default,,0,0,0,,Бұл шынымен де күмәнді болды.
Dialogue: 0,0:11:07.37,0:11:10.25,Default,,0,0,0,,Мен ағама жекпе-жек уақыты туралы электрондық хат жібергенше.
Dialogue: 0,0:11:10.71,0:11:12.08,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:11:14.17,0:11:15.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:15.13,0:11:16.50,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:11:16.63,0:11:19.72,Default,,0,0,0,,Сіз маған көмектесуге 15 сағат уақытыңызды жұмсадыңыз.
Dialogue: 0,0:11:19.97,0:11:22.72,Default,,0,0,0,,Үйдің төбесінде ағамды көргенде қатты әсер еттім...
Dialogue: 0,0:11:23.39,0:11:25.14,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:11:25.26,0:11:27.60,Default,,0,0,0,,Мүмкін мен тым көп киінген шығармын.
Dialogue: 0,0:11:28.64,0:11:29.93,Default,,0,0,0,,Рахмет Чию
Dialogue: 0,0:11:30.06,0:11:32.31,Default,,0,0,0,,Тек мен және Таку болғанда, біз міндетті түрде жеңіліп қалар едік.
Dialogue: 0,0:11:32.94,0:11:35.19,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:11:35.61,0:11:39.07,Default,,0,0,0,,Не? О, мүлде...
Dialogue: 0,0:11:39.94,0:11:42.82,Default,,0,0,0,,Жалғыз сендер болсаңдар, мен уайымдамаймын...
Dialogue: 0,0:11:42.99,0:11:45.24,Default,,0,0,0,,Мен де Нега тұмандығына қосыламын.
Dialogue: 0,0:11:45.83,0:11:46.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:47.24,0:11:48.74,Default,,0,0,0,,Жарайсың ба, Сенпай?
Dialogue: 0,0:11:49.04,0:11:50.20,Default,,0,0,0,,Әрине.
Dialogue: 0,0:11:56.25,0:11:57.38,Default,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,0:11:57.92,0:11:59.59,Default,,0,0,0,,Шынайы әлемге
Dialogue: 0,0:12:07.76,0:12:09.39,Default,,0,0,0,,Иә
Dialogue: 0,0:12:09.93,0:12:13.06,Default,,0,0,0,,Мен мұндай стратегияны ойлағаныма сене алар емеспін.
Dialogue: 0,0:12:13.19,0:12:14.35,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:14.48,0:12:17.94,Default,,0,0,0,,Бізге айтсаң, біз бұлай қиналмас едік.
Dialogue: 0,0:12:18.07,0:12:18.73,Default,,0,0,0,,Иә
Dialogue: 0,0:12:19.15,0:12:24.32,Default,,0,0,0,,Білесіз бе, мен жоғарыда айтқанымдай, бұл стратегия бір реттік мүмкіндік болды.
Dialogue: 0,0:12:24.45,0:12:25.61,Default,,0,0,0,,Номи маған келсе...
Dialogue: 0,0:12:25.74,0:12:28.24,Default,,0,0,0,,Тыңдау қолданбасы немесе құрылғысы сияқты бірдеңені орнатсаңыз...
Dialogue: 0,0:12:28.37,0:12:29.58,Default,,0,0,0,,Не болды деп ойлайсың?
Dialogue: 0,0:12:29.83,0:12:30.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:30.74,0:12:33.58,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,0:12:33.71,0:12:34.83,Default,,0,0,0,,Бұл Чию болса да
Dialogue: 0,0:12:34.96,0:12:37.17,Default,,0,0,0,,Күте тұрыңыз... бұл нені білдіреді?
Dialogue: 0,0:12:39.38,0:12:41.59,Default,,0,0,0,,Амансың ба? Чи-чан
Dialogue: 0,0:12:45.47,0:12:48.14,Default,,0,0,0,,Мен... Қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:12:48.93,0:12:52.81,Default,,0,0,0,,Бұл өте қиын болды, бірақ мен бар күшімді салдым.
Dialogue: 0,0:12:52.93,0:12:54.52,Default,,0,0,0,,(Танжиро) Жарайды, бәрі қалыпты. Үйге кет, уайымдама.
Dialogue: 0,0:12:55.14,0:12:58.36,Default,,0,0,0,,Чуйу саған көп рахмет
Dialogue: 0,0:12:59.23,0:13:01.11,Default,,0,0,0,,Мен оны жақсы көремін! Екеуміз-
Dialogue: 0,0:13:01.48,0:13:03.03,Default,,0,0,0,,Мен оны жақсы көремін! (Такуму Харуюки) Уау!
Dialogue: 0,0:13:03.15,0:13:03.82,Default,,0,0,0,,Чию…
Dialogue: 0,0:13:07.03,0:13:09.28,Default,,0,0,0,,Сапар барысында маған көп қамқорлық жасалды.
Dialogue: 0,0:13:09.49,0:13:12.12,Default,,0,0,0,,Мектепте тағы да қызық болды.
Dialogue: 0,0:13:12.24,0:13:12.91,Default,,0,0,0,,Иә
Dialogue: 0,0:13:13.29,0:13:16.08,Default,,0,0,0,,Мен кәдесыйыңызды ашуды асыға күтемін.
Dialogue: 0,0:13:16.21,0:13:16.87,Default,,0,0,0,,О
Dialogue: 0,0:13:17.29,0:13:18.54,Default,,0,0,0,,Ах (Мегуми) Иә?
Dialogue: 0,0:13:29.43,0:13:30.68,Default,,0,0,0,,Сонымен... әйтеуір-
Dialogue: 0,0:13:30.80,0:13:33.77,Default,,0,0,0,,Мен сол қара вице-министрдің қамауынан қашып кеттім...
Dialogue: 0,0:13:33.89,0:13:35.43,Default,,0,0,0,,Сонда менде қуат таусылды.
Dialogue: 0,0:13:35.98,0:13:39.23,Default,,0,0,0,,Жақсы емес деп ойлағанымда, менің ағам келді.
Dialogue: 0,0:13:39.36,0:13:40.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:40.94,0:13:44.07,Default,,0,0,0,,Бірақ сіз шынымен де күшейтілген сыртын қалайсыз...
Dialogue: 0,0:13:44.19,0:13:46.28,Default,,0,0,0,,Сіз Gale Thruster шақырған кезде...
Dialogue: 0,0:13:46.40,0:13:48.07,Default,,0,0,0,,Менің жүрегім тоқтап қалады деп ойладым.
Dialogue: 0,0:13:48.74,0:13:52.33,Default,,0,0,0,,Ол саған өз ниетін үйретеді деп ойламаппын.
Dialogue: 0,0:13:52.79,0:13:54.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:54.20,0:13:57.12,Default,,0,0,0,,Ағаның рұқсатынсыз бірдеңе істеу
Dialogue: 0,0:13:57.54,0:14:00.33,Default,,0,0,0,,Саған үйретейін десем де, жарайды...
Dialogue: 0,0:14:00.46,0:14:03.05,Default,,0,0,0,,Мен сен үшін жынға айнала алмас едім.
Dialogue: 0,0:14:05.05,0:14:06.84,Default,,0,0,0,,Бұл керемет болды.
Dialogue: 0,0:14:06.97,0:14:09.05,Default,,0,0,0,,Кенет Токио мұнарасының шыңынан-
Dialogue: 0,0:14:09.18,0:14:10.97,Default,,0,0,0,,Себебі мені итеріп жіберді.
Dialogue: 0,0:14:11.14,0:14:13.22,Default,,0,0,0,,Хехе, бұл оған ұқсайды.
Dialogue: 0,0:14:13.35,0:14:14.39,Default,,0,0,0,,Хахаха
Dialogue: 0,0:14:19.81,0:14:21.65,Default,,0,0,0,,Мм... Иә?
Dialogue: 0,0:14:26.03,0:14:26.69,Default,,0,0,0,,Ах
Dialogue: 0,0:14:27.65,0:14:29.32,Default,,0,0,0,,Сен... Сенпай?
Dialogue: 0,0:14:29.95,0:14:31.24,Default,,0,0,0,,Мен мұны әрқашан істегім келді
Dialogue: 0,0:14:32.74,0:14:36.00,Default,,0,0,0,,Қанаттарыңнан айырылғаныңды... Сонда да...
Dialogue: 0,0:14:36.12,0:14:39.00,Default,,0,0,0,,Маған сенімен бетпе-бет келе жатқаным туралы хабарланған сәттен бастап...
Dialogue: 0,0:14:39.12,0:14:40.79,Default,,0,0,0,,Мен мұны әрқашан істегім келді
Dialogue: 0,0:14:41.58,0:14:43.50,Default,,0,0,0,,Сіз шынымен керемет жұмыс жасадыңыз.
Dialogue: 0,0:14:43.92,0:14:45.25,Default,,0,0,0,,Бұл ауырды
Dialogue: 0,0:14:46.09,0:14:47.17,Default,,0,0,0,,Мұндай кезде-
Dialogue: 0,0:14:47.30,0:14:49.72,Default,,0,0,0,,Мен сенің жаныңда бола алмағаным үшін кешірім сұраймын.
Dialogue: 0,0:14:50.34,0:14:53.26,Default,,0,0,0,,Мен құқығы жоқ ата-анамын.
Dialogue: 0,0:14:53.72,0:14:58.02,Default,,0,0,0,,Мен... Сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:14:58.27,0:15:01.40,Default,,0,0,0,,Мен қатты уайымдадым!
Dialogue: 0,0:15:01.56,0:15:05.94,Default,,0,0,0,,Сен жоғалып кетсең не істеймін деп қорықтым.
Dialogue: 0,0:15:06.32,0:15:08.03,Default,,0,0,0,,Бұл өте қорқынышты болды!
Dialogue: 0,0:15:12.24,0:15:15.53,Default,,0,0,0,,Иә, мен сені марапаттауым керек.
Dialogue: 0,0:15:15.66,0:15:16.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:16.79,0:15:18.50,Default,,0,0,0,,Бүгінгі аумақтық шайқаста жеңіске жеттік, солай ма?
Dialogue: 0,0:15:19.04,0:15:20.50,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:15:20.71,0:15:22.42,Default,,0,0,0,,Сугинамиді өлгенше қорғасаң...
Dialogue: 0,0:15:22.54,0:15:25.09,Default,,0,0,0,,Мен сіздің сыйлық ретінде бір ғана нәрсені айтқаныңызды естігенде,
Dialogue: 0,0:15:29.42,0:15:30.09,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:15:31.13,0:15:33.22,Default,,0,0,0,,Мен одан да күшті боламын...
Dialogue: 0,0:15:33.34,0:15:36.47,Default,,0,0,0,,Сізді кез келген жаудан қорғайды
Dialogue: 0,0:15:37.01,0:15:38.02,Default,,0,0,0,,Соған дейін...
Dialogue: 0,0:15:38.14,0:15:41.35,Default,,0,0,0,,Өтінемін, қасымда болып, мені бақылап, маған жол көрсет.
Dialogue: 0,0:15:41.69,0:15:44.48,Default,,0,0,0,,Аға, легион шебері ретінде...
Dialogue: 0,0:15:44.61,0:15:46.82,Default,,0,0,0,,Және ата-ана ретінде
Dialogue: 0,0:15:47.90,0:15:49.44,Default,,0,0,0,,...
Dialogue: 0,0:15:50.86,0:15:53.03,Default,,0,0,0,,Әрқашан жанымда
Dialogue: 0,0:15:53.16,0:15:53.82,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:54.99,0:15:57.16,Default,,0,0,0,,Менің қалағаным осы ғана
Dialogue: 0,0:16:00.29,0:16:04.21,Default,,0,0,0,,Нана... Нана... Не айтып тұрсың?
Dialogue: 0,0:16:04.75,0:16:05.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:07.75,0:16:09.92,Default,,0,0,0,,Жоқ, жоқ, жоқ, анау жігіт... Мен... Оның үстіне...
Dialogue: 0,0:16:10.09,0:16:11.97,Default,,0,0,0,,Менің айтқым келгені бұл емес!
Dialogue: 0,0:16:16.72,0:16:17.81,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:16:25.69,0:16:27.06,Default,,0,0,0,,Мен уәде беремін
Dialogue: 0,0:16:27.56,0:16:29.73,Default,,0,0,0,,Мен сенің жаныңдамын
Dialogue: 0,0:16:30.11,0:16:31.86,Default,,0,0,0,,Мәңгілік болашақ
Dialogue: 0,0:16:35.95,0:16:39.54,Default,,0,0,0,,Арита мені ұр, өтінемін, мені ұр!
Dialogue: 0,0:16:39.83,0:16:43.21,Default,,0,0,0,,Иә... Жоқ, жетеді. Әлеуметтік камера да бар...
Dialogue: 0,0:16:43.33,0:16:44.21,Default,,0,0,0,,Арита! Апыр-ай!
Dialogue: 0,0:16:44.33,0:16:45.29,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:16:46.04,0:16:48.46,Default,,0,0,0,,Ештеңе етпейді, мұғалімді де ұр!
Dialogue: 0,0:16:48.59,0:16:50.46,Default,,0,0,0,,Маған демалыс беріңізші!
Dialogue: 0,0:16:51.46,0:16:53.67,Default,,0,0,0,,Сізден күткендей, Күроюкихиме-сенпай.
Dialogue: 0,0:16:53.80,0:16:56.01,Default,,0,0,0,,Жоғалған жабдықтар тізімін қайта жазу
Dialogue: 0,0:16:56.39,0:16:57.05,Default,,0,0,0,,Рахмет-
Dialogue: 0,0:16:57.18,0:16:59.18,Default,,0,0,0,,Мен войеризм айыптарынан босатылдым, бірақ...
Dialogue: 0,0:16:59.30,0:17:01.56,Default,,0,0,0,,Мұндай жағдай күтпеген!
Dialogue: 0,0:17:03.64,0:17:07.27,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:17:10.90,0:17:11.86,Default,,0,0,0,,Номи
Dialogue: 0,0:17:16.20,0:17:16.86,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:17.32,0:17:19.03,Default,,0,0,0,,Номи-кун
Dialogue: 0,0:17:19.49,0:17:20.16,Default,,0,0,0,,Иә
Dialogue: 0,0:17:20.95,0:17:22.54,Default,,0,0,0,,Менен бірдеңе керек пе?
Dialogue: 0,0:17:22.66,0:17:26.67,Default,,0,0,0,,Е, солай... Мен Аритамын.
Dialogue: 0,0:17:26.83,0:17:29.17,Default,,0,0,0,,Харуюки Арита, 2 курс студенті
Dialogue: 0,0:17:29.54,0:17:31.42,Default,,0,0,0,,Арита-сенпай?
Dialogue: 0,0:17:31.75,0:17:34.76,Default,,0,0,0,,О, түсіндім! Ол менімен онлайн ойындар ойнады.
Dialogue: 0,0:17:35.63,0:17:37.26,Default,,0,0,0,,Иә, бірақ (Номи) Мм...
Dialogue: 0,0:17:37.84,0:17:40.60,Default,,0,0,0,,Сол ойын... Иә?
Dialogue: 0,0:17:41.76,0:17:43.02,Default,,0,0,0,,Сіздің атыңыз кім еді?
Dialogue: 0,0:17:44.64,0:17:48.56,Default,,0,0,0,,Дұрыс, ми жарылып кеткенде...
Dialogue: 0,0:17:48.69,0:17:50.73,Default,,0,0,0,,Сол естелікті өзіңізбен бірге алыңыз
Dialogue: 0,0:17:50.86,0:17:55.61,Default,,0,0,0,,Бұл жеделдетілген әлемнің бар екендігінің толықтай құпия сақталуының ең үлкен себебі.
Dialogue: 0,0:17:56.03,0:17:58.86,Default,,0,0,0,,Бірақ бұл мүмкін бе?
Dialogue: 0,0:17:58.99,0:18:01.83,Default,,0,0,0,,Қолданба адамның жадын өшіре ала ма?
Dialogue: 0,0:18:01.95,0:18:02.62,Default,,0,0,0,,Саана
Dialogue: 0,0:18:03.20,0:18:06.46,Default,,0,0,0,,Бірақ сендер білесіңдер ме?
Dialogue: 0,0:18:08.00,0:18:08.92,Default,,0,0,0,,Мегуми…
Dialogue: 0,0:18:09.29,0:18:12.25,Default,,0,0,0,,Сонымен, принципті былай қойғанда...
Dialogue: 0,0:18:12.38,0:18:14.09,Default,,0,0,0,,Солай екен деп ойламаймын.
Dialogue: 0,0:18:14.63,0:18:15.55,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:18:15.67,0:18:16.72,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:17.22,0:18:18.22,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:19.13,0:18:20.68,Default,,0,0,0,,Дауласудың қажеті жоқ.
Dialogue: 0,0:18:20.80,0:18:24.35,Default,,0,0,0,,Жауабын білгіңіз келсе, 10 деңгейге жетіңіз...
Dialogue: 0,0:18:24.77,0:18:27.10,Default,,0,0,0,,Brain Burst әзірлеушісінен сұраудан басқа амалымыз жоқ.
Dialogue: 0,0:18:28.64,0:18:30.02,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:18:30.77,0:18:34.44,Default,,0,0,0,,Біз сілтеуіштерміз.
Dialogue: 0,0:18:36.03,0:18:39.15,Default,,0,0,0,,Олай болса, егжей-тегжейлерді тыңдауға рұқсат етіңіз.
Dialogue: 0,0:18:39.28,0:18:39.95,Default,,0,0,0,,Иә
Dialogue: 0,0:18:40.36,0:18:41.03,Default,,0,0,0,,Бай
Dialogue: 0,0:18:41.87,0:18:43.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:45.16,0:18:47.33,Default,,0,0,0,,Бұл Чи Чанға қатысты.
Dialogue: 0,0:18:47.62,0:18:49.83,Default,,0,0,0,,Менің ойымша, оны әзірше құпия ұстаған дұрыс.
Dialogue: 0,0:18:50.37,0:18:51.79,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:51.92,0:18:53.42,Default,,0,0,0,,Онда мен мұны істеймін.
Dialogue: 0,0:18:58.72,0:19:00.26,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:19:00.38,0:19:03.14,Default,,0,0,0,,Жедел дүниенің барлық естеліктері өшірілсе де...
Dialogue: 0,0:19:03.60,0:19:05.43,Default,,0,0,0,,Мен сені ұмытпаймын
Dialogue: 0,0:19:06.31,0:19:07.47,Default,,0,0,0,,Оны да ешқашан ұмытпаймын.
Dialogue: 0,0:19:07.98,0:19:09.31,Default,,0,0,0,,баллоннан ауа ағады.
Dialogue: 0,0:19:09.48,0:19:13.52,Default,,0,0,0,,Мен де ағамды ешқашан ұмытпаймын.
Dialogue: 0,0:19:13.90,0:19:14.73,Default,,0,0,0,,Мен сенемін
Dialogue: 0,0:19:15.57,0:19:19.82,Default,,0,0,0,,Бұл оқиғалар тізбегі ақыры аяқталды.
Dialogue: 0,0:19:20.15,0:19:20.86,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:21.95,0:19:25.33,Default,,0,0,0,,Менің тағы бір уәдем бар.
Dialogue: 0,0:19:56.65,0:20:00.57,Default,,0,0,0,,Мм... Мен саған қанаттарыңды беремін.
Dialogue: 0,0:20:01.20,0:20:04.70,Default,,0,0,0,,Сіз күміс қанаттарыңызды қайтардыңыз, солай ма?
Dialogue: 0,0:20:04.95,0:20:06.24,Default,,0,0,0,,Үміт
Dialogue: 0,0:20:09.54,0:20:10.66,Default,,0,0,0,,...
Dialogue: 0,0:20:10.79,0:20:12.00,Default,,0,0,0,,Иә, мен оны алдым.
Dialogue: 0,0:20:13.17,0:20:13.83,Default,,0,0,0,,Қарға мырза
Dialogue: 0,0:20:14.58,0:20:17.09,Default,,0,0,0,,Мен жете алмаған биіктерге сен жетесің.
Dialogue: 0,0:20:17.34,0:20:18.67,Default,,0,0,0,,Мен сенің ұша алатыныңа сенімдімін
Dialogue: 0,0:20:18.88,0:20:21.55,Default,,0,0,0,,Мен сені қолдаймын. Іске сәт
Dialogue: 0,0:20:24.01,0:20:24.89,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:39.78,0:20:40.78,Default,,0,0,0,,Аға
Dialogue: 0,0:20:43.65,0:20:44.40,Default,,0,0,0,,Лейкер!
Dialogue: 0,0:20:47.03,0:20:48.49,Default,,0,0,0,,Қайт, Каэде
Dialogue: 0,0:20:48.66,0:20:51.20,Default,,0,0,0,,Маған сен керексің!
Dialogue: 0,0:20:56.12,0:20:56.96,Default,,0,0,0,,Сачан
Dialogue: 0,0:20:57.25,0:20:57.92,Default,,0,0,0,,Каэде!
Dialogue: 0,0:21:05.51,0:21:09.35,Default,,0,0,0,,Біз бір сәт пен мәңгіліктің арасында өмір сүреміз
Dialogue: 0,0:21:09.85,0:21:11.93,Default,,0,0,0,,Кездесу және қоштасу...
Dialogue: 0,0:21:12.27,0:21:14.56,Default,,0,0,0,,Дүниеде бәрі өзгереді...
Dialogue: 0,0:21:14.73,0:21:16.48,Default,,0,0,0,,үшін шарасыз өмір сүреді
Dialogue: 0,0:21:17.44,0:21:18.86,Default,,0,0,0,,Әрине өзгермейтін нәрселер бар.
Dialogue: 0,0:21:19.69,0:21:20.82,Default,,0,0,0,,Ол өзгерді...
Dialogue: 0,0:21:20.94,0:21:23.53,Default,,0,0,0,,Ешқашан қайтып келмейтін нәрселер бар екені сөзсіз.
Dialogue: 0,0:21:25.53,0:21:28.49,Default,,0,0,0,,Бірақ біз қазірдің өзінде білеміз
Dialogue: 0,0:21:30.41,0:21:34.29,Default,,0,0,0,,Тіпті жағдай өзгерсе де, қайта бастауға болады.
Dialogue: 0,0:22:05.90,0:22:06.65,Default,,0,0,0,,Және-
Dialogue: 0,0:22:07.61,0:22:09.78,Default,,0,0,0,,Ерік-жігер болғанша.
Dialogue: 0,0:22:11.45,0:22:14.66,Default,,0,0,0,,Адамдар әрқашан алға ұмтылады
Dialogue: 0,0:22:15.29,0:22:17.79,Default,,0,0,0,,Бұл жылдамдатуға болатынын білдіреді.
Dialogue: 0,0:22:21.13,0:22:26.13,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.66,0:23:40.66,Default,,0,0,0,,～♪
