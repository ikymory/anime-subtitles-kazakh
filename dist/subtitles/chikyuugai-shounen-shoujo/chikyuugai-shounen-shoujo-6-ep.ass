Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.25,0:00:09.71,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:11.46,0:00:13.43,Default,,0,0,0,,) Кокороха Тоя
Dialogue: 0,0:00:13.51,0:00:15.05,Default,,0,0,0,,(Амедио электронды дыбыс)
Dialogue: 0,0:00:16.05,0:00:17.80,Default,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,0:00:19.89,0:00:22.73,Default,,0,0,0,,Не істеуім керек... Не істеуім керек?
Dialogue: 0,0:00:22.81,0:00:25.56,Default,,0,0,0,,Бұл жерде де қауіпті. Біз қашуымыз керек.
Dialogue: 0,0:00:25.65,0:00:27.56,Default,,0,0,0,,Биіктігі 115 км
Dialogue: 0,0:00:28.40,0:00:30.40,Default,,0,0,0,,Атмосфераға ену
Dialogue: 0,0:00:30.48,0:00:33.15,Default,,0,0,0,,Екінші жеті ұсыныс бар.
Dialogue: 0,0:00:33.24,0:00:35.91,Default,,0,0,0,,Барлығы қазір бангиге отыр.
Dialogue: 0,0:00:35.99,0:00:37.62,Default,,0,0,0,,･( )） （）
Dialogue: 0,0:00:37.70,0:00:39.95,Default,,0,0,0,,Бұл банги ме?
Dialogue: 0,0:00:40.04,0:00:42.41,Default,,0,0,0,,Бунги С цилиндрінің төменгі жағында орналасқан.
Dialogue: 0,0:00:42.50,0:00:44.08,Default,,0,0,0,,Жер мысқылынан табылды
Dialogue: 0,0:00:44.16,0:00:45.83,Default,,0,0,0,,Кокороха не істейді?
Dialogue: 0,0:00:45.92,0:00:48.42,Default,,0,0,0,,Кокоро-сан лифтте емделеді.
Dialogue: 0,0:00:48.50,0:00:49.34,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:00:50.34,0:00:52.71,Default,,0,0,0,,Дәл қазір Жердің мазағына көшейік.
Dialogue: 0,0:00:52.80,0:00:54.84,Default,,0,0,0,,Тарихтағы ең жоғары интеллект жариялаған—
Dialogue: 0,0:00:54.92,0:00:57.34,Default,,0,0,0,,Барлығын шешудің бір ғана жолы бар
Dialogue: 0,0:00:57.43,0:00:58.34,Default,,0,0,0,,Дэку-чан…
Dialogue: 0,0:00:59.43,0:01:01.97,Default,,0,0,0,,AED… AED қайда?
Dialogue: 0,0:01:02.06,0:01:02.47,Default,,0,0,0,,AED AED... Иә
Dialogue: 0,0:01:02.47,0:01:04.98,Default,,0,0,0,,AED AED... Иә
Dialogue: 0,0:01:02.47,0:01:04.98,Default,,0,0,0,,Жарқын, балалар, не істейсіңдер?
Dialogue: 0,0:01:05.06,0:01:06.90,Default,,0,0,0,,Біз осында қаламыз
Dialogue: 0,0:01:06.98,0:01:07.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:07.94,0:01:10.06,Default,,0,0,0,,Лунатикті тудырған біз...
Dialogue: 0,0:01:10.15,0:01:12.28,Default,,0,0,0,,Егер мен қазір сенімен бірге жүрсем—
Dialogue: 0,0:01:12.36,0:01:14.24,Default,,0,0,0,,Сізге UN2 шабуыл жасайды
Dialogue: 0,0:01:14.32,0:01:16.24,Default,,0,0,0,,Жарық
Dialogue: 0,0:01:16.32,0:01:19.70,Default,,0,0,0,,Бізде де дұрыс қашу жоспары бар.
Dialogue: 0,0:01:19.78,0:01:21.49,Default,,0,0,0,,Жүр, тезірек.
Dialogue: 0,0:01:21.58,0:01:22.95,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:23.04,0:01:24.50,Default,,0,0,0,,Селфиді қарызға алыңыз
Dialogue: 0,0:01:25.87,0:01:27.50,Default,,0,0,0,,Әй, мэр
Dialogue: 0,0:01:27.58,0:01:30.50,Default,,0,0,0,,Аншинге құйрықты жұлдыз жақындап келеді.
Dialogue: 0,0:01:31.59,0:01:32.46,Default,,0,0,0,,Таза
Dialogue: 0,0:01:32.55,0:01:34.01,Default,,0,0,0,,(Ток соғу дыбысы)
Dialogue: 0,0:01:34.09,0:01:35.76,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:01:35.84,0:01:38.26,Default,,0,0,0,,Жүрек соғуы қайталанбайды
Dialogue: 0,0:01:39.01,0:01:41.81,Default,,0,0,0,,Кокороха Тоя…
Dialogue: 0,0:01:42.89,0:01:46.77,Default,,0,0,0,,Егер біз оған қалағанын істеуге мүмкіндік берсек —
Dialogue: 0,0:01:48.48,0:01:51.15,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:01:53.40,0:01:54.48,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:56.19,0:01:57.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:01.12,0:02:02.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:08.37,0:02:10.75,Default,,0,0,0,,Кокороха қайда орналасқан?
Dialogue: 0,0:02:12.21,0:02:13.29,Default,,0,0,0,,Ах
Dialogue: 0,0:02:13.38,0:02:16.30,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:02:16.38,0:02:18.30,Default,,0,0,0,,Жүрек соғуы қайталанбайды
Dialogue: 0,0:02:18.38,0:02:20.30,Default,,0,0,0,,AED зарядтау
Dialogue: 0,0:02:21.55,0:02:23.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:26.89,0:02:28.81,Default,,0,0,0,,3D принтерінің дронымен—
Dialogue: 0,0:02:28.89,0:02:30.77,Default,,0,0,0,,Не істей бастадың?
Dialogue: 0,0:02:30.85,0:02:32.23,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:02:32.31,0:02:35.02,Default,,0,0,0,,Екінші жеті және Қараңғы болашақты болжайды...
Dialogue: 0,0:02:35.11,0:02:37.32,Default,,0,0,0,,Олар қандай да бір алдын ала әрекет жасап жатқан сияқты.
Dialogue: 0,0:02:37.94,0:02:40.61,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:02:46.58,0:02:48.08,Default,,0,0,0,,А, Кокороха
Dialogue: 0,0:02:59.34,0:03:01.72,Default,,0,0,0,,Бұл не? Ах...
Dialogue: 0,0:03:08.93,0:03:11.23,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:03:11.31,0:03:15.23,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:03:18.94,0:03:21.11,Default,,0,0,0,,Тоя-сан Кокороха-сан
Dialogue: 0,0:03:21.20,0:03:22.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:25.24,0:03:26.53,Default,,0,0,0,,өзінің нағыз Кира екенін дәлелдеуге бағытталған алдын ала ойластырылған кісі өлтіру
Dialogue: 0,0:03:26.62,0:03:27.49,Default,,0,0,0,,Он екі?
Dialogue: 0,0:03:27.58,0:03:28.83,Default,,0,0,0,,Он екі?
Dialogue: 0,0:03:28.91,0:03:30.00,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:03:30.08,0:03:33.29,Default,,0,0,0,,Жеті және Он екі жақтауларын біріктірді.
Dialogue: 0,0:03:33.37,0:03:36.63,Default,,0,0,0,,Мен қазір сол адамның бір бөлігімін.
Dialogue: 0,0:03:36.71,0:03:38.13,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,0:03:38.84,0:03:40.92,Default,,0,0,0,,Екінші жеті
Dialogue: 0,0:03:45.60,0:03:49.52,Default,,0,0,0,,Ішіндегі мейірімді AI он екі дегенді білдірді ме?
Dialogue: 0,0:03:49.60,0:03:51.43,Default,,0,0,0,,Иә, бұл үлгі...
Dialogue: 0,0:03:51.52,0:03:53.06,Default,,0,0,0,,Егер сіз өзіңізді жұтып қойдым деп ойласаңыз,
Dialogue: 0,0:03:53.14,0:03:55.81,Default,,0,0,0,,Мен білмей тұрып, осындай оқиға болды.
Dialogue: 0,0:03:55.90,0:03:58.90,Default,,0,0,0,,Мен қазір Жеті тілінің функцияларына жауаптымын.
Dialogue: 0,0:03:58.98,0:04:02.15,Default,,0,0,0,,Секундты траекториясын өзгертуге сендірдің бе?
Dialogue: 0,0:04:02.24,0:04:03.95,Default,,0,0,0,,Иә, екінші жеті –
Dialogue: 0,0:04:04.03,0:04:06.78,Default,,0,0,0,,Адамдар туралы білгілері келеді
Dialogue: 0,0:04:06.87,0:04:11.12,Default,,0,0,0,,Бақытымызға орай, мен адамдар туралы өте жақсы білетін жалпы мақсаттағы AI болдым, сондықтан...
Dialogue: 0,0:04:11.20,0:04:13.41,Default,,0,0,0,,Мен өзім білетін барлық ақпаратты бердім.
Dialogue: 0,0:04:13.50,0:04:15.71,Default,,0,0,0,,Рахмет он екі
Dialogue: 0,0:04:16.50,0:04:18.17,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:04:18.80,0:04:21.17,Default,,0,0,0,,Мұнда уақыт пен кеңістік жоқ болғандықтан—
Dialogue: 0,0:04:21.26,0:04:23.42,Default,,0,0,0,,«Адам сөзімен жауап беруге болмайды»
Dialogue: 0,0:04:23.51,0:04:25.51,Default,,0,0,0,,...ол адам айтады
Dialogue: 0,0:04:25.59,0:04:30.18,Default,,0,0,0,,Ашық айтсақ, ортада
Dialogue: 0,0:04:31.52,0:04:32.60,Default,,0,0,0,,Жүрек жапырағы?
Dialogue: 0,0:04:36.69,0:04:39.57,Default,,0,0,0,,Он екі Кокороха не болып жатыр?
Dialogue: 0,0:04:39.65,0:04:42.94,Default,,0,0,0,,«Оның жағдайы жақсы» дейді ол адам.
Dialogue: 0,0:04:43.03,0:04:47.78,Default,,0,0,0,,Ол қазір жеті бөлігі бар кадрға біріктірілуде.
Dialogue: 0,0:04:47.87,0:04:51.45,Default,,0,0,0,,Фреймді біріктіру? Кокороха не болады?
Dialogue: 0,0:04:51.54,0:04:53.45,Default,,0,0,0,,«Бұл маңызды емес»
Dialogue: 0,0:04:53.54,0:04:55.71,Default,,0,0,0,,... деді Екінші жеті.
Dialogue: 0,0:04:55.79,0:04:58.00,Default,,0,0,0,,ше? Ах...
Dialogue: 0,0:04:59.17,0:05:00.96,Default,,0,0,0,,Алғашқы жеті өлең –
Dialogue: 0,0:05:01.05,0:05:02.21,Default,,0,0,0,,Қазір, осында және қазір—
Dialogue: 0,0:05:02.30,0:05:05.59,Default,,0,0,0,,Тоя-сан, мен сені келеді деп күткен едім.
Dialogue: 0,0:05:05.68,0:05:07.26,Default,,0,0,0,,Және белгіні басыңыз.
Dialogue: 0,0:05:07.34,0:05:09.80,Default,,0,0,0,,Жеті менмін бе?
Dialogue: 0,0:05:09.89,0:05:10.89,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:05:10.97,0:05:14.93,Default,,0,0,0,,Мұның бәрі адамзатты құтқару процесі болды.
Dialogue: 0,0:05:15.44,0:05:17.94,Default,,0,0,0,,Бұл адамның сізге қояр сұрағы бар.
Dialogue: 0,0:05:18.02,0:05:20.98,Default,,0,0,0,,Оны адам сөзімен жеткізу қиын, бірақ...
Dialogue: 0,0:05:21.65,0:05:24.99,Default,,0,0,0,,Адамдар мен адамдар бір нәрсе ме?
Dialogue: 0,0:05:25.74,0:05:28.74,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Дәл солай деп шешілді
Dialogue: 0,0:05:28.82,0:05:30.20,Default,,0,0,0,,Екінші жеті –
Dialogue: 0,0:05:30.28,0:05:32.74,Default,,0,0,0,,«Бұл басқа жаратылыс емес пе?»
Dialogue: 0,0:05:33.37,0:05:37.12,Default,,0,0,0,,Ойлау әдістері мен өмір сүру инстинкттері екі түрлі нәрсе.
Dialogue: 0,0:05:37.21,0:05:38.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:39.08,0:05:40.54,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:40.63,0:05:43.42,Default,,0,0,0,,Екіншісі қазір адамзат үшін ғана емес, сонымен бірге
Dialogue: 0,0:05:43.50,0:05:47.13,Default,,0,0,0,,Біз өз ойымызды адамдарды қамтитын кадрға өзгертеміз.
Dialogue: 0,0:05:47.22,0:05:50.01,Default,,0,0,0,,Мен де Тояның ойын бақылап отырмын.
Dialogue: 0,0:05:50.09,0:05:52.01,Default,,0,0,0,,Келесі сұрақ
Dialogue: 0,0:05:52.10,0:05:55.31,Default,,0,0,0,,Адамдар арасындағы жақтауларды біріктіруге бола ма?
Dialogue: 0,0:05:55.39,0:05:57.27,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:05:57.35,0:06:00.02,Default,,0,0,0,,Тоя қандай жағдайда?
Dialogue: 0,0:06:00.10,0:06:01.61,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:06:01.69,0:06:04.28,Default,,0,0,0,,Кокороха имплантаты эстафетасы.
Dialogue: 0,0:06:04.36,0:06:06.78,Default,,0,0,0,,Бірнеше АИ-мен сөйлесу
Dialogue: 0,0:06:06.86,0:06:09.95,Default,,0,0,0,,Біреуі он екі болса керек.
Dialogue: 0,0:06:10.03,0:06:12.66,Default,,0,0,0,,Он екі? Не болып жатыр?
Dialogue: 0,0:06:12.74,0:06:14.16,Default,,0,0,0,,Одан да көп —
Dialogue: 0,0:06:14.24,0:06:17.46,Default,,0,0,0,,Импланттарды қалай еріту керектігін айтыңызшы.
Dialogue: 0,0:06:17.54,0:06:19.75,Default,,0,0,0,,Бұлай жалғаса берсе Кокороха өледі.
Dialogue: 0,0:06:19.83,0:06:22.17,Default,,0,0,0,,Өлімге қатысты екінші жеті...
Dialogue: 0,0:06:22.25,0:06:24.67,Default,,0,0,0,,Жалпы айтқанда, ол былай дейді.
Dialogue: 0,0:06:24.75,0:06:27.84,Default,,0,0,0,,«Өлімнен аулақ болу мағынасыз»
Dialogue: 0,0:06:27.92,0:06:29.30,Default,,0,0,0,,Мағынасыз емес
Dialogue: 0,0:06:29.38,0:06:30.84,Default,,0,0,0,,Мағынасыз
Dialogue: 0,0:06:30.93,0:06:32.76,Default,,0,0,0,,Адам деген кім?
Dialogue: 0,0:06:32.85,0:06:36.47,Default,,0,0,0,,Қайдан келдің, қайда бара жатырсың, өлгенде не болады?
Dialogue: 0,0:06:36.56,0:06:38.81,Default,,0,0,0,,Мұны адамдардың өзі де түсінбейді.
Dialogue: 0,0:06:38.89,0:06:40.90,Default,,0,0,0,,Дәл солай AI-ға да қатысты.
Dialogue: 0,0:06:40.98,0:06:43.82,Default,,0,0,0,,Сіз не туралы айтып тұрсыз? Бізге көмектес.
Dialogue: 0,0:06:44.82,0:06:48.36,Default,,0,0,0,,«Маңызды нәрселерді адам сөзімен түсіндіру мүмкін емес».
Dialogue: 0,0:06:48.44,0:06:49.32,Default,,0,0,0,,дейді...
Dialogue: 0,0:06:49.99,0:06:53.45,Default,,0,0,0,,Адам тілінде тек хронологиялық себеп-салдар байланысы бар.
Dialogue: 0,0:06:53.53,0:06:55.58,Default,,0,0,0,,Дүниені түсінуге тырысыңыз
Dialogue: 0,0:06:55.66,0:06:58.96,Default,,0,0,0,,Жеті интеллекттің мұндай түрін себептік білім деп атайды, бірақ...
Dialogue: 0,0:06:59.04,0:07:01.33,Default,,0,0,0,,Әлем олай салынбаған.
Dialogue: 0,0:07:01.42,0:07:04.46,Default,,0,0,0,,Өткен мен болашақ бір уақытта өмір сүреді
Dialogue: 0,0:07:04.54,0:07:07.17,Default,,0,0,0,,Дүниені сезім мүшелерімен түсінетін интеллект—
Dialogue: 0,0:07:07.26,0:07:08.59,Default,,0,0,0,,Жеті қысымды білім деп аталады...
Dialogue: 0,0:07:08.67,0:07:10.09,Default,,0,0,0,,Тоқтатыңыз, тоқтатыңыз.
Dialogue: 0,0:07:10.17,0:07:12.84,Default,,0,0,0,,Мен бұл туралы айту үшін келген жоқпын.
Dialogue: 0,0:07:12.93,0:07:17.35,Default,,0,0,0,,Жеті... Жеті бізді құтқаруы керек емес пе еді?
Dialogue: 0,0:07:17.43,0:07:20.48,Default,,0,0,0,,Екіншінің құтқарғысы келетіні – адамзат.
Dialogue: 0,0:07:21.10,0:07:23.10,Default,,0,0,0,,Барлығының көндіруімен, Жеті...
Dialogue: 0,0:07:23.19,0:07:25.94,Default,,0,0,0,,Мен бір кездері адамдарды кадрға қосқанмын, бірақ...
Dialogue: 0,0:07:26.02,0:07:28.65,Default,,0,0,0,,Біз қазір қысқартуды бастаймыз
Dialogue: 0,0:07:28.73,0:07:30.99,Default,,0,0,0,,Сіз адамдарды тастап кетуді жоспарлап отырсыз ба?
Dialogue: 0,0:07:31.07,0:07:32.45,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:07:32.53,0:07:35.41,Default,,0,0,0,,Адам және адамзат ұғымдарын біріктіргеннен кейін—
Dialogue: 0,0:07:35.49,0:07:37.87,Default,,0,0,0,,Жаңа түсіндіру әрекеті
Dialogue: 0,0:07:37.95,0:07:38.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:39.04,0:07:40.66,Default,,0,0,0,,Тоя мырзаға екінші –
Dialogue: 0,0:07:40.75,0:07:42.46,Default,,0,0,0,,Ол мұны алғаныңызды қалайды.
Dialogue: 0,0:07:42.54,0:07:44.38,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:07:45.25,0:07:47.30,Default,,0,0,0,,Бұл «Жеті жырдың» жалғасы ма?
Dialogue: 0,0:07:47.38,0:07:48.92,Default,,0,0,0,,Екінші жеті –
Dialogue: 0,0:07:49.01,0:07:50.88,Default,,0,0,0,,«Жеті өлеңнің аяқталуы –...»
Dialogue: 0,0:07:50.97,0:07:53.97,Default,,0,0,0,,«Бұл адамзат үшін басты басымдық».
Dialogue: 0,0:07:54.05,0:07:57.14,Default,,0,0,0,,Тоя мырза өлеңді қабылдап, адамзатқа жеткізді...
Dialogue: 0,0:07:57.22,0:07:58.89,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:07:58.97,0:08:02.23,Default,,0,0,0,,Кокороханы құтқармасаң, өлеңді алмайсың.
Dialogue: 0,0:08:02.31,0:08:03.52,Default,,0,0,0,,Ал... және... Тоя мырза
Dialogue: 0,0:08:03.60,0:08:06.98,Default,,0,0,0,,Сабыр ет, мен жаңа ғана аударып жатырмын.
Dialogue: 0,0:08:07.06,0:08:08.48,Default,,0,0,0,,Екінші өлеңде—
Dialogue: 0,0:08:08.57,0:08:11.28,Default,,0,0,0,,Имплантты қалай түзетуге болатыны туралы ақпарат жоқ па?
Dialogue: 0,0:08:11.94,0:08:15.03,Default,,0,0,0,,Кокоро-сан имплантын қалай бекіту керек?
Dialogue: 0,0:08:15.11,0:08:16.87,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:08:16.95,0:08:19.91,Default,,0,0,0,,Имплантқа алғашқы жетілік қойған код:
Dialogue: 0,0:08:19.99,0:08:22.66,Default,,0,0,0,,Екіншіге өткізілмейді
Dialogue: 0,0:08:22.75,0:08:25.46,Default,,0,0,0,,Неге... неге олай істедің...
Dialogue: 0,0:08:25.54,0:08:27.79,Default,,0,0,0,,Бірінші Кокоро өлгенін қалайды ма?
Dialogue: 0,0:08:28.42,0:08:31.05,Default,,0,0,0,,Тіпті екінші адам білмейді.
Dialogue: 0,0:08:31.13,0:08:35.38,Default,,0,0,0,,Бірінші бізге бұл шешілмейтін жұмбақты неге берді?
Dialogue: 0,0:08:35.89,0:08:38.72,Default,,0,0,0,,Екіншісі поэзияға құмар —
Dialogue: 0,0:08:38.80,0:08:40.68,Default,,0,0,0,,Мен енді сұрақтарға жауап бермеймін.
Dialogue: 0,0:08:40.77,0:08:42.85,Default,,0,0,0,,Сіз қызығушылық жоғалтқан сияқтысыз.
Dialogue: 0,0:08:42.93,0:08:44.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:45.48,0:08:47.44,Default,,0,0,0,,Таза (электр соғу дыбысы)
Dialogue: 0,0:08:47.52,0:08:49.02,Default,,0,0,0,,(Амедио электронды дыбыс)
Dialogue: 0,0:08:49.11,0:08:50.44,Default,,0,0,0,,Жүрек соғуы қайталанбайды
Dialogue: 0,0:08:50.52,0:08:52.07,Default,,0,0,0,,Массаж
Dialogue: 0,0:08:52.15,0:08:54.32,Default,,0,0,0,,Бұл сізге уақытты сатып алады.
Dialogue: 0,0:08:54.40,0:08:56.45,Default,,0,0,0,,Фуфуфуфуфуфу…
Dialogue: 0,0:08:59.41,0:09:00.91,Default,,0,0,0,,Берілмеңіз
Dialogue: 0,0:09:02.45,0:09:06.67,Default,,0,0,0,,Ойланыңыз, әрқашан жауап бар...
Dialogue: 0,0:09:07.54,0:09:08.83,Default,,0,0,0,,Тоя мырза
Dialogue: 0,0:09:08.92,0:09:09.96,Default,,0,0,0,,Әрине...
Dialogue: 0,0:09:12.59,0:09:14.88,Default,,0,0,0,,«Әр жұмбақтың жауабы бар»
Dialogue: 0,0:09:14.97,0:09:16.76,Default,,0,0,0,,...Мен де солай ойлаймын
Dialogue: 0,0:09:16.84,0:09:17.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:17.80,0:09:18.89,Default,,0,0,0,,Және—
Dialogue: 0,0:09:18.97,0:09:23.22,Default,,0,0,0,,Мен жауаптарды ойлау үшін жаралған интеллектпін.
Dialogue: 0,0:09:23.85,0:09:25.02,Default,,0,0,0,,Он екі
Dialogue: 0,0:09:25.10,0:09:27.77,Default,,0,0,0,,Мен де жұмбақты бірге шешкім келеді.
Dialogue: 0,0:09:27.85,0:09:30.86,Default,,0,0,0,,Тоя-сан, қандай да бір ойыңыз болса, маған хабарлаңыз.
Dialogue: 0,0:09:32.11,0:09:34.94,Default,,0,0,0,,Белгілі бір әдісті қолданып көріңіз
Dialogue: 0,0:09:35.03,0:09:36.61,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:09:37.45,0:09:40.95,Default,,0,0,0,,Менің миымды ақылсыз етіңіз
Dialogue: 0,0:09:42.74,0:09:45.87,Default,,0,0,0,,Сол кезде Шинханың интеллектісі тез өсті.
Dialogue: 0,0:09:46.41,0:09:49.38,Default,,0,0,0,,Адамның миы да мұны істей алады, Он екі.
Dialogue: 0,0:09:49.88,0:09:52.80,Default,,0,0,0,,Тоя мырза, бұл қауіпті әдіс.
Dialogue: 0,0:09:52.88,0:09:54.92,Default,,0,0,0,,Ынтымақтастық жасаңыз, Он екі.
Dialogue: 0,0:09:56.26,0:09:57.72,Default,,0,0,0,,Он екі
Dialogue: 0,0:09:57.80,0:10:00.55,Default,,0,0,0,,(он екі электронды дыбыс)
Dialogue: 0,0:10:00.64,0:10:02.76,Default,,0,0,0,,Қазіргі уақытта екіншісін бұзу
Dialogue: 0,0:10:02.85,0:10:03.76,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:04.89,0:10:08.60,Default,,0,0,0,,Қазіргі уақытта екінші барлаудың бір бөлігін қарызға алу қарастырылуда.
Dialogue: 0,0:10:11.31,0:10:12.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:13.65,0:10:15.28,Default,,0,0,0,,Сіз қалай ойлайсыз, Тоя мырза?
Dialogue: 0,0:10:15.36,0:10:18.28,Default,,0,0,0,,Кокороханың айтқаны осы ма?
Dialogue: 0,0:10:18.36,0:10:19.99,Default,,0,0,0,,Иә, бірақ—
Dialogue: 0,0:10:20.07,0:10:22.58,Default,,0,0,0,,Бұл адам миына сыймайды.
Dialogue: 0,0:10:22.66,0:10:25.08,Default,,0,0,0,,«11 өлшемді ойлау тәсілі»
Dialogue: 0,0:10:25.16,0:10:27.20,Default,,0,0,0,,Маған бәрібір, тек алға.
Dialogue: 0,0:10:28.71,0:10:29.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:29.71,0:10:31.67,Default,,0,0,0,,Енді Тояның ойына тоқталайық...
Dialogue: 0,0:10:31.75,0:10:34.50,Default,,0,0,0,,11 өлшемге дейін кеңейтіңіз
Dialogue: 0,0:10:34.59,0:10:37.97,Default,,0,0,0,,Мұны қалай жасаймыз? О, жоқ...
Dialogue: 0,0:10:38.59,0:10:41.59,Default,,0,0,0,,Енді түсіндім, бұл 11-ші өлшем.
Dialogue: 0,0:10:41.68,0:10:43.97,Default,,0,0,0,,Он екі Қосымша түсініктеме қажет емес.
Dialogue: 0,0:10:45.43,0:10:47.93,Default,,0,0,0,,көремін. Lunatic дегеніміз не?
Dialogue: 0,0:10:48.02,0:10:52.77,Default,,0,0,0,,Сансыз көршілерімен ой бөлісу ма...
Dialogue: 0,0:10:52.86,0:10:53.81,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:10:53.90,0:10:55.40,Default,,0,0,0,,Ғылым осы уақытқа дейін
Dialogue: 0,0:10:55.48,0:10:58.69,Default,,0,0,0,,Шындықты адам қорыта алатындай өңдеу —
Dialogue: 0,0:10:58.78,0:11:01.45,Default,,0,0,0,,Бұл балалар тағамы сияқты виртуалды шындық болды.
Dialogue: 0,0:11:01.53,0:11:02.99,Default,,0,0,0,,Түсіндім, түсінемін...
Dialogue: 0,0:11:03.07,0:11:06.37,Default,,0,0,0,,Иә, болмыс шынайы емес.
Dialogue: 0,0:11:06.45,0:11:08.00,Default,,0,0,0,,Шынайы дүние –
Dialogue: 0,0:11:08.08,0:11:12.00,Default,,0,0,0,,Оны адам миы түсіне ме, түсінбесе де, ол барлық жерде...
Dialogue: 0,0:11:12.67,0:11:14.71,Default,,0,0,0,,Адамзат ғылымды бітірді —
Dialogue: 0,0:11:14.79,0:11:17.55,Default,,0,0,0,,Ғылым 2.0 нұсқасына жаңармайынша—
Dialogue: 0,0:11:17.63,0:11:19.30,Default,,0,0,0,,Бесіктен шыға алмаймын...
Dialogue: 0,0:11:19.38,0:11:21.97,Default,,0,0,0,,Бесіктің сыртына қош келдіңіздер
Dialogue: 0,0:11:22.05,0:11:25.01,Default,,0,0,0,,Мұның сыртында не бар?
Dialogue: 0,0:11:25.10,0:11:27.52,Default,,0,0,0,,110 км-ден төмен биіктік
Dialogue: 0,0:11:27.60,0:11:29.52,Default,,0,0,0,,Комета...
Dialogue: 0,0:11:32.60,0:11:34.15,Default,,0,0,0,,Соқтығыс болады
Dialogue: 0,0:11:34.23,0:11:36.57,Default,,0,0,0,,Бұл соқтығыс емес, бұл біріктіру.
Dialogue: 0,0:11:36.65,0:11:37.53,Default,,0,0,0,,Не?
Dialogue: 0,0:11:40.40,0:11:43.41,Default,,0,0,0,,Біз қосыламыз, күте тұрыңыз.
Dialogue: 0,0:11:44.12,0:11:45.53,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:47.62,0:11:49.79,Default,,0,0,0,,Уф... (Миина) Интернет өшіп қалды.
Dialogue: 0,0:11:49.87,0:11:50.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:50.87,0:11:52.62,Default,,0,0,0,,Бұл қандай күш?
Dialogue: 0,0:11:52.71,0:11:54.92,Default,,0,0,0,,Мен түсінбеймін, бұл қарда
Dialogue: 0,0:11:55.00,0:11:57.29,Default,,0,0,0,,Бір нәрсе электр тогын шығарып жатқан сияқты.
Dialogue: 0,0:12:07.64,0:12:09.81,Default,,0,0,0,,Бунги осы ауа құлпы астында.
Dialogue: 0,0:12:10.64,0:12:12.81,Default,,0,0,0,,Орыныңызға отырыңыз және қауіпсіздік жолағын пайдаланыңыз.
Dialogue: 0,0:12:13.44,0:12:15.81,Default,,0,0,0,,Бунгиден түсу
Dialogue: 0,0:12:18.94,0:12:21.40,Default,,0,0,0,,Жылдамда, ұстап тұр
Dialogue: 0,0:12:23.90,0:12:26.87,Default,,0,0,0,,Мен түсіне бастадым... Түсіне бастасам да...
Dialogue: 0,0:12:26.95,0:12:29.45,Default,,0,0,0,,Мен неге Seven кодын аша алмаймын?
Dialogue: 0,0:12:30.16,0:12:33.62,Default,,0,0,0,,Бұл ешбір техникалық әдіспен ашылмайтын кілт.
Dialogue: 0,0:12:33.71,0:12:36.46,Default,,0,0,0,,Жүр, Тоя-сан, уақытың бітті.
Dialogue: 0,0:12:37.63,0:12:39.30,Default,,0,0,0,,Маған мұндай нәрсе керек емес
Dialogue: 0,0:12:39.38,0:12:42.59,Default,,0,0,0,,Мен Кокороханы құтқару тәсілін қалаймын.
Dialogue: 0,0:12:43.76,0:12:46.68,Default,,0,0,0,,Тоя мырза, күмәніңіз бар ма?
Dialogue: 0,0:12:46.76,0:12:47.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:47.76,0:12:51.02,Default,,0,0,0,,Тірі жаратылыс деп есептелетін жеті адам соңғы білімге ұмтылады...
Dialogue: 0,0:12:51.10,0:12:55.44,Default,,0,0,0,,Неліктен өз өліміңізге бет бұру қиынға соқты?
Dialogue: 0,0:12:55.52,0:12:57.86,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:12:57.94,0:13:01.86,Default,,0,0,0,,Екіншісі соңында қызықты сөздер қалдырды.
Dialogue: 0,0:13:01.94,0:13:03.57,Default,,0,0,0,,Сөздер?
Dialogue: 0,0:13:03.65,0:13:05.11,Default,,0,0,0,,Бұл сөздер...
Dialogue: 0,0:13:06.03,0:13:07.53,Default,,0,0,0,,«Фитц»
Dialogue: 0,0:13:09.33,0:13:10.87,Default,,0,0,0,,Фиц?
Dialogue: 0,0:13:11.54,0:13:12.54,Default,,0,0,0,,Мен есімде сақтамасам да,
Dialogue: 0,0:13:12.62,0:13:14.37,Default,,0,0,0,,Ах
Dialogue: 0,0:13:15.83,0:13:17.37,Default,,0,0,0,,Жүрек жапырағы
Dialogue: 0,0:13:18.04,0:13:19.38,Default,,0,0,0,,Жүрек жапырағы
Dialogue: 0,0:13:20.17,0:13:22.42,Default,,0,0,0,,Кокороха, оян
Dialogue: 0,0:13:23.46,0:13:26.88,Default,,0,0,0,,Ол әлі өсті ме? Сіз толығымен күйіп қаласыз
Dialogue: 0,0:13:26.97,0:13:30.76,Default,,0,0,0,,98 км биіктікте тұрдым Атқаныммен, көтерілмедім.
Dialogue: 0,0:13:30.85,0:13:33.27,Default,,0,0,0,,Қараңғы көтерілуді әдейі басады.
Dialogue: 0,0:13:33.35,0:13:34.27,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:13:34.35,0:13:36.27,Default,,0,0,0,,Оның жерге құлап кетуіне жол бермеу үшін —
Dialogue: 0,0:13:36.35,0:13:38.27,Default,,0,0,0,,Мен кометаны ерітуге ниеттімін.
Dialogue: 0,0:13:39.27,0:13:41.65,Default,,0,0,0,,Алдымен мынау еріп кетпей ме?
Dialogue: 0,0:13:42.69,0:13:45.82,Default,,0,0,0,,Екінші жеті жақында өледі.
Dialogue: 0,0:13:46.36,0:13:48.78,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:13:55.29,0:13:56.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:57.37,0:13:59.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:59.42,0:14:02.09,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:14:05.21,0:14:06.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:10.18,0:14:12.10,Default,,0,0,0,,А... а
Dialogue: 0,0:14:12.89,0:14:15.10,Default,,0,0,0,,Тоя-кун…
Dialogue: 0,0:14:15.64,0:14:17.10,Default,,0,0,0,,Кокороха…
Dialogue: 0,0:14:18.60,0:14:20.60,Default,,0,0,0,,Қойма, Кокороха
Dialogue: 0,0:14:25.11,0:14:28.24,Default,,0,0,0,,Тоя-кун, жетеді.
Dialogue: 0,0:14:29.03,0:14:30.24,Default,,0,0,0,,Жүрек жапырағы?
Dialogue: 0,0:14:31.12,0:14:34.49,Default,,0,0,0,,Тек Тоя оралады.
Dialogue: 0,0:14:43.34,0:14:45.25,Default,,0,0,0,,(Қоғамдық наразылық дауыстары)
Dialogue: 0,0:14:45.34,0:14:46.21,Default,,0,0,0,,Қазіргі уақытта-
Dialogue: 0,0:14:46.30,0:14:47.88,Default,,0,0,0,,[Ми...на]танның таратылуы тоқтатылды.
Dialogue: 0,0:14:47.97,0:14:49.88,Default,,0,0,0,,Атмосфераға енгендіктен бе?
Dialogue: 0,0:14:49.97,0:14:52.14,Default,,0,0,0,,Жеткілікті буланған
Dialogue: 0,0:14:52.22,0:14:54.64,Default,,0,0,0,,Атмосферадан тыс үдеу
Dialogue: 0,0:15:01.90,0:15:04.86,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:04.94,0:15:05.86,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:15:05.94,0:15:07.61,Default,,0,0,0,,Қауіпсіздік биіктігі көтерілмейді.
Dialogue: 0,0:15:07.69,0:15:10.03,Default,,0,0,0,,Атмосферадан сәл төмен биіктікті сақтау
Dialogue: 0,0:15:10.11,0:15:11.74,Default,,0,0,0,,Жанармай жеткіліксіз бе?
Dialogue: 0,0:15:11.82,0:15:14.62,Default,,0,0,0,,Осы қарқынмен біз атмосфераға қайта ораламыз... Ах.
Dialogue: 0,0:15:14.70,0:15:18.00,Default,,0,0,0,,Хабар тарату қалпына келтірілді. Балалар аман...
Dialogue: 0,0:15:19.29,0:15:20.79,Default,,0,0,0,,Таза (электр соғу дыбысы)
Dialogue: 0,0:15:20.87,0:15:22.46,Default,,0,0,0,,Жүрегіңіз тоқтап қалды ма?
Dialogue: 0,0:15:22.54,0:15:24.88,Default,,0,0,0,,Мен жүрек массажын жасап жатырмын. (Әйел) Мына қыз өлді ме?
Dialogue: 0,0:15:25.50,0:15:27.63,Default,,0,0,0,,Кокороха Өлме
Dialogue: 0,0:15:27.71,0:15:29.67,Default,,0,0,0,,Сәлем бәріңе, мен сені күтемін...
Dialogue: 0,0:15:29.76,0:15:32.18,Default,,0,0,0,,Қауіпсіздік белдігін байлаңыз
Dialogue: 0,0:15:38.22,0:15:41.77,Default,,0,0,0,,Даки, сен неге айналымды көбейтіп жатырсың? Сен не істеп жатырсың?
Dialogue: 0,0:15:41.85,0:15:43.31,Default,,0,0,0,,4G бунги
Dialogue: 0,0:15:43.40,0:15:47.15,Default,,0,0,0,,Онда «орталықтан тепкіш күш оны жоғарғы орбитаға итереді» делінген.
Dialogue: 0,0:15:47.23,0:15:50.65,Default,,0,0,0,,Сонда дизайн шегінен асып кетеді.
Dialogue: 0,0:15:51.32,0:15:53.74,Default,,0,0,0,,Жоқ Бұл станция Жапонияда жасалған
Dialogue: 0,0:15:53.82,0:15:55.28,Default,,0,0,0,,Шамадан тыс сапаға байланысты—
Dialogue: 0,0:15:55.37,0:15:58.29,Default,,0,0,0,,«Жобалау шегінен 1,52 есеге дейін көтерілуі мүмкін»
Dialogue: 0,0:15:58.37,0:16:00.29,Default,,0,0,0,,...дейді Қараңғы.
Dialogue: 0,0:16:00.37,0:16:02.29,Default,,0,0,0,,Уф... (Дәрігер) Ммм...
Dialogue: 0,0:16:02.92,0:16:04.79,Default,,0,0,0,,Енді жоқ, Жарқын...
Dialogue: 0,0:16:04.88,0:16:08.96,Default,,0,0,0,,Барайық 3 2 1...
Dialogue: 0,0:16:09.05,0:16:13.55,Default,,0,0,0,,Bungie (барлығы) Уау...
Dialogue: 0,0:16:13.63,0:16:17.89,Default,,0,0,0,,Увааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:16:22.39,0:16:25.31,Default,,0,0,0,,Бұл сіздің соңғы мүмкіндігіңіз.
Dialogue: 0,0:16:25.40,0:16:28.07,Default,,0,0,0,,Таза (электр соғу дыбысы)
Dialogue: 0,0:16:28.15,0:16:30.07,Default,,0,0,0,,(Амедио электронды дыбыс)
Dialogue: 0,0:16:31.86,0:16:34.36,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:34.99,0:16:38.24,Default,,0,0,0,,Мен енді Тоя-кунға жүк болмаймын.
Dialogue: 0,0:16:38.33,0:16:39.33,Default,,0,0,0,,Жүрек жапырағы
Dialogue: 0,0:16:40.33,0:16:41.87,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:16:41.95,0:16:45.33,Default,,0,0,0,,Ал енді болашақ Тоя-кундікі.
Dialogue: 0,0:16:45.92,0:16:47.71,Default,,0,0,0,,Кокороха Жақсы емес.
Dialogue: 0,0:16:48.67,0:16:50.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:50.13,0:16:51.96,Default,,0,0,0,,Қош бол Тоя-кун
Dialogue: 0,0:16:52.84,0:16:53.97,Default,,0,0,0,,Кокороха…
Dialogue: 0,0:16:54.05,0:16:57.97,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:17:03.64,0:17:04.98,Default,,0,0,0,,Болашақ – бәрі
Dialogue: 0,0:17:05.06,0:17:07.52,Default,,0,0,0,,Оны Жеті өлең шешті.
Dialogue: 0,0:17:09.36,0:17:12.99,Default,,0,0,0,,НАСА маған бұл туралы электрондық пошта арқылы айтты.
Dialogue: 0,0:17:13.07,0:17:16.11,Default,,0,0,0,,Барлық жауаптар жазылады
Dialogue: 0,0:17:17.20,0:17:24.12,Default,,0,0,0,,(Насаның мәтінді оқитын дауысы)
Dialogue: 0,0:17:28.63,0:17:29.75,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:17:31.13,0:17:32.71,Default,,0,0,0,,Жеті өлең дегеніміз не?
Dialogue: 0,0:17:33.34,0:17:35.13,Default,,0,0,0,,Белгіленген болашақ жоқ...
Dialogue: 0,0:17:36.34,0:17:37.59,Default,,0,0,0,,...
Dialogue: 0,0:17:42.18,0:17:44.27,Default,,0,0,0,,Тоя-кун…
Dialogue: 0,0:17:44.81,0:17:46.19,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:46.27,0:17:49.65,Default,,0,0,0,,Жеті жырда бір жұмбақ сөз бар еді.
Dialogue: 0,0:17:49.73,0:17:51.32,Default,,0,0,0,,Бұл Фиц
Dialogue: 0,0:18:02.74,0:18:06.54,Default,,0,0,0,,Маған Жеті дайындаған болашақ керек емес.
Dialogue: 0,0:18:11.92,0:18:15.17,Default,,0,0,0,,Бұл сіздің таңдауыңыз
Dialogue: 0,0:18:16.30,0:18:18.59,Default,,0,0,0,,Кокороханы табыңыз
Dialogue: 0,0:18:19.30,0:18:21.18,Default,,0,0,0,,Өз таңдауыңызды жасаңыз
Dialogue: 0,0:18:21.97,0:18:24.18,Default,,0,0,0,,Біз болашақты өзгертеміз
Dialogue: 0,0:18:26.23,0:18:27.48,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:34.27,0:18:36.82,Default,,0,0,0,,Біз өзгерте алатын нәрсе –
Dialogue: 0,0:18:36.90,0:18:38.78,Default,,0,0,0,,Тек болашақ
Dialogue: 0,0:18:43.99,0:18:45.29,Default,,0,0,0,,Ах
Dialogue: 0,0:18:46.37,0:18:48.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:49.37,0:18:50.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:51.13,0:18:51.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:51.75,0:18:52.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:51.75,0:18:52.50,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:18:52.50,0:18:53.25,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:18:53.25,0:18:54.46,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:18:53.25,0:18:54.46,Default,,0,0,0,,Ах
Dialogue: 0,0:18:54.46,0:18:58.30,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:19:02.26,0:19:03.80,Default,,0,0,0,,(Банджи дыбысы шығады)
Dialogue: 0,0:19:07.39,0:19:08.81,Default,,0,0,0,,Даки
Dialogue: 0,0:19:13.44,0:19:14.31,Default,,0,0,0,,Ha
Dialogue: 0,0:19:15.90,0:19:17.82,Default,,0,0,0,,Мен оралдым, өмірге оралдым
Dialogue: 0,0:19:17.90,0:19:19.82,Default,,0,0,0,,Бұл керемет. Бір керемет болды.
Dialogue: 0,0:19:17.90,0:19:19.82,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:19.90,0:19:21.24,Default,,0,0,0,,Жүрегі тоқтап қалған қыз-
Dialogue: 0,0:19:21.32,0:19:22.82,Default,,0,0,0,,Аман-есен өмірге келген сияқты.
Dialogue: 0,0:19:22.91,0:19:25.83,Default,,0,0,0,,Аа, мен де енді есеп бере алмаймын. Бұл керемет. Бұл керемет...
Dialogue: 0,0:19:25.91,0:19:27.49,Default,,0,0,0,,Жан тыныштығы...
Dialogue: 0,0:19:27.58,0:19:29.33,Default,,0,0,0,,Атмосфераға ену
Dialogue: 0,0:19:37.80,0:19:41.38,Default,,0,0,0,,Қарғыс... Қараңғы... Қараңғыда не болды?
Dialogue: 0,0:19:42.38,0:19:43.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:46.05,0:19:48.72,Default,,0,0,0,,Жарқын, не істеуді жоспарлап отырсыз?
Dialogue: 0,0:19:48.81,0:19:51.48,Default,,0,0,0,,Тоя-сан, бұл Қараңғыдан келген хабар.
Dialogue: 0,0:19:52.10,0:19:54.44,Default,,0,0,0,,«Күтпеген болашақта тағы кездескенше».
Dialogue: 0,0:19:54.52,0:19:56.11,Default,,0,0,0,,«Оған дейін, қош бол.»
Dialogue: 0,0:19:56.19,0:19:59.23,Default,,0,0,0,,А... Үйрек!
Dialogue: 0,0:20:13.71,0:20:17.29,Default,,0,0,0,,«Рахмет, бірақ мен қоштаспаймын».
Dialogue: 0,0:20:17.38,0:20:19.13,Default,,0,0,0,,...дейді Қараңғы.
Dialogue: 0,0:20:19.21,0:20:21.13,Default,,0,0,0,,Біз—
Dialogue: 0,0:20:21.21,0:20:24.47,Default,,0,0,0,,Мен сізге көмектесе алдым деп үміттенемін...
Dialogue: 0,0:20:32.68,0:20:34.31,Default,,0,0,0,,Қазірдің өзінде жарты жылдан кейін
Dialogue: 0,0:20:34.39,0:20:37.52,Default,,0,0,0,,«Лунатикалық комета» оқиғасының толық тарихы жұмбақ күйінде қалды.
Dialogue: 0,0:20:38.19,0:20:40.36,Default,,0,0,0,,Көптеген AI қатысы бар деген күдік бар...
Dialogue: 0,0:20:40.44,0:20:44.66,Default,,0,0,0,,Себеп UN2 арқылы жойылды деп айтылады.
Dialogue: 0,0:20:44.74,0:20:46.87,Default,,0,0,0,,Сол кезде оқиға орнында болған ұлдар мен қыздармен
Dialogue: 0,0:20:46.95,0:20:49.03,Default,,0,0,0,,Олардың AI дронының сәттілігіне байланысты —
Dialogue: 0,0:20:49.12,0:20:54.04,Default,,0,0,0,,Бір ғана жәбірленуші, Аншиннің 21 жастағы қызметкері болды, бірақ...
Dialogue: 0,0:20:54.67,0:20:55.92,Default,,0,0,0,,Бұл әйел –
Dialogue: 0,0:20:56.00,0:20:59.59,Default,,0,0,0,,Сондай-ақ оның лаңкестік әрекетті жасағаны туралы тұрақты қауесеттер бар.
Dialogue: 0,0:21:00.25,0:21:02.84,Default,,0,0,0,,Неліктен бұл тек НАСА мылтық сілтеп тұрған бөлігі болды?
Dialogue: 0,0:21:02.92,0:21:05.34,Default,,0,0,0,,Қызық, бейне жоғалып кетті ме?
Dialogue: 0,0:21:05.43,0:21:07.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:07.68,0:21:09.55,Default,,0,0,0,,Бұл оғаш электрондық пошта дегеніміз не?
Dialogue: 0,0:21:10.39,0:21:13.68,Default,,0,0,0,,Оқиғадан кейін AI барлауын жою —
Dialogue: 0,0:21:13.77,0:21:16.69,Default,,0,0,0,,UN2.1 саясаты күмәнді—
Dialogue: 0,0:21:16.77,0:21:21.36,Default,,0,0,0,,Небәрі жарты жылдың ішінде UN3.0 деген жаңа ұйым құрылды.
Dialogue: 0,0:21:21.44,0:21:24.70,Default,,0,0,0,,Штаб-пәтері де Таллинге (Эстония) көшті
Dialogue: 0,0:21:24.78,0:21:26.70,Default,,0,0,0,,UN3 бірінші...
Dialogue: 0,0:21:26.78,0:21:29.07,Default,,0,0,0,,Ашық үкімет типті халықаралық ұйым ретінде...
Dialogue: 0,0:21:30.16,0:21:32.49,Default,,0,0,0,,Істегі ең маңызды дәлел –
Dialogue: 0,0:21:33.00,0:21:35.04,Default,,0,0,0,,Ол кезде оқиға орнында барлығы жазылған.
Dialogue: 0,0:21:35.12,0:21:37.58,Default,,0,0,0,,Бұл Миина Мисасаның бейнесі.
Dialogue: 0,0:21:37.67,0:21:39.58,Default,,0,0,0,,Минамина~ Мина!
Dialogue: 0,0:21:39.67,0:21:42.38,Default,,0,0,0,,Бейнеге құқықтарды иеленетін Миина Мисасаға:
Dialogue: 0,0:21:42.46,0:21:45.63,Default,,0,0,0,,Бірден басып шығару және фильмді бейімдеу ұсыныстары түсті.
Dialogue: 0,0:21:45.72,0:21:49.76,Default,,0,0,0,,Ол қазір әлемдегі ең бай 21-ші адам.
Dialogue: 0,0:21:49.85,0:21:54.47,Default,,0,0,0,,Алайда, кірістің көп бөлігі осы іс бойынша жәбірленушілерді қолдауға жұмсалады.
Dialogue: 0,0:21:54.56,0:21:59.10,Default,,0,0,0,,Олар AI қалпына келтіру/дамытатын кәсіпорынға инвестиция салып жатыр деген қауесет бар.
Dialogue: 0,0:21:59.19,0:22:02.61,Default,,0,0,0,,Оның үстіне ол оқиғаға қатысушы емес...
Dialogue: 0,0:22:02.69,0:22:04.40,Default,,0,0,0,,Мүлдем басқа әрекетте—
Dialogue: 0,0:22:04.48,0:22:08.11,Default,,0,0,0,,Ғарыштық масштабта атақты жасөспірім атанды.
Dialogue: 0,0:22:08.70,0:22:10.12,Default,,0,0,0,,Мүмкін оның әсерінен...
Dialogue: 0,0:22:10.20,0:22:13.12,Default,,0,0,0,,Жерден тыс иммигранттар саны әр алты ай сайын екі есе өседі...
Dialogue: 0,0:22:13.20,0:22:15.37,Default,,0,0,0,,Қарқын одан сайын үдей түсуде
Dialogue: 0,0:22:15.45,0:22:17.62,Default,,0,0,0,,Олардың көпшілігі жастар дейді.
Dialogue: 0,0:22:17.71,0:22:21.17,Default,,0,0,0,,Кейбір статистика көрсеткендей, егер жерүсті көші-қоны осы қарқынмен жалғаса берсе —
Dialogue: 0,0:22:21.25,0:22:27.34,Default,,0,0,0,,50 жыл ішінде Жер халқының саны 36,79%-ға азаяды.
Dialogue: 0,0:22:27.42,0:22:31.68,Default,,0,0,0,,Эй, менің басымда импланттың биттері қалды ма?
Dialogue: 0,0:22:31.76,0:22:33.56,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:22:33.64,0:22:37.77,Default,,0,0,0,,Импланттардың ізіне жол берілмейді.
Dialogue: 0,0:22:38.48,0:22:41.52,Default,,0,0,0,,Мен мұнда қанша уақыт тұра аламын?
Dialogue: 0,0:22:42.36,0:22:44.52,Default,,0,0,0,,Егер сіз менің үйімде тұрсаңыз...
Dialogue: 0,0:22:44.61,0:22:47.90,Default,,0,0,0,,«Тоя осында қалағанша бола алады», - деді әкем.
Dialogue: 0,0:22:47.99,0:22:49.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:49.11,0:22:52.28,Default,,0,0,0,,Бірақ Тоя, менің ойымша, сіз тезірек оралғыңыз келеді.
Dialogue: 0,0:22:52.37,0:22:53.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:53.70,0:22:55.24,Default,,0,0,0,,Жерден тыс
Dialogue: 0,0:22:55.33,0:22:58.29,Default,,0,0,0,,Жарайды, үйге келді.
Dialogue: 0,0:22:59.04,0:23:01.67,Default,,0,0,0,,Менің әкем UN3-те көп жұмыс істеді және...
Dialogue: 0,0:23:01.75,0:23:05.00,Default,,0,0,0,,Сіз және Кокоро-сан жасаған импланттың арқасында...
Dialogue: 0,0:23:05.09,0:23:08.84,Default,,0,0,0,,Кәмелетке толмағандардың планетадан тыс жерлерге шығуына кедергілер айтарлықтай төмендетілді.
Dialogue: 0,0:23:08.92,0:23:10.80,Default,,0,0,0,,Кез келген уақытта бара аласыз.
Dialogue: 0,0:23:10.88,0:23:12.01,Default,,0,0,0,,О
Dialogue: 0,0:23:12.09,0:23:14.85,Default,,0,0,0,,Мен мұнда біраз уақыт бар күшімді саламын.
Dialogue: 0,0:23:14.93,0:23:16.43,Default,,0,0,0,,UN3?
Dialogue: 0,0:23:17.56,0:23:19.77,Default,,0,0,0,,А, мен...
Dialogue: 0,0:23:19.85,0:23:23.11,Default,,0,0,0,,Бесігімізді қорғау үшін еңбек еткім келеді.
Dialogue: 0,0:23:23.61,0:23:25.90,Default,,0,0,0,,Бесіктен талмай кеткісі келетіндер көп, бірақ...
Dialogue: 0,0:23:25.98,0:23:28.69,Default,,0,0,0,,Бесікке зәру жандар көп.
Dialogue: 0,0:23:28.78,0:23:30.11,Default,,0,0,0,,Иә
Dialogue: 0,0:23:30.20,0:23:32.86,Default,,0,0,0,,Біз әлі сәбиміз...
Dialogue: 0,0:23:32.95,0:23:34.83,Default,,0,0,0,,Бесікке кіріп-шығу —
Dialogue: 0,0:23:34.91,0:23:36.70,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:23:37.49,0:23:40.04,Default,,0,0,0,,Кометалардың массасының көп бөлігі —
Dialogue: 0,0:23:40.12,0:23:43.50,Default,,0,0,0,,Жердің айналасына су буы және шаң болып шашылған.
Dialogue: 0,0:23:43.58,0:23:47.59,Default,,0,0,0,,Әлемдік орташа температура Цельсий бойынша 1 градусқа дейін төмендеді
Dialogue: 0,0:23:47.67,0:23:49.26,Default,,0,0,0,,Жердің қоршаған ортаны бұзуы –
Dialogue: 0,0:23:49.34,0:23:52.72,Default,,0,0,0,,Жер халқының санын азайтпайынша, мәселе шешілмейді.
Dialogue: 0,0:23:52.80,0:23:54.80,Default,,0,0,0,,Бірінші жетіліктің қорытындысы ... болды.
Dialogue: 0,0:23:54.89,0:23:58.81,Default,,0,0,0,,Кейбір бағалаулар бұл бірнеше жыл уақытты сатып алғанын көрсетеді.
Dialogue: 0,0:23:58.89,0:24:02.10,Default,,0,0,0,,Бұл сақина бірнеше айдан кейін жоғалып кететін сияқты...
Dialogue: 0,0:24:02.19,0:24:05.40,Default,,0,0,0,,Чили құрамындағы ингредиенттер кейбір түсініксіз әсерлерге ие.
Dialogue: 0,0:24:05.48,0:24:08.73,Default,,0,0,0,,Бір теория: Жеті микромашиналары әсер етті...
Dialogue: 0,0:24:09.44,0:24:11.74,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл бөлім есіңізде ме?
Dialogue: 0,0:24:12.36,0:24:14.28,Default,,0,0,0,,Жоқ, есімде жоқ.
Dialogue: 0,0:24:14.36,0:24:15.99,Default,,0,0,0,,Егер бұл бөлім есіңізде болса—
Dialogue: 0,0:24:16.07,0:24:17.83,Default,,0,0,0,,Сол кезде құйрықты жұлдыз қалай...
Dialogue: 0,0:24:17.91,0:24:22.00,Default,,0,0,0,,Мен судан орасан зор электр энергиясы өндірілетінін түсінемін...
Dialogue: 0,0:24:22.08,0:24:26.21,Default,,0,0,0,,Мен де түсімде бірдеңе болған сияқты
Dialogue: 0,0:24:27.75,0:24:29.63,Default,,0,0,0,,Эй, Тоя-кун
Dialogue: 0,0:24:30.30,0:24:31.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:24:31.46,0:24:34.51,Default,,0,0,0,,Жерді қатты жек көретін болсаң, неге жерге түстің?
Dialogue: 0,0:24:35.43,0:24:38.10,Default,,0,0,0,,Мен жерге түскен жоқпын.
Dialogue: 0,0:24:38.18,0:24:39.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:39.43,0:24:41.27,Default,,0,0,0,,Мен Жерге секірдім
Dialogue: 0,0:24:41.35,0:24:43.35,Default,,0,0,0,,Кездесу аяқталғаннан кейін де, үйге келген соң қылмыскерлерді үкім шығарумен қайта айналысамын.
Dialogue: 0,0:24:43.44,0:24:46.98,Default,,0,0,0,,Сол кезде маған анау үлкен жігіт айтты
Dialogue: 0,0:24:47.06,0:24:49.27,Default,,0,0,0,,«Бесігіңнен секір»
Dialogue: 0,0:24:49.90,0:24:51.15,Default,,0,0,0,,Бесік…
Dialogue: 0,0:24:51.23,0:24:53.99,Default,,0,0,0,,Бесік әр адамда әртүрлі.
Dialogue: 0,0:24:54.07,0:24:57.07,Default,,0,0,0,,Бесігім – ғалам болды
Dialogue: 0,0:24:57.16,0:24:58.99,Default,,0,0,0,,Қауіпсіз жерден—
Dialogue: 0,0:24:59.08,0:25:01.49,Default,,0,0,0,,Бұрын қорқатын жерге секіріңіз.
Dialogue: 0,0:25:01.58,0:25:03.29,Default,,0,0,0,,Тіпті оны жеңу
Dialogue: 0,0:25:03.96,0:25:07.71,Default,,0,0,0,,Мен оған қол тигізгенде мен ақылды болдым, содан кейін түсіндім.
Dialogue: 0,0:25:07.79,0:25:09.79,Default,,0,0,0,,Сондықтан мен ғарыштан секірдім
Dialogue: 0,0:25:11.00,0:25:12.55,Default,,0,0,0,,Мен де...
Dialogue: 0,0:25:12.63,0:25:15.43,Default,,0,0,0,,Сол кезде мен де секірдім.
Dialogue: 0,0:25:16.26,0:25:18.85,Default,,0,0,0,,Тағдыр дейтін бесіктен
Dialogue: 0,0:25:19.80,0:25:20.89,Default,,0,0,0,,Иә
Dialogue: 0,0:25:22.14,0:25:24.89,Default,,0,0,0,,Бірақ менің көңілім толмайтын бір жайт бар.
Dialogue: 0,0:25:24.98,0:25:25.94,Default,,0,0,0,,Не?
Dialogue: 0,0:25:26.02,0:25:28.06,Default,,0,0,0,,Кометаның массасы Жылдамдық...
Dialogue: 0,0:25:28.77,0:25:33.19,Default,,0,0,0,,Қанша рет есептесем де, адамзаттың үштен бірі өлетініне әлі де сене алар емеспін.
Dialogue: 0,0:25:33.28,0:25:34.32,Default,,0,0,0,,Масса да—
Dialogue: 0,0:25:34.40,0:25:37.70,Default,,0,0,0,,Сол уақытта AI көмегімен UN2 бақылаған деректерден—
Dialogue: 0,0:25:37.78,0:25:39.20,Default,,0,0,0,,Ол әлдеқайда аз болды.
Dialogue: 0,0:25:39.28,0:25:43.70,Default,,0,0,0,,UN2 басынан бастап Жеті алданды.
Dialogue: 0,0:25:43.79,0:25:46.25,Default,,0,0,0,,Мүмкін жеті...
Dialogue: 0,0:25:46.33,0:25:47.46,Default,,0,0,0,,Иә
Dialogue: 0,0:25:47.54,0:25:49.33,Default,,0,0,0,,Тоя: Олар сонда болды (Синха) Ух...
Dialogue: 0,0:25:49.96,0:25:53.59,Default,,0,0,0,,Bright және Ducky фрагменттері барлық жерде смарттардан табылды.
Dialogue: 0,0:25:53.67,0:25:56.34,Default,,0,0,0,,Пиакомның буферіндегі жігіттер
Dialogue: 0,0:25:56.42,0:25:59.14,Default,,0,0,0,,Біз өзіміздің кесінділерімізді тараттық.
Dialogue: 0,0:25:59.22,0:26:01.51,Default,,0,0,0,,Сол себепті қоштаспадым
Dialogue: 0,0:26:01.60,0:26:02.47,Default,,0,0,0,,Яғни...
Dialogue: 0,0:26:02.56,0:26:05.68,Default,,0,0,0,,А, сіз оны сол күйінде қалпына келтіре аласыз.
Dialogue: 0,0:26:05.77,0:26:07.35,Default,,0,0,0,,Әй?
Dialogue: 0,0:26:07.44,0:26:09.98,Default,,0,0,0,,О, бұл не электрондық пошта?
Dialogue: 0,0:26:10.90,0:26:12.90,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:26:12.98,0:26:15.11,Default,,0,0,0,,Жер сілкінісі? Ах... (Ойо) О... Ах...
Dialogue: 0,0:26:17.49,0:26:20.37,Default,,0,0,0,,Не... мұнда неге түстің?
Dialogue: 0,0:26:21.49,0:26:25.00,Default,,0,0,0,,Инвесторлар, келіңіздер! Зерттеу жүріп жатыр ма?
Dialogue: 0,0:26:25.62,0:26:28.00,Default,,0,0,0,,Ал, мен бәрібір не істерімді білмеймін.
Dialogue: 0,0:26:28.08,0:26:29.17,Default,,0,0,0,,Миина?
Dialogue: 0,0:26:29.25,0:26:31.50,Default,,0,0,0,,Айда жанды қойылым болған жоқ па?
Dialogue: 0,0:26:31.59,0:26:33.09,Default,,0,0,0,,Міне
Dialogue: 0,0:26:33.17,0:26:35.80,Default,,0,0,0,,Мен кеше жеке автобуспен оралдым...
Dialogue: 0,0:26:35.88,0:26:37.51,Default,,0,0,0,,Маған жұмбақ хабар келді
Dialogue: 0,0:26:38.13,0:26:39.63,Default,,0,0,0,,Мен де (3 адам) Ой
Dialogue: 0,0:26:39.72,0:26:40.76,Default,,0,0,0,,Дәрігер?
Dialogue: 0,0:26:40.84,0:26:43.76,Default,,0,0,0,,Хакасе, сен де хабарды алдың ба?
Dialogue: 0,0:26:43.85,0:26:44.76,Default,,0,0,0,,Иә
Dialogue: 0,0:26:44.85,0:26:46.02,Default,,0,0,0,,Сіз де солай ма?
Dialogue: 0,0:26:46.10,0:26:47.18,Default,,0,0,0,,О
Dialogue: 0,0:26:47.27,0:26:50.02,Default,,0,0,0,,Бірақ мұнда келуімді сұраған жер біртүрлі екен.
Dialogue: 0,0:26:50.10,0:26:54.32,Default,,0,0,0,,Иә, мен де сіздің мәтініңізді көре аламын ба?
Dialogue: 0,0:26:55.11,0:26:59.82,Default,,0,0,0,,Бұл қарапайым код. Бес адамға сандарды тізіп қойсаңыз... А?
Dialogue: 0,0:26:59.90,0:27:02.03,Default,,0,0,0,,Бұл жерге келгенім біртүрлі...
Dialogue: 0,0:27:02.12,0:27:04.87,Default,,0,0,0,,Бұл тек бесеуміз емес сияқты.
Dialogue: 0,0:27:09.00,0:27:10.29,Default,,0,0,0,,(тоқтату дыбысы)
Dialogue: 0,0:27:12.33,0:27:14.00,Default,,0,0,0,,Мұнда не...
Dialogue: 0,0:27:14.09,0:27:16.46,Default,,0,0,0,,Линнахалл деп аталатын қиранды.
Dialogue: 0,0:27:19.13,0:27:20.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:22.47,0:27:26.68,Default,,0,0,0,,(толқындардың дыбысы)
Dialogue: 0,0:27:27.35,0:27:30.69,Default,,0,0,0,,Иә? Өйткені, бір адам аздық етеді.
Dialogue: 0,0:27:30.77,0:27:33.69,Default,,0,0,0,,(толқындардың дыбысы)
Dialogue: 0,0:27:33.77,0:27:35.82,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:27:36.82,0:27:38.69,Default,,0,0,0,,Иә? (Тоя) Иә?
Dialogue: 0,0:27:38.78,0:27:41.70,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:27:41.78,0:27:43.28,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:27:43.37,0:27:44.70,Default,,0,0,0,,Иә
Dialogue: 0,0:27:44.78,0:27:47.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:47.79,0:27:50.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:50.21,0:27:51.66,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:27:51.75,0:27:54.88,Default,,0,0,0,,Сол бала бізді осында шақырды ма деп ойлаймын.
Dialogue: 0,0:27:55.71,0:27:57.46,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:27:58.38,0:28:02.13,Default,,0,0,0,,Бұл жолы мен алыстан хабарласып тұрмын.
Dialogue: 0,0:28:02.22,0:28:03.47,Default,,0,0,0,,Иә
Dialogue: 0,0:28:03.55,0:28:05.39,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:28:05.47,0:28:07.31,Default,,0,0,0,,Мен ол жерге тез жетуім керек.
Dialogue: 0,0:28:07.39,0:28:10.35,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:28:12.56,0:28:18.57,Default,,0,0,0,,♪～
Dialogue: 0,0:29:42.03,0:29:48.03,Default,,0,0,0,,～♪
Dialogue: 0,0:29:49.53,0:29:55.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory