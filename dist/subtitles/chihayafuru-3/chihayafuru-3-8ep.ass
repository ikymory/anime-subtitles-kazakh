Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:10.94,0:01:15.95,Default,,0,0,0,,～♪
Dialogue: 0,0:01:18.82,0:01:22.33,Default,,0,0,0,,Кинкакуджи Ресми аты: Рокуонджи
Dialogue: 0,0:01:22.41,0:01:25.83,Default,,0,0,0,,Йошимицу Ашикага салған Шариден әсіресе әйгілі.
Dialogue: 0,0:01:25.91,0:01:27.92,Default,,0,0,0,,Дүниежүзілік мұра нысаны ретінде тіркелген
Dialogue: 0,0:01:28.00,0:01:28.83,Default,,0,0,0,,және жолдастарыммен бірге оларды қоршап алдық».
Dialogue: 0,0:01:28.92,0:01:30.88,Default,,0,0,0,,Бұл ақша (ер студент) Ақшаның мәні неде?
Dialogue: 0,0:01:30.96,0:01:31.42,Default,,0,0,0,,Алтын
Dialogue: 0,0:01:31.42,0:01:32.05,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:31.42,0:01:32.05,Default,,0,0,0,,Алтын
Dialogue: 0,0:01:32.05,0:01:32.13,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:32.13,0:01:34.34,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:32.13,0:01:34.34,Default,,0,0,0,,Жұмақ сезімі керемет.
Dialogue: 0,0:01:34.34,0:01:34.71,Default,,0,0,0,,Жұмақ сезімі керемет.
Dialogue: 0,0:01:34.80,0:01:36.42,Default,,0,0,0,,Чи Чан, бірге суретке түсейік
Dialogue: 0,0:01:36.51,0:01:38.93,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:01:39.01,0:01:39.93,Default,,0,0,0,,Чи-чан?
Dialogue: 0,0:01:40.01,0:01:44.56,Default,,0,0,0,,Түні бойы ойласаң да бір ғана жауап шығады.
Dialogue: 0,0:01:44.64,0:01:45.81,Default,,0,0,0,,Чи-чан?
Dialogue: 0,0:01:46.73,0:01:50.11,Default,,0,0,0,,Карутаны жүрегіңіздің қалауымен ойнай алатын жалғыз уақыт - қазір...
Dialogue: 0,0:01:50.19,0:01:52.69,Default,,0,0,0,,Мен білмедім, Тайчи.
Dialogue: 0,0:01:52.77,0:01:57.11,Default,,0,0,0,,Мен Тайчидің шебер болуды мақсат еткеніне сене алмаймын!
Dialogue: 0,0:01:59.28,0:02:00.95,Default,,0,0,0,,Байқамадым
Dialogue: 0,0:02:02.03,0:02:05.16,Default,,0,0,0,,Кірпік-кун мектеп саяхатын бұлғағанша
Dialogue: 0,0:02:05.25,0:02:07.96,Default,,0,0,0,,Ол шебер болуды шындап мақсат етті.
Dialogue: 0,0:02:09.42,0:02:12.04,Default,,0,0,0,,Мұғалім, қатыгез қимылдарыңызды тоқтатыңыз.
Dialogue: 0,0:02:12.13,0:02:13.59,Default,,0,0,0,,Такси тоқтады.
Dialogue: 0,0:02:13.67,0:02:15.13,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:02:16.71,0:02:19.55,Default,,0,0,0,,Мен сияқты!
Dialogue: 0,0:02:24.81,0:02:27.93,Default,,0,0,0,,Харада Сенсей биыл да
Dialogue: 0,0:02:28.02,0:02:32.61,Default,,0,0,0,,Бұл ақылсыз, сен 57-десің, толқыдың.
Dialogue: 0,0:02:44.74,0:02:46.08,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:46.16,0:02:48.66,Default,,0,0,0,,Жоқ, бұл Маютанды ұятқа қалдырады
Dialogue: 0,0:02:48.75,0:02:51.54,Default,,0,0,0,,Қаншалықты тез көтерілсем де, бұл соңғы жылдары сирек.
Dialogue: 0,0:02:51.62,0:02:53.08,Default,,0,0,0,,Мамандар жылдам
Dialogue: 0,0:02:53.17,0:02:55.00,Default,,0,0,0,,Бұл дұрыс емес, Аккун.
Dialogue: 0,0:02:55.92,0:02:57.80,Default,,0,0,0,,Йошино-кай турниріндегі жеңіс пен жеңілістің айырмашылығы неде?
Dialogue: 0,0:02:57.88,0:02:59.22,Default,,0,0,0,,Бірінші жартыжылдық нұсқаулары
Dialogue: 0,0:02:59.30,0:03:01.68,Default,,0,0,0,,Менің қабілетім жоғары!
Dialogue: 0,0:03:01.76,0:03:03.93,Default,,0,0,0,,Жеңіс пен жеңілістің айырмашылығы бірінші таймдағы шеберлік болды.
Dialogue: 0,0:03:04.01,0:03:06.18,Default,,0,0,0,,Менің қабілетім жоғары!
Dialogue: 0,0:03:06.26,0:03:08.31,Default,,0,0,0,,Қарғыс атсын, Шығыс Жапонияның іріктеу кезеңіне дейін.
Dialogue: 0,0:03:08.39,0:03:09.48,Default,,0,0,0,,А сыныбына ие болыңыз және Машима болыңыз
Dialogue: 0,0:03:09.56,0:03:11.69,Default,,0,0,0,,Мен қуып жетуім керек еді!
Dialogue: 0,0:03:11.77,0:03:12.65,Default,,0,0,0,,Ах
Dialogue: 0,0:03:16.52,0:03:18.40,Default,,0,0,0,,Мм... кешіріңіз (Хироши)?
Dialogue: 0,0:03:19.19,0:03:21.36,Default,,0,0,0,,Мен қатысуға өтініш бердім.
Dialogue: 0,0:03:21.45,0:03:22.61,Default,,0,0,0,,Қатыспаңыз.
Dialogue: 0,0:03:22.70,0:03:24.41,Default,,0,0,0,,Иә! (Тайчи) Иә?
Dialogue: 0,0:03:24.49,0:03:26.20,Default,,0,0,0,,Судо мырза, сіз не туралы айтып отырсыз?
Dialogue: 0,0:03:26.28,0:03:27.33,Default,,0,0,0,,Сіз естігендей.
Dialogue: 0,0:03:27.41,0:03:29.08,Default,,0,0,0,,Сенің жоқ екенің өтірік! ?
Dialogue: 0,0:03:30.50,0:03:35.29,Default,,0,0,0,,Бірінші жеңілген адам екі аптадан кейін Мейцзин турнирінің іріктеу кезеңіне қатыса алмайды.
Dialogue: 0,0:03:35.38,0:03:36.50,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:03:36.59,0:03:39.80,Default,,0,0,0,,Егер Судо мырза келмесе, Хокуо Карута клубының моральдық жағдайы нашарлайды!
Dialogue: 0,0:03:39.88,0:03:41.80,Default,,0,0,0,,Төмен қарай! Еркін құлау!
Dialogue: 0,0:03:41.88,0:03:44.22,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:03:44.30,0:03:46.80,Default,,0,0,0,,Мен сенсіз қолымнан келгеннің бәрін істей алмаймын, Судо!
Dialogue: 0,0:03:47.39,0:03:48.89,Default,,0,0,0,,Жақсы, Судо мырза, қатысыңыз.
Dialogue: 0,0:03:48.89,0:03:50.89,Default,,0,0,0,,Жақсы, Судо мырза, қатысыңыз.
Dialogue: 0,0:03:48.89,0:03:50.89,Default,,0,0,0,,(Мочиданың жылағаны)
Dialogue: 0,0:03:50.89,0:03:50.98,Default,,0,0,0,,(Мочиданың айқайы)
Dialogue: 0,0:03:50.98,0:03:52.19,Default,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:03:50.98,0:03:52.19,Default,,0,0,0,,(Мочиданың жылауы)
Dialogue: 0,0:03:52.19,0:03:52.27,Default,,0,0,0,,(Мочиданың жылағаны)
Dialogue: 0,0:03:52.27,0:03:55.19,Default,,0,0,0,,Мен уәдемді бұзамын, бірақ құмар ойнап қарыз болмаймын.
Dialogue: 0,0:03:52.27,0:03:55.19,Default,,0,0,0,,(Мочиданың айқайы)
Dialogue: 0,0:03:55.27,0:03:57.07,Default,,0,0,0,,Қарыз немесе ештеңе емес.
Dialogue: 0,0:03:57.15,0:04:00.99,Default,,0,0,0,,Мүлдем ұнатпаймын Мүлдем бермеңіз Мен ешқандай қарыздар емеспін
Dialogue: 0,0:04:01.07,0:04:02.57,Default,,0,0,0,,Әй, не деген әурешілік!
Dialogue: 0,0:04:02.65,0:04:05.49,Default,,0,0,0,,Олай болса, маған сәйкес келсе, маған беріңіз.
Dialogue: 0,0:04:08.58,0:04:09.99,Default,,0,0,0,,Хмм…
Dialogue: 0,0:04:10.08,0:04:12.75,Default,,0,0,0,,Бірақ мен футболка да, ештеңе әкелген жоқпын.
Dialogue: 0,0:04:12.83,0:04:13.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:13.75,0:04:14.83,Default,,0,0,0,,Мендікін пайдаланыңыз
Dialogue: 0,0:04:14.92,0:04:16.17,Default,,0,0,0,,Жоқ, менікі (Камеда) шахтасы.
Dialogue: 0,0:04:17.09,0:04:21.21,Default,,0,0,0,,Маджима, менде керемет Джокер бар.
Dialogue: 0,0:04:22.30,0:04:23.17,Default,,0,0,0,,Мажима
Dialogue: 0,0:04:23.26,0:04:24.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:24.68,0:04:27.18,Default,,0,0,0,,Маған тигенше ұтылып қалсаң, пайдасы жоқ.
Dialogue: 0,0:04:27.80,0:04:30.60,Default,,0,0,0,,Шығыс Жапонияның алдын ала атын атамаңыз
Dialogue: 0,0:04:34.35,0:04:35.19,Default,,0,0,0,,Макото
Dialogue: 0,0:04:35.77,0:04:37.56,Default,,0,0,0,,Сіз тест тапсырушы болсаңыз да, неге көрінесіз?
Dialogue: 0,0:04:37.65,0:04:39.61,Default,,0,0,0,,Ух... өйткені Рион мен Йорошико екеуі де
Dialogue: 0,0:04:39.69,0:04:41.07,Default,,0,0,0,,Эром да шығады дейді...
Dialogue: 0,0:04:41.86,0:04:44.15,Default,,0,0,0,,Эмуро-кун да тест тапсырушы, неге?
Dialogue: 0,0:04:45.24,0:04:47.12,Default,,0,0,0,,Бұл анық, сұрамаңыз.
Dialogue: 0,0:04:47.78,0:04:49.45,Default,,0,0,0,,Мен өзімді жақын сезінгім келеді
Dialogue: 0,0:04:49.53,0:04:52.41,Default,,0,0,0,,Сакуразава мырза патшайымның іріктеу кезеңіне қатысады
Dialogue: 0,0:04:52.50,0:04:54.71,Default,,0,0,0,,Карута да, сүт те белсенді!
Dialogue: 0,0:04:56.50,0:04:58.13,Default,,0,0,0,,Анашым! Анашым! Ояныңыз анашым!
Dialogue: 0,0:04:58.13,0:04:59.00,Default,,0,0,0,,Анашым! Анашым! Ояныңыз анашым!
Dialogue: 0,0:04:58.13,0:04:59.00,Default,,0,0,0,,...
Dialogue: 0,0:04:59.00,0:04:59.09,Default,,0,0,0,,Анашым! Анашым! Ояныңыз анашым!
Dialogue: 0,0:04:59.09,0:05:00.88,Default,,0,0,0,,Анашым! Анашым! Ояныңыз анашым!
Dialogue: 0,0:04:59.09,0:05:00.88,Default,,0,0,0,,Мама, мен саған кеудемді беремін.
Dialogue: 0,0:05:01.46,0:05:03.59,Default,,0,0,0,,Анам ұйықтап жатыр.
Dialogue: 0,0:05:03.67,0:05:04.76,Default,,0,0,0,,Ах
Dialogue: 0,0:05:05.51,0:05:07.51,Default,,0,0,0,,Джин Сен көп іштің бе?
Dialogue: 0,0:05:07.59,0:05:08.51,Default,,0,0,0,,(Зунның кекіруі)
Dialogue: 0,0:05:09.39,0:05:12.02,Default,,0,0,0,,Мен жеңемін, сондықтан келесі жолы түскі ас.
Dialogue: 0,0:05:13.60,0:05:16.60,Default,,0,0,0,,Е, Аясе-сан, мектептегі саяхаттан қалып қалдың ба?
Dialogue: 0,0:05:16.69,0:05:19.27,Default,,0,0,0,,Мизусаваның менеджері сонда болса да! ?
Dialogue: 0,0:05:23.19,0:05:25.40,Default,,0,0,0,,Бұл Карута залы ма?
Dialogue: 0,0:05:25.49,0:05:27.78,Default,,0,0,0,,Сіз оны сырттан көресіз бе? Неліктен?
Dialogue: 0,0:05:27.86,0:05:30.99,Default,,0,0,0,,Е, неге ойыншыларға толы...
Dialogue: 0,0:05:31.08,0:05:32.58,Default,,0,0,0,,Уф
Dialogue: 0,0:05:32.66,0:05:34.41,Default,,0,0,0,,Ах... (Рейко) Та... Тайчи!
Dialogue: 0,0:05:35.25,0:05:38.29,Default,,0,0,0,,Мен қай кітапханаға бардың деп ойладым...
Dialogue: 0,0:05:38.37,0:05:42.25,Default,,0,0,0,,Ах... Тайчи!
Dialogue: 0,0:05:43.67,0:05:47.51,Default,,0,0,0,,-де біз Шығыс Жапонияның іріктеу раундының комбинациясын бастаймыз.
Dialogue: 0,0:05:49.76,0:05:52.89,Default,,0,0,0,,Не болады? Биылғы іріктеу
Dialogue: 0,0:05:52.97,0:05:56.64,Default,,0,0,0,,Бұл күндері жас ойыншылар әйелдерге де, ерлерге де жақсы.
Dialogue: 0,0:05:56.73,0:06:00.31,Default,,0,0,0,,Менің кекімді Нагумо-кайдан Мурао-кун алғанын қалаймын.
Dialogue: 0,0:06:00.40,0:06:04.15,Default,,0,0,0,,Ағымдағы шеберді кез келген адам түсіре алады.
Dialogue: 0,0:06:04.23,0:06:06.24,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:06:06.32,0:06:10.07,Default,,0,0,0,,Менің ойымша, мен Арата Ватаямын.
Dialogue: 0,0:06:10.16,0:06:11.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:11.37,0:06:14.83,Default,,0,0,0,,Айта кету керек, Йошиока мырза.
Dialogue: 0,0:06:14.91,0:06:18.87,Default,,0,0,0,,Соңғы кездері мен Ватая мырзаның жүзін ерекше қатты көремін.
Dialogue: 0,0:06:20.54,0:06:23.71,Default,,0,0,0,,Ватая мырза Сайдё Хошиді ұнатады.
Dialogue: 0,0:06:23.80,0:06:25.46,Default,,0,0,0,,Оның интеллектуалдық жағы да болды.
Dialogue: 0,0:06:25.55,0:06:27.72,Default,,0,0,0,,Киёхико Сато 9-шы Данмен жарысты—
Dialogue: 0,0:06:27.80,0:06:29.88,Default,,0,0,0,,Екі билік дәуірінің күші қандай болды?
Dialogue: 0,0:06:30.64,0:06:32.39,Default,,0,0,0,,Тек жылдам емес
Dialogue: 0,0:06:32.47,0:06:35.22,Default,,0,0,0,,Ол гүлді және күшті.
Dialogue: 0,0:06:36.14,0:06:37.27,Default,,0,0,0,,Әрине —
Dialogue: 0,0:06:37.35,0:06:39.94,Default,,0,0,0,,Бұл сіздің үміттеріңізді ақтайды.
Dialogue: 0,0:06:40.02,0:06:42.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:42.56,0:06:44.02,Default,,0,0,0,,Не болды? жаңа
Dialogue: 0,0:06:44.11,0:06:46.23,Default,,0,0,0,,Жоқ... жоқ, ештеңе.
Dialogue: 0,0:06:47.44,0:06:48.78,Default,,0,0,0,,Мүлдем солай
Dialogue: 0,0:06:49.57,0:06:52.07,Default,,0,0,0,,Юудың көңілі көтеріліп, таңертең осылай жасады.
Dialogue: 0,0:06:52.16,0:06:54.74,Default,,0,0,0,,Көп мөлшерде кептірілген бонито үлпектері бар бонито сэндвичі
Dialogue: 0,0:06:55.24,0:06:58.04,Default,,0,0,0,,Қарғыс атсын, мен тым көп оғаш тамақ жедім...
Dialogue: 0,0:06:59.16,0:07:00.67,Default,,0,0,0,,Әжетхана бәрібір
Dialogue: 0,0:07:07.88,0:07:10.01,Default,,0,0,0,,Не, Тайчи! ?
Dialogue: 0,0:07:10.09,0:07:13.76,Default,,0,0,0,,Киотоға мектеп саяхаты!
Dialogue: 0,0:07:13.85,0:07:16.81,Default,,0,0,0,,Чихая олардың мектепке саяхатқа баратынын айтты.
Dialogue: 0,0:07:17.77,0:07:19.73,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:07:20.77,0:07:23.65,Default,,0,0,0,,Тайчи шебер болуды мақсат тұтады.
Dialogue: 0,0:07:23.73,0:07:26.32,Default,,0,0,0,,Чихаяның итергіштігі бәрі дерлік.
Dialogue: 0,0:07:26.40,0:07:29.15,Default,,0,0,0,,Мен бұлай алысқа барады деп ойламадым.
Dialogue: 0,0:07:29.24,0:07:32.86,Default,,0,0,0,,Менің ойымша, ол жай ғана Чихаямен кездесіп жүр...
Dialogue: 0,0:07:32.95,0:07:34.03,Default,,0,0,0,,(Мотоциклдің жүгіру дыбысы)
Dialogue: 0,0:07:34.62,0:07:36.16,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:36.24,0:07:39.66,Default,,0,0,0,,Әй, моторды өшіріп, асығыңыз!
Dialogue: 0,0:07:41.25,0:07:42.50,Default,,0,0,0,,Төраға Машита
Dialogue: 0,0:07:42.58,0:07:45.13,Default,,0,0,0,,Сізде үлкен қызмет рухы бар.
Dialogue: 0,0:07:45.21,0:07:46.09,Default,,0,0,0,,Шинобу-чан?
Dialogue: 0,0:07:46.17,0:07:50.55,Default,,0,0,0,,Тек телефон нөміріңізді айтыңыз, мен сізге мекен-жайымды айта алмаймын.
Dialogue: 0,0:07:50.63,0:07:51.88,Default,,0,0,0,,О... кешіріңіз.
Dialogue: 0,0:07:51.97,0:07:55.34,Default,,0,0,0,,Сенің маған қонаққа келгенің үшін өте кішіпейіл болдым.
Dialogue: 0,0:07:55.43,0:07:57.26,Default,,0,0,0,,Итерсе де, патшайым болсаң
Dialogue: 0,0:07:57.35,0:07:59.10,Default,,0,0,0,,Мені қуып жібереді деп ойладым
Dialogue: 0,0:07:59.18,0:08:03.14,Default,,0,0,0,,Бірақ күткендей, сіз шебердің қарқынына ілесе алдыңыз ба?
Dialogue: 0,0:08:03.23,0:08:04.06,Default,,0,0,0,,Ах
Dialogue: 0,0:08:09.03,0:08:10.69,Default,,0,0,0,,Мэйджин Суо! ?
Dialogue: 0,0:08:11.28,0:08:14.32,Default,,0,0,0,,Ал, күлкілі әзіл.
Dialogue: 0,0:08:14.41,0:08:17.12,Default,,0,0,0,,Учиха жағы... Жоқ, олай емес.
Dialogue: 0,0:08:17.20,0:08:18.41,Default,,0,0,0,,Арба мен оны мінгім келді.
Dialogue: 0,0:08:18.49,0:08:19.62,Default,,0,0,0,,Мен арбаға мінгім келді
Dialogue: 0,0:08:19.70,0:08:21.62,Default,,0,0,0,,Арбаға міну... (Еркек) Вагон
Dialogue: 0,0:08:23.08,0:08:24.37,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:08:24.96,0:08:28.71,Default,,0,0,0,,Неліктен Мэйдзин мен Королева Батыс Жапонияның іріктеу кезеңінде?
Dialogue: 0,0:08:30.76,0:08:32.13,Default,,0,0,0,,Иә (Ер) Иә?
Dialogue: 0,0:08:32.84,0:08:35.18,Default,,0,0,0,,Сіз А класындағы адамсыз ба?
Dialogue: 0,0:08:35.26,0:08:37.39,Default,,0,0,0,,Иә (Суо) Сонда...
Dialogue: 0,0:08:37.47,0:08:39.06,Default,,0,0,0,,Сіз ше? (Әйел) Е... бұл А сыныбы.
Dialogue: 0,0:08:39.14,0:08:41.89,Default,,0,0,0,,Мэйджин Суодан жапон тәттілерін тарату
Dialogue: 0,0:08:41.97,0:08:44.56,Default,,0,0,0,,Бұл Хисаши Суо
Dialogue: 0,0:08:44.64,0:08:46.27,Default,,0,0,0,,Бірінші рет көрдім
Dialogue: 0,0:08:46.35,0:08:48.02,Default,,0,0,0,,Теледидардан көп рет...
Dialogue: 0,0:08:48.61,0:08:52.32,Default,,0,0,0,,Суо-сан алғаш рет шебер болған кезде
Dialogue: 0,0:08:52.40,0:08:53.99,Default,,0,0,0,,Мен оны атаммен бірге көрдім.
Dialogue: 0,0:08:54.53,0:08:57.66,Default,,0,0,0,,Ноу ата, шебер болу қандай?
Dialogue: 0,0:08:57.74,0:08:59.45,Default,,0,0,0,,Тіпті атам да қобалжи ма?
Dialogue: 0,0:08:59.53,0:09:01.08,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:09:01.16,0:09:05.75,Default,,0,0,0,,Жаңа магистр – Хисаши Суо, университеттің белсенді студенті.
Dialogue: 0,0:09:05.83,0:09:10.04,Default,,0,0,0,,Бұл адам университетке түскеннен кейін карутаны бастады.
Dialogue: 0,0:09:10.13,0:09:13.67,Default,,0,0,0,,Кейде ұнамды данышпандар болады.
Dialogue: 0,0:09:13.76,0:09:14.84,Default,,0,0,0,,Ах
Dialogue: 0,0:09:14.92,0:09:16.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:17.39,0:09:20.97,Default,,0,0,0,,«Мүмкін сіз бұған қарсы шығуыңыз керек...»
Dialogue: 0,0:09:22.81,0:09:24.64,Default,,0,0,0,,«Жаңа шебер бол»
Dialogue: 0,0:09:25.98,0:09:29.31,Default,,0,0,0,,Суокун, не болды? Сізге бірдеңе керек пе?
Dialogue: 0,0:09:29.40,0:09:31.94,Default,,0,0,0,,Төраға, дораяки алғыңыз келе ме?
Dialogue: 0,0:09:32.02,0:09:34.86,Default,,0,0,0,,Не? Кешіріңіз, қаттырақ сөйлеңіз
Dialogue: 0,0:09:34.94,0:09:37.45,Default,,0,0,0,,Төраға, дораяки алғыңыз келе ме?
Dialogue: 0,0:09:37.53,0:09:39.91,Default,,0,0,0,,Құлағыңыз нашар, қаттырақ шығарыңыз!
Dialogue: 0,0:09:41.49,0:09:43.62,Default,,0,0,0,,сұхбат алдында
Dialogue: 0,0:09:43.70,0:09:48.08,Default,,0,0,0,,Менің ойымша, сіз мен үшін 28 карта бір кейіпкер үшін стандарт болып табылады деп айттыңыз.
Dialogue: 0,0:09:48.17,0:09:51.46,Default,,0,0,0,,Мен өткен күні қайта санадым, ол 27 болды.
Dialogue: 0,0:09:51.54,0:09:53.25,Default,,0,0,0,,Иә? 27 дана?
Dialogue: 0,0:09:53.34,0:09:57.38,Default,,0,0,0,,Мен осы жылы өте алмаған неміс кредиттерін ала аламын деп ойлаймын.
Dialogue: 0,0:09:57.47,0:09:59.26,Default,,0,0,0,,Мен оқуды аяқтайтын сияқтымын.
Dialogue: 0,0:09:59.34,0:10:01.97,Default,,0,0,0,,Иә! Осымен құттықтаймыз!
Dialogue: 0,0:10:02.05,0:10:02.89,Default,,0,0,0,,Жұмыспен қамту туралы не деуге болады?
Dialogue: 0,0:10:03.60,0:10:07.14,Default,,0,0,0,,Толық емес жұмыс істеген жер мені жұмысқа алады.
Dialogue: 0,0:10:07.23,0:10:08.27,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:10:09.77,0:10:13.07,Default,,0,0,0,,Келесіде мен 5 рет қатарынан чемпион болғаннан кейін зейнетке шығамын.
Dialogue: 0,0:10:13.15,0:10:14.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:16.15,0:10:20.78,Default,,0,0,0,,Не? Мастер зейнетке шығатынын хабарлайды?
Dialogue: 0,0:10:21.91,0:10:24.66,Default,,0,0,0,,Банзай!
Dialogue: 0,0:10:24.74,0:10:26.87,Default,,0,0,0,,«Қатарынан 5 рет жеңу»?
Dialogue: 0,0:10:26.95,0:10:30.29,Default,,0,0,0,,(Барлығы күңкілдейді)
Dialogue: 0,0:10:30.88,0:10:31.79,Default,,0,0,0,,Киокотан!
Dialogue: 0,0:10:32.63,0:10:37.05,Default,,0,0,0,,Киокотан Биылғы жылы Батыс Жапонияның алдын ала оқырманы!
Dialogue: 0,0:10:38.13,0:10:40.84,Default,,0,0,0,,U-n-me-i!
Dialogue: 0,0:10:40.93,0:10:43.60,Default,,0,0,0,,Сіз қатты шу шығарып жатырсыз ба?
Dialogue: 0,0:10:44.22,0:10:49.23,Default,,0,0,0,,Шу мен адам көп болса да, мен сонша алыстан дауысты қабылдай аламын.
Dialogue: 0,0:10:49.31,0:10:51.10,Default,,0,0,0,,Бірақ сіз зейнетке шықтыңыз ба?
Dialogue: 0,0:10:53.15,0:10:54.27,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:10:54.36,0:10:55.86,Default,,0,0,0,,Қызып кету
Dialogue: 0,0:10:55.94,0:10:57.78,Default,,0,0,0,,Қатарынан 5-ші жеңіс шешілген сияқты
Dialogue: 0,0:10:57.86,0:10:59.32,Default,,0,0,0,,Менің жеңіп, қашып кетуіме жол бересің бе?
Dialogue: 0,0:10:59.40,0:11:00.74,Default,,0,0,0,,(Аратаның асқазанының құлаған дыбысы)
Dialogue: 0,0:11:00.82,0:11:02.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:02.57,0:11:05.24,Default,,0,0,0,,(Дәретхананың ағу дыбысы)
Dialogue: 0,0:11:06.29,0:11:07.12,Default,,0,0,0,,Я...
Dialogue: 0,0:11:07.20,0:11:12.21,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:11:27.64,0:11:31.19,Default,,0,0,0,,Шебер болудың мәні неде? Бұл атамен уәде.
Dialogue: 0,0:11:33.52,0:11:34.81,Default,,0,0,0,,Менің арманым
Dialogue: 0,0:11:36.23,0:11:37.69,Default,,0,0,0,,Сәйкес емес
Dialogue: 0,0:11:39.44,0:11:40.40,Default,,0,0,0,,Кеттік
Dialogue: 0,0:11:48.70,0:11:51.37,Default,,0,0,0,,Шинобу-чан, сен доссың ба?
Dialogue: 0,0:11:52.29,0:11:54.92,Default,,0,0,0,,Обструктивті... өзен
Dialogue: 0,0:12:03.72,0:12:06.64,Default,,0,0,0,,Мен өз жасымдағы адамдармен енді араласа алмаймын.
Dialogue: 0,0:12:12.69,0:12:15.27,Default,,0,0,0,,Жаңасын, қазіргісін ал.
Dialogue: 0,0:12:15.35,0:12:17.23,Default,,0,0,0,,(шоттарды туралау дыбысы)
Dialogue: 0,0:12:21.11,0:12:22.57,Default,,0,0,0,,Ешқашан ұрыспаңыз
Dialogue: 0,0:12:23.20,0:12:26.57,Default,,0,0,0,,Бұл қалп Ватая мырзадан да мұра болды.
Dialogue: 0,0:12:29.12,0:12:32.20,Default,,0,0,0,,Мен өзіңізді жеңіп жатқаныңызды елестете алмайтыныңызды сеземін.
Dialogue: 0,0:12:33.46,0:12:34.62,Default,,0,0,0,,(Косей мен Цубакинің жылаған дауыстары)
Dialogue: 0,0:12:36.21,0:12:40.17,Default,,0,0,0,,Сурет…Жеңімпаз сурет
Dialogue: 0,0:12:41.88,0:12:44.22,Default,,0,0,0,,Сергіту концентрациясы
Dialogue: 0,0:12:44.30,0:12:46.80,Default,,0,0,0,,Менің ойымша, сіз оны күте аласыз.
Dialogue: 0,0:12:48.64,0:12:54.39,Default,,0,0,0,,Мен Мастер Ватаяның жас әрі сымбатты денесін көргенде,
Dialogue: 0,0:12:56.77,0:12:58.27,Default,,0,0,0,,Я...
Dialogue: 0,0:12:59.65,0:13:01.32,Default,,0,0,0,,Түс болды ма?
Dialogue: 0,0:13:01.82,0:13:03.74,Default,,0,0,0,,Қызық, шығыста не болып жатыр?
Dialogue: 0,0:13:05.65,0:13:06.99,Default,,0,0,0,,Тайчи...
Dialogue: 0,0:13:08.32,0:13:09.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:10.58,0:13:12.91,Default,,0,0,0,,Не... Суо мырза?
Dialogue: 0,0:13:13.00,0:13:15.33,Default,,0,0,0,,Сәлеметсіз бе, мен қарап отырдым.
Dialogue: 0,0:13:15.41,0:13:18.29,Default,,0,0,0,,Дауысы бәсең
Dialogue: 0,0:13:18.38,0:13:20.34,Default,,0,0,0,,Сен мықтысың.
Dialogue: 0,0:13:20.42,0:13:22.71,Default,,0,0,0,,Ал... бұл дұрыс емес.
Dialogue: 0,0:13:22.80,0:13:25.34,Default,,0,0,0,,Бір күні шебер боласың.
Dialogue: 0,0:13:25.42,0:13:27.34,Default,,0,0,0,,Болды... Шебер деген сондай...
Dialogue: 0,0:13:28.39,0:13:30.85,Default,,0,0,0,,Бірақ бұл келесі емес.
Dialogue: 0,0:13:30.93,0:13:31.76,Default,,0,0,0,,Ах
Dialogue: 0,0:13:35.06,0:13:38.73,Default,,0,0,0,,Саған қарасам да көңілім көтерілмейді
Dialogue: 0,0:13:43.07,0:13:44.11,Default,,0,0,0,,Қош бол
Dialogue: 0,0:13:46.45,0:13:49.07,Default,,0,0,0,,Чи-чан! қайда?
Dialogue: 0,0:13:49.16,0:13:53.08,Default,,0,0,0,,Шамамен сол уақытта басты кейіпкер Кинкаку-джи храмында жоғалып кетті.
Dialogue: 0,0:13:55.45,0:13:57.00,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:13:59.29,0:14:00.67,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:14:00.75,0:14:03.67,Default,,0,0,0,,Ал... Машима мен Готокуджи Санэацу?
Dialogue: 0,0:14:03.75,0:14:06.09,Default,,0,0,0,,Хмм, екеуінің де жеңілгенін қалаймын.
Dialogue: 0,0:14:06.17,0:14:08.47,Default,,0,0,0,,Біреу жеңеді!
Dialogue: 0,0:14:09.43,0:14:11.22,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:14.06,0:14:15.68,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:17.14,0:14:21.98,Default,,0,0,0,,Қызық, бәрі шебер болғысы келеді ме?
Dialogue: 0,0:14:22.06,0:14:23.73,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:23.82,0:14:26.74,Default,,0,0,0,,Мен мұны істеймін, істеймін
Dialogue: 0,0:14:26.82,0:14:28.36,Default,,0,0,0,,Мажима
Dialogue: 0,0:14:28.45,0:14:30.36,Default,,0,0,0,,Хмм... (Тайчи) Хмм...
Dialogue: 0,0:14:31.57,0:14:35.66,Default,,0,0,0,,Мектептегі саяхаттан үзіліс алдым.
Dialogue: 0,0:14:36.33,0:14:38.08,Default,,0,0,0,,Сіз қандай болғыңыз келеді?
Dialogue: 0,0:14:38.66,0:14:41.17,Default,,0,0,0,,Тайчи~!
Dialogue: 0,0:14:41.67,0:14:45.09,Default,,0,0,0,,Мастер дәрежесі Королева дәрежесінің біліктілігі? Бұл не!
Dialogue: 0,0:14:45.17,0:14:50.51,Default,,0,0,0,,Сіз карута шебері болуды мақсат еттіңіз бе? Тайчи... бұл мүмкін емес.
Dialogue: 0,0:14:50.59,0:14:52.72,Default,,0,0,0,,Менің баламның қызуы көтерілді.
Dialogue: 0,0:14:53.43,0:14:56.06,Default,,0,0,0,,Тіпті ата-анамды өтірік айту...
Dialogue: 0,0:14:56.64,0:14:57.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:58.35,0:15:00.23,Default,,0,0,0,,«Тайчи» сіз бұрын айтқан болатын.
Dialogue: 0,0:15:00.31,0:15:03.02,Default,,0,0,0,,Мәшима-сенпайдың анасы шығар?
Dialogue: 0,0:15:03.65,0:15:05.27,Default,,0,0,0,,Эй, сен (Сумире), не?
Dialogue: 0,0:15:05.36,0:15:07.78,Default,,0,0,0,,Бұл матч сағат нешеде аяқталады?
Dialogue: 0,0:15:07.86,0:15:09.82,Default,,0,0,0,,А... шамамен бір сағаттан кейін.
Dialogue: 0,0:15:09.90,0:15:11.03,Default,,0,0,0,,1 сағаттан кейін! ? (Цукуба) А...
Dialogue: 0,0:15:11.11,0:15:12.32,Default,,0,0,0,,Мен мұндай жерде бір сағат болса да күте алмаймын!
Dialogue: 0,0:15:12.32,0:15:13.53,Default,,0,0,0,,Мен мұндай жерде бір сағат болса да күте алмаймын!
Dialogue: 0,0:15:12.32,0:15:13.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:13.62,0:15:14.12,Default,,0,0,0,,Тыныш, іште ойын жүріп жатыр.
Dialogue: 0,0:15:14.12,0:15:15.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:14.12,0:15:15.53,Default,,0,0,0,,Тыныш, іште ойын жүріп жатыр.
Dialogue: 0,0:15:16.62,0:15:20.91,Default,,0,0,0,,А-а... мм... Біз Машима-сенпайдың клубында кішілерміз.
Dialogue: 0,0:15:21.00,0:15:24.04,Default,,0,0,0,,Не? Балалар сендер карута клубының мүшесісіңдер ме?
Dialogue: 0,0:15:24.13,0:15:27.63,Default,,0,0,0,,Иә, біз ойынды үнемі көріп отырдық.
Dialogue: 0,0:15:27.71,0:15:30.51,Default,,0,0,0,,Аяқтауға жақын қалғанда сізбен хабарласайын ба?
Dialogue: 0,0:15:30.59,0:15:31.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:32.30,0:15:34.22,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:15:34.85,0:15:37.06,Default,,0,0,0,,Мен саған шай әкелейін, өтінемін.
Dialogue: 0,0:15:39.93,0:15:42.94,Default,,0,0,0,,Ойланып қарасам, Нишида-сенпай осылай деді
Dialogue: 0,0:15:43.02,0:15:46.98,Default,,0,0,0,,Мен Машима-сенпайға: «Егер бағаларың нашар болса, карута клубын таста» дедім.
Dialogue: 0,0:15:47.07,0:15:49.28,Default,,0,0,0,,Мен сенің қорқынышты анаң бар деп естідім.
Dialogue: 0,0:15:49.78,0:15:53.66,Default,,0,0,0,,Цукуба Менің ойымша, бұл мүмкіндік.
Dialogue: 0,0:15:53.74,0:15:54.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:54.66,0:15:59.08,Default,,0,0,0,,Генералды атқың келсе, аттан баста... солай ма?
Dialogue: 0,0:16:00.66,0:16:03.25,Default,,0,0,0,,Анаңызға ұнау мүмкіндігі
Dialogue: 0,0:16:03.33,0:16:03.58,Default,,0,0,0,,Шынайы мақсатқа төте жол!
Dialogue: 0,0:16:03.58,0:16:05.88,Default,,0,0,0,,Шынайы мақсатқа төте жол!
Dialogue: 0,0:16:03.58,0:16:05.88,Default,,0,0,0,,(шіркеу қоңырауының дыбысы)
Dialogue: 0,0:16:05.88,0:16:05.96,Default,,0,0,0,,(шіркеу қоңырауының дыбысы)
Dialogue: 0,0:16:05.96,0:16:07.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:05.96,0:16:07.34,Default,,0,0,0,,(шіркеу қоңырауының дыбысы)
Dialogue: 0,0:16:08.30,0:16:10.46,Default,,0,0,0,,Менің атым Йошихико Хината
Dialogue: 0,0:16:10.55,0:16:12.97,Default,,0,0,0,,Қыздар арасында танымал болу үшін күн сайын бар күшіңізді салыңыз
Dialogue: 0,0:16:13.05,0:16:16.01,Default,,0,0,0,,Қыз баланың 1 см-ге созылған шашбауын да байқайтын байқағыш көз
Dialogue: 0,0:16:16.10,0:16:18.60,Default,,0,0,0,,Тақта лас болса, мүмкіндік жоқ
Dialogue: 0,0:16:18.68,0:16:20.52,Default,,0,0,0,,Қиындықтың орнын толтыратын байыптылық
Dialogue: 0,0:16:20.60,0:16:22.39,Default,,0,0,0,,Бұл потенциал
Dialogue: 0,0:16:22.48,0:16:25.65,Default,,0,0,0,,Фудзисакиде карутада мықты болу керемет!
Dialogue: 0,0:16:25.73,0:16:27.65,Default,,0,0,0,,Досей! (Хината) Уф!
Dialogue: 0,0:16:27.73,0:16:28.98,Default,,0,0,0,,(Макотоның тыныс алу дыбысы)
Dialogue: 0,0:16:29.07,0:16:32.03,Default,,0,0,0,,Рионды жеңгенді мен жеңемін!
Dialogue: 0,0:16:32.11,0:16:33.65,Default,,0,0,0,,Иә! (Макото) Уф
Dialogue: 0,0:16:33.74,0:16:37.12,Default,,0,0,0,,Биыл жақсы емес, балаларым.
Dialogue: 0,0:16:37.20,0:16:38.62,Default,,0,0,0,,Не үшін келдің?
Dialogue: 0,0:16:40.37,0:16:43.04,Default,,0,0,0,,Инокума мырза оңай жеңді
Dialogue: 0,0:16:43.12,0:16:43.96,Default,,0,0,0,,Рион ше?
Dialogue: 0,0:16:44.71,0:16:46.67,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:46.75,0:16:48.54,Default,,0,0,0,,Рион Қалай болды?
Dialogue: 0,0:16:49.75,0:16:51.84,Default,,0,0,0,,Немесе... мен жеңдім.
Dialogue: 0,0:16:52.55,0:16:55.97,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:16:56.59,0:16:57.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:57.76,0:17:00.18,Default,,0,0,0,,(шотты алу дыбысы)
Dialogue: 0,0:17:00.26,0:17:03.06,Default,,0,0,0,,Машима-сенпайдың кездесуі аяқталуға жақын.
Dialogue: 0,0:17:03.14,0:17:04.98,Default,,0,0,0,,Байланыс байланысы
Dialogue: 0,0:17:05.06,0:17:08.15,Default,,0,0,0,,Анаңның көңілінен шығу маңызды!
Dialogue: 0,0:17:08.23,0:17:09.06,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:09.15,0:17:12.99,Default,,0,0,0,,Тіпті Машима-сенпай да мәңгілік карута ойнайды...
Dialogue: 0,0:17:14.19,0:17:15.45,Default,,0,0,0,,Аа, кешіріңіз...
Dialogue: 0,0:17:16.36,0:17:17.74,Default,,0,0,0,,Эй (Харада) Иә...
Dialogue: 0,0:17:17.82,0:17:22.70,Default,,0,0,0,,(Хараданың ауыр тыныс алуы)
Dialogue: 0,0:17:24.04,0:17:31.00,Default,,0,0,0,,(баспалдақпен көтерілу)
Dialogue: 0,0:17:33.80,0:17:38.72,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:17:38.80,0:17:39.89,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:17:39.97,0:17:42.72,Default,,0,0,0,,Мажима жеңді, 11 карта айырмашылығы
Dialogue: 0,0:17:42.81,0:17:44.52,Default,,0,0,0,,Машима Сенпай
Dialogue: 0,0:17:44.60,0:17:46.23,Default,,0,0,0,,Әлде... сіз жеңдіңіз бе? Маджима
Dialogue: 0,0:17:46.31,0:17:49.86,Default,,0,0,0,,Дұрыс, әлгі қария жай ғана әуесқой.
Dialogue: 0,0:17:49.94,0:17:52.52,Default,,0,0,0,,Менің де жеңілгенім қызық (Тайчи) Рас.
Dialogue: 0,0:17:52.61,0:17:53.65,Default,,0,0,0,,Ах
Dialogue: 0,0:17:54.44,0:17:57.32,Default,,0,0,0,,Мен жіберген барлық шоттарымды бірден қайтарамын.
Dialogue: 0,0:17:57.40,0:18:00.24,Default,,0,0,0,,Тек өзіңді ойлайтының көрініп тұр.
Dialogue: 0,0:18:00.32,0:18:02.45,Default,,0,0,0,,Мақсатты карта да анық.
Dialogue: 0,0:18:03.29,0:18:05.41,Default,,0,0,0,,Сен мықтысың (Хироси) Ах.
Dialogue: 0,0:18:06.12,0:18:08.96,Default,,0,0,0,,Ондай нәрседен жеңілме.
Dialogue: 0,0:18:09.04,0:18:10.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:16.26,0:18:17.59,Default,,0,0,0,,Я...
Dialogue: 0,0:18:18.43,0:18:20.76,Default,,0,0,0,,Не айтып тұрсың сонша?
Dialogue: 0,0:18:22.93,0:18:28.56,Default,,0,0,0,,Келесі ойын... Жақында келесі ойын
Dialogue: 0,0:18:32.65,0:18:34.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:35.53,0:18:39.40,Default,,0,0,0,,Ол басқа... Басқаша.
Dialogue: 0,0:18:40.07,0:18:42.83,Default,,0,0,0,,Жеңілу себебім әлсіз болды.
Dialogue: 0,0:18:42.91,0:18:44.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:44.87,0:18:49.83,Default,,0,0,0,,Менің әлсіз екенімді мойындай алмағандықтан.
Dialogue: 0,0:18:49.92,0:18:53.54,Default,,0,0,0,,(Хирошидің айқайы)
Dialogue: 0,0:18:56.76,0:18:59.34,Default,,0,0,0,,Басталды, жарай ма?
Dialogue: 0,0:18:59.93,0:19:03.14,Default,,0,0,0,,Мен ағамның анасымен байланысуым керек.
Dialogue: 0,0:19:11.19,0:19:13.69,Default,,0,0,0,,Сәлем! Бұл не?
Dialogue: 0,0:19:13.77,0:19:16.07,Default,,0,0,0,,Мен сізден көп естіген жоқпын, сондықтан бір қарап көрейін...
Dialogue: 0,0:19:20.24,0:19:21.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:24.16,0:19:24.99,Default,,0,0,0,,Жол бер
Dialogue: 0,0:19:25.08,0:19:26.87,Default,,0,0,0,,Не... Мен не істерімді білмеймін (Рейко) Иә?
Dialogue: 0,0:19:27.49,0:19:28.50,Default,,0,0,0,,Мұны жасамаңыз!
Dialogue: 0,0:19:29.87,0:19:32.46,Default,,0,0,0,,Тіпті сіз карута ойнаушысыз немесе шеберсіз.
Dialogue: 0,0:19:32.54,0:19:34.38,Default,,0,0,0,,Оның ештеңе істемейтінін білесіз!
Dialogue: 0,0:19:34.96,0:19:37.42,Default,,0,0,0,,Осындай көңіл көтеру үшін...
Dialogue: 0,0:19:38.17,0:19:39.30,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:39.88,0:19:42.51,Default,,0,0,0,,Сіз мұны өміріңіздің соңына дейін жасай аласыз!
Dialogue: 0,0:19:43.43,0:19:45.47,Default,,0,0,0,,Мажима жеңді, 6 карта айырмашылығы
Dialogue: 0,0:19:45.55,0:19:47.51,Default,,0,0,0,,Әй, Сенпай
Dialogue: 0,0:19:47.60,0:19:50.81,Default,,0,0,0,,А... м... енді шықпа.
Dialogue: 0,0:19:50.89,0:19:52.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:52.85,0:19:55.81,Default,,0,0,0,,Иносукэ… Иносукэ, өзіңді жина! Иносукэ!
Dialogue: 0,0:19:56.98,0:20:01.03,Default,,0,0,0,,Машима Сенпай Менің аға...
Dialogue: 0,0:20:01.95,0:20:03.24,Default,,0,0,0,,Мен мұны 3 ұтамын
Dialogue: 0,0:20:03.32,0:20:04.95,Default,,0,0,0,,Чихаябуру~
Dialogue: 0,0:20:05.03,0:20:07.45,Default,,0,0,0,,10 «алды» және 15 «алды»!
Dialogue: 0,0:20:08.79,0:20:09.91,Default,,0,0,0,,Мен жаттығуға келдім.
Dialogue: 0,0:20:10.66,0:20:11.91,Default,,0,0,0,,(Каори) Дайындық уақыты өзі-ақ қысқа ғой—
Dialogue: 0,0:20:12.50,0:20:14.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:14.54,0:20:17.34,Default,,0,0,0,,Мен көп жұмыс істеймін, өйткені мен өзім болғым келеді!
Dialogue: 0,0:20:21.09,0:20:26.01,Default,,0,0,0,,Не... Мағынасы жоқ не істеп жатырсың?
Dialogue: 0,0:20:26.09,0:20:28.18,Default,,0,0,0,,Ха... Ах, ха...
Dialogue: 0,0:20:38.61,0:20:39.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:42.11,0:20:44.53,Default,,0,0,0,,3-ші айналым комбинациясы
Dialogue: 0,0:20:48.12,0:20:49.49,Default,,0,0,0,,Биыл кім жақсы үлгерді?
Dialogue: 0,0:20:49.58,0:20:51.16,Default,,0,0,0,,Хокуодан келген Судо мырза жақсы.
Dialogue: 0,0:20:51.25,0:20:52.37,Default,,0,0,0,,Күшті болу
Dialogue: 0,0:20:52.45,0:20:53.37,Default,,0,0,0,,Тамару-кун ше?
Dialogue: 0,0:20:53.46,0:20:54.54,Default,,0,0,0,,Мен оны асыға күттім.
Dialogue: 0,0:20:54.62,0:20:56.50,Default,,0,0,0,,Цубогучи мырза да жарасады.
Dialogue: 0,0:20:56.58,0:21:01.76,Default,,0,0,0,,Бірақ ең қанағаттандыратыны сөзсіз К университетінен Коишикава.
Dialogue: 0,0:21:02.42,0:21:05.05,Default,,0,0,0,,Егер дұрыс түсінсеңіз, өзіңізді сәтсіз деп есептеңіз.
Dialogue: 0,0:21:11.18,0:21:14.85,Default,,0,0,0,,Машима, сен... сен сондай ақымақсың.
Dialogue: 0,0:21:18.69,0:21:20.86,Default,,0,0,0,,Мен өзім болуды тоқтатқым келеді
Dialogue: 0,0:21:25.15,0:21:28.99,Default,,0,0,0,,Бірақ мен өзім болғым келеді!
Dialogue: 0,0:21:37.96,0:21:42.96,Default,,0,0,0,,♪～
Dialogue: 0,0:22:46.78,0:22:51.78,Default,,0,0,0,,～♪
Dialogue: 0,0:22:53.28,0:22:59.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory