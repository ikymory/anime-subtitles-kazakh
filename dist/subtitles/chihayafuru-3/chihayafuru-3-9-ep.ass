Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.92,0:00:11.17,Default,,0,0,0,,Бір күні шебер боласың.
Dialogue: 0,0:00:11.26,0:00:13.97,Default,,0,0,0,,Бірақ бұл келесі емес.
Dialogue: 0,0:00:15.43,0:00:19.68,Default,,0,0,0,,Саған қарасам да көңілім көтерілмейді
Dialogue: 0,0:00:19.76,0:00:21.22,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:21.85,0:00:23.69,Default,,0,0,0,,Есте сақтау уақыты: 2 минут қалды
Dialogue: 0,0:00:23.77,0:00:25.52,Default,,0,0,0,,А, жарайды.
Dialogue: 0,0:00:25.60,0:00:27.23,Default,,0,0,0,,Үшінші ойын басталды
Dialogue: 0,0:00:27.94,0:00:29.69,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:31.28,0:00:32.44,Default,,0,0,0,,Кездесу аяқталғаннан кейін де, үйге келген соң қылмыскерлерді үкім шығарумен қайта айналысамын.
Dialogue: 0,0:00:35.66,0:00:37.20,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:00:38.41,0:00:40.20,Default,,0,0,0,,Суо Мэйджин
Dialogue: 0,0:00:41.04,0:00:46.04,Default,,0,0,0,,♪～
Dialogue: 0,0:01:45.98,0:01:50.98,Default,,0,0,0,,～♪
Dialogue: 0,0:02:01.12,0:02:03.83,Default,,0,0,0,,Ерекше өрескел
Dialogue: 0,0:02:03.91,0:02:05.29,Default,,0,0,0,,Сәлем
Dialogue: 0,0:02:05.91,0:02:08.58,Default,,0,0,0,,Суо мырза, сіз үйдесіз бе?
Dialogue: 0,0:02:08.67,0:02:09.92,Default,,0,0,0,,Шинобу-чан
Dialogue: 0,0:02:10.00,0:02:12.04,Default,,0,0,0,,Қаласаңыз, мен сізге жіберемін.
Dialogue: 0,0:02:12.13,0:02:13.55,Default,,0,0,0,,Әлі жоқ
Dialogue: 0,0:02:13.63,0:02:18.38,Default,,0,0,0,,Оми храмына келіп, зиярат етпестен қалай кетуге болады?
Dialogue: 0,0:02:18.47,0:02:20.55,Default,,0,0,0,,(Кашива қолының дыбысы)
Dialogue: 0,0:02:35.86,0:02:40.53,Default,,0,0,0,,Мүмкін бұл сіздің күш-қуатыңызды қолдайтын шығар.
Dialogue: 0,0:02:42.57,0:02:44.28,Default,,0,0,0,,5 қатарынан жеңіс—
Dialogue: 0,0:02:45.62,0:02:47.79,Default,,0,0,0,,Сіз өте сенімді сияқтысыз.
Dialogue: 0,0:02:47.87,0:02:51.08,Default,,0,0,0,,Суо-санды не қолдайды?
Dialogue: 0,0:02:55.59,0:02:56.42,Default,,0,0,0,,ештеңе
Dialogue: 0,0:02:56.50,0:02:58.92,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:59.01,0:03:00.68,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:03:00.76,0:03:02.59,Default,,0,0,0,,Сонда оның күші?
Dialogue: 0,0:03:03.72,0:03:05.76,Default,,0,0,0,,Тіпті Құдай емес
Dialogue: 0,0:03:07.68,0:03:09.81,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:03:10.44,0:03:12.73,Default,,0,0,0,,Кинкакуджиден Ниннадзиге дейін
Dialogue: 0,0:03:12.81,0:03:15.73,Default,,0,0,0,,Арашияма топтық әрекетіне көшу
Dialogue: 0,0:03:15.82,0:03:19.99,Default,,0,0,0,,Хякунин Исшу залы, Шигурэ-доно
Dialogue: 0,0:03:20.07,0:03:21.74,Default,,0,0,0,,Хякунин Исшу?
Dialogue: 0,0:03:21.82,0:03:23.41,Default,,0,0,0,,Хорикава мұнда не үшін келді?
Dialogue: 0,0:03:23.49,0:03:26.62,Default,,0,0,0,,Неге бәрі біздің топ болып келе жатыр?
Dialogue: 0,0:03:26.70,0:03:29.00,Default,,0,0,0,,Егер сіз Хорикаваға еретін болсаңыз, онда күмән жоқ...
Dialogue: 0,0:03:29.08,0:03:32.67,Default,,0,0,0,,Маршрутты өзіңіз ойлаңыз.
Dialogue: 0,0:03:32.75,0:03:34.00,Default,,0,0,0,,Ах
Dialogue: 0,0:03:35.75,0:03:38.30,Default,,0,0,0,,Чи Чан, бұл керемет.
Dialogue: 0,0:03:38.38,0:03:40.88,Default,,0,0,0,,Хякунин Исшу ақындары Барлығына арналған қуыршақтар бар.
Dialogue: 0,0:03:41.67,0:03:44.47,Default,,0,0,0,,Бұл Чи Чанның сүйіктісі Нарихира Аривара ма?
Dialogue: 0,0:03:44.55,0:03:46.47,Default,,0,0,0,,Мұнда қараңыз.
Dialogue: 0,0:03:49.72,0:03:52.64,Default,,0,0,0,,Тайчи Матч қалай өтіп жатыр?
Dialogue: 0,0:03:52.73,0:03:53.81,Default,,0,0,0,,Сіз жеңдіңіз бе?
Dialogue: 0,0:03:55.10,0:03:56.61,Default,,0,0,0,,Жаңасы ше?
Dialogue: 0,0:03:56.69,0:03:58.52,Default,,0,0,0,,Қазір қандай ойын?
Dialogue: 0,0:03:58.61,0:04:01.03,Default,,0,0,0,,Өйткені мен Жапонияның батысында ешкімді танымаймын.
Dialogue: 0,0:04:01.11,0:04:03.61,Default,,0,0,0,,Арата маған айтпаса...
Dialogue: 0,0:04:03.70,0:04:06.16,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз көп жұмыс жасайсыз ба?
Dialogue: 0,0:04:06.24,0:04:07.41,Default,,0,0,0,,Жаңа
Dialogue: 0,0:04:07.49,0:04:08.33,Default,,0,0,0,,Тайчи
Dialogue: 0,0:04:10.95,0:04:12.16,Default,,0,0,0,,Иә
Dialogue: 0,0:04:13.29,0:04:14.37,Default,,0,0,0,,Батарея жинағы!
Dialogue: 0,0:04:14.46,0:04:15.79,Default,,0,0,0,,Иә (Чихая) Ах.
Dialogue: 0,0:04:16.75,0:04:18.80,Default,,0,0,0,,Мичиру-чан, неге...
Dialogue: 0,0:04:18.88,0:04:21.71,Default,,0,0,0,,Мен Чи Чанмен бірге мектепке саяхатқа келдім.
Dialogue: 0,0:04:21.80,0:04:23.88,Default,,0,0,0,,Неге мұнда жоқсың?
Dialogue: 0,0:04:23.97,0:04:26.89,Default,,0,0,0,,Мен Хякунин Исшу туралы ештеңе білмеймін.
Dialogue: 0,0:04:26.97,0:04:28.55,Default,,0,0,0,,Мен білмегендіктен келдім.
Dialogue: 0,0:04:28.64,0:04:31.93,Default,,0,0,0,,Әндер туралы, карута, Чи-чан...
Dialogue: 0,0:04:33.56,0:04:36.19,Default,,0,0,0,,Чи Чан үйретпейінше түсінбеймін!
Dialogue: 0,0:04:38.27,0:04:42.11,Default,,0,0,0,,Джуни-Хитоені бірге Шигурэ-донода киейік.
Dialogue: 0,0:04:42.19,0:04:43.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:43.40,0:04:45.07,Default,,0,0,0,,Уау, кешірші Мичиру-чан
Dialogue: 0,0:04:45.15,0:04:46.74,Default,,0,0,0,,Кешіріңіз, мен ақымақ болдым.
Dialogue: 0,0:04:46.82,0:04:49.58,Default,,0,0,0,,Бірақ мен ән мен карута туралы көп білмеймін.
Dialogue: 0,0:04:49.66,0:04:50.74,Default,,0,0,0,,Иә~
Dialogue: 0,0:04:50.83,0:04:52.83,Default,,0,0,0,,Бұл не? Неліктен жастар мұнда?
Dialogue: 0,0:04:52.91,0:04:55.33,Default,,0,0,0,,Қараңғы кеңістіктегі бұл толқу...
Dialogue: 0,0:04:55.42,0:04:56.87,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:04:57.92,0:05:00.04,Default,,0,0,0,,Әйтеуір, бұл Хайанның костюмі ғой.
Dialogue: 0,0:05:00.13,0:05:02.63,Default,,0,0,0,,Үй сияқты киінуге болады. Жүр киініп алайық.
Dialogue: 0,0:05:02.71,0:05:03.88,Default,,0,0,0,,Мичиру-чан...
Dialogue: 0,0:05:04.72,0:05:06.93,Default,,0,0,0,,Дұрыс, Мичиру-чан.
Dialogue: 0,0:05:07.01,0:05:11.51,Default,,0,0,0,,Мен Киотоға мектептегі саяхатқа келдім.
Dialogue: 0,0:05:11.60,0:05:14.35,Default,,0,0,0,,Мен орта мектеп мұғалімі болғым келеді.
Dialogue: 0,0:05:14.43,0:05:18.44,Default,,0,0,0,,Егер сіз ешқашан мектеп сапарында болмаған болсаңыз, сіз қиындыққа тап боласыз.
Dialogue: 0,0:05:19.90,0:05:21.48,Default,,0,0,0,,Екі рет емес
Dialogue: 0,0:05:22.61,0:05:24.36,Default,,0,0,0,,Ешқашан екінші рет болмайды.
Dialogue: 0,0:05:26.03,0:05:28.07,Default,,0,0,0,,2-қабат Өте кең болды.
Dialogue: 0,0:05:28.16,0:05:30.91,Default,,0,0,0,,Әйелдер чемпионаты да осында өтеді деп естідім.
Dialogue: 0,0:05:30.99,0:05:32.83,Default,,0,0,0,,Чи-чан да пайда болса жақсы болар еді.
Dialogue: 0,0:05:32.91,0:05:35.66,Default,,0,0,0,,Хм, көлік шығындары... А?
Dialogue: 0,0:05:36.29,0:05:37.75,Default,,0,0,0,,Бұл Кана Чан
Dialogue: 0,0:05:37.83,0:05:39.79,Default,,0,0,0,,Кана-чанның командасы да келді ме?
Dialogue: 0,0:05:39.88,0:05:41.42,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:41.50,0:05:44.13,Default,,0,0,0,,Жоқ... бұл ештеңе емес. Мен жыламаймын.
Dialogue: 0,0:05:44.21,0:05:46.63,Default,,0,0,0,,Дегенмен, көрмеде барлығы соншалықты керемет болды.
Dialogue: 0,0:05:46.72,0:05:50.97,Default,,0,0,0,,Әсіресе осы Тентоку Даири Утаайдың қайталану көрмесі
Dialogue: 0,0:05:51.05,0:05:53.26,Default,,0,0,0,,Тентокудайри әнін сәйкестендіру…
Dialogue: 0,0:05:53.35,0:05:55.89,Default,,0,0,0,,Білмеймін деуге жол бермеймін.
Dialogue: 0,0:05:55.98,0:05:57.44,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:05:57.52,0:05:59.48,Default,,0,0,0,,Ән байқауы сияқты нәрсе болды, солай ма?
Dialogue: 0,0:05:59.56,0:06:01.02,Default,,0,0,0,,Кохон
Dialogue: 0,0:06:01.11,0:06:05.53,Default,,0,0,0,,«Утааи» Хэйан дәуірінде шамамен 500 рет өткізілді.
Dialogue: 0,0:06:05.61,0:06:09.74,Default,,0,0,0,,Ең танымалды император Мураками 960 жылы ұстаған.
Dialogue: 0,0:06:09.82,0:06:12.49,Default,,0,0,0,,Бұл Тентоку Дайра Утааи.
Dialogue: 0,0:06:12.58,0:06:15.37,Default,,0,0,0,,Төреші Санейори Фудзивара болды.
Dialogue: 0,0:06:15.45,0:06:18.71,Default,,0,0,0,,Императордың тілегін кейде сұрайтыны айтылады.
Dialogue: 0,0:06:18.79,0:06:21.83,Default,,0,0,0,,Заманымыздың 12 жетекші ақыны жиналды.
Dialogue: 0,0:06:21.92,0:06:25.76,Default,,0,0,0,,Касуми, Сакура, Ямабуки, Махаббат сияқты тақырыптарға әндер құрастыру.
Dialogue: 0,0:06:25.84,0:06:28.80,Default,,0,0,0,,Мибу Тадамидің «Койсучо» да осы кезде оқылды.
Dialogue: 0,0:06:28.88,0:06:32.22,Default,,0,0,0,,Тайра Канеморидің «Шинобуредо» әні де әйгілі әндердің бірі.
Dialogue: 0,0:06:32.30,0:06:35.77,Default,,0,0,0,,Тіпті судьялар, оқытушылар мен әйелдер де шеше алмайды...
Dialogue: 0,0:06:37.02,0:06:38.52,Default,,0,0,0,,Мен де жас кезімде
Dialogue: 0,0:06:38.60,0:06:42.11,Default,,0,0,0,,«Ән байқауы үшін әдейі жазылған махаббат әні жаман!»
Dialogue: 0,0:06:42.19,0:06:44.27,Default,,0,0,0,,Мен солай ойладым...
Dialogue: 0,0:06:45.69,0:06:47.32,Default,,0,0,0,,Мен бала едім
Dialogue: 0,0:06:49.78,0:06:50.99,Default,,0,0,0,,«Шинобуредо...»
Dialogue: 0,0:06:51.95,0:06:56.20,Default,,0,0,0,,Император Мураками кенеттен нәтижені шешетін бірдеңе деп күбірледі дейді.
Dialogue: 0,0:06:56.91,0:07:00.83,Default,,0,0,0,,Жүректерді тербету үшін жарыстық.
Dialogue: 0,0:07:03.04,0:07:04.92,Default,,0,0,0,,Жарысқа...
Dialogue: 0,0:07:07.00,0:07:12.09,Default,,0,0,0,,Йошино-кай турнирі кезінде Тайчидің жүрегі оған ең жақын болды.
Dialogue: 0,0:07:14.05,0:07:15.93,Default,,0,0,0,,Шебер болуды мақсат еттіңіз бе?
Dialogue: 0,0:07:16.01,0:07:17.56,Default,,0,0,0,,Мен Чихаяны жеңгім келеді
Dialogue: 0,0:07:17.64,0:07:18.47,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:18.56,0:07:20.02,Default,,0,0,0,,Мен Чихаяны жеңгім келеді
Dialogue: 0,0:07:20.10,0:07:21.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:21.14,0:07:23.90,Default,,0,0,0,,Тайчи мектептегі саяхатта емес...
Dialogue: 0,0:07:23.98,0:07:25.44,Default,,0,0,0,,Мен жеңгім келеді
Dialogue: 0,0:07:31.45,0:07:33.07,Default,,0,0,0,,Жоқ... (Койсикава) Ах...
Dialogue: 0,0:07:33.16,0:07:33.99,Default,,0,0,0,,Ах... (Цукуба) А...
Dialogue: 0,0:07:34.07,0:07:35.12,Default,,0,0,0,,Машима-кун…
Dialogue: 0,0:07:35.20,0:07:38.79,Default,,0,0,0,,Шусаку Коишикава К Ұлы Карута қауымдастығы
Dialogue: 0,0:07:38.87,0:07:41.87,Default,,0,0,0,,Карутаны шабуыл мен қорғаныстың жақсы тепе-теңдігімен ойнаңыз.
Dialogue: 0,0:07:41.96,0:07:45.29,Default,,0,0,0,,Осы жылдың сәуір айында өткен бүкіл Жапония чемпионатында екінші орын
Dialogue: 0,0:07:45.38,0:07:46.75,Default,,0,0,0,,Әдетте «ортақ өсіру» ретінде белгілі
Dialogue: 0,0:07:46.84,0:07:49.76,Default,,0,0,0,,Қосақу-сенпай ғажап, 9 картамен алда
Dialogue: 0,0:07:49.84,0:07:52.88,Default,,0,0,0,,Үлескер биылғы жылдың басынан бері жақсы жұмыс істеп жатыр.
Dialogue: 0,0:07:52.97,0:07:55.09,Default,,0,0,0,,Ең бастысы, жұмысқа орналастым.
Dialogue: 0,0:07:55.18,0:07:56.76,Default,,0,0,0,,Карутаның Ойши Тенгудосы
Dialogue: 0,0:07:57.56,0:07:58.89,Default,,0,0,0,,Мен боламын
Dialogue: 0,0:08:00.14,0:08:04.44,Default,,0,0,0,,Мен Oishi Tengudo үшін жарнамалық мұнара боламын!
Dialogue: 0,0:08:06.23,0:08:07.44,Default,,0,0,0,,10 парақ айырмашылығы…
Dialogue: 0,0:08:07.52,0:08:11.82,Default,,0,0,0,,Өткен күні Йошино-кай турнирінде екінші орын алған мектеп оқушысы ма?
Dialogue: 0,0:08:11.90,0:08:12.90,Default,,0,0,0,,Бүгін емес.
Dialogue: 0,0:08:12.99,0:08:14.66,Default,,0,0,0,,Койсикаваға қарсы...
Dialogue: 0,0:08:14.74,0:08:17.78,Default,,0,0,0,,Жақсы жекпе-жек болған болуы керек, өйткені олар бір клубтан еді. Сол кезде.
Dialogue: 0,0:08:17.87,0:08:20.37,Default,,0,0,0,,Мен шабуылдауға тырысамын, бірақ...
Dialogue: 0,0:08:21.41,0:08:23.87,Default,,0,0,0,,Бұл адам... күшті
Dialogue: 0,0:08:24.62,0:08:26.17,Default,,0,0,0,,Бірақ шабуыл.
Dialogue: 0,0:08:26.25,0:08:27.63,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:08:28.17,0:08:30.09,Default,,0,0,0,,Жау лагерінен өт!
Dialogue: 0,0:08:30.38,0:08:30.96,Default,,0,0,0,,Юраното~
Dialogue: 0,0:08:30.96,0:08:31.80,Default,,0,0,0,,Юраното~
Dialogue: 0,0:08:30.96,0:08:31.80,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:31.88,0:08:32.97,Default,,0,0,0,,Га
Dialogue: 0,0:08:33.05,0:08:35.09,Default,,0,0,0,,Ах (К мажор клубының мүшесі) Әй, шағын жұмыс қайталанды!
Dialogue: 0,0:08:35.18,0:08:37.47,Default,,0,0,0,,Ол бүгін де қайталанды (К негізгі мүшесі) белсендірілді.
Dialogue: 0,0:08:39.56,0:08:41.02,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:41.10,0:08:41.93,Default,,0,0,0,,Көшіру…
Dialogue: 0,0:08:47.40,0:08:49.07,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:08:50.07,0:08:50.94,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:08:52.28,0:08:53.44,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:08:53.53,0:08:56.82,Default,,0,0,0,,Бұл менмін, оның ішінде Пока.
Dialogue: 0,0:08:59.83,0:09:01.58,Default,,0,0,0,,Дубляжға ренжімеу
Dialogue: 0,0:09:01.66,0:09:03.29,Default,,0,0,0,,Барған сайын өсуде...
Dialogue: 0,0:09:03.37,0:09:04.75,Default,,0,0,0,,Бүкіл Жапония уақыты да
Dialogue: 0,0:09:04.83,0:09:07.96,Default,,0,0,0,,6 айналымда 20 рет екінші орынға қол жеткізді
Dialogue: 0,0:09:08.04,0:09:09.88,Default,,0,0,0,,Жылы, бірақ күшті
Dialogue: 0,0:09:09.96,0:09:11.88,Default,,0,0,0,,Тағы бір айырмашылық
Dialogue: 0,0:09:11.96,0:09:13.38,Default,,0,0,0,,8 парақ айырмашылығы
Dialogue: 0,0:09:16.68,0:09:19.89,Default,,0,0,0,,Машима Сенпай Менің аға...
Dialogue: 0,0:09:20.64,0:09:23.43,Default,,0,0,0,,Мен көп жұмыс істеймін, өйткені мен өзім болғым келеді!
Dialogue: 0,0:09:28.27,0:09:29.90,Default,,0,0,0,,Өзім…
Dialogue: 0,0:09:29.98,0:09:31.15,Default,,0,0,0,,…және
Dialogue: 0,0:09:31.23,0:09:38.20,Default,,0,0,0,,Сорпамен сулану~
Dialogue: 0,0:09:40.83,0:09:41.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:41.74,0:09:43.83,Default,,0,0,0,,Мен басқа адамның баласын қорғадым.
Dialogue: 0,0:09:43.91,0:09:44.79,Default,,0,0,0,,Мен шабуылдасам да...
Dialogue: 0,0:09:45.96,0:09:48.21,Default,,0,0,0,,Парақтардың санында айырмашылық бар
Dialogue: 0,0:09:48.83,0:09:50.04,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:09:51.46,0:09:52.96,Default,,0,0,0,,Өз жағы пайда болады
Dialogue: 0,0:09:54.80,0:09:57.01,Default,,0,0,0,,Мен шабуыл ойынын тастағым келмейді
Dialogue: 0,0:09:57.09,0:09:59.01,Default,,0,0,0,,Харада Сенсейдің Карутадасы
Dialogue: 0,0:09:59.09,0:10:00.72,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:02.10,0:10:04.39,Default,,0,0,0,,Айтудың қажеті жоқ, мен үшін...
Dialogue: 0,0:10:04.47,0:10:07.14,Default,,0,0,0,,Шабуыл жасағандар ең күшті!
Dialogue: 0,0:10:07.23,0:10:08.73,Default,,0,0,0,,А, а... иә.
Dialogue: 0,0:10:08.81,0:10:10.23,Default,,0,0,0,,Иә
Dialogue: 0,0:10:10.98,0:10:14.78,Default,,0,0,0,,Бірақ Мурао-кунмен кездесуде...
Dialogue: 0,0:10:14.86,0:10:18.32,Default,,0,0,0,,Шаршағандықтан қорғаныс қабілеті шықты.
Dialogue: 0,0:10:19.66,0:10:21.87,Default,,0,0,0,,Бұл сізге сәйкес келді
Dialogue: 0,0:10:26.20,0:10:27.83,Default,,0,0,0,,«Қорғаушы»
Dialogue: 0,0:10:27.91,0:10:29.87,Default,,0,0,0,,Жоқ... қатарынан 7 жеңіс!
Dialogue: 0,0:10:30.79,0:10:32.88,Default,,0,0,0,,Мен бір карта айырмашылығына келдім!
Dialogue: 0,0:10:32.96,0:10:34.17,Default,,0,0,0,,(Тайчидің ауыр тыныс алуы)
Dialogue: 0,0:10:34.84,0:10:35.67,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:36.26,0:10:37.63,Default,,0,0,0,,Бұл мүмкін емес сияқты~
Dialogue: 0,0:10:37.72,0:10:39.26,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:10:39.34,0:10:42.09,Default,,0,0,0,,Мынау... мұнда кел, жартылай дуб!
Dialogue: 0,0:10:42.18,0:10:46.14,Default,,0,0,0,,Менің қателігімнен жағдай түбегейлі өзгерді...
Dialogue: 0,0:10:46.22,0:10:47.52,Default,,0,0,0,,Ыстық
Dialogue: 0,0:10:49.10,0:10:51.27,Default,,0,0,0,,5-7-дегі бірінші жетекші
Dialogue: 0,0:10:51.35,0:10:52.31,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:10:52.40,0:10:53.31,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:10:53.40,0:10:54.23,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:10:54.32,0:10:57.53,Default,,0,0,0,,Фуриюку~Заттар~
Dialogue: 0,0:10:57.61,0:11:03.82,Default,,0,0,0,,Вагаминари～Кери～
Dialogue: 0,0:11:04.87,0:11:07.41,Default,,0,0,0,,Чихаябуру~ (Тайчи) Ах
Dialogue: 0,0:11:07.50,0:11:09.41,Default,,0,0,0,,Жақсы! (Сумире/Цукуба) Иә?
Dialogue: 0,0:11:10.79,0:11:13.13,Default,,0,0,0,,Машима-сенпай «Чиха» деді...
Dialogue: 0,0:11:13.21,0:11:15.50,Default,,0,0,0,,Сондай-ақ жау лагері
Dialogue: 0,0:11:15.59,0:11:17.84,Default,,0,0,0,,Шабуыл мен қорғаныс арасында ауысу кешіктірілді.
Dialogue: 0,0:11:17.92,0:11:19.38,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:11:20.09,0:11:21.55,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:11:21.63,0:11:23.89,Default,,0,0,0,,Мені жіберме, артымнан жүр
Dialogue: 0,0:11:24.85,0:11:26.39,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:11:26.47,0:11:28.06,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:11:28.14,0:11:29.81,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:11:30.48,0:11:31.56,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:11:32.31,0:11:33.31,Default,,0,0,0,,Бір ғана айырмашылық жеткілікті!
Dialogue: 0,0:11:38.44,0:11:39.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:40.70,0:11:42.49,Default,,0,0,0,,1-1 болды.
Dialogue: 0,0:11:44.03,0:11:45.78,Default,,0,0,0,,Тағдыр шайқасы…
Dialogue: 0,0:11:46.45,0:11:49.95,Default,,0,0,0,,Батысты міндетті түрде Арата көрсетеді.
Dialogue: 0,0:11:51.25,0:11:52.83,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:11:52.92,0:11:54.38,Default,,0,0,0,,Шығыста!
Dialogue: 0,0:11:55.92,0:11:58.71,Default,,0,0,0,,Біз кездестік, Мишия немесе...
Dialogue: 0,0:12:01.55,0:12:03.18,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:03.26,0:12:05.47,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:05.55,0:12:07.89,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:09.06,0:12:12.35,Default,,0,0,0,,Амал жоқ, бұл тағдырдың шайқасы.
Dialogue: 0,0:12:12.44,0:12:15.06,Default,,0,0,0,,Менде Койсикавадан бір карта артықшылығы бар.
Dialogue: 0,0:12:15.15,0:12:16.77,Default,,0,0,0,,Керемет
Dialogue: 0,0:12:18.57,0:12:20.48,Default,,0,0,0,,Бұл ұят болды...
Dialogue: 0,0:12:21.74,0:12:23.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:27.87,0:12:29.20,Default,,0,0,0,,Ах
Dialogue: 0,0:12:29.29,0:12:30.83,Default,,0,0,0,,Уф... Сенпай...
Dialogue: 0,0:12:30.91,0:12:32.00,Default,,0,0,0,,Ханано!
Dialogue: 0,0:12:32.08,0:12:33.21,Default,,0,0,0,,Бұл не, Цукуба?
Dialogue: 0,0:12:33.29,0:12:34.96,Default,,0,0,0,,Ханано Барма
Dialogue: 0,0:12:35.04,0:12:36.67,Default,,0,0,0,,Мен болсам, жоқ.
Dialogue: 0,0:12:36.75,0:12:38.96,Default,,0,0,0,,Мен болсам...
Dialogue: 0,0:12:39.04,0:12:41.17,Default,,0,0,0,,Маған қазір ұнамайды!
Dialogue: 0,0:12:41.26,0:12:43.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:47.39,0:12:49.85,Default,,0,0,0,,«Фу» «Ямага» «Ханано» «Имако»…
Dialogue: 0,0:12:49.93,0:12:54.14,Default,,0,0,0,,(Тайчидің дауысы)
Dialogue: 0,0:12:54.23,0:12:55.81,Default,,0,0,0,,Мен санап отырдым
Dialogue: 0,0:12:55.90,0:13:02.86,Default,,0,0,0,,(Тайчидің дауысы)
Dialogue: 0,0:13:04.20,0:13:05.91,Default,,0,0,0,,Мен санап отырдым
Dialogue: 0,0:13:08.16,0:13:10.41,Default,,0,0,0,,Мен олардың барлығын санадым.
Dialogue: 0,0:13:15.58,0:13:17.50,Default,,0,0,0,,100-ші парақ...
Dialogue: 0,0:13:17.58,0:13:19.59,Default,,0,0,0,,Соңына дейін шықпады
Dialogue: 0,0:13:19.67,0:13:21.55,Default,,0,0,0,,Бос карталар жоқ
Dialogue: 0,0:13:21.63,0:13:25.01,Default,,0,0,0,,Жау лагерінің «менінен» өте алмайсың, ақымақ.
Dialogue: 0,0:13:25.80,0:13:27.59,Default,,0,0,0,,Әй
Dialogue: 0,0:13:30.26,0:13:32.22,Default,,0,0,0,,«Чиха»
Dialogue: 0,0:13:32.31,0:13:34.23,Default,,0,0,0,,Жаудың...
Dialogue: 0,0:13:34.31,0:13:36.52,Default,,0,0,0,,Мен оны алуға тура келді.
Dialogue: 0,0:13:36.60,0:13:39.52,Default,,0,0,0,,Қай жерде болса да,
Dialogue: 0,0:13:39.61,0:13:41.77,Default,,0,0,0,,Көзіңді жұмсаң да...
Dialogue: 0,0:13:44.44,0:13:45.99,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:13:51.03,0:13:53.24,Default,,0,0,0,,Ерлер мен әйелдер арасында екінші орын алатын спортшылар анықталды.
Dialogue: 0,0:13:53.33,0:13:55.70,Default,,0,0,0,,Харада-сенсэй Тамару-кунды берді.
Dialogue: 0,0:13:55.79,0:13:58.21,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:13:58.29,0:14:00.08,Default,,0,0,0,,Харада мырза
Dialogue: 0,0:14:00.63,0:14:04.26,Default,,0,0,0,,Мен уақыт түймесін басып жатырмын. 10 минуттан кейін отырыңыз.
Dialogue: 0,0:14:04.34,0:14:05.46,Default,,0,0,0,,Жақында?
Dialogue: 0,0:14:06.26,0:14:07.72,Default,,0,0,0,,Ах
Dialogue: 0,0:14:07.80,0:14:09.22,Default,,0,0,0,,Дәретхана…
Dialogue: 0,0:14:09.30,0:14:10.80,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:12.51,0:14:17.52,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:14:17.60,0:14:20.94,Default,,0,0,0,,(тізедегі ауырсыну дыбысы)
Dialogue: 0,0:14:21.02,0:14:22.48,Default,,0,0,0,,Я...
Dialogue: 0,0:14:23.27,0:14:25.99,Default,,0,0,0,,Харада мырза, сіз қайдасыз?
Dialogue: 0,0:14:26.07,0:14:27.24,Default,,0,0,0,,Сапқа тұрыңыз.
Dialogue: 0,0:14:28.32,0:14:29.99,Default,,0,0,0,,Харада мырза?
Dialogue: 0,0:14:30.07,0:14:33.20,Default,,0,0,0,,Сәлем! Ол шыққанша күтіңіз
Dialogue: 0,0:14:33.28,0:14:34.37,Default,,0,0,0,,Бірақ уақыт...
Dialogue: 0,0:14:34.45,0:14:37.79,Default,,0,0,0,,Өзіңді тым қатты итерсең, адам баласынан ештеңе ала алмайсың.
Dialogue: 0,0:14:37.87,0:14:39.92,Default,,0,0,0,,Бір-екі минутқа сараң болма.
Dialogue: 0,0:14:40.00,0:14:40.96,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:41.04,0:14:44.21,Default,,0,0,0,,Дұрыс, Цуцуми-кун, күте тұр.
Dialogue: 0,0:14:44.30,0:14:46.46,Default,,0,0,0,,Басқалардың да шағымданатынына сенімдімін.
Dialogue: 0,0:14:46.55,0:14:48.09,Default,,0,0,0,,Эй
Dialogue: 0,0:14:53.18,0:14:55.81,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:14:57.52,0:14:58.64,Default,,0,0,0,,Га
Dialogue: 0,0:15:06.78,0:15:07.82,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:09.19,0:15:12.36,Default,,0,0,0,,Харада мырзаның тізесі шегінде.
Dialogue: 0,0:15:12.45,0:15:14.99,Default,,0,0,0,,Шәкірт шоттарды белсенді түрде алды...
Dialogue: 0,0:15:15.08,0:15:16.45,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:16.54,0:15:18.75,Default,,0,0,0,,Тек сабырлы бол, сонда бәрі жақсы болады.
Dialogue: 0,0:15:18.83,0:15:21.33,Default,,0,0,0,,Жалқау болса да болады
Dialogue: 0,0:15:23.25,0:15:24.79,Default,,0,0,0,,Коишикава мырза
Dialogue: 0,0:15:24.88,0:15:28.80,Default,,0,0,0,,Сіздің тізеңіз әлі ауырмағанына сенімдімін.
Dialogue: 0,0:15:28.88,0:15:33.51,Default,,0,0,0,,Мен енді ауырмайтын кезді есіме түсіре алмаймын.
Dialogue: 0,0:15:34.80,0:15:36.01,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:37.39,0:15:40.77,Default,,0,0,0,,Мен бұл денемен доспын.
Dialogue: 0,0:15:40.85,0:15:42.69,Default,,0,0,0,,Аматсуказэ~ (Харада) Ой
Dialogue: 0,0:15:42.77,0:15:45.40,Default,,0,0,0,,Ол соққыны өткізіп алды.
Dialogue: 0,0:15:45.48,0:15:46.61,Default,,0,0,0,,Бірақ мен сенің соңынан ердім.
Dialogue: 0,0:15:46.69,0:15:49.86,Default,,0,0,0,,Койсикава-кун күзетілген формада
Dialogue: 0,0:15:52.36,0:15:53.61,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:15:56.62,0:15:57.45,Default,,0,0,0,,Міне, барамын!
Dialogue: 0,0:15:57.53,0:15:58.66,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:15:58.74,0:16:01.71,Default,,0,0,0,,Харада мырзаның Косаку мырзадан еш айырмашылығы жоқ.
Dialogue: 0,0:16:01.79,0:16:04.58,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:16:04.67,0:16:09.46,Default,,0,0,0,,Ейлаш-кун таяуда тағдырдың жазуымен жаудың іргесіне шабуылдады.
Dialogue: 0,0:16:09.55,0:16:10.76,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:16:10.84,0:16:13.13,Default,,0,0,0,,«Мен өмірімнің соңына дейін өз лагерімнен кетудің қажеті жоқ».
Dialogue: 0,0:16:13.22,0:16:14.64,Default,,0,0,0,,Өйткені мен тілек айттым
Dialogue: 0,0:16:16.22,0:16:18.85,Default,,0,0,0,,Мм, ой, кешіріңіз, мен тиіспедім.
Dialogue: 0,0:16:16.22,0:16:18.85,Default,,0,0,0,,Ariake no ~
Dialogue: 0,0:16:18.85,0:16:19.89,Default,,0,0,0,,Мм, ой, кешіріңіз, мен тиіспедім.
Dialogue: 0,0:16:21.10,0:16:23.56,Default,,0,0,0,,Сенсеңіз де, сенбесеңіз де
Dialogue: 0,0:16:23.64,0:16:27.15,Default,,0,0,0,,Егер сіз зейініңізді жинақтап, ұзақ уақыт жаттығатын болсаңыз
Dialogue: 0,0:16:27.23,0:16:29.57,Default,,0,0,0,,Қандай «оқылмайтын тег»
Dialogue: 0,0:16:29.65,0:16:32.28,Default,,0,0,0,,Мен әйтеуір түсіне бастадым.
Dialogue: 0,0:16:33.07,0:16:36.32,Default,,0,0,0,,Мұны білетіндер оны «Баба» деп атайды.
Dialogue: 0,0:16:36.41,0:16:37.91,Default,,0,0,0,,Жарайды, мен кірдім!
Dialogue: 0,0:16:37.99,0:16:38.83,Default,,0,0,0,,«Енгізілді»?
Dialogue: 0,0:16:39.41,0:16:41.04,Default,,0,0,0,,Сіз түсінесіз.
Dialogue: 0,0:16:42.83,0:16:45.54,Default,,0,0,0,,Орта кезеңнен кейін дайындалу
Dialogue: 0,0:16:45.62,0:16:47.38,Default,,0,0,0,,Ммм (әйел) Ах!
Dialogue: 0,0:16:47.46,0:16:49.38,Default,,0,0,0,,Тағы бір бөлік қалды
Dialogue: 0,0:16:49.46,0:16:50.88,Default,,0,0,0,,Харада Сенсей 4 дана
Dialogue: 0,0:16:50.96,0:16:52.88,Default,,0,0,0,,Бұл жерде қалжыңдама.
Dialogue: 0,0:16:52.97,0:16:54.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:54.17,0:16:55.18,Default,,0,0,0,,(Хараданың ауыр тыныс алуы)
Dialogue: 0,0:16:55.26,0:16:58.89,Default,,0,0,0,,Оқылмаған шоттарды екінші тарапқа жіберу.
Dialogue: 0,0:16:59.76,0:17:00.85,Default,,0,0,0,,Иә? Эй!
Dialogue: 0,0:17:00.93,0:17:03.35,Default,,0,0,0,,Тағдырлы шайқасқа дайындалу...
Dialogue: 0,0:17:03.43,0:17:04.39,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:04.48,0:17:06.85,Default,,0,0,0,,Иә? Сіз ол жігітті танымайсыз ба?
Dialogue: 0,0:17:07.52,0:17:13.28,Default,,0,0,0,,Қарсыласында бір ғана карта қалғаннан кейін Хараданың бетіндегі өрнек «жынды» болды
Dialogue: 0,0:17:13.36,0:17:15.40,Default,,0,0,0,,Бірақ шынымен...
Dialogue: 0,0:17:15.49,0:17:16.74,Default,,0,0,0,,(шотты алу дыбысы)
Dialogue: 0,0:17:16.82,0:17:19.07,Default,,0,0,0,,Басқаларға қарағанда сабырлы
Dialogue: 0,0:17:21.33,0:17:22.79,Default,,0,0,0,,Тағдыр шайқасы…
Dialogue: 0,0:17:22.87,0:17:25.29,Default,,0,0,0,,Тағдырлы шайқас келді
Dialogue: 0,0:17:26.87,0:17:29.67,Default,,0,0,0,,Мен келемін...
Dialogue: 0,0:17:29.75,0:17:30.59,Default,,0,0,0,,Шығыңыз!
Dialogue: 0,0:17:30.67,0:17:32.80,Default,,0,0,0,,Харада Сенсейдің командасы, шығыңыз!
Dialogue: 0,0:17:32.88,0:17:33.80,Default,,0,0,0,,Шығыңыз!
Dialogue: 0,0:17:33.88,0:17:34.80,Default,,0,0,0,,Шығыңыз!
Dialogue: 0,0:17:35.67,0:17:37.01,Default,,0,0,0,,Шығыңыз!
Dialogue: 0,0:17:39.18,0:17:41.85,Default,,0,0,0,,Алыс кет~
Dialogue: 0,0:17:41.93,0:17:42.85,Default,,0,0,0,,Кірпік-күн
Dialogue: 0,0:17:43.89,0:17:45.81,Default,,0,0,0,,Оқылмаған шоттар
Dialogue: 0,0:17:47.10,0:17:48.60,Default,,0,0,0,,мәңгі оқылмайды
Dialogue: 0,0:17:50.69,0:17:56.32,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:17:58.07,0:18:02.12,Default,,0,0,0,,Тағдырлы шайқас тағдыр емес
Dialogue: 0,0:18:04.16,0:18:08.29,Default,,0,0,0,,Ұзақ уақыт бойына зейін қойып, жаттығу
Dialogue: 0,0:18:08.37,0:18:11.38,Default,,0,0,0,,Сіз «оқылмайтын тегтерді» түсіне бастайсыз.
Dialogue: 0,0:18:12.42,0:18:14.84,Default,,0,0,0,,Мәңгі, мәңгі...
Dialogue: 0,0:18:16.09,0:18:18.34,Default,,0,0,0,,45 жыл
Dialogue: 0,0:18:18.43,0:18:20.05,Default,,0,0,0,,Мұны Харада мырза жасады!
Dialogue: 0,0:18:20.14,0:18:23.01,Default,,0,0,0,,Динамикалық жас қарсыласқа қарсы үлкен табандылық
Dialogue: 0,0:18:23.10,0:18:25.68,Default,,0,0,0,,Жоқ, бұл маңызды мәселе емес.
Dialogue: 0,0:18:25.77,0:18:27.77,Default,,0,0,0,,Бір жастасың деп мені кінәлама.
Dialogue: 0,0:18:27.85,0:18:30.94,Default,,0,0,0,,Иә, Карута тек жастық туралы емес.
Dialogue: 0,0:18:31.02,0:18:32.27,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:34.48,0:18:36.15,Default,,0,0,0,,Ха! Сіз ше, Цубогучи?
Dialogue: 0,0:18:38.65,0:18:39.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:42.83,0:18:45.20,Default,,0,0,0,,Шығыс Жапония Мейжин турнирінің іріктеу финалы
Dialogue: 0,0:18:45.29,0:18:47.58,Default,,0,0,0,,Харада мырза Судо мырзаға қарсы
Dialogue: 0,0:18:48.46,0:18:50.08,Default,,0,0,0,,Queen матчының іріктеу финалы
Dialogue: 0,0:18:50.17,0:18:52.58,Default,,0,0,0,,Инокума мырза Ямамото мырзаға қарсы
Dialogue: 0,0:18:52.67,0:18:54.80,Default,,0,0,0,,10 минуттан кейін басталады
Dialogue: 0,0:18:55.42,0:18:56.88,Default,,0,0,0,,(шотты алу дыбысы)
Dialogue: 0,0:19:02.43,0:19:05.85,Default,,0,0,0,,Мен бұл адамдарды жазғы съезде көрдім.
Dialogue: 0,0:19:06.77,0:19:08.60,Default,,0,0,0,,Қайсысы көтеріледі?
Dialogue: 0,0:19:09.89,0:19:13.44,Default,,0,0,0,,Сондай-ақ, мен бұл адамның миожокайдан екеніне сенімдімін ...
Dialogue: 0,0:19:13.52,0:19:14.36,Default,,0,0,0,,Ах
Dialogue: 0,0:19:15.77,0:19:18.07,Default,,0,0,0,,Ватая-кун, тағы бір бөлік қалды
Dialogue: 0,0:19:18.15,0:19:20.45,Default,,0,0,0,,Өткен жылы мен Такемура-куннан жеңіліп қалдым...
Dialogue: 0,0:19:21.95,0:19:23.91,Default,,0,0,0,,Биылғы жыл өте жақсы!
Dialogue: 0,0:19:24.91,0:19:26.91,Default,,0,0,0,,Жаңа емес
Dialogue: 0,0:19:26.99,0:19:31.92,Default,,0,0,0,,Жаудың 1-7-ге дейін ұстап тұру арқылы оның жанынан өтуге мәжбүрлей алмайсыз.
Dialogue: 0,0:19:33.50,0:19:36.63,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:19:36.71,0:19:38.76,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:19:39.26,0:19:41.13,Default,,0,0,0,,аш
Dialogue: 0,0:19:41.80,0:19:44.43,Default,,0,0,0,,Арата жақсы болмаса да, финалда жеңіске жетеді.
Dialogue: 0,0:19:44.51,0:19:45.89,Default,,0,0,0,,Қазір үйге қайт
Dialogue: 0,0:19:45.97,0:19:47.22,Default,,0,0,0,,Шинобу-чан
Dialogue: 0,0:19:47.31,0:19:48.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:48.22,0:19:49.68,Default,,0,0,0,,Исе мырза
Dialogue: 0,0:19:49.77,0:19:51.64,Default,,0,0,0,,Сіз жартылай финалды көрдіңіз бе?
Dialogue: 0,0:19:51.73,0:19:54.27,Default,,0,0,0,,Қалай? Менің Юикавам
Dialogue: 0,0:19:54.35,0:19:58.61,Default,,0,0,0,,Мен университетте бірінші курста оқимын, бірақ біраз уақыттан бері күш жинап жатырмын.
Dialogue: 0,0:19:58.69,0:20:00.94,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:20:01.03,0:20:02.95,Default,,0,0,0,,Не, қарның аш па?
Dialogue: 0,0:20:03.03,0:20:04.57,Default,,0,0,0,,Бұл Шехер астрономиялық басқармасы—
Dialogue: 0,0:20:06.16,0:20:10.29,Default,,0,0,0,,Жоғарыда айтқанымдай, сіз Миоджокайға жаттығуға келесіз бе?
Dialogue: 0,0:20:10.37,0:20:13.54,Default,,0,0,0,,Жоқ, жоқ, мен жай ғана кедергі келтіремін.
Dialogue: 0,0:20:14.17,0:20:17.04,Default,,0,0,0,,Вакамия мырза да қобалжыды.
Dialogue: 0,0:20:17.13,0:20:20.34,Default,,0,0,0,,«Менің немеремнің досы жоқ деп ойлаймын».
Dialogue: 0,0:20:20.42,0:20:21.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:22.01,0:20:24.47,Default,,0,0,0,,Қалай? Менің Юикавам
Dialogue: 0,0:20:24.55,0:20:27.26,Default,,0,0,0,,Менің ойымша, ол жақсы тәжірибелік серіктес болар еді.
Dialogue: 0,0:20:27.35,0:20:28.76,Default,,0,0,0,,Сіз оны жаншып алсаңыз да?
Dialogue: 0,0:20:31.35,0:20:33.77,Default,,0,0,0,,А... күте тұр, Шинобу-чан
Dialogue: 0,0:20:35.06,0:20:37.36,Default,,0,0,0,,Мұны өзіңізбен бірге алыңыз.
Dialogue: 0,0:20:41.07,0:20:43.03,Default,,0,0,0,,Шинобу-чан
Dialogue: 0,0:20:43.70,0:20:46.03,Default,,0,0,0,,Сіз маған кез келген уақытта хабарласа аласыз.
Dialogue: 0,0:20:51.58,0:20:53.54,Default,,0,0,0,,Қосымша күтім және
Dialogue: 0,0:20:54.54,0:20:56.63,Default,,0,0,0,,Қосымша күтім және
Dialogue: 0,0:21:02.55,0:21:04.26,Default,,0,0,0,,Хаха...
Dialogue: 0,0:21:04.34,0:21:05.30,Default,,0,0,0,,Шинкун
Dialogue: 0,0:21:05.38,0:21:06.22,Default,,0,0,0,,Ах
Dialogue: 0,0:21:06.30,0:21:08.43,Default,,0,0,0,,Тағы бір нәрсе қалды (Жаңа) Иә
Dialogue: 0,0:21:08.51,0:21:10.93,Default,,0,0,0,,Финалда кім қарсылас болады?
Dialogue: 0,0:21:11.01,0:21:13.31,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:21:14.18,0:21:16.52,Default,,0,0,0,,Ах, Жапонияның шығысы туралы мәлімет.
Dialogue: 0,0:21:17.23,0:21:20.69,Default,,0,0,0,,Мен телефоннан жартылай финал туралы естідім.
Dialogue: 0,0:21:20.77,0:21:23.40,Default,,0,0,0,,Тайчи қалды
Dialogue: 0,0:21:24.11,0:21:25.61,Default,,0,0,0,,Я...
Dialogue: 0,0:21:26.36,0:21:27.20,Default,,0,0,0,,Ах
Dialogue: 0,0:21:27.82,0:21:29.57,Default,,0,0,0,,Не? «Ыстық»…
Dialogue: 0,0:21:30.62,0:21:31.45,Default,,0,0,0,,Ах
Dialogue: 0,0:21:31.54,0:21:33.50,Default,,0,0,0,,Мурао мырза
Dialogue: 0,0:21:33.58,0:21:35.21,Default,,0,0,0,,Финалистер анықталды!
Dialogue: 0,0:21:35.29,0:21:38.21,Default,,0,0,0,,Шиничи Мурао және Арата Ватая
Dialogue: 0,0:21:40.04,0:21:42.59,Default,,0,0,0,,Нагумо-кай сыныбы!
Dialogue: 0,0:21:45.05,0:21:50.05,Default,,0,0,0,,♪～
Dialogue: 0,0:22:46.82,0:22:51.82,Default,,0,0,0,,～♪
Dialogue: 0,0:22:53.32,0:22:59.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory