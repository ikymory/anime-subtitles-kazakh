Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.29,0:00:43.11,Default,,0,0,0,,<Ханымдар мен мырзалар.
Dialogue: 0,0:00:43.11,0:00:48.30,Default,,0,0,0,,6 сәуір, Ю-Джи-О! фильмінің 5-ші бөлімі! серия басталады →
Dialogue: 0,0:00:48.30,0:00:51.27,Default,,0,0,0,,"Ю-Джи-О! Бес доға".
Dialogue: 0,0:00:51.27,0:00:53.36,Default,,0,0,0,,Оның трансляциясының басталуын еске алу үшін →
Dialogue: 0,0:00:53.36,0:00:56.46,Default,,0,0,0,,Бүгін 2010 жылы шығарылды...>
Dialogue: 0,0:01:04.99,0:01:09.66,Default,,0,0,0,,<Фуду Юсей Нео Дожино қаласын дуэльдер арқылы қорғайды.
Dialogue: 0,0:01:09.66,0:01:12.94,Default,,0,0,0,,Күндердің күнінде Юсейдің алдында, дүниені құрту үшін→
Dialogue: 0,0:01:12.94,0:01:17.65,Default,,0,0,0,,Болашақтың жұмбақ адамы Парадокс пайда болады→
Dialogue: 0,0:01:17.65,0:01:22.64,Default,,0,0,0,,Юсей өзінің жұлдызды айдаһардан айырылады.
Dialogue: 0,0:01:22.64,0:01:25.97,Default,,0,0,0,,Парадоксты қуып, Юсей уақытты аралайды→
Dialogue: 0,0:01:25.97,0:01:31.15,Default,,0,0,0,,Онда Жудей Юки картаның рухының күшін басқарады→
Dialogue: 0,0:01:31.15,0:01:35.13,Default,,0,0,0,,Сонымен қатар, аты аңызға айналған дуэлист Юги Мутомен кездесу→
Dialogue: 0,0:01:35.13,0:01:38.93,Default,,0,0,0,,Үшеуі бірігіп, соғысуға ант береді>
Dialogue: 0,0:01:47.83,0:01:52.98,Default,,0,0,0,,<Енді, олардың облигациялары мен Парадоксты басшылыққа алған үш дулистің арасында→
Dialogue: 0,0:01:52.98,0:01:55.98,Default,,0,0,0,,Қатты жекпе-жек басталады>
Dialogue: 0,0:03:18.40,0:03:40.52,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:40.52,0:03:42.52,Default,,0,0,0,,Қауіпті Қауіпті!
Dialogue: 0,0:03:51.55,0:03:53.55,Default,,0,0,0,,Neos шақырыңыз!
Dialogue: 0,0:04:03.13,0:04:06.30,Default,,0,0,0,,Иудаи Юджо.
Dialogue: 0,0:04:06.30,0:04:09.79,Default,,0,0,0,,Рухтарды басқара алатын сирек дуэлист.
Dialogue: 0,0:04:09.79,0:04:12.32,Default,,0,0,0,,Менің атымның танымал болғаны мақтаныш.
Dialogue: 0,0:04:12.32,0:04:14.96,Default,,0,0,0,,Көшедегі оқиғалар осы жігіттің ісі.
Dialogue: 0,0:04:14.96,0:04:17.65,Default,,0,0,0,,Қаншама жоғалып кеткен құбыжықтар тізіліп тұр.
Dialogue: 0,0:04:17.65,0:04:21.78,Default,,0,0,0,,Сөз жоқ. Оның үстіне, ол құбыжықтарды іске асыра алады!
Dialogue: 0,0:04:21.78,0:04:25.97,Default,,0,0,0,,Сақтықты төмендетпеңіз. Мен палубадан келетін орасан зор энергияны сезінемін.
Dialogue: 0,0:04:25.97,0:04:28.47,Default,,0,0,0,,Бұл жастың мақсаты аяқталды.
Dialogue: 0,0:04:28.47,0:04:30.54,Default,,0,0,0,,Уақыт келді! ? Сіз үшін→
Dialogue: 0,0:04:30.54,0:04:32.54,Default,,0,0,0,,Бұл жерде жоғалып кету керек.
Dialogue: 0,0:04:42.67,0:04:46.97,Default,,0,0,0,,Уау! Бұл алып энергияның шынайы ерекшелігі неде?
Dialogue: 0,0:04:51.00,0:04:53.00,Default,,0,0,0,,[Баяндамашы] Төтенше жағдай жарияланды.
Dialogue: 0,0:04:53.00,0:04:55.00,Default,,0,0,0,,Қаш! Асығыңыз!
Dialogue: 0,0:05:16.65,0:05:20.31,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:05:20.31,0:05:23.94,Default,,0,0,0,,Сіз тағы да сол түс көрдіңіз бе?
Dialogue: 0,0:05:23.94,0:05:27.65,Default,,0,0,0,,Сіз мұнда келгенде әрқашан солай болады.
Dialogue: 0,0:05:27.65,0:05:31.79,Default,,0,0,0,,Бұл қала әкемнің зерттеуінің арқасында бір рет жойылды.
Dialogue: 0,0:05:31.79,0:05:34.67,Default,,0,0,0,,Бірақ «Нөлдік кері» сіздің кінәңіз емес.
Dialogue: 0,0:05:34.67,0:05:38.23,Default,,0,0,0,,Сіз сәби кезіңізде не істер едіңіз?
Dialogue: 0,0:05:38.23,0:05:42.20,Default,,0,0,0,,Дұрыс. Керісінше, біз қаланы өз қолымызбен қорғап келеміз.
Dialogue: 0,0:05:42.20,0:05:45.00,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:05:49.30,0:05:51.29,Default,,0,0,0,,Бұл осындай кездер үшін жекпе-жек.
Dialogue: 0,0:05:51.29,0:05:53.32,Default,,0,0,0,,Өзімізді сергіп алайық!
Dialogue: 0,0:05:53.32,0:05:55.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:55.28,0:06:06.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:06.80,0:06:11.33,Default,,0,0,0,,《Біз Нео Дожинно қаласының тыныштығын қалпына келтірдік.
Dialogue: 0,0:06:11.33,0:06:15.28,Default,,0,0,0,,Мен бұл қаланы не болса да қорғаймын! 》
Dialogue: 0,0:06:15.28,0:06:38.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:38.32,0:06:41.27,Default,,0,0,0,,Бұл үлкен D дөңгелегі қандай?
Dialogue: 0,0:06:41.27,0:06:45.89,Default,,0,0,0,,Сізде бізді матчқа шақыруға күшіңіз жетеді.
Dialogue: 0,0:06:45.89,0:06:48.66,Default,,0,0,0,,Маған бұл дуэльді шешуге рұқсат етіңіз.
Dialogue: 0,0:06:48.66,0:06:50.61,Default,,0,0,0,,Аа, мен саған қалдырамын, Юсей.
Dialogue: 0,0:06:50.61,0:06:52.68,Default,,0,0,0,,Дуэль режимі қосулы.
Dialogue: 0,0:06:52.68,0:06:55.68,Default,,0,0,0,,Дуэльді жылдамдату!
Dialogue: 0,0:07:14.29,0:07:16.99,Default,,0,0,0,,Шабуыл іске асады. аа.
Dialogue: 0,0:07:16.99,0:07:19.44,Default,,0,0,0,,Бірақ Юсейдің өрісі мінсіз.
Dialogue: 0,0:07:19.44,0:07:21.80,Default,,0,0,0,,Бірден өзіңе қамқор бол!
Dialogue: 0,0:07:21.80,0:07:24.90,Default,,0,0,0,,Кеттік, Жұлдызды айдаһар.
Dialogue: 0,0:07:27.43,0:07:30.45,Default,,0,0,0,,Ұжымдық тілектер жаңа жарық жұлдызға айналады.
Dialogue: 0,0:07:30.45,0:07:32.51,Default,,0,0,0,,Жарықтың жолы бол.
Dialogue: 0,0:07:32.51,0:07:38.51,Default,,0,0,0,,Synchro Summon Fly, Stardust Dragon!
Dialogue: 0,0:07:44.47,0:07:46.47,Default,,0,0,0,,Хехехе….
Dialogue: 0,0:07:48.47,0:07:50.49,Default,,0,0,0,,Не, бос карта?
Dialogue: 0,0:07:50.49,0:08:12.33,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:12.33,0:08:15.12,Default,,0,0,0,,Ақымақ жұлдызды айдаһар...
Dialogue: 0,0:08:15.12,0:08:17.32,Default,,0,0,0,,Оның картасында...
Dialogue: 0,0:08:17.32,0:08:19.29,Default,,0,0,0,,Ол сорылды ма?
Dialogue: 0,0:08:19.29,0:08:21.82,Default,,0,0,0,,Хехехе….
Dialogue: 0,0:08:21.82,0:08:27.34,Default,,0,0,0,,Юсей Фудоу Мен сенің жұлдызшаңды аламын.
Dialogue: 0,0:08:27.34,0:08:30.10,Default,,0,0,0,,Осы жаста өледі.
Dialogue: 0,0:08:30.10,0:08:32.32,Default,,0,0,0,,Не? Хахаха….
Dialogue: 0,0:08:32.32,0:08:34.32,Default,,0,0,0,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,0:08:34.32,0:08:48.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:50.33,0:08:52.27,Default,,0,0,0,,Не болды!
Dialogue: 0,0:08:52.27,0:08:55.32,Default,,0,0,0,,Бұлай жоғалып кету оңай емес.
Dialogue: 0,0:08:55.32,0:08:57.27,Default,,0,0,0,,Ол менің атымды білді.
Dialogue: 0,0:08:57.27,0:08:59.61,Default,,0,0,0,,Сонда сіз басынан Жұлдыз шаңын көздедіңіз бе?
Dialogue: 0,0:08:59.61,0:09:02.81,Default,,0,0,0,,Планета.
Dialogue: 0,0:09:02.81,0:09:04.95,Default,,0,0,0,,Аки Рюя Рюка.
Dialogue: 0,0:09:04.95,0:09:09.39,Default,,0,0,0,,Бұл не үшін? Менің қазір сендермен айналысатын уақытым жоқ.
Dialogue: 0,0:09:09.39,0:09:12.66,Default,,0,0,0,,Ей, біз үлкен кесе таптық.
Dialogue: 0,0:09:12.66,0:09:14.61,Default,,0,0,0,,Не таптың?
Dialogue: 0,0:09:14.61,0:09:18.15,Default,,0,0,0,,Мен кітапханада «Дуэль монстрларының» тарихын зерттеп жүрген кезім→
Dialogue: 0,0:09:18.15,0:09:20.45,Default,,0,0,0,,Бұл. иә?
Dialogue: 0,0:09:20.45,0:09:22.98,Default,,0,0,0,,Бұл өте ескі мақала.
Dialogue: 0,0:09:22.98,0:09:25.15,Default,,0,0,0,,Бұл жігіт біледі.
Dialogue: 0,0:09:25.15,0:09:28.62,Default,,0,0,0,,Pegasus Дж. Кроуфорд, өнеркәсіптік иллюзияның төрағасы.
Dialogue: 0,0:09:28.62,0:09:30.82,Default,,0,0,0,,Ол дуэль монстрларының жасаушысы.
Dialogue: 0,0:09:30.82,0:09:32.79,Default,,0,0,0,,Суретте кімдер бірге?
Dialogue: 0,0:09:32.79,0:09:35.75,Default,,0,0,0,,Бұл адам Duel Monsters тарихында→
Dialogue: 0,0:09:35.75,0:09:38.98,Default,,0,0,0,,Бұл Юги Муто, ең мықты деген дуэлист.
Dialogue: 0,0:09:38.98,0:09:41.32,Default,,0,0,0,,Аты аталмаған перғауынның жаны бар деген қауесет.
Dialogue: 0,0:09:41.32,0:09:43.40,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:43.40,0:09:45.29,Default,,0,0,0,,Бұл мен кем дегенде бір рет күрескім келетін нәрсе.
Dialogue: 0,0:09:45.29,0:09:48.83,Default,,0,0,0,,Жарайды, уақытты кері қайтармайынша, бұл мүмкін емес.
Dialogue: 0,0:09:48.83,0:09:53.00,Default,,0,0,0,,Сіз маған мұны көрсету үшін келдіңіз бе? Жоқ, келесі мақаланы қараңыз.
Dialogue: 0,0:09:53.00,0:09:56.45,Default,,0,0,0,,Жұлдызды айдаһар!
Dialogue: 0,0:09:56.45,0:09:59.32,Default,,0,0,0,,Неліктен қазіргі заманда? (Рюя) Мен мұны естігім келеді.
Dialogue: 0,0:09:59.32,0:10:03.79,Default,,0,0,0,,Не? «Айдаһарлар кенеттен бүкіл Еуропада пайда болды→
Dialogue: 0,0:10:03.79,0:10:06.48,Default,,0,0,0,,Олар дулистерге бірінен соң бірі шабуыл жасайды.''
Dialogue: 0,0:10:06.48,0:10:11.18,Default,,0,0,0,,Жұлдызды айдаһар өткенге барады. Ал дулистерге шабуыл жасау үшін...
Dialogue: 0,0:10:11.18,0:10:13.98,Default,,0,0,0,,Мен мұндай ақымақ тарихты бірінші рет естіп тұрмын.
Dialogue: 0,0:10:19.32,0:10:21.36,Default,,0,0,0,,Бұрынғы бетперде киген адам!
Dialogue: 0,0:10:21.36,0:10:24.16,Default,,0,0,0,,Не?
Dialogue: 0,0:10:36.32,0:10:39.83,Default,,0,0,0,,Бұл не...? Қала жоғалып барады.
Dialogue: 0,0:10:39.83,0:10:42.93,Default,,0,0,0,,Неліктен...? Бұл жай ғана гипотеза, бірақ →
Dialogue: 0,0:10:42.93,0:10:45.48,Default,,0,0,0,,Жұлдыз шаңы бұрын пайда болғандай →
Dialogue: 0,0:10:45.48,0:10:47.45,Default,,0,0,0,,Тарих өзгере бастаған болуы мүмкін.
Dialogue: 0,0:10:47.45,0:10:49.49,Default,,0,0,0,,Мені ақымақ деп атаңыз.
Dialogue: 0,0:10:49.49,0:10:52.44,Default,,0,0,0,,Қаламыз күйреп барады.
Dialogue: 0,0:10:52.44,0:10:56.04,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:10:56.04,0:10:58.14,Default,,0,0,0,,көремін. Бұл оның ісі.
Dialogue: 0,0:11:02.02,0:11:04.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:06.30,0:11:10.51,Default,,0,0,0,,Арқасында қызыл айдаһардың туу белгісі бар.
Dialogue: 0,0:11:10.51,0:11:14.11,Default,,0,0,0,,Юсейдің D дөңгелегі жарқырап тұр. Бұл қызыл айдаһардың күші ме?
Dialogue: 0,0:11:16.15,0:11:19.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:19.33,0:11:22.43,Default,,0,0,0,,Юсей! Қызыл айдаһар шақырып жатыр!
Dialogue: 0,0:11:27.36,0:11:30.96,Default,,0,0,0,,Қызыл айдаһар, мені Жұлдызды шаңға апар!
Dialogue: 0,0:11:35.28,0:11:37.32,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:11:37.32,0:11:48.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:48.35,0:11:51.82,Default,,0,0,0,,Бұл ақ айдаһар қандай?
Dialogue: 0,0:11:51.82,0:11:55.35,Default,,0,0,0,,Judai Юки Сіз осы жерден жойыласыз.
Dialogue: 0,0:11:55.35,0:11:58.35,Default,,0,0,0,,Sonic түсіру!
Dialogue: 0,0:12:03.33,0:12:06.38,Default,,0,0,0,,Неос... Уау!
Dialogue: 0,0:12:06.38,0:12:21.33,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:21.33,0:12:23.33,Default,,0,0,0,,Не?
Dialogue: 0,0:12:26.98,0:12:28.97,Default,,0,0,0,,Жұлдызды айдаһар!
Dialogue: 0,0:12:28.97,0:12:31.67,Default,,0,0,0,,Сіз мені уақыт бойынша бақылайсыз ба?
Dialogue: 0,0:12:31.67,0:12:34.31,Default,,0,0,0,,Кисама! Мен үзілдім.
Dialogue: 0,0:12:34.31,0:12:36.94,Default,,0,0,0,,Иудаи Бұл саған.
Dialogue: 0,0:12:36.94,0:12:39.65,Default,,0,0,0,,Бұл дәуірде де менің үлкен тәжірибемнің арқасында →
Dialogue: 0,0:12:39.65,0:12:42.28,Default,,0,0,0,,Ол жойылады. Не! ?
Dialogue: 0,0:12:42.28,0:12:44.54,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:12:44.54,0:12:46.54,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:12:57.61,0:12:59.65,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:59.65,0:13:01.67,Default,,0,0,0,,Әй, бір сызат.
Dialogue: 0,0:13:01.67,0:13:05.44,Default,,0,0,0,,Ендеше мен сізден тағы сұрайын, сізді әлгі біртүрлі маска ұрлап кетті→
Dialogue: 0,0:13:05.44,0:13:08.89,Default,,0,0,0,,Ақ айдаһарды қуу, Аруақтардың күшін қарызға алу→
Dialogue: 0,0:13:08.89,0:13:12.61,Default,,0,0,0,,Бұл болашақтан уақытқа саяхаттағаныңызды білдіре ме?
Dialogue: 0,0:13:12.61,0:13:16.32,Default,,0,0,0,,Дұрыс. Сіз маған сенбейсіз деп ойлаймын...
Dialogue: 0,0:13:16.32,0:13:18.32,Default,,0,0,0,,Мен сенемін.
Dialogue: 0,0:13:18.32,0:13:22.61,Default,,0,0,0,,Уақытты жеңу өте қызықты емес пе?
Dialogue: 0,0:13:22.61,0:13:26.14,Default,,0,0,0,,Жақсы…. Менің атым Фудо Юсей.
Dialogue: 0,0:13:26.14,0:13:29.30,Default,,0,0,0,,Мен Джудай Юкимін. танысқаныма қуаныштымын!
Dialogue: 0,0:13:29.30,0:13:31.48,Default,,0,0,0,,Айтпақшы, қызық болдым→
Dialogue: 0,0:13:31.48,0:13:34.17,Default,,0,0,0,,Бұл болашақ дуэль дискісі ме? Иә.
Dialogue: 0,0:13:34.17,0:13:37.29,Default,,0,0,0,,Уау! Ол соншалықты дамиды ма?
Dialogue: 0,0:13:37.29,0:13:40.32,Default,,0,0,0,,Сен оны мінгің келеді, Иуда.
Dialogue: 0,0:13:40.32,0:13:43.94,Default,,0,0,0,,Сен кенеттен пайда болсаң, Юсей таң қалар еді.
Dialogue: 0,0:13:43.94,0:13:46.65,Default,,0,0,0,,Бізді көрсеңіз таң қалмас едім.
Dialogue: 0,0:13:46.65,0:13:51.05,Default,,0,0,0,,Оның да құдіретті рухтың күші бар.
Dialogue: 0,0:13:51.05,0:13:52.94,Default,,0,0,0,,Сіз осы туған белгі туралы айтып отырсыз.
Dialogue: 0,0:13:52.94,0:13:56.99,Default,,0,0,0,,Сіз сондай-ақ Duel Monsters таңдаған дуэлистсіз.
Dialogue: 0,0:13:56.99,0:14:01.28,Default,,0,0,0,,Айтпақшы, сен онымен неге ұрысып қалдың?
Dialogue: 0,0:14:01.28,0:14:04.00,Default,,0,0,0,,Соңғы уақытта Duel Monsters карталары осында болды→
Dialogue: 0,0:14:04.00,0:14:06.17,Default,,0,0,0,,Бірінен соң бірі жоғалып бара жатқан жағдайлар.
Dialogue: 0,0:14:06.17,0:14:10.04,Default,,0,0,0,,Мен оны қуып келе жатқанда, мен оны кездестірдім.
Dialogue: 0,0:14:10.04,0:14:16.19,Default,,0,0,0,,Жудай-сан, мен Жұлдызды айдаһарды қайтаруым керек.
Dialogue: 0,0:14:16.19,0:14:18.80,Default,,0,0,0,,Мен оны жалғыз қалдырсам, менің қалам...
Dialogue: 0,0:14:18.80,0:14:21.15,Default,,0,0,0,,Жоқ, бұл менің қалам ғана емес.
Dialogue: 0,0:14:21.15,0:14:24.02,Default,,0,0,0,,Тарих бұрмаланып, дүние жойылады.
Dialogue: 0,0:14:24.02,0:14:26.94,Default,,0,0,0,,Иудаи мырза, маған күшіңізді беріңізші.
Dialogue: 0,0:14:26.94,0:14:30.97,Default,,0,0,0,,Әрине. Менің басымнан осындай жағдай болған соң кері қайтара аламын ба деп ойлаймын!
Dialogue: 0,0:14:30.97,0:14:33.38,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:14:33.38,0:14:35.65,Default,,0,0,0,,Сонымен, оны қалай табасыз?
Dialogue: 0,0:14:35.65,0:14:38.03,Default,,0,0,0,,Өткенге кеткен шығар.
Dialogue: 0,0:14:38.03,0:14:41.95,Default,,0,0,0,,Иә. Сондықтан тарихта бір жерде тағы бір бұрмалау туады →
Dialogue: 0,0:14:41.95,0:14:45.16,Default,,0,0,0,,Бұл дәуірдің жазбаларында да көрінуі керек.
Dialogue: 0,0:14:45.16,0:14:49.03,Default,,0,0,0,,Мен көремін. Бар болғаны сол бұрмаланған жазбаны табу керек.
Dialogue: 0,0:14:49.03,0:14:51.81,Default,,0,0,0,,Мен тығып қойған сөмкенің қауіпсіз болғанына қуаныштымын.
Dialogue: 0,0:14:51.81,0:14:54.70,Default,,0,0,0,,Manjome Group дерекқорына кірсеңіз →
Dialogue: 0,0:14:54.70,0:14:57.28,Default,,0,0,0,,Сіз мұндай мақаланы таба аласыз.
Dialogue: 0,0:14:57.28,0:14:59.65,Default,,0,0,0,,Ой... мінеки!
Dialogue: 0,0:14:59.65,0:15:03.01,Default,,0,0,0,,О, құдай! Бұл оның мақсаты!
Dialogue: 0,0:15:03.01,0:15:05.33,Default,,0,0,0,,Егер шынымен де осындай нәрсе болған болса...
Dialogue: 0,0:15:05.33,0:15:07.36,Default,,0,0,0,,Ал егер...
Dialogue: 0,0:15:07.36,0:15:09.96,Default,,0,0,0,,Neos жоғалып барады!
Dialogue: 0,0:15:25.05,0:15:27.33,Default,,0,0,0,,Бұл сіз айтып отырған нәрсе ме?
Dialogue: 0,0:15:27.33,0:15:29.33,Default,,0,0,0,,Асығыңыз! Ах.
Dialogue: 0,0:16:35.32,0:16:38.79,Default,,0,0,0,,Бұл шынымен де өте көп адам болды.
Dialogue: 0,0:16:38.79,0:16:43.79,Default,,0,0,0,,Бүгінгі жекпе-жек турниріне арнайы қонақ ретінде Pegasus кіреді.
Dialogue: 0,0:16:46.34,0:16:48.88,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:16:48.88,0:16:52.63,Default,,0,0,0,,Бүгін осы қалада Duel Monsters турнирі өтеді→
Dialogue: 0,0:16:52.63,0:16:56.64,Default,,0,0,0,,Мен шынымен бақыттымын!
Dialogue: 0,0:16:56.64,0:17:00.64,Default,,0,0,0,,Хехе, бұл тағдыр.
Dialogue: 0,0:17:08.98,0:17:11.37,Default,,0,0,0,,Wow~ Соңғы қатты көрініс →
Dialogue: 0,0:17:11.37,0:17:13.37,Default,,0,0,0,,Ол алға жылжуда.
Dialogue: 0,0:17:21.95,0:17:23.96,Default,,0,0,0,,Бұл сенімді көзқарас емес!
Dialogue: 0,0:17:23.96,0:17:26.03,Default,,0,0,0,,Уау Юги!
Dialogue: 0,0:17:26.03,0:17:28.03,Default,,0,0,0,,Өрмекшілердің сыбдыры мүлдем жеккөрінішті!
Dialogue: 0,0:17:33.27,0:17:36.31,Default,,0,0,0,,О, Құдайым. Бұл қиын!
Dialogue: 0,0:17:36.31,0:17:40.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:40.30,0:17:42.30,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:10.98,0:18:13.40,Default,,0,0,0,,Ата….
Dialogue: 0,0:18:13.40,0:18:19.40,Default,,0,0,0,,Болды... Ата! !
Dialogue: 0,0:18:21.32,0:18:23.66,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:18:23.66,0:18:28.95,Default,,0,0,0,,Хахахаха... Менің керемет экспериментім орындалды.
Dialogue: 0,0:18:28.95,0:18:32.03,Default,,0,0,0,,Дүниежүзілік тарих өзгереді.
Dialogue: 0,0:18:32.03,0:18:35.63,Default,,0,0,0,,Хехехе... Хахахахаха!
Dialogue: 0,0:18:40.69,0:18:43.99,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:18:50.00,0:18:51.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:51.94,0:18:55.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:55.39,0:18:57.27,Default,,0,0,0,,Ита та та та та….
Dialogue: 0,0:18:57.27,0:18:59.31,Default,,0,0,0,,Амансың ба? иә?
Dialogue: 0,0:18:59.31,0:19:02.33,Default,,0,0,0,,Қатты әрекет еткенім үшін кешіріңіз.
Dialogue: 0,0:19:02.33,0:19:04.33,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:19:07.98,0:19:10.65,Default,,0,0,0,,Не болды? Ата, Пегасус ше?
Dialogue: 0,0:19:10.65,0:19:12.99,Default,,0,0,0,,Сен амансың, Юги-сан.
Dialogue: 0,0:19:12.99,0:19:16.36,Default,,0,0,0,,Біз оқиғадан 30 минут бұрын сонда болдық.
Dialogue: 0,0:19:16.36,0:19:18.36,Default,,0,0,0,,30 минут бұрын?
Dialogue: 0,0:19:21.60,0:19:25.32,Default,,0,0,0,,Жақсы! Әлі де жақсы. (Юги) Балалар...
Dialogue: 0,0:19:25.32,0:19:27.65,Default,,0,0,0,,Мен Фудо Юсеймін.
Dialogue: 0,0:19:27.65,0:19:29.97,Default,,0,0,0,,Мен Жудай Юкимін.
Dialogue: 0,0:19:29.97,0:19:32.94,Default,,0,0,0,,Юсей-кун мен Жудай-кун.
Dialogue: 0,0:19:32.94,0:19:36.38,Default,,0,0,0,,Сіз мені Юсей, Юги-сан деп атай аласыз.
Dialogue: 0,0:19:36.38,0:19:38.65,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:19:38.65,0:19:40.98,Default,,0,0,0,,Біз болашақтанбыз.
Dialogue: 0,0:19:40.98,0:19:43.05,Default,,0,0,0,,Болашақ? Иә.
Dialogue: 0,0:19:43.05,0:19:45.99,Default,,0,0,0,,Барлығын 30 минуттан кейін болатын трагедиядан құтқару.
Dialogue: 0,0:19:45.99,0:19:49.96,Default,,0,0,0,,Болашақтан газет көрдік.
Dialogue: 0,0:19:49.96,0:19:53.65,Default,,0,0,0,,Оның мен көрген бетперде киген адамға қатысы бар ма?
Dialogue: 0,0:19:53.65,0:19:57.60,Default,,0,0,0,,Иә. Ол Pegasus төрағасын жоюға тырысады.
Dialogue: 0,0:19:57.60,0:19:59.65,Default,,0,0,0,,Pegasus! ?
Dialogue: 0,0:19:59.65,0:20:02.62,Default,,0,0,0,,Төраға Пегасус жоғалып кетсе, Дуэль Монстрларының тарихы...
Dialogue: 0,0:20:02.62,0:20:05.94,Default,,0,0,0,,Жоқ, тіпті дүние тарихы да күрт өзгереді.
Dialogue: 0,0:20:05.94,0:20:09.40,Default,,0,0,0,,Болашақ әлемде дуэль құбыжықтары жоғалып кетті→
Dialogue: 0,0:20:09.40,0:20:11.93,Default,,0,0,0,,Қала жойылғалы тұр.
Dialogue: 0,0:20:11.93,0:20:14.33,Default,,0,0,0,,Міне...
Dialogue: 0,0:20:14.33,0:20:17.00,Default,,0,0,0,,Бірге күресіңдер, Юги-сан!
Dialogue: 0,0:20:17.00,0:20:20.00,Default,,0,0,0,,Әлемді өз күшімізбен қорғайық!
Dialogue: 0,0:20:26.70,0:20:29.00,Default,,0,0,0,,Мен әңгімені түсіндім.
Dialogue: 0,0:20:30.95,0:20:33.99,Default,,0,0,0,,Жудай-кун. Юсей-кун.
Dialogue: 0,0:20:33.99,0:20:37.66,Default,,0,0,0,,Маған жақсы болса, қуана көмектесемін.
Dialogue: 0,0:20:37.66,0:20:40.63,Default,,0,0,0,,Күш біріктіріп, күресейік!
Dialogue: 0,0:20:40.63,0:20:43.31,Default,,0,0,0,,Юги-санға рахмет! Жақсы! !
Dialogue: 0,0:20:43.31,0:20:45.98,Default,,0,0,0,,Юги менімен бірге болса, бізде 100 адам болады!
Dialogue: 0,0:20:45.98,0:20:47.98,Default,,0,0,0,,Егер сіз мұны шешсеңіз...
Dialogue: 0,0:20:49.99,0:20:51.94,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:20:51.94,0:20:53.97,Default,,0,0,0,,Барлығына! Тез қаш!
Dialogue: 0,0:20:53.97,0:20:56.64,Default,,0,0,0,,Алаңды тез көшіріңіз!
Dialogue: 0,0:20:56.64,0:21:00.28,Default,,0,0,0,,көремін. Турнир өтпей қалса, мұндай оқиға болмас еді.
Dialogue: 0,0:21:00.28,0:21:03.37,Default,,0,0,0,,Pegasus төрағасына хабарласу ғана қалды...
Dialogue: 0,0:21:03.37,0:21:05.37,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:21:12.61,0:21:14.64,Default,,0,0,0,,Сіз жай ғана...
Dialogue: 0,0:21:14.64,0:21:18.28,Default,,0,0,0,,Мен дуэлистер патшасының осында екеніне сене алмаймын.
Dialogue: 0,0:21:18.28,0:21:20.32,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:21:20.32,0:21:23.00,Default,,0,0,0,,Неліктен мұндай сұмдық әрекет етесің!
Dialogue: 0,0:21:23.00,0:21:26.30,Default,,0,0,0,,Неліктен? Хун, жарайды.
Dialogue: 0,0:21:29.31,0:21:32.31,Default,,0,0,0,,Менің атым Парадокс.
Dialogue: 0,0:21:32.31,0:21:34.26,Default,,0,0,0,,Парадокс?
Dialogue: 0,0:21:34.26,0:21:37.98,Default,,0,0,0,,Мен ең жақсы тарихты іздеуде уақыт пен кеңістіктен асып түсетін адаммын.
Dialogue: 0,0:21:37.98,0:21:42.62,Default,,0,0,0,,Барлық тарихи мүмкіндіктерді қарастырып, оларды жүзеге асырыңыз.
Dialogue: 0,0:21:42.62,0:21:44.66,Default,,0,0,0,,Ең жақсы тарих?
Dialogue: 0,0:21:44.66,0:21:47.33,Default,,0,0,0,,Кисаманың істеп жатқаны бүлінуден басқа ештеңе емес!
Dialogue: 0,0:21:47.33,0:21:50.68,Default,,0,0,0,,Бұл барлығын құрбан ету дұрыс әрекет екенін білдіре ме?
Dialogue: 0,0:21:50.68,0:21:55.99,Default,,0,0,0,,Жою үшін құрбандық... Хехе түсіндім. Сізге солай көрінеді ме?
Dialogue: 0,0:21:55.99,0:21:57.95,Default,,0,0,0,,Бірақ бұл басқаша.
Dialogue: 0,0:21:57.95,0:22:00.66,Default,,0,0,0,,Дұрыс болып көрінген болашақ бұрыс→
Dialogue: 0,0:22:00.66,0:22:03.68,Default,,0,0,0,,Бір қарағанда қате болып көрінетін болашақ дұрыс.
Dialogue: 0,0:22:03.68,0:22:05.61,Default,,0,0,0,,Ойлан.
Dialogue: 0,0:22:05.61,0:22:09.32,Default,,0,0,0,,Мен ештеңе істемесем де, дүние қайшылыққа толы.
Dialogue: 0,0:22:09.32,0:22:13.27,Default,,0,0,0,,Қоршаған ортаның бұзылуы Дүниежүзілік қақтығыс Адамдар арасындағы кемсітушілік.
Dialogue: 0,0:22:13.27,0:22:16.66,Default,,0,0,0,,Осының бәрі жойылу мен құрбандық емес пе?
Dialogue: 0,0:22:16.66,0:22:19.66,Default,,0,0,0,,Бұл адамзаттың әлі шешілмеген зұлым істері→
Dialogue: 0,0:22:19.66,0:22:22.26,Default,,0,0,0,,Балалар, мұны қалай түсіндіресіңдер?
Dialogue: 0,0:22:22.26,0:22:25.82,Default,,0,0,0,,Оны бірден орындау мүмкін болмаса да, адамдар оны бір күні түсінеді!
Dialogue: 0,0:22:25.82,0:22:28.27,Default,,0,0,0,,Жауабы бос сөз.
Dialogue: 0,0:22:28.27,0:22:31.99,Default,,0,0,0,,Бірақ біз қираған қалада тұрамыз... Қайта тірілді!
Dialogue: 0,0:22:31.99,0:22:34.66,Default,,0,0,0,,Спутник пен Қала біртұтас болды.
Dialogue: 0,0:22:34.66,0:22:38.03,Default,,0,0,0,,Мұны бәріміз білеміз, Фудо Юсей!
Dialogue: 0,0:22:38.03,0:22:40.98,Default,,0,0,0,,Мен алыстан келдім.
Dialogue: 0,0:22:40.98,0:22:43.95,Default,,0,0,0,,Әлем жойылған болашақтан.
Dialogue: 0,0:22:43.95,0:22:47.02,Default,,0,0,0,,Әлем... жойылған болашақ...
Dialogue: 0,0:22:47.02,0:22:49.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:22:55.03,0:22:58.00,Default,,0,0,0,,Тарих жалғыз қалса, дүние жойылады.
Dialogue: 0,0:22:58.00,0:23:02.39,Default,,0,0,0,,Мен осы үмітсіз болашақты өзгерту үшін келдім.
Dialogue: 0,0:23:02.39,0:23:05.29,Default,,0,0,0,,Уақыттың барлық деректерін талдаймын→
Dialogue: 0,0:23:05.29,0:23:08.99,Default,,0,0,0,,Дуэль монстрларының жұмбақ күштері бар екені анықталды.
Dialogue: 0,0:23:08.99,0:23:14.38,Default,,0,0,0,,Содан кейін мен сол тарихты өзгерту идеясын алдым.
Dialogue: 0,0:23:14.38,0:23:16.32,Default,,0,0,0,,Болашақты өзгерту туралы не деуге болады?
Dialogue: 0,0:23:16.32,0:23:19.70,Default,,0,0,0,,Нео Дожино қаласын осы мақсатпен жоймақсыз ба?
Dialogue: 0,0:23:19.70,0:23:21.70,Default,,0,0,0,,Жоқ, бұл бәрі емес.
Dialogue: 0,0:23:21.70,0:23:25.64,Default,,0,0,0,,Қазір онда көптеген адамдар тұрады, Төраға Пегасус →
Dialogue: 0,0:23:25.64,0:23:28.80,Default,,0,0,0,,Югидің аталары не болып жатқанына бәрібір дей ме?
Dialogue: 0,0:23:28.80,0:23:30.81,Default,,0,0,0,,Мұндай шағын құрбандықтар →
Dialogue: 0,0:23:30.81,0:23:34.15,Default,,0,0,0,,Бұл керемет эксперименттегі бір ғана қызық қадам.
Dialogue: 0,0:23:34.15,0:23:36.12,Default,,0,0,0,,Бұл қызықсыз процесс!
Dialogue: 0,0:23:36.12,0:23:39.66,Default,,0,0,0,,Әр адам өз болашағын өмір сүруге құқылы.
Dialogue: 0,0:23:39.66,0:23:43.94,Default,,0,0,0,,Адамдардың болашақты өзгерту күші бар. Мен бұған сенемін!
Dialogue: 0,0:23:43.94,0:23:45.98,Default,,0,0,0,,Хмм, қызық.
Dialogue: 0,0:23:45.98,0:23:48.98,Default,,0,0,0,,Болашақ қанша үмітсіз болса да, кері серпілу күші→
Dialogue: 0,0:23:48.98,0:23:52.47,Default,,0,0,0,,Бар десең, дәлелде.
Dialogue: 0,0:23:52.47,0:23:55.82,Default,,0,0,0,,Парадокс дуэлі! Оны реттейік!
Dialogue: 0,0:23:55.82,0:23:59.46,Default,,0,0,0,,Жарайды. Сіз сенетін дуэль құбыжықтары →
Dialogue: 0,0:23:59.46,0:24:01.76,Default,,0,0,0,,Оны ұсақтап алайық.
Dialogue: 0,0:24:16.31,0:24:21.30,Default,,0,0,0,,Мен сені жеңгенім үшін толқудамын!
Dialogue: 0,0:24:21.30,0:24:24.77,Default,,0,0,0,,Біз Кисаманың болашағымызды шешуіне жол бермейміз!
Dialogue: 0,0:24:24.77,0:24:27.84,Default,,0,0,0,,Досым, мұны маған қалдыра аласың ба?
Dialogue: 0,0:24:27.84,0:24:31.02,Default,,0,0,0,,Тағы бір қызметші...
Dialogue: 0,0:24:31.02,0:24:33.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:24:41.27,0:24:45.36,Default,,0,0,0,,Мен адамдардың өмірі баспалдақ ретінде пайдаланылатын болашақты қабылдамаймын.
Dialogue: 0,0:24:45.36,0:24:47.36,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:24:54.18,0:24:56.28,Default,,0,0,0,,Дуэль!
Dialogue: 0,0:25:59.33,0:26:01.40,Default,,0,0,0,,Менің бірінші шабуылым.
Dialogue: 0,0:26:01.40,0:26:06.00,Default,,0,0,0,,Мен өріс сиқырлы Күнә әлемін іске қосамын.
Dialogue: 0,0:26:21.30,0:26:23.29,Default,,0,0,0,,Күнә әлемі.
Dialogue: 0,0:26:23.29,0:26:25.29,Default,,0,0,0,,Осы карта бар болғанша →
Dialogue: 0,0:26:25.29,0:26:29.61,Default,,0,0,0,,Жеребе кезеңінде сурет салмаудың орнына, мен Син → атты құбыжықтың суретін саламын
Dialogue: 0,0:26:29.61,0:26:33.03,Default,,0,0,0,,Қолыңызға палубаңыздан кездейсоқ қосуға болады.
Dialogue: 0,0:26:33.03,0:26:37.78,Default,,0,0,0,,Мен Cyber End Dragon-ты қосымша палубадан зиратқа жіберемін →
Dialogue: 0,0:26:37.78,0:26:40.88,Default,,0,0,0,,Пайда бол, Күнә Cyber End Dragon!
Dialogue: 0,0:26:45.98,0:26:49.35,Default,,0,0,0,,Қосымша палубадағы құбыжықтар тікелей зиратқа жіберіледі...
Dialogue: 0,0:26:49.35,0:26:53.12,Default,,0,0,0,,Күнә сериясында жұпталған құбыжықты зиратқа жіберу арқылы →
Dialogue: 0,0:26:53.12,0:26:55.32,Default,,0,0,0,,Құбыжықтарды арнайы шақыруға болады.
Dialogue: 0,0:26:55.32,0:26:59.46,Default,,0,0,0,,Кенеттен шабуыл күші 4000 құбыжық пайда болды...
Dialogue: 0,0:26:59.46,0:27:04.48,Default,,0,0,0,,Әдетте Cyber ​​End шақыру үшін фьюжн картасы қажет болады.
Dialogue: 0,0:27:04.48,0:27:07.48,Default,,0,0,0,,Сәйкес құбыжықты құрбандыққа шалу арқылы жасалған→
Dialogue: 0,0:27:07.48,0:27:09.47,Default,,0,0,0,,Күнә құбыжық.
Dialogue: 0,0:27:09.47,0:27:12.82,Default,,0,0,0,,Жарық пен қараңғылық... Бұл қараңғы энергияны білдіреді ме?
Dialogue: 0,0:27:12.82,0:27:16.29,Default,,0,0,0,,Бірінші айналымда бірінші ойыншы шабуыл жасай алмайды.
Dialogue: 0,0:27:16.29,0:27:19.11,Default,,0,0,0,,Мен бір картаны бетін төмен қаратып қойып, айналымды аяқтаймын.
Dialogue: 0,0:27:19.11,0:27:21.16,Default,,0,0,0,,Енді сіздің кезегіңіз.
Dialogue: 0,0:27:21.16,0:27:23.11,Default,,0,0,0,,Иудаи мырза. иә?
Dialogue: 0,0:27:23.11,0:27:26.17,Default,,0,0,0,,Юги-сан, бірінші мені жіберші.
Dialogue: 0,0:27:26.17,0:27:31.29,Default,,0,0,0,,Ол барлық жастағы құбыжықтарды ұрлап, оларды әлемді жою үшін құрал ретінде пайдаланды.
Dialogue: 0,0:27:31.29,0:27:35.49,Default,,0,0,0,,Менің Жұлдызды Айдаһарымды да ол пайдаланған→
Dialogue: 0,0:27:35.49,0:27:38.34,Default,,0,0,0,,Қаланы қиратып, тарихты бұзу.
Dialogue: 0,0:27:38.34,0:27:41.95,Default,,0,0,0,,Мен әр дәуірдің және қаламыздың адамдарымын→
Dialogue: 0,0:27:41.95,0:27:44.87,Default,,0,0,0,,Бұл дуэль менің қымбат достарымды қорғау үшін→
Dialogue: 0,0:27:44.87,0:27:48.37,Default,,0,0,0,,Менде бар нәрсемен күрескім келеді.
Dialogue: 0,0:27:50.77,0:27:52.83,Default,,0,0,0,,Түсіндім, Юсей.
Dialogue: 0,0:27:52.83,0:27:55.63,Default,,0,0,0,,Мен оған сол құмарлықты төгемін.
Dialogue: 0,0:27:55.63,0:27:57.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:27:57.66,0:28:00.17,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:28:00.17,0:28:02.95,Default,,0,0,0,,Сиқырлы карта Қалаған реинкарнацияны іске қосыңыз.
Dialogue: 0,0:28:02.95,0:28:05.49,Default,,0,0,0,,Қолыңыздан зиратқа → 2 құбыжықты жіберіңіз
Dialogue: 0,0:28:05.49,0:28:07.62,Default,,0,0,0,,Екінші кезек күту фазасында →
Dialogue: 0,0:28:07.62,0:28:10.69,Default,,0,0,0,,Қолыңызға палубаңыздан 1 құбыжықты қосыңыз.
Dialogue: 0,0:28:10.69,0:28:12.69,Default,,0,0,0,,Мен қалаусыз синхронды шақырамын.
Dialogue: 0,0:28:14.63,0:28:17.03,Default,,0,0,0,,Бұл карта сәтті шақырылғанда →
Dialogue: 0,0:28:17.03,0:28:20.53,Default,,0,0,0,,Зираттан 2 немесе одан төмен деңгейлі құбыжықты арнайы шақыру.
Dialogue: 0,0:28:25.27,0:28:29.00,Default,,0,0,0,,Сонымен қатар, зираттағы Болт кірпі әсерін белсендіріңіз.
Dialogue: 0,0:28:29.00,0:28:32.48,Default,,0,0,0,,Алаңда тюнер болса, осы картаны арнайы шақырыңыз.
Dialogue: 0,0:28:32.48,0:28:36.95,Default,,0,0,0,,1-деңгейдегі жүгіруші және 2-деңгейдегі болт кірпі→
Dialogue: 0,0:28:36.95,0:28:40.04,Default,,0,0,0,,Қалаусыз синхронды реттеу 3-деңгей!
Dialogue: 0,0:28:40.04,0:28:43.46,Default,,0,0,0,,Болаттың тілегі дауылдың хабаршысына жиналғанда→
Dialogue: 0,0:28:43.46,0:28:49.03,Default,,0,0,0,,Сол тілек алынбас қалқан, нұрға апарар жол болады!
Dialogue: 0,0:28:49.03,0:28:53.53,Default,,0,0,0,,Синхронды шақыру! Келіңіз, керексіз Гарднер!
Dialogue: 0,0:28:56.29,0:28:58.31,Default,,0,0,0,,Синхронды шақыру! ?
Dialogue: 0,0:28:58.31,0:29:01.33,Default,,0,0,0,,Ғажайып техниканы қолдан, Юсей!
Dialogue: 0,0:29:01.33,0:29:04.63,Default,,0,0,0,,Екі картаны бетін төмен қаратып қойып, айналымды аяқтаймын.
Dialogue: 0,0:29:04.63,0:29:07.65,Default,,0,0,0,,Өкінішке орай, сол деңгейдегі құбыжық үшін→
Dialogue: 0,0:29:07.65,0:29:10.94,Default,,0,0,0,,Бұл менің Sin Cyber End-ке жақын да емес.
Dialogue: 0,0:29:10.94,0:29:15.39,Default,,0,0,0,,Жұлдызды айдаһарды жоғалтқан сен енді менің жауым емессің.
Dialogue: 0,0:29:15.39,0:29:19.83,Default,,0,0,0,,Менің кезегім. Сізге бір қызық көрсетейін.
Dialogue: 0,0:29:19.83,0:29:23.37,Default,,0,0,0,,Менің палубамда асыл тас құдай кемпірқосақ айдаһар бар→
Dialogue: 0,0:29:23.37,0:29:26.97,Default,,0,0,0,,Зиратқа жіберіп, күнәкар айдаһарды арнайы шақырыңыз!
Dialogue: 0,0:29:37.60,0:29:40.33,Default,,0,0,0,,Кисама! Міне, Йоханның картасы...
Dialogue: 0,0:29:40.33,0:29:42.99,Default,,0,0,0,,Шабуыл күші 4000 екі құбыжық! ?
Dialogue: 0,0:29:42.99,0:29:48.96,Default,,0,0,0,,Менің палубам басқа өлшемдегі, барлық дәуірдегі ең күшті карталарды қамтиды.
Dialogue: 0,0:29:48.96,0:29:52.36,Default,,0,0,0,,Сол күштің алдында жоғалып кетіңіз.
Dialogue: 0,0:29:52.36,0:29:55.96,Default,,0,0,0,,Күнә кемпірқосақ айдаһар! Кемпірқосақ үстінде! !
Dialogue: 0,0:30:00.45,0:30:02.97,Default,,0,0,0,,Қалаусыз Гарднер эффектісі іске қосылды!
Dialogue: 0,0:30:02.97,0:30:05.02,Default,,0,0,0,,Бұл картаны қарсыластың кезегіне бір рет пайдалануға болады→
Dialogue: 0,0:30:05.02,0:30:08.02,Default,,0,0,0,,Сіз шабуылдаушы құбыжықты қорғаныс режиміне ауыстыра аласыз!
Dialogue: 0,0:30:11.15,0:30:16.00,Default,,0,0,0,,Сіз бұған жол бермедіңіз бе? Дегенмен, Sin Cyber ​​End шабуылы сақталады.
Dialogue: 0,0:30:16.00,0:30:20.00,Default,,0,0,0,,Қабыл ал! Мәңгілік эволюция жарылды! !
Dialogue: 0,0:30:23.99,0:30:27.31,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:30:27.31,0:30:29.65,Default,,0,0,0,,Юсей! Сенімен бәрі жақсы ма? ?
Dialogue: 0,0:30:29.65,0:30:32.70,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:30:32.70,0:30:34.65,Default,,0,0,0,,Осы күнә әлеміндегі дуэлде→
Dialogue: 0,0:30:34.65,0:30:38.25,Default,,0,0,0,,Өмірің нөлге жеткенде, сен өлесің.
Dialogue: 0,0:30:42.66,0:30:44.95,Default,,0,0,0,,Қалаусыз Гарднердің жаңа әсері іске қосылды!
Dialogue: 0,0:30:44.95,0:30:46.98,Default,,0,0,0,,Бұл карта жойылған кезде→
Dialogue: 0,0:30:46.98,0:30:50.37,Default,,0,0,0,,Бір қарсыластың құбыжығын қорғаныс позициясына ауыстырыңыз.
Dialogue: 0,0:30:50.37,0:30:53.29,Default,,0,0,0,,Қосымша тұзақтар іске қосылды! Ғажайып сәуле.
Dialogue: 0,0:30:53.29,0:30:59.31,Default,,0,0,0,,Осы бұрылыста зираттан шайқаста жойылған құбыжықтарды тірілтіңіз!
Dialogue: 0,0:30:59.31,0:31:02.95,Default,,0,0,0,,Кешіріңіз... Менің өмірім өте қысқарды.
Dialogue: 0,0:31:02.95,0:31:04.98,Default,,0,0,0,,Жоқ. Жарайсың!
Dialogue: 0,0:31:04.98,0:31:09.67,Default,,0,0,0,,Мен 4000 шабуыл күші бар екі тіршілік иесінің шабуылдарынан аман қалдым. Бұл ең жоғары деңгей!
Dialogue: 0,0:31:09.67,0:31:12.01,Default,,0,0,0,,Юги-сан… Жудай-сан….
Dialogue: 0,0:31:12.01,0:31:15.66,Default,,0,0,0,,Оның палубасы өте күшті болуы мүмкін.
Dialogue: 0,0:31:15.66,0:31:20.67,Default,,0,0,0,,Бірақ біз өз күштерімізді біріктірсек, біз оны міндетті түрде жеңе аламыз!
Dialogue: 0,0:31:20.67,0:31:24.32,Default,,0,0,0,,Жеңіліс болатын болашақтың алдында мәңгілік күресесің бе?
Dialogue: 0,0:31:24.32,0:31:27.32,Default,,0,0,0,,Қызықты. Бұл адамзаттың қайшылығы...
Dialogue: 0,0:31:27.32,0:31:30.31,Default,,0,0,0,,Мен бір картаны төмен қаратып қойып, кезегімді аяқтаймын.
Dialogue: 0,0:31:30.31,0:31:35.31,Default,,0,0,0,,Кеттік. Мен саған батыр палубамның күшін көрсетемін. Менің кезегім!
Dialogue: 0,0:31:35.31,0:31:38.60,Default,,0,0,0,,Юсей! Мен сенің күшіңді қарызға аламын.
Dialogue: 0,0:31:38.60,0:31:40.65,Default,,0,0,0,,Сиқырлы карталарды біріктіру!
Dialogue: 0,0:31:40.65,0:31:43.11,Default,,0,0,0,,Қалаусыз Гарднер далада →
Dialogue: 0,0:31:43.11,0:31:47.33,Default,,0,0,0,,Қолыңыздағы элементтік батыр Неосты сақтаңыз.
Dialogue: 0,0:31:47.33,0:31:52.37,Default,,0,0,0,,Юсей! Бұл сіздің және менің күштерімді біріктіретін жаңа кейіпкер.
Dialogue: 0,0:31:52.37,0:31:55.97,Default,,0,0,0,,Көріңіз! Elemental Hero Neos Knight! !
Dialogue: 0,0:32:00.61,0:32:02.83,Default,,0,0,0,,Neos Knight Neos→-пен біріктірілді
Dialogue: 0,0:32:02.83,0:32:08.48,Default,,0,0,0,,Шабуыл күшін жауынгерлік құбыжықтардың шабуыл күшінің жартысына арттырады!
Dialogue: 0,0:32:08.48,0:32:13.28,Default,,0,0,0,,Бар, Neos Knight! Neos Slash қаһары! !
Dialogue: 0,0:32:23.00,0:32:24.95,Default,,0,0,0,,Уф!
Dialogue: 0,0:32:24.95,0:32:30.02,Default,,0,0,0,,Neos Knight әсері! Neos Knight бір шайқаста екі рет шабуыл жасай алады.
Dialogue: 0,0:32:30.02,0:32:32.02,Default,,0,0,0,,Жүр! не! ?
Dialogue: 0,0:32:37.79,0:32:39.81,Default,,0,0,0,,Уф!
Dialogue: 0,0:32:39.81,0:32:42.26,Default,,0,0,0,,Иә! Күткендей.
Dialogue: 0,0:32:42.26,0:32:45.32,Default,,0,0,0,,Екі күшті құбыжықты да жою.
Dialogue: 0,0:32:45.32,0:32:48.34,Default,,0,0,0,,Хэхехе! Алаңдама, Яхудей.
Dialogue: 0,0:32:48.34,0:32:52.44,Default,,0,0,0,,Осы сәтте менің тұзағым іске қосылды. Күнә әні!
Dialogue: 0,0:32:52.44,0:32:55.49,Default,,0,0,0,,Син атты құбыжық жойылғанда→
Dialogue: 0,0:32:55.49,0:32:57.81,Default,,0,0,0,,Палубадан екі картаны сал.
Dialogue: 0,0:32:57.81,0:33:01.28,Default,,0,0,0,,Олай болса, барлық карталарыңызды төмен қаратып, айналымды аяқтаңыз.
Dialogue: 0,0:33:01.28,0:33:03.99,Default,,0,0,0,,Иә! Бұл батыл стратегия.
Dialogue: 0,0:33:03.99,0:33:07.34,Default,,0,0,0,,Жасөспірім... Сіз мүлдем сенбейтін дуалистсіз.
Dialogue: 0,0:33:07.34,0:33:10.83,Default,,0,0,0,,Хэхехе! Мен саған және Юсейге сенемін.
Dialogue: 0,0:33:10.83,0:33:13.33,Default,,0,0,0,,Демек, билікті көрсетуде еш тартынуға болмайды.
Dialogue: 0,0:33:13.33,0:33:17.62,Default,,0,0,0,,Ах! Үшеуміздің ең күшті комбинациясын көрсетейік.
Dialogue: 0,0:33:17.62,0:33:19.65,Default,,0,0,0,,《Күтілгендей.
Dialogue: 0,0:33:19.65,0:33:23.01,Default,,0,0,0,,Екеуі осы жауға қарсы жекпе-жек өткізіп жатыр.
Dialogue: 0,0:33:23.01,0:33:26.06,Default,,0,0,0,,Менің кезегім. Мен сурет салмаймын →
Dialogue: 0,0:33:26.06,0:33:30.00,Default,,0,0,0,,Қолыңызға Син атты кездейсоқ құбыжықты қосыңыз.
Dialogue: 0,0:33:30.00,0:33:34.93,Default,,0,0,0,,Хахаха! Қазір менің қолымда жеңіске арналған барлық кілттер бар.
Dialogue: 0,0:33:34.93,0:33:37.64,Default,,0,0,0,,Үміттерің осымен бітетін сияқты.
Dialogue: 0,0:33:37.64,0:33:41.62,Default,,0,0,0,,Мен жұлдызды айдаһарды қосымша палубадан зиратқа жіберемін...
Dialogue: 0,0:33:41.62,0:33:44.62,Default,,0,0,0,,Пайда бол, Күнә жұлдызды айдаһар!
Dialogue: 0,0:33:52.03,0:33:54.03,Default,,0,0,0,,Жұлдызды шаң....
Dialogue: 0,0:33:55.96,0:33:59.64,Default,,0,0,0,,Жұлдызды айдаһар осылай көрінеді!
Dialogue: 0,0:33:59.64,0:34:04.63,Default,,0,0,0,,Иә! Мен Stardust Dragon күшін толық көрсетемін.
Dialogue: 0,0:34:04.63,0:34:08.32,Default,,0,0,0,,Sin Параллель берілістерді шақырады!
Dialogue: 0,0:34:08.32,0:34:12.32,Default,,0,0,0,,Sin параллельді берілісін Sin Stardust Dragon-ға баптау!
Dialogue: 0,0:34:12.32,0:34:14.37,Default,,0,0,0,,Не! ?
Dialogue: 0,0:34:14.37,0:34:18.37,Default,,0,0,0,,Шақыруды синхрондауға болатын жалғыз сіз емессіз.
Dialogue: 0,0:34:21.60,0:34:24.33,Default,,0,0,0,,Өлшемдік жарықшақтан туған қараңғылық.
Dialogue: 0,0:34:24.33,0:34:27.85,Default,,0,0,0,,Уақыттан тыс сахнада жойылу шымылдығын тарт!
Dialogue: 0,0:34:27.85,0:34:32.65,Default,,0,0,0,,Синхронды шақыру! Күнә парадокс айдаһар!
Dialogue: 0,0:34:35.96,0:34:37.98,Default,,0,0,0,,Уау...
Dialogue: 0,0:34:37.98,0:34:40.45,Default,,0,0,0,,Sin Paradox Dragon әсері іске қосылды!
Dialogue: 0,0:34:40.45,0:34:42.65,Default,,0,0,0,,Синхронды шақыру сәтті болған кезде →
Dialogue: 0,0:34:42.65,0:34:47.01,Default,,0,0,0,,Шақыру шарттарын елемей, зираттан синхронды құбыжықты тірілтеді.
Dialogue: 0,0:34:47.01,0:34:49.01,Default,,0,0,0,,Жұлдызды айдаһарды тірілт!
Dialogue: 0,0:34:50.99,0:34:53.16,Default,,0,0,0,,Жұлдызды айдаһар….
Dialogue: 0,0:34:53.16,0:34:56.80,Default,,0,0,0,,Күнә парадокс айдаһарының қайта тірілткен құбыжықтың шабуылдық күші бар→
Dialogue: 0,0:34:56.80,0:34:59.82,Default,,0,0,0,,Құбыжықтарыңыздың шабуыл күшін төмендетіңіз.
Dialogue: 0,0:34:59.82,0:35:03.62,Default,,0,0,0,,Қарғыс атсын, Neos Knight!
Dialogue: 0,0:35:03.62,0:35:05.64,Default,,0,0,0,,Neos Knight!
Dialogue: 0,0:35:05.64,0:35:09.55,Default,,0,0,0,,Бұл жақсы емес... Осылай шабуыл жасай берсек, жасөспірімдер жеңіледі.
Dialogue: 0,0:35:09.55,0:35:12.87,Default,,0,0,0,,Қош бол, ардагер айтыскерлер.
Dialogue: 0,0:35:12.87,0:35:17.17,Default,,0,0,0,,Күнә Парадоксы Айдаһар Neos Рыцарын жояды!
Dialogue: 0,0:35:21.44,0:35:23.96,Default,,0,0,0,,Додж, жасөспірім. Мен білемін!
Dialogue: 0,0:35:23.96,0:35:26.46,Default,,0,0,0,,Тұзақ іске қосылды! Батыр тосқауыл!
Dialogue: 0,0:35:26.46,0:35:31.26,Default,,0,0,0,,Алаңда қарапайым батыр болған кезде, шабуылды тек бір рет жойыңыз!
Dialogue: 0,0:35:33.62,0:35:35.62,Default,,0,0,0,,Дәмді! Жақсы!
Dialogue: 0,0:35:35.62,0:35:39.44,Default,,0,0,0,,Күрделі еліктеу! Тұзақ іске қосылды! Sin Crow Stream!
Dialogue: 0,0:35:39.44,0:35:42.39,Default,,0,0,0,,Синхрондық құбыжық далада болғанда→
Dialogue: 0,0:35:42.39,0:35:44.49,Default,,0,0,0,,Қарсыласыңыздың бір құбыжығын жойыңыз!
Dialogue: 0,0:35:46.63,0:35:49.02,Default,,0,0,0,,Шыу!
Dialogue: 0,0:35:49.02,0:35:51.77,Default,,0,0,0,,Уф... Бірақ дәл осы сәтте менің тұзағым да іске қосылды!
Dialogue: 0,0:35:51.77,0:35:53.77,Default,,0,0,0,,Элементтік Мираж!
Dialogue: 0,0:35:53.77,0:35:56.48,Default,,0,0,0,,Алаңдағы элементтік кейіпкер әсермен жойылғанда→
Dialogue: 0,0:35:56.48,0:35:58.94,Default,,0,0,0,,Мына құбыжықты тірілт!
Dialogue: 0,0:35:58.94,0:36:01.15,Default,,0,0,0,,Neos Knight-ты жандандырыңыз!
Dialogue: 0,0:36:01.15,0:36:03.50,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:36:03.50,0:36:05.55,Default,,0,0,0,,Бұл жақсы, Иуда!
Dialogue: 0,0:36:05.55,0:36:08.15,Default,,0,0,0,,Юги-санға беріп тұрсам да, алаң толығымен бос еді→
Dialogue: 0,0:36:08.15,0:36:10.12,Default,,0,0,0,,Сөз тіркесі қолданылмаған.
Dialogue: 0,0:36:10.12,0:36:13.83,Default,,0,0,0,,Ах! Жасөспірім, мен сенің жауынгерлік рухыңды мұра етемін!
Dialogue: 0,0:36:13.83,0:36:18.98,Default,,0,0,0,,Қанша рет құбыжықты тірілтуге тырыссаң да босқа кетеді.
Dialogue: 0,0:36:18.98,0:36:23.94,Default,,0,0,0,,Жұлдызды айдаһар менің өрісімде болғанша, Sin Paradox Dragon әсерінен →
Dialogue: 0,0:36:23.94,0:36:26.32,Default,,0,0,0,,Сіздің құбыжықтарыңыздың шабуыл күші →
Dialogue: 0,0:36:26.32,0:36:29.78,Default,,0,0,0,,Жұлдызды айдаһардың шабуыл күшін төмендетеді.
Dialogue: 0,0:36:29.78,0:36:31.83,Default,,0,0,0,,Жұлдызды айдаһар.
Dialogue: 0,0:36:31.83,0:36:34.61,Default,,0,0,0,,Юсей сіздің жұлдызды айдаһарыңыз→
Dialogue: 0,0:36:34.61,0:36:37.15,Default,,0,0,0,,Мен оны міндетті түрде қайтарамын!
Dialogue: 0,0:36:37.15,0:36:39.15,Default,,0,0,0,,Юги мырза.
Dialogue: 0,0:36:39.15,0:36:42.62,Default,,0,0,0,,Екі картаны бетін төмен қаратып қойып, кезегімді аяқтаймын.
Dialogue: 0,0:36:42.62,0:36:44.97,Default,,0,0,0,,Кеттік, Парадокс!
Dialogue: 0,0:36:44.97,0:36:47.44,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:36:47.44,0:36:51.41,Default,,0,0,0,,Кел. Аты жоқ перғауынның жаны.
Dialogue: 0,0:36:51.41,0:36:53.98,Default,,0,0,0,,Юги мырза! Менің күшімді пайдаланыңыз!
Dialogue: 0,0:36:53.98,0:36:55.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:55.99,0:37:00.31,Default,,0,0,0,,Үміт реинкарнациясының әсерімен палубаңыздан қолыңызға бір құбыжық картасын қосыңыз!
Dialogue: 0,0:37:00.31,0:37:04.49,Default,,0,0,0,,Мен таңдаған адам - ​​қара сиқыршы!
Dialogue: 0,0:37:04.49,0:37:06.45,Default,,0,0,0,,Ол қара сиқыршы ма?
Dialogue: 0,0:37:06.45,0:37:09.98,Default,,0,0,0,,Мен сиқырлы картаны ежелгі ережелерді іске қосамын!
Dialogue: 0,0:37:09.98,0:37:13.80,Default,,0,0,0,,Қолыңыздан 5 немесе одан жоғары деңгейлі қалыпты құбыжықты арнайы шақырыңыз!
Dialogue: 0,0:37:13.80,0:37:18.40,Default,,0,0,0,,Көріңіз! Менің ең күшті қызметшім, Қара сиқыршы!
Dialogue: 0,0:37:23.86,0:37:26.95,Default,,0,0,0,,Бұл Югидің эйс картасы: Қара сиқыршы!
Dialogue: 0,0:37:26.95,0:37:29.54,Default,,0,0,0,,Мұнда байыпты бюстгалтер!
Dialogue: 0,0:37:29.54,0:37:32.54,Default,,0,0,0,,Дегенмен, Sin Paradox Dragon әсері қолданылады.
Dialogue: 0,0:37:35.06,0:37:38.33,Default,,0,0,0,,Оның өрісінде Жұлдыз шаңы бар болса, оның жеңу мүмкіндігі жоқ.
Dialogue: 0,0:37:38.33,0:37:40.28,Default,,0,0,0,,Юги мырза.
Dialogue: 0,0:37:40.28,0:37:43.48,Default,,0,0,0,,Мен үшін уайымдама, Жұлдызды айдаһарды жой.
Dialogue: 0,0:37:43.48,0:37:45.48,Default,,0,0,0,,Юсей….
Dialogue: 0,0:37:45.48,0:37:47.49,Default,,0,0,0,,Ол мені пайдалануды жалғастырады деп үміттенемін →
Dialogue: 0,0:37:47.49,0:37:49.49,Default,,0,0,0,,Жұлдызды шаң да мұны қаламайды.
Dialogue: 0,0:37:52.99,0:37:56.96,Default,,0,0,0,,Енді не болды? Келіңіздер.
Dialogue: 0,0:37:56.96,0:38:01.98,Default,,0,0,0,,Мен қолымнан Master-Student Bond сиқырлы картасын іске қосамын!
Dialogue: 0,0:38:01.98,0:38:04.14,Default,,0,0,0,,Далада қара сиқыршы болғанда→
Dialogue: 0,0:38:04.14,0:38:08.14,Default,,0,0,0,,Шәкіртіңізді, Қара сиқыршы қызды қорғаныс позициясына арнайы шақырыңыз!
Dialogue: 0,0:38:10.31,0:38:12.44,Default,,0,0,0,,Ұстаз, сіз шынымен күшті сияқтысыз→
Dialogue: 0,0:38:12.44,0:38:14.98,Default,,0,0,0,,Ол жау. (Қара сиқыршы) Қорықпа.
Dialogue: 0,0:38:14.98,0:38:17.48,Default,,0,0,0,,Егер біз және шеберлер күш біріктірсек →
Dialogue: 0,0:38:17.48,0:38:19.62,Default,,0,0,0,,Сіз міндетті түрде жеңесіз. иә!
Dialogue: 0,0:38:19.62,0:38:22.32,Default,,0,0,0,,Оның үстіне мен ғажайып сиқырлы қақпаны іске қосамын!
Dialogue: 0,0:38:22.32,0:38:26.48,Default,,0,0,0,,Сіздің өрісіңізде екі немесе одан да көп шеберлер болған кезде→
Dialogue: 0,0:38:26.48,0:38:31.46,Default,,0,0,0,,Қарсыласыңыздың құбыжығын қорғаныс жағдайына ауыстырыңыз және оны бақылауға алыңыз!
Dialogue: 0,0:38:31.46,0:38:33.98,Default,,0,0,0,,Болма... уайымдама!
Dialogue: 0,0:38:33.98,0:38:36.29,Default,,0,0,0,,Trap картасы Sin Force іске қосылды!
Dialogue: 0,0:38:36.29,0:38:39.99,Default,,0,0,0,,Осы картамен жабдықталған құбыжық қарсыласыңыздың сиқырлы әсерлеріне әсер етпейді.
Dialogue: 0,0:38:39.99,0:38:43.88,Default,,0,0,0,,Енді менің Парадокс Айдаһарымды тартып ала алмайсың!
Dialogue: 0,0:38:43.88,0:38:45.98,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,0:38:51.18,0:38:53.18,Default,,0,0,0,,Не! ? Ах!
Dialogue: 0,0:38:56.11,0:38:58.16,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:38:58.16,0:39:01.33,Default,,0,0,0,,Юсей Енді сіздің картаңыз қайтарылды.
Dialogue: 0,0:39:01.33,0:39:03.28,Default,,0,0,0,,Юги мырза!
Dialogue: 0,0:39:03.28,0:39:06.48,Default,,0,0,0,,Сіз Жұлдызды шаңды басынан қайтаруды жоспарлағансыз!
Dialogue: 0,0:39:06.48,0:39:10.65,Default,,0,0,0,,Иә. Sin Paradox Dragon әсері енді жоғалады →
Dialogue: 0,0:39:10.65,0:39:13.95,Default,,0,0,0,,Біздің құбыжықтардың шабуыл күші қалыпты жағдайға оралады.
Dialogue: 0,0:39:19.16,0:39:21.30,Default,,0,0,0,,Бұлай етпе, Юги.
Dialogue: 0,0:39:21.30,0:39:23.65,Default,,0,0,0,,Бірақ шабуыл күші қанша қайтарылса да→
Dialogue: 0,0:39:23.65,0:39:27.04,Default,,0,0,0,,Парадокс Айдаһардың шабуыл күші 4000.
Dialogue: 0,0:39:27.04,0:39:30.61,Default,,0,0,0,,Сіздің құбыжықтарыңыздың шабуыл күші одан алыс.
Dialogue: 0,0:39:30.61,0:39:32.99,Default,,0,0,0,,Мен бұл туралы білмеймін. иә! ?
Dialogue: 0,0:39:32.99,0:39:36.36,Default,,0,0,0,,Black Twin Burst сиқырлы картасы іске қосылды!
Dialogue: 0,0:39:36.36,0:39:39.30,Default,,0,0,0,,Бұл бұрылыс, Қара сиқыршының шабуыл күші →
Dialogue: 0,0:39:39.30,0:39:41.32,Default,,0,0,0,,Қара сиқыршы қыздың шабуыл күші →
Dialogue: 0,0:39:41.32,0:39:43.30,Default,,0,0,0,,Жүктеп салу! не! ?
Dialogue: 0,0:39:43.30,0:39:46.11,Default,,0,0,0,,Екі адамның жалпы шабуыл күші 4500.
Dialogue: 0,0:39:46.11,0:39:50.14,Default,,0,0,0,,Бұл Sin Paradox Dragon шабуыл күшінен асып түседі.
Dialogue: 0,0:39:50.14,0:39:53.36,Default,,0,0,0,,Бар, қара сиқыршы, қара сиқыршы қыз!
Dialogue: 0,0:39:53.36,0:39:56.16,Default,,0,0,0,,Кеттік! Иә, ұстаз!
Dialogue: 0,0:39:58.78,0:40:00.85,Default,,0,0,0,,Қара…. егіз….
Dialogue: 0,0:40:00.85,0:40:02.95,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:40:06.61,0:40:08.64,Default,,0,0,0,,Уф!
Dialogue: 0,0:40:08.64,0:40:10.68,Default,,0,0,0,,Иә! Керемет!
Dialogue: 0,0:40:10.68,0:40:12.68,Default,,0,0,0,,Жеңіс көз алдында.
Dialogue: 0,0:40:14.65,0:40:17.99,Default,,0,0,0,,Уф... нағыз шайқас басталғалы тұр.
Dialogue: 0,0:40:17.99,0:40:21.61,Default,,0,0,0,,Бас тарту. Сіздің өрісіңізде енді құбыжықтар жоқ.
Dialogue: 0,0:40:21.61,0:40:24.31,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:40:24.31,0:40:27.43,Default,,0,0,0,,Бір қарағанда бұл шабуыл дұрыс болып көрінді.
Dialogue: 0,0:40:27.43,0:40:29.98,Default,,0,0,0,,Бірақ бұл үлкен қателік болар еді.
Dialogue: 0,0:40:29.98,0:40:32.00,Default,,0,0,0,,Не?
Dialogue: 0,0:40:32.00,0:40:34.60,Default,,0,0,0,,Тұзақты белсендіру Sin парадигмасының ауысуы!
Dialogue: 0,0:40:34.60,0:40:37.82,Default,,0,0,0,,Күнә парадокс айдаһары жойылғанда →
Dialogue: 0,0:40:37.82,0:40:41.29,Default,,0,0,0,,Өзімді құрбан етіп, өмірімді екіге қию арқылы→
Dialogue: 0,0:40:41.29,0:40:44.51,Default,,0,0,0,,Күнәнің ақиқаты айдаһарын арнайы шақыру!
Dialogue: 0,0:40:44.51,0:40:47.31,Default,,0,0,0,,Арх! (3 адам) Ах!
Dialogue: 0,0:40:54.02,0:40:57.02,Default,,0,0,0,,Арх! !
Dialogue: 0,0:41:02.98,0:41:07.35,Default,,0,0,0,,Ол өзін құбыжыққа айналдырды. (Юсей) Шабуыл күші 5000!
Dialogue: 0,0:41:07.35,0:41:11.32,Default,,0,0,0,,Сен мені өз қолыңмен жоясың.
Dialogue: 0,0:41:11.32,0:41:15.71,Default,,0,0,0,,Қарғыс атсын! Мен екі картаны төмен қаратып қойып, кезегімді аяқтаймын.
Dialogue: 0,0:41:15.71,0:41:17.65,Default,,0,0,0,,Барлығы….
Dialogue: 0,0:41:17.65,0:41:20.95,Default,,0,0,0,,Жақсы емес! Жақында Pegasus келеді.
Dialogue: 0,0:41:23.07,0:41:25.67,Default,,0,0,0,,Неге екені белгісіз, менде алаңдаушылық бар.
Dialogue: 0,0:41:31.21,0:41:33.50,Default,,0,0,0,,Юсей….
Dialogue: 0,0:41:33.50,0:41:37.00,Default,,0,0,0,,Ол жақсы болады. аа.
Dialogue: 0,0:41:38.98,0:41:41.15,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:41:41.15,0:41:44.01,Default,,0,0,0,,Күнә селекторын іске қосамын.
Dialogue: 0,0:41:44.01,0:41:47.66,Default,,0,0,0,,Sin Parallel Gear Sin Cyber End алынып тасталды →
Dialogue: 0,0:41:47.66,0:41:50.78,Default,,0,0,0,,Палубаңыздан қолыңызға екі карта қосыңыз.
Dialogue: 0,0:41:50.78,0:41:55.15,Default,,0,0,0,,Сонымен қатар палубадан зиратқа екі құбыжықты жіберіңіз...
Dialogue: 0,0:41:55.15,0:41:59.17,Default,,0,0,0,,Пайда бол, күнә, көк көзді ақ айдаһар!
Dialogue: 0,0:41:59.17,0:42:02.27,Default,,0,0,0,,Күнә Қызыл көздер Қара Айдаһар!
Dialogue: 0,0:42:04.33,0:42:06.68,Default,,0,0,0,,Көк көз бен қызыл көзге дейін.
Dialogue: 0,0:42:06.68,0:42:10.13,Default,,0,0,0,,Бар, қара жалын оқ!
Dialogue: 0,0:42:10.13,0:42:12.17,Default,,0,0,0,,Ах! Хахахаха!
Dialogue: 0,0:42:12.17,0:42:15.60,Default,,0,0,0,,Күнә құбыжығы қарсыласыңыздың құбыжығын жойғанда, Күнә Шындық Айдаһары→
Dialogue: 0,0:42:15.60,0:42:18.37,Default,,0,0,0,,Қарсыласыңыздың барлық құбыжықтарын жойыңыз.
Dialogue: 0,0:42:18.37,0:42:21.87,Default,,0,0,0,,Не! ? Жылдам шабуылдың сиқырлы ашылуы!
Dialogue: 0,0:42:26.83,0:42:28.88,Default,,0,0,0,,Қазір Юсей!
Dialogue: 0,0:42:28.88,0:42:32.34,Default,,0,0,0,,Қалаусыз Гарднер эффектісі іске қосылды! Қарсылас шабуыл жасағанда →
Dialogue: 0,0:42:32.34,0:42:35.94,Default,,0,0,0,,Қарсыласыңыздың құбыжығын қорғаныс жағдайына бір рет өзгертіңіз!
Dialogue: 0,0:42:40.00,0:42:41.98,Default,,0,0,0,,Бұл дәмді, Жудай Юсей!
Dialogue: 0,0:42:41.98,0:42:47.10,Default,,0,0,0,,Бірақ күнәкар көк көзді ақ айдаһардың шабуылы қалады!
Dialogue: 0,0:42:47.10,0:42:50.31,Default,,0,0,0,,Уау! ! (3 адам) Уау!
Dialogue: 0,0:42:50.31,0:42:52.44,Default,,0,0,0,,Қара сиқыршы! Ха!
Dialogue: 0,0:42:52.44,0:42:56.19,Default,,0,0,0,,Бұл «Өзім, Күнә Шындық Айдаһар» әсерін белсендіреді.
Dialogue: 0,0:42:56.19,0:43:00.49,Default,,0,0,0,,Барлық құбыжықтарыңызды жойыңыз.
Dialogue: 0,0:43:03.97,0:43:05.99,Default,,0,0,0,,Жұлдыз шаңының әсері іске қосылды!
Dialogue: 0,0:43:05.99,0:43:09.16,Default,,0,0,0,,Құрбандар үйі! Карталарды бұзатын әсер →
Dialogue: 0,0:43:09.16,0:43:14.38,Default,,0,0,0,,Оны жоққа шығару және жою үшін Stardust Dragon-ды босатыңыз!
Dialogue: 0,0:43:14.38,0:43:17.38,Default,,0,0,0,,Не! ? Сіз жоғалып кететін адамсыз!
Dialogue: 0,0:43:19.99,0:43:21.95,Default,,0,0,0,,Ооо~ Ақымақ болма!
Dialogue: 0,0:43:21.95,0:43:24.39,Default,,0,0,0,,Sin Truth Dragon әсері іске қосылды!
Dialogue: 0,0:43:24.39,0:43:29.61,Default,,0,0,0,,Син кемпірқосақ айдаһарын зираттан қуып, оның жойылуын жоққа шығарыңыз.
Dialogue: 0,0:43:29.61,0:43:33.18,Default,,0,0,0,,Мен әлі күнге дейін Күнә Ақиқат Айдаһарының шабуылын сезінемін→
Dialogue: 0,0:43:33.18,0:43:35.18,Default,,0,0,0,,қалады.
Dialogue: 0,0:43:37.77,0:43:43.23,Default,,0,0,0,,Уау! ! Сіздің құбыжықтарыңыз енді жойылды.
Dialogue: 0,0:43:43.23,0:43:46.65,Default,,0,0,0,,Осы әсерден жойылған әрбір құбыжық үшін→
Dialogue: 0,0:43:46.65,0:43:49.38,Default,,0,0,0,,800 шығын ұпайын алыңыз!
Dialogue: 0,0:43:49.38,0:43:52.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:43:55.32,0:43:58.34,Default,,0,0,0,,Жорғалаған жақсы, үміт үзген жақсы.
Dialogue: 0,0:43:58.34,0:44:03.15,Default,,0,0,0,,Уф... Осы уақытқа дейін барлық құбыжықтар жойылды.
Dialogue: 0,0:44:03.15,0:44:05.78,Default,,0,0,0,,Менің шабуылым әлі біткен жоқ.
Dialogue: 0,0:44:05.78,0:44:08.82,Default,,0,0,0,,Син Кросс жылдам шабуылының сиқырын іске қосыңыз!
Dialogue: 0,0:44:08.82,0:44:10.82,Default,,0,0,0,,Осы айналымның соңына дейін →
Dialogue: 0,0:44:10.82,0:44:13.54,Default,,0,0,0,,Зираттан бір күнәкар құбыжықты тірілт.
Dialogue: 0,0:44:13.54,0:44:17.34,Default,,0,0,0,,Күнә жұлдызды айдаһарды тірілт!
Dialogue: 0,0:44:19.48,0:44:23.12,Default,,0,0,0,,Не! ? 500 өмірлік ұпай қалды.
Dialogue: 0,0:44:23.12,0:44:26.82,Default,,0,0,0,,Егер маған шабуыл жасалса, мен өзімді қорғай алмаймын.
Dialogue: 0,0:44:26.82,0:44:31.97,Default,,0,0,0,,Бұл менің жеңісім. Жоғалып кет, Юги Жудай Юсей!
Dialogue: 0,0:44:31.97,0:44:34.97,Default,,0,0,0,,Бар, күнә жұлдызды айдаһар!
Dialogue: 0,0:44:37.48,0:44:41.77,Default,,0,0,0,,Юсей: Сіз адамдардың үмітсіздіктің болашағын өзгертуге күші бар екенін айттыңыз.
Dialogue: 0,0:44:41.77,0:44:46.37,Default,,0,0,0,,Сіз бұл үмітсіздіктен нені өзгерте аласыз? ?
Dialogue: 0,0:44:46.37,0:44:48.67,Default,,0,0,0,,Қарғыс атсын... Жақсы емес пе?
Dialogue: 0,0:44:51.28,0:44:55.91,Default,,0,0,0,,Біздің болашағымыз... күйреу.
Dialogue: 0,0:44:55.91,0:44:57.83,Default,,0,0,0,,Бұл не, Юсей?
Dialogue: 0,0:44:57.83,0:44:59.77,Default,,0,0,0,,Сіз бас тартуға дайынсыз ба?
Dialogue: 0,0:44:59.77,0:45:03.99,Default,,0,0,0,,Сіз осыншама уақыттан асып кеттіңіз бе?
Dialogue: 0,0:45:03.99,0:45:07.11,Default,,0,0,0,,Себебі біз Duel Monsters-ге сенеміз→
Dialogue: 0,0:45:07.11,0:45:09.14,Default,,0,0,0,,Біз уақыт өте келе кездестік.
Dialogue: 0,0:45:09.14,0:45:12.00,Default,,0,0,0,,Олай болса, онда қандай да бір мағына болуы керек.
Dialogue: 0,0:45:12.00,0:45:14.28,Default,,0,0,0,,Біздің болашағымыз дұрыс емес пе?→
Dialogue: 0,0:45:14.28,0:45:18.00,Default,,0,0,0,,Әлде жоқ па? Мұны сіз шешесіз.
Dialogue: 0,0:45:18.00,0:45:20.34,Default,,0,0,0,,Жылдам шабуыл сиқыры Гумбаны шақыратын ысқырық!
Dialogue: 0,0:45:20.34,0:45:24.31,Default,,0,0,0,,Қолыңызға палубаңыздан Goomba немесе Honey Goomba қосуға болады.
Dialogue: 0,0:45:24.31,0:45:28.31,Default,,0,0,0,,Юги мырза! Кел, Гумба!
Dialogue: 0,0:45:28.31,0:45:30.78,Default,,0,0,0,,Гумба эффектісін іске қосамын.
Dialogue: 0,0:45:30.78,0:45:36.15,Default,,0,0,0,,Бұл картаны зиратқа жіберіп, ұрыс шығынын бір рет нөлге дейін азайтыңыз.
Dialogue: 0,0:45:36.15,0:45:39.51,Default,,0,0,0,,Crickly!
Dialogue: 0,0:45:39.51,0:45:43.86,Default,,0,0,0,,Кри!
Dialogue: 0,0:45:43.86,0:45:45.96,Default,,0,0,0,,Не! ?
Dialogue: 0,0:45:48.60,0:45:50.60,Default,,0,0,0,,Мен жасадым! Мен одан қаштым!
Dialogue: 0,0:45:50.60,0:45:54.16,Default,,0,0,0,,Ақымақ! Мен осы шабуылдардың барлығынан құтыла алғаныма сене алар емеспін! ?
Dialogue: 0,0:45:54.16,0:45:57.61,Default,,0,0,0,,Осы айналымның соңында Sin Cross әсері жоғалады.
Dialogue: 0,0:45:57.61,0:46:02.20,Default,,0,0,0,,Мен сенің Күнә жұлдызды айдаһарыңды жоғалтып аламын.
Dialogue: 0,0:46:02.20,0:46:07.00,Default,,0,0,0,,Ал құбыжық әсері нағыз Жұлдызды Айдаһарды қайтарады.
Dialogue: 0,0:46:17.03,0:46:19.03,Default,,0,0,0,,Жұлдызды шаң....
Dialogue: 0,0:46:21.05,0:46:23.45,Default,,0,0,0,,Юсей.
Dialogue: 0,0:46:23.45,0:46:26.52,Default,,0,0,0,,Сенің кезінде де мен саған сенемін →
Dialogue: 0,0:46:26.52,0:46:29.62,Default,,0,0,0,,Сіздің қайтуыңызды күтіп жүрген достарыңыз жоқ па?
Dialogue: 0,0:46:50.46,0:46:52.65,Default,,0,0,0,,((Юсей! Юсей!
Dialogue: 0,0:46:52.65,0:46:54.63,Default,,0,0,0,,Юсей! Юсей!
Dialogue: 0,0:46:54.63,0:46:56.82,Default,,0,0,0,,Юсей! ))
Dialogue: 0,0:46:56.82,0:46:58.84,Default,,0,0,0,,Жудай-сан Юги-сан →
Dialogue: 0,0:46:58.84,0:47:03.02,Default,,0,0,0,,Мен достарым үшін ешқашан берілмеуім керек.
Dialogue: 0,0:47:03.02,0:47:06.02,Default,,0,0,0,,Иә. Бар, Юсей!
Dialogue: 0,0:47:09.98,0:47:12.63,Default,,0,0,0,,Тұзақ іске қосылды! Жұлдызшаң Мираж.
Dialogue: 0,0:47:12.63,0:47:16.86,Default,,0,0,0,,Алаңда жұлдызды айдаһар болған кезде, ол осы бұрылыста жойылды →
Dialogue: 0,0:47:16.86,0:47:19.66,Default,,0,0,0,,Біздің барлық құбыжықтарымызды тірілтіңіз.
Dialogue: 0,0:47:25.95,0:47:28.48,Default,,0,0,0,,Не! ? Барлық құбыжықтар...
Dialogue: 0,0:47:28.48,0:47:30.44,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:47:30.44,0:47:33.82,Default,,0,0,0,,Мен өз болашағымнан бас тартпаймын!
Dialogue: 0,0:47:33.82,0:47:35.81,Default,,0,0,0,,Аа, дұрыс, Юсей.
Dialogue: 0,0:47:35.81,0:47:38.73,Default,,0,0,0,,Тұзақ белсендірілген Neos Spiral Force!
Dialogue: 0,0:47:38.73,0:47:42.83,Default,,0,0,0,,Алаңдағы бір құбыжықтың шабуыл күшін екі есе арттырыңыз.
Dialogue: 0,0:47:42.83,0:47:45.37,Default,,0,0,0,,Тұзақ қосылған қара спиральдық күш!
Dialogue: 0,0:47:45.37,0:47:47.79,Default,,0,0,0,,Иә, Юсей. Біз әрқашан →
Dialogue: 0,0:47:47.79,0:47:49.80,Default,,0,0,0,,Алға ұмтылудан басқа амалымыз жоқ!
Dialogue: 0,0:47:49.80,0:47:52.77,Default,,0,0,0,,Бұл карта өрістегі бір құбыжықтың шабуыл күшін арттырады →
Dialogue: 0,0:47:52.77,0:47:55.33,Default,,0,0,0,,Қайтадан қос.
Dialogue: 0,0:47:55.33,0:47:57.46,Default,,0,0,0,,Шабуыл күші - 10000! ?
Dialogue: 0,0:47:57.46,0:47:59.46,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:48:03.52,0:48:05.62,Default,,0,0,0,,Қара сиқыршы!
Dialogue: 0,0:48:08.19,0:48:10.19,Default,,0,0,0,,Elemental Hero Neos!
Dialogue: 0,0:48:12.48,0:48:16.05,Default,,0,0,0,,Бұл біздің болашаққа деген күшіміз!
Dialogue: 0,0:48:16.05,0:48:18.65,Default,,0,0,0,,Алға, Жұлдызды айдаһар!
Dialogue: 0,0:48:31.65,0:48:34.80,Default,,0,0,0,,Спиральды дыбысты түсіру!
Dialogue: 0,0:48:34.80,0:48:36.80,Default,,0,0,0,,Не! ?
Dialogue: 0,0:48:40.52,0:48:45.12,Default,,0,0,0,,Менің экспериментім қате болды!
Dialogue: 0,0:49:04.98,0:49:07.77,Default,,0,0,0,,Бұл бүгінге арналған арнайы карта.
Dialogue: 0,0:49:07.77,0:49:10.50,Default,,0,0,0,,Үйге апарыңыз. рақмет сізге.
Dialogue: 0,0:49:10.50,0:49:13.37,Default,,0,0,0,,Турнирде жеңілдім, бірақ тағы да жарысамын!
Dialogue: 0,0:49:13.37,0:49:15.37,Default,,0,0,0,,Тағы бір. Сіз қанша суретке түстіңіз?
Dialogue: 0,0:49:18.78,0:49:20.81,Default,,0,0,0,,Сіз қазір кетесіз бе?
Dialogue: 0,0:49:20.81,0:49:22.95,Default,,0,0,0,,Иә, өз уақытымда →
Dialogue: 0,0:49:22.95,0:49:24.98,Default,,0,0,0,,Мен орындауым керек нәрсе →
Dialogue: 0,0:49:24.98,0:49:27.00,Default,,0,0,0,,Тағы да бар.
Dialogue: 0,0:49:27.00,0:49:29.27,Default,,0,0,0,,Бірақ мен тағы кездесетін сияқтымын.
Dialogue: 0,0:49:29.27,0:49:32.62,Default,,0,0,0,,Ондай жағдайда менімен жекпе-жек өткізіңіз.
Dialogue: 0,0:49:32.62,0:49:34.66,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:49:34.66,0:49:36.70,Default,,0,0,0,,Бір күні тағы кездесетінімізге сенімдімін.
Dialogue: 0,0:49:36.70,0:49:38.85,Default,,0,0,0,,Сіз дуэль монстрларына сенсеңіз →
Dialogue: 0,0:49:38.85,0:49:41.45,Default,,0,0,0,,Біздің байланысымыз әрқашан байланысты болады.
Dialogue: 0,0:50:06.86,0:50:12.36,Default,,0,0,0,,《Мен Парадокс айтқан үмітсіздіктің болашағы шындық па, жалған ба, білмеймін.》
Dialogue: 0,0:50:14.63,0:50:20.99,Default,,0,0,0,,《Бірақ болашақты біз шешеміз.
Dialogue: 0,0:50:20.99,0:50:25.51,Default,,0,0,0,,Юги-сан Жудай-сан мен сені қорғаймын.
Dialogue: 0,0:50:25.51,0:50:29.51,Default,,0,0,0,,Біздің болашағымыз осы таптырмас доспен.
Dialogue: 0,0:50:31.65,0:50:36.77,Default,,0,0,0,,＜ Қалай болды? Дулистердің бұрынғы патшаларының қызметі.
Dialogue: 0,0:50:36.77,0:50:39.82,Default,,0,0,0,,Бұл ессіз болды!
Dialogue: 0,0:50:39.82,0:50:44.81,Default,,0,0,0,,Қандай жағдай болмасын, алға қарап, жауға Жудай Юукимен қарсы тұрыңыз→
Dialogue: 0,0:50:44.81,0:50:49.43,Default,,0,0,0,,Elemental Hero Neos.
Dialogue: 0,0:50:49.43,0:50:53.66,Default,,0,0,0,,Достарына қамқор, жүрегі жылы Юсей Фудомен→
Dialogue: 0,0:50:53.66,0:50:57.06,Default,,0,0,0,,Жұлдызды айдаһар.
Dialogue: 0,0:50:57.06,0:51:00.45,Default,,0,0,0,,Ең бастысы, Duel Monsters тарихы→
Dialogue: 0,0:51:00.45,0:51:03.52,Default,,0,0,0,,Ең күшті дуэлист Юги Мутомен→
Dialogue: 0,0:51:03.52,0:51:09.02,Default,,0,0,0,,Қара сиқыршы Қара сиқыршы қыздың ойыны өте керемет болды>
Dialogue: 0,0:51:13.04,0:51:16.48,Default,,0,0,0,,< Салқын туралы айтатын болсақ, ол 6 сәуірде басталады →
Dialogue: 0,0:51:16.48,0:51:21.60,Default,,0,0,0,,Тіпті «Ю-Джи-О! Арк-5» фильмінің басты кейіпкері Юя Сакаки де жеңілмейді.
Dialogue: 0,0:51:21.60,0:51:27.16,Default,,0,0,0,,Солардың бірі - Юя қолданған жаңа шақыру әдісі.
Dialogue: 0,0:51:27.16,0:51:30.68,Default,,0,0,0,,Оның аты маятник шақыруы.
Dialogue: 0,0:51:30.68,0:51:35.71,Default,,0,0,0,,Сіз бірден көптеген құбыжықтарды шақыра алатын сияқтысыз...
Dialogue: 0,0:51:35.71,0:51:38.68,Default,,0,0,0,,Бұл жалғасы 6 сәуірден басталады →
Dialogue: 0,0:51:38.68,0:51:41.68,Default,,0,0,0,,"Ю-Джи-О! Бес доғаны" тексеріңіз>
Dialogue: 0,0:52:11.37,0:52:16.37,Default,,0,0,0,,<Кеншо Оно басты кейіпкер Юя Сакаки> ретінде көрінеді
Dialogue: 0,0:53:20.94,0:53:23.66,Default,,0,0,0,,Ханымдар мен мырзалар!
Dialogue: 0,0:53:23.66,0:53:28.94,Default,,0,0,0,,Менің атым Юя Сакаки. Біз сіздерге жаңа дуэль шоуын көрсетпекпіз.
Dialogue: 0,0:53:28.94,0:53:31.66,Default,,0,0,0,,Бағдарламаны көріп отырғандардың барлығына сәлем.
Dialogue: 0,0:53:31.66,0:53:35.98,Default,,0,0,0,,«Ю-Джи-О! Арк-5» Мен басты кейіпкер Юя Сакакидің дауысына жауапты боламын→
Dialogue: 0,0:53:35.98,0:53:37.94,Default,,0,0,0,,Бұл Кеншо Оно!
Dialogue: 0,0:53:37.94,0:53:43.71,Default,,0,0,0,,<6 сәуірде «Ю-Джи-О! Бес доға» ақыры басталады.
Dialogue: 0,0:53:43.71,0:53:46.71,Default,,0,0,0,,Бұл бағдарламада→
Dialogue: 0,0:53:49.85,0:53:54.85,Default,,0,0,0,,<Мен «Ю-Джи-О! Бес доға» туралы естідім>
Dialogue: 0,0:54:03.29,0:54:06.75,Default,,0,0,0,,Бұл жаңа бағдарлама «Ю-Джи-О! Арк-5» →
Dialogue: 0,0:54:06.75,0:54:12.85,Default,,0,0,0,,Осы уақытқа дейін мен бұл туралы көп айтқан емеспін...дәлірек айтсақ, бұл туралы көп айтқан жоқпын...
Dialogue: 0,0:54:23.16,0:54:27.79,Default,,0,0,0,,<мырза Оно, толығырақ айтып беріңізші>
Dialogue: 0,0:54:27.79,0:54:33.81,Default,,0,0,0,,Шындығында, бұл уақыттағы дуэль әдісі экшн дуэлі деп аталады.→
Dialogue: 0,0:54:33.81,0:54:37.95,Default,,0,0,0,,Іс жүзінде құбыжықпен өрісті айналып өту→
Dialogue: 0,0:54:37.95,0:54:40.37,Default,,0,0,0,,Карточкаларды жинау және т.б.→
Dialogue: 0,0:54:40.37,0:54:42.82,Default,,0,0,0,,Мұндай нәрсе қазір мүмкін→
Dialogue: 0,0:54:42.82,0:54:46.20,Default,,0,0,0,,Шынында да, құбыжықтар шынайырақ бола бастады →
Dialogue: 0,0:54:46.20,0:54:49.99,Default,,0,0,0,,Жауынгерлік әрекеттерді орындау кезінде жекпе-жек өткізетін бөлік→
Dialogue: 0,0:54:49.99,0:54:52.11,Default,,0,0,0,,Менің ойымша, бұл уақыт ең тартымды →
Dialogue: 0,0:54:52.11,0:54:55.65,Default,,0,0,0,,Өте көңілді дуэль болады деп ойлаймын→
Dialogue: 0,0:54:55.65,0:54:59.33,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:54:59.33,0:55:02.63,Default,,0,0,0,,<Әрекет дуэлі! Мен оны асыға күтемін>
Dialogue: 0,0:55:08.49,0:55:12.48,Default,,0,0,0,,Юяға келсек, ол адамдарды күлдіре алады →
Dialogue: 0,0:55:12.48,0:55:15.97,Default,,0,0,0,,Мен көңіл көтеруді жақсы көретін орта мектептің екінші курс студентімін.
Dialogue: 0,0:55:15.97,0:55:21.47,Default,,0,0,0,,Бұл Юяның аты аңызға айналған экшн дуэлисті болу арманы→
Dialogue: 0,0:55:21.47,0:55:25.46,Default,,0,0,0,,Менің Юшо Сакаки деген әкем болды→
Dialogue: 0,0:55:25.46,0:55:28.50,Default,,0,0,0,,Әкеңе сүйсінудің қуанышы→
Dialogue: 0,0:55:28.50,0:55:34.67,Default,,0,0,0,,Юя Сакакидің арманы ойын-сауық дуалисті болу →
Dialogue: 0,0:55:34.67,0:55:38.67,Default,,0,0,0,,Мен дуаист болу үшін күнде аянбай еңбек етемін.
Dialogue: 0,0:55:44.65,0:55:48.60,Default,,0,0,0,,Бұл жұмыс шынымен де ойын-сауық...
Dialogue: 0,0:55:48.60,0:55:50.94,Default,,0,0,0,,Циркке ұқсайды.
Dialogue: 0,0:55:50.94,0:55:54.32,Default,,0,0,0,,Көретіндердің бәрі ләззат алатын дуэль →
Dialogue: 0,0:55:54.32,0:55:58.13,Default,,0,0,0,,Мен жұмыс барысында осы мақсатқа ұмтылдым.
Dialogue: 0,0:55:58.13,0:56:03.08,Default,,0,0,0,,Сонымен, біз, қызметкерлер, бәріміз көңілді →
Dialogue: 0,0:56:03.08,0:56:07.38,Default,,0,0,0,,Шығармалар жасау үшін күн сайын тер төгіп жүрмін...
Dialogue: 0,0:56:18.95,0:56:23.30,Default,,0,0,0,,Қызық енді басталады! Мынаны көр!
Dialogue: 0,0:56:23.30,0:56:25.80,Default,,0,0,0,,<Рахмет, Оно-сан>
Dialogue: 0,0:56:27.30,0:56:33.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory