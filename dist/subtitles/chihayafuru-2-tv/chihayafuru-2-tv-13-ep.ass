Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.04,0:00:09.67,Default,,0,0,0,,«Бұл жел,» Чихая-чан.
Dialogue: 0,0:00:10.84,0:00:11.67,Default,,0,0,0,,Ах
Dialogue: 0,0:00:16.55,0:00:19.31,Default,,0,0,0,,А... а...
Dialogue: 0,0:00:24.69,0:00:30.65,Default,,0,0,0,,Чихая-чан 800 жыл бұрын «жел соғады» деп ұрандаған жүрек
Dialogue: 0,0:00:30.73,0:00:33.03,Default,,0,0,0,,Бұл өте керемет болуы керек.
Dialogue: 0,0:00:38.99,0:00:41.49,Default,,0,0,0,,Мисогизонацу
Dialogue: 0,0:00:41.58,0:00:43.71,Default,,0,0,0,,Ширушинари~керу~
Dialogue: 0,0:00:43.71,0:00:45.17,Default,,0,0,0,,Ширушинари~керу~
Dialogue: 0,0:00:43.71,0:00:45.17,Default,,0,0,0,,Жел...
Dialogue: 0,0:00:45.17,0:00:47.79,Default,,0,0,0,,Ширушинари~керу~
Dialogue: 0,0:00:47.88,0:00:48.79,Default,,0,0,0,,естіледі
Dialogue: 0,0:00:49.96,0:00:52.13,Default,,0,0,0,,Суминоэно (Эму) Ах
Dialogue: 0,0:00:52.21,0:00:53.59,Default,,0,0,0,,Сықырлаған толқындар…
Dialogue: 0,0:00:54.26,0:00:55.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:56.22,0:00:59.10,Default,,0,0,0,,Кана-чан, есімде.
Dialogue: 0,0:01:00.14,0:01:02.72,Default,,0,0,0,,Армандар туралы айтатын болсақ, бұл «Суминое»!
Dialogue: 0,0:01:14.44,0:01:15.45,Default,,0,0,0,,Эму-чан
Dialogue: 0,0:01:18.57,0:01:21.91,Default,,0,0,0,,Енді... жарысатын кез келді!
Dialogue: 0,0:01:21.99,0:01:26.54,Default,,0,0,0,,♪~
Dialogue: 0,0:02:26.89,0:02:31.90,Default,,0,0,0,,~♪
Dialogue: 0,0:02:44.95,0:02:49.87,Default,,0,0,0,,Мен оны ертерек ала алмадым, бірақ жау шебінің төменгі оң жағындағы бір әріптік сызықты алдым.
Dialogue: 0,0:02:55.42,0:03:00.13,Default,,0,0,0,,Жау жағындағы бір әріптік ереже әркім үшін ерекше.
Dialogue: 0,0:03:00.22,0:03:02.47,Default,,0,0,0,,...
Dialogue: 0,0:03:02.55,0:03:05.93,Default,,0,0,0,,Бұл өте қызық Аясеге ағын келеді
Dialogue: 0,0:03:06.01,0:03:06.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:07.56,0:03:10.18,Default,,0,0,0,,Ағымдағы жылдамдық күткендей.
Dialogue: 0,0:03:10.27,0:03:14.48,Default,,0,0,0,,Беллатрикстің құлақтарынан саусақтарына тікелей өтетін жүйке сигналдары бар.
Dialogue: 0,0:03:14.56,0:03:16.57,Default,,0,0,0,,Әйтпесе, сіз оны мұндай жылдамдықта ала алмайсыз.
Dialogue: 0,0:03:18.28,0:03:20.61,Default,,0,0,0,,Оның үстіне жау лагері төменгі сол жақта.
Dialogue: 0,0:03:20.70,0:03:24.95,Default,,0,0,0,,Бір S дыбысында «се» бар болса да, «су»-ға шабуыл жасау
Dialogue: 0,0:03:25.62,0:03:27.16,Default,,0,0,0,,Қандай батылдық!
Dialogue: 0,0:03:27.24,0:03:30.54,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:03:30.62,0:03:35.00,Default,,0,0,0,,Мен қазір қандай сезімде болсам, сол бұрышқа әдемі бардым.
Dialogue: 0,0:03:36.29,0:03:38.50,Default,,0,0,0,,Мен ешқашан бірдеңе істей алмадым ...
Dialogue: 0,0:03:38.59,0:03:40.17,Default,,0,0,0,,Чихая-чан жақсы шабуыл...
Dialogue: 0,0:03:40.26,0:03:41.93,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:03:42.01,0:03:44.80,Default,,0,0,0,,Уф... «Мен мұны істедім!» деп ойлаған сәтте.
Dialogue: 0,0:03:44.89,0:03:47.26,Default,,0,0,0,,Концентрация – қашатын нәрсе...
Dialogue: 0,0:03:47.35,0:03:48.72,Default,,0,0,0,,Менің гайохам~ (Чихая) Ах.
Dialogue: 0,0:03:48.81,0:03:50.31,Default,,0,0,0,,Тіпті менің жүрегімде~ (Чихая) Ах.
Dialogue: 0,0:03:50.39,0:03:51.85,Default,,0,0,0,,Гарн...
Dialogue: 0,0:03:51.94,0:03:54.77,Default,,0,0,0,,Қираған Үкекеке...
Dialogue: 0,0:03:54.85,0:03:56.90,Default,,0,0,0,,Қарғыс атсын, бүлдірген.
Dialogue: 0,0:03:56.98,0:03:58.52,Default,,0,0,0,,Я...
Dialogue: 0,0:03:58.61,0:03:59.90,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:04:00.61,0:04:02.90,Default,,0,0,0,,Жақсы, Эму, мен сені сүйреп тұрған жоқпын.
Dialogue: 0,0:04:05.24,0:04:09.41,Default,,0,0,0,,Командаңыздың бір таңба ережесі алынып тасталса да, жағдайдың нашарлауына жол бермеңіз.
Dialogue: 0,0:04:09.49,0:04:12.25,Default,,0,0,0,,Батыс өкілі күткендей.
Dialogue: 0,0:04:12.33,0:04:15.08,Default,,0,0,0,,Акаши Джошидің эйс және көңіл-күй жасаушысы
Dialogue: 0,0:04:15.17,0:04:18.59,Default,,0,0,0,,Жеңіс немесе жеңіліс Мегуми Осаканың өнеріне байланысты.
Dialogue: 0,0:04:18.67,0:04:20.55,Default,,0,0,0,,Енді бір бөлік.
Dialogue: 0,0:04:20.63,0:04:22.09,Default,,0,0,0,,Барымызды салайық (Оқушылар) Иә!
Dialogue: 0,0:04:22.92,0:04:24.51,Default,,0,0,0,,Я...
Dialogue: 0,0:04:25.47,0:04:28.51,Default,,0,0,0,,Мен мұндай сабырлы ойыншыны ешқашан көрген емеспін.
Dialogue: 0,0:04:28.60,0:04:31.72,Default,,0,0,0,,Койшикару ~Керек~
Dialogue: 0,0:04:31.81,0:04:34.85,Default,,0,0,0,,Йоханоцуки~Кана~
Dialogue: 0,0:04:34.94,0:04:37.77,Default,,0,0,0,,Ағынды қалай түсінесіз?
Dialogue: 0,0:04:37.86,0:04:39.69,Default,,0,0,0,,Хару но Йоно~
Dialogue: 0,0:04:39.77,0:04:42.82,Default,,0,0,0,,Ха... Дәл солай!
Dialogue: 0,0:04:42.90,0:04:45.15,Default,,0,0,0,,Кері қайтпа, күрес!
Dialogue: 0,0:04:46.16,0:04:50.03,Default,,0,0,0,,Ах, уау... Менікі болған шығар...
Dialogue: 0,0:04:50.12,0:04:50.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:51.83,0:04:54.54,Default,,0,0,0,,Мені оны өз картаң жасауға мәжбүрлеме.
Dialogue: 0,0:04:54.62,0:04:56.37,Default,,0,0,0,,Мен мұны айтып тұрған жоқпын.
Dialogue: 0,0:04:56.46,0:04:58.00,Default,,0,0,0,,Соңында берілсең де
Dialogue: 0,0:04:58.08,0:05:01.09,Default,,0,0,0,,Адамдарға сізді қиындық тудыратын адам деп ойлаудың мәні бар.
Dialogue: 0,0:05:01.17,0:05:03.42,Default,,0,0,0,,Қарсыласыңыздың қарқынын бұзыңыз
Dialogue: 0,0:05:03.51,0:05:04.63,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:04.72,0:05:07.22,Default,,0,0,0,,Дәл қазір Эму-чандікі.
Dialogue: 0,0:05:07.30,0:05:08.22,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:08.30,0:05:09.72,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:09.80,0:05:11.10,Default,,0,0,0,,Олай болса, өтінемін (Чихая) Иә?
Dialogue: 0,0:05:11.18,0:05:14.77,Default,,0,0,0,,Иә!? Бұл менің тегім болды~
Dialogue: 0,0:05:14.85,0:05:16.98,Default,,0,0,0,,Амал жоқ, болмайды... Не істеуім керек?
Dialogue: 0,0:05:17.06,0:05:18.35,Default,,0,0,0,,Бұл тым алыс~ (Чихая) А.
Dialogue: 0,0:05:18.44,0:05:19.73,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:19.81,0:05:22.36,Default,,0,0,0,,Маған көнсең, қарқынымды бұзасың.
Dialogue: 0,0:05:22.44,0:05:25.36,Default,,0,0,0,,Ах... (Тайчи) Мен төбелесуге дайын емеспін.
Dialogue: 0,0:05:26.20,0:05:28.57,Default,,0,0,0,,Мен күшті болуым керек
Dialogue: 0,0:05:28.66,0:05:30.74,Default,,0,0,0,,Маған мықты болу керек
Dialogue: 0,0:05:30.83,0:05:32.66,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:05:33.16,0:05:35.62,Default,,0,0,0,,Мен... мм
Dialogue: 0,0:05:36.46,0:05:41.63,Default,,0,0,0,,Мына ауа, мына галерея, менің денем мен ойлағандай қозғалмайды.
Dialogue: 0,0:05:41.71,0:05:42.71,Default,,0,0,0,,Ямагавани~
Dialogue: 0,0:05:42.71,0:05:43.63,Default,,0,0,0,,Ямагавани~
Dialogue: 0,0:05:42.71,0:05:43.63,Default,,0,0,0,,Ах... Бос вексель... Қауіпті.
Dialogue: 0,0:05:43.63,0:05:46.30,Default,,0,0,0,,Ах... Бос вексель... Қауіпті
Dialogue: 0,0:05:46.38,0:05:48.13,Default,,0,0,0,,А... ой
Dialogue: 0,0:05:51.01,0:05:52.64,Default,,0,0,0,,Ханано...
Dialogue: 0,0:05:53.43,0:05:54.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:55.73,0:05:59.40,Default,,0,0,0,,Хананоның «Ат құйрықты бала» естелігінде
Dialogue: 0,0:05:59.48,0:06:02.69,Default,,0,0,0,,«Рюджи Аоидың орамалы»
Dialogue: 0,0:06:02.77,0:06:07.95,Default,,0,0,0,,Орамал... Меніңше, ол бұл туралы көп білмейді.
Dialogue: 0,0:06:08.91,0:06:12.78,Default,,0,0,0,,Рюджи Аои - тәтті махаббат әндерін айтатын әнші.
Dialogue: 0,0:06:12.87,0:06:15.45,Default,,0,0,0,,Тазаланбаған қайғылы махаббат сериясы
Dialogue: 0,0:06:17.83,0:06:21.50,Default,,0,0,0,,Содан кейін мына жердегі тегтер...
Dialogue: 0,0:06:22.84,0:06:24.21,Default,,0,0,0,,Дұрыс қабылдаңыз!
Dialogue: 0,0:06:22.84,0:06:24.21,Default,,0,0,0,,Мичиноку жоқ ~
Dialogue: 0,0:06:24.30,0:06:26.34,Default,,0,0,0,,Мен мақсат еткен заң жобасы
Dialogue: 0,0:06:26.42,0:06:29.72,Default,,0,0,0,,Мен бұл адамның С класы туралы айттым, бірақ оны орындау қиын.
Dialogue: 0,0:06:29.80,0:06:32.72,Default,,0,0,0,,Бүгін бірінші ойында мен ағынмен жүрмін.
Dialogue: 0,0:06:33.35,0:06:35.97,Default,,0,0,0,,Қорғалған! Келесі жолы мен де аламын, Мизусава!
Dialogue: 0,0:06:36.06,0:06:37.06,Default,,0,0,0,,О!
Dialogue: 0,0:06:39.64,0:06:42.90,Default,,0,0,0,,Ханано мырза, мен сізді мұқият бақылап отырмын. Рақмет сізге.
Dialogue: 0,0:06:45.57,0:06:46.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:46.98,0:06:49.15,Default,,0,0,0,,Оеяма~ (Нишида және басқалар) Хмф!
Dialogue: 0,0:06:49.24,0:06:50.49,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:50.57,0:06:54.74,Default,,0,0,0,,«Сәлем!» Барлығы алды. Ағын келе жатыр. Бұл жолы!
Dialogue: 0,0:06:56.20,0:06:57.87,Default,,0,0,0,,Ағын – бұл...
Dialogue: 0,0:06:58.96,0:07:00.62,Default,,0,0,0,,Ағын – бұл...
Dialogue: 0,0:07:01.79,0:07:03.29,Default,,0,0,0,,Қатарынан ұтыстар туралы!
Dialogue: 0,0:07:03.96,0:07:05.29,Default,,0,0,0,,Қазір~
Dialogue: 0,0:07:05.38,0:07:06.25,Default,,0,0,0,,Ах
Dialogue: 0,0:07:10.34,0:07:12.26,Default,,0,0,0,,Темірмен қапталған тұрақтылық
Dialogue: 0,0:07:13.30,0:07:15.35,Default,,0,0,0,,Мен мұны алдым! (Эму) Ах...
Dialogue: 0,0:07:15.43,0:07:17.89,Default,,0,0,0,,Жарайды. Біріншісі (Ябе) Ах.
Dialogue: 0,0:07:17.97,0:07:19.52,Default,,0,0,0,,Мен біреуін аламын.
Dialogue: 0,0:07:19.60,0:07:21.60,Default,,0,0,0,,Иә, кешіріңіз Эму
Dialogue: 0,0:07:22.90,0:07:27.11,Default,,0,0,0,,Эму осындай үлкен сахнада да керемет...
Dialogue: 0,0:07:27.19,0:07:31.86,Default,,0,0,0,,Бірақ біз мәңгі бірге болсақ та, Эмудың сезімін әлі түсінбеймін.
Dialogue: 0,0:07:31.95,0:07:34.95,Default,,0,0,0,,Мен Мегумиді патшайым етіп, толқыттым.
Dialogue: 0,0:07:35.03,0:07:37.62,Default,,0,0,0,,Мен Хонманың өзін қалай сезінетініне таңғаламын...
Dialogue: 0,0:07:38.29,0:07:41.12,Default,,0,0,0,,Сіз патшайым болғыңыз келе ме?
Dialogue: 0,0:07:41.83,0:07:44.42,Default,,0,0,0,,Чихаяның қатарынан жеңіске жетуіне рұқсат етілмейді
Dialogue: 0,0:07:44.50,0:07:46.71,Default,,0,0,0,,Алшақтық бірте-бірте кеңейеді...
Dialogue: 0,0:07:46.79,0:07:47.63,Default,,0,0,0,,Га
Dialogue: 0,0:07:47.71,0:07:49.80,Default,,0,0,0,,Чихая, тек жең.
Dialogue: 0,0:07:51.05,0:07:52.18,Default,,0,0,0,,Жеңіске жетейік
Dialogue: 0,0:07:52.88,0:07:54.93,Default,,0,0,0,,Мен тағы да көп айттым ба?
Dialogue: 0,0:07:57.72,0:07:59.18,Default,,0,0,0,,Өткен жылдан өзгеше болуы керек
Dialogue: 0,0:08:02.06,0:08:03.94,Default,,0,0,0,,Бір жыл болды
Dialogue: 0,0:08:05.48,0:08:07.11,Default,,0,0,0,,1 жыл…
Dialogue: 0,0:08:20.04,0:08:23.04,Default,,0,0,0,,Ариаке но Цукио~
Dialogue: 0,0:08:23.12,0:08:28.29,Default,,0,0,0,,Қалада өсіре аламын ба деп ойлаймын.
Dialogue: 0,0:08:30.13,0:08:31.46,Default,,0,0,0,,Аматсуказэ~
Dialogue: 0,0:08:31.55,0:08:32.76,Default,,0,0,0,,Бланк вексель
Dialogue: 0,0:08:32.84,0:08:35.22,Default,,0,0,0,,Тез шығады, бірақ қашуға да шебер.
Dialogue: 0,0:08:35.30,0:08:36.47,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:08:39.51,0:08:43.06,Default,,0,0,0,,Осака мырзаның шапшаң секірісі мені ұстамады.
Dialogue: 0,0:08:50.82,0:08:53.82,Default,,0,0,0,,Ах... А, кешіріңіз.
Dialogue: 0,0:08:58.16,0:09:01.16,Default,,0,0,0,,Жастардың дәмін тату
Dialogue: 0,0:09:01.24,0:09:03.87,Default,,0,0,0,,(Оңтүстіктегі шайнайтын гүлдердің дыбысы)
Dialogue: 0,0:09:03.96,0:09:05.79,Default,,0,0,0,,Бұл енді сауда белгісі—
Dialogue: 0,0:09:05.87,0:09:07.96,Default,,0,0,0,,Мегуми Осаканың басы
Dialogue: 0,0:09:08.04,0:09:11.00,Default,,0,0,0,,Әзірге тек Осака ғана қол жеткізе алды, бірақ...
Dialogue: 0,0:09:11.09,0:09:14.05,Default,,0,0,0,,Мен республикалық турнирге қатыстым.
Dialogue: 0,0:09:14.13,0:09:16.22,Default,,0,0,0,,Бәріміз оны киейік (Юбе) А!?
Dialogue: 0,0:09:16.30,0:09:18.64,Default,,0,0,0,,Алдыңғы Маған жасаған тамағың үшін
Dialogue: 0,0:09:18.72,0:09:20.01,Default,,0,0,0,,Эму Сенпай!
Dialogue: 0,0:09:20.10,0:09:25.43,Default,,0,0,0,,Сондай әдемі достық... Мен карута клубының кеңесшісі болғаныма қуаныштымын.
Dialogue: 0,0:09:25.52,0:09:26.35,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:09:27.31,0:09:29.65,Default,,0,0,0,,Эму-танның бізге ұнайтыны
Dialogue: 0,0:09:29.73,0:09:32.86,Default,,0,0,0,,Эму-танның алдында тұрған үлкен алшақтық
Dialogue: 0,0:09:32.94,0:09:34.49,Default,,0,0,0,,Біз линзаларымызды білеміз
Dialogue: 0,0:09:36.15,0:09:37.66,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:37.74,0:09:40.53,Default,,0,0,0,,Жалғыз бас киім кию өте суық
Dialogue: 0,0:09:40.62,0:09:42.74,Default,,0,0,0,,Барлығын тарта алғанымызға қуаныштымын.
Dialogue: 0,0:09:47.08,0:09:48.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:48.46,0:09:50.92,Default,,0,0,0,,Қыздың бейнесі
Dialogue: 0,0:09:51.00,0:09:56.38,Default,,0,0,0,,Біраз уақыт қалдырыңыз~
Dialogue: 0,0:09:57.13,0:09:59.84,Default,,0,0,0,,Аразараму~ (Эму) Ах
Dialogue: 0,0:10:02.10,0:10:05.35,Default,,0,0,0,,Қолымның астынан өтіп кетті...
Dialogue: 0,0:10:06.06,0:10:08.77,Default,,0,0,0,,«А» тегі басынан бастап дерлік алынды.
Dialogue: 0,0:10:08.85,0:10:10.44,Default,,0,0,0,,Мен оны бірінші рет таза қабылдадым.
Dialogue: 0,0:10:12.82,0:10:14.90,Default,,0,0,0,,Сіз оны ұстадыңыз ба? бірдеңе
Dialogue: 0,0:10:17.45,0:10:18.90,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:10:21.87,0:10:22.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:24.49,0:10:27.25,Default,,0,0,0,,Енді келесіге көшейік.
Dialogue: 0,0:10:27.33,0:10:28.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:31.54,0:10:36.09,Default,,0,0,0,,Командалық жарыс болса да, неге мен ғана сөйлеймін...
Dialogue: 0,0:10:37.47,0:10:41.30,Default,,0,0,0,,Ханшайым? Маған бәрібір
Dialogue: 0,0:10:41.39,0:10:44.31,Default,,0,0,0,,Мен жалғыз қалдым ба?
Dialogue: 0,0:10:45.60,0:10:47.73,Default,,0,0,0,,Шот жіберу
Dialogue: 0,0:10:47.81,0:10:49.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:51.35,0:10:52.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:52.27,0:10:54.98,Default,,0,0,0,,Е, «Асаборакеу»?
Dialogue: 0,0:10:55.07,0:10:58.94,Default,,0,0,0,,Вексельдердің үлкен үйіндісі... Неге? Олар әдетте жібермейді, солай ма?
Dialogue: 0,0:11:02.78,0:11:07.70,Default,,0,0,0,,Ол үлкен карталарды ойнауда нашар болған болуы керек... Ол оларды лақтырып жіберді ме?
Dialogue: 0,0:11:07.79,0:11:10.58,Default,,0,0,0,,Бір рет...
Dialogue: 0,0:11:10.66,0:11:15.96,Default,,0,0,0,,Барғаныңыз дұрыс
Dialogue: 0,0:11:16.80,0:11:17.21,Default,,0,0,0,,Сізге Ошикаразариши
Dialogue: 0,0:11:17.21,0:11:18.88,Default,,0,0,0,,Сізге арналған Ошикаразариши
Dialogue: 0,0:11:17.21,0:11:18.88,Default,,0,0,0,,Басқа үлкен үйінді!
Dialogue: 0,0:11:18.88,0:11:18.96,Default,,0,0,0,,Сізге арналған Ошикаразариши
Dialogue: 0,0:11:18.96,0:11:20.38,Default,,0,0,0,,Сізге арналған Ошикаразариши
Dialogue: 0,0:11:18.96,0:11:20.38,Default,,0,0,0,,Иә!?
Dialogue: 0,0:11:20.47,0:11:23.39,Default,,0,0,0,,Тіпті өмір
Dialogue: 0,0:11:24.80,0:11:25.64,Default,,0,0,0,,Я...
Dialogue: 0,0:11:26.43,0:11:28.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:29.43,0:11:30.64,Default,,0,0,0,,Эму?
Dialogue: 0,0:11:33.48,0:11:35.48,Default,,0,0,0,,Сол бір әріптік жылдамдық
Dialogue: 0,0:11:36.52,0:11:37.73,Default,,0,0,0,,Қоршауды бұзу
Dialogue: 0,0:11:38.86,0:11:40.49,Default,,0,0,0,,Бүкіл денеңмен айт
Dialogue: 0,0:11:43.82,0:11:45.49,Default,,0,0,0,,Ханшайым бол
Dialogue: 0,0:11:54.00,0:11:56.13,Default,,0,0,0,,Маған патшайым бәрібір.
Dialogue: 0,0:11:57.29,0:12:00.51,Default,,0,0,0,,Бірақ... мына баланы осы жерден ұрады.
Dialogue: 0,0:12:14.15,0:12:14.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:16.06,0:12:17.69,Default,,0,0,0,,Қоршауды бұзу
Dialogue: 0,0:12:18.48,0:12:21.78,Default,,0,0,0,,Өзінің сүйікті карталарын тез ала алатын адамдар көп.
Dialogue: 0,0:12:21.86,0:12:23.95,Default,,0,0,0,,Айырмашылықты тудыратын нәрсе
Dialogue: 0,0:12:24.03,0:12:26.74,Default,,0,0,0,,Сіздің күшті жақтарыңыз бұлыңғыр болу үшін әлсіз жақтарыңызды жойыңыз
Dialogue: 0,0:12:27.58,0:12:31.25,Default,,0,0,0,,Ол... ол қанша уақыт жаттығады?
Dialogue: 0,0:12:31.33,0:12:34.92,Default,,0,0,0,,Сондықтан мен сенің семсеріңді маймыл дедім.
Dialogue: 0,0:12:35.00,0:12:37.25,Default,,0,0,0,,Осылай! Түсіну үшін қанша рет айтуым керек?
Dialogue: 0,0:12:40.71,0:12:44.88,Default,,0,0,0,,Бірдеңеде жақсы болмасаң, патшайым бола аламын деп ойлама!
Dialogue: 0,0:12:47.89,0:12:48.80,Default,,0,0,0,,Орындалды
Dialogue: 0,0:12:48.89,0:12:53.56,Default,,0,0,0,,Аясе мұқият тыңдап, секіргені дұрыс, мен сенімен бірге барамын.
Dialogue: 0,0:12:59.48,0:13:02.57,Default,,0,0,0,,Орындалды... барлығы.
Dialogue: 0,0:13:04.70,0:13:05.82,Default,,0,0,0,,Орындалды
Dialogue: 0,0:13:07.70,0:13:09.07,Default,,0,0,0,,Соққы
Dialogue: 0,0:13:13.70,0:13:14.91,Default,,0,0,0,,Ағын...
Dialogue: 0,0:13:15.66,0:13:16.96,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:13:17.04,0:13:18.46,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:13:22.25,0:13:24.38,Default,,0,0,0,,Миёшино... (Барлығы) Уф!
Dialogue: 0,0:13:24.47,0:13:26.80,Default,,0,0,0,,Мен оны алдым! (ойнау) Мен оны сақтадым!
Dialogue: 0,0:13:26.88,0:13:27.72,Default,,0,0,0,,Бұл да!
Dialogue: 0,0:13:27.80,0:13:29.22,Default,,0,0,0,,Бұл да!
Dialogue: 0,0:13:29.30,0:13:30.14,Default,,0,0,0,,Не!?
Dialogue: 0,0:13:30.93,0:13:32.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:32.31,0:13:33.43,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:33.52,0:13:35.43,Default,,0,0,0,,Я...
Dialogue: 0,0:13:35.52,0:13:37.19,Default,,0,0,0,,Ал... тағы да...
Dialogue: 0,0:13:37.27,0:13:38.94,Default,,0,0,0,,Бірінен соң бірі алынбайды
Dialogue: 0,0:13:39.73,0:13:41.94,Default,,0,0,0,,Я...
Dialogue: 0,0:13:42.02,0:13:44.44,Default,,0,0,0,,Эмутан "Жарайды" деді
Dialogue: 0,0:13:46.53,0:13:49.45,Default,,0,0,0,,Эму-тан «Жарайды, бір кесек» демейді.
Dialogue: 0,0:13:52.58,0:13:53.70,Default,,0,0,0,,Қызықты
Dialogue: 0,0:13:54.50,0:13:57.96,Default,,0,0,0,,Көру ойыны жоғары деңгейде... күтпеген жерден
Dialogue: 0,0:13:58.04,0:14:01.71,Default,,0,0,0,,Оның жақсы «сезімі» бар және бәрінен бұрын оның көзқарасы кең.
Dialogue: 0,0:14:01.79,0:14:03.38,Default,,0,0,0,,Шығу карталары жоқ
Dialogue: 0,0:14:03.46,0:14:05.71,Default,,0,0,0,,Не істесең де, сабыр сақта...
Dialogue: 0,0:14:05.80,0:14:07.72,Default,,0,0,0,,Шот жіберу
Dialogue: 0,0:14:09.01,0:14:10.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:10.51,0:14:14.18,Default,,0,0,0,,Мен бұрын жіберген карталардың үлкен жинағын қайтардым.
Dialogue: 0,0:14:14.27,0:14:16.93,Default,,0,0,0,,Ой, қызық...
Dialogue: 0,0:14:17.02,0:14:19.19,Default,,0,0,0,,Бұл қыздың да садист екені анық.
Dialogue: 0,0:14:24.07,0:14:25.03,Default,,0,0,0,,Асабораке Маггот Кагири
Dialogue: 0,0:14:25.03,0:14:25.86,Default,,0,0,0,,Асабораке Маггот Кагири
Dialogue: 0,0:14:25.03,0:14:25.86,Default,,0,0,0,,Бір ату...
Dialogue: 0,0:14:25.86,0:14:26.99,Default,,0,0,0,,Асабораке Маггот Кагири
Dialogue: 0,0:14:26.99,0:14:27.49,Default,,0,0,0,,Асабораке Маггот Кагири
Dialogue: 0,0:14:26.99,0:14:27.49,Default,,0,0,0,,Қарсыластың карталарын төмен және төмен ұстаңыз.
Dialogue: 0,0:14:27.49,0:14:27.57,Default,,0,0,0,,Жаудың белгісін төмен және төмен ұстау.
Dialogue: 0,0:14:27.57,0:14:29.36,Default,,0,0,0,,Қарсыластың карталарын төмен және төмен ұстаңыз.
Dialogue: 0,0:14:27.57,0:14:29.36,Default,,0,0,0,,Таедаена
Dialogue: 0,0:14:30.16,0:14:31.20,Default,,0,0,0,,(Тодороки) Камино… (Камино) Жарайды, алдым.
Dialogue: 0,0:14:32.12,0:14:32.95,Default,,0,0,0,,Иә
Dialogue: 0,0:14:34.12,0:14:37.83,Default,,0,0,0,,Мен олардың қоршауды бұзуға шара қолданып жатқанына сенімдімін.
Dialogue: 0,0:14:37.91,0:14:41.71,Default,,0,0,0,,Біз бәріміз патшайыммен күресу шартымен жаттығатынбыз.
Dialogue: 0,0:14:43.13,0:14:45.46,Default,,0,0,0,,Маған патшайым бәрібір.
Dialogue: 0,0:14:46.21,0:14:48.97,Default,,0,0,0,,Мен жеңсем, бәрі бақытты болады.
Dialogue: 0,0:14:50.13,0:14:52.72,Default,,0,0,0,,Сіз осы жерде соққы бересіз.
Dialogue: 0,0:14:52.80,0:14:55.85,Default,,0,0,0,,А... ашуланып қалдың ба?
Dialogue: 0,0:14:56.39,0:14:57.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:58.52,0:15:03.48,Default,,0,0,0,,Күшті... Тіпті үлкен палуба әлі де қатал.
Dialogue: 0,0:15:05.19,0:15:09.99,Default,,0,0,0,,Бірақ мен де бір нәрсені байқадым, профессор.
Dialogue: 0,0:15:16.70,0:15:20.62,Default,,0,0,0,,Қандай да бір себептермен бұл ойынды тамашалайтындар көбейіп кетті ме?
Dialogue: 0,0:15:21.96,0:15:24.38,Default,,0,0,0,,(Барлығы ауыр тыныс алады)
Dialogue: 0,0:15:25.04,0:15:29.88,Default,,0,0,0,,Акаши Джоши... Мен бұл Мегуми Осаканың бір адамдық командасы деп ойладым.
Dialogue: 0,0:15:30.76,0:15:34.64,Default,,0,0,0,,Мен қыздар мектебімен бірінші рет жарысып жатырмын, сондықтан мен біраз толқыдым.
Dialogue: 0,0:15:34.72,0:15:36.01,Default,,0,0,0,,Нагакаран~ (Юбе) Уф!
Dialogue: 0,0:15:36.60,0:15:39.48,Default,,0,0,0,,Бұл күшті! Бұл адамның күші дерлік!
Dialogue: 0,0:15:39.56,0:15:41.06,Default,,0,0,0,,Ах! (ойнау) Ах
Dialogue: 0,0:15:41.14,0:15:43.73,Default,,0,0,0,,Менің қозғалтқышым - Осака
Dialogue: 0,0:15:43.81,0:15:47.52,Default,,0,0,0,,Бірақ басқа балалар да тұрақты түрде күш жинайды.
Dialogue: 0,0:15:47.61,0:15:52.45,Default,,0,0,0,,Королева болғысы келетін Осака үшін жаттығу серіктесі болу деген осы.
Dialogue: 0,0:15:52.95,0:15:56.08,Default,,0,0,0,,Егер сізде мотив болса, сіз соншалықты күшті бола аласыз.
Dialogue: 0,0:15:56.91,0:16:01.58,Default,,0,0,0,,Қазіргі Акаши қыздары Осаканың арқасында күшейген команда.
Dialogue: 0,0:16:01.66,0:16:04.58,Default,,0,0,0,,Қарғыс атсын... Жастық шағымды жылаймын.
Dialogue: 0,0:16:05.21,0:16:08.59,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:16:10.09,0:16:11.84,Default,,0,0,0,,Эму маған қоңырау шалуды қойды.
Dialogue: 0,0:16:13.22,0:16:16.10,Default,,0,0,0,,Бұл шынымен де соншалықты күшті ме? бала
Dialogue: 0,0:16:16.18,0:16:18.10,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:20.18,0:16:21.98,Default,,0,0,0,,Арашифуку~ (2 адам) Уф
Dialogue: 0,0:16:22.94,0:16:26.19,Default,,0,0,0,,Мен бір сәтке кешігіп қалдым, дұрысырақ, дұрысырақ...
Dialogue: 0,0:16:29.90,0:16:33.65,Default,,0,0,0,,Сол бір миллиметр, сол бір нүкте...
Dialogue: 0,0:16:34.70,0:16:36.37,Default,,0,0,0,,Сол вексельдің шетінде...
Dialogue: 0,0:16:40.16,0:16:41.87,Default,,0,0,0,,Цукимиге қарасаңыз~
Dialogue: 0,0:16:42.66,0:16:43.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:43.71,0:16:45.62,Default,,0,0,0,,Соқтығысайық!
Dialogue: 0,0:16:45.71,0:16:47.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:47.46,0:16:49.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:49.21,0:16:53.88,Default,,0,0,0,,Карутаны соншалықты тез жинайтын ол... болды ма?
Dialogue: 0,0:16:54.68,0:16:58.39,Default,,0,0,0,,Осака тезірек секірсе де, оны басып озды.
Dialogue: 0,0:16:59.60,0:17:00.64,Default,,0,0,0,,Дәл…
Dialogue: 0,0:17:04.35,0:17:08.31,Default,,0,0,0,,Эму-чан Эму-чан менмін
Dialogue: 0,0:17:09.31,0:17:11.57,Default,,0,0,0,,Оны тым жылдам қабылдауды тоқтатыңыз
Dialogue: 0,0:17:14.99,0:17:17.57,Default,,0,0,0,,Маған бұлай айтатын адам жоқ еді.
Dialogue: 0,0:17:29.71,0:17:32.76,Default,,0,0,0,,Менің бір нәрсем...
Dialogue: 0,0:17:32.84,0:17:38.97,Default,,0,0,0,,Аки ni aara ~nedo~
Dialogue: 0,0:17:47.98,0:17:49.81,Default,,0,0,0,,Ясураваде~
Dialogue: 0,0:17:49.90,0:17:51.44,Default,,0,0,0,,Аймитено~
Dialogue: 0,0:17:52.19,0:17:53.73,Default,,0,0,0,,Рентори пайда болды
Dialogue: 0,0:17:54.53,0:17:57.74,Default,,0,0,0,,Бұл жерде ештеңе жоқ, бірақ тұрақты түрде...
Dialogue: 0,0:17:57.82,0:17:59.66,Default,,0,0,0,,Айырмашылығы...
Dialogue: 0,0:18:02.70,0:18:05.37,Default,,0,0,0,,Енді ешқандай айырмашылық жоқ...
Dialogue: 0,0:18:05.45,0:18:06.96,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:18:06.96,0:18:08.75,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:18:06.96,0:18:08.75,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:08.75,0:18:10.21,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:18:10.29,0:18:11.13,Default,,0,0,0,,Келіңіздер! (Эму) Ха!
Dialogue: 0,0:18:11.21,0:18:14.46,Default,,0,0,0,,1 дана! Мен біреуін аламын! (Барлығы) Уф
Dialogue: 0,0:18:15.30,0:18:17.72,Default,,0,0,0,,А... а
Dialogue: 0,0:18:20.05,0:18:22.68,Default,,0,0,0,,А... бұл дауыс тым қатты шықты. Мен бұған үйренбегенмін.
Dialogue: 0,0:18:22.68,0:18:23.56,Default,,0,0,0,,А... бұл дауыс тым қатты шықты. Мен бұған үйренбегенмін.
Dialogue: 0,0:18:22.68,0:18:23.56,Default,,0,0,0,,(жөтел жөтел)
Dialogue: 0,0:18:23.56,0:18:25.47,Default,,0,0,0,,А... бұл дауыс тым қатты шықты. Мен бұған үйренбегенмін.
Dialogue: 0,0:18:27.23,0:18:28.81,Default,,0,0,0,,Ю-чан...
Dialogue: 0,0:18:30.10,0:18:31.02,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:31.10,0:18:32.31,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:18:33.36,0:18:33.86,Default,,0,0,0,,Ariake no ~
Dialogue: 0,0:18:33.86,0:18:34.69,Default,,0,0,0,,Ariake no ~
Dialogue: 0,0:18:33.86,0:18:34.69,Default,,0,0,0,,Уф! (Нишида) Ах.
Dialogue: 0,0:18:34.69,0:18:35.48,Default,,0,0,0,,Ariake no ~
Dialogue: 0,0:18:35.57,0:18:39.61,Default,,0,0,0,,Бос есепшотқа бұл секіру негізінен ұл бала...
Dialogue: 0,0:18:40.53,0:18:44.45,Default,,0,0,0,,Эму... Мен Эмудың сезімін әлі түсінбеймін.
Dialogue: 0,0:18:44.95,0:18:47.33,Default,,0,0,0,,Хонма патшайымға мән бермейді.
Dialogue: 0,0:18:47.41,0:18:50.00,Default,,0,0,0,,Мүмкін бәрі бірге көңіл көтергісі келген шығар.
Dialogue: 0,0:18:50.71,0:18:51.67,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:52.21,0:18:57.76,Default,,0,0,0,,Эму Біріншіден, мен жеңемін, сондықтан уайымдамаңыз және оны жасаңыз.
Dialogue: 0,0:18:57.84,0:18:59.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:59.76,0:19:01.01,Default,,0,0,0,,Мен Эму туралы білмеймін...
Dialogue: 0,0:19:02.51,0:19:03.51,Default,,0,0,0,,Ханшайым…
Dialogue: 0,0:19:06.68,0:19:10.48,Default,,0,0,0,,Мен биыл Королеваның іріктеу кезеңіне қатысамын.
Dialogue: 0,0:19:10.56,0:19:11.77,Default,,0,0,0,,Күшті болу дегеніміз...
Dialogue: 0,0:19:11.85,0:19:12.77,Default,,0,0,0,,Га
Dialogue: 0,0:19:12.86,0:19:16.02,Default,,0,0,0,,Күшті болу қызық емес, солай емес пе?
Dialogue: 0,0:19:16.69,0:19:19.78,Default,,0,0,0,,Ему-тан, сен шынымен мейірімді бала екенсің.
Dialogue: 0,0:19:21.11,0:19:25.03,Default,,0,0,0,,Мен барлығын қуантқым келеді Мен барлығының үмітін ақтағым келеді
Dialogue: 0,0:19:25.12,0:19:28.54,Default,,0,0,0,,Сол сезім сіздің күш-жігеріңіздің негізі.
Dialogue: 0,0:19:28.62,0:19:30.04,Default,,0,0,0,,Біз білеміз
Dialogue: 0,0:19:30.62,0:19:32.29,Default,,0,0,0,,Бірақ біз...
Dialogue: 0,0:19:34.50,0:19:36.88,Default,,0,0,0,,Мен сенің ашкөздікпен жабылғаныңды көргім келеді
Dialogue: 0,0:19:38.09,0:19:40.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:40.13,0:19:41.80,Default,,0,0,0,,Конухито~
Dialogue: 0,0:19:41.88,0:19:45.55,Default,,0,0,0,,Уақыты бірдей, бірақ бұл менің жеке территориям.
Dialogue: 0,0:19:45.64,0:19:47.39,Default,,0,0,0,,Жақсы! (Чихая) Иә?
Dialogue: 0,0:19:47.47,0:19:49.14,Default,,0,0,0,,Не? Менің қабылдауым...
Dialogue: 0,0:19:49.22,0:19:51.52,Default,,0,0,0,,Бұл менмін Енді менмін!
Dialogue: 0,0:19:52.98,0:19:56.19,Default,,0,0,0,,Бірақ мен оны дерлік бір уақытта ұстадым және ол менің лагерімде болды...
Dialogue: 0,0:19:56.27,0:19:59.57,Default,,0,0,0,,Мен жылдамырақ болдым. Мен көрдім.
Dialogue: 0,0:19:59.65,0:20:01.03,Default,,0,0,0,,Ия... Бірақ қазір...
Dialogue: 0,0:20:01.11,0:20:02.03,Default,,0,0,0,,Жоқ, менмін. Мен сәл жылдамырақ болдым!
Dialogue: 0,0:20:02.03,0:20:03.03,Default,,0,0,0,,Жоқ, бұл менмін. Мен сәл жылдамырақ болдым!
Dialogue: 0,0:20:02.03,0:20:03.03,Default,,0,0,0,,Эму...
Dialogue: 0,0:20:03.03,0:20:06.03,Default,,0,0,0,,Жоқ, бұл менмін. Мен сәл жылдамырақ болдым!
Dialogue: 0,0:20:06.95,0:20:08.04,Default,,0,0,0,,Біз соғыстық...
Dialogue: 0,0:20:08.12,0:20:11.54,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:20:12.12,0:20:14.42,Default,,0,0,0,,Олай болса, өтінемін (Тайчи және басқалар) Ах...
Dialogue: 0,0:20:14.50,0:20:17.29,Default,,0,0,0,,Мен ұрысуға немесе төбелесуге жарамаймын.
Dialogue: 0,0:20:17.38,0:20:20.09,Default,,0,0,0,,Мені ақымақ деме, Ю Чан
Dialogue: 0,0:20:20.17,0:20:24.93,Default,,0,0,0,,Бәрін алға сүйрейтін менмін
Dialogue: 0,0:20:25.01,0:20:27.35,Default,,0,0,0,,Кім патшайымға қарсы шығып жатыр...
Dialogue: 0,0:20:28.89,0:20:30.06,Default,,0,0,0,,Мен!
Dialogue: 0,0:20:30.14,0:20:32.23,Default,,0,0,0,,Не? (Юбе) Не?
Dialogue: 0,0:20:32.31,0:20:34.48,Default,,0,0,0,,Хааа~
Dialogue: 0,0:20:35.23,0:20:36.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:37.06,0:20:40.98,Default,,0,0,0,,Мегуми Широхен шығады
Dialogue: 0,0:20:41.86,0:20:45.49,Default,,0,0,0,,Жекпе-жектен жеңіліп қалдым, бірақ бұрын берген қарызымды қайтардым.
Dialogue: 0,0:20:47.87,0:20:50.08,Default,,0,0,0,,Жақсы, Аясе.
Dialogue: 0,0:20:50.87,0:20:52.75,Default,,0,0,0,,Кәдімгі Чихаяға айнал
Dialogue: 0,0:20:53.50,0:20:55.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:56.46,0:20:57.96,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:58.04,0:21:00.34,Default,,0,0,0,,Осы жерден шабуыл жасайық, Мизусава!
Dialogue: 0,0:21:00.42,0:21:01.38,Default,,0,0,0,,О!
Dialogue: 0,0:21:01.46,0:21:04.63,Default,,0,0,0,,Енді біреуін ал... (Эму) Бір, бір!
Dialogue: 0,0:21:04.72,0:21:06.13,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:21:09.93,0:21:13.14,Default,,0,0,0,,Барлығы маған қарап тұр
Dialogue: 0,0:21:13.23,0:21:15.14,Default,,0,0,0,,Екі мектеп те тең...
Dialogue: 0,0:21:18.48,0:21:19.40,Default,,0,0,0,,Ауа...
Dialogue: 0,0:21:21.61,0:21:25.86,Default,,0,0,0,,Барлығының қысымы соқтығысуда
Dialogue: 0,0:21:25.95,0:21:30.95,Default,,0,0,0,,♪~
Dialogue: 0,0:22:45.90,0:22:50.91,Default,,0,0,0,,~♪
