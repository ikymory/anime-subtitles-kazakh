Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.67,0:00:06.96,JP-SUB,,0000,0000,0000,,Бюджет жеткіліксіз болса, бонус бұрышының көлемі қысқарады! ?
Dialogue: 0,0:00:07.22,0:00:09.12,JP-SUB,,0000,0000,0000,,2 сағат және сенбі 8 үшін арнайы жасаңыз.
Dialogue: 0,0:00:09.30,0:00:11.01,JP-SUB,,0000,0000,0000,,Сіз 500 парақтан тұратын кітап дайындап қойдыңыз ба?
Dialogue: 0,0:00:11.18,0:00:13.09,JP-SUB,,0000,0000,0000,,Мен Чихая туралы айтып отырған жоқпын.
Dialogue: 0,0:00:13.47,0:00:14.12,JP-SUB,,0000,0000,0000,,Не болды, Рюзаки?
Dialogue: 0,0:00:14.20,0:00:16.99,JP-SUB,,0000,0000,0000,,Мен бұл жолы А сыныбына баратын жолым тартылады деп ойладым.
Dialogue: 0,0:00:17.07,0:00:18.19,JP-SUB,,0000,0000,0000,,Уайымдаудың да бір мәні бар.
Dialogue: 0,0:00:18.32,0:00:21.77,JP-SUB,,0000,0000,0000,,Менің қабілетім бойынша, мен Машимадан тезірек А сыныбына жетемін.
Dialogue: 0,0:00:22.20,0:00:24.32,JP-SUB,,0000,0000,0000,,Ол бірінші маусымда көрінбеді.
Dialogue: 0,0:00:24.60,0:00:26.27,JP-SUB,,0000,0000,0000,,Мен бұл жолы басты кейіпкер боламын деп ойлаймын.
Dialogue: 0,0:00:26.63,0:00:29.22,JP-SUB,,0000,0000,0000,,Мен махаббаттан бас тарттым және дизайнер болу арманыммен өмір сүрдім...
Dialogue: 0,0:00:29.61,0:00:32.18,JP-SUB,,0000,0000,0000,,Дәлірек айтсақ, бұл Джонни Депп кімге ұқсайды?
Dialogue: 0,0:00:36.15,0:00:36.87,JP-SUB,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:00:38.31,0:00:39.77,JP-SUB,,0000,0000,0000,,Мен тастап кеткеніме сене алар емеспін
Dialogue: 0,0:00:44.65,0:00:45.94,JP-SUB,,0000,0000,0000,,Тез жігіт тауып ал
Dialogue: 0,0:00:46.39,0:00:48.10,JP-SUB,,0000,0000,0000,,Мектептегі ең керемет адам
Dialogue: 0,0:00:56.37,0:00:59.20,JP-SUB,,0000,0000,0000,,Бұл соңғы...
Dialogue: 0,0:00:59.59,0:01:01.40,JP-SUB,,0000,0000,0000,,Бірінші курс 10-сынып Цукуба
Dialogue: 0,0:01:04.79,0:01:07.89,JP-SUB,,0000,0000,0000,,Неліктен барлығы әдеттегі сыныпта?
Dialogue: 0,0:01:08.16,0:01:09.49,JP-SUB,,0000,0000,0000,,Сіз бүгін осындасыз ба?
Dialogue: 0,0:01:11.78,0:01:14.11,JP-SUB,,0000,0000,0000,,Келгеніңізге рахмет, Ханано-сан.
Dialogue: 0,0:01:17.09,0:01:17.67,JP-SUB,,0000,0000,0000,,Рахмет
Dialogue: 0,0:01:22.93,0:01:27.13,JP-SUB-uta,,0000,0000,0000,,…суппен дымқыл
Dialogue: 0,0:01:27.92,0:01:33.73,JP-SUB-uta,,0000,0000,0000,,Хана но Ироха Уцури мен Керина Итазура емес...
Dialogue: 0,0:01:29.51,0:01:31.14,JP-SUB-T,,0000,0000,0000,,А, мен мұны түсінемін.
Dialogue: 0,0:01:36.77,0:01:39.67,JP-SUB,,0000,0000,0000,,Енді бірінші рет алғаныңызға қуанған боларсыз.
Dialogue: 0,0:01:40.45,0:01:43.13,JP-SUB,,0000,0000,0000,,Мен оны тезірек және тезірек алғым келеді, Сумире-чан.
Dialogue: 0,0:01:44.92,0:01:49.90,JP-SUB,,0000,0000,0000,,Мен...түсіндім. Оң қол. Тек оң қолың жақсы.
Dialogue: 0,0:01:47.97,0:01:49.85,JP-SUB-T,,0000,0000,0000,,Эй... тоқташы өтінемін.
Dialogue: 0,0:01:50.18,0:01:51.31,JP-SUB,,0000,0000,0000,,Мен саған айттым.
Dialogue: 0,0:01:51.54,0:01:52.89,JP-SUB,,0000,0000,0000,,Мен карута ойыншысы емеспін
Dialogue: 0,0:01:52.92,0:01:55.34,JP-SUB,,0000,0000,0000,,Үйірмеге Машима-сенпаймен бірге болғым келгендіктен қосылдым...
Dialogue: 0,0:01:56.26,0:02:00.22,JP-SUB,,0000,0000,0000,,Жоқ... Жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:02:00.35,0:02:01.12,JP-SUB,,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:02:01.92,0:02:02.61,JP-SUB,,0000,0000,0000,,Сумире-чан
Dialogue: 0,0:02:02.72,0:02:04.57,JP-SUB,,0000,0000,0000,,Хаясе, жетеді.
Dialogue: 0,0:02:05.02,0:02:07.40,JP-SUB,,0000,0000,0000,,Ол карута ойнағысы келмейтінін анық айтты.
Dialogue: 0,0:02:07.79,0:02:08.65,JP-SUB,,0000,0000,0000,,Оны жайына қалдырайық
Dialogue: 0,0:02:10.94,0:02:14.77,JP-SUB,,0000,0000,0000,,Мен құлап, өткен жылы ұлттық турнирден бас тартқаннан бері.
Dialogue: 0,0:02:15.58,0:02:18.90,JP-SUB,,0000,0000,0000,,Күн сайын клубтың басқа мүшесі болса екен деп тілеймін.
Dialogue: 0,0:02:22.88,0:02:23.82,JP-SUB,,0000,0000,0000,,Ол ақыры келді
Dialogue: 0,0:02:25.39,0:02:26.64,JP-SUB,,0000,0000,0000,,Олардың екеуі де қалды.
Dialogue: 0,0:02:30.01,0:02:31.08,JP-SUB,,0000,0000,0000,,Мені ешқашан жалғыз қалдырмаңыз
Dialogue: 0,0:02:31.67,0:02:36.39,JP-SUB,,0000,0000,0000,,Кеше Ханано мырза маған Хякунин Исшу - бұл махаббат әндері екенін айтқан кезде.
Dialogue: 0,0:02:37.03,0:02:38.60,JP-SUB,,0000,0000,0000,,Мен бұл дұрыс деп ойладым.
Dialogue: 0,0:02:40.12,0:02:43.88,JP-SUB,,0000,0000,0000,,Адамдардың ойы бұрынғыдан қазіргі уақытқа дейін онша өзгерген жоқ.
Dialogue: 0,0:02:45.29,0:02:48.20,JP-SUB,,0000,0000,0000,,Бірақ Хякунин Исшу - танка.
Dialogue: 0,0:02:49.28,0:02:51.20,JP-SUB,,0000,0000,0000,,31 Дыбыс ережелерін сақта
Dialogue: 0,0:02:51.84,0:02:54.09,JP-SUB,,0000,0000,0000,,Өйткені ол ой мен технология негізінде жасалған
Dialogue: 0,0:02:54.42,0:02:55.80,JP-SUB,,0000,0000,0000,,Мың жыл қалды.
Dialogue: 0,0:02:57.87,0:03:00.57,JP-SUB,,0000,0000,0000,,«Қарым-қатынас» және «хабарласу» ережелерден асып түседі
Dialogue: 0,0:03:02.13,0:03:03.34,JP-SUB,,0000,0000,0000,,Бұрынғыдай сөздермен
Dialogue: 0,0:03:03.76,0:03:06.80,JP-SUB,,0000,0000,0000,,Ханано мырзаның шынайы сезімі менеджерге жеткізілді деп ойлайсыз ба?
Dialogue: 0,0:03:10.97,0:03:11.66,JP-SUB,,0000,0000,0000,,Ханано мырза
Dialogue: 0,0:03:14.26,0:03:16.74,JP-SUB,,0000,0000,0000,,Келесі жолы да маған тушь үйретіңізші.
Dialogue: 0,0:03:18.37,0:03:20.17,JP-SUB,,0000,0000,0000,,Өйткені менде үш ғана кірпік бар
Dialogue: 0,0:03:20.83,0:03:23.55,JP-SUB,,0000,0000,0000,,Тек үш кірпігі бар адам болмайды, солай ма?
Dialogue: 0,0:03:23.72,0:03:24.96,JP-SUB,,0000,0000,0000,,Маған бірдеңе көрсетіңізші
Dialogue: 0,0:03:32.22,0:03:32.77,JP-SUB,,0000,0000,0000,,Үш...
Dialogue: 0,0:03:33.33,0:03:34.08,JP-SUB,,0000,0000,0000,,Аздап
Dialogue: 0,0:03:34.57,0:03:37.89,JP-SUB,,0000,0000,0000,,Кешіріңіз, тіпті тушьмен болса да, үш - үш.
Dialogue: 0,0:03:38.06,0:03:40.21,JP-SUB,,0000,0000,0000,,Бұл General Mascara атын бұзады.
Dialogue: 0,0:03:41.43,0:03:44.02,JP-SUB,,0000,0000,0000,,Кана-чан, келесі клубтың белсенділік комитеті...
Dialogue: 0,0:03:44.22,0:03:44.64,JP-SUB,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:45.77,0:03:46.96,JP-SUB,,0000,0000,0000,,Құпиясы – жасанды кірпік
Dialogue: 0,0:05:08.02,0:05:08.75,JP-SUB,,0000,0000,0000,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:05:08.93,0:05:11.29,JP-SUB,,0000,0000,0000,,Джонни Деппке ұқсайтындықтан.
Dialogue: 0,0:05:11.34,0:05:12.67,JP-SUB,,0000,0000,0000,,Сіз тым абайсыздасыз.
Dialogue: 0,0:05:13.45,0:05:16.63,JP-SUB,,0000,0000,0000,,Бұл асыра сілтеу. Біреуге соқтығыссаңыз да мықты болуыңыз керек.
Dialogue: 0,0:05:16.96,0:05:20.00,JP-SUB,,0000,0000,0000,,Енді сені үйге апарудан басқа амалым жоқ.
Dialogue: 0,0:05:20.51,0:05:22.21,JP-SUB,,0000,0000,0000,,Сіздің үйіңіз қайда? Сіз ауруханаға барасыз ба?
Dialogue: 0,0:05:22.53,0:05:24.99,JP-SUB,,0000,0000,0000,,Адамдар мені Хёро-кун деп атайды, өйткені мен сымбаттымын.
Dialogue: 0,0:05:25.19,0:05:26.26,JP-SUB,,0000,0000,0000,,Сіз қай жерде тамақтанасыз?
Dialogue: 0,0:05:27.18,0:05:30.44,JP-SUB,,0000,0000,0000,,Өткен жылғы жеңімпаз мектептің кубогын қайтару
Dialogue: 0,0:05:34.04,0:05:37.27,JP-SUB,,0000,0000,0000,,Бірге күрескеннен кейін алған бірінші кубок
Dialogue: 0,0:05:38.46,0:05:41.27,JP-SUB,,0000,0000,0000,,Бұл қозғалыс қайта және бүкіл ел бойынша
Dialogue: 0,0:05:43.32,0:05:44.81,JP-SUB,,0000,0000,0000,,Менің келесі арманым Жапонияда бірінші болу.
Dialogue: 0,0:05:46.72,0:05:49.01,JP-SUB,,0000,0000,0000,,Иә, мен бірінші матчта серпін алғым келеді.
Dialogue: 0,0:05:49.95,0:05:52.31,JP-SUB,,0000,0000,0000,,Менің ойымша, Комано жасаған бұл бұйрық жақсы болады.
Dialogue: 0,0:05:52.75,0:05:53.43,JP-SUB,,0000,0000,0000,,That's right.
Dialogue: 0,0:05:53.86,0:05:54.63,JP-SUB,,0000,0000,0000,,Жарайды
Dialogue: 0,0:05:55.16,0:05:57.92,JP-SUB,,0000,0000,0000,,А, мен оны әкімшіге жіберемін.
Dialogue: 0,0:05:58.47,0:05:59.55,JP-SUB,,0000,0000,0000,,Рахмет
Dialogue: 0,0:06:08.37,0:06:09.17,JP-SUB,,0000,0000,0000,,Цукуба-кун?
Dialogue: 0,0:06:11.30,0:06:12.89,JP-SUB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:13.72,0:06:15.63,JP-SUB,,0000,0000,0000,,Бұйрықты қайта жазу мүмкін емес.
Dialogue: 0,0:06:15.83,0:06:17.43,JP-SUB,,0000,0000,0000,,Егер сізде шағымдар болса, оларды дауыстап айтыңыз.
Dialogue: 0,0:06:19.37,0:06:23.67,JP-SUB,,0000,0000,0000,,Себебі мен Комано-сенпайдан үш картаға дейін артта қалдым.
Dialogue: 0,0:06:23.84,0:06:25.86,JP-SUB,,0000,0000,0000,,Қабілеттік жағынан жетіп қалдым деп ойлаймын.
Dialogue: 0,0:06:26.14,0:06:26.88,JP-SUB,,0000,0000,0000,,Мен...
Dialogue: 0,0:06:31.28,0:06:32.08,JP-SUB,,0000,0000,0000,,Басыңызды суытыңыз
Dialogue: 0,0:06:33.26,0:06:34.12,JP-SUB,,0000,0000,0000,,Егер қолыңнан келмесе, үйге қайт.
Dialogue: 0,0:06:38.00,0:06:39.35,JP-SUB,,0000,0000,0000,,Тапсырысты қайта қарастырыңыз
Dialogue: 0,0:06:40.97,0:06:43.58,JP-SUB,,0000,0000,0000,,Бірінші Шурюқанда бір адамды ауыстырыңыз.
Dialogue: 0,0:06:43.96,0:06:46.34,JP-SUB,,0000,0000,0000,,Менің орнымда Сумире Ханано
Dialogue: 0,0:06:46.94,0:06:47.44,JP-SUB,,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:06:47.53,0:06:48.08,JP-SUB,,0000,0000,0000,,Е! ?
Dialogue: 0,0:06:48.58,0:06:50.87,JP-SUB,,0000,0000,0000,,Сонымен, Ниши орта мектебіне қарсы екінші ойын болды
Dialogue: 0,0:06:51.28,0:06:53.50,JP-SUB,,0000,0000,0000,,Кана-чанның орнына Акихиро Цукуба
Dialogue: 0,0:06:53.83,0:06:54.06,JP-SUB,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:55.16,0:06:58.53,JP-SUB,,0000,0000,0000,,Ауыстырылмаған үш ойыншы барлық ойындарды бірдей ойнайды.
Dialogue: 0,0:06:59.71,0:07:04.78,JP-SUB,,0000,0000,0000,,Машима ет тоқаш Аясе сұрады
Dialogue: 0,0:07:09.51,0:07:11.90,JP-SUB,,0000,0000,0000,,Кеттік, Мизусава орта мектебі
Dialogue: 0,0:07:12.57,0:07:13.76,JP-SUB-uta,,0000,0000,0000,,Егер сіз...
Dialogue: 0,0:07:13.89,0:07:14.76,JP-SUB-uta,,0000,0000,0000,,Ал...
Dialogue: 0,0:07:14.83,0:07:15.53,JP-SUB-uta,,0000,0000,0000,,Хисаката…
Dialogue: 0,0:07:16.86,0:07:20.42,JP-SUB,,0000,0000,0000,,Мм, неге маған мүмкіндік бердіңіз?
Dialogue: 0,0:07:20.72,0:07:22.39,JP-SUB,,0000,0000,0000,,Тынш, дауысың қатты.
Dialogue: 0,0:07:23.91,0:07:26.08,JP-SUB,,0000,0000,0000,,Мен көп дөрекі сөздер айттым.
Dialogue: 0,0:07:31.04,0:07:31.98,JP-SUB,,0000,0000,0000,,Өйткені менде де бар.
Dialogue: 0,0:07:33.97,0:07:35.88,JP-SUB,,0000,0000,0000,,Өйткені маған мүмкіндік берілді
Dialogue: 0,0:07:38.00,0:07:38.97,JP-SUB,,0000,0000,0000,,Казукацу Мизусава
Dialogue: 0,0:07:39.38,0:07:40.29,JP-SUB,,0000,0000,0000,,Футакацу Мизусава
Dialogue: 0,0:07:40.98,0:07:42.04,JP-SUB,,0000,0000,0000,,Директор Машима да
Dialogue: 0,0:07:42.42,0:07:44.08,JP-SUB,,0000,0000,0000,,Жақсы Мизусава Микатсу
Dialogue: 0,0:07:44.66,0:07:45.63,JP-SUB,,0000,0000,0000,,Еттен жасалған тоқаш
Dialogue: 0,0:07:46.66,0:07:48.23,JP-SUB,,0000,0000,0000,,Бірінші курс студенттері болмаса
Dialogue: 0,0:07:48.67,0:07:51.15,JP-SUB,,0000,0000,0000,,Мен оның соншалықты күшті болмағанына сенімдімін.
Dialogue: 0,0:07:54.22,0:07:55.02,JP-SUB,,0000,0000,0000,,Сәлем Хёро
Dialogue: 0,0:07:56.44,0:07:57.55,JP-SUB,,0000,0000,0000,,Сіз не ойлап отырсыз?
Dialogue: 0,0:07:57.81,0:08:00.33,JP-SUB,,0000,0000,0000,,Ондағы тәртіп мен күткеннен мүлде басқаша.
Dialogue: 0,0:08:00.42,0:08:01.66,JP-SUB,,0000,0000,0000,,Сіз нені айтасыз? (Амакасу-кун, сабыр ет)
Dialogue: 0,0:08:01.85,0:08:03.92,JP-SUB,,0000,0000,0000,,Көріпкелдік кейде қате болуы мүмкін.
Dialogue: 0,0:08:04.20,0:08:06.13,JP-SUB,,0000,0000,0000,,Жаңа шықты ма деп ойлаймын.
Dialogue: 0,0:08:10.18,0:08:11.94,JP-SUB,,0000,0000,0000,,Энергияны үнемдеу дегеніміз не?
Dialogue: 0,0:08:12.02,0:08:12.53,JP-SUB,,0000,0000,0000,,Әй?
Dialogue: 0,0:08:13.26,0:08:15.53,JP-SUB,,0000,0000,0000,,Біз Хокуо академиясында емеспіз бе?
Dialogue: 0,0:08:16.70,0:08:18.30,JP-SUB,,0000,0000,0000,,Жалпы соққылар жалпы
Dialogue: 0,0:08:19.01,0:08:20.62,JP-SUB,,0000,0000,0000,,Генерал-адъютант генерал-адъютантпен соқтығысады.
Dialogue: 0,0:08:21.34,0:08:23.60,JP-SUB,,0000,0000,0000,,Егер мен ұтпасам ше?
Dialogue: 0,0:08:25.12,0:08:27.62,JP-SUB,,0000,0000,0000,,Хокуо Гакуэн Токиодағы ең мықты
Dialogue: 0,0:08:28.31,0:08:30.40,JP-SUB,,0000,0000,0000,,Бәрінен де соны көргім келеді.
Dialogue: 0,0:08:33.09,0:08:33.62,JP-SUB,,0000,0000,0000,,Мұғалім?
Dialogue: 0,0:08:34.00,0:08:36.43,JP-SUB,,0000,0000,0000,,Кешіріңіз, осындай жақын сәтте.
Dialogue: 0,0:08:37.35,0:08:40.55,JP-SUB,,0000,0000,0000,,Мен кеше ойға келдім, оны тез жасап, бірінші аяқтадым.
Dialogue: 0,0:08:41.55,0:08:43.79,JP-SUB,,0000,0000,0000,,Менің ойымша, бұл қозғалуды жеңілдетеді.
Dialogue: 0,0:08:47.27,0:08:47.82,JP-SUB,,0000,0000,0000,,Белдік
Dialogue: 0,0:08:48.04,0:08:49.11,JP-SUB,,0000,0000,0000,,Жылжыту оңай
Dialogue: 0,0:08:51.19,0:08:52.69,JP-SUB,,0000,0000,0000,,Өте керемет
Dialogue: 0,0:09:07.70,0:09:09.07,JP-SUB-uta,,0000,0000,0000,,Суминоэно...
Dialogue: 0,0:09:09.11,0:09:10.78,JP-SUB-uta,,0000,0000,0000,,Магпи...
Dialogue: 0,0:09:12.52,0:09:14.46,JP-SUB,,0000,0000,0000,,Менің сүйікті карталарымды қатарынан өткізіп алдым
Dialogue: 0,0:09:15.07,0:09:16.32,JP-SUB,,0000,0000,0000,,Мына қыз да әдемі көрінеді.
Dialogue: 0,0:09:16.57,0:09:18.34,JP-SUB-uta,,0000,0000,0000,,Цукимиге қарасаңыз...
Dialogue: 0,0:09:19.25,0:09:22.62,JP-SUB,,0000,0000,0000,,Хёро, сен неге біртүрлі әрекет жасайсың?
Dialogue: 0,0:09:23.66,0:09:25.29,JP-SUB-uta,,0000,0000,0000,,Чихаябуру…
Dialogue: 0,0:09:25.77,0:09:27.79,JP-SUB,,0000,0000,0000,,Төртеуі де алды.
Dialogue: 0,0:09:28.59,0:09:31.41,JP-SUB,,0000,0000,0000,,Жоқ, өйткені «Чигирики» әлі оқылмаған.
Dialogue: 0,0:09:31.82,0:09:32.51,JP-SUB,,0000,0000,0000,,Мен сені қоршаймын...
Dialogue: 0,0:09:33.04,0:09:34.51,JP-SUB,,0000,0000,0000,,Мен бірінші болып қол тигіздім.
Dialogue: 0,0:09:35.14,0:09:37.68,JP-SUB,,0000,0000,0000,,Осылай бұрылып, осы саңылаудан өтіңіз, солай ма?
Dialogue: 0,0:09:38.20,0:09:39.31,JP-SUB,,0000,0000,0000,,Китао Иккацу
Dialogue: 0,0:09:41.24,0:09:43.12,JP-SUB,,0000,0000,0000,,Ет тоқаштары шоқ болып жоғалды ма?
Dialogue: 0,0:09:45.97,0:09:47.74,JP-SUB-uta,,0000,0000,0000,,Мичинокуно…
Dialogue: 0,0:09:51.84,0:09:54.90,JP-SUB,,0000,0000,0000,,Мм, «Асабо» солға жылжиды.
Dialogue: 0,0:09:58.17,0:09:59.47,JP-SUB,,0000,0000,0000,,Солақайларға қарсы шаралар?
Dialogue: 0,0:10:00.23,0:10:01.98,JP-SUB,,0000,0000,0000,,«Акино» солға жылжу
Dialogue: 0,0:10:02.58,0:10:04.25,JP-SUB,,0000,0000,0000,,Аа, кешіріңіз, мен оны бәрібір қайтарамын.
Dialogue: 0,0:10:04.82,0:10:07.39,JP-SUB,,0000,0000,0000,,Жоқ, олай емес. Бұл жігіттер...
Dialogue: 0,0:10:07.59,0:10:09.14,JP-SUB,,0000,0000,0000,,Кана-чанға тег жіберілгенше күтіңіз.
Dialogue: 0,0:10:09.24,0:10:10.30,JP-SUB,,0000,0000,0000,,Оны қазір жібермеңіз.
Dialogue: 0,0:10:14.74,0:10:16.18,JP-SUB,,0000,0000,0000,,Мен «Асабо» жіберемін
Dialogue: 0,0:10:18.72,0:10:19.61,JP-SUB,,0000,0000,0000,,(Тодороки) Камино… (Камино) Жарайды, алдым.
Dialogue: 0,0:10:22.12,0:10:23.07,JP-SUB,,0000,0000,0000,,Солтүстік Орталық...
Dialogue: 0,0:10:24.89,0:10:26.49,JP-SUB,,0000,0000,0000,,Шоттарды сұрыптау аяқталды.
Dialogue: 0,0:10:28.45,0:10:28.73,JP-SUB,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:30.92,0:10:31.66,JP-SUB,,0000,0000,0000,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:10:32.80,0:10:35.33,JP-SUB,,0000,0000,0000,,Үш ойында жеңіске жету қиынға соғатын жерде біз қазір қолайсыз ба?
Dialogue: 0,0:10:36.23,0:10:39.13,JP-SUB,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:10:46.12,0:10:47.59,JP-SUB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:48.85,0:10:50.60,JP-SUB,,0000,0000,0000,,Жаудың «Асабаракеасы» оқылғанда
Dialogue: 0,0:10:50.96,0:10:51.97,JP-SUB,,0000,0000,0000,,Чихая шығып кетеді
Dialogue: 0,0:10:53.30,0:10:54.27,JP-SUB,,0000,0000,0000,,«Акино» оқығанда
Dialogue: 0,0:10:54.79,0:10:56.13,JP-SUB,,0000,0000,0000,,Мен жау лагерін шығарамын
Dialogue: 0,0:10:58.05,0:10:59.31,JP-SUB,,0000,0000,0000,,Барлығы саған қызғанышпен қарайды,
Dialogue: 0,0:11:00.36,0:11:01.66,JP-SUB,,0000,0000,0000,,Мизусаваның үш жеңісі, чемпиондық
Dialogue: 0,0:11:05.02,0:11:11.16,JP-SUB-uta,,0000,0000,0000,,Суық желде қол бұлғаған өрмекші Таэмадан...
Dialogue: 0,0:11:12.81,0:11:13.90,JP-SUB,,0000,0000,0000,,Қолда...
Dialogue: 0,0:11:17.32,0:11:18.57,JP-SUB,,0000,0000,0000,,Казукацу Мизусава
Dialogue: 0,0:11:23.87,0:11:24.76,JP-SUB,,0000,0000,0000,,Амакасу
Dialogue: 0,0:11:26.41,0:11:27.53,JP-SUB,,0000,0000,0000,,Аманосу Сақ болыңыз
Dialogue: 0,0:11:28.88,0:11:29.87,JP-SUB,,0000,0000,0000,,Мұндай жағдайда
Dialogue: 0,0:11:30.26,0:11:38.41,JP-SUB-uta,,0000,0000,0000,,…Көлеңкеде ағып кетеді
Dialogue: 0,0:11:35.85,0:11:37.63,JP-SUB,,0000,0000,0000,,Бос болып қалатын адамдар бар.
Dialogue: 0,0:11:39.55,0:11:45.08,JP-SUB-uta,,0000,0000,0000,,Мен Ариаке но Цукиді көргенде...
Dialogue: 0,0:11:49.09,0:11:52.02,JP-SUB,,0000,0000,0000,,Аясе сен қазір оянуың керек деп ойлаймын.
Dialogue: 0,0:11:52.20,0:11:55.06,JP-SUB,,0000,0000,0000,,Иә, жабылу салтанаты басталғалы жатыр.
Dialogue: 0,0:11:55.52,0:11:57.04,JP-SUB,,0000,0000,0000,,Барлығын кешіріңіз
Dialogue: 0,0:11:57.51,0:11:59.01,JP-SUB,,0000,0000,0000,,Құнсыз адам сияқтымын.
Dialogue: 0,0:11:59.33,0:12:00.75,JP-SUB,,0000,0000,0000,,Бірінші жеңілді
Dialogue: 0,0:12:03.37,0:12:04.03,JP-SUB,,0000,0000,0000,,Чихая
Dialogue: 0,0:12:06.35,0:12:08.92,JP-SUB,,0000,0000,0000,,Бұл... қызық болды.
Dialogue: 0,0:12:10.42,0:12:13.44,JP-SUB,,0000,0000,0000,,Бұл мен үшін ең қызық болды.
Dialogue: 0,0:12:22.66,0:12:24.02,JP-SUB,,0000,0000,0000,,Осы екінші маусымда
Dialogue: 0,0:12:24.32,0:12:26.72,JP-SUB,,0000,0000,0000,,Барлығымызды толғандыратын үлкен мәселе туындады.
Dialogue: 0,0:12:27.33,0:12:28.33,JP-SUB,,0000,0000,0000,,Біздің білуімізше
Dialogue: 0,0:12:29.11,0:12:33.08,JP-SUB,,0000,0000,0000,,Менің әпкем мен Хёроның жалғыз жігіті мен қызы бар.
Dialogue: 0,0:12:33.41,0:12:35.33,JP-SUB,,0000,0000,0000,,Бірақ бұл жалғыз ма, білмеймін.
Dialogue: 0,0:12:36.23,0:12:36.71,JP-SUB,,0000,0000,0000,,Ол?
Dialogue: 0,0:12:37.01,0:12:37.65,JP-SUB,,0000,0000,0000,,Көп
Dialogue: 0,0:12:37.73,0:12:39.22,JP-SUB,,0000,0000,0000,,Онда... көп...
Dialogue: 0,0:12:39.11,0:12:40.65,JP-SUB-T,,0000,0000,0000,,Өзін-өзі есеп беру дұрыс емес.
Dialogue: 0,0:12:40.74,0:12:41.32,JP-SUB,,0000,0000,0000,,Мен...
Dialogue: 0,0:12:41.38,0:12:43.51,JP-SUB,,0000,0000,0000,,Жарайды, өйткені патшайымды сұрамай-ақ түсінуге болады.
Dialogue: 0,0:12:43.97,0:12:46.77,JP-SUB,,0000,0000,0000,,Көбінесе біз Карутаны тым көп ойнаймыз.
Dialogue: 0,0:12:47.02,0:12:49.42,JP-SUB,,0000,0000,0000,,Маджима және басқалар көп нәрсені мойындаған болуы керек.
Dialogue: 0,0:12:49.67,0:12:51.93,JP-SUB,,0000,0000,0000,,Сені жақсы көремін деген қызбен кездесуге болмайды.
Dialogue: 0,0:12:52.29,0:12:54.75,JP-SUB,,0000,0000,0000,,Бұл адам маңызды нәрселерге жеңіл қарайды
Dialogue: 0,0:12:54.92,0:12:56.52,JP-SUB,,0000,0000,0000,,Ауыр болып көрінсе де
Dialogue: 0,0:12:58.37,0:13:00.40,JP-SUB,,0000,0000,0000,,Бірақ танысу әрқашан көңілді бола бермейді.
Dialogue: 0,0:13:00.76,0:13:02.86,JP-SUB,,0000,0000,0000,,Әй, тәжірибелі адамның еркіндігі.
Dialogue: 0,0:13:03.11,0:13:04.62,JP-SUB,,0000,0000,0000,,Не? Мен Херомен бір жерде тұрмын ба?
Dialogue: 0,0:13:05.31,0:13:07.99,JP-SUB,,0000,0000,0000,,Бірақ егер мен біреумен кездесетін болсам, маған карутаға жақсы адам керек.
Dialogue: 0,0:13:09.07,0:13:13.03,JP-SUB,,0000,0000,0000,,Мен кимоно кие алатын адамды қалаймын.
Dialogue: 0,0:13:14.49,0:13:15.67,JP-SUB,,0000,0000,0000,,Цукуба Жаттығу жасайық
Dialogue: 0,0:13:15.81,0:13:16.04,JP-SUB,,0000,0000,0000,,Иә
Dialogue: 0,0:13:16.17,0:13:18.14,JP-SUB,,0000,0000,0000,,Кимоно Оэ кимоно киіну сабағын өткізді, солай ма?
Dialogue: 0,0:13:18.34,0:13:19.66,JP-SUB,,0000,0000,0000,,Деск-кун, мен сенімен барамын.
Dialogue: 0,0:13:21.09,0:13:21.32,JP-SUB,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:22.07,0:13:25.52,JP-SUB,,0000,0000,0000,,Ех! ? Цукуба шынымен де негізгі құрамда. Керемет.
Dialogue: 0,0:13:26.77,0:13:27.53,JP-SUB,,0000,0000,0000,,Бастапқы құрам…
Dialogue: 0,0:13:28.15,0:13:29.63,JP-SUB,,0000,0000,0000,,Блок лотереясы кеше болды.
Dialogue: 0,0:13:30.25,0:13:33.37,JP-SUB,,0000,0000,0000,,Бірінші турға тапсырыс Команомен талқыланып, ұсынылды.
Dialogue: 0,0:13:33.84,0:13:37.10,JP-SUB,,0000,0000,0000,,Неліктен Комано-сенпай негізгі құрамда...
Dialogue: 0,0:13:38.40,0:13:40.05,JP-SUB,,0000,0000,0000,,Токио іріктеуден кейін бір айдан кейін
Dialogue: 0,0:13:40.83,0:13:42.26,JP-SUB,,0000,0000,0000,,Цукуба көп жұмыс жасады
Dialogue: 0,0:13:42.95,0:13:44.67,JP-SUB,,0000,0000,0000,,Сенің қабілетің менікінен еш айырмашылығы жоқ.
Dialogue: 0,0:13:45.53,0:13:48.34,JP-SUB,,0000,0000,0000,,Ең бастысы, біздің мақсатымыз Жапонияда бірінші орынға шығу.
Dialogue: 0,0:13:49.29,0:13:50.64,JP-SUB,,0000,0000,0000,,Екі блоктық сәйкестіктер арасында
Dialogue: 0,0:13:51.09,0:13:53.62,JP-SUB,,0000,0000,0000,,Мен басқа күшті мектептерді зерттеуге назар аудардым.
Dialogue: 0,0:13:54.04,0:13:55.45,JP-SUB,,0000,0000,0000,,Қорытынды турнирге дайындық
Dialogue: 0,0:13:56.17,0:13:57.50,JP-SUB,,0000,0000,0000,,Бесеуміз жеңеміз.
Dialogue: 0,0:14:01.78,0:14:04.11,JP-SUB,,0000,0000,0000,,Бұл оның бір іріктеу матчында да ойнамайтынын білдіре ме?
Dialogue: 0,0:14:04.60,0:14:05.81,JP-SUB,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,0:14:06.26,0:14:06.64,JP-SUB,,0000,0000,0000,,О
Dialogue: 0,0:14:07.09,0:14:08.70,JP-SUB-uta,,0000,0000,0000,,Мен оны пайдалана аламын...
Dialogue: 0,0:14:12.56,0:14:13.50,JP-SUB,,0000,0000,0000,,Ет тоқаш
Dialogue: 0,0:14:14.50,0:14:16.32,JP-SUB,,0000,0000,0000,,Сіз не істеп жатырсыз? Мен сені іздедім.
Dialogue: 0,0:14:16.98,0:14:18.84,JP-SUB,,0000,0000,0000,,Ойын басталғалы тұр, тез.
Dialogue: 0,0:14:19.81,0:14:22.46,JP-SUB,,0000,0000,0000,,Тек ет тоқаштарында стратегиялық кездесулерге уақыт жоқ.
Dialogue: 0,0:14:23.64,0:14:26.77,JP-SUB,,0000,0000,0000,,Бірақ мен оны асхана деп ешқашан ойламадым. Мен үш түскі ас қорапшасын сатып алдым.
Dialogue: 0,0:14:27.41,0:14:30.30,JP-SUB,,0000,0000,0000,,Аа, мен алдын ала кезеңдегідей негізгі құраммен баруды шештім.
Dialogue: 0,0:14:33.45,0:14:36.31,JP-SUB,,0000,0000,0000,,Финалдық турнирге шыққан командалар ішке кіруі керек.
Dialogue: 0,0:14:36.96,0:14:40.12,JP-SUB,,0000,0000,0000,,Не? Матчқа барғыңыз келмейтініне сенімдісіз бе?
Dialogue: 0,0:14:40.59,0:14:41.33,JP-SUB,,0000,0000,0000,,Ет тоқаш
Dialogue: 0,0:14:41.97,0:14:43.98,JP-SUB,,0000,0000,0000,,Кавабеге қарсы ойнағанда да сабырлы болыңыз
Dialogue: 0,0:14:44.49,0:14:45.23,JP-SUB,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:14:46.67,0:14:48.22,JP-SUB,,0000,0000,0000,,Мен жай ғана болжап отырмын
Dialogue: 0,0:14:52.00,0:14:52.84,JP-SUB,,0000,0000,0000,,Жылдам енгізіңіз
Dialogue: 0,0:14:53.35,0:14:54.51,JP-SUB,,0000,0000,0000,,Жоқ, мен...
Dialogue: 0,0:14:57.26,0:14:58.38,JP-SUB,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:14:59.50,0:15:01.45,JP-SUB-uta,,0000,0000,0000,,Нацуноёха...
Dialogue: 0,0:15:02.61,0:15:03.15,JP-SUB,,0000,0000,0000,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:15:04.06,0:15:05.90,JP-SUB,,0000,0000,0000,,Мен кейде шығып тұратын жылдам таңдауларға ілесе алмаймын.
Dialogue: 0,0:15:06.98,0:15:08.01,JP-SUB,,0000,0000,0000,,Менің қолымнан келмейді
Dialogue: 0,0:15:08.67,0:15:11.10,JP-SUB,,0000,0000,0000,,Күшті Бұл өзен жағасындағы нәрсе
Dialogue: 0,0:15:12.65,0:15:13.42,JP-SUB,,0000,0000,0000,,Кавабе...?
Dialogue: 0,0:15:14.06,0:15:15.63,JP-SUB,,0000,0000,0000,,Мен жай ғана болжап отырмын
Dialogue: 0,0:15:18.15,0:15:20.06,JP-SUB,,0000,0000,0000,,Мен жеңдім. Мизусава жеңді.
Dialogue: 0,0:15:22.76,0:15:23.85,JP-SUB,,0000,0000,0000,,Мен келесі жолы сонда боламын.
Dialogue: 0,0:15:25.97,0:15:27.13,JP-SUB,,0000,0000,0000,,Мен келесі жолы сонда боламын.
Dialogue: 0,0:15:27.43,0:15:29.43,JP-SUB,,0000,0000,0000,,Мен сенімен барамын, деск-кун.
Dialogue: 0,0:15:32.46,0:15:38.90,JP-SUB-uta,,0000,0000,0000,,Мегуриахит Мишия немесе Ваканумани...
Dialogue: 0,0:15:41.81,0:15:43.30,JP-SUB,,0000,0000,0000,,«Мегуриахит» маңызды болды
Dialogue: 0,0:15:44.18,0:15:45.05,JP-SUB,,0000,0000,0000,,Түсінбедім
Dialogue: 0,0:15:45.76,0:15:48.25,JP-SUB,,0000,0000,0000,,Бұл Батыстың өкілі
Dialogue: 0,0:15:49.89,0:15:50.49,JP-SUB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:15:52.03,0:15:56.85,JP-SUB,,0000,0000,0000,,жылдамдығын сол іріктеу күнінен де жақсартқан ханшайым кандидаты
Dialogue: 0,0:15:58.23,0:16:00.16,JP-SUB-uta,,0000,0000,0000,,Суминоэно...
Dialogue: 0,0:16:00.44,0:16:02.59,JP-SUB-uta,,0000,0000,0000,,Аразараму…
Dialogue: 0,0:16:02.65,0:16:08.07,JP-SUB-uta,,0000,0000,0000,,Сені сақтайтын өмірге...
Dialogue: 0,0:16:08.87,0:16:09.43,JP-SUB,,0000,0000,0000,,Эму
Dialogue: 0,0:16:11.19,0:16:11.86,JP-SUB,,0000,0000,0000,,Соғу
Dialogue: 0,0:16:13.26,0:16:15.70,JP-SUB,,0000,0000,0000,,Мен жеңсем бәрі бақытты болады
Dialogue: 0,0:16:17.16,0:16:19.45,JP-SUB,,0000,0000,0000,,Сіз осы жерге келдіңіз
Dialogue: 0,0:16:19.74,0:16:21.67,JP-SUB-uta,,0000,0000,0000,,Цукимиге қарасаңыз...
Dialogue: 0,0:16:23.50,0:16:24.01,JP-SUB,,0000,0000,0000,,Сол жігіт
Dialogue: 0,0:16:25.04,0:16:27.70,JP-SUB,,0000,0000,0000,,Ол соншалықты жылдам карута ойнайтын жігіт пе еді?
Dialogue: 0,0:16:29.73,0:16:30.71,JP-SUB,,0000,0000,0000,,Эму-чан
Dialogue: 0,0:16:31.79,0:16:33.09,JP-SUB,,0000,0000,0000,,Эму-чан менмін
Dialogue: 0,0:16:34.76,0:16:36.56,JP-SUB,,0000,0000,0000,,Оны тым жылдам қабылдауды тоқтатыңыз
Dialogue: 0,0:16:39.72,0:16:42.01,JP-SUB,,0000,0000,0000,,Маған бұлай айтатын ешкім болмады.
Dialogue: 0,0:16:42.81,0:16:45.60,JP-SUB,,0000,0000,0000,,Эму Біріншіден, мен жеңемін.
Dialogue: 0,0:16:46.40,0:16:47.98,JP-SUB,,0000,0000,0000,,Сіз шыдамсыз болуыңыз мүмкін.
Dialogue: 0,0:16:49.37,0:16:49.89,JP-SUB,,0000,0000,0000,,Жарайды
Dialogue: 0,0:16:50.89,0:16:53.17,JP-SUB,,0000,0000,0000,,Осы жерден Мизусаваға шабуыл жасайық
Dialogue: 0,0:16:53.54,0:16:54.36,JP-SUB,,0000,0000,0000,,О!
Dialogue: 0,0:16:54.64,0:16:56.16,JP-SUB,,0000,0000,0000,,Бір бөлік...
Dialogue: 0,0:16:55.52,0:16:56.00,JP-SUB-T,,0000,0000,0000,,Бір бөлік!
Dialogue: 0,0:16:56.52,0:16:57.65,JP-SUB,,0000,0000,0000,,Мен біреуін аламын.
Dialogue: 0,0:16:58.40,0:16:59.06,JP-SUB,,0000,0000,0000,,Иә
Dialogue: 0,0:17:03.27,0:17:06.25,JP-SUB,,0000,0000,0000,,Сен мен үшін ұлсың
Dialogue: 0,0:17:07.94,0:17:10.09,JP-SUB,,0000,0000,0000,,Сіз Эмудан әлсізсіз
Dialogue: 0,0:17:10.97,0:17:14.12,JP-SUB,,0000,0000,0000,,Жарайды, мен жеңдім. Акаши Даиичи әйелдердің жеңісі
Dialogue: 0,0:17:15.71,0:17:17.52,JP-SUB-uta,,0000,0000,0000,,Күлгін...
Dialogue: 0,0:17:18.39,0:17:18.99,JP-SUB,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:17:19.80,0:17:21.51,JP-SUB,,0000,0000,0000,,Мегуми «му» болғанша алынды
Dialogue: 0,0:17:21.87,0:17:23.42,JP-SUB,,0000,0000,0000,,Иккацу Пизусава (Мизусава)
Dialogue: 0,0:17:26.12,0:17:28.00,JP-SUB,,0000,0000,0000,,«su» және «mu» екеуі де алынып тасталды.
Dialogue: 0,0:17:29.08,0:17:31.04,JP-SUB,,0000,0000,0000,,Бұл баланың жылдамдығы шынайы
Dialogue: 0,0:17:32.64,0:17:36.63,JP-SUB,,0000,0000,0000,,Бұл бала Чихая Аясе
Dialogue: 0,0:17:37.73,0:17:39.58,JP-SUB-uta,,0000,0000,0000,,Чихаябуру…
Dialogue: 0,0:17:39.66,0:17:40.19,JP-SUB,,0000,0000,0000,,Бұл қандай жаман иіс?
Dialogue: 0,0:17:40.28,0:17:41.35,JP-SUB,,0000,0000,0000,,Футакацу Мизусава
Dialogue: 0,0:17:44.61,0:17:46.27,JP-SUB,,0000,0000,0000,,Акаши Даиичи әйелдер арасындағы 2 жеңіс
Dialogue: 0,0:17:47.38,0:17:48.46,JP-SUB,,0000,0000,0000,,Футакацу Мизусава
Dialogue: 0,0:17:51.96,0:17:52.68,JP-SUB,,0000,0000,0000,,Деск-кун
Dialogue: 0,0:17:57.33,0:18:01.09,JP-SUB,,0000,0000,0000,,Қарсыласы – «Арима», ал Команоның тағдырлы шайқаста «Нагеки» бар.
Dialogue: 0,0:18:02.81,0:18:04.95,JP-SUB,,0000,0000,0000,,Тағы 4 бос карта қалды
Dialogue: 0,0:18:05.70,0:18:07.25,JP-SUB-uta,,0000,0000,0000,,Урамиваби…
Dialogue: 0,0:18:08.17,0:18:09.55,JP-SUB-uta,,0000,0000,0000,,Ханасасофу…
Dialogue: 0,0:18:10.59,0:18:16.65,JP-SUB-uta,,0000,0000,0000,,Шекараның тәтті жеңгелерінде де...
Dialogue: 0,0:18:12.07,0:18:13.05,JP-SUB-T,,0000,0000,0000,,Әлі шыққан жоқ.
Dialogue: 0,0:18:17.53,0:18:18.37,JP-SUB,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:18:21.65,0:18:22.13,JP-SUB,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:18:23.14,0:18:24.34,JP-SUB,,0000,0000,0000,,Соңғы матч
Dialogue: 0,0:18:25.24,0:18:26.38,JP-SUB,,0000,0000,0000,,Шайқастың ауыртпалығы
Dialogue: 0,0:18:27.92,0:18:34.26,JP-SUB-uta,,0000,0000,0000,,Нағиса Когу үңгірдің ішінде ылғи күреседі...
Dialogue: 0,0:18:31.68,0:18:33.90,JP-SUB-T,,0000,0000,0000,,Комано Түсінесіз бе?
Dialogue: 0,0:18:34.92,0:18:36.03,JP-SUB,,0000,0000,0000,,Енді бос карталар жоқ
Dialogue: 0,0:18:37.29,0:18:40.33,JP-SUB,,0000,0000,0000,,Келесі заң жобасымен анықталады
Dialogue: 0,0:18:42.97,0:18:43.62,JP-SUB,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:18:45.79,0:18:46.15,JP-SUB,,0000,0000,0000,,Бірақ
Dialogue: 0,0:18:46.52,0:18:54.33,JP-SUB-uta,,0000,0000,0000,,…
Dialogue: 0,0:18:54.88,0:18:56.32,JP-SUB,,0000,0000,0000,,Маған кім көмектеседі?
Dialogue: 0,0:18:57.59,0:18:59.52,JP-SUB-uta,,0000,0000,0000,,Көптеген...
Dialogue: 0,0:19:05.62,0:19:06.27,JP-SUB,,0000,0000,0000,,Деск-кун
Dialogue: 0,0:19:08.28,0:19:09.05,JP-SUB,,0000,0000,0000,,Деск-кун
Dialogue: 0,0:19:09.99,0:19:13.89,JP-SUB,,0000,0000,0000,,Мизусава орта мектебі 3 жеңіс, Акаши Даиичи қыздары 2 жеңіс
Dialogue: 0,0:19:14.48,0:19:16.11,JP-SUB,,0000,0000,0000,,Мизусава орта мектебінің жеңісі
Dialogue: 0,0:19:16.93,0:19:17.71,JP-SUB,,0000,0000,0000,,Хёрокун
Dialogue: 0,0:19:19.95,0:19:23.24,JP-SUB,,0000,0000,0000,,Ватая-кун, мен сені қолдамаймын.
Dialogue: 0,0:19:24.29,0:19:27.52,JP-SUB,,0000,0000,0000,,Маджима мен Чихая Жапонияда үздік атану үшін күреседі
Dialogue: 0,0:19:29.18,0:19:30.18,JP-SUB,,0000,0000,0000,,Хона Сайнара
Dialogue: 0,0:19:31.47,0:19:32.19,JP-SUB,,0000,0000,0000,,Шинобу-чан
Dialogue: 0,0:19:33.38,0:19:35.56,JP-SUB,,0000,0000,0000,,Кішкене болса да барып көргіңіз келе ме? Командалық жарыс
Dialogue: 0,0:19:36.33,0:19:37.78,JP-SUB,,0000,0000,0000,,Міндетті түрде жігерленетін бала бар.
Dialogue: 0,0:19:38.54,0:19:40.13,JP-SUB,,0000,0000,0000,,Мен шынымен де сараңмын
Dialogue: 0,0:19:41.07,0:19:41.76,JP-SUB,,0000,0000,0000,,Мен білемін, бірақ
Dialogue: 0,0:19:42.53,0:19:45.40,JP-SUB,,0000,0000,0000,,Королева болғаннан жақсы, Жапониядағы ең жақсы қыз болғаннан жақсы
Dialogue: 0,0:19:46.40,0:19:48.83,JP-SUB,,0000,0000,0000,,Жапонияда бірінші болу барлығына қиынырақ.
Dialogue: 0,0:19:59.33,0:19:59.92,JP-SUB,,0000,0000,0000,,Кеттік
Dialogue: 0,0:20:00.28,0:20:03.59,JP-SUB,,0000,0000,0000,,Мизусава күресі
Dialogue: 0,0:20:06.94,0:20:13.81,JP-SUB-uta,,0000,0000,0000,,Нанивадуни Сакуяконохана Фуюгомори
Dialogue: 0,0:20:15.31,0:20:21.78,JP-SUB-uta,,0000,0000,0000,,Има во Харубето Сакуяконохана
Dialogue: 0,0:20:20.23,0:20:21.34,JP-SUB-T,,0000,0000,0000,,Бұл сөзсіз басқаша.
Dialogue: 0,0:20:22.46,0:20:24.27,JP-SUB,,0000,0000,0000,,Толық уақытты оқырман осылай естіледі
Dialogue: 0,0:20:24.87,0:20:32.08,JP-SUB-uta,,0000,0000,0000,,Има во Харубето Сакуяконохана
Dialogue: 0,0:20:33.02,0:20:35.59,JP-SUB,,0000,0000,0000,,Бұл барлығына қарсы финалдық матч.
Dialogue: 0,0:22:06.03,0:22:08.99,JP-SUB,,0000,0000,0000,,Балалар, түсінбеген сияқтысыңдар, мен айтайын.
Dialogue: 0,0:22:09.82,0:22:11.25,JP-SUB,,0000,0000,0000,,Карута орта мектебінің біріншілігі
Dialogue: 0,0:22:11.53,0:22:14.16,JP-SUB,,0000,0000,0000,,Екі күнде барлығы 1000 студент қатысады.
Dialogue: 0,0:22:14.94,0:22:17.42,JP-SUB,,0000,0000,0000,,Операцияны шамамен 100 адам басқарады.
Dialogue: 0,0:22:18.25,0:22:20.63,JP-SUB,,0000,0000,0000,,Бүкіл жапондық Карута қауымдастығының офицерлері
Dialogue: 0,0:22:21.05,0:22:22.70,JP-SUB,,0000,0000,0000,,Жақын маңдағы Карута клубтарының адамдары
Dialogue: 0,0:22:23.31,0:22:25.35,JP-SUB,,0000,0000,0000,,Кансай университеттеріндегі Карута клубтарының мүшелері
Dialogue: 0,0:22:25.72,0:22:28.47,JP-SUB,,0000,0000,0000,,Оқырман төреші Татами шоттарды дайындауда және т.б.
Dialogue: 0,0:22:28.76,0:22:31.14,JP-SUB,,0000,0000,0000,,Ол сен үшін барын салуда.
Dialogue: 0,0:22:32.04,0:22:33.18,JP-SUB,,0000,0000,0000,,Есіңізде болсын
Dialogue: 0,0:22:33.45,0:22:36.33,JP-SUB,,0000,0000,0000,,Бұл адамдар әдетте A-деңгейі немесе супер-А спортшылары.
Dialogue: 0,0:22:37.04,0:22:38.46,JP-SUB,,0000,0000,0000,,Тіпті 10-дан сынып мұғалімі
Dialogue: 0,0:22:38.76,0:22:40.81,JP-SUB,,0000,0000,0000,,Сондай-ақ барлық уақыттағы ұлы ханшайымдар бар.
Dialogue: 0,0:22:41.30,0:22:41.96,JP-SUB,,0000,0000,0000,,Уг!?
Dialogue: 0,0:22:42.30,0:22:44.09,JP-SUB,,0000,0000,0000,,Түсінуді жеңілдету үшін Кошиеннің ұқсастығын қолданыңыз.
Dialogue: 0,0:03:54.88,0:04:02.05,Kamigami,,0000,0000,0000,,...
Dialogue: 0,0:03:54.88,0:04:02.05,Kamigami,,0000,0000,0000,,Субтитрлер жұбы
Dialogue: 0,0:04:04.22,0:04:08.18,staff,,0000,0000,0000,,...
Dialogue: 0,0:04:04.22,0:04:08.18,staff,,0000,0000,0000,,J O A N
Dialogue: 0,0:04:04.22,0:04:08.18,staff,,0000,0000,0000,,Суық жел
Dialogue: 0,0:04:08.89,0:04:12.69,staff,,0000,0000,0000,,Аударма
Dialogue: 0,0:04:08.89,0:04:12.69,staff,,0000,0000,0000,,...
Dialogue: 0,0:04:08.89,0:04:12.69,staff,,0000,0000,0000,,Бір түнде жауған жаңбыр
Dialogue: 0,0:04:13.52,0:04:17.52,staff,,0000,0000,0000,,...
Dialogue: 0,0:04:13.52,0:04:17.52,staff,,0000,0000,0000,,f l u f f y
Dialogue: 0,0:04:13.52,0:04:17.52,staff,,0000,0000,0000,,Жапон мектебі
Dialogue: 0,0:04:13.52,0:04:17.52,staff,,0000,0000,0000,,f l u f f y
Dialogue: 0,0:04:19.94,0:04:24.82,staff,,0000,0000,0000,,Жапондық жүйе
Dialogue: 0,0:04:19.94,0:04:24.82,staff,,0000,0000,0000,,Нацу
Dialogue: 0,0:04:19.94,0:04:24.82,staff,,0000,0000,0000,,уақыт
Dialogue: 0,0:04:19.94,0:04:24.82,staff,,0000,0000,0000,,...
Dialogue: 0,0:20:50.58,0:20:56.57,JP-ED,,0000,0000,0000,,Қызыл түске боялған еңіс
Dialogue: 0,0:20:57.01,0:21:03.34,JP-ED,,0000,0000,0000,,Тоқтап, тоқтап тұрған күндерде
Dialogue: 0,0:21:04.56,0:21:10.45,JP-ED,,0000,0000,0000,,Мұнда жоқ сені ойлап
Dialogue: 0,0:21:10.94,0:21:17.47,JP-ED,,0000,0000,0000,,Мен жоғалтатын жолды табуға тырысамын.
Dialogue: 0,0:21:17.97,0:21:21.50,JP-ED,,0000,0000,0000,,Қазір қай жерде болсаңыз да
Dialogue: 0,0:21:21.73,0:21:24.58,JP-ED,,0000,0000,0000,,Оны өзгерту мүмкін емес, солай ма?
Dialogue: 0,0:21:24.91,0:21:31.51,JP-ED,,0000,0000,0000,,Біздің жүрегіміз әрқашан байланысты
Dialogue: 0,0:21:31.92,0:21:35.69,JP-ED,,0000,0000,0000,,Алыста жүрсең де
Dialogue: 0,0:21:35.99,0:21:38.50,JP-ED,,0000,0000,0000,,Ұмытпа
Dialogue: 0,0:21:38.65,0:21:42.20,JP-ED,,0000,0000,0000,,Сол күні мен сезінген құштарлық
Dialogue: 0,0:21:42.38,0:21:46.28,JP-ED,,0000,0000,0000,,Бірге болған армандарымыз
Dialogue: 0,0:21:46.43,0:21:49.84,JP-ED,,0000,0000,0000,,Қып-қызыл аспан
Dialogue: 0,0:21:49.94,0:21:52.44,JP-ED,,0000,0000,0000,,Батып бара жатқан күн
Dialogue: 0,0:21:52.58,0:21:59.32,JP-ED,,0000,0000,0000,,Жүргенде басымызды тік ұстайық
Dialogue: 0,0:21:56.50,0:22:01.34,CN-ED,,0000,0000,0000,,Жапон субтитрлері www.kamigami.org
