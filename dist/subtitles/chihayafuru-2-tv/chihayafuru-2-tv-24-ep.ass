Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.79,0:00:05.79,Default,,0,0,0,,(Чихаяның жылағаны)
Dialogue: 0,0:00:08.04,0:00:10.80,Default,,0,0,0,,Бұл А класы, Тайчи.
Dialogue: 0,0:00:11.38,0:00:13.93,Default,,0,0,0,,Қарсылас Фудзисакидің үшінші курс студенті.
Dialogue: 0,0:00:14.01,0:00:15.68,Default,,0,0,0,,Жақсы орындады 3 карта
Dialogue: 0,0:00:16.85,0:00:19.26,Default,,0,0,0,,Бұл жартылай финал, жетеді.
Dialogue: 0,0:00:20.89,0:00:23.94,Default,,0,0,0,,Кел, кел, кел, кел, кел.
Dialogue: 0,0:00:24.02,0:00:26.48,Default,,0,0,0,,Оқитын бол Оқы
Dialogue: 0,0:00:26.56,0:00:28.27,Default,,0,0,0,,Шық, шық, шық, шық
Dialogue: 0,0:00:28.36,0:00:30.86,Default,,0,0,0,,Кел, кел, кел, кел!
Dialogue: 0,0:00:33.74,0:00:35.11,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:00:36.20,0:00:37.45,Default,,0,0,0,,Яй Тайчи
Dialogue: 0,0:00:39.20,0:00:40.95,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:00:41.04,0:00:45.58,Default,,0,0,0,,♪~
Dialogue: 0,0:01:45.89,0:01:50.90,Default,,0,0,0,,~♪
Dialogue: 0,0:01:51.61,0:01:56.61,Default,,0,0,0,,(Чихаяның жылағаны)
Dialogue: 0,0:01:58.78,0:01:59.91,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:01:59.99,0:02:02.08,Default,,0,0,0,,(Чихаяның жылағаны)
Dialogue: 0,0:02:02.16,0:02:04.16,Default,,0,0,0,,Чихая, жылама, оян.
Dialogue: 0,0:02:04.24,0:02:05.75,Default,,0,0,0,,Асықпасаң бітеді.
Dialogue: 0,0:02:08.58,0:02:09.87,Default,,0,0,0,,Ах... қазірдің өзінде
Dialogue: 0,0:02:11.58,0:02:14.21,Default,,0,0,0,,Ей, ақымақ, тыныш отыр.
Dialogue: 0,0:02:18.72,0:02:19.55,Default,,0,0,0,,Ах
Dialogue: 0,0:02:20.72,0:02:22.76,Default,,0,0,0,,Тайчи - А класы
Dialogue: 0,0:02:23.39,0:02:24.39,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:02:26.31,0:02:28.06,Default,,0,0,0,,Қарсылас!
Dialogue: 0,0:02:29.77,0:02:31.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:32.36,0:02:33.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:34.11,0:02:34.94,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:35.78,0:02:37.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:37.94,0:02:40.66,Default,,0,0,0,,Жоқ... баруға болады.
Dialogue: 0,0:02:40.74,0:02:42.66,Default,,0,0,0,,Біз сізді қолдаймыз
Dialogue: 0,0:02:42.74,0:02:44.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:44.74,0:02:47.91,Default,,0,0,0,,Мен капитанмын. Мизусава соңына дейін...
Dialogue: 0,0:02:49.08,0:02:50.42,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:50.50,0:02:52.17,Default,,0,0,0,,Кеттік Чихая (Чихая) Ах...
Dialogue: 0,0:02:55.75,0:02:57.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:57.92,0:02:59.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:03.85,0:03:05.51,Default,,0,0,0,,Ханано-сан (Сумире) Иә?
Dialogue: 0,0:03:05.60,0:03:08.06,Default,,0,0,0,,«Какуто Дани» жақсы ән, солай емес пе?
Dialogue: 0,0:03:08.14,0:03:09.64,Default,,0,0,0,,Не? «Какутодани»?
Dialogue: 0,0:03:09.73,0:03:12.35,Default,,0,0,0,,А, тыныш, ол қазірдің өзінде оқылып жатыр.
Dialogue: 0,0:03:13.94,0:03:16.44,Default,,0,0,0,,Ое-сенпай – біртүрлі адам.
Dialogue: 0,0:03:16.52,0:03:21.40,Default,,0,0,0,,Хякунин Исшуға кәмпит немесе дәрі сияқты «иә» деп айт.
Dialogue: 0,0:03:24.07,0:03:27.33,Default,,0,0,0,,«Сіз білмейсіз деп ойлаймын».
Dialogue: 0,0:03:27.41,0:03:31.66,Default,,0,0,0,,«Менің ойым оттай жанады»
Dialogue: 0,0:03:32.42,0:03:34.54,Default,,0,0,0,,Иә! Мен оны түсіндім!
Dialogue: 0,0:03:34.63,0:03:35.50,Default,,0,0,0,,Ах (Цукуба) Кеттік!
Dialogue: 0,0:03:35.59,0:03:37.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:37.09,0:03:38.92,Default,,0,0,0,,Жарайды! Тағы бір!
Dialogue: 0,0:03:39.01,0:03:40.01,Default,,0,0,0,,Иә!?
Dialogue: 0,0:03:40.92,0:03:43.76,Default,,0,0,0,,Цукуба D класындағы финалда ма?
Dialogue: 0,0:03:43.84,0:03:45.55,Default,,0,0,0,,Төрт қадам… бес қадам
Dialogue: 0,0:03:45.64,0:03:47.76,Default,,0,0,0,,Мен білмедім!
Dialogue: 0,0:03:51.14,0:03:52.56,Default,,0,0,0,,Иә
Dialogue: 0,0:03:53.81,0:03:58.90,Default,,0,0,0,,«Какутодани Эя Ибукидің қысқа шөптері»
Dialogue: 0,0:03:59.48,0:04:03.70,Default,,0,0,0,,«Менде көп ой бар».
Dialogue: 0,0:04:03.78,0:04:07.62,Default,,0,0,0,,Бірінші қабатта біздің матчта бос карталар тым аз болды.
Dialogue: 0,0:04:07.70,0:04:10.16,Default,,0,0,0,,Екінші қабатта әлі де бірнеше адам қалуы керек.
Dialogue: 0,0:04:10.25,0:04:12.33,Default,,0,0,0,,Ураясу бөлмесіне кіруге болады ма?
Dialogue: 0,0:04:12.41,0:04:16.96,Default,,0,0,0,,(Чихаяның жүрек соғысы)
Dialogue: 0,0:04:22.22,0:04:23.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:25.13,0:04:27.85,Default,,0,0,0,,Не болды? Чихая
Dialogue: 0,0:04:27.93,0:04:31.14,Default,,0,0,0,,Ақыр соңында, мен сізді төменгі қабатта қолдаймын.
Dialogue: 0,0:04:31.22,0:04:33.35,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың? Ах...
Dialogue: 0,0:04:33.94,0:04:35.35,Default,,0,0,0,,Бұл патшайым мен Арата арасындағы шайқас!
Dialogue: 0,0:04:35.44,0:04:37.52,Default,,0,0,0,,Оны көргің келмей ме?
Dialogue: 0,0:04:40.57,0:04:41.86,Default,,0,0,0,,Чихая...
Dialogue: 0,0:04:41.94,0:04:44.45,Default,,0,0,0,,(Чихаяның жүрек соғысы)
Dialogue: 0,0:04:44.53,0:04:45.74,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:46.86,0:04:50.66,Default,,0,0,0,,Көргім келді, неге?
Dialogue: 0,0:04:51.37,0:04:52.50,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:04:53.75,0:04:55.75,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:04:55.83,0:04:59.00,Default,,0,0,0,,А сыныбының финалында өте көп адам бар, мен тіпті кіре алмаймын.
Dialogue: 0,0:04:59.09,0:05:00.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:00.13,0:05:02.80,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:05:02.88,0:05:04.26,Default,,0,0,0,,Курияма мырза (Тайчи)
Dialogue: 0,0:05:04.34,0:05:06.72,Default,,0,0,0,,Енді кіре алмайтыныңызға сенімдісіз бе?
Dialogue: 0,0:05:06.80,0:05:09.01,Default,,0,0,0,,Мидори-чан...
Dialogue: 0,0:05:09.10,0:05:10.47,Default,,0,0,0,,Біз бірдеңе істей алмаймыз ба?
Dialogue: 0,0:05:10.56,0:05:13.35,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:05:18.27,0:05:20.11,Default,,0,0,0,,Келіңдер, сендер де балалар.
Dialogue: 0,0:05:20.19,0:05:21.73,Default,,0,0,0,,Эх (Чихая) Ах.
Dialogue: 0,0:05:21.82,0:05:24.07,Default,,0,0,0,,Не? Оны көргің келмей ме?
Dialogue: 0,0:05:24.15,0:05:25.99,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:05:29.62,0:05:32.74,Default,,0,0,0,,Бұл және біз таңдаған жол туралы білмегеніміз не жақсы?
Dialogue: 0,0:05:32.83,0:05:34.12,Default,,0,0,0,,Біреуі жоқ.
Dialogue: 0,0:05:36.50,0:05:37.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:37.58,0:05:42.09,Default,,0,0,0,,Мидори-чан арт жақтан Мен енді істей алмаймын, бүйірден кір.
Dialogue: 0,0:05:42.17,0:05:43.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:43.59,0:05:46.26,Default,,0,0,0,,Бір кездері ~ заттар~
Dialogue: 0,0:05:46.34,0:05:51.51,Default,,0,0,0,,Омовазари～Кери～
Dialogue: 0,0:05:53.60,0:05:54.89,Default,,0,0,0,,Хмм (Эмуро) Ха
Dialogue: 0,0:05:54.97,0:05:56.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:21.79,0:06:23.21,Default,,0,0,0,,Ах
Dialogue: 0,0:06:25.05,0:06:26.88,Default,,0,0,0,,Тез және тыныш отырыңыз
Dialogue: 0,0:06:26.96,0:06:27.97,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:06:31.18,0:06:33.30,Default,,0,0,0,,Суда себеп жоқ
Dialogue: 0,0:06:34.51,0:06:36.02,Default,,0,0,0,,Қалыпты ойын көрінісі
Dialogue: 0,0:06:44.57,0:06:45.65,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:50.61,0:06:52.07,Default,,0,0,0,,Бұл ауырады…
Dialogue: 0,0:06:55.16,0:06:56.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:57.83,0:07:00.71,Default,,0,0,0,,Өтінемін... 5 карта 11 картаға қарсы ма?
Dialogue: 0,0:07:00.79,0:07:02.33,Default,,0,0,0,,Шинобу-чан жеңіліп жатыр!?
Dialogue: 0,0:07:02.42,0:07:06.42,Default,,0,0,0,,Мм, Аясе Машима келді.
Dialogue: 0,0:07:06.50,0:07:07.96,Default,,0,0,0,,Машима жеңді ме?
Dialogue: 0,0:07:09.59,0:07:13.43,Default,,0,0,0,,Мен де Фудзисаки сияқты бейне түсіруім керек еді.
Dialogue: 0,0:07:14.14,0:07:17.47,Default,,0,0,0,,Мен Аясе мен Машимаға бәрін айтқым келеді.
Dialogue: 0,0:07:19.02,0:07:20.69,Default,,0,0,0,,Алдыңғы сәйкестіктер
Dialogue: 0,0:07:21.56,0:07:23.48,Default,,0,0,0,,Екі адамға арналған Карута
Dialogue: 0,0:07:25.40,0:07:30.24,Default,,0,0,0,,Бастапқы орналасу Ватая да, Королева да дос карталарын бөлек орналастырды.
Dialogue: 0,0:07:32.32,0:07:33.91,Default,,0,0,0,,Ватаядан оңай өтуді ұйымдастыру
Dialogue: 0,0:07:35.20,0:07:38.66,Default,,0,0,0,,Мен клишеге дейін бәрін төледім және бұл туралы ештеңе істей алмадым.
Dialogue: 0,0:07:40.50,0:07:42.92,Default,,0,0,0,,Королева да мұндай нәрселерден үрейленбейді.
Dialogue: 0,0:07:43.88,0:07:45.42,Default,,0,0,0,,Мақсатты картаны нақты шешіңіз
Dialogue: 0,0:07:46.63,0:07:48.67,Default,,0,0,0,,Әдеттегі дәл қабылдау
Dialogue: 0,0:07:50.88,0:07:52.09,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:53.30,0:07:55.64,Default,,0,0,0,,Баға ұсыныстарын сіз мақсат етпейтін карталарға орналастырыңыз.
Dialogue: 0,0:07:55.72,0:07:57.64,Default,,0,0,0,,Арата Ватая ағыны
Dialogue: 0,0:07:58.60,0:07:59.52,Default,,0,0,0,,Команда құрамын келіссөз жүргізуді бастайық.
Dialogue: 0,0:08:00.60,0:08:02.56,Default,,0,0,0,,Мені қалай осылай атай аласың?
Dialogue: 0,0:08:03.10,0:08:04.27,Default,,0,0,0,,Неге...
Dialogue: 0,0:08:04.35,0:08:07.15,Default,,0,0,0,,Тегті жылжыту
Dialogue: 0,0:08:09.07,0:08:12.11,Default,,0,0,0,,Карточканың жағымсыз қозғалысы Карточканың қажетсіз қозғалысы
Dialogue: 0,0:08:12.11,0:08:12.36,Default,,0,0,0,,Карточканың жағымсыз қозғалысы Карточканың қажетсіз қозғалысы
Dialogue: 0,0:08:12.11,0:08:12.36,Default,,0,0,0,,(Судоның күлкісі)
Dialogue: 0,0:08:12.36,0:08:12.45,Default,,0,0,0,,(Судоның күлкісі)
Dialogue: 0,0:08:12.45,0:08:15.41,Default,,0,0,0,,(Судоның күлкісі)
Dialogue: 0,0:08:12.45,0:08:15.41,Default,,0,0,0,,Ол Судо мырза сияқты садист!
Dialogue: 0,0:08:15.41,0:08:16.16,Default,,0,0,0,,Ол Судо мырза сияқты садист!
Dialogue: 0,0:08:17.58,0:08:19.74,Default,,0,0,0,,Әдемі өткел
Dialogue: 0,0:08:19.83,0:08:21.75,Default,,0,0,0,,Егжей-тегжейлі тактика
Dialogue: 0,0:08:21.83,0:08:22.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:23.66,0:08:25.67,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:08:26.42,0:08:29.00,Default,,0,0,0,,Ағын келсе, бұрылуға болады.
Dialogue: 0,0:08:29.09,0:08:31.26,Default,,0,0,0,,Парақтар санындағы айырмашылық маңызды емес.
Dialogue: 0,0:08:31.84,0:08:32.67,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:34.13,0:08:36.93,Default,,0,0,0,,Неліктен жағдай нашар болды?
Dialogue: 0,0:08:37.76,0:08:38.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:40.18,0:08:44.69,Default,,0,0,0,,Бүгін біз тастайтын карталар мен алған карталарды ажыратуымыз керек.
Dialogue: 0,0:08:46.40,0:08:48.19,Default,,0,0,0,,Дискриминацияланған...
Dialogue: 0,0:08:48.98,0:08:52.03,Default,,0,0,0,,Барлығы менен теріс бұрылды.
Dialogue: 0,0:08:54.99,0:08:56.03,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:56.11,0:08:57.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:57.45,0:09:00.16,Default,,0,0,0,,Хитокосо~Ми~
Dialogue: 0,0:09:00.24,0:09:06.37,Default,,0,0,0,,Акихакини～Кери～
Dialogue: 0,0:09:08.21,0:09:09.67,Default,,0,0,0,,Акинотано~
Dialogue: 0,0:09:09.75,0:09:10.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:10.80,0:09:12.30,Default,,0,0,0,,Енді жай ғана...
Dialogue: 0,0:09:12.38,0:09:14.72,Default,,0,0,0,,Қандай ой...
Dialogue: 0,0:09:14.80,0:09:16.05,Default,,0,0,0,,Уау, бұл тез!
Dialogue: 0,0:09:16.13,0:09:18.09,Default,,0,0,0,,Күткендей (аудитория) таң қалдырды
Dialogue: 0,0:09:18.93,0:09:22.43,Default,,0,0,0,,Мен... Шинобу-чанның тұтқасы дыбыс шығарады.
Dialogue: 0,0:09:22.52,0:09:24.85,Default,,0,0,0,,Бір тиын алу үшін қанша тиын төледіңіз?
Dialogue: 0,0:09:25.48,0:09:28.06,Default,,0,0,0,,Бұл Шинобудың әдеттегі стилі емес.
Dialogue: 0,0:09:28.81,0:09:32.36,Default,,0,0,0,,Бірінші нотадан қозғалады. Сіз тәуекелге бардыңыз.
Dialogue: 0,0:09:38.70,0:09:40.41,Default,,0,0,0,,Барлығын кешіріңіз
Dialogue: 0,0:09:41.12,0:09:42.12,Default,,0,0,0,,Алыңыз
Dialogue: 0,0:09:43.54,0:09:46.12,Default,,0,0,0,,Қалғанның бәрін ал!
Dialogue: 0,0:09:46.21,0:09:48.33,Default,,0,0,0,,Королеваның байсалды жүзі
Dialogue: 0,0:09:48.42,0:09:50.13,Default,,0,0,0,,Королева жылдамырақ
Dialogue: 0,0:09:50.21,0:09:54.01,Default,,0,0,0,,Мақтану техникасы екінші жартысында әлсіз
Dialogue: 0,0:09:54.09,0:09:55.38,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:55.46,0:09:57.59,Default,,0,0,0,,Техника емес
Dialogue: 0,0:09:58.13,0:09:59.89,Default,,0,0,0,,Бұл жігіттің таңғажайып нәрсесі...
Dialogue: 0,0:10:00.72,0:10:02.93,Default,,0,0,0,,Мен мұны білемін, өйткені мен оларға қарсы ойнадым.
Dialogue: 0,0:10:03.01,0:10:04.89,Default,,0,0,0,,Арата Ватаяның таңғаларлық тұсы...
Dialogue: 0,0:10:04.97,0:10:11.94,Default,,0,0,0,,Юйоши~Могана~
Dialogue: 0,0:10:13.07,0:10:13.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:16.65,0:10:19.07,Default,,0,0,0,,…Киказени~
Dialogue: 0,0:10:23.24,0:10:24.99,Default,,0,0,0,,FB… FB!
Dialogue: 0,0:10:27.66,0:10:29.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:32.08,0:10:33.67,Default,,0,0,0,,Ах
Dialogue: 0,0:10:35.13,0:10:36.26,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:39.76,0:10:40.80,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:10:40.89,0:10:43.43,Default,,0,0,0,,Синобу Вакамиядан жылдамырақ па?
Dialogue: 0,0:10:44.35,0:10:47.43,Default,,0,0,0,,Королеваның дыбысқа реакциясы жылдамырақ болды
Dialogue: 0,0:10:48.52,0:10:52.69,Default,,0,0,0,,Оның реакциясы мен қол жылдамдығы жеткілікті...
Dialogue: 0,0:10:54.69,0:10:55.61,Default,,0,0,0,,Өтті!
Dialogue: 0,0:10:56.69,0:10:58.61,Default,,0,0,0,,Супер жеделдету!
Dialogue: 0,0:10:59.36,0:11:01.61,Default,,0,0,0,,Кешіріңіз Тайчи Чихая
Dialogue: 0,0:11:01.70,0:11:03.37,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:11:03.45,0:11:05.33,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:11:05.41,0:11:08.62,Default,,0,0,0,,Арата Ватаяның супер жеделдетуінен, қару-жарақ санынан көп
Dialogue: 0,0:11:09.96,0:11:12.38,Default,,0,0,0,,Мен оның қаншалықты босаңсығанынан қорқамын.
Dialogue: 0,0:11:16.88,0:11:19.59,Default,,0,0,0,,Чихая-чан, мысалы
Dialogue: 0,0:11:19.67,0:11:22.76,Default,,0,0,0,,Жоғары жылдамдықпен айналатын түзу осі бар төбе
Dialogue: 0,0:11:25.60,0:11:28.18,Default,,0,0,0,,Қозғалмайтын болып көрінген кезде
Dialogue: 0,0:11:28.27,0:11:32.69,Default,,0,0,0,,Қуат барлық жерде біркелкі шоғырланған.
Dialogue: 0,0:11:33.90,0:11:37.53,Default,,0,0,0,,Қол тигізгеннің бәрі кері қайтарылатын тұрақты әлем.
Dialogue: 0,0:11:40.82,0:11:43.03,Default,,0,0,0,,Құдай туралы жастықтар
Dialogue: 0,0:11:45.37,0:11:47.08,Default,,0,0,0,,«Чихаябуру»
Dialogue: 0,0:11:49.58,0:11:52.92,Default,,0,0,0,,Ах, Чихая, олай көрінбе.
Dialogue: 0,0:11:53.00,0:11:53.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:58.67,0:12:00.59,Default,,0,0,0,,Таңғажайып нәрсе шықты.
Dialogue: 0,0:12:00.67,0:12:03.09,Default,,0,0,0,,Жоғары 2? (Көрермендер) Биыл 17 жаста ма?
Dialogue: 0,0:12:03.88,0:12:07.01,Default,,0,0,0,,Мен оның Ватая шебердің немересі болатынына үлкен үміт артатынмын.
Dialogue: 0,0:12:07.10,0:12:08.85,Default,,0,0,0,,Мен оның осы деңгейге жетеді деп күткен жоқпын.
Dialogue: 0,0:12:08.93,0:12:10.89,Default,,0,0,0,,Жаңадан жасалды
Dialogue: 0,0:12:10.98,0:12:14.35,Default,,0,0,0,,Мен басынан бастап бұлай карута ойнай алмадым.
Dialogue: 0,0:12:15.81,0:12:16.77,Default,,0,0,0,,Уф
Dialogue: 0,0:12:16.86,0:12:17.82,Default,,0,0,0,,Уф
Dialogue: 0,0:12:17.90,0:12:18.94,Default,,0,0,0,,Уф
Dialogue: 0,0:12:19.02,0:12:21.82,Default,,0,0,0,,Бірдеңе дұрыс емес, Арата.
Dialogue: 0,0:12:22.74,0:12:24.53,Default,,0,0,0,,Бір ұрпақта жау болмайды.
Dialogue: 0,0:12:24.61,0:12:26.82,Default,,0,0,0,,Мурао-кунға әлі де сәйкестік жоқ па?
Dialogue: 0,0:12:26.91,0:12:31.58,Default,,0,0,0,,Ватая мырза да қозғалыстың тым үлкен екенін айтады, солай ма?
Dialogue: 0,0:12:31.66,0:12:34.21,Default,,0,0,0,,Аа, келесі жолы кездескенше...
Dialogue: 0,0:12:34.29,0:12:35.29,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:36.00,0:12:36.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:38.50,0:12:41.34,Default,,0,0,0,,Сурет… Сурет…
Dialogue: 0,0:12:42.55,0:12:45.09,Default,,0,0,0,,Ең жақсы Карута бейнесі
Dialogue: 0,0:12:48.43,0:12:51.93,Default,,0,0,0,,Мурао-куннан тағы жеңіліп қалдыңыз ба?
Dialogue: 0,0:12:52.02,0:12:55.90,Default,,0,0,0,,Біз соңғы Киото турнирінде қызықсыз қателіктің салдарынан жеңіліп қалдық.
Dialogue: 0,0:12:55.98,0:12:59.06,Default,,0,0,0,,Сен атаңды көрмейсің бе?
Dialogue: 0,0:12:59.15,0:13:00.11,Default,,0,0,0,,Оны электр желісінен ажыратыңыз!
Dialogue: 0,0:13:00.73,0:13:02.82,Default,,0,0,0,,Менің басымда бір қарт бар
Dialogue: 0,0:13:02.90,0:13:05.20,Default,,0,0,0,,Мен оны елестетуге тырысамын, бірақ қолымнан келмейді.
Dialogue: 0,0:13:05.28,0:13:06.36,Default,,0,0,0,,Дұрыс қозғалғаныңызға көз жеткізіңіз!
Dialogue: 0,0:13:08.66,0:13:09.49,Default,,0,0,0,,Иә
Dialogue: 0,0:13:10.37,0:13:13.58,Default,,0,0,0,,Бетіңізде қорқынышты Карутаны ойнап жатырсыз ба?
Dialogue: 0,0:13:13.66,0:13:14.54,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:14.62,0:13:16.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:16.42,0:13:19.96,Default,,0,0,0,,Бейнелерге келгенде неше түрлі нәрсе бар.
Dialogue: 0,0:13:21.34,0:13:25.63,Default,,0,0,0,,Сіздің денеңіз соңғы рет қашан ең жеңіл қозғалды?
Dialogue: 0,0:13:25.72,0:13:29.01,Default,,0,0,0,,Карутаны ойнау қай уақытта ең қызық болды?
Dialogue: 0,0:13:31.31,0:13:32.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:34.31,0:13:38.94,Default,,0,0,0,,Нақтырақ айтсам, мен күн сайын 300 рет тербелумен айналысамын.
Dialogue: 0,0:13:39.02,0:13:39.98,Default,,0,0,0,,Иә!?
Dialogue: 0,0:13:41.23,0:13:44.86,Default,,0,0,0,,Іс жақсы болған кезде доктор Ватая қайтыс болды.
Dialogue: 0,0:13:44.94,0:13:46.99,Default,,0,0,0,,Бір жарым жылдық бос уақыт
Dialogue: 0,0:13:47.86,0:13:51.49,Default,,0,0,0,,Аратаның неге қайта оралғанын білмеймін.
Dialogue: 0,0:13:52.20,0:13:56.25,Default,,0,0,0,,Мен мұны Ватая мырза қайтыс болғаннан кейін ғана түсіндім.
Dialogue: 0,0:13:56.33,0:13:59.00,Default,,0,0,0,,Арата 20 сантиметрге өсті.
Dialogue: 0,0:14:00.75,0:14:02.63,Default,,0,0,0,,Осы өткен жылы-
Dialogue: 0,0:14:03.17,0:14:07.13,Default,,0,0,0,,Бір күнді қалдырмай 500 рет тербелуге жаттықтым.
Dialogue: 0,0:14:09.09,0:14:11.10,Default,,0,0,0,,Дене пайда болды
Dialogue: 0,0:14:12.68,0:14:15.10,Default,,0,0,0,,Суретті қуып жету
Dialogue: 0,0:14:16.02,0:14:16.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:16.93,0:14:18.85,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:14:18.94,0:14:22.48,Default,,0,0,0,,Мэйджин Суоға нұсқау беретін ойыншыларға
Dialogue: 0,0:14:22.57,0:14:23.86,Default,,0,0,0,,Мен солай болады деп ойлаймын
Dialogue: 0,0:14:23.94,0:14:25.61,Default,,0,0,0,,Керісінше
Dialogue: 0,0:14:26.57,0:14:28.61,Default,,0,0,0,,4 карта қалды және 9 карта қалды
Dialogue: 0,0:14:29.24,0:14:31.37,Default,,0,0,0,,Алдымен патшайым ұрылады.
Dialogue: 0,0:14:35.54,0:14:39.37,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,0:14:39.46,0:14:41.54,Default,,0,0,0,,Шулы...
Dialogue: 0,0:14:41.63,0:14:44.88,Default,,0,0,0,,Неліктен галереялар көп? Сен ақымақсың ба?
Dialogue: 0,0:14:47.30,0:14:49.38,Default,,0,0,0,,Мен неге айналамды осылай көремін?
Dialogue: 0,0:14:51.39,0:14:52.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:58.39,0:15:00.35,Default,,0,0,0,,Оның маған пайдасы болмады.
Dialogue: 0,0:15:00.44,0:15:02.98,Default,,0,0,0,,Жаңа түскен қар үлпілдек дөңгелек сүлгі
Dialogue: 0,0:15:03.06,0:15:04.77,Default,,0,0,0,,Патшайым терін сүртіп жатыр
Dialogue: 0,0:15:04.86,0:15:05.98,Default,,0,0,0,,бәлкім, осы ғана шығар
Dialogue: 0,0:15:06.82,0:15:10.40,Default,,0,0,0,,Бұл менің 5-ойыным, мен қатты терлеп жатырмын.
Dialogue: 0,0:15:12.87,0:15:15.66,Default,,0,0,0,,Барлығы оңай матчтар болған жоқ.
Dialogue: 0,0:15:22.79,0:15:27.21,Default,,0,0,0,,Ешқандай күтімді қажет етпейтін күн...
Dialogue: 0,0:15:29.80,0:15:31.55,Default,,0,0,0,,Лейзуру~
Dialogue: 0,0:15:31.63,0:15:38.60,Default,,0,0,0,,Цукино~Кагено Сая~Кеса~
Dialogue: 0,0:15:40.31,0:15:42.23,Default,,0,0,0,,Дауыл
Dialogue: 0,0:15:42.31,0:15:43.81,Default,,0,0,0,,Бос шот...
Dialogue: 0,0:15:42.31,0:15:43.81,Default,,0,0,0,,Мимуро но Ямано ~Момиджиба~
Dialogue: 0,0:15:43.81,0:15:47.94,Default,,0,0,0,,Мимуро но Ямано ~Момиджиба~
Dialogue: 0,0:15:49.49,0:15:52.40,Default,,0,0,0,,Тацута-но Кавано
Dialogue: 0,0:15:52.49,0:15:58.87,Default,,0,0,0,,Нишикинари ~Кери~
Dialogue: 0,0:15:59.91,0:16:01.46,Default,,0,0,0,,Юраното~
Dialogue: 0,0:16:01.54,0:16:02.58,Default,,0,0,0,,Қазір қайсысы?
Dialogue: 0,0:16:02.67,0:16:04.46,Default,,0,0,0,,Дәл солай ма? (Көрермендер) Мен мүлде түсінбеймін.
Dialogue: 0,0:16:05.33,0:16:06.75,Default,,0,0,0,,Королеваның тұтқынға алынуы
Dialogue: 0,0:16:06.84,0:16:08.84,Default,,0,0,0,,Жау сызығының төменгі оң жағы жойылды
Dialogue: 0,0:16:09.55,0:16:10.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:12.30,0:16:16.39,Default,,0,0,0,,Мен Арата тезірек түсінді деп ойладым.
Dialogue: 0,0:16:17.26,0:16:19.72,Default,,0,0,0,,қолының астынан сырғып кетті
Dialogue: 0,0:16:20.39,0:16:22.77,Default,,0,0,0,,Мен соншалықты төмен қозғала алатыныма сене алмаймын.
Dialogue: 0,0:16:22.85,0:16:25.56,Default,,0,0,0,,Юкуэ Мо Ширану
Dialogue: 0,0:16:25.65,0:16:32.03,Default,,0,0,0,,Кой Мичи~Кана~
Dialogue: 0,0:16:34.11,0:16:36.78,Default,,0,0,0,,Ұзақ тұру...
Dialogue: 0,0:16:36.87,0:16:38.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:38.37,0:16:39.28,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:16:39.37,0:16:42.04,Default,,0,0,0,,Вексельдер екі мүлдем басқа бағытта...
Dialogue: 0,0:16:42.12,0:16:45.04,Default,,0,0,0,,Ондай нәрсе бар ма? Сіз қайсысын қалайсыз?
Dialogue: 0,0:16:45.12,0:16:48.04,Default,,0,0,0,,Екеуі де төледі, бірақ...
Dialogue: 0,0:16:48.75,0:16:50.67,Default,,0,0,0,,Ендігі кезек патшайымға келді
Dialogue: 0,0:16:50.75,0:16:55.01,Default,,0,0,0,,О... көрдің бе? Чихая қазір
Dialogue: 0,0:16:55.59,0:16:56.80,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:16:58.10,0:17:00.35,Default,,0,0,0,,Жаңа ғана оқылған «Нагеки» болды.
Dialogue: 0,0:17:00.43,0:17:02.35,Default,,0,0,0,,Шинобу-чанның төменгі сол жағында
Dialogue: 0,0:17:02.43,0:17:04.44,Default,,0,0,0,,Өйткені «нагеки» және «наниваэ» болды.
Dialogue: 0,0:17:04.52,0:17:06.65,Default,,0,0,0,,Арата есепшотты бәрін төлеуге итермеледі.
Dialogue: 0,0:17:07.73,0:17:11.07,Default,,0,0,0,,Бірақ Шинобу-чан төледі
Dialogue: 0,0:17:11.15,0:17:13.32,Default,,0,0,0,,Солардың бірі
Dialogue: 0,0:17:16.49,0:17:20.58,Default,,0,0,0,,Шинобу-чан жіпті қайтадан қатайтады...
Dialogue: 0,0:17:21.99,0:17:23.41,Default,,0,0,0,,Оны қалай алуға болады?
Dialogue: 0,0:17:26.54,0:17:28.54,Default,,0,0,0,,Жылдамырақ
Dialogue: 0,0:17:29.75,0:17:31.21,Default,,0,0,0,,төмен
Dialogue: 0,0:17:33.46,0:17:34.80,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:37.26,0:17:38.09,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:49.94,0:17:52.69,Default,,0,0,0,,Сізді барлығымен не байланыстырады?
Dialogue: 0,0:17:53.69,0:17:55.69,Default,,0,0,0,,Арата Учия
Dialogue: 0,0:17:55.78,0:17:57.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:57.28,0:17:58.45,Default,,0,0,0,,Иә
Dialogue: 0,0:17:58.53,0:18:00.12,Default,,0,0,0,,Ах (Шинобу) Иә!
Dialogue: 0,0:18:02.24,0:18:06.37,Default,,0,0,0,,Шынымды айтсам, мен мына күлімсіреген көзілдірікпен жынды болып бара жатырмын.
Dialogue: 0,0:18:06.96,0:18:10.13,Default,,0,0,0,,Сақтықты түсірме, зейініңді жинақта
Dialogue: 0,0:18:12.71,0:18:17.38,Default,,0,0,0,,4 карта 7 картаға қарсы Патшайым саңылауды жапты. Не болады?
Dialogue: 0,0:18:18.18,0:18:21.26,Default,,0,0,0,,Концентрация… Концентрация…
Dialogue: 0,0:18:21.93,0:18:23.39,Default,,0,0,0,,А... қиын
Dialogue: 0,0:18:24.10,0:18:27.98,Default,,0,0,0,,Сөзсіз жоғары сынып оқушысы... жоқ
Dialogue: 0,0:18:28.06,0:18:30.77,Default,,0,0,0,,А класындағы ең жоғары деңгейдегі шайқас
Dialogue: 0,0:18:30.85,0:18:32.77,Default,,0,0,0,,Қалай ~Хисашики~
Dialogue: 0,0:18:32.77,0:18:33.73,Default,,0,0,0,,Қалай ~Хисашики~
Dialogue: 0,0:18:32.77,0:18:33.73,Default,,0,0,0,,Шаршадым... Ыстық...
Dialogue: 0,0:18:33.73,0:18:33.82,Default,,0,0,0,,Шаршадым... Ыстық...
Dialogue: 0,0:18:33.82,0:18:36.15,Default,,0,0,0,,Шаршадым... Ыстық...
Dialogue: 0,0:18:33.82,0:18:36.15,Default,,0,0,0,,заттар ~ мырза~
Dialogue: 0,0:18:36.15,0:18:38.40,Default,,0,0,0,,заттар ~ мырза~
Dialogue: 0,0:18:38.40,0:18:39.40,Default,,0,0,0,,заттар ~ мырза~
Dialogue: 0,0:18:38.40,0:18:39.40,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:45.37,0:18:47.58,Default,,0,0,0,,Біз әлі де күшті бола аламыз
Dialogue: 0,0:18:49.21,0:18:51.08,Default,,0,0,0,,Тегпен тереңірек қосылыңыз
Dialogue: 0,0:18:52.63,0:18:53.46,Default,,0,0,0,,Батырлар дереу қажет!
Dialogue: 0,0:18:55.00,0:18:55.84,Default,,0,0,0,,Батырлар дереу қажет!
Dialogue: 0,0:18:57.38,0:18:58.22,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:19:26.12,0:19:30.00,Default,,0,0,0,,Сен Харуноның үйіне келесің~
Dialogue: 0,0:19:30.08,0:19:34.04,Default,,0,0,0,,Вакана~Цум~
