Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.01,0:00:16.55,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:16.64,0:00:17.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:23.85,0:00:26.31,Default,,0,0,0,,Мен… Чи… Ро…
Dialogue: 0,0:00:27.73,0:00:28.31,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:00:28.40,0:00:28.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:29.07,0:00:29.77,Default,,0,0,0,,Ағай!
Dialogue: 0,0:00:30.73,0:00:32.11,Default,,0,0,0,,Сен, неге...
Dialogue: 0,0:00:32.19,0:00:33.61,Default,,0,0,0,,Жылы Жыны
Dialogue: 0,0:00:33.70,0:00:34.57,Default,,0,0,0,,А...
Dialogue: 0,0:00:35.45,0:00:37.16,Default,,0,0,0,,Мұқият қараңыз...
Dialogue: 0,0:00:37.66,0:00:38.16,Default,,0,0,0,,Не!
Dialogue: 0,0:00:38.24,0:00:39.37,Default,,0,0,0,,Үшінші буын!
Dialogue: 0,0:00:39.45,0:00:40.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:42.12,0:00:44.37,Default,,0,0,0,,(Періштенің ырылдауы)
Dialogue: 0,0:00:44.46,0:00:45.58,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:00:45.67,0:00:47.63,Default,,0,0,0,,Шайтан...әлде періште ме?
Dialogue: 0,0:00:48.17,0:00:50.13,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:00:50.21,0:00:51.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:52.34,0:00:54.30,Default,,0,0,0,,Бұл жалған болды ма?
Dialogue: 0,0:00:54.38,0:00:55.88,Default,,0,0,0,,«Малефицияның қасиетті суы»
Dialogue: 0,0:00:55.97,0:00:58.55,Default,,0,0,0,,Оның жұмыс істегені – шайтан.
Dialogue: 0,0:00:59.22,0:01:01.56,Default,,0,0,0,,Оның жалған екенін анық аңғаруға болады.
Dialogue: 0,0:01:01.64,0:01:02.56,Default,,0,0,0,,Егер сіз ақымақ әке болсаңыз
Dialogue: 0,0:01:02.64,0:01:05.60,Default,,0,0,0,,Мен бұл жауапқа ешқашан жете алмаймын.
Dialogue: 0,0:01:05.69,0:01:07.77,Default,,0,0,0,,Бұл Strofire үшін тұзақ екені анық.
Dialogue: 0,0:01:08.27,0:01:09.11,Default,,0,0,0,,Эй
Dialogue: 0,0:01:09.19,0:01:11.36,Default,,0,0,0,,Жауабын таптың ба?
Dialogue: 0,0:01:11.44,0:01:12.11,Default,,0,0,0,,О
Dialogue: 0,0:01:12.19,0:01:15.15,Default,,0,0,0,,Менің күшімді қарызға алуыңызды өтінемін~
Dialogue: 0,0:01:15.24,0:01:15.74,Default,,0,0,0,,Гуах
Dialogue: 0,0:01:15.82,0:01:16.95,Default,,0,0,0,,Әй... сен!
Dialogue: 0,0:01:17.03,0:01:20.24,Default,,0,0,0,,Он үшінші апостол Гремори-чан
Dialogue: 0,0:01:20.33,0:01:21.33,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:01:21.41,0:01:22.99,Default,,0,0,0,,Бар болғаны он екі елші бар!
Dialogue: 0,0:01:23.50,0:01:24.00,Default,,0,0,0,,Шамамен
Dialogue: 0,0:01:24.62,0:01:27.87,Default,,0,0,0,,Мен шайтанның жүрегін жеген елшіге шыдай алмаймын!
Dialogue: 0,0:01:28.37,0:01:29.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:29.54,0:01:30.88,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:01:33.34,0:01:35.51,Default,,0,0,0,,Ей, жалғыз барма.
Dialogue: 0,0:01:35.59,0:01:36.76,Default,,0,0,0,,Уууу, дұрыс.
Dialogue: 0,0:01:36.84,0:01:37.76,Default,,0,0,0,,Менімен бірге барайық~
Dialogue: 0,0:01:37.84,0:01:39.01,Default,,0,0,0,,Күтіңіз III
Dialogue: 0,0:01:39.09,0:01:40.35,Default,,0,0,0,,Мен бірінші барамын...
Dialogue: 0,0:01:40.43,0:01:42.26,Default,,0,0,0,,Әке, жарайды.
Dialogue: 0,0:01:42.93,0:01:43.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:44.22,0:01:46.10,Default,,0,0,0,,Оны маған және шайтанға қалдыр
Dialogue: 0,0:01:46.18,0:01:47.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:48.39,0:01:51.19,Default,,0,0,0,,Жарайды, абай болыңыз.
Dialogue: 0,0:01:51.69,0:01:52.40,Default,,0,0,0,,Иә
Dialogue: 0,0:01:52.90,0:01:55.78,Default,,0,0,0,,Мен Шинго ағайға міндетті түрде көмектесемін.
Dialogue: 0,0:01:56.44,0:01:57.70,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:01:57.78,0:01:59.07,Default,,0,0,0,,III
Dialogue: 0,0:01:59.57,0:02:01.32,Default,,0,0,0,,Егер Ичиро мен мен
Dialogue: 0,0:02:01.83,0:02:03.95,Default,,0,0,0,,Мен Строфирді жеңе алатыныма сенімдімін.
Dialogue: 0,0:02:10.00,0:02:12.21,Default,,0,0,0,,Гремори Акума-кун ше?
Dialogue: 0,0:02:12.71,0:02:15.05,Default,,0,0,0,,Ішке кірсем ол жоқ екен.
Dialogue: 0,0:02:15.13,0:02:17.80,Default,,0,0,0,,Сонда бұл қақпан ғой?
Dialogue: 0,0:02:17.88,0:02:19.01,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:02:20.18,0:02:24.51,Default,,0,0,0,,Мен бүкіл кеңістікте қорқынышты сиқырлы күшті сезінемін.
Dialogue: 0,0:02:25.60,0:02:28.10,Default,,0,0,0,,Біріншіден, менің дәмім нашар.
Dialogue: 0,0:02:37.53,0:02:40.95,Default,,0,0,0,,Малефицияның қасиетті суымен зарядталған мылтық?
Dialogue: 0,0:02:41.45,0:02:44.03,Default,,0,0,0,,Сізде қызықты нәрсе бар.
Dialogue: 0,0:02:44.53,0:02:46.20,Default,,0,0,0,,Эшмадан күткендей
Dialogue: 0,0:02:46.29,0:02:48.12,Default,,0,0,0,,Олай болса, бірден ойнайық.
Dialogue: 0,0:02:48.75,0:02:50.25,Default,,0,0,0,,Сіз кімді өлтіресіз?
Dialogue: 0,0:02:50.33,0:02:52.58,Default,,0,0,0,,Бұл сіз бұрын түсірген нашар жасалған періште.
Dialogue: 0,0:02:52.67,0:02:54.59,Default,,0,0,0,,Қызықсыз, солай ма?
Dialogue: 0,0:02:54.67,0:02:57.38,Default,,0,0,0,,Бұл адамдарға әсер етпейді.
Dialogue: 0,0:02:58.26,0:03:00.76,Default,,0,0,0,,Он екі Апостолды іздеуге бару туралы не айтасыз?
Dialogue: 0,0:03:00.84,0:03:01.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:02.14,0:03:02.64,Default,,0,0,0,,Гррр…
Dialogue: 0,0:03:02.72,0:03:03.80,Default,,0,0,0,,Гах…
Dialogue: 0,0:03:07.72,0:03:08.89,Default,,0,0,0,,Не?
Dialogue: 0,0:03:09.77,0:03:11.52,Default,,0,0,0,,Хи хи
Dialogue: 0,0:03:12.85,0:03:15.02,Default,,0,0,0,,Қандай ысырап.
Dialogue: 0,0:03:15.11,0:03:17.78,Default,,0,0,0,,Қасиетті су толтырылған оқ болса да
Dialogue: 0,0:03:19.03,0:03:21.36,Default,,0,0,0,,Эй, мұндай нәрсе мені өлтіруі мүмкін емес.
Dialogue: 0,0:03:21.45,0:03:23.53,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:03:24.12,0:03:24.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:25.03,0:03:27.41,Default,,0,0,0,,Әлде сен мені өлтіруді ойладың ба?
Dialogue: 0,0:03:27.91,0:03:30.54,Default,,0,0,0,,Ол тек жындарға ғана әсер етеді
Dialogue: 0,0:03:30.62,0:03:33.29,Default,,0,0,0,,Бұл сәтсіз періштеде де жұмыс істеді.
Dialogue: 0,0:03:33.79,0:03:36.59,Default,,0,0,0,,Сен де өлген періштелермен бір нәсілденсің.
Dialogue: 0,0:03:37.09,0:03:38.80,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:03:38.88,0:03:43.13,Default,,0,0,0,,Оны Писис жасаған жалған періштемен араластыруға қалай дәтің бар?
Dialogue: 0,0:03:43.64,0:03:44.59,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:03:44.68,0:03:47.68,Default,,0,0,0,,Мен тек қасиетті су жеткіліксіз деп ойладым.
Dialogue: 0,0:03:47.76,0:03:48.81,Default,,0,0,0,,Ах… Ах… Ааах…
Dialogue: 0,0:03:48.89,0:03:50.18,Default,,0,0,0,,Сізде тағы бір нәрсе бар ма?
Dialogue: 0,0:03:50.27,0:03:52.39,Default,,0,0,0,,Майданға көз салғандар
Dialogue: 0,0:03:52.48,0:03:54.35,Default,,0,0,0,,Өздігінен жасалғандар
Dialogue: 0,0:03:54.44,0:03:55.06,Default,,0,0,0,,Уақыт тең...
Dialogue: 0,0:03:55.15,0:03:56.31,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:03:56.40,0:03:58.82,Default,,0,0,0,,Ал билікте тең болғандар
Dialogue: 0,0:03:59.32,0:04:01.78,Default,,0,0,0,,Патшалықсыз отар болады.
Dialogue: 0,0:04:01.86,0:04:02.45,Default,,0,0,0,,Аешма!
Dialogue: 0,0:04:13.83,0:04:14.58,Default,,0,0,0,,Аешма...
Dialogue: 0,0:04:15.96,0:04:17.59,Default,,0,0,0,,Оны қайдан алдың?
Dialogue: 0,0:04:19.59,0:04:22.72,Default,,0,0,0,,«Сүлейменнің флейтасын» жойыңыз
Dialogue: 0,0:04:24.09,0:04:26.09,Default,,0,0,0,,Каранэс ауданына оралу.
Dialogue: 0,0:04:27.01,0:04:27.85,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:27.93,0:04:30.47,Default,,0,0,0,,Строфирдің сиқырлы күші әлсіреді.
Dialogue: 0,0:04:30.56,0:04:33.18,Default,,0,0,0,,Мүмкін менің кесірімнен шығар?
Dialogue: 0,0:04:33.27,0:04:35.14,Default,,0,0,0,,Кеттік, жартылай адам.
Dialogue: 0,0:04:35.23,0:04:36.90,Default,,0,0,0,,Сіз бұйрық бермейсіз.
Dialogue: 0,0:04:45.82,0:04:46.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:49.28,0:04:50.74,Default,,0,0,0,,Строфир қозғалысы
Dialogue: 0,0:04:50.83,0:04:52.70,Default,,0,0,0,,Пломбалауға болатын нәрсе
Dialogue: 0,0:04:52.79,0:04:55.37,Default,,0,0,0,,Өйткені Сүлейменнің сыбызғысынан басқа...
Dialogue: 0,0:04:57.17,0:05:00.67,Default,,0,0,0,,Енді сіз Сүлейменнің флейтасын ойнай аласыз...
Dialogue: 0,0:05:01.17,0:05:04.09,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:04.17,0:05:07.09,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:11.72,0:05:13.27,Default,,0,0,0,,Момомомон!
Dialogue: 0,0:05:13.35,0:05:13.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:13.98,0:05:15.85,Default,,0,0,0,,Жүз көзсіз
Dialogue: 0,0:05:17.69,0:05:19.19,Default,,0,0,0,,(құпия есіктің ашылған дыбысы)
Dialogue: 0,0:05:19.27,0:05:20.44,Default,,0,0,0,,Осы жолмен
Dialogue: 0,0:05:20.52,0:05:22.53,Default,,0,0,0,,Түсіндім, бұл жасырын үзінді.
Dialogue: 0,0:05:22.61,0:05:26.40,Default,,0,0,0,,Осы жерден әкеңе баруға болады, шайтан...
Dialogue: 0,0:05:26.49,0:05:27.78,Default,,0,0,0,,...Хададамон
Dialogue: 0,0:05:27.86,0:05:28.99,Default,,0,0,0,,«Керек»?
Dialogue: 0,0:05:29.07,0:05:30.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:30.99,0:05:33.16,Default,,0,0,0,,Менің де ол жерге бірінші рет баруым.
Dialogue: 0,0:05:33.24,0:05:34.79,Default,,0,0,0,,Бұл менің әкемнің бұйрығы ма?
Dialogue: 0,0:05:34.87,0:05:36.25,Default,,0,0,0,,Әр түрлі дүйсенбі
Dialogue: 0,0:05:36.33,0:05:40.04,Default,,0,0,0,,Ібіліс-кун әкесі Девил-кунға көмектесуге келді.
Dialogue: 0,0:05:40.13,0:05:42.63,Default,,0,0,0,,Мен де сенімен ұрысамын.
Dialogue: 0,0:05:43.13,0:05:44.67,Default,,0,0,0,,Ол елші болғандықтан ба?
Dialogue: 0,0:05:45.17,0:05:46.92,Default,,0,0,0,,Өйткені біз доспыз
Dialogue: 0,0:05:57.06,0:05:58.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:59.06,0:05:59.98,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:00.69,0:06:01.73,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:06:01.81,0:06:04.28,Default,,0,0,0,,`` Сүлейменнің флейта бөлмесі '' Дэймон
Dialogue: 0,0:06:04.36,0:06:05.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:05.57,0:06:06.74,Default,,0,0,0,,Не?
Dialogue: 0,0:06:08.95,0:06:10.37,Default,,0,0,0,,Ібіліс-күн!
Dialogue: 0,0:06:11.37,0:06:13.03,Default,,0,0,0,,Не болды, Дс?
Dialogue: 0,0:06:19.75,0:06:20.38,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:06:20.46,0:06:21.92,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:06:22.00,0:06:23.92,Default,,0,0,0,,Мен Нанға келмеймін бе?
Dialogue: 0,0:06:24.63,0:06:25.67,Default,,0,0,0,,Арх! (Гремори) О
Dialogue: 0,0:06:25.76,0:06:26.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:26.92,0:06:28.51,Default,,0,0,0,,Уа!
Dialogue: 0,0:06:30.93,0:06:32.35,Default,,0,0,0,,Өрт!
Dialogue: 0,0:06:32.43,0:06:33.01,Default,,0,0,0,,Гррр…
Dialogue: 0,0:06:33.10,0:06:36.77,Default,,0,0,0,,Жартылай жын болсаң да, таныс.
Dialogue: 0,0:06:36.85,0:06:37.85,Default,,0,0,0,,Ah бұрышы
Dialogue: 0,0:06:38.35,0:06:39.48,Default,,0,0,0,,Эй, бұл бізде бар дегенді білдіреді.
Dialogue: 0,0:06:39.56,0:06:42.65,Default,,0,0,0,,Потестат Диаболиді алып жатырсыз ба?
Dialogue: 0,0:06:43.56,0:06:44.40,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:44.48,0:06:45.82,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:06:45.90,0:06:48.49,Default,,0,0,0,,Сиқырлы электр бомбалаушы
Dialogue: 0,0:06:48.57,0:06:49.99,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:51.49,0:06:53.87,Default,,0,0,0,,Құдіретіңіз де осындай!
Dialogue: 0,0:06:54.53,0:06:55.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:55.66,0:06:57.45,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:57.54,0:06:59.00,Default,,0,0,0,,«Бұл туралы ма?»
Dialogue: 0,0:06:59.08,0:07:00.50,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:07:00.58,0:07:03.38,Default,,0,0,0,,Мен сіз туралы шындап айту мүмкін емес.
Dialogue: 0,0:07:03.46,0:07:06.38,Default,,0,0,0,,Егер сіз әкеңізге қоңырау шалсаңыз, оны шындап шығаруға болады.
Dialogue: 0,0:07:07.30,0:07:09.97,Default,,0,0,0,,Ал, әлі секундтар бар.
Dialogue: 0,0:07:10.05,0:07:11.88,Default,,0,0,0,,Сиқырлы күш Найзағай...
Dialogue: 0,0:07:11.97,0:07:13.39,Default,,0,0,0,,Баяу
Dialogue: 0,0:07:13.47,0:07:14.64,Default,,0,0,0,,Уау... уф...
Dialogue: 0,0:07:15.60,0:07:16.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:22.23,0:07:23.02,Default,,0,0,0,,Мен… мен істедім! Мен жылдамырақпын! ➡
Dialogue: 0,0:07:23.10,0:07:25.48,Default,,0,0,0,,Қарғыс атсын... бұл...
Dialogue: 0,0:07:26.19,0:07:27.73,Default,,0,0,0,,Сен кімсің өзі…
Dialogue: 0,0:07:28.32,0:07:29.49,Default,,0,0,0,,Қызыл қан?
Dialogue: 0,0:07:30.15,0:07:31.74,Default,,0,0,0,,Бұл жағымсыз.
Dialogue: 0,0:07:31.82,0:07:35.12,Default,,0,0,0,,Аешманың қасында сен сияқты адам бар.
Dialogue: 0,0:07:35.66,0:07:39.62,Default,,0,0,0,,Ей, мені елеме.
Dialogue: 0,0:07:39.70,0:07:41.91,Default,,0,0,0,,Ойлап қарасам, сен сонда болдың.
Dialogue: 0,0:07:42.00,0:07:42.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:43.17,0:07:45.50,Default,,0,0,0,,Мен сенімен ойнаймын
Dialogue: 0,0:07:45.59,0:07:46.75,Default,,0,0,0,,Гррр…
Dialogue: 0,0:07:46.84,0:07:49.17,Default,,0,0,0,,Мен қаша алмаймын.
Dialogue: 0,0:07:49.26,0:07:51.76,Default,,0,0,0,,Оксирхинх папирусы отырғызылды.
Dialogue: 0,0:07:51.84,0:07:53.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:53.18,0:07:56.76,Default,,0,0,0,,Аешмаға қажетсіз нәрсені үйреткен сен бе?
Dialogue: 0,0:07:56.85,0:07:57.93,Default,,0,0,0,,Гремори
Dialogue: 0,0:07:58.01,0:08:01.39,Default,,0,0,0,,Жартылай адам шайтан-кунға көмектес.
Dialogue: 0,0:08:03.69,0:08:06.56,Default,,0,0,0,,Мен бұл періштемен билеп жатырмын
Dialogue: 0,0:08:07.36,0:08:09.65,Default,,0,0,0,,Ібіліс пен періштенің биі
Dialogue: 0,0:08:10.15,0:08:12.07,Default,,0,0,0,,Уф... рахмет
Dialogue: 0,0:08:12.15,0:08:14.07,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:08:14.16,0:08:15.74,Default,,0,0,0,,Сізге айтайын
Dialogue: 0,0:08:16.24,0:08:18.62,Default,,0,0,0,,Өйткені шайтан менікі!
Dialogue: 0,0:08:18.70,0:08:20.70,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:08:22.54,0:08:26.92,Default,,0,0,0,,Жалынды би Сізге ұнады ма?
Dialogue: 0,0:08:27.42,0:08:29.63,Default,,0,0,0,,Ал, аздап.
Dialogue: 0,0:08:29.71,0:08:30.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:31.30,0:08:32.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:32.26,0:08:35.22,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:08:35.30,0:08:37.09,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:08:37.18,0:08:37.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:38.39,0:08:39.76,Default,,0,0,0,,Үшінші буын монах!
Dialogue: 0,0:08:39.85,0:08:40.35,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:40.93,0:08:42.35,Default,,0,0,0,,Осы жолмен
Dialogue: 0,0:08:43.06,0:08:45.31,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:08:49.94,0:08:52.11,Default,,0,0,0,,Әке шайтан-кун...
Dialogue: 0,0:08:55.11,0:08:56.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:56.95,0:08:58.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:58.37,0:08:59.78,Default,,0,0,0,,Не болды, Мон?
Dialogue: 0,0:08:59.87,0:09:02.45,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:09:13.97,0:09:15.59,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:17.51,0:09:18.76,Default,,0,0,0,,Иә
Dialogue: 0,0:09:26.35,0:09:27.35,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:09:27.44,0:09:30.48,Default,,0,0,0,,Шыңға шығудың жолы бар ма?
Dialogue: 0,0:09:30.57,0:09:32.78,Default,,0,0,0,,Йотко Корашотто
Dialogue: 0,0:09:32.86,0:09:34.07,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз...
Dialogue: 0,0:09:34.15,0:09:36.11,Default,,0,0,0,,Ахаха (жарқанат мысық)
Dialogue: 0,0:09:36.20,0:09:38.11,Default,,0,0,0,,Мон жақсы жерге келді
Dialogue: 0,0:09:38.20,0:09:40.45,Default,,0,0,0,,Шынымен де осындай жерде...
Dialogue: 0,0:09:40.53,0:09:41.62,Default,,0,0,0,,Әй, шайтан-күн!
Dialogue: 0,0:09:42.24,0:09:43.49,Default,,0,0,0,,Мефисто
Dialogue: 0,0:09:44.50,0:09:45.71,Default,,0,0,0,,Менің сұм әкем...
Dialogue: 0,0:09:46.21,0:09:47.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:54.01,0:09:55.51,Default,,0,0,0,,Шинго ағай!
Dialogue: 0,0:09:56.01,0:09:59.76,Default,,0,0,0,,Бұл ғимараттарда болатын құбылыс.
Dialogue: 0,0:10:00.47,0:10:02.01,Default,,0,0,0,,Бұл адам ағзасында да бола ма?
Dialogue: 0,0:10:02.10,0:10:03.18,Default,,0,0,0,,Ұлы ұстаз!
Dialogue: 0,0:10:03.26,0:10:05.02,Default,,0,0,0,,Мықты бол, дүйсенбі!
Dialogue: 0,0:10:05.52,0:10:07.56,Default,,0,0,0,,Сізде тыныс бар, солай ма?
Dialogue: 0,0:10:08.14,0:10:10.81,Default,,0,0,0,,Жоқ... келме.
Dialogue: 0,0:10:10.90,0:10:12.44,Default,,0,0,0,,Әй, аға...
Dialogue: 0,0:10:13.40,0:10:16.99,Default,,0,0,0,,Ичиро: Сүлейменнің флейтасы.
Dialogue: 0,0:10:17.78,0:10:18.82,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:10:18.90,0:10:20.78,Default,,0,0,0,,Сүлейменнің сыбызғы...
Dialogue: 0,0:10:21.28,0:10:23.99,Default,,0,0,0,,Бұл енді шырылдамайды, солай ма?
Dialogue: 0,0:10:26.00,0:10:27.83,Default,,0,0,0,,Сүлейменнің сыбызғы…
Dialogue: 0,0:10:27.91,0:10:28.87,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:29.37,0:10:32.25,Default,,0,0,0,,Ысқырық сізді оның иесі деп таныды.
Dialogue: 0,0:10:32.84,0:10:33.79,Default,,0,0,0,,Жарылған
Dialogue: 0,0:10:34.30,0:10:37.72,Default,,0,0,0,,Біз қазір жарықшақ неліктен пайда болғанын зерттеп жатырмыз.
Dialogue: 0,0:10:37.80,0:10:38.72,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:38.80,0:10:41.59,Default,,0,0,0,,Бұл сіздің шайтан екеніңізге дәлел.
Dialogue: 0,0:10:42.09,0:10:43.22,Default,,0,0,0,,Оны үрлеп көріңіз.
Dialogue: 0,0:10:43.30,0:10:44.81,Default,,0,0,0,,Үрлеу...
Dialogue: 0,0:10:45.31,0:10:46.31,Default,,0,0,0,,Сен дұрыс айтасың — сені өліміңе мен себеп болдым.
Dialogue: 0,0:10:47.68,0:10:49.64,Default,,0,0,0,,(құрғақ дыбыс)
Dialogue: 0,0:10:50.65,0:10:52.23,Default,,0,0,0,,(құрғақ дыбыс)
Dialogue: 0,0:10:52.81,0:10:57.44,Default,,0,0,0,,Мүмкін сізге ең алдымен «бақыт» деген не екенін білу керек шығар.
Dialogue: 0,0:10:57.94,0:10:58.69,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:10:58.78,0:11:02.24,Default,,0,0,0,,Көрінбейтін мектеп ысқырықты біраз уақыт қорғасын.
Dialogue: 0,0:11:03.62,0:11:04.83,Default,,0,0,0,,Соңында...
Dialogue: 0,0:11:04.91,0:11:09.41,Default,,0,0,0,,Менің қолымда Сүлейменнің сыбызғысы ешқашан шырқалмаған.
Dialogue: 0,0:11:11.21,0:11:12.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:25.10,0:11:26.43,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:28.31,0:11:29.18,Default,,0,0,0,,Ай!
Dialogue: 0,0:11:29.27,0:11:30.10,Default,,0,0,0,,Мама!
Dialogue: 0,0:11:30.18,0:11:31.85,Default,,0,0,0,,Көрінбейтін мектеп қирап жатыр!
Dialogue: 0,0:11:36.69,0:11:37.78,Default,,0,0,0,,Сақ болыңыз, барлығы...
Dialogue: 0,0:11:37.86,0:11:38.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:38.98,0:11:39.49,Default,,0,0,0,,Мефисто!
Dialogue: 0,0:11:39.57,0:11:40.82,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:11:49.58,0:11:51.54,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:04.59,0:12:05.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:05.64,0:12:07.35,Default,,0,0,0,,Амансың ба? Шайтан-күн
Dialogue: 0,0:12:07.43,0:12:08.64,Default,,0,0,0,,Бұл тозақ патшалығы ма?
Dialogue: 0,0:12:08.72,0:12:09.64,Default,,0,0,0,,Тірі дүйсенбі…
Dialogue: 0,0:12:09.72,0:12:11.14,Default,,0,0,0,,Сіздің ақымақ әкеңіз ше?
Dialogue: 0,0:12:11.64,0:12:13.10,Default,,0,0,0,,Жақын жерден іздеп көрейік
Dialogue: 0,0:12:13.19,0:12:15.10,Default,,0,0,0,,Егер оны көміп тастаса, мәселе болар еді.
Dialogue: 0,0:12:15.19,0:12:16.73,Default,,0,0,0,,Тек «көмілген ағаштар»
Dialogue: 0,0:12:16.81,0:12:18.61,Default,,0,0,0,,Бұл сіз іздеп жүрген нәрсе ме?
Dialogue: 0,0:12:18.69,0:12:19.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:26.53,0:12:27.74,Default,,0,0,0,,Ағай...
Dialogue: 0,0:12:27.83,0:12:29.45,Default,,0,0,0,,Күтіңіз!
Dialogue: 0,0:12:29.54,0:12:32.75,Default,,0,0,0,,Күте тұрыңыз, жоқ, мен ештеңе істемеймін.
Dialogue: 0,0:12:33.25,0:12:35.62,Default,,0,0,0,,Сізге ештеңе істеудің қажеті жоқ
Dialogue: 0,0:12:35.71,0:12:37.25,Default,,0,0,0,,Қоқыс - қоқыс
Dialogue: 0,0:12:43.84,0:12:45.80,Default,,0,0,0,,Шинго ағай!
Dialogue: 0,0:12:45.89,0:12:47.51,Default,,0,0,0,,Эй, сұм әке.
Dialogue: 0,0:12:47.60,0:12:49.01,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:12:50.77,0:12:51.81,Default,,0,0,0,,Уау! (Шайтан-кун) Не!
Dialogue: 0,0:12:51.89,0:12:53.14,Default,,0,0,0,,Не деген сұмдық! (100 көз) Уау!
Dialogue: 0,0:12:53.81,0:12:55.90,Default,,0,0,0,,I… Чи… Роу…
Dialogue: 0,0:12:57.65,0:12:58.52,Default,,0,0,0,,Ай…
Dialogue: 0,0:12:59.98,0:13:03.11,Default,,0,0,0,,Маған қолайсыздықтан құтылу керек.
Dialogue: 0,0:13:03.78,0:13:04.74,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:13:07.82,0:13:09.03,Default,,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:13:09.12,0:13:09.78,Default,,0,0,0,,Не?
Dialogue: 0,0:13:10.83,0:13:12.87,Default,,0,0,0,,Әкем мұны маған бұрын да айтқан.
Dialogue: 0,0:13:13.37,0:13:15.21,Default,,0,0,0,,Мен жартылай адаммын
Dialogue: 0,0:13:15.87,0:13:19.92,Default,,0,0,0,,Сонымен, егер менің ішімдегі шайтанның күші толығымен оянса,
Dialogue: 0,0:13:20.50,0:13:25.05,Default,,0,0,0,,Оны адам ақылымен басқара алмай, бақылаудан шығып кетеді...
Dialogue: 0,0:13:26.22,0:13:27.89,Default,,0,0,0,,Сонымен, егер...
Dialogue: 0,0:13:28.39,0:13:32.31,Default,,0,0,0,,Егер мен бақылаудан шығып кетсем, мені өлтіріңіз.
Dialogue: 0,0:13:33.89,0:13:36.02,Default,,0,0,0,,Мен... сен бе?
Dialogue: 0,0:13:36.52,0:13:37.69,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:40.02,0:13:41.11,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:42.94,0:13:44.19,Default,,0,0,0,,Бұл болар ма…
Dialogue: 0,0:13:50.53,0:13:53.99,Default,,0,0,0,,Осылай күресетіндер адам емес пе?
Dialogue: 0,0:13:54.50,0:13:56.46,Default,,0,0,0,,Күреспе!
Dialogue: 0,0:13:56.54,0:13:58.71,Default,,0,0,0,,Мойындамайтын жүрек дейді!
Dialogue: 0,0:13:58.79,0:14:01.09,Default,,0,0,0,,Сиқырлы жалынның сәулеленуі~!
Dialogue: 0,0:14:01.59,0:14:03.09,Default,,0,0,0,,Максималды қуат!
Dialogue: 0,0:14:04.38,0:14:05.84,Default,,0,0,0,,Керемет доп
Dialogue: 0,0:14:05.92,0:14:07.09,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:07.17,0:14:09.76,Default,,0,0,0,,Ол менің сиқырлы күшімді сорып жатыр.
Dialogue: 0,0:14:09.84,0:14:10.34,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:14:11.93,0:14:14.01,Default,,0,0,0,,Олай болса менің кезегім!
Dialogue: 0,0:14:18.73,0:14:20.90,Default,,0,0,0,,Алмаделдің төрт биігі
Dialogue: 0,0:14:20.98,0:14:22.69,Default,,0,0,0,,Лемегетонда жазылған
Dialogue: 0,0:14:23.19,0:14:25.90,Default,,0,0,0,,Аты белгісіз біреудің ілімінде
Dialogue: 0,0:14:26.40,0:14:29.36,Default,,0,0,0,,Жер қойнауынан өсетін өмір ағашы
Dialogue: 0,0:14:33.16,0:14:34.87,Default,,0,0,0,,Жоғалып кеткен құбыжық...
Dialogue: 0,0:14:34.95,0:14:38.33,Default,,0,0,0,,Сіз бұл жақсы жол дедіңіз, бірақ...
Dialogue: 0,0:14:38.41,0:14:40.04,Default,,0,0,0,,Фрезияға ұсыныстар…
Dialogue: 0,0:14:40.12,0:14:41.96,Default,,0,0,0,,Жоқ, сіз оны пайдалана алмайсыз.
Dialogue: 0,0:14:42.04,0:14:43.84,Default,,0,0,0,,Сонымен, бұл Тешу киелі мерекесі ме?
Dialogue: 0,0:14:44.92,0:14:46.38,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:14:46.46,0:14:47.34,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:47.97,0:14:49.84,Default,,0,0,0,,Тағы қызыл қан?
Dialogue: 0,0:14:50.38,0:14:51.51,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:51.59,0:14:53.60,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:53.68,0:14:54.43,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:54.51,0:14:55.93,Default,,0,0,0,,Ахх!
Dialogue: 0,0:14:56.02,0:14:56.81,Default,,0,0,0,,Аһ!
Dialogue: 0,0:14:57.52,0:14:59.94,Default,,0,0,0,,Сиқырлы қуат Мүйіз электр тогының соғуы!
Dialogue: 0,0:15:00.02,0:15:01.94,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:15:02.69,0:15:04.27,Default,,0,0,0,,Каку Денгеки...
Dialogue: 0,0:15:04.36,0:15:06.94,Default,,0,0,0,,Оны пайдалану ауыр болуы керек.
Dialogue: 0,0:15:07.03,0:15:08.94,Default,,0,0,0,,Гуо... Гу...
Dialogue: 0,0:15:10.11,0:15:11.45,Default,,0,0,0,,Гуа…
Dialogue: 0,0:15:11.53,0:15:13.03,Default,,0,0,0,,Сәлем, Президент мырза! (100 көз) Ия!
Dialogue: 0,0:15:13.82,0:15:14.91,Default,,0,0,0,,Гррр…
Dialogue: 0,0:15:30.13,0:15:31.84,Default,,0,0,0,,Бұл қауіпті! Бұл ақылсыз!
Dialogue: 0,0:15:35.30,0:15:36.89,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:36.97,0:15:38.85,Default,,0,0,0,,Оян! Оян! (100 көз) Мефисто III!
Dialogue: 0,0:15:39.43,0:15:40.35,Default,,0,0,0,,Мефисто…
Dialogue: 0,0:15:42.06,0:15:42.65,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:15:42.73,0:15:43.73,Default,,0,0,0,,Қаха…
Dialogue: 0,0:15:45.31,0:15:46.48,Default,,0,0,0,,А... (100 көз) А...
Dialogue: 0,0:15:46.57,0:15:48.07,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:15:48.57,0:15:50.61,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:55.45,0:15:57.37,Default,,0,0,0,,Бұл өте қарапайым.
Dialogue: 0,0:15:58.29,0:16:00.41,Default,,0,0,0,,Мефисто III!
Dialogue: 0,0:16:00.50,0:16:01.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:01.08,0:16:03.50,Default,,0,0,0,,А, сен амансың.
Dialogue: 0,0:16:03.58,0:16:04.88,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:16:10.67,0:16:11.63,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:16:11.72,0:16:13.55,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:16:17.30,0:16:18.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:18.35,0:16:20.22,Default,,0,0,0,,(Мефисто III-нің ырылдауы)
Dialogue: 0,0:16:24.23,0:16:27.40,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:16:27.98,0:16:31.78,Default,,0,0,0,,Жартылай адамның жынға айналуы қорқынышты.
Dialogue: 0,0:16:31.86,0:16:34.95,Default,,0,0,0,,Мен қашуым керек! Ха, мен тез қашуым керек!
Dialogue: 0,0:16:35.03,0:16:36.41,Default,,0,0,0,,Қашпайтын дүйсенбі
Dialogue: 0,0:16:36.49,0:16:39.58,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:40.62,0:16:42.25,Default,,0,0,0,,Бұл уәде болды.
Dialogue: 0,0:16:43.12,0:16:45.21,Default,,0,0,0,,Фуркасварам Анголкам
Dialogue: 0,0:16:45.29,0:16:47.71,Default,,0,0,0,,Фуркасварам Анголкам
Dialogue: 0,0:16:48.21,0:16:52.05,Default,,0,0,0,,Жартаста жатқан рух, менің күш-қуатым бол.
Dialogue: 0,0:16:52.55,0:16:54.38,Default,,0,0,0,,Менің күшім бол!
Dialogue: 0,0:16:54.47,0:16:55.51,Default,,0,0,0,,Ай…
Dialogue: 0,0:16:56.39,0:16:59.01,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:59.10,0:17:01.60,Default,,0,0,0,,Мефисто III…
Dialogue: 0,0:17:01.68,0:17:02.52,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:17:02.60,0:17:04.52,Default,,0,0,0,,Мефисто III!
Dialogue: 0,0:17:04.60,0:17:06.27,Default,,0,0,0,,Оян!
Dialogue: 0,0:17:06.77,0:17:08.77,Default,,0,0,0,,Біз доспыз!
Dialogue: 0,0:17:08.86,0:17:10.82,Default,,0,0,0,,Біздің бетімізге қара!
Dialogue: 0,0:17:10.90,0:17:12.53,Default,,0,0,0,,(Қорыққан екі дауыс)
Dialogue: 0,0:17:12.61,0:17:14.53,Default,,0,0,0,,...
Dialogue: 0,0:17:14.61,0:17:16.28,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:17:16.36,0:17:16.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:17.03,0:17:19.91,Default,,0,0,0,,Сабуймон... (Жарқанат мысық) Сиқырлы котацу бар дөңгелек...
Dialogue: 0,0:17:20.87,0:17:26.29,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:17:26.37,0:17:27.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:33.01,0:17:34.92,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:17:41.76,0:17:46.69,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:17:50.69,0:17:52.61,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:17:56.36,0:17:58.41,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:18:02.62,0:18:03.99,Default,,0,0,0,,(Айзава) Бірінші жекпе-жек бойынша ой елегінен өткізуге арналған негізгі тармақтарды айтыңыз
Dialogue: 0,0:18:04.08,0:18:07.29,Default,,0,0,0,,Мені өз қолыңмен өлтір, Аешма.
Dialogue: 0,0:18:15.67,0:18:18.68,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:18:24.06,0:18:25.68,Default,,0,0,0,,…
Dialogue: 0,0:18:25.77,0:18:29.73,Default,,0,0,0,,Егер мен бақылаудан шығып кетсем, мені өлтіріңіз.
Dialogue: 0,0:18:30.52,0:18:32.77,Default,,0,0,0,,Мен... сен бе?
Dialogue: 0,0:18:32.86,0:18:34.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:38.20,0:18:39.95,Default,,0,0,0,,Өйткені бұл уәде
Dialogue: 0,0:18:40.49,0:18:41.57,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:43.66,0:18:44.79,Default,,0,0,0,,Сіз...
Dialogue: 0,0:18:48.54,0:18:49.67,Default,,0,0,0,,Не?
Dialogue: 0,0:18:50.67,0:18:52.92,Default,,0,0,0,,Бұл не... сезім?
Dialogue: 0,0:19:10.94,0:19:12.06,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:23.12,0:19:24.45,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:19:25.66,0:19:29.16,Default,,0,0,0,,Бұл жауап шынымен дұрыс па?
Dialogue: 0,0:19:30.46,0:19:31.62,Default,,0,0,0,,Мефисто…
Dialogue: 0,0:19:35.29,0:19:35.79,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:19:37.13,0:19:38.80,Default,,0,0,0,,(жаншылған дыбыс)
Dialogue: 0,0:19:38.88,0:19:40.26,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:40.84,0:19:43.80,Default,,0,0,0,,...
Dialogue: 0,0:19:43.89,0:19:46.76,Default,,0,0,0,,Сүлейменнің сыбызғы үзіліп жатыр
Dialogue: 0,0:19:47.26,0:19:48.81,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,0:19:50.39,0:19:52.69,Default,,0,0,0,,Басында мен болдым, солай ма?
Dialogue: 0,0:19:53.19,0:19:56.40,Default,,0,0,0,,Сен мені жоғалтқанда бұзыла бастады
Dialogue: 0,0:19:57.90,0:20:01.99,Default,,0,0,0,,Ол мені сенен алған кезде
Dialogue: 0,0:20:03.41,0:20:05.32,Default,,0,0,0,,...
Dialogue: 0,0:20:05.41,0:20:06.83,Default,,0,0,0,,Мен босмын
Dialogue: 0,0:20:07.99,0:20:12.33,Default,,0,0,0,,Саған рахмет, Сүлейменнің сыбызғы жоқ.
Dialogue: 0,0:20:12.41,0:20:14.83,Default,,0,0,0,,Бұл адам не істейді?
Dialogue: 0,0:20:14.92,0:20:18.34,Default,,0,0,0,,Оны жарық ретінде шығару да ашуландырады.
Dialogue: 0,0:20:18.42,0:20:21.84,Default,,0,0,0,,Мен сені толық жоққа түсірейін бе?
Dialogue: 0,0:20:22.55,0:20:25.09,Default,,0,0,0,,...
Dialogue: 0,0:20:29.93,0:20:32.98,Default,,0,0,0,,“”
Dialogue: 0,0:20:35.06,0:20:38.86,Default,,0,0,0,,Материалдық әлем сіздің миыңыз үшін тым кішкентай.
Dialogue: 0,0:20:39.82,0:20:44.82,Default,,0,0,0,,Мен саған сен білмейтін нәрселерді көбірек үйретемін.
Dialogue: 0,0:20:45.32,0:20:48.95,Default,,0,0,0,,Сіз білмейтін сияқтысыз, мен сізге айтайын.
Dialogue: 0,0:20:49.66,0:20:50.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:50.79,0:20:52.87,Default,,0,0,0,,...
Dialogue: 0,0:20:54.21,0:20:58.34,Default,,0,0,0,,Сүлеймен сыбызғы жүрекпен ойналады.
Dialogue: 0,0:20:58.84,0:21:01.51,Default,,0,0,0,,...
Dialogue: 0,0:21:02.67,0:21:04.30,Default,,0,0,0,,...
Dialogue: 0,0:21:04.38,0:21:07.80,Default,,0,0,0,,Біріншіден, ол материалдық дүниені білу арқылы жасалды.
Dialogue: 0,0:21:08.60,0:21:10.85,Default,,0,0,0,,...
Dialogue: 0,0:21:11.97,0:21:13.48,Default,,0,0,0,,Бұл қоқыс
Dialogue: 0,0:21:13.56,0:21:14.85,Default,,0,0,0,,（）
Dialogue: 0,0:21:14.94,0:21:15.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:16.60,0:21:18.02,Default,,0,0,0,,Уф… Э-э… Жарақатың жазылды ма?
Dialogue: 0,0:21:18.11,0:21:20.40,Default,,0,0,0,,Оның шырылдамауының себебі Сүлейменнің сыбызғы емес.
Dialogue: 0,0:21:21.86,0:21:23.40,Default,,0,0,0,,...
Dialogue: 0,0:21:23.49,0:21:25.90,Default,,0,0,0,,（）
Dialogue: 0,0:21:25.99,0:21:27.99,Default,,0,0,0,,♪～
Dialogue: 0,0:21:31.62,0:21:33.33,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:21:33.41,0:21:35.41,Default,,0,0,0,,…
Dialogue: 0,0:21:47.97,0:21:51.39,Default,,0,0,0,,...
Dialogue: 0,0:21:51.47,0:21:56.48,Default,,0,0,0,,Менен алмақ болған ешнәрсе жоғалған жоқ.
Dialogue: 0,0:21:56.98,0:21:58.19,Default,,0,0,0,,Эй, Эйшма...
Dialogue: 0,0:21:58.27,0:22:00.23,Default,,0,0,0,,...
Dialogue: 0,0:22:00.31,0:22:01.40,Default,,0,0,0,,Аешма!
Dialogue: 0,0:22:01.48,0:22:04.57,Default,,0,0,0,,Уф... Аешма Аешма А...
Dialogue: 0,0:22:22.75,0:22:24.76,Default,,0,0,0,,～♪
Dialogue: 0,0:22:27.63,0:22:28.26,Default,,0,0,0,,О!
Dialogue: 0,0:22:28.34,0:22:30.30,Default,,0,0,0,,Күте тұр… Демек, мені соңында ұмытып қалдыңдар ма?
Dialogue: 0,0:22:35.14,0:22:36.35,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:22:39.10,0:22:40.77,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:22:40.85,0:22:42.27,Default,,0,0,0,,Уау, бұл дәмді көрінеді!
Dialogue: 0,0:22:42.36,0:22:44.52,Default,,0,0,0,,Амансың ба? бізге байланысты
Dialogue: 0,0:22:44.61,0:22:46.07,Default,,0,0,0,,Иә, бәріміз де тойлайық.
Dialogue: 0,0:22:46.15,0:22:48.99,Default,,0,0,0,,...
Dialogue: 0,0:22:49.07,0:22:51.11,Default,,0,0,0,,Бәрі жақсы, иә.
Dialogue: 0,0:22:51.82,0:22:53.99,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:22:54.91,0:22:56.08,Default,,0,0,0,,Ммм, дәмді
Dialogue: 0,0:22:56.16,0:22:57.91,Default,,0,0,0,,Иә, бұл рас.
Dialogue: 0,0:22:58.00,0:22:59.96,Default,,0,0,0,,Бұл менің анамның рецепті.
Dialogue: 0,0:23:00.04,0:23:01.96,Default,,0,0,0,,Бұл әлі де ең жақсысы
Dialogue: 0,0:23:02.04,0:23:03.50,Default,,0,0,0,,Рахмет Ичиро
Dialogue: 0,0:23:03.59,0:23:06.38,Default,,0,0,0,,(кеспенің шырылдаған дыбысы)
Dialogue: 0,0:23:06.46,0:23:08.67,Default,,0,0,0,,...
Dialogue: 0,0:23:08.76,0:23:10.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:11.72,0:23:14.22,Default,,0,0,0,,Ең жақсысы татулық.
Dialogue: 0,0:23:14.30,0:23:17.18,Default,,0,0,0,,«Мыңжылдық мақсаты»
Dialogue: 0,0:23:19.23,0:23:22.44,Default,,0,0,0,,(шаңсорғыш моторының дыбысы)
Dialogue: 0,0:23:22.52,0:23:23.48,Default,,0,0,0,,Жақсы, бірақ...
Dialogue: 0,0:23:23.56,0:23:25.57,Default,,0,0,0,,Жартылай адам болғаныма қуаныштымын
Dialogue: 0,0:23:25.65,0:23:27.07,Default,,0,0,0,,Шайтан болған дұрыс па?
Dialogue: 0,0:23:27.15,0:23:28.44,Default,,0,0,0,,Сонымен
Dialogue: 0,0:23:28.53,0:23:29.86,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:23:29.95,0:23:33.12,Default,,0,0,0,,Сен мені атып алсаң да, мен аман қалдым.
Dialogue: 0,0:23:33.62,0:23:36.54,Default,,0,0,0,,Тас-қағаз-қайшы нәтижесін ұмытпаңыз
Dialogue: 0,0:23:36.62,0:23:37.58,Default,,0,0,0,,Нихаха
Dialogue: 0,0:23:37.66,0:23:40.33,Default,,0,0,0,,Жоқ, жоқ, бұл енді жарамсыз.
Dialogue: 0,0:23:40.41,0:23:41.92,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:23:45.54,0:23:47.71,Default,,0,0,0,,Иә? Қарсы болмайсыз ба?
Dialogue: 0,0:23:48.88,0:23:49.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:49.51,0:23:50.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:53.76,0:23:56.05,Default,,0,0,0,,Уау
Dialogue: 0,0:23:56.14,0:23:59.18,Default,,0,0,0,,Уәделерді орындау керек.
Dialogue: 0,0:24:00.52,0:24:06.02,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:24:06.52,0:24:08.94,Default,,0,0,0,,Уа... аа...
Dialogue: 0,0:24:10.28,0:24:12.45,Default,,0,0,0,,Білесің бе, ешкім қарап тұрған жоқ болса да, солай қажырлы еңбек ету.
Dialogue: 0,0:24:20.12,0:24:20.66,Default,,0,0,0,,Фу…
Dialogue: 0,0:24:20.75,0:24:22.75,Default,,0,0,0,,♪～
Dialogue: 0,0:26:34.80,0:26:36.80,Default,,0,0,0,,～♪
Dialogue: 0,0:26:38.30,0:26:44.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory