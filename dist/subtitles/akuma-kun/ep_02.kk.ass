Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:20.43,0:00:21.93,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:00:24.14,0:00:27.56,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:00:27.65,0:00:28.31,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:28.40,0:00:29.23,Default,,0,0,0,,(құбыжықтың ыңырсыуы)
Dialogue: 0,0:00:32.78,0:00:34.20,Default,,0,0,0,,Ағай
Dialogue: 0,0:00:34.95,0:00:36.36,Default,,0,0,0,,Сіз ақымақ әкесіз бе?
Dialogue: 0,0:00:37.28,0:00:38.41,Default,,0,0,0,,Бұл міндеттеме болса да
Dialogue: 0,0:00:38.49,0:00:41.54,Default,,0,0,0,,Әкеңе не айтып тұрсың?
Dialogue: 0,0:00:42.45,0:00:43.62,Default,,0,0,0,,Үй меңгерушісі
Dialogue: 0,0:00:43.71,0:00:47.71,Default,,0,0,0,,Жасы ұлғайғанына қарамастан, ол әлі күнге дейін жадағай киіп, ескі таяқ ұстайды.
Dialogue: 0,0:00:47.79,0:00:48.63,Default,,0,0,0,,Эй!
Dialogue: 0,0:00:48.71,0:00:52.59,Default,,0,0,0,,Бұл бізге доктор Фаусттың өсиетін мұра еткендігіміздің дәлелі.
Dialogue: 0,0:00:54.09,0:00:55.43,Default,,0,0,0,,Бұрынғы жігіт...
Dialogue: 0,0:00:55.93,0:00:56.89,Default,,0,0,0,,Ол кетті
Dialogue: 0,0:00:56.97,0:01:00.14,Default,,0,0,0,,Бұл негізгі дене емес, ол көлеңкеге көбірек ұқсайды.
Dialogue: 0,0:01:02.89,0:01:04.64,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:01:08.81,0:01:09.77,Default,,0,0,0,,Хмм.
Dialogue: 0,0:01:14.82,0:01:15.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:15.61,0:01:16.53,Default,,0,0,0,,Ичика!
Dialogue: 0,0:01:17.36,0:01:18.74,Default,,0,0,0,,Ичика
Dialogue: 0,0:01:20.62,0:01:22.54,Default,,0,0,0,,Үлкен қызба
Dialogue: 0,0:01:25.08,0:01:27.29,Default,,0,0,0,,Рахмет, III мырза.
Dialogue: 0,0:01:27.79,0:01:29.75,Default,,0,0,0,,Менің үйіме анда-санда тоқтауыңызды өтінемін.
Dialogue: 0,0:01:30.25,0:01:31.29,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:31.80,0:01:32.63,Default,,0,0,0,,Ичиро
Dialogue: 0,0:01:32.71,0:01:34.34,Default,,0,0,0,,Егер мен осы сәтте селт етсем,
Dialogue: 0,0:01:34.42,0:01:37.13,Default,,0,0,0,,Мыңжылдыққа апаратын жол ұзақ.
Dialogue: 0,0:01:37.22,0:01:38.51,Default,,0,0,0,,Қараңыз, міне осы ғой?
Dialogue: 0,0:01:38.59,0:01:40.80,Default,,0,0,0,,Маған қалдырсаң, аузыңды жап.
Dialogue: 0,0:01:47.73,0:01:49.06,Default,,0,0,0,,Әке
Dialogue: 0,0:01:49.56,0:01:51.56,Default,,0,0,0,,♪～
Dialogue: 0,0:02:03.49,0:02:05.50,Default,,0,0,0,,～♪
Dialogue: 0,0:02:08.79,0:02:11.08,Default,,0,0,0,,Қалыпты ештеңе жоқ сияқты.
Dialogue: 0,0:02:11.92,0:02:14.67,Default,,0,0,0,,Дәрігер сізге шамадан тыс жұмыс істеуі мүмкін деді.
Dialogue: 0,0:02:15.17,0:02:17.80,Default,,0,0,0,,Уайымдама, мен жақында оянамын.
Dialogue: 0,0:02:18.30,0:02:19.18,Default,,0,0,0,,Иә
Dialogue: 0,0:02:19.68,0:02:21.30,Default,,0,0,0,,Хмм…
Dialogue: 0,0:02:22.68,0:02:27.43,Default,,0,0,0,,Мен ешқашан жындар бар деп ойлаған емеспін.
Dialogue: 0,0:02:27.93,0:02:28.60,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:02:28.69,0:02:30.10,Default,,0,0,0,,Иса
Dialogue: 0,0:02:31.44,0:02:32.81,Default,,0,0,0,,Барлық жерде.
Dialogue: 0,0:02:33.31,0:02:37.24,Default,,0,0,0,,Менің көргенім бұл түс емес пе?
Dialogue: 0,0:02:37.32,0:02:38.49,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:02:38.99,0:02:40.49,Default,,0,0,0,,Мынаны да оған бер
Dialogue: 0,0:02:42.16,0:02:44.83,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:02:45.33,0:02:48.75,Default,,0,0,0,,Мм... бұрын маған көмектескен бала...
Dialogue: 0,0:02:48.83,0:02:51.92,Default,,0,0,0,,Шинго Умеки - алдыңғы шайтан.
Dialogue: 0,0:02:52.00,0:02:53.25,Default,,0,0,0,,Алдыңғы?
Dialogue: 0,0:02:53.33,0:02:55.80,Default,,0,0,0,,Ол менің қайын атам.
Dialogue: 0,0:02:56.30,0:02:57.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:57.34,0:02:58.38,Default,,0,0,0,,Мен оянғанда
Dialogue: 0,0:02:58.46,0:03:01.97,Default,,0,0,0,,Сакура Йосикавамен қарым-қатынасым туралы сұраңыз.
Dialogue: 0,0:03:04.18,0:03:05.35,Default,,0,0,0,,Ичика…
Dialogue: 0,0:03:07.85,0:03:09.60,Default,,0,0,0,,«Олар әрдайым ашық қалып қояды», – деді олар
Dialogue: 0,0:03:09.68,0:03:10.52,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:03:10.60,0:03:12.10,Default,,0,0,0,,Екеуі де.
Dialogue: 0,0:03:12.19,0:03:13.86,Default,,0,0,0,,Хина-чан да, Ичика-чан да
Dialogue: 0,0:03:14.36,0:03:15.65,Default,,0,0,0,,Ол кедей ауданда көшедегі бала болып жүрген шығар, иә?
Dialogue: 0,0:03:16.19,0:03:17.53,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:17.61,0:03:20.74,Default,,0,0,0,,Менің алдыңғы ағам айтқандай, бұл көлеңке.
Dialogue: 0,0:03:21.24,0:03:23.36,Default,,0,0,0,,Негізгі бөлім басқа жерде
Dialogue: 0,0:03:23.87,0:03:27.20,Default,,0,0,0,,Менде әкемдей сиқыр болғанын қалаймын.
Dialogue: 0,0:03:29.37,0:03:30.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:30.21,0:03:31.08,Default,,0,0,0,,Ичика
Dialogue: 0,0:03:31.58,0:03:32.79,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:03:32.87,0:03:33.83,Default,,0,0,0,,Аурухана
Dialogue: 0,0:03:34.33,0:03:37.42,Default,,0,0,0,,Мама үйге киім ауыстыруға бара жатыр.
Dialogue: 0,0:03:39.76,0:03:41.38,Default,,0,0,0,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:03:46.80,0:03:48.18,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:03:48.26,0:03:52.64,Default,,0,0,0,,Мен бұл жігіттер өлген болуы керек деп ойладым.
Dialogue: 0,0:03:52.73,0:03:53.69,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:03:53.77,0:03:55.61,Default,,0,0,0,,Бұл Ичиканың кінәсі емес
Dialogue: 0,0:03:55.69,0:03:57.11,Default,,0,0,0,,Бұл шайтанның ісі
Dialogue: 0,0:03:57.61,0:03:58.94,Default,,0,0,0,,Ібіліс?
Dialogue: 0,0:03:59.03,0:04:01.03,Default,,0,0,0,,Өйткені мен қарғадым...
Dialogue: 0,0:04:01.11,0:04:03.86,Default,,0,0,0,,Жоқ, мұның бәрі шайтан.
Dialogue: 0,0:04:04.36,0:04:07.66,Default,,0,0,0,,Өйткені оның Сакура Йосикаваға қатысы жоқ, солай ма?
Dialogue: 0,0:04:08.16,0:04:11.79,Default,,0,0,0,,Йошикава мырза... Йошикава мырза да?
Dialogue: 0,0:04:11.87,0:04:12.96,Default,,0,0,0,,Иә
Dialogue: 0,0:04:13.04,0:04:16.79,Default,,0,0,0,,Мен олардың анда-санда кездескенін көрдім, бірақ олар жақын емес, солай ма?
Dialogue: 0,0:04:18.17,0:04:18.80,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:20.21,0:04:24.80,Default,,0,0,0,,Мен Йосикава мырзамен Ширайши және оның достары туралы кеңес алдым.
Dialogue: 0,0:04:25.39,0:04:28.18,Default,,0,0,0,,Йошикаваның әкесі заңгер.
Dialogue: 0,0:04:28.68,0:04:29.72,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:04:29.81,0:04:31.31,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:04:31.81,0:04:33.85,Default,,0,0,0,,Енді ештеңе айтудың қажеті жоқ
Dialogue: 0,0:04:34.44,0:04:36.40,Default,,0,0,0,,Ичика жаман емес.
Dialogue: 0,0:04:36.98,0:04:41.15,Default,,0,0,0,,Ичикаға көмектесе алмағаныма өкінемін.
Dialogue: 0,0:04:41.65,0:04:45.32,Default,,0,0,0,,Жоқ, маған Хина кеңес берді.
Dialogue: 0,0:04:45.41,0:04:47.74,Default,,0,0,0,,Сұрамаған мен едім.
Dialogue: 0,0:04:48.24,0:04:50.20,Default,,0,0,0,,Ичиканы тоқтата алмады
Dialogue: 0,0:04:50.70,0:04:52.41,Default,,0,0,0,,Мен мұны істей алмадым
Dialogue: 0,0:04:52.95,0:04:54.33,Default,,0,0,0,,(Құбыжықтың дауысы)
Dialogue: 0,0:04:54.41,0:04:55.37,Default,,0,0,0,,Не?
Dialogue: 0,0:04:55.46,0:04:57.08,Default,,0,0,0,,Қандай дыбыс? дауыс?
Dialogue: 0,0:04:57.17,0:05:00.34,Default,,0,0,0,,Біз жақын дос болсақ та, кешіріңіздер
Dialogue: 0,0:05:05.43,0:05:06.80,Default,,0,0,0,,Мынаны алыңыз
Dialogue: 0,0:05:07.43,0:05:08.47,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:08.97,0:05:11.35,Default,,0,0,0,,Тұмар, мүмкін бойтұмар
Dialogue: 0,0:05:12.27,0:05:13.93,Default,,0,0,0,,Ичика - Ичика
Dialogue: 0,0:05:14.43,0:05:15.85,Default,,0,0,0,,Біз мәңгі дос боламыз
Dialogue: 0,0:05:17.06,0:05:18.27,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:23.57,0:05:25.86,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:05:34.20,0:05:35.37,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:44.96,0:05:46.67,Default,,0,0,0,,(Құбыжықтың дауысы)
Dialogue: 0,0:05:46.76,0:05:48.89,Default,,0,0,0,,(Косей) Аа, дұрыс. Шыны мен ауыстыратын киім—
Dialogue: 0,0:05:48.97,0:05:50.89,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:05:50.97,0:05:52.14,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:05:53.31,0:05:55.22,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:05:55.31,0:05:56.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:57.23,0:05:59.73,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:05:59.81,0:06:02.19,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:06:02.90,0:06:04.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:05.36,0:06:06.78,Default,,0,0,0,,Кя!
Dialogue: 0,0:06:07.40,0:06:10.70,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:06:16.45,0:06:18.71,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:19.58,0:06:21.00,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:06:21.08,0:06:22.17,Default,,0,0,0,,Ібіліс-күн!
Dialogue: 0,0:06:22.67,0:06:25.21,Default,,0,0,0,,Сәлем! Оян, шайтан-күн
Dialogue: 0,0:06:25.30,0:06:26.76,Default,,0,0,0,,Эй, оян!
Dialogue: 0,0:06:26.84,0:06:28.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:29.01,0:06:31.68,Default,,0,0,0,,Бұл қорқынышты. Ичика-чанға шабуыл жасалды.
Dialogue: 0,0:06:31.76,0:06:33.76,Default,,0,0,0,,Хина-чан маған хабарласты.
Dialogue: 0,0:06:33.85,0:06:37.68,Default,,0,0,0,,Ол аман қалды, бірақ бүкіл денесін шауып тастады.
Dialogue: 0,0:06:37.77,0:06:40.69,Default,,0,0,0,,Хмм, не болды?
Dialogue: 0,0:06:40.77,0:06:42.73,Default,,0,0,0,,Қандай жағдай болмасын, бұл үлкен мәселе.
Dialogue: 0,0:06:43.23,0:06:45.44,Default,,0,0,0,,Сіз тұмар тақпаған шығарсыз.
Dialogue: 0,0:06:45.53,0:06:47.61,Default,,0,0,0,,Бірақ бірінші кезекте Ичика-чан
Dialogue: 0,0:06:47.69,0:06:50.20,Default,,0,0,0,,Пентаграммамен қорғалуы керек емес пе?
Dialogue: 0,0:06:50.28,0:06:54.08,Default,,0,0,0,,Пентаграмма кері бұрылса, ол қарғыс атқан жұлдызға айналады.
Dialogue: 0,0:06:54.91,0:06:58.45,Default,,0,0,0,,Бұл сурет салған адамның орнына байланысты, сондықтан мұнда таңқаларлық ештеңе жоқ.
Dialogue: 0,0:06:58.54,0:07:01.33,Default,,0,0,0,,Сонымен, мұндай жағдай болуы мүмкін екенін білдіңіз бе?
Dialogue: 0,0:07:01.83,0:07:03.25,Default,,0,0,0,,Бұл күтуге болады.
Dialogue: 0,0:07:03.75,0:07:05.71,Default,,0,0,0,,Күтулер шегінде не бар?
Dialogue: 0,0:07:05.80,0:07:07.76,Default,,0,0,0,,Мүмкіндікті жоққа шығаруға болмайды
Dialogue: 0,0:07:08.26,0:07:09.59,Default,,0,0,0,,Алдымен айтыңыз.
Dialogue: 0,0:07:10.09,0:07:11.43,Default,,0,0,0,,Бұлай айтсаң не болады?
Dialogue: 0,0:07:11.51,0:07:12.72,Default,,0,0,0,,Мен сені қорғай алдым.
Dialogue: 0,0:07:12.80,0:07:16.22,Default,,0,0,0,,Оның орнына какао қосыңыз.
Dialogue: 0,0:07:16.31,0:07:17.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:18.06,0:07:19.14,Default,,0,0,0,,Сіз...
Dialogue: 0,0:07:19.23,0:07:21.27,Default,,0,0,0,,Сенің сиқырлы күшің бәрібір мені қорғай алмайды.
Dialogue: 0,0:07:21.77,0:07:24.11,Default,,0,0,0,,Түсінсеңіз, какао қосыңыз.
Dialogue: 0,0:07:28.15,0:07:31.36,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:07:35.95,0:07:37.62,Default,,0,0,0,,(контроллер жұмысының дыбысы)
Dialogue: 0,0:07:37.70,0:07:38.79,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:07:39.45,0:07:40.37,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:07:44.25,0:07:45.63,Default,,0,0,0,,(тоңазытқыш есігінің ашылған дыбысы)
Dialogue: 0,0:07:47.17,0:07:48.13,Default,,0,0,0,,(тоңазытқыш есігінің жабылу дыбысы)
Dialogue: 0,0:07:48.71,0:07:51.22,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:07:54.84,0:07:58.26,Default,,0,0,0,,(Насиро) Рей! (Сузуя) Ол қазір Джузо~
Dialogue: 0,0:08:01.10,0:08:02.27,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:03.94,0:08:04.48,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:08:04.56,0:08:07.36,Default,,0,0,0,,Бүгінгі қажырлы еңбегіңіз үшін рахмет, Экчан
Dialogue: 0,0:08:07.86,0:08:11.03,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Кешкі асқа не бар?
Dialogue: 0,0:08:11.11,0:08:13.07,Default,,0,0,0,,Жаңа піскен орамалдар мен наси горенг
Dialogue: 0,0:08:13.57,0:08:15.41,Default,,0,0,0,,Әрине, ол кориандрмен толтырылған.
Dialogue: 0,0:08:15.49,0:08:17.24,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:08:20.45,0:08:23.75,Default,,0,0,0,,Сонда бұл бала несіне ашуланды?
Dialogue: 0,0:08:24.25,0:08:26.63,Default,,0,0,0,,Ичиро-кунмен төбелескен көрінеді.
Dialogue: 0,0:08:26.71,0:08:27.54,Default,,0,0,0,,Раббым!
Dialogue: 0,0:08:28.13,0:08:29.75,Default,,0,0,0,,Ол жігіт ең нашар.
Dialogue: 0,0:08:33.38,0:08:34.88,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:35.38,0:08:40.31,Default,,0,0,0,,Сакура Йосикава тек Ичика Цучиядан кеңес алды.
Dialogue: 0,0:08:41.39,0:08:42.43,Default,,0,0,0,,Иә
Dialogue: 0,0:08:42.93,0:08:43.89,Default,,0,0,0,,Қазірге дейін мен—
Dialogue: 0,0:08:43.98,0:08:48.23,Default,,0,0,0,,Бұл менің шегерімімнің дұрыс екенін білдіреді...
Dialogue: 0,0:08:48.73,0:08:50.32,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:08:50.40,0:08:51.86,Default,,0,0,0,,Ол кешкі ас кезінде кенеттен келді.
Dialogue: 0,0:08:51.94,0:08:54.49,Default,,0,0,0,,Маған құймақ жеп, болжам жасауға рұқсат етіңіз!
Dialogue: 0,0:08:54.57,0:08:58.53,Default,,0,0,0,,Бұл үйде шайтан бар екеніне күмән жоқ.
Dialogue: 0,0:08:59.03,0:09:00.83,Default,,0,0,0,,Адамзат әлемінде зұлымдық жасайтын шайтан
Dialogue: 0,0:09:01.37,0:09:03.79,Default,,0,0,0,,Жындар әлеміне қайта жіберу керек
Dialogue: 0,0:09:06.17,0:09:10.25,Default,,0,0,0,,Сіздің ата-анаңыздың екеуі де Батыс тарихынан хабардар.
Dialogue: 0,0:09:11.00,0:09:11.84,Default,,0,0,0,,Егер
Dialogue: 0,0:09:12.71,0:09:14.59,Default,,0,0,0,,Сіз жындар туралы көп білесіз, солай ма?
Dialogue: 0,0:09:14.67,0:09:15.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:20.39,0:09:21.10,Default,,0,0,0,,Ha
Dialogue: 0,0:09:21.68,0:09:22.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:22.68,0:09:24.81,Default,,0,0,0,,Әй, әке...
Dialogue: 0,0:09:25.31,0:09:27.73,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:09:27.81,0:09:29.73,Default,,0,0,0,,Әке!
Dialogue: 0,0:09:30.61,0:09:32.48,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:09:32.57,0:09:34.99,Default,,0,0,0,,Не күтеді?
Dialogue: 0,0:09:36.03,0:09:39.03,Default,,0,0,0,,Бұл адамдардың өміріне әсер ететін мәселе.
Dialogue: 0,0:09:41.28,0:09:44.20,Default,,0,0,0,,Жалпы айтқанда, әрқашан жоғарыдан қарау.
Dialogue: 0,0:09:45.16,0:09:46.37,Default,,0,0,0,,Бұйрықпен
Dialogue: 0,0:09:46.87,0:09:48.21,Default,,0,0,0,,Қолы биік
Dialogue: 0,0:09:48.29,0:09:50.75,Default,,0,0,0,,Өзіңіз аздап какао қосыңыз.
Dialogue: 0,0:09:52.04,0:09:53.21,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:56.80,0:09:58.97,Default,,0,0,0,,Канаваги: ​​Мен оны ешқашан кездестірмеймін!
Dialogue: 0,0:09:59.05,0:10:00.22,Default,,0,0,0,,Өйткені
Dialogue: 0,0:10:00.30,0:10:01.97,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:10:03.56,0:10:06.60,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:10:08.44,0:10:10.19,Default,,0,0,0,,(Балапанның анасының күлкісі)
Dialogue: 0,0:10:10.27,0:10:12.86,Default,,0,0,0,,Тұмардай әлсіз
Dialogue: 0,0:10:12.94,0:10:14.36,Default,,0,0,0,,Оқудың аздығы!
Dialogue: 0,0:10:16.57,0:10:19.32,Default,,0,0,0,,Сіз шайтанды жындар әлеміне қайтарып жатырсыз ба?
Dialogue: 0,0:10:19.91,0:10:23.83,Default,,0,0,0,,Сен ақымақсың. Мен саған олай істеуге рұқсат бермеймін!
Dialogue: 0,0:10:23.91,0:10:25.91,Default,,0,0,0,,Әй... Анашым?
Dialogue: 0,0:10:26.41,0:10:28.58,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:10:29.46,0:10:30.58,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:10:30.67,0:10:33.04,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:10:33.13,0:10:35.59,Default,,0,0,0,,Мефи... Соққы...
Dialogue: 0,0:10:38.55,0:10:39.72,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:10:39.80,0:10:41.47,Default,,0,0,0,,Өл
Dialogue: 0,0:10:42.43,0:10:43.60,Default,,0,0,0,,Аа...
Dialogue: 0,0:10:44.43,0:10:47.68,Default,,0,0,0,,Оны ішкеннен кейін неге бармайсың?
Dialogue: 0,0:10:48.18,0:10:51.73,Default,,0,0,0,,Ичироны адамдар тастап, жындар өсірді...
Dialogue: 0,0:10:52.81,0:10:55.23,Default,,0,0,0,,Оны да сол жын тастап кеткен, солай ма?
Dialogue: 0,0:10:55.32,0:10:58.40,Default,,0,0,0,,Мен бұл әңгімені естігенім сонша, құлағымда қыжыл болды.
Dialogue: 0,0:10:58.90,0:11:00.32,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:00.91,0:11:02.87,Default,,0,0,0,,О, Ичиро қоңырау шалып жатыр.
Dialogue: 0,0:11:03.45,0:11:05.62,Default,,0,0,0,,Әй, жөнелту
Dialogue: 0,0:11:05.70,0:11:08.50,Default,,0,0,0,,Кім шақырылады!
Dialogue: 0,0:11:08.58,0:11:09.62,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:09.71,0:11:13.63,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:11:13.71,0:11:15.63,Default,,0,0,0,,Қарғыс атсын... аа...
Dialogue: 0,0:11:15.71,0:11:19.47,Default,,0,0,0,,Киіміңізді де ауыстырмаңыз, тек толық жиынтығын жинаңыз.
Dialogue: 0,0:11:19.55,0:11:21.38,Default,,0,0,0,,Баруға толық мотивацияңыз бар ма?
Dialogue: 0,0:11:21.47,0:11:21.97,Default,,0,0,0,,III
Dialogue: 0,0:11:22.72,0:11:25.47,Default,,0,0,0,,Не десең де, мен сені баратын шығар деп ойладым.
Dialogue: 0,0:11:28.06,0:11:29.39,Default,,0,0,0,,Профессор, шай ішесіз бе?
Dialogue: 0,0:11:29.48,0:11:30.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:30.31,0:11:31.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:31.48,0:11:32.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:32.48,0:11:33.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:36.23,0:11:38.15,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:11:42.61,0:11:43.53,Default,,0,0,0,,Ібіліс-күн!
Dialogue: 0,0:11:43.61,0:11:46.53,Default,,0,0,0,,Сиқырлы күш Найзағай!
Dialogue: 0,0:11:46.62,0:11:48.54,Default,,0,0,0,,(құбыжықтың ыңырсыуы)
Dialogue: 0,0:11:49.79,0:11:50.29,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:11:50.37,0:11:51.54,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:11:52.83,0:11:54.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:54.08,0:11:57.50,Default,,0,0,0,,Осылайша Яватаның рамені расталды.
Dialogue: 0,0:11:58.80,0:12:02.76,Default,,0,0,0,,Өйткені, бұл чашу кеспесі...
Dialogue: 0,0:12:06.01,0:12:08.64,Default,,0,0,0,,Қажетсіз істермен айналыспаңыз!
Dialogue: 0,0:12:09.43,0:12:12.06,Default,,0,0,0,,Сиқырлы абсолютті...
Dialogue: 0,0:12:12.14,0:12:13.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:13.73,0:12:15.48,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:12:15.56,0:12:16.61,Default,,0,0,0,,Нөл…
Dialogue: 0,0:12:17.82,0:12:18.32,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:18.40,0:12:20.40,Default,,0,0,0,,♬~
Dialogue: 0,0:12:20.90,0:12:21.86,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,0:12:22.90,0:12:25.28,Default,,0,0,0,,Мефисто Мен балапандарды апарамын.
Dialogue: 0,0:12:25.36,0:12:26.74,Default,,0,0,0,,Т… Мені ешкім қудалап жүрген жоқ еді.
Dialogue: 0,0:12:26.82,0:12:27.99,Default,,0,0,0,,Хинаның бөлмесі
Dialogue: 0,0:12:28.08,0:12:29.20,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:30.12,0:12:31.12,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:33.04,0:12:35.25,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:36.63,0:12:37.50,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:12:37.59,0:12:38.88,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:38.96,0:12:40.34,Default,,0,0,0,,Шық!
Dialogue: 0,0:12:40.42,0:12:41.84,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:12:41.92,0:12:43.34,Default,,0,0,0,,Оны ашыңыз!
Dialogue: 0,0:12:43.92,0:12:45.09,Default,,0,0,0,,Балапандарды қайтар!
Dialogue: 0,0:12:47.93,0:12:50.81,Default,,0,0,0,,Хинаның анасы жын болған ба?
Dialogue: 0,0:12:51.43,0:12:53.35,Default,,0,0,0,,Жоқ, ол мердігер.
Dialogue: 0,0:12:53.85,0:12:54.81,Default,,0,0,0,,Жай ғана адам
Dialogue: 0,0:12:55.60,0:12:57.77,Default,,0,0,0,,Сенің сиқырың мені де өлтіретін еді.
Dialogue: 0,0:12:57.86,0:12:59.19,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:13:00.57,0:13:01.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:02.07,0:13:04.07,Default,,0,0,0,,Уф... Мефисто-сан...
Dialogue: 0,0:13:04.15,0:13:06.36,Default,,0,0,0,,Ха... Анаң мен әкең ше?
Dialogue: 0,0:13:10.45,0:13:15.00,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:13:15.50,0:13:19.13,Default,,0,0,0,,Сонда шайтанның шын денесі қайда?
Dialogue: 0,0:13:20.25,0:13:22.21,Default,,0,0,0,,Қазірдің өзінде... Не екенін білмеймін...
Dialogue: 0,0:13:22.71,0:13:25.38,Default,,0,0,0,,Мен бір нәрсені есте сақтағаныңызды қалаймын.
Dialogue: 0,0:13:25.97,0:13:29.14,Default,,0,0,0,,Бұл бөлме міндетті түрде сіздің бөлмеңіз, солай ма?
Dialogue: 0,0:13:29.22,0:13:30.35,Default,,0,0,0,,Иә
Dialogue: 0,0:13:30.43,0:13:31.89,Default,,0,0,0,,Мәңгі? (Мефисто III) Иә?
Dialogue: 0,0:13:31.97,0:13:34.64,Default,,0,0,0,,Бұл менің кішкентай кезімнен...
Dialogue: 0,0:13:34.73,0:13:37.77,Default,,0,0,0,,Ал, маған естеліктер айт.
Dialogue: 0,0:13:38.27,0:13:39.10,Default,,0,0,0,,Жақында «Сакура Саку» орындалды деген хабар келеді.
Dialogue: 0,0:13:39.61,0:13:40.52,Default,,0,0,0,,Естеліктер?
Dialogue: 0,0:13:41.02,0:13:43.94,Default,,0,0,0,,Кішкентай кезің де, орта мектепте оқығаның да маңызды емес.
Dialogue: 0,0:13:44.44,0:13:45.90,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:45.99,0:13:49.49,Default,,0,0,0,,Осы бөлмеде көрсетілген фотолар сіздің хоббиіңіз ме?
Dialogue: 0,0:13:49.99,0:13:51.08,Default,,0,0,0,,Фотосурет…
Dialogue: 0,0:13:51.58,0:13:54.20,Default,,0,0,0,,Барлық фотоларды ата-аналар таңдауы мүмкін.
Dialogue: 0,0:13:55.33,0:13:56.91,Default,,0,0,0,,Фотосуреттер ғана емес
Dialogue: 0,0:13:57.00,0:14:00.42,Default,,0,0,0,,Онда тіпті марапат сертификаттары мен эсселер де бар. Және...
Dialogue: 0,0:14:00.50,0:14:05.42,Default,,0,0,0,,Қаншама көп болса да, мектеп бітіргеннен бері менде жоқ.
Dialogue: 0,0:14:06.13,0:14:10.18,Default,,0,0,0,,Қайтыс болған адамды еске алатын бөлме сияқты.
Dialogue: 0,0:14:10.26,0:14:11.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:11.97,0:14:14.31,Default,,0,0,0,,Бұл шынымен сіздің есте сақтау қабілетіңіз бе?
Dialogue: 0,0:14:14.93,0:14:16.18,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:14:19.23,0:14:20.44,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:21.44,0:14:22.31,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:22.40,0:14:25.03,Default,,0,0,0,,Әкеге ие болған көлеңке еді.
Dialogue: 0,0:14:25.11,0:14:26.65,Default,,0,0,0,,Анасы мердігер
Dialogue: 0,0:14:26.74,0:14:27.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:27.32,0:14:28.70,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:14:28.78,0:14:30.45,Default,,0,0,0,,Ібіліс - Хина Чан
Dialogue: 0,0:14:30.53,0:14:31.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:31.45,0:14:33.53,Default,,0,0,0,,Нағыз Хинаға не болды?
Dialogue: 0,0:14:34.03,0:14:36.62,Default,,0,0,0,,Белгілі бір себептермен қайтыс болған шығар
Dialogue: 0,0:14:37.12,0:14:39.46,Default,,0,0,0,,Шамамен орта мектепті бітірген кезім.
Dialogue: 0,0:14:39.54,0:14:43.79,Default,,0,0,0,,Ана қызының орнына шайтанмен мәміле жасады.
Dialogue: 0,0:14:44.30,0:14:46.38,Default,,0,0,0,,Мына балапан.
Dialogue: 0,0:14:46.88,0:14:47.55,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:47.63,0:14:50.22,Default,,0,0,0,,Бұл бізді алдау үшін жасалған әрекет еді...
Dialogue: 0,0:14:50.80,0:14:52.47,Default,,0,0,0,,Алдамаңыз
Dialogue: 0,0:14:52.55,0:14:55.43,Default,,0,0,0,,Хинаның мінезі жынды басып тастады.
Dialogue: 0,0:14:55.51,0:14:58.10,Default,,0,0,0,,Сіз бұл туралы ұмытып кетуіңіз керек
Dialogue: 0,0:14:58.60,0:15:02.73,Default,,0,0,0,,Бірақ қазір есімде, егер мен бұл амулетті алып тастасам,
Dialogue: 0,0:15:02.81,0:15:05.94,Default,,0,0,0,,Басылған жын оянады
Dialogue: 0,0:15:06.82,0:15:08.74,Default,,0,0,0,,Шыу!
Dialogue: 0,0:15:08.82,0:15:10.24,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:10.74,0:15:11.99,Default,,0,0,0,,(Балапанның анасының жылағаны)
Dialogue: 0,0:15:14.70,0:15:17.20,Default,,0,0,0,,Хина... Хина!
Dialogue: 0,0:15:17.29,0:15:18.54,Default,,0,0,0,,Ана…
Dialogue: 0,0:15:19.04,0:15:21.12,Default,,0,0,0,,Балапандарды алып кетуге жол бермеймін!
Dialogue: 0,0:15:24.46,0:15:27.21,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:15:28.30,0:15:29.21,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:31.51,0:15:33.05,Default,,0,0,0,,(кесу жіп дыбысы)
Dialogue: 0,0:15:33.14,0:15:34.30,Default,,0,0,0,,Хина!
Dialogue: 0,0:15:35.51,0:15:37.56,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:15:38.10,0:15:39.31,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:15:50.28,0:15:51.86,Default,,0,0,0,,Хина...
Dialogue: 0,0:15:51.95,0:15:55.82,Default,,0,0,0,,Хина... Кешіріңіз.
Dialogue: 0,0:15:56.91,0:15:58.37,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:15:58.45,0:15:59.62,Default,,0,0,0,,Эй
Dialogue: 0,0:15:59.70,0:16:02.83,Default,,0,0,0,,Сіз мені келісім-шарттан босата аласыз ба?
Dialogue: 0,0:16:03.71,0:16:07.09,Default,,0,0,0,,Мен сіз деп ойладым, ашкөздік Гремори.
Dialogue: 0,0:16:07.59,0:16:08.67,Default,,0,0,0,,Гремори?
Dialogue: 0,0:16:09.17,0:16:13.05,Default,,0,0,0,,Ақыры байқадың, Акума-кун.
Dialogue: 0,0:16:13.55,0:16:17.26,Default,,0,0,0,,Мен өлген қызымның орнын толтырудан шаршадым.
Dialogue: 0,0:16:17.35,0:16:21.10,Default,,0,0,0,,Сонымен қатар, мердігер қалаған «мінсіз қызы» не?
Dialogue: 0,0:16:21.18,0:16:23.10,Default,,0,0,0,,«Кемел қыз»?
Dialogue: 0,0:16:23.19,0:16:26.77,Default,,0,0,0,,Сондықтан олар мені туған қызымдай жақсы көрді.
Dialogue: 0,0:16:26.86,0:16:30.32,Default,,0,0,0,,Иә, бірақ Хинаның мінезі тым күшті еді.
Dialogue: 0,0:16:30.82,0:16:33.49,Default,,0,0,0,,Мені ұрлап кетеді деп ойламаппын.
Dialogue: 0,0:16:34.07,0:16:38.70,Default,,0,0,0,,Соның арқасында Ичика баламен «әйел достығы» ойнап жатыр ма?
Dialogue: 0,0:16:39.20,0:16:41.00,Default,,0,0,0,,(Кугисаки) Кугисаки Нобара, қуаныштан селк ете түс! Осы жігіттердің арасында жалғыз қызмын ғой.
Dialogue: 0,0:16:41.08,0:16:43.16,Default,,0,0,0,,Жаман емес пе?
Dialogue: 0,0:16:43.25,0:16:47.67,Default,,0,0,0,,Ашкөздік шайтан махаббатты жеп, жынды болады.
Dialogue: 0,0:16:47.75,0:16:51.17,Default,,0,0,0,,Махаббатты жеуге үйренбегенмін.
Dialogue: 0,0:16:51.26,0:16:53.80,Default,,0,0,0,,Хина-чанға шабуыл жасаған сен бе?
Dialogue: 0,0:16:54.30,0:16:55.68,Default,,0,0,0,,Хинаның өзі
Dialogue: 0,0:16:55.76,0:16:58.18,Default,,0,0,0,,Ичика кеңескен қыз Сакура болатын.
Dialogue: 0,0:16:58.26,0:17:01.60,Default,,0,0,0,,Хинаның өз еркімен кеңескен Ичикаға да шабуыл жасады.
Dialogue: 0,0:17:01.68,0:17:03.52,Default,,0,0,0,,Өтірікші Хина Чан осылай істейтін еді...
Dialogue: 0,0:17:03.60,0:17:07.48,Default,,0,0,0,,Иә! Мен жай ғана қол ұшын бердім
Dialogue: 0,0:17:07.56,0:17:10.44,Default,,0,0,0,,Беттік тұлға және терең тұлға
Dialogue: 0,0:17:10.52,0:17:12.36,Default,,0,0,0,,Жындармен күресу де қиын.
Dialogue: 0,0:17:12.44,0:17:13.49,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:13.57,0:17:15.20,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:17:15.28,0:17:18.45,Default,,0,0,0,,Тіпті ананың қызына деген махаббаты
Dialogue: 0,0:17:18.53,0:17:21.62,Default,,0,0,0,,Ол тіпті мен күтпегендей толып кетті.
Dialogue: 0,0:17:21.70,0:17:23.41,Default,,0,0,0,,Мені жалғыз қалдырыңыз!
Dialogue: 0,0:17:23.50,0:17:26.04,Default,,0,0,0,,Хина-сан, сен ондай қыз емес едің...
Dialogue: 0,0:17:26.12,0:17:29.21,Default,,0,0,0,,Шулы! Сен менің ата-анам емессің!
Dialogue: 0,0:17:29.29,0:17:31.42,Default,,0,0,0,,Менің артымнан ерме!
Dialogue: 0,0:17:31.50,0:17:34.17,Default,,0,0,0,,Хина-сан! Хина!
Dialogue: 0,0:17:34.26,0:17:36.59,Default,,0,0,0,,Шығару... Уф...
Dialogue: 0,0:17:36.68,0:17:38.18,Default,,0,0,0,,Ауырсыну... Ах...
Dialogue: 0,0:17:38.26,0:17:40.85,Default,,0,0,0,,Ах… Уф…
Dialogue: 0,0:17:42.31,0:17:43.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:50.44,0:17:51.69,Default,,0,0,0,,Элоим Эссаим
Dialogue: 0,0:17:51.77,0:17:53.19,Default,,0,0,0,,Элоим Эссаим
Dialogue: 0,0:17:53.28,0:17:56.90,Default,,0,0,0,,Аспан мен жерді хаосқа лақтыратын тозақтың құбыжығы.
Dialogue: 0,0:17:56.99,0:17:58.99,Default,,0,0,0,,Қараңғы үйіңізге оралыңыз
Dialogue: 0,0:18:02.33,0:18:05.00,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:18:09.42,0:18:10.54,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:18:10.63,0:18:12.21,Default,,0,0,0,,Иә! Мен... мәйітті таптым!
Dialogue: 0,0:18:12.71,0:18:14.30,Default,,0,0,0,,Жертөледен мәйіт табылды!
Dialogue: 0,0:18:22.14,0:18:23.81,Default,,0,0,0,,Раменді күту~
Dialogue: 0,0:18:26.64,0:18:28.19,Default,,0,0,0,,Сіз char siu кеспесін айттыңыз ба?
Dialogue: 0,0:18:28.27,0:18:29.39,Default,,0,0,0,,(кеспенің шырылдаған дыбысы)
Dialogue: 0,0:18:29.48,0:18:31.86,Default,,0,0,0,,Мен мұндайды естіген жоқпын.
Dialogue: 0,0:18:33.15,0:18:36.03,Default,,0,0,0,,Бұл қорқынышты ем. Сіз шайтансыз ба?
Dialogue: 0,0:18:36.65,0:18:39.11,Default,,0,0,0,,Әй, бұл шайтан.
Dialogue: 0,0:18:39.61,0:18:41.37,Default,,0,0,0,,Эй, мен сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:18:41.45,0:18:43.12,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:18:43.20,0:18:46.54,Default,,0,0,0,,Ичика-чан Хина-чанды университетте кездестірді, солай ма?
Dialogue: 0,0:18:48.08,0:18:49.58,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:50.37,0:18:53.46,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:18:55.63,0:18:56.59,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:18:56.67,0:18:58.55,Default,,0,0,0,,Тағамыңызға рахмет (қызметші)
Dialogue: 0,0:18:59.13,0:18:59.97,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:19:00.05,0:19:01.80,Default,,0,0,0,,Ичика-чан екеуміз жақын дос болдық
Dialogue: 0,0:19:01.89,0:19:03.43,Default,,0,0,0,,Гремори Бұл не?
Dialogue: 0,0:19:03.51,0:19:05.56,Default,,0,0,0,,Мүмкіндікті жоққа шығаруға болмайды
Dialogue: 0,0:19:05.64,0:19:06.89,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:19:08.73,0:19:11.73,Default,,0,0,0,,Жындар мен адамдар да дос бола алады.
Dialogue: 0,0:19:12.23,0:19:13.27,Default,,0,0,0,,Мен осындамын, мама
Dialogue: 0,0:19:45.80,0:19:46.68,Default,,0,0,0,,Ha
Dialogue: 0,0:19:54.98,0:19:56.98,Default,,0,0,0,,♪～
Dialogue: 0,0:20:05.16,0:20:08.91,Default,,0,0,0,,Екінші шайтан да көп қиындық көріп жатқан сияқты.
Dialogue: 0,0:20:08.99,0:20:10.54,Default,,0,0,0,,Бұл тағы да күрделі өткен.
Dialogue: 0,0:20:10.62,0:20:11.96,Default,,0,0,0,,Бұл мүмкін сияқты.
Dialogue: 0,0:20:12.04,0:20:13.79,Default,,0,0,0,,Бірақ мен сенің қолыңнан келгеннің бәрін жасағаныңды қалаймын.
Dialogue: 0,0:20:13.87,0:20:15.71,Default,,0,0,0,,Жарайды, бірақ бұл не деген шайтан...
Dialogue: 0,0:20:15.79,0:20:17.25,Default,,0,0,0,,Ах, екінші буын.
Dialogue: 0,0:20:17.34,0:20:19.00,Default,,0,0,0,,Менің мотивациям жоқ деп ойлаймын...
Dialogue: 0,0:20:19.09,0:20:20.59,Default,,0,0,0,,Мен мұны істегім келмейді...
Dialogue: 0,0:20:20.67,0:20:22.67,Default,,0,0,0,,Сонда сен жарқанат пен мысыққа ұқсайсың.
Dialogue: 0,0:20:22.76,0:20:23.26,Default,,0,0,0,,Не!
Dialogue: 0,0:20:23.34,0:20:25.72,Default,,0,0,0,,Олай болмайды деп айта алмаймын.
Dialogue: 0,0:20:25.80,0:20:28.93,Default,,0,0,0,,Мен ол кезде өте жақсы жұмыс жасадым деп ойлаймын.
Dialogue: 0,0:20:29.01,0:20:33.52,Default,,0,0,0,,Екінші ұрпақ Акума-кун мен Мефисто III Мен олардың жақын арада дос болғанын қалаймын.
Dialogue: 0,0:20:33.60,0:20:35.10,Default,,0,0,0,,Иә, енді сені елемеді ме?
Dialogue: 0,0:20:35.60,0:20:36.77,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:20:36.86,0:20:39.73,Default,,0,0,0,,Барлық тіршілік иелері тыныш өмір сүретін жұмақ.
Dialogue: 0,0:20:39.82,0:20:43.15,Default,,0,0,0,,Біз қандай да бір жолмен «Мыңжылдықты» шындыққа айналдыруымыз керек.
Dialogue: 0,0:20:43.24,0:20:44.32,Default,,0,0,0,,30 жыл бұрын
Dialogue: 0,0:20:44.40,0:20:47.07,Default,,0,0,0,,Қанша тырыссақ та, бәрібір.
Dialogue: 0,0:20:47.16,0:20:50.29,Default,,0,0,0,,Мен бұл дұрыс тұқым қуалаған нәрсе екеніне сенімдімін.
Dialogue: 0,0:20:50.37,0:20:53.25,Default,,0,0,0,,Өйткені шайтанды шайтан көтерген.
Dialogue: 0,0:20:53.33,0:20:56.54,Default,,0,0,0,,Девил-кун менің қайын атам болса да, оның әкем болатынына сене алар емеспін.
Dialogue: 0,0:20:56.63,0:20:58.59,Default,,0,0,0,,...Ойбай, бұл бірінші ұрпақтан шыққан шайтан.
Dialogue: 0,0:20:59.09,0:21:01.00,Default,,0,0,0,,Сыртқы түрі өзгерген жоқ.
Dialogue: 0,0:21:01.09,0:21:02.71,Default,,0,0,0,,Біз не айтамыз?
Dialogue: 0,0:21:02.80,0:21:03.67,Default,,0,0,0,,Дэймон
Dialogue: 0,0:21:03.76,0:21:05.05,Default,,0,0,0,,Мефисто II-ге келетін болсақ
Dialogue: 0,0:21:05.13,0:21:08.01,Default,,0,0,0,,Мен жақсы жағынан 30 жасқа есейдім.
Dialogue: 0,0:21:08.10,0:21:09.76,Default,,0,0,0,,Е-чан екеуің жақсы көрінесіңдер.
Dialogue: 0,0:21:09.85,0:21:11.31,Default,,0,0,0,,Біз жақсы жұппыз.
Dialogue: 0,0:21:11.39,0:21:12.22,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:21:12.31,0:21:15.14,Default,,0,0,0,,Торымайден екеуміз бірге болған күндер есімде.
Dialogue: 0,0:21:15.23,0:21:18.65,Default,,0,0,0,,Дос болу әдемі емес пе?
Dialogue: 0,0:21:18.73,0:21:20.32,Default,,0,0,0,,Менде мұндай естеліктер жоқ.
Dialogue: 0,0:21:20.40,0:21:21.36,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:21:21.44,0:21:25.32,Default,,0,0,0,,Жоқ, бірақ мен ол күннің бір күні келетініне сенімдімін!
Dialogue: 0,0:21:25.40,0:21:28.32,Default,,0,0,0,,Мен осындай жаңа дамудан үміттенемін.
Dialogue: 0,0:21:28.41,0:21:29.74,Default,,0,0,0,,Өтінемін! Шайтан-күн
Dialogue: 0,0:21:29.83,0:21:31.41,Default,,0,0,0,,Ах, екеуі де.
Dialogue: 0,0:21:31.49,0:21:33.41,Default,,0,0,0,,Хаха...шатасады.
Dialogue: 0,0:21:52.93,0:21:54.93,Default,,0,0,0,,～♪
Dialogue: 0,0:21:56.43,0:22:02.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory