Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.01,0:00:17.18,Default,,0,0,0,,Ібіліс-кун-сан
Dialogue: 0,0:00:19.76,0:00:22.18,Default,,0,0,0,,Сіз шығасыз ба?
Dialogue: 0,0:00:22.27,0:00:24.85,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:00:24.94,0:00:27.94,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:29.65,0:00:30.48,Default,,0,0,0,,О.
Dialogue: 0,0:00:34.86,0:00:37.24,Default,,0,0,0,,Сіз демалыстасыз ба? Шайтан-күн
Dialogue: 0,0:00:38.20,0:00:39.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:41.37,0:00:42.41,Default,,0,0,0,,О.
Dialogue: 0,0:00:42.50,0:00:45.75,Default,,0,0,0,,Ал, мен суық тиіп аламын.
Dialogue: 0,0:00:45.83,0:00:49.92,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:00:50.00,0:00:52.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:04.02,0:01:06.02,Default,,0,0,0,,～♪
Dialogue: 0,0:01:08.48,0:01:09.02,Default,,0,0,0,,Иә
Dialogue: 0,0:01:11.36,0:01:12.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:12.61,0:01:13.53,Default,,0,0,0,,Уау
Dialogue: 0,0:01:13.61,0:01:15.61,Default,,0,0,0,,Менің шын атым Джеймс Рэтли
Dialogue: 0,0:01:15.70,0:01:16.74,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:17.32,0:01:19.03,Default,,0,0,0,,Мен ұсталдым
Dialogue: 0,0:01:21.79,0:01:23.75,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:01:23.83,0:01:27.08,Default,,0,0,0,,Менің атым Санае Казама.
Dialogue: 0,0:01:30.13,0:01:31.67,Default,,0,0,0,,Девил-кун ше?
Dialogue: 0,0:01:31.75,0:01:35.26,Default,,0,0,0,,А, түсіндім. Күтіп жатып ұйықтап қалдым.
Dialogue: 0,0:01:35.34,0:01:36.26,Default,,0,0,0,,Ұйқыңыз келсе...
Dialogue: 0,0:01:36.34,0:01:36.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:36.93,0:01:38.93,Default,,0,0,0,,Жындар әлеміне оралып, ұйықтаңыз.
Dialogue: 0,0:01:39.43,0:01:41.60,Default,,0,0,0,,О, сен сондасың ба?
Dialogue: 0,0:01:42.47,0:01:46.85,Default,,0,0,0,,Кітапханадан бірдеңе іздеп жүріп, уақытты ұмытып кеткендей.
Dialogue: 0,0:01:46.94,0:01:50.44,Default,,0,0,0,,Ібіліс-кун, мен сені күттім. Жүр, мұнда кел.
Dialogue: 0,0:01:50.52,0:01:51.73,Default,,0,0,0,,Әй, Гремори!
Dialogue: 0,0:01:51.82,0:01:52.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:52.52,0:01:53.53,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:01:53.61,0:01:56.28,Default,,0,0,0,,Бұл қайтадан келді!
Dialogue: 0,0:01:56.36,0:01:57.28,Default,,0,0,0,,Осы аралдағы шайтандар…
Dialogue: 0,0:01:57.36,0:01:59.95,Default,,0,0,0,,Шық! бұл! бұл!
Dialogue: 0,0:02:00.03,0:02:01.57,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:02:01.66,0:02:04.04,Default,,0,0,0,,Сіз тез ашуланасыз.
Dialogue: 0,0:02:04.12,0:02:06.58,Default,,0,0,0,,Шулы! бұл! бұл!
Dialogue: 0,0:02:06.66,0:02:08.79,Default,,0,0,0,,Түсіндім, түсіндім!
Dialogue: 0,0:02:11.17,0:02:12.88,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:02:12.96,0:02:14.34,Default,,0,0,0,,Бұл кешірім сұрау.
Dialogue: 0,0:02:14.92,0:02:16.67,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:02:18.42,0:02:19.84,Default,,0,0,0,,Дәмді
Dialogue: 0,0:02:19.93,0:02:21.97,Default,,0,0,0,,Бұл Цейлон Рухуна.
Dialogue: 0,0:02:22.05,0:02:23.72,Default,,0,0,0,,Сүт қосса да дәмді болады.
Dialogue: 0,0:02:23.81,0:02:26.98,Default,,0,0,0,,Мефисто мырза, сіз шайдың да маманысыз.
Dialogue: 0,0:02:27.06,0:02:29.10,Default,,0,0,0,,«Батырлық ойлау» мен сол сияқты нәрселерден гөрі,
Dialogue: 0,0:02:29.19,0:02:33.98,Default,,0,0,0,,Егер бұл айдың жалдау ақысы болса, менің ойымша, сіз тағы біраз күте аласыз...
Dialogue: 0,0:02:34.07,0:02:34.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:35.07,0:02:35.86,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:02:35.94,0:02:38.99,Default,,0,0,0,,Бүгін мен екеуіңе жақсылық сұрауға келдім.
Dialogue: 0,0:02:39.07,0:02:40.86,Default,,0,0,0,,Өтінемін?
Dialogue: 0,0:02:41.74,0:02:42.87,Default,,0,0,0,,Ол қазір келеді.
Dialogue: 0,0:02:42.95,0:02:45.99,Default,,0,0,0,,Біздің тұтынушыларды тыңдағаныңызды қалаймыз.
Dialogue: 0,0:02:46.70,0:02:49.46,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:49.54,0:02:50.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:53.50,0:02:54.75,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:02:54.84,0:02:57.26,Default,,0,0,0,,Ол кісі менің қожайынымның жанашыры.
Dialogue: 0,0:03:00.09,0:03:02.01,Default,,0,0,0,,Ей... Директор!
Dialogue: 0,0:03:02.09,0:03:03.80,Default,,0,0,0,,Мен бұл туралы естідім.
Dialogue: 0,0:03:03.89,0:03:06.51,Default,,0,0,0,,Ол өте танымал режиссер, солай ма?
Dialogue: 0,0:03:08.10,0:03:10.52,Default,,0,0,0,,Директор сізге не үшін келді?
Dialogue: 0,0:03:10.60,0:03:13.90,Default,,0,0,0,,Ядороку! Оны сындырыңыз! сурет?
Dialogue: 0,0:03:13.98,0:03:15.77,Default,,0,0,0,,Керемет тұтынушы келді!
Dialogue: 0,0:03:15.86,0:03:19.28,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:03:21.78,0:03:22.78,Default,,0,0,0,,(Кесе салынған дыбыс)
Dialogue: 0,0:03:27.41,0:03:29.04,Default,,0,0,0,,Сіз оны төмендете аласыз ба?
Dialogue: 0,0:03:29.12,0:03:30.04,Default,,0,0,0,,Е...
Dialogue: 0,0:03:30.12,0:03:33.92,Default,,0,0,0,,Кешіріңіз, Эй қара шайды ұнатпайды.
Dialogue: 0,0:03:34.00,0:03:35.00,Default,,0,0,0,,Кофе іше алсаңыз...
Dialogue: 0,0:03:35.08,0:03:36.79,Default,,0,0,0,,Тынш, кешіріңіз.
Dialogue: 0,0:03:39.38,0:03:41.05,Default,,0,0,0,,Санае-кун
Dialogue: 0,0:03:41.13,0:03:43.43,Default,,0,0,0,,Өткен күн үшін кешіріңіз.
Dialogue: 0,0:03:43.51,0:03:46.55,Default,,0,0,0,,Шииба мені таң қалдырған сияқты...
Dialogue: 0,0:03:46.64,0:03:49.39,Default,,0,0,0,,Шынында да өте сүйкімді екен.
Dialogue: 0,0:03:49.47,0:03:50.68,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:50.77,0:03:54.15,Default,,0,0,0,,Бұл нуар фильміндегі көрініс сияқты болды, сондықтан мен біраз қобалжыдым.
Dialogue: 0,0:03:54.23,0:03:58.40,Default,,0,0,0,,Сонда Казама-кун әлі жоқ па?
Dialogue: 0,0:03:58.98,0:03:59.90,Default,,0,0,0,,Иә
Dialogue: 0,0:03:59.98,0:04:03.66,Default,,0,0,0,,Мен бұл туралы полицияға хабарладым, бірақ ештеңе...
Dialogue: 0,0:04:03.74,0:04:07.28,Default,,0,0,0,,Иә, бұл өте өкінішті.
Dialogue: 0,0:04:09.87,0:04:13.12,Default,,0,0,0,,Ол әлдеқашан өлген сияқты.
Dialogue: 0,0:04:13.21,0:04:14.54,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:04:15.12,0:04:18.38,Default,,0,0,0,,Жоқ, бұл тәжірибеге негізделген жалпылау.
Dialogue: 0,0:04:18.46,0:04:21.05,Default,,0,0,0,,Бос өмір сүресің.
Dialogue: 0,0:04:21.67,0:04:24.47,Default,,0,0,0,,Солай болса да, сөздерді жақсырақ таңдау керек.
Dialogue: 0,0:04:24.55,0:04:26.84,Default,,0,0,0,,Күйеуіңіздің бір күні қайтып келетініне сеніңіз.
Dialogue: 0,0:04:26.93,0:04:28.05,Default,,0,0,0,,Санаэ-сан әрқашан...
Dialogue: 0,0:04:28.14,0:04:29.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:29.18,0:04:31.85,Default,,0,0,0,,Нағыз режиссер Эй~
Dialogue: 0,0:04:32.98,0:04:34.56,Default,,0,0,0,,Мм... Санаэ-сан
Dialogue: 0,0:04:34.64,0:04:35.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:35.56,0:04:36.85,Default,,0,0,0,,Әй, бұл... Иә?
Dialogue: 0,0:04:36.94,0:04:39.61,Default,,0,0,0,,Терезе кедергісі ~
Dialogue: 0,0:04:39.69,0:04:41.57,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:04:41.65,0:04:43.61,Default,,0,0,0,,Терезе әйнегі ластанады
Dialogue: 0,0:04:43.70,0:04:45.28,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:04:45.36,0:04:45.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:46.66,0:04:50.87,Default,,0,0,0,,Ал... қалғанын тікелей сұраймыз.
Dialogue: 0,0:04:50.95,0:04:52.54,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:53.04,0:04:55.37,Default,,0,0,0,,Еңбегіңізге рахмет, Санае-кун.
Dialogue: 0,0:04:55.46,0:04:56.46,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:04:56.96,0:04:58.13,Default,,0,0,0,,Істі тыңдайық
Dialogue: 0,0:04:59.75,0:05:02.38,Default,,0,0,0,,Мен сізге белгілі бір фильм тауып беруіңізді қалаймын.
Dialogue: 0,0:05:03.05,0:05:06.09,Default,,0,0,0,,Менің досым Бито түсірген
Dialogue: 0,0:05:06.18,0:05:09.10,Default,,0,0,0,,Оны өзі мөр басып қойды.
Dialogue: 0,0:05:09.18,0:05:12.64,Default,,0,0,0,,Бұл фильмді әлем елес шедевр деп атайды.
Dialogue: 0,0:05:12.72,0:05:15.89,Default,,0,0,0,,Мөр... Неге олай істейсің?
Dialogue: 0,0:05:15.98,0:05:17.94,Default,,0,0,0,,Бұл шедевр, солай емес пе?
Dialogue: 0,0:05:18.02,0:05:19.90,Default,,0,0,0,,деді
Dialogue: 0,0:05:19.98,0:05:22.94,Default,,0,0,0,,``Бұл қарғыс атқан фильм.''
Dialogue: 0,0:05:23.03,0:05:25.78,Default,,0,0,0,,«Мен шайтанмен келісім жасадым».
Dialogue: 0,0:05:25.86,0:05:29.41,Default,,0,0,0,,''Мен бұл фильмді түсірдім''
Dialogue: 0,0:05:29.49,0:05:30.91,Default,,0,0,0,,Ібіліс?
Dialogue: 0,0:05:30.99,0:05:31.99,Default,,0,0,0,,Әрі қарай жалғастыр.
Dialogue: 0,0:05:32.91,0:05:34.79,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:05:34.87,0:05:36.50,Default,,0,0,0,,Бұл қарапайым оқиға.
Dialogue: 0,0:05:37.04,0:05:38.33,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:38.42,0:05:43.00,Default,,0,0,0,,Мұнда келу қате болмаған сияқты.
Dialogue: 0,0:05:44.80,0:05:48.30,Default,,0,0,0,,Бюджеті жомарт танымал актерлер
Dialogue: 0,0:05:48.38,0:05:51.26,Default,,0,0,0,,Бұл көптен күткен фильм болды.
Dialogue: 0,0:05:51.35,0:05:53.01,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:53.93,0:05:56.39,Default,,0,0,0,,«Бұл фильм мөрленген»
Dialogue: 0,0:05:59.48,0:06:03.69,Default,,0,0,0,,Бұл Битоның фильмді аяқтағаннан кейін айтқан сөздері.
Dialogue: 0,0:06:05.11,0:06:09.36,Default,,0,0,0,,Ол Битоның шедевріне айналады деген қауесет бар.
Dialogue: 0,0:06:09.45,0:06:13.24,Default,,0,0,0,,Бұрын-соңды болмаған ауқымды шығару жоспарланған болатын, бірақ
Dialogue: 0,0:06:15.20,0:06:17.87,Default,,0,0,0,,Айналдырудан кейін «пломбалау»...
Dialogue: 0,0:06:19.96,0:06:21.88,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:06:21.96,0:06:25.38,Default,,0,0,0,,``Көргендерге апат әкелу''
Dialogue: 0,0:06:26.46,0:06:30.13,Default,,0,0,0,,«Мен жанымды шайтанға саттым»
Dialogue: 0,0:06:30.22,0:06:33.14,Default,,0,0,0,,«Мен бұл фильмді түсірдім».
Dialogue: 0,0:06:33.76,0:06:35.97,Default,,0,0,0,,Апат әкелу…
Dialogue: 0,0:06:36.72,0:06:40.40,Default,,0,0,0,,Бас тартса да босатуды талап ететін өндірушілер
Dialogue: 0,0:06:41.90,0:06:45.15,Default,,0,0,0,,Бито ақырында кептіруге дайындалды.
Dialogue: 0,0:06:45.23,0:06:48.44,Default,,0,0,0,,Барлық сценарийлер мен негативтер жойылған кезде
Dialogue: 0,0:06:48.95,0:06:52.37,Default,,0,0,0,,Мен қалған жалғыз басты фильмді алып қаштым.
Dialogue: 0,0:06:54.16,0:06:55.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:55.12,0:06:57.50,Default,,0,0,0,,Содан бері мен өлгенше, Бито
Dialogue: 0,0:06:58.08,0:07:00.37,Default,,0,0,0,,Фильмге не болғанын айтпаңыз
Dialogue: 0,0:07:00.87,0:07:04.13,Default,,0,0,0,,Сондықтан ол адамдардың қызығушылығын тудырады.
Dialogue: 0,0:07:04.21,0:07:08.76,Default,,0,0,0,,Бұл фильм фантастикалық шедевр деп аталды.
Dialogue: 0,0:07:09.26,0:07:13.64,Default,,0,0,0,,Оны әлі де іздеп жүрген маньяктар мен БАҚ-тың шегі жоқ.
Dialogue: 0,0:07:14.14,0:07:16.22,Default,,0,0,0,,Оны іздеңіз бе?
Dialogue: 0,0:07:16.31,0:07:17.06,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:07:18.64,0:07:21.73,Default,,0,0,0,,Менің көп уақытым қалмады
Dialogue: 0,0:07:21.81,0:07:25.23,Default,,0,0,0,,Көптеген фильмдер түсіріп, жүлделі орындарға ие болды.
Dialogue: 0,0:07:25.31,0:07:29.57,Default,,0,0,0,,Менің некем сәтсіз болды, менде бала жоқ, бірақ мен өкінбеймін.
Dialogue: 0,0:07:30.07,0:07:34.57,Default,,0,0,0,,Менің жалғыз өкінетінім - Бито фильмі.
Dialogue: 0,0:07:34.66,0:07:38.29,Default,,0,0,0,,Сіз шынымен қарғыс алғаныңызды тексеріңіз
Dialogue: 0,0:07:38.37,0:07:40.58,Default,,0,0,0,,Мүмкіндігінше жария еткім келеді
Dialogue: 0,0:07:40.66,0:07:43.46,Default,,0,0,0,,Досқа соңғы тапсырма ретінде
Dialogue: 0,0:07:43.54,0:07:46.34,Default,,0,0,0,,Мен осы үшін өлгім келеді.
Dialogue: 0,0:07:47.75,0:07:48.88,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:49.67,0:07:54.34,Default,,0,0,0,,Қарғыс атқан Ібіліс фильмі Егер бұл шын болса, мен де көргім келеді.
Dialogue: 0,0:07:54.43,0:07:55.85,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:55.93,0:07:56.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:57.43,0:08:00.64,Default,,0,0,0,,Мен фильмді бірінші болып көрдім.
Dialogue: 0,0:08:00.73,0:08:04.60,Default,,0,0,0,,Фильмнің мазмұнын өзім тексеремін.
Dialogue: 0,0:08:04.69,0:08:05.98,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:08:06.06,0:08:06.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:06.86,0:08:07.61,Default,,0,0,0,,Шииба
Dialogue: 0,0:08:07.69,0:08:08.86,Default,,0,0,0,,Иә
Dialogue: 0,0:08:08.94,0:08:13.03,Default,,0,0,0,,Айтпақшы, біз осы деңгейдегі табысты ақы туралы ойлаймыз.
Dialogue: 0,0:08:13.11,0:08:15.07,Default,,0,0,0,,Нақты құнға бөлек шот-фактура жасаңыз.
Dialogue: 0,0:08:15.16,0:08:16.95,Default,,0,0,0,,Мен бұған жол бермеймін. Мен бұған жол бермеймін!
Dialogue: 0,0:08:17.03,0:08:19.70,Default,,0,0,0,,Біз сіздің өтінішіңізді қуана қабылдаймыз.
Dialogue: 0,0:08:20.20,0:08:23.50,Default,,0,0,0,,Бұл жігіт не десе де, мен оны орындаймын.
Dialogue: 0,0:08:23.58,0:08:25.12,Default,,0,0,0,,Жақсы ма? Шайтан-күн
Dialogue: 0,0:08:27.21,0:08:30.13,Default,,0,0,0,,Сіз ұсынысты оңай қабылдадыңыз.
Dialogue: 0,0:08:30.21,0:08:31.88,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:08:31.96,0:08:35.26,Default,,0,0,0,,Өзіңіз түсірген фильмді жабу үшін жаныңызды шайтанға саттыңыз ба?
Dialogue: 0,0:08:35.34,0:08:36.59,Default,,0,0,0,,Ол Киригумо-суги деп аталатын өте жеңіл ағаш түрінен жасалған
Dialogue: 0,0:08:36.68,0:08:38.18,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:08:38.26,0:08:41.85,Default,,0,0,0,,«Шийба» деп атаған жігіт шайтан ғой, солай ма?
Dialogue: 0,0:08:41.93,0:08:43.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:46.94,0:08:50.11,Default,,0,0,0,,Гремори! Сен кінәсізсің...
Dialogue: 0,0:08:50.19,0:08:52.36,Default,,0,0,0,,Демек, Шииба – шайтан...
Dialogue: 0,0:08:52.44,0:08:54.28,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:08:54.36,0:08:56.82,Default,,0,0,0,,Мен оны одан сайын түсінбеймін
Dialogue: 0,0:08:56.91,0:08:58.74,Default,,0,0,0,,Кездейсоқ нәрселерді айтпаңыз
Dialogue: 0,0:08:58.82,0:09:03.20,Default,,0,0,0,,Өйткені, жартылай адам жын тәрізді нәрсе байқамайды.
Dialogue: 0,0:09:06.04,0:09:07.12,Default,,0,0,0,,Шулы!
Dialogue: 0,0:09:07.21,0:09:12.00,Default,,0,0,0,,Сонымен, сіз ақыры босатылып, бостандыққа шықтыңыз, солай ма?
Dialogue: 0,0:09:12.09,0:09:14.51,Default,,0,0,0,,Неге сонша рет өкінбей...
Dialogue: 0,0:09:14.59,0:09:15.59,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:09:15.68,0:09:18.97,Default,,0,0,0,,Бұлай деуге негіз жоқ, жартылай адам.
Dialogue: 0,0:09:19.05,0:09:21.51,Default,,0,0,0,,Мен шайтанды көруге келе жатырмын.
Dialogue: 0,0:09:22.10,0:09:24.14,Default,,0,0,0,,Әй, шайтан!
Dialogue: 0,0:09:24.23,0:09:27.52,Default,,0,0,0,,Мен бәрін істеймін, сондықтан өтінішімді тыңдаңыз.
Dialogue: 0,0:09:27.60,0:09:29.11,Default,,0,0,0,,Қалайсыз ба?
Dialogue: 0,0:09:29.61,0:09:32.28,Default,,0,0,0,,Жүрегіңнің етін жеймін
Dialogue: 0,0:09:32.36,0:09:33.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:33.86,0:09:37.36,Default,,0,0,0,,Мен сенімен балапанның жүзімен сөйлесіп тұрғанда
Dialogue: 0,0:09:37.45,0:09:40.45,Default,,0,0,0,,Жүрегімнің тереңінде, Мен осылай ойладым
Dialogue: 0,0:09:40.53,0:09:43.54,Default,,0,0,0,,10 000 жылда бір данышпан Акума-кун
Dialogue: 0,0:09:43.62,0:09:45.33,Default,,0,0,0,,Сол жан...
Dialogue: 0,0:09:45.41,0:09:47.54,Default,,0,0,0,,Жан жатқан жүрек
Dialogue: 0,0:09:47.62,0:09:49.88,Default,,0,0,0,,Қызық, дәмі қандай?
Dialogue: 0,0:09:50.71,0:09:53.88,Default,,0,0,0,,Мен бұл үшін бәрін жасаймын.
Dialogue: 0,0:09:55.97,0:09:59.76,Default,,0,0,0,,Менің жүрегімді көздеп отырғаныңыздың себебі ол дәмді көрінгендіктен бе?
Dialogue: 0,0:09:59.84,0:10:00.47,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:10:00.55,0:10:02.72,Default,,0,0,0,,Тағы не бар?
Dialogue: 0,0:10:02.81,0:10:03.64,Default,,0,0,0,,(тілді жалау дыбысы)
Dialogue: 0,0:10:05.73,0:10:08.19,Default,,0,0,0,,Жарайды, маған бәрібір.
Dialogue: 0,0:10:08.27,0:10:10.23,Default,,0,0,0,,Мен саған жүрек етін беремін
Dialogue: 0,0:10:10.31,0:10:11.31,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:10:11.40,0:10:13.15,Default,,0,0,0,,Иә? Эй, шайтан-күн
Dialogue: 0,0:10:13.23,0:10:14.98,Default,,0,0,0,,Бірақ шарттар бар.
Dialogue: 0,0:10:15.07,0:10:16.65,Default,,0,0,0,,Мені тыңда
Dialogue: 0,0:10:16.74,0:10:17.90,Default,,0,0,0,,Не айту керек?
Dialogue: 0,0:10:17.99,0:10:22.16,Default,,0,0,0,,Жоғарыда айтылған жын фильмін іздеңіз.
Dialogue: 0,0:10:22.24,0:10:24.08,Default,,0,0,0,,Бұл арзан.
Dialogue: 0,0:10:24.16,0:10:25.33,Default,,0,0,0,,Бірақ бұл шынымен жақсы ма?
Dialogue: 0,0:10:25.41,0:10:28.08,Default,,0,0,0,,«Еті жақсы, қаны жақсы» деген ұғым жоқ.
Dialogue: 0,0:10:28.16,0:10:31.42,Default,,0,0,0,,Енді мен Шекспирден үзінді келтіруім керек пе?
Dialogue: 0,0:10:31.50,0:10:33.46,Default,,0,0,0,,Уау, уәде бер.
Dialogue: 0,0:10:33.54,0:10:36.05,Default,,0,0,0,,Бұзсаң, қабылдамаймын!
Dialogue: 0,0:10:38.51,0:10:40.09,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:10:40.18,0:10:40.89,Default,,0,0,0,,О
Dialogue: 0,0:10:40.97,0:10:42.35,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:44.97,0:10:48.23,Default,,0,0,0,,Бірақ директор Бито шынымен де керемет.
Dialogue: 0,0:10:48.31,0:10:50.90,Default,,0,0,0,,Барлығы блокбастерлік фильмдер туралы.
Dialogue: 0,0:10:51.56,0:10:54.65,Default,,0,0,0,,Бізді фантастикалық шедевр күтетін сияқты.
Dialogue: 0,0:10:55.40,0:10:57.82,Default,,0,0,0,,Бұл да екеуінің достығының арқасы.
Dialogue: 0,0:10:57.90,0:10:59.53,Default,,0,0,0,,(Адам) Әке, бірдеңе болды ма?
Dialogue: 0,0:10:59.61,0:11:00.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:00.24,0:11:02.91,Default,,0,0,0,,Достық дегеніміз не? мефисто
Dialogue: 0,0:11:02.99,0:11:04.16,Default,,0,0,0,,А... А?
Dialogue: 0,0:11:04.24,0:11:07.45,Default,,0,0,0,,Мен оның бар екенін ешқашан растаған емеспін.
Dialogue: 0,0:11:07.54,0:11:09.96,Default,,0,0,0,,Демек, бұл жай ғана ойдан шығарылған ұғым.
Dialogue: 0,0:11:12.25,0:11:14.63,Default,,0,0,0,,Сондықтан мен достыққа сенбеймін
Dialogue: 0,0:11:14.71,0:11:17.17,Default,,0,0,0,,Сондықтан мен директор Эйдің ниетіне күмәнданамын.
Dialogue: 0,0:11:17.80,0:11:20.01,Default,,0,0,0,,Достыққа күмәніңіз бар ма?
Dialogue: 0,0:11:20.09,0:11:23.55,Default,,0,0,0,,Мен күмәндансам да, мен ештеңе жоқ деп айтамын.
Dialogue: 0,0:11:24.97,0:11:26.26,Default,,0,0,0,,Ұрыс дегеніміз не?
Dialogue: 0,0:11:26.35,0:11:27.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:27.85,0:11:29.23,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:30.69,0:11:31.98,Default,,0,0,0,,Тек аргумент.
Dialogue: 0,0:11:32.06,0:11:33.02,Default,,0,0,0,,Уау
Dialogue: 0,0:11:33.10,0:11:36.40,Default,,0,0,0,,Енді шайтанның жүрегі менікі!
Dialogue: 0,0:11:36.48,0:11:37.48,Default,,0,0,0,,(пленканы орналастыру дыбысы)
Dialogue: 0,0:11:37.57,0:11:38.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:16.23,0:12:21.90,Default,,0,0,0,,(Эйдің жылағаны)
Dialogue: 0,0:12:24.41,0:12:25.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:27.49,0:12:32.46,Default,,0,0,0,,Бито, сен не істеп жатырсың...
Dialogue: 0,0:12:33.58,0:12:34.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:37.33,0:12:40.42,Default,,0,0,0,,Күткендей, фильм шедевр болды.
Dialogue: 0,0:12:40.92,0:12:43.09,Default,,0,0,0,,Оны ешкім көрмей тұрып
Dialogue: 0,0:12:43.17,0:12:46.34,Default,,0,0,0,,Мен оны көргеніме өте қуаныштымын.
Dialogue: 0,0:12:46.43,0:12:48.10,Default,,0,0,0,,Аня нәжіске батты.
Dialogue: 0,0:12:48.18,0:12:51.10,Default,,0,0,0,,Қазір өкінетін нәрсе бар ма?
Dialogue: 0,0:12:56.60,0:12:58.06,Default,,0,0,0,,(май жағу дыбысы)
Dialogue: 0,0:12:58.15,0:12:59.32,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:13:00.36,0:13:01.11,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:13:07.16,0:13:09.33,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:13:09.41,0:13:11.74,Default,,0,0,0,,Себебі мен сені жек көремін
Dialogue: 0,0:13:11.83,0:13:15.04,Default,,0,0,0,,Ол және түсірген фильмі
Dialogue: 0,0:13:15.12,0:13:18.50,Default,,0,0,0,,Оны және бәрін мақтайтын адамдар!
Dialogue: 0,0:13:18.58,0:13:21.75,Default,,0,0,0,,Сендер ең жақын достар емессіңдер ме?
Dialogue: 0,0:13:21.84,0:13:23.13,Default,,0,0,0,,Ең жақсы дос?
Dialogue: 0,0:13:23.21,0:13:24.01,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:24.09,0:13:28.51,Default,,0,0,0,,Біз төбелесіп, қарым-қатынасымызды ондаған жылдар бұрын тоқтаттық.
Dialogue: 0,0:13:28.59,0:13:29.51,Default,,0,0,0,,А...
Dialogue: 0,0:13:30.39,0:13:31.01,Default,,0,0,0,,Бірақ жанкүйерлер
Dialogue: 0,0:13:31.10,0:13:35.77,Default,,0,0,0,,Біз әрқашан ең жақсы дос боламыз деген иллюзияны аңсадым
Dialogue: 0,0:13:35.85,0:13:40.31,Default,,0,0,0,,Оны кинокомпаниялар да, телеарналар да жарнама үшін пайдаланды.
Dialogue: 0,0:13:40.40,0:13:43.40,Default,,0,0,0,,Сондықтан ол да, мен де жоққа шығарған жоқпыз.
Dialogue: 0,0:13:44.32,0:13:45.19,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:45.28,0:13:49.74,Default,,0,0,0,,Үнемі баға алатын жалғыз адам!
Dialogue: 0,0:13:49.82,0:13:53.41,Default,,0,0,0,,Сіз өлгенше жеңілуге ​​шыдай аласыз ба?
Dialogue: 0,0:13:53.99,0:13:55.00,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:55.50,0:13:56.79,Default,,0,0,0,,Иә...
Dialogue: 0,0:13:56.87,0:13:59.21,Default,,0,0,0,,Сен істедің, Бито!
Dialogue: 0,0:13:59.29,0:14:01.42,Default,,0,0,0,,Мен бұған еш өкінбеймін...
Dialogue: 0,0:14:01.50,0:14:02.92,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:05.01,0:14:06.01,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:14:09.43,0:14:15.43,Default,,0,0,0,,(Жедел жәрдем сигналы)
Dialogue: 0,0:14:15.52,0:14:18.19,Default,,0,0,0,,Достық... Бұл қызық.
Dialogue: 0,0:14:23.23,0:14:24.28,Default,,0,0,0,,«Бақытсыз азғындық»
Dialogue: 0,0:14:24.36,0:14:26.57,Default,,0,0,0,,«Трипод» сияқты жұмыстармен танымал
Dialogue: 0,0:14:26.65,0:14:28.99,Default,,0,0,0,,Кинорежиссер Горю Эй
Dialogue: 0,0:14:29.07,0:14:31.49,Default,,0,0,0,,Бүгін кешке жүрек жетіспеушілігінен қайтыс болды.
Dialogue: 0,0:14:31.57,0:14:34.20,Default,,0,0,0,,Әй, ол дүниеден өтті.
Dialogue: 0,0:14:34.29,0:14:36.58,Default,,0,0,0,,Жақсы кино түсірген адам болған.
Dialogue: 0,0:14:37.08,0:14:39.62,Default,,0,0,0,,Сіз бірдеңе көрдіңіз бе?
Dialogue: 0,0:14:40.12,0:14:42.04,Default,,0,0,0,,Бұлай емес.
Dialogue: 0,0:14:42.54,0:14:44.25,Default,,0,0,0,,Мен тіпті кино көргім де келмейді.
Dialogue: 0,0:14:44.34,0:14:45.80,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:14:45.88,0:14:50.01,Default,,0,0,0,,Менің есімде жақсы сақталған бір фильм бар.
Dialogue: 0,0:14:50.09,0:14:51.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:51.34,0:14:54.31,Default,,0,0,0,,«Омарлар бәсекесі» деп аталады...
Dialogue: 0,0:14:54.39,0:14:57.47,Default,,0,0,0,,Режиссер Эйдің фильмдерінде сирек кездесетін махаббат хикаясы.
Dialogue: 0,0:14:57.56,0:14:58.98,Default,,0,0,0,,Мен оны әкеммен бірге көрдім.
Dialogue: 0,0:14:59.06,0:15:02.52,Default,,0,0,0,,Үйлену туралы ұсынысқа жауап Белгіленген күні
Dialogue: 0,0:15:02.61,0:15:03.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:04.82,0:15:07.53,Default,,0,0,0,,Басында мен бас тартуды ойладым.
Dialogue: 0,0:15:08.11,0:15:10.70,Default,,0,0,0,,Өйткені, екеуі тым бөлек.
Dialogue: 0,0:15:10.78,0:15:12.74,Default,,0,0,0,,Бірге тұру мүмкін емес еді
Dialogue: 0,0:15:13.91,0:15:17.83,Default,,0,0,0,,Бірақ мені бір жерге ауыстырды.
Dialogue: 0,0:15:17.91,0:15:21.54,Default,,0,0,0,,Дәл осылай көз жасын төгетін адамға қара.
Dialogue: 0,0:15:21.62,0:15:24.25,Default,,0,0,0,,«О, бұл жақсы болуы мүмкін».
Dialogue: 0,0:15:24.34,0:15:28.21,Default,,0,0,0,,«Мүмкін мен бұл адаммен бірге бола аламын».
Dialogue: 0,0:15:28.96,0:15:32.47,Default,,0,0,0,,Егер бұл фильм болмаса, сіз туылмауыңыз мүмкін еді.
Dialogue: 0,0:15:32.55,0:15:34.09,Default,,0,0,0,,А...
Dialogue: 0,0:16:01.33,0:16:03.29,Default,,0,0,0,,Бұл жанкүйерлердің үлкен саны.
Dialogue: 0,0:16:03.37,0:16:04.29,Default,,0,0,0,,Иә (Мефисто III) Иә?
Dialogue: 0,0:16:04.38,0:16:07.75,Default,,0,0,0,,Ол түсірген фильм шынайы болды.
Dialogue: 0,0:16:09.34,0:16:13.80,Default,,0,0,0,,Сізді Бито қарғыс атқан фильмді түсіруге шақырды ма?
Dialogue: 0,0:16:13.88,0:16:16.76,Default,,0,0,0,,Әлде оны Битоны қызғанған Эй шақырды ма?
Dialogue: 0,0:16:16.85,0:16:19.14,Default,,0,0,0,,Екеуі де әртүрлі.
Dialogue: 0,0:16:19.22,0:16:20.47,Default,,0,0,0,,Мені кім шақырды
Dialogue: 0,0:16:20.56,0:16:24.35,Default,,0,0,0,,Екеуін қызғанған белгілі бір шағын кинорежиссер.
Dialogue: 0,0:16:24.44,0:16:28.02,Default,,0,0,0,,Мен күш-қуатымды берсем де, ол бірден құлап қалды.
Dialogue: 0,0:16:28.11,0:16:30.48,Default,,0,0,0,,Мен атымды ұмытып қалдым...
Dialogue: 0,0:16:31.07,0:16:34.53,Default,,0,0,0,,Олай болса, жындар әлеміне қайта оралудың орнына неге қалдың?
Dialogue: 0,0:16:34.61,0:16:37.37,Default,,0,0,0,,Сіз қандай рөлде ойнадыңыз?
Dialogue: 0,0:16:37.45,0:16:38.83,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:16:38.91,0:16:42.25,Default,,0,0,0,,Мен жай ғана екеуміздің арамызда қатты қызғаныш сезінемін.
Dialogue: 0,0:16:42.33,0:16:43.87,Default,,0,0,0,,Мен оның дәмін жаңа ғана көріп отырмын.
Dialogue: 0,0:16:43.96,0:16:45.87,Default,,0,0,0,,Қызғаныш?
Dialogue: 0,0:16:46.38,0:16:48.25,Default,,0,0,0,,Сіз Левиафансыз ба?
Dialogue: 0,0:16:48.34,0:16:50.63,Default,,0,0,0,,Біздің Yotsuba тобымыздың әрі қарай өсуі мен дамуы үшін,
Dialogue: 0,0:16:51.26,0:16:53.26,Default,,0,0,0,,Сізбен қайта танысқаныма қуаныштымын...
Dialogue: 0,0:16:53.34,0:16:54.88,Default,,0,0,0,,Ібіліс-кун
Dialogue: 0,0:16:59.60,0:17:00.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:01.06,0:17:03.48,Default,,0,0,0,,Сен директор Эйдің қызғанышын қоздырдың.
Dialogue: 0,0:17:03.56,0:17:06.27,Default,,0,0,0,,Сіз мені қарғыс атқан фильмді өртеуге мәжбүр еттіңіз!
Dialogue: 0,0:17:06.35,0:17:08.19,Default,,0,0,0,,Бұл – тұзақ.
Dialogue: 0,0:17:08.27,0:17:09.57,Default,,0,0,0,,Біріншіден, сол фильм
Dialogue: 0,0:17:09.65,0:17:12.86,Default,,0,0,0,,Эйдің қызғанышына орын жоқ.
Dialogue: 0,0:17:13.61,0:17:15.28,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:17:15.36,0:17:19.28,Default,,0,0,0,,Мен көптен бері олардың қасында болдым.
Dialogue: 0,0:17:20.53,0:17:23.12,Default,,0,0,0,,Осы тұрғыдан мынаны айтайын:
Dialogue: 0,0:17:23.20,0:17:24.29,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:24.37,0:17:27.29,Default,,0,0,0,,Бұл нашар жұмыс болды, оған күмән жоқ.
Dialogue: 0,0:17:28.83,0:17:31.50,Default,,0,0,0,,Бито сол фильмді түсіргеннен бір жыл бұрын.
Dialogue: 0,0:17:31.59,0:17:33.80,Default,,0,0,0,,Ei «Бақытсыз азғындық» деп жариялады
Dialogue: 0,0:17:33.88,0:17:37.30,Default,,0,0,0,,Дүние жүзінен жоғары баға алды
Dialogue: 0,0:17:38.43,0:17:40.55,Default,,0,0,0,,Битоның күйзелісі мен қызғанышы болды.
Dialogue: 0,0:17:40.64,0:17:44.52,Default,,0,0,0,,Мен шығарманы продюсердің нұсқауы бойынша түсірдім.
Dialogue: 0,0:17:45.27,0:17:49.23,Default,,0,0,0,,Ақшаны қажет еткенімен, қызықсыз болды...
Dialogue: 0,0:17:49.31,0:17:51.90,Default,,0,0,0,,Жанымды сатқан жаман шығарма болды.
Dialogue: 0,0:17:52.98,0:17:55.19,Default,,0,0,0,,Сондықтан Бито сол фильмді таңдады.
Dialogue: 0,0:17:55.28,0:17:57.03,Default,,0,0,0,,Оны «қарғыс атқан фильм» деп атайды.
Dialogue: 0,0:17:57.11,0:17:59.41,Default,,0,0,0,,Жариялаудан бас тартып, қашып кетті.
Dialogue: 0,0:18:00.32,0:18:03.66,Default,,0,0,0,,Бірақ мен оны өртеп жібермейінше істей алмадым.
Dialogue: 0,0:18:03.74,0:18:07.92,Default,,0,0,0,,Сонда Эй неге бұл фильм шедевр деп өтірік айтты?
Dialogue: 0,0:18:09.75,0:18:12.04,Default,,0,0,0,,Дос болғандықтан шығар
Dialogue: 0,0:18:13.55,0:18:14.42,Default,,0,0,0,,Мен ақыры түсіндім
Dialogue: 0,0:18:15.34,0:18:18.01,Default,,0,0,0,,Директор Эй не ойлады
Dialogue: 0,0:18:18.51,0:18:21.51,Default,,0,0,0,,Режиссер Битоның жалғыз өкінгені сол фильм болды.
Dialogue: 0,0:18:21.60,0:18:23.81,Default,,0,0,0,,Оған дақ бол
Dialogue: 0,0:18:24.31,0:18:27.77,Default,,0,0,0,,Директор Эй өзінің өкінішін өшірді.
Dialogue: 0,0:18:27.85,0:18:30.81,Default,,0,0,0,,Өміріңнің жарығын пайдалану...
Dialogue: 0,0:18:34.61,0:18:36.24,Default,,0,0,0,,Бұл достық
Dialogue: 0,0:18:36.74,0:18:38.57,Default,,0,0,0,,Мен сізді тағы қалай атасам болады?
Dialogue: 0,0:18:38.65,0:18:42.07,Default,,0,0,0,,Эй артықшылықты сезінгісі келген жоқ па?
Dialogue: 0,0:18:42.16,0:18:44.79,Default,,0,0,0,,Қарғыс атсын... сен ол жігітсің...
Dialogue: 0,0:18:44.87,0:18:49.54,Default,,0,0,0,,Екеуінің арасында қызғаныш болғаны сөзсіз.
Dialogue: 0,0:18:49.62,0:18:51.50,Default,,0,0,0,,Дегенмен, директор Эй қызғаншақ болса да,
Dialogue: 0,0:18:51.58,0:18:54.29,Default,,0,0,0,,Мен жоғалтқым келмейтін адамның болуы
Dialogue: 0,0:18:54.38,0:18:57.38,Default,,0,0,0,,Мен өмірдегі мақсатты сезіндім деп ойлаймын.
Dialogue: 0,0:18:58.13,0:19:03.05,Default,,0,0,0,,Бір-біріне деген қызғаныштары тәтті болды.
Dialogue: 0,0:19:03.14,0:19:06.18,Default,,0,0,0,,Жарысқа түскен екі адамның жасаған жұмысы
Dialogue: 0,0:19:06.27,0:19:08.77,Default,,0,0,0,,Берілмеу үшін жасаған шығармаларым болды
Dialogue: 0,0:19:08.85,0:19:12.15,Default,,0,0,0,,Адамдардың эмоциясын шайқап, жаңа қызғаныш туғызу
Dialogue: 0,0:19:12.23,0:19:16.36,Default,,0,0,0,,Бұл жұмыс тағы бір жаңа қызғаныш туғызды.
Dialogue: 0,0:19:17.23,0:19:22.36,Default,,0,0,0,,Бұл өте күлкілі, өте тәтті тізбек болды.
Dialogue: 0,0:19:23.70,0:19:27.12,Default,,0,0,0,,Бірақ, өкінішке орай, бітті.
Dialogue: 0,0:19:27.20,0:19:29.62,Default,,0,0,0,,Соңында фильмді өртеген адам...
Dialogue: 0,0:19:29.71,0:19:30.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:30.96,0:19:33.50,Default,,0,0,0,,Қызғаныштың астарында тағы бір сезім жатыр еді...
Dialogue: 0,0:19:33.58,0:19:36.42,Default,,0,0,0,,Бұл «таңдану» болуы мүмкін
Dialogue: 0,0:19:36.96,0:19:39.42,Default,,0,0,0,,Фантомдық фильмді кім іздеді?
Dialogue: 0,0:19:39.51,0:19:42.89,Default,,0,0,0,,Директор Эй директор Битоның бейнесіне тәнті болды.
Dialogue: 0,0:19:42.97,0:19:44.97,Default,,0,0,0,,Себебі мен оны қайта көргім келді...
Бұл
Dialogue: 0,0:19:45.05,0:19:46.89,Default,,0,0,0,,болуы мүмкін
Dialogue: 0,0:19:47.47,0:19:51.39,Default,,0,0,0,,Мен қызғаныштың жын-шайтаны ретінде мен шынымен түсінбеймін.
Dialogue: 0,0:19:52.06,0:19:53.65,Default,,0,0,0,,Қызғаныш пен таңданыс
Dialogue: 0,0:19:53.73,0:19:55.90,Default,,0,0,0,,Барлығы достық туралы болды.
Dialogue: 0,0:20:01.28,0:20:04.16,Default,,0,0,0,,Иә Иә! Сізге ұнайды деп үміттенемін
Dialogue: 0,0:20:05.20,0:20:08.12,Default,,0,0,0,,Иә, ләззат алыңыз!
Dialogue: 0,0:20:08.20,0:20:09.29,Default,,0,0,0,,Эххе
Dialogue: 0,0:20:14.25,0:20:15.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:16.00,0:20:17.46,Default,,0,0,0,,Сәлем, шайтан-күн
Dialogue: 0,0:20:17.54,0:20:18.17,Default,,0,0,0,,Уәде етілгендей
Dialogue: 0,0:20:18.25,0:20:20.05,Default,,0,0,0,,Жүрегіңді алуға келдім.
Dialogue: 0,0:20:20.13,0:20:20.92,Default,,0,0,0,,Уау
Dialogue: 0,0:20:21.01,0:20:22.22,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:20:22.72,0:20:24.18,Default,,0,0,0,,Мен бос емеспін
Dialogue: 0,0:20:24.26,0:20:25.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:26.01,0:20:28.81,Default,,0,0,0,,Мен сені тамақтандырамын дедім.
Dialogue: 0,0:20:30.14,0:20:31.31,Default,,0,0,0,,Бірақ ол «қашан» деп айтпайды
Dialogue: 0,0:20:31.39,0:20:32.18,Default,,0,0,0,,Уау
Dialogue: 0,0:20:32.27,0:20:35.19,Default,,0,0,0,,Шартта шарт күшіне енетін күн мен уақыт көрсетіледі.
Dialogue: 0,0:20:35.27,0:20:37.11,Default,,0,0,0,,анық көрсетілуі керек
Dialogue: 0,0:20:37.19,0:20:38.69,Default,,0,0,0,,Өйткені бұл туралы нақты көрсеткіш жоқ
Dialogue: 0,0:20:38.77,0:20:41.44,Default,,0,0,0,,Күн мен уақыт өзара келісім бойынша анықталады
Dialogue: 0,0:20:42.03,0:20:45.45,Default,,0,0,0,,Сондықтан жегің келсе, мен келіскенше күте тұр.
Dialogue: 0,0:20:45.53,0:20:47.07,Default,,0,0,0,,Қашан?
Dialogue: 0,0:20:47.16,0:20:50.45,Default,,0,0,0,,Уайымдама, мен сені өлгенше тамақтандырамын.
Dialogue: 0,0:20:50.54,0:20:52.96,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:20:53.04,0:20:55.21,Default,,0,0,0,,Бұл шайтан!
Dialogue: 0,0:20:55.29,0:20:57.21,Default,,0,0,0,,Ол осылай аталады
Dialogue: 0,0:20:57.29,0:20:58.79,Default,,0,0,0,,Ондай бос сөзді айтпа!
Dialogue: 0,0:20:58.88,0:20:59.54,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:20:59.63,0:21:01.09,Default,,0,0,0,,Әй, шайтан!
Dialogue: 0,0:21:01.17,0:21:01.67,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:21:02.34,0:21:05.34,Default,,0,0,0,,(Қатты рок)
Dialogue: 0,0:21:08.05,0:21:08.68,Default,,0,0,0,,ал Ол Майтпен шайқасу – қауіпті ғана емес,
Dialogue: 0,0:21:08.76,0:21:10.56,Default,,0,0,0,,Ха... жіберші...
Dialogue: 0,0:21:10.64,0:21:13.43,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:21:13.93,0:21:15.02,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:21:26.99,0:21:28.99,Default,,0,0,0,,♪～
Dialogue: 0,0:21:37.00,0:21:37.79,Default,,0,0,0,,Достық бұл
Dialogue: 0,0:21:37.87,0:21:41.30,Default,,0,0,0,,Бұл бізді, Он екі Апостолды байланыстыратын маңызды нәрсе.
Dialogue: 0,0:21:41.38,0:21:44.84,Default,,0,0,0,,Екінші шайтан да түсінетін уақыт келеді деп сенемін.
Dialogue: 0,0:21:44.92,0:21:46.55,Default,,0,0,0,,Міне, жоғарыдан келген бала.
Dialogue: 0,0:21:46.63,0:21:48.05,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:21:48.14,0:21:49.09,Default,,0,0,0,,Жарқанат мысық
Dialogue: 0,0:21:49.18,0:21:52.26,Default,,0,0,0,,Сіз де оған сенесіз бе?
Dialogue: 0,0:21:52.35,0:21:56.27,Default,,0,0,0,,Оған сенетін адам керек.
Dialogue: 0,0:21:56.35,0:21:57.10,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:57.19,0:22:00.11,Default,,0,0,0,,Девил-кун, ол сенің нағыз әкең екені анық.
Dialogue: 0,0:22:00.19,0:22:01.06,Default,,0,0,0,,...
Dialogue: 0,0:22:01.15,0:22:02.02,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:22:02.11,0:22:05.57,Default,,0,0,0,,Мен мұның болғанын қалаймын, бірақ бұл мүмкін емес.
Dialogue: 0,0:22:05.65,0:22:07.95,Default,,0,0,0,,Бұл жағынан Мефисто II жақсырақ.
Dialogue: 0,0:22:08.03,0:22:10.95,Default,,0,0,0,,Үшінші ұрпақ әке ісіне қабілетті болды.
Dialogue: 0,0:22:11.03,0:22:12.24,Default,,0,0,0,,Мен де сенен үйренуім керек.
Dialogue: 0,0:22:12.33,0:22:13.66,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:22:13.74,0:22:16.29,Default,,0,0,0,,Бұл оның сыртқы түріне байланысты болуы мүмкін.
Dialogue: 0,0:22:16.37,0:22:18.17,Default,,0,0,0,,Ібіліс-күн... Әй, бірінші буын.
Dialogue: 0,0:22:18.25,0:22:20.46,Default,,0,0,0,,Мәңгілік жас болып қала бер
Dialogue: 0,0:22:20.54,0:22:22.46,Default,,0,0,0,,Ібілістің тапсырмасын орындау
Dialogue: 0,0:22:22.54,0:22:25.05,Default,,0,0,0,,Өйткені жын әлемінде адамдар көбірек.
Dialogue: 0,0:22:25.13,0:22:27.59,Default,,0,0,0,,Жын дүниесінде қартаймайсың ба?
Dialogue: 0,0:22:27.67,0:22:28.34,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:28.43,0:22:31.22,Default,,0,0,0,,Мен бұл туралы анық ештеңе білмеймін.
Dialogue: 0,0:22:31.30,0:22:35.06,Default,,0,0,0,,Жындар дүниесінде қартаю адам дүниесіне қарағанда басқаша дейді.
Dialogue: 0,0:22:35.14,0:22:37.23,Default,,0,0,0,,Мефисто II Экчанмен бірге.
Dialogue: 0,0:22:37.31,0:22:40.40,Default,,0,0,0,,Мен адам әлемінде ұзақ өмір сүрдім, сондықтан мен қартайдым деп ойлаймын.
Dialogue: 0,0:22:40.48,0:22:43.15,Default,,0,0,0,,Өйткені доктор Фауст та жындар әлеміне енген.
Dialogue: 0,0:22:43.23,0:22:46.15,Default,,0,0,0,,Менің ойымша, зерттеулер 300 жылдан астам уақыт бойы жалғасты.
Dialogue: 0,0:22:46.23,0:22:47.90,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:22:47.99,0:22:51.62,Default,,0,0,0,,Қанша жаста болсақ та, достығымыз өзгермейді.
Dialogue: 0,0:22:51.70,0:22:52.53,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:22:52.62,0:22:54.08,Default,,0,0,0,,Хахаха дұрыс.
Dialogue: 0,0:22:54.16,0:22:56.04,Default,,0,0,0,,Жақсы бірдеңе айт Бат Мысық
Dialogue: 0,0:22:56.12,0:22:57.33,Default,,0,0,0,,Хехехе
Dialogue: 0,0:22:57.41,0:23:01.54,Default,,0,0,0,,Соңғы 30 жыл ішінде мен біршама өстім.
Dialogue: 0,0:23:01.63,0:23:02.63,Default,,0,0,0,,Жүз көз
Dialogue: 0,0:23:02.71,0:23:03.42,Default,,0,0,0,,Иә
Dialogue: 0,0:23:03.50,0:23:07.21,Default,,0,0,0,,Біздің түпкі арманымызға апаратын жол әлі ұзақ
Dialogue: 0,0:23:07.30,0:23:07.92,Default,,0,0,0,,Шындығында, 2-сыныпты үш тәжірибеші мен бір 1-сыныпты тәжірибеші қызмет барысында қаза тапты.
Dialogue: 0,0:23:08.01,0:23:09.34,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:23:09.42,0:23:11.80,Default,,0,0,0,,♪ Орташа болғым келмейді, бас тартқым келмейді, бас тартқым келмейді.
Dialogue: 0,0:23:11.89,0:23:14.81,Default,,0,0,0,,Олай болса, «Насаке най» дейсің.
Dialogue: 0,0:23:24.90,0:23:26.90,Default,,0,0,0,,～♪
Dialogue: 0,0:23:28.40,0:23:34.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory