Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.01,0:00:18.68,Default,,0,0,0,,Мен шайтан болғым келеді
Dialogue: 0,0:00:18.76,0:00:21.27,Default,,0,0,0,,Неге шайтан болғың келеді?
Dialogue: 0,0:00:21.77,0:00:25.23,Default,,0,0,0,,Ібілістің күші зор, солай ма?
Dialogue: 0,0:00:25.31,0:00:27.69,Default,,0,0,0,,Бұл күшті жаман адамдарды жеңу үшін пайдаланыңыз
Dialogue: 0,0:00:27.77,0:00:30.98,Default,,0,0,0,,Идея қызықты
Dialogue: 0,0:00:31.53,0:00:32.19,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:32.28,0:00:33.40,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:33.49,0:00:34.70,Default,,0,0,0,,Бас тарту Wow
Dialogue: 0,0:00:34.78,0:00:36.45,Default,,0,0,0,,Профессор, шай ішесіз бе?
Dialogue: 0,0:00:37.16,0:00:37.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:37.74,0:00:38.78,Default,,0,0,0,,Бұл жақсы болмады ма?
Dialogue: 0,0:00:39.28,0:00:41.75,Default,,0,0,0,,Мио-чан айтты, солай ма?
Dialogue: 0,0:00:41.83,0:00:44.29,Default,,0,0,0,,Шайтан көмектеседі дейді
Dialogue: 0,0:00:44.37,0:00:46.83,Default,,0,0,0,,Анау маскүнем
Dialogue: 0,0:00:46.92,0:00:49.21,Default,,0,0,0,,Мен сізді соншалықты көп біледі деп ойладым.
Dialogue: 0,0:00:49.29,0:00:51.76,Default,,0,0,0,,Бұл керемет жігіт кім?
Dialogue: 0,0:00:51.84,0:00:53.47,Default,,0,0,0,,Мен де түсінбеймін.
Dialogue: 0,0:00:53.97,0:00:54.55,Default,,0,0,0,,А...
Dialogue: 0,0:00:55.13,0:00:55.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:55.72,0:00:58.80,Default,,0,0,0,,Ол біртүрлі істерді шешумен танымал.
Dialogue: 0,0:00:58.89,0:01:01.18,Default,,0,0,0,,3-ші көшедегі пәтерде оқиға болды, солай ма?
Dialogue: 0,0:01:01.26,0:01:03.14,Default,,0,0,0,,Бұл шешілді, шайтан-күн.
Dialogue: 0,0:01:03.22,0:01:06.14,Default,,0,0,0,,Ондай жағдайда Мио-чаннан да сұраңыз.
Dialogue: 0,0:01:06.90,0:01:07.40,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:07.48,0:01:08.73,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:09.23,0:01:10.48,Default,,0,0,0,,Өйткені ол осында...
Dialogue: 0,0:01:10.98,0:01:11.86,Default,,0,0,0,,Бұл жігіт пе?
Dialogue: 0,0:01:12.36,0:01:14.19,Default,,0,0,0,,Ол болса, онда ол!
Dialogue: 0,0:01:14.69,0:01:15.65,Default,,0,0,0,,Кім?
Dialogue: 0,0:01:16.32,0:01:17.16,Default,,0,0,0,,Қаңқа
Dialogue: 0,0:01:19.16,0:01:21.83,Default,,0,0,0,,Мио-чан, сен одан қорқасың ба?
Dialogue: 0,0:01:21.91,0:01:22.83,Default,,0,0,0,,Өте тітіркендіргіш! Апыр-ай!
Dialogue: 0,0:01:22.91,0:01:24.08,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:01:24.16,0:01:26.04,Default,,0,0,0,,Тататата...
Dialogue: 0,0:01:26.12,0:01:29.25,Default,,0,0,0,,Оның орнына қалай шайтан болуға болады
Dialogue: 0,0:01:29.75,0:01:31.75,Default,,0,0,0,,♪～
Dialogue: 0,0:01:42.81,0:01:44.81,Default,,0,0,0,,～♪
Dialogue: 0,0:01:45.31,0:01:48.10,Default,,0,0,0,,(шаңсорғыш моторының дыбысы)
Dialogue: 0,0:01:53.40,0:01:55.11,Default,,0,0,0,,Мына кішкентай жігіт ше?
Dialogue: 0,0:01:55.86,0:01:57.28,Default,,0,0,0,,Мефисто III
Dialogue: 0,0:01:57.86,0:02:01.03,Default,,0,0,0,,Ол шайтанға алтын балықтың қытығындай жабысады.
Dialogue: 0,0:02:01.95,0:02:04.20,Default,,0,0,0,,Біз соншалықты тату емес сияқтымыз, бірақ...
Dialogue: 0,0:02:04.70,0:02:07.21,Default,,0,0,0,,Біз әдетте жақсы достармыз.
Dialogue: 0,0:02:08.21,0:02:11.13,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:11.21,0:02:12.38,Default,,0,0,0,,Әй, біреу келді.
Dialogue: 0,0:02:21.34,0:02:22.64,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:02:22.72,0:02:25.10,Default,,0,0,0,,Иә, дәл қазір.
Dialogue: 0,0:02:26.43,0:02:29.35,Default,,0,0,0,,А... Иә, иә, қазір аша аламын.
Dialogue: 0,0:02:30.10,0:02:31.35,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:31.44,0:02:32.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:33.73,0:02:34.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:37.19,0:02:38.61,Default,,0,0,0,,Сіз шайтансыз ба?
Dialogue: 0,0:02:38.70,0:02:40.11,Default,,0,0,0,,(жүгіру)
Dialogue: 0,0:02:40.20,0:02:41.95,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:02:42.03,0:02:46.12,Default,,0,0,0,,Мефистофель III
Dialogue: 0,0:02:47.33,0:02:48.29,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:02:49.25,0:02:50.58,Default,,0,0,0,,Жоқ... а...
Dialogue: 0,0:02:51.33,0:02:53.13,Default,,0,0,0,,А... мынау шайтан ғой
Dialogue: 0,0:02:53.21,0:02:54.13,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:02:54.21,0:02:57.13,Default,,0,0,0,,Сіз, жалға алудан бас тартпаңыз.
Dialogue: 0,0:02:57.21,0:02:58.09,Default,,0,0,0,,Сол жалықтырар жігіт…
Dialogue: 0,0:02:58.17,0:03:00.93,Default,,0,0,0,,Дүниелік істермен айналысуға уақытым жоқ.
Dialogue: 0,0:03:02.26,0:03:04.89,Default,,0,0,0,,Сәл күте тұрыңыз
Dialogue: 0,0:03:06.26,0:03:09.18,Default,,0,0,0,,Жұмыс істемейтіндер тамақ ішпеуі керек, солай ма?
Dialogue: 0,0:03:09.27,0:03:12.19,Default,,0,0,0,,Олай болса, жұмыс істей алмайтындардың өлуден басқа амалы жоқ па?
Dialogue: 0,0:03:12.27,0:03:14.06,Default,,0,0,0,,Олай қисынды болма!
Dialogue: 0,0:03:14.15,0:03:16.23,Default,,0,0,0,,Егер тезис дұрыс болса
Dialogue: 0,0:03:16.32,0:03:17.90,Default,,0,0,0,,Әрине солай.
Dialogue: 0,0:03:17.98,0:03:21.03,Default,,0,0,0,,Ең алдымен, Жаңа өсиеттегі салоникалықтарға...
Dialogue: 0,0:03:21.11,0:03:22.82,Default,,0,0,0,,Екінші әріптің мақсаты қандай болды?
Dialogue: 0,0:03:23.57,0:03:24.49,Default,,0,0,0,,Сіз сияқты...
Dialogue: 0,0:03:24.57,0:03:26.95,Default,,0,0,0,,Сіз шынымен доссыз ба? Сол екі адам
Dialogue: 0,0:03:27.04,0:03:28.62,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:29.91,0:03:31.33,Default,,0,0,0,,Мм... (Мефисто III) Иә?
Dialogue: 0,0:03:31.96,0:03:34.83,Default,,0,0,0,,Бұл Мыңжылдық институты, солай ма?
Dialogue: 0,0:03:35.42,0:03:36.88,Default,,0,0,0,,Ақыл-ой айтпайды
Dialogue: 0,0:03:36.96,0:03:39.84,Default,,0,0,0,,Сіз жұмбақ істі шешесіз, солай ма?
Dialogue: 0,0:03:44.01,0:03:45.43,Default,,0,0,0,,Бұл мистер Рент болды ма?
Dialogue: 0,0:03:45.51,0:03:46.85,Default,,0,0,0,,Мен Такекумамын
Dialogue: 0,0:03:47.89,0:03:51.06,Default,,0,0,0,,Бұл менің досым Джозеф Икея.
Dialogue: 0,0:03:51.56,0:03:53.10,Default,,0,0,0,,Ол жақсы жігіт.
Dialogue: 0,0:03:53.19,0:03:54.10,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:54.19,0:03:56.61,Default,,0,0,0,,Себебі менің әкем шетелдік
Dialogue: 0,0:03:56.69,0:03:58.61,Default,,0,0,0,,Мені кішкентайымнан қорлады.
Dialogue: 0,0:03:59.11,0:04:01.07,Default,,0,0,0,,Мен орта мектепті бітіріп қалдым.
Dialogue: 0,0:04:01.57,0:04:05.70,Default,,0,0,0,,Бірақ мен көп еңбектеніп, мектепті бітірдім.
Dialogue: 0,0:04:06.20,0:04:08.08,Default,,0,0,0,,Бір университетте оқыдық.
Dialogue: 0,0:04:08.16,0:04:09.91,Default,,0,0,0,,Ақыр аяғында, бұл нәтиже болмады.
Dialogue: 0,0:04:09.99,0:04:12.08,Default,,0,0,0,,Біз ойын ойнайтын достармыз.
Dialogue: 0,0:04:12.16,0:04:13.92,Default,,0,0,0,,Мен көшеге жиі шығатынмын.
Dialogue: 0,0:04:14.71,0:04:17.92,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:04:19.00,0:04:21.09,Default,,0,0,0,,Икея, сен осындасың, солай ма?
Dialogue: 0,0:04:22.59,0:04:24.80,Default,,0,0,0,,Бұл менмін, Такекума.
Dialogue: 0,0:04:26.18,0:04:27.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:27.51,0:04:33.06,Default,,0,0,0,,(шу)
Dialogue: 0,0:04:40.28,0:04:41.82,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:04:41.90,0:04:42.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:42.53,0:04:46.95,Default,,0,0,0,,(Қара көлеңкенің ырылдауы)
Dialogue: 0,0:04:47.03,0:04:48.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:50.54,0:04:53.20,Default,,0,0,0,,(Қара көлеңкенің ырылдауы)
Dialogue: 0,0:04:53.29,0:04:55.62,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:04:56.17,0:04:57.00,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:04:59.42,0:05:00.59,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:01.09,0:05:02.01,Default,,0,0,0,,Дәл...
Dialogue: 0,0:05:02.09,0:05:05.76,Default,,0,0,0,,Бұл біз шешуіміз керек жағдай.
Dialogue: 0,0:05:06.63,0:05:08.97,Default,,0,0,0,,Қызық, қандай шайтан жамандық жасап жатыр?
Dialogue: 0,0:05:09.05,0:05:10.26,Default,,0,0,0,,Бұл жұмбақ...
Dialogue: 0,0:05:18.44,0:05:20.11,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:05:20.19,0:05:22.61,Default,,0,0,0,,Балалармен қарым-қатынасым жақсы емес.
Dialogue: 0,0:05:22.69,0:05:25.19,Default,,0,0,0,,Маған серік боламын десең...
Dialogue: 0,0:05:25.70,0:05:26.78,Default,,0,0,0,,О...
Dialogue: 0,0:05:26.86,0:05:28.11,Default,,0,0,0,,Эй... күте тұрыңыз.
Dialogue: 0,0:05:28.82,0:05:31.12,Default,,0,0,0,,Мио-чанмен араласу қиын.
Dialogue: 0,0:05:31.20,0:05:33.33,Default,,0,0,0,,Осылай қал, кетпе
Dialogue: 0,0:05:33.41,0:05:35.66,Default,,0,0,0,,Елеусіз қалма, тыңдама
Dialogue: 0,0:05:35.75,0:05:38.25,Default,,0,0,0,,Келісетініміз сирек болатын.
Dialogue: 0,0:05:42.30,0:05:43.88,Default,,0,0,0,,Бұл Икейяның бөлмесі.
Dialogue: 0,0:05:50.35,0:05:52.14,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:52.22,0:05:54.43,Default,,0,0,0,,Құлыптан босатылды
Dialogue: 0,0:05:55.48,0:05:56.68,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:56.77,0:05:59.27,Default,,0,0,0,,(Қара көлеңкенің айқайы)
Dialogue: 0,0:06:00.48,0:06:01.86,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:06:01.94,0:06:04.11,Default,,0,0,0,,(Қара көлеңкенің айқайы)
Dialogue: 0,0:06:04.19,0:06:05.65,Default,,0,0,0,,Мен қазір кетемін.
Dialogue: 0,0:06:06.15,0:06:07.11,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:06:07.20,0:06:10.87,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:10.95,0:06:13.62,Default,,0,0,0,,(Сиқырлы шеңбер сызу дыбысы)
Dialogue: 0,0:06:13.70,0:06:16.12,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:17.71,0:06:20.83,Default,,0,0,0,,Косей шынымен бұған қол жеткізе ала ма екен?
Dialogue: 0,0:06:20.92,0:06:22.63,Default,,0,0,0,,Мен іздеймін және сотқа беремін
Dialogue: 0,0:06:24.46,0:06:28.09,Default,,0,0,0,,Мен сізге Потестат Диаболиді беремін
Dialogue: 0,0:06:30.72,0:06:31.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:31.72,0:06:33.64,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:34.51,0:06:37.93,Default,,0,0,0,,Сиқырлы күш Абсолютті нөл~!
Dialogue: 0,0:06:38.02,0:06:40.94,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:43.52,0:06:45.57,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:52.66,0:06:54.12,Default,,0,0,0,,Хаа…
Dialogue: 0,0:06:54.66,0:06:56.87,Default,,0,0,0,,Мио-чан, қазір қашайық.
Dialogue: 0,0:06:57.45,0:06:59.08,Default,,0,0,0,,Ах... менің аяғым...
Dialogue: 0,0:07:00.04,0:07:01.17,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:07:02.17,0:07:04.59,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:07:06.30,0:07:08.46,Default,,0,0,0,,Абсолюттік нөл жұмыс істемейді
Dialogue: 0,0:07:08.55,0:07:10.34,Default,,0,0,0,,Жартылай адам шайтан болғандықтан ба?
Dialogue: 0,0:07:10.84,0:07:12.80,Default,,0,0,0,,Стратегиялық ауысу
Dialogue: 0,0:07:13.30,0:07:15.01,Default,,0,0,0,,Басқаша айтқанда, қаш! (Мефисто III) Уау!
Dialogue: 0,0:07:15.10,0:07:18.02,Default,,0,0,0,,(Қара көлеңкенің ырылдауы)
Dialogue: 0,0:07:24.11,0:07:28.69,Default,,0,0,0,,(Миотачидің ауыр тыныс алуы)
Dialogue: 0,0:07:29.36,0:07:30.90,Default,,0,0,0,,Бұл қорқынышты болды...
Dialogue: 0,0:07:30.99,0:07:32.86,Default,,0,0,0,,Хаа... мен де
Dialogue: 0,0:07:35.78,0:07:39.16,Default,,0,0,0,,Бірақ шайтанның күші керемет.
Dialogue: 0,0:07:39.25,0:07:41.00,Default,,0,0,0,,Шайтан қашып кетті.
Dialogue: 0,0:07:41.79,0:07:44.96,Default,,0,0,0,,Мен шайтан болғым келеді.
Dialogue: 0,0:07:45.04,0:07:48.13,Default,,0,0,0,,Ібіліс болып, жамандарды жең
Dialogue: 0,0:07:48.21,0:07:49.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:49.30,0:07:51.88,Default,,0,0,0,,Мефисто жартылай адам деп айтпадың ба?
Dialogue: 0,0:07:51.97,0:07:53.38,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:07:53.89,0:07:55.97,Default,,0,0,0,,Оның әкесі біртүрлі.
Dialogue: 0,0:07:56.47,0:07:59.02,Default,,0,0,0,,Күндіз итпен серуендеу
Dialogue: 0,0:07:59.60,0:08:01.64,Default,,0,0,0,,Саябақта күнге күйіп тұру
Dialogue: 0,0:08:01.73,0:08:04.27,Default,,0,0,0,,Мен Одеонға таңертең келдім.
Dialogue: 0,0:08:04.35,0:08:06.77,Default,,0,0,0,,Мүмкін ол шайтан болғандықтан...
Dialogue: 0,0:08:07.86,0:08:08.77,Default,,0,0,0,,Мұнда
Dialogue: 0,0:08:09.28,0:08:10.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.19,0:08:11.78,Default,,0,0,0,,Қалай шайтан болуға болады
Dialogue: 0,0:08:11.86,0:08:14.07,Default,,0,0,0,,Шайтаннан сұрау тезірек!
Dialogue: 0,0:08:14.86,0:08:16.78,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:08:16.87,0:08:19.79,Default,,0,0,0,,А, иә, сәл күте тұрыңыз~
Dialogue: 0,0:08:19.87,0:08:22.79,Default,,0,0,0,,(Үздіксіз қоңыраулар)
Dialogue: 0,0:08:22.87,0:08:24.96,Default,,0,0,0,,Мен сізге бір минут күтуіңізді айтып жатырмын...
Dialogue: 0,0:08:25.04,0:08:26.54,Default,,0,0,0,,Ах Мио-чан
Dialogue: 0,0:08:27.42,0:08:29.30,Default,,0,0,0,,Ағай, сіз шайтансыз ба?
Dialogue: 0,0:08:29.38,0:08:30.38,Default,,0,0,0,,Не!
Dialogue: 0,0:08:32.55,0:08:34.76,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:08:36.39,0:08:38.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:38.93,0:08:40.93,Default,,0,0,0,,Бұл қандай жағдай...
Dialogue: 0,0:08:41.02,0:08:44.27,Default,,0,0,0,,Достық испан инквизициясы?
Dialogue: 0,0:08:45.35,0:08:47.77,Default,,0,0,0,,Қария шынымен шайтан ма?
Dialogue: 0,0:08:47.86,0:08:50.78,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:08:54.36,0:08:56.28,Default,,0,0,0,,Иә, нағашы – шайтан.
Dialogue: 0,0:08:56.36,0:08:57.78,Default,,0,0,0,,А, мен айттым...
Dialogue: 0,0:08:57.87,0:08:59.70,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:08:59.78,0:09:01.99,Default,,0,0,0,,Иә, шайтан болған.
Dialogue: 0,0:09:02.08,0:09:02.79,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:09:02.87,0:09:05.33,Default,,0,0,0,,Ағай, мені өзіңе шәкірт ет.
Dialogue: 0,0:09:05.83,0:09:08.00,Default,,0,0,0,,Не? Ал... Шәкірт?
Dialogue: 0,0:09:08.08,0:09:09.88,Default,,0,0,0,,Бұл жігіттің аты «Махиро»
Dialogue: 0,0:09:09.96,0:09:11.17,Default,,0,0,0,,Ол шайтан болғысы келетінін айтады.
Dialogue: 0,0:09:11.25,0:09:11.75,Default,,0,0,0,,Не!
Dialogue: 0,0:09:12.59,0:09:14.22,Default,,0,0,0,,Жоқ, жоқ, мен шайтан болғым келеді.
Dialogue: 0,0:09:14.30,0:09:16.09,Default,,0,0,0,,Неліктен бұл қайталануда...
Dialogue: 0,0:09:16.18,0:09:18.76,Default,,0,0,0,,Жамандарды шайтанның күшімен жең!
Dialogue: 0,0:09:18.84,0:09:22.77,Default,,0,0,0,,Жоқ. Сонда да адамдар жынға айналуы мүмкін...
Dialogue: 0,0:09:22.85,0:09:24.89,Default,,0,0,0,,Әй, әйеліңмен қалай таныстың?
Dialogue: 0,0:09:24.98,0:09:25.56,Default,,0,0,0,,(дауыс дыбысы)
Dialogue: 0,0:09:25.64,0:09:27.27,Default,,0,0,0,,Бұл маңызды емес, иә?
Dialogue: 0,0:09:27.35,0:09:28.69,Default,,0,0,0,,Мені қызықтырады.
Dialogue: 0,0:09:28.77,0:09:30.69,Default,,0,0,0,,Жын мен адам жұбы.
Dialogue: 0,0:09:30.77,0:09:33.73,Default,,0,0,0,,Мен олардың қалай үйленгенін білгім келеді.
Dialogue: 0,0:09:33.82,0:09:35.11,Default,,0,0,0,,Дұрыс па? (Мефисто II) Иә?
Dialogue: 0,0:09:35.19,0:09:36.78,Default,,0,0,0,,Не... біз бір-бірімізге қалай үйрендік?
Dialogue: 0,0:09:36.86,0:09:38.99,Default,,0,0,0,,Не... маңызды емес, солай ма?
Dialogue: 0,0:09:39.07,0:09:41.20,Default,,0,0,0,,Иә, маңызды емес.
Dialogue: 0,0:09:41.28,0:09:43.24,Default,,0,0,0,,Мен оны естімейінше үйге бармаймын.
Dialogue: 0,0:09:43.33,0:09:44.75,Default,,0,0,0,,Аа...
Dialogue: 0,0:09:44.83,0:09:48.04,Default,,0,0,0,,Экчан менің ең жақын досымның әпкесі
Dialogue: 0,0:09:48.12,0:09:50.75,Default,,0,0,0,,Мен оны бастауыш сыныпта оқып жүргенде кездестірдім.
Dialogue: 0,0:09:50.84,0:09:52.46,Default,,0,0,0,,Бала күнгі досым!
Dialogue: 0,0:09:52.55,0:09:55.59,Default,,0,0,0,,Махаббат!
Dialogue: 0,0:09:55.67,0:09:57.51,Default,,0,0,0,,Керемет шугир~
Dialogue: 0,0:09:57.59,0:09:59.18,Default,,0,0,0,,Бұл фильм сияқты
Dialogue: 0,0:09:59.26,0:10:01.01,Default,,0,0,0,,Эй, маған егжей-тегжейлі айтып берші, ха...
Dialogue: 0,0:10:01.10,0:10:03.31,Default,,0,0,0,,Мен айтқан соң қайтасың ба?
Dialogue: 0,0:10:03.39,0:10:04.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:06.43,0:10:09.15,Default,,0,0,0,,Ең бірінші мен шайтанды кездестірдім...
Dialogue: 0,0:10:09.23,0:10:12.11,Default,,0,0,0,,Әй, сен білетін шайтан емес.
Dialogue: 0,0:10:15.57,0:10:17.11,Default,,0,0,0,,Сол шайтан...
Dialogue: 0,0:10:17.19,0:10:19.36,Default,,0,0,0,,Бұл емес пе?
Dialogue: 0,0:10:19.45,0:10:21.41,Default,,0,0,0,,Ах, Элигор.
Dialogue: 0,0:10:21.49,0:10:23.49,Default,,0,0,0,,Не, сен білесің бе?
Dialogue: 0,0:10:23.58,0:10:24.87,Default,,0,0,0,,Жалпы мағына
Dialogue: 0,0:10:26.29,0:10:29.37,Default,,0,0,0,,Соғыс пен қақтығысты жақсы көретін жын болса керек.
Dialogue: 0,0:10:29.46,0:10:32.38,Default,,0,0,0,,Немесе жанжалдың азабын қалайды
Dialogue: 0,0:10:32.46,0:10:33.67,Default,,0,0,0,,(саусақтардың үстелді түрту дыбысы)
Dialogue: 0,0:10:33.75,0:10:36.38,Default,,0,0,0,,Мен мұны білмей тұрып ұсыныс жасадым.
Dialogue: 0,0:10:36.96,0:10:39.22,Default,,0,0,0,,Мен жауап ала алмаған сияқтымын.
Dialogue: 0,0:10:39.30,0:10:41.47,Default,,0,0,0,,Біз бірге кино көруге бардық...
Dialogue: 0,0:10:41.55,0:10:45.39,Default,,0,0,0,,Сіз «Гунджо бәсекесін» білмеуіңіз мүмкін.
Dialogue: 0,0:10:45.47,0:10:46.47,Default,,0,0,0,,Мен көрдім
Dialogue: 0,0:10:46.56,0:10:48.93,Default,,0,0,0,,Мен оны шынымен түсінбеймін, бірақ бұл жақсы фильм.
Dialogue: 0,0:10:49.02,0:10:50.02,Default,,0,0,0,,Сонда?
Dialogue: 0,0:10:50.10,0:10:53.02,Default,,0,0,0,,Экчан бұл туралы фильмнен кейін айтты.
Dialogue: 0,0:10:54.77,0:10:56.78,Default,,0,0,0,,«Бір жерде күлімсіреу»
Dialogue: 0,0:10:56.86,0:10:59.82,Default,,0,0,0,,«Егер мен сенімен бір жерде жыла алсам»
Dialogue: 0,0:11:00.32,0:11:03.57,Default,,0,0,0,,«Мүмкін біз бір жерде болуымыз мүмкін».
Dialogue: 0,0:11:04.08,0:11:04.58,Default,,0,0,0,,Иә
Dialogue: 0,0:11:04.66,0:11:06.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:06.24,0:11:08.79,Default,,0,0,0,,Маған бұл маңызды емес!
Dialogue: 0,0:11:08.87,0:11:12.00,Default,,0,0,0,,Мен шайтан болғанша үйге бармаймын!
Dialogue: 0,0:11:13.13,0:11:14.00,Default,,0,0,0,,А...
Dialogue: 0,0:11:14.09,0:11:16.96,Default,,0,0,0,,Махиро үйге бармаса, мен де үйге бармаймын.
Dialogue: 0,0:11:17.05,0:11:19.26,Default,,0,0,0,,Иә! Сіз үйге бара жатқаныңызды айттыңыз.
Dialogue: 0,0:11:19.34,0:11:21.88,Default,,0,0,0,,(Сателла) Мен сенің мұнда екеніңе қуаныштымын. Бұл жолы сені жіберіп алмаймын.
Dialogue: 0,0:11:21.97,0:11:24.30,Default,,0,0,0,,Бұл қорқынышты. Бұл қорқынышты.
Dialogue: 0,0:11:24.39,0:11:25.55,Default,,0,0,0,,Бала?
Dialogue: 0,0:11:25.64,0:11:29.14,Default,,0,0,0,,Балаға айтылғанда одан бетер мұңды болатын сөздер...
Dialogue: 0,0:11:29.23,0:11:32.48,Default,,0,0,0,,Әй, маған қалай шайтан болу керектігін айтшы.
Dialogue: 0,0:11:36.94,0:11:37.98,Default,,0,0,0,,Егер бұл жақсы болмаса, жоқ!
Dialogue: 0,0:11:39.90,0:11:41.36,Default,,0,0,0,,Ал, мен серуендеуге барамын.
Dialogue: 0,0:11:41.45,0:11:42.99,Default,,0,0,0,,Балалар сендер үйге қайтыңдар.
Dialogue: 0,0:11:43.07,0:11:44.32,Default,,0,0,0,,Келісесің бе?
Dialogue: 0,0:11:55.33,0:11:56.92,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:58.59,0:11:59.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:59.59,0:12:01.01,Default,,0,0,0,,(Мефисто II-нің ауыр тыныс алуы)
Dialogue: 0,0:12:01.09,0:12:02.51,Default,,0,0,0,,(Миотачидің ауыр тыныс алуы)
Dialogue: 0,0:12:02.59,0:12:05.01,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:12:05.09,0:12:08.01,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:12:08.10,0:12:12.52,Default,,0,0,0,,(Мефисто II-нің ауыр тыныс алуы)
Dialogue: 0,0:12:14.85,0:12:16.27,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:12:16.36,0:12:18.11,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:12:18.19,0:12:19.32,Default,,0,0,0,,Өткенге… электрондық хат па?
Dialogue: 0,0:12:19.86,0:12:20.90,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:12:21.40,0:12:21.90,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:12:21.99,0:12:23.99,Default,,0,0,0,,Тек «Сіз кешкі асқа не қалайсыз?»
Dialogue: 0,0:12:24.74,0:12:26.62,Default,,0,0,0,,Такекума-санды қауіпсіз жерге апарыңыз
Dialogue: 0,0:12:26.70,0:12:27.53,Default,,0,0,0,,Иә
Dialogue: 0,0:12:28.33,0:12:29.54,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:29.62,0:12:31.04,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:12:32.12,0:12:35.08,Default,,0,0,0,,(Сиқырлы шеңбер сызу дыбысы)
Dialogue: 0,0:12:41.26,0:12:43.84,Default,,0,0,0,,(Эригордың ырылдауы)
Dialogue: 0,0:12:44.38,0:12:46.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:46.39,0:12:47.76,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:47.85,0:12:49.05,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:12:50.89,0:12:51.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:54.48,0:12:55.31,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:12:58.27,0:13:00.57,Default,,0,0,0,,(Эригордың айқайы)
Dialogue: 0,0:13:02.07,0:13:02.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:03.15,0:13:04.32,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:13:04.40,0:13:05.45,Default,,0,0,0,,Гррр…
Dialogue: 0,0:13:12.79,0:13:15.33,Default,,0,0,0,,(Эригордың ыңырануы)
Dialogue: 0,0:13:20.46,0:13:21.92,Default,,0,0,0,,Тиіп көр!
Dialogue: 0,0:13:23.63,0:13:24.76,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:13:25.88,0:13:27.22,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:13:27.72,0:13:28.97,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:13:29.47,0:13:33.06,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:33.14,0:13:34.18,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:13:34.27,0:13:35.94,Default,,0,0,0,,Сиқырлы қорғаныс кедергісі...
Dialogue: 0,0:13:36.02,0:13:37.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:45.53,0:13:47.70,Default,,0,0,0,,Қашанға дейін менің соңымнан жүресің?
Dialogue: 0,0:13:47.78,0:13:49.95,Default,,0,0,0,,Мен шайтан болғанша!
Dialogue: 0,0:13:50.03,0:13:51.53,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:52.03,0:13:53.37,Default,,0,0,0,,(Эригордың ырылдауы)
Dialogue: 0,0:13:53.45,0:13:54.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:54.79,0:13:56.12,Default,,0,0,0,,Ичиро-кун!
Dialogue: 0,0:13:56.21,0:13:57.12,Default,,0,0,0,,Үшінші буын!
Dialogue: 0,0:13:58.25,0:14:00.88,Default,,0,0,0,,(Миотачидің айқайы)
Dialogue: 0,0:14:00.96,0:14:02.38,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:14:02.46,0:14:04.38,Default,,0,0,0,,(Үш қорқынышты дауыс)
Dialogue: 0,0:14:04.46,0:14:05.30,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:05.80,0:14:07.72,Default,,0,0,0,,(Екі адам жылайды)
Dialogue: 0,0:14:09.55,0:14:11.72,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:14:14.43,0:14:15.22,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:16.18,0:14:19.10,Default,,0,0,0,,Косей шынымен бұған қол жеткізе ала ма екен?
Dialogue: 0,0:14:19.85,0:14:21.81,Default,,0,0,0,,Мен талап етемін және сотқа беремін.
Dialogue: 0,0:14:24.69,0:14:25.53,Default,,0,0,0,,О
Dialogue: 0,0:14:27.61,0:14:30.53,Default,,0,0,0,,Сиқырлы күш Найзағай ~!
Dialogue: 0,0:14:31.70,0:14:33.12,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:35.41,0:14:36.50,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:40.58,0:14:43.00,Default,,0,0,0,,Уау
Dialogue: 0,0:14:44.50,0:14:45.00,Default,,0,0,0,,Уау
Dialogue: 0,0:14:47.21,0:14:47.97,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:14:48.05,0:14:49.84,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:14:51.30,0:14:52.43,Default,,0,0,0,,Үшінші буын!
Dialogue: 0,0:14:53.22,0:14:55.76,Default,,0,0,0,,бұл... na... se...
Dialogue: 0,0:14:56.27,0:14:59.81,Default,,0,0,0,,Сиқырлы қуат абсолютті нөл~!
Dialogue: 0,0:15:00.64,0:15:02.56,Default,,0,0,0,,Уау... Әй... Эй, күте тұр...
Dialogue: 0,0:15:03.90,0:15:05.82,Default,,0,0,0,,Сабырлы бол, III.
Dialogue: 0,0:15:07.40,0:15:08.86,Default,,0,0,0,,Сиқырлы күш…
Dialogue: 0,0:15:09.74,0:15:11.66,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:15:12.24,0:15:13.28,Default,,0,0,0,,Найзағай...
Dialogue: 0,0:15:14.33,0:15:15.87,Default,,0,0,0,,Электр тогының соғуы!
Dialogue: 0,0:15:15.95,0:15:17.58,Default,,0,0,0,,Уау! Арх...
Dialogue: 0,0:15:18.87,0:15:24.34,Default,,0,0,0,,(Эригордың ыңырсыуы)
Dialogue: 0,0:15:26.59,0:15:29.38,Default,,0,0,0,,бірақ қанға бөккен қол дәл алдына ұсынылғанда да,
Dialogue: 0,0:15:29.47,0:15:31.51,Default,,0,0,0,,Икея, мықты бол.
Dialogue: 0,0:15:31.59,0:15:32.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:32.59,0:15:34.14,Default,,0,0,0,,Бамбук аюы?
Dialogue: 0,0:15:34.64,0:15:36.01,Default,,0,0,0,,Икея
Dialogue: 0,0:15:36.10,0:15:38.72,Default,,0,0,0,,Бұл әкенің құдіреті...
Dialogue: 0,0:15:38.81,0:15:39.93,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:15:40.02,0:15:42.27,Default,,0,0,0,,Бұл қорқынышты, әке.
Dialogue: 0,0:15:43.60,0:15:47.78,Default,,0,0,0,,Менің ұлым болса да, бар күшіңмен маған шабуыл жаса.
Dialogue: 0,0:15:47.86,0:15:50.65,Default,,0,0,0,,Мен сенің оны жеңе алатыныңды білдім.
Dialogue: 0,0:15:51.15,0:15:53.36,Default,,0,0,0,,Мен оны жеңе алмаймын.
Dialogue: 0,0:15:53.86,0:15:57.12,Default,,0,0,0,,Ол бұл экранға көптен бері қарап жүр.
Dialogue: 0,0:15:57.62,0:15:58.62,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:15:59.12,0:16:01.96,Default,,0,0,0,,Галакси Ардендегі София!
Dialogue: 0,0:16:02.04,0:16:03.04,Default,,0,0,0,,Гя... Галактика?
Dialogue: 0,0:16:03.75,0:16:07.04,Default,,0,0,0,,Бұл бүкіл әлем бойынша 100 миллион жүктеп алынатын әлеуметтік ойын.
Dialogue: 0,0:16:07.63,0:16:08.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:08.71,0:16:11.55,Default,,0,0,0,,София - бұл ойында өте сирек кездесетін кейіпкер.
Dialogue: 0,0:16:11.63,0:16:14.76,Default,,0,0,0,,Гачаны қанша айналдырсам да шықпайды.
Dialogue: 0,0:16:16.68,0:16:19.10,Default,,0,0,0,,Икетани О, сен...
Dialogue: 0,0:16:19.18,0:16:21.81,Default,,0,0,0,,Сіз бұл уәдені ұмыттыңыз ба?
Dialogue: 0,0:16:21.89,0:16:22.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:22.64,0:16:24.10,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:24.19,0:16:27.56,Default,,0,0,0,,Мен саған Софияны беруім керек...
Dialogue: 0,0:16:27.65,0:16:29.02,Default,,0,0,0,,Икетани…
Dialogue: 0,0:16:29.78,0:16:32.49,Default,,0,0,0,,Бір-біріміздің сүйікті кейіпкерлерімізді салсақ
Dialogue: 0,0:16:32.57,0:16:34.95,Default,,0,0,0,,Біз ымыраға келеміз деп баяғыда уәде берген едік.
Dialogue: 0,0:16:35.03,0:16:37.95,Default,,0,0,0,,Мен сенің Софияңды қалаймын... Мен...
Dialogue: 0,0:16:43.04,0:16:44.96,Default,,0,0,0,,Ikeya (Ikeya) Иә?
Dialogue: 0,0:16:45.04,0:16:48.00,Default,,0,0,0,,Мен сізге сүйікті «Лулуны» бергенше
Dialogue: 0,0:16:48.09,0:16:49.46,Default,,0,0,0,,София сенікі
Dialogue: 0,0:16:49.55,0:16:50.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:50.67,0:16:53.63,Default,,0,0,0,,Такекума~!
Dialogue: 0,0:16:53.72,0:16:55.43,Default,,0,0,0,,Жұмбақ қалады
Dialogue: 0,0:16:55.93,0:16:59.47,Default,,0,0,0,,Шайтанды тартатын қайшылық қай жерде?
Dialogue: 0,0:16:59.56,0:17:02.10,Default,,0,0,0,,Ичиро-кун, түсінбейсің бе?
Dialogue: 0,0:17:02.18,0:17:02.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:02.81,0:17:05.94,Default,,0,0,0,,Сіз ұтқан өте сирек
Dialogue: 0,0:17:06.02,0:17:09.19,Default,,0,0,0,,Бұл уәде болса да, мен оны босатуым керек.
Dialogue: 0,0:17:09.27,0:17:11.73,Default,,0,0,0,,Бұл қаншалықты қақтығыс?
Dialogue: 0,0:17:12.82,0:17:15.70,Default,,0,0,0,,Мұны ойын жасайтындар да біледі.
Dialogue: 0,0:17:16.20,0:17:17.36,Default,,0,0,0,,Білсең де
Dialogue: 0,0:17:17.45,0:17:21.24,Default,,0,0,0,,Жүрегіңді шайтанға айналдырып, сиректі көтеру керек.
Dialogue: 0,0:17:21.95,0:17:24.83,Default,,0,0,0,,Жүрек – жанжал орны
Dialogue: 0,0:17:25.33,0:17:26.79,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:17:27.29,0:17:28.25,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:17:28.33,0:17:30.63,Default,,0,0,0,,Такекума~! (3 адам) Иә?
Dialogue: 0,0:17:30.71,0:17:33.13,Default,,0,0,0,,Ikeya~!
Dialogue: 0,0:17:33.21,0:17:34.67,Default,,0,0,0,,Біз доспыз~!
Dialogue: 0,0:17:34.76,0:17:36.18,Default,,0,0,0,,Ағай (Мефисто II) Иә?
Dialogue: 0,0:17:36.26,0:17:37.93,Default,,0,0,0,,Керемет болды!
Dialogue: 0,0:17:38.01,0:17:39.22,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:17:39.30,0:17:40.47,Default,,0,0,0,,Мен міндетті түрде шайтанға айналамын!
Dialogue: 0,0:17:41.18,0:17:41.89,Default,,0,0,0,,А... білесің бе.
Dialogue: 0,0:17:41.97,0:17:43.97,Default,,0,0,0,,Бұл форс-мажор...
Dialogue: 0,0:17:44.06,0:17:45.73,Default,,0,0,0,,Ұлым үшін...
Dialogue: 0,0:17:45.81,0:17:47.73,Default,,0,0,0,,Сөзсіз шайтанға айнал!
Dialogue: 0,0:17:49.06,0:17:50.19,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:50.69,0:17:52.44,Default,,0,0,0,,Махиро-кун, мені тыңда.
Dialogue: 0,0:17:52.94,0:17:56.24,Default,,0,0,0,,Сіз шайтан болсаңыз да, бұл сіздің қолыңыздан ештеңе келеді дегенді білдірмейді.
Dialogue: 0,0:17:56.82,0:17:59.32,Default,,0,0,0,,Жындар адамдармен келісім-шарт жасайды
Dialogue: 0,0:17:59.41,0:18:03.24,Default,,0,0,0,,Адамның қалауына тартылып, сол адаммен әуестену.
Dialogue: 0,0:18:04.16,0:18:05.25,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:18:05.33,0:18:07.33,Default,,0,0,0,,Әлгі шіркін шайтан
Dialogue: 0,0:18:08.08,0:18:10.50,Default,,0,0,0,,Сенің де сондай болғың келе ме?
Dialogue: 0,0:18:11.00,0:18:12.17,Default,,0,0,0,,Бірақ қарт...
Dialogue: 0,0:18:12.25,0:18:14.25,Default,,0,0,0,,Жоқ, менің де келісімшартым бар.
Dialogue: 0,0:18:14.34,0:18:15.76,Default,,0,0,0,,Экчанмен
Dialogue: 0,0:18:16.26,0:18:19.01,Default,,0,0,0,,«Неке» шарты
Dialogue: 0,0:18:19.09,0:18:22.51,Default,,0,0,0,,Зугюн керемет!
Dialogue: 0,0:18:23.31,0:18:26.02,Default,,0,0,0,,Сен сол қалпыңда қаласың, бұдан былай ересек адам боласың.
Dialogue: 0,0:18:26.52,0:18:28.35,Default,,0,0,0,,Тек жаман адамдарды жеңіңіз
Dialogue: 0,0:18:28.44,0:18:29.52,Default,,0,0,0,,Бар... (Мефисто III) Әй, не?
Dialogue: 0,0:18:29.60,0:18:33.52,Default,,0,0,0,,Мен есейгенше шыдамаймын!
Dialogue: 0,0:18:33.61,0:18:34.57,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:18:34.65,0:18:37.11,Default,,0,0,0,,Не... жаман айттым ба?
Dialogue: 0,0:18:37.19,0:18:39.24,Default,,0,0,0,,Мен мұны күте алмаймын.
Dialogue: 0,0:18:39.32,0:18:42.41,Default,,0,0,0,,«Жаман балаларды» жеңудің орнына
Dialogue: 0,0:18:42.49,0:18:44.28,Default,,0,0,0,,Сіз «жаман жігіт» дедіңіз
Dialogue: 0,0:18:44.87,0:18:46.79,Default,,0,0,0,,Әсіресе біреу бар ма?
Dialogue: 0,0:18:46.87,0:18:48.71,Default,,0,0,0,,(Рэй) Уф… (Эмма) Ех!
Dialogue: 0,0:18:49.62,0:18:51.79,Default,,0,0,0,,Махиро-кун, кешіріңіз.
Dialogue: 0,0:18:51.88,0:18:54.50,Default,,0,0,0,,Тоқта, жібер! Мен жібере алсам ғой!
Dialogue: 0,0:18:54.59,0:18:55.42,Default,,0,0,0,,Жібер...
Dialogue: 0,0:18:55.92,0:18:57.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:03.05,0:19:05.85,Default,,0,0,0,,Досыңа берген уәдеңде тұрасың ба, жоқ па, соған байланысты.
Dialogue: 0,0:19:05.93,0:19:07.39,Default,,0,0,0,,Шайтанды шақыру
Dialogue: 0,0:19:08.85,0:19:11.77,Default,,0,0,0,,Анасын қорғау үшін шайтан болуға тырысу
Dialogue: 0,0:19:12.35,0:19:15.27,Default,,0,0,0,,Жындарды тек адамдар итереді.
Dialogue: 0,0:19:15.36,0:19:17.03,Default,,0,0,0,,Сіз тамақ ішпейсіз бе?
Dialogue: 0,0:19:17.11,0:19:19.78,Default,,0,0,0,,Махиро-кун, не болады?
Dialogue: 0,0:19:19.86,0:19:21.66,Default,,0,0,0,,Не болады екен деп ойлаймын.
Dialogue: 0,0:19:21.74,0:19:24.24,Default,,0,0,0,,Балаларға бағдар беру орталығы жауап береді
Dialogue: 0,0:19:24.74,0:19:28.91,Default,,0,0,0,,Сенің шешеңнің күйеуі тұрмыстық зорлық-зомбылық жасаған жігіт болған.
Dialogue: 0,0:19:29.00,0:19:31.58,Default,,0,0,0,,Оны сонша қорлады.
Dialogue: 0,0:19:31.67,0:19:32.42,Default,,0,0,0,,Анасы да кінәлі...
Dialogue: 0,0:19:32.50,0:19:33.42,Default,,0,0,0,,(үстелді түрту дыбысы)
Dialogue: 0,0:19:34.00,0:19:38.42,Default,,0,0,0,,Сенің анаң Махироны қорғап жүріп соққыға жығылмады ма?
Dialogue: 0,0:19:38.51,0:19:39.63,Default,,0,0,0,,Бірдей қылмыс емес
Dialogue: 0,0:19:39.72,0:19:41.63,Default,,0,0,0,,Әйтпесе, Махиро-кун
Dialogue: 0,0:19:41.72,0:19:44.93,Default,,0,0,0,,Жамандарды жеңемін деп айтпас едің.
Dialogue: 0,0:19:45.01,0:19:48.68,Default,,0,0,0,,Сонда анаң онымен неге ажыраспады?
Dialogue: 0,0:19:48.77,0:19:50.27,Default,,0,0,0,,Е... е...
Dialogue: 0,0:19:50.35,0:19:51.94,Default,,0,0,0,,Бұл көптеген жұмбақтары бар жағдай.
Dialogue: 0,0:19:52.02,0:19:55.48,Default,,0,0,0,,Мен және менің балаларым зорлық-зомбылыққа тап болса да
Dialogue: 0,0:19:55.56,0:19:57.69,Default,,0,0,0,,Кейбір аналар еркекке жабысады.
Dialogue: 0,0:19:58.28,0:20:01.70,Default,,0,0,0,,Сонда да кейбір балалар анасын қорғағысы келеді.
Dialogue: 0,0:20:02.45,0:20:06.45,Default,,0,0,0,,Адамдарға сене алмасаң, жындарға сенуден басқа амалың жоқ.
Dialogue: 0,0:20:08.79,0:20:12.16,Default,,0,0,0,,Ол балаға керегі шайтан емес.
Dialogue: 0,0:20:12.25,0:20:14.83,Default,,0,0,0,,Ол қорғаншы әке болды.
Dialogue: 0,0:20:18.80,0:20:20.96,Default,,0,0,0,,Әкем маған пісіріп берді.
Dialogue: 0,0:20:21.05,0:20:22.80,Default,,0,0,0,,Олар өте ұқсас.
Dialogue: 0,0:20:23.80,0:20:26.30,Default,,0,0,0,,Айтайын дегенім, ойланбастан жейсің бе?
Dialogue: 0,0:20:26.80,0:20:28.35,Default,,0,0,0,,Сонда бұл
Dialogue: 0,0:20:29.43,0:20:31.56,Default,,0,0,0,,Аздап ризашылықпен тамақтаныңыз!
Dialogue: 0,0:20:31.64,0:20:34.73,Default,,0,0,0,,Иә, дәмі жақсы.
Dialogue: 0,0:20:46.37,0:20:48.74,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:20:49.37,0:20:54.25,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:03.67,0:21:05.55,Default,,0,0,0,,Сана…
Dialogue: 0,0:21:08.97,0:21:10.97,Default,,0,0,0,,♪～
Dialogue: 0,0:21:25.28,0:21:28.07,Default,,0,0,0,,Мефисто II де мұны істеу уақыты келгенде жасайды.
Dialogue: 0,0:21:28.16,0:21:30.24,Default,,0,0,0,,Ол кезде де салқын еді.
Dialogue: 0,0:21:30.33,0:21:32.04,Default,,0,0,0,,Олай болса, ренжіту оңай.
Dialogue: 0,0:21:32.12,0:21:33.75,Default,,0,0,0,,Бұл допқа сызат болды.
Dialogue: 0,0:21:33.83,0:21:36.54,Default,,0,0,0,,Сондай-ақ, сенгіш құбыжықтар
Dialogue: 0,0:21:36.62,0:21:39.38,Default,,0,0,0,,Мені алдаған жарғанат мысық болды.
Dialogue: 0,0:21:39.46,0:21:42.34,Default,,0,0,0,,Бұл менің ерекше сиқырлы күшім.
Dialogue: 0,0:21:42.42,0:21:44.80,Default,,0,0,0,,Жоқ, шынымен де алдау оңай болды.
Dialogue: 0,0:21:44.88,0:21:47.51,Default,,0,0,0,,Сіз он екі елшінің бірі болдыңыз.
Dialogue: 0,0:21:47.59,0:21:48.14,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:48.22,0:21:51.76,Default,,0,0,0,,Ендеше, ерекше қозғалыс атауын ойлап көрейік.
Dialogue: 0,0:21:51.85,0:21:53.06,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:21:53.14,0:21:54.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:54.43,0:21:57.23,Default,,0,0,0,,Сиқырлы күш соқырлық! Дэймон
Dialogue: 0,0:21:57.31,0:21:59.40,Default,,0,0,0,,Бұл Момо-санның мамандығы.
Dialogue: 0,0:21:59.48,0:22:00.69,Default,,0,0,0,,Мен де.
Dialogue: 0,0:22:00.77,0:22:03.03,Default,,0,0,0,,Сиқырлы мысық айласы
Dialogue: 0,0:22:03.11,0:22:05.07,Default,,0,0,0,,Өйткені, бұл алдау.
Dialogue: 0,0:22:05.15,0:22:07.86,Default,,0,0,0,,Сондықтан мен оны жақсы меңгердім
Dialogue: 0,0:22:07.95,0:22:10.62,Default,,0,0,0,,Көз алмасының сиқырлы гипнозы!
Dialogue: 0,0:22:10.70,0:22:12.74,Default,,0,0,0,,Бұл қандай техника болды?
Dialogue: 0,0:22:12.83,0:22:14.41,Default,,0,0,0,,Мен туралы барлығына айтыңыз
Dialogue: 0,0:22:14.49,0:22:17.29,Default,,0,0,0,,Бұл сізді қорқынышты жын емес деп санайтын әдіс.
Dialogue: 0,0:22:17.37,0:22:19.29,Default,,0,0,0,,Сен де алдап жүрсің ғой?
Dialogue: 0,0:22:19.37,0:22:21.04,Default,,0,0,0,,Алдамаңыз!
Dialogue: 0,0:22:21.13,0:22:23.09,Default,,0,0,0,,Бұл гипноз.
Dialogue: 0,0:22:23.17,0:22:24.34,Default,,0,0,0,,Жарайды, мен де.
Dialogue: 0,0:22:24.42,0:22:26.59,Default,,0,0,0,,Сиқырлы күш Кейінірек тас-қағаз-қайшы
Dialogue: 0,0:22:26.67,0:22:28.72,Default,,0,0,0,,Сиқырлы күш Артынан тосын шабуыл
Dialogue: 0,0:22:28.80,0:22:30.64,Default,,0,0,0,,Сиқырлы Үлкен өтірікші
Dialogue: 0,0:22:30.72,0:22:33.35,Default,,0,0,0,,Жарқанаттар мен мысықтар туралы бәрі жаман.
Dialogue: 0,0:22:33.43,0:22:34.51,Default,,0,0,0,,Не!
Dialogue: 0,0:22:34.60,0:22:35.52,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:22:35.60,0:22:37.60,Default,,0,0,0,,Сиқырлы Ұлы ұры
Dialogue: 0,0:22:37.68,0:22:39.77,Default,,0,0,0,,Иә, бұл өте жаман!
Dialogue: 0,0:22:39.85,0:22:40.90,Default,,0,0,0,,Дұрыс па?
