Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.23,0:00:25.23,Default,,0,0,0,,Сәлем
Dialogue: 0,0:00:25.98,0:00:27.94,Default,,0,0,0,,Сүлейменнің сыбызғысынан аулақ бол
Dialogue: 0,0:00:28.02,0:00:29.15,Default,,0,0,0,,Строфир
Dialogue: 0,0:00:30.03,0:00:32.65,Default,,0,0,0,,Мен Сүлейменнің сыбызғысына ештеңе істемеймін.
Dialogue: 0,0:00:32.74,0:00:34.24,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:00:34.32,0:00:35.16,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:00:36.24,0:00:39.33,Default,,0,0,0,,(Строфирдің күлкісі)
Dialogue: 0,0:00:41.75,0:00:42.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:44.83,0:00:46.88,Default,,0,0,0,,Куку куку
Dialogue: 0,0:00:48.50,0:00:52.67,Default,,0,0,0,,♪ Жындар әлемінің Харукасы
Dialogue: 0,0:00:52.76,0:00:57.18,Default,,0,0,0,,♪ Биік аспан~
Dialogue: 0,0:00:57.68,0:00:58.22,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:58.72,0:01:00.68,Default,,0,0,0,,Ммм, жақсы сезім
Dialogue: 0,0:01:00.76,0:01:01.89,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:01:01.97,0:01:02.56,Default,,0,0,0,,О!
Dialogue: 0,0:01:02.64,0:01:05.19,Default,,0,0,0,,Экчан, сен жұмысыңды бітірдің бе?
Dialogue: 0,0:01:07.90,0:01:09.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:09.19,0:01:11.19,Default,,0,0,0,,♪～
Dialogue: 0,0:01:23.20,0:01:25.21,Default,,0,0,0,,～♪
Dialogue: 0,0:01:25.29,0:01:26.71,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:28.29,0:01:29.75,Default,,0,0,0,,Алдымен Гу
Dialogue: 0,0:01:29.83,0:01:31.21,Default,,0,0,0,,(Исуми Миямура) Иә (Ишикава) Маған беріп тұрсың ба?
Dialogue: 0,0:01:32.00,0:01:34.80,Default,,0,0,0,,Куу... Мен тағы жеңілдім.
Dialogue: 0,0:01:34.88,0:01:37.72,Default,,0,0,0,,Бүгін жартылай қуырылған күрішпен бірге келетін жиынтық алайық.
Dialogue: 0,0:01:37.80,0:01:39.01,Default,,0,0,0,,Аа, уже... уф...
Dialogue: 0,0:01:39.09,0:01:40.43,Default,,0,0,0,,бірақ қанға бөккен қол дәл алдына ұсынылғанда да,
Dialogue: 0,0:01:40.51,0:01:41.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:41.30,0:01:43.47,Default,,0,0,0,,Екеуміз де!
Dialogue: 0,0:01:44.06,0:01:44.93,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:01:45.02,0:01:47.23,Default,,0,0,0,,А, бүгін карри?
Dialogue: 0,0:01:47.31,0:01:48.73,Default,,0,0,0,,Сабырлы болсаңыз
Dialogue: 0,0:01:48.81,0:01:50.06,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:01:50.15,0:01:53.02,Default,,0,0,0,,Екі күн қатарынан кешкі ас сатып алу керек...
Dialogue: 0,0:01:53.11,0:01:53.98,Default,,0,0,0,,Гиозаны да қосыңыз
Dialogue: 0,0:01:54.07,0:01:55.49,Default,,0,0,0,,Ібіліс-күн! (Мефисто III) Иә?
Dialogue: 0,0:01:55.57,0:01:57.49,Default,,0,0,0,,А... солай емес пе, Шинго-кун?
Dialogue: 0,0:01:57.57,0:01:59.49,Default,,0,0,0,,Әрбір «көрінбейтін мектеп»
Dialogue: 0,0:01:59.57,0:02:01.07,Default,,0,0,0,,Ол мөрленген!
Dialogue: 0,0:02:07.37,0:02:09.87,Default,,0,0,0,,Бұл соңғы хабарлама.
Dialogue: 0,0:02:09.96,0:02:13.04,Default,,0,0,0,,«Періште» Строфия дегенді білдірмейді ме?
Dialogue: 0,0:02:13.13,0:02:13.96,Default,,0,0,0,,Мен осындамын, мама
Dialogue: 0,0:02:14.05,0:02:15.71,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:15.80,0:02:18.05,Default,,0,0,0,,Әкеңе үлкен мәселе болса да.
Dialogue: 0,0:02:18.13,0:02:20.43,Default,,0,0,0,,«Мыңжылдықты» құру
Dialogue: 0,0:02:20.51,0:02:22.55,Default,,0,0,0,,Мұны миссия деп айтудың қажеті жоқ
Dialogue: 0,0:02:24.64,0:02:25.77,Default,,0,0,0,,Сергіту
Dialogue: 0,0:02:25.85,0:02:27.56,Default,,0,0,0,,Шехер астрономиялық кітапханасының басқарма бастығы, «Юстиция» обсерваториясында
Dialogue: 0,0:02:30.90,0:02:34.07,Default,,0,0,0,,Көмек алғыңыз келсе, Он екі елшіден сұраңыз
Dialogue: 0,0:02:34.15,0:02:36.65,Default,,0,0,0,,Жетеді, мен оны сағындым.
Dialogue: 0,0:02:36.73,0:02:37.74,Default,,0,0,0,,Кеттік, әке.
Dialogue: 0,0:02:38.24,0:02:40.45,Default,,0,0,0,,Бұл шынымен жақсы ма? Ичиро-кун
Dialogue: 0,0:02:40.53,0:02:42.07,Default,,0,0,0,,Мені жалғыз қалдырыңыз!
Dialogue: 0,0:02:42.57,0:02:43.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:44.91,0:02:46.54,Default,,0,0,0,,Таку қазірдің өзінде!
Dialogue: 0,0:02:47.12,0:02:48.29,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:02:48.37,0:02:50.08,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:02:50.17,0:02:52.71,Default,,0,0,0,,Менің сенімен жұмысым бітті.
Dialogue: 0,0:02:52.79,0:02:55.75,Default,,0,0,0,,Косей шынымен бұған қол жеткізе ала ма екен?
Dialogue: 0,0:02:55.84,0:02:57.67,Default,,0,0,0,,Мен талап етемін және сотқа беремін.
Dialogue: 0,0:02:58.17,0:03:01.47,Default,,0,0,0,,Мен сізге Потестат Диаболиді беремін
Dialogue: 0,0:03:06.68,0:03:08.81,Default,,0,0,0,,Сиқырлық күшің болмаса, қиналып қаласың.
Dialogue: 0,0:03:08.89,0:03:10.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:11.02,0:03:12.31,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:03:12.40,0:03:14.52,Default,,0,0,0,,Әдептілік сияқты жақсы емес
Dialogue: 0,0:03:14.61,0:03:15.82,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:03:29.29,0:03:31.96,Default,,0,0,0,,Строфирдің күші күшейе түсуде.
Dialogue: 0,0:03:39.92,0:03:41.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:41.67,0:03:43.43,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:03:44.18,0:03:47.06,Default,,0,0,0,,Бұл строфирлік тосқауыл болуы мүмкін.
Dialogue: 0,0:03:47.14,0:03:48.06,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:03:48.14,0:03:48.93,Default,,0,0,0,,Иә
Dialogue: 0,0:03:53.19,0:03:53.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:53.77,0:03:54.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:54.81,0:03:55.65,Default,,0,0,0,,Кірмеңіз
Dialogue: 0,0:03:56.15,0:03:58.36,Default,,0,0,0,,Сиқырлы күшімізді біріктіріп, бірге шабуыл жасайық.
Dialogue: 0,0:03:58.44,0:03:59.36,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:03:59.44,0:04:01.95,Default,,0,0,0,,Сиқырлы күш Найзағай!
Dialogue: 0,0:04:09.37,0:04:11.12,Default,,0,0,0,,Бұл да пайдасыз
Dialogue: 0,0:04:15.00,0:04:19.17,Default,,0,0,0,,Строфирдің күшін бір жерде жабудың жолы болуы керек.
Dialogue: 0,0:04:19.25,0:04:21.13,Default,,0,0,0,,Тез арада таппасақ...
Dialogue: 0,0:04:21.76,0:04:24.05,Default,,0,0,0,,Сиқырлы жалын сәулесі!
Dialogue: 0,0:04:24.13,0:04:25.80,Default,,0,0,0,,Пулеметпен соққы!
Dialogue: 0,0:04:25.89,0:04:27.39,Default,,0,0,0,,Абсолюттік нөл!
Dialogue: 0,0:04:27.89,0:04:30.47,Default,,0,0,0,,Сиқырлы қалпақ арасы!
Dialogue: 0,0:04:32.48,0:04:33.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:34.98,0:04:36.98,Default,,0,0,0,,Әке, бұл мүлдем жұмыс істемейді.
Dialogue: 0,0:04:37.06,0:04:38.90,Default,,0,0,0,,Берілме, 3-ші ұрпақ!
Dialogue: 0,0:04:42.99,0:04:45.20,Default,,0,0,0,,Бұл кітапта да анықтамалар жоқ.
Dialogue: 0,0:04:47.99,0:04:49.70,Default,,0,0,0,,Берілмеңіз
Dialogue: 0,0:04:50.99,0:04:52.00,Default,,0,0,0,,Менің жауапкершілігім бар
Dialogue: 0,0:04:55.79,0:04:58.42,Default,,0,0,0,,Мүмкін мен қауіпті жерге келген шығармын.
Dialogue: 0,0:04:59.00,0:05:00.34,Default,,0,0,0,,Сіз әлі барасыз ба?
Dialogue: 0,0:05:00.42,0:05:02.30,Default,,0,0,0,,Өтінемін, Мефисто II
Dialogue: 0,0:05:02.38,0:05:05.97,Default,,0,0,0,,Таро карталарына сәйкес, бұл жерде екені анық.
Dialogue: 0,0:05:06.47,0:05:08.14,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:05:08.64,0:05:10.76,Default,,0,0,0,,Бармайынша білмейсің...
Dialogue: 0,0:05:11.26,0:05:12.14,Default,,0,0,0,,Төмен түсейік
Dialogue: 0,0:05:12.22,0:05:13.06,Default,,0,0,0,,О
Dialogue: 0,0:05:35.37,0:05:37.21,Default,,0,0,0,,Жүр, кел, Әэшма.
Dialogue: 0,0:05:39.13,0:05:42.80,Default,,0,0,0,,Граф та мұнда емін-еркін ойнай алатыныңды айтты, солай ма?
Dialogue: 0,0:05:44.42,0:05:45.30,Default,,0,0,0,,Иә
Dialogue: 0,0:05:45.38,0:05:50.30,Default,,0,0,0,,(Орақтың сүйреу дыбысы)
Dialogue: 0,0:05:51.93,0:05:53.35,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:05:53.85,0:05:54.68,Default,,0,0,0,,Иә
Dialogue: 0,0:05:58.27,0:05:59.56,Default,,0,0,0,,Сен оны білесің бе?
Dialogue: 0,0:05:59.65,0:06:01.52,Default,,0,0,0,,Бұл дүние жарықты жарып жіберді.
Dialogue: 0,0:06:01.61,0:06:04.44,Default,,0,0,0,,Бұл сізді жабық ұстауға арналған жүйе.
Dialogue: 0,0:06:06.24,0:06:08.28,Default,,0,0,0,,Нәтижелері жақсы емес.
Dialogue: 0,0:06:09.16,0:06:10.66,Default,,0,0,0,,Қамау…
Dialogue: 0,0:06:10.74,0:06:13.83,Default,,0,0,0,,Иә, материя – түрме.
Dialogue: 0,0:06:15.08,0:06:19.71,Default,,0,0,0,,Жарық жанға айналады да, адам денесінде ұсталады.
Dialogue: 0,0:06:21.29,0:06:24.38,Default,,0,0,0,,Бостандыққа шығатын күнді армандау...
Dialogue: 0,0:06:25.67,0:06:27.76,Default,,0,0,0,,Ендеше мен сені босатуға рұқсат етемін.
Dialogue: 0,0:06:28.26,0:06:30.84,Default,,0,0,0,,Эшма, сенің қолыңнан келеді.
Dialogue: 0,0:06:31.76,0:06:32.85,Default,,0,0,0,,Шығарылым…
Dialogue: 0,0:06:33.55,0:06:34.64,Default,,0,0,0,,I
Dialogue: 0,0:06:35.81,0:06:36.97,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:06:37.06,0:06:39.64,Default,,0,0,0,,Дене жоғалған кезде жарық шығады.
Dialogue: 0,0:06:40.14,0:06:42.31,Default,,0,0,0,,Жарықтың үміті осы.
Dialogue: 0,0:06:42.81,0:06:44.57,Default,,0,0,0,,Бұл рахат, солай емес пе?
Dialogue: 0,0:06:45.53,0:06:46.57,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:47.40,0:06:49.78,Default,,0,0,0,,Мені қолдарыңызбен босатыңыз
Dialogue: 0,0:06:55.16,0:06:56.54,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:57.04,0:06:59.25,Default,,0,0,0,,Мен сені қазір босатамын.
Dialogue: 0,0:07:00.67,0:07:02.08,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:06.42,0:07:07.67,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:08.17,0:07:09.63,Default,,0,0,0,,(жаншылған дыбыс)
Dialogue: 0,0:07:10.55,0:07:11.05,Default,,0,0,0,,Кім?
Dialogue: 0,0:07:13.85,0:07:16.35,Default,,0,0,0,,Мен баланы қолыма беремін.
Dialogue: 0,0:07:17.85,0:07:19.60,Default,,0,0,0,,Әке шын мәнінде дәрігер емес
Dialogue: 0,0:07:21.14,0:07:24.98,Default,,0,0,0,,Неліктен мен мұны істеуім керек?
Dialogue: 0,0:07:25.65,0:07:27.98,Default,,0,0,0,,Сіз Strofireсіз бе?
Dialogue: 0,0:07:28.07,0:07:29.53,Default,,0,0,0,,Строфир…
Dialogue: 0,0:07:29.61,0:07:31.07,Default,,0,0,0,,Сақ бол, шайтан!
Dialogue: 0,0:07:31.15,0:07:34.70,Default,,0,0,0,,Мм, түсіндім. Сіз шайтансыз ба?
Dialogue: 0,0:07:37.41,0:07:39.16,Default,,0,0,0,,Ха... Сүлейменнің сыбызғы!
Dialogue: 0,0:07:39.66,0:07:43.21,Default,,0,0,0,,Strofire Баланы тыныштандырыңыз!
Dialogue: 0,0:07:44.50,0:07:45.79,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:45.88,0:07:46.92,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:07:47.96,0:07:49.38,Default,,0,0,0,,Уау! (Мефисто II)...
Dialogue: 0,0:07:49.46,0:07:49.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:50.47,0:07:51.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:57.72,0:07:58.72,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:07:59.22,0:08:00.14,Default,,0,0,0,,Сүлейменнің сыбызғы...
Dialogue: 0,0:08:00.22,0:08:02.10,Default,,0,0,0,,Амансың ба? Шайтан-күн
Dialogue: 0,0:08:03.69,0:08:07.11,Default,,0,0,0,,Материяға түскен жарықтың үзіндісі болса да
Dialogue: 0,0:08:07.19,0:08:09.11,Default,,0,0,0,,Сіз не істеп жатқаныңызды білмейсіз!
Dialogue: 0,0:08:09.19,0:08:10.78,Default,,0,0,0,,Шатаспаңыз!
Dialogue: 0,0:08:10.86,0:08:13.61,Default,,0,0,0,,Материя мен жарық, бақыт пен қайғы
Dialogue: 0,0:08:13.70,0:08:15.74,Default,,0,0,0,,Олардың барлығы нағыз біз.
Dialogue: 0,0:08:16.24,0:08:18.24,Default,,0,0,0,,Түсінбейтін сенсің!
Dialogue: 0,0:08:18.74,0:08:21.58,Default,,0,0,0,,Маған кедергі жасама деп айтып тұрмын!
Dialogue: 0,0:08:22.08,0:08:24.00,Default,,0,0,0,,Сиқырлы күш Найзағай!
Dialogue: 0,0:08:27.46,0:08:28.84,Default,,0,0,0,,Элоим Эссаим
Dialogue: 0,0:08:28.92,0:08:29.88,Default,,0,0,0,,Элоим Эссаим
Dialogue: 0,0:08:29.96,0:08:32.47,Default,,0,0,0,,Мен талап етемін және сотқа беремін.
Dialogue: 0,0:08:32.55,0:08:34.26,Default,,0,0,0,,Ібілістің қалқаны!
Dialogue: 0,0:08:36.22,0:08:39.01,Default,,0,0,0,,(Строфирдің күлкісі)
Dialogue: 0,0:08:39.10,0:08:39.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:40.47,0:08:44.06,Default,,0,0,0,,Өйткені, мен Строфирдің сиқырлы күшін жеңе алмаймын.
Dialogue: 0,0:08:44.56,0:08:45.60,Default,,0,0,0,,Ібіліс-кун
Dialogue: 0,0:08:46.10,0:08:48.77,Default,,0,0,0,,Сіз Аешма екеумізге араластыңыз.
Dialogue: 0,0:08:48.86,0:08:52.03,Default,,0,0,0,,Мен сенің жарық болып өмір сүруіңе де жол бермеймін.
Dialogue: 0,0:08:52.11,0:08:54.74,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:08:54.82,0:08:56.45,Default,,0,0,0,,Қаш, шайтан!
Dialogue: 0,0:08:56.53,0:08:58.03,Default,,0,0,0,,Маған ұнамайды! Мен берілмеймін!
Dialogue: 0,0:08:58.12,0:09:00.20,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:00.70,0:09:01.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:01.62,0:09:02.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:07.38,0:09:08.13,Default,,0,0,0,,А...
Dialogue: 0,0:09:08.21,0:09:09.04,Default,,0,0,0,,Аешма!
Dialogue: 0,0:09:10.59,0:09:11.42,Default,,0,0,0,,Не?
Dialogue: 0,0:09:11.50,0:09:12.55,Default,,0,0,0,,Бұл жарық...
Dialogue: 0,0:09:15.63,0:09:16.55,Default,,0,0,0,,Не?Бұл
Dialogue: 0,0:09:18.64,0:09:21.01,Default,,0,0,0,,Лақтыр, Аешма!
Dialogue: 0,0:09:21.51,0:09:23.18,Default,,0,0,0,,Strofire-ге қараңыз.
Dialogue: 0,0:09:23.27,0:09:24.48,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:09:26.02,0:09:27.69,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:28.69,0:09:31.19,Default,,0,0,0,,Аэшма Аешма...
Dialogue: 0,0:09:31.27,0:09:33.57,Default,,0,0,0,,Аэшма Аешма
Dialogue: 0,0:09:41.83,0:09:43.37,Default,,0,0,0,,Строфир…
Dialogue: 0,0:09:44.29,0:09:45.50,Default,,0,0,0,,Қайда?
Dialogue: 0,0:09:48.29,0:09:50.71,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:53.38,0:09:55.72,Default,,0,0,0,,Кел, менімен үйге кел.
Dialogue: 0,0:10:03.60,0:10:04.52,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:05.02,0:10:06.85,Default,,0,0,0,,Бұл кітапта да жоқ па?
Dialogue: 0,0:10:16.69,0:10:19.45,Default,,0,0,0,,Какао Сіз оны жеп көрдіңіз бе?
Dialogue: 0,0:10:28.41,0:10:29.54,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:10:29.62,0:10:30.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:30.29,0:10:31.58,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:33.29,0:10:36.71,Default,,0,0,0,,(кітап оқып отырған жас шайтанның дауысы)
Dialogue: 0,0:10:39.47,0:10:40.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:40.22,0:10:41.14,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:10:41.22,0:10:41.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:42.30,0:10:43.55,Default,,0,0,0,,Бұл құймақ
Dialogue: 0,0:10:44.06,0:10:45.47,Default,,0,0,0,,Ыстық па?
Dialogue: 0,0:10:45.56,0:10:46.68,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:50.39,0:10:51.98,Default,,0,0,0,,Ыстық па?
Dialogue: 0,0:10:56.57,0:10:57.99,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:58.07,0:10:58.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:00.99,0:11:01.82,Default,,0,0,0,,Уау
Dialogue: 0,0:11:01.91,0:11:03.32,Default,,0,0,0,,Оны жай қалдырыңыз...
Dialogue: 0,0:11:03.41,0:11:05.28,Default,,0,0,0,,Құймақ!
Dialogue: 0,0:11:08.33,0:11:09.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:09.37,0:11:10.50,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:11:10.58,0:11:12.75,Default,,0,0,0,,«Бұл дәмді» (жас шайтан)!
Dialogue: 0,0:11:14.21,0:11:15.09,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:11:16.05,0:11:16.92,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:11:22.76,0:11:25.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:25.97,0:11:27.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:28.68,0:11:30.69,Default,,0,0,0,,Өзін «Граф» деп атайтын шайтаннан
Dialogue: 0,0:11:30.77,0:11:32.94,Default,,0,0,0,,Сізді немен тамақтандырдыңыз?
Dialogue: 0,0:11:33.02,0:11:34.31,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:11:34.40,0:11:38.15,Default,,0,0,0,,Бұдан былай адам асын жеу керек.
Dialogue: 0,0:11:38.23,0:11:39.07,Default,,0,0,0,,(Кішкентай шайтанның кекіруі)
Dialogue: 0,0:11:39.57,0:11:42.11,Default,,0,0,0,,Көптеген дәмді тағамдар бар.
Dialogue: 0,0:11:42.61,0:11:48.24,Default,,0,0,0,,«Дәм физиологиясы немесе трансцендентальды гастрономия туралы медитация»
Dialogue: 0,0:11:48.33,0:11:51.71,Default,,0,0,0,,Саваринді де оқығаныңызға таң қалдым.
Dialogue: 0,0:11:51.79,0:11:53.46,Default,,0,0,0,,Бұл қызықсыз болды
Dialogue: 0,0:11:53.54,0:11:56.34,Default,,0,0,0,,Ең алдымен, «дәмді» дегеннің не екенін білу керек.
Dialogue: 0,0:11:56.42,0:11:57.67,Default,,0,0,0,,Бұл ғана емес
Dialogue: 0,0:11:57.75,0:12:00.92,Default,,0,0,0,,Бұдан былай адам туралы көбірек білейік.
Dialogue: 0,0:12:02.09,0:12:02.76,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:12:02.84,0:12:05.26,Default,,0,0,0,,Өйткені сен адамсың.
Dialogue: 0,0:12:06.89,0:12:10.27,Default,,0,0,0,,Адамдар адам туралы білуі керек пе?
Dialogue: 0,0:12:10.85,0:12:11.89,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:11.98,0:12:14.65,Default,,0,0,0,,Өзіңді де тану.
Dialogue: 0,0:12:17.90,0:12:20.48,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:21.15,0:12:22.40,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:24.28,0:12:25.91,Default,,0,0,0,,Әке
Dialogue: 0,0:12:25.99,0:12:26.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:27.53,0:12:28.91,Default,,0,0,0,,Фото?
Dialogue: 0,0:12:32.12,0:12:32.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:37.38,0:12:41.88,Default,,0,0,0,,Отыр, отыр, күл, күл~
Dialogue: 0,0:12:41.96,0:12:43.30,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:43.38,0:12:44.97,Default,,0,0,0,,Суретке түсіру
Dialogue: 0,0:12:45.47,0:12:47.26,Default,,0,0,0,,Олай болса өтінемін, Юуко.
Dialogue: 0,0:12:47.34,0:12:48.05,Default,,0,0,0,,Иә
Dialogue: 0,0:12:48.14,0:12:50.31,Default,,0,0,0,,Оны менің Юко-чаныма қалдырыңыз~
Dialogue: 0,0:12:50.39,0:12:52.39,Default,,0,0,0,,Неліктен фотосуреттер?
Dialogue: 0,0:12:52.48,0:12:55.19,Default,,0,0,0,,Жарайды, бұл отбасылық фотосурет.
Dialogue: 0,0:12:55.77,0:12:57.40,Default,,0,0,0,,Онда мен суретке түсемін.
Dialogue: 0,0:12:57.48,0:12:58.36,Default,,0,0,0,,Иә Сыр
Dialogue: 0,0:12:58.44,0:12:58.94,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:13:03.19,0:13:07.91,Default,,0,0,0,,Мыңжылдықты жүзеге асыруды мақсат ету керек.
Dialogue: 0,0:13:09.62,0:13:14.50,Default,,0,0,0,,(Балалардың жанды дауыстары)
Dialogue: 0,0:13:14.58,0:13:16.62,Default,,0,0,0,,Олай болса, келесі жолы...
Dialogue: 0,0:13:16.71,0:13:17.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:17.79,0:13:19.75,Default,,0,0,0,,Кеттік (2-қыз) Ух... иә
Dialogue: 0,0:13:19.84,0:13:24.01,Default,,0,0,0,,Барлығы бақытты өмір сүретін мыңжылдық...
Dialogue: 0,0:13:24.88,0:13:28.01,Default,,0,0,0,,Дұрыс. Сіз бірдеңе таба аласыз ба?
Dialogue: 0,0:13:29.30,0:13:31.60,Default,,0,0,0,,Жарайды, асықпаудың қажеті жоқ.
Dialogue: 0,0:13:31.68,0:13:33.35,Default,,0,0,0,,Бұл оңай емес
Dialogue: 0,0:13:35.81,0:13:37.19,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:13:38.31,0:13:40.31,Default,,0,0,0,,(әйел әншілердің әндері)
Dialogue: 0,0:13:40.40,0:13:42.40,Default,,0,0,0,,♪～
Dialogue: 0,0:13:54.25,0:13:55.25,Default,,0,0,0,,«Ән»
Dialogue: 0,0:13:58.25,0:14:00.25,Default,,0,0,0,,～♪
Dialogue: 0,0:14:01.50,0:14:03.09,Default,,0,0,0,,Әке...
Dialogue: 0,0:14:06.59,0:14:08.09,Default,,0,0,0,,Бұл да жақсы емес.
Dialogue: 0,0:14:08.88,0:14:10.26,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:10.34,0:14:14.93,Default,,0,0,0,,Строфирді жабудың қандай да бір жолы болуы керек...
Dialogue: 0,0:14:15.89,0:14:18.14,Default,,0,0,0,,Сіз мағынасыз нәрсе істеп жатырсыз.
Dialogue: 0,0:14:18.64,0:14:19.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:19.35,0:14:23.61,Default,,0,0,0,,Менің бұл дүние туылғанға дейін болғаным.
Dialogue: 0,0:14:23.69,0:14:25.82,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:14:25.90,0:14:27.28,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:14:27.36,0:14:30.07,Default,,0,0,0,,Бірақ сіз адам бейнесін алуыңыз керек.
Dialogue: 0,0:14:30.16,0:14:32.66,Default,,0,0,0,,Сіз тіпті бұл дүниеге араласа алмайсыз, солай ма?
Dialogue: 0,0:14:32.74,0:14:34.83,Default,,0,0,0,,Әрқашан оны мөрлеудің жолы бар.
Dialogue: 0,0:14:36.04,0:14:38.75,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:14:40.92,0:14:41.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:46.92,0:14:50.55,Default,,0,0,0,,Строфия адамдардан бұрын дүниеге келген.
Dialogue: 0,0:14:50.63,0:14:53.51,Default,,0,0,0,,Бірақ бұл атау мұраға қалдырылды.
Dialogue: 0,0:14:54.01,0:14:55.64,Default,,0,0,0,,Саған кім айтты?
Dialogue: 0,0:14:56.31,0:14:58.81,Default,,0,0,0,,Егер мөр басып қойған біреу болса...
Dialogue: 0,0:14:58.89,0:14:59.89,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:15:00.44,0:15:01.77,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:02.98,0:15:04.48,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:15:06.15,0:15:08.86,Default,,0,0,0,,Материалдық дүниені жоюға тырысатындар
Dialogue: 0,0:15:08.94,0:15:09.90,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:10.40,0:15:13.49,Default,,0,0,0,,Strofire нені қалайды?
Dialogue: 0,0:15:26.05,0:15:27.34,Default,,0,0,0,,Сол арман...
Dialogue: 0,0:15:27.96,0:15:28.88,Default,,0,0,0,,Қызыл тырнақ
Dialogue: 0,0:15:29.38,0:15:31.22,Default,,0,0,0,,Шынжырдағы әйел
Dialogue: 0,0:15:31.30,0:15:32.34,Default,,0,0,0,,Строфир дәл осы жерде.
Dialogue: 0,0:15:33.68,0:15:35.89,Default,,0,0,0,,Жындар әлемінде болған кезімнен естеліктер
Dialogue: 0,0:15:35.97,0:15:38.14,Default,,0,0,0,,Жауап осында емес пе?
Dialogue: 0,0:15:38.64,0:15:41.64,Default,,0,0,0,,Мен... Мен өзім шайтан бола аламын.
Dialogue: 0,0:15:41.73,0:15:42.65,Default,,0,0,0,,перне
Dialogue: 0,0:15:43.90,0:15:44.86,Default,,0,0,0,,Шайтанға...
Dialogue: 0,0:15:44.94,0:15:46.23,Default,,0,0,0,,Болу
Dialogue: 0,0:15:50.69,0:15:55.12,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:55.20,0:15:56.74,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:15:57.70,0:15:59.62,Default,,0,0,0,,Иә, күткеніңізге рахмет~
Dialogue: 0,0:15:59.70,0:16:02.62,Default,,0,0,0,,Әй, бұл қиын болды.
Dialogue: 0,0:16:02.71,0:16:04.63,Default,,0,0,0,,Олай болса, мөр үшін рахмет~
Dialogue: 0,0:16:05.21,0:16:06.54,Default,,0,0,0,,Гремори
Dialogue: 0,0:16:06.63,0:16:09.34,Default,,0,0,0,,Строфирді жабуға көмектесіңіз.
Dialogue: 0,0:16:09.42,0:16:10.13,Default,,0,0,0,,Э~?
Dialogue: 0,0:16:10.92,0:16:12.76,Default,,0,0,0,,Строфир?
Dialogue: 0,0:16:12.84,0:16:16.55,Default,,0,0,0,,Бұл аздап...дәлірек айтсақ, шектен шыққан бұйрық.
Dialogue: 0,0:16:16.64,0:16:20.39,Default,,0,0,0,,Нагхаммади құжаттарынан Крит сызықтық жазуы
Dialogue: 0,0:16:20.47,0:16:23.14,Default,,0,0,0,,Пасха аралындағы Ронгоронго ағашына.
Dialogue: 0,0:16:23.23,0:16:27.61,Default,,0,0,0,,Көне құжаттардың барлық түрін іздедім, бірақ техникасын таба алмадым.
Dialogue: 0,0:16:27.69,0:16:28.27,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:28.86,0:16:32.86,Default,,0,0,0,,Егер мен оны тапсам ше? Сонда?
Dialogue: 0,0:16:33.36,0:16:34.61,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:16:34.70,0:16:35.57,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:16:36.07,0:16:37.37,Default,,0,0,0,,Мұны орындаңыз
Dialogue: 0,0:16:37.87,0:16:40.29,Default,,0,0,0,,Бұл шынымен де рас, солай емес пе?
Dialogue: 0,0:16:41.16,0:16:42.00,Default,,0,0,0,,О
Dialogue: 0,0:16:42.66,0:16:44.29,Default,,0,0,0,,Ішімде…
Dialogue: 0,0:16:49.38,0:16:51.55,Default,,0,0,0,,(Пломбаны бұзу дыбысы)
Dialogue: 0,0:17:00.85,0:17:02.52,Default,,0,0,0,,Сен бейбақ!
Dialogue: 0,0:17:04.31,0:17:04.81,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:04.89,0:17:05.94,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:06.02,0:17:08.94,Default,,0,0,0,,Менің қолымнан келетіні - үндемеу және қарау.
Dialogue: 0,0:17:09.02,0:17:12.32,Default,,0,0,0,,Он екі елшіні жинаған дұрыс емес пе?
Dialogue: 0,0:17:12.40,0:17:16.36,Default,,0,0,0,,Осылай жалғаса берсе, көзге көрінбейтін мектеп пен ағам не болмақ...
Dialogue: 0,0:17:16.45,0:17:20.33,Default,,0,0,0,,Он екі елшінің барлығы өз елдерінде аянбай еңбек етуде.
Dialogue: 0,0:17:20.41,0:17:21.41,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:17:21.49,0:17:24.66,Default,,0,0,0,,Ал мен Ичираға сенемін.
Dialogue: 0,0:17:25.41,0:17:29.63,Default,,0,0,0,,Өйткені дәл қазір әке ретінде менің қолымнан келетіні осы ғана.
Dialogue: 0,0:17:32.59,0:17:34.17,Default,,0,0,0,,Шайтан-күн жігіт...
Dialogue: 0,0:17:45.98,0:17:49.19,Default,,0,0,0,,Шайтан-сама~
Dialogue: 0,0:17:49.27,0:17:51.23,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:17:52.61,0:17:54.28,Default,,0,0,0,,Менің ойымша, сіз білесіз.
Dialogue: 0,0:17:54.36,0:17:58.41,Default,,0,0,0,,Строфир Девил-кунмен араласып жатыр.
Dialogue: 0,0:17:59.49,0:18:00.87,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:18:00.95,0:18:05.37,Default,,0,0,0,,Оның сиқырын бұзуды білмейсің бе?
Dialogue: 0,0:18:11.38,0:18:12.59,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:18:12.67,0:18:13.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:13.38,0:18:16.17,Default,,0,0,0,,Түстер қиын.
Dialogue: 0,0:18:16.26,0:18:17.93,Default,,0,0,0,,Қан қызыл болса да
Dialogue: 0,0:18:18.01,0:18:21.89,Default,,0,0,0,,Тері астынан көрінетін қан тамырларының түсі көк.
Dialogue: 0,0:18:24.06,0:18:26.31,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:18:27.10,0:18:28.81,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:18:29.48,0:18:29.98,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:30.06,0:18:31.06,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:18:33.40,0:18:35.28,Default,,0,0,0,,Ммм
Dialogue: 0,0:18:35.36,0:18:36.82,Default,,0,0,0,,Куку куку
Dialogue: 0,0:18:37.61,0:18:39.28,Default,,0,0,0,,О, бұл көк.
Dialogue: 0,0:18:39.36,0:18:40.86,Default,,0,0,0,,Бұл дәмді көк
Dialogue: 0,0:18:40.95,0:18:42.32,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:18:42.41,0:18:43.91,Default,,0,0,0,,Бұл көк
Dialogue: 0,0:18:45.12,0:18:46.66,Default,,0,0,0,,Строфир - бұл
Dialogue: 0,0:18:46.75,0:18:49.83,Default,,0,0,0,,Өзіңді осы дүниенің ережелерінен тыс қалдым деп ойлау
Dialogue: 0,0:18:50.33,0:18:52.29,Default,,0,0,0,,Шынымен
Dialogue: 0,0:18:52.38,0:18:55.05,Default,,0,0,0,,Материалдық әлемге қатысы жоқ
Dialogue: 0,0:18:55.13,0:18:57.59,Default,,0,0,0,,Бірақ біз өмір сүргендіктен
Dialogue: 0,0:18:57.67,0:19:00.38,Default,,0,0,0,,Оны тоқтатудың жолы бар
Dialogue: 0,0:19:07.52,0:19:11.40,Default,,0,0,0,,Ол өте нашар, солай емес пе?
Dialogue: 0,0:19:12.15,0:19:14.86,Default,,0,0,0,,Егер сіз оны маған беретін болсаңыз, әдеттегідей беріңіз.
Dialogue: 0,0:19:16.44,0:19:17.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:17.61,0:19:18.86,Default,,0,0,0,,Сіздің пікіріңізді естігеннен кейін оны мүмкіндігінше тезірек хабардар еткім келді.
Dialogue: 0,0:19:18.94,0:19:22.61,Default,,0,0,0,,Мен де күткендей аман-есен құтыла алмадым.
Dialogue: 0,0:19:23.12,0:19:24.37,Default,,0,0,0,,Бірақ иә
Dialogue: 0,0:19:24.45,0:19:26.74,Default,,0,0,0,,Осы арқылы мен Строфирді жақсы көремін.
Dialogue: 0,0:19:26.83,0:19:28.75,Default,,0,0,0,,Ах~ бұл ауырды~
Dialogue: 0,0:19:28.83,0:19:32.37,Default,,0,0,0,,Шіркін, анау-мынау шағады.
Dialogue: 0,0:19:32.46,0:19:35.38,Default,,0,0,0,,Жасы үлкен болғандықтан ғана жаман емес пе?
Dialogue: 0,0:19:37.92,0:19:39.84,Default,,0,0,0,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:19:39.92,0:19:41.38,Default,,0,0,0,,Сәлеметсіз бе! Эй!
Dialogue: 0,0:19:42.38,0:19:43.84,Default,,0,0,0,,Мен көрінбейтін мектепке барамын
Dialogue: 0,0:19:43.93,0:19:44.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:44.97,0:19:45.72,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:19:45.80,0:19:48.14,Default,,0,0,0,,Иә? Азғана? Рақмет сізге?
Dialogue: 0,0:19:48.22,0:19:52.02,Default,,0,0,0,,«Жақсы жұмыс» немесе «Гремори-чан күткендей» сияқты сөздерді айту
Dialogue: 0,0:19:52.10,0:19:54.90,Default,,0,0,0,,Алғыс сөз жоқ па?
Dialogue: 0,0:19:58.98,0:19:59.90,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:19:59.99,0:20:00.78,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:00.86,0:20:02.20,Default,,0,0,0,,(Бұрғы моторының дыбысы)
Dialogue: 0,0:20:02.28,0:20:03.91,Default,,0,0,0,,А, жер асты да жақсы емес пе?
Dialogue: 0,0:20:03.99,0:20:04.53,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:05.87,0:20:07.03,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:20:07.12,0:20:09.83,Default,,0,0,0,,Жаман болайын деп тұр.
Dialogue: 0,0:20:09.91,0:20:11.87,Default,,0,0,0,,Әрі қарай не болады? әке
Dialogue: 0,0:20:11.96,0:20:12.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:12.58,0:20:14.12,Default,,0,0,0,,ше? не?
Dialogue: 0,0:20:21.13,0:20:22.01,Default,,0,0,0,,Ібіліс-күн!
Dialogue: 0,0:20:22.09,0:20:23.38,Default,,0,0,0,,Ағай!
Dialogue: 0,0:20:24.72,0:20:26.39,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:20:26.47,0:20:27.47,Default,,0,0,0,,О
Dialogue: 0,0:20:28.06,0:20:31.60,Default,,0,0,0,,Мен строфир тосқауылынан өтудің жолын таптым.
Dialogue: 0,0:20:33.56,0:20:34.65,Default,,0,0,0,,О!
Dialogue: 0,0:20:36.19,0:20:37.27,Default,,0,0,0,,Жақсы өтті...
Dialogue: 0,0:20:37.36,0:20:37.86,Default,,0,0,0,,О...
Dialogue: 0,0:20:37.94,0:20:39.02,Default,,0,0,0,,Ой
Dialogue: 0,0:20:39.94,0:20:41.69,Default,,0,0,0,,Амансың ба? Шайтан-күн
Dialogue: 0,0:20:41.78,0:20:43.15,Default,,0,0,0,,Ағай, берік болыңыз!
Dialogue: 0,0:20:43.65,0:20:46.95,Default,,0,0,0,,Кешіріңіз Мефисто II
Dialogue: 0,0:20:47.03,0:20:48.45,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:20:48.53,0:20:49.37,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:49.45,0:20:50.24,Default,,0,0,0,,Хаа…
Dialogue: 0,0:20:50.33,0:20:53.08,Default,,0,0,0,,Бір кезде мен не болар екен деп ойладым.
Dialogue: 0,0:20:53.16,0:20:55.96,Default,,0,0,0,,Строфирдің абайсыздығын пайдаланыңыз.
Dialogue: 0,0:20:56.83,0:20:58.09,Default,,0,0,0,,Ағам күткендей
Dialogue: 0,0:20:58.17,0:20:59.13,Default,,0,0,0,,Ичиро ше?
Dialogue: 0,0:20:59.21,0:21:00.25,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:21:00.34,0:21:04.72,Default,,0,0,0,,Ол адамдыққа жатпайтын шайтан.
Dialogue: 0,0:21:04.80,0:21:07.72,Default,,0,0,0,,Бұл сіздің балағат сөздеріңіздің ауқымы ма?
Dialogue: 0,0:21:07.80,0:21:08.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:08.60,0:21:11.10,Default,,0,0,0,,Менің ойымша, сіз Миодан біраз нәрсені үйренуіңіз керек.
Dialogue: 0,0:21:11.60,0:21:14.39,Default,,0,0,0,,Бұл рас~ Бұл деңгейде жақсы емес.
Dialogue: 0,0:21:15.73,0:21:16.44,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:16.94,0:21:20.94,Default,,0,0,0,,Енді бұл жерге келіп, бастық болма.
Dialogue: 0,0:21:21.48,0:21:23.24,Default,,0,0,0,,Жарайсыз, III мырза.
Dialogue: 0,0:21:23.32,0:21:26.11,Default,,0,0,0,,Жаңа келгенің жақсы емес пе?
Dialogue: 0,0:21:26.66,0:21:28.41,Default,,0,0,0,,Рахмет Ичиро
Dialogue: 0,0:21:28.49,0:21:32.74,Default,,0,0,0,,Гремори менің ұлыма әрқашан қарыздар.
Dialogue: 0,0:21:32.83,0:21:35.04,Default,,0,0,0,,Менің қазіргі түрім осындай~
Dialogue: 0,0:21:35.12,0:21:36.54,Default,,0,0,0,,Сәлем Гремори
Dialogue: 0,0:21:46.30,0:21:46.88,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:46.97,0:21:47.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:50.01,0:21:52.01,Default,,0,0,0,,♪～
Dialogue: 0,0:22:05.28,0:22:06.45,Default,,0,0,0,,Ібіліс-күн!
Dialogue: 0,0:22:06.53,0:22:07.65,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:22:07.74,0:22:08.78,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:22:08.86,0:22:09.66,Default,,0,0,0,,Шайтан
Dialogue: 0,0:22:09.74,0:22:12.83,Default,,0,0,0,,Бұл Шайтан Итиро Акума-кунды басқарып тұрған жоқ па?
Dialogue: 0,0:22:12.91,0:22:16.46,Default,,0,0,0,,А-а, сіз бұрыннан мөрмен жабылғаныңызға кексіз бе?
Dialogue: 0,0:22:16.54,0:22:17.54,Default,,0,0,0,,Монмонмон!
Dialogue: 0,0:22:17.62,0:22:20.50,Default,,0,0,0,,Сонда мен Сфинкс мені қайтадан жеңеді!
Dialogue: 0,0:22:20.58,0:22:21.42,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:22:21.50,0:22:23.09,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:22:23.17,0:22:24.59,Default,,0,0,0,,Оны не үшін тоқтату керек?
Dialogue: 0,0:22:24.67,0:22:25.59,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:22:26.09,0:22:29.72,Default,,0,0,0,,Жарқанат-мысық шайтанның мүшесі болды ма?
Dialogue: 0,0:22:29.80,0:22:30.64,Default,,0,0,0,,Эх!
Dialogue: 0,0:22:30.72,0:22:33.10,Default,,0,0,0,,«Сиқырлы күш, үлкен сатқындық»
Dialogue: 0,0:22:33.18,0:22:35.85,Default,,0,0,0,,Жоқ, жоқ, бұл менің мамандығым...
Dialogue: 0,0:22:35.93,0:22:37.14,Default,,0,0,0,,Жаман жарқанат!
Dialogue: 0,0:22:37.23,0:22:39.10,Default,,0,0,0,,А, жаман мысық?
Dialogue: 0,0:22:39.19,0:22:39.98,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:22:40.06,0:22:43.48,Default,,0,0,0,,Құқық бұзушы болып кеткен Ичиро Акума-кун емес пе?
Dialogue: 0,0:22:43.57,0:22:44.61,Default,,0,0,0,,А...
Dialogue: 0,0:22:44.69,0:22:45.86,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:22:45.94,0:22:48.95,Default,,0,0,0,,Енді әке болған соң, жоғарыдан артық айтып тұрған жоқсың ба?
Dialogue: 0,0:22:49.03,0:22:50.36,Default,,0,0,0,,Бұл папахара.
Dialogue: 0,0:22:50.45,0:22:53.58,Default,,0,0,0,,Себебі мен Мыңжылдық Патшалықты жүзеге асыру туралы тым көп айттым.
Dialogue: 0,0:22:53.66,0:22:55.41,Default,,0,0,0,,Сондықтан мен ренжідім.
Dialogue: 0,0:22:55.49,0:22:58.79,Default,,0,0,0,,Мен Девил-кун мәжбүрлі ештеңе айтпайды деп ойлаймын.
Dialogue: 0,0:22:58.87,0:22:59.87,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:22:59.96,0:23:02.92,Default,,0,0,0,,Ал Мыңжылдық жүзеге асады
Dialogue: 0,0:23:03.00,0:23:06.96,Default,,0,0,0,,Мон оны жүзеге асыру үшін не істеу керектігін ойластыру маңызды екенін айтты.
Dialogue: 0,0:23:07.46,0:23:11.55,Default,,0,0,0,,Мыңжылдық ғылыми-зерттеу институты шайтанның мейірімділігі.
Dialogue: 0,0:23:11.64,0:23:14.10,Default,,0,0,0,,Хм, онда әзірге тозаққа барайық.
Dialogue: 0,0:23:14.18,0:23:15.89,Default,,0,0,0,,Ниндзя патшадан сұрауым керек пе?
Dialogue: 0,0:23:15.97,0:23:18.10,Default,,0,0,0,,Иә, дүйсенбі! Ни-сама демон!
Dialogue: 0,0:23:18.18,0:23:21.19,Default,,0,0,0,,Мүмкін Ни-сама бірдеңе істей алады.
Dialogue: 0,0:23:21.27,0:23:22.10,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:23:22.19,0:23:25.07,Default,,0,0,0,,Ни-самаға өз әңгімеңізді қалай тыңдауға болады
Dialogue: 0,0:23:25.57,0:23:27.78,Default,,0,0,0,,Сүлейменнің сыбызғы...
Dialogue: 0,0:23:28.28,0:23:30.03,Default,,0,0,0,,Бәрі жақсы!
Dialogue: 0,0:23:30.11,0:23:32.36,Default,,0,0,0,,Келесі жолы соңғы эпизод
Dialogue: 0,0:23:47.92,0:23:49.92,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.42,0:23:57.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory