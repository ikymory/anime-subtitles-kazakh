Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.76,0:00:17.30,Default,,0,0,0,,Бәріңе сәлем, Мофу
Dialogue: 0,0:00:17.43,0:00:19.64,Default,,0,0,0,,Иә? Сіз кімсіз, Мофф?
Dialogue: 0,0:00:19.76,0:00:21.73,Default,,0,0,0,,Керемет Лейтморф
Dialogue: 0,0:00:23.60,0:00:26.40,Default,,0,0,0,,Барлығында Ғажайып жарық бар ма?
Dialogue: 0,0:00:26.52,0:00:27.52,Default,,0,0,0,,Иә
Dialogue: 0,0:00:27.65,0:00:31.36,Default,,0,0,0,,Бұл жарық фильмде ол және Прекюр сиқыр жасағанда пайдаланылады.
Dialogue: 0,0:00:31.53,0:00:34.07,Default,,0,0,0,,Мұны Прекюр қысылған кезде пайдаланыңыз.
Dialogue: 0,0:00:34.24,0:00:34.90,Default,,0,0,0,,Ең үздік батыр болу үшін
Dialogue: 0,0:00:35.03,0:00:37.07,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:00:37.24,0:00:38.99,Default,,0,0,0,,Ах! таң қалдыратын
Dialogue: 0,0:00:39.41,0:00:41.58,Default,,0,0,0,,Маңайдағы жарықтан жарыққа қарау
Dialogue: 0,0:00:41.75,0:00:43.25,Default,,0,0,0,,Хи хи
Dialogue: 0,0:00:43.83,0:00:44.66,Default,,0,0,0,,Міне!
Dialogue: 0,0:00:45.25,0:00:48.88,Default,,0,0,0,,Ешқашан ештеңені лақтырмаңыз немесе соқпаңыз, себебі бұл қауіпті.
Dialogue: 0,0:00:50.04,0:00:52.09,Default,,0,0,0,,Содан кейін біз билеген кезде
Dialogue: 0,0:00:52.21,0:00:55.22,Default,,0,0,0,,Айналаңыздағы адамдарға соқтығысудан сақ болыңыз.
Dialogue: 0,0:00:55.76,0:00:57.18,Default,,0,0,0,,Енді бастайық
Dialogue: 0,0:00:57.30,0:01:01.77,Default,,0,0,0,,Сейно Кюп Рапапа, перде, көтеріл!
Dialogue: 0,0:01:09.61,0:01:11.15,Default,,0,0,0,,Куап Рапапа
Dialogue: 0,0:01:14.44,0:01:15.28,Default,,0,0,0,,Алмаз
Dialogue: 0,0:01:18.32,0:01:20.70,Default,,0,0,0,,Керемет сиқырлы зергерлік бұйымдар
Dialogue: 0,0:01:23.45,0:01:24.58,Default,,0,0,0,,Изумруд
Dialogue: 0,0:01:27.62,0:01:30.29,Default,,0,0,0,,Фелис Фанфан Флоре
Dialogue: 0,0:02:04.66,0:02:07.50,Default,,0,0,0,,Екі емнің кереметі Керемет
Dialogue: 0,0:02:08.00,0:02:11.04,Default,,0,0,0,,Екі адамның сиқыры Сиқырлы ем
Dialogue: 0,0:02:12.00,0:02:13.96,Default,,0,0,0,,Бүкіл өмірге береке бер
Dialogue: 0,0:02:14.67,0:02:15.34,Default,,0,0,0,,Әй
Dialogue: 0,0:02:19.22,0:02:20.68,Default,,0,0,0,,Фелисті емдеу
Dialogue: 0,0:02:22.05,0:02:24.26,Default,,0,0,0,,Сиқырлы прекюр
Dialogue: 0,0:02:27.02,0:02:32.02,Default,,0,0,0,,♪～
Dialogue: 0,0:02:49.08,0:02:50.96,Default,,0,0,0,,I Мираи Асахина
Dialogue: 0,0:02:51.08,0:02:52.25,Default,,0,0,0,,Аңызға айналған сиқырлы қолданушы
Dialogue: 0,0:02:52.38,0:02:54.17,Default,,0,0,0,,Емдік ғажайыпқа айналды
Dialogue: 0,0:02:55.04,0:02:56.71,Default,,0,0,0,,Ха! Тааа!
Dialogue: 0,0:02:57.17,0:02:58.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:01.38,0:03:02.39,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:03:02.51,0:03:04.26,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:03:04.39,0:03:07.77,Default,,0,0,0,,Бұл қыз – Рико, сиқырлы әлемнің қызы.
Dialogue: 0,0:03:07.89,0:03:10.39,Default,,0,0,0,,Сіз менімен бірге Сиқырлы емші болдыңыз.
Dialogue: 0,0:03:11.23,0:03:12.90,Default,,0,0,0,,Қолынан келгеннің бәрін жасайтын Мофу
Dialogue: 0,0:03:13.56,0:03:15.02,Default,,0,0,0,,Бұл бала Мофурун
Dialogue: 0,0:03:15.15,0:03:16.90,Default,,0,0,0,,Әрқашан жаныңда болатын тұлып
Dialogue: 0,0:03:17.07,0:03:18.07,Default,,0,0,0,,Сіз Прекюр болған кезде
Dialogue: 0,0:03:18.19,0:03:19.57,Default,,0,0,0,,Енді мен сөйлей аламын.
Dialogue: 0,0:03:19.69,0:03:20.40,Default,,0,0,0,,Уау
Dialogue: 0,0:03:20.53,0:03:21.74,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:03:22.07,0:03:23.49,Default,,0,0,0,,Мофу
Dialogue: 0,0:03:25.66,0:03:26.78,Default,,0,0,0,,Фелис
Dialogue: 0,0:03:26.91,0:03:27.83,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:03:28.16,0:03:29.54,Default,,0,0,0,,Бұл бала Ха Чан
Dialogue: 0,0:03:29.70,0:03:31.25,Default,,0,0,0,,Ертегі балаға айналу
Dialogue: 0,0:03:31.41,0:03:32.58,Default,,0,0,0,,Фелиске ем болу
Dialogue: 0,0:03:33.17,0:03:34.04,Default,,0,0,0,,Донёнквар
Dialogue: 0,0:03:34.88,0:03:37.75,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:03:43.55,0:03:44.39,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:03:44.68,0:03:47.18,Default,,0,0,0,,Толық! Толық! Әжім!
Dialogue: 0,0:03:47.68,0:03:51.43,Default,,0,0,0,,Прекюр гауһар мәңгілік!
Dialogue: 0,0:03:51.56,0:03:56.56,Default,,0,0,0,,～♪
Dialogue: 0,0:04:08.79,0:04:10.12,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:04:10.66,0:04:11.41,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:04:11.91,0:04:12.62,Default,,0,0,0,,Иә
Dialogue: 0,0:04:13.00,0:04:13.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:13.79,0:04:14.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:15.46,0:04:16.71,Default,,0,0,0,,Аққан жұлдыз!
Dialogue: 0,0:04:17.33,0:04:19.30,Default,,0,0,0,,Мен сенен бірнәрсе сұрайын деп едім.
Dialogue: 0,0:04:19.46,0:04:20.63,Default,,0,0,0,,Өтінемін?
Dialogue: 0,0:04:21.59,0:04:23.30,Default,,0,0,0,,Аққан жұлдыз жоғалып кетпес бұрын―
Dialogue: 0,0:04:23.42,0:04:26.64,Default,,0,0,0,,Үш рет тілек тілесең орындалады дейді.
Dialogue: 0,0:04:28.05,0:04:30.22,Default,,0,0,0,,Баршаңызға, сіз қандай өтініш тілейсіз?
Dialogue: 0,0:04:30.64,0:04:31.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:31.60,0:04:33.56,Default,,0,0,0,,Маған сиқырлы кітап керек
Dialogue: 0,0:04:33.69,0:04:35.69,Default,,0,0,0,,Ах! Сосын мен де солай істеймін.
Dialogue: 0,0:04:35.81,0:04:36.98,Default,,0,0,0,,Мофу!
Dialogue: 0,0:04:37.44,0:04:38.19,Default,,0,0,0,,Болашақ туралы не деуге болады?
Dialogue: 0,0:04:38.31,0:04:38.98,Default,,0,0,0,,Не!
Dialogue: 0,0:04:39.15,0:04:40.36,Default,,0,0,0,,Тілектер
Dialogue: 0,0:04:40.48,0:04:42.94,Default,,0,0,0,,Мен бе? Мен...
Dialogue: 0,0:04:43.32,0:04:44.70,Default,,0,0,0,,Сондай-ақ Shooting Star Moff
Dialogue: 0,0:04:44.82,0:04:45.49,Default,,0,0,0,,және келісім-шарт аяқталады
Dialogue: 0,0:04:47.32,0:04:48.49,Default,,0,0,0,,Уау, бұл рас.
Dialogue: 0,0:04:48.62,0:04:49.83,Default,,0,0,0,,Сиқырлы кітап Сиқырлы кітап Сиқырлы кітап...
Dialogue: 0,0:04:49.95,0:04:54.21,Default,,0,0,0,,Асығыңыз! Ал, тілек, тілек...
Dialogue: 0,0:04:54.37,0:04:58.08,Default,,0,0,0,,Әй, бұл жұлдыз жақындап келе жатқан жоқ па?
Dialogue: 0,0:04:58.63,0:05:01.42,Default,,0,0,0,,бірақ мен әлемді өзгерту үшін өзім кісі өлтірушіге айналар едім деп ойламаймын
Dialogue: 0,0:05:01.67,0:05:04.51,Default,,0,0,0,,Бұл шынымен келе жатыр! Уф...
Dialogue: 0,0:05:04.76,0:05:08.93,Default,,0,0,0,,Ах! Болашақ Мофф?
Dialogue: 0,0:05:09.05,0:05:09.97,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:14.02,0:05:14.77,Default,,0,0,0,,Аю
Dialogue: 0,0:05:14.98,0:05:15.64,Default,,0,0,0,,Бұл аю.
Dialogue: 0,0:05:15.81,0:05:16.52,Default,,0,0,0,,Аю
Dialogue: 0,0:05:16.89,0:05:21.48,Default,,0,0,0,,Мофурун сияқты! Бірақ мен сиқырлы кітап алғым келді.
Dialogue: 0,0:05:21.61,0:05:25.78,Default,,0,0,0,,Жоқ, одан да көп... а? а?
Dialogue: 0,0:05:28.32,0:05:29.16,Default,,0,0,0,,Не?!
Dialogue: 0,0:05:29.57,0:05:30.83,Default,,0,0,0,,Шар?
Dialogue: 0,0:05:31.45,0:05:32.87,Default,,0,0,0,,Бұл ғажайып жарық
Dialogue: 0,0:05:32.99,0:05:33.66,Default,,0,0,0,,О!
Dialogue: 0,0:05:37.08,0:05:39.54,Default,,0,0,0,,Алдағы фестивальге не керек.
Dialogue: 0,0:05:39.88,0:05:42.75,Default,,0,0,0,,Директор! Фестиваль?
Dialogue: 0,0:05:42.88,0:05:46.47,Default,,0,0,0,,Бүкіл сиқыршылар әлемі 100 жылда бір рет өткізеді
Dialogue: 0,0:05:46.59,0:05:49.80,Default,,0,0,0,,Атауы Ұлы сиқырлы фестиваль
Dialogue: 0,0:05:49.93,0:05:51.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:51.76,0:05:53.14,Default,,0,0,0,,Енді... Мофф?
Dialogue: 0,0:05:53.43,0:05:56.43,Default,,0,0,0,,Ұлы сиқырлы фестиваль дедіңіз бе?
Dialogue: 0,0:06:01.36,0:06:05.23,Default,,0,0,0,,Ақырында, сол тас...
Dialogue: 0,0:06:16.00,0:06:17.08,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:06:17.21,0:06:20.79,Default,,0,0,0,,Бұл Ұлы сиқыр фестивалінің өтетін орны
Dialogue: 0,0:06:23.67,0:06:27.38,Default,,0,0,0,,Қараңдаршы, шардың ішінде қала бар
Dialogue: 0,0:06:27.59,0:06:29.43,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:06:38.02,0:06:40.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:40.69,0:06:42.06,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:06:42.73,0:06:43.65,Default,,0,0,0,,Эй, мынаны қарашы.
Dialogue: 0,0:06:43.77,0:06:44.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:45.44,0:06:46.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:47.03,0:06:51.28,Default,,0,0,0,,Керемет Уау
Dialogue: 0,0:06:51.45,0:06:53.28,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:06:53.95,0:06:57.58,Default,,0,0,0,,Әрбір шар – дүкен, көрме немесе іс-шара өтетін орын.
Dialogue: 0,0:06:58.45,0:06:59.16,Default,,0,0,0,,Өте қызықты!
Dialogue: 0,0:06:59.29,0:07:01.21,Default,,0,0,0,,Мираи Рико!
Dialogue: 0,0:07:01.33,0:07:02.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:02.29,0:07:03.75,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:07:03.88,0:07:04.71,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:07:06.38,0:07:09.47,Default,,0,0,0,,(Мирайдың күлуі)
Dialogue: 0,0:07:13.30,0:07:15.93,Default,,0,0,0,,Аюлар көп
Dialogue: 0,0:07:16.06,0:07:17.89,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:07:18.98,0:07:19.81,Default,,0,0,0,,Мұнда не?
Dialogue: 0,0:07:20.27,0:07:22.19,Default,,0,0,0,,Бұл киім шары
Dialogue: 0,0:07:22.31,0:07:26.19,Default,,0,0,0,,Сиқыршылар әлемінің соңғы сәні осында сияқты.
Dialogue: 0,0:07:26.32,0:07:27.44,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:07:27.57,0:07:28.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:29.11,0:07:31.15,Default,,0,0,0,,Ах, Франсуа.
Dialogue: 0,0:07:31.70,0:07:36.45,Default,,0,0,0,,Francois's Festival Limited дүкеніне қош келдіңіз
Dialogue: 0,0:07:36.74,0:07:38.16,Default,,0,0,0,,Дүкен шектеулі ме?
Dialogue: 0,0:07:38.29,0:07:41.83,Default,,0,0,0,,Балалар, сендер қандайсыңдар?
Dialogue: 0,0:07:42.00,0:07:46.00,Default,,0,0,0,,Бұл фестиваль, сондықтан сіз сәнді болуыңыз керек!
Dialogue: 0,0:07:46.67,0:07:48.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:49.38,0:07:50.47,Default,,0,0,0,,Мофу
Dialogue: 0,0:07:51.09,0:07:52.51,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:07:52.63,0:07:53.97,Default,,0,0,0,,Мофу!
Dialogue: 0,0:07:54.09,0:07:55.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:55.64,0:07:57.14,Default,,0,0,0,,Эй, енді қайда баруымыз керек?
Dialogue: 0,0:07:57.26,0:07:59.43,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:07:59.81,0:08:01.73,Default,,0,0,0,,Рико да көңілді жүрген сияқты Мофу
Dialogue: 0,0:08:01.85,0:08:03.19,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:03.35,0:08:06.02,Default,,0,0,0,,Ұлы сиқырлы фестиваль 100 жылда бір рет өтеді.
Dialogue: 0,0:08:06.15,0:08:09.28,Default,,0,0,0,,«Тілек тасының» қайта тірілуін тойлайтын үлкен оқиға.
Dialogue: 0,0:08:10.03,0:08:12.20,Default,,0,0,0,,«Тілек тасы»?
Dialogue: 0,0:08:12.70,0:08:15.41,Default,,0,0,0,,Кез келген тілекті орындай алатын тас.
Dialogue: 0,0:08:15.53,0:08:16.20,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:08:16.37,0:08:20.20,Default,,0,0,0,,Алайда тас бір адамды ғана таңдайтын сияқты.
Dialogue: 0,0:08:20.37,0:08:21.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:22.16,0:08:24.04,Default,,0,0,0,,Тілек...
Dialogue: 0,0:08:24.21,0:08:25.17,Default,,0,0,0,,Мофф?
Dialogue: 0,0:08:26.13,0:08:27.71,Default,,0,0,0,,Тамақтану алаңы шары
Dialogue: 0,0:08:28.63,0:08:30.80,Default,,0,0,0,,Сіз кесе пудинг алғыңыз келе ме?
Dialogue: 0,0:08:30.92,0:08:32.34,Default,,0,0,0,,Уау! Өтінемін
Dialogue: 0,0:08:33.13,0:08:34.59,Default,,0,0,0,,Куап Рапапа
Dialogue: 0,0:08:35.72,0:08:37.68,Default,,0,0,0,,Мен не шығатынын асыға күтемін.
Dialogue: 0,0:08:37.93,0:08:38.72,Default,,0,0,0,,Уау
Dialogue: 0,0:08:38.85,0:08:39.68,Default,,0,0,0,,Мен де!
Dialogue: 0,0:08:40.14,0:08:41.68,Default,,0,0,0,,Куап Лапапа
Dialogue: 0,0:08:42.43,0:08:43.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:44.81,0:08:46.23,Default,,0,0,0,,Не?!
Dialogue: 0,0:08:46.69,0:08:48.36,Default,,0,0,0,,Мұражай шары
Dialogue: 0,0:08:49.23,0:08:51.73,Default,,0,0,0,,Көптеген соңғы сиқырлы сыпырғыштар.
Dialogue: 0,0:08:52.57,0:08:53.90,Default,,0,0,0,,Кітапхана шары
Dialogue: 0,0:08:54.07,0:08:55.91,Default,,0,0,0,,Сиқырлы кітаптарға толы
Dialogue: 0,0:08:56.03,0:08:59.37,Default,,0,0,0,,Осының бәрін маған берсең, тілегім қабыл болады.
Dialogue: 0,0:08:59.70,0:09:00.91,Default,,0,0,0,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,0:09:01.12,0:09:02.33,Default,,0,0,0,,Тілек…
Dialogue: 0,0:09:02.95,0:09:08.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:08.83,0:09:12.34,Default,,0,0,0,,Енді айдаһардың жалынды иллюзиясы.
Dialogue: 0,0:09:12.46,0:09:19.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:21.72,0:09:24.02,Default,,0,0,0,,Уау таңғажайып керемет
Dialogue: 0,0:09:25.43,0:09:26.19,Default,,0,0,0,,Угаааа
Dialogue: 0,0:09:26.44,0:09:28.10,Default,,0,0,0,,Не? Ха!
Dialogue: 0,0:09:28.31,0:09:31.11,Default,,0,0,0,,Енді не болмақ... Иә?
Dialogue: 0,0:09:32.73,0:09:35.19,Default,,0,0,0,,Жақсы, бірге ойнайық.
Dialogue: 0,0:09:35.95,0:09:36.99,Default,,0,0,0,,Ха-чан?
Dialogue: 0,0:09:37.41,0:09:38.99,Default,,0,0,0,,Куап Рапапа
Dialogue: 0,0:09:44.45,0:09:46.21,Default,,0,0,0,,Гүлдер, би
Dialogue: 0,0:09:48.29,0:09:50.63,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:50.75,0:09:53.71,Default,,0,0,0,,Ухахаха Угга Угга...
Dialogue: 0,0:09:54.17,0:09:54.84,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:09:54.96,0:09:57.05,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:09:58.26,0:09:59.09,Default,,0,0,0,,Ахаха
Dialogue: 0,0:10:02.47,0:10:04.60,Default,,0,0,0,,…мм хачантара
Dialogue: 0,0:10:04.72,0:10:07.60,Default,,0,0,0,,Эххе кешіріңіз
Dialogue: 0,0:10:07.73,0:10:08.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:12.15,0:10:14.36,Default,,0,0,0,,Сиқыршылар
Dialogue: 0,0:10:14.86,0:10:15.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:15.90,0:10:17.65,Default,,0,0,0,,Мофурун, кеттік.
Dialogue: 0,0:10:18.36,0:10:20.49,Default,,0,0,0,,Тас оянатын сияқты.
Dialogue: 0,0:10:22.12,0:10:23.16,Default,,0,0,0,,Мен көптен күттім
Dialogue: 0,0:10:23.33,0:10:24.37,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:10:24.66,0:10:26.12,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:10:27.25,0:10:28.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:35.80,0:10:37.47,Default,,0,0,0,,Эй, бұл жер бос.
Dialogue: 0,0:10:37.59,0:10:39.34,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:10:40.13,0:10:42.05,Default,,0,0,0,,Негізгі Мофф
Dialogue: 0,0:10:42.97,0:10:45.68,Default,,0,0,0,,Бүгін барлығы жақсы жиналды.
Dialogue: 0,0:10:46.60,0:10:49.52,Default,,0,0,0,,Енді мұнда ұйықтау – «тілек тасы»
Dialogue: 0,0:10:50.31,0:10:53.48,Default,,0,0,0,,Дүниенің бір жерінде 100 жылда бір туылады
Dialogue: 0,0:10:53.61,0:10:56.53,Default,,0,0,0,,Адамдардың тілегін орындай алады дейді.
Dialogue: 0,0:10:57.69,0:10:58.69,Default,,0,0,0,,Тілек…
Dialogue: 0,0:10:59.20,0:11:03.53,Default,,0,0,0,,Тас ең таза және ең үлкен тілектеріңізді орындай алады дейді.
Dialogue: 0,0:11:03.70,0:11:08.20,Default,,0,0,0,,Тас оянғанда ғажайып нұрға тілек айт.
Dialogue: 0,0:11:09.16,0:11:11.21,Default,,0,0,0,,Барлығы түсінді ме?
Dialogue: 0,0:11:11.87,0:11:13.83,Default,,0,0,0,,Бұл шынымен орындала ма?
Dialogue: 0,0:11:13.96,0:11:16.21,Default,,0,0,0,,Бұл сиқыр сияқты емес пе?
Dialogue: 0,0:11:18.51,0:11:19.17,Default,,0,0,0,,Ах
Dialogue: 0,0:11:21.30,0:11:22.97,Default,,0,0,0,,Уақыт жеткен сияқты
Dialogue: 0,0:11:23.68,0:11:24.68,Default,,0,0,0,,Тас...
Dialogue: 0,0:11:25.47,0:11:26.56,Default,,0,0,0,,Оян
Dialogue: 0,0:11:36.27,0:11:37.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:38.23,0:11:39.82,Default,,0,0,0,,Мофу
Dialogue: 0,0:11:41.90,0:11:43.24,Default,,0,0,0,,Келіңіздер, бәріңіз.
Dialogue: 0,0:11:49.91,0:11:52.08,Default,,0,0,0,,100 сиқырлы кітап 100 сиқырлы кітап...
Dialogue: 0,0:11:52.75,0:11:54.46,Default,,0,0,0,,Жарайды, мен де!
Dialogue: 0,0:11:58.50,0:11:59.71,Default,,0,0,0,,Уау
Dialogue: 0,0:11:59.84,0:12:00.76,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:12:00.88,0:12:01.55,Default,,0,0,0,,Ахх
Dialogue: 0,0:12:09.52,0:12:14.27,Default,,0,0,0,,Уау! Ах! Сіз тілек айтпайсыз ба?
Dialogue: 0,0:12:14.40,0:12:16.77,Default,,0,0,0,,Не? Хмм
Dialogue: 0,0:12:17.36,0:12:22.53,Default,,0,0,0,,Мен бұл туралы көптен бері ойлап жүрмін, бірақ менің ойыма мұндай нәрсе келмейді.
Dialogue: 0,0:12:22.65,0:12:23.53,Default,,0,0,0,,Не?
Dialogue: 0,0:12:24.95,0:12:27.41,Default,,0,0,0,,Менің… тілегім
Dialogue: 0,0:12:28.12,0:12:29.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:30.62,0:12:31.95,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:12:32.08,0:12:32.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:35.58,0:12:36.63,Default,,0,0,0,,Үлкен!
Dialogue: 0,0:12:36.79,0:12:38.00,Default,,0,0,0,,Үлкен!
Dialogue: 0,0:12:38.13,0:12:39.88,Default,,0,0,0,,...Бұл Мофф-чан емес пе?
Dialogue: 0,0:12:42.30,0:12:43.63,Default,,0,0,0,,Әй? О
Dialogue: 0,0:12:47.01,0:12:48.55,Default,,0,0,0,,Уау (Басшы) Мофурун-кун
Dialogue: 0,0:12:48.68,0:12:49.64,Default,,0,0,0,,Мофф?
Dialogue: 0,0:12:50.06,0:12:52.06,Default,,0,0,0,,Тас сені таңдаған сияқты
Dialogue: 0,0:12:52.18,0:12:52.98,Default,,0,0,0,,Мофу?
Dialogue: 0,0:12:53.56,0:12:55.06,Default,,0,0,0,,Уау Ахаха Құттықтаймыз! Мофурун
Dialogue: 0,0:12:55.19,0:12:56.69,Default,,0,0,0,,(Шапалақтау дыбысы)
Dialogue: 0,0:12:57.10,0:12:58.23,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:12:58.36,0:13:00.40,Default,,0,0,0,,(Шапалақтау дыбысы)
Dialogue: 0,0:13:00.57,0:13:05.65,Default,,0,0,0,,Олай болса, тасқа тілеу керек. Қалаған нәрсе бар ма?
Dialogue: 0,0:13:05.82,0:13:06.82,Default,,0,0,0,,Мофф жоқ
Dialogue: 0,0:13:07.36,0:13:10.16,Default,,0,0,0,,Сонымен, қайда барғың келеді?
Dialogue: 0,0:13:10.49,0:13:11.62,Default,,0,0,0,,Мофф жоқ
Dialogue: 0,0:13:11.87,0:13:14.75,Default,,0,0,0,,Сонымен, сіз бірдеңе істегіңіз келеді ме?
Dialogue: 0,0:13:15.08,0:13:16.08,Default,,0,0,0,,Мофф жоқ
Dialogue: 0,0:13:16.46,0:13:18.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:18.67,0:13:21.67,Default,,0,0,0,,Тәңірім, сен не тіледің?
Dialogue: 0,0:13:22.05,0:13:25.34,Default,,0,0,0,,Мофурунның Мирай, Рико және Ха-чанға өтініші бар.
Dialogue: 0,0:13:25.51,0:13:28.34,Default,,0,0,0,,Оның орындалуын сұраған Мофф.
Dialogue: 0,0:13:28.51,0:13:29.93,Default,,0,0,0,,Эх!
Dialogue: 0,0:13:30.05,0:13:32.18,Default,,0,0,0,,Не?!
Dialogue: 0,0:13:32.60,0:13:34.27,Default,,0,0,0,,Арнайы өтініш қалдырыңыз...
Dialogue: 0,0:13:34.77,0:13:36.69,Default,,0,0,0,,Басқа біреуге бір нәрсе беру деген нені білдіреді?
Dialogue: 0,0:13:37.31,0:13:39.61,Default,,0,0,0,,Бұл бұрын-соңды болмаған.
Dialogue: 0,0:13:41.86,0:13:45.53,Default,,0,0,0,,Ал... күте тұрыңыз, сізде бірдеңе жоқ па?
Dialogue: 0,0:13:45.69,0:13:48.66,Default,,0,0,0,,Мысалы, көптеген печенье.
Dialogue: 0,0:13:48.78,0:13:52.37,Default,,0,0,0,,Cookie файлдарын Рико және оның достары кез келген уақытта жасайды.
Dialogue: 0,0:13:52.49,0:13:54.75,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:13:54.87,0:13:55.87,Default,,0,0,0,,Мофу?
Dialogue: 0,0:13:56.54,0:14:00.33,Default,,0,0,0,,Мофурун – болашақтың көңілді екеніне қуанатын моф.
Dialogue: 0,0:14:00.46,0:14:03.34,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:14:03.92,0:14:05.01,Default,,0,0,0,,Сәлем Мофурун
Dialogue: 0,0:14:05.13,0:14:05.84,Default,,0,0,0,,Мофф?
Dialogue: 0,0:14:06.34,0:14:08.68,Default,,0,0,0,,Таңдалған адам Мофурун болды.
Dialogue: 0,0:14:08.80,0:14:12.35,Default,,0,0,0,,Мофурунның тілегі орындалмайынша, жұмыс істемейді деп ойлаймын.
Dialogue: 0,0:14:12.81,0:14:14.64,Default,,0,0,0,,Мофу…
Dialogue: 0,0:14:15.27,0:14:18.85,Default,,0,0,0,,Олай болса, менің тілегімді орындаңыз.
Dialogue: 0,0:14:19.23,0:14:20.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:26.19,0:14:26.94,Default,,0,0,0,,Аю?
Dialogue: 0,0:14:27.11,0:14:27.82,Default,,0,0,0,,Бұл аю.
Dialogue: 0,0:14:28.24,0:14:29.24,Default,,0,0,0,,Аю
Dialogue: 0,0:14:30.11,0:14:34.66,Default,,0,0,0,,Жоқ, Акума... да
Dialogue: 0,0:14:35.74,0:14:36.41,Default,,0,0,0,,Хамф!
Dialogue: 0,0:14:44.42,0:14:45.50,Default,,0,0,0,,Не? (Еркек 4) Уау
Dialogue: 0,0:14:45.92,0:14:48.09,Default,,0,0,0,,А, не? Ооо!
Dialogue: 0,0:14:48.22,0:14:49.13,Default,,0,0,0,,Кя (6-ер адам) Сәлем!
Dialogue: 0,0:14:53.55,0:14:56.18,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:14:56.81,0:14:58.10,Default,,0,0,0,,Барлығы эвакуацияланады
Dialogue: 0,0:14:58.39,0:14:59.35,Default,,0,0,0,,Мофу
Dialogue: 0,0:15:02.15,0:15:04.73,Default,,0,0,0,,Күп Лапапа, желді соға
Dialogue: 0,0:15:04.86,0:15:07.11,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:15:07.74,0:15:08.78,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:15:08.90,0:15:10.07,Default,,0,0,0,,Ах ха!
Dialogue: 0,0:15:11.78,0:15:14.12,Default,,0,0,0,,Сіз «Тілек тасы» аласыз
Dialogue: 0,0:15:14.62,0:15:15.45,Default,,0,0,0,,Біз де
Dialogue: 0,0:15:15.58,0:15:16.24,Default,,0,0,0,,Иә
Dialogue: 0,0:15:16.87,0:15:17.75,Default,,0,0,0,,Мофурун!
Dialogue: 0,0:15:17.87,0:15:18.70,Default,,0,0,0,,Мофу
Dialogue: 0,0:15:21.75,0:15:23.21,Default,,0,0,0,,Куап Лапапа
Dialogue: 0,0:15:26.05,0:15:28.55,Default,,0,0,0,,Сиқырлы прекюр
Dialogue: 0,0:15:33.09,0:15:35.89,Default,,0,0,0,,Тааааа!
Dialogue: 0,0:15:37.14,0:15:37.81,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:15:39.06,0:15:40.06,Default,,0,0,0,,Ей ха!
Dialogue: 0,0:15:41.06,0:15:41.73,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:45.15,0:15:45.90,Default,,0,0,0,,Құт
Dialogue: 0,0:15:46.27,0:15:46.94,Default,,0,0,0,,Хех хех хех. Пфу.
Dialogue: 0,0:15:47.07,0:15:47.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:48.32,0:15:49.32,Default,,0,0,0,,Эмили
Dialogue: 0,0:15:50.11,0:15:51.11,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:15:51.32,0:15:52.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:54.49,0:15:57.08,Default,,0,0,0,,Уа... Ха! Ха...
Dialogue: 0,0:15:57.24,0:15:58.12,Default,,0,0,0,,Уваах! Көзім…
Dialogue: 0,0:15:59.08,0:15:59.87,Default,,0,0,0,,Фелис
Dialogue: 0,0:16:00.00,0:16:01.33,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:16:09.51,0:16:11.13,Default,,0,0,0,,Маған тасты беріңіз
Dialogue: 0,0:16:13.01,0:16:15.89,Default,,0,0,0,,Таа! Сен кімсің?
Dialogue: 0,0:16:16.01,0:16:16.68,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:17.35,0:16:18.97,Default,,0,0,0,,Сен тасты не істейсің?
Dialogue: 0,0:16:19.35,0:16:22.85,Default,,0,0,0,,Тұрақты тілекті орындаңыз
Dialogue: 0,0:16:23.27,0:16:26.98,Default,,0,0,0,,Мен қараңғы затпын.
Dialogue: 0,0:16:27.52,0:16:28.44,Default,,0,0,0,,Қалайсыз ба?
Dialogue: 0,0:16:29.27,0:16:34.78,Default,,0,0,0,,Осы әлемнен барлық сиқырлы пайдаланушыларды өшіру.
Dialogue: 0,0:16:37.41,0:16:38.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:38.49,0:16:39.70,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:16:40.37,0:16:41.04,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:42.37,0:16:43.04,Default,,0,0,0,,Уф
Dialogue: 0,0:16:43.16,0:16:45.21,Default,,0,0,0,,Бұл туралы Ах!
Dialogue: 0,0:16:47.25,0:16:48.25,Default,,0,0,0,,Ех… Ах…
Dialogue: 0,0:16:48.75,0:16:50.38,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:16:52.72,0:16:53.38,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:57.05,0:16:57.80,Default,,0,0,0,,Уау
Dialogue: 0,0:17:11.07,0:17:12.23,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:13.07,0:17:13.86,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:13.99,0:17:14.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:15.07,0:17:19.20,Default,,0,0,0,,Керемет А қатты мофу
Dialogue: 0,0:17:19.74,0:17:22.49,Default,,0,0,0,,Оны тас таңдаған...
Dialogue: 0,0:17:23.25,0:17:25.33,Default,,0,0,0,,Керемет...
Dialogue: 0,0:17:25.46,0:17:27.04,Default,,0,0,0,,Оны қолдануға болатын сияқты
Dialogue: 0,0:17:27.17,0:17:28.67,Default,,0,0,0,,Мофу
Dialogue: 0,0:17:28.92,0:17:29.59,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:17:29.75,0:17:30.71,Default,,0,0,0,,Мофурун
Dialogue: 0,0:17:32.34,0:17:33.09,Default,,0,0,0,,Олардың аурасы ұқсас қой, иә? Олар әпкелер ме?
Dialogue: 0,0:17:33.42,0:17:35.05,Default,,0,0,0,,Ахх!
Dialogue: 0,0:17:35.72,0:17:38.34,Default,,0,0,0,,Мен тасты алдым, болды.
Dialogue: 0,0:17:38.59,0:17:39.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:39.39,0:17:40.05,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:17:44.10,0:17:45.68,Default,,0,0,0,,Угаа! (Фелис) Ах!
Dialogue: 0,0:17:50.11,0:17:52.90,Default,,0,0,0,,Бұл батпақта ауа өте аз.
Dialogue: 0,0:17:53.44,0:17:54.90,Default,,0,0,0,,До... Айдаһар?
Dialogue: 0,0:17:55.15,0:17:56.95,Default,,0,0,0,,(Косей) Аа, дұрыс. Шыны мен ауыстыратын киім—
Dialogue: 0,0:17:57.95,0:17:59.07,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:59.62,0:18:01.99,Default,,0,0,0,,Жоқ! Шарда тесік бар...
Dialogue: 0,0:18:07.41,0:18:09.37,Default,,0,0,0,,Мофу!
Dialogue: 0,0:18:12.80,0:18:13.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:13.96,0:18:16.13,Default,,0,0,0,,Мофу!
Dialogue: 0,0:18:16.55,0:18:17.51,Default,,0,0,0,,Мофурун!
Dialogue: 0,0:18:21.89,0:18:23.47,Default,,0,0,0,,Мофурун!
Dialogue: 0,0:18:24.39,0:18:26.39,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:27.27,0:18:31.27,Default,,0,0,0,,Уф, у, у...
Dialogue: 0,0:18:32.44,0:18:33.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:33.23,0:18:34.40,Default,,0,0,0,,Мофу!
Dialogue: 0,0:18:34.53,0:18:36.49,Default,,0,0,0,,Мен мынаны сақтаймын.
Dialogue: 0,0:18:39.61,0:18:40.45,Default,,0,0,0,,Мофурун!
Dialogue: 0,0:18:40.99,0:18:45.16,Default,,0,0,0,,Гуоо... Күзетші!
Dialogue: 0,0:18:46.62,0:18:48.16,Default,,0,0,0,,Мофурун!
Dialogue: 0,0:18:49.83,0:18:50.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:51.42,0:18:52.17,Default,,0,0,0,,Болашақ
Dialogue: 0,0:18:52.46,0:18:53.59,Default,,0,0,0,,Мофурун
Dialogue: 0,0:18:54.84,0:18:57.30,Default,,0,0,0,,Неліктен? Мофурунды тастап кеткендіктен бе?
Dialogue: 0,0:18:57.84,0:19:01.34,Default,,0,0,0,,Мофурун! Мофурун Мофурун
Dialogue: 0,0:19:01.84,0:19:04.85,Default,,0,0,0,,Мофурун!
Dialogue: 0,0:19:19.90,0:19:21.86,Default,,0,0,0,,Мен бәрінің қауіпсіз болғанына қуаныштымын.
Dialogue: 0,0:19:22.03,0:19:22.82,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:22.95,0:19:23.99,Default,,0,0,0,,Мофурун
Dialogue: 0,0:19:24.53,0:19:25.83,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:19:26.45,0:19:31.21,Default,,0,0,0,,Ол кісінің сиқырлы күші бізден әлдеқайда асып түсті.
Dialogue: 0,0:19:31.83,0:19:35.42,Default,,0,0,0,,Сіз сиқыршыны өшіремін дедіңіз.
Dialogue: 0,0:19:36.75,0:19:40.88,Default,,0,0,0,,Қалғанын бізге қалдыр, Мофурун.
Dialogue: 0,0:19:41.68,0:19:42.93,Default,,0,0,0,,Мофурун…
Dialogue: 0,0:19:43.26,0:19:48.35,Default,,0,0,0,,Бірақ осылай бір орында тұра берсең... Не істейсің, Мирай?
Dialogue: 0,0:19:49.22,0:19:51.44,Default,,0,0,0,,Болашақ? Болашақ!
Dialogue: 0,0:19:51.56,0:19:52.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:53.73,0:19:54.73,Default,,0,0,0,,Болашақ
Dialogue: 0,0:19:56.11,0:19:58.57,Default,,0,0,0,,А... мүмкін емес!
Dialogue: 0,0:20:07.66,0:20:13.54,Default,,0,0,0,,Тас, мына зұлым сиқыршыларды осы дүниеден жой.
Dialogue: 0,0:20:21.09,0:20:24.26,Default,,0,0,0,,Қанша талпынсам да баяғы... иә!
Dialogue: 0,0:20:27.60,0:20:29.60,Default,,0,0,0,,Хаа... мофу?
Dialogue: 0,0:20:30.56,0:20:33.56,Default,,0,0,0,,Менің сені пайдаланудан басқа амалым жоқ сияқты.
Dialogue: 0,0:20:33.73,0:20:34.94,Default,,0,0,0,,Морфу!
Dialogue: 0,0:20:36.44,0:20:38.86,Default,,0,0,0,,Мофф қайда? Барлығы қайда?
Dialogue: 0,0:20:38.98,0:20:43.32,Default,,0,0,0,,Жоқ, мен сізге тілегімді орындауға рұқсат етемін.
Dialogue: 0,0:20:43.49,0:20:48.28,Default,,0,0,0,,Мофуу, Ичиго... Маған ұнамайды!
Dialogue: 0,0:20:50.20,0:20:53.37,Default,,0,0,0,,Хамф, бұл көп күш салуды қажет етеді.
Dialogue: 0,0:20:54.79,0:21:00.05,Default,,0,0,0,,Ха ха ха ха... Иә?
Dialogue: 0,0:21:01.55,0:21:02.76,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:06.13,0:21:07.55,Default,,0,0,0,,Мофу!
Dialogue: 0,0:21:09.55,0:21:13.23,Default,,0,0,0,,Ахх, Мофу!
Dialogue: 0,0:21:13.52,0:21:17.15,Default,,0,0,0,,Морфу Ооо! Мо!
Dialogue: 0,0:21:17.98,0:21:19.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:20.32,0:21:22.15,Default,,0,0,0,,Сен барып қарап кел.
Dialogue: 0,0:21:27.24,0:21:28.28,Default,,0,0,0,,Хуха
Dialogue: 0,0:21:30.95,0:21:37.00,Default,,0,0,0,,Уф... Мофу!
Dialogue: 0,0:21:45.01,0:21:46.51,Default,,0,0,0,,Морфу
Dialogue: 0,0:21:47.55,0:21:48.51,Default,,0,0,0,,Хаа
Dialogue: 0,0:21:49.55,0:21:55.31,Default,,0,0,0,,А... иә? Мофф бұл жерде қайда?
Dialogue: 0,0:22:01.52,0:22:02.52,Default,,0,0,0,,(шу)
Dialogue: 0,0:22:02.65,0:22:03.36,Default,,0,0,0,,Мофф?
Dialogue: 0,0:22:05.82,0:22:06.65,Default,,0,0,0,,Мофу
Dialogue: 0,0:22:07.57,0:22:08.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:11.66,0:22:15.04,Default,,0,0,0,,Мофф бар ма? Иә?
Dialogue: 0,0:22:16.96,0:22:18.21,Default,,0,0,0,,Моху!
Dialogue: 0,0:22:19.37,0:22:20.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:23.46,0:22:24.13,Default,,0,0,0,,Аю!
Dialogue: 0,0:22:24.59,0:22:29.68,Default,,0,0,0,,Мофу! Сәлем Мофф, мен қорықпаймын Мофф
Dialogue: 0,0:22:30.18,0:22:30.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:34.72,0:22:35.81,Default,,0,0,0,,Кумар!
Dialogue: 0,0:22:37.06,0:22:40.73,Default,,0,0,0,,Аю аю аю аю аю
Dialogue: 0,0:22:41.23,0:22:46.23,Default,,0,0,0,,Мофуфу Мофуфу көп.
Dialogue: 0,0:22:47.24,0:22:47.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:48.57,0:22:49.40,Default,,0,0,0,,Аю мама Уау!
Dialogue: 0,0:22:50.11,0:22:52.12,Default,,0,0,0,,Рахмет сізге Мофф
Dialogue: 0,0:22:52.57,0:22:59.46,Default,,0,0,0,,Кумар! Кумар Кумар Кумар...
Dialogue: 0,0:22:59.58,0:23:00.75,Default,,0,0,0,,Моху!
Dialogue: 0,0:23:02.29,0:23:03.25,Default,,0,0,0,,♪～
Dialogue: 0,0:23:03.38,0:23:05.88,Default,,0,0,0,,♪Сағат нешеде
Dialogue: 0,0:23:06.21,0:23:09.17,Default,,0,0,0,,♪Мен бұл сиқырды қолдана аламын ба?
Dialogue: 0,0:23:09.47,0:23:13.97,Default,,0,0,0,,♪Ережені айтып беріңізші.
Dialogue: 0,0:23:15.60,0:23:18.23,Default,,0,0,0,,♪Өзім үшін емес
Dialogue: 0,0:23:18.35,0:23:21.44,Default,,0,0,0,,♪Жанымдағы жақындарыма
Dialogue: 0,0:23:21.56,0:23:23.44,Default,,0,0,0,,♪Құпия жолмен
Dialogue: 0,0:23:23.56,0:23:26.57,Default,,0,0,0,,♪Ғажайып жаса
Dialogue: 0,0:23:27.86,0:23:30.15,Default,,0,0,0,,♪Егер біреу жылап жатса
Dialogue: 0,0:23:30.28,0:23:32.99,Default,,0,0,0,,♪Мен істей алатын нәрсе бар ма?
Dialogue: 0,0:23:33.12,0:23:35.28,Default,,0,0,0,,♪ Қолыңызды созыңыз...
Dialogue: 0,0:23:35.41,0:23:36.28,Default,,0,0,0,,♪Енді сабаққа
Dialogue: 0,0:23:36.62,0:23:39.04,Default,,0,0,0,,♪Рапапаны емдеңіз!
Dialogue: 0,0:23:39.16,0:23:42.46,Default,,0,0,0,,♪Мен сені бірден күлдіремін
Dialogue: 0,0:23:42.75,0:23:45.00,Default,,0,0,0,,♪Рапапаны емдеңіз!
Dialogue: 0,0:23:45.42,0:23:48.46,Default,,0,0,0,,♪Сезім сіздің күшіңізге айналады
Dialogue: 0,0:23:49.26,0:23:51.47,Default,,0,0,0,,♪Ғажайып жарықты толқында
Dialogue: 0,0:23:51.72,0:23:53.84,Default,,0,0,0,,♪Мейірімді жүрекпен
Dialogue: 0,0:23:53.97,0:23:57.14,Default,,0,0,0,,♪Маған жайлап қарасаң
Dialogue: 0,0:23:57.26,0:24:00.89,Default,,0,0,0,,♪Мен күлемін
Dialogue: 0,0:24:06.27,0:24:11.28,Default,,0,0,0,,～♪
Dialogue: 0,0:24:24.29,0:24:26.33,Default,,0,0,0,,Хмм Мофу
Dialogue: 0,0:24:26.50,0:24:27.59,Default,,0,0,0,,Иә
Dialogue: 0,0:24:30.59,0:24:32.84,Default,,0,0,0,,Барлығы, не болды, Мофф?
Dialogue: 0,0:24:32.97,0:24:33.68,Default,,0,0,0,,(шу)
Dialogue: 0,0:24:34.68,0:24:35.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:39.68,0:24:40.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:41.22,0:24:43.64,Default,,0,0,0,,Қара аю Мофф
Dialogue: 0,0:24:44.81,0:24:47.36,Default,,0,0,0,,Ах! Аю…
Dialogue: 0,0:24:50.07,0:24:50.73,Default,,0,0,0,,Хмм.
Dialogue: 0,0:24:50.86,0:24:52.78,Default,,0,0,0,,Танысқаныма қуаныштымын Мофф
Dialogue: 0,0:24:52.90,0:24:54.20,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:24:54.65,0:24:56.03,Default,,0,0,0,,Мофурун Мофу!
Dialogue: 0,0:24:57.07,0:24:59.53,Default,,0,0,0,,Мен Куматамын
Dialogue: 0,0:25:05.08,0:25:05.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:08.25,0:25:12.34,Default,,0,0,0,,Мофурун қайда орналасқан? Мофуль... Уау!
Dialogue: 0,0:25:14.76,0:25:16.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:18.01,0:25:20.97,Default,,0,0,0,,А? Рико…
Dialogue: 0,0:25:21.77,0:25:25.19,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:25:25.52,0:25:28.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:30.57,0:25:31.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:32.36,0:25:33.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:35.24,0:25:36.20,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:25:36.32,0:25:36.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:37.74,0:25:40.95,Default,,0,0,0,,Мен сені іздедім, өз бетіммен жүгірдім.
Dialogue: 0,0:25:45.29,0:25:46.16,Default,,0,0,0,,Болашақ?
Dialogue: 0,0:25:46.50,0:25:47.62,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:25:48.17,0:25:50.59,Default,,0,0,0,,Бұл сыпырғыш мұны істемейді.
Dialogue: 0,0:25:52.21,0:25:52.88,Default,,0,0,0,,Бірақ
Dialogue: 0,0:25:53.00,0:25:54.09,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:25:54.26,0:25:54.97,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:25:55.09,0:25:56.09,Default,,0,0,0,,Тынышталыңыз!
Dialogue: 0,0:25:56.51,0:25:57.55,Default,,0,0,0,,Өйткені Мофурун!
Dialogue: 0,0:25:57.97,0:26:00.01,Default,,0,0,0,,Болашақта бірдеңе болса ше?
Dialogue: 0,0:26:00.30,0:26:01.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:03.43,0:26:10.31,Default,,0,0,0,,Дұрыс, Мофурунды алаңдатып отырған жай Мираи ғана емес.
Dialogue: 0,0:26:11.44,0:26:12.11,Default,,0,0,0,,Эй?
Dialogue: 0,0:26:13.86,0:26:14.94,Default,,0,0,0,,Ха-чан
Dialogue: 0,0:26:15.99,0:26:19.61,Default,,0,0,0,,Бәріміз бірге барайық.
Dialogue: 0,0:26:20.32,0:26:21.03,Default,,0,0,0,,Иә
Dialogue: 0,0:26:21.37,0:26:24.66,Default,,0,0,0,,А... иә!
Dialogue: 0,0:26:25.91,0:26:27.08,Default,,0,0,0,,(Риконың асқазаны естіледі)
Dialogue: 0,0:26:27.21,0:26:27.91,Default,,0,0,0,,Ах
Dialogue: 0,0:26:28.25,0:26:31.29,Default,,0,0,0,,Ахаха ахаха…
Dialogue: 0,0:26:31.46,0:26:33.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:26:33.67,0:26:37.13,Default,,0,0,0,,Ойланып қарасам, Мофу ештеңе жеген жоқ...
Dialogue: 0,0:26:39.63,0:26:40.43,Default,,0,0,0,,Біз тамақ ішеміз бе?
Dialogue: 0,0:26:40.72,0:26:46.39,Default,,0,0,0,,Моху! Печенье Мофу Итадакимасу Мофу Ааааан
Dialogue: 0,0:26:48.18,0:26:49.81,Default,,0,0,0,,Дәмді моф
Dialogue: 0,0:26:50.06,0:26:50.94,Default,,0,0,0,,Тағы да бар
Dialogue: 0,0:26:51.06,0:26:54.32,Default,,0,0,0,,Рахмет, Мофф.
Dialogue: 0,0:26:55.15,0:26:56.82,Default,,0,0,0,,Егер бұл сізге ұнаса
Dialogue: 0,0:27:00.32,0:27:01.41,Default,,0,0,0,,Мофу!
Dialogue: 0,0:27:02.32,0:27:04.74,Default,,0,0,0,,Уау! Кяхаха
Dialogue: 0,0:27:05.08,0:27:06.37,Default,,0,0,0,,Қалағаныңызша жеңіз
Dialogue: 0,0:27:06.62,0:27:08.46,Default,,0,0,0,,Мофф Ах...
Dialogue: 0,0:27:09.58,0:27:11.46,Default,,0,0,0,,Бірақ бұл не болды?
Dialogue: 0,0:27:11.58,0:27:17.67,Default,,0,0,0,,Хм, бұл менің сиқырыммен оңай.
Dialogue: 0,0:27:18.17,0:27:22.68,Default,,0,0,0,,Мофф аю болса да сиқырды кім қолдана алады? Сооо мофу!
Dialogue: 0,0:27:23.18,0:27:23.93,Default,,0,0,0,,Не!
Dialogue: 0,0:27:24.51,0:27:28.27,Default,,0,0,0,,Бірақ аюлар барлығын бірге жегісі келді.
Dialogue: 0,0:27:29.56,0:27:32.10,Default,,0,0,0,,Барлығы қайда кетті, Мофу?
Dialogue: 0,0:27:32.52,0:27:35.23,Default,,0,0,0,,Хмм, әдеттегідей.
Dialogue: 0,0:27:40.53,0:27:41.70,Default,,0,0,0,,Хмм.
Dialogue: 0,0:27:42.20,0:27:44.16,Default,,0,0,0,,Эй, сен мұны шынымен жей аласың ба?
Dialogue: 0,0:27:44.28,0:27:44.95,Default,,0,0,0,,Әрине
Dialogue: 0,0:27:45.53,0:27:49.79,Default,,0,0,0,,Бұл құнарлы Янани жемісі, бірақ онша ұқсамайды.
Dialogue: 0,0:27:50.04,0:27:50.75,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:27:50.87,0:27:53.79,Default,,0,0,0,,Әй, бірақ бір нәрседен сақ болу керек.
Dialogue: 0,0:27:53.92,0:27:54.96,Default,,0,0,0,,...Ой!
Dialogue: 0,0:27:55.75,0:27:58.00,Default,,0,0,0,,Хмм... Уау!
Dialogue: 0,0:27:58.42,0:27:59.63,Default,,0,0,0,,Сасық!
Dialogue: 0,0:27:59.76,0:28:01.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:28:01.76,0:28:04.72,Default,,0,0,0,,Ешқашан ішіндегі тұқымдарды тістеуге болмайды.
Dialogue: 0,0:28:04.89,0:28:08.72,Default,,0,0,0,,Ұйқыдағы балаларды оятатын осы күшті иісті таратады.
Dialogue: 0,0:28:08.89,0:28:11.94,Default,,0,0,0,,Аха ахахха Неткен қызық жүз!
Dialogue: 0,0:28:12.06,0:28:13.48,Default,,0,0,0,,Ха-чан!
Dialogue: 0,0:28:14.56,0:28:19.78,Default,,0,0,0,,Аха, сасық, тынығып берші!
Dialogue: 0,0:28:19.90,0:28:25.32,Default,,0,0,0,,Ахаха ахахха...
Dialogue: 0,0:28:25.45,0:28:26.74,Default,,0,0,0,,Ахаха
Dialogue: 0,0:28:27.16,0:28:31.58,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:28:31.70,0:28:35.29,Default,,0,0,0,,Ахаха ахахха...
Dialogue: 0,0:28:35.42,0:28:37.63,Default,,0,0,0,,Екеуіңізге де рахмет.
Dialogue: 0,0:28:40.09,0:28:41.21,Default,,0,0,0,,Сізге жақсы Рико
Dialogue: 0,0:28:41.34,0:28:44.43,Default,,0,0,0,,Уф! О... шынымен емес
Dialogue: 0,0:28:44.93,0:28:45.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:49.14,0:28:49.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:53.23,0:28:54.94,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:28:55.10,0:28:57.06,Default,,0,0,0,,Үй, сен де кел.
Dialogue: 0,0:28:57.19,0:29:00.69,Default,,0,0,0,,Мофу аа аа аа!
Dialogue: 0,0:29:05.66,0:29:07.49,Default,,0,0,0,,Әдемі мофу
Dialogue: 0,0:29:07.62,0:29:08.32,Default,,0,0,0,,О
Dialogue: 0,0:29:08.62,0:29:09.53,Default,,0,0,0,,Мафф!
Dialogue: 0,0:29:09.78,0:29:11.12,Default,,0,0,0,,Сізде әлі бар ма?
Dialogue: 0,0:29:14.46,0:29:15.12,Default,,0,0,0,,Не?
Dialogue: 0,0:29:15.50,0:29:17.38,Default,,0,0,0,,Бірге тамақтанады
Dialogue: 0,0:29:17.71,0:29:18.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:19.50,0:29:23.01,Default,,0,0,0,,Сіз жейсіз, мен оны кез келген уақытта бере аламын.
Dialogue: 0,0:29:23.47,0:29:25.09,Default,,0,0,0,,Бұл дұрыс Мофф
Dialogue: 0,0:29:26.47,0:29:30.39,Default,,0,0,0,,Сен менің сиқырыма қарап, ол туралы ештеңе ойламайсың ба?
Dialogue: 0,0:29:30.51,0:29:32.14,Default,,0,0,0,,Мофф не?
Dialogue: 0,0:29:34.89,0:29:38.61,Default,,0,0,0,,Менің құдіретімді көрген адам қорқып қашады.
Dialogue: 0,0:29:39.90,0:29:41.98,Default,,0,0,0,,Сол аюлар да солай.
Dialogue: 0,0:29:42.90,0:29:46.45,Default,,0,0,0,,Қорқынышты емес Мофф Керемет сиқырлы Мофф
Dialogue: 0,0:29:46.99,0:29:51.33,Default,,0,0,0,,Оның үстіне...Кумата өте мейірімді мофу.
Dialogue: 0,0:29:52.95,0:29:54.95,Default,,0,0,0,,«Нәзік»?
Dialogue: 0,0:29:55.41,0:29:56.29,Default,,0,0,0,,Мофу
Dialogue: 0,0:29:59.88,0:30:01.92,Default,,0,0,0,,Сізге бұл жер ұнай ма?
Dialogue: 0,0:30:02.09,0:30:03.00,Default,,0,0,0,,Мофуфу
Dialogue: 0,0:30:03.42,0:30:07.76,Default,,0,0,0,,Иә, мен де.
Dialogue: 0,0:30:10.18,0:30:15.73,Default,,0,0,0,,Олай болса, осында қалып, басқаларды ұмыт.
Dialogue: 0,0:30:16.68,0:30:17.77,Default,,0,0,0,,Кумата?
Dialogue: 0,0:30:17.89,0:30:21.90,Default,,0,0,0,,Ал менің тілегім...
Dialogue: 0,0:30:23.19,0:30:25.65,Default,,0,0,0,,Ах... Мофф!
Dialogue: 0,0:30:27.70,0:30:29.70,Default,,0,0,0,,Әй, аққан жұлдыз!
Dialogue: 0,0:30:29.86,0:30:30.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:30.70,0:30:31.37,Default,,0,0,0,,(Киришима & Сейро) Хахаха… Шынымен бе? Шынымен бе? Бакуго!
Dialogue: 0,0:30:34.74,0:30:38.92,Default,,0,0,0,,Керемет! сонша көп
Dialogue: 0,0:30:40.04,0:30:41.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:45.88,0:30:50.89,Default,,0,0,0,,♪～
Dialogue: 0,0:30:58.14,0:31:00.73,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:31:01.02,0:31:01.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:02.73,0:31:08.15,Default,,0,0,0,,Менің тілегім Бұл тілек пе, дәлірек айтқанда сезім бе?
Dialogue: 0,0:31:10.70,0:31:13.45,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:31:14.33,0:31:17.20,Default,,0,0,0,,♪Оны біраз уақытқа қалдырыңыз
Dialogue: 0,0:31:17.33,0:31:20.62,Default,,0,0,0,,♪ Төгілген су
Dialogue: 0,0:31:21.25,0:31:22.63,Default,,0,0,0,,♪Мен байқадым
Dialogue: 0,0:31:22.75,0:31:26.25,Default,,0,0,0,,♪Шынайы сезімдер
Dialogue: 0,0:31:28.01,0:31:30.13,Default,,0,0,0,,Тек Мофурунмен...
Dialogue: 0,0:31:30.26,0:31:31.26,Default,,0,0,0,,Тоқта
Dialogue: 0,0:31:31.38,0:31:32.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:32.97,0:31:36.60,Default,,0,0,0,,Мұны тікелей Мофурунға айт.
Dialogue: 0,0:31:37.10,0:31:41.19,Default,,0,0,0,,Рико... Иә!
Dialogue: 0,0:31:44.65,0:31:47.78,Default,,0,0,0,,♪Мейірімді жүрегің
Dialogue: 0,0:31:47.90,0:31:50.65,Default,,0,0,0,,♪Тілектен тыс
Dialogue: 0,0:31:50.78,0:31:54.03,Default,,0,0,0,,♪Әрқашан бар
Dialogue: 0,0:31:54.16,0:31:56.99,Default,,0,0,0,,♪Менің суретім
Dialogue: 0,0:31:57.12,0:32:00.25,Default,,0,0,0,,♪Көңілді және бақытты
Dialogue: 0,0:32:00.37,0:32:03.42,Default,,0,0,0,,♪Эгаоның себебі неде?
Dialogue: 0,0:32:03.54,0:32:09.80,Default,,0,0,0,,♪Себебі сен менің жанымдасың
Dialogue: 0,0:32:09.92,0:32:16.05,Default,,0,0,0,,♪Мен сізге бірден айтқым келеді
Dialogue: 0,0:32:16.18,0:32:21.89,Default,,0,0,0,,♪Мен сені жақсы көретінімді айтқым келеді
Dialogue: 0,0:32:30.65,0:32:35.70,Default,,0,0,0,,～♪
Dialogue: 0,0:32:35.82,0:32:38.24,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:32:38.49,0:32:39.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:40.87,0:32:43.50,Default,,0,0,0,,Ғажайып жарық шары!
Dialogue: 0,0:32:44.71,0:32:46.00,Default,,0,0,0,,Бұл...
Dialogue: 0,0:32:46.58,0:32:47.50,Default,,0,0,0,,Мофурун
Dialogue: 0,0:32:50.67,0:32:51.88,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:32:52.38,0:32:53.80,Default,,0,0,0,,Мофф үйге қайтып келеді
Dialogue: 0,0:32:54.68,0:32:56.84,Default,,0,0,0,,Мен саған осында қалуыңды айттым.
Dialogue: 0,0:32:57.85,0:32:59.01,Default,,0,0,0,,Қайтып кел
Dialogue: 0,0:32:59.56,0:33:02.43,Default,,0,0,0,,Мофурун маңызды нәрсені есіне алды.
Dialogue: 0,0:33:02.56,0:33:05.48,Default,,0,0,0,,Сондықтан кешіріңіз, Мофф.
Dialogue: 0,0:33:07.65,0:33:12.86,Default,,0,0,0,,Сен де, мен де саған мейірімді болдым.
Dialogue: 0,0:33:14.03,0:33:20.95,Default,,0,0,0,,Сен мені таңдамайсың ба?
Dialogue: 0,0:33:22.20,0:33:23.83,Default,,0,0,0,,Ку…Кумата
Dialogue: 0,0:33:26.54,0:33:28.25,Default,,0,0,0,,Мен сені кешірмеймін
Dialogue: 0,0:33:29.21,0:33:34.09,Default,,0,0,0,,Қараңғы материя! Уф... Куматаға не болды, Мофф?
Dialogue: 0,0:33:34.26,0:33:36.88,Default,,0,0,0,,Куматота т.б. басынан жоқ
Dialogue: 0,0:33:37.34,0:33:42.06,Default,,0,0,0,,Мұның бәрі сені пайдалану үшін жасалған ойын.
Dialogue: 0,0:33:42.39,0:33:44.73,Default,,0,0,0,,Міне! Сіз алдадың ба?
Dialogue: 0,0:33:44.85,0:33:48.23,Default,,0,0,0,,Шулы! Басқа амалдар жоқ
Dialogue: 0,0:33:48.40,0:33:52.69,Default,,0,0,0,,Қане, тас тілегім орындалсын.
Dialogue: 0,0:33:53.03,0:33:55.11,Default,,0,0,0,,Мофф мұндайды сұрамайды.
Dialogue: 0,0:33:55.24,0:33:56.74,Default,,0,0,0,,Олай болса, мен сені үйге жібермеймін.
Dialogue: 0,0:33:56.90,0:33:59.41,Default,,0,0,0,,Болашаққа келіп, бізге көмектесетін Мофф
Dialogue: 0,0:33:59.53,0:34:03.66,Default,,0,0,0,,Сонымен не? Менің күшімді көруіңіз керек еді.
Dialogue: 0,0:34:03.79,0:34:05.41,Default,,0,0,0,,Мофу…
Dialogue: 0,0:34:06.08,0:34:06.79,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:34:06.91,0:34:07.58,Default,,0,0,0,,​​О?
Dialogue: 0,0:34:08.04,0:34:12.09,Default,,0,0,0,,Егер сіз осында қалсаңыз, Прекюр-ге тиіспеңіз.
Dialogue: 0,0:34:12.42,0:34:16.34,Default,,0,0,0,,Бірақ егер сіз баруды шешсеңіз...
Dialogue: 0,0:34:16.97,0:34:19.55,Default,,0,0,0,,(Кондуктор) Сен, сол жерде тұр! Ей! Қауіпті!
Dialogue: 0,0:34:20.05,0:34:23.77,Default,,0,0,0,,Мофурун — Мофурун —...
Dialogue: 0,0:34:24.93,0:34:28.02,Default,,0,0,0,,Мофф болашақтың көңілді болатынына қуанады.
Dialogue: 0,0:34:29.19,0:34:31.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:33.36,0:34:34.03,Default,,0,0,0,,Хмм.
Dialogue: 0,0:34:37.44,0:34:39.11,Default,,0,0,0,,Осы жерде шығар
Dialogue: 0,0:34:39.36,0:34:40.62,Default,,0,0,0,,Сіз осындасыз ба? Алдын ала емдеу
Dialogue: 0,0:34:40.74,0:34:41.87,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,0:34:45.12,0:34:49.29,Default,,0,0,0,,Мен қазір оны елемеймін. Үйге тыныш жүр.
Dialogue: 0,0:34:49.67,0:34:50.75,Default,,0,0,0,,Қараңғы материя
Dialogue: 0,0:34:50.88,0:34:52.04,Default,,0,0,0,,Мофурунды қайтару
Dialogue: 0,0:34:52.25,0:34:52.96,Default,,0,0,0,,Иә! Ахх
Dialogue: 0,0:34:53.50,0:34:54.25,Default,,0,0,0,,Рико?
Dialogue: 0,0:34:54.38,0:34:57.26,Default,,0,0,0,,Егер ол осында болса, Мофурун да жақын жерде болуы керек.
Dialogue: 0,0:34:57.55,0:34:58.22,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:34:58.84,0:35:00.51,Default,,0,0,0,,Мен сізге ескерттім.
Dialogue: 0,0:35:01.97,0:35:02.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:35:03.47,0:35:04.97,Default,,0,0,0,,Угаа!
Dialogue: 0,0:35:07.85,0:35:10.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:10.48,0:35:12.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:13.73,0:35:15.98,Default,,0,0,0,,А, солай.
Dialogue: 0,0:35:17.65,0:35:19.03,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:35:19.86,0:35:21.99,Default,,0,0,0,,Хмм, айтыңызшы.
Dialogue: 0,0:35:22.16,0:35:23.49,Default,,0,0,0,,Мофурун сол жерде екені сөзсіз.
Dialogue: 0,0:35:23.62,0:35:25.08,Default,,0,0,0,,Угаа! (Мираи Рико) Ах!
Dialogue: 0,0:35:26.99,0:35:27.75,Default,,0,0,0,,Ei
Dialogue: 0,0:35:35.42,0:35:38.34,Default,,0,0,0,,Маған алдымен осында баруға рұқсат етіңіз.
Dialogue: 0,0:35:38.46,0:35:39.42,Default,,0,0,0,,Фелис
Dialogue: 0,0:35:42.34,0:35:43.14,Default,,0,0,0,,Гуао
Dialogue: 0,0:35:43.76,0:35:44.76,Default,,0,0,0,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,0:35:45.85,0:35:47.60,Default,,0,0,0,,Угаа!
Dialogue: 0,0:35:48.14,0:35:50.85,Default,,0,0,0,,Оны бізге қалдырыңыз. Біз Мофурунды мүмкіндігінше тезірек аламыз ...
Dialogue: 0,0:35:51.02,0:35:51.94,Default,,0,0,0,,Егер қарсы болмасаңыз, жол көрсетейін
Dialogue: 0,0:35:52.06,0:35:52.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:35:55.44,0:35:57.07,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:35:58.90,0:35:59.90,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:36:00.03,0:36:03.70,Default,,0,0,0,,Сонда сен қорқынышты тү көріпсің ғой.
Dialogue: 0,0:36:04.20,0:36:08.70,Default,,0,0,0,,Кюп Рапапа Құлаған жапырақтар, биле!
Dialogue: 0,0:36:09.25,0:36:09.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:10.62,0:36:11.29,Default,,0,0,0,,Арттан да біреу келеді — 12 метрлік класты Титан осы жаққа бет алып келеді.
Dialogue: 0,0:36:11.41,0:36:12.50,Default,,0,0,0,,Енді жүгір!
Dialogue: 0,0:36:12.62,0:36:14.13,Default,,0,0,0,,Болды... Асығыңыз!
Dialogue: 0,0:36:14.25,0:36:15.84,Default,,0,0,0,,Бірақ... Барыңыз!
Dialogue: 0,0:36:15.96,0:36:19.21,Default,,0,0,0,,Күп Рапапа, сыпырғыш, жүр!
Dialogue: 0,0:36:19.67,0:36:22.01,Default,,0,0,0,,Сәлем! Ах! Рико!
Dialogue: 0,0:36:22.51,0:36:24.97,Default,,0,0,0,,Маған айтқыңыз келетін нәрсе бар ма?
Dialogue: 0,0:36:25.47,0:36:26.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:26.89,0:36:28.51,Default,,0,0,0,,Пайдасыз нәрселер
Dialogue: 0,0:36:30.18,0:36:34.85,Default,,0,0,0,,Сіз оны қолданып көрмейінше, оның ысырап екенін білмейсіз.
Dialogue: 0,0:36:38.11,0:36:40.82,Default,,0,0,0,,Рико... уф
Dialogue: 0,0:36:42.40,0:36:43.15,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:36:46.28,0:36:48.95,Default,,0,0,0,,Мофурун, күте тұр!
Dialogue: 0,0:36:59.59,0:37:00.59,Default,,0,0,0,,Мофурун
Dialogue: 0,0:37:00.84,0:37:01.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:02.92,0:37:06.76,Default,,0,0,0,,Мен оны таптым. Үйге барайық.
Dialogue: 0,0:37:08.80,0:37:10.22,Default,,0,0,0,,Қайтып келмейтін Мофф
Dialogue: 0,0:37:10.60,0:37:11.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:12.27,0:37:14.06,Default,,0,0,0,,Мофурун - қайтып келмейтін мофу
Dialogue: 0,0:37:15.19,0:37:17.15,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:37:18.23,0:37:19.94,Default,,0,0,0,,Мен естігенім осы болды.
Dialogue: 0,0:37:21.65,0:37:22.61,Default,,0,0,0,,Қараңғы материя
Dialogue: 0,0:37:22.74,0:37:27.53,Default,,0,0,0,,Түсінсең, үйге тез қайт. Бұл сіз болғыңыз келетін нәрсе.
Dialogue: 0,0:37:30.79,0:37:31.45,Default,,0,0,0,,Рико!
Dialogue: 0,0:37:31.83,0:37:34.08,Default,,0,0,0,,Мофф қорқынышты ештеңе істемейтінін айтты.
Dialogue: 0,0:37:34.21,0:37:36.58,Default,,0,0,0,,Бұл жігіттер ескертуге мән бермеді.
Dialogue: 0,0:37:37.46,0:37:39.29,Default,,0,0,0,,Басқа адам да қазір қасында...
Dialogue: 0,0:37:39.79,0:37:40.88,Default,,0,0,0,,Уф
Dialogue: 0,0:37:41.30,0:37:45.09,Default,,0,0,0,,Соңғы ескерту, үйге қайтыңыз.
Dialogue: 0,0:37:47.64,0:37:48.30,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:37:48.76,0:37:49.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:50.81,0:37:55.64,Default,,0,0,0,,Ей, Мофурун, мен Мофурунды сағындым.
Dialogue: 0,0:37:56.14,0:37:59.81,Default,,0,0,0,,Басым айналып, не істерімді білмей қалдым.
Dialogue: 0,0:38:00.98,0:38:05.24,Default,,0,0,0,,Өзіңізге ұнайтын адамнан бөлек тұрғанда, сіз осылай сезінесіз.
Dialogue: 0,0:38:06.57,0:38:08.61,Default,,0,0,0,,Мен байқадым
Dialogue: 0,0:38:08.74,0:38:09.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:10.83,0:38:12.83,Default,,0,0,0,,Сол кезде Мофурун
Dialogue: 0,0:38:13.41,0:38:16.33,Default,,0,0,0,,Ол біздің көңілді жүргенімізге қуанышты екенін айтты.
Dialogue: 0,0:38:17.79,0:38:21.71,Default,,0,0,0,,Көңіл көтерсем, Мофурун қасымда болатын.
Dialogue: 0,0:38:21.84,0:38:22.63,Default,,0,0,0,,Ах
Dialogue: 0,0:38:22.96,0:38:24.80,Default,,0,0,0,,Өйткені Мофурун сонда болады.
Dialogue: 0,0:38:24.92,0:38:25.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:26.17,0:38:30.93,Default,,0,0,0,,Мен бақыттымын және көңілдімін
Dialogue: 0,0:38:32.72,0:38:34.18,Default,,0,0,0,,Болашақ…
Dialogue: 0,0:38:35.02,0:38:40.94,Default,,0,0,0,,Сонымен Мофурун мен Мофурунмын...
Dialogue: 0,0:38:41.36,0:38:44.86,Default,,0,0,0,,Мофурун шын мәнінде Мираи...
Dialogue: 0,0:38:45.74,0:38:47.28,Default,,0,0,0,,Иә?Ах!
Dialogue: 0,0:38:47.95,0:38:49.86,Default,,0,0,0,,…
Dialogue: 0,0:38:51.70,0:38:52.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:52.49,0:38:53.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:55.58,0:38:56.83,Default,,0,0,0,,Ватари-сан
Dialogue: 0,0:38:57.58,0:38:58.58,Default,,0,0,0,,Мофф...!
Dialogue: 0,0:39:00.04,0:39:01.13,Default,,0,0,0,,Мофурун!
Dialogue: 0,0:39:01.63,0:39:02.50,Default,,0,0,0,,Мирай!
Dialogue: 0,0:39:03.04,0:39:03.88,Default,,0,0,0,,Беріңіз!
Dialogue: 0,0:39:04.38,0:39:05.55,Default,,0,0,0,,Жиренішті!
Dialogue: 0,0:39:05.67,0:39:11.34,Default,,0,0,0,,Мофурун - болашаққа көмектесетін мофу!
Dialogue: 0,0:39:17.73,0:39:19.10,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:39:38.29,0:39:41.29,Default,,0,0,0,,Үлпілдек Мофурун емі Мофурун
Dialogue: 0,0:39:49.34,0:39:50.42,Default,,0,0,0,,Мофурун?
Dialogue: 0,0:39:50.93,0:39:53.59,Default,,0,0,0,,Бұл тастың күші ме?
Dialogue: 0,0:39:54.01,0:39:54.68,Default,,0,0,0,,Ха! (Қара зат) Уф
Dialogue: 0,0:39:56.56,0:39:57.26,Default,,0,0,0,,Моху!
Dialogue: 0,0:39:57.39,0:39:58.43,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,0:40:03.52,0:40:05.19,Default,,0,0,0,,Жарайды, Мофф.
Dialogue: 0,0:40:05.31,0:40:07.07,Default,,0,0,0,,Бұл шынымен де Мофурун ба?
Dialogue: 0,0:40:07.19,0:40:11.53,Default,,0,0,0,,Не туралы айтып тұрсың, Мофф? ...Мофуу енді прекуре болды!
Dialogue: 0,0:40:11.90,0:40:13.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:40:13.16,0:40:14.53,Default,,0,0,0,,Dream Moff?
Dialogue: 0,0:40:14.95,0:40:17.12,Default,,0,0,0,,Бұл арман емес Бұл арман емес Мофф
Dialogue: 0,0:40:18.29,0:40:20.87,Default,,0,0,0,,Мираи Томофу
Dialogue: 0,0:40:22.12,0:40:22.83,Default,,0,0,0,,Иә
Dialogue: 0,0:40:24.21,0:40:28.30,Default,,0,0,0,,Бірге? мұндай нәрсе үшін
Dialogue: 0,0:40:29.42,0:40:30.71,Default,,0,0,0,,Мен сені кешірмеймін!
Dialogue: 0,0:40:34.80,0:40:36.10,Default,,0,0,0,,Оны Моффқа қалдырыңыз
Dialogue: 0,0:40:37.64,0:40:38.81,Default,,0,0,0,,Моху!
Dialogue: 0,0:40:39.22,0:40:41.31,Default,,0,0,0,,Хмф! О!
Dialogue: 0,0:40:44.31,0:40:44.98,Default,,0,0,0,,Мофуу
Dialogue: 0,0:40:46.77,0:40:47.98,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:40:49.32,0:40:53.49,Default,,0,0,0,,Кумата Мофурун - сәл ашулы Мофу.
Dialogue: 0,0:40:53.99,0:40:55.95,Default,,0,0,0,,Иә! Ти
Dialogue: 0,0:40:56.07,0:41:00.04,Default,,0,0,0,,Бұл адам шынымен де маңызды ма?
Dialogue: 0,0:41:01.33,0:41:02.33,Default,,0,0,0,,Маңызды мофу
Dialogue: 0,0:41:03.29,0:41:03.96,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:41:09.13,0:41:09.80,Default,,0,0,0,,Oh?
Dialogue: 0,0:41:10.71,0:41:11.46,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,0:41:12.01,0:41:12.67,Default,,0,0,0,,Эххе
Dialogue: 0,0:41:14.38,0:41:15.63,Default,,0,0,0,,Ах Рико!
Dialogue: 0,0:41:16.34,0:41:17.43,Default,,0,0,0,,Хмм, аа!
Dialogue: 0,0:41:19.47,0:41:20.14,Default,,0,0,0,,(Абдул) Жарайды, міне, Калькутта. Жолға шығайық.
Dialogue: 0,0:41:20.43,0:41:21.10,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:41:23.18,0:41:26.44,Default,,0,0,0,,Мофурун да түсінді, Мофу!
Dialogue: 0,0:41:27.98,0:41:29.19,Default,,0,0,0,,Мофу!
Dialogue: 0,0:41:29.73,0:41:31.61,Default,,0,0,0,,Не?
Dialogue: 0,0:41:31.73,0:41:35.70,Default,,0,0,0,,Болашақ қызық болса, Мофурун да қуанады.
Dialogue: 0,0:41:35.82,0:41:39.53,Default,,0,0,0,,Жаныңыздан болашақтың күлкісін көру
Dialogue: 0,0:41:40.16,0:41:43.00,Default,,0,0,0,,Мофу, өйткені сіз оны көре аласыз!
Dialogue: 0,0:41:43.87,0:41:44.54,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:41:47.46,0:41:51.50,Default,,0,0,0,,Оян, Рико! А... не істеуім керек?
Dialogue: 0,0:41:52.71,0:41:54.38,Default,,0,0,0,,А... мынау!
Dialogue: 0,0:41:59.80,0:42:01.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:42:02.39,0:42:03.39,Default,,0,0,0,,Мен сол Одақтың әрбір сорлысының миын шағып тастаймын!
Dialogue: 0,0:42:04.89,0:42:05.94,Default,,0,0,0,,Мофф!
Dialogue: 0,0:42:14.78,0:42:16.32,Default,,0,0,0,,Даа!
Dialogue: 0,0:42:16.90,0:42:18.32,Default,,0,0,0,,Буха!
Dialogue: 0,0:42:23.24,0:42:24.08,Default,,0,0,0,,Қайда!
Dialogue: 0,0:42:25.83,0:42:27.75,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:42:28.79,0:42:30.17,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:42:30.29,0:42:33.96,Default,,0,0,0,,Ятта! Рико Эхехе Ахахха...
Dialogue: 0,0:42:34.09,0:42:35.26,Default,,0,0,0,,Уау! Ахахха...
Dialogue: 0,0:42:35.92,0:42:37.01,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:42:37.72,0:42:38.59,Default,,0,0,0,,Осымен
Dialogue: 0,0:42:38.76,0:42:39.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:40.76,0:42:41.60,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:42:43.93,0:42:45.18,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:42:45.85,0:42:46.93,Default,,0,0,0,,Фелис!
Dialogue: 0,0:42:51.06,0:42:51.94,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:42:52.31,0:42:53.61,Default,,0,0,0,,Мофу!
Dialogue: 0,0:42:59.41,0:43:02.91,Default,,0,0,0,,Жоқ! Ааааааа!
Dialogue: 0,0:43:15.38,0:43:16.46,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:43:16.63,0:43:19.26,Default,,0,0,0,,Бұл сиқырлы цирктен келген бала ма?
Dialogue: 0,0:43:19.38,0:43:20.05,Default,,0,0,0,,Иә
Dialogue: 0,0:43:20.59,0:43:22.97,Default,,0,0,0,,Қара айдаһар осы бала еді.
Dialogue: 0,0:43:23.47,0:43:25.01,Default,,0,0,0,,Не?!
Dialogue: 0,0:43:27.98,0:43:30.44,Default,,0,0,0,,Угаа! Ааа
Dialogue: 0,0:43:30.73,0:43:31.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:43:38.07,0:43:40.11,Default,,0,0,0,,Ах! Сіз...
Dialogue: 0,0:43:40.49,0:43:42.16,Default,,0,0,0,,Ууууу...
Dialogue: 0,0:43:44.58,0:43:46.16,Default,,0,0,0,,Угаааааааааааааааааааааааааааааа
Dialogue: 0,0:43:46.66,0:43:48.37,Default,,0,0,0,,Ха! Уф...
Dialogue: 0,0:43:50.08,0:43:52.50,Default,,0,0,0,,Әжімді қызғылт турмалин
Dialogue: 0,0:43:56.38,0:43:58.76,Default,,0,0,0,,Арх!
Dialogue: 0,0:44:01.01,0:44:03.43,Default,,0,0,0,,Угах!
Dialogue: 0,0:44:06.68,0:44:07.89,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:44:09.18,0:44:10.60,Default,,0,0,0,,Угао
Dialogue: 0,0:44:12.73,0:44:14.02,Default,,0,0,0,,...Мынаны білдіретін.
Dialogue: 0,0:44:14.40,0:44:16.44,Default,,0,0,0,,Әй, дұрыс.
Dialogue: 0,0:44:17.44,0:44:19.90,Default,,0,0,0,,Иә? Жоқ... дәлірек айтсақ, ол бала кім?
Dialogue: 0,0:44:20.03,0:44:20.86,Default,,0,0,0,,Бұл Мофурун.
Dialogue: 0,0:44:20.99,0:44:21.70,Default,,0,0,0,,Мофф!
Dialogue: 0,0:44:21.86,0:44:22.53,Default,,0,0,0,,Не?!
Dialogue: 0,0:44:23.16,0:44:24.78,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:44:25.41,0:44:27.20,Default,,0,0,0,,Тас қуатын өшіру
Dialogue: 0,0:44:27.58,0:44:31.46,Default,,0,0,0,,«Тілек тасы» Моффқа бірге болу күшін берді.
Dialogue: 0,0:44:31.87,0:44:36.04,Default,,0,0,0,,Мен түсінбеймін, бірақ дұрыс жеткізген шығарсыз.
Dialogue: 0,0:44:36.17,0:44:39.13,Default,,0,0,0,,Иә, рахмет Рико.
Dialogue: 0,0:44:39.38,0:44:40.26,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:44:41.55,0:44:42.55,Default,,0,0,0,,Бірге?
Dialogue: 0,0:44:42.68,0:44:43.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:45.59,0:44:46.80,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:44:47.14,0:44:48.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:48.85,0:44:52.68,Default,,0,0,0,,Мен саған соны тілеймін.
Dialogue: 0,0:44:54.69,0:44:58.73,Default,,0,0,0,,Мен өлтіремін!
Dialogue: 0,0:45:04.74,0:45:05.70,Default,,0,0,0,,(Рей) Уф~ Нұсқауларды мінсіз орындадым
Dialogue: 0,0:45:08.03,0:45:09.58,Default,,0,0,0,,Тоқта, Мофф! Уф...
Dialogue: 0,0:45:10.24,0:45:11.20,Default,,0,0,0,,Мофурун!
Dialogue: 0,0:45:12.04,0:45:16.92,Default,,0,0,0,,Болашақты Мофурун қорғайды. Мофф барлығы бірге үйге барады.
Dialogue: 0,0:45:17.25,0:45:18.75,Default,,0,0,0,,Маған барлығы керек емес
Dialogue: 0,0:45:24.76,0:45:27.64,Default,,0,0,0,,«Тілек тасы» әлдеқашан жоғалып кеткен.
Dialogue: 0,0:45:28.64,0:45:35.23,Default,,0,0,0,,Сонда мен ең болмағанда бар күшімді пайдаланып, бәрін бүлдіремін.
Dialogue: 0,0:45:35.81,0:45:37.60,Default,,0,0,0,,Неліктен Мофф?
Dialogue: 0,0:45:38.98,0:45:41.94,Default,,0,0,0,,Нені сонша жек көресің?
Dialogue: 0,0:45:42.61,0:45:44.78,Default,,0,0,0,,Сіз түсінбейсіз
Dialogue: 0,0:45:45.28,0:45:50.37,Default,,0,0,0,,Бәрі бас тартқан, жалғыз өмір сүрген мен туралы.
Dialogue: 0,0:45:53.66,0:45:57.33,Default,,0,0,0,,Неліктен менде мұндай күш бар?
Dialogue: 0,0:45:58.54,0:46:02.63,Default,,0,0,0,,Мен де білмеймін, бірақ...
Dialogue: 0,0:46:13.64,0:46:15.31,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:46:28.86,0:46:30.45,Default,,0,0,0,,Неге қашу керек?
Dialogue: 0,0:46:32.70,0:46:34.33,Default,,0,0,0,,Неліктен қорқу керек?
Dialogue: 0,0:46:35.75,0:46:41.34,Default,,0,0,0,,Мен не істедім?
Dialogue: 0,0:46:45.88,0:46:51.35,Default,,0,0,0,,«Қараңғы материя, ежелгі дәуірде туылған қорқынышты тіршілік»
Dialogue: 0,0:46:51.68,0:46:55.68,Default,,0,0,0,,«Бірақ біз мұны білмей тұрып, зұлым аю жоғалып кетті».
Dialogue: 0,0:46:56.64,0:46:58.23,Default,,0,0,0,,Акума... иә?
Dialogue: 0,0:46:59.35,0:47:01.19,Default,,0,0,0,,Сізге де солай.
Dialogue: 0,0:47:01.36,0:47:05.69,Default,,0,0,0,,Ақырында олар менен қорқып, мені таңдады.
Dialogue: 0,0:47:05.86,0:47:06.53,Default,,0,0,0,,Мофф?
Dialogue: 0,0:47:07.24,0:47:08.78,Default,,0,0,0,,Мұнда мәңгі қал
Dialogue: 0,0:47:09.20,0:47:10.07,Default,,0,0,0,,Мофф!
Dialogue: 0,0:47:10.70,0:47:16.87,Default,,0,0,0,,Болды, жалғызбын, жалғыз қалдым!
Dialogue: 0,0:47:17.79,0:47:21.67,Default,,0,0,0,,Менің құдіретімді көрген адам қорқып қашады.
Dialogue: 0,0:47:23.09,0:47:24.29,Default,,0,0,0,,Кумато…
Dialogue: 0,0:47:25.21,0:47:26.59,Default,,0,0,0,,Кешіріңіз, Мофф
Dialogue: 0,0:47:27.21,0:47:29.88,Default,,0,0,0,,Балалар, қалай батылы барсыңдар!
Dialogue: 0,0:47:31.26,0:47:33.22,Default,,0,0,0,,Жалғыз Мофф?
Dialogue: 0,0:47:33.51,0:47:36.39,Default,,0,0,0,,Мен сені жек көремін!
Dialogue: 0,0:47:36.77,0:47:37.56,Default,,0,0,0,,Құматар!
Dialogue: 0,0:47:47.44,0:47:48.24,Default,,0,0,0,,Уау
Dialogue: 0,0:47:50.99,0:47:55.49,Default,,0,0,0,,Мофурун! Ха ха ха ха ха... Мофурун! Ах!
Dialogue: 0,0:48:02.92,0:48:06.67,Default,,0,0,0,,Мираи Мофурун ше? Болашақ?
Dialogue: 0,0:48:07.88,0:48:13.43,Default,,0,0,0,,Мофурун, не болды? Эй Мофурун?
Dialogue: 0,0:48:14.47,0:48:19.22,Default,,0,0,0,,Қазір бұл не? неге ештеңе айтпайсың?
Dialogue: 0,0:48:20.14,0:48:25.06,Default,,0,0,0,,Мофурун енді ешқандай күш сезбейді...
Dialogue: 0,0:48:25.48,0:48:26.77,Default,,0,0,0,,Міне!
Dialogue: 0,0:48:27.36,0:48:28.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:30.15,0:48:35.32,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:48:42.75,0:48:46.79,Default,,0,0,0,,Ухаха хахаха ақымақ!
Dialogue: 0,0:48:46.96,0:48:50.59,Default,,0,0,0,,Егер менде солай болса, біз бірге ештеңе істей алмаймыз.
Dialogue: 0,0:48:51.34,0:48:53.18,Default,,0,0,0,,Сіз! Ах...
Dialogue: 0,0:48:54.43,0:48:55.68,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:48:56.51,0:48:57.30,Default,,0,0,0,,Не?
Dialogue: 0,0:48:58.06,0:49:01.31,Default,,0,0,0,,Өйткені сен де...
Dialogue: 0,0:49:02.52,0:49:06.73,Default,,0,0,0,,А? Апыр-ай! Бұл не?
Dialogue: 0,0:49:06.86,0:49:09.15,Default,,0,0,0,,Неліктен? Неліктен?
Dialogue: 0,0:49:10.48,0:49:17.28,Default,,0,0,0,,Түсіндім, сен де Мофурунмен бірге болғың келді.
Dialogue: 0,0:49:18.33,0:49:22.00,Default,,0,0,0,,Уф! Ақымақ, мен оны пайдаландым...
Dialogue: 0,0:49:22.50,0:49:27.79,Default,,0,0,0,,Егер бұл шынымен де солай болса, оны әлгі бала сияқты сиқырмен басқару керек.
Dialogue: 0,0:49:28.17,0:49:29.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:30.84,0:49:36.22,Default,,0,0,0,,Сіз мұны істей алмадыңыз. Сіздің шынайы тілегіңіз...
Dialogue: 0,0:49:40.76,0:49:41.89,Default,,0,0,0,,Қалайсыз ба?
Dialogue: 0,0:49:44.35,0:49:47.65,Default,,0,0,0,,Түсіндім, мен...
Dialogue: 0,0:49:48.61,0:49:49.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:50.36,0:49:52.36,Default,,0,0,0,,Мофф бірге тамақтануға
Dialogue: 0,0:49:55.20,0:49:59.20,Default,,0,0,0,,Мен не істеп жатырмын...
Dialogue: 0,0:50:01.33,0:50:02.58,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:50:03.91,0:50:08.92,Default,,0,0,0,,(Куматаның айқайы)
Dialogue: 0,0:50:35.86,0:50:37.40,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:50:38.03,0:50:38.99,Default,,0,0,0,,Міне!
Dialogue: 0,0:50:46.12,0:50:49.08,Default,,0,0,0,,Мофурун! Болашақ!
Dialogue: 0,0:50:49.25,0:50:51.08,Default,,0,0,0,,Күте тұрыңыз, бірдеңе дұрыс емес.
Dialogue: 0,0:50:51.25,0:50:53.25,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:51:01.93,0:51:05.85,Default,,0,0,0,,Бұл да қараңғы материяның күші ме?
Dialogue: 0,0:51:10.60,0:51:11.27,Default,,0,0,0,,Ха!
Dialogue: 0,0:51:13.61,0:51:14.86,Default,,0,0,0,,Бұл күш...
Dialogue: 0,0:51:15.90,0:51:16.57,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:51:16.69,0:51:17.61,Default,,0,0,0,,Ха-чан
Dialogue: 0,0:51:19.20,0:51:20.95,Default,,0,0,0,,Сиқыр жойылды
Dialogue: 0,0:51:21.49,0:51:23.83,Default,,0,0,0,,Мен тәртіпсіздік жасаймын
Dialogue: 0,0:51:24.53,0:51:25.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:25.83,0:51:27.54,Default,,0,0,0,,Уау
Dialogue: 0,0:51:27.66,0:51:28.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:28.91,0:51:29.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:29.75,0:51:30.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:31.42,0:51:33.46,Default,,0,0,0,,Шардың ішіндегі барлығы
Dialogue: 0,0:51:33.79,0:51:36.05,Default,,0,0,0,,Біздің сиқырымыз енді жоқ...
Dialogue: 0,0:51:36.17,0:51:38.63,Default,,0,0,0,,Директор: Бұл қиын!
Dialogue: 0,0:51:39.47,0:51:40.30,Default,,0,0,0,,Не!
Dialogue: 0,0:51:43.97,0:51:44.97,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:51:45.43,0:51:47.47,Default,,0,0,0,,Міне, фестиваль өтетін орын
Dialogue: 0,0:51:49.14,0:51:52.27,Default,,0,0,0,,Тез тоқта! Бұл сенің сиқырың, солай ма?
Dialogue: 0,0:51:52.40,0:51:53.31,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:51:53.48,0:51:54.40,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:51:55.15,0:51:56.32,Default,,0,0,0,,Мен оны өшіре алмаймын.
Dialogue: 0,0:51:57.11,0:52:00.07,Default,,0,0,0,,Оның үстіне менің күшім қазірдің өзінде
Dialogue: 0,0:52:00.45,0:52:03.41,Default,,0,0,0,,Сол жігіт болған соң бәрі жоғалып кеткен сияқты.
Dialogue: 0,0:52:04.57,0:52:09.50,Default,,0,0,0,,Сол... Осылай жалғаса берсе, сиқырлы дүние...
Dialogue: 0,0:52:15.59,0:52:16.84,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:52:23.76,0:52:25.18,Default,,0,0,0,,Куап Рапапа
Dialogue: 0,0:52:26.56,0:52:27.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:52:28.01,0:52:30.35,Default,,0,0,0,,Сиқыр, тоқта!
Dialogue: 0,0:52:31.56,0:52:32.52,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:52:32.64,0:52:33.85,Default,,0,0,0,,Куап Рапапа
Dialogue: 0,0:52:34.35,0:52:35.19,Default,,0,0,0,,Болашақ?
Dialogue: 0,0:52:35.36,0:52:40.19,Default,,0,0,0,,Сиқыр, тоқта! Лапапа емдеу
Dialogue: 0,0:52:41.11,0:52:43.53,Default,,0,0,0,,Сиқыр, тоқта!
Dialogue: 0,0:52:44.78,0:52:45.82,Default,,0,0,0,,Мираи-кун
Dialogue: 0,0:52:46.49,0:52:51.04,Default,,0,0,0,,Мұндай сиқырмен енді ештеңе істеудің қажеті жоқ.
Dialogue: 0,0:52:51.20,0:52:52.21,Default,,0,0,0,,Бұл ысырап емес!
Dialogue: 0,0:52:52.33,0:52:53.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:53.71,0:52:57.46,Default,,0,0,0,,«Бұл жерден бас тартуға болмайды», - дейді Мофурун.
Dialogue: 0,0:52:58.13,0:52:59.75,Default,,0,0,0,,Ақымақ, ол жігіт қазірдің өзінде...
Dialogue: 0,0:52:59.88,0:53:04.76,Default,,0,0,0,,Мен мұндамын, мен әлі сенімен біргемін.
Dialogue: 0,0:53:05.59,0:53:07.97,Default,,0,0,0,,Сондықтан берілме!
Dialogue: 0,0:53:08.10,0:53:08.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:09.85,0:53:13.98,Default,,0,0,0,,Мираймен алғаш танысқан кезім есімде.
Dialogue: 0,0:53:14.10,0:53:14.98,Default,,0,0,0,,Рико!
Dialogue: 0,0:53:15.73,0:53:20.57,Default,,0,0,0,,Сонда да Мофурун сөйлей алмады, мен сиқырдан жаманмын.
Dialogue: 0,0:53:20.73,0:53:24.86,Default,,0,0,0,,Және күткендей, Мираи оң болды.
Dialogue: 0,0:53:25.78,0:53:29.87,Default,,0,0,0,,Сонда мүмкін тағы бір керемет болады.
Dialogue: 0,0:53:30.33,0:53:31.24,Default,,0,0,0,,Рико…
Dialogue: 0,0:53:31.95,0:53:33.62,Default,,0,0,0,,Қазір мен де сондамын
Dialogue: 0,0:53:33.91,0:53:35.17,Default,,0,0,0,,Ха-чан
Dialogue: 0,0:53:39.92,0:53:44.59,Default,,0,0,0,,Кюп Рапапа Сиқыры, тоқта!
Dialogue: 0,0:53:45.30,0:53:50.01,Default,,0,0,0,,Kyup Rapapa Magic, тоқта!
Dialogue: 0,0:53:52.43,0:53:53.85,Default,,0,0,0,,Енді бәрі бітті
Dialogue: 0,0:53:53.98,0:53:55.35,Default,,0,0,0,,Ештеңе істеу мүмкін емес
Dialogue: 0,0:53:55.77,0:53:57.44,Default,,0,0,0,,Мен мұны осында шеше аламын.
Dialogue: 0,0:53:58.19,0:53:58.86,Default,,0,0,0,,Иә? (Директордың орынбасары) А...
Dialogue: 0,0:53:59.52,0:54:00.48,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:54:00.61,0:54:03.11,Default,,0,0,0,,Әлі де төбелесіп жатқандар бар
Dialogue: 0,0:54:03.78,0:54:09.32,Default,,0,0,0,,Барлығы, тек үміттеніңіз! бізде әлі де сезім бар
Dialogue: 0,0:54:10.87,0:54:12.45,Default,,0,0,0,,Кумапу Кумама
Dialogue: 0,0:54:12.91,0:54:14.62,Default,,0,0,0,,Кумапу Кумама
Dialogue: 0,0:54:19.17,0:54:23.63,Default,,0,0,0,,Kyup Rapapa Magic, тоқта!
Dialogue: 0,0:54:24.63,0:54:25.34,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:54:26.42,0:54:28.26,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:54:30.35,0:54:34.31,Default,,0,0,0,,Әй, бірдеңе айт!
Dialogue: 0,0:54:35.48,0:54:36.14,Default,,0,0,0,,Кубок…
Dialogue: 0,0:54:36.27,0:54:37.52,Default,,0,0,0,,Куап Рапапа
Dialogue: 0,0:54:37.64,0:54:38.73,Default,,0,0,0,,Әй?
Dialogue: 0,0:54:39.52,0:54:42.44,Default,,0,0,0,,Менің сиқырым, тоқта!
Dialogue: 0,0:54:43.32,0:54:47.99,Default,,0,0,0,,Күп Лапапа, тоқта!
Dialogue: 0,0:54:48.15,0:54:48.99,Default,,0,0,0,,Иә
Dialogue: 0,0:54:49.66,0:54:51.32,Default,,0,0,0,,Куап Рапапа
Dialogue: 0,0:54:51.70,0:54:58.50,Default,,0,0,0,,Сиқыр, тоқта!
Dialogue: 0,0:55:06.67,0:55:08.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:09.30,0:55:13.22,Default,,0,0,0,,Бұл ғажайып жарық шары ма?
Dialogue: 0,0:55:14.85,0:55:16.85,Default,,0,0,0,,(Абдул) Ағаңды еске алу үшін шайқас өткізуге ниеттенесің бе?
Dialogue: 0,0:55:17.35,0:55:18.35,Default,,0,0,0,,Бұл тілек
Dialogue: 0,0:55:18.52,0:55:19.19,Default,,0,0,0,,Ах
Dialogue: 0,0:55:19.89,0:55:24.11,Default,,0,0,0,,Мен көптеген тілектерді сезінемін
Dialogue: 0,0:55:27.07,0:55:30.78,Default,,0,0,0,,Қандай жылы жарық...
Dialogue: 0,0:55:38.54,0:55:39.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:40.33,0:55:41.29,Default,,0,0,0,,Бұл...
Dialogue: 0,0:55:42.21,0:55:43.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:49.92,0:55:50.88,Default,,0,0,0,,Мофуфу
Dialogue: 0,0:55:51.55,0:55:52.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:53.39,0:55:57.89,Default,,0,0,0,,Мофудың иісі өте тәтті
Dialogue: 0,0:55:59.56,0:56:02.44,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:56:02.98,0:56:04.81,Default,,0,0,0,,Мофурун! Моху!
Dialogue: 0,0:56:05.94,0:56:08.15,Default,,0,0,0,,Бұл Прекюр
Dialogue: 0,0:56:09.86,0:56:14.62,Default,,0,0,0,,Куматаның дауысын естіген Кумата Моф
Dialogue: 0,0:56:14.87,0:56:17.24,Default,,0,0,0,,Сіз мені кешіресіз бе? мен...
Dialogue: 0,0:56:17.37,0:56:23.00,Default,,0,0,0,,Әрине Мофуку Кумата мен Мофурун Моффтың достары!
Dialogue: 0,0:56:23.50,0:56:28.21,Default,,0,0,0,,Рахмет сізге Мофурун
Dialogue: 0,0:56:35.64,0:56:38.56,Default,,0,0,0,,Екі емнің кереметі
Dialogue: 0,0:56:39.02,0:56:42.27,Default,,0,0,0,,Екі адамның сиқыры Сиқырлы ем
Dialogue: 0,0:56:42.89,0:56:47.11,Default,,0,0,0,,Бүкіл өмірге бата Фелиске ем
Dialogue: 0,0:56:47.82,0:56:50.74,Default,,0,0,0,,Үлпілдек Мофурун емі Мофурун
Dialogue: 0,0:56:51.69,0:56:53.91,Default,,0,0,0,,Сиқырлы прекюр
Dialogue: 0,0:57:00.12,0:57:01.29,Default,,0,0,0,,О (директордың орынбасары) Міне!
Dialogue: 0,0:57:01.75,0:57:02.50,Default,,0,0,0,,Прекюр?
Dialogue: 0,0:57:02.62,0:57:03.75,Default,,0,0,0,,Прекюр
Dialogue: 0,0:57:11.80,0:57:12.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:57:14.97,0:57:15.80,Default,,0,0,0,,Рахмет
Dialogue: 0,0:57:15.93,0:57:16.85,Default,,0,0,0,,«Пендлтон отбасының жалғыз қызы Элина үйленеді!»
Dialogue: 0,0:57:20.72,0:57:23.06,Default,,0,0,0,,Бірақ бұл туралы не істеуім керек?
Dialogue: 0,0:57:23.64,0:57:25.81,Default,,0,0,0,,Мен тәртіпсіздік жасаймын
Dialogue: 0,0:57:26.48,0:57:27.98,Default,,0,0,0,,Ішінде не бар?
Dialogue: 0,0:57:28.15,0:57:30.28,Default,,0,0,0,,Сиқырдың орталығы шығар.
Dialogue: 0,0:57:30.40,0:57:31.65,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:57:31.78,0:57:32.49,Default,,0,0,0,,Иә
Dialogue: 0,0:57:34.65,0:57:35.82,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:57:36.36,0:57:39.28,Default,,0,0,0,,Уф... хааа!
Dialogue: 0,0:57:46.12,0:57:50.50,Default,,0,0,0,,Міне, бұл менің сиқырым
Dialogue: 0,0:57:51.75,0:57:57.14,Default,,0,0,0,,Менің көлеңкем бұрмаланған тілектен туған
Dialogue: 0,0:57:59.01,0:58:00.47,Default,,0,0,0,,Уф... аааа
Dialogue: 0,0:58:01.51,0:58:02.89,Default,,0,0,0,,Қалғанын маған қалдырыңыз
Dialogue: 0,0:58:03.68,0:58:06.73,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:58:13.74,0:58:15.86,Default,,0,0,0,,Әжім! ай тасы
Dialogue: 0,0:58:20.87,0:58:22.91,Default,,0,0,0,,Әжім! аметист
Dialogue: 0,0:58:23.83,0:58:25.50,Default,,0,0,0,,Иә! аа!
Dialogue: 0,0:58:25.62,0:58:26.46,Default,,0,0,0,,Мофф
Dialogue: 0,0:58:38.76,0:58:39.80,Default,,0,0,0,,О!
Dialogue: 0,0:58:41.72,0:58:42.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:58:47.94,0:58:48.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:58:51.23,0:58:52.23,Default,,0,0,0,,Мофу!
Dialogue: 0,0:58:57.57,0:58:59.41,Default,,0,0,0,,Уф! Кя!
Dialogue: 0,0:59:00.20,0:59:00.91,Default,,0,0,0,,Мофурун
Dialogue: 0,0:59:01.07,0:59:01.82,Default,,0,0,0,,Мофф!
Dialogue: 0,0:59:12.09,0:59:14.17,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:59:16.71,0:59:17.38,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:59:20.01,0:59:21.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:59:21.72,0:59:22.93,Default,,0,0,0,,Жақсысың ба, Мофу?
Dialogue: 0,0:59:25.93,0:59:26.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:59:36.07,0:59:40.53,Default,,0,0,0,,Мен сені жек көремін, мен сені шатастырып аламын.
Dialogue: 0,0:59:41.61,0:59:45.41,Default,,0,0,0,,Ал сендер ше, балалар!
Dialogue: 0,0:59:49.71,0:59:51.54,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:59:51.96,0:59:57.34,Default,,0,0,0,,Сәттілік! Алдын ала!
Dialogue: 0,0:59:58.17,1:00:00.30,Default,,0,0,0,,Дааааа!
Dialogue: 0,1:00:06.47,1:00:07.47,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:00:07.97,1:00:09.10,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,1:00:14.27,1:00:14.98,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,1:00:20.90,1:00:22.66,Default,,0,0,0,,Сәттілік Прекюр!
Dialogue: 0,1:00:23.11,1:00:24.49,Default,,0,0,0,,Негізгі
Dialogue: 0,1:00:24.62,1:00:26.41,Default,,0,0,0,,Барлығың дауысыңды көтеріңдер
Dialogue: 0,1:00:27.24,1:00:33.37,Default,,0,0,0,,Тілектеріңді сөзбен айт, Сөз сиқырға айналады, Сиқыр ғажайып әкеледі.
Dialogue: 0,1:00:33.83,1:00:35.50,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:00:35.79,1:00:37.46,Default,,0,0,0,,Алдын ала!
Dialogue: 0,1:00:37.59,1:00:39.42,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:00:39.80,1:00:43.34,Default,,0,0,0,,Прекюр Сәттілік!
Dialogue: 0,1:00:43.84,1:00:46.80,Default,,0,0,0,,Прекюр!
Dialogue: 0,1:00:49.85,1:00:55.15,Default,,0,0,0,,Тәтті иіс Мофф Өте тәтті иіс Мофф
Dialogue: 0,1:00:59.86,1:01:00.65,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:01:00.78,1:01:01.69,Default,,0,0,0,,Иә, Мофф.
Dialogue: 0,1:01:03.24,1:01:05.03,Default,,0,0,0,,Әр адамның қалауы...
Dialogue: 0,1:01:07.12,1:01:08.62,Default,,0,0,0,,Кездесу кереметі...
Dialogue: 0,1:01:09.62,1:01:11.33,Default,,0,0,0,,Бірін-бірі тартатын сиқыр...
Dialogue: 0,1:01:12.50,1:01:14.79,Default,,0,0,0,,Бақыт сол жерден айналды!
Dialogue: 0,1:01:15.92,1:01:17.67,Default,,0,0,0,,Мофф ешқашан берілмейді!
Dialogue: 0,1:01:18.04,1:01:18.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:19.09,1:01:21.17,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:01:21.51,1:01:24.84,Default,,0,0,0,,Толық толық Толық Толық әжім
Dialogue: 0,1:01:26.89,1:01:31.72,Default,,0,0,0,,Прекюр Heartful Rainbow!
Dialogue: 0,1:01:34.85,1:01:38.69,Default,,0,0,0,,Кюп Лапапа Кемпірқосақтың арғы жағында
Dialogue: 0,1:01:39.15,1:01:43.19,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,1:01:47.66,1:01:52.66,Default,,0,0,0,,～♪
Dialogue: 0,1:01:55.75,1:01:57.54,Default,,0,0,0,,(Студент дауыстары)
Dialogue: 0,1:01:57.67,1:01:59.09,Default,,0,0,0,,А, не?
Dialogue: 0,1:01:59.21,1:02:01.55,Default,,0,0,0,,Ой-оу!
Dialogue: 0,1:02:01.67,1:02:03.17,Default,,0,0,0,,Иә Иә (Директордың орынбасары) Охохохо
Dialogue: 0,1:02:03.30,1:02:04.05,Default,,0,0,0,,Иә
Dialogue: 0,1:02:04.17,1:02:06.30,Default,,0,0,0,,Ятта Ахахха... (Эмили) Ахахха...
Dialogue: 0,1:02:09.80,1:02:12.52,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,1:02:25.03,1:02:26.61,Default,,0,0,0,,«Тілек тасы»
Dialogue: 0,1:02:26.74,1:02:28.74,Default,,0,0,0,,Келесі жолы, тағы 100 жылдан кейін.
Dialogue: 0,1:02:28.87,1:02:31.24,Default,,0,0,0,,Олай болса, келесі өтінішімді ойлауым керек.
Dialogue: 0,1:02:31.37,1:02:32.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:32.79,1:02:35.54,Default,,0,0,0,,(Мирайдың күлкісі)
Dialogue: 0,1:02:36.58,1:02:37.62,Default,,0,0,0,,(Куматаның ізі)
Dialogue: 0,1:02:37.75,1:02:42.96,Default,,0,0,0,,Әй, Кумата! Мофф менімен келе ме?
Dialogue: 0,1:02:43.09,1:02:46.63,Default,,0,0,0,,Жоқ, жеткілікті.
Dialogue: 0,1:02:47.05,1:02:47.93,Default,,0,0,0,,Мофф?
Dialogue: 0,1:02:49.14,1:02:50.14,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,1:02:50.97,1:02:53.97,Default,,0,0,0,,Ха ха мофу!
Dialogue: 0,1:02:55.60,1:02:56.27,Default,,0,0,0,,Уф...
Dialogue: 0,1:02:58.56,1:02:59.48,Default,,0,0,0,,Аю
Dialogue: 0,1:03:02.19,1:03:02.86,Default,,0,0,0,,Хехе
Dialogue: 0,1:03:06.99,1:03:10.82,Default,,0,0,0,,Эй, Рико, бұл баланың шын тілегі қандай...
Dialogue: 0,1:03:11.12,1:03:13.66,Default,,0,0,0,,Достар керек пе?
Dialogue: 0,1:03:13.79,1:03:14.70,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,1:03:14.83,1:03:18.71,Default,,0,0,0,,Иә, бұл болды.
Dialogue: 0,1:03:20.50,1:03:23.67,Default,,0,0,0,,«Тілек тасы» деген ұғым жоқ.
Dialogue: 0,1:03:25.25,1:03:26.67,Default,,0,0,0,,Морху!
Dialogue: 0,1:03:32.35,1:03:37.35,Default,,0,0,0,,♪～
Dialogue: 0,1:05:27.59,1:05:32.59,Default,,0,0,0,,～♪
Dialogue: 0,1:05:40.81,1:05:42.39,Default,,0,0,0,,Куап Рапапа
Dialogue: 0,1:05:50.57,1:05:51.28,Default,,0,0,0,,Ei
Dialogue: 0,1:05:51.48,1:05:55.40,Default,,0,0,0,,Барлығы, сиқырлы сабақтардың уақыты келді, Жан!
Dialogue: 0,1:05:56.61,1:05:59.58,Default,,0,0,0,,Бұл сіздің тілектеріңіз қалыптасатын ғажайып жарық.
Dialogue: 0,1:05:59.70,1:06:01.29,Default,,0,0,0,,Маған көмектесші, Мофуу иә?
Dialogue: 0,1:06:02.04,1:06:03.25,Default,,0,0,0,,Мофф Мофф
Dialogue: 0,1:06:03.83,1:06:06.00,Default,,0,0,0,,Мофурун! Мен сізге қазір көмектесемін!
Dialogue: 0,1:06:07.12,1:06:11.67,Default,,0,0,0,,Кюп Рапапа Мофурун, өсе бер!
Dialogue: 0,1:06:12.88,1:06:14.84,Default,,0,0,0,,Уаааааааааа!
Dialogue: 0,1:06:14.97,1:06:17.76,Default,,0,0,0,,Морфу Морфу
Dialogue: 0,1:06:18.30,1:06:21.93,Default,,0,0,0,,...және осындай сиқырлы сөздерді айт
Dialogue: 0,1:06:22.06,1:06:24.81,Default,,0,0,0,,Кя! Апыр-ай!
Dialogue: 0,1:06:25.35,1:06:28.06,Default,,0,0,0,,Кәне, бәріміз бірге сиқырлайық.
Dialogue: 0,1:06:28.19,1:06:32.07,Default,,0,0,0,,Мен Мофурунды кішірейтемін.
Dialogue: 0,1:06:32.19,1:06:36.90,Default,,0,0,0,,Кюп Лапапа Мофурун, кішкентай бол!
Dialogue: 0,1:06:38.20,1:06:40.03,Default,,0,0,0,,Уау, хехехе
Dialogue: 0,1:06:40.16,1:06:42.79,Default,,0,0,0,,Мофурун да Мофуды жасайды
Dialogue: 0,1:06:43.24,1:06:46.12,Default,,0,0,0,,Мофурун - гүлдерді гүлдендіретін мофу.
Dialogue: 0,1:06:46.25,1:06:49.38,Default,,0,0,0,,Бәріміз бірге болайық
Dialogue: 0,1:06:49.75,1:06:53.80,Default,,0,0,0,,Лапапа гүлі-сан гүлденген Мофуды емдеу!
Dialogue: 0,1:06:57.34,1:06:58.22,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:00.43,1:07:03.39,Default,,0,0,0,,Гүл ханшайымы флораны емдейді
Dialogue: 0,1:07:04.06,1:07:06.06,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,1:07:07.18,1:07:09.23,Default,,0,0,0,,...Бұл дұрыс емес!
Dialogue: 0,1:07:09.35,1:07:13.48,Default,,0,0,0,,Жарайды, келесі менің кезегім.
Dialogue: 0,1:07:13.61,1:07:16.07,Default,,0,0,0,,Кюп Рапапа Эй!
Dialogue: 0,1:07:17.03,1:07:17.70,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:19.99,1:07:21.49,Default,,0,0,0,,Таң қалған Мияу
Dialogue: 0,1:07:21.62,1:07:22.91,Default,,0,0,0,,Ахаха…
Dialogue: 0,1:07:23.66,1:07:25.79,Default,,0,0,0,,Куап Лапапа Мофу!
Dialogue: 0,1:07:25.91,1:07:30.54,Default,,0,0,0,,Уау! Апыр-ай! Апыр-ай! Ахахха...
Dialogue: 0,1:07:30.67,1:07:32.54,Default,,0,0,0,,Рапапаны емдеңіз!
Dialogue: 0,1:07:33.42,1:07:36.92,Default,,0,0,0,,Мофф Мофф Мофф
Dialogue: 0,1:07:37.88,1:07:40.76,Default,,0,0,0,,Мафф мофу!
Dialogue: 0,1:07:40.93,1:07:41.68,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:41.80,1:07:47.06,Default,,0,0,0,,Мофу мофу мофу мофу мофу!
Dialogue: 0,1:07:48.52,1:07:50.44,Default,,0,0,0,,Мофу…
Dialogue: 0,1:07:50.56,1:07:51.44,Default,,0,0,0,,Мофурун!
Dialogue: 0,1:07:55.61,1:07:57.94,Default,,0,0,0,,Күте тұрыңыз, мен қазір барамын.
Dialogue: 0,1:08:01.61,1:08:04.53,Default,,0,0,0,,Мофурун қауіпті! Мофф?
Dialogue: 0,1:08:07.08,1:08:07.75,Default,,0,0,0,,(шарлардың ұшып шыққан дыбысы)
Dialogue: 0,1:08:08.00,1:08:09.75,Default,,0,0,0,,Мофу…
Dialogue: 0,1:08:11.04,1:08:13.92,Default,,0,0,0,,Кюп Рапапа шары, шық!
Dialogue: 0,1:08:15.75,1:08:16.42,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:16.88,1:08:18.46,Default,,0,0,0,,Мофурун, ұстаңыз!
Dialogue: 0,1:08:18.67,1:08:20.47,Default,,0,0,0,,Момофу…
Dialogue: 0,1:08:21.22,1:08:23.14,Default,,0,0,0,,Мен көбірек беруім керек
Dialogue: 0,1:08:24.10,1:08:26.56,Default,,0,0,0,,Өтінемін, бәрі де маған көмектессін.
Dialogue: 0,1:08:27.10,1:08:30.48,Default,,0,0,0,,Сейно Куап Рапапа
Dialogue: 0,1:08:30.98,1:08:32.44,Default,,0,0,0,,Мофу Мофу
Dialogue: 0,1:08:32.81,1:08:35.77,Default,,0,0,0,,Сейно Куап Рапапа
Dialogue: 0,1:08:36.11,1:08:39.32,Default,,0,0,0,,Сейно Куап Рапапа
Dialogue: 0,1:08:39.44,1:08:41.53,Default,,0,0,0,,Мафф мофу
Dialogue: 0,1:08:41.90,1:08:46.24,Default,,0,0,0,,Сейно Лапапаны емдеңіз!
Dialogue: 0,1:08:46.49,1:08:48.66,Default,,0,0,0,,Мофу!
Dialogue: 0,1:08:48.83,1:08:49.75,Default,,0,0,0,,Ах
Dialogue: 0,1:08:55.04,1:08:56.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:58.25,1:09:00.01,Default,,0,0,0,,Морфу!
Dialogue: 0,1:09:01.13,1:09:01.84,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:03.43,1:09:04.51,Default,,0,0,0,,Мофурун
Dialogue: 0,1:09:04.68,1:09:07.76,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,1:09:09.10,1:09:12.68,Default,,0,0,0,,Иә? Апыр-ай! Бұл да сиқырлы мофпа?
Dialogue: 0,1:09:13.89,1:09:19.19,Default,,0,0,0,,Уфуфу, бұл күннің сиқыры ма?
Dialogue: 0,1:09:21.86,1:09:23.70,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,1:09:23.86,1:09:29.20,Default,,0,0,0,,Соңында бұл сиқырлы би, Se's Cure Up Rapapa!
Dialogue: 0,1:09:32.71,1:09:37.71,Default,,0,0,0,,♪～
Dialogue: 0,1:09:52.60,1:09:55.14,Default,,0,0,0,,♪Қашан
Dialogue: 0,1:09:55.52,1:09:58.40,Default,,0,0,0,,♪Мен бұл сиқырды қолдана аламын ба?
Dialogue: 0,1:09:58.73,1:10:03.24,Default,,0,0,0,,♪Ережені айтып беріңізші.
Dialogue: 0,1:10:04.82,1:10:07.49,Default,,0,0,0,,♪Өзім үшін емес
Dialogue: 0,1:10:07.62,1:10:10.66,Default,,0,0,0,,♪Жаныңдағы маңызды адамдар үшін
Dialogue: 0,1:10:10.78,1:10:12.58,Default,,0,0,0,,♪Құпия жолмен
Dialogue: 0,1:10:12.70,1:10:15.83,Default,,0,0,0,,♪Бір ғажайып жаса
Dialogue: 0,1:10:17.08,1:10:19.42,Default,,0,0,0,,♪Егер біреу жылап жатса
Dialogue: 0,1:10:19.59,1:10:22.42,Default,,0,0,0,,♪Мен істей алатын бірдеңе бар ма?
Dialogue: 0,1:10:22.59,1:10:24.51,Default,,0,0,0,,♪ Қолыңызды созыңыз...
Dialogue: 0,1:10:24.63,1:10:25.59,Default,,0,0,0,,♪Енді сабаққа
Dialogue: 0,1:10:25.88,1:10:28.26,Default,,0,0,0,,♪Рапапаны емдеңіз!
Dialogue: 0,1:10:28.39,1:10:31.60,Default,,0,0,0,,♪Мен сені бірден күлдіремін
Dialogue: 0,1:10:31.97,1:10:34.52,Default,,0,0,0,,♪Рапапаны емдеңіз!
Dialogue: 0,1:10:34.64,1:10:38.35,Default,,0,0,0,,♪Сезім сіздің күшіңізге айналады
Dialogue: 0,1:10:38.48,1:10:40.56,Default,,0,0,0,,♪Ғажайып жарықты толқында
Dialogue: 0,1:10:40.94,1:10:43.11,Default,,0,0,0,,♪Мейірімді жүрекпен
Dialogue: 0,1:10:43.23,1:10:46.40,Default,,0,0,0,,♪Маған жайлап қарасаң
Dialogue: 0,1:10:46.53,1:10:49.99,Default,,0,0,0,,♪Мен күлемін
Dialogue: 0,1:10:58.96,1:11:03.96,Default,,0,0,0,,～♪
Dialogue: 0,1:11:05.46,1:11:11.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory