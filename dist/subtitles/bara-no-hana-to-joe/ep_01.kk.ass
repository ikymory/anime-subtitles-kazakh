Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:44.08,0:02:46.62,Default,Narrator,0,0,0,,Джо - жалғызбасты қоңыр ит.
Dialogue: 0,0:02:56.05,0:02:59.40,Default,Narrator,0,0,0,,Джо кішкентай ит болғандықтан,
Dialogue: 0,0:02:59.40,0:03:02.07,Default,Narrator,0,0,0,,Маған раушан гүлдерінің астында ұйықтаған ұнады.
Dialogue: 0,0:03:05.51,0:03:07.51,Default,Narrator,0,0,0,,деді Джо раушан гүлдеріне
Dialogue: 0,0:03:08.14,0:03:10.95,Joe,Joe,0,0,0,,«Маған раушан гүлдері ұнайды».
Dialogue: 0,0:03:10.95,0:03:15.44,Joe,Joe,0,0,0,,«Мен сенің қасыңда болсам, өзімді іштей бақытты сезінемін».
Dialogue: 0,0:03:15.44,0:03:18.20,Default,Narrator,0,0,0,,Роза күліп жауап берді.
Dialogue: 0,0:03:18.94,0:03:24.62,Rose,Rose,0,0,0,,«Мен де, Джо. Маған сенің қара домалақ дангобана ұнайды».
Dialogue: 0,0:03:24.62,0:03:26.10,Joe,Joe,0,0,0,,«Мен бұл рас па деп ойлаймын».
Dialogue: 0,0:03:26.60,0:03:30.00,Joe,Joe,0,0,0,,«Сен әдемісің, бірақ мен ұсқынсызмын».
Dialogue: 0,0:03:30.62,0:03:38.22,Default,Song,0,0,0,,Мен үйсіз, кір итпін.
Dialogue: 0,0:03:39.60,0:03:47.84,Default,Song,0,0,0,,Сен әдемі қызыл раушансың
Dialogue: 0,0:03:49.46,0:03:56.42,Default,Song,0,0,0,,Тым басқа
Dialogue: 0,0:03:56.42,0:04:02.85,Default,Song,0,0,0,,Раушан гүлдер желмен ән салды
Dialogue: 0,0:04:03.23,0:04:08.97,Default,Song,0,0,0,,Маған Джо ұнайды
Dialogue: 0,0:04:10.52,0:04:13.86,Default,Song,0,0,0,,Шын жүректен...
Dialogue: 0,0:04:14.21,0:04:15.57,Default,Song,0,0,0,,Маған ұнайды
Dialogue: 0,0:04:17.23,0:04:24.15,Default,Song,0,0,0,,Раушан және Джо
Dialogue: 0,0:04:24.15,0:04:31.88,Default,Song,0,0,0,,Раушан және Джо
Dialogue: 0,0:04:37.52,0:04:40.13,Default,Narrator,0,0,0,,Раушан гүлді көздеген қарға болды.
Dialogue: 0,0:04:43.46,0:04:46.64,Default,Narrator,0,0,0,,Бір күні қарға раушан гүлінің жанына келді.
Dialogue: 0,0:04:59.39,0:05:01.58,Joe,Joe,0,0,0,,«Ах! Раушан қауіпті!»
Dialogue: 0,0:05:02.58,0:05:03.36,Joe,Joe,0,0,0,,«Жарайды...»
Dialogue: 0,0:06:03.24,0:06:05.58,Rose,Rose,0,0,0,,«Джо, бұл тамаша».
Dialogue: 0,0:06:05.58,0:06:08.16,Rose,Rose,0,0,0,,«Сен мықтысың, солай ма?».
Dialogue: 0,0:06:08.16,0:06:11.03,Joe,Joe,0,0,0,,"Дұрыс! Мен күштімін".
Dialogue: 0,0:06:11.03,0:06:14.32,Joe,Joe,0,0,0,,«Ештеңеге қарамастан мен мұны сен үшін жасамас едім».
Dialogue: 0,0:07:33.22,0:07:34.78,Joe,Joe,0,0,0,,«Мен жасадым...»
Dialogue: 0,0:07:42.61,0:07:44.80,Rose,Rose,0,0,0,,«Джо, бұл тамаша.»
Dialogue: 0,0:07:44.80,0:07:46.86,Rose,Rose,0,0,0,,«Сен мықтысың, солай ма?»
Dialogue: 0,0:07:47.65,0:07:50.45,Joe,Joe,0,0,0,,"Дұрыс! Мен күштімін".
Dialogue: 0,0:07:54.87,0:07:55.96,Joe,Joe,0,0,0,,«Жарайды...»
Dialogue: 0,0:09:55.44,0:09:57.80,Rose,Rose,0,0,0,,«Рахмет, Джо».
Dialogue: 0,0:09:57.80,0:09:58.72,Joe,Joe,0,0,0,,«Жарайды».
Dialogue: 0,0:09:58.72,0:10:02.23,Joe,Joe,0,0,0,,«Мен сен үшін бәрін істей аламын».
Dialogue: 0,0:11:37.37,0:11:38.56,Rose,Rose,0,0,0,,«Джо, бұл қауіпті!!»
Dialogue: 0,0:11:59.12,0:12:01.57,Rose,Rose,0,0,0,,«Джо, бұл тамаша».
Dialogue: 0,0:12:02.12,0:12:05.47,Joe,Joe,0,0,0,,"Дұрыс! Мен күштімін".
Dialogue: 0,0:12:08.68,0:12:10.33,Rose,Rose,0,0,0,,"Ой! Джо!"
Dialogue: 0,0:12:12.06,0:12:13.16,Rose,Rose,0,0,0,,"Джо!!"
Dialogue: 0,0:12:13.68,0:12:14.76,Rose,Rose,0,0,0,,"Джо!!"
Dialogue: 0,0:12:15.36,0:12:16.64,Rose,Rose,0,0,0,,"Джо!!"
Dialogue: 0,0:12:19.28,0:12:26.97,Default,Song,0,0,0,,Джо - батыл қоңыр ит
Dialogue: 0,0:12:26.97,0:12:36.28,Default,Song,0,0,0,,Джо әдемі раушан гүлдерін ұнатады.
Dialogue: 0,0:12:36.28,0:12:42.81,Default,Song,0,0,0,,Раушан гүлдерінің көлеңкесінде
Dialogue: 0,0:12:42.81,0:12:49.31,Default,Song,0,0,0,,Джо үнемі ұйықтайтын
Dialogue: 0,0:12:49.31,0:12:55.60,Default,Song,0,0,0,,Раушан гүлдер тербелді
Dialogue: 0,0:12:55.60,0:13:01.15,Default,Song,0,0,0,,Ақырын, ақырын теңселді
Dialogue: 0,0:13:02.14,0:13:08.54,Default,Song,0,0,0,,Раушан және Джо
Dialogue: 0,0:13:08.54,0:13:15.04,Default,Song,0,0,0,,Раушан және Джо
Dialogue: 0,0:16:39.08,0:16:40.14,Rose,Rose,0,0,0,,«Джо…»
Dialogue: 0,0:16:41.76,0:16:43.08,Rose,Rose,0,0,0,,«Джо».
Dialogue: 0,0:16:44.00,0:16:46.15,Rose,Rose,0,0,0,,«Кел, Джо».
Dialogue: 0,0:16:57.60,0:17:00.22,Rose,Rose,0,0,0,,«Мен күттім».
Dialogue: 0,0:17:00.22,0:17:02.88,Rose,Rose,0,0,0,,«Мен мұнда гүлдеп жатырмын».
Dialogue: 0,0:17:08.97,0:17:11.61,Rose,Rose,0,0,0,,«Джо, кешіріңіз.»
Dialogue: 0,0:17:11.98,0:17:14.64,Rose,Rose,0,0,0,,«Менің кесірімнен соқыр болдың».
Dialogue: 0,0:17:15.61,0:17:17.18,Joe,Joe,0,0,0,,«Жарайды».
Dialogue: 0,0:17:17.88,0:17:22.37,Joe,Joe,0,0,0,,«Мен әрқашан көзіме қарағанда көзіме сезімтал болдым».
Dialogue: 0,0:17:22.83,0:17:26.48,Rose,Rose,0,0,0,,«Бірақ... сен мені көре алмайсың, солай ма?»
Dialogue: 0,0:17:27.06,0:17:30.11,Rose,Rose,0,0,0,,«Ол қазір әдемі гүлдеп жатыр».
Dialogue: 0,0:17:31.38,0:17:34.59,Joe,Joe,0,0,0,,«Жоқ, мен оны көріп тұрмын».
Dialogue: 0,0:17:35.83,0:17:39.05,Joe,Joe,0,0,0,,«Жұмсақ барқыт жапырақшалар да».
Dialogue: 0,0:17:40.18,0:17:43.11,Joe,Joe,0,0,0,,«Ал оның үстіне түсетін шық».
Dialogue: 0,0:17:43.97,0:17:49.56,Joe,Joe,0,0,0,,«Мен сені көргенімнен де анық көремін».
Dialogue: 0,0:18:42.71,0:18:49.82,Default,Song,0,0,0,,Желдің салқынына шыдамай
Dialogue: 0,0:18:50.36,0:18:58.45,Default,Song,0,0,0,,Сол жылы раушан гүлдері шынымен бақытсыз болды.
Dialogue: 0,0:18:59.34,0:19:05.55,Default,Song,0,0,0,,Раушан өтірік айтты
Dialogue: 0,0:19:05.55,0:19:11.30,Default,Song,0,0,0,,«Мен өлгенде менімен бірге Джо».
Dialogue: 0,0:19:11.74,0:19:17.99,Default,Song,0,0,0,,Раушан гүл Мен білемін
Dialogue: 0,0:19:17.99,0:19:24.19,Default,Song,0,0,0,,Қысқа өмір аяқталды
Dialogue: 0,0:19:24.19,0:19:30.36,Default,Song,0,0,0,,Раушандар мен Джо
Dialogue: 0,0:19:30.36,0:19:38.12,Default,Song,0,0,0,,Раушан және Джо
