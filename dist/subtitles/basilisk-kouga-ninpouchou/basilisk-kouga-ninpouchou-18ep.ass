Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.34,0:00:11.01,Default,,0,0,0,,Бірін-бірі жек көретін адамдар болды
Dialogue: 0,0:00:12.92,0:00:17.68,Default,,0,0,0,,Далада дене шіриді, рух қанға боялады.
Dialogue: 0,0:00:20.31,0:00:23.77,Default,,0,0,0,,Байланыс пышақпен бөлінді
Dialogue: 0,0:00:23.94,0:00:26.98,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:00:32.53,0:00:33.49,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:37.37,0:00:38.66,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:39.78,0:00:42.37,Default,,0,0,0,,Қараңғылықтың шынайылығы жылайды
Dialogue: 0,0:00:42.50,0:00:43.91,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:00:45.33,0:00:49.42,Default,,0,0,0,,Сүйіктім, өлуге дайын
Dialogue: 0,0:01:01.51,0:01:06.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:26.72,0:02:30.56,Default,,0,0,0,,～♪
Dialogue: 0,0:02:36.65,0:02:41.82,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:42.41,0:02:43.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:45.41,0:02:47.75,Default,,0,0,0,,Куничиё-сама! (Қызметші) Қалайсың?
Dialogue: 0,0:02:47.87,0:02:49.66,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:02:49.79,0:02:52.17,Default,,0,0,0,,...
Dialogue: 0,0:02:52.29,0:02:54.38,Default,,0,0,0,,Куничиё-сама! Куничиё-сама!
Dialogue: 0,0:02:59.22,0:03:00.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:04.55,0:03:05.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:05.68,0:03:08.60,Default,,0,0,0,,...
Dialogue: 0,0:03:08.73,0:03:09.89,Default,,0,0,0,,Оэйодо
Dialogue: 0,0:03:12.23,0:03:15.98,Default,,0,0,0,,...
Dialogue: 0,0:03:16.11,0:03:16.98,Default,,0,0,0,,Хо…
Dialogue: 0,0:03:17.11,0:03:20.03,Default,,0,0,0,,Бақытымызға орай, маңызды ештеңе болған жоқ.
Dialogue: 0,0:03:20.15,0:03:22.28,Default,,0,0,0,,...
Dialogue: 0,0:03:22.74,0:03:26.41,Default,,0,0,0,,…
Dialogue: 0,0:03:26.53,0:03:28.29,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:03:28.58,0:03:33.33,Default,,0,0,0,,Қазіргі уақытта мұрагерлікке қатысты жағдай біршама қиын.
Dialogue: 0,0:03:33.63,0:03:38.84,Default,,0,0,0,,...
Dialogue: 0,0:03:39.30,0:03:41.59,Default,,0,0,0,,Алайда, Амами...
Dialogue: 0,0:03:41.72,0:03:43.55,Default,,0,0,0,,(Такечионың күлкісі)
Dialogue: 0,0:03:44.01,0:03:44.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:45.05,0:03:47.51,Default,,0,0,0,,...
Dialogue: 0,0:03:47.81,0:03:49.68,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:03:49.81,0:03:53.81,Default,,0,0,0,,Бұл сөздер, тіпті мұнда жоқ викс үшін де...
Dialogue: 0,0:03:54.15,0:03:56.27,Default,,0,0,0,,Бізге хабарлаңыз!
Dialogue: 0,0:03:58.61,0:03:59.90,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:04:00.65,0:04:01.78,Default,,0,0,0,,Иә! (соққы дыбысы)
Dialogue: 0,0:04:02.15,0:04:03.82,Default,,0,0,0,,Иә! Алақай! (қол шапалақтау)
Dialogue: 0,0:04:03.95,0:04:05.37,Default,,0,0,0,,Иә! (соққы дыбысы)
Dialogue: 0,0:04:05.49,0:04:08.70,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:04:08.83,0:04:10.58,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:04:39.15,0:04:42.24,Default,,0,0,0,,( )
Dialogue: 0,0:04:44.74,0:04:46.45,Default,,0,0,0,,Цк... Ига адам!
Dialogue: 0,0:04:46.61,0:04:47.78,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:04:48.03,0:04:49.74,Default,,0,0,0,,Ха... аа...
Dialogue: 0,0:04:53.20,0:04:54.41,Default,,0,0,0,,Ахх...
Dialogue: 0,0:04:55.75,0:04:57.21,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:05:00.55,0:05:01.71,Default,,0,0,0,,(Орақ лақтыру дыбысы)
Dialogue: 0,0:05:15.64,0:05:16.85,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:05:23.69,0:05:27.32,Default,,0,0,0,,...
Dialogue: 0,0:05:27.99,0:05:30.87,Default,,0,0,0,,… （） …
Dialogue: 0,0:05:31.70,0:05:36.79,Default,,0,0,0,,...
Dialogue: 0,0:05:44.01,0:05:45.26,Default,,0,0,0,,Барыс жылқы…
Dialogue: 0,0:05:45.42,0:05:47.26,Default,,0,0,0,,(айқай)
Dialogue: 0,0:05:47.80,0:05:49.01,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:50.05,0:05:51.47,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:05:52.76,0:05:53.85,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:55.35,0:05:57.23,Default,,0,0,0,,Kagero Go!
Dialogue: 0,0:05:59.98,0:06:01.19,Default,,0,0,0,,Генносуке-сама!
Dialogue: 0,0:06:01.98,0:06:03.82,Default,,0,0,0,,(айқай)
Dialogue: 0,0:06:04.61,0:06:06.19,Default,,0,0,0,,Мм... Генносуке!
Dialogue: 0,0:06:09.16,0:06:10.62,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:11.74,0:06:12.58,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:17.00,0:06:18.21,Default,,0,0,0,,(бір-бірін соғу дыбысы)
Dialogue: 0,0:06:23.96,0:06:25.71,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:06:26.67,0:06:28.34,Default,,0,0,0,,(айқай)
Dialogue: 0,0:06:35.43,0:06:36.52,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:06:37.93,0:06:41.81,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:06:42.19,0:06:44.19,Default,,0,0,0,,Міне, Кошироны қараңыз
Dialogue: 0,0:06:53.03,0:06:54.03,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,0:07:15.60,0:07:18.81,Default,,0,0,0,,Хоук, сен қайда бардың?
Dialogue: 0,0:07:19.10,0:07:21.81,Default,,0,0,0,,...
Dialogue: 0,0:07:22.40,0:07:26.44,Default,,0,0,0,,Күткендей, менің көзімді Генносуке-сама жауып тастады...
Dialogue: 0,0:07:27.57,0:07:29.82,Default,,0,0,0,,Сіз оны әлі ашқан жоқсыз ба?
Dialogue: 0,0:07:49.26,0:07:50.26,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:07:51.72,0:07:53.18,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:07:55.64,0:07:59.85,Default,,0,0,0,,...
Dialogue: 0,0:08:01.48,0:08:03.02,Default,,0,0,0,,Генносуке-сама
Dialogue: 0,0:08:05.44,0:08:07.15,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:10.65,0:08:11.49,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:11.65,0:08:13.61,Default,,0,0,0,,(айқай)
Dialogue: 0,0:08:28.38,0:08:30.96,Default,,0,0,0,,Қайда? Кога адам
Dialogue: 0,0:08:31.59,0:08:33.17,Default,,0,0,0,,Ол қайдан шыққан?
Dialogue: 0,0:08:51.65,0:08:52.65,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:54.15,0:08:55.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:02.83,0:09:03.66,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:03.83,0:09:05.25,Default,,0,0,0,,(шашу дыбысы)
Dialogue: 0,0:09:06.37,0:09:07.67,Default,,0,0,0,,Ах... Қарғыс атсын!
Dialogue: 0,0:09:08.83,0:09:09.67,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:09:09.84,0:09:13.59,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:09:18.14,0:09:19.39,Default,,0,0,0,,Ессіздік...
Dialogue: 0,0:09:31.69,0:09:33.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:38.20,0:09:41.20,Default,,0,0,0,,Барыс жылқы! Барс аттары бар ма?
Dialogue: 0,0:09:48.50,0:09:51.75,Default,,0,0,0,,Сізге телефон соғуға болады ма? Данжо-сама
Dialogue: 0,0:09:52.30,0:09:55.42,Default,,0,0,0,,Сіз бұл жігіттің кім екенін білесіз бе?
Dialogue: 0,0:09:59.93,0:10:00.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:03.01,0:10:06.56,Default,,0,0,0,,Бұл жерде анамның қаны бар сияқты...
Dialogue: 0,0:10:07.60,0:10:10.81,Default,,0,0,0,,Әпкеңнің қаны қалың шыққан сияқты.
Dialogue: 0,0:10:13.07,0:10:15.53,Default,,0,0,0,,Мынаны салып бере аласыз ба?
Dialogue: 0,0:10:16.69,0:10:18.40,Default,,0,0,0,,Көз техникасы...
Dialogue: 0,0:10:22.91,0:10:26.29,Default,,0,0,0,,Мен бұл күшті болғанын қалаймын.
Dialogue: 0,0:10:26.87,0:10:28.71,Default,,0,0,0,,Менен артық
Dialogue: 0,0:10:31.92,0:10:33.00,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:10:36.21,0:10:39.30,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:39.72,0:10:43.93,Default,,0,0,0,,Тым көп көретін көздер де проблема болуы мүмкін.
Dialogue: 0,0:10:44.06,0:10:46.02,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:51.65,0:10:53.02,Default,,0,0,0,,О...
Dialogue: 0,0:11:11.08,0:11:14.75,Default,,0,0,0,,Сіз қалай ойлайсыз? Барыс жылқы
Dialogue: 0,0:11:15.09,0:11:15.92,Default,,0,0,0,,Ха...
Dialogue: 0,0:11:16.75,0:11:20.67,Default,,0,0,0,,Қандай адал бала.
Dialogue: 0,0:11:27.10,0:11:33.10,Default,,0,0,0,,(цикада айқайы)
Dialogue: 0,0:11:50.29,0:11:53.92,Default,,0,0,0,,(айқай)
Dialogue: 0,0:11:54.08,0:11:55.33,Default,,0,0,0,,Хо…
Dialogue: 0,0:11:55.88,0:11:59.46,Default,,0,0,0,,Даусыңыз жақсы, Генносуке-сама.
Dialogue: 0,0:11:59.59,0:12:00.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:03.84,0:12:07.43,Default,,0,0,0,,Құстардың даусы маған пайдасы жоқ!
Dialogue: 0,0:12:08.14,0:12:10.14,Default,,0,0,0,,Қаншалықты әдепсіз...
Dialogue: 0,0:12:10.56,0:12:14.81,Default,,0,0,0,,Дәм туралы аздап білу керек.
Dialogue: 0,0:12:15.86,0:12:17.40,Default,,0,0,0,,Ннн…
Dialogue: 0,0:12:27.87,0:12:28.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:29.70,0:12:32.79,Default,,0,0,0,,Сіз не істедіңіз? Генносуке мырза
Dialogue: 0,0:12:34.62,0:12:36.29,Default,,0,0,0,,Оны көргенде білесің...
Dialogue: 0,0:12:36.42,0:12:39.80,Default,,0,0,0,,Одан гөрі мен сенің өнеріңді үйренгім келеді!
Dialogue: 0,0:12:40.50,0:12:42.67,Default,,0,0,0,,Осындай көз байланған...
Dialogue: 0,0:12:42.80,0:12:45.84,Default,,0,0,0,,Күні бойы Мангаяны айналып өтуге болмайды...
Dialogue: 0,0:12:46.22,0:12:48.85,Default,,0,0,0,,Сізге серуендеу ұнамады ма?
Dialogue: 0,0:12:49.35,0:12:51.31,Default,,0,0,0,,Мен күшті болғым келеді!
Dialogue: 0,0:12:51.43,0:12:53.60,Default,,0,0,0,,Кога үшін және...
Dialogue: 0,0:12:54.19,0:12:58.36,Default,,0,0,0,,Бірақ бұл сізді күштірек етуден алыс.
Dialogue: 0,0:12:59.23,0:13:01.53,Default,,0,0,0,,Егер сіз Pupil Technique қолданбасын пайдалана алатыныңызды білсеңіз...
Dialogue: 0,0:13:01.78,0:13:06.16,Default,,0,0,0,,Біріншіден, жау сіздің көзіңізді нысанаға алады, бірақ бұл әскери тактиканың негізі.
Dialogue: 0,0:13:06.45,0:13:09.74,Default,,0,0,0,,Бұл сіздің көзіңіз жабылған жағдайда ғана...
Dialogue: 0,0:13:09.87,0:13:11.45,Default,,0,0,0,,Жаттығуда
Dialogue: 0,0:13:12.79,0:13:13.91,Default,,0,0,0,,(Төлемнің дыбысы)
Dialogue: 0,0:13:20.34,0:13:24.22,Default,,0,0,0,,Маған төтенше жағдай қажет емес, тез арада оқушының техникасын үйретіңізші!
Dialogue: 0,0:13:30.93,0:13:31.97,Default,,0,0,0,,Барыс жылқы!
Dialogue: 0,0:13:33.52,0:13:36.14,Default,,0,0,0,,Мен келе жатырмын, Генносуке-сама.
Dialogue: 0,0:13:37.65,0:13:38.73,Default,,0,0,0,,Ннн…
Dialogue: 0,0:13:52.03,0:13:53.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:54.79,0:13:57.00,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:13:57.21,0:13:58.46,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:09.13,0:14:12.22,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:14:15.52,0:14:17.48,Default,,0,0,0,,Бес сезім мүшелерін ұштау
Dialogue: 0,0:14:17.60,0:14:22.11,Default,,0,0,0,,Мұндай тау жолы ерекше емес.
Dialogue: 0,0:14:23.61,0:14:25.15,Default,,0,0,0,,Мен білемін! (аяқтың сынған дыбысы)
Dialogue: 0,0:14:25.61,0:14:28.90,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:14:29.57,0:14:32.28,Default,,0,0,0,,Бұл жерде аздап қауіпті.
Dialogue: 0,0:14:33.03,0:14:34.70,Default,,0,0,0,,Қандай қауіпті!
Dialogue: 0,0:14:41.88,0:14:43.13,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:52.51,0:14:53.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:54.05,0:14:57.39,Default,,0,0,0,,«Маған қауіп төніп тұр» дедім.
Dialogue: 0,0:14:57.73,0:15:00.85,Default,,0,0,0,,Қорқақ болсаң одан да жаман.
Dialogue: 0,0:15:09.28,0:15:11.66,Default,,0,0,0,,Бұл дүние күрделі және біртүрлі
Dialogue: 0,0:15:11.95,0:15:14.58,Default,,0,0,0,,Әр түрлі заттардың араласуы
Dialogue: 0,0:15:15.20,0:15:17.95,Default,,0,0,0,,Заттар уақыт өте өзгереді.
Dialogue: 0,0:15:19.16,0:15:20.16,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:21.04,0:15:25.17,Default,,0,0,0,,Сіз осы бейберекет әлемді басқаратын нәрселерге назар аудара аласыз ...
Dialogue: 0,0:15:25.46,0:15:29.17,Default,,0,0,0,,Барлығын өз көзіңмен көруге болады.
Dialogue: 0,0:15:29.30,0:15:33.84,Default,,0,0,0,,Сол... (Барыс жылқы) Менің оқушы техникамның сыры осында.
Dialogue: 0,0:15:34.14,0:15:37.39,Default,,0,0,0,,Бұл барлық тірі заттарға арналған заң.
Dialogue: 0,0:15:37.68,0:15:39.68,Default,,0,0,0,,…Ал бұл «ескерту» дегеніміз не?
Dialogue: 0,0:15:41.69,0:15:44.90,Default,,0,0,0,,Егер сіз мұны түсінсеңіз, сізде қиындық болмайды.
Dialogue: 0,0:15:45.02,0:15:47.69,Default,,0,0,0,,Мм! леопард жылқылары нашар
Dialogue: 0,0:15:50.32,0:15:51.40,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:56.45,0:15:58.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:01.50,0:16:02.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:03.42,0:16:05.25,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:05.38,0:16:06.21,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:06.38,0:16:09.42,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:09.80,0:16:11.47,Default,,0,0,0,,Ах... Генносуке-сама!
Dialogue: 0,0:16:11.63,0:16:15.18,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:15.55,0:16:17.72,Default,,0,0,0,,Аа... аа...
Dialogue: 0,0:16:17.89,0:16:19.60,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:20.14,0:16:23.44,Default,,0,0,0,,А... хаха...
Dialogue: 0,0:16:23.60,0:16:25.40,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:32.95,0:16:35.07,Default,,0,0,0,,(айқай)
Dialogue: 0,0:16:36.12,0:16:37.45,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:16:37.99,0:16:38.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:39.12,0:16:42.37,Default,,0,0,0,,Ах... Ах... (Барыс жылқы) Генносуке-сама
Dialogue: 0,0:17:01.39,0:17:04.56,Default,,0,0,0,,Данжо-саманың пікірінде ешқандай айырмашылық жоқ.
Dialogue: 0,0:17:05.39,0:17:09.69,Default,,0,0,0,,Генносуке-саманың оқушылық сиқыршылық қабілеті бар екені рас.
Dialogue: 0,0:17:11.78,0:17:12.99,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:17:17.03,0:17:20.37,Default,,0,0,0,,Бұл дүниеде қасиетті болса, жамандық бар.
Dialogue: 0,0:17:22.41,0:17:26.33,Default,,0,0,0,,Сұлулық бар жерде шіркін де бар.
Dialogue: 0,0:17:27.42,0:17:30.04,Default,,0,0,0,,Екеуін бірге жұту
Dialogue: 0,0:17:30.38,0:17:33.96,Default,,0,0,0,,Генносуке-саманың көзі тым түзу
Dialogue: 0,0:17:38.01,0:17:41.81,Default,,0,0,0,,(Жылан қорқытқан дыбыс)
Dialogue: 0,0:17:41.93,0:17:43.85,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:17:43.97,0:17:49.86,Default,,0,0,0,,Бұл көздерге көлеңке түсіру үшін ескертудің қажеті жоқ шығар.
Dialogue: 0,0:17:52.98,0:17:55.90,Default,,0,0,0,,Генносуке-сама, қалыңыз қалай?
Dialogue: 0,0:17:58.70,0:17:59.62,Default,,0,0,0,,Барыс жылқы
Dialogue: 0,0:18:00.78,0:18:01.95,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:18:06.00,0:18:07.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:17.34,0:18:18.18,Default,,0,0,0,,(айқай)
Dialogue: 0,0:18:22.01,0:18:25.47,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:18:50.00,0:18:51.42,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:03.64,0:19:07.68,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:19:08.43,0:19:10.14,Default,,0,0,0,,Ах! (Барыс жылқы) Ха...
Dialogue: 0,0:19:13.23,0:19:14.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:16.36,0:19:18.07,Default,,0,0,0,,Кешіріңіз, Барыс жылқы
Dialogue: 0,0:19:18.65,0:19:19.57,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:28.16,0:19:29.54,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:30.75,0:19:33.21,Default,,0,0,0,,Көз байлауыңызды шешіп, қараңыз.
Dialogue: 0,0:19:33.58,0:19:36.84,Default,,0,0,0,,Жоқ, мен оны көріп тұрмын.
Dialogue: 0,0:19:37.92,0:19:39.59,Default,,0,0,0,,Мен барыс атты көріп тұрмын
Dialogue: 0,0:19:40.88,0:19:43.93,Default,,0,0,0,,Дүние деген осы ма?
Dialogue: 0,0:19:44.30,0:19:46.31,Default,,0,0,0,,Қош бол
Dialogue: 0,0:19:46.72,0:19:50.10,Default,,0,0,0,,Макото Жарқыраған күн
Dialogue: 0,0:19:51.27,0:19:54.69,Default,,0,0,0,,Бұл күн тек Кога емес...
Dialogue: 0,0:19:54.94,0:19:59.19,Default,,0,0,0,,Игадағы Цубагакуре де дәл осылай жарықтандырылған емес пе?
Dialogue: 0,0:20:00.03,0:20:02.61,Default,,0,0,0,,Дүние солай десе...
Dialogue: 0,0:20:02.91,0:20:06.62,Default,,0,0,0,,Дүние солай десе...
Dialogue: 0,0:20:19.76,0:20:22.59,Default,,0,0,0,,Өтінемін, өмір сүріңіз...
Dialogue: 0,0:20:24.18,0:20:25.76,Default,,0,0,0,,Генносуке-сама
Dialogue: 0,0:20:26.05,0:20:28.89,Default,,0,0,0,,Ха... барыс жылқы
Dialogue: 0,0:20:31.48,0:20:33.48,Default,,0,0,0,,Жауап болды.
Dialogue: 0,0:20:34.23,0:20:36.98,Default,,0,0,0,,Бірақ оның құлағанының белгісі жоқ.
Dialogue: 0,0:20:37.27,0:20:41.69,Default,,0,0,0,,Сіз қате жібердіңіз бе? Жоқ, мен оның жеңілгеніне сенімдімін...
Dialogue: 0,0:20:41.86,0:20:42.82,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:20:45.53,0:20:48.99,Default,,0,0,0,,Қайда? Кога адам, сен қайдасың?
Dialogue: 0,0:20:49.24,0:20:51.79,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:20:54.71,0:20:55.54,Default,,0,0,0,,(айқай)
Dialogue: 0,0:20:55.92,0:20:59.21,Default,,0,0,0,,Така... Коширо мен басқалары қайтты?
Dialogue: 0,0:20:59.38,0:21:02.97,Default,,0,0,0,,Жоқ, бірдеңе дұрыс емес.
Dialogue: 0,0:21:03.13,0:21:05.13,Default,,0,0,0,,(айқай)
Dialogue: 0,0:21:05.47,0:21:10.64,Default,,0,0,0,,Мүмкін Тензен-сама мен Кошироға бірдеңе болған шығар...
Dialogue: 0,0:21:16.31,0:21:17.69,Default,,0,0,0,,Коширо...
Dialogue: 0,0:21:19.82,0:21:21.65,Default,,0,0,0,,Қайда? Қайда жоғалып кетті?
Dialogue: 0,0:21:21.82,0:21:24.82,Default,,0,0,0,,Мұндай жерде тұрып қалуға ешқандай себеп жоқ!
Dialogue: 0,0:21:24.95,0:21:28.03,Default,,0,0,0,,Біз ханшайымды қорғауымыз керек... Оборо-сама!
Dialogue: 0,0:21:28.24,0:21:31.20,Default,,0,0,0,,Асығыңыз... Тезірек Оборо-самаға барыңыз!
Dialogue: 0,0:21:32.20,0:21:34.16,Default,,0,0,0,,Коширо кім... (Косиро)... Ол кім?
Dialogue: 0,0:21:37.04,0:21:40.17,Default,,0,0,0,,Қай Коширо... (Коширо) Ха... Қай қызыл жібек?
Dialogue: 0,0:22:06.49,0:22:11.49,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.95,0:23:35.78,Default,,0,0,0,,～♪
Dialogue: 0,0:23:39.83,0:23:42.21,Default,,0,0,0,,Бетіне қарап құлаған мәйіт.
Dialogue: 0,0:23:42.33,0:23:46.04,Default,,0,0,0,,Сугариши – бөгетті алғаш рет кескен әйелдің ыңырсы.
Dialogue: 0,0:23:46.29,0:23:47.92,Default,,0,0,0,,Йоки көтерілген ай сәулесі
Dialogue: 0,0:23:48.05,0:23:51.80,Default,,0,0,0,,Өлімнің тоқырауынан үш рет ысқырып, пульсирленген жаңғырық.
Dialogue: 0,0:23:52.01,0:23:55.55,Default,,0,0,0,,Аойдың патшайымы желсіз далада пайда болады
Dialogue: 0,0:23:56.01,0:23:59.64,Default,,0,0,0,,Кога мен Ига соғыс ниндзяларының шынайы ниеттері осы жерде және қазір ашылады.
Dialogue: 0,0:24:00.64,0:24:03.52,Default,,0,0,0,,Келесі жолы «Basilisk ~Koga Ninja Scroll~»
Dialogue: 0,0:24:05.02,0:24:11.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
