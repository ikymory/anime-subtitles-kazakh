Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.25,0:00:11.01,Default,,0,0,0,,Бірін-бірі жек көретін адамдар болды
Dialogue: 0,0:00:12.92,0:00:17.68,Default,,0,0,0,,Далада дене шіриді, рух қанға боялады.
Dialogue: 0,0:00:20.35,0:00:23.77,Default,,0,0,0,,Байланыс пышақпен бөлінді
Dialogue: 0,0:00:23.94,0:00:26.98,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:00:32.53,0:00:33.49,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:37.37,0:00:38.66,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:39.78,0:00:42.37,Default,,0,0,0,,Қараңғылықтың шынайылығы жылайды
Dialogue: 0,0:00:42.50,0:00:43.91,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:00:45.33,0:00:49.42,Default,,0,0,0,,Сүйіктім, өлуге дайын
Dialogue: 0,0:01:01.51,0:01:06.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:26.72,0:02:30.56,Default,,0,0,0,,～♪
Dialogue: 0,0:02:43.37,0:02:48.41,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:02:48.54,0:02:50.29,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:02:52.13,0:02:53.42,Default,,0,0,0,,Обородо
Dialogue: 0,0:02:56.21,0:02:57.88,Default,,0,0,0,,Генносуке-сама
Dialogue: 0,0:03:11.27,0:03:12.19,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:14.73,0:03:16.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:21.53,0:03:22.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:31.54,0:03:32.37,Default,,0,0,0,,Ах…
Dialogue: 0,0:03:33.58,0:03:34.83,Default,,0,0,0,,Ахх...
Dialogue: 0,0:03:41.88,0:03:44.39,Default,,0,0,0,,Не істеді? Обородо
Dialogue: 0,0:03:45.14,0:03:47.01,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:47.51,0:03:51.77,Default,,0,0,0,,Әжелер Сунпуға барған соң
Dialogue: 0,0:03:51.89,0:03:54.35,Default,,0,0,0,,Мен мазасыздануды тоқтата алмайтын сияқтымын...
Dialogue: 0,0:03:55.81,0:03:58.65,Default,,0,0,0,,Мен Генносуке-саманың түрін көрген бойда...
Dialogue: 0,0:04:00.36,0:04:02.07,Default,,0,0,0,,Мені кешіріңіз.
Dialogue: 0,0:04:06.49,0:04:08.99,Default,,0,0,0,,Аман бол, Обородо
Dialogue: 0,0:04:09.45,0:04:14.62,Default,,0,0,0,,Біздің отбасымыз бір-бірін жек көрмегеніне көп болды.
Dialogue: 0,0:04:15.25,0:04:17.88,Default,,0,0,0,,Келісім Теншо дәуірінде жасалды.
Dialogue: 0,0:04:18.67,0:04:21.55,Default,,0,0,0,,Кога Ига Ұрыспаймын деген уәде болғанша
Dialogue: 0,0:04:22.05,0:04:25.55,Default,,0,0,0,,Қайтадан қайшылықтың туындауы екіталай.
Dialogue: 0,0:04:30.60,0:04:31.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:32.60,0:04:34.98,Default,,0,0,0,,Ұлы могулға... (Оборо) А...
Dialogue: 0,0:04:35.90,0:04:37.15,Default,,0,0,0,,Ниндзя өнерінің көрінісі
Dialogue: 0,0:04:38.61,0:04:41.65,Default,,0,0,0,,Хаттори Ханзоның маған жіберген хатында...
Dialogue: 0,0:04:42.28,0:04:44.65,Default,,0,0,0,,Бұл айтылған емес пе?
Dialogue: 0,0:04:45.49,0:04:48.32,Default,,0,0,0,,Иә, Генносуке-сама.
Dialogue: 0,0:04:58.38,0:05:00.71,Default,,0,0,0,,Осы уақытта, мүмкін...
Dialogue: 0,0:05:01.38,0:05:05.22,Default,,0,0,0,,Екі отбасының әлемге бірге шығуына жақсы мүмкіндік ретінде.
Dialogue: 0,0:05:05.51,0:05:09.72,Default,,0,0,0,,Ханзодо маған бірдеңе ұйымдастырды ма деп ойлаймын...
Dialogue: 0,0:05:10.85,0:05:15.73,Default,,0,0,0,,Ағам да басын изеп, Сунпуға кетті.
Dialogue: 0,0:05:16.35,0:05:20.73,Default,,0,0,0,,Мейірімділігіңіз үшін рахмет. Мен қатты ренжідім...
Dialogue: 0,0:05:21.44,0:05:25.49,Default,,0,0,0,,Аматсусае, мен ниндзялар отбасында дүниеге келсем де...
Dialogue: 0,0:05:25.61,0:05:28.95,Default,,0,0,0,,Ниндзя әдістерін, қылыштасу мен тайджуцуды айтпағанның өзінде.
Dialogue: 0,0:05:29.07,0:05:31.78,Default,,0,0,0,,Ештеңе кимеген екі адам
Dialogue: 0,0:05:32.83,0:05:37.04,Default,,0,0,0,,Жарайды, маған бәрібір.
Dialogue: 0,0:05:37.37,0:05:40.08,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:05:40.33,0:05:44.17,Default,,0,0,0,,Менің қолымнан келмейтін нәрсе - оны дұрыс шығару.
Dialogue: 0,0:05:44.51,0:05:47.43,Default,,0,0,0,,Мені оқытқан әжеге...
Dialogue: 0,0:05:47.55,0:05:50.14,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:05:50.26,0:05:54.31,Default,,0,0,0,,Оның темпераменті жоқ шығар, ал...
Dialogue: 0,0:05:54.93,0:05:56.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:56.31,0:05:59.15,Default,,0,0,0,,Бәріміз бірге өмір сүретін күн келсе
Dialogue: 0,0:05:59.27,0:06:01.27,Default,,0,0,0,,Бұл да пайдасыз болады.
Dialogue: 0,0:06:03.94,0:06:06.36,Default,,0,0,0,,Генносуке-сама (Генносуке) Иә?
Dialogue: 0,0:06:06.49,0:06:08.53,Default,,0,0,0,,Неліктен Ига мен Кога
Dialogue: 0,0:06:08.65,0:06:11.70,Default,,0,0,0,,Екеуміз бір-бірімізді көптен бері жек көретінбіз, солай емес пе?
Dialogue: 0,0:06:14.24,0:06:15.87,Default,,0,0,0,,Жек көру...
Dialogue: 0,0:06:16.70,0:06:18.54,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:06:19.58,0:06:24.63,Default,,0,0,0,,Қайырлы таң, Оджидзи мен Огендони, біз құттықтау күнін анықтауымыз керек.
Dialogue: 0,0:06:25.00,0:06:28.09,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:06:33.10,0:06:35.35,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:06:45.90,0:06:47.57,Default,,0,0,0,,(айқай)
Dialogue: 0,0:06:50.24,0:06:52.78,Default,,0,0,0,,(айқай)
Dialogue: 0,0:06:53.78,0:06:55.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:55.87,0:06:58.62,Default,,0,0,0,,А... Мен бірдеңені ойлап едім...
Dialogue: 0,0:07:01.67,0:07:05.80,Default,,0,0,0,,Әлгі сұңқар шиыршық алып жүрді.
Dialogue: 0,0:07:06.96,0:07:07.96,Default,,0,0,0,,Қайсысы...
Dialogue: 0,0:07:08.59,0:07:10.55,Default,,0,0,0,,Уау! Ахх...
Dialogue: 0,0:07:11.47,0:07:12.64,Default,,0,0,0,,Өтінемін, менен сөйлеспеңіз.
Dialogue: 0,0:07:16.85,0:07:19.31,Default,,0,0,0,,Маған бере аласыз ба?
Dialogue: 0,0:07:19.43,0:07:21.19,Default,,0,0,0,,Джосуке Удоно
Dialogue: 0,0:07:21.52,0:07:27.28,Default,,0,0,0,,О, бұл Азуки Ваксай Лао емес пе?
Dialogue: 0,0:07:27.78,0:07:30.19,Default,,0,0,0,,Жас және жарқыраған Бебежану
Dialogue: 0,0:07:30.61,0:07:35.37,Default,,0,0,0,,Неліктен бүгін кешке байсалды нәрсені таңдайсыз?
Dialogue: 0,0:07:35.49,0:07:39.70,Default,,0,0,0,,Сол сұңқар біздің көшбасшымыз, елес сұңқар.
Dialogue: 0,0:07:40.33,0:07:45.25,Default,,0,0,0,,Бұл шиыршық сияқты көрінеді, яғни ол фантомға тиесілі болуы керек.
Dialogue: 0,0:07:46.17,0:07:49.21,Default,,0,0,0,,Әй... (Розей) Сұңқар мен шиыршық...
Dialogue: 0,0:07:49.38,0:07:53.76,Default,,0,0,0,,Бұл Кога сияқты адамдарға қол тигізуге рұқсат етілмеген нәрсе емес дегенді білдірмейді.
Dialogue: 0,0:07:53.89,0:07:55.22,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:55.60,0:07:58.22,Default,,0,0,0,,Сонда бұл жаңалық Сунпудан ма?
Dialogue: 0,0:07:58.39,0:07:59.47,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:07:59.64,0:08:03.77,Default,,0,0,0,,Маған біраз қызық.
Dialogue: 0,0:08:04.65,0:08:05.48,Default,,0,0,0,,Джосуке!
Dialogue: 0,0:08:05.86,0:08:08.61,Default,,0,0,0,,Расында да біз жаумыз.
Dialogue: 0,0:08:08.73,0:08:12.86,Default,,0,0,0,,Дегенмен, қазір ол Хаттори отбасымен келісімге байланысты.
Dialogue: 0,0:08:12.99,0:08:16.37,Default,,0,0,0,,Жақын жерде Генносуке-сама мен Оборо-саманың некесі.
Dialogue: 0,0:08:16.49,0:08:20.24,Default,,0,0,0,,Барлық біріктірілген активтер шайылып кетеді.
Dialogue: 0,0:08:21.41,0:08:24.46,Default,,0,0,0,,Біз де дос боламыз ба? Ва Ци Лао
Dialogue: 0,0:08:25.29,0:08:29.25,Default,,0,0,0,,Жарайды, достық көңілді өткізейік.
Dialogue: 0,0:08:29.67,0:08:32.13,Default,,0,0,0,,Олай болса, бұл жай ғана ойын.
Dialogue: 0,0:08:32.26,0:08:36.51,Default,,0,0,0,,Кога мен Ига, бұл кімнің жақсы екенін көру үшін ниндзя ойыны!
Dialogue: 0,0:08:41.60,0:08:43.94,Default,,0,0,0,,Мені семіз деп бағалама!
Dialogue: 0,0:08:45.35,0:08:47.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:47.23,0:08:48.56,Default,,0,0,0,,Тах!
Dialogue: 0,0:08:50.65,0:08:51.78,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:08:52.78,0:08:54.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:54.57,0:08:55.78,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:57.20,0:09:01.33,Default,,0,0,0,,Ойнап жүріп өміріңді жоғалтуың мүмкін екенін біл, Джосуке.
Dialogue: 0,0:09:01.62,0:09:05.87,Default,,0,0,0,,Ига мен Кога арасындағы татулық өте қызықты!
Dialogue: 0,0:09:08.63,0:09:09.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:15.13,0:09:18.18,Default,,0,0,0,,Иә? Жігіт! Бұл қауіпсіздік жастығы ма?
Dialogue: 0,0:09:18.30,0:09:20.89,Default,,0,0,0,,Сүйексіз құбыжық!
Dialogue: 0,0:09:22.35,0:09:24.48,Default,,0,0,0,,Ей, шымыр қария!
Dialogue: 0,0:09:24.60,0:09:27.31,Default,,0,0,0,,Мына сүйексіз құбыжық!
Dialogue: 0,0:09:38.20,0:09:39.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:39.49,0:09:40.32,Default,,0,0,0,,Хехе...
Dialogue: 0,0:09:42.49,0:09:44.04,Default,,0,0,0,,Иә! Хмм!
Dialogue: 0,0:09:47.46,0:09:49.71,Default,,0,0,0,,Мен асқабақ басын таптым!
Dialogue: 0,0:09:50.67,0:09:52.04,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:09:54.13,0:09:55.01,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:57.30,0:09:59.01,Default,,0,0,0,,Иә? (Джосуке) Ия!
Dialogue: 0,0:10:06.93,0:10:09.56,Default,,0,0,0,,(ұшатын дыбыс)
Dialogue: 0,0:10:09.73,0:10:13.94,Default,,0,0,0,,(ұшатын дыбыс)
Dialogue: 0,0:10:16.11,0:10:19.32,Default,,0,0,0,,Сыртқы түріне қарамастан, сүйектері бар сияқты.
Dialogue: 0,0:10:19.70,0:10:24.08,Default,,0,0,0,,Неліктен саған қиын болады?
Dialogue: 0,0:10:26.16,0:10:27.29,Default,,0,0,0,,Майру!
Dialogue: 0,0:10:33.29,0:10:34.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:35.34,0:10:36.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:39.13,0:10:40.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:40.76,0:10:44.56,Default,,0,0,0,,Джосуке!
Dialogue: 0,0:11:09.75,0:11:11.33,Default,,0,0,0,,(шу)
Dialogue: 0,0:11:11.46,0:11:15.38,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:11:15.50,0:11:16.84,Default,,0,0,0,,(айқай)
Dialogue: 0,0:11:18.88,0:11:20.55,Default,,0,0,0,,Хэхе... хехе...
Dialogue: 0,0:11:21.09,0:11:22.93,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:11:23.93,0:11:27.77,Default,,0,0,0,,Ига халқының дәптері Данжо-саманың қолында.
Dialogue: 0,0:11:27.89,0:11:30.43,Default,,0,0,0,,Соғыс ниндзясының жеңісі немесе жеңілісі жақын арада шешіледі.
Dialogue: 0,0:11:30.85,0:11:35.56,Default,,0,0,0,,Ол Ига Цубагакуре мен басқаларды бір түнде жояды.
Dialogue: 0,0:11:44.24,0:11:48.54,Default,,0,0,0,,Данжо-саманың жұлдызы жаман болып шықты...
Dialogue: 0,0:11:53.25,0:11:57.50,Default,,0,0,0,,Бас менеджердің де сәтсіздігінің белгілері бар.
Dialogue: 0,0:12:00.17,0:12:04.76,Default,,0,0,0,,Күте тұрыңыз! мен барамын
Dialogue: 0,0:12:35.62,0:12:36.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:37.42,0:12:41.09,Default,,0,0,0,,Ги... Генносуке-сама, мен қашан...
Dialogue: 0,0:12:41.21,0:12:43.84,Default,,0,0,0,,Сондай-ақ... Кешіріңіз.
Dialogue: 0,0:12:44.93,0:12:46.01,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:48.55,0:12:52.14,Default,,0,0,0,,Бұл тыныш уақыт болды (Оборо) Иә?
Dialogue: 0,0:12:53.39,0:12:55.94,Default,,0,0,0,,Ұйқысыз күн болған сияқты.
Dialogue: 0,0:12:57.10,0:12:59.86,Default,,0,0,0,,Иә... (Генносуке) Жасайық.
Dialogue: 0,0:13:00.57,0:13:03.99,Default,,0,0,0,,Цубагакуредегілер де алаңдау керек.
Dialogue: 0,0:13:04.32,0:13:06.70,Default,,0,0,0,,Бірақ бүгін әлі де...
Dialogue: 0,0:13:06.82,0:13:10.78,Default,,0,0,0,,Күнді өзгерту арқылы кез келген уақытта жаттығуға болады.
Dialogue: 0,0:13:10.91,0:13:13.08,Default,,0,0,0,,Иә, Генносуке-сама.
Dialogue: 0,0:13:38.52,0:13:41.15,Default,,0,0,0,,Не істеді? Обородо
Dialogue: 0,0:13:42.90,0:13:47.91,Default,,0,0,0,,Ал... Генносуке-сама тез қозғалатын сияқты...
Dialogue: 0,0:13:48.45,0:13:50.12,Default,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:13:51.28,0:13:55.20,Default,,0,0,0,,Мен мұндай нәрсе болатынына сенімдімін...
Dialogue: 0,0:13:55.45,0:13:59.29,Default,,0,0,0,,Уайымдамаңыз, мен оны сізге реттеп беремін.
Dialogue: 0,0:14:02.25,0:14:06.72,Default,,0,0,0,,Қол ұстассақ, ешқашан ажырамаймыз.
Dialogue: 0,0:14:07.01,0:14:11.30,Default,,0,0,0,,Қадамымды байқамай жылдамдата алмаймын.
Dialogue: 0,0:14:12.26,0:14:13.26,Default,,0,0,0,,Иә
Dialogue: 0,0:14:19.69,0:14:21.23,Default,,0,0,0,,Генносуке-сама?
Dialogue: 0,0:14:33.58,0:14:34.99,Default,,0,0,0,,Оборо-сама
Dialogue: 0,0:14:37.66,0:14:39.67,Default,,0,0,0,,Бұл қызыл жібек емес пе?
Dialogue: 0,0:14:40.25,0:14:43.09,Default,,0,0,0,,Не болды? осындай жерге
Dialogue: 0,0:14:44.75,0:14:46.42,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:14:46.55,0:14:48.88,Default,,0,0,0,,Оборо-саманың қайтып келуі...
Dialogue: 0,0:14:49.01,0:14:51.93,Default,,0,0,0,,Кешіктіргеніміз үшін кешірім сұраймыз.
Dialogue: 0,0:14:55.22,0:14:57.47,Default,,0,0,0,,Мен сені алып кетуге келдім.
Dialogue: 0,0:14:57.89,0:14:59.98,Default,,0,0,0,,Ненки отшағышы...
Dialogue: 0,0:15:04.19,0:15:07.48,Default,,0,0,0,,Бұл үшін кешірім сұраймын, Цубагакуре но шу.
Dialogue: 0,0:15:08.03,0:15:10.99,Default,,0,0,0,,Аман-есен жүргеніңе көңілім толды.
Dialogue: 0,0:15:11.32,0:15:14.03,Default,,0,0,0,,Сонда да таң атқанша қайта алмаймын...
Dialogue: 0,0:15:14.20,0:15:15.87,Default,,0,0,0,,Мені кешірші, Шукину
Dialogue: 0,0:15:16.08,0:15:19.58,Default,,0,0,0,,Дегенмен, егер сіз Дженносуке-самамен бірге болсаңыз, сізге уайымдаудың қажеті жоқ...
Dialogue: 0,0:15:19.71,0:15:20.83,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:15:21.37,0:15:23.79,Default,,0,0,0,,Джингоро: Сен де келдің бе?
Dialogue: 0,0:15:24.00,0:15:27.09,Default,,0,0,0,,Сунпудан елес қайтып келгенше
Dialogue: 0,0:15:27.21,0:15:29.26,Default,,0,0,0,,Оборо-сама – біздің көшбасшымыз
Dialogue: 0,0:15:29.67,0:15:33.55,Default,,0,0,0,,Осы уақытта шыдамдылық танытқаныңыз үшін рахмет.
Dialogue: 0,0:15:33.72,0:15:37.43,Default,,0,0,0,,Бұл менің кінәм болды. Кешіріңіз. Өтінемін, мені кешірші.
Dialogue: 0,0:15:37.56,0:15:38.60,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:38.93,0:15:42.81,Default,,0,0,0,,Кейде, Оборо-сама, мен неге Русайрумен кездесе алмаймын?
Dialogue: 0,0:15:42.94,0:15:44.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:44.15,0:15:48.94,Default,,0,0,0,,Аспаннан бірдеңе таптым десе, ол ешқашан оралмайды.
Dialogue: 0,0:15:49.11,0:15:51.82,Default,,0,0,0,,Келіңіздер ме? Кездеспесем де...
Dialogue: 0,0:15:53.16,0:15:54.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:54.49,0:15:55.70,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:59.12,0:16:00.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:03.58,0:16:04.42,Default,,0,0,0,,Джосуке!
Dialogue: 0,0:16:08.96,0:16:09.80,Default,,0,0,0,,Оборо…
Dialogue: 0,0:16:11.42,0:16:12.72,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:16:12.88,0:16:14.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:15.34,0:16:18.47,Default,,0,0,0,,Ах! Ахх...
Dialogue: 0,0:16:19.89,0:16:21.64,Default,,0,0,0,,Итатата...
Dialogue: 0,0:16:21.77,0:16:24.23,Default,,0,0,0,,Сіз не істеп жатырсыз? Джосуке (Джосуке) Иә?
Dialogue: 0,0:16:24.35,0:16:27.11,Default,,0,0,0,,Ах! Ген… Генносуке-сама
Dialogue: 0,0:16:27.23,0:16:31.32,Default,,0,0,0,,Өтінемін, Оборо-самаға маған қарамасын... басқа жаққа қарасын!
Dialogue: 0,0:16:31.61,0:16:35.28,Default,,0,0,0,,Менде... Менде ештеңе жоқ... (Генносуке) Мен білемін.
Dialogue: 0,0:16:36.78,0:16:40.83,Default,,0,0,0,,Бұлыңғыр көздер елеспен туады.
Dialogue: 0,0:16:41.87,0:16:45.29,Default,,0,0,0,,Техника емес, техника емес...
Dialogue: 0,0:16:45.83,0:16:50.88,Default,,0,0,0,,Құбыжықтар сияқты ниндзялардың сиқырын оңай бұзатын жұмбақ көздер.
Dialogue: 0,0:16:52.80,0:16:55.30,Default,,0,0,0,,Балалар! (Шину және т.б.) Руси!
Dialogue: 0,0:16:55.43,0:16:59.30,Default,,0,0,0,,Джосукенің кеудесіндегі шиыршықты қайтарып ал! (Джосуке) А?
Dialogue: 0,0:16:59.43,0:17:02.60,Default,,0,0,0,,Бұл елес шиыршық! (Джосуке) А...
Dialogue: 0,0:17:08.65,0:17:10.65,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:17:12.61,0:17:15.15,Default,,0,0,0,,Сіз нені айтасыз? Джосуке
Dialogue: 0,0:17:15.40,0:17:20.20,Default,,0,0,0,,Жоқ, солай... Роузимен шиыршық үшін нинпо сайысы...
Dialogue: 0,0:17:21.12,0:17:24.41,Default,,0,0,0,,А, жоқ, жоқ, нинпо ойнайық...
Dialogue: 0,0:17:24.58,0:17:26.08,Default,,0,0,0,,Бұл... (Генносуке) Міне!
Dialogue: 0,0:17:26.62,0:17:27.50,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:17:27.88,0:17:30.17,Default,,0,0,0,,Кешірім сұраймыз!
Dialogue: 0,0:17:31.59,0:17:33.51,Default,,0,0,0,,Жүр, тұманның ішіне қара.
Dialogue: 0,0:17:33.67,0:17:35.84,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,0:17:36.51,0:17:39.97,Default,,0,0,0,,Оны Генносуке-саманың алдында ашпа!
Dialogue: 0,0:17:40.10,0:17:43.22,Default,,0,0,0,,Не... нені айтып тұрсыз? Джингоро
Dialogue: 0,0:17:43.60,0:17:46.94,Default,,0,0,0,,Бұл елестетілген шиыршық
Dialogue: 0,0:17:47.14,0:17:49.56,Default,,0,0,0,,Егер мен оны Кога тобының көзіне түсірсем ше?
Dialogue: 0,0:17:49.69,0:17:53.28,Default,,0,0,0,,Сен жоқта тұрудың қажеті жоқ.
Dialogue: 0,0:17:53.40,0:17:56.24,Default,,0,0,0,,Джиноро! Генносуке-сама қазірдің өзінде...
Dialogue: 0,0:17:56.82,0:17:59.99,Default,,0,0,0,,Құттықтаулар әлі алыс, Оборо-сама.
Dialogue: 0,0:18:02.28,0:18:05.62,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:18:07.00,0:18:08.46,Default,,0,0,0,,Нушира…
Dialogue: 0,0:18:08.62,0:18:11.04,Default,,0,0,0,,Айтатата…
Dialogue: 0,0:18:11.71,0:18:14.42,Default,,0,0,0,,Бұл сәл дөрекі болар еді.
Dialogue: 0,0:18:14.55,0:18:16.97,Default,,0,0,0,,Генносуке-сама Когаманданиден...
Dialogue: 0,0:18:18.84,0:18:20.39,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:18:20.64,0:18:23.31,Default,,0,0,0,,Егер мағынасы болса, мен оны алып тастаймын.
Dialogue: 0,0:18:24.14,0:18:25.14,Default,,0,0,0,,Джосуке!
Dialogue: 0,0:18:26.02,0:18:28.19,Default,,0,0,0,,Ах, Генносуке-сама...
Dialogue: 0,0:18:28.31,0:18:30.81,Default,,0,0,0,,Джингоро ақымақ!
Dialogue: 0,0:18:31.02,0:18:32.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:33.23,0:18:35.65,Default,,0,0,0,,Генносуке-сама, Удоно-сама!
Dialogue: 0,0:18:35.98,0:18:38.70,Default,,0,0,0,,Қолайсыздықты кешіріңіз.
Dialogue: 0,0:18:38.82,0:18:41.28,Default,,0,0,0,,Бұл мүмкін емес (Оборо) Иә?
Dialogue: 0,0:18:41.41,0:18:45.29,Default,,0,0,0,,Екі отбасының тарихын қарастыратын болсақ, бұл табиғи нәрсе.
Dialogue: 0,0:18:45.66,0:18:48.16,Default,,0,0,0,,Енді біз бидғатшылармыз.
Dialogue: 0,0:18:48.29,0:18:49.62,Default,,0,0,0,,бидғат? (Генносуке) Иә.
Dialogue: 0,0:18:50.58,0:18:53.29,Default,,0,0,0,,Мұны шешу оңай емес.
Dialogue: 0,0:18:53.42,0:18:55.88,Default,,0,0,0,,Ашулана берсем... (Оборо) А...
Dialogue: 0,0:18:56.17,0:19:01.09,Default,,0,0,0,,Саған шиыршық лақтырсам, ұятқа қалар едім.
Dialogue: 0,0:19:02.22,0:19:05.39,Default,,0,0,0,,Болмайтын нәрсені жібере алмаймын десең де...
Dialogue: 0,0:19:06.06,0:19:07.98,Default,,0,0,0,,Мақсат белгілі болды.
Dialogue: 0,0:19:08.35,0:19:09.48,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:10.10,0:19:12.94,Default,,0,0,0,,Ухуху... Ухуху...
Dialogue: 0,0:19:15.69,0:19:16.98,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:17.78,0:19:21.91,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:19:22.03,0:19:24.32,Default,,0,0,0,,Джингоро: Әжең не дейді?
Dialogue: 0,0:19:25.62,0:19:26.45,Default,,0,0,0,,Джингоро!
Dialogue: 0,0:19:26.70,0:19:29.91,Default,,0,0,0,,Өтінемін... сенімді болыңыз, Оборо-сама.
Dialogue: 0,0:19:30.04,0:19:33.96,Default,,0,0,0,,Сунпуда Кога мен Иганың арасындағы бейбітшілік толығымен қамтамасыз етілді.
Dialogue: 0,0:19:34.67,0:19:36.96,Default,,0,0,0,,Апай мен Данжо Кога бірге
Dialogue: 0,0:19:37.09,0:19:39.84,Default,,0,0,0,,Көктемде Эдоның көрікті жерлерін аралап, үйге қайтқанда...
Dialogue: 0,0:19:39.97,0:19:41.97,Default,,0,0,0,,Бұл жақсы жаңалық!
Dialogue: 0,0:19:42.22,0:19:43.26,Default,,0,0,0,,Хо…
Dialogue: 0,0:19:46.64,0:19:49.47,Default,,0,0,0,,Дөрекілігім үшін кешіріңіз, Генносуке-сама.
Dialogue: 0,0:19:49.60,0:19:53.77,Default,,0,0,0,,Бұл да шинобидің (Генносуке) мұңды табиғаты, маған бәрібір.
Dialogue: 0,0:19:54.23,0:19:57.23,Default,,0,0,0,,Сіз қалай ойлайсыз? Жақсы мүмкіндік болса...
Dialogue: 0,0:19:57.36,0:20:00.19,Default,,0,0,0,,Неге Игаға дейін бармайсың?
Dialogue: 0,0:20:00.32,0:20:03.16,Default,,0,0,0,,Ал, Ненки! Бұл жақсы идея
Dialogue: 0,0:20:04.95,0:20:08.04,Default,,0,0,0,,Келіңізші, Генносуке-сама.
Dialogue: 0,0:20:10.62,0:20:13.54,Default,,0,0,0,,Жарайды, Игаға барайық. (Джосуке) Хмм...
Dialogue: 0,0:20:13.67,0:20:16.00,Default,,0,0,0,,Не? Эй... сәл күте тұрыңыз!
Dialogue: 0,0:20:16.13,0:20:19.42,Default,,0,0,0,,Бұл тым абайсызда!
Dialogue: 0,0:20:20.30,0:20:22.80,Default,,0,0,0,,Уау... Ах!
Dialogue: 0,0:20:23.55,0:20:27.14,Default,,0,0,0,,Жүріңіз, лорд Корморант, бізбен бірге жүріңіз.
Dialogue: 0,0:20:28.31,0:20:31.35,Default,,0,0,0,,Жоқ, у... Иә, дұрыс...
Dialogue: 0,0:20:31.77,0:20:35.90,Default,,0,0,0,,Иә, жоқ, Цубагакуре жақсы жер хаха...
Dialogue: 0,0:20:36.77,0:20:39.98,Default,,0,0,0,,Жабайы көкөністерді жинап алғаннан кейін т.б.
Dialogue: 0,0:20:40.11,0:20:43.49,Default,,0,0,0,,Қонақтарыңызға дөрекілік көрсетпеңіз.
Dialogue: 0,0:20:44.53,0:20:47.57,Default,,0,0,0,,Иә, мен бәрін түсінемін.
Dialogue: 0,0:20:50.87,0:20:52.00,Default,,0,0,0,,Өрт сөндіруші…
Dialogue: 0,0:20:52.29,0:20:55.00,Default,,0,0,0,,Тензенге хабарлау (От бляшка) Мен оны білдім.
Dialogue: 0,0:21:14.23,0:21:17.48,Default,,0,0,0,,Иллюзия өлді.
Dialogue: 0,0:21:17.65,0:21:18.98,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:20.11,0:21:21.11,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:21:21.44,0:21:24.11,Default,,0,0,0,,Кога Данжо да қайтыс болды.
Dialogue: 0,0:21:25.20,0:21:26.91,Default,,0,0,0,,Мүмкін өзара кек алу
Dialogue: 0,0:21:29.45,0:21:31.83,Default,,0,0,0,,Екеуі де олардың сүйіктісі болар еді.
Dialogue: 0,0:21:32.95,0:21:36.16,Default,,0,0,0,,Тензен-саманың «құрметі» қандай?
Dialogue: 0,0:21:37.58,0:21:39.04,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:21:40.42,0:21:42.92,Default,,0,0,0,,Саған әлі ерте, аңғал адам.
Dialogue: 0,0:21:48.97,0:21:50.85,Default,,0,0,0,,А... хех хе...
Dialogue: 0,0:21:52.26,0:21:54.39,Default,,0,0,0,,Бұл ақыры шешілді...
Dialogue: 0,0:21:56.23,0:22:00.56,Default,,0,0,0,,Ига мен Коганы Теншодан байланыстырған соғыс болмайтын келісім...
Dialogue: 0,0:22:02.02,0:22:04.90,Default,,0,0,0,,Ол ақырында шешілді
Dialogue: 0,0:22:06.49,0:22:10.24,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.95,0:23:35.78,Default,,0,0,0,,～♪
Dialogue: 0,0:23:41.21,0:23:43.67,Default,,0,0,0,,Соғыс болмаймын деген уәде жойылды.
Dialogue: 0,0:23:44.25,0:23:48.00,Default,,0,0,0,,Көк қараңғылық қойнауына жындар тобы жіберіледі.
Dialogue: 0,0:23:49.01,0:23:52.01,Default,,0,0,0,,Шаңға толы аң ізі өрмекші торы
Dialogue: 0,0:23:52.59,0:23:55.55,Default,,0,0,0,,Гүлденген ірі фаленопсис гүлдері
Dialogue: 0,0:23:55.97,0:23:58.64,Default,,0,0,0,,Желімдей қыбырлаған бейтаныс адам
Dialogue: 0,0:24:00.10,0:24:02.77,Default,,0,0,0,,Келесі жолы «Basilisk ~Koga Ninja Scroll~»
Dialogue: 0,0:24:04.27,0:24:10.27,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
