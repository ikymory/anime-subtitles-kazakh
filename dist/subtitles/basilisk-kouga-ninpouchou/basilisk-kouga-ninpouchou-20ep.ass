Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.34,0:00:11.01,Default,,0,0,0,,Бірін-бірі жек көретін адамдар болды
Dialogue: 0,0:00:12.92,0:00:17.68,Default,,0,0,0,,Далада дене шіриді, рух қанға боялады.
Dialogue: 0,0:00:20.31,0:00:23.77,Default,,0,0,0,,Байланыс пышақпен бөлінді
Dialogue: 0,0:00:23.94,0:00:26.98,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:00:32.53,0:00:33.49,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:37.37,0:00:38.66,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:39.78,0:00:42.37,Default,,0,0,0,,Қараңғылықтың шынайылығы жылайды
Dialogue: 0,0:00:42.50,0:00:43.91,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:00:45.33,0:00:49.42,Default,,0,0,0,,Сүйіктім, өлуге дайын
Dialogue: 0,0:01:01.51,0:01:06.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:26.72,0:02:30.56,Default,,0,0,0,,～♪
Dialogue: 0,0:02:45.79,0:02:48.08,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:02:59.01,0:03:00.22,Default,,0,0,0,,Гомен
Dialogue: 0,0:03:02.01,0:03:03.43,Default,,0,0,0,,Ах, Тензен-сама...
Dialogue: 0,0:03:12.10,0:03:15.69,Default,,0,0,0,,Фантом қоңырау шалып жатыр.
Dialogue: 0,0:03:18.69,0:03:21.36,Default,,0,0,0,,Тензен сонатасы...
Dialogue: 0,0:03:21.95,0:03:26.28,Default,,0,0,0,,Ода шабуылы кезінде қайда бардыңыз?
Dialogue: 0,0:03:26.87,0:03:28.91,Default,,0,0,0,,Жанашыр
Dialogue: 0,0:03:29.04,0:03:33.46,Default,,0,0,0,,Танегасиманы жеп, тез өлді.
Dialogue: 0,0:03:37.34,0:03:39.17,Default,,0,0,0,,Айтпақшы, иллюзия
Dialogue: 0,0:03:39.80,0:03:43.76,Default,,0,0,0,,Сіз Кога Данжоны тоқтата алмаған сияқтысыз.
Dialogue: 0,0:03:43.93,0:03:44.76,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:45.26,0:03:49.60,Default,,0,0,0,,Жоқ, сіздің денеңіз оған төтеп бере алмайды.
Dialogue: 0,0:03:50.48,0:03:53.98,Default,,0,0,0,,Біздің туымыз болып табылатын иллюзия
Dialogue: 0,0:03:54.60,0:03:58.23,Default,,0,0,0,,Жүрегін менсінбеген Кога Данжо
Dialogue: 0,0:03:59.23,0:04:01.78,Default,,0,0,0,,Өйткені ол аман қалды...
Dialogue: 0,0:04:01.90,0:04:05.53,Default,,0,0,0,,Иганың бірлігі нығая түсті.
Dialogue: 0,0:04:08.53,0:04:10.54,Default,,0,0,0,,Сонымен.
Dialogue: 0,0:04:17.59,0:04:18.54,Default,,0,0,0,,Тензен
Dialogue: 0,0:04:22.26,0:04:23.55,Default,,0,0,0,,Сіз...
Dialogue: 0,0:04:27.97,0:04:31.18,Default,,0,0,0,,А... хех хе...
Dialogue: 0,0:04:32.14,0:04:35.35,Default,,0,0,0,,Әже, өткен күндерге өкініш...
Dialogue: 0,0:04:35.69,0:04:38.31,Default,,0,0,0,,Мен оны ешқашан қайталамаймын.
Dialogue: 0,0:04:41.86,0:04:43.74,Default,,0,0,0,,Оборо-самаға...
Dialogue: 0,0:04:43.86,0:04:48.20,Default,,0,0,0,,Генносуке Коганы өз қолыммен жерлеуге рұқсат етіңіз.
Dialogue: 0,0:05:10.68,0:05:13.52,Default,,0,0,0,,(ағаштардың сықырлауы)
Dialogue: 0,0:05:14.18,0:05:16.02,Default,,0,0,0,,Бұл жағымсыз дыбыс.
Dialogue: 0,0:05:17.15,0:05:21.02,Default,,0,0,0,,Өлгендердің қарғыс атқан дауыстары шығар.
Dialogue: 0,0:05:24.82,0:05:26.49,Default,,0,0,0,,Генносуке-сама
Dialogue: 0,0:05:26.61,0:05:31.41,Default,,0,0,0,,Заттардың механизмін білгенде жүрегің дірілдеген жоқ па?
Dialogue: 0,0:05:35.58,0:05:37.17,Default,,0,0,0,,Енді тоқтай алмаймын
Dialogue: 0,0:05:39.17,0:05:41.71,Default,,0,0,0,,Көп қан төгілді
Dialogue: 0,0:05:42.05,0:05:45.72,Default,,0,0,0,,Кога мен Ига, егер олардың біреуі өлмесе...
Dialogue: 0,0:05:46.88,0:05:48.22,Default,,0,0,0,,Енді біткен жоқ
Dialogue: 0,0:05:49.76,0:05:50.76,Default,,0,0,0,,Ннн…
Dialogue: 0,0:05:56.14,0:05:57.69,Default,,0,0,0,,Генносуке-сама ше?
Dialogue: 0,0:05:57.81,0:06:01.11,Default,,0,0,0,,Мен біразға дейін жасырынуды шештім.
Dialogue: 0,0:06:01.77,0:06:04.82,Default,,0,0,0,,Иганы Токугава жағы қорғайтындықтан
Dialogue: 0,0:06:05.11,0:06:07.36,Default,,0,0,0,,Іс бұрынғыдай болмайды.
Dialogue: 0,0:06:07.49,0:06:09.36,Default,,0,0,0,,Дегенмен, Генносуке-сама...
Dialogue: 0,0:06:09.49,0:06:13.99,Default,,0,0,0,,Ол Обораны жеңуге шешім қабылдады... Ига.
Dialogue: 0,0:06:15.04,0:06:16.50,Default,,0,0,0,,Міне.
Dialogue: 0,0:06:17.91,0:06:22.38,Default,,0,0,0,,Көшбасшы, Генносуке, кез келген жағдайда аман қалуы керек.
Dialogue: 0,0:06:22.75,0:06:26.63,Default,,0,0,0,,Біз шынайы тілектерімізді орындауымыз керек.
Dialogue: 0,0:06:27.80,0:06:30.01,Default,,0,0,0,,Міне, тұман
Dialogue: 0,0:06:30.97,0:06:34.14,Default,,0,0,0,,Бұл күн шығып, батқанда...
Dialogue: 0,0:06:34.31,0:06:37.68,Default,,0,0,0,,Алдағы уақытта қанша өмір бірге өледі...
Dialogue: 0,0:06:41.06,0:06:43.36,Default,,0,0,0,,Осы пішінде шашырасаңыз...
Dialogue: 0,0:06:43.82,0:06:46.69,Default,,0,0,0,,Күн мен түннің теңелу күнін күтіп отырған Кога халқына
Dialogue: 0,0:06:47.07,0:06:50.03,Default,,0,0,0,,Бұл ең болмағанда кәдесый болуы мүмкін.
Dialogue: 0,0:06:50.70,0:06:51.99,Default,,0,0,0,,Саймон ше...
Dialogue: 0,0:06:52.57,0:06:53.57,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:59.54,0:07:03.67,Default,,0,0,0,,(сөйлеу)
Dialogue: 0,0:07:07.00,0:07:08.76,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:07:10.26,0:07:12.14,Default,,0,0,0,,Ах, Оборо-сама...
Dialogue: 0,0:07:12.76,0:07:15.47,Default,,0,0,0,,Оборо-сама болмайды
Dialogue: 0,0:07:15.81,0:07:18.35,Default,,0,0,0,,Мен Шукинмен жүргім келеді
Dialogue: 0,0:07:18.68,0:07:22.31,Default,,0,0,0,,Не? (Оборо) Мен бұл аяқтармен жерді мықтап басып кеткім келеді
Dialogue: 0,0:07:23.02,0:07:25.11,Default,,0,0,0,,Мен ұмытпаймын
Dialogue: 0,0:07:25.77,0:07:27.61,Default,,0,0,0,,(айқай)
Dialogue: 0,0:07:27.90,0:07:30.70,Default,,0,0,0,,Біз тіріміз.
Dialogue: 0,0:07:31.24,0:07:32.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:33.07,0:07:34.45,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:34.82,0:07:37.45,Default,,0,0,0,,Кога сізді қашан нысанаға алады?
Dialogue: 0,0:07:38.08,0:07:39.83,Default,,0,0,0,,Өзіңіз туралы хабардар болыңыз!
Dialogue: 0,0:07:40.33,0:07:43.96,Default,,0,0,0,,Жақында кетесің, орныңды ал! (вассаалдар) Ха!
Dialogue: 0,0:07:51.42,0:07:53.59,Default,,0,0,0,,(айқай)
Dialogue: 0,0:08:02.06,0:08:05.61,Default,,0,0,0,,Тіпті кешкі асқа да тимеген.
Dialogue: 0,0:08:05.98,0:08:07.65,Default,,0,0,0,,Өте орынды.
Dialogue: 0,0:08:07.82,0:08:11.82,Default,,0,0,0,,Мұрагер шешілгенше өмір сүргенше...
Dialogue: 0,0:08:12.24,0:08:13.91,Default,,0,0,0,,Иә? Ха...
Dialogue: 0,0:08:19.58,0:08:21.37,Default,,0,0,0,,Сіз! Қайда бара жатырсың?
Dialogue: 0,0:08:22.16,0:08:23.41,Default,,0,0,0,,(айқай)
Dialogue: 0,0:08:24.87,0:08:28.34,Default,,0,0,0,,Бүгін түнде бір дворян осында болады.
Dialogue: 0,0:08:28.46,0:08:29.88,Default,,0,0,0,,Басқа қонақ үйге барыңыз!
Dialogue: 0,0:08:30.25,0:08:33.97,Default,,0,0,0,,Мм... Ол асыл азамат кім?
Dialogue: 0,0:08:34.22,0:08:36.39,Default,,0,0,0,,Бұл сіз білетін нәрсе емес!
Dialogue: 0,0:08:36.72,0:08:39.10,Default,,0,0,0,,Эй, қазір кет!
Dialogue: 0,0:08:39.93,0:08:40.97,Default,,0,0,0,,(айқай)
Dialogue: 0,0:08:41.14,0:08:43.98,Default,,0,0,0,,Аа... аа...
Dialogue: 0,0:08:44.14,0:08:45.98,Default,,0,0,0,,Мынау... мына жігіт! (Вассал) Сен алаяқ!
Dialogue: 0,0:08:49.15,0:08:51.65,Default,,0,0,0,,Ннн…
Dialogue: 0,0:08:52.57,0:08:53.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:54.70,0:08:55.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:56.03,0:08:59.41,Default,,0,0,0,,Ууу
Dialogue: 0,0:08:59.58,0:09:00.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.95,0:09:02.91,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:09:03.25,0:09:05.29,Default,,0,0,0,,Сіз ән жазушысыз!
Dialogue: 0,0:09:13.30,0:09:15.59,Default,,0,0,0,,Әй, Тензен-сама!
Dialogue: 0,0:09:16.68,0:09:18.55,Default,,0,0,0,,Күте тұрыңыз! Жоқ!
Dialogue: 0,0:09:18.93,0:09:21.18,Default,,0,0,0,,Бұл адам біз жақта!
Dialogue: 0,0:09:23.47,0:09:24.31,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:24.48,0:09:25.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:32.02,0:09:34.74,Default,,0,0,0,,Кешіріңіз, Тензен-сама.
Dialogue: 0,0:09:34.86,0:09:37.57,Default,,0,0,0,,Мен сізге хабарлағанмын...
Dialogue: 0,0:09:39.57,0:09:41.53,Default,,0,0,0,,Ах... (Шину) Бұл адамдар...
Dialogue: 0,0:09:41.66,0:09:46.41,Default,,0,0,0,,Шогунаттың тақ мұрагері, Такечионың дымқыл емшісі Афуку-сама
Dialogue: 0,0:09:46.71,0:09:48.58,Default,,0,0,0,,Қызметшілеріңізге
Dialogue: 0,0:09:49.04,0:09:50.59,Default,,0,0,0,,Шогун отбасымен?
Dialogue: 0,0:09:51.17,0:09:54.88,Default,,0,0,0,,Лорд Тензен, лорд Афукумен танысыңыз.
Dialogue: 0,0:09:55.26,0:09:57.88,Default,,0,0,0,,Біз не үшін келдік?
Dialogue: 0,0:09:58.09,0:10:01.18,Default,,0,0,0,,Жоқ... Менің бұған уақытым жоқ.
Dialogue: 0,0:10:02.05,0:10:03.56,Default,,0,0,0,,Кагеро
Dialogue: 0,0:10:04.39,0:10:06.77,Default,,0,0,0,,Кога тобының кагеросын тапты.
Dialogue: 0,0:10:06.93,0:10:07.77,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:07.89,0:10:11.02,Default,,0,0,0,,Югуре көпірінде біреу біреуді күтіп тұрған сияқты
Dialogue: 0,0:10:11.40,0:10:17.19,Default,,0,0,0,,Біріншіден, Генносуке Кога мен Заемон Кисарагидің айырмашылығы жоқ.
Dialogue: 0,0:10:17.32,0:10:20.99,Default,,0,0,0,,Әй... Кога болса, біз де қосыламыз!
Dialogue: 0,0:10:21.20,0:10:25.16,Default,,0,0,0,,Қоға халқын бізге қалдыр.
Dialogue: 0,0:10:25.62,0:10:28.75,Default,,0,0,0,,Сіздің алдыңызда күшті қарсылас емес
Dialogue: 0,0:10:29.83,0:10:33.46,Default,,0,0,0,,Сонымен қатар, Иганың құрметіне...
Dialogue: 0,0:10:34.00,0:10:38.01,Default,,0,0,0,,Біреуге қалдыра алмайтын өшпенділік болса.
Dialogue: 0,0:10:38.51,0:10:41.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:42.97,0:10:46.43,Default,,0,0,0,,Кагеро - Кошироны өлтірген қыз.
Dialogue: 0,0:10:46.60,0:10:47.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:48.89,0:10:51.56,Default,,0,0,0,,Бұл... Коширо...
Dialogue: 0,0:10:51.94,0:10:55.44,Default,,0,0,0,,Менің ойымша, оны Мурога Хёума өлтірді...
Dialogue: 0,0:10:56.69,0:10:58.32,Default,,0,0,0,,Не болса да
Dialogue: 0,0:10:58.44,0:11:00.28,Default,,0,0,0,,Кагеро есімді қыз...
Dialogue: 0,0:11:00.57,0:11:04.53,Default,,0,0,0,,Еркекпен араласқанда тынысың уға айналатын сияқты.
Dialogue: 0,0:11:06.04,0:11:09.00,Default,,0,0,0,,Кошироның денесінде ешқандай жарақат болған жоқ, солай ма?
Dialogue: 0,0:11:11.71,0:11:14.92,Default,,0,0,0,,Оның техникасы қыздарда жұмыс істемейді.
Dialogue: 0,0:11:15.88,0:11:17.42,Default,,0,0,0,,Егер сіз...
Dialogue: 0,0:11:17.55,0:11:19.09,Default,,0,0,0,,Тензен-сама! (Тенцэн) Ха...
Dialogue: 0,0:11:20.17,0:11:23.89,Default,,0,0,0,,Біраз күткеніңізге рахмет.
Dialogue: 0,0:11:24.01,0:11:25.30,Default,,0,0,0,,Қызыл жібек…
Dialogue: 0,0:11:37.98,0:11:39.28,Default,,0,0,0,,Ннн…
Dialogue: 0,0:11:48.37,0:11:51.58,Default,,0,0,0,,Ха... Тензен-сама
Dialogue: 0,0:11:54.13,0:11:57.63,Default,,0,0,0,,Шукин...
Dialogue: 0,0:11:58.42,0:12:00.80,Default,,0,0,0,,Өткізіп алма, Тензен-сама!
Dialogue: 0,0:12:00.92,0:12:04.43,Default,,0,0,0,,Өзі жеккөрінішті жау болса да, Оборо-саманың қамын ойлайтын адам.
Dialogue: 0,0:12:04.64,0:12:06.51,Default,,0,0,0,,Ең болмағанда естелік ретінде...
Dialogue: 0,0:12:15.02,0:12:16.27,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:12:16.48,0:12:17.73,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:20.48,0:12:23.82,Default,,0,0,0,,Көрмегендей кейіп танытамын (Шину) Ах...
Dialogue: 0,0:12:36.08,0:12:39.09,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:39.21,0:12:44.72,Default,,0,0,0,,Сонда әлгі Афуку жігіттері Кога халқын өздері құлатады ма?
Dialogue: 0,0:12:45.22,0:12:46.68,Default,,0,0,0,,Ах... иә
Dialogue: 0,0:12:47.22,0:12:48.64,Default,,0,0,0,,Тавакега!
Dialogue: 0,0:12:49.68,0:12:53.93,Default,,0,0,0,,Мұрагерлікке қатысты даулар сияқты нәрселердің бізге еш қатысы жоқ.
Dialogue: 0,0:12:54.73,0:12:59.73,Default,,0,0,0,,Бар жалғыз нәрсе - Ига мен Кога арасындағы бұрыннан келе жатқан өшпенділіктің шешілуі.
Dialogue: 0,0:13:00.27,0:13:01.82,Default,,0,0,0,,Солай емес пе!
Dialogue: 0,0:13:03.57,0:13:06.28,Default,,0,0,0,,Егер сіз біреудің көмегін қарызға алсаңыз...
Dialogue: 0,0:13:06.41,0:13:08.99,Default,,0,0,0,,Шашылғандар кетпесін
Dialogue: 0,0:13:09.16,0:13:10.37,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:11.24,0:13:16.08,Default,,0,0,0,,Мен де... Менде де сондай сезім болды.
Dialogue: 0,0:13:16.71,0:13:20.67,Default,,0,0,0,,Қоғалықтардың әрқайсысын қанға бояуға тиіспіз.
Dialogue: 0,0:13:21.71,0:13:25.76,Default,,0,0,0,,Ига... Менің шайқасым ешқашан бітпейді
Dialogue: 0,0:13:27.05,0:13:28.05,Default,,0,0,0,,Тек...
Dialogue: 0,0:13:29.09,0:13:32.43,Default,,0,0,0,,Тек соқыр Оборо-сама...
Dialogue: 0,0:13:32.60,0:13:33.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:33.77,0:13:38.44,Default,,0,0,0,,Мен Оборо-саманың Сунпуға аман-есен жеткізілгенін қалаймын...
Dialogue: 0,0:13:44.69,0:13:47.70,Default,,0,0,0,,Макото, ессіздер.
Dialogue: 0,0:13:47.99,0:13:50.37,Default,,0,0,0,,Мен ниндзя жұмбағына еш қатысым жоқ, бірақ...
Dialogue: 0,0:13:50.70,0:13:52.45,Default,,0,0,0,,Лорд Афукуның хабары
Dialogue: 0,0:13:54.70,0:13:55.70,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:58.92,0:14:02.17,Default,,0,0,0,,Сен... Сен... Сен...
Dialogue: 0,0:14:29.53,0:14:32.32,Default,,0,0,0,,Генносуке Коганың Шинобюі... (Шукину) Иә?
Dialogue: 0,0:14:32.45,0:14:36.75,Default,,0,0,0,,Сен оны Цубагакуреден алдың ба? (Шину) Иә.
Dialogue: 0,0:14:37.87,0:14:39.33,Default,,0,0,0,,Мүмкін бұл...
Dialogue: 0,0:14:39.67,0:14:44.46,Default,,0,0,0,,Бұл Генносуке Коганың Оборо-самамен қоштасуының белгісі сияқты.
Dialogue: 0,0:14:44.80,0:14:49.22,Default,,0,0,0,,Олай болса, оны кейінгі өміріңізде неге сонша ұқыпты ұстадыңыз?
Dialogue: 0,0:14:50.30,0:14:55.97,Default,,0,0,0,,Бұл Оборо-саманың ұзаққа созылған сезімдерін тоқтату үшін тамаша нәрсе болар еді.
Dialogue: 0,0:14:57.02,0:14:58.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:59.56,0:15:03.23,Default,,0,0,0,,Макото Адамның жүрегі сияқты――
Dialogue: 0,0:15:03.56,0:15:06.23,Default,,0,0,0,,Еш нәрсе өлшеусіз емес (Шину) Иә?
Dialogue: 0,0:15:06.57,0:15:09.32,Default,,0,0,0,,Жау жүректі былай қойғанда...
Dialogue: 0,0:15:09.45,0:15:13.32,Default,,0,0,0,,Қанша ақымақ болсаң да, жауап ешқашан келмейді.
Dialogue: 0,0:15:17.29,0:15:18.12,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:18.50,0:15:20.21,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:15:22.75,0:15:24.75,Default,,0,0,0,,Кеттік, Шукину
Dialogue: 0,0:15:25.88,0:15:26.71,Default,,0,0,0,,Иә
Dialogue: 0,0:15:40.48,0:15:41.48,Default,,0,0,0,,(шу)
Dialogue: 0,0:15:44.44,0:15:48.86,Default,,0,0,0,,Генносуке әлі келмеді ме?
Dialogue: 0,0:15:55.87,0:15:58.49,Default,,0,0,0,,Мм! Бұл ойын!
Dialogue: 0,0:16:00.66,0:16:02.71,Default,,0,0,0,,Мен күткен нәрсе болды-
Dialogue: 0,0:16:03.17,0:16:05.71,Default,,0,0,0,,Бұл сенсің, Шукину (Шину) ха...
Dialogue: 0,0:16:10.30,0:16:12.01,Default,,0,0,0,,Кагеро!
Dialogue: 0,0:16:12.17,0:16:13.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:15.26,0:16:16.72,Default,,0,0,0,,(ұнтақтау қалақтарының дыбысы)
Dialogue: 0,0:16:18.89,0:16:21.73,Default,,0,0,0,,Оген-сама Роузи-до Ненки-до...
Dialogue: 0,0:16:21.89,0:16:25.19,Default,,0,0,0,,Джингоро ше, Хотаруби ше, Яшамару ше!
Dialogue: 0,0:16:26.19,0:16:28.77,Default,,0,0,0,,Кошироның жауы!
Dialogue: 0,0:16:29.90,0:16:31.03,Default,,0,0,0,,Уууу…
Dialogue: 0,0:16:31.24,0:16:33.20,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:16:34.49,0:16:35.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:36.12,0:16:37.99,Default,,0,0,0,,(Тері дірілдеген дыбыс)
Dialogue: 0,0:16:39.33,0:16:43.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:44.92,0:16:45.79,Default,,0,0,0,,Уф…
Dialogue: 0,0:16:51.51,0:16:54.93,Default,,0,0,0,,Өл, Кагеру!
Dialogue: 0,0:16:55.09,0:16:57.89,Default,,0,0,0,,А... Тензен-сама!
Dialogue: 0,0:17:01.27,0:17:02.52,Default,,0,0,0,,Ннн…
Dialogue: 0,0:17:04.94,0:17:07.27,Default,,0,0,0,,Ннн! (Вермилион) А...
Dialogue: 0,0:17:14.99,0:17:16.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:19.24,0:17:20.24,Default,,0,0,0,,Ахх...
Dialogue: 0,0:17:23.00,0:17:25.37,Default,,0,0,0,,Ақырында тұман да өтеді.
Dialogue: 0,0:17:26.87,0:17:31.09,Default,,0,0,0,,Қаныңмен тозақтың шықын сүрт.
Dialogue: 0,0:17:31.88,0:17:34.63,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:17:39.64,0:17:40.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:42.81,0:17:43.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:49.73,0:17:51.07,Default,,0,0,0,,Ахх...
Dialogue: 0,0:17:53.69,0:17:54.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:16.30,0:18:19.89,Default,,0,0,0,,Кога мен Ига бір адамдар.
Dialogue: 0,0:18:20.47,0:18:25.85,Default,,0,0,0,,Кек деген қарғысты тастап, бұлыңғыр көзіңді аш.
Dialogue: 0,0:18:26.98,0:18:30.40,Default,,0,0,0,,Игадан бір адам болса да
Dialogue: 0,0:18:31.11,0:18:34.11,Default,,0,0,0,,Алдымен толығырақ қарастырайық.
Dialogue: 0,0:18:35.57,0:18:39.82,Default,,0,0,0,,Енді білуге ​​мүмкіндік жоқ.
Dialogue: 0,0:18:42.87,0:18:45.70,Default,,0,0,0,,Кагеро, біз...
Dialogue: 0,0:18:46.12,0:18:49.75,Default,,0,0,0,,Сіз Саймон Додоны сәтті тартып алдыңыз.
Dialogue: 0,0:18:49.87,0:18:50.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:51.54,0:18:54.17,Default,,0,0,0,,Енді жалғыз Оборо қалды.
Dialogue: 0,0:18:55.30,0:19:00.26,Default,,0,0,0,,Саймон мен Обороның рөлі менікі болады!
Dialogue: 0,0:19:02.59,0:19:06.35,Default,,0,0,0,,Бұлыңғыр көздер жұмылды.
Dialogue: 0,0:19:06.52,0:19:07.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:09.23,0:19:10.06,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:20.03,0:19:21.07,Default,,0,0,0,,(жылжымалы есіктің ашылу дыбысы)
Dialogue: 0,0:19:26.16,0:19:27.58,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:44.34,0:19:46.51,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:47.68,0:19:50.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:01.28,0:20:04.28,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:20:07.45,0:20:08.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:09.41,0:20:12.83,Default,,0,0,0,,Бұл Афукудононың ұстаушылары.
Dialogue: 0,0:20:12.96,0:20:15.38,Default,,0,0,0,,Бұрын айтқаным үшін кешіріңіз.
Dialogue: 0,0:20:15.54,0:20:17.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:19.13,0:20:23.76,Default,,0,0,0,,Ига тауында маймыл болып өстім.
Dialogue: 0,0:20:24.18,0:20:26.22,Default,,0,0,0,,Өзін қатал ұстады...
Dialogue: 0,0:20:27.43,0:20:30.81,Default,,0,0,0,,Қызыл жібек қалай жасалды?
Dialogue: 0,0:20:31.39,0:20:32.98,Default,,0,0,0,,Вермилион жібек -
Dialogue: 0,0:20:33.52,0:20:38.65,Default,,0,0,0,,Мен Кога-гуми жетекшісі Кога Генносукенің соңынан бардым.
Dialogue: 0,0:20:38.77,0:20:40.82,Default,,0,0,0,,О, құдай! (Васал 2) Сонымен?
Dialogue: 0,0:20:41.90,0:20:44.57,Default,,0,0,0,,Терең жаралы фугаға байланысты...
Dialogue: 0,0:20:45.32,0:20:50.16,Default,,0,0,0,,Мен бәрібір табиғатта өлетін шығармын, бірақ...
Dialogue: 0,0:20:52.75,0:20:57.79,Default,,0,0,0,,Шукиндоның айтуынша, Кога тобында тағы бір адам бар...
Dialogue: 0,0:20:58.54,0:21:02.30,Default,,0,0,0,,Кагеро деген қыз бар екен.
Dialogue: 0,0:21:02.80,0:21:07.18,Default,,0,0,0,,Ондай жағдайда ол көнді.
Dialogue: 0,0:21:08.14,0:21:09.93,Default,,0,0,0,,Үйрену деген нені білдіреді?
Dialogue: 0,0:21:10.56,0:21:15.10,Default,,0,0,0,,Тірідей тұтқынға түстім, мен оны әйелге айналдырдым, солай істе дедім.
Dialogue: 0,0:21:15.56,0:21:20.94,Default,,0,0,0,,Содан біртүрлі жағдай болып, бірден Игаға бұрылды.
Dialogue: 0,0:21:21.44,0:21:26.32,Default,,0,0,0,,Жарайды... жоқ, маған қатты әсер етті.
Dialogue: 0,0:21:27.53,0:21:30.16,Default,,0,0,0,,Бұрынғыдай.
Dialogue: 0,0:21:30.62,0:21:34.16,Default,,0,0,0,,Сіз қандай сенімді одақтассыз.
Dialogue: 0,0:21:36.25,0:21:39.67,Default,,0,0,0,,Айтпақшы, Якушидзи Тензен ше?
Dialogue: 0,0:21:40.38,0:21:45.42,Default,,0,0,0,,Менің естуімше, сіз...
Dialogue: 0,0:21:48.34,0:21:52.18,Default,,0,0,0,,Қандай жарақат алса да өлмейді...
Dialogue: 0,0:21:55.85,0:21:58.60,Default,,0,0,0,,Мен сені өлмейтін шиноби деп естідім.
Dialogue: 0,0:21:59.27,0:22:00.15,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:22:06.49,0:22:11.49,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.99,0:23:35.83,Default,,0,0,0,,～♪
Dialogue: 0,0:23:41.21,0:23:44.38,Default,,0,0,0,,Шеңберлерде ашылатын жаңа қанның керемет желдеткіші
Dialogue: 0,0:23:44.50,0:23:46.63,Default,,0,0,0,,Қиын жағдайдағы қызыл пион
Dialogue: 0,0:23:46.88,0:23:51.51,Default,,0,0,0,,Жіптің толқынды терісі, көмейдің бал-бұлтары өшпес нәпсіні оятады.
Dialogue: 0,0:23:51.88,0:23:54.93,Default,,0,0,0,,Таояканың көлеңкесін құшақтап алған экстаз тынысы
Dialogue: 0,0:23:55.05,0:23:58.39,Default,,0,0,0,,Қаңғырту нирванасын тарту
Dialogue: 0,0:23:59.64,0:24:02.60,Default,,0,0,0,,Келесі жолы «Basilisk ~Koga Ninja Scroll~»
Dialogue: 0,0:24:04.10,0:24:10.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
