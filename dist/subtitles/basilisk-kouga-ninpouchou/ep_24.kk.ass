Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:06.04,Default,,0,0,0,,♪～
Dialogue: 0,0:01:26.71,0:01:30.54,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.77,0:01:48.77,Default,,0,0,0,,(Оборо ұйықтау тынысы)
Dialogue: 0,0:01:56.32,0:01:59.45,Default,,0,0,0,,Ештеңе өзгерген жоқ
Dialogue: 0,0:02:04.91,0:02:07.04,Default,,0,0,0,,Эй, Кога адамы
Dialogue: 0,0:02:12.00,0:02:14.30,Default,,0,0,0,,Хаттори Ханзоның үйі
Dialogue: 0,0:02:30.48,0:02:33.23,Default,,0,0,0,,Iga no Oboro Жарайсыз ба?
Dialogue: 0,0:02:34.48,0:02:35.48,Default,,0,0,0,,Иә
Dialogue: 0,0:02:35.61,0:02:37.07,Default,,0,0,0,,(жылжымалы есіктің ашылу дыбысы)
Dialogue: 0,0:02:51.17,0:02:55.88,Default,,0,0,0,,2-ші буын Ханзо Масанари - Кадзуко Киохачиро
Dialogue: 0,0:02:56.71,0:02:59.76,Default,,0,0,0,,Енді 4-ші ұрпақ Масахироның мұрагері.
Dialogue: 0,0:03:00.38,0:03:03.43,Default,,0,0,0,,Мен сенімен бірінші рет кездесіп тұрмын.
Dialogue: 0,0:03:03.89,0:03:07.64,Default,,0,0,0,,Түсіндім... Көп нәрсе есімде жоқ.
Dialogue: 0,0:03:28.91,0:03:30.29,Default,,0,0,0,,Осы уақытта...
Dialogue: 0,0:03:30.83,0:03:35.79,Default,,0,0,0,,Біздің отбасымызды өлімге апарған сенсің...
Dialogue: 0,0:03:38.05,0:03:39.63,Default,,0,0,0,,Кек сақтама
Dialogue: 0,0:03:42.59,0:03:44.55,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:03:52.19,0:03:54.73,Default,,0,0,0,,Сенің қылышың ше?
Dialogue: 0,0:03:55.65,0:03:57.82,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:03:58.94,0:04:00.44,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:02.45,0:04:04.45,Default,,0,0,0,,Сонымен, бұл...
Dialogue: 0,0:04:06.41,0:04:08.91,Default,,0,0,0,,Аты жоқ, бірақ өнер туындысы
Dialogue: 0,0:04:15.33,0:04:17.63,Default,,0,0,0,,Түсінгеніңізге рахмет.
Dialogue: 0,0:04:21.51,0:04:23.93,Default,,0,0,0,,Сіз қалаған нәрсе бар ма?
Dialogue: 0,0:04:43.07,0:04:44.99,Default,,0,0,0,,Генносуке Кога ше?
Dialogue: 0,0:04:45.11,0:04:48.12,Default,,0,0,0,,Тек сана әрең...
Dialogue: 0,0:04:48.37,0:04:50.12,Default,,0,0,0,,Алайда...
Dialogue: 0,0:04:50.49,0:04:52.75,Default,,0,0,0,,Осыған тезірек көшейік.
Dialogue: 0,0:04:52.87,0:04:55.83,Default,,0,0,0,,Бар болғаны тұру керек. (Васал) Ха...
Dialogue: 0,0:05:12.35,0:05:14.27,Default,,0,0,0,,Жедел найзағай
Dialogue: 0,0:05:15.23,0:05:18.35,Default,,0,0,0,,Бар болғаны 10 күнде
Dialogue: 0,0:05:18.48,0:05:22.07,Default,,0,0,0,,Мен ешқашан мұндай қайғылы жағдай болады деп ойламаппын...
Dialogue: 0,0:05:58.06,0:05:59.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:02.57,0:06:05.94,Default,,0,0,0,,Қатаң қыстың өзі ақыры бітеді
Dialogue: 0,0:06:07.28,0:06:11.57,Default,,0,0,0,,Мен бұл маусымды көптен күттім.
Dialogue: 0,0:06:36.77,0:06:40.10,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:06:46.69,0:06:49.20,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:51.66,0:06:52.70,Default,,0,0,0,,Обородо
Dialogue: 0,0:08:23.71,0:08:25.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:29.00,0:08:33.09,Default,,0,0,0,,Жоқ... бұл тыныш уақыт еді.
Dialogue: 0,0:09:23.10,0:09:25.56,Default,,0,0,0,,Исеге барар жолда
Dialogue: 0,0:09:26.64,0:09:29.77,Default,,0,0,0,,Бұл қақтығысқа не себеп болды...
Dialogue: 0,0:09:30.19,0:09:32.15,Default,,0,0,0,,Таза сәйкестік
Dialogue: 0,0:09:32.57,0:09:37.36,Default,,0,0,0,,Біз бұл қақтығысқа ештеңе жасамадық.
Dialogue: 0,0:09:37.95,0:09:43.37,Default,,0,0,0,,Соғыс ниндзясының шенеунігі ретінде сізден мені өз көздеріңізбен қарауларыңызды өтінемін.
Dialogue: 0,0:09:44.08,0:09:48.58,Default,,0,0,0,,Ұлы моғолдың куәгері болғаныңыз үшін рахмет.
Dialogue: 0,0:09:49.08,0:09:50.46,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:09:51.46,0:09:53.59,Default,,0,0,0,,Мен бұл туралы білемін.
Dialogue: 0,0:09:54.30,0:09:58.59,Default,,0,0,0,,Бұл... Генносуке Коганың көзін Ига жағы жауып алды.
Dialogue: 0,0:09:58.72,0:10:01.76,Default,,0,0,0,,Ол ауыр жарақат алса да,
Dialogue: 0,0:10:02.01,0:10:06.56,Default,,0,0,0,,Бұл да ниндзя ойынының бір бөлігі емес пе?
Dialogue: 0,0:10:07.06,0:10:08.48,Default,,0,0,0,,Бастапқыда
Dialogue: 0,0:10:08.69,0:10:09.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:11.40,0:10:14.36,Default,,0,0,0,,Бұрынғы тітіркендіргіш сөздер...
Dialogue: 0,0:10:15.32,0:10:20.53,Default,,0,0,0,,Бұл қажетсіз күдік туғызады.
Dialogue: 0,0:10:20.70,0:10:21.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:25.79,0:10:28.46,Default,,0,0,0,,Сіз қалаған нәрсе бар ма?
Dialogue: 0,0:10:30.50,0:10:34.05,Default,,0,0,0,,Мен қазір көп нәрсені істей алмаймын.
Dialogue: 0,0:10:36.21,0:10:39.38,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:10:40.18,0:10:41.43,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:52.65,0:10:54.02,Default,,0,0,0,,Хаттори мырза
Dialogue: 0,0:10:56.19,0:10:57.61,Default,,0,0,0,,Бір ғана нәрсе...
Dialogue: 0,0:10:59.40,0:11:01.24,Default,,0,0,0,,Менің сөздерімді қабыл алыңыз.
Dialogue: 0,0:11:01.70,0:11:04.03,Default,,0,0,0,,Біздің сізден сұрайтынымыз бар.
Dialogue: 0,0:11:06.70,0:11:07.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:09.50,0:11:10.75,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:11:13.04,0:11:15.54,Default,,0,0,0,,Мен мұны сізге қалдырғым келеді.
Dialogue: 0,0:11:19.72,0:11:23.55,Default,,0,0,0,,Бұл Цубагакурэ Цзюниншуға қатысты нәрсе ме?
Dialogue: 0,0:11:26.01,0:11:27.56,Default,,0,0,0,,Біздің…
Dialogue: 0,0:11:29.73,0:11:31.52,Default,,0,0,0,,Намазда
Dialogue: 0,0:11:37.44,0:11:39.86,Default,,0,0,0,,Мен оны сақтадым.
Dialogue: 0,0:11:40.69,0:11:41.65,Default,,0,0,0,,Бітіру кеші жақындап қалды ғой?
Dialogue: 0,0:11:43.82,0:11:47.16,Default,,0,0,0,,Егер мен құлап қалсам...
Dialogue: 0,0:11:48.45,0:11:51.37,Default,,0,0,0,,Мүмкін емес шығар
Dialogue: 0,0:11:52.79,0:11:54.42,Default,,0,0,0,,Генносуке Кога…
Dialogue: 0,0:11:55.96,0:11:57.46,Default,,0,0,0,,Бұл жағдайда...
Dialogue: 0,0:11:59.59,0:12:03.51,Default,,0,0,0,,Оборо, ең болмағанда қылыштың астында...
Dialogue: 0,0:12:05.05,0:12:06.89,Default,,0,0,0,,Мені кейінгі өмірге жібер
Dialogue: 0,0:12:11.89,0:12:13.06,Default,,0,0,0,,Иә
Dialogue: 0,0:12:17.98,0:12:18.82,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:24.41,0:12:25.36,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:12:36.88,0:12:38.29,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:13:09.66,0:13:12.33,Default,,0,0,0,,Әй, сен не істеп жатырсың!
Dialogue: 0,0:13:12.58,0:13:16.92,Default,,0,0,0,,Оборо! Тезірек әлгі Кога жігітін өлтір!
Dialogue: 0,0:14:02.50,0:14:03.88,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:14:05.59,0:14:07.09,Default,,0,0,0,,Генносуке-сама
Dialogue: 0,0:14:07.63,0:14:08.51,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:13.93,0:14:16.39,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:14:32.53,0:14:33.58,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:14:46.34,0:14:48.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:48.67,0:14:52.26,Default,,0,0,0,,Бұл... біреу! Біреу қазірдің өзінде Генносукені өлтіріп жатқан еді!
Dialogue: 0,0:14:52.43,0:14:53.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:53.51,0:14:56.43,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:14:58.10,0:14:59.35,Default,,0,0,0,,Тавакега
Dialogue: 0,0:14:59.52,0:15:02.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:02.44,0:15:04.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:14.49,0:15:16.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:16.74,0:15:18.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:18.62,0:15:20.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:21.12,0:15:22.79,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:15:22.96,0:15:24.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:33.59,0:15:35.80,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:15:40.73,0:15:42.02,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:43.48,0:15:45.40,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:15:58.91,0:16:00.87,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:16:19.06,0:16:20.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:20.27,0:16:21.39,Default,,0,0,0,,Ахх...
Dialogue: 0,0:16:37.16,0:16:38.24,Default,,0,0,0,,Оборо…
Dialogue: 0,0:17:03.77,0:17:04.94,Default,,0,0,0,,Оборо…
Dialogue: 0,0:17:13.19,0:17:15.24,Default,,0,0,0,,Ха... Әке.
Dialogue: 0,0:17:16.41,0:17:19.87,Default,,0,0,0,,Бұл екеуі, егер...
Dialogue: 0,0:17:26.00,0:17:28.08,Default,,0,0,0,,Хибикихачиро (Киохачиро) Ха...
Dialogue: 0,0:17:36.80,0:17:41.26,Default,,0,0,0,,«Ақыры, мен мұны жаздым»…
Dialogue: 0,0:17:43.35,0:17:44.56,Default,,0,0,0,,Ішек-қарынды жұлып алып, оның өшін алғым келеді.
Dialogue: 0,0:17:45.23,0:17:48.94,Default,,0,0,0,,«Ига Ниндзя Оборо»
Dialogue: 0,0:17:53.36,0:17:55.44,Default,,0,0,0,,Осы соңғы минутта-
Dialogue: 0,0:17:55.90,0:18:00.99,Default,,0,0,0,,Дәл осылайша Иганың Такечио фракциясының жеңісі шешілетін еді...
Dialogue: 0,0:18:01.33,0:18:04.29,Default,,0,0,0,,А... бітті...
Dialogue: 0,0:18:04.66,0:18:07.00,Default,,0,0,0,,Бітті...
Dialogue: 0,0:18:08.17,0:18:11.67,Default,,0,0,0,,Сәтсіздігі күшті әйел.
Dialogue: 0,0:18:17.26,0:18:20.51,Default,,0,0,0,,Ига жеңеді. Қамалға барыңыз.
Dialogue: 0,0:18:35.73,0:18:38.36,Default,,0,0,0,,Бізді жел соққанда...
Dialogue: 0,0:18:39.57,0:18:43.12,Default,,0,0,0,,Біз армандарымызды бірге ойып алсақ...
Dialogue: 0,0:18:44.16,0:18:48.08,Default,,0,0,0,,Мен кенет ойланатын бірдеңе болды.
Dialogue: 0,0:18:48.87,0:18:51.04,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:18:51.83,0:18:54.21,Default,,0,0,0,,«Генносуке-сама екеуміз» деген не?
Dialogue: 0,0:18:54.84,0:18:59.63,Default,,0,0,0,,Баяғыда бір жан болған шығар
Dialogue: 0,0:19:01.09,0:19:03.68,Default,,0,0,0,,Екіге бөлінген жан...
Dialogue: 0,0:19:04.14,0:19:09.39,Default,,0,0,0,,Мүмкін олар қандай болу керек болса, сол күйге оралғысы келетін шығар.
Dialogue: 0,0:19:11.90,0:19:17.19,Default,,0,0,0,,Мен Генносуке-сама бола алсам ғой...
Dialogue: 0,0:19:18.86,0:19:21.07,Default,,0,0,0,,Бір жан болса...
Dialogue: 0,0:19:21.57,0:19:24.58,Default,,0,0,0,,Біз міндетті түрде бірге келеміз
Dialogue: 0,0:19:25.99,0:19:28.87,Default,,0,0,0,,Икусе бөлек болса да...
Dialogue: 0,0:19:29.41,0:19:31.62,Default,,0,0,0,,Қанша ұрпақ өмір сүрсем де...
Dialogue: 0,0:19:32.54,0:19:33.75,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:19:41.13,0:19:42.34,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:19:58.78,0:20:00.57,Default,,0,0,0,,(айқай)
Dialogue: 0,0:20:13.25,0:20:14.54,Default,,0,0,0,,(айқай)
Dialogue: 0,0:20:16.21,0:20:18.38,Default,,0,0,0,,(айқай)
Dialogue: 0,0:20:21.09,0:20:26.09,Default,,0,0,0,,♪～
Dialogue: 0,0:21:44.84,0:21:50.39,Default,,0,0,0,,～♪
Dialogue: 0,0:21:53.56,0:21:55.68,Default,,0,0,0,,Ганкуни храмына бару туралы не деуге болады?
Dialogue: 0,0:21:56.14,0:21:59.56,Default,,0,0,0,,Ха... Менде ұсынатын кимоно бар.
Dialogue: 0,0:22:03.98,0:22:06.53,Default,,0,0,0,,Ол жерге бару үшін қиындыққа барудың қажеті жоқ.
Dialogue: 0,0:22:07.20,0:22:11.28,Default,,0,0,0,,Егер мен өз қолыммен жеткізгім келетін нәрсе болса.
Dialogue: 0,0:22:12.33,0:22:14.45,Default,,0,0,0,,Біртүрлі жігіт
Dialogue: 0,0:22:16.20,0:22:17.91,Default,,0,0,0,,Кейде әке
Dialogue: 0,0:22:18.37,0:22:19.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:20.00,0:22:24.05,Default,,0,0,0,,Марқұм Иеясу қалдырған адамның дәптері
Dialogue: 0,0:22:25.38,0:22:26.84,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:22:35.14,0:22:36.56,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:22:58.12,0:23:00.29,Default,,0,0,0,,Бейбітшілік әлемі келді
Dialogue: 0,0:23:01.46,0:23:05.42,Default,,0,0,0,,Ига Цубагакуре және Кога Мангакудани
Dialogue: 0,0:23:08.51,0:23:13.30,Default,,0,0,0,,Токугаваның мұрагерін анықтау үшін бір-біріне қарсы күрескен екі отбасы...
Dialogue: 0,0:23:13.60,0:23:15.93,Default,,0,0,0,,Бірдей өркендеу уәде етілген.
Dialogue: 0,0:23:17.14,0:23:22.90,Default,,0,0,0,,Қазіргі кезде екі жақтан аз да болса біреулер келіп-кететінін естідім.
Dialogue: 0,0:23:26.40,0:23:29.11,Default,,0,0,0,,Оборо, Генносуке
Dialogue: 0,0:23:30.95,0:23:33.24,Default,,0,0,0,,Қараңғылықтар
