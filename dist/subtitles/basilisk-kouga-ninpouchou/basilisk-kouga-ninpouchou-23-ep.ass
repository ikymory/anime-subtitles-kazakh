Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.34,0:00:11.01,Default,,0,0,0,,Бірін-бірі жек көретін адамдар болды
Dialogue: 0,0:00:12.92,0:00:17.68,Default,,0,0,0,,Далада дене шіриді, рух қанға боялады.
Dialogue: 0,0:00:20.35,0:00:23.77,Default,,0,0,0,,Байланыс пышақпен бөлінді
Dialogue: 0,0:00:23.94,0:00:26.98,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:00:32.53,0:00:33.49,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:37.37,0:00:38.66,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:39.78,0:00:42.37,Default,,0,0,0,,Қараңғылықтың шынайылығы жылайды
Dialogue: 0,0:00:42.50,0:00:43.91,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:00:45.37,0:00:49.46,Default,,0,0,0,,Сүйіктім, өлуге дайын
Dialogue: 0,0:01:01.51,0:01:06.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:26.72,0:02:30.56,Default,,0,0,0,,～♪
Dialogue: 0,0:02:51.12,0:02:53.92,Default,,0,0,0,,Мені жек көру ақылға сыймайды
Dialogue: 0,0:02:54.96,0:02:58.17,Default,,0,0,0,,Кек болсаң, Токугаваны жек көр.
Dialogue: 0,0:02:59.13,0:03:01.26,Default,,0,0,0,,Сунпу ұлы тұлғалары...
Dialogue: 0,0:03:02.47,0:03:05.35,Default,,0,0,0,,Дүниедегі мұрагерлік үшін шайқас
Dialogue: 0,0:03:06.85,0:03:08.14,Default,,0,0,0,,Және…
Dialogue: 0,0:03:10.35,0:03:13.02,Default,,0,0,0,,Кога болып туылғаның үшін өзіңе қарғыс айт!
Dialogue: 0,0:03:14.23,0:03:15.44,Default,,0,0,0,,Генносуке-сама!
Dialogue: 0,0:03:18.28,0:03:20.82,Default,,0,0,0,,Ұзақ қозғалу
Dialogue: 0,0:03:27.54,0:03:29.95,Default,,0,0,0,,Күн де келді.
Dialogue: 0,0:03:41.93,0:03:44.39,Default,,0,0,0,,Ху... (Генносуке) Барыс жылқы...
Dialogue: 0,0:03:49.52,0:03:50.81,Default,,0,0,0,,(Қылыштардың соқтығысуы)
Dialogue: 0,0:03:57.65,0:03:59.32,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:03.82,0:04:04.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:07.95,0:04:09.49,Default,,0,0,0,,Уууу…
Dialogue: 0,0:04:11.33,0:04:12.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:13.92,0:04:16.25,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:04:21.42,0:04:22.55,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:04:25.89,0:04:27.55,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:04:30.93,0:04:33.27,Default,,0,0,0,,Генносуке-сама!
Dialogue: 0,0:04:37.90,0:04:39.19,Default,,0,0,0,,Ннн! (Тенцэн) Ха...
Dialogue: 0,0:04:41.82,0:04:43.03,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:04:53.83,0:04:54.91,Default,,0,0,0,,Ge…
Dialogue: 0,0:04:56.79,0:05:02.84,Default,,0,0,0,,Генносуке!
Dialogue: 0,0:05:22.36,0:05:23.74,Default,,0,0,0,,Уууу…
Dialogue: 0,0:05:24.57,0:05:26.03,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:05:30.41,0:05:32.41,Default,,0,0,0,,Обородо...
Dialogue: 0,0:05:34.20,0:05:35.20,Default,,0,0,0,,Иә
Dialogue: 0,0:05:36.46,0:05:38.50,Default,,0,0,0,,Қылыш... (Оборо) Ха...
Dialogue: 0,0:05:40.84,0:05:42.25,Default,,0,0,0,,Сізде бар ма?
Dialogue: 0,0:05:42.88,0:05:44.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:48.68,0:05:52.64,Default,,0,0,0,,Не! Оборо жоқ емес пе?
Dialogue: 0,0:05:57.44,0:05:59.27,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:06:00.52,0:06:02.94,Default,,0,0,0,,Сіз кесілген дыбысты естідіңіз бе?
Dialogue: 0,0:06:03.07,0:06:07.86,Default,,0,0,0,,Онда неге дірілдеп тұрсың?
Dialogue: 0,0:06:08.11,0:06:12.45,Default,,0,0,0,,Бірдеңе болып қалса, мен саған қамқор боламын!
Dialogue: 0,0:06:16.50,0:06:20.96,Default,,0,0,0,,Жоқ, менде жоқ.
Dialogue: 0,0:06:21.67,0:06:24.75,Default,,0,0,0,,Қылышты ал, Обородо
Dialogue: 0,0:06:27.34,0:06:30.59,Default,,0,0,0,,Мен сені өлтіруім керек.
Dialogue: 0,0:06:34.76,0:06:37.56,Default,,0,0,0,,Сіз мені өлтіруіңіз керек.
Dialogue: 0,0:06:39.02,0:06:40.90,Default,,0,0,0,,Мен сені жеңе алатын шығармын.
Dialogue: 0,0:06:42.31,0:06:45.98,Default,,0,0,0,,Менің көзім енді жабылды.
Dialogue: 0,0:06:46.78,0:06:50.36,Default,,0,0,0,,Мен де соқырмын.
Dialogue: 0,0:06:50.53,0:06:52.95,Default,,0,0,0,,Ха... Ига адамдар?
Dialogue: 0,0:06:53.78,0:06:58.08,Default,,0,0,0,,Жоқ, мен бұғаттадым.
Dialogue: 0,0:06:58.83,0:07:03.08,Default,,0,0,0,,Мен Мангаяшумен төбелесті көргім келмейді...
Dialogue: 0,0:07:05.67,0:07:07.09,Default,,0,0,0,,Обородо...
Dialogue: 0,0:07:08.71,0:07:10.26,Default,,0,0,0,,Генносуке-сама
Dialogue: 0,0:07:12.26,0:07:13.64,Default,,0,0,0,,Өйткені ол
Dialogue: 0,0:07:17.18,0:07:19.18,Default,,0,0,0,,Мені кесіп тастаңызшы
Dialogue: 0,0:07:35.83,0:07:38.95,Default,,0,0,0,,Менің көзім ашылғанша...
Dialogue: 0,0:07:46.84,0:07:49.51,Default,,0,0,0,,Обородо (Оборо) Иә
Dialogue: 0,0:07:49.76,0:07:52.84,Default,,0,0,0,,Қоғада жалғыз қалдым.
Dialogue: 0,0:07:54.18,0:07:57.85,Default,,0,0,0,,Мен де Игада жалғыз қалдым.
Dialogue: 0,0:08:01.31,0:08:04.85,Default,,0,0,0,,Тез, қылышыңды ал, Оборо.
Dialogue: 0,0:08:08.57,0:08:11.28,Default,,0,0,0,,Генносуке-сама, неге...
Dialogue: 0,0:08:11.69,0:08:13.07,Default,,0,0,0,,Кагеро...
Dialogue: 0,0:08:13.49,0:08:16.49,Default,,0,0,0,,Оборо неге жеңілмейді?
Dialogue: 0,0:08:16.87,0:08:18.03,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:18.99,0:08:21.50,Default,,0,0,0,,Сіз Когасыз...
Dialogue: 0,0:08:22.62,0:08:24.46,Default,,0,0,0,,Мангая...
Dialogue: 0,0:08:32.88,0:08:34.26,Default,,0,0,0,,Өйткені ол
Dialogue: 0,0:08:36.26,0:08:38.39,Default,,0,0,0,,Сіз маған опасыздық жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:08:45.10,0:08:46.31,Default,,0,0,0,,Кагеро...
Dialogue: 0,0:08:47.52,0:08:52.28,Default,,0,0,0,,Ол әйел сені алдады.
Dialogue: 0,0:08:53.07,0:08:55.24,Default,,0,0,0,,Цубагакуре...
Dialogue: 0,0:08:56.82,0:08:58.53,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:59.53,0:09:02.12,Default,,0,0,0,,Онда асығыңыз...
Dialogue: 0,0:09:02.54,0:09:03.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:10.92,0:09:14.59,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:19.43,0:09:22.39,Default,,0,0,0,,Генносуке...
Dialogue: 0,0:09:24.98,0:09:26.27,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:42.95,0:09:45.91,Default,,0,0,0,,Саған және маған...
Dialogue: 0,0:09:48.12,0:09:49.88,Default,,0,0,0,,Қауіпсіз жер туралы жұмбақ...
Dialogue: 0,0:09:52.04,0:09:53.55,Default,,0,0,0,,Еш жерде...
Dialogue: 0,0:09:56.13,0:09:57.13,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:09:58.13,0:09:59.47,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:59.72,0:10:00.72,Default,,0,0,0,,Уф…
Dialogue: 0,0:10:01.14,0:10:04.47,Default,,0,0,0,,Ха... Генносуке-сама?
Dialogue: 0,0:10:05.52,0:10:06.93,Default,,0,0,0,,Генносуке-сама!
Dialogue: 0,0:10:11.27,0:10:12.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:14.73,0:10:16.11,Default,,0,0,0,,Оборо…
Dialogue: 0,0:10:19.78,0:10:23.70,Default,,0,0,0,,Тек сіз ғана аман қала аласыз.
Dialogue: 0,0:10:25.37,0:10:26.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:30.67,0:10:34.00,Default,,0,0,0,,Тоқта... Тоқта...
Dialogue: 0,0:10:35.96,0:10:38.22,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:10:38.42,0:10:42.05,Default,,0,0,0,,Генносуке-сама!
Dialogue: 0,0:10:43.64,0:10:44.85,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:57.86,0:10:59.70,Default,,0,0,0,,У...
Dialogue: 0,0:11:00.91,0:11:03.70,Default,,0,0,0,,Жоғалу...
Dialogue: 0,0:11:08.12,0:11:09.71,Default,,0,0,0,,Генносуке-сама!
Dialogue: 0,0:11:17.17,0:11:18.21,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:19.88,0:11:23.14,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:32.19,0:11:37.02,Default,,0,0,0,,А... хаха...
Dialogue: 0,0:11:39.65,0:11:42.07,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:11:48.37,0:11:53.87,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:12:07.56,0:12:09.14,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:12:09.27,0:12:12.31,Default,,0,0,0,,Ах... Оборо...
Dialogue: 0,0:12:12.44,0:12:14.15,Default,,0,0,0,,Ах... Генносуке-сама
Dialogue: 0,0:12:14.81,0:12:16.61,Default,,0,0,0,,Оборо…
Dialogue: 0,0:12:18.94,0:12:20.73,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:12:21.82,0:12:23.70,Default,,0,0,0,,Ешкім...
Dialogue: 0,0:12:24.82,0:12:28.20,Default,,0,0,0,,Мен ешкімді өлтіргім келмеді.
Dialogue: 0,0:12:28.37,0:12:29.45,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:33.83,0:12:35.33,Default,,0,0,0,,Ешкім...
Dialogue: 0,0:12:35.96,0:12:38.42,Default,,0,0,0,,Мен сенің өлгеніңді қаламадым.
Dialogue: 0,0:12:41.21,0:12:42.80,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:12:44.38,0:12:45.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:07.57,0:13:10.87,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:13:10.99,0:13:15.37,Default,,0,0,0,,Бұл... бұл Кога! (Вассал) Генносуке Кога келді!
Dialogue: 0,0:13:15.87,0:13:16.92,Default,,0,0,0,,Тензен ше!
Dialogue: 0,0:13:17.37,0:13:19.71,Default,,0,0,0,,Тензен ше?
Dialogue: 0,0:13:19.84,0:13:22.17,Default,,0,0,0,,Сен тағы да өлдің!
Dialogue: 0,0:13:22.71,0:13:24.97,Default,,0,0,0,,Эй, үрейленбе!
Dialogue: 0,0:13:25.13,0:13:27.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:35.94,0:13:38.19,Default,,0,0,0,,Тензен - өлмейтін ниндзя
Dialogue: 0,0:13:38.77,0:13:42.78,Default,,0,0,0,,Сіз мұны білуіңіз керек! (вассаалдар) А...
Dialogue: 0,0:13:42.90,0:13:45.36,Default,,0,0,0,,Біреу мені оятуын өтінемін.
Dialogue: 0,0:13:45.74,0:13:48.24,Default,,0,0,0,,Мен оны тіпті сол мойынға қайта салдым!
Dialogue: 0,0:13:52.28,0:13:54.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:54.50,0:13:56.96,Default,,0,0,0,,Иә, сен неден қорқасың?
Dialogue: 0,0:13:57.16,0:14:00.88,Default,,0,0,0,,Бұл Такечио-сама, ал қосымша айтқанда, бұл Афуку...
Dialogue: 0,0:14:01.04,0:14:05.09,Default,,0,0,0,,Оның үстіне бұл маңызды, өйткені ол сіздің тағдырыңызға әсер етеді!
Dialogue: 0,0:14:05.21,0:14:06.38,Default,,0,0,0,,Ха...хаха!
Dialogue: 0,0:14:11.39,0:14:12.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:13.76,0:14:16.39,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:16.56,0:14:19.31,Default,,0,0,0,,Ннн… Ннн…
Dialogue: 0,0:14:19.48,0:14:22.77,Default,,0,0,0,,Ннн… Ннн…
Dialogue: 0,0:14:25.82,0:14:27.19,Default,,0,0,0,,Уф…
Dialogue: 0,0:14:33.28,0:14:36.75,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:40.04,0:14:42.79,Default,,0,0,0,,Оборо…
Dialogue: 0,0:14:42.92,0:14:44.67,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:44.96,0:14:46.42,Default,,0,0,0,,Апай...
Dialogue: 0,0:14:49.76,0:14:51.72,Default,,0,0,0,,Кейде обороя
Dialogue: 0,0:14:53.76,0:14:57.98,Default,,0,0,0,,Якушидзи Тензенмен абай болыңыз
Dialogue: 0,0:14:58.27,0:14:59.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:00.19,0:15:03.69,Default,,0,0,0,,Сіз оны әлі көрмеген шығарсыз.
Dialogue: 0,0:15:03.86,0:15:07.61,Default,,0,0,0,,Өлмейтіндік сиқырын пайдаланады.
Dialogue: 0,0:15:08.03,0:15:10.99,Default,,0,0,0,,Бұл ниндзя заңы емес.
Dialogue: 0,0:15:12.24,0:15:16.87,Default,,0,0,0,,Бұл адамның ішінде бір нәрсе өмір сүреді.
Dialogue: 0,0:15:16.99,0:15:18.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:18.95,0:15:22.42,Default,,0,0,0,,Мен оның не екенін де білмеймін.
Dialogue: 0,0:15:22.75,0:15:24.96,Default,,0,0,0,,Өйткені, бұл...
Dialogue: 0,0:15:25.09,0:15:29.01,Default,,0,0,0,,Мен туылғанға дейін көп болды.
Dialogue: 0,0:15:29.47,0:15:31.51,Default,,0,0,0,,Сенімді болудың жолы жоқ
Dialogue: 0,0:15:31.84,0:15:34.80,Default,,0,0,0,,Бірақ менің ойымша...
Dialogue: 0,0:15:34.93,0:15:37.51,Default,,0,0,0,,Онда не бар...
Dialogue: 0,0:15:39.43,0:15:43.23,Default,,0,0,0,,А... (Оборо) Әй... Апай?
Dialogue: 0,0:15:43.60,0:15:46.32,Default,,0,0,0,,А, жоқ... (Оборо) А...
Dialogue: 0,0:15:46.82,0:15:49.94,Default,,0,0,0,,А, мен бос сөз айтып едім.
Dialogue: 0,0:15:50.11,0:15:55.70,Default,,0,0,0,,Болашақта өмір сүру, білудің қажеті жоқ.
Dialogue: 0,0:15:56.41,0:15:57.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:58.87,0:16:01.12,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:16:01.25,0:16:04.08,Default,,0,0,0,,Мен де шаршадым.
Dialogue: 0,0:16:06.71,0:16:07.96,Default,,0,0,0,,Апай...
Dialogue: 0,0:16:13.68,0:16:15.05,Default,,0,0,0,,Апай...
Dialogue: 0,0:16:15.76,0:16:22.39,Default,,0,0,0,,(Тенцэннің ыңырануы)
Dialogue: 0,0:16:22.69,0:16:25.85,Default,,0,0,0,,О... Оборо…
Dialogue: 0,0:16:26.02,0:16:27.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:28.07,0:16:29.23,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:29.36,0:16:30.40,Default,,0,0,0,,Ннн!
Dialogue: 0,0:16:38.62,0:16:40.08,Default,,0,0,0,,Оборо…
Dialogue: 0,0:16:40.45,0:16:43.91,Default,,0,0,0,,Көздерің ашық па?
Dialogue: 0,0:16:48.88,0:16:53.17,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:16:53.30,0:16:55.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:58.68,0:16:59.85,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:00.76,0:17:02.98,Default,,0,0,0,,(Жан) Не…
Dialogue: 0,0:17:03.81,0:17:07.10,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:17:14.15,0:17:18.74,Default,,0,0,0,,Сәлем! Сіз біртүрлі әрекет етесіз (вассаль) Тензен қайда?
Dialogue: 0,0:17:26.00,0:17:28.54,Default,,0,0,0,,Уау! (Оборо) Ха...
Dialogue: 0,0:17:30.09,0:17:32.55,Default,,0,0,0,,Ннн… Ннн…
Dialogue: 0,0:17:32.71,0:17:33.88,Default,,0,0,0,,Ннн!
Dialogue: 0,0:17:34.01,0:17:36.55,Default,,0,0,0,,Ннн… Ннн…
Dialogue: 0,0:17:36.72,0:17:37.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:38.22,0:17:43.52,Default,,0,0,0,,Кога... Генносуке...
Dialogue: 0,0:17:45.56,0:17:48.94,Default,,0,0,0,,Обороның артында...
Dialogue: 0,0:17:49.06,0:17:54.65,Default,,0,0,0,,Баспалдақтың артында... бар...
Dialogue: 0,0:17:54.78,0:17:55.86,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:56.03,0:17:57.15,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:03.87,0:18:05.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:10.63,0:18:15.05,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:18:15.88,0:18:20.30,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:18:24.77,0:18:28.10,Default,,0,0,0,,Болашақта өмір сүретіндер үшін...
Dialogue: 0,0:18:39.03,0:18:42.57,Default,,0,0,0,,Бұл сізге білу қажет нәрсе емес.
Dialogue: 0,0:18:45.70,0:18:49.33,Default,,0,0,0,,Біз, Кога Мангая руы
Dialogue: 0,0:18:53.75,0:18:56.38,Default,,0,0,0,,Ига Цубагакуре клан
Dialogue: 0,0:19:14.82,0:19:18.78,Default,,0,0,0,,Ниндзяның қорқынышты әдістерін меңгерген екі жақ...
Dialogue: 0,0:19:21.91,0:19:25.87,Default,,0,0,0,,Көптен келе жатқан кек дейді.
Dialogue: 0,0:19:27.87,0:19:29.12,Default,,0,0,0,,бір-бірін жек көреді
Dialogue: 0,0:19:30.79,0:19:35.25,Default,,0,0,0,,Макото: Ақымақтық шыңы...
Dialogue: 0,0:19:35.84,0:19:37.71,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:19:38.67,0:19:41.68,Default,,0,0,0,,Болашақта өмір сүретіндер үшін...
Dialogue: 0,0:19:44.01,0:19:47.51,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:19:48.47,0:19:51.69,Default,,0,0,0,,Сізге білудің қажеті жоқ.
Dialogue: 0,0:19:53.69,0:19:57.65,Default,,0,0,0,,Мен ешкімді өлтіргім келмеді.
Dialogue: 0,0:19:58.86,0:20:01.70,Default,,0,0,0,,Неге...
Dialogue: 0,0:20:02.40,0:20:03.57,Default,,0,0,0,,Неге...
Dialogue: 0,0:20:05.99,0:20:08.45,Default,,0,0,0,,Неге!
Dialogue: 0,0:20:09.33,0:20:12.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:21.92,0:20:24.18,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:20:26.93,0:20:30.02,Default,,0,0,0,,Мен... Ол өлді ме?
Dialogue: 0,0:20:30.85,0:20:32.23,Default,,0,0,0,,Ішек-қарынды жұлып алып, оның өшін алғым келеді.
Dialogue: 0,0:20:37.61,0:20:39.61,Default,,0,0,0,,Оборо...
Dialogue: 0,0:20:43.03,0:20:45.74,Default,,0,0,0,,Тензеннің сөзі қазір...
Dialogue: 0,0:20:47.99,0:20:50.83,Default,,0,0,0,,Расында да, менің артымда...
Dialogue: 0,0:20:51.29,0:20:55.62,Default,,0,0,0,,Жаралы және уланған Қоғалық адам жатыр.
Dialogue: 0,0:20:55.92,0:20:58.29,Default,,0,0,0,,О... бұл үлкен!
Dialogue: 0,0:20:58.59,0:21:01.59,Default,,0,0,0,,Ха... Жауды өлтірсем де, соғыса алмаймын...
Dialogue: 0,0:21:01.88,0:21:02.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:04.51,0:21:07.97,Default,,0,0,0,,Бұл Игаға абырой әкелмейді.
Dialogue: 0,0:21:08.18,0:21:11.97,Default,,0,0,0,,Жоқ... Ниндзя ешқашан не істемейді деп ойлайсың...
Dialogue: 0,0:21:17.27,0:21:18.77,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:21:20.07,0:21:23.49,Default,,0,0,0,,Хаттори Ханзо курьерді қайда жібереді? (Васал) Ха!
Dialogue: 0,0:21:24.40,0:21:26.61,Default,,0,0,0,,Жылқыларды дайындаңыз! (вассаалдар) Ха!
Dialogue: 0,0:21:29.37,0:21:33.00,Default,,0,0,0,,Соғыс ниндзясының шенеунігі Доно Ханзоның қатысуымен...
Dialogue: 0,0:21:33.12,0:21:35.62,Default,,0,0,0,,Бұл әділ жекпе-жек
Dialogue: 0,0:21:37.87,0:21:39.63,Default,,0,0,0,,Менің қарсылығым жоқ.
Dialogue: 0,0:21:51.51,0:21:52.72,Default,,0,0,0,,Қарсы пікір…
Dialogue: 0,0:21:55.18,0:21:56.60,Default,,0,0,0,,...Кешіріңіз
Dialogue: 0,0:22:06.49,0:22:11.49,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.95,0:23:35.78,Default,,0,0,0,,～♪
Dialogue: 0,0:23:39.08,0:23:41.21,Default,,0,0,0,,Тыныш көктемнің соңы
Dialogue: 0,0:23:41.37,0:23:43.13,Default,,0,0,0,,Сонымен қатар, ұқыпты және тыныш...
Dialogue: 0,0:23:43.25,0:23:46.75,Default,,0,0,0,,Аойдың қараңғылығына екі таза жан түседі
Dialogue: 0,0:23:47.25,0:23:49.26,Default,,0,0,0,,Жаңбырда жоғалып кететін көпіршіктер сияқты
Dialogue: 0,0:23:49.38,0:23:53.80,Default,,0,0,0,,Көк айдың жасырын әлемінде трагедиялық махаббат байламмен тербеледі.
Dialogue: 0,0:23:54.09,0:23:56.56,Default,,0,0,0,,Икуседен кейін біз енді кездеспейміз
Dialogue: 0,0:23:56.72,0:23:59.22,Default,,0,0,0,,Табысқа жету үшін көп өмір сүріңіз
Dialogue: 0,0:23:59.89,0:24:03.15,Default,,0,0,0,,«Basilisk ~Koga Ninja Scroll~» Соңғы эпизод
Dialogue: 0,0:24:04.65,0:24:10.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
