Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.14,0:00:06.11,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:09.15,0:00:29.17,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:00:29.17,0:00:47.12,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:00:47.12,0:00:49.09,Default,,0,0,0,,Хойса
Dialogue: 0,0:00:50.12,0:00:54.09,Default,,0,0,0,,Күз мезгілі ғой, солай емес пе?
Dialogue: 0,0:00:55.13,0:00:59.10,Default,,0,0,0,,Иә? Мұнда...
Dialogue: 0,0:01:02.13,0:01:04.14,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:01:04.14,0:01:08.14,Default,,0,0,0,,Көптен көрген арманыңыз? Алыстағы естелік?
Dialogue: 0,0:01:04.14,0:01:08.14,Default,,0,0,0,,Телешоу?
Dialogue: 0,0:01:08.14,0:01:12.14,Default,,0,0,0,,Мен жақында оқыдым
Dialogue: 0,0:01:08.14,0:01:12.14,Default,,0,0,0,,Жұмбақ роман?
Dialogue: 0,0:01:12.14,0:01:15.15,Default,,0,0,0,,Хмм…
Dialogue: 0,0:01:12.14,0:01:15.15,Default,,0,0,0,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,0:01:15.15,0:01:18.15,Default,,0,0,0,,Уау...
Dialogue: 0,0:01:18.15,0:01:23.12,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:01:18.15,0:01:23.12,Default,,0,0,0,,Буха…
Dialogue: 0,0:01:24.16,0:01:26.16,Default,,0,0,0,,Афина! ?
Dialogue: 0,0:01:26.16,0:01:30.16,Default,,0,0,0,,О, Аня, қалайсың?
Dialogue: 0,0:01:30.16,0:01:36.10,Default,,0,0,0,,олай емес.
Dialogue: 0,0:01:30.16,0:01:36.10,Default,,0,0,0,,Амансың ба? Афина
Dialogue: 0,0:01:36.10,0:01:56.12,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:56.12,0:02:09.13,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:09.13,0:02:14.14,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:14.14,0:02:34.09,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:34.09,0:02:54.11,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:54.11,0:03:02.09,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:05.12,0:03:07.12,Default,,0,0,0,,Уақытыңызды бөліңіз.
Dialogue: 0,0:03:07.12,0:03:09.13,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:09.13,0:03:12.13,Default,,0,0,0,,Мм... түсіндім.
Dialogue: 0,0:03:12.13,0:03:14.13,Default,,0,0,0,,Дайындық үзілісінде➡
Dialogue: 0,0:03:14.13,0:03:17.13,Default,,0,0,0,,Алиса-сенпайдың ән салған дауысы
Dialogue: 0,0:03:14.13,0:03:17.13,Default,,0,0,0,,Себебі мен естідім➡
Dialogue: 0,0:03:17.13,0:03:21.14,Default,,0,0,0,,Сыртқа шығып іздегенімнен басқа амалым болмады.
Dialogue: 0,0:03:17.13,0:03:21.14,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:03:21.14,0:03:24.14,Default,,0,0,0,,Содан адасып қалдым.
Dialogue: 0,0:03:24.14,0:03:27.11,Default,,0,0,0,,Ха, абай болыңыз, артық қоспаңыз...
Dialogue: 0,0:03:29.15,0:03:31.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:31.15,0:03:33.12,Default,,0,0,0,,Ах
Dialogue: 0,0:03:34.09,0:03:37.09,Default,,0,0,0,,О, мен жасадым.
Dialogue: 0,0:03:37.09,0:03:41.09,Default,,0,0,0,,Маған Алиса-сенпай айтса да
Dialogue: 0,0:03:37.09,0:03:41.09,Default,,0,0,0,,Оның алдын ала алмағаны үшін мен кінәлімін.
Dialogue: 0,0:03:41.09,0:03:44.06,Default,,0,0,0,,Сібірге жіберілді
Dialogue: 0,0:03:46.10,0:03:48.10,Default,,0,0,0,,Ой, мен де!
Dialogue: 0,0:03:48.10,0:03:50.10,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:50.10,0:03:54.11,Default,,0,0,0,,Екеуіңнен бері біраз уақыт өтті
Dialogue: 0,0:03:50.10,0:03:54.11,Default,,0,0,0,,Біз әлі кездескен жоқпыз.
Dialogue: 0,0:03:54.11,0:03:56.11,Default,,0,0,0,,Осы уақыт ішінде
Dialogue: 0,0:03:54.11,0:03:56.11,Default,,0,0,0,,Кюу
Dialogue: 0,0:03:54.11,0:03:56.11,Default,,0,0,0,,Воволо сарайындағы кеш ➡
Dialogue: 0,0:03:56.11,0:04:00.08,Default,,0,0,0,,Афина келе алмады.
Dialogue: 0,0:04:02.11,0:04:05.12,Default,,0,0,0,,Бұл компанияға келді➡
Dialogue: 0,0:04:05.12,0:04:08.09,Default,,0,0,0,,Афинаға
Dialogue: 0,0:04:05.12,0:04:08.09,Default,,0,0,0,,Жанкүйер хат
Dialogue: 0,0:04:09.12,0:04:11.12,Default,,0,0,0,,Алиса-сенпай да
Dialogue: 0,0:04:09.12,0:04:11.12,Default,,0,0,0,,Бірге жеткізейік➡
Dialogue: 0,0:04:11.12,0:04:15.13,Default,,0,0,0,,Мен айттым...
Dialogue: 0,0:04:11.12,0:04:15.13,Default,,0,0,0,,Сіз келе алмадыңыз.
Dialogue: 0,0:04:15.13,0:04:19.13,Default,,0,0,0,,Иә, бүгін түнге дейін.
Dialogue: 0,0:04:15.13,0:04:19.13,Default,,0,0,0,,Өйткені мен жұмыс істеуім керек
Dialogue: 0,0:04:19.13,0:04:21.10,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:04:23.13,0:04:26.10,Default,,0,0,0,,Алисаға сәлем айтыңыз
Dialogue: 0,0:04:29.14,0:04:31.11,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:38.08,0:04:40.08,Default,,0,0,0,,Pupupu…
Dialogue: 0,0:04:40.08,0:04:42.09,Default,,0,0,0,,Пуй Чай
Dialogue: 0,0:04:40.08,0:04:42.09,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:04:42.09,0:04:44.09,Default,,0,0,0,,Өте жылы
Dialogue: 0,0:04:44.09,0:04:48.09,Default,,0,0,0,,Әй, эй!
Dialogue: 0,0:04:44.09,0:04:48.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:48.09,0:04:51.10,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:04:48.09,0:04:51.10,Default,,0,0,0,,Тұтынушы! ?
Dialogue: 0,0:04:51.10,0:04:54.10,Default,,0,0,0,,Ах
Dialogue: 0,0:04:51.10,0:04:54.10,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:04:54.10,0:04:57.10,Default,,0,0,0,,Ал егер...
Dialogue: 0,0:04:57.10,0:04:59.10,Default,,0,0,0,,(әйелдер)
Dialogue: 0,0:04:57.10,0:04:59.10,Default,,0,0,0,,Алисия Флоренс?
Dialogue: 0,0:04:59.10,0:05:01.11,Default,,0,0,0,,Мен Алисияны көргенде, ол не көрді?
Dialogue: 0,0:05:01.11,0:05:03.11,Default,,0,0,0,,Үш рет тілек айтсаңыз
Dialogue: 0,0:05:01.11,0:05:03.11,Default,,0,0,0,,Бұл орындалады.
Dialogue: 0,0:05:03.11,0:05:08.11,Default,,0,0,0,,Фотосурет!
Dialogue: 0,0:05:03.11,0:05:08.11,Default,,0,0,0,,Фотосуреттер! Оны қорғайық!
Dialogue: 0,0:05:08.11,0:05:10.11,Default,,0,0,0,,Шамдар
Dialogue: 0,0:05:08.11,0:05:10.11,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:05:10.11,0:05:12.12,Default,,0,0,0,,Арибедерчи
Dialogue: 0,0:05:12.12,0:05:14.12,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:05:12.12,0:05:14.12,Default,,0,0,0,,Пуи Пуи Пуи Мяу
Dialogue: 0,0:05:14.12,0:05:17.12,Default,,0,0,0,,Ең күшті амулетті алыңыз!
Dialogue: 0,0:05:14.12,0:05:17.12,Default,,0,0,0,,Бүгін біз өте бақыттымыз...
Dialogue: 0,0:05:17.12,0:05:20.12,Default,,0,0,0,,Ай Чан, келесі тұтынушы кім?
Dialogue: 0,0:05:20.12,0:05:23.13,Default,,0,0,0,,Келесі тұтынушылар
Dialogue: 0,0:05:20.12,0:05:23.13,Default,,0,0,0,,Келу кестесі өзгерді.
Dialogue: 0,0:05:23.13,0:05:27.13,Default,,0,0,0,,және бүгінге осы жетсін
Dialogue: 0,0:05:23.13,0:05:27.13,Default,,0,0,0,,Сонымен, түскі асқа бір жерге барғыңыз келе ме?
Dialogue: 0,0:05:27.13,0:05:29.13,Default,,0,0,0,,Жоқ, мен бармаймын.
Dialogue: 0,0:05:29.13,0:05:31.10,Default,,0,0,0,,Иә~
Dialogue: 0,0:05:33.07,0:05:37.07,Default,,0,0,0,,~ сұрайық
Dialogue: 0,0:05:33.07,0:05:37.07,Default,,0,0,0,,А, мен күттім.
Dialogue: 0,0:05:37.07,0:05:40.08,Default,,0,0,0,,Аяқталған жұмыс?
Dialogue: 0,0:05:37.07,0:05:40.08,Default,,0,0,0,,Дәл түскі үзілісте
Dialogue: 0,0:05:40.08,0:05:43.08,Default,,0,0,0,,Азуса-чан мен Аня-чан
Dialogue: 0,0:05:40.08,0:05:43.08,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:05:43.08,0:05:45.05,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:46.08,0:05:51.06,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:06:00.10,0:06:02.07,Default,,0,0,0,,Я...
Dialogue: 0,0:06:04.10,0:06:07.07,Default,,0,0,0,,Өрік
Dialogue: 0,0:06:04.10,0:06:07.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:10.11,0:06:12.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:13.11,0:06:15.11,Default,,0,0,0,,Бу-бу-бу-бу
Dialogue: 0,0:06:15.11,0:06:17.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:21.12,0:06:23.09,Default,,0,0,0,,Я...
Dialogue: 0,0:06:26.12,0:06:29.13,Default,,0,0,0,,Жоқ! Кетчуп жоқ па?
Dialogue: 0,0:06:29.13,0:06:33.06,Default,,0,0,0,,Соңғы кездері өзіңізді жақсы сезінбей жүрсіз.
Dialogue: 0,0:06:29.13,0:06:33.06,Default,,0,0,0,,Сізде уайым бар ма?
Dialogue: 0,0:06:33.06,0:06:37.07,Default,,0,0,0,,Неге сұрамайсың? Анзу
Dialogue: 0,0:06:33.06,0:06:37.07,Default,,0,0,0,,Иә! Атлас, мені тыңда.
Dialogue: 0,0:06:37.07,0:06:39.07,Default,,0,0,0,,Хмм, сұрасаңыз➡
Dialogue: 0,0:06:39.07,0:06:42.07,Default,,0,0,0,,Біз қарапайым адамдар түсінбейміз.
Dialogue: 0,0:06:39.07,0:06:42.07,Default,,0,0,0,,Егер сізде мәселе болса...
Dialogue: 0,0:06:42.07,0:06:47.08,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:06:42.07,0:06:47.08,Default,,0,0,0,,Ол ұшқыштар тарихында қалатын кемеңгер.
Dialogue: 0,0:06:47.08,0:06:49.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:50.08,0:06:52.05,Default,,0,0,0,,Не!
Dialogue: 0,0:06:50.08,0:06:52.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:56.09,0:06:59.09,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:59.09,0:07:01.09,Default,,0,0,0,,Сонымен, біз➡
Dialogue: 0,0:07:01.09,0:07:04.09,Default,,0,0,0,,Сол күні дүниеге келген
Dialogue: 0,0:07:01.09,0:07:04.09,Default,,0,0,0,,Тілегім тұқымының гүлі жайнағанын қалаймын.
Dialogue: 0,0:07:04.09,0:07:07.10,Default,,0,0,0,,Иә, бұл жақсы деп ойлаймын.
Dialogue: 0,0:07:07.10,0:07:10.10,Default,,0,0,0,,Келесі жолы өтінемін
Dialogue: 0,0:07:07.10,0:07:10.10,Default,,0,0,0,,Барлық қарттарды шақырыңыз➡
Dialogue: 0,0:07:10.10,0:07:13.10,Default,,0,0,0,,Тосын кеш
Dialogue: 0,0:07:10.10,0:07:13.10,Default,,0,0,0,,Мен жетістікке жеткім келеді!
Dialogue: 0,0:07:13.10,0:07:16.11,Default,,0,0,0,,Иә? Таңқаларлық па?
Dialogue: 0,0:07:16.11,0:07:19.11,Default,,0,0,0,,Мен... сұрасам, жарайды ма?
Dialogue: 0,0:07:19.11,0:07:22.11,Default,,0,0,0,,Бұл аз
Dialogue: 0,0:07:19.11,0:07:22.11,Default,,0,0,0,,Менде бір нәрсе бар...
Dialogue: 0,0:07:22.11,0:07:26.12,Default,,0,0,0,,Бұл кезде Акари үшін тосынсый болды
Dialogue: 0,0:07:22.11,0:07:26.12,Default,,0,0,0,,Ол жоқ болады➡
Dialogue: 0,0:07:26.12,0:07:29.12,Default,,0,0,0,,Шынымды айтсам
Dialogue: 0,0:07:26.12,0:07:29.12,Default,,0,0,0,,Мен сізбен кеңескім келеді.
Dialogue: 0,0:07:29.12,0:07:32.12,Default,,0,0,0,,Түсіндім, сонда саған не қызық?
Dialogue: 0,0:07:32.12,0:07:36.06,Default,,0,0,0,,Жақында
Dialogue: 0,0:07:32.12,0:07:36.06,Default,,0,0,0,,Афина өзін жақсы сезінбейді.
Dialogue: 0,0:07:36.06,0:07:38.06,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:36.06,0:07:38.06,Default,,0,0,0,,Иә
Dialogue: 0,0:07:38.06,0:07:40.06,Default,,0,0,0,,Ал Алиса...
Dialogue: 0,0:07:40.06,0:07:44.07,Default,,0,0,0,,Афинаға
Dialogue: 0,0:07:40.06,0:07:44.07,Default,,0,0,0,,Мен сені көргім келмейтін сияқты.
Dialogue: 0,0:07:44.07,0:07:46.07,Default,,0,0,0,,Е...
Dialogue: 0,0:07:46.07,0:07:50.07,Default,,0,0,0,,Бірге хат жаз
Dialogue: 0,0:07:46.07,0:07:50.07,Default,,0,0,0,,Жеткізейік деген күні...
Dialogue: 0,0:07:50.07,0:07:52.08,Default,,0,0,0,,｟Аня-чан
Dialogue: 0,0:07:50.07,0:07:52.08,Default,,0,0,0,,Келе аласыз ба? ｠
Dialogue: 0,0:07:52.08,0:07:56.08,Default,,0,0,0,,｟Аа, жұмыс істеп жатырсыз ба?
Dialogue: 0,0:07:52.08,0:07:56.08,Default,,0,0,0,,Ертең болса да...｠
Dialogue: 0,0:07:56.08,0:08:01.05,Default,,0,0,0,,｟Аа... Жарайды.
Dialogue: 0,0:07:56.08,0:08:01.05,Default,,0,0,0,,Аня-чан, өтінемін｠
Dialogue: 0,0:08:04.09,0:08:09.09,Default,,0,0,0,,Хм... А, мүмкін.
Dialogue: 0,0:08:04.09,0:08:09.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:09.09,0:08:11.10,Default,,0,0,0,,Алиса-чан
Dialogue: 0,0:08:09.09,0:08:11.10,Default,,0,0,0,,Тым қатты ➡
Dialogue: 0,0:08:11.10,0:08:15.10,Default,,0,0,0,,Сіз өзіңізге қашан тым қатал боласыз?
Dialogue: 0,0:08:11.10,0:08:15.10,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:08:15.10,0:08:19.10,Default,,0,0,0,,Әлі күнге дейін
Dialogue: 0,0:08:15.10,0:08:19.10,Default,,0,0,0,,Мен жаңа болған кезімде➡
Dialogue: 0,0:08:19.10,0:08:23.11,Default,,0,0,0,,Бізге қамқор бол
Dialogue: 0,0:08:19.10,0:08:23.11,Default,,0,0,0,,Себепсіз қоңырау шалу➡
Dialogue: 0,0:08:23.11,0:08:25.11,Default,,0,0,0,,Мен сені көруге баруым керек.
Dialogue: 0,0:08:23.11,0:08:25.11,Default,,0,0,0,,Мүмкін емес➡
Dialogue: 0,0:08:25.11,0:08:27.08,Default,,0,0,0,,Мен ұстап тұрдым
Dialogue: 0,0:08:28.11,0:08:30.11,Default,,0,0,0,,Сабыр...
Dialogue: 0,0:08:30.11,0:08:32.12,Default,,0,0,0,,Не болғанын білмеймін➡
Dialogue: 0,0:08:32.12,0:08:36.05,Default,,0,0,0,,Екі адамның дұрыс кездесіп, дұрыс сөйлесуінің жалғыз жолы.
Dialogue: 0,0:08:32.12,0:08:36.05,Default,,0,0,0,,Жоқ деп ойлаймын.
Dialogue: 0,0:08:36.05,0:08:38.06,Default,,0,0,0,,Пуи Пуи
Dialogue: 0,0:08:36.05,0:08:38.06,Default,,0,0,0,,Ақыр аяғында бұл➡
Dialogue: 0,0:08:38.06,0:08:40.06,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:38.06,0:08:40.06,Default,,0,0,0,,Екі адам мүлдем➡
Dialogue: 0,0:08:40.06,0:08:43.06,Default,,0,0,0,,Сіз келгіңіз келетін кеш
Dialogue: 0,0:08:40.06,0:08:43.06,Default,,0,0,0,,Бұл сізде мұны істеуден басқа таңдау жоқ дегенді білдіреді.
Dialogue: 0,0:08:43.06,0:08:45.06,Default,,0,0,0,,Иә
Dialogue: 0,0:08:45.06,0:08:48.07,Default,,0,0,0,,Міндетті түрде келетін нәрсе...
Dialogue: 0,0:08:45.06,0:08:48.07,Default,,0,0,0,,Пуи
Dialogue: 0,0:08:48.07,0:08:50.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:50.07,0:08:54.07,Default,,0,0,0,,Ммм туған күн кеші
Dialogue: 0,0:08:54.07,0:08:57.07,Default,,0,0,0,,Пуи Пуи Ча
Dialogue: 0,0:08:54.07,0:08:57.07,Default,,0,0,0,,Алиса-сенпайдың туған күні!
Dialogue: 0,0:08:57.07,0:09:00.08,Default,,0,0,0,,Пуи!
Dialogue: 0,0:08:57.07,0:09:00.08,Default,,0,0,0,,...1 қыркүйекте➡
Dialogue: 0,0:09:00.08,0:09:03.08,Default,,0,0,0,,Ол әлдеқашан өтті...
Dialogue: 0,0:09:00.08,0:09:03.08,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:09:03.08,0:09:05.08,Default,,0,0,0,,Афина ше?
Dialogue: 0,0:09:03.08,0:09:05.08,Default,,0,0,0,,Пуи Пуи!
Dialogue: 0,0:09:05.08,0:09:09.09,Default,,0,0,0,,24 желтоқсан! Ол ұзақ жол
Dialogue: 0,0:09:09.09,0:09:12.09,Default,,0,0,0,,Пуича…
Dialogue: 0,0:09:09.09,0:09:12.09,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:12.09,0:09:15.09,Default,,0,0,0,,Пуи Пуи Пуи Пуи
Dialogue: 0,0:09:12.09,0:09:15.09,Default,,0,0,0,,Қалай?
Dialogue: 0,0:09:15.09,0:09:17.09,Default,,0,0,0,,Пуйчер
Dialogue: 0,0:09:17.09,0:09:20.10,Default,,0,0,0,,Үй қайығы?
Dialogue: 0,0:09:20.10,0:09:22.10,Default,,0,0,0,,Редентор!
Dialogue: 0,0:09:22.10,0:09:24.10,Default,,0,0,0,,Акацуки
Dialogue: 0,0:09:22.10,0:09:24.10,Default,,0,0,0,,Хохо Реденторе?
Dialogue: 0,0:09:24.10,0:09:26.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.10,0:09:30.11,Default,,0,0,0,,Акацуки-сан бүгін де
Dialogue: 0,0:09:26.10,0:09:30.11,Default,,0,0,0,,Сіз сауданың ортасындасыз ба?
Dialogue: 0,0:09:30.11,0:09:32.11,Default,,0,0,0,,Пуйчер
Dialogue: 0,0:09:30.11,0:09:32.11,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:32.11,0:09:35.11,Default,,0,0,0,,Мен Акваның климатын қорғаймын.
Dialogue: 0,0:09:32.11,0:09:35.11,Default,,0,0,0,,Саламандр ретінде➡
Dialogue: 0,0:09:35.11,0:09:39.12,Default,,0,0,0,,Менің өмірім қарбалас.
Dialogue: 0,0:09:35.11,0:09:39.12,Default,,0,0,0,,Менің бос уақытым жоқ➡
Dialogue: 0,0:09:39.12,0:09:43.12,Default,,0,0,0,,Мен сені тексеруге келдім.
Dialogue: 0,0:09:39.12,0:09:43.12,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:43.12,0:09:45.12,Default,,0,0,0,,Who?
Dialogue: 0,0:09:43.12,0:09:45.12,Default,,0,0,0,,Күн ыстық
Dialogue: 0,0:09:45.12,0:09:47.12,Default,,0,0,0,,Мені Сібірге жібергім келеді.
Dialogue: 0,0:09:47.12,0:09:50.13,Default,,0,0,0,,Шынын айтсам, аса ештеңе емес, бірақ…
Dialogue: 0,0:09:47.12,0:09:50.13,Default,,0,0,0,,Redentore➡ туралы сөз болғанда
Dialogue: 0,0:09:50.13,0:09:53.13,Default,,0,0,0,,Сізге
Dialogue: 0,0:09:50.13,0:09:53.13,Default,,0,0,0,,Өзіңізді уақыт алуға мәжбүрлеу...
Dialogue: 0,0:09:53.13,0:09:57.13,Default,,0,0,0,,Сол Акацуки-сан
Dialogue: 0,0:09:53.13,0:09:57.13,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:57.13,0:10:01.14,Default,,0,0,0,,Ешкім қалмады
Dialogue: 0,0:09:57.13,0:10:01.14,Default,,0,0,0,,Менің амалым жоқ.
Dialogue: 0,0:10:01.14,0:10:04.14,Default,,0,0,0,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:10:01.14,0:10:04.14,Default,,0,0,0,,Момиконың шай уақытында
Dialogue: 0,0:10:01.14,0:10:04.14,Default,,0,0,0,,Біз бірге отырамыз ба?
Dialogue: 0,0:10:04.14,0:10:08.15,Default,,0,0,0,,Мен де қазір жұмысқа барамын.
Dialogue: 0,0:10:08.15,0:10:10.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:14.15,0:10:17.15,Default,,0,0,0,,Бұл жерден шіркеуге баратын көпір бар➡
Dialogue: 0,0:10:17.15,0:10:19.16,Default,,0,0,0,,Толып жатқан адамдар мен көп кемелер
Dialogue: 0,0:10:19.16,0:10:23.16,Default,,0,0,0,,
Dialogue: 0,0:10:19.16,0:10:23.16,Default,,0,0,0,,Және отшашу, және дәмді тағамдар.
Dialogue: 0,0:10:19.16,0:10:23.16,Default,,0,0,0,,Қонақжайлылық болса...
Dialogue: 0,0:10:23.16,0:10:26.16,Default,,0,0,0,,
Dialogue: 0,0:10:23.16,0:10:26.16,Default,,0,0,0,,Иә! Өте қолжетімді! Бұл қызықты болады
Dialogue: 0,0:10:26.16,0:10:29.17,Default,,0,0,0,,Жүрегіміздің арасында көпір болатынына сенімдімін.
Dialogue: 0,0:10:29.17,0:10:33.10,Default,,0,0,0,,Ал, жасайық... Хм...
Dialogue: 0,0:10:33.10,0:10:35.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:33.10,0:10:35.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:35.11,0:10:37.11,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:10:37.11,0:10:40.11,Default,,0,0,0,,Бұл Редентор күні...
Dialogue: 0,0:10:40.11,0:10:42.11,Default,,0,0,0,,Айка
Dialogue: 0,0:10:40.11,0:10:42.11,Default,,0,0,0,,О, керемет естіледі!
Dialogue: 0,0:10:42.11,0:10:46.12,Default,,0,0,0,,Сол күні Редентор жәрмеңкесі болады.
Dialogue: 0,0:10:42.11,0:10:46.12,Default,,0,0,0,,Сен мұны айтпадың ба?
Dialogue: 0,0:10:46.12,0:10:48.12,Default,,0,0,0,,Иә, солай болды.
Dialogue: 0,0:10:48.12,0:10:51.12,Default,,0,0,0,,Фестивальге дейін
Dialogue: 0,0:10:48.12,0:10:51.12,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Филиал менеджері.
Dialogue: 0,0:10:51.12,0:10:55.13,Default,,0,0,0,,Мен үшін алаңдамасаң да
Dialogue: 0,0:10:51.12,0:10:55.13,Default,,0,0,0,,Мен де маған көмектесуіңізді сұраймын.
Dialogue: 0,0:10:55.13,0:10:58.13,Default,,0,0,0,,А... Мен оны білдім.
Dialogue: 0,0:10:58.13,0:11:00.13,Default,,0,0,0,,Сондықтан, Редентор қабылданбады.
Dialogue: 0,0:11:00.13,0:11:03.13,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:11:00.13,0:11:03.13,Default,,0,0,0,,Пуикю…
Dialogue: 0,0:11:03.13,0:11:05.14,Default,,0,0,0,,Дәлірек айтсақ, Айка-сан➡
Dialogue: 0,0:11:05.14,0:11:08.14,Default,,0,0,0,,Балалар
Dialogue: 0,0:11:05.14,0:11:08.14,Default,,0,0,0,,Маған көмектесулеріңізді сұраймын.
Dialogue: 0,0:11:08.14,0:11:10.14,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:08.14,0:11:10.14,Default,,0,0,0,,Пуи Пуи…
Dialogue: 0,0:11:10.14,0:11:13.11,Default,,0,0,0,,Аа, біз қазірдің өзінде үлкен шымшудамыз.
Dialogue: 0,0:11:10.14,0:11:13.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:31.16,0:11:34.10,Default,,0,0,0,,Бүгінгі еңбектеріңізге рахмет.
Dialogue: 0,0:11:31.16,0:11:34.10,Default,,0,0,0,,Ал, Президент
Dialogue: 0,0:11:34.10,0:11:37.07,Default,,0,0,0,,Ал...
Dialogue: 0,0:11:38.10,0:11:44.07,Default,,0,0,0,,Иә? Аня-чан
Dialogue: 0,0:11:38.10,0:11:44.07,Default,,0,0,0,,Сіз әлі оралмаған сияқтысыз.
Dialogue: 0,0:11:51.12,0:11:54.12,Default,,0,0,0,,Афина Сенпай
Dialogue: 0,0:11:54.12,0:11:56.09,Default,,0,0,0,,
Dialogue: 0,0:11:57.12,0:12:00.09,Default,,0,0,0,,
Dialogue: 0,0:12:01.13,0:12:03.09,Default,,0,0,0,,Иә? ｠
Dialogue: 0,0:12:04.13,0:12:09.13,Default,,0,0,0,,｟Ал...
Dialogue: 0,0:12:04.13,0:12:09.13,Default,,0,0,0,,Гамба Афина! ｠
Dialogue: 0,0:12:09.13,0:12:13.10,Default,,0,0,0,,｟Жақсысың ба? Жақтар
Dialogue: 0,0:12:09.13,0:12:13.10,Default,,0,0,0,,｟Ах! ｠
Dialogue: 0,0:12:15.14,0:12:18.14,Default,,0,0,0,,｜Мен тықылдадым, бірақ жауап болмады｠
Dialogue: 0,0:12:18.14,0:12:21.15,Default,,0,0,0,,｟Танысқаныма қуаныштымын
Dialogue: 0,0:12:18.14,0:12:21.15,Default,,0,0,0,,Бүгіннен бастап осы бөлмеде➡
Dialogue: 0,0:12:21.15,0:12:23.15,Default,,0,0,0,,Маған қосылуға рұқсат етіңіз
Dialogue: 0,0:12:21.15,0:12:23.15,Default,,0,0,0,,Мен оны алуды шештім➡
Dialogue: 0,0:12:23.15,0:12:25.15,Default,,0,0,0,,Элис Кэрролл｠
Dialogue: 0,0:12:25.15,0:12:27.12,Default,,0,0,0,,｟мм…｠
Dialogue: 0,0:12:28.15,0:12:31.16,Default,,0,0,0,,｟Ааа Уау｠
Dialogue: 0,0:12:31.16,0:12:34.09,Default,,0,0,0,,｟Аа…｠
Dialogue: 0,0:12:31.16,0:12:34.09,Default,,0,0,0,,｟Жақсысың ба? ｠
Dialogue: 0,0:12:34.09,0:12:39.06,Default,,0,0,0,,｟Аа, бұл жақсы емес шығар｠
Dialogue: 0,0:12:44.10,0:12:47.10,Default,,0,0,0,,｠Бұл қатты｠
Dialogue: 0,0:12:44.10,0:12:47.10,Default,,0,0,0,,｟Бұл қалыпты｠
Dialogue: 0,0:12:47.10,0:12:49.07,Default,,0,0,0,,｟n…｠
Dialogue: 0,0:12:51.11,0:12:54.11,Default,,0,0,0,,｟Танысқаныма қуаныштымын
Dialogue: 0,0:12:51.11,0:12:54.11,Default,,0,0,0,,Бұл жолы Orange Planet➡
Dialogue: 0,0:12:54.11,0:12:58.12,Default,,0,0,0,,Мен компанияға қосылдым.
Dialogue: 0,0:12:54.11,0:12:58.12,Default,,0,0,0,,Менің атым Элис Кэрролл｠
Dialogue: 0,0:12:58.12,0:13:02.12,Default,,0,0,0,,｟Мен тәжірибесіз адаммын, бірақ
Dialogue: 0,0:12:58.12,0:13:02.12,Default,,0,0,0,,Нұсқаулық Сіз қаншалықты білгіңіз келеді➡
Dialogue: 0,0:13:02.12,0:13:05.09,Default,,0,0,0,,Қолдауыңыз үшін рахмет｠
Dialogue: 0,0:13:06.12,0:13:08.09,Default,,0,0,0,,｟Hehe｠
Dialogue: 0,0:13:11.13,0:13:15.13,Default,,0,0,0,,｟Мен екі адаммын
Dialogue: 0,0:13:11.13,0:13:15.13,Default,,0,0,0,,Бұл Афина Даңқы｠
Dialogue: 0,0:13:15.13,0:13:19.10,Default,,0,0,0,,｟Алдын ала рахмет
Dialogue: 0,0:13:15.13,0:13:19.10,Default,,0,0,0,,Алиса-чан
Dialogue: 0,0:13:22.14,0:13:27.11,Default,,0,0,0,,(Мааның ұйқысы)
Dialogue: 0,0:13:29.15,0:13:31.11,Default,,0,0,0,,Алиса-сенпай?
Dialogue: 0,0:13:35.09,0:13:37.05,Default,,0,0,0,,Алиса-сенпай...
Dialogue: 0,0:13:46.10,0:13:48.10,Default,,0,0,0,,Мерейтойды іздеп жүрсіз бе?
Dialogue: 0,0:13:46.10,0:13:48.10,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:13:48.10,0:13:52.10,Default,,0,0,0,,Бәріміз қаланы түгел ақтарсақ
Dialogue: 0,0:13:48.10,0:13:52.10,Default,,0,0,0,,Алиса мен Афина іште➡
Dialogue: 0,0:13:52.10,0:13:55.11,Default,,0,0,0,,Келмей тұра алмаймын
Dialogue: 0,0:13:52.10,0:13:55.11,Default,,0,0,0,,Мерейтойды табуға болады
Dialogue: 0,0:13:55.11,0:13:57.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:57.11,0:14:00.11,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:13:57.11,0:14:00.11,Default,,0,0,0,,Пуи Пуи Мяу
Dialogue: 0,0:14:00.11,0:14:02.08,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:14:03.11,0:14:06.12,Default,,0,0,0,,Мұнда? Ария президенті
Dialogue: 0,0:14:03.11,0:14:06.12,Default,,0,0,0,,Пуи
Dialogue: 0,0:14:06.12,0:14:09.12,Default,,0,0,0,,Пуи Пуи Пуи
Dialogue: 0,0:14:09.12,0:14:13.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:09.12,0:14:13.09,Default,,0,0,0,,Бұл тамаша мерейтой!
Dialogue: 0,0:14:14.12,0:14:20.13,Default,,0,0,0,,Баши
Dialogue: 0,0:14:14.12,0:14:20.13,Default,,0,0,0,,Риалто көпірі
Dialogue: 0,0:14:14.12,0:14:20.13,Default,,0,0,0,,1444 Көптің салмағынан құлады
Dialogue: 0,0:14:20.13,0:14:23.13,Default,,0,0,0,,Пуи Пуи Пуи Ча
Dialogue: 0,0:14:20.13,0:14:23.13,Default,,0,0,0,,А...
Dialogue: 0,0:14:23.13,0:14:28.14,Default,,0,0,0,,Үлкен қоңырау мұнарасы 1902 жылы таңертең құлады
Dialogue: 0,0:14:28.14,0:14:34.08,Default,,0,0,0,,Казанова 1755 Түрмеде
Dialogue: 0,0:14:34.08,0:14:38.08,Default,,0,0,0,,Жоқ Бағыты басқа.
Dialogue: 0,0:14:38.08,0:14:41.08,Default,,0,0,0,,Я...
Dialogue: 0,0:14:38.08,0:14:41.08,Default,,0,0,0,,О, Ай Чан
Dialogue: 0,0:14:41.08,0:14:43.09,Default,,0,0,0,,Пуи Пуи Чар
Dialogue: 0,0:14:41.08,0:14:43.09,Default,,0,0,0,,Алисия
Dialogue: 0,0:14:43.09,0:14:48.09,Default,,0,0,0,,Пуи Пуи Пуи…
Dialogue: 0,0:14:43.09,0:14:48.09,Default,,0,0,0,,Хехе, ау.
Dialogue: 0,0:14:48.09,0:14:50.09,Default,,0,0,0,,Сіз президент Ариямен жұмыс жасайсыз ба?
Dialogue: 0,0:14:50.09,0:14:53.10,Default,,0,0,0,,Пуи Пуи Пуи Пуи Пуи Пуи
Dialogue: 0,0:14:50.09,0:14:53.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.10,0:14:55.10,Default,,0,0,0,,Мен мерейтойды іздеп жүрмін.
Dialogue: 0,0:14:55.10,0:14:57.10,Default,,0,0,0,,Мерейтойды іздеп жүрсіз бе?
Dialogue: 0,0:14:57.10,0:15:00.10,Default,,0,0,0,,Иә, шын мәнінде...
Dialogue: 0,0:15:00.10,0:15:02.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:04.11,0:15:09.08,Default,,0,0,0,,Акира
Dialogue: 0,0:15:04.11,0:15:09.08,Default,,0,0,0,,Салқындап қалдыңыз ба? Тұтынушы
Dialogue: 0,0:15:04.11,0:15:09.08,Default,,0,0,0,,Иә
Dialogue: 0,0:15:10.11,0:15:12.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:12.12,0:15:25.10,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:27.13,0:15:29.13,Default,,0,0,0,,Иә? Мен тағы да осындамын
Dialogue: 0,0:15:29.13,0:15:31.13,Default,,0,0,0,,
Dialogue: 0,0:15:29.13,0:15:31.13,Default,,0,0,0,,Уау! Қауіпті, одан аулақ болыңыз, одан аулақ болыңыз!
Dialogue: 0,0:15:31.13,0:15:33.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:33.07,0:15:36.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:37.07,0:15:39.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:39.08,0:15:41.04,Default,,0,0,0,,(қозғалтқыштың соғу дыбысы)
Dialogue: 0,0:15:39.08,0:15:41.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:46.08,0:15:49.09,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:15:46.08,0:15:49.09,Default,,0,0,0,,Егер Алетта...
Dialogue: 0,0:15:49.09,0:15:51.09,Default,,0,0,0,,Сен де бүгін жаттығу жасайсың ба?
Dialogue: 0,0:15:51.09,0:15:55.09,Default,,0,0,0,,Иә! Әлі де толыққанды адам
Dialogue: 0,0:15:51.09,0:15:55.09,Default,,0,0,0,,Сильфке апаратын жол ұзақ
Dialogue: 0,0:15:55.09,0:15:59.06,Default,,0,0,0,,Аня ше? Бүгін жалғызсың ба?
Dialogue: 0,0:16:02.10,0:16:04.10,Default,,0,0,0,,
Dialogue: 0,0:16:02.10,0:16:04.10,Default,,0,0,0,,Соңғы кездері үшеуіңіз бірге жаттығасыздар.
Dialogue: 0,0:16:04.10,0:16:08.11,Default,,0,0,0,,Көрген сайын
Dialogue: 0,0:16:04.10,0:16:08.11,Default,,0,0,0,,Мен бұл қызық сияқты көрінді деп ойладым.
Dialogue: 0,0:16:08.11,0:16:10.11,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:10.11,0:16:13.08,Default,,0,0,0,,Көңіл көтеру жақсы!
Dialogue: 0,0:16:14.11,0:16:18.12,Default,,0,0,0,,Алетта әрқашан болды
Dialogue: 0,0:16:14.11,0:16:18.12,Default,,0,0,0,,Сильфа боламын дедіңіз.
Dialogue: 0,0:16:18.12,0:16:21.12,Default,,0,0,0,,
Dialogue: 0,0:16:18.12,0:16:21.12,Default,,0,0,0,,Бұл менің бала кезімнен арманым.
Dialogue: 0,0:16:21.12,0:16:23.12,Default,,0,0,0,,Аня да
Dialogue: 0,0:16:21.12,0:16:23.12,Default,,0,0,0,,Қайталанушыға айналу➡
Dialogue: 0,0:16:23.12,0:16:25.12,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:16:23.12,0:16:25.12,Default,,0,0,0,,Иә
Dialogue: 0,0:16:25.12,0:16:30.09,Default,,0,0,0,,Бірақ Алеттадан айырмашылығы
Dialogue: 0,0:16:25.12,0:16:30.09,Default,,0,0,0,,Менің ойым жоқ болғандықтан...
Dialogue: 0,0:16:37.07,0:16:43.04,Default,,0,0,0,,Кейде мен солай ойлаймын
Dialogue: 0,0:16:37.07,0:16:43.04,Default,,0,0,0,,Осы жерде қалғаным дұрыс па деп ойлаймын.
Dialogue: 0,0:16:46.08,0:16:50.08,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:16:46.08,0:16:50.08,Default,,0,0,0,,Аня
Dialogue: 0,0:16:50.08,0:16:54.05,Default,,0,0,0,,Иә, түсінемін!
Dialogue: 0,0:16:50.08,0:16:54.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:56.09,0:16:58.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:56.09,0:16:58.09,Default,,0,0,0,,Содан кейін мәңгі➡
Dialogue: 0,0:16:58.09,0:17:02.06,Default,,0,0,0,,Мен сені өзіммен бірге алып кетемін!
Мен
Dialogue: 0,0:16:58.09,0:17:02.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:04.09,0:17:06.10,Default,,0,0,0,,➡ айтқым келеді
Dialogue: 0,0:17:06.10,0:17:09.10,Default,,0,0,0,,Менің әлі де ұшуға болатын аймақтарым бар.
Dialogue: 0,0:17:06.10,0:17:09.10,Default,,0,0,0,,Өйткені ол шектеулі➡
Dialogue: 0,0:17:09.10,0:17:12.10,Default,,0,0,0,,Дәл қазір ол тек осы жерде.
Dialogue: 0,0:17:12.10,0:17:16.11,Default,,0,0,0,,Уау, бұл әлі де керемет.
Dialogue: 0,0:17:16.11,0:17:20.11,Default,,0,0,0,,Осы маусымда жолдар мен су жолдары
Dialogue: 0,0:17:16.11,0:17:20.11,Default,,0,0,0,,Сіздің киіміңіз басқа маусымдардан ерекшеленеді, солай емес пе?
Dialogue: 0,0:17:20.11,0:17:24.11,Default,,0,0,0,,Расында да, шатырдың түсі мен ағаштардың түсі➡
Dialogue: 0,0:17:24.11,0:17:27.12,Default,,0,0,0,,Ал түскен жапырақтардың үндестігі
Dialogue: 0,0:17:27.12,0:17:31.12,Default,,0,0,0,,Бұл қала
Dialogue: 0,0:17:27.12,0:17:31.12,Default,,0,0,0,,Өте әдемі болды
Dialogue: 0,0:17:31.12,0:17:33.06,Default,,0,0,0,,Аспанға тамсанамын➡
Dialogue: 0,0:17:33.06,0:17:37.06,Default,,0,0,0,,Бала кезінен
Dialogue: 0,0:17:33.06,0:17:37.06,Default,,0,0,0,,Аспанға қарай бердім
Dialogue: 0,0:17:37.06,0:17:40.06,Default,,0,0,0,,Аспанда ұша алсам, әрине
Dialogue: 0,0:17:37.06,0:17:40.06,Default,,0,0,0,,Бұрын көрмеген әлем➡
Dialogue: 0,0:17:40.06,0:17:43.07,Default,,0,0,0,,Мен көре алатыныма сендім.
Dialogue: 0,0:17:43.07,0:17:46.07,Default,,0,0,0,,Бірақ сіз аспанда ұшқан кезде➡
Dialogue: 0,0:17:46.07,0:17:50.04,Default,,0,0,0,,Біздің көргеніміз
Dialogue: 0,0:17:46.07,0:17:50.04,Default,,0,0,0,,Мен әрқашан болатын қала
Dialogue: 0,0:17:51.07,0:17:55.05,Default,,0,0,0,,Сол жерде мен аспанға қарап тұрдым
Dialogue: 0,0:17:51.07,0:17:55.05,Default,,0,0,0,,Менде өзім бар
Dialogue: 0,0:17:58.08,0:18:00.05,Default,,0,0,0,,Ах
Dialogue: 0,0:18:01.08,0:18:05.09,Default,,0,0,0,,｟Уау хехехехе｠
Dialogue: 0,0:18:05.09,0:18:07.09,Default,,0,0,0,,｟Аа, бұл гондола! ｠
Dialogue: 0,0:18:07.09,0:18:10.09,Default,,0,0,0,,｟Аня, күте тұр｠
Dialogue: 0,0:18:10.09,0:18:14.06,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:18:16.10,0:18:19.10,Default,,0,0,0,,Мен де сол кездегі
Dialogue: 0,0:18:19.10,0:18:24.11,Default,,0,0,0,,Сәлем Алетта-чан
Dialogue: 0,0:18:19.10,0:18:24.11,Default,,0,0,0,,Сен де бүгін қатты жаттығасың.
Dialogue: 0,0:18:24.11,0:18:27.11,Default,,0,0,0,,Иә, Вуди мырза.
Dialogue: 0,0:18:24.11,0:18:27.11,Default,,0,0,0,,бүгін өте ұзақ күн болды, мен қатты шаршадым…
Dialogue: 0,0:18:27.11,0:18:29.11,Default,,0,0,0,,Қала өте әдемі
Dialogue: 0,0:18:29.11,0:18:33.05,Default,,0,0,0,,О, бұл рас.
Dialogue: 0,0:18:29.11,0:18:33.05,Default,,0,0,0,,Мүмкін сондықтан болар?
Dialogue: 0,0:18:33.05,0:18:35.05,Default,,0,0,0,,Екеуі де күлімсірейді.
Dialogue: 0,0:18:33.05,0:18:35.05,Default,,0,0,0,,Бұл керемет.
Dialogue: 0,0:18:35.05,0:18:39.06,Default,,0,0,0,,Не? Мен күлдім бе?
Dialogue: 0,0:18:39.06,0:18:43.06,Default,,0,0,0,,(Вуди)
Dialogue: 0,0:18:39.06,0:18:43.06,Default,,0,0,0,,Хехехе, кездескенше~
Dialogue: 0,0:18:43.06,0:18:46.03,Default,,0,0,0,,Жұмысыңызға сәттілік
Dialogue: 0,0:18:48.06,0:18:50.07,Default,,0,0,0,,Аня
Dialogue: 0,0:18:48.06,0:18:50.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:50.07,0:18:54.07,Default,,0,0,0,,
Dialogue: 0,0:18:50.07,0:18:54.07,Default,,0,0,0,,Менің қазір ұша алатын жерім өте тар.
Dialogue: 0,0:18:54.07,0:18:58.07,Default,,0,0,0,,Бірақ бір күні, жоғарырақ және алысырақ
Dialogue: 0,0:18:54.07,0:18:58.07,Default,,0,0,0,,Сіз ұша алатын кезде➡
Dialogue: 0,0:18:58.07,0:19:02.08,Default,,0,0,0,,Бұл аудан қанша кіші?
Dialogue: 0,0:18:58.07,0:19:02.08,Default,,0,0,0,,Керемет жер болды➡
Dialogue: 0,0:19:02.08,0:19:04.08,Default,,0,0,0,,Сіз байқайсыз деп ойлаймын.
Dialogue: 0,0:19:04.08,0:19:08.08,Default,,0,0,0,,Мен қазір қайда екенімді білемін
Dialogue: 0,0:19:04.08,0:19:08.08,Default,,0,0,0,,Бұл қандай тамаша жер?➡
Dialogue: 0,0:19:08.08,0:19:12.09,Default,,0,0,0,,Сіз сонда болғанда
Dialogue: 0,0:19:08.08,0:19:12.09,Default,,0,0,0,,Менің ойымша, бұл сіз көре алмайтын нәрсе.
Dialogue: 0,0:19:12.09,0:19:16.09,Default,,0,0,0,,Аня кім қазір осында
Dialogue: 0,0:19:12.09,0:19:16.09,Default,,0,0,0,,Бұл қазір Аня.
Dialogue: 0,0:19:16.09,0:19:19.06,Default,,0,0,0,,Мен қазір...
Dialogue: 0,0:19:24.10,0:19:28.10,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:19:24.10,0:19:28.10,Default,,0,0,0,,Ах
Dialogue: 0,0:19:28.10,0:19:30.11,Default,,0,0,0,,Аня-чан қазір
Dialogue: 0,0:19:28.10,0:19:30.11,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:19:30.11,0:19:34.11,Default,,0,0,0,,Ах, Алиса-сенпай, қош келдіңіз.
Dialogue: 0,0:19:34.11,0:19:37.11,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:19:37.11,0:19:43.09,Default,,0,0,0,,Не? О, өлі жапырақтар
Dialogue: 0,0:19:37.11,0:19:43.09,Default,,0,0,0,,Бұл әдемі, солай емес пе?
Dialogue: 0,0:19:44.12,0:19:48.12,Default,,0,0,0,,Иә, Аня-чан.
Dialogue: 0,0:19:44.12,0:19:48.12,Default,,0,0,0,,Кешкі ас іштің бе?
Dialogue: 0,0:19:48.12,0:19:50.13,Default,,0,0,0,,Қаласаң менімен бірге жүр...
Dialogue: 0,0:19:50.13,0:19:53.13,Default,,0,0,0,,Ахх...
Dialogue: 0,0:19:50.13,0:19:53.13,Default,,0,0,0,,Досыммен ұзақ уақыттан кейін таныстым➡
Dialogue: 0,0:19:53.13,0:19:55.13,Default,,0,0,0,,Мен оны жедім.
Dialogue: 0,0:19:55.13,0:19:58.10,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:59.14,0:20:01.10,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:04.14,0:20:07.14,Default,,0,0,0,,Сол Аня-чан
Dialogue: 0,0:20:04.14,0:20:07.14,Default,,0,0,0,,Иә
Dialogue: 0,0:20:07.14,0:20:11.15,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:20:07.14,0:20:11.15,Default,,0,0,0,,Егер сізді алаңдататын мәселелер болса➡
Dialogue: 0,0:20:11.15,0:20:14.15,Default,,0,0,0,,Маған кез келген уақытта айтыңыз...
Dialogue: 0,0:20:11.15,0:20:14.15,Default,,0,0,0,,А... жоқ
Dialogue: 0,0:20:14.15,0:20:19.16,Default,,0,0,0,,Бұл Алиса-сенпай.
Dialogue: 0,0:20:14.15,0:20:19.16,Default,,0,0,0,,Сіз бір нәрсеге алаңдайсыз ба?
Dialogue: 0,0:20:19.16,0:20:21.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:21.16,0:20:25.16,Default,,0,0,0,,А... а...
Dialogue: 0,0:20:25.16,0:20:27.16,Default,,0,0,0,,Е, эй, эй... иә...!
Dialogue: 0,0:20:27.16,0:20:31.17,Default,,0,0,0,,О, жоқ, мен мүлдем жоқпын.
Dialogue: 0,0:20:31.17,0:20:35.11,Default,,0,0,0,,Бұл үлкен пайдасыз шеңбер
Dialogue: 0,0:20:31.17,0:20:35.11,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:35.11,0:20:40.11,Default,,0,0,0,,Бубубу Бубубу…
Dialogue: 0,0:20:40.11,0:20:43.11,Default,,0,0,0,,Бубубу…
Dialogue: 0,0:20:43.11,0:20:45.08,Default,,0,0,0,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,0:20:48.12,0:20:50.12,Default,,0,0,0,,Ооо!
Dialogue: 0,0:20:48.12,0:20:50.12,Default,,0,0,0,,(Мұрынды шұқылау дыбысы)
Dialogue: 0,0:20:50.12,0:20:53.12,Default,,0,0,0,,А... Алиса-сенпай
Dialogue: 0,0:20:50.12,0:20:53.12,Default,,0,0,0,,Өзіңді қолыңа ал.
Dialogue: 0,0:20:53.12,0:20:56.09,Default,,0,0,0,,Дамамару деген не?
Dialogue: 0,0:20:57.13,0:21:00.13,Default,,0,0,0,,Мен аға ретінде дисквалификацияландым.
Dialogue: 0,0:21:00.13,0:21:03.10,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:21:05.14,0:21:07.10,Default,,0,0,0,,Алиса-сенпай?
Dialogue: 0,0:21:08.14,0:21:10.14,Default,,0,0,0,,Афина-сенпай бұл➡
Dialogue: 0,0:21:10.14,0:21:13.14,Default,,0,0,0,,Маған көп нәрсе
Dialogue: 0,0:21:10.14,0:21:13.14,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:21:13.14,0:21:19.15,Default,,0,0,0,,Күлімсіресеңіз
Dialogue: 0,0:21:13.14,0:21:19.15,Default,,0,0,0,,Кейде адамдар да күледі.
Dialogue: 0,0:21:19.15,0:21:24.12,Default,,0,0,0,,Өз әндеріңізді өзіңізге ұнайтындай етіп жасаңыз
Dialogue: 0,0:21:19.15,0:21:24.12,Default,,0,0,0,,...
Dialogue: 0,0:21:27.16,0:21:32.13,Default,,0,0,0,,Басқа маңызды нәрселер
Dialogue: 0,0:21:27.16,0:21:32.13,Default,,0,0,0,,Ол маған көп нәрсені үйретті.
Dialogue: 0,0:21:36.10,0:21:39.10,Default,,0,0,0,,｟Акари ведьмы Бефана
Dialogue: 0,0:21:36.10,0:21:39.10,Default,,0,0,0,,Сіз білесіз бе? ｠
Dialogue: 0,0:21:39.10,0:21:41.10,Default,,0,0,0,,｟Бефана? ｠
Dialogue: 0,0:21:41.10,0:21:44.11,Default,,0,0,0,,｟Рождествоны қорытындылау
Dialogue: 0,0:21:41.10,0:21:44.11,Default,,0,0,0,,Epiphany күнінің басты кейіпкері｠
Dialogue: 0,0:21:44.11,0:21:47.11,Default,,0,0,0,,｟Ұшатын сыпырғышқа міну
Dialogue: 0,0:21:44.11,0:21:47.11,Default,,0,0,0,,Балалар шұлықтарына➡
Dialogue: 0,0:21:47.11,0:21:49.11,Default,,0,0,0,,Ойыншықтар мен тәттілер
Dialogue: 0,0:21:47.11,0:21:49.11,Default,,0,0,0,,Сіз оны бересіз бе?
Dialogue: 0,0:21:49.11,0:21:52.12,Default,,0,0,0,,｟Уау...｠
Dialogue: 0,0:21:49.11,0:21:52.12,Default,,0,0,0,,｟Puyture｠
Dialogue: 0,0:21:52.12,0:21:56.12,Default,,0,0,0,,｟Алайда тек жақсы балалар
Dialogue: 0,0:21:52.12,0:21:56.12,Default,,0,0,0,,Нашар балаларға арналған қара көмір｠
Dialogue: 0,0:21:56.12,0:21:58.12,Default,,0,0,0,,｟Иә…｠
Dialogue: 0,0:21:56.12,0:21:58.12,Default,,0,0,0,,｟Пуи｠
Dialogue: 0,0:21:58.12,0:22:00.12,Default,,0,0,0,,｟Сиқыршы Бефана Каа｠
Dialogue: 0,0:22:00.12,0:22:03.13,Default,,0,0,0,,｟Әйтеуір өте
Dialogue: 0,0:22:00.12,0:22:03.13,Default,,0,0,0,,Мен қатты толқып тұрмын➡
Dialogue: 0,0:22:03.13,0:22:06.13,Default,,0,0,0,,Бұл қызық болады, солай емес пе?
Dialogue: 0,0:22:06.13,0:22:09.13,Default,,0,0,0,,｟Екеуіңіз де
Dialogue: 0,0:22:06.13,0:22:09.13,Default,,0,0,0,,Бұл үлкен нәресте｠
Dialogue: 0,0:22:09.13,0:22:11.13,Default,,0,0,0,,｟Иә? ｠
Dialogue: 0,0:22:09.13,0:22:11.13,Default,,0,0,0,,｟Пуи? ｠
Dialogue: 0,0:22:11.13,0:22:13.14,Default,,0,0,0,,｟Не, кенеттен｠
Dialogue: 0,0:22:13.14,0:22:16.14,Default,,0,0,0,,Егер ｟ болса, кіші-чан болады
Dialogue: 0,0:22:13.14,0:22:16.14,Default,,0,0,0,,Сіз ересекпін дейсіз бе? ｠
Dialogue: 0,0:22:16.14,0:22:20.14,Default,,0,0,0,,｟Иә, өкінішке орай｠
Dialogue: 0,0:22:16.14,0:22:20.14,Default,,0,0,0,,｟Алис-чан｠
Dialogue: 0,0:22:20.14,0:22:23.15,Default,,0,0,0,,｟Мүлдір баладай
Dialogue: 0,0:22:20.14,0:22:23.15,Default,,0,0,0,,Мен бет бұрдым｠
Dialogue: 0,0:22:23.15,0:22:27.12,Default,,0,0,0,,｟Бұл жер...
Dialogue: 0,0:22:23.15,0:22:27.12,Default,,0,0,0,,Әпкеңмен сөйлес.
Dialogue: 0,0:22:28.15,0:22:33.09,Default,,0,0,0,,｟Әйтеуір соңғы кездері
Dialogue: 0,0:22:28.15,0:22:33.09,Default,,0,0,0,,Мен қатты толқып тұрған жоқпын.
Dialogue: 0,0:22:33.09,0:22:35.09,Default,,0,0,0,,｟Иә? ｠
Dialogue: 0,0:22:33.09,0:22:35.09,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:22:35.09,0:22:39.10,Default,,0,0,0,,｟Мен кішкентай кезімде Бефана деген сиқырды да көрдім.
Dialogue: 0,0:22:35.09,0:22:39.10,Default,,0,0,0,,Мен оған таң қалсам да｠
Dialogue: 0,0:22:39.10,0:22:42.10,Default,,0,0,0,,(Айка)
Dialogue: 0,0:22:39.10,0:22:42.10,Default,,0,0,0,,｟Бақсылар шынымен жоқ
Dialogue: 0,0:22:39.10,0:22:42.10,Default,,0,0,0,,Мен шындықты көре аламын➡
Dialogue: 0,0:22:42.10,0:22:44.10,Default,,0,0,0,,Бұл сіз шынымен ләззат ала алмайсыз дегенді білдіре ме? ｠
Dialogue: 0,0:22:44.10,0:22:50.11,Default,,0,0,0,,｟Иә, ересек болу
Dialogue: 0,0:22:44.10,0:22:50.11,Default,,0,0,0,,Үлкен, қызықсыз｠
Dialogue: 0,0:22:50.11,0:22:52.08,Default,,0,0,0,,｟Алис-чан｠
Dialogue: 0,0:22:58.11,0:23:02.12,Default,,0,0,0,,｟Иә, мен сонда бардым~｠
Dialogue: 0,0:22:58.11,0:23:02.12,Default,,0,0,0,,｟Ал, жақсы, жақсы! ｠
Dialogue: 0,0:23:02.12,0:23:04.12,Default,,0,0,0,,Иә? ｠
Dialogue: 0,0:23:04.12,0:23:08.09,Default,,0,0,0,,｟Ах Алиса Чан
Dialogue: 0,0:23:04.12,0:23:08.09,Default,,0,0,0,,Қош келдіңіз｠
Dialogue: 0,0:23:13.13,0:23:15.10,Default,,0,0,0,,Иә? ｠
Dialogue: 0,0:23:18.13,0:23:20.14,Default,,0,0,0,,｟Міне, мынаны қараңыз➡
Dialogue: 0,0:23:20.14,0:23:23.14,Default,,0,0,0,,Бұзу қиын
Dialogue: 0,0:23:20.14,0:23:23.14,Default,,0,0,0,,Бұл сабын көпіршігі｠
Dialogue: 0,0:23:23.14,0:23:27.14,Default,,0,0,0,,｟Алисиа-чаннан
Dialogue: 0,0:23:23.14,0:23:27.14,Default,,0,0,0,,Мен оны Рождестволық сыйлық ретінде алдым｠
Dialogue: 0,0:23:27.14,0:23:31.15,Default,,0,0,0,,｟Мен түсінемін. Бұл жақсы.｠
Dialogue: 0,0:23:31.15,0:23:35.12,Default,,0,0,0,,｟Не болды? Өзіңізді жақсы сезінбейсіз бе?
Dialogue: 0,0:23:37.09,0:23:40.09,Default,,0,0,0,,｟Мама...мама! Ал...｠
Dialogue: 0,0:23:40.09,0:23:42.09,Default,,0,0,0,,｟Иә, Алиса Чан｠
Dialogue: 0,0:23:42.09,0:23:46.10,Default,,0,0,0,,｟Епифаниядағы Бефана
Dialogue: 0,0:23:42.09,0:23:46.10,Default,,0,0,0,,Сіз не сұрайсыз? ｠
Dialogue: 0,0:23:46.10,0:23:50.10,Default,,0,0,0,,｟Ах...｠
Dialogue: 0,0:23:50.10,0:23:56.11,Default,,0,0,0,,｟Себебі мен арманымды ұмытқан жаман баламын
Dialogue: 0,0:23:50.10,0:23:56.11,Default,,0,0,0,,Бұл қою қара көмір｠
Dialogue: 0,0:23:56.11,0:23:58.11,Default,,0,0,0,,｟Ал, мен де сол көмірді шұлығыма салып қойдым➡
Dialogue: 0,0:23:58.11,0:24:01.08,Default,,0,0,0,,Қою
Dialogue: 0,0:23:58.11,0:24:01.08,Default,,0,0,0,,Мен солай болады деп ойлаймын.
Dialogue: 0,0:24:04.11,0:24:07.12,Default,,0,0,0,,｟Бәрі трюк ойнап жатыр｠
Dialogue: 0,0:24:07.12,0:24:11.12,Default,,0,0,0,,｟Себебі ведьма Бефана
Dialogue: 0,0:24:07.12,0:24:11.12,Default,,0,0,0,,Шынында да жоқ.
Dialogue: 0,0:24:11.12,0:24:13.09,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:24:14.12,0:24:18.13,Default,,0,0,0,,｟бірақ бәрібір
Dialogue: 0,0:24:14.12,0:24:18.13,Default,,0,0,0,,Өтініш жасағыңыз келсе➡
Dialogue: 0,0:24:18.13,0:24:20.13,Default,,0,0,0,,Сен не қалайсың, Алиса? ｠
Dialogue: 0,0:24:20.13,0:24:23.13,Default,,0,0,0,,｟｟｠
Dialogue: 0,0:24:20.13,0:24:23.13,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:24:23.13,0:24:25.13,Default,,0,0,0,,｟Сабын елінің ханшайымы➡
Dialogue: 0,0:24:25.13,0:24:29.14,Default,,0,0,0,,Қанағаттанасыз ба? ｠
Dialogue: 0,0:24:29.14,0:24:31.14,Default,,0,0,0,,｟nnnn…｠
Dialogue: 0,0:24:31.14,0:24:34.08,Default,,0,0,0,,｟Мен қазір ұйықтаймын｠
Dialogue: 0,0:24:34.08,0:24:38.08,Default,,0,0,0,,｟Иә, қайырлы түн｠
Dialogue: 0,0:24:34.08,0:24:38.08,Default,,0,0,0,,｟Жақсы｠
Dialogue: 0,0:24:38.08,0:24:58.10,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:58.10,0:25:00.10,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:00.10,0:25:05.07,Default,,0,0,0,,｟Сонымен қатар, Афина-сенпай
Dialogue: 0,0:25:00.10,0:25:05.07,Default,,0,0,0,,Шұлықты рұқсатсыз ілу｠
Dialogue: 0,0:25:10.11,0:25:12.08,Default,,0,0,0,,｟Хунхунхун хунхун｠
Dialogue: 0,0:25:14.12,0:25:19.09,Default,,0,0,0,,(Мааның ұйқысы)
Dialogue: 0,0:25:24.13,0:25:28.13,Default,,0,0,0,,⚟
Dialogue: 0,0:25:28.13,0:25:31.10,Default,,0,0,0,,｟nnnnnn…｠
Dialogue: 0,0:25:34.07,0:25:36.04,Default,,0,0,0,,｟Ха｠
Dialogue: 0,0:25:38.07,0:25:42.05,Default,,0,0,0,,｟Қайырлы кеш
Dialogue: 0,0:25:38.07,0:25:42.05,Default,,0,0,0,,Жақсы қыз Алиса
Dialogue: 0,0:25:44.08,0:25:49.09,Default,,0,0,0,,｟Мен сиқыршы Бефанамын
Dialogue: 0,0:25:44.08,0:25:49.09,Default,,0,0,0,,Жүр, менің артымнан жүр｠
Dialogue: 0,0:25:49.09,0:25:53.09,Default,,0,0,0,,｟Жақсы…｠
Dialogue: 0,0:25:49.09,0:25:53.09,Default,,0,0,0,,｟Не істеп жатырсың? Афина Сенпай
Dialogue: 0,0:25:53.09,0:25:56.06,Default,,0,0,0,,｟Uu…｠
Dialogue: 0,0:25:53.09,0:25:56.06,Default,,0,0,0,,｟Ха｠
Dialogue: 0,0:25:58.09,0:26:01.10,Default,,0,0,0,,(жылжымалы дыбыс)
Dialogue: 0,0:25:58.09,0:26:01.10,Default,,0,0,0,,｟Уау! ｠
Dialogue: 0,0:26:01.10,0:26:04.10,Default,,0,0,0,,｟Ха ха…｠
Dialogue: 0,0:26:04.10,0:26:06.10,Default,,0,0,0,,｟ Міне.
Dialogue: 0,0:26:06.10,0:26:09.11,Default,,0,0,0,,｟Афина-сенпай!
Dialogue: 0,0:26:06.10,0:26:09.11,Default,,0,0,0,,Түнде осылай шықсаңыз➡
Dialogue: 0,0:26:09.11,0:26:12.11,Default,,0,0,0,,Тамағың ауырады! ｠
Dialogue: 0,0:26:12.11,0:26:22.12,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:26:22.12,0:26:26.12,Default,,0,0,0,,｟Афина-сенпай, қазірдің өзінде! ｠
Dialogue: 0,0:26:26.12,0:26:29.09,Default,,0,0,0,,｟Үлкен
Dialogue: 0,0:26:26.12,0:26:29.09,Default,,0,0,0,,Ол үлкен жұмысты қажет ететін аға! ｠
Dialogue: 0,0:26:30.13,0:26:35.10,Default,,0,0,0,,｟Афина-сенпай! Бұл қайда? ｠
Dialogue: 0,0:26:36.07,0:26:40.07,Default,,0,0,0,,《Ұйқы бар, суық және қараңғы》
Dialogue: 0,0:26:40.07,0:26:42.07,Default,,0,0,0,,《Маған артыңыздан жүруімді айт➡
Dialogue: 0,0:26:42.07,0:26:45.07,Default,,0,0,0,,Афина Сенпай
Dialogue: 0,0:26:42.07,0:26:45.07,Default,,0,0,0,,Мен әрі қарай жүремін.
Dialogue: 0,0:26:45.07,0:26:50.05,Default,,0,0,0,,｟Ха ха ха…｠
Dialogue: 0,0:26:53.08,0:26:57.09,Default,,0,0,0,,《Бефана сиқыршы?
Dialogue: 0,0:26:53.08,0:26:57.09,Default,,0,0,0,,Шынында да жоқ.
Dialogue: 0,0:26:57.09,0:26:59.09,Default,,0,0,0,,｟Ха…｠
Dialogue: 0,0:26:59.09,0:27:02.09,Default,,0,0,0,,⚟♪ (ән айту)
Dialogue: 0,0:26:59.09,0:27:02.09,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:27:02.09,0:27:05.09,Default,,0,0,0,,♪~
Dialogue: 0,0:27:05.09,0:27:07.10,Default,,0,0,0,,｟Ах...｠
Dialogue: 0,0:27:07.10,0:27:17.11,Default,,0,0,0,,♪~
Dialogue: 0,0:27:17.11,0:27:19.11,Default,,0,0,0,,｟Афина-сенпай! ｠
Dialogue: 0,0:27:19.11,0:27:24.11,Default,,0,0,0,,♪~
Dialogue: 0,0:27:24.11,0:27:26.08,Default,,0,0,0,,｟Е...｠
Dialogue: 0,0:27:29.12,0:27:31.09,Default,,0,0,0,,｟Ааа...｠
Dialogue: 0,0:27:32.12,0:27:35.06,Default,,0,0,0,,｟Афина-сенпай, сен қайдасың? ｠
Dialogue: 0,0:27:35.06,0:27:40.06,Default,,0,0,0,,｟Біз абай болуымыз керек
Dialogue: 0,0:27:35.06,0:27:40.06,Default,,0,0,0,,Мен үйге жалғыз барамын.
Dialogue: 0,0:27:40.06,0:27:43.07,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:27:43.07,0:27:46.04,Default,,0,0,0,,｟Ааа...｠
Dialogue: 0,0:27:43.07,0:27:46.04,Default,,0,0,0,,｟Ал…｠
Dialogue: 0,0:27:47.07,0:27:49.04,Default,,0,0,0,,｟Уау…｠
Dialogue: 0,0:27:54.08,0:27:58.08,Default,,0,0,0,,｟Ханшайым｠
Dialogue: 0,0:27:54.08,0:27:58.08,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:27:58.08,0:28:01.08,Default,,0,0,0,,｟Сабын еліне қош келдіңіз｠
Dialogue: 0,0:28:01.08,0:28:04.05,Default,,0,0,0,,｟Эх｠
Dialogue: 0,0:28:01.08,0:28:04.05,Default,,0,0,0,,｟Ал…｠
Dialogue: 0,0:28:06.09,0:28:13.06,Default,,0,0,0,,｟Жүрекке толы салқын түн
Dialogue: 0,0:28:06.09,0:28:13.06,Default,,0,0,0,,Бұл сиқыршы Бефананың сыйы.
Dialogue: 0,0:28:15.10,0:28:17.07,Default,,0,0,0,,｟Ах...｠
Dialogue: 0,0:28:22.11,0:28:25.07,Default,,0,0,0,,｟Уау… аа｠
Dialogue: 0,0:28:26.11,0:28:28.11,Default,,0,0,0,,(Айка)
Dialogue: 0,0:28:26.11,0:28:28.11,Default,,0,0,0,,｟Ханшайым, ішіңізші｠
Dialogue: 0,0:28:28.11,0:28:31.08,Default,,0,0,0,,(Акари)
Dialogue: 0,0:28:28.11,0:28:31.08,Default,,0,0,0,,｟Тәттілер де көп｠
Dialogue: 0,0:28:34.05,0:28:37.05,Default,,0,0,0,,｟Ха…｠
Dialogue: 0,0:28:34.05,0:28:37.05,Default,,0,0,0,,｟Айка-чан, әлі ерте｠
Dialogue: 0,0:28:37.05,0:28:42.02,Default,,0,0,0,,｟Не?｠
Dialogue: 0,0:28:37.05,0:28:42.02,Default,,0,0,0,,｟Е, уау...｠
Dialogue: 0,0:28:47.06,0:28:52.07,Default,,0,0,0,,｟Афина-сенпай бүгін.
Dialogue: 0,0:28:47.06,0:28:52.07,Default,,0,0,0,,Сізге көп рахмет｠
Dialogue: 0,0:28:52.07,0:28:54.07,Default,,0,0,0,,｟Кешіріңіз｠
Dialogue: 0,0:28:54.07,0:28:58.07,Default,,0,0,0,,｟Егде жастағы адамдарға да
Dialogue: 0,0:28:54.07,0:28:58.07,Default,,0,0,0,,Мен саған қиындық тудырдым｠
Dialogue: 0,0:28:58.07,0:29:02.08,Default,,0,0,0,,｟Келесі күні I
Dialogue: 0,0:28:58.07,0:29:02.08,Default,,0,0,0,,Ол сабын жерінің ханшайымы➡
Dialogue: 0,0:29:02.08,0:29:05.08,Default,,0,0,0,,Мүмкін емес тапсырма
Dialogue: 0,0:29:02.08,0:29:05.08,Default,,0,0,0,,Себебі мен айттым...｠
Dialogue: 0,0:29:05.08,0:29:07.08,Default,,0,0,0,,｟Хехе｠
Dialogue: 0,0:29:07.08,0:29:09.09,Default,,0,0,0,,｟Сәлем, Элис-чан｠
Dialogue: 0,0:29:09.09,0:29:15.09,Default,,0,0,0,,｟Мүмкін ересек болу
Dialogue: 0,0:29:09.09,0:29:15.09,Default,,0,0,0,,Бұл қызықсыз деп ойлайсыз ба? ｠
Dialogue: 0,0:29:15.09,0:29:17.09,Default,,0,0,0,,｟Бұл өте
Dialogue: 0,0:29:15.09,0:29:17.09,Default,,0,0,0,,Бұл ысырап｠
Dialogue: 0,0:29:17.09,0:29:19.10,Default,,0,0,0,,｟Иә? ｠
Dialogue: 0,0:29:19.10,0:29:21.10,Default,,0,0,0,,｟Әрине бала кезімде➡
Dialogue: 0,0:29:21.10,0:29:25.10,Default,,0,0,0,,Қызық екінші жақтан басталады
Dialogue: 0,0:29:21.10,0:29:25.10,Default,,0,0,0,,Олар көбірек келеді.
Dialogue: 0,0:29:25.10,0:29:28.10,Default,,0,0,0,,｟Бірақ әрқашан
Dialogue: 0,0:29:25.10,0:29:28.10,Default,,0,0,0,,Өте көп｠
Dialogue: 0,0:29:28.10,0:29:30.11,Default,,0,0,0,,｟Көп көп пе? ｠
Dialogue: 0,0:29:30.11,0:29:34.11,Default,,0,0,0,,｟Иә, көп, көп
Dialogue: 0,0:29:30.11,0:29:34.11,Default,,0,0,0,,Нөлдік маржа｠
Dialogue: 0,0:29:34.11,0:29:38.11,Default,,0,0,0,,｟Бірақ ересек болған кезде
Dialogue: 0,0:29:34.11,0:29:38.11,Default,,0,0,0,,Бала кезімде көре алмайтынмын➡
Dialogue: 0,0:29:38.11,0:29:41.12,Default,,0,0,0,,Керемет әлемді түсініңіз｠
Dialogue: 0,0:29:41.12,0:29:47.12,Default,,0,0,0,,｟Бір ғана жүрекпен бостандық
Dialogue: 0,0:29:41.12,0:29:47.12,Default,,0,0,0,,Сіз оны қалауыңызша пайдалана аласыз.
Dialogue: 0,0:29:47.12,0:29:51.13,Default,,0,0,0,,｜Еркін түрлендіруге болады｠
Dialogue: 0,0:29:51.13,0:29:53.13,Default,,0,0,0,,｟Бұл сиқыр сияқты｠
Dialogue: 0,0:29:53.13,0:29:55.13,Default,,0,0,0,,｟Hehehehe｠
Dialogue: 0,0:29:55.13,0:29:58.13,Default,,0,0,0,,｟Иә, егер сіз керемет ересек адам болсаңыз➡
Dialogue: 0,0:29:58.13,0:30:02.10,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:29:58.13,0:30:02.10,Default,,0,0,0,,Бұл енді жай ғана күту емес.
Dialogue: 0,0:30:03.14,0:30:06.14,Default,,0,0,0,,｟Сиқырды қолданыңыз
Dialogue: 0,0:30:03.14,0:30:06.14,Default,,0,0,0,,Тіпті сиқыршы Бефананың өзіне➡
Dialogue: 0,0:30:06.14,0:30:09.15,Default,,0,0,0,,Мен үйреніп бара жатырмын! ｠
Dialogue: 0,0:30:09.15,0:30:12.15,Default,,0,0,0,,｟Мынау, мынау~｠
Dialogue: 0,0:30:09.15,0:30:12.15,Default,,0,0,0,,｟Хахаха｠
Dialogue: 0,0:30:12.15,0:30:14.12,Default,,0,0,0,,｟Ах...｠
Dialogue: 0,0:30:15.15,0:30:17.15,Default,,0,0,0,,｟Бұл➡
Dialogue: 0,0:30:17.15,0:30:21.16,Default,,0,0,0,,Huge
Dialogue: 0,0:30:17.15,0:30:21.16,Default,,0,0,0,,Мен қатты толқып тұрмын｠
Dialogue: 0,0:30:21.16,0:30:23.13,Default,,0,0,0,,｟Hehehehe｠
Dialogue: 0,0:30:25.16,0:30:28.16,Default,,0,0,0,,Афина-сенпай маған арналған➡
Dialogue: 0,0:30:28.16,0:30:32.13,Default,,0,0,0,,Мәңгі және мәңгі
Dialogue: 0,0:30:28.16,0:30:32.13,Default,,0,0,0,,Мен сиқыршы Бефанамын.
Dialogue: 0,0:30:37.11,0:30:39.11,Default,,0,0,0,,Афина-сенпайға рахмет➡
Dialogue: 0,0:30:39.11,0:30:44.11,Default,,0,0,0,,Мен өзім туралы аздап білгім келеді.
Dialogue: 0,0:30:39.11,0:30:44.11,Default,,0,0,0,,Мен саған ғашық болатындай сезіндім.
Dialogue: 0,0:30:44.11,0:30:48.08,Default,,0,0,0,,Бірақ осылай
Dialogue: 0,0:30:44.11,0:30:48.08,Default,,0,0,0,,Прима болған кезде бұл мүлде...
Dialogue: 0,0:30:54.12,0:31:14.14,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:31:14.14,0:31:17.11,Default,,0,0,0,,Мен шақыру алған жоқпын!
Dialogue: 0,0:31:20.15,0:31:22.15,Default,,0,0,0,,♪
Dialogue: 0,0:31:22.15,0:31:24.12,Default,,0,0,0,,Эй...
Dialogue: 0,0:31:25.15,0:31:27.16,Default,,0,0,0,,Эй!
Dialogue: 0,0:31:25.15,0:31:27.16,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:31:27.16,0:31:31.16,Default,,0,0,0,,Акацуки-сан, сен тағы да шоппинг жасайсың ба?
Dialogue: 0,0:31:31.16,0:31:34.10,Default,,0,0,0,,Ах, Реденторе.
Dialogue: 0,0:31:31.16,0:31:34.10,Default,,0,0,0,,Фестивальге келдің бе?
Dialogue: 0,0:31:34.10,0:31:38.10,Default,,0,0,0,,Жоқ, не?
Dialogue: 0,0:31:34.10,0:31:38.10,Default,,0,0,0,,Иә жоқ па?
Dialogue: 0,0:31:38.10,0:31:41.10,Default,,0,0,0,,Егер бұл Ай Чан болса
Dialogue: 0,0:31:38.10,0:31:41.10,Default,,0,0,0,,Aika's Garden кафесі➡
Dialogue: 0,0:31:41.10,0:31:43.11,Default,,0,0,0,,Мен көмектесуге келдім.
Dialogue: 0,0:31:43.11,0:31:46.11,Default,,0,0,0,,Мұны істеу
Dialogue: 0,0:31:43.11,0:31:46.11,Default,,0,0,0,,Біз оны уақытында орындаймыз ба?
Dialogue: 0,0:31:46.11,0:31:48.11,Default,,0,0,0,,Сіз уақытындасыз ба?
Dialogue: 0,0:31:48.11,0:31:52.11,Default,,0,0,0,,Бұл үй қайығы!
Dialogue: 0,0:31:48.11,0:31:52.11,Default,,0,0,0,,Мен әлі шақыру алған жоқпын ба?
Dialogue: 0,0:31:52.11,0:31:56.12,Default,,0,0,0,,Әй, бұл қайық па?
Dialogue: 0,0:31:52.11,0:31:56.12,Default,,0,0,0,,О
Dialogue: 0,0:31:56.12,0:31:59.12,Default,,0,0,0,,Мен оны асыға күткен жоқпын.
Dialogue: 0,0:31:56.12,0:31:59.12,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:31:59.12,0:32:02.12,Default,,0,0,0,,Бұл жойылды.
Dialogue: 0,0:31:59.12,0:32:02.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:02.12,0:32:05.13,Default,,0,0,0,,Не... сонда...
Dialogue: 0,0:32:05.13,0:32:08.13,Default,,0,0,0,,Барлығы бос емес сияқты.
Dialogue: 0,0:32:08.13,0:32:10.13,Default,,0,0,0,,Тоқтату
Dialogue: 0,0:32:08.13,0:32:10.13,Default,,0,0,0,,Авава…
Dialogue: 0,0:32:10.13,0:32:14.14,Default,,0,0,0,,Менің біраз уақытым бар.
Dialogue: 0,0:32:10.13,0:32:14.14,Default,,0,0,0,,Шай ішкіңіз келе ме?
Dialogue: 0,0:32:14.14,0:32:17.14,Default,,0,0,0,,Хмм!
Dialogue: 0,0:32:17.14,0:32:20.14,Default,,0,0,0,,Жаңа кілегей қосылған какаоға тапсырыс беріңіз!
Dialogue: 0,0:32:17.14,0:32:20.14,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:32:20.14,0:32:22.14,Default,,0,0,0,,Ходжича жақсы ма?
Dialogue: 0,0:32:22.14,0:32:24.15,Default,,0,0,0,,Хмм
Dialogue: 0,0:32:24.15,0:32:27.15,Default,,0,0,0,,Раушан шайы бар
Dialogue: 0,0:32:24.15,0:32:27.15,Default,,0,0,0,,Бұл асқабақ торты.
Dialogue: 0,0:32:27.15,0:32:29.15,Default,,0,0,0,,Ах! ол
Dialogue: 0,0:32:27.15,0:32:29.15,Default,,0,0,0,,2-кесте 2-кесте
Dialogue: 0,0:32:29.15,0:32:33.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:29.15,0:32:33.09,Default,,0,0,0,,Резервтері бар тұтынушылар енді қол жетімді.
Dialogue: 0,0:32:33.09,0:32:36.06,Default,,0,0,0,,Пуи Пуи Чар
Dialogue: 0,0:32:33.09,0:32:36.06,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:32:37.09,0:32:39.06,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:32:40.10,0:32:44.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:40.10,0:32:44.10,Default,,0,0,0,,Максималды кернеу!
Dialogue: 0,0:32:44.10,0:32:46.10,Default,,0,0,0,,Фу…
Dialogue: 0,0:32:44.10,0:32:46.10,Default,,0,0,0,,Пуйча
Dialogue: 0,0:32:46.10,0:32:48.10,Default,,0,0,0,,Рахмет, Президент Ария.
Dialogue: 0,0:32:48.10,0:32:51.11,Default,,0,0,0,,Шынында да, мысықтың табандары бар.
Dialogue: 0,0:32:48.10,0:32:51.11,Default,,0,0,0,,Мен оны қарызға алғым келді.
Dialogue: 0,0:32:51.11,0:32:53.11,Default,,0,0,0,,Пуи Пуи Ча
Dialogue: 0,0:32:51.11,0:32:53.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:53.11,0:32:56.08,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:32:53.11,0:32:56.08,Default,,0,0,0,,Пуи
Dialogue: 0,0:33:02.12,0:33:06.12,Default,,0,0,0,,Бүгін де Афинаның концерті
Dialogue: 0,0:33:02.12,0:33:06.12,Default,,0,0,0,,Толған сияқты.
Dialogue: 0,0:33:06.12,0:33:09.13,Default,,0,0,0,,Иә, әсіресе бүгін соңғы күн болғандықтан➡
Dialogue: 0,0:33:09.13,0:33:11.13,Default,,0,0,0,,Бұл тек күндізгі қойылым.
Dialogue: 0,0:33:11.13,0:33:14.13,Default,,0,0,0,,Мен кеше бардым.
Dialogue: 0,0:33:11.13,0:33:14.13,Default,,0,0,0,,Бұл шынымен де керемет болды!
Dialogue: 0,0:33:14.13,0:33:16.13,Default,,0,0,0,,Алиса кетті ме?
Dialogue: 0,0:33:16.13,0:33:19.14,Default,,0,0,0,,Е, а, жоқ...
Dialogue: 0,0:33:19.14,0:33:24.11,Default,,0,0,0,,(әйел)
Dialogue: 0,0:33:19.14,0:33:24.11,Default,,0,0,0,,Түсіндім, бос емессің.
Dialogue: 0,0:33:34.08,0:33:36.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:42.09,0:33:44.06,Default,,0,0,0,,Иә
Dialogue: 0,0:33:52.10,0:33:55.10,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:33:52.10,0:33:55.10,Default,,0,0,0,,Рахмет
Dialogue: 0,0:33:55.10,0:33:57.11,Default,,0,0,0,,Сізге де рахмет, мысық.
Dialogue: 0,0:33:57.11,0:33:59.11,Default,,0,0,0,,Пуи Пуи!
Dialogue: 0,0:33:59.11,0:34:04.11,Default,,0,0,0,,Пуйю Пуйча!
Dialogue: 0,0:33:59.11,0:34:04.11,Default,,0,0,0,,Пуйю... Пуича!
Dialogue: 0,0:34:04.11,0:34:08.12,Default,,0,0,0,,Pupupu…
Dialogue: 0,0:34:04.11,0:34:08.12,Default,,0,0,0,,Хехехе, отшашу қызық
Dialogue: 0,0:34:08.12,0:34:12.12,Default,,0,0,0,,Ааа, басталып жатыр, кеттік.
Dialogue: 0,0:34:08.12,0:34:12.12,Default,,0,0,0,,Иә
Dialogue: 0,0:34:12.12,0:34:14.09,Default,,0,0,0,,Рахмет
Dialogue: 0,0:34:20.13,0:34:22.13,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:34:22.13,0:34:27.14,Default,,0,0,0,,Сіздің арқаңызда бұл үлкен жетістік болды.
Dialogue: 0,0:34:22.13,0:34:27.14,Default,,0,0,0,,Әркім, емін-еркін тамақтанып, жеп жүр.
Dialogue: 0,0:34:27.14,0:34:29.14,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:34:29.14,0:34:34.08,Default,,0,0,0,,Баршаңызға жақсы жұмыс
Dialogue: 0,0:34:29.14,0:34:34.08,Default,,0,0,0,,О, Акари, жақсы жұмыс.
Dialogue: 0,0:34:34.08,0:34:36.08,Default,,0,0,0,,Пуи Пуи Пуи Чар
Dialogue: 0,0:34:34.08,0:34:36.08,Default,,0,0,0,,Мияу
Dialogue: 0,0:34:36.08,0:34:39.08,Default,,0,0,0,,Пуи! Пуи…
Dialogue: 0,0:34:36.08,0:34:39.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:39.08,0:34:42.08,Default,,0,0,0,,Еңбегіңізге рахмет, Акари-сан.
Dialogue: 0,0:34:42.08,0:34:46.09,Default,,0,0,0,,Осы уақытта
Dialogue: 0,0:34:42.08,0:34:46.09,Default,,0,0,0,,Бұл жерде тыныш.
Dialogue: 0,0:34:46.09,0:34:49.09,Default,,0,0,0,,Барлығы отшашуға қарай
Dialogue: 0,0:34:46.09,0:34:49.09,Default,,0,0,0,,Мен кетемін.
Dialogue: 0,0:34:49.09,0:34:53.10,Default,,0,0,0,,Дүкен де жабық.
Dialogue: 0,0:34:49.09,0:34:53.10,Default,,0,0,0,,Эй, сен де жеу керек.
Dialogue: 0,0:34:53.10,0:34:57.10,Default,,0,0,0,,Иә...
Dialogue: 0,0:34:53.10,0:34:57.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:57.10,0:35:00.10,Default,,0,0,0,,Алиса ше?
Dialogue: 0,0:34:57.10,0:35:00.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:00.10,0:35:04.11,Default,,0,0,0,,Мен осындамын.
Dialogue: 0,0:35:00.10,0:35:04.11,Default,,0,0,0,,Мен сізге айттым
Dialogue: 0,0:35:04.11,0:35:07.11,Default,,0,0,0,,Егер Афина және
Dialogue: 0,0:35:04.11,0:35:07.11,Default,,0,0,0,,Алиса келгенде➡
Dialogue: 0,0:35:07.11,0:35:09.11,Default,,0,0,0,,Бұл әдемі «миракуру», солай емес пе?
Dialogue: 0,0:35:09.11,0:35:11.11,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:35:09.11,0:35:11.11,Default,,0,0,0,,(отшашудың дыбысы)
Dialogue: 0,0:35:11.11,0:35:16.09,Default,,0,0,0,,Ах... отшашу басталды.
Dialogue: 0,0:35:19.12,0:35:23.13,Default,,0,0,0,,Егер бұл отшашуды көруге болатын жер болса
Dialogue: 0,0:35:19.12,0:35:23.13,Default,,0,0,0,,Мен тағы біраз ақша таба алар едім.
Dialogue: 0,0:35:23.13,0:35:27.13,Default,,0,0,0,,Иә...
Dialogue: 0,0:35:23.13,0:35:27.13,Default,,0,0,0,,Сіз әлі де жеткіліксіз жұмыс жасайсыз ба?
Dialogue: 0,0:35:27.13,0:35:29.13,Default,,0,0,0,,Айка-сан, сен тым күштісің.
Dialogue: 0,0:35:29.13,0:35:32.13,Default,,0,0,0,,Енді жын!
Dialogue: 0,0:35:29.13,0:35:32.13,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:35:32.13,0:35:35.07,Default,,0,0,0,,Акираның шайтандығымен салыстырғанда
Dialogue: 0,0:35:32.13,0:35:35.07,Default,,0,0,0,,Мен періштеммін!
Dialogue: 0,0:35:35.07,0:35:38.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:35.07,0:35:38.07,Default,,0,0,0,,Гарт!
Dialogue: 0,0:35:38.07,0:35:40.08,Default,,0,0,0,,Ах... Акира-сан
Dialogue: 0,0:35:40.08,0:35:43.08,Default,,0,0,0,,Жын деген кім?
Dialogue: 0,0:35:43.08,0:35:45.08,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:35:45.08,0:35:48.08,Default,,0,0,0,,Алисия да
Dialogue: 0,0:35:45.08,0:35:48.08,Default,,0,0,0,,Сіз өз ісіңізді аяқтадыңыз ба?
Dialogue: 0,0:35:48.08,0:35:52.09,Default,,0,0,0,,Иә, мен бос емеспін.
Dialogue: 0,0:35:48.08,0:35:52.09,Default,,0,0,0,,Отшашу басталғанша
Dialogue: 0,0:35:52.09,0:35:55.09,Default,,0,0,0,,Одан да тамаша мерейтой
Dialogue: 0,0:35:52.09,0:35:55.09,Default,,0,0,0,,Оны таптыңыз ба?
Dialogue: 0,0:35:55.09,0:35:58.09,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:35:55.09,0:35:58.09,Default,,0,0,0,,Аа, бәрі біледі ме?
Dialogue: 0,0:35:58.09,0:36:01.10,Default,,0,0,0,,Қызық, бұл тосын сый ма?
Dialogue: 0,0:36:01.10,0:36:04.10,Default,,0,0,0,,Аа... мүлде.
Dialogue: 0,0:36:04.10,0:36:08.10,Default,,0,0,0,,Сол жасөспірімдерге
Dialogue: 0,0:36:04.10,0:36:08.10,Default,,0,0,0,,Мен сені соншалықты алаңдатамын деп ойламаппын.
Dialogue: 0,0:36:08.10,0:36:12.11,Default,,0,0,0,,Бұл екі адамды шынымен де жалғыз қалдыруға болмайды.
Dialogue: 0,0:36:12.11,0:36:14.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:17.11,0:36:20.12,Default,,0,0,0,,Ол әрқашан ебедейсіз болды.
Dialogue: 0,0:36:20.12,0:36:25.12,Default,,0,0,0,,Иә және өте тура.
Dialogue: 0,0:36:25.12,0:36:30.13,Default,,0,0,0,,Сол кезде де
Dialogue: 0,0:36:25.12,0:36:30.13,Default,,0,0,0,,Есіңде ме? Алисия
Dialogue: 0,0:36:30.13,0:36:32.09,Default,,0,0,0,,Иә
Dialogue: 0,0:36:38.07,0:36:41.07,Default,,0,0,0,,⚟(Әйел)
Dialogue: 0,0:36:38.07,0:36:41.07,Default,,0,0,0,,｟Әй, тыңдаңызшы.
Dialogue: 0,0:36:38.07,0:36:41.07,Default,,0,0,0,,Кемеңгер қыз туралы
Dialogue: 0,0:36:41.07,0:36:43.04,Default,,0,0,0,,Иә? ｠
Dialogue: 0,0:36:45.07,0:36:49.08,Default,,0,0,0,,｟Қатты ұялшақтық
Dialogue: 0,0:36:45.07,0:36:49.08,Default,,0,0,0,,Қарым-қатынаста біраз қиындықтар бар сияқты｠
Dialogue: 0,0:36:49.08,0:36:54.05,Default,,0,0,0,,｟Undine қонақжайлылық индустриясында болса да
Dialogue: 0,0:36:49.08,0:36:54.05,Default,,0,0,0,,Мен бұл дұрыс па деп ойлаймын｠
Dialogue: 0,0:36:55.08,0:36:57.09,Default,,0,0,0,,｟Кернеу
Dialogue: 0,0:36:55.08,0:36:57.09,Default,,0,0,0,,Мен бұл жалғасады ма деп ойлаймын｠
Dialogue: 0,0:36:57.09,0:37:01.09,Default,,0,0,0,,｟Менің айналамдағы адамдардың бәрі жасы үлкен.｠
Dialogue: 0,0:37:01.09,0:37:05.09,Default,,0,0,0,,｟Бірақ данышпан... Мен қызғанамын｠
Dialogue: 0,0:37:05.09,0:37:10.07,Default,,0,0,0,,｟Аяғыңызды басудың қажеті жоқ екеніне сенімдімін
Dialogue: 0,0:37:05.09,0:37:10.07,Default,,0,0,0,,Менің ойымша, бұл Прима｠
Dialogue: 0,0:37:11.10,0:37:13.10,Default,,0,0,0,,｟n…｠
Dialogue: 0,0:37:13.10,0:37:23.11,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:37:23.11,0:37:25.08,Default,,0,0,0,,｟Ах...｠
Dialogue: 0,0:37:29.12,0:37:32.12,Default,,0,0,0,,｟Алис-чан, ғажап, таңқаларлық｠
Dialogue: 0,0:37:32.12,0:37:35.06,Default,,0,0,0,,｟Тоқтаңыз! ｠
Dialogue: 0,0:37:32.12,0:37:35.06,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:37:35.06,0:37:38.06,Default,,0,0,0,,｟Үш ірі су перісінің ағасы➡
Dialogue: 0,0:37:38.06,0:37:41.06,Default,,0,0,0,,Мен не сезінемін?
Dialogue: 0,0:37:38.06,0:37:41.06,Default,,0,0,0,,Түсіну қиын.
Dialogue: 0,0:37:41.06,0:37:43.07,Default,,0,0,0,,｟Иә? ｠
Dialogue: 0,0:37:43.07,0:37:47.07,Default,,0,0,0,,｟Мені қазір қанағаттандыратын нәрсе
Dialogue: 0,0:37:43.07,0:37:47.07,Default,,0,0,0,,Иә.
Dialogue: 0,0:37:43.07,0:37:47.07,Default,,0,0,0,,Бұл тек рульді басқару дағдылары｠
Dialogue: 0,0:37:47.07,0:37:50.07,Default,,0,0,0,,｟Тұтынушыға қызмет көрсету үшін қажетті сөйлеу дағдылары
Dialogue: 0,0:37:47.07,0:37:50.07,Default,,0,0,0,,Canzone да➡
Dialogue: 0,0:37:50.07,0:37:53.08,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:37:53.08,0:37:57.08,Default,,0,0,0,,｟Сондықтан үлкендер де
Dialogue: 0,0:37:53.08,0:37:57.08,Default,,0,0,0,,Менен ештеңе күтпе｠
Dialogue: 0,0:37:57.08,0:38:00.08,Default,,0,0,0,,｟Әрине солай
Dialogue: 0,0:37:57.08,0:38:00.08,Default,,0,0,0,,Ол деформацияланған бала еді➡
Dialogue: 0,0:38:00.08,0:38:02.05,Default,,0,0,0,,Себебі көңіліңіз қалады...｠
Dialogue: 0,0:38:04.09,0:38:08.09,Default,,0,0,0,,｜Мен түсіндім｠
Dialogue: 0,0:38:04.09,0:38:08.09,Default,,0,0,0,,｟Иә? ｠
Dialogue: 0,0:38:08.09,0:38:10.09,Default,,0,0,0,,｟Бұл қорқынышты｠
Dialogue: 0,0:38:10.09,0:38:15.10,Default,,0,0,0,,｟Алис-чан
Dialogue: 0,0:38:10.09,0:38:15.10,Default,,0,0,0,,Негізі мен де ән айтамын.
Dialogue: 0,0:38:15.10,0:38:17.10,Default,,0,0,0,,｟Сіз баланы бұрмаладыңыз｠
Dialogue: 0,0:38:17.10,0:38:20.07,Default,,0,0,0,,｟Сондықтан мен оны өте жақсы түсінемін｠
Dialogue: 0,0:38:26.11,0:38:30.08,Default,,0,0,0,,｟Біз бір жерде
Dialogue: 0,0:38:26.11,0:38:30.08,Default,,0,0,0,,Мүмкін олар ұқсас болуы мүмкін｠
Dialogue: 0,0:38:32.11,0:38:37.05,Default,,0,0,0,,｟ Дұрыс па? Ақырын жүрейік
Dialogue: 0,0:38:32.11,0:38:37.05,Default,,0,0,0,,Алиса-чан
Dialogue: 0,0:38:37.05,0:38:41.06,Default,,0,0,0,,♪｟Екі адам ұқсас｠
Dialogue: 0,0:38:41.06,0:38:45.06,Default,,0,0,0,,♪｟Мабудачи өте жақсы｠
Dialogue: 0,0:38:45.06,0:38:49.06,Default,,0,0,0,,♪｟Екі бұрмаланған адам｠
Dialogue: 0,0:38:45.06,0:38:49.06,Default,,0,0,0,,｟Не? Бұл не? ? ｠
Dialogue: 0,0:38:49.06,0:38:51.07,Default,,0,0,0,,♪｟Бұл сізге сәйкес келеді｠
Dialogue: 0,0:38:51.07,0:38:54.07,Default,,0,0,0,,｟Ха, менің көңілім қалды.
Dialogue: 0,0:38:54.07,0:38:56.04,Default,,0,0,0,,｟О...｠
Dialogue: 0,0:38:57.07,0:39:03.08,Default,,0,0,0,,《Егер сен біреудің көңілін қалдырсаң
Dialogue: 0,0:38:57.07,0:39:03.08,Default,,0,0,0,,Менің де көңілім қалды.
Dialogue: 0,0:39:03.08,0:39:08.08,Default,,0,0,0,,《Басқалардан бастап
Dialogue: 0,0:39:03.08,0:39:08.08,Default,,0,0,0,,Бұрынырақ болса жақсы➡
Dialogue: 0,0:39:08.08,0:39:11.09,Default,,0,0,0,,Асығудың қажеті жоқ》
Dialogue: 0,0:39:11.09,0:39:16.09,Default,,0,0,0,,《Ақырын және жайбарақат
Dialogue: 0,0:39:11.09,0:39:16.09,Default,,0,0,0,,Алисаның әрбір қадамы➡
Dialogue: 0,0:39:16.09,0:39:20.10,Default,,0,0,0,,Осы қалада жұмсалған асыл қазыналар》
Dialogue: 0,0:39:20.10,0:39:24.10,Default,,0,0,0,,《Әр аяқ ізі
Dialogue: 0,0:39:20.10,0:39:24.10,Default,,0,0,0,,Әуен тоқу》
Dialogue: 0,0:39:24.10,0:39:26.10,Default,,0,0,0,,《Ән Құдайы》
Dialogue: 0,0:39:26.10,0:39:31.11,Default,,0,0,0,,《Өтінемін, Алиса Чан артта қалды
Dialogue: 0,0:39:26.10,0:39:31.11,Default,,0,0,0,,Траектория – әуен ➡
Dialogue: 0,0:39:31.11,0:39:36.08,Default,,0,0,0,,Керемет симфония
Dialogue: 0,0:39:31.11,0:39:36.08,Default,,0,0,0,,Бұл резонанс тудыруы мүмкін》
Dialogue: 0,0:39:39.11,0:39:42.08,Default,,0,0,0,,Ол шынымен ебедейсіз.
Dialogue: 0,0:39:43.12,0:39:48.12,Default,,0,0,0,,Бір-бірімізді ойлаған сайын ебедейсіз боламыз.
Dialogue: 0,0:39:43.12,0:39:48.12,Default,,0,0,0,,Барлығы бірдей.
Dialogue: 0,0:39:48.12,0:39:51.13,Default,,0,0,0,,Мен ондай емеспін.
Dialogue: 0,0:39:48.12,0:39:51.13,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:39:51.13,0:39:54.13,Default,,0,0,0,,Акира-сан ебедейсіз топ, солай емес пе?
Dialogue: 0,0:39:54.13,0:39:57.13,Default,,0,0,0,,Мен сенің бұлай айтқаныңды қаламаймын!
Dialogue: 0,0:39:54.13,0:39:57.13,Default,,0,0,0,,Crybaby серенадасы!
Dialogue: 0,0:39:57.13,0:40:02.14,Default,,0,0,0,,Баланың жылайтын серенадалары жоқ!
Dialogue: 0,0:39:57.13,0:40:02.14,Default,,0,0,0,,О, жоқ хехехе
Dialogue: 0,0:40:02.14,0:40:04.14,Default,,0,0,0,,Ой, уақыт таяп қалды.
Dialogue: 0,0:40:04.14,0:40:08.14,Default,,0,0,0,,Ал, бәріміз кеттік.
Dialogue: 0,0:40:08.14,0:40:11.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:08.14,0:40:11.15,Default,,0,0,0,,Бару...
Dialogue: 0,0:40:11.15,0:40:15.15,Default,,0,0,0,,Қайда?
Dialogue: 0,0:40:11.15,0:40:15.15,Default,,0,0,0,,Хехе, шын мәнінде...
Dialogue: 0,0:40:15.15,0:40:17.15,Default,,0,0,0,,Хехе
Dialogue: 0,0:40:17.15,0:40:37.11,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:40:37.11,0:40:39.07,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:40:45.11,0:40:48.12,Default,,0,0,0,,Афина Сенпай
Dialogue: 0,0:40:45.11,0:40:48.12,Default,,0,0,0,,Ах
Dialogue: 0,0:40:48.12,0:40:51.12,Default,,0,0,0,,Алиса, сен келдің.
Dialogue: 0,0:40:51.12,0:40:56.12,Default,,0,0,0,,Алисиядан тікелей шақыру.
Dialogue: 0,0:40:51.12,0:40:56.12,Default,,0,0,0,,Мен оны алдым➡
Dialogue: 0,0:40:56.12,0:40:59.13,Default,,0,0,0,,Келмеуге шамам жетпейді.
Dialogue: 0,0:40:59.13,0:41:01.10,Default,,0,0,0,,Рахмет
Dialogue: 0,0:41:02.13,0:41:05.13,Default,,0,0,0,,дегеніміз не?
Dialogue: 0,0:41:05.13,0:41:08.14,Default,,0,0,0,,Алиса-чан
Dialogue: 0,0:41:05.13,0:41:08.14,Default,,0,0,0,,Мүмкін сіз ашуланбаған шығарсыз?
Dialogue: 0,0:41:08.14,0:41:13.14,Default,,0,0,0,,Ха, менің ашуымды келтіретін нәрсе болса да.
Dialogue: 0,0:41:08.14,0:41:13.14,Default,,0,0,0,,Сіз жасадыңыз ба?
Dialogue: 0,0:41:13.14,0:41:16.11,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:41:13.14,0:41:16.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:17.15,0:41:23.15,Default,,0,0,0,,Мен Алисамен сөйлесуім керек.
Dialogue: 0,0:41:17.15,0:41:23.15,Default,,0,0,0,,Сіз істеуге болмайтын нәрсе бар ма?
Dialogue: 0,0:41:23.15,0:41:28.16,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:41:28.16,0:41:33.10,Default,,0,0,0,,｟Prima-ға жылжытуды өткізіп жіберу｠
Dialogue: 0,0:41:33.10,0:41:36.10,Default,,0,0,0,,(Офицерлер)
Dialogue: 0,0:41:33.10,0:41:36.10,Default,,0,0,0,,｟Иә, күтеміз｠
Dialogue: 0,0:41:36.10,0:41:39.10,Default,,0,0,0,,｟Алис Кэрроллдікі
Dialogue: 0,0:41:36.10,0:41:39.10,Default,,0,0,0,,Сіз бітірген кезде｠
Dialogue: 0,0:41:39.10,0:41:43.07,Default,,0,0,0,,｜Емтиханның мазмұны толығымен сізге байланысты｠
Dialogue: 0,0:41:45.11,0:41:47.11,Default,,0,0,0,,｟Уау｠
Dialogue: 0,0:41:45.11,0:41:47.11,Default,,0,0,0,,｟Пуи? ｠
Dialogue: 0,0:41:47.11,0:41:49.11,Default,,0,0,0,,｟Ах...｠
Dialogue: 0,0:41:47.11,0:41:49.11,Default,,0,0,0,,｟Афина-чан? ｠
Dialogue: 0,0:41:49.11,0:41:52.11,Default,,0,0,0,,｟Не болды? ｠
Dialogue: 0,0:41:49.11,0:41:52.11,Default,,0,0,0,,｟мм…｠
Dialogue: 0,0:41:52.11,0:41:55.12,Default,,0,0,0,,｟Мен мүлде түсінбеймін｠
Dialogue: 0,0:41:55.12,0:41:58.12,Default,,0,0,0,,｜Жақында бітіреміз｠
Dialogue: 0,0:41:58.12,0:42:01.12,Default,,0,0,0,,｟Бітіру? Алиса ше? ｠
Dialogue: 0,0:42:01.12,0:42:05.09,Default,,0,0,0,,｟Түсінемін, бұл жылдам.｠
Dialogue: 0,0:42:06.13,0:42:08.13,Default,,0,0,0,,｟Пуи? ｠
Dialogue: 0,0:42:06.13,0:42:08.13,Default,,0,0,0,,Иә? ｠
Dialogue: 0,0:42:08.13,0:42:12.10,Default,,0,0,0,,《Иә, баяу жүрген дұрыс》
Dialogue: 0,0:42:14.14,0:42:20.11,Default,,0,0,0,,《Бірақ
Dialogue: 0,0:42:14.14,0:42:20.11,Default,,0,0,0,,Қойылымның ашылуына шымылдық ашылады.
Dialogue: 0,0:42:22.14,0:42:27.15,Default,,0,0,0,,｟Бүгін мен тапсырыс берушімін.
Dialogue: 0,0:42:22.14,0:42:27.15,Default,,0,0,0,,Элис Ундиннің рөлін сомдайды➡
Dialogue: 0,0:42:27.15,0:42:29.15,Default,,0,0,0,,Неге оны күні бойы көрмеске? ｠
Dialogue: 0,0:42:29.15,0:42:31.15,Default,,0,0,0,,｟Иә? ｠
Dialogue: 0,0:42:31.15,0:42:33.09,Default,,0,0,0,,｟Қызықты идея｠
Dialogue: 0,0:42:33.09,0:42:36.09,Default,,0,0,0,,｟Қабылдап, тұрайық｠
Dialogue: 0,0:42:36.09,0:42:41.10,Default,,0,0,0,,｟Сонымен Афина-сенпай?
Dialogue: 0,0:42:36.09,0:42:41.10,Default,,0,0,0,,Бұдан былай сен менің маңызды тұтынушымсың.
Dialogue: 0,0:42:41.10,0:42:43.07,Default,,0,0,0,,｟Иә, танысқаныма қуаныштымын｠
Dialogue: 0,0:42:46.10,0:42:50.11,Default,,0,0,0,,｟Тұтынушы, көмектесіңіз｠
Dialogue: 0,0:42:50.11,0:42:56.11,Default,,0,0,0,,《О, Құдай, ән Құдайы》
Dialogue: 0,0:42:56.11,0:43:00.12,Default,,0,0,0,,《Науқанды өткізіп жіберу
Dialogue: 0,0:42:56.11,0:43:00.12,Default,,0,0,0,,Сіз нені тым көп деп ойлайсыз?➡
Dialogue: 0,0:43:00.12,0:43:04.09,Default,,0,0,0,,Жалқаулығымнан ба?
Dialogue: 0,0:43:05.12,0:43:09.12,Default,,0,0,0,,《Ән Құдайы》
Dialogue: 0,0:43:09.12,0:43:12.13,Default,,0,0,0,,《Бұл орны толмас уақыт➡
Dialogue: 0,0:43:12.13,0:43:16.13,Default,,0,0,0,,Баяу жалғасады деп үміттенемін➡
Dialogue: 0,0:43:16.13,0:43:20.14,Default,,0,0,0,,Себебі мен бұрмаланғанмын
Бұл
Dialogue: 0,0:43:16.13,0:43:20.14,Default,,0,0,0,,ма? 》
Dialogue: 0,0:43:20.14,0:43:31.15,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:43:31.15,0:43:35.08,Default,,0,0,0,,｟Мен бастапқыда
Dialogue: 0,0:43:31.15,0:43:35.08,Default,,0,0,0,,Менің дауысым тыныш➡
Dialogue: 0,0:43:35.08,0:43:39.09,Default,,0,0,0,,Әндер де
Dialogue: 0,0:43:35.08,0:43:39.09,Default,,0,0,0,,Мен онша жақсы емеспін｠
Dialogue: 0,0:43:39.09,0:43:44.09,Default,,0,0,0,,｟Дауысыңыздың қаттылығы дұрыс шығып жатыр ма?
Dialogue: 0,0:43:39.09,0:43:44.09,Default,,0,0,0,,Сауатсыз екеніңізді тексеріңіз➡
Dialogue: 0,0:43:44.09,0:43:48.10,Default,,0,0,0,,Мен жақсы ән айтуым керек
Dialogue: 0,0:43:44.09,0:43:48.10,Default,,0,0,0,,Мен бұл туралы көбірек ойланамын➡
Dialogue: 0,0:43:48.10,0:43:51.10,Default,,0,0,0,,Менің басымда
Dialogue: 0,0:43:48.10,0:43:51.10,Default,,0,0,0,,Ол толығымен ақ болады｠
Dialogue: 0,0:43:51.10,0:43:54.10,Default,,0,0,0,,《Ән Құдайы》
Dialogue: 0,0:43:54.10,0:43:59.11,Default,,0,0,0,,《Адасқан кіші
Dialogue: 0,0:43:54.10,0:43:59.11,Default,,0,0,0,,Күмістің жарқырауына не әкеледі➡
Dialogue: 0,0:43:59.11,0:44:03.08,Default,,0,0,0,,Бұл жылы және жылы сөз болуы керек》
Dialogue: 0,0:44:04.11,0:44:09.12,Default,,0,0,0,,《Жүректі еңсеретін сөздер
Dialogue: 0,0:44:04.11,0:44:09.12,Default,,0,0,0,,Айтуға болмайды.
Dialogue: 0,0:44:09.12,0:44:14.12,Default,,0,0,0,,《Әсіресе маңызды емтиханның ортасында болсаңыз》
Dialogue: 0,0:44:14.12,0:44:19.13,Default,,0,0,0,,《Бірақ мен болсам да➡
Dialogue: 0,0:44:19.13,0:44:25.10,Default,,0,0,0,,Тек әннің бар алдында
Dialogue: 0,0:44:19.13,0:44:25.10,Default,,0,0,0,,Мен жүрегіме адал болғым келеді》
Dialogue: 0,0:44:27.14,0:44:29.14,Default,,0,0,0,,｟фу｠
Dialogue: 0,0:44:29.14,0:44:32.14,Default,,0,0,0,,｟Адамның өзі қиынға соғады.
Dialogue: 0,0:44:29.14,0:44:32.14,Default,,0,0,0,,Айтылатын ән –➡
Dialogue: 0,0:44:32.14,0:44:35.08,Default,,0,0,0,,Тыңдап отырғандарға
Dialogue: 0,0:44:32.14,0:44:35.08,Default,,0,0,0,,Оны айту қиын.
Dialogue: 0,0:44:35.08,0:44:39.08,Default,,0,0,0,,｟Ән айту техникасы
Dialogue: 0,0:44:35.08,0:44:39.08,Default,,0,0,0,,Әрине қажет➡
Dialogue: 0,0:44:39.08,0:44:45.05,Default,,0,0,0,,Ең бастысы - ән айту
Dialogue: 0,0:44:39.08,0:44:45.05,Default,,0,0,0,,Махаббат сезімі｠
Dialogue: 0,0:44:46.09,0:44:50.06,Default,,0,0,0,,｟Мен ән айтқанды жақсы көремін｠
Dialogue: 0,0:44:51.09,0:44:53.10,Default,,0,0,0,,｟Алис-чанның әні➡
Dialogue: 0,0:44:53.10,0:44:56.10,Default,,0,0,0,,Алисаның өзі
Dialogue: 0,0:44:53.10,0:44:56.10,Default,,0,0,0,,Мен саған ғашық болуым керек➡
Dialogue: 0,0:44:56.10,0:45:00.10,Default,,0,0,0,,Тағы кім?
Dialogue: 0,0:44:56.10,0:45:00.10,Default,,0,0,0,,Сен маған ғашық боламын дейсің бе? ｠
Dialogue: 0,0:45:00.10,0:45:04.11,Default,,0,0,0,,《Жарайды, сүрінсе де болады》
Dialogue: 0,0:45:04.11,0:45:08.11,Default,,0,0,0,,《Ақырын, баяу жақсы》
Dialogue: 0,0:45:08.11,0:45:14.08,Default,,0,0,0,,《Бұл біздің бұрмаланған
Dialogue: 0,0:45:08.11,0:45:14.08,Default,,0,0,0,,Бұл жүру жылдамдығы》
Dialogue: 0,0:45:17.12,0:45:22.12,Default,,0,0,0,,♪ (ән айту)
Dialogue: 0,0:45:22.12,0:45:42.08,Default,,0,0,0,,♪~
Dialogue: 0,0:45:42.08,0:45:53.09,Default,,0,0,0,,♪~
Dialogue: 0,0:45:53.09,0:45:57.09,Default,,0,0,0,,《О, Алиса Чан》
Dialogue: 0,0:45:57.09,0:46:03.10,Default,,0,0,0,,《Сондай күшті, бір қадамда
Dialogue: 0,0:45:57.09,0:46:03.10,Default,,0,0,0,,Мен оның сонша өскеніне сене алмаймын》
Dialogue: 0,0:46:03.10,0:46:06.07,Default,,0,0,0,,《Сіз шынымен жылдам жүгіресіз》
Dialogue: 0,0:46:07.10,0:46:11.11,Default,,0,0,0,,《Лақап атқа қатысты
Dialogue: 0,0:46:07.10,0:46:11.11,Default,,0,0,0,,Мифті білгеннен кейін➡
Dialogue: 0,0:46:11.11,0:46:14.11,Default,,0,0,0,,Жүрегімнің бір жерінде қорықтым》
Dialogue: 0,0:46:14.11,0:46:18.11,Default,,0,0,0,,《Егер менің әнім болса
Dialogue: 0,0:46:14.11,0:46:18.11,Default,,0,0,0,,Біреуді мұң теңізіне салыңыз➡
Dialogue: 0,0:46:18.11,0:46:21.12,Default,,0,0,0,,Мен оны батырып жібергенімді қалаймын.
Dialogue: 0,0:46:21.12,0:46:27.12,Default,,0,0,0,,《Бірақ қазір сен менің алдымда ән айтып тұрсың
Dialogue: 0,0:46:21.12,0:46:27.12,Default,,0,0,0,,Мына періштенің қанаты сынған➡
Dialogue: 0,0:46:27.12,0:46:32.09,Default,,0,0,0,,Ешқашан қараңғылыққа түспеу》
Dialogue: 0,0:46:36.06,0:46:43.07,Default,,0,0,0,,Сол кезде мен, Алиса Чан,
Dialogue: 0,0:46:36.06,0:46:43.07,Default,,0,0,0,,Емтиханнан сүрінгенім дұрыс деп ойладым.
Dialogue: 0,0:46:43.07,0:46:47.08,Default,,0,0,0,,Бұл әрқашан болған.
Dialogue: 0,0:46:43.07,0:46:47.08,Default,,0,0,0,,Жүрегімде қадалып қалды
Dialogue: 0,0:46:47.08,0:46:49.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:46:49.08,0:46:51.08,Default,,0,0,0,,Афина Сенпай
Dialogue: 0,0:46:51.08,0:46:54.08,Default,,0,0,0,,Кешірім сұрау қабылданбайды.
Dialogue: 0,0:46:54.08,0:46:58.09,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:46:54.08,0:46:58.09,Default,,0,0,0,,Ал...
Dialogue: 0,0:46:58.09,0:47:00.09,Default,,0,0,0,,Жақсы айттыңыз.
Dialogue: 0,0:47:00.09,0:47:04.09,Default,,0,0,0,,Ах
Dialogue: 0,0:47:00.09,0:47:04.09,Default,,0,0,0,,Сен қолыңнан келгеннің бәрін жасадың, Афина-чан.
Dialogue: 0,0:47:04.09,0:47:07.10,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:47:07.10,0:47:09.10,Default,,0,0,0,,Барлығы, бұл не?
Dialogue: 0,0:47:09.10,0:47:11.10,Default,,0,0,0,,Екеуің не істеп жатырсыңдар?
Dialogue: 0,0:47:09.10,0:47:11.10,Default,,0,0,0,,Бұл біртүрлі➡
Dialogue: 0,0:47:11.10,0:47:15.10,Default,,0,0,0,,Мен кенжем үшін алаңдаймын.
Dialogue: 0,0:47:11.10,0:47:15.10,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:47:15.10,0:47:17.11,Default,,0,0,0,,Міне, мен солай дедім...
Dialogue: 0,0:47:17.11,0:47:21.11,Default,,0,0,0,,Әй, хехехе
Егер сіз Афинадан
Dialogue: 0,0:47:17.11,0:47:21.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:21.11,0:47:23.11,Default,,0,0,0,,➡ сұрасаңыз
Dialogue: 0,0:47:23.11,0:47:26.11,Default,,0,0,0,,Мен шынымен кешірім сұрағым келеді
Dialogue: 0,0:47:23.11,0:47:26.11,Default,,0,0,0,,Олар ➡ бар дейді
Dialogue: 0,0:47:26.11,0:47:28.12,Default,,0,0,0,,Мен жай ғана киімімді шешіп алған сияқтымын.
Dialogue: 0,0:47:28.12,0:47:31.12,Default,,0,0,0,,Кем дегенде Алиса
Dialogue: 0,0:47:28.12,0:47:31.12,Default,,0,0,0,,Себебі мен сені кездестіре алмаймын
Dialogue: 0,0:47:31.12,0:47:33.05,Default,,0,0,0,,Сонымен шақыру...
Dialogue: 0,0:47:33.05,0:47:38.06,Default,,0,0,0,,Бастапқыда мен Алисаға қамқор болдым.
Dialogue: 0,0:47:33.05,0:47:38.06,Default,,0,0,0,,Себебі мен сені ашуландырдым.
Dialogue: 0,0:47:38.06,0:47:41.06,Default,,0,0,0,,Сен ашуланып, маған бармадың.
Dialogue: 0,0:47:38.06,0:47:41.06,Default,,0,0,0,,Өте танымал емес
Dialogue: 0,0:47:41.06,0:47:44.07,Default,,0,0,0,,Айка-чан
Dialogue: 0,0:47:41.06,0:47:44.07,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:47:44.07,0:47:47.07,Default,,0,0,0,,Мен Афина Сенпаймын
Dialogue: 0,0:47:44.07,0:47:47.07,Default,,0,0,0,,Мен сені көруге барған жоқпын➡
Dialogue: 0,0:47:47.07,0:47:50.07,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:47:50.07,0:47:52.07,Default,,0,0,0,,Аняныкі
Dialogue: 0,0:47:50.07,0:47:52.07,Default,,0,0,0,,Жақсы аға бола аласың ба➡
Dialogue: 0,0:47:52.07,0:47:55.08,Default,,0,0,0,,Менде сенім жоқ
Dialogue: 0,0:47:55.08,0:47:57.08,Default,,0,0,0,,Алиса?
Dialogue: 0,0:47:57.08,0:48:01.08,Default,,0,0,0,,Афина-сенпайды кездестіргенде
Dialogue: 0,0:47:57.08,0:48:01.08,Default,,0,0,0,,Оның сізге кеңес беретініне сенімдімін.
Dialogue: 0,0:48:01.08,0:48:06.09,Default,,0,0,0,,Бірақ содан кейін мәңгі
Dialogue: 0,0:48:01.08,0:48:06.09,Default,,0,0,0,,Мен өзімді толыққанды адам бола алмайтындай сезінемін.
Dialogue: 0,0:48:06.09,0:48:10.09,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:48:06.09,0:48:10.09,Default,,0,0,0,,Сонда сіз барлығын алаңдатыңыз ба?
Dialogue: 0,0:48:10.09,0:48:13.09,Default,,0,0,0,,Бала
Dialogue: 0,0:48:10.09,0:48:13.09,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:48:13.09,0:48:15.10,Default,,0,0,0,,Жауап беретін сөзім жоқ.
Dialogue: 0,0:48:15.10,0:48:19.10,Default,,0,0,0,,Сонымен, сол емтихан күні туралы...
Dialogue: 0,0:48:19.10,0:48:21.10,Default,,0,0,0,,Иә, Афина-сенпай➡
Dialogue: 0,0:48:21.10,0:48:24.11,Default,,0,0,0,,Сол кезде мен солай істедім.
Dialogue: 0,0:48:21.10,0:48:24.11,Default,,0,0,0,,Мен не ойладым➡
Dialogue: 0,0:48:24.11,0:48:27.11,Default,,0,0,0,,Мен оны мүлде байқамадым.
Dialogue: 0,0:48:27.11,0:48:31.11,Default,,0,0,0,,Олай болса, тағы да кешірім сұраймын.
Dialogue: 0,0:48:31.11,0:48:35.08,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:48:31.11,0:48:35.08,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:48:37.05,0:48:39.05,Default,,0,0,0,,Һм? Не болды?
Dialogue: 0,0:48:39.05,0:48:41.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:41.06,0:48:43.06,Default,,0,0,0,,Иә...
Dialogue: 0,0:48:43.06,0:48:46.06,Default,,0,0,0,,Олай болса, қатал кеңес
Dialogue: 0,0:48:43.06,0:48:46.06,Default,,0,0,0,,Егер сіз мұны жасамасаңыз➡
Dialogue: 0,0:48:46.06,0:48:50.07,Default,,0,0,0,,Һм? Не болды?
Dialogue: 0,0:48:46.06,0:48:50.07,Default,,0,0,0,,Иә?Бірақ...
Dialogue: 0,0:48:50.07,0:48:53.07,Default,,0,0,0,,Енді мен ризамын.
Dialogue: 0,0:48:53.07,0:48:57.07,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:48:53.07,0:48:57.07,Default,,0,0,0,,Мен ән айтуда жақсы емеспін, бірақ➡
Dialogue: 0,0:48:57.07,0:49:01.08,Default,,0,0,0,,Өз әндеріңізді жек көрмейсіз бе?
Dialogue: 0,0:48:57.07,0:49:01.08,Default,,0,0,0,,Өйткені ол жоғалып кетті
Dialogue: 0,0:49:01.08,0:49:05.08,Default,,0,0,0,,Афина-сенпай: «Мен тек ән айтамын»
Dialogue: 0,0:49:01.08,0:49:05.08,Default,,0,0,0,,Мен айтқанымдай➡
Dialogue: 0,0:49:05.08,0:49:10.05,Default,,0,0,0,,Афина-сенпай ән салғанда
Dialogue: 0,0:49:05.08,0:49:10.05,Default,,0,0,0,,Өте бақытты көрінеді
Dialogue: 0,0:49:11.09,0:49:15.09,Default,,0,0,0,,Мен жартылай қайықпен есіп жүрген кезім
Dialogue: 0,0:49:11.09,0:49:15.09,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:49:15.09,0:49:19.06,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:49:15.09,0:49:19.06,Default,,0,0,0,,Бұл ұқсас болуы мүмкін
Dialogue: 0,0:49:20.10,0:49:24.07,Default,,0,0,0,,Маған ән айтасың ба? Афина Сенпай
Dialogue: 0,0:49:30.11,0:49:35.11,Default,,0,0,0,,♪ (ән айту)
Dialogue: 0,0:49:35.11,0:49:45.12,Default,,0,0,0,,♪~
Dialogue: 0,0:49:45.12,0:49:48.12,Default,,0,0,0,,《Баяғыда болды➡
Dialogue: 0,0:49:48.12,0:49:53.13,Default,,0,0,0,,Ән айтып жүріп жүру
Dialogue: 0,0:49:48.12,0:49:53.13,Default,,0,0,0,,Мен Undines жұбын көрдім》
Dialogue: 0,0:49:53.13,0:49:58.13,Default,,0,0,0,,♪ (ән айту)
Dialogue: 0,0:49:58.13,0:50:00.14,Default,,0,0,0,,♪~
Dialogue: 0,0:50:00.14,0:50:03.14,Default,,0,0,0,,Ha
Dialogue: 0,0:50:00.14,0:50:03.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:03.14,0:50:08.14,Default,,0,0,0,,《Солай ма?
Dialogue: 0,0:50:03.14,0:50:08.14,Default,,0,0,0,,Сол кезде көргенім...》
Dialogue: 0,0:50:08.14,0:50:10.11,Default,,0,0,0,,《Бұл Афина》
Dialogue: 0,0:50:11.15,0:50:16.15,Default,,0,0,0,,《 Ұялшақтық
Dialogue: 0,0:50:11.15,0:50:16.15,Default,,0,0,0,,Көпшілік алдында жақсы ән айта алмайтын мен үшін➡
Dialogue: 0,0:50:16.15,0:50:21.16,Default,,0,0,0,,Оның сыртқы түрі өте еркін.
Dialogue: 0,0:50:16.15,0:50:21.16,Default,,0,0,0,,Жарқырап көрінді》
Dialogue: 0,0:50:21.16,0:50:26.16,Default,,0,0,0,,《Мен Undineмін
Dialogue: 0,0:50:21.16,0:50:26.16,Default,,0,0,0,,Аңсаған кезім еді
Dialogue: 0,0:50:26.16,0:50:36.10,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:50:36.10,0:50:39.11,Default,,0,0,0,,♪ (ән айту)
Dialogue: 0,0:50:39.11,0:50:44.11,Default,,0,0,0,,♪ (ән айтатын екі дауыс)
Dialogue: 0,0:50:44.11,0:50:53.12,Default,,0,0,0,,♪~
Dialogue: 0,0:50:53.12,0:50:58.09,Default,,0,0,0,,(Аня/Алис)
Dialogue: 0,0:50:53.12,0:50:58.09,Default,,0,0,0,,《Сол күн, бұл кездесу бастамасы болды》
Dialogue: 0,0:50:59.13,0:51:02.13,Default,,0,0,0,,《Соның арқасында мен
Dialogue: 0,0:50:59.13,0:51:02.13,Default,,0,0,0,,Гондоламен кездесу➡
Dialogue: 0,0:51:02.13,0:51:06.13,Default,,0,0,0,,Гондоламен жүру
Dialogue: 0,0:51:02.13,0:51:06.13,Default,,0,0,0,,Мен оған ғашық болдым》
Dialogue: 0,0:51:06.13,0:51:09.14,Default,,0,0,0,,《Егер Прима болса...》
Dialogue: 0,0:51:09.14,0:51:13.14,Default,,0,0,0,,《Жоқ, Undine болыңыз.
Dialogue: 0,0:51:09.14,0:51:13.14,Default,,0,0,0,,Ешкім болмаса да➡
Dialogue: 0,0:51:13.14,0:51:18.15,Default,,0,0,0,,Мен жаман әнші екеніме сенімдімін
Dialogue: 0,0:51:13.14,0:51:18.15,Default,,0,0,0,,ызылдаған кезде➡
Dialogue: 0,0:51:18.15,0:51:21.15,Default,,0,0,0,,Осы сүйікті су қаланың бір жерінде➡
Dialogue: 0,0:51:21.15,0:51:25.15,Default,,0,0,0,,Ол гондолада есуді жалғастыра берді.
Dialogue: 0,0:51:21.15,0:51:25.15,Default,,0,0,0,,Менің ойымша》
Dialogue: 0,0:51:25.15,0:51:41.10,Default,,0,0,0,,♪~
Dialogue: 0,0:51:41.10,0:51:45.07,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:51:41.10,0:51:45.07,Default,,0,0,0,,Пуйча!
Dialogue: 0,0:51:47.11,0:51:50.11,Default,,0,0,0,,Аня-чан, мен➡
Dialogue: 0,0:51:50.11,0:51:53.11,Default,,0,0,0,,Аня-чанға арналған
Dialogue: 0,0:51:50.11,0:51:53.11,Default,,0,0,0,,Мен жақсы аға болуым керек➡
Dialogue: 0,0:51:53.11,0:51:55.12,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:51:55.12,0:52:00.12,Default,,0,0,0,,Мен де жақсы кенже боламын.
Dialogue: 0,0:51:55.12,0:52:00.12,Default,,0,0,0,,Мен солай болуы керек деп ойладым
Dialogue: 0,0:52:00.12,0:52:04.13,Default,,0,0,0,,Бірақ бұл үшін маңыздысы
Dialogue: 0,0:52:00.12,0:52:04.13,Default,,0,0,0,,Өзіңізді мәжбүрлеме➡
Dialogue: 0,0:52:04.13,0:52:07.13,Default,,0,0,0,,Бұл өзіме адал болу туралы болды.
Dialogue: 0,0:52:07.13,0:52:09.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:52:09.13,0:52:14.14,Default,,0,0,0,,Сіз жақсы көретін адам үшін
Dialogue: 0,0:52:09.13,0:52:14.14,Default,,0,0,0,,Ең алдымен, өзіңіздің керемет болыңыз
Dialogue: 0,0:52:14.14,0:52:19.11,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:52:14.14,0:52:19.11,Default,,0,0,0,,Мен жақсы көретін адам үшін...
Dialogue: 0,0:52:23.14,0:52:28.15,Default,,0,0,0,,♪ (ән айтатын екі дауыс)
Dialogue: 0,0:52:28.15,0:52:48.10,Default,,0,0,0,,♪~
Dialogue: 0,0:52:48.10,0:53:01.12,Default,,0,0,0,,♪~
Dialogue: 0,0:53:01.12,0:53:03.12,Default,,0,0,0,,Бірге ән айту
Dialogue: 0,0:53:03.12,0:53:06.12,Default,,0,0,0,,Магистр мен студент, бұл арман ынтымақтастығы.
Dialogue: 0,0:53:06.12,0:53:11.13,Default,,0,0,0,,Бірақ екеуі де
Dialogue: 0,0:53:06.12,0:53:11.13,Default,,0,0,0,,Сенің күлкің қайта оралғанына қуаныштымын
Dialogue: 0,0:53:11.13,0:53:13.13,Default,,0,0,0,,Иә.
Dialogue: 0,0:53:13.13,0:53:33.08,Default,,0,0,0,,♪~
Dialogue: 0,0:53:33.08,0:53:53.10,Default,,0,0,0,,♪~
Dialogue: 0,0:53:53.10,0:54:06.11,Default,,0,0,0,,♪~
Dialogue: 0,0:54:06.11,0:54:11.12,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:54:11.12,0:54:18.13,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:54:18.13,0:54:20.13,Default,,0,0,0,,Хахаха
Dialogue: 0,0:54:20.13,0:54:37.08,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:54:37.08,0:54:39.08,Default,,0,0,0,,Барлығы жиналды
Dialogue: 0,0:54:39.08,0:54:42.08,Default,,0,0,0,,Ғажайып ғажайып.
Dialogue: 0,0:54:39.08,0:54:42.08,Default,,0,0,0,,Хехе
Dialogue: 0,0:54:42.08,0:54:47.09,Default,,0,0,0,,Аняның ойлары
Dialogue: 0,0:54:42.08,0:54:47.09,Default,,0,0,0,,Сіз бәрін ауыстырдыңыз, солай ма?
Dialogue: 0,0:54:47.09,0:54:49.09,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:54:49.09,0:54:51.09,Default,,0,0,0,,О, жарай берсін, абай бол.
Dialogue: 0,0:54:51.09,0:54:54.10,Default,,0,0,0,,Рахмет
Dialogue: 0,0:54:51.09,0:54:54.10,Default,,0,0,0,,Жоқ
Dialogue: 0,0:54:54.10,0:54:57.10,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:54:54.10,0:54:57.10,Default,,0,0,0,,Аа, тынышталыңыз.
Dialogue: 0,0:54:57.10,0:55:02.10,Default,,0,0,0,,Индиго гондоласына дейін
Dialogue: 0,0:54:57.10,0:55:02.10,Default,,0,0,0,,Мен оны мінгенде, өткенге оралғандай сезінемін.
Dialogue: 0,0:55:02.10,0:55:06.11,Default,,0,0,0,,Иә, сол күндер есімде.
Dialogue: 0,0:55:06.11,0:55:10.11,Default,,0,0,0,,Бірақ ол күндер жақсы болды...
Dialogue: 0,0:55:06.11,0:55:10.11,Default,,0,0,0,,➡ емес
Dialogue: 0,0:55:10.11,0:55:13.11,Default,,0,0,0,,Ол күндер де жақсы болды емес пе?
Dialogue: 0,0:55:13.11,0:55:18.12,Default,,0,0,0,,That's right.
Dialogue: 0,0:55:13.11,0:55:18.12,Default,,0,0,0,,Қазірдің өзінде бұл жаман емес.
Dialogue: 0,0:55:18.12,0:55:23.12,Default,,0,0,0,,Менің де сүйкімді кенже балам болды.
Dialogue: 0,0:55:18.12,0:55:23.12,Default,,0,0,0,,Менің керемет ағаларым бар.
Dialogue: 0,0:55:23.12,0:55:26.13,Default,,0,0,0,,Ертеңгі күн бүгінгіден жақсы болатынына сенімдімін
Dialogue: 0,0:55:23.12,0:55:26.13,Default,,0,0,0,,Өзіңіз үшін➡
Dialogue: 0,0:55:26.13,0:55:28.13,Default,,0,0,0,,Мен кездесе алатындай сезінемін
Dialogue: 0,0:55:28.13,0:55:30.13,Default,,0,0,0,,Иә Ұят сөздерге жол берілмейді!
Dialogue: 0,0:55:30.13,0:55:32.13,Default,,0,0,0,,Иә~
Dialogue: 0,0:55:32.13,0:55:36.07,Default,,0,0,0,,Хе, аа...
Dialogue: 0,0:55:36.07,0:55:40.04,Default,,0,0,0,,Га, таңертең күн шығады.
Dialogue: 0,0:55:41.08,0:55:45.05,Default,,0,0,0,,Аа, ертең басталады.
Dialogue: 0,0:55:46.08,0:55:52.05,Default,,0,0,0,,Ах, мен дәл қазір сонда болған түні
Dialogue: 0,0:55:46.08,0:55:52.05,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:55:54.09,0:55:58.09,Default,,0,0,0,,Мен артқа қарауым керек
Dialogue: 0,0:55:54.09,0:55:58.09,Default,,0,0,0,,Сіз байқамайтын керемет нәрселер бар.
Dialogue: 0,0:55:58.09,0:56:02.10,Default,,0,0,0,,Ал енді, осы сәттің көркі➡
Dialogue: 0,0:56:02.10,0:56:06.10,Default,,0,0,0,,Мен оны дәл қазір бүкіл денеммен сезінемін.
Dialogue: 0,0:56:06.10,0:56:09.10,Default,,0,0,0,,Келесі жылы мен сенімдімін
Dialogue: 0,0:56:06.10,0:56:09.10,Default,,0,0,0,,Үйде қайықпен серуендейміз.
Dialogue: 0,0:56:09.10,0:56:11.11,Default,,0,0,0,,О, мен оны асыға күтемін.
Dialogue: 0,0:56:09.10,0:56:11.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:56:11.11,0:56:14.11,Default,,0,0,0,,<Мен жақсы көретін адамдар
Dialogue: 0,0:56:11.11,0:56:14.11,Default,,0,0,0,,Менің сезімдерім➡
Dialogue: 0,0:56:14.11,0:56:21.12,Default,,0,0,0,,Бірінен соң бірі, бірінен соң бірі
Dialogue: 0,0:56:14.11,0:56:21.12,Default,,0,0,0,,«Миракуру» жасалды＞
Dialogue: 0,0:56:21.12,0:56:24.12,Default,,0,0,0,,<Гүлдеген тілектің дәні➡
Dialogue: 0,0:56:24.12,0:56:30.12,Default,,0,0,0,,Және жаңа тұқымдар туады
Dialogue: 0,0:56:24.12,0:56:30.12,Default,,0,0,0,,Болашаққа қосылу＞
Dialogue: 0,0:56:30.12,0:56:34.06,Default,,0,0,0,,<Сумен мәңгілік өмір сүру➡
Dialogue: 0,0:56:34.06,0:56:38.07,Default,,0,0,0,,Осы нео-Венеция қаласында＞
