Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:35.95,0:00:40.87,Default,,0,0,0,,(Балалар дауысы)
Dialogue: 0,0:01:15.53,0:01:18.32,Default,,0,0,0,,(шіркеу қоңырауының дыбысы)
Dialogue: 0,0:01:21.99,0:01:25.21,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:01:35.26,0:01:36.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:44.93,0:01:46.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:00.12,0:02:01.20,Default,,0,0,0,,Ах
Dialogue: 0,0:02:17.05,0:02:18.68,Default,,0,0,0,,бұл... а
Dialogue: 0,0:02:21.43,0:02:22.55,Default,,0,0,0,,Га
Dialogue: 0,0:02:30.85,0:02:32.27,Default,,0,0,0,,Гах…
Dialogue: 0,0:02:38.15,0:02:40.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:48.00,0:02:49.04,Default,,0,0,0,,Ах
Dialogue: 0,0:03:10.31,0:03:11.90,Default,,0,0,0,,Ханзада
Dialogue: 0,0:03:12.02,0:03:17.53,Default,,0,0,0,,Кешірімсіз ханзадамыз.
Dialogue: 0,0:03:17.94,0:03:20.53,Default,,0,0,0,,Мен сіздермен аудитория болғым келеді...
Dialogue: 0,0:03:44.64,0:03:48.56,Default,,0,0,0,,Мен сені бір күні оның елінде көремін.
Dialogue: 0,0:03:48.97,0:03:54.35,Default,,0,0,0,,Біздің вассал, аңсаған бақытты патша...
Dialogue: 0,0:03:57.73,0:04:01.82,Default,,0,0,0,,А-а-а... уф
Dialogue: 0,0:04:12.50,0:04:14.92,Default,,0,0,0,,(балта дыбысы)
Dialogue: 0,0:04:21.21,0:04:24.09,Default,,0,0,0,,(Ауыр аяқ дыбысы)
Dialogue: 0,0:04:38.82,0:04:41.94,Default,,0,0,0,,Оны бұл жолы Шетодан көрген сияқты.
Dialogue: 0,0:04:42.07,0:04:43.11,Default,,0,0,0,,Не…
Dialogue: 0,0:04:43.28,0:04:46.16,Default,,0,0,0,,Әр жерде оғаш оқиғалар болып жатыр...
Dialogue: 0,0:04:46.28,0:04:48.32,Default,,0,0,0,,Бұл қандай жаман белгі?
Dialogue: 0,0:04:48.45,0:04:50.91,Default,,0,0,0,,Қасиетті Тақ тергеу тобын жібере ме...
Dialogue: 0,0:04:51.04,0:04:55.37,Default,,0,0,0,,Әй, ақыры Киелі Тақ та қозғала бастады.
Dialogue: 0,0:05:35.83,0:05:39.88,Default,,0,0,0,,♪~
Dialogue: 0,0:07:03.33,0:07:08.63,Default,,0,0,0,,~♪
Dialogue: 0,0:07:31.74,0:07:33.87,Default,,0,0,0,,(шу)
Dialogue: 0,0:07:34.49,0:07:36.91,Default,,0,0,0,,Тым тереңдеп кетпеңіз
Dialogue: 0,0:07:39.45,0:07:41.79,Default,,0,0,0,,Тіпті құлап қалсаңыз да...
Dialogue: 0,0:07:42.92,0:07:43.83,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:07:45.59,0:07:49.09,Default,,0,0,0,,Рикерт қайтып келді. Біз Гриффиттің қайда екенін білеміз.
Dialogue: 0,0:07:50.17,0:07:51.47,Default,,0,0,0,,Жарайды... онда!
Dialogue: 0,0:07:58.72,0:07:59.97,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:08:00.68,0:08:01.81,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:03.94,0:08:05.94,Default,,0,0,0,,Әркім өз шегінде.
Dialogue: 0,0:08:06.36,0:08:08.86,Default,,0,0,0,,Бір жыл бойы осылай қашып жүрмін.
Dialogue: 0,0:08:09.11,0:08:10.69,Default,,0,0,0,,Шаршау шыңында...
Dialogue: 0,0:08:11.99,0:08:15.28,Default,,0,0,0,,Бірақ бұл дәл қазір ештеңе істей алмайтыныңызды білдірмейді.
Dialogue: 0,0:08:20.41,0:08:21.87,Default,,0,0,0,,Әйтеуір, қазір демалыңыз.
Dialogue: 0,0:08:24.50,0:08:25.17,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:25.29,0:08:26.42,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:08:41.22,0:08:43.48,Default,,0,0,0,,Майор… Майор Гилберт
Dialogue: 0,0:08:45.27,0:08:48.11,Default,,0,0,0,,Рикерт, сіз ұсталды!
Dialogue: 0,0:08:48.36,0:08:49.32,Default,,0,0,0,,Ах
Dialogue: 0,0:08:59.49,0:09:01.54,Default,,0,0,0,,Мен қатты толқыдым
Dialogue: 0,0:09:01.70,0:09:05.37,Default,,0,0,0,,Сұңқырлар тобының әйел көшбасшысы күткендей.\NСұңқар тобының
Dialogue: 0,0:09:05.50,0:09:10.38,Default,,0,0,0,,Дегенмен, кез келген шайқаста жеңіс немесе жеңіліс командир басын көтергенде шешіледі.
Dialogue: 0,0:09:10.55,0:09:11.38,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:09:14.80,0:09:16.93,Default,,0,0,0,,Бұл не деген балалар!
Dialogue: 0,0:09:21.93,0:09:23.43,Default,,0,0,0,,Ол жай ғана жау емес!
Dialogue: 0,0:09:23.60,0:09:25.89,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,0:09:31.15,0:09:32.28,Default,,0,0,0,,Каска!
Dialogue: 0,0:09:37.24,0:09:38.49,Default,,0,0,0,,Ах
Dialogue: 0,0:09:39.78,0:09:41.12,Default,,0,0,0,,Ку ха ха
Dialogue: 0,0:09:42.16,0:09:43.62,Default,,0,0,0,,Бұл шайқас болды
Dialogue: 0,0:09:44.25,0:09:48.25,Default,,0,0,0,,Бар болғаны қылышыңды лақтырып, адамдарыңа берілуді бұйырсаң болғаны.
Dialogue: 0,0:09:48.42,0:09:51.59,Default,,0,0,0,,Әйтпесе, басын кесіп тастаңыз.
Dialogue: 0,0:09:51.79,0:09:54.13,Default,,0,0,0,,Үш санау Таңдау
Dialogue: 0,0:09:54.63,0:09:55.88,Default,,0,0,0,,Бір
Dialogue: 0,0:09:57.84,0:09:59.09,Default,,0,0,0,,Екі
Dialogue: 0,0:10:03.01,0:10:04.39,Default,,0,0,0,,Үш!
Dialogue: 0,0:10:09.60,0:10:11.06,Default,,0,0,0,,Йоцу!
Dialogue: 0,0:10:13.11,0:10:15.99,Default,,0,0,0,,Көше өнерпаздарынан бас тартпа.
Dialogue: 0,0:10:18.86,0:10:21.70,Default,,0,0,0,,Ащы бол, Сеннинчо
Dialogue: 0,0:10:24.29,0:10:25.49,Default,,0,0,0,,Ішім!
Dialogue: 0,0:10:25.95,0:10:26.95,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:10:27.50,0:10:30.50,Default,,0,0,0,,Капитан! Сен қайтып келдің!
Dialogue: 0,0:10:35.34,0:10:38.63,Default,,0,0,0,,О! Менде депрессияға уақыт жоқ.
Dialogue: 0,0:10:38.76,0:10:41.68,Default,,0,0,0,,Бұны маған қалдыр, сен жұмысыңды істейсің.
Dialogue: 0,0:10:47.43,0:10:48.48,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:10:57.32,0:10:59.86,Default,,0,0,0,,Қайтып кел, маған кедергі жасама.
Dialogue: 0,0:11:01.66,0:11:04.08,Default,,0,0,0,,Мен бұл жігітті өлтіремін.
Dialogue: 0,0:11:15.25,0:11:19.22,Default,,0,0,0,,Мына жүзді найзағайдай өз денеңмен ал!
Dialogue: 0,0:11:20.84,0:11:22.68,Default,,0,0,0,,Ти!
Dialogue: 0,0:11:28.43,0:11:29.43,Default,,0,0,0,,Хехехе
Dialogue: 0,0:11:33.15,0:11:34.94,Default,,0,0,0,,О, ау!
Dialogue: 0,0:11:36.65,0:11:37.69,Default,,0,0,0,,Уф
Dialogue: 0,0:11:38.57,0:11:40.57,Default,,0,0,0,,О!
Dialogue: 0,0:11:45.74,0:11:47.24,Default,,0,0,0,,Уау
Dialogue: 0,0:11:47.62,0:11:48.91,Default,,0,0,0,,Құрметті Сират!
Dialogue: 0,0:11:52.75,0:11:53.92,Default,,0,0,0,,Түсіру
Dialogue: 0,0:11:54.58,0:11:55.75,Default,,0,0,0,,Мен қазірше артқа шегінемін.
Dialogue: 0,0:11:59.80,0:12:00.76,Default,,0,0,0,,Каска!
Dialogue: 0,0:12:13.48,0:12:15.44,Default,,0,0,0,,Зардап шеккендерге көмек көрсету
Dialogue: 0,0:12:15.56,0:12:16.65,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:12:18.07,0:12:19.32,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:35.96,0:12:38.50,Default,,0,0,0,,Не! ? Гриффит...?
Dialogue: 0,0:12:38.63,0:12:42.05,Default,,0,0,0,,Әй, сен кеткеннен кейінгі күннің оқиғасы.
Dialogue: 0,0:12:42.21,0:12:45.97,Default,,0,0,0,,Хе! Бізді Мидлендтің құтқарушылары ретінде қарсы алды...
Dialogue: 0,0:12:46.09,0:12:50.60,Default,,0,0,0,,Бір түнде сені іздеді, ал ақсүйектердің арманы кетті
Dialogue: 0,0:12:51.43,0:12:54.02,Default,,0,0,0,,Менің ойымша, бұл сізге маңызды емес.
Dialogue: 0,0:12:54.39,0:12:56.31,Default,,0,0,0,,Бірақ мен оны мойындамаймын.
Dialogue: 0,0:12:56.65,0:13:01.65,Default,,0,0,0,,Қиын кезде қасында болмаған бейбақты мен досым деп санамаймын.
Dialogue: 0,0:13:09.28,0:13:10.33,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:13:13.91,0:13:17.08,Default,,0,0,0,,Бір минут күтіңіз! Мен дәл қазір қан құмарлыққа толы болдым.
Dialogue: 0,0:13:19.21,0:13:20.92,Default,,0,0,0,,Сәлем, Каска!
Dialogue: 0,0:13:26.09,0:13:28.55,Default,,0,0,0,,Жалама, қылышыңды сөндір!
Dialogue: 0,0:13:33.31,0:13:35.39,Default,,0,0,0,,Ол әлі де беймаза жігіт.
Dialogue: 0,0:13:36.27,0:13:37.85,Default,,0,0,0,,Маған себебін көрсетіңіз
Dialogue: 0,0:13:38.85,0:13:40.36,Default,,0,0,0,,Бұл сен кінәлісің...
Dialogue: 0,0:13:40.98,0:13:42.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:43.03,0:13:46.20,Default,,0,0,0,,Сіз бәрін жойдыңыз...
Dialogue: 0,0:13:50.49,0:13:52.58,Default,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:13:53.49,0:13:56.46,Default,,0,0,0,,Сіз Гриффитті де, Шұңқырлар тобын да шатастырдыңыз!
Dialogue: 0,0:13:56.79,0:13:58.46,Default,,0,0,0,,Мен? неге
Dialogue: 0,0:13:58.71,0:14:01.34,Default,,0,0,0,,Сен сондай ақымақсың ба?
Dialogue: 0,0:14:04.80,0:14:08.13,Default,,0,0,0,,Гриффиттің бәрі сен еді!
Dialogue: 0,0:14:08.63,0:14:12.39,Default,,0,0,0,,Гриффиттің қасында жалғыз сен болдың!
Dialogue: 0,0:14:14.22,0:14:16.89,Default,,0,0,0,,Сен Гриффитті әлсіреттің!
Dialogue: 0,0:14:19.27,0:14:20.19,Default,,0,0,0,,Гриффит...
Dialogue: 0,0:14:22.11,0:14:22.90,Default,,0,0,0,,Гриффит...
Dialogue: 0,0:14:27.07,0:14:29.78,Default,,0,0,0,,Мен сенсіз істей алмаймын!
Dialogue: 0,0:14:40.96,0:14:41.92,Default,,0,0,0,,Ах
Dialogue: 0,0:14:48.26,0:14:50.13,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:14:50.63,0:14:53.89,Default,,0,0,0,,Ол Гриффит...
Dialogue: 0,0:14:54.60,0:14:55.68,Default,,0,0,0,,Сол Гриффит...
Dialogue: 0,0:14:55.81,0:14:57.89,Default,,0,0,0,,Жібер! Қан...
Dialogue: 0,0:14:58.39,0:14:59.48,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:00.14,0:15:04.86,Default,,0,0,0,,Мен жай ғана өз ісімді істедім... Гриффит сияқты.
Dialogue: 0,0:15:05.07,0:15:07.28,Default,,0,0,0,,Мен түсіндім, сондықтан жібер, ақымақ!
Dialogue: 0,0:15:20.62,0:15:22.71,Default,,0,0,0,,Мен Гриффиттікімін
Dialogue: 0,0:15:22.83,0:15:25.96,Default,,0,0,0,,Мен қылыш немесе әйел бола алмадым...
Dialogue: 0,0:15:29.30,0:15:31.63,Default,,0,0,0,,Мен шынымен де білдім
Dialogue: 0,0:15:32.13,0:15:36.85,Default,,0,0,0,,Мені сыйғызатын орын жоқ сияқты...
Dialogue: 0,0:15:37.81,0:15:39.93,Default,,0,0,0,,Мен қатты тырыстым:
Dialogue: 0,0:15:40.31,0:15:44.19,Default,,0,0,0,,Өйткені мен мұны істемесем, жоқ болып кетер едім.
Dialogue: 0,0:15:45.81,0:15:46.65,Default,,0,0,0,,Каска...
Dialogue: 0,0:15:48.11,0:15:53.32,Default,,0,0,0,,Бірақ жетеді, мен... шаршадым.
Dialogue: 0,0:15:54.95,0:15:57.83,Default,,0,0,0,,Қалғаны өзіңізге байланысты.
Dialogue: 0,0:16:34.82,0:16:36.62,Default,,0,0,0,,Сен менің курткамды ұшырып, мені де ұшырып жібердің ғой!
Dialogue: 0,0:16:37.37,0:16:39.12,Default,,0,0,0,,Уф аа
Dialogue: 0,0:16:41.79,0:16:44.21,Default,,0,0,0,,Сен не ойладың!
Dialogue: 0,0:16:44.33,0:16:47.92,Default,,0,0,0,,Тыңда, жарға тым жақындама.
Dialogue: 0,0:16:54.72,0:16:59.22,Default,,0,0,0,,Мені екі-үш рет сүйреп, құлатқанына шыдай алмаймын.
Dialogue: 0,0:17:00.22,0:17:03.10,Default,,0,0,0,,Менен бәрін тартып алған ол.
Dialogue: 0,0:17:04.48,0:17:07.27,Default,,0,0,0,,Мен оны өлтіргім келсе де...
Dialogue: 0,0:17:08.19,0:17:09.23,Default,,0,0,0,,Барка
Dialogue: 0,0:17:09.52,0:17:10.40,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:13.49,0:17:17.36,Default,,0,0,0,,Менің кесірімнен үнемі зардап шегесің...
Dialogue: 0,0:17:18.91,0:17:22.29,Default,,0,0,0,,Үнемі қан ағып жатырсың...
Dialogue: 0,0:17:26.00,0:17:27.75,Default,,0,0,0,,Баркер…
Dialogue: 0,0:18:47.66,0:18:49.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:42.84,0:19:43.84,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:19:44.97,0:19:46.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:46.39,0:19:50.06,Default,,0,0,0,,Гриффитті құтқарғаннан кейін ол шықты.
Dialogue: 0,0:19:50.56,0:19:53.85,Default,,0,0,0,,Аа, мен қатал болғым келеді.
Dialogue: 0,0:20:03.49,0:20:06.91,Default,,0,0,0,,Сен... менімен бірге жүр.
Dialogue: 0,0:20:07.03,0:20:07.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:08.12,0:20:10.50,Default,,0,0,0,,Гриффитті құтқарсаң, менімен бірге жүр.
Dialogue: 0,0:20:12.08,0:20:14.08,Default,,0,0,0,,Мен болашақта не күтіп тұрғанын білмеймін...
Dialogue: 0,0:20:15.54,0:20:16.67,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:16.84,0:20:17.88,Default,,0,0,0,,Ах
Dialogue: 0,0:20:19.63,0:20:22.59,Default,,0,0,0,,Бұлай жалғаса берсе, мен сені жеткілікті түрде ұстай алмаймын
Dialogue: 0,0:20:23.18,0:20:24.34,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:20:25.84,0:20:29.77,Default,,0,0,0,,Мен сені болашақта жүздеген, мыңдаған рет ұстағым келеді...
Dialogue: 0,0:20:30.10,0:20:31.64,Default,,0,0,0,,Мен қазір солай ойлаймын
Dialogue: 0,0:20:33.69,0:20:34.65,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:20:35.06,0:20:37.94,Default,,0,0,0,,Ақымақ болма, мен оны білемін.
Dialogue: 0,0:21:37.87,0:21:40.71,Default,,0,0,0,,Әй, Каска, оян, Каска!
Dialogue: 0,0:22:24.13,0:22:27.72,Default,,0,0,0,,Тісті берілістер айнала бастады...
Dialogue: 0,0:22:30.93,0:22:33.85,Default,,0,0,0,,Ақымақ, сөзсіз артта.
Dialogue: 0,0:22:52.66,0:22:54.08,Default,,0,0,0,,Не деген сұмдық! ?
Dialogue: 0,0:22:54.37,0:22:57.79,Default,,0,0,0,,Көңіл ал, күрескен.
Dialogue: 0,0:22:59.04,0:23:01.12,Default,,0,0,0,,Осыдан кейін сізге...
Dialogue: 0,0:23:01.25,0:23:07.26,Default,,0,0,0,,Ақылсыз нөсер, адам денесі ешқашан құтқара алмайтын өлім дауылы.
Dialogue: 0,0:23:08.13,0:23:11.30,Default,,0,0,0,,Есте болыңыз, күресушілер.
Dialogue: 0,0:23:11.89,0:23:14.51,Default,,0,0,0,,Күрес, сынақ, күрес!
Dialogue: 0,0:23:14.64,0:23:18.18,Default,,0,0,0,,Өліммен бетпе-бет келгендердің жалғыз семсері осы.
Dialogue: 0,0:23:19.14,0:23:21.94,Default,,0,0,0,,Армандауды ұмытпаңыз
Dialogue: 0,0:23:23.86,0:23:27.82,Default,,0,0,0,,Әй, ей, не айтып тұрсың! ? Күте тұрыңыз!
Dialogue: 0,0:24:09.65,0:24:11.90,Default,,0,0,0,,Бұл олқылықты табу жақсы жұмыс.
Dialogue: 0,0:24:12.03,0:24:13.95,Default,,0,0,0,,Сақтандырушы бар.
Dialogue: 0,0:24:16.37,0:24:19.24,Default,,0,0,0,,Гриффитті құтқарғысы келетін адам...
Dialogue: 0,0:24:19.37,0:24:22.04,Default,,0,0,0,,Бұл біздің жалғыз емес екенімізді білдіреді.
Dialogue: 0,0:24:22.50,0:24:25.38,Default,,0,0,0,,Алайда қамалдағы адамдар...
Dialogue: 0,0:24:30.76,0:24:32.51,Default,,0,0,0,,Сіз Hawk тобынансыз ба?
Dialogue: 0,0:24:33.93,0:24:38.76,Default,,0,0,0,,Мен сені күттім. Сіз шынымен келдіңіз.
Dialogue: 0,0:24:39.18,0:24:42.73,Default,,0,0,0,,Ханшайым! ? Сонымен, инсайдер ...
Dialogue: 0,0:24:43.02,0:24:45.40,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:24:52.53,0:24:56.03,Default,,0,0,0,,(Күнәкарлардың ыңырануы)
Dialogue: 0,0:25:01.87,0:25:04.04,Default,,0,0,0,,Бұл тесік қаншаға дейін барады?
Dialogue: 0,0:25:05.17,0:25:09.67,Default,,0,0,0,,Баяғыда, мың жылдай бұрын болған.
Dialogue: 0,0:25:10.21,0:25:11.76,Default,,0,0,0,,Бұл соғыс кезі еді.
Dialogue: 0,0:25:11.88,0:25:12.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:12.88,0:25:16.93,Default,,0,0,0,,Дүрбелеңге нүкте қоятын адам көрінді.
Dialogue: 0,0:25:19.80,0:25:21.56,Default,,0,0,0,,Оверлорд Гайзерик
Dialogue: 0,0:25:22.22,0:25:26.81,Default,,0,0,0,,Ол өз өмірінде бүкіл континентті қамтыған империя құрды.
Dialogue: 0,0:25:27.48,0:25:32.32,Default,,0,0,0,,Оның тұлғасы жұмбақ болғанымен, ол шайқаста өте шебер...
Dialogue: 0,0:25:32.73,0:25:37.41,Default,,0,0,0,,Ұрыс кезінде үнемі бас сүйегінің бетперде киіп жүретіні айтылады.
Dialogue: 0,0:25:37.57,0:25:39.62,Default,,0,0,0,,Сонда мен бұл туралы естідім.
Dialogue: 0,0:25:39.74,0:25:41.74,Default,,0,0,0,,Бас сүйегінің патшасы туралы әңгіме
Dialogue: 0,0:25:42.24,0:25:46.75,Default,,0,0,0,,Бірақ билікке батып бара жатқан патша Құдай жіберген бес періштеге жүгінді ...
Dialogue: 0,0:25:46.87,0:25:49.42,Default,,0,0,0,,Бүкіл қала қирады.
Dialogue: 0,0:25:49.58,0:25:51.00,Default,,0,0,0,,4 адам болған жоқ па?
Dialogue: 0,0:25:51.88,0:25:55.42,Default,,0,0,0,,Олай болса, бұл ертегі осы тесікке қалай қосылған?
Dialogue: 0,0:25:56.34,0:26:01.85,Default,,0,0,0,,Бұл ертегі емес! Кем дегенде, бұл қала шынымен болған.
Dialogue: 0,0:26:02.26,0:26:04.77,Default,,0,0,0,,Осы тік тесіктің тереңдігінде
Dialogue: 0,0:26:09.94,0:26:10.86,Default,,0,0,0,,Гррр…
Dialogue: 0,0:26:10.98,0:26:11.90,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:26:12.40,0:26:13.53,Default,,0,0,0,,Қандай бақыттысыңдар, барлық қызықты өзіңе алдыңдар.
Dialogue: 0,0:26:34.84,0:26:36.26,Default,,0,0,0,,Уф
Dialogue: 0,0:26:52.77,0:26:53.94,Default,,0,0,0,,Гриффит?
Dialogue: 0,0:26:54.07,0:26:55.48,Default,,0,0,0,,Гриффит мырза!
Dialogue: 0,0:26:58.82,0:26:59.95,Default,,0,0,0,,Біреу бар!
Dialogue: 0,0:27:03.12,0:27:03.95,Default,,0,0,0,,Гри...! ?
Dialogue: 0,0:27:06.79,0:27:08.58,Default,,0,0,0,,Gri... fiss?
Dialogue: 0,0:27:12.50,0:27:13.50,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:27:18.97,0:27:20.63,Default,,0,0,0,,Аяқ-қол сіңірлері кесілген
Dialogue: 0,0:27:22.76,0:27:23.72,Default,,0,0,0,,Тіл де...
Dialogue: 0,0:27:25.68,0:27:27.10,Default,,0,0,0,,Каска Бұл кілт!
Dialogue: 0,0:27:29.68,0:27:30.98,Default,,0,0,0,,Каска!
Dialogue: 0,0:27:39.03,0:27:40.49,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:27:40.95,0:27:42.53,Default,,0,0,0,,Келме!
Dialogue: 0,0:27:44.20,0:27:45.66,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:27:46.33,0:27:50.04,Default,,0,0,0,,Бұл мүмкін емес... Гриффит...
Dialogue: 0,0:27:57.71,0:27:59.67,Default,,0,0,0,,Гуц…цу
Dialogue: 0,0:28:32.21,0:28:33.58,Default,,0,0,0,,(Есік жабылған дыбысы)
Dialogue: 0,0:28:35.42,0:28:36.54,Default,,0,0,0,,Кяах!
Dialogue: 0,0:28:39.25,0:28:43.01,Default,,0,0,0,,Ой, балалар енді қаша алмайсыңдар.
Dialogue: 0,0:28:43.26,0:28:47.30,Default,,0,0,0,,Есікті құлыптағандықтан, хи хи хи!
Dialogue: 0,0:28:52.31,0:28:53.39,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:28:54.44,0:28:56.65,Default,,0,0,0,,Гриффитке не себеп болды?
Dialogue: 0,0:28:56.86,0:29:00.82,Default,,0,0,0,,Эй, мен мұндай әдемі ештеңе таба алмадым.
Dialogue: 0,0:29:00.94,0:29:03.61,Default,,0,0,0,,Бұл менің Олаға бірінші рет келуім.
Dialogue: 0,0:29:03.78,0:29:08.74,Default,,0,0,0,,Рики де азаптауға қосылды.
Dialogue: 0,0:29:08.87,0:29:12.95,Default,,0,0,0,,Алдымен қашып кетпес үшін қолдарыңыз бен аяқтарыңыздың сіңірлерін кесіңіз.
Dialogue: 0,0:29:13.08,0:29:18.79,Default,,0,0,0,,Содан бастап тамақпен ұйықтаған кездерім болмаса, терімді, тырнақтарымды тазалайтынмын.
Dialogue: 0,0:29:18.92,0:29:22.84,Default,,0,0,0,,Гриль үтікті жағыңыз немесе қайнаған суға салып қойыңыз
Dialogue: 0,0:29:22.96,0:29:28.30,Default,,0,0,0,,Тағы бір жыл бойы біз ерлі-зайыптылардың артынан жүрдік.
Dialogue: 0,0:29:28.85,0:29:30.01,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,0:29:30.18,0:29:35.44,Default,,0,0,0,,Оланың мақтаныш жинағы Оланың тұмарына қараңыз
Dialogue: 0,0:29:35.98,0:29:41.07,Default,,0,0,0,,Бұл сенің тілің, бұл поцелу... lelolelorero~
Dialogue: 0,0:29:41.65,0:29:42.48,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:29:47.99,0:29:49.53,Default,,0,0,0,,Хаг...
Dialogue: 0,0:29:49.74,0:29:53.83,Default,,0,0,0,,Өлейін деп тұрсың, бірақ екі жақты болсаң жәннатқа бара алмайсың.
Dialogue: 0,0:29:53.95,0:29:56.04,Default,,0,0,0,,Иә, тоқта, лерореро...
Dialogue: 0,0:29:59.17,0:30:04.17,Default,,0,0,0,,Жоқ, сіздің тынысыңыз тым ауыр. Сен тозаққа барасың.
Dialogue: 0,0:30:05.01,0:30:07.80,Default,,0,0,0,,Уау~
Dialogue: 0,0:30:08.18,0:30:10.68,Default,,0,0,0,,Әбу... Тәшүке...
Dialogue: 0,0:30:11.18,0:30:14.10,Default,,0,0,0,,Мен сізді естімеймін, анық сөйлеңіз.
Dialogue: 0,0:30:15.02,0:30:17.73,Default,,0,0,0,,Гяаа!
Dialogue: 0,0:30:20.19,0:30:23.69,Default,,0,0,0,,Қозғалмаңыз! Қару-жарақтарыңызды тастап, момындықпен беріле беріңіздер!
Dialogue: 0,0:30:25.32,0:30:27.28,Default,,0,0,0,,Ішек Бұл әзірше...
Dialogue: 0,0:30:28.15,0:30:30.37,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:30:34.08,0:30:35.54,Default,,0,0,0,,Кес, кес!
Dialogue: 0,0:30:53.26,0:30:55.18,Default,,0,0,0,,Не істеп жатырсың! Ат!
Dialogue: 0,0:30:55.31,0:30:56.27,Default,,0,0,0,,Ха!
Dialogue: 0,0:31:06.15,0:31:08.40,Default,,0,0,0,,Кеттік, Ішекке кешікпе!
Dialogue: 0,0:31:09.74,0:31:14.20,Default,,0,0,0,,Не?! ? Сол Гриффитті алып кетті!
Dialogue: 0,0:31:15.33,0:31:19.00,Default,,0,0,0,,Маған қашып кетуге жол берме! Оның қашып кетуіне ешқашан жол бермеңіз!
Dialogue: 0,0:31:21.37,0:31:22.92,Default,,0,0,0,,Аз ғана жау бар!
Dialogue: 0,0:31:24.09,0:31:25.59,Default,,0,0,0,,Каска-сама
Dialogue: 0,0:31:26.00,0:31:27.26,Default,,0,0,0,,Мен – Соғысшылар корпусының капитаны Тео Магатпын.
Dialogue: 0,0:31:35.89,0:31:36.68,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:31:36.81,0:31:41.19,Default,,0,0,0,,Hehe, it's an honor to work for the heroes who saved the country.
Dialogue: 0,0:31:56.49,0:31:57.87,Default,,0,0,0,,Қақпаны жабыңыз!
Dialogue: 0,0:31:58.79,0:32:01.08,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:32:01.96,0:32:04.67,Default,,0,0,0,,Біз көтерілісшілерге ешқашан жол бермейміз!
Dialogue: 0,0:32:07.59,0:32:09.92,Default,,0,0,0,,Атты көздеңіз! Ат!
Dialogue: 0,0:32:15.43,0:32:17.93,Default,,0,0,0,,Ей, ақымақ... Асығып кірейін деп жатырсың ба? ?
Dialogue: 0,0:32:22.02,0:32:23.85,Default,,0,0,0,,Не істеп жатырсың! ? Ақымақ!
Dialogue: 0,0:32:23.98,0:32:25.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:27.86,0:32:29.11,Default,,0,0,0,,Асығыңыз, асығыңыз
Dialogue: 0,0:32:45.58,0:32:46.29,Default,,0,0,0,,Дегенмен, Дио осы қалада бір жерде болуы тиіс
Dialogue: 0,0:32:48.00,0:32:49.34,Default,,0,0,0,,Гриффит мырза
Dialogue: 0,0:32:50.63,0:32:53.22,Default,,0,0,0,,Біз тағы кездесеміз...
Dialogue: 0,0:32:54.34,0:32:56.80,Default,,0,0,0,,Сәлем, ханшайым?
Dialogue: 0,0:33:06.94,0:33:08.36,Default,,0,0,0,,Тұрақты әскер.
Dialogue: 0,0:33:08.86,0:33:11.99,Default,,0,0,0,,There are roughly 50... no, 100 horses!
Dialogue: 0,0:33:17.37,0:33:18.45,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:33:19.08,0:33:20.74,Default,,0,0,0,,Ол жақындамайды...
Dialogue: 0,0:33:26.12,0:33:27.29,Default,,0,0,0,,Тұтқындау
Dialogue: 0,0:33:33.01,0:33:33.92,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:33:34.88,0:33:36.72,Default,,0,0,0,,Sister, the back is dangerous too!
Dialogue: 0,0:33:36.84,0:33:38.68,Default,,0,0,0,,Балалар сендер алға шықыңдар.
Dialogue: 0,0:33:39.05,0:33:41.89,Default,,0,0,0,,Гутс Пиппин, менің арқамды сұра.
Dialogue: 0,0:33:50.36,0:33:52.86,Default,,0,0,0,,Ол ұлы мәртебелі алдына бас иген қылмыскер. Оның қашып кетуіне жол бермеңіз!
Dialogue: 0,0:33:52.98,0:33:54.40,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:34:19.80,0:34:22.93,Default,,0,0,0,,The horse has been damaged. Бұл ұзаққа созылмайды!
Dialogue: 0,0:34:26.93,0:34:28.27,Default,,0,0,0,,Соңы жоқ!
Dialogue: 0,0:34:28.94,0:34:31.11,Default,,0,0,0,,Шүкір, бәрі...
Dialogue: 0,0:34:38.49,0:34:39.53,Default,,0,0,0,,Did you make it in time?
Dialogue: 0,0:34:41.16,0:34:42.49,Default,,0,0,0,,Коркас!
Dialogue: 0,0:34:44.04,0:34:46.83,Default,,0,0,0,,Hehe... I wanted to try it once.
Dialogue: 0,0:34:47.46,0:34:49.29,Default,,0,0,0,,Alright, bastards!
Dialogue: 0,0:34:49.83,0:34:52.84,Default,,0,0,0,,Бүкіл әскер аттанды...
Dialogue: 0,0:34:54.84,0:34:56.51,Default,,0,0,0,,Дәл қазір ештеңе жоқ Эй
Dialogue: 0,0:35:12.52,0:35:14.65,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:35:17.15,0:35:20.15,Default,,0,0,0,,Гриффит қайтып келгенше, ол менікі.
Dialogue: 0,0:35:20.28,0:35:22.53,Default,,0,0,0,,«Сұңқар тобы» толығымен қайта жанданды.
Dialogue: 0,0:35:22.66,0:35:26.70,Default,,0,0,0,,Кел, тағы да жеңеміз, тағы да жеңеміз, тағы да жеңеміз.
Dialogue: 0,0:35:26.83,0:35:29.16,Default,,0,0,0,,Осы жолы Тюдорды тағайындағыңыз келе ме?
Dialogue: 0,0:35:29.29,0:35:32.46,Default,,0,0,0,,Let's give those guys in Midland a break.
Dialogue: 0,0:35:32.75,0:35:35.80,Default,,0,0,0,,Бұл жақсы хахаха...
Dialogue: 0,0:35:36.75,0:35:39.80,Default,,0,0,0,,Sorry, I'll have a replacement ready right away.
Dialogue: 0,0:35:39.92,0:35:42.51,Default,,0,0,0,,Жоқ, капитан, демалыңыз.
Dialogue: 0,0:35:43.01,0:35:45.22,Default,,0,0,0,,Үнемі тынбай еңбектенбейсің бе?
Dialogue: 0,0:35:45.35,0:35:47.60,Default,,0,0,0,,Мен сендерді уайымдағандарыңды қаламаймын.
Dialogue: 0,0:35:58.44,0:36:00.61,Default,,0,0,0,,Сіз қалай ойлайсыз? Гриффит
Dialogue: 0,0:36:01.20,0:36:05.07,Default,,0,0,0,,Мен дәрігер емеспін, сондықтан егжей-тегжейлі білмеймін...
Dialogue: 0,0:36:05.87,0:36:06.91,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:36:12.04,0:36:12.75,Default,,0,0,0,,Гриффит
Dialogue: 0,0:36:15.04,0:36:16.79,Default,,0,0,0,,Ыстық емес пе?
Dialogue: 0,0:36:19.09,0:36:22.30,Default,,0,0,0,,It doesn't matter if you take it, there's only two of us.
Dialogue: 0,0:36:25.97,0:36:26.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:31.89,0:36:33.14,Default,,0,0,0,,Оны кигіңіз келе ме?
Dialogue: 0,0:36:34.81,0:36:37.86,Default,,0,0,0,,Хахаха... Саған ұқсайды.
Dialogue: 0,0:36:39.73,0:36:44.16,Default,,0,0,0,,It hasn't changed. Even after a year, this place is still a battlefield.
Dialogue: 0,0:36:44.86,0:36:47.33,Default,,0,0,0,,You can't start unless you put on the armor.
Dialogue: 0,0:36:50.24,0:36:54.67,Default,,0,0,0,,Also, my hands and feet were taken away, including their tendons.
Dialogue: 0,0:36:55.29,0:36:59.88,Default,,0,0,0,,Мен енді тұрып, қылышымды ұстай алмаймын...
Dialogue: 0,0:37:08.64,0:37:09.64,Default,,0,0,0,,Иә
Dialogue: 0,0:37:27.16,0:37:28.78,Default,,0,0,0,,Яһудеядан естілді
Dialogue: 0,0:37:28.91,0:37:30.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:37:31.29,0:37:33.96,Default,,0,0,0,,(Колканың күлкісі)
Dialogue: 0,0:37:51.01,0:37:54.64,Default,,0,0,0,,Эй, сен қалжыңдап тұрсың ба? Сол Гриффит...
Dialogue: 0,0:37:55.89,0:37:58.52,Default,,0,0,0,,Мен сонда болдым. Адамнан тікелей сұраңыз.
Dialogue: 0,0:37:58.65,0:38:00.06,Default,,0,0,0,,Бұл мүмкін емес, иә?
Dialogue: 0,0:38:01.65,0:38:03.86,Default,,0,0,0,,Гриффит енді сөйлей алмайды.
Dialogue: 0,0:38:08.41,0:38:10.49,Default,,0,0,0,,Гриффит... не?
Dialogue: 0,0:38:10.62,0:38:13.04,Default,,0,0,0,,Сіз нені айтасыз? Бұл рас па?
Dialogue: 0,0:38:14.54,0:38:18.42,Default,,0,0,0,,Ах...! Бұл не?
Dialogue: 0,0:38:19.46,0:38:22.71,Default,,0,0,0,,Болғалы тұрған жоқ па?
Dialogue: 0,0:38:23.55,0:38:27.63,Default,,0,0,0,,Мұның бәрі Гриффит қайтып келгенде болған оқиға емес пе?
Dialogue: 0,0:38:28.34,0:38:31.51,Default,,0,0,0,,Мен неге екенін түсінбей тұрып, мені күнәкар етіп жаратты...
Dialogue: 0,0:38:31.80,0:38:38.60,Default,,0,0,0,,Бір жыл бойы мен жәндіктерден қаштым, көптеген достарым қырылды.
Dialogue: 0,0:38:38.73,0:38:42.90,Default,,0,0,0,,Сонда да мен Гриффиттің қайтып оралғанын қалаймын...
Dialogue: 0,0:38:43.02,0:38:46.86,Default,,0,0,0,,Мен сендім, бірақ... міне, солай!
Dialogue: 0,0:38:47.45,0:38:51.78,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:39:00.54,0:39:02.08,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:39:02.21,0:39:04.13,Default,,0,0,0,,Бұдан былай біз...
Dialogue: 0,0:39:06.59,0:39:08.26,Default,,0,0,0,,Сіз бұл туралы бірдеңе істей алмайсыз ба?
Dialogue: 0,0:39:08.38,0:39:09.88,Default,,0,0,0,,Капитан Каска!
Dialogue: 0,0:39:10.68,0:39:13.18,Default,,0,0,0,,Бұл «Сұңқарлар тобы» жойылған сияқты емес.
Dialogue: 0,0:39:13.30,0:39:15.06,Default,,0,0,0,,Дәл солай, капитан Каска...
Dialogue: 0,0:39:17.64,0:39:19.44,Default,,0,0,0,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,0:39:19.56,0:39:23.19,Default,,0,0,0,,Келесі қуғыншы келгенше әлі уақыт болуы керек.
Dialogue: 0,0:39:23.86,0:39:26.15,Default,,0,0,0,,Оған дейін ойланып көрейін.
Dialogue: 0,0:39:33.03,0:39:37.95,Default,,0,0,0,,Ей, күте тұр, сен бұл туралы ойлағанда не істейсің?
Dialogue: 0,0:39:38.41,0:39:41.54,Default,,0,0,0,,Сіз дәл қазір бәріне не айтқыңыз келді?
Dialogue: 0,0:39:41.67,0:39:42.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:42.88,0:39:46.42,Default,,0,0,0,,Маған өзім шайқасқан шайқастар туралы шешім қабылдауымды айтты...
Dialogue: 0,0:39:47.00,0:39:49.09,Default,,0,0,0,,Сен мықтысың.
Dialogue: 0,0:39:49.88,0:39:54.10,Default,,0,0,0,,Бұл сіз өзіңіз күрескен шайқас, сондықтан сіз өзіңізді тоқтата алмайтын нәрселер бар.
Dialogue: 0,0:39:54.76,0:39:58.93,Default,,0,0,0,,Осы сөздерді қазіргі Гриффитке айта аласыз ба?
Dialogue: 0,0:40:01.56,0:40:06.07,Default,,0,0,0,,Біз бәріміз әлсізбіз. Біз әлсіз болғандықтан, біз адамдарға және армандарға жабысамыз.
Dialogue: 0,0:40:06.90,0:40:09.32,Default,,0,0,0,,Қолында ұстайтын нәрсесін жоғалтқандар үшін...
Dialogue: 0,0:40:09.44,0:40:11.32,Default,,0,0,0,,Қызық, мен саған бірдеңе істей аламын ба?
Dialogue: 0,0:40:11.90,0:40:17.58,Default,,0,0,0,,Жылы сөздер? Ауыр сөздер? Сіз үшін сонда болу үшін бе?
Dialogue: 0,0:40:18.62,0:40:22.62,Default,,0,0,0,,Мен де... Жанымда біреу болғанын қаладым.
Dialogue: 0,0:40:23.79,0:40:28.30,Default,,0,0,0,,Мен не істеуім керек? Мен не істеуім керек...
Dialogue: 0,0:40:29.38,0:40:31.80,Default,,0,0,0,,Мен тіпті білмеймін
Dialogue: 0,0:40:38.14,0:40:40.35,Default,,0,0,0,,Гриффитке барыңыз
Dialogue: 0,0:40:48.02,0:40:51.40,Default,,0,0,0,,Гриффит, таңғышты ауыстыр.
Dialogue: 0,0:40:53.78,0:40:57.12,Default,,0,0,0,,Енді не істейсің?
Dialogue: 0,0:40:57.24,0:40:59.03,Default,,0,0,0,,Сіз тағы да саяхатқа шығасыз ба?
Dialogue: 0,0:41:02.83,0:41:03.83,Default,,0,0,0,,Яһудея туралы не деуге болады?
Dialogue: 0,0:41:06.08,0:41:07.33,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:41:07.84,0:41:11.84,Default,,0,0,0,,Артта қалған адамдарды шақырсам, ұрылардың да қолынан келеді.
Dialogue: 0,0:41:12.01,0:41:15.13,Default,,0,0,0,,Осылайша сіз Гриффитке жалғыз қамқорлық жасай аласыз.
Dialogue: 0,0:41:15.26,0:41:16.51,Default,,0,0,0,,Сосын мен де
Dialogue: 0,0:41:16.84,0:41:22.06,Default,,0,0,0,,Сен енді ересек адам шығарсың. Жақсырақ, бұл жолы Касканы өзіңізбен бірге алыңыз.
Dialogue: 0,0:41:22.18,0:41:23.02,Default,,0,0,0,,А...
Dialogue: 0,0:41:23.52,0:41:27.10,Default,,0,0,0,,Ол... Бұл жолы оны өзіммен бірге алып кетуім керек.
Dialogue: 0,0:41:28.73,0:41:30.02,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:41:31.86,0:41:32.99,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:41:33.32,0:41:35.78,Default,,0,0,0,,Капитан капитан
Dialogue: 0,0:41:37.57,0:41:40.91,Default,,0,0,0,,Өткен жолғыдай қайта қыдыруды жоспарлап отырсыз ба?
Dialogue: 0,0:41:41.70,0:41:44.37,Default,,0,0,0,,Егер бұл орын алса, маған қосылуға рұқсат етіңіз.
Dialogue: 0,0:41:45.00,0:41:47.25,Default,,0,0,0,,Кесілген топ Барлығымыз бірге шештік.
Dialogue: 0,0:41:47.37,0:41:49.21,Default,,0,0,0,,О, сіз мұны әлі де жасай аласыз.
Dialogue: 0,0:41:49.54,0:41:51.05,Default,,0,0,0,,Жалдамалы, бәрібір.
Dialogue: 0,0:41:51.17,0:41:52.67,Default,,0,0,0,,Тек капитан болса
Dialogue: 0,0:41:53.13,0:41:55.47,Default,,0,0,0,,Капитан өтінемін, капитан!
Dialogue: 0,0:41:55.59,0:41:56.55,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:41:57.26,0:42:00.05,Default,,0,0,0,,Біз бәріміз де өз отбасымызды жақсы күтеміз емеспіз бе?
Dialogue: 0,0:42:00.18,0:42:02.81,Default,,0,0,0,,Мен қайда барсам да, егер сені қаласаң, мен сенімен бірге барғым келеді.
Dialogue: 0,0:42:02.93,0:42:06.02,Default,,0,0,0,,Тек капитан болса, жақсы болар едік.
Dialogue: 0,0:42:07.23,0:42:09.10,Default,,0,0,0,,Сәлем, капитан! Өтінемін!
Dialogue: 0,0:42:09.23,0:42:09.90,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:42:10.02,0:42:11.11,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:42:11.23,0:42:12.23,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:42:14.07,0:42:17.07,Default,,0,0,0,,Өтінемін, капитан.
Dialogue: 0,0:42:34.42,0:42:38.88,Default,,0,0,0,,Рикерт шекарадан өтудің жолын іздеп, жетекшілік етеді.
Dialogue: 0,0:42:39.80,0:42:42.39,Default,,0,0,0,,Мен сіздің Калония тауларында танитын адамыңыз бар екенін естідім...
Dialogue: 0,0:43:08.08,0:43:09.08,Default,,0,0,0,,О?
Dialogue: 0,0:43:09.96,0:43:12.50,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:43:14.04,0:43:17.59,Default,,0,0,0,,Мен әлдеқайда жақсы болдым деп ойладым, бірақ...
Dialogue: 0,0:43:20.01,0:43:22.22,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:43:22.89,0:43:23.89,Default,,0,0,0,,Ах
Dialogue: 0,0:43:25.89,0:43:29.39,Default,,0,0,0,,Кешіріңіз, оның орнына мен сізге көрпе әкелемін...
Dialogue: 0,0:43:30.60,0:43:33.56,Default,,0,0,0,,Не! ? Гриффит Гриффит...
Dialogue: 0,0:43:37.53,0:43:38.86,Default,,0,0,0,,Ах
Dialogue: 0,0:43:39.70,0:43:42.70,Default,,0,0,0,,Гриффит... Тоқта!
Dialogue: 0,0:44:32.04,0:44:33.04,Default,,0,0,0,,Каска
Dialogue: 0,0:44:36.04,0:44:37.04,Default,,0,0,0,,Ішек...
Dialogue: 0,0:44:40.88,0:44:41.84,Default,,0,0,0,,Гриффит ше?
Dialogue: 0,0:44:42.05,0:44:44.64,Default,,0,0,0,,Иә... Жаңа ғана ұйықтап қалдым.
Dialogue: 0,0:44:46.35,0:44:47.55,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:44:48.06,0:44:49.77,Default,,0,0,0,,Не... не?
Dialogue: 0,0:44:49.97,0:44:52.10,Default,,0,0,0,,Эй, не болды? Не болды?
Dialogue: 0,0:44:54.23,0:44:57.11,Default,,0,0,0,,Жоқ, бұл бәрібір...
Dialogue: 0,0:44:57.23,0:45:00.82,Default,,0,0,0,,Сіз ештеңеге жылап отырсыз ба? Гриффитке не болды?
Dialogue: 0,0:45:01.94,0:45:04.24,Default,,0,0,0,,Тоқта, жоқ!
Dialogue: 0,0:45:10.20,0:45:11.41,Default,,0,0,0,,Әй...
Dialogue: 0,0:45:12.33,0:45:14.21,Default,,0,0,0,,Кешіріңіз, мен бара алмаймын.
Dialogue: 0,0:45:14.33,0:45:15.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:15.67,0:45:16.75,Default,,0,0,0,,Мен...
Dialogue: 0,0:45:17.58,0:45:20.21,Default,,0,0,0,,Мен сенімен бара алмаймын...
Dialogue: 0,0:45:21.59,0:45:24.68,Default,,0,0,0,,Гриффит өте арық...
Dialogue: 0,0:45:25.43,0:45:28.30,Default,,0,0,0,,Жеңіл... осылай дірілдеп...
Dialogue: 0,0:45:29.43,0:45:31.72,Default,,0,0,0,,Сол мақтаншақ Гриффит...
Dialogue: 0,0:45:35.81,0:45:39.44,Default,,0,0,0,,Мен қазіргі Гриффитті артта қалдыра алмаймын...
Dialogue: 0,0:45:40.61,0:45:44.82,Default,,0,0,0,,Мен сені тастап кете алмаймын. кешіріңіз...
Dialogue: 0,0:45:48.20,0:45:50.99,Default,,0,0,0,,(Касканың айқайы)
Dialogue: 0,0:45:55.12,0:45:56.46,Default,,0,0,0,,Мен де қаламын
Dialogue: 0,0:45:59.29,0:46:02.05,Default,,0,0,0,,Мен де Сұңқарлар тобында қаламын...
Dialogue: 0,0:46:19.02,0:46:22.23,Default,,0,0,0,,Промроз Холлда не болғаны есіңізде ме?
Dialogue: 0,0:46:28.99,0:46:29.66,Default,,0,0,0,,О
Dialogue: 0,0:46:32.87,0:46:34.87,Default,,0,0,0,,Олай болса бару керек.
Dialogue: 0,0:46:39.17,0:46:43.30,Default,,0,0,0,,Гриффитпен тең болсаң, оның досы болсаң...
Dialogue: 0,0:46:44.46,0:46:46.47,Default,,0,0,0,,Мен жалғыз баруым керек
Dialogue: 0,0:47:30.55,0:47:33.39,Default,,0,0,0,,Мұндай жерде неден қорқасың?
Dialogue: 0,0:47:47.40,0:47:50.36,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:47:58.91,0:48:01.75,Default,,0,0,0,,Кеттік, әлі қызық болған жоқ.
Dialogue: 0,0:48:02.50,0:48:04.59,Default,,0,0,0,,Күн әлі батқан жоқ
Dialogue: 0,0:48:08.92,0:48:10.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:11.22,0:48:12.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:12.80,0:48:13.97,Default,,0,0,0,,(Арба дыбысы)
Dialogue: 0,0:48:15.22,0:48:16.26,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:48:16.51,0:48:18.60,Default,,0,0,0,,Не, қашқан ат?
Dialogue: 0,0:48:19.31,0:48:21.44,Default,,0,0,0,,Жоқ, Гриффит бұл туралы айтып отыр! ?
Dialogue: 0,0:48:21.56,0:48:23.73,Default,,0,0,0,,Ақымақ! Мен әрең жүгіре аламын ...
Dialogue: 0,0:48:27.15,0:48:28.69,Default,,0,0,0,,Яһудаға және басқаларға айт!
Dialogue: 0,0:48:29.74,0:48:30.44,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:48:31.45,0:48:32.57,Default,,0,0,0,,Маған ат беріңдер!
Dialogue: 0,0:48:36.24,0:48:38.66,Default,,0,0,0,,Қарғыс атсын! Қарғыс атсын!
Dialogue: 0,0:48:39.20,0:48:40.08,Default,,0,0,0,,Уг!?
Dialogue: 0,0:48:59.22,0:49:02.98,Default,,0,0,0,,Иә... Мен сәл демалдым.
Dialogue: 0,0:49:05.06,0:49:10.61,Default,,0,0,0,,Мен қазір баруым керек, бұл ойын әлі аяқталған жоқ...
Dialogue: 0,0:49:11.49,0:49:17.03,Default,,0,0,0,,Артқы аллеядағы тас төсем әлі жалғасып жатыр...
Dialogue: 0,0:50:04.37,0:50:07.87,Default,,0,0,0,,(қарлыған күлкі)
Dialogue: 0,0:51:17.44,0:51:20.41,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:51:49.39,0:51:50.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:52:08.16,0:52:09.12,Default,,0,0,0,,Не?
Dialogue: 0,0:52:09.62,0:52:12.17,Default,,0,0,0,,Әй... мінекей
Dialogue: 0,0:52:15.17,0:52:16.84,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:52:26.72,0:52:27.68,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:52:33.44,0:52:35.44,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:52:36.44,0:52:37.65,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:52:42.40,0:52:43.74,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:52:58.46,0:52:59.38,Default,,0,0,0,,Не...! ?
Dialogue: 0,0:53:04.09,0:53:06.30,Default,,0,0,0,,Егер мен сізге дәл қазір қол тигізсем...
Dialogue: 0,0:53:14.35,0:53:15.90,Default,,0,0,0,,Мен ешқашан...
Dialogue: 0,0:53:34.58,0:53:35.83,Default,,0,0,0,,Мен сені енді ешқашан көрмеймін...
Dialogue: 0,0:53:56.85,0:53:58.86,Default,,0,0,0,,(толқын)
Dialogue: 0,0:54:10.03,0:54:11.70,Default,,0,0,0,,(адамның ыңырануы)
Dialogue: 0,0:54:12.54,0:54:14.25,Default,,0,0,0,,Не? Ах
Dialogue: 0,0:54:18.46,0:54:21.63,Default,,0,0,0,,Не... болды...?
Dialogue: 0,0:54:30.43,0:54:31.72,Default,,0,0,0,,Не болып жатыр! ?
Dialogue: 0,0:54:32.06,0:54:34.35,Default,,0,0,0,,Уау~ Бұл қайда?!
Dialogue: 0,0:54:34.56,0:54:37.06,Default,,0,0,0,,Бұл не...! ? Қай жерде пайда болды?
Dialogue: 0,0:54:38.98,0:54:41.98,Default,,0,0,0,,Әй, біз... жайлауда жүгіріп келе жатқанбыз... Әй! ?
Dialogue: 0,0:54:42.11,0:54:44.61,Default,,0,0,0,,Сәлем! Аяғыңызға қараңыз!
Dialogue: 0,0:54:47.82,0:54:52.70,Default,,0,0,0,,Бұлай болуы мүмкін емес! Бұл арман, біз армандаймыз
Dialogue: 0,0:54:52.83,0:54:54.04,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:54:54.16,0:54:57.66,Default,,0,0,0,,Түсінбеген нәрсені ойлама! Қолыңнан келгенін істе!
Dialogue: 0,0:54:58.00,0:55:02.04,Default,,0,0,0,,Шеңбер қорғауды құрастыру. Қазір жау шапса, құрып кетесің!
Dialogue: 0,0:55:02.17,0:55:04.71,Default,,0,0,0,,Дзюдо! Коркас! Гастон! Пиппин!
Dialogue: 0,0:55:04.88,0:55:07.51,Default,,0,0,0,,Адам санын тексеріп, құрамын дайында. Бұл үлкен доп...
Dialogue: 0,0:55:07.63,0:55:10.30,Default,,0,0,0,,Жебені арбалет ұстаған адамға бер! Кешіктірмеңіз!
Dialogue: 0,0:55:10.43,0:55:12.55,Default,,0,0,0,,Гриффит сен тұра аласың ба?
Dialogue: 0,0:55:21.69,0:55:22.94,Default,,0,0,0,,Бехелит?
Dialogue: 0,0:55:28.45,0:55:30.16,Default,,0,0,0,,Гриффит... жақсысың ба?
Dialogue: 0,0:55:32.20,0:55:33.95,Default,,0,0,0,,Уақыт келді...
Dialogue: 0,0:55:34.20,0:55:35.87,Default,,0,0,0,,Уақыт келді...
Dialogue: 0,0:55:36.04,0:55:37.54,Default,,0,0,0,,Уақыт келді...
Dialogue: 0,0:55:37.66,0:55:39.96,Default,,0,0,0,,Ұлы түн мерекесінің уақыты...
Dialogue: 0,0:55:40.08,0:55:44.71,Default,,0,0,0,,216 жылда бір рет болатын банкет уақыты...
Dialogue: 0,0:55:44.92,0:55:46.38,Default,,0,0,0,,Тұтылу!
Dialogue: 0,0:55:47.42,0:55:48.72,Default,,0,0,0,,Тұтылу! ?
Dialogue: 0,0:55:50.55,0:55:52.05,Default,,0,0,0,,Бұл не деген жігіттер! ?
Dialogue: 0,0:55:52.22,0:55:53.05,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:55:53.60,0:55:54.72,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:55:54.85,0:55:55.89,Default,,0,0,0,,Бұл келе жатыр...
Dialogue: 0,0:55:56.01,0:55:57.72,Default,,0,0,0,,Кел
Dialogue: 0,0:55:57.85,0:56:00.10,Default,,0,0,0,,Сол адамдар келе жатыр...
Dialogue: 0,0:56:00.23,0:56:01.39,Default,,0,0,0,,Бұл келе жатыр...
Dialogue: 0,0:56:01.64,0:56:02.60,Default,,0,0,0,,Келеді...
Dialogue: 0,0:56:02.73,0:56:05.48,Default,,0,0,0,,Біз табиғаттан тыс патшамыз
Dialogue: 0,0:56:08.19,0:56:12.24,Default,,0,0,0,,Төрт қорғаушы періштенің келуі!
Dialogue: 0,0:56:18.45,0:56:21.08,Default,,0,0,0,,Уа, Тран мырза!
Dialogue: 0,0:56:22.54,0:56:24.96,Default,,0,0,0,,Лорд Тран!
Dialogue: 0,0:56:47.23,0:56:48.32,Default,,0,0,0,,Ах
Dialogue: 0,0:57:02.71,0:57:05.25,Default,,0,0,0,,Kyohoho…
Dialogue: 0,0:57:12.92,0:57:15.18,Default,,0,0,0,,Вахахаха
Dialogue: 0,0:57:21.18,0:57:24.14,Default,,0,0,0,,Kyohoho…
Dialogue: 0,0:57:26.15,0:57:28.44,Default,,0,0,0,,Ооо~
Dialogue: 0,0:57:28.82,0:57:30.48,Default,,0,0,0,,Енді ше? ?
Dialogue: 0,0:57:38.49,0:57:39.99,Default,,0,0,0,,Не?
Dialogue: 0,0:57:56.63,0:57:58.39,Default,,0,0,0,,Ооо~
Dialogue: 0,0:58:12.28,0:58:13.65,Default,,0,0,0,,Құдай…
Dialogue: 0,0:58:14.49,0:58:16.07,Default,,0,0,0,,Жоқ, шайтан?
Dialogue: 0,0:58:16.20,0:58:18.49,Default,,0,0,0,,Жақсы жиналды.
Dialogue: 0,0:58:19.03,0:58:24.25,Default,,0,0,0,,Құдай емес, адам жасаған Құдайдың Тоқтылары.
Dialogue: 0,0:58:24.87,0:58:30.04,Default,,0,0,0,,Осы қасиетті түн мерекесінен толық рахат алыңыз.
Dialogue: 0,0:58:30.21,0:58:31.71,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:58:33.30,0:58:37.38,Default,,0,0,0,,Хок, себеп-салдар заңы бойынша таңдалған ұл
Dialogue: 0,0:58:38.76,0:58:44.39,Default,,0,0,0,,Таңдаулысың, осы сағатта, осы елде...
Dialogue: 0,0:58:44.56,0:58:49.60,Default,,0,0,0,,Ұлы Құдайдың қолымен тағайындалғандар
Dialogue: 0,0:58:50.36,0:58:55.74,Default,,0,0,0,,Біздің вассалымыз, аңсаған Бақытты патша!
Dialogue: 0,0:58:57.57,0:58:58.57,Default,,0,0,0,,Тәуелді...?
Dialogue: 0,0:58:58.70,0:58:59.99,Default,,0,0,0,,Бұл...
Dialogue: 0,0:59:00.11,0:59:02.62,Default,,0,0,0,,Достар? Гриффит?
Dialogue: 0,0:59:02.78,0:59:04.41,Default,,0,0,0,,Олар сияқты...?
Dialogue: 0,0:59:06.08,0:59:07.21,Default,,0,0,0,,…Оны жібермеңіз
Dialogue: 0,0:59:09.25,0:59:11.25,Default,,0,0,0,,Ауырсынып жатыр~! Қарауға батылым жетпейді
Dialogue: 0,0:59:12.00,0:59:12.92,Default,,0,0,0,,Ішек...
Dialogue: 0,0:59:13.04,0:59:16.84,Default,,0,0,0,,Ұлым? Сіз туыссыз ба? Ақымақ болма!
Dialogue: 0,0:59:17.09,0:59:19.84,Default,,0,0,0,,Мен бұл жігітті бұрын да жалаңаш көргенмін.
Dialogue: 0,0:59:20.09,0:59:23.26,Default,,0,0,0,,Бұл жігіттің құйрығы да өспейді!
Dialogue: 0,0:59:24.51,0:59:27.35,Default,,0,0,0,,Аха…
Dialogue: 0,0:59:28.89,0:59:31.85,Default,,0,0,0,,Әдемі достық
Dialogue: 0,0:59:32.02,0:59:36.90,Default,,0,0,0,,Сіз үлкен құрбандық етер едіңіз.
Dialogue: 0,0:59:37.07,0:59:38.07,Default,,0,0,0,,Құрбан шалу?
Dialogue: 0,0:59:38.36,0:59:44.16,Default,,0,0,0,,Иә, оның жын патшасы болуы үшін қымбат құрбандық...
Dialogue: 0,0:59:44.28,0:59:47.66,Default,,0,0,0,,Мен сол қызыл Бехелитті алған күннен бастап...
Dialogue: 0,0:59:47.79,0:59:52.25,Default,,0,0,0,,Сіз жын патшасы болу біліктілігін алдыңыз, kyohohoho...
Dialogue: 0,0:59:52.42,0:59:55.84,Default,,0,0,0,,Бұл біздің қорғаншы періштеміз.
Dialogue: 0,0:59:55.96,1:00:01.72,Default,,0,0,0,,Бұл құдайдың қолына қайта туылуы мүмкін үстем қожаның жұмыртқасы.
Dialogue: 0,1:00:02.01,1:00:06.81,Default,,0,0,0,,Ал сен періштелердің келуі үшін...
Dialogue: 0,1:00:06.97,1:00:08.81,Default,,0,0,0,,Бағалы құрбандық...
Dialogue: 0,1:00:09.64,1:00:12.10,Default,,0,0,0,,Хо хо хо хо
Dialogue: 0,1:00:12.23,1:00:14.48,Default,,0,0,0,,(Біртүрлі жаратылыстардың күлкісі)
Dialogue: 0,1:00:16.23,1:00:19.49,Default,,0,0,0,,Бұл арман ғой бұл арман ғой
Dialogue: 0,1:00:24.78,1:00:27.79,Default,,0,0,0,,Гриффитті құбыжыққа айналдырсаңыз ше?
Dialogue: 0,1:00:27.91,1:00:29.75,Default,,0,0,0,,Біздің өмірімізге айырбас ретінде...
Dialogue: 0,1:00:29.87,1:00:35.34,Default,,0,0,0,,Бұл сәл басқаша. Бұл оның еркі.
Dialogue: 0,1:00:36.17,1:00:40.59,Default,,0,0,0,,Ол сені құрбан етеді...
Dialogue: 0,1:00:40.72,1:00:42.13,Default,,0,0,0,,Га
Dialogue: 0,1:00:47.60,1:00:49.68,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,1:00:55.15,1:00:57.07,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,1:00:59.19,1:01:01.19,Default,,0,0,0,,Осындай нәрсе болуы керек...
Dialogue: 0,1:01:01.40,1:01:05.37,Default,,0,0,0,,Барлығы себеп пен салдар ағымында
Dialogue: 0,1:01:05.70,1:01:10.62,Default,,0,0,0,,Енді жын шығару рәсімі өтеді.
Dialogue: 0,1:01:11.20,1:01:15.75,Default,,0,0,0,,Ұлыңызды құрбандық үстеліне әкеліңіз!
Dialogue: 0,1:01:23.09,1:01:25.26,Default,,0,0,0,,Ішім! Гриффит!
Dialogue: 0,1:01:39.36,1:01:40.44,Default,,0,0,0,,Уау
Dialogue: 0,1:01:57.00,1:01:58.67,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,1:02:07.30,1:02:10.26,Default,,0,0,0,,Ааа... уф
Dialogue: 0,1:02:28.28,1:02:32.49,Default,,0,0,0,,Қорқынышты ма? Сен сияқты біреу
Dialogue: 0,1:02:33.37,1:02:36.79,Default,,0,0,0,,Табиғаттан тыс тіршілік иелері туралы не деуге болады?
Dialogue: 0,1:02:37.17,1:02:42.00,Default,,0,0,0,,Әлде бұл сіздің келе жатқан болашақ па?
Dialogue: 0,1:02:42.63,1:02:47.55,Default,,0,0,0,,Болашаққа жеткенше бір рет біл.
Dialogue: 0,1:02:47.84,1:02:50.47,Default,,0,0,0,,Өзіңіз...
Dialogue: 0,1:02:56.68,1:02:59.85,Default,,0,0,0,,(шіркеу қоңырауының дыбысы)
Dialogue: 0,1:03:02.90,1:03:03.94,Default,,0,0,0,,Ах
Dialogue: 0,1:03:33.22,1:03:34.26,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:35.06,1:03:36.02,Default,,0,0,0,,Уау!
Dialogue: 0,1:03:42.69,1:03:44.32,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:03:46.15,1:03:47.82,Default,,0,0,0,,Ах, уау!
Dialogue: 0,1:03:49.90,1:03:50.74,Default,,0,0,0,,Уау!
Dialogue: 0,1:03:50.86,1:03:55.28,Default,,0,0,0,,Әй... Ол шынымен шулы бала.
Dialogue: 0,1:03:55.99,1:03:58.54,Default,,0,0,0,,Нені шулатып жатырсың?
Dialogue: 0,1:03:58.96,1:04:04.00,Default,,0,0,0,,Өйткені, кемпір, қаншама адам өліп жатыр!
Dialogue: 0,1:04:04.13,1:04:06.80,Default,,0,0,0,,Бұл сіздің істегеніңіз емес пе?
Dialogue: 0,1:04:14.89,1:04:19.27,Default,,0,0,0,,Сенің сол сарайға барасың деп айтуым керек.
Dialogue: 0,1:04:19.39,1:04:22.40,Default,,0,0,0,,Барлығы аман қалды!
Dialogue: 0,1:04:24.40,1:04:28.32,Default,,0,0,0,,Солай...Мен ешкімді артымнан еруге мәжбүрлей алмаймын...
Dialogue: 0,1:04:28.44,1:04:29.74,Default,,0,0,0,,Одамари!
Dialogue: 0,1:04:30.70,1:04:33.16,Default,,0,0,0,,Сіз білуіңіз керек еді
Dialogue: 0,1:04:33.28,1:04:38.04,Default,,0,0,0,,Сіз бұл жердің қандай екенін білуіңіз керек еді.
Dialogue: 0,1:04:40.25,1:04:41.75,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,1:04:42.75,1:04:44.25,Default,,0,0,0,,(Беатриса) Ол кітап бөлмеге кіріп кеткен жәндіктерден қалай құтылу керектігін айтып бере ме екен?
Dialogue: 0,1:04:44.71,1:04:50.05,Default,,0,0,0,,Сол қамалға жетудің жалғыз жолы - сол мәйітті басу.
Dialogue: 0,1:04:50.55,1:04:55.43,Default,,0,0,0,,Әйтпесе, сен де өлікке айналасың.
Dialogue: 0,1:04:59.31,1:05:02.31,Default,,0,0,0,,Мен... мен...
Dialogue: 0,1:05:03.14,1:05:05.52,Default,,0,0,0,,Мына бала ақымақ...
Dialogue: 0,1:05:06.15,1:05:09.82,Default,,0,0,0,,Өкінгеннен гөрі, ең алдымен мұны қаламағанымды қалаймын...
Dialogue: 0,1:05:10.65,1:05:15.28,Default,,0,0,0,,Мен неге артқы аллеядан жоғары қарап, қанағаттанбадым?
Dialogue: 0,1:05:22.37,1:05:25.12,Default,,0,0,0,,Иә... Мен білдім.
Dialogue: 0,1:05:26.00,1:05:27.29,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,1:05:29.21,1:05:30.13,Default,,0,0,0,,Хэхе…
Dialogue: 0,1:05:31.34,1:05:36.30,Default,,0,0,0,,Мен кешірім сұрай алмаймын, жоқ, мен...
Dialogue: 0,1:05:37.76,1:05:40.72,Default,,0,0,0,,Кешірім сұрасаң, өкінсең...
Dialogue: 0,1:05:41.81,1:05:44.06,Default,,0,0,0,,Өйткені бәрі бітеді
Dialogue: 0,1:05:46.52,1:05:50.82,Default,,0,0,0,,Өйткені ол жерге енді жете алмайсың...
Dialogue: 0,1:05:58.07,1:06:00.95,Default,,0,0,0,,Иә, бұл сенсің!
Dialogue: 0,1:06:05.46,1:06:07.54,Default,,0,0,0,,Бұл жай ғана елес пе...?
Dialogue: 0,1:06:09.04,1:06:11.46,Default,,0,0,0,,Бұл иллюзия емес...
Dialogue: 0,1:06:11.59,1:06:15.55,Default,,0,0,0,,Бұл сіздің саналы әлеміңіздегі шындық!
Dialogue: 0,1:06:18.76,1:06:24.68,Default,,0,0,0,,Аспандағы қамалды көздеген мүрделер төбесінде үйіліп жатыр
Dialogue: 0,1:06:25.18,1:06:27.85,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,1:06:28.35,1:06:30.11,Default,,0,0,0,,Және...
Dialogue: 0,1:06:30.90,1:06:35.03,Default,,0,0,0,,Енді сіздің артқы аллеяңыз аяқталды.
Dialogue: 0,1:06:35.49,1:06:36.86,Default,,0,0,0,,Бірақ қараңыз
Dialogue: 0,1:06:38.03,1:06:42.95,Default,,0,0,0,,Бірге ұшуын жалғастырған сұңқар қанаттары
Dialogue: 0,1:06:43.37,1:06:49.79,Default,,0,0,0,,Қанды сапарыңның соңында не қалды...
Dialogue: 0,1:06:50.88,1:06:54.21,Default,,0,0,0,,Ал сіз өмір сүре аласыз
Dialogue: 0,1:06:54.96,1:06:57.88,Default,,0,0,0,,Армандардың қалдықтарына көмілген...
Dialogue: 0,1:06:59.30,1:07:01.89,Default,,0,0,0,,Арманның қалдықтары...
Dialogue: 0,1:07:06.06,1:07:11.61,Default,,0,0,0,,Сізден қалғанның бәрін жинаңыз...
Dialogue: 0,1:07:12.73,1:07:18.32,Default,,0,0,0,,Жүрегіңізде бір сөз айтыңыз: «Арнау».
Dialogue: 0,1:07:21.03,1:07:24.37,Default,,0,0,0,,Сонда сіз төбеден аспанға ұшасыз.
Dialogue: 0,1:07:24.49,1:07:28.37,Default,,0,0,0,,Мен саған қара қанатты бермеймін!
Dialogue: 0,1:07:34.42,1:07:35.76,Default,,0,0,0,,Гриффит!
Dialogue: 0,1:07:42.51,1:07:43.76,Default,,0,0,0,,Хехе
Dialogue: 0,1:07:53.23,1:07:58.94,Default,,0,0,0,,Иә...мыңдаған, он мыңдаған дос пен дұшпанның арасында...
Dialogue: 0,1:07:59.70,1:08:02.45,Default,,0,0,0,,Тек сен...
Dialogue: 0,1:08:03.74,1:08:06.37,Default,,0,0,0,,Сіз маған армандарымды ұмыттырдыңыз ...
Dialogue: 0,1:08:16.71,1:08:18.13,Default,,0,0,0,,Арнау
Dialogue: 0,1:08:23.93,1:08:25.64,Default,,0,0,0,,Гриффит!
Dialogue: 0,1:08:30.56,1:08:32.98,Default,,0,0,0,,Таңертеңгі тұзақ құртты ұстайды. Оларды жеңелік.
Dialogue: 0,1:08:40.69,1:08:42.15,Default,,0,0,0,,Гриффит!
Dialogue: 0,1:08:48.99,1:08:53.00,Default,,0,0,0,,Себеп-салдар заңы бойынша бір-бірімен байланысқан жіптер...
Dialogue: 0,1:08:53.12,1:08:55.25,Default,,0,0,0,,Енді байланыстырылды...
Dialogue: 0,1:08:56.13,1:08:59.76,Default,,0,0,0,,Уәденің уақыты келді!
Dialogue: 0,1:09:33.96,1:09:34.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:39.46,1:09:45.18,Default,,0,0,0,,Қазір саған ойып жазылған нәрсе - құрбандықтың белгісі.
Dialogue: 0,1:09:45.47,1:09:51.35,Default,,0,0,0,,Оған жазылған адамның өмірі оның қанының соңғы тамшысы.
Dialogue: 0,1:09:51.56,1:09:56.65,Default,,0,0,0,,Тіпті қараңғылықтың жаңа баласының соңғы азабы...
Dialogue: 0,1:09:57.06,1:10:00.07,Default,,0,0,0,,Өмір азығы бол
Dialogue: 0,1:10:03.69,1:10:05.07,Default,,0,0,0,,Пипин! Жүгіріп кету!
Dialogue: 0,1:10:06.86,1:10:10.37,Default,,0,0,0,,Жүр! Қаш, қаш... Аман қалуың керек!
Dialogue: 0,1:10:10.70,1:10:11.62,Default,,0,0,0,,Не айтасыз...
Dialogue: 0,1:10:12.45,1:10:15.54,Default,,0,0,0,,Сіз не істеп жатырсыз? Жуданы босат! Пиппин!
Dialogue: 0,1:10:23.67,1:10:26.22,Default,,0,0,0,,Арқаңа көтер мені
Dialogue: 0,1:10:26.38,1:10:27.34,Default,,0,0,0,,Пипин!
Dialogue: 0,1:10:31.60,1:10:34.23,Default,,0,0,0,,Иуданы қайтар! Сіз оның өлуге рұқсат беруді жоспарлап отырсыз ба? ?
Dialogue: 0,1:10:34.39,1:10:38.44,Default,,0,0,0,,Жоқ! Сіз қазір біздің командирсіз.
Dialogue: 0,1:10:39.31,1:10:43.94,Default,,0,0,0,,Аман бол! Генерал аман қалғанша, «Сұңқар тобы» бітпейді.
Dialogue: 0,1:10:46.61,1:10:50.03,Default,,0,0,0,,Бұл біз үшін ақырғы болуы мүмкін бе?
Dialogue: 0,1:10:51.12,1:10:55.62,Default,,0,0,0,,Мен соңына дейін күресемін, күресемін және күресемін!
Dialogue: 0,1:11:23.02,1:11:25.36,Default,,0,0,0,,Бұл кездесу орны ма...
Dialogue: 0,1:11:26.07,1:11:27.32,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:11:36.41,1:11:38.46,Default,,0,0,0,,О, жоқ!
Dialogue: 0,1:11:40.04,1:11:41.00,Default,,0,0,0,,Га
Dialogue: 0,1:11:56.22,1:12:01.98,Default,,0,0,0,,Хмф, сіз қайтадан пайда болдыңыз ба? Мың жыл бойы өшімізді алған сенсің.
Dialogue: 0,1:12:02.10,1:12:05.69,Default,,0,0,0,,Мен бұл мүмкіндікті өткізіп жіберуге мүмкіндік жоқ деп ойладым.
Dialogue: 0,1:12:06.23,1:12:10.70,Default,,0,0,0,,Сен өлмейтін қақпашы болып тағайындалдың.
Dialogue: 0,1:12:11.20,1:12:14.16,Default,,0,0,0,,Түскі ас кезіндегі әбігерге қызықпаймын.
Dialogue: 0,1:12:14.33,1:12:17.70,Default,,0,0,0,,Білесің бе, ескі жау.
Dialogue: 0,1:12:17.91,1:12:20.12,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,1:12:24.92,1:12:26.38,Default,,0,0,0,,Капитан...
Dialogue: 0,1:12:30.67,1:12:32.55,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:12:33.34,1:12:34.47,Default,,0,0,0,,Гухаа
Dialogue: 0,1:12:44.81,1:12:47.40,Default,,0,0,0,,Ахаха... ахахха
Dialogue: 0,1:12:49.15,1:12:53.45,Default,,0,0,0,,Хи хи бұл арман... бұл міндетті түрде арман
Dialogue: 0,1:12:53.57,1:12:55.91,Default,,0,0,0,,Бұл жай ғана жаман түс
Dialogue: 0,1:12:56.03,1:12:59.04,Default,,0,0,0,,Мен кәдімгі бардан жаңа ғана ішіп алдым.
Dialogue: 0,1:12:59.16,1:13:02.41,Default,,0,0,0,,Біреу... мені тез оятуыңызды өтінемін.
Dialogue: 0,1:13:03.50,1:13:09.21,Default,,0,0,0,,Джудо Пиппин Рикерт Сіз сондасыз ба?
Dialogue: 0,1:13:09.63,1:13:12.42,Default,,0,0,0,,Эй... өтінемін!
Dialogue: 0,1:13:26.19,1:13:28.15,Default,,0,0,0,,Тозақта бір әйел бар...
Dialogue: 0,1:13:30.73,1:13:34.20,Default,,0,0,0,,Өтінемін, мені қазір оятпа...
Dialogue: 0,1:13:39.83,1:13:45.37,Default,,0,0,0,,Қарғыс атсын, неге мен? Ол... Қарғыс атсын.
Dialogue: 0,1:13:48.96,1:13:52.63,Default,,0,0,0,,Күте тұрыңыз, Гриффит! Мен сені қазір құтқарамын.
Dialogue: 0,1:13:58.05,1:13:59.60,Default,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,1:13:59.85,1:14:05.14,Default,,0,0,0,,Саған көмектескенім дұрыс емес. Бұл адамның өзі қалаған.
Dialogue: 0,1:14:05.60,1:14:10.11,Default,,0,0,0,,Сіз оны естідіңіз, мен сенімдімін...
Dialogue: 0,1:14:10.23,1:14:11.32,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,1:14:12.44,1:14:15.24,Default,,0,0,0,,Оның бұлай айтуы мүмкін емес!
Dialogue: 0,1:14:16.32,1:14:19.66,Default,,0,0,0,,Гриффит менікі... менікі!
Dialogue: 0,1:14:20.20,1:14:20.99,Default,,0,0,0,,Уау!
Dialogue: 0,1:14:23.04,1:14:24.00,Default,,0,0,0,,Яһудея
Dialogue: 0,1:14:32.13,1:14:33.01,Default,,0,0,0,,Дзюдо!
Dialogue: 0,1:14:37.93,1:14:40.43,Default,,0,0,0,,Жолдан кет, ақымақ! Осы қарқынмен сіз!
Dialogue: 0,1:14:40.85,1:14:41.81,Default,,0,0,0,,Аһ!
Dialogue: 0,1:14:45.35,1:14:46.69,Default,,0,0,0,,Неге...
Dialogue: 0,1:14:46.94,1:14:47.98,Default,,0,0,0,,Каска...
Dialogue: 0,1:14:51.52,1:14:53.53,Default,,0,0,0,,Уау
Dialogue: 0,1:14:59.28,1:15:01.24,Default,,0,0,0,,Менің пышағымды ұрдың ба?
Dialogue: 0,1:15:01.37,1:15:03.70,Default,,0,0,0,,Әй, маған тиді, өлтірдім.
Dialogue: 0,1:15:06.33,1:15:08.75,Default,,0,0,0,,Енді... кеттік.
Dialogue: 0,1:15:08.87,1:15:13.38,Default,,0,0,0,,Не айтып тұрсың! Соңына дейін күресемін деген сен едің!
Dialogue: 0,1:15:14.05,1:15:18.30,Default,,0,0,0,,Айтқаныңыз үшін жауапкершілікті алыңыз! Енді тұр!
Dialogue: 0,1:15:19.80,1:15:22.14,Default,,0,0,0,,Ішекке қарағанда, ол нәзік...
Dialogue: 0,1:15:22.26,1:15:23.89,Default,,0,0,0,,Аузыңды жаппа!
Dialogue: 0,1:15:25.10,1:15:27.10,Default,,0,0,0,,Бұл менің аузым ғана.
Dialogue: 0,1:15:27.23,1:15:29.14,Default,,0,0,0,,Аузыңызды мүлде қозғалтыңыз...
Dialogue: 0,1:15:29.27,1:15:30.81,Default,,0,0,0,,Шынымен...
Dialogue: 0,1:15:31.15,1:15:36.11,Default,,0,0,0,,Мен өзімді шебер адам деп ойладым...
Dialogue: 0,1:15:56.42,1:16:00.38,Default,,0,0,0,,Иуда... Жоқ, мен
Dialogue: 0,1:16:00.93,1:16:02.43,Default,,0,0,0,,(Апостолдың қатысуы)
Dialogue: 0,1:16:16.11,1:16:18.07,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:21.53,1:16:22.78,Default,,0,0,0,,Олардың аурасы ұқсас қой, иә? Олар әпкелер ме?
Dialogue: 0,1:17:12.91,1:17:16.34,Default,,0,0,0,,Бұл қай жерде...
Dialogue: 0,1:17:18.30,1:17:21.76,Default,,0,0,0,,Барлығының өлімі өтіп жатыр...
Dialogue: 0,1:17:25.68,1:17:29.68,Default,,0,0,0,,Біртүрлі, мен ештеңе сезбеймін...
Dialogue: 0,1:17:43.65,1:17:47.91,Default,,0,0,0,,Естеліктер төгіліп жатыр...
Dialogue: 0,1:18:11.01,1:18:15.06,Default,,0,0,0,,Неліктен... Неліктен адамдар...
Dialogue: 0,1:18:53.43,1:18:58.81,Default,,0,0,0,,Дұрыс, сондықтан мен...
Dialogue: 0,1:18:59.65,1:19:02.48,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,1:19:03.94,1:19:06.36,Default,,0,0,0,,(Апостолдың айқайы)
Dialogue: 0,1:19:09.49,1:19:10.20,Default,,0,0,0,,Гуах
Dialogue: 0,1:19:14.20,1:19:15.29,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,1:19:26.92,1:19:29.97,Default,,0,0,0,,Гуаа... аа!
Dialogue: 0,1:19:37.93,1:19:40.56,Default,,0,0,0,,(ішек жөтел)
Dialogue: 0,1:20:04.42,1:20:09.34,Default,,0,0,0,,Біреу жоқ па... Тірі адам жоқ па!
Dialogue: 0,1:20:10.76,1:20:12.22,Default,,0,0,0,,Каска!
Dialogue: 0,1:20:12.80,1:20:16.06,Default,,0,0,0,,Дзюдо! Пиппин! Коркас!
Dialogue: 0,1:20:17.06,1:20:19.73,Default,,0,0,0,,Команданы кес, жауап бер!
Dialogue: 0,1:20:37.83,1:20:38.95,Default,,0,0,0,,Гастон…
Dialogue: 0,1:20:47.55,1:20:48.67,Default,,0,0,0,,Пипин!
Dialogue: 0,1:21:00.27,1:21:04.02,Default,,0,0,0,,Пипин! Ол тірі болды ма? Пиппин
Dialogue: 0,1:21:06.44,1:21:09.40,Default,,0,0,0,,Гуфуфу…
Dialogue: 0,1:21:35.76,1:21:37.76,Default,,0,0,0,,Балалар...
Dialogue: 0,1:21:43.52,1:21:46.10,Default,,0,0,0,,Сіз!
Dialogue: 0,1:21:46.23,1:21:47.48,Default,,0,0,0,,Туу!
Dialogue: 0,1:21:47.61,1:21:49.44,Default,,0,0,0,,Бесінші бақытты патша
Dialogue: 0,1:21:49.57,1:21:52.57,Default,,0,0,0,,Жаңа жын патшасы
Dialogue: 0,1:21:52.69,1:21:58.78,Default,,0,0,0,,Артымыздан ерген жын есімді жаңа туыс.
Dialogue: 0,1:21:59.53,1:22:03.54,Default,,0,0,0,,Қараңғылық қанаттары Фемто
Dialogue: 0,1:22:08.79,1:22:11.55,Default,,0,0,0,,Гррр…
Dialogue: 0,1:22:35.32,1:22:38.82,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,1:22:58.80,1:22:59.84,Default,,0,0,0,,Гриффи…
Dialogue: 0,1:23:09.94,1:23:11.02,Default,,0,0,0,,Га
Dialogue: 0,1:23:39.01,1:23:40.09,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:50.56,1:23:51.73,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,1:23:52.11,1:23:52.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:01.11,1:24:03.58,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:24:21.09,1:24:23.43,Default,,0,0,0,,Gri... fiss?
Dialogue: 0,1:24:44.87,1:24:46.20,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:21.49,1:25:24.78,Default,,0,0,0,,Риппель Овердрайв Брэфордтың маңдайына жай ғана тиіп өтті ме?
Dialogue: 0,1:25:50.97,1:25:52.73,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,1:26:01.78,1:26:05.91,Default,,0,0,0,,Ақымақ адам не істей алады?
Dialogue: 0,1:26:06.28,1:26:09.99,Default,,0,0,0,,Ол қазірдің өзінде адамнан артық...
Dialogue: 0,1:26:10.12,1:26:11.04,Default,,0,0,0,,Ой
Dialogue: 0,1:26:21.55,1:26:22.80,Default,,0,0,0,,Аһ!
Dialogue: 0,1:26:26.55,1:26:28.55,Default,,0,0,0,,(Апостолдардың күлкісі)
Dialogue: 0,1:26:38.27,1:26:39.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:42.19,1:26:44.19,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,1:26:54.04,1:26:55.41,Default,,0,0,0,,Қарама...
Dialogue: 0,1:26:55.54,1:26:59.25,Default,,0,0,0,,Әдемі... жүрегімді елжіретеді
Dialogue: 0,1:26:59.88,1:27:02.09,Default,,0,0,0,,Махаббат жек көру...
Dialogue: 0,1:27:02.21,1:27:05.67,Default,,0,0,0,,Азап ләззат Өмір Өлім...
Dialogue: 0,1:27:05.84,1:27:07.43,Default,,0,0,0,,Онда бәрі бар
Dialogue: 0,1:27:07.80,1:27:11.51,Default,,0,0,0,,Мынау адам, мынау жын
Dialogue: 0,1:27:23.65,1:27:25.40,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:32.20,1:27:37.87,Default,,0,0,0,,Ооо!
Dialogue: 0,1:27:38.92,1:27:43.71,Default,,0,0,0,,(Ішектің айқайы)
Dialogue: 0,1:27:45.21,1:27:49.97,Default,,0,0,0,,(Ішектің айқайы)
Dialogue: 0,1:28:03.90,1:28:05.15,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,1:29:01.96,1:29:08.13,Default,,0,0,0,,Kyohoho… Қызық! бұл күтпеген жағдай
Dialogue: 0,1:29:08.76,1:29:14.39,Default,,0,0,0,,Ухуху... Бәрін көру мүмкін емес.
Dialogue: 0,1:29:14.55,1:29:18.35,Default,,0,0,0,,Өйткені біз де Құдай емеспіз...
Dialogue: 0,1:29:19.27,1:29:25.19,Default,,0,0,0,,Әлде Void, бұл да сіздің алдын ала белгіленген тағдырларыңыздың бірі ме?
Dialogue: 0,1:29:29.44,1:29:30.15,Default,,0,0,0,,Ах
Dialogue: 0,1:29:35.53,1:29:36.87,Default,,0,0,0,,Уау!
Dialogue: 0,1:29:43.25,1:29:45.29,Default,,0,0,0,,Каска! ? батыл! ?
Dialogue: 0,1:29:46.63,1:29:51.92,Default,,0,0,0,,Қалай болғанда да, уақыт өте бастады.
Dialogue: 0,1:29:52.67,1:29:57.47,Default,,0,0,0,,Бесінші періште дүниеге келді...
Dialogue: 0,1:29:57.97,1:30:01.27,Default,,0,0,0,,Қараңғылық мезгілі келеді
Dialogue: 0,1:30:01.89,1:30:06.60,Default,,0,0,0,,Барлық қараңғылық жарықтан асып түсетін уақыт
Dialogue: 0,1:30:07.19,1:30:10.36,Default,,0,0,0,,Кейінірек адамдар оны осылай атайтын
Dialogue: 0,1:30:11.19,1:30:14.45,Default,,0,0,0,,Зұлмат ғасырлар және
Dialogue: 0,1:30:44.31,1:30:47.02,Default,,0,0,0,,Бәрің қайда бара жатырсыңдар?
Dialogue: 0,1:30:47.85,1:30:50.98,Default,,0,0,0,,Дзюдо! Эй, тоқта!
Dialogue: 0,1:30:52.40,1:30:54.53,Default,,0,0,0,,Барма!
Dialogue: 0,1:30:57.32,1:30:59.20,Default,,0,0,0,,Коркас! Пиппин!
Dialogue: 0,1:31:01.45,1:31:04.00,Default,,0,0,0,,Жоқ! Артқа бұрыл!
Dialogue: 0,1:31:07.00,1:31:09.67,Default,,0,0,0,,Барма!
Dialogue: 0,1:31:45.54,1:31:46.41,Default,,0,0,0,,Уф...
Dialogue: 0,1:31:46.87,1:31:49.08,Default,,0,0,0,,Ішім! Сіз ояндыңыз.
Dialogue: 0,1:31:49.21,1:31:50.21,Default,,0,0,0,,Рикерт...?
Dialogue: 0,1:31:50.33,1:31:54.21,Default,,0,0,0,,Жақсы, мен жаман болады деп ойладым.
Dialogue: 0,1:31:54.38,1:31:57.34,Default,,0,0,0,,Төрт күн бойы мүлде қозғалмады...
Dialogue: 0,1:31:59.05,1:32:00.22,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:32:00.68,1:32:04.14,Default,,0,0,0,,Менің артымдағы тауда. Ол Кордо деп аталады.
Dialogue: 0,1:32:04.26,1:32:07.39,Default,,0,0,0,,Торнадо не болды?
Dialogue: 0,1:32:09.85,1:32:11.40,Default,,0,0,0,,Торнадо...?
Dialogue: 0,1:32:14.36,1:32:18.24,Default,,0,0,0,,Эй, Гриффитті құтқару не болды?
Dialogue: 0,1:32:18.74,1:32:21.49,Default,,0,0,0,,Қандай жарақат болды? Ал қалғандары ше?
Dialogue: 0,1:32:21.86,1:32:24.58,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,1:32:26.49,1:32:28.75,Default,,0,0,0,,Каска... Каска қайда!
Dialogue: 0,1:32:29.91,1:32:31.75,Default,,0,0,0,,Каска... Каска...
Dialogue: 0,1:32:32.25,1:32:35.09,Default,,0,0,0,,Каска-нечан сол жерде.
Dialogue: 0,1:32:58.86,1:32:59.99,Default,,0,0,0,,Каска...
Dialogue: 0,1:33:11.96,1:33:13.58,Default,,0,0,0,,Бұл менмін, Ішек.
Dialogue: 0,1:33:13.71,1:33:14.67,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:33:22.59,1:33:26.93,Default,,0,0,0,,Эй... қалжыңдама, бітті, Каска.
Dialogue: 0,1:33:27.64,1:33:30.47,Default,,0,0,0,,Біз ол жерден тірі қайттық! Каска
Dialogue: 0,1:33:31.39,1:33:32.31,Default,,0,0,0,,Гуах
Dialogue: 0,1:33:39.48,1:33:44.11,Default,,0,0,0,,Ей, сен қорқынышты жігітсің.
Dialogue: 0,1:33:44.61,1:33:48.37,Default,,0,0,0,,Жоқ, Ішек, сен Касканы қорлай алмайсың.
Dialogue: 0,1:33:50.29,1:33:52.00,Default,,0,0,0,,есімде жоқ.
Dialogue: 0,1:33:52.66,1:33:55.08,Default,,0,0,0,,Ішек туралы және мен туралы
Dialogue: 0,1:33:55.83,1:33:58.04,Default,,0,0,0,,Мен оянғаннан бері осылай болды.
Dialogue: 0,1:34:00.38,1:34:03.38,Default,,0,0,0,,Әй, балақай, жарайды...
Dialogue: 0,1:34:03.51,1:34:06.84,Default,,0,0,0,,А... а... а...
Dialogue: 0,1:34:07.09,1:34:09.22,Default,,0,0,0,,Иә... Балақай
Dialogue: 0,1:34:11.64,1:34:15.19,Default,,0,0,0,,(Касканың күлкісі)
Dialogue: 0,1:34:16.69,1:34:17.69,Default,,0,0,0,,Жаттығуға жарайды, білесің бе.
Dialogue: 0,1:34:18.27,1:34:18.94,Default,,0,0,0,,Сіз
Dialogue: 0,1:34:19.19,1:34:20.36,Default,,0,0,0,,Бұл сен кінәлі
Dialogue: 0,1:34:20.65,1:34:21.69,Default,,0,0,0,,Қылыштан шығыңыз!
Dialogue: 0,1:34:22.07,1:34:23.44,Default,,0,0,0,,Баркер…
Dialogue: 0,1:34:23.74,1:34:27.28,Default,,0,0,0,,(Касканың күлкісі)
Dialogue: 0,1:35:09.24,1:35:10.49,Default,,0,0,0,,Уау
Dialogue: 0,1:35:47.90,1:35:52.83,Default,,0,0,0,,Уау!
Dialogue: 0,1:36:39.37,1:36:42.75,Default,,0,0,0,,Көз... менің...
Dialogue: 0,1:36:49.59,1:36:50.63,Default,,0,0,0,,Не?
Dialogue: 0,1:36:53.47,1:36:56.68,Default,,0,0,0,,(Өлгендердің шуы)
Dialogue: 0,1:36:56.81,1:37:02.02,Default,,0,0,0,,Бұл бауыр... Бұл менікі Ни... Ние...
Dialogue: 0,1:37:32.88,1:37:33.84,Default,,0,0,0,,Ах
Dialogue: 0,1:37:38.26,1:37:39.22,Default,,0,0,0,,Дионы жеңуге арналған бұл сапар—
Dialogue: 0,1:37:40.68,1:37:41.73,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:37:43.89,1:37:45.77,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:48.15,1:37:51.69,Default,,0,0,0,,Мықты бол! Әйтпесе өлтіресің.
Dialogue: 0,1:37:59.58,1:38:05.42,Default,,0,0,0,,Құрбандық маркасы... қараңғыларды тартады.
Dialogue: 0,1:38:06.25,1:38:10.75,Default,,0,0,0,,Сіздің денеңіз, тіпті соңғы тамшы қаныңыз...
Dialogue: 0,1:38:11.09,1:38:15.43,Default,,0,0,0,,Мұның бәрі қараңғыға құрбандық.
Dialogue: 0,1:38:15.93,1:38:20.01,Default,,0,0,0,,Бұл таңбаланғандардың ережесі.
Dialogue: 0,1:38:32.48,1:38:34.78,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,1:38:46.21,1:38:48.38,Default,,0,0,0,,Күресетіндер...
Dialogue: 0,1:38:59.05,1:39:04.73,Default,,0,0,0,,Қысқасы, бұл соғыс. Әдеттегіден ештеңе өзгерген жоқ...
Dialogue: 0,1:39:05.43,1:39:06.31,Default,,0,0,0,,Ештеңе!
Dialogue: 0,1:39:06.69,1:39:08.48,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,1:39:11.82,1:39:14.86,Default,,0,0,0,,Бұл жолы Касканы өзіңізбен бірге алып кетуіңіз керек.
Dialogue: 0,1:39:17.15,1:39:20.03,Default,,0,0,0,,Ке! Хитокири ақымақ осында!
Dialogue: 0,1:39:22.16,1:39:26.33,Default,,0,0,0,,Егер сіз Гриффитпен тең болсаңыз, оның досы болсаңыз...
Dialogue: 0,1:39:29.12,1:39:30.88,Default,,0,0,0,,Мен жалғыз баруым керек
Dialogue: 0,1:40:05.87,1:40:07.25,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:40:08.37,1:40:12.04,Default,,0,0,0,,Кім жылап жатыр?
Dialogue: 0,1:40:18.88,1:40:20.13,Default,,0,0,0,,Көз жасы?
Dialogue: 0,1:40:22.18,1:40:24.30,Default,,0,0,0,,Мен оны тастадым ...
Dialogue: 0,1:40:26.93,1:40:28.60,Default,,0,0,0,,Соңғы...
Dialogue: 0,1:40:36.78,1:40:41.53,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,1:42:11.50,1:42:16.21,Default,,0,0,0,,♪~
Dialogue: 0,1:46:35.80,1:46:40.39,Default,,0,0,0,,~♪
Dialogue: 0,1:46:41.89,1:46:47.89,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory