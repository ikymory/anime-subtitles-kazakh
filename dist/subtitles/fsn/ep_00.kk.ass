Dialogue: 0,0:48:04.84,0:48:13.95,JPOP,,0000,0000,0000,,Жүрегімді өртеп жіберген үмітсіздіктің қасында
Dialogue: 0,0:48:15.23,0:48:25.40,JPOP,,0000,0000,0000,,Сіз маған әрқашан күлкі сыйладыңыз, ол бәрін жоғалтты.
Dialogue: 0,0:48:25.88,0:48:31.12,JPOP,,0000,0000,0000,,Батып кеткен дауыстар, жетпейтін сөздер
Dialogue: 0,0:48:31.24,0:48:40.80,JPOP,,0000,0000,0000,,Қайта сүрінгім келген сайын, қайта-қайта ұстадым.
Dialogue: 0,0:48:40.96,0:48:51.71,JPOP,,0000,0000,0000,,Ақ, ақ, таза ақ болашақ – жалғыз үмітіміз
Dialogue: 0,0:48:51.95,0:49:02.68,JPOP,,0000,0000,0000,,Қазір менде бар нәрсе - осы соқыр сезім.
Dialogue: 0,0:49:02.88,0:49:07.92,JPOP,,0000,0000,0000,,Бір дұрыс жауап жоқ
Dialogue: 0,0:49:08.24,0:49:17.06,JPOP,,0000,0000,0000,,Мен өз ертеңімді іздедім
Dialogue: 0,0:00:47.82,0:00:50.48,JPDB,,0000,0000,0000,,Қош келдіңіз, әке.
Dialogue: 0,0:00:57.21,0:00:58.60,JPDB,,0000,0000,0000,,Шу шығаруды тоқтатыңыз
Dialogue: 0,0:01:01.81,0:01:03.40,JPDB,,0000,0000,0000,,Не, қазірдің өзінде...
Dialogue: 0,0:01:03.88,0:01:07.66,JPDB,,0000,0000,0000,,Мен кеше кешке дейін жұмыс істедім, сондықтан сәл артық
Dialogue: 0,0:01:09.20,0:01:11.26,JPDB,,0000,0000,0000,,Ол енді икемді емес.
Dialogue: 0,0:01:38.66,0:01:40.16,JPDB,,0000,0000,0000,,Иә, кулон
Dialogue: 0,0:01:50.26,0:01:52.12,JPDB,,0000,0000,0000,,Бұл әлі басталған жоқ.
Dialogue: 0,0:01:52.41,0:01:54.26,JPDB,,0000,0000,0000,,Сақтықпен қателескен дұрыс па?
Dialogue: 0,0:02:22.24,0:02:25.78,JPDB,,0000,0000,0000,,Бұл не? Мен бірде-бір студентті көрмеймін.
Dialogue: 0,0:02:26.00,0:02:27.64,JPDB,,0000,0000,0000,,Тым тыныш.
Dialogue: 0,0:02:34.52,0:02:36.94,JPDB,,0000,0000,0000,,Осындай күндер бола ма?
Dialogue: 0,0:02:44.44,0:02:45.76,JPDB,,0000,0000,0000,,Сол Тохсака
Dialogue: 0,0:02:46.12,0:02:47.84,JPDB,,0000,0000,0000,,Бүгін таңертең ертерек.
Dialogue: 0,0:02:50.50,0:02:52.20,JPDB,,0000,0000,0000,,Ақырында солай болды ма?
Dialogue: 0,0:02:56.86,0:02:59.22,JPDB,,0000,0000,0000,,Қайырлы таң, бүгін тағы салқын.
Dialogue: 0,0:02:59.38,0:03:00.88,JPDB,,0000,0000,0000,,Қайырлы таң Мисузу-сан
Dialogue: 0,0:03:01.52,0:03:04.26,JPDB,,0000,0000,0000,,Мен көп сұрақ естимін, бірақ сағат неше екенін білесіз бе?
Dialogue: 0,0:03:05.76,0:03:07.68,JPDB,,0000,0000,0000,,Сағат 7-ге дейін нешеде?
Dialogue: 0,0:03:08.01,0:03:09.40,JPDB,,0000,0000,0000,,Тохсака Жартылай ұйықтап жатырсың ба?
Dialogue: 0,0:03:10.68,0:03:13.28,JPDB,,0000,0000,0000,,Менің сағатым бір сағат бұрын болған сияқты.
Dialogue: 0,0:03:13.53,0:03:14.92,JPDB,,0000,0000,0000,,Әрі қарай
Dialogue: 0,0:03:15.44,0:03:18.70,JPDB,,0000,0000,0000,,Оятқыш қана емес, қабырға сағаты да.
Dialogue: 0,0:03:20.38,0:03:24.98,JPDB,,0000,0000,0000,,Мен сол кулонды тапқанда, бұл шынымен әкемнің еңбегі ме?
Dialogue: 0,0:03:27.12,0:03:27.92,JPDB,,0000,0000,0000,,Тохсака?
Dialogue: 0,0:03:29.50,0:03:31.50,JPDB,,0000,0000,0000,,Мисзури бүгін де таңертең жаттығуда ма?
Dialogue: 0,0:03:31.80,0:03:34.24,JPDB,,0000,0000,0000,,Иә, бір жақсы адам кем.
Dialogue: 0,0:03:34.84,0:03:38.62,JPDB,,0000,0000,0000,,Жаңа студенттерді тартуға дайындық кезінде мен өзімді сәл жақсырақ көрсетуім керек.
Dialogue: 0,0:03:38.84,0:03:41.92,JPDB,,0000,0000,0000,,Капитан болу әрқашан стрессті тудырады.
Dialogue: 0,0:03:43.06,0:03:45.22,JPDB,,0000,0000,0000,,Мен таңғы жаттығуды қарастырамын.
Dialogue: 0,0:03:51.38,0:03:52.98,JPDB,,0000,0000,0000,,Сіз оған шынымен қарамайсыз ба?
Dialogue: 0,0:03:53.28,0:03:54.94,JPDB,,0000,0000,0000,,Көрсең де түсіне алмайтын нәрсе
Dialogue: 0,0:03:55.28,0:03:57.70,JPDB,,0000,0000,0000,,Оны алыстан көру өте жақсы.
Dialogue: 0,0:04:03.58,0:04:05.32,JPDB,,0000,0000,0000,,Қайырлы таң капитан
Dialogue: 0,0:04:05.85,0:04:07.82,JPDB,,0000,0000,0000,,Қайырлы таң Мату
Dialogue: 0,0:04:08.26,0:04:09.26,JPDB,,0000,0000,0000,,Бүгін таңертең жалғызсың ба?
Dialogue: 0,0:04:09.82,0:04:13.78,JPDB,,0000,0000,0000,,Иә, кешіріңіз, мен сізге көмектесе алмаймын.
Dialogue: 0,0:04:14.20,0:04:15.66,JPDB,,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:04:15.90,0:04:19.38,JPDB,,0000,0000,0000,,Егер адам мұны істегісі келмесе, оны мәжбүрлеудің мәні жоқ.
Dialogue: 0,0:04:19.76,0:04:21.32,JPDB,,0000,0000,0000,,Олай болса, кешіріңіз.
Dialogue: 0,0:04:21.68,0:04:23.34,JPDB,,0000,0000,0000,,Кездескенше, Мисузу-сан.
Dialogue: 0,0:04:23.97,0:04:26.14,JPDB,,0000,0000,0000,,Аа, көріскенше, Тохсака.
Dialogue: 0,0:04:27.50,0:04:29.72,JPDB,,0000,0000,0000,,Еңбек еткеніңе рахмет, Тохсақа-сенпай.
Dialogue: 0,0:04:32.58,0:04:35.08,JPDB,,0000,0000,0000,,Рахмет, шие гүлдері де жақсы.
Dialogue: 0,0:04:41.34,0:04:43.34,JPDB,,0000,0000,0000,,Сәлем Тохсака Қайырлы таң
Dialogue: 0,0:04:44.08,0:04:46.82,JPDB,,0000,0000,0000,,Таңертең сені көретінім керемет.
Dialogue: 0,0:04:47.94,0:04:51.52,JPDB,,0000,0000,0000,,Қайырлы таң, Синдзи Матоу, сен бүгін ертесің.
Dialogue: 0,0:04:51.60,0:04:54.14,JPDB,,0000,0000,0000,,Бұл табиғи, ол капитан.
Dialogue: 0,0:04:55.24,0:04:57.08,JPDB,,0000,0000,0000,,Директордың орынбасары шығар...
Dialogue: 0,0:04:57.46,0:04:58.12,JPDB,,0000,0000,0000,,Олай болса
Dialogue: 0,0:04:58.93,0:04:59.82,JPDB,,0000,0000,0000,,Бір минут күтіңіз.
Dialogue: 0,0:05:00.13,0:05:01.82,JPDB,,0000,0000,0000,,Таңертеңгілік жаттығуға назар аударыңыз
Dialogue: 0,0:05:01.96,0:05:03.20,JPDB,,0000,0000,0000,,Мен олай істемеймін.
Dialogue: 0,0:05:03.42,0:05:05.74,JPDB,,0000,0000,0000,,Таңертеңгілік жаттығуға кедергі келтіргіңіз келмейтін нәрселер
Dialogue: 0,0:05:05.97,0:05:07.76,JPDB,,0000,0000,0000,,Маған бұл маңызды емес.
Dialogue: 0,0:05:08.34,0:05:11.08,JPDB,,0000,0000,0000,,Сондықтан сіз араласқыңыз келмейді дейсіз.
Dialogue: 0,0:05:11.50,0:05:15.26,JPDB,,0000,0000,0000,,Мен садақ атуға аса қызықпаймын.
Dialogue: 0,0:05:15.84,0:05:17.26,JPDB,,0000,0000,0000,,Бұл не, Тохсақа?
Dialogue: 0,0:05:17.81,0:05:20.08,JPDB,,0000,0000,0000,,Садақ атуға қызықпадың ба?
Dialogue: 0,0:05:22.05,0:05:23.42,JPDB,,0000,0000,0000,,Мен қате түсіндім.
Dialogue: 0,0:05:23.62,0:05:27.16,JPDB,,0000,0000,0000,,Садақты жақсы көретіндіктен Тохсака сабақтан кейін маған келеді деп ойладым.
Dialogue: 0,0:05:27.64,0:05:31.30,JPDB,,0000,0000,0000,,Түсіндім, сенің мақсатың басқа еді.
Dialogue: 0,0:05:35.10,0:05:37.48,JPDB,,0000,0000,0000,,Мату-кун, мені тастап кете аласың ба?
Dialogue: 0,0:05:39.58,0:05:40.98,JPDB,,0000,0000,0000,,Жақсы Мату-кун
Dialogue: 0,0:05:41.66,0:05:46.56,JPDB,,0000,0000,0000,,Мен саған садақ атудан артық қызық емеспін деп жатырмын.
Dialogue: 0,0:05:47.16,0:05:51.16,JPDB,,0000,0000,0000,,Шындығында, мен сіздің полигонда екеніңізді алғаш рет білдім.
Dialogue: 0,0:05:51.49,0:05:53.52,JPDB,,0000,0000,0000,,Мен оны енді көрмейтініме сенімдімін.
Dialogue: 0,0:05:53.74,0:05:55.58,JPDB,,0000,0000,0000,,Не...не?
Dialogue: 0,0:05:55.74,0:05:57.84,JPDB,,0000,0000,0000,,Тохсака сен...
Dialogue: 0,0:05:58.32,0:06:00.48,JPDB,,0000,0000,0000,,Өзін-өзі шектен тыс санаға салу дұрыс емес.
Dialogue: 0,0:06:00.68,0:06:02.49,JPDB,,0000,0000,0000,,Оны қалыпты жағдайда ұстаған дұрыс.
Dialogue: 0,0:06:03.93,0:06:06.70,JPDB,,0000,0000,0000,,Бұл Тохсака-сан. Қайырлы таң.
Dialogue: 0,0:06:06.76,0:06:08.68,JPDB,,0000,0000,0000,,Қайырлы таң, Фуджимура мырза.
Dialogue: 0,0:06:16.81,0:06:17.74,JPDB,,0000,0000,0000,,Тохсака…
Dialogue: 0,0:06:18.48,0:06:20.18,JPDB,,0000,0000,0000,,О, студенттер кеңесінің төрағасы
Dialogue: 0,0:06:20.46,0:06:22.88,JPDB,,0000,0000,0000,,Сіз ерте таңертең мектеп ғимаратын патрульдейсіз бе?
Dialogue: 0,0:06:23.18,0:06:25.52,JPDB,,0000,0000,0000,,Немесе әрбір клуб бөлмесіне қамқорлық жасай аласыз ба?
Dialogue: 0,0:06:26.18,0:06:28.96,JPDB,,0000,0000,0000,,Екеуі де жақсы, бірақ бәрібір қызықсыз.
Dialogue: 0,0:06:30.24,0:06:32.76,JPDB,,0000,0000,0000,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:06:33.08,0:06:36.54,JPDB,,0000,0000,0000,,Сыныптан тыс іс-шараларды орындамай жатып, соншалықты ерте тұрғаныңыздың мәні неде?
Dialogue: 0,0:06:37.24,0:06:38.66,JPDB,,0000,0000,0000,,Жай ғана қыңырлық
Dialogue: 0,0:06:41.37,0:06:43.32,JPDB,,0000,0000,0000,,Казунари, жөндеу жұмыстары аяқталды.
Dialogue: 0,0:06:43.68,0:06:46.37,JPDB,,0000,0000,0000,,Сұраған мен болсам да.
Dialogue: 0,0:06:46.46,0:06:48.96,JPDB,,0000,0000,0000,,Барлығын Эмиияға тапсырғаным үшін кешіріңіз.
Dialogue: 0,0:06:49.16,0:06:52.16,JPDB,,0000,0000,0000,,Енді қайда? Уақытымыз көп емес.
Dialogue: 0,0:06:52.30,0:06:54.76,JPDB,,0000,0000,0000,,Ах, келесіде аудиовизуалды бөлме.
Dialogue: 0,0:06:54.94,0:06:57.14,JPDB,,0000,0000,0000,,Мен сіздің біраз уақыттан бері өзіңізді жақсы сезінбегеніңізді естідім.
Dialogue: 0,0:06:57.18,0:06:59.68,JPDB,,0000,0000,0000,,Ол ақыры өзінің табиғи өмірінің соңына жетті.
Dialogue: 0,0:07:00.10,0:07:02.56,JPDB,,0000,0000,0000,,Егер сіз табиғи өміріңізді өткізсеңіз, оны түзете алмайсыз.
Dialogue: 0,0:07:02.80,0:07:04.44,JPDB,,0000,0000,0000,,Оны қайтадан сатып алу жылдамырақ болар еді.
Dialogue: 0,0:07:04.62,0:07:07.84,JPDB,,0000,0000,0000,,Дұрыс, бірақ қарап шықсаңыз пайдалы болар еді.
Dialogue: 0,0:07:08.20,0:07:12.22,JPDB,,0000,0000,0000,,Менің көзқарасым бойынша, бұл өлім, бірақ сіздің көзқарасыңыз бойынша бұл жалған ауру болуы мүмкін.
Dialogue: 0,0:07:13.17,0:07:15.10,JPDB,,0000,0000,0000,,Олай болса, жасап көрейік
Dialogue: 0,0:07:19.66,0:07:22.22,JPDB,,0000,0000,0000,,Таң болды, Тохсақа.
Dialogue: 0,0:07:25.90,0:07:28.56,JPDB,,0000,0000,0000,,Сіз жай ғана сәлем айтқыңыз келді ме деп ойлаймын.
Dialogue: 0,0:07:48.00,0:07:49.64,JPDB,,0000,0000,0000,,А... анау Тохсака-сан.
Dialogue: 0,0:07:49.80,0:07:53.00,JPDB,,0000,0000,0000,,Қарсы болмасаңыз, менімен түскі ас ішуді қалайсыз ба?
Dialogue: 0,0:07:54.17,0:07:55.66,JPDB,,0000,0000,0000,,Рахмет, Саегуса-сан
Dialogue: 0,0:07:56.14,0:07:59.48,JPDB,,0000,0000,0000,,Бірақ кешіріңіз, мен бүгін мектеп асханасындамын.
Dialogue: 0,0:07:59.88,0:08:01.86,JPDB,,0000,0000,0000,,Мен бүгін таңертең артық ұйықтадым.
Dialogue: 0,0:08:02.42,0:08:04.02,JPDB,,0000,0000,0000,,О, солай ма?
Dialogue: 0,0:08:04.28,0:08:07.44,JPDB,,0000,0000,0000,,Кешіріңіз, мен сізді байқамай тоқтаттым.
Dialogue: 0,0:08:08.00,0:08:10.82,JPDB,,0000,0000,0000,,Бұған ренжімеңіз, маған қайта қоңырау шалыңыз.
Dialogue: 0,0:08:11.78,0:08:15.98,JPDB,,0000,0000,0000,,Иә, бірақ Тохсака-сан да кейде ұйықтап қалады.
Dialogue: 0,0:08:16.45,0:08:18.82,JPDB,,0000,0000,0000,,Негізі мен ұйқыға көмектесетін құралмын.
Dialogue: 0,0:08:19.25,0:08:22.34,JPDB,,0000,0000,0000,,Таңертең тұра алмайтындықтан үйірме жұмыстарына қатыспаймын.
Dialogue: 0,0:08:22.94,0:08:25.00,JPDB,,0000,0000,0000,,Олай болса, Саегуса мырза, уақытыңызды бөліңіз.
Dialogue: 0,0:08:25.29,0:08:26.98,JPDB,,0000,0000,0000,,Иә, Тохсака мырза да.
Dialogue: 0,0:08:28.16,0:08:30.44,JPDB,,0000,0000,0000,,О, сен мені тастадың, Юки-ччи.
Dialogue: 0,0:08:31.01,0:08:34.92,JPDB,,0000,0000,0000,,Сондықтан мен саған Тохсака түскі асын әкелмеді дедім.
Dialogue: 0,0:08:35.09,0:08:39.56,JPDB,,0000,0000,0000,,Мак: Біз жай ғана асханаға көшуіміз керек емес пе?
Dialogue: 0,0:08:40.56,0:08:43.92,JPDB,,0000,0000,0000,,Жоқ, жоқ, Тохсакамен бірге отырып көріңіз.
Dialogue: 0,0:08:44.06,0:08:46.70,JPDB,,0000,0000,0000,,Ер адамдар саған қараса неге тітіркендіреді?
Dialogue: 0,0:08:47.33,0:08:48.90,JPDB,,0000,0000,0000,,Бұл алдыңғы демалыс күні болатын.
Dialogue: 0,0:08:49.06,0:08:52.42,JPDB,,0000,0000,0000,,Екеуміз шықтық, тек ол ғана пайда көрді.
Dialogue: 0,0:08:52.58,0:08:57.14,JPDB,,0000,0000,0000,,Макиноджи Тосака ханым сіздің ғайбатыңызды естіп тұрған сияқты.
Dialogue: 0,0:09:02.52,0:09:04.90,JPDB,,0000,0000,0000,,Ол маған қатты қарап тұр.
Dialogue: 0,0:09:04.98,0:09:09.50,JPDB,,0000,0000,0000,,Эх, Тохсака-сан Маки-чанға жалт қараған жоқ деп ойлаймын.
Dialogue: 0,0:09:09.76,0:09:11.04,JPDB,,0000,0000,0000,,Ол маған қарап тұрды.
Dialogue: 0,0:09:11.28,0:09:13.90,JPDB,,0000,0000,0000,,Ол күліп тұрғанда ең қорқынышты.
Dialogue: 0,0:09:14.30,0:09:15.88,JPDB,,0000,0000,0000,,Бұл жақсы, тек шағымдану.
Dialogue: 0,0:09:15.96,0:09:19.30,JPDB,,0000,0000,0000,,Сабыр ет, мен сені тайякимен емдейтін едім.
Dialogue: 0,0:09:32.30,0:09:35.08,JPDB,,0000,0000,0000,,Әкеңнің өсиетін асыға күттім.
Dialogue: 0,0:09:36.04,0:09:41.20,JPDB,,0000,0000,0000,,Кеше түнде жертөледен әкемнің заттары мен бір қиын басқатырғыш табылды.
Dialogue: 0,0:09:42.45,0:09:44.00,JPDB,,0000,0000,0000,,Егер сіз оны ашуға қиналсаңыз,
Dialogue: 0,0:09:44.93,0:09:49.42,JPDB,,0000,0000,0000,,Шыққан нәрсе сынған катализатор және мына кулон болып көрінді.
Dialogue: 0,0:09:50.36,0:09:53.34,JPDB,,0000,0000,0000,,Не керек, үйдегі сағаттар есінен танады.
Dialogue: 0,0:09:58.02,0:10:00.26,JPDB,,0000,0000,0000,,Бұл өз алдына таң қалдырады.
Dialogue: 0,0:10:00.68,0:10:04.68,JPDB,,0000,0000,0000,,Ең күшті қызметші Саберді шақыру бекер, солай ма?
Dialogue: 0,0:10:06.29,0:10:10.46,JPDB,,0000,0000,0000,,Діни қызметкердің мәліметі бойынша, тек екі Ұстаз қалды.
Dialogue: 0,0:10:11.16,0:10:13.02,JPDB,,0000,0000,0000,,Уайымдауға уақытыңыз бар ма?
Dialogue: 0,0:10:37.64,0:10:43.38,JPDB,,0000,0000,0000,,31 қаңтар 15:21-дегі хабарлама
Dialogue: 0,0:10:44.46,0:10:45.44,JPDB,,0000,0000,0000,,Екі күн бұрын банк тонаған жігіт енді автобусты ұрлап кетті.
Dialogue: 0,0:10:46.54,0:10:50.20,JPDB,,0000,0000,0000,,Менің ойымша, сен білесің, бірақ мерзімі ертең, Рин.
Dialogue: 0,0:10:51.18,0:10:54.10,JPDB,,0000,0000,0000,,Егер сіз өз позицияңызды тым баяу ұстанатын болсаңыз, бұл мәселе болады.
Dialogue: 0,0:10:54.64,0:10:59.66,JPDB,,0000,0000,0000,,Бар болғаны екі орын қалды, садақшы және қылыш сыныптары.
Dialogue: 0,0:11:00.33,0:11:02.86,JPDB,,0000,0000,0000,,Тезірек магистрлер болуы керек
Dialogue: 0,0:11:03.88,0:11:07.24,JPDB,,0000,0000,0000,,Қызметшіні тез шақырып, бұйрық заклинасын ашыңыз.
Dialogue: 0,0:11:07.80,0:11:13.44,JPDB,,0000,0000,0000,,Алайда, егер сіз Қасиетті Граил соғысына қатысқыңыз келмесе, бұл басқа әңгіме.
Dialogue: 0,0:11:14.16,0:11:17.12,JPDB,,0000,0000,0000,,Өміріңді жоғалтқың келмесе, тезірек шіркеуге қосыл...
Dialogue: 0,0:11:19.72,0:11:21.76,JPDB,,0000,0000,0000,,Айтпасаң да білемін.
Dialogue: 0,0:11:41.92,0:11:43.08,JPDB,,0000,0000,0000,,Дайын
Dialogue: 0,0:11:43.71,0:11:44.88,JPDB,,0000,0000,0000,,Жақсы уақыт
Dialogue: 0,0:11:45.68,0:11:47.06,JPDB,,0000,0000,0000,,Жақсы толқын ұзындығы
Dialogue: 0,0:11:48.11,0:11:52.14,JPDB,,0000,0000,0000,,Менің сиқырлы күшімнің шыңына жеткенде сағат 2-де шақыру арқылы.
Dialogue: 0,0:11:52.22,0:11:55.04,JPDB,,0000,0000,0000,,Саберді катализаторсыз алыңыз
Dialogue: 0,0:12:03.22,0:12:04.84,JPDB,,0000,0000,0000,,Негізінде күміс пен темір
Dialogue: 0,0:12:05.31,0:12:07.68,JPDB,,0000,0000,0000,,Негіз тасы және Келісім Ұлы Герцог
Dialogue: 0,0:12:08.39,0:12:11.16,JPDB,,0000,0000,0000,,Менің ата-бабам – қожайыным Швайорг.
Dialogue: 0,0:12:11.96,0:12:17.48,JPDB,,0000,0000,0000,,Төрт қақпаны жауып, тәжден шығып, патшалыққа апаратын үш жақты жолды айналып өт.
Dialogue: 0,0:12:18.74,0:12:23.96,JPDB,,0000,0000,0000,,қанағаттандыру, қанағаттандыру, қанағаттандыру, қанағаттандыру, қанағаттандыру
Dialogue: 0,0:12:25.11,0:12:26.58,JPDB,,0000,0000,0000,,Бес рет қайталаңыз
Dialogue: 0,0:12:27.24,0:12:29.42,JPDB,,0000,0000,0000,,Тек орындалу уақытын жойыңыз
Dialogue: 0,0:12:30.11,0:12:30.70,JPDB,,0000,0000,0000,,Жиын
Dialogue: 0,0:12:31.94,0:12:32.74,JPDB,,0000,0000,0000,,айт
Dialogue: 0,0:12:33.58,0:12:37.62,JPDB,,0000,0000,0000,,Денең менің астымда, тағдырым сенің қылышыңның астында.
Dialogue: 0,0:12:38.86,0:12:40.52,JPDB,,0000,0000,0000,,Қасиетті Граил жақындаған соң
Dialogue: 0,0:12:40.76,0:12:43.36,JPDB,,0000,0000,0000,,Бұл мағына Осы принципті ұстанатын болсаңыз, жауап беріңіз.
Dialogue: 0,0:12:44.83,0:12:46.06,JPDB,,0000,0000,0000,,Ант
Dialogue: 0,0:12:46.63,0:12:48.96,JPDB,,0000,0000,0000,,Мен мәңгілікте барлық жақсылыққа айналатын адаммын.
Dialogue: 0,0:12:49.67,0:12:52.14,JPDB,,0000,0000,0000,,Мәңгілік дүниеде барлық зұлымдықты тудырушы менмін.
Dialogue: 0,0:12:53.14,0:12:55.54,JPDB,,0000,0000,0000,,Рухтың үш ұлы сөзін киген жеті аспансың.
Dialogue: 0,0:12:56.02,0:12:57.50,JPDB,,0000,0000,0000,,Тоқтау шеңберінен келіңіз
Dialogue: 0,0:12:57.92,0:12:59.66,JPDB,,0000,0000,0000,,Таразыны сақтаушы
Dialogue: 0,0:13:12.95,0:13:17.06,JPDB,,0000,0000,0000,,Керемет Мен ең күшті картаны алдым.
Dialogue: 0,0:13:18.14,0:13:18.60,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:22.35,0:13:23.70,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:13:24.28,0:13:25.72,JPDB,,0000,0000,0000,,Есік сынған
Dialogue: 0,0:13:26.27,0:13:27.40,JPDB,,0000,0000,0000,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:13:45.96,0:13:49.80,JPDB,,0000,0000,0000,,Егер есімде дұрыс болса, менің сағатым бүгін бір сағат ерте болды.
Dialogue: 0,0:13:50.79,0:13:54.36,JPDB,,0000,0000,0000,,Демек, түнгі 2 емес, түнгі 1.00.
Dialogue: 0,0:13:55.10,0:13:56.82,JPDB,,0000,0000,0000,,Мен мұны қайтадан жасадым
Dialogue: 0,0:13:57.23,0:13:59.04,JPDB,,0000,0000,0000,,Мен істеген ісіме қатысты ештеңе істей алмаймын.
Dialogue: 0,0:14:00.08,0:14:02.74,JPDB,,0000,0000,0000,,Бірақ әке, үй тапсырмасы қандай?
Dialogue: 0,0:14:04.66,0:14:06.84,JPDB,,0000,0000,0000,,Сонда сен кімсің?
Dialogue: 0,0:14:07.24,0:14:09.04,JPDB,,0000,0000,0000,,Бұл ашу ма?
Dialogue: 0,0:14:09.40,0:14:13.16,JPDB,,0000,0000,0000,,Бұл тағы бір керемет шеберге тағайындалды.
Dialogue: 0,0:14:13.40,0:14:16.74,JPDB,,0000,0000,0000,,Мен нашар лотереяны ұтып алдым деп ойлаймын.
Dialogue: 0,0:14:18.35,0:14:22.38,JPDB,,0000,0000,0000,,Тек растау үшін, сіз менің қызметшім екеніңізге сенімдісіз бе?
Dialogue: 0,0:14:23.20,0:14:25.54,JPDB,,0000,0000,0000,,Сіз менің қожайынымсыз ба?
Dialogue: 0,0:14:25.88,0:14:28.60,JPDB,,0000,0000,0000,,Мені шақырған кезде ол жерде болмас па еді
Dialogue: 0,0:14:28.86,0:14:30.44,JPDB,,0000,0000,0000,,Бұл құстың баласы емес.
Dialogue: 0,0:14:30.50,0:14:34.92,JPDB,,0000,0000,0000,,Кім екеніңді тек көзіңді ашқанда шеше аламын деп әзілдеуді доғар.
Dialogue: 0,0:14:35.70,0:14:36.90,JPDB,,0000,0000,0000,,Толық түсінгенім жоқ, бірақ—
Dialogue: 0,0:14:37.62,0:14:39.50,JPDB,,0000,0000,0000,,Менің сұрайын дегенім
Dialogue: 0,0:14:39.67,0:14:43.86,JPDB,,0000,0000,0000,,Менің білетінім, сен менің қызметшімсің, басқа ешкім емессің.
Dialogue: 0,0:14:44.44,0:14:47.90,JPDB,,0000,0000,0000,,Қожайын мен қызметші арасындағы қарым-қатынас ең басында анық болуы керек.
Dialogue: 0,0:14:48.22,0:14:51.28,JPDB,,0000,0000,0000,,Иә, мен бұл пікірмен келісемін.
Dialogue: 0,0:14:51.62,0:14:56.16,JPDB,,0000,0000,0000,,Бірақ сенің менің қожайыным екендігіңнің дәлелі қайда?
Dialogue: 0,0:14:57.43,0:14:58.20,JPDB,,0000,0000,0000,,Осы мектепті бітіру – шеберліктің дәлелі.
Dialogue: 0,0:14:58.66,0:15:01.30,JPDB,,0000,0000,0000,,Бұл сіздің шебер екеніңіздің дәлелі.
Dialogue: 0,0:15:04.23,0:15:05.26,JPDB,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:15:05.55,0:15:07.70,JPDB,,0000,0000,0000,,Сіз байсалдысыз ба, жас ханым?
Dialogue: 0,0:15:08.28,0:15:11.92,JPDB,,0000,0000,0000,,Менің көргім келгені жай ғана мұндай нәрсе емес еді.
Dialogue: 0,0:15:12.19,0:15:15.90,JPDB,,0000,0000,0000,,Менің адалдығыма лайықсың ба деген сұрақ болды.
Dialogue: 0,0:15:16.38,0:15:19.70,JPDB,,0000,0000,0000,,Сонымен, мен шеберлік құқығынан айырылдым ба?
Dialogue: 0,0:15:20.72,0:15:25.08,JPDB,,0000,0000,0000,,Жоқ, мен мүлдем риза емеспін, бірақ мен сізді өзімнің қожайыным деп қабылдаймын.
Dialogue: 0,0:15:25.55,0:15:27.84,JPDB,,0000,0000,0000,,Дегенмен менің де шарттарым бар.
Dialogue: 0,0:15:28.42,0:15:31.30,JPDB,,0000,0000,0000,,Мен енді сіздің бұйрықтарыңызды орындамаймын.
Dialogue: 0,0:15:31.51,0:15:33.44,JPDB,,0000,0000,0000,,Соғыс саясатын мен шешемін.
Dialogue: 0,0:15:34.22,0:15:36.34,JPDB,,0000,0000,0000,,Жарайсың, жас ханым.
Dialogue: 0,0:15:38.19,0:15:39.34,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:15:39.87,0:15:41.94,JPDB,,0000,0000,0000,,Мен наразымын, бірақ мойындаймын.
Dialogue: 0,0:15:42.02,0:15:45.52,JPDB,,0000,0000,0000,,Сіз не айтасыз, мен сіздің пікіріңізбен келіспеймін?
Dialogue: 0,0:15:46.19,0:15:48.36,JPDB,,0000,0000,0000,,Сен менің қызметшімсің, солай ма?
Dialogue: 0,0:15:48.80,0:15:50.96,JPDB,,0000,0000,0000,,Ах, тек формада.
Dialogue: 0,0:15:51.38,0:15:54.26,JPDB,,0000,0000,0000,,Сондықтан ресми түрде мен сізге еремін.
Dialogue: 0,0:15:54.62,0:15:57.30,JPDB,,0000,0000,0000,,Бірақ мен төбелесіп жатырмын.
Dialogue: 0,0:15:57.84,0:16:00.00,JPDB,,0000,0000,0000,,Осы үйдің жертөлесіне тығылуға болады.
Dialogue: 0,0:16:00.07,0:16:02.66,JPDB,,0000,0000,0000,,Қасиетті Граил соғысы аяқталғанша қозғалмай тұрыңыз.
Dialogue: 0,0:16:03.27,0:16:06.72,JPDB,,0000,0000,0000,,Ондай жағдайда тәжірибесіз болсаң да, өмірің сақталады.
Dialogue: 0,0:16:08.94,0:16:10.50,JPDB,,0000,0000,0000,,Мен сені ашуландырдым ба?
Dialogue: 0,0:16:10.64,0:16:13.58,JPDB,,0000,0000,0000,,Жоқ, әрине мен сіздің ұстанымыңызды құрметтеймін.
Dialogue: 0,0:16:14.00,0:16:17.48,JPDB,,0000,0000,0000,,Өйткені мен Мастердің жеңіске жетуіне көмектесуге шақырылған адаммын.
Dialogue: 0,0:16:18.34,0:16:20.28,JPDB,,0000,0000,0000,,Менің жеңісім сенікі
Dialogue: 0,0:16:20.51,0:16:23.36,JPDB,,0000,0000,0000,,Мен саған шайқаста алғанымның бәрін беремін.
Dialogue: 0,0:16:23.64,0:16:25.78,JPDB,,0000,0000,0000,,Сонда шағымданатын ештеңе жоқ.
Dialogue: 0,0:16:26.12,0:16:28.80,JPDB,,0000,0000,0000,,Ал, қалғанын маған қалдыр.
Dialogue: 0,0:16:29.00,0:16:31.28,JPDB,,0000,0000,0000,,Өз қауіпсіздігіңізді ойлаңыз
Dialogue: 0,0:16:32.12,0:16:34.54,JPDB,,0000,0000,0000,,Мен сенен ештеңе қаламаймын
Dialogue: 0,0:16:34.78,0:16:37.82,JPDB,,0000,0000,0000,,Ау, ауа райы жылы!
Dialogue: 0,0:16:38.92,0:16:42.12,JPDB,,0000,0000,0000,,Жарайды, көп айтсаң, неге қолданбасқа?
Dialogue: 0,0:16:42.35,0:16:43.00,JPDB,,0000,0000,0000,,Анфанг
Dialogue: 0,0:16:43.07,0:16:44.26,JPDB,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:16:44.44,0:16:45.74,JPDB,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:16:46.07,0:16:47.66,JPDB,,0000,0000,0000,,Бұл құрметсіздік
Dialogue: 0,0:16:48.06,0:16:48.96,JPDB,,0000,0000,0000,,Vertrag…
Dialogue: 0,0:16:49.11,0:16:50.54,JPDB,,0000,0000,0000,,Эйн нойер Нагель
Dialogue: 0,0:16:50.63,0:16:51.76,JPDB - UP,,0000,0000,0000,,Ein neues Gesetz
Dialogue: 0,0:16:50.96,0:16:52.46,JPDB,,0000,0000,0000,,Тоқта, есі дұрыс па, ұстаз?
Dialogue: 0,0:16:51.94,0:16:53.50,JPDB - UP,,0000,0000,0000,,Ein neues Gesetz
Dialogue: 0,0:16:52.82,0:16:54.76,JPDB,,0000,0000,0000,,Бір нәрсе үшін пәрмен емлесін пайдаланатын адам...
Dialogue: 0,0:16:53.54,0:16:55.48,JPDB - UP,,0000,0000,0000,,Ein neues Verbrechen
Dialogue: 0,0:16:55.60,0:16:56.64,JPDB,,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:16:56.94,0:16:59.46,JPDB,,0000,0000,0000,,Жақсы, сен менің қызметшімсің.
Dialogue: 0,0:16:59.60,0:17:03.58,JPDB,,0000,0000,0000,,Олай болса, менің бұйрықтарымды мүлде орындауың керек.
Dialogue: 0,0:17:10.54,0:17:12.64,JPDB,,0000,0000,0000,,Немесе... сізде ештеңе жоқ.
Dialogue: 0,0:17:13.15,0:17:15.78,JPDB,,0000,0000,0000,,Бұндай өрескел нәрсеге пәрмен емлесін қолдану.
Dialogue: 0,0:17:17.54,0:17:21.30,JPDB,,0000,0000,0000,,Мен...Орын ауыстырып жатырмын. Маған жазыл.
Dialogue: 0,0:17:33.76,0:17:34.62,JPDB,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:17:35.06,0:17:37.82,JPDB,,0000,0000,0000,,Мен сіздің табиғатыңызды түсінемін, ұстаз.
Dialogue: 0,0:17:38.67,0:17:40.06,JPDB,,0000,0000,0000,,Мен сенімді болу үшін сұраймын.
Dialogue: 0,0:17:40.72,0:17:44.00,JPDB,,0000,0000,0000,,Бұйрық жазуларының қаншалықты маңызды екенін түсінесіз бе?
Dialogue: 0,0:17:45.34,0:17:46.96,JPDB,,0000,0000,0000,,Жоғарыдан не қарап тұрсың?
Dialogue: 0,0:17:47.40,0:17:49.94,JPDB,,0000,0000,0000,,Бұл жерде абсолютті бағыну дегеніміз не?
Dialogue: 0,0:17:50.68,0:17:53.90,JPDB,,0000,0000,0000,,Бұл қызметшілерді басқаратын үш реттік командалық құқық.
Dialogue: 0,0:17:53.98,0:17:55.18,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:17:56.71,0:17:57.68,JPDB,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:17:58.38,0:18:01.88,JPDB,,0000,0000,0000,,Командалық сиқырлар қызметшілерді әрекет етуге мәжбүр етеді.
Dialogue: 0,0:18:02.23,0:18:07.12,JPDB,,0000,0000,0000,,Мысалы, мен бұл жерден алыс жерге бірден саяхаттай алмаймын.
Dialogue: 0,0:18:07.50,0:18:09.92,JPDB,,0000,0000,0000,,Бірақ егер мен сізге командалық заклинаниемен жүруді бұйырсам,
Dialogue: 0,0:18:10.18,0:18:13.06,JPDB,,0000,0000,0000,,Бұл сенің және менің сиқырымыздың арқасында мүмкін.
Dialogue: 0,0:18:13.78,0:18:17.44,JPDB,,0000,0000,0000,,Физикалық дененің шегін де жеңе алатын керемет сиқырдың кристалы.
Dialogue: 0,0:18:17.52,0:18:18.92,JPDB,,0000,0000,0000,,Үш команда емлесі.
Dialogue: 0,0:18:19.43,0:18:22.48,JPDB,,0000,0000,0000,,Енді екіге қалды.
Dialogue: 0,0:18:23.11,0:18:25.04,JPDB,,0000,0000,0000,,Мен мұны білемін.
Dialogue: 0,0:18:25.50,0:18:28.02,JPDB,,0000,0000,0000,,Жарайды, әлі екеуі қалды.
Dialogue: 0,0:18:28.27,0:18:31.28,JPDB,,0000,0000,0000,,Саған берген ережелерім бекер болған жоқ.
Dialogue: 0,0:18:32.55,0:18:35.26,JPDB,,0000,0000,0000,,Шынында да, бұл менің тарапымнан қате есеп болды.
Dialogue: 0,0:18:36.07,0:18:39.40,JPDB,,0000,0000,0000,,Пәрмен емлесі анық емес пәрмендерге қарсы тиімді емес.
Dialogue: 0,0:18:39.86,0:18:42.60,JPDB,,0000,0000,0000,,Сіздің бұрынғы пәрмен емлесі дәл солай.
Dialogue: 0,0:18:43.75,0:18:46.30,JPDB,,0000,0000,0000,,Барлық сөздер мен істерге абсолютті бағыну және т.б.
Dialogue: 0,0:18:46.48,0:18:48.86,JPDB,,0000,0000,0000,,Жүз командалық заклинание болса да, оны жүзеге асыру мүмкін емес.
Dialogue: 0,0:18:50.26,0:18:53.62,JPDB,,0000,0000,0000,,Сонымен, бұл менің алдыңғы пәрмен емлесі мағынасыз дегенді білдіре ме?
Dialogue: 0,0:18:54.71,0:18:56.64,JPDB,,0000,0000,0000,,Әдетте,
Dialogue: 0,0:18:57.18,0:19:01.46,JPDB,,0000,0000,0000,,Сіздің сиқыршы ретіндегі жұмысыңыз басқа дәрежеде сияқты.
Dialogue: 0,0:19:01.96,0:19:03.30,JPDB,,0000,0000,0000,,Қате цифр?
Dialogue: 0,0:19:03.62,0:19:05.92,JPDB,,0000,0000,0000,,Аа, қате есептеу деген осы.
Dialogue: 0,0:19:06.58,0:19:10.42,JPDB,,0000,0000,0000,,Дәл қазір сіздің сөздеріңізден қатты мәжбүрлік сезініп тұрмын.
Dialogue: 0,0:19:10.82,0:19:11.92,JPDB,,0000,0000,0000,,Бұл мәселе.
Dialogue: 0,0:19:12.35,0:19:14.36,JPDB,,0000,0000,0000,,Міне, солай.
Dialogue: 0,0:19:15.39,0:19:17.62,JPDB,,0000,0000,0000,,Бұрынғы сөзімді қайтарып алуға рұқсат етіңіз, ұстаз.
Dialogue: 0,0:19:18.59,0:19:22.18,JPDB,,0000,0000,0000,,Жас болсаң да, көрнекті сиқыршысың.
Dialogue: 0,0:19:22.87,0:19:28.24,JPDB,,0000,0000,0000,,Баланы менсінбей, ұрыстан аулақ ұстауға тырысқаным менің қателігім болды.
Dialogue: 0,0:19:29.74,0:19:31.52,JPDB,,0000,0000,0000,,Дөрекі болғанымыз үшін кешірім сұрайық.
Dialogue: 0,0:19:33.78,0:19:37.64,JPDB,,0000,0000,0000,,Олай болса, менің командалық заклинаниесіз шебер екенімді мойындайсың.
Dialogue: 0,0:19:38.46,0:19:39.22,JPDB,,0000,0000,0000,,Әрине.
Dialogue: 0,0:19:40.11,0:19:43.24,JPDB,,0000,0000,0000,,Мені бұрын ғана шақырды, сондықтан мен оған үйренбедім.
Dialogue: 0,0:19:43.70,0:19:45.58,JPDB,,0000,0000,0000,,Енді толық қосылды
Dialogue: 0,0:19:46.27,0:19:50.62,JPDB,,0000,0000,0000,,Егер сіз сиқыршы болсаңыз, сіз өзіңізді келісім-шарт арқылы байланыстыратын шығарсыз.
Dialogue: 0,0:19:58.56,0:19:59.42,JPDB,,0000,0000,0000,,Шарт…
Dialogue: 0,0:20:00.19,0:20:03.54,JPDB,,0000,0000,0000,,Түсіндім, қызметшілер Қасиетті Граилға шақырылады.
Dialogue: 0,0:20:03.66,0:20:06.12,JPDB,,0000,0000,0000,,Шақырылған қызметшіні бұл дүниеде не ұстап тұрады?
Dialogue: 0,0:20:06.44,0:20:08.76,JPDB,,0000,0000,0000,,Иә, шебердің құдіреті.
Dialogue: 0,0:20:09.42,0:20:13.52,JPDB,,0000,0000,0000,,Қызметшілер қожайындарынан сиқырлы күш беру арқылы осы дүниеде қалады.
Dialogue: 0,0:20:14.34,0:20:16.86,JPDB,,0000,0000,0000,,Сіз беретін сиқырлы күштің мөлшері жеткілікті.
Dialogue: 0,0:20:17.76,0:20:20.46,JPDB,,0000,0000,0000,,Сіз сөзсіз жоғары деңгейдесіз.
Dialogue: 0,0:20:23.40,0:20:26.00,JPDB,,0000,0000,0000,,Мен сені қазір мақтасам да, одан ештеңе шықпайды.
Dialogue: 0,0:20:29.24,0:20:31.28,JPDB,,0000,0000,0000,,Сіз Сабер емессіз бе?
Dialogue: 0,0:20:32.43,0:20:34.66,JPDB,,0000,0000,0000,,Өкінішке орай, менде қылыш жоқ.
Dialogue: 0,0:20:35.30,0:20:36.92,JPDB,,0000,0000,0000,,Бұл Арчер дегенді білдіреді.
Dialogue: 0,0:20:37.23,0:20:38.58,JPDB,,0000,0000,0000,,Мен абдырап қалдым.
Dialogue: 0,0:20:38.90,0:20:42.16,JPDB,,0000,0000,0000,,Қалайша сіз осы асыл тастарды пайдаланып, әлі де Сабер бола алмайсыз?
Dialogue: 0,0:20:42.70,0:20:45.02,JPDB,,0000,0000,0000,,Өкініштісі, Сабер емес еді.
Dialogue: 0,0:20:46.76,0:20:51.36,JPDB,,0000,0000,0000,,Бұл өкінішті қате, бірақ бұл менің кінәм.
Dialogue: 0,0:20:52.98,0:20:55.10,JPDB,,0000,0000,0000,,Мен сені жаман сөздерің үшін дәл қазір өкінемін.
Dialogue: 0,0:20:55.58,0:20:58.40,JPDB,,0000,0000,0000,,Сол кезде кешірім сұрасаң да тыңдамайды.
Dialogue: 0,0:21:08.67,0:21:12.56,JPDB,,0000,0000,0000,,Олай болса, мені өкіндіретініне көз жеткіз, Арчер.
Dialogue: 0,0:21:13.14,0:21:15.98,JPDB,,0000,0000,0000,,Егер бұлай болса, мен шын жүректен кешірім сұраймын.
Dialogue: 0,0:21:16.74,0:21:19.34,JPDB,,0000,0000,0000,,Әй, ұмытпа, ұстаз.
Dialogue: 0,0:21:36.16,0:21:38.82,JPDB,,0000,0000,0000,,Иә, мен оны әлі естіген жоқпын.
Dialogue: 0,0:21:38.94,0:21:40.76,JPDB,,0000,0000,0000,,Сіз қай батырлық рухсыз?
Dialogue: 0,0:21:43.50,0:21:44.26,JPDB,,0000,0000,0000,,Садақшы?
Dialogue: 0,0:21:46.54,0:21:49.68,JPDB,,0000,0000,0000,,Мен қандай адам болғаныма жауап бере алмаймын.
Dialogue: 0,0:21:50.50,0:21:53.16,JPDB,,0000,0000,0000,,Неге екенін өзім де білмеймін.
Dialogue: 0,0:21:53.47,0:21:57.74,JPDB,,0000,0000,0000,,Иә? Не, сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:21:58.51,0:22:00.44,JPDB,,0000,0000,0000,,Мен қожайынға тіл тигізгім келмейді.
Dialogue: 0,0:22:00.99,0:22:03.28,JPDB,,0000,0000,0000,,Бұл сіздің толық емес шақыруыңызға арналған.
Dialogue: 0,0:22:03.90,0:22:05.42,JPDB,,0000,0000,0000,,Жадтағы шатасу
Dialogue: 0,0:22:06.02,0:22:07.96,JPDB,,0000,0000,0000,,Аты мен тұлғасы анық емес
Dialogue: 0,0:22:08.42,0:22:11.46,JPDB,,0000,0000,0000,,Бұл өте маңызды қате емес.
Dialogue: 0,0:22:11.58,0:22:13.44,JPDB,,0000,0000,0000,,Бұл алаңдайтын нәрсе емес.
Dialogue: 0,0:22:14.07,0:22:15.92,JPDB,,0000,0000,0000,,Маған бұл маңызды емес.
Dialogue: 0,0:22:16.12,0:22:18.06,JPDB,,0000,0000,0000,,Мен сенің қандай батырлық рухты екеніңді білуім керек.
Dialogue: 0,0:22:18.10,0:22:20.00,JPDB,,0000,0000,0000,,Өзіңнің қаншалықты күшті екеніңді білмейсің.
Dialogue: 0,0:22:20.22,0:22:22.24,JPDB,,0000,0000,0000,,Бұл тривиальды сұрақ.
Dialogue: 0,0:22:22.32,0:22:23.90,JPDB,,0000,0000,0000,,Тривиальды нәрсе сізсіз.
Dialogue: 0,0:22:24.16,0:22:27.96,JPDB,,0000,0000,0000,,Егер сіз серіктесіңіздің күшін білмесеңіз, стратегияны жоспарлауға мүмкіндік жоқ.
Dialogue: 0,0:22:28.95,0:22:29.88,JPDB,,0000,0000,0000,,Не айту керек
Dialogue: 0,0:22:30.19,0:22:32.48,JPDB,,0000,0000,0000,,Мен сен шақырған қызметшімін.
Dialogue: 0,0:22:32.96,0:22:34.82,JPDB,,0000,0000,0000,,Бұл ең күшті емес
Dialogue: 0,0:22:38.32,0:22:39.50,JPDB,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:22:39.87,0:22:43.32,JPDB,,0000,0000,0000,,Сіздің кім екеніңізді ешкім білмейтіні белгілі.
Dialogue: 0,0:22:44.07,0:22:47.36,JPDB,,0000,0000,0000,,Біраз уақыт сіздің жеке басыңызға күмән келтірмейік.
Dialogue: 0,0:22:47.98,0:22:50.64,JPDB,,0000,0000,0000,,Олай болса, Арчер, бұл сенің бірінші жұмысың.
Dialogue: 0,0:22:51.10,0:22:54.10,JPDB,,0000,0000,0000,,Сіз өте ұрыссыз.
Dialogue: 0,0:22:54.79,0:22:55.90,JPDB,,0000,0000,0000,,Сонымен жау...
Dialogue: 0,0:22:58.66,0:22:59.80,JPDB,,0000,0000,0000,,Қонақ бөлмені тазалау
Dialogue: 0,0:23:00.23,0:23:03.64,JPDB,,0000,0000,0000,,Сіз тәртіпсіздік жасадыңыз, сондықтан жауапкершілікті алып, тазалаңыз.
Dialogue: 0,0:23:04.23,0:23:07.46,JPDB,,0000,0000,0000,,Күте тұрыңыз, қызметші қандай деп ойлайсыз?
Dialogue: 0,0:23:07.58,0:23:08.66,JPDB,,0000,0000,0000,,Бұл таныс, солай ма?
Dialogue: 0,0:23:08.98,0:23:11.56,JPDB,,0000,0000,0000,,Бұл аздап ыңғайсыз және оны өңдеу қиын.
Dialogue: 0,0:23:13.59,0:23:14.90,JPDB,,0000,0000,0000,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:23:15.20,0:23:16.86,JPDB,,0000,0000,0000,,Тозаққа барыңыз, ұстаз
Dialogue: 0,0:23:29.08,0:23:36.36,JPDB,,0000,0000,0000,,Әке, мен он жыл күткен шайқас басталғалы тұр.
Dialogue: 0,0:23:38.10,0:23:41.54,JPDB,,0000,0000,0000,,Менің қасиетті гриль соғысым...
Dialogue: 0,0:23:54.82,0:23:56.84,JPDB,,0000,0000,0000,,Бұл кешіктіру туралы емес.
Dialogue: 0,0:23:57.56,0:23:58.94,JPDB,,0000,0000,0000,,Бүгін тынығып алайық
Dialogue: 0,0:24:05.36,0:24:09.26,JPDB,,0000,0000,0000,,Мен Саберді емес, Арчерді шақырдым.
Dialogue: 0,0:24:09.60,0:24:13.98,JPDB,,0000,0000,0000,,Және сіздің кім екеніңізді білмеу қосымша бонусымен.
Dialogue: 0,0:24:15.74,0:24:18.18,JPDB,,0000,0000,0000,,Кенет бірдеңе басымды ауырта бастады.
Dialogue: 0,0:24:22.06,0:24:22.96,JPDB,,0000,0000,0000,,Шаршау сезімі
Dialogue: 0,0:24:23.62,0:24:26.14,JPDB,,0000,0000,0000,,Сиқырлы күш шақыру арқылы алынды ма?
Dialogue: 0,0:24:33.38,0:24:36.78,JPDB,,0000,0000,0000,,Уау, мен мұны қайта қарастырған болармын.
Dialogue: 0,0:24:37.51,0:24:39.26,JPDB,,0000,0000,0000,,Күн шықты.
Dialogue: 0,0:24:40.62,0:24:43.86,JPDB,,0000,0000,0000,,Сіз де тым жалқаусыз.
Dialogue: 0,0:24:53.23,0:24:54.04,JPDB,,0000,0000,0000,,Дәмді...
Dialogue: 0,0:24:56.26,0:24:57.86,JPDB,,0000,0000,0000,,Неге күлесің?
Dialogue: 0,0:24:58.52,0:25:01.68,JPDB,,0000,0000,0000,,Оның орнына сіз өзіңіздің шынайы болмысыңызды еске түсірдіңіз.
Dialogue: 0,0:25:02.15,0:25:02.70,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:25:03.30,0:25:04.22,JPDB,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:25:04.60,0:25:08.04,JPDB,,0000,0000,0000,,Есіңізде болса, мен онымен күресудің жолдарын ойластырамын.
Dialogue: 0,0:25:08.70,0:25:10.42,JPDB,,0000,0000,0000,,Садақшы шығуға дайындал
Dialogue: 0,0:25:10.78,0:25:12.44,JPDB,,0000,0000,0000,,Мен саған қаланы көрсетемін.
Dialogue: 0,0:25:14.30,0:25:15.50,JPDB,,0000,0000,0000,,Оған дейін шебер
Dialogue: 0,0:25:15.95,0:25:18.70,JPDB,,0000,0000,0000,,Маңызды нәрсені ұмытып жатырсыз ба?
Dialogue: 0,0:25:19.10,0:25:21.50,JPDB,,0000,0000,0000,,Не маңызды?
Dialogue: 0,0:25:21.87,0:25:28.12,JPDB,,0000,0000,0000,,Шынында да, сэр, біз келісімшарттағы ең маңызды алмасуды әлі жасаған жоқпыз.
Dialogue: 0,0:25:28.47,0:25:31.82,JPDB,,0000,0000,0000,,Шарттағы ең маңызды алмасу
Dialogue: 0,0:25:32.00,0:25:35.30,JPDB,,0000,0000,0000,,Сіз шынымен таңертең әлсізсіз.
Dialogue: 0,0:25:35.64,0:25:38.30,JPDB,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:25:40.07,0:25:42.04,JPDB,,0000,0000,0000,,Менің атым...
Dialogue: 0,0:25:42.47,0:25:43.70,JPDB,,0000,0000,0000,,Сіз оны таптың ба?
Dialogue: 0,0:25:44.12,0:25:46.82,JPDB,,0000,0000,0000,,Олай болса, ұстаз, мен сізді бұдан былай қалай атайын?
Dialogue: 0,0:25:48.80,0:25:50.80,JPDB,,0000,0000,0000,,Мен Рин Тохсакамын.
Dialogue: 0,0:25:51.51,0:25:53.36,JPDB,,0000,0000,0000,,Сіз маған қалағаныңызша қоңырау шала аласыз.
Dialogue: 0,0:25:54.63,0:25:56.14,JPDB,,0000,0000,0000,,Олай болса, Ринто
Dialogue: 0,0:25:56.60,0:25:59.60,JPDB,,0000,0000,0000,,А, бұл дыбыс сізге шынымен жарасады.
Dialogue: 0,0:26:42.84,0:26:44.66,JPDB,,0000,0000,0000,,Бұл синтоизм саябағы.
Dialogue: 0,0:26:45.40,0:26:49.00,JPDB,,0000,0000,0000,,Енді негізгі орындарды аралап шыққан соң, қалай ойлайсың?
Dialogue: 0,0:26:49.96,0:26:51.22,JPDB,,0000,0000,0000,,Бұл үлкен саябақ.
Dialogue: 0,0:26:51.46,0:26:55.22,JPDB,,0000,0000,0000,,Оның танымал болмауының себебі бар ма?
Dialogue: 0,0:26:55.76,0:26:57.02,JPDB,,0000,0000,0000,,Бұл шынымен де солай ма?
Dialogue: 0,0:26:57.66,0:27:00.42,JPDB,,0000,0000,0000,,Бұл жерде бір ауыз сөз бар.
Dialogue: 0,0:27:00.96,0:27:05.70,JPDB,,0000,0000,0000,,Осыдан он жыл бұрын осы ауданда үлкен өрт болған.
Dialogue: 0,0:27:06.38,0:27:10.12,JPDB,,0000,0000,0000,,Содан бері қала қайта салынды, бірақ бұл бөлігі сол күйінде қалды.
Dialogue: 0,0:27:11.16,0:27:15.00,JPDB,,0000,0000,0000,,Өртенген аймаққа айналдырған, ештеңе қалмаған сияқты, саябаққа айналдырған.
Dialogue: 0,0:27:16.78,0:27:18.12,JPDB,,0000,0000,0000,,Сіз байқаған сияқтысыз.
Dialogue: 0,0:27:18.64,0:27:22.86,JPDB,,0000,0000,0000,,Иә, осы жерде соңғы Қасиетті Граил соғысы аяқталды.
Dialogue: 0,0:27:23.78,0:27:27.50,JPDB,,0000,0000,0000,,Соңғы Қасиетті Граил соғысы осында аяқталды, міне, осымен аяқталды.
Dialogue: 0,0:27:28.22,0:27:29.12,JPDB,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:27:29.36,0:27:33.04,JPDB,,0000,0000,0000,,Сонда бұл жер кекке толы?
Dialogue: 0,0:27:34.96,0:27:36.42,JPDB,,0000,0000,0000,,Түсіндің бе?
Dialogue: 0,0:27:37.16,0:27:38.90,JPDB,,0000,0000,0000,,Қызметші – рухани дене.
Dialogue: 0,0:27:39.56,0:27:42.44,JPDB,,0000,0000,0000,,Мұндай болмыс өшпенділік пен адасуға жақын.
Dialogue: 0,0:27:43.04,0:27:45.62,JPDB,,0000,0000,0000,,Сондықтан мен де сол өкініштерге сезімталмын.
Dialogue: 0,0:27:46.20,0:27:47.72,JPDB,,0000,0000,0000,,Бұл әсіресе ерекше.
Dialogue: 0,0:27:48.24,0:27:50.76,JPDB,,0000,0000,0000,,Біздің көзқарасымыз бойынша, ол бірегей тосқауылға ұқсас.
Dialogue: 0,0:27:52.98,0:27:54.30,JPDB,,0000,0000,0000,,Рин, не болды?
Dialogue: 0,0:27:55.34,0:27:57.88,JPDB,,0000,0000,0000,,Бұл аздап таң қалдырды.
Dialogue: 0,0:27:58.36,0:27:59.74,JPDB,,0000,0000,0000,,Бұл ерекше кедергі.
Dialogue: 0,0:27:59.90,0:28:02.78,JPDB,,0000,0000,0000,,Сіз садақшы болсаңыз да, әдеттен тыс сөздерді білесіз.
Dialogue: 0,0:28:03.16,0:28:05.32,JPDB,,0000,0000,0000,,Не, білу қызық па?
Dialogue: 0,0:28:05.60,0:28:06.70,JPDB,,0000,0000,0000,,Өйткені олай емес.
Dialogue: 0,0:28:07.24,0:28:08.92,JPDB,,0000,0000,0000,,Бірегей тосқауыл дегеніміз не?
Dialogue: 0,0:28:09.08,0:28:13.88,JPDB,,0000,0000,0000,,Сиқыршы үшін бұл тыйымдар арасында тыйым, жұмбақ арасында жұмбақ.
Dialogue: 0,0:28:14.48,0:28:17.30,JPDB,,0000,0000,0000,,Садақшы, мұны білу ақылға сыймайды.
Dialogue: 0,0:28:18.82,0:28:19.40,JPDB,,0000,0000,0000,,Рин
Dialogue: 0,0:28:20.00,0:28:23.28,JPDB,,0000,0000,0000,,Батыр - қылыш шеберлігі мен сиқыршылыққа шебер адам.
Dialogue: 0,0:28:23.80,0:28:27.32,JPDB,,0000,0000,0000,,Садақшы болғандықтан ғана садақпен айналысуға болады деп ойлау өзімшілдік.
Dialogue: 0,0:28:27.78,0:28:31.00,JPDB,,0000,0000,0000,,Менен басқа қызметшілерге бұлай оптимист болма.
Dialogue: 0,0:28:32.42,0:28:34.18,JPDB,,0000,0000,0000,,Мен...түсіндім.
Dialogue: 0,0:28:34.50,0:28:36.58,JPDB,,0000,0000,0000,,Бұл ойланбастан айтылған сөз болды.
Dialogue: 0,0:28:36.90,0:28:40.26,JPDB,,0000,0000,0000,,Келесі жолы мұқият боламын, жарай ма?
Dialogue: 0,0:28:40.48,0:28:41.98,JPDB,,0000,0000,0000,,Рин, тура сөзге көшейік.
Dialogue: 0,0:28:42.42,0:28:46.70,JPDB,,0000,0000,0000,,Сіз өте жақсысыз, бірақ сол себепті сізде басқаларды бағаламау кемшілігі бар.
Dialogue: 0,0:28:47.00,0:28:48.86,JPDB,,0000,0000,0000,,Ересек жасқа жеткенге дейін түзетіңіз
Dialogue: 0,0:28:48.98,0:28:50.56,JPDB,,0000,0000,0000,,Кё... Түзету?
Dialogue: 0,0:28:50.76,0:28:53.20,JPDB,,0000,0000,0000,,Сіз дөрекі нәрсе айтасыз.
Dialogue: 0,0:28:53.38,0:28:54.60,JPDB,,0000,0000,0000,,Жоқ, кешіріңіз.
Dialogue: 0,0:28:55.38,0:28:58.16,JPDB,,0000,0000,0000,,Мен Ринді арамза деп айтпаймын.
Dialogue: 0,0:28:58.84,0:29:02.02,JPDB,,0000,0000,0000,,Сіз жаңа ғана елестеткен өрнекті қолдандыңыз ба?
Dialogue: 0,0:29:02.88,0:29:04.16,JPDB,,0000,0000,0000,,Одан да сорақы.
Dialogue: 0,0:29:04.22,0:29:04.60,JPDB,,0000,0000,0000,,Ауырсыну...
Dialogue: 0,0:29:06.12,0:29:06.54,JPDB,,0000,0000,0000,,Рин?
Dialogue: 0,0:29:06.84,0:29:09.56,JPDB,,0000,0000,0000,,Садақшы, үндеме, командалық заклинание әрекет етуде...
Dialogue: 0,0:29:10.24,0:29:12.46,JPDB,,0000,0000,0000,,Мен оны жақын жерде бақылап жатқанына сенімдімін.
Dialogue: 0,0:29:13.34,0:29:14.82,JPDB,,0000,0000,0000,,Мен оны таба алмаймын
Dialogue: 0,0:29:15.00,0:29:16.28,JPDB,,0000,0000,0000,,Садақшы Сіз ше?
Dialogue: 0,0:29:16.40,0:29:19.54,JPDB,,0000,0000,0000,,Бұл қиын. Маған сенің көздеріңді де сезбеймін.
Dialogue: 0,0:29:20.54,0:29:23.02,JPDB,,0000,0000,0000,,Олай болса, қарап тұрған – қожайын.
Dialogue: 0,0:29:23.60,0:29:24.58,JPDB,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,0:29:25.06,0:29:28.04,JPDB,,0000,0000,0000,,Сонымен, бұл орынды хабарлаудың жақсы жолы ма?
Dialogue: 0,0:29:28.42,0:29:29.48,JPDB,,0000,0000,0000,,Менің ойымша
Dialogue: 0,0:29:29.98,0:29:32.74,JPDB,,0000,0000,0000,,Бірақ бұл мені сонда бару қиындығынан құтқарады.
Dialogue: 0,0:29:42.58,0:29:45.17,JPDB,,0000,0000,0000,,Бұл жерде болжам жақсы, солай ма?
Dialogue: 0,0:29:48.65,0:29:52.57,JPDB,,0000,0000,0000,,Егер мен мұнда басынан бері келсем, қыдырмас едім.
Dialogue: 0,0:29:53.08,0:29:54.25,JPDB,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:29:54.73,0:29:57.48,JPDB,,0000,0000,0000,,Бұл жерден көруге болатын нәрсе қаланың жай ғана панорамалық көрінісі емес.
Dialogue: 0,0:29:57.96,0:30:01.26,JPDB,,0000,0000,0000,,Қаланың қалай салынғанын сол жерге бармайынша түсінбейсіз.
Dialogue: 0,0:30:01.73,0:30:03.08,JPDB,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,0:30:03.74,0:30:05.76,JPDB,,0000,0000,0000,,Садақшы сыныбы жай әзіл емес.
Dialogue: 0,0:30:06.74,0:30:08.84,JPDB,,0000,0000,0000,,Садақшылар нәтижелі болу үшін жақсы көруі керек.
Dialogue: 0,0:30:09.74,0:30:10.46,JPDB,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:30:11.26,0:30:13.88,JPDB,,0000,0000,0000,,Сіз сол көпірдегі плиткалардың санын көре аласыз.
Dialogue: 0,0:30:14.38,0:30:18.02,JPDB,,0000,0000,0000,,Таң қалдырыңыз, Арчер шынымен де садақшы.
Dialogue: 0,0:30:19.06,0:30:24.40,JPDB,,0000,0000,0000,,Рин Мен олай ойламаймын, бірақ сен мені мазақ етіп тұрған жоқсың деп ойлаймын.
Dialogue: 0,0:30:24.88,0:30:26.44,JPDB,,0000,0000,0000,,Бұл мүлде мүмкін емес
Dialogue: 0,0:30:32.34,0:30:33.98,JPDB,,0000,0000,0000,,Мен ол екеніне сенімдімін.
Dialogue: 0,0:30:34.32,0:30:36.18,JPDB,,0000,0000,0000,,Рин Жауды таптың ба?
Dialogue: 0,0:30:36.62,0:30:38.78,JPDB,,0000,0000,0000,,Жай ғана таныс
Dialogue: 0,0:30:39.14,0:30:41.58,JPDB,,0000,0000,0000,,Оның бізге, қарапайым халыққа қатысы жоқ.
Dialogue: 0,0:30:42.02,0:30:43.76,JPDB,,0000,0000,0000,,Мен бір нәрсені сұрауды ұмытып кетіппін.
Dialogue: 0,0:30:44.06,0:30:44.66,JPDB,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:30:45.25,0:30:49.34,JPDB,,0000,0000,0000,,Рин, сен кішкентай кезіңнен шеберлікке тәрбиелендің.
Dialogue: 0,0:30:49.68,0:30:51.72,JPDB,,0000,0000,0000,,Менің ойымша, ол соны орындады.
Dialogue: 0,0:30:52.40,0:30:53.10,JPDB,,0000,0000,0000,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:30:53.64,0:30:58.38,JPDB,,0000,0000,0000,,Тохсака халқы үшін Қасиетті Граил ұрпақтар үшін асыл тілек болды.
Dialogue: 0,0:30:58.68,0:31:01.24,JPDB,,0000,0000,0000,,Онда әлдеқашан мақсат болуы керек.
Dialogue: 0,0:31:01.90,0:31:05.80,JPDB,,0000,0000,0000,,Жаратқанның не қалайтынын білмесем, қылышымды сеніп тапсыра алмаймын.
Dialogue: 0,0:31:06.28,0:31:08.66,JPDB,,0000,0000,0000,,Рин, сенің тілегің қандай?
Dialogue: 0,0:31:09.10,0:31:09.88,JPDB,,0000,0000,0000,,Тілек
Dialogue: 0,0:31:10.21,0:31:11.86,JPDB,,0000,0000,0000,,Ондай ештеңе жоқ.
Dialogue: 0,0:31:11.98,0:31:12.58,JPDB,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:31:13.44,0:31:14.70,JPDB,,0000,0000,0000,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:31:15.62,0:31:18.64,JPDB,,0000,0000,0000,,Қасиетті Граил - тілектерді орындайтын құдіретті тостаған.
Dialogue: 0,0:31:19.25,0:31:21.56,JPDB,,0000,0000,0000,,Бұл шынайы әлемді басқаруға мүмкіндік беретін күш.
Dialogue: 0,0:31:22.02,0:31:24.54,JPDB,,0000,0000,0000,,Өйткені дүниені бағындыру – машақат.
Dialogue: 0,0:31:24.85,0:31:27.78,JPDB,,0000,0000,0000,,Бұндай пайдасыз нәрсені тілеуден пайда жоқ.
Dialogue: 0,0:31:28.12,0:31:29.62,JPDB,,0000,0000,0000,,Түсіну қиын емес
Dialogue: 0,0:31:30.22,0:31:31.92,JPDB,,0000,0000,0000,,Сонымен біз не үшін күресеміз?
Dialogue: 0,0:31:33.26,0:31:36.40,JPDB,,0000,0000,0000,,Бұл жерде төбелес болып жатыр, Арчер.
Dialogue: 0,0:31:36.58,0:31:38.20,JPDB,,0000,0000,0000,,Яғни, сіз
Dialogue: 0,0:31:38.98,0:31:41.90,JPDB,,0000,0000,0000,,Иә, мен тек жеңіс үшін күресемін.
Dialogue: 0,0:31:44.01,0:31:44.98,JPDB,,0000,0000,0000,,Бұл болды
Dialogue: 0,0:31:45.48,0:31:48.52,JPDB,,0000,0000,0000,,Сіз менің қожайыным болуға лайықсыз.
Dialogue: 0,0:31:49.16,0:31:51.42,JPDB,,0000,0000,0000,,Сіз ең мықты шеберсіз.
Dialogue: 0,0:31:52.04,0:31:54.94,JPDB,,0000,0000,0000,,Қызмет көрсететін адам жоқ.
Dialogue: 0,0:31:55.68,0:31:56.14,JPDB,,0000,0000,0000,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:32:20.40,0:32:22.26,JPDB,,0000,0000,0000,,Рин, сен не жасырып тұрсың?
Dialogue: 0,0:32:22.62,0:32:23.74,JPDB,,0000,0000,0000,,Бір-біріңді білесіңдер ме?
Dialogue: 0,0:32:24.82,0:32:28.26,JPDB,,0000,0000,0000,,Мен бүгін мектепке бармадым, сондықтан сені көргім келмейді.
Dialogue: 0,0:32:52.36,0:32:54.14,JPDB,,0000,0000,0000,,Кирей, бұл менмін.
Dialogue: 0,0:32:55.28,0:32:57.18,JPDB,,0000,0000,0000,,Өйткені мен кеше Арчермен келісімшарт жасастым.
Dialogue: 0,0:32:57.48,0:32:59.36,JPDB,,0000,0000,0000,,Шебер ретінде ресми тіркелуіңізді сұраймыз
Dialogue: 0,0:32:59.77,0:33:00.56,JPDB,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:33:01.05,0:33:02.12,JPDB,,0000,0000,0000,,Сонда ше?
Dialogue: 0,0:33:02.74,0:33:05.34,JPDB,,0000,0000,0000,,Неге бетіңізді бір рет көрсетпейсіз?
Dialogue: 0,0:33:05.72,0:33:08.44,JPDB,,0000,0000,0000,,Кейбір нәрселер ата-анаңда қалады.
Dialogue: 0,0:33:09.20,0:33:11.22,JPDB,,0000,0000,0000,,Бұл әкемнің өсиеті.
Dialogue: 0,0:33:11.93,0:33:14.68,JPDB,,0000,0000,0000,,Ал, мен оны шешіп, алдым.
Dialogue: 0,0:33:15.52,0:33:18.64,JPDB,,0000,0000,0000,,Олай болса, қаласам саған қонаққа келемін.
Dialogue: 0,0:33:18.98,0:33:19.84,JPDB,,0000,0000,0000,,Күте тұрыңыз...
Dialogue: 0,0:33:22.80,0:33:24.04,JPDB,,0000,0000,0000,,Сен мектепке барасың ба?
Dialogue: 0,0:33:24.36,0:33:26.88,JPDB,,0000,0000,0000,,Иә, мәселе бар ма?
Dialogue: 0,0:33:27.53,0:33:28.64,JPDB,,0000,0000,0000,,Мәселе жоқ, бірақ
Dialogue: 0,0:33:29.00,0:33:32.54,JPDB,,0000,0000,0000,,Мектеп – күтпеген шабуылдарға дайындалу қиын болатын жер.
Dialogue: 0,0:33:33.12,0:33:36.32,JPDB,,0000,0000,0000,,Шеберлер арасындағы төбелес – жұртшылықтың назарынан тыс қалмау керек нәрсе.
Dialogue: 0,0:33:36.76,0:33:41.70,JPDB,,0000,0000,0000,,Бұл жағдайда, егер сіз адамдар сізді көретін мектепте болсаңыз, таң қалмайсыз деп ойлаймын.
Dialogue: 0,0:33:42.08,0:33:47.02,JPDB,,0000,0000,0000,,Қауіпсіз жерде жау болса, не істер едің?
Dialogue: 0,0:33:47.57,0:33:48.86,JPDB,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:33:49.36,0:33:53.62,JPDB,,0000,0000,0000,,Бұл қалада бір ғана сиқыршы отбасы бар, ол Тохсака.
Dialogue: 0,0:33:54.29,0:33:58.52,JPDB,,0000,0000,0000,,Бір жанұя құлдырап, шебер атанбаған.
Dialogue: 0,0:34:00.34,0:34:03.76,JPDB,,0000,0000,0000,,Рин мектебінде тағы бір сиқыршы бар.
Dialogue: 0,0:34:04.17,0:34:08.14,JPDB,,0000,0000,0000,,Бірақ шебер болу үшін сиқырлы күшіңіз болмаса.
Dialogue: 0,0:34:08.68,0:34:09.64,JPDB,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:34:10.09,0:34:13.32,JPDB,,0000,0000,0000,,Бірақ Рин, барлығында ерекшелік бар.
Dialogue: 0,0:34:14.14,0:34:18.34,JPDB,,0000,0000,0000,,Мектепте сіз танымайтын сиқыршы болса ше?
Dialogue: 0,0:34:31.73,0:34:34.18,JPDB,,0000,0000,0000,,Ауа тоқырау сияқты емес.
Dialogue: 0,0:34:34.64,0:34:36.72,JPDB,,0000,0000,0000,,Бұл бөгет енді жоқ.
Dialogue: 0,0:34:37.62,0:34:41.36,JPDB,,0000,0000,0000,,Толық болмаса да, дайындық басталып кеткен сияқты.
Dialogue: 0,0:34:42.34,0:34:45.68,JPDB,,0000,0000,0000,,Оның соншалықты жарқыраған әрекеті оның шынымен де үлкен мәміле болуы керек екенін білдіреді.
Dialogue: 0,0:34:46.13,0:34:47.82,JPDB,,0000,0000,0000,,Сіз сондай әуесқойсыз.
Dialogue: 0,0:34:48.41,0:34:51.42,JPDB,,0000,0000,0000,,Басқаларды әдеттен тыс сезінуге әкелетін кедергі үшінші дәрежелі.
Dialogue: 0,0:34:52.00,0:34:55.86,JPDB,,0000,0000,0000,,Егер сіз мұны істегіңіз келсе, оны орнату уақыты келгенше оны жасырғаныңыз жөн.
Dialogue: 0,0:34:56.28,0:34:57.96,JPDB,,0000,0000,0000,,Мен не істеуім керек, Рин?
Dialogue: 0,0:34:58.48,0:35:01.42,JPDB,,0000,0000,0000,,Маған бәрібір бірінші сынып па, үшінші сынып па.
Dialogue: 0,0:35:01.92,0:35:05.04,JPDB,,0000,0000,0000,,Менің аумағыма мұндай сұмдықты кім отырғызды?
Dialogue: 0,0:35:05.34,0:35:07.30,JPDB,,0000,0000,0000,,Ешқандай сұрақ қойылмады, оны ұрып тастаңыз.
Dialogue: 0,0:35:07.85,0:35:08.80,JPDB,,0000,0000,0000,,Жақсы садақшы
Dialogue: 0,0:35:09.20,0:35:11.16,JPDB,,0000,0000,0000,,Мектептен кейін алдымен кедергіге алдын ала зерттеу жүргізіңіз.
Dialogue: 0,0:35:11.52,0:35:13.34,JPDB,,0000,0000,0000,,Оның қандай тосқауыл екенін анықтағаннан кейін
Dialogue: 0,0:35:13.40,0:35:14.92,JPDB,,0000,0000,0000,,Жоюды немесе кетуді шешіңіз
Dialogue: 0,0:35:20.81,0:35:22.20,JPDB,,0000,0000,0000,,Садақшы Кейін кездескенше
Dialogue: 0,0:35:24.86,0:35:26.20,JPDB,,0000,0000,0000,,Мен саған көмектесемін, Сакура.
Dialogue: 0,0:35:26.86,0:35:28.88,JPDB,,0000,0000,0000,,Ах Тохсақа-сенпай
Dialogue: 0,0:35:31.30,0:35:33.04,JPDB,,0000,0000,0000,,Рахмет, Сенпай.
Dialogue: 0,0:35:33.73,0:35:34.94,JPDB,,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:35:35.50,0:35:37.52,JPDB,,0000,0000,0000,,Олай болса, бұл Сакураның сыныбына арналған.
Dialogue: 0,0:35:38.00,0:35:39.68,JPDB,,0000,0000,0000,,Бұл Катсураги мырзаның орны.
Dialogue: 0,0:35:40.20,0:35:42.68,JPDB,,0000,0000,0000,,Олар теру қатесі болғандықтан жинаймыз деді.
Dialogue: 0,0:35:43.14,0:35:45.32,JPDB,,0000,0000,0000,,Өйткені Кузуки икемсіз.
Dialogue: 0,0:36:01.21,0:36:02.66,JPDB,,0000,0000,0000,,Бұл жетінші ме?
Dialogue: 0,0:36:03.32,0:36:05.30,JPDB,,0000,0000,0000,,Әзірге бұл бастапқы нүкте сияқты.
Dialogue: 0,0:36:06.20,0:36:08.56,JPDB,,0000,0000,0000,,Мен мұндай хатты көрген де, естіген де емеспін.
Dialogue: 0,0:36:09.34,0:36:12.56,JPDB,,0000,0000,0000,,Қарғыс атсын, бұл менің қолымнан келмейді.
Dialogue: 0,0:36:13.58,0:36:16.54,JPDB,,0000,0000,0000,,Садақшы Сіз тосқауылдың шынайы табиғатын білесіз бе?
Dialogue: 0,0:36:17.16,0:36:22.80,JPDB,,0000,0000,0000,,Іске қосылғаннан кейін бұл тосқауыл оның ішіндегі адамдарды ерітеді.
Dialogue: 0,0:36:23.40,0:36:24.76,JPDB,,0000,0000,0000,,Бұл жан жегіш
Dialogue: 0,0:36:25.32,0:36:27.52,JPDB,,0000,0000,0000,,Адам денесін бөгет ішінде балқыту
Dialogue: 0,0:36:27.78,0:36:31.02,JPDB,,0000,0000,0000,,Шыққан жандарды күштеп жинайтын қан қорғаны.
Dialogue: 0,0:36:31.90,0:36:36.62,JPDB,,0000,0000,0000,,Ал жан кімге керек? Бұл қызметші.
Dialogue: 0,0:36:37.61,0:36:40.56,JPDB,,0000,0000,0000,,Садақшы Балалар сендер сондайсыңдар.
Dialogue: 0,0:36:41.18,0:36:42.69,JPDB,,0000,0000,0000,,Сіз оны таптың.
Dialogue: 0,0:36:43.24,0:36:45.18,JPDB,,0000,0000,0000,,Біз негізінен рухтармыз.
Dialogue: 0,0:36:45.88,0:36:47.82,JPDB,,0000,0000,0000,,Етпен қоректенгендей.
Dialogue: 0,0:36:48.20,0:36:51.16,JPDB,,0000,0000,0000,,Қызметші ақыл мен жанды тамақтандырады
Dialogue: 0,0:36:51.46,0:36:56.84,JPDB,,0000,0000,0000,,Басқаша айтқанда, сіз неғұрлым көп қабылдасаңыз, сиқырлы қуат сақтау орны соғұрлым артады.
Dialogue: 0,0:36:57.41,0:37:00.72,JPDB,,0000,0000,0000,,Шебердің берген сиқырлы күші жетпейді.
Dialogue: 0,0:37:01.26,0:37:04.18,JPDB,,0000,0000,0000,,Жетпейді, көп болса жақсы.
Dialogue: 0,0:37:04.97,0:37:09.54,JPDB,,0000,0000,0000,,Айналаңыздағы адамдардан энергияны ұрлау шебер ретіндегі негізгі стратегия болып табылады.
Dialogue: 0,0:37:09.90,0:37:13.02,JPDB,,0000,0000,0000,,Осы тұрғыдан алғанда бұл кедергі тиімді.
Dialogue: 0,0:37:13.90,0:37:15.32,JPDB,,0000,0000,0000,,Бұл мені ашуландырады.
Dialogue: 0,0:37:15.66,0:37:17.58,JPDB,,0000,0000,0000,,Ешқашан бұлай айтпа, Арчер.
Dialogue: 0,0:37:18.26,0:37:19.32,JPDB,,0000,0000,0000,,Біз бәріміз құтқарылар едік
Dialogue: 0,0:37:19.65,0:37:21.58,JPDB,,0000,0000,0000,,Менің де еліктеймін деген ойым жоқ.
Dialogue: 0,0:37:24.16,0:37:25.50,JPDB,,0000,0000,0000,,Олай болса, өшірейік.
Dialogue: 0,0:37:25.90,0:37:27.04,JPDB,,0000,0000,0000,,Бұл мағынасыз шығар.
Dialogue: 0,0:37:27.10,0:37:28.86,JPDB,,0000,0000,0000,,Жолға түсу үшін жеткілікті.
Dialogue: 0,0:37:29.04,0:37:31.98,JPDB,,0000,0000,0000,,Мұның мәні неде? Оны өшіру босқа кетеді.
Dialogue: 0,0:37:47.50,0:37:49.54,JPDB,,0000,0000,0000,,Бұл сіздің жұмысыңыз
Dialogue: 0,0:37:50.12,0:37:54.04,JPDB,,0000,0000,0000,,Жоқ, бұл трюк ойнау сиқыршының міндеті.
Dialogue: 0,0:37:54.40,0:37:57.44,JPDB,,0000,0000,0000,,Біз тек бұйырғандай шайқасамыз.
Dialogue: 0,0:37:59.14,0:38:01.70,JPDB,,0000,0000,0000,,Дұрыс, ана жақтағы аға.
Dialogue: 0,0:38:03.54,0:38:05.26,JPDB,,0000,0000,0000,,Арчерді көре аласыз.
Dialogue: 0,0:38:05.38,0:38:06.56,JPDB,,0000,0000,0000,,Қызметші
Dialogue: 0,0:38:07.04,0:38:12.12,JPDB,,0000,0000,0000,,Соны түсінген жас келіншектің маған жау болғаны дұрыс па?
Dialogue: 0,0:38:17.46,0:38:20.78,JPDB,,0000,0000,0000,,Жан-жақтан қоршалған Бұл жерде соғысу тиімсіз
Dialogue: 0,0:38:21.14,0:38:26.98,JPDB,,0000,0000,0000,,О, бұл үлкен мәселе. Сіз ештеңе түсінбейтін сияқтысыз, бірақ сіз мәнді түсініп жатырсыз.
Dialogue: 0,0:38:27.38,0:38:30.42,JPDB,,0000,0000,0000,,А, мен сәтсіздікке ұшырадым.
Dialogue: 0,0:38:30.88,0:38:32.20,JPDB,,0000,0000,0000,,Көңілді...
Dialogue: 0,0:38:35.60,0:38:37.78,JPDB,,0000,0000,0000,,Мен сені шақырмауым керек еді.
Dialogue: 0,0:38:46.72,0:38:49.46,JPDB,,0000,0000,0000,,Es ist gross. Es ist klein
Dialogue: 0,0:38:51.44,0:38:53.40,JPDB,,0000,0000,0000,,Vox Gott Es Atlas
Dialogue: 0,0:38:59.26,0:39:01.26,JPDB,,0000,0000,0000,,Садақшы Мен қонуға рұқсат бердім.
Dialogue: 0,0:39:24.52,0:39:25.16,JPDB,,0000,0000,0000,,Садақшы
Dialogue: 0,0:39:33.33,0:39:35.28,JPDB,,0000,0000,0000,,Жақсы, мен мұны істеуім керек.
Dialogue: 0,0:39:35.82,0:39:38.09,JPDB,,0000,0000,0000,,Мен тез сөйлейтін адамдарды ұнатпаймын.
Dialogue: 0,0:39:38.56,0:39:40.00,JPDB,,0000,0000,0000,,Лансер қызметшісі
Dialogue: 0,0:39:40.60,0:39:41.36,JPDB,,0000,0000,0000,,Шынында да
Dialogue: 0,0:39:42.02,0:39:45.46,JPDB,,0000,0000,0000,,Мына қызметшіңіз Саберге ұқсамайды.
Dialogue: 0,0:39:46.48,0:39:48.29,JPDB,,0000,0000,0000,,Ол әрине шыдай алмай, әрекетке көшеді.
Dialogue: 0,0:39:55.40,0:39:57.76,JPDB,,0000,0000,0000,,Сіз тікелей шайқаста күресетін типке жатпайсыз.
Dialogue: 0,0:39:58.36,0:39:59.80,JPDB,,0000,0000,0000,,Рычаг садақшы ма?
Dialogue: 0,0:40:01.89,0:40:04.16,JPDB,,0000,0000,0000,,Сора, садағыңды шығар, садақшы.
Dialogue: 0,0:40:04.46,0:40:05.60,JPDB,,0000,0000,0000,,Мен мұны күтемін.
Dialogue: 0,0:40:08.98,0:40:09.74,JPDB,,0000,0000,0000,,Садақшы…
Dialogue: 0,0:40:14.64,0:40:15.30,JPDB,,0000,0000,0000,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:40:16.34,0:40:18.74,JPDB,,0000,0000,0000,,Садақшы, мен саған көмектеспеймін.
Dialogue: 0,0:40:19.32,0:40:21.80,JPDB,,0000,0000,0000,,Маған осы жерде өз күшіңді көрсет
Dialogue: 0,0:40:49.12,0:40:49.94,JPDB,,0000,0000,0000,,Ято деген құдай?
Dialogue: 0,0:41:16.68,0:41:19.42,JPDB,,0000,0000,0000,,Бұл... қызметшілердің шайқасы
Dialogue: 0,0:41:32.12,0:41:33.04,JPDB,,0000,0000,0000,,Идиот
Dialogue: 0,0:41:35.22,0:41:35.86,JPDB,,0000,0000,0000,,Садақшы
Dialogue: 0,0:41:46.02,0:41:47.28,JPDB,,0000,0000,0000,,Қос қылыш ұстағыш?
Dialogue: 0,0:41:57.98,0:42:01.04,JPDB,,0000,0000,0000,,Садақшының сыртқы түрі қылышшыға еліктеу емес.
Dialogue: 0,0:42:25.08,0:42:26.05,JPDB,,0000,0000,0000,,Жиырма жеті...
Dialogue: 0,0:42:26.86,0:42:29.12,JPDB,,0000,0000,0000,,Бəрін атып тастасам да əлі көп бар екенін білмедім.
Dialogue: 0,0:42:29.94,0:42:32.48,JPDB,,0000,0000,0000,,Не болды? Күтіп, көріп тұрғандай емес сияқтымыз.
Dialogue: 0,0:42:33.09,0:42:34.96,JPDB,,0000,0000,0000,,Импульс бұрын қайда кетті?
Dialogue: 0,0:42:35.30,0:42:38.52,JPDB,,0000,0000,0000,,Енот ит аузыма ұра береді.
Dialogue: 0,0:42:39.04,0:42:40.72,JPDB,,0000,0000,0000,,Жақсы, мен тыңдаймын.
Dialogue: 0,0:42:41.12,0:42:42.82,JPDB,,0000,0000,0000,,Бұл батыр кім?
Dialogue: 0,0:42:43.32,0:42:45.90,JPDB,,0000,0000,0000,,Мен екі жақты садақшы туралы естіген емеспін.
Dialogue: 0,0:42:46.30,0:42:48.42,JPDB,,0000,0000,0000,,Сізді осылай түсіну оңай.
Dialogue: 0,0:42:49.14,0:42:51.96,JPDB,,0000,0000,0000,,Найзашы ретінде ең жүйрік батырды таңдайды дейді.
Dialogue: 0,0:42:52.16,0:42:54.08,JPDB,,0000,0000,0000,,Олардың ішіндегі ең жақсысы сенсің.
Dialogue: 0,0:42:54.98,0:42:57.78,JPDB,,0000,0000,0000,,Дүниеде мұндай үш найза ғана бар.
Dialogue: 0,0:42:58.52,0:43:02.62,JPDB,,0000,0000,0000,,Сонымен қатар, жануарға ұқсайтын ептілігі бар бір ғана адам бар шығар.
Dialogue: 0,0:43:02.82,0:43:05.08,JPDB,,0000,0000,0000,,Жақсы айтты Арчер.
Dialogue: 0,0:43:13.38,0:43:16.76,JPDB,,0000,0000,0000,,Олай болса, менің өлімші соққымды қабылдайсың ба?
Dialogue: 0,0:43:18.65,0:43:21.92,JPDB,,0000,0000,0000,,Мен оны тоқтатпаймын; бұл мен ақырында жеңуім керек жау.
Dialogue: 0,0:43:22.60,0:43:23.22,JPDB,,0000,0000,0000,,(Кёсукэ) Дұрыс айтасың, Миямура-кун! (Миямура) Иә?
Dialogue: 0,0:43:24.34,0:43:26.06,JPDB,,0000,0000,0000,,Сол ерекше сиқырлы күш
Dialogue: 0,0:43:26.48,0:43:28.48,JPDB,,0000,0000,0000,,Noble Phantasm қолдануға тырысатыны анық
Dialogue: 0,0:43:29.88,0:43:30.78,JPDB,,0000,0000,0000,,және тек үшеуміз – анам, әкем және мен – бірге өмір сүремін…
Dialogue: 0,0:43:36.32,0:43:36.88,JPDB,,0000,0000,0000,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:43:39.84,0:43:42.48,JPDB,,0000,0000,0000,,Оқушы Мен әлі мектепте оқып жүргенмін.
Dialogue: 0,0:43:42.82,0:43:43.96,JPDB,,0000,0000,0000,,Солай көрінеді.
Dialogue: 0,0:43:44.18,0:43:45.88,JPDB,,0000,0000,0000,,Сіздің арқаңызда мен өмірімді сақтап қалдым.
Dialogue: 0,0:43:46.18,0:43:48.44,JPDB,,0000,0000,0000,,Эй, Лансерге не болды?
Dialogue: 0,0:43:48.72,0:43:50.50,JPDB,,0000,0000,0000,,Мен бұрынғы фигураны ұстандым.
Dialogue: 0,0:43:51.22,0:43:52.56,JPDB,,0000,0000,0000,,Өйткені ол куә.
Dialogue: 0,0:43:53.08,0:43:54.66,JPDB,,0000,0000,0000,,Оны өшіруге барған шығар.
Dialogue: 0,0:43:55.81,0:43:56.86,JPDB,,0000,0000,0000,,Арчерге еріңіз
Dialogue: 0,0:43:57.06,0:43:58.62,JPDB,,0000,0000,0000,,Мен де жақында жетемін.
Dialogue: 0,0:43:59.78,0:44:01.94,JPDB,,0000,0000,0000,,Ей, неткен ақымақ
Dialogue: 0,0:44:02.66,0:44:05.02,JPDB,,0000,0000,0000,,Куәгерлерді өшіру сиқыршының ережесі.
Dialogue: 0,0:44:05.33,0:44:08.00,JPDB,,0000,0000,0000,,Мен мұны жек көретінмін, сондықтан мен әрқашан сақ болдым ...
Dialogue: 0,0:44:43.58,0:44:45.86,JPDB,,0000,0000,0000,,Садақшы Лэнсерді қуып келеді
Dialogue: 0,0:44:46.92,0:44:50.38,JPDB,,0000,0000,0000,,Тым болмаса Ұстаздың жүзін түсінбейінше, оған тұрарлық емес.
Dialogue: 0,0:44:56.48,0:44:59.38,JPDB,,0000,0000,0000,,Рин, бұл сенің жауапкершілігіңде.
Dialogue: 0,0:45:06.01,0:45:07.92,JPDB,,0000,0000,0000,,Лансердің найзасы бар пышақ?
Dialogue: 0,0:45:08.56,0:45:10.60,JPDB,,0000,0000,0000,,Жүрегің зақымданса, оны сақтай алмайсың.
Dialogue: 0,0:45:17.00,0:45:20.08,JPDB,,0000,0000,0000,,Кешіріңіз, мен сізге ең болмаса қамқорлық жасаймын.
Dialogue: 0,0:45:33.02,0:45:33.96,JPDB,,0000,0000,0000,,Тоқта, жарай ма?
Dialogue: 0,0:45:34.93,0:45:40.40,JPDB,,0000,0000,0000,,Сенің кесіріңнен осындай күнде, осындай уақытта,
Dialogue: 0,0:45:41.76,0:45:44.84,JPDB,,0000,0000,0000,,Ертеңнен бастап ол қызды қандай жүзбен қарсы алайын?
Dialogue: 0,0:45:53.88,0:45:55.98,JPDB,,0000,0000,0000,,Қолымыз әлі бар.
Dialogue: 0,0:46:15.92,0:46:17.65,JPDB,,0000,0000,0000,,Кешіріңіз, мен сәтсіздікке ұшырадым.
Dialogue: 0,0:46:18.20,0:46:20.48,JPDB,,0000,0000,0000,,Ол өте сақ шебер болса керек.
Dialogue: 0,0:46:21.46,0:46:22.09,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:46:22.77,0:46:25.12,JPDB,,0000,0000,0000,,Бұл оңай емес.
Dialogue: 0,0:46:29.42,0:46:31.84,JPDB,,0000,0000,0000,,Иә, оны алуға кетті.
Dialogue: 0,0:46:36.84,0:46:40.77,JPDB,,0000,0000,0000,,Ұмытпа, бұл тек Ринге жарасады.
Dialogue: 0,0:46:41.30,0:46:43.84,JPDB,,0000,0000,0000,,Иә, онда рахмет.
Dialogue: 0,0:46:44.64,0:46:47.36,JPDB,,0000,0000,0000,,Қалай қарасаң да, сиқыр қалмайды.
Dialogue: 0,0:46:48.94,0:46:49.78,JPDB,,0000,0000,0000,,Мен күттім.
Dialogue: 0,0:46:50.34,0:46:51.40,JPDB,,0000,0000,0000,,Ринге не болды?
Dialogue: 0,0:46:51.98,0:46:56.88,JPDB,,0000,0000,0000,,Лансердің қожайыны ол өлтірді деп болжанған куәгердің өлтірілгенін білгенде не болады?
Dialogue: 0,0:46:57.58,0:47:00.62,JPDB,,0000,0000,0000,,Мен Лэнсердің оны қайтадан аяқтайтынына сенімдімін.
Dialogue: 0,0:47:07.36,0:47:10.98,JPDB,,0000,0000,0000,,Сізге қосымша ауыртпалық түскелі тұр.
Dialogue: 0,0:47:11.49,0:47:15.26,JPDB,,0000,0000,0000,,Мен саған көмектесу үшін қанша істегенімнен кейін, мен сені өлуге жол бере алмаймын.
Dialogue: 0,0:47:15.94,0:47:17.88,JPDB,,0000,0000,0000,,Лансерлік қызметші
Dialogue: 0,0:47:22.44,0:47:23.24,JPDB,,0000,0000,0000,,Ринді күтіңіз
Dialogue: 0,0:47:23.58,0:47:25.50,JPDB,,0000,0000,0000,,Қызметшінің бірнеше қатысуы бар.
Dialogue: 0,0:47:49.56,0:47:51.84,JPDB,,0000,0000,0000,,Сабердің қызметшісі
Dialogue: 0,0:50:23.36,0:50:24.68,JPDB,,0000,0000,0000,,Бақылау қосулы
Dialogue: 0,0:50:24.72,0:50:26.72,JPDB,,0000,0000,0000,,Таң атпайды, Тохсақа.
Dialogue: 0,0:50:26.78,0:50:28.06,JPDB,,0000,0000,0000,,Алда әлі алда
Dialogue: 0,0:50:28.10,0:50:31.10,JPDB,,0000,0000,0000,,Мен өмір сүріп, өз міндетімді орындауым керек.
Dialogue: 0,0:50:31.14,0:50:33.62,JPDB,,0000,0000,0000,,Маған тез арада хабарласпасаң, өлесің.
Dialogue: 0,0:50:33.68,0:50:35.08,JPDB,,0000,0000,0000,,Бұл жетінші қызметші.
Dialogue: 0,0:50:35.12,0:50:37.16,JPDB,,0000,0000,0000,,Сіз менің қожайынымсыз ба?
Dialogue: 0,0:50:38.66,0:50:44.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
