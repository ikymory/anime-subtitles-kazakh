Dialogue: 0,0:01:07.96,0:01:17.47,JPOP,,0000,0000,0000,,Жүрегімді өртеп жіберген үмітсіздіктің қасында
Dialogue: 0,0:01:18.34,0:01:28.98,JPOP,,0000,0000,0000,,Сіз маған әрқашан күлкі сыйладыңыз, ол бәрін жоғалтты.
Dialogue: 1,0:01:29.06,0:01:31.94,JPOP,,0000,0000,0000,,Күңгірт дауыс
Dialogue: 2,0:01:31.94,0:01:34.36,JPOP,,0000,0000,0000,,Қол жетпейтін сөздер
Dialogue: 0,0:01:34.36,0:01:39.90,JPOP,,0000,0000,0000,,Қайта сүрініп кете жаздаған сайын
Dialogue: 0,0:01:39.90,0:01:44.16,JPOP,,0000,0000,0000,,Мен саған талай рет жабыстым
Dialogue: 0,0:01:44.16,0:01:49.75,JPOP,,0000,0000,0000,,Ақ, ақ, таза ақ болашақ
Dialogue: 0,0:01:49.75,0:01:55.09,JPOP,,0000,0000,0000,,Біздің жалғыз үмітіміз
Dialogue: 0,0:01:55.09,0:02:06.01,JPOP,,0000,0000,0000,,Дәл қазір менде бар соқыр сезім бар.
Dialogue: 0,0:02:06.01,0:02:11.23,JPOP,,0000,0000,0000,,Бір дұрыс жауап жоқ
Dialogue: 0,0:02:11.23,0:02:20.40,JPOP,,0000,0000,0000,,Мен өз ертеңімді іздедім
Dialogue: 0,0:22:10.14,0:22:15.94,JPED,,0000,0000,0000,,Екеуміз әлі ештеңе білмедік.
Dialogue: 0,0:22:16.30,0:22:22.45,JPED,,0000,0000,0000,,Мен сол қолыммен өткінші жоқтықпен ойнадым.
Dialogue: 0,0:22:22.46,0:22:28.24,JPED,,0000,0000,0000,,Кішкене қақтығыс қолдарыңызды байлайды
Dialogue: 0,0:22:28.57,0:22:32.86,JPED,,0000,0000,0000,,Болашақты алдау
Dialogue: 0,0:22:33.20,0:22:39.78,JPED,,0000,0000,0000,,Мен оны қалай қорғау керектігін де білмеймін
Dialogue: 0,0:22:39.78,0:22:45.60,JPED,,0000,0000,0000,,Бұл жалған идеал болса, бәрібір
Dialogue: 0,0:22:45.92,0:22:54.76,JPED,,0000,0000,0000,,Мен өзім өмір сүргім келеді
Dialogue: 0,0:22:54.82,0:23:01.49,JPED,,0000,0000,0000,,Уақыт өте келе кездестік
Dialogue: 0,0:23:01.49,0:23:07.50,JPED,,0000,0000,0000,,Мен сенімен бірге болған маған сенемін
Dialogue: 0,0:23:07.69,0:23:13.68,JPED,,0000,0000,0000,,Бұл арман ақырын аяқталғанша
Dialogue: 0,0:23:13.78,0:23:22.32,JPED,,0000,0000,0000,,Көгілдір күндерді ашып, тағдырыңмен күрес
Dialogue: 0,0:00:32.62,0:00:33.94,JPDB,,0000,0000,0000,,Бұл жеткілікті
Dialogue: 0,0:00:38.20,0:00:39.76,JPDB,,0000,0000,0000,,Маған эскорт керек емес
Dialogue: 0,0:00:40.24,0:00:42.60,JPDB,,0000,0000,0000,,Сондай кісі өлтіруші оққағар бар ма?
Dialogue: 0,0:00:42.88,0:00:44.08,JPDB,,0000,0000,0000,,Мен оны қарап шықтым.
Dialogue: 0,0:00:44.62,0:00:48.88,JPDB,,0000,0000,0000,,Оның кісі өлтіру ниетін сезіну қабілеті бар сияқты.
Dialogue: 0,0:00:49.90,0:00:54.34,JPDB,,0000,0000,0000,,Мен Риннің сені шығарып салғанда саған шабуыл жасамау туралы нұсқауларын орындаймын.
Dialogue: 0,0:02:27.96,0:02:29.06,JPDB,,0000,0000,0000,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:02:29.32,0:02:32.54,JPDB,,0000,0000,0000,,Егер қаласаң, мен саған жар боламын.
Dialogue: 0,0:02:33.06,0:02:36.38,JPDB,,0000,0000,0000,,Мен тек жарты жас болсам да, мен бәрібір сиқыршымын.
Dialogue: 0,0:02:36.64,0:02:37.92,JPDB,,0000,0000,0000,,Ойнау
Dialogue: 0,0:02:38.60,0:02:42.27,JPDB,,0000,0000,0000,,Қанды иіскемеген сиқыршы жарты адамнан кем.
Dialogue: 0,0:02:43.22,0:02:45.74,JPDB,,0000,0000,0000,,Менен қан иісін сезбей тұрсың ба?
Dialogue: 0,0:02:46.12,0:02:50.50,JPDB,,0000,0000,0000,,Сиқыршылар нәтижеге жету үшін салқын қанды тіршілік иелері.
Dialogue: 0,0:02:50.92,0:02:52.90,JPDB,,0000,0000,0000,,Рин Тохсакаға еріңіз
Dialogue: 0,0:02:53.22,0:02:54.96,JPDB,,0000,0000,0000,,Кішкене тәтті болса да
Dialogue: 0,0:02:55.16,0:02:57.52,JPDB,,0000,0000,0000,,Бұл жаста сіздің ой-өрісіңіз толық болады.
Dialogue: 0,0:02:58.58,0:03:00.72,JPDB,,0000,0000,0000,,Тохсақаның қожа болғанына қуаныштымын.
Dialogue: 0,0:03:01.24,0:03:03.60,JPDB,,0000,0000,0000,,Қасиетті Граалды алу үшін жақсы
Dialogue: 0,0:03:04.56,0:03:07.96,JPDB,,0000,0000,0000,,Адам тілегін орындайтын зиянды қазына сандығы ма?
Dialogue: 0,0:03:08.64,0:03:10.56,JPDB,,0000,0000,0000,,Маған бұл керек емес.
Dialogue: 0,0:03:10.72,0:03:12.84,JPDB,,0000,0000,0000,,Не... Маған керегі жоқ.
Dialogue: 0,0:03:13.58,0:03:17.28,JPDB,,0000,0000,0000,,Орындалмаған тілектерді орындау үшін қызметші
Dialogue: 0,0:03:17.44,0:03:19.24,JPDB,,0000,0000,0000,,Сіз бұл шайқасқа қатысасыз ба?
Dialogue: 0,0:03:19.70,0:03:20.70,JPDB,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:03:21.30,0:03:23.56,JPDB,,0000,0000,0000,,Олай болатыны сөзсіз.
Dialogue: 0,0:03:24.42,0:03:26.98,JPDB,,0000,0000,0000,,Біз қызметшілерде ерік бостандығы жоқ.
Dialogue: 0,0:03:27.66,0:03:32.38,JPDB,,0000,0000,0000,,Шақыруға өз еркімен жауап беретін жалғыз адам – сенің Саберің.
Dialogue: 0,0:03:32.80,0:03:34.12,JPDB,,0000,0000,0000,,Тек Сабер ме?
Dialogue: 0,0:03:34.48,0:03:39.12,JPDB,,0000,0000,0000,,Иә, батыр рухтар өзгенің қалауымен шақырылады.
Dialogue: 0,0:03:39.56,0:03:41.54,JPDB,,0000,0000,0000,,Бір рет қолданылатын құралдармен бірдей
Dialogue: 0,0:03:41.80,0:03:46.72,JPDB,,0000,0000,0000,,Мұндай қызметшінің адамдарға шын жүректен көмектескісі келетіні.
Dialogue: 0,0:03:46.80,0:03:48.38,JPDB,,0000,0000,0000,,Сіз бұған шындап сенесіз бе?
Dialogue: 0,0:03:49.12,0:03:50.12,JPDB,,0000,0000,0000,,Бұл...
Dialogue: 0,0:03:50.96,0:03:54.04,JPDB,,0000,0000,0000,,Тыңдаңыздар, батырлық рухтар құрылғыдан басқа ештеңе емес.
Dialogue: 0,0:03:54.40,0:03:56.22,JPDB,,0000,0000,0000,,Қандай да бір мәселе туындаса, сізге қоңырау шалылады
Dialogue: 0,0:03:56.40,0:03:58.92,JPDB,,0000,0000,0000,,Осыдан кейін ғана тазалап, жоғалып кет.
Dialogue: 0,0:03:59.88,0:04:04.96,JPDB,,0000,0000,0000,,Өзінің еркінен айырылып, мәңгілікке адамдар үшін жұмысын жалғастыратын тазалаушы.
Dialogue: 0,0:04:05.46,0:04:06.96,JPDB,,0000,0000,0000,,Бұл батырлық рух
Dialogue: 0,0:04:07.20,0:04:10.00,JPDB,,0000,0000,0000,,Қамқоршы деп аталатын ыңғайлы адам.
Dialogue: 0,0:04:10.56,0:04:12.96,JPDB,,0000,0000,0000,,Құрылғы дегенді қалай түсінесіз?
Dialogue: 0,0:04:13.36,0:04:15.42,JPDB,,0000,0000,0000,,Сабер - адам
Dialogue: 0,0:04:15.90,0:04:17.78,JPDB,,0000,0000,0000,,Жасағым келмейтін нәрседен бас тартамын.
Dialogue: 0,0:04:17.98,0:04:20.94,JPDB,,0000,0000,0000,,Мұнда келгеннен кейін опциялар болуы керек.
Dialogue: 0,0:04:21.32,0:04:25.16,JPDB,,0000,0000,0000,,Ал, қызметшінің қабығы берілген батырлық рух
Dialogue: 0,0:04:25.38,0:04:28.24,JPDB,,0000,0000,0000,,Сол кезде сіз өзіңіздің бастапқы адамдығыңызды қалпына келтіре аласыз.
Dialogue: 0,0:04:29.00,0:04:32.96,JPDB,,0000,0000,0000,,Бұрынғы құмарлықтарыммен және бұрынғы өкініштеріммен
Dialogue: 0,0:04:33.48,0:04:34.22,JPDB,,0000,0000,0000,,Өкінішті
Dialogue: 0,0:04:34.66,0:04:36.00,JPDB,,0000,0000,0000,,Елестетіп көріңізші!
Dialogue: 0,0:04:36.70,0:04:39.38,JPDB,,0000,0000,0000,,Тілегін орындай алмай қайтыс болды.
Dialogue: 0,0:04:39.88,0:04:44.08,JPDB,,0000,0000,0000,,Өлгеннен кейін де адамдар шақыратын адамдардың сезімдері.
Dialogue: 0,0:04:45.02,0:04:48.82,JPDB,,0000,0000,0000,,Бұл менің Қасиетті Граалды іздегендіктен шығар.
Dialogue: 0,0:04:49.30,0:04:52.90,JPDB,,0000,0000,0000,,Неліктен бұл заттардың бәрі қажет емес деп айтасыз?
Dialogue: 0,0:04:53.18,0:04:56.14,JPDB,,0000,0000,0000,,Орындай алмаған тілегім қалмады.
Dialogue: 0,0:04:57.70,0:05:01.09,JPDB,,0000,0000,0000,,Тілегімді орындадым, өлдім, Батыр рух болдым.
Dialogue: 0,0:05:03.06,0:05:05.66,JPDB,,0000,0000,0000,,Сондықтан орындалатын тілек жоқ.
Dialogue: 0,0:05:11.24,0:05:12.10,JPDB,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:05:12.84,0:05:14.84,JPDB,,0000,0000,0000,,Қош келдіңіз, Сенпай.
Dialogue: 0,0:05:15.08,0:05:16.84,JPDB,,0000,0000,0000,,Иә Широу қош келдіңіз
Dialogue: 0,0:05:17.02,0:05:19.94,JPDB,,0000,0000,0000,,Сабер-чан ашуланды
Dialogue: 0,0:05:22.84,0:05:24.30,JPDB,,0000,0000,0000,,Мисузу-сан...
Dialogue: 0,0:05:25.72,0:05:27.48,JPDB,,0000,0000,0000,,Мен бұрын қорғалғанмын.
Dialogue: 0,0:05:27.72,0:05:29.50,JPDB,,0000,0000,0000,,Әдемі сиқырды таптың ба?
Dialogue: 0,0:05:29.98,0:05:32.28,JPDB,,0000,0000,0000,,Неліктен Фудзи...
Dialogue: 0,0:05:32.54,0:05:35.44,JPDB,,0000,0000,0000,,Янагидо-кун маған айтып беруімді өтінді.
Dialogue: 0,0:05:35.78,0:05:38.24,JPDB,,0000,0000,0000,,Менің есте сақтау қабілетім сәл шатасатын сияқты.
Dialogue: 0,0:05:38.36,0:05:41.44,JPDB,,0000,0000,0000,,Зардап шеккендер және өмірге қауіп төндіретін жарақаттар болған жоқ.
Dialogue: 0,0:05:41.86,0:05:44.30,JPDB,,0000,0000,0000,,Жарайсың, Сенпай.
Dialogue: 0,0:05:44.60,0:05:45.20,JPDB,,0000,0000,0000,,О
Dialogue: 0,0:05:50.22,0:05:52.20,JPDB,,0000,0000,0000,,Сакура, қарсы боласың ба?
Dialogue: 0,0:05:53.96,0:05:57.34,JPDB,,0000,0000,0000,,Түнде шулы, сондықтан бүгін түнде менің үйімде болғаныңызды қалаймын.
Dialogue: 0,0:05:58.24,0:05:58.98,JPDB,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:05:59.12,0:06:02.30,JPDB,,0000,0000,0000,,Мүмкін болса, мен біраз уақыт тұра аламын ба?
Dialogue: 0,0:06:04.56,0:06:06.68,JPDB,,0000,0000,0000,,Кешіріңіз, мен сізді мазаладым ба?
Dialogue: 0,0:06:07.84,0:06:08.88,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:06:09.06,0:06:11.90,JPDB,,0000,0000,0000,,Мен сіздің сөздеріңізді бағалаймын.
Dialogue: 0,0:06:16.04,0:06:20.54,JPDB,,0000,0000,0000,,Ширу Сіз күн батқанша оралуға уәде бергенсіз.
Dialogue: 0,0:06:21.30,0:06:22.50,JPDB,,0000,0000,0000,,Масқара
Dialogue: 0,0:06:22.78,0:06:24.98,JPDB,,0000,0000,0000,,Сабердің ашулануға толық құқығы бар.
Dialogue: 0,0:06:25.38,0:06:29.76,JPDB,,0000,0000,0000,,Біріншіден, мен сізге болашақ жоспарларыңыз туралы сөйлесе аламын ба?
Dialogue: 0,0:06:33.46,0:06:35.84,JPDB,,0000,0000,0000,,Мектепте үшінші шебер болған
Dialogue: 0,0:06:36.34,0:06:41.72,JPDB,,0000,0000,0000,,-де біз үшінші адамды тапқанша Тохсакамен бітімге қол қойдық.
Dialogue: 0,0:06:43.88,0:06:46.40,JPDB,,0000,0000,0000,,Тохсакамен жұмыс істеуге қарсы ма?
Dialogue: 0,0:06:46.84,0:06:47.50,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:06:47.86,0:06:52.34,JPDB,,0000,0000,0000,,Егер сіз осындай маңызды шешім қабылдағыңыз келсе, менімен алдын ала кеңескеніңізді қалаймын.
Dialogue: 0,0:06:53.96,0:06:55.50,JPDB,,0000,0000,0000,,Олар кездескісі келеді.
Dialogue: 0,0:06:56.04,0:06:59.68,JPDB,,0000,0000,0000,,Тек растау үшін, мектеп шеберін жеңгеннен кейін.
Dialogue: 0,0:06:59.96,0:07:04.46,JPDB,,0000,0000,0000,,Ринмен бітімгершілік келісімі бірінші шаршыға қайта оралды. Оған күмән жоқ.
Dialogue: 0,0:07:05.86,0:07:06.66,JPDB,,0000,0000,0000,,О
Dialogue: 0,0:07:07.34,0:07:10.88,JPDB,,0000,0000,0000,,Соны түсінсең, менен саған ештеңе жоқ.
Dialogue: 0,0:07:11.94,0:07:15.70,JPDB,,0000,0000,0000,,Ширудың жауынгерлік тәжірибесін арттыру үшін Ринмен ынтымақтасамыз делік.
Dialogue: 0,0:07:16.78,0:07:20.42,JPDB,,0000,0000,0000,,Сабер, саған Қасиетті Граил керек.
Dialogue: 0,0:07:20.82,0:07:21.34,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:07:21.68,0:07:24.20,JPDB,,0000,0000,0000,,Бірақ бұл не үшін?
Dialogue: 0,0:07:25.46,0:07:29.32,JPDB,,0000,0000,0000,,Бұл сұрақ болашақ саясатқа қатысты ма?
Dialogue: 0,0:07:29.84,0:07:31.48,JPDB,,0000,0000,0000,,Э-э…
Dialogue: 0,0:07:32.04,0:07:34.08,JPDB,,0000,0000,0000,,Бірдеңе болды ма, Ширу?
Dialogue: 0,0:07:34.90,0:07:36.78,JPDB,,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:07:38.50,0:07:40.48,JPDB,,0000,0000,0000,,Менің де ұсынысым бар.
Dialogue: 0,0:07:42.06,0:07:45.54,JPDB,,0000,0000,0000,,Енді сіз практикалық тәжірибе жинақтауыңыз керек.
Dialogue: 0,0:07:49.80,0:07:51.68,JPDB,,0000,0000,0000,,Ах, дұрыс.
Dialogue: 0,0:07:53.36,0:07:54.58,JPDB,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:08:01.60,0:08:02.84,JPDB,,0000,0000,0000,,Сәлем Эмия
Dialogue: 0,0:08:03.88,0:08:06.10,JPDB,,0000,0000,0000,,Мицзури туралы естідіңіз бе?
Dialogue: 0,0:08:06.50,0:08:09.50,JPDB,,0000,0000,0000,,Мен мұны бүгін таңертең дожода естідім.
Dialogue: 0,0:08:09.76,0:08:12.98,JPDB,,0000,0000,0000,,Мен Мизуцудан шыққан синтоизмде табылғанын естідім.
Dialogue: 0,0:08:13.12,0:08:14.64,JPDB,,0000,0000,0000,,Ал артқы аллеяда
Dialogue: 0,0:08:14.96,0:08:18.46,JPDB,,0000,0000,0000,,Көзі жерде екенін, киімінің жыртық екенін айтты.
Dialogue: 0,0:08:19.40,0:08:21.38,JPDB,,0000,0000,0000,,Мен не болғанын білмеймін.
Dialogue: 0,0:08:21.52,0:08:25.21,JPDB,,0000,0000,0000,,Әншейінде мақтаншақ жігіт қалай тасталды?
Dialogue: 0,0:08:25.74,0:08:29.32,JPDB,,0000,0000,0000,,Дос ретінде аздап қызықпайсыз ба?
Dialogue: 0,0:08:28.32,0:08:29.15,JPDB - UP,,0000,0000,0000,,Синдзи
Dialogue: 0,0:08:31.20,0:08:32.48,JPDB,,0000,0000,0000,,Бұл қорқынышты
Dialogue: 0,0:08:32.68,0:08:34.30,JPDB,,0000,0000,0000,,Қалжың, әзіл
Dialogue: 0,0:08:34.94,0:08:36.62,JPDB,,0000,0000,0000,,Бұл жай ғана өсек емес пе?
Dialogue: 0,0:08:37.48,0:08:42.34,JPDB,,0000,0000,0000,,Ол кешеден бері өткен жылы танымал болған сияқты.
Dialogue: 0,0:08:42.68,0:08:45.50,JPDB,,0000,0000,0000,,Мизуцумен кездескен соңғы адам сен болуың керек.
Dialogue: 0,0:08:45.94,0:08:48.72,JPDB,,0000,0000,0000,,Біз жай ғана шағын әңгіме қозғадық.
Dialogue: 0,0:08:50.94,0:08:52.84,JPDB,,0000,0000,0000,,Болжам жасамаңыз
Dialogue: 0,0:08:53.24,0:08:57.50,JPDB,,0000,0000,0000,,Мені еріксіз айыптасаң, өкінесің, Эмия.
Dialogue: 0,0:09:08.70,0:09:10.24,JPDB,,0000,0000,0000,,Негізгі сәйкестендіру?
Dialogue: 0,0:09:10.68,0:09:14.34,JPDB,,0000,0000,0000,,Жақын жерде шебер болса, Тохсаканы білуге ​​болар ма еді?
Dialogue: 0,0:09:15.14,0:09:19.06,JPDB,,0000,0000,0000,,Иә, егер ештеңе манипуляцияланбаса.
Dialogue: 0,0:09:19.40,0:09:21.70,JPDB,,0000,0000,0000,,Өйткені сиқыршы қандай болса, шебер сол.
Dialogue: 0,0:09:21.84,0:09:24.19,JPDB,,0000,0000,0000,,Сиқырды іздесең, табасың.
Dialogue: 0,0:09:24.98,0:09:28.34,JPDB,,0000,0000,0000,,Бірақ бұл жай ғана күдікті. Күдікті.
Dialogue: 0,0:09:30.42,0:09:31.32,JPDB,,0000,0000,0000,,Эмия-кун?
Dialogue: 0,0:09:33.12,0:09:34.38,JPDB,,0000,0000,0000,,Бақылау қосулы
Dialogue: 0,0:09:48.84,0:09:51.86,JPDB,,0000,0000,0000,,Бұл шынымен болды, бұл үлкен мәселе болды.
Dialogue: 0,0:09:52.56,0:09:54.00,JPDB,,0000,0000,0000,,Бұл қарғыс
Dialogue: 0,0:09:54.15,0:09:58.35,JPDB,,0000,0000,0000,,Дұрыс, Эмия-кун, жаратылыстың сиқырды сезу қабілеті мүлде жойылып кеткенімен.
Dialogue: 0,0:09:58.48,0:10:00.46,JPDB,,0000,0000,0000,,Сіз орналасқан жеріңіздегі ауытқуларға сезімталсыз.
Dialogue: 0,0:10:04.64,0:10:06.64,JPDB,,0000,0000,0000,,Сіз мұны мақтайсыз ба?
Dialogue: 0,0:10:07.68,0:10:11.70,JPDB,,0000,0000,0000,,Тохсака Хаса, сен менің сиқыршы екенімді білмедің.
Dialogue: 0,0:10:12.18,0:10:13.80,JPDB,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:10:14.40,0:10:16.88,JPDB,,0000,0000,0000,,Не, бұлай айту дұрыс па?
Dialogue: 0,0:10:17.08,0:10:20.38,JPDB,,0000,0000,0000,,Жоқ, жақсы, менде дөрекі ой бар.
Dialogue: 0,0:10:20.64,0:10:23.64,JPDB,,0000,0000,0000,,Бұл дана. Жарайды, бұл солай.
Dialogue: 0,0:10:24.14,0:10:29.82,JPDB,,0000,0000,0000,,Сиқыршыларға келетін болсақ, белгілі бір деңгейден жоғары сиқырлы күшке ие адамдар ғана сиқыршы болып танылады.
Dialogue: 0,0:10:30.08,0:10:32.38,JPDB,,0000,0000,0000,,Мен солай деп ойладым.
Dialogue: 0,0:10:37.12,0:10:40.22,JPDB,,0000,0000,0000,,Мен осымен тірі қарғыс белгілерінің көпшілігін өшіре аламын ба?
Dialogue: 0,0:10:40.54,0:10:43.14,JPDB,,0000,0000,0000,,Сонымен, сіз кедергіні бейтараптай алдыңыз ба?
Dialogue: 0,0:10:43.60,0:10:47.96,JPDB,,0000,0000,0000,,Тосқауылдың өзі қойылып қойған, сондықтан оның тиімділігін әлсіретіп жатыр.
Dialogue: 0,0:10:48.38,0:10:50.34,JPDB,,0000,0000,0000,,Осылай тосқауыл қоятын ол.
Dialogue: 0,0:10:50.54,0:10:52.94,JPDB,,0000,0000,0000,,Мен мазасыздануға шыдайтын адам емеспін.
Dialogue: 0,0:10:53.60,0:10:57.24,JPDB,,0000,0000,0000,,Қалай көрсем, ертең беремін.
Dialogue: 0,0:10:58.78,0:11:00.27,JPDB,,0000,0000,0000,,Бұл солай ма?
Dialogue: 0,0:11:06.26,0:11:10.38,JPDB,,0000,0000,0000,,Жарайды, менің бір ісім бар, алдымен үйге барайын.
Dialogue: 0,0:11:11.10,0:11:14.18,JPDB,,0000,0000,0000,,Ертеңгі күнге дайындалу үшін мен көп нәрсені сатып алуым керек.
Dialogue: 0,0:11:14.74,0:11:17.12,JPDB,,0000,0000,0000,,Эмия-кун, бүгін үйге ерте қайт.
Dialogue: 0,0:11:17.54,0:11:20.74,JPDB,,0000,0000,0000,,Мен үшін неге уайымдайсың, Тохсақа?
Dialogue: 0,0:11:22.24,0:11:23.92,JPDB,,0000,0000,0000,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:11:24.10,0:11:25.88,JPDB,,0000,0000,0000,,Өйткені біз ынтымақтастық қарым-қатынасқа түстік.
Dialogue: 0,0:11:25.98,0:11:28.80,JPDB,,0000,0000,0000,,Рұқсатсыз оқуды тастасаңыз, жоспарларыңыз бұзылады.
Dialogue: 0,0:11:29.34,0:11:32.30,JPDB,,0000,0000,0000,,Әзірге кішкене растау.
Dialogue: 0,0:11:40.30,0:11:45.28,JPDB,,0000,0000,0000,,Сіз қарғысты жаншу сияқты қарапайым нәрсені істегеннен кейін осы сағатта үйге барасыз ба?
Dialogue: 0,0:11:47.32,0:11:48.26,JPDB,,0000,0000,0000,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:11:48.96,0:11:52.14,JPDB,,0000,0000,0000,,Сіз жойған тосқауыл болды
Dialogue: 0,0:11:52.34,0:11:54.58,JPDB,,0000,0000,0000,,Бұл мен орнатқан сақтандыру полисі.
Dialogue: 0,0:11:54.92,0:11:57.50,JPDB,,0000,0000,0000,,Синдзи бұл сенсің ғой...
Dialogue: 0,0:11:57.64,0:12:00.08,JPDB,,0000,0000,0000,,Бұлай әрекет жасама, Эмия.
Dialogue: 0,0:12:00.70,0:12:05.02,JPDB,,0000,0000,0000,,Мен де сиқырлы күшім болмаса да шебер болуға мәжбүрмін.
Dialogue: 0,0:12:05.50,0:12:07.38,JPDB,,0000,0000,0000,,Сонда бұл қандай кедергі?
Dialogue: 0,0:12:07.70,0:12:10.52,JPDB,,0000,0000,0000,,Демек, бұл жай сақтандыру.
Dialogue: 0,0:12:10.90,0:12:13.36,JPDB,,0000,0000,0000,,Кеше студент қызға шабуыл жасаған сіз болдыңыз ба?
Dialogue: 0,0:12:14.66,0:12:19.40,JPDB,,0000,0000,0000,,Көмек көрсету мүмкін болмады, қызметшім өз бетімен жасады...
Dialogue: 0,0:12:20.46,0:12:22.88,JPDB,,0000,0000,0000,,Келіңіздер, маған сеніңіздер.
Dialogue: 0,0:12:23.00,0:12:25.40,JPDB,,0000,0000,0000,,Мен ешкіммен ұрысқым келмейді
Dialogue: 0,0:12:26.58,0:12:27.82,JPDB,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:12:28.40,0:12:29.64,JPDB,,0000,0000,0000,,Күте тұрыңыз, Эмия
Dialogue: 0,0:12:30.12,0:12:31.68,JPDB,,0000,0000,0000,,Менімен ынтымақтасасың ба?
Dialogue: 0,0:12:32.36,0:12:35.87,JPDB,,0000,0000,0000,,Мату отбасы бастапқыда сиқыршылар отбасы болған.
Dialogue: 0,0:12:36.44,0:12:37.44,JPDB,,0000,0000,0000,,Мату
Dialogue: 0,0:12:37.66,0:12:42.14,JPDB,,0000,0000,0000,,Ал, Эмиияның білмеуі мүмкін емес, өйткені ол ресми сиқыршы емес.
Dialogue: 0,0:12:42.44,0:12:45.08,JPDB,,0000,0000,0000,,Егер күмәніңіз болса, Тохсакадан сұраңыз.
Dialogue: 0,0:12:45.72,0:12:49.36,JPDB,,0000,0000,0000,,Синдзи Сакура сен туралы біледі ме?
Dialogue: 0,0:12:50.08,0:12:53.44,JPDB,,0000,0000,0000,,Сиқыршылар отбасында жұмбақтар тек үлкен ұлына беріледі.
Dialogue: 0,0:12:54.10,0:12:57.20,JPDB,,0000,0000,0000,,Неліктен мұндай баяу әйелге сиқырды үйретер едің?
Dialogue: 0,0:12:58.08,0:12:59.80,JPDB,,0000,0000,0000,,ше?
Dialogue: 0,0:13:00.56,0:13:04.52,JPDB,,0000,0000,0000,,Егер сіз ештеңе жасамасаңыз, ынтымақтастықтың қажеті жоқ.
Dialogue: 0,0:13:07.64,0:13:09.60,JPDB,,0000,0000,0000,,Бұл біз ынтымақтастық жасай алмаймыз дегенді білдіре ме?
Dialogue: 0,0:13:10.06,0:13:15.02,JPDB,,0000,0000,0000,,Эмиия: Жеңіске жетуді ойлайсың ба?
Dialogue: 0,0:13:17.68,0:13:18.88,JPDB,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:13:19.18,0:13:23.82,JPDB,,0000,0000,0000,,Олай болса, мен әпкемді бірін-бірі өлтіре беретін біреудің үйіне қалдыра алмаймын.
Dialogue: 0,0:13:24.38,0:13:27.84,JPDB,,0000,0000,0000,,Жарайды, мен Сакураға өз тарапымнан айтамын.
Dialogue: 0,0:13:28.14,0:13:32.00,JPDB,,0000,0000,0000,,Жарайды, мен өзімнің кішілерімді ойлайтын аға болғандықтан құтқарылдым.
Dialogue: 0,0:13:32.68,0:13:35.68,JPDB,,0000,0000,0000,,Бұл жерде айтқанымыз біз үшін ғана құпия.
Dialogue: 0,0:13:36.14,0:13:40.30,JPDB,,0000,0000,0000,,Емияны досымдай ойлап, сырымды айттым.
Dialogue: 0,0:13:40.96,0:13:42.84,JPDB,,0000,0000,0000,,О, үндеме.
Dialogue: 0,0:13:52.21,0:13:52.80,JPDB,,0000,0000,0000,,Алшақтық бар.
Dialogue: 0,0:14:05.83,0:14:07.50,JPDB,,0000,0000,0000,,Жарайды, тағы бір.
Dialogue: 0,0:14:10.11,0:14:12.98,JPDB,,0000,0000,0000,,Итата Сабер жігіті
Dialogue: 0,0:14:13.55,0:14:16.14,JPDB,,0000,0000,0000,,Егер мен мұны істеу керек болса, мен ешбір тасты тастамас едім.
Dialogue: 0,0:14:20.47,0:14:21.78,JPDB,,0000,0000,0000,,Бақылау қосулы
Dialogue: 0,0:14:29.60,0:14:31.58,JPDB,,0000,0000,0000,,Шоғырлану
Dialogue: 0,0:14:34.04,0:14:34.76,JPDB,,0000,0000,0000,,Ширу
Dialogue: 0,0:14:36.30,0:14:37.70,JPDB,,0000,0000,0000,,Бұл не, Сабер?
Dialogue: 0,0:14:38.00,0:14:40.98,JPDB,,0000,0000,0000,,Жоқ, өйткені мен сиқырдың барын сездім.
Dialogue: 0,0:14:41.56,0:14:42.64,JPDB,,0000,0000,0000,,Бұл жаттығу ма?
Dialogue: 0,0:14:43.10,0:14:46.80,JPDB,,0000,0000,0000,,А, мен мұны күнде істеймін.
Dialogue: 0,0:14:47.26,0:14:48.94,JPDB,,0000,0000,0000,,Мен кіруге болады ма?
Dialogue: 0,0:14:49.90,0:14:50.58,JPDB,,0000,0000,0000,,О
Dialogue: 0,0:14:51.32,0:14:54.66,JPDB,,0000,0000,0000,,Ширудың мамандығы арматура деп естідім.
Dialogue: 0,0:14:55.24,0:14:59.36,JPDB,,0000,0000,0000,,Жарайды, мен оны жақсымын деп айта алмаймын, бірақ бұл менің қолымнан келетін жалғыз нәрсе.
Dialogue: 0,0:14:59.88,0:15:03.40,JPDB,,0000,0000,0000,,Күшейтуге қалай жаттығасыз?
Dialogue: 0,0:15:04.00,0:15:08.20,JPDB,,0000,0000,0000,,Күшейту дегеніміз бір нәрсенің күшін арттыру ғана емес.
Dialogue: 0,0:15:08.54,0:15:11.28,JPDB,,0000,0000,0000,,Заттардың әсерін күшейтуді қамтиды.
Dialogue: 0,0:15:12.20,0:15:13.94,JPDB,,0000,0000,0000,,Бұл оны қиындатады
Dialogue: 0,0:15:14.30,0:15:17.44,JPDB,,0000,0000,0000,,Егер бұл шам болса, ол жарқыраған болар еді.
Dialogue: 0,0:15:17.82,0:15:20.18,JPDB,,0000,0000,0000,,Заттардың құрамдас материалдарын елестетіңіз
Dialogue: 0,0:15:20.28,0:15:24.90,JPDB,,0000,0000,0000,,Бұл оған өзімнің сиқырлы күшімді беру арқылы оны күшейтуді білдіреді.
Dialogue: 0,0:15:25.36,0:15:26.24,JPDB,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:15:28.52,0:15:30.82,JPDB,,0000,0000,0000,,Бұл даудан жақсы.
Dialogue: 0,0:15:32.06,0:15:33.66,JPDB,,0000,0000,0000,,Бірдеңе жасап көріңіз
Dialogue: 0,0:15:34.65,0:15:35.82,JPDB,,0000,0000,0000,,Бақылау қосулы
Dialogue: 0,0:15:39.76,0:15:41.66,JPDB,,0000,0000,0000,,Негізгі контурды түсіндіру
Dialogue: 0,0:15:42.72,0:15:44.68,JPDB,,0000,0000,0000,,Құрамдық материалдарды түсіндіру
Dialogue: 0,0:15:45.67,0:15:47.54,JPDB,,0000,0000,0000,,Негізгі контурды өзгерту
Dialogue: 0,0:15:48.79,0:15:52.22,JPDB,,0000,0000,0000,,Құрылыс материалы Арматура
Dialogue: 0,0:15:55.88,0:15:57.32,JPDB,,0000,0000,0000,,Тағы бір сәтсіздік
Dialogue: 0,0:15:58.03,0:16:00.60,JPDB,,0000,0000,0000,,Сәттілік деңгейі өте төмен.
Dialogue: 0,0:16:00.94,0:16:06.48,JPDB,,0000,0000,0000,,Жоқ, мен Ширудың зейіні аздап кеткендей болдым.
Dialogue: 0,0:16:08.36,0:16:14.06,JPDB,,0000,0000,0000,,Жоқ Мысалы, мұндай пышақтар жиі жақсы жұмыс істейді.
Dialogue: 0,0:16:15.96,0:16:18.46,JPDB,,0000,0000,0000,,Ақыр соңында, қасыңда болсам әбігер.
Dialogue: 0,0:16:19.18,0:16:21.32,JPDB,,0000,0000,0000,,Тамырларды тым көп жинамау
Dialogue: 0,0:16:22.62,0:16:24.72,JPDB,,0000,0000,0000,,Қалай болғанда да, мен жақында 15-ке толамын.
Dialogue: 0,0:17:12.82,0:17:13.82,JPDB,,0000,0000,0000,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:17:14.96,0:17:16.12,JPDB,,0000,0000,0000,,Рюдужи храмы
Dialogue: 0,0:17:16.86,0:17:18.04,JPDB,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:17:34.48,0:17:36.13,JPDB,,0000,0000,0000,,Грильде пісірілген треска улығы
Dialogue: 0,0:17:45.17,0:17:45.78,JPDB,,0000,0000,0000,,Ширу...
Dialogue: 0,0:17:52.40,0:17:54.54,JPDB,,0000,0000,0000,,Кастердің қызметшісі...
Dialogue: 0,0:17:54.89,0:17:58.24,JPDB,,0000,0000,0000,,Иә, дұрыс, Сабер ұстаз.
Dialogue: 0,0:17:59.58,0:18:00.52,JPDB,,0000,0000,0000,,Бұл пайдасыз.
Dialogue: 0,0:18:01.07,0:18:05.40,JPDB,,0000,0000,0000,,Белгіленгеннен кейін сиқырды сиқырлы күштің суымен жууға болмайды.
Dialogue: 0,0:18:05.90,0:18:09.96,JPDB,,0000,0000,0000,,Әсіресе сиқырлы схема сияқты әлсіз ағынмен.
Dialogue: 0,0:18:10.60,0:18:12.78,JPDB,,0000,0000,0000,,Сонымен, қоңырау шалу оңай болды ма?
Dialogue: 0,0:18:13.12,0:18:17.46,JPDB,,0000,0000,0000,,Шеберлердің ішінде де сіз ең әлсіз болдыңыз.
Dialogue: 0,0:18:17.69,0:18:19.68,JPDB,,0000,0000,0000,,Сіз мені өлтірмекшісіз бе?
Dialogue: 0,0:18:20.25,0:18:24.42,JPDB,,0000,0000,0000,,Уайымдамаңыз, егер сіз оларды өлтірсеңіз, олардың сиқырлы күшін сіңіре алмайсыз.
Dialogue: 0,0:18:24.72,0:18:27.90,JPDB,,0000,0000,0000,,Алғашында оны қалай ұстау керектігін білмедім, сондықтан оны өлтірдім.
Dialogue: 0,0:18:28.00,0:18:30.02,JPDB,,0000,0000,0000,,Енді мен оны жақсы жинай аламын.
Dialogue: 0,0:18:31.08,0:18:33.70,JPDB,,0000,0000,0000,,Қалада болып жатқан оқиғаларға сіз жауаптысыз...
Dialogue: 0,0:18:34.20,0:18:35.90,JPDB,,0000,0000,0000,,О, мен мұны білмедім.
Dialogue: 0,0:18:36.68,0:18:40.20,JPDB,,0000,0000,0000,,Кастердің қызметшісі база құруға құқылы.
Dialogue: 0,0:18:40.82,0:18:44.82,JPDB,,0000,0000,0000,,Мен сенен қорғану үшін осы жерге ғибадатхана саламын.
Dialogue: 0,0:18:45.16,0:18:46.76,JPDB,,0000,0000,0000,,Қараңызшы, сіз оны көре аласыз.
Dialogue: 0,0:18:47.49,0:18:51.00,JPDB,,0000,0000,0000,,Осы елде жинақталған бірнеше жүздеген адамға арналған сиқырлы күштің қоймасы
Dialogue: 0,0:18:51.13,0:18:53.20,JPDB,,0000,0000,0000,,Болмыстың да, көрінбейтіннің де үзінділері...
Dialogue: 0,0:18:53.45,0:18:58.88,JPDB,,0000,0000,0000,,Кастер, сіз қатысы жоқ адамды қатыстырдыңыз ба?
Dialogue: 0,0:18:59.16,0:19:01.80,JPDB,,0000,0000,0000,,Бұл қалада барлығы менікі
Dialogue: 0,0:19:02.10,0:19:03.42,JPDB,,0000,0000,0000,,Кастер…
Dialogue: 0,0:19:03.86,0:19:07.46,JPDB,,0000,0000,0000,,Енді осыны аяқтайық.
Dialogue: 0,0:19:07.86,0:19:10.42,JPDB,,0000,0000,0000,,Мен сізге бұл бұйрық заклинаны беремін.
Dialogue: 0,0:19:22.08,0:19:25.42,JPDB,,0000,0000,0000,,Батыр рухы деген ұғымның өзін жоққа шығаратын бөгет пе?
Dialogue: 0,0:19:36.50,0:19:37.16,JPDB,,0000,0000,0000,,Тыңдап көрейік
Dialogue: 0,0:19:37.72,0:19:39.50,JPDB,,0000,0000,0000,,Ол қандай қызметші?
Dialogue: 0,0:19:40.16,0:19:43.72,JPDB,,0000,0000,0000,,Ассасин қызметшісі Кодзиро Сасаки
Dialogue: 0,0:19:45.68,0:19:48.76,JPDB,,0000,0000,0000,,Қатыспас бұрын өз аты-жөніңізді айту табиғи болар еді.
Dialogue: 0,0:19:49.14,0:19:52.68,JPDB,,0000,0000,0000,,Есіміңді бергеннен кейін атыңды қайтару рыцарьдың әдептілігі.
Dialogue: 0,0:19:53.42,0:19:55.22,JPDB,,0000,0000,0000,,Осыдан кейін мен сенен осы жерден кетуіңді сұраймын.
Dialogue: 0,0:19:56.24,0:19:57.04,JPDB,,0000,0000,0000,,Менің атым...
Dialogue: 0,0:19:57.10,0:19:57.72,JPDB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:20:00.54,0:20:04.44,JPDB,,0000,0000,0000,,Жауды білу үшін осы қылыштың өзі жеткілікті.
Dialogue: 0,0:20:05.85,0:20:09.48,JPDB,,0000,0000,0000,,Осы жерден өткіңіз келсе, басып өтіңіз.
Dialogue: 0,0:20:10.46,0:20:12.84,JPDB,,0000,0000,0000,,Пәрмен емлесін алып тастау
Dialogue: 0,0:20:13.52,0:20:17.94,JPDB,,0000,0000,0000,,Иә, мен команданың емлесін шеберіме жіберемін.
Dialogue: 0,0:20:18.42,0:20:22.72,JPDB,,0000,0000,0000,,Сабер тітіркендіргіш Берсеркерді жеңіп алайық.
Dialogue: 0,0:20:23.71,0:20:25.88,JPDB,,0000,0000,0000,,Пәрмен емлесін жою нені білдіреді?
Dialogue: 0,0:20:26.16,0:20:29.90,JPDB,,0000,0000,0000,,Бұл сонымен қатар сізден сиқырлы тізбекті алуды білдіреді.
Dialogue: 0,0:20:41.00,0:20:42.26,JPDB,,0000,0000,0000,,О, жақсы қыз.
Dialogue: 0,0:20:43.08,0:20:46.10,JPDB,,0000,0000,0000,,Мен мұндай күш-жігерді ұнатпаймын.
Dialogue: 0,0:20:58.94,0:21:02.82,JPDB,,0000,0000,0000,,Мен бұл ұзақ уақыт бойы өледі деп ойладым, бірақ бұл таңқаларлық тұрақты.
Dialogue: 0,0:21:04.37,0:21:06.40,JPDB,,0000,0000,0000,,Сіз неге?
Dialogue: 0,0:21:11.36,0:21:13.84,JPDB,,0000,0000,0000,,Не? Мен жай ғана өтіп бара жаттым.
Dialogue: 0,0:21:14.68,0:21:16.92,JPDB,,0000,0000,0000,,Денеңіз қалай?
Dialogue: 0,0:21:17.49,0:21:20.42,JPDB,,0000,0000,0000,,Егер бұл Кастердің жібі болса, мен дәл қазір бас тартар едім.
Dialogue: 0,0:21:22.84,0:21:23.50,JPDB,,0000,0000,0000,,бірақ көзге ілеспейтіндей жылдам
Dialogue: 0,0:21:24.02,0:21:25.22,JPDB,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:21:25.89,0:21:27.34,JPDB,,0000,0000,0000,,Қалғандарымен қалағаныңызды жасаңыз.
Dialogue: 0,0:21:27.47,0:21:29.02,JPDB,,0000,0000,0000,,Мен мұны айтқым келеді
Dialogue: 0,0:21:29.59,0:21:31.78,JPDB,,0000,0000,0000,,Біраз уақыт қозғалмаңыз
Dialogue: 0,0:21:32.40,0:21:34.48,JPDB,,0000,0000,0000,,Көп ойланбай қозғалсаң...
Dialogue: 0,0:21:35.47,0:21:36.88,JPDB,,0000,0000,0000,,Садақшы?
Dialogue: 0,0:21:38.45,0:21:40.68,JPDB,,0000,0000,0000,,Ассасин, сен не істеп жүрсің?
Dialogue: 0,0:21:41.08,0:21:45.10,JPDB,,0000,0000,0000,,Көріп тұрғаныңыздай, сізге қатты соққы болады.
Dialogue: 0,0:21:45.60,0:21:48.64,JPDB,,0000,0000,0000,,Әйелдің құмарлығын бақылау қиын.
Dialogue: 0,0:21:49.64,0:21:53.94,JPDB,,0000,0000,0000,,Менің ойымша, бұл сәл өрескел болады.
Dialogue: 0,0:23:26.72,0:23:28.46,JPDB,,0000,0000,0000,,Маған көмектесу үшін бірдеңе істей аласыз ба?
Dialogue: 0,0:23:28.50,0:23:30.50,JPDB,,0000,0000,0000,,Мен енді бұл ақымақ бәйбішеге шыдай алмаймын.
Dialogue: 0,0:23:30.54,0:23:34.20,JPDB,,0000,0000,0000,,Мені бақсы деп атаған адам тиісті жазасын алады.
Dialogue: 0,0:23:34.22,0:23:36.68,JPDB,,0000,0000,0000,,Тек қылыш шеберлігін қолдана отырып, асыл фантасм деңгейіне қосылған қызметші.
Dialogue: 0,0:23:36.72,0:23:39.90,JPDB,,0000,0000,0000,,Мен бұл сенімді бар күшіммен ашайын ба?
Dialogue: 0,0:23:41.40,0:23:47.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
