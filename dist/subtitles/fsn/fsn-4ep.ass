Dialogue: 0,0:01:09.97,0:01:19.50,JPOP,,0000,0000,0000,,Жүрегімді өртеп жіберген үмітсіздіктің қасында
Dialogue: 0,0:01:20.36,0:01:31.01,JPOP,,0000,0000,0000,,Сіз маған әрқашан күлкі сыйладыңыз, ол бәрін жоғалтты.
Dialogue: 1,0:01:31.07,0:01:33.96,JPOP,,0000,0000,0000,,Күңгірт дауыс
Dialogue: 2,0:01:33.96,0:01:36.39,JPOP,,0000,0000,0000,,Қол жетпейтін сөздер
Dialogue: 0,0:01:36.39,0:01:41.92,JPOP,,0000,0000,0000,,Қайта сүрініп кете жаздаған сайын
Dialogue: 0,0:01:41.92,0:01:46.18,JPOP,,0000,0000,0000,,Мен саған талай рет жабыстым
Dialogue: 0,0:01:46.18,0:01:51.77,JPOP,,0000,0000,0000,,Ақ, ақ, таза ақ болашақ
Dialogue: 0,0:01:51.77,0:01:57.11,JPOP,,0000,0000,0000,,Біздің жалғыз үмітіміз
Dialogue: 0,0:01:57.11,0:02:08.03,JPOP,,0000,0000,0000,,Дәл қазір менде бар соқыр сезім бар.
Dialogue: 0,0:02:08.03,0:02:13.26,JPOP,,0000,0000,0000,,Бір дұрыс жауап жоқ
Dialogue: 0,0:02:13.26,0:02:22.43,JPOP,,0000,0000,0000,,Мен өз ертеңімді іздедім
Dialogue: 0,0:22:10.21,0:22:16.01,JPED,,0000,0000,0000,,Екеуміз әлі ештеңе білмедік.
Dialogue: 0,0:22:16.37,0:22:22.52,JPED,,0000,0000,0000,,Мен сол қолыммен өткінші жоқтықпен ойнадым.
Dialogue: 0,0:22:22.53,0:22:28.31,JPED,,0000,0000,0000,,Кішкене қақтығыс қолдарыңызды байлайды
Dialogue: 0,0:22:28.64,0:22:32.93,JPED,,0000,0000,0000,,Болашақты алдау
Dialogue: 0,0:22:33.27,0:22:39.85,JPED,,0000,0000,0000,,Мен оны қалай қорғау керектігін де білмеймін
Dialogue: 0,0:22:39.85,0:22:45.67,JPED,,0000,0000,0000,,Бұл жалған идеал болса, бәрібір
Dialogue: 0,0:22:45.99,0:22:54.83,JPED,,0000,0000,0000,,Мен өзім өмір сүргім келеді
Dialogue: 0,0:22:54.89,0:23:01.56,JPED,,0000,0000,0000,,Уақыт өте келе кездестік
Dialogue: 0,0:23:01.56,0:23:07.57,JPED,,0000,0000,0000,,Мен сенімен бірге болған маған сенемін
Dialogue: 0,0:23:07.76,0:23:13.75,JPED,,0000,0000,0000,,Бұл арман ақырын аяқталғанша
Dialogue: 0,0:23:13.85,0:23:22.39,JPED,,0000,0000,0000,,Көгілдір күндерді ашып, тағдырыңмен күрес
Dialogue: 0,0:00:04.34,0:00:06.15,JPDB,,0000,0000,0000,,Маған әсер еткен жоқ
Dialogue: 0,0:00:06.58,0:00:08.42,JPDB,,0000,0000,0000,,Екеумізді де жеңетін нәрсе...
Dialogue: 0,0:00:08.78,0:00:10.79,JPDB,,0000,0000,0000,,Сіз нені сағынасыз?
Dialogue: 0,0:00:14.88,0:00:17.19,JPDB,,0000,0000,0000,,Біреуді бірден өлтіру қызық емес.
Dialogue: 0,0:00:18.00,0:00:20.22,JPDB,,0000,0000,0000,,Қоянды шегіне дейін қуды
Dialogue: 0,0:00:20.48,0:00:22.90,JPDB,,0000,0000,0000,,Қорыққан адамды өлтіретін нәрсе.
Dialogue: 0,0:00:23.22,0:00:26.70,JPDB,,0000,0000,0000,,Алайда Берсеркердің асыл фантасмасы ашылғаннан бері.
Dialogue: 0,0:00:26.90,0:00:29.54,JPDB,,0000,0000,0000,,Менің ойымша, мен бір шайқаста олардың біреуін өлтіруім керек еді.
Dialogue: 0,0:00:32.76,0:00:33.77,JPDB,,0000,0000,0000,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:00:34.22,0:00:37.42,JPDB,,0000,0000,0000,,Берсеркердің асыл фантасмасына қарсы шара жоқ.
Dialogue: 0,0:00:38.22,0:00:43.00,JPDB,,0000,0000,0000,,Иә, бір асыл фантас 3 күнде қалпына келтіріледі.
Dialogue: 0,0:00:43.50,0:00:47.24,JPDB,,0000,0000,0000,,Широ Эмияға мейірімділік танытады деп күтпедім, жас ханым...
Dialogue: 0,0:00:48.12,0:00:50.82,JPDB,,0000,0000,0000,,Мен сенің осындай нәрсені ойнайтыныңа сенімдімін.
Dialogue: 0,0:00:51.72,0:00:56.80,JPDB,,0000,0000,0000,,Мен сені Кирицугуның орнында қатты қинаймын.
Dialogue: 0,0:02:45.53,0:02:46.32,JPDB,,0000,0000,0000,,Сіз ояусыз ба?
Dialogue: 0,0:02:47.22,0:02:48.46,JPDB,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:02:51.54,0:02:53.36,JPDB,,0000,0000,0000,,О, қазір жара жақсы.
Dialogue: 0,0:02:53.70,0:02:55.10,JPDB,,0000,0000,0000,,Және...Тохсака
Dialogue: 0,0:02:55.64,0:02:56.82,JPDB,,0000,0000,0000,,Сіз неге...
Dialogue: 0,0:02:57.44,0:02:59.20,JPDB,,0000,0000,0000,,Жоқ, мен не істеп жатырмын...
Dialogue: 0,0:02:59.71,0:03:02.24,JPDB,,0000,0000,0000,,Егер сіз таңданбайтын болсаңыз, біреуіне немесе екіншісіне таң қалыңыз.
Dialogue: 0,0:03:02.99,0:03:03.60,JPDB,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:03:04.54,0:03:07.58,JPDB,,0000,0000,0000,,Мен ес-түссіз қалғанда мені осында апардың.
Dialogue: 0,0:03:09.32,0:03:11.74,JPDB,,0000,0000,0000,,Менің ойым көрінгеннен де жылдам
Dialogue: 0,0:03:12.03,0:03:14.08,JPDB,,0000,0000,0000,,Қызықты Қызықты
Dialogue: 0,0:03:14.87,0:03:15.54,JPDB,,0000,0000,0000,,Секір!!
Dialogue: 0,0:03:15.71,0:03:16.44,JPDB,,0000,0000,0000,,Тохсака
Dialogue: 0,0:03:17.16,0:03:19.40,JPDB,,0000,0000,0000,,Кеш болды, бірақ рахмет.
Dialogue: 0,0:03:21.21,0:03:22.00,JPDB,,0000,0000,0000,,Қазірше тек сен мен мен ғана оралдық.
Dialogue: 0,0:03:22.68,0:03:24.68,JPDB,,0000,0000,0000,,Неліктен ол жерде садақ бар?
Dialogue: 0,0:03:24.96,0:03:27.50,JPDB,,0000,0000,0000,,Жоқ, өйткені сен маған көмектесер едің.
Dialogue: 0,0:03:27.72,0:03:30.08,JPDB,,0000,0000,0000,,Дұшпандарыңа рахмет айтпа
Dialogue: 0,0:03:30.62,0:03:32.94,JPDB,,0000,0000,0000,,Қасиетті Граил соғысы бір-бірін өлтіруге арналған.
Dialogue: 0,0:03:33.39,0:03:36.88,JPDB,,0000,0000,0000,,Сонда Тохсақа мені неге өлтірмеді?
Dialogue: 0,0:03:37.81,0:03:40.52,JPDB,,0000,0000,0000,,Мен... жай ғана маған ұнамады.
Dialogue: 0,0:03:40.90,0:03:43.30,JPDB,,0000,0000,0000,,Біреуге ұйықтап жатқанда қол көтерген дұрыс емес.
Dialogue: 0,0:03:44.05,0:03:46.28,JPDB,,0000,0000,0000,,Бұл менің кінәм.
Dialogue: 0,0:03:46.62,0:03:49.90,JPDB,,0000,0000,0000,,Бәлкім, мен сенен күштімін деп сақамды тастаған шығармын.
Dialogue: 0,0:03:50.40,0:03:52.98,JPDB,,0000,0000,0000,,Олай десеңіз, жүрегім босқа кетті.
Dialogue: 0,0:03:53.29,0:03:54.88,JPDB,,0000,0000,0000,,Жүректің майлылығы...
Dialogue: 0,0:03:55.28,0:03:57.90,JPDB,,0000,0000,0000,,Бұл Тохсака семіз дегенді білдіре ме?
Dialogue: 0,0:03:59.28,0:04:01.16,JPDB,,0000,0000,0000,,Сіз бір қызық нәрсе айтасыз.
Dialogue: 0,0:04:10.47,0:04:11.32,JPDB,,0000,0000,0000,,Секір!!
Dialogue: 0,0:04:11.64,0:04:13.58,JPDB,,0000,0000,0000,,Келесі кездескенімізде жау боламыз.
Dialogue: 0,0:04:13.96,0:04:15.76,JPDB,,0000,0000,0000,,Ол кезде дайын болыңыз.
Dialogue: 0,0:04:21.10,0:04:23.40,JPDB,,0000,0000,0000,,Ақырында оралдым деп ойлаймын, ұстаз.
Dialogue: 0,0:04:24.94,0:04:27.22,JPDB,,0000,0000,0000,,Үйге құр қол баруға амал жоқ.
Dialogue: 0,0:04:27.84,0:04:29.80,JPDB,,0000,0000,0000,,Біз жоғалтқан ұпайларымызды қалпына келтіруіміз керек.
Dialogue: 0,0:04:38.80,0:04:39.88,JPDB,,0000,0000,0000,,Сабер
Dialogue: 0,0:04:58.37,0:05:00.22,JPDB,,0000,0000,0000,,Сабер мұнда не істеп жүрсің?
Dialogue: 0,0:05:00.61,0:05:02.14,JPDB,,0000,0000,0000,,Мен денемді тынықтырдым.
Dialogue: 0,0:05:02.90,0:05:05.68,JPDB,,0000,0000,0000,,Тым болмаса өз-өзіме көңіл бөлгім келді.
Dialogue: 0,0:05:06.36,0:05:08.18,JPDB,,0000,0000,0000,,Ширу, жарақаттарың қалай?
Dialogue: 0,0:05:08.50,0:05:10.74,JPDB,,0000,0000,0000,,А, қазір бәрі жақсы.
Dialogue: 0,0:05:11.68,0:05:12.58,JPDB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:05:13.39,0:05:15.13,JPDB,,0000,0000,0000,,Сонда да мені қатты таң қалдырды.
Dialogue: 0,0:05:15.94,0:05:18.70,JPDB,,0000,0000,0000,,Өзіне дауа болу деген нені білдіреді?
Dialogue: 0,0:05:22.66,0:05:26.86,JPDB,,0000,0000,0000,,Ширу, мен кеше түнде бір нәрсе айтқым келеді.
Dialogue: 0,0:05:27.76,0:05:31.20,JPDB,,0000,0000,0000,,Ұстаз, бұлай әрекет ету сізге қиын болар еді.
Dialogue: 0,0:05:32.36,0:05:34.20,JPDB,,0000,0000,0000,,Бұған көмектесу мүмкін емес.
Dialogue: 0,0:05:34.40,0:05:36.38,JPDB,,0000,0000,0000,,Саберге қауіп төнді.
Dialogue: 0,0:05:36.84,0:05:41.42,JPDB,,0000,0000,0000,,Сіз жаңа кездескен қызметшіге ашық болдыңыз ба?
Dialogue: 0,0:05:42.04,0:05:43.88,JPDB,,0000,0000,0000,,Ақыр соңында, сіз қол алысып жібердіңіз ғой?
Dialogue: 0,0:05:50.76,0:05:54.40,JPDB,,0000,0000,0000,,Қызметші ретінде Ширудың сөзі мені қуантады.
Dialogue: 0,0:05:55.63,0:05:56.34,JPDB,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:05:57.86,0:05:59.28,JPDB,,0000,0000,0000,,Болашақта мұндай әрекеттен аулақ болыңыз.
Dialogue: 0,0:05:59.90,0:06:02.08,JPDB,,0000,0000,0000,,Мен сізден Қасиетті Граалды алуыңызды сұраймын.
Dialogue: 0,0:06:02.58,0:06:05.88,JPDB,,0000,0000,0000,,Сабер де Қасиетті Граалды қалайды...
Dialogue: 0,0:06:06.46,0:06:09.78,JPDB,,0000,0000,0000,,Иә, тілегімді орындау үшін
Dialogue: 0,0:06:14.94,0:06:16.82,JPDB,,0000,0000,0000,,Біз қызметшілер батыр рухтармыз.
Dialogue: 0,0:06:17.72,0:06:19.14,JPDB,,0000,0000,0000,,Өйткені ол батыр рух
Dialogue: 0,0:06:19.68,0:06:23.84,JPDB,,0000,0000,0000,,Өзіңіздің шынайы болмысыңызды ашу - сіздің әлсіз жақтарыңызды көрсету.
Dialogue: 0,0:06:25.42,0:06:29.52,JPDB,,0000,0000,0000,,Өзіңізді Сабер деп атай отырып, шын есіміңізді жасырып жүргеніңіз осы ма?
Dialogue: 0,0:06:30.05,0:06:30.50,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:06:31.00,0:06:33.86,JPDB,,0000,0000,0000,,Қасиетті Граилға шақырылған жеті қызметші бар.
Dialogue: 0,0:06:34.22,0:06:37.56,JPDB,,0000,0000,0000,,Олардың барлығы сыныпқа сәйкес таңдалады.
Dialogue: 0,0:06:37.94,0:06:41.62,JPDB,,0000,0000,0000,,Сынып семсерші ме, әлде садақшы ма?
Dialogue: 0,0:06:41.88,0:06:42.64,JPDB,,0000,0000,0000,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:06:43.30,0:06:46.76,JPDB,,0000,0000,0000,,Қасиетті Граиль үшін алдын ала жеті ыдыс дайындалды.
Dialogue: 0,0:06:47.02,0:06:51.12,JPDB,,0000,0000,0000,,Барлық дәуірлерден тек ыдысқа сай келетін батыр рухтар шақырылған.
Dialogue: 0,0:06:52.22,0:06:53.88,JPDB,,0000,0000,0000,,Бұл 7 сынып
Dialogue: 0,0:06:54.81,0:06:55.56,JPDB,,0000,0000,0000,,Сабер
Dialogue: 0,0:06:56.18,0:06:56.82,JPDB,,0000,0000,0000,,Лансер
Dialogue: 0,0:06:57.46,0:06:58.08,JPDB,,0000,0000,0000,,Садақшы
Dialogue: 0,0:06:58.68,0:06:59.32,JPDB,,0000,0000,0000,,Шабандоз
Dialogue: 0,0:06:59.88,0:07:00.54,JPDB,,0000,0000,0000,,Кастер
Dialogue: 0,0:07:01.12,0:07:01.71,JPDB,,0000,0000,0000,,Ассасин
Dialogue: 0,0:07:02.38,0:07:03.42,JPDB,,0000,0000,0000,,Берсеркер
Dialogue: 0,0:07:04.76,0:07:05.80,JPDB,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:07:06.46,0:07:09.24,JPDB,,0000,0000,0000,,Өйткені Сабыр қылыштан озатын батыр.
Dialogue: 0,0:07:09.52,0:07:11.81,JPDB,,0000,0000,0000,,Сонда сені Сабер деп атады ма?
Dialogue: 0,0:07:12.26,0:07:16.34,JPDB,,0000,0000,0000,,Алайда, екінші жағынан, бұл да Сабер класының кемшілігі.
Dialogue: 0,0:07:16.90,0:07:17.62,JPDB,,0000,0000,0000,,Кемшіліктері?
Dialogue: 0,0:07:18.16,0:07:22.12,JPDB,,0000,0000,0000,,Мысалы, егер жау сізге қарағанда қоян-қолтық ұрыста жақсырақ болса.
Dialogue: 0,0:07:22.46,0:07:23.96,JPDB,,0000,0000,0000,,Ширу не істер еді?
Dialogue: 0,0:07:24.66,0:07:27.48,JPDB,,0000,0000,0000,,Бетпе-бет күрессең де жеңе алмасаң
Dialogue: 0,0:07:28.98,0:07:31.04,JPDB,,0000,0000,0000,,Мен заңды ұрыс бастамаймын.
Dialogue: 0,0:07:31.70,0:07:32.92,JPDB,,0000,0000,0000,,Бұл сізге де, маған да тиімді мәміле, иә?
Dialogue: 0,0:07:33.34,0:07:35.58,JPDB,,0000,0000,0000,,Сонымен қатар, бізде асыл фантасма бар.
Dialogue: 0,0:07:36.38,0:07:38.92,JPDB,,0000,0000,0000,,Лансердің найзасы немесе садақшының садағы
Dialogue: 0,0:07:39.57,0:07:42.22,JPDB,,0000,0000,0000,,Сондай-ақ, менің семсерім т.б. асыл фантасма санатына жатады.
Dialogue: 0,0:07:42.86,0:07:45.80,JPDB,,0000,0000,0000,,Noble Phantasm – қызметшінің тұлпары
Dialogue: 0,0:07:46.12,0:07:50.31,JPDB,,0000,0000,0000,,Дегенмен, асыл фантасманы іске қосу үшін сиқырлы күштің айтарлықтай мөлшері қажет.
Dialogue: 0,0:07:50.88,0:07:53.70,JPDB,,0000,0000,0000,,Басқаша айтқанда, оны абайсызда қолдануға болмайды.
Dialogue: 0,0:07:54.26,0:07:55.14,JPDB,,0000,0000,0000,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:07:55.58,0:07:59.72,JPDB,,0000,0000,0000,,Сондай-ақ, оны іске қосқан кезде асыл фантасманың шын атын айту керек.
Dialogue: 0,0:08:00.32,0:08:03.70,JPDB,,0000,0000,0000,,Қызметшінің шынайы тұлғасы ашылып қалу қаупі бар.
Dialogue: 0,0:08:04.24,0:08:07.38,JPDB,,0000,0000,0000,,Сол себепті Сабер қылышын көрінбейтін етіп қояды ма?
Dialogue: 0,0:08:08.84,0:08:12.44,JPDB,,0000,0000,0000,,Ширу, менің осы мәселе бойынша өтінішім бар.
Dialogue: 0,0:08:13.20,0:08:14.94,JPDB,,0000,0000,0000,,Менің шын атым
Dialogue: 0,0:08:15.72,0:08:19.02,JPDB,,0000,0000,0000,,Бастапқыда қызметшілер өздерінің шын есімдерін қожайындарына ғана ашады.
Dialogue: 0,0:08:19.08,0:08:20.30,JPDB,,0000,0000,0000,,Қарсы шараларды әзірлеу
Dialogue: 0,0:08:20.86,0:08:23.82,JPDB,,0000,0000,0000,,Алайда Ширу сиқыршы ретінде тәжірибесіз.
Dialogue: 0,0:08:24.46,0:08:28.54,JPDB,,0000,0000,0000,,Жақсы сиқыршы Ширудың ойын оқи алатын еді.
Dialogue: 0,0:08:29.85,0:08:30.54,JPDB,,0000,0000,0000,,Сол адам – бәрінен әлсіз
Dialogue: 0,0:08:31.70,0:08:34.02,JPDB,,0000,0000,0000,,Бұл сіздің атыңызды аша алмайсыз дегенді білдіре ме?
Dialogue: 0,0:08:37.77,0:08:38.42,JPDB,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:08:39.00,0:08:43.08,JPDB,,0000,0000,0000,,Сабердің асыл фантасмасын қолдану Сабердің өз шешіміне қалдырылады.
Dialogue: 0,0:08:45.14,0:08:47.52,JPDB,,0000,0000,0000,,Егер сіз мұны шешсеңіз, тамақ ішейік.
Dialogue: 0,0:08:48.76,0:08:51.32,JPDB,,0000,0000,0000,,Иә, ол киімдерге не болды?
Dialogue: 0,0:08:51.72,0:08:53.42,JPDB,,0000,0000,0000,,Бұл Риннің маған бергені.
Dialogue: 0,0:08:54.68,0:08:57.76,JPDB,,0000,0000,0000,,Мен рух бола алмағандықтан, күнделікті киім керек деп ойлаймын.
Dialogue: 0,0:08:58.96,0:09:02.04,JPDB,,0000,0000,0000,,Ол сондай әйелдік киім киеді.
Dialogue: 0,0:09:10.55,0:09:13.38,JPDB,,0000,0000,0000,,Мен аз да болса сиқырлы күштің қалдықтарын сезінемін.
Dialogue: 0,0:09:14.28,0:09:17.19,JPDB,,0000,0000,0000,,Демек, бұл жай ғана газдың ағуынан болған апат емес еді.
Dialogue: 0,0:09:18.26,0:09:20.20,JPDB,,0000,0000,0000,,Қарапайым халықты тарту...
Dialogue: 0,0:09:25.90,0:09:26.88,JPDB,,0000,0000,0000,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:09:27.29,0:09:30.27,JPDB,,0000,0000,0000,,Бастапқыда оны шебер қамтамасыз ету керек еді.
Dialogue: 0,0:09:30.42,0:09:32.10,JPDB,,0000,0000,0000,,Мен жай ғана жетілмегенмін...
Dialogue: 0,0:09:33.20,0:09:37.06,JPDB,,0000,0000,0000,,Шаршаудан кейін біраз ұйықтау арқылы алдын алуға болады.
Dialogue: 0,0:09:43.18,0:09:45.24,JPDB,,0000,0000,0000,,Иә, мен Эмиямын.
Dialogue: 0,0:09:45.42,0:09:48.30,JPDB,,0000,0000,0000,,Сәлем, сәлем, мен Фуджимурамын.
Dialogue: 0,0:09:48.77,0:09:49.82,JPDB,,0000,0000,0000,,Фудзи-ни
Dialogue: 0,0:09:50.34,0:09:52.57,JPDB,,0000,0000,0000,,Не? Менің уақытым жоқ.
Dialogue: 0,0:09:52.60,0:09:54.89,JPDB,,0000,0000,0000,,Менің де уақытым жоқ.
Dialogue: 0,0:09:55.22,0:09:59.60,JPDB,,0000,0000,0000,,Мен бүгін оқушыларымды күту үшін демалысты қайта аламын.
Dialogue: 0,0:09:59.82,0:10:04.66,JPDB,,0000,0000,0000,,Сондықтан мен түскі ас қорапшасын жасап, оны садақ ату алаңына мүмкіндігінше тезірек жеткізіп бердім.
Dialogue: 0,0:10:05.21,0:10:05.88,JPDB,,0000,0000,0000,,Бар болғаны
Dialogue: 0,0:10:11.90,0:10:13.12,JPDB,,0000,0000,0000,,Сәлем Сабер
Dialogue: 0,0:10:13.88,0:10:17.04,JPDB,,0000,0000,0000,,Шеберлер назар аударудан қашады, солай ма?
Dialogue: 0,0:10:17.98,0:10:20.22,JPDB,,0000,0000,0000,,Кешегі түн сияқты ештеңе жоқ
Dialogue: 0,0:10:20.80,0:10:23.02,JPDB,,0000,0000,0000,,Дегенмен, кейбір күтпеген жағдайлар болуы мүмкін.
Dialogue: 0,0:10:23.88,0:10:26.62,JPDB,,0000,0000,0000,,Шируды сыртта жалғыз қалдыру қауіпті.
Dialogue: 0,0:10:33.36,0:10:36.38,JPDB,,0000,0000,0000,,Сабер Егер сізді біреу тоқтатса
Dialogue: 0,0:10:36.50,0:10:38.44,JPDB,,0000,0000,0000,,Ештеңе айтпай басыңды шайқа.
Dialogue: 0,0:10:39.06,0:10:42.46,JPDB,,0000,0000,0000,,Жапон тілін түсінбейтін болып көрінсеңіз жақсы.
Dialogue: 0,0:10:45.22,0:10:45.90,JPDB,,0000,0000,0000,,Сабер?
Dialogue: 0,0:10:46.62,0:10:48.74,JPDB,,0000,0000,0000,,Мен сиқырлы күштің қалдықтарын сезінемін.
Dialogue: 0,0:10:49.62,0:10:51.30,JPDB,,0000,0000,0000,,Мені мазалайтын біртүрлі сезім бар.
Dialogue: 0,0:10:51.70,0:10:53.42,JPDB,,0000,0000,0000,,Әзірге ешқандай қауіп жоқ сияқты.
Dialogue: 0,0:10:53.68,0:10:56.52,JPDB,,0000,0000,0000,,Ешқандай қауіп жоқ дедім.
Dialogue: 0,0:11:03.11,0:11:03.56,JPDB,,0000,0000,0000,,Незуко! Жоқ, жасама!
Dialogue: 0,0:11:05.06,0:11:07.72,JPDB,,0000,0000,0000,,Мен Фудзи-ниге бенто жеткізуге келдім.
Dialogue: 0,0:11:08.58,0:11:10.72,JPDB,,0000,0000,0000,,Кешіріңіз, маған қоңырау шала аласыз ба?
Dialogue: 0,0:11:15.62,0:11:17.62,JPDB,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:11:20.16,0:11:22.24,JPDB,,0000,0000,0000,,Мен құтқарылдым.
Dialogue: 0,0:11:22.46,0:11:24.44,JPDB,,0000,0000,0000,,Ол маған түскі қорап әкелгенін айтты.
Dialogue: 0,0:11:24.84,0:11:28.88,JPDB,,0000,0000,0000,,Фуджимура мырза Қарным ашып, көңілім толқығандықтан қиындыққа тап болдым.
Dialogue: 0,0:11:29.02,0:11:33.46,JPDB,,0000,0000,0000,,Сондай-ақ таңертең Фудзи-нидің бентосын тексеру керек.
Dialogue: 0,0:11:33.60,0:11:36.44,JPDB,,0000,0000,0000,,Жоқ, мен де шаршадым.
Dialogue: 0,0:11:36.56,0:11:37.94,JPDB,,0000,0000,0000,,Синдзи туралы айтып тұрсың ба?
Dialogue: 0,0:11:38.62,0:11:39.66,JPDB,,0000,0000,0000,,Бүгін ол туралы не деуге болады?
Dialogue: 0,0:11:39.78,0:11:40.78,JPDB,,0000,0000,0000,,Босаңсу
Dialogue: 0,0:11:40.88,0:11:43.18,JPDB,,0000,0000,0000,,Жаңадан келген әйел мұны істей алар еді.
Dialogue: 0,0:11:43.42,0:11:44.64,JPDB,,0000,0000,0000,,Одан да көп, Эмия
Dialogue: 0,0:11:45.06,0:11:46.98,JPDB,,0000,0000,0000,,Майдандағы адам кім болды?
Dialogue: 0,0:11:47.14,0:11:49.08,JPDB,,0000,0000,0000,,Ол ғажайып сұлу еді, сіз оны танисыз ба?
Dialogue: 0,0:11:49.24,0:11:52.36,JPDB,,0000,0000,0000,,Түсіндіру қиын.
Dialogue: 0,0:11:52.70,0:11:54.66,JPDB,,0000,0000,0000,,Онда болды ма?
Dialogue: 0,0:12:27.50,0:12:28.54,JPDB,,0000,0000,0000,,Катсураги мырза
Dialogue: 0,0:12:34.20,0:12:34.88,JPDB,,0000,0000,0000,,Эмия
Dialogue: 0,0:12:36.20,0:12:37.88,JPDB,,0000,0000,0000,,Бұл қыз менің танысым.
Dialogue: 0,0:12:38.20,0:12:40.50,JPDB,,0000,0000,0000,,Айтайын дегенім, мен оны көруге келдім...
Dialogue: 0,0:12:40.64,0:12:43.18,JPDB,,0000,0000,0000,,Бұл студенттің шетелден оқуға түсуі бірінші рет.
Dialogue: 0,0:12:45.64,0:12:47.96,JPDB,,0000,0000,0000,,Тіркелсең, басқалардың көзіне түсесің.
Dialogue: 0,0:12:48.46,0:12:51.22,JPDB,,0000,0000,0000,,Эмия: Егер сіз біреуді танитын болсаңыз, абай болыңыз.
Dialogue: 0,0:12:52.40,0:12:53.60,JPDB,,0000,0000,0000,,А... иә
Dialogue: 0,0:12:55.92,0:12:57.12,JPDB,,0000,0000,0000,,Айтпақшы, Эмия
Dialogue: 0,0:13:00.06,0:13:02.42,JPDB,,0000,0000,0000,,Мектеп ішінде аяқ киімге қатаң тыйым салынады.
Dialogue: 0,0:13:08.02,0:13:11.14,JPDB,,0000,0000,0000,,Широ: Бұрынғы мұғалім туралы...
Dialogue: 0,0:13:11.40,0:13:13.38,JPDB,,0000,0000,0000,,Катсураги мырзаға не болды?
Dialogue: 0,0:13:13.70,0:13:17.58,JPDB,,0000,0000,0000,,Жоқ.Алғашында өзімді қарапайым адам емес сияқты сезіндім.
Dialogue: 0,0:13:18.20,0:13:21.34,JPDB,,0000,0000,0000,,Ол сиқыршы емес, қан иісін де сезбейді.
Dialogue: 0,0:13:21.82,0:13:25.10,JPDB,,0000,0000,0000,,Катсураги мырза сиқыршы болса, мен де таң қалар едім.
Dialogue: 0,0:13:25.28,0:13:28.08,JPDB,,0000,0000,0000,,Бірақ сіз қарапайым адам емессіз дегенді қалай түсінесіз?
Dialogue: 0,0:13:28.32,0:13:31.72,JPDB,,0000,0000,0000,,Оның тыныс алуы өте табиғи және тұрақты болды.
Dialogue: 0,0:13:32.34,0:13:34.46,JPDB,,0000,0000,0000,,Мен шынымды айтсам қатты әсер еттім.
Dialogue: 0,0:13:35.00,0:13:36.66,JPDB,,0000,0000,0000,,Әр қадамда ысырап болмайды.
Dialogue: 0,0:13:37.36,0:13:40.84,JPDB,,0000,0000,0000,,Егер ол мұғалім болса, шәкірттері өздерін қауіпсіз сезінеді.
Dialogue: 0,0:13:41.74,0:13:44.06,JPDB,,0000,0000,0000,,Келесі жерге барамыз ба?
Dialogue: 0,0:13:44.26,0:13:47.32,JPDB,,0000,0000,0000,,Сәл күтіңіз, мектепті аралайсыз ба?
Dialogue: 0,0:13:47.60,0:13:49.98,JPDB,,0000,0000,0000,,Иә Қауіпсіз болғанша
Dialogue: 0,0:13:57.64,0:13:58.76,JPDB,,0000,0000,0000,,Мм, мм
Dialogue: 0,0:13:59.06,0:14:00.62,JPDB,,0000,0000,0000,,Сол Эмиия
Dialogue: 0,0:14:01.14,0:14:02.76,JPDB,,0000,0000,0000,,Мен әлі мектепте оқитынмын.
Dialogue: 0,0:14:03.42,0:14:04.42,JPDB,,0000,0000,0000,,Бітті ме?
Dialogue: 0,0:14:04.76,0:14:07.12,JPDB,,0000,0000,0000,,Иә, біз бүгін ерте ашамыз.
Dialogue: 0,0:14:07.50,0:14:09.38,JPDB,,0000,0000,0000,,Түсіндім, сен шаршадың.
Dialogue: 0,0:14:13.00,0:14:14.16,JPDB,,0000,0000,0000,,Сәлем Эмия
Dialogue: 0,0:14:15.74,0:14:17.46,JPDB,,0000,0000,0000,,Мен садақ ату үйірмесіне қайтып бармаймын.
Dialogue: 0,0:14:20.82,0:14:24.10,JPDB,,0000,0000,0000,,Фуджимура мырза сізді сендіруге тырысатын сияқты.
Dialogue: 0,0:14:24.54,0:14:25.66,JPDB,,0000,0000,0000,,Сіз шынымен не ойлайсыз?
Dialogue: 0,0:14:27.74,0:14:28.94,JPDB,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:14:30.12,0:14:33.69,JPDB,,0000,0000,0000,,Бәрі тынышталғанда, мен қайтадан әрекет етуді ойлаймын.
Dialogue: 0,0:14:33.92,0:14:36.20,JPDB,,0000,0000,0000,,Иә, бұл біраз таң қалдырады.
Dialogue: 0,0:14:36.50,0:14:37.26,JPDB,,0000,0000,0000,,Таңқаларлық?
Dialogue: 0,0:14:38.04,0:14:40.94,JPDB,,0000,0000,0000,,Мен кіргеннен бері құбыжық сияқты болды.
Dialogue: 0,0:14:41.20,0:14:44.06,JPDB,,0000,0000,0000,,Нысанаға дәл тигізу сізді қызықтырмай ма?
Dialogue: 0,0:14:44.42,0:14:47.18,JPDB,,0000,0000,0000,,Болжауға құлқың жоқ сияқты.
Dialogue: 0,0:14:47.78,0:14:50.38,JPDB,,0000,0000,0000,,Сондықтан мен жалығып кеттім деп ойлап қалдым.
Dialogue: 0,0:14:50.96,0:14:54.28,JPDB,,0000,0000,0000,,Эмиияның ешнәрсеге құштарлығы жоқ сияқты.
Dialogue: 0,0:14:54.84,0:14:55.80,JPDB,,0000,0000,0000,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:14:56.30,0:14:58.12,JPDB,,0000,0000,0000,,Мен Шинджи деп айтпас едім.
Dialogue: 0,0:14:58.28,0:15:00.10,JPDB,,0000,0000,0000,,Неліктен аздап қызықтырақ нәрсе жасамасқа?
Dialogue: 0,0:15:03.04,0:15:04.36,JPDB,,0000,0000,0000,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:15:05.13,0:15:08.24,JPDB,,0000,0000,0000,,Бұл сіздің сыныптастарыңызды алаңдататындай маңызды болды ма?
Dialogue: 0,0:15:08.53,0:15:11.38,JPDB,,0000,0000,0000,,Себебі Эмия күлмейді.
Dialogue: 0,0:15:22.32,0:15:24.46,JPDB,,0000,0000,0000,,Сонымен оқу-жаттығу жиыны туралы.
Dialogue: 0,0:15:25.02,0:15:26.46,JPDB,,0000,0000,0000,,Барлығы шулағанда
Dialogue: 0,0:15:26.57,0:15:30.04,JPDB,,0000,0000,0000,,Ерекше әзіліме күлмеген жалғыз Эмия болды.
Dialogue: 0,0:15:31.65,0:15:33.64,JPDB,,0000,0000,0000,,Бұл менің тамырымда әлі де бар.
Dialogue: 0,0:15:34.49,0:15:37.30,JPDB,,0000,0000,0000,,Ал, мен қызметкерлер бөлмесіне тоқтайын.
Dialogue: 0,0:15:37.61,0:15:38.72,JPDB,,0000,0000,0000,,Ертең кездескенше
Dialogue: 0,0:15:43.36,0:15:44.52,JPDB,,0000,0000,0000,,Мизуцу…
Dialogue: 0,0:15:58.64,0:16:01.94,JPDB,,0000,0000,0000,,Ол қыз менің соңымнан ереді.
Dialogue: 0,0:16:02.74,0:16:05.08,JPDB,,0000,0000,0000,,Сіз өз ағаңызбен таныссыз ба?
Dialogue: 0,0:16:05.44,0:16:07.96,JPDB,,0000,0000,0000,,А, мен әкемді білемін.
Dialogue: 0,0:16:08.20,0:16:09.62,JPDB,,0000,0000,0000,,Кирицугу?
Dialogue: 0,0:16:10.18,0:16:13.60,JPDB,,0000,0000,0000,,Сонымен, мен Кирицугу деген қызға қонаққа келдім.
Dialogue: 0,0:16:13.70,0:16:14.98,JPDB,,0000,0000,0000,,Ах~ Ол тірі!
Dialogue: 0,0:16:15.58,0:16:17.72,JPDB,,0000,0000,0000,,Бүгіннен бастап біраз уақыт менің үйімде тұрасың.
Dialogue: 0,0:16:17.88,0:16:19.18,JPDB,,0000,0000,0000,,Маған жақсылық жасаңыз.
Dialogue: 0,0:16:26.52,0:16:30.02,JPDB,,0000,0000,0000,,Өмір сүру деген ол қызбен бірге тұру дегенді білдіре ме?
Dialogue: 0,0:16:30.13,0:16:31.34,JPDB,,0000,0000,0000,,Бірге тұрмау
Dialogue: 0,0:16:31.54,0:16:34.84,JPDB,,0000,0000,0000,,Сабер аз ғана уақыт қалады.
Dialogue: 0,0:16:35.04,0:16:37.58,JPDB,,0000,0000,0000,,Ол кісі Сабер-сан деп аталады ма?
Dialogue: 0,0:16:38.70,0:16:41.10,JPDB,,0000,0000,0000,,Сакура да тіл табыса алса пайдалы болар еді.
Dialogue: 0,0:16:42.60,0:16:44.86,JPDB,,0000,0000,0000,,Иә, бұл жақсы.
Dialogue: 0,0:16:45.37,0:16:46.38,JPDB,,0000,0000,0000,,Фуджимура мырза
Dialogue: 0,0:16:46.85,0:16:50.40,JPDB,,0000,0000,0000,,Фуджимура мырза Сабер мырзаның қалуына рұқсат бере ме?
Dialogue: 0,0:16:51.78,0:16:54.56,JPDB,,0000,0000,0000,,Мұғалім ретінде мен, әрине, сырттаймын.
Dialogue: 0,0:16:54.82,0:16:58.80,JPDB,,0000,0000,0000,,Кирицугуге арқа сүйеген баланы қоя алмаймын...
Dialogue: 0,0:17:08.08,0:17:09.44,JPDB,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:17:09.54,0:17:11.34,JPDB,,0000,0000,0000,,Егер сіз оны үйде тұру деп ойласаңыз
Dialogue: 0,0:17:56.34,0:17:59.24,JPDB,,0000,0000,0000,,Мен оны жасауға көп күш жұмсасам да...
Dialogue: 0,0:17:59.84,0:18:02.04,JPDB,,0000,0000,0000,,Сакура да көмектесуге келмейді.
Dialogue: 0,0:18:02.60,0:18:05.76,JPDB,,0000,0000,0000,,Фудзи-ни, шие гүлдерін шығарып салу уақыты келді.
Dialogue: 0,0:18:07.81,0:18:08.84,JPDB,,0000,0000,0000,,Фудзи-ни
Dialogue: 0,0:18:13.50,0:18:14.94,JPDB,,0000,0000,0000,,О, сигналы келіп жатыр, келіп жатыр
Dialogue: 0,0:18:15.84,0:18:18.70,JPDB,,0000,0000,0000,,Сіз мұны естіген жоқсыз ба, Фуджимура мырза?
Dialogue: 0,0:18:18.86,0:18:20.70,JPDB,,0000,0000,0000,,Кешіріңіз, бірақ қабылданбады
Dialogue: 0,0:18:20.84,0:18:23.70,JPDB,,0000,0000,0000,,Мен Сакура-чанды біраз уақытқа жібере алмаймын.
Dialogue: 0,0:18:23.76,0:18:24.77,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:18:28.76,0:18:31.22,JPDB,,0000,0000,0000,,Мен де бүгіннен бастап осында боламын.
Dialogue: 0,0:18:31.76,0:18:32.34,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:32.97,0:18:34.50,JPDB,,0000,0000,0000,,Сакура-чан ше?
Dialogue: 0,0:18:35.04,0:18:38.56,JPDB,,0000,0000,0000,,Уайымдамаңыз, мен үйдегілердің барлығына хабарласамын.
Dialogue: 0,0:18:39.46,0:18:40.98,JPDB,,0000,0000,0000,,Иә, өтінемін.
Dialogue: 0,0:18:41.30,0:18:43.32,JPDB,,0000,0000,0000,,Фуджимура мырза сенімді.
Dialogue: 0,0:18:45.30,0:18:48.56,JPDB,,0000,0000,0000,,Жарайды, онда артқы жағындағы татами бөлмесін қолданайық.
Dialogue: 0,0:18:48.77,0:18:50.28,JPDB,,0000,0000,0000,,Футондар өте көп.
Dialogue: 0,0:18:50.81,0:18:52.50,JPDB,,0000,0000,0000,,Сабер-чан да жақсы.
Dialogue: 0,0:19:56.74,0:19:58.32,JPDB,,0000,0000,0000,,Бұл қандай иіс?
Dialogue: 0,0:19:58.86,0:20:00.18,JPDB,,0000,0000,0000,,Бәлкім, бақсының жақпауы
Dialogue: 0,0:20:00.62,0:20:03.70,JPDB,,0000,0000,0000,,Менің ойымша, бұл Umbelliferae отбасының махаббатын бұзады.
Dialogue: 0,0:20:04.50,0:20:06.94,JPDB,,0000,0000,0000,,Олай болса, басқа адам әйел ме?
Dialogue: 0,0:20:07.66,0:20:10.02,JPDB,,0000,0000,0000,,Тіпті қызметші болу да жеткілікті болар еді деп ойлау.
Dialogue: 0,0:20:10.10,0:20:11.02,JPDB,,0000,0000,0000,,Терең тамырлар
Dialogue: 0,0:20:11.78,0:20:14.34,JPDB,,0000,0000,0000,,Жазба жазуға болмайды, терезені ашамын.
Dialogue: 0,0:20:21.74,0:20:24.00,JPDB,,0000,0000,0000,,Рюдоудзи храмынан ағып жатқан ағын ба?
Dialogue: 0,0:20:24.52,0:20:25.30,JPDB,,0000,0000,0000,,Иә.
Dialogue: 0,0:20:25.77,0:20:28.34,JPDB,,0000,0000,0000,,Барлық ұрланған рухтар тауға кетті.
Dialogue: 0,0:20:29.02,0:20:31.94,JPDB,,0000,0000,0000,,Комада болған оқиғаға кінәлі Кастер болса керек.
Dialogue: 0,0:20:32.54,0:20:34.80,JPDB,,0000,0000,0000,,Рюдоудзи храмында ұя салатын бақсы ма?
Dialogue: 0,0:20:35.26,0:20:37.84,JPDB,,0000,0000,0000,,Сонымен, сіз кеше өрескел әрекет еттіңіз.
Dialogue: 0,0:20:38.52,0:20:39.34,JPDB,,0000,0000,0000,,Қателік пе?
Dialogue: 0,0:20:39.72,0:20:41.68,JPDB,,0000,0000,0000,,Берсеркермен сурет салдыңыз ба?
Dialogue: 0,0:20:42.16,0:20:43.98,JPDB,,0000,0000,0000,,Менің ойымша, бұл ең жақсы болды.
Dialogue: 0,0:20:44.38,0:20:45.32,JPDB,,0000,0000,0000,,Бұл шынымен де…
Dialogue: 0,0:20:45.64,0:20:48.78,JPDB,,0000,0000,0000,,Егер құюшыда осындай кең сызық болса
Dialogue: 0,0:20:49.10,0:20:51.25,JPDB,,0000,0000,0000,,Сіз өткен түнгі шайқасты тыңдап отырған болуыңыз керек.
Dialogue: 0,0:20:52.00,0:20:53.20,JPDB,,0000,0000,0000,,қарамастан...
Dialogue: 0,0:20:53.57,0:20:57.22,JPDB,,0000,0000,0000,,Жауды жеңе алмай, өнерімді аштым.
Dialogue: 0,0:20:59.32,0:21:00.32,JPDB,,0000,0000,0000,,Кітапханада жәндіктер ұяласып жатыр ма? Бұл өте қорқынышты.
Dialogue: 0,0:21:01.96,0:21:03.06,JPDB,,0000,0000,0000,,Мен шоқты қуамын
Dialogue: 0,0:21:04.06,0:21:05.90,JPDB,,0000,0000,0000,,Менің ойымша, қатысу әлі де сақталады.
Dialogue: 0,0:21:06.58,0:21:09.20,JPDB,,0000,0000,0000,,Олар Рюдужи храмына қашып кетпес бұрын, оларға қамқорлық жасаңыз
Dialogue: 0,0:21:09.61,0:21:13.44,JPDB,,0000,0000,0000,,Мүмкін емес деп санайтын нәрсені жасамау сіздің ұстанымыңыз емес пе?
Dialogue: 0,0:21:13.90,0:21:14.54,JPDB,,0000,0000,0000,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:21:15.02,0:21:17.00,JPDB,,0000,0000,0000,,Бірақ бұл басқаша, солай емес пе?
Dialogue: 0,0:21:17.90,0:21:20.90,JPDB,,0000,0000,0000,,Ұрыс таңдамасам, көңілім толмайды...
Dialogue: 0,0:21:23.30,0:21:25.46,JPDB,,0000,0000,0000,,Оңай жеңетін қарсыласты жалғыз қалдырыңыз
Dialogue: 0,0:21:25.70,0:21:28.24,JPDB,,0000,0000,0000,,Ең қиын қарсыласты жеңу
Dialogue: 0,0:21:29.04,0:21:29.96,JPDB,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:21:30.54,0:21:33.14,JPDB,,0000,0000,0000,,Сіз әрқашан осындай нәрседен құтыла аласыз.
Dialogue: 0,0:21:33.80,0:21:37.70,JPDB,,0000,0000,0000,,Ол үйде тығылып жатқанша, мен оны жіберемін.
Dialogue: 0,0:21:38.76,0:21:41.72,JPDB,,0000,0000,0000,,-да шебер болудан хабарсыз.
Dialogue: 0,0:21:41.86,0:21:45.22,JPDB,,0000,0000,0000,,Алдарыңыздан Ширу Эмия пайда болса ше?
Dialogue: 0,0:21:47.92,0:21:48.78,JPDB,,0000,0000,0000,,Мен сені өлтіремін
Dialogue: 0,0:21:49.86,0:21:51.84,JPDB,,0000,0000,0000,,Егер сіз мұны білмесеңіз
Dialogue: 0,0:21:52.42,0:21:54.84,JPDB,,0000,0000,0000,,Ақшаны жұмсауға себеп жоқ
Dialogue: 0,0:23:26.80,0:23:28.32,JPDB,,0000,0000,0000,,Сакура екеуміз бір-бірімізді түсіндік.
Dialogue: 0,0:23:28.38,0:23:31.62,JPDB,,0000,0000,0000,,Себебі мен сені жақсы білемін.
Dialogue: 0,0:23:31.68,0:23:33.50,JPDB,,0000,0000,0000,,Жоқ, мен сізге бұйрықтың емлесін бере алмаймын.
Dialogue: 0,0:23:33.56,0:23:34.94,JPDB,,0000,0000,0000,,Тек дайын болыңыз.
Dialogue: 0,0:23:35.12,0:23:35.62,JPDB,,0000,0000,0000,,Ширу
Dialogue: 0,0:23:35.70,0:23:38.88,JPDB,,0000,0000,0000,,Сіз мені ақырын өлтіресіз.
Dialogue: 0,0:23:40.38,0:23:46.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
