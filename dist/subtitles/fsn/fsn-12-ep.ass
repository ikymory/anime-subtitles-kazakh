Dialogue: 0,0:00:00.00,0:00:05.00,ZZRY,,0000,0000,0000,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:00:05.00,0:00:10.00,ZZRY,,0000,0000,0000,,:ikiko  :  :zwx
Dialogue: 0,0:00:10.00,0:00:15.00,ZZRY,,0000,0000,0000,,Уақыты: Айлық жүйесі: өзен крабы Құрбан: Аншао
Dialogue: 0,0:01:53.91,0:02:03.42,JPOP,,0000,0000,0000,,Жүрегімді өртеп жіберген үмітсіздіктің қасында
Dialogue: 0,0:02:04.30,0:02:14.94,JPOP,,0000,0000,0000,,Сіз маған әрқашан күлкі сыйладыңыз, ол бәрін жоғалтты.
Dialogue: 1,0:02:15.02,0:02:17.90,JPOP,,0000,0000,0000,,Күңгірт дауыс
Dialogue: 2,0:02:17.90,0:02:20.32,JPOP,,0000,0000,0000,,Қол жетпейтін сөздер
Dialogue: 0,0:02:20.32,0:02:25.86,JPOP,,0000,0000,0000,,Қайта сүрініп кете жаздаған сайын
Dialogue: 0,0:02:25.86,0:02:30.12,JPOP,,0000,0000,0000,,Мен саған талай рет жабыстым
Dialogue: 0,0:02:30.12,0:02:35.71,JPOP,,0000,0000,0000,,Ақ, ақ, таза ақ болашақ
Dialogue: 0,0:02:35.71,0:02:41.04,JPOP,,0000,0000,0000,,Біздің жалғыз үмітіміз
Dialogue: 0,0:02:41.04,0:02:51.97,JPOP,,0000,0000,0000,,Қазір менде бар нәрсе - осы соқыр сезім.
Dialogue: 0,0:02:51.97,0:02:57.19,JPOP,,0000,0000,0000,,Бір дұрыс жауап жоқ
Dialogue: 0,0:02:57.19,0:03:06.40,JPOP,,0000,0000,0000,,Мен өз ертеңімді іздедім
Dialogue: 0,0:43:57.26,0:44:09.26,JPED,,0000,0000,0000,,Мен армандаған сол күннің көлеңкесіне жетпеген зар
Dialogue: 0,0:44:09.26,0:44:21.81,JPED,,0000,0000,0000,,Ертең өзімді қалай елестетсем де, өшпейтін тілекке малындым.
Dialogue: 0,0:44:24.85,0:44:36.79,JPED,,0000,0000,0000,,Құлаған бөлшектерді ұстайтын қолдармен
Dialogue: 0,0:44:36.79,0:44:50.42,JPED,,0000,0000,0000,,Дірілдеген жүрегіңді ұстап, түнге секір
Dialogue: 0,0:44:51.35,0:45:03.33,JPED,,0000,0000,0000,,Біреуге сүйенсең де, іздегенің емес.
Dialogue: 0,0:45:03.33,0:45:17.56,JPED,,0000,0000,0000,,Көзіңді жұма, нағыз сен осындасың
Dialogue: 0,0:45:39.19,0:45:51.23,JPED,,0000,0000,0000,,Сағынышқа толы күлкі желге шашылып, қоқыс сияқты көрінді
Dialogue: 0,0:45:51.23,0:45:57.24,JPED,,0000,0000,0000,,Ертеңгі күн үшін не тілесем де,
Dialogue: 0,0:45:57.91,0:46:04.04,JPED,,0000,0000,0000,,Алысқан жауап бұлыңғыр болады
Dialogue: 0,0:46:06.73,0:46:18.80,JPED,,0000,0000,0000,,Тоңған денем мен сезімімнің бір бөлшегі
Dialogue: 0,0:46:18.80,0:46:33.06,JPED,,0000,0000,0000,,Шірімей тұрып, түнде ұшып өт
Dialogue: 0,0:46:33.46,0:46:45.39,JPED,,0000,0000,0000,,Біреуге сүйенсең де, іздегенің емес.
Dialogue: 0,0:46:45.39,0:46:56.76,JPED,,0000,0000,0000,,Көзіңді жұма, нағыз сен осындасың
Dialogue: 0,0:46:57.33,0:47:08.11,JPED,,0000,0000,0000,,Біреу үшін өмір сүру, бұл сәт бәрі
Dialogue: 0,0:47:08.11,0:47:09.66,JPED,,0000,0000,0000,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:47:09.66,0:47:25.17,JPED,,0000,0000,0000,,Өзіңіздің өзіңізді жайлап тастаңыз және тек өзіңіз болыңыз.
Dialogue: 0,0:00:05.72,0:00:06.16,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:00:09.04,0:00:12.83,JPDB,,0000,0000,0000,,Мен сатып алған нан жоғалып кетті, 100 иендік үш тиын болды.
Dialogue: 0,0:00:13.52,0:00:15.84,JPDB,,0000,0000,0000,,Оны адалдық деп санау керек пе?
Dialogue: 0,0:00:18.20,0:00:19.30,JPDB,,0000,0000,0000,,Тохсака
Dialogue: 0,0:00:20.41,0:00:21.27,JPDB,,0000,0000,0000,,Тохсака?
Dialogue: 0,0:00:23.84,0:00:24.93,JPDB,,0000,0000,0000,,Бар емес пе?
Dialogue: 0,0:00:28.96,0:00:30.45,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:00:36.32,0:00:37.58,JPDB,,0000,0000,0000,,Бір сәт кешіріңіз
Dialogue: 0,0:00:38.42,0:00:41.26,JPDB,,0000,0000,0000,,Оған біраз уақыт кетеді.
Dialogue: 0,0:00:47.66,0:00:50.34,JPDB,,0000,0000,0000,,Широ, көңіл-күйің қалай?
Dialogue: 0,0:00:50.70,0:00:52.97,JPDB,,0000,0000,0000,,Дененің бір жағында енді сал болмайды
Dialogue: 0,0:00:53.47,0:00:55.89,JPDB,,0000,0000,0000,,Менің ойымша, бұл әлі сәл ауыр.
Dialogue: 0,0:00:56.16,0:00:57.36,JPDB,,0000,0000,0000,,Бұл жақсы болды
Dialogue: 0,0:01:00.00,0:01:01.10,JPDB,,0000,0000,0000,,Қайырлы таң Рин
Dialogue: 0,0:01:02.19,0:01:03.28,JPDB,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:01:03.48,0:01:05.66,JPDB,,0000,0000,0000,,Сіз кеше түнде жақсы ұйықтаған сияқтысыз.
Dialogue: 0,0:01:06.53,0:01:09.12,JPDB,,0000,0000,0000,,Бұл шын мәнінде олай емес еді.
Dialogue: 0,0:01:09.63,0:01:12.92,JPDB,,0000,0000,0000,,Түн ортасынан кейін де адамдар ойнап жүрді.
Dialogue: 0,0:01:13.56,0:01:15.75,JPDB,,0000,0000,0000,,Сондай-ақ, мен бүгін шығамын.
Dialogue: 0,0:01:16.12,0:01:17.43,JPDB,,0000,0000,0000,,Тез дайындал
Dialogue: 0,0:01:17.72,0:01:20.30,JPDB,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:01:20.57,0:01:21.99,JPDB,,0000,0000,0000,,Келесі қалаға.
Dialogue: 0,0:01:22.64,0:01:23.62,JPDB,,0000,0000,0000,,Не істеу керек
Dialogue: 0,0:01:23.84,0:01:27.33,JPDB,,0000,0000,0000,,Не? Мен сенің ойынға шығатыныңа сенімдімін.
Dialogue: 0,0:01:28.16,0:01:29.86,JPDB,,0000,0000,0000,,Күні, күні
Dialogue: 0,0:01:30.44,0:01:33.38,JPDB,,0000,0000,0000,,Кім кіммен кездесуге барады?
Dialogue: 0,0:01:33.80,0:01:35.08,JPDB,,0000,0000,0000,,Мен және Ширу
Dialogue: 0,0:01:36.00,0:01:38.93,JPDB,,0000,0000,0000,,Көрдім, мен және Тохсака...
Dialogue: 0,0:01:39.04,0:01:39.53,JPDB,,0000,0000,0000,,De…
Dialogue: 0,0:03:14.48,0:03:16.14,JPDB,,0000,0000,0000,,Ширу
Dialogue: 0,0:03:16.32,0:03:19.05,JPDB,,0000,0000,0000,,Тохсака-санмен кездесіп жүргеніңді естідім.
Dialogue: 0,0:03:19.64,0:03:22.26,JPDB,,0000,0000,0000,,Бұл үлкен ойын.
Dialogue: 0,0:03:22.68,0:03:24.28,JPDB,,0000,0000,0000,,Мені мазақ етпе
Dialogue: 0,0:03:24.48,0:03:27.20,JPDB,,0000,0000,0000,,Тіпті мен оны түсінбеймін.
Dialogue: 0,0:03:27.50,0:03:29.81,JPDB,,0000,0000,0000,,Мен тағы да ұялып қалдым
Dialogue: 0,0:03:29.92,0:03:33.04,JPDB,,0000,0000,0000,,Бұл жақсы, жастық шақ.
Dialogue: 0,0:03:34.64,0:03:37.24,JPDB,,0000,0000,0000,,Фуджимура мырзаның да бүгін кездесуі бар, солай ма?
Dialogue: 0,0:03:37.63,0:03:38.61,JPDB,,0000,0000,0000,,Фуджинега?
Dialogue: 0,0:03:38.86,0:03:40.93,JPDB,,0000,0000,0000,,Иә, мен де кездесудемін.
Dialogue: 0,0:03:41.28,0:03:44.79,JPDB,,0000,0000,0000,,Бірақ Ширу мен басқалары тым алыс кетпеуі керек.
Dialogue: 0,0:03:45.04,0:03:46.41,JPDB,,0000,0000,0000,,Содан кейін бірінші барыңыз.
Dialogue: 0,0:03:47.94,0:03:50.19,JPDB,,0000,0000,0000,,Ал, біз де барамыз.
Dialogue: 0,0:03:50.38,0:03:50.93,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:04:02.98,0:04:05.63,JPDB,,0000,0000,0000,,Енді қайда баруымыз керек?
Dialogue: 0,0:04:06.54,0:04:08.21,JPDB,,0000,0000,0000,,Екеуіңіздің өтініштеріңіз бар ма?
Dialogue: 0,0:04:08.70,0:04:11.35,JPDB,,0000,0000,0000,,Осыны айтсаң да мені мазалайды.
Dialogue: 0,0:04:11.46,0:04:13.52,JPDB,,0000,0000,0000,,Менің ойымша, Сабер
Dialogue: 0,0:04:13.94,0:04:17.08,JPDB,,0000,0000,0000,,Жоқ, мен бірінші кезекте Ширудың күзетшісімін.
Dialogue: 0,0:04:17.40,0:04:19.22,JPDB,,0000,0000,0000,,Жоқ сияқты әрекет етіңіз
Dialogue: 0,0:04:19.46,0:04:19.88,JPDB,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:04:20.18,0:04:25.40,JPDB,,0000,0000,0000,,Екеуің де менің саясатыма толықтай бағынуларың дұрыс па?
Dialogue: 0,0:04:25.68,0:04:27.62,JPDB,,0000,0000,0000,,Қорлайтын сөздерді қолданбаңыз
Dialogue: 0,0:04:27.84,0:04:30.79,JPDB,,0000,0000,0000,,Жалпы айтқанда, мен Тохсакамен бірге шығамын дедім.
Dialogue: 0,0:04:31.28,0:04:33.00,JPDB,,0000,0000,0000,,Мен кездесуге барамыз деп айтқан жоқпын.
Dialogue: 0,0:04:33.38,0:04:36.62,JPDB,,0000,0000,0000,,Бұл үшеумізге анда-санда үзіліс жасау үшін...
Dialogue: 0,0:04:36.68,0:04:40.92,JPDB,,0000,0000,0000,,Иә, бұл ұят. Дүниеде олар танысу деп атайды.
Dialogue: 0,0:04:41.30,0:04:44.28,JPDB,,0000,0000,0000,,Егер сенің соңың жаман болса, адамдар сені жек көреді.
Dialogue: 0,0:04:44.76,0:04:46.80,JPDB,,0000,0000,0000,,Кімді жек көреді?
Dialogue: 0,0:04:47.10,0:04:49.53,JPDB,,0000,0000,0000,,Кім екенін тап?
Dialogue: 0,0:04:50.70,0:04:51.47,JPDB,,0000,0000,0000,,Ширу
Dialogue: 0,0:04:53.72,0:04:55.39,JPDB,,0000,0000,0000,,А, мен енді түсіндім.
Dialogue: 0,0:04:55.54,0:04:58.08,JPDB,,0000,0000,0000,,Егер бұлай болса, мен қайда барсаң да сені ертіп барамын.
Dialogue: 0,0:05:05.26,0:05:06.94,JPDB,,0000,0000,0000,,Бұл қалай дәмді?
Dialogue: 0,0:05:07.30,0:05:10.42,JPDB,,0000,0000,0000,,Жоқ, оның дәмі қандай екенін білмеймін.
Dialogue: 0,0:05:11.03,0:05:14.17,JPDB,,0000,0000,0000,,Бұл не? Оның қаншалықты тәтті екенін түсінуге болады.
Dialogue: 0,0:05:15.06,0:05:18.96,JPDB,,0000,0000,0000,,Бұл көрінгеннен әлдеқайда тәтті.
Dialogue: 0,0:05:47.10,0:05:47.83,JPDB,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:49.48,0:05:52.60,JPDB,,0000,0000,0000,,Менің ойымша, бұл соншалықты жаман емес.
Dialogue: 0,0:05:52.72,0:05:55.60,JPDB,,0000,0000,0000,,Иә, сен ақылдырақ көрінесің, Рин.
Dialogue: 0,0:05:56.02,0:05:57.03,JPDB,,0000,0000,0000,,Сәлем
Dialogue: 0,0:05:57.44,0:05:58.71,JPDB,,0000,0000,0000,,Иә.
Dialogue: 0,0:05:59.94,0:06:02.05,JPDB,,0000,0000,0000,,Бұл Саберге сәйкес келмейді.
Dialogue: 0,0:06:05.46,0:06:06.91,JPDB,,0000,0000,0000,,Бұл жақсы емес, Сабер.
Dialogue: 0,0:06:07.30,0:06:08.73,JPDB,,0000,0000,0000,,Бұл Эмия-кун.
Dialogue: 0,0:06:13.44,0:06:15.11,JPDB,,0000,0000,0000,,О, біртүрлі
Dialogue: 0,0:06:20.60,0:06:23.34,JPDB,,0000,0000,0000,,Мен алтын көзілдірік тақпаймын.
Dialogue: 0,0:06:23.98,0:06:26.12,JPDB,,0000,0000,0000,,Мен бұдан былай баланың қарауына шыдай аламын ба?
Dialogue: 0,0:06:28.24,0:06:30.80,JPDB,,0000,0000,0000,,Көрдім, хабардар болдым.
Dialogue: 0,0:06:32.34,0:06:34.26,JPDB,,0000,0000,0000,,Бірақ уайымдаудың қажеті жоқ.
Dialogue: 0,0:06:34.54,0:06:37.28,JPDB,,0000,0000,0000,,Эмия-кун, заттарды қазіргідей қалдырудың еш қиындығы жоқ.
Dialogue: 0,0:06:37.82,0:06:39.47,JPDB,,0000,0000,0000,,Мәселе бар.
Dialogue: 0,0:06:40.14,0:06:43.36,JPDB,,0000,0000,0000,,Менің бойым сәл жоғары болуы керек.
Dialogue: 0,0:06:43.80,0:06:45.42,JPDB,,0000,0000,0000,,Менің ойымша, бұл орташа.
Dialogue: 0,0:06:46.04,0:06:47.42,JPDB,,0000,0000,0000,,Бұл орташа ма?
Dialogue: 0,0:06:47.87,0:06:50.36,JPDB,,0000,0000,0000,,Оның бойы кем дегенде Иссейдей.
Dialogue: 0,0:06:51.16,0:06:53.18,JPDB,,0000,0000,0000,,Сондықтан уайымдамаңыз
Dialogue: 0,0:06:53.38,0:06:55.74,JPDB,,0000,0000,0000,,Сіз әлі өсіп жатырсыз
Dialogue: 0,0:06:56.40,0:06:57.72,JPDB,,0000,0000,0000,,Неге негіз болып табылады?
Dialogue: 0,0:07:00.60,0:07:03.10,JPDB,,0000,0000,0000,,Өйткені қаңқасы мықты.
Dialogue: 0,0:07:03.23,0:07:04.98,JPDB,,0000,0000,0000,,Қоректік заттар алсаң, өсесің.
Dialogue: 0,0:07:05.48,0:07:10.02,JPDB,,0000,0000,0000,,Ширу дұрыс фотосинтездесе үлкен бола ала ма деп ойлаймын.
Dialogue: 0,0:07:11.56,0:07:13.92,JPDB,,0000,0000,0000,,Қай жапырақты айтып тұрсың?
Dialogue: 0,0:07:14.86,0:07:16.72,JPDB,,0000,0000,0000,,Мүмкін ашуланған шығарсыз?
Dialogue: 0,0:07:17.42,0:07:20.32,JPDB,,0000,0000,0000,,Мен мұны бір түйір тұзбен аламын.
Dialogue: 0,0:07:21.14,0:07:23.22,JPDB,,0000,0000,0000,,Мен сіздің арқаңызға кепілдік бере алмаймын.
Dialogue: 0,0:07:23.76,0:07:26.44,JPDB,,0000,0000,0000,,Оның өте жақсы адам болатынына сенімдімін.
Dialogue: 0,0:07:26.84,0:07:29.68,JPDB,,0000,0000,0000,,Бұл менің кепілдігім, Ширу.
Dialogue: 0,0:07:31.82,0:07:33.12,JPDB,,0000,0000,0000,,Мен ұялдым, ұялдым
Dialogue: 0,0:07:33.58,0:07:36.14,JPDB,,0000,0000,0000,,Эмия-кун, маған ұнайды, себебі ол бірден бетіме шығады.
Dialogue: 0,0:07:37.12,0:07:38.50,JPDB,,0000,0000,0000,,Бұл зұлымдық
Dialogue: 0,0:07:38.74,0:07:42.32,JPDB,,0000,0000,0000,,Өз сыныбыңда жігіттерді мазақтағанды ұнатасың ба?
Dialogue: 0,0:07:42.59,0:07:46.14,JPDB,,0000,0000,0000,,Әрине, Ширудың реакциясы ең жақсы.
Dialogue: 0,0:07:46.94,0:07:50.56,JPDB,,0000,0000,0000,,Ширумен ойнауды тоқтатып, сүйіктісіне барайық.
Dialogue: 0,0:07:51.34,0:07:54.36,JPDB,,0000,0000,0000,,Түскі ас алдында осылай айтасың.
Dialogue: 0,0:07:58.80,0:07:59.74,JPDB,,0000,0000,0000,,Тағы бір пышақ
Dialogue: 0,0:08:00.30,0:08:02.36,JPDB,,0000,0000,0000,,Бұл 120 км.
Dialogue: 0,0:08:03.86,0:08:06.52,JPDB,,0000,0000,0000,,Ширу, не нәрсеге таң қалдың?
Dialogue: 0,0:08:07.10,0:08:10.02,JPDB,,0000,0000,0000,,А, мен Тохсақа жеңіле алмаймын.
Dialogue: 0,0:08:19.39,0:08:20.22,JPDB,,0000,0000,0000,,Сабер
Dialogue: 0,0:08:28.90,0:08:30.90,JPDB,,0000,0000,0000,,Бұл не, Ширу?
Dialogue: 0,0:08:31.56,0:08:34.02,JPDB,,0000,0000,0000,,Маған біреу осылай қараса, қиналып қалар едім.
Dialogue: 0,0:08:34.74,0:08:37.26,JPDB,,0000,0000,0000,,Бәсекеге қабілеттіліктің шегі бар
Dialogue: 0,0:08:37.64,0:08:39.20,JPDB,,0000,0000,0000,,Бұл қате есептеу болды.
Dialogue: 0,0:08:39.82,0:08:43.54,JPDB,,0000,0000,0000,,Мен Саберді матчқа соншалықты алаңдатады деп ойламадым.
Dialogue: 0,0:08:44.02,0:08:45.96,JPDB,,0000,0000,0000,,Бұрыштарды кессең, мен ашуланамын.
Dialogue: 0,0:08:46.21,0:08:48.96,JPDB,,0000,0000,0000,,Өзгеріс жасасаң, көңіліңді түсіресің.
Dialogue: 0,0:08:49.30,0:08:53.96,JPDB,,0000,0000,0000,,Ширу: Шируда да Ринге қарсы күресетін рух болмады ма?
Dialogue: 0,0:08:54.42,0:08:58.66,JPDB,,0000,0000,0000,,Жарайды, қасымдағы біреу жұдырықпен жауап қайтарса, ренжітеді.
Dialogue: 0,0:08:59.14,0:09:02.34,JPDB,,0000,0000,0000,,Тохсаканың соққысы өте жақсы.
Dialogue: 0,0:09:02.82,0:09:06.66,JPDB,,0000,0000,0000,,Ұйықтар алдында отжимание жасамайсыз ба?
Dialogue: 0,0:09:09.22,0:09:11.22,JPDB,,0000,0000,0000,,Мен істеп жатырмын.
Dialogue: 0,0:09:12.02,0:09:13.62,JPDB,,0000,0000,0000,,Не болды?
Dialogue: 0,0:09:14.38,0:09:15.51,JPDB,,0000,0000,0000,,Әй, Айя
Dialogue: 0,0:09:17.10,0:09:17.96,JPDB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:09:26.03,0:09:27.06,JPDB,,0000,0000,0000,,Мен таң қалдым
Dialogue: 0,0:09:27.16,0:09:30.24,JPDB,,0000,0000,0000,,Мен бұлайша күрделі болады деп ойламаппын.
Dialogue: 0,0:09:30.38,0:09:31.48,JPDB,,0000,0000,0000,,Әрине
Dialogue: 0,0:09:31.90,0:09:33.46,JPDB,,0000,0000,0000,,Себебі мен сені шақырдым.
Dialogue: 0,0:09:33.54,0:09:35.44,JPDB,,0000,0000,0000,,Мен біраз дайындық жасадым.
Dialogue: 0,0:09:36.20,0:09:38.52,JPDB,,0000,0000,0000,,А, енді жұмбақ шешілді.
Dialogue: 0,0:09:38.86,0:09:41.68,JPDB,,0000,0000,0000,,Тохсақа: Сіз бұл мақсатта ақ нан пайдаландыңыз.
Dialogue: 0,0:09:41.86,0:09:46.26,JPDB,,0000,0000,0000,,Түн ортасында қарным ашса да, тамақтың бәрін жеп қойдым деп ойладым.
Dialogue: 0,0:09:46.40,0:09:47.61,JPDB,,0000,0000,0000,,Бүкіл нан
Dialogue: 0,0:09:47.98,0:09:49.32,JPDB,,0000,0000,0000,,Эмия-кун
Dialogue: 0,0:09:50.96,0:09:54.38,JPDB,,0000,0000,0000,,Сөйлеуді тоқтатып, тез тамақтаныңыз.
Dialogue: 0,0:09:54.50,0:09:56.01,JPDB,,0000,0000,0000,,Иә, дұрыс айтасың.
Dialogue: 0,0:09:56.14,0:09:57.26,JPDB,,0000,0000,0000,,Itadadakimasu
Dialogue: 0,0:09:58.08,0:09:59.56,JPDB,,0000,0000,0000,,Итадакимасу Рин
Dialogue: 0,0:10:04.62,0:10:08.33,JPDB,,0000,0000,0000,,Ух, Ширу, сен ащы тамақты ұнатпайтын шығарсың.
Dialogue: 0,0:10:08.76,0:10:10.79,JPDB,,0000,0000,0000,,Жоқ, жарайды.
Dialogue: 0,0:10:11.28,0:10:14.40,JPDB,,0000,0000,0000,,Бұл күшті дәмдеуіш, бірақ ол дәмді.
Dialogue: 0,0:10:15.64,0:10:17.40,JPDB,,0000,0000,0000,,Иә, бұл жақсы болды.
Dialogue: 0,0:10:18.52,0:10:20.43,JPDB,,0000,0000,0000,,Аузыңда тұздық бар
Dialogue: 0,0:10:21.76,0:10:23.06,JPDB,,0000,0000,0000,,Мен оны сізге алайын ба?
Dialogue: 0,0:10:24.32,0:10:26.62,JPDB,,0000,0000,0000,,Сіз кенеттен не айтып тұрсыз?
Dialogue: 0,0:10:29.72,0:10:31.70,JPDB,,0000,0000,0000,,Бұл аздап еркелік болды ма?
Dialogue: 0,0:10:32.56,0:10:36.04,JPDB,,0000,0000,0000,,Кешіріңіз, менің реакциям тым болжамды болды.
Dialogue: 0,0:10:36.14,0:10:37.47,JPDB,,0000,0000,0000,,Қызықты деп ойладым
Dialogue: 0,0:10:38.92,0:10:41.38,JPDB,,0000,0000,0000,,Жарайды, бірақ қараңыз.
Dialogue: 0,0:10:41.54,0:10:44.42,JPDB,,0000,0000,0000,,Ертеңнен бастап мен аздап қозғала алмаймын.
Dialogue: 0,0:10:46.16,0:10:49.46,JPDB,,0000,0000,0000,,Сонымен, ертеңнен бастап ешбір түзетусіз жасай аласыз.
Dialogue: 0,0:10:49.92,0:10:54.46,JPDB,,0000,0000,0000,,Керемет, мен жалқау мысық болып көрінуден жалыққанмын.
Dialogue: 0,0:10:54.82,0:10:56.76,JPDB,,0000,0000,0000,,Айя Қазір бас тарту
Dialogue: 0,0:10:56.92,0:10:58.70,JPDB,,0000,0000,0000,,Бұл біраз уақытты алады.
Dialogue: 0,0:10:58.78,0:11:01.56,JPDB,,0000,0000,0000,,Егер сіз оны қазіргі деңгейде біраз уақыт ұстасаңыз пайдалы болар еді.
Dialogue: 0,0:11:02.06,0:11:04.84,JPDB,,0000,0000,0000,,Иә, егер Ширу солай айтса, жақсы.
Dialogue: 0,0:11:05.04,0:11:07.10,JPDB,,0000,0000,0000,,Деңгейді көтергіңіз келсе, маған хабарлаңыз.
Dialogue: 0,0:11:07.34,0:11:09.66,JPDB,,0000,0000,0000,,Мен сені ойланбастан ұрып-соғамын.
Dialogue: 0,0:11:10.04,0:11:11.74,JPDB,,0000,0000,0000,,Бұл оны жеңудің алғышарты ма?
Dialogue: 0,0:11:12.08,0:11:14.81,JPDB,,0000,0000,0000,,Сіз шынымен шайтансыз ба?
Dialogue: 0,0:11:15.01,0:11:16.48,JPDB,,0000,0000,0000,,Ол әрқашан қызыл
Dialogue: 0,0:11:19.69,0:11:21.68,JPDB,,0000,0000,0000,,Менің физикалық жағдайым жақсы емес.
Dialogue: 0,0:11:22.42,0:11:23.86,JPDB,,0000,0000,0000,,Қазір жақсысың ба?
Dialogue: 0,0:11:24.94,0:11:25.74,JPDB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:11:31.52,0:11:32.44,JPDB,,0000,0000,0000,,Тохсака
Dialogue: 0,0:11:32.70,0:11:33.37,JPDB,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:11:33.84,0:11:36.57,JPDB,,0000,0000,0000,,Сен кеше менің үйіме келдің.
Dialogue: 0,0:11:36.98,0:11:38.74,JPDB,,0000,0000,0000,,Мен түнеп жатқаныма сене алар емеспін.
Dialogue: 0,0:11:39.14,0:11:42.89,JPDB,,0000,0000,0000,,Бұл жай ғана құмарлық.
Dialogue: 0,0:11:43.16,0:11:45.46,JPDB,,0000,0000,0000,,Бірде-бір рет солай істесе жақсы болар еді деп ойладым.
Dialogue: 0,0:11:46.32,0:11:49.58,JPDB,,0000,0000,0000,,Кешегі күн қызық әрі көңілді болды.
Dialogue: 0,0:11:49.92,0:11:50.84,JPDB,,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:11:51.20,0:11:53.97,JPDB,,0000,0000,0000,,Иә, ештеңе болған жоқ.
Dialogue: 0,0:11:54.66,0:11:55.52,JPDB,,0000,0000,0000,,Рахмет
Dialogue: 0,0:11:55.86,0:11:59.71,JPDB,,0000,0000,0000,,Сіз нені түсінбедіңіз?
Dialogue: 0,0:11:59.82,0:12:03.90,JPDB,,0000,0000,0000,,Мен Широға ерекше алаңдамадым.
Dialogue: 0,0:12:04.10,0:12:06.62,JPDB,,0000,0000,0000,,Бірлескен жұмысшылар санының азаюы жағымсыз құбылыс.
Dialogue: 0,0:12:06.86,0:12:08.67,JPDB,,0000,0000,0000,,Сол үшін мені тексеруге келдің, солай ма?
Dialogue: 0,0:12:09.20,0:12:11.53,JPDB,,0000,0000,0000,,Иә, сіз өте жақсы түсіндіңіз.
Dialogue: 0,0:12:11.64,0:12:13.75,JPDB,,0000,0000,0000,,О, мен оны бағалаймын.
Dialogue: 0,0:12:14.08,0:12:16.94,JPDB,,0000,0000,0000,,Мен Тохсаканың не жоспарлағанын білмеймін.
Dialogue: 0,0:12:17.24,0:12:19.42,JPDB,,0000,0000,0000,,Маған көңіл бөлгеніңіз рас.
Dialogue: 0,0:12:34.64,0:12:38.20,JPDB,,0000,0000,0000,,Широу сондай тәкаппар, кездесуге барады.
Dialogue: 0,0:12:39.10,0:12:40.42,JPDB,,0000,0000,0000,,Дұрыс, Кирицугу.
Dialogue: 0,0:12:40.78,0:12:42.55,JPDB,,0000,0000,0000,,Мен Сабер-чанды білемін.
Dialogue: 0,0:12:42.84,0:12:45.26,JPDB,,0000,0000,0000,,Ол мен шетелде кездескен адамның қызы.
Dialogue: 0,0:12:46.28,0:12:49.23,JPDB,,0000,0000,0000,,Мен Кирицугуге бару үшін келдім.
Dialogue: 0,0:12:52.44,0:12:54.02,JPDB,,0000,0000,0000,,Шетелде?
Dialogue: 0,0:12:55.88,0:13:00.44,JPDB,,0000,0000,0000,,Ақырында, сен мені ол жаққа апармадың.
Dialogue: 0,0:13:22.64,0:13:23.85,JPDB,,0000,0000,0000,,Егер қаласаңыз, мен оны сіздің атыңыздан жеткізе аламын.
Dialogue: 0,0:13:24.99,0:13:26.26,JPDB,,0000,0000,0000,,Бүгін көңілді болдыңыз ба?
Dialogue: 0,0:13:28.28,0:13:30.70,JPDB,,0000,0000,0000,,Мен жоспардың жартысын ғана айналып өте алдым.
Dialogue: 0,0:13:30.94,0:13:31.83,JPDB,,0000,0000,0000,,Қалай болды?
Dialogue: 0,0:13:33.32,0:13:34.27,JPDB,,0000,0000,0000,,That's right.
Dialogue: 0,0:13:34.83,0:13:37.08,JPDB,,0000,0000,0000,,Осылай ойнағаныма біраз болды.
Dialogue: 0,0:13:38.44,0:13:42.03,JPDB,,0000,0000,0000,,Әй, рахаттанып қалсаң, айт.
Dialogue: 0,0:13:42.51,0:13:45.03,JPDB,,0000,0000,0000,,Сені осы уақытқа дейін шығарып салғаным үшін маған дөрекі болма.
Dialogue: 0,0:13:45.48,0:13:48.14,JPDB,,0000,0000,0000,,Жоқ, менің айтқым келгені бұл емес.
Dialogue: 0,0:13:48.23,0:13:49.15,JPDB,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:49.35,0:13:52.09,JPDB,,0000,0000,0000,,Сіз бейсаналық түрде тежегішті басып жатырсыз.
Dialogue: 0,0:13:53.68,0:13:55.59,JPDB,,0000,0000,0000,,Бұрын не болғанын білмеймін.
Dialogue: 0,0:13:55.79,0:13:59.33,JPDB,,0000,0000,0000,,Егер бұл өте ауыр болса, оны ұмыту оңай емес пе?
Dialogue: 0,0:14:08.48,0:14:10.64,JPDB,,0000,0000,0000,,Ширу: Сыртта не болып жатыр?
Dialogue: 0,0:14:13.01,0:14:14.58,JPDB,,0000,0000,0000,,Әй, не болды?
Dialogue: 0,0:14:15.06,0:14:16.92,JPDB,,0000,0000,0000,,Жоқ, бірдеңе дұрыс емес.
Dialogue: 0,0:14:24.11,0:14:24.95,JPDB,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:14:51.94,0:14:53.82,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:14:55.12,0:14:56.58,JPDB,,0000,0000,0000,,Archer бағдарламасымен қосылу мүмкін емес
Dialogue: 0,0:14:56.94,0:14:58.34,JPDB,,0000,0000,0000,,толығымен шектелген
Dialogue: 0,0:15:14.83,0:15:15.78,JPDB,,0000,0000,0000,,Бұл жігіттер...
Dialogue: 0,0:15:34.99,0:15:37.19,JPDB,,0000,0000,0000,,Бұл тек жаулардың санын көбейтеді.
Dialogue: 0,0:15:37.60,0:15:38.68,JPDB,,0000,0000,0000,,бұл дұрыс
Dialogue: 0,0:15:39.96,0:15:45.10,JPDB,,0000,0000,0000,,Менің тосқауылымның ішінде соғыссаң да, сиқырлы күшіңді босқа жұмсайсың.
Dialogue: 0,0:15:47.79,0:15:50.10,JPDB,,0000,0000,0000,,Бұл өте үлкен қадам.
Dialogue: 0,0:15:50.30,0:15:53.43,JPDB,,0000,0000,0000,,Су бар болғанша, әскери күш бітпейді.
Dialogue: 0,0:15:53.84,0:15:56.34,JPDB,,0000,0000,0000,,Олай болса, бастапқы нүкте кесілгенге дейін.
Dialogue: 0,0:15:56.85,0:15:58.50,JPDB,,0000,0000,0000,,Батыл заттар
Dialogue: 0,0:15:59.04,0:16:01.21,JPDB,,0000,0000,0000,,Бірақ сен маған қылышыңды сермегенде
Dialogue: 0,0:16:01.41,0:16:04.66,JPDB,,0000,0000,0000,,Мұны көргенше күтпеу керек, Сабер.
Dialogue: 0,0:16:12.36,0:16:13.13,JPDB,,0000,0000,0000,,Фудзи-ни
Dialogue: 0,0:16:19.19,0:16:22.10,JPDB,,0000,0000,0000,,Барымтаға алып не істемексің?
Dialogue: 0,0:16:22.54,0:16:24.44,JPDB,,0000,0000,0000,,Сен маған керек емессің
Dialogue: 0,0:16:24.99,0:16:27.53,JPDB,,0000,0000,0000,,Мен ол балаға қызығамын.
Dialogue: 0,0:16:28.26,0:16:30.72,JPDB,,0000,0000,0000,,Сіздің сиқырлы схемаңыз қызық.
Dialogue: 0,0:16:31.28,0:16:33.48,JPDB,,0000,0000,0000,,Мүмкін болса, мен оны өлтірмей-ақ алғым келеді.
Dialogue: 0,0:16:33.68,0:16:34.70,JPDB,,0000,0000,0000,,Түсіну
Dialogue: 0,0:16:34.90,0:16:39.70,JPDB,,0000,0000,0000,,Менің ақымақтық жасауымның себебі, мен сені дос ретінде тірі қалдырғым келеді.
Dialogue: 0,0:16:40.44,0:16:45.78,JPDB,,0000,0000,0000,,Егер сен менің қуыршағым болсаң, мен бұдан былай ақылсыз әрекеттерді доғарамын.
Dialogue: 0,0:16:46.02,0:16:47.40,JPDB,,0000,0000,0000,,Қандай өзімшіл әрекет
Dialogue: 0,0:16:47.74,0:16:50.18,JPDB,,0000,0000,0000,,Қожаға айтпай ойына келгенін істейтін жігіт.
Dialogue: 0,0:16:50.66,0:16:52.27,JPDB,,0000,0000,0000,,Әй, қызғаныш па?
Dialogue: 0,0:16:52.64,0:16:53.80,JPDB,,0000,0000,0000,,Өкінішке орай
Dialogue: 0,0:16:53.92,0:16:56.98,JPDB,,0000,0000,0000,,Менің қалағаным толық құдіреттілік емес.
Dialogue: 0,0:16:57.18,0:16:59.90,JPDB,,0000,0000,0000,,Тек толық емес дара қабілеттер
Dialogue: 0,0:17:00.71,0:17:03.22,JPDB,,0000,0000,0000,,Жарайды, балам, жауап мынау
Dialogue: 0,0:17:07.34,0:17:08.89,JPDB,,0000,0000,0000,,Сен қиналған баласың.
Dialogue: 0,0:17:09.22,0:17:11.33,JPDB,,0000,0000,0000,,Уайымдайтын ештеңе жоқ.
Dialogue: 0,0:17:11.92,0:17:14.57,JPDB,,0000,0000,0000,,Сенің қылышың қаншалықты жақсы болса да,
Dialogue: 0,0:17:14.77,0:17:18.47,JPDB,,0000,0000,0000,,Таусылмас сиқырлы күшке ие мені жеңе алмайсың.
Dialogue: 0,0:17:18.90,0:17:23.18,JPDB,,0000,0000,0000,,Менің күш-қуатымның қайнар көзі – қалада тұратын барлық адамдар.
Dialogue: 0,0:17:23.57,0:17:26.41,JPDB,,0000,0000,0000,,Бұл 1000 адамнан тұратын бірліктердегі шебердің болуы сияқты.
Dialogue: 0,0:17:26.82,0:17:28.92,JPDB,,0000,0000,0000,,Оның нені білдіретінін біліңіз
Dialogue: 0,0:17:29.31,0:17:31.05,JPDB,,0000,0000,0000,,Сіз, мүмкін емес.
Dialogue: 0,0:17:31.34,0:17:36.86,JPDB,,0000,0000,0000,,Иә, адамның сиқырлы күші болмаса да, жан дүниесінің өзі бөлек.
Dialogue: 0,0:17:37.36,0:17:40.12,JPDB,,0000,0000,0000,,Біз бастапқыда жан жегішпіз
Dialogue: 0,0:17:40.61,0:17:43.33,JPDB,,0000,0000,0000,,Шеберден өмірдің сиқырлы күшін алсаң
Dialogue: 0,0:17:43.53,0:17:45.78,JPDB,,0000,0000,0000,,Сіз қалағаныңызша сиқыр жасай аласыз
Dialogue: 0,0:17:48.29,0:17:51.44,JPDB,,0000,0000,0000,,Кел, балақай, сенің мүмкіндігің жоқ.
Dialogue: 0,0:17:51.95,0:17:54.58,JPDB,,0000,0000,0000,,Сабермен бірге менің артымнан жүр
Dialogue: 0,0:17:57.67,0:17:59.28,JPDB,,0000,0000,0000,,Фуджиниді жібер
Dialogue: 0,0:18:00.96,0:18:03.36,JPDB,,0000,0000,0000,,Тыңдаған жоқсың ба деп ойлаймын.
Dialogue: 0,0:18:04.03,0:18:06.54,JPDB,,0000,0000,0000,,Сіз маған түсуімді айттыңыз.
Dialogue: 0,0:18:06.90,0:18:09.51,JPDB,,0000,0000,0000,,Шулы Фудзи-ни, жібер.
Dialogue: 0,0:18:12.09,0:18:15.14,JPDB,,0000,0000,0000,,Бұл сіздің басқа шеберлермен күш біріктіру ниетіңіз жоқ дегенді білдіре ме?
Dialogue: 0,0:18:15.87,0:18:18.16,JPDB,,0000,0000,0000,,Мен жай ғана сенімен бірге болмаймын.
Dialogue: 0,0:18:18.66,0:18:21.85,JPDB,,0000,0000,0000,,Иә, мені де жек көрді.
Dialogue: 0,0:18:22.05,0:18:23.42,JPDB,,0000,0000,0000,,Шынымен көңіл көншітеді
Dialogue: 0,0:18:24.20,0:18:27.00,JPDB,,0000,0000,0000,,Менімен ынтымақтасатын болсаңыз
Dialogue: 0,0:18:27.12,0:18:29.62,JPDB,,0000,0000,0000,,Мен сіздермен Қасиетті Граильді бөлісе алар едім.
Dialogue: 0,0:18:30.00,0:18:31.97,JPDB,,0000,0000,0000,,Бұл қажетсіз қарастыру.
Dialogue: 0,0:18:32.64,0:18:36.09,JPDB,,0000,0000,0000,,Мен сен сияқтыларды тоқтату үшін күресуді шештім.
Dialogue: 0,0:18:36.44,0:18:38.20,JPDB,,0000,0000,0000,,Қасиетті Граил маңызды емес.
Dialogue: 0,0:18:44.24,0:18:45.12,JPDB,,0000,0000,0000,,Сіз...
Dialogue: 0,0:18:46.03,0:18:47.94,JPDB,,0000,0000,0000,,Ой, бұл сені мазалады ма?
Dialogue: 0,0:18:48.49,0:18:50.15,JPDB,,0000,0000,0000,,Бірақ бұған сен де кінәлісің.
Dialogue: 0,0:18:50.38,0:18:52.83,JPDB,,0000,0000,0000,,Өйткені ойыңызда жоқ нәрселерді айтасыз.
Dialogue: 0,0:18:53.64,0:18:56.32,JPDB,,0000,0000,0000,,Сіз Қасиетті Граилдың құрбанысыз
Dialogue: 0,0:18:56.88,0:18:58.86,JPDB,,0000,0000,0000,,Қасиетті Граил маңызды емес.
Dialogue: 0,0:18:59.20,0:19:03.93,JPDB,,0000,0000,0000,,Сіз мұны айтқанда, сіз Қасиетті Граильді жек көрмейсіз.
Dialogue: 0,0:19:04.90,0:19:05.71,JPDB,,0000,0000,0000,,Ширу
Dialogue: 0,0:19:06.84,0:19:09.67,JPDB,,0000,0000,0000,,Мен білемін, Ширу Эмия.
Dialogue: 0,0:19:09.87,0:19:13.70,JPDB,,0000,0000,0000,,Соңғы шайқаста бәрінен айырылдыңыз.
Dialogue: 0,0:19:14.83,0:19:18.86,JPDB,,0000,0000,0000,,Жалғыз қалдың жалынның ішінде, Өлуді күтіп.
Dialogue: 0,0:19:19.06,0:19:21.27,JPDB,,0000,0000,0000,,Кирицугу Эмия алды
Dialogue: 0,0:19:21.96,0:19:25.31,JPDB,,0000,0000,0000,,Тек келесі Қасиетті Граил соғысы үшін қабылданады.
Dialogue: 0,0:19:25.61,0:19:29.03,JPDB,,0000,0000,0000,,Сіз сиқырға мәжбүрлеуден зардап шектіңіз, солай емес пе?
Dialogue: 0,0:19:29.78,0:19:30.61,JPDB,,0000,0000,0000,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:19:31.23,0:19:33.37,JPDB,,0000,0000,0000,,Эмия-кун, дәл қазір болған оқиға...
Dialogue: 0,0:19:33.92,0:19:39.01,JPDB,,0000,0000,0000,,Иә, сіз үшін Қасиетті Граил жек көретін жау болды.
Dialogue: 0,0:19:39.48,0:19:42.58,JPDB,,0000,0000,0000,,Сондықтан сіз Қасиетті Граилға лайықсыз
Dialogue: 0,0:19:42.78,0:19:45.63,JPDB,,0000,0000,0000,,Сіздің 10 жыл бұрын таратуға құқығыңыз бар.
Dialogue: 0,0:19:45.83,0:19:48.98,JPDB,,0000,0000,0000,,Ал Қасиетті Граил менің қолымдағыдай жақсы.
Dialogue: 0,0:19:49.18,0:19:52.79,JPDB,,0000,0000,0000,,Өз тілегіңді жүзеге асырудан артық ештеңе жоқ.
Dialogue: 0,0:19:53.18,0:19:54.63,JPDB,,0000,0000,0000,,Бұл ақымақтық, Кастер.
Dialogue: 0,0:19:55.07,0:19:58.90,JPDB,,0000,0000,0000,,Қасиетті Граил соңғы Қызметші қалғанша пайда болмайды.
Dialogue: 0,0:19:59.38,0:20:04.51,JPDB,,0000,0000,0000,,Жоқ, Қасиетті Граильді ұрыспай алудың жолы бар.
Dialogue: 0,0:20:04.94,0:20:09.04,JPDB,,0000,0000,0000,,Мен құюшы ретінде Қасиетті Граилдың айлаларын оқи аламын.
Dialogue: 0,0:20:09.24,0:20:15.05,JPDB,,0000,0000,0000,,Иә, егер сіз үлкен сиқырлы қуатпен мақтана алатын болсаңыз, маған қол ұшын созсаңыз.
Dialogue: 0,0:20:15.97,0:20:19.38,JPDB,,0000,0000,0000,,Қасиетті Граильді қазір де шақыруға болады.
Dialogue: 0,0:20:22.41,0:20:25.07,JPDB,,0000,0000,0000,,Енді бұл соңғы рет, балам.
Dialogue: 0,0:20:25.48,0:20:27.80,JPDB,,0000,0000,0000,,Сіз пайдасыз шайқастан аулақ болғыңыз келеді, солай ма?
Dialogue: 0,0:20:28.23,0:20:30.20,JPDB,,0000,0000,0000,,Олай болса менің артымнан жүр
Dialogue: 0,0:20:30.66,0:20:32.50,JPDB,,0000,0000,0000,,Сабер шебері
Dialogue: 0,0:20:38.77,0:20:39.67,JPDB,,0000,0000,0000,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:20:40.30,0:20:42.17,JPDB,,0000,0000,0000,,Мен сіздің әңгімеңізді қабылдамаймын.
Dialogue: 0,0:20:43.61,0:20:45.06,JPDB,,0000,0000,0000,,Сенің есі дұрыс па?
Dialogue: 0,0:20:45.50,0:20:48.04,JPDB,,0000,0000,0000,,Мен қандай лауазымда екенімді білемін.
Dialogue: 0,0:20:48.44,0:20:51.48,JPDB,,0000,0000,0000,,Адамдарды жейтін бақсылармен жұмыс жасама.
Dialogue: 0,0:20:52.30,0:20:54.12,JPDB,,0000,0000,0000,,Сіздің амалдарыңыз дұрыс емес.
Dialogue: 0,0:20:54.62,0:20:55.80,JPDB,,0000,0000,0000,,Және тағы бір нәрсе
Dialogue: 0,0:20:56.38,0:20:59.13,JPDB,,0000,0000,0000,,Мені сиқыршы болуға мәжбүрлеген жоқ.
Dialogue: 0,0:20:59.56,0:21:02.67,JPDB,,0000,0000,0000,,Әкемнің жолын қууға бастама көтердім.
Dialogue: 0,0:21:04.37,0:21:05.04,JPDB,,0000,0000,0000,,Ведьма…
Dialogue: 0,0:21:06.04,0:21:07.99,JPDB,,0000,0000,0000,,Сен мені бақсы деп атадың.
Dialogue: 0,0:21:08.76,0:21:11.73,JPDB,,0000,0000,0000,,Онда сен маған керек емессің
Dialogue: 0,0:21:11.96,0:21:13.85,JPDB,,0000,0000,0000,,Осы жерден жоғалыңыз
Dialogue: 0,0:21:14.31,0:21:15.20,JPDB,,0000,0000,0000,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:21:15.24,0:21:16.63,JPDB,,0000,0000,0000,,Саберді қозғалтпаңыз
Dialogue: 0,0:21:18.02,0:21:21.04,JPDB,,0000,0000,0000,,Қозғалмаңыз.
Dialogue: 0,0:21:21.91,0:21:23.56,JPDB,,0000,0000,0000,,Ширу Бірақ...
Dialogue: 0,0:21:31.86,0:21:35.79,JPDB,,0000,0000,0000,,О, мен сені мүлде білмеймін деп ойладым.
Dialogue: 0,0:21:36.54,0:21:39.59,JPDB,,0000,0000,0000,,Менің ұстанымымды түсінген сияқтысыз.
Dialogue: 0,0:21:40.94,0:21:44.26,JPDB,,0000,0000,0000,,Қорқақ Қарсылық көрсетпейтін Шируды өлтіруді жоспарлап отырсыз ба?
Dialogue: 0,0:21:44.46,0:21:45.58,JPDB,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:21:46.16,0:21:48.98,JPDB,,0000,0000,0000,,Баладан қожайын болуды тоқтатуын сұраңыз.
Dialogue: 0,0:21:49.62,0:21:53.35,JPDB,,0000,0000,0000,,Ол менің досым болмайды, бірақ мен оны құтқарғым келеді.
Dialogue: 0,0:21:53.55,0:21:58.00,JPDB,,0000,0000,0000,,Олай десеңіз, сіз командалық заклинание беруге дайын болған шығарсыз.
Dialogue: 0,0:22:01.12,0:22:04.02,JPDB,,0000,0000,0000,,Жарайды, оны саған қалай берейін?
Dialogue: 0,0:22:04.35,0:22:07.15,JPDB,,0000,0000,0000,,Ширу, сен олай істей алмайсың.
Dialogue: 0,0:22:07.50,0:22:11.18,JPDB,,0000,0000,0000,,Әрине, мен бүкіл қолды аламын.
Dialogue: 0,0:22:12.37,0:22:13.95,JPDB,,0000,0000,0000,,Бар болғаны, Ширу.
Dialogue: 0,0:22:14.60,0:22:17.16,JPDB,,0000,0000,0000,,Мен енді Кастерге қалағанын жасауға рұқсат ете алмаймын.
Dialogue: 0,0:22:17.78,0:22:19.25,JPDB,,0000,0000,0000,,Мен де келісемін.
Dialogue: 0,0:22:19.60,0:22:23.16,JPDB,,0000,0000,0000,,Ол әдетте кепілге алынғандарды босатады.
Dialogue: 0,0:22:26.64,0:22:29.36,JPDB,,0000,0000,0000,,Оны өзіңізбен бірге алыңыз. Менің ойымша, бұл жақсы.
Dialogue: 0,0:22:29.80,0:22:30.46,JPDB,,0000,0000,0000,,Ширу
Dialogue: 0,0:22:30.65,0:22:33.90,JPDB,,0000,0000,0000,,Басқаларға көмектесу үшін көп нәрсеге барудың қажеті жоқ.
Dialogue: 0,0:22:34.02,0:22:34.64,JPDB,,0000,0000,0000,,Харизма!
Dialogue: 0,0:22:35.68,0:22:37.80,JPDB,,0000,0000,0000,,Егер Фудзи-ниді бір қолмен құтқаруға болады
Dialogue: 0,0:22:38.38,0:22:40.18,JPDB,,0000,0000,0000,,Бұл туралы ойлаудың қажеті жоқ.
Dialogue: 0,0:22:49.30,0:22:51.36,JPDB,,0000,0000,0000,,Нағыз ақымақ бала
Dialogue: 0,0:22:52.06,0:22:54.96,JPDB,,0000,0000,0000,,Бұл көз ауыртады, өл.
Dialogue: 0,0:23:01.34,0:23:04.28,JPDB,,0000,0000,0000,,Жоқ, тоқтат, Сабер.
Dialogue: 0,0:23:19.32,0:23:20.30,JPDB,,0000,0000,0000,,Сабер
Dialogue: 0,0:23:36.83,0:23:38.31,JPDB,,0000,0000,0000,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:23:38.51,0:23:41.88,JPDB,,0000,0000,0000,,Бұл менің асыл фантастикалық ереже бұзушым
Dialogue: 0,0:23:42.41,0:23:48.67,JPDB,,0000,0000,0000,,Бұл дүниедегі барлық сиқырларды жоққа шығаратын сатқындық пен бас тартудың қылышы.
Dialogue: 0,0:23:49.10,0:23:51.15,JPDB,,0000,0000,0000,,Келісімшарт жасалды.
Dialogue: 0,0:23:51.56,0:23:53.56,JPDB,,0000,0000,0000,,Бұдан былай мен шебермін.
Dialogue: 0,0:23:53.79,0:23:56.09,JPDB,,0000,0000,0000,,Сіз бұл жағынан мен сияқтысыз
Dialogue: 0,0:23:56.24,0:23:59.65,JPDB,,0000,0000,0000,,Мырзаңды сатып, қылышыңды маған тапсыр
Dialogue: 0,0:24:02.32,0:24:05.54,JPDB,,0000,0000,0000,,Сен қызметшісің, бірақ сен қызметшісің...
Dialogue: 0,0:24:05.87,0:24:08.50,JPDB,,0000,0000,0000,,Иә, мен оны өзіме таныс еттім.
Dialogue: 0,0:24:08.70,0:24:11.25,JPDB,,0000,0000,0000,,Сабер енді менікі
Dialogue: 0,0:24:12.42,0:24:16.04,JPDB,,0000,0000,0000,,Міне, мен оны саған қайтарамын, ақымақ.
Dialogue: 0,0:24:16.24,0:24:17.00,JPDB,,0000,0000,0000,,Фудзи-ни
Dialogue: 0,0:24:18.97,0:24:21.54,JPDB,,0000,0000,0000,,Эй Фудзи, жақсысың ба? Эй Фудзи
Dialogue: 0,0:24:23.77,0:24:24.47,JPDB,,0000,0000,0000,,Фудзи-ни
Dialogue: 0,0:24:25.23,0:24:29.01,JPDB,,0000,0000,0000,,Жарайды, мен сені де сағынуға рұқсат етемін.
Dialogue: 0,0:24:29.46,0:24:34.10,JPDB,,0000,0000,0000,,Бұрынғы көріністің таңғаларлық болғаны сонша, мені күлдірді.
Dialogue: 0,0:24:34.53,0:24:35.35,JPDB,,0000,0000,0000,,көрінгендей, шамамен 36 дана шығады.
Dialogue: 0,0:24:36.48,0:24:37.17,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:24:37.66,0:24:40.84,JPDB,,0000,0000,0000,,Міне, солай болады. Әдетте.
Dialogue: 0,0:24:41.30,0:24:45.03,JPDB,,0000,0000,0000,,Иә, қызық осымен аяқталады, жас ханым.
Dialogue: 0,0:24:45.74,0:24:49.38,JPDB,,0000,0000,0000,,Енді, Сабер, Арчердің қожайынын өлтір.
Dialogue: 0,0:24:50.42,0:24:53.32,JPDB,,0000,0000,0000,,Ақымақ болма. Сен кімге...
Dialogue: 0,0:24:55.47,0:24:57.62,JPDB,,0000,0000,0000,,Жоқ, менің артымнан жүр, Сабер.
Dialogue: 0,0:24:58.13,0:25:02.56,JPDB,,0000,0000,0000,,Менде осы бұйрық сиқыры болғанша, дене де, ақыл да маған қарсы тұра алмайды.
Dialogue: 0,0:25:18.13,0:25:19.64,JPDB,,0000,0000,0000,,Идиот неге...
Dialogue: 0,0:25:20.00,0:25:22.78,JPDB,,0000,0000,0000,,Өкінішті, бұл босқа.
Dialogue: 0,0:25:22.98,0:25:25.53,JPDB,,0000,0000,0000,,Мені сол бала қызықтырды.
Dialogue: 0,0:25:26.72,0:25:28.98,JPDB,,0000,0000,0000,,Сабер емлесі пәрменін орындаңыз
Dialogue: 0,0:25:33.84,0:25:35.35,JPDB,,0000,0000,0000,,ni… ге… те…
Dialogue: 0,0:25:38.11,0:25:40.79,JPDB,,0000,0000,0000,,Қаш, Ширу
Dialogue: 0,0:25:43.51,0:25:44.20,JPDB,,0000,0000,0000,,Фудзи-ни...
Dialogue: 0,0:25:44.40,0:25:45.52,JPDB,,0000,0000,0000,,Жарайды, міне.
Dialogue: 0,0:25:46.29,0:25:51.52,JPDB,,0000,0000,0000,,Идиот, Сабердің сиқырлы қарсылығы командалық заклинание байланыстарына да қарсы тұра ма?
Dialogue: 0,0:25:52.01,0:25:54.56,JPDB,,0000,0000,0000,,Бірақ бәрібір мен оны жіберіп алмаймын
Dialogue: 0,0:26:18.06,0:26:19.00,JPDB,,0000,0000,0000,,баяу
Dialogue: 0,0:26:19.38,0:26:22.89,JPDB,,0000,0000,0000,,Барьерді бұзу үшін біраз уақыт қажет болды.
Dialogue: 0,0:26:23.39,0:26:25.78,JPDB,,0000,0000,0000,,Бірақ ішкі жағынан
Dialogue: 0,0:26:28.91,0:26:30.58,JPDB,,0000,0000,0000,,Садақшы Фуджимура мырза...
Dialogue: 0,0:26:31.48,0:26:33.79,JPDB,,0000,0000,0000,,Жүр, қазір барайық.
Dialogue: 0,0:26:39.66,0:26:40.69,JPDB,,0000,0000,0000,,Сабер…
Dialogue: 0,0:27:06.40,0:27:08.24,JPDB,,0000,0000,0000,,Профессор Фуджимура бөлмеге барады.
Dialogue: 0,0:27:08.86,0:27:10.76,JPDB,,0000,0000,0000,,Ширу, есіңізде ме?
Dialogue: 0,0:27:17.00,0:27:18.84,JPDB,,0000,0000,0000,,Жарайды, мен жаяу барамын.
Dialogue: 0,0:27:26.06,0:27:29.64,JPDB,,0000,0000,0000,,Бұл жақсы, менде тек өмір бар.
Dialogue: 0,0:27:32.41,0:27:35.63,JPDB,,0000,0000,0000,,Енді жақсылап демалып ал, Эмия-кун.
Dialogue: 0,0:27:43.16,0:27:47.10,JPDB,,0000,0000,0000,,Көрдім, Сабер тосқауылды бұзды.
Dialogue: 0,0:27:47.44,0:27:48.21,JPDB,,0000,0000,0000,,Барлығы осы ма?
Dialogue: 0,0:27:49.03,0:27:53.92,JPDB,,0000,0000,0000,,Кастердің асыл фантасмасын білу жеткілікті.
Dialogue: 0,0:27:54.79,0:27:58.73,JPDB,,0000,0000,0000,,Бірақ Кастер, сіз әдеттегідей баяусыз.
Dialogue: 0,0:27:59.35,0:28:02.57,JPDB,,0000,0000,0000,,Мүмкін ол шын мәнінде жақсы әйел шығар.
Dialogue: 0,0:28:03.08,0:28:05.34,JPDB,,0000,0000,0000,,Сіз мүлдем бейжайсыз, Арчер.
Dialogue: 0,0:28:05.88,0:28:08.78,JPDB,,0000,0000,0000,,Саберге арқаңды бермедің бе?
Dialogue: 0,0:28:09.43,0:28:12.08,JPDB,,0000,0000,0000,,Мен олай әрекет етейін деген жоқпын.
Dialogue: 0,0:28:12.80,0:28:15.36,JPDB,,0000,0000,0000,,Неліктен олай ойлайсың, Рин?
Dialogue: 0,0:28:15.56,0:28:18.96,JPDB,,0000,0000,0000,,Иә, әйел интуициясына қарап қабылдай аласыз ба?
Dialogue: 0,0:28:19.70,0:28:20.75,JPDB,,0000,0000,0000,,Қабылданбады.
Dialogue: 0,0:28:21.55,0:28:23.75,JPDB,,0000,0000,0000,,Әйел болуға жасыңыз жеткен бе?
Dialogue: 0,0:28:24.74,0:28:29.07,JPDB,,0000,0000,0000,,Біріншіден, оған сүйкімділік пен талғампаздық жетіспейді.
Dialogue: 0,0:28:29.72,0:28:30.60,JPDB,,0000,0000,0000,,Тағы не…
Dialogue: 0,0:28:32.27,0:28:34.19,JPDB,,0000,0000,0000,,Бұл өлімге әкеледі.
Dialogue: 0,0:28:34.50,0:28:37.01,JPDB,,0000,0000,0000,,Қалай болғанда да, оның қаншалықты сүйкімді екенін түсіну қиын
Dialogue: 0,0:28:39.66,0:28:42.75,JPDB,,0000,0000,0000,,Әй, мен өзімді жақсы сезінемін.
Dialogue: 0,0:28:46.29,0:28:47.20,JPDB,,0000,0000,0000,,Сіз
Dialogue: 0,0:28:50.39,0:28:52.76,JPDB,,0000,0000,0000,,Олай болса, жоғарыда айтқанымызды жалғастырайық.
Dialogue: 0,0:28:53.24,0:28:57.02,JPDB,,0000,0000,0000,,Саберге адал болғаныңыздың бір дәлелі
Dialogue: 0,0:28:57.82,0:29:01.28,JPDB,,0000,0000,0000,,Мен Сабермен алғаш танысқанда, бәлкім, мен бұрышты кесіп тастадым.
Dialogue: 0,0:29:02.23,0:29:04.30,JPDB,,0000,0000,0000,,Сабер қаншалықты күшті болса да,
Dialogue: 0,0:29:04.50,0:29:07.87,JPDB,,0000,0000,0000,,Қорғануға өте шебер болғандықтан жеңіліске ұшырамайды деп ойлаймын.
Dialogue: 0,0:29:08.79,0:29:10.86,JPDB,,0000,0000,0000,,Бұл күтпеген шабуыл болды.
Dialogue: 0,0:29:11.45,0:29:15.23,JPDB,,0000,0000,0000,,Мен де сіз сияқты күтпеген оқиғаларға қарсымын.
Dialogue: 0,0:29:15.68,0:29:17.28,JPDB,,0000,0000,0000,,Көмегің үшін рахмет.
Dialogue: 0,0:29:17.64,0:29:19.55,JPDB,,0000,0000,0000,,№2 растау
Dialogue: 0,0:29:20.38,0:29:23.95,JPDB,,0000,0000,0000,,Шабандоз оқиғасынан кейін сіз Саберді арандатқансыз, солай ма?
Dialogue: 0,0:29:24.57,0:29:28.02,JPDB,,0000,0000,0000,,Қалай қарасаңыз да, бұл сізге ұқсамайды.
Dialogue: 0,0:29:28.84,0:29:31.74,JPDB,,0000,0000,0000,,Сосын мен оған сәл басқаша қарап, түсіндім.
Dialogue: 0,0:29:32.32,0:29:35.50,JPDB,,0000,0000,0000,,Сен ол кезде Сабырға ұрысып жаттың ғой, солай ма?
Dialogue: 0,0:29:36.64,0:29:37.91,JPDB,,0000,0000,0000,,А, дұрыс па?
Dialogue: 0,0:29:38.47,0:29:39.81,JPDB,,0000,0000,0000,,Ал… біз Карт Титанмен біріктік ➡
Dialogue: 0,0:29:40.44,0:29:42.86,JPDB,,0000,0000,0000,,Бұл бұрынғы өмірден байланыс па, әлде басқасы.
Dialogue: 0,0:29:43.47,0:29:47.10,JPDB,,0000,0000,0000,,Сіздің соншалықты салқын әрекет етуіңіз ерекше.
Dialogue: 0,0:29:47.40,0:29:48.53,JPDB,,0000,0000,0000,,Менің ойымша, солай
Dialogue: 0,0:29:48.73,0:29:52.80,JPDB,,0000,0000,0000,,Мен бәріне солай қараймын деп ойлаймын.
Dialogue: 0,0:29:53.35,0:29:55.99,JPDB,,0000,0000,0000,,Тек оның өзі осылай деп есептейді.
Dialogue: 0,0:29:56.57,0:30:01.38,JPDB,,0000,0000,0000,,Менің ойымша, сіз тек өзіңізге келгенде ебедейсіз.
Dialogue: 0,0:30:02.24,0:30:04.12,JPDB,,0000,0000,0000,,Өйткені ол айналамен епті
Dialogue: 0,0:30:04.18,0:30:05.84,JPDB,,0000,0000,0000,,Мен алданып қаламын.
Dialogue: 0,0:30:07.24,0:30:09.47,JPDB,,0000,0000,0000,,Еске алмақшысыз ба?
Dialogue: 0,0:30:10.01,0:30:12.00,JPDB,,0000,0000,0000,,Мен кімнің батырымын?
Dialogue: 0,0:30:12.93,0:30:17.34,JPDB,,0000,0000,0000,,Егер ол Сабермен туысқан болса, ол Сабирге ұқсас дәуірдің батыры болуы керек.
Dialogue: 0,0:30:18.18,0:30:20.70,JPDB,,0000,0000,0000,,Жоқ, әлі тұман.
Dialogue: 0,0:30:21.52,0:30:25.28,JPDB,,0000,0000,0000,,Бірақ сіз дұрыс айтасыз, Сабердің естеліктері бар.
Dialogue: 0,0:30:25.87,0:30:30.56,JPDB,,0000,0000,0000,,Олар бір-бірін танымайтын сияқты, сондықтан олар өте терең қарым-қатынаста болмаған сияқты.
Dialogue: 0,0:30:31.82,0:30:32.38,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:30:33.43,0:30:34.40,JPDB,,0000,0000,0000,,Одан да көп, Рин
Dialogue: 0,0:30:34.92,0:30:37.04,JPDB,,0000,0000,0000,,Сіз әкелген адам қалай?
Dialogue: 0,0:30:37.51,0:30:40.92,JPDB,,0000,0000,0000,,Иә, бақытымызға орай өмірлік маңызды сәт өткізіліп қалды.
Dialogue: 0,0:30:41.43,0:30:44.65,JPDB,,0000,0000,0000,,Бірақ бұл жара мүлде жазылмайды.
Dialogue: 0,0:30:45.08,0:30:46.48,JPDB,,0000,0000,0000,,Өйткені келісім-шарт мерзімі аяқталды
Dialogue: 0,0:30:46.57,0:30:49.68,JPDB,,0000,0000,0000,,Сабырдан алған емшілік қабілетім кеткен шығар.
Dialogue: 0,0:30:50.44,0:30:54.35,JPDB,,0000,0000,0000,,Жоқ, ол анау емес, екіншісі.
Dialogue: 0,0:30:56.32,0:30:58.03,JPDB,,0000,0000,0000,,О, Фуджимура мырза?
Dialogue: 0,0:30:58.82,0:31:02.03,JPDB,,0000,0000,0000,,Кастер маған ұйқы сиқырын сыйлаған сияқты.
Dialogue: 0,0:31:02.39,0:31:04.32,JPDB,,0000,0000,0000,,Ол өте жақсы жұмыс істейді.
Dialogue: 0,0:31:04.93,0:31:09.03,JPDB,,0000,0000,0000,,Мен онымен айналыстым, сондықтан бір апта ұйықтасам зиян тигізбейді.
Dialogue: 0,0:31:10.80,0:31:13.66,JPDB,,0000,0000,0000,,Менің ойымша, Фуджимура мырза кенеттен оянады.
Dialogue: 0,0:31:14.05,0:31:18.04,JPDB,,0000,0000,0000,,Бірақ анау әйелдің айласы сиқырдан гөрі қарғыс.
Dialogue: 0,0:31:18.76,0:31:21.73,JPDB,,0000,0000,0000,,Сиқырды жоюдың ең жылдам жолы - адамды жеңу.
Dialogue: 0,0:31:22.34,0:31:23.20,JPDB,,0000,0000,0000,,Иә.
Dialogue: 0,0:31:33.35,0:31:35.83,JPDB,,0000,0000,0000,,Кастерді жою - басты басымдық.
Dialogue: 0,0:31:36.34,0:31:37.15,JPDB,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:31:37.80,0:31:41.44,JPDB,,0000,0000,0000,,Мүмкін болса, Саберді толығымен басқармай тұрып жеңуіміз керек.
Dialogue: 0,0:31:43.45,0:31:44.43,JPDB,,0000,0000,0000,,Түсінді.
Dialogue: 0,0:31:45.06,0:31:48.54,JPDB,,0000,0000,0000,,Міне, сол баламен келісім-шарт аяқталды.
Dialogue: 0,0:31:48.98,0:31:49.43,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:31:50.18,0:31:51.44,JPDB,,0000,0000,0000,,«e» емес
Dialogue: 0,0:31:52.20,0:31:54.61,JPDB,,0000,0000,0000,,Ширу Эмия шебер емес шығар.
Dialogue: 0,0:31:55.62,0:31:56.47,JPDB,,0000,0000,0000,,Не болды?
Dialogue: 0,0:31:57.22,0:32:02.55,JPDB,,0000,0000,0000,,Бірге төбелескен мейірімінен сені асыраймын деп жатқан жоқ деп ойлаймын.
Dialogue: 0,0:32:04.14,0:32:07.54,JPDB,,0000,0000,0000,,Менің ойымша, ол соншалықты мейірімді емес.
Dialogue: 0,0:32:07.93,0:32:08.65,JPDB,,0000,0000,0000,,Ийда…
Dialogue: 0,0:32:09.22,0:32:11.27,JPDB,,0000,0000,0000,,Бірақ әлі біткен жоқ.
Dialogue: 0,0:32:12.53,0:32:16.23,JPDB,,0000,0000,0000,,Ол түсемін демейінше мен уәдемді бұзбаймын.
Dialogue: 0,0:32:16.87,0:32:18.34,JPDB,,0000,0000,0000,,Мен сені итеріп жіберемін, бірақ
Dialogue: 0,0:32:18.54,0:32:22.75,JPDB,,0000,0000,0000,,Ол кетті демейінше ештеңе бітпейді.
Dialogue: 0,0:32:25.42,0:32:26.22,JPDB,,0000,0000,0000,,Рин…
Dialogue: 0,0:32:27.05,0:32:28.78,JPDB,,0000,0000,0000,,Бұл менің саясатым.
Dialogue: 0,0:32:29.44,0:32:31.32,JPDB,,0000,0000,0000,,Шағымдарыңыз бар ма? садақшы
Dialogue: 0,0:32:32.36,0:32:33.75,JPDB,,0000,0000,0000,,Оған көмектесу мүмкін емес
Dialogue: 0,0:32:34.23,0:32:38.36,JPDB,,0000,0000,0000,,Мен сенің сондай адам екеніңді түсінемін.
Dialogue: 0,0:32:40.23,0:32:41.79,JPDB,,0000,0000,0000,,Кеттік, Арчер.
Dialogue: 0,0:32:51.52,0:32:52.23,JPDB,,0000,0000,0000,,Бұл
Dialogue: 0,0:32:54.28,0:32:55.22,JPDB,,0000,0000,0000,,Мұнда...
Dialogue: 0,0:33:06.69,0:33:09.76,JPDB,,0000,0000,0000,,Ешкім жоқ па...?
Dialogue: 0,0:33:16.14,0:33:18.35,JPDB,,0000,0000,0000,,Осы уақытқа дейін...
Dialogue: 0,0:33:18.63,0:33:19.89,JPDB,,0000,0000,0000,,Ол жалғыз...
Dialogue: 0,0:33:28.25,0:33:32.60,JPDB,,0000,0000,0000,,Вари Мен әбігерге түстім... Тохсака...
Dialogue: 0,0:33:40.38,0:33:43.04,JPDB,,0000,0000,0000,,Бұл бір жерде...
Dialogue: 0,0:33:43.84,0:33:47.38,JPDB,,0000,0000,0000,,Иә, бұл сол кездегідей.
Dialogue: 0,0:33:47.98,0:33:49.35,JPDB,,0000,0000,0000,,Тоқта, жарай ма?
Dialogue: 0,0:33:50.00,0:33:51.47,JPDB,,0000,0000,0000,,Сіз қандайсыз?
Dialogue: 0,0:33:52.13,0:33:55.95,JPDB,,0000,0000,0000,,Сондай күнде, сондай уақытта
Dialogue: 0,0:33:57.26,0:33:59.47,JPDB,,0000,0000,0000,,Әлі де атқарылатын жұмыстар бар
Dialogue: 0,0:34:04.52,0:34:07.17,JPDB,,0000,0000,0000,,Бұл не сұмдық?
Dialogue: 0,0:34:08.09,0:34:11.10,JPDB,,0000,0000,0000,,Бұл несие немесе несие екенін айтыңыз.
Dialogue: 0,0:34:12.82,0:34:16.48,JPDB,,0000,0000,0000,,Бұл ешқашан өтелмейтін қарыз емес пе?
Dialogue: 0,0:34:24.62,0:34:25.63,JPDB,,0000,0000,0000,,Тохсака…
Dialogue: 0,0:34:38.56,0:34:40.82,JPDB,,0000,0000,0000,,Тыңдап тұрсың ба, Ассасин?
Dialogue: 0,0:34:41.77,0:34:45.40,JPDB,,0000,0000,0000,,Мен саған қақпашы боласың дедім.
Dialogue: 0,0:34:45.68,0:34:48.18,JPDB,,0000,0000,0000,,Жоқ, менің жолымда біреу бар.
Dialogue: 0,0:34:48.74,0:34:51.50,JPDB,,0000,0000,0000,,Мен біртүрлі құсты көрдім, сондықтан оны кесіп тастадым.
Dialogue: 0,0:34:51.94,0:34:53.78,JPDB,,0000,0000,0000,,Бұл сіздің жерлесіңіз бе?
Dialogue: 0,0:34:54.40,0:34:57.33,JPDB,,0000,0000,0000,,Иә, бақылаушы таныс.
Dialogue: 0,0:35:00.04,0:35:02.34,JPDB,,0000,0000,0000,,Әлгі қыздың да жолы болмай қалды.
Dialogue: 0,0:35:02.68,0:35:06.82,JPDB,,0000,0000,0000,,Егер сен аздап қабілетсіз болсаң, мен сені шәкіртім етер едім.
Dialogue: 0,0:35:08.20,0:35:10.95,JPDB,,0000,0000,0000,,Қожайынымды қорғауды саған қалдырдым, Ассасин.
Dialogue: 0,0:35:11.15,0:35:13.14,JPDB,,0000,0000,0000,,Қақпаны өліммен күзет
Dialogue: 0,0:35:13.52,0:35:15.66,JPDB,,0000,0000,0000,,Енді, бұл Кодзиро
Dialogue: 0,0:35:16.14,0:35:19.96,JPDB,,0000,0000,0000,,Мені шақырғанда бұл кісінің тірі екенін сезбеймін.
Dialogue: 0,0:35:20.84,0:35:24.46,JPDB,,0000,0000,0000,,Ондай кісіні өлімге бұйыру бекер емес пе?
Dialogue: 0,0:35:25.08,0:35:26.48,JPDB,,0000,0000,0000,,Редукцияланбаған ауыз
Dialogue: 0,0:35:26.94,0:35:29.52,JPDB,,0000,0000,0000,,Сіз мен шақырған қызметшісіз
Dialogue: 0,0:35:29.94,0:35:32.55,JPDB,,0000,0000,0000,,Егер сіз қожайыныңызға адал болуға ант ете алмасаңыз
Dialogue: 0,0:35:32.64,0:35:34.50,JPDB,,0000,0000,0000,,Оны осы жерден жойыңыз.
Dialogue: 0,0:35:34.96,0:35:37.42,JPDB,,0000,0000,0000,,Түсіндім, мен мұны істедім.
Dialogue: 0,0:35:38.56,0:35:43.16,JPDB,,0000,0000,0000,,Менің өмірім тұман сияқты, бірақ қазір өшірілсе, қиналатын едім.
Dialogue: 0,0:35:44.32,0:35:48.00,JPDB,,0000,0000,0000,,Өйткені мен бір уәде бердім.
Dialogue: 0,0:35:48.56,0:35:50.74,JPDB,,0000,0000,0000,,Олай болса сөзіңізге абай болыңыз.
Dialogue: 0,0:35:51.28,0:35:54.16,JPDB,,0000,0000,0000,,Бар болғаны осы жерді қорғау керек.
Dialogue: 0,0:35:55.50,0:35:56.82,JPDB,,0000,0000,0000,,Сонымен
Dialogue: 0,0:35:57.84,0:35:59.70,JPDB,,0000,0000,0000,,Бірақ жақсы ма, Кастер?
Dialogue: 0,0:36:00.42,0:36:03.12,JPDB,,0000,0000,0000,,Мен де қожайынға адал емеспін.
Dialogue: 0,0:36:03.32,0:36:05.16,JPDB,,0000,0000,0000,,Сіз тым ойшылсыз.
Dialogue: 0,0:36:05.66,0:36:08.60,JPDB,,0000,0000,0000,,Бұл мәселе шеберден құпия болуы керек.
Dialogue: 0,0:36:13.79,0:36:19.67,JPDB,,0000,0000,0000,,Бұл күннен күнге нашарлап барады, Кастер.
Dialogue: 0,0:36:19.87,0:36:21.04,JPDB,,0000,0000,0000,,Үндетпе
Dialogue: 0,0:36:21.41,0:36:23.58,JPDB,,0000,0000,0000,,Келесі жолы да дәл осылай айтуды сұрасаңыз
Dialogue: 0,0:36:23.82,0:36:26.64,JPDB,,0000,0000,0000,,Тағы бес күн күтпей-ақ өшіріп тастаңыз.
Dialogue: 0,0:36:27.18,0:36:31.68,JPDB,,0000,0000,0000,,Ендеше, әйел мен ергежейлі адам басқарылмайды дейді.
Dialogue: 0,0:36:31.92,0:36:33.86,JPDB,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:36:37.36,0:36:40.04,JPDB,,0000,0000,0000,,Білсеңіз де, уайымдамаңыз
Dialogue: 0,0:36:40.99,0:36:44.62,JPDB,,0000,0000,0000,,Бәрі қожайыннан жасырын болады дейді ғой.
Dialogue: 0,0:36:44.88,0:36:46.80,JPDB,,0000,0000,0000,,Бұл әдемі әңгіме емес пе?
Dialogue: 0,0:36:47.20,0:36:52.52,JPDB,,0000,0000,0000,,Мен ол кісінің қожайынына деген жанашырлығын айта аламын деп үміттенемін.
Dialogue: 0,0:36:52.82,0:36:54.70,JPDB,,0000,0000,0000,,Сізді өлтіру...
Dialogue: 0,0:36:54.90,0:36:56.32,JPDB,,0000,0000,0000,,Мен жеңілгеніме қынжыламын.
Dialogue: 0,0:36:56.72,0:36:59.04,JPDB,,0000,0000,0000,,Осы деңгейдегі бос сөзді кешіріңіз.
Dialogue: 0,0:36:59.48,0:37:03.74,JPDB,,0000,0000,0000,,Бар күшіммен мен бұл қақпаны қандай жағдайда да қорғаймын.
Dialogue: 0,0:37:04.06,0:37:06.82,JPDB,,0000,0000,0000,,Бірақ қайда бара жатырсың?
Dialogue: 0,0:37:07.44,0:37:09.66,JPDB,,0000,0000,0000,,Менің қорғауыма сене алмайсың ба?
Dialogue: 0,0:37:10.03,0:37:11.30,JPDB,,0000,0000,0000,,Әрине
Dialogue: 0,0:37:11.64,0:37:13.56,JPDB,,0000,0000,0000,,Сіз жай ғана сақтандырусыз
Dialogue: 0,0:37:14.08,0:37:15.54,JPDB,,0000,0000,0000,,Бірақ бәрі бітті
Dialogue: 0,0:37:15.83,0:37:17.70,JPDB,,0000,0000,0000,,Саберді алғанша
Dialogue: 0,0:37:17.82,0:37:20.98,JPDB,,0000,0000,0000,,Мен мұндай қаңырап бос тұрған жерді ғибадатханаға айналдырмас едім.
Dialogue: 0,0:37:21.94,0:37:23.46,JPDB,,0000,0000,0000,,Позицияның өзгеруі?
Dialogue: 0,0:37:23.80,0:37:27.08,JPDB,,0000,0000,0000,,туралы сөз болғанда, мен онымен біткеніме сенімдімін.
Dialogue: 0,0:37:27.94,0:37:30.56,JPDB,,0000,0000,0000,,Қалай ойлайсың, осы таудан асқан рухани жер бар ма?
Dialogue: 0,0:37:30.68,0:37:34.24,JPDB,,0000,0000,0000,,Иә, мен үшін орын бар.
Dialogue: 0,0:37:35.94,0:37:39.21,JPDB,,0000,0000,0000,,Иә, мен алдымен жүлдемді аламын.
Dialogue: 0,0:37:39.41,0:37:41.78,JPDB,,0000,0000,0000,,Жаңа база және Қасиетті Граил
Dialogue: 0,0:37:42.20,0:37:45.02,JPDB,,0000,0000,0000,,Мен тіпті Сабер деген шығарманы да алдым.
Dialogue: 0,0:37:45.22,0:37:47.64,JPDB,,0000,0000,0000,,Мұны тіпті құлықсыз қожайыным да пайдалана алады.
Dialogue: 0,0:37:47.76,0:37:50.52,JPDB,,0000,0000,0000,,Менің саясатыммен дауласуға болмайды.
Dialogue: 0,0:37:51.20,0:37:54.96,JPDB,,0000,0000,0000,,Қасиетті Граалды алғанша, қорқатын ештеңе жоқ.
Dialogue: 0,0:37:55.24,0:38:00.58,JPDB,,0000,0000,0000,,Иә, мені ешкім тоқтата алмайды.
Dialogue: 0,0:38:18.60,0:38:19.64,JPDB,,0000,0000,0000,,Кастер?
Dialogue: 0,0:38:20.12,0:38:21.76,JPDB,,0000,0000,0000,,Танысқаныма қуаныштымын?
Dialogue: 0,0:38:22.18,0:38:24.80,JPDB,,0000,0000,0000,,Осы ақылсыз рәсімнің директоры
Dialogue: 0,0:38:25.24,0:38:26.92,JPDB,,0000,0000,0000,,Бұл не үшін, Кастер?
Dialogue: 0,0:38:27.34,0:38:29.88,JPDB,,0000,0000,0000,,Бұл қол сұғылмайтын бейтарап аймақ
Dialogue: 0,0:38:30.40,0:38:31.98,JPDB,,0000,0000,0000,,Батырлық рух болса да
Dialogue: 0,0:38:32.02,0:38:35.32,JPDB,,0000,0000,0000,,Қызметшілердің аяқ басатын жері жақсы емес.
Dialogue: 0,0:38:35.52,0:38:37.62,JPDB,,0000,0000,0000,,Ережелер өзгерді.
Dialogue: 0,0:38:41.02,0:38:42.16,JPDB,,0000,0000,0000,,Бұл команда емлесі ме?
Dialogue: 0,0:38:49.66,0:38:50.74,JPDB,,0000,0000,0000,,Сабер?
Dialogue: 0,0:38:51.20,0:38:54.06,JPDB,,0000,0000,0000,,Сабер енді менің қуыршағым
Dialogue: 0,0:38:54.46,0:38:56.44,JPDB,,0000,0000,0000,,сонда сіз түсінесіз.
Dialogue: 0,0:38:57.06,0:38:59.40,JPDB,,0000,0000,0000,,Жеңіс немесе жеңіліс әлдеқашан шешілген сияқты.
Dialogue: 0,0:39:00.05,0:39:04.06,JPDB,,0000,0000,0000,,Қызық, бірінші болып жүлдені алуға келгеннің несі айып?
Dialogue: 0,0:39:04.40,0:39:05.38,JPDB,,0000,0000,0000,,Сондай-ақ бар
Dialogue: 0,0:39:05.50,0:39:09.70,JPDB,,0000,0000,0000,,Қасиетті Граил соңғы Қызметші қалмайынша пайда болмайды.
Dialogue: 0,0:39:09.96,0:39:14.54,JPDB,,0000,0000,0000,,Егер сіз қызметші болсаңыз, бұл туралы сізді шақыру кезінде хабардар ету керек еді.
Dialogue: 0,0:39:14.84,0:39:17.75,JPDB,,0000,0000,0000,,Иә, солай деді Қасиетті Граил.
Dialogue: 0,0:39:17.86,0:39:21.78,JPDB,,0000,0000,0000,,Сондықтан мен саған басқа батыр рухтарды өлтіріп, Қасиетті Граильді іске қосуды айттым.
Dialogue: 0,0:39:22.14,0:39:25.98,JPDB,,0000,0000,0000,,Бірақ бұл үлкен оқиға.
Dialogue: 0,0:39:27.32,0:39:30.24,JPDB,,0000,0000,0000,,Енді кішісі қайда?
Dialogue: 0,0:39:30.62,0:39:34.08,JPDB,,0000,0000,0000,,Менің ойымша, сендер кілтті ұстап отырсыңдар.
Dialogue: 0,0:39:36.60,0:39:38.66,JPDB,,0000,0000,0000,,Бұл жерде қасиетті гриль жоқ
Dialogue: 0,0:39:38.98,0:39:41.04,JPDB,,0000,0000,0000,,Сіз өлгіңіз келеді
Dialogue: 0,0:39:42.66,0:39:44.08,JPDB,,0000,0000,0000,,Оны асыра пайдаланбаңыз
Dialogue: 0,0:39:44.78,0:39:47.60,JPDB,,0000,0000,0000,,Жер шығып жатыр, Колхида ханшайымы.
Dialogue: 0,0:39:48.04,0:39:51.82,JPDB,,0000,0000,0000,,Жаман жаққа әлі үйренбегенсің бе?
Dialogue: 0,0:40:54.88,0:40:57.02,JPDB,,0000,0000,0000,,Үніңді жауып, қарап тұру керек.
Dialogue: 0,0:40:57.64,0:40:59.46,JPDB,,0000,0000,0000,,Ешкім сенімен араласпайды
Dialogue: 0,0:41:04.50,0:41:07.90,JPDB,,0000,0000,0000,,Бұл дәуірде тіпті жауынгерлер бар ма?
Dialogue: 0,0:41:10.65,0:41:14.42,JPDB,,0000,0000,0000,,Бірақ бұл жақсы шайқас қанша уақытқа созылады?
Dialogue: 0,0:41:38.74,0:41:39.74,JPDB,,0000,0000,0000,,Тохсака…
Dialogue: 0,0:41:40.46,0:41:41.43,JPDB,,0000,0000,0000,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:42:04.18,0:42:06.24,JPDB,,0000,0000,0000,,Сен неге...
Dialogue: 0,0:42:10.18,0:42:11.12,JPDB,,0000,0000,0000,,Үйге қайт
Dialogue: 0,0:42:11.92,0:42:13.68,JPDB,,0000,0000,0000,,Мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:42:14.24,0:42:15.76,JPDB,,0000,0000,0000,,Көздің жауын аларсың.
Dialogue: 0,0:42:16.18,0:42:17.11,JPDB,,0000,0000,0000,,Үйге бармау
Dialogue: 0,0:42:17.48,0:42:19.80,JPDB,,0000,0000,0000,,Бірге күресуге уәде бердің.
Dialogue: 0,0:42:21.34,0:42:23.19,JPDB,,0000,0000,0000,,Бұл уәдені ұмытыңыз.
Dialogue: 0,0:42:24.38,0:42:27.12,JPDB,,0000,0000,0000,,Енді не істей аласыз?
Dialogue: 0,0:42:27.74,0:42:29.70,JPDB,,0000,0000,0000,,Саберді жоғалтқан саған
Dialogue: 0,0:42:30.04,0:42:31.04,JPDB,,0000,0000,0000,,Бұл...
Dialogue: 0,0:42:32.32,0:42:35.62,JPDB,,0000,0000,0000,,Ал енді төбелесудің қажеті жоқ.
Dialogue: 0,0:42:36.50,0:42:40.64,JPDB,,0000,0000,0000,,Енді сіз шебер емессіз, сіз шіркеуге қауіпсіз қашып кете аласыз.
Dialogue: 0,0:42:40.84,0:42:41.96,JPDB,,0000,0000,0000,,Ақымақ болма
Dialogue: 0,0:42:42.18,0:42:44.95,JPDB,,0000,0000,0000,,Саберді сол күйінде қалдыра аласыз ба?
Dialogue: 0,0:42:45.50,0:42:49.00,JPDB,,0000,0000,0000,,Сонда не болса да, мен соңына дейін күресетін едім...
Dialogue: 0,0:42:51.18,0:42:52.18,JPDB,,0000,0000,0000,,Қараңызшы
Dialogue: 0,0:42:52.84,0:42:55.18,JPDB,,0000,0000,0000,,Осы уақытқа дейін мен Сабердің көмегін алдым.
Dialogue: 0,0:42:55.46,0:42:57.10,JPDB,,0000,0000,0000,,Жоғалғанда солай болады
Dialogue: 0,0:43:01.04,0:43:04.04,JPDB,,0000,0000,0000,,Ал Сабер ше?
Dialogue: 0,0:43:04.38,0:43:07.14,JPDB,,0000,0000,0000,,Енді Саберге не болғаны маңызды емес.
Dialogue: 0,0:43:07.34,0:43:10.30,JPDB,,0000,0000,0000,,Жоқ, шебер болудың қажеті жоқ.
Dialogue: 0,0:43:10.54,0:43:13.24,JPDB,,0000,0000,0000,,Сабер... оны жек көрді...
Dialogue: 0,0:43:13.88,0:43:17.28,JPDB,,0000,0000,0000,,Қалай сіз осындай біреуді өз бұйрығын орындауға мәжбүрлей аласыз?
Dialogue: 0,0:43:17.80,0:43:18.54,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:43:19.52,0:43:21.64,JPDB,,0000,0000,0000,,Бірақ сен дәрменсізсің
Dialogue: 0,0:43:22.54,0:43:26.18,JPDB,,0000,0000,0000,,Жақсы, егер мойындағың келмесе.
Dialogue: 0,0:43:26.60,0:43:28.52,JPDB,,0000,0000,0000,,Мен мұны сізге айтайын.
Dialogue: 0,0:43:29.74,0:43:33.72,JPDB,,0000,0000,0000,,Сен қазір Саберге көмектесе алмайсың.
Dialogue: 0,0:43:37.70,0:43:39.14,JPDB,,0000,0000,0000,,Әзірше осы.
Dialogue: 0,0:43:39.68,0:43:42.76,JPDB,,0000,0000,0000,,Сабер кетті, Ұстаз да кетті.
Dialogue: 0,0:43:43.80,0:43:47.96,JPDB,,0000,0000,0000,,Қасиетті Граил соғысы деп аталатын қырғынға қатысуға енді ешқандай себеп жоқ.
Dialogue: 0,0:43:48.38,0:43:49.60,JPDB,,0000,0000,0000,,Осы жерден түсіңіз
Dialogue: 0,0:43:50.46,0:43:52.06,JPDB,,0000,0000,0000,,Күте тұрыңыз, Тохсака
Dialogue: 0,0:43:52.54,0:43:53.56,JPDB,,0000,0000,0000,,Әлі де...
Dialogue: 0,0:43:57.84,0:43:59.66,JPDB,,0000,0000,0000,,Не ойлап отырсың, ақымақ?
Dialogue: 0,0:45:14.40,0:45:16.10,JPDB,,0000,0000,0000,,Егер мен одан әрі аралассам
Dialogue: 0,0:45:16.80,0:45:17.72,JPDB,,0000,0000,0000,,Мен өлемін
Dialogue: 0,0:47:35.32,0:47:38.12,JPDB,,0000,0000,0000,,Сіз өзіңіздің дұрыс екеніңізге соңына дейін сене аласыз ба?
Dialogue: 0,0:47:38.22,0:47:40.38,JPDB,,0000,0000,0000,,Жоқ, мен жағдайды түсінемін.
Dialogue: 0,0:47:40.42,0:47:41.95,JPDB,,0000,0000,0000,,Сырттан қауіпсіздікті қамтамасыз ету дұрыс па?
Dialogue: 0,0:47:42.00,0:47:43.40,JPDB,,0000,0000,0000,,Ширу кетіп қалды
Dialogue: 0,0:47:43.53,0:47:47.94,JPDB,,0000,0000,0000,,Сіз мені өз еркіңізбен қорғадыңыз.
Dialogue: 0,0:47:49.63,0:47:53.43,JPDB,,0000,0000,0000,,Мифтік шайқас Оны осы жерде қайталап көрейік.
Dialogue: 0,0:47:53.54,0:47:54.40,JPDB,,0000,0000,0000,,Садақшы…
Dialogue: 0,0:47:56.16,0:47:58.17,JPDB,,0000,0000,0000,,Сіз... Меніңше...
Dialogue: 0,0:47:59.67,0:48:05.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
