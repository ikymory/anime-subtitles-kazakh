Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:47.58,0:00:49.79,Default,,0,0,0,,Күте тұрыңыз, сіздің кезегіңіз.
Dialogue: 0,0:00:54.17,0:00:55.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:03.68,0:01:06.06,Default,,0,0,0,,Кешіріңіз... ол жоғалып кетті.
Dialogue: 0,0:01:19.07,0:01:20.08,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:01:22.33,0:01:25.08,Default,,0,0,0,,Аспанды көрсететін көл сияқты
Dialogue: 0,0:02:44.37,0:02:46.66,Default,,0,0,0,,(Мизоре Йороизуканың тынысы)
Dialogue: 0,0:04:02.28,0:04:05.87,Default,,0,0,0,,Ой, бұл не? Бұл өте көк!
Dialogue: 0,0:04:06.37,0:04:08.41,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:04:16.63,0:04:17.84,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:04:24.18,0:04:25.34,Default,,0,0,0,,Мен оны саған беремін
Dialogue: 0,0:04:27.97,0:04:28.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:29.68,0:04:31.06,Default,,0,0,0,,Бұл қажет емес пе?
Dialogue: 0,0:04:34.56,0:04:36.15,Default,,0,0,0,,Рахмет?
Dialogue: 0,0:04:36.23,0:04:38.61,Default,,0,0,0,,Неліктен сұраулы?
Dialogue: 0,0:04:38.69,0:04:40.07,Default,,0,0,0,,Қош келдіңіздер ме?
Dialogue: 0,0:04:40.15,0:04:42.40,Default,,0,0,0,,Хэхе хехе кеттік
Dialogue: 0,0:08:08.15,0:08:08.98,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:08:09.82,0:08:14.66,Default,,0,0,0,,(флейта дыбысы)
Dialogue: 0,0:08:14.74,0:08:18.74,Default,,0,0,0,,(Гобой дыбысының шығуы)
Dialogue: 0,0:08:21.58,0:08:22.41,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:08:23.83,0:08:24.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:24.96,0:08:27.29,Default,,0,0,0,,А, Мизор да бақытты ма?
Dialogue: 0,0:08:28.79,0:08:31.92,Default,,0,0,0,,Мен де бақыттымын...
Dialogue: 0,0:08:33.01,0:08:36.18,Default,,0,0,0,,Бұл ән өте жақсы, солай емес пе?
Dialogue: 0,0:08:36.26,0:08:39.39,Default,,0,0,0,,Бұл тегін ән болғанына өте қуаныштымын.
Dialogue: 0,0:08:40.97,0:08:41.97,Default,,0,0,0,,Иә
Dialogue: 0,0:08:45.35,0:08:46.69,Default,,0,0,0,,(Гобой дыбысының шығуы)
Dialogue: 0,0:08:46.77,0:08:49.48,Default,,0,0,0,,Мизор бұл әнді білетін бе?
Dialogue: 0,0:08:49.98,0:08:51.07,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:08:51.15,0:08:55.45,Default,,0,0,0,,Бұл әнді соңғы кездері байқауларда танымал болған Уда мырза жазған.
Dialogue: 0,0:08:55.53,0:08:58.16,Default,,0,0,0,,Уда мырза, жақсы.
Dialogue: 0,0:09:02.50,0:09:03.41,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:09:05.04,0:09:05.87,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:06.58,0:09:07.58,Default,,0,0,0,,Иә
Dialogue: 0,0:09:10.17,0:09:13.05,Default,,0,0,0,,Мен мұны кітапханадан алдым.
Dialogue: 0,0:09:14.92,0:09:18.47,Default,,0,0,0,,Мұны бала кезімде оқығаным есімде.
Dialogue: 0,0:09:18.55,0:09:20.05,Default,,0,0,0,,Қарлы қар ше?
Dialogue: 0,0:09:30.73,0:09:34.86,Default,,0,0,0,,Лиз есімді жалғыз қыз туралы әңгіме.
Dialogue: 0,0:09:37.74,0:09:39.41,Default,,0,0,0,,Жалғыз...
Dialogue: 0,0:09:44.00,0:09:45.75,Default,,0,0,0,,Барлық уақытта⸺
Dialogue: 0,0:09:46.54,0:09:49.04,Default,,0,0,0,,Жалғыз қалған Лизге
Dialogue: 0,0:09:51.13,0:09:54.67,Default,,0,0,0,,Бір күні маған бейтаныс қыз келеді.
Dialogue: 0,0:09:57.38,0:09:58.34,Default,,0,0,0,,Эй, сен
Dialogue: 0,0:09:59.76,0:10:02.14,Default,,0,0,0,,Сенің атың кім?
Dialogue: 0,0:10:03.72,0:10:08.06,Default,,0,0,0,,Мен, Нозоми Касаги, менімен бірге Фукибеге келгің келе ме?
Dialogue: 0,0:10:12.23,0:10:14.65,Default,,0,0,0,,Екеуі қатты жақын болды.
Dialogue: 0,0:10:14.73,0:10:16.99,Default,,0,0,0,,Біз бірге өмір сүре бастағалы жатырмыз⸺
Dialogue: 0,0:10:18.78,0:10:21.74,Default,,0,0,0,,Соңында екеуің ажырасып кеттіңдер, солай ма?
Dialogue: 0,0:10:23.74,0:10:27.96,Default,,0,0,0,,Лизге келген қыз шын мәнінде көк құс екен.
Dialogue: 0,0:10:28.75,0:10:31.42,Default,,0,0,0,,Ол Лизден ұшып кетеді.
Dialogue: 0,0:10:33.09,0:10:35.13,Default,,0,0,0,,Мен солай екеніне сенімдімін
Dialogue: 0,0:10:39.34,0:10:41.80,Default,,0,0,0,,Бізге ұқсайды.
Dialogue: 0,0:10:42.89,0:10:43.72,Default,,0,0,0,,Сіз нені айтасыз...?
Dialogue: 0,0:10:43.80,0:10:46.85,Default,,0,0,0,,Бірақ ажырасу мұң екен, солай емес пе?
Dialogue: 0,0:10:48.27,0:10:51.02,Default,,0,0,0,,Маған әңгімелердің соңы бақытты болғаны ұнайды.
Dialogue: 0,0:10:55.48,0:10:56.61,Default,,0,0,0,,Иә
Dialogue: 0,0:11:08.45,0:11:11.54,Default,,0,0,0,,Біраз соққы алғыңыз келе ме? Жеке бөлім
Dialogue: 0,0:11:14.04,0:11:15.63,Default,,0,0,0,,3-ші бөлім
Dialogue: 0,0:11:24.93,0:11:26.93,Default,,0,0,0,,«Махаббаттан жасалған шешім»…
Dialogue: 0,0:11:27.01,0:11:28.85,Default,,0,0,0,,Бас
Dialogue: 0,0:11:31.52,0:11:35.44,Default,,0,0,0,,(флейта дыбысы)
Dialogue: 0,0:11:36.11,0:11:36.94,Default,,0,0,0,,Сен дұрыс айтасың — сені өліміңе мен себеп болдым.
Dialogue: 0,0:11:37.86,0:11:38.69,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:44.99,0:11:45.83,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:11:46.49,0:11:51.50,Default,,0,0,0,,♪ «Лиз және көк құс, 3-ші бөлім»
Dialogue: 0,0:12:17.11,0:12:21.24,Default,,0,0,0,,Хмм, дыбыс деңгейі сәл оғаш болды, солай емес пе?
Dialogue: 0,0:12:21.32,0:12:24.07,Default,,0,0,0,,Жарайды, осы жерден бе деп ойлаймын~
Dialogue: 0,0:12:27.58,0:12:31.12,Default,,0,0,0,,Мен бұл әнді жақын арада шынайы өмірде ойнағым келеді.
Dialogue: 0,0:12:32.79,0:12:33.62,Default,,0,0,0,,Нозоми...
Dialogue: 0,0:12:33.71,0:12:34.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:35.83,0:12:38.88,Default,,0,0,0,,Нозоми жаттығуды ұната ма?
Dialogue: 0,0:12:38.96,0:12:40.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:40.38,0:12:42.76,Default,,0,0,0,,Мен сені сүйемін, мен сені қатты жақсы көремін
Dialogue: 0,0:12:44.38,0:12:46.09,Default,,0,0,0,,Бұл ән де?
Dialogue: 0,0:12:46.18,0:12:48.01,Default,,0,0,0,,Маған қатты ұнайды
Dialogue: 0,0:12:48.64,0:12:49.68,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:12:52.85,0:12:54.52,Default,,0,0,0,,Мен нақты орындауды асыға күтемін.
Dialogue: 0,0:12:56.73,0:12:58.90,Default,,0,0,0,,Қайырлы таң~
Dialogue: 0,0:12:58.98,0:12:59.94,Default,,0,0,0,,О
Dialogue: 0,0:13:00.02,0:13:02.94,Default,,0,0,0,,Жексенбі болса да ерте.
Dialogue: 0,0:13:03.03,0:13:04.82,Default,,0,0,0,,...
Dialogue: 0,0:13:04.90,0:13:06.66,Default,,0,0,0,,Сәлем~ (Юко) Ауырып тұр.
Dialogue: 0,0:13:06.74,0:13:10.41,Default,,0,0,0,,О, қайырлы таң, менеджер.
Dialogue: 0,0:13:10.49,0:13:12.70,Default,,0,0,0,,Бұл анық болды.
Dialogue: 0,0:13:12.79,0:13:13.66,Default,,0,0,0,,Менің ұйқым келіп тұр~
Dialogue: 0,0:13:13.66,0:13:14.75,Default,,0,0,0,,Мен біраз ұйықтап қалдым~ (Нозоми) Хахаха мен қайталап жатырмын.
Dialogue: 0,0:13:14.75,0:13:16.00,Default,,0,0,0,,Хахаха мен қайталап жатырмын
Dialogue: 0,0:13:16.08,0:13:17.63,Default,,0,0,0,,Ал 16:42-де
Dialogue: 0,0:13:17.71,0:13:19.29,Default,,0,0,0,,Қайырлы таң~
Dialogue: 0,0:13:19.38,0:13:21.80,Default,,0,0,0,,Барлығы, сен өте жылдамсың.
Dialogue: 0,0:13:21.88,0:13:24.92,Default,,0,0,0,,Балалар сендер де жылдам екенсіңдер~
Dialogue: 0,0:13:25.01,0:13:26.93,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:13:27.76,0:13:29.76,Default,,0,0,0,,Нозоми Сенпай~
Dialogue: 0,0:13:29.85,0:13:31.06,Default,,0,0,0,,Ал 16:42-де
Dialogue: 0,0:13:31.14,0:13:33.72,Default,,0,0,0,,Эй, ол қазірдің өзінде.
Dialogue: 0,0:13:33.81,0:13:34.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:36.52,0:13:37.73,Default,,0,0,0,,Сырттай оқыту
Dialogue: 0,0:13:37.81,0:13:38.98,Default,,0,0,0,,Иә
Dialogue: 0,0:13:48.99,0:13:50.62,Default,,0,0,0,,Сенпай, сағыз аю жегің келе ме?
Dialogue: 0,0:13:50.70,0:13:52.41,Default,,0,0,0,,А, түсініңіз.
Dialogue: 0,0:13:52.49,0:13:55.04,Default,,0,0,0,,Әй, мен ағама айттым.
Dialogue: 0,0:13:55.12,0:13:57.58,Default,,0,0,0,,Мен таңғы ас ішпедім~
Dialogue: 0,0:13:57.67,0:14:00.38,Default,,0,0,0,,Жемесем, шыдамаймын.
Dialogue: 0,0:14:00.46,0:14:02.55,Default,,0,0,0,,Таңғы асқа не ішесіз?
Dialogue: 0,0:14:02.63,0:14:06.42,Default,,0,0,0,,Кәдімгі тосттар, сосын ірімшік пен жұмыртқа.
Dialogue: 0,0:14:06.51,0:14:07.93,Default,,0,0,0,,Күріш және тағы бір нәрсе
Dialogue: 0,0:14:08.01,0:14:09.84,Default,,0,0,0,,Мисо сорпасы буккаке күріш
Dialogue: 0,0:14:09.93,0:14:12.68,Default,,0,0,0,,Мен мұны кешіре алмаймын. (Мейко) Бұл дәмді~
Dialogue: 0,0:14:12.76,0:14:14.14,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:14:14.22,0:14:15.60,Default,,0,0,0,,Бүршіктер ше?
Dialogue: 0,0:14:15.68,0:14:16.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:17.85,0:14:19.10,Default,,0,0,0,,Француз тосты
Dialogue: 0,0:14:19.19,0:14:20.90,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:14:25.90,0:14:29.70,Default,,0,0,0,,Мен бұл әнді жақын арада өмірде ойнағым келеді.
Dialogue: 0,0:14:36.50,0:14:39.37,Default,,0,0,0,,Сізге ешқашан нақты шоуға келудің қажеті жоқ.
Dialogue: 0,0:14:53.30,0:14:57.31,Default,,0,0,0,,(Трамвай аялдамасының дыбысы)
Dialogue: 0,0:15:16.08,0:15:16.91,Default,,0,0,0,,Сәлем (пошта қызметкері) Сәлеметсіз бе.
Dialogue: 0,0:15:27.13,0:15:29.13,Default,,0,0,0,,Е/Ж
Dialogue: 0,0:15:30.55,0:15:32.22,Default,,0,0,0,,А... а
Dialogue: 0,0:15:33.09,0:15:34.72,Default,,0,0,0,,Қайырлы таң Аальто
Dialogue: 0,0:15:34.80,0:15:36.89,Default,,0,0,0,,Қайырлы таң Лиз
Dialogue: 0,0:15:39.02,0:15:40.48,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:43.19,0:15:44.44,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:16:04.33,0:16:05.33,Default,,0,0,0,,Лиз
Dialogue: 0,0:16:06.46,0:16:08.71,Default,,0,0,0,,Бүгінгі күнді атайық
Dialogue: 0,0:16:09.71,0:16:11.42,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:16:11.51,0:16:12.97,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:13.05,0:16:16.22,Default,,0,0,0,,Ертең кездескенше Аальто
Dialogue: 0,0:16:39.87,0:16:41.58,Default,,0,0,0,,Барлық азық-түлік үшін
Dialogue: 0,0:17:22.04,0:17:26.04,Default,,0,0,0,,(дауыл дыбыстары)
Dialogue: 0,0:17:42.93,0:17:46.94,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:17:50.98,0:17:52.78,Default,,0,0,0,,Таң атты
Dialogue: 0,0:17:52.86,0:17:54.86,Default,,0,0,0,,Дауыл өтіп кетті.
Dialogue: 0,0:17:55.86,0:17:57.32,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:18:00.28,0:18:04.37,Default,,0,0,0,,Жарқырап тұрғандай... кешегі боран өтірік сияқты
Dialogue: 0,0:18:07.75,0:18:10.33,Default,,0,0,0,,Көк... қыз?
Dialogue: 0,0:18:11.29,0:18:12.59,Default,,0,0,0,,Екі рет секіру ме? Әзілдеп тұрсың ғой.
Dialogue: 0,0:18:15.80,0:18:18.09,Default,,0,0,0,,Әй, саған не болды?
Dialogue: 0,0:18:18.18,0:18:19.76,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:18:22.14,0:18:23.22,Default,,0,0,0,,Ой...
Dialogue: 0,0:18:27.89,0:18:29.10,Default,,0,0,0,,Лиз!
Dialogue: 0,0:18:32.36,0:18:33.36,Default,,0,0,0,,Лиз!
Dialogue: 0,0:18:53.46,0:18:57.38,Default,,0,0,0,,Осымен бүгінгі жаттығу аяқталды.
Dialogue: 0,0:18:57.46,0:19:00.55,Default,,0,0,0,,Бүгін біз берілген әндерге тоқталдық.
Dialogue: 0,0:19:00.63,0:19:03.64,Default,,0,0,0,,Мен ертең Лизмен жаттығуға көңіл бөлуді жоспарлап отырмын⸺
Dialogue: 0,0:19:04.30,0:19:06.39,Default,,0,0,0,,Осыны ескере отырып дайындалыңыз.
Dialogue: 0,0:19:06.47,0:19:07.64,Default,,0,0,0,,Иә
Dialogue: 0,0:19:08.64,0:19:10.73,Default,,0,0,0,,Директордан бірдеңе бар ма?
Dialogue: 0,0:19:10.81,0:19:12.15,Default,,0,0,0,,Иә
Dialogue: 0,0:19:13.56,0:19:15.44,Default,,0,0,0,,Барлығының шешімі бойынша
Dialogue: 0,0:19:15.52,0:19:19.32,Default,,0,0,0,,Биылғы мақсат – республикалық турнирде алтын алу.
Dialogue: 0,0:19:19.40,0:19:20.99,Default,,0,0,0,,Келесі жолы тыңдауым бар⸺
Dialogue: 0,0:19:21.07,0:19:24.24,Default,,0,0,0,,Сайланған және сайланбаған мүшелер
Dialogue: 0,0:19:24.32,0:19:27.24,Default,,0,0,0,,Команданың бір бөлігі болу өзгермейді.
Dialogue: 0,0:19:27.33,0:19:31.58,Default,,0,0,0,,Бәріміз бір-бірімізді қолдап, ең күшті Китауджи жасайық
Dialogue: 0,0:19:31.67,0:19:32.50,Default,,0,0,0,,Иә
Dialogue: 0,0:19:32.58,0:19:34.25,Default,,0,0,0,,(Саяма мен басқалар күледі)
Dialogue: 0,0:19:36.71,0:19:38.84,Default,,0,0,0,,Бұл сүйкімді, солай емес пе?
Dialogue: 0,0:19:38.92,0:19:41.34,Default,,0,0,0,,Бұл рас, сүйкімді
Dialogue: 0,0:19:41.43,0:19:44.43,Default,,0,0,0,,Нозо-сенпайдың айқышы да сүйкімді.
Dialogue: 0,0:19:44.51,0:19:47.14,Default,,0,0,0,,«Нозо-сенпай» десең сүйкімді.
Dialogue: 0,0:19:47.22,0:19:49.43,Default,,0,0,0,,Өте сүйкімді~ Нозо-сенпай
Dialogue: 0,0:19:49.52,0:19:51.56,Default,,0,0,0,,Балалар сендер сондай сүйкімді және маңыздысыңдар ма?
Dialogue: 0,0:19:51.64,0:19:53.44,Default,,0,0,0,,Бұл маңызды!
Dialogue: 0,0:19:53.52,0:19:55.94,Default,,0,0,0,,Ахаха, сіз керемет үйлесімдесіз.
Dialogue: 0,0:19:57.65,0:19:58.73,Default,,0,0,0,,...
Dialogue: 0,0:20:00.15,0:20:02.53,Default,,0,0,0,,Еңбегіңіз үшін рахмет~
Dialogue: 0,0:20:04.91,0:20:08.54,Default,,0,0,0,,Ол жерде әрқашан жанды.
Dialogue: 0,0:20:08.62,0:20:13.33,Default,,0,0,0,,Бұл кішкентай құстардың сайрауы сияқты.
Dialogue: 0,0:20:13.42,0:20:14.42,Default,,0,0,0,,Иә
Dialogue: 0,0:20:20.88,0:20:23.47,Default,,0,0,0,,А... Сенпай?
Dialogue: 0,0:20:23.55,0:20:27.64,Default,,0,0,0,,Келесі жолы мен фагот балаларымен қос құрақ кездесуін өткіземін.
Dialogue: 0,0:20:27.72,0:20:31.23,Default,,0,0,0,,Жарайды, мен үйге қайтып бара жатқанда шай ішемін деп ойлаймын.
Dialogue: 0,0:20:31.81,0:20:34.31,Default,,0,0,0,,Бізге қосылғың келе ме, Йороизука-сенпай?
Dialogue: 0,0:20:34.39,0:20:38.40,Default,,0,0,0,,Бұл тек төрт адамнан тұратын қос жетекші.
Dialogue: 0,0:20:39.69,0:20:40.82,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:20:41.53,0:20:44.07,Default,,0,0,0,,Солай ма...?
Dialogue: 0,0:20:47.16,0:20:49.58,Default,,0,0,0,,Еңбегіңіз үшін рахмет...
Dialogue: 0,0:20:51.20,0:20:52.20,Default,,0,0,0,,Я...
Dialogue: 0,0:20:54.87,0:20:56.12,Default,,0,0,0,,Нозоми
Dialogue: 0,0:20:56.21,0:20:58.67,Default,,0,0,0,,Аа, Мизоре, жақсы жұмыс~
Dialogue: 0,0:20:58.75,0:21:01.71,Default,,0,0,0,,Бүгін мен толық емес жұмысшылармен отбасылық мейрамханаға барып, үйге қайттым.
Dialogue: 0,0:21:03.34,0:21:04.51,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:21:04.59,0:21:05.76,Default,,0,0,0,,Иә
Dialogue: 0,0:21:07.97,0:21:10.93,Default,,0,0,0,,А... иә
Dialogue: 0,0:21:11.01,0:21:12.22,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:21:12.31,0:21:13.93,Default,,0,0,0,,Иә, ертең кездескенше.
Dialogue: 0,0:21:16.27,0:21:18.02,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:21:20.07,0:21:20.90,Default,,0,0,0,,Ах
Dialogue: 0,0:21:21.65,0:21:23.40,Default,,0,0,0,,Бүгін таңертең
Dialogue: 0,0:21:23.49,0:21:25.86,Default,,0,0,0,,Дұрыс, кешіріңіз, кешіріңіз.
Dialogue: 0,0:21:25.95,0:21:26.78,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:27.53,0:21:31.03,Default,,0,0,0,,Нозоми Сізге бұл оқиға ұнай ма?
Dialogue: 0,0:21:32.12,0:21:33.41,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:21:33.50,0:21:35.79,Default,,0,0,0,,Соңы аздап қайғылы.
Dialogue: 0,0:21:35.87,0:21:38.00,Default,,0,0,0,,Нозо-сенпай~
Dialogue: 0,0:21:38.08,0:21:40.42,Default,,0,0,0,,А, мен қазір барамын~
Dialogue: 0,0:21:42.75,0:21:44.13,Default,,0,0,0,,Джейн
Dialogue: 0,0:21:44.63,0:21:45.63,Default,,0,0,0,,Иә
Dialogue: 0,0:22:02.65,0:22:04.65,Default,,0,0,0,,Бұл қос Лу Рид.
Dialogue: 0,0:22:04.74,0:22:07.53,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:22:07.61,0:22:11.53,Default,,0,0,0,,Аа, Йороизука-сенпай, еңбегіңіз үшін рахмет~
Dialogue: 0,0:22:11.62,0:22:13.49,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:22:14.29,0:22:15.62,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:22:19.37,0:22:22.42,Default,,0,0,0,,Сенпай, мен саған тоймаймын...
Dialogue: 0,0:22:25.55,0:22:29.59,Default,,0,0,0,,(флейта үйірмесі мүшелерінің дауысы)
Dialogue: 0,0:22:34.26,0:22:35.14,Default,,0,0,0,,Ах
Dialogue: 0,0:22:35.22,0:22:36.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:38.81,0:22:40.44,Default,,0,0,0,,А...
Dialogue: 0,0:22:40.52,0:22:41.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:42.98,0:22:44.19,Default,,0,0,0,,Бұл!
Dialogue: 0,0:22:45.11,0:22:48.32,Default,,0,0,0,,Қой ойнайтыныңызға сенімдімін...
Dialogue: 0,0:22:48.40,0:22:50.86,Default,,0,0,0,,Бұл сауыт емес... бұл Кензаки.
Dialogue: 0,0:22:50.95,0:22:53.08,Default,,0,0,0,,Ахаха
Dialogue: 0,0:22:53.16,0:22:54.74,Default,,0,0,0,,Не?
Dialogue: 0,0:22:54.83,0:22:57.29,Default,,0,0,0,,Құрыш емес...
Dialogue: 0,0:22:57.37,0:23:00.50,Default,,0,0,0,,Мен Йороизука-сенпайға қатысты кеңес алдым...
Dialogue: 0,0:23:00.58,0:23:01.92,Default,,0,0,0,,Қар?
Dialogue: 0,0:23:02.92,0:23:03.75,Default,,0,0,0,,Не болды?
Dialogue: 0,0:23:03.84,0:23:10.01,Default,,0,0,0,,Ым, Йороизука-сенпай екеуің жақсы доссыңдар, солай ма?
Dialogue: 0,0:23:10.09,0:23:11.84,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:23:11.93,0:23:15.35,Default,,0,0,0,,Сондықтан мен кеңес алғым келеді.
Dialogue: 0,0:23:15.43,0:23:17.02,Default,,0,0,0,,Иә, не болды?
Dialogue: 0,0:23:17.10,0:23:21.10,Default,,0,0,0,,Иә, у... мен.
Dialogue: 0,0:23:21.19,0:23:25.15,Default,,0,0,0,,Мүмкін мен Йороизука-сенпаймен жақсы араласпайтын шығармын.
Dialogue: 0,0:23:25.23,0:23:28.15,Default,,0,0,0,,Солай ма? Неліктен?
Dialogue: 0,0:23:29.40,0:23:31.36,Default,,0,0,0,,Түсіндім⸺
Dialogue: 0,0:23:31.45,0:23:35.62,Default,,0,0,0,,Мен онымен сөйлессем де, ол шынымен жауап бермейді.
Dialogue: 0,0:23:36.24,0:23:41.04,Default,,0,0,0,,Мен онымен сөйлесе алсам да, ол онша қызықтырмайтын сияқты...
Dialogue: 0,0:23:41.54,0:23:42.87,Default,,0,0,0,,Мүмкін мен шығармын⸺
Dialogue: 0,0:23:43.54,0:23:47.13,Default,,0,0,0,,Адамдар мені жек көре ме екен...
Dialogue: 0,0:23:47.21,0:23:49.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:49.84,0:23:53.89,Default,,0,0,0,,Қарлы қарда біртүрлі нәрсе бар.
Dialogue: 0,0:23:53.97,0:23:56.64,Default,,0,0,0,,Мүмкін сен... (Ририка) Кензаки.
Dialogue: 0,0:23:56.72,0:23:58.81,Default,,0,0,0,,Сондай-ақ, Ририка.
Dialogue: 0,0:23:58.89,0:24:03.52,Default,,0,0,0,,Хехе, ол Ририка-чанды жек көрмейді деп ойлаймын.
Dialogue: 0,0:24:03.60,0:24:05.48,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:24:05.56,0:24:07.69,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:24:10.90,0:24:13.78,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:24:13.86,0:24:16.62,Default,,0,0,0,,А, бұл менің алғысым.
Dialogue: 0,0:24:16.70,0:24:18.37,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:24:18.45,0:24:23.12,Default,,0,0,0,,Бұл дүкеннен алынған пісірілген жұмыртқа. Бұл дәмді және дәмді.
Dialogue: 0,0:24:23.21,0:24:25.71,Default,,0,0,0,,Аа... (Ририка) Кешіріңіз.
Dialogue: 0,0:24:32.22,0:24:33.26,Default,,0,0,0,,Лиз!
Dialogue: 0,0:24:37.01,0:24:38.31,Default,,0,0,0,,Иә
Dialogue: 0,0:24:40.89,0:24:42.18,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:24:42.27,0:24:43.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:47.52,0:24:49.94,Default,,0,0,0,,Уау Ахахха
Dialogue: 0,0:24:50.03,0:24:52.74,Default,,0,0,0,,Әй! Ахахаха...
Dialogue: 0,0:24:53.57,0:24:54.95,Default,,0,0,0,,Маған көмектесіңіз~
Dialogue: 0,0:24:55.03,0:24:57.62,Default,,0,0,0,,Өзіңізді жақсы сезінгеніңізге қуаныштымын.
Dialogue: 0,0:24:59.87,0:25:00.70,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:25:06.75,0:25:07.63,Default,,0,0,0,,Ахх
Dialogue: 0,0:25:14.34,0:25:16.13,Default,,0,0,0,,Лиздің орамалы...
Dialogue: 0,0:25:25.19,0:25:28.19,Default,,0,0,0,,Нан көп, Лиз!
Dialogue: 0,0:25:29.23,0:25:30.36,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:25:30.44,0:25:31.48,Default,,0,0,0,,Кохон
Dialogue: 0,0:25:38.45,0:25:39.95,Default,,0,0,0,,Мен мұны да ала аламын ба?
Dialogue: 0,0:25:40.03,0:25:41.03,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:25:47.92,0:25:49.33,Default,,0,0,0,,Уау...
Dialogue: 0,0:25:49.92,0:25:53.71,Default,,0,0,0,,Уфуфуфу! Ухухуху
Dialogue: 0,0:25:53.80,0:25:55.30,Default,,0,0,0,,Ах~ Хэхе
Dialogue: 0,0:26:00.97,0:26:02.18,Default,,0,0,0,,Сіз оны қолданып көргіңіз келе ме?
Dialogue: 0,0:26:05.56,0:26:06.85,Default,,0,0,0,,Хмм!
Dialogue: 0,0:26:06.94,0:26:10.06,Default,,0,0,0,,О, дәмді! Хехехе
Dialogue: 0,0:26:11.15,0:26:12.61,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:26:33.92,0:26:36.59,Default,,0,0,0,,Әй, сен қайдансың?
Dialogue: 0,0:26:37.09,0:26:40.80,Default,,0,0,0,,Мен білмеймін. Мен көптеген қалалар мен ормандарды көрдім.
Dialogue: 0,0:26:41.47,0:26:43.22,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:26:44.43,0:26:46.47,Default,,0,0,0,,Өйткені Лиз жалғыз қалды.
Dialogue: 0,0:26:47.93,0:26:51.44,Default,,0,0,0,,Мен Лизбен көп араласқым келді.
Dialogue: 0,0:26:51.52,0:26:52.36,Default,,0,0,0,,Хехехе
Dialogue: 0,0:27:00.45,0:27:01.87,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:27:05.95,0:27:07.54,Default,,0,0,0,,Не болды?
Dialogue: 0,0:27:08.29,0:27:09.12,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:27:10.83,0:27:12.38,Default,,0,0,0,,Менің қасымда бол
Dialogue: 0,0:27:13.04,0:27:15.50,Default,,0,0,0,,мәңгілік
Dialogue: 0,0:27:15.59,0:27:17.21,Default,,0,0,0,,«Менің қасымда бол»
Dialogue: 0,0:27:18.38,0:27:21.76,Default,,0,0,0,,
Dialogue: 0,0:27:22.64,0:27:25.26,Default,,0,0,0,,Мектептен үйге кететін уақыт.
Dialogue: 0,0:27:25.35,0:27:28.35,Default,,0,0,0,,Тезірек кетіңіз.
Dialogue: 0,0:27:28.85,0:27:31.39,Default,,0,0,0,,Мектептен үйге кететін уақыт.
Dialogue: 0,0:27:34.19,0:27:35.36,Default,,0,0,0,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,0:27:36.61,0:27:39.28,Default,,0,0,0,,Мен есікті құлыптаймын.
Dialogue: 0,0:27:39.36,0:27:41.49,Default,,0,0,0,,Қайырлы таң~ (Оқушы қыз) Қайырлы таң.
Dialogue: 0,0:27:42.11,0:27:43.45,Default,,0,0,0,,Үй тапсырмасын орындадың ба?
Dialogue: 0,0:27:50.83,0:27:52.37,Default,,0,0,0,,Мен оны жақсы көремін!
Dialogue: 0,0:27:52.46,0:27:53.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:53.96,0:27:55.29,Default,,0,0,0,,Ол өте еңбекқор⸺
Dialogue: 0,0:27:55.38,0:27:58.88,Default,,0,0,0,,Салқын болу және жаттығу жасай алу - бәрі тамаша!
Dialogue: 0,0:27:58.96,0:28:01.88,Default,,0,0,0,,Мен Сатсукимін...
Dialogue: 0,0:28:01.97,0:28:02.80,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:28:03.55,0:28:05.30,Default,,0,0,0,,Бұл құшақтау...
Dialogue: 0,0:28:05.39,0:28:10.31,Default,,0,0,0,,Бұл балалар Нанчудан келген бе? Мен оны орта мектепте оқып жүргенімде жасадым.
Dialogue: 0,0:28:10.39,0:28:11.39,Default,,0,0,0,,Иә
Dialogue: 0,0:28:12.89,0:28:15.02,Default,,0,0,0,,Жарайсың~
Dialogue: 0,0:28:15.11,0:28:18.53,Default,,0,0,0,,Басқа адамның сізге ұнайтыны туралы айтып жатқанда құшақтаңыз.
Dialogue: 0,0:28:18.61,0:28:22.49,Default,,0,0,0,,Менің әрқашан істегенім жай ғана қарау болды...
Dialogue: 0,0:28:22.57,0:28:23.99,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:28:24.07,0:28:24.91,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:28:25.49,0:28:26.32,Default,,0,0,0,,А...?
Dialogue: 0,0:28:28.08,0:28:29.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:32.08,0:28:34.17,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:28:34.25,0:28:36.13,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:28:36.21,0:28:38.59,Default,,0,0,0,,Ах, у...
Dialogue: 0,0:28:38.67,0:28:39.67,Default,,0,0,0,,Кеттік
Dialogue: 0,0:28:40.30,0:28:41.30,Default,,0,0,0,,Иә
Dialogue: 0,0:28:45.76,0:28:46.80,Default,,0,0,0,,Олай болса~
Dialogue: 0,0:28:47.51,0:28:48.89,Default,,0,0,0,,Иә
Dialogue: 0,0:28:50.81,0:28:52.43,Default,,0,0,0,,О!
Dialogue: 0,0:28:56.06,0:28:57.19,Default,,0,0,0,,Қар
Dialogue: 0,0:29:00.78,0:29:01.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:05.28,0:29:06.95,Default,,0,0,0,,Иә
Dialogue: 0,0:29:07.03,0:29:08.12,Default,,0,0,0,,Мен...
Dialogue: 0,0:29:09.78,0:29:11.12,Default,,0,0,0,,Нацуки
Dialogue: 0,0:29:13.12,0:29:13.96,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:29:15.21,0:29:16.04,Default,,0,0,0,,Йороизука
Dialogue: 0,0:29:18.17,0:29:22.30,Default,,0,0,0,,Мансап сауалнамасы Онда менің аты-жөнім ғана жазылған?
Dialogue: 0,0:29:24.34,0:29:27.43,Default,,0,0,0,,Келесі аптаға дейін жазып, жіберіңіз.
Dialogue: 0,0:29:28.01,0:29:29.01,Default,,0,0,0,,Иә
Dialogue: 0,0:29:31.89,0:29:34.31,Default,,0,0,0,,Мысалы, 2 және 3, 4 және 5⸺
Dialogue: 0,0:29:34.39,0:29:38.27,Default,,0,0,0,,1-ден басқа ортақ бөлгішсіз қатынас
Dialogue: 0,0:29:38.35,0:29:41.57,Default,,0,0,0,,Осындай екі сан «салыстырмалы жай» деп айтылады.
Dialogue: 0,0:29:49.95,0:29:50.78,Default,,0,0,0,,Нацуки!
Dialogue: 0,0:29:56.79,0:29:58.71,Default,,0,0,0,,Гарн
Dialogue: 0,0:29:58.79,0:30:00.13,Default,,0,0,0,,
Dialogue: 0,0:30:00.21,0:30:01.96,Default,,0,0,0,,Иә Ауыстыру
Dialogue: 0,0:30:02.71,0:30:03.88,Default,,0,0,0,,Қар
Dialogue: 0,0:30:05.17,0:30:06.47,Default,,0,0,0,,Бұл өзгеріс.
Dialogue: 0,0:30:06.97,0:30:07.97,Default,,0,0,0,,Иә
Dialogue: 0,0:30:08.80,0:30:09.84,Default,,0,0,0,,Неліктен жоқ?
Dialogue: 0,0:30:14.72,0:30:15.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:16.43,0:30:17.98,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:30:18.06,0:30:19.06,Default,,0,0,0,,...Шотто
Dialogue: 0,0:30:19.77,0:30:22.11,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:30:25.57,0:30:26.40,Default,,0,0,0,,
Dialogue: 0,0:30:34.58,0:30:37.16,Default,,0,0,0,,Мені «сүйкімді» деп атады~
Dialogue: 0,0:30:37.25,0:30:40.00,Default,,0,0,0,,Ол бір сыныптағы биология зерттеу тобының баласы.
Dialogue: 0,0:30:40.08,0:30:42.09,Default,,0,0,0,,
Dialogue: 0,0:30:42.92,0:30:45.30,Default,,0,0,0,,Бұл таңқаларлық. Қандай жағдайларда?
Dialogue: 0,0:30:45.96,0:30:49.13,Default,,0,0,0,,Біз таңғы асқа не ішу керектігін айта бастадық.
Dialogue: 0,0:30:49.22,0:30:50.80,Default,,0,0,0,,Француз тосты\NЖауап
Dialogue: 0,0:30:50.89,0:30:53.14,Default,,0,0,0,,болды.
Dialogue: 0,0:30:53.72,0:30:56.93,Default,,0,0,0,,А, бұл бүршік.
Dialogue: 0,0:30:57.02,0:30:58.48,Default,,0,0,0,,Уау~
Dialogue: 0,0:30:58.56,0:30:59.52,Default,,0,0,0,,Мен ұялып тұрмын
Dialogue: 0,0:30:59.60,0:31:01.06,Default,,0,0,0,,Мен ұялып тұрмын
Dialogue: 0,0:31:01.15,0:31:04.40,Default,,0,0,0,,Нозо-сенпай, сен кездесуге бардың ба?
Dialogue: 0,0:31:04.48,0:31:06.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:15.12,0:31:16.12,Default,,0,0,0,,Қапшық балық
Dialogue: 0,0:32:02.46,0:32:03.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:33.91,0:32:34.74,Default,,0,0,0,,Ах
Dialogue: 0,0:32:58.72,0:33:00.39,Default,,0,0,0,,Жақында тыңдау болады.
Dialogue: 0,0:33:00.47,0:33:02.02,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:33:02.10,0:33:05.81,Default,,0,0,0,,Сыбызғы солисын Нозо Сенпай орындаса керек.
Dialogue: 0,0:33:05.90,0:33:08.06,Default,,0,0,0,,Бұл дәмді!
Dialogue: 0,0:33:13.99,0:33:17.99,Default,,0,0,0,,(гобой дыбысы)
Dialogue: 0,0:33:29.17,0:33:33.17,Default,,0,0,0,,(флейта дыбысы)
Dialogue: 0,0:33:38.51,0:33:41.35,Default,,0,0,0,,Қарашы, Лиз, ай туды!
Dialogue: 0,0:33:41.43,0:33:43.06,Default,,0,0,0,,Өте әдемі!
Dialogue: 0,0:33:44.81,0:33:46.60,Default,,0,0,0,,Ертең де күн ашық болатынына сенімдімін!
Dialogue: 0,0:33:46.69,0:33:48.15,Default,,0,0,0,,Иә.
Dialogue: 0,0:33:49.69,0:33:52.32,Default,,0,0,0,,Мен де ертең Лизбен көп ойнай аламын.
Dialogue: 0,0:33:55.07,0:33:57.74,Default,,0,0,0,,Мен сені жақсы көремін, Лиз.
Dialogue: 0,0:33:58.45,0:33:59.62,Default,,0,0,0,,Мен де
Dialogue: 0,0:34:00.32,0:34:02.87,Default,,0,0,0,,Қайырлы түн, ертең кездескенше
Dialogue: 0,0:34:02.95,0:34:04.50,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:35:06.52,0:35:08.27,Default,,0,0,0,,Жақында күн суытады
Dialogue: 0,0:35:08.35,0:35:10.81,Default,,0,0,0,,Иә, қыс келе жатыр.
Dialogue: 0,0:35:10.90,0:35:13.48,Default,,0,0,0,,Сонда Лиз қайда барады?
Dialogue: 0,0:35:14.90,0:35:17.99,Default,,0,0,0,,Мен ешқайда бармаймын, осындамын.
Dialogue: 0,0:35:19.28,0:35:20.11,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:35:57.98,0:35:58.99,Default,,0,0,0,,Сіздің кезегіңіз.
Dialogue: 0,0:36:00.11,0:36:02.03,Default,,0,0,0,,Ол қытықтайды
Dialogue: 0,0:36:02.11,0:36:03.82,Default,,0,0,0,,Жақсы қыз.
Dialogue: 0,0:36:03.91,0:36:06.24,Default,,0,0,0,,Сол жерде отырма.
Dialogue: 0,0:36:35.10,0:36:36.52,Default,,0,0,0,,Йороизука мырза
Dialogue: 0,0:36:41.07,0:36:43.11,Default,,0,0,0,,Доктор Ниияма...
Dialogue: 0,0:36:43.74,0:36:46.03,Default,,0,0,0,,Сізбен бір сәт сөйлесе аламын ба?
Dialogue: 0,0:36:47.95,0:36:49.54,Default,,0,0,0,,Көптен бері көрмеген.
Dialogue: 0,0:36:49.62,0:36:52.04,Default,,0,0,0,,Мұнда Сіз қайдан білдіңіз?
Dialogue: 0,0:36:52.12,0:36:55.63,Default,,0,0,0,,Құрыш... Кензаки-сан емес
Dialogue: 0,0:36:55.71,0:36:58.13,Default,,0,0,0,,Ол маған осында болуы мүмкін екенін айтты.
Dialogue: 0,0:36:59.05,0:37:00.63,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:37:01.96,0:37:05.72,Default,,0,0,0,,Сайыс әні Керемет ән болады деп шешілді.
Dialogue: 0,0:37:07.47,0:37:10.35,Default,,0,0,0,,Бұл әнде флейта мен гобой
Dialogue: 0,0:37:10.43,0:37:13.73,Default,,0,0,0,,Бұл Лиз мен Көк құсты бейнелейді делінеді.
Dialogue: 0,0:37:14.85,0:37:20.40,Default,,0,0,0,,Үшінші бөлімдегі жеке диалог Лиз мен қыздың қоштасуы екені сөзсіз.
Dialogue: 0,0:37:22.74,0:37:25.49,Default,,0,0,0,,Нозоми? Сіз кеше кеттіңіз
Dialogue: 0,0:37:25.57,0:37:28.28,Default,,0,0,0,,Сіз мұны білмедіңіз бе, Йороизука мырза?
Dialogue: 0,0:37:29.33,0:37:30.62,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:37:34.54,0:37:35.41,Default,,0,0,0,,Мен үшін⸺
Dialogue: 0,0:37:36.17,0:37:38.79,Default,,0,0,0,,Лиздің көк құстың қашып кетуіне деген сезімі⸺
Dialogue: 0,0:37:38.88,0:37:41.13,Default,,0,0,0,,Мен толық түсінбеймін
Dialogue: 0,0:37:41.63,0:37:42.96,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:37:46.43,0:37:51.31,Default,,0,0,0,,Иә, бүгін мен Йороизука мырзамен сөйлестім.
Dialogue: 0,0:37:52.43,0:37:53.68,Default,,0,0,0,,Йороизука мырза
Dialogue: 0,0:37:53.77,0:37:56.56,Default,,0,0,0,,Сіз өзіңіздің мансабыңыз туралы шешім қабылдадыңыз ба?
Dialogue: 0,0:38:00.48,0:38:04.49,Default,,0,0,0,,(флейта және пикколо дыбыстары)
Dialogue: 0,0:38:06.32,0:38:07.41,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:38:07.49,0:38:08.49,Default,,0,0,0,,Иә
Dialogue: 0,0:38:09.70,0:38:10.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:38:11.20,0:38:12.95,Default,,0,0,0,,Қар?
Dialogue: 0,0:38:22.84,0:38:24.01,Default,,0,0,0,,Қар
Dialogue: 0,0:38:26.05,0:38:27.30,Default,,0,0,0,,Сіз не істеп жүрсіз?
Dialogue: 0,0:38:28.18,0:38:30.39,Default,,0,0,0,,Мен балықты қоректендірдім.
Dialogue: 0,0:38:30.89,0:38:32.56,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:38:32.64,0:38:35.10,Default,,0,0,0,,Лиз сияқты
Dialogue: 0,0:38:38.14,0:38:40.56,Default,,0,0,0,,Сіз оған тәуелдісіз бе? Қасқыр балық
Dialogue: 0,0:38:40.65,0:38:42.36,Default,,0,0,0,,Эм… Май-сан. Не болды?
Dialogue: 0,0:38:42.44,0:38:44.73,Default,,0,0,0,,Келесі жолы мен де бара аламын ба?
Dialogue: 0,0:38:44.82,0:38:45.82,Default,,0,0,0,,Иә
Dialogue: 0,0:38:46.61,0:38:48.32,Default,,0,0,0,,Нозоми де
Dialogue: 0,0:38:48.40,0:38:50.70,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:38:50.78,0:38:53.45,Default,,0,0,0,,Бұл... кітапша ма?
Dialogue: 0,0:38:53.53,0:38:55.70,Default,,0,0,0,,Иә, мен мұны түсінемін.
Dialogue: 0,0:38:55.79,0:38:57.50,Default,,0,0,0,,Мен оны көре аламын ба? Иә
Dialogue: 0,0:38:59.33,0:39:02.84,Default,,0,0,0,,Музыкалық колледжге арналған кітапша? иә?
Dialogue: 0,0:39:02.92,0:39:04.75,Default,,0,0,0,,Иә? Дәлірек айтқанда, бұл
Dialogue: 0,0:39:04.84,0:39:07.01,Default,,0,0,0,,Мизор, сен музыкалық колледжге түсесің бе?
Dialogue: 0,0:39:09.13,0:39:11.30,Default,,0,0,0,,Оны маған Ниияма мырза берді.
Dialogue: 0,0:39:11.39,0:39:13.14,Default,,0,0,0,,«Сізді қызықтырасыз ба?»
Dialogue: 0,0:39:15.35,0:39:16.72,Default,,0,0,0,,Хмм…
Dialogue: 0,0:39:21.23,0:39:22.36,Default,,0,0,0,,Нозоми?
Dialogue: 0,0:39:22.44,0:39:23.27,Default,,0,0,0,,Мен...
Dialogue: 0,0:39:23.98,0:39:26.48,Default,,0,0,0,,Осы университетке түсуім керек пе?
Dialogue: 0,0:39:29.36,0:39:31.20,Default,,0,0,0,,Қайырлы таң, Мидория-кун.
Dialogue: 0,0:39:33.32,0:39:34.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:34.24,0:39:37.16,Default,,0,0,0,,Нозоми қабылдаса, мен де қабылдаймын.
Dialogue: 0,0:39:39.08,0:39:41.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:39:44.25,0:39:45.09,Default,,0,0,0,,Я...
Dialogue: 0,0:39:45.17,0:39:47.96,Default,,0,0,0,,Бұл кестені қалай жасауға болады
Dialogue: 0,0:39:48.05,0:39:50.22,Default,,0,0,0,,Сіз өзіңіз тым көп істеп жатырсыз.
Dialogue: 0,0:39:50.30,0:39:52.76,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:39:52.84,0:39:55.10,Default,,0,0,0,,Сіз Асука-сенпай емессіз.
Dialogue: 0,0:39:55.18,0:39:57.14,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:40:00.39,0:40:04.40,Default,,0,0,0,,(Мизордың фортепиано орындауы)
Dialogue: 0,0:40:05.27,0:40:06.86,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:40:06.94,0:40:09.11,Default,,0,0,0,,Нозоми Клубтың ақысы қандай?
Dialogue: 0,0:40:10.40,0:40:13.86,Default,,0,0,0,,Цукамото, Такигава және Такино әлі
Dialogue: 0,0:40:13.95,0:40:16.08,Default,,0,0,0,,Дереу жинақ жинағы
Dialogue: 0,0:40:16.16,0:40:17.45,Default,,0,0,0,,Мен~?
Dialogue: 0,0:40:17.54,0:40:19.50,Default,,0,0,0,,Сіз есепшісіз, солай ма?
Dialogue: 0,0:40:19.58,0:40:21.00,Default,,0,0,0,,Хехехе
Dialogue: 0,0:40:21.87,0:40:24.71,Default,,0,0,0,,Аа, бүгін сынақ емтиханы ма?
Dialogue: 0,0:40:24.79,0:40:26.88,Default,,0,0,0,,Мен үйірме жұмыстарына көңіл бөлгім келсе де...
Dialogue: 0,0:40:26.96,0:40:31.34,Default,,0,0,0,,Менімен бір мектепте оқитын сенің бір сүйкімділігің бар.
Dialogue: 0,0:40:31.42,0:40:35.55,Default,,0,0,0,,Иә? Ең жаманы осы ғана.
Dialogue: 0,0:40:35.64,0:40:38.51,Default,,0,0,0,,Біз университетке барсақ та, біз әрқашан дос боламыз.
Dialogue: 0,0:40:38.60,0:40:41.27,Default,,0,0,0,,Әй, бұл не деген қаздар?
Dialogue: 0,0:40:41.35,0:40:44.27,Default,,0,0,0,,Менің колледжге түсуім қорқынышты кездейсоқтық болды.
Dialogue: 0,0:40:44.35,0:40:45.81,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:40:50.23,0:40:52.28,Default,,0,0,0,,Мизоре, мен музыкалық колледжге түсемін.
Dialogue: 0,0:40:54.86,0:40:57.74,Default,,0,0,0,,Дұрыс! Бұл керемет Мизор
Dialogue: 0,0:40:57.83,0:40:58.83,Default,,0,0,0,,Сәлем
Dialogue: 0,0:41:01.37,0:41:03.29,Default,,0,0,0,,Себебі Нозоми оны қабылдайды⸺
Dialogue: 0,0:41:03.37,0:41:04.87,Default,,0,0,0,,Мен де
Dialogue: 0,0:41:08.59,0:41:12.42,Default,,0,0,0,,Ахахха, екеуің де не нәрсеге байсалдысыңдар?
Dialogue: 0,0:41:12.51,0:41:13.51,Default,,0,0,0,,Мизордың қалжыңы
Dialogue: 0,0:41:16.34,0:41:18.51,Default,,0,0,0,,Нозоми, мен музыкалық колледжге түсемін.
Dialogue: 0,0:41:18.60,0:41:20.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:20.85,0:41:21.81,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:41:21.89,0:41:23.98,Default,,0,0,0,,Дегенмен сенімді емеспін
Dialogue: 0,0:41:24.77,0:41:26.77,Default,,0,0,0,,Аа, дұрыс (Юко) Эй...
Dialogue: 0,0:41:28.61,0:41:30.40,Default,,0,0,0,,Жақында Агата фестивалі келеді.
Dialogue: 0,0:41:31.15,0:41:34.03,Default,,0,0,0,,Өте өкінішті, менің уақытым жетпейді.
Dialogue: 0,0:41:34.11,0:41:37.32,Default,,0,0,0,,Үйірме жұмыстарынан бір рет бас тартыңыз.
Dialogue: 0,0:41:38.57,0:41:41.04,Default,,0,0,0,,Мизоре~ Бірге барайық
Dialogue: 0,0:41:41.74,0:41:42.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:43.33,0:41:44.87,Default,,0,0,0,,Агата фестивалі
Dialogue: 0,0:41:47.21,0:41:49.96,Default,,0,0,0,,Иә? Жоспарларыңыз болды ма?
Dialogue: 0,0:41:51.46,0:41:52.51,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:41:52.59,0:41:54.05,Default,,0,0,0,,Олай болса барамыз ба?
Dialogue: 0,0:41:54.67,0:41:56.55,Default,,0,0,0,,Егер Нозоми саған жақсы болса
Dialogue: 0,0:42:00.97,0:42:02.72,Default,,0,0,0,,Юко да, Нацуки де тегін, солай ма?
Dialogue: 0,0:42:03.68,0:42:06.06,Default,,0,0,0,,Иә, жарайды
Dialogue: 0,0:42:09.36,0:42:10.90,Default,,0,0,0,,Менеджер кім? (Юко) Уау
Dialogue: 0,0:42:11.65,0:42:12.61,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:42:15.11,0:42:16.20,Default,,0,0,0,,Ира Қарлы қар ше? Басқа барғысы келетіндер бар ма?
Dialogue: 0,0:42:16.20,0:42:16.28,Default,,0,0,0,,Қарлы қар ше? Басқа барғысы келетіндер бар ма?
Dialogue: 0,0:42:16.28,0:42:18.53,Default,,0,0,0,,Бұл өте ақымақтық болды. Мизор ше? Басқа барғысы келетіндер бар ма?
Dialogue: 0,0:42:18.53,0:42:18.61,Default,,0,0,0,,Қарлы қар ше? Басқа барғысы келетіндер бар ма?
Dialogue: 0,0:42:18.61,0:42:19.07,Default,,0,0,0,,Мен саған қарыздармын, ал Мизоре ше? Басқа барғысы келетіндер бар ма?
Dialogue: 0,0:42:19.07,0:42:19.99,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:42:19.99,0:42:20.82,Default,,0,0,0,,Мен саған қарыздармын, бірақ мен жоқпын.
Dialogue: 0,0:42:22.66,0:42:23.83,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:42:32.59,0:42:36.55,Default,,0,0,0,,Нозо-сенпай, мен келесі жолы аквариумға барамын.
Dialogue: 0,0:42:36.63,0:42:40.26,Default,,0,0,0,,А, сол сыныпта ма? Сіз жасадыңыз!
Dialogue: 0,0:42:40.34,0:42:41.47,Default,,0,0,0,,Мен не киюім керек?
Dialogue: 0,0:42:41.55,0:42:43.56,Default,,0,0,0,,Бұл бір бөліктен тұратын көйлек, солай ма?
Dialogue: 0,0:42:43.64,0:42:45.39,Default,,0,0,0,,Сізде жоқ, солай ма?
Dialogue: 0,0:42:45.47,0:42:47.23,Default,,0,0,0,,Бір бөлік, иә? (Флейта 1 курс) Жоқ
Dialogue: 0,0:42:48.60,0:42:49.52,Default,,0,0,0,,Саған қарызға берейін бе?
Dialogue: 0,0:42:49.60,0:42:51.48,Default,,0,0,0,,Иә? Бұл жақсы ма?
Dialogue: 0,0:42:51.56,0:42:53.61,Default,,0,0,0,,Цубо-сенпайға рахмет!
Dialogue: 0,0:42:53.69,0:42:55.36,Default,,0,0,0,,Цубомидің киімдері бар~?
Dialogue: 0,0:42:55.44,0:42:59.20,Default,,0,0,0,,Иә? (күлкі)
Dialogue: 0,0:42:59.28,0:43:02.62,Default,,0,0,0,,(гобой дыбысы)
Dialogue: 0,0:43:02.70,0:43:04.70,Default,,0,0,0,,Мизо-сенпай~
Dialogue: 0,0:43:06.20,0:43:08.21,Default,,0,0,0,,Жаңбыр жауып тұр емес пе?
Dialogue: 0,0:43:09.92,0:43:14.04,Default,,0,0,0,,А... жақсы болмады ма? «Мизо-сенпай»
Dialogue: 0,0:43:14.67,0:43:17.67,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:43:18.42,0:43:19.55,Default,,0,0,0,,Иә
Dialogue: 0,0:43:24.97,0:43:25.81,Default,,0,0,0,,Уау
Dialogue: 0,0:43:25.89,0:43:29.31,Default,,0,0,0,,Мизо-сенпай, мынау әдемі!
Dialogue: 0,0:43:29.39,0:43:32.31,Default,,0,0,0,,Сіз тек ақ түсті сатасыз ба?
Dialogue: 0,0:43:33.27,0:43:34.98,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:43:35.07,0:43:37.19,Default,,0,0,0,,Нозоми маған берді
Dialogue: 0,0:43:37.28,0:43:38.57,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:43:39.07,0:43:41.74,Default,,0,0,0,,Біз өте жақсы доспыз.
Dialogue: 0,0:43:41.82,0:43:43.74,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:43:46.29,0:43:47.70,Default,,0,0,0,,Мизо Сенпай
Dialogue: 0,0:43:47.79,0:43:50.08,Default,,0,0,0,,Келесі жолы тыңдау алдында
Dialogue: 0,0:43:50.16,0:43:52.83,Default,,0,0,0,,Бізде тағы бір қос құрақ кездесуі бар⸺
Dialogue: 0,0:43:52.92,0:43:58.01,Default,,0,0,0,,Мизо-сенпай, қаласаң, сен де келер ме едің?
Dialogue: 0,0:44:01.26,0:44:03.55,Default,,0,0,0,,Өйткені мен мұнда болсам да қызық емес
Dialogue: 0,0:44:03.64,0:44:07.01,Default,,0,0,0,,Әрине, олай емес!
Dialogue: 0,0:44:09.93,0:44:11.31,Default,,0,0,0,,Бір күні кездескенше
Dialogue: 0,0:44:13.10,0:44:15.02,Default,,0,0,0,,Иә...
Dialogue: 0,0:44:17.86,0:44:18.78,Default,,0,0,0,,Бұл
Dialogue: 0,0:44:20.11,0:44:22.82,Default,,0,0,0,,Қайтарылған күннен бері бір ай өтті.
Dialogue: 0,0:44:22.91,0:44:26.62,Default,,0,0,0,,Менің ойымша, оны қарызға алғысы келетін басқа адамдар бар.
Dialogue: 0,0:44:26.70,0:44:29.37,Default,,0,0,0,,Кітапханадағы кітаптар барлығына арналған.
Dialogue: 0,0:44:29.45,0:44:31.66,Default,,0,0,0,,Иә, иә, түсіндім!
Dialogue: 0,0:44:31.75,0:44:34.67,Default,,0,0,0,,Мен қазірден бастап сақ боламын!
Dialogue: 0,0:44:35.58,0:44:36.96,Default,,0,0,0,,Кеттік
Dialogue: 0,0:44:38.63,0:44:41.34,Default,,0,0,0,,Бұлай табанды болудың қажеті жоқ.
Dialogue: 0,0:44:41.42,0:44:42.26,Default,,0,0,0,,Иә
Dialogue: 0,0:44:42.34,0:44:45.26,Default,,0,0,0,,Мен кітаптарды қайтаруды ұмытып қаламын.
Dialogue: 0,0:44:45.34,0:44:46.35,Default,,0,0,0,,Иә
Dialogue: 0,0:44:49.60,0:44:52.39,Default,,0,0,0,,«Лиз» маған қарызға алғанымды берер еді.
Dialogue: 0,0:44:55.02,0:44:56.52,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:44:56.61,0:44:57.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:57.98,0:45:00.65,Default,,0,0,0,,Мен оны қайтадан жалға беремін.
Dialogue: 0,0:45:00.73,0:45:03.03,Default,,0,0,0,,Не болды? Қарлы қар
Dialogue: 0,0:45:03.11,0:45:06.03,Default,,0,0,0,,Кітапханадағы кітаптарды басқаларға қарызға беру жақсы емес.
Dialogue: 0,0:45:06.12,0:45:09.16,Default,,0,0,0,,Иә, иә, түсіндім!
Dialogue: 0,0:45:10.20,0:45:12.20,Default,,0,0,0,,Хаха хаха
Dialogue: 0,0:45:29.72,0:45:30.64,Default,,0,0,0,,Мизо Сенпай
Dialogue: 0,0:45:31.68,0:45:32.89,Default,,0,0,0,,Уау
Dialogue: 0,0:45:32.98,0:45:36.85,Default,,0,0,0,,Мизо-сенпай, ленталарды өзіңіз жасайсыз ба?
Dialogue: 0,0:45:37.90,0:45:39.69,Default,,0,0,0,,Тек жартысы?
Dialogue: 0,0:45:39.77,0:45:42.15,Default,,0,0,0,,Сіз жай ғана пышақ салуды айтасыз ба?
Dialogue: 0,0:45:42.23,0:45:44.15,Default,,0,0,0,,Жіпті орау
Dialogue: 0,0:45:44.24,0:45:45.99,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:45:46.66,0:45:48.62,Default,,0,0,0,,Мен де істей аламын ба?
Dialogue: 0,0:45:49.58,0:45:51.12,Default,,0,0,0,,Мен саған келесі жолы үйретемін
Dialogue: 0,0:45:51.20,0:45:52.83,Default,,0,0,0,,Күрсін...!
Dialogue: 0,0:45:52.91,0:45:54.87,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:45:54.96,0:45:55.79,Default,,0,0,0,,Иә
Dialogue: 0,0:45:55.87,0:45:59.29,Default,,0,0,0,,Ахаха, мен өте қуаныштымын.
Dialogue: 0,0:45:59.38,0:46:01.80,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:46:01.88,0:46:03.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:10.89,0:46:12.51,Default,,0,0,0,,Не болды?
Dialogue: 0,0:46:13.18,0:46:14.22,Default,,0,0,0,,(Ририканың жылағаны)
Dialogue: 0,0:46:15.64,0:46:17.39,Default,,0,0,0,,(айқайлаған дауыс)
Dialogue: 0,0:46:17.48,0:46:18.77,Default,,0,0,0,,Тыңдау…
Dialogue: 0,0:46:19.52,0:46:21.82,Default,,0,0,0,,Мен құладым!
Dialogue: 0,0:46:21.90,0:46:23.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:23.90,0:46:25.74,Default,,0,0,0,,Менің ағаммен...
Dialogue: 0,0:46:26.61,0:46:31.07,Default,,0,0,0,,Конкурсқа бірге қатысқым келді!
Dialogue: 0,0:46:31.16,0:46:35.16,Default,,0,0,0,,(Ририканың қатты жылап жатқан дыбысы)
Dialogue: 0,0:46:39.46,0:46:41.34,Default,,0,0,0,,Балмұздақ құтты болсын!
Dialogue: 0,0:46:41.42,0:46:44.46,Default,,0,0,0,,Бұл не? (Мидори) Иә? Сіз білмейсіз бе?
Dialogue: 0,0:46:44.55,0:46:49.18,Default,,0,0,0,,Хазуки-чан мен Мидори бір уақытта бір нәрсені айтты, солай ма?
Dialogue: 0,0:46:49.26,0:46:50.97,Default,,0,0,0,,Иә, дедім
Dialogue: 0,0:46:51.05,0:46:53.72,Default,,0,0,0,,Менің қарным ашты~ тәтті нәрсе
Dialogue: 0,0:46:53.81,0:46:55.47,Default,,0,0,0,,Мен жегім келеді (Мидори) Мен жегім келеді
Dialogue: 0,0:46:55.56,0:46:57.35,Default,,0,0,0,,Мұндай жағдайда дереу
Dialogue: 0,0:46:57.43,0:46:59.98,Default,,0,0,0,,«Бақытты балмұздақ» деп айқайлау
Dialogue: 0,0:47:00.06,0:47:01.10,Default,,0,0,0,,Иә
Dialogue: 0,0:47:01.19,0:47:02.65,Default,,0,0,0,,Алдымен айтқан жөн
Dialogue: 0,0:47:02.73,0:47:05.94,Default,,0,0,0,,Бұл балмұздақ сатып алуға болатын ойын.
Dialogue: 0,0:47:06.03,0:47:10.28,Default,,0,0,0,,Сонда ше? Мидориге балмұздақ сатып алуым керек пе?
Dialogue: 0,0:47:10.36,0:47:13.33,Default,,0,0,0,,Дұрыс, тамақ үшін рахмет, Хазуки-чан.
Dialogue: 0,0:47:13.41,0:47:15.79,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:47:15.87,0:47:17.33,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:47:17.41,0:47:18.54,Default,,0,0,0,,Қар
Dialogue: 0,0:47:19.75,0:47:21.92,Default,,0,0,0,,Мен орындықты тастап кете аламын ба?
Dialogue: 0,0:47:22.00,0:47:23.00,Default,,0,0,0,,Иә
Dialogue: 0,0:47:24.00,0:47:26.80,Default,,0,0,0,,Ой, ой...
Dialogue: 0,0:47:27.30,0:47:28.30,Default,,0,0,0,,О
Dialogue: 0,0:47:33.76,0:47:36.39,Default,,0,0,0,,Жаз келді!
Dialogue: 0,0:47:36.47,0:47:38.73,Default,,0,0,0,,Мен суға шомылғым келеді.
Dialogue: 0,0:47:39.23,0:47:41.31,Default,,0,0,0,,Әй, Мизоре
Dialogue: 0,0:47:41.40,0:47:43.77,Default,,0,0,0,,Алдағы мерекелерге жоспарларыңыз бар ма?
Dialogue: 0,0:47:44.73,0:47:46.28,Default,,0,0,0,,Атап айтқанда, ештеңе жоқ
Dialogue: 0,0:47:46.36,0:47:49.49,Default,,0,0,0,,Шынымен бе? Жарайды, бассейнге барайық.
Dialogue: 0,0:47:53.32,0:47:54.16,Default,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:47:54.24,0:47:57.20,Default,,0,0,0,,О, сонда шешілді.
Dialogue: 0,0:47:59.33,0:48:00.75,Default,,0,0,0,,Сәлем Нозоми
Dialogue: 0,0:48:00.83,0:48:01.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:03.38,0:48:05.88,Default,,0,0,0,,Басқа балаларды да шақыра аламын ба?
Dialogue: 0,0:48:09.21,0:48:10.88,Default,,0,0,0,,Не?
Dialogue: 0,0:48:10.97,0:48:13.64,Default,,0,0,0,,Мизордың бұлай айтуы сирек.
Dialogue: 0,0:48:13.72,0:48:15.76,Default,,0,0,0,,Жарайды, кім?
Dialogue: 0,0:48:17.60,0:48:22.77,Default,,0,0,0,,(Гобойдағы Шармера)
Dialogue: 0,0:48:27.86,0:48:29.53,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:48:31.15,0:48:32.40,Default,,0,0,0,,қаңтар
Dialogue: 0,0:48:32.90,0:48:34.53,Default,,0,0,0,,Бассейн суреті
Dialogue: 0,0:48:34.62,0:48:37.78,Default,,0,0,0,,Жоқ, мен қобалжыдым.
Dialogue: 0,0:48:37.87,0:48:39.54,Default,,0,0,0,,Менде үлкендер көп.
Dialogue: 0,0:48:40.75,0:48:42.04,Default,,0,0,0,,О, бірақ
Dialogue: 0,0:48:42.12,0:48:46.04,Default,,0,0,0,,Мені шақырғаныңызға қуаныштымын.
Dialogue: 0,0:48:49.38,0:48:51.92,Default,,0,0,0,,Жазғы естеліктер
Dialogue: 0,0:48:52.01,0:48:53.01,Default,,0,0,0,,Иә
Dialogue: 0,0:48:53.63,0:48:56.14,Default,,0,0,0,,Аа, мен сізге фото жібере аламын ба?
Dialogue: 0,0:48:56.22,0:48:57.22,Default,,0,0,0,,Иә
Dialogue: 0,0:48:59.31,0:49:01.31,Default,,0,0,0,,Келесі жылы бар күшімді саламын
Dialogue: 0,0:49:01.39,0:49:02.89,Default,,0,0,0,,Жарыс
Dialogue: 0,0:49:08.86,0:49:09.94,Default,,0,0,0,,Иә
Dialogue: 0,0:49:10.86,0:49:13.45,Default,,0,0,0,,Аа, сіз жетекшіге қарап жібере аласыз ба?
Dialogue: 0,0:49:15.07,0:49:20.04,Default,,0,0,0,,(Гобой ансамблі)
Dialogue: 0,0:49:55.15,0:50:00.16,Default,,0,0,0,,♪ «Лиз және көк құс, 3-ші бөлім»
Dialogue: 0,0:50:27.31,0:50:30.73,Default,,0,0,0,,Қасағи мырза, сіз гобойды тыңдап тұрсыз ба?
Dialogue: 0,0:50:31.36,0:50:32.98,Default,,0,0,0,,Жаман емес
Dialogue: 0,0:50:33.07,0:50:36.57,Default,,0,0,0,,Сіз аздап эмоционалды болуыңыз мүмкін.
Dialogue: 0,0:50:37.07,0:50:41.49,Default,,0,0,0,,Бұл бөлімде бір-бірінің дыбыстарын тыңдау өте маңызды.
Dialogue: 0,0:50:41.58,0:50:46.25,Default,,0,0,0,,Йороизука мырзаға ақырын сөйлегендей.
Dialogue: 0,0:50:47.04,0:50:48.33,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:50:48.42,0:50:49.25,Default,,0,0,0,,Иә
Dialogue: 0,0:50:50.04,0:50:51.25,Default,,0,0,0,,Йороизука мырза
Dialogue: 0,0:50:51.33,0:50:55.26,Default,,0,0,0,,Бұл жерде гобой мен флейтаның өзара әрекеті ең маңызды.
Dialogue: 0,0:50:55.84,0:50:58.30,Default,,0,0,0,,Сен де сыбызғыдан сұрақтарға жауап бересің
Dialogue: 0,0:50:58.38,0:51:00.05,Default,,0,0,0,,Жауап беру керек
Dialogue: 0,0:51:00.84,0:51:04.77,Default,,0,0,0,,Музыкада нотаға жазылмайтын үзілістер болады.
Dialogue: 0,0:51:05.43,0:51:08.60,Default,,0,0,0,,Музыкалық партитуралар арасындағы бос орындар арқылы ағып жатқан жүректі қабылдаңыз.
Dialogue: 0,0:51:09.10,0:51:11.27,Default,,0,0,0,,Көбірек ән айт
Dialogue: 0,0:51:11.86,0:51:13.02,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:51:14.32,0:51:15.53,Default,,0,0,0,,Иә
Dialogue: 0,0:51:17.24,0:51:18.40,Default,,0,0,0,,Сіз оны кесіп жатырсыз ба?
Dialogue: 0,0:51:19.32,0:51:21.66,Default,,0,0,0,,Иә, Ририка-чан үшін.
Dialogue: 0,0:51:22.45,0:51:23.45,Default,,0,0,0,,Иә
Dialogue: 0,0:51:26.33,0:51:28.87,Default,,0,0,0,,Мизоре, сен музыкалық колледжге түсесің.
Dialogue: 0,0:51:28.96,0:51:29.87,Default,,0,0,0,,Иә
Dialogue: 0,0:51:29.96,0:51:32.58,Default,,0,0,0,,Юко, сен бақытты боласың ба?
Dialogue: 0,0:51:32.67,0:51:35.71,Default,,0,0,0,,Әрине, мен өте қуаныштымын.
Dialogue: 0,0:51:35.80,0:51:37.80,Default,,0,0,0,,Мизоре міндетті түрде өтеді деп ойлаймын.
Dialogue: 0,0:51:40.05,0:51:41.22,Default,,0,0,0,,Жақсы
Dialogue: 0,0:51:42.89,0:51:44.47,Default,,0,0,0,,Сәлем Мизор
Dialogue: 0,0:51:45.72,0:51:49.73,Default,,0,0,0,,Нозоми музыкалық колледжге баратын болғандықтан, Мизоре де барады ма?
Dialogue: 0,0:51:52.19,0:51:53.48,Default,,0,0,0,,Біртүрлі?
Dialogue: 0,0:51:54.06,0:51:55.32,Default,,0,0,0,,Жоқ
Dialogue: 0,0:51:59.49,0:52:02.11,Default,,0,0,0,,Қар жақсы ма?
Dialogue: 0,0:52:07.12,0:52:11.46,Default,,0,0,0,,Нозоми не шешті, мен де солай шештім
Dialogue: 0,0:52:12.33,0:52:13.75,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:52:13.83,0:52:15.13,Default,,0,0,0,,Юко Сенпай
Dialogue: 0,0:52:15.21,0:52:17.50,Default,,0,0,0,,Барлық кернейлер қолжетімді
Dialogue: 0,0:52:17.59,0:52:20.47,Default,,0,0,0,,А, жарайды, мен бірден барамын.
Dialogue: 0,0:52:25.51,0:52:26.81,Default,,0,0,0,,Не болды?
Dialogue: 0,0:52:27.56,0:52:30.10,Default,,0,0,0,,Аздап алғың келе ме?
Dialogue: 0,0:52:30.89,0:52:32.48,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:52:32.56,0:52:36.15,Default,,0,0,0,,Негізі мен еркін әндегі гобой солосына қызық болдым...
Dialogue: 0,0:52:37.40,0:52:38.78,Default,,0,0,0,,Ол ешқашан да болмайды!
Dialogue: 0,0:52:38.86,0:52:41.15,Default,,0,0,0,,Нозоми-сенпаймен жақсы араласпайсың ба?
Dialogue: 0,0:52:42.53,0:52:43.36,Default,,0,0,0,,Такасака…
Dialogue: 0,0:52:45.37,0:52:46.62,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:52:47.53,0:52:50.50,Default,,0,0,0,,Менің ағам қазір қалай естіледі⸺
Dialogue: 0,0:52:50.58,0:52:53.50,Default,,0,0,0,,Бұл өте тар естіледі.
Dialogue: 0,0:52:54.33,0:52:57.50,Default,,0,0,0,,Бұл тежегішті әдейі басқан сияқты.
Dialogue: 0,0:52:58.34,0:53:02.51,Default,,0,0,0,,Нозоми-сенпай маған бейімделмейді деп ойлағандықтан болар.
Dialogue: 0,0:53:02.59,0:53:03.80,Default,,0,0,0,,Такасака!
Dialogue: 0,0:53:05.76,0:53:07.14,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:53:13.14,0:53:14.48,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:53:14.56,0:53:16.61,Default,,0,0,0,,Мен сені олай етіп көрсеткім келмеді.
Dialogue: 0,0:53:18.40,0:53:19.36,Default,,0,0,0,,Бірақ
Dialogue: 0,0:53:20.23,0:53:23.49,Default,,0,0,0,,Мен ағамның байсалды дауысын естігім келеді.
Dialogue: 0,0:53:27.99,0:53:29.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:53:31.87,0:53:33.21,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:53:33.96,0:53:35.12,Default,,0,0,0,,Мизор, жақсысың ба?
Dialogue: 0,0:53:35.21,0:53:36.33,Default,,0,0,0,,Жоқ
Dialogue: 0,0:53:36.42,0:53:38.21,Default,,0,0,0,,Нозоми жаман емес
Dialogue: 0,0:53:41.05,0:53:42.55,Default,,0,0,0,,Ол тар
Dialogue: 0,0:53:42.63,0:53:46.18,Default,,0,0,0,,Өйткені мен көк құсты қашып жібермеймін.
Dialogue: 0,0:53:47.55,0:53:48.80,Default,,0,0,0,,Себебі Нозоми⸺
Dialogue: 0,0:53:49.60,0:53:52.27,Default,,0,0,0,,Мен оның келесі жолы қашан жоғалатынын білмеймін.
Dialogue: 0,0:53:52.35,0:53:54.02,Default,,0,0,0,,Менен...
Dialogue: 0,0:53:55.14,0:53:56.94,Default,,0,0,0,,Менің қолыммен...
Dialogue: 0,0:53:57.02,0:54:00.19,Default,,0,0,0,,Нозомиді босатып алудың жолы жоқ.
Dialogue: 0,0:54:01.57,0:54:02.94,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:54:04.44,0:54:05.70,Default,,0,0,0,,Егер мен Лиз болсам⸺
Dialogue: 0,0:54:06.82,0:54:09.66,Default,,0,0,0,,Көк құсты мәңгілік қамауда ұста
Dialogue: 0,0:54:11.28,0:54:13.95,Default,,0,0,0,,Нацуки, сен сынақ емтиханын тапсырасың ба?
Dialogue: 0,0:54:14.04,0:54:17.17,Default,,0,0,0,,Мен оны аламын. Мен кем дегенде 3 аламын.
Dialogue: 0,0:54:17.25,0:54:18.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:54:19.96,0:54:21.13,Default,,0,0,0,,Қар туралы не деуге болады?
Dialogue: 0,0:54:21.21,0:54:22.63,Default,,0,0,0,,1 дана\NСіз
Dialogue: 0,0:54:22.71,0:54:24.55,Default,,0,0,0,,туралы естіген жоқсыз ба?
Dialogue: 0,0:54:25.13,0:54:26.63,Default,,0,0,0,,Хмм…
Dialogue: 0,0:54:26.72,0:54:29.14,Default,,0,0,0,,Бір университетте оқитын болсақ та?
Dialogue: 0,0:54:29.22,0:54:31.10,Default,,0,0,0,,Міне...
Dialogue: 0,0:54:33.93,0:54:36.14,Default,,0,0,0,,Мизор, бірдеңе айтып тұрсың ба?
Dialogue: 0,0:54:36.23,0:54:37.19,Default,,0,0,0,,Қый!
Dialogue: 0,0:54:37.27,0:54:39.19,Default,,0,0,0,,Не... бірдеңе?
Dialogue: 0,0:54:41.19,0:54:42.15,Default,,0,0,0,,Атап айтқанда
Dialogue: 0,0:54:42.23,0:54:45.69,Default,,0,0,0,,А, бірақ мен мансап жолымды шештім және бар күшімді салып жатырмын.
Dialogue: 0,0:54:45.78,0:54:47.95,Default,,0,0,0,,Бұл Нозомимен бірдей университет.
Dialogue: 0,0:54:48.45,0:54:51.91,Default,,0,0,0,,Мизоре, сен менімен алыс емессің бе?
Dialogue: 0,0:54:51.99,0:54:54.79,Default,,0,0,0,,Қай жерде олай емес?
Dialogue: 0,0:54:54.87,0:54:59.25,Default,,0,0,0,,Мен бірінші жылымда бір рет үйірме жұмыстарын тастадым.
Dialogue: 0,0:54:59.33,0:55:02.71,Default,,0,0,0,,Бұл көп уақыт бұрын.
Dialogue: 0,0:55:02.79,0:55:06.67,Default,,0,0,0,,Сол кездегі естеліктеріңіз әлі бар ма?
Dialogue: 0,0:55:07.26,0:55:11.72,Default,,0,0,0,,Мизор маған не ойлайтынын айтпайды.
Dialogue: 0,0:55:11.80,0:55:13.81,Default,,0,0,0,,Мен әлі түсінбеймін
Dialogue: 0,0:55:15.06,0:55:17.73,Default,,0,0,0,,Жеке бөлім де онша сәйкес келмейді.
Dialogue: 0,0:55:18.89,0:55:20.48,Default,,0,0,0,,Менің көзқарасым бойынша
Dialogue: 0,0:55:20.56,0:55:24.98,Default,,0,0,0,,Олар флейта мен гобой ойнайды, бұл керемет.
Dialogue: 0,0:55:25.07,0:55:26.53,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:55:29.57,0:55:32.37,Default,,0,0,0,,Мен Лиз жіберген көк құспын.
Dialogue: 0,0:55:32.45,0:55:34.20,Default,,0,0,0,,Лизді кездестіргіңіз келсе
Dialogue: 0,0:55:34.28,0:55:36.49,Default,,0,0,0,,Менің ойымша, сіз мені қайтадан көруге келсеңіз жақсы болар еді.
Dialogue: 0,0:55:36.58,0:55:40.21,Default,,0,0,0,,Ху... Бұл Лиздің шешімін бұзады.
Dialogue: 0,0:55:40.71,0:55:42.04,Default,,0,0,0,,Хмм…
Dialogue: 0,0:55:43.34,0:55:45.63,Default,,0,0,0,,Бірақ бұл бақытты аяқталды, солай ма?
Dialogue: 0,0:55:46.96,0:55:48.88,Default,,0,0,0,,Бүгіннен бастап тағы да жарыс.
Dialogue: 0,0:55:49.59,0:55:51.89,Default,,0,0,0,,Сондай-ақ Хашимото мырза мен Ниияма мырзаға
Dialogue: 0,0:55:51.97,0:55:54.80,Default,,0,0,0,,Сізге біраз уақыт тәжірибеге қатысу сұралады.
Dialogue: 0,0:55:54.89,0:55:57.89,Default,,0,0,0,,Ал, барлық 3 және 2 курс студенттері.
Dialogue: 0,0:55:57.97,0:55:59.64,Default,,0,0,0,,Көптен бері көрмедім~
Dialogue: 0,0:55:59.73,0:56:02.65,Default,,0,0,0,,Танысқаныма қуаныштымын, бірінші курс студенттері, мен Хашимотомын.
Dialogue: 0,0:56:02.73,0:56:07.78,Default,,0,0,0,,Мен барлығының жаттығуын біраз уақыт бақылайтын боламын, сондықтан оны асыға күтіңіздер.
Dialogue: 0,0:56:07.86,0:56:10.70,Default,,0,0,0,,♪ «Лиз және көк құс, 3-ші бөлім»
Dialogue: 0,0:56:10.78,0:56:12.82,Default,,0,0,0,,А... Иә...
Dialogue: 0,0:56:16.28,0:56:17.12,Default,,0,0,0,,Хмм…
Dialogue: 0,0:56:21.12,0:56:22.29,Default,,0,0,0,,Иә...
Dialogue: 0,0:56:28.38,0:56:29.88,Default,,0,0,0,,Қар
Dialogue: 0,0:56:29.96,0:56:31.97,Default,,0,0,0,,Жеке бөлім
Dialogue: 0,0:56:32.05,0:56:34.68,Default,,0,0,0,,Кейінірек тағы да байқап көрейін бе?
Dialogue: 0,0:56:34.76,0:56:35.85,Default,,0,0,0,,Иә
Dialogue: 0,0:56:41.06,0:56:42.85,Default,,0,0,0,,Доктор Ниияма
Dialogue: 0,0:56:42.94,0:56:44.23,Default,,0,0,0,,О.
Dialogue: 0,0:56:46.27,0:56:47.61,Default,,0,0,0,,Бұл не өзі…?>
Dialogue: 0,0:56:47.69,0:56:49.15,Default,,0,0,0,,Қасаги...
Dialogue: 0,0:56:49.23,0:56:53.03,Default,,0,0,0,,Мен сенің ағаштан үрмелі аспаптар бойынша нұсқауыңды осы жылы тағы да күтемін.
Dialogue: 0,0:56:53.11,0:56:56.45,Default,,0,0,0,,Биыл сіз байқауға қатысушы ретінде қатысасыз.
Dialogue: 0,0:56:56.53,0:56:57.62,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:56:57.70,0:56:58.74,Default,,0,0,0,,Иә
Dialogue: 0,0:57:02.41,0:57:06.13,Default,,0,0,0,,Мен... Мен музыкалық колледжге тапсыруды ойладым.
Dialogue: 0,0:57:06.21,0:57:08.34,Default,,0,0,0,,Иә
Dialogue: 0,0:57:10.05,0:57:11.59,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:57:11.67,0:57:14.63,Default,,0,0,0,,Маған қарсы болмасаңыз, бірдеңе сұраңыз.
Dialogue: 0,0:57:16.18,0:57:17.18,Default,,0,0,0,,Иә
Dialogue: 0,0:57:19.31,0:57:20.31,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:57:21.47,0:57:22.64,Default,,0,0,0,,Иә
Dialogue: 0,0:57:26.98,0:57:28.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:28.98,0:57:31.40,Default,,0,0,0,,Хмм, бұл
Dialogue: 0,0:57:31.48,0:57:34.40,Default,,0,0,0,,Күні кеше тыңдап, ойланып қалдым⸺
Dialogue: 0,0:57:34.49,0:57:35.53,Default,,0,0,0,,Бұл…
Dialogue: 0,0:57:35.61,0:57:39.03,Default,,0,0,0,,Гобой мен флейтаның өзара әрекеті
Dialogue: 0,0:57:39.12,0:57:40.29,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:57:40.37,0:57:44.54,Default,,0,0,0,,Сондықтан мен балыққа бардым да:
Dialogue: 0,0:57:44.62,0:57:45.67,Default,,0,0,0,,Иә
Dialogue: 0,0:57:45.75,0:57:47.75,Default,,0,0,0,,«Мен саған бұл балықты көрсеткім келді».
Dialogue: 0,0:57:47.83,0:57:49.04,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:57:49.13,0:57:52.30,Default,,0,0,0,,«Сен маған ұқсайсың»~
Dialogue: 0,0:57:52.38,0:57:54.55,Default,,0,0,0,,Сүйкімді емес пе? сол балық
Dialogue: 0,0:57:54.63,0:57:57.05,Default,,0,0,0,,Бірақ бұл пафель~
Dialogue: 0,0:57:57.14,0:57:59.30,Default,,0,0,0,,Сүйкімді болса, жақсы
Dialogue: 0,0:57:59.39,0:58:00.68,Default,,0,0,0,,Сәлем Нозоми
Dialogue: 0,0:58:01.47,0:58:02.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:02.68,0:58:03.81,Default,,0,0,0,,А... иә
Dialogue: 0,0:58:03.89,0:58:07.31,Default,,0,0,0,,Мүмкін мен семіз шығармын...
Dialogue: 0,0:58:07.40,0:58:11.27,Default,,0,0,0,,Цубо-сенпайдың киімі жараспады~
Dialogue: 0,0:58:11.36,0:58:15.11,Default,,0,0,0,,Жарайды, ол сондай сүйкімді.
Dialogue: 0,0:58:17.20,0:58:18.45,Default,,0,0,0,,Нозоми
Dialogue: 0,0:58:19.66,0:58:21.24,Default,,0,0,0,,Ах Мизоре
Dialogue: 0,0:58:22.16,0:58:23.29,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:58:26.08,0:58:27.25,Default,,0,0,0,,Джейн
Dialogue: 0,0:58:28.37,0:58:29.79,Default,,0,0,0,,Нозоми
Dialogue: 0,0:58:29.88,0:58:31.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:31.25,0:58:33.80,Default,,0,0,0,,Сіз бір нәрсеге ашуланасыз ба?
Dialogue: 0,0:58:34.38,0:58:35.76,Default,,0,0,0,,№.
Dialogue: 0,0:58:37.18,0:58:39.14,Default,,0,0,0,,Олай болса, мен үшін жасайсың ба?
Dialogue: 0,0:58:39.22,0:58:40.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:54.23,0:58:55.40,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:59:12.21,0:59:15.71,Default,,0,0,0,,Не істеу керек? 3-ші қозғалыс
Dialogue: 0,0:59:17.34,0:59:18.26,Default,,0,0,0,,Хмм?
Dialogue: 0,0:59:19.55,0:59:20.55,Default,,0,0,0,,Иә
Dialogue: 0,0:59:21.30,0:59:24.26,Default,,0,0,0,,Маған Мизорды дұрыс түсінуім керек.
Dialogue: 0,0:59:24.35,0:59:26.14,Default,,0,0,0,,Yes, that's right.
Dialogue: 0,0:59:28.85,0:59:30.73,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:59:30.81,0:59:32.02,Default,,0,0,0,,Не?
Dialogue: 0,0:59:32.11,0:59:33.31,Default,,0,0,0,,Қарлы қармен
Dialogue: 0,0:59:34.77,0:59:36.48,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:59:36.57,0:59:39.74,Default,,0,0,0,,Ал... нақты орындауға әлі уақыт бар⸺
Dialogue: 0,0:59:40.36,0:59:42.49,Default,,0,0,0,,Мен оған дейін бірдеңе істеймін.
Dialogue: 0,0:59:43.57,0:59:47.58,Default,,0,0,0,,♪ «Лиз және көк құс, 3-ші бөлім»
Dialogue: 0,0:59:50.50,0:59:52.13,Default,,0,0,0,,Ах, Киомаэ-чан және басқалар.
Dialogue: 0,0:59:53.00,0:59:54.92,Default,,0,0,0,,Нозоми және оның достарының бөлігі.
Dialogue: 0,0:59:55.00,0:59:56.71,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,1:00:41.67,1:00:43.38,Default,,0,0,0,,(терезе жабылған дыбыс)
Dialogue: 0,1:00:52.98,1:00:56.40,Default,,0,0,0,,Ол күшті Лиз сияқты көрінді.
Dialogue: 0,1:00:56.48,1:00:59.44,Default,,0,0,0,,«Жарайды, сау бол!»
Dialogue: 0,1:01:00.49,1:01:02.03,Default,,0,0,0,,Такасака сияқты
Dialogue: 0,1:01:02.99,1:01:04.28,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,1:01:05.16,1:01:06.16,Default,,0,0,0,,Кел, мен⸺
Dialogue: 0,1:01:06.91,1:01:09.99,Default,,0,0,0,,Сіз шынымен музыкалық колледжге барғыңыз келе ме?
Dialogue: 0,1:01:18.75,1:01:20.71,Default,,0,0,0,,Мм... соло
Dialogue: 0,1:01:21.38,1:01:23.63,Default,,0,0,0,,Мен әлі түсінбеймін
Dialogue: 0,1:01:24.38,1:01:29.18,Default,,0,0,0,,Йороизука мырза сол солода нені білдіреді?
Dialogue: 0,1:01:33.35,1:01:35.69,Default,,0,0,0,,Лиздің сезімі
Dialogue: 0,1:01:36.94,1:01:37.94,Default,,0,0,0,,Не?
Dialogue: 0,1:01:41.15,1:01:45.57,Default,,0,0,0,,Құс торынан дос болдық көк құс⸺
Dialogue: 0,1:01:46.78,1:01:48.07,Default,,0,0,0,,еркін
Dialogue: 0,1:01:48.95,1:01:51.08,Default,,0,0,0,,Бұл Лиздің әрекеті еді⸺
Dialogue: 0,1:01:51.16,1:01:53.62,Default,,0,0,0,,Бұл сезім емес.
Dialogue: 0,1:01:56.42,1:01:57.88,Default,,0,0,0,,Мен өзімді қалай сезінемін...
Dialogue: 0,1:02:01.46,1:02:04.30,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,1:02:04.80,1:02:06.63,Default,,0,0,0,,Сізге ұнайтын адам
Dialogue: 0,1:02:06.72,1:02:10.72,Default,,0,0,0,,Себебі мен сені жанымнан итере алмаймын⸺
Dialogue: 0,1:02:12.47,1:02:16.48,Default,,0,0,0,,Мен түсінбеймін және түсінбеймін
Dialogue: 0,1:02:16.56,1:02:19.06,Default,,0,0,0,,Маған флейта ұнайды
Dialogue: 0,1:02:19.15,1:02:22.36,Default,,0,0,0,,Қызық, мен бірінші кезекте кәсіпқой болғым келеді ме?
Dialogue: 0,1:02:23.07,1:02:26.99,Default,,0,0,0,,Жұмыстың болуы мен аспапта ойнауды жалғастыруды қалау бір нәрсе емес.
Dialogue: 0,1:02:27.57,1:02:30.66,Default,,0,0,0,,Сондай-ақ, бұл ақша талап етеді, солай ма?
Dialogue: 0,1:02:30.74,1:02:33.24,Default,,0,0,0,,Мен жеке сабақтарға баруым керек.
Dialogue: 0,1:02:33.91,1:02:35.04,Default,,0,0,0,,Екі адам сияқты
Dialogue: 0,1:02:35.12,1:02:38.17,Default,,0,0,0,,Менің ойымша, қарапайым университетке түскен дұрыс.
Dialogue: 0,1:02:38.67,1:02:40.04,Default,,0,0,0,,Бұл…
Dialogue: 0,1:02:40.13,1:02:42.30,Default,,0,0,0,,Сіз Мизорды білесіз бе?
Dialogue: 0,1:02:42.38,1:02:43.88,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:02:44.67,1:02:45.51,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,1:02:45.59,1:02:47.38,Default,,0,0,0,,(Кугисаки мен Итадори) Токио! Токио! Токио!
Dialogue: 0,1:02:47.93,1:02:50.72,Default,,0,0,0,,Оған музыкалық колледжге бірге бару керектігін айт⸺
Dialogue: 0,1:02:50.80,1:02:54.77,Default,,0,0,0,,Бірақ кәсіпқой болу басқа болғандықтан, жұмыстан шығып жатырмын дегеніңіз не?
Dialogue: 0,1:02:54.85,1:02:55.68,Default,,0,0,0,,Юко
Dialogue: 0,1:03:01.56,1:03:03.40,Default,,0,0,0,,Тіпті бір жылдан кейін⸺
Dialogue: 0,1:03:03.98,1:03:06.61,Default,,0,0,0,,Мизоре клубының жұмысын тоқтатыңыз және тоқтатыңыз.
Dialogue: 0,1:03:06.69,1:03:10.03,Default,,0,0,0,,Мен қайтып келдім, өйткені мен мұны істегім келді.
Dialogue: 0,1:03:11.32,1:03:13.37,Default,,0,0,0,,Айналадағы қарды қанша шайқауым керек...
Dialogue: 0,1:03:13.45,1:03:14.49,Default,,0,0,0,,Юко
Dialogue: 0,1:03:17.16,1:03:18.83,Default,,0,0,0,,Жақын жерде болғандықтан
Dialogue: 0,1:03:18.92,1:03:22.00,Default,,0,0,0,,Әркім әр нәрсені айта бермейді.
Dialogue: 0,1:03:25.63,1:03:26.76,Default,,0,0,0,,Иә...
Dialogue: 0,1:03:28.38,1:03:29.47,Default,,0,0,0,,Йороизука мырза⸺
Dialogue: 0,1:03:30.13,1:03:33.68,Default,,0,0,0,,Сіз жақсы көретін адамдарыңызды тым жоғары бағалайтыныңызға сенімдімін.
Dialogue: 0,1:03:37.89,1:03:39.23,Default,,0,0,0,,Ал...
Dialogue: 0,1:03:40.73,1:03:44.36,Default,,0,0,0,,Сонымен, Йороизука мырза көк құс болса ше?
Dialogue: 0,1:03:44.36,1:03:45.53,Default,,0,0,0,,Ха ха ха ха... Сонда Йороизука мырза көк құс болса ше?
Dialogue: 0,1:03:45.53,1:03:46.78,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:03:47.44,1:03:51.74,Default,,0,0,0,,Сол күні Лиз кенет көк құспен қоштасты.
Dialogue: 0,1:03:52.82,1:03:56.04,Default,,0,0,0,,Күні кешеге дейін бірге бақытты өмір сүрдік...
Dialogue: 0,1:03:57.50,1:03:59.62,Default,,0,0,0,,Сіз бос болуыңыз керек
Dialogue: 0,1:04:01.37,1:04:05.92,Default,,0,0,0,,Сол серпімді қанаттармен сіз қалағаныңызша биікке ұша алуыңыз керек.
Dialogue: 0,1:04:08.26,1:04:11.05,Default,,0,0,0,,Неліктен? Мен Лизбен мәңгі бірге болғым келеді!
Dialogue: 0,1:04:11.13,1:04:14.35,Default,,0,0,0,,Лизбен бірге болу – менің жалғыз қуанышым.
Dialogue: 0,1:04:20.35,1:04:23.10,Default,,0,0,0,,Мен сені құс торына қамап аламын
Dialogue: 0,1:04:24.40,1:04:26.07,Default,,0,0,0,,Қанаттарың бар
Dialogue: 0,1:04:26.90,1:04:30.57,Default,,0,0,0,,Мәңгілікке созылған үлкен аспан бар
Dialogue: 0,1:04:34.41,1:04:37.58,Default,,0,0,0,,Мен сенен ол қанаттарды ала алмаймын.
Dialogue: 0,1:04:40.75,1:04:44.54,Default,,0,0,0,,Жүр, бұл жерден кет, биікке, алысқа ұш
Dialogue: 0,1:04:46.75,1:04:51.17,Default,,0,0,0,,Маған әдемі мүсініңізді шығарып салуға рұқсат етіңізші.
Dialogue: 0,1:04:52.68,1:04:55.64,Default,,0,0,0,,Менің махаббатым осылай болуы керек
Dialogue: 0,1:05:03.14,1:05:04.35,Default,,0,0,0,,Осы жолы…
Dialogue: 0,1:05:08.36,1:05:13.36,Default,,0,0,0,,(Қыздың жылағаны)
Dialogue: 0,1:05:21.75,1:05:25.29,Default,,0,0,0,,Сіз қалай ойлайсыз? Көк құс ұшты ма?
Dialogue: 0,1:05:27.25,1:05:28.75,Default,,0,0,0,,Лиз...
Dialogue: 0,1:05:28.84,1:05:31.63,Default,,0,0,0,,Лиз осылай деді, сондықтан мен оны қабылдадым.
Dialogue: 0,1:05:32.34,1:05:36.14,Default,,0,0,0,,Көк құс Лиздің таңдауын тоқтата алмайды.
Dialogue: 0,1:05:36.97,1:05:38.39,Default,,0,0,0,,Өйткені көк құс⸺
Dialogue: 0,1:05:39.01,1:05:41.52,Default,,0,0,0,,Себебі мен Лизді жақсы көремін
Dialogue: 0,1:05:42.14,1:05:43.56,Default,,0,0,0,,Қайғылы болсам да
Dialogue: 0,1:05:44.06,1:05:46.90,Default,,0,0,0,,Менің ұшып кетуден басқа амалым жоқ
Dialogue: 0,1:05:50.69,1:05:52.90,Default,,0,0,0,,Көк құс бақытсыз болды ма?
Dialogue: 0,1:05:55.66,1:05:57.91,Default,,0,0,0,,Мен білмеймін, бірақ Лизге⸺
Dialogue: 0,1:05:57.99,1:06:01.66,Default,,0,0,0,,Мен сенің бақытты болғаныңды қалаймын.
Dialogue: 0,1:06:03.08,1:06:05.75,Default,,0,0,0,,Бұл сөзсіз шындық
Dialogue: 0,1:06:08.83,1:06:12.59,Default,,0,0,0,,Көк құстың махаббаты осылай болуы керек
Dialogue: 0,1:06:13.59,1:06:16.01,Default,,0,0,0,,Менің ұшып кетуден басқа амалым жоқ
Dialogue: 0,1:06:20.76,1:06:22.81,Default,,0,0,0,,Мансап бойынша зерттеу жұмысы
Dialogue: 0,1:06:22.89,1:06:25.43,Default,,0,0,0,,Бос жіберілген тек Мизор емес еді.
Dialogue: 0,1:06:26.02,1:06:27.56,Default,,0,0,0,,Мен де
Dialogue: 0,1:06:30.27,1:06:31.90,Default,,0,0,0,,Бірақ
Dialogue: 0,1:06:31.98,1:06:36.28,Default,,0,0,0,,Ниияма-сенсэйдің айтқан жалғыз адамы Мизоре болды, солай ма?
Dialogue: 0,1:06:37.24,1:06:38.07,Default,,0,0,0,,I⸺
Dialogue: 0,1:06:38.82,1:06:41.83,Default,,0,0,0,,Мен әрқашан Лизді анықтауға тырыстым.
Dialogue: 0,1:06:44.66,1:06:47.29,Default,,0,0,0,,«Лиз және көк құс»
Dialogue: 0,1:06:47.83,1:06:51.46,Default,,0,0,0,,Мен Мизор екеумізді қандай да бір жағынан ұқсас деп ойладым.
Dialogue: 0,1:06:52.96,1:06:53.84,Default,,0,0,0,,Қар...
Dialogue: 0,1:06:53.92,1:06:55.17,Default,,0,0,0,,Лизде
Dialogue: 0,1:06:56.97,1:06:57.84,Default,,0,0,0,,Нозоми...
Dialogue: 0,1:06:58.80,1:06:59.89,Default,,0,0,0,,Көк құс
Dialogue: 0,1:07:00.97,1:07:02.26,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,1:07:16.19,1:07:17.49,Default,,0,0,0,,I⸺
Dialogue: 0,1:07:18.40,1:07:23.33,Default,,0,0,0,,Сол баланы қатты жақсы көрдім, Әдемі қанаттарын тартып алдым.
Dialogue: 0,1:07:25.87,1:07:27.41,Default,,0,0,0,,Сол бала⸺
Dialogue: 0,1:07:28.12,1:07:30.33,Default,,0,0,0,,Мен кез келген жерге ұша алатын болсам да...
Dialogue: 0,1:07:32.79,1:07:34.71,Default,,0,0,0,,О, Құдай...
Dialogue: 0,1:07:35.21,1:07:36.46,Default,,0,0,0,,Неге мен?
Dialogue: 0,1:07:37.26,1:07:40.18,Default,,0,0,0,,Сіз оған себетті ашуды үйреттіңіз бе?
Dialogue: 0,1:07:48.18,1:07:51.27,Default,,0,0,0,,Енді жалпы жаттығуды бастайық.
Dialogue: 0,1:07:52.19,1:07:53.31,Default,,0,0,0,,Ең алдымен...
Dialogue: 0,1:07:53.40,1:07:54.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:07:56.03,1:07:59.57,Default,,0,0,0,,3-ші қозғалыс Мен оны толығымен ойнасам жақсы ма?
Dialogue: 0,1:08:04.12,1:08:05.24,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,1:08:27.43,1:08:31.44,Default,,0,0,0,,♪ «Лиз және көк құс, 3-ші бөлім»
Dialogue: 0,1:11:47.92,1:11:52.93,Default,,0,0,0,,~♪
Dialogue: 0,1:12:04.19,1:12:06.36,Default,,0,0,0,,Бұл керемет, Сенпай.
Dialogue: 0,1:12:06.98,1:12:08.49,Default,,0,0,0,,Қатты күйзелдім
Dialogue: 0,1:12:08.57,1:12:12.16,Default,,0,0,0,,Мен өз жұмысыма назар аудара алмадым.
Dialogue: 0,1:12:12.95,1:12:15.87,Default,,0,0,0,,Мизоре Бұл шынымен де керемет болды!
Dialogue: 0,1:12:22.42,1:12:23.54,Default,,0,0,0,,Нозоми...?
Dialogue: 0,1:13:06.67,1:13:07.84,Default,,0,0,0,,Нозоми
Dialogue: 0,1:13:12.30,1:13:13.51,Default,,0,0,0,,Қар…
Dialogue: 0,1:13:15.43,1:13:17.01,Default,,0,0,0,,Нозоми...?
Dialogue: 0,1:13:19.18,1:13:20.56,Default,,0,0,0,,Сіз жылап жатырсыз ба?
Dialogue: 0,1:13:23.85,1:13:25.02,Default,,0,0,0,,Жоқ
Dialogue: 0,1:13:25.85,1:13:27.15,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:13:28.40,1:13:29.65,Default,,0,0,0,,Қар
Dialogue: 0,1:13:31.36,1:13:33.61,Default,,0,0,0,,Сіз осы уақытқа дейін босаңсыдыңыз.
Dialogue: 0,1:13:33.70,1:13:34.82,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:37.12,1:13:42.08,Default,,0,0,0,,Менің деңгейіме сай жасалғандықтан, мен осы уақытқа дейін бар күшімді сала алмадым.
Dialogue: 0,1:13:42.96,1:13:44.16,Default,,0,0,0,,Айырмашылық…
Dialogue: 0,1:13:44.25,1:13:46.21,Default,,0,0,0,,Мен ақымақпын~
Dialogue: 0,1:13:47.79,1:13:50.71,Default,,0,0,0,,Мизорға айт, қолыңнан келгеннің бәрін істе...
Dialogue: 0,1:13:51.21,1:13:53.80,Default,,0,0,0,,Мизор байыпты бола алмайды...
Dialogue: 0,1:13:53.88,1:13:57.01,Default,,0,0,0,,Мен жеткіліксіз болдым.
Dialogue: 0,1:13:57.09,1:13:57.93,Default,,0,0,0,,Жоқ
Dialogue: 0,1:13:58.01,1:14:01.10,Default,,0,0,0,,Музыкалық университетті маған профессор Ниияма ұсынды.
Dialogue: 0,1:14:01.18,1:14:02.85,Default,,0,0,0,,Қар жауып тұр.
Dialogue: 0,1:14:04.52,1:14:06.15,Default,,0,0,0,,Жыл сайынғы бәсекелестік қатынасы әдетте 300:1-ден асады>
Dialogue: 0,1:14:07.10,1:14:09.19,Default,,0,0,0,,Мизор әрқашан дәмді болды
Dialogue: 0,1:14:11.15,1:14:13.65,Default,,0,0,0,,Қар жауады
Dialogue: 0,1:14:14.74,1:14:15.70,Default,,0,0,0,,Бұл шынымен алдау...
Dialogue: 0,1:14:18.28,1:14:19.12,Default,,0,0,0,,Нозоми...
Dialogue: 0,1:14:19.20,1:14:20.37,Default,,0,0,0,,Кел, мен
Dialogue: 0,1:14:20.87,1:14:22.95,Default,,0,0,0,,Қарға жеңілгім келмейді⸺
Dialogue: 0,1:14:24.91,1:14:27.67,Default,,0,0,0,,Біз тең бола аламыз ба деп ойладым.
Dialogue: 0,1:14:27.75,1:14:30.13,Default,,0,0,0,,Мен сол музыкалық колледжге баратынымды айттым.
Dialogue: 0,1:14:32.13,1:14:34.30,Default,,0,0,0,,Себебі менде талант жоқ.
Dialogue: 0,1:14:34.80,1:14:36.84,Default,,0,0,0,,Өйткені ол қарлы қар сияқты күшті емес.
Dialogue: 0,1:14:37.51,1:14:41.85,Default,,0,0,0,,Егер сіз музыкалық колледжге барамын десеңіз, бұл өте жақсы көрінеді деп ойладым.
Dialogue: 0,1:14:42.93,1:14:43.77,Default,,0,0,0,,Нозоми
Dialogue: 0,1:14:43.85,1:14:44.98,Default,,0,0,0,,Мен...
Dialogue: 0,1:14:45.56,1:14:47.85,Default,,0,0,0,,Қарлы қар сияқты жаман емес.
Dialogue: 0,1:14:55.57,1:14:58.61,Default,,0,0,0,,Өйткені мен қарапайым адаммын
Dialogue: 0,1:14:59.24,1:15:01.66,Default,,0,0,0,,Жоқ (Нозоми) Мизорехаса⸺
Dialogue: 0,1:15:01.74,1:15:05.45,Default,,0,0,0,,Енді сенің кең әлемге шығатыныңа сенімдімін.
Dialogue: 0,1:15:07.37,1:15:09.33,Default,,0,0,0,,«Лиз және көк құс»
Dialogue: 0,1:15:09.42,1:15:12.59,Default,,0,0,0,,Мен Мизордың өнімділігіне қандай да бір жолмен сәйкес келу үшін бар күшімді саламын.
Dialogue: 0,1:15:13.09,1:15:13.92,Default,,0,0,0,,Нозоми...
Dialogue: 0,1:15:14.00,1:15:16.22,Default,,0,0,0,,Мизордың солосын қолдай білу
Dialogue: 0,1:15:16.30,1:15:17.38,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,1:15:24.93,1:15:28.14,Default,,0,0,0,,Нозоми әрқашан өзімшіл
Dialogue: 0,1:15:28.23,1:15:32.44,Default,,0,0,0,,Бірінші курста оқып жүргенімде де рұқсатсыз тастадым.
Dialogue: 0,1:15:32.52,1:15:34.07,Default,,0,0,0,,Маған үндеме
Dialogue: 0,1:15:35.69,1:15:37.65,Default,,0,0,0,,Бұл баяғыда болды, солай ма?
Dialogue: 0,1:15:37.74,1:15:39.40,Default,,0,0,0,,Жақында емес
Dialogue: 0,1:15:39.99,1:15:42.41,Default,,0,0,0,,Мен үшін бұл әрқашан қазір
Dialogue: 0,1:15:43.24,1:15:47.04,Default,,0,0,0,,Мен Нозомиді көптен бері қудым
Dialogue: 0,1:15:47.12,1:15:51.54,Default,,0,0,0,,Мен музыкалық аспаптарда ойнауды жалғастырдым, өйткені мен Нозоми мені тастап кеткенін қаламадым.
Dialogue: 0,1:15:52.29,1:15:54.96,Default,,0,0,0,,Нозоми әрқашан менің бірінші нөмірім болды
Dialogue: 0,1:15:55.67,1:16:00.05,Default,,0,0,0,,Мен гобойда бар күшімді салдым, өйткені мен Нозомимен бірге болғым келді.
Dialogue: 0,1:16:02.64,1:16:05.06,Default,,0,0,0,,Нозомимен бірге болғанша бәрі жақсы
Dialogue: 0,1:16:07.18,1:16:09.14,Default,,0,0,0,,Ондай әсірелеу сөздерді айтпа...
Dialogue: 0,1:16:09.23,1:16:10.73,Default,,0,0,0,,Артық айтқандық емес
Dialogue: 0,1:16:11.94,1:16:14.11,Default,,0,0,0,,Барлығы дұрыс
Dialogue: 0,1:16:14.19,1:16:15.65,Default,,0,0,0,,Бұл алдау...
Dialogue: 0,1:16:15.73,1:16:18.74,Default,,0,0,0,,Нозоми - менің бәрім
Dialogue: 0,1:16:23.07,1:16:27.49,Default,,0,0,0,,Мен Мизор ойлағандай адам емеспін.
Dialogue: 0,1:16:27.58,1:16:30.75,Default,,0,0,0,,менсінбеу керек
Dialogue: 0,1:16:32.62,1:16:35.50,Default,,0,0,0,,Нозоми менің ерекше
Dialogue: 0,1:16:36.34,1:16:38.59,Default,,0,0,0,,Нозоми үшін ештеңе болмаса да
Dialogue: 0,1:16:38.67,1:16:40.38,Default,,0,0,0,,Маған бәрі...
Dialogue: 0,1:16:40.47,1:16:42.13,Default,,0,0,0,,Барлығы ерекше...!
Dialogue: 0,1:16:43.22,1:16:47.47,Default,,0,0,0,,Хмм, неге сонша көп айтқаныңды білмеймін...
Dialogue: 0,1:16:51.14,1:16:52.69,Default,,0,0,0,,Не болды?
Dialogue: 0,1:16:55.40,1:16:57.07,Default,,0,0,0,,Менің сүйікті құшақтауым
Dialogue: 0,1:17:20.30,1:17:23.38,Default,,0,0,0,,Егер менде Нозоми болмаса
Dialogue: 0,1:17:23.47,1:17:25.05,Default,,0,0,0,,Ештеңе болмады
Dialogue: 0,1:17:25.55,1:17:27.51,Default,,0,0,0,,Мен тіпті музыкалық аспаптарда ойнамаймын.
Dialogue: 0,1:17:27.60,1:17:30.52,Default,,0,0,0,,Нозоми мені шақырды.
Dialogue: 0,1:17:30.60,1:17:34.98,Default,,0,0,0,,Менің досым болғаныңыз үшін және маған мейірімді болғаныңыз үшін рахмет⸺
Dialogue: 0,1:17:35.06,1:17:36.81,Default,,0,0,0,,Мен бақытты болдым
Dialogue: 0,1:17:38.02,1:17:41.23,Default,,0,0,0,,Кешіріңіз, бұл жақсы есімде жоқ...
Dialogue: 0,1:17:41.90,1:17:45.20,Default,,0,0,0,,Барлығын өзіне тартып, әрқашан көңілді болып көріну
Dialogue: 0,1:17:45.28,1:17:47.24,Default,,0,0,0,,Менің ойымша, бұл керемет.
Dialogue: 0,1:17:48.87,1:17:51.12,Default,,0,0,0,,Мизоре еңбекқор.
Dialogue: 0,1:17:52.37,1:17:56.67,Default,,0,0,0,,Маған Нозомидің күлгені ұнайды Маған Нозомидің сөйлеу тәсілі ұнайды
Dialogue: 0,1:17:57.17,1:18:01.09,Default,,0,0,0,,Маған Нозомидің ізі ұнайды Маған Нозомидің шашы ұнайды
Dialogue: 0,1:18:01.17,1:18:02.34,Default,,0,0,0,,Нозоми...
Dialogue: 0,1:18:03.05,1:18:04.51,Default,,0,0,0,,Нозоми туралы барлығы
Dialogue: 0,1:18:04.59,1:18:06.68,Default,,0,0,0,,Маған Мизордың гобойы ұнайды
Dialogue: 0,1:18:32.41,1:18:34.66,Default,,0,0,0,,Аа... Ахахха
Dialogue: 0,1:18:34.75,1:18:38.96,Default,,0,0,0,,Хахахахаха...
Dialogue: 0,1:18:39.04,1:18:41.59,Default,,0,0,0,,(Нозоми күлкісін жалғастырады)
Dialogue: 0,1:18:41.67,1:18:42.71,Default,,0,0,0,,Нозоми...?
Dialogue: 0,1:18:45.92,1:18:47.01,Default,,0,0,0,,А...
Dialogue: 0,1:18:51.18,1:18:52.47,Default,,0,0,0,,Рахмет
Dialogue: 0,1:18:54.35,1:18:56.23,Default,,0,0,0,,Рахмет сізге Мизоре
Dialogue: 0,1:18:58.73,1:18:59.73,Default,,0,0,0,,Рахмет
Dialogue: 0,1:19:03.57,1:19:06.57,Default,,0,0,0,,Иә! Жарайды, мен үйге баруым керек.
Dialogue: 0,1:19:07.20,1:19:08.70,Default,,0,0,0,,Мен сенің жүгіңді алайын.
Dialogue: 0,1:19:24.80,1:19:27.42,Default,,0,0,0,,Сіздің атыңыз Йороизука-сан?
Dialogue: 0,1:19:29.80,1:19:31.34,Default,,0,0,0,,Сіз қандай да бір үйірме жұмыстарына қатысасыз ба?
Dialogue: 0,1:19:32.55,1:19:36.81,Default,,0,0,0,,А, онда үйге қайту бөлімі? Онда ештеңе жоқ па?
Dialogue: 0,1:19:38.52,1:19:41.02,Default,,0,0,0,,Онда неге үрмелі аспаптар оркестріне қосылмайсың?
Dialogue: 0,1:19:45.65,1:19:47.82,Default,,0,0,0,,Иә, бәрі дұрыс.
Dialogue: 0,1:19:47.90,1:19:49.49,Default,,0,0,0,,(Қатты тыныс алу дыбысы)
Dialogue: 0,1:20:23.52,1:20:24.36,Default,,0,0,0,,Бұл⸺
Dialogue: 0,1:20:24.94,1:20:28.61,Default,,0,0,0,,Келесі жолы қайту күнін қарсы алуыңызды қалаймын.
Dialogue: 0,1:20:32.57,1:20:34.12,Default,,0,0,0,,Иә (Кітапханашы) Кітапхана кітаптары⸺
Dialogue: 0,1:20:34.20,1:20:35.58,Default,,0,0,0,,Ол барлығына тиесілі.
Dialogue: 0,1:20:35.66,1:20:38.25,Default,,0,0,0,,Иә, иә, түсіндім.
Dialogue: 0,1:20:38.33,1:20:39.66,Default,,0,0,0,,Мен мұны қарызға аламын.
Dialogue: 0,1:20:47.21,1:20:50.92,Default,,0,0,0,,Қарыз мерзімі бүгіннен бастап бір апта.
Dialogue: 0,1:20:51.01,1:20:52.38,Default,,0,0,0,,Иә
Dialogue: 0,1:23:02.10,1:23:02.93,Default,,0,0,0,,Сәлем Мизоре
Dialogue: 0,1:23:05.48,1:23:07.19,Default,,0,0,0,,Үйге қайтар жолда бір жерге тоқтағың келе ме?
Dialogue: 0,1:23:07.27,1:23:08.69,Default,,0,0,0,,Иә
Dialogue: 0,1:23:09.85,1:23:10.69,Default,,0,0,0,,Не жегің келеді?
Dialogue: 0,1:23:12.02,1:23:13.19,Default,,0,0,0,,Қырылған мұз
Dialogue: 0,1:23:13.27,1:23:17.11,Default,,0,0,0,,Бұл жақсы~ Сондай-ақ, парфе де жақсы.
Dialogue: 0,1:23:17.70,1:23:21.20,Default,,0,0,0,,Құймақ (Нозоми) О, жақсы.
Dialogue: 0,1:23:21.28,1:23:24.95,Default,,0,0,0,,А, бірақ менің ойымша, бұл тоқаш шығар.
Dialogue: 0,1:23:31.38,1:23:32.21,Default,,0,0,0,,Нозоми
Dialogue: 0,1:23:32.29,1:23:33.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:34.80,1:23:36.34,Default,,0,0,0,,Рахмет?
Dialogue: 0,1:23:36.92,1:23:38.76,Default,,0,0,0,,Неліктен сұрақ түрінде берілген?
Dialogue: 0,1:23:49.94,1:23:51.73,Default,,0,0,0,,Мизоре I...
Dialogue: 0,1:23:52.73,1:23:56.48,Default,,0,0,0,,Мизордың солосы Мен сені тамаша қолдаймын
Dialogue: 0,1:24:01.45,1:24:03.99,Default,,0,0,0,,Енді сәл күте тұрыңыз.
Dialogue: 0,1:24:07.50,1:24:08.50,Default,,0,0,0,,Мен де
Dialogue: 0,1:24:08.58,1:24:11.67,Default,,0,0,0,,Мен де гобой ойнауды жалғастырамын.
Dialogue: 0,1:24:12.21,1:24:13.21,Default,,0,0,0,,Иә
Dialogue: 0,1:24:21.30,1:24:23.76,Default,,0,0,0,,Нақты орындауда бар күшімізді салайық
Dialogue: 0,1:24:26.14,1:24:28.06,Default,,0,0,0,,Балмұздақ құтты болсын!
Dialogue: 0,1:24:28.14,1:24:31.19,Default,,0,0,0,,Не? Мизоре, балмұздақ жегің келе ме?
Dialogue: 0,1:24:32.40,1:24:34.44,Default,,0,0,0,,Олай болса, балмұздақ жеу керек пе?
Dialogue: 0,1:24:34.52,1:24:35.52,Default,,0,0,0,,Шешілді!
Dialogue: 0,1:24:42.53,1:24:43.57,Default,,0,0,0,,Хехе
Dialogue: 0,1:24:58.21,1:25:02.22,Default,,0,0,0,,♪「қыздар, би, баспалдақ」
Dialogue: 0,1:25:11.98,1:25:13.77,Default,,0,0,0,,♪ Kotori
Dialogue: 0,1:25:13.85,1:25:15.77,Default,,0,0,0,,♪ жарылған
Dialogue: 0,1:25:15.86,1:25:19.07,Default,,0,0,0,,♪ Аяқ киім
Dialogue: 0,1:25:19.15,1:25:26.32,Default,,0,0,0,,♪ Ақырын жабыңыз
Dialogue: 0,1:25:26.41,1:25:31.75,Default,,0,0,0,,♪ Жұмсақ жарық
Dialogue: 0,1:25:31.83,1:25:33.50,Default,,0,0,0,,♪ Үлпілдек
Dialogue: 0,1:25:33.58,1:25:38.84,Default,,0,0,0,,♪ Ақыры олар билей бастайды
Dialogue: 0,1:25:38.92,1:25:41.38,Default,,0,0,0,,♪ Қыз
Dialogue: 0,1:25:55.23,1:25:58.69,Default,,0,0,0,,♪ Сіздің дауысыңыз
Dialogue: 0,1:25:58.77,1:26:02.36,Default,,0,0,0,,♪ Жарылсын
Dialogue: 0,1:26:02.44,1:26:09.53,Default,,0,0,0,,♪ Өтінемін, мен сізді қорытындылауға рұқсат етіңіз.
Dialogue: 0,1:26:09.62,1:26:13.16,Default,,0,0,0,,♪ Аяқ саусақтарымен
Dialogue: 0,1:26:13.25,1:26:16.75,Default,,0,0,0,,♪ Курури мау\NЖазу үшін
Dialogue: 0,1:26:16.83,1:26:23.97,Default,,0,0,0,,♪
Dialogue: 0,1:26:24.05,1:26:25.72,Default,,0,0,0,,♪ Қазір
Dialogue: 0,1:26:25.80,1:26:31.14,Default,,0,0,0,,♪ Менің денеме
Dialogue: 0,1:26:31.22,1:26:35.39,Default,,0,0,0,,♪ Сол жүрек соғысы
Dialogue: 0,1:26:35.48,1:26:38.98,Default,,0,0,0,,♪ Тасымалдау
Dialogue: 0,1:26:39.06,1:26:45.03,Default,,0,0,0,,♪ Тек осы жерде қалыңыз
Dialogue: 0,1:26:45.11,1:26:47.99,Default,,0,0,0,,♪ Махаббат үні
Dialogue: 0,1:26:48.07,1:26:53.45,Default,,0,0,0,,♪ Бөліп көрейік
Dialogue: 0,1:27:24.94,1:27:29.95,Default,,0,0,0,,~♪
Dialogue: 0,1:27:31.66,1:27:35.66,Default,,0,0,0,,♪ «Әнші құстар»
Dialogue: 0,1:28:09.74,1:28:13.24,Default,,0,0,0,,♪ Екі сызық жақындады
Dialogue: 0,1:28:13.32,1:28:17.58,Default,,0,0,0,,♪, сосын кет.
Dialogue: 0,1:28:17.66,1:28:19.75,Default,,0,0,0,,♪ Кейбір оңай трюктар қосулы
Dialogue: 0,1:28:19.83,1:28:21.87,Default,,0,0,0,,♪ Мысықтың бесігі,
Dialogue: 0,1:28:21.96,1:28:23.08,Default,,0,0,0,,♪ Менің қолымнан келмейтіні
Dialogue: 0,1:28:23.17,1:28:26.38,Default,,0,0,0,,♪ бұдан былай жақсы.
Dialogue: 0,1:28:26.46,1:28:29.97,Default,,0,0,0,,♪ Музыкалық таяқшада,
Dialogue: 0,1:28:30.05,1:28:34.80,Default,,0,0,0,,♪ Жыл мезгілдері өте тез өтеді.
Dialogue: 0,1:28:34.89,1:28:37.47,Default,,0,0,0,,♪ Әр көктем мезгілі,
Dialogue: 0,1:28:37.56,1:28:40.06,Default,,0,0,0,,♪ Біз сонда жүзіп келеміз
Dialogue: 0,1:28:40.14,1:28:42.94,Default,,0,0,0,,♪ шарлар сияқты.
Dialogue: 0,1:28:43.02,1:28:44.77,Default,,0,0,0,,♪ Елестер қуылды
Dialogue: 0,1:28:44.86,1:28:47.44,Default,,0,0,0,,♪ менің күнделігімнен,
Dialogue: 0,1:28:47.53,1:28:48.82,Default,,0,0,0,,♪ Мен өртеп жібердім
Dialogue: 0,1:28:48.90,1:28:51.40,Default,,0,0,0,,♪ жаздың басында.
Dialogue: 0,1:28:51.49,1:28:53.24,Default,,0,0,0,,♪ Сыдырлаған дыбыс
Dialogue: 0,1:28:53.32,1:28:55.74,Default,,0,0,0,,♪ дәлізде,
Dialogue: 0,1:28:55.83,1:28:59.95,Default,,0,0,0,,♪ Жүрегімнің бір жерінде.
Dialogue: 0,1:29:00.04,1:29:03.75,Default,,0,0,0,,♪ Аязды терезе арқылы,
Dialogue: 0,1:29:03.83,1:29:07.21,Default,,0,0,0,,♪ Көзден хабардар болсам
Dialogue: 0,1:29:07.30,1:29:08.50,Default,,0,0,0,,♪ линзаның артында,
Dialogue: 0,1:29:08.59,1:29:12.72,Default,,0,0,0,,♪ Мен қалай ән айтар едім?
Dialogue: 0,1:29:12.80,1:29:15.30,Default,,0,0,0,,♪ Алтын шағылыстар
Dialogue: 0,1:29:15.39,1:29:16.97,Default,,0,0,0,,♪ біздің өміріміз,
Dialogue: 0,1:29:17.06,1:29:21.10,Default,,0,0,0,,♪ Түстен кейін күн сәулесі.
Dialogue: 0,1:29:21.18,1:29:22.52,Default,,0,0,0,,♪ Шоколадтарды балқыту
Dialogue: 0,1:29:22.60,1:29:25.06,Default,,0,0,0,,♪ қалтамда.
Dialogue: 0,1:29:25.15,1:29:26.94,Default,,0,0,0,,♪ Оны әнге айналдыру арқылы,
Dialogue: 0,1:29:27.02,1:29:29.32,Default,,0,0,0,,♪ Жадты сақтай аламын ба?
Dialogue: 0,1:29:29.40,1:29:31.40,Default,,0,0,0,,♪ Мен оны енді ғана жақсы көре бастадым.
Dialogue: 0,1:29:31.49,1:29:33.24,Default,,0,0,0,,♪ Оны әнге айналдыру арқылы,
Dialogue: 0,1:29:33.32,1:29:35.91,Default,,0,0,0,,♪ Жадты сақтай аламын ба?
Dialogue: 0,1:29:35.99,1:29:40.20,Default,,0,0,0,,♪ Мен оны енді ғана жақсы көре бастадым.
Dialogue: 0,1:29:58.43,1:30:03.43,Default,,0,0,0,,~♪
Dialogue: 0,1:30:04.93,1:30:10.93,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory