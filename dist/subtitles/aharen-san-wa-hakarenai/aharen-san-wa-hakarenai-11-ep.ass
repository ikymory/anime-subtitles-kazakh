Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.25,0:00:03.62,Default,,0,0,0,,Сәлем бауырым
Dialogue: 0,0:00:03.71,0:00:05.04,Default,,0,0,0,,Қараңыз және қараңыз
Dialogue: 0,0:00:05.54,0:00:06.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:11.05,0:00:12.09,Default,,0,0,0,,Мен… мен жай…—
Dialogue: 0,0:00:13.51,0:00:14.93,Default,,0,0,0,,Өйткені суық болды
Dialogue: 0,0:00:15.01,0:00:16.93,Default,,0,0,0,,Ертең үйіліп қала ма?
Dialogue: 0,0:00:22.02,0:00:24.02,Default,,0,0,0,,♪~
Dialogue: 0,0:01:48.65,0:01:50.65,Default,,0,0,0,,~♪
Dialogue: 0,0:01:56.90,0:01:58.66,Default,,0,0,0,,Оның осылай үйіліп жатқанына сене алар емеспін
Dialogue: 0,0:01:58.74,0:02:00.37,Default,,0,0,0,,Кейбір ерекше нәрселер бар.
Dialogue: 0,0:02:01.70,0:02:03.33,Default,,0,0,0,,Әлі суық
Dialogue: 0,0:02:03.41,0:02:05.83,Default,,0,0,0,,Мен жылы нәрсе ішкім келеді.
Dialogue: 0,0:02:10.25,0:02:10.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:11.79,0:02:14.59,Default,,0,0,0,,Бұл қардың алып жануары
Dialogue: 0,0:02:14.67,0:02:18.22,Default,,0,0,0,,Әйтеуір, бұл адамзатқа соғылған балға
Dialogue: 0,0:02:18.30,0:02:22.26,Default,,0,0,0,,Табиғаттың ғылымды ілгерілету үшін бізден кек алуы
Dialogue: 0,0:02:22.85,0:02:24.97,Default,,0,0,0,,Бұл ақыры басталды!
Dialogue: 0,0:02:25.97,0:02:27.18,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:27.27,0:02:28.23,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:31.06,0:02:33.65,Default,,0,0,0,,Ах... Қайырлы таң, Ахарен-сан.
Dialogue: 0,0:02:34.27,0:02:35.90,Default,,0,0,0,,Бұл камакура болды.
Dialogue: 0,0:02:36.57,0:02:38.11,Default,,0,0,0,,Орташа өтінемін
Dialogue: 0,0:02:38.61,0:02:40.95,Default,,0,0,0,,А... бір қарап көрейік.
Dialogue: 0,0:02:42.87,0:02:43.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:44.28,0:02:46.45,Default,,0,0,0,,Мен де орындықтарға үстел жасадым.
Dialogue: 0,0:02:46.54,0:02:47.54,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:02:48.04,0:02:48.91,Default,,0,0,0,,Иә
Dialogue: 0,0:02:50.33,0:02:50.83,Default,,0,0,0,,Уф
Dialogue: 0,0:02:51.46,0:02:51.96,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:52.04,0:02:53.00,Default,,0,0,0,,Әй
Dialogue: 0,0:02:56.88,0:02:59.38,Default,,0,0,0,,Aharen кафесіне қош келдіңіз
Dialogue: 0,0:03:00.18,0:03:03.47,Default,,0,0,0,,Кафе... Бұл параметр ме?
Dialogue: 0,0:03:03.55,0:03:04.72,Default,,0,0,0,,Қане мініп жіберейік
Dialogue: 0,0:03:05.43,0:03:05.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:06.64,0:03:10.60,Default,,0,0,0,,Жарайды, мен таңертең көп тамақ жеген жоқпын, сондықтан мен таңғы ас жинаймын.
Dialogue: 0,0:03:11.10,0:03:11.98,Default,,0,0,0,,Иә
Dialogue: 0,0:03:14.61,0:03:15.27,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:19.19,0:03:19.90,Default,,0,0,0,,Аа...
Dialogue: 0,0:03:30.41,0:03:31.12,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:40.17,0:03:40.88,Default,,0,0,0,,Уф
Dialogue: 0,0:03:48.60,0:03:49.64,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:03:50.64,0:03:53.14,Default,,0,0,0,,Бұл кафе шын ғой, солай емес пе?
Dialogue: 0,0:03:55.69,0:03:58.57,Default,,0,0,0,,Фу~ Фу~
Dialogue: 0,0:04:00.94,0:04:03.78,Default,,0,0,0,,Суық күндері ыстық сусындар ең жақсысы.
Dialogue: 0,0:04:04.41,0:04:05.11,Default,,0,0,0,,Иә
Dialogue: 0,0:04:06.32,0:04:09.58,Default,,0,0,0,,Мектепке бара жатқанда мұншалықты демаламын деп ойламаппын.
Dialogue: 0,0:04:09.66,0:04:11.25,Default,,0,0,0,,Мен мұны ешқашан күткен емеспін.
Dialogue: 0,0:04:12.50,0:04:14.29,Default,,0,0,0,,Иә? Сіз мектепке бара жатырсыз ба?
Dialogue: 0,0:04:14.37,0:04:19.05,Default,,0,0,0,,
Dialogue: 0,0:04:19.13,0:04:20.38,Default,,0,0,0,,Сіз кешіктіңіз бе?
Dialogue: 0,0:04:28.10,0:04:29.97,Default,,0,0,0,,Мектептен шығатын уақыт та қалды.
Dialogue: 0,0:04:30.47,0:04:32.14,Default,,0,0,0,,Кеш қалмағаныңызға қуаныштымын.
Dialogue: 0,0:04:32.64,0:04:33.43,Default,,0,0,0,,Иә
Dialogue: 0,0:04:34.56,0:04:39.40,Default,,0,0,0,,Әлі шай қалды, үйге қайтып бара жатқанда кафеге тоқтамасқа?
Dialogue: 0,0:04:40.57,0:04:41.78,Default,,0,0,0,,Тәттілер де бар.
Dialogue: 0,0:04:42.28,0:04:43.78,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:04:47.28,0:04:48.53,Default,,0,0,0,,Жиналған
Dialogue: 0,0:04:49.03,0:04:51.49,Default,,0,0,0,,Басымның ауырлығына шыдай алмадым
Dialogue: 0,0:04:53.29,0:04:53.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:55.00,0:04:57.29,Default,,0,0,0,,Ахарен мырза (Ахарен) Иә?
Dialogue: 0,0:04:58.04,0:05:00.59,Default,,0,0,0,,Пішіні бар кез келген нәрсе ақырында бұзылады.
Dialogue: 0,0:05:01.09,0:05:03.05,Default,,0,0,0,,Бұл бәріне сәйкес келеді.
Dialogue: 0,0:05:03.55,0:05:05.26,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:05:05.97,0:05:09.10,Default,,0,0,0,,Сондықтан оны үзген сайын жөндей аласыз.
Dialogue: 0,0:05:09.60,0:05:11.22,Default,,0,0,0,,Оны бірге қайта құрастырайық
Dialogue: 0,0:05:11.31,0:05:12.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:13.77,0:05:16.27,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:05:21.32,0:05:24.19,Default,,0,0,0,,Фуфуфуфуфуфуфуфуфу…
Dialogue: 0,0:05:25.99,0:05:27.07,Default,,0,0,0,,Орындалды
Dialogue: 0,0:05:28.57,0:05:31.66,Default,,0,0,0,,Оны түзету... бұл басқа нәрсе емес пе?
Dialogue: 0,0:05:32.24,0:05:32.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:33.87,0:05:35.79,Default,,0,0,0,,Ахарен мырзаның қолдары...
Dialogue: 0,0:05:36.66,0:05:39.38,Default,,0,0,0,,Қар Себебі суық болды
Dialogue: 0,0:05:40.25,0:05:40.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:44.34,0:05:45.88,Default,,0,0,0,,Менің қолым жылы
Dialogue: 0,0:05:45.97,0:05:47.30,Default,,0,0,0,,Мен сені жылытамын.
Dialogue: 0,0:05:47.80,0:05:48.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:52.39,0:05:54.18,Default,,0,0,0,,Әй, күн жылып барады.
Dialogue: 0,0:05:54.68,0:05:56.81,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:05:56.89,0:05:58.85,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:06:10.78,0:06:12.28,Default,,0,0,0,,Райду-кун
Dialogue: 0,0:06:13.33,0:06:14.74,Default,,0,0,0,,Ахарен мырза?
Dialogue: 0,0:06:16.20,0:06:18.79,Default,,0,0,0,,Қайырлы таң, бірге барайық.
Dialogue: 0,0:06:19.29,0:06:20.96,Default,,0,0,0,,Осындай кеш келу—
Dialogue: 0,0:06:25.09,0:06:27.88,Default,,0,0,0,,Ахарен мырза қиындап барады.
Dialogue: 0,0:06:28.47,0:06:31.05,Default,,0,0,0,,Жоқ, Ахарен мырза, ақыры...
Dialogue: 0,0:06:32.05,0:06:33.30,Default,,0,0,0,,Машинаның корпусы!
Dialogue: 0,0:06:33.81,0:06:36.89,Default,,0,0,0,,Өлмейтін денені іздеудегі ұзақ жолдың соңында
Dialogue: 0,0:06:36.97,0:06:39.81,Default,,0,0,0,,Мен механикалық денені алдым!
Dialogue: 0,0:06:40.77,0:06:44.40,Default,,0,0,0,,Бүгін оянсам, менің иығым қатты болды.
Dialogue: 0,0:06:44.48,0:06:47.11,Default,,0,0,0,,А, менің иығымның қатуы қорқынышты.
Dialogue: 0,0:06:47.61,0:06:50.15,Default,,0,0,0,,Мен кеше камакура жасау үшін көп жұмыс жасадым.
Dialogue: 0,0:06:51.41,0:06:54.08,Default,,0,0,0,,Жаман болса, емханаға барыңыз.
Dialogue: 0,0:06:54.70,0:06:55.49,Default,,0,0,0,,Иә
Dialogue: 0,0:06:57.25,0:06:59.37,Default,,0,0,0,,Мұғалім, сіз сондасыз ба?
Dialogue: 0,0:07:00.75,0:07:02.50,Default,,0,0,0,,Сіз шығып кеткен сияқтысыз.
Dialogue: 0,0:07:03.13,0:07:03.92,Default,,0,0,0,,Кем дегенде хабарласып қойсаңыз болар еді!
Dialogue: 0,0:07:04.88,0:07:08.34,Default,,0,0,0,,Созылуды жақсы білетін Оширо мырза, ол бір жерде ме?
Dialogue: 0,0:07:10.13,0:07:11.63,Default,,0,0,0,,Ешқайсысы жоқ сияқты.
Dialogue: 0,0:07:12.14,0:07:12.89,Default,,0,0,0,,Иә
Dialogue: 0,0:07:13.76,0:07:15.51,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:07:17.43,0:07:19.02,Default,,0,0,0,,Менімен бірге созылайық па?
Dialogue: 0,0:07:19.52,0:07:21.39,Default,,0,0,0,,Істі сәл жеңілдету үшін
Dialogue: 0,0:07:21.89,0:07:22.60,Default,,0,0,0,,Иә
Dialogue: 0,0:07:25.40,0:07:26.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:27.23,0:07:29.15,Default,,0,0,0,,Сіз қалай ойлайсыз? Ауырмайды ма?
Dialogue: 0,0:07:29.24,0:07:30.45,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:31.57,0:07:33.91,Default,,0,0,0,,Енді сіз қозғала аласыз ба?
Dialogue: 0,0:07:34.41,0:07:38.12,Default,,0,0,0,,Сіз оны күшейте аласыз. Мен сенің көбірек істегеніңді қалаймын.
Dialogue: 0,0:07:38.62,0:07:40.54,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:07:44.13,0:07:45.63,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:07:47.46,0:07:49.92,Default,,0,0,0,,Иә көбірек
Dialogue: 0,0:07:50.01,0:07:53.72,Default,,0,0,0,,Иә, күштірек пе? Сіз мұны шынымен жасайсыз ба?
Dialogue: 0,0:07:57.01,0:07:59.18,Default,,0,0,0,,Мен мұны шындап істей аламын ба?
Dialogue: 0,0:07:59.68,0:08:00.43,Default,,0,0,0,,Иә
Dialogue: 0,0:08:01.68,0:08:04.94,Default,,0,0,0,,Жарайды, егер Ахарен мырза қаласа.
Dialogue: 0,0:08:15.45,0:08:18.83,Default,,0,0,0,,Қазір әлдеқайда оңай, рахмет
Dialogue: 0,0:08:18.91,0:08:22.08,Default,,0,0,0,,Жоқ, қош келдіңіз.
Dialogue: 0,0:08:22.75,0:08:23.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:25.54,0:08:28.46,Default,,0,0,0,,Тым жұмсақ емес пе?
Dialogue: 0,0:08:30.34,0:08:32.26,Default,,0,0,0,,Ммм... (Ахарен) Ах.
Dialogue: 0,0:08:35.43,0:08:38.64,Default,,0,0,0,,Аа, мен соңғы кездері тестке оқуға байланысты ұйықтай алмай жүрмін.
Dialogue: 0,0:08:38.72,0:08:40.72,Default,,0,0,0,,Менің иығым да қатты.
Dialogue: 0,0:08:40.81,0:08:41.81,Default,,0,0,0,,А...
Dialogue: 0,0:08:42.60,0:08:43.85,Default,,0,0,0,,Мен де
Dialogue: 0,0:08:43.94,0:08:46.44,Default,,0,0,0,,Менің иығымды уқалай аласыз ба? рахмет
Dialogue: 0,0:08:46.94,0:08:48.86,Default,,0,0,0,,Жарайды, мен сізге бір жақсылық сұрауға рұқсат етіңіз.
Dialogue: 0,0:08:49.94,0:08:53.28,Default,,0,0,0,,...
Dialogue: 0,0:08:53.36,0:08:54.45,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:54.53,0:08:57.82,Default,,0,0,0,,Мен оның күштірек болғанын қалаймын, бірақ бұл мүмкін емес.
Dialogue: 0,0:08:58.66,0:09:00.33,Default,,0,0,0,,хм/сағ хм/сағ
Dialogue: 0,0:09:00.91,0:09:05.29,Default,,0,0,0,,Дұрыс, Ахарен-сан, өтінемін, арқамнан мініп, бассаңшы?
Dialogue: 0,0:09:05.92,0:09:07.79,Default,,0,0,0,,О... ауыр екен.
Dialogue: 0,0:09:08.42,0:09:11.50,Default,,0,0,0,,Жарайды, онша жаман емес.
Dialogue: 0,0:09:12.80,0:09:15.26,Default,,0,0,0,,Түсіндім, рахмет
Dialogue: 0,0:09:22.35,0:09:24.89,Default,,0,0,0,,Мен мінемін, өтінемін
Dialogue: 0,0:09:28.73,0:09:30.57,Default,,0,0,0,,U.A. Спорттық күні тез арада келіп жетті
Dialogue: 0,0:09:33.82,0:09:37.53,Default,,0,0,0,,Қалай... қалай? Ауыр емес пе?
Dialogue: 0,0:09:38.03,0:09:40.03,Default,,0,0,0,,Жарайды, кем дегенде сенде жаулық ниет жоқ екеніне көз жеткіздім.
Dialogue: 0,0:09:40.12,0:09:40.91,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:09:41.78,0:09:43.24,Default,,0,0,0,,жақсы болар еді
Dialogue: 0,0:09:43.74,0:09:46.54,Default,,0,0,0,,Иә, аздап
Dialogue: 0,0:09:51.92,0:09:53.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:57.55,0:10:02.26,Default,,0,0,0,,Иә? А... Райду-кун?
Dialogue: 0,0:10:02.35,0:10:03.60,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:10:03.68,0:10:06.48,Default,,0,0,0,,Сіз ұйықтап қалдыңыз ба? Сенімен бәрі жақсы ма?
Dialogue: 0,0:10:10.98,0:10:14.44,Default,,0,0,0,,Сабақ басталғалы жатыр, Райду-кун.
Dialogue: 0,0:10:15.57,0:10:17.90,Default,,0,0,0,,Ммм... Ммм (Ахарен) А...
Dialogue: 0,0:10:19.91,0:10:21.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:26.16,0:10:28.41,Default,,0,0,0,,Уау! Кеш, кеш! (Ахарен) Уау...
Dialogue: 0,0:10:28.50,0:10:31.67,Default,,0,0,0,,О? Сабақ басталғалы жатыр
Dialogue: 0,0:10:33.04,0:10:35.30,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,0:10:35.38,0:10:38.38,Default,,0,0,0,,Қазір әлдеқайда оңай, рахмет
Dialogue: 0,0:10:39.43,0:10:41.47,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:10:44.06,0:10:46.93,Default,,0,0,0,,
Dialogue: 0,0:10:48.27,0:10:50.19,Default,,0,0,0,,Райду Ахарен-сан?
Dialogue: 0,0:10:50.27,0:10:50.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:50.98,0:10:52.23,Default,,0,0,0,,Менімен үйге барасың ба?
Dialogue: 0,0:10:52.73,0:10:56.65,Default,,0,0,0,,Бүгін жер қарлы, лайлы, менде үйірме жұмыстары жоқ.
Dialogue: 0,0:10:57.15,0:10:59.53,Default,,0,0,0,,А, жарайды (Ахарен) Иә.
Dialogue: 0,0:11:00.86,0:11:02.24,Default,,0,0,0,,Біз де барамыз ба, Сато мырза?
Dialogue: 0,0:11:02.74,0:11:04.08,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,0:11:04.16,0:11:04.99,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:11:05.08,0:11:06.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:07.83,0:11:08.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:09.00,0:11:11.42,Default,,0,0,0,,Иә?Онда емес
Dialogue: 0,0:11:12.58,0:11:13.83,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:11:28.60,0:11:29.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:32.02,0:11:34.15,Default,,0,0,0,,Екеуің кездесіп жүрсіңдер ме?
Dialogue: 0,0:11:34.23,0:11:36.82,Default,,0,0,0,,Немесе олар кездеспейтін шығар?
Dialogue: 0,0:11:37.32,0:11:39.57,Default,,0,0,0,,Шынымды айтсам, білмеймін.
Dialogue: 0,0:11:40.53,0:11:43.49,Default,,0,0,0,,Егер сіз оның өрнекіне қарасаңыз, сіз бірдеңе айта аласыз.
Dialogue: 0,0:11:43.99,0:11:46.45,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:11:46.53,0:11:48.74,Default,,0,0,0,,Мен түсінбеймін эмоциялар!
Dialogue: 0,0:11:50.20,0:11:52.37,Default,,0,0,0,,Ахарен мырза, қарныңыз ашты ма?
Dialogue: 0,0:11:52.87,0:11:53.83,Default,,0,0,0,,Иә
Dialogue: 0,0:11:54.33,0:11:56.46,Default,,0,0,0,,Олай болса, бәріміз дүкенге барайық.
Dialogue: 0,0:12:01.51,0:12:04.18,Default,,0,0,0,,Қанша жесең де, артық.
Dialogue: 0,0:12:04.93,0:12:06.93,Default,,0,0,0,,Ахарен мырза ұйықтап жатқан сияқты.
Dialogue: 0,0:12:07.60,0:12:09.39,Default,,0,0,0,,Мен дәретханаға барамын.
Dialogue: 0,0:12:10.22,0:12:14.10,Default,,0,0,0,,(Ахареннің ұйқысы)
Dialogue: 0,0:12:14.90,0:12:16.06,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:12:17.06,0:12:20.28,Default,,0,0,0,,Жарайсың, бүгін күні бойы екеумізді бақылап отырдың.
Dialogue: 0,0:12:20.36,0:12:20.90,Default,,0,0,0,,Хана-чан
Dialogue: 0,0:12:20.99,0:12:22.78,Default,,0,0,0,,Иә? Түсінді ме?
Dialogue: 0,0:12:22.86,0:12:25.57,Default,,0,0,0,,Білемін, біз бала кезден доспыз.
Dialogue: 0,0:12:25.66,0:12:28.12,Default,,0,0,0,,Дұрысы, енді мені Хана-чан деп атама.
Dialogue: 0,0:12:28.20,0:12:30.33,Default,,0,0,0,,Иә, иә, Сато мырза.
Dialogue: 0,0:12:30.41,0:12:31.50,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:32.00,0:12:35.88,Default,,0,0,0,,Бүгін кездесіп жүрміз бе деп ойлап, шаршадым.
Dialogue: 0,0:12:35.96,0:12:39.88,Default,,0,0,0,,Бірақ егер сіз кәдімгі жұп болсаңыз, қазіргідей болмас едіңіз.
Dialogue: 0,0:12:40.50,0:12:44.34,Default,,0,0,0,,Бірақ олар кәдімгі жұп емес шығар.
Dialogue: 0,0:12:44.84,0:12:48.85,Default,,0,0,0,,Сіздің ойыңызша, қарапайым жұп қандай болады, Сато мырза?
Dialogue: 0,0:12:48.93,0:12:52.31,Default,,0,0,0,,қыдырып болған соң, екеуміз үйге қайтайық.
Dialogue: 0,0:12:52.39,0:12:54.31,Default,,0,0,0,,Тамақты да бірге ішеміз.
Dialogue: 0,0:12:54.39,0:12:58.11,Default,,0,0,0,,Мен де екеуміз ғана болған кезде бір-бірімізге жақынырақ болғым келетінін сезінемін.
Dialogue: 0,0:12:58.19,0:12:58.90,Default,,0,0,0,,Әдетте
Dialogue: 0,0:12:59.48,0:13:03.32,Default,,0,0,0,,Сато мырза бірдеңе қалыпты ма, жоқ па деген сұраққа ерекше мән береді.
Dialogue: 0,0:13:03.40,0:13:04.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:04.32,0:13:06.61,Default,,0,0,0,,Өйткені әрбір адам бірегей
Dialogue: 0,0:13:06.70,0:13:10.12,Default,,0,0,0,,Мен тым қалыптымын, бірақ мен мүлдем қалыпты емес сияқтымын.\NМен
Dialogue: 0,0:13:10.62,0:13:14.16,Default,,0,0,0,,туралы ойлаған кезде, мен қалыпты нәрсе деп ойлай бастаймын.
Dialogue: 0,0:13:14.66,0:13:16.87,Default,,0,0,0,,Әр адамның бірегей екені рас.
Dialogue: 0,0:13:16.96,0:13:19.08,Default,,0,0,0,,Хмм, бірақ
Dialogue: 0,0:13:19.17,0:13:21.96,Default,,0,0,0,,Әртүрлі адамдар болғаны қызық.
Dialogue: 0,0:13:22.05,0:13:26.22,Default,,0,0,0,,Хм... Ишикава-кун әрқашан солай болған, солай емес пе?
Dialogue: 0,0:13:26.30,0:13:29.97,Default,,0,0,0,,Менің ойымша, Исикава-кун да қызық адам.
Dialogue: 0,0:13:30.05,0:13:31.93,Default,,0,0,0,,Ахахха, солай деп ойлаймын?
Dialogue: 0,0:13:33.64,0:13:38.56,Default,,0,0,0,,Бірақ мен Сато мырзаны да қызықты адам деп ойлаймын.
Dialogue: 0,0:13:39.40,0:13:40.36,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:40.94,0:13:43.98,Default,,0,0,0,,Мен... Мен күлкілі емеспін...
Dialogue: 0,0:13:45.86,0:13:46.99,Default,,0,0,0,,О, Райду
Dialogue: 0,0:13:47.07,0:13:49.37,Default,,0,0,0,,Тоқта, бірдеңе болды ма?
Dialogue: 0,0:13:50.03,0:13:51.03,Default,,0,0,0,,Не?
Dialogue: 0,0:13:51.99,0:13:54.20,Default,,0,0,0,,Ахарен мырза оянғанда үйге барамыз ба?
Dialogue: 0,0:13:55.08,0:13:56.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:02.04,0:14:04.92,Default,,0,0,0,,Ахарен мырза, сіз оны тым тез қорытып жатқан жоқсыз ба?
Dialogue: 0,0:14:07.22,0:14:08.59,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:09.22,0:14:12.18,Default,,0,0,0,,Ертең не киюім керек?
Dialogue: 0,0:14:15.02,0:14:19.23,Default,,0,0,0,,Иә, жақсы, мен мұны шештім.
Dialogue: 0,0:14:23.40,0:14:25.78,Default,,0,0,0,,Бүгінгі демалыс күні Ахарен мырза
Dialogue: 0,0:14:25.86,0:14:28.78,Default,,0,0,0,,Мен мұнда сіз сауда орталығына барғыңыз келетінін айтқандықтан келдім.
Dialogue: 0,0:14:28.86,0:14:30.03,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:14:30.82,0:14:31.99,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:14:33.78,0:14:35.04,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:14:37.33,0:14:38.83,Default,,0,0,0,,Ресми турнир!
Dialogue: 0,0:14:39.33,0:14:43.67,Default,,0,0,0,,Бір-бірін спиннермен ұру қазіргі кезде бастауыш сынып оқушылары арасында кең таралған.
Dialogue: 0,0:14:43.75,0:14:46.38,Default,,0,0,0,,Мен Blade Spinner Burst турниріне қатысамын.
Dialogue: 0,0:14:47.21,0:14:49.80,Default,,0,0,0,,Ахарен мырзаның титулдың иесі екеніне сенімдімін.
Dialogue: 0,0:14:50.30,0:14:52.34,Default,,0,0,0,,Бүгін біз қорғаныс шайқасына шығамыз.
Dialogue: 0,0:14:53.26,0:14:55.43,Default,,0,0,0,,Кеше түнде болған шығар
Dialogue: 0,0:14:55.51,0:14:58.43,Default,,0,0,0,,Ол жабдықты реттеуге алаңдаған болуы керек.
Dialogue: 0,0:14:59.81,0:15:01.98,Default,,0,0,0,,Райду-кун, күте тұрыңыз.
Dialogue: 0,0:15:07.48,0:15:09.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:12.24,0:15:13.32,Default,,0,0,0,,Күтесіз бе?
Dialogue: 0,0:15:13.41,0:15:15.66,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:15:16.24,0:15:20.33,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз. Мен кеше кеш тұрдым.
Dialogue: 0,0:15:20.83,0:15:22.63,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:15:23.13,0:15:25.71,Default,,0,0,0,,Мен кешке дейін баптадым!
Dialogue: 0,0:15:27.00,0:15:29.59,Default,,0,0,0,,Олай болса, барамыз ба? (Ахарен) Иә.
Dialogue: 0,0:15:33.84,0:15:36.60,Default,,0,0,0,,Иә, иә, қыз, мынаны жейміз.
Dialogue: 0,0:15:37.68,0:15:39.43,Default,,0,0,0,,Қараңызшы, бұл да дәмді.
Dialogue: 0,0:15:39.52,0:15:40.64,Default,,0,0,0,,Сіз де бізге қосылыңыз.
Dialogue: 0,0:15:40.73,0:15:42.02,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:15:42.90,0:15:45.06,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:15:46.36,0:15:47.78,Default,,0,0,0,,Сіз тым көп жейсіз бе?
Dialogue: 0,0:15:49.53,0:15:54.11,Default,,0,0,0,,Сонда да, Ахарен мырза, арнайы мақсат жоқ.
Dialogue: 0,0:15:54.62,0:15:58.20,Default,,0,0,0,,Бүкіл заттың ішінен таңдап алып, мұқият тексеріп, дәмін татып көргендей...
Dialogue: 0,0:15:59.70,0:16:03.42,Default,,0,0,0,,Сонымен қатар, мен барлық үлгілерді жеу керек емес.
Dialogue: 0,0:16:03.50,0:16:06.34,Default,,0,0,0,,Ұсынылған кезде бас тарта алмайды
Dialogue: 0,0:16:07.34,0:16:08.92,Default,,0,0,0,,Жоқ, Ахарен мырза
Dialogue: 0,0:16:09.63,0:16:10.88,Default,,0,0,0,,Қонақ үй патшасы!
Dialogue: 0,0:16:11.38,0:16:15.43,Default,,0,0,0,,Мен болашақта танымал болатындай жерде қонақүйлерді бірінен соң бірі салуды жоспарлап отырмын.
Dialogue: 0,0:16:16.01,0:16:18.56,Default,,0,0,0,,Тамақтану – туризмнің негізі.
Dialogue: 0,0:16:18.64,0:16:22.27,Default,,0,0,0,,Мен азық-түлік негізінде елде ненің трендте екенін білуге ​​тырысамын.
Dialogue: 0,0:16:24.14,0:16:24.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:25.52,0:16:27.23,Default,,0,0,0,,Фестиваль өткізу
Dialogue: 0,0:16:27.73,0:16:32.07,Default,,0,0,0,,Менің отбасым фестиваль туралы өте экстравагантты.
Dialogue: 0,0:16:32.57,0:16:35.16,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:16:35.95,0:16:36.66,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:37.49,0:16:40.20,Default,,0,0,0,,Райду, шаянды ұнатасың ба?
Dialogue: 0,0:16:40.70,0:16:41.95,Default,,0,0,0,,Маған шаян ұнайды
Dialogue: 0,0:16:42.58,0:16:43.71,Default,,0,0,0,,Шешім
Dialogue: 0,0:16:44.33,0:16:45.58,Default,,0,0,0,,Маған мынаны беріңізші
Dialogue: 0,0:16:45.67,0:16:46.58,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:47.21,0:16:49.04,Default,,0,0,0,,Мен оны кейінірек алып кетемін.
Dialogue: 0,0:16:54.55,0:16:57.59,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:59.56,0:17:03.23,Default,,0,0,0,,Бұл сауда орталығынан толық ләззат алатын күн, солай ма?
Dialogue: 0,0:17:06.81,0:17:10.40,Default,,0,0,0,,Жарайды, мен бүгін ең жақсы демалыс күнін жасаймын.
Dialogue: 0,0:17:11.69,0:17:14.95,Default,,0,0,0,,Әй, патша Аха! Ава әкел!
Dialogue: 0,0:17:16.82,0:17:18.57,Default,,0,0,0,,Бітті, солай емес пе?
Dialogue: 0,0:17:19.99,0:17:21.58,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:17:22.33,0:17:24.00,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:17:24.50,0:17:27.67,Default,,0,0,0,,Оны көргенде білесің. Бұл кездесу. Бұл кездесу.
Dialogue: 0,0:17:27.75,0:17:31.25,Default,,0,0,0,,Жоқ, сіз жаңа ғана менімен бірге жұмысыма келетініңізді айттыңыз.
Dialogue: 0,0:17:31.34,0:17:31.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:33.30,0:17:36.76,Default,,0,0,0,,Міне... міне! Маған шындықты айтпа!
Dialogue: 0,0:17:36.84,0:17:38.68,Default,,0,0,0,,Сіздердің...
Dialogue: 0,0:17:41.56,0:17:42.43,Default,,0,0,0,,Ах
Dialogue: 0,0:17:44.64,0:17:47.52,Default,,0,0,0,,Балалар, болмайды...
Dialogue: 0,0:17:50.36,0:17:55.07,Default,,0,0,0,,Жоқ, мен сендерді қызықтырмаймын.
Dialogue: 0,0:17:55.99,0:17:58.32,Default,,0,0,0,,Жүр, кеттік, Ақкүн.
Dialogue: 0,0:17:58.45,0:17:59.82,Default,,0,0,0,,Жоқ, не?
Dialogue: 0,0:18:00.82,0:18:01.83,Default,,0,0,0,,Сәлем шәкірт
Dialogue: 0,0:18:02.33,0:18:05.16,Default,,0,0,0,,Неге әрқашан патшаның қасындасың?
Dialogue: 0,0:18:06.41,0:18:08.92,Default,,0,0,0,,Жоқ, патша...
Dialogue: 0,0:18:09.75,0:18:13.46,Default,,0,0,0,,Менің патшаның ең жақсы шәкірті екенімді ұмыттың ба?
Dialogue: 0,0:18:14.63,0:18:15.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:17.34,0:18:19.22,Default,,0,0,0,,Маған жетпейтін сияқты
Dialogue: 0,0:18:20.68,0:18:21.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:21.76,0:18:24.10,Default,,0,0,0,,Жарайды, онда...
Dialogue: 0,0:18:25.43,0:18:28.35,Default,,0,0,0,,Кіші шәкірт! Менімен жарыс!
Dialogue: 0,0:18:28.85,0:18:29.90,Default,,0,0,0,,Жарыс?
Dialogue: 0,0:18:30.69,0:18:31.40,Default,,0,0,0,,О
Dialogue: 0,0:18:32.48,0:18:35.78,Default,,0,0,0,,Блейд спиннер турнирі басталғалы тұр.
Dialogue: 0,0:18:38.24,0:18:40.70,Default,,0,0,0,,Бұл турнир турнирлік ойын.
Dialogue: 0,0:18:40.78,0:18:42.57,Default,,0,0,0,,Ал қатарынан кірсеңіз
Dialogue: 0,0:18:42.66,0:18:45.20,Default,,0,0,0,,Әртүрлі блоктарға бөлуге болады
Dialogue: 0,0:18:45.70,0:18:47.70,Default,,0,0,0,,Турнирді екеуміз де жеңсек
Dialogue: 0,0:18:47.79,0:18:49.62,Default,,0,0,0,,Финалда кездесуі мүмкін
Dialogue: 0,0:18:52.46,0:18:56.34,Default,,0,0,0,,Жүр, кіші шәкірт, мұны істейсің бе?
Dialogue: 0,0:18:57.13,0:19:00.18,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:19:01.68,0:19:04.30,Default,,0,0,0,,Финалда кездескенше.
Dialogue: 0,0:19:08.43,0:19:11.27,Default,,0,0,0,,(Ацушидің айқайы)
Dialogue: 0,0:19:11.77,0:19:15.07,Default,,0,0,0,,Бірінші раундта екеуміз де жеңілеміз деп ойламаппын.
Dialogue: 0,0:19:16.36,0:19:18.15,Default,,0,0,0,,Жылама, Атсуши-кун
Dialogue: 0,0:19:18.69,0:19:20.03,Default,,0,0,0,,Бұл жақсы шайқас болды.
Dialogue: 0,0:19:20.95,0:19:23.95,Default,,0,0,0,,Иә? Ахарен ше?
Dialogue: 0,0:19:24.45,0:19:26.24,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:27.20,0:19:30.21,Default,,0,0,0,,Шексіз бөлу Жеңімпаз...
Dialogue: 0,0:19:30.29,0:19:33.38,Default,,0,0,0,,Аваны әкелме!
Dialogue: 0,0:19:33.46,0:19:36.46,Default,,0,0,0,,Бұл менің турнирдегі 5-ші жеңісім!
Dialogue: 0,0:19:38.30,0:19:40.22,Default,,0,0,0,,Ахарен мырза да қатысты.
Dialogue: 0,0:19:40.30,0:19:42.51,Default,,0,0,0,,Иә, ол әр кезде пайда болады.
Dialogue: 0,0:19:43.01,0:19:46.60,Default,,0,0,0,,Мен баптау туралы уайымдап, кеш ұйықтадым.
Dialogue: 0,0:19:47.22,0:19:48.77,Default,,0,0,0,,Күтілгендей, солай болды.
Dialogue: 0,0:19:48.85,0:19:50.81,Default,,0,0,0,,Аха патша күткендей!
Dialogue: 0,0:19:51.81,0:19:55.81,Default,,0,0,0,,Мен де, бірақ маған да қара.
Dialogue: 0,0:19:56.73,0:19:59.57,Default,,0,0,0,,Әйелдер дивизионының жеңімпазы - Футаба!
Dialogue: 0,0:19:59.65,0:20:01.78,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:20:02.36,0:20:03.66,Default,,0,0,0,,Футаба?
Dialogue: 0,0:20:04.36,0:20:06.33,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:20:06.83,0:20:11.25,Default,,0,0,0,,Екеуміз сөйлесейік деп Аккунның бұл әрекетін үнемі бақылап отыратынмын.
Dialogue: 0,0:20:11.33,0:20:15.92,Default,,0,0,0,,Мен де қолданып көрдім, бірақ жеңемін деп ешқашан ойламадым...
Dialogue: 0,0:20:16.67,0:20:17.84,Default,,0,0,0,,Футаба...
Dialogue: 0,0:20:18.46,0:20:21.30,Default,,0,0,0,,Сіз кереметсіз! Маған да айтыңызшы!
Dialogue: 0,0:20:21.80,0:20:24.64,Default,,0,0,0,,Бол... Мен қарсы емеспін.
Dialogue: 0,0:20:25.26,0:20:26.30,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:20:26.80,0:20:28.51,Default,,0,0,0,,Әйтеуір бәрі бір-біріне сәйкес келеді.
Dialogue: 0,0:20:29.01,0:20:29.77,Default,,0,0,0,,Иә
Dialogue: 0,0:20:31.43,0:20:35.31,Default,,0,0,0,,Олай болса, енді екеуіңіз кездесуді жалғастыра аласыздар.
Dialogue: 0,0:20:37.02,0:20:38.73,Default,,0,0,0,,А... иә? Күн?
Dialogue: 0,0:20:40.28,0:20:42.24,Default,,0,0,0,,Тамақтану және ойнау
Dialogue: 0,0:20:42.32,0:20:44.78,Default,,0,0,0,,Маған жаңа ғана сауда орталығы ұнады.
Dialogue: 0,0:20:44.86,0:20:46.11,Default,,0,0,0,,Не? Өйткені
Dialogue: 0,0:20:46.20,0:20:48.78,Default,,0,0,0,,Сауда үйін жалғыз айналып шығасың ба?
Dialogue: 0,0:20:49.28,0:20:51.75,Default,,0,0,0,,Бұл кездесу емес пе?
Dialogue: 0,0:20:52.62,0:20:53.71,Default,,0,0,0,,Е...
Dialogue: 0,0:20:54.46,0:20:55.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:56.96,0:20:57.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:00.50,0:21:02.21,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:21:03.30,0:21:09.01,Default,,0,0,0,,Менің қарным ашты және уақытым болды, сондықтан бұл қалыпты болды...
Dialogue: 0,0:21:10.97,0:21:12.18,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:21:13.43,0:21:14.27,Default,,0,0,0,,Иә
Dialogue: 0,0:21:22.57,0:21:24.82,Default,,0,0,0,,Бүгінгі түскі ас қорабы керемет.
Dialogue: 0,0:21:24.90,0:21:28.12,Default,,0,0,0,,Мен мұны тәжірибеге арналған сынақ ретінде жасадым.
Dialogue: 0,0:21:28.70,0:21:30.62,Default,,0,0,0,,Райду-кун, сен де же.
Dialogue: 0,0:21:33.45,0:21:36.50,Default,,0,0,0,,Сіз оны сауда орталығынан сатып алған ингредиенттер арқылы жасадыңыз.
Dialogue: 0,0:21:38.54,0:21:39.84,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:21:42.13,0:21:43.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:48.72,0:21:53.85,Default,,0,0,0,,Хмм, краб, бұл өте жақсы!
Dialogue: 0,0:21:56.64,0:21:57.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:57.94,0:22:00.86,Default,,0,0,0,,Мен Оширо мырзаны соңғы уақытта көрмедім.
Dialogue: 0,0:22:01.98,0:22:03.98,Default,,0,0,0,,♪~
Dialogue: 0,0:23:28.44,0:23:30.45,Default,,0,0,0,,~♪
Dialogue: 0,0:23:58.64,0:24:00.31,Default,,0,0,0,,Сіз екінші курс студентісіз бе?
Dialogue: 0,0:24:00.39,0:24:02.52,Default,,0,0,0,,Ахарен мырза, сіздің естеліктеріңіз бар ма?
Dialogue: 0,0:24:02.60,0:24:04.73,Default,,0,0,0,,Жақсы айтатын нәрселер тым көп.
Dialogue: 0,0:24:04.81,0:24:07.32,Default,,0,0,0,,Бұдан былай дау-дамай болмайды.
Dialogue: 0,0:24:07.40,0:24:09.86,Default,,0,0,0,,Студенттік өмірің тыныш болады деп сенемін.
Dialogue: 0,0:24:10.36,0:24:11.11,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:24:11.19,0:24:12.70,Default,,0,0,0,,«Бұл тұр емес пе?»
Dialogue: 0,0:24:14.20,0:24:20.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory