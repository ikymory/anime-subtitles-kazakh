Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.60,0:00:20.06,Default,,0,0,0,,бастайық.
Dialogue: 0,0:00:21.18,0:00:24.31,Default,,0,0,0,,«Төменгі палубаға баратын уақыт келді»
Dialogue: 0,0:00:25.02,0:00:27.40,Default,,0,0,0,,Момохара мырза біраз қорқынышты.
Dialogue: 0,0:00:27.48,0:00:28.73,Default,,0,0,0,,Бұл жұмбақ.
Dialogue: 0,0:00:28.82,0:00:30.94,Default,,0,0,0,,Физикалық тұрғыдан әлсіз деген қауесет бар...
Dialogue: 0,0:00:31.03,0:00:32.28,Default,,0,0,0,,Исикава мырза (Ишикава) Ах...
Dialogue: 0,0:00:32.36,0:00:33.53,Default,,0,0,0,,Жеке сөйлесуді тоқтатыңыз
Dialogue: 0,0:00:33.61,0:00:34.65,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:00:34.74,0:00:36.53,Default,,0,0,0,,Жалғастыру
Dialogue: 0,0:00:36.61,0:00:39.08,Default,,0,0,0,,«Мұны ұят деп санайтындар»
Dialogue: 0,0:00:39.16,0:00:41.45,Default,,0,0,0,,Қанша оқысаң да әдемі жазу
Dialogue: 0,0:00:41.54,0:00:43.66,Default,,0,0,0,,Мені жеке сөзбен мазалағым келмейді.
Dialogue: 0,0:00:43.75,0:00:44.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:45.12,0:00:48.17,Default,,0,0,0,,Бұл “ito” – екпінді үстеулер.
Dialogue: 0,0:00:48.25,0:00:49.54,Default,,0,0,0,,«өте» дегенді білдіреді
Dialogue: 0,0:00:49.63,0:00:52.63,Default,,0,0,0,,Мұндағы «Хабар» сөзі нені білдіреді?
Dialogue: 0,0:00:52.71,0:00:56.89,Default,,0,0,0,,«Дәмді» - жүрек тебіренгенде қолданылатын өрнек…
Dialogue: 0,0:00:59.47,0:01:00.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:00.85,0:01:04.27,Default,,0,0,0,,Райду-сан мен Ахарен-сан сабақ үстінде сырласып жүрді...
Dialogue: 0,0:01:05.27,0:01:07.90,Default,,0,0,0,,Мен бұл жерде абай болуым керек!
Dialogue: 0,0:01:07.98,0:01:09.98,Default,,0,0,0,,♪~
Dialogue: 0,0:02:34.61,0:02:36.61,Default,,0,0,0,,~♪
Dialogue: 0,0:02:40.74,0:02:41.78,Default,,0,0,0,,Бұл екі...
Dialogue: 0,0:02:41.87,0:02:43.83,Default,,0,0,0,,Мен сенімен сырласпаймын.
Dialogue: 0,0:02:43.91,0:02:46.20,Default,,0,0,0,,Сен маған ұмытып кеткен оқулықты көрсетіп тұрсың.
Dialogue: 0,0:02:46.29,0:02:48.41,Default,,0,0,0,,Оның үстіне Райду-сан маған көрсетіп тұр.
Dialogue: 0,0:02:48.50,0:02:51.17,Default,,0,0,0,,Мен Ахарен-санға өзімнен артықшылықты көрсетемін.
Dialogue: 0,0:02:52.00,0:02:55.63,Default,,0,0,0,,Жоғары сынып оқушыларының қыздарға деген мейірімділігі
Dialogue: 0,0:02:56.13,0:02:57.59,Default,,0,0,0,,Бұл хабардар!
Dialogue: 0,0:02:57.67,0:02:59.80,Default,,0,0,0,,Мүлдем жиіркенішті!
Dialogue: 0,0:02:59.88,0:03:02.47,Default,,0,0,0,,Жоғары сынып оқушылары мен қыздарының пәктігі
Dialogue: 0,0:03:02.55,0:03:04.76,Default,,0,0,0,,Itoaware тым көп!
Dialogue: 0,0:03:04.85,0:03:06.97,Default,,0,0,0,,Мұғалім, амансың ба?
Dialogue: 0,0:03:07.06,0:03:08.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:08.22,0:03:10.27,Default,,0,0,0,,Себебі мен кенеттен жиіркенішті сезіндім.
Dialogue: 0,0:03:10.98,0:03:12.98,Default,,0,0,0,,Жоқ, мен абай болуым керек.
Dialogue: 0,0:03:13.56,0:03:16.48,Default,,0,0,0,,Өйткені маған классикалық романтикалық шығармалар өте ұнайды
Dialogue: 0,0:03:16.57,0:03:17.69,Default,,0,0,0,,Екі еркек пен әйелге қарап
Dialogue: 0,0:03:17.78,0:03:20.49,Default,,0,0,0,,Ол енді ғана өз бетімен қызықты бола бастады.
Dialogue: 0,0:03:20.57,0:03:22.20,Default,,0,0,0,,Әсіресе осы екі адам
Dialogue: 0,0:03:22.28,0:03:26.20,Default,,0,0,0,,Бұл бір қарағанда керемет көрінеді, бірақ ол күшті байланыс болуы керек!
Dialogue: 0,0:03:26.78,0:03:28.91,Default,,0,0,0,,Жарайды, тыныштал.
Dialogue: 0,0:03:29.00,0:03:31.04,Default,,0,0,0,,Енді бір-біріне жабыспайды
Dialogue: 0,0:03:32.62,0:03:35.21,Default,,0,0,0,,«Окаши» «Білумен» бірдей
Dialogue: 0,0:03:35.29,0:03:39.13,Default,,0,0,0,,Ол «қызық» деп аударылған, бірақ мағынасы сәл басқаша.
Dialogue: 0,0:03:39.63,0:03:40.63,Default,,0,0,0,,Кім біледі?
Dialogue: 0,0:03:41.93,0:03:43.51,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,0:03:44.18,0:03:46.64,Default,,0,0,0,,Біз бұрынғыдан да жақынбыз!
Dialogue: 0,0:03:46.72,0:03:49.14,Default,,0,0,0,,Олар бір-біріне жабысып қалды, дәлірек айтсақ, олар бір-біріне жабысып қалды!
Dialogue: 0,0:03:49.22,0:03:52.14,Default,,0,0,0,,Бұл мұғалім шынымен...
Dialogue: 0,0:03:52.23,0:03:54.85,Default,,0,0,0,,Кешіріңіз, мен жақында тынышталамын.
Dialogue: 0,0:03:54.94,0:03:58.98,Default,,0,0,0,,Мен аздап... жүрек соғысын сезіндім.
Dialogue: 0,0:04:00.24,0:04:01.36,Default,,0,0,0,,Басқаша айтқанда, бұл сенің махаббатыңның күші
Dialogue: 0,0:04:02.11,0:04:04.36,Default,,0,0,0,,Бұл жолы Ахарен мырза сақтық танытты.
Dialogue: 0,0:04:04.45,0:04:06.41,Default,,0,0,0,,Екеуіңізді де анық көретіндей етіп қойыңыз!
Dialogue: 0,0:04:06.49,0:04:08.70,Default,,0,0,0,,Екеуі бір-бірін қайталады.
Dialogue: 0,0:04:08.79,0:04:10.66,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:04:10.75,0:04:13.62,Default,,0,0,0,,Екеуі қандай жақсы қыздар.
Dialogue: 0,0:04:13.71,0:04:16.46,Default,,0,0,0,,Бұл мені күлдіреді және!
Dialogue: 0,0:04:17.50,0:04:20.67,Default,,0,0,0,,Тезірек сабаққа бармасам, жүрегім шыдамайды!
Dialogue: 0,0:04:20.76,0:04:23.72,Default,,0,0,0,,Сонымен… өйткені… бұл… мұнда…
Dialogue: 0,0:04:23.80,0:04:25.18,Default,,0,0,0,,Ах
Dialogue: 0,0:04:28.35,0:04:29.64,Default,,0,0,0,,Бұл... бұл?
Dialogue: 0,0:04:29.72,0:04:30.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:30.85,0:04:33.35,Default,,0,0,0,,Менің алдымдағы адамның үлкендігі сонша, мен тақтаны көре алмаймын.
Dialogue: 0,0:04:33.43,0:04:36.56,Default,,0,0,0,,Райду-сан оны көрсін деп ұстап тұр!
Dialogue: 0,0:04:36.65,0:04:40.28,Default,,0,0,0,,Оның үстіне мен де тақтаға жазуым керек, сондықтан мен оны бір қолмен жасаймын.
Dialogue: 0,0:04:40.82,0:04:42.65,Default,,0,0,0,,Қандай мейірімді!
Dialogue: 0,0:04:42.74,0:04:44.24,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:45.03,0:04:47.62,Default,,0,0,0,,Жыл қояны!
Dialogue: 0,0:04:47.70,0:04:50.03,Default,,0,0,0,,Момохара мырза құлап қалды!
Dialogue: 0,0:04:50.12,0:04:52.41,Default,,0,0,0,,Мен шынымен әлсіз болдым.
Dialogue: 0,0:04:55.46,0:04:57.75,Default,,0,0,0,,Момохара мырза, жақсысыз ба?
Dialogue: 0,0:04:57.83,0:04:58.46,Default,,0,0,0,,Иә
Dialogue: 0,0:04:58.54,0:04:59.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:59.96,0:05:00.67,Default,,0,0,0,,Жоқ! иә?
Dialogue: 0,0:05:00.75,0:05:01.42,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:02.01,0:05:02.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:03.59,0:05:05.63,Default,,0,0,0,,Не... не болды? Ахарен мырза
Dialogue: 0,0:05:05.72,0:05:06.30,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:06.38,0:05:08.30,Default,,0,0,0,,Қоңырау шалғанда жауап жоқ
Dialogue: 0,0:05:08.39,0:05:10.35,Default,,0,0,0,,Міне, бұл!
Dialogue: 0,0:05:11.10,0:05:12.31,Default,,0,0,0,,Жын иелену!
Dialogue: 0,0:05:13.64,0:05:16.64,Default,,0,0,0,,Ахарен мырзаға жын кірген.
Dialogue: 0,0:05:17.40,0:05:19.77,Default,,0,0,0,,Әй, бұл қасиетті су!
Dialogue: 0,0:05:19.86,0:05:22.90,Default,,0,0,0,,Ахарен мырза шайтанды өзі қуып шығуға тырысады.
Dialogue: 0,0:05:22.98,0:05:23.90,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:25.78,0:05:26.53,Default,,0,0,0,,Фу
Dialogue: 0,0:05:26.61,0:05:29.03,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:05:29.12,0:05:29.74,Default,,0,0,0,,Иә
Dialogue: 0,0:05:29.82,0:05:32.24,Default,,0,0,0,,Тамағым тамағыма кептеліп қалды.
Dialogue: 0,0:05:33.12,0:05:34.33,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:05:35.25,0:05:36.96,Default,,0,0,0,,Ахарен мырзаның не айтқысы келетіні туралы толығырақ.
Dialogue: 0,0:05:37.04,0:05:40.75,Default,,0,0,0,,Дереу ескертпеу апатқа әкелуі мүмкін.
Dialogue: 0,0:05:41.50,0:05:42.38,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:05:42.96,0:05:47.51,Default,,0,0,0,,Ахарен мырзаны өрнекті бай деп сипаттауға болмайды.
Dialogue: 0,0:05:48.63,0:05:51.76,Default,,0,0,0,,Ахарен мырза, жағдай осылай жалғаса берсе жақсы емес.
Dialogue: 0,0:05:51.85,0:05:54.14,Default,,0,0,0,,Мимика жасауға жаттығамыз ба?
Dialogue: 0,0:05:54.22,0:05:54.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:55.64,0:05:56.98,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:05:57.69,0:05:58.27,Default,,0,0,0,,Иә
Dialogue: 0,0:05:59.31,0:06:01.06,Default,,0,0,0,,Ең алдымен күліңіз
Dialogue: 0,0:06:01.15,0:06:02.90,Default,,0,0,0,,Менің бетімді көшіріңіз.
Dialogue: 0,0:06:04.07,0:06:04.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:05.94,0:06:07.90,Default,,0,0,0,,Жарайды, көріңіз.
Dialogue: 0,0:06:07.99,0:06:08.70,Default,,0,0,0,,Иә
Dialogue: 0,0:06:10.37,0:06:10.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:11.87,0:06:13.83,Default,,0,0,0,,Иә, мен жақсымын.
Dialogue: 0,0:06:13.91,0:06:14.87,Default,,0,0,0,,Иә
Dialogue: 0,0:06:14.95,0:06:19.37,Default,,0,0,0,,Олай болса, өрнектерді жасауды жеңілдету үшін мимика бұлшықеттерін жұмсартайық.
Dialogue: 0,0:06:19.46,0:06:20.71,Default,,0,0,0,,Мен саған массаж жасаймын.
Dialogue: 0,0:06:20.79,0:06:21.58,Default,,0,0,0,,Иә
Dialogue: 0,0:06:25.96,0:06:27.88,Default,,0,0,0,,Жарайды, ол жұмсақ болып барады.
Dialogue: 0,0:06:32.68,0:06:34.56,Default,,0,0,0,,Тым жұмсақ емес пе?
Dialogue: 0,0:06:36.31,0:06:38.56,Default,,0,0,0,,Одан әрі эмоцияларды қозғалтуға жаттықтыру
Dialogue: 0,0:06:38.64,0:06:40.69,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:06:41.31,0:06:44.52,Default,,0,0,0,,Ууууууууууууууууу...
Dialogue: 0,0:06:44.61,0:06:47.15,Default,,0,0,0,,Мм... тұтынушы
Dialogue: 0,0:06:47.24,0:06:51.07,Default,,0,0,0,,Кешіріңіз, тынышталғанша күте аласыз ба?
Dialogue: 0,0:06:51.57,0:06:54.12,Default,,0,0,0,,Жарайды, тағы біраз нәрсені байқап көрейік.
Dialogue: 0,0:06:54.83,0:06:55.49,Default,,0,0,0,,Иә
Dialogue: 0,0:07:02.08,0:07:03.67,Default,,0,0,0,,Соңғы жанасулар
Dialogue: 0,0:07:05.00,0:07:06.84,Default,,0,0,0,,Менімен көз жүгірту сайысында жарысыңыз!
Dialogue: 0,0:07:07.34,0:07:09.13,Default,,0,0,0,,Келіңіз, Ахарен мырза.
Dialogue: 0,0:07:09.22,0:07:11.55,Default,,0,0,0,,Мені жеңуге тырысыңыз, қожайын!
Dialogue: 0,0:07:17.52,0:07:19.56,Default,,0,0,0,,Қандай күлкілі жүз жасайсың
Dialogue: 0,0:07:20.10,0:07:21.69,Default,,0,0,0,,Бірақ әлі жоқ
Dialogue: 0,0:07:22.77,0:07:24.31,Default,,0,0,0,,Не болды, Ахарен мырза?
Dialogue: 0,0:07:24.40,0:07:26.27,Default,,0,0,0,,Маған басқа оғаш беттерді көрсетіңіз.
Dialogue: 0,0:07:26.86,0:07:28.03,Default,,0,0,0,,Күлкілі жүз
Dialogue: 0,0:07:29.90,0:07:30.74,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:07:30.82,0:07:35.32,Default,,0,0,0,,Бұл менің жоғалтуым, сондықтан бұл бетті жасауды доғар.
Dialogue: 0,0:07:36.41,0:07:37.91,Default,,0,0,0,,Құттықтаймыз Ахарен-сан
Dialogue: 0,0:07:37.99,0:07:40.16,Default,,0,0,0,,Менің сізге үйрететін ештеңем жоқ.
Dialogue: 0,0:07:41.00,0:07:43.12,Default,,0,0,0,,Бұдан былай дауыстап айтудың қажеті жоқ.
Dialogue: 0,0:07:43.21,0:07:45.84,Default,,0,0,0,,Мен Ахарен мырзаның не ойлап тұрғанын түсінемін.
Dialogue: 0,0:07:45.92,0:07:47.00,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:47.09,0:07:48.30,Default,,0,0,0,,Күл, күл
Dialogue: 0,0:07:48.38,0:07:49.05,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:50.01,0:07:51.76,Default,,0,0,0,,Алдыңғы фотосуретпен салыстырғанда
Dialogue: 0,0:07:51.84,0:07:53.84,Default,,0,0,0,,Өсуді тексерейік
Dialogue: 0,0:07:57.22,0:07:58.51,Default,,0,0,0,,Ештеңе өзгерген жоқ, солай ма?
Dialogue: 0,0:07:59.93,0:08:01.98,Default,,0,0,0,,Арнайы дайындық сәтті аяқталды.
Dialogue: 0,0:08:02.56,0:08:04.23,Default,,0,0,0,,Көңіл-күйді басқа жаққа аудару жақсы
Dialogue: 0,0:08:04.31,0:08:07.61,Default,,0,0,0,,Менің Ахарен мырзаның мимикасын оқу қабілетім
Dialogue: 0,0:08:07.69,0:08:09.48,Default,,0,0,0,,Ол міндетті түрде көтерілуі керек еді.
Dialogue: 0,0:08:09.98,0:08:13.07,Default,,0,0,0,,Бет әлпетіңізге қарап ұнаған компакт-дискілерді оқып көрейік
Dialogue: 0,0:08:13.15,0:08:13.86,Default,,0,0,0,,Ах
Dialogue: 0,0:08:13.95,0:08:15.45,Default,,0,0,0,,Міне! иә?
Dialogue: 0,0:08:16.20,0:08:17.03,Default,,0,0,0,,Рэп?
Dialogue: 0,0:08:17.74,0:08:19.37,Default,,0,0,0,,Сіз жиі тыңдайсыз ба?
Dialogue: 0,0:08:19.45,0:08:21.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:21.16,0:08:23.04,Default,,0,0,0,,Тыңдап көрейік.
Dialogue: 0,0:08:23.12,0:08:23.71,Default,,0,0,0,,Иә
Dialogue: 0,0:08:24.75,0:08:25.54,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:08:25.63,0:08:27.92,Default,,0,0,0,,(рэп ырғағы)
Dialogue: 0,0:08:28.00,0:08:29.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:39.89,0:08:40.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:43.18,0:08:44.77,Default,,0,0,0,,Қайырлы таң Ахарен-сан
Dialogue: 0,0:08:44.85,0:08:45.35,Default,,0,0,0,,Ах
Dialogue: 0,0:08:46.27,0:08:47.81,Default,,0,0,0,,CD қалай болды?
Dialogue: 0,0:08:47.90,0:08:49.69,Default,,0,0,0,,Ұнаса, мен де тыңдап көрейін.
Dialogue: 0,0:08:50.19,0:08:51.03,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:08:52.03,0:08:57.28,Default,,0,0,0,,(рэп ырғағы)
Dialogue: 0,0:08:57.41,0:09:00.03,Default,,0,0,0,,♪ Қозғалтқыш таңертең әлсіз және жұмыс істемейді.
Dialogue: 0,0:09:00.12,0:09:02.95,Default,,0,0,0,,♪ Мен саябақтағы орындықта демалғым келеді.
Dialogue: 0,0:09:03.04,0:09:05.46,Default,,0,0,0,,♪ Мен сынақты кейінге қалдырғым келеді.
Dialogue: 0,0:09:05.54,0:09:08.21,Default,,0,0,0,,♪ Мен оқымаймын. Мен қатты қысылып қалдым.
Dialogue: 0,0:09:09.75,0:09:12.00,Default,,0,0,0,,Ахарен мырза рэп айтып жатыр ма?
Dialogue: 0,0:09:12.09,0:09:15.01,Default,,0,0,0,,Бұл кеше сатып алған компакт-дискіге байланысты болды ма?
Dialogue: 0,0:09:15.09,0:09:16.47,Default,,0,0,0,,Тез үйренесіз бе?
Dialogue: 0,0:09:17.05,0:09:17.80,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:09:18.39,0:09:19.35,Default,,0,0,0,,Рэп - бұл мәлімдеме және т.б.
Dialogue: 0,0:09:19.43,0:09:23.14,Default,,0,0,0,,Байланыс үшін қолданылатын күшті хабары бар музыка
Dialogue: 0,0:09:23.64,0:09:26.94,Default,,0,0,0,,Ахарен қаласа да жеткізе алмайтын көптеген нәрселер бар.
Dialogue: 0,0:09:27.02,0:09:28.81,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:29.69,0:09:31.36,Default,,0,0,0,,Мен оны таптым!
Dialogue: 0,0:09:31.44,0:09:34.53,Default,,0,0,0,,Ахарен мырзамен байланысудың ең жақсы тәсілі
Dialogue: 0,0:09:35.57,0:09:38.74,Default,,0,0,0,,Енді маған тек ыстық әкпен рэп айту ғана қалды!
Dialogue: 0,0:09:40.37,0:09:42.41,Default,,0,0,0,,♪ О... Мен Ла... Райдумын
Dialogue: 0,0:09:42.49,0:09:44.87,Default,,0,0,0,,♪ Дәл қазір... Мен мектепке бара жатырмын...
Dialogue: 0,0:09:44.95,0:09:47.67,Default,,0,0,0,,♪ Қазір істеп жүргенім мектепке бару...
Dialogue: 0,0:09:49.25,0:09:51.50,Default,,0,0,0,,Рэп Бұл қиын, солай емес пе?
Dialogue: 0,0:09:52.50,0:09:54.92,Default,,0,0,0,,Ахарен-санға рэп айтып жаттық
Dialogue: 0,0:09:56.63,0:09:57.43,Default,,0,0,0,,Бұл керемет, Широ-сан. Шынымен де, бұл мүлде басқа деңгей.
Dialogue: 0,0:09:57.51,0:09:58.13,Default,,0,0,0,,Не?
Dialogue: 0,0:09:58.22,0:10:01.18,Default,,0,0,0,,♪ Сіз, әпке, мен, аға, сіздің көзқарасыңыз қандай?
Dialogue: 0,0:10:01.26,0:10:02.51,Default,,0,0,0,,♪ Бұл шынымен дөрекі емес пе?
Dialogue: 0,0:10:02.60,0:10:07.10,Default,,0,0,0,,♪ Ағайынды сыйлауды ұмытпа. Алғыс сұрау.
Dialogue: 0,0:10:07.18,0:10:08.89,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:10:10.94,0:10:11.86,Default,,0,0,0,,♪ Ана
Dialogue: 0,0:10:11.94,0:10:12.94,Default,,0,0,0,,Не?
Dialogue: 0,0:10:13.02,0:10:14.86,Default,,0,0,0,,♪ Бүгінгі кешке гарнирге не бар?
Dialogue: 0,0:10:14.94,0:10:16.86,Default,,0,0,0,,♪ Егер әлі айтпаған болсаңыз, сізге бірдеңе айтайын ба?
Dialogue: 0,0:10:16.94,0:10:18.99,Default,,0,0,0,,♪ Менің сүйікті көкөнісімді білесіз бе?
Dialogue: 0,0:10:19.07,0:10:21.82,Default,,0,0,0,,♪ Бұл қытай қырыққабаты, бок чай.
Dialogue: 0,0:10:21.91,0:10:24.20,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:10:24.29,0:10:25.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:26.04,0:10:29.42,Default,,0,0,0,,Екеуміздің де менің ырымыма жауап берер сөзіміз жоқ.
Dialogue: 0,0:10:29.50,0:10:30.67,Default,,0,0,0,,Керемет
Dialogue: 0,0:10:34.34,0:10:35.42,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:10:35.50,0:10:36.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:36.17,0:10:37.09,Default,,0,0,0,,♪ YO YO YO
Dialogue: 0,0:10:37.17,0:10:39.13,Default,,0,0,0,,♪ Қазірден басталатын сабақ – қоғамтану
Dialogue: 0,0:10:39.22,0:10:42.30,Default,,0,0,0,,♪ Бүгінгі оқулығыңыз бар ма?
Dialogue: 0,0:10:42.39,0:10:43.05,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:45.56,0:10:47.60,Default,,0,0,0,,♪ Менде бұл дұрыс. Сынақ аяқталуға жақын.
Dialogue: 0,0:10:47.68,0:10:49.52,Default,,0,0,0,,♪ Назарларыңызға ризамын.
Dialogue: 0,0:10:50.52,0:10:54.07,Default,,0,0,0,,Орындалды! байланыс
Dialogue: 0,0:10:54.15,0:10:56.61,Default,,0,0,0,,Енді біз бұрынғыдан да жақсы сөйлесе аламыз
Dialogue: 0,0:10:57.23,0:10:58.86,Default,,0,0,0,,Қандай керемет!
Dialogue: 0,0:10:59.57,0:11:00.32,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:02.95,0:11:05.95,Default,,0,0,0,,♪ Бүгін түскі ас қорабында не болады?
Dialogue: 0,0:11:06.04,0:11:08.16,Default,,0,0,0,,♪ Уайымдамаңыз, бұл әрқашан дәмді көрінеді
Dialogue: 0,0:11:08.25,0:11:09.37,Default,,0,0,0,,♪ Сізге көп рахмет
Dialogue: 0,0:11:09.46,0:11:11.37,Default,,0,0,0,,♪ Бізде де бүгін фрикаделькалар бар.
Dialogue: 0,0:11:11.46,0:11:13.96,Default,,0,0,0,,♪ Мен Райду-кунды білемін, жегің келе ме?
Dialogue: 0,0:11:14.04,0:11:16.71,Default,,0,0,0,,♪ Өтінемін, қате түсінбеңіз.
Dialogue: 0,0:11:16.80,0:11:18.80,Default,,0,0,0,,♪ I'm not aiming for anything in particular.
Dialogue: 0,0:11:18.88,0:11:20.42,Default,,0,0,0,,♪ Сонда бұл сізге қажет емес пе?
Dialogue: 0,0:11:20.51,0:11:22.13,Default,,0,0,0,,♪ Жоқ, мен оны жегім келеді.
Dialogue: 0,0:11:22.22,0:11:24.85,Default,,0,0,0,,♪ Олардың кез келгенін жеуге болады.
Dialogue: 0,0:11:24.93,0:11:27.81,Default,,0,0,0,,♪ Содан кейін сөзіңізді қабылдап, бәрін жеп қойыңыз
Dialogue: 0,0:11:27.89,0:11:30.56,Default,,0,0,0,,Мен неден қорықтым... мынау!
Dialogue: 0,0:11:31.52,0:11:33.35,Default,,0,0,0,,Еркін күрес!
Dialogue: 0,0:11:35.15,0:11:37.15,Default,,0,0,0,,♪ YO YO YO мен бәрін тоқтатамын.
Dialogue: 0,0:11:37.23,0:11:39.15,Default,,0,0,0,,♪ Аштықтан құлайсың.
Dialogue: 0,0:11:39.24,0:11:41.24,Default,,0,0,0,,♪ It's okay because I want to eat with you.
Dialogue: 0,0:11:41.32,0:11:43.41,Default,,0,0,0,,♪ Олай болса, оны алыңыз.
Dialogue: 0,0:11:43.49,0:11:45.53,Default,,0,0,0,,♪ Жегеніңіз үшін рахмет
Dialogue: 0,0:11:45.62,0:11:48.45,Default,,0,0,0,,♪ Жоқ, әрқашан дәмді
Dialogue: 0,0:11:48.95,0:11:52.96,Default,,0,0,0,,Бұл ұтыс ойыны.
Dialogue: 0,0:11:53.04,0:11:56.17,Default,,0,0,0,,Көңілді болды, қайталап көрейік
Dialogue: 0,0:11:56.25,0:11:57.42,Default,,0,0,0,,О
Dialogue: 0,0:11:57.50,0:12:00.88,Default,,0,0,0,,Let's echo each other's words into this microphone again.
Dialogue: 0,0:12:02.63,0:12:05.39,Default,,0,0,0,,It's against school rules to bring your own microphone.
Dialogue: 0,0:12:05.47,0:12:06.14,Default,,0,0,0,,Иә
Dialogue: 0,0:12:09.35,0:12:12.27,Default,,0,0,0,,Сіз микрофонсыз да рэп айта аласыз.
Dialogue: 0,0:12:12.77,0:12:13.48,Default,,0,0,0,,Иә
Dialogue: 0,0:12:14.35,0:12:15.98,Default,,0,0,0,,Ах~
Dialogue: 0,0:12:16.69,0:12:18.02,Default,,0,0,0,,♪ Мен Райдумын
Dialogue: 0,0:12:18.11,0:12:19.69,Default,,0,0,0,,Ум... аа~
Dialogue: 0,0:12:19.78,0:12:22.32,Default,,0,0,0,,♪ Мен қазір жүрмін.
Dialogue: 0,0:12:22.40,0:12:23.40,Default,,0,0,0,,Ал...
Dialogue: 0,0:12:23.49,0:12:25.53,Default,,0,0,0,,♪ Бұл... тротуар
Dialogue: 0,0:12:25.61,0:12:26.20,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:26.28,0:12:29.20,Default,,0,0,0,,♪ That's right, that's right, the sidewalk.
Dialogue: 0,0:12:29.29,0:12:32.08,Default,,0,0,0,,Мен... мен істедім! Дәл осылай болуы керек еді!
Dialogue: 0,0:12:32.16,0:12:34.50,Default,,0,0,0,,Микрофон маңызды емес пе?
Dialogue: 0,0:12:35.50,0:12:36.58,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:12:39.13,0:12:40.34,Default,,0,0,0,,I'm going
Dialogue: 0,0:12:40.42,0:12:42.55,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:43.26,0:12:44.76,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:12:45.55,0:12:48.43,Default,,0,0,0,,Кеше тым суық болды ма?
Dialogue: 0,0:12:48.51,0:12:49.72,Default,,0,0,0,,Тағы, тағы!
Dialogue: 0,0:12:50.60,0:12:52.98,Default,,0,0,0,,Рэп жақсы болмады, бірақ
Dialogue: 0,0:12:53.48,0:12:54.35,Default,,0,0,0,,Ахарен мырза кім?
Dialogue: 0,0:12:54.44,0:12:56.73,Default,,0,0,0,,We've been able to communicate for a while.
Dialogue: 0,0:12:56.81,0:12:57.90,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:12:57.98,0:12:58.86,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:12:58.94,0:12:59.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:59.52,0:13:01.82,Default,,0,0,0,,♪ Аға мен әпке, мен және сен
Dialogue: 0,0:13:01.90,0:13:03.94,Default,,0,0,0,,♪ Кешегі мен Тұз жауабы
Dialogue: 0,0:13:04.03,0:13:06.82,Default,,0,0,0,,♪ So as an apology, I'd like to give you this~
Dialogue: 0,0:13:06.91,0:13:08.62,Default,,0,0,0,,Не?
Dialogue: 0,0:13:09.16,0:13:10.20,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:13:10.28,0:13:13.37,Default,,0,0,0,,K... I bought it because I was playing it in class.
Dialogue: 0,0:13:13.45,0:13:15.71,Default,,0,0,0,,Шаршадым, саған беремін
Dialogue: 0,0:13:15.79,0:13:17.71,Default,,0,0,0,,Рахмет (Райдоу әпке) Уф-о!
Dialogue: 0,0:13:17.79,0:13:20.13,Default,,0,0,0,,Қол спиннер?
Dialogue: 0,0:13:21.42,0:13:23.92,Default,,0,0,0,,Иә... Мен әлі түсінбеймін.
Dialogue: 0,0:13:24.01,0:13:24.97,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:25.05,0:13:25.80,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:26.47,0:13:27.93,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:28.01,0:13:29.18,Default,,0,0,0,,Сіз осылай ойнайсыз
Dialogue: 0,0:13:30.64,0:13:31.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:32.47,0:13:33.72,Default,,0,0,0,,Оны сізге қарызға бергенімді қалайсыз ба?
Dialogue: 0,0:13:33.81,0:13:34.35,Default,,0,0,0,,Иә
Dialogue: 0,0:13:35.06,0:13:36.06,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:13:36.14,0:13:37.14,Default,,0,0,0,,Аяғын батпаққа тығып алып, осы жардан құлап кеткен бе? ➡
Dialogue: 0,0:13:37.23,0:13:39.77,Default,,0,0,0,,Сізге ұнайтын сияқты. Жақсы.
Dialogue: 0,0:13:40.86,0:13:41.98,Default,,0,0,0,,Оны үйге апаруға болады.
Dialogue: 0,0:13:43.07,0:13:43.73,Default,,0,0,0,,Иә
Dialogue: 0,0:13:46.49,0:13:49.16,Default,,0,0,0,,Бұл шынымен де қызықты ма?
Dialogue: 0,0:13:56.62,0:13:59.42,Default,,0,0,0,,«Окаши» - эмоцияны білдіретін сөз.
Dialogue: 0,0:13:59.50,0:14:01.00,Default,,0,0,0,,Бұл «Білемін»…
Dialogue: 0,0:14:01.09,0:14:02.38,Default,,0,0,0,,(қол спиннерінің айналмалы дыбысы)
Dialogue: 0,0:14:02.46,0:14:04.84,Default,,0,0,0,,Хэйан дәуіріндегі ең маңызды әйелдер әдебиеті...
Dialogue: 0,0:14:05.42,0:14:06.26,Default,,0,0,0,,Ах
Dialogue: 0,0:14:06.34,0:14:07.68,Default,,0,0,0,,Райду мырза
Dialogue: 0,0:14:07.76,0:14:11.14,Default,,0,0,0,,Сабақ үстінде жанымдағы Ахарен мырзаға қарап.
Dialogue: 0,0:14:11.22,0:14:12.68,Default,,0,0,0,,Қаншалықты жақын болсақ та,...
Dialogue: 0,0:14:15.98,0:14:18.10,Default,,0,0,0,,Не? Сол техника
Dialogue: 0,0:14:18.98,0:14:21.06,Default,,0,0,0,,Ағынды үздіксіз техника
Dialogue: 0,0:14:21.15,0:14:22.65,Default,,0,0,0,,Мен сенен көзімді ала алмаймын!
Dialogue: 0,0:14:23.36,0:14:24.15,Default,,0,0,0,,Ах
Dialogue: 0,0:14:24.23,0:14:26.69,Default,,0,0,0,,Жоқ, бұл таңданатын уақыт емес.
Dialogue: 0,0:14:26.78,0:14:30.03,Default,,0,0,0,,Ахарен мырза, сабақ кезінде тоқтауыңыз керек.
Dialogue: 0,0:14:30.11,0:14:31.24,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:31.32,0:14:34.29,Default,,0,0,0,,Түсінбегенімді жайлап үйретіп жатырсың.
Dialogue: 0,0:14:34.37,0:14:36.37,Default,,0,0,0,,Ахарен мырзаны ұятқа қалдырмаңыз
Dialogue: 0,0:14:36.45,0:14:39.58,Default,,0,0,0,,Айналаңыздағылар байқамауы үшін...
Dialogue: 0,0:14:39.67,0:14:41.54,Default,,0,0,0,,Қандай мейірімділік!
Dialogue: 0,0:14:41.63,0:14:42.71,Default,,0,0,0,,Аһ!
Dialogue: 0,0:14:42.79,0:14:44.71,Default,,0,0,0,,Мен білгім келеді...
Dialogue: 0,0:14:44.80,0:14:47.46,Default,,0,0,0,,Момохара мырза, жақсысыз ба?
Dialogue: 0,0:14:50.76,0:14:52.30,Default,,0,0,0,,(Айналмалы қол спиннерінің дыбысы)
Dialogue: 0,0:14:52.39,0:14:52.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:55.18,0:14:58.43,Default,,0,0,0,,Ахарен мырза, жүру қауіпті.
Dialogue: 0,0:14:59.14,0:15:01.15,Default,,0,0,0,,Мен оны бейсана айналдырдым.
Dialogue: 0,0:15:01.23,0:15:03.06,Default,,0,0,0,,Бұл не қорқынышты?
Dialogue: 0,0:15:03.15,0:15:06.03,Default,,0,0,0,,Бұл өте дәмді емес пе? (Әйел Б) Мынау да дәмді.
Dialogue: 0,0:15:09.15,0:15:10.11,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:15:14.12,0:15:15.95,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:15:16.04,0:15:20.16,Default,,0,0,0,,А... Ахарен мырза, бұл сәл артық емес пе?
Dialogue: 0,0:15:27.30,0:15:28.96,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:15:30.22,0:15:30.88,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:34.35,0:15:38.77,Default,,0,0,0,,Мен толығымен тәуелдімін. Мен бұл туралы тез арада бірдеңе істеуім керек.
Dialogue: 0,0:15:40.43,0:15:43.40,Default,,0,0,0,,Мен Ахарен мырзаның болашағына алаңдаймын...
Dialogue: 0,0:15:45.11,0:15:49.19,Default,,0,0,0,,Бірақ егер сіз кенеттен бір нәрсені алсаңыз, соншалықты тәуелді болсаңыз ...
Dialogue: 0,0:15:55.37,0:15:57.99,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:16:02.75,0:16:03.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:04.54,0:16:05.54,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:16:06.17,0:16:08.34,Default,,0,0,0,,Мен жеткілікті айналдым, сондықтан мен оны қайтарамын.
Dialogue: 0,0:16:09.17,0:16:09.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:11.55,0:16:15.26,Default,,0,0,0,,Оны айналдырып көрдіңіз, бірақ оның қаншалықты қызықты екенін түсінбедіңіз бе?
Dialogue: 0,0:16:15.34,0:16:15.93,Default,,0,0,0,,Иә
Dialogue: 0,0:16:16.01,0:16:18.81,Default,,0,0,0,,Иә Иә Жақсы Иә
Dialogue: 0,0:16:19.47,0:16:21.18,Default,,0,0,0,,Сонда да бұл техника...
Dialogue: 0,0:16:22.77,0:16:24.02,Default,,0,0,0,,Мұны қалай жасаймыз?
Dialogue: 0,0:16:27.69,0:16:28.73,Default,,0,0,0,,Иә
Dialogue: 0,0:16:30.69,0:16:33.95,Default,,0,0,0,,Ағай, бұл аздап артық емес пе?
Dialogue: 0,0:16:35.11,0:16:38.78,Default,,0,0,0,,Салқын самал ағаштарды сыбдырлайды
Dialogue: 0,0:16:39.45,0:16:41.45,Default,,0,0,0,,Саябақ тыныш және әдемі.
Dialogue: 0,0:16:42.41,0:16:45.96,Default,,0,0,0,,Мен соңғы кездері спиннерді жиі қолданып жүрмін, шаршадым.
Dialogue: 0,0:16:46.04,0:16:47.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:47.58,0:16:50.38,Default,,0,0,0,,Қаһарлы аң! Неге мұндай жерде...
Dialogue: 0,0:16:50.96,0:16:52.55,Default,,0,0,0,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:16:52.63,0:16:54.88,Default,,0,0,0,,Қашып кеткен аң ашулы.
Dialogue: 0,0:16:55.47,0:16:57.34,Default,,0,0,0,,Сіз бізге шабуыл жасамақшысыз ба?
Dialogue: 0,0:16:57.93,0:17:00.81,Default,,0,0,0,,Сіз одан көзіңізді алсаңыз, ол міндетті түрде сізге шабуыл жасайды.
Dialogue: 0,0:17:01.52,0:17:03.31,Default,,0,0,0,,Ешқашан бұрылмаңыз.
Dialogue: 0,0:17:03.85,0:17:05.35,Default,,0,0,0,,（）
Dialogue: 0,0:17:05.44,0:17:07.48,Default,,0,0,0,,Кешіріңіз (ит үреді)
Dialogue: 0,0:17:07.56,0:17:09.40,Default,,0,0,0,,Мен байқаусызда жетекшіні жіберіп алдым.
Dialogue: 0,0:17:09.48,0:17:12.82,Default,,0,0,0,,Мына бала бұзық екен, хаха
Dialogue: 0,0:17:13.99,0:17:14.49,Default,,0,0,0,,Ах
Dialogue: 0,0:17:14.57,0:17:16.03,Default,,0,0,0,,Дағдарыс аяқталды
Dialogue: 0,0:17:16.78,0:17:19.41,Default,,0,0,0,,Ахарен мырза, сіз қазір сенімді бола аласыз.
Dialogue: 0,0:17:19.49,0:17:21.95,Default,,0,0,0,,Ха, тағы бір аң!
Dialogue: 0,0:17:22.04,0:17:25.29,Default,,0,0,0,,Ахарен мырза да қорқыныштан қозғала алмайды.
Dialogue: 0,0:17:25.37,0:17:27.21,Default,,0,0,0,,Мен сізге мұнда көмектесуім керек.
Dialogue: 0,0:17:27.29,0:17:28.33,Default,,0,0,0,,Ha
Dialogue: 0,0:17:28.42,0:17:31.63,Default,,0,0,0,,Бұл жергілікті тұрғындардың жауынгерлік айқайы.
Dialogue: 0,0:17:32.46,0:17:34.88,Default,,0,0,0,,Сіздің территорияңыздағы зиянкестерге шабуыл жасау үшін?
Dialogue: 0,0:17:34.97,0:17:38.47,Default,,0,0,0,,Идиллиялық емес, бұл жабайы патшалық!
Dialogue: 0,0:17:38.55,0:17:40.68,Default,,0,0,0,,♬~
Dialogue: 0,0:17:40.76,0:17:42.22,Default,,0,0,0,,Мен ең жақсымын!
Dialogue: 0,0:17:42.31,0:17:43.81,Default,,0,0,0,,Аккун, өте жаман!
Dialogue: 0,0:17:43.89,0:17:44.89,Default,,0,0,0,,оның қан тамырларының қабырғаларынан шығып келе жатқанын—
Dialogue: 0,0:17:44.98,0:17:46.14,Default,,0,0,0,,Сабыр ет, мен!
Dialogue: 0,0:17:46.23,0:17:48.81,Default,,0,0,0,,Бұл бала, бірақ жеткілікті ұрыс...
Dialogue: 0,0:17:48.90,0:17:50.73,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:17:50.81,0:17:52.82,Default,,0,0,0,,Не болды? Ахарен мырза
Dialogue: 0,0:17:52.90,0:17:54.40,Default,,0,0,0,,Ах! (Ұлдар) Ой!
Dialogue: 0,0:17:54.49,0:17:55.94,Default,,0,0,0,,Патша Аха!
Dialogue: 0,0:17:56.03,0:17:57.70,Default,,0,0,0,,Ахарен мырза, сіз білесіз бе?
Dialogue: 0,0:17:57.78,0:17:58.28,Default,,0,0,0,,Иә
Dialogue: 0,0:17:58.36,0:18:00.57,Default,,0,0,0,,Бұл патша Аха ғой!
Dialogue: 0,0:18:00.66,0:18:01.74,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:02.33,0:18:04.70,Default,,0,0,0,,Алдыңғы қол спиннер
Dialogue: 0,0:18:05.29,0:18:09.00,Default,,0,0,0,,Мен саябақта осымен айналысқанда үлкен құрметке ие болдым.
Dialogue: 0,0:18:09.92,0:18:12.63,Default,,0,0,0,,Маған табынатыны сондықтан
Dialogue: 0,0:18:12.71,0:18:14.25,Default,,0,0,0,,Патша! (Ұлдар) Патша!
Dialogue: 0,0:18:14.34,0:18:16.01,Default,,0,0,0,,Сондықтан ол «патша»
Dialogue: 0,0:18:16.09,0:18:19.34,Default,,0,0,0,,Патша! Бүгін бізге қандай трюктар көрсетесіз?
Dialogue: 0,0:18:19.43,0:18:21.10,Default,,0,0,0,,Патша! патша! Эй, эй!
Dialogue: 0,0:18:21.64,0:18:23.31,Default,,0,0,0,,Ахарен мырза қиындыққа тап болды.
Dialogue: 0,0:18:23.81,0:18:25.39,Default,,0,0,0,,Мен көмектесуім керек!
Dialogue: 0,0:18:25.47,0:18:28.81,Default,,0,0,0,,Балалар, сәл үндемей тұрыңдар.
Dialogue: 0,0:18:28.89,0:18:31.31,Default,,0,0,0,,Ахарен мырза қиындыққа тап болды емес пе?
Dialogue: 0,0:18:31.40,0:18:32.82,Default,,0,0,0,,Жарайды, шештім.
Dialogue: 0,0:18:33.40,0:18:34.73,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:18:34.82,0:18:36.57,Default,,0,0,0,,Сіз патшаның жаңа шәкіртісіз бе?
Dialogue: 0,0:18:36.65,0:18:38.40,Default,,0,0,0,,Біз ең жақсы шәкіртпіз.
Dialogue: 0,0:18:38.49,0:18:39.99,Default,,0,0,0,,Сонда сіздің мәртебеңіз төмен?
Dialogue: 0,0:18:40.07,0:18:41.57,Default,,0,0,0,,Маған шырын сатып алыңыз.
Dialogue: 0,0:18:42.28,0:18:44.49,Default,,0,0,0,,Қазіргі балалар қорқынышты
Dialogue: 0,0:18:45.37,0:18:46.41,Default,,0,0,0,,Сәлем! иә?
Dialogue: 0,0:18:46.50,0:18:48.87,Default,,0,0,0,,Аккунс, тоқтат!
Dialogue: 0,0:18:48.96,0:18:50.87,Default,,0,0,0,,Футаба!
Dialogue: 0,0:18:50.96,0:18:52.58,Default,,0,0,0,,Оның саған еш қатысы жоқ.
Dialogue: 0,0:18:52.67,0:18:53.79,Default,,0,0,0,,Кет!
Dialogue: 0,0:18:53.88,0:18:57.13,Default,,0,0,0,,Бала күнгі дос ретінде саған қамқор болу менің міндетім!
Dialogue: 0,0:18:57.21,0:18:58.09,Default,,0,0,0,,Қамқорлық дегеніміз не?
Dialogue: 0,0:18:58.17,0:19:01.05,Default,,0,0,0,,Неге екенін білмеймін, бірақ маған көмектесті
Dialogue: 0,0:19:01.14,0:19:04.26,Default,,0,0,0,,Мынау да, мынау да жаман...
Dialogue: 0,0:19:04.89,0:19:07.02,Default,,0,0,0,,Аваны өзіңізбен бірге алыңыз! Бұл сенің кінәң
Dialogue: 0,0:19:07.10,0:19:09.23,Default,,0,0,0,,Бұл көмектеспейді, солай емес пе?
Dialogue: 0,0:19:09.31,0:19:11.94,Default,,0,0,0,,Ақкунды сол әйел азғырып жатыр!
Dialogue: 0,0:19:12.02,0:19:13.11,Default,,0,0,0,,Түсінбейсің бе?
Dialogue: 0,0:19:13.19,0:19:15.57,Default,,0,0,0,,Иә? Патша мұны жасамас еді!
Dialogue: 0,0:19:15.65,0:19:16.57,Default,,0,0,0,,Мен істеп жатырмын!
Dialogue: 0,0:19:17.15,0:19:18.49,Default,,0,0,0,,Балалар, тоқтаңдар!
Dialogue: 0,0:19:18.57,0:19:19.53,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:19.61,0:19:21.82,Default,,0,0,0,,Қауіпсіздік сигналы естіледі!
Dialogue: 0,0:19:21.91,0:19:22.74,Default,,0,0,0,,Иә, кешіріңіз
Dialogue: 0,0:19:22.82,0:19:25.91,Default,,0,0,0,,Аваны өзіңізбен бірге алыңыз! Менімен жарыс!
Dialogue: 0,0:19:28.54,0:19:30.46,Default,,0,0,0,,Менімен реверси ойнаңыз
Dialogue: 0,0:19:30.54,0:19:32.92,Default,,0,0,0,,Мен жеңсем, Ақкүннен өзіңді алып таста.
Dialogue: 0,0:19:36.21,0:19:39.30,Default,,0,0,0,,Жаман сөз айтпа. Айтпа.
Dialogue: 0,0:19:39.38,0:19:41.22,Default,,0,0,0,,Сен кімсің, шәкіртім?
Dialogue: 0,0:19:41.30,0:19:42.59,Default,,0,0,0,,Мен хабарлаймын.
Dialogue: 0,0:19:42.68,0:19:43.84,Default,,0,0,0,,Біз оларды қашып құтылуға ешқашан жол бермейміз
Dialogue: 0,0:19:43.93,0:19:45.89,Default,,0,0,0,,Сіз оны жақсы меңгергеніңіз оның дұрыс емес екенін білдірмейді!
Dialogue: 0,0:19:45.97,0:19:47.31,Default,,0,0,0,,Сендер тым шулысыңдар.
Dialogue: 0,0:19:47.39,0:19:48.39,Default,,0,0,0,,
Dialogue: 0,0:19:48.47,0:19:49.47,Default,,0,0,0,,Сіз?
Dialogue: 0,0:19:49.56,0:19:53.19,Default,,0,0,0,,Ахарен-санмен жарысқыңыз келсе, мені жеңгеннен кейін жасаңыз.
Dialogue: 0,0:19:53.27,0:19:54.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:55.23,0:19:57.15,Default,,0,0,0,,Саған шәкірт болудан басқа амалым жоқ.
Dialogue: 0,0:19:57.23,0:19:59.48,Default,,0,0,0,,Онда сен, қара, бірінші жүр.
Dialogue: 0,0:19:59.57,0:20:00.11,Default,,0,0,0,,О
Dialogue: 0,0:20:00.19,0:20:02.24,Default,,0,0,0,,Мен мұнда ересек адаммын.
Dialogue: 0,0:20:02.32,0:20:04.82,Default,,0,0,0,,Мен саған дүниенің қаншалықты қатал екенін көрсетуім керек!
Dialogue: 0,0:20:07.95,0:20:10.29,Default,,0,0,0,,Не? Тіпті аузыңа да жақын емес.
Dialogue: 0,0:20:10.37,0:20:13.37,Default,,0,0,0,,Қазіргі балалардың реверсистік дағдылары күшті, солай ма?
Dialogue: 0,0:20:14.17,0:20:15.04,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:20:15.13,0:20:18.00,Default,,0,0,0,,Зұлымдықтың басы ақыры пайда болды.
Dialogue: 0,0:20:19.30,0:20:22.72,Default,,0,0,0,,Шынайысың ба, Ахарен-сан, сен менің жауымсың ба?
Dialogue: 0,0:20:29.81,0:20:33.48,Default,,0,0,0,,Міне... Ахарен мырза реверсиде жеңілді!
Dialogue: 0,0:20:33.56,0:20:35.27,Default,,0,0,0,,Мен әдейі жеңілдім
Dialogue: 0,0:20:35.77,0:20:38.69,Default,,0,0,0,,Бұл сізді кері шегінуге мәжбүр етеді деп ойладым.
Dialogue: 0,0:20:38.77,0:20:41.61,Default,,0,0,0,,Райду-кун, сен де жеңілдің, солай ма?
Dialogue: 0,0:20:41.69,0:20:44.11,Default,,0,0,0,,А... а, әрине.
Dialogue: 0,0:20:44.20,0:20:46.49,Default,,0,0,0,,Балаға байыпты қарауға болмайды.
Dialogue: 0,0:20:46.57,0:20:48.45,Default,,0,0,0,,Сендер, тоқтаңдар.
Dialogue: 0,0:20:49.03,0:20:52.45,Default,,0,0,0,,Бұл тұрарлық емес. Мен жеңемін!
Dialogue: 0,0:20:52.54,0:20:55.62,Default,,0,0,0,,Олай болса, уәде еткендей, өзіңді Ақкүннен алып таста.
Dialogue: 0,0:20:55.71,0:20:57.79,Default,,0,0,0,,Патша әдейі жеңіліп қалды.
Dialogue: 0,0:20:57.88,0:20:59.09,Default,,0,0,0,,Оны көргенде түсінесіз.
Dialogue: 0,0:20:59.17,0:21:00.75,Default,,0,0,0,,Не...не!
Dialogue: 0,0:21:00.84,0:21:02.38,Default,,0,0,0,,Мұқият ойлан
Dialogue: 0,0:21:02.46,0:21:05.43,Default,,0,0,0,,Егер бәрі алынған болса, ешкім ұтылмас еді!
Dialogue: 0,0:21:05.51,0:21:06.34,Default,,0,0,0,,Уф! Уау
Dialogue: 0,0:21:06.43,0:21:10.35,Default,,0,0,0,,Менімен үнемі араласып жүргенің несі? Үйге бар!
Dialogue: 0,0:21:10.43,0:21:11.85,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:21:11.93,0:21:14.31,Default,,0,0,0,,Артқа қайт! Қайтып келу!
Dialogue: 0,0:21:14.89,0:21:15.77,Default,,0,0,0,,Ах
Dialogue: 0,0:21:15.85,0:21:18.44,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:18.52,0:21:22.15,Default,,0,0,0,,Ақкун, ақымақ! Мен енді білмеймін!
Dialogue: 0,0:21:22.82,0:21:24.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:24.70,0:21:25.45,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:21:25.53,0:21:26.57,Default,,0,0,0,,Патша: Ақырында...
Dialogue: 0,0:21:26.66,0:21:27.28,Default,,0,0,0,,Уф
Dialogue: 0,0:21:28.82,0:21:29.49,Default,,0,0,0,,Король?
Dialogue: 0,0:21:29.57,0:21:31.66,Default,,0,0,0,,Үйге бару тым көп
Dialogue: 0,0:21:31.74,0:21:35.25,Default,,0,0,0,,Сол қызға... барып Футаба-чаннан кешірім сұра.
Dialogue: 0,0:21:35.33,0:21:36.71,Default,,0,0,0,,Бірақ... Бірақ...
Dialogue: 0,0:21:37.54,0:21:39.88,Default,,0,0,0,,Сіз бұл жаман болды деп ойлайсыз, солай ма?
Dialogue: 0,0:21:39.96,0:21:40.84,Default,,0,0,0,,Иә
Dialogue: 0,0:21:40.92,0:21:42.55,Default,,0,0,0,,Онда кешірім сұрауға болады.
Dialogue: 0,0:21:42.63,0:21:43.46,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:21:44.05,0:21:45.80,Default,,0,0,0,,Ой... Мен кешірім сұраймын.
Dialogue: 0,0:21:51.22,0:21:54.39,Default,,0,0,0,,Бәрі жақсы болды, онда үйге қайтайық.
Dialogue: 0,0:21:54.47,0:21:55.43,Default,,0,0,0,,Аа...
Dialogue: 0,0:21:56.02,0:21:57.10,Default,,0,0,0,,Ахарен мырза!
Dialogue: 0,0:21:57.85,0:22:00.98,Default,,0,0,0,,Көп нәрсе болды, мен шаршадым.
Dialogue: 0,0:22:01.98,0:22:03.98,Default,,0,0,0,,♪~
Dialogue: 0,0:23:27.82,0:23:29.82,Default,,0,0,0,,~♪
Dialogue: 0,0:23:32.49,0:23:34.53,Default,,0,0,0,,Амансың ба? Үйге бара аласың ба?
Dialogue: 0,0:23:34.62,0:23:35.12,Default,,0,0,0,,Иә
Dialogue: 0,0:23:36.28,0:23:37.08,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:23:38.91,0:23:39.58,Default,,0,0,0,,Ha
Dialogue: 0,0:23:40.54,0:23:41.54,Default,,0,0,0,,Үлкен аң!
Dialogue: 0,0:23:41.62,0:23:44.00,Default,,0,0,0,,Нуи менің итім
Dialogue: 0,0:23:44.08,0:23:45.17,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:23:46.75,0:23:47.46,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:23:47.55,0:23:48.51,Default,,0,0,0,,Иә
Dialogue: 0,0:23:49.21,0:23:50.97,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:23:52.05,0:23:56.14,Default,,0,0,0,,Ахарен мырза, сізде патшаның стилі бар, солай емес пе?
Dialogue: 0,0:24:00.31,0:24:03.56,Default,,0,0,0,,Бауырым, соңғы кездері жеңіл тамақ ішкен жоқсың ба?
Dialogue: 0,0:24:03.65,0:24:07.19,Default,,0,0,0,,Тамақ жеу салмақ қосады, сондықтан оны тоқтату керек.
Dialogue: 0,0:24:07.27,0:24:09.53,Default,,0,0,0,,Жоқ, мен емес...
Dialogue: 0,0:24:09.61,0:24:11.57,Default,,0,0,0,,Менен сұраңыз, әпке.
Dialogue: 0,0:24:11.65,0:24:14.36,Default,,0,0,0,,Мен қазір диетаны оқып жатырмын.
Dialogue: 0,0:24:14.45,0:24:16.28,Default,,0,0,0,,Аа, менің ес-түсім бар.
Dialogue: 0,0:24:17.03,0:24:20.62,Default,,0,0,0,,Мен қазір диетаға тәуелді досыма көмектесіп жатырмын.
Dialogue: 0,0:24:20.70,0:24:21.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:22.46,0:24:23.37,Default,,0,0,0,,Келесі жолы…
Dialogue: 0,0:24:23.46,0:24:25.46,Default,,0,0,0,,«Сен тым семіз емессің бе?»
Dialogue: 0,0:24:26.96,0:24:32.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory