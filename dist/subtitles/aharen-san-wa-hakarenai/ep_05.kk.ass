Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.92,0:00:08.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:09.38,0:00:10.21,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:11.38,0:00:13.47,Default,,0,0,0,,...
Dialogue: 0,0:00:13.55,0:00:15.34,Default,,0,0,0,,Бұл... ауырады, ауырады
Dialogue: 0,0:00:15.43,0:00:16.76,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:00:16.85,0:00:17.93,Default,,0,0,0,,Аха Рен-сан
Dialogue: 0,0:00:18.01,0:00:19.14,Default,,0,0,0,,Ах... хмм
Dialogue: 0,0:00:19.64,0:00:20.81,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:21.39,0:00:23.98,Default,,0,0,0,,Не істеп жатырсың сонша ессіз?
Dialogue: 0,0:00:24.94,0:00:25.69,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:25.77,0:00:26.48,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:28.65,0:00:31.03,Default,,0,0,0,,Құбыжықты ұстау және жаттықтыру ойыны
Dialogue: 0,0:00:31.11,0:00:33.03,Default,,0,0,0,,Әдетте «Хок сызығы» ретінде белгілі
Dialogue: 0,0:00:33.90,0:00:38.99,Default,,0,0,0,,Ол бірнеше жыл бұрын өте танымал болды және көптеген адамдар әлі де солай істейді...\NМен жақында
Dialogue: 0,0:00:39.66,0:00:44.58,Default,,0,0,0,,орындалып жатқанын білдім, мен оны бастаған кезде мен іліндім.
Dialogue: 0,0:00:45.17,0:00:46.42,Default,,0,0,0,,Я~
Dialogue: 0,0:00:46.50,0:00:48.21,Default,,0,0,0,,Мен жақында білдім...
Dialogue: 0,0:00:49.63,0:00:52.96,Default,,0,0,0,,Сәл сәннен шығып кеткен жоқ па?
Dialogue: 0,0:00:54.05,0:00:56.05,Default,,0,0,0,,♪~
Dialogue: 0,0:02:20.68,0:02:22.68,Default,,0,0,0,,~♪
Dialogue: 0,0:02:26.47,0:02:27.85,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:02:27.93,0:02:30.65,Default,,0,0,0,,Мен оны бұрын да ойнадым, сондықтан менде құбыжық бар.
Dialogue: 0,0:02:31.23,0:02:33.19,Default,,0,0,0,,Неге біз бір-бірімізге қарсы ойнамаймыз?
Dialogue: 0,0:02:33.86,0:02:36.23,Default,,0,0,0,,Бұл менің бірінші рет жарысқа қатысуым...
Dialogue: 0,0:02:36.32,0:02:39.24,Default,,0,0,0,,Жарайды, мен де сені көрмегелі біраз болды.
Dialogue: 0,0:02:39.32,0:02:39.99,Default,,0,0,0,,Иә
Dialogue: 0,0:02:40.57,0:02:41.66,Default,,0,0,0,,Олай болса бастайық
Dialogue: 0,0:02:42.53,0:02:43.95,Default,,0,0,0,,Менің құбыжық...
Dialogue: 0,0:02:46.20,0:02:48.83,Default,,0,0,0,,(Янкирас жылайды)
Dialogue: 0,0:02:48.91,0:02:51.08,Default,,0,0,0,,Мұқият таңдалған
Dialogue: 0,0:02:51.17,0:02:55.04,Default,,0,0,0,,Мен өсірген 7V арманым Янкирас!
Dialogue: 0,0:02:55.13,0:02:57.71,Default,,0,0,0,,Екінші жағынан, Ахарен мырзаның құбыжығы...
Dialogue: 0,0:03:04.68,0:03:08.14,Default,,0,0,0,,А... Жарайды ма?
Dialogue: 0,0:03:08.22,0:03:08.98,Default,,0,0,0,,Иә
Dialogue: 0,0:03:09.68,0:03:10.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:10.81,0:03:13.27,Default,,0,0,0,,Ахарен мырза, біз енді ғана бастадық.
Dialogue: 0,0:03:13.35,0:03:15.73,Default,,0,0,0,,Менде күшті құбыжықтар жоқ.
Dialogue: 0,0:03:15.82,0:03:17.19,Default,,0,0,0,,Ол жоғалды.
Dialogue: 0,0:03:17.28,0:03:20.70,Default,,0,0,0,,Бірақ бұл сол Ахарен-санға қарсы жеңіске жету мүмкіндігі.
Dialogue: 0,0:03:21.20,0:03:23.03,Default,,0,0,0,,Сондай-ақ, бұрыштарды кесу дөрекі.
Dialogue: 0,0:03:23.78,0:03:26.58,Default,,0,0,0,,Жарайды, аға ретінде мен мұнда мейірімді боламын.
Dialogue: 0,0:03:27.08,0:03:29.79,Default,,0,0,0,,Сен қиналмас үшін мен сені бір соққымен өлтіремін.
Dialogue: 0,0:03:31.37,0:03:32.75,Default,,0,0,0,,Шайқас басталады!
Dialogue: 0,0:03:32.83,0:03:35.42,Default,,0,0,0,,Менен жоғары жылдамдықпен шабуыл!
Dialogue: 0,0:03:37.50,0:03:39.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:39.13,0:03:40.88,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:43.47,0:03:47.26,Default,,0,0,0,,Иә! Ақыры Ахарен мырзаны жеңдім... Иә?
Dialogue: 0,0:03:48.60,0:03:50.52,Default,,0,0,0,,Шыдадым! неге?
Dialogue: 0,0:03:50.60,0:03:51.89,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:51.98,0:03:55.48,Default,,0,0,0,,1 соққы нүктесі бар бір өлімге әкелетін жарақатқа төтеп бере алатын жабдық.
Dialogue: 0,0:03:55.98,0:03:58.15,Default,,0,0,0,,Менің ойымша, бұл әсермен ...
Dialogue: 0,0:03:58.65,0:04:01.95,Default,,0,0,0,,Менің шабуылыма жақсы қарсы тұрдың, бірақ...
Dialogue: 0,0:04:06.12,0:04:08.79,Default,,0,0,0,,Мұндай төмен деңгейдегі құбыжықтардың шабуылдары
Dialogue: 0,0:04:08.87,0:04:12.83,Default,,0,0,0,,Янкирас барлық құбыжықтардың ішіндегі ең төзімдісі.
Dialogue: 0,0:04:12.91,0:04:14.25,Default,,0,0,0,,Неліктен ол жұмыс істейді...
Dialogue: 0,0:04:14.33,0:04:17.50,Default,,0,0,0,,(Янкирасудың айқайы)
Dialogue: 0,0:04:18.84,0:04:20.76,Default,,0,0,0,,Бұл өте көп зиян, солай емес пе?
Dialogue: 0,0:04:20.84,0:04:22.13,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:22.88,0:04:23.63,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:04:23.72,0:04:26.18,Default,,0,0,0,,Ағымдағы техника қарсыластың соққы нүктелерін пайдаланады және
Dialogue: 0,0:04:26.26,0:04:28.97,Default,,0,0,0,,Сіздің соққы ұпайларыңызды бірдей ететін әдіс!
Dialogue: 0,0:04:29.64,0:04:32.81,Default,,0,0,0,,Ахарен мырза күткендей, сіз осы уақытқа дейін жақсы күрестіңіз.
Dialogue: 0,0:04:33.43,0:04:34.81,Default,,0,0,0,,Бірақ келесі кезек
Dialogue: 0,0:04:34.89,0:04:39.44,Default,,0,0,0,,Менің жылдамырақ құбыжық алдымен шабуыл жасайды және бұл аяқталды.
Dialogue: 0,0:04:39.52,0:04:42.57,Default,,0,0,0,,Ахарен мырзаны жеңетін уақыт келді!
Dialogue: 0,0:04:42.65,0:04:44.45,Default,,0,0,0,,2-ші айналым Бастау!
Dialogue: 0,0:04:44.53,0:04:46.70,Default,,0,0,0,,Енді, жүр, Янкирас!
Dialogue: 0,0:04:46.78,0:04:48.62,Default,,0,0,0,,Бұл жолы бір соққымен...
Dialogue: 0,0:04:49.28,0:04:51.58,Default,,0,0,0,,Не? Не? Неліктен?
Dialogue: 0,0:04:51.66,0:04:52.91,Default,,0,0,0,,О, күте тұр... күте тұр...
Dialogue: 0,0:04:54.54,0:04:59.71,Default,,0,0,0,,(Янкирасудың айқайы)
Dialogue: 0,0:04:59.79,0:05:01.67,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:05:01.75,0:05:03.46,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:05:04.17,0:05:06.93,Default,,0,0,0,,Неліктен? Неліктен бірінші шабуыл жасалды?
Dialogue: 0,0:05:08.26,0:05:13.52,Default,,0,0,0,,Ха, түсіндім. Қазіргі техника, сөзсіз, бірінші шабуыл әдісі.
Dialogue: 0,0:05:14.10,0:05:18.35,Default,,0,0,0,,Үлкен шымшудағы жағдайды тез өзгертетін алтын өрнек.
Dialogue: 0,0:05:18.44,0:05:23.36,Default,,0,0,0,,Мұның бәрі Ахарен мырзаның тұзағы болды.
Dialogue: 0,0:05:24.65,0:05:27.57,Default,,0,0,0,,Оны Ахарен мырза жоспарлаған!
Dialogue: 0,0:05:29.53,0:05:32.37,Default,,0,0,0,,Ахарен мырза, мен оны өлшей алмаймын.
Dialogue: 0,0:05:32.45,0:05:34.33,Default,,0,0,0,,Мен мұны қайта жасағым келеді
Dialogue: 0,0:05:34.83,0:05:37.62,Default,,0,0,0,,Не? Жоқ, бұл...
Dialogue: 0,0:05:38.12,0:05:40.46,Default,,0,0,0,,Кешіріңіз, бұл жеткілікті.
Dialogue: 0,0:05:45.17,0:05:46.05,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:05:49.22,0:05:52.64,Default,,0,0,0,,Кешіріңіз, мен жуынатын бөлмеге бір сәт тоқтай аламын ба?
Dialogue: 0,0:05:55.73,0:05:57.48,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:57.56,0:05:58.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.19,0:06:06.82,Default,,0,0,0,,Міне болды! Аккунның сүйікті құбыжығы
Dialogue: 0,0:06:06.90,0:06:09.45,Default,,0,0,0,,Мұны туған күніне сыйлық ретінде беріңіз
Dialogue: 0,0:06:09.53,0:06:12.49,Default,,0,0,0,,Мен Ақкунның жүрегін алдым!
Dialogue: 0,0:06:13.74,0:06:14.74,Default,,0,0,0,,Иә? Алақай!
Dialogue: 0,0:06:16.04,0:06:17.33,Default,,0,0,0,,Менен Ақкун
Dialogue: 0,0:06:17.41,0:06:20.79,Default,,0,0,0,,Ұрлық жасауға тырысқан зұлым шотакон әйел!
Dialogue: 0,0:06:21.42,0:06:24.38,Default,,0,0,0,,Ал, мен қазір бос емеспін.
Dialogue: 0,0:06:25.30,0:06:29.47,Default,,0,0,0,,О, бұл? Мен сені қалағандай емес.
Dialogue: 0,0:06:29.55,0:06:30.97,Default,,0,0,0,,Оны біреуге беріңіз.
Dialogue: 0,0:06:31.05,0:06:33.14,Default,,0,0,0,,Қалыпты сатып алсаңыз, қымбат.
Dialogue: 0,0:06:33.22,0:06:36.10,Default,,0,0,0,,Ең нашар жағдайда, сіз оны шамамен 500 иенге аласыз.
Dialogue: 0,0:06:36.18,0:06:38.94,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен ақылдымын, солай ма?
Dialogue: 0,0:06:39.60,0:06:41.19,Default,,0,0,0,,Жарайды, қараңызшы.
Dialogue: 0,0:06:41.27,0:06:44.27,Default,,0,0,0,,Менің тамаша техникам!
Dialogue: 0,0:06:46.90,0:06:47.65,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:48.49,0:06:49.15,Default,,0,0,0,,Ах
Dialogue: 0,0:06:49.24,0:06:50.36,Default,,0,0,0,,Уф
Dialogue: 0,0:06:51.11,0:06:51.66,Default,,0,0,0,,Уф
Dialogue: 0,0:06:52.41,0:06:53.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:53.99,0:06:55.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:55.91,0:06:59.29,Default,,0,0,0,,Уф, бұлай болмауы керек...
Dialogue: 0,0:06:59.37,0:07:02.54,Default,,0,0,0,,Бұл алаяқтық, хабарлаңыз! Хабарлаңыз!
Dialogue: 0,0:07:02.63,0:07:05.50,Default,,0,0,0,,Тұтынушылар орталығы!
Dialogue: 0,0:07:05.59,0:07:08.21,Default,,0,0,0,,Иә? Ава әкел!
Dialogue: 0,0:07:08.30,0:07:11.01,Default,,0,0,0,,Кіріңіз!
Dialogue: 0,0:07:11.09,0:07:11.93,Default,,0,0,0,,Иә?Уф
Dialogue: 0,0:07:12.01,0:07:14.68,Default,,0,0,0,,«Маған қара» деген көзқарастың мәні неде?
Dialogue: 0,0:07:14.76,0:07:17.39,Default,,0,0,0,,Ал сіз кенеттен 500 иен салдыңыз ба?
Dialogue: 0,0:07:17.47,0:07:21.14,Default,,0,0,0,,Қаржылық күш-қуатыңызды көрсету жиіркенішті!
Dialogue: 0,0:07:21.23,0:07:25.94,Default,,0,0,0,,Жарайды, көрсетші. Сіз оны бәрібір алмайсыз. Бұл алаяқтық.
Dialogue: 0,0:07:27.98,0:07:30.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:31.45,0:07:33.20,Default,,0,0,0,,Аваны өзіңізбен бірге алыңыз!
Dialogue: 0,0:07:33.28,0:07:35.91,Default,,0,0,0,,Осыншама көп нәрсені алып, оны қалай көрсетуге болады?
Dialogue: 0,0:07:35.99,0:07:38.08,Default,,0,0,0,,Мінезі қандай жаман!
Dialogue: 0,0:07:38.79,0:07:40.91,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:07:41.00,0:07:41.62,Default,,0,0,0,,Ах
Dialogue: 0,0:07:42.62,0:07:45.25,Default,,0,0,0,,«Бір тегін кран ойыны»
Dialogue: 0,0:07:48.46,0:07:48.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:49.92,0:07:51.55,Default,,0,0,0,,Қараңдар, мен оны тастадым.
Dialogue: 0,0:07:52.59,0:07:57.39,Default,,0,0,0,,Не... бұл не! Маған мына билетті бересіз бе?
Dialogue: 0,0:07:59.56,0:08:02.23,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:08:04.60,0:08:05.31,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:06.61,0:08:07.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.48,0:08:09.90,Default,,0,0,0,,Бұл Ақкүнге сыйлық.
Dialogue: 0,0:08:09.98,0:08:12.70,Default,,0,0,0,,Мен оны өз ақшаммен алуым керек.
Dialogue: 0,0:08:12.78,0:08:15.36,Default,,0,0,0,,Мен сенен ешбір садақа алмаймын!
Dialogue: 0,0:08:16.82,0:08:19.08,Default,,0,0,0,,Түсіндім, кешіріңіз.
Dialogue: 0,0:08:19.16,0:08:21.33,Default,,0,0,0,,Оны алғаныңызға рахмет.
Dialogue: 0,0:08:22.87,0:08:24.79,Default,,0,0,0,,Жарайды, қараңызшы.
Dialogue: 0,0:08:24.87,0:08:28.04,Default,,0,0,0,,Мен оны міндетті түрде соңғы рет сынап көремін.
Dialogue: 0,0:08:28.79,0:08:29.38,Default,,0,0,0,,Ах
Dialogue: 0,0:08:30.80,0:08:33.42,Default,,0,0,0,,Дұрыс жерде тұлып тұр.
Dialogue: 0,0:08:33.51,0:08:36.68,Default,,0,0,0,,Сағынып кеткеніңе сенімдімін, ақымақ.
Dialogue: 0,0:08:36.76,0:08:39.97,Default,,0,0,0,,Бірақ мен соңғы рет сәтсіздікке ұшырай алмаймын.
Dialogue: 0,0:08:40.06,0:08:41.72,Default,,0,0,0,,Қалай қозғалу керек...
Dialogue: 0,0:08:42.35,0:08:43.39,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:49.15,0:08:53.57,Default,,0,0,0,,Мен сені көшіремін деп ойлама, сен сондай ақымақсың.
Dialogue: 0,0:08:55.86,0:08:57.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:05.71,0:09:06.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:12.59,0:09:15.97,Default,,0,0,0,,Көрдіңіз бе? Мен Аваны өзіммен бірге алып кеттім!
Dialogue: 0,0:09:16.05,0:09:18.05,Default,,0,0,0,,О~
Dialogue: 0,0:09:18.14,0:09:20.68,Default,,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:09:20.76,0:09:24.68,Default,,0,0,0,,Басқа ештеңе жоқ, үйге қайт! Есіңізде болсын!
Dialogue: 0,0:09:25.89,0:09:28.10,Default,,0,0,0,,Солай болса да, Ауаны алып кетсе
Dialogue: 0,0:09:28.19,0:09:29.94,Default,,0,0,0,,Нағыз ақымақ
Dialogue: 0,0:09:30.98,0:09:33.90,Default,,0,0,0,,Мен сондай жақсы жағдайда тұрған нәрсені алуды ұмытып кетіппін.
Dialogue: 0,0:09:34.53,0:09:37.11,Default,,0,0,0,,Оны көп рет қалай қабылдау керектігін көрсетіңіз
Dialogue: 0,0:09:39.62,0:09:40.62,Default,,0,0,0,,Ах
Dialogue: 0,0:09:40.70,0:09:44.66,Default,,0,0,0,,Мүмкін әдейі?
Dialogue: 0,0:09:49.25,0:09:54.09,Default,,0,0,0,,Себебі мен «рахмет» деп айтпаймын
Dialogue: 0,0:09:57.22,0:09:57.72,Default,,0,0,0,,Ах
Dialogue: 0,0:09:58.59,0:10:00.68,Default,,0,0,0,,Күткеніңізге рахмет, Ахарен мырза.
Dialogue: 0,0:10:01.68,0:10:04.39,Default,,0,0,0,,Сен күткендей бүгін де көп нәрсе алдың.
Dialogue: 0,0:10:06.18,0:10:08.02,Default,,0,0,0,,Не? Маған бере аласыз ба?
Dialogue: 0,0:10:08.10,0:10:10.86,Default,,0,0,0,,Жоқ, жақсы, мен де бұрын алғанмын.
Dialogue: 0,0:10:11.69,0:10:12.40,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:18.70,0:10:19.78,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:10:20.53,0:10:23.83,Default,,0,0,0,,(Янкирасудың айқайы)
Dialogue: 0,0:10:23.91,0:10:25.54,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:10:26.16,0:10:29.92,Default,,0,0,0,,Кешіріңіз, Янкирас, мен сізді қорғай алмадым.
Dialogue: 0,0:10:30.83,0:10:31.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:32.50,0:10:34.46,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:10:34.55,0:10:36.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:43.18,0:10:45.43,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:45.51,0:10:47.81,Default,,0,0,0,,Қайырлы таң Ахарен-сан
Dialogue: 0,0:10:50.39,0:10:53.36,Default,,0,0,0,,Мм... бірдеңе өзгерді ме?
Dialogue: 0,0:10:53.86,0:10:56.78,Default,,0,0,0,,Не? Оның әдеттегіден айырмашылығы жоқ
Dialogue: 0,0:10:58.90,0:10:59.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:01.32,0:11:02.03,Default,,0,0,0,,Сіз салмақ қостыңыз ба?
Dialogue: 0,0:11:02.11,0:11:03.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:03.28,0:11:05.41,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:11:07.04,0:11:09.75,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:11:10.62,0:11:11.92,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:11:12.88,0:11:14.75,Default,,0,0,0,,Не болды? Ахарен мырза
Dialogue: 0,0:11:16.63,0:11:17.88,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:11:21.84,0:11:22.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:27.39,0:11:27.89,Default,,0,0,0,,Ах
Dialogue: 0,0:11:33.94,0:11:35.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:40.32,0:11:40.90,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:46.03,0:11:48.45,Default,,0,0,0,,Ал оны өзгерте алмасам…
Dialogue: 0,0:11:50.20,0:11:52.12,Default,,0,0,0,,Қайырлы таң Ахарен-сан
Dialogue: 0,0:11:54.96,0:11:56.96,Default,,0,0,0,,Сіз ештеңе көрмедіңіз бе?
Dialogue: 0,0:11:57.04,0:11:59.21,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:11:59.30,0:12:01.55,Default,,0,0,0,,А... ештеңе жоқ.
Dialogue: 0,0:12:02.26,0:12:06.10,Default,,0,0,0,,Кешіріңіз, Ахарен-сан, мен оны көрдім.
Dialogue: 0,0:12:06.18,0:12:08.51,Default,,0,0,0,,Мен диеталық кітап оқып жатқанда ұсталдым.
Dialogue: 0,0:12:09.35,0:12:12.73,Default,,0,0,0,,I can't believe Mr. Aharen was worried about his weight!
Dialogue: 0,0:12:13.98,0:12:16.02,Default,,0,0,0,,Қарсылық денсаулыққа пайдалы емес.
Dialogue: 0,0:12:16.11,0:12:20.19,Default,,0,0,0,,Above all, I don't think Aharen needs to go on a diet.
Dialogue: 0,0:12:20.69,0:12:24.82,Default,,0,0,0,,But I don't know if they'll listen even if I say that.
Dialogue: 0,0:12:27.87,0:12:32.66,Default,,0,0,0,,Олай болса, ең болмағанда Ахарен мырзаға дұрыс тамақтану әдісін айтайық.
Dialogue: 0,0:12:34.00,0:12:35.29,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:12:42.01,0:12:43.72,Default,,0,0,0,,Фуфу фуфу фуфу
Dialogue: 0,0:12:46.80,0:12:48.97,Default,,0,0,0,,Хо хо хо...
Dialogue: 0,0:12:53.35,0:12:54.56,Default,,0,0,0,,Ыстық
Dialogue: 0,0:12:55.52,0:12:56.85,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:12:56.94,0:13:00.23,Default,,0,0,0,,Менің ойымша, Ахарен сол күйінде қалуы керек.
Dialogue: 0,0:13:01.69,0:13:05.36,Default,,0,0,0,,Бірақ Ахарен мырзаның өзін өзгерткісі келетіні
Dialogue: 0,0:13:05.45,0:13:08.74,Default,,0,0,0,,Мен оны жоққа шығарғым келмейді, мен сені қолдаймын.
Dialogue: 0,0:13:09.41,0:13:14.58,Default,,0,0,0,,Сондықтан диета ұстағыңыз келсе, осы кітапты ұсынамын.
Dialogue: 0,0:13:14.66,0:13:17.88,Default,,0,0,0,,Мен диета ұстауға тырыспаймын.
Dialogue: 0,0:13:18.42,0:13:20.42,Default,,0,0,0,,Не? А... иә
Dialogue: 0,0:13:20.50,0:13:21.67,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:24.26,0:13:26.63,Default,,0,0,0,,Иә, орындар туралы.
Dialogue: 0,0:13:29.72,0:13:30.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:35.56,0:13:37.85,Default,,0,0,0,,Келесі аптада сынақ кезеңі басталады.
Dialogue: 0,0:13:38.35,0:13:41.11,Default,,0,0,0,,Бəріміз өзімізді біліп алайық.
Dialogue: 0,0:13:41.69,0:13:45.11,Default,,0,0,0,,Those with poor grades in each subject will be given a make-up exam.
Dialogue: 0,0:13:45.19,0:13:46.65,Default,,0,0,0,,Мұнда Он екі Құбыжық Айдың тек Төменгі Айлары ғана жиналған
Dialogue: 0,0:13:46.74,0:13:47.57,Default,,0,0,0,,Иә
Dialogue: 0,0:13:48.32,0:13:51.24,Default,,0,0,0,,Бұл толықтыру емтиханы ма? Менің ойымша, бұл соңғы рет болды ...
Dialogue: 0,0:13:52.16,0:13:55.87,Default,,0,0,0,,Төменнен бастап санау жылдамырақ болды
Dialogue: 0,0:13:57.41,0:14:02.25,Default,,0,0,0,,Мен де осы уақытқа дейін оқымағанмын, сондықтан бұл қауіпті емес пе?
Dialogue: 0,0:14:03.46,0:14:04.00,Default,,0,0,0,,Ах
Dialogue: 0,0:14:05.80,0:14:09.97,Default,,0,0,0,,Ахарен мырза күткендей, ол жайбарақат сөйлейді.
Dialogue: 0,0:14:10.05,0:14:12.64,Default,,0,0,0,,Мен бұл жағдайға мүлдем бей-жай қалдым.
Dialogue: 0,0:14:12.72,0:14:16.23,Default,,0,0,0,,Чемпионның стиліне дұрыс оқу арқылы ғана қол жеткізуге болады.
Dialogue: 0,0:14:16.31,0:14:17.52,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:17.60,0:14:20.02,Default,,0,0,0,,Ахарен мырза маған қалай оқу керектігін үйретсе...
Dialogue: 0,0:14:21.06,0:14:24.15,Default,,0,0,0,,Ол менің құтқаруымның құдайы болуы мүмкін!
Dialogue: 0,0:14:27.57,0:14:28.95,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:14:29.03,0:14:29.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:30.20,0:14:32.91,Default,,0,0,0,,Бүгіннен бастап сабақтан кейін сабақ өткіземіз бе?
Dialogue: 0,0:14:33.66,0:14:37.71,Default,,0,0,0,,Let's study together and teach each other the subjects that we're not good at.
Dialogue: 0,0:14:38.41,0:14:42.96,Default,,0,0,0,,Мүлдем оқымағандықтан, шымшып қалғандықтан емес.
Dialogue: 0,0:14:43.50,0:14:45.38,Default,,0,0,0,,Бұл жеңді.
Dialogue: 0,0:14:46.09,0:14:46.67,Default,,0,0,0,,Иә
Dialogue: 0,0:14:47.55,0:14:52.60,Default,,0,0,0,,Жарайды, онда сабақтан кейін бірге оқитын тыныш жер тауып алайық.
Dialogue: 0,0:14:58.31,0:15:01.85,Default,,0,0,0,,Мұнда тыныш, сондықтан мен оңай оқи аламын.
Dialogue: 0,0:15:01.94,0:15:02.69,Default,,0,0,0,,Иә
Dialogue: 0,0:15:05.19,0:15:05.77,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:08.86,0:15:09.40,Default,,0,0,0,,Иә
Dialogue: 0,0:15:11.16,0:15:11.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:14.20,0:15:14.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:17.83,0:15:18.45,Default,,0,0,0,,Иә
Dialogue: 0,0:15:20.33,0:15:20.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:24.00,0:15:24.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:32.76,0:15:33.26,Default,,0,0,0,,Иә
Dialogue: 0,0:15:38.64,0:15:40.06,Default,,0,0,0,,Пуу~
Dialogue: 0,0:15:42.39,0:15:44.56,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:15:44.65,0:15:46.15,Default,,0,0,0,,О~
Dialogue: 0,0:15:49.11,0:15:49.99,Default,,0,0,0,,（）
Dialogue: 0,0:15:50.07,0:15:51.28,Default,,0,0,0,,Ах! (2 адам) Иә?
Dialogue: 0,0:15:51.36,0:15:55.03,Default,,0,0,0,,Уау! Мен оқимын!
Dialogue: 0,0:15:55.12,0:15:56.49,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:56.58,0:16:00.25,Default,,0,0,0,,Come with Awa, compete with me in arithmetic!
Dialogue: 0,0:16:00.33,0:16:03.00,Default,,0,0,0,,There's no way a king would accept a fight like that.
Dialogue: 0,0:16:03.08,0:16:06.25,Default,,0,0,0,,Не... не! Оның Ақкүнге еш қатысы жоқ, солай ма?
Dialogue: 0,0:16:06.34,0:16:08.96,Default,,0,0,0,,Иә! Мен ең жақсы шәкіртпін!
Dialogue: 0,0:16:13.09,0:16:15.55,Default,,0,0,0,,Өйткені, бұл ең жақсысы.
Dialogue: 0,0:16:15.64,0:16:16.22,Default,,0,0,0,,Иә
Dialogue: 0,0:16:16.72,0:16:17.64,Default,,0,0,0,,Жақсы
Dialogue: 0,0:16:18.14,0:16:22.81,Default,,0,0,0,,Мен мүлдем оқымадым, сондықтан сізбен бірге оқи алғаныма қуаныштымын.
Dialogue: 0,0:16:23.35,0:16:27.90,Default,,0,0,0,,Солай ма? Мен толығымен дайын және босаңсыған сияқтымын.
Dialogue: 0,0:16:28.69,0:16:30.99,Default,,0,0,0,,Жай ғана шымшып қалды.
Dialogue: 0,0:16:31.07,0:16:32.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:32.78,0:16:35.41,Default,,0,0,0,,Now, tell me the results of the previous test.
Dialogue: 0,0:16:35.49,0:16:38.70,Default,,0,0,0,,For each subject, the one with the highest score will be taught.
Dialogue: 0,0:16:39.20,0:16:39.79,Default,,0,0,0,,Иә
Dialogue: 0,0:16:41.41,0:16:42.91,Default,,0,0,0,,Мен... мен істедім! Дәл осылай болуы керек еді!
Dialogue: 0,0:16:43.83,0:16:47.29,Default,,0,0,0,,Сіз барлық пәндерден маған қарағанда жоғары балл алдыңыз, солай ма?
Dialogue: 0,0:17:01.47,0:17:04.48,Default,,0,0,0,,Әй, тазалық міндеті деген небір машақат.
Dialogue: 0,0:17:05.64,0:17:06.94,Default,,0,0,0,,Сынақ ертең басталады.
Dialogue: 0,0:17:07.02,0:17:09.36,Default,,0,0,0,,Let's split up and finish it as soon as possible.
Dialogue: 0,0:17:09.98,0:17:11.94,Default,,0,0,0,,Біз еденді жасаймыз.
Dialogue: 0,0:17:12.03,0:17:14.36,Default,,0,0,0,,Mr. Aharen and Mr. Raidou, please do something else.
Dialogue: 0,0:17:14.95,0:17:15.82,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:16.74,0:17:19.24,Default,,0,0,0,,Ал, бастайық, Ахарен...
Dialogue: 0,0:17:19.32,0:17:20.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:21.24,0:17:24.20,Default,,0,0,0,,Mr. Aharen, you're very motivated, aren't you?
Dialogue: 0,0:17:26.75,0:17:30.42,Default,,0,0,0,,Мен тазалауды жақсы көремін және оны жақсы көремін, сондықтан оны маған қалдырыңыз.
Dialogue: 0,0:17:34.84,0:17:35.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:36.34,0:17:37.22,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:37.30,0:17:38.47,Default,,0,0,0,,Қараңғы қару?
Dialogue: 0,0:17:39.09,0:17:40.80,Default,,0,0,0,,Мүмкін Ахарен мырза?
Dialogue: 0,0:17:41.64,0:17:43.39,Default,,0,0,0,,Себебі мен оған жете алмаймын
Dialogue: 0,0:17:43.47,0:17:46.06,Default,,0,0,0,,Сіз бәрін жоймақшысыз...
Dialogue: 0,0:17:47.44,0:17:48.73,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:17:51.36,0:17:53.40,Default,,0,0,0,,Аа, дұрыс...
Dialogue: 0,0:17:54.32,0:17:54.82,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:57.24,0:17:59.41,Default,,0,0,0,,Бұл өте шынайы, солай емес пе?
Dialogue: 0,0:17:59.49,0:18:03.79,Default,,0,0,0,,You said you were good at cleaning, but it's like being a professional cleaner...
Dialogue: 0,0:18:04.37,0:18:04.91,Default,,0,0,0,,Ha
Dialogue: 0,0:18:05.79,0:18:09.12,Default,,0,0,0,,Ахарен мырза өлтірушілер отбасының мүшесі болуы мүмкін бе?
Dialogue: 0,0:18:10.04,0:18:13.75,Default,,0,0,0,,Жер асты тазалаушы бала кезінен үйренген?
Dialogue: 0,0:18:15.09,0:18:17.01,Default,,0,0,0,,Сенің жүзіңдегі жіңішке өрнек
Dialogue: 0,0:18:17.09,0:18:20.18,Default,,0,0,0,,Себебі мен өз эмоцияларымды өлтіруге машықтандым.
Dialogue: 0,0:18:20.93,0:18:25.72,Default,,0,0,0,,Бұл өзімнің шынайы тұлғамды білсем, менің де тазаратынымды білдіре ме?
Dialogue: 0,0:18:26.98,0:18:28.14,Default,,0,0,0,,Дайын га
Dialogue: 0,0:18:28.23,0:18:31.23,Default,,0,0,0,,Мұндағы кір кетпейді~ (Ахарен) Иә?
Dialogue: 0,0:18:32.77,0:18:35.36,Default,,0,0,0,,Күдікті сұйықтықтарды араластыру
Dialogue: 0,0:18:36.11,0:18:39.15,Default,,0,0,0,,Мені умен өлтіретіндеріңізге сене алар емеспін...
Dialogue: 0,0:18:40.36,0:18:41.87,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:18:41.95,0:18:45.20,Default,,0,0,0,,Ой, мына сабынды су өте жақсы шығады!
Dialogue: 0,0:18:45.79,0:18:48.00,Default,,0,0,0,,Рахмет саған Ахарен-сан
Dialogue: 0,0:18:48.75,0:18:51.21,Default,,0,0,0,,Сіз шынымен тазалықтың жанкүйерісіз бе?
Dialogue: 0,0:18:52.21,0:18:54.96,Default,,0,0,0,,Біздің бөлім аяқталды, ендеше ары қарай жалғастырайық.
Dialogue: 0,0:18:55.05,0:18:58.09,Default,,0,0,0,,Аа, мен үшін де бітті.
Dialogue: 0,0:18:58.17,0:18:59.34,Default,,0,0,0,,Кездескенше (Ахарен)...
Dialogue: 0,0:19:01.76,0:19:04.39,Default,,0,0,0,,Тазалап болған соң оқу сабағын өткізейік
Dialogue: 0,0:19:04.47,0:19:05.14,Default,,0,0,0,,Иә
Dialogue: 0,0:19:06.18,0:19:11.65,Default,,0,0,0,,I'll take the lectern back, so Raidou-kun, please use the lectern.
Dialogue: 0,0:19:12.23,0:19:15.27,Default,,0,0,0,,Teaching platform It's big, but is it okay?
Dialogue: 0,0:19:15.36,0:19:16.11,Default,,0,0,0,,Иә
Dialogue: 0,0:19:18.74,0:19:21.70,Default,,0,0,0,,Ахарен мырза, сіз өте ынталысыз.
Dialogue: 0,0:19:23.20,0:19:25.12,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:19:25.20,0:19:26.83,Default,,0,0,0,,Мм... Ах!
Dialogue: 0,0:19:29.66,0:19:30.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:31.37,0:19:32.25,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:33.46,0:19:34.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:35.00,0:19:36.38,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:19:36.46,0:19:39.80,Default,,0,0,0,,Ахарен мырза, жақсысыз ба? Сіз зардап шеккен жоқсыз ба?
Dialogue: 0,0:19:39.88,0:19:40.47,Default,,0,0,0,,Иә
Dialogue: 0,0:19:41.13,0:19:42.18,Default,,0,0,0,,Жақсы
Dialogue: 0,0:19:42.26,0:19:44.80,Default,,0,0,0,,It would have been difficult if I had gotten injured before the test.
Dialogue: 0,0:19:45.55,0:19:47.31,Default,,0,0,0,,Эм, жақсысың ба?
Dialogue: 0,0:19:47.93,0:19:50.06,Default,,0,0,0,,Мен? Бұл ештеңе емес
Dialogue: 0,0:19:52.90,0:19:54.02,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:59.07,0:20:02.07,Default,,0,0,0,,Өйткені бұл...
Dialogue: 0,0:20:02.15,0:20:06.58,Default,,0,0,0,,А, мен түсіндім. Бұрынғы айтқаныңыз осы еді.
Dialogue: 0,0:20:06.66,0:20:08.58,Default,,0,0,0,,Түсіндім, онда мынаны орындайық.
Dialogue: 0,0:20:10.37,0:20:13.04,Default,,0,0,0,,Ой, бұл сынақтың ауқымы.
Dialogue: 0,0:20:13.92,0:20:15.25,Default,,0,0,0,,Барлық пәндер аяқталды
Dialogue: 0,0:20:15.92,0:20:19.05,Default,,0,0,0,,Енді ертеңнен бастап тестілеуді сенімді түрде тапсыруға болады.
Dialogue: 0,0:20:19.96,0:20:20.84,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:21.47,0:20:23.80,Default,,0,0,0,,Өйткені Ахарен мырза маған қалай оқу керектігін үйретті.
Dialogue: 0,0:20:23.88,0:20:25.14,Default,,0,0,0,,Мен осы уақытқа дейін жеттім.
Dialogue: 0,0:20:26.05,0:20:26.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:27.51,0:20:28.60,Default,,0,0,0,,Мен... мен істедім! Дәл осылай болуы керек еді!
Dialogue: 0,0:20:29.18,0:20:31.02,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:20:32.52,0:20:33.39,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:20:34.31,0:20:35.06,Default,,0,0,0,,Жеңілгеніңе ренжіп, маған шабуылдап жүрсің бе?
Dialogue: 0,0:20:40.15,0:20:44.20,Default,,0,0,0,,Тоқта... Ахарен-сан, не болып жатыр?
Dialogue: 0,0:20:44.86,0:20:46.41,Default,,0,0,0,,Бірінші рет...
Dialogue: 0,0:20:46.49,0:20:47.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:47.74,0:20:50.95,Default,,0,0,0,,Райду-кунға бірінші рет көмектесу.
Dialogue: 0,0:20:51.62,0:20:52.50,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:20:54.08,0:20:59.00,Default,,0,0,0,,Райду-кун, сен мен үшін әрқашан көп нәрсе істейсің.
Dialogue: 0,0:20:59.88,0:21:04.55,Default,,0,0,0,,I'm just causing trouble and relying on you...
Dialogue: 0,0:21:06.93,0:21:10.51,Default,,0,0,0,,Дәл қазір мен тазалауды жақсы білемін.
Dialogue: 0,0:21:10.60,0:21:13.06,Default,,0,0,0,,I thought I'd do it without relying on you.
Dialogue: 0,0:21:13.14,0:21:15.14,Default,,0,0,0,,Мен тағы да қиындық туғыздым.
Dialogue: 0,0:21:15.64,0:21:16.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:17.02,0:21:18.15,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:18.98,0:21:22.90,Default,,0,0,0,,I'm glad to finally be able to give something back.
Dialogue: 0,0:21:24.57,0:21:28.49,Default,,0,0,0,,It's okay, I don't always think it's a nuisance.
Dialogue: 0,0:21:29.16,0:21:32.66,Default,,0,0,0,,Бұл бірінші рет емес.
Dialogue: 0,0:21:32.74,0:21:33.29,Default,,0,0,0,,Ах
Dialogue: 0,0:21:34.16,0:21:35.83,Default,,0,0,0,,Мен әрқашан Ахарен-санға барамын.
Dialogue: 0,0:21:35.91,0:21:36.96,Default,,0,0,0,,Маған көмектесуде.
Dialogue: 0,0:21:37.46,0:21:38.71,Default,,0,0,0,,Мен де саған сенемін.
Dialogue: 0,0:21:39.71,0:21:41.59,Default,,0,0,0,,Әдеттегідей рахмет.
Dialogue: 0,0:21:45.63,0:21:47.55,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:21:58.35,0:22:00.48,Default,,0,0,0,,Тест Қолдан келгеннің бәрін жасайық
Dialogue: 0,0:22:01.82,0:22:02.44,Default,,0,0,0,,Иә
Dialogue: 0,0:22:07.11,0:22:10.66,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪~
Dialogue: 0,0:23:37.83,0:23:39.83,Default,,0,0,0,,~♪
Dialogue: 0,0:23:44.21,0:23:46.09,Default,,0,0,0,,Тест Қолдан келгеннің бәрін жасайық
Dialogue: 0,0:23:47.09,0:23:47.92,Default,,0,0,0,,Иә
Dialogue: 0,0:23:49.34,0:23:51.63,Default,,0,0,0,,Сонымен… бұл…
Dialogue: 0,0:23:53.47,0:23:55.89,Default,,0,0,0,,Қазір жіберіңізші.
Dialogue: 0,0:23:59.02,0:24:00.35,Default,,0,0,0,,Аваны өзіңізбен бірге алыңыз!
Dialogue: 0,0:24:00.43,0:24:03.06,Default,,0,0,0,,Неге сен екеуміз біргеміз?
Dialogue: 0,0:24:03.15,0:24:04.10,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:24:04.19,0:24:07.02,Default,,0,0,0,,Ал... Ақымақ болма.
Dialogue: 0,0:24:07.11,0:24:08.53,Default,,0,0,0,,Мен оны оқыдым.
Dialogue: 0,0:24:08.61,0:24:10.07,Default,,0,0,0,,Мені ұста, қарсыласың.
Dialogue: 0,0:24:10.15,0:24:13.11,Default,,0,0,0,,Сен мені Ақкуннан бас тартуға тырысып жатырсың.
Dialogue: 0,0:24:13.20,0:24:17.37,Default,,0,0,0,,солай емес пе? Емес пе? Әйтеуір айт!
Dialogue: 0,0:24:17.45,0:24:19.83,Default,,0,0,0,,(Ахареннің ұйқысы)
Dialogue: 0,0:24:19.91,0:24:21.83,Default,,0,0,0,,Эй... ұйықтап жатырсың ба?
Dialogue: 0,0:24:22.58,0:24:24.62,Default,,0,0,0,,Ах, келесі жолы...
Dialogue: 0,0:24:24.71,0:24:27.09,Default,,0,0,0,,«Тым күшті емес пе?»
Dialogue: 0,0:24:28.59,0:24:34.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory