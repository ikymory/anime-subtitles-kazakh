Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.84,Default,,0,0,0,,Бұл кім? Сіз қолданып отырған күш сіздің бастапқы күшіңіз емес.
Dialogue: 0,0:00:06.84,0:00:09.16,Default,,0,0,0,,Сол дауыс, бір жерде
Dialogue: 0,0:00:09.16,0:00:12.90,Default,,0,0,0,,Егер солай болса, сіз ешқашан күшті бола алмайсыз.
Dialogue: 0,0:00:12.90,0:00:15.84,Default,,0,0,0,,Иә, сіз бұрын түс көргенсіз.
Dialogue: 0,0:00:15.84,0:00:19.80,Default,,0,0,0,,Сіз денеңізде айдаһар бар әдеттен тыс тіршілік иесісіз.
Dialogue: 0,0:00:19.80,0:00:21.90,Default,,0,0,0,,Мен саған сұрапыл шайқас көрсетемін.
Dialogue: 0,0:00:21.90,0:00:23.68,Default,,0,0,0,,Ақ түспен көрсетіледі
Dialogue: 0,0:00:23.68,0:00:25.74,Default,,0,0,0,,Ақ жігіт кім?
Dialogue: 0,0:00:25.76,0:00:28.06,Default,,0,0,0,,Ақырында сіздің алдыңызда пайда болады
Dialogue: 0,0:00:28.06,0:00:31.76,Default,,0,0,0,,Жарайды, мен онымен күресуім керек.
Dialogue: 0,0:00:31.76,0:00:33.86,Default,,0,0,0,,Күнге мықты бол
Dialogue: 0,0:00:33.86,0:00:36.86,Default,,0,0,0,,Мен әрқашан өз күшімді бөлісемін
Dialogue: 0,0:00:36.86,0:00:40.02,Default,,0,0,0,,Неге, мен оны құрбандыққа тұрарлықтай етемін.
Dialogue: 0,0:00:40.02,0:00:43.08,Default,,0,0,0,,Айдаһардың бар екенін көрсетіңіз.
Dialogue: 0,0:00:43.08,0:00:44.42,Default,,0,0,0,,Айдаһар, сен
Dialogue: 0,0:00:44.42,0:00:50.70,Default,,0,0,0,,Веб аяқ киім айдаһары, Қызыл айдаһар императоры Ддрейг
Dialogue: 0,0:00:50.70,0:00:51.72,Default,,0,0,0,,Ддрейг
Dialogue: 0,0:00:51.72,0:00:54.76,Default,,0,0,0,,Сол қолыңыздағы
Dialogue: 0,0:00:54.76,0:01:01.48,Default,,0,0,0,,Мен, мен, неге?
Dialogue: 0,0:01:01.48,0:01:06.02,Default,,0,0,0,,Сіз оянған сияқтысыз.
Dialogue: 0,0:01:06.02,0:01:10.52,Default,,0,0,0,,Клефия-сан, менеджерге не болды?
Dialogue: 0,0:01:10.52,0:01:13.86,Default,,0,0,0,,Ойын Рисер-саманың жеңісімен аяқталды.
Dialogue: 0,0:01:13.86,0:01:14.78,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:01:14.78,0:01:18.04,Default,,0,0,0,,Риас-сама Резайнды жариялады.
Dialogue: 0,0:01:18.04,0:01:20.22,Default,,0,0,0,,Менеджер тапсырды.
Dialogue: 0,0:01:20.22,0:01:21.16,Default,,0,0,0,,Иә
Dialogue: 0,0:01:21.16,0:01:22.74,Default,,0,0,0,,"Жоқ" жағын бөгеп, жоятын есілік балалары
Dialogue: 0,0:01:22.74,0:01:25.12,Default,,0,0,0,,Сіз жеңілгеніңізді қалай мойындайсыз?
Dialogue: 0,0:01:25.12,0:01:27.22,Default,,0,0,0,,Мұны тек бас менеджер ғана айта алады.
Dialogue: 0,0:01:27.22,0:01:30.26,Default,,0,0,0,,Өйткені Ризер-сама сені өлтірмек болды.
Dialogue: 0,0:01:30.26,0:01:34.00,Default,,0,0,0,,Ол кез менің есімде жоқ.
Dialogue: 0,0:01:34.70,0:01:38.62,Default,,0,0,0,,Талай рет тұрып, Ризер-самамен бетпе-бет келдің.
Dialogue: 0,0:01:38.62,0:01:42.24,Default,,0,0,0,,Жарайсың, Исей.
Dialogue: 0,0:01:42.24,0:01:43.24,Default,,0,0,0,,Жетеді
Dialogue: 0,0:01:43.24,0:01:45.00,Default,,0,0,0,,Жарайсыңдар
Dialogue: 0,0:01:45.00,0:01:46.24,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:01:46.24,0:01:47.88,Default,,0,0,0,,Иссей
Dialogue: 0,0:01:47.88,0:01:51.64,Default,,0,0,0,,Міне, осыны білдіреді.
Dialogue: 0,0:01:51.64,0:01:53.46,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:01:53.46,0:01:56.18,Default,,0,0,0,,Менеджерге ұқсауға тырысып,
Dialogue: 0,0:01:56.18,0:01:58.78,Default,,0,0,0,,Көз алдымда құлап түсті
Dialogue: 0,0:01:58.78,0:02:02.16,Default,,0,0,0,,Басқалар, басқалар
Dialogue: 0,0:02:02.16,0:02:05.46,Default,,0,0,0,,Риас-саманың нұсқауы бойынша тек Азия-сан ғана.
Dialogue: 0,0:02:05.46,0:02:08.16,Default,,0,0,0,,Мен бұл жерде Иссей-санға қамқорлық жасаймын.
Dialogue: 0,0:02:08.16,0:02:10.22,Default,,0,0,0,,Басқалар
Dialogue: 0,0:02:10.22,0:02:12.82,Default,,0,0,0,,Ол анық Риас-самамен бірге жүреді.
Dialogue: 0,0:02:12.82,0:02:13.84,Default,,0,0,0,,Қосымшалар?
Dialogue: 0,0:02:14.00,0:02:15.16,Default,,0,0,0,,Бұл келісім кеші.
Dialogue: 0,0:02:15.16,0:02:17.52,Default,,0,0,0,,Ризер-сама және Риас-сама
Dialogue: 0,0:02:17.52,0:02:19.00,Default,,0,0,0,,Әй, менеджер.
Dialogue: 0,0:02:19.00,0:02:23.16,Default,,0,0,0,,Мені Риас сияқты жақсы көретін адаммен бірге болғым келеді.
Dialogue: 0,0:02:23.16,0:02:26.42,Default,,0,0,0,,Мен осы кішкентай арманымды көргім келеді
Dialogue: 0,0:02:26.42,0:02:28.40,Default,,0,0,0,,Кешіріңіз, менеджер.
Dialogue: 0,0:02:28.40,0:02:30.68,Default,,0,0,0,,Ең күшті пешкаға ұмтылыңыз
Dialogue: 0,0:02:30.68,0:02:32.70,Default,,0,0,0,,Сіз мұны істей аласыз
Dialogue: 0,0:02:32.70,0:02:35.36,Default,,0,0,0,,Сен менің сүйкімді қызметшімсің.
Dialogue: 0,0:02:35.36,0:02:37.60,Default,,0,0,0,,Мықты бол
Dialogue: 0,0:02:37.60,0:02:39.34,Default,,0,0,0,,Иссей
Dialogue: 0,0:02:39.34,0:02:41.86,Default,,0,0,0,,Мен күшейе алмадым
Dialogue: 0,0:02:41.86,0:02:45.98,Default,,0,0,0,,Әлсіз, мен неге сонша әлсізмін?
Dialogue: 0,0:02:45.98,0:02:48.62,Default,,0,0,0,,Сенбеген сияқтысың.
Dialogue: 0,0:02:48.62,0:02:52.06,Default,,0,0,0,,Риас ханым отбасының шешімін орындады.
Dialogue: 0,0:02:52.06,0:02:55.76,Default,,0,0,0,,Сонымен қатар, матчтың нәтижесі адамның өзі қалағандай болды.
Dialogue: 0,0:02:55.76,0:02:58.40,Default,,0,0,0,,Мен білемін, білемін.
Dialogue: 0,0:02:58.40,0:02:59.86,Default,,0,0,0,,Әлі де I
Dialogue: 0,0:02:59.86,0:03:02.38,Default,,0,0,0,,Менеджерге ұнамайтын нәрсені мойындау.
Dialogue: 0,0:03:02.38,0:03:05.98,Default,,0,0,0,,Ата-анасы қабылдаған шешімдерді құлықсыз орындаудан басқа амалы жоқ басшы.
Dialogue: 0,0:03:05.98,0:03:07.20,Default,,0,0,0,,Бұл ауырмайды
Dialogue: 0,0:03:07.20,0:03:11.22,Default,,0,0,0,,Сол бейбаққа
Dialogue: 0,0:03:11.22,0:03:16.38,Default,,0,0,0,,Сіз шынымен қызықсыз
Dialogue: 0,0:03:16.38,0:03:19.66,Default,,0,0,0,,Мен жылдар бойы неше түрлі жындарды көрдім.
Dialogue: 0,0:03:19.66,0:03:22.76,Default,,0,0,0,,Тек бетіңізде не ойлайтыныңызды көрсетіңіз
Dialogue: 0,0:03:22.76,0:03:25.60,Default,,0,0,0,,Мен біреудің мен күткендей жүгіріп өткенін бірінші рет көруім.
Dialogue: 0,0:03:25.60,0:03:29.56,Default,,0,0,0,,Сирзечс-сама да қызық екеніңді айтты.
Dialogue: 0,0:03:29.56,0:03:31.54,Default,,0,0,0,,Сиқырлы шеңбер?
Dialogue: 0,0:03:32.06,0:03:35.40,Default,,0,0,0,,Осы сиқырлы шеңберден үйлену тойы өтетін жерге телепортациялауға болады.
Dialogue: 0,0:03:35.40,0:03:37.80,Default,,0,0,0,,Мен де менеджерді ертіп барамын дейсіз бе?
Dialogue: 0,0:03:37.80,0:03:41.36,Default,,0,0,0,,Егер әпкеңді қайтарғың келсе, оған шабуыл жаса.
Dialogue: 0,0:03:41.36,0:03:45.60,Default,,0,0,0,,Бұл маған сеніп тапсырған Сирзехтердің сөздері.
Dialogue: 0,0:03:45.60,0:03:53.96,Default,,0,0,0,,Менің ойымша, бұл жас ханымды қайтарып алған кезде пайдалы болады.
Dialogue: 0,0:03:53.96,0:04:02.12,Default,,0,0,0,,Ойланудың қажеті жоқ
Dialogue: 0,0:04:02.12,0:04:04.72,Default,,0,0,0,,Исе мырза
Dialogue: 0,0:04:04.72,0:04:12.12,Default,,0,0,0,,Бұл кенеттен Азия.
Dialogue: 0,0:04:12.12,0:04:14.68,Default,,0,0,0,,Жақсы, шынымен жақсы.
Dialogue: 0,0:04:14.68,0:04:18.14,Default,,0,0,0,,Ол емделсе де екі күн ұйықтап қалды.
Dialogue: 0,0:04:18.14,0:04:21.10,Default,,0,0,0,,Сен енді оянбайсың деп ойлаймын.
Dialogue: 0,0:04:21.10,0:04:24.92,Default,,0,0,0,,Азияны тағы да алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:04:24.92,0:04:29.20,Default,,0,0,0,,Жоқ, Исэ-сан жақсы болғанша, маған керегі осы.
Dialogue: 0,0:04:29.20,0:04:31.04,Default,,0,0,0,,Тыңда, Азия.
Dialogue: 0,0:04:31.04,0:04:31.74,Default,,0,0,0,,Эй
Dialogue: 0,0:04:31.74,0:04:35.22,Default,,0,0,0,,Мен қазір менеджерге барамын.
Dialogue: 0,0:04:35.22,0:04:38.16,Default,,0,0,0,,Бұл мереке емес, солай ма?
Dialogue: 0,0:04:38.16,0:04:41.70,Default,,0,0,0,,О, мен менеджерді қайтарамын.
Dialogue: 0,0:04:41.70,0:04:42.88,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:04:42.88,0:04:43.94,Default,,0,0,0,,Азия
Dialogue: 0,0:04:43.94,0:04:47.22,Default,,0,0,0,,Жоқ, Асия, осында қал.
Dialogue: 0,0:04:47.22,0:04:47.94,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:04:47.94,0:04:51.00,Default,,0,0,0,,Мен де Исэмен бірге күресе аламын.
Dialogue: 0,0:04:51.00,0:04:53.08,Default,,0,0,0,,Енді сіз сиқырлы күшті пайдалана аласыз
Dialogue: 0,0:04:53.08,0:04:54.96,Default,,0,0,0,,Мен жай ғана қорғанғым келмейді.
Dialogue: 0,0:04:54.96,0:04:55.66,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:55.66,0:04:58.40,Default,,0,0,0,,Ризерді жеңіл соққы және оны жеңу.
Dialogue: 0,0:04:58.40,0:05:00.06,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:05:00.06,0:05:02.92,Default,,0,0,0,,Мұның бәрі ұрып-соғып, ұрып-соққан.
Dialogue: 0,0:05:02.92,0:05:04.20,Default,,0,0,0,,Мыжылған
Dialogue: 0,0:05:04.20,0:05:07.02,Default,,0,0,0,,Сіз қатты ауырсынуды сезінесіз бе?
Dialogue: 0,0:05:07.02,0:05:09.78,Default,,0,0,0,,Мен енді Исе-санды олай көргім келмейді.
Dialogue: 0,0:05:09.78,0:05:13.42,Default,,0,0,0,,Мен өлмеймін
Dialogue: 0,0:05:13.42,0:05:14.80,Default,,0,0,0,,Норман?
Dialogue: 0,0:05:14.80,0:05:17.74,Default,,0,0,0,,Қараңызшы, мен Азияға көмектескен кезім.
Dialogue: 0,0:05:17.74,0:05:18.90,Default,,0,0,0,,Мен тірі болдым.
Dialogue: 0,0:05:18.90,0:05:21.88,Default,,0,0,0,,Олай болса маған уәде бер
Dialogue: 0,0:05:21.88,0:05:22.76,Default,,0,0,0,,Сен сияқты — олардың әрқайсысы.
Dialogue: 0,0:05:22.76,0:05:26.48,Default,,0,0,0,,Менеджермен бірге оралуды ұмытпаңыз.
Dialogue: 0,0:05:26.48,0:05:28.48,Default,,0,0,0,,Әрине
Dialogue: 0,0:05:28.48,0:05:31.76,Default,,0,0,0,,Сондай-ақ мен Азияның ынтымақтастығын қалайтын нәрсе бар.
Dialogue: 0,0:05:32.30,0:05:37.06,Default,,0,0,0,,Бұл тек Азия сұрай алатын нәрсе.
Dialogue: 0,0:05:37.06,0:05:38.40,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:05:38.40,0:05:39.50,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:05:39.50,0:05:42.76,Default,,0,0,0,,Егер Исэ-сан солай айтса.
Dialogue: 0,0:05:42.76,0:05:44.90,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:44.90,0:05:49.28,Default,,0,0,0,,Эй, сен мені естисің.
Dialogue: 0,0:05:49.28,0:05:50.84,Default,,0,0,0,,Саған айтар сөзім бар.
Dialogue: 0,0:05:50.84,0:05:52.40,Default,,0,0,0,,Немесе мен мәңгі осы жерде қалсам, ол мазалайды деп отырсың ба?
Dialogue: 0,0:05:52.40,0:05:53.90,Default,,0,0,0,,Қорғалған бұрғылау қондырғысы
Dialogue: 0,0:05:53.90,0:05:55.74,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:55.74,0:05:57.84,Default,,0,0,0,,Маған не айтарыңыз бар?
Dialogue: 0,0:05:57.84,0:06:01.12,Default,,0,0,0,,Мен сенімен бизнес жасағым келеді.
Dialogue: 0,0:06:01.12,0:06:04.12,Default,,0,0,0,,Бұл келісім кеші болса да
Dialogue: 0,0:06:04.12,0:06:05.54,Default,,0,0,0,,Бұл ортақ үйлену көйлегі.
Dialogue: 0,0:06:05.54,0:06:08.12,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:08.12,0:06:11.46,Default,,0,0,0,,Жоқ Riser-san.
Dialogue: 0,0:06:11.46,0:06:13.12,Default,,0,0,0,,Бұл еркек Венера
Dialogue: 0,0:06:13.12,0:06:14.68,Default,,0,0,0,,Қатты болмаңыз
Dialogue: 0,0:06:14.68,0:06:16.42,Default,,0,0,0,,Мен бүгін басты кейіпкермін.
Dialogue: 0,0:06:16.42,0:06:19.12,Default,,0,0,0,,Аа, бас кейіпкер келін.
Dialogue: 0,0:06:19.12,0:06:20.30,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:20.30,0:06:22.60,Default,,0,0,0,,Мен әлі келін болған жоқпын.
Dialogue: 0,0:06:22.60,0:06:23.96,Default,,0,0,0,,Бұл қандай костюм?
Dialogue: 0,0:06:23.96,0:06:25.84,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:06:25.84,0:06:28.34,Default,,0,0,0,,Гремори отбасы мен Феникс отбасы бір-бірімен байланысты.
Dialogue: 0,0:06:28.34,0:06:30.24,Default,,0,0,0,,Сіз апелляцияны нақтырақ бере аласыз
Dialogue: 0,0:06:30.24,0:06:34.12,Default,,0,0,0,,Егер сіз оны киіп алсаңыз, тіпті өзіңізді одан да жеңіл сезінесіз.
Dialogue: 0,0:06:34.12,0:06:34.64,Default,,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,0:06:34.64,0:06:56.64,Default,,0,0,0,,Уайымдамаңыз, мен нақты үйлену тойы үшін онымен салыстыруға келмейтін көйлек дайындаймын. Менің Феникс отбасымның жер асты әлеміндегі ең керемет костюмі бар, оның үстінде дәстүрлі жалын қауырсындары бар. Оның дәмі нашар, бірақ олар жаңадан шыққан отбасы.
Dialogue: 0,0:06:56.64,0:06:58.64,Default,,0,0,0,,Уф
Dialogue: 0,0:06:58.64,0:06:59.64,Default,,0,0,0,,Ах
Dialogue: 0,0:06:59.64,0:07:02.64,Default,,0,0,0,,Иссей
Dialogue: 0,0:07:02.64,0:07:04.64,Default,,0,0,0,,Менеджер
Dialogue: 0,0:07:04.64,0:07:05.64,Default,,0,0,0,,Мен
Dialogue: 0,0:07:05.64,0:07:07.64,Default,,0,0,0,,Жоғалтпа
Dialogue: 0,0:07:07.64,0:07:08.64,Default,,0,0,0,,Менеджер
Dialogue: 0,0:07:08.64,0:07:11.64,Default,,0,0,0,,Мен міндетті түрде менеджерді жеңіске жеткіземін.
Dialogue: 0,0:07:11.64,0:07:15.64,Default,,0,0,0,,Сиқырлы күшті қалай қолдану керектігі әлі есімде болмаса да.
Dialogue: 0,0:07:15.64,0:07:18.64,Default,,0,0,0,,Менің жауынгерлік тәжірибем болмаса да.
Dialogue: 0,0:07:18.64,0:07:21.64,Default,,0,0,0,,Мен үшін барынша жүгір
Dialogue: 0,0:07:21.64,0:07:24.64,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:07:24.64,0:07:28.64,Default,,0,0,0,,Е, мен ақымақпын.
Dialogue: 0,0:07:28.64,0:07:32.64,Default,,0,0,0,,Мен бұл баладан айырылып қала жаздадым.
Dialogue: 0,0:07:32.64,0:07:35.64,Default,,0,0,0,,Менің сүйкімді және қымбаттым
Dialogue: 0,0:07:35.64,0:07:36.64,Default,,0,0,0,,Иә
Dialogue: 0,0:07:36.64,0:07:38.64,Default,,0,0,0,,өте маңызды
Dialogue: 0,0:07:38.64,0:07:40.64,Default,,0,0,0,,Иссей
Dialogue: 0,0:07:40.64,0:07:42.64,Default,,0,0,0,,Риас-сама, уақыт келді.
Dialogue: 0,0:07:42.64,0:07:44.64,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:44.64,0:07:50.64,Default,,0,0,0,,Менің ағам болса, рейтингтік ойын арқылы әйел алған болар едім.
Dialogue: 0,0:07:50.64,0:07:56.64,Default,,0,0,0,,Бұл біз білетін ойын еді, бірақ біз оны маңызды оқиғаға айналдырғымыз келді.
Dialogue: 0,0:07:56.64,0:07:58.64,Default,,0,0,0,,Қалағаныңды айт
Dialogue: 0,0:07:58.64,0:08:00.64,Default,,0,0,0,,Сіз оның беріліп жатқанын ұмытқан болуыңыз керек.
Dialogue: 0,0:08:00.64,0:08:02.64,Default,,0,0,0,,Сонымен, Төраға
Dialogue: 0,0:08:02.64,0:08:04.64,Default,,0,0,0,,Нәтижеге қарамастан, шайқас аяқталды
Dialogue: 0,0:08:04.64,0:08:08.64,Default,,0,0,0,,Жоқ, одан да көп екені бәріне аян еді.
Dialogue: 0,0:08:08.64,0:08:10.64,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:10.64,0:08:12.64,Default,,0,0,0,,Бірақ алаңдаудың қажеті жоқ.
Dialogue: 0,0:08:12.64,0:08:14.64,Default,,0,0,0,,Мүмкін әлі бітпеген шығар
Dialogue: 0,0:08:14.64,0:08:16.64,Default,,0,0,0,,Өйткені біз солай ойлаймыз.
Dialogue: 0,0:08:16.64,0:08:18.64,Default,,0,0,0,,Аяқталмаған
Dialogue: 0,0:08:18.64,0:08:24.64,Default,,0,0,0,,Аспан асты елінің атақты дворяндары
Dialogue: 0,0:08:24.64,0:08:30.64,Default,,0,0,0,,Феникс отбасының атынан бізге қосылғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:08:30.64,0:08:45.64,Default,,0,0,0,,Бүгін мұнда болмаған себебім, мен, Райзер Феникс пен беделді Гремори отбасының келесі басшысы Риас Гремори арасындағы келісімнің тарихи сәтімен бөліскеніңізді қалағандықтан.
Dialogue: 0,0:08:45.64,0:08:51.64,Default,,0,0,0,,Енді мен сізді патшайым Риас Греморимен таныстырғым келеді.
Dialogue: 0,0:08:51.64,0:08:53.64,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:53.64,0:08:55.64,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:08:55.64,0:08:59.64,Default,,0,0,0,,Га
Dialogue: 0,0:08:59.64,0:09:01.64,Default,,0,0,0,,Иссей
Dialogue: 0,0:09:01.64,0:09:03.64,Default,,0,0,0,,Менеджер
Dialogue: 0,0:09:03.64,0:09:05.64,Default,,0,0,0,,Әй, сен қайдасың?
Dialogue: 0,0:09:05.64,0:09:07.64,Default,,0,0,0,,Мен Қуоғакен оккульттік зерттеу клубының бірінші буын сарбазымын.
Dialogue: 0,0:09:07.64,0:09:09.64,Default,,0,0,0,,Бастық Риас Греморидің пәктігі менікі.
Dialogue: 0,0:09:09.64,0:09:11.64,Default,,0,0,0,,Ах
Dialogue: 0,0:09:11.64,0:09:13.64,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:09:13.64,0:09:15.64,Default,,0,0,0,,осында
Dialogue: 0,0:09:15.64,0:09:16.64,Default,,0,0,0,,Мені ұста
Dialogue: 0,0:09:16.64,0:09:19.64,Default,,0,0,0,,Біз де келеміз бе?
Dialogue: 0,0:09:19.64,0:09:21.64,Default,,0,0,0,,Йокай
Dialogue: 0,0:09:21.64,0:09:23.64,Default,,0,0,0,,Иссей-кун, мұны бізге қалдыр.
Dialogue: 0,0:09:23.64,0:09:25.64,Default,,0,0,0,,Баяу
Dialogue: 0,0:09:25.64,0:09:27.64,Default,,0,0,0,,Азу мысық
Dialogue: 0,0:09:27.64,0:09:29.64,Default,,0,0,0,,Әй, ақыры келдіңіз.
Dialogue: 0,0:09:29.64,0:09:31.64,Default,,0,0,0,,Акено мырза
Dialogue: 0,0:09:31.64,0:09:33.64,Default,,0,0,0,,Жүр, Иссейкун.
Dialogue: 0,0:09:33.64,0:09:35.64,Default,,0,0,0,,Иә
Dialogue: 0,0:09:35.64,0:09:37.64,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:09:37.64,0:09:38.64,Default,,0,0,0,,Риас-доно, бұл не?
Dialogue: 0,0:09:38.64,0:09:39.64,Default,,0,0,0,,Бұл мен дайындаған ойын-сауық.
Dialogue: 0,0:09:39.64,0:09:41.64,Default,,0,0,0,,бірақ енді Эсидиси жеңілгендіктен—
Dialogue: 0,0:09:41.64,0:09:43.64,Default,,0,0,0,,Аға
Dialogue: 0,0:09:43.64,0:09:45.64,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:09:45.64,0:09:47.64,Default,,0,0,0,,Сирзукус Люцифер
Dialogue: 0,0:09:47.64,0:09:49.64,Default,,0,0,0,,Бұл адам шайтан
Dialogue: 0,0:09:49.64,0:09:51.64,Default,,0,0,0,,Сирзукус
Dialogue: 0,0:09:51.64,0:09:53.64,Default,,0,0,0,,Көңіл көтеру дегеніміз не?
Dialogue: 0,0:09:53.64,0:09:55.64,Default,,0,0,0,,Ризер-кун
Dialogue: 0,0:09:55.64,0:09:57.64,Default,,0,0,0,,Бағалау ойыны
Dialogue: 0,0:09:57.64,0:09:59.64,Default,,0,0,0,,Мен оны қызығушылықпен қарадым.
Dialogue: 0,0:09:59.64,0:10:01.64,Default,,0,0,0,,Дегенмен, менде ойын тәжірибесі жоқ
Dialogue: 0,0:10:01.64,0:10:03.64,Default,,0,0,0,,Күшімнің жартысынан азы бар әпкеме қарсы күткендей.
Dialogue: 0,0:10:03.64,0:10:05.64,Default,,0,0,0,,Сол шайқасқа көңіліңіз толмаса да
Dialogue: 0,0:10:05.64,0:10:06.64,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:10:06.64,0:10:08.64,Default,,0,0,0,,Мен сөздің орнына келсем
Dialogue: 0,0:10:08.64,0:10:12.64,Default,,0,0,0,,Бағалау ойынының өзі маңыздылығын жоғалтады
Dialogue: 0,0:10:12.64,0:10:16.64,Default,,0,0,0,,Не керек, бұл жолы жағдай
Dialogue: 0,0:10:16.64,0:10:19.64,Default,,0,0,0,,Қарт әулеттің де жүзі тұрмайды.
Dialogue: 0,0:10:19.64,0:10:22.64,Default,,0,0,0,,Менің сүйкімді әпкемнің той кеші
Dialogue: 0,0:10:22.64,0:10:25.64,Default,,0,0,0,,Мен де жарқыраған нәрсе алғым келеді.
Dialogue: 0,0:10:25.64,0:10:26.64,Default,,0,0,0,,Бала сонда
Dialogue: 0,0:10:26.64,0:10:28.64,Default,,0,0,0,,Сіздің айдаһар күшіңіз
Dialogue: 0,0:10:28.64,0:10:31.64,Default,,0,0,0,,Өз көзіммен көргім келеді
Dialogue: 0,0:10:31.64,0:10:34.64,Default,,0,0,0,,Мен Грециядан бірнеше қадам жасауын өтіндім.
Dialogue: 0,0:10:34.64,0:10:36.64,Default,,0,0,0,,Ал, бұл нені білдіреді?
Dialogue: 0,0:10:36.64,0:10:38.64,Default,,0,0,0,,Айдаһар Фенитоксқа қарсы
Dialogue: 0,0:10:38.64,0:10:43.64,Default,,0,0,0,,Аты аңызға айналған күшке ие адамдармен алаңды безендіруге қалай қарайсыз?
Dialogue: 0,0:11:00.64,0:11:02.64,Default,,0,0,0,,Әй, аға!
Dialogue: 0,0:11:02.64,0:11:07.64,Default,,0,0,0,,Жын патшасы күткендей, сізде қызықты ойлар бар.
Dialogue: 0,0:11:07.64,0:11:09.64,Default,,0,0,0,,Айдаһар шебері
Dialogue: 0,0:11:09.64,0:11:10.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:10.64,0:11:16.64,Default,,0,0,0,,Маған және басқа аға дворяндарға өз күшіңізді тағы бір рет көрсете аласыз ба?
Dialogue: 0,0:11:16.64,0:11:17.64,Default,,0,0,0,,Взвод командирі, тіпті біз Әйел Титанын қолға түсірсек те,
Dialogue: 0,0:11:17.64,0:11:18.64,Default,,0,0,0,,Барлығын бірден тоқтатыңыз!
Dialogue: 0,0:11:18.64,0:11:24.64,Default,,0,0,0,,Мына көтергіш, қатып қалмай тұрғанда соңғы жалынды көрсетейін.
Dialogue: 0,0:11:24.64,0:11:27.64,Default,,0,0,0,,Енді, Айдаһар шебері
Dialogue: 0,0:11:27.64,0:11:29.64,Default,,0,0,0,,Жеңісті арттырудың ең жақсы жолы қандай?
Dialogue: 0,0:11:29.64,0:11:30.64,Default,,0,0,0,,Кел, Зекс-сама!
Dialogue: 0,0:11:30.64,0:11:32.64,Default,,0,0,0,,Төменгі деңгейдегі шайтанды үлкен құбыжық дейді...
Dialogue: 0,0:11:32.64,0:11:36.64,Default,,0,0,0,,Кіші болсын, үлкен болсын, ол да шайтан.
Dialogue: 0,0:11:36.64,0:11:40.64,Default,,0,0,0,,Біз өтініш жасағандықтан, сәйкес комиссияны төлеуіміз керек.
Dialogue: 0,0:11:40.64,0:11:42.64,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:11:42.64,0:11:45.64,Default,,0,0,0,,Бұл интерпретация ма? Әлде ол теңдесі жоқ сұлу ма?
Dialogue: 0,0:11:45.64,0:11:48.64,Default,,0,0,0,,Кәне, бірдеңе айт.
Dialogue: 0,0:11:48.64,0:11:49.64,Default,,0,0,0,,Директор…
Dialogue: 0,0:11:49.64,0:11:54.64,Default,,0,0,0,,Жоқ, Риас Гремори-саманы қайтарыңыз!
Dialogue: 0,0:11:54.64,0:11:57.64,Default,,0,0,0,,Ал, бастайық.
Dialogue: 0,0:11:57.64,0:12:00.64,Default,,0,0,0,,Директор! Мен сені 10 секундтан кейін ұрамын!
Dialogue: 0,0:12:00.64,0:12:03.64,Default,,0,0,0,,10 секундтан кейін мені тепкілейсіз бе?
Dialogue: 0,0:12:03.64,0:12:05.64,Default,,0,0,0,,Сіздің ойыңыз дұрыс па?
Dialogue: 0,0:12:05.64,0:12:09.64,Default,,0,0,0,,Ха, онда мен сенің аузыңды 5 секундтан кейін жабамын.
Dialogue: 0,0:12:09.64,0:12:11.64,Default,,0,0,0,,Оны қайта ашпаңыз!
Dialogue: 0,0:12:12.64,0:12:15.64,Default,,0,0,0,,Директор! Маған оны насихаттауға рұқсат етіңіз!
Dialogue: 0,0:12:15.64,0:12:18.64,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз...
Dialogue: 0,0:12:18.64,0:12:23.64,Default,,0,0,0,,Науқан! Ханшайым!
Dialogue: 0,0:12:23.64,0:12:25.64,Default,,0,0,0,,Бұл босқа!
Dialogue: 0,0:12:25.64,0:12:26.64,Default,,0,0,0,,Директор!
Dialogue: 0,0:12:26.64,0:12:27.64,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:27.64,0:12:30.64,Default,,0,0,0,,Менде Кивадай қылыш талант жоқ!
Dialogue: 0,0:12:30.64,0:12:33.64,Default,,0,0,0,,Мен тіпті Акено-сан сияқты сиқырлы данышпан емеспін!
Dialogue: 0,0:12:33.64,0:12:36.64,Default,,0,0,0,,Оның Конеко-чан сияқты ақымақ күші жоқ...
Dialogue: 0,0:12:36.64,0:12:39.64,Default,,0,0,0,,Бізде Азиядағыдай керемет команданың күші жоқ!
Dialogue: 0,0:12:39.64,0:12:42.64,Default,,0,0,0,,Сонда да мен ең мықты сүйек боламын!
Dialogue: 0,0:12:42.64,0:12:46.64,Default,,0,0,0,,Директор үшін болса, Құдайды да жеңбеймін!
Dialogue: 0,0:12:46.64,0:12:50.64,Default,,0,0,0,,Жарқырауды тоқтатыңыз! Шамадан тыс күшейткіш!
Dialogue: 0,0:12:50.64,0:12:54.64,Default,,0,0,0,,Першутра! Oberboosser!
Dialogue: 0,0:12:54.64,0:12:58.64,Default,,0,0,0,,Өте көп!
Dialogue: 0,0:12:58.64,0:13:10.80,Default,,0,0,0,,Бұл Рютейдің күші
Dialogue: 0,0:13:10.80,0:13:13.04,Default,,0,0,0,,Баланс ажыратқыш
Dialogue: 0,0:13:13.04,0:13:13.94,Default,,0,0,0,,Bullset Gear
Dialogue: 0,0:13:13.94,0:13:15.30,Default,,0,0,0,,Ескірген тырнақтар
Dialogue: 0,0:13:15.30,0:13:16.82,Default,,0,0,0,,Баланс ажыратқыш
Dialogue: 0,0:13:16.82,0:13:19.40,Default,,0,0,0,,Тыйым салынған
Dialogue: 0,0:13:19.40,0:13:22.02,Default,,0,0,0,,Шиген енді
Dialogue: 0,0:13:22.02,0:13:24.98,Default,,0,0,0,,Менімен сауда жасаңыз
Dialogue: 0,0:13:24.98,0:13:25.88,Default,,0,0,0,,Қызықты
Dialogue: 0,0:13:25.88,0:13:27.16,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:13:27.16,0:13:28.64,Default,,0,0,0,,Шулы
Dialogue: 0,0:13:28.64,0:13:30.50,Default,,0,0,0,,Мұны істеу керек пе, жоқ па?
Dialogue: 0,0:13:30.50,0:13:32.04,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:13:32.04,0:13:34.76,Default,,0,0,0,,Құрбандыққа тұрарлық.
Dialogue: 0,0:13:34.76,0:13:36.68,Default,,0,0,0,,Бірақ есіңізде болсын
Dialogue: 0,0:13:36.68,0:13:38.26,Default,,0,0,0,,10 санау
Dialogue: 0,0:13:38.26,0:13:41.00,Default,,0,0,0,,Денеде артық жоқ
Dialogue: 0,0:13:41.00,0:13:42.26,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:13:42.26,0:13:44.00,Default,,0,0,0,,Егер бәрі осы болса
Dialogue: 0,0:13:44.00,0:13:45.78,Default,,0,0,0,,Оны ұруды доғарыңыз.
Dialogue: 0,0:13:45.78,0:13:54.50,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:13:54.50,0:14:00.72,Default,,0,0,0,,Не?
Dialogue: 0,0:14:00.72,0:14:02.46,Default,,0,0,0,,Бұл күш пен жылдамдық
Dialogue: 0,0:14:02.46,0:14:04.86,Default,,0,0,0,,Ол шынымен де ұнамсыз бок.
Dialogue: 0,0:14:04.86,0:14:07.10,Default,,0,0,0,,Сен енді құбыжықсың.
Dialogue: 0,0:14:07.10,0:14:07.70,Default,,0,0,0,,Тәтті бала
Dialogue: 0,0:14:07.70,0:14:09.54,Default,,0,0,0,,Firebird және Gun King
Dialogue: 0,0:14:09.54,0:14:11.66,Default,,0,0,0,,Мэр Хедикс ретінде құрметке ие
Dialogue: 0,0:14:11.66,0:14:12.80,Default,,0,0,0,,Менің отбасымның сән-салтанаты
Dialogue: 0,0:14:12.80,0:14:15.24,Default,,0,0,0,,Оны жеке қабылдап, күйіп кетіңіз.
Dialogue: 0,0:14:15.24,0:14:18.26,Default,,0,0,0,,Сіздің бейшара отыңызбен
Dialogue: 0,0:14:18.26,0:14:20.66,Default,,0,0,0,,Олардың мені өлтіруі мүмкін емес.
Dialogue: 0,0:14:20.66,0:14:27.90,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:14:27.90,0:14:28.88,Default,,0,0,0,,Құрыш жоқ
Dialogue: 0,0:14:28.88,0:14:32.52,Default,,0,0,0,,Бұл оның күші болды ма?
Dialogue: 0,0:14:32.52,0:14:33.28,Default,,0,0,0,,Шун
Dialogue: 0,0:14:33.28,0:14:34.46,Default,,0,0,0,,Қарақұрым қоңырау белгісі мұнараның шыңынан алыстап барады. Мен оны сеземін.
Dialogue: 0,0:14:34.46,0:14:35.74,Default,,0,0,0,,Менен қорқасың ба?
Dialogue: 0,0:14:35.74,0:14:37.88,Default,,0,0,0,,Сізде күшейтілген беріліс болуы керек
Dialogue: 0,0:14:37.88,0:14:38.84,Default,,0,0,0,,Тек қоқыс
Dialogue: 0,0:14:38.84,0:14:52.92,Default,,0,0,0,,болып табылады
Dialogue: 0,0:14:52.92,0:14:54.84,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:14:54.84,0:14:57.74,Default,,0,0,0,,Болу
Dialogue: 0,0:14:57.74,0:14:59.82,Default,,0,0,0,,Пан
Dialogue: 0,0:14:59.82,0:15:01.82,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:15:05.82,0:15:07.82,Default,,0,0,0,,Егер бұл крест болса
Dialogue: 0,0:15:07.82,0:15:09.82,Default,,0,0,0,,Менің епископ - бұрынғы әпкем.
Dialogue: 0,0:15:09.82,0:15:12.82,Default,,0,0,0,,Артында сақтадым, бірақ ол маған оралды.
Dialogue: 0,0:15:12.82,0:15:14.82,Default,,0,0,0,,Сіз күткендей
Dialogue: 0,0:15:14.82,0:15:17.82,Default,,0,0,0,,Қасиетті тетік көтерген қасиетті күш жауап беретін сияқты.
Dialogue: 0,0:15:17.82,0:15:19.82,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:15:19.82,0:15:22.82,Default,,0,0,0,,Крест шайтанның денесіне қатты ауырсыну әкеледі.
Dialogue: 0,0:15:22.82,0:15:24.82,Default,,0,0,0,,Айдаһар сауытын қалай кигеніңізге қарамастан
Dialogue: 0,0:15:24.82,0:15:26.82,Default,,0,0,0,,Өзін беру
Dialogue: 0,0:15:26.82,0:15:28.82,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:28.82,0:15:29.82,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:15:29.82,0:15:31.82,Default,,0,0,0,,Қолыңды қолыңдағы айдаһарға бер.
Dialogue: 0,0:15:31.82,0:15:32.82,Default,,0,0,0,,Аяқ киім
Dialogue: 0,0:15:32.82,0:15:36.82,Default,,0,0,0,,Айдаһардың қолы болса, жынның әлсіздігі маңызды емес.
Dialogue: 0,0:15:36.82,0:15:39.82,Default,,0,0,0,,Бұл қол енді менікі емес.
Dialogue: 0,0:15:39.82,0:15:40.82,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:15:41.82,0:15:43.82,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:15:43.82,0:15:46.82,Default,,0,0,0,,Тіпті айқышты да ұстауға болады
Dialogue: 0,0:15:48.82,0:15:50.82,Default,,0,0,0,,Сіз өте кереметсіз бе?
Dialogue: 0,0:15:50.82,0:15:52.82,Default,,0,0,0,,Егер сіз мұны жасасаңыз, сіз ешқашан оралмайсыз.
Dialogue: 0,0:15:52.82,0:15:54.82,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:15:54.82,0:15:56.82,Default,,0,0,0,,Тіпті қолымды ұсынды
Dialogue: 0,0:15:56.82,0:15:59.82,Default,,0,0,0,,Менің мұндай Иссей-саннан жеңілуім мүмкін емес.
Dialogue: 0,0:15:59.82,0:16:03.82,Default,,0,0,0,,Ол міндетті түрде жеңіп, менеджерді қайтарады.
Dialogue: 0,0:16:03.82,0:16:07.82,Default,,0,0,0,,Бұл сіздің қазіргі негізгі мүмкіндігіңіздің шегі.
Dialogue: 0,0:16:07.82,0:16:08.82,Default,,0,0,0,,Мен арзанмын!
Dialogue: 0,0:16:08.82,0:16:12.82,Default,,0,0,0,,Бұл Дрич!
Dialogue: 0,0:16:12.82,0:16:13.82,Default,,0,0,0,,Карточка ашық!
Dialogue: 0,0:16:13.82,0:16:17.82,Default,,0,0,0,,Бұл Дрич!
Dialogue: 0,0:16:17.82,0:16:19.82,Default,,0,0,0,,Өкінішке орай, бізде уақыт таусылды.
Dialogue: 0,0:16:19.82,0:16:20.82,Default,,0,0,0,,Өзіңізді алдамаңыз!
Dialogue: 0,0:16:20.82,0:16:21.82,Default,,0,0,0,,Сәлден кейін!
Dialogue: 0,0:16:21.82,0:16:23.82,Default,,0,0,0,,Бұл жолы не төлеуім керек?
Dialogue: 0,0:16:23.82,0:16:26.82,Default,,0,0,0,,Мехтар, теңіз арыстандары, қалағаныңыздың бәрі!
Dialogue: 0,0:16:26.82,0:16:29.82,Default,,0,0,0,,Бұл сіздің қазіргі негізгі мүмкіндігіңіздің шегі.
Dialogue: 0,0:16:29.82,0:16:31.82,Default,,0,0,0,,Менің әлсіздігімнен бе?
Dialogue: 0,0:16:31.82,0:16:34.82,Default,,0,0,0,,Тәтті, мен неге ең маңызды бөлімдемін...
Dialogue: 0,0:16:34.82,0:16:38.82,Default,,0,0,0,,Босатқан кезде күш аз болса да кернеуге ауысты.
Dialogue: 0,0:16:38.82,0:16:40.82,Default,,0,0,0,,Бірақ бұл уақытша
Dialogue: 0,0:16:40.82,0:16:45.82,Default,,0,0,0,,Өкінішке орай, бұл Феникстің регенерация қабілетіне қарсы тұру үшін жеткіліксіз болады.
Dialogue: 0,0:16:45.82,0:16:50.82,Default,,0,0,0,,Бірақ сонда да мен ешқашан берілмеймін!
Dialogue: 0,0:16:54.82,0:16:56.82,Default,,0,0,0,,Енді мен қазір ұйықтауым керек пе?
Dialogue: 0,0:16:56.82,0:16:59.82,Default,,0,0,0,,Сіз оянған кезде сіздің өлім кезеңіңіз аяқталады.
Dialogue: 0,0:16:59.82,0:17:00.82,Default,,0,0,0,,(Су шашыраған дыбысы)
Dialogue: 0,0:17:00.82,0:17:04.82,Default,,0,0,0,,Өртті сөндірудің ең жақсы тәсілі - су!
Dialogue: 0,0:17:04.82,0:17:05.82,Default,,0,0,0,,Қасиетті су!
Dialogue: 0,0:17:05.82,0:17:09.82,Default,,0,0,0,,Алайда, Ризер сияқты шайтан қасиетті суды пайдалана алмайды...
Dialogue: 0,0:17:09.82,0:17:13.82,Default,,0,0,0,,Bullsket құралының сыйлығы!
Dialogue: 0,0:17:13.82,0:17:15.82,Default,,0,0,0,,Tradaspo!
Dialogue: 0,0:17:21.82,0:17:22.82,Default,,0,0,0,,Көтергіштің жалыны...
Dialogue: 0,0:17:22.82,0:17:27.82,Default,,0,0,0,,Жетілдірілген қасиетті су сіздің физикалық және ақыл-ой күшіңізді айтарлықтай сарптауы мүмкін.
Dialogue: 0,0:17:27.82,0:17:32.82,Default,,0,0,0,,Диапазон ішінен жанданатын Феникс рухты бірден қалпына келтіре алмайды.
Dialogue: 0,0:17:32.82,0:17:34.82,Default,,0,0,0,,Рух…
Dialogue: 0,0:17:34.82,0:17:37.82,Default,,0,0,0,,Рух...жүрек өлмейтін емес.
Dialogue: 0,0:17:37.82,0:17:39.82,Default,,0,0,0,,Азия осылай деді!
Dialogue: 0,0:17:39.82,0:17:42.82,Default,,0,0,0,,Шайтан крест пен қасиетті суды ұнатпайды!
Dialogue: 0,0:17:42.82,0:17:45.82,Default,,0,0,0,,Егер сіз оларды күшейтіп, бір уақытта қолдансаңыз...
Dialogue: 0,0:17:45.82,0:17:47.82,Default,,0,0,0,,Бұл шайтанға көп зиян!
Dialogue: 0,0:17:47.82,0:17:49.82,Default,,0,0,0,,Киба солай айтты!
Dialogue: 0,0:17:49.82,0:17:52.82,Default,,0,0,0,,Көкжиегіңді кеңейтіп, басқа адамға қарасаң!
Dialogue: 0,0:17:52.82,0:17:53.82,Default,,0,0,0,,Е...
Dialogue: 0,0:17:53.82,0:17:54.82,Default,,0,0,0,,Жек көру!
Dialogue: 0,0:17:54.82,0:17:57.82,Default,,0,0,0,,Азия!
Dialogue: 0,0:17:57.82,0:17:58.82,Default,,0,0,0,,Акено-сан айтты!
Dialogue: 0,0:17:58.82,0:18:01.82,Default,,0,0,0,,Сиқырлы күш бүкіл денені жауып тұрған аурадан ағып жатқанда жиналады!
Dialogue: 0,0:18:01.82,0:18:05.82,Default,,0,0,0,,Бар болғаны ерік-жігеріңізді жинақтап, сиқырлы күш толқындарын сезінсеңіз болғаны!
Dialogue: 0,0:18:05.82,0:18:07.82,Default,,0,0,0,,Котенка осылай деді!
Dialogue: 0,0:18:07.82,0:18:12.82,Default,,0,0,0,,Соққының орталық бөлігін көздеңіз және жауды ойып жіберетіндей соққы беріңіз!
Dialogue: 0,0:18:12.82,0:18:14.82,Default,,0,0,0,,Ал... күте тұрыңыз! Түсінесіз бе?
Dialogue: 0,0:18:14.82,0:18:18.82,Default,,0,0,0,,Бұл әскери аударма шайтанның болашағы үшін қажет және маңызды!
Dialogue: 0,0:18:18.82,0:18:23.82,Default,,0,0,0,,Бұл сен сияқты надан бәйбішенің ісі емес!
Dialogue: 0,0:18:23.82,0:18:25.82,Default,,0,0,0,,Қиын нәрселерді түсінбе!
Dialogue: 0,0:18:25.82,0:18:32.82,Default,,0,0,0,,Бірақ, мен сенен жеңіліп, ес-түссіз кеткенде, есіме бір нәрсе түсті!
Dialogue: 0,0:18:32.82,0:18:34.82,Default,,0,0,0,,Менеджер жылап тұрды!
Dialogue: 0,0:18:34.82,0:18:39.82,Default,,0,0,0,,Темеге соғудың барлық себебі осы!
Dialogue: 0,0:18:42.82,0:18:44.82,Default,,0,0,0,,Осындай нәрсе бар ма?
Dialogue: 0,0:18:44.82,0:18:46.82,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,0:18:46.82,0:18:48.82,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:18:51.82,0:18:54.82,Default,,0,0,0,,Егер шағымыңыз болса, маған келіңіз!
Dialogue: 0,0:18:54.82,0:18:56.82,Default,,0,0,0,,Мен сенің серіктесің боламын!
Dialogue: 0,0:18:56.82,0:19:01.82,Default,,0,0,0,,О... жүр... сен... сен...
Dialogue: 0,0:19:04.82,0:19:06.82,Default,,0,0,0,,Бұл шайқас болды...
Dialogue: 0,0:19:06.82,0:19:16.82,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:19:16.82,0:19:18.82,Default,,0,0,0,,Рахмет, Конеко-чан!
Dialogue: 0,0:19:18.82,0:19:19.82,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:19:19.82,0:19:21.82,Default,,0,0,0,,Жарайсың, Иссейкун!
Dialogue: 0,0:19:21.82,0:19:22.82,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:19:22.82,0:19:23.82,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:19:23.82,0:19:25.82,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:19:25.82,0:19:34.82,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:19:34.82,0:19:36.82,Default,,0,0,0,,Менің, Исей!
Dialogue: 0,0:19:44.82,0:19:46.82,Default,,0,0,0,,Мен білмейтін қыз…➡
Dialogue: 0,0:19:46.82,0:19:49.82,Default,,0,0,0,,Грифон. Әй, хехе.
Dialogue: 0,0:19:49.82,0:19:53.82,Default,,0,0,0,,Иссей-кун сізге менеджерді жіберсе ше?
Dialogue: 0,0:19:53.82,0:19:55.32,Default,,0,0,0,,Ал, мен!?
Dialogue: 0,0:19:55.32,0:19:58.82,Default,,0,0,0,,Иә. Мен сенен бір жақсылық сұрай аламын ба?
Dialogue: 0,0:19:58.82,0:20:01.32,Default,,0,0,0,,Бөлім немесе директор бұйырса!
Dialogue: 0,0:20:01.32,0:20:05.32,Default,,0,0,0,,Мен алдымен клуб бөлмесінде күтемін!
Dialogue: 0,0:20:12.32,0:20:18.32,Default,,0,0,0,,Бұл грифон ең нашар жағдайда қашу жолы ретінде дайындалған.
Dialogue: 0,0:20:18.32,0:20:22.32,Default,,0,0,0,,Егер бұл орын алса, оның салдары қиын болар еді.
Dialogue: 0,0:20:22.32,0:20:27.32,Default,,0,0,0,,Менің әкем де, лорд Феникс те көп нәрсеге ой жүгіртті.
Dialogue: 0,0:20:27.32,0:20:31.32,Default,,0,0,0,,Өкінішке орай, бұл жалын оқының сынғандығы расталды.
Dialogue: 0,0:20:31.32,0:20:35.32,Default,,0,0,0,,Өкінішке орай, мен олай ойламаймын.
Dialogue: 0,0:20:35.32,0:20:37.32,Default,,0,0,0,,Мерш айдаһары.
Dialogue: 0,0:20:37.32,0:20:41.32,Default,,0,0,0,,Мен қызыл айдаһар менің жағыма келеді деп ешқашан күтпедім.
Dialogue: 0,0:20:41.32,0:20:47.32,Default,,0,0,0,,Жоғалып бара жатқан айдаһар. Ақ айдаһарды кездестіру өте қарапайым оқиға болмауы мүмкін.
Dialogue: 0,0:20:47.32,0:20:49.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:49.32,0:20:53.32,Default,,0,0,0,,Әй, менеджер...
Dialogue: 0,0:20:53.32,0:20:57.32,Default,,0,0,0,,Сен ақымақсың. Осындай нәрсе жасаңыз. Мен сияқты нәрсе үшін.
Dialogue: 0,0:20:57.32,0:21:02.32,Default,,0,0,0,,Бұл жақсы келісім. Өйткені мен менеджерімді осылай қайтара алдым.
Dialogue: 0,0:21:02.32,0:21:08.32,Default,,0,0,0,,Бұл жолы үзіліс болуы мүмкін еді. Бірақ тағы да араласу туралы әңгіме болуы мүмкін.
Dialogue: 0,0:21:08.32,0:21:11.32,Default,,0,0,0,,Одан кейін оң қол, содан кейін көз, меніңше.
Dialogue: 0,0:21:11.32,0:21:12.32,Default,,0,0,0,,Isse…
Dialogue: 0,0:21:12.32,0:21:21.32,Default,,0,0,0,,Мен саған қайта-қайта көмекке келемін. Өйткені, мен Риас Греморидің қолбасымын.
Dialogue: 0,0:21:21.32,0:21:22.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:22.32,0:21:31.32,Default,,0,0,0,,Бұл үлкен үштік. Мен сенің жүрегіңе жол көрсетемін.
Dialogue: 0,0:21:31.32,0:21:41.32,Default,,0,0,0,,Уайымдамаңыз! Бұлар талғампаз! Байланысты бастайық!
Dialogue: 0,0:21:41.32,0:21:44.32,Default,,0,0,0,,Ұлы Құдайды көруге талпынысыңыздың нәтижесі қандай?
Dialogue: 0,0:21:44.32,0:21:50.32,Default,,0,0,0,,Бірінші сүйісу. Жапонияда бұл қыздарға ұнайтын нәрсе.
Dialogue: 0,0:21:50.32,0:21:55.32,Default,,0,0,0,,Иә? Дұрыс, бірақ... менің алғашқы сүйісім?! Маған жақсы ма...
Dialogue: 0,0:21:55.32,0:22:00.32,Default,,0,0,0,,Сіз лайықты нәрсе жасадыңыз. Бұл сыйлық.
Dialogue: 0,0:22:00.32,0:22:03.32,Default,,0,0,0,,Осы марапаттың өзі күш салуға тұрарлық болды.
Dialogue: 0,0:22:03.32,0:22:04.32,Default,,0,0,0,,Содан кейін.
Dialogue: 0,0:22:04.32,0:22:05.32,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:22:05.32,0:22:08.32,Default,,0,0,0,,Мен де сенің үйіңде тұруды шештім.
Dialogue: 0,0:22:08.32,0:22:09.32,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:22:09.32,0:22:12.32,Default,,0,0,0,,Мен қызметшіммен қарым-қатынасымды тереңдеткім келеді.
Dialogue: 0,0:22:12.32,0:22:15.32,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:22:15.32,0:22:17.32,Default,,0,0,0,,Ой...
Dialogue: 0,0:22:17.32,0:22:20.32,Default,,0,0,0,,Мен жалғыз жұмыс істегім келеді.
Dialogue: 0,0:22:20.32,0:22:23.32,Default,,0,0,0,,Процентке не болды?
Dialogue: 0,0:22:23.32,0:22:24.32,Default,,0,0,0,,Келіңіздер!!
Dialogue: 0,0:22:24.32,0:22:26.32,Default,,0,0,0,,Эскрин-чан ащы жымиды, бірақ бұл бірінші рет емес.
Dialogue: 0,0:22:26.32,0:22:28.32,Default,,0,0,0,,Сен Чан ащы жымиды, бірақ ол қозғалмады.
Dialogue: 0,0:22:28.32,0:22:29.32,Default,,0,0,0,,факт.
Dialogue: 0,0:22:29.32,0:22:31.32,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:22:31.32,0:22:32.26,Default,,0,0,0,,Жасағым келеді
Dialogue: 0,0:22:32.26,0:22:34.20,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:22:34.20,0:22:35.28,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:22:35.28,0:22:35.94,Default,,0,0,0,,О, жарайды!
Dialogue: 0,0:22:35.94,0:22:36.70,Default,,0,0,0,,Сіз бұл жерде емессіз!
Dialogue: 0,0:22:36.70,0:22:37.20,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:22:37.20,0:22:39.42,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:22:39.42,0:22:41.52,Default,,0,0,0,,Датчик!
Dialogue: 0,0:22:41.52,0:22:42.52,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:22:42.52,0:22:44.02,Default,,0,0,0,,Әрқашан сөзсіз
Dialogue: 0,0:22:44.02,0:22:45.34,Default,,0,0,0,,Сарисари
Dialogue: 0,0:22:45.34,0:22:46.78,Default,,0,0,0,,Оған бүгін көмектесу мүмкін емес
Dialogue: 0,0:22:46.78,0:22:48.18,Default,,0,0,0,,Қосымша
Dialogue: 0,0:22:48.18,0:22:49.68,Default,,0,0,0,,Берілме!
Dialogue: 0,0:22:49.68,0:22:51.72,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:23:01.32,0:23:03.08,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:23:03.08,0:23:07.08,Default,,0,0,0,,Мен ол адамды қорғағым келді.
Dialogue: 0,0:23:07.08,0:23:08.38,Default,,0,0,0,,Шарт және т.б.
Dialogue: 0,0:23:08.38,0:23:09.56,Default,,0,0,0,,Шектеулер және т.б.
Dialogue: 0,0:23:09.56,0:23:11.38,Default,,0,0,0,,Таңғы ас дайын.
Dialogue: 0,0:23:11.38,0:23:12.56,Default,,0,0,0,,Сол адам
Dialogue: 0,0:23:12.56,0:23:14.68,Default,,0,0,0,,Қып-қызыл Құдайды шайқау
Dialogue: 0,0:23:14.68,0:23:18.56,Default,,0,0,0,,Абыройлы болуы керек
Dialogue: 0,0:23:18.56,0:23:21.22,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:23:21.22,0:23:23.22,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:23:23.22,0:23:32.02,Default,,0,0,0,,Бұл сол адам.
Dialogue: 0,0:23:33.52,0:23:38.52,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
