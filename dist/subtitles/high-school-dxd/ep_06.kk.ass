Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:09.90,Default,,0,0,0,,Джо Бұл көкірекше болуы мүмкін бе?
Dialogue: 0,0:00:09.90,0:00:11.30,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:00:11.30,0:00:22.24,Default,,0,0,0,,Сонда бұл Азияныкі
Dialogue: 0,0:00:22.24,0:00:26.00,Default,,0,0,0,,Бұл қылмыс, Исейсенпай.
Dialogue: 0,0:00:26.00,0:00:27.72,Default,,0,0,0,,Котенка
Dialogue: 0,0:00:27.72,0:00:29.60,Default,,0,0,0,,Ах, Иссей-сан
Dialogue: 0,0:00:29.60,0:00:32.84,Default,,0,0,0,,Іш киім ұрлау - ауыр қылмыс
Dialogue: 0,0:00:32.84,0:00:34.30,Default,,0,0,0,,Қылмыс?
Dialogue: 0,0:00:34.74,0:00:37.54,Default,,0,0,0,,Жоқ, жай ғана бетіме жабысып қалды.
Dialogue: 0,0:00:37.54,0:00:42.98,Default,,0,0,0,,Кешіріңіз, мен оны бәріңіз келгенше кіргізуді ойладым.
Dialogue: 0,0:00:42.98,0:00:46.90,Default,,0,0,0,,Жарайды, Азияның осы жерден басқа жері жоқ.
Dialogue: 0,0:00:46.90,0:00:51.72,Default,,0,0,0,,Мен мектепке бармай тұрып менеджер маған баспана тауып береді деп сенемін.
Dialogue: 0,0:00:51.72,0:00:54.38,Default,,0,0,0,,Таңертеңгілік жаттығу?
Dialogue: 0,0:00:54.38,0:00:57.26,Default,,0,0,0,,Періштемен жекпе-жектен білгенім
Dialogue: 0,0:00:57.26,0:01:01.26,Default,,0,0,0,,Сізге негізгі физикалық дайындықты жақсарту керек.
Dialogue: 0,0:01:01.26,0:01:02.38,Default,,0,0,0,,А, ха
Dialogue: 0,0:01:02.38,0:01:04.68,Default,,0,0,0,,Мен сені таңғы 5-ке дейін алып кетемін.
Dialogue: 0,0:01:04.68,0:01:05.90,Default,,0,0,0,,Сағат 5-ке дейін?
Dialogue: 0,0:01:06.68,0:01:07.38,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:01:07.38,0:01:09.46,Default,,0,0,0,,Олай болса мен парақшаларды таратамын.
Dialogue: 0,0:01:09.46,0:01:12.26,Default,,0,0,0,,(Субару) Жарайды! (Жастар тобының жетекшісі) Жарайды!
Dialogue: 0,0:01:12.26,0:01:14.58,Default,,0,0,0,,Азия
Dialogue: 0,0:01:14.58,0:01:15.96,Default,,0,0,0,,Иә
Dialogue: 0,0:01:15.96,0:01:16.90,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:01:16.90,0:01:18.54,Default,,0,0,0,,Бұл пансионат туралы.
Dialogue: 0,0:01:18.54,0:01:19.04,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:01:18.96,0:01:20.96,Default,,0,0,0,,Уф
Dialogue: 0,0:01:20.96,0:01:22.96,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:01:22.96,0:01:25.84,Default,,0,0,0,,Can
Dialogue: 0,0:01:25.84,0:01:27.52,Default,,0,0,0,,О, сол күні таңертең.
Dialogue: 0,0:01:27.52,0:01:28.48,Default,,0,0,0,,Ояныңыз
Dialogue: 0,0:01:28.48,0:01:30.22,Default,,0,0,0,,Can Can Can
Dialogue: 0,0:01:30.22,0:01:31.34,Default,,0,0,0,,Жарайды, мен кеттім. Қош бол.
Dialogue: 0,0:01:31.34,0:01:32.00,Default,,0,0,0,,Оян
Dialogue: 0,0:01:32.00,0:01:33.20,Default,,0,0,0,,Can
Dialogue: 0,0:01:33.20,0:01:34.22,Default,,0,0,0,,Ояныңыз
Dialogue: 0,0:01:34.22,0:01:35.10,Default,,0,0,0,,Can
Dialogue: 0,0:01:35.10,0:01:38.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:38.26,0:01:39.96,Default,,0,0,0,,Сағат төрт жарым ғана емес пе?
Dialogue: 0,0:01:40.76,0:01:45.00,Default,,0,0,0,,осында айналдырыңыз
Dialogue: 0,0:01:45.00,0:01:47.00,Default,,0,0,0,,кандидаттар
Dialogue: 0,0:01:47.00,0:01:47.56,Default,,0,0,0,,Олардың бірі… Кира ғой, иә?
Dialogue: 0,0:01:47.56,0:01:48.06,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:01:48.04,0:01:49.08,Default,,0,0,0,,Иә
Dialogue: 0,0:01:49.08,0:01:49.66,Default,,0,0,0,,Кя
Dialogue: 0,0:01:49.66,0:01:50.20,Default,,0,0,0,,Кура
Dialogue: 0,0:01:50.20,0:01:51.58,Default,,0,0,0,,Кя
Dialogue: 0,0:01:51.58,0:01:52.32,Default,,0,0,0,,Адал пікір
Dialogue: 0,0:01:52.32,0:01:56.76,Default,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:01:56.76,0:01:59.26,Default,,0,0,0,,Таңқаларлықтай спорттық, иә?
Dialogue: 0,0:01:59.26,0:02:03.90,Default,,0,0,0,,Бұлыңғыр Менің қызметшім әлсіз, сондықтан мен оны кешірмеймін.
Dialogue: 0,0:02:03.90,0:02:06.90,Default,,0,0,0,,Мен қатты тырыспаймын
Dialogue: 0,0:02:07.80,0:02:13.44,Default,,0,0,0,,Жақсы, жақсы, жындар әлемінде дене күші басым.
Dialogue: 0,0:02:13.44,0:02:17.20,Default,,0,0,0,,Әсіресе, егер сіз бірінші буын болсаңыз Иә.
Dialogue: 0,0:02:17.20,0:02:21.52,Default,,0,0,0,,Кеуде жақсы
Dialogue: 0,0:02:21.52,0:02:26.98,Default,,0,0,0,,Сіздің негізгі физикалық күшіңіз неғұрлым жоғары болса, соғұрлым сіздің қабілеттеріңіз мағыналы болады. Иә.
Dialogue: 0,0:02:26.98,0:02:30.36,Default,,0,0,0,,1112
Dialogue: 0,0:02:30.36,0:02:35.36,Default,,0,0,0,,Режиссердің бөкседегі сезімі ең жақсы
Dialogue: 0,0:02:35.36,0:02:37.46,Default,,0,0,0,,Удо
Dialogue: 0,0:02:37.46,0:02:41.28,Default,,0,0,0,,Менде жаман ойлар бар. Менің жамбас қимылдары біртүрлі.
Dialogue: 0,0:02:41.28,0:02:48.28,Default,,0,0,0,,Бұл жағдайда менің ішімде жасырылған Оума-сан ең жоғары деңгейге жетеді.
Dialogue: 0,0:02:48.28,0:02:50.08,Default,,0,0,0,,Келетін уақыт та қалды.
Dialogue: 0,0:02:50.08,0:02:53.08,Default,,0,0,0,,Уа, біреу келе жатыр ма?
Dialogue: 0,0:02:53.08,0:02:55.08,Default,,0,0,0,,Уф
Dialogue: 0,0:02:55.08,0:03:01.08,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:03:01.08,0:03:03.08,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:03:03.08,0:03:06.08,Default,,0,0,0,,Сіз құлайсыз ба?
Dialogue: 0,0:03:06.08,0:03:09.08,Default,,0,0,0,,Өтінемін, рахмет.
Dialogue: 0,0:03:09.08,0:03:11.08,Default,,0,0,0,,Асия, сен мұнда не үшін келдің?
Dialogue: 0,0:03:11.08,0:03:13.08,Default,,0,0,0,,Мен менеджердің келуін өтіндім.
Dialogue: 0,0:03:13.08,0:03:14.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:14.08,0:03:17.08,Default,,0,0,0,,Директор, неге Азияны таңдадыңыз?
Dialogue: 0,0:03:17.08,0:03:20.08,Default,,0,0,0,,Менеджер
Dialogue: 0,0:03:20.08,0:03:21.08,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:03:21.08,0:03:23.08,Default,,0,0,0,,Не болды, менеджер?
Dialogue: 0,0:03:23.08,0:03:25.08,Default,,0,0,0,,Олай болса, мен Азиямен барамын ба?
Dialogue: 0,0:03:25.08,0:03:26.08,Default,,0,0,0,,Мінез-құлқы: Талғампаз
Dialogue: 0,0:03:26.08,0:03:28.08,Default,,0,0,0,,Иссейдің үйі
Dialogue: 0,0:03:28.08,0:03:31.08,Default,,0,0,0,,«Токио Доумда Өлім періштесінің бар екенін раста».
Dialogue: 0,0:03:31.08,0:03:33.08,Default,,0,0,0,,Менің жеке мүлкім
Dialogue: 0,0:03:33.08,0:03:34.08,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:03:34.08,0:03:36.08,Default,,0,0,0,,Таңқаларлықтай көп
Dialogue: 0,0:03:36.08,0:03:37.08,Default,,0,0,0,,Эй
Dialogue: 0,0:03:37.08,0:03:38.08,Default,,0,0,0,,Директор Азия Нотте
Dialogue: 0,0:03:38.08,0:03:39.08,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:03:39.08,0:03:41.08,Default,,0,0,0,,Бүгіннен бастап сіздің үйіңізде Асия тұрады.
Dialogue: 0,0:03:41.08,0:03:43.08,Default,,0,0,0,,Иә
Dialogue: 0,0:03:43.08,0:03:44.08,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:03:44.08,0:03:48.08,Default,,0,0,0,,Мен қайда тұрғым келеді деп сұрағанымда, сенің үйің менің таңдауым болатынын айтты.
Dialogue: 0,0:03:48.08,0:03:51.08,Default,,0,0,0,,Сонымен, сіз кенеттен осындай бірдеңе айтса да,
Dialogue: 0,0:03:51.08,0:03:52.08,Default,,0,0,0,,Келесі мақсатым —
Dialogue: 0,0:03:52.08,0:03:53.08,Default,,0,0,0,,Ахх
Dialogue: 0,0:03:53.08,0:03:54.08,Default,,0,0,0,,Бұл Азия-сан болды.
Dialogue: 0,0:03:54.08,0:03:55.08,Default,,0,0,0,,Иә әке
Dialogue: 0,0:03:55.08,0:03:57.08,Default,,0,0,0,,Үйде қонақ үй жасасаңыз да
Dialogue: 0,0:03:57.08,0:04:00.08,Default,,0,0,0,,Біздікінен басқа үй жақсы болмай ма?
Dialogue: 0,0:04:00.08,0:04:03.08,Default,,0,0,0,,Иссей мырза менмін.
Dialogue: 0,0:04:03.08,0:04:04.08,Default,,0,0,0,,Негізгі
Dialogue: 0,0:04:04.08,0:04:06.08,Default,,0,0,0,,Иә
Dialogue: 0,0:04:06.08,0:04:10.08,Default,,0,0,0,,Ол маған ең көп көмектескен адам болды, себебі мен шетелден жалғыз келдім.
Dialogue: 0,0:04:10.08,0:04:14.08,Default,,0,0,0,,Мен Исейдің үйінде тыныш өмір сүремін деп ойладым.
Dialogue: 0,0:04:14.08,0:04:16.08,Default,,0,0,0,,Ахх
Dialogue: 0,0:04:16.08,0:04:17.08,Default,,0,0,0,,Азия
Dialogue: 0,0:04:17.08,0:04:19.08,Default,,0,0,0,,Бірақ бұл сізді алаңдатса, мен бас тартамын.
Dialogue: 0,0:04:19.08,0:04:20.08,Default,,0,0,0,,Ахх
Dialogue: 0,0:04:20.08,0:04:22.08,Default,,0,0,0,,Мен жоқ деп айтпаймын.
Dialogue: 0,0:04:22.08,0:04:24.08,Default,,0,0,0,,Ешқандай бөлме жоқ сияқты.
Dialogue: 0,0:04:24.08,0:04:25.08,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:04:25.08,0:04:29.08,Default,,0,0,0,,Менің ұлым бар, оны сексуалдық обсессивті деп атауға болады.
Dialogue: 0,0:04:29.08,0:04:30.08,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:04:30.08,0:04:33.08,Default,,0,0,0,,Ұлыңа бірдеңе айтуға қалай дәтің бар.
Dialogue: 0,0:04:33.08,0:04:38.08,Default,,0,0,0,,Сонымен, бұл отбасылық үй қалыңдықты оқыту қызметін де атқарады.
Dialogue: 0,0:04:38.08,0:04:39.08,Default,,0,0,0,,ше?
Dialogue: 0,0:04:39.08,0:04:41.08,Default,,0,0,0,,Қалыңдық?
Dialogue: 0,0:04:41.08,0:04:42.08,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:04:42.08,0:04:43.08,Default,,0,0,0,,Әлде, ана?
Dialogue: 0,0:04:43.08,0:04:47.08,Default,,0,0,0,,Ұлымның кесірінен немеремнің бетін ешқашан көре алмаймын деп ойладым.
Dialogue: 0,0:04:47.08,0:04:48.08,Default,,0,0,0,,Не?
Dialogue: 0,0:04:48.08,0:04:49.08,Default,,0,0,0,,Әке.
Dialogue: 0,0:04:49.08,0:04:50.08,Default,,0,0,0,,Мен де
Dialogue: 0,0:04:50.08,0:04:51.08,Default,,0,0,0,,Осындай түкке тұрғысыз ұлдың жолы болсын.
Dialogue: 0,0:04:51.08,0:04:52.08,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:04:52.08,0:04:53.08,Default,,0,0,0,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:04:53.08,0:04:54.08,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:04:54.08,0:04:55.08,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:04:55.08,0:04:57.08,Default,,0,0,0,,Иссей мырза жаман адам емес.
Dialogue: 0,0:04:57.08,0:04:58.08,Default,,0,0,0,,О.
Dialogue: 0,0:04:58.08,0:05:00.08,Default,,0,0,0,,Қандай жақсы қыз.
Dialogue: 0,0:05:00.08,0:05:02.08,Default,,0,0,0,,А-а-а-а, Лия-сан.
Dialogue: 0,0:05:02.08,0:05:04.08,Default,,0,0,0,,Мен аяқ дүкенін күтемін.
Dialogue: 0,0:05:04.08,0:05:06.08,Default,,0,0,0,,Жоқ, оны сақтауға рұқсат етіңіз.
Dialogue: 0,0:05:06.08,0:05:07.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:07.08,0:05:08.08,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:05:08.08,0:05:09.08,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:05:09.08,0:05:11.08,Default,,0,0,0,,Міне!
Dialogue: 0,0:05:11.08,0:05:17.08,Default,,0,0,0,,Әй, келін болып оқу мен келін болу мүлдем бөлек.
Dialogue: 0,0:05:17.08,0:05:22.08,Default,,0,0,0,,Әй, қалыңдық.
Dialogue: 0,0:05:22.08,0:05:23.08,Default,,0,0,0,,Директор?
Dialogue: 0,0:05:23.08,0:05:24.08,Default,,0,0,0,,Менің атым Азия Аргенто.
Dialogue: 0,0:05:24.08,0:05:37.08,Default,,0,0,0,,Мен үйренбеген нәрселер көп, бірақ түсінгеніңізге рахмет.
Dialogue: 0,0:05:37.08,0:05:38.08,Default,,0,0,0,,О!
Dialogue: 0,0:05:38.08,0:05:40.08,Default,,0,0,0,,Әдемі аққұба қыз
Dialogue: 0,0:05:40.08,0:05:42.08,Default,,0,0,0,,Кеуде 82, бел 55, жамбас 81
Dialogue: 0,0:05:42.08,0:05:43.08,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:05:43.08,0:05:47.08,Default,,0,0,0,,Түсіндім, мен осы сыныпқа түстім.
Dialogue: 0,0:05:47.08,0:05:49.08,Default,,0,0,0,,Бұл да менеджердікі
Dialogue: 0,0:05:49.08,0:05:53.08,Default,,0,0,0,,Мен қазір Иссей Хиодоның үйінде тұрамын.
Dialogue: 0,0:05:53.08,0:05:55.08,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:05:55.08,0:05:56.08,Default,,0,0,0,,Сіз нені айтып тұрсыз!
Dialogue: 0,0:05:56.08,0:05:59.08,Default,,0,0,0,,Неліктен аққұба сұлу қыз екеуің бір шаңырақ астындасыңдар?
Dialogue: 0,0:05:59.08,0:06:03.08,Default,,0,0,0,,Неліктен бұл жалау тек мұрын ұшына көтерілетін жағдай?
Dialogue: 0,0:06:03.08,0:06:05.08,Default,,0,0,0,,Мен шешкен жоқпын!
Dialogue: 0,0:06:05.08,0:06:09.08,Default,,0,0,0,,Олай болса, мен бәрімен жақсы араласатын сияқтымын.
Dialogue: 0,0:06:09.08,0:06:12.08,Default,,0,0,0,,Эй, бұл мистер Ашердің бөлмесі деп жазылған ба?
Dialogue: 0,0:06:12.08,0:06:14.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:14.08,0:06:17.08,Default,,0,0,0,,Жуынатын бөлме мен дәретхананы мұқият тексеріңіз.
Dialogue: 0,0:06:17.08,0:06:19.08,Default,,0,0,0,,О, тексеру?
Dialogue: 0,0:06:19.08,0:06:22.08,Default,,0,0,0,,Дұрыс, камералар немесе басқалары болуы мүмкін.
Dialogue: 0,0:06:22.08,0:06:23.08,Default,,0,0,0,,Камера?
Dialogue: 0,0:06:23.08,0:06:25.08,Default,,0,0,0,,Балалар!
Dialogue: 0,0:06:25.08,0:06:35.08,Default,,0,0,0,,?
Dialogue: 0,0:06:35.08,0:06:42.08,Default,,0,0,0,,Жоқ, сыныптағылардың бәрі маған, Иссейдің достары Мацуда-сан мен Мотохама-санға мейірімді.
Dialogue: 0,0:06:42.08,0:06:45.08,Default,,0,0,0,,О, олар не істеді?
Dialogue: 0,0:06:45.08,0:06:49.08,Default,,0,0,0,,Сіз мені келесі жолы мырзалар жиналысына шақырасыз ба?
Dialogue: 0,0:06:49.08,0:06:51.08,Default,,0,0,0,,Күрсініңіз, оны елемеуге болады.
Dialogue: 0,0:06:51.08,0:06:53.08,Default,,0,0,0,,Иә
Dialogue: 0,0:06:53.08,0:06:54.08,Default,,0,0,0,,Не!
Dialogue: 0,0:06:54.08,0:06:56.08,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:06:56.08,0:06:58.08,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:06:58.08,0:07:00.08,Default,,0,0,0,,А, аа!
Dialogue: 0,0:07:03.08,0:07:04.08,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:07.08,0:07:09.08,Default,,0,0,0,,Иссей мырза?
Dialogue: 0,0:07:09.08,0:07:11.08,Default,,0,0,0,,Енді әрі қарай жүрейік!
Dialogue: 0,0:07:11.08,0:07:12.08,Default,,0,0,0,,Взвод командирі, тіпті біз Әйел Титанын қолға түсірсек те,
Dialogue: 0,0:07:15.08,0:07:17.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:19.08,0:07:21.08,Default,,0,0,0,,Директор, мен жаңа ғана оралдым.
Dialogue: 0,0:07:22.08,0:07:24.08,Default,,0,0,0,,?
Dialogue: 0,0:07:24.08,0:07:27.08,Default,,0,0,0,,Кешіріңіз, мен аздап таң қалдым.
Dialogue: 0,0:07:27.08,0:07:29.08,Default,,0,0,0,,Екеуіңізге де еңбектеріңіз үшін рахмет.
Dialogue: 0,0:07:29.08,0:07:30.08,Default,,0,0,0,,Азия?
Dialogue: 0,0:07:30.08,0:07:31.08,Default,,0,0,0,,Иә
Dialogue: 0,0:07:31.08,0:07:36.08,Default,,0,0,0,,Мен Азияның бүгін кешке дебют жасауын ойлаймын.
Dialogue: 0,0:07:36.08,0:07:38.08,Default,,0,0,0,,Дебют?
Dialogue: 0,0:07:38.08,0:07:43.08,Default,,0,0,0,,Аа, ол сиқырлы шеңберден шартты адамға секіріп, шарт жасайды.
Dialogue: 0,0:07:43.08,0:07:45.08,Default,,0,0,0,,Айтайын дегенім, әлі ерте емес пе?
Dialogue: 0,0:07:45.08,0:07:49.08,Default,,0,0,0,,Азияның жынға айналғанына бірнеше күн болса да.
Dialogue: 0,0:07:49.08,0:07:50.08,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:50.08,0:07:53.08,Default,,0,0,0,,Менің зерттегенімше, Азия-чан
Dialogue: 0,0:07:53.08,0:07:57.08,Default,,0,0,0,,Жынның вассалы ретінде ол менен кейін екінші сиқырлы күшке ие.
Dialogue: 0,0:07:57.08,0:07:58.08,Default,,0,0,0,,О, рас па?
Dialogue: 0,0:07:58.08,0:08:00.08,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:08:00.08,0:08:04.08,Default,,0,0,0,,Мен епископ ретінде өз қабілеттерімді толығымен пайдалана аламын.
Dialogue: 0,0:08:04.08,0:08:06.08,Default,,0,0,0,,...
Dialogue: 0,0:08:06.08,0:08:08.08,Default,,0,0,0,,О, солай...
Dialogue: 0,0:08:08.08,0:08:11.08,Default,,0,0,0,,Бұл жақсы нәрсе, бірақ менің көңілім қалды...
Dialogue: 0,0:08:11.08,0:08:13.08,Default,,0,0,0,,Жоқ, менің тәжірибем сенен артық.
Dialogue: 0,0:08:13.08,0:08:16.08,Default,,0,0,0,,Мен Азияны дұрыстап қорғауым керек.
Dialogue: 0,0:08:16.08,0:08:17.08,Default,,0,0,0,,Иә
Dialogue: 0,0:08:17.08,0:08:20.08,Default,,0,0,0,,Не болды, Асия?
Dialogue: 0,0:08:20.08,0:08:22.08,Default,,0,0,0,,О, жоқ, ештеңе.
Dialogue: 0,0:08:22.08,0:08:24.08,Default,,0,0,0,,Бұл қабылдау болғандықтан...
Dialogue: 0,0:08:24.08,0:08:25.08,Default,,0,0,0,,Директор!
Dialogue: 0,0:08:25.08,0:08:26.08,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:08:26.08,0:08:28.08,Default,,0,0,0,,Please let me go this time.
Dialogue: 0,0:08:28.08,0:08:30.08,Default,,0,0,0,,Эй, Иссен мырза...
Dialogue: 0,0:08:30.08,0:08:34.08,Default,,0,0,0,,Қараңызшы, Азия бұл елде аз ғана уақыт болды.
Dialogue: 0,0:08:34.08,0:08:37.08,Default,,0,0,0,,Өмірге аздап үйренгенім дұрыс болар еді.
Dialogue: 0,0:08:37.08,0:08:42.08,Default,,0,0,0,,Шынымды айтсам, мен де уайымдадым.
Dialogue: 0,0:08:42.08,0:08:46.08,Default,,0,0,0,,Сізді шақырған адам қауіпті адам болса, не ойлайсыз...
Dialogue: 0,0:08:46.08,0:08:52.08,Default,,0,0,0,,Уф, эй, шарт жасасақ, мен не айтсам соны істейсің.
Dialogue: 0,0:08:52.08,0:08:56.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:56.08,0:09:00.08,Default,,0,0,0,,Менің ойымша, бұл жай ғана менің қиялым.
Dialogue: 0,0:09:00.08,0:09:06.08,Default,,0,0,0,,Иә, мен осындамын, өтінемін, Нён.
Dialogue: 0,0:09:06.08,0:09:08.08,Default,,0,0,0,,А... Нён?
Dialogue: 0,0:09:08.08,0:09:10.08,Default,,0,0,0,,Ньон деген не...
Dialogue: 0,0:09:10.08,0:09:12.08,Default,,0,0,0,,Мың йен бе?
Dialogue: 0,0:09:12.08,0:09:13.08,Default,,0,0,0,,А-а-а-а-а-а...
Dialogue: 0,0:09:13.08,0:09:15.08,Default,,0,0,0,,Қош келдіңіз, Нён
Dialogue: 0,0:09:15.08,0:09:17.08,Default,,0,0,0,,Бұл Миртан, Нён!
Dialogue: 0,0:09:17.08,0:09:19.08,Default,,0,0,0,,Ньон!
Dialogue: 0,0:09:19.08,0:09:38.08,Default,,0,0,0,,Ой, м, мен шайтанды шақырған жоқпын...Греворидің ізбасарлары...
Dialogue: 0,0:09:38.08,0:09:40.08,Default,,0,0,0,,Uuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuu!
Dialogue: 0,0:09:40.08,0:09:44.08,Default,,0,0,0,,Сіздің өтінішіңіз үшін мен шайтанды шақырдым!
Dialogue: 0,0:09:44.08,0:09:45.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:45.08,0:09:46.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:46.08,0:09:50.08,Default,,0,0,0,,Мен Меутанның сиқырлы қыз болғанын қалаймын!
Dialogue: 0,0:09:50.08,0:09:52.08,Default,,0,0,0,,Басқа әлемге телепортация жасаңыз.
Dialogue: 0,0:09:52.08,0:09:54.08,Default,,0,0,0,,Мен мұны істеп көрдім!
Dialogue: 0,0:09:54.08,0:09:55.08,Default,,0,0,0,,Сіз қолданып көрдіңіз бе?
Dialogue: 0,0:09:55.08,0:09:56.08,Default,,0,0,0,,Бұл шайтан!
Dialogue: 0,0:09:56.08,0:09:57.08,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:09:57.08,0:10:01.08,Default,,0,0,0,,Мютанға фантастикалық күш беріңіз!
Dialogue: 0,0:10:01.08,0:10:04.08,Default,,0,0,0,,Жоқ, бұл жеткілікті қиял.
Dialogue: 0,0:10:04.08,0:10:08.08,Default,,0,0,0,,Жоқ, мен Мютан сиқырының күшін қалаймын!
Dialogue: 0,0:10:08.08,0:10:09.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:09.08,0:10:10.08,Default,,0,0,0,,Әй, орында!
Dialogue: 0,0:10:10.08,0:10:12.08,Default,,0,0,0,,Осы жерде шу шығарсаң, қобалжисың!
Dialogue: 0,0:10:12.08,0:10:14.08,Default,,0,0,0,,Біз ішке кіреміз бе?
Dialogue: 0,0:10:14.08,0:10:17.08,Default,,0,0,0,,А-а, сен мені сиқырлы қыз жасайсың ба?
Dialogue: 0,0:10:17.08,0:10:19.08,Default,,0,0,0,,Жарайды, мен тек кеңесу үшін мінемін!
Dialogue: 0,0:10:23.08,0:10:29.08,Default,,0,0,0,,Олай болса, «Сиқырлы қыз сүтті спираль жеті баламасын» бірге тамашалайық!
Dialogue: 0,0:10:29.08,0:10:31.08,Default,,0,0,0,,Кейбір сиқыр сол жерден басталады!
Dialogue: 0,0:10:31.08,0:10:35.08,Default,,0,0,0,,Бұл тағы да солай ма? Өйткені, ол басқаша қауіпті болды.
Dialogue: 0,0:10:38.08,0:10:42.08,Default,,0,0,0,,Әй, менің қайда барғанымды көру неге соншалықты таңқаларлық?
Dialogue: 0,0:10:46.08,0:10:47.08,Default,,0,0,0,,Директор?
Dialogue: 0,0:10:47.08,0:10:50.08,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Жұмыс біткен сияқты.
Dialogue: 0,0:10:50.08,0:10:51.08,Default,,0,0,0,,Нәтижелер туралы не деуге болады?
Dialogue: 0,0:10:51.08,0:10:52.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:52.08,0:10:53.08,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:01.08,0:11:03.08,Default,,0,0,0,,Ммммммм!
Dialogue: 0,0:11:03.08,0:11:07.08,Default,,0,0,0,,Тыңдау. Егер сіз бірнеше жылдан кейін шоғырлансаңыз, сіздің гүлденушілер сіз білмей тұрып, трусикаға ұқсай бастайды!
Dialogue: 0,0:11:07.08,0:11:13.08,Default,,0,0,0,,Мен оны көріп тұрмын, Мотохама! Мен де көріп тұрмын! Мен қара көк гүлді қашан көремін!
Dialogue: 0,0:11:13.08,0:11:15.08,Default,,0,0,0,,Келісім-шартты қайтадан алмадыңыз ба?
Dialogue: 0,0:11:15.08,0:11:20.08,Default,,0,0,0,,Маған көрсетілген аниме таңқаларлықтай қызықты болды, мен оны соңына дейін көрдім.
Dialogue: 0,0:11:20.08,0:11:25.08,Default,,0,0,0,,Ой, кешіріңіз. Жарайды, мен оны ала алмасам, көмектесе алмаймын.
Dialogue: 0,0:11:25.08,0:11:29.08,Default,,0,0,0,,Менеджердің дауысы таң қалдырды.
Dialogue: 0,0:11:29.08,0:11:53.08,Default,,0,0,0,,Аа, күн тым қатал, ендеше сыныпты сүртіп, ұйықтайық.
Dialogue: 0,0:11:53.08,0:11:55.08,Default,,0,0,0,,Әй, бөлім, директор!
Dialogue: 0,0:11:55.08,0:11:59.08,Default,,0,0,0,,Әй, қолдар, қолдар!
Dialogue: 0,0:11:59.08,0:12:02.08,Default,,0,0,0,,Жарайды, тоқта, оң қолым!
Dialogue: 0,0:12:02.08,0:12:05.08,Default,,0,0,0,,Тағы біраз!
Dialogue: 0,0:12:06.08,0:12:10.08,Default,,0,0,0,,О, м, бұл жағдай ше?
Dialogue: 0,0:12:10.08,0:12:14.08,Default,,0,0,0,,Мен аздап летаргиялық болдым және ұйықтап алайын деп ойладым.
Dialogue: 0,0:12:14.08,0:12:17.08,Default,,0,0,0,,Сол кезде бірінші Ыссей ұйықтап жатыр еді.
Dialogue: 0,0:12:17.08,0:12:18.08,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:12:19.08,0:12:20.08,Default,,0,0,0,,Сіз мені мазаладыңыз ба?
Dialogue: 0,0:12:20.08,0:12:25.08,Default,,0,0,0,,О, жоқ, бірақ оны ұйқы деп атаудың өзі тым шектен шыққан...
Dialogue: 0,0:12:25.08,0:12:28.08,Default,,0,0,0,,Жалаңаш болмасам ұйықтай алмаймын.
Dialogue: 0,0:12:28.08,0:12:31.08,Default,,0,0,0,,Иссейге қыздардың кеудесі ұнай ма?
Dialogue: 0,0:12:31.08,0:12:32.08,Default,,0,0,0,,Иә, маған ұнайды.
Dialogue: 0,0:12:33.08,0:12:35.08,Default,,0,0,0,,Менің кеудеме қол тигізгің келе ме?
Dialogue: 0,0:12:38.08,0:12:43.08,Default,,0,0,0,,Менің кеудем, түртіңіз, түртіңіз, түртіңіз.
Dialogue: 0,0:12:43.08,0:12:46.08,Default,,0,0,0,,О, мен бұл әлемде мұндай керемет жапон тілі бар деп ойламаппын!
Dialogue: 0,0:12:46.08,0:12:49.08,Default,,0,0,0,,Менің өтінішімді тыңдасаң, маған қол тигізуге рұқсат бере аламын.
Dialogue: 0,0:12:49.08,0:12:51.08,Default,,0,0,0,,Иә, не деген!
Dialogue: 0,0:12:52.08,0:12:55.08,Default,,0,0,0,,Енді бір келісімшартты алайық.
Dialogue: 0,0:12:55.08,0:13:01.08,Default,,0,0,0,,Мм, сен менімен шындап барасың ба?
Dialogue: 0,0:13:02.08,0:13:06.08,Default,,0,0,0,,Мен бұл жолы бірінші рет директор боламын деп айтпадым ба?
Dialogue: 0,0:13:06.08,0:13:07.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:08.08,0:13:14.08,Default,,0,0,0,,Егер сіз менеджермен бірге болсаңыз, сәтсіздікке ұшырау мүмкіндігі жоқ. Егер сіз мұны жасасаңыз ...
Dialogue: 0,0:13:14.08,0:13:17.08,Default,,0,0,0,,Сәттілік. Тұманды.
Dialogue: 0,0:13:17.08,0:13:19.08,Default,,0,0,0,,Әй, мен барымды саламын, Асия!
Dialogue: 0,0:13:19.08,0:13:21.08,Default,,0,0,0,,Жарайды, мен оны сізге жіберемін!
Dialogue: 0,0:13:21.08,0:13:23.08,Default,,0,0,0,,Таң
Dialogue: 0,0:13:28.08,0:13:34.46,Default,,0,0,0,,Пәтерге ұқсайды, бірақ бұл сенгоку тауарлары...
Dialogue: 0,0:13:34.46,0:13:40.20,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:13:40.20,0:13:49.46,Default,,0,0,0,,Кешіріңіз, сіз әйелсіз бе? Иә, менің атым Судон. Мен Жапонияға жапон мәдениетіне сүйсінгендіктен келдім.
Dialogue: 0,0:13:49.46,0:13:52.46,Default,,0,0,0,,Мен кіші мектеп оқушысы болсам да,
Dialogue: 0,0:13:52.46,0:13:58.14,Default,,0,0,0,,Кешіріңіз, бірақ Сия өте мазасыз болғандықтан, мен өзімді осылай сауытпен қорғауға тура келді.
Dialogue: 0,0:13:58.14,0:14:07.28,Default,,0,0,0,,Бірдеңе дұрыс емес.Бірақ оның мейірімді шайтан екеніне қуаныштымын.Егер ол қорқынышты шайтан болса,осы Кижин таңбасына оның шашын жұлып алудан басқа амалым қалмас еді.
Dialogue: 0,0:14:07.28,0:14:13.28,Default,,0,0,0,,Сіздің тілегіңіз, Ұзан мырза.
Dialogue: 0,0:14:13.28,0:14:20.28,Default,,0,0,0,,Куссун, менімен бірге шетелде оқып жатқан университетке барып жазып алуыңызды өтінемін. Бар болғаны.
Dialogue: 0,0:14:20.28,0:14:23.28,Default,,0,0,0,,Түнгі университет қорқынышты.
Dialogue: 0,0:14:23.28,0:14:27.28,Default,,0,0,0,,Сіз ең қорқыныштысыз
Dialogue: 0,0:14:27.28,0:14:32.28,Default,,0,0,0,,Қарғыс атсын, мені неге біртүрлі атайсың?
Dialogue: 0,0:14:32.28,0:14:35.28,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:14:35.28,0:14:41.28,Default,,0,0,0,,Кешіріңіз, мен түнде қаладан қорқамын, сондықтан қорқатын адам сізсіз.
Dialogue: 0,0:14:41.28,0:14:46.28,Default,,0,0,0,,Сізге көп рахмет. Біз үшін солай.
Dialogue: 0,0:14:46.28,0:14:54.28,Default,,0,0,0,,Менеджердің уәдесі орындалды. Енді мен оның кеудесін еш ойланбастан еркелей аламын.
Dialogue: 0,0:14:54.28,0:15:00.28,Default,,0,0,0,,Алдымен оң қолыңызды айналмалы қозғалыспен жылжытыңыз және сол қолыңызды қолыңыздың үстіне қойыңыз.
Dialogue: 0,0:15:00.28,0:15:04.28,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,0:15:04.28,0:15:08.28,Default,,0,0,0,,Орындауыңызды қалайтын тағы бір өтінішім бар.
Dialogue: 0,0:15:08.28,0:15:12.28,Default,,0,0,0,,Жоқ, бұл мәселе. Бір уақытта бір тілек айтыңыз.
Dialogue: 0,0:15:12.28,0:15:14.28,Default,,0,0,0,,Иә, маңызды емес.
Dialogue: 0,0:15:14.28,0:15:15.28,Default,,0,0,0,,Менеджер
Dialogue: 0,0:15:15.28,0:15:18.28,Default,,0,0,0,,Сізге ер адам ұнайды ма?
Dialogue: 0,0:15:18.28,0:15:23.28,Default,,0,0,0,,Иә, көңілінің бір түкпірінде сезімін жеткізе алмайтын өте жақсы адам.
Dialogue: 0,0:15:23.28,0:15:28.28,Default,,0,0,0,,Ол мұртты сенгоку қолбасшысына ұқсайды.
Dialogue: 0,0:15:28.28,0:15:31.28,Default,,0,0,0,,Мен адамды өзіме ғашық етуім керек пе?
Dialogue: 0,0:15:31.28,0:15:36.28,Default,,0,0,0,,Мүмкін болса, шайтанның күшін емес, өз күшіңді пайдаланып маған ғашық болғаныңды қалаймын.
Dialogue: 0,0:15:36.28,0:15:38.28,Default,,0,0,0,,Онда бізге керек емес.
Dialogue: 0,0:15:39.28,0:15:40.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:40.28,0:15:44.28,Default,,0,0,0,,Олай болса неге сол адамға өз сезіміңізді тікелей айтпасқа?
Dialogue: 0,0:15:44.28,0:15:48.28,Default,,0,0,0,,Әрине, мұны кенеттен жасау мүмкін емес!
Dialogue: 0,0:15:48.28,0:15:50.28,Default,,0,0,0,,О, әріптер ше?
Dialogue: 0,0:15:50.28,0:15:52.28,Default,,0,0,0,,Әй, бұл хат па?
Dialogue: 0,0:15:52.28,0:15:55.28,Default,,0,0,0,,Иә, менің ойымша, махаббат хаттары да жақсы болар еді.
Dialogue: 0,0:15:55.28,0:15:57.28,Default,,0,0,0,,А, махаббат хаты ма?
Dialogue: 0,0:15:57.28,0:16:00.28,Default,,0,0,0,,Өз сезімдерін жазбаша білдіру жақсы.
Dialogue: 0,0:16:00.28,0:16:02.28,Default,,0,0,0,,А, жарайды, мен жасап көремін!
Dialogue: 0,0:16:02.28,0:16:10.28,Default,,0,0,0,,Көп мән бермейтін, жоқ әйелге ілтипатпен қарау керек.
Dialogue: 0,0:16:10.28,0:16:11.28,Default,,0,0,0,,Бұл жай ғана түсініктеме құжаты.
Dialogue: 0,0:16:11.28,0:16:12.28,Default,,0,0,0,,болып табылады
Dialogue: 0,0:16:12.28,0:16:13.28,Default,,0,0,0,,Бізден басқа барлығы Сакурадзима-сенпайды ұмытып қалған болар.
Dialogue: 0,0:16:13.28,0:16:17.28,Default,,0,0,0,,Маңыздысы пішін емес, сезім.
Dialogue: 0,0:16:17.28,0:16:20.28,Default,,0,0,0,,Қызық, сол сезім дұрыс жеткізе ме?
Dialogue: 0,0:16:20.28,0:16:22.28,Default,,0,0,0,,Иә, бұл пішін емес.
Dialogue: 0,0:16:22.28,0:16:26.28,Default,,0,0,0,,Пішін, мен оны қалаймын.
Dialogue: 0,0:16:26.28,0:16:27.28,Default,,0,0,0,,Мейірімсіз бе?
Dialogue: 0,0:16:27.28,0:16:28.28,Default,,0,0,0,,Дайын
Dialogue: 0,0:16:28.28,0:16:32.28,Default,,0,0,0,,Ябуми әзіл ғой, солай ма?
Dialogue: 0,0:16:34.28,0:16:35.28,Default,,0,0,0,,Анашым, бұл не?
Dialogue: 0,0:16:35.28,0:16:37.28,Default,,0,0,0,,Қараңдар, қарамау керек.
Dialogue: 0,0:16:41.28,0:16:43.28,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:16:43.28,0:16:44.28,Default,,0,0,0,,Сіз келген сияқтысыз.
Dialogue: 0,0:16:44.28,0:16:45.28,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:16:45.28,0:16:46.28,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:16:46.28,0:16:48.28,Default,,0,0,0,,Ха, аааааааааааа!
Dialogue: 0,0:16:48.28,0:16:49.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:49.28,0:16:52.28,Default,,0,0,0,,Сью, жебе мені тесіп жатыр!
Dialogue: 0,0:16:52.28,0:16:54.28,Default,,0,0,0,,Иә, мен бұл туралы көп ойладым.
Dialogue: 0,0:16:54.28,0:16:58.28,Default,,0,0,0,,Мен бұталардан басқа жол бере алмадым.
Dialogue: 0,0:16:58.28,0:17:01.28,Default,,0,0,0,,Ах, бірақ бұл
Dialogue: 0,0:17:01.28,0:17:07.28,Default,,0,0,0,,А-а-а-а-а-а...
Dialogue: 0,0:17:16.28,0:17:18.28,Default,,0,0,0,,Мен сіздің хатыңызды оқыдым.
Dialogue: 0,0:17:18.28,0:17:20.28,Default,,0,0,0,,Бұл жақсы бұта болды.
Dialogue: 0,0:17:20.28,0:17:26.64,Default,,0,0,0,,Махаббатымның кесірінен мен сияқтылардың оққа ұшуы үлкен шығын.
Dialogue: 0,0:17:26.64,0:17:31.32,Default,,0,0,0,,Ақылсыз болғаным сонша, менің ойым тек ату ғана болды.
Dialogue: 0,0:17:31.32,0:17:32.42,Default,,0,0,0,,Құрметті Холли
Dialogue: 0,0:17:32.42,0:17:34.82,Default,,0,0,0,,Менің басым қиналған сияқты
Dialogue: 0,0:17:34.82,0:17:38.12,Default,,0,0,0,,Маған жақсы болса, мен сенімен қыдырғым келеді.
Dialogue: 0,0:17:38.12,0:17:44.40,Default,,0,0,0,,Холли, мен өте қуаныштымын.
Dialogue: 0,0:17:44.40,0:17:47.62,Default,,0,0,0,,Состер бұл бетпен керемет көрінеді.
Dialogue: 0,0:17:47.62,0:17:51.14,Default,,0,0,0,,Жоқ, Холли, сенің қаруың қатты және күшті.
Dialogue: 0,0:17:51.14,0:17:54.20,Default,,0,0,0,,Суреті тамаша жұп.
Dialogue: 0,0:17:54.20,0:17:57.00,Default,,0,0,0,,Иә, белгілі бір мағынада.
Dialogue: 0,0:17:57.00,0:17:58.50,Default,,0,0,0,,Сәлем Иссей
Dialogue: 0,0:17:58.50,0:17:59.16,Default,,0,0,0,,А, иә
Dialogue: 0,0:17:59.16,0:18:03.64,Default,,0,0,0,,Өзіңіз жақсы көретін адаммен осылай байланыстыруға қалай қарайсыз?
Dialogue: 0,0:18:03.64,0:18:06.28,Default,,0,0,0,,Не ойласаң да, бақытты емессің бе?
Dialogue: 0,0:18:06.28,0:18:07.60,Default,,0,0,0,,Бақыт
Dialogue: 0,0:18:07.60,0:18:09.16,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:18:09.16,0:18:10.32,Default,,0,0,0,,Һмпф
Dialogue: 0,0:18:10.32,0:18:14.84,Default,,0,0,0,,Неліктен сіз біреуді ұнатпасаңыз да, онымен кездесесіз?
Dialogue: 0,0:18:14.84,0:18:16.80,Default,,0,0,0,,Сіз мұны ешқашан жасамаңыз.
Dialogue: 0,0:18:17.62,0:18:20.14,Default,,0,0,0,,Мүлдем жоқ
Dialogue: 0,0:18:20.14,0:18:22.08,Default,,0,0,0,,Сонымен
Dialogue: 0,0:18:22.08,0:18:24.30,Default,,0,0,0,,Бұл
Dialogue: 0,0:18:24.30,0:18:27.42,Default,,0,0,0,,Мен не айттым? Кешіріңіз.
Dialogue: 0,0:18:27.42,0:18:30.14,Default,,0,0,0,,Жауабыңызға рахмет.
Dialogue: 0,0:18:30.14,0:18:37.78,Default,,0,0,0,,Одан артық әңгіме бар емес пе?
Dialogue: 0,0:18:37.78,0:18:38.42,Default,,0,0,0,,Иә
Dialogue: 0,0:18:38.42,0:18:41.00,Default,,0,0,0,,Дұрыс, ол жерде ешкім жоқ.
Dialogue: 0,0:18:41.00,0:18:43.52,Default,,0,0,0,,Енді сол уәдені орындайтын кез келді
Dialogue: 0,0:18:43.52,0:18:46.52,Default,,0,0,0,,Уәденің мысалы
Dialogue: 0,0:18:46.52,0:18:47.84,Default,,0,0,0,,Мысал уәде
Dialogue: 0,0:18:47.84,0:18:50.20,Default,,0,0,0,,Сіз не уәде бердіңіз?
Dialogue: 0,0:18:50.20,0:18:51.04,Default,,0,0,0,,На
Dialogue: 0,0:18:51.04,0:18:51.70,Default,,0,0,0,,Бұл
Dialogue: 0,0:18:51.70,0:18:53.90,Default,,0,0,0,,Сүт бездері
Dialogue: 0,0:18:53.90,0:18:56.04,Default,,0,0,0,,Вагон тежегішті басады!
Dialogue: 0,0:18:56.04,0:18:59.42,Default,,0,0,0,,Сіз онша байыпты көрінбейсіз.
Dialogue: 0,0:18:59.42,0:19:00.46,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:19:00.46,0:19:02.86,Default,,0,0,0,,Енді беске дейін санау
Dialogue: 0,0:19:02.86,0:19:05.92,Default,,0,0,0,,Мына сандық сенікі.
Dialogue: 0,0:19:05.92,0:19:09.00,Default,,0,0,0,,1
Dialogue: 0,0:19:09.00,0:19:11.44,Default,,0,0,0,,Кенеттен осылай айтсаң да
Dialogue: 0,0:19:11.44,0:19:12.38,Default,,0,0,0,,2
Dialogue: 0,0:19:12.38,0:19:16.06,Default,,0,0,0,,Ойыңызды дайындамас бұрын
Dialogue: 0,0:19:16.06,0:19:16.92,Default,,0,0,0,,3
Dialogue: 0,0:19:16.92,0:19:19.22,Default,,0,0,0,,Сабыр ет, сабыр ет, мен.
Dialogue: 0,0:19:19.22,0:19:21.32,Default,,0,0,0,,Оңға ма, солға ма?
Dialogue: 0,0:19:21.32,0:19:22.44,Default,,0,0,0,,4
Dialogue: 0,0:19:22.44,0:19:24.96,Default,,0,0,0,,Бұлай болса, екеуіне бірден массаж жасалады.
Dialogue: 0,0:19:24.96,0:19:26.96,Default,,0,0,0,,Уф
Dialogue: 0,0:19:26.96,0:19:27.66,Default,,0,0,0,,Иссей мырза
Dialogue: 0,0:19:27.66,0:19:29.44,Default,,0,0,0,,Сіз ертерек келдіңіз бе?
Dialogue: 0,0:19:29.44,0:19:30.78,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:19:30.78,0:19:31.76,Default,,0,0,0,,Сәлем
Dialogue: 0,0:19:31.76,0:19:32.34,Default,,0,0,0,,Немесе
Dialogue: 0,0:19:32.34,0:19:34.10,Default,,0,0,0,,Иә аяқталды
Dialogue: 0,0:19:34.10,0:19:35.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:35.96,0:19:37.30,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:19:37.30,0:19:38.68,Default,,0,0,0,,Не болды, Иссейкун?
Dialogue: 0,0:19:38.68,0:19:39.84,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:19:39.84,0:19:44.28,Default,,0,0,0,,Иссей өте қызық бала.
Dialogue: 0,0:19:44.28,0:19:46.64,Default,,0,0,0,,Мен кеудеме қол тигізгім келді.
Dialogue: 0,0:19:46.64,0:19:52.62,Default,,0,0,0,,Ал, мен мұны біраз уақыт істеймін.
Dialogue: 0,0:19:52.62,0:19:55.68,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:55.68,0:20:03.92,Default,,0,0,0,,Бұл
Dialogue: 0,0:20:03.92,0:20:05.90,Default,,0,0,0,,Барлығы қарап отыр.
Dialogue: 0,0:20:05.90,0:20:07.42,Default,,0,0,0,,Келесі жолы бар күшіңізді салыңыз
Dialogue: 0,0:20:07.42,0:20:09.26,Default,,0,0,0,,Менің сүйкімді қызым
Dialogue: 0,0:20:09.26,0:20:14.26,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:20:14.26,0:20:15.44,Default,,0,0,0,,Иә
Dialogue: 0,0:20:15.44,0:20:18.68,Default,,0,0,0,,Риас
Dialogue: 0,0:20:18.68,0:20:21.26,Default,,0,0,0,,Мүмкін сіз
Dialogue: 0,0:20:21.26,0:20:29.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:29.12,0:20:29.66,Default,,0,0,0,,Уау
Dialogue: 0,0:20:29.66,0:20:31.32,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:20:31.32,0:20:33.26,Default,,0,0,0,,Көрнекі бейнелерді қоссаңыз, бұл шынымен де керемет
Dialogue: 0,0:20:33.94,0:20:35.70,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:20:35.70,0:20:36.62,Default,,0,0,0,,Чо
Dialogue: 0,0:20:36.62,0:20:38.26,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:20:38.26,0:20:40.46,Default,,0,0,0,,Қандай тамаша даму
Dialogue: 0,0:20:40.46,0:21:08.90,Default,,0,0,0,,Қоқыс
Dialogue: 0,0:21:10.40,0:21:15.40,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
