Dialogue: 0,0:10:25.16,0:10:29.16,Default,,0,0,0,,О
Dialogue: 0,0:10:29.16,0:10:45.66,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:10:49.66,0:10:53.66,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:10:53.66,0:10:58.32,Default,,0,0,0,,.
Dialogue: 0,0:10:58.32,0:11:02.32,Default,,0,0,0,,Мен ішуден шаршадым.
Dialogue: 0,0:11:02.32,0:11:04.32,Default,,0,0,0,,Мен мұнда шай қояйын.
Dialogue: 0,0:11:04.32,0:11:06.32,Default,,0,0,0,,А, мен...
Dialogue: 0,0:11:06.32,0:11:09.32,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:11:09.32,0:11:11.32,Default,,0,0,0,,А, жоқ...
Dialogue: 0,0:11:11.32,0:11:14.32,Default,,0,0,0,,Жоқ, бұл ғажап, Иссей-сан.
Dialogue: 0,0:11:14.32,0:11:17.32,Default,,0,0,0,,Бұл әлі де құпия.
Dialogue: 0,0:11:17.32,0:11:19.32,Default,,0,0,0,,Олардың екеуі?
Dialogue: 0,0:11:19.32,0:11:21.32,Default,,0,0,0,,Бұл әлі құпия.
Dialogue: 0,0:11:21.32,0:11:23.32,Default,,0,0,0,,Мен оны тым алыс болу үшін қолданамын.
Dialogue: 0,0:11:23.32,0:11:25.32,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:11:25.32,0:11:31.32,Default,,0,0,0,,Мен саған бір құпиямен көмектесемін.
Dialogue: 0,0:11:31.32,0:11:36.32,Default,,0,0,0,,Ендеше, Ахсия, мен саған сенің оқиғаңды айтып берейін.
Dialogue: 0,0:11:36.32,0:11:38.32,Default,,0,0,0,,А, иә.
Dialogue: 0,0:11:38.32,0:11:40.32,Default,,0,0,0,,А, жақсы...
Dialogue: 0,0:11:40.32,0:11:45.32,Default,,0,0,0,,Эксорцисттің заттары екі.
Dialogue: 0,0:11:45.32,0:11:47.32,Default,,0,0,0,,Бірі мынау.
Dialogue: 0,0:11:47.32,0:11:48.32,Default,,0,0,0,,Құпия.
Dialogue: 0,0:11:48.32,0:11:52.32,Default,,0,0,0,,Сіз оны ешқашан ұстай алмайсыз.
Dialogue: 0,0:11:52.32,0:11:54.32,Default,,0,0,0,,Егер сіз оны ұстасаңыз, оны қалай жасайсыз?
Dialogue: 0,0:11:54.32,0:12:00.32,Default,,0,0,0,,Бұл қиын нәрсе.
Dialogue: 0,0:12:00.32,0:12:02.32,Default,,0,0,0,,Ахсия, сен сондайсың.
Dialogue: 0,0:12:02.32,0:12:05.32,Default,,0,0,0,,Сен шайтансың.
Dialogue: 0,0:12:05.32,0:12:06.32,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:06.32,0:12:07.32,Default,,0,0,0,,Мен сенің дірілдеп тұрған жеріңе асығып барамын
Dialogue: 0,0:12:07.32,0:12:09.32,Default,,0,0,0,,Мен оған тұрарлық па, білмеймін.
Dialogue: 0,0:12:09.32,0:12:11.32,Default,,0,0,0,,Мен сізге кейінірек айтамын.
Dialogue: 0,0:12:11.32,0:12:13.32,Default,,0,0,0,,Және басқа нәрсе ...
Dialogue: 0,0:12:13.32,0:12:37.32,Default,,0,0,0,,...
Dialogue: 0,0:12:37.32,0:12:43.20,Default,,0,0,0,,Нойос Момен кездескен кезде, ол менің Құдайым және сенің құдайларың болады...
Dialogue: 0,0:12:44.82,0:12:45.66,Default,,0,0,0,,Al have failed me.
Dialogue: 0,0:12:45.66,0:12:49.66,Default,,0,0,0,,Спикер үнсіз ме, әлде үнсіз ме?
Dialogue: 0,0:12:49.66,0:12:53.86,Default,,0,0,0,,Әрине, жай ғана емес.
Dialogue: 0,0:12:53.86,0:12:57.82,Default,,0,0,0,,Бірақ менде сіз көргіңіз келетін ештеңе жоқ. Мұнда да машина бар.
Dialogue: 0,0:13:02.96,0:13:05.62,Default,,0,0,0,,Мәселе?
Dialogue: 0,0:13:05.62,0:13:09.96,Default,,0,0,0,,О, комиссар, бүгін түнде қараңғыда не істегіңіз келеді?
Dialogue: 0,0:13:11.02,0:13:14.72,Default,,0,0,0,,Ой, аздап істейік.
Dialogue: 0,0:13:19.14,0:13:21.22,Default,,0,0,0,,Сондықтан жазықтық құрылымды?
Dialogue: 0,0:13:21.76,0:13:22.80,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:13:22.80,0:13:27.66,Default,,0,0,0,,Бұл қол жүйесіндегі ең жақсысы сөзсіз.
Dialogue: 0,0:13:27.66,0:13:29.52,Default,,0,0,0,,Ешқандай проблема жоқ.
Dialogue: 0,0:13:29.52,0:13:32.18,Default,,0,0,0,,Пациенттеріңіз бір-біріне өте ерте.
Dialogue: 0,0:13:32.18,0:13:35.38,Default,,0,0,0,,Бірақ менің жеке серіктесім Феникске арналған.
Dialogue: 0,0:13:35.62,0:13:37.62,Default,,0,0,0,,Бұл жақсы нәрсе екенін білесіз бе?
Dialogue: 0,0:13:37.62,0:13:40.62,Default,,0,0,0,,Оны киелі аң дейді.
Dialogue: 0,0:13:40.62,0:13:45.62,Default,,0,0,0,,Бұл жақсы есім.
Dialogue: 0,0:13:45.62,0:13:49.62,Default,,0,0,0,,Бұл жақсы есім, оны қасиетті аң деп те атайды.
Dialogue: 0,0:13:49.62,0:13:52.62,Default,,0,0,0,,Оны қасиетті аң деп те атайды.
Dialogue: 0,0:13:52.62,0:13:54.62,Default,,0,0,0,,Фузими.
Dialogue: 0,0:13:54.62,0:13:56.62,Default,,0,0,0,,Фузими...
Dialogue: 0,0:13:56.62,0:13:58.62,Default,,0,0,0,,Эбису
Dialogue: 0,0:13:58.62,0:14:00.62,Default,,0,0,0,,Барлығы осы. Бұл мүмкін емес дерлік.
Dialogue: 0,0:14:00.62,0:14:04.62,Default,,0,0,0,,Егер сіз шабуыл жасасаңыз, оған бірден орала аласыз.
Dialogue: 0,0:14:04.62,0:14:07.88,Default,,0,0,0,,Лин қуат Голдстер екенін көрсетеді.
Dialogue: 0,0:14:07.88,0:14:10.06,Default,,0,0,0,,Бірақ, міне, серия.
Dialogue: 0,0:14:10.06,0:14:12.62,Default,,0,0,0,,Gooddie G کی сынаққа түседі.
Dialogue: 0,0:14:12.62,0:14:15.86,Default,,0,0,0,,Ұлт негізінен Онның Хоритариаты.
Dialogue: 0,0:14:17.68,0:14:21.50,Default,,0,0,0,,TheNex's Hen — Sandoval франшизасында білікті T ойыны,
Dialogue: 0,0:14:21.50,0:14:24.50,Default,,0,0,0,,- ұзындығы сияқты жаңа рафинг командасы.
Dialogue: 0,0:14:25.26,0:14:28.12,Default,,0,0,0,,Сіз білесіз.
Dialogue: 0,0:14:28.12,0:14:31.50,Default,,0,0,0,,Фузими WWE емес, бірақ шынында да болмайды.
Dialogue: 0,0:14:31.88,0:14:33.76,Default,,0,0,0,,Мм... кешірім сұрағым келді.
Dialogue: 0,0:14:33.76,0:14:39.22,Default,,0,0,0,,What ia não era soco derài ra dienses itDA gibt ebagar the
Dialogue: 0,0:14:39.80,0:14:40.92,Default,,0,0,0,,wie
Dialogue: 0,0:14:40.92,0:14:42.92,Default,,0,0,0,,біз ADADISE-ді іздейміз
Dialogue: 0,0:14:42.92,0:14:45.30,Default,,0,0,0,,қолмен жүгірген сем дар әйелі
Dialogue: 0,0:14:45.30,0:14:48.26,Default,,0,0,0,,Басынан бастап мен десарролло
Dialogue: 0,0:14:48.26,0:14:51.16,Default,,0,0,0,,Бұрынғы сұлулық салоны жылтыр
Dialogue: 0,0:14:51.16,0:14:55.56,Default,,0,0,0,,күн сайын o
Dialogue: 0,0:14:56.10,0:14:59.40,Default,,0,0,0,,Соңғы жасыл анотус
Dialogue: 0,0:14:59.40,0:15:04.40,Default,,0,0,0,,Мен Гримори отбасымын.
Dialogue: 0,0:15:04.40,0:15:08.40,Default,,0,0,0,,Мен Риастың адамы емеспін.
Dialogue: 0,0:15:08.40,0:15:16.40,Default,,0,0,0,,Мен әрқашан Гримори отбасымын.
Dialogue: 0,0:15:16.40,0:15:24.40,Default,,0,0,0,,Мен мұны мақтан тұтамын, бірақ мен Гримори әулетіндегі адам емеспін.
Dialogue: 0,0:15:24.40,0:15:30.40,Default,,0,0,0,,Мен өзімді жақсы көретін адам болғым келеді.
Dialogue: 0,0:15:30.40,0:15:42.40,Default,,0,0,0,,Мен Гримори отбасын жақсы көремін.
Dialogue: 0,0:15:42.40,0:15:47.40,Default,,0,0,0,,Мен осында болғаныма өте қуаныштымын.
Dialogue: 0,0:15:47.40,0:15:52.40,Default,,0,0,0,,Мен Риастың ең жақын досымын.
Dialogue: 0,0:15:52.40,0:15:56.40,Default,,0,0,0,,Риастың ең жақын досы мен болдым.
Dialogue: 0,0:15:56.40,0:16:06.40,Default,,0,0,0,,Мен өзімді жақсы көретін адам емеспін.
Dialogue: 0,0:16:06.40,0:16:10.40,Default,,0,0,0,,Мен өзімді жақсы көретін адаммын.
Dialogue: 0,0:16:10.40,0:16:13.40,Default,,0,0,0,,Бірақ мені жақсы көретін жігіт болса, мен адам емеспін.
Dialogue: 0,0:16:13.40,0:16:14.40,Default,,0,0,0,,Ол Шесфа.
Dialogue: 0,0:16:14.40,0:16:16.40,Default,,0,0,0,,Менің халқым - Люк Ағылшын.
Dialogue: 0,0:16:16.40,0:16:17.40,Default,,0,0,0,,Ол мені бүлдірді.
Dialogue: 0,0:16:17.40,0:16:19.40,Default,,0,0,0,,Ол адам емес.
Dialogue: 0,0:16:19.40,0:16:22.40,Default,,0,0,0,,Бірақ ол менде аяқталды.
Dialogue: 0,0:16:22.40,0:16:23.40,Default,,0,0,0,,Мен оған лайық емеспін.
Dialogue: 0,0:16:23.40,0:16:26.40,Default,,0,0,0,,Ал ispytoOOD мені маған көмектескен адамға апарады.
Dialogue: 0,0:16:26.40,0:16:27.58,Default,,0,0,0,,Олар бәрін бақылауы керек
Dialogue: 0,0:16:27.58,0:16:28.26,Default,,0,0,0,,сондықтан мен тек жүгіріп жатырмын
Dialogue: 0,0:16:28.26,0:16:49.28,Default,,0,0,0,,жоқ
Dialogue: 0,0:16:49.28,0:16:51.70,Default,,0,0,0,,Мм
Dialogue: 0,0:16:51.70,0:16:55.24,Default,,0,0,0,,Сонымен
Dialogue: 0,0:16:55.24,0:16:56.24,Default,,0,0,0,,Мен жалғыз емеспін.
Dialogue: 0,0:16:56.24,0:16:59.24,Default,,0,0,0,,Бірақ мен бір ғана адаммын.
Dialogue: 0,0:16:59.24,0:17:01.24,Default,,0,0,0,,Мен жай ғана адаммын.
Dialogue: 0,0:17:01.24,0:17:06.24,Default,,0,0,0,,Мен жалғыз емеспін.
Dialogue: 0,0:17:06.24,0:17:15.24,Default,,0,0,0,,Сабырлы болғаныңызды қалаймын.
Dialogue: 0,0:17:15.24,0:17:17.24,Default,,0,0,0,,Мен жалғыз емеспін.
Dialogue: 0,0:17:17.24,0:17:20.24,Default,,0,0,0,,Ендеше, енді демалайық.
Dialogue: 0,0:17:20.24,0:17:37.24,Default,,0,0,0,,Мен жалғыз емеспін.
Dialogue: 0,0:17:40.24,0:17:43.24,Default,,0,0,0,,Күшейткіш тетіктерді қолданыңыз, Yisse.
Dialogue: 0,0:17:43.24,0:17:47.24,Default,,0,0,0,,Бірақ мен бұл құрылғыны пайдаланбаймын.
Dialogue: 0,0:17:47.24,0:17:52.24,Default,,0,0,0,,Бұл құрылғыны орындау мүмкін емес.
Dialogue: 0,0:17:52.24,0:17:55.24,Default,,0,0,0,,Кешіріңіз, solamente.
Dialogue: 0,0:17:55.24,0:17:59.24,Default,,0,0,0,,Сонымен, егер бізде әскери Тута болса,
Dialogue: 0,0:17:59.24,0:18:02.24,Default,,0,0,0,,бізде энозин болмайды.
