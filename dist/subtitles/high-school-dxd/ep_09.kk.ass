Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.42,Default,,0,0,0,,.
Dialogue: 0,0:00:06.42,0:00:23.06,Default,,0,0,0,,Исеки де күлді.
Dialogue: 0,0:00:23.06,0:00:25.94,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:00:25.94,0:00:29.64,Default,,0,0,0,,Мен келдім.
Dialogue: 0,0:00:29.64,0:00:53.92,Default,,0,0,0,,Иә,
Dialogue: 0,0:00:53.92,0:01:01.46,Default,,0,0,0,,О, мынаны ыңғайлырақ көрейік.
Dialogue: 0,0:01:09.26,0:01:12.30,Default,,0,0,0,,Мұнда жалғыз, тағы не көр!
Dialogue: 0,0:01:12.30,0:01:15.02,Default,,0,0,0,,Енді бірге барайық.
Dialogue: 0,0:01:15.02,0:01:17.26,Default,,0,0,0,,Бірінші істеу керек пе?
Dialogue: 0,0:01:17.26,0:01:19.06,Default,,0,0,0,,Плаужм әскерге барады.
Dialogue: 0,0:01:19.06,0:01:21.00,Default,,0,0,0,,Сіз талапшылсыз.
Dialogue: 0,0:01:21.00,0:01:25.00,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:01:25.00,0:01:31.00,Default,,0,0,0,,Та-да!
Dialogue: 0,0:01:31.00,0:01:33.00,Default,,0,0,0,,Сәлем, Киба.
Dialogue: 0,0:01:33.00,0:01:35.00,Default,,0,0,0,,Сіз бұрын ұрысқансыз,
Dialogue: 0,0:01:35.00,0:01:39.00,Default,,0,0,0,,сіз ғибадатхана мен ғибадатхананың жауын жек көретініңізді айттыңыз.
Dialogue: 0,0:01:39.00,0:01:41.00,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:01:41.00,0:01:45.00,Default,,0,0,0,,Мен өзім ғибадатхананың жауын ұнатпаймын.
Dialogue: 0,0:01:45.00,0:01:47.00,Default,,0,0,0,,Мен жек көрмеймін.
Dialogue: 0,0:01:47.00,0:01:48.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:48.00,0:01:52.00,Default,,0,0,0,,Ицсей-кун мен Азия-санды ғибадатхана құтқарды.
Dialogue: 0,0:01:52.00,0:01:54.00,Default,,0,0,0,,Сіз де дәл солай болдыңыз.
Dialogue: 0,0:01:54.00,0:01:58.00,Default,,0,0,0,,Сонымен, біз ғибадатхана үшін жеңіске жетуіміз керек.
Dialogue: 0,0:01:58.00,0:01:59.00,Default,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:01:59.00,0:02:01.00,Default,,0,0,0,,Әрине, мүлдем!
Dialogue: 0,0:02:01.00,0:02:03.00,Default,,0,0,0,,1-сабақ!
Dialogue: 0,0:02:03.00,0:02:05.00,Default,,0,0,0,,Мен айтқанымдай,
Dialogue: 0,0:02:05.00,0:02:07.00,Default,,0,0,0,,Адам, ол қандай ұлт болуы керек еді?
Dialogue: 0,0:02:07.00,0:02:10.00,Default,,0,0,0,,Сіз тек қылыштың қимылы емессіз.
Dialogue: 0,0:02:10.00,0:02:12.00,Default,,0,0,0,,Жауды да, жауды да көруге болады.
Dialogue: 0,0:02:12.00,0:02:15.00,Default,,0,0,0,,Сіз...
Dialogue: 0,0:02:15.00,0:02:17.00,Default,,0,0,0,,О, мынаны қара!
Dialogue: 0,0:02:17.00,0:02:19.00,Default,,0,0,0,,Сіз...
Dialogue: 0,0:02:19.00,0:02:20.00,Default,,0,0,0,,Келмейік...
Dialogue: 0,0:02:20.00,0:02:22.00,Default,,0,0,0,,2-сабақ.
Dialogue: 0,0:02:22.00,0:02:27.00,Default,,0,0,0,,Жау аурадан бүкіл денені ала алады.
Dialogue: 0,0:02:27.00,0:02:35.00,Default,,0,0,0,,Сіз...
Dialogue: 0,0:02:35.00,0:02:36.00,Default,,0,0,0,,Жер
Dialogue: 0,0:02:36.00,0:02:40.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:40.00,0:02:41.00,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:02:41.00,0:02:44.00,Default,,0,0,0,,Ол періштелердің құдіретіне ие болуы мүмкін деп ойлады,
Dialogue: 0,0:02:44.00,0:02:52.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:52.00,0:02:53.00,Default,,0,0,0,,20 маусымға дейін...
Dialogue: 0,0:02:53.00,0:02:54.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:54.00,0:02:55.00,Default,,0,0,0,,Қай уақытта...
Dialogue: 0,0:02:55.00,0:02:56.00,Default,,0,0,0,,Білсең,
Dialogue: 0,0:02:56.00,0:02:57.00,Default,,0,0,0,,сакрамо...
Dialogue: 0,0:02:57.00,0:02:58.00,Default,,0,0,0,,пена...
Dialogue: 0,0:02:58.00,0:02:59.00,Default,,0,0,0,,Кангеами...
Dialogue: 0,0:02:59.00,0:03:00.00,Default,,0,0,0,,Құрметті...
Dialogue: 0,0:03:00.00,0:03:02.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:02.00,0:03:04.00,Default,,0,0,0,,(Тик-так, тик-так соғады сағат)
Dialogue: 0,0:03:04.00,0:03:09.00,Default,,0,0,0,,Сіз әрқашан сиқырдың сиқырын сақтауға тырысасыз.
Dialogue: 0,0:03:09.00,0:03:11.00,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:03:11.00,0:03:13.00,Default,,0,0,0,,Сиқырдың сиқыры – бейне.
Dialogue: 0,0:03:13.00,0:03:17.00,Default,,0,0,0,,Ақылдың сиқырын оның жасырын екенін жасау маңызды.
Dialogue: 0,0:03:17.00,0:03:20.00,Default,,0,0,0,,Ақылдың сиқыры жасырылған.
Dialogue: 0,0:03:20.00,0:03:22.00,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:03:22.00,0:03:24.00,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:03:24.00,0:03:28.00,Default,,0,0,0,,Оны сақтаңыз.
Dialogue: 0,0:03:28.00,0:03:33.00,Default,,0,0,0,,Мен туралы не ойлайсың?
Dialogue: 0,0:03:33.00,0:03:35.00,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:03:35.00,0:03:36.00,Default,,0,0,0,,Иссей?
Dialogue: 0,0:03:36.00,0:03:39.00,Default,,0,0,0,,Жоқ, менің жолым жоқ!
Dialogue: 0,0:03:39.00,0:03:41.00,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:03:41.00,0:03:43.00,Default,,0,0,0,,3-сабақ.
Dialogue: 0,0:03:43.00,0:03:46.00,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:03:46.00,0:03:48.00,Default,,0,0,0,,Ол әлі де бар!
Dialogue: 0,0:03:48.00,0:03:56.00,Default,,0,0,0,,Дененің сиқыры дененің ортасына бағытталып, жаудың нысанасына тиеді.
Dialogue: 0,0:03:58.00,0:04:03.00,Default,,0,0,0,,Бұл тіпті тұрмайды.
Dialogue: 0,0:04:03.00,0:04:05.00,Default,,0,0,0,,Сиқырдың сиқыры жетпейді.
Dialogue: 0,0:04:05.00,0:04:07.00,Default,,0,0,0,,Менің орным жақсы емес.
Dialogue: 0,0:04:07.00,0:04:09.00,Default,,0,0,0,,Әртүрлі ерекшеліктері бар.
Dialogue: 0,0:04:09.00,0:04:11.00,Default,,0,0,0,,Сіздің ерекшеліктеріңіз қандай?
Dialogue: 0,0:04:11.00,0:04:13.00,Default,,0,0,0,,Менің ерекшеліктерім туралы не ойлайсыз?
Dialogue: 0,0:04:13.00,0:04:15.00,Default,,0,0,0,,Бұл зұлымдық мекені.
Dialogue: 0,0:04:15.00,0:04:17.00,Default,,0,0,0,,Және тағы біреуі.
Dialogue: 0,0:04:17.00,0:04:21.00,Default,,0,0,0,,Бұл жұмыс орны.
Dialogue: 0,0:04:22.00,0:04:24.00,Default,,0,0,0,,Мен жасаймын, кішкентай қыз!
Dialogue: 0,0:04:24.00,0:04:26.00,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:04:26.00,0:04:29.00,Default,,0,0,0,,Жер
Dialogue: 0,0:04:29.00,0:04:30.00,Default,,0,0,0,,4-сабақ.
Dialogue: 0,0:04:30.00,0:04:32.00,Default,,0,0,0,,Енді сиқырды қолдан?
Dialogue: 0,0:04:32.00,0:04:34.00,Default,,0,0,0,,Сіз тамақ пісіріп жатырсыз ба?
Dialogue: 0,0:04:34.00,0:04:36.00,Default,,0,0,0,,Әрине, бұл жақсы жер емес.
Dialogue: 0,0:04:36.00,0:04:37.00,Default,,0,0,0,,Бұл жақсы жер емес.
Dialogue: 0,0:04:37.00,0:04:38.00,Default,,0,0,0,,Олай болса, мен істеймін.
Dialogue: 0,0:04:38.00,0:04:40.00,Default,,0,0,0,,Сен жақсысың.
Dialogue: 0,0:04:40.00,0:04:42.00,Default,,0,0,0,,Өтінемін, Юуу.
Dialogue: 0,0:04:42.00,0:04:44.00,Default,,0,0,0,,Анашым!
Dialogue: 0,0:04:44.00,0:05:02.00,Default,,0,0,0,,The
Dialogue: 0,0:05:02.00,0:05:04.00,Default,,0,0,0,,және сіз көңілдісіз.
Dialogue: 0,0:05:04.00,0:05:07.00,Default,,0,0,0,,Әй, бұл жақсы ойын!
Dialogue: 0,0:05:07.00,0:05:09.00,Default,,0,0,0,,Бұл керемет, Иссей!
Dialogue: 0,0:05:09.00,0:05:13.00,Default,,0,0,0,,Дәл сол сезім сол кезде жаман болды, сондықтан бұл нағыз күш.
Dialogue: 0,0:05:13.00,0:05:15.00,Default,,0,0,0,,О, солай!
Dialogue: 0,0:05:15.00,0:05:19.00,Default,,0,0,0,,Бұл менде бұрын болған сезім.
Dialogue: 0,0:05:21.00,0:05:25.00,Default,,0,0,0,,Дұрыс! Мен Secret Gear-ді алғаш бастаған кезім еді.
Dialogue: 0,0:05:25.00,0:05:28.00,Default,,0,0,0,,Дұрыс, бұл...
Dialogue: 0,0:05:28.00,0:05:34.00,Default,,0,0,0,,Маған құйрық шықты!
Dialogue: 0,0:05:34.00,0:05:36.00,Default,,0,0,0,,Иссей-сан!
Dialogue: 0,0:05:36.00,0:05:40.00,Default,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,0:05:40.00,0:05:49.00,Default,,0,0,0,,Сиқырдың күші – бейне.
Dialogue: 0,0:05:49.00,0:05:53.00,Default,,0,0,0,,Оның басында тұрғандай етіп жасау маңызды.
Dialogue: 0,0:05:53.00,0:05:55.00,Default,,0,0,0,,Бәрі басқаша, сондықтан...
Dialogue: 0,0:05:55.00,0:05:57.00,Default,,0,0,0,,Біртүрлі жер екен.
Dialogue: 0,0:05:59.00,0:06:01.00,Default,,0,0,0,,Бұл жақсы нәрсе.
Dialogue: 0,0:06:01.00,0:06:03.00,Default,,0,0,0,,О, бұл жақсы нәрсе емес!
Dialogue: 0,0:06:03.00,0:06:06.00,Default,,0,0,0,,Иссей...
Dialogue: 0,0:06:06.00,0:06:07.00,Default,,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:06:07.00,0:06:10.00,Default,,0,0,0,,Бүгінгі жаттығуда не істедің?
Dialogue: 0,0:06:10.00,0:06:12.00,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:12.00,0:06:14.00,Default,,0,0,0,,Мен ең әлсізмін.
Dialogue: 0,0:06:14.00,0:06:16.00,Default,,0,0,0,,Дұрыс, бұл дұрыс.
Dialogue: 0,0:06:16.00,0:06:20.00,Default,,0,0,0,,Бірақ, Жердің қалпына келуі және күшейтілген беріліс,
Dialogue: 0,0:06:20.00,0:06:23.00,Default,,0,0,0,,Сиқырдың күші өте құнды.
Dialogue: 0,0:06:23.00,0:06:25.00,Default,,0,0,0,,Жау мұны түсінеді, сондықтан...
Dialogue: 0,0:06:25.00,0:06:30.00,Default,,0,0,0,,Мен жаудың аяғының күшін сақтағым келеді.
Dialogue: 0,0:06:30.00,0:06:31.00,Default,,0,0,0,,Мен жаудың күшін жасағым келеді.
Dialogue: 0,0:06:31.00,0:06:34.00,Default,,0,0,0,,Ой, Хиёри-я! Жаңа жылды әзілмен бастап жатырсың ғой, иә?
Dialogue: 0,0:06:34.00,0:06:43.00,Default,,0,0,0,,Ұрысқа түскен менмін.
Dialogue: 0,0:06:43.00,0:06:46.00,Default,,0,0,0,,Ал, кешкі ас ішіп болдық, ендеше жуынатын бөлмеге барайық.
Dialogue: 0,0:06:46.00,0:06:47.00,Default,,0,0,0,,Жер
Dialogue: 0,0:06:47.00,0:06:49.00,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:06:49.00,0:06:50.00,Default,,0,0,0,,Иссей...
Dialogue: 0,0:06:50.00,0:06:51.00,Default,,0,0,0,,Сіз біздің достарымызға кіресіз бе?
Dialogue: 0,0:06:51.00,0:06:52.00,Default,,0,0,0,,Олай болса, менімен бірге кіресің бе?
Dialogue: 0,0:06:52.00,0:06:54.00,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:06:54.00,0:06:55.00,Default,,0,0,0,,Қалай болып жатыр?
Dialogue: 0,0:06:55.00,0:07:00.00,Default,,0,0,0,,Жаудың аяғының арқасын алғым келеді.
Dialogue: 0,0:07:00.00,0:07:02.00,Default,,0,0,0,,Әй, төбелескен мен ғой.
Dialogue: 0,0:07:02.00,0:07:04.00,Default,,0,0,0,,Әй, төбелеске шыққан менмін.
Dialogue: 0,0:07:04.00,0:07:05.00,Default,,0,0,0,,Жарайсың.
Dialogue: 0,0:07:05.00,0:07:06.00,Default,,0,0,0,,Жер
Dialogue: 0,0:07:06.00,0:07:07.00,Default,,0,0,0,,Ит деген не?
Dialogue: 0,0:07:07.00,0:07:09.00,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:07:09.00,0:07:12.00,Default,,0,0,0,,Мен олай емеспін.
Dialogue: 0,0:07:12.00,0:07:13.00,Default,,0,0,0,,Бұл өте жаман.
Dialogue: 0,0:07:13.00,0:07:15.00,Default,,0,0,0,,Жаудың аяғының арқасын аламын.
Dialogue: 0,0:07:15.00,0:07:17.00,Default,,0,0,0,,Әрине.
Dialogue: 0,0:07:17.00,0:07:18.00,Default,,0,0,0,,шолақ мылтық
Dialogue: 0,0:07:18.00,0:07:20.00,Default,,0,0,0,,เร Шивани
Dialogue: 0,0:07:20.00,0:07:25.00,Default,,0,0,0,,мұнда біздің барлық дәмдер керемет.
Dialogue: 0,0:07:25.00,0:07:30.00,Default,,0,0,0,,Өкінішке орай, қоғамдық фику еріп жүрмеді.
Dialogue: 0,0:07:30.00,0:07:35.00,Default,,0,0,0,,Күн сайын, Күлгін?
Dialogue: 0,0:07:35.00,0:07:36.00,Default,,0,0,0,,Күн сайын, бұл өте жақсы.
Dialogue: 0,0:07:36.00,0:07:39.48,Default,,0,0,0,,дәрігер
Dialogue: 0,0:07:42.12,0:07:44.36,Default,,0,0,0,,мұнда
Dialogue: 0,0:07:46.50,0:07:47.80,Default,,0,0,0,,Сонымен
Dialogue: 0,0:07:47.80,0:07:49.08,Default,,0,0,0,,Бір қолымда оқпен зарядталған винтовка
Dialogue: 0,0:07:49.08,0:07:50.10,Default,,0,0,0,,а
Dialogue: 0,0:07:50.10,0:07:51.60,Default,,0,0,0,,логикалық
Dialogue: 0,0:07:53.76,0:07:56.44,Default,,0,0,0,,Quero
Dialogue: 0,0:07:57.96,0:08:00.32,Default,,0,0,0,,немесе
Dialogue: 0,0:08:02.12,0:08:03.16,Default,,0,0,0,,Бір қолымда оқпен зарядталған винтовка
Dialogue: 0,0:08:03.16,0:08:06.16,Default,,0,0,0,,Бұл менің күшім! Менің күшім!
Dialogue: 0,0:08:24.16,0:08:26.16,Default,,0,0,0,,Менің ойымша, солай болды.
Dialogue: 0,0:08:26.16,0:08:27.16,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:08:28.16,0:08:30.16,Default,,0,0,0,,Бұл Риас сияқты.
Dialogue: 0,0:08:30.16,0:08:32.16,Default,,0,0,0,,Бұл сенің жеңісің деп ойлаймын.
Dialogue: 0,0:08:32.16,0:08:34.16,Default,,0,0,0,,Менің ойымша, бұл дұрыс емес.
Dialogue: 0,0:08:34.16,0:08:36.16,Default,,0,0,0,,Мен сенің олай емес екеніңді білемін.
Dialogue: 0,0:08:36.16,0:08:41.16,Default,,0,0,0,,Мен сізге таңдау бере алатыныма сенімді емеспін.
Dialogue: 0,0:08:41.16,0:08:43.16,Default,,0,0,0,,Бұл Риастың шешімі.
Dialogue: 0,0:08:43.16,0:08:46.16,Default,,0,0,0,,Мен сенің жақсы екеніңді білмеймін.
Dialogue: 0,0:08:46.16,0:08:47.16,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:08:57.16,0:08:59.16,Default,,0,0,0,,Мен ең болмағанда алған ақшамды қайтарып бергім келеді.
Dialogue: 0,0:09:02.16,0:09:09.16,Default,,0,0,0,,Бұл Consilo помощы Смит туралы электрондық хат алып жатыр!
Dialogue: 0,0:09:09.16,0:09:15.16,Default,,0,0,0,,О
Dialogue: 0,0:09:15.16,0:09:19.16,Default,,0,0,0,,Сіз мұны істей алмайсыз
Dialogue: 0,0:09:19.16,0:09:27.16,Default,,0,0,0,,О
Dialogue: 0,0:09:27.16,0:09:29.16,Default,,0,0,0,,Мен саған сыйлық бергім келеді
Dialogue: 0,0:09:29.16,0:09:31.16,Default,,0,0,0,,О, сен сондай шынайысың
Dialogue: 0,0:09:31.16,0:09:33.16,Default,,0,0,0,,Мұның бәрі тек менің алаңдаған жүрегімді жылдамдатты
Dialogue: 0,0:09:33.16,0:09:39.16,Default,,0,0,0,,О
Dialogue: 0,0:09:41.16,0:09:43.16,Default,,0,0,0,,О
