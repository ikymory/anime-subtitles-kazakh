Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Келесі - Allium!
Dialogue: 0,0:00:06.24,0:00:08.44,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:00:09.26,0:00:10.02,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:00:10.32,0:00:11.78,Default,,0,0,0,,Исей үйленеді!
Dialogue: 0,0:00:12.04,0:00:13.88,Default,,0,0,0,,Бұл қастандықтың бір түрі!
Dialogue: 0,0:00:14.08,0:00:15.02,Default,,0,0,0,,Неке?
Dialogue: 0,0:00:15.38,0:00:17.96,Default,,0,0,0,,Исей, менің тұңғыш немерем қыз!
Dialogue: 0,0:00:18.78,0:00:22.96,Default,,0,0,0,,Мен үлкен тұлға болып өскен, нәпсіқұмарлықпен ғана мақтанған дәрменсіз бала едім.
Dialogue: 0,0:00:22.96,0:00:23.74,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:00:24.00,0:00:26.42,Default,,0,0,0,,Айналаңа қарама, Исей.
Dialogue: 0,0:00:26.42,0:00:27.26,Default,,0,0,0,,Директор!
Dialogue: 0,0:00:27.26,0:00:30.18,Default,,0,0,0,,Кя! Риас-сама, сен әдемісің!
Dialogue: 0,0:00:30.60,0:00:33.34,Default,,0,0,0,,О, Риас-оне-сама, сен неге ол кісімен жүрсің?
Dialogue: 0,0:00:33.70,0:00:36.30,Default,,0,0,0,,Ой, мен менеджерге үйленемін бе?
Dialogue: 0,0:00:37.78,0:00:38.74,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:00:38.86,0:00:39.56,Default,,0,0,0,,Керемет рөл...
Dialogue: 0,0:00:39.56,0:00:41.62,Default,,0,0,0,,Мен мұны білмей тұрып, жағдай осылай болды!
Dialogue: 0,0:00:42.18,0:00:45.90,Default,,0,0,0,,Егер сіз арманыңыздағы менеджерге үйленсеңіз, ешқандай қиындық болмайды!
Dialogue: 0,0:00:46.12,0:00:46.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:46.96,0:00:48.84,Default,,0,0,0,,Дегенмен, неке дегеніміз балалы болу!
Dialogue: 0,0:00:49.12,0:00:50.88,Default,,0,0,0,,Балалы болуды айтсам, той кітабы!
Dialogue: 0,0:00:51.42,0:00:52.10,Default,,0,0,0,,Дәмді...
Dialogue: 0,0:00:52.10,0:00:55.94,Default,,0,0,0,,Қош келдің, Истай
Dialogue: 0,0:00:55.94,0:00:58.86,Default,,0,0,0,,Енді, ант сүйісі...
Dialogue: 0,0:00:58.86,0:00:59.36,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:00:59.36,0:01:03.48,Default,,0,0,0,,Поцелу!
Dialogue: 0,0:01:03.48,0:01:04.40,Default,,0,0,0,,Е!
Dialogue: 0,0:01:04.40,0:01:07.40,Default,,0,0,0,,Бұл өте қызық болып барады, қарғыс атқыр бала...
Dialogue: 0,0:01:07.40,0:01:09.32,Default,,0,0,0,,Мен қазір естіп тұрған дауыс, бір жерде...
Dialogue: 0,0:01:09.32,0:01:10.82,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:01:10.82,0:01:14.74,Default,,0,0,0,,Дұрыс...Мен сенің ішіңдемін...
Dialogue: 0,0:01:14.74,0:01:15.74,Default,,0,0,0,,Бұл кім!?
Dialogue: 0,0:01:15.74,0:01:16.74,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:01:16.74,0:01:20.66,Default,,0,0,0,,Бұл сіз айтқан нәрсе...
Dialogue: 0,0:01:20.66,0:01:25.66,Default,,0,0,0,,Даусыңыз маған жетпеді, әлсірегендіктен болар...
Dialogue: 0,0:01:25.66,0:01:26.16,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:26.16,0:01:28.66,Default,,0,0,0,,Не дегенің, түсініксіз нәрсе айтып тұрсың!
Dialogue: 0,0:01:28.66,0:01:30.66,Default,,0,0,0,,Мен жай ғана сәлем айтқым келді...
Dialogue: 0,0:01:30.66,0:01:33.66,Default,,0,0,0,,Бұдан былай бірге күресуде менің серіктесім боласың...
Dialogue: 0,0:01:33.66,0:01:34.66,Default,,0,0,0,,Серіктес!?
Dialogue: 0,0:01:34.66,0:01:36.66,Default,,0,0,0,,Сіз...
Dialogue: 0,0:01:36.66,0:01:39.58,Default,,0,0,0,,Сіз бұрыннан білуіңіз керек...
Dialogue: 0,0:01:39.58,0:01:40.58,Default,,0,0,0,,Олай емес...
Dialogue: 0,0:01:40.58,0:01:41.58,Default,,0,0,0,,Дос…
Dialogue: 0,0:01:41.58,0:01:42.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:42.58,0:01:43.58,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:43.58,0:01:46.50,Default,,0,0,0,,Увааааааааааааааааааааааааааааааа!
Dialogue: 0,0:01:46.50,0:01:47.50,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:01:47.50,0:01:48.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:48.50,0:01:49.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:49.50,0:01:52.50,Default,,0,0,0,,Иә...
Dialogue: 0,0:01:52.50,0:01:59.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:59.50,0:02:02.50,Default,,0,0,0,,Сіз өте ұйықтап жатқан сияқтысыз...
Dialogue: 0,0:02:02.50,0:02:06.00,Default,,0,0,0,,Әй, біртүрлі түс көрдім, ұйқым қашты...
Dialogue: 0,0:02:06.00,0:02:06.84,Default,,0,0,0,,Ештеңе!
Dialogue: 0,0:02:06.84,0:02:09.00,Default,,0,0,0,,Егер сізде эротикалық түс көрсеңіз, онда ол туралы айтыңыз!
Dialogue: 0,0:02:09.00,0:02:10.50,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:10.50,0:02:13.42,Default,,0,0,0,,Кешіріңіз, Исай-сан...
Dialogue: 0,0:02:13.42,0:02:16.42,Default,,0,0,0,,Мен сенімен тезірек сөйлесуге барсам ғой...
Dialogue: 0,0:02:16.42,0:02:17.92,Default,,0,0,0,,Жарайды, Асия!
Dialogue: 0,0:02:17.92,0:02:19.42,Default,,0,0,0,,Ұйықтау менің кінәм болды...
Dialogue: 0,0:02:19.42,0:02:20.42,Default,,0,0,0,,Құрметті Исекку!
Dialogue: 0,0:02:20.42,0:02:22.54,Default,,0,0,0,,Сіз Асиядан сізді оятуын сұрайсыз ба?
Dialogue: 0,0:02:22.54,0:02:24.42,Default,,0,0,0,,Бұл табиғи нәрсе!
Dialogue: 0,0:02:24.42,0:02:24.92,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:24.92,0:02:27.54,Default,,0,0,0,,Бір шаңырақтың астында өмір сүріп жатырмыз ғой...
Dialogue: 0,0:02:27.54,0:02:28.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:28.62,0:02:30.88,Default,,0,0,0,,Исай мырза ұйықтаушы...
Dialogue: 0,0:02:30.88,0:02:33.20,Default,,0,0,0,,Олай болса, тамақ алайық...
Dialogue: 0,0:02:33.20,0:02:36.58,Default,,0,0,0,,Әсияны анасы да зейінді бала деп мақтады...
Dialogue: 0,0:02:36.58,0:02:38.74,Default,,0,0,0,,Бұл мені ұятқа қалдырады...
Dialogue: 0,0:02:38.74,0:02:39.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:39.96,0:02:42.88,Default,,0,0,0,,Неге осындай сұлу қыздар тек сенің айналаңда?
Dialogue: 0,0:02:42.88,0:02:45.30,Default,,0,0,0,,Осы қисынсыздықтың кесірінен үзіліп кететін сияқтымын!
Dialogue: 0,0:02:45.30,0:02:46.30,Default,,0,0,0,,Эй, менің ең жақын досым...
Dialogue: 0,0:02:46.30,0:02:51.26,Default,,0,0,0,,Келісуге болады, бірақ ең болмаса бір адамды таныстырсаңыз, жазаланбайсыз деп ойлаймын...
Dialogue: 0,0:02:51.26,0:02:53.18,Default,,0,0,0,,Дұрысы, мені біреумен таныстырыңызшы!
Dialogue: 0,0:02:53.18,0:02:54.80,Default,,0,0,0,,Өтінемін! Өтінемін!
Dialogue: 0,0:02:54.80,0:02:59.22,Default,,0,0,0,,Айтсаң да... бәрі шайтан...
Dialogue: 0,0:02:59.22,0:03:03.14,Default,,0,0,0,,Егер сіз мені таныстырсаңыз, мен сізге лайықты сыпайылық көрсеткім келеді...
Dialogue: 0,0:03:03.14,0:03:05.64,Default,,0,0,0,,Әй, не дейсің...
Dialogue: 0,0:03:05.64,0:03:07.60,Default,,0,0,0,,Айтуға тура келсе...
Dialogue: 0,0:03:07.60,0:03:09.22,Default,,0,0,0,,Джентельменнің VIP орны...
Dialogue: 0,0:03:09.22,0:03:10.64,Default,,0,0,0,,Эй, сәл күте тұрыңыз!
Dialogue: 0,0:03:10.64,0:03:13.56,Default,,0,0,0,,Бір бала жақсы болды...
Dialogue: 0,0:03:13.56,0:03:14.56,Default,,0,0,0,,О, шынымен!
Dialogue: 0,0:03:14.56,0:03:16.48,Default,,0,0,0,,Мен сені бүгін де көргім келеді...
Dialogue: 0,0:03:16.48,0:03:17.48,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:03:17.48,0:03:19.40,Default,,0,0,0,,Олар достарын да әкелеміз деді!
Dialogue: 0,0:03:19.40,0:03:21.40,Default,,0,0,0,,Сонымен, ол қандай бала?
Dialogue: 0,0:03:21.40,0:03:23.90,Default,,0,0,0,,Ал, ол қыз...
Dialogue: 0,0:03:23.90,0:03:24.90,Default,,0,0,0,,Сөзсіз...
Dialogue: 0,0:03:24.90,0:03:26.18,Default,,0,0,0,,Қыз!
Dialogue: 0,0:03:26.18,0:03:27.06,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:27.06,0:03:28.98,Default,,0,0,0,,Айтпақшы, аты...
Dialogue: 0,0:03:28.98,0:03:30.46,Default,,0,0,0,,Pfft…
Dialogue: 0,0:03:30.46,0:03:31.70,Default,,0,0,0,,Милтан…
Dialogue: 0,0:03:31.70,0:03:34.36,Default,,0,0,0,,!
Dialogue: 0,0:03:34.36,0:03:35.60,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:03:35.60,0:03:36.90,Default,,0,0,0,,Ей, көмектес! Оның алдыңғы тістерін жұлып ал—мен оларды тіс дәрігеріне апарамын!
Dialogue: 0,0:03:36.90,0:03:38.12,Default,,0,0,0,,Мына қыздың кеудесін қарашы...
Dialogue: 0,0:03:38.12,0:03:40.24,Default,,0,0,0,,Қан терден құтыласыз!
Dialogue: 0,0:03:40.24,0:03:43.70,Default,,0,0,0,,Мен тапқан супер пип-орын туралы не ойлайсыз? НАТО...
Dialogue: 0,0:03:44.16,0:03:45.90,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:03:46.02,0:03:48.28,Default,,0,0,0,,Эй, мына мысық!
Dialogue: 0,0:03:48.90,0:03:53.08,Default,,0,0,0,,О, құдайым-ай, раушан дәруінің екпіні қандай!
Dialogue: 0,0:03:53.08,0:03:58.08,Default,,0,0,0,,Ми жадына сақтаңыз! Сақтық көшірме HD сапасында аяқталды!
Dialogue: 0,0:04:03.08,0:04:06.08,Default,,0,0,0,,Мына жұдырық! Мүмкін емес!
Dialogue: 0,0:04:12.08,0:04:13.08,Default,,0,0,0,,Қамырды турбо!
Dialogue: 0,0:04:16.08,0:04:18.08,Default,,0,0,0,,Сәлем, котенка!
Dialogue: 0,0:04:18.08,0:04:19.08,Default,,0,0,0,,Қандай таңғаларлық сәйкестік!
Dialogue: 0,0:04:19.08,0:04:21.08,Default,,0,0,0,,Бұл сұмдық!
Dialogue: 0,0:04:23.08,0:04:26.08,Default,,0,0,0,,Уф! Ол аурады!
Dialogue: 0,0:04:26.08,0:04:28.08,Default,,0,0,0,,Амансың ба? Исай-сан?
Dialogue: 0,0:04:28.08,0:04:30.08,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:04:30.08,0:04:32.08,Default,,0,0,0,,Сен неге олайсың?
Dialogue: 0,0:04:32.08,0:04:35.08,Default,,0,0,0,,Жоқ, мені досым шақырды.
Dialogue: 0,0:04:35.08,0:04:39.08,Default,,0,0,0,,Исей мырза, мені сонша жалаңаш көргіңіз келсе, бұл мен!
Dialogue: 0,0:04:39.08,0:04:42.08,Default,,0,0,0,,О, жоқ, Аша, олай емес!
Dialogue: 0,0:04:42.08,0:04:46.08,Default,,0,0,0,,Иә, барлығы бірден. Менен сұрасаң, маған көрсетесің бе?
Dialogue: 0,0:04:46.08,0:04:47.08,Default,,0,0,0,,Директор!
Dialogue: 0,0:04:47.08,0:04:51.08,Default,,0,0,0,,Мен оны бірнеше рет көрсеттім, солай ма?
Dialogue: 0,0:04:51.08,0:04:53.08,Default,,0,0,0,,Жарайды, бұл рас.
Dialogue: 0,0:04:53.08,0:04:56.08,Default,,0,0,0,,Иссей-санның толқыған жүзін естімедім.
Dialogue: 0,0:04:56.08,0:04:59.08,Default,,0,0,0,,Бұл дұрыс емес. Тыңда, Аша!
Dialogue: 0,0:04:59.08,0:05:05.46,Default,,0,0,0,,Маған Исей-санның нұрлы жүзі ұнамайды.
Dialogue: 0,0:05:05.46,0:05:07.94,Default,,0,0,0,,Маған қателескенімді айтшы, Азият.
Dialogue: 0,0:05:07.94,0:05:10.30,Default,,0,0,0,,Бірақ бұл біртүрлі.
Dialogue: 0,0:05:10.30,0:05:10.80,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:05:11.92,0:05:14.56,Default,,0,0,0,,Иссей-кунды қай жерге шақыру керектігі туралы сауалнама
Dialogue: 0,0:05:14.56,0:05:16.70,Default,,0,0,0,,Әр адамның беделі жақсы.
Dialogue: 0,0:05:16.70,0:05:20.02,Default,,0,0,0,,Көңілді болдыңыз ба, әлде көңілді болдыңыз ба?
Dialogue: 0,0:05:20.02,0:05:24.90,Default,,0,0,0,,Сіз менімен болған кезден басқа барлық келісім-шарттар сәтсіз аяқталды.
Dialogue: 0,0:05:24.90,0:05:27.18,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:05:27.18,0:05:31.38,Default,,0,0,0,,Мен шайтан ретінде дисквалификацияланатын едім.
Dialogue: 0,0:05:31.38,0:05:33.72,Default,,0,0,0,,Барлық клиенттер риза болды.
Dialogue: 0,0:05:33.72,0:05:37.18,Default,,0,0,0,,Оны қалай түсіндіруім керек?
Dialogue: 0,0:05:37.18,0:05:38.32,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:05:38.32,0:05:40.82,Default,,0,0,0,,Бірақ Иссей-кун - Иссей-кун
Dialogue: 0,0:05:40.82,0:05:42.20,Default,,0,0,0,,Мұның мағынасы осы емес пе?
Dialogue: 0,0:05:42.20,0:05:42.70,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:05:43.72,0:05:45.84,Default,,0,0,0,,Өткен күні менің таныс семсерім де солай.
Dialogue: 0,0:05:45.84,0:05:49.82,Default,,0,0,0,,Мен бұл Эсейдің өзіне деген сенімін жоғалтады деп ойладым.
Dialogue: 0,0:05:49.82,0:05:54.72,Default,,0,0,0,,Сондықтан мен саған жақсырақ қарауым керек.
Dialogue: 0,0:05:54.72,0:05:56.64,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:05:56.64,0:05:59.04,Default,,0,0,0,,Сіз әдеттен тыс белсендісіз.
Dialogue: 0,0:05:59.04,0:06:00.84,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:01.34,0:06:04.18,Default,,0,0,0,,Себебі мен сені осы уақытқа дейін корпорацияшы деп ойладым.
Dialogue: 0,0:06:04.18,0:06:08.28,Default,,0,0,0,,Бірақ оған тым қатал болма.
Dialogue: 0,0:06:08.28,0:06:11.18,Default,,0,0,0,,Риас
Dialogue: 0,0:06:11.18,0:06:12.38,Default,,0,0,0,,Сен
Dialogue: 0,0:06:12.38,0:06:14.90,Default,,0,0,0,,Ең жақын досыңның сені уайымдауы жаман емес.
Dialogue: 0,0:06:14.90,0:06:17.68,Default,,0,0,0,,Өйткені бұл менің проблемам
Dialogue: 0,0:06:17.68,0:06:21.36,Default,,0,0,0,,Ал клуб бөлмесінде сіз менеджерсіз, солай ма?
Dialogue: 0,0:06:23.10,0:06:23.92,Default,,0,0,0,,Иә, директор
Dialogue: 0,0:06:23.92,0:06:31.22,Default,,0,0,0,,Алдын ала кешірім сұраймын.
Dialogue: 0,0:06:31.22,0:06:31.72,Default,,0,0,0,,Иә
Dialogue: 0,0:06:31.66,0:06:33.10,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:06:33.10,0:06:55.90,Default,,0,0,0,,О
Dialogue: 0,0:06:55.90,0:06:58.14,Default,,0,0,0,,Котенка мені жек көреді
Dialogue: 0,0:06:58.14,0:07:00.54,Default,,0,0,0,,Мен онша жақсы емеспін.
Dialogue: 0,0:07:00.54,0:07:01.04,Default,,0,0,0,,О
Dialogue: 0,0:07:00.94,0:07:02.94,Default,,0,0,0,,Сіз қалай күйзеліске түсе аласыз?
Dialogue: 0,0:07:02.94,0:07:03.94,Default,,0,0,0,,О
Dialogue: 0,0:07:03.94,0:07:05.34,Default,,0,0,0,,Мен гарем патшасы боламын
Dialogue: 0,0:07:05.34,0:07:06.34,Default,,0,0,0,,О
Dialogue: 0,0:07:06.34,0:07:08.34,Default,,0,0,0,,Әзірше мен өзімді кәсіби адам ретінде сергітіп жатырмын.
Dialogue: 0,0:07:08.34,0:07:14.34,Default,,0,0,0,,О
Dialogue: 0,0:07:14.34,0:07:17.24,Default,,0,0,0,,Мен неге айқайладым?
Dialogue: 0,0:07:17.24,0:07:19.54,Default,,0,0,0,,Кешіріңіз, мен ол жерде болмаймын.
Dialogue: 0,0:07:19.54,0:07:20.04,Default,,0,0,0,,О
Dialogue: 0,0:07:19.74,0:07:22.74,Default,,0,0,0,,Уф
Dialogue: 0,0:07:22.74,0:07:24.94,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:24.94,0:07:26.24,Default,,0,0,0,,Ах!!
Dialogue: 0,0:07:26.24,0:07:27.44,Default,,0,0,0,,Бұл
Dialogue: 0,0:07:27.44,0:07:29.74,Default,,0,0,0,,Ер
Dialogue: 0,0:07:29.74,0:07:32.94,Default,,0,0,0,,Мен оны бірінші рет көрдім, сондықтан
Dialogue: 0,0:07:32.94,0:07:35.04,Default,,0,0,0,,Мен ренжідім
Dialogue: 0,0:07:35.04,0:07:36.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:36.04,0:07:39.04,Default,,0,0,0,,Мен ойладым.
Dialogue: 0,0:07:39.04,0:07:41.64,Default,,0,0,0,,Ашаның барын байқамадым.
Dialogue: 0,0:07:41.64,0:07:43.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:43.24,0:07:45.24,Default,,0,0,0,,Бірақ
Dialogue: 0,0:07:47.24,0:07:48.24,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:48.24,0:07:50.24,Default,,0,0,0,,Не
Dialogue: 0,0:07:50.24,0:07:52.24,Default,,0,0,0,,Жапон моншаларында
Dialogue: 0,0:07:52.24,0:07:55.24,Default,,0,0,0,,Мен біреумен кездесіп жүрсің деген ереже бар деп естідім.
Dialogue: 0,0:07:55.24,0:07:56.24,Default,,0,0,0,,Ережелер
Dialogue: 0,0:07:56.24,0:07:57.24,Default,,0,0,0,,Иә
Dialogue: 0,0:07:57.24,0:08:00.24,Default,,0,0,0,,Ваннада өзара әрекеттесу арқылы
Dialogue: 0,0:08:00.24,0:08:03.24,Default,,0,0,0,,Бір-бірін тереңірек тану
Dialogue: 0,0:08:03.24,0:08:07.24,Default,,0,0,0,,Аша қателеспейді, бірақ сәл өшіп қалды.
Dialogue: 0,0:08:07.24,0:08:07.74,Default,,0,0,0,,Шынында да, сен бөлексің…
Dialogue: 0,0:08:07.74,0:08:08.24,Default,,0,0,0,,Мен
Dialogue: 0,0:08:08.24,0:08:09.74,Default,,0,0,0,,Гиссен мырзамен
Dialogue: 0,0:08:09.74,0:08:11.74,Default,,0,0,0,,Мен тереңірек барғым келеді.
Dialogue: 0,0:08:11.74,0:08:13.74,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:08:13.74,0:08:15.74,Default,,0,0,0,,Менің ойымша, Райсен жалаңаш адамдарды көргенді ұнатады.
Dialogue: 0,0:08:15.74,0:08:16.74,Default,,0,0,0,,Уф
Dialogue: 0,0:08:16.74,0:08:18.74,Default,,0,0,0,,Ууууууууууу, шыда, шыда
Dialogue: 0,0:08:18.74,0:08:19.74,Default,,0,0,0,,Менің өрлеуім
Dialogue: 0,0:08:19.74,0:08:24.74,Default,,0,0,0,,Уф
Dialogue: 0,0:08:24.74,0:08:28.90,Default,,0,0,0,,Азия, жалаңаш араласу деген жоқ.
Dialogue: 0,0:08:28.90,0:08:30.36,Default,,0,0,0,,Дәлірек айтсақ, ол қыз.
Dialogue: 0,0:08:30.36,0:08:33.50,Default,,0,0,0,,Ер адам ваннаға кіргенде, ең алдымен қорғаныс әрекетін жасау керек.
Dialogue: 0,0:08:33.50,0:08:36.98,Default,,0,0,0,,Асия-чан, мен орамалды осында қалдырамын.
Dialogue: 0,0:08:36.98,0:08:42.60,Default,,0,0,0,,Мен эротикалық емеспін, мен бұзық емеспін
Dialogue: 0,0:08:42.60,0:08:44.58,Default,,0,0,0,,Азияны қорғауға тиіс адам болу
Dialogue: 0,0:08:44.58,0:08:47.98,Default,,0,0,0,,Мен Азиямен бірге тұрамын, бірақ тентек ештеңе ойлай алмаймын.
Dialogue: 0,0:08:47.98,0:08:48.72,Default,,0,0,0,,ішу
Dialogue: 0,0:08:48.72,0:08:53.04,Default,,0,0,0,,Жындардың сутраларды айтуы жақсы емес.
Dialogue: 0,0:08:53.04,0:08:56.42,Default,,0,0,0,,Мен Буддалыққа қалай қол жеткізе аламын?
Dialogue: 0,0:08:56.42,0:08:59.30,Default,,0,0,0,,А, сиқыршы?
Dialogue: 0,0:08:59.30,0:09:03.94,Default,,0,0,0,,Әй, менеджер.
Dialogue: 0,0:09:03.94,0:09:07.26,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:09:07.26,0:09:09.68,Default,,0,0,0,,О, күте тұрыңыз.
Dialogue: 0,0:09:09.68,0:09:10.78,Default,,0,0,0,,Барлығы бірден
Dialogue: 0,0:09:10.78,0:09:14.38,Default,,0,0,0,,Мені ұста
Dialogue: 0,0:09:14.38,0:09:16.22,Default,,0,0,0,,А, иә
Dialogue: 0,0:09:16.22,0:09:19.32,Default,,0,0,0,,Менің қыздығымды алыңыз
Dialogue: 0,0:09:19.32,0:09:20.48,Default,,0,0,0,,Сізден мүмкіндігінше тезірек өтінемін.
Dialogue: 0,0:09:20.48,0:09:33.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:33.86,0:09:35.80,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:35.80,0:09:38.96,Default,,0,0,0,,Сонымен, сіз өзіңіздің алғашқы тәжірибеңіздің серіктесі ретінде таңдалдыңыз ба?
Dialogue: 0,0:09:39.86,0:09:41.46,Default,,0,0,0,,Бұл қорқынышты...
Dialogue: 0,0:09:41.46,0:09:43.86,Default,,0,0,0,,Бұлай ойламас бұрын, ойыңды дайында...
Dialogue: 0,0:09:43.86,0:09:46.12,Default,,0,0,0,,Мен мұны істей алмаймын ба?
Dialogue: 0,0:09:46.12,0:09:47.24,Default,,0,0,0,,Жоқ, жоқ, бұл дұрыс емес...
Dialogue: 0,0:09:47.24,0:09:50.62,Default,,0,0,0,,Мен бұл туралы көп ойладым, бірақ бұл жалғыз жол.
Dialogue: 0,0:09:50.62,0:09:52.62,Default,,0,0,0,,А, қалай?
Dialogue: 0,0:09:52.62,0:09:53.62,Default,,0,0,0,,А, а...
Dialogue: 0,0:09:53.62,0:09:56.62,Default,,0,0,0,,Fait accompli анықталғаннан кейін ешқандай шағымдар болмауы керек.
Dialogue: 0,0:09:56.62,0:10:00.62,Default,,0,0,0,,Сізге әлі де кейбір салаларда жетіспеушілік бар, бірақ сізде әлеует бар.
Dialogue: 0,0:10:00.62,0:10:02.62,Default,,0,0,0,,Әй, сөйлесетін ештеңе жоқ...
Dialogue: 0,0:10:02.62,0:10:07.00,Default,,0,0,0,,Оның үстіне, ол сұрағаннан кейін бірнеше минут ішінде Джорджда болатын сияқты.
Dialogue: 0,0:10:07.00,0:10:08.00,Default,,0,0,0,,А, а...
Dialogue: 0,0:10:08.00,0:10:10.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:10.00,0:10:11.00,Default,,0,0,0,,Директор…
Dialogue: 0,0:10:11.00,0:10:13.00,Default,,0,0,0,,Бұл не деген...
Dialogue: 0,0:10:13.00,0:10:14.00,Default,,0,0,0,,Иссей…
Dialogue: 0,0:10:14.00,0:10:16.00,Default,,0,0,0,,Бұл бірінші рет...
Dialogue: 0,0:10:16.00,0:10:17.00,Default,,0,0,0,,А, иә...
Dialogue: 0,0:10:17.00,0:10:18.00,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:18.00,0:10:23.38,Default,,0,0,0,,Бір-бірімізге жете алмайтын тұстар болуы мүмкін, бірақ әйтеуір бірдеңе жасайық.
Dialogue: 0,0:10:23.38,0:10:25.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:25.00,0:10:26.38,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:10:26.38,0:10:28.82,Default,,0,0,0,,Мен сізді осында сыйғыза аламын.
Dialogue: 0,0:10:28.82,0:10:32.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:32.88,0:10:34.58,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:10:34.58,0:10:36.46,Default,,0,0,0,,Мен де қобалжыдым.
Dialogue: 0,0:10:36.46,0:10:38.26,Default,,0,0,0,,А, иә...
Dialogue: 0,0:10:38.26,0:10:40.26,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,0:10:40.26,0:10:44.46,Default,,0,0,0,,Өткен жолы уақыт аяқталды, бірақ бұл жолы есеп жоқ.
Dialogue: 0,0:10:44.46,0:10:46.00,Default,,0,0,0,,Мм, бірақ...
Dialogue: 0,0:10:46.00,0:10:48.50,Default,,0,0,0,,Мен біраз сенімсізмін.
Dialogue: 0,0:10:48.50,0:10:50.64,Default,,0,0,0,,Маған ұят па?
Dialogue: 0,0:10:50.64,0:10:51.76,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:51.76,0:10:54.46,Default,,0,0,0,,Бұл менмін, менеджер!
Dialogue: 0,0:11:02.88,0:11:05.88,Default,,0,0,0,,Сәл кешігіп қалған сияқтысыз.
Dialogue: 0,0:11:05.88,0:11:11.88,Default,,0,0,0,,Кемеден түскен осы адаммен...
Dialogue: 0,0:11:11.88,0:11:15.26,Default,,0,0,0,,Күйеуім мен Сирзечтер мұңаяды.
Dialogue: 0,0:11:15.26,0:11:17.00,Default,,0,0,0,,Сирзехтер?
Dialogue: 0,0:11:17.00,0:11:18.26,Default,,0,0,0,,Менің ағам
Dialogue: 0,0:11:18.26,0:11:20.46,Default,,0,0,0,,Әй, менеджердің ағасы!?
Dialogue: 0,0:11:20.46,0:11:23.00,Default,,0,0,0,,Менің гимнастика менікі
Dialogue: 0,0:11:23.00,0:11:27.00,Default,,0,0,0,,Мен мақұлдайтын нәрсеге арнаудың несі жаман?
Dialogue: 0,0:11:27.00,0:11:28.84,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:11:28.84,0:11:32.74,Default,,0,0,0,,Мен сүйкімді қызметшімді түсіруге шақыруға рұқсат бермеймін.
Dialogue: 0,0:11:32.74,0:11:35.98,Default,,0,0,0,,Менің ағамның ханшайымы болсаң да
Dialogue: 0,0:11:35.98,0:11:38.98,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:38.98,0:11:40.82,Default,,0,0,0,,Апа, мен өскенде,
Dialogue: 0,0:11:40.82,0:11:44.12,Default,,0,0,0,,Сіз Гремори отбасының басшысысыз.
Dialogue: 0,0:11:46.26,0:11:48.26,Default,,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:11:51.60,0:11:53.16,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:11:53.16,0:11:57.26,Default,,0,0,0,,Менің атым Грейфия, мен Гремори отбасында жұмыс істеймін.
Dialogue: 0,0:11:57.26,0:11:58.76,Default,,0,0,0,,Мен сені кейін көремін.
Dialogue: 0,0:11:58.76,0:11:59.86,Default,,0,0,0,,А, иә!
Dialogue: 0,0:11:59.86,0:12:01.70,Default,,0,0,0,,Қандай әдемі адам!
Dialogue: 0,0:12:01.70,0:12:02.94,Default,,0,0,0,,Сәлем Нана!
Dialogue: 0,0:12:02.94,0:12:05.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.44,0:12:06.94,Default,,0,0,0,,Кешіріңіз Иссей
Dialogue: 0,0:12:06.94,0:12:08.94,Default,,0,0,0,,Мен де сабырлы емес едім.
Dialogue: 0,0:12:08.94,0:12:09.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:09.94,0:12:11.44,Default,,0,0,0,,Бір-бірімізді ұмытайық
Dialogue: 0,0:12:11.44,0:12:13.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:13.28,0:12:14.82,Default,,0,0,0,,Иссей?
Dialogue: 0,0:12:14.82,0:12:16.44,Default,,0,0,0,,Мен бұл жақсы болады деп ойламадым ...
Dialogue: 0,0:12:16.44,0:12:17.28,Default,,0,0,0,,Тек ол ғана жұтылып кеткен азаматтардың өкпе-ренішін қайтара алады
Dialogue: 0,0:12:17.28,0:12:18.82,Default,,0,0,0,,Менің поп…
Dialogue: 0,0:12:18.82,0:12:21.06,Default,,0,0,0,,Күшейтілген беріліс бар
Dialogue: 0,0:12:21.06,0:12:23.06,Default,,0,0,0,,Айдаһар императорының иелігіндегілер
Dialogue: 0,0:12:23.06,0:12:24.30,Default,,0,0,0,,Осындай бала...
Dialogue: 0,0:12:24.30,0:12:25.30,Default,,0,0,0,,Мұндай бала...
Dialogue: 0,0:12:25.30,0:12:26.80,Default,,0,0,0,,Не...бұл не...
Dialogue: 0,0:12:26.80,0:12:29.04,Default,,0,0,0,,Әңгімені өз ойыммен тыңдаймын.
Dialogue: 0,0:12:29.04,0:12:30.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:30.04,0:12:31.28,Default,,0,0,0,,Сол Яноны өзіңізбен бірге ала аласыз, солай ма?
Dialogue: 0,0:12:31.28,0:12:33.10,Default,,0,0,0,,Сіз Иказучидің киелі қызысыз ​​ба?
Dialogue: 0,0:12:33.10,0:12:34.44,Default,,0,0,0,,(Браффорд) Лорд Дио маған өмір сыйлады—
Dialogue: 0,0:12:34.44,0:12:37.12,Default,,0,0,0,,Жоғары тұрған шайтан дегеніміз не?
Dialogue: 0,0:12:37.12,0:12:39.66,Default,,0,0,0,,Жаныңызда патшайым болуы әдетке айналған.
Dialogue: 0,0:12:39.66,0:12:44.08,Default,,0,0,0,,Сіз маған қиындық тудырдыңыз.
Dialogue: 0,0:12:44.08,0:12:44.72,Default,,0,0,0,,Иссей
Dialogue: 0,0:12:44.72,0:12:53.34,Default,,0,0,0,,Бүгін кешке мені кешіріңіз.
Dialogue: 0,0:12:53.34,0:13:04.16,Default,,0,0,0,,Менеджер кеше түнде не істеді деп ойлаймын.
Dialogue: 0,0:13:04.16,0:13:07.46,Default,,0,0,0,,Бірдеңе әдеттен тыс сияқты.
Dialogue: 0,0:13:07.46,0:13:12.96,Default,,0,0,0,,Бүгін таңертең сендер радикалдысыңдар.
Dialogue: 0,0:13:12.96,0:13:14.06,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:13:14.06,0:13:16.12,Default,,0,0,0,,Оны қолтырауын көрді.
Dialogue: 0,0:13:16.12,0:13:18.56,Default,,0,0,0,,Қалай қарасаң да, бұл жекпе-жек өнерпаздарының қас жауы.
Dialogue: 0,0:13:18.56,0:13:21.02,Default,,0,0,0,,Бұл жерде неге готикалық лолиталар бар?
Dialogue: 0,0:13:21.02,0:13:22.40,Default,,0,0,0,,Ең жоғарғы қару?
Dialogue: 0,0:13:22.40,0:13:24.28,Default,,0,0,0,,Қараңдаршы, мен бақсыларға тәнтімін.
Dialogue: 0,0:13:24.28,0:13:25.62,Default,,0,0,0,,Ол сүйкімді бала еді
Dialogue: 0,0:13:25.62,0:13:27.36,Default,,0,0,0,,Менімен алмасуға бола ма?
Dialogue: 0,0:13:27.36,0:13:28.86,Default,,0,0,0,,Түйсік неде?
Dialogue: 0,0:13:28.86,0:13:29.82,Default,,0,0,0,,Мен сені еркек деп атаймын
Dialogue: 0,0:13:29.82,0:13:32.06,Default,,0,0,0,,Оның үстіне әйелдер киінген адамдар жиналады.
Dialogue: 0,0:13:32.06,0:13:33.88,Default,,0,0,0,,Бұл тозақтан келген кездесу болды.
Dialogue: 0,0:13:33.88,0:13:34.94,Default,,0,0,0,,Бұл қорқынышты болды
Dialogue: 0,0:13:34.94,0:13:36.74,Default,,0,0,0,,Мен өлемін деп ойладым.
Dialogue: 0,0:13:36.74,0:13:37.42,Default,,0,0,0,,(JoJo) Дүрбелең шығарма!
Dialogue: 0,0:13:37.42,0:13:38.96,Default,,0,0,0,,Сиқырлы әлем туралы
Dialogue: 0,0:13:38.96,0:13:42.22,Default,,0,0,0,,Бұл не, Террапин сиқырлы әлемі?
Dialogue: 0,0:13:42.22,0:13:46.12,Default,,0,0,0,,Бұл менеджердің мәселесі.
Dialogue: 0,0:13:46.12,0:13:49.70,Default,,0,0,0,,Бұл Гремори отбасына қатысты болуы мүмкін.
Dialogue: 0,0:13:49.70,0:13:51.94,Default,,0,0,0,,Қызық, Әкено мырза бірдеңе біледі ме?
Dialogue: 0,0:13:51.94,0:13:55.50,Default,,0,0,0,,Ол кісі менеджердің қалталы пышағы шығар.
Dialogue: 0,0:13:55.50,0:13:57.90,Default,,0,0,0,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 0,0:13:57.90,0:14:01.10,Default,,0,0,0,,Мен мұны мұнда келгенде ғана байқадым.
Dialogue: 0,0:14:01.10,0:14:02.82,Default,,0,0,0,,Бұл қызметші
Dialogue: 0,0:14:02.82,0:14:04.50,Default,,0,0,0,,Таңдау
Dialogue: 0,0:14:04.50,0:14:07.40,Default,,0,0,0,,Грейфия-сан
Dialogue: 0,0:14:07.40,0:14:10.16,Default,,0,0,0,,Біз бәріміз осындамыз.
Dialogue: 0,0:14:10.16,0:14:10.76,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:14:10.76,0:14:13.32,Default,,0,0,0,,Мен сөйлесейін бе?
Dialogue: 0,0:14:13.32,0:14:16.14,Default,,0,0,0,,Шынында…
Dialogue: 0,0:14:16.14,0:14:23.92,Default,,0,0,0,,Феникс
Dialogue: 0,0:14:23.92,0:14:29.48,Default,,0,0,0,,Адамзат әлеміне көп уақыт өтті
Dialogue: 0,0:14:29.48,0:14:32.88,Default,,0,0,0,,Мен сені көруге келдім.
Dialogue: 0,0:14:32.88,0:14:34.74,Default,,0,0,0,,Құрметті Риас
Dialogue: 0,0:14:34.74,0:14:36.58,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:14:36.58,0:14:39.26,Default,,0,0,0,,Бұл адам Ризер Феникс.
Dialogue: 0,0:14:39.26,0:14:41.60,Default,,0,0,0,,Тазалықтың жоғары дәрежелі жын.
Dialogue: 0,0:14:41.60,0:14:43.44,Default,,0,0,0,,Феникс отбасының үшінші ұлы
Dialogue: 0,0:14:43.44,0:14:44.90,Default,,0,0,0,,Феникс тұқымдасы
Dialogue: 0,0:14:44.90,0:14:48.16,Default,,0,0,0,,Ал Гремори отбасының келесі басшысы дөрекі.
Dialogue: 0,0:14:48.16,0:14:49.92,Default,,0,0,0,,Гремори отбасының басшысы
Dialogue: 0,0:14:49.92,0:14:51.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:51.00,0:14:52.10,Default,,0,0,0,,Яғни
Dialogue: 0,0:14:52.10,0:14:55.52,Default,,0,0,0,,Мен Риас-саманың күйеу жігітімін.
Dialogue: 0,0:14:55.52,0:14:56.68,Default,,0,0,0,,Келіссөз
Dialogue: 0,0:14:56.68,0:15:00.12,Default,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:15:00.12,0:15:02.22,Default,,0,0,0,,Риас патшайымы маған дайындаған шай
Dialogue: 0,0:15:02.22,0:15:03.72,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:15:03.72,0:15:05.72,Default,,0,0,0,,Ауырды.
Dialogue: 0,0:15:05.72,0:15:07.72,Default,,0,0,0,,Керемет жігіт
Dialogue: 0,0:15:07.72,0:15:10.06,Default,,0,0,0,,Сіз менеджердің қалыңдығымын дейсіз бе?
Dialogue: 0,0:15:10.06,0:15:15.86,Default,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:15:15.86,0:15:16.78,Default,,0,0,0,,Көтергіштер
Dialogue: 0,0:15:16.78,0:15:18.18,Default,,0,0,0,,Мен мұны бұрын да айтқанмын.
Dialogue: 0,0:15:18.18,0:15:20.78,Default,,0,0,0,,Мен саған үйленбеймін
Dialogue: 0,0:15:20.78,0:15:22.16,Default,,0,0,0,,Бірақ Риас
Dialogue: 0,0:15:22.16,0:15:24.08,Default,,0,0,0,,Сіздің отбасылық жағдайыңыз қандай?
Dialogue: 0,0:15:24.08,0:15:26.06,Default,,0,0,0,,Мұндай өзімшілдік нәтиже бермейді
Dialogue: 0,0:15:26.06,0:15:28.00,Default,,0,0,0,,Менің ойымша, сіз шарасыз екенсіз.
Dialogue: 0,0:15:28.00,0:15:30.24,Default,,0,0,0,,Менің үйді қирату ойым жоқ.
Dialogue: 0,0:15:30.24,0:15:32.40,Default,,0,0,0,,Біз тіпті жұмыссыз газеттерді де қарсы алуға ниеттіміз.
Dialogue: 0,0:15:32.40,0:15:33.72,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:15:33.72,0:15:36.20,Default,,0,0,0,,Мен өзім ұнатқанға үйленемін
Dialogue: 0,0:15:36.20,0:15:40.62,Default,,0,0,0,,Өткен соғыста күрт азайған таза қанды жындардың қанын сақтау нені білдіреді?
Dialogue: 0,0:15:40.62,0:15:43.16,Default,,0,0,0,,Бұл да жалпы шайтанға қатысты мәселе.
Dialogue: 0,0:15:43.16,0:15:45.88,Default,,0,0,0,,Сенің әкең де, Сирзехтер де.
Dialogue: 0,0:15:45.88,0:15:48.16,Default,,0,0,0,,Мен болашақты ойлап, бұл неке туралы шешім қабылдадым.
Dialogue: 0,0:15:48.16,0:15:50.82,Default,,0,0,0,,Әкесі, ағасы, отбасы мүшелері
Dialogue: 0,0:15:50.82,0:15:52.72,Default,,0,0,0,,Барлығы тым асығыс.
Dialogue: 0,0:15:53.56,0:15:54.90,Default,,0,0,0,,Мен оны енді ешқашан айтпаймын
Dialogue: 0,0:15:54.90,0:15:56.72,Default,,0,0,0,,Көтергіш
Dialogue: 0,0:15:56.72,0:15:58.56,Default,,0,0,0,,Мен саған үйленбеймін
Dialogue: 0,0:15:58.56,0:16:01.26,Default,,0,0,0,,Мен де Ария
Dialogue: 0,0:16:01.26,0:16:04.74,Default,,0,0,0,,Ол арқасында Феникс отбасы белгісін алып жүр.
Dialogue: 0,0:16:04.74,0:16:07.66,Default,,0,0,0,,Мен атыма кір келтіре алмаймын.
Dialogue: 0,0:16:07.66,0:16:09.54,Default,,0,0,0,,Вусионг
Dialogue: 0,0:16:09.54,0:16:13.88,Default,,0,0,0,,Мен сенің барлық ағашыңды өртеп жіберсем де
Dialogue: 0,0:16:13.88,0:16:16.32,Default,,0,0,0,,Мен сені жер асты әлеміне қайтарамын
Dialogue: 0,0:16:16.32,0:16:20.80,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:16:20.80,0:16:21.72,Default,,0,0,0,,Райзер мырза
Dialogue: 0,0:16:21.72,0:16:25.86,Default,,0,0,0,,Мен мұнда Сирзехтердің көз алдындамын.
Dialogue: 0,0:16:25.86,0:16:28.14,Default,,0,0,0,,Біз ештеңені ұстанбаймыз.
Dialogue: 0,0:16:28.14,0:16:33.70,Default,,0,0,0,,Ең күшті патшайым ретінде танылған сіз сізге осындай сөздер айтса
Dialogue: 0,0:16:33.70,0:16:35.88,Default,,0,0,0,,Күткендей мен де қорқамын.
Dialogue: 0,0:16:35.88,0:16:39.54,Default,,0,0,0,,Күйеулеріңіз де осылай болады деп күткен.
Dialogue: 0,0:16:39.54,0:16:42.68,Default,,0,0,0,,Сондықтан бұзылған жағдайда соңғы шара
Dialogue: 0,0:16:42.68,0:16:43.96,Default,,0,0,0,,Мен Ousei қолданамын.
Dialogue: 0,0:16:43.96,0:16:45.96,Default,,0,0,0,,Соңғы шара?
Dialogue: 0,0:16:45.96,0:16:47.44,Default,,0,0,0,,Сіз нені айтасыз? Грейфин
Dialogue: 0,0:16:47.44,0:16:51.96,Default,,0,0,0,,Егер жас ханым өз еркін орындағысы келсе,
Dialogue: 0,0:16:51.96,0:16:55.38,Default,,0,0,0,,Мен Ризер-самамен рейтингтік ойынға ұқсас нәрсені шешкім келеді.
Dialogue: 0,0:16:55.38,0:16:57.28,Default,,0,0,0,,Бағалау ойыны?
Dialogue: 0,0:16:58.10,0:16:58.80,Default,,0,0,0,,Бір жерде?
Dialogue: 0,0:17:00.34,0:17:00.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:01.56,0:17:03.44,Default,,0,0,0,,Студенттік кеңес төрағасының осылай айтқанына сенімдімін!
Dialogue: 0,0:17:04.38,0:17:06.12,Default,,0,0,0,,Таразы бар жынның орындауында
Dialogue: 0,0:17:06.12,0:17:09.84,Default,,0,0,0,,Бұл шахматқа ұқсас ойын, мұнда төменгі ағаштарды бір-біріне қарсы қою арқылы жарысады.
Dialogue: 0,0:17:09.84,0:17:10.66,Default,,0,0,0,,Шахмат?
Dialogue: 0,0:17:10.66,0:17:16.24,Default,,0,0,0,,Бізде шахмат фигурасына ұқсайтын күшке ие болу себебі - бұл жаман фигураның
Dialogue: 0,0:17:16.24,0:17:17.66,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:17:18.66,0:17:19.76,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:17:19.76,0:17:23.90,Default,,0,0,0,,Мен ойынды бірнеше рет ойнадым.
Dialogue: 0,0:17:23.90,0:17:25.78,Default,,0,0,0,,Көптеген жеңімпаздар
Dialogue: 0,0:17:25.78,0:17:27.30,Default,,0,0,0,,Сіз тәжірибеден алыссыз.
Dialogue: 0,0:17:27.30,0:17:30.30,Default,,0,0,0,,Ол әлі ресми ойын ретінде сәйкес келмейді.
Dialogue: 0,0:17:30.30,0:17:35.50,Default,,0,0,0,,Рейтингтік ойынға тек жетілген жындар қатыса алады.
Dialogue: 0,0:17:35.50,0:17:37.80,Default,,0,0,0,,Сонда сіз үлкен кемшілікке тап боласыз.
Dialogue: 0,0:17:37.80,0:17:39.60,Default,,0,0,0,,Бұл жалғыз кемшілік емес.
Dialogue: 0,0:17:39.60,0:17:41.40,Default,,0,0,0,,Airsu
Dialogue: 0,0:17:41.40,0:17:43.86,Default,,0,0,0,,Сенімді болу үшін мен растағым келеді.
Dialogue: 0,0:17:43.86,0:17:46.74,Default,,0,0,0,,Осының бәрі сіздің ағаштарыңызда бар ма?
Dialogue: 0,0:17:47.04,0:17:48.38,Default,,0,0,0,,Ал егер?
Dialogue: 0,0:17:48.38,0:17:58.96,Default,,0,0,0,,Бұл 15 адам
Dialogue: 0,0:17:58.96,0:18:02.96,Default,,0,0,0,,Басқаша айтқанда, сізде бөліктердің толық жиынтығы бар.
Dialogue: 0,0:18:02.96,0:18:09.80,Default,,0,0,0,,Әдемі әйелдер? Бар болғаны 15 сұлу қыз болса ше?
Dialogue: 0,0:18:10.38,0:18:11.38,Default,,0,0,0,,Бұрын айтқаныңнан қарағанда, сен Кирамен бетпе-бет келгендейсің, бірақ
Dialogue: 0,0:18:11.38,0:18:15.38,Default,,0,0,0,,Қандай адам
Dialogue: 0,0:18:15.38,0:18:21.66,Default,,0,0,0,,Эй, Риас, Шимоки-кун, сен маған қарап жылайсың.
Dialogue: 0,0:18:21.66,0:18:24.02,Default,,0,0,0,,Сол баланың арманы - гарем.
Dialogue: 0,0:18:24.02,0:18:25.90,Default,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:18:25.90,0:18:28.36,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:28.36,0:18:29.36,Default,,0,0,0,,деді Беллуна
Dialogue: 0,0:18:29.36,0:18:31.38,Default,,0,0,0,,Иә, Ризер-сама.
Dialogue: 0,0:18:31.38,0:18:37.70,Default,,0,0,0,,Эй
Dialogue: 0,0:18:37.70,0:18:47.98,Default,,0,0,0,,Сіз мұны ешқашан жасай алмайсыз.
Dialogue: 0,0:18:47.98,0:18:50.30,Default,,0,0,0,,Төменгі сынып шайтаны
Dialogue: 0,0:18:50.30,0:18:51.60,Default,,0,0,0,,Шулы
Dialogue: 0,0:18:51.60,0:18:54.06,Default,,0,0,0,,Менеджерге тұрмысқа шыққаннан кейін де осылай жүре берсең.
Dialogue: 0,0:18:54.06,0:18:56.02,Default,,0,0,0,,Сіз басқа қыздармен сырласасыз ба?
Dialogue: 0,0:18:56.02,0:18:57.70,Default,,0,0,0,,Бұл тұқымды илектелген якитори жігіті
Dialogue: 0,0:18:57.70,0:18:58.98,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:18:58.98,0:19:02.44,Default,,0,0,0,,Сіз өз ұстанымыңызды біліп тұрып сөйлейсіз бе?
Dialogue: 0,0:19:02.44,0:19:03.30,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:19:03.30,0:19:04.58,Default,,0,0,0,,Бұл менің ұстанымым.
Dialogue: 0,0:19:04.58,0:19:05.14,Default,,0,0,0,,Тоқтамаңыз
Dialogue: 0,0:19:05.14,0:19:06.34,Default,,0,0,0,,Тек менеджердің ағашы.
Dialogue: 0,0:19:06.34,0:19:08.94,Default,,0,0,0,,Менің ойымша, одан артық болуы дұрыс емес.
Dialogue: 0,0:19:08.94,0:19:10.54,Default,,0,0,0,,Гисссен
Dialogue: 0,0:19:10.54,0:19:12.62,Default,,0,0,0,,Ойындардың қажеті жоқ
Dialogue: 0,0:19:12.62,0:19:14.70,Default,,0,0,0,,Олардың барлығын осы жерде жеңіңіз.
Dialogue: 0,0:19:14.70,0:19:15.82,Default,,0,0,0,,Гиссен мырза
Dialogue: 0,0:19:15.82,0:19:17.02,Default,,0,0,0,,Нера
Dialogue: 0,0:19:17.02,0:19:20.50,Default,,0,0,0,,Сондай кішкентай қыз
Dialogue: 0,0:19:20.50,0:19:22.42,Default,,0,0,0,,Ями Райзен
Dialogue: 0,0:19:22.42,0:19:29.82,Default,,0,0,0,,Гиссен мырза
Dialogue: 0,0:19:29.82,0:19:32.62,Default,,0,0,0,,Гисссен
Dialogue: 0,0:19:32.62,0:19:34.44,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:19:34.44,0:19:37.72,Default,,0,0,0,,Менеджер
Dialogue: 0,0:19:37.72,0:19:40.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:40.04,0:19:48.30,Default,,0,0,0,,Ең күшті және ең қуатты деп саналатын Boosted Gear пайдаланушысы.
Dialogue: 0,0:19:48.30,0:19:51.04,Default,,0,0,0,,Мен оның мұндай түкке тұрғысыз адам болады деп күтпедім.
Dialogue: 0,0:19:51.04,0:19:53.04,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:19:53.04,0:19:56.32,Default,,0,0,0,,Бағалау ойынымен шешейік
Dialogue: 0,0:19:56.32,0:20:00.18,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:20:00.18,0:20:03.64,Default,,0,0,0,,Көтергіштер
Dialogue: 0,0:20:03.64,0:20:08.04,Default,,0,0,0,,Мен сені міндетті түрде сүртемін
Dialogue: 0,0:20:08.04,0:20:09.64,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:20:09.64,0:20:11.04,Default,,0,0,0,,Құрметті Риас
Dialogue: 0,0:20:11.04,0:20:13.40,Default,,0,0,0,,Келесі ойында кездескенше
Dialogue: 0,0:20:13.40,0:20:25.08,Default,,0,0,0,,Иссен
Dialogue: 0,0:20:25.08,0:20:29.06,Default,,0,0,0,,4-сабақ
