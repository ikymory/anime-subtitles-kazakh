Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:36.46,0:00:38.42,Default,,0,0,0,,Бұл балалар Митеминуфури емес.
Dialogue: 0,0:00:38.42,0:00:42.26,Default,,0,0,0,,Мен қарсымын. Бұл сіздердің бұл дүниеде тым көзге түсетіндеріңізді білдіреді.
Dialogue: 0,0:00:44.59,0:00:45.34,Default,,0,0,0,,Мұнда
Dialogue: 0,0:00:46.38,0:00:47.43,Default,,0,0,0,,Қарсы
Dialogue: 0,0:00:48.22,0:00:53.06,Default,,0,0,0,,Қызғаныш пен арандатушылық Митеминуфрилер арасында сізге деген өшпенділік тудырды.
Dialogue: 0,0:00:53.52,0:00:58.73,Default,,0,0,0,,Бет-жүзін көрсетуге батылы жетпесе де, жынды. Ол топ құрғанда күшті.
Dialogue: 0,0:00:59.06,0:01:00.98,Default,,0,0,0,,Жаман болсаң бастықтай боласың.
Dialogue: 0,0:01:01.15,0:01:05.99,Default,,0,0,0,,Қаш, не тығыл, нысана сен, Ел аузында жүрген батырлар.
Dialogue: 0,0:01:07.45,0:01:09.12,Default,,0,0,0,,Біз батырмыз
Dialogue: 0,0:01:14.00,0:01:15.04,Default,,0,0,0,,Шрамы жақсы
Dialogue: 0,0:01:18.21,0:01:18.71,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:20.00,0:01:20.71,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:01:22.63,0:01:23.71,Default,,0,0,0,,Яе Йошида
Dialogue: 0,0:01:24.26,0:01:25.13,Default,,0,0,0,,Йэ Чан
Dialogue: 0,0:01:26.01,0:01:28.22,Default,,0,0,0,,Қоңырау естілгенше осында жасырыңыз.
Dialogue: 0,0:01:29.14,0:01:32.01,Default,,0,0,0,,Миссия шайқассыз аяқталмайды
Dialogue: 0,0:01:32.93,0:01:35.93,Default,,0,0,0,,Ал, статус-кво бүгінгі күні өзгеріссіз қалды.
Dialogue: 0,0:01:36.48,0:01:38.02,Default,,0,0,0,,Қарсы шаралар қарастырылды
Dialogue: 0,0:01:38.44,0:01:41.31,Default,,0,0,0,,Бірақ Я Чан менің кесірімнен зардап шекті.
Dialogue: 0,0:01:41.31,0:01:46.03,Default,,0,0,0,,Мәселе жоқ. Егер сіз жұмыртқаға оралсаңыз, ол ең жылдам жылдамдықпен қалпына келеді.
Dialogue: 0,0:01:48.07,0:01:49.32,Default,,0,0,0,,Сіз оны таптыңыз ба?
Dialogue: 0,0:01:49.86,0:01:53.78,Default,,0,0,0,,Белгіленген уақытқа дейін жұмыртқаны қорғау - басты міндет.
Dialogue: 0,0:01:54.54,0:01:56.75,Default,,0,0,0,,Қоғамның негізі – есеп беру.
Dialogue: 0,0:01:57.04,0:01:58.62,Default,,0,0,0,,Дауыспен бөлісіңіз
Dialogue: 0,0:01:59.29,0:02:01.25,Default,,0,0,0,,Біздің ең үлкен мақсатымыз
Dialogue: 0,0:02:01.79,0:02:02.54,Default,,0,0,0,,Ғажайып
Dialogue: 0,0:02:03.09,0:02:03.88,Default,,0,0,0,,Жұмыртқа
Dialogue: 0,0:02:05.13,0:02:06.21,Default,,0,0,0,,Басымдық
Dialogue: 0,0:03:43.52,0:03:47.02,Default,,0,0,0,,Ай Чан, жүр, таңғы ас ішейік.
Dialogue: 0,0:03:48.15,0:03:50.15,Default,,0,0,0,,Кешегі күн қиын болды.
Dialogue: 0,0:03:50.15,0:03:52.28,Default,,0,0,0,,Эй, оян да, маған көмектес.
Dialogue: 0,0:03:52.78,0:03:54.41,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:02.16,0:04:03.29,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:04:05.21,0:04:05.88,Default,,0,0,0,,Көз
Dialogue: 0,0:04:05.88,0:04:07.29,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:13.05,0:04:14.22,Default,,0,0,0,,Мынаны да жеп ал
Dialogue: 0,0:04:16.18,0:04:20.18,Default,,0,0,0,,Мен бүгін түскі асқа Ай Чанның сүйікті омлет күрішін дайындадым.
Dialogue: 0,0:04:20.18,0:04:21.89,Default,,0,0,0,,Мен мұны шынымен жасадым
Dialogue: 0,0:04:22.89,0:04:25.44,Default,,0,0,0,,Бүгін кешке сукияки ішеміз.
Dialogue: 0,0:04:27.48,0:04:28.19,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:28.52,0:04:31.69,Default,,0,0,0,,Неліктен саған Ай Чан сукияки ұнайды?
Dialogue: 0,0:04:32.19,0:04:34.20,Default,,0,0,0,,Әдетте тек ерекше күндерде
Dialogue: 0,0:04:38.24,0:04:39.24,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:41.41,0:04:46.46,Default,,0,0,0,,Ай-чан, мен бүгін мұғаліммен дұрыс сөйлеспеймін.
Dialogue: 0,0:04:47.12,0:04:50.21,Default,,0,0,0,,Мұғалім Ай-чанға шын көңіл бөледі.
Dialogue: 0,0:04:50.75,0:04:53.96,Default,,0,0,0,,Аз болса да болашақ туралы ойламаңыз.
Dialogue: 0,0:04:57.01,0:04:57.84,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:05:00.22,0:05:01.35,Default,,0,0,0,,Ойлан
Dialogue: 0,0:05:02.39,0:05:03.22,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:05:03.89,0:05:05.27,Default,,0,0,0,,Ойлан
Dialogue: 0,0:05:05.73,0:05:06.56,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:05:25.29,0:05:27.25,Default,,0,0,0,,Сонымен мен бірден мектепке бардым.
Dialogue: 0,0:05:27.25,0:05:27.75,Default,,0,0,0,,Иә
Dialogue: 0,0:05:27.67,0:05:29.88,Default,,0,0,0,,Жылтыр еріндер және панда көздері
Dialogue: 0,0:05:29.88,0:05:30.58,Default,,0,0,0,,Мен қарғыс энергиясын толық қуатыммен дәл сәйкестендіремін
Dialogue: 0,0:05:31.00,0:05:31.59,Default,,0,0,0,,келді
Dialogue: 0,0:05:32.59,0:05:33.09,Default,,0,0,0,,келді
Dialogue: 0,0:05:33.50,0:05:34.26,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:05:36.59,0:05:37.80,Default,,0,0,0,,Өткізіп жіберу
Dialogue: 0,0:05:38.76,0:05:39.64,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:05:39.89,0:05:41.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:41.35,0:05:42.51,Default,,0,0,0,,өршіп тұр
Dialogue: 0,0:05:47.10,0:05:48.35,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:49.06,0:05:51.48,Default,,0,0,0,,Мен білмеймін. Мүмкін бірдеңе болған шығар.
Dialogue: 0,0:05:52.27,0:05:54.48,Default,,0,0,0,,Мен бұрын да осындай қорқынышты түс көргенмін.
Dialogue: 0,0:05:56.82,0:05:58.28,Default,,0,0,0,,Бұл жаман аяқталды.
Dialogue: 0,0:06:00.49,0:06:02.24,Default,,0,0,0,,Күтейік, көрейік
Dialogue: 0,0:06:06.25,0:06:09.16,Default,,0,0,0,,Құттықтаймыз, қашып құтылған сияқтысыз.
Dialogue: 0,0:06:09.62,0:06:12.00,Default,,0,0,0,,Сонда да мен қарсымын.
Dialogue: 0,0:06:12.33,0:06:16.80,Default,,0,0,0,,Біз мұны жасап жатқан сияқты емеспіз, өйткені бізге кейіпкерлер сияқты қарау ұнайды.
Dialogue: 0,0:06:17.34,0:06:19.88,Default,,0,0,0,,Өкінішке орай, логика жұмыс істемейді.
Dialogue: 0,0:06:20.47,0:06:23.39,Default,,0,0,0,,Қай заманда, қай дүниеде болмасын, қадалған қазық қағылады.
Dialogue: 0,0:06:24.64,0:06:27.52,Default,,0,0,0,,Мен қарсы шараларды ойладым, солай ма?
Dialogue: 0,0:06:27.52,0:06:29.52,Default,,0,0,0,,Әй, қарағым, енді келді.
Dialogue: 0,0:06:30.77,0:06:32.02,Default,,0,0,0,,Майдо
Dialogue: 0,0:06:33.86,0:06:37.07,Default,,0,0,0,,Ішінде сізді қолдайтын бір нәрсе бар.
Dialogue: 0,0:06:37.86,0:06:41.32,Default,,0,0,0,,Бұл негізінен көмекші элемент.
Dialogue: 0,0:06:41.95,0:06:42.99,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:43.24,0:06:43.95,Default,,0,0,0,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:06:45.12,0:06:47.58,Default,,0,0,0,,Ал, мен оны үнемі қолданады деп күтпеймін.
Dialogue: 0,0:06:47.95,0:06:51.04,Default,,0,0,0,,Егер сізде сондай жақсы нәрсе болса, оны басынан бастап қойыңыз.
Dialogue: 0,0:06:51.04,0:06:55.25,Default,,0,0,0,,Бұл өте құнды зат, мен оның оңай жоғалғанын қаламас едім.
Dialogue: 0,0:06:55.25,0:06:58.34,Default,,0,0,0,,Бұл бүліну емес, ақымақ болу.
Dialogue: 0,0:07:08.47,0:07:09.52,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:07:10.18,0:07:13.77,Default,,0,0,0,,Бір адамға қызмет етейік, әрине.
Dialogue: 0,0:07:16.02,0:07:17.23,Default,,0,0,0,,Кулон
Dialogue: 0,0:07:17.48,0:07:18.94,Default,,0,0,0,,Бұл помандер. Оны
Dialogue: 0,0:07:21.15,0:07:23.07,Default,,0,0,0,,-де қалай қолдануға болады
Dialogue: 0,0:07:23.28,0:07:25.74,Default,,0,0,0,,Біріншіден, бұл дүниеде люк
Dialogue: 0,0:07:26.03,0:07:26.70,Default,,0,0,0,,штрихтау?
Dialogue: 0,0:07:27.58,0:07:28.99,Default,,0,0,0,,Бұл соншалықты қиын емес
Dialogue: 0,0:07:29.37,0:07:33.79,Default,,0,0,0,,Ол сіздің денеңіздің температурасына әсер етеді, сондықтан оны қолыңызға орап, ақырын ысқылаңыз.
Dialogue: 0,0:07:35.21,0:07:36.38,Default,,0,0,0,,Сіз бұл жерде жасай алмайсыз.
Dialogue: 0,0:07:36.38,0:07:39.17,Default,,0,0,0,,Үйге келіп, жалғыз қалғанда киюім керек.
Dialogue: 0,0:07:39.67,0:07:40.55,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:41.22,0:07:46.01,Default,,0,0,0,,Импринация қажет: бала бірінші рет қараған адамды ата-анасы ретінде таниды.
Dialogue: 0,0:07:46.64,0:07:51.02,Default,,0,0,0,,Вениді жырласаң, жұмыртқадан шығады. Қайта қойғанда, Неби
Dialogue: 0,0:07:51.02,0:07:52.06,Default,,0,0,0,,Латын.
Dialogue: 0,0:07:52.39,0:07:55.02,Default,,0,0,0,,Мен сымбатты ана болғым келеді
Dialogue: 0,0:07:56.23,0:07:58.82,Default,,0,0,0,,Әй, маған қай түр кіреді?
Dialogue: 0,0:07:59.07,0:08:01.69,Default,,0,0,0,,Егер ол басып шығарылмаса, оны ауыстыруға болады.
Dialogue: 0,0:08:01.94,0:08:03.95,Default,,0,0,0,,Нейру Мендікін ауыстырып көрейін бе?
Dialogue: 0,0:08:04.20,0:08:04.95,Default,,0,0,0,,Ұнатпау
Dialogue: 0,0:08:06.57,0:08:08.83,Default,,0,0,0,,Ең ұсқынсыз адамға көмектесіңізші.
Dialogue: 0,0:08:15.04,0:08:15.62,Default,,0,0,0,,Көз
Dialogue: 0,0:08:18.59,0:08:19.75,Default,,0,0,0,,Капитан, 3D маневрге көшейік
Dialogue: 0,0:08:21.63,0:08:23.09,Default,,0,0,0,,Өйткені заттар біртүрлі
Dialogue: 0,0:08:26.43,0:08:27.76,Default,,0,0,0,,Бұл ұзақ, бірақ
Dialogue: 0,0:08:36.44,0:08:38.02,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:48.87,0:08:49.58,Default,,0,0,0,,Вени
Dialogue: 0,0:08:58.63,0:08:59.33,Default,,0,0,0,,Жылан
Dialogue: 0,0:09:01.04,0:09:02.21,Default,,0,0,0,,О, сигналы келіп жатыр, келіп жатыр
Dialogue: 0,0:09:07.34,0:09:08.93,Default,,0,0,0,,Менде реакциялар қиын.
Dialogue: 0,0:09:13.97,0:09:14.85,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:09:15.18,0:09:17.90,Default,,0,0,0,,Жарайды, менің бұл жолы көмекші кейіпкерім бар.
Dialogue: 0,0:09:18.48,0:09:19.06,Default,,0,0,0,,Вени
Dialogue: 0,0:09:27.82,0:09:28.95,Default,,0,0,0,,Сіз оны жедіңіз бе?
Dialogue: 0,0:09:28.95,0:09:31.28,Default,,0,0,0,,Олар антистарды жақсы көреді.
Dialogue: 0,0:09:31.28,0:09:34.50,Default,,0,0,0,,Қызғаныш пен өшпенділік олардың азығы.
Dialogue: 0,0:09:36.50,0:09:37.83,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:09:43.25,0:09:45.34,Default,,0,0,0,,Антилер өте жақсы сияқты.
Dialogue: 0,0:09:46.26,0:09:47.09,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:09:52.26,0:09:54.77,Default,,0,0,0,,Неліктен Яэ Чан өз-өзіне қол жұмсады?
Dialogue: 0,0:09:57.02,0:09:57.85,Default,,0,0,0,,Сіз оны көре аласыз ба?
Dialogue: 0,0:09:58.52,0:09:59.39,Default,,0,0,0,,Мен оларды көріп тұрмын
Dialogue: 0,0:10:00.52,0:10:03.36,Default,,0,0,0,,Өлген адамға қатты кек
Dialogue: 0,0:10:04.11,0:10:06.24,Default,,0,0,0,,Алтыншы сезім дегеніміз не?
Dialogue: 0,0:10:06.24,0:10:09.07,Default,,0,0,0,,Қараңызшы, адамдар маған олай сенбейді.
Dialogue: 0,0:10:09.32,0:10:12.78,Default,,0,0,0,,Мен ғана керемет қорқынышты нәрсені көре аламын
Dialogue: 0,0:10:14.24,0:10:16.91,Default,,0,0,0,,Кешіріңіз, мен түсінбеймін.
Dialogue: 0,0:10:18.16,0:10:21.63,Default,,0,0,0,,Жақсы, менің достарым да енді қорқынышты емес.
Dialogue: 0,0:10:21.63,0:10:23.96,Default,,0,0,0,,Ата-аналар мен мұғалімдер маған сенбейді
Dialogue: 0,0:10:23.96,0:10:27.30,Default,,0,0,0,,Не керек, мен жынды екенмін деп ауруханаға түстім.
Dialogue: 0,0:10:29.13,0:10:31.97,Default,,0,0,0,,Бірақ мен қатты қорықтым.
Dialogue: 0,0:10:33.68,0:10:38.27,Default,,0,0,0,,Сол аурухана қаншама адамның ренішіне толы болды.
Dialogue: 0,0:10:38.56,0:10:42.65,Default,,0,0,0,,Мен елестерді көргеннен гөрі олардың дауыстарын естимін.
Dialogue: 0,0:10:42.98,0:10:47.15,Default,,0,0,0,,Менің басыма күні бойы қорқынышты жүздер жүгірді.
Dialogue: 0,0:10:48.24,0:10:52.20,Default,,0,0,0,,Сабыр ет, мен бір жерден бастыққа дайындалайын.
Dialogue: 0,0:10:52.49,0:10:53.78,Default,,0,0,0,,Қазірдің өзінде бар
Dialogue: 0,0:11:10.97,0:11:12.84,Default,,0,0,0,,Қайырлы кеш, Ото мырза.
Dialogue: 0,0:11:16.47,0:11:17.81,Default,,0,0,0,,Қайырлы кеш.
Dialogue: 0,0:11:18.77,0:11:21.56,Default,,0,0,0,,Кешкі ас уақыты келді, шашыңызды кептіріңіз.
Dialogue: 0,0:11:22.44,0:11:23.44,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:11:23.73,0:11:27.98,Default,,0,0,0,,Жоқ, жарайды, отырыңыз, мұғалім.
Dialogue: 0,0:11:30.15,0:11:31.07,Default,,0,0,0,,бірге
Dialogue: 0,0:11:37.28,0:11:37.99,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:37.99,0:11:39.29,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:41.96,0:11:43.08,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:11:44.63,0:11:46.34,Default,,0,0,0,,Ай Чан, сәл күте тұрыңыз.
Dialogue: 0,0:11:46.92,0:11:47.84,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:11:48.59,0:11:50.80,Default,,0,0,0,,Аналар, менің сізге айтар сөзім бар.
Dialogue: 0,0:11:51.84,0:11:53.80,Default,,0,0,0,,Мектепке тағы біраз
Dialogue: 0,0:11:53.80,0:11:56.39,Default,,0,0,0,,Жоқ, жай отырыңыз.
Dialogue: 0,0:12:07.06,0:12:08.52,Default,,0,0,0,,Тыныштанып тыңдаңыз.
Dialogue: 0,0:12:12.07,0:12:15.86,Default,,0,0,0,,Мен анаммен қыдыруды ойлап жүрмін.
Dialogue: 0,0:12:24.33,0:12:28.54,Default,,0,0,0,,Әрине, мен сенің келісіміңсіз мұны істемеймін.
Dialogue: 0,0:12:42.85,0:12:44.81,Default,,0,0,0,,Ағай мен Айдың анасы
Dialogue: 0,0:12:45.44,0:12:49.65,Default,,0,0,0,,Сондықтан біз туысқан шығармыз.
Dialogue: 0,0:12:50.27,0:12:52.03,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:12:52.61,0:12:53.65,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:12:54.11,0:12:54.90,Default,,0,0,0,,Эй, мен
Dialogue: 0,0:12:56.28,0:12:58.41,Default,,0,0,0,,Бұл бақытты жүз бе?
Dialogue: 0,0:12:58.91,0:13:00.16,Default,,0,0,0,,Мен бұған қарсымын.
Dialogue: 0,0:13:01.95,0:13:05.04,Default,,0,0,0,,Қалағаныңды істе, маған бәрібір
Dialogue: 0,0:13:05.29,0:13:07.50,Default,,0,0,0,,Бұл менің ең жақсы қарсылығым.
Dialogue: 0,0:13:07.87,0:13:10.50,Default,,0,0,0,,Мен сізге болашақта міндетті түрде қамқорлық жасамаймын.
Dialogue: 0,0:13:10.50,0:13:15.13,Default,,0,0,0,,Біз тіпті бірге тұрмаймыз, оны бір жерге тастап, анда-санда ғана барып тұрамыз.
Dialogue: 0,0:13:15.67,0:13:17.68,Default,,0,0,0,,Ұнады, маған қатты тиді.
Dialogue: 0,0:13:18.39,0:13:21.30,Default,,0,0,0,,Нағыз әкеңді неге аяйсың?
Dialogue: 0,0:13:21.81,0:13:26.73,Default,,0,0,0,,Жоқ, ажырасу аяқталды, әкемнің жаңа біреу болуы мүмкін.
Dialogue: 0,0:13:26.98,0:13:28.65,Default,,0,0,0,,Олай болса, проблема жоқ.
Dialogue: 0,0:13:28.73,0:13:30.15,Default,,0,0,0,,Мәселе бар
Dialogue: 0,0:13:31.44,0:13:34.15,Default,,0,0,0,,Момо, сен басқалардың айтқанын тыңдамайсың ба?
Dialogue: 0,0:13:34.15,0:13:38.99,Default,,0,0,0,,Който-чанның өз-өзіне қол жұмсауына ағаңыздың қатысы болуы мүмкін деп отырсыз.
Dialogue: 0,0:13:39.16,0:13:40.74,Default,,0,0,0,,Сондықтан бұл мүмкін емес
Dialogue: 0,0:13:40.74,0:13:42.37,Default,,0,0,0,,Бұл орын алса ше?
Dialogue: 0,0:13:42.37,0:13:44.75,Default,,0,0,0,,Мұғалім анадан кіші, солай ма?
Dialogue: 0,0:13:44.75,0:13:47.25,Default,,0,0,0,,Бұл кіші кәдімгі күйеу дегенді білдіреді.
Dialogue: 0,0:13:47.25,0:13:48.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:48.37,0:13:50.04,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:13:50.46,0:13:53.84,Default,,0,0,0,,Ерлі-зайыптылардың қиянатының шегі жоқ.
Dialogue: 0,0:13:54.00,0:13:58.01,Default,,0,0,0,,Өгей балаға қатысты зорлық-зомбылық, қызына қатысты жыныстық зорлық-зомбылық
Dialogue: 0,0:13:58.18,0:14:03.56,Default,,0,0,0,,Кешіріңіз, бірақ өтінемін, ағаңызды анаңыз кездескен адаммен араластырмаңыз.
Dialogue: 0,0:14:03.56,0:14:04.68,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:14:05.14,0:14:09.94,Default,,0,0,0,,Басқаша айтқанда, мұғалім біз сияқты кішкентай балаларды ұнатады, ал анасы манекен.
Dialogue: 0,0:14:09.94,0:14:12.15,Default,,0,0,0,,Нысананың Аи болу мүмкіндігі бар.
Dialogue: 0,0:14:12.31,0:14:16.78,Default,,0,0,0,,Жоқ, жоқ, ағай Айдың менің досым екенін біледі.
Dialogue: 0,0:14:17.74,0:14:19.70,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:14:21.24,0:14:25.62,Default,,0,0,0,,Алайда мен Който-чанды ұнатпаймын.
Dialogue: 0,0:14:26.29,0:14:30.58,Default,,0,0,0,,Егер мен қайта тұрмысқа шықсам, анам үшін мұғалімімді қорғауым керек.
Dialogue: 0,0:14:31.71,0:14:33.63,Default,,0,0,0,,Сене алар емеспін, таң қалдым
Dialogue: 0,0:14:34.13,0:14:36.59,Default,,0,0,0,,Кешіріңіз, Момо-чан, менің айтқым келгені бұл емес.
Dialogue: 0,0:14:36.96,0:14:39.42,Default,,0,0,0,,Сен не туралы айтып тұрсың?
Dialogue: 0,0:14:39.88,0:14:40.80,Default,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:14:41.18,0:14:45.31,Default,,0,0,0,,Ең болмағанда бұл алқамен қандай киімнің жақсы көрінетіні туралы емес.
Dialogue: 0,0:14:45.81,0:14:50.27,Default,,0,0,0,,Өмір мен өлім үшін күрестен гөрі отбасы мәселесі маңыздырақ болған сияқты.
Dialogue: 0,0:14:51.85,0:14:56.27,Default,,0,0,0,,Сайып келгенде, біз Койтоны тірілтпейінше шындықты білмейміз.
Dialogue: 0,0:14:56.53,0:14:57.98,Default,,0,0,0,,Оккам ұстарасы
Dialogue: 0,0:14:59.11,0:15:01.95,Default,,0,0,0,,Оқиғаны күрделендіретін элемент бар сияқты.
Dialogue: 0,0:15:03.07,0:15:05.91,Default,,0,0,0,,Не? Әлі бірдеңе болып жатыр ма?
Dialogue: 0,0:15:07.29,0:15:08.79,Default,,0,0,0,,Ай да мұғалімді жақсы көреді
Dialogue: 0,0:15:12.71,0:15:14.58,Default,,0,0,0,,Қарапайым теория ең жақсы
Dialogue: 0,0:15:14.58,0:15:17.75,Default,,0,0,0,,Сіз не туралы айтып тұрсыз? Жоқ, олай емес.
Dialogue: 0,0:15:18.84,0:15:21.80,Default,,0,0,0,,Бұл эмоционалды Бұл күрделі эмоционалды
Dialogue: 0,0:15:22.01,0:15:25.47,Default,,0,0,0,,Бұл басқаша болғандықтан, бұл мүмкін емес.
Dialogue: 0,0:15:31.56,0:15:32.69,Default,,0,0,0,,Бетіңді... маған бұр...
Dialogue: 0,0:15:34.48,0:15:35.44,Default,,0,0,0,,Келме
Dialogue: 0,0:15:35.44,0:15:38.48,Default,,0,0,0,,Маған да ұнайтындықтан көре алмаймын.
Dialogue: 0,0:15:38.65,0:15:41.61,Default,,0,0,0,,Мен сенің досың да емеспін.
Dialogue: 0,0:16:03.97,0:16:05.01,Default,,0,0,0,,Бұл
Dialogue: 0,0:16:06.09,0:16:07.51,Default,,0,0,0,,Дайкоку-сан
Dialogue: 0,0:16:08.39,0:16:11.81,Default,,0,0,0,,Бұл келе жатыр, бірақ маған
Dialogue: 0,0:16:12.73,0:16:15.69,Default,,0,0,0,,Өтінемін, баланы өлтірме.
Dialogue: 0,0:16:18.98,0:16:19.98,Default,,0,0,0,,Намаз моншақтары
Dialogue: 0,0:16:22.90,0:16:27.53,Default,,0,0,0,,Әңгіме Който-чан есімді баланың өз-өзіне қол жұмсауына ағаңыздың қатысы болуы мүмкін.
Dialogue: 0,0:16:31.49,0:16:34.83,Default,,0,0,0,,Мен анаммен қыдыруды ойлап жүрмін.
Dialogue: 0,0:16:43.63,0:16:46.47,Default,,0,0,0,,Оқиғаны күрделендіретін элемент бар сияқты.
Dialogue: 0,0:16:48.18,0:16:53.10,Default,,0,0,0,,Кешеннің қажеті жоқ, көздерің өте тартымды.
Dialogue: 0,0:16:56.23,0:16:57.90,Default,,0,0,0,,Ай да мұғалімді жақсы көреді
Dialogue: 0,0:17:01.48,0:17:02.19,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:06.45,0:17:07.61,Default,,0,0,0,,Өйткені ол басқаша.
Dialogue: 0,0:17:08.74,0:17:10.58,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:15.96,0:17:17.25,Default,,0,0,0,,Өйткені ол басқаша.
Dialogue: 0,0:17:17.71,0:17:18.50,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:17:21.54,0:17:24.13,Default,,0,0,0,,Мен жоқ деймін.
Dialogue: 0,0:17:39.23,0:17:43.19,Default,,0,0,0,,Мен Тосакаға келдім.
Dialogue: 0,0:17:53.45,0:17:56.45,Default,,0,0,0,,Әпке, мені көре аласыз ба?
Dialogue: 0,0:17:58.16,0:17:59.83,Default,,0,0,0,,Бірақ біз дос бола алмаймыз
Dialogue: 0,0:18:06.05,0:18:10.64,Default,,0,0,0,,Бұл өте ауыр болды, бұл құбыжықтар жалғыз.
Dialogue: 0,0:18:12.10,0:18:13.56,Default,,0,0,0,,Маған сенесіз бе?
Dialogue: 0,0:18:14.31,0:18:14.97,Default,,0,0,0,,Әрине
Dialogue: 0,0:18:26.74,0:18:30.16,Default,,0,0,0,,Аты Леон, бірақ бәрібір.
Dialogue: 0,0:18:31.61,0:18:32.24,Default,,0,0,0,,Вени
Dialogue: 0,0:18:36.83,0:18:37.33,Default,,0,0,0,,Неби
Dialogue: 0,0:18:42.71,0:18:43.25,Default,,0,0,0,,Вени
Dialogue: 0,0:18:48.72,0:18:51.80,Default,,0,0,0,,Ай-чан, мұғалім сен үйге барасың.
Dialogue: 0,0:18:51.80,0:18:52.89,Default,,0,0,0,,Жақсы, жақсы.
Dialogue: 0,0:18:53.51,0:18:55.85,Default,,0,0,0,,Ото мырза, келесі аптада кездескенше.
Dialogue: 0,0:19:13.28,0:19:16.08,Default,,0,0,0,,Мен үйдемін, Ай Чан, жуынып жатырмын.
Dialogue: 0,0:19:16.79,0:19:17.66,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:19:18.29,0:19:20.54,Default,,0,0,0,,Мен киімімді шешіп қойғанмын.
Dialogue: 0,0:19:20.54,0:19:22.12,Default,,0,0,0,,Анам үнемі солай айтады, солай ма?
Dialogue: 0,0:19:22.29,0:19:25.46,Default,,0,0,0,,Кірге салғанда қалтаңызды сыртқа бұрыңыз.
Dialogue: 0,0:19:27.09,0:19:30.30,Default,,0,0,0,,Мен қалтамдағы заттарды осында қалдырамын.
Dialogue: 0,0:19:36.18,0:19:38.01,Default,,0,0,0,,Эй, Ай Чан
Dialogue: 0,0:19:38.64,0:19:39.35,Default,,0,0,0,,суық тию
Dialogue: 0,0:19:39.35,0:19:40.02,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:42.14,0:19:44.35,Default,,0,0,0,,Сен осылай киініп қайда барасың?
Dialogue: 0,0:19:44.69,0:19:45.48,Default,,0,0,0,,Мектеп
Dialogue: 0,0:20:23.27,0:20:24.85,Default,,0,0,0,,Савапи сау бол
Dialogue: 0,0:20:25.52,0:20:26.52,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:20:29.36,0:20:30.36,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:20:44.66,0:20:45.54,Default,,0,0,0,,Ото мырза
Dialogue: 0,0:20:47.75,0:20:48.71,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:20:55.72,0:20:56.63,Default,,0,0,0,,Ото мырза
Dialogue: 0,0:20:58.30,0:21:00.60,Default,,0,0,0,,Аспан ашық, әдемі
Dialogue: 0,0:21:01.60,0:21:03.18,Default,,0,0,0,,Жаңбыр жауып тұрды емес пе?
Dialogue: 0,0:21:05.89,0:21:06.81,Default,,0,0,0,,Мен
Dialogue: 0,0:21:13.57,0:21:20.28,Default,,0,0,0,,Мен мектепке барамын
Dialogue: 0,0:21:21.78,0:21:26.78,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
