Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.27,0:00:19.19,Default,,0,0,0,,Менің атым Мива.
Dialogue: 0,0:00:20.19,0:00:21.19,Default,,0,0,0,,Мива-чан
Dialogue: 0,0:00:23.69,0:00:24.95,Default,,0,0,0,,Мен Момомын
Dialogue: 0,0:00:25.57,0:00:26.41,Default,,0,0,0,,Шабдалы
Dialogue: 0,0:00:27.95,0:00:28.82,Default,,0,0,0,,Кез келген нәрсе
Dialogue: 0,0:00:29.95,0:00:33.08,Default,,0,0,0,,Олай болса, Момотаро-сан.
Dialogue: 0,0:00:36.00,0:00:36.54,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:00:37.38,0:00:38.17,Default,,0,0,0,,Сонымен
Dialogue: 0,0:00:39.71,0:00:42.80,Default,,0,0,0,,Мені зорлады
Dialogue: 0,0:00:44.80,0:00:47.51,Default,,0,0,0,,Күнде бір адам болды.
Dialogue: 0,0:00:47.97,0:00:51.39,Default,,0,0,0,,Сол күні мен ол кісінің қолынан ұстауға батылдық жасадым.
Dialogue: 0,0:00:51.72,0:00:53.35,Default,,0,0,0,,Бұл адам қорлаушы
Dialogue: 0,0:00:54.27,0:00:55.31,Default,,0,0,0,,Жақсы болды.
Dialogue: 0,0:00:55.60,0:00:59.23,Default,,0,0,0,,Иә, айналамдағылар мені бірден тежеп қойды.
Dialogue: 0,0:00:59.56,0:01:00.40,Default,,0,0,0,,Жақсы
Dialogue: 0,0:01:01.07,0:01:07.03,Default,,0,0,0,,Бірақ мен неге қыз емеспін?
Dialogue: 0,0:01:07.70,0:01:09.20,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:01:11.03,0:01:11.87,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:01:12.49,0:01:14.00,Default,,0,0,0,,Жоқ, солай ма?
Dialogue: 0,0:01:14.87,0:01:16.33,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:01:18.04,0:01:18.71,Default,,0,0,0,,Шынымен
Dialogue: 0,0:01:20.21,0:01:24.01,Default,,0,0,0,,Бірақ ол ағайдың әкесінің компаниясының басқарушы директоры болды.
Dialogue: 0,0:01:26.88,0:01:28.55,Default,,0,0,0,,Әкем жұмыстан шығарылды.
Dialogue: 0,0:01:29.64,0:01:32.93,Default,,0,0,0,,Анам неге сонша шыдамсыз болды?
Dialogue: 0,0:01:33.31,0:01:36.60,Default,,0,0,0,,Сізге әсер еткені сіздің сүйкімді екеніңізді білдірмейді.
Dialogue: 0,0:01:40.81,0:01:44.03,Default,,0,0,0,,Олар мені сүйкімді болғандықтан таңдағандарын айтты.
Dialogue: 0,0:01:46.86,0:01:51.74,Default,,0,0,0,,Сабыр ет, сен мүлде жаман емессің, жаман емессің, солай ма?
Dialogue: 0,0:01:55.08,0:01:56.20,Default,,0,0,0,,Момотаро-сан
Dialogue: 0,0:01:59.29,0:02:02.04,Default,,0,0,0,,Уайымдама, мен сені қорғаймын.
Dialogue: 0,0:02:03.54,0:02:04.55,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:08.05,0:02:10.05,Default,,0,0,0,,Иықтар кең.
Dialogue: 0,0:02:12.05,0:02:13.26,Default,,0,0,0,,Уф… Қолымды қозғалтсам.
Dialogue: 0,0:03:46.48,0:03:47.31,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:03:48.40,0:03:50.15,Default,,0,0,0,,Жай ғана қашу жақсы емес
Dialogue: 0,0:03:50.15,0:03:51.69,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:03:53.20,0:03:55.57,Default,,0,0,0,,Иә, біз күресуіміз керек.
Dialogue: 0,0:03:55.57,0:03:57.20,Default,,0,0,0,,Бұл тұман мұны істемейді.
Dialogue: 0,0:03:58.49,0:04:00.74,Default,,0,0,0,,Ал мен жалғызбын
Dialogue: 0,0:04:01.50,0:04:02.33,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:04:06.29,0:04:06.96,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:04:15.76,0:04:16.64,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:04:17.60,0:04:20.18,Default,,0,0,0,,Мұны бір нәрсе үшін қолдануға болады ма?
Dialogue: 0,0:04:20.72,0:04:21.64,Default,,0,0,0,,Менікі де
Dialogue: 0,0:04:23.81,0:04:24.73,Default,,0,0,0,,Қалам шамы
Dialogue: 0,0:04:26.94,0:04:27.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:39.58,0:04:40.66,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:04:41.33,0:04:43.79,Default,,0,0,0,,Жарайды, келіңіз.
Dialogue: 0,0:04:57.05,0:04:58.64,Default,,0,0,0,,Саған тиіскенімді қалайсың, солай ма?
Dialogue: 0,0:04:59.76,0:05:04.48,Default,,0,0,0,,Үлкендер түсінеді, қанша тілегіңді айт.
Dialogue: 0,0:05:05.43,0:05:09.52,Default,,0,0,0,,Әйеліңізге тиісе аласыз, солай ма? Біз бір-бірімізді сүйіп, үйлендік.
Dialogue: 0,0:05:12.57,0:05:14.24,Default,,0,0,0,,шығыңыз!
Dialogue: 0,0:05:14.74,0:05:16.15,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:18.74,0:05:19.32,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:05:23.24,0:05:24.04,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:24.50,0:05:26.04,Default,,0,0,0,,Абайсыз жау
Dialogue: 0,0:05:33.30,0:05:37.17,Default,,0,0,0,,Қайсысы жақсы: шыбық па, тас па?
Dialogue: 0,0:05:38.18,0:05:39.59,Default,,0,0,0,,Маған да ұнамайды.
Dialogue: 0,0:05:39.59,0:05:41.39,Default,,0,0,0,,содан кейін шашлық
Dialogue: 0,0:05:41.80,0:05:44.43,Default,,0,0,0,,Әйелдерде маусым бар.
Dialogue: 0,0:05:51.61,0:05:52.61,Default,,0,0,0,,Момотаро-сан
Dialogue: 0,0:05:53.98,0:05:54.98,Default,,0,0,0,,Шықпа
Dialogue: 0,0:05:55.32,0:05:58.70,Default,,0,0,0,,Қол тигізсе қуанатын бала болсам да.
Dialogue: 0,0:05:58.95,0:06:02.12,Default,,0,0,0,,Мен сенің жақсы сезінуіңді қамтамасыз етемін.
Dialogue: 0,0:06:02.12,0:06:03.33,Default,,0,0,0,,Эден қақпасынан өткен бірінші сынып оқушылары
Dialogue: 0,0:06:03.91,0:06:04.70,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:06:08.29,0:06:09.42,Default,,0,0,0,,Маған қол тигізуге рұқсат етіңіз
Dialogue: 0,0:06:13.67,0:06:15.67,Default,,0,0,0,,Мико-чан Мако-чан
Dialogue: 0,0:06:19.05,0:06:20.22,Default,,0,0,0,,Бұл музыка
Dialogue: 0,0:06:20.51,0:06:26.31,Default,,0,0,0,,Егер сіз Ю Юның жанкүйері болсаңыз, оны Ю Ю көріп тұрғанның алдында шашырата алмайсыз.
Dialogue: 0,0:06:26.89,0:06:29.52,Default,,0,0,0,,Ай-чан, қалам шамды үстіне қойыңыз
Dialogue: 0,0:06:30.98,0:06:31.85,Default,,0,0,0,,Шайқау
Dialogue: 0,0:06:33.48,0:06:34.52,Default,,0,0,0,,Ұялмай
Dialogue: 0,0:06:47.45,0:06:49.29,Default,,0,0,0,,Мако-чан керемет
Dialogue: 0,0:06:50.33,0:06:51.71,Default,,0,0,0,,Керемет
Dialogue: 0,0:06:52.58,0:06:53.88,Default,,0,0,0,,Мен тез жетуім керек.
Dialogue: 0,0:06:54.54,0:06:56.84,Default,,0,0,0,,Мен қатты қобалжыдым.
Dialogue: 0,0:06:58.30,0:07:00.59,Default,,0,0,0,,Трилл мен күдік?
Dialogue: 0,0:07:02.47,0:07:08.35,Default,,0,0,0,,Бұл менің сүйкімді болғандықтан.
Dialogue: 0,0:07:09.56,0:07:14.10,Default,,0,0,0,,Дұрыс, мен ақыры түсіндім.
Dialogue: 0,0:07:23.24,0:07:24.16,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:07:26.99,0:07:28.20,Default,,0,0,0,,Мейірімді бол
Dialogue: 0,0:07:28.66,0:07:32.67,Default,,0,0,0,,Әрине, асығыңыз!
Dialogue: 0,0:07:34.92,0:07:35.92,Default,,0,0,0,,түртіңіз
Dialogue: 0,0:07:51.02,0:07:54.02,Default,,0,0,0,,Мен Тосакаға келдім.
Dialogue: 0,0:07:58.19,0:07:59.98,Default,,0,0,0,,Күні кеше келіңіз
Dialogue: 0,0:08:13.21,0:08:15.12,Default,,0,0,0,,Сен мені алдадың.
Dialogue: 0,0:08:16.71,0:08:20.71,Default,,0,0,0,,Бұл анық, солай ма? Мен сенің өлгеніңді қаламаймын.
Dialogue: 0,0:08:23.59,0:08:27.18,Default,,0,0,0,,Әйелдер оңай алдайды
Dialogue: 0,0:08:28.93,0:08:30.93,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:32.89,0:08:33.48,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:08:36.77,0:08:40.77,Default,,0,0,0,,Барлық ақымақ балалар үлкендерге жем болады.
Dialogue: 0,0:08:50.20,0:08:53.87,Default,,0,0,0,,Өмірлік маңызды нүктелеріңізді қысу
Dialogue: 0,0:08:59.54,0:09:00.09,Default,,0,0,0,,Рика
Dialogue: 0,0:09:03.21,0:09:08.47,Default,,0,0,0,,Біз бұл дүниеде өлмеспіз, уақыт емдейді.
Dialogue: 0,0:09:11.31,0:09:12.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:12.85,0:09:14.14,Default,,0,0,0,,Бұны тез бітірейік.
Dialogue: 0,0:09:14.48,0:09:15.06,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:09:16.94,0:09:18.56,Default,,0,0,0,,Бірліктің қайта қосылуы
Dialogue: 0,0:09:22.23,0:09:25.57,Default,,0,0,0,,Түрлі-түсті оралыңыз
Dialogue: 0,0:09:26.49,0:09:29.95,Default,,0,0,0,,Түрлі-түсті оралыңыз
Dialogue: 0,0:09:36.50,0:09:38.67,Default,,0,0,0,,Торя
Dialogue: 0,0:09:45.84,0:09:47.34,Default,,0,0,0,,Табан
Dialogue: 0,0:09:56.77,0:10:02.06,Default,,0,0,0,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:10:16.29,0:10:17.50,Default,,0,0,0,,Тым көп
Dialogue: 0,0:10:34.56,0:10:38.23,Default,,0,0,0,,Бір күн ғана болды, бірақ мен саған ғашық болдым
Dialogue: 0,0:10:40.10,0:10:40.94,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:42.10,0:10:44.57,Default,,0,0,0,,Мен сені кездестіргеніме өте қуаныштымын
Dialogue: 0,0:10:46.28,0:10:48.74,Default,,0,0,0,,Мен жай ғана жоғалып кете аламын ба?
Dialogue: 0,0:11:03.67,0:11:04.92,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:11:09.34,0:11:11.55,Default,,0,0,0,,Ия, дене қызуы көтерілді.
Dialogue: 0,0:11:11.97,0:11:15.10,Default,,0,0,0,,Біз сіздің жанкүйерлеріңіз болдық.
Dialogue: 0,0:11:15.30,0:11:18.47,Default,,0,0,0,,Шынымен де, мен дебюттен кейін асығысқым келеді.
Dialogue: 0,0:11:18.81,0:11:21.14,Default,,0,0,0,,Жоқ, жоқ, мен дебют жасап жатқан жоқпын.
Dialogue: 0,0:11:21.77,0:11:23.40,Default,,0,0,0,,Желдеткіш нөмірі 1, солай ма?
Dialogue: 0,0:11:23.81,0:11:24.86,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:11:25.61,0:11:27.02,Default,,0,0,0,,Қош бол
Dialogue: 0,0:11:38.29,0:11:41.41,Default,,0,0,0,,Қандай жағдай болмасын, ауруханадан шығуға әлі ерте.
Dialogue: 0,0:11:41.75,0:11:44.79,Default,,0,0,0,,Сізге тек бұлшықеттеріңізді тұрақты түрде қалпына келтіру керек.
Dialogue: 0,0:11:55.14,0:11:56.47,Default,,0,0,0,,Сен сияқты жігіт тазаруға тиіс.
Dialogue: 0,0:11:58.64,0:12:00.31,Default,,0,0,0,,Сіз жоспарланған уақыттан ерте шықтыңыз.
Dialogue: 0,0:12:00.64,0:12:02.10,Default,,0,0,0,,Көз бен Жұмыртқаға рахмет
Dialogue: 0,0:12:03.27,0:12:07.69,Default,,0,0,0,,Ол жақта төбелесу біздің денемізге үлкен жүктеме түсіретін сияқты.
Dialogue: 0,0:12:08.65,0:12:10.40,Default,,0,0,0,,Биік биіктіктегі жаттығулар сияқты
Dialogue: 0,0:12:10.82,0:12:11.32,Default,,0,0,0,,Иә
Dialogue: 0,0:12:11.90,0:12:12.65,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:12:12.99,0:12:15.57,Default,,0,0,0,,Ішім жарылып бара жатқандай сезінемін.
Dialogue: 0,0:12:16.66,0:12:18.99,Default,,0,0,0,,Неліктен спорт үйірмесіне қосылып, байқап көрмеске?
Dialogue: 0,0:12:21.08,0:12:22.66,Default,,0,0,0,,Ай мектепке бармады.
Dialogue: 0,0:12:26.33,0:12:28.92,Default,,0,0,0,,Мектеп жалғыз қоғам емес.
Dialogue: 0,0:12:29.59,0:12:31.59,Default,,0,0,0,,Бірақ ата-ананың көзі де бар.
Dialogue: 0,0:12:32.67,0:12:34.47,Default,,0,0,0,,Мен де мектепке бармаймын.
Dialogue: 0,0:12:35.01,0:12:36.34,Default,,0,0,0,,Ештеңе айтқан жоқ
Dialogue: 0,0:12:37.26,0:12:37.97,Default,,0,0,0,,Бөлек
Dialogue: 0,0:12:38.97,0:12:39.76,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:40.68,0:12:41.39,Default,,0,0,0,,Осыдан кейін
Dialogue: 0,0:12:42.18,0:12:44.10,Default,,0,0,0,,Мен жұмыртқа сатып алуым керек деп ойлаймын.
Dialogue: 0,0:12:44.98,0:12:46.35,Default,,0,0,0,,Мен де бара аламын.
Dialogue: 0,0:12:47.06,0:12:47.90,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:50.52,0:12:51.19,Default,,0,0,0,,Ұйқы
Dialogue: 0,0:12:52.03,0:12:52.82,Default,,0,0,0,,Жүру
Dialogue: 0,0:12:54.99,0:12:56.70,Default,,0,0,0,,Мен бір жерге тоқтауым керек.
Dialogue: 0,0:12:57.03,0:12:58.41,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:13:04.00,0:13:07.87,Default,,0,0,0,,Иә, бұл Ликка-чан, бірақ ол жаман қыз емес еді.
Dialogue: 0,0:13:09.42,0:13:09.92,Default,,0,0,0,,Иә
Dialogue: 0,0:13:10.34,0:13:14.72,Default,,0,0,0,,Сіздің көзқарасыңыз шынайы сезімдеріңізден басқаша деп айтасыз ба?
Dialogue: 0,0:13:16.26,0:13:18.39,Default,,0,0,0,,Әмиянды қайтару емес пе?
Dialogue: 0,0:13:20.39,0:13:22.35,Default,,0,0,0,,Бұл жай ғана ауыз, меніңше.
Dialogue: 0,0:13:23.89,0:13:25.10,Default,,0,0,0,,Сондықтан ол орта мектеп оқулықтары мен жұмыс дәптерлерін қалайтынын айтты.
Dialogue: 0,0:13:33.19,0:13:34.07,Default,,0,0,0,,Үлкен
Dialogue: 0,0:13:35.28,0:13:36.40,Default,,0,0,0,,Папаның компаниясы
Dialogue: 0,0:13:41.66,0:13:45.79,Default,,0,0,0,,Ай адамдарға оңай сенеді және оңай кешіреді.
Dialogue: 0,0:13:47.12,0:13:48.37,Default,,0,0,0,,Бұрынғы оқиға
Dialogue: 0,0:13:49.83,0:13:52.46,Default,,0,0,0,,Дұрыс, бұл жақсы емес.
Dialogue: 0,0:13:55.80,0:13:56.76,Default,,0,0,0,,Керемет жер
Dialogue: 0,0:13:58.72,0:14:01.09,Default,,0,0,0,,Нашар, бірақ жақсы орын
Dialogue: 0,0:14:01.68,0:14:05.64,Default,,0,0,0,,Ондай бала анда-санда болмаса, құтқара алмаймыз.
Dialogue: 0,0:14:07.68,0:14:09.06,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:14:10.40,0:14:11.73,Default,,0,0,0,,Менің досым Ай Ото
Dialogue: 0,0:14:12.06,0:14:14.86,Default,,0,0,0,,Бұл Мисаки Танабе, бірінші хатшы.
Dialogue: 0,0:14:15.28,0:14:17.03,Default,,0,0,0,,Сәлеметсіз бе, Ото мырза
Dialogue: 0,0:14:18.28,0:14:19.03,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:19.86,0:14:22.45,Default,,0,0,0,,Президент, сізді ауруханадан шығуыңызбен құттықтаймыз.
Dialogue: 0,0:14:25.49,0:14:26.75,Default,,0,0,0,,Президент
Dialogue: 0,0:14:30.04,0:14:32.79,Default,,0,0,0,,Жұмыртқа сынап жатқан басқа балалар да бар.
Dialogue: 0,0:14:34.21,0:14:35.00,Default,,0,0,0,,Қандай бала
Dialogue: 0,0:14:36.13,0:14:37.76,Default,,0,0,0,,Бұл күнбағыс.
Dialogue: 0,0:14:38.05,0:14:38.88,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:39.51,0:14:40.80,Default,,0,0,0,,Оны көргенде білесің
Dialogue: 0,0:14:41.43,0:14:43.14,Default,,0,0,0,,Олардың кейбір ерекшеліктері бар.
Dialogue: 0,0:14:43.89,0:14:46.77,Default,,0,0,0,,Бірақ олардың бәрі жақсы балалар және жақсы араласады.
Dialogue: 0,0:14:47.72,0:14:48.81,Default,,0,0,0,,Күнбағыс
Dialogue: 0,0:14:49.27,0:14:51.31,Default,,0,0,0,,Мен бұрын ешқашан Knack's картоп жеген емеспін.
Dialogue: 0,0:14:52.19,0:14:55.69,Default,,0,0,0,,Қытырлақ, жылы болса өте дәмді.
Dialogue: 0,0:14:56.02,0:14:57.86,Default,,0,0,0,,Ол суыған кезде сәл оғаш болады.
Dialogue: 0,0:14:58.15,0:14:58.99,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:14:59.36,0:15:02.82,Default,,0,0,0,,Бірақ оны пеште қыздырудың бір айласы бар.
Dialogue: 0,0:15:06.54,0:15:09.16,Default,,0,0,0,,Бұл тек әйелдерге арналған көлік.
Dialogue: 0,0:15:09.33,0:15:12.83,Default,,0,0,0,,Әлгі қарғыс атқысы келсе, жолын кесемін.
Dialogue: 0,0:15:14.84,0:15:18.00,Default,,0,0,0,,Менің бұл көлікте жүруге құқығым бар.
Dialogue: 0,0:15:18.00,0:15:20.42,Default,,0,0,0,,Сіз не айтқыңыз келеді?
Dialogue: 0,0:15:20.67,0:15:23.68,Default,,0,0,0,,Басқаша айтқанда, мен де қызбын.
Dialogue: 0,0:15:25.93,0:15:27.01,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:30.02,0:15:31.27,Default,,0,0,0,,Кешегі күн
Dialogue: 0,0:15:36.11,0:15:37.23,Default,,0,0,0,,Момотаро-сан
Dialogue: 0,0:15:38.15,0:15:41.49,Default,,0,0,0,,Менің шын атым - Момо Саваки Момо
Dialogue: 0,0:15:42.49,0:15:44.41,Default,,0,0,0,,Бұл шынымен де қыз ғой, солай емес пе?
Dialogue: 0,0:15:45.82,0:15:47.95,Default,,0,0,0,,Мен сені алдайын деп тұрған жоқпын.
Dialogue: 0,0:15:48.91,0:15:51.58,Default,,0,0,0,,Мен емес, мен сияқты.
Dialogue: 0,0:15:52.54,0:15:53.67,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:15:54.62,0:15:58.71,Default,,0,0,0,,Қыз болсаң да маған ғашық болдың.
Dialogue: 0,0:15:59.30,0:16:04.76,Default,,0,0,0,,Мен сені сүйемін, жоғалғым келмейді, сенімен мәңгі бірге болғым келеді.
Dialogue: 0,0:16:20.90,0:16:25.53,Default,,0,0,0,,Жылы Бұл өте көп, солай емес пе? Харука
Dialogue: 0,0:16:26.62,0:16:29.20,Default,,0,0,0,,Мен де сені жақсы көремін
Dialogue: 0,0:16:44.55,0:16:45.51,Default,,0,0,0,,түртіңіз
Dialogue: 0,0:17:12.83,0:17:16.75,Default,,0,0,0,,Мен әмиянымды ұмытып қалдым, егер қарсы болмасаңыз.
Dialogue: 0,0:17:16.75,0:17:17.54,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:17:17.83,0:17:19.92,Default,,0,0,0,,Сіз оны әдейі алып жүрмейсіз бе?
Dialogue: 0,0:17:20.17,0:17:24.34,Default,,0,0,0,,Себебі әкем әдемі әйелдер әмиян көтермеу керек деген.
Dialogue: 0,0:17:24.51,0:17:28.97,Default,,0,0,0,,Ал менің әмиян кешігіп жатыр.
Dialogue: 0,0:17:28.97,0:17:30.97,Default,,0,0,0,,Көз сіздің әмияныңыз емес пе?
Dialogue: 0,0:17:32.35,0:17:34.10,Default,,0,0,0,,Әзіл.
Dialogue: 0,0:17:34.77,0:17:36.98,Default,,0,0,0,,Онда бұл қызық емес, сондықтан оны тоқтат.
Dialogue: 0,0:17:50.28,0:17:51.49,Default,,0,0,0,,Ол қатты жараланған еді...
Dialogue: 0,0:17:53.24,0:17:53.83,Default,,0,0,0,,Мен
Dialogue: 0,0:17:53.83,0:17:57.00,Default,,0,0,0,,Ол сондай әдемі, үй иесі сияқты
Dialogue: 0,0:17:57.79,0:17:58.92,Default,,0,0,0,,Хост дегеніміз не?
Dialogue: 0,0:17:59.25,0:18:03.00,Default,,0,0,0,,Бірақ ұлдар да бар екені көрініп тұр ма?
Dialogue: 0,0:18:03.00,0:18:04.96,Default,,0,0,0,,Ер адамдар да өз-өзіне қол жұмсайды.
Dialogue: 0,0:18:05.46,0:18:08.80,Default,,0,0,0,,Ұлдар жоқ дегеніңіз не?
Dialogue: 0,0:18:09.76,0:18:13.14,Default,,0,0,0,,Ұлдар мен қыздардың өз-өзіне қол жұмсауы әртүрлі мағынаға ие.
Dialogue: 0,0:18:13.14,0:18:16.22,Default,,0,0,0,,Ерлердің миы мақсатты, әйелдердің эмоционалды миы бар.
Dialogue: 0,0:18:16.22,0:18:20.60,Default,,0,0,0,,Әйелдер импульсивті және басқа адамдардың дауысына оңай әсер етеді.
Dialogue: 0,0:18:21.02,0:18:22.61,Default,,0,0,0,,Адамдар арасындағы қарым-қатынас және т.б.
Dialogue: 0,0:18:22.77,0:18:23.86,Default,,0,0,0,,Бұл да
Dialogue: 0,0:18:24.65,0:18:26.74,Default,,0,0,0,,Өлуге азғыру болса
Dialogue: 0,0:18:27.74,0:18:29.03,Default,,0,0,0,,Өлім азғыру
Dialogue: 0,0:18:29.45,0:18:32.41,Default,,0,0,0,,Қорқынышты, бірақ мен бір нәрсені түсінетін шығармын
Dialogue: 0,0:18:32.66,0:18:36.16,Default,,0,0,0,,Сіз азғырылып, өкініп қалуыңыз мүмкін.
Dialogue: 0,0:18:36.54,0:18:41.04,Default,,0,0,0,,Бұл балаларды өмірге қайтарғысы келетіндер үшін бар.
Dialogue: 0,0:18:41.21,0:18:44.67,Default,,0,0,0,,Сондықтан жынысына қарай ештеңе айтпаңыз.
Dialogue: 0,0:18:45.21,0:18:47.84,Default,,0,0,0,,Иә, кемсіту жаман.
Dialogue: 0,0:19:10.90,0:19:11.53,Default,,0,0,0,,Бұл
Dialogue: 0,0:19:15.28,0:19:16.20,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:18.12,0:19:20.37,Default,,0,0,0,,Мен, жоқ
Dialogue: 0,0:19:22.29,0:19:23.00,Default,,0,0,0,,Мен
Dialogue: 0,0:19:25.79,0:19:28.71,Default,,0,0,0,,Қазір қалай көрінеді?
Dialogue: 0,0:19:31.09,0:19:32.30,Default,,0,0,0,,Жылап тұрған қыз
Dialogue: 0,0:19:33.68,0:19:34.59,Default,,0,0,0,,Шынымен
Dialogue: 0,0:19:36.22,0:19:40.52,Default,,0,0,0,,Модельге ұқсайтын жылап тұрған қыз
Dialogue: 0,0:19:41.23,0:19:41.98,Default,,0,0,0,,Күнбағыс
Dialogue: 0,0:19:44.15,0:19:47.90,Default,,0,0,0,,Бұл менің сүйікті, сондықтан мен оны үнемі киемін.
Dialogue: 0,0:19:48.78,0:19:53.53,Default,,0,0,0,,Бірақ бұл өте сүйкімді
Dialogue: 0,0:19:55.41,0:19:56.37,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:58.62,0:20:03.58,Default,,0,0,0,,Барлық модельдердің желкелерінен мойын сүйектеріне дейін таңғажайып сызықтары бар сияқты.
Dialogue: 0,0:20:03.83,0:20:04.67,Default,,0,0,0,,Мәліметтер қандай?
Dialogue: 0,0:20:05.13,0:20:07.79,Default,,0,0,0,,Мен оны кішкентай кезімде көп көретінмін.
Dialogue: 0,0:20:09.13,0:20:13.13,Default,,0,0,0,,Менің анам сән журналының бас редакторы болған.
Dialogue: 0,0:20:14.51,0:20:15.26,Default,,0,0,0,,Ұйқы
Dialogue: 0,0:20:15.76,0:20:19.14,Default,,0,0,0,,Қарашы, сенің мойның онша әдемі емес.
Dialogue: 0,0:20:21.18,0:20:22.77,Default,,0,0,0,,Үлгіге ұқсайды
Dialogue: 0,0:20:23.44,0:20:26.10,Default,,0,0,0,,Бұл дұрыс. Ол жіңішке және ұзын.
Dialogue: 0,0:20:26.48,0:20:27.98,Default,,0,0,0,,Онда Адамның алмасы жоқ
Dialogue: 0,0:20:28.40,0:20:30.65,Default,,0,0,0,,Маған да Адамның алмасы ұнайды, солай емес пе?
Dialogue: 0,0:20:31.03,0:20:31.73,Default,,0,0,0,,Мен де
Dialogue: 0,0:20:32.36,0:20:34.53,Default,,0,0,0,,Маған Адамның алмасы ұнайды. Маған ұнайды, өйткені ол сексуалды.
Dialogue: 0,0:20:34.74,0:20:36.53,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:36.53,0:20:38.03,Default,,0,0,0,,Қытырлақ
Dialogue: 0,0:20:38.03,0:20:39.66,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:20:39.66,0:20:40.91,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:20:41.37,0:20:45.33,Default,,0,0,0,,Менің мойыным жақсы және мейірімді.
Dialogue: 0,0:20:46.88,0:20:47.71,Default,,0,0,0,,Күшік сияқты
Dialogue: 0,0:20:47.88,0:20:49.59,Default,,0,0,0,,ит ит
Dialogue: 0,0:20:52.42,0:20:53.47,Default,,0,0,0,,Маған қарызға ақша беріңіз
Dialogue: 0,0:20:53.97,0:20:54.80,Default,,0,0,0,,Барка
Dialogue: 0,0:20:56.80,0:20:58.47,Default,,0,0,0,,Күлме
Dialogue: 0,0:20:58.47,0:21:00.35,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:21:13.19,0:21:15.20,Default,,0,0,0,,Тым көп күлу
Dialogue: 0,0:21:15.20,0:21:16.99,Default,,0,0,0,,Жуырда жұмыртқа сатып алайық.
Dialogue: 0,0:21:18.16,0:21:19.49,Default,,0,0,0,,Ал, аты кім?
Dialogue: 0,0:21:20.07,0:21:22.20,Default,,0,0,0,,I, Момо Саваки
Dialogue: 0,0:21:25.21,0:21:26.12,Default,,0,0,0,,Саваки
Dialogue: 0,0:21:27.62,0:21:32.62,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
