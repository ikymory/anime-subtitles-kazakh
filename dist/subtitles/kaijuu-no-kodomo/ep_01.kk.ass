Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:26.73,0:00:29.90,Default,,0,0,0,,«Жетеді» деп айтылды
Dialogue: 0,0:00:29.98,0:00:31.57,Default,,0,0,0,,Мен көзімді ашқанда...
Dialogue: 0,0:00:33.78,0:00:35.95,Default,,0,0,0,,Ол теңізде болды
Dialogue: 0,0:00:38.20,0:00:40.24,Default,,0,0,0,,Уау...
Dialogue: 0,0:00:43.62,0:00:47.42,Default,,0,0,0,,Анаңа қолыңды ақырын жақындатқанда...
Dialogue: 0,0:00:55.47,0:00:57.76,Default,,0,0,0,,Мен қозғалсам да
Dialogue: 0,0:01:00.47,0:01:02.47,Default,,0,0,0,,Мен сенің соңынан ердім
Dialogue: 0,0:01:12.99,0:01:16.49,Default,,0,0,0,,Балалық шағымнан естеліктер
Dialogue: 0,0:01:28.58,0:01:31.46,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:01:31.55,0:01:32.84,Default,,0,0,0,,«Ән»?
Dialogue: 0,0:01:34.63,0:01:35.97,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,0:01:36.47,0:01:41.14,Default,,0,0,0,,Жоқ, киттер жауап ретінде ән айтып жатыр.
Dialogue: 0,0:01:44.18,0:01:46.94,Default,,0,0,0,,Әнге жауап ретінде дельфиндер қоныс аудара бастады.
Dialogue: 0,0:01:47.77,0:01:50.81,Default,,0,0,0,,Бұл бұрын-соңды болмаған жаңа ән түрі.
Dialogue: 0,0:01:56.74,0:01:58.24,Default,,0,0,0,,Әлі ұзақ жол
Dialogue: 0,0:01:58.74,0:02:01.33,Default,,0,0,0,,Бірақ ол бірте-бірте жақындап келеді
Dialogue: 0,0:02:28.64,0:02:30.15,Default,,0,0,0,,«Жұлдыз»
Dialogue: 0,0:02:30.23,0:02:31.73,Default,,0,0,0,,«жұлдыздар»
Dialogue: 0,0:02:32.23,0:02:34.19,Default,,0,0,0,,«Теңіз – туған жер»
Dialogue: 0,0:02:41.03,0:02:42.78,Default,,0,0,0,,Ақыры осында.
Dialogue: 0,0:03:05.76,0:03:09.73,Default,,0,0,0,,(теңіз құстарының айқайы)
Dialogue: 0,0:03:57.57,0:04:01.40,Default,,0,0,0,,(оқушы қыздардың дауысы)
Dialogue: 0,0:04:04.74,0:04:06.32,Default,,0,0,0,,(Рион) Егер сұраса, олар әлемнің кез келген түкпіріне барады —
Dialogue: 0,0:04:06.49,0:04:08.03,Default,,0,0,0,,Сіз ұша аласыз!
Dialogue: 0,0:04:08.95,0:04:10.54,Default,,0,0,0,,Наиш!
Dialogue: 0,0:04:11.16,0:04:12.62,Default,,0,0,0,,Наиш Рюка!
Dialogue: 0,0:04:13.50,0:04:15.29,Default,,0,0,0,,Рюка шынымен қозғалады!
Dialogue: 0,0:04:20.30,0:04:23.93,Default,,0,0,0,,Жазғы демалыс бүгіннен басталатындықтан, көшетініне сенімдімін.
Dialogue: 0,0:04:24.01,0:04:26.30,Default,,0,0,0,,Жазда өзімді жеңіл сезінемін!
Dialogue: 0,0:04:27.30,0:04:29.31,Default,,0,0,0,,Наиш! (А оқушы) Рюка жақсы!
Dialogue: 0,0:04:30.60,0:04:31.60,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:04:32.23,0:04:35.60,Default,,0,0,0,,Рюка Менің жағдайым жақсы! (Д-оқушы) Ғажайып, ғажап, ғажап.
Dialogue: 0,0:04:36.40,0:04:39.19,Default,,0,0,0,,Ол жақсы болған кезде қауіпті.
Dialogue: 0,0:04:39.27,0:04:40.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:50.12,0:04:51.66,Default,,0,0,0,,Авдол мен басқалар… келе жатыр…
Dialogue: 0,0:04:54.92,0:04:57.17,Default,,0,0,0,,Өйткені кішкентай жігіт мұны істей алмайды.
Dialogue: 0,0:05:01.84,0:05:03.34,Default,,0,0,0,,
Dialogue: 0,0:05:03.42,0:05:07.51,Default,,0,0,0,,(13-нөмірлі әйелдің айқайы)
Dialogue: 0,0:05:11.18,0:05:13.73,Default,,0,0,0,,Не болды? Бұл мұрын ба? Иә?
Dialogue: 0,0:05:13.85,0:05:16.85,Default,,0,0,0,,Атқанда Рюканың шынтағы бетіме тиді...
Dialogue: 0,0:05:17.85,0:05:19.19,Default,,0,0,0,,Бұл әдейі, солай емес пе?
Dialogue: 0,0:05:19.90,0:05:21.69,Default,,0,0,0,,Егер ол бұзылса, проблема болар еді.
Dialogue: 0,0:05:22.23,0:05:24.36,Default,,0,0,0,,Мені емханаға апарыңыз.
Dialogue: 0,0:05:32.04,0:05:34.70,Default,,0,0,0,,Рюка, сен тым көп істеп жатырсың.
Dialogue: 0,0:05:34.87,0:05:37.50,Default,,0,0,0,,Сізге қанша тұратыны маңызды емес.
Dialogue: 0,0:05:38.38,0:05:39.92,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:05:43.13,0:05:44.55,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:05:44.71,0:05:45.59,Default,,0,0,0,,Рюка
Dialogue: 0,0:05:46.30,0:05:48.22,Default,,0,0,0,,Өйткені... (Мұғалім) Рюка!
Dialogue: 0,0:05:48.93,0:05:51.51,Default,,0,0,0,,Бір сәт қызметкерлер бөлмесіне келіңіз.
Dialogue: 0,0:05:58.52,0:06:02.52,Default,,0,0,0,,Әй... Жазғы каникулдың алғашқы күнінен осы ма?
Dialogue: 0,0:06:03.02,0:06:04.86,Default,,0,0,0,,Ол нағыз бұзақы.
Dialogue: 0,0:06:04.99,0:06:08.82,Default,,0,0,0,,Неше рет? Қарсылас командалас...
Dialogue: 0,0:06:10.45,0:06:13.08,Default,,0,0,0,,Қалайша осылай зардап шектің?
Dialogue: 0,0:06:14.41,0:06:16.50,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:06:17.58,0:06:20.46,Default,,0,0,0,,Бірінші...
Dialogue: 0,0:06:20.58,0:06:23.50,Default,,0,0,0,,Бұл сенің кінәң емес...
Dialogue: 0,0:06:23.59,0:06:26.59,Default,,0,0,0,,Жақсы... емес...
Dialogue: 0,0:06:30.05,0:06:32.64,Default,,0,0,0,,Бұл сен кінәлі, солай емес пе?
Dialogue: 0,0:06:33.43,0:06:35.22,Default,,0,0,0,,Иә, жеткілікті.
Dialogue: 0,0:06:39.60,0:06:42.61,Default,,0,0,0,,Қалай болғанда да, сауықтыру бөлмесін қараңыз.
Dialogue: 0,0:06:42.73,0:06:45.86,Default,,0,0,0,,Қажет болса, мен сені ауруханаға апаруым керек.
Dialogue: 0,0:06:46.78,0:06:48.36,Default,,0,0,0,,Қазір үйге бару керек.
Dialogue: 0,0:06:49.11,0:06:50.28,Default,,0,0,0,,Иә
Dialogue: 0,0:06:53.62,0:06:54.74,Default,,0,0,0,,Мен…
Dialogue: 0,0:06:55.16,0:06:57.12,Default,,0,0,0,,Мен де емханадамын...
Dialogue: 0,0:06:58.12,0:07:00.96,Default,,0,0,0,,Ах, сосын Рюка.
Dialogue: 0,0:07:01.50,0:07:06.80,Default,,0,0,0,,Кешірім сұрауға ниетіңіз болмаса, енді келудің қажеті жоқ.
Dialogue: 0,0:07:06.92,0:07:08.80,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:07:39.66,0:07:40.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:41.46,0:07:46.38,Default,,0,0,0,,(Қашықтағы бөгет туралы ескерту дыбысының дыбысы)
Dialogue: 0,0:07:46.50,0:07:47.59,Default,,0,0,0,,Уф
Dialogue: 0,0:07:52.84,0:07:53.68,Default,,0,0,0,,Бұл
Dialogue: 0,0:08:08.65,0:08:10.53,Default,,0,0,0,,Бүгін басталды...
Dialogue: 0,0:08:12.78,0:08:15.62,Default,,0,0,0,,Менің жазғы демалысым қазірдің өзінде...
Dialogue: 0,0:08:16.66,0:08:17.87,Default,,0,0,0,,бітті.
Dialogue: 0,0:08:39.89,0:08:41.18,Default,,0,0,0,,Уа!
Dialogue: 0,0:08:55.70,0:09:00.74,Default,,0,0,0,,А, мен енді ұша алмаймын.
Dialogue: 0,0:09:28.56,0:09:30.15,Default,,0,0,0,,Қашан барасың?
Dialogue: 0,0:09:30.27,0:09:31.82,Default,,0,0,0,,Обон мерекесі (А оқушы) Обон?
Dialogue: 0,0:09:31.94,0:09:34.32,Default,,0,0,0,,Бұл тамаша. Шетелге саяхат (А студенті).
Dialogue: 0,0:09:34.40,0:09:36.11,Default,,0,0,0,,Оған дейін мен клубтағы жұмысымды шешемін.
Dialogue: 0,0:09:36.32,0:09:38.78,Default,,0,0,0,,Бұл орындалады (А оқушысы)
Dialogue: 0,0:09:38.91,0:09:40.83,Default,,0,0,0,,Керемет, біз ешқайда бармаймыз.
Dialogue: 0,0:09:40.95,0:09:42.29,Default,,0,0,0,,Қабірлерді де зиярат етеміз.
Dialogue: 0,0:09:42.41,0:09:43.95,Default,,0,0,0,,Олай болса, киноға барайық па?
Dialogue: 0,0:09:44.04,0:09:45.12,Default,,0,0,0,,Кя, мұны істейік.
Dialogue: 0,0:09:45.29,0:09:46.37,Default,,0,0,0,,Маған да рұқсат етіңіз.
Dialogue: 0,0:09:46.50,0:09:48.17,Default,,0,0,0,,Олай болса, үшеуміз кеттік!
Dialogue: 0,0:10:03.93,0:10:05.14,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:10:08.52,0:10:11.36,Default,,0,0,0,,Сіздің жарақатыңызға не болды?
Dialogue: 0,0:10:14.48,0:10:15.82,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:28.37,0:10:30.04,Default,,0,0,0,,Уау~
Dialogue: 0,0:10:31.33,0:10:32.84,Default,,0,0,0,,Сондай сағыныш
Dialogue: 0,0:10:35.63,0:10:37.13,Default,,0,0,0,,Аквариум
Dialogue: 0,0:10:51.86,0:10:54.52,Default,,0,0,0,,(Кардиарлық дабыл дыбысы)
Dialogue: 0,0:10:57.53,0:11:01.20,Default,,0,0,0,,Біз Эносима Эношиманың соңына таяп қалдық.
Dialogue: 0,0:11:02.03,0:11:04.99,Default,,0,0,0,,Сәлем анашым, мен сонда барғым келеді! Ана жерде!
Dialogue: 0,0:11:06.95,0:11:09.29,Default,,0,0,0,,Ғажайып аквариум
Dialogue: 0,0:11:10.71,0:11:12.83,Default,,0,0,0,,Ғажайып аквариум
Dialogue: 0,0:11:12.96,0:11:16.09,Default,,0,0,0,,Бүгіннен бастап өткізіледі, сондықтан оны тексеріңіз.
Dialogue: 0,0:11:18.17,0:11:20.59,Default,,0,0,0,,Рахмет (Бала) Сау болыңыз
Dialogue: 0,0:11:22.30,0:11:24.60,Default,,0,0,0,,Өтінемін (Рюка) А, рахмет.
Dialogue: 0,0:11:29.81,0:11:33.48,Default,,0,0,0,,Аңқайдың қызы шығар?
Dialogue: 0,0:11:33.61,0:11:34.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:35.27,0:11:37.15,Default,,0,0,0,,Не, Рюка?
Dialogue: 0,0:11:37.23,0:11:39.07,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:11:39.19,0:11:40.78,Default,,0,0,0,,Көздер дәл солай көрінеді.
Dialogue: 0,0:11:40.90,0:11:42.91,Default,,0,0,0,,Мен кішкентай кезімде осында жиі келетінмін.
Dialogue: 0,0:11:42.99,0:11:44.20,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:11:44.32,0:11:46.03,Default,,0,0,0,,Өйткені мен қазір жібере алмаймын
Dialogue: 0,0:11:46.16,0:11:49.37,Default,,0,0,0,,Бұл үлкен аквариумның артында, сондықтан мен оны өзіңіз іздеуді өтіндім.
Dialogue: 0,0:11:49.50,0:11:50.83,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:11:51.58,0:11:55.00,Default,,0,0,0,,Бас сардиналар келді (Масааки) О, дұрыс.
Dialogue: 0,0:11:55.42,0:11:57.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:58.25,0:12:00.92,Default,,0,0,0,,Мен сені әкеңе апарамын.
Dialogue: 0,0:12:01.01,0:12:03.30,Default,,0,0,0,,Біз оларды қашып құтылуға ешқашан жол бермейміз
Dialogue: 0,0:12:19.65,0:12:21.61,Default,,0,0,0,,Уау! Ахх
Dialogue: 0,0:12:29.45,0:12:32.33,Default,,0,0,0,,Егер сіз осы жерден кірсеңіз, мен сізді бірден көремін.
Dialogue: 0,0:12:35.71,0:12:37.00,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:12:38.50,0:12:39.63,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:42.72,0:12:45.22,Default,,0,0,0,,Сондай-ақ Wonder Aquarium-ды қараңыз.
Dialogue: 0,0:12:45.34,0:12:46.30,Default,,0,0,0,,Иә
Dialogue: 0,0:13:01.65,0:13:04.70,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:13:18.50,0:13:19.50,Default,,0,0,0,,(шу)
Dialogue: 0,0:13:21.13,0:13:22.84,Default,,0,0,0,,Әке?
Dialogue: 0,0:13:29.51,0:13:31.35,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:13:37.15,0:13:39.06,Default,,0,0,0,,Бұл~!
Dialogue: 0,0:13:39.73,0:13:41.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:47.28,0:13:49.03,Default,,0,0,0,,(судың шашырауының дыбысы)
Dialogue: 0,0:14:02.05,0:14:03.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:03.50,0:14:04.96,Default,,0,0,0,,Ой және...
Dialogue: 0,0:14:25.57,0:14:26.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:26.69,0:14:29.32,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:14:31.91,0:14:33.16,Default,,0,0,0,,Не?
Dialogue: 0,0:14:33.70,0:14:34.70,Default,,0,0,0,,Кім?
Dialogue: 0,0:14:41.46,0:14:42.42,Default,,0,0,0,,Баа!
Dialogue: 0,0:14:42.54,0:14:43.63,Default,,0,0,0,,Ах
Dialogue: 0,0:14:45.21,0:14:46.55,Default,,0,0,0,,Хахаха
Dialogue: 0,0:14:50.93,0:14:54.76,Default,,0,0,0,,«Жазғы демалыс» жазғы демалыс па?
Dialogue: 0,0:15:01.19,0:15:02.69,Default,,0,0,0,,және келісім-шарт аяқталады
Dialogue: 0,0:15:03.27,0:15:05.40,Default,,0,0,0,,...
Dialogue: 0,0:15:05.48,0:15:08.57,Default,,0,0,0,,(көтерілген көпіршіктердің дыбысы)
Dialogue: 0,0:15:08.74,0:15:10.61,Default,,0,0,0,,Шва дегеніміз не...
Dialogue: 0,0:15:14.78,0:15:16.37,Default,,0,0,0,,Сол Косаку Каваджири, иіліп-жығылып, жалтақтайды.
Dialogue: 0,0:15:18.62,0:15:19.50,Default,,0,0,0,,Рюка?
Dialogue: 0,0:15:50.82,0:15:52.20,Default,,0,0,0,,Хахаха
Dialogue: 0,0:16:05.25,0:16:06.84,Default,,0,0,0,,Ұшу
Dialogue: 0,0:16:23.35,0:16:24.90,Default,,0,0,0,,Мен Уми Умимін
Dialogue: 0,0:16:25.02,0:16:26.11,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:16:28.36,0:16:30.03,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:30.15,0:16:31.40,Default,,0,0,0,,Осындай қатал жағдайларға қарамастан, барлығыңыз да жақсы өнер көрсеттіңіздер.
Dialogue: 0,0:16:33.24,0:16:34.74,Default,,0,0,0,,Ru… Ka…
Dialogue: 0,0:16:34.82,0:16:36.12,Default,,0,0,0,,Лұқа, солай ма?
Dialogue: 0,0:16:36.20,0:16:40.16,Default,,0,0,0,,Лукер!
Dialogue: 0,0:16:53.26,0:16:54.38,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:16:55.55,0:16:57.01,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:16:57.09,0:16:58.05,Default,,0,0,0,,Әке!
Dialogue: 0,0:16:59.01,0:17:02.56,Default,,0,0,0,,Оны теңіздегі дюгондар өсірді.
Dialogue: 0,0:17:06.73,0:17:08.23,Default,,0,0,0,,Дугонг…
Dialogue: 0,0:17:12.86,0:17:13.99,Default,,0,0,0,,Менің...
Dialogue: 0,0:17:14.74,0:17:18.99,Default,,0,0,0,,Ұзақ, ұзақ... ұзақ жазғы демалыс басталады
Dialogue: 0,0:17:23.41,0:17:25.54,Default,,0,0,0,,Су перісі үлгісі?
Dialogue: 0,0:17:37.59,0:17:39.30,Default,,0,0,0,,Әкенің иісі
Dialogue: 0,0:17:39.47,0:17:42.10,Default,,0,0,0,,Бұл бала 10 жыл бұрын Филиппин жағалауында болған.
Dialogue: 0,0:17:42.22,0:17:45.52,Default,,0,0,0,,Оны дүңгірлер үйірімен байқады.
Dialogue: 0,0:17:46.56,0:17:49.23,Default,,0,0,0,,Басқа баламен.
Dialogue: 0,0:17:50.02,0:17:52.57,Default,,0,0,0,,Менің терім құрғақтыққа өте сезімтал.
Dialogue: 0,0:17:53.28,0:17:55.95,Default,,0,0,0,,Олар мұхитта өмір сүргендіктен болар.
Dialogue: 0,0:17:56.11,0:17:58.20,Default,,0,0,0,,Менің аквариумда біраз уақыт зерттеу үшін.
Dialogue: 0,0:17:58.32,0:18:00.16,Default,,0,0,0,,Мен оны сақтауды шештім.
Dialogue: 0,0:18:00.28,0:18:02.62,Default,,0,0,0,,Міне, келдің.
Dialogue: 0,0:18:02.79,0:18:04.58,Default,,0,0,0,,Сізде бірдеңе істеу керек еді, солай ма?
Dialogue: 0,0:18:07.42,0:18:08.79,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:18:09.88,0:18:11.84,Default,,0,0,0,,Көңіл көтеру жаңалықтары
Dialogue: 0,0:18:11.96,0:18:13.42,Default,,0,0,0,,Неліктен Манхэттен жағалауында?
Dialogue: 0,0:18:13.55,0:18:17.38,Default,,0,0,0,,Алып кит пайда болды ма, белгісіз, бірақ бұл қалыпты емес миграция...
Dialogue: 0,0:18:17.47,0:18:20.76,Default,,0,0,0,,Масааки Сіз тағы да тоқтамай бардыңыз.
Dialogue: 0,0:18:24.22,0:18:26.35,Default,,0,0,0,,Сіз не үшін бардыңыз?
Dialogue: 0,0:18:27.56,0:18:29.19,Default,,0,0,0,,Сәлем? Рюка!
Dialogue: 0,0:18:30.94,0:18:32.48,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:18:40.82,0:18:43.28,Default,,0,0,0,,Адамның жаны... келе жатыр.
Dialogue: 0,0:18:44.08,0:18:45.58,Default,,0,0,0,,
Dialogue: 0,0:18:46.58,0:18:48.29,Default,,0,0,0,,Наиш!
Dialogue: 0,0:18:50.29,0:18:51.75,Default,,0,0,0,,Айналыңыз!
Dialogue: 0,0:18:55.21,0:18:56.42,Default,,0,0,0,,Наиш!
Dialogue: 0,0:18:56.59,0:18:58.59,Default,,0,0,0,,Иә? Қазір сонда...
Dialogue: 0,0:18:58.67,0:18:59.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:06.77,0:19:10.90,Default,,0,0,0,,Кешіріңіз... Кешіріңіз
Dialogue: 0,0:19:14.65,0:19:16.86,Default,,0,0,0,,Бұл менің кінәм емес!
Dialogue: 0,0:19:18.82,0:19:21.70,Default,,0,0,0,,Хмм! Ха!
Dialogue: 0,0:19:22.87,0:19:24.62,Default,,0,0,0,,Хмм! Ха!
Dialogue: 0,0:19:28.25,0:19:30.25,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:19:33.33,0:19:38.05,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:19:39.72,0:19:45.97,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:19:46.93,0:19:54.65,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:54.77,0:19:57.57,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:19:59.40,0:20:00.24,Default,,0,0,0,,Бұл
Dialogue: 0,0:20:02.24,0:20:06.33,Default,,0,0,0,,Мен неге мектепте жасырынбақ ойнаймын?
Dialogue: 0,0:20:08.62,0:20:10.45,Default,,0,0,0,,Рюка! менде сен барсың!
Dialogue: 0,0:20:10.58,0:20:11.71,Default,,0,0,0,,Ах
Dialogue: 0,0:20:13.96,0:20:15.42,Default,,0,0,0,,Уми-кун…
Dialogue: 0,0:20:19.26,0:20:21.63,Default,,0,0,0,,Жақсы! Олай болса кеттік
Dialogue: 0,0:20:22.30,0:20:24.47,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,0:20:25.09,0:20:27.97,Default,,0,0,0,,Адам жандары келе жатыр, соларды көрейік.
Dialogue: 0,0:20:28.60,0:20:30.85,Default,,0,0,0,,Адамның жаны? (Теңіз) Иә!
Dialogue: 0,0:20:30.98,0:20:33.73,Default,,0,0,0,,Сора Сора-кунды көргім келді, бірақ әлі мүмкін емес.
Dialogue: 0,0:20:33.81,0:20:35.44,Default,,0,0,0,,Сора-кун...?
Dialogue: 0,0:20:35.56,0:20:38.40,Default,,0,0,0,,Менің ағам қазір ауруханада.
Dialogue: 0,0:20:38.48,0:20:39.94,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:40.03,0:20:42.86,Default,,0,0,0,,Мен Рюканы есіме түсірдім, сондықтан мен сізге қоңырау шалуға келдім.
Dialogue: 0,0:20:43.03,0:20:44.28,Default,,0,0,0,,Адамның жаны...
Dialogue: 0,0:20:44.78,0:20:46.20,Default,,0,0,0,,Жанып, ұшатын нәрсе
Dialogue: 0,0:20:46.32,0:20:48.28,Default,,0,0,0,,Бірге тамашалайық (поезд мүйізі)
Dialogue: 0,0:20:55.62,0:20:58.59,Default,,0,0,0,,Эй, мұнда не болып жатыр?
Dialogue: 0,0:20:58.67,0:20:59.80,Default,,0,0,0,,Құдай...
Dialogue: 0,0:21:00.63,0:21:03.13,Default,,0,0,0,,Ойнари-сан? (теңіз) Хмм
Dialogue: 0,0:21:03.97,0:21:04.80,Default,,0,0,0,,Бұл да?
Dialogue: 0,0:21:04.93,0:21:07.22,Default,,0,0,0,,Бұл Джизо
Dialogue: 0,0:21:07.30,0:21:08.72,Default,,0,0,0,,Хмм.
Dialogue: 0,0:21:09.60,0:21:11.39,Default,,0,0,0,,А, мен мұны білемін!
Dialogue: 0,0:21:12.10,0:21:13.85,Default,,0,0,0,,Жұмсақ крем…
Dialogue: 0,0:21:14.81,0:21:16.52,Default,,0,0,0,,Иә? сурет? сурет?
Dialogue: 0,0:21:24.32,0:21:25.95,Default,,0,0,0,,Тәтті
Dialogue: 0,0:21:27.87,0:21:29.53,Default,,0,0,0,,Тока…-чан
Dialogue: 0,0:21:30.33,0:21:32.83,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:21:33.70,0:21:36.04,Default,,0,0,0,,Неге мені шақыруға келдің?
Dialogue: 0,0:21:37.54,0:21:40.80,Default,,0,0,0,,Сіз де дәл осылай ойладыңыз ба?
Dialogue: 0,0:21:41.67,0:21:44.42,Default,,0,0,0,,Ай!
Dialogue: 0,0:21:47.76,0:21:50.01,Default,,0,0,0,,Толқындардың дыбысы күшейіп барады
Dialogue: 0,0:21:51.18,0:21:52.68,Default,,0,0,0,,Түн
Dialogue: 0,0:21:55.56,0:21:57.56,Default,,0,0,0,,Мұндай жерде адам жаны бар ма?
Dialogue: 0,0:21:58.69,0:22:00.69,Default,,0,0,0,,Мүмкін мені мазақ етіп жатқан шығар...
Dialogue: 0,0:22:01.61,0:22:02.78,Default,,0,0,0,,(Барлығы төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:22:03.98,0:22:05.36,Default,,0,0,0,,Мен сенімдімін.
Dialogue: 0,0:22:08.91,0:22:11.12,Default,,0,0,0,,Маған тезірек үйге бару керек.
Dialogue: 0,0:22:11.20,0:22:12.37,Default,,0,0,0,,Міне!
Dialogue: 0,0:22:25.71,0:22:27.13,Default,,0,0,0,,Міне, біз тағы да келдік!
Dialogue: 0,0:22:29.55,0:22:30.80,Default,,0,0,0,,Не?
Dialogue: 0,0:22:31.76,0:22:34.85,Default,,0,0,0,,Бұл өте... жарқын болды.
Dialogue: 0,0:22:35.31,0:22:36.73,Default,,0,0,0,,Үлкен
Dialogue: 0,0:22:36.85,0:22:39.23,Default,,0,0,0,,Керемет! Бұл не? Комета сарқырамасы?
Dialogue: 0,0:22:39.40,0:22:40.81,Default,,0,0,0,,Адамның жаны, солай ма? (Рюка) Не болып жатыр?
Dialogue: 0,0:22:40.94,0:22:43.11,Default,,0,0,0,,Аққан жұлдыз? Метеорит?
Dialogue: 0,0:22:43.19,0:22:45.19,Default,,0,0,0,,Бұл адамның рухы емес пе? (Рюка) Бәрі жақсы!
Dialogue: 0,0:22:45.32,0:22:46.90,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:22:48.49,0:22:49.70,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:22:50.11,0:22:53.91,Default,,0,0,0,,Өйткені адам рухы: «Мені тапқаныңды қалаймын» деді.
Dialogue: 0,0:22:54.33,0:22:56.12,Default,,0,0,0,,Мен оның соншалықты қатты жарқырағанына сенбеймін
Dialogue: 0,0:22:56.25,0:22:58.71,Default,,0,0,0,,Мен олардың барлығының оны тапқанын қалайтынына сенімдімін.
Dialogue: 0,0:22:59.25,0:23:03.42,Default,,0,0,0,,Жәндіктер мен жануарлар да жарқырайды, өйткені олар адамдар оларды тапқанын қалайды.
Dialogue: 0,0:23:07.84,0:23:09.22,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:23:10.43,0:23:13.55,Default,,0,0,0,,Уми-кун мені мектептен тауып алды.
Dialogue: 0,0:23:13.64,0:23:14.93,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,0:23:16.27,0:23:18.10,Default,,0,0,0,,Эй, тағы келесің бе? адам жаны
Dialogue: 0,0:23:18.27,0:23:22.10,Default,,0,0,0,,Мені біреу тауып алғанын қаладым
Dialogue: 0,0:23:26.11,0:23:27.65,Default,,0,0,0,,Енді де!
Dialogue: 0,0:23:28.03,0:23:31.45,Default,,0,0,0,,Мені осында әкелгеніңіз үшін рахмет, Уми-кун.
Dialogue: 0,0:23:49.55,0:23:51.76,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:23:57.31,0:23:58.81,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:24:01.44,0:24:02.85,Default,,0,0,0,,(Тоққыл дыбыс)
Dialogue: 0,0:24:03.65,0:24:07.48,Default,,0,0,0,,Сора-кун, Джим-сан мені алып кетуге келді.
Dialogue: 0,0:24:08.03,0:24:09.03,Default,,0,0,0,,Иә
Dialogue: 0,0:24:11.65,0:24:12.66,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:24:25.29,0:24:28.59,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:24:34.80,0:24:37.55,Default,,0,0,0,,Хахаха
Dialogue: 0,0:25:02.66,0:25:06.88,Default,,0,0,0,,(теңіз құстарының айқайы)
Dialogue: 0,0:25:22.73,0:25:23.89,Default,,0,0,0,,
Dialogue: 0,0:25:24.06,0:25:25.44,Default,,0,0,0,,(Дельфин дыбысы)
Dialogue: 0,0:25:25.56,0:25:26.94,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:25:28.90,0:25:30.65,Default,,0,0,0,,Мен шоғырлана алмаймын.
Dialogue: 0,0:25:30.77,0:25:34.07,Default,,0,0,0,,Итбалықтар да түнде қорқынышты айқайлады.
Dialogue: 0,0:25:35.24,0:25:37.99,Default,,0,0,0,,Мына мысалды қараңыз...
Dialogue: 0,0:25:38.82,0:25:40.24,Default,,0,0,0,,Метеорит?
Dialogue: 0,0:25:43.66,0:25:45.91,Default,,0,0,0,,Метеорит түскен аймақтың айналасы
Dialogue: 0,0:25:46.08,0:25:49.08,Default,,0,0,0,,Біраз күннен бері өркеш кит көрінді.
Dialogue: 0,0:25:49.17,0:25:51.59,Default,,0,0,0,,Джим, сен дұрыс таптың.
Dialogue: 0,0:25:51.67,0:25:52.88,Default,,0,0,0,,Жақсы
Dialogue: 0,0:25:53.42,0:25:56.05,Default,,0,0,0,,Осы жерде жазылған әндерін жіберіңіз
Dialogue: 0,0:25:56.18,0:25:57.38,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:26:00.85,0:26:02.26,Default,,0,0,0,,(кит әні)
Dialogue: 0,0:26:02.43,0:26:03.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:05.48,0:26:07.64,Default,,0,0,0,,(кит әні)
Dialogue: 0,0:26:09.90,0:26:11.44,Default,,0,0,0,,Ум...
Dialogue: 0,0:26:13.11,0:26:14.49,Default,,0,0,0,,Сіз Аңқайдансыз...
Dialogue: 0,0:26:14.61,0:26:17.61,Default,,0,0,0,,Бұл қандай музыка болды?
Dialogue: 0,0:26:18.11,0:26:20.20,Default,,0,0,0,,Аа, сіз «ән» деп отырсыз.
Dialogue: 0,0:26:20.32,0:26:21.49,Default,,0,0,0,,Ән?
Dialogue: 0,0:26:21.62,0:26:26.29,Default,,0,0,0,,Киттер суда ән салып жатыр.
Dialogue: 0,0:26:26.46,0:26:31.21,Default,,0,0,0,,Дыбыс ауаға қарағанда суда әлдеқайда алыс таралады.
Dialogue: 0,0:26:31.34,0:26:34.46,Default,,0,0,0,,Бір-бірінен миль қашықтықта тұратын достар бірге ән айта алады
Dialogue: 0,0:26:35.30,0:26:39.64,Default,,0,0,0,,Кит әндері өте күрделі ақпарат толқындары.
Dialogue: 0,0:26:40.64,0:26:43.60,Default,,0,0,0,,Егер біз адамдар оны жақсы жеткізе алмасақ,
Dialogue: 0,0:26:43.72,0:26:46.52,Default,,0,0,0,,Мен ойлағанымның жартысын да жеткізе алмаймын.
Dialogue: 0,0:26:46.64,0:26:49.69,Default,,0,0,0,,Бірақ киттер не көріп, не сезінгенін білмеді.
Dialogue: 0,0:26:49.81,0:26:53.15,Default,,0,0,0,,Сол күйінде хабарлауға болады.
Dialogue: 0,0:26:53.82,0:26:57.28,Default,,0,0,0,,Қалай болса да... сөйлесіңіз.
Dialogue: 0,0:27:03.99,0:27:06.16,Default,,0,0,0,,Сөзсіз жеткізуге болады...
Dialogue: 0,0:27:10.25,0:27:12.67,Default,,0,0,0,,Бүгін түнде адам жаны да келер ме екен.
Dialogue: 0,0:27:17.05,0:27:20.93,Default,,0,0,0,,(сырлау дыбысы)
Dialogue: 0,0:27:22.18,0:27:23.85,Default,,0,0,0,,Қандай дыбыс?
Dialogue: 0,0:27:24.22,0:27:26.39,Default,,0,0,0,,Иә? адамдар...?
Dialogue: 0,0:27:29.52,0:27:31.02,Default,,0,0,0,,Уми-кун?
Dialogue: 0,0:27:38.32,0:27:39.65,Default,,0,0,0,,Жоқ
Dialogue: 0,0:27:42.03,0:27:43.07,Default,,0,0,0,,Ах
Dialogue: 0,0:27:45.74,0:27:47.95,Default,,0,0,0,,Аспан...кун?
Dialogue: 0,0:27:58.59,0:28:00.55,Default,,0,0,0,,(сықырлау дыбысы)
Dialogue: 0,0:28:00.97,0:28:02.55,Default,,0,0,0,,Бұл қайтадан естіледі
Dialogue: 0,0:28:02.72,0:28:04.26,Default,,0,0,0,,Толқындарда -
Dialogue: 0,0:28:05.18,0:28:07.35,Default,,0,0,0,,Бұл құм мен тастың дыбысы.
Dialogue: 0,0:28:07.89,0:28:10.89,Default,,0,0,0,,Толқындардың дыбысымен жасырылғанымен
Dialogue: 0,0:28:11.52,0:28:14.77,Default,,0,0,0,,Жағалауы сондай шешен
Dialogue: 0,0:28:14.86,0:28:18.86,Default,,0,0,0,,Мұхит суы арқылы көп ақпарат жиналады.
Dialogue: 0,0:28:19.32,0:28:21.74,Default,,0,0,0,,Егер сіз оны ести алсаңыз
Dialogue: 0,0:28:21.90,0:28:24.24,Default,,0,0,0,,Көп нәрсе жарыққа шығады
Dialogue: 0,0:28:27.33,0:28:28.66,Default,,0,0,0,,Сіз Рюкасыз, солай ма?
Dialogue: 0,0:28:31.12,0:28:33.25,Default,,0,0,0,,Сіз менің кім екенімді білесіз, солай ма?
Dialogue: 0,0:28:34.42,0:28:36.25,Default,,0,0,0,,Сіз білуіңіз керек.
Dialogue: 0,0:28:39.09,0:28:40.84,Default,,0,0,0,,Аспан...кун?
Dialogue: 0,0:28:44.05,0:28:46.39,Default,,0,0,0,,Сіз қызықсыз.
Dialogue: 0,0:28:48.06,0:28:50.27,Default,,0,0,0,,Ол тек күткендей жұмыс істейді.
Dialogue: 0,0:28:50.39,0:28:51.93,Default,,0,0,0,,Ол оңай қыз.
Dialogue: 0,0:28:53.39,0:28:54.90,Default,,0,0,0,,Сіз теңізді көруге келдіңіз, солай ма?
Dialogue: 0,0:28:55.48,0:28:59.44,Default,,0,0,0,,Өкінішке орай, теңіз қазір теңізде.
Dialogue: 0,0:29:00.11,0:29:03.74,Default,,0,0,0,,Мен... Мен ауырдым, бірақ өзімді итермелей алмаймын...
Dialogue: 0,0:29:04.95,0:29:08.28,Default,,0,0,0,,Мен ауырған жоқпын, мен тек тексерілуде едім.
Dialogue: 0,0:29:08.83,0:29:11.62,Default,,0,0,0,,Теңізге қызығуға ерікті.
Dialogue: 0,0:29:11.79,0:29:14.41,Default,,0,0,0,,Қызық, саған теңіз қызық па?
Dialogue: 0,0:29:15.29,0:29:18.46,Default,,0,0,0,,Мен сені мүлдем ойламаймын... (Рюка) Мүлдем емес!
Dialogue: 0,0:29:18.63,0:29:22.30,Default,,0,0,0,,Бәрінен де Уми-кун бүгін де адам...
Dialogue: 0,0:29:22.46,0:29:25.34,Default,,0,0,0,,А, мен жұлдызды көремін бе деп ойладым...
Dialogue: 0,0:29:25.47,0:29:27.30,Default,,0,0,0,,Теңізде мен бармын
Dialogue: 0,0:29:27.47,0:29:28.80,Default,,0,0,0,,Үйге бару керек.
Dialogue: 0,0:29:28.93,0:29:30.60,Default,,0,0,0,,Үйге кететін уақыт келді!
Dialogue: 0,0:29:30.72,0:29:33.81,Default,,0,0,0,,Сенің мұнда не істеп жүргеніңді білмеймін!
Dialogue: 0,0:29:33.93,0:29:35.39,Default,,0,0,0,,«Ән»...
Dialogue: 0,0:29:36.14,0:29:39.73,Default,,0,0,0,,Мен бұрын естімеген әндерді естимін.
Dialogue: 0,0:29:41.57,0:29:44.57,Default,,0,0,0,,Ән киттен бе?
Dialogue: 0,0:29:48.49,0:29:51.62,Default,,0,0,0,,Жазбаны жаңа ғана тыңдаған кезде
Dialogue: 0,0:29:51.70,0:29:54.50,Default,,0,0,0,,Кит пен анау аққан жұлдыз ойға оралады.
Dialogue: 0,0:29:55.21,0:29:57.58,Default,,0,0,0,,Ал қандай да бір мереке?
Dialogue: 0,0:29:57.67,0:29:59.50,Default,,0,0,0,,Сәби сияқты...
Dialogue: 0,0:30:00.46,0:30:02.42,Default,,0,0,0,,Бұл? не болды?
Dialogue: 0,0:30:03.46,0:30:04.80,Default,,0,0,0,,Шынымен емес!
Dialogue: 0,0:30:05.51,0:30:09.26,Default,,0,0,0,,Жалғыз болсаң, сенімен ойнасам қалай болады?
Dialogue: 0,0:30:09.39,0:30:10.47,Default,,0,0,0,,Үлкен апа
Dialogue: 0,0:30:14.85,0:30:16.35,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:30:18.73,0:30:20.23,Default,,0,0,0,,Мен тітіркеніп тұрмын!
Dialogue: 0,0:30:20.36,0:30:23.23,Default,,0,0,0,,Ол жігіт Умикунның ағасы!
Dialogue: 0,0:30:24.11,0:30:25.07,Default,,0,0,0,,Бұл тітіркендіргіш!
Dialogue: 0,0:30:29.11,0:30:33.20,Default,,0,0,0,,Әлгі бала елес болып жоғалып кететін сияқты.
Dialogue: 0,0:30:37.21,0:30:38.04,Default,,0,0,0,,Фу
Dialogue: 0,0:30:38.21,0:30:40.63,Default,,0,0,0,,Иә? Сора-кун жай ғана ма?
Dialogue: 0,0:30:41.42,0:30:43.59,Default,,0,0,0,,Мен Рюканы да сонда деп ойладым.
Dialogue: 0,0:30:43.71,0:30:45.17,Default,,0,0,0,,Дәл осы уақытқа дейін.
Dialogue: 0,0:30:51.89,0:30:52.72,Default,,0,0,0,,Фу…
Dialogue: 0,0:30:52.89,0:30:55.60,Default,,0,0,0,,Ол жігіттің иісі анық.
Dialogue: 0,0:30:55.72,0:30:56.56,Default,,0,0,0,,Иә
Dialogue: 0,0:30:57.10,0:31:00.06,Default,,0,0,0,,Кішкене зерттеп көрейік
Dialogue: 0,0:31:01.02,0:31:02.44,Default,,0,0,0,,Ішінде қандай болды?
Dialogue: 0,0:31:02.56,0:31:04.90,Default,,0,0,0,,Бұл жерде өте аз адам бар сияқты.
Dialogue: 0,0:31:07.40,0:31:09.03,Default,,0,0,0,,Мен оны естимін.
Dialogue: 0,0:31:09.86,0:31:10.91,Default,,0,0,0,,Сонымен қатар, сыртта Реммен сөйлескенде,
Dialogue: 0,0:31:26.46,0:31:27.96,Default,,0,0,0,,«Жұлдыз»
Dialogue: 0,0:31:28.51,0:31:30.34,Default,,0,0,0,,«жұлдыздар»
Dialogue: 0,0:31:30.43,0:31:32.64,Default,,0,0,0,,«Теңіз – туған жер»
Dialogue: 0,0:31:48.99,0:31:51.24,Default,,0,0,0,,Алдымен нәтижені айтайын.
Dialogue: 0,0:31:51.82,0:31:53.49,Default,,0,0,0,,Сора-кун – «адам»
Dialogue: 0,0:31:53.57,0:31:59.16,Default,,0,0,0,,Көз алмасы, әсіресе жарықтың сыну көрсеткіші, жүрек-тамыр қызметі, бұлшықет пен сүйек тығыздығы, т.б.
Dialogue: 0,0:31:59.29,0:32:03.17,Default,,0,0,0,,Су астында өмір сүрген жылдардан алынған бейімделу болса керек.
Dialogue: 0,0:32:03.29,0:32:06.63,Default,,0,0,0,,Тері тінінде люминесценция құбылысына ықпал ететін факторлар табылмады.
Dialogue: 0,0:32:06.80,0:32:09.30,Default,,0,0,0,,Сондықтан олардың жарқырауы мүмкін емес...
Dialogue: 0,0:32:15.22,0:32:18.77,Default,,0,0,0,,Иә? Жалған өлтіруші киттердің тобы ма?
Dialogue: 0,0:32:36.83,0:32:38.87,Default,,0,0,0,,Рюка-чан, күте тұрыңыз.
Dialogue: 0,0:32:39.54,0:32:41.50,Default,,0,0,0,,Сіз мұны менен сұрай алатыныңызға сенімдісіз бе?
Dialogue: 0,0:32:41.62,0:32:42.46,Default,,0,0,0,,Иә
Dialogue: 0,0:32:44.67,0:32:46.13,Default,,0,0,0,,Мұнда судың температурасы төмен.
Dialogue: 0,0:32:46.25,0:32:48.84,Default,,0,0,0,,Жоқ, оған саусағыңызды салмаңыз! Мұнда акуланың сауыты бар.
Dialogue: 0,0:32:48.96,0:32:49.80,Default,,0,0,0,,Мен білемін~
Dialogue: 0,0:32:55.76,0:32:57.93,Default,,0,0,0,,(Теңіз күлкі)
Dialogue: 0,0:33:19.03,0:33:20.37,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:33:25.67,0:33:27.00,Default,,0,0,0,,Масаки?
Dialogue: 0,0:33:27.08,0:33:28.67,Default,,0,0,0,,Мм...қайсысы?
Dialogue: 0,0:33:28.79,0:33:31.30,Default,,0,0,0,,Әй, Канако-сан! Көп уақыт өтті
Dialogue: 0,0:33:31.42,0:33:33.13,Default,,0,0,0,,Сіз кімсіз? Аңқайдың әйелі
Dialogue: 0,0:33:33.30,0:33:34.47,Default,,0,0,0,,Ах, Рюканың анасы
Dialogue: 0,0:33:34.59,0:33:35.43,Default,,0,0,0,,Эй
Dialogue: 0,0:33:36.09,0:33:38.51,Default,,0,0,0,,Ануми мырза зерттеу тобында пайда болды.
Dialogue: 0,0:33:38.64,0:33:40.60,Default,,0,0,0,,Шынымен бе? иә
Dialogue: 0,0:33:42.39,0:33:44.14,Default,,0,0,0,,Сонда Рюка ше?
Dialogue: 0,0:33:45.23,0:33:47.23,Default,,0,0,0,,Рюка-чан ғимаратта шығар...
Dialogue: 0,0:33:47.40,0:33:48.40,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:33:48.52,0:33:49.52,Default,,0,0,0,,Тору, менімен бірге жүр. (Ишикава) Ээ…
Dialogue: 0,0:33:49.65,0:33:52.07,Default,,0,0,0,,Мен сені өзім іздеймін, мені жайына қалдыршы.
Dialogue: 0,0:33:53.74,0:33:56.28,Default,,0,0,0,,Канако-сан - мұнда жұмысшы.
Dialogue: 0,0:33:56.40,0:33:58.11,Default,,0,0,0,,Мен қазір еңбек демалысындамын.
Dialogue: 0,0:33:58.24,0:34:00.83,Default,,0,0,0,,Иә, бұл аты аңызға айналған емдеуші.
Dialogue: 0,0:34:01.28,0:34:03.16,Default,,0,0,0,,Канако-сан, сен осында келесің бе?
Dialogue: 0,0:34:03.29,0:34:04.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:05.04,0:34:06.37,Default,,0,0,0,,Не?
Dialogue: 0,0:34:07.00,0:34:09.83,Default,,0,0,0,,Не болды? (Рюка) Мазасыз ана
Dialogue: 0,0:34:10.42,0:34:12.75,Default,,0,0,0,,Жасырғыңыз келсе, мұнда, осында
Dialogue: 0,0:34:12.84,0:34:13.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:14.17,0:34:15.42,Default,,0,0,0,,Мұнда
Dialogue: 0,0:34:17.43,0:34:18.93,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:34:19.43,0:34:20.60,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:34:21.93,0:34:22.97,Default,,0,0,0,,Осында тығылайық
Dialogue: 0,0:34:23.47,0:34:25.68,Default,,0,0,0,,Бұл аквариум кемесі.
Dialogue: 0,0:34:25.77,0:34:27.44,Default,,0,0,0,,Сіз оны ешқашан осы жерден таба алмайсыз.
Dialogue: 0,0:34:28.02,0:34:29.27,Default,,0,0,0,,О...
Dialogue: 0,0:34:29.35,0:34:31.27,Default,,0,0,0,,Кешіріңіз (теңіз) хахаха
Dialogue: 0,0:34:31.94,0:34:33.69,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:34:34.61,0:34:36.40,Default,,0,0,0,,Бұл қозғалмайды... (Рюка) Иә?
Dialogue: 0,0:34:37.03,0:34:39.11,Default,,0,0,0,,Ұшу дайындығы аяқталды!
Dialogue: 0,0:34:41.45,0:34:42.99,Default,,0,0,0,,Иә!? (Аспан) Осылай.
Dialogue: 0,0:34:44.24,0:34:45.29,Default,,0,0,0,,Ах
Dialogue: 0,0:34:46.45,0:34:48.42,Default,,0,0,0,,Кеме кетеді!
Dialogue: 0,0:34:59.97,0:35:02.26,Default,,0,0,0,,Кемені жүргізе алатыныңыз ғажап.
Dialogue: 0,0:35:02.39,0:35:03.93,Default,,0,0,0,,Менің қолымнан келмейді (Рюка) Иә?
Dialogue: 0,0:35:04.06,0:35:06.35,Default,,0,0,0,,Мен оны дұрыс орындаған кезде жұмыс істеді.
Dialogue: 0,0:35:06.47,0:35:07.31,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:35:07.81,0:35:09.14,Default,,0,0,0,,Алдыңғы Алдыңғы Алдыңғы!
Dialogue: 0,0:35:09.69,0:35:10.90,Default,,0,0,0,,Уау! (Балықшы) Ах!
Dialogue: 0,0:35:11.27,0:35:12.81,Default,,0,0,0,,Біз соқтығысамыз!
Dialogue: 0,0:35:12.94,0:35:14.32,Default,,0,0,0,,Екінші жақ одан жалтарады.
Dialogue: 0,0:35:15.90,0:35:16.74,Default,,0,0,0,,Порт
Dialogue: 0,0:35:17.82,0:35:19.65,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:35:23.70,0:35:25.33,Default,,0,0,0,,О, бірақ
Dialogue: 0,0:35:25.79,0:35:27.62,Default,,0,0,0,,Мен мұнда жүктеме болғым келмейді.
Dialogue: 0,0:35:31.92,0:35:35.00,Default,,0,0,0,,Эй, эй! Жүр, киттерді көрейік.
Dialogue: 0,0:35:35.17,0:35:36.13,Default,,0,0,0,,Біз мұны істейміз бе?
Dialogue: 0,0:35:37.17,0:35:38.01,Default,,0,0,0,,Кит?
Dialogue: 0,0:35:42.72,0:35:44.76,Default,,0,0,0,,(Қозғалтқыштың қалыпты шуы)
Dialogue: 0,0:35:50.35,0:35:52.02,Default,,0,0,0,,Тоқтады (Рюка) Ааа!
Dialogue: 0,0:35:52.52,0:35:54.36,Default,,0,0,0,,```````````````````` деме.
Dialogue: 0,0:35:54.52,0:35:56.86,Default,,0,0,0,,Ол қозғалмайды ма? (Аспан) Жақсы.
Dialogue: 0,0:35:58.19,0:36:00.20,Default,,0,0,0,,Біз не істеуіміз керек? Осындай жерде!
Dialogue: 0,0:36:00.36,0:36:01.86,Default,,0,0,0,,Біз ештеңе істей алмаймыз.
Dialogue: 0,0:36:08.29,0:36:09.62,Default,,0,0,0,,Маған сән журналының түсірілімінде қолданылған осы киімді берді
Dialogue: 0,0:36:10.83,0:36:14.13,Default,,0,0,0,,Не... не істеуіміз керек!? Біз үйге бара алмаймыз!
Dialogue: 0,0:36:14.71,0:36:17.09,Default,,0,0,0,,Сіз оны тоқтатқан кезіңіз болды ма?
Dialogue: 0,0:36:17.21,0:36:18.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:18.63,0:36:21.76,Default,,0,0,0,,«Тоқта» немесе «артқа бұрыл» дедіңіз бе?
Dialogue: 0,0:36:22.26,0:36:24.76,Default,,0,0,0,,Айтпасам да, қуанып қалдым.
Dialogue: 0,0:36:24.89,0:36:26.26,Default,,0,0,0,,Басқаларды кінәламаңыз
Dialogue: 0,0:36:32.89,0:36:36.19,Default,,0,0,0,,Өйткені біз теңізде өстік
Dialogue: 0,0:36:36.27,0:36:38.69,Default,,0,0,0,,Салқындатылмаса, күйікке ұқсайды.
Dialogue: 0,0:36:38.86,0:36:40.90,Default,,0,0,0,,Теріңіз дем ала алмайды.
Dialogue: 0,0:36:42.03,0:36:44.07,Default,,0,0,0,,Мен оған әбден үйреніп қалдым.
Dialogue: 0,0:36:44.20,0:36:47.83,Default,,0,0,0,,Өмір сүру ұзақтығы өте қысқа шығар.
Dialogue: 0,0:36:48.74,0:36:49.91,Default,,0,0,0,,Өмір сүру ұзақтығы? (теңіз) Иә
Dialogue: 0,0:36:51.08,0:36:53.92,Default,,0,0,0,,Мен қалай ұзақ өмір сүруге болатынын зерттеп жатырмын.
Dialogue: 0,0:36:56.29,0:36:58.92,Default,,0,0,0,,Иә? Бірдеңе келе жатыр (Рюка) Иә?
Dialogue: 0,0:36:59.30,0:37:01.42,Default,,0,0,0,,Рюка да келуі керек.
Dialogue: 0,0:37:08.93,0:37:11.98,Default,,0,0,0,,Өйткені бұл жер терең, солай емес пе?
Dialogue: 0,0:37:14.23,0:37:15.06,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,0:37:24.15,0:37:27.99,Default,,0,0,0,,Мұндай терең жерге бару мүмкін емес, мүлде мүмкін емес!
Dialogue: 0,0:37:28.12,0:37:28.95,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:37:33.96,0:37:35.21,Default,,0,0,0,,терең
Dialogue: 0,0:37:36.96,0:37:38.92,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:37:40.00,0:37:41.21,Default,,0,0,0,,Не?
Dialogue: 0,0:37:53.73,0:37:56.64,Default,,0,0,0,,Пуха! ха ха ха
Dialogue: 0,0:38:03.15,0:38:04.44,Default,,0,0,0,,Кит акуласы?
Dialogue: 0,0:38:17.54,0:38:20.04,Default,,0,0,0,,Сыпырып кетті... Ах!
Dialogue: 0,0:38:31.93,0:38:34.35,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:38:34.52,0:38:37.56,Default,,0,0,0,,Таку! Егер сіз жүзе алмасаңыз, келуге мәжбүрлемеңіз.
Dialogue: 0,0:38:37.69,0:38:39.40,Default,,0,0,0,,Жүзу... Мен жүземін.
Dialogue: 0,0:38:39.52,0:38:40.94,Default,,0,0,0,,Сіз суға батып бара жатқансыз, солай емес пе?
Dialogue: 0,0:38:41.06,0:38:42.86,Default,,0,0,0,,Бұл біраз...
Dialogue: 0,0:38:42.98,0:38:44.15,Default,,0,0,0,,Сіз жүзе алмадыңыз.
Dialogue: 0,0:38:44.28,0:38:45.78,Default,,0,0,0,,Сіз жүзе аласыз!
Dialogue: 0,0:38:47.90,0:38:51.12,Default,,0,0,0,,Артымнан көп адам келе жатқан сияқты.
Dialogue: 0,0:38:51.24,0:38:52.83,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,0:38:53.74,0:38:54.79,Default,,0,0,0,,Айналаңдап жүру
Dialogue: 0,0:38:55.20,0:38:56.16,Default,,0,0,0,,Ах
Dialogue: 0,0:38:57.33,0:38:58.71,Default,,0,0,0,,Балықтар мектебі
Dialogue: 0,0:38:59.12,0:38:59.96,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:39:00.08,0:39:02.71,Default,,0,0,0,,Мен кит акулаларының мектебін қуып келемін.
Dialogue: 0,0:39:03.29,0:39:06.71,Default,,0,0,0,,Кит акуласы Теңізде өрнек жарқырап тұрды
Dialogue: 0,0:39:07.38,0:39:08.88,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:39:09.72,0:39:11.89,Default,,0,0,0,,Аквариум елесі
Dialogue: 0,0:39:13.18,0:39:14.72,Default,,0,0,0,,Жарқ етті ме?
Dialogue: 0,0:39:14.85,0:39:15.85,Default,,0,0,0,,Иә
Dialogue: 0,0:39:16.72,0:39:19.85,Default,,0,0,0,,Мен кішкентай кезімде бір нәрсенің жарыққа айналып, жоғалып кеткенін көрдім.
Dialogue: 0,0:39:22.98,0:39:24.61,Default,,0,0,0,,Біз де солай көрдік
Dialogue: 0,0:39:24.73,0:39:25.69,Default,,0,0,0,,Елес пе?
Dialogue: 0,0:39:25.82,0:39:28.19,Default,,0,0,0,,Иә, ол «Теңіз елесі» деп аталды.
Dialogue: 0,0:39:28.32,0:39:30.53,Default,,0,0,0,,Мен де солай көрдім... (теңіз) Ән ше?
Dialogue: 0,0:39:30.99,0:39:33.95,Default,,0,0,0,,Сен оны естімедің бе? кит әні
Dialogue: 0,0:39:34.62,0:39:37.33,Default,,0,0,0,,Бұл біраз уақыттан бері бірінші рет болды...
Dialogue: 0,0:39:37.41,0:39:38.62,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:39:39.08,0:39:43.13,Default,,0,0,0,,Туған күн фестивалі деп аталатын үлкен фестиваль теңіз астында бір жерде өтеді.
Dialogue: 0,0:39:43.25,0:39:47.26,Default,,0,0,0,,Фестивальдармен қарым-қатынасымызды зерттеу және Джиммен бірге әлем бойынша саяхаттау.
Dialogue: 0,0:39:48.17,0:39:50.76,Default,,0,0,0,,Киттің әні – соның алдын ала көрінісі.
Dialogue: 0,0:39:50.93,0:39:54.60,Default,,0,0,0,,Фестивальге қонақ іздейтіндері де айтылады.
Dialogue: 0,0:39:54.76,0:39:55.97,Default,,0,0,0,,Қонақ...?
Dialogue: 0,0:39:56.60,0:40:00.44,Default,,0,0,0,,Сора-кунның соңғы деректерінде ешқандай өзгеріс жоқ сияқты.
Dialogue: 0,0:40:00.89,0:40:04.94,Default,,0,0,0,,Шындығында ол деректерге қарағанда тезірек нашарлайды.
Dialogue: 0,0:40:05.44,0:40:09.03,Default,,0,0,0,,Уми-кун жерге бейімделген болса да...
Dialogue: 0,0:40:09.19,0:40:12.03,Default,,0,0,0,,Олар бірдей, бірақ аздап ерекшеленеді.
Dialogue: 0,0:40:12.16,0:40:13.70,Default,,0,0,0,,Метеоритке келетін болсақ,
Dialogue: 0,0:40:13.82,0:40:16.91,Default,,0,0,0,,Ол күткендей жерге жетпеген сияқты.
Dialogue: 0,0:40:17.04,0:40:18.87,Default,,0,0,0,,Өртеніп кетті ме?
Dialogue: 0,0:40:19.33,0:40:22.62,Default,,0,0,0,,Профессор Англэйд жинауға бара жатқан сияқты.
Dialogue: 0,0:40:22.75,0:40:23.88,Default,,0,0,0,,Уақытты босқа өткізеді
Dialogue: 0,0:40:23.96,0:40:27.88,Default,,0,0,0,,Бірақ балықтар сол суларға ағып жатыр.
Dialogue: 0,0:40:28.30,0:40:30.92,Default,,0,0,0,,Ал киттердің белгісіз әні...
Dialogue: 0,0:40:31.51,0:40:36.18,Default,,0,0,0,,Бұлардың барлығы біз жүріп жатқан фестивальдің белгілері.
Dialogue: 0,0:40:37.93,0:40:40.73,Default,,0,0,0,,Асықсақ, аспан...
Dialogue: 0,0:40:47.61,0:40:48.48,Default,,0,0,0,,Сора-кун?
Dialogue: 0,0:40:52.82,0:40:54.07,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:40:55.16,0:40:56.99,Default,,0,0,0,,Бұл жалған өлтіруші кит!
Dialogue: 0,0:40:57.70,0:40:58.66,Default,,0,0,0,,Сора-кун!
Dialogue: 0,0:41:00.50,0:41:01.79,Default,,0,0,0,,Уми-кун!
Dialogue: 0,0:41:04.83,0:41:06.50,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:41:08.63,0:41:11.30,Default,,0,0,0,,Уми-кун? Аспан-күн!
Dialogue: 0,0:41:11.76,0:41:15.05,Default,,0,0,0,,Аспан!
Dialogue: 0,0:41:17.22,0:41:18.81,Default,,0,0,0,,Хахаха
Dialogue: 0,0:41:24.44,0:41:26.10,Default,,0,0,0,,Теңіз қарағай болып шығады
Dialogue: 0,0:41:26.23,0:41:30.07,Default,,0,0,0,,Басқа кеме өтпегенде не болар еді деп ойлайсыңдар?
Dialogue: 0,0:41:30.94,0:41:32.94,Default,,0,0,0,,Тыңдап тұрсың ба? Рюка!
Dialogue: 0,0:41:33.70,0:41:36.53,Default,,0,0,0,,Теңізге жалғыз шығу дегенді қалай түсіндіңіз?
Dialogue: 0,0:41:36.66,0:41:39.20,Default,,0,0,0,,Клуб қызметі Клуб қызметі өтірік
Dialogue: 0,0:41:40.16,0:41:42.29,Default,,0,0,0,,Рюка! Сіз күнде қайда барасыз?
Dialogue: 0,0:41:42.41,0:41:45.25,Default,,0,0,0,,Масакидің орны? (Рюка) Кез келген жерде жақсы!
Dialogue: 0,0:41:48.79,0:41:50.75,Default,,0,0,0,,Кез келген жерде жақсы.
Dialogue: 0,0:42:00.97,0:42:04.39,Default,,0,0,0,,Бейшара, шайып кетті...
Dialogue: 0,0:42:04.56,0:42:06.06,Default,,0,0,0,,Неліктен жер бетінде...
Dialogue: 0,0:42:06.23,0:42:08.06,Default,,0,0,0,,Ол өлді ме?
Dialogue: 0,0:42:11.69,0:42:14.49,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:42:20.91,0:42:21.95,Default,,0,0,0,,Не?
Dialogue: 0,0:42:31.42,0:42:32.55,Default,,0,0,0,,(камера ысырмасының дыбысы)
Dialogue: 0,0:42:39.64,0:42:40.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:42:42.39,0:42:43.51,Default,,0,0,0,,Ах Рюка
Dialogue: 0,0:42:43.64,0:42:44.72,Default,,0,0,0,,Әкем
Dialogue: 0,0:42:45.10,0:42:48.39,Default,,0,0,0,,Сіз таң қалдыңыз ба? Бұл Megamouse отбасының мүшесі.
Dialogue: 0,0:42:48.52,0:42:49.65,Default,,0,0,0,,Мегамут?
Dialogue: 0,0:42:49.77,0:42:53.02,Default,,0,0,0,,Иә, бұл терең теңізде тіршілік ететін акуланың бір түрі.
Dialogue: 0,0:42:53.44,0:42:56.07,Default,,0,0,0,,Басқа балықтардың көпшілігі терең теңіз балықтары (ысырма дыбысы)
Dialogue: 0,0:42:56.19,0:42:58.03,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:42:58.82,0:43:01.62,Default,,0,0,0,,Басқа да әртүрлі балықтар жағаға шықты.
Dialogue: 0,0:43:01.78,0:43:04.45,Default,,0,0,0,,Сора әзірге жоқ... Бүлініп қалды.
Dialogue: 0,0:43:04.62,0:43:08.46,Default,,0,0,0,,Сора-кун қайтып келмеді!? (Масааки) О, мен де Джимді іздеп жүрмін.
Dialogue: 0,0:43:08.54,0:43:10.92,Default,,0,0,0,,Уми-кун ше? Кай Кун қалай?
Dialogue: 0,0:43:11.29,0:43:13.75,Default,,0,0,0,,Көңіл-күйім жоқ, Аспанға алаңдаймын
Dialogue: 0,0:43:15.17,0:43:16.21,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:43:16.30,0:43:19.22,Default,,0,0,0,,Тайфун келе жатыр. Үйде бол!
Dialogue: 0,0:43:37.90,0:43:39.95,Default,,0,0,0,,Ескі балық?
Dialogue: 0,0:43:57.88,0:43:58.76,Default,,0,0,0,,Уми-кун!
Dialogue: 0,0:43:59.67,0:44:00.51,Default,,0,0,0,,Уми-кун!
Dialogue: 0,0:44:01.84,0:44:03.05,Default,,0,0,0,,Уми-кун?
Dialogue: 0,0:44:05.18,0:44:07.31,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:44:11.35,0:44:12.40,Default,,0,0,0,,Уф
Dialogue: 0,0:44:14.94,0:44:17.19,Default,,0,0,0,,Уми-кун! Уми-кун!
Dialogue: 0,0:44:17.98,0:44:19.15,Default,,0,0,0,,Жүрек!
Dialogue: 0,0:44:22.03,0:44:23.49,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:44:24.70,0:44:26.78,Default,,0,0,0,,Бірақ ол дем алмайды.
Dialogue: 0,0:44:27.20,0:44:28.37,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:44:28.49,0:44:30.66,Default,,0,0,0,,Жасанды тыныс алу кезінде не істеуім керек?
Dialogue: 0,0:44:39.26,0:44:40.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:40.67,0:44:41.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:42.88,0:44:44.55,Default,,0,0,0,,Рюка, сен не істеп жатырсың?
Dialogue: 0,0:44:48.60,0:44:51.39,Default,,0,0,0,,Идиот! Сен не істеп жатырсың? Осындай жерде!
Dialogue: 0,0:44:52.64,0:44:54.40,Default,,0,0,0,,Мен Сора-кунды таптым!
Dialogue: 0,0:44:54.56,0:44:55.90,Default,,0,0,0,,Маған толқындар үйретті!
Dialogue: 0,0:44:56.11,0:44:57.27,Default,,0,0,0,,Не, толқындар?
Dialogue: 0,0:44:57.40,0:44:59.90,Default,,0,0,0,,Тайфун – мен туған теңіздің ауасы.
Dialogue: 0,0:45:00.03,0:45:01.40,Default,,0,0,0,,Сора-кунның иісін сеземін.
Dialogue: 0,0:45:01.53,0:45:02.70,Default,,0,0,0,,Тайфун?
Dialogue: 0,0:45:13.25,0:45:14.96,Default,,0,0,0,,Уми-кунның қолы
Dialogue: 0,0:45:19.42,0:45:20.80,Default,,0,0,0,,Олардың мен адамзаттың күш арасындағы алшақтық аса үлкен еді,
Dialogue: 0,0:45:27.93,0:45:29.60,Default,,0,0,0,,Мен сені қорғауым керек
Dialogue: 0,0:45:34.94,0:45:38.06,Default,,0,0,0,,Тайфун кенет бізге қарай бұрылды.
Dialogue: 0,0:45:38.19,0:45:40.82,Default,,0,0,0,,Теңіз балықтарынан кейін тайфундар келеді.
Dialogue: 0,0:45:40.94,0:45:43.61,Default,,0,0,0,,Бұл Анкай-сан мен мына Рюка-чан.
Dialogue: 0,0:45:43.69,0:45:48.07,Default,,0,0,0,,Ей, жағаға барма! Өйткені бұл қауіпті!
Dialogue: 0,0:45:49.08,0:45:50.79,Default,,0,0,0,,Қолшатыр да әкелме...
Dialogue: 0,0:46:36.00,0:46:39.33,Default,,0,0,0,,Аа, олар да мұнда келмеді.
Dialogue: 0,0:46:39.46,0:46:40.50,Default,,0,0,0,,Толқындарға?
Dialogue: 0,0:46:40.63,0:46:43.92,Default,,0,0,0,,Жоқ, бұл балық аулау портындағы адамдар қарап отырғандықтан емес.
Dialogue: 0,0:46:44.05,0:46:45.76,Default,,0,0,0,,Табылған жағдайда бізге хабарласыңыз...
Dialogue: 0,0:46:45.88,0:46:48.51,Default,,0,0,0,,А, түсіндім, түсіндім.
Dialogue: 0,0:46:50.34,0:46:53.76,Default,,0,0,0,,Таку! Неліктен олар қайтадан тайфунның ортасында қалды?
Dialogue: 0,0:46:53.85,0:46:58.31,Default,,0,0,0,,Боранда естеліктер, уақыт, рухтар да бір-бірінен өтеді
Dialogue: 0,0:46:58.69,0:47:02.52,Default,,0,0,0,,Бұл сіз ойлағаннан да шұғыл болуы мүмкін.
Dialogue: 0,0:47:02.69,0:47:04.03,Default,,0,0,0,,Уақыт
Dialogue: 0,0:47:04.86,0:47:06.19,Default,,0,0,0,,Екінші жекпе-жекте мүлде қатып қалған сахна да—
Dialogue: 0,0:47:45.78,0:47:47.23,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:48:08.09,0:48:09.59,Default,,0,0,0,,Жақын жерде ме?
Dialogue: 0,0:48:09.76,0:48:11.84,Default,,0,0,0,,Иә, міне
Dialogue: 0,0:48:22.06,0:48:23.40,Default,,0,0,0,,Ах, теңіз
Dialogue: 0,0:48:23.77,0:48:25.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:32.82,0:48:34.95,Default,,0,0,0,,Хахаха
Dialogue: 0,0:48:35.12,0:48:38.45,Default,,0,0,0,,Не? Сіз оны әлі таптыңыз ба?
Dialogue: 0,0:48:49.34,0:48:52.01,Default,,0,0,0,,Аспан қазір теңізде
Dialogue: 0,0:48:56.60,0:48:59.14,Default,,0,0,0,,Теңіздің ортасындағы аспанды қарсы алыңыз
Dialogue: 0,0:49:00.39,0:49:02.60,Default,,0,0,0,,Мен оны осында әкелдім
Dialogue: 0,0:49:03.39,0:49:04.73,Default,,0,0,0,,Және—
Dialogue: 0,0:49:05.77,0:49:07.69,Default,,0,0,0,,Сен теңізді әкелдің
Dialogue: 0,0:49:08.94,0:49:12.19,Default,,0,0,0,,Дәлірек айтсақ, сені мұнда теңіз әкелді.
Dialogue: 0,0:49:12.32,0:49:14.78,Default,,0,0,0,,Тайфунның артынан жүріңіз
Dialogue: 0,0:49:14.86,0:49:15.82,Default,,0,0,0,,Иә
Dialogue: 0,0:49:15.95,0:49:19.12,Default,,0,0,0,,Онда теңізге абай болғаныңыз жөн.
Dialogue: 0,0:49:26.17,0:49:29.09,Default,,0,0,0,,Мен сізге ескерту жасадым.
Dialogue: 0,0:49:32.38,0:49:33.59,Default,,0,0,0,,Хехе
Dialogue: 0,0:49:33.72,0:49:37.64,Default,,0,0,0,,Эй, мен кешкі асқа гарнир алғым келеді!
Dialogue: 0,0:49:40.64,0:49:44.39,Default,,0,0,0,,Жарайды, асықпа, мен Джимге хабарласамын.
Dialogue: 0,0:49:44.52,0:49:46.85,Default,,0,0,0,,Иә? Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:49:46.94,0:49:48.19,Default,,0,0,0,,Әрине
Dialogue: 0,0:49:49.36,0:49:53.32,Default,,0,0,0,,Мен Джимнің көмекшісі болып жұмыс істейтін океанографпын.
Dialogue: 0,0:49:53.40,0:49:56.99,Default,,0,0,0,,Күтпеген қонақтар көбейді, ендеше жазғы демалысқа шығайық.
Dialogue: 0,0:49:57.49,0:49:58.82,Default,,0,0,0,,Жазғы демалыс...
Dialogue: 0,0:49:58.95,0:50:00.45,Default,,0,0,0,,Рюка!
Dialogue: 0,0:50:05.04,0:50:06.42,Default,,0,0,0,,Сора-кун…
Dialogue: 0,0:50:22.31,0:50:24.06,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,0:50:36.03,0:50:37.91,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:50:43.45,0:50:44.58,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:50:46.16,0:50:47.79,Default,,0,0,0,,Дугонг…
Dialogue: 0,0:50:53.75,0:50:55.13,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:51:04.14,0:51:06.43,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,0:51:53.40,0:51:54.82,Default,,0,0,0,,О, айдаһар арбасы
Dialogue: 0,0:51:54.94,0:51:57.36,Default,,0,0,0,,Нақты «фестиваль» осында дерлік?
Dialogue: 0,0:51:57.48,0:51:58.36,Default,,0,0,0,,Иә
Dialogue: 0,0:51:58.49,0:52:00.15,Default,,0,0,0,,Қай жерде?
Dialogue: 0,0:52:00.32,0:52:02.07,Default,,0,0,0,,Теңізден келген ұлдар
Dialogue: 0,0:52:02.20,0:52:04.62,Default,,0,0,0,,көрсетіледі деп күтілуде
Dialogue: 0,0:52:05.16,0:52:08.00,Default,,0,0,0,,Фестивальдің куәсі болып, оның механизмін түсіндірсеңіз,
Dialogue: 0,0:52:08.12,0:52:11.17,Default,,0,0,0,,Мұхит дамуындағы серпілістерге жетелеу
Dialogue: 0,0:52:11.29,0:52:12.42,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:52:13.08,0:52:15.29,Default,,0,0,0,,Кілтті ұстаған ұлдар
Dialogue: 0,0:52:15.42,0:52:19.30,Default,,0,0,0,,Сіздің көмекшіңіз Мистер Англэд оны алып кетті деген ақпарат бар ма?
Dialogue: 0,0:52:19.47,0:52:21.97,Default,,0,0,0,,Тек уақытша бірге әрекет ету
Dialogue: 0,0:52:22.09,0:52:24.68,Default,,0,0,0,,Байланыс үшін әрқашан қол жетімді
Dialogue: 0,0:52:25.18,0:52:26.85,Default,,0,0,0,,Бірақ содан кейін нақты белгілерді қарастырайық.
Dialogue: 0,0:52:26.93,0:52:29.18,Default,,0,0,0,,Оны түсіру мүмкін емес пе?
Dialogue: 0,0:52:29.35,0:52:31.14,Default,,0,0,0,,Бұл жағдайда...
Dialogue: 0,0:52:32.06,0:52:35.27,Default,,0,0,0,,Анград сізге жол көрсетеді.
Dialogue: 0,0:52:35.40,0:52:37.02,Default,,0,0,0,,Мен оған онша сене алмаймын!
Dialogue: 0,0:52:37.11,0:52:38.69,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:52:38.78,0:52:41.28,Default,,0,0,0,,Оның кемесі қай жерде болса да анықталуы мүмкін.
Dialogue: 0,0:52:41.36,0:52:42.91,Default,,0,0,0,,Жалқау! Қазір флот...
Dialogue: 0,0:52:42.99,0:52:43.95,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:52:44.62,0:52:48.66,Default,,0,0,0,,Бізде қанша уақыт қалды?
Dialogue: 0,0:52:49.04,0:52:51.87,Default,,0,0,0,,Теңіз… Аспан…
Dialogue: 0,0:52:52.71,0:52:55.04,Default,,0,0,0,,Пуха! Ха ха ха
Dialogue: 0,0:52:56.29,0:52:57.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:01.47,0:53:03.38,Default,,0,0,0,,Уау~
Dialogue: 0,0:53:07.55,0:53:09.26,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:53:13.06,0:53:15.10,Default,,0,0,0,,Аспан да, теңіз де ашық қызыл
Dialogue: 0,0:53:15.23,0:53:17.40,Default,,0,0,0,,Сенің де көзің қызарып кетті (Рюка) А?
Dialogue: 0,0:53:17.52,0:53:18.40,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:53:19.19,0:53:20.40,Default,,0,0,0,,Уф (теңіз/аспан) хахаха
Dialogue: 0,0:53:23.82,0:53:25.95,Default,,0,0,0,,Сәлем, балалар
Dialogue: 0,0:53:26.41,0:53:28.45,Default,,0,0,0,,Сіз олжаңызды ұстадыңыз ба?
Dialogue: 0,0:53:28.95,0:53:30.41,Default,,0,0,0,,Мен оны жақында жасаймын.
Dialogue: 0,0:53:30.58,0:53:32.58,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:53:33.21,0:53:37.08,Default,,0,0,0,,Теңіз тек кешкі аспаннан ғана емес қызыл болып көрінеді.
Dialogue: 0,0:53:37.63,0:53:38.50,Default,,0,0,0,,Қараңыз.
Dialogue: 0,0:53:39.46,0:53:40.80,Default,,0,0,0,,Бұл зейінімді басқа жаққа бұрады, сондықтан кетші.
Dialogue: 0,0:53:41.46,0:53:43.42,Default,,0,0,0,,Түнде түсінесіз
Dialogue: 0,0:53:43.92,0:53:45.84,Default,,0,0,0,,А, мен ұсталдым!
Dialogue: 0,0:53:47.22,0:53:49.60,Default,,0,0,0,,Қараңыз! (Рюка) Уау!
Dialogue: 0,0:54:26.26,0:54:27.55,Default,,0,0,0,,Уау (англад) қышқыл
Dialogue: 0,0:54:27.63,0:54:28.80,Default,,0,0,0,,Эй
Dialogue: 0,0:54:34.27,0:54:35.39,Default,,0,0,0,,Иә
Dialogue: 0,0:54:36.85,0:54:42.98,Default,,0,0,0,,(Теңіздің гуілдеуі)
Dialogue: 0,0:55:14.35,0:55:15.68,Default,,0,0,0,,(Серо) Тіпті бастауыш сынып оқушысы кенеттен «Қорықпа!» деп айқайлады.
Dialogue: 0,0:55:17.85,0:55:19.69,Default,,0,0,0,,Уау~
Dialogue: 0,0:55:29.07,0:55:30.74,Default,,0,0,0,,Ммм...
Dialogue: 0,0:55:37.50,0:55:40.33,Default,,0,0,0,,Аспан Өзіңізді қалай сезінесіз?
Dialogue: 0,0:55:40.46,0:55:42.04,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:55:42.21,0:55:44.88,Default,,0,0,0,,Деректерді жинаған сайын нашарлайды.
Dialogue: 0,0:55:46.55,0:55:49.22,Default,,0,0,0,,Қайдан келдік, қайда барамыз...
Dialogue: 0,0:55:49.38,0:55:52.51,Default,,0,0,0,,Мен мұны білгім келді, сондықтан мен сынақтар мен эксперименттерден өттім.
Dialogue: 0,0:55:52.59,0:55:55.72,Default,,0,0,0,,Бірақ тіпті рентген және МРТ
Dialogue: 0,0:55:55.89,0:55:57.89,Default,,0,0,0,,Ешқандай ауытқулар табылмады
Dialogue: 0,0:56:00.44,0:56:02.90,Default,,0,0,0,,Мен денемді қайта жасап жатқандай сезінемін.
Dialogue: 0,0:56:03.06,0:56:06.44,Default,,0,0,0,,Ғылымның көз алдында біздің денемізде не болып жатыр?
Dialogue: 0,0:56:06.57,0:56:08.03,Default,,0,0,0,,Мен оны көре алмаймын.
Dialogue: 0,0:56:09.74,0:56:12.61,Default,,0,0,0,,Бұл дүниедегі барлық нәрселерден
Dialogue: 0,0:56:12.74,0:56:14.99,Default,,0,0,0,,Біз адамдар нені көре аламыз
Dialogue: 0,0:56:15.12,0:56:17.29,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:56:17.41,0:56:20.33,Default,,0,0,0,,Ғаламды бақылау технологиясы дамыған сайын, біз...
Dialogue: 0,0:56:21.04,0:56:25.54,Default,,0,0,0,,Ешбір әдіспен байқауға болмайтын «қараңғы материяның» болуы
Dialogue: 0,0:56:26.50,0:56:30.22,Default,,0,0,0,,Әлемнің күйінен есептелетін материя мөлшерінің қосындысы тең
Dialogue: 0,0:56:30.30,0:56:32.76,Default,,0,0,0,,қалыптыдан 10 есе немесе көп
Dialogue: 0,0:56:33.72,0:56:36.22,Default,,0,0,0,,Сонымен, ғаламның жалпы массасының 90%-дан астамы
Dialogue: 0,0:56:36.35,0:56:39.39,Default,,0,0,0,,Кеңістікті белгісіз қараңғы материя алып жатыр.
Dialogue: 0,0:56:39.52,0:56:41.23,Default,,0,0,0,,Сіз барлығын дерлік айтасыз ба?
Dialogue: 0,0:56:41.35,0:56:42.39,Default,,0,0,0,,Иә
Dialogue: 0,0:56:42.94,0:56:45.81,Default,,0,0,0,,Ештеңені көрмейтін сияқтымыз.
Dialogue: 0,0:56:46.98,0:56:50.11,Default,,0,0,0,,Бұл дүние көзге көрінбейтін нәрселерге толы.
Dialogue: 0,0:56:50.28,0:56:53.95,Default,,0,0,0,,Әлем біз көріп тұрғаннан әлдеқайда үлкен.
Dialogue: 0,0:56:54.45,0:56:57.70,Default,,0,0,0,,Менің ойымша, ғалам адамдарға ұқсас.
Dialogue: 0,0:56:58.12,0:56:59.45,Default,,0,0,0,,Иә
Dialogue: 0,0:57:00.00,0:57:01.25,Default,,0,0,0,,Кейбір адамдар
Dialogue: 0,0:57:01.37,0:57:06.13,Default,,0,0,0,,Естеліктердің көптеген шағын фрагменттері бір-бірінен қалқып тұрады
Dialogue: 0,0:57:06.79,0:57:10.80,Default,,0,0,0,,Кейбір триггердің арқасында бірнеше жады қосылған.
Dialogue: 0,0:57:10.96,0:57:13.09,Default,,0,0,0,,Сол ескірек жадта
Dialogue: 0,0:57:13.22,0:57:17.35,Default,,0,0,0,,Сонымен қатар, әртүрлі естеліктер тартылып, байланысады.
Dialogue: 0,0:57:17.47,0:57:19.22,Default,,0,0,0,,Үлкен болу
Dialogue: 0,0:57:22.43,0:57:26.19,Default,,0,0,0,,«Ойлау» немесе «ойлау» деген осы емес пе?
Dialogue: 0,0:57:27.56,0:57:28.98,Default,,0,0,0,,Бұл...
Dialogue: 0,0:57:29.48,0:57:30.82,Default,,0,0,0,,Бұл сияқты
Dialogue: 0,0:57:31.40,0:57:36.82,Default,,0,0,0,,Жұлдыздың тууы Галактиканың тууы сияқты...
Dialogue: 0,0:57:38.16,0:57:40.66,Default,,0,0,0,,Ғарыш және адамдар
Dialogue: 0,0:58:07.65,0:58:09.61,Default,,0,0,0,,Сора-кун мен Англад ше?
Dialogue: 0,0:58:09.69,0:58:11.44,Default,,0,0,0,,(Теңіздің ыңылдауы)
Dialogue: 0,0:58:15.03,0:58:16.49,Default,,0,0,0,,Уми-кун?
Dialogue: 0,0:58:16.61,0:58:18.45,Default,,0,0,0,,(Теңіздің қатты тыныс алуы)
Dialogue: 0,0:58:18.57,0:58:20.08,Default,,0,0,0,,Өте ыстық
Dialogue: 0,0:58:34.13,0:58:35.55,Default,,0,0,0,,Аа.
Dialogue: 0,0:58:45.43,0:58:47.02,Default,,0,0,0,,Мен кішкентай кезімде-
Dialogue: 0,0:58:48.19,0:58:50.52,Default,,0,0,0,,Анаң маған осылай берді...
Dialogue: 0,0:58:56.28,0:58:59.91,Default,,0,0,0,,♪ Сәлем!
Dialogue: 0,0:59:00.07,0:59:03.74,Default,,0,0,0,,♪ Обероньо
Dialogue: 0,0:59:03.95,0:59:07.62,Default,,0,0,0,,♪ Бұл бала сүйкімді
Dialogue: 0,0:59:08.08,0:59:11.42,Default,,0,0,0,,♪ Шексіз
Dialogue: 0,0:59:14.09,0:59:15.59,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:59:24.77,0:59:26.93,Default,,0,0,0,,Анград яхтасы жоқ
Dialogue: 0,0:59:27.64,0:59:28.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:28.89,0:59:31.61,Default,,0,0,0,,Су жарқырап тұр
Dialogue: 0,0:59:32.31,0:59:34.02,Default,,0,0,0,,Түнгі жәндік (Рюка) Уау!
Dialogue: 0,0:59:34.11,0:59:35.73,Default,,0,0,0,,Сора-кун!
Dialogue: 0,0:59:35.86,0:59:37.28,Default,,0,0,0,,Бұл түнгі жәндік.
Dialogue: 0,0:59:37.40,0:59:38.70,Default,,0,0,0,,Якочю?
Dialogue: 0,0:59:38.82,0:59:41.53,Default,,0,0,0,,Міне, сондықтан кешке теңіз қызыл болды
Dialogue: 0,0:59:41.66,0:59:42.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:42.70,0:59:44.83,Default,,0,0,0,,Фитопланктонның бір түрі
Dialogue: 0,0:59:44.95,0:59:46.83,Default,,0,0,0,,Тітіркенген кезде жарқырайды
Dialogue: 0,0:59:47.79,0:59:49.12,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:59:51.12,0:59:53.63,Default,,0,0,0,,Қызыл теңіз көк болып жарқырайды...
Dialogue: 0,0:59:55.42,0:59:57.30,Default,,0,0,0,,Сора-кун?
Dialogue: 0,1:00:14.06,1:00:15.07,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,1:00:18.78,1:00:20.99,Default,,0,0,0,,Су кесектерге бөлінеді.
Dialogue: 0,1:00:21.11,1:00:24.03,Default,,0,0,0,,Сол кесекпен сырғанап жүрсеңіз, оңай жүзе аласыз.
Dialogue: 0,1:00:27.33,1:00:28.66,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,1:00:32.21,1:00:34.00,Default,,0,0,0,,Мен де істей аламын ба?
Dialogue: 0,1:00:35.29,1:00:36.17,Default,,0,0,0,,Әй!
Dialogue: 0,1:00:51.23,1:00:52.56,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,1:00:54.69,1:00:56.02,Default,,0,0,0,,Эрвин, бұның бәрі сенің операцияңның нәтижесі ме?
Dialogue: 0,1:00:57.36,1:00:58.98,Default,,0,0,0,,Мәңгі осылай қал
Dialogue: 0,1:01:00.53,1:01:03.03,Default,,0,0,0,,Дәл осылай, жұлдыздарға дейін
Dialogue: 0,1:01:03.20,1:01:04.70,Default,,0,0,0,,Мен жүзе алатын сияқтымын
Dialogue: 0,1:01:09.20,1:01:11.33,Default,,0,0,0,,Құс жолы жоғары және төмен
Dialogue: 0,1:01:12.54,1:01:14.79,Default,,0,0,0,,Ертең жаңа ай
Dialogue: 0,1:01:14.88,1:01:17.09,Default,,0,0,0,,Өмір бесігіңдей
Dialogue: 0,1:01:18.84,1:01:21.46,Default,,0,0,0,,Өртеніп кеткен метеорит туралы
Dialogue: 0,1:01:21.59,1:01:23.93,Default,,0,0,0,,Бүкіл мұхит қозғалады
Dialogue: 0,1:01:24.05,1:01:25.72,Default,,0,0,0,,Бұл туралы не ойлау керек...
Dialogue: 0,1:01:26.22,1:01:29.64,Default,,0,0,0,,Мүмкін біз өмір сүріп жатқан бұл әлем...
Dialogue: 0,1:01:32.60,1:01:37.40,Default,,0,0,0,,Бәлкім, бұл терең теңізді толтырған сансыз снарядтар шашыратқан арман шығар.
Dialogue: 0,1:01:38.23,1:01:42.24,Default,,0,0,0,,Теңіз мен аспан... олар шынымен қайдан шыққан?
Dialogue: 0,1:01:43.32,1:01:44.82,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:01:44.91,1:01:47.45,Default,,0,0,0,,Олар енді қайда барады?
Dialogue: 0,1:01:47.57,1:01:50.66,Default,,0,0,0,,Біз де солай.
Dialogue: 0,1:01:55.29,1:01:57.00,Default,,0,0,0,,Мен бұл балаларға сенімдімін
Dialogue: 0,1:01:57.13,1:02:00.67,Default,,0,0,0,,Бізден басқа уақытта және жерде тұру
Dialogue: 0,1:02:00.80,1:02:03.59,Default,,0,0,0,,Ол әлемге қарап тұрған болуы керек.
Dialogue: 0,1:02:04.05,1:02:08.14,Default,,0,0,0,,Біздің қиялымыздан тыс басқа әлемде.
Dialogue: 0,1:02:08.93,1:02:12.27,Default,,0,0,0,,Бірақ ол біздің алдымызда пайда болды.
Dialogue: 0,1:02:14.27,1:02:16.94,Default,,0,0,0,,Біз не істей аламыз?
Dialogue: 0,1:02:17.10,1:02:20.36,Default,,0,0,0,,Ол балалардың жолына түспеу туралы.
Dialogue: 0,1:02:20.48,1:02:22.86,Default,,0,0,0,,Сол балаларға көмектескіңіз келсе
Dialogue: 0,1:02:22.98,1:02:25.82,Default,,0,0,0,,Мені мақтаншақтардан сақта
Dialogue: 0,1:02:27.49,1:02:30.24,Default,,0,0,0,,Жақында «фестиваль» келеді.
Dialogue: 0,1:02:32.45,1:02:36.29,Default,,0,0,0,,Ал қонақтарды қазірге дейін шешу керек еді.
Dialogue: 0,1:02:40.34,1:02:41.75,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,1:02:42.92,1:02:46.84,Default,,0,0,0,,Мұхиттың іші де пішінін өзгертуде.
Dialogue: 0,1:02:48.84,1:02:52.01,Default,,0,0,0,,Уақыты келгенде мен де...
Dialogue: 0,1:02:52.43,1:02:54.02,Default,,0,0,0,,Қашан...
Dialogue: 0,1:03:04.82,1:03:06.57,Default,,0,0,0,,Өте әдемі
Dialogue: 0,1:03:09.66,1:03:12.45,Default,,0,0,0,,Оның жарқыраған себебі, мен оны тапқаныңды қалаймын.
Dialogue: 0,1:03:12.53,1:03:14.83,Default,,0,0,0,,Уми-кун маған айтты
Dialogue: 0,1:03:16.62,1:03:20.00,Default,,0,0,0,,Әдемі жарық әйтеуір жалғыздықты сезінеді
Dialogue: 0,1:03:21.42,1:03:23.00,Default,,0,0,0,,Өкінішті...
Dialogue: 0,1:03:24.34,1:03:26.38,Default,,0,0,0,,Менің ойымша, бұл ақыр соңында жоғалып кеткендіктен.
Dialogue: 0,1:03:27.38,1:03:30.47,Default,,0,0,0,,Жоғалса да қалай жарқырайды...
Dialogue: 0,1:03:38.77,1:03:40.85,Default,,0,0,0,,Мен солай ойлағандықтан.
Dialogue: 0,1:03:41.02,1:03:43.27,Default,,0,0,0,,Атап айтқанда, ештеңе жоқ... Иә?
Dialogue: 0,1:03:47.11,1:03:48.07,Default,,0,0,0,,(қатты нәрсеге соғылған дыбыс)
Dialogue: 0,1:03:53.87,1:03:55.62,Default,,0,0,0,,Мен бірдеңе іштім.
Dialogue: 0,1:03:56.29,1:03:59.29,Default,,0,0,0,,Метеорит Мен оны саған тапсыруды жөн көрдім.
Dialogue: 0,1:03:59.75,1:04:00.87,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:12.09,1:04:13.22,Default,,0,0,0,,Егер—
Dialogue: 0,1:04:14.80,1:04:18.10,Default,,0,0,0,,Метеорит мұхитқа қажет болса
Dialogue: 0,1:04:18.22,1:04:20.85,Default,,0,0,0,,Ішіңді кесіп, маған бер.
Dialogue: 0,1:04:29.74,1:04:30.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:40.50,1:04:41.71,Default,,0,0,0,,Не?
Dialogue: 0,1:04:44.54,1:04:45.75,Default,,0,0,0,,Сора-кун?
Dialogue: 0,1:04:59.35,1:05:00.85,Default,,0,0,0,,Шамасы...
Dialogue: 0,1:05:01.77,1:05:03.73,Default,,0,0,0,,Уақыт шынымен бітті.
Dialogue: 0,1:05:03.85,1:05:05.27,Default,,0,0,0,,Сора-кун!
Dialogue: 0,1:05:06.86,1:05:10.49,Default,,0,0,0,,Толық ай түні болады деп болжадым...
Dialogue: 0,1:05:12.65,1:05:15.95,Default,,0,0,0,,Джим де, Англэйд те сақтықтарын түсірді.
Dialogue: 0,1:05:16.16,1:05:17.95,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,1:05:18.12,1:05:20.04,Default,,0,0,0,,Теңізде, аз болса да...
Dialogue: 0,1:05:20.45,1:05:22.00,Default,,0,0,0,,Сора-кун!
Dialogue: 0,1:05:23.83,1:05:27.96,Default,,0,0,0,,Дюгон күндіз мені алып кетуге келді ме екен...
Dialogue: 0,1:05:29.30,1:05:32.63,Default,,0,0,0,,Бұл мен күткеннен жылдамырақ болды.
Dialogue: 0,1:05:35.80,1:05:37.30,Default,,0,0,0,,Жылдам, оны өртеп жіберші!
Dialogue: 0,1:05:38.93,1:05:40.01,Default,,0,0,0,,Сора-кун!
Dialogue: 0,1:05:53.03,1:05:55.78,Default,,0,0,0,,(дыбыс толқыны сияқты)
Dialogue: 0,1:05:56.32,1:05:58.49,Default,,0,0,0,,Қандай дыбыс? Тағы да...
Dialogue: 0,1:05:58.62,1:06:00.99,Default,,0,0,0,,(дыбыс толқыны сияқты)
Dialogue: 0,1:06:05.96,1:06:07.17,Default,,0,0,0,,Ха!
Dialogue: 0,1:06:18.89,1:06:20.51,Default,,0,0,0,,(айқай)
Dialogue: 0,1:06:22.06,1:06:23.56,Default,,0,0,0,,Жылдам жылдам
Dialogue: 0,1:06:27.90,1:06:30.73,Default,,0,0,0,,Уми-кун, сөзіңді ұмыттың ба?
Dialogue: 0,1:06:30.86,1:06:33.74,Default,,0,0,0,,Қайтып келгеннен бері бірде-бір сөз айтпадың.
Dialogue: 0,1:06:33.86,1:06:35.82,Default,,0,0,0,,Жылдам жылдам
Dialogue: 0,1:06:36.24,1:06:38.70,Default,,0,0,0,,Келіңіздер, шоу басталғалы жатыр.
Dialogue: 0,1:06:41.20,1:06:42.62,Default,,0,0,0,,Жылдам жылдам
Dialogue: 0,1:06:46.46,1:06:47.62,Default,,0,0,0,,Жылдам жылдам
Dialogue: 0,1:07:05.64,1:07:08.73,Default,,0,0,0,,Жарайды, аман-есен оралғаныңызға қуаныштымын.
Dialogue: 0,1:07:08.90,1:07:10.81,Default,,0,0,0,,Сөз сияқты
Dialogue: 0,1:07:10.98,1:07:12.44,Default,,0,0,0,,Менің айтқым келгені бұл емес еді...
Dialogue: 0,1:07:12.57,1:07:14.44,Default,,0,0,0,,Бұл бір нәрсе.
Dialogue: 0,1:07:15.07,1:07:18.70,Default,,0,0,0,,Рюканың үйде отырғысы келмейтін себебі, менің осындай болғанымнан шығар.
Dialogue: 0,1:07:18.82,1:07:21.24,Default,,0,0,0,,Сіз кеткен кездегідей
Dialogue: 0,1:07:21.66,1:07:23.95,Default,,0,0,0,,Рюка екеуің бірдейсіңдер.
Dialogue: 0,1:07:26.91,1:07:29.58,Default,,0,0,0,,Тіпті біреу менің сезімімді түсінгенін қаласам да
Dialogue: 0,1:07:29.75,1:07:31.25,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,1:07:31.79,1:07:34.75,Default,,0,0,0,,Сіз жай ғана тітіркеніп, ашуланасыз, солай ма?
Dialogue: 0,1:07:35.34,1:07:38.22,Default,,0,0,0,,Екеуіміздің де өмір сүруіміз ыңғайсыз.
Dialogue: 0,1:07:38.76,1:07:40.22,Default,,0,0,0,,Мен ақыры түсіндім.
Dialogue: 0,1:07:41.09,1:07:44.81,Default,,0,0,0,,Осы уақытқа дейін мен ештеңені қабылдай алмадым.
Dialogue: 0,1:07:52.52,1:07:53.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:55.98,1:07:57.32,Default,,0,0,0,,Сіз ебедейсіз.
Dialogue: 0,1:07:58.78,1:07:59.95,Default,,0,0,0,,Сіз де
Dialogue: 0,1:08:04.45,1:08:07.29,Default,,0,0,0,,Елеусіз түрде мен оны дұрыс орындағым келеді.
Dialogue: 0,1:08:07.45,1:08:09.58,Default,,0,0,0,,Егер әлі де рұқсат етілсе...
Dialogue: 0,1:08:14.13,1:08:18.34,Default,,0,0,0,,Біздің мұнда шынымен де өз үйіміз бар.
Dialogue: 0,1:08:23.80,1:08:25.39,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,1:08:32.77,1:08:34.98,Default,,0,0,0,,Сен осындасың, Джим.
Dialogue: 0,1:08:36.07,1:08:37.23,Default,,0,0,0,,О
Dialogue: 0,1:08:44.82,1:08:46.53,Default,,0,0,0,,Сіз уақытында үлгермедіңіз.
Dialogue: 0,1:08:48.04,1:08:49.87,Default,,0,0,0,,Аспан ұшып кетті
Dialogue: 0,1:08:51.00,1:08:54.58,Default,,0,0,0,,Сол кезде мен теңіз суы арқылы өтетін дыбысты естідім.
Dialogue: 0,1:08:56.04,1:08:59.17,Default,,0,0,0,,698,45 Герц
Dialogue: 0,1:08:59.55,1:09:01.72,Default,,0,0,0,,Өліп бара жатқан жұлдыздың дыбысы...
Dialogue: 0,1:09:03.34,1:09:05.51,Default,,0,0,0,,Теңіз ыстық
Dialogue: 0,1:09:06.72,1:09:11.02,Default,,0,0,0,,Рюка жағада ес-түссіз жатып қалды.
Dialogue: 0,1:09:14.56,1:09:17.94,Default,,0,0,0,,Аспан өлді ме?
Dialogue: 0,1:09:20.49,1:09:21.86,Default,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,1:09:25.20,1:09:27.91,Default,,0,0,0,,Деде айтып отырған «фестиваль» осы ма?
Dialogue: 0,1:09:35.46,1:09:36.46,Default,,0,0,0,,Ақыр соңында-
Dialogue: 0,1:09:38.34,1:09:42.09,Default,,0,0,0,,Бұл біз ештеңе істей алмадық дегенді білдіре ме...
Dialogue: 0,1:09:43.22,1:09:44.55,Default,,0,0,0,,Иә...
Dialogue: 0,1:09:56.02,1:09:59.15,Default,,0,0,0,,Бірақ мен аспанды сезінемін
Dialogue: 0,1:10:07.03,1:10:09.87,Default,,0,0,0,,Мен аспанның арғы жағына қарауым керек
Dialogue: 0,1:10:18.50,1:10:26.43,Default,,0,0,0,,(Мацубаяши)
Dialogue: 0,1:10:37.65,1:10:39.27,Default,,0,0,0,,(Мацубаяши)
Dialogue: 0,1:10:39.44,1:10:40.94,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:10:42.90,1:10:44.19,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:10:44.32,1:10:45.28,Default,,0,0,0,,Рюка
Dialogue: 0,1:10:46.53,1:10:47.95,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:10:50.28,1:10:51.78,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:10:54.00,1:10:55.54,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:10:57.12,1:10:58.67,Default,,0,0,0,,(Мацубаяши)
Dialogue: 0,1:11:16.77,1:11:19.65,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,1:11:28.20,1:11:29.82,Default,,0,0,0,,(Мацубаяши)
Dialogue: 0,1:11:43.00,1:11:45.34,Default,,0,0,0,,(Ән: Kii-)
Dialogue: 0,1:11:45.80,1:11:46.88,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:11:46.96,1:11:48.47,Default,,0,0,0,,Мен үйге барамын.
Dialogue: 0,1:11:50.72,1:11:54.51,Default,,0,0,0,,Дененің тереңінде спираль бар.
Dialogue: 0,1:11:56.10,1:11:58.35,Default,,0,0,0,,Бұл не...
Dialogue: 0,1:12:08.99,1:12:10.07,Default,,0,0,0,,Не болды?
Dialogue: 0,1:12:10.20,1:12:12.20,Default,,0,0,0,,Теңізде бірдеңе бар ма?
Dialogue: 0,1:12:12.28,1:12:13.57,Default,,0,0,0,,Теңіз дегеніміз не?
Dialogue: 0,1:12:13.66,1:12:16.87,Default,,0,0,0,,Сәлем! (Әйел) Бұл не? кит?
Dialogue: 0,1:12:16.99,1:12:18.33,Default,,0,0,0,,Анашым, бұл не?
Dialogue: 0,1:12:18.41,1:12:20.58,Default,,0,0,0,,Бастық! Жағалауда кит бар!
Dialogue: 0,1:12:20.75,1:12:21.67,Default,,0,0,0,,Кит!?
Dialogue: 0,1:12:32.30,1:12:34.60,Default,,0,0,0,,Үлкен! (Масааки) Бұл өркеш кит.
Dialogue: 0,1:12:41.23,1:12:44.44,Default,,0,0,0,,(Киттің толқыны)
Dialogue: 0,1:12:53.95,1:12:55.83,Default,,0,0,0,,Сенің көздерің
Dialogue: 0,1:12:55.95,1:12:59.12,Default,,0,0,0,,Бұл жерде емес, алыс жерге жалғанған.
Dialogue: 0,1:13:00.08,1:13:02.58,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,1:13:04.42,1:13:06.92,Default,,0,0,0,,Мен теңіздің барлық кәсіптерінің докрымын
Dialogue: 0,1:13:07.59,1:13:08.50,Default,,0,0,0,,Атпен жүру
Dialogue: 0,1:13:15.55,1:13:18.01,Default,,0,0,0,,Жел де жақсы, толқын да жақсы.
Dialogue: 0,1:13:18.10,1:13:20.43,Default,,0,0,0,,Осы арқылы мен сол китті қуып жетемін деп ойлаймын.
Dialogue: 0,1:13:21.43,1:13:23.90,Default,,0,0,0,,Мен ән естідім
Dialogue: 0,1:13:24.27,1:13:27.48,Default,,0,0,0,,Мен қонақ іздеп жүрмін.
Dialogue: 0,1:13:29.82,1:13:32.32,Default,,0,0,0,,Жұлдыздар әнін орындағанда
Dialogue: 0,1:13:32.53,1:13:33.91,Default,,0,0,0,,Жұлдыздар әні...
Dialogue: 0,1:13:34.66,1:13:38.99,Default,,0,0,0,,«Жұлдыздар теңізі – туған жер».
Dialogue: 0,1:13:39.79,1:13:41.91,Default,,0,0,0,,«Ауланған жұлдыз теңізге түседі»
Dialogue: 0,1:13:42.50,1:13:44.62,Default,,0,0,0,,«Толқындар тербеткен ұйқы»
Dialogue: 0,1:13:44.75,1:13:46.96,Default,,0,0,0,,Ұмытып кеткен әннің жалғасы есіме түсті
Dialogue: 0,1:13:47.08,1:13:50.55,Default,,0,0,0,,Анам айтқан бесік жыры...
Dialogue: 0,1:13:58.22,1:14:11.65,Default,,0,0,0,,(Муккури орындау)
Dialogue: 0,1:14:11.82,1:14:13.40,Default,,0,0,0,,Желмен ән айту
Dialogue: 0,1:14:15.99,1:14:18.37,Default,,0,0,0,,Жұлдызды кит әні
Dialogue: 0,1:14:18.45,1:14:21.33,Default,,0,0,0,,Жел барлық теңіздер туралы естеліктерге толы.
Dialogue: 0,1:14:21.83,1:14:27.42,Default,,0,0,0,,Оны сөзге айналдырып, өлең, жыр арқылы жеткіздік.
Dialogue: 0,1:14:27.50,1:14:32.51,Default,,0,0,0,,Бірақ шектеулі сөздер желдің аз ғана бөлігін түсіре алады.
Dialogue: 0,1:14:32.88,1:14:34.97,Default,,0,0,0,,Осы желкенді ұнатыңыз
Dialogue: 0,1:14:35.88,1:14:40.64,Default,,0,0,0,,Бұл желмен толып жатқан сезімдер туралы айту.
Dialogue: 0,1:14:40.76,1:14:42.64,Default,,0,0,0,,Теңіз туралы естеліктермен
Dialogue: 0,1:14:44.39,1:14:48.19,Default,,0,0,0,,(Муккури орындау)
Dialogue: 0,1:14:48.35,1:14:51.98,Default,,0,0,0,,Желге мініп, Кішкене дауысты естимін
Dialogue: 0,1:14:54.03,1:14:57.32,Default,,0,0,0,,Кездейсоқ кезде кездесеміз.
Dialogue: 0,1:14:59.41,1:15:03.33,Default,,0,0,0,,Өткен немесе болашақ біреудің есінде...
Dialogue: 0,1:15:18.30,1:15:20.59,Default,,0,0,0,,Жалған өлтіруші киттердің тобы.
Dialogue: 0,1:15:20.72,1:15:23.22,Default,,0,0,0,,Олардың баратын жері бір.
Dialogue: 0,1:15:24.72,1:15:25.93,Default,,0,0,0,,Егер бұл...
Dialogue: 0,1:15:26.06,1:15:27.39,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:15:28.02,1:15:31.36,Default,,0,0,0,,Иә? Неге секірдің?
Dialogue: 0,1:15:36.07,1:15:37.57,Default,,0,0,0,,Уми-кун жоқ
Dialogue: 0,1:15:41.20,1:15:42.24,Default,,0,0,0,,(айқай)
Dialogue: 0,1:15:42.32,1:15:43.78,Default,,0,0,0,,Не?
Dialogue: 0,1:15:43.91,1:15:45.75,Default,,0,0,0,,СМАШ АҚШ-ы!
Dialogue: 0,1:15:45.83,1:15:47.08,Default,,0,0,0,,(айқай)
Dialogue: 0,1:15:52.42,1:15:55.13,Default,,0,0,0,,Сора-кун не сезінеді
Dialogue: 0,1:15:55.25,1:15:57.26,Default,,0,0,0,,Мен де сеземін
Dialogue: 0,1:16:11.98,1:16:13.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:54.61,1:16:57.65,Default,,0,0,0,,(Рюканың ауыр тыныс алуы)
Dialogue: 0,1:17:46.74,1:17:48.49,Default,,0,0,0,,А...?
Dialogue: 0,1:17:50.37,1:17:53.04,Default,,0,0,0,,Рюка әні келе жатыр!
Dialogue: 0,1:17:55.71,1:17:56.88,Default,,0,0,0,,Уми-кун?
Dialogue: 0,1:17:57.63,1:17:59.80,Default,,0,0,0,,«Тікелей» (Рюка) Иә?
Dialogue: 0,1:18:01.13,1:18:03.51,Default,,0,0,0,,(сықырлау)
Dialogue: 0,1:18:03.59,1:18:08.39,Default,,0,0,0,,
Dialogue: 0,1:18:08.51,1:18:12.31,Default,,0,0,0,,Уау!
Dialogue: 0,1:18:13.64,1:18:19.48,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,1:18:27.20,1:18:30.87,Default,,0,0,0,,Керемет! Мұндай күшті дыбысты бірінші рет естіп тұрмын.
Dialogue: 0,1:18:40.79,1:18:42.59,Default,,0,0,0,,Теңіз туралы бәрі...
Dialogue: 0,1:18:43.55,1:18:46.88,Default,,0,0,0,,Теңіздегі барлық нәрсе қозғала бастады
Dialogue: 0,1:19:06.28,1:19:08.95,Default,,0,0,0,,Бұл қауіпсіздік туралы өте тым асыра мәліметтер.
Dialogue: 0,1:19:09.07,1:19:11.41,Default,,0,0,0,,Өте қалыпты деңгей
Dialogue: 0,1:19:11.58,1:19:14.12,Default,,0,0,0,,Ұпайлар күтілген нүктелерден біршама басқаша сияқты.
Dialogue: 0,1:19:14.29,1:19:15.62,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,1:19:15.79,1:19:20.38,Default,,0,0,0,,Олар фестивальдің орталығы және оларда барлық жауаптар бар.
Dialogue: 0,1:19:20.58,1:19:22.46,Default,,0,0,0,,Керемет жаттығу залы!
Dialogue: 0,1:19:22.59,1:19:25.42,Default,,0,0,0,,Арнайы орындар енді біздікі.
Dialogue: 0,1:19:27.47,1:19:29.39,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:19:32.01,1:19:34.47,Default,,0,0,0,,Мен басқа жолмен жүремін
Dialogue: 0,1:19:37.81,1:19:41.65,Default,,0,0,0,,Мен оларға ештеңе істей алмаймын ба деп ойлаймын...
Dialogue: 0,1:19:44.86,1:19:47.53,Default,,0,0,0,,Сол балаларға қалған уақыт
Dialogue: 0,1:19:47.65,1:19:50.61,Default,,0,0,0,,Мен оны сәл де болса кейінге қалдырғым келді.
Dialogue: 0,1:19:50.70,1:19:52.87,Default,,0,0,0,,Дегенмен, бұл зерттеу
Dialogue: 0,1:19:52.99,1:19:57.83,Default,,0,0,0,,Бұл балаларды пайдалану мақсаты өзгерді.
Dialogue: 0,1:19:58.33,1:19:59.75,Default,,0,0,0,,Деде
Dialogue: 0,1:19:59.96,1:20:04.50,Default,,0,0,0,,Балаларды сол менмендерден қорғаңыз.
Dialogue: 0,1:20:05.30,1:20:09.55,Default,,0,0,0,,Адамдарды осы планетадағы ең ұлы деп санайтындардан...
Dialogue: 0,1:20:13.39,1:20:16.77,Default,,0,0,0,,Бұл оларды қорғады ма?
Dialogue: 0,1:20:16.89,1:20:18.14,Default,,0,0,0,,Джим!
Dialogue: 0,1:20:19.18,1:20:20.85,Default,,0,0,0,,Теңіз де, Рюка да жоқ.
Dialogue: 0,1:20:21.81,1:20:23.52,Default,,0,0,0,,Сіз бәрін білесіз, солай ма?
Dialogue: 0,1:20:25.36,1:20:27.57,Default,,0,0,0,,Бізді алып кетіңіз
Dialogue: 0,1:20:27.74,1:20:29.36,Default,,0,0,0,,Рюкаға барыңыз!
Dialogue: 0,1:20:29.45,1:20:30.57,Default,,0,0,0,,Иә
Dialogue: 0,1:20:40.79,1:20:42.04,Default,,0,0,0,,Балық
Dialogue: 0,1:20:44.38,1:20:45.79,Default,,0,0,0,,(Роко) Куфуфуфу. Мақтаның жараланды ма?
Dialogue: 0,1:20:46.80,1:20:48.76,Default,,0,0,0,,Үй - осылай.
Dialogue: 0,1:20:54.26,1:20:55.26,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:58.89,1:20:59.89,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:21:01.44,1:21:04.40,Default,,0,0,0,,Мұнда теңіз жануарлары өмір сүре алмайды.
Dialogue: 0,1:21:05.23,1:21:06.36,Default,,0,0,0,,Уау
Dialogue: 0,1:21:07.23,1:21:09.40,Default,,0,0,0,,Уми-кун!? Сенімен бәрі жақсы ма?
Dialogue: 0,1:21:10.24,1:21:11.32,Default,,0,0,0,,Уми-кун!
Dialogue: 0,1:21:11.40,1:21:13.53,Default,,0,0,0,,Бізге тезірек суға оралу керек.
Dialogue: 0,1:21:15.28,1:21:16.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:18.16,1:21:20.25,Default,,0,0,0,,Уми-кун қайсысы?
Dialogue: 0,1:21:41.35,1:21:42.60,Default,,0,0,0,,Ха!
Dialogue: 0,1:21:43.52,1:21:45.85,Default,,0,0,0,,Уми-кун! қайда?
Dialogue: 0,1:21:49.11,1:21:49.98,Default,,0,0,0,,Уми-кун
Dialogue: 0,1:22:03.00,1:22:04.00,Default,,0,0,0,,Га
Dialogue: 0,1:22:06.00,1:22:07.00,Default,,0,0,0,,Ха!
Dialogue: 0,1:22:34.78,1:22:35.86,Default,,0,0,0,,Не?
Dialogue: 0,1:22:42.33,1:22:43.58,Default,,0,0,0,,Бұл адам —
Dialogue: 0,1:22:44.16,1:22:48.25,Default,,0,0,0,,Мен мұнда өте, өте ұзақ уақыт жалғыз болдым ...
Dialogue: 0,1:22:49.33,1:22:50.79,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,1:22:53.71,1:22:55.22,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,1:22:55.97,1:23:00.80,Default,,0,0,0,,Соншалықты терең және жарықсыз әлемде де өмір бар.
Dialogue: 0,1:23:02.06,1:23:06.52,Default,,0,0,0,,Барлығы су... тірі заттардың жады
Dialogue: 0,1:23:09.06,1:23:11.82,Default,,0,0,0,,(кит әні)
Dialogue: 0,1:23:11.98,1:23:13.03,Default,,0,0,0,,Уф
Dialogue: 0,1:23:24.83,1:23:27.37,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:23:29.67,1:23:31.25,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:23:35.63,1:23:37.47,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,1:23:51.65,1:23:53.69,Default,,0,0,0,,Сора-кун...?
Dialogue: 0,1:23:56.40,1:24:00.36,Default,,0,0,0,,Рюка, сенің рөлің осымен аяқталады.
Dialogue: 0,1:24:00.78,1:24:02.37,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,1:24:04.03,1:24:05.08,Default,,0,0,0,,Рөл?
Dialogue: 0,1:24:05.54,1:24:08.66,Default,,0,0,0,,Иә, метеорит оянды.
Dialogue: 0,1:24:10.83,1:24:13.04,Default,,0,0,0,,Метеорит оянғанда не болады?
Dialogue: 0,1:24:13.50,1:24:16.26,Default,,0,0,0,,Үлкен құйынның орталығы бол
Dialogue: 0,1:24:17.09,1:24:19.30,Default,,0,0,0,,Білгіңіз келсе, тексеріп алыңыз.
Dialogue: 0,1:24:19.97,1:24:23.80,Default,,0,0,0,,Қарап отырмай соңына дейін тамашалай алсаңыз
Dialogue: 0,1:24:27.52,1:24:30.60,Default,,0,0,0,,Сора-кун... сен Сора-кун емессің бе?
Dialogue: 0,1:24:31.27,1:24:32.81,Default,,0,0,0,,Мен айттым
Dialogue: 0,1:24:33.48,1:24:35.77,Default,,0,0,0,,Метеорит естеліктерді араластырады
Dialogue: 0,1:24:35.90,1:24:40.07,Default,,0,0,0,,Бұл да сіз білетін адам туралы естелік.
Dialogue: 0,1:24:40.20,1:24:41.95,Default,,0,0,0,,Бұл метеорит
Dialogue: 0,1:24:42.11,1:24:43.99,Default,,0,0,0,,Бұл да сенің бір бөлігің
Dialogue: 0,1:24:44.74,1:24:47.41,Default,,0,0,0,,Енді қабақтарымызды жұмайық.
Dialogue: 0,1:24:48.45,1:24:50.29,Default,,0,0,0,,Баяу қабылдаңыз...
Dialogue: 0,1:24:51.79,1:24:52.92,Default,,0,0,0,,Жақсы бала
Dialogue: 0,1:24:54.96,1:24:58.84,Default,,0,0,0,,Аспан мен теңіз қабаттасып, өмір мерекесі басталады.
Dialogue: 0,1:24:58.96,1:25:02.38,Default,,0,0,0,,Туған күннің қуанышын бірге айтайық!
Dialogue: 0,1:25:03.55,1:25:05.47,Default,,0,0,0,,Бұл сенің бесік жырың
Dialogue: 0,1:25:05.60,1:25:08.97,Default,,0,0,0,,Сіз оны естисіз, солай ма? Мен ән айта бастадым
Dialogue: 0,1:25:09.64,1:25:14.52,Default,,0,0,0,,Бүкіл ғалам бір ауыздан сөйлейді!
Dialogue: 0,1:25:17.48,1:25:19.40,Default,,0,0,0,,Сора-кунның бейберекеттігі
Dialogue: 0,1:25:21.90,1:25:24.45,Default,,0,0,0,,Әлем – біртұтас тіршілік иесі
Dialogue: 0,1:25:24.82,1:25:27.16,Default,,0,0,0,,Теңіз орналасқан жұлдыз – жатыр
Dialogue: 0,1:25:27.66,1:25:29.37,Default,,0,0,0,,Метеорит – сперматозоид
Dialogue: 0,1:25:29.49,1:25:31.16,Default,,0,0,0,,Ұрықтану фестивалі
Dialogue: 0,1:25:31.33,1:25:36.00,Default,,0,0,0,,Оны көргендер оқиғаны өлеңмен жеткізген.
Dialogue: 0,1:25:36.50,1:25:41.17,Default,,0,0,0,,«Жұлдыздар теңізі – туған жер».
Dialogue: 0,1:25:42.17,1:25:44.18,Default,,0,0,0,,Әннің жалғасын тыңдауға болады
Dialogue: 0,1:25:44.26,1:25:47.85,Default,,0,0,0,,«Халық – кеуде, аспан – ойын алаңы»
Dialogue: 0,1:25:48.51,1:25:51.89,Default,,0,0,0,,Нағыз фестиваль басталады!
Dialogue: 0,1:25:54.35,1:25:55.19,Default,,0,0,0,,Мен оны көргім келеді!
Dialogue: 0,1:26:33.10,1:26:34.10,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:27:21.98,1:27:24.53,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,1:28:09.49,1:28:10.74,Default,,0,0,0,,Мен оларды көріп тұрмын
Dialogue: 0,1:28:10.82,1:28:12.49,Default,,0,0,0,,Мен ғаламмын ба?
Dialogue: 0,1:28:53.28,1:28:56.54,Default,,0,0,0,,♪ Сәлем!
Dialogue: 0,1:28:56.66,1:28:57.79,Default,,0,0,0,,Бұл бесік жыры...
Dialogue: 0,1:28:57.91,1:29:00.41,Default,,0,0,0,,♪ Обероньо
Dialogue: 0,1:29:00.54,1:29:01.37,Default,,0,0,0,,Ана әні...
Dialogue: 0,1:29:01.54,1:29:07.84,Default,,0,0,0,,♪ Теңізде туған балық
Dialogue: 0,1:29:07.92,1:29:09.59,Default,,0,0,0,,Менің анам...
Dialogue: 0,1:29:11.05,1:29:13.34,Default,,0,0,0,,Менің ішімде
Dialogue: 0,1:29:31.24,1:29:32.49,Default,,0,0,0,,Уми-кун?
Dialogue: 0,1:29:34.57,1:29:35.82,Default,,0,0,0,,Уми-кун!
Dialogue: 0,1:29:58.76,1:30:00.22,Default,,0,0,0,,Уми-кун
Dialogue: 0,1:30:13.40,1:30:14.49,Default,,0,0,0,,Уф...
Dialogue: 0,1:30:27.04,1:30:28.29,Default,,0,0,0,,Уми-кун
Dialogue: 0,1:30:30.96,1:30:32.17,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:30:36.64,1:30:37.64,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:30:39.89,1:30:41.35,Default,,0,0,0,,Уми-кун
Dialogue: 0,1:31:36.61,1:31:39.66,Default,,0,0,0,,Ол жарқырайды, өйткені мен оны тапқым келеді.
Dialogue: 0,1:31:40.53,1:31:43.33,Default,,0,0,0,,Бұл Умикунның жарығы
Dialogue: 0,1:31:43.45,1:31:48.62,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,1:32:15.03,1:32:18.90,Default,,0,0,0,,(бала күлкі)
Dialogue: 0,1:33:36.90,1:33:38.44,Default,,0,0,0,,Уми-кун!
Dialogue: 0,1:33:40.11,1:33:41.49,Default,,0,0,0,,Уми-кун?
Dialogue: 0,1:33:46.62,1:33:50.50,Default,,0,0,0,,Иә? Уми-кун, сен қайдасың?
Dialogue: 0,1:33:51.00,1:33:57.00,Default,,0,0,0,,♪ («Туған күніңмен құттықтаймын» музыкалық қорапшасы)
Dialogue: 0,1:34:17.69,1:34:19.52,Default,,0,0,0,,Жақсы нәрселер Жаман нәрселер...
Dialogue: 0,1:34:20.82,1:34:24.20,Default,,0,0,0,,Екеуі тепе-теңдікте болғанда дүние сақталады.
Dialogue: 0,1:34:25.16,1:34:28.28,Default,,0,0,0,,Бір нәрсені екі жағынан көру
Dialogue: 0,1:34:28.87,1:34:32.29,Default,,0,0,0,,Теңіз бен құрлықтағы тіршілік иелерінің айырмашылығы сияқты.
Dialogue: 0,1:34:33.75,1:34:36.08,Default,,0,0,0,,Жоқ, бұл дұрыс емес...
Dialogue: 0,1:34:38.21,1:34:41.00,Default,,0,0,0,,Өйткені барлық тірі заттар бір шикізаттан жасалған
Dialogue: 0,1:34:42.01,1:34:44.80,Default,,0,0,0,,Және ол ғарыштан келеді.
Dialogue: 0,1:34:44.88,1:34:47.34,Default,,0,0,0,,Бұл дүниеде бәрі бір заттан жасалған
Dialogue: 0,1:34:50.05,1:34:52.10,Default,,0,0,0,,Әлем мен адамдар ұқсас
Dialogue: 0,1:34:53.64,1:34:56.64,Default,,0,0,0,,Егер бәрі бір нәрсенің бөлігі болса
Dialogue: 0,1:34:56.73,1:34:59.61,Default,,0,0,0,,«ұқсас» емес, «бірдей»
Dialogue: 0,1:35:00.73,1:35:03.36,Default,,0,0,0,,Күн, теңіз және адамдар
Dialogue: 0,1:35:04.90,1:35:07.07,Default,,0,0,0,,Аспан, теңіз және мен
Dialogue: 0,1:35:07.99,1:35:10.41,Default,,0,0,0,,Және басқа кез келген адаммен
Dialogue: 0,1:35:15.16,1:35:17.46,Default,,0,0,0,,Егер сіз ғарышқа шықсаңыз, мен сенімдімін
Dialogue: 0,1:35:17.58,1:35:19.79,Default,,0,0,0,,Менің ойымша, бұл теңізге ұқсайды.
Dialogue: 0,1:35:21.00,1:35:22.71,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:35:25.92,1:35:27.26,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:35:31.60,1:35:32.43,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:35:36.18,1:35:37.56,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:35:40.81,1:35:42.11,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:35:44.69,1:35:45.94,Default,,0,0,0,,Уми-кун!
Dialogue: 0,1:35:46.95,1:35:48.45,Default,,0,0,0,,Кира өте икемсіз ғой, иә?
Dialogue: 0,1:35:51.45,1:35:56.04,Default,,0,0,0,,Сіз жай ғана «қош болыңыз» дедіңіз бе?
Dialogue: 0,1:36:11.47,1:36:12.89,Default,,0,0,0,,Уми-кун!
Dialogue: 0,1:36:15.43,1:36:17.10,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:36:24.82,1:36:26.07,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,1:36:28.82,1:36:30.36,Default,,0,0,0,,Уми-кун!
Dialogue: 0,1:36:34.28,1:36:36.16,Default,,0,0,0,,Уми-кун!
Dialogue: 0,1:36:38.00,1:36:39.50,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:36:51.84,1:36:53.22,Default,,0,0,0,,Мен де...
Dialogue: 0,1:37:00.69,1:37:01.85,Default,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,1:37:06.52,1:37:08.03,Default,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,1:37:13.36,1:37:14.70,Default,,0,0,0,,Бірге!
Dialogue: 0,1:38:25.31,1:38:29.65,Default,,0,0,0,,(Рюканың ауыр тыныс алуы)
Dialogue: 0,1:39:00.39,1:39:02.72,Default,,0,0,0,,Рюка! Рюка! (Масааки) Рюка!
Dialogue: 0,1:39:03.64,1:39:04.81,Default,,0,0,0,,Рюка, мықты бол!
Dialogue: 0,1:39:06.14,1:39:07.27,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:39:11.65,1:39:12.48,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:39:13.48,1:39:16.15,Default,,0,0,0,,Рюка… Рюка…
Dialogue: 0,1:39:55.32,1:39:57.07,Default,,0,0,0,,Сәлем! (Балықшы Б) Айо
Dialogue: 0,1:39:57.20,1:39:58.40,Default,,0,0,0,,Жақсы
Dialogue: 0,1:40:32.69,1:40:57.26,Default,,0,0,0,,(Муккури орындау)
Dialogue: 0,1:40:59.42,1:41:03.26,Default,,0,0,0,,Мен де сенің жасыңда кездескенбіз.
Dialogue: 0,1:41:05.26,1:41:08.43,Default,,0,0,0,,Теңізден келген сұлу балаға
Dialogue: 0,1:41:11.02,1:41:14.86,Default,,0,0,0,,...
Dialogue: 0,1:41:14.98,1:41:17.19,Default,,0,0,0,,Тыныш сөйлеңіз
Dialogue: 0,1:41:20.28,1:41:24.16,Default,,0,0,0,,...
Dialogue: 0,1:41:24.28,1:41:26.45,Default,,0,0,0,,Сол өмірдің себебі
Dialogue: 0,1:41:33.00,1:41:34.96,Default,,0,0,0,,Дүниенің сыры
Dialogue: 0,1:41:35.13,1:41:39.17,Default,,0,0,0,,...
Dialogue: 0,1:41:39.92,1:41:42.13,Default,,0,0,0,,Кит құшақтап алған құдай
Dialogue: 0,1:41:42.30,1:41:44.14,Default,,0,0,0,,Уақыт өтіп бара жатқан бала
Dialogue: 0,1:41:45.05,1:41:49.89,Default,,0,0,0,,...
Dialogue: 0,1:41:50.64,1:41:54.56,Default,,0,0,0,,...
Dialogue: 0,1:41:55.15,1:41:58.40,Default,,0,0,0,,Дүние бүркеніп тығылады
Dialogue: 0,1:42:02.82,1:42:04.20,Default,,0,0,0,,Менің...
Dialogue: 0,1:42:06.49,1:42:07.83,Default,,0,0,0,,Әңгіме
Dialogue: 0,1:42:20.55,1:42:21.84,Default,,0,0,0,,Мен...
Dialogue: 0,1:42:24.18,1:42:26.22,Default,,0,0,0,,Мен ештеңе білмеймін
Dialogue: 0,1:42:28.35,1:42:30.39,Default,,0,0,0,,Мен сені қайта көргім келеді
Dialogue: 0,1:42:31.81,1:42:33.60,Default,,0,0,0,,«Неге?»
Dialogue: 0,1:42:36.23,1:42:37.61,Default,,0,0,0,,Мен...
Dialogue: 0,1:42:40.23,1:42:41.69,Default,,0,0,0,,Мен...
Dialogue: 0,1:42:53.87,1:42:56.54,Default,,0,0,0,,Сенде бәрі жақсы.
Dialogue: 0,1:42:57.17,1:42:58.25,Default,,0,0,0,,А...?
Dialogue: 0,1:42:59.84,1:43:03.42,Default,,0,0,0,,Теңізге және аспанға сену
Dialogue: 0,1:43:03.88,1:43:06.22,Default,,0,0,0,,және өзіңіз
Dialogue: 0,1:43:24.53,1:43:27.78,Default,,0,0,0,,(теңіз құстарының айқайы)
Dialogue: 0,1:44:04.90,1:44:07.15,Default,,0,0,0,,(доптың секіру дыбысы)
Dialogue: 0,1:44:22.46,1:44:24.13,Default,,0,0,0,,Аспан да сонда...
Dialogue: 0,1:44:28.47,1:44:30.30,Default,,0,0,0,,Теңіз болды
Dialogue: 0,1:44:35.01,1:44:39.31,Default,,0,0,0,,...
Dialogue: 0,1:44:42.81,1:44:48.82,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:48:27.79,1:48:33.79,Default,,0,0,0,,~♪
Dialogue: 0,1:48:38.30,1:48:42.34,Default,,0,0,0,,(туылу туралы жылау)
Dialogue: 0,1:48:42.51,1:48:45.56,Default,,0,0,0,,(туылу туралы жылау)
Dialogue: 0,1:48:45.68,1:48:47.39,Default,,0,0,0,,Олай болса маған кіндік берші.
Dialogue: 0,1:48:47.52,1:48:49.56,Default,,0,0,0,,Мен сенен оны кесуіңді өтіндім.
Dialogue: 0,1:48:50.85,1:48:52.15,Default,,0,0,0,,Иә?
Dialogue: 0,1:48:53.06,1:48:54.27,Default,,0,0,0,,Иә
Dialogue: 0,1:48:54.44,1:48:58.03,Default,,0,0,0,,(туылу туралы жылау)
Dialogue: 0,1:49:12.25,1:49:13.29,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,1:49:14.25,1:49:17.42,Default,,0,0,0,,Өмірімнің қысқарғанын сезіндім.
Dialogue: 0,1:49:26.60,1:49:28.22,Default,,0,0,0,,Сәлем анашым
Dialogue: 0,1:49:28.85,1:49:30.81,Default,,0,0,0,,Иә? Не?
Dialogue: 0,1:49:31.69,1:49:34.90,Default,,0,0,0,,...
Dialogue: 0,1:49:36.61,1:49:39.61,Default,,0,0,0,,...
Dialogue: 0,1:49:40.07,1:49:42.11,Default,,0,0,0,,Не? Иә
Dialogue: 0,1:49:42.20,1:49:45.28,Default,,0,0,0,,...
Dialogue: 0,1:49:45.45,1:49:47.62,Default,,0,0,0,,Мен кішкентай кезімде
Dialogue: 0,1:49:48.20,1:49:50.12,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,1:49:58.30,1:49:59.80,Default,,0,0,0,,Ештеңе
Dialogue: 0,1:50:02.80,1:50:05.89,Default,,0,0,0,,♪ Сәлем!
Dialogue: 0,1:50:06.01,1:50:09.01,Default,,0,0,0,,♪ Обероньо
Dialogue: 0,1:50:09.14,1:50:15.19,Default,,0,0,0,,♪ Тіпті теңізде туған балық
Dialogue: 0,1:50:15.35,1:50:21.32,Default,,0,0,0,,♪ Кеуде және аяқ.
Dialogue: 0,1:50:21.44,1:50:27.57,Default,,0,0,0,,♪ Аспанға жеткіз, жұлдызды аң аулау
Dialogue: 0,1:50:27.70,1:50:33.87,Default,,0,0,0,,♪ Аңдаған жұлдыз теңізге түседі
Dialogue: 0,1:50:40.17,1:50:42.80,Default,,0,0,0,,Әрқашан денеңіздің ең терең жерінде
Dialogue: 0,1:50:43.17,1:50:44.59,Default,,0,0,0,,Дұрыс қосылған
Dialogue: 0,1:50:50.68,1:50:52.85,Default,,0,0,0,,Ең маңызды уәде –
Dialogue: 0,1:50:53.68,1:50:55.52,Default,,0,0,0,,Сөзбен алмастырылмайды
Dialogue: 0,1:50:57.02,1:51:03.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory