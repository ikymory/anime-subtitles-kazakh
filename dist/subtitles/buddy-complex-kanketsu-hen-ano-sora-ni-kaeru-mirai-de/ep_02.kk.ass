Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.95,0:00:12.20,Default,,0,0,0,,бастайық
Dialogue: 0,0:00:12.83,0:00:16.04,Default,,0,0,0,,Осы сәтті 70 жыл күттім.
Dialogue: 0,0:00:17.29,0:00:22.00,Default,,0,0,0,,Мен сені жаншып тұрған сәт! Аоба Ватасе!
Dialogue: 0,0:00:22.29,0:00:22.83,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:26.16,0:00:27.70,Default,,0,0,0,,Аоба! ...хмм
Dialogue: 0,0:00:29.70,0:00:32.29,Default,,0,0,0,,Мен бұл сатқынды таптым!
Dialogue: 0,0:00:32.41,0:00:33.66,Default,,0,0,0,,Күте тұрыңыз, Талзим!
Dialogue: 0,0:00:34.50,0:00:35.95,Default,,0,0,0,,Өл!
Dialogue: 0,0:00:40.08,0:00:40.95,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:00:41.70,0:00:42.41,Default,,0,0,0,,Жүр!
Dialogue: 0,0:00:42.50,0:00:42.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:43.00,0:00:43.83,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:00:43.91,0:00:44.70,Default,,0,0,0,,Кук
Dialogue: 0,0:00:54.16,0:00:56.25,Default,,0,0,0,,Қарғыс атқыр, қандай жылдамдық...
Dialogue: 0,0:00:56.45,0:01:01.08,Default,,0,0,0,,Тіпті сен де Сен келмесең, мен барамын!
Dialogue: 0,0:01:04.08,0:01:05.83,Default,,0,0,0,,Онда жоқ! ?
Dialogue: 0,0:01:07.54,0:01:08.25,Default,,0,0,0,,Уау...
Dialogue: 0,0:01:09.45,0:01:12.08,Default,,0,0,0,,Бір кесек етке айналып өл!
Dialogue: 0,0:01:19.00,0:01:20.87,Default,,0,0,0,,Қанаттарыңды атыңдар
Dialogue: 0,0:01:20.95,0:01:25.45,Default,,0,0,0,,Көрінбейтін аспанда үйілген үміт
Dialogue: 0,0:01:25.70,0:01:28.83,Default,,0,0,0,,Мұңның салмағына берілме
Dialogue: 0,0:01:28.91,0:01:34.00,Default,,0,0,0,,мәңгі жаңғырық UNISONIA
Dialogue: 0,0:01:39.20,0:01:42.79,Default,,0,0,0,,Сіз көріп отырған дүние
Dialogue: 0,0:01:43.70,0:01:48.95,Default,,0,0,0,,Қызық, ол қандай түсті?
Dialogue: 0,0:01:49.12,0:01:50.66,Default,,0,0,0,,＜Сезім сәйкестігін өлшеу＞
Dialogue: 0,0:01:51.33,0:01:53.54,Default,,0,0,0,,Жоғалту қандай азап
Dialogue: 0,0:01:54.37,0:01:56.33,Default,,0,0,0,,Менің үйренгім келмейді
Dialogue: 0,0:01:56.62,0:02:01.04,Default,,0,0,0,,Жұлдыздар осындай түнде де әдемі
Dialogue: 0,0:02:02.75,0:02:05.66,Default,,0,0,0,,Алақаннан құлау
Dialogue: 0,0:02:05.75,0:02:08.37,Default,,0,0,0,,Тот басқан тиын сияқты
Dialogue: 0,0:02:08.70,0:02:11.58,Default,,0,0,0,,<Модренаи> <Каеритай>
Dialogue: 0,0:02:11.70,0:02:14.95,Default,,0,0,0,,Екі адам бір-бірінен кейін
Dialogue: 0,0:02:15.20,0:02:17.00,Default,,0,0,0,,Пирс
Dialogue: 0,0:02:17.12,0:02:21.75,Default,,0,0,0,,Біздің өшпейтін сезімдерімізді байланысқа айналдырыңыз
Dialogue: 0,0:02:21.87,0:02:25.04,Default,,0,0,0,,Түссіз дүниені қайта салғандай
Dialogue: 0,0:02:25.12,0:02:27.62,Default,,0,0,0,,Осы жанашырлықты жеткізіңіз
Dialogue: 0,0:02:27.79,0:02:29.08,Default,,0,0,0,,Қанатты өсіру
Dialogue: 0,0:02:29.29,0:02:34.04,Default,,0,0,0,,Өзіңіз қалаған болашақты жасаңыз
Dialogue: 0,0:02:34.20,0:02:37.08,Default,,0,0,0,,Тіпті тағдырды өзгертуге болады
Dialogue: 0,0:02:37.29,0:02:42.29,Default,,0,0,0,,Уақыттан тыс UNISONIA
Dialogue: 0,0:02:48.08,0:02:50.50,Default,,0,0,0,,Хехехе... Иә! ?
Dialogue: 0,0:02:55.79,0:02:58.54,Default,,0,0,0,,Бұл... Чокомакато...
Dialogue: 0,0:02:58.79,0:03:03.70,Default,,0,0,0,,Бұл қандай ұшақ? ? Бір ғана машина ілінісу машинасымен бірдей өнімділікке ие...
Dialogue: 0,0:03:04.12,0:03:05.79,Default,,0,0,0,,Бұл біріктіру машинасы емес пе?
Dialogue: 0,0:03:05.95,0:03:10.41,Default,,0,0,0,,Мүмкін емес. Дос машинасы болмаса... Мүмкін...
Dialogue: 0,0:03:11.12,0:03:12.62,Default,,0,0,0,,Жоқ, бұл дұрыс емес…
Dialogue: 0,0:03:12.91,0:03:18.58,Default,,0,0,0,,Бірақ бұл сондай-ақ шудың жүйеге араласып, мәжбүрлі ажырату себебін түсіндіреді...
Dialogue: 0,0:03:19.83,0:03:21.41,Default,,0,0,0,,Сіз бірдеңені түсінген сияқтысыз ба?
Dialogue: 0,0:03:21.62,0:03:23.12,Default,,0,0,0,,Ешқандай сенімділік болмаса да
Dialogue: 0,0:03:23.37,0:03:25.00,Default,,0,0,0,,Тек жасап көріңіз.
Dialogue: 0,0:03:25.16,0:03:30.25,Default,,0,0,0,,Егер біз ілінісу машинасын бәрібір пайдалана алмасақ, жеңу мүмкіндігіміз жоқ.
Dialogue: 0,0:03:30.45,0:03:33.20,Default,,0,0,0,,Жарайды, Маю, маған көмектес.
Dialogue: 0,0:03:33.41,0:03:34.20,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:03:40.54,0:03:43.95,Default,,0,0,0,,Сіздің шыққаныңыз жақсы болды! Бизонның жауы!
Dialogue: 0,0:03:44.16,0:03:44.66,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:03:44.95,0:03:47.45,Default,,0,0,0,,Күте тұрыңыз, Талзим! Хинаның әңгімесін тыңдайық!
Dialogue: 0,0:03:47.75,0:03:49.29,Default,,0,0,0,,Шулы!
Dialogue: 0,0:03:51.00,0:03:52.37,Default,,0,0,0,,Гү…
Dialogue: 0,0:03:58.50,0:03:59.87,Default,,0,0,0,,Қарғыс атсын, соқпайды!
Dialogue: 0,0:04:02.87,0:04:03.29,Default,,0,0,0,,Ішек
Dialogue: 0,0:04:05.08,0:04:05.79,Default,,0,0,0,,Аоба!
Dialogue: 0,0:04:06.16,0:04:06.83,Default,,0,0,0,,Цк
Dialogue: 0,0:04:07.37,0:04:08.83,Default,,0,0,0,,Дио муфтасы!
Dialogue: 0,0:04:09.08,0:04:09.58,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:04:09.83,0:04:11.70,Default,,0,0,0,,Бұл онымен күресудің жалғыз жолы!
Dialogue: 0,0:04:12.08,0:04:14.70,Default,,0,0,0,,Алайда кептеліс болған кезде Эльвира...
Dialogue: 0,0:04:14.79,0:04:17.37,Default,,0,0,0,,Егер сіз оны қолданып көрмесеңіз, мүмкін емес екенін білмейсіз!
Dialogue: 0,0:04:18.12,0:04:18.87,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:19.04,0:04:21.37,Default,,0,0,0,,Кеттік! Байланыс Дио!
Dialogue: 0,0:04:21.45,0:04:22.37,Default,,0,0,0,,Қабылдау!
Dialogue: 0,0:04:23.45,0:04:24.12,Default,,0,0,0,,Хун
Dialogue: 0,0:04:29.87,0:04:30.45,Default,,0,0,0,,Гах...
Dialogue: 0,0:04:31.12,0:04:31.83,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:32.08,0:04:35.41,Default,,0,0,0,,Түсінбейсің бе бұл босқа! Ақымақ!
Dialogue: 0,0:04:38.20,0:04:40.50,Default,,0,0,0,,Не! ? Гррр...
Dialogue: 0,0:04:42.37,0:04:44.12,Default,,0,0,0,,Не! ? Кенет қозғалыс бар ...
Dialogue: 0,0:04:44.41,0:04:46.50,Default,,0,0,0,,Мен түсінбеймін! Бірақ бұл мүмкіндік!
Dialogue: 0,0:04:47.29,0:04:48.62,Default,,0,0,0,,Не болып жатыр! ?
Dialogue: 0,0:04:48.75,0:04:52.54,Default,,0,0,0,,Аа, уақыт шегі жеткен сияқты.
Dialogue: 0,0:04:52.62,0:04:56.37,Default,,0,0,0,,Дереу қайта іске қосыңыз! Уақыт шектеулерін қоймаңыз!
Dialogue: 0,0:04:56.50,0:04:59.37,Default,,0,0,0,,Бірақ мұны жасамасаңыз, сіздің миыңызға әсері...
Dialogue: 0,0:04:59.41,0:05:01.12,Default,,0,0,0,,Ақтау жоқ!
Dialogue: 0,0:05:01.66,0:05:02.87,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:05:03.04,0:05:05.62,Default,,0,0,0,,Сіз мүлде түсінбейсіз.
Dialogue: 0,0:05:05.95,0:05:12.20,Default,,0,0,0,,Жүйе жоғары деңгейлі болса да, бөлшектер екінші дәрежелі болса, ол өзінің толық әлеуетінде жұмыс істемейді.
Dialogue: 0,0:05:12.66,0:05:15.12,Default,,0,0,0,,Ұшқыш деп аталатын бөлік бар.
Dialogue: 0,0:05:20.95,0:05:23.04,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:05:23.37,0:05:26.79,Default,,0,0,0,,Кеттік, Аоба Ватасе!
Dialogue: 0,0:05:28.66,0:05:29.91,Default,,0,0,0,,Тағы да сұмдық!
Dialogue: 0,0:05:29.95,0:05:30.75,Default,,0,0,0,,Чи…
Dialogue: 0,0:05:31.95,0:05:33.08,Default,,0,0,0,,Бұл рас па? ол
Dialogue: 0,0:05:33.16,0:05:34.95,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:05:35.08,0:05:37.45,Default,,0,0,0,,Бірақ бұл мүмкін бе?
Dialogue: 0,0:05:37.70,0:05:42.37,Default,,0,0,0,,Ағымдағы кабинаның өзінде жүйені қосу арқылы теориялық тұрғыдан мүмкін.
Dialogue: 0,0:05:42.75,0:05:44.79,Default,,0,0,0,,Тар арқанмен жүргендей...
Dialogue: 0,0:05:45.79,0:05:49.12,Default,,0,0,0,,Бірақ бұл кептелістің неліктен орын алып жатқанын да түсіндіреді.
Dialogue: 0,0:05:49.87,0:05:53.29,Default,,0,0,0,,Мүмкін, мен сізге бұрын көрсеткен жоспарды жүзеге асыра алармыз.
Dialogue: 0,0:05:55.54,0:05:56.45,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:57.16,0:05:57.91,Default,,0,0,0,,Капитан
Dialogue: 0,0:05:58.62,0:06:01.25,Default,,0,0,0,,Жүйені қосу қанша уақытты алады?
Dialogue: 0,0:06:01.29,0:06:02.66,Default,,0,0,0,,Мүмкіндігінше тезірек
Dialogue: 0,0:06:03.04,0:06:03.95,Default,,0,0,0,,Хмм…
Dialogue: 0,0:06:05.58,0:06:09.87,Default,,0,0,0,,Жарайды, менің басқа таңдауым жоқ деп ойлаймын. өтінемін
Dialogue: 0,0:06:10.00,0:06:11.37,Default,,0,0,0,,Иә Маю!
Dialogue: 0,0:06:11.41,0:06:12.33,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:06:13.91,0:06:18.95,Default,,0,0,0,,Мынау... мұндай күрес әділдік деп аталады ма?
Dialogue: 0,0:06:19.45,0:06:20.45,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:21.37,0:06:21.95,Default,,0,0,0,,Подполковник.
Dialogue: 0,0:06:22.29,0:06:22.95,Default,,0,0,0,,Ах! ?
Dialogue: 0,0:06:26.04,0:06:27.79,Default,,0,0,0,,Жүйе құрылысы аяқталды
Dialogue: 0,0:06:28.04,0:06:29.87,Default,,0,0,0,,Уақытты белгілеу осы жерде көрсетілген
Dialogue: 0,0:06:30.00,0:06:31.70,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:06:31.87,0:06:34.79,Default,,0,0,0,,Бұл мүмкін бе? Менен басшының орынбасары да сұрады.
Dialogue: 0,0:06:35.08,0:06:37.20,Default,,0,0,0,,Қараңдаршы, ханшайым келді.
Dialogue: 0,0:06:37.45,0:06:38.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:39.62,0:06:40.33,Default,,0,0,0,,Аоба!
Dialogue: 0,0:06:40.62,0:06:41.54,Default,,0,0,0,,Хина!
Dialogue: 0,0:06:47.00,0:06:51.33,Default,,0,0,0,,Өкініштісі, капитанның нұсқауы сол қызды орындау еді.
Dialogue: 0,0:06:51.45,0:06:54.66,Default,,0,0,0,,Цк, сендер мені үнемі тітіркендірдіңдер!
Dialogue: 0,0:06:54.87,0:06:55.66,Default,,0,0,0,,Жасайық, Дио!
Dialogue: 0,0:06:55.87,0:06:56.66,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:06:57.25,0:07:00.83,Default,,0,0,0,,Ха! Неліктен сіз оны көрмедім деп айтасыз?
Dialogue: 0,0:07:01.12,0:07:02.54,Default,,0,0,0,,Сіз оны білесіз бе?
Dialogue: 0,0:07:03.00,0:07:03.95,Default,,0,0,0,,Шатаспаңыз
Dialogue: 0,0:07:04.08,0:07:04.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:05.83,0:07:08.37,Default,,0,0,0,,Сен сонда қал, Хина!
Dialogue: 0,0:07:08.54,0:07:12.33,Default,,0,0,0,,Мен Аобаны өлтіргеннен кейін, мен сенімен көп көңіл көтеремін!
Dialogue: 0,0:07:13.70,0:07:14.79,Default,,0,0,0,,Теня да батыр ма?
Dialogue: 0,0:07:20.37,0:07:22.25,Default,,0,0,0,,Дербес режимді іске қосу
Dialogue: 0,0:07:22.62,0:07:23.16,Default,,0,0,0,,Қазір!
Dialogue: 0,0:07:23.58,0:07:25.16,Default,,0,0,0,,Жалғаулық люкс!
Dialogue: 0,0:07:31.41,0:07:32.66,Default,,0,0,0,,(ДжоДжо) Сен қалай епті қозғалатыныңды көрсем—
Dialogue: 0,0:07:44.25,0:07:45.16,Default,,0,0,0,,Не! ?
Dialogue: 0,0:07:45.70,0:07:48.83,Default,,0,0,0,,Ілініс машинасының жүйесінде псевдотұлғаны жасаңыз
Dialogue: 0,0:07:49.33,0:07:54.04,Default,,0,0,0,,Онымен виртуалды байланыс жасау арқылы тәуелсіз байланыс мүмкін болады.
Dialogue: 0,0:07:54.45,0:07:57.20,Default,,0,0,0,,Сіз оны қысқа мерзімде тұрғыза алдыңыз! ?
Dialogue: 0,0:07:57.41,0:08:00.70,Default,,0,0,0,,Бұл асығыс жасалған өнім, сондықтан оны пайдаланудың бастапқы тәсілі емес.
Dialogue: 0,0:08:00.75,0:08:05.20,Default,,0,0,0,,Ол ұшқышқа ауыр салмақ түсіреді, сондықтан оны аз уақыт ішінде ғана пайдалануға болады.
Dialogue: 0,0:08:05.87,0:08:07.33,Default,,0,0,0,,Гууууууууууууууууууууууууууууууу...
Dialogue: 0,0:08:08.29,0:08:12.62,Default,,0,0,0,,Қосылу екі ұшқыштың ойлауын үндестіру үшін қолданылады.
Dialogue: 0,0:08:12.91,0:08:17.54,Default,,0,0,0,,1 наносекундқа субатомдық деңгейде болашаққа ой деректерін жіберу
Dialogue: 0,0:08:18.04,0:08:21.79,Default,,0,0,0,,Өйткені жалғыз ілінісу өзімен байланыс сияқты.
Dialogue: 0,0:08:22.33,0:08:23.54,Default,,0,0,0,,Қабылдаудың қажеті жоқ
Dialogue: 0,0:08:24.00,0:08:26.33,Default,,0,0,0,,Қалған жіберу деректері туралы не деуге болады?
Dialogue: 0,0:08:26.66,0:08:29.25,Default,,0,0,0,,Берілген деректерді қабылдау арқылы
Dialogue: 0,0:08:29.75,0:08:31.87,Default,,0,0,0,,Ілініс жүйесіне араласатын шу
Dialogue: 0,0:08:32.58,0:08:34.91,Default,,0,0,0,,Кептеліс деген осы.
Dialogue: 0,0:08:39.58,0:08:44.41,Default,,0,0,0,,Әлі жоқ. Жүйені құрастыру мүмкін болса да, ұшақтың өнімділігі...
Dialogue: 0,0:08:45.95,0:08:49.79,Default,,0,0,0,,Егер бірдей шу шығарылса, кептелуді жоюға болады.
Dialogue: 0,0:08:50.45,0:08:51.04,Default,,0,0,0,,Екеуің де!
Dialogue: 0,0:08:51.29,0:08:51.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:51.95,0:08:52.62,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:52.83,0:08:54.95,Default,,0,0,0,,Дербес режим шығарылды!
Dialogue: 0,0:08:55.62,0:08:56.75,Default,,0,0,0,,Жалғаулық Aoba!
Dialogue: 0,0:08:57.45,0:08:58.58,Default,,0,0,0,,Қабылдау!
Dialogue: 0,0:09:14.54,0:09:16.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:16.54,0:09:18.91,Default,,0,0,0,,Ақымақ! Ақымақ, ақымақ!
Dialogue: 0,0:09:19.16,0:09:22.16,Default,,0,0,0,,Мен Эльвирадан кем емеспін!
Dialogue: 0,0:09:22.58,0:09:25.45,Default,,0,0,0,,Дұрыс, егер менде бөлшектер болса...
Dialogue: 0,0:09:25.79,0:09:28.16,Default,,0,0,0,,Керемет бөліктер бар!
Dialogue: 0,0:09:29.70,0:09:31.29,Default,,0,0,0,,Үш адаммен қосылу?
Dialogue: 0,0:09:31.33,0:09:36.79,Default,,0,0,0,,Иә, Аоба мен Хина Рязаньның «Энфатия» толқын пішіндері дәл солай болды.
Dialogue: 0,0:09:37.37,0:09:42.33,Default,,0,0,0,,Жүйе тұрғысынан бұл жеке тұлға ретінде танылуы мүмкін.
Dialogue: 0,0:09:42.79,0:09:45.75,Default,,0,0,0,,Егер сіз Дионы жұптасаңыз...
Dialogue: 0,0:09:46.00,0:09:47.00,Default,,0,0,0,,Не болады?
Dialogue: 0,0:09:47.95,0:09:50.91,Default,,0,0,0,,Бұл зерттелмеген аумақ. Байқап көрмесең,
Dialogue: 0,0:09:52.58,0:09:54.37,Default,,0,0,0,,ga… ggg…
Dialogue: 0,0:09:54.54,0:09:58.66,Default,,0,0,0,,Ойлау деректері жұтылады...
Dialogue: 0,0:09:58.83,0:10:04.04,Default,,0,0,0,,Тоқта... Тоқта!
Dialogue: 0,0:10:15.95,0:10:17.29,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:20.62,0:10:22.75,Default,,0,0,0,,Балапандар туралы естеліктер...?
Dialogue: 0,0:10:27.37,0:10:33.16,Default,,0,0,0,,Бірінен соң бірі, екіден бірінен соң бірі жоғалады
Dialogue: 0,0:10:33.33,0:10:40.37,Default,,0,0,0,,Өмір оты жанады
Dialogue: 0,0:10:42.37,0:10:44.50,Default,,0,0,0,,Мыңдаған жұлдыздардың ішінде
Dialogue: 0,0:10:44.58,0:10:46.45,Default,,0,0,0,,Мен сізбен кездесе алдым
Dialogue: 0,0:10:46.50,0:10:51.12,Default,,0,0,0,,Бірінші біріктіру тәжірибесінде тек балапандары ұшып кетті...
Dialogue: 0,0:10:51.33,0:10:53.54,Default,,0,0,0,,Мен ұша аламын
Dialogue: 0,0:10:53.79,0:10:55.58,Default,,0,0,0,,Аты жоқ жауынгер
Dialogue: 0,0:10:55.66,0:10:56.91,Default,,0,0,0,,Тұр
Dialogue: 0,0:10:57.04,0:10:59.58,Default,,0,0,0,,Жүрегіңе от жағу
Dialogue: 0,0:11:01.20,0:11:03.37,Default,,0,0,0,,Алдымен Одаққа бардым...
Dialogue: 0,0:11:03.87,0:11:05.95,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:11:06.04,0:11:11.75,Default,,0,0,0,,Екі адам зұлымдыққа айналуы мүмкін
Dialogue: 0,0:11:11.83,0:11:14.45,Default,,0,0,0,,Қанаттар қағу
Dialogue: 0,0:11:14.58,0:11:17.16,Default,,0,0,0,,Егіз құс
Dialogue: 0,0:11:23.87,0:11:25.29,Default,,0,0,0,,Және…
Dialogue: 0,0:11:28.12,0:11:34.04,Default,,0,0,0,,Бос ыдысқа
Dialogue: 0,0:11:34.16,0:11:39.62,Default,,0,0,0,,Жиналатын естеліктер
Dialogue: 0,0:11:40.08,0:11:46.45,Default,,0,0,0,,Болашақтың бағдарлары
Dialogue: 0,0:11:46.87,0:11:48.83,Default,,0,0,0,,Жалғыздық деп аталатын қоңырау үні
Dialogue: 0,0:11:49.12,0:11:51.75,Default,,0,0,0,,Қараңғылыққа шақыру
Dialogue: 0,0:11:52.08,0:11:55.70,Default,,0,0,0,,Бір секундта ойланыңыз
Dialogue: 0,0:11:55.83,0:11:58.33,Default,,0,0,0,,Уақыттың толықтығы
Dialogue: 0,0:11:59.08,0:12:00.87,Default,,0,0,0,,Жылаушы періште
Dialogue: 0,0:12:00.91,0:12:02.16,Default,,0,0,0,,Қалықтау
Dialogue: 0,0:12:02.20,0:12:04.95,Default,,0,0,0,,Өткенді тастаңыз
Dialogue: 0,0:12:05.04,0:12:06.79,Default,,0,0,0,,Реинкарнация аяқталғанға дейін
Dialogue: 0,0:12:06.91,0:12:09.16,Default,,0,0,0,,Мақтанышпен
Dialogue: 0,0:12:09.20,0:12:11.20,Default,,0,0,0,,Аман бол
Dialogue: 0,0:12:11.33,0:12:16.91,Default,,0,0,0,,Дүние саған жау болса да
Dialogue: 0,0:12:17.00,0:12:18.91,Default,,0,0,0,,Тағдыр жазғандай...
Dialogue: 0,0:12:19.54,0:12:21.45,Default,,0,0,0,,Сол циклде...
Dialogue: 0,0:12:47.29,0:12:49.62,Default,,0,0,0,,Бизон... Бұл сен едің.
Dialogue: 0,0:12:49.87,0:12:50.62,Default,,0,0,0,,Хаха...
Dialogue: 0,0:12:50.83,0:12:52.54,Default,,0,0,0,,Оны мінген адам...
Dialogue: 0,0:12:53.20,0:12:55.29,Default,,0,0,0,,Һм? Ә… Не? Неге?
Dialogue: 0,0:12:55.62,0:12:58.29,Default,,0,0,0,,Мен бәріңді өлтіремін!
Dialogue: 0,0:13:00.00,0:13:00.83,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:13:00.95,0:13:04.50,Default,,0,0,0,,Евгений Кедар Соғыс қимылдарын дереу тоқтату
Dialogue: 0,0:13:05.41,0:13:07.75,Default,,0,0,0,,Сізді сатқындық үшін ұстаңыз
Dialogue: 0,0:13:08.04,0:13:09.04,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:13:09.66,0:13:12.58,Default,,0,0,0,,Зорлық-зомбылықпен басып алынған үкіметтің мағынасы жоқ.
Dialogue: 0,0:13:12.95,0:13:17.25,Default,,0,0,0,,Әкімшілік бюроның озбырлығына наразы жолдастар көп болды.
Dialogue: 0,0:13:18.04,0:13:22.91,Default,,0,0,0,,Сіз ғарышта болғаныңызда, мен ойлағаннан да жылдам болды.
Dialogue: 0,0:13:23.41,0:13:26.37,Default,,0,0,0,,Аляска базасындағы атыс тым көп болды.
Dialogue: 0,0:13:26.75,0:13:29.12,Default,,0,0,0,,Бұл залал туралы бейне триггер болды
Dialogue: 0,0:13:30.75,0:13:33.95,Default,,0,0,0,,Сіз өзіңізді тұншықтырып өлтірдіңіз.
Dialogue: 0,0:13:34.66,0:13:37.08,Default,,0,0,0,,Уақытша Жоғарғы Кеңестің бұрынғы төрағасы
Dialogue: 0,0:13:37.12,0:13:37.95,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:38.41,0:13:40.16,Default,,0,0,0,,Бүкіл армияға хабар тарату!
Dialogue: 0,0:13:40.83,0:13:43.41,Default,,0,0,0,,Мүмкін бұл көмектесті ме?
Dialogue: 0,0:13:45.04,0:13:46.25,Default,,0,0,0,,Куку Куку…
Dialogue: 0,0:13:46.50,0:13:51.00,Default,,0,0,0,,Кукукукукуку... Кукукукуку... Хахахахахаха!
Dialogue: 0,0:13:51.12,0:13:57.83,Default,,0,0,0,,Бұған не болды! Мен бұл ұрыс алаңын басқарамын! Бұл менмін!
Dialogue: 0,0:14:04.29,0:14:04.95,Default,,0,0,0,,Әй! ?
Dialogue: 0,0:14:06.83,0:14:09.45,Default,,0,0,0,,Менің кек әлі біткен жоқ!
Dialogue: 0,0:14:09.75,0:14:13.41,Default,,0,0,0,,70 жыл бойымда жүрген кек!
Dialogue: 0,0:14:13.75,0:14:15.12,Default,,0,0,0,,Тоқта, Бизон!
Dialogue: 0,0:14:15.29,0:14:16.20,Default,,0,0,0,,Шулы!
Dialogue: 0,0:14:16.45,0:14:17.16,Default,,0,0,0,,Кяах!
Dialogue: 0,0:14:17.29,0:14:21.45,Default,,0,0,0,,Хахахаха! Мен сені дәл осылай басып тастаймын, Хина!
Dialogue: 0,0:14:22.00,0:14:23.58,Default,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:14:23.66,0:14:27.79,Default,,0,0,0,,Менің астыма жата қалсаңшы!
Dialogue: 0,0:14:27.91,0:14:29.75,Default,,0,0,0,,Аххх! !
Dialogue: 0,0:14:32.75,0:14:33.16,Default,,0,0,0,,Әй! ?
Dialogue: 0,0:14:35.66,0:14:38.50,Default,,0,0,0,,Мен сенің сезіміңді түсінемін...
Dialogue: 0,0:14:39.16,0:14:41.20,Default,,0,0,0,,Мен Хинаға ұзақ қарап тұрдым...
Dialogue: 0,0:14:41.62,0:14:45.66,Default,,0,0,0,,Ууууу Ватасе Аоба!
Dialogue: 0,0:14:54.00,0:14:57.83,Default,,0,0,0,,Бірақ сенің қорғағың келген нәрсе - өз менмендігің мен менмендігің!
Dialogue: 0,0:15:00.83,0:15:04.20,Default,,0,0,0,,Бірақ менде қорғағымыз келетін нәрсе бар!
Dialogue: 0,0:15:08.00,0:15:09.25,Default,,0,0,0,,Жақсысың ба, Хина?
Dialogue: 0,0:15:09.33,0:15:10.16,Default,,0,0,0,,Иә
Dialogue: 0,0:15:10.58,0:15:13.33,Default,,0,0,0,,Ааааааааааааа! !
Dialogue: 0,0:15:15.41,0:15:16.20,Default,,0,0,0,,Бітті
Dialogue: 0,0:15:34.04,0:15:37.33,Default,,0,0,0,,Әй, мен... құрып кетем бе...?
Dialogue: 0,0:15:38.54,0:15:40.16,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:15:45.62,0:15:47.66,Default,,0,0,0,,Қарсыластың шабуыл спутнигіне жоғары энергетикалық реакция!
Dialogue: 0,0:15:47.95,0:15:49.00,Default,,0,0,0,,Әлі де өсуде!
Dialogue: 0,0:15:49.50,0:15:55.62,Default,,0,0,0,,Спутникте сақталған үш жылдық Нектолибиум бірден шығарылды.
Dialogue: 0,0:15:55.70,0:16:00.62,Default,,0,0,0,,Ақымақ! Бұл спутниктің өзі мұндай энергияға төтеп бере алмайды!
Dialogue: 0,0:16:02.91,0:16:03.79,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:04.66,0:16:07.75,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:16:08.04,0:16:12.50,Default,,0,0,0,,Өзіңізді алдамаңыз! Мен мұндай жерде өлуге лайық емеспін!
Dialogue: 0,0:16:12.83,0:16:16.75,Default,,0,0,0,,Менің миым мен зерттеуім осында!
Dialogue: 0,0:16:16.95,0:16:19.33,Default,,0,0,0,,Бұл менің кек алуым
Dialogue: 0,0:16:19.41,0:16:25.41,Default,,0,0,0,,Хахахаха... хахахахаха! Ха!
Dialogue: 0,0:16:28.87,0:16:33.50,Default,,0,0,0,,Спутникті жоя алмасаң бәрібір! Сізге тек от сызығын ауыстыру керек!
Dialogue: 0,0:16:37.79,0:16:38.95,Default,,0,0,0,,Нектар перделері! ?
Dialogue: 0,0:16:39.50,0:16:41.41,Default,,0,0,0,,Қарсыластың шабуыл нысанасы есептелді!
Dialogue: 0,0:16:41.70,0:16:45.08,Default,,0,0,0,,Зогирия Республикасы Құмтор Мұрынтау Одағына мүше мемлекеттер
Dialogue: 0,0:16:45.50,0:16:46.87,Default,,0,0,0,,Калгурли, Австралия!
Dialogue: 0,0:16:47.37,0:16:48.83,Default,,0,0,0,,Үш орын! ?
Dialogue: 0,0:16:49.08,0:16:51.37,Default,,0,0,0,,Бірақ сен өз еліңе не үшін келдің?
Dialogue: 0,0:16:51.58,0:16:55.08,Default,,0,0,0,,Бұлардың барлығы Nectolibium өндіретін әлемдегі жетекші аймақтар.
Dialogue: 0,0:16:55.83,0:16:58.66,Default,,0,0,0,,Бірнеше ондаған жылдарға созылатын жер асты нектоолибийінде.
Dialogue: 0,0:16:59.29,0:17:00.45,Default,,0,0,0,,Алып шырындар зеңбірегі тисе
Dialogue: 0,0:17:01.16,0:17:03.12,Default,,0,0,0,,Үлкен жарылыс тудырыңыз
Dialogue: 0,0:17:03.20,0:17:05.37,Default,,0,0,0,,Бұл орын алса не болады?
Dialogue: 0,0:17:05.79,0:17:10.00,Default,,0,0,0,,Жер жойылатын шығар...
Dialogue: 0,0:17:11.12,0:17:12.04,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:17:12.87,0:17:14.33,Default,,0,0,0,,Мен бұған жол бермеймін!
Dialogue: 0,0:17:14.41,0:17:14.87,Default,,0,0,0,,Әй! ?
Dialogue: 0,0:17:15.00,0:17:16.66,Default,,0,0,0,,Біз сізге тікелей соққы береміз!
Dialogue: 0,0:17:16.87,0:17:18.87,Default,,0,0,0,,Бірақ спутникке дейінгі қашықтық!
Dialogue: 0,0:17:18.95,0:17:21.04,Default,,0,0,0,,Егер сізде ілінісу машинасы болса, оны уақытында жасай аласыз!
Dialogue: 0,0:17:21.16,0:17:21.79,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:17:22.04,0:17:22.91,Default,,0,0,0,,Бірақ олай емес!
Dialogue: 0,0:17:23.45,0:17:26.08,Default,,0,0,0,,Сіз тырыспайынша білмейсіз, солай ма?
Dialogue: 0,0:17:26.20,0:17:28.37,Default,,0,0,0,,Ах! Кеттік, Дио!
Dialogue: 0,0:17:28.83,0:17:29.58,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:30.37,0:17:31.00,Default,,0,0,0,,Аоба! ?
Dialogue: 0,0:17:33.08,0:17:36.29,Default,,0,0,0,,Пайдасы жоқ... Уақытында үлгермеймін.
Dialogue: 0,0:17:48.29,0:17:48.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:49.08,0:17:49.58,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:17:50.08,0:17:50.58,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:51.04,0:17:52.91,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:18:05.12,0:18:06.00,Default,,0,0,0,,Қазір не болып жатыр? ?
Dialogue: 0,0:18:06.25,0:18:09.62,Default,,0,0,0,,Сіз білесіз бе! Ең алдымен мұны тоқтату керек!
Dialogue: 0,0:18:10.04,0:18:11.37,Default,,0,0,0,,Маған бұйрық бермеңіз!
Dialogue: 0,0:18:11.66,0:18:13.45,Default,,0,0,0,,Эльвира мырза, бұл...
Dialogue: 0,0:18:14.54,0:18:18.95,Default,,0,0,0,,Бұл... Аоба және басқалары уақыт арқылы ұшып келеді...! ?
Dialogue: 0,0:18:19.37,0:18:20.37,Default,,0,0,0,,-На! ? -Не айтқың келеді?
Dialogue: 0,0:18:20.54,0:18:24.95,Default,,0,0,0,,Байланыс жүйесі ойларды уақыт кідірісінсіз үндестіреді
Dialogue: 0,0:18:25.20,0:18:29.25,Default,,0,0,0,,Болашаққа 1 наносекундқа сигнал жіберу
Dialogue: 0,0:18:29.95,0:18:35.62,Default,,0,0,0,,Екі адамның ойы қажет болмай, үндессе ше...
Dialogue: 0,0:18:36.20,0:18:39.00,Default,,0,0,0,,Нөл секундтан нөл секундқа дейін сигнал жіберу...
Dialogue: 0,0:18:39.20,0:18:43.79,Default,,0,0,0,,Дегенмен, болашаққа 1 наносекунд жіберу құбылысын толықтыру үшін...
Dialogue: 0,0:18:44.87,0:18:48.33,Default,,0,0,0,,1 наносекунд Қабылдағыш пен қабылдағыш өткенге жіберіледі...! ?
Dialogue: 0,0:18:48.58,0:18:49.95,Default,,0,0,0,,Бұл шынымен де рас па?
Dialogue: 0,0:18:50.04,0:18:53.12,Default,,0,0,0,,Мен түсінбеймін! Бірақ бұл жалғыз жол...
Dialogue: 0,0:18:53.54,0:18:59.08,Default,,0,0,0,,Бұл рас болса да, Аоба және басқалары өткенге 1 наносекундқа оралар еді...
Dialogue: 0,0:18:59.50,0:19:01.54,Default,,0,0,0,,Бұл бір миллион секіру...! ?
Dialogue: 0,0:19:10.83,0:19:12.66,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:19:12.87,0:19:14.87,Default,,0,0,0,,Гррр!
Dialogue: 0,0:19:16.16,0:19:17.83,Default,,0,0,0,,Жол жүру қашықтығы одан әрі кеңейтілді!
Dialogue: 0,0:19:18.75,0:19:19.41,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:20.54,0:19:21.16,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:22.12,0:19:23.66,Default,,0,0,0,,Бар, Аоба!
Dialogue: 0,0:19:25.62,0:19:26.33,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:26.58,0:19:27.66,Default,,0,0,0,,Аоба-сан...!
Dialogue: 0,0:19:27.91,0:19:28.87,Default,,0,0,0,,Дио...!
Dialogue: 0,0:19:35.62,0:19:36.45,Default,,0,0,0,,Аоба...!
Dialogue: 0,0:19:40.33,0:19:43.95,Default,,0,0,0,,Адамдар өмір бойы жүрек тереңдерін өзгелерден жасырып өтеді.
Dialogue: 0,0:19:57.25,0:19:58.08,Default,,0,0,0,,Аоба-сан!
Dialogue: 0,0:20:08.33,0:20:11.16,Default,,0,0,0,,Е7R1 (Echo Seven Romeo One) нүктесінде ерекшелік пайда болады!
Dialogue: 0,0:20:11.62,0:20:13.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:13.95,0:20:14.95,Default,,0,0,0,,Аоба!
Dialogue: 0,0:20:16.16,0:20:16.79,Default,,0,0,0,,Аоба!
Dialogue: 0,0:20:17.79,0:20:18.91,Default,,0,0,0,,Тоқта, Дио!
Dialogue: 0,0:20:19.04,0:20:20.66,Default,,0,0,0,,Сізді де сүйреп апарады!
Dialogue: 0,0:20:20.87,0:20:21.66,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:20:22.08,0:20:25.33,Default,,0,0,0,,Брэдион өзінің шегіне жетті! Қуып кететін болсақ, орындаймыз...!
Dialogue: 0,0:20:25.87,0:20:26.75,Default,,0,0,0,,Жарайды, Фромм.
Dialogue: 0,0:20:27.33,0:20:27.79,Default,,0,0,0,,Хм
Dialogue: 0,0:20:27.95,0:20:28.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:29.95,0:20:33.08,Default,,0,0,0,,Дио Сіз мұны көргендіктен білесіз бе?
Dialogue: 0,0:20:33.70,0:20:36.79,Default,,0,0,0,,Біз бастапқы әлемге ораламыз.
Dialogue: 0,0:20:37.41,0:20:38.29,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:20:38.50,0:20:39.37,Default,,0,0,0,,Ооооооох…!!
Dialogue: 0,0:20:40.12,0:20:43.70,Default,,0,0,0,,Бұл менмін, бұл туралы армандамадым.
Dialogue: 0,0:20:44.66,0:20:48.58,Default,,0,0,0,,Мен 70 жылдан кейін ең жақсы дос бола аламын деп ешқашан ойламадым.
Dialogue: 0,0:20:48.83,0:20:49.50,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:20:50.16,0:20:54.50,Default,,0,0,0,,Баршаңызға ең жақсы тілектерімді айтыңыз. Көмегіңіз үшін рақмет.
Dialogue: 0,0:20:54.70,0:20:57.12,Default,,0,0,0,,Айтқың келсе, өзің айт...!
Dialogue: 0,0:20:57.83,0:21:01.29,Default,,0,0,0,,Бізде онша көп уақыт қалмаған сияқты.
Dialogue: 0,0:21:02.54,0:21:03.79,Default,,0,0,0,,Аоба-сан…
Dialogue: 0,0:21:04.66,0:21:09.91,Default,,0,0,0,,Сіз... кенет пайда болдыңыз... бізді тырнап...
Dialogue: 0,0:21:10.41,0:21:11.79,Default,,0,0,0,,Кенет тағы...!
Dialogue: 0,0:21:12.54,0:21:15.54,Default,,0,0,0,,Кездескенше, Дио
Dialogue: 0,0:21:16.12,0:21:16.95,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:30.08,0:21:33.79,Default,,0,0,0,,Luxion Next және Carla сигналының жоғалуы...
Dialogue: 0,0:21:34.20,0:21:35.54,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:21:37.58,0:21:38.62,Default,,0,0,0,,Гррр…
Dialogue: 0,0:21:48.83,0:21:57.04,Default,,0,0,0,,Жүрекпен шақырып, бір-біріне тартқан арғы жағы
Dialogue: 0,0:21:57.16,0:22:05.62,Default,,0,0,0,,Ауырсынудың себебін қазір ғана ұмытыңыз.
Dialogue: 0,0:22:06.00,0:22:14.62,Default,,0,0,0,,Мен сені білемін, мен сені іздеймін
Dialogue: 0,0:22:14.91,0:22:23.75,Default,,0,0,0,,Тоқтату мүмкін емес жарықтың кейінгі бейнесін ақырын сүйіңіз
Dialogue: 0,0:22:23.79,0:22:32.37,Default,,0,0,0,,Сәл кідіріс үмітке сеп болса
Dialogue: 0,0:22:32.58,0:22:41.50,Default,,0,0,0,,Қанша рет қыдырдым, Жайсаң таңға
Dialogue: 0,0:22:41.58,0:22:50.12,Default,,0,0,0,,Болашақта сол аспанға қайтып оралсам, сені құтқарғым келеді, қорғағым келеді.
Dialogue: 0,0:22:50.29,0:22:57.20,Default,,0,0,0,,Сол арманға жетуге болатын болашақта күту
Dialogue: 0,0:22:57.41,0:23:06.62,Default,,0,0,0,,Мен сенің табатыныңа сенімдімін махаббатқа қол созуыңды қалаймын.
Dialogue: 0,0:23:12.00,0:23:13.08,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:23:13.25,0:23:14.70,Default,,0,0,0,,Хина, сәл күте тұрыңыз.
Dialogue: 0,0:23:14.79,0:23:16.62,Default,,0,0,0,,Бұлай асығудың қажеті жоқ
Dialogue: 0,0:23:17.20,0:23:20.41,Default,,0,0,0,,Өйткені асықпасаң, келесі сабағыңа кешігіп қаласың.
Dialogue: 0,0:23:20.58,0:23:21.75,Default,,0,0,0,,Кя
Dialogue: 0,0:23:21.83,0:23:23.66,Default,,0,0,0,,Аа, кешіріңіз, жақсысыз ба?
Dialogue: 0,0:23:23.75,0:23:25.54,Default,,0,0,0,,Бұл сенікі емес қой…
Dialogue: 0,0:23:27.12,0:23:29.37,Default,,0,0,0,,Біз бір жерде кездестік пе?
Dialogue: 0,0:23:29.41,0:23:31.16,Default,,0,0,0,,Балапандарды жинап жатырсың ба?
Dialogue: 0,0:23:31.20,0:23:32.25,Default,,0,0,0,,Цк, жоқ!
Dialogue: 0,0:23:32.41,0:23:34.37,Default,,0,0,0,,Жоқ, бұл бірінші рет.
Dialogue: 0,0:23:36.25,0:23:38.83,Default,,0,0,0,,Me Aoba Watase Сіз ше?
Dialogue: 0,0:23:39.08,0:23:41.29,Default,,0,0,0,,Ю Юмихара Хина...
Dialogue: 0,0:23:42.79,0:23:48.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory