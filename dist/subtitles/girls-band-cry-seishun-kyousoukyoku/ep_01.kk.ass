Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.05,0:00:16.05,Default,,0,0,0,,[Қала шуы]
Dialogue: 0,0:00:43.41,0:00:46.33,Default,,0,0,0,,♪Ары қарай жүргіңіз келе ме?
Dialogue: 0,0:00:46.46,0:00:49.96,Default,,0,0,0,,♪Бұл шынымен ақ, бұл өте ұзын
Dialogue: 0,0:00:50.13,0:00:55.68,Default,,0,0,0,,♪Котаэ, бәлкім, жай ғана форма болып табылатын қарапайым білім.
Dialogue: 0,0:00:55.80,0:01:00.56,Default,,0,0,0,,♪Саусақ ұшы дірілдеп тұрса да
Dialogue: 0,0:01:00.72,0:01:04.14,Default,,0,0,0,,♪Дұрыс жауап жоқ, жеңіліс жоқ.
Dialogue: 0,0:01:04.27,0:01:06.02,Default,,0,0,0,,♪Менің бүкіл өмірім
Dialogue: 0,0:01:06.31,0:01:10.32,Default,,0,0,0,,♪ [Құлаққаптан музыка ағып жатыр]
Dialogue: 0,0:01:11.11,0:01:14.11,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:01:19.83,0:01:20.99,Default,,0,0,0,,Қыз бала…
Dialogue: 0,0:01:21.24,0:01:23.79,Default,,0,0,0,,Жас ханым Жас ханым
Dialogue: 0,0:01:24.58,0:01:25.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:26.50,0:01:27.33,Default,,0,0,0,,Е...
Dialogue: 0,0:01:27.46,0:01:29.67,Default,,0,0,0,,Сіз ояндыңыз ба? Қазірдің өзінде Токио
Dialogue: 0,0:01:30.46,0:01:31.88,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:34.59,0:01:35.63,Default,,0,0,0,,[Қате дыбыс] (Нина) А...
Dialogue: 0,0:01:36.05,0:01:39.64,Default,,0,0,0,,Маған Шинагавадан түсіп, көк пойызға отыруды бұйырды.
Dialogue: 0,0:01:40.81,0:01:42.52,Default,,0,0,0,,Мен Токиоға келдім
Dialogue: 0,0:01:42.72,0:01:46.73,Default,,0,0,0,,Мм, көк көк...
Dialogue: 0,0:01:47.77,0:01:50.31,Default,,0,0,0,,Ашық көк және индиго түстері бар.
Dialogue: 0,0:01:50.69,0:01:51.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:51.98,0:01:58.78,Default,,0,0,0,,Камата/Каннай ауданы Камата/Каннай ауданы...
Dialogue: 0,0:02:02.08,0:02:05.54,Default,,0,0,0,,Кабаяки бенто котлет сэндвич котлет карри Қалай ше?
Dialogue: 0,0:02:06.50,0:02:08.29,Default,,0,0,0,,Кабаяки котлетінен жасалған сэндвич
Dialogue: 0,0:02:08.42,0:02:11.13,Default,,0,0,0,,Кабаяки котлет сэндвич котлет карри
Dialogue: 0,0:02:11.25,0:02:15.97,Default,,0,0,0,,Кабаяки котлет сэндвич Кабаяки котлет сэндвич Котлет карри...
Dialogue: 0,0:02:16.97,0:02:18.80,Default,,0,0,0,,Вайса
Dialogue: 0,0:02:22.51,0:02:24.31,Default,,0,0,0,,Ал...
Dialogue: 0,0:02:24.52,0:02:27.98,Default,,0,0,0,,Ах Йокогама Йокогама Йокогама...
Dialogue: 0,0:02:29.81,0:02:31.27,Default,,0,0,0,,17 жаста
Dialogue: 0,0:02:31.40,0:02:34.82,Default,,0,0,0,,Наурыз Мен Токиоға келдім
Dialogue: 0,0:02:35.36,0:02:36.82,Default,,0,0,0,,Себебі мен жеңілгім келмейді
Dialogue: 0,0:02:36.94,0:02:38.53,Default,,0,0,0,,Өйткені бұл дұрыс емес...
Dialogue: 0,0:02:40.70,0:02:41.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:44.41,0:02:45.70,Default,,0,0,0,,Мен… мен жай…—
Dialogue: 0,0:02:48.33,0:02:49.25,Default,,0,0,0,,А...
Dialogue: 0,0:02:51.04,0:02:53.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:54.42,0:02:57.30,Default,,0,0,0,,``Бізге енді ештеңе керек емес болашақ'' ♪Ою түні біріктірілді
Dialogue: 0,0:02:57.42,0:03:00.47,Default,,0,0,0,,♪ Үзілген ақиқаттың әрбір бөлігі
Dialogue: 0,0:03:00.59,0:03:03.22,Default,,0,0,0,,♪Тамаша болып қалатын әлсіз естелік
Dialogue: 0,0:03:03.35,0:03:09.85,Default,,0,0,0,,♪Төре, жыртық
Dialogue: 0,0:03:19.24,0:03:20.45,Default,,0,0,0,,♪ Сәйкес бас изеді
Dialogue: 0,0:03:20.57,0:03:22.36,Default,,0,0,0,,♪Ағысқа қарсы шықпа
Dialogue: 0,0:03:22.49,0:03:23.32,Default,,0,0,0,,♪Бұл мөлдір
Dialogue: 0,0:03:23.45,0:03:25.12,Default,,0,0,0,,♪Сол межелі жерге
Dialogue: 0,0:03:25.53,0:03:27.83,Default,,0,0,0,,♪Тұншығып жатыр. Карта еш ойланбастан кішірейіп барады.
Dialogue: 0,0:03:27.95,0:03:29.25,Default,,0,0,0,,♪Бәрі де қашып құтыла алмаймын
Dialogue: 0,0:03:29.37,0:03:31.29,Default,,0,0,0,,♪Мен жай ғана төмен қарадым.
Dialogue: 0,0:03:31.79,0:03:33.96,Default,,0,0,0,,♪Мен үнемі өтірік айтамын
Dialogue: 0,0:03:34.08,0:03:37.05,Default,,0,0,0,,♪ Еріндері қатып қалған айқай
Dialogue: 0,0:03:37.17,0:03:40.17,Default,,0,0,0,,♪Міне, мен армандаған шығармын.
Dialogue: 0,0:03:40.47,0:03:43.22,Default,,0,0,0,,♪Бөлінген жер
Dialogue: 0,0:03:43.34,0:03:46.39,Default,,0,0,0,,♪Сол анық жер
Dialogue: 0,0:03:48.06,0:03:49.64,Default,,0,0,0,,♪Маған енді ештеңе керек емес
Dialogue: 0,0:03:49.77,0:03:51.19,Default,,0,0,0,,♪Әдемі заттар, алды-арты
Dialogue: 0,0:03:51.31,0:03:53.94,Default,,0,0,0,,♪Шынайы болашақты іздейік
Dialogue: 0,0:03:54.19,0:03:56.94,Default,,0,0,0,,♪Ой, одан да уды түкір.
Dialogue: 0,0:03:57.07,0:04:00.32,Default,,0,0,0,,♪Айуандық нонсенс
Dialogue: 0,0:04:00.44,0:04:01.82,Default,,0,0,0,,♪Көк дерті кеудеме ұялады
Dialogue: 0,0:04:01.95,0:04:03.45,Default,,0,0,0,,♪Оны мұқият алыңыз
Dialogue: 0,0:04:03.57,0:04:06.12,Default,,0,0,0,,♪Нағыз мен осында
Dialogue: 0,0:04:06.24,0:04:09.16,Default,,0,0,0,,♪Мені кешірмейтініне сенімдімін
Dialogue: 0,0:04:09.29,0:04:12.79,Default,,0,0,0,,♪Сөйтсе де, қазіргі заман фантастика емес
Dialogue: 0,0:04:12.92,0:04:15.88,Default,,0,0,0,,♪Мен нені жоғалттым, Не таптым
Dialogue: 0,0:04:16.00,0:04:18.05,Default,,0,0,0,,♪Кір қолдарыңызбен жайыңыз
Dialogue: 0,0:04:18.17,0:04:21.84,Default,,0,0,0,,♪Иә, көрсеткі осында.
Dialogue: 0,0:04:24.76,0:04:27.76,Default,,0,0,0,,～♪
Dialogue: 0,0:04:28.51,0:04:29.85,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:30.22,0:04:32.14,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:32.64,0:04:35.10,Default,,0,0,0,,Бұл кілтті алуға келген Исери.
Dialogue: 0,0:04:36.02,0:04:36.90,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:04:37.02,0:04:39.19,Default,,0,0,0,,Бұл жоспарланғаннан әлдеқайда кеш болды.
Dialogue: 0,0:04:39.32,0:04:40.73,Default,,0,0,0,,[Смартфон қуаты басылып жатқан дыбыс] (Нина) Жоқ...
Dialogue: 0,0:04:44.95,0:04:46.32,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:49.74,0:04:51.04,Default,,0,0,0,,[Ит үреді] (Нина) Уау!
Dialogue: 0,0:04:51.16,0:04:52.37,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:04:52.50,0:04:54.12,Default,,0,0,0,,[Сыртылып жатқан чемодан дыбысы] (Тұрғын) Қандай тітіркендіргіш!
Dialogue: 0,0:04:54.25,0:04:55.79,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:05:00.67,0:05:01.51,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:05:01.84,0:05:03.72,Default,,0,0,0,,[Есікті ашуға тырысқан дыбыс]
Dialogue: 0,0:05:03.84,0:05:07.18,Default,,0,0,0,,Ха... Солай деп ойлаймын.
Dialogue: 0,0:05:07.55,0:05:08.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:10.76,0:05:12.18,Default,,0,0,0,,[Есіктің ашылған дыбысы]
Dialogue: 0,0:05:12.60,0:05:16.27,Default,,0,0,0,,Мен бұл жерде осындай нәрселер бар екеніне сенімдімін...
Dialogue: 0,0:05:16.77,0:05:17.69,Default,,0,0,0,,Ондай емес пе...
Dialogue: 0,0:05:17.81,0:05:18.65,Default,,0,0,0,,Ум...
Dialogue: 0,0:05:18.77,0:05:20.15,Default,,0,0,0,,Сәлем! Бұл ...
Dialogue: 0,0:05:21.32,0:05:24.11,Default,,0,0,0,,Бұл көрші үйдегі адам. Бұл не?
Dialogue: 0,0:05:24.28,0:05:25.95,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,0:05:26.07,0:05:29.41,Default,,0,0,0,,Ерм... бұл Исери, мұнда көшуге бел буған.
Dialogue: 0,0:05:29.53,0:05:31.91,Default,,0,0,0,,Солай ма? Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:05:32.08,0:05:33.41,Default,,0,0,0,,Иә
Dialogue: 0,0:05:33.70,0:05:35.54,Default,,0,0,0,,Менде кілт жоқ...
Dialogue: 0,0:05:35.91,0:05:38.88,Default,,0,0,0,,Мен оны бүгін жылжымайтын мүлік агентінен алуды жоспарладым.
Dialogue: 0,0:05:39.00,0:05:40.38,Default,,0,0,0,,Мен кешігіп қалдым...
Dialogue: 0,0:05:40.50,0:05:41.55,Default,,0,0,0,,Сіз телефон соқтыңыз ба?
Dialogue: 0,0:05:42.63,0:05:44.72,Default,,0,0,0,,Смартфон батареясы...
Dialogue: 0,0:05:44.84,0:05:45.72,Default,,0,0,0,,Сіз оны пайдаланасыз ба?
Dialogue: 0,0:05:45.84,0:05:49.01,Default,,0,0,0,,Әй... Смартфоныма телефон нөмірімді де қойдым.
Dialogue: 0,0:05:49.26,0:05:50.26,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:50.39,0:05:52.26,Default,,0,0,0,,Сонда оны үйде зарядтау керек пе?
Dialogue: 0,0:05:53.31,0:05:55.77,Default,,0,0,0,,Өтінемін! Ұялудың қажеті жоқ
Dialogue: 0,0:05:58.56,0:06:01.86,Default,,0,0,0,,А, жоқ, бұл жақсы. Менің ойымша, біз қандай да бір жолмен жеңеміз.
Dialogue: 0,0:06:01.98,0:06:03.48,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:03.98,0:06:07.28,Default,,0,0,0,,Кешіріңіз, менің жүгімді қалдырыңызшы.
Dialogue: 0,0:06:10.99,0:06:11.91,Default,,0,0,0,,О, міне!
Dialogue: 0,0:06:13.16,0:06:14.16,Default,,0,0,0,,Мұндай емес қой. (Миямура) Шынымен бе?
Dialogue: 0,0:06:14.41,0:06:16.54,Default,,0,0,0,,[Мазасыз әннің рингтоны]
Dialogue: 0,0:06:17.58,0:06:18.42,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:18.71,0:06:20.17,Default,,0,0,0,,Ах, ақыры шықты.
Dialogue: 0,0:06:20.29,0:06:22.67,Default,,0,0,0,,Анашым! Нина шықты
Dialogue: 0,0:06:22.84,0:06:25.13,Default,,0,0,0,,Кешіріңіз, батарея заряды бітті.
Dialogue: 0,0:06:25.46,0:06:29.22,Default,,0,0,0,,Сіз не істемексіз? Ағай, сіз мені шақырдыңыз.
Dialogue: 0,0:06:29.34,0:06:31.18,Default,,0,0,0,,Қанша уақыт өтсе де, келіңіз
Dialogue: 0,0:06:32.05,0:06:33.18,Default,,0,0,0,,Вакатту
Dialogue: 0,0:06:33.76,0:06:35.18,Default,,0,0,0,,Мен ертең барамын
Dialogue: 0,0:06:35.31,0:06:36.73,Default,,0,0,0,,Шуды жай қалдырыңыз
Dialogue: 0,0:06:36.85,0:06:37.68,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:06:37.98,0:06:40.94,Default,,0,0,0,,Сіз шынымен осылай істей аламын деп ойлайсыз ба?
Dialogue: 0,0:06:41.06,0:06:43.19,Default,,0,0,0,,Кешіріңіз, менде батареялар жоқ.
Dialogue: 0,0:06:44.69,0:06:45.73,Default,,0,0,0,,Я...
Dialogue: 0,0:06:46.40,0:06:47.99,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:07:00.08,0:07:01.92,Default,,0,0,0,,Иә, дәл жақын жерде.
Dialogue: 0,0:07:02.79,0:07:04.00,Default,,0,0,0,,22 сағат...
Dialogue: 0,0:07:05.96,0:07:06.84,Default,,0,0,0,,Өтірік!?
Dialogue: 0,0:07:07.76,0:07:09.84,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:07:16.31,0:07:19.31,Default,,0,0,0,,[Гитара орындауы] ♪～
Dialogue: 0,0:07:29.78,0:07:33.20,Default,,0,0,0,,``Бос жәшік'' ♪Бұл өте ақ және өте ұзын.
Dialogue: 0,0:07:33.37,0:07:38.79,Default,,0,0,0,,♪Котаэ негізінен форма деген түсінік бар.
Dialogue: 0,0:07:39.29,0:07:44.13,Default,,0,0,0,,♪Саусақ ұшы дірілдеп тұрса да
Dialogue: 0,0:07:44.25,0:07:47.84,Default,,0,0,0,,♪Дұрыс жауап жоқ, жеңіліс жоқ.
Dialogue: 0,0:07:48.01,0:07:49.63,Default,,0,0,0,,♪Менің бүкіл өмірім
Dialogue: 0,0:07:49.76,0:07:53.59,Default,,0,0,0,,♪Бұл менмін, бар болғаны.
Dialogue: 0,0:07:50.80,0:07:53.59,Default,,0,0,0,,Бұл шынымен де болды...
Dialogue: 0,0:07:53.80,0:08:01.10,Default,,0,0,0,,♪Енді бұзатын болсақ та, ертең болмайды
Dialogue: 0,0:08:01.23,0:08:02.64,Default,,0,0,0,,～♪
Dialogue: 0,0:08:02.94,0:08:04.06,Default,,0,0,0,,Ум...
Dialogue: 0,0:08:05.61,0:08:06.94,Default,,0,0,0,,Тору, менімен бірге жүр. (Ишикава) Ээ…
Dialogue: 0,0:08:07.86,0:08:10.61,Default,,0,0,0,,Момока Кавараки, солай ма?
Dialogue: 0,0:08:10.74,0:08:11.57,Default,,0,0,0,,Иә
Dialogue: 0,0:08:12.03,0:08:13.61,Default,,0,0,0,,Мен жанкүйермін
Dialogue: 0,0:08:13.74,0:08:17.08,Default,,0,0,0,,Алмаз шаңынан алынған Момока
Dialogue: 0,0:08:17.74,0:08:18.83,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:08:19.37,0:08:22.96,Default,,0,0,0,,Ум, маған Момоканың әні қатты ұнайды.
Dialogue: 0,0:08:23.08,0:08:25.67,Default,,0,0,0,,Мен бүгін Токиоға ауылдан келдім.
Dialogue: 0,0:08:25.79,0:08:28.09,Default,,0,0,0,,Себебі сол ән мені алға итермеледі.
Dialogue: 0,0:08:28.63,0:08:29.50,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:08:29.76,0:08:32.01,Default,,0,0,0,,Бұл рас, бұл рас.
Dialogue: 0,0:08:32.38,0:08:35.68,Default,,0,0,0,,Мен оны өзім 1000 рет ойнаған шығармын.
Dialogue: 0,0:08:36.22,0:08:40.10,Default,,0,0,0,,Мен SNS-ті тексеріп жатқанымда, бүгін мұнда тікелей эфир бар екенін көрдім.
Dialogue: 0,0:08:40.39,0:08:41.85,Default,,0,0,0,,Бұл тағдыр
Dialogue: 0,0:08:42.39,0:08:44.35,Default,,0,0,0,,Олай болса, маған CD сатып ала аласыз ба?
Dialogue: 0,0:08:44.60,0:08:46.81,Default,,0,0,0,,А... иә, әрине.
Dialogue: 0,0:08:48.11,0:08:49.78,Default,,0,0,0,,1000 иен…
Dialogue: 0,0:08:50.28,0:08:51.11,Default,,0,0,0,,Менің тамырларым жарылып кетеді?
Dialogue: 0,0:08:51.24,0:08:52.32,Default,,0,0,0,,Иә
Dialogue: 0,0:08:52.99,0:08:54.15,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:08:56.07,0:08:57.99,Default,,0,0,0,,Бұл бар болғаны 1000 иен.
Dialogue: 0,0:08:58.28,0:09:00.49,Default,,0,0,0,,Пис... Ахахха
Dialogue: 0,0:09:00.66,0:09:02.04,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:09:02.16,0:09:03.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:03.29,0:09:05.75,Default,,0,0,0,,Мен ұят нәрсе айттым ба?
Dialogue: 0,0:09:05.87,0:09:07.00,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:09:07.38,0:09:08.42,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:08.67,0:09:12.38,Default,,0,0,0,,Мына қыз мені ұнатып қалды деп біраз қуанып қалдым.
Dialogue: 0,0:09:14.80,0:09:16.76,Default,,0,0,0,,Эй (2 адам) Иә?
Dialogue: 0,0:09:18.43,0:09:22.77,Default,,0,0,0,,Бұрын айтқанымдай, біз бұл жерді көптен бері пайдаланып келеміз.
Dialogue: 0,0:09:23.18,0:09:26.06,Default,,0,0,0,,Иә? Содан кейін өз атыңызды жазыңыз.
Dialogue: 0,0:09:26.48,0:09:28.77,Default,,0,0,0,,Мен саған басқа жерде істе дедім.
Dialogue: 0,0:09:28.94,0:09:29.77,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:32.86,0:09:33.69,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:09:33.82,0:09:35.86,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:09:36.15,0:09:37.20,Default,,0,0,0,,Эй!
Dialogue: 0,0:09:39.70,0:09:41.24,Default,,0,0,0,,Бая!
Dialogue: 0,0:09:41.99,0:09:43.33,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:43.45,0:09:44.91,Default,,0,0,0,,Жүгіру! (Нина) Не? Не?
Dialogue: 0,0:09:45.04,0:09:46.79,Default,,0,0,0,,Өлтір!
Dialogue: 0,0:09:49.75,0:09:51.04,Default,,0,0,0,,Барқа!
Dialogue: 0,0:09:51.38,0:09:53.84,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:53.96,0:09:55.76,Default,,0,0,0,,«Рахмет» сөзінің мағынасы
Dialogue: 0,0:09:55.88,0:09:58.51,Default,,0,0,0,,Онда неге сонша ашуландың?
Dialogue: 0,0:10:00.35,0:10:01.31,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:10:02.43,0:10:03.64,Default,,0,0,0,,Бұл Нина.
Dialogue: 0,0:10:04.35,0:10:05.73,Default,,0,0,0,,Нина Исери
Dialogue: 0,0:10:07.23,0:10:09.19,Default,,0,0,0,,Кавасаки Токио емес
Dialogue: 0,0:10:09.31,0:10:12.32,Default,,0,0,0,,Дәлірек айтсақ, Канагава. Йокогамадағы досым.
Dialogue: 0,0:10:12.44,0:10:15.07,Default,,0,0,0,,Өтірік! Тіпті Токионың шетінде...
Dialogue: 0,0:10:15.19,0:10:18.11,Default,,0,0,0,,Мені ағам мен жылжымайтын мүлік агенті алдады.
Dialogue: 0,0:10:18.24,0:10:20.45,Default,,0,0,0,,Қосымша бөлме мені мәжбүр етті.
Dialogue: 0,0:10:20.91,0:10:23.20,Default,,0,0,0,,Сондықтан да жалдау ақысы арзан болды ма?
Dialogue: 0,0:10:23.33,0:10:25.91,Default,,0,0,0,,Маған Кавасаки ұнайды.
Dialogue: 0,0:10:26.04,0:10:29.46,Default,,0,0,0,,Міне, мен де Момокамен осылай таныстым.
Dialogue: 0,0:10:29.58,0:10:33.25,Default,,0,0,0,,I Diamond Dust жергілікті жерде орындауға жоспарланған билеттер.
Dialogue: 0,0:10:33.38,0:10:34.92,Default,,0,0,0,,Менде әрқашан болды
Dialogue: 0,0:10:35.05,0:10:37.38,Default,,0,0,0,,Қаласаңыз, қол қойыңыз.
Dialogue: 0,0:10:37.72,0:10:38.76,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:10:39.01,0:10:40.47,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:10:40.72,0:10:42.47,Default,,0,0,0,,Сиыр етіне арналған ыдыс, стандартты өлшем
Dialogue: 0,0:10:43.72,0:10:44.77,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:44.89,0:10:45.93,Default,,0,0,0,,Гю Дон!
Dialogue: 0,0:10:46.06,0:10:49.60,Default,,0,0,0,,Поо... Бұл сіздің бірінші рет не болды? Сіз қай планетадансыз?
Dialogue: 0,0:10:49.73,0:10:50.77,Default,,0,0,0,,Кумамото
Dialogue: 0,0:10:50.90,0:10:52.52,Default,,0,0,0,,Сиыр етінен жасалған ыдыс тізбегі жоқ па?
Dialogue: 0,0:10:52.65,0:10:53.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:53.73,0:10:58.07,Default,,0,0,0,,Бірақ менің бір ережем бар, мен тамақты үнемі үйде ішемін...
Dialogue: 0,0:10:58.49,0:11:01.11,Default,,0,0,0,,Мүмкін, жас ханым?
Dialogue: 0,0:11:01.32,0:11:03.45,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:11:05.41,0:11:06.24,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:11:06.58,0:11:08.66,Default,,0,0,0,,Не? Бұл не!
Dialogue: 0,0:11:08.79,0:11:11.04,Default,,0,0,0,,Бұл дәмді ме? (Нина) Иә!
Dialogue: 0,0:11:12.58,0:11:14.00,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:11:14.25,0:11:15.25,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:11:15.67,0:11:18.59,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет. Мен екі адамға жететін ақша қалдырамын.
Dialogue: 0,0:11:19.13,0:11:21.26,Default,,0,0,0,,Сізге көп рахмет~ (Нина) Иә?
Dialogue: 0,0:11:22.09,0:11:24.76,Default,,0,0,0,,Осыған қарамастан, жанкүйерлер оған қамқорлық жасауды шешті.
Dialogue: 0,0:11:26.26,0:11:27.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:27.47,0:11:29.18,Default,,0,0,0,,Өте дәмді болды.
Dialogue: 0,0:11:29.35,0:11:31.27,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:11:31.56,0:11:33.06,Default,,0,0,0,,Ұрыс сатасыз ба?
Dialogue: 0,0:11:33.19,0:11:35.02,Default,,0,0,0,,Сізге үлкен рахмет~
Dialogue: 0,0:11:35.27,0:11:36.44,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:11:36.57,0:11:38.90,Default,,0,0,0,,«Рахмет» нені білдіреді?
Dialogue: 0,0:11:39.03,0:11:40.70,Default,,0,0,0,,Бұл мүлдем басқа!
Dialogue: 0,0:11:40.82,0:11:41.78,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:11:42.24,0:11:44.20,Default,,0,0,0,,Жылыту жұмыс істемейді. Мынау.
Dialogue: 0,0:11:44.32,0:11:45.41,Default,,0,0,0,,Сіздің отбасыңыз...
Dialogue: 0,0:11:45.53,0:11:47.20,Default,,0,0,0,,О, жоқ, жоқ
Dialogue: 0,0:11:47.33,0:11:48.91,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:49.96,0:11:52.50,Default,,0,0,0,,Бұны шешуге біраз уақыт кетеді, сондықтан алдымен оны киіңіз.
Dialogue: 0,0:11:52.62,0:11:53.67,Default,,0,0,0,,Соңғы бөлме
Dialogue: 0,0:11:54.92,0:11:55.84,Default,,0,0,0,,Хмм!
Dialogue: 0,0:11:56.25,0:11:58.09,Default,,0,0,0,,Электр ол сол жақта, дұрыс па?
Dialogue: 0,0:11:58.42,0:11:59.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:00.34,0:12:01.38,Default,,0,0,0,,Уау...
Dialogue: 0,0:12:01.88,0:12:02.72,Default,,0,0,0,,[Rurr…]
Dialogue: 0,0:12:02.84,0:12:03.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:04.05,0:12:05.18,Default,,0,0,0,,Мя~
Dialogue: 0,0:12:05.97,0:12:07.22,Default,,0,0,0,,Мысық жақсы ма?
Dialogue: 0,0:12:07.35,0:12:08.27,Default,,0,0,0,,Иә
Dialogue: 0,0:12:08.77,0:12:11.27,Default,,0,0,0,,Отыр, мен саған қазір кофе дайындаймын.
Dialogue: 0,0:12:11.73,0:12:13.27,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:14.98,0:12:16.19,Default,,0,0,0,,Ол өте салқынқанды…
Dialogue: 0,0:12:16.44,0:12:17.48,Default,,0,0,0,,Не? Сіз оны ойнайсыз ба?
Dialogue: 0,0:12:17.61,0:12:20.69,Default,,0,0,0,,Мүлдем емес, бірақ мен оған сүйсінемін.
Dialogue: 0,0:12:21.28,0:12:22.53,Default,,0,0,0,,Сіз оны алғыңыз келе ме?
Dialogue: 0,0:12:22.65,0:12:23.70,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:12:25.99,0:12:26.91,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:12:27.74,0:12:28.66,Default,,0,0,0,,Уау...
Dialogue: 0,0:12:28.79,0:12:30.20,Default,,0,0,0,,Күтілгеннен ауыр
Dialogue: 0,0:12:30.54,0:12:32.16,Default,,0,0,0,,Бұл маған сәйкес келмейді.
Dialogue: 0,0:12:32.29,0:12:33.96,Default,,0,0,0,,А... солай ма?
Dialogue: 0,0:12:34.29,0:12:35.67,Default,,0,0,0,,әзіл әзіл
Dialogue: 0,0:12:35.79,0:12:38.71,Default,,0,0,0,,Гитарамен кез келген адам әдемі көрінеді дейді.
Dialogue: 0,0:12:39.00,0:12:40.71,Default,,0,0,0,,Сіз әлі орта мектепте оқисыз, солай ма?
Dialogue: 0,0:12:40.84,0:12:43.05,Default,,0,0,0,,Иә 17 жаста
Dialogue: 0,0:12:43.30,0:12:46.14,Default,,0,0,0,,Мен орта мектепке барғанда биыл үшінші курста болдым.
Dialogue: 0,0:12:48.43,0:12:49.64,Default,,0,0,0,,Қант қосасыз ба?
Dialogue: 0,0:12:49.76,0:12:50.97,Default,,0,0,0,,Иә
Dialogue: 0,0:12:51.27,0:12:53.85,Default,,0,0,0,,Мен де 17 жаста едім.
Dialogue: 0,0:12:53.98,0:12:57.23,Default,,0,0,0,,Мен достарыммен орта мектепті тастап, осында келдік.
Dialogue: 0,0:12:57.48,0:12:59.32,Default,,0,0,0,,Үш жыл бұрын...
Dialogue: 0,0:12:59.44,0:13:01.69,Default,,0,0,0,,Әй, сен небәрі 20 жастасың ба?
Dialogue: 0,0:13:01.82,0:13:04.49,Default,,0,0,0,,Уф... аздап ауырады.
Dialogue: 0,0:13:04.95,0:13:07.45,Default,,0,0,0,,Жарайды, бұл шынымен де тағдырдың жазғаны шығар.
Dialogue: 0,0:13:07.57,0:13:09.53,Default,,0,0,0,,Иә, бұл тағдыр.
Dialogue: 0,0:13:09.66,0:13:10.49,Default,,0,0,0,,Ум...
Dialogue: 0,0:13:10.83,0:13:12.75,Default,,0,0,0,,Сен бүгін шықтың ғой, солай ма?
Dialogue: 0,0:13:12.91,0:13:13.75,Default,,0,0,0,,Иә
Dialogue: 0,0:13:13.87,0:13:15.00,Default,,0,0,0,,Мм, қарсы болмасаң...
Dialogue: 0,0:13:15.25,0:13:18.50,Default,,0,0,0,,Мен ертең Асахикаваға қайтамын.
Dialogue: 0,0:13:19.17,0:13:20.00,Default,,0,0,0,,Үйге бару...
Dialogue: 0,0:13:20.30,0:13:22.67,Default,,0,0,0,,Мына жерден құтыл.
Dialogue: 0,0:13:22.80,0:13:25.76,Default,,0,0,0,,Артқа қайтып, музыканы тоқтатыңыз.
Dialogue: 0,0:13:26.80,0:13:28.09,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:13:28.22,0:13:31.06,Default,,0,0,0,,Сондай жақсы ән айтса да
Dialogue: 0,0:13:31.93,0:13:33.89,Default,,0,0,0,,Рахмет, мен суып бара жатырмын.
Dialogue: 0,0:13:35.69,0:13:36.65,Default,,0,0,0,,Момока-сан
Dialogue: 0,0:13:36.94,0:13:39.77,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені ол сатылмады.
Dialogue: 0,0:13:39.90,0:13:43.11,Default,,0,0,0,,Жанды шоулар мен музыкадан түскен табыспен күн көру қиын.
Dialogue: 0,0:13:43.24,0:13:45.40,Default,,0,0,0,,Қалғаны байт байт байт
Dialogue: 0,0:13:45.95,0:13:48.70,Default,,0,0,0,,Бірақ бұл әнді сіз жазғансыз, солай ма?
Dialogue: 0,0:13:48.82,0:13:50.53,Default,,0,0,0,,Бұл өте көп ойналып жатса да
Dialogue: 0,0:13:50.83,0:13:52.99,Default,,0,0,0,,Мен оны біреуге бердім (Нина) А?
Dialogue: 0,0:13:53.12,0:13:55.71,Default,,0,0,0,,Бұл әнге құқықтар енді жоқ.
Dialogue: 0,0:13:58.83,0:14:00.04,Default,,0,0,0,,Мен шамамен жеті пайыз ғана шын айтып тұрмын.
Dialogue: 0,0:14:00.88,0:14:01.71,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:14:01.84,0:14:03.30,Default,,0,0,0,,Сұраудың қажеті жоқ.
Dialogue: 0,0:14:03.46,0:14:04.30,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:14:04.42,0:14:06.84,Default,,0,0,0,,Момока жасағандықтан, солай ма?
Dialogue: 0,0:14:06.97,0:14:09.30,Default,,0,0,0,,Сіз оны бере алмауыңыз керек!
Dialogue: 0,0:14:09.55,0:14:11.35,Default,,0,0,0,,Мен мұны істей аламын (Нина) Мен істей алмаймын.
Dialogue: 0,0:14:11.47,0:14:12.31,Default,,0,0,0,,Хмм!
Dialogue: 0,0:14:12.47,0:14:13.85,Default,,0,0,0,,Мен мұны істей аламын (Нина) Мен істей алмаймын.
Dialogue: 0,0:14:13.97,0:14:15.31,Default,,0,0,0,,Мен мұны істей аламын (Нина) Мен істей алмаймын.
Dialogue: 0,0:14:15.85,0:14:18.44,Default,,0,0,0,,Сіз Хиго Моккосу күткендей қыңырсыз
Dialogue: 0,0:14:18.56,0:14:19.81,Default,,0,0,0,,Атанмытай
Dialogue: 0,0:14:19.94,0:14:21.94,Default,,0,0,0,,[Гитара орындауы]
Dialogue: 0,0:14:22.23,0:14:23.44,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:14:26.44,0:14:27.32,Default,,0,0,0,,Савана
Dialogue: 0,0:14:28.57,0:14:30.16,Default,,0,0,0,,Дәл... бұл не?
Dialogue: 0,0:14:30.28,0:14:33.33,Default,,0,0,0,,Ол дәл қазір қатты шошып кетті, қандай біртүрлі жігіт.
Dialogue: 0,0:14:33.54,0:14:34.87,Default,,0,0,0,,Өйткені бұл ән...
Dialogue: 0,0:14:35.00,0:14:36.16,Default,,0,0,0,,[Есіктің ашылған дыбысы]
Dialogue: 0,0:14:37.25,0:14:38.50,Default,,0,0,0,,Өл, қарт жезөкше!
Dialogue: 0,0:14:38.62,0:14:40.17,Default,,0,0,0,,Жоқ… артық әуре болма.
Dialogue: 0,0:14:40.29,0:14:43.25,Default,,0,0,0,,Егер сіз қатты шуылдасаңыз, қасыңыздағы адам сізге тағы айқайлайды.
Dialogue: 0,0:14:43.38,0:14:45.76,Default,,0,0,0,,Не, қазір шығасың ба?
Dialogue: 0,0:14:45.88,0:14:47.05,Default,,0,0,0,,О~
Dialogue: 0,0:14:47.17,0:14:48.01,Default,,0,0,0,,Мен... қазір!
Dialogue: 0,0:14:48.13,0:14:49.18,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:14:49.43,0:14:50.34,Default,,0,0,0,,Немесе… Жігіт
Dialogue: 0,0:14:50.47,0:14:51.55,Default,,0,0,0,,Ол сенің жігітің ғой, солай ма?
Dialogue: 0,0:14:51.68,0:14:53.22,Default,,0,0,0,,Жасаңыз... бірге тұрыңыз! Хаха...
Dialogue: 0,0:14:53.35,0:14:55.68,Default,,0,0,0,,･･･
Dialogue: 0,0:14:55.81,0:14:57.89,Default,,0,0,0,,Біз бірге тұрамыз. Біз бөлмені бөлісеміз.
Dialogue: 0,0:14:58.02,0:15:00.65,Default,,0,0,0,,Мұндай үлкен үйді жалғыз жалдауға мүмкіндік жоқ.
Dialogue: 0,0:15:00.77,0:15:02.69,Default,,0,0,0,,Бірақ... ол еркек еді ғой?
Dialogue: 0,0:15:02.94,0:15:05.32,Default,,0,0,0,,Әй, бірақ махаббат қызығы ер адам.
Dialogue: 0,0:15:05.44,0:15:08.11,Default,,0,0,0,,Менің ойымша, сен қазір жігітіңнің үйінде қалатын шығарсың.
Dialogue: 0,0:15:08.24,0:15:09.20,Default,,0,0,0,,Жігіт…
Dialogue: 0,0:15:11.91,0:15:15.24,Default,,0,0,0,,Эзука! Токио Эзука!
Dialogue: 0,0:15:15.37,0:15:16.20,Default,,0,0,0,,Кавасаки
Dialogue: 0,0:15:16.49,0:15:18.91,Default,,0,0,0,,Бөлек бөлмелер және әртүрлі тұру уақыты
Dialogue: 0,0:15:19.04,0:15:20.75,Default,,0,0,0,,Біз бір-бірімізді сирек көреміз
Dialogue: 0,0:15:20.87,0:15:21.71,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:21.96,0:15:25.38,Default,,0,0,0,,Менің айтайын дегенім, сіз де бір бөлмені бөлісу туралы ойлануыңыз керек.
Dialogue: 0,0:15:25.50,0:15:27.30,Default,,0,0,0,,Мұнда жалғыз тұру
Dialogue: 0,0:15:27.42,0:15:29.97,Default,,0,0,0,,Мұны білмес бұрын, сіз тек толық емес жұмыс күнімен жұмыс жасайсыз.
Dialogue: 0,0:15:30.26,0:15:31.38,Default,,0,0,0,,Жалдау ақысы қандай?
Dialogue: 0,0:15:31.64,0:15:32.47,Default,,0,0,0,,50 000
Dialogue: 0,0:15:32.80,0:15:33.80,Default,,0,0,0,,Толық емес жұмыс күні туралы не айтасыз?
Dialogue: 0,0:15:33.93,0:15:36.14,Default,,0,0,0,,Иә, мен әлі шешкен жоқпын...
Dialogue: 0,0:15:36.26,0:15:38.39,Default,,0,0,0,,Жарайды ма? Сонымен
Dialogue: 0,0:15:38.52,0:15:39.93,Default,,0,0,0,,Менде жинақ бар.
Dialogue: 0,0:15:40.06,0:15:42.85,Default,,0,0,0,,Үйден шыққанда мен де азын-аулақ ақша алдым.
Dialogue: 0,0:15:43.15,0:15:45.07,Default,,0,0,0,,Не, бұл оңай жеңіс пе?
Dialogue: 0,0:15:45.61,0:15:47.57,Default,,0,0,0,,Содан кейін өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:15:47.69,0:15:49.19,Default,,0,0,0,,Менің ақшам болғанша...
Dialogue: 0,0:15:49.32,0:15:52.20,Default,,0,0,0,,Бұл мен туралы не айтады?
Dialogue: 0,0:15:54.74,0:15:58.12,Default,,0,0,0,,Бұл оңай жеңіс деп ойламаңыз!
Dialogue: 0,0:15:58.58,0:16:00.12,Default,,0,0,0,,Кофе мейрамы үшін рахмет.
Dialogue: 0,0:16:00.25,0:16:01.58,Default,,0,0,0,,Таңғажайып емес пе? Көз жеткен жердің бәрінде Ятоитерлер!
Dialogue: 0,0:16:01.96,0:16:04.29,Default,,0,0,0,,[Есіктің ашылу және жабылу дыбысы]
Dialogue: 0,0:16:04.42,0:16:05.63,Default,,0,0,0,,[Мысық мияу]
Dialogue: 0,0:16:07.30,0:16:08.13,Default,,0,0,0,,Я...
Dialogue: 0,0:16:11.84,0:16:13.05,Default,,0,0,0,,[Жақындау]
Dialogue: 0,0:16:13.18,0:16:14.30,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:16:15.26,0:16:17.43,Default,,0,0,0,,Сіздің аяқтарыңыз жылдам.
Dialogue: 0,0:16:18.01,0:16:18.93,Default,,0,0,0,,Ах
Dialogue: 0,0:16:20.43,0:16:22.14,Default,,0,0,0,,Кешіріңіз, бұл жаман болды.
Dialogue: 0,0:16:22.69,0:16:26.23,Default,,0,0,0,,Мен сол жаста мектепті тастап, осында келдім.
Dialogue: 0,0:16:26.86,0:16:28.40,Default,,0,0,0,,Оңай жеңіс жоқ.
Dialogue: 0,0:16:29.36,0:16:30.90,Default,,0,0,0,,Сіз қандай болғыңыз келеді?
Dialogue: 0,0:16:31.28,0:16:33.41,Default,,0,0,0,,Ерекше ештеңе жоқ
Dialogue: 0,0:16:33.53,0:16:34.66,Default,,0,0,0,,«Ештеңе»?
Dialogue: 0,0:16:35.53,0:16:38.24,Default,,0,0,0,,Мен мұнда түс көргендіктен келмедім.
Dialogue: 0,0:16:38.49,0:16:40.91,Default,,0,0,0,,Менің тиесілі жерім жоқ.
Dialogue: 0,0:16:41.33,0:16:46.04,Default,,0,0,0,,Мен қателеспесем де, бұл мені кінәлі сезінді.
Dialogue: 0,0:16:46.17,0:16:47.92,Default,,0,0,0,,Мен одан жеңілгім келмейді
Dialogue: 0,0:16:48.34,0:16:49.38,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:49.50,0:16:51.55,Default,,0,0,0,,Содан кейін тағы да «Кешіріңіз» деп айтыңыз.
Dialogue: 0,0:16:52.05,0:16:53.55,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:54.22,0:16:55.51,Default,,0,0,0,,Бұл Момока.
Dialogue: 0,0:16:55.64,0:16:57.60,Default,,0,0,0,,Неліктен Асахикаваға қайтып бара жатырсың?
Dialogue: 0,0:16:57.72,0:16:59.64,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:16:59.76,0:17:01.56,Default,,0,0,0,,Әдеттегі ұрыс-керіс
Dialogue: 0,0:17:02.81,0:17:04.69,Default,,0,0,0,,Алмас шаңы ше?
Dialogue: 0,0:17:05.10,0:17:07.06,Default,,0,0,0,,Иә, таратылған кезде
Dialogue: 0,0:17:07.19,0:17:09.69,Default,,0,0,0,,Біз бұл әннің кімге тиесілі екенін айта бастадық.
Dialogue: 0,0:17:10.23,0:17:13.61,Default,,0,0,0,,Басқа мүшелер де музыка шығаруды жалғастыруды жоспарлап отыр.
Dialogue: 0,0:17:13.82,0:17:15.07,Default,,0,0,0,,Сіз оны бердіңіз бе?
Dialogue: 0,0:17:15.45,0:17:17.45,Default,,0,0,0,,Тағы бір жақсы ән жаз.
Dialogue: 0,0:17:17.57,0:17:20.37,Default,,0,0,0,,Міне, мен де сол кезде солай ойладым.
Dialogue: 0,0:17:20.49,0:17:21.37,Default,,0,0,0,,Менің тамырларым жарылып кетеді?
Dialogue: 0,0:17:21.49,0:17:22.33,Default,,0,0,0,,Не?
Dialogue: 0,0:17:22.70,0:17:23.87,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:17:24.00,0:17:26.08,Default,,0,0,0,,Бұл жай ғана ақкөңіл адам емес пе?
Dialogue: 0,0:17:26.83,0:17:29.84,Default,,0,0,0,,Бірақ менің ойымша Момока-сан керемет.
Dialogue: 0,0:17:31.00,0:17:31.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:31.96,0:17:33.34,Default,,0,0,0,,Ауырсын, ауырсын!
Dialogue: 0,0:17:33.51,0:17:34.76,Default,,0,0,0,,А-а, сіздің бетіңіз қызарып кетті.
Dialogue: 0,0:17:34.88,0:17:35.72,Default,,0,0,0,,Шулы!
Dialogue: 0,0:17:35.88,0:17:38.60,Default,,0,0,0,,Сіздің шашыңыздың бәрі бүлінген!
Dialogue: 0,0:17:42.97,0:17:44.39,Default,,0,0,0,,Караокеге барамыз ба?
Dialogue: 0,0:17:44.68,0:17:45.60,Default,,0,0,0,,Бұдан былай?
Dialogue: 0,0:17:46.10,0:17:49.36,Default,,0,0,0,,Мұнда адамдар осындай кезде караокеге барады.
Dialogue: 0,0:17:49.48,0:17:51.61,Default,,0,0,0,,Кумамото үшін де солай.
Dialogue: 0,0:17:51.73,0:17:53.99,Default,,0,0,0,,Елді мазақ етпе.
Dialogue: 0,0:17:54.11,0:17:57.16,Default,,0,0,0,,Асахикава Кумамотодан әлдеқайда кіші.
Dialogue: 0,0:17:57.28,0:17:58.32,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:17:58.45,0:18:00.78,Default,,0,0,0,,Қараңдаршы, халық жартысы, солай емес пе?
Dialogue: 0,0:18:00.91,0:18:02.99,Default,,0,0,0,,Бірақ мұнда рамен жақсырақ.
Dialogue: 0,0:18:03.12,0:18:04.91,Default,,0,0,0,,Мен келісе алмаймын.
Dialogue: 0,0:18:06.29,0:18:07.37,Default,,0,0,0,,[Шапалақтау]
Dialogue: 0,0:18:07.50,0:18:09.67,Default,,0,0,0,,Сіз бұл өте ескі әнді білесіз.
Dialogue: 0,0:18:10.04,0:18:11.67,Default,,0,0,0,,Мен әжемді жақсы көретінмін.
Dialogue: 0,0:18:12.05,0:18:14.67,Default,,0,0,0,,Ал сіз Алмаз шаңына ғашық болдыңыз ба?
Dialogue: 0,0:18:15.13,0:18:18.68,Default,,0,0,0,,Иә, мен оны қатты қысылған кезде тыңдаймын.
Dialogue: 0,0:18:19.05,0:18:22.68,Default,,0,0,0,,Мен дәл қазір өзімді қалай сезінетінімді айтып жатырмын...
Dialogue: 0,0:18:24.52,0:18:26.27,Default,,0,0,0,,Сіз жоғалта алмайсыз ...
Dialogue: 0,0:18:27.02,0:18:28.98,Default,,0,0,0,,Бұл менің тақырыптық әнім
Dialogue: 0,0:18:33.69,0:18:36.32,Default,,0,0,0,,Өйткені бүгін түнде мен бұл әнді соңғы рет естідім.
Dialogue: 0,0:18:36.44,0:18:40.03,Default,,0,0,0,,Мен Гауһар шаңның соңғы әнін айтамын
Dialogue: 0,0:18:41.12,0:18:41.95,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:42.08,0:18:43.45,Default,,0,0,0,,Енді әрі қарай жүрейік!
Dialogue: 0,0:18:44.83,0:18:46.70,Default,,0,0,0,,[Жаңбыр дыбысы]
Dialogue: 0,0:18:46.83,0:18:48.67,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:18:49.87,0:18:50.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:51.08,0:18:52.04,Default,,0,0,0,,Ня~
Dialogue: 0,0:18:52.21,0:18:53.21,Default,,0,0,0,,Уау~
Dialogue: 0,0:18:53.67,0:18:55.26,Default,,0,0,0,,Әй, бұл~
Dialogue: 0,0:18:56.26,0:18:57.76,Default,,0,0,0,,Ня~
Dialogue: 0,0:18:58.05,0:18:59.47,Default,,0,0,0,,Мысық?
Dialogue: 0,0:19:00.72,0:19:01.89,Default,,0,0,0,,«Қайырлы таң»
Dialogue: 0,0:19:02.01,0:19:04.85,Default,,0,0,0,,«Сіз мұны оқыған кезде мен енді мұнда болмаймын».
Dialogue: 0,0:19:04.97,0:19:07.06,Default,,0,0,0,,«Мен көшу басталды деп ойлаймын».
Dialogue: 0,0:19:07.48,0:19:09.85,Default,,0,0,0,,«Мен толық емес күндік жалақымды аламын».
Dialogue: 0,0:19:09.98,0:19:12.27,Default,,0,0,0,,«Онда мен вокзалды аралап, үйге қайтайын».
Dialogue: 0,0:19:12.61,0:19:16.53,Default,,0,0,0,,«Маған гитарамды беріңіз.»
Dialogue: 0,0:19:17.99,0:19:18.99,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:19:19.11,0:19:20.45,Default,,0,0,0,,...
Dialogue: 0,0:19:21.28,0:19:24.28,Default,,0,0,0,,А... иә, менің жүгімді алып кетіңізші.
Dialogue: 0,0:19:28.58,0:19:29.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:38.17,0:19:39.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:44.76,0:19:46.51,Default,,0,0,0,,Не? (Нина) Мен бірден қайтамын!
Dialogue: 0,0:19:46.64,0:19:48.02,Default,,0,0,0,,[Жаңбыр дыбысы]
Dialogue: 0,0:19:48.31,0:19:49.27,Default,,0,0,0,,Хахаха
Dialogue: 0,0:19:56.73,0:19:57.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:05.12,0:20:07.66,Default,,0,0,0,,Момока-сан Момока-сан…
Dialogue: 0,0:20:09.83,0:20:10.79,Default,,0,0,0,,Момока-сан
Dialogue: 0,0:20:11.04,0:20:12.33,Default,,0,0,0,,Момока-сан
Dialogue: 0,0:20:17.63,0:20:18.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:18.63,0:20:20.17,Default,,0,0,0,,Сәлем! О сен!
Dialogue: 0,0:20:20.59,0:20:22.93,Default,,0,0,0,,Момока-сан! Момока-сан!
Dialogue: 0,0:20:23.43,0:20:25.09,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:20:25.22,0:20:28.01,Default,,0,0,0,,Біткен соң, бітті!
Dialogue: 0,0:20:28.18,0:20:32.94,Default,,0,0,0,,Сіз өзіңізге «болды» десең, шынымен де бітті!
Dialogue: 0,0:20:33.90,0:20:35.19,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:20:35.52,0:20:38.94,Default,,0,0,0,,Ол өте өзімшіл және өте өзімшіл сөздер айтады!
Dialogue: 0,0:20:39.44,0:20:42.45,Default,,0,0,0,,Мен мұнда жеңілгім келмегендіктен келдім.
Dialogue: 0,0:20:42.99,0:20:45.57,Default,,0,0,0,,Сондықтан Момока-саннан да жеңілмейсің деп үміттенемін.
Dialogue: 0,0:20:45.74,0:20:46.91,Default,,0,0,0,,…
Dialogue: 0,0:20:47.49,0:20:48.74,Default,,0,0,0,,Бірге!
Dialogue: 0,0:20:49.99,0:20:54.04,Default,,0,0,0,,Ортаңғы саусағыңызды көтеріңіз!
Dialogue: 0,0:21:02.63,0:21:05.51,Default,,0,0,0,,[Гитараның шырылдаған дыбысы]
Dialogue: 0,0:21:09.10,0:21:10.60,Default,,0,0,0,,Сіз ән айта аласыз, солай ма?
Dialogue: 0,0:21:12.93,0:21:13.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:18.61,0:21:21.73,Default,,0,0,0,,``Бос жәшік'' ♪Бұл шынымен ақ және өте ұзын
Dialogue: 0,0:21:21.86,0:21:26.95,Default,,0,0,0,,♪Котаэ, бәлкім, жай ғана форма болып табылатын қарапайым білім.
Dialogue: 0,0:21:27.12,0:21:30.83,Default,,0,0,0,,♪Саусақ ұшы дірілдеп тұрса да
Dialogue: 0,0:21:31.74,0:21:35.87,Default,,0,0,0,,♪Үш жақты қиылыс бар, ол картада болмауы керек.
Dialogue: 0,0:21:36.00,0:21:38.38,Default,,0,0,0,,♪Менде жанжал бар.
Dialogue: 0,0:21:38.50,0:21:44.80,Default,,0,0,0,,♪Мен алға жылжу үшін неге сүйенуім керек?
Dialogue: 0,0:21:45.38,0:21:48.39,Default,,0,0,0,,♪Оқулықта айтылғандай.
Dialogue: 0,0:21:48.64,0:21:50.93,Default,,0,0,0,,♪ Күрделі сөздерге толы
Dialogue: 0,0:21:51.06,0:21:56.60,Default,,0,0,0,,♪Ол күннен бері бүгінгі күн мүлде өзгерген жоқ.
Dialogue: 0,0:21:57.98,0:22:02.94,Default,,0,0,0,,♪ Бос орындарды толтыру арқылы шеше аласыз ба?
Dialogue: 0,0:22:03.07,0:22:04.57,Default,,0,0,0,,♪Бір күні
Dialogue: 0,0:22:04.82,0:22:10.28,Default,,0,0,0,,♪Алға қалай жылар едіңіз?
Dialogue: 0,0:22:10.41,0:22:13.62,Default,,0,0,0,,♪Бұл шынымен ақ, бұл өте ұзын
Dialogue: 0,0:22:13.75,0:22:18.83,Default,,0,0,0,,♪Котаэ негізінен форма болып табылады деген түсінік бар.
Dialogue: 0,0:22:19.04,0:22:22.84,Default,,0,0,0,,♪Саусақ ұшы дірілдеп тұрса да
Dialogue: 0,0:22:23.42,0:22:26.51,Default,,0,0,0,,♪Дұрыс жауап жоқ, жеңіліс жоқ.
Dialogue: 0,0:22:26.72,0:22:28.22,Default,,0,0,0,,♪Менің бүкіл өмірім
Dialogue: 0,0:22:28.34,0:22:31.76,Default,,0,0,0,,♪Бұл менмін, бар болғаны.
Dialogue: 0,0:22:32.01,0:22:37.64,Default,,0,0,0,,♪Енді бұзатын болсақ та, ертең болмайды
Dialogue: 0,0:22:46.61,0:22:50.36,Default,,0,0,0,,♪Қанша талпынсаң да ертең жоқ
Dialogue: 0,0:22:50.49,0:22:53.49,Default,,0,0,0,,～♪
Dialogue: 0,0:22:55.62,0:23:00.46,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:23:01.08,0:23:03.00,Default,,0,0,0,,А...
Dialogue: 0,0:23:05.55,0:23:06.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:11.30,0:23:13.35,Default,,0,0,0,,Токиоға келгеннен кейін бірнеше күн
Dialogue: 0,0:23:13.47,0:23:17.35,Default,,0,0,0,,Таңертең көзімді ашсам, мына көріністі көремін.
Dialogue: 0,0:23:29.07,0:23:31.32,Default,,0,0,0,,Түсінгенше мен неше рет айтуым керек?
Dialogue: 0,0:23:31.74,0:23:32.99,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:23:33.12,0:23:35.37,Default,,0,0,0,,Онда сіздің атыңыз жазылған, солай ма?
Dialogue: 0,0:23:35.49,0:23:36.45,Default,,0,0,0,,Сараң
Dialogue: 0,0:23:36.58,0:23:37.95,Default,,0,0,0,,(Каишо) Қорықпа—ағамның қаны менікімен бірдей қасиетке ие емес.
Dialogue: 0,0:23:38.12,0:23:40.50,Default,,0,0,0,,Ойлану үшін жарты жарым
Dialogue: 0,0:23:40.62,0:23:41.46,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:23:41.67,0:23:42.63,Default,,0,0,0,,Кеше дүкенде
Dialogue: 0,0:23:42.75,0:23:45.59,Default,,0,0,0,,Сатып алудың қажеті жоқ па деп көп сұрадың.
Dialogue: 0,0:23:45.71,0:23:47.51,Default,,0,0,0,,Мен мас болғаным үшін...
Dialogue: 0,0:23:47.63,0:23:48.63,Default,,0,0,0,,Уф
Dialogue: 0,0:23:50.01,0:23:52.59,Default,,0,0,0,,Сізге хабарласты ма?
Dialogue: 0,0:23:52.76,0:23:53.68,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:23:53.80,0:23:58.06,Default,,0,0,0,,Меншікті сатқаннан кейін оған қайта оралу қиын.
Dialogue: 0,0:23:58.18,0:24:00.31,Default,,0,0,0,,Толық емес жұмыс күні туралы не айтасыз? (Момока) Бұл әлі де солай.
Dialogue: 0,0:24:00.43,0:24:02.77,Default,,0,0,0,,Мен бүгін шығуым керек.
Dialogue: 0,0:24:02.90,0:24:03.81,Default,,0,0,0,,Уф!
Dialogue: 0,0:24:05.36,0:24:06.52,Default,,0,0,0,,Сіз ол жерге күнде барасыз ба?
Dialogue: 0,0:24:06.73,0:24:10.53,Default,,0,0,0,,Мен осында оқып, жақсы университетке түсуім керек.
Dialogue: 0,0:24:10.90,0:24:13.74,Default,,0,0,0,,Жарайды, мен күрделі мәселелерге араласпаймын.
Dialogue: 0,0:24:13.87,0:24:16.08,Default,,0,0,0,,Бос уақытымда жаттығуды қалаймын.
Dialogue: 0,0:24:16.20,0:24:17.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:17.62,0:24:19.83,Default,,0,0,0,,Жолақ? (Момока) Сіз мұны істеймін дедіңіз ғой, солай ма?
Dialogue: 0,0:24:19.95,0:24:21.83,Default,,0,0,0,,Мен олай айтқан жоқпын! (Момока) Мен айттым.
Dialogue: 0,0:24:21.96,0:24:24.67,Default,,0,0,0,,«Ортаңғы саусағыңызды бірге көтеріңіз.»
Dialogue: 0,0:24:24.88,0:24:28.05,Default,,0,0,0,,Бірден ортаңғы саусағыңызды көрсету әдеті туралы бірдеңе жасаңыз.
Dialogue: 0,0:24:28.17,0:24:29.17,Default,,0,0,0,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,0:24:29.38,0:24:31.76,Default,,0,0,0,,Бұл «ән айту» дегенді білдірмейді
Dialogue: 0,0:24:31.88,0:24:33.80,Default,,0,0,0,,«Әр позиция»
Dialogue: 0,0:24:34.14,0:24:35.64,Default,,0,0,0,,Мен оқимын
Dialogue: 0,0:24:35.76,0:24:37.43,Default,,0,0,0,,Момока — музыка
Dialogue: 0,0:24:37.68,0:24:39.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:24:39.68,0:24:42.19,Default,,0,0,0,,Неге екені белгісіз, біртүрлі болып қалдым.
Dialogue: 0,0:24:42.48,0:24:45.15,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:24:46.69,0:24:49.15,Default,,0,0,0,,Жоқ, мен оны музыкалық аспап деп атамаймын.
Dialogue: 0,0:24:49.28,0:24:52.70,Default,,0,0,0,,Менің ойымша, Нина жақсы вокалист, солай ма?
Dialogue: 0,0:24:52.90,0:24:54.57,Default,,0,0,0,,Иә? Вокал?
Dialogue: 0,0:24:54.91,0:24:58.03,Default,,0,0,0,,Оның даусы жақсы, бәрінен де жүрегі сүйкімді.
Dialogue: 0,0:24:58.16,0:25:00.37,Default,,0,0,0,,Мен бе? (Момока) Иә
Dialogue: 0,0:25:00.66,0:25:01.83,Default,,0,0,0,,Топ дегеніміз не?
Dialogue: 0,0:25:02.29,0:25:04.42,Default,,0,0,0,,Айтқысы келетін сөздері көп адамдар бар.
Dialogue: 0,0:25:04.54,0:25:05.71,Default,,0,0,0,,Бұл біз жиналған кезде жасайтын нәрсе.
Dialogue: 0,0:25:05.83,0:25:07.08,Default,,0,0,0,,Сіз солай ойлайсыз.
Dialogue: 0,0:25:07.79,0:25:10.21,Default,,0,0,0,,«Ғашық болайық~»
Dialogue: 0,0:25:10.38,0:25:12.97,Default,,0,0,0,,«Дүние мені ашуландырады».
Dialogue: 0,0:25:13.34,0:25:16.09,Default,,0,0,0,,«Мен қатты әсерлендім»
Dialogue: 0,0:25:16.55,0:25:20.06,Default,,0,0,0,,«Мен өзімді жақсы көремін» «Мен өзімді жек көремін» т.б.
Dialogue: 0,0:25:21.68,0:25:24.10,Default,,0,0,0,,Өзің ән айтуың керек емес пе?
Dialogue: 0,0:25:24.69,0:25:26.19,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:25:26.31,0:25:29.11,Default,,0,0,0,,Топтар керемет, солай емес пе?
Dialogue: 0,0:25:29.52,0:25:30.52,Default,,0,0,0,,Біз бірге болғанда
Dialogue: 0,0:25:30.65,0:25:33.44,Default,,0,0,0,,Ғайбат та болды, айту да болды, көп болды
Dialogue: 0,0:25:33.57,0:25:35.57,Default,,0,0,0,,Олай десем, жеңілемін, бірақ шыдаймын.
Dialogue: 0,0:25:35.70,0:25:38.03,Default,,0,0,0,,Біз әрқашан бірге болғандықтан, ол жинала береді
Dialogue: 0,0:25:38.16,0:25:40.08,Default,,0,0,0,,Менің енді сол ауаны жұтқым да келмейді
Dialogue: 0,0:25:40.20,0:25:41.20,Default,,0,0,0,,Ол ақыры жарылып кетті...
Dialogue: 0,0:25:41.33,0:25:43.00,Default,,0,0,0,,Мен бұл туралы жақсы ештеңе айтқан жоқпын.
Dialogue: 0,0:25:43.33,0:25:45.29,Default,,0,0,0,,Не? О, көремін
Dialogue: 0,0:25:45.71,0:25:47.58,Default,,0,0,0,,Бірақ, бұл қызық.
Dialogue: 0,0:25:47.71,0:25:49.75,Default,,0,0,0,,Мен өз бетімше не істей алмаймын
Dialogue: 0,0:25:49.88,0:25:52.00,Default,,0,0,0,,Өзіңнен басқа біреумен жасау деген сөз
Dialogue: 0,0:25:52.13,0:25:52.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:53.63,0:25:54.47,Default,,0,0,0,,Не?
Dialogue: 0,0:25:54.59,0:25:56.13,Default,,0,0,0,,Ештеңе!
Dialogue: 0,0:25:56.63,0:26:00.10,Default,,0,0,0,,Не айтамын, бұл қала сезімі жоқ станция.
Dialogue: 0,0:26:00.22,0:26:02.01,Default,,0,0,0,,Бұл аймақтың жақсы жағы.
Dialogue: 0,0:26:02.14,0:26:03.72,Default,,0,0,0,,Нинаның үйі сол жақта.
Dialogue: 0,0:26:03.85,0:26:06.06,Default,,0,0,0,,Бұл жерде супермаркет бар, мен айтайын.
Dialogue: 0,0:26:06.19,0:26:07.48,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:26:07.77,0:26:08.77,Default,,0,0,0,,Ита
Dialogue: 0,0:26:09.36,0:26:10.90,Default,,0,0,0,,Иә, күткеніңізге рахмет.
Dialogue: 0,0:26:11.07,0:26:11.90,Default,,0,0,0,,Уау...
Dialogue: 0,0:26:12.32,0:26:14.44,Default,,0,0,0,,Маған да жақында шам сатып алу керек.
Dialogue: 0,0:26:14.57,0:26:16.90,Default,,0,0,0,,Сен мұны жейсің бе?
Dialogue: 0,0:26:17.57,0:26:20.24,Default,,0,0,0,,Нина жас ханым ғой.
Dialogue: 0,0:26:20.37,0:26:21.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:21.33,0:26:23.04,Default,,0,0,0,,Бұл байдың ойы.
Dialogue: 0,0:26:23.24,0:26:25.62,Default,,0,0,0,,Не? Жоқ, олай емес, олай емес.
Dialogue: 0,0:26:25.75,0:26:27.62,Default,,0,0,0,,Бұл қалыпты үй.
Dialogue: 0,0:26:28.25,0:26:30.92,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:26:31.29,0:26:33.30,Default,,0,0,0,,Отбасының өсиеттері бар.
Dialogue: 0,0:26:33.50,0:26:34.51,Default,,0,0,0,,Отбасылық өсиет?
Dialogue: 0,0:26:34.63,0:26:37.30,Default,,0,0,0,,А, үй заңдары ұнай ма?
Dialogue: 0,0:26:37.80,0:26:38.97,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:26:39.89,0:26:44.77,Default,,0,0,0,,Бірінші, кешкі асты әрқашан үйде отбасыңызбен ішіңіз.
Dialogue: 0,0:26:45.10,0:26:49.23,Default,,0,0,0,,Біріншіден, қонақ бөлмеде смартфонды пайдалануға тыйым салынады.
Dialogue: 0,0:26:49.90,0:26:54.48,Default,,0,0,0,,Бірінші, әр жексенбі күні кешке отбасылық жиналыс өткізіңіз.
Dialogue: 0,0:26:54.90,0:26:55.82,Default,,0,0,0,,...т.б.
Dialogue: 0,0:26:57.03,0:26:57.86,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:26:57.99,0:27:02.70,Default,,0,0,0,,Сонда менің ата-анам: «Ой, мынау осындай іспен айналысатын отбасы ғой.
Dialogue: 0,0:27:02.83,0:27:04.91,Default,,0,0,0,,Ол мектепте біраз атақты...
Dialogue: 0,0:27:05.04,0:27:07.58,Default,,0,0,0,,А, мен оны түсіндім.
Dialogue: 0,0:27:08.04,0:27:10.83,Default,,0,0,0,,Бірақ мен енді мектепке бара алмаймын.
Dialogue: 0,0:27:10.96,0:27:12.71,Default,,0,0,0,,Ақыры мен бас тарттым.
Dialogue: 0,0:27:12.84,0:27:13.84,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:27:14.00,0:27:16.59,Default,,0,0,0,,Бұл маңызды емес, солай ма?
Dialogue: 0,0:27:18.67,0:27:19.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:20.18,0:27:21.01,Default,,0,0,0,,​​Солай ма?
Dialogue: 0,0:27:21.43,0:27:23.10,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:27:23.68,0:27:25.26,Default,,0,0,0,,Бетке тым көп
Dialogue: 0,0:27:27.14,0:27:29.73,Default,,0,0,0,,Мектептегі ең танымал және әдемі қыз
Dialogue: 0,0:27:29.94,0:27:32.65,Default,,0,0,0,,Ұлдар мектебіндегі сымбатты жігіттер орындарын ауыстыра береді
Dialogue: 0,0:27:32.77,0:27:33.61,Default,,0,0,0,,Не?
Dialogue: 0,0:27:33.81,0:27:35.98,Default,,0,0,0,,Ол сені қорлады ма?
Dialogue: 0,0:27:36.11,0:27:37.11,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:27:37.44,0:27:38.49,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:27:38.94,0:27:40.45,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:27:40.57,0:27:42.95,Default,,0,0,0,,Сізге ұнамады деп ойлаймын.
Dialogue: 0,0:27:43.07,0:27:44.87,Default,,0,0,0,,Қайтарып бермедің бе?
Dialogue: 0,0:27:45.08,0:27:46.33,Default,,0,0,0,,Мұндай бала
Dialogue: 0,0:27:46.45,0:27:48.91,Default,,0,0,0,,Қарсы алмас үшін достар табыңыз
Dialogue: 0,0:27:49.04,0:27:50.50,Default,,0,0,0,,Бұл қулық.
Dialogue: 0,0:27:50.96,0:27:54.17,Default,,0,0,0,,Достарыңызды пайдаланыңыз, оларды елемеңіз, зиян келтіріңіз ...
Dialogue: 0,0:27:54.29,0:27:56.67,Default,,0,0,0,,Мен ауруханаға жеткізілдім
Dialogue: 0,0:27:56.80,0:28:00.38,Default,,0,0,0,,Отбасыңды, тіпті мектебіңді әбігерге салмағаның дұрыс...
Dialogue: 0,0:28:00.51,0:28:01.63,Default,,0,0,0,,Тоқта
Dialogue: 0,0:28:01.84,0:28:04.43,Default,,0,0,0,,Кәстрөл шамадан тыс піседі.
Dialogue: 0,0:28:04.55,0:28:07.14,Default,,0,0,0,,Жарайды, мен көкөніс жейтін адаммын.
Dialogue: 0,0:28:08.18,0:28:10.64,Default,,0,0,0,,Менің ойымша, бәрінен кейін ән айтқан дұрыс.
Dialogue: 0,0:28:10.77,0:28:11.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:11.64,0:28:14.44,Default,,0,0,0,,Жаңа айтқанымнан 5 ән жаза аламын.
Dialogue: 0,0:28:14.73,0:28:19.19,Default,,0,0,0,,Бірде мен вокалист болмаған топты сынап көргім келді.
Dialogue: 0,0:28:19.40,0:28:22.45,Default,,0,0,0,,Мен тек гитараға назар аударудың қандай екеніне таңғаламын.
Dialogue: 0,0:28:22.91,0:28:24.20,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:28:24.32,0:28:25.66,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:28:29.45,0:28:31.46,Default,,0,0,0,,Орта мектепті тастап кету деген нені білдіреді?
Dialogue: 0,0:28:31.66,0:28:34.96,Default,,0,0,0,,Сіздің болашақ нұсқаларыңыз осылай тар.
Dialogue: 0,0:28:35.25,0:28:39.13,Default,,0,0,0,,Өзің қалаған нәрсеге қол жеткізгеннен кейін өкінуге тым кеш.
Dialogue: 0,0:28:40.63,0:28:41.47,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:28:41.76,0:28:44.09,Default,,0,0,0,,Сондықтан университетке түсу керек!
Dialogue: 0,0:28:44.30,0:28:46.97,Default,,0,0,0,,Егер сіз университетті оқып, тапсырсаңыз!
Dialogue: 0,0:28:47.97,0:28:50.81,Default,,0,0,0,,Жоқ... Мен мектепті бітіремін.
Dialogue: 0,0:28:50.93,0:28:53.52,Default,,0,0,0,,Университетке түсе алмасаң, бітті.
Dialogue: 0,0:28:54.27,0:28:55.15,Default,,0,0,0,,Бұл соңы ма...
Dialogue: 0,0:28:55.48,0:28:58.27,Default,,0,0,0,,Аа, жоқ, менің айтқым келгені бұл емес еді.
Dialogue: 0,0:28:58.44,0:29:02.57,Default,,0,0,0,,Дегенмен, осылай жалғастыра берсем, мен жеңіліп жатқан сияқтымын, солай ма?
Dialogue: 0,0:29:03.03,0:29:04.74,Default,,0,0,0,,Тіпті мені қорлаған адамдарға да
Dialogue: 0,0:29:04.86,0:29:06.57,Default,,0,0,0,,Ата-аналар мен мұғалімдер де...
Dialogue: 0,0:29:07.58,0:29:08.70,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:29:09.08,0:29:10.87,Default,,0,0,0,,Онда мен сені енді шақырмаймын.
Dialogue: 0,0:29:11.41,0:29:12.83,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:29:13.21,0:29:15.25,Default,,0,0,0,,Бұл кешірім сұрау туралы емес.
Dialogue: 0,0:29:15.75,0:29:18.17,Default,,0,0,0,,Әлі де сыра болды, солай ма?
Dialogue: 0,0:29:22.42,0:29:25.09,Default,,0,0,0,,Иә, мен мұны қолданамын.
Dialogue: 0,0:29:25.26,0:29:27.34,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:29:27.64,0:29:31.10,Default,,0,0,0,,Қалай болғанда да, мен ойнай алмаймын.
Dialogue: 0,0:29:33.98,0:29:36.60,Default,,0,0,0,,Менің ойымша, оны қабылдаған дұрыс.
Dialogue: 0,0:29:38.86,0:29:39.98,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:29:41.82,0:29:42.78,Default,,0,0,0,,Әй, сәлем айт
Dialogue: 0,0:29:42.90,0:29:45.32,Default,,0,0,0,,Не, мен сенімен баруым керек пе?
Dialogue: 0,0:29:45.45,0:29:46.61,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:29:47.11,0:29:47.99,Default,,0,0,0,,Иә
Dialogue: 0,0:29:49.95,0:29:53.62,Default,,0,0,0,,Олай болса, менен соңғы бір нәрсе сұрай аласыз ба?
Dialogue: 0,0:29:53.75,0:29:55.08,Default,,0,0,0,,Не ол?
Dialogue: 0,0:29:59.75,0:30:01.84,Default,,0,0,0,,Сізде қандай да бір сұраулар бар ма?
Dialogue: 0,0:30:01.96,0:30:03.05,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:30:03.59,0:30:05.26,Default,,0,0,0,,Нинаның сүйікті әні
Dialogue: 0,0:30:05.51,0:30:08.30,Default,,0,0,0,,Уақытың болса, тамақ ішіп алайық.
Dialogue: 0,0:30:09.09,0:30:09.93,Default,,0,0,0,,Иә
Dialogue: 0,0:30:10.05,0:30:13.06,Default,,0,0,0,,Әуеніңізге де сәттілік, Момока-сан!
Dialogue: 0,0:30:13.43,0:30:14.31,Default,,0,0,0,,Иә
Dialogue: 0,0:30:16.44,0:30:19.94,Default,,0,0,0,,Мен де Нинаның сені қатты жақсы көретін ән шығарамын.
Dialogue: 0,0:30:20.06,0:30:20.90,Default,,0,0,0,,Иә
Dialogue: 0,0:30:21.02,0:30:23.44,Default,,0,0,0,,Ортаңғы саусағыңызды көтеріп, маған қайта қарашы.
Dialogue: 0,0:30:23.69,0:30:24.94,Default,,0,0,0,,Бір-біріне
Dialogue: 0,0:30:26.36,0:30:27.20,Default,,0,0,0,,Ум...
Dialogue: 0,0:30:28.49,0:30:30.20,Default,,0,0,0,,Ортаңғы саусағыңызды көтергіңіз келсе
Dialogue: 0,0:30:30.32,0:30:31.58,Default,,0,0,0,,Қызғылт саусағыңызды көтеріңіз.
Dialogue: 0,0:30:32.58,0:30:33.95,Default,,0,0,0,,Өйткені мен де солай істеймін.
Dialogue: 0,0:30:35.00,0:30:36.21,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:30:43.88,0:30:44.88,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:30:46.84,0:30:52.85,Default,,0,0,0,,«Бос жәшік» ♪Алға қалай жылар едіңіз?
Dialogue: 0,0:30:54.47,0:30:57.43,Default,,0,0,0,,♪Бұл шынымен ақ, бұл өте ұзын
Dialogue: 0,0:30:57.73,0:31:02.86,Default,,0,0,0,,♪Котаэ жай ғана форма деген түсінік бар.
Dialogue: 0,0:31:03.07,0:31:07.28,Default,,0,0,0,,♪Саусақ ұшы дірілдеп тұрса да
Dialogue: 0,0:31:07.57,0:31:10.61,Default,,0,0,0,,♪Дұрыс жауап жоқ, жеңіліс жоқ.
Dialogue: 0,0:31:10.74,0:31:12.24,Default,,0,0,0,,♪Менің бүкіл өмірім
Dialogue: 0,0:31:12.37,0:31:15.79,Default,,0,0,0,,♪Бұл менмін, бар болғаны.
Dialogue: 0,0:31:16.00,0:31:21.46,Default,,0,0,0,,♪Енді бұзатын болсақ та, ертең болмайды
Dialogue: 0,0:31:25.96,0:31:28.09,Default,,0,0,0,,～♪
Dialogue: 0,0:31:28.72,0:31:29.76,Default,,0,0,0,,Яба…
Dialogue: 0,0:31:32.89,0:31:34.72,Default,,0,0,0,,Мм... [Бетті айналдыру дыбысы]
Dialogue: 0,0:31:35.43,0:31:36.52,Default,,0,0,0,,«Джим айтты»
Dialogue: 0,0:31:36.64,0:31:38.10,Default,,0,0,0,,«Берілме»
Dialogue: 0,0:31:38.23,0:31:41.69,Default,,0,0,0,,«Тіпті қараңғыда да бір күні үміт нұры болады».
Dialogue: 0,0:31:48.40,0:31:49.99,Default,,0,0,0,,Мен бірдеңе сатып алуым керек...
Dialogue: 0,0:31:52.87,0:31:57.24,Default,,0,0,0,,(Дайындық мектебінің лекция дауысы)
Dialogue: 0,0:31:57.37,0:31:59.12,Default,,0,0,0,,[Смартфон: Бейне аудио]
Dialogue: 0,0:31:59.25,0:32:00.41,Default,,0,0,0,,Хаха...
Dialogue: 0,0:32:02.21,0:32:03.96,Default,,0,0,0,,Мен ешкіммен сөйлескен жоқпын.
Dialogue: 0,0:32:06.71,0:32:10.47,Default,,0,0,0,,Мен осы аптада ешкіммен сөйлескен жоқпын.
Dialogue: 0,0:32:11.22,0:32:12.80,Default,,0,0,0,,(Нинаның дауысы)
Dialogue: 0,0:32:13.01,0:32:15.39,Default,,0,0,0,,(Момоканың дауысы)
Dialogue: 0,0:32:15.51,0:32:17.43,Default,,0,0,0,,(Нинаның дауысы)
Dialogue: 0,0:32:17.56,0:32:18.39,Default,,0,0,0,,(Момоканың дауысы)
Dialogue: 0,0:32:20.06,0:32:21.69,Default,,0,0,0,,[Смартфонның кіріс дыбысы]
Dialogue: 0,0:32:22.85,0:32:23.94,Default,,0,0,0,,Я...
Dialogue: 0,0:32:24.48,0:32:26.48,Default,,0,0,0,,[Хабарландыру дыбысы]
Dialogue: 0,0:32:26.61,0:32:27.82,Default,,0,0,0,,Я...
Dialogue: 0,0:32:29.61,0:32:30.69,Default,,0,0,0,,[Хабарландыру дыбысы]
Dialogue: 0,0:32:31.61,0:32:32.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:32.78,0:32:36.45,Default,,0,0,0,,(Момоканың дауысы)
Dialogue: 0,0:32:36.58,0:32:37.79,Default,,0,0,0,,Уау...
Dialogue: 0,0:32:37.91,0:32:38.95,Default,,0,0,0,,«Рахмет!»
Dialogue: 0,0:32:39.08,0:32:39.91,Default,,0,0,0,,«Бұл маған керек!»
Dialogue: 0,0:32:43.71,0:32:45.33,Default,,0,0,0,,Ол сонда орналастырылған.
Dialogue: 0,0:32:45.46,0:32:47.75,Default,,0,0,0,,Жарайды, оны қалыпты жағдайда қолдануға болатын сияқты.
Dialogue: 0,0:32:47.88,0:32:49.42,Default,,0,0,0,,Рахмет
Dialogue: 0,0:32:49.67,0:32:51.51,Default,,0,0,0,,Жарық болғанша, жақсы
Dialogue: 0,0:32:51.63,0:32:53.43,Default,,0,0,0,,Не? Кішкене үйреніп қалдыңыз ба?
Dialogue: 0,0:32:53.84,0:32:56.18,Default,,0,0,0,,Енді... ше...
Dialogue: 0,0:32:57.76,0:33:00.27,Default,,0,0,0,,Сіз тамақ жегіңіз келе ме?
Dialogue: 0,0:33:00.39,0:33:02.06,Default,,0,0,0,,Мен толық емес жұмыс күнін бастадым, сондықтан мен сізге бір нәрсе сыйлаймын.
Dialogue: 0,0:33:02.39,0:33:03.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:03.52,0:33:05.44,Default,,0,0,0,,А, иә, мен барамын.
Dialogue: 0,0:33:06.15,0:33:07.56,Default,,0,0,0,,Бұл бала Нина Чан ба?
Dialogue: 0,0:33:08.61,0:33:09.48,Default,,0,0,0,,Иә
Dialogue: 0,0:33:09.61,0:33:11.15,Default,,0,0,0,,Маған жарық сыйлаған Ясува мырза
Dialogue: 0,0:33:11.28,0:33:13.32,Default,,0,0,0,,Маған барабанда ойнауды тапсырды.
Dialogue: 0,0:33:13.70,0:33:15.78,Default,,0,0,0,,Анва Субару десу
Dialogue: 0,0:33:15.91,0:33:17.07,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:33:17.20,0:33:18.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:33:20.49,0:33:25.00,Default,,0,0,0,,Қытай қырыққабатын көп қайнатып алсаңыз, оның құрамы жоғалып, дәмі нашарлайды.
Dialogue: 0,0:33:25.17,0:33:26.00,Default,,0,0,0,,Иә
Dialogue: 0,0:33:27.21,0:33:28.04,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:33:28.17,0:33:29.00,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:33:29.25,0:33:32.38,Default,,0,0,0,,Ойланып қарашы, Нина-чанға қандай музыка ұнайды?
Dialogue: 0,0:33:32.55,0:33:33.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:33.51,0:33:35.55,Default,,0,0,0,,Сүйікті топ, Vocaloid, т.б.
Dialogue: 0,0:33:35.76,0:33:39.26,Default,,0,0,0,,Маған әжемнің арқасында Шоу дәуірінің әншілері ұнайды.
Dialogue: 0,0:33:39.39,0:33:41.43,Default,,0,0,0,,Ей, жақсы болды, жақсы болды.
Dialogue: 0,0:33:41.56,0:33:42.77,Default,,0,0,0,,Мен де кейде тыңдаймын.
Dialogue: 0,0:33:42.89,0:33:44.02,Default,,0,0,0,,Сізге кім ұнайды?
Dialogue: 0,0:33:44.56,0:33:47.23,Default,,0,0,0,,Жоқ, бұл маған ұнамайды...
Dialogue: 0,0:33:44.94,0:33:47.23,Default,,0,0,0,,♪ [Дүкендегі BGM]
Dialogue: 0,0:33:47.35,0:33:49.57,Default,,0,0,0,,Ах! Бұл Гуреречи емес пе?
Dialogue: 0,0:33:50.11,0:33:52.90,Default,,0,0,0,,Шынымен бе? Сіз Гуреречиді тыңдайсыз ба?
Dialogue: 0,0:33:53.03,0:33:54.82,Default,,0,0,0,,Мен бір рет тікелей эфирге бардым деп ойлаймын.
Dialogue: 0,0:33:54.95,0:33:56.28,Default,,0,0,0,,Және бір рет фестивальде
Dialogue: 0,0:33:56.49,0:33:59.78,Default,,0,0,0,,Өткен жылы фестиваль Чибада болды ма? Иә
Dialogue: 0,0:34:00.03,0:34:04.16,Default,,0,0,0,,(Екеуінің әңгімесі алыстай түседі)
Dialogue: 0,0:34:14.30,0:34:16.51,Default,,0,0,0,,Дебют жақсы болды.
Dialogue: 0,0:34:16.68,0:34:19.51,Default,,0,0,0,,Нина-чан тікелей шоуларға бармайды ма?
Dialogue: 0,0:34:19.93,0:34:20.93,Default,,0,0,0,,Атап айтқанда...
Dialogue: 0,0:34:21.05,0:34:21.89,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:34:22.01,0:34:23.81,Default,,0,0,0,,Қазан бос, енді ет салайын ба?
Dialogue: 0,0:34:23.93,0:34:24.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:24.89,0:34:26.06,Default,,0,0,0,,Сіз етті жек көресіз бе?
Dialogue: 0,0:34:26.23,0:34:27.06,Default,,0,0,0,,Нина-чан?
Dialogue: 0,0:34:27.31,0:34:28.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:28.56,0:34:31.19,Default,,0,0,0,,Бір сәт кешіріңіз...
Dialogue: 0,0:34:37.03,0:34:37.82,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:34:39.41,0:34:40.28,Default,,0,0,0,,Заттарыңды үйге әкетуді ұмытып қалғансың ғой…
Dialogue: 0,0:34:40.41,0:34:42.41,Default,,0,0,0,,Ал, мен сізге аздап айтып берейін.
Dialogue: 0,0:34:42.53,0:34:44.83,Default,,0,0,0,,Мен байланыс нүктелерін ұстап тұруға тырысамын.
Dialogue: 0,0:34:45.16,0:34:47.33,Default,,0,0,0,,«Қолыңнан келгеннің бәрін істе» деген нені білдіреді?
Dialogue: 0,0:34:47.50,0:34:50.08,Default,,0,0,0,,Бұл өзіңізді сөйлеуге мәжбүрлеп жатқаныңызды білдіре ме?
Dialogue: 0,0:34:50.42,0:34:52.80,Default,,0,0,0,,Алғашында бәрі солай істейді, солай ма?
Dialogue: 0,0:34:52.92,0:34:55.34,Default,,0,0,0,,Біз бір-біріміз туралы ештеңе білмейміз.
Dialogue: 0,0:34:55.88,0:34:59.05,Default,,0,0,0,,Біреуге жоғарыдан қарап ашуым келеді.
Dialogue: 0,0:34:59.18,0:35:00.80,Default,,0,0,0,,Бұл жай ғана болжам.
Dialogue: 0,0:35:00.93,0:35:03.18,Default,,0,0,0,,Ол актерлік мектепте оқығанын айтты.
Dialogue: 0,0:35:03.31,0:35:05.06,Default,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:35:05.18,0:35:06.73,Default,,0,0,0,,Мен ешқандай зиян келтірмеймін.
Dialogue: 0,0:35:07.35,0:35:08.98,Default,,0,0,0,,Сіз ақкөңіл адамсыз, солай емес пе?
Dialogue: 0,0:35:09.10,0:35:10.98,Default,,0,0,0,,Тіпті мұңайған баламен
Dialogue: 0,0:35:11.10,0:35:14.98,Default,,0,0,0,,«Мен саған қамқормын» деген сияқты сөздерді айта бермейсің бе?
Dialogue: 0,0:35:15.15,0:35:16.49,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:35:16.61,0:35:17.74,Default,,0,0,0,,Мен депрессияда емеспін!
Dialogue: 0,0:35:17.86,0:35:19.61,Default,,0,0,0,,Адамдарға осылай қарасаң
Dialogue: 0,0:35:19.74,0:35:21.78,Default,,0,0,0,,Қанша уақыт өтсе де, мен ешкіммен сөйлесе алмаймын!
Dialogue: 0,0:35:27.75,0:35:28.58,Default,,0,0,0,,Ах~
Dialogue: 0,0:35:28.71,0:35:29.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:29.96,0:35:32.17,Default,,0,0,0,,Бұл үшін рахмет
Dialogue: 0,0:35:32.29,0:35:33.25,Default,,0,0,0,,Қош келдіңіз...
Dialogue: 0,0:35:33.84,0:35:34.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:35.92,0:35:37.76,Default,,0,0,0,,Бұл өте ақымақ
Dialogue: 0,0:35:38.22,0:35:40.80,Default,,0,0,0,,Менде ең маңыздысы болса да
Dialogue: 0,0:35:44.76,0:35:46.56,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:35:55.82,0:35:57.73,Default,,0,0,0,,Сіз не істеп жатырсыз...
Dialogue: 0,0:35:58.19,0:36:00.28,Default,,0,0,0,,Маған қоңырау шалғаныңызға рахмет.
Dialogue: 0,0:36:00.82,0:36:03.62,Default,,0,0,0,,Мен туралы ойласаңыз да...
Dialogue: 0,0:36:06.08,0:36:07.58,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:36:09.41,0:36:10.96,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:36:12.62,0:36:14.04,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:36:14.25,0:36:15.29,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:36:15.63,0:36:16.67,Default,,0,0,0,,Идиот! ақымақ!
Dialogue: 0,0:36:16.96,0:36:19.05,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:36:22.09,0:36:23.43,Default,,0,0,0,,Сіз ақымақ емессіз...
Dialogue: 0,0:36:23.64,0:36:24.85,Default,,0,0,0,,Өте тітіркендіргіш!
Dialogue: 0,0:36:24.97,0:36:26.56,Default,,0,0,0,,Шулы! (Өтіп бара жатқан адам) Міне!
Dialogue: 0,0:36:27.85,0:36:28.68,Default,,0,0,0,,Әй!
Dialogue: 0,0:36:29.14,0:36:30.43,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:36:31.69,0:36:33.81,Default,,0,0,0,,Шулы!
Dialogue: 0,0:36:34.23,0:36:36.19,Default,,0,0,0,,Эй... тоқтат.
Dialogue: 0,0:36:36.73,0:36:37.94,Default,,0,0,0,,Шулы!
Dialogue: 0,0:36:38.32,0:36:41.07,Default,,0,0,0,,[Жарықтың соғу дыбысы]
Dialogue: 0,0:36:41.24,0:36:43.57,Default,,0,0,0,,Тек Секара~!
Dialogue: 0,0:36:46.70,0:36:47.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:36:49.70,0:36:51.58,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:36:53.17,0:36:55.08,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:36:55.33,0:36:56.84,Default,,0,0,0,,Уау...
Dialogue: 0,0:36:57.09,0:36:57.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:03.72,0:37:04.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:06.26,0:37:09.68,Default,,0,0,0,,Жарықты өзім де жаға алмаймын...
Dialogue: 0,0:37:10.89,0:37:13.14,Default,,0,0,0,,Өмірімнің соңына дейін қараңғы болып қалады
Dialogue: 0,0:37:13.27,0:37:16.73,Default,,0,0,0,,Мен әрқашан қараңғылықта болдым
Dialogue: 0,0:37:18.36,0:37:19.69,Default,,0,0,0,,Қараңғы...
Dialogue: 0,0:37:19.90,0:37:20.73,Default,,0,0,0,,[шу]
Dialogue: 0,0:37:21.94,0:37:24.57,Default,,0,0,0,,Әйтеуір жасайық, топ
Dialogue: 0,0:37:24.70,0:37:26.24,Default,,0,0,0,,Не? Ха!
Dialogue: 0,0:37:26.57,0:37:29.83,Default,,0,0,0,,Момока-сан Субару-чан...
Dialogue: 0,0:37:30.08,0:37:32.45,Default,,0,0,0,,Кілттерді жасыратын орынды өзгертіңіз.
Dialogue: 0,0:37:32.58,0:37:34.50,Default,,0,0,0,,Жарық әлдеқашан жойылған.
Dialogue: 0,0:37:38.79,0:37:41.76,Default,,0,0,0,,Мен Нинаның ән айтатын даусын ұнатамын дедім.
Dialogue: 0,0:37:42.34,0:37:45.63,Default,,0,0,0,,Неге олай өтірік айтасың?
Dialogue: 0,0:37:46.09,0:37:47.47,Default,,0,0,0,,Бұл өтірік емес
Dialogue: 0,0:37:47.59,0:37:50.22,Default,,0,0,0,,Иілуді және заттарды қиындата беру
Dialogue: 0,0:37:50.35,0:37:53.98,Default,,0,0,0,,Бірақ бұл сіз өзіңізге өтірік айтпағаныңыз үшін, солай ма?
Dialogue: 0,0:37:54.10,0:37:58.27,Default,,0,0,0,,Әлсіз болсаң да, өзіңді еңкейткің келмейді, солай ма?
Dialogue: 0,0:37:59.82,0:38:02.82,Default,,0,0,0,,Міне, ұмытып кеткенім...
Dialogue: 0,0:38:02.94,0:38:06.57,Default,,0,0,0,,Мен сені сүйемін және сені мәңгілікке ұстағым келеді.
Dialogue: 0,0:38:06.74,0:38:07.99,Default,,0,0,0,,Менің...
Dialogue: 0,0:38:08.57,0:38:09.74,Default,,0,0,0,,Бұл ән
Dialogue: 0,0:38:16.50,0:38:17.96,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:38:18.42,0:38:20.67,Default,,0,0,0,,Маған бұл керек емес.
Dialogue: 0,0:38:21.55,0:38:24.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:38:24.72,0:38:26.63,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:38:26.76,0:38:28.93,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:38:29.64,0:38:30.68,Default,,0,0,0,,Мазасыз~
Dialogue: 0,0:38:30.80,0:38:31.93,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:38:32.47,0:38:33.72,Default,,0,0,0,,Ой!
Dialogue: 0,0:38:35.81,0:38:39.40,Default,,0,0,0,,Ештеңе етпейді, барлық қиындықты маған тастаңыз.
Dialogue: 0,0:38:39.94,0:38:41.06,Default,,0,0,0,,Әнге
Dialogue: 0,0:38:41.31,0:38:42.32,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:38:42.73,0:38:43.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:38:44.82,0:38:45.94,Default,,0,0,0,,Жарай бер, сол баланы оқпен тесіп өт!
Dialogue: 0,0:38:46.24,0:38:47.95,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:38:49.32,0:38:52.53,Default,,0,0,0,,[Ішу дыбысы]
Dialogue: 0,0:38:53.54,0:38:56.16,Default,,0,0,0,,Жарай бер, сол баланы оқпен тесіп өт!
Dialogue: 0,0:38:56.62,0:39:00.25,Default,,0,0,0,,[Барабан дыбысы]
Dialogue: 0,0:39:01.79,0:39:03.96,Default,,0,0,0,,Сәл жандырақ...
Dialogue: 0,0:39:04.09,0:39:05.26,Default,,0,0,0,,[Барабан дыбысы]
Dialogue: 0,0:39:05.38,0:39:06.63,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:39:07.26,0:39:09.72,Default,,0,0,0,,Бір минут күте тұр, күте тұр, күте тұр!
Dialogue: 0,0:39:09.84,0:39:12.72,Default,,0,0,0,,Сіз не істеп жатырсыз!? Сіз оқып жатырсыз! оқу!
Dialogue: 0,0:39:12.85,0:39:14.60,Default,,0,0,0,,[Барабан дыбысы]
Dialogue: 0,0:39:14.72,0:39:17.64,Default,,0,0,0,,Бірін-бірі қайталау дұрыс емес пе?
Dialogue: 0,0:39:17.98,0:39:18.81,Default,,0,0,0,,Иә
Dialogue: 0,0:39:18.94,0:39:23.69,Default,,0,0,0,,-ге келетін болсақ, менің ойымша, бұл жерде аздап тыныш болған дұрыс.
Dialogue: 0,0:39:24.11,0:39:27.61,Default,,0,0,0,,[Көгершіннің айқайы]
Dialogue: 0,0:39:27.74,0:39:31.24,Default,,0,0,0,,Дудду~ Дуду
Dialogue: 0,0:39:31.41,0:39:35.04,Default,,0,0,0,,Дудду~ Дуду
Dialogue: 0,0:39:35.20,0:39:38.04,Default,,0,0,0,,Дудду~ Дуду
Dialogue: 0,0:39:38.37,0:39:39.37,Default,,0,0,0,,Оқу!
Dialogue: 0,0:39:40.92,0:39:42.25,Default,,0,0,0,,Кешкі ас іштің бе?
Dialogue: 0,0:39:43.09,0:39:46.00,Default,,0,0,0,,Ах! Бұл жаман мінез.
Dialogue: 0,0:39:46.13,0:39:48.59,Default,,0,0,0,,Сіз жас ханымсыз, Нина.
Dialogue: 0,0:39:48.72,0:39:50.43,Default,,0,0,0,,Тұздық қосылған ет тоқаш...
Dialogue: 0,0:39:50.72,0:39:52.26,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:39:52.55,0:39:55.93,Default,,0,0,0,,Аа, менің мектебімдегі бір бала Чинатаунда толық емес жұмыс күнімен жұмыс істейтін.
Dialogue: 0,0:39:56.06,0:39:57.47,Default,,0,0,0,,Сізде артық болғандықтан
Dialogue: 0,0:39:57.60,0:39:58.89,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:39:59.06,0:40:00.19,Default,,0,0,0,,Ахм
Dialogue: 0,0:40:00.77,0:40:02.52,Default,,0,0,0,,Бұл ән...
Dialogue: 0,0:40:02.65,0:40:08.32,Default,,0,0,0,,♪ [Смартфоннан ойнатылатын музыка]
Dialogue: 0,0:40:09.15,0:40:13.32,Default,,0,0,0,,Егер есімде дұрыс болса, мен сізге бір апта бұрын қолданбаны қалай пайдалану керектігін үйреттім.
Dialogue: 0,0:40:13.45,0:40:15.78,Default,,0,0,0,,Ендеше мен осындай бірдеңе жасаймын~
Dialogue: 0,0:40:15.91,0:40:16.74,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:40:16.87,0:40:21.00,Default,,0,0,0,,Өйткені ноталарды оқи алмасаңыз да, тек сезім арқылы бірдеңе жасауға болады.
Dialogue: 0,0:40:21.12,0:40:23.67,Default,,0,0,0,,Момока солай айтқандықтан, әйтеуір...
Dialogue: 0,0:40:24.08,0:40:27.55,Default,,0,0,0,,Солай болса да, оның соншалықты егжей-тегжейлі болуы ...
Dialogue: 0,0:40:28.09,0:40:30.59,Default,,0,0,0,,Күн сайын 8 сағаттан артық жұмыс істедіңіз.
Dialogue: 0,0:40:30.72,0:40:31.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:32.43,0:40:33.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:34.18,0:40:35.01,Default,,0,0,0,,[Есіктің ашылған дыбысы]
Dialogue: 0,0:40:35.14,0:40:36.81,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:40:37.31,0:40:39.14,Default,,0,0,0,,Мен үйге бара жатырмын, иә?
Dialogue: 0,0:40:39.43,0:40:42.85,Default,,0,0,0,,Мен оқуым керек! Мен оқуым керек!
Dialogue: 0,0:40:43.23,0:40:44.27,Default,,0,0,0,,Бұл жұлдыз ба...
Dialogue: 0,0:40:45.31,0:40:48.69,Default,,0,0,0,,Мен бара алмаймын, себебі Момока-сан қажет емес нәрселерді үйретеді!
Dialogue: 0,0:40:48.82,0:40:50.74,Default,,0,0,0,,Мен сізге бұл емтиханыңызға әсер етпейтінін айттым!
Dialogue: 0,0:40:50.86,0:40:52.28,Default,,0,0,0,,Бұл хит.
Dialogue: 0,0:40:52.49,0:40:53.95,Default,,0,0,0,,Мен білемін...
Dialogue: 0,0:40:54.07,0:40:56.12,Default,,0,0,0,,Білмесең, айтпа.
Dialogue: 0,0:40:56.66,0:40:57.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:57.74,0:40:58.62,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:40:58.74,0:41:02.16,Default,,0,0,0,,Түсіндім, түсіндім, сені үйреткеніме менің кінәм болды.
Dialogue: 0,0:41:02.29,0:41:04.79,Default,,0,0,0,,Мен оны өшіремін, сондықтан Нина ән айтады.
Dialogue: 0,0:41:04.92,0:41:06.50,Default,,0,0,0,,Жоюдың қажеті жоқ
Dialogue: 0,0:41:06.63,0:41:07.63,Default,,0,0,0,,Бұл қайсысы!
Dialogue: 0,0:41:07.79,0:41:09.05,Default,,0,0,0,,Бұл менің кінәм!
Dialogue: 0,0:41:09.17,0:41:11.34,Default,,0,0,0,,Маған дұрыс ауысу керек.
Dialogue: 0,0:41:11.46,0:41:12.97,Default,,0,0,0,,Топты Момока-санға қалдырыңыз
Dialogue: 0,0:41:13.09,0:41:13.93,Default,,0,0,0,,... дұрыс па?
Dialogue: 0,0:41:14.05,0:41:15.64,Default,,0,0,0,,Кімге айттыңыз?
Dialogue: 0,0:41:16.43,0:41:17.80,Default,,0,0,0,,Маған!
Dialogue: 0,0:41:17.93,0:41:19.68,Default,,0,0,0,,Ал, мен келесі аптада қайтамын.
Dialogue: 0,0:41:19.89,0:41:22.27,Default,,0,0,0,,[Алдыңғы есіктің ашылуы мен жабылу дыбысы]
Dialogue: 0,0:41:22.39,0:41:23.69,Default,,0,0,0,,Нақты не?
Dialogue: 0,0:41:23.81,0:41:25.15,Default,,0,0,0,,Мен оны түсінбеймін.
Dialogue: 0,0:41:25.44,0:41:27.90,Default,,0,0,0,,А, онда мен де үйге қайтайын.
Dialogue: 0,0:41:28.73,0:41:30.78,Default,,0,0,0,,Сәлем! Әлі азғантай ет қалды.
Dialogue: 0,0:41:30.90,0:41:32.57,Default,,0,0,0,,Соның бәрін жеуге болады!
Dialogue: 0,0:41:32.69,0:41:35.24,Default,,0,0,0,,[Алдыңғы есіктің ашылуы мен жабылу дыбысы]
Dialogue: 0,0:41:35.70,0:41:37.32,Default,,0,0,0,,Вокзалға бірге барайық.
Dialogue: 0,0:41:37.62,0:41:39.70,Default,,0,0,0,,А... иә
Dialogue: 0,0:41:40.87,0:41:42.58,Default,,0,0,0,,Десе де, бұл таңқаларлық, солай емес пе?
Dialogue: 0,0:41:42.70,0:41:44.75,Default,,0,0,0,,Мен кенеттен ән жаза бастағаныма сене алар емеспін.
Dialogue: 0,0:41:44.87,0:41:46.83,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:41:46.96,0:41:49.09,Default,,0,0,0,,А... бұл жай ғана
Dialogue: 0,0:41:49.21,0:41:51.46,Default,,0,0,0,,Көріп, еліктеп көрейік...
Dialogue: 0,0:41:52.46,0:41:56.05,Default,,0,0,0,,Бірақ мен ән мәтінін ойлап таба алмадым деп ойлаймын.
Dialogue: 0,0:41:57.09,0:41:58.60,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:41:58.72,0:41:59.55,Default,,0,0,0,,Иә
Dialogue: 0,0:41:59.85,0:42:02.27,Default,,0,0,0,,Аха…
Dialogue: 0,0:42:04.60,0:42:06.02,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:42:06.14,0:42:08.56,Default,,0,0,0,,Мен дүкенге біраз тоқтаймын...
Dialogue: 0,0:42:08.69,0:42:10.82,Default,,0,0,0,,Не? Мен сенімен бірге шығамын
Dialogue: 0,0:42:11.07,0:42:12.44,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:42:12.57,0:42:15.61,Default,,0,0,0,,Сондықтан мен үйге жаяу барайын деп ойладым.
Dialogue: 0,0:42:15.74,0:42:16.57,Default,,0,0,0,,Хаха…
Dialogue: 0,0:42:16.91,0:42:17.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:42:18.16,0:42:19.70,Default,,0,0,0,,Иә, онда...
Dialogue: 0,0:42:23.62,0:42:25.54,Default,,0,0,0,,[Смартфонның діріл дыбысы]
Dialogue: 0,0:42:25.66,0:42:26.58,Default,,0,0,0,,Хмм
Dialogue: 0,0:42:27.54,0:42:30.38,Default,,0,0,0,,Мм!? [Үздіксіз діріл дыбысы]
Dialogue: 0,0:42:30.50,0:42:31.80,Default,,0,0,0,,Субарумо да!
Dialogue: 0,0:42:31.92,0:42:33.21,Default,,0,0,0,,Ня~
Dialogue: 0,0:42:33.38,0:42:36.59,Default,,0,0,0,,Өзіңіз баруыңыз керек емес пе?
Dialogue: 0,0:42:36.88,0:42:39.30,Default,,0,0,0,,Осыдан кейін байт ығысуы болады.
Dialogue: 0,0:42:39.43,0:42:40.26,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:42:40.39,0:42:42.64,Default,,0,0,0,,Бұл жаман емес, бірақ...
Dialogue: 0,0:42:42.85,0:42:45.14,Default,,0,0,0,,Ет тоқаш! (Нина) Ух...
Dialogue: 0,0:42:49.56,0:42:51.15,Default,,0,0,0,,Мұқият қарасаңыз, міне, [Ысырма дыбысы]
Dialogue: 0,0:42:51.40,0:42:53.78,Default,,0,0,0,,Шынайы ма? Ауылдың баласы.
Dialogue: 0,0:42:53.90,0:42:55.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:42:55.53,0:42:56.90,Default,,0,0,0,,Ал...
Dialogue: 0,0:42:57.53,0:42:58.78,Default,,0,0,0,,Ал...
Dialogue: 0,0:42:59.45,0:43:00.28,Default,,0,0,0,,Осылайша...
Dialogue: 0,0:43:00.82,0:43:02.03,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:43:02.37,0:43:03.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:06.12,0:43:07.16,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:43:07.91,0:43:09.92,Default,,0,0,0,,бір айдан да аз уақыт ішінде жойылып кетеді…
Dialogue: 0,0:43:10.38,0:43:11.71,Default,,0,0,0,,[Есікті автоматты түрде ашу дыбысы]
Dialogue: 0,0:43:11.96,0:43:13.71,Default,,0,0,0,,Әй, Субару
Dialogue: 0,0:43:14.09,0:43:16.72,Default,,0,0,0,,Иә, ол пьесаның ағымы жақсы.
Dialogue: 0,0:43:17.80,0:43:20.80,Default,,0,0,0,,Уау, Нина-чан! Не болды?
Dialogue: 0,0:43:20.93,0:43:21.85,Default,,0,0,0,,Уау...
Dialogue: 0,0:43:22.14,0:43:23.85,Default,,0,0,0,,Мичи Жақсы болды ма?
Dialogue: 0,0:43:23.97,0:43:26.85,Default,,0,0,0,,Егер сіз мектепке хабарлассаңыз, мен сізді алып кетуге келер едім.
Dialogue: 0,0:43:27.10,0:43:28.89,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:43:29.02,0:43:30.10,Default,,0,0,0,,Бұл…
Dialogue: 0,0:43:30.40,0:43:32.61,Default,,0,0,0,,Ах! Рақмет сізге!
Dialogue: 0,0:43:33.02,0:43:34.73,Default,,0,0,0,,Нені ұмыттыңыз?
Dialogue: 0,0:43:34.86,0:43:37.40,Default,,0,0,0,,Иә хаха... Мен абайсызда болдым~
Dialogue: 0,0:43:37.53,0:43:39.61,Default,,0,0,0,,Әй, сонда бәрі қоңырау шалып жатыр.
Dialogue: 0,0:43:39.90,0:43:41.74,Default,,0,0,0,,Жарайды, көріскенше!
Dialogue: 0,0:43:41.87,0:43:43.41,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:43:43.53,0:43:45.12,Default,,0,0,0,,Бұдан кейін әлі уақыт бар, солай емес пе?
Dialogue: 0,0:43:45.24,0:43:47.45,Default,,0,0,0,,Кешкі ас ішейік.
Dialogue: 0,0:43:47.62,0:43:48.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:49.04,0:43:52.75,Default,,0,0,0,,Менің оқуым керек...
Dialogue: 0,0:43:53.08,0:43:54.96,Default,,0,0,0,,көремін. Сонда демалыс күндері ше?
Dialogue: 0,0:43:55.09,0:43:56.34,Default,,0,0,0,,жексенбі т.б.
Dialogue: 0,0:43:56.46,0:43:59.38,Default,,0,0,0,,Аа... шынымен де бұл туралы уайымдамаңыз.
Dialogue: 0,0:43:59.72,0:44:01.38,Default,,0,0,0,,Айтпақшы...
Dialogue: 0,0:44:01.51,0:44:03.35,Default,,0,0,0,,Олай болса, кешіріңіз.
Dialogue: 0,0:44:05.64,0:44:07.02,Default,,0,0,0,,Тоқтауым керек пе?
Dialogue: 0,0:44:07.14,0:44:08.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:09.23,0:44:12.52,Default,,0,0,0,,Топтан шығуым керек пе? мен
Dialogue: 0,0:44:13.15,0:44:15.02,Default,,0,0,0,,Мен де ақымақ емеспін.
Dialogue: 0,0:44:15.15,0:44:17.73,Default,,0,0,0,,Мен сенен неге қашып жатқанын түсінемін.
Dialogue: 0,0:44:17.94,0:44:19.28,Default,,0,0,0,,Е... жоқ...
Dialogue: 0,0:44:19.40,0:44:21.99,Default,,0,0,0,,Мен сенің жолыңа бөгет болғым келмейді.
Dialogue: 0,0:44:22.11,0:44:23.74,Default,,0,0,0,,Басқа топтар да бар.
Dialogue: 0,0:44:23.99,0:44:25.41,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:44:25.53,0:44:27.79,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:44:27.91,0:44:29.12,Default,,0,0,0,,Тек...
Dialogue: 0,0:44:31.08,0:44:31.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:33.04,0:44:34.25,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:44:34.58,0:44:36.17,Default,,0,0,0,,Иә, бұл...
Dialogue: 0,0:44:36.29,0:44:38.34,Default,,0,0,0,,Кейінірек оқуға болады.
Dialogue: 0,0:44:38.46,0:44:40.22,Default,,0,0,0,,Бірінші кезекте еркіндік...
Dialogue: 0,0:44:40.34,0:44:42.26,Default,,0,0,0,,Сен емес, мен.
Dialogue: 0,0:44:43.68,0:44:46.89,Default,,0,0,0,,Мен де орта мектепте оқып жүрген кезімде үйірме жұмыстарымен айналыса бастадым.
Dialogue: 0,0:44:47.01,0:44:49.39,Default,,0,0,0,,Мен тым үлкен ештеңе айта алмаймын.
Dialogue: 0,0:44:49.72,0:44:50.64,Default,,0,0,0,,Топ дегеніміз не?
Dialogue: 0,0:44:50.77,0:44:53.23,Default,,0,0,0,,Өйткені бәріміз бір нәрсені жасауымыз керек
Dialogue: 0,0:44:53.35,0:44:55.44,Default,,0,0,0,,Бұл өте тығыз, солай емес пе?
Dialogue: 0,0:44:55.56,0:44:59.28,Default,,0,0,0,,Егер бізде пікір қайшылығы болса, оны жай қалдыра алмаймыз.
Dialogue: 0,0:44:59.65,0:45:01.90,Default,,0,0,0,,Беттік жөндеу туралы айтқанда
Dialogue: 0,0:45:02.45,0:45:04.57,Default,,0,0,0,,Біз әрқашан бір жерде бір-бірімізден өтеміз
Dialogue: 0,0:45:05.70,0:45:07.53,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:45:07.83,0:45:09.87,Default,,0,0,0,,Мұны істеуді доғарыңыз!
Dialogue: 0,0:45:10.45,0:45:12.33,Default,,0,0,0,,Адамдар сізді бәрібір жек көреді.
Dialogue: 0,0:45:12.46,0:45:13.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:13.42,0:45:16.13,Default,,0,0,0,,Жоқ! Бұл дұрыс емес! Бұл дұрыс емес!
Dialogue: 0,0:45:16.25,0:45:18.59,Default,,0,0,0,,Мен... арақашықтықты сақтаймын.
Dialogue: 0,0:45:18.71,0:45:21.67,Default,,0,0,0,,Сіз ұялшақ болғандықтан, адамдар сізге назар аударады, солай ма?
Dialogue: 0,0:45:21.80,0:45:23.93,Default,,0,0,0,,Не? Сізге бұл ұнамайды ма?
Dialogue: 0,0:45:24.22,0:45:25.55,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:45:25.68,0:45:29.06,Default,,0,0,0,,Адамдар маған тек тіл табысу үшін келгенде, қандай да бір себептермен...
Dialogue: 0,0:45:29.18,0:45:30.81,Default,,0,0,0,,Сіз қалағандай бола ма?
Dialogue: 0,0:45:30.93,0:45:32.93,Default,,0,0,0,,Бұл мен үшін оңай емес!
Dialogue: 0,0:45:33.06,0:45:34.81,Default,,0,0,0,,Мен кенеттен ойладым...
Dialogue: 0,0:45:34.94,0:45:37.23,Default,,0,0,0,,Уау... қандай қиыншылық
Dialogue: 0,0:45:37.36,0:45:40.19,Default,,0,0,0,,Сол себепті мектепті тастап кеттіңіз бе?
Dialogue: 0,0:45:40.65,0:45:42.44,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:45:42.57,0:45:43.49,Default,,0,0,0,,Цукуёми-кун мен Каэрубүки-санға қандай сынақтар қойылған?
Dialogue: 0,0:45:44.36,0:45:45.57,Default,,0,0,0,,Сіз мұны естідіңіз бе?
Dialogue: 0,0:45:46.11,0:45:47.20,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:45:47.95,0:45:50.87,Default,,0,0,0,,Жақсы, оны жоғарыдан айтуға болады.
Dialogue: 0,0:45:50.99,0:45:51.83,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:45:52.08,0:45:55.71,Default,,0,0,0,,Бұл сенсің! Сіз мені дұрыс түсінбейсіз!
Dialogue: 0,0:45:56.21,0:45:57.25,Default,,0,0,0,,Мен сізге айтып тұрмын.
Dialogue: 0,0:45:57.38,0:45:59.63,Default,,0,0,0,,Актер мектебіне барамын десең де
Dialogue: 0,0:45:59.75,0:46:02.46,Default,,0,0,0,,Менің отбасымда орта білім туралы аттестат жоқ.
Dialogue: 0,0:46:02.80,0:46:04.22,Default,,0,0,0,,Сізге ұқсас нәрсе
Dialogue: 0,0:46:04.76,0:46:06.97,Default,,0,0,0,,Бірақ! Сіз актер болуды мақсат етесіз бе?
Dialogue: 0,0:46:07.43,0:46:10.22,Default,,0,0,0,,Бұл сіздің армандарыңызды қуып бара жатқаныңызды білдірмейді ме?
Dialogue: 0,0:46:10.43,0:46:13.10,Default,,0,0,0,,Оны басқаларға мақтанышпен айта аласыз!
Dialogue: 0,0:46:13.39,0:46:15.48,Default,,0,0,0,,Сонда мен қате түсіндім дейсіз бе?
Dialogue: 0,0:46:15.81,0:46:16.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:17.94,0:46:19.23,Default,,0,0,0,,Сіз бұл адамды танисыз ба?
Dialogue: 0,0:46:20.11,0:46:22.23,Default,,0,0,0,,Мен мұны бұрын көргендей сезінемін...
Dialogue: 0,0:46:22.48,0:46:24.19,Default,,0,0,0,,«Детектив Обабаның істері»
Dialogue: 0,0:46:24.32,0:46:25.99,Default,,0,0,0,,Түсте қайта эфирге шығады, солай ма?
Dialogue: 0,0:46:26.36,0:46:27.20,Default,,0,0,0,,О
Dialogue: 0,0:46:27.32,0:46:29.24,Default,,0,0,0,,Бұл адам менің әжем.
Dialogue: 0,0:46:29.37,0:46:30.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:30.33,0:46:31.95,Default,,0,0,0,,Бұл өте қатты
Dialogue: 0,0:46:32.08,0:46:34.25,Default,,0,0,0,,«Субару менің орныма келеді».
Dialogue: 0,0:46:34.37,0:46:38.00,Default,,0,0,0,,«Мен саған актерлік мектебіне түсуге көмектесемін».
Dialogue: 0,0:46:38.54,0:46:40.79,Default,,0,0,0,,Сонымен, актерлер ше?
Dialogue: 0,0:46:40.92,0:46:43.00,Default,,0,0,0,,Мен ештеңені мақсат етіп отырған жоқпын.
Dialogue: 0,0:46:43.30,0:46:45.97,Default,,0,0,0,,Егер сіз мақсат етпесеңіз, не істеп жатырсыз?
Dialogue: 0,0:46:46.09,0:46:48.72,Default,,0,0,0,,Бірақ менің айналамдағы ешкім бұлай көрмеді.
Dialogue: 0,0:46:48.84,0:46:53.39,Default,,0,0,0,,Менің отбасымның себебінен бәрі мені бірдеңе мақсат етіп отыр деп ойлайды...
Dialogue: 0,0:46:53.52,0:46:54.77,Default,,0,0,0,,Сонымен топ ше?
Dialogue: 0,0:46:54.97,0:46:57.23,Default,,0,0,0,,Қарапайым қарсылық дегеніміз не?
Dialogue: 0,0:46:57.35,0:47:01.27,Default,,0,0,0,,Мен орта мектепте оқып жүргенде драма үйірмесіне қатысқым келмеді.
Dialogue: 0,0:47:01.61,0:47:04.73,Default,,0,0,0,,Осылайша мен жеңіл музыка үйірмесіне қосылдым, өйткені мен топтар ұнайды.
Dialogue: 0,0:47:04.86,0:47:06.78,Default,,0,0,0,,Мен оны сынап көрдім және таңқаларлық қызықты деп таптым.
Dialogue: 0,0:47:07.07,0:47:09.78,Default,,0,0,0,,Жасырын топ құрған кезіміз болды.
Dialogue: 0,0:47:10.11,0:47:11.87,Default,,0,0,0,,Сенің әжең білмей ме?
Dialogue: 0,0:47:11.99,0:47:13.33,Default,,0,0,0,,Олай деуге болмайды.
Dialogue: 0,0:47:13.45,0:47:15.75,Default,,0,0,0,,Иә, сіз Хачиконы көрдіңіз бе?
Dialogue: 0,0:47:16.04,0:47:17.96,Default,,0,0,0,,Мені ауылданмын деп ойламайсың ба?
Dialogue: 0,0:47:18.08,0:47:20.12,Default,,0,0,0,,Ештеңе етпейді, мен ауыл адамымын.
Dialogue: 0,0:47:20.46,0:47:22.50,Default,,0,0,0,,Енді сөйлесіп болған соң мен сені менімен бірге шығуды өтінемін.
Dialogue: 0,0:47:22.63,0:47:24.17,Default,,0,0,0,,Ах... [Ысырма дыбысы]
Dialogue: 0,0:47:24.30,0:47:27.30,Default,,0,0,0,,Бүгіннен бастап сен Нинасың, Конояро!
Dialogue: 0,0:47:28.59,0:47:30.47,Default,,0,0,0,,Көшеде тірі ме? (Момока) Иә.
Dialogue: 0,0:47:31.72,0:47:35.72,Default,,0,0,0,,Алдымен сіз бейне түсіру және жүктеп салу туралы айттыңыз, солай емес пе?
Dialogue: 0,0:47:36.02,0:47:37.68,Default,,0,0,0,,Әрине, мен де солай істеймін.
Dialogue: 0,0:47:37.81,0:47:38.77,Default,,0,0,0,,Бірақ
Dialogue: 0,0:47:38.89,0:47:43.11,Default,,0,0,0,,Бұл жанды орындау сияқты, солай емес пе? Осы үш адам.
Dialogue: 0,0:47:43.40,0:47:46.57,Default,,0,0,0,,Бірақ сіз басссыз жанды орындауды жасай аласыз ба?
Dialogue: 0,0:47:46.78,0:47:48.61,Default,,0,0,0,,Нина аспапта ойнай алмайды, солай ма?
Dialogue: 0,0:47:48.90,0:47:50.53,Default,,0,0,0,,Бұл әуесқой іс-шара.
Dialogue: 0,0:47:50.66,0:47:52.24,Default,,0,0,0,,Теру арқылы бірдеңе жасаңыз
Dialogue: 0,0:47:52.37,0:47:54.49,Default,,0,0,0,,Бұл да бар...
Dialogue: 0,0:47:54.87,0:47:56.70,Default,,0,0,0,,Бұл не? (Момока) Ілмекті машина
Dialogue: 0,0:47:56.83,0:47:57.66,Default,,0,0,0,,[Түйменің басу дыбысы]
Dialogue: 0,0:47:57.79,0:47:59.96,Default,,0,0,0,,[Гитара орындауы] (Момока) Дыбысты осылай қосыңыз...
Dialogue: 0,0:48:00.08,0:48:05.80,Default,,0,0,0,,[Орындалу жалғасуда]
Dialogue: 0,0:48:05.92,0:48:06.75,Default,,0,0,0,,[Түйменің басу дыбысы]
Dialogue: 0,0:48:07.01,0:48:09.42,Default,,0,0,0,,[Циклдік машинадан әуен ойнайды] (Момока) Иә?
Dialogue: 0,0:48:09.55,0:48:10.88,Default,,0,0,0,,Я~
Dialogue: 0,0:48:11.01,0:48:14.39,Default,,0,0,0,,Мүмкін сол көшеде тұратын шығар...
Dialogue: 0,0:48:14.68,0:48:16.89,Default,,0,0,0,,Көпшілік алдында ән айтуды айтасыз ба?
Dialogue: 0,0:48:17.35,0:48:18.27,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:48:18.52,0:48:20.52,Default,,0,0,0,,Мен үйге бара жатырмын [Алдыңғы есікті ашқан дыбыс]
Dialogue: 0,0:48:20.85,0:48:22.19,Default,,0,0,0,,Қалағаныңды істе.
Dialogue: 0,0:48:22.31,0:48:24.40,Default,,0,0,0,,Жібер! Мен оны естіген жоқпын!
Dialogue: 0,0:48:24.69,0:48:25.65,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:48:25.77,0:48:27.53,Default,,0,0,0,,Сен кеше вокзал алдында ән айттың!
Dialogue: 0,0:48:27.65,0:48:28.94,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:48:29.07,0:48:31.20,Default,,0,0,0,,Бұлай жұмыс істемейді!
Dialogue: 0,0:48:31.32,0:48:33.66,Default,,0,0,0,,Менің тәжірибем жоқ!
Dialogue: 0,0:48:33.91,0:48:36.66,Default,,0,0,0,,Ән айтсаң түсінерсің, сенемін маған
Dialogue: 0,0:48:41.75,0:48:42.75,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:48:42.87,0:48:44.83,Default,,0,0,0,,Сонымен топтан шыққаным дұрыс па?
Dialogue: 0,0:48:44.96,0:48:45.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:46.04,0:48:48.30,Default,,0,0,0,,Иә, рахмет!
Dialogue: 0,0:48:48.59,0:48:51.01,Default,,0,0,0,,[Алдыңғы есік жабылған дыбыс]
Dialogue: 0,0:48:51.59,0:48:52.59,Default,,0,0,0,,Эй...
Dialogue: 0,0:48:53.30,0:48:54.64,Default,,0,0,0,,Жарайды
Dialogue: 0,0:48:58.10,0:49:00.10,Default,,0,0,0,,[Алдыңғы есіктің ашылған дыбысы]
Dialogue: 0,0:49:00.68,0:49:03.39,Default,,0,0,0,,Бұл алдау! Топты кепілге алу үшін!
Dialogue: 0,0:49:03.69,0:49:05.15,Default,,0,0,0,,Теория бұзылды.
Dialogue: 0,0:49:05.27,0:49:06.56,Default,,0,0,0,,Өйткені мен!
Dialogue: 0,0:49:06.69,0:49:07.77,Default,,0,0,0,,Ашуланбаңыз!
Dialogue: 0,0:49:08.02,0:49:11.44,Default,,0,0,0,,Жақсы жүре ме, жоқ па, сәтті ме, жоқ па
Dialogue: 0,0:49:11.57,0:49:13.66,Default,,0,0,0,,Қалай болғанда да өкінесіз.
Dialogue: 0,0:49:13.78,0:49:15.53,Default,,0,0,0,,Өйткені менде сондай мінез бар.
Dialogue: 0,0:49:15.78,0:49:16.66,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:49:16.78,0:49:18.03,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:49:18.33,0:49:20.04,Default,,0,0,0,,Иә, Нина жеңіледі~
Dialogue: 0,0:49:20.16,0:49:21.45,Default,,0,0,0,,Субару-чан, үндеме!
Dialogue: 0,0:49:21.75,0:49:23.75,Default,,0,0,0,,Ашуыңызды әнге айналдырыңыз!
Dialogue: 0,0:49:24.37,0:49:26.46,Default,,0,0,0,,Бұл сіздің шынайы сезімдеріңіз.
Dialogue: 0,0:49:30.51,0:49:34.97,Default,,0,0,0,,[Барабан өнімділігі]
Dialogue: 0,0:49:35.09,0:49:36.72,Default,,0,0,0,,Уау...
Dialogue: 0,0:49:39.26,0:49:40.85,Default,,0,0,0,,Иә, бұл жақсы емес пе?
Dialogue: 0,0:49:40.97,0:49:43.18,Default,,0,0,0,,Ендеше бір рет ән айтайық (Нина)?
Dialogue: 0,0:49:43.52,0:49:45.69,Default,,0,0,0,,Оның осылай болатынын елестетпедің бе?
Dialogue: 0,0:49:45.81,0:49:46.69,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:49:46.94,0:49:47.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:50.02,0:49:54.32,Default,,0,0,0,,♪Ааааааааааааааааа
Dialogue: 0,0:49:57.74,0:49:58.62,Default,,0,0,0,,Кохон…
Dialogue: 0,0:49:59.41,0:50:03.75,Default,,0,0,0,,♪Ааааааааааа
Dialogue: 0,0:50:04.41,0:50:05.54,Default,,0,0,0,,Баяу
Dialogue: 0,0:50:05.83,0:50:10.21,Default,,0,0,0,,♪А-а-а-а-а
Dialogue: 0,0:50:10.84,0:50:11.96,Default,,0,0,0,,♪Ах
Dialogue: 0,0:50:12.17,0:50:13.30,Default,,0,0,0,,[Гитара орындауы]
Dialogue: 0,0:50:13.42,0:50:14.97,Default,,0,0,0,,[Барабандар қосылды]
Dialogue: 0,0:50:22.35,0:50:23.77,Default,,0,0,0,,[Ойын тоқтатылады]
Dialogue: 0,0:50:24.23,0:50:25.48,Default,,0,0,0,,Бір екі үш төрт
Dialogue: 0,0:50:25.69,0:50:34.69,Default,,0,0,0,,♪Аа ааа [гитара мен барабанның орындалуы]
Dialogue: 0,0:50:35.36,0:50:36.20,Default,,0,0,0,,[Орындау аяқталады]
Dialogue: 0,0:50:38.36,0:50:39.53,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:50:39.78,0:50:40.62,Default,,0,0,0,,Хехе
Dialogue: 0,0:50:41.16,0:50:42.41,Default,,0,0,0,,Не болды?
Dialogue: 0,0:50:42.54,0:50:45.83,Default,,0,0,0,,Жоқ, мен бұл қайтадан жақсы дауыс деп ойладым.
Dialogue: 0,0:50:45.96,0:50:47.29,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:50:47.42,0:50:49.54,Default,,0,0,0,,А-а, менің де қарным ашылды.
Dialogue: 0,0:50:49.67,0:50:51.13,Default,,0,0,0,,Енді ән айтайық!
Dialogue: 0,0:50:51.63,0:50:52.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:50:53.80,0:50:55.34,Default,,0,0,0,,орташа және алдымен сыра
Dialogue: 0,0:50:55.47,0:50:56.88,Default,,0,0,0,,Жасыл пиязсыз орташа
Dialogue: 0,0:50:57.01,0:50:57.93,Default,,0,0,0,,Орташа
Dialogue: 0,0:50:58.30,0:50:59.14,Default,,0,0,0,,Менің тамырларым жарылып кетеді?
Dialogue: 0,0:50:59.26,0:51:01.18,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:51:01.51,0:51:02.68,Default,,0,0,0,,Күйген алкоголь!
Dialogue: 0,0:51:02.97,0:51:05.93,Default,,0,0,0,,Екі адам шын жүректен ән айт деді.
Dialogue: 0,0:51:06.27,0:51:08.77,Default,,0,0,0,,Ертең қалыпты жағдайға оралатын шығар.
Dialogue: 0,0:51:08.90,0:51:10.56,Default,,0,0,0,,Тамағыңызды күтіңіз.
Dialogue: 0,0:51:10.69,0:51:12.19,Default,,0,0,0,,Үш бөлік?
Dialogue: 0,0:51:13.36,0:51:14.94,Default,,0,0,0,,Мен гитара қорабын көрдім, сондықтан
Dialogue: 0,0:51:17.40,0:51:18.95,Default,,0,0,0,,Сізге ұнаса келіңіз.
Dialogue: 0,0:51:20.45,0:51:21.91,Default,,0,0,0,,Рахмет
Dialogue: 0,0:51:23.99,0:51:24.95,Default,,0,0,0,,...Сонымен...
Dialogue: 0,0:51:25.66,0:51:26.50,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:51:26.75,0:51:30.12,Default,,0,0,0,,Саған да өзіміздікі бере аламын ба?
Dialogue: 0,0:51:31.17,0:51:32.96,Default,,0,0,0,,Тікелей қойылымды көргеннен кейін
Dialogue: 0,0:51:33.29,0:51:34.88,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:51:35.00,0:51:36.55,Default,,0,0,0,,Онда мен барамын.
Dialogue: 0,0:51:36.67,0:51:38.01,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,0:51:38.13,0:51:38.97,Default,,0,0,0,,Байт
Dialogue: 0,0:51:39.63,0:51:40.51,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:51:50.06,0:51:52.06,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:51:52.86,0:51:56.07,Default,,0,0,0,,Ол Момока тобының бұрынғы мүшесі, солай ма?
Dialogue: 0,0:51:59.36,0:52:01.57,Default,,0,0,0,,Мен не киюім керек?
Dialogue: 0,0:52:01.86,0:52:03.91,Default,,0,0,0,,Көше тікелей эфирде...
Dialogue: 0,0:52:04.70,0:52:06.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:52:06.20,0:52:07.41,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:52:07.75,0:52:09.75,Default,,0,0,0,,Шин-Кавасаки!?
Dialogue: 0,0:52:10.00,0:52:12.83,Default,,0,0,0,,Бұдан кейін жиналыс бар! Топтың атауына қатысты
Dialogue: 0,0:52:12.96,0:52:15.25,Default,,0,0,0,,Демек, сіз бұл уақытша деп айтасыз.
Dialogue: 0,0:52:15.55,0:52:17.26,Default,,0,0,0,,Кешіктіргеніміз үшін кешіріңіз
Dialogue: 0,0:52:20.30,0:52:21.88,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:52:22.43,0:52:24.55,Default,,0,0,0,,Сонымен, сіз сахнаға шығуды жоспарлап отырсыз ба?
Dialogue: 0,0:52:24.68,0:52:26.39,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:52:26.68,0:52:29.39,Default,,0,0,0,,Мен саған айттым ба? Толығымен жалаңаш болыңыз
Dialogue: 0,0:52:30.52,0:52:31.81,Default,,0,0,0,,Барып, ауыстырыңыз.
Dialogue: 0,0:52:33.19,0:52:35.86,Default,,0,0,0,,Ah Іскерлік байланыс Іскерлік байланыс
Dialogue: 0,0:52:35.98,0:52:38.99,Default,,0,0,0,,Мен Нина мүлдем жек көретін костюмді кигенім дұрыс деп ойладым.
Dialogue: 0,0:52:39.44,0:52:41.03,Default,,0,0,0,,Көп ойланбаңыз
Dialogue: 0,0:52:41.15,0:52:44.99,Default,,0,0,0,,Өзіңіздің шынымен не ойлайтыныңызды ғана айтыңыз, тек сезіміңізді білдіріңіз
Dialogue: 0,0:52:45.37,0:52:47.99,Default,,0,0,0,,Уайымдамаңыз, мен кепілдік беремін.
Dialogue: 0,0:52:48.33,0:52:50.50,Default,,0,0,0,,Нина әлсіз болса да, қыңыр.
Dialogue: 0,0:52:50.75,0:52:52.75,Default,,0,0,0,,Қорқақ, бірақ сенімді
Dialogue: 0,0:52:53.21,0:52:56.00,Default,,0,0,0,,Өзіне-өзі қарама-қайшы комплекстер массасы...
Dialogue: 0,0:52:56.25,0:52:57.50,Default,,0,0,0,,Мен бақытты емеспін!
Dialogue: 0,0:52:57.63,0:52:58.63,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:52:58.75,0:53:01.26,Default,,0,0,0,,Нина, кететін уақыт болды.
Dialogue: 0,0:53:02.30,0:53:05.76,Default,,0,0,0,,Міне, Нинаның күйзеліске ұшырауы және оның энергиясы күшейе түсуі.
Dialogue: 0,0:53:05.89,0:53:07.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:53:07.72,0:53:09.89,Default,,0,0,0,,Бұл сөзсіз рок.
Dialogue: 0,0:53:10.02,0:53:11.64,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:53:12.56,0:53:13.39,Default,,0,0,0,,Құлыптау?
Dialogue: 0,0:53:13.52,0:53:21.15,Default,,0,0,0,,[Гитара мен барабан дыбыстары]
Dialogue: 0,0:53:23.70,0:53:27.16,Default,,0,0,0,,Сізді ешкім танымайды және сізді ешкім күтпейді.
Dialogue: 0,0:53:27.83,0:53:30.45,Default,,0,0,0,,Бірақ қызық осы емес пе?
Dialogue: 0,0:53:33.96,0:53:38.38,Default,,0,0,0,,♪Ааааааааа
Dialogue: 0,0:53:38.59,0:53:40.21,Default,,0,0,0,,(аудитория айқайлауы)
Dialogue: 0,0:53:41.34,0:53:44.55,Default,,0,0,0,,Ах! !
Dialogue: 0,0:53:49.56,0:53:52.39,Default,,0,0,0,,Нина - рок-н-ролл
Dialogue: 0,0:53:54.48,0:53:56.31,Default,,0,0,0,,[Барабан дыбысы]
Dialogue: 0,0:53:56.44,0:53:59.27,Default,,0,0,0,,«Дауыссыз балық» ♪Қанша күтсем де, ештеңе өзгермесе
Dialogue: 0,0:53:59.40,0:54:01.61,Default,,0,0,0,,♪Сізді ешкім де, бұл жігіт те пайдаланбайды.
Dialogue: 0,0:54:01.73,0:54:04.24,Default,,0,0,0,,♪Біріншіден біреу кінәлі десең де
Dialogue: 0,0:54:04.36,0:54:06.28,Default,,0,0,0,,♪Бұл ауырсыну кетпейді
Dialogue: 0,0:54:06.57,0:54:09.83,Default,,0,0,0,,♪Күнде мен тіземді ұстап еңкейемін
Dialogue: 0,0:54:09.95,0:54:11.62,Default,,0,0,0,,♪Қоштассам ғой
Dialogue: 0,0:54:11.74,0:54:15.87,Default,,0,0,0,,♪Мен Құдайға мүлде сенбесем де
Dialogue: 0,0:54:16.21,0:54:19.42,Default,,0,0,0,,♪Ол шулы
Dialogue: 0,0:54:21.21,0:54:23.88,Default,,0,0,0,,♪Мені жалғыз қалдырыңызшы
Dialogue: 0,0:54:26.84,0:54:29.26,Default,,0,0,0,,♪Танымайтын біреу маған жалғыз емес екенімді айтады
Dialogue: 0,0:54:29.39,0:54:31.56,Default,,0,0,0,,♪Қырылдап ән айту
Dialogue: 0,0:54:31.89,0:54:35.77,Default,,0,0,0,,♪Осындай сөздер арқылы кейбір адамдардың өмірін сақтап қалуға болады.
Dialogue: 0,0:54:36.14,0:54:39.15,Default,,0,0,0,,♪Білмеймін, дұрыс.
Dialogue: 0,0:54:39.27,0:54:41.23,Default,,0,0,0,,♪Солай ма? Мен ұмыттым
Dialogue: 0,0:54:41.73,0:54:44.11,Default,,0,0,0,,♪Мазасыз, мен оны жойғым келеді
Dialogue: 0,0:54:44.24,0:54:45.74,Default,,0,0,0,,♪Менде батылдық жоқ
Dialogue: 0,0:54:46.24,0:54:49.16,Default,,0,0,0,,♪Өмір сүру себебі
Dialogue: 0,0:54:49.28,0:54:51.70,Default,,0,0,0,,♪ Біреу маған тез айтшы
Dialogue: 0,0:54:51.83,0:54:53.45,Default,,0,0,0,,♪Ешқандай алмастырғыш жоқ
Dialogue: 0,0:54:53.58,0:54:55.91,Default,,0,0,0,,♪Ол қалағаныңызша айналады
Dialogue: 0,0:54:56.04,0:54:57.87,Default,,0,0,0,,♪Өзің бол
Dialogue: 0,0:54:58.00,0:55:01.25,Default,,0,0,0,,♪Оншалықты оңай айтпайсың.
Dialogue: 0,0:55:01.42,0:55:04.21,Default,,0,0,0,,♪Егер ол орындалса, оны қайтарыңыз
Dialogue: 0,0:55:04.34,0:55:06.51,Default,,0,0,0,,♪Арманға толы екені рас
Dialogue: 0,0:55:06.63,0:55:09.39,Default,,0,0,0,,♪Эй, мұнда біреу бар ма?
Dialogue: 0,0:55:18.81,0:55:20.23,Default,,0,0,0,,～♪
Dialogue: 0,0:55:20.35,0:55:23.44,Default,,0,0,0,,(қолдау мен қол шапалақтау)
Dialogue: 0,0:55:23.57,0:55:24.40,Default,,0,0,0,,Физика шекараларын да бағындыратын күш—
Dialogue: 0,0:55:24.53,0:55:26.40,Default,,0,0,0,,Хаха...
Dialogue: 0,0:55:26.74,0:55:28.49,Default,,0,0,0,,Хаха...
Dialogue: 0,0:55:28.61,0:55:31.41,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:55:32.91,0:55:34.20,Default,,0,0,0,,Бұл құлып.
Dialogue: 0,0:55:37.29,0:55:40.29,Default,,0,0,0,,♪ [Бөлмеден музыка естіледі]
Dialogue: 0,0:55:41.21,0:55:42.67,Default,,0,0,0,,Иә Иә Тоқта
Dialogue: 0,0:55:43.17,0:55:45.59,Default,,0,0,0,,Иә, қызықсыз екені анық.
Dialogue: 0,0:55:45.71,0:55:48.09,Default,,0,0,0,,Сонымен қатар барабандарды қайта жазып алайық.
Dialogue: 0,0:55:48.22,0:55:49.84,Default,,0,0,0,,Енді бастайық па?
Dialogue: 0,0:55:50.30,0:55:52.68,Default,,0,0,0,,Мен ертең ертемін.
Dialogue: 0,0:55:53.72,0:55:55.26,Default,,0,0,0,,Алмаз шаңы?
Dialogue: 0,0:55:55.47,0:55:59.52,Default,,0,0,0,,Иә, мен іздедім. Мен мұны бәрінен бұрын түсінемін.
Dialogue: 0,0:55:59.64,0:56:04.19,Default,,0,0,0,,Егер сіз бұл мәселеге байыппен қарасаңыз, сіз бұл екі әуесқоймен бірге болмас едіңіз.
Dialogue: 0,0:56:05.11,0:56:06.15,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:56:07.32,0:56:08.82,Default,,0,0,0,,[Смартфонның хабарландыру дыбысы] (Nina/Субару) Иә?
Dialogue: 0,0:56:10.36,0:56:12.57,Default,,0,0,0,,Иә? Өтірік...
Dialogue: 0,0:56:12.70,0:56:14.03,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:56:14.37,0:56:15.33,Default,,0,0,0,,Не болды?
Dialogue: 0,0:56:15.45,0:56:17.95,Default,,0,0,0,,Кешіріңіз, мен бүгін үйге барамын! (Нина) Иә?
Dialogue: 0,0:56:18.58,0:56:21.58,Default,,0,0,0,,Оқылған деп белгілемейді (Момока) Бұл еркек пе...
Dialogue: 0,0:56:21.71,0:56:22.58,Default,,0,0,0,,Не?!
Dialogue: 0,0:56:22.88,0:56:25.38,Default,,0,0,0,,Ешқандай белгі болған жоқ.
Dialogue: 0,0:56:25.50,0:56:27.96,Default,,0,0,0,,Ажырасқаннан кейін қайта қосылғыңыз келе ме?
Dialogue: 0,0:56:28.09,0:56:29.84,Default,,0,0,0,,Қазірдің өзінде! Сен не туралы айтып тұрсың?
Dialogue: 0,0:56:29.97,0:56:32.09,Default,,0,0,0,,Неге сонша ренжідің?
Dialogue: 0,0:56:32.22,0:56:36.35,Default,,0,0,0,,Махаббат пен жартылай ауысым үшін еркіндік жеткілікті емес пе?
Dialogue: 0,0:56:36.93,0:56:39.43,Default,,0,0,0,,Момока-сан, сен қалай ойлайсың?
Dialogue: 0,0:56:39.60,0:56:40.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:41.19,0:56:43.31,Default,,0,0,0,,Ағымдағы алмаз шаңы…
Dialogue: 0,0:56:43.44,0:56:46.15,Default,,0,0,0,,Менің оларға деген өшім жоқ.
Dialogue: 0,0:56:46.32,0:56:49.90,Default,,0,0,0,,Дайдас қазір жақсы сатады деп үміттенемін.
Dialogue: 0,0:56:50.36,0:56:52.66,Default,,0,0,0,,Онда неге тоқтадың?
Dialogue: 0,0:56:53.86,0:56:55.91,Default,,0,0,0,,[Гитара орындауы]
Dialogue: 0,0:56:56.28,0:56:58.04,Default,,0,0,0,,Жарайды, бұл оқиға.
Dialogue: 0,0:56:58.16,0:57:01.83,Default,,0,0,0,,Қажетсіз нәрселерге алаңдамаңыз, ән айтыңыз
Dialogue: 0,0:57:06.42,0:57:08.67,Default,,0,0,0,,Момока-сан, бұл қандай топ болды?
Dialogue: 0,0:57:09.51,0:57:10.51,Default,,0,0,0,,Я...
Dialogue: 0,0:57:13.18,0:57:14.09,Default,,0,0,0,,[Есіктің ашылған дыбысы]
Dialogue: 0,0:57:14.22,0:57:15.05,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:57:15.18,0:57:16.93,Default,,0,0,0,,Уау! иә?
Dialogue: 0,0:57:17.10,0:57:19.18,Default,,0,0,0,,Бастапқыда орта мектептің жеңіл музыка клубы
Dialogue: 0,0:57:19.39,0:57:23.19,Default,,0,0,0,,Бірақ басынан бастап бәрі жақсы, құмар болды.
Dialogue: 0,0:57:23.69,0:57:27.15,Default,,0,0,0,,«Кәсіби маман болуды мақсат етейік» және «Мен шығу жолымды кесемін» сондықтан мен мектепті тастадым.
Dialogue: 0,0:57:27.27,0:57:32.44,Default,,0,0,0,,Мұнда келіңіз, инди-дискіде тікелей эфирде, магистратураға баруға жақын!
Dialogue: 0,0:57:32.70,0:57:34.95,Default,,0,0,0,,Мен кеткен себебім...
Dialogue: 0,0:57:37.07,0:57:38.24,Default,,0,0,0,,Момока-сан...
Dialogue: 0,0:57:39.54,0:57:41.75,Default,,0,0,0,,Сіз осылай күлесіз.
Dialogue: 0,0:57:47.46,0:57:49.21,Default,,0,0,0,,Драма түсірілімі!?
Dialogue: 0,0:57:49.34,0:57:52.17,Default,,0,0,0,,Қалай! Микрофон арқылы сөйлеспеңіз!
Dialogue: 0,0:57:52.30,0:57:55.43,Default,,0,0,0,,Амал жоқ, бұл әжеңнің шешімі.
Dialogue: 0,0:57:55.55,0:57:59.60,Default,,0,0,0,,Драма болса да, біраз бөлігі, сондықтан бір аптадан кейін бітеді деп ойлаймын.
Dialogue: 0,0:57:59.72,0:58:01.22,Default,,0,0,0,,Сол уақыт ішінде жаттығу жасау мүмкін емес.
Dialogue: 0,0:58:01.43,0:58:03.23,Default,,0,0,0,,Жарайды (Нина) Жарайды ма?
Dialogue: 0,0:58:03.52,0:58:07.40,Default,,0,0,0,,Қайтып келемін дейсіз ғой, енді маған сеніңіз!
Dialogue: 0,0:58:07.52,0:58:08.52,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:58:08.69,0:58:09.61,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:58:09.73,0:58:12.74,Default,,0,0,0,,Мен адамдардың қол тигізгенін қаламайтын кейбір жағдайлар бар.
Dialogue: 0,0:58:13.32,0:58:14.15,Default,,0,0,0,,Тіпті сен де
Dialogue: 0,0:58:14.28,0:58:16.74,Default,,0,0,0,,Сізден мұнда не үшін келгеніңізді сұрағыңыз келмейді, солай ма?
Dialogue: 0,0:58:16.86,0:58:19.07,Default,,0,0,0,,Бұл... (Момока) Бұл бос уақыт.
Dialogue: 0,0:58:19.20,0:58:21.62,Default,,0,0,0,,Бүгін мен тек Субару бөлігін қайта жазып аламын.
Dialogue: 0,0:58:21.74,0:58:23.33,Default,,0,0,0,,Нина үйіне бара алады.
Dialogue: 0,0:58:25.58,0:58:28.17,Default,,0,0,0,,Ертең уақыт жоқ па? (Нина) Жоқ!
Dialogue: 0,0:58:28.79,0:58:30.21,Default,,0,0,0,,Өтірік! бол!
Dialogue: 0,0:58:31.30,0:58:32.34,Default,,0,0,0,,[Лифттің келу дыбысы]
Dialogue: 0,0:58:33.01,0:58:35.63,Default,,0,0,0,,Уау... керемет
Dialogue: 0,0:58:36.84,0:58:39.60,Default,,0,0,0,,Мен тез жалықтым. Мен шай іше аламын ба?
Dialogue: 0,0:58:39.72,0:58:40.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:58:41.31,0:58:43.22,Default,,0,0,0,,Сіз қалаған жерде отыра аласыз ба?
Dialogue: 0,0:58:43.35,0:58:44.48,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:58:45.31,0:58:46.60,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:58:49.44,0:58:52.98,Default,,0,0,0,,Дұрыс сөйлемесең, қайтадан ашулануың мүмкін.
Dialogue: 0,0:58:56.65,0:58:57.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:57.61,0:59:00.57,Default,,0,0,0,,Мен өз атымды осы тақырыптан алдым.
Dialogue: 0,0:59:00.99,0:59:03.74,Default,,0,0,0,,Бұл адам...
Dialogue: 0,0:59:03.99,0:59:04.95,Default,,0,0,0,,Иә
Dialogue: 0,0:59:05.08,0:59:08.37,Default,,0,0,0,,Жас кезімде бұл фильм мені бірден танымал етті.
Dialogue: 0,0:59:08.50,0:59:11.59,Default,,0,0,0,,Мен туылған жоқпын, сондықтан ол туралы ештеңе білмеймін.
Dialogue: 0,0:59:12.38,0:59:13.80,Default,,0,0,0,,Хмм…
Dialogue: 0,0:59:14.34,0:59:16.67,Default,,0,0,0,,Сондықтан да берекелі есім...
Dialogue: 0,0:59:17.42,0:59:19.13,Default,,0,0,0,,Егер сіз актер болғыңыз келсе.
Dialogue: 0,0:59:20.80,0:59:22.89,Default,,0,0,0,,Бірақ бұл сізге ұнамайды, солай ма?
Dialogue: 0,0:59:23.01,0:59:24.01,Default,,0,0,0,,Бұл Майюри ме?
Dialogue: 0,0:59:24.14,0:59:28.06,Default,,0,0,0,,Әжемнің жеті шырағы үшін қайда барсам да мені ерекше көргім келмейді.
Dialogue: 0,0:59:28.19,0:59:30.44,Default,,0,0,0,,Біріншіден, мен актерлік өнерді ұнатпаймын.
Dialogue: 0,0:59:30.56,0:59:31.69,Default,,0,0,0,,Ұят
Dialogue: 0,0:59:34.53,0:59:35.61,Default,,0,0,0,,Тек...
Dialogue: 0,0:59:36.19,0:59:39.86,Default,,0,0,0,,«Мен соны мақсат етіп отырмын» десем, күлесің.
Dialogue: 0,0:59:40.28,0:59:43.24,Default,,0,0,0,,Сіз шынымен күлетін жалғыз уақыт, солай емес пе?
Dialogue: 0,0:59:43.41,0:59:45.83,Default,,0,0,0,,Мен жасаған күлкі емес, хехе...
Dialogue: 0,0:59:46.04,0:59:46.87,Default,,0,0,0,,Ха...
Dialogue: 0,0:59:49.21,0:59:50.87,Default,,0,0,0,,Кездескенше (Нина) Иә...
Dialogue: 0,0:59:51.46,0:59:53.71,Default,,0,0,0,,Уайымдама, мен тоқтамаймын
Dialogue: 0,0:59:53.84,0:59:55.46,Default,,0,0,0,,Шынымен бе? Иә
Dialogue: 0,0:59:55.92,0:59:58.30,Default,,0,0,0,,Мен бұл туралы кеше оны тікелей эфирде ойнап жатқанда ойладым.
Dialogue: 0,0:59:58.42,1:00:01.47,Default,,0,0,0,,«Маған бұл шынымен ұнауы мүмкін».
Dialogue: 0,1:00:04.89,1:00:06.06,Default,,0,0,0,,Уф
Dialogue: 0,1:00:06.31,1:00:07.14,Default,,0,0,0,,Ittatatata...
Dialogue: 0,1:00:07.27,1:00:09.85,Default,,0,0,0,,Сіз жақсы нәрсе айттыңыз, сондықтан бірдеңе айтыңыз!
Dialogue: 0,1:00:10.85,1:00:11.85,Default,,0,0,0,,Иә
Dialogue: 0,1:00:13.56,1:00:16.86,Default,,0,0,0,,«Детектив Обабаның істері» 6-бөлім
Dialogue: 0,1:00:16.98,1:00:19.78,Default,,0,0,0,,Бұл Обабаны ойнайтын Анва Тендо мырза [Қызметкерлердің қол шапалақтауы]
Dialogue: 0,1:00:19.90,1:00:21.11,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,1:00:21.36,1:00:24.70,Default,,0,0,0,,Бұл менің немерем Субару, мен дүкенде сатушы болып жұмыс істейтін боламын.
Dialogue: 0,1:00:24.83,1:00:26.54,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,1:00:29.50,1:00:31.17,Default,,0,0,0,,Сіз шынымен сөйлеп тұрсыз ба?
Dialogue: 0,1:00:31.29,1:00:32.96,Default,,0,0,0,,Иә, мен мұны айттым.
Dialogue: 0,1:00:33.08,1:00:35.71,Default,,0,0,0,,Мен мектепті тастауым керек шығар.
Dialogue: 0,1:00:35.84,1:00:39.09,Default,,0,0,0,,Ол ата-анасының үйіне қайтуы мүмкін, бірақ ол топпен жұмысты жалғастырғысы келеді.
Dialogue: 0,1:00:39.21,1:00:43.39,Default,,0,0,0,,Бұл соншалықты үлкен мәміле бола ма? Сонда оны айтуға өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,1:00:43.84,1:00:45.01,Default,,0,0,0,,Сонымен…
Dialogue: 0,1:00:45.14,1:00:48.68,Default,,0,0,0,,Бірақ мен оны бір күні айтуым керек деп ойладым.
Dialogue: 0,1:00:48.81,1:00:50.52,Default,,0,0,0,,Иә, бәрі жақсы.
Dialogue: 0,1:00:52.69,1:00:53.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:54.27,1:00:55.48,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,1:00:56.44,1:00:58.90,Default,,0,0,0,,Иә, бүгінгі күн солай.
Dialogue: 0,1:00:59.28,1:01:01.28,Default,,0,0,0,,Бұл біздің бірінші рет бірге жұмыс істеуіміз.
Dialogue: 0,1:01:01.40,1:01:02.82,Default,,0,0,0,,Аня нәжіске батты.
Dialogue: 0,1:01:03.49,1:01:05.28,Default,,0,0,0,,Бұл әрқашан арман болды
Dialogue: 0,1:01:07.66,1:01:10.58,Default,,0,0,0,,Ол сол бала сияқты жұмыста көрінеді...
Dialogue: 0,1:01:11.71,1:01:14.17,Default,,0,0,0,,Сіз әлі де актриса болғыңыз келе ме?
Dialogue: 0,1:01:14.38,1:01:15.67,Default,,0,0,0,,Ал...
Dialogue: 0,1:01:16.25,1:01:20.92,Default,,0,0,0,,Субарудың есімі мені танымал еткен фильмдегі рөлімнің атымен бірдей.
Dialogue: 0,1:01:21.30,1:01:23.47,Default,,0,0,0,,Сол себепті мен қатты қуандым.
Dialogue: 0,1:01:23.59,1:01:27.18,Default,,0,0,0,,Субару менің жұмысымды ұнататынын айтқан кезде...
Dialogue: 0,1:01:27.85,1:01:29.35,Default,,0,0,0,,Мен ризамын
Dialogue: 0,1:01:29.97,1:01:32.43,Default,,0,0,0,,Иә, Жарайды, тексеріңіз.
Dialogue: 0,1:01:32.73,1:01:35.06,Default,,0,0,0,,Аа, еңбегіңіз үшін рахмет.
Dialogue: 0,1:01:37.27,1:01:39.90,Default,,0,0,0,,Мм... Саған айтар сөзім бар.
Dialogue: 0,1:01:40.44,1:01:42.40,Default,,0,0,0,,Әңгіме? не?
Dialogue: 0,1:01:42.95,1:01:45.07,Default,,0,0,0,,Негізі, мен мұны кейінірек жасағым келеді...
Dialogue: 0,1:01:45.49,1:01:47.91,Default,,0,0,0,,Шинкансен Сіз уақытында үлгере алмайсыз, солай ма?
Dialogue: 0,1:01:48.28,1:01:50.91,Default,,0,0,0,,Ал, мен қазір кетуім керек.
Dialogue: 0,1:01:51.58,1:01:55.12,Default,,0,0,0,,Түсіндім... Иә, сосын айтамын.
Dialogue: 0,1:01:55.46,1:01:56.63,Default,,0,0,0,,Көрдіңіз бе!
Dialogue: 0,1:01:58.50,1:02:01.76,Default,,0,0,0,,Мм... мен.
Dialogue: 0,1:02:03.76,1:02:06.47,Default,,0,0,0,,Мен әжем...
Dialogue: 0,1:02:09.43,1:02:10.35,Default,,0,0,0,,Мен...
Dialogue: 0,1:02:10.47,1:02:12.85,Default,,0,0,0,,Субару-чан! қиын! иә?
Dialogue: 0,1:02:13.06,1:02:15.81,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым. Мен дереу кетуім керек!
Dialogue: 0,1:02:16.10,1:02:16.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:17.15,1:02:19.94,Default,,0,0,0,,Мен қазір кетуім керек! Эй? Кеттік, кеттік!
Dialogue: 0,1:02:20.07,1:02:21.15,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,1:02:21.28,1:02:23.44,Default,,0,0,0,,Бұл! аздап!
Dialogue: 0,1:02:24.78,1:02:26.36,Default,,0,0,0,,Оны баспаңыз!
Dialogue: 0,1:02:27.20,1:02:29.41,Default,,0,0,0,,Күте тұрыңыз... не?
Dialogue: 0,1:02:30.49,1:02:31.83,Default,,0,0,0,,♪ [Монитордан ойналатын музыка]
Dialogue: 0,1:02:32.87,1:02:35.54,Default,,0,0,0,,Танысқаныма қуаныштымын, біз...
Dialogue: 0,1:02:36.29,1:02:38.17,Default,,0,0,0,,Алмаз шаңы!
Dialogue: 0,1:02:38.67,1:02:40.71,Default,,0,0,0,,Біздің дебюттік сингл...
Dialogue: 0,1:02:40.84,1:02:41.92,Default,,0,0,0,,[Мониторды өшіру дыбысы] (Нина) Ах...
Dialogue: 0,1:02:42.21,1:02:45.22,Default,,0,0,0,,Уақытты босқа кетіру. Бұл тегін емес.
Dialogue: 0,1:02:45.59,1:02:47.55,Default,,0,0,0,,Неге десеңіз, негізін тапқан дұрыс.
Dialogue: 0,1:02:47.68,1:02:50.10,Default,,0,0,0,,[Гитара дыбысы] (Момока) Егер тауып алсаңыз.
Dialogue: 0,1:02:50.22,1:02:54.14,Default,,0,0,0,,Бірақ қазіргі үшеуі де жаман емес деп ойлаймын.
Dialogue: 0,1:02:54.31,1:02:56.27,Default,,0,0,0,,Хмм?
Dialogue: 0,1:02:58.65,1:02:59.86,Default,,0,0,0,,Уау!
Dialogue: 0,1:03:00.11,1:03:03.11,Default,,0,0,0,,Сәлем, Момо-чан! Қанша жыл болды?
Dialogue: 0,1:03:03.36,1:03:05.61,Default,,0,0,0,,Екі жыл болған жоқ, солай ма?
Dialogue: 0,1:03:06.65,1:03:09.24,Default,,0,0,0,,Мұнда да ештеңе өзгерген жоқ.
Dialogue: 0,1:03:09.87,1:03:13.74,Default,,0,0,0,,Ол өзгерді~ Бұл күйреу алдында! Ол ертең құлайды!
Dialogue: 0,1:03:13.87,1:03:15.54,Default,,0,0,0,,Мен тек Момо-чанға сене аламын...
Dialogue: 0,1:03:16.04,1:03:18.00,Default,,0,0,0,,А... Момока-сан?
Dialogue: 0,1:03:18.12,1:03:20.42,Default,,0,0,0,,Өте сүйкімді~
Dialogue: 0,1:03:20.92,1:03:22.63,Default,,0,0,0,,Шулы
Dialogue: 0,1:03:23.46,1:03:25.76,Default,,0,0,0,,Олар бір-біріне ұқсайды...
Dialogue: 0,1:03:25.96,1:03:27.76,Default,,0,0,0,,Нина (Нина) А... иә!
Dialogue: 0,1:03:27.97,1:03:30.55,Default,,0,0,0,,Іштей қарасам жарайды дедім.
Dialogue: 0,1:03:31.51,1:03:33.64,Default,,0,0,0,,Мазалағаным үшін кешіріңіз...
Dialogue: 0,1:03:38.89,1:03:43.19,Default,,0,0,0,,Өткен уақытпен салыстырғанда тар.
Dialogue: 0,1:03:43.65,1:03:45.69,Default,,0,0,0,,Бұл бұрыннан бар дүкен.
Dialogue: 0,1:03:45.82,1:03:47.90,Default,,0,0,0,,Көптеген тұтынушылар оны естуге үйренген.
Dialogue: 0,1:03:48.03,1:03:50.36,Default,,0,0,0,,Егер ол жұмыс істемесе, ашық түрде әрекет етіңіз
Dialogue: 0,1:03:50.82,1:03:54.87,Default,,0,0,0,,Маған тікелей шоуда өнер көрсетуді сұрады, не істеуім керек?
Dialogue: 0,1:03:55.24,1:03:56.58,Default,,0,0,0,,Маған көп жаттығу керек...
Dialogue: 0,1:03:56.70,1:03:57.79,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,1:03:58.46,1:03:59.87,Default,,0,0,0,,Мен біраз уайымдап тұрмын...
Dialogue: 0,1:04:00.00,1:04:01.88,Default,,0,0,0,,Мен саған мүлдем ғашықпын!
Dialogue: 0,1:04:02.00,1:04:04.29,Default,,0,0,0,,Соңғы уақытқа дейін мен оны қатты жек көретінмін.
Dialogue: 0,1:04:04.67,1:04:08.38,Default,,0,0,0,,Бұл бар болғаны 20 минутқа созылады.
Dialogue: 0,1:04:09.09,1:04:11.18,Default,,0,0,0,,Бұл соншалықты ауыртпалық емес...
Dialogue: 0,1:04:11.93,1:04:13.26,Default,,0,0,0,,Біз тырысамыз ба?
Dialogue: 0,1:04:14.43,1:04:15.93,Default,,0,0,0,,Иә Билет
Dialogue: 0,1:04:16.43,1:04:20.06,Default,,0,0,0,,Сондай-ақ, «бұрынғы гауһар шаңы» жарнамасы жоқ!
Dialogue: 0,1:04:22.23,1:04:25.32,Default,,0,0,0,,Иә, енді қаша алмайсың.
Dialogue: 0,1:04:25.57,1:04:26.78,Default,,0,0,0,,Иә? Ха...
Dialogue: 0,1:04:27.86,1:04:29.32,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,1:04:29.78,1:04:33.32,Default,,0,0,0,,Мен оны өзіміз сата аламыз деп ешқашан ойламаппын...
Dialogue: 0,1:04:37.79,1:04:39.83,Default,,0,0,0,,Ах... (Нина) Эхехе
Dialogue: 0,1:04:39.96,1:04:40.96,Default,,0,0,0,,Не?
Dialogue: 0,1:04:41.16,1:04:43.96,Default,,0,0,0,,Жоқ, мен тікелей эфирде шоу жасап жатырмын.
Dialogue: 0,1:04:44.08,1:04:45.71,Default,,0,0,0,,Қызығушылық...
Dialogue: 0,1:04:46.50,1:04:47.46,Default,,0,0,0,,Сіз?
Dialogue: 0,1:04:47.96,1:04:49.01,Default,,0,0,0,,Аха…
Dialogue: 0,1:04:49.13,1:04:51.22,Default,,0,0,0,,Сонда оны маған тегін бердіңіз бе?
Dialogue: 0,1:04:51.51,1:04:53.09,Default,,0,0,0,,Бұл билет
Dialogue: 0,1:04:53.22,1:04:56.85,Default,,0,0,0,,Біз оны сатып алдық, солай ма? Тірі үй үшін төлеңіз!
Dialogue: 0,1:04:56.97,1:04:58.47,Default,,0,0,0,,Е! Ха...
Dialogue: 0,1:04:58.72,1:05:00.60,Default,,0,0,0,,Орташа өлшемді күту~
Dialogue: 0,1:05:00.98,1:05:03.52,Default,,0,0,0,,Соңғы уақытта билет квотасы төмендеді.
Dialogue: 0,1:05:03.65,1:05:05.52,Default,,0,0,0,,Жанды дауыс орындайтын топқа байланысты.
Dialogue: 0,1:05:05.65,1:05:10.32,Default,,0,0,0,,Қатысу жарнасы немесе билет жарнасы атынан алдымен ақша алу
Dialogue: 0,1:05:10.44,1:05:12.15,Default,,0,0,0,,Осылайша, тіпті тұтынушылар болмаса да
Dialogue: 0,1:05:12.28,1:05:15.37,Default,,0,0,0,,Жанды музыка алаңдары ең төменгі табысқа кепілдік береді, солай емес пе?
Dialogue: 0,1:05:15.53,1:05:17.37,Default,,0,0,0,,Бұл алдау!
Dialogue: 0,1:05:17.58,1:05:19.37,Default,,0,0,0,,Бұл бизнестің түрі!
Dialogue: 0,1:05:21.20,1:05:22.66,Default,,0,0,0,,Күрішті жару…
Dialogue: 0,1:05:24.08,1:05:24.88,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:25.92,1:05:26.96,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:27.67,1:05:30.21,Default,,0,0,0,,Момока-сан, сен өзің төледім дедің.
Dialogue: 0,1:05:30.34,1:05:32.26,Default,,0,0,0,,Маған жай ғана айтсаңызшы...
Dialogue: 0,1:05:33.05,1:05:34.09,Default,,0,0,0,,Әй?
Dialogue: 0,1:05:34.47,1:05:36.35,Default,,0,0,0,,Ах, Момо-чанның немере ағасы...
Dialogue: 0,1:05:36.47,1:05:37.51,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,1:05:37.64,1:05:38.76,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,1:05:38.89,1:05:39.77,Default,,0,0,0,,Әй!
Dialogue: 0,1:05:40.77,1:05:42.64,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,1:05:43.35,1:05:45.60,Default,,0,0,0,,Ал, қайда бардың?
Dialogue: 0,1:05:45.73,1:05:47.36,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,1:05:47.81,1:05:49.15,Default,,0,0,0,,Не ол?
Dialogue: 0,1:05:49.78,1:05:52.69,Default,,0,0,0,,Қараңызшы, Diamond Dust өзінің негізгі дебютін жасап жатыр.
Dialogue: 0,1:05:52.82,1:05:55.86,Default,,0,0,0,,«Көмегіңе көптен рахмет» деп түстен кейін сәлемдесуге келді.
Dialogue: 0,1:05:56.41,1:05:57.87,Default,,0,0,0,,Қаласаңыз
Dialogue: 0,1:05:58.12,1:05:59.49,Default,,0,0,0,,Оны ала аламын ба?
Dialogue: 0,1:05:59.62,1:06:02.12,Default,,0,0,0,,Артқы жағында осындай үлкен бөлік болған кезде.
Dialogue: 0,1:06:02.25,1:06:05.25,Default,,0,0,0,,Ағай енді қызықпайды.
Dialogue: 0,1:06:05.58,1:06:07.63,Default,,0,0,0,,Қаласаңыз, Момо-чанға да беріңіз.
Dialogue: 0,1:06:11.13,1:06:13.63,Default,,0,0,0,,Не істеу керек? Мен оны Момокаға беруім керек пе?
Dialogue: 0,1:06:14.30,1:06:17.01,Default,,0,0,0,,Саған берсем ұрыс болады.
Dialogue: 0,1:06:18.05,1:06:21.01,Default,,0,0,0,,Бірақ мен оны көргім келеді.
Dialogue: 0,1:06:22.02,1:06:24.27,Default,,0,0,0,,Ендеше, бірге барамыз ба?
Dialogue: 0,1:06:24.56,1:06:26.77,Default,,0,0,0,,Мен де қызықтай бастадым!
Dialogue: 0,1:06:27.56,1:06:29.15,Default,,0,0,0,,Субару-chan...
Dialogue: 0,1:06:30.15,1:06:31.02,Default,,0,0,0,,О...
Dialogue: 0,1:06:38.57,1:06:39.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:44.45,1:06:46.58,Default,,0,0,0,,Күтілгендей, ТАПТЫ
Dialogue: 0,1:06:52.80,1:06:55.80,Default,,0,0,0,,♪～
Dialogue: 0,1:06:53.34,1:06:55.80,Default,,0,0,0,,(қуаныш)
Dialogue: 0,1:07:02.01,1:07:05.02,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,1:07:05.39,1:07:09.31,Default,,0,0,0,,``Бос жәшік'' ♪Мен картада болмауы керек үш жақты қиылыста тұрмын.
Dialogue: 0,1:07:09.44,1:07:11.82,Default,,0,0,0,,♪Менде жанжал бар.
Dialogue: 0,1:07:11.94,1:07:19.61,Default,,0,0,0,,♪Мен алға жылжу үшін неге сүйенуім керек?
Dialogue: 0,1:07:29.79,1:07:31.67,Default,,0,0,0,,Бұл Нинаның кінәсі.
Dialogue: 0,1:07:38.63,1:07:39.63,Default,,0,0,0,,Өтірік…
Dialogue: 0,1:07:40.64,1:07:41.55,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,1:07:41.68,1:07:44.68,Default,,0,0,0,,♪Бұл шынымен ақ, бұл өте ұзын
Dialogue: 0,1:07:44.81,1:07:49.94,Default,,0,0,0,,♪Котаэ, бәлкім, жалпыға ортақ білім, ол негізінен жай пішін.
Dialogue: 0,1:07:50.77,1:07:52.98,Default,,0,0,0,,Ән айту керек... Иә?
Dialogue: 0,1:07:54.57,1:07:56.23,Default,,0,0,0,,Иә? аздап!
Dialogue: 0,1:07:56.90,1:08:00.49,Default,,0,0,0,,Күте тұрыңыз! Не болып жатыр? Оның басталғанына 5 минут болды...
Dialogue: 0,1:08:00.61,1:08:02.41,Default,,0,0,0,,Субару-чан, не?
Dialogue: 0,1:08:02.53,1:08:06.37,Default,,0,0,0,,Мен шынымен лас нәрсе айтайын деп тұрғандай болдым.
Dialogue: 0,1:08:06.50,1:08:07.83,Default,,0,0,0,,Бірақ, әйтеуір, мен оны Фужинума мырзаға айтпаймын, білесің бе.
Dialogue: 0,1:08:08.16,1:08:11.75,Default,,0,0,0,,Мен әуелі мағынасыз айқайлап, бар сезімімді сыртқа шығарамын.
Dialogue: 0,1:08:11.88,1:08:12.50,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:13.04,1:08:14.25,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,1:08:14.38,1:08:18.59,Default,,0,0,0,,(түсініксіз сөздерді айқайлаған дауыс)
Dialogue: 0,1:08:18.92,1:08:21.05,Default,,0,0,0,,Қат! Өл!
Dialogue: 0,1:08:21.18,1:08:23.47,Default,,0,0,0,,Екінші жартысы Сөзге айналды...
Dialogue: 0,1:08:23.85,1:08:26.56,Default,,0,0,0,,Бұл не? Бұл не? Бұл не? Бұл не?
Dialogue: 0,1:08:26.68,1:08:28.27,Default,,0,0,0,,Бұл не!? Мен білмеймін.
Dialogue: 0,1:08:28.73,1:08:30.98,Default,,0,0,0,,Бұл гауһар шаңына көбірек ұқсайды.
Dialogue: 0,1:08:31.10,1:08:34.15,Default,,0,0,0,,Мен өмірден кейінгі ең маңыздысымын.
Dialogue: 0,1:08:34.27,1:08:36.02,Default,,0,0,0,,Бұл қазына...
Dialogue: 0,1:08:36.23,1:08:37.86,Default,,0,0,0,,Сонымен не?
Dialogue: 0,1:08:40.86,1:08:42.78,Default,,0,0,0,,Бұл жаңа вокал
Dialogue: 0,1:08:43.07,1:08:45.24,Default,,0,0,0,,Мен... білемін.
Dialogue: 0,1:08:45.99,1:08:47.91,Default,,0,0,0,,Мен бұрын дос болған қыз...
Dialogue: 0,1:08:48.04,1:08:49.91,Default,,0,0,0,,Біз ажырастық, солай ма?
Dialogue: 0,1:08:50.25,1:08:51.71,Default,,0,0,0,,Біз үзілдік!
Dialogue: 0,1:08:53.79,1:08:55.13,Default,,0,0,0,,♪ [Монитордан ойнатылатын музыка]
Dialogue: 0,1:08:56.17,1:08:58.88,Default,,0,0,0,,Танысқаныма қуаныштымын, біз...
Dialogue: 0,1:08:59.59,1:09:00.97,Default,,0,0,0,,Алмаз шаңы
Dialogue: 0,1:09:01.09,1:09:01.93,Default,,0,0,0,,[Мониторды өшіру дыбысы]
Dialogue: 0,1:09:03.93,1:09:07.18,Default,,0,0,0,,Бұл бұзылады (Нина) Менің оны естігім келмейді!
Dialogue: 0,1:09:07.31,1:09:10.43,Default,,0,0,0,,Тікелей эфирге рұқсатсыз кіріп, ашулану
Dialogue: 0,1:09:10.56,1:09:12.14,Default,,0,0,0,,Рұқсатсыз шағымдану
Dialogue: 0,1:09:12.27,1:09:14.69,Default,,0,0,0,,Оның қалай аталатынын білесіз бе?
Dialogue: 0,1:09:14.81,1:09:16.52,Default,,0,0,0,,«Мазасыздық» деп аталады.
Dialogue: 0,1:09:16.65,1:09:18.94,Default,,0,0,0,,Момока-сан, мен өзімді түсінбеймін.
Dialogue: 0,1:09:19.28,1:09:20.69,Default,,0,0,0,,Түсінгім де келмейді.
Dialogue: 0,1:09:20.99,1:09:22.70,Default,,0,0,0,,Қандай кездейсоқтық!
Dialogue: 0,1:09:22.82,1:09:24.32,Default,,0,0,0,,Қандай керемет!
Dialogue: 0,1:09:24.45,1:09:27.28,Default,,0,0,0,,Неліктен бұл бала Diamond Dust тобының вокалисті?
Dialogue: 0,1:09:27.41,1:09:29.87,Default,,0,0,0,,Және бұл харакараның бәрі…
Dialogue: 0,1:09:30.00,1:09:32.79,Default,,0,0,0,,Бірақ бастапқыда мен мұнда-мұнда тыңдауларға бардым.
Dialogue: 0,1:09:32.91,1:09:34.58,Default,,0,0,0,,Ол жол бойы кеткен бала ғой, солай ма?
Dialogue: 0,1:09:34.71,1:09:37.09,Default,,0,0,0,,Сол себепті... (Момока) Сен өте ренжіттің!
Dialogue: 0,1:09:37.25,1:09:39.25,Default,,0,0,0,,Бұл сіздің жағдайыңыз, солай емес пе?
Dialogue: 0,1:09:39.38,1:09:41.80,Default,,0,0,0,,Бұл тек сен үшін емес, Дедус.
Dialogue: 0,1:09:41.92,1:09:44.97,Default,,0,0,0,,Сонымен, Момока-сан, бұл дұрыс деп ойлайсың ба?
Dialogue: 0,1:09:45.09,1:09:46.51,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,1:09:46.64,1:09:49.10,Default,,0,0,0,,Олар мен кездегіге қарағанда жақсы сатылып жатқан сияқты.
Dialogue: 0,1:09:49.22,1:09:50.85,Default,,0,0,0,,Сатса жарайды ма?
Dialogue: 0,1:09:50.97,1:09:52.56,Default,,0,0,0,,Мүлдем сатпағаннан жақсы!
Dialogue: 0,1:09:52.68,1:09:54.73,Default,,0,0,0,,Жауап емес!
Dialogue: 0,1:09:55.06,1:09:56.48,Default,,0,0,0,,Мм!
Dialogue: 0,1:09:59.48,1:10:00.32,Default,,0,0,0,,Сонымен?
Dialogue: 0,1:10:00.44,1:10:03.03,Default,,0,0,0,,А, сәл күте тұрыңыз [Гонг дыбысы]
Dialogue: 0,1:10:03.15,1:10:04.86,Default,,0,0,0,,Қосымша әрекеттер жасаудың қажеті жоқ
Dialogue: 0,1:10:05.66,1:10:06.99,Default,,0,0,0,,Неліктен оны жауып жатырсыз?
Dialogue: 0,1:10:07.16,1:10:09.12,Default,,0,0,0,,Сондықтан мені қорғаудың қажеті жоқ, солай ма?
Dialogue: 0,1:10:09.33,1:10:10.54,Default,,0,0,0,,Мен сені қорғаймын.
Dialogue: 0,1:10:10.66,1:10:14.08,Default,,0,0,0,,Ойланып көріңізші. Қалай қарасаңыз да, қазіргі алмаз шаңы
Dialogue: 0,1:10:14.21,1:10:16.54,Default,,0,0,0,,Момоканың істеп жүргенінен өзгеше емес пе?
Dialogue: 0,1:10:16.67,1:10:17.50,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:10:17.67,1:10:20.25,Default,,0,0,0,,Бекіту біртүрлі деп жатырмын!
Dialogue: 0,1:10:20.38,1:10:21.80,Default,,0,0,0,,Мұнда таңқаларлық ештеңе жоқ, солай ма?
Dialogue: 0,1:10:21.92,1:10:23.72,Default,,0,0,0,,Мен енді ол жерде емеспін
Dialogue: 0,1:10:23.84,1:10:24.93,Default,,0,0,0,,Қалғаны өзіңізге байланысты.
Dialogue: 0,1:10:25.05,1:10:28.51,Default,,0,0,0,,Жолдар көп, оларды жоққа шығаруға құқығым жоқ.
Dialogue: 0,1:10:28.80,1:10:30.81,Default,,0,0,0,,Менің сұрайтыным бұл емес.
Dialogue: 0,1:10:30.93,1:10:33.27,Default,,0,0,0,,Бұл сізге ұнайды ма, ұнамады ма, мәселе!
Dialogue: 0,1:10:33.73,1:10:36.77,Default,,0,0,0,,Маған ұнамайды да, ұнатпайды да.
Dialogue: 0,1:10:38.27,1:10:40.73,Default,,0,0,0,,Сіз қатысқан топ, солай ма?
Dialogue: 0,1:10:40.86,1:10:43.99,Default,,0,0,0,,Бұл Момока-сан өз жанын салған топ.
Dialogue: 0,1:10:45.07,1:10:47.03,Default,,0,0,0,,Болжам жасамаңыз
Dialogue: 0,1:10:47.32,1:10:49.20,Default,,0,0,0,,Сонда бұл басқаша.
Dialogue: 0,1:10:49.32,1:10:51.49,Default,,0,0,0,,Момока үшін алмаз шаңы
Dialogue: 0,1:10:51.62,1:10:54.37,Default,,0,0,0,,Олар оған жанын салмады, олар жай ғана маңызды емес топ болды.
Dialogue: 0,1:10:54.50,1:10:55.66,Default,,0,0,0,,Шулы!
Dialogue: 0,1:10:55.87,1:10:58.54,Default,,0,0,0,,Бұл Нинаны алаңдатып отырған вокалист емес пе?
Dialogue: 0,1:10:58.67,1:10:59.67,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:10:59.83,1:11:03.96,Default,,0,0,0,,Мен Алмаз шаңы қазіргі күйінде жақсы ма деп сұраймын!
Dialogue: 0,1:11:06.34,1:11:08.93,Default,,0,0,0,,Барлығы, уайымдама~
Dialogue: 0,1:11:09.30,1:11:11.05,Default,,0,0,0,,Екеуің де тынышталыңдар.
Dialogue: 0,1:11:11.47,1:11:12.64,Default,,0,0,0,,Сіз білесіз...
Dialogue: 0,1:11:12.76,1:11:14.43,Default,,0,0,0,,Жолақтар адамдармен бірдей.
Dialogue: 0,1:11:14.56,1:11:17.02,Default,,0,0,0,,Ол өсіп, өзгереді.
Dialogue: 0,1:11:17.14,1:11:19.56,Default,,0,0,0,,Барлығы өзгереді.
Dialogue: 0,1:11:19.81,1:11:21.94,Default,,0,0,0,,Онда неге тоқтадың...
Dialogue: 0,1:11:23.53,1:11:26.57,Default,,0,0,0,,Өзгеріс сізді қанағаттандырмағандықтан жұмыстан шықтыңыз.
Dialogue: 0,1:11:26.70,1:11:30.91,Default,,0,0,0,,«Бұл гауһар шаңы емес» деп ойладым да, мен мұны тоқтаттым.
Dialogue: 0,1:11:31.83,1:11:34.87,Default,,0,0,0,,Сен қателеспеймін деп тоқтадың.
Dialogue: 0,1:11:35.00,1:11:38.83,Default,,0,0,0,,Маған ол балалардың қазір істеп жатқаны ұнамады, сондықтан мен мұны тоқтаттым.
Dialogue: 0,1:11:40.08,1:11:41.54,Default,,0,0,0,,Сен неге үндемейсің?
Dialogue: 0,1:11:41.67,1:11:44.05,Default,,0,0,0,,Мен естіген ән қандай болды?
Dialogue: 0,1:11:44.17,1:11:46.30,Default,,0,0,0,,Дайдас осылай істегісі келді, солай ма?
Dialogue: 0,1:11:46.72,1:11:49.18,Default,,0,0,0,,Маған Дайдастың қазір басқаша екенін айтыңызшы!
Dialogue: 0,1:11:49.51,1:11:52.18,Default,,0,0,0,,Бұл гауһар шаңы емес!
Dialogue: 0,1:11:52.85,1:11:53.81,Default,,0,0,0,,Бұл...
Dialogue: 0,1:11:55.22,1:11:56.43,Default,,0,0,0,,Қандай бақыттысыңдар, барлық қызықты өзіңе алдыңдар.
Dialogue: 0,1:11:58.56,1:11:59.56,Default,,0,0,0,,Үндетпе
Dialogue: 0,1:12:00.31,1:12:01.35,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,1:12:02.06,1:12:03.11,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,1:12:03.23,1:12:06.40,Default,,0,0,0,,Маған Момоканың гауһар шаңы ұнайды!
Dialogue: 0,1:12:07.07,1:12:08.99,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:12:09.11,1:12:09.95,Default,,0,0,0,,[Құлыптау дыбысы]
Dialogue: 0,1:12:11.61,1:12:12.45,Default,,0,0,0,,Хехехе
Dialogue: 0,1:12:14.45,1:12:17.66,Default,,0,0,0,,♪Бұл шынымен ақ, бұл өте ұзын
Dialogue: 0,1:12:17.79,1:12:19.41,Default,,0,0,0,,♪Котаэ шамамен
Dialogue: 0,1:12:19.54,1:12:20.83,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,1:12:20.96,1:12:24.04,Default,,0,0,0,,Маған Момоканың «Гауһар шаңы» ұнайды.
Dialogue: 0,1:12:24.17,1:12:27.05,Default,,0,0,0,,Сол ән менің өмірімді өзгертті.
Dialogue: 0,1:12:27.17,1:12:28.01,Default,,0,0,0,,[Сусын құйып жатқан дыбыс]
Dialogue: 0,1:12:28.13,1:12:30.09,Default,,0,0,0,,Сондықтан мен сенің жеңілгеніңді қаламаймын!
Dialogue: 0,1:12:32.76,1:12:33.60,Default,,0,0,0,,Хмм...
Dialogue: 0,1:12:33.89,1:12:34.72,Default,,0,0,0,,Эй!
Dialogue: 0,1:12:34.85,1:12:38.48,Default,,0,0,0,,«Мен кінәлімін» немесе «Олар дұрыс» деп айту, тіпті мен сенімді болмасам да.
Dialogue: 0,1:12:38.64,1:12:40.98,Default,,0,0,0,,Мен сенің мұндай өтірік айтқаныңды қаламаймын!
Dialogue: 0,1:12:43.35,1:12:47.28,Default,,0,0,0,,Ол кезде Алмаз шаңы нені көздегенін білесіз бе?
Dialogue: 0,1:12:48.23,1:12:49.49,Default,,0,0,0,,Не ол?
Dialogue: 0,1:12:49.61,1:12:50.95,Default,,0,0,0,,Қыздар тобында
Dialogue: 0,1:12:51.07,1:12:54.57,Default,,0,0,0,,Мен кемпір болсам да, бастапқы мүше ретінде жалғастырамын.
Dialogue: 0,1:12:55.24,1:12:57.12,Default,,0,0,0,,Мен ешқашан тоқтамаймын
Dialogue: 0,1:12:57.33,1:12:58.91,Default,,0,0,0,,...
Dialogue: 0,1:12:59.04,1:13:01.08,Default,,0,0,0,,Мен осыны ғана мақсат еттім.
Dialogue: 0,1:13:02.08,1:13:04.79,Default,,0,0,0,,Сондықтан бұл менің кінәм.
Dialogue: 0,1:13:07.75,1:13:09.09,Default,,0,0,0,,«Қазір шыдамды болыңыз»
Dialogue: 0,1:13:09.34,1:13:10.59,Default,,0,0,0,,«Бір күні сен шыңға шығасың»
Dialogue: 0,1:13:10.72,1:13:13.38,Default,,0,0,0,,«Біз өзіміз қалаған нәрсені жасай аламыз».
Dialogue: 0,1:13:14.34,1:13:18.10,Default,,0,0,0,,Олар мені соңына дейін сендіруге тырысты.
Dialogue: 0,1:13:19.64,1:13:23.02,Default,,0,0,0,,Сонда да мен кеттім.
Dialogue: 0,1:13:27.32,1:13:29.44,Default,,0,0,0,,Иә, бұл оолонг шайы.
Dialogue: 0,1:13:29.57,1:13:31.49,Default,,0,0,0,,Рахмет (хатшы) Иә.
Dialogue: 0,1:13:32.11,1:13:33.11,Default,,0,0,0,,Nina…
Dialogue: 0,1:13:33.24,1:13:36.95,Default,,0,0,0,,Мәселе үшін кешірім сұраймыз, барлығыңыз!
Dialogue: 0,1:13:40.70,1:13:41.66,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,1:13:41.91,1:13:42.83,Default,,0,0,0,,Әлі де...
Dialogue: 0,1:13:42.96,1:13:45.38,Default,,0,0,0,,...
Dialogue: 0,1:13:46.00,1:13:47.88,Default,,0,0,0,,Өйткені маған Момоканың әні ұнайды
Dialogue: 0,1:13:48.92,1:13:53.76,Default,,0,0,0,,Менің жүрегімді елжіреткені сол кездегі алмас шаңы еді.
Dialogue: 0,1:13:54.51,1:13:56.09,Default,,0,0,0,,Өйткені бұл Момока-сан...
Dialogue: 0,1:14:01.68,1:14:04.94,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,1:14:05.60,1:14:08.57,Default,,0,0,0,,Сен ақымақсың. Егер сен ақымақ болмасаң...
Dialogue: 0,1:14:08.90,1:14:11.44,Default,,0,0,0,,Мен мұны мұндай жерде істеп жатқан жоқпын.
Dialogue: 0,1:14:11.73,1:14:13.24,Default,,0,0,0,,(Нинаның жылағаны)
Dialogue: 0,1:14:13.36,1:14:15.86,Default,,0,0,0,,Алкогольді көбірек қосыңыз~
Dialogue: 0,1:14:15.99,1:14:17.74,Default,,0,0,0,,Субару-чан... Иә?
Dialogue: 0,1:14:18.37,1:14:19.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:19.62,1:14:20.87,Default,,0,0,0,,Hey… hey!?
Dialogue: 0,1:14:21.45,1:14:24.75,Default,,0,0,0,,()
Dialogue: 0,1:14:25.50,1:14:26.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:14:26.62,1:14:28.71,Default,,0,0,0,,Мен сіздің жүзіңізді көргенде ашуландым, сондықтан мен...
Dialogue: 0,1:14:29.71,1:14:30.71,Default,,0,0,0,,(murmuring voice)
Dialogue: 0,1:14:30.84,1:14:33.42,Default,,0,0,0,,А... [көліктің жүгірген дыбысы]
Dialogue: 0,1:14:36.63,1:14:37.64,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,1:14:39.43,1:14:41.18,Default,,0,0,0,,Мүмкін ол бақытты болған шығар.
Dialogue: 0,1:14:41.64,1:14:42.72,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:14:44.85,1:14:46.02,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:14:46.85,1:14:48.73,Default,,0,0,0,,(аудитория сөзі)
Dialogue: 0,1:14:49.36,1:14:51.07,Default,,0,0,0,,О, Момо-чан!
Dialogue: 0,1:14:51.19,1:14:52.11,Default,,0,0,0,,Сыбырлау
Dialogue: 0,1:14:52.48,1:14:54.11,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:14:54.24,1:14:55.99,Default,,0,0,0,,Жоқ, мен оған шеге қададым.
Dialogue: 0,1:14:56.11,1:14:58.78,Default,,0,0,0,,Қызметкерлер Момо-чан туралы рұқсатсыз жазған.
Dialogue: 0,1:14:58.91,1:15:01.83,Default,,0,0,0,,Бақытымызға орай, билеттер САТЫЛДЫ.
Dialogue: 0,1:15:01.95,1:15:03.41,Default,,0,0,0,,Иә! (Хаяши) Не?
Dialogue: 0,1:15:03.95,1:15:05.83,Default,,0,0,0,,Не? Ооооо...
Dialogue: 0,1:15:05.96,1:15:06.96,Default,,0,0,0,,Әй!
Dialogue: 0,1:15:07.71,1:15:09.54,Default,,0,0,0,,Сонымен, костюм ше?
Dialogue: 0,1:15:10.00,1:15:12.88,Default,,0,0,0,,Иә, бұл жақсы деп ойлаймын.
Dialogue: 0,1:15:14.80,1:15:15.63,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:15:15.76,1:15:17.63,Default,,0,0,0,,Не? Оны екі адам дайындады ма?
Dialogue: 0,1:15:17.76,1:15:19.64,Default,,0,0,0,,Егер сізге ұнамаса, маған хабарлаңыз
Dialogue: 0,1:15:20.01,1:15:21.85,Default,,0,0,0,,Ұнамаса да, киюге рұқсат етемін.
Dialogue: 0,1:15:21.97,1:15:24.31,Default,,0,0,0,,Мен сенен менімен жалаңаш жүруіңді сұраймын.
Dialogue: 0,1:15:24.52,1:15:25.35,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:25.48,1:15:27.19,Default,,0,0,0,,Ах, хе!
Dialogue: 0,1:15:28.02,1:15:29.31,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,1:15:29.44,1:15:30.94,Default,,0,0,0,,(3 адам күледі)
Dialogue: 0,1:15:31.06,1:15:32.86,Default,,0,0,0,,Сіз Момокасыз ба?
Dialogue: 0,1:15:32.98,1:15:34.19,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,1:15:34.32,1:15:38.45,Default,,0,0,0,,Кешіріңіз, мен қыздардың музыкасын жек көремін.
Dialogue: 0,1:15:38.66,1:15:40.28,Default,,0,0,0,,Ауа Мен оны жарып жібере аламын ба?
Dialogue: 0,1:15:40.62,1:15:42.33,Default,,0,0,0,,Атап айтқанда, біз...
Dialogue: 0,1:15:42.45,1:15:45.54,Default,,0,0,0,,Уайымдама, біз оны құртамыз.
Dialogue: 0,1:15:46.00,1:15:46.79,Default,,0,0,0,,Хмф!
Dialogue: 0,1:15:48.37,1:15:49.37,Default,,0,0,0,,О...
Dialogue: 0,1:15:50.75,1:15:52.67,Default,,0,0,0,,Жасайық!
Dialogue: 0,1:15:52.92,1:15:53.75,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,1:15:53.88,1:15:54.80,Default,,0,0,0,,Тағы бір… үкі ме?
Dialogue: 0,1:15:55.42,1:15:59.93,Default,,0,0,0,,[Гитара мен барабан дыбыстары]
Dialogue: 0,1:16:00.47,1:16:02.93,Default,,0,0,0,,Момока-сан! Момока~!
Dialogue: 0,1:16:04.93,1:16:07.56,Default,,0,0,0,,Момока мен сені жақсы көремін!
Dialogue: 0,1:16:07.68,1:16:09.19,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,1:16:12.06,1:16:13.65,Default,,0,0,0,,Осылай жалғастырамыз ба?
Dialogue: 0,1:16:14.32,1:16:16.73,Default,,0,0,0,,Қалай ойлайсыз, «тырнақ ізі» жақсы сөз емес пе?
Dialogue: 0,1:16:16.86,1:16:17.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:18.03,1:16:20.70,Default,,0,0,0,,Амалсыз күресіп, жабайы жүгіру
Dialogue: 0,1:16:20.82,1:16:25.16,Default,,0,0,0,,Өзіңізді ренжітіп жатқанда, басқаларды ренжітіп жатқандай сезінбейсіз бе?
Dialogue: 0,1:16:26.08,1:16:27.25,Default,,0,0,0,,Бұл іске араласпа.
Dialogue: 0,1:16:27.83,1:16:31.46,Default,,0,0,0,,Момоканың әні жүрегімді ойып алды.
Dialogue: 0,1:16:31.87,1:16:33.63,Default,,0,0,0,,Тырнақ іздері қалды.
Dialogue: 0,1:16:33.75,1:16:35.59,Default,,0,0,0,,«Мен өлсем де жеңілмеймін»
Dialogue: 0,1:16:38.09,1:16:38.97,Default,,0,0,0,,Әй!
Dialogue: 0,1:16:39.09,1:16:41.63,Default,,0,0,0,,Тырнақ ізімізді қалдырайық!
Dialogue: 0,1:16:45.14,1:16:49.10,Default,,0,0,0,,Ойыңыздағыны айқайлаңыз. Айқайлағың келген нәрсені әшекейлемей айғайла.
Dialogue: 0,1:16:49.23,1:16:52.35,Default,,0,0,0,,Қанағатсыздық, ашу, мұң, ұят, ұят
Dialogue: 0,1:16:52.48,1:16:54.44,Default,,0,0,0,,Өткенде көрпемді басыма лақтырып, айқайлайтын кездер болады.
Dialogue: 0,1:16:54.56,1:16:57.28,Default,,0,0,0,,Өкініш есіме түсіп, тұла бойымды терлейді
Dialogue: 0,1:16:57.40,1:16:59.78,Default,,0,0,0,,Бәрін аш... (Терең тыныс алу дыбысы)
Dialogue: 0,1:16:59.90,1:17:02.99,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:17:03.11,1:17:05.99,Default,,0,0,0,,♪～
Dialogue: 0,1:17:06.33,1:17:09.50,Default,,0,0,0,,Мен бәрін әшкерелеп, өмір сүремін!
Dialogue: 0,1:17:17.55,1:17:19.01,Default,,0,0,0,,``Менің көзқарасымның бұрышындағы ыдырау дыбысы'' ♪Үнемі араласатын қиылыста
Dialogue: 0,1:17:19.13,1:17:20.38,Default,,0,0,0,,♪Қолымызда не болды?
Dialogue: 0,1:17:20.59,1:17:22.01,Default,,0,0,0,,♪Тек үстірт сөздер
Dialogue: 0,1:17:22.13,1:17:23.63,Default,,0,0,0,,♪Жаңғырық пен тырнау
Dialogue: 0,1:17:23.76,1:17:25.18,Default,,0,0,0,,♪Аққан жұлдыз түскенде
Dialogue: 0,1:17:25.30,1:17:26.68,Default,,0,0,0,,♪Бәрін үрлеймін
Dialogue: 0,1:17:26.80,1:17:27.72,Default,,0,0,0,,♪Рейтинг
Dialogue: 0,1:17:27.85,1:17:29.89,Default,,0,0,0,,♪Ештеңе өзгерген жоқ
Dialogue: 0,1:17:30.02,1:17:31.35,Default,,0,0,0,,♪Осылай білмеймін деп
Dialogue: 0,1:17:31.48,1:17:32.94,Default,,0,0,0,,♪Қолымызды таза ұстайық
Dialogue: 0,1:17:33.06,1:17:35.81,Default,,0,0,0,,♪Арманның үзінділері көз алдымызда қирап жатыр
Dialogue: 0,1:17:35.94,1:17:38.90,Default,,0,0,0,,♪Байқамағандай, естімегендей кейіп таныт
Dialogue: 0,1:17:39.03,1:17:41.53,Default,,0,0,0,,♪Қарашы, өтіп бара жатыр
Dialogue: 0,1:17:42.40,1:17:45.32,Default,,0,0,0,,♪Әділдік құйын мен ағып жатқан қала
Dialogue: 0,1:17:45.45,1:17:48.49,Default,,0,0,0,,♪ Қалқымалы қалқыма, қайда барамыз?
Dialogue: 0,1:17:48.91,1:17:51.45,Default,,0,0,0,,♪Баратын жерге күле алсаң
Dialogue: 0,1:17:51.58,1:17:55.04,Default,,0,0,0,,♪Қол ұстайық, бұл арман емес
Dialogue: 0,1:17:55.17,1:17:58.00,Default,,0,0,0,,♪Күлге айналған соң, ақыры түсіндім
Dialogue: 0,1:17:58.13,1:18:01.30,Default,,0,0,0,,♪Тілектер саған ешқашан жетпейді
Dialogue: 0,1:18:01.42,1:18:04.01,Default,,0,0,0,,♪Осы үнемі өзгеріп отыратын әлемде
Dialogue: 0,1:18:04.13,1:18:08.10,Default,,0,0,0,,♪Нені жүземіз?
Dialogue: 0,1:18:12.18,1:18:14.27,Default,,0,0,0,,♪Нені көтереміз?
Dialogue: 0,1:18:18.31,1:18:20.57,Default,,0,0,0,,♪Сізбен кездесе аламын ба?
Dialogue: 0,1:18:24.53,1:18:26.74,Default,,0,0,0,,♪Бәрі біткенше
Dialogue: 0,1:18:31.70,1:18:33.25,Default,,0,0,0,,♪Осы саусақпен
Dialogue: 0,1:18:38.04,1:18:42.09,Default,,0,0,0,,♪Сурет салайық
Dialogue: 0,1:18:46.68,1:18:49.10,Default,,0,0,0,,～♪
Dialogue: 0,1:18:50.56,1:18:51.60,Default,,0,0,0,,Олай болса бастайық
Dialogue: 0,1:18:52.14,1:18:53.22,Default,,0,0,0,,[Тінтуірді басқан дыбыс]
Dialogue: 0,1:18:53.35,1:18:54.35,Default,,0,0,0,,Иә
Dialogue: 0,1:18:56.27,1:18:57.31,Default,,0,0,0,,Ағын
Dialogue: 0,1:18:57.44,1:19:00.44,Default,,0,0,0,,♪ [Компьютерден ойнатылатын музыка]
Dialogue: 0,1:19:08.49,1:19:09.32,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,1:19:09.45,1:19:10.70,Default,,0,0,0,,[Жедел жәрдем сиренасы]
Dialogue: 0,1:19:10.83,1:19:11.83,Default,,0,0,0,,Аха…
Dialogue: 0,1:19:11.95,1:19:14.16,Default,,0,0,0,,Уф... Не?!
Dialogue: 0,1:19:16.62,1:19:18.08,Default,,0,0,0,,Момока-сан!
Dialogue: 0,1:19:18.37,1:19:19.38,Default,,0,0,0,,А? (Нина) Кохон…
Dialogue: 0,1:19:19.79,1:19:22.25,Default,,0,0,0,,Мен алдыңғы тікелей эфирдегі реакцияны оқимын.
Dialogue: 0,1:19:22.88,1:19:25.84,Default,,0,0,0,,«Даидас - бұл Момока».
Dialogue: 0,1:19:26.42,1:19:30.05,Default,,0,0,0,,«Мен оның қазір Дайдасқа қарағанда рок болғанына сенімдімін».
Dialogue: 0,1:19:30.18,1:19:33.85,Default,,0,0,0,,Ху... Ол да Нинаны сүйкімді деп мақтады.
Dialogue: 0,1:19:34.02,1:19:35.31,Default,,0,0,0,,Бұл керемет (Момоканың есінеу)
Dialogue: 0,1:19:35.43,1:19:36.31,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,1:19:36.43,1:19:39.69,Default,,0,0,0,,Барлық тұтынушылар алдыңғы Дайдаларды жақсы көреді.
Dialogue: 0,1:19:40.10,1:19:41.81,Default,,0,0,0,,Сонымен? (Нина) Иә?
Dialogue: 0,1:19:42.06,1:19:43.73,Default,,0,0,0,,Оны интернетке жариялауым керек пе?
Dialogue: 0,1:19:43.86,1:19:46.32,Default,,0,0,0,,«Бүгінгі Дайдалар – жалған».
Dialogue: 0,1:19:46.44,1:19:50.07,Default,,0,0,0,,«Біз дұрыспыз, сондықтан бізді қолдаңыздар».
Dialogue: 0,1:19:50.78,1:19:52.03,Default,,0,0,0,,Сізге ұнамай ма?
Dialogue: 0,1:19:52.16,1:19:53.78,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,1:19:53.91,1:19:56.08,Default,,0,0,0,,Дайдастың қанша ізбасары бар екенін білесіз бе?
Dialogue: 0,1:19:56.45,1:19:57.41,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:19:59.29,1:20:01.46,Default,,0,0,0,,20 000... өсуде
Dialogue: 0,1:20:01.67,1:20:03.21,Default,,0,0,0,,Біз қаншамыз?
Dialogue: 0,1:20:03.96,1:20:05.34,Default,,0,0,0,,500 адам…
Dialogue: 0,1:20:05.59,1:20:07.09,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,1:20:07.22,1:20:09.34,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,1:20:09.47,1:20:13.55,Default,,0,0,0,,Біз әлі де анда-санда жиналып, жаттығу жасаймыз.
Dialogue: 0,1:20:13.68,1:20:15.97,Default,,0,0,0,,Ән жасаңыз және жанды дауыста орындаңыз...
Dialogue: 0,1:20:16.18,1:20:17.73,Default,,0,0,0,,Ал сен не істейсің?
Dialogue: 0,1:20:19.35,1:20:22.36,Default,,0,0,0,,Біздің топтың мақсаты қандай?
Dialogue: 0,1:20:22.81,1:20:24.23,Default,,0,0,0,,Сіз университетке барасыз ба?
Dialogue: 0,1:20:24.57,1:20:27.11,Default,,0,0,0,,Мен Момока-саннан оның мақсаттары туралы сұраймын.
Dialogue: 0,1:20:27.24,1:20:28.61,Default,,0,0,0,,Бұл азап.
Dialogue: 0,1:20:28.74,1:20:32.95,Default,,0,0,0,,Ваннаны қабылдағаннан кейін өзіңізді сергек сезіндіңіз, сондықтан оны бұзбаңыз.
Dialogue: 0,1:20:33.07,1:20:35.41,Default,,0,0,0,,Бірақ мен де бір нәрсе сұрағым келеді.
Dialogue: 0,1:20:36.66,1:20:39.66,Default,,0,0,0,,Момока-сан, сен кәсіпқой болған шығарсың.
Dialogue: 0,1:20:39.96,1:20:44.25,Default,,0,0,0,,Ондайлар біз сияқты өнерпаздармен топтарда ойнайды.
Dialogue: 0,1:20:44.38,1:20:46.21,Default,,0,0,0,,Біртүрлі екен, солай емес пе?
Dialogue: 0,1:20:46.34,1:20:48.84,Default,,0,0,0,,Қандай да бір мақсат бар ма деп ойлаймын.
Dialogue: 0,1:20:49.30,1:20:51.38,Default,,0,0,0,,Ештеңе ... ерекше ештеңе жоқ.
Dialogue: 0,1:20:51.51,1:20:53.47,Default,,0,0,0,,Сонда мақсат жоқ.
Dialogue: 0,1:20:53.72,1:20:55.22,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:20:56.85,1:20:58.10,Default,,0,0,0,,Дәл қазір...
Dialogue: 0,1:20:58.22,1:20:59.35,Default,,0,0,0,,[Төсекке құлау дыбысы]
Dialogue: 0,1:21:03.90,1:21:06.61,Default,,0,0,0,,«Топ» «Мақсат»…
Dialogue: 0,1:21:07.11,1:21:13.53,Default,,0,0,0,,♪ [Компьютерден ойнатылатын музыка]
Dialogue: 0,1:21:10.74,1:21:13.53,Default,,0,0,0,,``Көзімнің бұрышындағы ыдыраған дыбыс'' ♪Міне, өтіп бара жатыр
Dialogue: 0,1:21:14.24,1:21:17.24,Default,,0,0,0,,♪Әділдік құйын мен ағып жатқан қала
Dialogue: 0,1:21:17.41,1:21:20.45,Default,,0,0,0,,♪ Қалқымалы қалқыма, мен қайда барамын?
Dialogue: 0,1:21:20.58,1:21:23.25,Default,,0,0,0,,♪Баратын жерге күле алсаң
Dialogue: 0,1:21:23.37,1:21:26.84,Default,,0,0,0,,♪Қол ұстасайық, бұл арман емес
Dialogue: 0,1:21:27.00,1:21:27.88,Default,,0,0,0,,[Музыканы тоқтату]
Dialogue: 0,1:21:28.00,1:21:30.76,Default,,0,0,0,,«Мен ақшаны жоғалтқанша, бұрынғы қалпымда қалғанды жақсы көремін».
Dialogue: 0,1:21:30.88,1:21:34.05,Default,,0,0,0,,«Мен өзімді ренжіткенше, сол қалпымда қалғанды ​​жақсы көремін».
Dialogue: 0,1:21:34.18,1:21:37.51,Default,,0,0,0,,Менің ойымша, бұл мүлдем жаман идея емес.
Dialogue: 0,1:21:37.76,1:21:40.85,Default,,0,0,0,,Бірақ бұл жағдайда оны алып тастаңыз.
Dialogue: 0,1:21:41.18,1:21:42.52,Default,,0,0,0,,Бұл күлкілі
Dialogue: 0,1:21:45.56,1:21:48.02,Default,,0,0,0,,Қалай ойлайсың, Лупа жақсы жұмыс істейді ме?
Dialogue: 0,1:21:48.44,1:21:50.36,Default,,0,0,0,,Мен мұны түсінуге мүмкіндік жоқ.
Dialogue: 0,1:21:50.48,1:21:54.03,Default,,0,0,0,,Қаншалықты жақын болсақ та, төбелесіп, айырылысамыз.
Dialogue: 0,1:21:54.16,1:21:57.28,Default,,0,0,0,,Үйлесімділік Ең нашар жағдайда да ол жұмбақ түрде жалғасуы мүмкін
Dialogue: 0,1:21:59.49,1:22:04.21,Default,,0,0,0,,Дегенмен, менің ойымша, бұл үшеуі Томо-чанға жақсы сәйкес келеді.
Dialogue: 0,1:22:04.33,1:22:05.29,Default,,0,0,0,,Қай жағынан?
Dialogue: 0,1:22:05.79,1:22:07.08,Default,,0,0,0,,сондықтан қазір бұдан артық ештеңе айта алмаймын.
Dialogue: 0,1:22:08.09,1:22:10.05,Default,,0,0,0,,Біз қашаннан бері осылай сөйлесе бастадық?
Dialogue: 0,1:22:10.17,1:22:14.01,Default,,0,0,0,,Өйткені олай етпесең, Алмаз шаңын жеңе алмайсың.
Dialogue: 0,1:22:14.13,1:22:16.80,Default,,0,0,0,,Сонымен біз «жеңу» туралы қашан айта бастадық?
Dialogue: 0,1:22:21.97,1:22:23.18,Default,,0,0,0,,Сіз айтасыз
Dialogue: 0,1:22:23.31,1:22:25.73,Default,,0,0,0,,Мен Дайдасқа ренішім де жоқ...
Dialogue: 0,1:22:25.85,1:22:27.94,Default,,0,0,0,,Мен жеңілгім келмейді
Dialogue: 0,1:22:28.31,1:22:29.19,Default,,0,0,0,,біз қайта орала аламыз.
Dialogue: 0,1:22:29.32,1:22:33.32,Default,,0,0,0,,Бұл туралы армандап қана қоймай, өзіңіздің жеке жағдайларыңызды басқаларға жүктеңіз.
Dialogue: 0,1:22:34.36,1:22:35.70,Default,,0,0,0,,Б-барлаушы? Не туралы айтып тұрсыздар?
Dialogue: 0,1:22:35.91,1:22:39.70,Default,,0,0,0,,Бірақ мен әлі де жеңілгім келмейді.
Dialogue: 0,1:22:42.08,1:22:43.45,Default,,0,0,0,,[Есікті автоматты түрде ашу дыбысы]
Dialogue: 0,1:22:43.75,1:22:46.67,Default,,0,0,0,,Мен Нинаның сезімін түсінемін.
Dialogue: 0,1:22:46.79,1:22:48.21,Default,,0,0,0,,Қайырлы кеш!
Dialogue: 0,1:22:48.42,1:22:50.75,Default,,0,0,0,,Мен кенеттен кәсіби маман екенімді түсіндім...
Dialogue: 0,1:22:51.09,1:22:53.92,Default,,0,0,0,,Мен кәсіпқой болғаным үшін ғана жетістікке жетемін деп ойламаймын.
Dialogue: 0,1:22:54.13,1:22:56.59,Default,,0,0,0,,Мен Алмаз шаңын жеңе аламын деп ойламаймын.
Dialogue: 0,1:22:56.72,1:23:00.47,Default,,0,0,0,,Бірақ басынан жеңілсем де, берілгім келмейді.
Dialogue: 0,1:23:00.72,1:23:03.10,Default,,0,0,0,,Өйткені біз қателеспейміз.
Dialogue: 0,1:23:04.35,1:23:06.69,Default,,0,0,0,,Жасыл пиязсыз орташа.
Dialogue: 0,1:23:07.19,1:23:08.98,Default,,0,0,0,,Орташа
Dialogue: 0,1:23:09.11,1:23:10.69,Default,,0,0,0,,Иә, орташа 2 мылтық... (Даналық) Мм!
Dialogue: 0,1:23:10.82,1:23:11.65,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:11.86,1:23:12.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:14.49,1:23:15.49,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:16.24,1:23:17.45,Default,,0,0,0,,Бұл біраз кінәлі сезім емес пе?
Dialogue: 0,1:23:18.24,1:23:20.57,Default,,0,0,0,,Мен музыка ойнадым...
Dialogue: 0,1:23:20.70,1:23:22.95,Default,,0,0,0,,Иә, мен Рупамын
Dialogue: 0,1:23:23.08,1:23:24.58,Default,,0,0,0,,Бұл Сатоси Эбитсука
Dialogue: 0,1:23:25.00,1:23:27.33,Default,,0,0,0,,Екеуміз біраздан бері ән салып жүрміз.
Dialogue: 0,1:23:27.46,1:23:29.58,Default,,0,0,0,,Аа, мен мұны бұрын көргенмін.
Dialogue: 0,1:23:29.71,1:23:31.75,Default,,0,0,0,,Бұл туралы көп айтылды, солай емес пе?
Dialogue: 0,1:23:31.88,1:23:36.09,Default,,0,0,0,,Олар жүздерін көрсетпеді, бірақ нағыз тұлға осы екеуі.
Dialogue: 0,1:23:36.26,1:23:37.80,Default,,0,0,0,,Сүйкімді... (Томо) Буха!
Dialogue: 0,1:23:37.93,1:23:39.34,Default,,0,0,0,,Рахмет
Dialogue: 0,1:23:39.89,1:23:41.68,Default,,0,0,0,,Мүмкін сөйлесу керек шығар...
Dialogue: 0,1:23:41.80,1:23:44.22,Default,,0,0,0,,Фургондарға қарсы... әлде бір нәрсе ме? Жоқ.
Dialogue: 0,1:23:44.68,1:23:46.35,Default,,0,0,0,,Шағым? Жоқ.
Dialogue: 0,1:23:46.68,1:23:48.85,Default,,0,0,0,,Түсіндім! Біздің 10 000-шы тұтынушымыз
Dialogue: 0,1:23:48.98,1:23:49.98,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,1:23:50.10,1:23:51.94,Default,,0,0,0,,Уф...
Dialogue: 0,1:23:52.31,1:23:56.24,Default,,0,0,0,,Сенің түйсігің түтіккен, Скаут! барлаушы
Dialogue: 0,1:23:56.53,1:23:58.45,Default,,0,0,0,,Күшті сандар арқылы анықтауға болады... Жоқ.
Dialogue: 0,1:23:58.57,1:24:00.24,Default,,0,0,0,,Су-ка-у-то!
Dialogue: 0,1:24:00.57,1:24:02.62,Default,,0,0,0,,Скаут? ДДСҰ?
Dialogue: 0,1:24:02.74,1:24:03.99,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:24:04.54,1:24:05.66,Default,,0,0,0,,Кім?
Dialogue: 0,1:24:07.96,1:24:08.79,Default,,0,0,0,,Не!
Dialogue: 0,1:24:08.91,1:24:10.50,Default,,0,0,0,,Бәлкім, шығарып аларсың!?
Dialogue: 0,1:24:10.62,1:24:11.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:24:11.63,1:24:15.84,Default,,0,0,0,,Сіз үшеуіңізді де бізбен бірігуді сұрайсыз ба?
Dialogue: 0,1:24:16.13,1:24:16.96,Default,,0,0,0,,Өтірік…
Dialogue: 0,1:24:17.09,1:24:20.26,Default,,0,0,0,,Иә, мен кеше тікелей эфирді көрдім.
Dialogue: 0,1:24:20.72,1:24:21.93,Default,,0,0,0,,Өтірік…
Dialogue: 0,1:24:22.05,1:24:24.51,Default,,0,0,0,,Сондықтан мен Сатосимен сөйлесіп, шешім қабылдадым.
Dialogue: 0,1:24:24.85,1:24:27.27,Default,,0,0,0,,Мен мұны осы адамдармен сынап көргім келеді.
Dialogue: 0,1:24:27.39,1:24:29.60,Default,,0,0,0,,Өтірік!
Dialogue: 0,1:24:29.73,1:24:31.19,Default,,0,0,0,,Сөздік...
Dialogue: 0,1:24:31.60,1:24:34.90,Default,,0,0,0,,Келіңіздер, өтінемін (Нина/Субару) Мазалағаным үшін кешіріңіз.
Dialogue: 0,1:24:35.02,1:24:37.57,Default,,0,0,0,,Мен қазір шамды қосамын, күте тұрыңыз.
Dialogue: 0,1:24:37.69,1:24:38.86,Default,,0,0,0,,Иә
Dialogue: 0,1:24:39.20,1:24:40.86,Default,,0,0,0,,Осылай ма... Шабуыл!
Dialogue: 0,1:24:40.99,1:24:42.53,Default,,0,0,0,,Тым көп қозғалмаңыз!
Dialogue: 0,1:24:42.66,1:24:44.41,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:24:44.53,1:24:46.91,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,1:24:47.24,1:24:49.08,Default,,0,0,0,,Уау! Лизард!
Dialogue: 0,1:24:49.21,1:24:50.33,Default,,0,0,0,,Гекко!\NСонымен,
Dialogue: 0,1:24:50.58,1:24:53.21,Default,,0,0,0,,нысана - Будокан...
Dialogue: 0,1:24:53.33,1:24:55.21,Default,,0,0,0,,Ах! (Нина) Будокан?
Dialogue: 0,1:24:55.34,1:24:58.76,Default,,0,0,0,,Не... не! Бұл жерде ештеңе жоқ!
Dialogue: 0,1:24:58.88,1:25:02.89,Default,,0,0,0,,Бұл мүлде жаман емес, шын мәнінде бұл керемет.
Dialogue: 0,1:25:03.18,1:25:06.18,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,1:25:06.31,1:25:07.47,Default,,0,0,0,,Бұл Майюри ме?
Dialogue: 0,1:25:08.18,1:25:09.43,Default,,0,0,0,,Уау...
Dialogue: 0,1:25:10.77,1:25:13.27,Default,,0,0,0,,Айтпақшы, Будокан үлкен бе?
Dialogue: 0,1:25:13.40,1:25:14.98,Default,,0,0,0,,Не, сен білмейсің бе?
Dialogue: 0,1:25:15.19,1:25:19.24,Default,,0,0,0,,Мен бұл туралы естідім және теледидардан көрдім, бірақ...
Dialogue: 0,1:25:19.49,1:25:20.49,Default,,0,0,0,,Жерлес…
Dialogue: 0,1:25:20.61,1:25:22.57,Default,,0,0,0,,Томо-чан да Сендайда.
Dialogue: 0,1:25:22.70,1:25:25.78,Default,,0,0,0,,Не? Каваучи қаласы? Мен Кумамото!
Dialogue: 0,1:25:25.91,1:25:28.16,Default,,0,0,0,,Иә? «Миягидегі» Сендай!
Dialogue: 0,1:25:28.29,1:25:29.58,Default,,0,0,0,,Не?
Dialogue: 0,1:25:30.33,1:25:31.37,Default,,0,0,0,,Хехе
Dialogue: 0,1:25:31.50,1:25:34.92,Default,,0,0,0,,Енді барамыз ба? Бұдан былай
Dialogue: 0,1:25:35.63,1:25:36.63,Default,,0,0,0,,Иә? (Субару/Tomo) Иә?
Dialogue: 0,1:25:37.17,1:25:40.63,Default,,0,0,0,,Неге дәл осы уақытта келу керек?
Dialogue: 0,1:25:40.76,1:25:44.13,Default,,0,0,0,,Қашықтықты қысқарту маңызды.
Dialogue: 0,1:25:46.26,1:25:51.14,Default,,0,0,0,,(Өткізілетін жерден қатты дауыстар естілді)
Dialogue: 0,1:25:52.18,1:25:54.06,Default,,0,0,0,,Осы жерде ән айта алсам...
Dialogue: 0,1:25:54.19,1:25:55.02,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:56.94,1:26:00.69,Default,,0,0,0,,Осы жерде ән айта алсаңыз, қателеспегендей боласыз.
Dialogue: 0,1:26:00.82,1:26:03.78,Default,,0,0,0,,«Алмас шаңнан жеңілген жоқпын» деуге болады.
Dialogue: 0,1:26:04.49,1:26:05.49,Default,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,1:26:05.91,1:26:06.82,Default,,0,0,0,,Хехе
Dialogue: 0,1:26:07.95,1:26:11.83,Default,,0,0,0,,Будоканға ұмтылыңыз~!
Dialogue: 0,1:26:16.33,1:26:17.92,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,1:26:18.92,1:26:21.05,Default,,0,0,0,,Мен сенімен сөйлесуге тырысамын.
Dialogue: 0,1:26:21.17,1:26:22.51,Default,,0,0,0,,Мазмұнға өту
Dialogue: 0,1:26:23.22,1:26:26.05,Default,,0,0,0,,Бұл жалғыз нұсқа ма? әділ құбыжық
Dialogue: 0,1:26:26.18,1:26:28.80,Default,,0,0,0,,Бірақ басқа амал жоқ, солай ма?
Dialogue: 0,1:26:29.01,1:26:30.22,Default,,0,0,0,,Хмм...
Dialogue: 0,1:26:30.68,1:26:32.81,Default,,0,0,0,,Не? Біреу бар ма?
Dialogue: 0,1:26:33.06,1:26:34.81,Default,,0,0,0,,Мені «өтірікші» демейсің бе?
Dialogue: 0,1:26:34.94,1:26:35.77,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:36.48,1:26:39.73,Default,,0,0,0,,Мені өтірікші демесең, мен саған айтамын.
Dialogue: 0,1:26:39.94,1:26:42.94,Default,,0,0,0,,♪ [Смартфоннан ойнатылатын музыка]
Dialogue: 0,1:26:44.15,1:26:45.82,Default,,0,0,0,,Деңгейі жоғары.
Dialogue: 0,1:26:46.53,1:26:49.20,Default,,0,0,0,,Жалған нәрселердің арасында жақсы айырмашылық бар.
Dialogue: 0,1:26:49.33,1:26:50.45,Default,,0,0,0,,Демалыстар да жұмыс істейді
Dialogue: 0,1:26:50.58,1:26:53.87,Default,,0,0,0,,Дұрыс па? Оның үстіне негізгі кәсібім – бас және пернетақта.
Dialogue: 0,1:26:54.00,1:26:58.13,Default,,0,0,0,,Бір әнді бірге сынап көру жақсы болар еді деп ойладым.
Dialogue: 0,1:26:58.25,1:26:59.46,Default,,0,0,0,,Сонымен?
Dialogue: 0,1:26:59.79,1:27:01.50,Default,,0,0,0,,Олар не айтып жатыр?
Dialogue: 0,1:27:01.63,1:27:03.88,Default,,0,0,0,,«Міндетті түрде!» Немесе одан да көп…
Dialogue: 0,1:27:04.01,1:27:04.92,Default,,0,0,0,,[Тоқсыған дыбыс] (Нина) Мен...
Dialogue: 0,1:27:05.05,1:27:08.84,Default,,0,0,0,,Қалай болғанда да, мен келесі жексенбіде баптағым келеді.
Dialogue: 0,1:27:08.97,1:27:10.72,Default,,0,0,0,,Боссың ба? (Момока) Мүмкін...
Dialogue: 0,1:27:10.85,1:27:13.02,Default,,0,0,0,,Олай болса, шешілген кезде мен сізге хабарласамын!
Dialogue: 0,1:27:14.02,1:27:16.23,Default,,0,0,0,,Өтірікші! Сондықтан «стратегия»
Dialogue: 0,1:27:16.35,1:27:17.19,Default,,0,0,0,,Қайсысы?
Dialogue: 0,1:27:17.31,1:27:19.40,Default,,0,0,0,,Жарайды, келісемін, келісемін.
Dialogue: 0,1:27:19.52,1:27:20.81,Default,,0,0,0,,Қарсы болыңыз...
Dialogue: 0,1:27:20.94,1:27:22.36,Default,,0,0,0,,Бұл не!
Dialogue: 0,1:27:22.65,1:27:25.28,Default,,0,0,0,,Мен оны осылай көрдім.
Dialogue: 0,1:27:25.40,1:27:28.11,Default,,0,0,0,,Мүмкін екі Момока бар шығар.
Dialogue: 0,1:27:28.74,1:27:32.37,Default,,0,0,0,,Музыка ойнағанда байсалды болыңыз және оған барыңызды беріңіз.
Dialogue: 0,1:27:32.62,1:27:34.91,Default,,0,0,0,,Мен мүмкіндігінше жақсы нәрсе жасағым келеді
Dialogue: 0,1:27:35.50,1:27:39.21,Default,,0,0,0,,Менің әнім орындалатынын көргім келеді.
Dialogue: 0,1:27:40.96,1:27:44.96,Default,,0,0,0,,Бірақ мен музыкадан алшақтап кеткенде, өз-өзіме келемін.
Dialogue: 0,1:27:45.80,1:27:48.97,Default,,0,0,0,,Ол жарыстан шығып, бас тартқанын айтты.
Dialogue: 0,1:27:49.43,1:27:53.93,Default,,0,0,0,,Менің ойымша, сіз: «Мұны істеудің мәні бар ма?» деп ойлайтын шығарсыз.
Dialogue: 0,1:27:54.06,1:27:56.98,Default,,0,0,0,,Түсіндім... (Даналық) Бірге жасай аламыз ба?
Dialogue: 0,1:27:57.39,1:27:58.35,Default,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,1:27:58.85,1:28:01.69,Default,,0,0,0,,Бірақ егер сіз жақсы дыбысқа немесе топқа түскіңіз келсе,
Dialogue: 0,1:28:01.81,1:28:03.69,Default,,0,0,0,,Мен қарсы тұра алмайтындай сезінемін.
Dialogue: 0,1:28:03.82,1:28:06.36,Default,,0,0,0,,Ол кісінің жүрегі музыкант!
Dialogue: 0,1:28:06.49,1:28:07.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:28:09.03,1:28:10.53,Default,,0,0,0,,Олар енді үйлеріне кетсе екен.
Dialogue: 0,1:28:12.16,1:28:13.70,Default,,0,0,0,,-де? Сен не істеп жатырсың?
Dialogue: 0,1:28:13.83,1:28:16.37,Default,,0,0,0,,Соңғы тікелей эфирдегі әнді пайдалана аламын ба?
Dialogue: 0,1:28:16.50,1:28:18.96,Default,,0,0,0,,Жарайды, бірақ мұны екі адам жасай ала ма?
Dialogue: 0,1:28:19.08,1:28:21.13,Default,,0,0,0,,Иә, Момока келгенше.
Dialogue: 0,1:28:21.25,1:28:23.42,Default,,0,0,0,,Мен жай ғана тыңдап, жаттықтым.
Dialogue: 0,1:28:23.54,1:28:25.80,Default,,0,0,0,,Мен кейбір шараларды жасаймын.
Dialogue: 0,1:28:25.92,1:28:27.30,Default,,0,0,0,,Барсам болады ма?
Dialogue: 0,1:28:27.42,1:28:28.63,Default,,0,0,0,,Бір минут күтіңіз [гитара дыбысы]\NЕгер бұл
Dialogue: 0,1:28:28.76,1:28:31.18,Default,,0,0,0,,болса, неге оны бірден қолданып көрмеске?
Dialogue: 0,1:28:31.30,1:28:32.59,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,1:28:33.35,1:28:35.10,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,1:28:36.56,1:28:37.98,Default,,0,0,0,,Бір екі үш төрт
Dialogue: 0,1:28:38.10,1:28:41.10,Default,,0,0,0,,♪～
Dialogue: 0,1:28:45.77,1:28:46.90,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,1:28:47.03,1:28:48.86,Default,,0,0,0,,Бұл не? Керемет...
Dialogue: 0,1:28:51.95,1:28:55.08,Default,,0,0,0,,``Менің көзқарасымның бұрышындағы ыдыраудың дыбысы'' ♪Әділдік құйын мен ағып жатқан қала
Dialogue: 0,1:28:55.20,1:28:58.37,Default,,0,0,0,,♪ Қалқымалы қалқыма, мен қайда барамын?
Dialogue: 0,1:28:58.50,1:29:01.08,Default,,0,0,0,,♪Осы үнемі өзгеріп отыратын әлемде
Dialogue: 0,1:29:01.21,1:29:05.25,Default,,0,0,0,,♪Нені жүземіз?
Dialogue: 0,1:29:12.43,1:29:14.76,Default,,0,0,0,,～♪
Dialogue: 0,1:29:15.51,1:29:17.35,Default,,0,0,0,,Мм... Момока-сан
Dialogue: 0,1:29:18.18,1:29:19.81,Default,,0,0,0,,Негізі екі адамға арналған
Dialogue: 0,1:29:19.93,1:29:22.77,Default,,0,0,0,,Олар: «Бұдан былай бірге жұмыс істегіңіз келе ме?» - деді.
Dialogue: 0,1:29:24.27,1:29:26.57,Default,,0,0,0,,Мен оны көргім келеді.
Dialogue: 0,1:29:26.69,1:29:28.86,Default,,0,0,0,,«Момока-сан қателеспейді».
Dialogue: 0,1:29:28.98,1:29:31.28,Default,,0,0,0,,«Момоканың әні ешкімді жеңбейді»
Dialogue: 0,1:29:31.49,1:29:33.32,Default,,0,0,0,,Мен оны дәлелдегім келеді.
Dialogue: 0,1:29:38.54,1:29:39.37,Default,,0,0,0,,Фестиваль?
Dialogue: 0,1:29:39.50,1:29:42.29,Default,,0,0,0,,Бірінші қадам - ​​бұл жерде назар аудару.
Dialogue: 0,1:29:42.58,1:29:46.13,Default,,0,0,0,,Фестивальдар сонымен қатар музыка индустриясындағы адамдар үшін сауда жәрмеңкесі болып табылады.
Dialogue: 0,1:29:46.25,1:29:48.17,Default,,0,0,0,,Барлығы сені іздеуге келді, солай ма?
Dialogue: 0,1:29:48.30,1:29:50.92,Default,,0,0,0,,«Дөрекі гауһар» деп аталатын
Dialogue: 0,1:29:51.22,1:29:52.72,Default,,0,0,0,,Қайда...
Dialogue: 0,1:29:52.84,1:29:53.68,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:54.22,1:29:55.68,Default,,0,0,0,,Алмаз шаңы…
Dialogue: 0,1:30:04.19,1:30:05.94,Default,,0,0,0,,[Камера ысырмасының дыбысы] Мен сізге тілектеспін!
Dialogue: 0,1:30:06.31,1:30:07.48,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,1:30:08.02,1:30:10.23,Default,,0,0,0,,Иә, танысқаныма қуаныштымын!
Dialogue: 0,1:30:10.69,1:30:13.70,Default,,0,0,0,,Уау... Лупа сондай танымал~
Dialogue: 0,1:30:13.82,1:30:16.91,Default,,0,0,0,,Оның орнына мен топтың атын дұрыс шешемін.
Dialogue: 0,1:30:17.03,1:30:17.91,Default,,0,0,0,,Иә...
Dialogue: 0,1:30:18.03,1:30:19.37,Default,,0,0,0,,Әкем полицияда қызмет етеді.
Dialogue: 0,1:30:22.20,1:30:23.16,Default,,0,0,0,,Иә
Dialogue: 0,1:30:24.16,1:30:25.17,Default,,0,0,0,,Тікелей ме?
Dialogue: 0,1:30:25.29,1:30:26.21,Default,,0,0,0,,Иә
Dialogue: 0,1:30:26.33,1:30:28.96,Default,,0,0,0,,Жаңа бастаған кезімде қамқор болған адам.
Dialogue: 0,1:30:29.09,1:30:31.00,Default,,0,0,0,,Мұны бірге жасағыңыз келе ме?
Dialogue: 0,1:30:31.17,1:30:32.67,Default,,0,0,0,,Орналасқан жері Қайда?
Dialogue: 0,1:30:33.05,1:30:34.34,Default,,0,0,0,,Наганодағы Сува
Dialogue: 0,1:30:34.47,1:30:37.85,Default,,0,0,0,,Алдын ала жаттығу жасап, содан кейін сол түнде нақты қойылымды орындаңыз.
Dialogue: 0,1:30:37.97,1:30:39.47,Default,,0,0,0,,Мен үйге солай қайтайын.
Dialogue: 0,1:30:39.60,1:30:42.43,Default,,0,0,0,,Бос емеспін, сондықтан жалғыз барсам жақсы.
Dialogue: 0,1:30:42.56,1:30:45.44,Default,,0,0,0,,Әсіресе Нинаның үйренетіні көп деп ойлаймын.
Dialogue: 0,1:30:45.56,1:30:47.15,Default,,0,0,0,,Кеттік! Эй?
Dialogue: 0,1:30:47.27,1:30:50.02,Default,,0,0,0,,Сіз байсалдысыз ба? Менің ойыным әлі дірілдеп тұр.
Dialogue: 0,1:30:50.15,1:30:53.44,Default,,0,0,0,,Бірақ жақсы емес пе?
Dialogue: 0,1:30:54.53,1:30:56.32,Default,,0,0,0,,Егер Лупа солай айтса, жақсы...
Dialogue: 0,1:30:56.78,1:30:58.78,Default,,0,0,0,,Танысқаныма қуаныштымын~
Dialogue: 0,1:30:58.91,1:31:00.41,Default,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,1:31:00.70,1:31:01.83,Default,,0,0,0,,Ал...
Dialogue: 0,1:31:02.37,1:31:03.20,Default,,0,0,0,,Не?
Dialogue: 0,1:31:03.58,1:31:07.25,Default,,0,0,0,,Топты қалай атаймыз?
Dialogue: 0,1:31:08.13,1:31:09.33,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:31:09.50,1:31:10.96,Default,,0,0,0,,Шоколад! Болдырма! Армандаған қыз!
Dialogue: 0,1:31:14.88,1:31:16.26,Default,,0,0,0,,Бұл катакана емес.
Dialogue: 0,1:31:16.38,1:31:17.93,Default,,0,0,0,,хираганадағы «Чоко-то».
Dialogue: 0,1:31:18.05,1:31:21.05,Default,,0,0,0,,Хиго Моккосу күткендей таңғажайып нәрсе келді
Dialogue: 0,1:31:21.18,1:31:22.97,Default,,0,0,0,,Бұл тым тәтті және сізге қуыстар береді.
Dialogue: 0,1:31:23.10,1:31:24.02,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,1:31:24.14,1:31:25.85,Default,,0,0,0,,Не? «Болдыру»?
Dialogue: 0,1:31:25.98,1:31:27.19,Default,,0,0,0,,Бұл...
Dialogue: 0,1:31:27.31,1:31:29.40,Default,,0,0,0,,Менікінен әлдеқайда ұят
Dialogue: 0,1:31:29.52,1:31:31.65,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,1:31:31.77,1:31:33.40,Default,,0,0,0,,Екеуі де!
Dialogue: 0,1:31:33.53,1:31:35.78,Default,,0,0,0,,Сонда Субару-чандікі қандай?
Dialogue: 0,1:31:35.90,1:31:38.24,Default,,0,0,0,,Иә! қайталап көріңіз
Dialogue: 0,1:31:39.32,1:31:40.91,Default,,0,0,0,,Армандағы қыз…
Dialogue: 0,1:31:41.41,1:31:42.24,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:31:42.66,1:31:45.70,Default,,0,0,0,,Бір күнді босқа өткізу...
Dialogue: 0,1:31:49.88,1:31:52.75,Default,,0,0,0,,Ха... мен кешігіп қалдым.
Dialogue: 0,1:31:53.09,1:31:54.46,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,1:31:55.38,1:31:58.68,Default,,0,0,0,,Топ!? Сондықтан менің бағаларым құлдырап барады...
Dialogue: 0,1:31:59.76,1:32:00.89,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,1:32:01.01,1:32:03.56,Default,,0,0,0,,Жарайды, маған да қыстақ мектебінен телефон соғады.
Dialogue: 0,1:32:03.68,1:32:05.72,Default,,0,0,0,,Егер сіздің бағаларыңыз түсіп, үзіліс жасасаңыз!
Dialogue: 0,1:32:05.85,1:32:07.35,Default,,0,0,0,,Қосымша заттар...
Dialogue: 0,1:32:07.48,1:32:11.15,Default,,0,0,0,,Әкеңнің келмей қалғанына шүкіршілік ет.
Dialogue: 0,1:32:13.73,1:32:14.78,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,1:32:16.61,1:32:17.99,Default,,0,0,0,,Үйден шығу
Dialogue: 0,1:32:22.32,1:32:23.45,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,1:32:23.58,1:32:27.37,Default,,0,0,0,,Бұл сіздің үйге ешқашан бара алмайтыныңызды білдіреді.
Dialogue: 0,1:32:28.46,1:32:29.54,Default,,0,0,0,,Әрине
Dialogue: 0,1:32:30.08,1:32:32.04,Default,,0,0,0,,Менің әкем жаман болған деп ойлаймын.
Dialogue: 0,1:32:36.13,1:32:37.30,Default,,0,0,0,,[Лақтырылған кітаптардың дыбысы]
Dialogue: 0,1:32:37.42,1:32:39.63,Default,,0,0,0,,(Нинаның ауыр тыныс алуы)
Dialogue: 0,1:32:39.76,1:32:43.22,Default,,0,0,0,,Мен харизматикалық мұғалім ретінде осындай кітап жазып жатырмын.
Dialogue: 0,1:32:43.35,1:32:46.81,Default,,0,0,0,,Қызымның мектепке барудан бас тартуын қабылдай алмадым.
Dialogue: 0,1:32:47.02,1:32:50.23,Default,,0,0,0,,Менің ойымша, сіз де қатты зардап шегесіз.
Dialogue: 0,1:32:50.73,1:32:53.61,Default,,0,0,0,,Бірақ әкеңнің не айтып тұрғанын түсіндім.
Dialogue: 0,1:32:54.02,1:32:56.94,Default,,0,0,0,,Кем дегенде, егер олар қорқытуды дұрыс жасаса
Dialogue: 0,1:32:57.07,1:32:58.94,Default,,0,0,0,,Мен мектепке несие бере алдым.
Dialogue: 0,1:32:59.07,1:33:02.32,Default,,0,0,0,,Сіздің бағаларыңызбен мен сізге кеңес бере алар едім.
Dialogue: 0,1:33:02.74,1:33:04.91,Default,,0,0,0,,Бұл алдау.
Dialogue: 0,1:33:05.70,1:33:07.70,Default,,0,0,0,,«Сіз университетке өз бетіңізше түсе аласыз»
Dialogue: 0,1:33:07.83,1:33:09.91,Default,,0,0,0,,Осыны айту үшін келдің емес пе?
Dialogue: 0,1:33:11.79,1:33:14.84,Default,,0,0,0,,Дегенмен, сіз бұлай жай ғана ``үйден кету'' мүмкін емес.
Dialogue: 0,1:33:14.96,1:33:17.50,Default,,0,0,0,,Мен күткендей, сенің иығыңнан ұстай алмаймын.
Dialogue: 0,1:33:20.59,1:33:24.22,Default,,0,0,0,,Қараңдар! Мен ертең таңертең жаттығу жасаймын, сондықтан асығармын.
Dialogue: 0,1:33:24.34,1:33:25.43,Default,,0,0,0,,Иә
Dialogue: 0,1:33:26.10,1:33:27.26,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,1:33:27.39,1:33:28.39,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:28.85,1:33:31.73,Default,,0,0,0,,Бұл Чуо экспресс жолы, солай ма? Сосын көшеге шық...
Dialogue: 0,1:33:31.85,1:33:33.10,Default,,0,0,0,,Мүмкін мен де байқап көрермін.
Dialogue: 0,1:33:34.65,1:33:36.69,Default,,0,0,0,,Бұл нұсқаулық па? сирек
Dialogue: 0,1:33:36.98,1:33:41.03,Default,,0,0,0,,Досымнан сұрасам, менде жалғыз осы болды.
Dialogue: 0,1:33:41.15,1:33:43.74,Default,,0,0,0,,Мм... Мен сенімдімін...
Dialogue: 0,1:33:43.86,1:33:45.07,Default,,0,0,0,,[Қозғалтқышты іске қосу дыбысы]
Dialogue: 0,1:33:45.20,1:33:46.83,Default,,0,0,0,,О, міне...
Dialogue: 0,1:33:47.45,1:33:49.41,Default,,0,0,0,,[Қозғалтқыштың тоқтау дыбысы]
Dialogue: 0,1:33:49.95,1:33:50.83,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,1:33:50.95,1:33:53.75,Default,,0,0,0,,Жүргізушіні ауыстыруды жақтайтын тұлғалар
Dialogue: 0,1:33:56.71,1:33:58.84,Default,,0,0,0,,Рупа мырза, сіз көлікті жақсы басқарасыз.
Dialogue: 0,1:33:59.09,1:34:02.09,Default,,0,0,0,,Мен ортада үзіліс жасаймын, сондықтан соңына дейін жете аласыз ба?
Dialogue: 0,1:34:02.22,1:34:04.59,Default,,0,0,0,,Сіз менің көлік жүргізуімді соншалықты жек көресіз бе?
Dialogue: 0,1:34:06.18,1:34:07.10,Default,,0,0,0,,Хмм...
Dialogue: 0,1:34:07.97,1:34:09.97,Default,,0,0,0,,Демалайық па?
Dialogue: 0,1:34:12.73,1:34:15.60,Default,,0,0,0,,(Оқушылар сөйлейді)
Dialogue: 0,1:34:19.61,1:34:20.73,Default,,0,0,0,,Міне, не болғаны
Dialogue: 0,1:34:22.24,1:34:23.32,Default,,0,0,0,,Баяу…
Dialogue: 0,1:34:24.32,1:34:26.82,Default,,0,0,0,,Бұл не... (Нина) Басқаша болғаны жақсы емес пе?
Dialogue: 0,1:34:27.82,1:34:29.33,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:34:29.74,1:34:30.95,Default,,0,0,0,,Жақсы
Dialogue: 0,1:34:36.21,1:34:37.42,Default,,0,0,0,,Сатоши-чан
Dialogue: 0,1:34:37.92,1:34:39.75,Default,,0,0,0,,Мектепті неге тастадыңыз?
Dialogue: 0,1:34:40.25,1:34:41.59,Default,,0,0,0,,Неліктен сұрайсыз?
Dialogue: 0,1:34:42.26,1:34:44.59,Default,,0,0,0,,Өйткені тыңдайтын ешкім жоқ...
Dialogue: 0,1:34:45.01,1:34:48.26,Default,,0,0,0,,Менің ондай жерде ерінуге уақытым болмады.
Dialogue: 0,1:34:48.39,1:34:50.31,Default,,0,0,0,,Ата-ана жоқ сияқты
Dialogue: 0,1:34:50.43,1:34:54.10,Default,,0,0,0,,Оқуды бітірген соң өз бетімше бірдеңе істеуім керек болды.
Dialogue: 0,1:34:57.19,1:34:58.48,Default,,0,0,0,,Ана?
Dialogue: 0,1:34:58.65,1:34:59.98,Default,,0,0,0,,[Есіктің ашылған дыбысы]
Dialogue: 0,1:35:00.69,1:35:01.73,Default,,0,0,0,,Ха...
Dialogue: 0,1:35:03.86,1:35:05.49,Default,,0,0,0,,Мен танымайтын адаммен...
Dialogue: 0,1:35:05.65,1:35:07.74,Default,,0,0,0,,Бұл басқа жаратылыс сияқты болды.
Dialogue: 0,1:35:08.57,1:35:11.79,Default,,0,0,0,,Сол ананы көріп, бірден қосқышты қостым.
Dialogue: 0,1:35:12.04,1:35:16.54,Default,,0,0,0,,Қазіргі кезде әншілердің 18-20 жаста болуы ғажап емес.
Dialogue: 0,1:35:16.92,1:35:19.50,Default,,0,0,0,,Неғұрлым тезірек бастасаңыз, соғұрлым жақсы
Dialogue: 0,1:35:20.04,1:35:23.26,Default,,0,0,0,,Сондықтан дереу Токиоға келіңіз және мүшелерді жинаңыз.
Dialogue: 0,1:35:23.80,1:35:27.26,Default,,0,0,0,,Мектепке бару бос уақыт болды.
Dialogue: 0,1:35:27.38,1:35:28.51,Default,,0,0,0,,Солай ет.
Dialogue: 0,1:35:29.14,1:35:33.89,Default,,0,0,0,,Бұл таңқаларлық, мен бұл туралы ешқашан ойламадым.
Dialogue: 0,1:35:34.02,1:35:36.31,Default,,0,0,0,,Сенетін адам болмаса не болады?
Dialogue: 0,1:35:36.44,1:35:38.56,Default,,0,0,0,,Кез келген адам бірден осылай ойлай алады.
Dialogue: 0,1:35:38.69,1:35:40.90,Default,,0,0,0,,Рупаның отбасы апаттан қайтыс болғанда...
Dialogue: 0,1:35:42.19,1:35:44.15,Default,,0,0,0,,Ол бұл туралы ойлағанын айтты.
Dialogue: 0,1:35:44.61,1:35:47.15,Default,,0,0,0,,Мен: Мүлдем...
Dialogue: 0,1:35:48.61,1:35:50.16,Default,,0,0,0,,[Терезені қағу]
Dialogue: 0,1:35:51.32,1:35:54.41,Default,,0,0,0,,Мен әрқашан осындай нәрсені жасағым келді.
Dialogue: 0,1:35:54.66,1:35:56.20,Default,,0,0,0,,Иә, күліңіз~!
Dialogue: 0,1:35:56.33,1:35:59.29,Default,,0,0,0,,Момока-сан мен Томо-чан, тағы да күліңіз
Dialogue: 0,1:35:59.67,1:36:01.92,Default,,0,0,0,,Иә! Өтінемін, ірімшік айтыңыз.
Dialogue: 0,1:36:02.04,1:36:03.46,Default,,0,0,0,,[Ысырма дыбысы]
Dialogue: 0,1:36:04.59,1:36:06.09,Default,,0,0,0,,Пұт сияқты
Dialogue: 0,1:36:06.34,1:36:07.34,Default,,0,0,0,,Үндетпе
Dialogue: 0,1:36:10.80,1:36:13.01,Default,,0,0,0,,♪ [Студиядан тыңдалған музыка]
Dialogue: 0,1:36:13.81,1:36:15.68,Default,,0,0,0,,[Орындау аяқталады]
Dialogue: 0,1:36:16.60,1:36:19.10,Default,,0,0,0,,Уф... Бұл өте жақсы болды.
Dialogue: 0,1:36:19.23,1:36:21.44,Default,,0,0,0,,Ол қайда? Шырылдау емес
Dialogue: 0,1:36:21.56,1:36:24.48,Default,,0,0,0,,Иә? Бұл екі адам қиналып жатыр.
Dialogue: 0,1:36:24.61,1:36:26.44,Default,,0,0,0,,Бұлай болуы мүмкін емес!
Dialogue: 0,1:36:26.57,1:36:28.11,Default,,0,0,0,,Екеуі де, екеуі де!
Dialogue: 0,1:36:28.24,1:36:31.11,Default,,0,0,0,,Оның орнына Субару-чанның мойыны қайырылған.
Dialogue: 0,1:36:31.24,1:36:33.58,Default,,0,0,0,,Мен білемін! Мен қате ұйықтадым!
Dialogue: 0,1:36:33.70,1:36:36.29,Default,,0,0,0,,Бұл Момоның жаңа тобы ма...
Dialogue: 0,1:36:36.41,1:36:37.25,Default,,0,0,0,,Момо?
Dialogue: 0,1:36:37.37,1:36:38.21,Default,,0,0,0,,Иә!
Dialogue: 0,1:36:38.33,1:36:39.25,Default,,0,0,0,,[Гулп] Иә!?
Dialogue: 0,1:36:39.37,1:36:40.71,Default,,0,0,0,,Әй, менің мойным сауығып кетті...
Dialogue: 0,1:36:41.04,1:36:44.34,Default,,0,0,0,,Жақсы, жақсы деп айтпас едім, бірақ ұнатпайды.
Dialogue: 0,1:36:44.92,1:36:46.51,Default,,0,0,0,,Елеусіз болудан гөрі
Dialogue: 0,1:36:46.84,1:36:50.18,Default,,0,0,0,,Кешіріңіз, мен сіздің жолыңызға кедергі келтірмеу үшін барымды саламын.
Dialogue: 0,1:36:50.51,1:36:52.26,Default,,0,0,0,,Ах... анау гитара
Dialogue: 0,1:36:52.55,1:36:54.43,Default,,0,0,0,,Иә, өзгеріс жоқ.
Dialogue: 0,1:36:54.55,1:36:55.89,Default,,0,0,0,,Сондай-ақ Момодан алған стикер
Dialogue: 0,1:36:56.06,1:36:56.89,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,1:36:57.02,1:36:57.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:36:57.97,1:36:58.89,Default,,0,0,0,,Хехе
Dialogue: 0,1:36:59.77,1:37:03.61,Default,,0,0,0,,Не айтайын, кейіпкерлері әртүрлі...
Dialogue: 0,1:37:03.73,1:37:05.19,Default,,0,0,0,,Бастапқыда шығар
Dialogue: 0,1:37:05.32,1:37:08.40,Default,,0,0,0,,Мүмкін солай болған шығар, Момока-сан.
Dialogue: 0,1:37:08.78,1:37:12.28,Default,,0,0,0,,Мен сенімен соңғы бір ән айтқым келеді, жарай ма?
Dialogue: 0,1:37:12.41,1:37:15.58,Default,,0,0,0,,Жақсысың ба? Керісінше, бұл біз
Dialogue: 0,1:37:15.70,1:37:18.54,Default,,0,0,0,,Момомен ойнағым келгендіктен саған қоңырау шалдым...
Dialogue: 0,1:37:18.66,1:37:21.08,Default,,0,0,0,,Бұл балалар да жақсы ма?
Dialogue: 0,1:37:21.46,1:37:23.33,Default,,0,0,0,,Бұл әлем сызығы өзгерді деген сөз бе?
Dialogue: 0,1:37:23.54,1:37:26.67,Default,,0,0,0,,Біз сессия өткізу туралы сөйлестік.
Dialogue: 0,1:37:26.80,1:37:29.46,Default,,0,0,0,,Сессия? (Момока) Бірге ән айту
Dialogue: 0,1:37:30.26,1:37:31.97,Default,,0,0,0,,Вокалист сізсіз, солай ма?
Dialogue: 0,1:37:32.13,1:37:33.13,Default,,0,0,0,,Иә
Dialogue: 0,1:37:34.30,1:37:39.14,Default,,0,0,0,,«Сол күннің қош бол әуені» ♪Сол күннің қош бол әуені
Dialogue: 0,1:37:39.27,1:37:43.73,Default,,0,0,0,,♪Бір күні тағы кездескенше
Dialogue: 0,1:37:44.15,1:37:46.44,Default,,0,0,0,,♪Ересек болу
Dialogue: 0,1:37:46.57,1:37:48.73,Default,,0,0,0,,♪Тағы да
Dialogue: 0,1:37:48.98,1:37:53.20,Default,,0,0,0,,♪Ұмытып кетсең де
Dialogue: 0,1:37:53.32,1:37:54.53,Default,,0,0,0,,～♪
Dialogue: 0,1:37:54.74,1:37:55.74,Default,,0,0,0,,Сіз қалай ойлайсыз? (Нина) Иә?
Dialogue: 0,1:37:56.07,1:37:57.66,Default,,0,0,0,,Сіз ән айта аласыз ба? (Нина) А... иә.
Dialogue: 0,1:37:57.78,1:38:00.50,Default,,0,0,0,,Мүмкін, бірақ... Мен бар күшімді саламын.
Dialogue: 0,1:38:00.62,1:38:04.12,Default,,0,0,0,,Хехе... Сосын шешілді. Мен дүкен менеджеріне айтамын.
Dialogue: 0,1:38:04.25,1:38:06.21,Default,,0,0,0,,[Есіктің ашылу және жабылу дыбысы]
Dialogue: 0,1:38:06.79,1:38:08.88,Default,,0,0,0,,Бұл жақсы ән (Нина) Иә!
Dialogue: 0,1:38:09.34,1:38:11.01,Default,,0,0,0,,Токио Мен шыққан кезде
Dialogue: 0,1:38:11.13,1:38:14.34,Default,,0,0,0,,Мен Мин-санның жанды дауыстағы орындауын көргенде солай ойладым.
Dialogue: 0,1:38:16.26,1:38:19.06,Default,,0,0,0,,Бұл ашылу актісі бойынша бонус сияқты болды.
Dialogue: 0,1:38:19.18,1:38:23.14,Default,,0,0,0,,Бір қадам артқа шегінбей, әндерімен төбелесіп жатқандай.
Dialogue: 0,1:38:23.73,1:38:26.52,Default,,0,0,0,,«О, бұл рок»…
Dialogue: 0,1:38:27.44,1:38:30.23,Default,,0,0,0,,Бұл менің соңғы тікелей шоуыма өте ыңғайлы.
Dialogue: 0,1:38:31.78,1:38:32.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:33.78,1:38:38.12,Default,,0,0,0,,Мен жұмыстан шығамын. Бұл топтың өнер көрсетуі ертең аяқталады.
Dialogue: 0,1:38:38.24,1:38:39.37,Default,,0,0,0,,Мен кетемін
Dialogue: 0,1:38:40.16,1:38:42.16,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:38:42.45,1:38:43.33,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,1:38:43.46,1:38:47.29,Default,,0,0,0,,Менің арқамда осы топпен кәсіпқой болуды мақсат еткім келмейді.
Dialogue: 0,1:38:47.46,1:38:48.59,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,1:38:48.71,1:38:52.67,Default,,0,0,0,,Өйткені мен шығаратын әндер кәсіби әлемде жұмыс істемейді.
Dialogue: 0,1:38:53.01,1:38:57.64,Default,,0,0,0,,Менің әнім Нинаға ұнағанына қуаныштымын.
Dialogue: 0,1:38:57.76,1:39:00.81,Default,,0,0,0,,Мен де сіздің байсалды болғаныңызға ризамын.
Dialogue: 0,1:39:00.93,1:39:01.81,Default,,0,0,0,,Рахмет
Dialogue: 0,1:39:01.93,1:39:03.18,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,1:39:03.48,1:39:04.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:39:07.56,1:39:08.94,Default,,0,0,0,,[Есік жабылған дыбыс] (Момока) Жақсы.
Dialogue: 0,1:39:09.19,1:39:11.07,Default,,0,0,0,,[Бірден ішу дыбысы]
Dialogue: 0,1:39:11.44,1:39:14.57,Default,,0,0,0,,Пхуха~! Апыр-ай!
Dialogue: 0,1:39:14.99,1:39:16.49,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,1:39:16.95,1:39:19.45,Default,,0,0,0,,Ертеңгі өміріңізді дұрыс жасаңыз.
Dialogue: 0,1:39:19.57,1:39:21.91,Default,,0,0,0,,Бұл тұтынушыларға сыпайылық.
Dialogue: 0,1:39:22.04,1:39:23.12,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,1:39:23.24,1:39:25.50,Default,,0,0,0,,Не? Сіз қорқынышты көрінесіз (Нина) Ех...
Dialogue: 0,1:39:26.04,1:39:28.17,Default,,0,0,0,,Не? Дау ма?
Dialogue: 0,1:39:30.25,1:39:31.88,Default,,0,0,0,,А, одан да көп!
Dialogue: 0,1:39:32.00,1:39:34.76,Default,,0,0,0,,Мине-сан қандай әндерді ұнатады?
Dialogue: 0,1:39:34.88,1:39:38.26,Default,,0,0,0,,Музыканы тастауға тырысып көрдіңіз бе?
Dialogue: 0,1:39:38.39,1:39:40.97,Default,,0,0,0,,Сіз не туралы айтып тұрсыз?
Dialogue: 0,1:39:41.10,1:39:43.01,Default,,0,0,0,,Сіз тітіркендіргішсіз! Уф...
Dialogue: 0,1:39:43.60,1:39:46.81,Default,,0,0,0,,Менің ойымша, сізге қорытынды жасау ұнамайды.
Dialogue: 0,1:39:47.44,1:39:51.40,Default,,0,0,0,,Неғұрлым көп жалғастырсаңыз, нәтижелер соғұрлым анық болады.
Dialogue: 0,1:39:51.52,1:39:55.44,Default,,0,0,0,,Бірінші рет жақсы өтпесе де, бұл жай ғана «бақытсыз».
Dialogue: 0,1:39:55.57,1:39:59.28,Default,,0,0,0,,Егер сіз екі рет тырыссаңыз, нәтиже шықпаса, адамдар бұл сіздің «қабілетіңіз» деп айтады.
Dialogue: 0,1:40:00.32,1:40:03.41,Default,,0,0,0,,Мұның жақсы болатынына сенбейсіз бе?
Dialogue: 0,1:40:06.08,1:40:08.12,Default,,0,0,0,,Мен сенгім келеді.
Dialogue: 0,1:40:08.42,1:40:12.42,Default,,0,0,0,,Бірақ мен оған сенсем және бұл жақсы емес болып шықса, мен одан да көп зардап шегемін.
Dialogue: 0,1:40:12.92,1:40:17.30,Default,,0,0,0,,Бұл қорқынышты, өйткені мен музыканы қатты жақсы көремін.
Dialogue: 0,1:40:20.39,1:40:22.05,Default,,0,0,0,,Олай болса, ертең кездескенше.
Dialogue: 0,1:40:24.97,1:40:25.81,Default,,0,0,0,,Бұл!
Dialogue: 0,1:40:26.60,1:40:27.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:27.93,1:40:30.69,Default,,0,0,0,,Мине-сан, қорықпайсың ба?
Dialogue: 0,1:40:30.94,1:40:32.77,Default,,0,0,0,,Мен? (Нина) Иә...
Dialogue: 0,1:40:35.98,1:40:37.53,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,1:40:37.65,1:40:41.07,Default,,0,0,0,,Қазір де ұйықтай алмаймын, тамақ іше алмаймын.
Dialogue: 0,1:40:41.36,1:40:42.53,Default,,0,0,0,,Қазір де?
Dialogue: 0,1:40:42.66,1:40:43.70,Default,,0,0,0,,Әрине
Dialogue: 0,1:40:43.83,1:40:48.41,Default,,0,0,0,,Бірақ шын жақсы көретін ісіңді жұмысқа айналдыру деген осы.
Dialogue: 0,1:40:48.54,1:40:50.37,Default,,0,0,0,,Мен бұл туралы музыкалық колледжге барғанда ойладым.
Dialogue: 0,1:40:50.50,1:40:53.75,Default,,0,0,0,,Мен мектепте мұғалім болып, хобби ретінде ән айта беремін...
Dialogue: 0,1:40:54.79,1:40:58.47,Default,,0,0,0,,Менің ойымша, бұл ең ақылды нәрсе.
Dialogue: 0,1:40:59.84,1:41:02.14,Default,,0,0,0,,Неліктен мұны істемедің?
Dialogue: 0,1:41:02.26,1:41:03.72,Default,,0,0,0,,Неге...
Dialogue: 0,1:41:04.05,1:41:06.01,Default,,0,0,0,,Мен ұмытып кетіппін.
Dialogue: 0,1:41:06.64,1:41:07.47,Default,,0,0,0,,Ұмыту керек пе?
Dialogue: 0,1:41:07.93,1:41:08.93,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:41:09.39,1:41:13.77,Default,,0,0,0,,Дегенмен, мен үшін сахна – айтқым келгенімді айта алатын орын.
Dialogue: 0,1:41:13.90,1:41:15.40,Default,,0,0,0,,Менің сүйікті жерім
Dialogue: 0,1:41:15.73,1:41:18.99,Default,,0,0,0,,Сондықтан ол қаншалықты қорқынышты, ауыртпалық болса да, оған көмектесу мүмкін емес ...
Dialogue: 0,1:41:19.65,1:41:21.99,Default,,0,0,0,,Мүмкін сіз солай ойлаған шығарсыз.
Dialogue: 0,1:41:22.61,1:41:23.49,Default,,0,0,0,,Хи хи хи...
Dialogue: 0,1:41:24.87,1:41:26.99,Default,,0,0,0,,Сәлем! (Нина/Мені) Иә?
Dialogue: 0,1:41:27.24,1:41:28.62,Default,,0,0,0,,Уау! (Нина) Уау!
Dialogue: 0,1:41:29.00,1:41:30.91,Default,,0,0,0,,Не! Сәкең сұмдық... (Менің күлкісі)
Dialogue: 0,1:41:31.04,1:41:33.92,Default,,0,0,0,,Не дедіңіз! Мен бір тамшы да ішкен жоқпын...
Dialogue: 0,1:41:34.04,1:41:36.42,Default,,0,0,0,,Ондай өтірікті оңай айта аласыз!
Dialogue: 0,1:41:36.54,1:41:38.84,Default,,0,0,0,,Сіз шулысыз.
Dialogue: 0,1:41:38.96,1:41:40.97,Default,,0,0,0,,Әрқашан әрқашан әрқашан әрқашан...
Dialogue: 0,1:41:41.09,1:41:42.05,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,1:41:43.26,1:41:44.14,Default,,0,0,0,,Уф...
Dialogue: 0,1:41:44.51,1:41:47.31,Default,,0,0,0,,Әй, тыңдап тұрсың ба!
Dialogue: 0,1:41:48.26,1:41:49.85,Default,,0,0,0,,Момока туралы Танысқаныма қуаныштымын!
Dialogue: 0,1:41:49.97,1:41:52.85,Default,,0,0,0,,Не? аздап! Мұнымен не істейсің?
Dialogue: 0,1:41:52.98,1:41:55.52,Default,,0,0,0,,Нина! Бұл алдау!
Dialogue: 0,1:41:57.52,1:41:59.73,Default,,0,0,0,,Кешіріңіз, көл, қайсысы?
Dialogue: 0,1:42:01.36,1:42:03.24,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:42:10.87,1:42:14.25,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:42:17.96,1:42:19.21,Default,,0,0,0,,Шешім
Dialogue: 0,1:42:19.80,1:42:22.47,Default,,0,0,0,,Шешім! Мен шештім, шештім, шештім!
Dialogue: 0,1:42:22.59,1:42:25.13,Default,,0,0,0,,Мен шештім!
Dialogue: 0,1:42:28.60,1:42:29.93,Default,,0,0,0,,[отшашулардың дыбысы]
Dialogue: 0,1:42:35.85,1:42:37.02,Default,,0,0,0,,Мен шештім...
Dialogue: 0,1:42:39.11,1:42:41.28,Default,,0,0,0,,(қолдау мен қол шапалақтау)
Dialogue: 0,1:42:41.40,1:42:43.90,Default,,0,0,0,,Мине-сан!
Dialogue: 0,1:42:44.40,1:42:45.61,Default,,0,0,0,,Рахмет
Dialogue: 0,1:42:45.74,1:42:48.91,Default,,0,0,0,,Келесі менің сүйікті тобым, сондықтан тыңдаңыздар!
Dialogue: 0,1:42:52.08,1:42:52.91,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:42:53.29,1:42:54.16,Default,,0,0,0,,Иә!
Dialogue: 0,1:42:54.58,1:42:57.67,Default,,0,0,0,,...Енді ойлап қарасам, топтың аты кім? (Нина) Әй! Хехе
Dialogue: 0,1:42:57.96,1:42:58.92,Default,,0,0,0,,Шешім қабылданды ма?
Dialogue: 0,1:42:59.21,1:43:02.67,Default,,0,0,0,,Мен тамақ ішіп отырып шешейік дедім, болды...
Dialogue: 0,1:43:02.80,1:43:06.97,Default,,0,0,0,,Егер бұл «Шин-Кавасаки» болса... жақсы, екеуі де жақсы.
Dialogue: 0,1:43:07.34,1:43:08.18,Default,,0,0,0,,Иә?
Dialogue: 0,1:43:08.64,1:43:09.47,Default,,0,0,0,,Иә?
Dialogue: 0,1:43:10.01,1:43:13.06,Default,,0,0,0,,Қайырлы кеш! біз...
Dialogue: 0,1:43:11.60,1:43:13.06,Default,,0,0,0,,Иә!? (Сатоши) Ол жігіт...
Dialogue: 0,1:43:13.18,1:43:16.52,Default,,0,0,0,,Ах... у...
Dialogue: 0,1:43:17.27,1:43:18.61,Default,,0,0,0,,Хмм...
Dialogue: 0,1:43:19.73,1:43:20.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:43:25.61,1:43:27.57,Default,,0,0,0,,«Жұмыртқалы құмырсқа»!
Dialogue: 0,1:43:27.78,1:43:28.82,Default,,0,0,0,,ше? иә?
Dialogue: 0,1:43:29.32,1:43:32.04,Default,,0,0,0,,Мен киген футболкамен бірдей~
Dialogue: 0,1:43:32.16,1:43:33.83,Default,,0,0,0,,Мұндай сәйкестіктер бар ғой, солай ма?
Dialogue: 0,1:43:35.37,1:43:36.66,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,1:43:36.79,1:43:40.88,Default,,0,0,0,,Осы көктемде кенеттен топ аштым.
Dialogue: 0,1:43:41.00,1:43:44.01,Default,,0,0,0,,Неге бұлай істеп жатырсың? Неге ән айтасың?
Dialogue: 0,1:43:44.13,1:43:48.09,Default,,0,0,0,,Мен оны шынымен түсінбедім, бірақ қызық болды...
Dialogue: 0,1:43:48.55,1:43:51.93,Default,,0,0,0,,Өмірімде бірінші рет бір нәрсеге әуестендім...
Dialogue: 0,1:43:53.64,1:43:55.14,Default,,0,0,0,,Жүр, тезірек.
Dialogue: 0,1:43:55.81,1:43:59.69,Default,,0,0,0,,Өмірімде мені қатты тебіренткен бір ән бар.
Dialogue: 0,1:43:59.81,1:44:03.36,Default,,0,0,0,,Бұл ән маған қатты әсер етті.
Dialogue: 0,1:44:04.28,1:44:08.61,Default,,0,0,0,,Сондықтан әннің дұрыс екенін дәлелдегім келеді.
Dialogue: 0,1:44:08.74,1:44:10.99,Default,,0,0,0,,Сол әнмен адамдардың жүрегін елжірет
Dialogue: 0,1:44:11.12,1:44:13.91,Default,,0,0,0,,Мен айтқым келеді: «Уау, бұл керемет».
Dialogue: 0,1:44:14.04,1:44:18.00,Default,,0,0,0,,Субару-чан, Лупа-сан, Сатоши-чан және Момока-санмен
Dialogue: 0,1:44:18.46,1:44:21.08,Default,,0,0,0,,Барлығының ойы ұқсас екеніне сенімдімін.
Dialogue: 0,1:44:21.50,1:44:23.67,Default,,0,0,0,,Міне, сондықтан мен қатты жұмыс істеп жатырмын.
Dialogue: 0,1:44:23.92,1:44:26.76,Default,,0,0,0,,Бұл қорқынышты, бірақ мен сенемін және бар күшімді саламын.
Dialogue: 0,1:44:27.34,1:44:28.93,Default,,0,0,0,,Сонымен, мен
Dialogue: 0,1:44:29.26,1:44:30.18,Default,,0,0,0,,Мен... [Дон! ]
Dialogue: 0,1:44:30.30,1:44:31.14,Default,,0,0,0,,Уау!
Dialogue: 0,1:44:32.30,1:44:33.51,Default,,0,0,0,,Бұл тітіркендіргіш
Dialogue: 0,1:44:34.97,1:44:36.43,Default,,0,0,0,,Өзіңізбен сөйлесіңіз!
Dialogue: 0,1:44:36.77,1:44:37.64,Default,,0,0,0,,Иә...
Dialogue: 0,1:44:41.27,1:44:44.94,Default,,0,0,0,,Сонымен... неткен бассыздық!
Dialogue: 0,1:44:45.23,1:44:46.28,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:44:46.40,1:44:48.53,Default,,0,0,0,,[Барабан дыбысы]
Dialogue: 0,1:44:48.95,1:44:50.11,Default,,0,0,0,,``Аты жоқ бәрі'' ♪Бұл әрқашан жәй ғана ауырады ма?
Dialogue: 0,1:44:50.24,1:44:51.16,Default,,0,0,0,,♪ Дене де, ақыл да
Dialogue: 0,1:44:51.28,1:44:53.70,Default,,0,0,0,,♪Ол құлап жатыр
Dialogue: 0,1:44:54.08,1:44:55.20,Default,,0,0,0,,♪Құштарлық пен салқын жүректілік
Dialogue: 0,1:44:55.33,1:44:59.25,Default,,0,0,0,,♪ Менің басым айналады
Dialogue: 0,1:45:09.59,1:45:10.59,Default,,0,0,0,,♪Бәрі өтірік
Dialogue: 0,1:45:10.72,1:45:12.05,Default,,0,0,0,,♪Бірінен соң бірі ұшады
Dialogue: 0,1:45:12.18,1:45:13.51,Default,,0,0,0,,♪Қалаға секірді
Dialogue: 0,1:45:14.60,1:45:16.51,Default,,0,0,0,,♪Сасық иіспен қабатталған шу ішінде
Dialogue: 0,1:45:16.64,1:45:19.02,Default,,0,0,0,,♪Жалғыздықта айқайлау
Dialogue: 0,1:45:19.39,1:45:21.94,Default,,0,0,0,,♪Ештеңе емес, бірақ күнің қалай өтті?
Dialogue: 0,1:45:22.06,1:45:24.48,Default,,0,0,0,,♪Осындай ақымақ сөздерді айтпа
Dialogue: 0,1:45:24.61,1:45:27.78,Default,,0,0,0,,♪Басым әлі жылап тұр
Dialogue: 0,1:45:27.90,1:45:30.15,Default,,0,0,0,,♪Үйренген дауыс жаңғырық
Dialogue: 0,1:45:30.36,1:45:35.41,Default,,0,0,0,,♪ «Мен қорықпаймын, сондықтан жасырма, менімен билейік»
Dialogue: 0,1:45:35.53,1:45:38.12,Default,,0,0,0,,♪Мен қорқынышты әлемнен қашқым келеді
Dialogue: 0,1:45:39.20,1:45:42.25,Default,,0,0,0,,♪Енді шашу, шашу, шашу
Dialogue: 0,1:45:42.37,1:45:45.38,Default,,0,0,0,,♪Жұмсақ, ақырын, мені жалғыз қалдырма
Dialogue: 0,1:45:45.67,1:45:49.84,Default,,0,0,0,,♪Барларда тізілген мұң сияқты
Dialogue: 0,1:45:49.96,1:45:52.55,Default,,0,0,0,,♪Мәңгілік және мәңгі
Dialogue: 0,1:45:52.68,1:45:55.76,Default,,0,0,0,,♪Махаббатымды дәлелдей алмайынша мәңгілік
Dialogue: 0,1:45:55.89,1:45:59.97,Default,,0,0,0,,♪Махаббат сезім екеніне сенгім келмейді
Dialogue: 0,1:46:00.10,1:46:03.39,Default,,0,0,0,,♪Жынды болу
Dialogue: 0,1:46:16.32,1:46:17.33,Default,,0,0,0,,～♪
Dialogue: 0,1:46:17.45,1:46:20.29,Default,,0,0,0,,(қуаныш)
Dialogue: 0,1:46:20.45,1:46:21.91,Default,,0,0,0,,Нина!
Dialogue: 0,1:46:25.21,1:46:27.00,Default,,0,0,0,,Хаха...
Dialogue: 0,1:46:30.51,1:46:31.34,Default,,0,0,0,,Лупа мырза
Dialogue: 0,1:46:32.26,1:46:33.30,Default,,0,0,0,,Сатоши-чан
Dialogue: 0,1:46:34.05,1:46:35.34,Default,,0,0,0,,Субару-чан
Dialogue: 0,1:46:36.30,1:46:37.47,Default,,0,0,0,,Момока-сан
Dialogue: 0,1:46:38.60,1:46:39.72,Default,,0,0,0,,Мен...
Dialogue: 0,1:46:40.77,1:46:42.48,Default,,0,0,0,,Мектептен бас тарту
Dialogue: 0,1:46:44.10,1:46:45.65,Default,,0,0,0,,Ача~
Dialogue: 0,1:46:48.82,1:46:51.03,Default,,0,0,0,,Хмф!
Dialogue: 0,1:46:51.15,1:46:52.11,Default,,0,0,0,,Хмм!
Dialogue: 0,1:46:53.49,1:46:56.49,Default,,0,0,0,,♪～
Dialogue: 0,1:47:03.29,1:47:08.04,Default,,0,0,0,,«Маған өмір сыйла» ♪Аспан мен үшін жылайды
Dialogue: 0,1:47:08.42,1:47:13.13,Default,,0,0,0,,♪Менде бәрі жақсы.
Dialogue: 0,1:47:13.55,1:47:20.85,Default,,0,0,0,,♪Тәнімді, санамды қанша ойып тастаса да
Dialogue: 0,1:47:21.10,1:47:26.48,Default,,0,0,0,,♪Менде бәрі жақсы.
Dialogue: 0,1:47:28.60,1:47:33.36,Default,,0,0,0,,♪Мен көптен бері жүрдім.
Dialogue: 0,1:47:33.73,1:47:38.45,Default,,0,0,0,,♪Тыныштық шырылдаған мына жерге
Dialogue: 0,1:47:38.74,1:47:42.87,Default,,0,0,0,,♪Бұл саябақ сол күйінде қалды.
Dialogue: 0,1:47:43.04,1:47:48.12,Default,,0,0,0,,♪Бұл менің жалғыз орным
Dialogue: 0,1:47:48.25,1:47:55.42,Default,,0,0,0,,♪Жаңбырдың жүрек соғысы иығымда
Dialogue: 0,1:47:55.76,1:48:00.72,Default,,0,0,0,,♪Мен күшті бола алмаймын Мен дұрыс бола алмаймын
Dialogue: 0,1:48:00.85,1:48:05.64,Default,,0,0,0,,♪Неге сонша шіркін?
Dialogue: 0,1:48:05.98,1:48:10.06,Default,,0,0,0,,♪Маған не болғанын айтыңыз.
Dialogue: 0,1:48:10.19,1:48:14.44,Default,,0,0,0,,♪Алла, маған өмір бере гөр
Dialogue: 0,1:48:24.20,1:48:28.92,Default,,0,0,0,,♪Мен неге тірімін деп ойлаймын
Dialogue: 0,1:48:29.29,1:48:33.96,Default,,0,0,0,,♪Шулы кеңістікте
Dialogue: 0,1:48:34.34,1:48:38.47,Default,,0,0,0,,♪Мен де бетімді жеп тұрған мына тыртықты жек көремін.
Dialogue: 0,1:48:38.59,1:48:43.68,Default,,0,0,0,,♪Дыбыс шығармай ғана құлаймын
Dialogue: 0,1:48:43.80,1:48:48.68,Default,,0,0,0,,♪Бәрінің бақытын алсам да
Dialogue: 0,1:48:48.89,1:48:53.81,Default,,0,0,0,,♪ Жетпейді Мүлдем жетпейді
Dialogue: 0,1:48:54.07,1:48:57.90,Default,,0,0,0,,♪Бұл жүрек нашар ма?
Dialogue: 0,1:48:58.03,1:49:03.16,Default,,0,0,0,,♪Мен спектакль емеспін
Dialogue: 0,1:49:03.28,1:49:07.58,Default,,0,0,0,,♪Сіз сияқты
Dialogue: 0,1:49:08.87,1:49:12.58,Default,,0,0,0,,♪Мен болғым келеді
Dialogue: 0,1:49:24.18,1:49:29.14,Default,,0,0,0,,♪Мықты бола алмаймын, дұрыс айта алмаймын
Dialogue: 0,1:49:29.27,1:49:34.06,Default,,0,0,0,,♪Неге шіркін?
Dialogue: 0,1:49:34.40,1:49:38.48,Default,,0,0,0,,♪Маған не болғанын айтыңыз.
Dialogue: 0,1:49:38.61,1:49:43.36,Default,,0,0,0,,♪Алла, маған өмір бер
Dialogue: 0,1:49:43.66,1:49:52.87,Default,,0,0,0,,♪Алла, мені қазір кешіре гөр.
Dialogue: 0,1:50:05.43,1:50:08.47,Default,,0,0,0,,～♪
Dialogue: 0,1:50:09.97,1:50:15.97,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
