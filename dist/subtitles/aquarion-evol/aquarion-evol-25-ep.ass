Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.58,0:00:43.62,Default,,0,0,0,,Ақыры мен сені кездестірдім
Dialogue: 0,0:00:43.62,0:00:45.62,Default,,0,0,0,,Жоғалған бөлік
Dialogue: 0,0:00:50.93,0:00:53.69,Default,,0,0,0,,Ақыры мен сені кездестірдім
Dialogue: 0,0:00:53.69,0:00:55.69,Default,,0,0,0,,Жетіспейтін бөлік
Dialogue: 0,0:01:07.74,0:01:09.84,Default,,0,0,0,,Оны не бұзды...
Dialogue: 0,0:01:54.19,0:01:56.59,Default,,0,0,0,,Кагура
Dialogue: 0,0:02:00.49,0:02:02.43,Default,,0,0,0,,Тек сен...
Dialogue: 0,0:02:02.43,0:02:04.43,Default,,0,0,0,,Мен сені кешірмеймін!
Dialogue: 0,0:03:51.74,0:03:56.08,Default,,0,0,0,,Уф... Изумо.
Dialogue: 0,0:03:56.08,0:03:58.08,Default,,0,0,0,,Иә? Sylphy
Dialogue: 0,0:04:01.48,0:04:05.49,Default,,0,0,0,,Сильфия
Dialogue: 0,0:04:05.49,0:04:08.76,Default,,0,0,0,,Мен сені ешқашан ұмытпаймын
Dialogue: 0,0:04:08.76,0:04:11.06,Default,,0,0,0,,Дүние болса да
Dialogue: 0,0:04:21.10,0:04:23.04,Default,,0,0,0,,Не?
Dialogue: 0,0:04:23.04,0:04:25.11,Default,,0,0,0,,Қылмыскер?
Dialogue: 0,0:04:25.11,0:04:29.44,Default,,0,0,0,,Сен менсің
Dialogue: 0,0:04:29.44,0:04:32.41,Default,,0,0,0,,Жоқ, азғындық
Dialogue: 0,0:04:32.41,0:04:34.41,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:04:46.79,0:04:49.30,Default,,0,0,0,,Механикалық періштенің сәтсіздігі?
Dialogue: 0,0:04:49.30,0:04:52.10,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:04:52.10,0:04:54.03,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:04:54.03,0:04:56.44,Default,,0,0,0,,Бастапқыда мен сен едім
Dialogue: 0,0:04:56.44,0:04:58.91,Default,,0,0,0,,Өйткені сен мен болдым
Dialogue: 0,0:04:58.91,0:05:00.98,Default,,0,0,0,,Сондықтан мен оны кешіре алмаймын
Dialogue: 0,0:05:00.98,0:05:03.11,Default,,0,0,0,,Мен сені кешіре алмаймын!
Dialogue: 0,0:05:03.11,0:05:06.98,Default,,0,0,0,,Не? сен біздің әкемізді өлтірдің
Dialogue: 0,0:05:06.98,0:05:08.98,Default,,0,0,0,,Әке? Ол кім?
Dialogue: 0,0:05:08.98,0:05:11.22,Default,,0,0,0,,Альтеяның Жоғарғы Көшбасшысы
Dialogue: 0,0:05:11.22,0:05:13.22,Default,,0,0,0,,Бұл Изумо
Dialogue: 0,0:05:16.59,0:05:19.09,Default,,0,0,0,,Сіз үшін
Dialogue: 0,0:05:19.09,0:05:22.49,Default,,0,0,0,,Уф, сен кінәлісің.
Dialogue: 0,0:05:30.14,0:05:32.07,Default,,0,0,0,,Уф
Dialogue: 0,0:05:32.07,0:05:34.07,Default,,0,0,0,,Үніңді жап, әлсіреген Амата.
Dialogue: 0,0:05:36.41,0:05:39.18,Default,,0,0,0,,Бір адам қосылса ше?
Dialogue: 0,0:05:39.18,0:05:41.12,Default,,0,0,0,,Сіз мұны істей аласыз
Dialogue: 0,0:05:41.12,0:05:43.72,Default,,0,0,0,,Менің қолымнан келмейтін іс жоқ.
Dialogue: 0,0:05:46.39,0:05:48.49,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:05:51.03,0:05:53.03,Default,,0,0,0,,«Біз оның әйелі мен балаларын қауіпсіз жерге жеткіздік»
Dialogue: 0,0:05:54.93,0:05:56.93,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:06:01.60,0:06:03.60,Default,,0,0,0,,Не?
Dialogue: 0,0:06:08.21,0:06:10.21,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:06:13.05,0:06:15.05,Default,,0,0,0,,Уау! Уф
Dialogue: 0,0:06:23.26,0:06:27.06,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:06:29.56,0:06:32.26,Default,,0,0,0,,Екіге бөлінген жан сынығы
Dialogue: 0,0:06:34.40,0:06:38.97,Default,,0,0,0,,Ал механикалық періштенің бөліктері біріктірілді.
Dialogue: 0,0:06:38.97,0:06:40.91,Default,,0,0,0,,Қазір уақыт
Dialogue: 0,0:06:40.91,0:06:44.91,Default,,0,0,0,,Қызыл түс пен көк депрессияның кездесуі басталады
Dialogue: 0,0:07:01.90,0:07:03.90,Default,,0,0,0,,Ах
Dialogue: 0,0:07:27.05,0:07:29.59,Default,,0,0,0,,Төраға Клэр
Dialogue: 0,0:07:29.59,0:07:31.96,Default,,0,0,0,,Қызыл жұлдыз
Dialogue: 0,0:07:31.96,0:07:34.19,Default,,0,0,0,,Яғни
Dialogue: 0,0:07:34.19,0:07:36.13,Default,,0,0,0,,Althea Huh?
Dialogue: 0,0:07:36.13,0:07:38.13,Default,,0,0,0,,Гепард реакциясын ұстаныңыз
Dialogue: 0,0:07:38.13,0:07:40.57,Default,,0,0,0,,Ол ұрлаушымен соғысып жатқан сияқты.
Dialogue: 0,0:07:40.57,0:07:42.57,Default,,0,0,0,,Не?
Dialogue: 0,0:07:46.51,0:07:48.51,Default,,0,0,0,,ＭＩＸ
Dialogue: 0,0:07:53.85,0:07:57.38,Default,,0,0,0,,Мені қабылдаңыз MIX
Dialogue: 0,0:07:57.38,0:08:00.69,Default,,0,0,0,,Кеңістіктік өтемақы
Dialogue: 0,0:08:00.69,0:08:03.39,Default,,0,0,0,,Энди
Dialogue: 0,0:08:03.39,0:08:05.46,Default,,0,0,0,,Егер сіз өзіңіздің қабілеттеріңізді одан әрі пайдалансаңыз, сіздің денеңіз де пайдаланады
Dialogue: 0,0:08:05.46,0:08:09.73,Default,,0,0,0,,Осы жерде тоқтасақ, MIX не болады?
Dialogue: 0,0:08:09.73,0:08:13.07,Default,,0,0,0,,MIX-тен ешқашан бас тартпаңыз
Dialogue: 0,0:08:13.07,0:08:15.87,Default,,0,0,0,,Мен сені құшағыма алғанша
Dialogue: 0,0:08:19.01,0:08:21.21,Default,,0,0,0,,ＭＩＸ
Dialogue: 0,0:08:21.21,0:08:23.21,Default,,0,0,0,,Уау! Ах
Dialogue: 0,0:08:25.85,0:08:28.82,Default,,0,0,0,,күрсіну... АРАЛАШ
Dialogue: 0,0:08:28.82,0:08:32.62,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:08:32.62,0:08:35.06,Default,,0,0,0,,Мен сенің тесікіңді толтырғым келеді
Dialogue: 0,0:08:35.06,0:08:38.29,Default,,0,0,0,,Ах!Уф...
Dialogue: 0,0:08:38.29,0:08:40.89,Default,,0,0,0,,Мен тесіктерді жек көремін.
Dialogue: 0,0:08:40.89,0:08:43.23,Default,,0,0,0,,Мен сені жек көремін!
Dialogue: 0,0:08:43.23,0:08:45.20,Default,,0,0,0,,ＭＩＸ
Dialogue: 0,0:08:45.20,0:08:47.30,Default,,0,0,0,,Уф Энди
Dialogue: 0,0:08:51.57,0:08:53.51,Default,,0,0,0,,Жетеді
Dialogue: 0,0:08:53.51,0:08:55.44,Default,,0,0,0,,Осылай жүре берсек, бізді MIX басып қалады.
Dialogue: 0,0:08:55.44,0:08:59.35,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:08:59.35,0:09:01.35,Default,,0,0,0,,ＭＩＸ
Dialogue: 0,0:09:01.35,0:09:05.05,Default,,0,0,0,,Сенің жүрегіңде саңылау бар
Dialogue: 0,0:09:05.05,0:09:08.49,Default,,0,0,0,,Мен
Dialogue: 0,0:09:08.49,0:09:10.89,Default,,0,0,0,,Ең бастысы, ертең L-ді өлтіру керек пе, жоқ па деген сұрақ
Dialogue: 0,0:09:15.16,0:09:17.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:17.43,0:09:19.73,Default,,0,0,0,,ＭＩＸ
Dialogue: 0,0:09:22.67,0:09:24.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:31.38,0:09:33.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:42.06,0:09:44.09,Default,,0,0,0,,Соңында
Dialogue: 0,0:09:44.09,0:09:47.36,Default,,0,0,0,,Мен сені құшақтай алдым
Dialogue: 0,0:09:47.36,0:09:50.36,Default,,0,0,0,,Менің... MIX
Dialogue: 0,0:09:50.36,0:09:52.36,Default,,0,0,0,,Га
Dialogue: 0,0:09:54.50,0:09:57.30,Default,,0,0,0,,Жоғалған естеліктердегі бос орындар толтырылуда
Dialogue: 0,0:10:00.24,0:10:02.18,Default,,0,0,0,,жоғалған
Dialogue: 0,0:10:02.18,0:10:04.58,Default,,0,0,0,,Әйел кезіндегі естеліктерім
Dialogue: 0,0:10:06.78,0:10:10.28,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:10:18.03,0:10:20.03,Default,,0,0,0,,Энди
Dialogue: 0,0:10:20.03,0:10:22.03,Default,,0,0,0,,Га
Dialogue: 0,0:10:24.20,0:10:28.07,Default,,0,0,0,,Уф
Dialogue: 0,0:10:28.07,0:10:30.67,Default,,0,0,0,,ＭＩＸ
Dialogue: 0,0:10:30.67,0:10:35.21,Default,,0,0,0,,Энди сен
Dialogue: 0,0:10:35.21,0:10:38.11,Default,,0,0,0,,Энди
Dialogue: 0,0:10:38.11,0:10:40.51,Default,,0,0,0,,MIX Жақсы
Dialogue: 0,0:10:40.51,0:10:42.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:42.45,0:10:44.55,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:10:46.72,0:10:50.59,Default,,0,0,0,,Мен
Dialogue: 0,0:10:50.59,0:10:53.49,Default,,0,0,0,,MIX Мен қазірдің өзінде бармын
Dialogue: 0,0:10:53.49,0:10:55.59,Default,,0,0,0,,Қыз
Dialogue: 0,0:11:00.20,0:11:03.50,Default,,0,0,0,,Жарайды, иә?
Dialogue: 0,0:11:03.50,0:11:06.77,Default,,0,0,0,,Ер адамсың ба, әйелсің бе бәрібір.
Dialogue: 0,0:11:06.77,0:11:09.14,Default,,0,0,0,,Мен MIXмын
Dialogue: 0,0:11:09.14,0:11:11.61,Default,,0,0,0,,Өйткені маған ұнайды
Dialogue: 0,0:11:11.61,0:11:13.61,Default,,0,0,0,,Энди
Dialogue: 0,0:11:15.48,0:11:17.48,Default,,0,0,0,,Одақ
Dialogue: 0,0:11:17.48,0:11:20.12,Default,,0,0,0,,Мен мұны істей аламын ба?
Dialogue: 0,0:11:20.12,0:11:22.12,Default,,0,0,0,,Иә
Dialogue: 0,0:11:22.12,0:11:24.39,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:11:24.39,0:11:27.06,Default,,0,0,0,,Жарайды, күте тұрыңыз.
Dialogue: 0,0:11:27.06,0:11:30.93,Default,,0,0,0,,Жағдайдың қандай екенін білесіз бе?
Dialogue: 0,0:11:30.93,0:11:34.17,Default,,0,0,0,,Әрқашан қорғаған жан тазалығым
Dialogue: 0,0:11:34.17,0:11:36.10,Default,,0,0,0,,Өңделген манипуляция
Dialogue: 0,0:11:36.10,0:11:39.04,Default,,0,0,0,,Қазір жарылыс уақыты
Dialogue: 0,0:11:39.04,0:11:41.04,Default,,0,0,0,,Хонкай одағы
Dialogue: 0,0:11:41.04,0:11:43.24,Default,,0,0,0,,GO Aquarion!
Dialogue: 0,0:11:45.38,0:11:49.25,Default,,0,0,0,,А? Мен сені мазалап жүрмін
Dialogue: 0,0:11:49.25,0:11:51.45,Default,,0,0,0,,О, о? Ах
Dialogue: 0,0:11:53.72,0:11:55.66,Default,,0,0,0,,Уау
Dialogue: 0,0:11:55.66,0:11:58.19,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:11:58.19,0:12:00.19,Default,,0,0,0,,ЖӘНЕ АРАЛАСТЫРУ
Dialogue: 0,0:12:02.10,0:12:05.73,Default,,0,0,0,,Кагура, мен сенің қасыңда болдым.
Dialogue: 0,0:12:05.73,0:12:09.37,Default,,0,0,0,,Менің әкем де, шешем де осында, Альтеяда.
Dialogue: 0,0:12:09.37,0:12:11.91,Default,,0,0,0,,Уф, сен маған ұқсамайсың.
Dialogue: 0,0:12:11.91,0:12:14.47,Default,,0,0,0,,Мен барлығына ие болатын жерде болдым.
Dialogue: 0,0:12:14.47,0:12:16.47,Default,,0,0,0,,Ал дегенмен!
Dialogue: 0,0:12:19.25,0:12:22.15,Default,,0,0,0,,Әй
Dialogue: 0,0:12:22.15,0:12:25.19,Default,,0,0,0,,Мен өскенім есімде жоқ. Не?
Dialogue: 0,0:12:25.19,0:12:27.92,Default,,0,0,0,,Мені өсірген Микадж болды
Dialogue: 0,0:12:27.92,0:12:30.82,Default,,0,0,0,,Бұл шайтандық нәрсе.
Dialogue: 0,0:12:30.82,0:12:33.42,Default,,0,0,0,,Онымен өмір сүру әдеттен тыс болды.
Dialogue: 0,0:12:38.57,0:12:40.57,Default,,0,0,0,,Микаджбен бірге болу арқылы
Dialogue: 0,0:12:40.57,0:12:42.87,Default,,0,0,0,,Мен жалғыз болғанды жөн көремін
Dialogue: 0,0:12:42.87,0:12:45.17,Default,,0,0,0,,Мен өзімді одан бетер жалғыз сезіндім.
Dialogue: 0,0:12:49.64,0:12:52.25,Default,,0,0,0,,Ешкімге сенуге болмайды
Dialogue: 0,0:12:52.25,0:12:54.55,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:54.55,0:12:58.52,Default,,0,0,0,,Сильфидің иісін алғаш иіскегенде мен де солай сезіндім.
Dialogue: 0,0:12:58.52,0:13:00.72,Default,,0,0,0,,Әлемде
Dialogue: 0,0:13:00.72,0:13:02.79,Default,,0,0,0,,Мені қабылдаңыз
Dialogue: 0,0:13:02.79,0:13:05.33,Default,,0,0,0,,Тағдыр жазған әйел
Dialogue: 0,0:13:05.33,0:13:07.36,Default,,0,0,0,,Мен Сильфиді өлтіремін
Dialogue: 0,0:13:07.36,0:13:09.63,Default,,0,0,0,,Махаббат үшін бірін-бірі өлтіру
Dialogue: 0,0:13:09.63,0:13:11.57,Default,,0,0,0,,Мені жаңа ғана дүниеге әкелді
Dialogue: 0,0:13:11.57,0:13:14.13,Default,,0,0,0,,Ата-анаң сияқты адамды құрбандыққа шалуға тырыспа.
Dialogue: 0,0:13:14.13,0:13:16.07,Default,,0,0,0,,Кагура
Dialogue: 0,0:13:16.07,0:13:18.97,Default,,0,0,0,,Сен менің әлсіз жүрегімсің
Dialogue: 0,0:13:18.97,0:13:20.91,Default,,0,0,0,,Құт
Dialogue: 0,0:13:20.91,0:13:22.91,Default,,0,0,0,,Уф
Dialogue: 0,0:13:25.38,0:13:27.31,Default,,0,0,0,,Сіз әлсізсіз
Dialogue: 0,0:13:27.31,0:13:29.58,Default,,0,0,0,,Махаббатың да әлсіз
Dialogue: 0,0:13:29.58,0:13:31.99,Default,,0,0,0,,Сонымен 10 000 жыл және 2000 жыл бұрын
Dialogue: 0,0:13:31.99,0:13:35.52,Default,,0,0,0,,Біз Сильфиден бөлініп кеттік!
Dialogue: 0,0:13:35.52,0:13:37.46,Default,,0,0,0,,Жоқ! және
Dialogue: 0,0:13:37.46,0:13:40.09,Default,,0,0,0,,Тіпті осы дүниеде 10 000 және 2000 жылдан кейін.
Dialogue: 0,0:13:40.09,0:13:43.63,Default,,0,0,0,,Анамды ұзату Жоқ...
Dialogue: 0,0:13:43.63,0:13:46.63,Default,,0,0,0,,Сильфи бұл жолы тағы басқа!
Dialogue: 0,0:13:46.63,0:13:49.80,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:49.80,0:13:52.50,Default,,0,0,0,,Басқа!
Dialogue: 0,0:14:01.55,0:14:05.75,Default,,0,0,0,,Альтея
Dialogue: 0,0:14:05.75,0:14:08.12,Default,,0,0,0,,Сол сияқты
Dialogue: 0,0:14:08.12,0:14:11.02,Default,,0,0,0,,Бұл резонанс тудыратын сияқты
Dialogue: 0,0:14:11.02,0:14:13.12,Default,,0,0,0,,Төраға?
Dialogue: 0,0:14:15.96,0:14:19.20,Default,,0,0,0,,Бұл Жаратылыс кітабында жазылған
Dialogue: 0,0:14:19.20,0:14:22.10,Default,,0,0,0,,Жаңа бет
Dialogue: 0,0:14:22.10,0:14:25.07,Default,,0,0,0,,Екі жан бір-бірін шақырғанда
Dialogue: 0,0:14:25.07,0:14:28.41,Default,,0,0,0,,Екі жұлдыз тартылды
Dialogue: 0,0:14:28.41,0:14:30.41,Default,,0,0,0,,Соңында
Dialogue: 0,0:14:32.28,0:14:34.65,Default,,0,0,0,,Ескі заттар
Dialogue: 0,0:14:34.65,0:14:38.19,Default,,0,0,0,,Таза дүние туады
Dialogue: 0,0:14:38.19,0:14:41.09,Default,,0,0,0,,Микадж құдайға айналатын әлем
Dialogue: 0,0:14:41.09,0:14:43.99,Default,,0,0,0,,Сіз іздеген болашақ осы ма?
Dialogue: 0,0:14:46.26,0:14:49.20,Default,,0,0,0,,Осы жұлдызды бақылап жүре беріңіз
Dialogue: 0,0:14:49.20,0:14:51.23,Default,,0,0,0,,Мен де
Dialogue: 0,0:14:51.23,0:14:54.00,Default,,0,0,0,,Мен жай ғана қарап қалдым.
Dialogue: 0,0:14:54.00,0:14:56.47,Default,,0,0,0,,Иә, кез келген уақытта
Dialogue: 0,0:14:56.47,0:14:58.94,Default,,0,0,0,,Сабырлылар
Dialogue: 0,0:14:58.94,0:15:02.14,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:15:02.14,0:15:04.08,Default,,0,0,0,,Жаңа әлем үшін
Dialogue: 0,0:15:04.08,0:15:07.08,Default,,0,0,0,,Қазір өмір сүргендер құрбандыққа шалынады
Dialogue: 0,0:15:07.08,0:15:09.58,Default,,0,0,0,,Бұл мектептің оқушылары да ерекшелік емес.
Dialogue: 0,0:15:11.79,0:15:14.99,Default,,0,0,0,,Өйткені Жаратылыс кітабы осы тағдырды іздейді.
Dialogue: 0,0:15:14.99,0:15:17.06,Default,,0,0,0,,Сен
Dialogue: 0,0:15:17.06,0:15:19.86,Default,,0,0,0,,Сіз бәрінің өліп жатқанын қабылдайсыз ба?
Dialogue: 0,0:15:22.06,0:15:24.97,Default,,0,0,0,,Мұның дұрыс екеніне сенімдісіз бе?
Dialogue: 0,0:15:24.97,0:15:26.97,Default,,0,0,0,,ＺＥＮ
Dialogue: 0,0:15:32.27,0:15:35.01,Default,,0,0,0,,Ах
Dialogue: 0,0:15:35.01,0:15:37.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:45.52,0:15:48.22,Default,,0,0,0,,Мен де Миконо-санмен алғаш танысқан кезімде.
Dialogue: 0,0:15:48.22,0:15:50.16,Default,,0,0,0,,Мен тағдырды сезіндім
Dialogue: 0,0:15:50.16,0:15:53.76,Default,,0,0,0,,Мені қабылдап, сол азапты сезінетін адам
Dialogue: 0,0:15:53.76,0:15:56.06,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:15:56.06,0:15:58.00,Default,,0,0,0,,Миконо мырза
Dialogue: 0,0:15:58.00,0:16:01.50,Default,,0,0,0,,Мен ашуландым, түсінбеймін
Dialogue: 0,0:16:01.50,0:16:03.60,Default,,0,0,0,,Боқ әйелдерді мақтама
Dialogue: 0,0:16:06.91,0:16:09.61,Default,,0,0,0,,Бірақ Миконо-сан үнемі жұмыс істейді.
Dialogue: 0,0:16:09.61,0:16:13.01,Default,,0,0,0,,Адамдардың қайғысына жанашырлық танытамын.
Dialogue: 0,0:16:13.01,0:16:16.48,Default,,0,0,0,,Біз әр адамның сезімін байланыстыра аламыз.
Dialogue: 0,0:16:16.48,0:16:19.09,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:16:19.09,0:16:22.02,Default,,0,0,0,,Сильфи емес, қазіргі Миконо.
Dialogue: 0,0:16:22.02,0:16:24.02,Default,,0,0,0,,Хозакуна
Dialogue: 0,0:16:26.26,0:16:28.26,Default,,0,0,0,,Мен оны жақсы көремін!
Dialogue: 0,0:16:33.13,0:16:35.50,Default,,0,0,0,,Мен өз тағдырымды өз қолыма аламын
Dialogue: 0,0:16:35.50,0:16:37.44,Default,,0,0,0,,Мен тағдырдан асып түстім
Dialogue: 0,0:16:37.44,0:16:39.51,Default,,0,0,0,,Қазіргі уақытты қабылдаңыз
Dialogue: 0,0:16:39.51,0:16:42.91,Default,,0,0,0,,Миконо-сан Сильфи
Dialogue: 0,0:16:49.05,0:16:51.15,Default,,0,0,0,,Шуш…
Dialogue: 0,0:16:53.79,0:16:56.46,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:56.46,0:16:58.39,Default,,0,0,0,,Яғни
Dialogue: 0,0:16:58.39,0:17:00.49,Default,,0,0,0,,Амата-кунмен
Dialogue: 0,0:17:05.10,0:17:07.47,Default,,0,0,0,,Сізге ұрысуға болмайды
Dialogue: 0,0:17:07.47,0:17:09.87,Default,,0,0,0,,Амата-кун
Dialogue: 0,0:17:09.87,0:17:12.24,Default,,0,0,0,,Біз шайқаспаймыз ба?
Dialogue: 0,0:17:12.24,0:17:15.54,Default,,0,0,0,,Джессика Жекпе-жектен бас тартады
Dialogue: 0,0:17:15.54,0:17:18.88,Default,,0,0,0,,Бұл бүкіл әлем жоққа шығарылады.
Dialogue: 0,0:17:18.88,0:17:21.78,Default,,0,0,0,,Сіз
Dialogue: 0,0:17:21.78,0:17:24.08,Default,,0,0,0,,Маған қосылыңыз.
Dialogue: 0,0:17:24.08,0:17:26.02,Default,,0,0,0,,Миконо Сузусиро
Dialogue: 0,0:17:26.02,0:17:28.52,Default,,0,0,0,,Сіз Джессика емессіз бе? Сен кімсің?
Dialogue: 0,0:17:31.62,0:17:37.30,Default,,0,0,0,,Менің атым
Dialogue: 0,0:17:37.30,0:17:39.80,Default,,0,0,0,,24 000 жыл бұрын
Dialogue: 0,0:17:39.80,0:17:42.77,Default,,0,0,0,,Менің күйеуім болған адамнан
Dialogue: 0,0:17:42.77,0:17:45.61,Default,,0,0,0,,Махаббат опасыздық жасады
Dialogue: 0,0:17:45.61,0:17:47.57,Default,,0,0,0,,Сен
Dialogue: 0,0:17:47.57,0:17:50.38,Default,,0,0,0,,Сол жек көрушілікті ұстаныңыз
Dialogue: 0,0:17:50.38,0:17:54.61,Default,,0,0,0,,Мен Аполлонийдің реинкарнациясымын
Dialogue: 0,0:17:54.61,0:17:57.52,Default,,0,0,0,,Аполлонмен шайқасты
Dialogue: 0,0:17:57.52,0:18:00.92,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:00.92,0:18:04.56,Default,,0,0,0,,Толығымен өшірілмеді
Dialogue: 0,0:18:04.56,0:18:08.29,Default,,0,0,0,,Аполлон әлемді құтқару үшін
Dialogue: 0,0:18:08.29,0:18:11.53,Default,,0,0,0,,Менімен бір болуыңа тілектеспін.
Dialogue: 0,0:18:11.53,0:18:14.47,Default,,0,0,0,,Мен оны қабылдадым.
Dialogue: 0,0:18:14.47,0:18:17.24,Default,,0,0,0,,Сүйікті адамыңызбен бір болыңыз
Dialogue: 0,0:18:17.24,0:18:21.04,Default,,0,0,0,,Мен шарықтау шегін сезіндім
Dialogue: 0,0:18:23.04,0:18:25.08,Default,,0,0,0,,байқадым
Dialogue: 0,0:18:25.08,0:18:28.18,Default,,0,0,0,,Жандар біріктіріледі
Dialogue: 0,0:18:30.35,0:18:34.95,Default,,0,0,0,,Аполлон Аполлонийдің реинкарнациясы емес.
Dialogue: 0,0:18:37.12,0:18:39.32,Default,,0,0,0,,Нағыз Аполлоний
Dialogue: 0,0:18:50.17,0:18:53.81,Default,,0,0,0,,Бір емес, екі рет
Dialogue: 0,0:18:53.81,0:18:55.88,Default,,0,0,0,,Аполлоний
Dialogue: 0,0:18:55.88,0:18:58.34,Default,,0,0,0,,тапталған
Dialogue: 0,0:18:58.34,0:19:00.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:00.28,0:19:04.15,Default,,0,0,0,,Мен екі жұлдызды бір жұлдыз жасадым
Dialogue: 0,0:19:04.15,0:19:06.45,Default,,0,0,0,,Жаңа әлемнің құдайы бол
Dialogue: 0,0:19:08.89,0:19:13.66,Default,,0,0,0,,Махаббаттан айырылған
Dialogue: 0,0:19:13.66,0:19:16.30,Default,,0,0,0,,Менің қалағаным осы
Dialogue: 0,0:19:16.30,0:19:18.83,Default,,0,0,0,,Жаңа миф
Dialogue: 0,0:19:18.83,0:19:22.20,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:19:22.20,0:19:25.61,Default,,0,0,0,,Қанша өлтірсем де, өлтірмеймін.
Dialogue: 0,0:19:25.61,0:19:28.91,Default,,0,0,0,,Менен Аполлонийді ұрладың.
Dialogue: 0,0:19:28.91,0:19:30.91,Default,,0,0,0,,Жек көретін әйел!
Dialogue: 0,0:19:35.38,0:19:37.78,Default,,0,0,0,,На
Dialogue: 0,0:19:37.78,0:19:41.08,Default,,0,0,0,,Міне
Dialogue: 0,0:19:44.89,0:19:47.43,Default,,0,0,0,,Ах
Dialogue: 0,0:19:47.43,0:19:49.73,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:54.70,0:19:57.00,Default,,0,0,0,,Миконо-сан Сильфидің дауысы
Dialogue: 0,0:20:04.78,0:20:06.78,Default,,0,0,0,,Бұл ұшақ
Dialogue: 0,0:20:09.08,0:20:11.98,Default,,0,0,0,,Миконо-сан Миконо-сан сонда.
Dialogue: 0,0:20:13.92,0:20:15.89,Default,,0,0,0,,Көбірек қуат
Dialogue: 0,0:20:15.89,0:20:17.89,Default,,0,0,0,,Темір теңіз
Dialogue: 0,0:20:17.89,0:20:20.29,Default,,0,0,0,,Маған ана жұлдыздың күшін бер!
Dialogue: 0,0:20:39.85,0:20:43.15,Default,,0,0,0,,Микадж Сіз жұлдыздардың күшін сіңіруге тырысасыз ба?
Dialogue: 0,0:20:46.62,0:20:48.62,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:51.52,0:20:53.53,Default,,0,0,0,,Амата
Dialogue: 0,0:20:53.53,0:20:55.66,Default,,0,0,0,,Кайен
Dialogue: 0,0:20:55.66,0:20:57.60,Default,,0,0,0,,Юноха
Dialogue: 0,0:20:57.60,0:20:59.53,Default,,0,0,0,,Менің орныма сақтандырғыш.
Dialogue: 0,0:20:59.53,0:21:03.14,Default,,0,0,0,,Сіздің қарапайым қабілеттеріңіз болмаса, олармен күресу мүмкін емес.
Dialogue: 0,0:21:03.14,0:21:05.91,Default,,0,0,0,,Амата-кун
Dialogue: 0,0:21:05.91,0:21:07.91,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:13.95,0:21:18.45,Default,,0,0,0,,Шешуші шайқас комбинациясы GO Aquarion!
Dialogue: 0,0:21:26.53,0:21:29.93,Default,,0,0,0,,Aquarion EVOL
Dialogue: 0,0:21:29.93,0:21:32.23,Default,,0,0,0,,Миконо-санды қайтару
Dialogue: 0,0:21:36.54,0:21:40.14,Default,,0,0,0,,(Каэбуки) Күтпегендей, дайындықты ескерсек, аса әсерлі болған жоқ.
Dialogue: 0,0:21:40.14,0:21:43.74,Default,,0,0,0,,Темір теңіз
Dialogue: 0,0:21:46.38,0:21:48.78,Default,,0,0,0,,Уау уау
Dialogue: 0,0:21:48.78,0:21:51.08,Default,,0,0,0,,Қанатты ит құдайдың денесіне айналады
Dialogue: 0,0:21:51.08,0:21:54.05,Default,,0,0,0,,Менің ойымша, сіз қарсы тұра аласыз.
Dialogue: 0,0:21:54.05,0:21:56.05,Default,,0,0,0,,Және Кагура
Dialogue: 0,0:22:08.20,0:22:10.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:10.20,0:22:13.04,Default,,0,0,0,,Уау
Dialogue: 0,0:22:13.04,0:22:15.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:22.65,0:22:26.29,Default,,0,0,0,,Кагура!
Dialogue: 0,0:22:26.29,0:22:28.22,Default,,0,0,0,,Кагура
Dialogue: 0,0:22:28.22,0:22:31.72,Default,,0,0,0,,Сен маған қарсы шыға алмайсың.
Dialogue: 0,0:22:35.83,0:22:38.13,Default,,0,0,0,,Құқық бұзушылық комбинациясы
Dialogue: 0,0:22:38.13,0:22:40.13,Default,,0,0,0,,GO акварионы
Dialogue: 0,0:22:47.64,0:22:51.48,Default,,0,0,0,,О
Dialogue: 0,0:22:51.48,0:22:53.45,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:22:53.45,0:22:55.45,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:23:06.69,0:23:09.69,Default,,0,0,0,,Қара...
Dialogue: 0,0:24:54.47,0:24:57.30,Default,,0,0,0,,Біз
Dialogue: 0,0:24:57.30,0:25:00.64,Default,,0,0,0,,Біз
Dialogue: 0,0:25:00.64,0:25:03.61,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:25:03.61,0:25:05.81,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:27:35.73,0:27:38.50,Default,,0,0,0,,Миконо-санды қайтар!
Dialogue: 0,0:27:38.50,0:27:41.60,Default,,0,0,0,,Шексіз соққы!
Dialogue: 0,0:27:44.90,0:27:46.90,Default,,0,0,0,,Шексіз?
Dialogue: 0,0:27:55.15,0:27:58.85,Default,,0,0,0,,Ол да шексіз соққы жасайды, бірақ бұл жерде біртүрлі нәрсе бар.
Dialogue: 0,0:28:06.26,0:28:10.13,Default,,0,0,0,,Бірінші соққы Себеп пен салдардың кері қайтарылуы
Dialogue: 0,0:28:10.13,0:28:13.40,Default,,0,0,0,,Оның соққысы себеп-салдар заңынан асып кете ме?
Dialogue: 0,0:28:13.40,0:28:17.34,Default,,0,0,0,,Мамыр иттей иттің шексіздік туралы айтуы күлкілі.
Dialogue: 0,0:28:17.34,0:28:20.01,Default,,0,0,0,,Құдайдың құдіреті шексіз
Dialogue: 0,0:28:20.01,0:28:22.34,Default,,0,0,0,,Кез келген жерде пайда болады
Dialogue: 0,0:28:22.34,0:28:25.74,Default,,0,0,0,,Әр уақытта бата беріңіз
Dialogue: 0,0:28:54.27,0:28:56.27,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:28:59.51,0:29:01.51,Default,,0,0,0,,Сильфия
Dialogue: 0,0:29:06.29,0:29:08.29,Default,,0,0,0,,Сильфия
Dialogue: 0,0:29:17.26,0:29:19.23,Default,,0,0,0,,Мен неге жете алмаймын?
Dialogue: 0,0:29:19.23,0:29:21.63,Default,,0,0,0,,Неге...
Dialogue: 0,0:29:21.63,0:29:23.63,Default,,0,0,0,,Сильфия
Dialogue: 0,0:29:28.14,0:29:30.14,Default,,0,0,0,,Қазірге дейін мен—
Dialogue: 0,0:29:37.25,0:29:39.19,Default,,0,0,0,,Осы сияқты
Dialogue: 0,0:29:39.19,0:29:43.36,Default,,0,0,0,,Мен Аматаның ауырсынуын тудыратын біріктіруді қаламаймын ...
Dialogue: 0,0:29:43.36,0:29:48.56,Default,,0,0,0,,Сен Микадж жүрегінің лабиринтісің.
Dialogue: 0,0:29:48.56,0:29:53.40,Default,,0,0,0,,Өтінемін, мені өлтіріңізші.
Dialogue: 0,0:29:53.40,0:29:55.40,Default,,0,0,0,,Мен өлсем
Dialogue: 0,0:29:55.40,0:30:00.17,Default,,0,0,0,,Микадж енді күннің қанаттарын басқара алмайды.
Dialogue: 0,0:30:00.17,0:30:03.18,Default,,0,0,0,,Өйткені мен ақымақпын...
Dialogue: 0,0:30:03.18,0:30:07.91,Default,,0,0,0,,Мен Микаджды тоқтатудың басқа жолын таба алмаймын.
Dialogue: 0,0:30:07.91,0:30:12.38,Default,,0,0,0,,Микононы жоғалту Аматаны қайғырады.
Dialogue: 0,0:30:12.38,0:30:14.78,Default,,0,0,0,,Аматаны мұңайтқым келмейді
Dialogue: 0,0:30:26.40,0:30:28.40,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:30:41.68,0:30:45.88,Default,,0,0,0,,Енді жоқ, одақ жойылады.
Dialogue: 0,0:30:50.09,0:30:52.09,Default,,0,0,0,,Қажетсіз еліктеу
Dialogue: 0,0:30:56.26,0:30:59.56,Default,,0,0,0,,Қош бол Амата...
Dialogue: 0,0:31:03.47,0:31:05.47,Default,,0,0,0,,Шығу
Dialogue: 0,0:31:08.41,0:31:11.21,Default,,0,0,0,,Неге... сен?
Dialogue: 0,0:31:11.21,0:31:15.08,Default,,0,0,0,,Амата сияқты нәрсе үшін өлу ұят болар.
Dialogue: 0,0:31:15.08,0:31:17.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:17.98,0:31:20.85,Default,,0,0,0,,Кішкентай қанатсыз бейбақ
Dialogue: 0,0:31:20.85,0:31:24.65,Default,,0,0,0,,Сіздің денелеріңіз енді қажет емес.
Dialogue: 0,0:31:31.46,0:31:34.33,Default,,0,0,0,,Нағыз күннің қанаттары
Dialogue: 0,0:31:34.33,0:31:40.14,Default,,0,0,0,,Оны алғашында тек ежелгі құдайлар киген.
Dialogue: 0,0:31:40.14,0:31:43.51,Default,,0,0,0,,Мен сені оята аламын
Dialogue: 0,0:31:43.51,0:31:47.91,Default,,0,0,0,,Элементтер тек қарғыс атқан келін мен мен.
Dialogue: 0,0:31:50.95,0:31:53.45,Default,,0,0,0,,Сакасама! Супер бұрылыс!
Dialogue: 0,0:31:58.26,0:32:02.66,Default,,0,0,0,,Енді кек алудың үйлену қоңырауларын соғыңыз
Dialogue: 0,0:32:02.66,0:32:05.56,Default,,0,0,0,,Мына жеккөрінішті әйелдің денесін алыңыз
Dialogue: 0,0:32:05.56,0:32:09.37,Default,,0,0,0,,Мен жаңа әлем жасаймын
Dialogue: 0,0:32:09.37,0:32:11.57,Default,,0,0,0,,Жаратылыстың құдайы бол
Dialogue: 0,0:32:20.35,0:32:24.15,Default,,0,0,0,,Оян, тағы бір күн
Dialogue: 0,0:32:38.30,0:32:40.30,Default,,0,0,0,,Кайен Юноха
Dialogue: 0,0:32:48.57,0:32:50.57,Default,,0,0,0,,Қара күн болса
Dialogue: 0,0:33:02.05,0:33:05.82,Default,,0,0,0,,Дүние жүзіндегі температураның көтерілуі және теңіз деңгейінің төмендеуі
Dialogue: 0,0:33:05.82,0:33:09.13,Default,,0,0,0,,Барлық өзендердің, көлдердің және батпақтардың су деңгейі төмендейді.
Dialogue: 0,0:33:09.13,0:33:11.70,Default,,0,0,0,,Күн қанаттары…
Dialogue: 0,0:33:11.70,0:33:16.44,Default,,0,0,0,,Барлығын құрғататын күйдіретін жалын
Dialogue: 0,0:33:16.44,0:33:19.81,Default,,0,0,0,,MIX Иә
Dialogue: 0,0:33:19.81,0:33:21.81,Default,,0,0,0,,Бұлай жалғаса берсе, әлем...
Dialogue: 0,0:33:21.81,0:33:26.18,Default,,0,0,0,,Бірақ Вектор онымен күресе алмайды.
Dialogue: 0,0:33:26.18,0:33:29.05,Default,,0,0,0,,Амата біріктіреді.
Dialogue: 0,0:33:29.05,0:33:32.55,Default,,0,0,0,,Энди, бірге жүргенімізге біраз болды, Амата.
Dialogue: 0,0:33:32.55,0:33:35.05,Default,,0,0,0,,MIX Қайтып келдіңіз бе?
Dialogue: 0,0:33:38.79,0:33:42.19,Default,,0,0,0,,Бұл ән... Schrade
Dialogue: 0,0:33:45.93,0:33:48.67,Default,,0,0,0,,Бұл Шраде мінген ұшақ екеніне күмән жоқ.
Dialogue: 0,0:33:48.67,0:33:51.07,Default,,0,0,0,,Бірақ биологиялық реакциялар...
Dialogue: 0,0:33:53.51,0:33:55.44,Default,,0,0,0,,Жаңа векторлық реакциялар
Dialogue: 0,0:33:55.44,0:33:59.38,Default,,0,0,0,,Джессика тастап кеткен Вектор Ix әлі тірі және жақсы.
Dialogue: 0,0:33:59.38,0:34:01.91,Default,,0,0,0,,Енді сізде 2 қосалқы вектор бар
Dialogue: 0,0:34:01.91,0:34:04.25,Default,,0,0,0,,Тағы бір жазықтық.
Dialogue: 0,0:34:04.25,0:34:08.12,Default,,0,0,0,,Әй, мені ұмытсаң бәлеге қаламын.
Dialogue: 0,0:34:08.12,0:34:10.39,Default,,0,0,0,,Вектор Зед Моллой.
Dialogue: 0,0:34:10.39,0:34:12.73,Default,,0,0,0,,Мен сияқты оңтүстік елде дүниеге келген адамға
Dialogue: 0,0:34:12.73,0:34:15.56,Default,,0,0,0,,Ыстық күн дос сияқты.
Dialogue: 0,0:34:15.56,0:34:18.46,Default,,0,0,0,,О! Қазір бізде 3 ұшақ бар
Dialogue: 0,0:34:18.46,0:34:20.97,Default,,0,0,0,,Кайен Юноха қайта пайда болды
Dialogue: 0,0:34:20.97,0:34:25.60,Default,,0,0,0,,Элементті өзгерту Мен Моллойдың орнына барамын.
Dialogue: 0,0:34:25.60,0:34:28.24,Default,,0,0,0,,Иә! Клэр төрағасы
Dialogue: 0,0:34:28.24,0:34:31.08,Default,,0,0,0,,Бұл ақылға қонымсыз. Бұл жағдайда мен...
Dialogue: 0,0:34:31.08,0:34:35.41,Default,,0,0,0,,Донал Суоми Аман болыңыз
Dialogue: 0,0:34:35.41,0:34:39.62,Default,,0,0,0,,Егер бірдеңе бола қалса, біз кейінгі ұрпақтың Адам ата мен Хауа анаға айналар едік.
Dialogue: 0,0:34:39.62,0:34:41.55,Default,,0,0,0,,Не?!
Dialogue: 0,0:34:41.55,0:34:44.89,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:34:44.89,0:34:46.83,Default,,0,0,0,,Не?!
Dialogue: 0,0:34:46.83,0:34:49.73,Default,,0,0,0,,Кайен Юноха менің артымнан жүр
Dialogue: 0,0:34:49.73,0:34:51.73,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:34:51.73,0:34:53.73,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:34:58.87,0:35:01.27,Default,,0,0,0,,Бұл ән... Schrade
Dialogue: 0,0:35:12.89,0:35:17.49,Default,,0,0,0,,Менің орнымды баса аласың ба деп біраз уайымдап тұрмын.
Dialogue: 0,0:35:19.66,0:35:22.56,Default,,0,0,0,,Мен оны сұрадым, ең жақын досым.
Dialogue: 0,0:35:22.56,0:35:24.56,Default,,0,0,0,,Schrade
Dialogue: 0,0:35:28.77,0:35:30.84,Default,,0,0,0,,Мен қорғағым келеді
Dialogue: 0,0:35:30.84,0:35:34.87,Default,,0,0,0,,Джин туған планета және жер
Dialogue: 0,0:35:34.87,0:35:39.71,Default,,0,0,0,,Schrade Сіз бізге жаныңыздың әуенімен көмектесесіз бе?
Dialogue: 0,0:35:39.71,0:35:41.65,Default,,0,0,0,,Жүр, кеттік
Dialogue: 0,0:35:41.65,0:35:43.65,Default,,0,0,0,,Құрметті достар
Dialogue: 0,0:35:43.65,0:35:46.49,Default,,0,0,0,,Маңызды адам
Dialogue: 0,0:35:46.49,0:35:50.09,Default,,0,0,0,,Маңызды адамдар, маңызды ойлар
Dialogue: 0,0:35:52.79,0:35:56.70,Default,,0,0,0,,Кеттік, Шрейд.
Dialogue: 0,0:35:56.70,0:36:01.20,Default,,0,0,0,,Құдайдың достығы.
Dialogue: 0,0:36:19.32,0:36:22.55,Default,,0,0,0,,Акварион Гепада
Dialogue: 0,0:36:22.55,0:36:26.33,Default,,0,0,0,,Кел, бірге күресейік, Кайен.
Dialogue: 0,0:36:26.33,0:36:28.33,Default,,0,0,0,,Кеттік, Камитомо.
Dialogue: 0,0:36:32.26,0:36:34.26,Default,,0,0,0,,Пайдасыз заттар
Dialogue: 0,0:36:37.04,0:36:39.04,Default,,0,0,0,,Не?
Dialogue: 0,0:36:41.91,0:36:44.74,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:36:44.74,0:36:47.34,Default,,0,0,0,,Қоршалған телепорт
Dialogue: 0,0:36:49.48,0:36:52.12,Default,,0,0,0,,Төраға
Dialogue: 0,0:36:52.12,0:36:54.12,Default,,0,0,0,,Не
Dialogue: 0,0:36:56.69,0:37:01.69,Default,,0,0,0,,Мына саңылау тесігі!
Dialogue: 0,0:37:05.13,0:37:09.33,Default,,0,0,0,,Досқа арналған орындаушыға арналған реквием!
Dialogue: 0,0:37:26.52,0:37:28.95,Default,,0,0,0,,Мен жас және тым ынталы едім.
Dialogue: 0,0:37:28.95,0:37:31.36,Default,,0,0,0,,Жылдар...
Dialogue: 0,0:37:31.36,0:37:33.36,Default,,0,0,0,,Ақылды еліктеу
Dialogue: 0,0:37:36.53,0:37:40.13,Default,,0,0,0,,Кеңістіктік өтемақы
Dialogue: 0,0:37:40.13,0:37:42.07,Default,,0,0,0,,Мен бас тартуым керек пе?
Dialogue: 0,0:37:42.07,0:37:44.77,Default,,0,0,0,,Мен бас тартуым керек пе?
Dialogue: 0,0:37:44.77,0:37:48.14,Default,,0,0,0,,Әй, мен қайта-қайта жараландым.
Dialogue: 0,0:37:48.14,0:37:50.71,Default,,0,0,0,,Әлі де тұр
Dialogue: 0,0:37:50.71,0:37:53.58,Default,,0,0,0,,Сен сол әйелді қатты қалайсың ба?
Dialogue: 0,0:37:53.58,0:37:56.48,Default,,0,0,0,,Мұны да осы жерден аяқтайық.
Dialogue: 0,0:38:22.24,0:38:25.54,Default,,0,0,0,,Екі жұлдыз күшпен біріктірілген
Dialogue: 0,0:38:30.42,0:38:33.02,Default,,0,0,0,,Жұлдыздардан өмірді сорып жатырсың ба?
Dialogue: 0,0:38:41.63,0:38:45.20,Default,,0,0,0,,Сіз 10 000 және 2 000 жыл бұрын дүниеге келдіңіз.
Dialogue: 0,0:38:45.20,0:38:49.60,Default,,0,0,0,,Әй, сол сағыныш иісі
Dialogue: 0,0:38:49.60,0:38:52.60,Default,,0,0,0,,Аполлон Бұл Аполлон ба?
Dialogue: 0,0:38:56.31,0:38:58.81,Default,,0,0,0,,Мұңайма
Dialogue: 0,0:38:58.81,0:39:03.15,Default,,0,0,0,,Асыл болашақ апа
Dialogue: 0,0:39:03.15,0:39:07.99,Default,,0,0,0,,Үлкен аға? Аспан қанаттары мен қанатсыздың арасында дүниеге келген
Dialogue: 0,0:39:07.99,0:39:13.39,Default,,0,0,0,,Мені азаптап, құтқарды
Dialogue: 0,0:39:13.39,0:39:15.39,Default,,0,0,0,,Тома
Dialogue: 0,0:39:18.20,0:39:20.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:39:20.13,0:39:23.44,Default,,0,0,0,,Ақыры есіме түсті
Dialogue: 0,0:39:23.44,0:39:25.37,Default,,0,0,0,,Мен үшін...
Dialogue: 0,0:39:25.37,0:39:28.87,Default,,0,0,0,,Менің өтінішім үшін мен құрбан болдым ...
Dialogue: 0,0:39:28.87,0:39:30.91,Default,,0,0,0,,Ешқашан кешірім сұрама
Dialogue: 0,0:39:30.91,0:39:33.15,Default,,0,0,0,,Сіз де, біз де
Dialogue: 0,0:39:33.15,0:39:36.68,Default,,0,0,0,,Мен сол кезде қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:39:36.68,0:39:39.55,Default,,0,0,0,,Және уәде етілгендей
Dialogue: 0,0:39:39.55,0:39:44.76,Default,,0,0,0,,Өйткені біз осылай қайта кездесе алдық.
Dialogue: 0,0:39:44.76,0:39:47.03,Default,,0,0,0,,Амата-кун Аполлон
Dialogue: 0,0:39:47.03,0:39:50.73,Default,,0,0,0,,Өйткені адамдар мен Аспан Қанаттары байланысты.
Dialogue: 0,0:39:57.77,0:40:00.24,Default,,0,0,0,,Бір емес, екі рет
Dialogue: 0,0:40:00.24,0:40:04.08,Default,,0,0,0,,Менің сүйіктімді менен ұрлап алған жеккөрінішті әйел.
Dialogue: 0,0:40:04.08,0:40:07.71,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:40:07.71,0:40:10.48,Default,,0,0,0,,Фудо бас қолбасшысы Яғни
Dialogue: 0,0:40:10.48,0:40:14.95,Default,,0,0,0,,Махаббатпен өмір сүретін Томас бөлген жүректің көлеңкесі
Dialogue: 0,0:40:14.95,0:40:18.79,Default,,0,0,0,,Жүректің көлеңкесі Микадж
Dialogue: 0,0:40:18.79,0:40:20.73,Default,,0,0,0,,Қарамаңдар
Dialogue: 0,0:40:20.73,0:40:25.40,Default,,0,0,0,,Әлі де көретін нәрсе бар.
Dialogue: 0,0:40:25.40,0:40:28.30,Default,,0,0,0,,Қорқыныштан басқа, шындыққа қол тигізіңіз
Dialogue: 0,0:40:28.30,0:40:31.87,Default,,0,0,0,,Егер сіз қазір болсаңыз, мен сенімдімін ...
Dialogue: 0,0:40:31.87,0:40:34.11,Default,,0,0,0,,Аполлоний
Dialogue: 0,0:40:34.11,0:40:36.11,Default,,0,0,0,,Аполлоний
Dialogue: 0,0:40:36.11,0:40:40.75,Default,,0,0,0,,Аполлоний!
Dialogue: 0,0:40:40.75,0:40:43.15,Default,,0,0,0,,Аполлоний
Dialogue: 0,0:40:43.15,0:40:47.75,Default,,0,0,0,,Жақындарыңды түгелдей өртеп жіберемін.
Dialogue: 0,0:40:55.73,0:40:57.73,Default,,0,0,0,,ＭＩＸ
Dialogue: 0,0:41:00.37,0:41:03.30,Default,,0,0,0,,Бір ғана соққыда біріктіру
Dialogue: 0,0:41:03.30,0:41:05.40,Default,,0,0,0,,Уау! жаман!
Dialogue: 0,0:41:08.41,0:41:11.38,Default,,0,0,0,,Амата! Микадж
Dialogue: 0,0:41:11.38,0:41:15.08,Default,,0,0,0,,Біз де барайық. Маған күш-қуат берші, түбі бір әйел.
Dialogue: 0,0:41:17.55,0:41:20.45,Default,,0,0,0,,Жарайды мына сұмдық жігіт.
Dialogue: 0,0:41:23.82,0:41:26.53,Default,,0,0,0,,Амата Джессика
Dialogue: 0,0:41:26.53,0:41:29.53,Default,,0,0,0,,Кагура, кейін жақсы боласыз.
Dialogue: 0,0:41:29.53,0:41:33.00,Default,,0,0,0,,Сіздерді бірге қорғауға рұқсат етіңіздер.
Dialogue: 0,0:41:33.00,0:41:35.67,Default,,0,0,0,,Миконо, бұл әлем
Dialogue: 0,0:41:35.67,0:41:39.00,Default,,0,0,0,,Джессика, кешіріңіз.
Dialogue: 0,0:41:39.00,0:41:43.84,Default,,0,0,0,,Бакаамата, бұл «кешіріңіз» емес пе?
Dialogue: 0,0:41:43.84,0:41:48.45,Default,,0,0,0,,Рақмет саған, Джессика, сен өте жетілген бейбақсың.
Dialogue: 0,0:41:48.45,0:41:52.82,Default,,0,0,0,,Тас түбіндегі әйелді жылаттың.
Dialogue: 0,0:41:52.82,0:41:57.22,Default,,0,0,0,,Икуйо Шонен таза махаббат одағы
Dialogue: 0,0:41:57.22,0:41:59.92,Default,,0,0,0,,Акварион!
Dialogue: 0,0:42:05.43,0:42:09.90,Default,,0,0,0,,Күште мейірімділік, әлсіздікте жылылық
Dialogue: 0,0:42:09.90,0:42:13.24,Default,,0,0,0,,Керемет сүйкімді
Dialogue: 0,0:42:13.24,0:42:15.74,Default,,0,0,0,,Aquarion EVOL
Dialogue: 0,0:42:18.08,0:42:20.65,Default,,0,0,0,,Аполлоний Бұл не?
Dialogue: 0,0:42:20.65,0:42:23.35,Default,,0,0,0,,Аполлоний
Dialogue: 0,0:42:23.35,0:42:27.22,Default,,0,0,0,,Аполлоний I Аполлонийді қатты жақсы көрді.
Dialogue: 0,0:42:27.22,0:42:31.09,Default,,0,0,0,,Сатқындық және ренжіту
Dialogue: 0,0:42:31.09,0:42:33.79,Default,,0,0,0,,Өшпенділікпен
Dialogue: 0,0:42:33.79,0:42:36.46,Default,,0,0,0,,Сонда да көп...
Dialogue: 0,0:42:36.46,0:42:40.36,Default,,0,0,0,,Аполлоний
Dialogue: 0,0:42:43.20,0:42:45.97,Default,,0,0,0,,А...
Dialogue: 0,0:42:45.97,0:42:49.84,Default,,0,0,0,,Ай Шител
Dialogue: 0,0:42:49.84,0:42:51.78,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:42:51.78,0:42:54.58,Default,,0,0,0,,Сонша, сонша
Dialogue: 0,0:42:56.92,0:43:00.79,Default,,0,0,0,,Жақында
Dialogue: 0,0:43:00.79,0:43:03.62,Default,,0,0,0,,Иә? кешіріңіз
Dialogue: 0,0:43:03.62,0:43:08.09,Default,,0,0,0,,Мен қарап тұра бердім
Dialogue: 0,0:43:08.09,0:43:11.40,Default,,0,0,0,,Жақыныңды өзіңнен алып кеткен күнәдан.
Dialogue: 0,0:43:11.40,0:43:14.13,Default,,0,0,0,,Қайғыңнан
Dialogue: 0,0:43:14.13,0:43:18.07,Default,,0,0,0,,Неге қазір маған көңіл бөлесің?
Dialogue: 0,0:43:18.07,0:43:22.31,Default,,0,0,0,,Бірақ бұл дүниедегі барлық адамдар маған көмектесіңдерші.
Dialogue: 0,0:43:22.31,0:43:24.24,Default,,0,0,0,,Миконо-сан!
Dialogue: 0,0:43:24.24,0:43:27.68,Default,,0,0,0,,Амата-кун, келме.
Dialogue: 0,0:43:27.68,0:43:29.61,Default,,0,0,0,,Өтінемін, бәрі қашып кетсін.
Dialogue: 0,0:43:29.61,0:43:32.52,Default,,0,0,0,,Миконо-санды осылай тастап кетуге қалай болады?
Dialogue: 0,0:43:32.52,0:43:36.42,Default,,0,0,0,,Мен сені бұл жолы ұзатпаймын, иә?
Dialogue: 0,0:43:36.42,0:43:38.42,Default,,0,0,0,,Мен сені қосамын
Dialogue: 0,0:43:38.42,0:43:42.16,Default,,0,0,0,,Махаббат пен мұңнан айырылған жан
Dialogue: 0,0:43:42.16,0:43:44.20,Default,,0,0,0,,Мен сені қосамын
Dialogue: 0,0:43:44.20,0:43:47.70,Default,,0,0,0,,Иә, бос сөз!
Dialogue: 0,0:43:50.87,0:43:52.87,Default,,0,0,0,,Миконо-сан!
Dialogue: 0,0:43:55.34,0:43:57.34,Default,,0,0,0,,Сакасама
Dialogue: 0,0:43:59.54,0:44:04.14,Default,,0,0,0,,Trinity Punch жеңіз!
Dialogue: 0,0:44:09.92,0:44:13.02,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:44:16.60,0:44:20.20,Default,,0,0,0,,Сильфи Миконо
Dialogue: 0,0:44:20.20,0:44:22.30,Default,,0,0,0,,Күлуді тоқтатыңыз
Dialogue: 0,0:44:25.84,0:44:28.14,Default,,0,0,0,,Мен күйіп жатырмын...
Dialogue: 0,0:44:28.14,0:44:30.41,Default,,0,0,0,,Мен бас тартуым керек пе?
Dialogue: 0,0:44:30.41,0:44:34.38,Default,,0,0,0,,Мен анамды сол күні шығарып салдым.
Dialogue: 0,0:44:34.38,0:44:37.08,Default,,0,0,0,,Мен өкіне бердім.
Dialogue: 0,0:44:37.08,0:44:39.48,Default,,0,0,0,,Бірақ мен ақыры түсіндім.
Dialogue: 0,0:44:39.48,0:44:42.42,Default,,0,0,0,,Бұл 10 000 және 2 000 жыл бұрын болды
Dialogue: 0,0:44:42.42,0:44:45.29,Default,,0,0,0,,Сильвияның I қалдырып кеткені
Dialogue: 0,0:44:45.29,0:44:48.13,Default,,0,0,0,,Микононың қайғысы
Dialogue: 0,0:44:48.13,0:44:50.36,Default,,0,0,0,,Сезімді білу
Dialogue: 0,0:44:50.36,0:44:53.90,Default,,0,0,0,,Мен осылай дүниеге келдім
Dialogue: 0,0:44:53.90,0:44:56.13,Default,,0,0,0,,Сондықтан мен сені бұл жолы жібермеймін
Dialogue: 0,0:44:56.13,0:44:58.14,Default,,0,0,0,,Мен қоштаспаймын
Dialogue: 0,0:44:58.14,0:45:01.97,Default,,0,0,0,,Өзің жақсы көретін адаммен, Миконо-санмен
Dialogue: 0,0:45:01.97,0:45:04.41,Default,,0,0,0,,Мен бұл әлемді қорғағым келеді
Dialogue: 0,0:45:04.41,0:45:06.48,Default,,0,0,0,,Амата-кун
Dialogue: 0,0:45:06.48,0:45:09.08,Default,,0,0,0,,Мына итке ұқсас нәрсе
Dialogue: 0,0:45:20.73,0:45:22.99,Default,,0,0,0,,Мұның бәрі осы ма?
Dialogue: 0,0:45:22.99,0:45:25.90,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:45:25.90,0:45:28.87,Default,,0,0,0,,Амата
Dialogue: 0,0:45:28.87,0:45:32.14,Default,,0,0,0,,Амата
Dialogue: 0,0:45:32.14,0:45:34.94,Default,,0,0,0,,Амата-кун
Dialogue: 0,0:45:34.94,0:45:38.58,Default,,0,0,0,,Қазіргіні қабылда, Амата
Dialogue: 0,0:45:38.58,0:45:41.48,Default,,0,0,0,,Амата Амата
Dialogue: 0,0:45:41.48,0:45:44.48,Default,,0,0,0,,Ана әке
Dialogue: 0,0:45:55.63,0:45:58.53,Default,,0,0,0,,Ах! Амата
Dialogue: 0,0:45:58.53,0:46:01.07,Default,,0,0,0,,Миконо қате.
Dialogue: 0,0:46:01.07,0:46:04.97,Default,,0,0,0,,Мен жалғыз қалғанда қалай және немен байланыса аламын?
Dialogue: 0,0:46:07.41,0:46:11.81,Default,,0,0,0,,Себебі менде біреу бар, өйткені мен біреуге қамқормын
Dialogue: 0,0:46:11.81,0:46:13.78,Default,,0,0,0,,Сондықтан біз қосылдық
Dialogue: 0,0:46:13.78,0:46:16.48,Default,,0,0,0,,Мен әрқашан жаныңдамын
Dialogue: 0,0:46:22.32,0:46:25.82,Default,,0,0,0,,Миконо қартайып, мыжып кетсе де
Dialogue: 0,0:46:25.82,0:46:28.86,Default,,0,0,0,,Бұл жерде қартаюды қойып, мифке айналсам да
Dialogue: 0,0:46:28.86,0:46:32.20,Default,,0,0,0,,Мен оның қасындамын
Dialogue: 0,0:46:32.20,0:46:36.50,Default,,0,0,0,,Шексіз ұшады, шексіз сүйуді жалғастырады
Dialogue: 0,0:46:41.81,0:46:44.68,Default,,0,0,0,,Амата, неткен бейбақ.
Dialogue: 0,0:46:44.68,0:46:48.11,Default,,0,0,0,,Мен Сильфиді жақсы көру үшін дүниеге келдім
Dialogue: 0,0:46:48.11,0:46:51.78,Default,,0,0,0,,10 000 және 2 000 жылдан кейін
Dialogue: 0,0:46:51.78,0:46:54.59,Default,,0,0,0,,Бірақ сіз қазірсіз
Dialogue: 0,0:46:54.59,0:46:56.59,Default,,0,0,0,,Маған қазіргі Микононы ұнады.
Dialogue: 0,0:46:58.89,0:47:02.13,Default,,0,0,0,,Бірге барайық.
Dialogue: 0,0:47:02.13,0:47:05.46,Default,,0,0,0,,Махаббаттың шегінен шығу
Dialogue: 0,0:47:05.46,0:47:07.46,Default,,0,0,0,,Кагура
Dialogue: 0,0:47:11.14,0:47:13.07,Default,,0,0,0,,Миконо-сан!
Dialogue: 0,0:47:13.07,0:47:15.01,Default,,0,0,0,,Амата-кун
Dialogue: 0,0:47:15.01,0:47:20.31,Default,,0,0,0,,Жаратылыс Одағы Алға Акварион ЭВОЛ
Dialogue: 0,0:47:25.25,0:47:27.25,Default,,0,0,0,,Не!
Dialogue: 0,0:47:30.69,0:47:34.13,Default,,0,0,0,,Жоқ, бұл EVOL емес.
Dialogue: 0,0:47:34.13,0:47:36.43,Default,,0,0,0,,Оның жаңа есімі
Dialogue: 0,0:47:39.76,0:47:42.26,Default,,0,0,0,,Акварион МАХАББАТ
Dialogue: 0,0:47:46.14,0:47:48.07,Default,,0,0,0,,Амата-кун
Dialogue: 0,0:47:48.07,0:47:50.51,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:47:50.51,0:47:53.81,Default,,0,0,0,,Мен сенмін мен сенмін
Dialogue: 0,0:47:55.78,0:47:57.78,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:48:11.16,0:48:14.16,Default,,0,0,0,,Неге өзін көрсетіп жатырсың?
Dialogue: 0,0:48:19.04,0:48:21.77,Default,,0,0,0,,Суқұйғыштың көз жасы МАХАББАТ
Dialogue: 0,0:48:21.77,0:48:23.71,Default,,0,0,0,,Біркелкі кеңістіктен секіру
Dialogue: 0,0:48:23.71,0:48:26.08,Default,,0,0,0,,Құрғаған жерді ылғалдандыр
Dialogue: 0,0:48:26.08,0:48:29.08,Default,,0,0,0,,Жыртылған дүниені жалғау
Dialogue: 0,0:48:43.19,0:48:47.40,Default,,0,0,0,,Мен оны бұлай қалдыра алмаймын.
Dialogue: 0,0:48:47.40,0:48:51.74,Default,,0,0,0,,Маған денеңді бер.
Dialogue: 0,0:48:51.74,0:48:56.34,Default,,0,0,0,,О... бұл сенсің!
Dialogue: 0,0:48:59.91,0:49:02.48,Default,,0,0,0,,О? неге жұмыс істемейді
Dialogue: 0,0:49:02.48,0:49:05.78,Default,,0,0,0,,Неге менің айтқанымды істемейсің?
Dialogue: 0,0:49:07.82,0:49:09.75,Default,,0,0,0,,Аполлоний
Dialogue: 0,0:49:09.75,0:49:14.66,Default,,0,0,0,,Мен сені қабылдаймын
Dialogue: 0,0:49:14.66,0:49:17.50,Default,,0,0,0,,Уақытты бірге бақайық
Dialogue: 0,0:49:17.50,0:49:22.40,Default,,0,0,0,,Менде ұйықта, махаббаттың көлеңкесі.
Dialogue: 0,0:49:22.40,0:49:24.40,Default,,0,0,0,,Уақыттан тыс
Dialogue: 0,0:49:24.40,0:49:29.71,Default,,0,0,0,,Біз осы дәуірде байланыстымыз
Dialogue: 0,0:49:29.71,0:49:35.51,Default,,0,0,0,,Маған бір емес, екі рет опасыздық жасаған адам.
Dialogue: 0,0:49:35.51,0:49:37.88,Default,,0,0,0,,Неліктен
Dialogue: 0,0:49:37.88,0:49:42.18,Default,,0,0,0,,Сенің ішің сондай жылы
Dialogue: 0,0:51:01.73,0:51:03.73,Default,,0,0,0,,Скранчи
Dialogue: 0,0:51:32.33,0:51:34.33,Default,,0,0,0,,Амата
Dialogue: 0,0:51:37.00,0:51:39.70,Default,,0,0,0,,Содан бастап махаббатқа тыйым салынады.
Dialogue: 0,0:51:41.20,0:51:47.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory