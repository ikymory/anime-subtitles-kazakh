Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.81,0:00:43.31,Default,,0,0,0,,Уау...
Dialogue: 0,0:00:46.62,0:00:50.32,Default,,0,0,0,,Уау...
Dialogue: 0,0:00:52.89,0:00:55.99,Default,,0,0,0,,Уау...
Dialogue: 0,0:00:59.43,0:01:02.63,Default,,0,0,0,,Уау...
Dialogue: 0,0:01:05.57,0:01:07.57,Default,,0,0,0,,Бұл жиіркенішті дауыс.
Dialogue: 0,0:01:28.56,0:01:30.56,Default,,0,0,0,,Бұл ұшу қабілеті
Dialogue: 0,0:01:36.90,0:01:39.80,Default,,0,0,0,,Оған күмән жоқ
Dialogue: 0,0:01:39.80,0:01:41.80,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:01:45.61,0:01:48.38,Default,,0,0,0,,Микадж, рұқсатсыз не істеп жатырсың?
Dialogue: 0,0:01:48.38,0:01:52.88,Default,,0,0,0,,Бұрынғыдан жалғасы Изумо Ол кім?
Dialogue: 0,0:01:55.15,0:01:59.02,Default,,0,0,0,,Олай болса мен сенің орныңды аламын.
Dialogue: 0,0:01:59.02,0:02:05.13,Default,,0,0,0,,Ол тыйым салынған қосылудан өткен механикалық періштенің операторы.
Dialogue: 0,0:02:05.13,0:02:09.97,Default,,0,0,0,,Желде желбіреп тұрған алтын көз, сары шаш
Dialogue: 0,0:02:09.97,0:02:14.47,Default,,0,0,0,,Ал ұйықтап жатқан Хауа анаға
Dialogue: 0,0:02:14.47,0:02:18.17,Default,,0,0,0,,Бет-әлпеті ұқсас бала
Dialogue: 0,0:04:08.42,0:04:11.32,Default,,0,0,0,,Әйел Альтеядан адасып қалды.
Dialogue: 0,0:04:11.32,0:04:15.19,Default,,0,0,0,,Бізде ертеңгі күні жойылудан басқа амал жоқ.
Dialogue: 0,0:04:15.19,0:04:22.03,Default,,0,0,0,,Үміт жіптерін қосу үшін біз Веганы зерттеуді бастадық.
Dialogue: 0,0:04:22.03,0:04:30.24,Default,,0,0,0,,Олар Альтеяның биологиялық ортасына төтеп бере алатын Риа Игларды, әйелді тұтқынға алды.
Dialogue: 0,0:04:30.24,0:04:36.05,Default,,0,0,0,,Мен Хауа ананы планетамыздың ертеңін дүниеге әкелетіндей етіп жоспарладым.
Dialogue: 0,0:04:36.05,0:04:39.28,Default,,0,0,0,,Онда таңдалған үміткерлердің бірі
Dialogue: 0,0:04:39.28,0:04:42.58,Default,,0,0,0,,Ұйықтап жатқан Хауа Алисия
Dialogue: 0,0:04:44.92,0:04:50.63,Default,,0,0,0,,Дегенмен, ол кеңістік-уақыт телепортациясының әсерлеріне байланысты тоқтатылған анимация күйінде қалады.
Dialogue: 0,0:04:50.63,0:04:53.53,Default,,0,0,0,,Ешқашан оянба
Dialogue: 0,0:04:53.53,0:04:58.37,Default,,0,0,0,,Оның үстіне ол қазір қолданылған зат.
Dialogue: 0,0:04:58.37,0:05:01.74,Default,,0,0,0,,Біз Альтеяға уақытша қайтып келген кезімізде.
Dialogue: 0,0:05:01.74,0:05:05.84,Default,,0,0,0,,Ол бала туып, оны Вегада қалдырды.
Dialogue: 0,0:05:08.38,0:05:11.68,Default,,0,0,0,,Бұл кішкентай нәрсе.
Dialogue: 0,0:05:11.68,0:05:15.55,Default,,0,0,0,,Ол нағыз Хауа бола алмады
Dialogue: 0,0:05:15.55,0:05:18.45,Default,,0,0,0,,Дәл солай, мен ұйықтай бердім
Dialogue: 0,0:05:18.45,0:05:24.03,Default,,0,0,0,,Сені жұбататын қуыршақ, Қанатсыз көбелек
Dialogue: 0,0:05:24.03,0:05:25.96,Default,,0,0,0,,Мені жұбатасыз ба?
Dialogue: 0,0:05:25.96,0:05:29.40,Default,,0,0,0,,Қандай аянышты, Изумо!
Dialogue: 0,0:05:29.40,0:05:35.80,Default,,0,0,0,,Қанатсыз көбелектің қабыршақтары жай ғана елес.
Dialogue: 0,0:05:35.80,0:05:38.31,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:05:38.31,0:05:40.91,Default,,0,0,0,,Ұзақ арманды аяқтау
Dialogue: 0,0:05:44.85,0:05:46.95,Default,,0,0,0,,Микадж!
Dialogue: 0,0:05:53.36,0:05:57.59,Default,,0,0,0,,Алисияға қол тигізуге болмайды.
Dialogue: 0,0:05:57.59,0:06:03.23,Default,,0,0,0,,Сонымен, Изумо Юме но Отоши Мэйді қалай киесіз?
Dialogue: 0,0:06:03.23,0:06:07.10,Default,,0,0,0,,Джин механикалық періштенің ұясына кіргенде,
Dialogue: 0,0:06:07.10,0:06:12.40,Default,,0,0,0,,Біз оны басқарған сирек кездесетін иглерді де анықтай аламыз.
Dialogue: 0,0:06:14.74,0:06:17.34,Default,,0,0,0,,Сіз Изумоны білесіз бе?
Dialogue: 0,0:06:20.25,0:06:25.69,Default,,0,0,0,,Вегада көбелектердің қайта тірілу мағынасы бар.
Dialogue: 0,0:06:25.69,0:06:30.06,Default,,0,0,0,,Кешірімсіз махаббат та жаңғырады.
Dialogue: 0,0:06:30.06,0:06:33.66,Default,,0,0,0,,Тұрғындар балық аулау мен егіншілікпен күнкөреді—
Dialogue: 0,0:06:41.24,0:06:43.24,Default,,0,0,0,,Кагура
Dialogue: 0,0:06:46.07,0:06:49.77,Default,,0,0,0,,Ке да мо но
Dialogue: 0,0:06:55.88,0:07:01.56,Default,,0,0,0,,Аа, дұрыс, Кагура, одан сайын.
Dialogue: 0,0:07:01.56,0:07:07.36,Default,,0,0,0,,Ішіңізде ашуланған қисынсыз өткенді босатыңыз.
Dialogue: 0,0:07:07.36,0:07:10.87,Default,,0,0,0,,Бар жүрегіммен, әр тамшы
Dialogue: 0,0:07:10.87,0:07:17.94,Default,,0,0,0,,Иә, Аполлон мен Сильфи туралы естеліктер сіздің ішіңізде ұйықтайды.
Dialogue: 0,0:07:17.94,0:07:22.71,Default,,0,0,0,,Тұрғындар балық аулау мен егіншілікпен күнкөреді—
Dialogue: 0,0:07:22.71,0:07:28.92,Default,,0,0,0,,Сильфи дәл сіздің жүрегіңізде
Dialogue: 0,0:07:28.92,0:07:31.82,Default,,0,0,0,,Сол тыныс жұпар иісті
Dialogue: 0,0:07:31.82,0:07:38.59,Default,,0,0,0,,Сол тәтті дауыс аспан бақытын әкеледі.
Dialogue: 0,0:07:38.59,0:07:41.93,Default,,0,0,0,,Оның қызуын басшылыққа алады
Dialogue: 0,0:07:41.93,0:07:47.10,Default,,0,0,0,,Махаббат қайта-қайта туады
Dialogue: 0,0:07:47.10,0:07:50.67,Default,,0,0,0,,Қарашы, сен махаббатқа шөлдедің, солай ма?
Dialogue: 0,0:07:50.67,0:07:58.21,Default,,0,0,0,,Сіз де тыйым салынған одақты орындағыңыз келеді, солай ма? Кагура
Dialogue: 0,0:07:58.21,0:08:05.32,Default,,0,0,0,,Көбірек, көбірек, көбірек!
Dialogue: 0,0:08:05.32,0:08:10.19,Default,,0,0,0,,Егер біз оған қалағанын істеуге мүмкіндік берсек —
Dialogue: 0,0:08:10.19,0:08:16.09,Default,,0,0,0,,Дұрыс, ғашықтықтан ұлыған аш аң!
Dialogue: 0,0:08:26.34,0:08:29.58,Default,,0,0,0,,Кел, махаббат аңы.
Dialogue: 0,0:08:29.58,0:08:34.58,Default,,0,0,0,,Шөліңізді қандыру үшін, өз махаббатыңызға саяхатқа шығыңыз
Dialogue: 0,0:09:18.46,0:09:20.46,Default,,0,0,0,,Аң?
Dialogue: 0,0:09:25.07,0:09:29.91,Default,,0,0,0,,Изумо Мен тірілткім келетін нәрсе
Dialogue: 0,0:09:29.91,0:09:33.81,Default,,0,0,0,,Альтеяның ертеңін тоқу Бұл сирек кездесетін иглар жұмбақ емес
Dialogue: 0,0:09:36.01,0:09:42.91,Default,,0,0,0,,Вегада ұйықтайтын механикалық жаратылыс періштесі
Dialogue: 0,0:09:54.20,0:09:58.07,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:09:58.07,0:10:01.37,Default,,0,0,0,,Жарайсың ба? Тек осыны ұмытпа
Dialogue: 0,0:10:01.37,0:10:05.67,Default,,0,0,0,,Саған сенетін ойым жоқ.
Dialogue: 0,0:10:05.67,0:10:08.94,Default,,0,0,0,,Егер бірдеңе болса, онда
Dialogue: 0,0:10:08.94,0:10:10.94,Default,,0,0,0,,Бұл жолы сіз...
Dialogue: 0,0:10:18.65,0:10:21.45,Default,,0,0,0,,Бұл не болды? Бұл күш
Dialogue: 0,0:10:27.70,0:10:32.23,Default,,0,0,0,,Акбаруддин Бадбаяр, шығыңыз.
Dialogue: 0,0:10:32.23,0:10:36.61,Default,,0,0,0,,Жарайсың ба? Ешқашан қыздардың жатақханасына жасырын кіруге тырыспаңыз.
Dialogue: 0,0:10:36.61,0:10:40.98,Default,,0,0,0,,Кайен сен мылтықпен сыныптасыңа қарадың.
Dialogue: 0,0:10:40.98,0:10:44.91,Default,,0,0,0,,Сол жерде біраз уақыт ойланып көріңіз.
Dialogue: 0,0:10:44.91,0:10:47.68,Default,,0,0,0,,О, бұл туралы ше?
Dialogue: 0,0:10:47.68,0:10:53.46,Default,,0,0,0,,Негізі оған Алисия ұнайтын сияқты.
Dialogue: 0,0:10:53.46,0:10:59.19,Default,,0,0,0,,Бұл Алисия ма? Күте тұрыңыз, бірақ бұл сәл басқаша.
Dialogue: 0,0:10:59.19,0:11:02.70,Default,,0,0,0,,Бірақ профиль
Dialogue: 0,0:11:02.70,0:11:04.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:10.44,0:11:12.44,Default,,0,0,0,,Жағымсыз бала
Dialogue: 0,0:11:16.65,0:11:20.85,Default,,0,0,0,,Акбаруддин Бадбаяр жалған болған
Dialogue: 0,0:11:23.22,0:11:27.72,Default,,0,0,0,,Бұл жерде ештеңе жоқ.
Dialogue: 0,0:11:27.72,0:11:31.59,Default,,0,0,0,,Ол Neo-Diva үшін соңғы қабылдау сынағынан өткен адам болды.
Dialogue: 0,0:11:31.59,0:11:34.90,Default,,0,0,0,,Бірақ... Біздің мектепке керегі сол
Dialogue: 0,0:11:34.90,0:11:37.00,Default,,0,0,0,,Өшіруге арналған қуат
Dialogue: 0,0:11:42.07,0:11:45.94,Default,,0,0,0,,Юноха, Джин сенің сезіміңді түсінетінін айтты.
Dialogue: 0,0:11:45.94,0:11:48.91,Default,,0,0,0,,Иә, жұмбақтар өте көп.
Dialogue: 0,0:11:48.91,0:11:51.45,Default,,0,0,0,,Бірақ ол жаман жігітке ұқсамайды.
Dialogue: 0,0:11:51.45,0:11:56.42,Default,,0,0,0,,Біз жақсы дос болып, әртүрлі нәрселерді тыңдап, әртүрлі нәрселерді түсінсек деп тілеймін.
Dialogue: 0,0:11:56.42,0:12:00.02,Default,,0,0,0,,Иә, егер біз бір-бірімізді жан-жақты түсінсек.
Dialogue: 0,0:12:05.49,0:12:09.90,Default,,0,0,0,,Миконо-сан, мен сені қалаймын.
Dialogue: 0,0:12:09.90,0:12:14.40,Default,,0,0,0,,Мен бір нәрсені білгім келеді.
Dialogue: 0,0:12:14.40,0:12:17.71,Default,,0,0,0,,Сол адам Сол адам туралы
Dialogue: 0,0:12:17.71,0:12:20.64,Default,,0,0,0,,Ол кісінің көзі жалғыз көрінді.
Dialogue: 0,0:12:20.64,0:12:23.81,Default,,0,0,0,,Сен оны неге кешіресің?
Dialogue: 0,0:12:23.81,0:12:27.12,Default,,0,0,0,,Тастанды ит сияқты
Dialogue: 0,0:12:27.12,0:12:29.82,Default,,0,0,0,,О-күте-та-се!
Dialogue: 0,0:12:29.82,0:12:32.79,Default,,0,0,0,,А, сап түзеп, сап түзеп
Dialogue: 0,0:12:32.79,0:12:38.63,Default,,0,0,0,,Иә? Не болып жатыр? Екеуің ақымақ болып көрінесіңдер.
Dialogue: 0,0:12:38.63,0:12:41.76,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:41.76,0:12:44.76,Default,,0,0,0,,А, шырын
Dialogue: 0,0:12:48.44,0:12:52.04,Default,,0,0,0,,Әй, маған тістеп берші, ә?
Dialogue: 0,0:12:52.04,0:12:57.44,Default,,0,0,0,,Бұл... қоғамдық әдепсіздік! Эй, бұл жанама сүйіспеншілік, солай ма?
Dialogue: 0,0:12:59.41,0:13:02.08,Default,,0,0,0,,Жанама сүйісу? Ах
Dialogue: 0,0:13:02.08,0:13:04.72,Default,,0,0,0,,Эй, оны да берші.
Dialogue: 0,0:13:04.72,0:13:09.19,Default,,0,0,0,,Ах... Иә, өтінемін.
Dialogue: 0,0:13:09.19,0:13:13.39,Default,,0,0,0,,Джессика, сен шынымен шөлдедің.
Dialogue: 0,0:13:19.63,0:13:22.04,Default,,0,0,0,,Амансың ба? О
Dialogue: 0,0:13:22.04,0:13:24.24,Default,,0,0,0,,Ангарда бір нәрсе бар...
Dialogue: 0,0:13:31.45,0:13:33.88,Default,,0,0,0,,Кагура!
Dialogue: 0,0:13:33.88,0:13:35.82,Default,,0,0,0,,Қақпаны жабыңыз! Хаха
Dialogue: 0,0:13:35.82,0:13:39.52,Default,,0,0,0,,Кагураны Вегаға жіберме.
Dialogue: 0,0:13:41.96,0:13:44.36,Default,,0,0,0,,О, Кагура
Dialogue: 0,0:13:44.36,0:13:47.93,Default,,0,0,0,,Кетуіңді гүлдермен безендірейік
Dialogue: 0,0:13:47.93,0:13:53.54,Default,,0,0,0,,Мен сенің жарқыраған махаббатыңмен үміттенемін
Dialogue: 0,0:13:53.54,0:13:56.84,Default,,0,0,0,,Жаратылыстың машиналық періштесін жарықтандырыңыз
Dialogue: 0,0:14:03.14,0:14:05.34,Default,,0,0,0,,Міне, осында ма?
Dialogue: 0,0:14:12.35,0:14:15.66,Default,,0,0,0,,Қанша шөлдесең де,
Dialogue: 0,0:14:15.66,0:14:18.56,Default,,0,0,0,,Бұндай адамдардың алдында ұятқа қалма.
Dialogue: 0,0:14:18.56,0:14:22.06,Default,,0,0,0,,Қазанға арпа шайын сал. Арпа шайы
Dialogue: 0,0:14:22.06,0:14:24.00,Default,,0,0,0,,Мен арпа шайын ұнатпаймын
Dialogue: 0,0:14:24.00,0:14:27.37,Default,,0,0,0,,Бұл жағдайда қара шай немесе оолонг шайы жақсы болар еді.
Dialogue: 0,0:14:27.37,0:14:30.74,Default,,0,0,0,,Қалай болғанда да, мұндай мінез-құлық ...
Dialogue: 0,0:14:30.74,0:14:33.64,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:14:33.64,0:14:36.14,Default,,0,0,0,,Сіз жатақханаға қайтасыз ба?
Dialogue: 0,0:14:36.14,0:14:39.35,Default,,0,0,0,,Не? Түстен кейінгі сабағыңыз ше?
Dialogue: 0,0:14:39.35,0:14:41.38,Default,,0,0,0,,Сәлем Джессика
Dialogue: 0,0:14:41.38,0:14:46.08,Default,,0,0,0,,Жарайды, мен белдемшенің етегіне соқыр тігістерді қолдандым.
Dialogue: 0,0:14:48.52,0:14:52.96,Default,,0,0,0,,Қарғыс атсын, бұл тәтті және қышқыл.
Dialogue: 0,0:14:52.96,0:14:57.80,Default,,0,0,0,,Бірақ Джин осылай үйреніп кетсе жақсы болар еді.
Dialogue: 0,0:14:57.80,0:15:00.64,Default,,0,0,0,,Сіз не кигіңіз келеді?
Dialogue: 0,0:15:00.64,0:15:04.51,Default,,0,0,0,,Әйелдер әрқашан махаббатқа аш болып, кеуіп қалады.
Dialogue: 0,0:15:04.51,0:15:07.38,Default,,0,0,0,,Джессика да шөлдеді, солай ма?
Dialogue: 0,0:15:07.38,0:15:09.78,Default,,0,0,0,,Не? Кенет не?
Dialogue: 0,0:15:09.78,0:15:16.55,Default,,0,0,0,,Микононың жүрегінің жер асты тамырларын қазып ал, жарай ма?
Dialogue: 0,0:15:16.55,0:15:18.55,Default,,0,0,0,,Миконо-санның...
Dialogue: 0,0:15:23.46,0:15:25.79,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:15:25.79,0:15:28.70,Default,,0,0,0,,Романтикаға тыйым салынады, солай ма?
Dialogue: 0,0:15:28.70,0:15:32.33,Default,,0,0,0,,Менің ойымша, ұрлаушымен төбелес біткеннен кейін ешқандай проблема болмайды.
Dialogue: 0,0:15:32.33,0:15:35.67,Default,,0,0,0,,Осы уақытқа дейін бронь жасасаңыз, ол брондау болады.
Dialogue: 0,0:15:35.67,0:15:38.04,Default,,0,0,0,,Миконо Себебі ол сүйкімді
Dialogue: 0,0:15:38.04,0:15:41.94,Default,,0,0,0,,Уақытыңды алма, оны ешкім тартып алмайды.
Dialogue: 0,0:15:52.42,0:15:55.36,Default,,0,0,0,,Миконо-сан, бәрі жақсы шығар.
Dialogue: 0,0:15:55.36,0:16:00.23,Default,,0,0,0,,А... Иә, кенеттен!
Dialogue: 0,0:16:00.23,0:16:05.63,Default,,0,0,0,,Ағайынды үш қазудың екінші ұлы өте тәуелсіз.
Dialogue: 0,0:16:11.77,0:16:15.18,Default,,0,0,0,,Не?
Dialogue: 0,0:16:15.18,0:16:19.18,Default,,0,0,0,,Кагура, сен ақылыңды жоғалттың.
Dialogue: 0,0:16:19.18,0:16:21.82,Default,,0,0,0,,Мен сені Вегаға жібере алмаймын.
Dialogue: 0,0:16:21.82,0:16:24.32,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:35.20,0:16:39.13,Default,,0,0,0,,Кагура, қазір Митрадан түсіп, Изумо-самаға барыңыз.
Dialogue: 0,0:16:39.13,0:16:41.23,Default,,0,0,0,,​​Бля!
Dialogue: 0,0:16:43.77,0:16:46.47,Default,,0,0,0,,Біздің жолымызға кедергі жасамаңыз!
Dialogue: 0,0:16:51.05,0:16:55.38,Default,,0,0,0,,Изумодан келген қарт, Темір теңіздің жойылғанын қалайсың ба?
Dialogue: 0,0:16:55.38,0:16:59.38,Default,,0,0,0,,Мен бас тартып, қақпаны ашуым керек пе?
Dialogue: 0,0:17:04.96,0:17:09.33,Default,,0,0,0,,9-шы аудандағы темір теңіздің зақымдануы Көрші тұрғындарға шұғыл...
Dialogue: 0,0:17:09.33,0:17:15.23,Default,,0,0,0,,Неліктен? Кагураның жауынгерлік қабілеті үлкен дәрежеге көтерілді.
Dialogue: 0,0:17:17.54,0:17:21.38,Default,,0,0,0,,Жабайы гүлдеп, тез шашылады
Dialogue: 0,0:17:21.38,0:17:25.88,Default,,0,0,0,,Гүлдің аты - Кагура
Dialogue: 0,0:17:25.88,0:17:28.62,Default,,0,0,0,,Көрдіңіз бе? Изумо
Dialogue: 0,0:17:28.62,0:17:32.42,Default,,0,0,0,,Мен әрқашан махаббат жағындамын
Dialogue: 0,0:17:47.87,0:17:51.51,Default,,0,0,0,,Не?
Dialogue: 0,0:17:51.51,0:17:55.74,Default,,0,0,0,,Барлық ұшақтар өрт сызығынан эвакуацияланды. Кез келген уақытта бара аласыз.
Dialogue: 0,0:17:55.74,0:17:57.74,Default,,0,0,0,,Мен оны көргім келеді!
Dialogue: 0,0:18:09.12,0:18:13.32,Default,,0,0,0,,Маған қарғыс атқан әйелді беріңіз
Dialogue: 0,0:18:21.34,0:18:25.64,Default,,0,0,0,,Кел, Кагура, маған махаббатыңды бер.
Dialogue: 0,0:18:50.87,0:18:53.67,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:18:53.67,0:18:55.67,Default,,0,0,0,,Мен және Миконо
Dialogue: 0,0:19:04.91,0:19:08.31,Default,,0,0,0,,Аполлон Сильфи
Dialogue: 0,0:19:11.62,0:19:13.62,Default,,0,0,0,,Сильфия
Dialogue: 0,0:19:25.03,0:19:26.97,Default,,0,0,0,,Не болды? Миконо-сан
Dialogue: 0,0:19:26.97,0:19:30.77,Default,,0,0,0,,Жоқ, тағы не?
Dialogue: 0,0:19:32.81,0:19:35.58,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:35.58,0:19:38.45,Default,,0,0,0,,Сол жігіт өткен күні
Dialogue: 0,0:19:38.45,0:19:40.95,Default,,0,0,0,,Сіз оны өзіңізбен бірге ала алмайсыз.
Dialogue: 0,0:19:40.95,0:19:44.42,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:19:44.42,0:19:48.92,Default,,0,0,0,,Жоқ? Бұл да басқаша...
Dialogue: 0,0:19:48.92,0:19:51.32,Default,,0,0,0,,Эй, м...
Dialogue: 0,0:19:53.83,0:19:56.20,Default,,0,0,0,,Жоқ, Амата-кун?
Dialogue: 0,0:19:56.20,0:20:01.04,Default,,0,0,0,,Жоқ, иә, маған бір сәт қарап жібере аласыз ба?
Dialogue: 0,0:20:01.04,0:20:03.37,Default,,0,0,0,,Не? өтінемін!
Dialogue: 0,0:20:03.37,0:20:05.57,Default,,0,0,0,,Иә
Dialogue: 0,0:20:08.18,0:20:11.55,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:11.55,0:20:15.25,Default,,0,0,0,,Дәл қазір болуы керек емес, иә.
Dialogue: 0,0:20:17.29,0:20:20.62,Default,,0,0,0,,Абдуктормен шайқас аяқталғаннан кейін
Dialogue: 0,0:20:20.62,0:20:23.32,Default,,0,0,0,,Мм, қарсы болмасаң...
Dialogue: 0,0:20:37.57,0:20:41.18,Default,,0,0,0,,Айқай Кагура
Dialogue: 0,0:20:41.18,0:20:46.01,Default,,0,0,0,,Дәл қазір жаныңда махаббат болмаса да
Dialogue: 0,0:20:46.01,0:20:50.81,Default,,0,0,0,,Айқайлау арқылы сіз бәрін өзгерте аласыз
Dialogue: 0,0:20:53.12,0:20:56.22,Default,,0,0,0,,Иә, төңкерілген
Dialogue: 0,0:21:10.20,0:21:13.01,Default,,0,0,0,,Салқын.
Dialogue: 0,0:21:13.01,0:21:16.51,Default,,0,0,0,,Ұрғанның өзі суық.
Dialogue: 0,0:21:33.06,0:21:35.06,Default,,0,0,0,,Қозғалма, Кагура!
Dialogue: 0,0:21:38.53,0:21:41.40,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:21:41.40,0:21:47.08,Default,,0,0,0,,Мен ол әйелді өлтіргім келеді
Dialogue: 0,0:21:47.08,0:21:51.28,Default,,0,0,0,,Мені өлтіріп, қолыма ұста
Dialogue: 0,0:21:54.15,0:21:56.35,Default,,0,0,0,,Мен оны жойғым келеді
Dialogue: 0,0:21:58.89,0:22:00.89,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,0:22:02.86,0:22:05.26,Default,,0,0,0,,Сильфи!
Dialogue: 0,0:22:15.20,0:22:17.20,Default,,0,0,0,,Буси!
Dialogue: 0,0:22:20.68,0:22:23.18,Default,,0,0,0,,Мен және мынау...
Dialogue: 0,0:22:29.38,0:22:31.38,Default,,0,0,0,,Миконо мырза?
Dialogue: 0,0:22:45.17,0:22:48.07,Default,,0,0,0,,Бұл қандай күш...
Dialogue: 0,0:22:48.07,0:22:51.74,Default,,0,0,0,,Микадж Сіз мұны жасадыңыз ба?
Dialogue: 0,0:22:51.74,0:22:54.24,Default,,0,0,0,,Нашар тыңдаушы
Dialogue: 0,0:22:54.24,0:22:58.84,Default,,0,0,0,,Бұл Кагураның жабайы шақыруы
Dialogue: 0,0:23:13.09,0:23:17.93,Default,,0,0,0,,Енді жүр, Кагура.
Dialogue: 0,0:23:17.93,0:23:20.43,Default,,0,0,0,,Жаңа махаббат әлеміне
Dialogue: 0,0:24:57.73,0:25:02.47,Default,,0,0,0,,Сол күні мен көрген фильм екеуміздің танысқанымыз.
Dialogue: 0,0:25:02.47,0:25:06.37,Default,,0,0,0,,Ойланып қарасаң, содан бері мен қалқып келемін.
Dialogue: 0,0:25:06.37,0:25:08.97,Default,,0,0,0,,Ұят!
Dialogue: 0,0:27:35.92,0:27:38.22,Default,,0,0,0,,Иә? Хмм иә
Dialogue: 0,0:27:40.33,0:27:43.23,Default,,0,0,0,,Тұтынушы Тұтынушы Тұтынушы Иә?
Dialogue: 0,0:27:43.23,0:27:45.67,Default,,0,0,0,,О
Dialogue: 0,0:27:45.67,0:27:50.60,Default,,0,0,0,,Аа, менде жақсы сурет бар.
Dialogue: 0,0:27:50.60,0:27:53.77,Default,,0,0,0,,Ах, Ли Иглердің шынайы суреті
Dialogue: 0,0:27:53.77,0:27:55.78,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:27:55.78,0:27:58.01,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:27:58.01,0:28:01.05,Default,,0,0,0,,Сонда мынау, мынау және мынау
Dialogue: 0,0:28:01.05,0:28:03.52,Default,,0,0,0,,Хмм, сен өте сезімталсың.
Dialogue: 0,0:28:03.52,0:28:06.45,Default,,0,0,0,,Жоқ, бұл зерттеу мақсатында.
Dialogue: 0,0:28:06.45,0:28:09.76,Default,,0,0,0,,Тергеу? Ештеңе етпейді.
Dialogue: 0,0:28:09.76,0:28:13.03,Default,,0,0,0,,Қанша төлеуім керек? Ах, ақша жақсы.
Dialogue: 0,0:28:13.03,0:28:15.56,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:28:15.56,0:28:17.60,Default,,0,0,0,,Маған суретке түсуге рұқсат бере аласыз ба?
Dialogue: 0,0:28:17.60,0:28:19.73,Default,,0,0,0,,Е, фотосуреттер проблема болып табылады.
Dialogue: 0,0:28:19.73,0:28:22.94,Default,,0,0,0,,Жарайды, жарайды, таң қалдырады.
Dialogue: 0,0:28:22.94,0:28:25.84,Default,,0,0,0,,Студент атрибуттарын берудің біраз қараңғы жағы бар.
Dialogue: 0,0:28:25.84,0:28:28.21,Default,,0,0,0,,Хот-дог жеу жақсы емес пе?
Dialogue: 0,0:28:28.21,0:28:31.98,Default,,0,0,0,,Ах, бұл жақсы, мен келісемін.
Dialogue: 0,0:28:31.98,0:28:34.42,Default,,0,0,0,,Ей, же, же, а
Dialogue: 0,0:28:34.42,0:28:38.02,Default,,0,0,0,,О, тоқтат!
Dialogue: 0,0:28:41.19,0:28:45.69,Default,,0,0,0,,Джин-кун, сен маған біраз үйреніп қалған сияқтысың. Мен қуаныштымын.
Dialogue: 0,0:30:29.96,0:30:34.64,Default,,0,0,0,,Қандай өкінішті, сен өз сезіміңді мойындай алмадың ба?
Dialogue: 0,0:30:34.64,0:30:36.57,Default,,0,0,0,,Иә
Dialogue: 0,0:30:36.57,0:30:38.94,Default,,0,0,0,,Оған көмектесу мүмкін емес, иә?
Dialogue: 0,0:30:38.94,0:30:44.21,Default,,0,0,0,,Энди мына жерден шұңқыр қазбақ па?
Dialogue: 0,0:30:44.21,0:30:46.65,Default,,0,0,0,,Шұңқыр қазудың қажеті жоқ
Dialogue: 0,0:30:46.65,0:30:50.05,Default,,0,0,0,,Жалпы, Neo Divas тым қиын.
Dialogue: 0,0:30:50.05,0:30:53.65,Default,,0,0,0,,Бұл аздап көңілді және қызықты оқиға ма?
Dialogue: 0,0:30:53.65,0:30:55.59,Default,,0,0,0,,Бұл бізге керек
Dialogue: 0,0:30:55.59,0:30:59.29,Default,,0,0,0,,Сонымен, ор қазу мен қызықты оқиғаның арасында қандай байланыс бар...
Dialogue: 0,0:30:59.29,0:31:01.63,Default,,0,0,0,,Оны маған қалдырыңыз.
Dialogue: 0,0:31:01.63,0:31:04.53,Default,,0,0,0,,Сен ертең қандай күн екенін білесің бе?
Dialogue: 0,0:31:04.53,0:31:08.40,Default,,0,0,0,,Ертең Қасиетті Періште академиясының құрылған күні.
Dialogue: 0,0:31:08.40,0:31:11.21,Default,,0,0,0,,Дүниеге қарсы шабуылдарға қарсы тұра алады
Dialogue: 0,0:31:11.21,0:31:14.07,Default,,0,0,0,,Элементарлы қабілеттерді жаттықтыру мақсатында
Dialogue: 0,0:31:14.07,0:31:18.88,Default,,0,0,0,,Мектептің құрылғанына 12 жыл болды.
Dialogue: 0,0:31:18.88,0:31:20.88,Default,,0,0,0,,Өзіңнен кейінгі көп ата-бабаларыңның атына лайық бол.
Dialogue: 0,0:31:20.88,0:31:23.38,Default,,0,0,0,,Сене алар емеспін, бәрі.
Dialogue: 0,0:31:23.38,0:31:27.35,Default,,0,0,0,,Өтінемін, көп жұмыс істеп, көп оқы.
Dialogue: 0,0:31:27.35,0:31:30.66,Default,,0,0,0,,Жоқ! Кейбір күтуші қызметкерлер іс-шара күні алынып тасталатынын ескеріңіз.
Dialogue: 0,0:31:30.66,0:31:33.56,Default,,0,0,0,,Барлық оқушылар мереке ретінде қарастырылады.
Dialogue: 0,0:31:33.56,0:31:37.26,Default,,0,0,0,,Күнделікті қатаң жаттығуларымызды ұмытып, ертең біздің құрылған күн.
Dialogue: 0,0:31:37.26,0:31:40.17,Default,,0,0,0,,Еріктілермен көңілді іс-шараны жоспарлайық.
Dialogue: 0,0:31:40.17,0:31:44.64,Default,,0,0,0,,Сабақтан кейін ұлдар жатақханасында жоспарлау жиналысын өткіземіз.
Dialogue: 0,0:31:44.64,0:31:47.27,Default,,0,0,0,,Бұл не? Уф ахаха
Dialogue: 0,0:31:47.27,0:31:50.98,Default,,0,0,0,,Энди: «Ой, не?» деп сұрай берді.
Dialogue: 0,0:31:50.98,0:31:53.88,Default,,0,0,0,,А, Джессика да, егер қаласаңыз.
Dialogue: 0,0:31:53.88,0:31:57.38,Default,,0,0,0,,Хью Джессиканы да шақырсаңыз не істейсіз?
Dialogue: 0,0:31:57.38,0:32:01.26,Default,,0,0,0,,Сіз не туралы айтып отырсыз? А, бұл ештеңе емес
Dialogue: 0,0:32:01.26,0:32:03.26,Default,,0,0,0,,Қазір ғана Какёин менің кім екенімді анықтай бастағанда мен дүрлігіп кеттім
Dialogue: 0,0:32:07.19,0:32:10.83,Default,,0,0,0,,Мммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:32:10.83,0:32:14.74,Default,,0,0,0,,О Джин, сен де көмектесе аласың.
Dialogue: 0,0:32:14.74,0:32:16.94,Default,,0,0,0,,А, күте тұр, күте тұр, сәл күте тұр.
Dialogue: 0,0:32:16.94,0:32:19.47,Default,,0,0,0,,Не? Сіз әлі ұйықтайсыз ба?
Dialogue: 0,0:32:19.47,0:32:23.18,Default,,0,0,0,,Қыздар келе жатыр, біз көңілді пижама кешін өткіземіз.
Dialogue: 0,0:32:23.18,0:32:25.61,Default,,0,0,0,,Иә? пижама кеші
Dialogue: 0,0:32:25.61,0:32:30.42,Default,,0,0,0,,Бұл 10 000 және 2 000 жыл бұрын болған делінетін қызықты оқиға болды.
Dialogue: 0,0:32:30.42,0:32:32.42,Default,,0,0,0,,Жоспарлау жиналысы болған жоқ па?
Dialogue: 0,0:32:32.42,0:32:34.59,Default,,0,0,0,,Қалай болғанда да, сіз де көмектесе аласыз.
Dialogue: 0,0:32:34.59,0:32:38.79,Default,,0,0,0,,Оның қыздарға қарсы иммунитеті жоқ сияқты, сондықтан бұл тамаша мүмкіндік.
Dialogue: 0,0:32:38.79,0:32:42.76,Default,,0,0,0,,Ақырында біріктірілген кезде қазір үйренбесем, не істеуім керек?
Dialogue: 0,0:32:42.76,0:32:46.03,Default,,0,0,0,,Комбинация? Иә, біріктіру
Dialogue: 0,0:32:46.03,0:32:50.64,Default,,0,0,0,,Бұл біздің жүрегімізді біріктіріп, бір-бірімізге терең және терең әсер ету.
Dialogue: 0,0:32:50.64,0:32:54.14,Default,,0,0,0,,Егер сіз менен бұл қаншалықты жақсы деп сұрасаңыз, о
Dialogue: 0,0:32:54.14,0:32:58.48,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе? Сөзбен жеткізу қиын
Dialogue: 0,0:32:58.48,0:33:02.35,Default,,0,0,0,,Бірақ сіз оны бастан кешіргеннен кейін түсінесіз.
Dialogue: 0,0:33:02.35,0:33:06.25,Default,,0,0,0,,Мен әлі қызбен қосылмаған болсам да.
Dialogue: 0,0:33:06.25,0:33:08.25,Default,,0,0,0,,Одақ
Dialogue: 0,0:33:17.36,0:33:20.60,Default,,0,0,0,,Мен білмей тұрып, мынандай тесік болды.
Dialogue: 0,0:33:20.60,0:33:23.50,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,0:33:23.50,0:33:25.84,Default,,0,0,0,,Императрица картасы!
Dialogue: 0,0:33:25.84,0:33:28.74,Default,,0,0,0,,Амансың ба? Жарайды
Dialogue: 0,0:33:28.74,0:33:32.04,Default,,0,0,0,,Мен мүлде қорықпаймын.
Dialogue: 0,0:33:34.38,0:33:36.72,Default,,0,0,0,,Сізді таң қалдырғаны үшін кешіріңіз.
Dialogue: 0,0:33:36.72,0:33:39.25,Default,,0,0,0,,Ах Юноха
Dialogue: 0,0:33:39.25,0:33:42.55,Default,,0,0,0,,Эй, мен де саған қосыла аламын ба?
Dialogue: 0,0:33:48.00,0:33:50.86,Default,,0,0,0,,Не болды? Ең жақын дос?
Dialogue: 0,0:33:50.86,0:33:55.10,Default,,0,0,0,,Шрейд Түрме камерасында болу сізге ұқсамайды.
Dialogue: 0,0:33:55.10,0:33:58.94,Default,,0,0,0,,Сіз ауысатын студент үшін алаңдайсыз ба?
Dialogue: 0,0:33:58.94,0:34:01.71,Default,,0,0,0,,Хе, бұл міндетті түрде қолдың түрі.
Dialogue: 0,0:34:01.71,0:34:04.95,Default,,0,0,0,,Жүрегіңнің түбінде қараңғылықты ұстап тұрған сияқтысың.
Dialogue: 0,0:34:04.95,0:34:07.95,Default,,0,0,0,,Иә, дәл сіз сияқты
Dialogue: 0,0:34:07.95,0:34:10.25,Default,,0,0,0,,...
Dialogue: 0,0:34:10.25,0:34:12.32,Default,,0,0,0,,Менде қараңғылық жоқ
Dialogue: 0,0:34:12.32,0:34:15.76,Default,,0,0,0,,Хехехехе ақыры шықты
Dialogue: 0,0:34:15.76,0:34:18.13,Default,,0,0,0,,А-а, Миконо
Dialogue: 0,0:34:18.13,0:34:22.30,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:34:22.30,0:34:26.53,Default,,0,0,0,,Тыйым салынған ұлдар жатақханасына қош келдіңіздер.
Dialogue: 0,0:34:26.53,0:34:31.13,Default,,0,0,0,,Енді ұялудың қажеті жоқ. Артқы жағына дейін барыңыз...
Dialogue: 0,0:34:33.21,0:34:38.18,Default,,0,0,0,,Балалар, сол жерде неге бір-бірлеріңе тап болдыңдар?
Dialogue: 0,0:34:38.18,0:34:40.35,Default,,0,0,0,,Е! Ааа
Dialogue: 0,0:34:40.35,0:34:42.78,Default,,0,0,0,,Сөзіңізді бөлгенім үшін кешіріңіз.
Dialogue: 0,0:34:42.78,0:34:47.29,Default,,0,0,0,,А, бұл күнәкар мақсат емес.
Dialogue: 0,0:34:47.29,0:34:50.86,Default,,0,0,0,,Ертеңгі құрылған күніне байланысты қызықты оқиғада
Dialogue: 0,0:34:50.86,0:34:52.93,Default,,0,0,0,,Қызықты ма? Уф
Dialogue: 0,0:34:52.93,0:34:55.10,Default,,0,0,0,,А, жоқ, мен толқып тұрмын десем де, бәрібір.
Dialogue: 0,0:34:55.10,0:34:57.03,Default,,0,0,0,,Бұл махаббаттың толқуы туралы емес.
Dialogue: 0,0:34:57.03,0:34:59.87,Default,,0,0,0,,Жастарға арналған ескерткіш мағынасында
Dialogue: 0,0:34:59.87,0:35:02.70,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:35:02.70,0:35:06.57,Default,,0,0,0,,Өйткені бұл жерлерде ұл балалардың лас заттары көп.
Dialogue: 0,0:35:06.57,0:35:09.24,Default,,0,0,0,,MIX оны жасыруды айтты.
Dialogue: 0,0:35:09.24,0:35:11.31,Default,,0,0,0,,Ықылық естіңіз
Dialogue: 0,0:35:11.31,0:35:13.65,Default,,0,0,0,,Мен ұлдар жатақханасында бірінші рет болуым.
Dialogue: 0,0:35:13.65,0:35:16.22,Default,,0,0,0,,Мен оның шынайылығын тексергім келді.
Dialogue: 0,0:35:16.22,0:35:19.85,Default,,0,0,0,,Оны рұқсатсыз тексеруге тырыспаңыз.
Dialogue: 0,0:35:19.85,0:35:22.22,Default,,0,0,0,,Хехе… Ой!
Dialogue: 0,0:35:22.22,0:35:25.03,Default,,0,0,0,,Сәлем
Dialogue: 0,0:35:25.03,0:35:27.79,Default,,0,0,0,,О, мен лас фото тауып алдым.
Dialogue: 0,0:35:27.79,0:35:30.43,Default,,0,0,0,,Уф аа
Dialogue: 0,0:35:30.43,0:35:32.93,Default,,0,0,0,,Сильфи? О
Dialogue: 0,0:35:32.93,0:35:35.84,Default,,0,0,0,,Ол актриса ма? «Аквариа билейтін аспан»
Dialogue: 0,0:35:35.84,0:35:40.11,Default,,0,0,0,,Ол батыр қыз. Мен оның жанкүйерімін.
Dialogue: 0,0:35:40.11,0:35:43.54,Default,,0,0,0,,Бірақ неге бром емес, фотосурет?
Dialogue: 0,0:35:43.54,0:35:46.21,Default,,0,0,0,,Джин-кун да оның жанкүйері, солай ма?
Dialogue: 0,0:35:46.21,0:35:49.05,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:35:49.05,0:35:52.09,Default,,0,0,0,,Неге бәріне көрсетпейсің? Не?
Dialogue: 0,0:35:52.09,0:35:55.72,Default,,0,0,0,,Қараңдаршы, Алисия ән айтатын машина бар.
Dialogue: 0,0:35:55.72,0:35:59.03,Default,,0,0,0,,Әй, бұл қандай нәрсе? Маған көрсет
Dialogue: 0,0:35:59.03,0:36:02.83,Default,,0,0,0,,Уф аа
Dialogue: 0,0:36:06.63,0:36:09.54,Default,,0,0,0,,Керемет
Dialogue: 0,0:36:09.54,0:36:12.44,Default,,0,0,0,,Мұндай нәрсені қайдан алдың?
Dialogue: 0,0:36:12.44,0:36:14.74,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:36:14.74,0:36:17.34,Default,,0,0,0,,Не? Мерейтойлық іс-шара
Dialogue: 0,0:36:17.34,0:36:20.18,Default,,0,0,0,,Біз «Аквариум билейтін аспан» фильмін көрсетеміз.
Dialogue: 0,0:36:20.18,0:36:22.22,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:36:22.22,0:36:24.92,Default,,0,0,0,,Эй, эй, хмм.
Dialogue: 0,0:36:30.66,0:36:34.23,Default,,0,0,0,,Бүгін түнде Берлин үлкен экранда болады
Dialogue: 0,0:36:34.23,0:36:37.80,Default,,0,0,0,,«Акварианың билейтін аспаны» Шұғыл скрининг шешімі
Dialogue: 0,0:36:37.80,0:36:42.27,Default,,0,0,0,,Берлин алдындағы аула Басталуы 20:00
Dialogue: 0,0:36:42.27,0:36:45.67,Default,,0,0,0,,Шрейдтің ашылудағы жанды орындауы
Dialogue: 0,0:36:45.67,0:36:48.44,Default,,0,0,0,,Берлинде фильм көрсетуді жоспарлап отырсыз ба?
Dialogue: 0,0:36:48.44,0:36:50.38,Default,,0,0,0,,Рұқсат алдыңыз деп ойлаймын?
Dialogue: 0,0:36:50.38,0:36:56.02,Default,,0,0,0,,Бұл анық. Бұл құрылу мерейтойына арналған іс-шара. Көңілді болайық.
Dialogue: 0,0:36:56.02,0:36:58.92,Default,,0,0,0,,Барлығы бірге көңіл көтеріп, тамашалай алады.
Dialogue: 0,0:36:58.92,0:37:01.66,Default,,0,0,0,,Жалғыз зейін қойып, қарауға болады.
Dialogue: 0,0:37:01.66,0:37:04.56,Default,,0,0,0,,Ерлі-зайыптылар ретінде романтикалық көру үшін жақсы
Dialogue: 0,0:37:04.56,0:37:08.43,Default,,0,0,0,,Неге менімен бірге көрмейсің? Неге сен?
Dialogue: 0,0:37:08.43,0:37:11.23,Default,,0,0,0,,Амансың ба? қашан және қай уақытта
Dialogue: 0,0:37:11.23,0:37:13.90,Default,,0,0,0,,Ұрлаушы шабуылы болуы мүмкін.
Dialogue: 0,0:37:13.90,0:37:18.34,Default,,0,0,0,,Сізге мезгіл-мезгіл үзіліс қажет болуы мүмкін.
Dialogue: 0,0:37:18.34,0:37:20.57,Default,,0,0,0,,Дүние – арман
Dialogue: 0,0:37:20.57,0:37:27.05,Default,,0,0,0,,Ал фильмге өртенген арман да арман
Dialogue: 0,0:37:27.05,0:37:29.75,Default,,0,0,0,,Штаб, жауап бер.
Dialogue: 0,0:37:29.75,0:37:32.99,Default,,0,0,0,,Бұл Джин. Сен не істеп жатырсың? Ешкім жоқ па?
Dialogue: 0,0:37:32.99,0:37:35.92,Default,,0,0,0,,Қарғыс атқыр, бірдеңе дұрыс болмады ма?
Dialogue: 0,0:37:35.92,0:37:38.73,Default,,0,0,0,,Егер сіз бұл хабарды естісеңіз, дереу бізге хабарласыңыз.
Dialogue: 0,0:37:38.73,0:37:42.13,Default,,0,0,0,,Шын Хауа үшін үміткер Лия Иглар анықталды.
Dialogue: 0,0:37:42.13,0:37:44.63,Default,,0,0,0,,Механикалық періштенің қосалқы машинасын ұрлап, оны қайтарыңыз.
Dialogue: 0,0:37:44.63,0:37:46.93,Default,,0,0,0,,Қақпаны ашуға дайындалу
Dialogue: 0,0:37:46.93,0:37:50.43,Default,,0,0,0,,Джин-кун, о, аа.
Dialogue: 0,0:37:52.74,0:37:56.21,Default,,0,0,0,,Сіз мұны дәл қазір естідіңіз бе?
Dialogue: 0,0:37:56.21,0:37:59.45,Default,,0,0,0,,Не? Сіз тыңдадыңыз ба?
Dialogue: 0,0:37:59.45,0:38:02.15,Default,,0,0,0,,Мен ештеңе жоқ
Dialogue: 0,0:38:02.15,0:38:05.55,Default,,0,0,0,,Юноха, сен мұнда не істеп жүрсің? Маған көмектесші.
Dialogue: 0,0:38:08.09,0:38:10.62,Default,,0,0,0,,Уф, күте тұрыңыз.
Dialogue: 0,0:38:10.62,0:38:13.53,Default,,0,0,0,,Иә
Dialogue: 0,0:38:13.53,0:38:15.53,Default,,0,0,0,,О
Dialogue: 0,0:38:18.50,0:38:20.60,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:38:23.20,0:38:25.80,Default,,0,0,0,,Жоқ, о
Dialogue: 0,0:38:28.01,0:38:30.01,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:38:33.75,0:38:37.62,Default,,0,0,0,,Ұнамаған
Dialogue: 0,0:38:37.62,0:38:40.62,Default,,0,0,0,,Сонымен, ананастың үстіңгі жағы да керемет.
Dialogue: 0,0:38:40.62,0:38:44.39,Default,,0,0,0,,Жарайды, мен пиццадағы ананасқа шыдай алмаймын.
Dialogue: 0,0:38:44.39,0:38:48.16,Default,,0,0,0,,О, эй, Джессика, оны бізбен бірге көргің келе ме?
Dialogue: 0,0:38:48.16,0:38:51.00,Default,,0,0,0,,Кейбір дәмді пицца жеткізу мейрамханалары бар.
Dialogue: 0,0:38:51.00,0:38:55.20,Default,,0,0,0,,Жақсы, бірақ мен
Dialogue: 0,0:38:57.40,0:38:59.74,Default,,0,0,0,,Сол күні, сол кинотеатрда
Dialogue: 0,0:38:59.74,0:39:03.01,Default,,0,0,0,,«Аквариум билейтін аспан» фильмін көрмеген болсаңыз
Dialogue: 0,0:39:03.01,0:39:06.85,Default,,0,0,0,,Біз кездескен жоқпыз ғой?
Dialogue: 0,0:39:06.85,0:39:09.12,Default,,0,0,0,,Иә, онда
Dialogue: 0,0:39:09.12,0:39:12.02,Default,,0,0,0,,Мен бұл жерде ешқашан болған емеспін.
Dialogue: 0,0:39:13.95,0:39:16.49,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:39:16.49,0:39:19.99,Default,,0,0,0,,Неліктен кешірім сұрайсыз? Өйткені Миконо-сан
Dialogue: 0,0:39:19.99,0:39:22.56,Default,,0,0,0,,Мен өзіме қауіп төндірдім.
Dialogue: 0,0:39:22.56,0:39:24.80,Default,,0,0,0,,Бұл сенің кінәң емес, Амата.
Dialogue: 0,0:39:24.80,0:39:29.60,Default,,0,0,0,,Мен өз тағдырымды таңдадым.
Dialogue: 0,0:39:29.60,0:39:31.90,Default,,0,0,0,,Бұл туралы фильмде Алисия да айтқан.
Dialogue: 0,0:39:33.97,0:39:38.47,Default,,0,0,0,,Тағдырға ұшатын әр адамның қанаты бар.
Dialogue: 0,0:39:48.32,0:39:52.09,Default,,0,0,0,,Менің анам да өз тағдырынан осылай аттап кетті ме деп ойлаймын.
Dialogue: 0,0:39:52.09,0:39:55.53,Default,,0,0,0,,Не? Ха
Dialogue: 0,0:39:55.53,0:40:00.03,Default,,0,0,0,,Кішкентай кезімде анам мені тастап кеткен.
Dialogue: 0,0:40:02.07,0:40:05.81,Default,,0,0,0,,Анасы Алисия.
Dialogue: 0,0:40:05.81,0:40:11.04,Default,,0,0,0,,О, фото...
Dialogue: 0,0:40:11.04,0:40:14.92,Default,,0,0,0,,Ана тағдырды оңай жеңді.
Dialogue: 0,0:40:14.92,0:40:17.62,Default,,0,0,0,,Ол мені тастап, бір жаққа кетті.
Dialogue: 0,0:40:19.75,0:40:22.85,Default,,0,0,0,,Мен сені шығарып салудан басқа ештеңе істей алмаймын.
Dialogue: 0,0:40:24.93,0:40:27.96,Default,,0,0,0,,Анама, мен
Dialogue: 0,0:40:27.96,0:40:31.06,Default,,0,0,0,,Мен қалаусыз бала болдым.
Dialogue: 0,0:40:31.06,0:40:33.93,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:40:33.93,0:40:38.37,Default,,0,0,0,,Мен үшін де солай. Кайен әрқашан жақсы қыз.
Dialogue: 0,0:40:38.37,0:40:41.81,Default,,0,0,0,,Мен әрқашан қабілетсіз бала болдым.
Dialogue: 0,0:40:41.81,0:40:46.65,Default,,0,0,0,,Сузусиро отбасы ұрпақтар бойы тамаша қарапайым қабілеттерге ие отбасы болды.
Dialogue: 0,0:40:46.65,0:40:52.25,Default,,0,0,0,,Менің күшім жоқ, сондықтан мен оны үнемі артқа тастаймын.
Dialogue: 0,0:40:52.25,0:40:55.55,Default,,0,0,0,,Тіпті Кайен Нео Диваға қосылған кезде де
Dialogue: 0,0:40:59.79,0:41:03.26,Default,,0,0,0,,Бірақ қолынан келмейтін бала болса да.
Dialogue: 0,0:41:03.26,0:41:08.10,Default,,0,0,0,,Қажетсіз балалар жоқ. Қажетсіз балалар жоқ.
Dialogue: 0,0:41:08.10,0:41:11.84,Default,,0,0,0,,Біреуге, бір жерде, міндетті түрде қажет.
Dialogue: 0,0:41:11.84,0:41:15.74,Default,,0,0,0,,Мен сені күтемін.
Dialogue: 0,0:41:15.74,0:41:20.58,Default,,0,0,0,,Өйткені Амата-кун маған соны түсінді.
Dialogue: 0,0:41:20.58,0:41:23.95,Default,,0,0,0,,Мен...
Dialogue: 0,0:41:23.95,0:41:27.32,Default,,0,0,0,,Хмм, рахмет
Dialogue: 0,0:41:27.32,0:41:31.16,Default,,0,0,0,,Эй, сен менімен фильм көргің келе ме?
Dialogue: 0,0:41:31.16,0:41:34.06,Default,,0,0,0,,Жарайды, мені ешкім мазаламайды.
Dialogue: 0,0:41:34.06,0:41:36.46,Default,,0,0,0,,Мен сендерге арнайы орындар дайындаймын.
Dialogue: 0,0:41:36.46,0:41:38.86,Default,,0,0,0,,Арнайы орындық дегеніміз не?
Dialogue: 0,0:41:40.87,0:41:45.57,Default,,0,0,0,,Сол тағдырдың үстінен ұшатын қанаттарымен
Dialogue: 0,0:41:49.48,0:41:55.35,Default,,0,0,0,,Ой-о-а-а-а-а
Dialogue: 0,0:41:55.35,0:41:58.08,Default,,0,0,0,,Бұл тіпті фильм емес, солай ма?
Dialogue: 0,0:41:58.08,0:42:00.18,Default,,0,0,0,,Сізге көп салмақ дайындау керек.
Dialogue: 0,0:42:01.99,0:42:04.52,Default,,0,0,0,,Уау, мені сонда тартпа.
Dialogue: 0,0:42:04.52,0:42:06.76,Default,,0,0,0,,Бұлай айтатын уақыт емес.
Dialogue: 0,0:42:06.76,0:42:11.26,Default,,0,0,0,,Уа, у-у-у, Миконо-сан
Dialogue: 0,0:42:25.15,0:42:27.11,Default,,0,0,0,,Хмм.
Dialogue: 0,0:42:27.11,0:42:31.35,Default,,0,0,0,,Мен кешірім сұрауым керек пе?
Dialogue: 0,0:42:31.35,0:42:35.65,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, мен ескерту аламын және оларды түсіре алмаймын.
Dialogue: 0,0:42:42.83,0:42:44.83,Default,,0,0,0,,Әй
Dialogue: 0,0:42:54.41,0:42:58.51,Default,,0,0,0,,Бұл да өте керемет.
Dialogue: 0,0:43:00.91,0:43:05.32,Default,,0,0,0,,Сіз бұл жауапкершілікті қалай алуды жоспарлайсыз?
Dialogue: 0,0:43:05.32,0:43:07.32,Default,,0,0,0,,Жоқ... сен әзілдеп тұрсың ғой?
Dialogue: 0,0:43:07.32,0:43:12.06,Default,,0,0,0,,Менің бойымда мұндай ұғым бар деп ойлайсың ба?
Dialogue: 0,0:43:12.06,0:43:15.10,Default,,0,0,0,,Қымбаттым, одан да көп.
Dialogue: 0,0:43:15.10,0:43:19.20,Default,,0,0,0,,Джин қызық нәрсе істеп жатыр.
Dialogue: 0,0:43:19.20,0:43:24.34,Default,,0,0,0,,Ол да махаббатқа жүгірмек
Dialogue: 0,0:43:24.34,0:43:28.01,Default,,0,0,0,,Не? махаббат әрқашан
Dialogue: 0,0:43:28.01,0:43:30.01,Default,,0,0,0,,Қылмыс жасау
Dialogue: 0,0:43:37.05,0:43:39.79,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:43:39.79,0:43:42.76,Default,,0,0,0,,Кешіріңіз, бәрі жақсы.
Dialogue: 0,0:43:42.76,0:43:46.53,Default,,0,0,0,,Мен сәл таң қалдым, бәрібір.
Dialogue: 0,0:43:46.53,0:43:51.90,Default,,0,0,0,,Әр адамның білгісі келмейтін құпиялары бар деп ойлаймын.
Dialogue: 0,0:43:51.90,0:43:55.80,Default,,0,0,0,,Жоқ, бұл... Бірақ маған сеніңіз.
Dialogue: 0,0:43:55.80,0:44:00.34,Default,,0,0,0,,Шынымды айтсам, мен ештеңе естімедім.
Dialogue: 0,0:44:00.34,0:44:03.28,Default,,0,0,0,,Біз мақсатты өзгерте алмаймыз, сондықтан…
Dialogue: 0,0:44:03.28,0:44:06.38,Default,,0,0,0,,Джин-кун? Жоқ... бұл ештеңе емес.
Dialogue: 0,0:44:08.78,0:44:11.22,Default,,0,0,0,,Сен менің шарларымды түзеттің.
Dialogue: 0,0:44:11.22,0:44:14.22,Default,,0,0,0,,Тама? бұл баланың аты
Dialogue: 0,0:44:14.22,0:44:17.02,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:44:17.02,0:44:20.83,Default,,0,0,0,,Рахмет Жоқ
Dialogue: 0,0:44:20.83,0:44:23.73,Default,,0,0,0,,Иә, татуласу белгісі ретінде.
Dialogue: 0,0:44:23.73,0:44:27.17,Default,,0,0,0,,Бүгін кешке «Aquaria’s Dancing Sky» фильмін бірге көргіңіз келе ме?
Dialogue: 0,0:44:27.17,0:44:32.67,Default,,0,0,0,,Мен бұл фильмді әлі көрген жоқпын.
Dialogue: 0,0:44:32.67,0:44:36.64,Default,,0,0,0,,Сондықтан мен оны асыға күтемін.
Dialogue: 0,0:44:36.64,0:44:40.88,Default,,0,0,0,,Жарайды, бұл уәде.
Dialogue: 0,0:44:40.88,0:44:43.38,Default,,0,0,0,,Уфуфу Олай болса.
Dialogue: 0,0:44:43.38,0:44:46.89,Default,,0,0,0,,Ах, мынау, ах
Dialogue: 0,0:44:46.89,0:44:51.29,Default,,0,0,0,,Ах, хехе
Dialogue: 0,0:44:51.29,0:44:53.89,Default,,0,0,0,,Мен түнде осында күтемін.
Dialogue: 0,0:44:57.86,0:44:59.86,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:45:02.07,0:45:06.27,Default,,0,0,0,,Мүмкін бұл
Dialogue: 0,0:45:06.27,0:45:08.27,Default,,0,0,0,,Одақ
Dialogue: 0,0:45:24.59,0:45:26.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:29.26,0:45:31.26,Default,,0,0,0,,Хмм
Dialogue: 0,0:45:33.93,0:45:35.93,Default,,0,0,0,,Әрине, осында
Dialogue: 0,0:45:38.47,0:45:40.47,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:45:54.35,0:45:56.29,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:45:56.29,0:45:58.29,Default,,0,0,0,,Ах
Dialogue: 0,0:46:00.46,0:46:02.90,Default,,0,0,0,,О
Dialogue: 0,0:46:02.90,0:46:05.20,Default,,0,0,0,,Джин-кун
Dialogue: 0,0:46:05.20,0:46:07.40,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:46:14.24,0:46:17.04,Default,,0,0,0,,Сіз мені естисіз бе? Джин Ах
Dialogue: 0,0:46:17.04,0:46:19.51,Default,,0,0,0,,Кагура сол жаққа қарай бет алды.
Dialogue: 0,0:46:19.51,0:46:22.98,Default,,0,0,0,,Жақында қақпа Вегада ашылуы керек.
Dialogue: 0,0:46:22.98,0:46:27.82,Default,,0,0,0,,Сирек кездесетін Игларды қорғаңыз және ол бәрін жоймай тұрып оралыңыз.
Dialogue: 0,0:46:27.82,0:46:29.82,Default,,0,0,0,,Ах
Dialogue: 0,0:46:34.49,0:46:37.59,Default,,0,0,0,,А, күткенім үшін кешіріңіз.
Dialogue: 0,0:46:40.30,0:46:42.30,Default,,0,0,0,,Уа, не болды?
Dialogue: 0,0:46:47.84,0:46:50.64,Default,,0,0,0,,Барабан ырғағымен бірге қозғалып, ол жыртқыш жануардың тырнақ іздерінің пішінін алды.
Dialogue: 0,0:47:10.10,0:47:12.03,Default,,0,0,0,,Кя Кя
Dialogue: 0,0:47:12.03,0:47:14.27,Default,,0,0,0,,Қанпай
Dialogue: 0,0:47:14.27,0:47:16.27,Default,,0,0,0,,Хмм.
Dialogue: 0,0:47:19.21,0:47:21.21,Default,,0,0,0,,Хехехе
Dialogue: 0,0:47:30.62,0:47:33.62,Default,,0,0,0,,Олай болса, барлығына, күткендеріңізге рахмет.
Dialogue: 0,0:47:33.62,0:47:37.39,Default,,0,0,0,,«Аквариумның билейтін аспаны» мәңгілік шедевр
Dialogue: 0,0:47:37.39,0:47:40.69,Default,,0,0,0,,Соңына дейін ләззат алыңыз.
Dialogue: 0,0:47:48.87,0:47:52.41,Default,,0,0,0,,Бұл кездесу және қоштасу
Dialogue: 0,0:47:52.41,0:47:55.51,Default,,0,0,0,,Және ғажайыптар туралы әңгімелер
Dialogue: 0,0:47:57.94,0:48:00.88,Default,,0,0,0,,10 000 және 2 000 жыл бұрын
Dialogue: 0,0:48:00.88,0:48:05.28,Default,,0,0,0,,Өмір ағашының астында ант еткен махаббат хикаясы
Dialogue: 0,0:48:15.26,0:48:19.76,Default,,0,0,0,,Тағдырға ұшатын әр адамның қанаты бар.
Dialogue: 0,0:48:33.55,0:48:35.55,Default,,0,0,0,,Га
Dialogue: 0,0:48:56.67,0:49:00.54,Default,,0,0,0,,Ух Хух
Dialogue: 0,0:49:00.54,0:49:03.24,Default,,0,0,0,,иә иә иә
Dialogue: 0,0:49:03.24,0:49:05.34,Default,,0,0,0,,Га
Dialogue: 0,0:49:08.72,0:49:13.12,Default,,0,0,0,,Абдектор дабылы берілді Абдектор дабылы берілді
Dialogue: 0,0:49:13.12,0:49:15.79,Default,,0,0,0,,Өтірік! Неліктен сізді осындай уақытта жібереді?
Dialogue: 0,0:49:15.79,0:49:17.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:22.26,0:49:24.26,Default,,0,0,0,,Әй, Кагура!
Dialogue: 0,0:49:28.74,0:49:31.54,Default,,0,0,0,,А, ол осында.
Dialogue: 0,0:49:31.54,0:49:34.94,Default,,0,0,0,,Уф ах аа ах кя
Dialogue: 0,0:49:37.34,0:49:40.98,Default,,0,0,0,,Ауырды, жақсысың ба? Иә
Dialogue: 0,0:49:40.98,0:49:43.28,Default,,0,0,0,,...
Dialogue: 0,0:49:49.69,0:49:52.19,Default,,0,0,0,,Менің сұм әйелім
Dialogue: 0,0:49:52.19,0:49:54.19,Default,,0,0,0,,әжесі келіп, оны алып кетуге асығып тұрғандай.
Dialogue: 0,0:49:57.03,0:49:59.80,Default,,0,0,0,,А-а-а
Dialogue: 0,0:49:59.80,0:50:03.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:03.24,0:50:06.04,Default,,0,0,0,,Юноха Трур Ах
Dialogue: 0,0:50:06.04,0:50:08.34,Default,,0,0,0,,Менімен бірге жүр!
Dialogue: 0,0:51:47.67,0:51:51.01,Default,,0,0,0,,Баланың ойы Алта Димана болғанда
Dialogue: 0,0:51:51.01,0:51:54.48,Default,,0,0,0,,Қыз Синдимана туралы алғаш рет біледі.
Dialogue: 0,0:51:54.48,0:51:58.08,Default,,0,0,0,,Дегенмен, олардың екеуі
Dialogue: 0,0:51:59.58,0:52:05.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory