Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.40,0:00:42.60,Default,,0,0,0,,Махаббатқа жол берілмейді!
Dialogue: 0,0:00:48.14,0:00:50.18,Default,,0,0,0,,Бұл қария кім?
Dialogue: 0,0:00:50.18,0:00:54.62,Default,,0,0,0,,Сіз Neo-Diva-мен туыссыз ба? Сиқыршы? сайқымазақ?
Dialogue: 0,0:00:54.62,0:00:56.55,Default,,0,0,0,,Махаббатқа қандай тыйым салынған?
Dialogue: 0,0:00:56.55,0:00:58.52,Default,,0,0,0,,Қабырға бітсе де
Dialogue: 0,0:00:58.52,0:01:00.72,Default,,0,0,0,,Иә! Бұл дұрыс! Бұл дұрыс!
Dialogue: 0,0:01:13.00,0:01:15.44,Default,,0,0,0,,Қош келдіңіз, төраға
Dialogue: 0,0:01:15.44,0:01:17.74,Default,,0,0,0,,Иә? Төраға?
Dialogue: 0,0:01:27.12,0:01:29.69,Default,,0,0,0,,Төраға, пончик алыңыз.
Dialogue: 0,0:01:29.69,0:01:33.52,Default,,0,0,0,,Рахмет... Мына қыз президент пе?
Dialogue: 0,0:01:33.52,0:01:36.43,Default,,0,0,0,,Иә, және сол адам
Dialogue: 0,0:01:36.43,0:01:40.23,Default,,0,0,0,,Осы неодиваның бас қолбасшысы Фудо ЗЭН
Dialogue: 0,0:01:44.10,0:01:46.04,Default,,0,0,0,,Бас қолбасшы және басқарма төрағасы
Dialogue: 0,0:01:46.04,0:01:50.57,Default,,0,0,0,,Ол Акварион жұмбағын шешу үшін сапарын жалғастырды.
Dialogue: 0,0:01:50.57,0:01:52.88,Default,,0,0,0,,Қайтып келгенде не істедің?
Dialogue: 0,0:01:52.88,0:01:56.21,Default,,0,0,0,,Сіз қандай да бір анықтама алдыңыз ба?
Dialogue: 0,0:01:56.21,0:01:58.95,Default,,0,0,0,,Маған хабарланған жоқ
Dialogue: 0,0:01:58.95,0:02:02.82,Default,,0,0,0,,Сіз айтып отырған жұмбақ және тыйым салынған Акварион.
Dialogue: 0,0:02:02.82,0:02:04.75,Default,,0,0,0,,Суоми ханым
Dialogue: 0,0:02:04.75,0:02:07.36,Default,,0,0,0,,Аполлон мен Сильфидің тарихын білесіз бе?
Dialogue: 0,0:02:07.36,0:02:11.53,Default,,0,0,0,,Бұл бәрі білетін ертегі.
Dialogue: 0,0:02:11.53,0:02:16.07,Default,,0,0,0,,Бұл фильмге түсірілген болуы керек, менің ойымша, «Аквариум билейтін аспан»
Dialogue: 0,0:02:16.07,0:02:20.90,Default,,0,0,0,,Иә, 12 000 жыл бұрын, қаза тапқан періштелермен шайқастан кейін.
Dialogue: 0,0:02:20.90,0:02:25.61,Default,,0,0,0,,Бірін-бірі сүйген Аполлон мен Сильфи ажырасып кетті.
Dialogue: 0,0:02:25.61,0:02:30.38,Default,,0,0,0,,Тым қарқынды ойлар кейде жойылуға әкелуі мүмкін.
Dialogue: 0,0:02:30.38,0:02:35.12,Default,,0,0,0,,Аполлон мен Сильфидің жыртылған жүректері бір-бірін аңсайды.
Dialogue: 0,0:02:35.12,0:02:37.19,Default,,0,0,0,,Қазіргі заманда жанданған акварион
Dialogue: 0,0:02:37.19,0:02:39.92,Default,,0,0,0,,Бұл оның бақылаудан шығуына әкелетін фактор.
Dialogue: 0,0:02:39.92,0:02:42.53,Default,,0,0,0,,Қашқын... Сондықтан
Dialogue: 0,0:02:42.53,0:02:46.90,Default,,0,0,0,,Нео Даева Акварионның шынайы күшін жауып тастады.
Dialogue: 0,0:02:46.90,0:02:50.30,Default,,0,0,0,,Сіз мені жақсы білесіз, Донал мырза.
Dialogue: 0,0:02:50.30,0:02:52.97,Default,,0,0,0,,Иә, бұл маған ұнамайды.
Dialogue: 0,0:02:52.97,0:02:56.84,Default,,0,0,0,,Бірақ қазір жау күшейе түсуде.
Dialogue: 0,0:02:56.84,0:03:00.84,Default,,0,0,0,,Неодивалар да өз жүйелерін өзгертуге мәжбүр.
Dialogue: 0,0:03:00.84,0:03:03.48,Default,,0,0,0,,Иә, біз
Dialogue: 0,0:03:03.48,0:03:06.98,Default,,0,0,0,,Тіпті тыйым салынған күшке де сенуден басқа амалымыз жоқ.
Dialogue: 0,0:03:08.98,0:03:12.89,Default,,0,0,0,,Дөңгелек – сақиналармен қоршалған қуыс.
Dialogue: 0,0:03:12.89,0:03:17.69,Default,,0,0,0,,Ортаңызда орналасқан барлық бос жерлерді жұтып қойыңыз.
Dialogue: 0,0:03:17.69,0:03:20.79,Default,,0,0,0,,Донал Дантос…
Dialogue: 0,0:05:22.95,0:05:25.72,Default,,0,0,0,,Лорд Джин, лорд Изумо шақырып жатыр.
Dialogue: 0,0:05:25.72,0:05:29.59,Default,,0,0,0,,Иә? Апыр-ай! Алисия HD
Dialogue: 0,0:05:29.59,0:05:32.19,Default,,0,0,0,,Мұндай сирек деректерді қайдан алдыңыз?
Dialogue: 0,0:05:32.19,0:05:34.13,Default,,0,0,0,,Уау
Dialogue: 0,0:05:34.13,0:05:37.23,Default,,0,0,0,,Бұл не, Изумо-сама?
Dialogue: 0,0:05:47.68,0:05:49.65,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:49.65,0:05:54.32,Default,,0,0,0,,Джин, бұл сіз қайтарған шайқас деректерінің талдау нәтижесі.
Dialogue: 0,0:05:54.32,0:05:56.25,Default,,0,0,0,,Пішін өзгертулерімен
Dialogue: 0,0:05:56.25,0:05:59.52,Default,,0,0,0,,Механикалық періштенің қабілеттілік параметрлері де өзгерді.
Dialogue: 0,0:05:59.52,0:06:03.19,Default,,0,0,0,,Мүмкін трансформацияға дейін және кейін.
Dialogue: 0,0:06:03.19,0:06:07.06,Default,,0,0,0,,Өйткені біз мүлде басқа сипаттағы шайқасқа шықтық.
Dialogue: 0,0:06:07.06,0:06:12.70,Default,,0,0,0,,Тағы бір нәрсе: Қорытынды техниканы шығарғанда
Dialogue: 0,0:06:12.70,0:06:16.21,Default,,0,0,0,,Реа Иглердің реакциясы расталды.
Dialogue: 0,0:06:16.21,0:06:19.81,Default,,0,0,0,,Рея Иглер бортта болды ма?
Dialogue: 0,0:06:19.81,0:06:24.48,Default,,0,0,0,,Лорд Изумо, лорд Кагураның Митра Гунис жіберді.
Dialogue: 0,0:06:24.48,0:06:26.42,Default,,0,0,0,,Артқа серпілу
Dialogue: 0,0:06:26.42,0:06:29.32,Default,,0,0,0,,Тек Гуниспен Вегаға барайық...
Dialogue: 0,0:06:29.32,0:06:32.52,Default,,0,0,0,,Өлшем қақпасы іске қосылды! не?
Dialogue: 0,0:06:36.43,0:06:39.23,Default,,0,0,0,,Митра Гунис Транслокация аумағына кіреді
Dialogue: 0,0:06:39.23,0:06:41.83,Default,,0,0,0,,Қақпаны кім ашты
Dialogue: 0,0:06:41.83,0:06:45.63,Default,,0,0,0,,Сіз шынымен ояндыңыз ба?
Dialogue: 0,0:06:58.88,0:07:01.08,Default,,0,0,0,,О...
Dialogue: 0,0:07:11.46,0:07:13.53,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:07:13.53,0:07:16.67,Default,,0,0,0,,Бүгіннен бастап Қасиетті Періште академиясы бірлескен білім беретін болады.
Dialogue: 0,0:07:16.67,0:07:19.57,Default,,0,0,0,,Сіз қазір бір сыныптасыз.
Dialogue: 0,0:07:19.57,0:07:22.54,Default,,0,0,0,,Менің ойымша, сіз кенеттен болатын өзгерістерге шатасуыңыз мүмкін.
Dialogue: 0,0:07:22.54,0:07:25.04,Default,,0,0,0,,Барлығыңыз жақсы араласыңыз.
Dialogue: 0,0:07:28.58,0:07:31.78,Default,,0,0,0,,Ах, тірі Шрад.
Dialogue: 0,0:07:34.75,0:07:36.79,Default,,0,0,0,,Ауа ластанған
Dialogue: 0,0:07:36.79,0:07:40.29,Default,,0,0,0,,Бірінші біріккен сабақ қоғамдық пәндер бойынша экскурсия болды.
Dialogue: 0,0:07:40.29,0:07:43.26,Default,,0,0,0,,Аралас командада Нео Кулонды аралау
Dialogue: 0,0:07:43.26,0:07:45.26,Default,,0,0,0,,Жақсы естіледі ме?
Dialogue: 0,0:07:45.26,0:07:48.33,Default,,0,0,0,,Мұндай сабақтың пайдасы қандай?
Dialogue: 0,0:07:48.33,0:07:53.10,Default,,0,0,0,,Уау, ынталандыру кенет тым күшті.
Dialogue: 0,0:07:53.10,0:07:55.10,Default,,0,0,0,,Миконо мырза...
Dialogue: 0,0:07:59.41,0:08:02.64,Default,,0,0,0,,Уау! Амата-кун үй бөлмесінде.
Dialogue: 0,0:08:02.64,0:08:04.58,Default,,0,0,0,,Тыныш болыңыз!
Dialogue: 0,0:08:04.58,0:08:07.52,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:08:07.52,0:08:09.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:12.32,0:08:14.99,Default,,0,0,0,,Басып шығаруды айналдырыңыз
Dialogue: 0,0:08:14.99,0:08:19.23,Default,,0,0,0,,«Жаяу серуендеу және Кулон мұнарасында аспанда серуендеу»
Dialogue: 0,0:08:19.23,0:08:22.26,Default,,0,0,0,,"Портқа қарайтын қонақүйдегі Дим сом?"
Dialogue: 0,0:08:22.26,0:08:25.87,Default,,0,0,0,,Бұл... Нео Кулонның стандартты күн курсы
Dialogue: 0,0:08:25.87,0:08:28.17,Default,,0,0,0,,Мен мұны да айналдырамын.
Dialogue: 0,0:08:30.21,0:08:32.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:32.14,0:08:34.08,Default,,0,0,0,,Мм... мен үшін бе?
Dialogue: 0,0:08:34.08,0:08:37.95,Default,,0,0,0,,Төрағаның керегі жоқ па?
Dialogue: 0,0:08:37.95,0:08:40.65,Default,,0,0,0,,Топтастыруды жариялау
Dialogue: 0,0:08:40.65,0:08:43.59,Default,,0,0,0,,А тобы Cielo Enji Youka
Dialogue: 0,0:08:43.59,0:08:46.46,Default,,0,0,0,,В тобы Морои Айка Тұман
Dialogue: 0,0:08:46.46,0:08:48.46,Default,,0,0,0,,Сүйкімді бала Сүйкімді бала...
Dialogue: 0,0:08:48.46,0:08:51.66,Default,,0,0,0,,C тобы Энди MIX Юноха
Dialogue: 0,0:08:51.66,0:08:55.06,Default,,0,0,0,,Уноха? бұршақ пастасы?
Dialogue: 0,0:08:55.06,0:08:57.97,Default,,0,0,0,,Сүйкімді қызбен бірге болғаныңызға қуаныштымын.
Dialogue: 0,0:08:57.97,0:09:00.87,Default,,0,0,0,,Мен оны сүйкімді деп ойладым
Dialogue: 0,0:09:00.87,0:09:02.80,Default,,0,0,0,,Бұл тұлып емес пе?
Dialogue: 0,0:09:02.80,0:09:05.77,Default,,0,0,0,,Мысық па?
Dialogue: 0,0:09:05.77,0:09:09.77,Default,,0,0,0,,Мен мына шулы жігітпен бір командада болғаныма сене алар емеспін.
Dialogue: 0,0:09:11.91,0:09:14.82,Default,,0,0,0,,Ол күшті, бірақ сүйкімді көрінеді
Dialogue: 0,0:09:14.82,0:09:19.22,Default,,0,0,0,,Және үлкен жарылыс!
Dialogue: 0,0:09:21.22,0:09:24.13,Default,,0,0,0,,Арқаңа көтер мені
Dialogue: 0,0:09:24.13,0:09:28.13,Default,,0,0,0,,Келесі топ Schrade Cayenne Sasanqua
Dialogue: 0,0:09:28.13,0:09:30.87,Default,,0,0,0,,Құрметпен, қымбатты досым
Dialogue: 0,0:09:30.87,0:09:32.80,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:09:32.80,0:09:37.21,Default,,0,0,0,,Мен сенің қасымда екеніңді, тіпті жүрегімнің жоқтығына сендіремін.
Dialogue: 0,0:09:37.21,0:09:39.78,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:09:39.78,0:09:42.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:42.28,0:09:44.21,Default,,0,0,0,,Соңғы топ
Dialogue: 0,0:09:44.21,0:09:46.25,Default,,0,0,0,,Амата мен Миконо Джессика
Dialogue: 0,0:09:46.25,0:09:49.79,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:09:49.79,0:09:52.89,Default,,0,0,0,,Хмм...хехе
Dialogue: 0,0:09:55.32,0:09:59.09,Default,,0,0,0,,Бұдан былай әр топ әр түрлі әрекеттер жасайды.
Dialogue: 0,0:09:59.09,0:10:02.36,Default,,0,0,0,,Қайыққа ешқашан кешікпеңіз.
Dialogue: 0,0:10:02.36,0:10:04.86,Default,,0,0,0,,Жақсы, иә!
Dialogue: 0,0:10:24.72,0:10:27.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:27.32,0:10:30.53,Default,,0,0,0,,Гяа! Апыр-ай!
Dialogue: 0,0:10:30.53,0:10:33.56,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,0:10:33.56,0:10:36.33,Default,,0,0,0,,Әрбір элемент қобалжыды
Dialogue: 0,0:10:36.33,0:10:38.77,Default,,0,0,0,,Бұл жетілмеген.
Dialogue: 0,0:10:38.77,0:10:40.70,Default,,0,0,0,,Бұл білезік ше?
Dialogue: 0,0:10:40.70,0:10:45.34,Default,,0,0,0,,Элементтердің дене температурасын, жүрек соғу жиілігін, тер жиілігін және т.б.
Dialogue: 0,0:10:45.34,0:10:48.61,Default,,0,0,0,,Ток берілген мәннен асқанда осылай өтеді.
Dialogue: 0,0:10:48.61,0:10:52.18,Default,,0,0,0,,Менің ойымша, мұндай ақымақ арнайы дайындықтың дәмі нашар.
Dialogue: 0,0:10:52.18,0:10:55.08,Default,,0,0,0,,Оның мағынасы бар ма? Бар
Dialogue: 0,0:10:55.08,0:10:59.62,Default,,0,0,0,,Бұл жаттығу элементтердің мүмкіндіктерін барынша арттырады.
Dialogue: 0,0:10:59.62,0:11:02.42,Default,,0,0,0,,Және Акварион трагедиясын болдырмау үшін
Dialogue: 0,0:11:02.42,0:11:04.36,Default,,0,0,0,,Маңызды заттар
Dialogue: 0,0:11:04.36,0:11:07.26,Default,,0,0,0,,Акварион трагедиясы...
Dialogue: 0,0:11:07.26,0:11:12.10,Default,,0,0,0,,Тоғыз жыл бұрын, Акварион бірінші шабуыл кезінде сұрыпталды.
Dialogue: 0,0:11:12.10,0:11:14.87,Default,,0,0,0,,Ұрыс ортасында қашып кеткен
Dialogue: 0,0:11:14.87,0:11:17.51,Default,,0,0,0,,Екі элемент жоқ
Dialogue: 0,0:11:17.51,0:11:20.44,Default,,0,0,0,,Жалғыз аман қалған Донал Дантес болды.
Dialogue: 0,0:11:20.44,0:11:24.04,Default,,0,0,0,,Екі қолынан және жақын адамынан айырылды
Dialogue: 0,0:11:27.18,0:11:29.38,Default,,0,0,0,,Ол қыжылдайды
Dialogue: 0,0:12:11.26,0:12:14.66,Default,,0,0,0,,Махаббат әуені жүрексіз
Dialogue: 0,0:12:20.07,0:12:22.47,Default,,0,0,0,,Нанаон!
Dialogue: 0,0:12:22.47,0:12:24.47,Default,,0,0,0,,Донал…
Dialogue: 0,0:12:35.05,0:12:39.52,Default,,0,0,0,,Акварион элементтердің көп өлшемді эмоцияларымен үндеседі.
Dialogue: 0,0:12:39.52,0:12:42.32,Default,,0,0,0,,Оның күшін арттырып, күрес
Dialogue: 0,0:12:42.32,0:12:46.53,Default,,0,0,0,,Сіздің эмоцияларыңыздың қарқындылығы олардың күшіне тікелей байланысты.
Dialogue: 0,0:12:46.53,0:12:50.40,Default,,0,0,0,,Адамның ең құмарлық сезімі қандай?
Dialogue: 0,0:12:50.40,0:12:53.67,Default,,0,0,0,,Сіз бірдеңе білесіз бе? сағыныш Суоми
Dialogue: 0,0:12:53.67,0:12:56.14,Default,,0,0,0,,Өкпе немесе қызғаныш? Жоқ
Dialogue: 0,0:12:56.14,0:12:59.01,Default,,0,0,0,,Не? Бұл махаббат
Dialogue: 0,0:12:59.01,0:13:00.94,Default,,0,0,0,,Махаббат... Дегенмен
Dialogue: 0,0:13:00.94,0:13:04.81,Default,,0,0,0,,Ол махаббат сатысында қалуы керек.
Dialogue: 0,0:13:04.81,0:13:08.65,Default,,0,0,0,,Кездейсоқ ол нағыз махаббатқа айналса
Dialogue: 0,0:13:08.65,0:13:11.29,Default,,0,0,0,,Акварион бақылаудан шығып кетеді
Dialogue: 0,0:13:11.29,0:13:16.66,Default,,0,0,0,,Донал мен оның жақындарының басынан өткен трагедия сияқты.
Dialogue: 0,0:13:16.66,0:13:19.66,Default,,0,0,0,,Бірақ тыйым салудан бір қадам бұрын
Dialogue: 0,0:13:19.66,0:13:23.53,Default,,0,0,0,,Шектеумен күресу арқылы махаббатқа жету
Dialogue: 0,0:13:23.53,0:13:26.93,Default,,0,0,0,,Акварион орасан зор күш көрсетеді
Dialogue: 0,0:13:29.74,0:13:32.64,Default,,0,0,0,,Сора Амата мен Миконо Сузусиро арасындағы қатынас мәні
Dialogue: 0,0:13:32.64,0:13:35.44,Default,,0,0,0,,Олар ғашық болу алдында тұрды.
Dialogue: 0,0:13:35.44,0:13:39.01,Default,,0,0,0,,Сондықтан тыйым салынған туу белгісі іске қосылды
Dialogue: 0,0:13:39.01,0:13:43.85,Default,,0,0,0,,Бұл білезік киген адамның романтикалық сезімін анықтайды.
Dialogue: 0,0:13:43.85,0:13:48.16,Default,,0,0,0,,Сіз қалаған нәрсе - бақылаудан шығу алдында тұрған билік.
Dialogue: 0,0:13:48.16,0:13:50.83,Default,,0,0,0,,Бұл махаббатты тоқтатуға арналған арнайы жаттығу.
Dialogue: 0,0:13:50.83,0:13:54.40,Default,,0,0,0,,Иә, сүйкімді оқушылар.
Dialogue: 0,0:13:54.40,0:13:57.30,Default,,0,0,0,,Мен сені мен сияқты бастан өткере алмаймын.
Dialogue: 0,0:13:57.30,0:14:00.64,Default,,0,0,0,,Әсіресе Амата, ұқсайды.
Dialogue: 0,0:14:00.64,0:14:02.90,Default,,0,0,0,,Жас кезімде маған
Dialogue: 0,0:14:02.90,0:14:05.00,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:14:11.61,0:14:15.38,Default,,0,0,0,,Бұл сүйкімді. Қараңызшы, бұл мысық. Шушу
Dialogue: 0,0:14:15.38,0:14:19.58,Default,,0,0,0,,Миконо-сан әлдеқайда сүйкімді...
Dialogue: 0,0:14:24.66,0:14:27.90,Default,,0,0,0,,Бұл! Амата-кун
Dialogue: 0,0:14:27.90,0:14:31.13,Default,,0,0,0,,Не болды? Менің кеудем... ауырады...
Dialogue: 0,0:14:31.13,0:14:35.00,Default,,0,0,0,,Хмф, романтикаға тыйым салынған, Амата.
Dialogue: 0,0:14:35.00,0:14:38.40,Default,,0,0,0,,Ол мүлде абайсыз бейбақ.
Dialogue: 0,0:14:55.09,0:14:57.09,Default,,0,0,0,,Иіс
Dialogue: 0,0:15:01.40,0:15:04.70,Default,,0,0,0,,Люкс қонақ үй бассейнінде әлеуметтік зерттеулер бойынша экскурсия
Dialogue: 0,0:15:04.70,0:15:07.24,Default,,0,0,0,,Оның үстіне олар сізге купальник де береді.
Dialogue: 0,0:15:07.24,0:15:09.54,Default,,0,0,0,,Менің айта алатыным осы ғана
Dialogue: 0,0:15:11.57,0:15:14.94,Default,,0,0,0,,Сонымен, бұл тұлып дегеніміз не?
Dialogue: 0,0:15:14.94,0:15:16.94,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:15:21.68,0:15:24.89,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:24.89,0:15:26.82,Default,,0,0,0,,Ал өл...
Dialogue: 0,0:15:26.82,0:15:29.49,Default,,0,0,0,,Э? Не? Мен тыңдамаппын.
Dialogue: 0,0:15:29.49,0:15:31.43,Default,,0,0,0,,Бұл арнайы тренинг
Dialogue: 0,0:15:31.43,0:15:34.73,Default,,0,0,0,,Бұл сонымен қатар элементтердің комбинациясын модельдеу.
Dialogue: 0,0:15:34.73,0:15:37.23,Default,,0,0,0,,Төрағаның айтқаны рас болса.
Dialogue: 0,0:15:37.23,0:15:39.17,Default,,0,0,0,,Ұлдарға ұнамайтын қоспалар
Dialogue: 0,0:15:39.17,0:15:41.70,Default,,0,0,0,,Болашақта маңызды күшке айналуы мүмкін
Dialogue: 0,0:15:41.70,0:15:45.57,Default,,0,0,0,,Жоқ, егер сіз ол сияқты қарама-қарсы жынысқа жабық болсаңыз,
Dialogue: 0,0:15:45.57,0:15:49.18,Default,,0,0,0,,Махаббаттың шегіне жету қиын болады.
Dialogue: 0,0:15:49.18,0:15:53.05,Default,,0,0,0,,Сонымен, Шрейд пен Кайен Сасанкуа командасы туралы не деуге болады?
Dialogue: 0,0:15:53.05,0:15:58.85,Default,,0,0,0,,Мәзірде тіпті қай жерде тамақтану керектігі көрсетілсе, бұл жағымсыз.
Dialogue: 0,0:15:58.85,0:16:02.79,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, бұл қарбыз шырыны.
Dialogue: 0,0:16:02.79,0:16:05.39,Default,,0,0,0,,Мм... бір ғана бар ма?
Dialogue: 0,0:16:05.39,0:16:08.13,Default,,0,0,0,,Маған осылай жасау тапсырылды.
Dialogue: 0,0:16:08.13,0:16:10.57,Default,,0,0,0,,Жүр, ішіп алайық, а?
Dialogue: 0,0:16:10.57,0:16:15.20,Default,,0,0,0,,Бұл да тренингтің бір бөлігі, солай ма?
Dialogue: 0,0:16:15.20,0:16:17.67,Default,,0,0,0,,Қызбен ұялшақ көрінеді.
Dialogue: 0,0:16:17.67,0:16:20.67,Default,,0,0,0,,Кешіріңіз, ха...
Dialogue: 0,0:16:28.32,0:16:31.15,Default,,0,0,0,,Ах... Лорд Шрейд пен лорд Кайенн бірге.
Dialogue: 0,0:16:31.15,0:16:35.66,Default,,0,0,0,,Бір шырынды сорып алыңыз
Dialogue: 0,0:16:35.66,0:16:39.33,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:16:39.33,0:16:42.90,Default,,0,0,0,,Шрейд мүлде ренжімейтін сияқты.
Dialogue: 0,0:16:42.90,0:16:47.67,Default,,0,0,0,,Күткендей, Сазанка басқа бағытта қобалжыған сияқты.
Dialogue: 0,0:16:47.67,0:16:50.71,Default,,0,0,0,,Төраға Шраденің нақты шайқасы...
Dialogue: 0,0:16:50.71,0:16:53.88,Default,,0,0,0,,Мен оның денесі туралы білемін.
Dialogue: 0,0:16:53.88,0:16:57.71,Default,,0,0,0,,Шрейд Илан өмірінің шетінде.
Dialogue: 0,0:16:57.71,0:16:59.68,Default,,0,0,0,,Соңғы минуттық эмоцияны құру
Dialogue: 0,0:16:59.68,0:17:02.18,Default,,0,0,0,,Сіз мұны тамаша деп айта аласыз.
Dialogue: 0,0:17:02.18,0:17:04.52,Default,,0,0,0,,Қорқынышты… және
Dialogue: 0,0:17:04.52,0:17:07.09,Default,,0,0,0,,Ең көрнекті комбинация
Dialogue: 0,0:17:07.09,0:17:09.69,Default,,0,0,0,,Амата Джессика Миконо
Dialogue: 0,0:17:09.69,0:17:11.63,Default,,0,0,0,,Бірақ Миконодан
Dialogue: 0,0:17:11.63,0:17:14.40,Default,,0,0,0,,Ешбір элементтік қабілет анықталмады
Dialogue: 0,0:17:14.40,0:17:16.90,Default,,0,0,0,,Сақинамен қоршалған болуы керек
Dialogue: 0,0:17:16.90,0:17:20.27,Default,,0,0,0,,Донуттар бос нәрсе емес
Dialogue: 0,0:17:20.27,0:17:22.27,Default,,0,0,0,,Миконо Сузусиро
Dialogue: 0,0:17:22.27,0:17:26.07,Default,,0,0,0,,Бұл бос орынды пончикке айналдыратын сақина.
Dialogue: 0,0:17:26.07,0:17:31.98,Default,,0,0,0,,Бірақ тәттілер үшін...
Dialogue: 0,0:17:31.98,0:17:35.52,Default,,0,0,0,,Бұл! Сенімен бәрі жақсы ма?
Dialogue: 0,0:17:35.52,0:17:38.29,Default,,0,0,0,,Әй, сен осылай қалқып тұрдың.
Dialogue: 0,0:17:38.29,0:17:41.06,Default,,0,0,0,,Қанша үрлейтін мылтық болса да, ол ешқашан жетпейді.
Dialogue: 0,0:17:41.06,0:17:45.46,Default,,0,0,0,,Амата-кун, сен мені көргенде жүрегің дүрсілдеп,...
Dialogue: 0,0:17:45.46,0:17:48.00,Default,,0,0,0,,Хехе, Амата-кун.
Dialogue: 0,0:17:48.00,0:17:50.87,Default,,0,0,0,,Сен бақытты көрінесің, Миконо.
Dialogue: 0,0:17:50.87,0:17:53.47,Default,,0,0,0,,Бұл жақсы. Сізге ұнау мүмкіндігі бар ма?
Dialogue: 0,0:17:53.47,0:17:56.34,Default,,0,0,0,,Бұл олай емес пе?
Dialogue: 0,0:17:56.34,0:18:01.54,Default,,0,0,0,,Маған бұл аңғал түрі ұнайды.
Dialogue: 0,0:18:01.54,0:18:03.48,Default,,0,0,0,,Енді не болады...
Dialogue: 0,0:18:03.48,0:18:07.98,Default,,0,0,0,,Әуесқой, бірге барайық, жарай ма?
Dialogue: 0,0:18:11.05,0:18:15.39,Default,,0,0,0,,А, мен де қалқып жүрдім, Амата-күн.
Dialogue: 0,0:18:15.39,0:18:17.33,Default,,0,0,0,,Кез келген адам жүзе ала ма?
Dialogue: 0,0:18:17.33,0:18:20.36,Default,,0,0,0,,Не? Бұл барлығына ғана қатысты емес.
Dialogue: 0,0:18:20.36,0:18:22.76,Default,,0,0,0,,Өйткені басқа адам менмін
Dialogue: 0,0:18:22.76,0:18:25.63,Default,,0,0,0,,Ой!
Dialogue: 0,0:18:25.63,0:18:27.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:27.57,0:18:29.57,Default,,0,0,0,,Шушу не болды?
Dialogue: 0,0:18:34.68,0:18:37.01,Default,,0,0,0,,Уау! Ол қандай?
Dialogue: 0,0:18:37.01,0:18:41.31,Default,,0,0,0,,Бірақ... сәл жақсы емес пе?
Dialogue: 0,0:18:46.65,0:18:49.55,Default,,0,0,0,,Иісі жақсы ма? иә?
Dialogue: 0,0:18:54.96,0:18:59.06,Default,,0,0,0,,Амансың ба? Сіз осында біраз демаласыз деп үміттенемін.
Dialogue: 0,0:19:01.74,0:19:04.64,Default,,0,0,0,,Соңғы шайқасқа ашуландың ба?
Dialogue: 0,0:19:04.64,0:19:09.14,Default,,0,0,0,,Хмф, адамдардың санасын басқаратын адамға ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:19:09.14,0:19:11.08,Default,,0,0,0,,Неге жасырып жатырсың?
Dialogue: 0,0:19:11.08,0:19:14.55,Default,,0,0,0,,Тіпті менің өмірім де манипуляциялануда.
Dialogue: 0,0:19:14.55,0:19:18.35,Default,,0,0,0,,Ауру деп аталатын ұрлаушыға.
Dialogue: 0,0:19:30.03,0:19:33.07,Default,,0,0,0,,Ааа! иә?
Dialogue: 0,0:19:33.07,0:19:35.84,Default,,0,0,0,,Не? Ауада серуендеген 3 фотосурет
Dialogue: 0,0:19:35.84,0:19:37.77,Default,,0,0,0,,Не, мен де істеймін бе?
Dialogue: 0,0:19:37.77,0:19:42.01,Default,,0,0,0,,Бұл жай ғана жаттығу, сондықтан қорқатын болсаңыз, өзіңізді итермеңіз.
Dialogue: 0,0:19:42.01,0:19:44.55,Default,,0,0,0,,Амата, бірге көңіл көтерейік
Dialogue: 0,0:19:44.55,0:19:47.05,Default,,0,0,0,,Маған жабыспа О!
Dialogue: 0,0:19:47.05,0:19:48.98,Default,,0,0,0,,Хахаха қызық
Dialogue: 0,0:19:48.98,0:19:52.49,Default,,0,0,0,,Дұрыс, мен ыңғайсызданып тұрған сияқтымын, өтінемін, бірге барайық.
Dialogue: 0,0:19:52.49,0:19:55.19,Default,,0,0,0,,Миконо-сан, күте тұр.
Dialogue: 0,0:19:57.33,0:19:59.66,Default,,0,0,0,,Миконо-сан, күте тұр! мен...
Dialogue: 0,0:19:59.66,0:20:02.56,Default,,0,0,0,,Амата-кунның жынысы! сурет?
Dialogue: 0,0:20:02.56,0:20:05.43,Default,,0,0,0,,Джессика-сан маған қарай келе жатыр.
Dialogue: 0,0:20:05.43,0:20:08.94,Default,,0,0,0,,Мен бұл тек менікі деп ойладым...
Dialogue: 0,0:20:08.94,0:20:11.81,Default,,0,0,0,,Енді ше? Жетеді
Dialogue: 0,0:20:11.81,0:20:14.18,Default,,0,0,0,,Миконо-сан!
Dialogue: 0,0:20:14.18,0:20:16.18,Default,,0,0,0,,Ха...
Dialogue: 0,0:20:22.48,0:20:24.48,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:20:26.35,0:20:29.22,Default,,0,0,0,,Өртеніп жатқан сияқты Иә.
Dialogue: 0,0:20:29.22,0:20:33.42,Default,,0,0,0,,«Аквариа билейтін аспан» сияқты
Dialogue: 0,0:20:43.81,0:20:45.81,Default,,0,0,0,,Бұл ән...
Dialogue: 0,0:20:59.89,0:21:02.79,Default,,0,0,0,,Сағыныш сезімі бар, иә?
Dialogue: 0,0:21:02.79,0:21:07.63,Default,,0,0,0,,Мен Амата-кунмен жақында ғана кездестім.
Dialogue: 0,0:21:07.63,0:21:11.30,Default,,0,0,0,,Қаншама уақыт өтіп кеткендей.
Dialogue: 0,0:21:11.30,0:21:13.97,Default,,0,0,0,,Менің жинақтағы ақшамнан тек 285 йен ғана қалды!
Dialogue: 0,0:21:13.97,0:21:16.30,Default,,0,0,0,,Менің ойымша, бұл біртүрлі емес
Dialogue: 0,0:21:16.30,0:21:18.97,Default,,0,0,0,,Мен Миконо-санмен кездестім
Dialogue: 0,0:21:18.97,0:21:23.58,Default,,0,0,0,,Өйткені бұл тағдыр сияқты сезілді
Dialogue: 0,0:21:23.58,0:21:26.15,Default,,0,0,0,,Сондықтан сен мені жек көресің…
Dialogue: 0,0:21:26.15,0:21:28.62,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Кешіріңіз.
Dialogue: 0,0:21:28.62,0:21:31.25,Default,,0,0,0,,Онсыз қазір онсыз өтінемін
Dialogue: 0,0:21:31.25,0:21:34.79,Default,,0,0,0,,Жоқ...?
Dialogue: 0,0:21:34.79,0:21:38.69,Default,,0,0,0,,Мен онсыз болғым келмейді! Миконо-сан
Dialogue: 0,0:21:45.80,0:21:49.24,Default,,0,0,0,,Нашар! Микононың махаббат көрсеткіші тез өсіп келеді.
Dialogue: 0,0:21:49.24,0:21:51.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:00.92,0:22:03.48,Default,,0,0,0,,Жоқ, ары кетсе, махаббат болады!
Dialogue: 0,0:22:03.48,0:22:05.92,Default,,0,0,0,,Донал мырза, оларды тоқтатыңыз!
Dialogue: 0,0:22:05.92,0:22:09.79,Default,,0,0,0,,Цк, мылтық маған жетпейді.
Dialogue: 0,0:22:09.79,0:22:11.79,Default,,0,0,0,,Амата-кун
Dialogue: 0,0:22:22.94,0:22:26.81,Default,,0,0,0,,Жоқ! Амата-кун, Миконо-сан, сен бара алмайсың.
Dialogue: 0,0:22:26.81,0:22:30.08,Default,,0,0,0,,Тыйым салынған махаббаттың дәмі балдай
Dialogue: 0,0:22:30.08,0:22:34.88,Default,,0,0,0,,Бірақ тәтті бал құмырсқаларды өзіне тартады.
Dialogue: 0,0:22:39.49,0:22:42.09,Default,,0,0,0,,Мен таптым.
Dialogue: 0,0:22:49.90,0:22:52.30,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:22:54.80,0:22:58.94,Default,,0,0,0,,Иісі және тәтті
Dialogue: 0,0:22:58.94,0:23:03.78,Default,,0,0,0,,Ах! Миконо-сан
Dialogue: 0,0:23:03.78,0:23:07.18,Default,,0,0,0,,Бұл реакция... махаббат емес.
Dialogue: 0,0:23:07.18,0:23:09.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:23:09.85,0:23:12.15,Default,,0,0,0,,Бұл тыйым салынған кездесу.
Dialogue: 0,0:23:18.03,0:23:20.80,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:23:20.80,0:23:23.20,Default,,0,0,0,,Миконо-сан!
Dialogue: 0,0:24:56.96,0:24:59.89,Default,,0,0,0,,7 күннен кейін болашақ туралы сөйлесеміз бе?
Dialogue: 0,0:24:59.89,0:25:02.10,Default,,0,0,0,,Мен бұл Шерзандо шайқасына сенімдімін
Dialogue: 0,0:25:02.10,0:25:04.03,Default,,0,0,0,,Қараңғыда дульсеньо болады
Dialogue: 0,0:25:04.03,0:25:06.30,Default,,0,0,0,,Иә, менің ең жақын досым.
Dialogue: 0,0:25:06.30,0:25:10.50,Default,,0,0,0,,Next Aquarion EVOL «Өмірдің толқуы»
Dialogue: 0,0:27:29.88,0:27:31.81,Default,,0,0,0,,Қазір өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:27:31.81,0:27:34.58,Default,,0,0,0,,А... иә, рахмет.
Dialogue: 0,0:27:34.58,0:27:37.68,Default,,0,0,0,,Миконо!
Dialogue: 0,0:27:40.72,0:27:43.32,Default,,0,0,0,,Миконо мұнарасындағы Миконо!
Dialogue: 0,0:27:45.33,0:27:47.56,Default,,0,0,0,,Әрбір элементті айтыңыз
Dialogue: 0,0:27:47.56,0:27:50.93,Default,,0,0,0,,Нео-Кулон аймағына жақын абдекторлық реакция
Dialogue: 0,0:27:50.93,0:27:53.30,Default,,0,0,0,,Сондықтан жаттығу жойылды.
Dialogue: 0,0:27:53.30,0:27:56.27,Default,,0,0,0,,Үш адам Кайен, Джессика және Энди.
Dialogue: 0,0:27:56.27,0:27:59.87,Default,,0,0,0,,Тез арада мектепке оралу.
Dialogue: 0,0:27:59.87,0:28:05.61,Default,,0,0,0,,Ең жақын досым, мұны маған қалдыр, сонда сен мектепке қайта бара аласың.
Dialogue: 0,0:28:05.61,0:28:09.52,Default,,0,0,0,,Сазанка, сен де, бірақ Миконоға қауіп төніп тұр!
Dialogue: 0,0:28:09.52,0:28:14.22,Default,,0,0,0,,Сіз элемент болсаңыз да, миссияңыздың орнына әпкеңізді таңдар ма едіңіз?
Dialogue: 0,0:28:18.16,0:28:20.26,Default,,0,0,0,,А... сәл күте тұрыңыз!
Dialogue: 0,0:28:23.00,0:28:26.73,Default,,0,0,0,,Жақсы балалар
Dialogue: 0,0:28:26.73,0:28:31.41,Default,,0,0,0,,Басқалардан жоғары, басқалардан әдемі үйлесім
Dialogue: 0,0:28:31.41,0:28:35.51,Default,,0,0,0,,Мен болсам, оны жүзеге асыра алар едім.
Dialogue: 0,0:30:23.75,0:30:26.05,Default,,0,0,0,,Таптым! Ахх
Dialogue: 0,0:30:32.16,0:30:34.16,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:30:36.53,0:30:38.63,Default,,0,0,0,,Иісі және тәтті
Dialogue: 0,0:30:40.50,0:30:44.21,Default,,0,0,0,,Ах! Миконо-сан
Dialogue: 0,0:30:44.21,0:30:49.98,Default,,0,0,0,,Бұл қандай реакция? Бұл махаббат емес...
Dialogue: 0,0:30:49.98,0:30:52.28,Default,,0,0,0,,Бұл тыйым салынған кездесу
Dialogue: 0,0:31:00.75,0:31:02.85,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:31:07.83,0:31:11.53,Default,,0,0,0,,Иә, бұл өте нәзік.
Dialogue: 0,0:31:11.53,0:31:13.83,Default,,0,0,0,,Миконо-санды босат!
Dialogue: 0,0:31:18.27,0:31:21.54,Default,,0,0,0,,Уа... қандай иіс?
Dialogue: 0,0:31:21.54,0:31:23.88,Default,,0,0,0,,Мен мұны сенен істемеймін.
Dialogue: 0,0:31:23.88,0:31:29.68,Default,,0,0,0,,Ештеңені иіскемейтін біртүрлі адам.
Dialogue: 0,0:31:29.68,0:31:32.59,Default,,0,0,0,,Эй, сен
Dialogue: 0,0:31:32.59,0:31:35.49,Default,,0,0,0,,Мен сені өлтіре аламын ба?
Dialogue: 0,0:31:37.89,0:31:43.70,Default,,0,0,0,,Мен өлтіргім келмейді, бірақ хмм, түсіндім.
Dialogue: 0,0:31:43.70,0:31:46.60,Default,,0,0,0,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,0:31:46.60,0:31:49.40,Default,,0,0,0,,Бізге кедергі жасамаңыз
Dialogue: 0,0:31:49.40,0:31:52.80,Default,,0,0,0,,Бұл менің қаншық.
Dialogue: 0,0:32:03.55,0:32:05.49,Default,,0,0,0,,Жоқ
Dialogue: 0,0:32:05.49,0:32:07.99,Default,,0,0,0,,Миконо-сан, сен...
Dialogue: 0,0:32:10.09,0:32:13.99,Default,,0,0,0,,Мен оны саған бермеймін Уау!
Dialogue: 0,0:32:16.86,0:32:18.96,Default,,0,0,0,,Енді ешкімді жаралағым келмейді.
Dialogue: 0,0:32:42.79,0:32:44.79,Default,,0,0,0,,Қанаттар...
Dialogue: 0,0:32:50.83,0:32:53.03,Default,,0,0,0,,Бұл ненің дыбысы?
Dialogue: 0,0:33:08.35,0:33:11.15,Default,,0,0,0,,Кагура Вегаға қайтады
Dialogue: 0,0:33:11.15,0:33:14.72,Default,,0,0,0,,Қақпаны кім басқарды?
Dialogue: 0,0:33:14.72,0:33:18.02,Default,,0,0,0,,Кагураның Гунисті қатаң түрде ұстады...
Dialogue: 0,0:33:20.29,0:33:22.59,Default,,0,0,0,,Көптен бері Изумоны көрмедім
Dialogue: 0,0:33:24.83,0:33:26.93,Default,,0,0,0,,Джин де есейіп кетті.
Dialogue: 0,0:33:28.77,0:33:33.04,Default,,0,0,0,,Микадж, бұл сіздің ақшаңыз ғой.
Dialogue: 0,0:33:33.04,0:33:36.81,Default,,0,0,0,,Сіз қашан ояндыңыз? қашан?
Dialogue: 0,0:33:36.81,0:33:39.71,Default,,0,0,0,,Мені ояту үшін сүйді.
Dialogue: 0,0:33:39.71,0:33:43.22,Default,,0,0,0,,Механикалық періштенің тыйым салынған техникасына.
Dialogue: 0,0:33:43.22,0:33:45.79,Default,,0,0,0,,Неге күшіңді Кагураға бердің?
Dialogue: 0,0:33:45.79,0:33:48.66,Default,,0,0,0,,Мен сені жаңа ғана шығарып салдым.
Dialogue: 0,0:33:48.66,0:33:54.46,Default,,0,0,0,,Махаббаттың жаңа әлеміне қарай жүгірген таңдалғанның арқасында.
Dialogue: 0,0:33:54.46,0:33:57.46,Default,,0,0,0,,Жаңа махаббат әлемі?
Dialogue: 0,0:33:57.46,0:34:01.17,Default,,0,0,0,,Тыйым салынған әдісті шығарған механикалық періште.
Dialogue: 0,0:34:01.17,0:34:03.50,Default,,0,0,0,,Құрсағындағы Риа Игларга
Dialogue: 0,0:34:03.50,0:34:06.41,Default,,0,0,0,,Кагура басшылыққа алынды.
Dialogue: 0,0:34:06.41,0:34:09.81,Default,,0,0,0,,Ол Риа Игларды соншалықты қатты қуады.
Dialogue: 0,0:34:09.81,0:34:12.11,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:34:14.65,0:34:19.12,Default,,0,0,0,,Егер сіз механикалық періштелерді басқара алатын сирек кездесетін Иглар болсаңыз.
Dialogue: 0,0:34:19.12,0:34:21.19,Default,,0,0,0,,Немесе...
Dialogue: 0,0:34:21.19,0:34:25.69,Default,,0,0,0,,Мүмкін мен Альтеяның нағыз Хауа ана бола алармын.
Dialogue: 0,0:34:31.10,0:34:33.77,Default,,0,0,0,,Vega-ны бақылауды жалғастырыңыз.
Dialogue: 0,0:34:33.77,0:34:38.41,Default,,0,0,0,,Егер бұзушылықтар орын алса, Митра Гунисті күштеп жинаңыз
Dialogue: 0,0:34:38.41,0:34:40.41,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:35:12.14,0:35:14.24,Default,,0,0,0,,Алисия…
Dialogue: 0,0:35:30.29,0:35:33.73,Default,,0,0,0,,Сен... мені өлтір... жарайды ма?
Dialogue: 0,0:35:33.73,0:35:35.96,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:35:35.96,0:35:38.76,Default,,0,0,0,,Егер сіз мені ойнай алсаңыз
Dialogue: 0,0:35:48.98,0:35:52.41,Default,,0,0,0,,Сіз әлсіз иіссіз.
Dialogue: 0,0:35:52.41,0:35:55.11,Default,,0,0,0,,Әлгі әйелдің иісі
Dialogue: 0,0:36:01.92,0:36:03.92,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,0:36:13.47,0:36:16.77,Default,,0,0,0,,Хм... Керемет естіледі.
Dialogue: 0,0:36:18.84,0:36:22.14,Default,,0,0,0,,Сонымен Шрейд Нео Кулон аймағында қалды ма?
Dialogue: 0,0:36:22.14,0:36:26.31,Default,,0,0,0,,Түсінікті, үш адам Кайен, Джессика және Энди.
Dialogue: 0,0:36:26.31,0:36:28.71,Default,,0,0,0,,Мен оралған бойда орналастыруға келісемін.
Dialogue: 0,0:36:30.72,0:36:34.49,Default,,0,0,0,,Мм, мен бұл туралы көптен бері ойланып жүрмін.
Dialogue: 0,0:36:34.49,0:36:38.09,Default,,0,0,0,,Шрейд мырза, ол неге нақты ұрысқа қатыспайды?
Dialogue: 0,0:36:41.86,0:36:46.10,Default,,0,0,0,,Білесіз бе... өтірік шайқаста да сіз әрқашан ең жақсы әрекет етесіз.
Dialogue: 0,0:36:46.10,0:36:49.07,Default,,0,0,0,,Қызық, неге қыздар арасында...
Dialogue: 0,0:36:49.07,0:36:51.74,Default,,0,0,0,,Ерлер мен әйелдер арасында енді шекара жоқ.
Dialogue: 0,0:36:51.74,0:36:54.64,Default,,0,0,0,,Ақырында біріктірілуі мүмкін элементтер профилі
Dialogue: 0,0:36:54.64,0:36:56.64,Default,,0,0,0,,Мен түсінгім келеді
Dialogue: 0,0:37:04.65,0:37:09.75,Default,,0,0,0,,Шрейд Илан жастайынан музыкалық талантқа ие болған.
Dialogue: 0,0:37:11.76,0:37:15.53,Default,,0,0,0,,Бірақ оның фортепианосының үні солай
Dialogue: 0,0:37:15.53,0:37:18.63,Default,,0,0,0,,Құрамында күшті теріс элементтер бар
Dialogue: 0,0:37:21.03,0:37:23.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:32.25,0:37:35.15,Default,,0,0,0,,Адамдардың терең психологиясымен тікелей байланыс
Dialogue: 0,0:37:35.15,0:37:37.85,Default,,0,0,0,,Шрейдтің ауырсыну тонусы
Dialogue: 0,0:37:37.85,0:37:43.05,Default,,0,0,0,,Сыбыс тарады, көп ұзамай ол қараңғылықтың құралына айналды.
Dialogue: 0,0:38:13.05,0:38:15.05,Default,,0,0,0,,Бұл дыбыс...
Dialogue: 0,0:38:32.41,0:38:34.81,Default,,0,0,0,,Neo Diva...
Dialogue: 0,0:38:37.88,0:38:41.75,Default,,0,0,0,,Шрейдтің баласы, оны төраға барлап көрді ме?
Dialogue: 0,0:38:41.75,0:38:44.69,Default,,0,0,0,,Дәлірек айтсақ, төраға неше жаста?
Dialogue: 0,0:38:44.69,0:38:47.55,Default,,0,0,0,,Бірақ қарапайым бейімділік сынағында
Dialogue: 0,0:38:47.55,0:38:51.93,Default,,0,0,0,,Шрейде күрделі мәселе бар екен.
Dialogue: 0,0:38:51.93,0:38:55.36,Default,,0,0,0,,Не? Акварионға міну арқылы
Dialogue: 0,0:38:55.36,0:38:59.20,Default,,0,0,0,,Шрейдтің өмірі қиылады
Dialogue: 0,0:38:59.20,0:39:03.07,Default,,0,0,0,,Акварион элементтердің жасырын күшін күшейтеді
Dialogue: 0,0:39:03.07,0:39:06.44,Default,,0,0,0,,Ал элементтер оны кері серпеді
Dialogue: 0,0:39:06.44,0:39:09.24,Default,,0,0,0,,Бір-бірінің күшін арттыру
Dialogue: 0,0:39:09.24,0:39:12.85,Default,,0,0,0,,Шрейдтің қарапайым қабілеттері тым күшті.
Dialogue: 0,0:39:12.85,0:39:15.12,Default,,0,0,0,,Акварионмен күш раллиі
Dialogue: 0,0:39:15.12,0:39:17.82,Default,,0,0,0,,Оның ауру денесі шыдамайды.
Dialogue: 0,0:39:20.79,0:39:22.72,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:39:22.72,0:39:25.52,Default,,0,0,0,,Сәл бұрмаланған
Dialogue: 0,0:39:27.49,0:39:29.79,Default,,0,0,0,,Бірақ бұл жақсы естіледі.
Dialogue: 0,0:39:31.77,0:39:35.07,Default,,0,0,0,,Қуаныштан өлетін тон.
Dialogue: 0,0:39:49.18,0:39:51.75,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:39:51.75,0:39:55.32,Default,,0,0,0,,Бос... Істеңіз...
Dialogue: 0,0:39:55.32,0:39:59.29,Default,,0,0,0,,Мен... сол адамға...
Dialogue: 0,0:39:59.29,0:40:01.76,Default,,0,0,0,,Мен кешірім сұрауым керек...
Dialogue: 0,0:40:01.76,0:40:04.30,Default,,0,0,0,,Оған «Кешірім сұрау»?
Dialogue: 0,0:40:04.30,0:40:07.30,Default,,0,0,0,,Миконо-сан, сен нені айтып тұрсың?
Dialogue: 0,0:40:07.30,0:40:10.10,Default,,0,0,0,,Абдуктор дабылы
Dialogue: 0,0:40:12.84,0:40:14.84,Default,,0,0,0,,Векторлық машина
Dialogue: 0,0:40:21.28,0:40:25.52,Default,,0,0,0,,Сендердің қаншаларың біздің жолымызға кедергі жасап жатыр?
Dialogue: 0,0:40:25.52,0:40:27.82,Default,,0,0,0,,Менің сұм әйелім...
Dialogue: 0,0:40:29.82,0:40:32.02,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:40:56.72,0:40:58.95,Default,,0,0,0,,Ол туралы не деуге болады?
Dialogue: 0,0:40:58.95,0:41:02.22,Default,,0,0,0,,Ұрлаушы қашан аңға ұқсайды?
Dialogue: 0,0:41:02.22,0:41:04.72,Default,,0,0,0,,Митра Гунис.
Dialogue: 0,0:41:04.72,0:41:07.72,Default,,0,0,0,,Бұл машинаның аты, Бас қолбасшы?
Dialogue: 0,0:41:14.94,0:41:18.24,Default,,0,0,0,,Мына жігіттің іші одан да жаман иіс...
Dialogue: 0,0:41:27.11,0:41:29.21,Default,,0,0,0,,Кайен!
Dialogue: 0,0:41:31.55,0:41:33.55,Default,,0,0,0,,Жоқ
Dialogue: 0,0:41:38.83,0:41:41.73,Default,,0,0,0,,Сонда мынау?
Dialogue: 0,0:41:41.73,0:41:44.03,Default,,0,0,0,,Додж, Джессика
Dialogue: 0,0:41:55.58,0:41:57.54,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:41:57.54,0:41:59.74,Default,,0,0,0,,Ол Миконо-санды іздеп жатыр.
Dialogue: 0,0:42:03.05,0:42:07.89,Default,,0,0,0,,Миконо-сан, байқадың ба? Амата-кун?
Dialogue: 0,0:42:07.89,0:42:09.89,Default,,0,0,0,,Мен...
Dialogue: 0,0:42:11.86,0:42:16.56,Default,,0,0,0,,Миконо-сан, мен ол жігіттен кешірім сұраймын дедім.
Dialogue: 0,0:42:16.56,0:42:19.97,Default,,0,0,0,,Не? кешірім сұрау?
Dialogue: 0,0:42:19.97,0:42:25.44,Default,,0,0,0,,Білмеймін, әйтеуір ол кісінің қолына түскенде.
Dialogue: 0,0:42:25.44,0:42:29.84,Default,,0,0,0,,Бұл қорқынышты болды, бірақ...
Dialogue: 0,0:42:29.84,0:42:32.28,Default,,0,0,0,,Сол ыстық тыныс
Dialogue: 0,0:42:32.28,0:42:35.08,Default,,0,0,0,,Сағыныш сезімі бар...
Dialogue: 0,0:42:46.53,0:42:48.63,Default,,0,0,0,,Жоқ! Мен оны шайқау мүмкін емес
Dialogue: 0,0:43:05.85,0:43:08.08,Default,,0,0,0,,Отоиши?
Dialogue: 0,0:43:08.08,0:43:10.08,Default,,0,0,0,,Менің сұм әйелім!
Dialogue: 0,0:43:28.40,0:43:30.84,Default,,0,0,0,,Жақсысың ба, жақын досым?
Dialogue: 0,0:43:30.84,0:43:32.84,Default,,0,0,0,,Шрейд
Dialogue: 0,0:43:37.21,0:43:39.58,Default,,0,0,0,,Мен сенің орныңды аламын
Dialogue: 0,0:43:39.58,0:43:42.38,Default,,0,0,0,,Бірақ сіздің денеңіз...
Dialogue: 0,0:43:52.16,0:43:55.26,Default,,0,0,0,,Маған қарғыс атқыр әйелімді бер!
Dialogue: 0,0:43:57.36,0:43:59.30,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:43:59.30,0:44:01.90,Default,,0,0,0,,Ол... менде бәрі жақсы.
Dialogue: 0,0:44:01.90,0:44:04.90,Default,,0,0,0,,Амата-кун... Мен де.
Dialogue: 0,0:44:04.90,0:44:08.20,Default,,0,0,0,,Мен де оны білетін сияқтымын.
Dialogue: 0,0:44:10.91,0:44:15.11,Default,,0,0,0,,Мен сені оған бере алмаймын деп ойлаймын.
Dialogue: 0,0:44:22.52,0:44:25.12,Default,,0,0,0,,Кайенна? Жоқ, жоқ, мүмкін емес
Dialogue: 0,0:44:27.26,0:44:30.56,Default,,0,0,0,,Шрейд! Неліктен ол векторлық машинаға айналды?
Dialogue: 0,0:44:35.57,0:44:37.50,Default,,0,0,0,,Жоқ, сіз...
Dialogue: 0,0:44:37.50,0:44:40.24,Default,,0,0,0,,Жау – жарымжан қарсылас емес.
Dialogue: 0,0:44:40.24,0:44:42.48,Default,,0,0,0,,Менің бұл жерде күресуден басқа амалым жоқ.
Dialogue: 0,0:44:42.48,0:44:45.81,Default,,0,0,0,,Бірақ сіздің денеңіз... қозғалмайды.
Dialogue: 0,0:44:45.81,0:44:47.75,Default,,0,0,0,,Элементті өзгерту!
Dialogue: 0,0:44:47.75,0:44:50.72,Default,,0,0,0,,Энди В. Холл. Ә?
Dialogue: 0,0:44:50.72,0:44:54.22,Default,,0,0,0,,Тоқта... Мен бүгін бір қызбен қосыламын деп ойладым...
Dialogue: 0,0:44:59.29,0:45:02.09,Default,,0,0,0,,Жүр, қарғыс атқыр әйел!
Dialogue: 0,0:45:05.10,0:45:07.03,Default,,0,0,0,,Егер солай болса, Мелло Нианы айналып өтіп, дәптерді қолға түсіру үшін барын салған болар еді
Dialogue: 0,0:45:07.03,0:45:09.23,Default,,0,0,0,,Вектор Zed
Dialogue: 0,0:45:11.27,0:45:13.27,Default,,0,0,0,,Миконо қашып кетті
Dialogue: 0,0:45:15.18,0:45:17.18,Default,,0,0,0,,Амата-кун!
Dialogue: 0,0:45:26.75,0:45:29.56,Default,,0,0,0,,Төраға Клэр, біріктіруге рұқсат
Dialogue: 0,0:45:29.56,0:45:31.96,Default,,0,0,0,,Сұраныс №!
Dialogue: 0,0:45:31.96,0:45:34.59,Default,,0,0,0,,Мен өлсем де бәрібір
Dialogue: 0,0:45:34.59,0:45:37.63,Default,,0,0,0,,Егер сіз Aquarion ойнай алмасаңыз
Dialogue: 0,0:45:37.63,0:45:40.43,Default,,0,0,0,,Мен тірімін, бірақ мен өлдім.
Dialogue: 0,0:45:58.79,0:46:00.72,Default,,0,0,0,,Біріктіруге мүмкіндік береді
Dialogue: 0,0:46:00.72,0:46:04.02,Default,,0,0,0,,Шрейд Илан Сіз басшысыз.
Dialogue: 0,0:46:08.19,0:46:14.57,Default,,0,0,0,,Акварионды ойнайтын кез келді.
Dialogue: 0,0:46:14.57,0:46:20.17,Default,,0,0,0,,Әуен бірлігі Go Aquarion!
Dialogue: 0,0:46:31.05,0:46:34.89,Default,,0,0,0,,Қарқынды дыбыс кеудемде терең жаңғыруда.
Dialogue: 0,0:46:34.89,0:46:37.79,Default,,0,0,0,,Бірақ бұл біртүрлі сағыныш сезімін тудырады
Dialogue: 0,0:46:37.79,0:46:40.53,Default,,0,0,0,,Бұл өмір үні
Dialogue: 0,0:46:40.53,0:46:43.43,Default,,0,0,0,,Бейкүнә сәбидің дүниеге келген зары.
Dialogue: 0,0:46:48.67,0:46:52.07,Default,,0,0,0,,Акварион спада
Dialogue: 0,0:46:52.07,0:46:55.01,Default,,0,0,0,,Векторлық Хиронның басы ретінде комбинациясы
Dialogue: 0,0:46:55.01,0:46:57.11,Default,,0,0,0,,Акварион спада
Dialogue: 0,0:46:59.78,0:47:02.15,Default,,0,0,0,,Шрейдтің күшімен
Dialogue: 0,0:47:02.15,0:47:05.15,Default,,0,0,0,,Биліктің жаңа түрі дүниеге келді.
Dialogue: 0,0:47:11.69,0:47:13.69,Default,,0,0,0,,Акварион…
Dialogue: 0,0:47:15.60,0:47:20.97,Default,,0,0,0,,Сені алғаш көрген сәттен, өлі жүрегім
Dialogue: 0,0:47:20.97,0:47:24.60,Default,,0,0,0,,Қатты стакато соққысы басталды.
Dialogue: 0,0:47:24.60,0:47:27.51,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:47:27.51,0:47:29.91,Default,,0,0,0,,Жан әуені
Dialogue: 0,0:47:33.01,0:47:36.92,Default,,0,0,0,,Механикалық періште, маған тағы да жолыңды кесуге жол берме!
Dialogue: 0,0:47:36.92,0:47:39.15,Default,,0,0,0,,Амата Джессика
Dialogue: 0,0:47:39.15,0:47:42.76,Default,,0,0,0,,Өмір сүру – ойып салу
Dialogue: 0,0:47:42.76,0:47:45.76,Default,,0,0,0,,Өмірмен ойнау
Dialogue: 0,0:47:45.76,0:47:50.00,Default,,0,0,0,,Маған күш бер, өмір ойнайын.
Dialogue: 0,0:47:50.00,0:47:53.20,Default,,0,0,0,,Түсіндім, мен де оны жалғыз қалдыра алмаймын.
Dialogue: 0,0:47:57.74,0:48:01.24,Default,,0,0,0,,Кеттік, жанның арпеджиосы!
Dialogue: 0,0:48:08.38,0:48:10.58,Default,,0,0,0,,Мынау!
Dialogue: 0,0:48:12.92,0:48:15.82,Default,,0,0,0,,Аматаның «Ұшу» элементтік қабілеті
Dialogue: 0,0:48:15.82,0:48:18.29,Default,,0,0,0,,Және Джессиканың «шокы»
Dialogue: 0,0:48:18.29,0:48:22.16,Default,,0,0,0,,Шрейдтің күші осы екеуімен қабаттасқанда
Dialogue: 0,0:48:22.16,0:48:24.40,Default,,0,0,0,,Аспандағы айдың тербелісі
Dialogue: 0,0:48:24.40,0:48:27.30,Default,,0,0,0,,Егер су айы Allegro vivace ойнаса
Dialogue: 0,0:48:27.30,0:48:29.77,Default,,0,0,0,,Не? Адамның айы
Dialogue: 0,0:48:29.77,0:48:33.64,Default,,0,0,0,,Бұл өмірді Аджитатқа әндете беріңіз!
Dialogue: 0,0:48:33.64,0:48:36.54,Default,,0,0,0,,Ай сәулесі реквиемі!
Dialogue: 0,0:48:41.38,0:48:43.48,Default,,0,0,0,,Не!
Dialogue: 0,0:49:04.07,0:49:06.17,Default,,0,0,0,,Маю-сан менің жейдемнің үстінде жатыр…
Dialogue: 0,0:49:09.28,0:49:13.18,Default,,0,0,0,,Әлі жоқ. Мен әлі де күресе аламын.
Dialogue: 0,0:49:15.72,0:49:19.59,Default,,0,0,0,,Кешіріңіз, бірақ Митра Гунис қалпына келеді.
Dialogue: 0,0:49:19.59,0:49:22.49,Default,,0,0,0,,Vega-ны тергеу кезінде өзімшілдікпен ештеңе жасамаңыз.
Dialogue: 0,0:49:22.49,0:49:24.56,Default,,0,0,0,,Себебі менің жұмысым артады.
Dialogue: 0,0:49:24.56,0:49:27.66,Default,,0,0,0,,Джин… Теми…
Dialogue: 0,0:49:32.13,0:49:37.70,Default,,0,0,0,,Сіз қашуға тырысып жатырсыз ба, Шрейд? оған тағы бір соққы беріңіз
Dialogue: 0,0:49:37.70,0:49:41.00,Default,,0,0,0,,Шрейд Сәлем! Schrade...
Dialogue: 0,0:49:43.54,0:49:45.55,Default,,0,0,0,,Шрейд Жақсысың ба?
Dialogue: 0,0:49:45.55,0:49:47.95,Default,,0,0,0,,Шрейд Шрейд!
Dialogue: 0,0:49:54.82,0:49:58.66,Default,,0,0,0,,Миконо Не болды, Миконо?
Dialogue: 0,0:49:58.66,0:50:02.06,Default,,0,0,0,,Мен білмеймін, білмеймін
Dialogue: 0,0:50:02.06,0:50:07.46,Default,,0,0,0,,Бірақ білмеу ауырады
Dialogue: 0,0:51:47.33,0:51:50.57,Default,,0,0,0,,Сіз білесіз бе? Жоғалған элемент туралы елес оқиғаны айтыңыз.
Dialogue: 0,0:51:50.57,0:51:53.61,Default,,0,0,0,,Қорқынышты, қорқынышты, түнде ваннаға бара алмаймын.
Dialogue: 0,0:51:53.61,0:51:56.84,Default,,0,0,0,,Болмау үшін шұңқыр қазуым керек пе?
Dialogue: 0,0:51:56.84,0:52:00.74,Default,,0,0,0,,Next Aquarion EVOL «Түн ортасындағы қыз»
Dialogue: 0,0:52:02.24,0:52:08.24,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory