Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.97,0:00:43.51,Default,,0,0,0,,Аа, ұнамайды... тағдыр...
Dialogue: 0,0:00:43.51,0:00:46.98,Default,,0,0,0,,Маңыздысы біздің қазіргі жағдайымыз.
Dialogue: 0,0:00:46.98,0:00:49.88,Default,,0,0,0,,Джессика... Жоқ.
Dialogue: 0,0:00:49.88,0:00:54.28,Default,,0,0,0,,Түскі асқа кешігіп келдім, якисоба наны сатылып кетті.
Dialogue: 0,0:00:54.28,0:00:58.12,Default,,0,0,0,,Мм... Джессика
Dialogue: 0,0:00:58.12,0:01:01.83,Default,,0,0,0,,Бұл... Акварион ессіз кеткенге дейін
Dialogue: 0,0:01:01.83,0:01:04.13,Default,,0,0,0,,Джессика осылай деді.
Dialogue: 0,0:01:04.13,0:01:07.03,Default,,0,0,0,,Ұнады
Dialogue: 0,0:01:07.03,0:01:11.87,Default,,0,0,0,,Мен күткендей...
Dialogue: 0,0:01:11.87,0:01:15.31,Default,,0,0,0,,Дәл қазір, Миконо-сан... Иә? Түсіндім, жақсы!
Dialogue: 0,0:01:15.31,0:01:17.61,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:17.61,0:01:21.48,Default,,0,0,0,,Мен солай шығар деп ойладым.
Dialogue: 0,0:01:21.48,0:01:24.85,Default,,0,0,0,,Олай болса, күте тұр, Джессика!
Dialogue: 0,0:01:24.85,0:01:26.95,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:01:31.92,0:01:34.29,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:01:34.29,0:01:38.10,Default,,0,0,0,,Өтінемін... Сізді бөлгенім үшін кешіріңіз.
Dialogue: 0,0:01:38.10,0:01:40.73,Default,,0,0,0,,Хмм... Уау!
Dialogue: 0,0:01:40.73,0:01:45.57,Default,,0,0,0,,Бір минут күтіңіз! Миконо-сан, бұл дұрыс емес.
Dialogue: 0,0:01:45.57,0:01:50.17,Default,,0,0,0,,Әй, шуш шуш!
Dialogue: 0,0:01:50.17,0:01:52.27,Default,,0,0,0,,Миконо-сан!
Dialogue: 0,0:01:56.55,0:02:00.48,Default,,0,0,0,,Қабір шұңқырына жаттығу және имитацияланған шайқас
Dialogue: 0,0:02:00.48,0:02:04.66,Default,,0,0,0,,Уақыт піскен жоқ па? Иә
Dialogue: 0,0:02:04.66,0:02:09.16,Default,,0,0,0,,Бұл нәрсені қазып алатын уақыт келді ме?
Dialogue: 0,0:03:56.90,0:03:59.70,Default,,0,0,0,,Сізді тастап кетті ме?
Dialogue: 0,0:04:02.17,0:04:04.91,Default,,0,0,0,,Сол күндізгі нәрсе.
Dialogue: 0,0:04:04.91,0:04:07.91,Default,,0,0,0,,Мен бір нәрсені дұрыс түсінбеуім мүмкін.
Dialogue: 0,0:04:15.42,0:04:18.72,Default,,0,0,0,,Мен жұмыстан шықтым. Ештеңе етпейді.
Dialogue: 0,0:04:21.22,0:04:24.80,Default,,0,0,0,,Махаббатқа тыйым салынады. Барлығы бірдеңе дұрыс емес істеп жатыр.
Dialogue: 0,0:04:24.80,0:04:28.47,Default,,0,0,0,,Соңғы шайқаста тіпті адам шығыны да болды.
Dialogue: 0,0:04:28.47,0:04:33.97,Default,,0,0,0,,Неліктен махаббат? Бұл дұрыс
Dialogue: 0,0:04:33.97,0:04:37.94,Default,,0,0,0,,Бірақ дәл осындай жағдайға тап болғанымыз үшін өлім аузында тұрмыз.
Dialogue: 0,0:04:37.94,0:04:41.21,Default,,0,0,0,,Жалынды махаббатты қалайтыным да рас
Dialogue: 0,0:04:41.21,0:04:44.15,Default,,0,0,0,,Бұл жай ғана адамның инстинкті.
Dialogue: 0,0:04:44.15,0:04:48.08,Default,,0,0,0,,Мен өмірге қауіп төндіретін қауіп жағдайында генімді беруге тырысамын.
Dialogue: 0,0:04:48.08,0:04:51.69,Default,,0,0,0,,Гендер... ет пен қанның қосылуын айтамыз ба?
Dialogue: 0,0:04:51.69,0:04:54.39,Default,,0,0,0,,Жоқ, мен осыған көбірек ұқсаймын.
Dialogue: 0,0:04:54.39,0:04:57.29,Default,,0,0,0,,Таза махаббат
Dialogue: 0,0:05:06.40,0:05:12.90,Default,,0,0,0,,Бірақ егер шынымен өлетін болсаң, оны таста! ген
Dialogue: 0,0:05:22.99,0:05:28.33,Default,,0,0,0,,Төтенше шақыру? Барлығы осында сияқты.
Dialogue: 0,0:05:28.33,0:05:30.73,Default,,0,0,0,,Менің саған бұдан да құпия тапсырмам бар.
Dialogue: 0,0:05:30.73,0:05:34.03,Default,,0,0,0,,Мен оның орындалғанын қалаймын.
Dialogue: 0,0:05:34.03,0:05:36.87,Default,,0,0,0,,Хабарландыру әдісіне көбірек көңіл бөліңіз
Dialogue: 0,0:05:36.87,0:05:39.77,Default,,0,0,0,,Сонда бұл құпия тапсырма қандай?
Dialogue: 0,0:05:39.77,0:05:43.61,Default,,0,0,0,,Біреудің белгілі бір жерден бірдеңені қазып алуын сұраңыз
Dialogue: 0,0:05:43.61,0:05:46.51,Default,,0,0,0,,Онда не бар? Бұл өте құпия
Dialogue: 0,0:05:46.51,0:05:49.38,Default,,0,0,0,,Орын дегеніміз не? Бұл өте құпия
Dialogue: 0,0:05:49.38,0:05:52.42,Default,,0,0,0,,Сіз қазуға барасыз ба? Бұл өте құпия
Dialogue: 0,0:05:52.42,0:05:55.65,Default,,0,0,0,,Ха? Ертең таңертең кетеді
Dialogue: 0,0:05:55.65,0:05:59.09,Default,,0,0,0,,Жабдық, ақыл-ой, т.б. туралы толық ақпарат алу үшін.
Dialogue: 0,0:05:59.09,0:06:01.59,Default,,0,0,0,,Бұл «стратегиялық нұсқаулықта» жазылған.
Dialogue: 0,0:06:01.59,0:06:06.30,Default,,0,0,0,,Бұл өте құпия миссия және оны ешқашан ашуға болмайды.
Dialogue: 0,0:06:06.30,0:06:08.60,Default,,0,0,0,,Сол бас қолбасшы
Dialogue: 0,0:06:08.60,0:06:12.10,Default,,0,0,0,,Мен осы қолдан жасалған стратегиялық нұсқаулықты көрген сәттен бастап
Dialogue: 0,0:06:12.10,0:06:14.54,Default,,0,0,0,,Сезіп тұрғаныңызға сенімдімін.
Dialogue: 0,0:06:14.54,0:06:18.14,Default,,0,0,0,,Осыны айтайын.
Dialogue: 0,0:06:18.14,0:06:21.34,Default,,0,0,0,,Банандар жеңіл тағамдарға кірмейді!
Dialogue: 0,0:06:23.61,0:06:26.25,Default,,0,0,0,,Әдемі
Dialogue: 0,0:06:26.25,0:06:30.55,Default,,0,0,0,,Тым қобалжымаңыз. Бұл далалық саяхат емес.
Dialogue: 0,0:06:30.55,0:06:33.46,Default,,0,0,0,,Қалай болғанда да, бұл жеткізілген заттар.
Dialogue: 0,0:06:33.46,0:06:36.16,Default,,0,0,0,,Бұл біртүрлі банан.
Dialogue: 0,0:06:38.36,0:06:41.60,Default,,0,0,0,,Бұл не, Тұқым?
Dialogue: 0,0:06:41.60,0:06:45.00,Default,,0,0,0,,Бұл бананның түпнұсқа түрі сияқты.
Dialogue: 0,0:06:45.00,0:06:48.41,Default,,0,0,0,,Айтпақшы, бұл жолы баратын жеріміз қайда?
Dialogue: 0,0:06:48.41,0:06:52.31,Default,,0,0,0,,Ол векторлық машинаға бағдарламаланған сияқты.
Dialogue: 0,0:06:52.31,0:06:57.08,Default,,0,0,0,,Артымыздан басқа амал жоқ.Нұсқаушы білмей ме?
Dialogue: 0,0:06:57.08,0:07:00.88,Default,,0,0,0,,Мен сыныпты басқарамын дегеннен басқа мәліметтер жоқ.
Dialogue: 0,0:07:00.88,0:07:03.35,Default,,0,0,0,,Бұл тапсырма тіпті нұсқаушы Доналға арналған.
Dialogue: 0,0:07:03.35,0:07:07.22,Default,,0,0,0,,Мен білмедім. Сенің бұл құпияны сақтап жүргеніңе сене алар емеспін.
Dialogue: 0,0:07:07.22,0:07:11.09,Default,,0,0,0,,Бас қолбасшы нені қазғанымызды қалайды?
Dialogue: 0,0:07:11.09,0:07:13.46,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:07:13.46,0:07:17.43,Default,,0,0,0,,Аңызға айналған мифтік акварион иә?
Dialogue: 0,0:07:17.43,0:07:20.43,Default,,0,0,0,,Мифтік акварион?
Dialogue: 0,0:07:24.07,0:07:27.04,Default,,0,0,0,,Бірақ аңыз шындық болса ше?
Dialogue: 0,0:07:27.04,0:07:29.88,Default,,0,0,0,,Осындай нәрсені қазып алуға бола ма?
Dialogue: 0,0:07:29.88,0:07:32.68,Default,,0,0,0,,Хафф хафф хафф
Dialogue: 0,0:07:32.68,0:07:35.59,Default,,0,0,0,,Ақырында заттар қозғала бастаған сияқты.
Dialogue: 0,0:07:35.59,0:07:39.99,Default,,0,0,0,,Күннің қанаттарын іздеуде
Dialogue: 0,0:07:43.63,0:07:46.53,Default,,0,0,0,,Осындай жерде мифтік Акварион бар ма?
Dialogue: 0,0:07:46.53,0:07:50.70,Default,,0,0,0,,Бұл жасырыну үшін жақсы орын болуы мүмкін.
Dialogue: 0,0:07:50.70,0:07:53.17,Default,,0,0,0,,Қазсаң да көл емес пе?
Dialogue: 0,0:07:53.17,0:07:55.67,Default,,0,0,0,,Қай жерді қазайын дейсің, Бас қолбасшы?
Dialogue: 0,0:07:55.67,0:07:58.48,Default,,0,0,0,,Біраз күте тұрыңыз. А?
Dialogue: 0,0:07:58.48,0:08:02.91,Default,,0,0,0,,Әрбір адам келесі пәрмен берілгенге дейін әрекет ете алады.
Dialogue: 0,0:08:02.91,0:08:06.25,Default,,0,0,0,,Дұрыс. Бұл еркін қозғалыс па?
Dialogue: 0,0:08:06.25,0:08:09.15,Default,,0,0,0,,Соны айтсаң да, түсінемін.
Dialogue: 0,0:08:09.15,0:08:12.49,Default,,0,0,0,,Сонымен бұл... Қараңызшы!
Dialogue: 0,0:08:12.49,0:08:15.09,Default,,0,0,0,,Суға шомылу костюмін не әкелу керек?
Dialogue: 0,0:08:15.09,0:08:19.43,Default,,0,0,0,,Егер сіз купальникіңізді ұмытып қалсаңыз, көлікте біреуі болады.
Dialogue: 0,0:08:19.43,0:08:24.53,Default,,0,0,0,,Ұрысты біраз уақытқа ұмытып, санаңызды жуыңыз.
Dialogue: 0,0:08:27.20,0:08:29.87,Default,,0,0,0,,Бұл не, балалар?
Dialogue: 0,0:08:29.87,0:08:35.18,Default,,0,0,0,,Нұсқаушы Суоми Күнделікті күзеттің қаттылығы қандай?
Dialogue: 0,0:08:35.18,0:08:37.88,Default,,0,0,0,,Бұл ересектердің сүйкімділігі.
Dialogue: 0,0:08:37.88,0:08:40.55,Default,,0,0,0,,Джессика әдетте батыл көрінеді.
Dialogue: 0,0:08:40.55,0:08:42.49,Default,,0,0,0,,Киран Суға түсуге келгенде
Dialogue: 0,0:08:42.49,0:08:45.09,Default,,0,0,0,,Тағы бір дәм бар.
Dialogue: 0,0:08:45.09,0:08:51.19,Default,,0,0,0,,Бірақ ең әсерлі нәрсе... Уау.
Dialogue: 0,0:08:51.19,0:08:54.10,Default,,0,0,0,,Салыстырмалы түрде тар купальникке қарамастан
Dialogue: 0,0:08:54.10,0:08:57.67,Default,,0,0,0,,Жасырынбайтын Үлкен жарылыс!
Dialogue: 0,0:08:57.67,0:09:00.07,Default,,0,0,0,,ＭＩＸ…
Dialogue: 0,0:09:00.07,0:09:03.77,Default,,0,0,0,,Киран Микононың купальнигі өте сүйкімді
Dialogue: 0,0:09:03.77,0:09:07.01,Default,,0,0,0,,Айта кету керек, Юноха да өте...
Dialogue: 0,0:09:07.01,0:09:10.91,Default,,0,0,0,,Қандай таңғаларлық буксирлеу.
Dialogue: 0,0:09:10.91,0:09:14.78,Default,,0,0,0,,Ей, неге мен ғана еленбеймін?
Dialogue: 0,0:09:14.78,0:09:17.58,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:09:22.26,0:09:26.53,Default,,0,0,0,,Көлден соққан желдің әуені
Dialogue: 0,0:09:26.53,0:09:30.00,Default,,0,0,0,,Бұл өте жақсы сезім, менің ең жақын досым.
Dialogue: 0,0:09:30.00,0:09:32.44,Default,,0,0,0,,Мұны істеу дұрыс па?
Dialogue: 0,0:09:32.44,0:09:36.11,Default,,0,0,0,,Қалай болғанда да, бас қолбасшының нұсқауынсыз қозғала алмаймыз.
Dialogue: 0,0:09:36.11,0:09:39.14,Default,,0,0,0,,Мұны арнайы жаттығуларыңыздың бөлігі ретінде қабылдаңыз және одан ләззат алыңыз.
Dialogue: 0,0:09:39.14,0:09:45.92,Default,,0,0,0,,Арнайы дайындық... Бізге әлі жетіспейтін нәрсе бар ма?
Dialogue: 0,0:09:45.92,0:09:48.69,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:09:48.69,0:09:51.29,Default,,0,0,0,,Сәлем Эй!
Dialogue: 0,0:09:51.29,0:09:54.96,Default,,0,0,0,,Мен мұны купальник болғандықтан айтып отырған жоқпын.
Dialogue: 0,0:09:54.96,0:09:58.26,Default,,0,0,0,,MIX шынымен сүйкімді.
Dialogue: 0,0:09:58.26,0:10:01.16,Default,,0,0,0,,Әй, бұл сүйкімді
Dialogue: 0,0:10:01.16,0:10:03.17,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:10:03.17,0:10:06.00,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:10:06.00,0:10:08.91,Default,,0,0,0,,Әй, менің гендерім дірілдеп жатыр!
Dialogue: 0,0:10:08.91,0:10:11.81,Default,,0,0,0,,Қазір мұндай жерде таңырқайтын уақыт емес!
Dialogue: 0,0:10:11.81,0:10:14.71,Default,,0,0,0,,Сейно шабуылы!
Dialogue: 0,0:10:18.55,0:10:22.25,Default,,0,0,0,,Аха... Энди!
Dialogue: 0,0:10:26.02,0:10:30.26,Default,,0,0,0,,Мен... Бұл жаман болды. Сенімен бәрі жақсы ма?
Dialogue: 0,0:10:30.26,0:10:34.13,Default,,0,0,0,,А, бұл жарақат деңгейі маңызды емес.
Dialogue: 0,0:10:34.13,0:10:37.77,Default,,0,0,0,,Соңғы кездегі кеудемдегі ауырсынумен салыстырғанда бұл ештеңе емес.
Dialogue: 0,0:10:37.77,0:10:40.50,Default,,0,0,0,,Сіздің кеудеңіз де жарақаттанған ба? А, маған ұнамайды
Dialogue: 0,0:10:40.50,0:10:43.74,Default,,0,0,0,,Жоқ, олай емес. Міне бітті.
Dialogue: 0,0:10:43.74,0:10:45.68,Default,,0,0,0,,Не? Бірақ біраз уақытқа
Dialogue: 0,0:10:45.68,0:10:49.58,Default,,0,0,0,,Мүмкін демалу керек шығар. Ах...
Dialogue: 0,0:10:49.58,0:10:53.88,Default,,0,0,0,,ＭＩＸ！
Dialogue: 0,0:10:53.88,0:10:58.66,Default,,0,0,0,,Біраз күте тұрыңыз.
Dialogue: 0,0:10:58.66,0:11:03.96,Default,,0,0,0,,Осы жерде сөйлесейік пе?
Dialogue: 0,0:11:13.87,0:11:18.41,Default,,0,0,0,,Кеш болды. Сен не істеп жатырсың? Энди мен MIX?
Dialogue: 0,0:11:18.41,0:11:21.71,Default,,0,0,0,,Мен мұны аламын ба? Жоқ, сәл артық
Dialogue: 0,0:11:21.71,0:11:24.35,Default,,0,0,0,,Біздің жалғыз қалғанымыз жақсы болар еді деп ойлаймын.
Dialogue: 0,0:11:24.35,0:11:27.72,Default,,0,0,0,,Не? Бұл туралы айтатын болсақ, Миконоға не болды?
Dialogue: 0,0:11:27.72,0:11:31.42,Default,,0,0,0,,Мм... Джессика да жоқ.
Dialogue: 0,0:11:38.33,0:11:43.70,Default,,0,0,0,,Ха, бірдеңе ақымақ сияқты.
Dialogue: 0,0:11:43.70,0:11:45.67,Default,,0,0,0,,Миконо
Dialogue: 0,0:11:45.67,0:11:49.77,Default,,0,0,0,,Әйтеуір, бәрімен бірге болғым келмейді.
Dialogue: 0,0:11:52.41,0:11:57.35,Default,,0,0,0,,Бүгін біз бір-бірімізді жақсы сезінеміз.
Dialogue: 0,0:11:57.35,0:12:00.28,Default,,0,0,0,,Әй, мен суық тиіп қаламын.
Dialogue: 0,0:12:00.28,0:12:03.59,Default,,0,0,0,,Эй... эй MIX
Dialogue: 0,0:12:03.59,0:12:07.16,Default,,0,0,0,,Махаббатқа тыйым салынғанын жақсы білемін.
Dialogue: 0,0:12:07.16,0:12:11.36,Default,,0,0,0,,Қазір айтпасам, өкінемін деп ойлаймын.
Dialogue: 0,0:12:11.36,0:12:14.83,Default,,0,0,0,,Сіз не үшін өкінесіз?
Dialogue: 0,0:12:14.83,0:12:18.07,Default,,0,0,0,,Хмм... аа
Dialogue: 0,0:12:18.07,0:12:20.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:23.01,0:12:26.21,Default,,0,0,0,,Сәлем, Энди? MIX!
Dialogue: 0,0:12:26.21,0:12:28.98,Default,,0,0,0,,Абдуктормен шайқас аяқталғаннан кейін ғана.
Dialogue: 0,0:12:28.98,0:12:33.78,Default,,0,0,0,,Осылай айтсаң, ажал туы болып көрінеді.
Dialogue: 0,0:12:33.78,0:12:37.65,Default,,0,0,0,,Бірақ бәрібір, мен ешқашан өлмеймін.
Dialogue: 0,0:12:37.65,0:12:41.19,Default,,0,0,0,,Сонымен, бұл шайқас аяқталғанда
Dialogue: 0,0:12:41.19,0:12:43.13,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:43.13,0:12:46.03,Default,,0,0,0,,Айт, айт, Энди!
Dialogue: 0,0:12:46.03,0:12:49.07,Default,,0,0,0,,Мен әдетте ор қазатын адаммын.
Dialogue: 0,0:12:49.07,0:12:52.80,Default,,0,0,0,,Бұл жолы мен сенің жүрегіңдегі тесікті толтырғым келеді.
Dialogue: 0,0:12:52.80,0:12:56.51,Default,,0,0,0,,О, Энди? MIX!
Dialogue: 0,0:12:56.51,0:13:00.24,Default,,0,0,0,,Жүрегіңдегі тесікті толтырғым келеді
Dialogue: 0,0:13:00.24,0:13:04.78,Default,,0,0,0,,Мен сенің...
Dialogue: 0,0:13:04.78,0:13:07.25,Default,,0,0,0,,MIX! иә!
Dialogue: 0,0:13:07.25,0:13:12.99,Default,,0,0,0,,Мен сенің тесікіңді толтырғым келеді!
Dialogue: 0,0:13:12.99,0:13:17.26,Default,,0,0,0,,Иә, тесік? иә сенің
Dialogue: 0,0:13:17.26,0:13:19.90,Default,,0,0,0,,Тесік!
Dialogue: 0,0:13:19.90,0:13:22.80,Default,,0,0,0,,Жоқ... Мен басқа мағынадағы тесікті айтып отырмын, яғни.
Dialogue: 0,0:13:22.80,0:13:27.97,Default,,0,0,0,,Шәует... Не айтып тұрсың? Мен руханимын.
Dialogue: 0,0:13:27.97,0:13:33.18,Default,,0,0,0,,А? Сіз дәл қазір қатты бірдеңе естіген жоқсыз ба?
Dialogue: 0,0:13:33.18,0:13:36.61,Default,,0,0,0,,Айт!
Dialogue: 0,0:13:36.61,0:13:40.42,Default,,0,0,0,,Жүрек...
Dialogue: 0,0:13:40.42,0:13:42.79,Default,,0,0,0,,Білесің бе, мені
Dialogue: 0,0:13:42.79,0:13:45.69,Default,,0,0,0,,Менің ойымша, мен әрқашан Джессикаға қызғанышпен қарайтынмын.
Dialogue: 0,0:13:45.69,0:13:49.16,Default,,0,0,0,,Не? әрқашан түзу бол
Dialogue: 0,0:13:49.16,0:13:52.06,Default,,0,0,0,,Өз сезімдеріңіз туралы шынайы болыңыз
Dialogue: 0,0:13:52.06,0:13:55.26,Default,,0,0,0,,Сондықтан Амата-күн де солай.
Dialogue: 0,0:13:55.26,0:13:58.07,Default,,0,0,0,,Сіз өз сезіміңізді шынайы айта аласыз
Dialogue: 0,0:13:58.07,0:14:03.94,Default,,0,0,0,,Бірақ, біз жеткенге дейін көп нәрсе болды.
Dialogue: 0,0:14:03.94,0:14:07.88,Default,,0,0,0,,Микононы қызғанатын менмін.
Dialogue: 0,0:14:07.88,0:14:10.78,Default,,0,0,0,,Әрқашан кішіпейіл болып, еңбектеніңіз
Dialogue: 0,0:14:10.78,0:14:13.62,Default,,0,0,0,,Мүмкін барлық ұлдар Миконо сияқты қызды қалайтын шығар.
Dialogue: 0,0:14:13.62,0:14:17.05,Default,,0,0,0,,Мен сені сүйемін, бұл дұрыс емес.
Dialogue: 0,0:14:17.05,0:14:19.42,Default,,0,0,0,,Джессика ұлдар арасында көбірек танымал.
Dialogue: 0,0:14:19.42,0:14:22.26,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:22.26,0:14:24.23,Default,,0,0,0,,Сөзге келсек, ұлдар
Dialogue: 0,0:14:24.23,0:14:27.13,Default,,0,0,0,,Миконо сияқты қызды таңдар еді деп ойлаймын.
Dialogue: 0,0:14:27.13,0:14:32.67,Default,,0,0,0,,Дұрыс, сен қорғағың келетін қыз түрі.
Dialogue: 0,0:14:32.67,0:14:35.57,Default,,0,0,0,,Джессика?
Dialogue: 0,0:14:38.11,0:14:41.41,Default,,0,0,0,,Аспан... мінекей!
Dialogue: 0,0:14:46.95,0:14:49.35,Default,,0,0,0,,Бұл өлшемді қақпа
Dialogue: 0,0:14:49.35,0:14:52.99,Default,,0,0,0,,Amata Мен Векторды іске қосамын. Түсіндім!
Dialogue: 0,0:14:52.99,0:14:56.33,Default,,0,0,0,,Ұрлаушы осылай жүреді
Dialogue: 0,0:14:56.33,0:15:01.30,Default,,0,0,0,,Энди, мен мұны істедім.
Dialogue: 0,0:15:01.30,0:15:07.50,Default,,0,0,0,,Сен ақымақ екенсің, сені әбден лақтырып жіберді.
Dialogue: 0,0:15:07.50,0:15:12.80,Default,,0,0,0,,Тесік болса, кіргім келетін сияқты.
Dialogue: 0,0:15:19.58,0:15:23.45,Default,,0,0,0,,Аудан Көл жағасы ANA аймағында өлшемді қақпа ашылды.
Dialogue: 0,0:15:23.45,0:15:26.36,Default,,0,0,0,,Тұрақты элементтер жойылды деп айтасыз ба?
Dialogue: 0,0:15:26.36,0:15:28.29,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:15:28.29,0:15:30.86,Default,,0,0,0,,Сабыр ет, Донал.
Dialogue: 0,0:15:30.86,0:15:36.00,Default,,0,0,0,,Төраға Клэр Бас қолбасшы Не болып жатыр?
Dialogue: 0,0:15:36.00,0:15:38.00,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:51.48,0:15:56.15,Default,,0,0,0,,Бұл ұрлаушы кім? Қаш, Миконо.
Dialogue: 0,0:15:56.15,0:15:58.95,Default,,0,0,0,,Энди!
Dialogue: 0,0:16:01.06,0:16:03.06,Default,,0,0,0,,Энди, сен не істеп жатырсың?
Dialogue: 0,0:16:03.06,0:16:08.23,Default,,0,0,0,,Жау шабуылы! Тезірек шұңқырдан шығыңыз! Жарайды...
Dialogue: 0,0:16:08.23,0:16:10.83,Default,,0,0,0,,Мені жалғыз қалдырыңыз!
Dialogue: 0,0:16:10.83,0:16:13.33,Default,,0,0,0,,Ха?
Dialogue: 0,0:16:19.88,0:16:24.08,Default,,0,0,0,,Өте суық комбинация GO Aquarion!
Dialogue: 0,0:16:29.55,0:16:33.55,Default,,0,0,0,,Акварион Гепард
Dialogue: 0,0:16:35.93,0:16:39.13,Default,,0,0,0,,Бұл біртүрлі ұрлаушы біздікі.
Dialogue: 0,0:16:39.13,0:16:42.00,Default,,0,0,0,,Schrade Жердегі барлық адамдарды қорғаңыз
Dialogue: 0,0:16:42.00,0:16:44.00,Default,,0,0,0,,Түсінікті, жақын досым!
Dialogue: 0,0:16:56.51,0:16:59.28,Default,,0,0,0,,Тропикалық елде туған мен үшін суық.
Dialogue: 0,0:16:59.28,0:17:01.22,Default,,0,0,0,,Бұл суық қатты
Dialogue: 0,0:17:01.22,0:17:04.62,Default,,0,0,0,,Бәрің Энди қазған шұңқырды пана алдыңдар.
Dialogue: 0,0:17:04.62,0:17:07.59,Default,,0,0,0,,Егер ол жер астында болса, суықтан сақтану керек.
Dialogue: 0,0:17:07.59,0:17:10.89,Default,,0,0,0,,Бұл боран ұрлаушы ма?
Dialogue: 0,0:17:13.96,0:17:19.47,Default,,0,0,0,,Жарайды, Амат сізге міндетті түрде көмектеседі.
Dialogue: 0,0:17:19.47,0:17:21.47,Default,,0,0,0,,Иә
Dialogue: 0,0:17:26.78,0:17:30.15,Default,,0,0,0,,Қарғыс атсын, қарғыс атсын, менде элементтік костюм болса болды.
Dialogue: 0,0:17:30.15,0:17:34.45,Default,,0,0,0,,Экспозиция қуаты жұмыс істемей ме? Жоқ, тым суық
Dialogue: 0,0:17:45.63,0:17:49.03,Default,,0,0,0,,Энди, ол қаншалықты терең қазды?
Dialogue: 0,0:17:49.03,0:17:51.40,Default,,0,0,0,,Энди
Dialogue: 0,0:17:51.40,0:17:53.67,Default,,0,0,0,,Энди…
Dialogue: 0,0:17:53.67,0:17:56.07,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:17:56.07,0:17:58.41,Default,,0,0,0,,Мен енді мұны істей алмаймын
Dialogue: 0,0:17:58.41,0:18:01.88,Default,,0,0,0,,Эндидің аура деңгейі қазір ең түбінде.
Dialogue: 0,0:18:01.88,0:18:03.91,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:18:03.91,0:18:07.22,Default,,0,0,0,,Енді оны қазып алатын кез келді
Dialogue: 0,0:18:07.22,0:18:11.62,Default,,0,0,0,,Энди В. Холлға барыңыз!
Dialogue: 0,0:18:17.86,0:18:20.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:20.66,0:18:23.37,Default,,0,0,0,,(Абдул) Ағаңды еске алу үшін шайқас өткізуге ниеттенесің бе?
Dialogue: 0,0:18:23.37,0:18:25.37,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:30.47,0:18:32.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:40.08,0:18:42.32,Default,,0,0,0,,Бұл дыбыс
Dialogue: 0,0:18:42.32,0:18:45.19,Default,,0,0,0,,Кеңістікте резонанс
Dialogue: 0,0:18:45.19,0:18:47.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:47.72,0:18:52.23,Default,,0,0,0,,Бұл жігіт... Ақыры басталды, Фудо.
Dialogue: 0,0:18:52.23,0:18:55.13,Default,,0,0,0,,Жерге түскен тұқымдар көктеп шығады
Dialogue: 0,0:18:55.13,0:18:58.93,Default,,0,0,0,,Жақында жемісін береді
Dialogue: 0,0:18:58.93,0:19:01.37,Default,,0,0,0,,Ал келесі ұрпаққа
Dialogue: 0,0:19:01.37,0:19:04.71,Default,,0,0,0,,Жаңа өмірді байланыстыру!
Dialogue: 0,0:19:04.71,0:19:07.61,Default,,0,0,0,,Суық
Dialogue: 0,0:19:09.55,0:19:12.88,Default,,0,0,0,,Су, жоқ, ыстық су...
Dialogue: 0,0:19:12.88,0:19:15.79,Default,,0,0,0,,А, күн жылы.
Dialogue: 0,0:19:15.79,0:19:21.36,Default,,0,0,0,,Бұл күкірт иісі ыстық бұлақ па?
Dialogue: 0,0:19:21.36,0:19:24.63,Default,,0,0,0,,Балалар... Әй, өмірге оралыңдар.
Dialogue: 0,0:19:24.63,0:19:28.20,Default,,0,0,0,,Е, Кя! Аа, кешіріңіз
Dialogue: 0,0:19:28.20,0:19:30.13,Default,,0,0,0,,Джессика
Dialogue: 0,0:19:30.13,0:19:32.43,Default,,0,0,0,,Миконо-сан Амата-кун
Dialogue: 0,0:19:39.14,0:19:44.84,Default,,0,0,0,,GO Aquarion аралас ванна комбинациясы!
Dialogue: 0,0:19:48.38,0:19:50.65,Default,,0,0,0,,А, мен толқып тұрмын
Dialogue: 0,0:19:50.65,0:19:54.35,Default,,0,0,0,,Жер қойнауынан, тіршілік құдіреті!
Dialogue: 0,0:19:57.43,0:20:01.30,Default,,0,0,0,,Aquarion EVOL
Dialogue: 0,0:20:01.30,0:20:05.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:05.63,0:20:07.70,Default,,0,0,0,,Ежелгі алхимия бойынша
Dialogue: 0,0:20:07.70,0:20:11.04,Default,,0,0,0,,Әйел мен еркек бір қазанда қайнатылады деген дұрыс емес.
Dialogue: 0,0:20:11.04,0:20:13.68,Default,,0,0,0,,Бір-бірінің кемшілігінің орнын толтыру, бір болу
Dialogue: 0,0:20:13.68,0:20:16.58,Default,,0,0,0,,Бұл қайта туылу дегенді білдіреді.
Dialogue: 0,0:20:16.58,0:20:19.55,Default,,0,0,0,,Барлық элементтер бірін-бірі толықтырады
Dialogue: 0,0:20:19.55,0:20:22.69,Default,,0,0,0,,Ыстық суда бір бол
Dialogue: 0,0:20:22.69,0:20:27.69,Default,,0,0,0,,Фудо командирі, бұл арнайы дайындықтың мақсаты болды.
Dialogue: 0,0:20:31.53,0:20:35.90,Default,,0,0,0,,Аралас шомылуды былай қойғанда, бұл банан нені білдіреді?
Dialogue: 0,0:20:35.90,0:20:40.07,Default,,0,0,0,,Бананның пісуіне ықпал ететін өсімдік гормондарының көп мөлшері бар.
Dialogue: 0,0:20:40.07,0:20:44.07,Default,,0,0,0,,Бір кездері Атлантия бағында Хауаны азғырған жылан
Dialogue: 0,0:20:44.07,0:20:46.84,Default,,0,0,0,,Банан ағашында жасырылған
Dialogue: 0,0:20:46.84,0:20:51.65,Default,,0,0,0,,Банан – жұмақ жемісі және күн жемісі
Dialogue: 0,0:20:51.65,0:20:57.79,Default,,0,0,0,,Пісіп жетілген кезде жемісі күнге қарай көтеріледі.
Dialogue: 0,0:20:57.79,0:21:00.69,Default,,0,0,0,,А, бұл жақсы сезіледі
Dialogue: 0,0:21:00.69,0:21:04.53,Default,,0,0,0,,Денеңіздің өзегінен қыздырыңыз! Шуу
Dialogue: 0,0:21:04.53,0:21:08.43,Default,,0,0,0,,Жылы Мару!
Dialogue: 0,0:21:15.10,0:21:17.04,Default,,0,0,0,,Акварион...
Dialogue: 0,0:21:17.04,0:21:19.34,Default,,0,0,0,,Аршылған
Dialogue: 0,0:21:22.41,0:21:28.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:31.69,0:21:36.59,Default,,0,0,0,,Cluster Infinite Punch! Шексіз соққы!
Dialogue: 0,0:21:42.20,0:21:47.00,Default,,0,0,0,,Цурануке!
Dialogue: 0,0:21:50.84,0:21:53.48,Default,,0,0,0,,Мен істедім
Dialogue: 0,0:21:53.48,0:21:59.72,Default,,0,0,0,,Әй, ойық... жүрегімдегі тесік
Dialogue: 0,0:21:59.72,0:22:05.59,Default,,0,0,0,,Ақыры күннің қанатын таптым.
Dialogue: 0,0:22:05.59,0:22:11.33,Default,,0,0,0,,Бірақ негізгі бөлім басқа жерде
Dialogue: 0,0:22:11.33,0:22:16.10,Default,,0,0,0,,Күннің жемісі болса, мен оны саған қалағанша беремін.
Dialogue: 0,0:22:16.10,0:22:20.10,Default,,0,0,0,,Бірақ күннің қанаты
Dialogue: 0,0:22:28.68,0:22:32.25,Default,,0,0,0,,Қайырлы таң Амата Қайырлы таң
Dialogue: 0,0:22:32.25,0:22:37.22,Default,,0,0,0,,Иә... Джессика?
Dialogue: 0,0:22:37.22,0:22:40.96,Default,,0,0,0,,Джессика Бұл жақшаларда не болды?
Dialogue: 0,0:22:40.96,0:22:45.59,Default,,0,0,0,,Хмм, көңіл күйінің сәл өзгеруі сияқты?
Dialogue: 0,0:22:45.59,0:22:48.49,Default,,0,0,0,,Иә, мен мұны айтуды ұмытып кетіппін.
Dialogue: 0,0:22:52.87,0:22:55.14,Default,,0,0,0,,Мені Амата тастап кетті
Dialogue: 0,0:22:55.14,0:22:57.07,Default,,0,0,0,,Не? Бірақ бәрібір
Dialogue: 0,0:22:57.07,0:23:00.84,Default,,0,0,0,,Махаббат жүзеге асқанда, Акварион бақылаудан шығып кетеді.
Dialogue: 0,0:23:00.84,0:23:03.11,Default,,0,0,0,,Жауапсыз сүйіспеншілікке жарайды
Dialogue: 0,0:23:03.11,0:23:06.85,Default,,0,0,0,,Мен Аматаны ойлаймын
Dialogue: 0,0:23:06.85,0:23:09.95,Default,,0,0,0,,Хунхун…
Dialogue: 0,0:24:43.05,0:24:46.95,Default,,0,0,0,,Мен қандай бала едім?
Dialogue: 0,0:24:46.95,0:24:50.42,Default,,0,0,0,,Күшті, ержүрек жауынгер? Бұл дұрыс
Dialogue: 0,0:24:50.42,0:24:52.49,Default,,0,0,0,,Мен жеңуге бел байладым...
Dialogue: 0,0:24:52.49,0:24:56.69,Default,,0,0,0,,Жоқ, түсінбеймін!
Dialogue: 0,0:27:22.64,0:27:24.57,Default,,0,0,0,,Бас қолбасшы Фудо?
Dialogue: 0,0:27:24.57,0:27:30.45,Default,,0,0,0,,Жазба болды. Сіз бүгін таңертең мектептен ерте шыққан сияқтысыз.
Dialogue: 0,0:27:30.45,0:27:35.58,Default,,0,0,0,,Сіз оны іздейсіз бе? Аңызға айналған мифтік Акварион?
Dialogue: 0,0:27:35.58,0:27:38.19,Default,,0,0,0,,Сіз қандай да бір анықтама таптыңыз ба?
Dialogue: 0,0:27:38.19,0:27:41.09,Default,,0,0,0,,Мен түсінбеймін. Жаратылыс кітабында айтылған
Dialogue: 0,0:27:41.09,0:27:43.99,Default,,0,0,0,,Немесе ол жазылған шығар
Dialogue: 0,0:27:43.99,0:27:46.09,Default,,0,0,0,,Жаратылыс кітабы?
Dialogue: 0,0:27:53.44,0:27:57.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:57.04,0:28:00.84,Default,,0,0,0,,Онда... сонша саңылаулар бар.
Dialogue: 0,0:28:00.84,0:28:05.11,Default,,0,0,0,,Міне! Бұл жерде!
Dialogue: 0,0:28:05.11,0:28:09.35,Default,,0,0,0,,Бұл жігіт қайтадан терең, Энди.
Dialogue: 0,0:28:09.35,0:28:11.35,Default,,0,0,0,,Не болды? Ол...
Dialogue: 0,0:28:11.35,0:28:14.02,Default,,0,0,0,,Бұл өткен күні үлкен жетістік болды, бірақ иә!
Dialogue: 0,0:28:14.02,0:28:17.83,Default,,0,0,0,,Энди ашқан ыстық бұлақ керемет болды.
Dialogue: 0,0:28:17.83,0:28:21.70,Default,,0,0,0,,Бірдеңе болды ма? Гику!
Dialogue: 0,0:28:21.70,0:28:26.17,Default,,0,0,0,,MIX туралы түсінік бар ма? Мм... шынымен емес.
Dialogue: 0,0:28:26.17,0:28:28.97,Default,,0,0,0,,Мен не болғанын шынымен де білмеймін.
Dialogue: 0,0:28:28.97,0:28:31.77,Default,,0,0,0,,Хэхе... хехехе
Dialogue: 0,0:28:31.77,0:28:35.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:28:35.54,0:28:39.74,Default,,0,0,0,,Ах... АРАЛАШ
Dialogue: 0,0:30:23.69,0:30:26.59,Default,,0,0,0,,Концерт?
Dialogue: 0,0:30:26.59,0:30:30.33,Default,,0,0,0,,Рахмет. Ойлан. Тек бұл туралы ойламаңыз.
Dialogue: 0,0:30:30.33,0:30:33.30,Default,,0,0,0,,Шынайы, менімен жүр, мен сені күтемін.
Dialogue: 0,0:30:33.30,0:30:37.67,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:30:37.67,0:30:39.60,Default,,0,0,0,,Мені басқа кездесуге шақырғыңыз келе ме?
Dialogue: 0,0:30:39.60,0:30:42.60,Default,,0,0,0,,Джессика макияж жасағаннан кейін танымал емес
Dialogue: 0,0:30:42.60,0:30:46.81,Default,,0,0,0,,Хмм... Тәтті болса екен.
Dialogue: 0,0:30:46.81,0:30:49.75,Default,,0,0,0,,Оның өтірік шайқас кезіндегі батыл мойындауы да жұмыс істеген шығар.
Dialogue: 0,0:30:49.75,0:30:53.12,Default,,0,0,0,,Бұлтылу, бірдеңе дұрыс емес сияқты сезіну.
Dialogue: 0,0:30:53.12,0:30:55.48,Default,,0,0,0,,Кешіріңіз, бұл болуы мүмкін бе?
Dialogue: 0,0:30:55.48,0:30:57.42,Default,,0,0,0,,Мен қажетсіз бірдеңе айтқандықтан ба?
Dialogue: 0,0:30:57.42,0:31:00.86,Default,,0,0,0,,Айтқым келгендіктен ғана айттым.
Dialogue: 0,0:31:00.86,0:31:06.53,Default,,0,0,0,,Әйтеуір алға жылжыдық... Әй, рас па?
Dialogue: 0,0:31:06.53,0:31:11.93,Default,,0,0,0,,Бірақ алда тағы бір тығырыққа тіреледі.
Dialogue: 0,0:31:14.64,0:31:16.87,Default,,0,0,0,,Сузусиро мырза А, иә.
Dialogue: 0,0:31:16.87,0:31:20.44,Default,,0,0,0,,Жақсы болды, мен оны жатақханаға жеткізіп бермек болдым.
Dialogue: 0,0:31:20.44,0:31:23.74,Default,,0,0,0,,Иә, бұл үшін кешіріңіз.
Dialogue: 0,0:31:26.38,0:31:29.22,Default,,0,0,0,,Миконо-сан!
Dialogue: 0,0:31:29.22,0:31:34.12,Default,,0,0,0,,О, жоқ, мен... Мен ештеңе жасырып тұрғандай емеспін.
Dialogue: 0,0:31:34.12,0:31:37.86,Default,,0,0,0,,Әкемнен келген хат? Әкемнен хат па?
Dialogue: 0,0:31:37.86,0:31:41.73,Default,,0,0,0,,Ол аздап қиын адам болғандықтан, иә?
Dialogue: 0,0:31:41.73,0:31:44.57,Default,,0,0,0,,Маған хат жазады деп күтпедім.
Dialogue: 0,0:31:44.57,0:31:48.10,Default,,0,0,0,,Сенің маған қамқор болуың табиғи нәрсе.
Dialogue: 0,0:31:48.10,0:31:51.84,Default,,0,0,0,,Ата-ана мен бала деп айту маған жат па?
Dialogue: 0,0:31:51.84,0:31:54.14,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:31:54.14,0:31:58.98,Default,,0,0,0,,Мен анам туралы біраз есте қалдым.
Dialogue: 0,0:31:58.98,0:32:02.68,Default,,0,0,0,,Бірақ әкем туралы ештеңе жоқ.
Dialogue: 0,0:32:05.49,0:32:09.29,Default,,0,0,0,,Солай болса да мен түсінбейтін нәрселер көп.
Dialogue: 0,0:32:09.29,0:32:11.63,Default,,0,0,0,,Сол кезде ше?
Dialogue: 0,0:32:11.63,0:32:15.30,Default,,0,0,0,,Мен сені сол жолы қорғадым ба?
Dialogue: 0,0:32:15.30,0:32:18.67,Default,,0,0,0,,Тоқта! атпа
Dialogue: 0,0:32:18.67,0:32:22.20,Default,,0,0,0,,Бұл адамды кешіріңіз!
Dialogue: 0,0:32:22.20,0:32:25.11,Default,,0,0,0,,Жоқ, мен Микононы кінәлағым келмейді.
Dialogue: 0,0:32:25.11,0:32:27.64,Default,,0,0,0,,Енді барлығымыз өз сезімдерімізде бірлікте болуымыз керек.
Dialogue: 0,0:32:27.64,0:32:31.61,Default,,0,0,0,,Мен де солай ойлаймын, өйткені бұл жаман уақыт.
Dialogue: 0,0:32:31.61,0:32:35.52,Default,,0,0,0,,Менің рөлім – әр адамның сезімін байланыстыру.
Dialogue: 0,0:32:35.52,0:32:39.75,Default,,0,0,0,,Бірақ мен шынымен білмеймін.
Dialogue: 0,0:32:39.75,0:32:42.45,Default,,0,0,0,,Миконо-сан!
Dialogue: 0,0:32:58.94,0:33:01.34,Default,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:33:04.35,0:33:06.28,Default,,0,0,0,,Бұл сирек кездеседі.
Dialogue: 0,0:33:06.28,0:33:09.18,Default,,0,0,0,,Не болды? әкеден хат
Dialogue: 0,0:33:09.18,0:33:11.85,Default,,0,0,0,,Бұл маған қателесіп келді.
Dialogue: 0,0:33:11.85,0:33:14.76,Default,,0,0,0,,Кешіріңіз, мен оны кездейсоқ шығардым.
Dialogue: 0,0:33:14.76,0:33:17.69,Default,,0,0,0,,Әкемнің қолжазбасын оқу қиын.
Dialogue: 0,0:33:17.69,0:33:21.50,Default,,0,0,0,,Жалпы, бұл күндері мөрленген хатпен жібермесеңіз де
Dialogue: 0,0:33:21.50,0:33:24.80,Default,,0,0,0,,Не болды? А, жоқ.
Dialogue: 0,0:33:24.80,0:33:27.07,Default,,0,0,0,,Сосын мен саған бердім.
Dialogue: 0,0:33:27.07,0:33:29.87,Default,,0,0,0,,Сәлем Миконо!
Dialogue: 0,0:33:34.81,0:33:37.11,Default,,0,0,0,,Мен ақымақпын.
Dialogue: 0,0:33:37.11,0:33:40.48,Default,,0,0,0,,Мен оқуды бірден тоқтатуым керек еді.
Dialogue: 0,0:33:40.48,0:33:45.15,Default,,0,0,0,,Нео Диваның Микононы неге қабылдағанын білмеймін.
Dialogue: 0,0:33:45.15,0:33:50.13,Default,,0,0,0,,Мен сенің жолыңа бөгет бола ма деп уайымдап отырмын.
Dialogue: 0,0:33:50.13,0:33:56.13,Default,,0,0,0,,Мен ешқашан ештеңеге қанағаттанбайтын қыз болдым.
Dialogue: 0,0:33:56.13,0:34:00.77,Default,,0,0,0,,Қаласаңыз, мен сізді Нео Дивадан қайтарамын.
Dialogue: 0,0:34:00.77,0:34:03.77,Default,,0,0,0,,Мен оны қолымда ұстаймын
Dialogue: 0,0:34:03.77,0:34:08.48,Default,,0,0,0,,Ол әкесі үшін әлі қабілетсіз бала.
Dialogue: 0,0:34:08.48,0:34:10.58,Default,,0,0,0,,Миконо?
Dialogue: 0,0:34:13.32,0:34:15.28,Default,,0,0,0,,Шуш Кюкю
Dialogue: 0,0:34:15.28,0:34:17.72,Default,,0,0,0,,Сіз Энди үшін алаңдайсыз ба?
Dialogue: 0,0:34:17.72,0:34:21.36,Default,,0,0,0,,Ол қазір шынымен де депрессияда, солай емес пе?
Dialogue: 0,0:34:21.36,0:34:23.73,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:34:23.73,0:34:27.06,Default,,0,0,0,,Бірақ екеуі өте жақсы араласты.
Dialogue: 0,0:34:27.06,0:34:30.90,Default,,0,0,0,,Өткен күнгі саяхат кезінде, біраз уақытқа.
Dialogue: 0,0:34:30.90,0:34:35.30,Default,,0,0,0,,Басқаларға анық сөйлеуді айтыңыз.
Dialogue: 0,0:34:35.30,0:34:40.01,Default,,0,0,0,,Өзіме келсем, шекарадан өтуге батылым жетпейді.
Dialogue: 0,0:34:40.01,0:34:44.25,Default,,0,0,0,,Барлық ер адамдар еріксіз өз әкесіндей сезінеді.
Dialogue: 0,0:34:44.25,0:34:47.28,Default,,0,0,0,,Әке... тыңдап тұрсыз ғой?
Dialogue: 0,0:34:47.28,0:34:50.82,Default,,0,0,0,,Еркектерді ұнатпайтын себебім Иә.
Dialogue: 0,0:34:50.82,0:34:52.75,Default,,0,0,0,,Миконо қалай болды?
Dialogue: 0,0:34:52.75,0:34:56.63,Default,,0,0,0,,Жақсы өтті ме? Әкем және мен?
Dialogue: 0,0:34:56.63,0:35:00.03,Default,,0,0,0,,Мен...
Dialogue: 0,0:35:00.03,0:35:02.43,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:35:02.43,0:35:06.90,Default,,0,0,0,,Бұл не, Миконо?
Dialogue: 0,0:35:06.90,0:35:09.94,Default,,0,0,0,,Ол өте анық емес.
Dialogue: 0,0:35:09.94,0:35:14.64,Default,,0,0,0,,Мен әрқашан әкемнің өңіне қарап жүргендей боламын.
Dialogue: 0,0:35:14.64,0:35:16.58,Default,,0,0,0,,Айтар сөзің болса да
Dialogue: 0,0:35:16.58,0:35:19.55,Default,,0,0,0,,Мен ашуланғанда не істерімді білмеймін, сондықтан ештеңе айта алмаймын.
Dialogue: 0,0:35:19.55,0:35:22.05,Default,,0,0,0,,Демек, ол да түсініксіз бала.
Dialogue: 0,0:35:22.05,0:35:25.92,Default,,0,0,0,,Сіз ашуланып қалдыңыз, түсіндім.
Dialogue: 0,0:35:25.92,0:35:28.86,Default,,0,0,0,,О, мен білмеймін.
Dialogue: 0,0:35:28.86,0:35:32.06,Default,,0,0,0,,Әке десем де, оның қарама-қарсы жынысты болуы ғажап емес.
Dialogue: 0,0:35:32.06,0:35:36.77,Default,,0,0,0,,Ер адамның сезімін тек ер адамдар түсіне алады.
Dialogue: 0,0:35:36.77,0:35:41.37,Default,,0,0,0,,Не?
Dialogue: 0,0:35:41.37,0:35:43.67,Default,,0,0,0,,Әй, енді ойласам, Шушу
Dialogue: 0,0:35:43.67,0:35:46.64,Default,,0,0,0,,Ер әйел? Бұл дұрыс
Dialogue: 0,0:35:46.64,0:35:48.64,Default,,0,0,0,,Шушу
Dialogue: 0,0:35:56.89,0:35:58.85,Default,,0,0,0,,Джессика?
Dialogue: 0,0:35:58.85,0:36:01.62,Default,,0,0,0,,Осылай кеш жаттығасыз ба?
Dialogue: 0,0:36:01.62,0:36:06.06,Default,,0,0,0,,Мен күрескен әйел екенімді есіме түсірдім.
Dialogue: 0,0:36:06.06,0:36:09.03,Default,,0,0,0,,Соңғы кездері аздап қобалжыдым.
Dialogue: 0,0:36:09.03,0:36:12.33,Default,,0,0,0,,Өйткені мен мұндай нәрсені жоғалтқым келмейді.
Dialogue: 0,0:36:12.33,0:36:16.10,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:36:16.10,0:36:18.40,Default,,0,0,0,,Джессика
Dialogue: 0,0:36:26.88,0:36:30.48,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:36:33.46,0:36:37.26,Default,,0,0,0,,Тұйық жол?
Dialogue: 0,0:36:43.13,0:36:47.00,Default,,0,0,0,,Темір теңізінің жұмыс жылдамдығы 40%-дан төмен түсті.
Dialogue: 0,0:36:47.00,0:36:51.64,Default,,0,0,0,,Ең бастысы, өлшемді тасымалдау үшін қажетті энергия шығыны шама ретімен.
Dialogue: 0,0:36:51.64,0:36:54.44,Default,,0,0,0,,Егер сіз Вегаға алға-артқа жүре берсеңіз
Dialogue: 0,0:36:54.44,0:36:57.71,Default,,0,0,0,,Тіпті азаматтардың ең төменгі өмір сүру деңгейіне де әсер етеді.
Dialogue: 0,0:36:57.71,0:37:01.62,Default,,0,0,0,,Сондай-ақ ауқымды тәртіпсіздіктер болады деп күтілуде
Dialogue: 0,0:37:01.62,0:37:06.45,Default,,0,0,0,,Ақырында біз істейтін ештеңе қалмайтын деңгейге жеткен сияқтымыз.
Dialogue: 0,0:37:06.45,0:37:09.69,Default,,0,0,0,,Кагура қайда орналасқан? кешіріңіз
Dialogue: 0,0:37:09.69,0:37:11.93,Default,,0,0,0,,Әлі түсініксіз
Dialogue: 0,0:37:11.93,0:37:15.60,Default,,0,0,0,,Мүмкін Микадж жіптерді тартып жатқан шығар.
Dialogue: 0,0:37:15.60,0:37:20.24,Default,,0,0,0,,Ол адам Альтейдің болашағына мүлде қарамайды.
Dialogue: 0,0:37:20.24,0:37:23.27,Default,,0,0,0,,Ха, бұл...
Dialogue: 0,0:37:23.27,0:37:26.54,Default,,0,0,0,,Афра Гунисті кетуге дайындаңыз.
Dialogue: 0,0:37:26.54,0:37:31.81,Default,,0,0,0,,Бұл? Вегаға барыңыз
Dialogue: 0,0:37:31.81,0:37:38.21,Default,,0,0,0,,Мен көптен бері алыс жүрген майдан даласының атмосферасынан ләззат алатын кез келген сияқты.
Dialogue: 0,0:37:47.73,0:37:49.66,Default,,0,0,0,,Алисия
Dialogue: 0,0:37:49.66,0:37:53.94,Default,,0,0,0,,Бұл дүниені алғашқы айқайымен естіртсін
Dialogue: 0,0:37:53.94,0:37:58.11,Default,,0,0,0,,Біз нағыз Хауа ананы міндетті түрде табамыз
Dialogue: 0,0:37:58.11,0:38:01.64,Default,,0,0,0,,Мүмкін кездесерміз.
Dialogue: 0,0:38:01.64,0:38:06.84,Default,,0,0,0,,Вегада қалдырған ұлыңызға да.
Dialogue: 0,0:38:10.99,0:38:13.59,Default,,0,0,0,,Сіз оны оқыдыңыз ба? Сіз
Dialogue: 0,0:38:13.59,0:38:16.49,Default,,0,0,0,,Әкемнің хаты...
Dialogue: 0,0:38:16.49,0:38:18.43,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:38:18.43,0:38:22.10,Default,,0,0,0,,Не оқығаның маңызды емес.
Dialogue: 0,0:38:22.10,0:38:25.00,Default,,0,0,0,,Себебі сіз депрессияға түскен сияқтысыз.
Dialogue: 0,0:38:25.00,0:38:27.80,Default,,0,0,0,,Неліктен ата-аналар мұндай?
Dialogue: 0,0:38:27.80,0:38:30.84,Default,,0,0,0,,Сіз тек қажетсіз нәрселерге алаңдайсыз ба?
Dialogue: 0,0:38:30.84,0:38:34.24,Default,,0,0,0,,Мен үйге бара аламын.
Dialogue: 0,0:38:34.24,0:38:37.61,Default,,0,0,0,,Не? Дәл әкем айтқандай
Dialogue: 0,0:38:37.61,0:38:41.42,Default,,0,0,0,,Егер сіз Кайенге және басқаларға кедергі болып жатсаңыз ше?
Dialogue: 0,0:38:41.42,0:38:45.15,Default,,0,0,0,,Үйде сабырлы болуды үйрене алмайтын балаларға жақсы.
Dialogue: 0,0:38:45.15,0:38:47.52,Default,,0,0,0,,Миконо
Dialogue: 0,0:38:47.52,0:38:50.43,Default,,0,0,0,,Жоқ... Шықыр!
Dialogue: 0,0:38:50.43,0:38:53.46,Default,,0,0,0,,Сіз не істеп жатырсыз? Сіз баяғыдан
Dialogue: 0,0:38:53.46,0:38:57.27,Default,,0,0,0,,Адамдардың түсіне тым көп көңіл бөлесіз бе?
Dialogue: 0,0:38:57.27,0:39:00.57,Default,,0,0,0,,Себебі мен басқа адамды ренжіткім немесе ренжіткім келмейді.
Dialogue: 0,0:39:00.57,0:39:03.81,Default,,0,0,0,,Дауыстап айтуға қорқамын, бірақ
Dialogue: 0,0:39:03.81,0:39:08.68,Default,,0,0,0,,Негізі сіз өзіңізді жарақаттап алудан қорқасыз, солай ма?
Dialogue: 0,0:39:08.68,0:39:11.55,Default,,0,0,0,,Мен де сені әрқашан ойладым
Dialogue: 0,0:39:11.55,0:39:15.25,Default,,0,0,0,,Мен оны ештеңе істей алмайтын ауру апа деп ойладым.
Dialogue: 0,0:39:15.25,0:39:21.06,Default,,0,0,0,,Әйтсе де, алғаш танысқанымызда маған осылай айтқан бір жігіт болды.
Dialogue: 0,0:39:21.06,0:39:23.96,Default,,0,0,0,,Мен сені жаңа ғана кездестірдім.
Dialogue: 0,0:39:23.96,0:39:28.33,Default,,0,0,0,,Мен қазір Миконо-сан басқаша сезінемін.
Dialogue: 0,0:39:28.33,0:39:31.13,Default,,0,0,0,,Мен Миконо-санның бұрынғыдай адам екеніне сенімдімін.
Dialogue: 0,0:39:31.13,0:39:34.04,Default,,0,0,0,,Өзгергіңіз келе ме деп ойлаймын!
Dialogue: 0,0:39:34.04,0:39:36.60,Default,,0,0,0,,Амата-кун солай істеді ме?
Dialogue: 0,0:39:36.60,0:39:39.81,Default,,0,0,0,,Мен акуланы ұстадым, бірақ ол дұрыс айтты.
Dialogue: 0,0:39:39.81,0:39:43.18,Default,,0,0,0,,Сіз әрине өзгердіңіз.
Dialogue: 0,0:39:43.18,0:39:47.05,Default,,0,0,0,,Тезірек әкеме көрсеткім келеді.
Dialogue: 0,0:39:47.05,0:39:50.05,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:40:03.50,0:40:06.40,Default,,0,0,0,,Бұл үнді бірінші рет естіп тұрмын.
Dialogue: 0,0:40:06.40,0:40:09.80,Default,,0,0,0,,Ауыр және асыл дыбыс
Dialogue: 0,0:40:13.58,0:40:17.78,Default,,0,0,0,,Теңіз? Сағыныш көк
Dialogue: 0,0:40:17.78,0:40:20.98,Default,,0,0,0,,Менің жастық шағымның Вегасы
Dialogue: 0,0:40:20.98,0:40:26.22,Default,,0,0,0,,Изумо, сіз қазір гүлдеуді жоспарлап отырсыз ба?
Dialogue: 0,0:40:26.22,0:40:28.59,Default,,0,0,0,,Әлде іздеу керек пе?
Dialogue: 0,0:40:28.59,0:40:32.46,Default,,0,0,0,,Гүлден қалған тұқымдар не болады?
Dialogue: 0,0:40:32.46,0:40:34.40,Default,,0,0,0,,Бұл мен бұрын көрмеген ұшақ.
Dialogue: 0,0:40:34.40,0:40:38.27,Default,,0,0,0,,Жау басының иісі өткір.
Dialogue: 0,0:40:38.27,0:40:42.47,Default,,0,0,0,,Әй, кешігіп қалдың, Энди! Кешіріңіз...
Dialogue: 0,0:40:48.08,0:40:52.35,Default,,0,0,0,,Амансың ба? О, бұл ерекше ештеңе емес.
Dialogue: 0,0:40:52.35,0:40:55.05,Default,,0,0,0,,Ах! Twitch
Dialogue: 0,0:40:55.05,0:40:57.79,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:40:57.79,0:40:59.72,Default,,0,0,0,,Эй... Энди!
Dialogue: 0,0:40:59.72,0:41:02.59,Default,,0,0,0,,Ой! Мұндай жерге тесік бұрғылаңыз
Dialogue: 0,0:41:02.59,0:41:06.46,Default,,0,0,0,,Жоқ, қазіргі жігіт ақымақ.
Dialogue: 0,0:41:06.46,0:41:08.50,Default,,0,0,0,,Сұрыптауға болатын векторлар саны 5-ке тең.
Dialogue: 0,0:41:08.50,0:41:10.93,Default,,0,0,0,,Екі вектор қолдайтын акварион
Dialogue: 0,0:41:10.93,0:41:13.17,Default,,0,0,0,,Сұрыптау элементі...
Dialogue: 0,0:41:13.17,0:41:17.11,Default,,0,0,0,,Мен мұны сізге Кайен Амата қалдырамын және...
Dialogue: 0,0:41:17.11,0:41:19.27,Default,,0,0,0,,Мен барамын! мен барамын!
Dialogue: 0,0:41:19.27,0:41:22.14,Default,,0,0,0,,Жоқ, мен сендерді жібере алмаймын...
Dialogue: 0,0:41:22.14,0:41:25.85,Default,,0,0,0,,Егер маған төбелесуге тыйым салынса, мен өзім болмаймын.
Dialogue: 0,0:41:25.85,0:41:29.45,Default,,0,0,0,,Жауынгер ретінде мен әйел ретінде өзімнен асып түскім келеді.
Dialogue: 0,0:41:29.45,0:41:32.02,Default,,0,0,0,,Мен барлығына көмектескім келеді.
Dialogue: 0,0:41:32.02,0:41:35.46,Default,,0,0,0,,Балалар... кеттік.
Dialogue: 0,0:41:35.46,0:41:38.09,Default,,0,0,0,,Рас, тек ер адамдар күрессе де,
Dialogue: 0,0:41:38.09,0:41:40.53,Default,,0,0,0,,Шектер бар
Dialogue: 0,0:41:40.53,0:41:44.77,Default,,0,0,0,,Фудо Мен қателеспеймін, солай ма?
Dialogue: 0,0:41:44.77,0:41:48.24,Default,,0,0,0,,Жақсы! Аквариондағы Амата Джессика Моллой
Dialogue: 0,0:41:48.24,0:41:50.17,Default,,0,0,0,,Cayenne және MIX сізді қолдауы керек!
Dialogue: 0,0:41:50.17,0:41:53.61,Default,,0,0,0,,Түсіндім...
Dialogue: 0,0:41:53.61,0:41:56.54,Default,,0,0,0,,Джессика деген жігіт өте батыл.
Dialogue: 0,0:41:56.54,0:41:59.55,Default,,0,0,0,,Сондықтан мен одан бетер қобалжыдым.
Dialogue: 0,0:41:59.55,0:42:03.15,Default,,0,0,0,,Мен бұл туралы жағымсыз сезімде болмай тұра алмаймын.
Dialogue: 0,0:42:06.79,0:42:10.19,Default,,0,0,0,,Біріктірейік. Мен бастықпын, бұл жақсы!
Dialogue: 0,0:42:10.19,0:42:12.16,Default,,0,0,0,,Джессика түсінді
Dialogue: 0,0:42:12.16,0:42:17.16,Default,,0,0,0,,Heartbreak комбинациясы GO Aquarion!
Dialogue: 0,0:42:20.84,0:42:24.71,Default,,0,0,0,,Біз төбелесіп жатқанда, тым болмаса, Аматаның қасында бол!
Dialogue: 0,0:42:24.71,0:42:27.34,Default,,0,0,0,,Джессиканың ойлары Бұл солай ма?
Dialogue: 0,0:42:27.34,0:42:30.85,Default,,0,0,0,,Күтілгендей, біріктіру ең жақсы!
Dialogue: 0,0:42:30.85,0:42:34.45,Default,,0,0,0,,Акварион Гепард
Dialogue: 0,0:42:37.39,0:42:41.09,Default,,0,0,0,,Жаппай өндіру машинасын бізге қалдырыңыз!
Dialogue: 0,0:42:41.09,0:42:44.29,Default,,0,0,0,,Оны тек вектор болғандықтан ғана бағаламаңыз.
Dialogue: 0,0:42:54.64,0:42:57.44,Default,,0,0,0,,Бір соққымен шешіңіз
Dialogue: 0,0:42:59.47,0:43:05.21,Default,,0,0,0,,Бұл көк. Сол серпінді сатып алайық.
Dialogue: 0,0:43:05.21,0:43:09.72,Default,,0,0,0,,Жоқ! Бұл жұмыс істемейтін сияқты
Dialogue: 0,0:43:09.72,0:43:11.72,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:43:18.56,0:43:20.70,Default,,0,0,0,,Зақым туралы есеп
Dialogue: 0,0:43:20.70,0:43:23.97,Default,,0,0,0,,Жалпы гимназияның жанындағы Батыс аймағы қираған
Dialogue: 0,0:43:23.97,0:43:27.84,Default,,0,0,0,,Жау Гепардтың сәулесін жұтып, екі рет қайтарды.
Dialogue: 0,0:43:27.84,0:43:30.94,Default,,0,0,0,,...
Dialogue: 0,0:43:33.64,0:43:37.35,Default,,0,0,0,,Алтайда жастық жоғалады.
Dialogue: 0,0:43:37.35,0:43:40.45,Default,,0,0,0,,Бірақ жеңіске жету үшін мұның өзі жеткіліксіз.
Dialogue: 0,0:43:48.66,0:43:50.89,Default,,0,0,0,,Қызба, Джессика
Dialogue: 0,0:43:50.89,0:43:54.63,Default,,0,0,0,,Қарумен шабуыл жасау қауіпті, қоян-қолтық ұрыс
Dialogue: 0,0:43:54.63,0:43:57.73,Default,,0,0,0,,Маған айтпасаң да!
Dialogue: 0,0:44:00.07,0:44:04.24,Default,,0,0,0,,Морой, маған күшіңді бер! Жарайды Джессика
Dialogue: 0,0:44:04.24,0:44:08.74,Default,,0,0,0,,Нәзік күштің супер бұрылысы
Dialogue: 0,0:44:13.78,0:44:16.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:19.19,0:44:21.49,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:44:24.69,0:44:27.43,Default,,0,0,0,,Сынғыштық дегеніміз не? Қызық
Dialogue: 0,0:44:27.43,0:44:34.00,Default,,0,0,0,,Бірақ жастар әрқашан ең осал болып табылады.
Dialogue: 0,0:44:34.00,0:44:36.90,Default,,0,0,0,,Пайдасыз шайқастарды болдырмау
Dialogue: 0,0:44:36.90,0:44:40.17,Default,,0,0,0,,Қуаттың абсолютті айырмашылығын еске сала кетейін.
Dialogue: 0,0:44:40.17,0:44:44.01,Default,,0,0,0,,Бұл жолы керемет бұрылыс!
Dialogue: 0,0:44:44.01,0:44:46.31,Default,,0,0,0,,Енді ешқашан соқыр болмаңыз
Dialogue: 0,0:44:46.31,0:44:48.31,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:44:51.45,0:44:54.05,Default,,0,0,0,,Әй, Гепард!
Dialogue: 0,0:44:56.39,0:45:00.66,Default,,0,0,0,,Біріктірілмеген бе? Молой ертеректе есеңгіреп есінен танып қалды.
Dialogue: 0,0:45:00.66,0:45:03.53,Default,,0,0,0,,Автопилотта ұшатын векторлық Chiron
Dialogue: 0,0:45:03.53,0:45:07.10,Default,,0,0,0,,Мен Mikono элементін өзгертуге барамын
Dialogue: 0,0:45:07.10,0:45:09.47,Default,,0,0,0,,Кайен Амата Микономен біріктіріледі
Dialogue: 0,0:45:09.47,0:45:12.37,Default,,0,0,0,,Неліктен Джессика резервтік көшірме?
Dialogue: 0,0:45:12.37,0:45:14.98,Default,,0,0,0,,Бүгін сізге байсалдылық жетіспеді.
Dialogue: 0,0:45:14.98,0:45:19.28,Default,,0,0,0,,Неге олай істейсің?
Dialogue: 0,0:45:19.28,0:45:22.78,Default,,0,0,0,,Амата-кун, Кайен, біріктірейік!
Dialogue: 0,0:45:25.49,0:45:28.06,Default,,0,0,0,,Жау бізге қарай келе жатыр.
Dialogue: 0,0:45:28.06,0:45:33.06,Default,,0,0,0,,Ұрлаушының қозғалысы Сіз шабуылдан басқа ниетті сезінесіз.
Dialogue: 0,0:45:38.33,0:45:41.67,Default,,0,0,0,,Сіз байланыс желісін үздіңіз! не?
Dialogue: 0,0:45:41.67,0:45:44.04,Default,,0,0,0,,Вега лордтары
Dialogue: 0,0:45:44.04,0:45:48.98,Default,,0,0,0,,Мен Изумо Камуроги, Альтеа әлемінің жоғарғы көшбасшысымын.
Dialogue: 0,0:45:48.98,0:45:52.18,Default,,0,0,0,,Мен сіздің командиріңізбен сөйлескім келеді.
Dialogue: 0,0:45:52.18,0:45:57.99,Default,,0,0,0,,Жоғарғы басшы? Бұл адам?
Dialogue: 0,0:45:57.99,0:46:02.36,Default,,0,0,0,,Клэр Дросера Мен Нео Диваның командирімін.
Dialogue: 0,0:46:02.36,0:46:07.19,Default,,0,0,0,,Командир де әйел ме?
Dialogue: 0,0:46:07.19,0:46:11.03,Default,,0,0,0,,Әйелдердің көпшілігі жанжалды ұнатпайды ма?
Dialogue: 0,0:46:11.03,0:46:14.00,Default,,0,0,0,,Иә, солай айтуға болады, бірақ
Dialogue: 0,0:46:14.00,0:46:18.14,Default,,0,0,0,,Кейде әйелдер күштірек болады.
Dialogue: 0,0:46:18.14,0:46:22.14,Default,,0,0,0,,Мүмкін ең күшті сирек кездесетін Иглер
Dialogue: 0,0:46:22.14,0:46:26.68,Default,,0,0,0,,Сондықтан бізге қажет
Dialogue: 0,0:46:26.68,0:46:30.58,Default,,0,0,0,,Ең күшті сирек кездесетін иглер?
Dialogue: 0,0:46:30.58,0:46:35.69,Default,,0,0,0,,Менің бұл жерге зиян келтіру ниетім жоқ.
Dialogue: 0,0:46:35.69,0:46:40.23,Default,,0,0,0,,Егер біз Риа Игглерді өз әлемімізге қарсы алсақ.
Dialogue: 0,0:46:40.23,0:46:43.63,Default,,0,0,0,,Бұл қолайлы ма? күт
Dialogue: 0,0:46:43.63,0:46:45.57,Default,,0,0,0,,Төраға
Dialogue: 0,0:46:45.57,0:46:49.94,Default,,0,0,0,,Диалог жолы ашылу мүмкіндігі болса
Dialogue: 0,0:46:49.94,0:46:52.64,Default,,0,0,0,,Фудо сонда болса ше...
Dialogue: 0,0:46:52.64,0:46:59.11,Default,,0,0,0,,А, Джессиканың векторы ұрлаушыға қарай бет алды.
Dialogue: 0,0:46:59.11,0:47:02.98,Default,,0,0,0,,Әйел алам десең, барамын.
Dialogue: 0,0:47:02.98,0:47:07.59,Default,,0,0,0,,Осылайша жағдай өзгеруі мүмкін!
Dialogue: 0,0:47:07.59,0:47:10.16,Default,,0,0,0,,Бұл ұшақ...
Dialogue: 0,0:47:10.16,0:47:12.86,Default,,0,0,0,,Сирек кездесетін иглярлық реакция!
Dialogue: 0,0:47:18.57,0:47:22.27,Default,,0,0,0,,Тоқта, Джессика, өзіңе жақсырақ қара.
Dialogue: 0,0:47:22.27,0:47:25.54,Default,,0,0,0,,Дәл қазір өзіңізді шарасыз сезінесіз!
Dialogue: 0,0:47:25.54,0:47:27.61,Default,,0,0,0,,Жоқ, мен
Dialogue: 0,0:47:27.61,0:47:31.71,Default,,0,0,0,,Мен Риа Иглардың берілуге дайын екенін көрдім.
Dialogue: 0,0:47:31.71,0:47:34.75,Default,,0,0,0,,Түсіру
Dialogue: 0,0:47:34.75,0:47:41.39,Default,,0,0,0,,GO Aquarion!
Dialogue: 0,0:47:41.39,0:47:45.96,Default,,0,0,0,,Aquarion EVOL
Dialogue: 0,0:47:45.96,0:47:48.43,Default,,0,0,0,,Ха, ұшатын механикалық періште?
Dialogue: 0,0:47:48.43,0:47:51.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:54.87,0:48:00.01,Default,,0,0,0,,Бұл сезім оны басқарады...
Dialogue: 0,0:48:00.01,0:48:03.61,Default,,0,0,0,,Оны тексеруге қалай қарайсыз? Изумо
Dialogue: 0,0:48:03.61,0:48:07.51,Default,,0,0,0,,Сол көздермен
Dialogue: 0,0:48:15.12,0:48:19.82,Default,,0,0,0,,Анашым, бұл неге аян?
Dialogue: 0,0:48:21.90,0:48:27.60,Default,,0,0,0,,Аматаның жүрегінің жіптерін біреу ойнақтап жатыр.
Dialogue: 0,0:48:27.60,0:48:31.77,Default,,0,0,0,,Таза, тәтті, ащы
Dialogue: 0,0:48:31.77,0:48:35.51,Default,,0,0,0,,Микадждың әжімдері ыңғайсыз
Dialogue: 0,0:48:35.51,0:48:38.78,Default,,0,0,0,,Бірақ механикалық періште қозғалуды тоқтатты.
Dialogue: 0,0:48:38.78,0:48:42.45,Default,,0,0,0,,Күмән жоқ...
Dialogue: 0,0:48:42.45,0:48:44.79,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:48:44.79,0:48:49.19,Default,,0,0,0,,Амата Джессика жаудың алдында!
Dialogue: 0,0:48:49.19,0:48:53.09,Default,,0,0,0,,Мен Джессиканы ешқашан жібермеймін!
Dialogue: 0,0:48:56.60,0:49:01.44,Default,,0,0,0,,Асықпа, Джессика
Dialogue: 0,0:49:01.44,0:49:05.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:05.64,0:49:07.94,Default,,0,0,0,,ＭＩＸ！ ＭＩＸ
Dialogue: 0,0:49:07.94,0:49:10.34,Default,,0,0,0,,ＭＩＸ！
Dialogue: 0,0:49:14.45,0:49:20.89,Default,,0,0,0,,Сізге құтылуға мүмкіндік бермейтін шексіз соққы!
Dialogue: 0,0:49:20.89,0:49:25.59,Default,,0,0,0,,Қанатты бала, біз тағы кездесерміз.
Dialogue: 0,0:49:34.34,0:49:37.81,Default,,0,0,0,,Сонымен... менің орнымда ма?
Dialogue: 0,0:49:37.81,0:49:40.91,Default,,0,0,0,,ＭＩＸ… ＭＩＸ！
Dialogue: 0,0:49:58.63,0:50:01.93,Default,,0,0,0,,ＭＩＸ！
Dialogue: 0,0:51:32.35,0:51:34.86,Default,,0,0,0,,Мен ауырғаным үшін өзімді жек көрдім.
Dialogue: 0,0:51:34.86,0:51:39.69,Default,,0,0,0,,Бірақ менің ойымша, бұл біз ойланбастан жалғастырамыз деп қорқамыз.
Dialogue: 0,0:51:39.69,0:51:43.79,Default,,0,0,0,,Менің міндетім қазір бірінші қадамды жасау.
Dialogue: 0,0:51:45.29,0:51:51.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory