Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.72,0:00:45.09,Default,,0,0,0,,Әйел Альтеяға барса, ол не өледі, не еркек болады.
Dialogue: 0,0:00:45.09,0:00:47.02,Default,,0,0,0,,Сонда MIX туралы не деуге болады?
Dialogue: 0,0:00:47.02,0:00:49.93,Default,,0,0,0,,Бұл біз білетін MIX емес еді.
Dialogue: 0,0:00:49.93,0:00:52.83,Default,,0,0,0,,Мен тіпті есте сақтау қабілетімнен айырылдым.
Dialogue: 0,0:00:52.83,0:00:55.20,Default,,0,0,0,,Джессика мен Юноха қауіпсіз болды ма?
Dialogue: 0,0:00:55.20,0:00:57.17,Default,,0,0,0,,Мен қазір жақсымын.
Dialogue: 0,0:00:57.17,0:01:00.57,Default,,0,0,0,,Медициналық тексерудің қорытындысы бойынша ауытқулар анықталған жоқ.
Dialogue: 0,0:01:00.57,0:01:03.77,Default,,0,0,0,,Егер біз сол жерде сәл ұзағырақ болсақ, біз де болар едік.
Dialogue: 0,0:01:08.78,0:01:10.81,Default,,0,0,0,,Миконо қайтып келмеді ме?
Dialogue: 0,0:01:10.81,0:01:15.45,Default,,0,0,0,,Мен әлі де командир Фудоны іздеуге шықтым.
Dialogue: 0,0:01:15.45,0:01:17.39,Default,,0,0,0,,Шрейд қалай?
Dialogue: 0,0:01:17.39,0:01:21.62,Default,,0,0,0,,Дағдарыс әзірге аяқталды, бірақ ол мүлдем қауіпсіз сияқты.
Dialogue: 0,0:01:21.62,0:01:24.09,Default,,0,0,0,,Боқ, бас қолбасшы жоқ.
Dialogue: 0,0:01:24.09,0:01:27.00,Default,,0,0,0,,Шраденің де күші таусылып, ұйықтап қалды.
Dialogue: 0,0:01:27.00,0:01:29.53,Default,,0,0,0,,Енді жақсы емес пе, Нео Дива?
Dialogue: 0,0:01:29.53,0:01:33.07,Default,,0,0,0,,Оңай берілме
Dialogue: 0,0:01:33.07,0:01:35.40,Default,,0,0,0,,Бұл соңы емес.
Dialogue: 0,0:01:35.40,0:01:39.18,Default,,0,0,0,,Өзіңізді көтеріп, Альтеаға қайта отырыңыз.
Dialogue: 0,0:01:39.18,0:01:43.08,Default,,0,0,0,,Энди MIX-ті толығымен құтқарады
Dialogue: 0,0:01:47.45,0:01:49.75,Default,,0,0,0,,Энди, жақсысың ба?
Dialogue: 0,0:01:49.75,0:01:53.62,Default,,0,0,0,,Жарайды, мен ешқашан берілмеймін
Dialogue: 0,0:01:53.62,0:01:56.56,Default,,0,0,0,,MIX қайтарылғанша қалағаныңызша рет
Dialogue: 0,0:01:56.56,0:01:59.06,Default,,0,0,0,,Мен сізге қанша қаласаңыз, сонша еремін.
Dialogue: 0,0:03:42.97,0:03:45.57,Default,,0,0,0,,Бұл дерлік болды
Dialogue: 0,0:03:45.57,0:03:48.97,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:03:48.97,0:03:55.34,Default,,0,0,0,,Екі дүние ойнаған махаббаттың шекті әуені
Dialogue: 0,0:03:55.34,0:03:57.98,Default,,0,0,0,,Енді сөйлеме
Dialogue: 0,0:03:57.98,0:04:02.79,Default,,0,0,0,,Дәл қазір денемді демалу – менің басымдылығым.
Dialogue: 0,0:04:02.79,0:04:06.19,Default,,0,0,0,,Өмірімнің оты сөнгенше
Dialogue: 0,0:04:06.19,0:04:10.43,Default,,0,0,0,,Ән аяқтала ма?
Dialogue: 0,0:04:10.43,0:04:16.37,Default,,0,0,0,,Сіз маған үмітсіздік туралы болжамыңызды айта аласыз ба?
Dialogue: 0,0:04:16.37,0:04:19.27,Default,,0,0,0,,Үмітсіздіктің болашағы т.б.
Dialogue: 0,0:04:19.27,0:04:22.14,Default,,0,0,0,,Тек үмітсіздікте
Dialogue: 0,0:04:22.14,0:04:26.48,Default,,0,0,0,,Кейбір әуендер әдемі естіледі.
Dialogue: 0,0:04:26.48,0:04:29.98,Default,,0,0,0,,Шрейд
Dialogue: 0,0:04:29.98,0:04:36.22,Default,,0,0,0,,Ән біткен соң, менімен бірге ойнайсың ба, менің жан досым?
Dialogue: 0,0:04:36.22,0:04:39.76,Default,,0,0,0,,Командир Фудо қашан оралады?
Dialogue: 0,0:04:39.76,0:04:43.06,Default,,0,0,0,,Мен де Миконодан ештеңе естіген жоқпын.
Dialogue: 0,0:04:43.06,0:04:46.46,Default,,0,0,0,,Біреу, Суоми ханым?
Dialogue: 0,0:04:46.46,0:04:50.33,Default,,0,0,0,,No. Түнде жоғары калориялы тағамдар
Dialogue: 0,0:04:50.33,0:04:55.54,Default,,0,0,0,,көремін. Дүрбелеңнің қажеті жоқ.
Dialogue: 0,0:04:55.54,0:04:58.44,Default,,0,0,0,,Фуду міндетті түрде қайтып келеді
Dialogue: 0,0:04:58.44,0:05:01.44,Default,,0,0,0,,Жаратылыс мифімен
Dialogue: 0,0:05:06.05,0:05:11.75,Default,,0,0,0,,Сен жасыл шашсың
Dialogue: 0,0:05:11.75,0:05:18.23,Default,,0,0,0,,Өлшемді қақпаны ашуға қиналсам да, бұл ұят.
Dialogue: 0,0:05:18.23,0:05:20.23,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:05:25.97,0:05:28.50,Default,,0,0,0,,Мен уәдемді орындаймын
Dialogue: 0,0:05:28.50,0:05:30.47,Default,,0,0,0,,Тіпті ұйықтап қалғаннан кейін де, кем дегенде—
Dialogue: 0,0:05:30.47,0:05:34.11,Default,,0,0,0,,Менің қандай уәдем бар?
Dialogue: 0,0:05:34.11,0:05:37.45,Default,,0,0,0,,Оны әлі есте сақтаудың қажеті жоқ.
Dialogue: 0,0:05:37.45,0:05:41.05,Default,,0,0,0,,Уақыты келгенде орындалады
Dialogue: 0,0:05:55.90,0:05:57.90,Default,,0,0,0,,ＭＩＸ…
Dialogue: 0,0:06:02.61,0:06:08.04,Default,,0,0,0,,Енді ойлап қарасам, мен оның үлкен жарылысын сағындым деп ойлаймын.
Dialogue: 0,0:06:08.04,0:06:13.18,Default,,0,0,0,,Бұл үлкен жарылыс болған жоқ.
Dialogue: 0,0:06:13.18,0:06:15.88,Default,,0,0,0,,Энди, сен мұнда не істеп жүрсің?
Dialogue: 0,0:06:15.88,0:06:21.22,Default,,0,0,0,,Отырмасам, көңілім түсіп кетеді.
Dialogue: 0,0:06:21.22,0:06:25.09,Default,,0,0,0,,Бұл MIX толтырған тесік
Dialogue: 0,0:06:25.09,0:06:30.90,Default,,0,0,0,,А, ол жерлеген жердің молекулалық құрылымында саңылау жоқ.
Dialogue: 0,0:06:30.90,0:06:36.40,Default,,0,0,0,,Сондықтан менің күшім бақылаудан шығып кетсе де, мен өз бетіммен құламаймын.
Dialogue: 0,0:06:38.44,0:06:40.38,Default,,0,0,0,,Энди
Dialogue: 0,0:06:40.38,0:06:42.34,Default,,0,0,0,,Сәлем Амата
Dialogue: 0,0:06:42.34,0:06:47.22,Default,,0,0,0,,MIX-ті қайтарсам да, мен...
Dialogue: 0,0:06:47.22,0:06:53.92,Default,,0,0,0,,Еркек болып кеткен MIX-ті бұрынғыдай сүйе аламын ба?
Dialogue: 0,0:07:09.04,0:07:13.84,Default,,0,0,0,,Не, мен оны иіскемеймін деп ойладым, сонда сен бе?
Dialogue: 0,0:07:18.71,0:07:20.68,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:20.68,0:07:23.28,Default,,0,0,0,,Неге қашып кеттің?
Dialogue: 0,0:07:27.89,0:07:30.53,Default,,0,0,0,,Біз бірміз.
Dialogue: 0,0:07:30.53,0:07:32.59,Default,,0,0,0,,Аполлон…
Dialogue: 0,0:07:32.59,0:07:35.09,Default,,0,0,0,,Міне, Аполлон.
Dialogue: 0,0:07:37.87,0:07:42.74,Default,,0,0,0,,Ақыры сені кездестірдім, мені алып кетуге келдің.
Dialogue: 0,0:07:42.74,0:07:48.21,Default,,0,0,0,,Миконо-сан... қарғыс атқан әйел, біз Аполлос емеспіз.
Dialogue: 0,0:07:48.21,0:07:50.21,Default,,0,0,0,,Амагра
Dialogue: 0,0:07:54.45,0:07:57.42,Default,,0,0,0,,Күте тұрыңыз, Миконо-сан.
Dialogue: 0,0:07:57.42,0:07:59.52,Default,,0,0,0,,Тоқта, қарғыс атқан әйел!
Dialogue: 0,0:08:04.06,0:08:06.53,Default,,0,0,0,,Тоқта, тоқта!
Dialogue: 0,0:08:06.53,0:08:10.83,Default,,0,0,0,,Қарғыс атқыр қыз, сен де бізге қосыл.
Dialogue: 0,0:08:10.83,0:08:12.90,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:08:12.90,0:08:17.31,Default,,0,0,0,,Амата-кун, тоқтат.
Dialogue: 0,0:08:17.31,0:08:20.21,Default,,0,0,0,,Жыл!
Dialogue: 0,0:08:29.72,0:08:31.72,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:08:44.90,0:08:46.90,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:48.80,0:08:54.91,Default,,0,0,0,,Мен қолдарымды бір-біріне соқтым. Олардың арасында не бар?
Dialogue: 0,0:08:54.91,0:08:59.15,Default,,0,0,0,,Не? Оң қол мен сол қол, періште және адам
Dialogue: 0,0:08:59.15,0:09:05.45,Default,,0,0,0,,Ер мен әйел, Инь мен Ян, арасында не бар?
Dialogue: 0,0:09:08.76,0:09:12.46,Default,,0,0,0,,Оң және сол қолдың арасындағы заттар
Dialogue: 0,0:09:19.37,0:09:22.30,Default,,0,0,0,,Қараңғылық?
Dialogue: 0,0:09:22.30,0:09:26.40,Default,,0,0,0,,Онда ештеңе болмаса да, жылы
Dialogue: 0,0:09:28.68,0:09:32.98,Default,,0,0,0,,Мен мұны бұрын бір жерден естіген сияқтымын.
Dialogue: 0,0:09:42.09,0:09:47.40,Default,,0,0,0,,Бір кездері аспан мен жер әлі ажырамаған кезде
Dialogue: 0,0:09:47.40,0:09:51.40,Default,,0,0,0,,Бұл дүние әдемі нұрға толы еді
Dialogue: 0,0:09:51.40,0:09:53.57,Default,,0,0,0,,Гүлдер ән салады
Dialogue: 0,0:09:53.57,0:09:57.37,Default,,0,0,0,,Ұшатын жәндіктер мен киелі аңдар махаббатты сыбырлайды
Dialogue: 0,0:09:57.37,0:10:02.21,Default,,0,0,0,,Періштелер жұлдыздардан жоғары махаббат жасайды
Dialogue: 0,0:10:02.21,0:10:04.21,Default,,0,0,0,,Бірақ қорқынышты
Dialogue: 0,0:10:04.21,0:10:09.95,Default,,0,0,0,,Сол періштелер адамдарды аулады.
Dialogue: 0,0:10:09.95,0:10:15.62,Default,,0,0,0,,Кісі өлтіру періштесі атанған Аполлониймен жанжалда.
Dialogue: 0,0:10:15.62,0:10:21.02,Default,,0,0,0,,Сериан деген қыз танысып, ғашық болады.
Dialogue: 0,0:10:23.10,0:10:28.60,Default,,0,0,0,,Аполлоний достарына опасыздық жасап, адамдар жағына шықты.
Dialogue: 0,0:10:30.84,0:10:34.71,Default,,0,0,0,,Ақырында күнәкар Аполлоний қанаттарын тастады.
Dialogue: 0,0:10:34.71,0:10:43.09,Default,,0,0,0,,Адамдармен үлкен күш, механикалық періштелерді басқаратын және күресетін періштелер.
Dialogue: 0,0:10:43.09,0:10:46.96,Default,,0,0,0,,Бұл Жаратылыс кітабында жазылған оқиға
Dialogue: 0,0:10:46.96,0:10:50.63,Default,,0,0,0,,10 000 және 2000 жыл бұрынғы шындық
Dialogue: 0,0:10:50.63,0:10:54.80,Default,,0,0,0,,Жоқ, мен өткенге тағы бір рет оралдым.
Dialogue: 0,0:10:54.80,0:10:59.57,Default,,0,0,0,,Бұл 20 000 және 4 000 жыл бұрынғы оқиға.
Dialogue: 0,0:10:59.57,0:11:07.04,Default,,0,0,0,,Тағдыр бұрыла береді, ал мифтер тағы да айналады.
Dialogue: 0,0:11:07.04,0:11:10.74,Default,,0,0,0,,Тағы да аңыз...
Dialogue: 0,0:11:19.59,0:11:22.19,Default,,0,0,0,,Sora Amata Сіз нені білдіреді?
Dialogue: 0,0:11:22.19,0:11:25.09,Default,,0,0,0,,Сорттік бұйрық шығарғаным есімде жоқ.
Dialogue: 0,0:11:25.09,0:11:27.43,Default,,0,0,0,,Мен Миконо-санды іздеймін.
Dialogue: 0,0:11:27.43,0:11:29.67,Default,,0,0,0,,Біз ерікті әрекеттерге жол бермейміз.
Dialogue: 0,0:11:29.67,0:11:33.40,Default,,0,0,0,,Мен Миконо мені көмекке шақырып жатқандай сезінемін.
Dialogue: 0,0:11:33.40,0:11:36.00,Default,,0,0,0,,Сондықтан мен тез жүруім керек.
Dialogue: 0,0:11:45.75,0:11:47.68,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:11:47.68,0:11:51.28,Default,,0,0,0,,Жақындарыңызды ұзататын кез келді...
Dialogue: 0,0:11:55.96,0:11:59.83,Default,,0,0,0,,Сүйіктіңе бар
Dialogue: 0,0:11:59.83,0:12:04.17,Default,,0,0,0,,Ал күн қанатының астында
Dialogue: 0,0:12:04.17,0:12:09.77,Default,,0,0,0,,Қымбатты жарым, енді неге оянбайсың?
Dialogue: 0,0:12:16.65,0:12:20.58,Default,,0,0,0,,Амата... Вектор Зед байланыссыз қалды.
Dialogue: 0,0:12:20.58,0:12:22.75,Default,,0,0,0,,Оның орны да белгісіз
Dialogue: 0,0:12:22.75,0:12:26.62,Default,,0,0,0,,Үмітсіздік болжамымен Аматаның қайда бара жатқанын анықтай аласыз ба?
Dialogue: 0,0:12:26.62,0:12:28.62,Default,,0,0,0,,Сынап көрейін
Dialogue: 0,0:12:44.94,0:12:46.94,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:55.65,0:12:58.95,Default,,0,0,0,,Миконо-санмен алғаш танысқан қала
Dialogue: 0,0:13:01.96,0:13:05.16,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:34.99,0:13:37.43,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:13:37.43,0:13:42.43,Default,,0,0,0,,Жаратылыс кітабында жазылған жарық пен қараңғылықтың арасындағы алшақтық
Dialogue: 0,0:13:45.27,0:13:50.41,Default,,0,0,0,,Кабина бос снаряд, ақымақ.
Dialogue: 0,0:13:50.41,0:13:53.28,Default,,0,0,0,,Аматаны алғаш көрген қала
Dialogue: 0,0:13:53.28,0:13:57.28,Default,,0,0,0,,Ал бірінші біріккен қала
Dialogue: 0,0:14:05.72,0:14:08.69,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:14:08.69,0:14:13.56,Default,,0,0,0,,Барлығы қайда кетті?
Dialogue: 0,0:14:13.56,0:14:18.70,Default,,0,0,0,,Мен бұл шайқастан кейін қатаң бақылау аймағы болып тағайындалғанын естідім.
Dialogue: 0,0:14:18.70,0:14:21.07,Default,,0,0,0,,Мен бұлай болады деп күткен жоқпын.
Dialogue: 0,0:14:21.07,0:14:23.57,Default,,0,0,0,,Миконо да сонда ма? осы жерде
Dialogue: 0,0:14:23.57,0:14:26.94,Default,,0,0,0,,Менің болжамым осылай дейді.
Dialogue: 0,0:14:26.94,0:14:30.85,Default,,0,0,0,,Амата Микононы қуып келеді
Dialogue: 0,0:14:30.85,0:14:34.25,Default,,0,0,0,,Әзірге бөлініп, ізденейік.
Dialogue: 0,0:14:44.06,0:14:46.06,Default,,0,0,0,,Қария
Dialogue: 0,0:15:13.42,0:15:16.16,Default,,0,0,0,,Неге сонша?
Dialogue: 0,0:15:16.16,0:15:19.46,Default,,0,0,0,,Мен емес. ДДСҰ?
Dialogue: 0,0:15:21.96,0:15:24.40,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:15:24.40,0:15:29.24,Default,,0,0,0,,Неліктен Микадж сізге мұнда баруды айтты?
Dialogue: 0,0:15:29.24,0:15:32.54,Default,,0,0,0,,Бірақ бұл иіс
Dialogue: 0,0:15:32.54,0:15:35.81,Default,,0,0,0,,Баяғыда күмән жоқ
Dialogue: 0,0:15:35.81,0:15:38.31,Default,,0,0,0,,Мен бұл қалада бұрын болғанмын.
Dialogue: 0,0:16:00.94,0:16:06.24,Default,,0,0,0,,Амата Амата Амата…
Dialogue: 0,0:16:24.96,0:16:30.66,Default,,0,0,0,,Жадының мөрі ақыры бұзылған сияқты.
Dialogue: 0,0:16:35.34,0:16:38.94,Default,,0,0,0,,Суқұйғыштар билейтін аспан
Dialogue: 0,0:16:57.06,0:16:59.06,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:17:03.83,0:17:05.83,Default,,0,0,0,,Миконо-сан!
Dialogue: 0,0:17:12.14,0:17:17.55,Default,,0,0,0,,Амата Джессика сен не үшін келдің?
Dialogue: 0,0:17:17.55,0:17:21.15,Default,,0,0,0,,Аматаның артынан қудым.
Dialogue: 0,0:17:23.82,0:17:29.52,Default,,0,0,0,,Төраға Клэрдің бұйрығымен Кайенмен бірге.
Dialogue: 0,0:17:29.52,0:17:33.62,Default,,0,0,0,,Кешіріңіз, мен сіздің тапсырысыңызды елемедім.
Dialogue: 0,0:17:36.67,0:17:40.17,Default,,0,0,0,,Бұл қала енді қатаң бақылау аймағы ретінде белгіленген.
Dialogue: 0,0:17:40.17,0:17:42.47,Default,,0,0,0,,Эвакуация туралы бұйрық шығарылды.
Dialogue: 0,0:17:42.47,0:17:46.78,Default,,0,0,0,,Көремін, қарттар да.
Dialogue: 0,0:17:46.78,0:17:50.65,Default,,0,0,0,,Неліктен бұйрықты бұзып, бұл қалашыққа келдің?
Dialogue: 0,0:17:50.65,0:17:53.42,Default,,0,0,0,,Мен білмеймін, бірақ...
Dialogue: 0,0:17:53.42,0:17:55.35,Default,,0,0,0,,Сіз оны қалай тапқаныңызды білсем бола ма?
Dialogue: 0,0:17:55.35,0:17:58.85,Default,,0,0,0,,Маған Миконо қоңырау шалып тұрғандай болды.
Dialogue: 0,0:18:03.22,0:18:06.46,Default,,0,0,0,,Мен сені күтемін
Dialogue: 0,0:18:06.46,0:18:11.26,Default,,0,0,0,,10 000 жыл және 2000 жыл болса да
Dialogue: 0,0:18:16.60,0:18:20.48,Default,,0,0,0,,Амата осы кинотеатрда жұмыс істеді, солай ма?
Dialogue: 0,0:18:20.48,0:18:24.35,Default,,0,0,0,,Міне, мен Микономен кездестім.
Dialogue: 0,0:18:24.35,0:18:27.32,Default,,0,0,0,,Джессика…
Dialogue: 0,0:18:27.32,0:18:31.62,Default,,0,0,0,,Сәлем Амата Келесі
Dialogue: 0,0:18:31.62,0:18:35.36,Default,,0,0,0,,Келесі 12 000 жылдан кейін
Dialogue: 0,0:18:35.36,0:18:37.36,Default,,0,0,0,,Өйткені ол
Dialogue: 0,0:18:43.77,0:18:49.57,Default,,0,0,0,,Бізге адам қолымен жасалған жалған әңгімелер керек емес.
Dialogue: 0,0:18:49.57,0:18:54.97,Default,,0,0,0,,Жақында әлемде шынайы мифтер қайта жаңғырады.
Dialogue: 0,0:18:58.28,0:19:03.12,Default,,0,0,0,,Джессика, қаш!
Dialogue: 0,0:19:03.12,0:19:05.92,Default,,0,0,0,,Сіз не істеп жатырсыз? Асықшы!
Dialogue: 0,0:19:05.92,0:19:07.92,Default,,0,0,0,,Иә
Dialogue: 0,0:19:14.16,0:19:19.07,Default,,0,0,0,,Қане, жүгіріңдер, ғашықтық аңдар.
Dialogue: 0,0:19:19.07,0:19:21.67,Default,,0,0,0,,Уәде етілген жерге
Dialogue: 0,0:19:35.42,0:19:37.42,Default,,0,0,0,,Амата!
Dialogue: 0,0:19:40.26,0:19:42.26,Default,,0,0,0,,Джессика!
Dialogue: 0,0:19:44.96,0:19:46.96,Default,,0,0,0,,Джессика!
Dialogue: 0,0:19:49.73,0:19:52.97,Default,,0,0,0,,Шүкір, бұл мүмкін емес, мен шыға алмаймын.
Dialogue: 0,0:19:52.97,0:19:55.07,Default,,0,0,0,,Берілмеңіз
Dialogue: 0,0:19:58.67,0:20:01.58,Default,,0,0,0,,Менде бәрі жақсы, Амата, қаш.
Dialogue: 0,0:20:01.58,0:20:06.41,Default,,0,0,0,,Жоқ, мен Джессиканы артта қалдыра алмаймын.
Dialogue: 0,0:20:06.41,0:20:08.41,Default,,0,0,0,,Амата
Dialogue: 0,0:20:14.16,0:20:18.16,Default,,0,0,0,,Рахмет саған Амат
Dialogue: 0,0:20:30.04,0:20:32.34,Default,,0,0,0,,Жоқ, Джессика
Dialogue: 0,0:20:41.65,0:20:43.65,Default,,0,0,0,,Джессика!
Dialogue: 0,0:20:47.46,0:20:49.46,Default,,0,0,0,,Амата, мен сені іздедім.
Dialogue: 0,0:21:05.67,0:21:11.18,Default,,0,0,0,,Cayenne Sasanqua Vector Chiron күткеніңізге рахмет
Dialogue: 0,0:21:11.18,0:21:16.75,Default,,0,0,0,,Ән біткен соң, бірге ойнауға уәде бересің, ең жақын досым.
Dialogue: 0,0:21:16.75,0:21:20.35,Default,,0,0,0,,Тоқта, денелерді осылай біріктірсек, өлеміз...
Dialogue: 0,0:21:23.59,0:21:27.40,Default,,0,0,0,,Менің ойланатын уақытым жоқ, кеттік.
Dialogue: 0,0:21:27.40,0:21:32.00,Default,,0,0,0,,Құрбандық бірлестігі Go Aquarion!
Dialogue: 0,0:21:36.04,0:21:38.27,Default,,0,0,0,,Сізге хабарласыңыз
Dialogue: 0,0:21:38.27,0:21:40.21,Default,,0,0,0,,Рахмет, қымбатты досым
Dialogue: 0,0:21:40.21,0:21:43.01,Default,,0,0,0,,О, шіріп жатыр!
Dialogue: 0,0:21:45.55,0:21:49.65,Default,,0,0,0,,Акварион спада!
Dialogue: 0,0:22:02.66,0:22:06.16,Default,,0,0,0,,Мен таптым, Йовамуши Амата
Dialogue: 0,0:22:08.20,0:22:10.20,Default,,0,0,0,,Сіз...
Dialogue: 0,0:22:16.51,0:22:21.38,Default,,0,0,0,,Күннің қанаттары енді оянғалы тұр
Dialogue: 0,0:22:21.38,0:22:25.75,Default,,0,0,0,,Мен кешірім сұрауым керек
Dialogue: 0,0:22:25.75,0:22:31.56,Default,,0,0,0,,Мен қорқынышты нәрсе жасадым, мені кешіріңіз.
Dialogue: 0,0:22:31.56,0:22:36.06,Default,,0,0,0,,Сіз оны сол жолы көрдіңіз...
Dialogue: 0,0:22:36.06,0:22:39.96,Default,,0,0,0,,А, мен бұл елес пе деп ойладым.
Dialogue: 0,0:22:58.85,0:23:03.55,Default,,0,0,0,,Әлсіз Аматаның қолынан ештеңе келмеді.
Dialogue: 0,0:23:09.50,0:23:12.40,Default,,0,0,0,,Өйткені, сіз...
Dialogue: 0,0:23:12.40,0:23:15.34,Default,,0,0,0,,Иә.
Dialogue: 0,0:23:15.34,0:23:17.74,Default,,0,0,0,,Басқа мен Басқа мен
Dialogue: 0,0:24:56.90,0:25:00.78,Default,,0,0,0,,Ум, Кагура-кун, сен қыздарға қалай қарайсың?
Dialogue: 0,0:25:00.78,0:25:03.48,Default,,0,0,0,,Мен қателесіп жатырмын деп ойлаймын.
Dialogue: 0,0:25:03.48,0:25:08.32,Default,,0,0,0,,Мен сені жақсы көретіндіктен, бұл шын мәнінде жылырақ сезім.
Dialogue: 0,0:25:08.32,0:25:10.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:49.68,0:27:53.78,Default,,0,0,0,,Соңғы кезең - шақыру
Dialogue: 0,0:29:47.73,0:29:50.63,Default,,0,0,0,,Бұл үн, мына әуен
Dialogue: 0,0:29:50.63,0:29:53.53,Default,,0,0,0,,Қорытынды қозғалысқа сәйкес
Dialogue: 0,0:29:53.53,0:29:58.04,Default,,0,0,0,,Көбірек, көбірек ойна, Акварион
Dialogue: 0,0:29:58.04,0:30:02.41,Default,,0,0,0,,Шрейд, бұл күш сіздің денеңіздің қай жерінде әлі бар?
Dialogue: 0,0:30:02.41,0:30:07.62,Default,,0,0,0,,Таңғажайып, талғампаз және нәзік, бірақ ыстық және қарқынды.
Dialogue: 0,0:30:07.62,0:30:10.22,Default,,0,0,0,,Жүрегімнің түбінде жаңғырады
Dialogue: 0,0:30:10.22,0:30:13.12,Default,,0,0,0,,Бұл мен бірінші рет
Dialogue: 0,0:30:13.12,0:30:16.56,Default,,0,0,0,,Элемент костюмі жоқ Schrade
Dialogue: 0,0:30:16.56,0:30:20.86,Default,,0,0,0,,Жалаңаш теріңізді ашуға батылдық таныту арқылы сіздің сезімдеріңіз одан да өткір болады.
Dialogue: 0,0:30:20.86,0:30:25.17,Default,,0,0,0,,Дегенмен, денеге келтірілген зиян айтарлықтай болуы керек.
Dialogue: 0,0:30:25.17,0:30:28.20,Default,,0,0,0,,Нағыз шарасыз шайқас
Dialogue: 0,0:30:28.20,0:30:30.87,Default,,0,0,0,,Schrade
Dialogue: 0,0:30:30.87,0:30:35.17,Default,,0,0,0,,Менің жаным үшін ең жақсы каденза
Dialogue: 0,0:30:39.38,0:30:43.05,Default,,0,0,0,,Сол кезде көргендерім елес емес еді.
Dialogue: 0,0:30:43.05,0:30:46.29,Default,,0,0,0,,Сен менсің
Dialogue: 0,0:30:46.29,0:30:51.06,Default,,0,0,0,,Әйтеуір, алғаш танысқаннан бері иісін сезе алмадым.
Dialogue: 0,0:30:51.06,0:30:54.53,Default,,0,0,0,,Өйткені оның иісі менімен бірдей
Dialogue: 0,0:30:54.53,0:30:58.30,Default,,0,0,0,,Бұл суреттегі адам менмін
Dialogue: 0,0:30:58.30,0:31:01.04,Default,,0,0,0,,Ал сіз
Dialogue: 0,0:31:01.04,0:31:05.37,Default,,0,0,0,,Сіз бен біз бастапқыда бір адам едік.
Dialogue: 0,0:31:05.37,0:31:07.77,Default,,0,0,0,,Иә, сол күнге дейін
Dialogue: 0,0:31:09.74,0:31:12.31,Default,,0,0,0,,Мама №
Dialogue: 0,0:31:12.31,0:31:16.61,Default,,0,0,0,,Жоқ, барма.
Dialogue: 0,0:31:34.64,0:31:40.51,Default,,0,0,0,,Сол күні Аматаның тағдыры тек қана ұзай алды.
Dialogue: 0,0:31:40.51,0:31:42.71,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:31:46.18,0:31:48.82,Default,,0,0,0,,Қазір де өзгерген жоқ.
Dialogue: 0,0:31:48.82,0:31:53.35,Default,,0,0,0,,Амат – жағдай талап еткенде ештеңе істей алмайтын әлсіз.
Dialogue: 0,0:31:53.35,0:31:55.66,Default,,0,0,0,,Сонда сіз ше?
Dialogue: 0,0:31:55.66,0:31:58.23,Default,,0,0,0,,Анамды құтқара алмасам да
Dialogue: 0,0:31:58.23,0:32:02.43,Default,,0,0,0,,Сіз Альтеяға барған кезде не істедіңіз?
Dialogue: 0,0:32:02.43,0:32:04.93,Default,,0,0,0,,Өлшемдерден асып кету дұрыс.
Dialogue: 0,0:32:04.93,0:32:08.27,Default,,0,0,0,,Мен анамнан айырылдым.
Dialogue: 0,0:32:08.27,0:32:11.31,Default,,0,0,0,,Міне, мен Микаджды кездестірдім.
Dialogue: 0,0:32:11.31,0:32:17.81,Default,,0,0,0,,Қош келдің, менің екінші жартым, Қараңғылық Аматасы
Dialogue: 0,0:32:22.65,0:32:25.69,Default,,0,0,0,,Сіз Кагурасыз
Dialogue: 0,0:32:25.69,0:32:29.86,Default,,0,0,0,,Бүгіннен бастап Кагура
Dialogue: 0,0:32:29.86,0:32:36.63,Default,,0,0,0,,Менің есте сақтау қабілетім жоғалып, Микадждың тәрбиесінде болдым.
Dialogue: 0,0:32:36.63,0:32:39.87,Default,,0,0,0,,Мен қазір анамды ойламаймын.
Dialogue: 0,0:32:39.87,0:32:44.47,Default,,0,0,0,,Мен де әкем сияқты оның қайда, кім екенін де білмеймін.
Dialogue: 0,0:32:44.47,0:32:47.71,Default,,0,0,0,,Мен үшін бір ғана иіс маңызды
Dialogue: 0,0:32:47.71,0:32:50.98,Default,,0,0,0,,Аяулы әйелдің иісі
Dialogue: 0,0:32:50.98,0:32:54.98,Default,,0,0,0,,Тек нағыз Сильфи
Dialogue: 0,0:32:54.98,0:32:57.75,Default,,0,0,0,,Мен ақымақ емеспін
Dialogue: 0,0:32:57.75,0:33:01.65,Default,,0,0,0,,Мен саған Миконо-санды бермеймін.
Dialogue: 0,0:33:06.29,0:33:08.70,Default,,0,0,0,,әлсіз әлсіз
Dialogue: 0,0:33:08.70,0:33:10.66,Default,,0,0,0,,Бұл өте әлсіз
Dialogue: 0,0:33:10.66,0:33:14.24,Default,,0,0,0,,Тоқта, екеуің неге ұрысып жатырсыңдар?
Dialogue: 0,0:33:14.24,0:33:17.34,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:33:19.17,0:33:24.17,Default,,0,0,0,,Күннің қанаттары ақыры оянады, иә?
Dialogue: 0,0:33:59.08,0:34:01.15,Default,,0,0,0,,Не болды, Амата?
Dialogue: 0,0:34:01.15,0:34:04.15,Default,,0,0,0,,Маған ақымақ емес екеніңді көрсет.
Dialogue: 0,0:34:11.06,0:34:13.06,Default,,0,0,0,,Не?
Dialogue: 0,0:34:20.67,0:34:23.07,Default,,0,0,0,,Миконо-сан Сильфи
Dialogue: 0,0:34:27.27,0:34:29.27,Default,,0,0,0,,Миконо
Dialogue: 0,0:34:38.55,0:34:40.75,Default,,0,0,0,,Акварион туралы не деуге болады?
Dialogue: 0,0:34:46.06,0:34:48.00,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:34:48.00,0:34:52.50,Default,,0,0,0,,Жоғары өлшемді кванттық реакция Бұрын көл болған жер астынан
Dialogue: 0,0:35:07.21,0:35:11.45,Default,,0,0,0,,Бұл қандай дисплей? Сонымен, Aquarion резонанс тудырады ма?
Dialogue: 0,0:35:11.45,0:35:13.39,Default,,0,0,0,,Бұл ежелгі
Dialogue: 0,0:35:13.39,0:35:18.56,Default,,0,0,0,,10 000 және 2000 жыл бұрын жаңғыратын әуен
Dialogue: 0,0:35:18.56,0:35:21.86,Default,,0,0,0,,Сөз жоқ, бұл бір.
Dialogue: 0,0:35:21.86,0:35:25.76,Default,,0,0,0,,Аңызға айналған мифтік акварион
Dialogue: 0,0:35:33.47,0:35:37.68,Default,,0,0,0,,О... ақырында
Dialogue: 0,0:35:37.68,0:35:41.28,Default,,0,0,0,,Күннің қанаттары пайда болды
Dialogue: 0,0:35:50.56,0:35:54.43,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:35:54.43,0:35:58.40,Default,,0,0,0,,Акварион... Жоқ, олай емес.
Dialogue: 0,0:35:58.40,0:36:01.74,Default,,0,0,0,,Миконо-сан Миконо-сан
Dialogue: 0,0:36:01.74,0:36:04.34,Default,,0,0,0,,Амата-кун Сильфи
Dialogue: 0,0:36:06.27,0:36:08.71,Default,,0,0,0,,Мен сені сағындым, Сильфи.
Dialogue: 0,0:36:08.71,0:36:11.41,Default,,0,0,0,,12 000 жылдан астам
Dialogue: 0,0:36:11.41,0:36:14.25,Default,,0,0,0,,Енді мен сені өлтіре аламын.
Dialogue: 0,0:36:14.25,0:36:16.18,Default,,0,0,0,,Сен Микононы өлтірмексің бе?
Dialogue: 0,0:36:16.18,0:36:19.39,Default,,0,0,0,,Иә, мені өлтір
Dialogue: 0,0:36:19.39,0:36:22.16,Default,,0,0,0,,ащы және қатты тоңу
Dialogue: 0,0:36:22.16,0:36:26.36,Default,,0,0,0,,Қайта-қайта өлтіру
Dialogue: 0,0:36:26.36,0:36:29.26,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:36:29.26,0:36:32.83,Default,,0,0,0,,Амата мен сені өлтіремін
Dialogue: 0,0:36:32.83,0:36:36.20,Default,,0,0,0,,Мені күт, Сильфи, мен бұл жігітті пайдаланамын.
Dialogue: 0,0:36:36.20,0:36:39.97,Default,,0,0,0,,Таң атқанша бір-бірімізді өлтірейік. Эй...
Dialogue: 0,0:36:39.97,0:36:42.97,Default,,0,0,0,,Мен саған бір саусақты тигізуге жол бермеймін.
Dialogue: 0,0:36:57.02,0:37:00.83,Default,,0,0,0,,Жоғары өлшемді кванттық деңгей жоғарылауды жалғастыруда
Dialogue: 0,0:37:00.83,0:37:04.40,Default,,0,0,0,,Бұл нақты нәрсе екені күмәнсіз.
Dialogue: 0,0:37:04.40,0:37:07.27,Default,,0,0,0,,Мифтік акварион
Dialogue: 0,0:37:07.27,0:37:09.67,Default,,0,0,0,,Аңыз ақырында шындыққа айналады
Dialogue: 0,0:37:09.67,0:37:14.17,Default,,0,0,0,,Біз осындай таңғажайып тарихи сәттің куәсі болып отырмыз ба?
Dialogue: 0,0:37:14.17,0:37:20.35,Default,,0,0,0,,Әй, олар осындай уақытта не істеп жатыр?
Dialogue: 0,0:37:20.35,0:37:23.98,Default,,0,0,0,,Бұл да аңыз
Dialogue: 0,0:37:23.98,0:37:27.86,Default,,0,0,0,,Фудо командирі, сіз қашан оралдыңыз?
Dialogue: 0,0:37:27.86,0:37:32.76,Default,,0,0,0,,Дауды ит те жемейді
Dialogue: 0,0:37:38.00,0:37:40.00,Default,,0,0,0,,Амата-кун
Dialogue: 0,0:37:49.01,0:37:52.25,Default,,0,0,0,,Одан бас тартпа, бас тарт
Dialogue: 0,0:37:52.25,0:37:56.42,Default,,0,0,0,,Бұл 10 000 және 2000 жыл бұрын шешілген тағдыр.
Dialogue: 0,0:37:56.42,0:37:59.62,Default,,0,0,0,,Сильфиге байланған сен емессің.
Dialogue: 0,0:37:59.62,0:38:03.39,Default,,0,0,0,,Қанша күрессең де, тағдырды жеңе алмайсың.
Dialogue: 0,0:38:03.39,0:38:07.06,Default,,0,0,0,,Өйткені Сильфи екеуміз тағдырдың нұсқауымен жүрдік.
Dialogue: 0,0:38:07.06,0:38:09.00,Default,,0,0,0,,Жұлдыздарымыз әртүрлі болса да кездесе алдық.
Dialogue: 0,0:38:09.00,0:38:13.20,Default,,0,0,0,,Тағдырға ұшатын қанатым бар
Dialogue: 0,0:38:16.14,0:38:18.94,Default,,0,0,0,,Қанаттарың болса да, ұша алмасаң мән жоқ.
Dialogue: 0,0:38:18.94,0:38:22.64,Default,,0,0,0,,Сіз ұша аласыз ба? Жүр, ұшайық
Dialogue: 0,0:38:24.71,0:38:29.12,Default,,0,0,0,,Тоқта, енді Аматаны ренжітпе.
Dialogue: 0,0:38:29.12,0:38:33.95,Default,,0,0,0,,Күлімдеген жүз де ең сорақы, Сильфи, сені одан сайын өлтіргім келеді.
Dialogue: 0,0:38:33.95,0:38:36.86,Default,,0,0,0,,Көбірек күліңіз
Dialogue: 0,0:38:36.86,0:38:40.36,Default,,0,0,0,,көбірек
Dialogue: 0,0:38:54.98,0:38:57.98,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:38:57.98,0:39:00.78,Default,,0,0,0,,Мен өлдім бе?
Dialogue: 0,0:39:02.82,0:39:04.95,Default,,0,0,0,,Амата
Dialogue: 0,0:39:04.95,0:39:07.62,Default,,0,0,0,,Сенің қауіпсіз болғаныңа қуаныштымын, Джессика.
Dialogue: 0,0:39:07.62,0:39:13.62,Default,,0,0,0,,Амат мен үшін уайымдап, қайтып келуі мүмкін...
Dialogue: 0,0:39:15.76,0:39:19.20,Default,,0,0,0,,Джессика Мен мұны ақыры түсіндім.
Dialogue: 0,0:39:19.20,0:39:22.00,Default,,0,0,0,,Шын мәнінде не маңызды?
Dialogue: 0,0:39:22.00,0:39:25.71,Default,,0,0,0,,Амата
Dialogue: 0,0:39:25.71,0:39:28.61,Default,,0,0,0,,Ояныңдар
Dialogue: 0,0:39:30.64,0:39:36.35,Default,,0,0,0,,Сіз әлі өле алмайсыз, өйткені
Dialogue: 0,0:39:36.35,0:39:41.85,Default,,0,0,0,,Себебі сенің маған берген уәдең әлі орындалған жоқ.
Dialogue: 0,0:39:44.69,0:39:48.19,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:39:53.73,0:39:57.34,Default,,0,0,0,,Сіз өле алмайсыз, өйткені
Dialogue: 0,0:39:57.34,0:40:01.84,Default,,0,0,0,,Өйткені маған берген уәдең әлі орындалған жоқ.
Dialogue: 0,0:40:04.98,0:40:06.98,Default,,0,0,0,,Сен сияқты — олардың әрқайсысы.
Dialogue: 0,0:40:10.35,0:40:12.99,Default,,0,0,0,,Өтінемін, тоқтатыңызшы.
Dialogue: 0,0:40:12.99,0:40:16.52,Default,,0,0,0,,Мен енді екі адамның бір-бірін ренжіткенін көргім келмейді.
Dialogue: 0,0:40:16.52,0:40:20.46,Default,,0,0,0,,Жоқ, Миконо-сан, бүгін түсіндірейік.
Dialogue: 0,0:40:20.46,0:40:24.26,Default,,0,0,0,,Иә? Нені түсіндіргіңіз келеді?
Dialogue: 0,0:40:24.26,0:40:28.74,Default,,0,0,0,,Микононы іздеп жүрсіз бе, себебі бұл сіздің тағдырыңыз?
Dialogue: 0,0:40:28.74,0:40:31.64,Default,,0,0,0,,Дұрыс, енді қайталама.
Dialogue: 0,0:40:31.64,0:40:34.91,Default,,0,0,0,,Мен басқашамын
Dialogue: 0,0:40:34.91,0:40:37.81,Default,,0,0,0,,Миконо-сан Сильфидің реинкарнациясы болуы мүмкін бе?
Dialogue: 0,0:40:37.81,0:40:41.68,Default,,0,0,0,,10 000 және 2000 жыл бұрынғы тағдыр маңызды емес.
Dialogue: 0,0:40:41.68,0:40:46.05,Default,,0,0,0,,Мен қазір... Миконо-сан қазір.
Dialogue: 0,0:40:46.05,0:40:49.32,Default,,0,0,0,,Амата-кун Амата
Dialogue: 0,0:40:49.32,0:40:52.96,Default,,0,0,0,,Қазір, дәл осы сәтте
Dialogue: 0,0:40:52.96,0:40:56.73,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:40:56.73,0:40:59.03,Default,,0,0,0,,Олай болса, мен оны осы жерден тексеремін.
Dialogue: 0,0:40:59.03,0:41:02.67,Default,,0,0,0,,Менің тағдырым және сенің ыстық сезімдерің
Dialogue: 0,0:41:02.67,0:41:04.97,Default,,0,0,0,,Қайсысы күшті?
Dialogue: 0,0:41:15.12,0:41:17.12,Default,,0,0,0,,Амата-кун
Dialogue: 0,0:41:22.46,0:41:25.13,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:41:25.13,0:41:27.13,Default,,0,0,0,,Күннің қанаттары
Dialogue: 0,0:41:32.87,0:41:36.87,Default,,0,0,0,,Мен сенен жеңілемін бе?
Dialogue: 0,0:41:42.08,0:41:46.68,Default,,0,0,0,,Аз қалды, мен іздеген әуен жақында келеді
Dialogue: 0,0:41:49.72,0:41:51.72,Default,,0,0,0,,Шрейд Шрейд
Dialogue: 0,0:41:51.72,0:41:55.09,Default,,0,0,0,,Эй, не болды, Шрейд?
Dialogue: 0,0:41:55.09,0:42:00.49,Default,,0,0,0,,Менің ең жақын досым, мені естисің бе? Әдемі тон екен.
Dialogue: 0,0:42:11.94,0:42:14.44,Default,,0,0,0,,Сильфи Миконо
Dialogue: 0,0:42:19.78,0:42:22.22,Default,,0,0,0,,Шрейдтің био деңгейі шекке дейін төмендейді
Dialogue: 0,0:42:22.22,0:42:25.22,Default,,0,0,0,,Әрі қарайғы ұрыс әрекеті өмірге қауіп төндіреді.
Dialogue: 0,0:42:25.22,0:42:28.99,Default,,0,0,0,,Шлейд орнына Юноха элементін өзгерту
Dialogue: 0,0:42:28.99,0:42:33.73,Default,,0,0,0,,Күте тұрыңыз, мен әлі де күресе аламын.
Dialogue: 0,0:42:33.73,0:42:35.66,Default,,0,0,0,,Тағы да
Dialogue: 0,0:42:35.66,0:42:38.57,Default,,0,0,0,,Мен жақындап қалдым
Dialogue: 0,0:42:38.57,0:42:40.77,Default,,0,0,0,,Элементті өзгерту Асығыңыз
Dialogue: 0,0:42:43.74,0:42:46.64,Default,,0,0,0,,Юноха Трур жекпе-жегі
Dialogue: 0,0:42:46.64,0:42:50.54,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:42:55.35,0:42:57.35,Default,,0,0,0,,«Біз оның әйелі мен балаларын қауіпсіз жерге жеткіздік»
Dialogue: 0,0:43:02.12,0:43:06.36,Default,,0,0,0,,Мифтік Акварионның жоғары өлшемді кванттық деңгейі өлшеу диапазонынан асып кетті.
Dialogue: 0,0:43:06.36,0:43:10.56,Default,,0,0,0,,Фудо Сен не істемексің?
Dialogue: 0,0:43:10.56,0:43:14.73,Default,,0,0,0,,Барлығы Жаратылыс кітабында жазылған емес пе?
Dialogue: 0,0:43:14.73,0:43:19.07,Default,,0,0,0,,Мифтерді тек асыл өмірлер жазады.
Dialogue: 0,0:43:19.07,0:43:24.95,Default,,0,0,0,,Иә, төгілген қанды сия ретінде пайдалану
Dialogue: 0,0:43:24.95,0:43:26.88,Default,,0,0,0,,Тоқтауға ниетіңіз жоқ.
Dialogue: 0,0:43:26.88,0:43:29.98,Default,,0,0,0,,Тоқтау мен қозғалу бір нәрсе
Dialogue: 0,0:43:32.62,0:43:35.92,Default,,0,0,0,,Алақанның арасында не бар?
Dialogue: 0,0:43:35.92,0:43:40.89,Default,,0,0,0,,Онда ештеңе жоқ, тек жоқтық.
Dialogue: 0,0:43:40.89,0:43:44.63,Default,,0,0,0,,Бірақ ешнәрсе ештеңеден басқа ештеңе емес
Dialogue: 0,0:43:44.63,0:43:51.30,Default,,0,0,0,,Оң және теріс екі күш бірін-бірі жоққа шығарады және жоқтықты құрайды.
Dialogue: 0,0:43:51.30,0:43:56.58,Default,,0,0,0,,Миконо Сузусироның қосу күші де бірдей.
Dialogue: 0,0:43:56.58,0:43:59.48,Default,,0,0,0,,Жарық пен қараңғылық, дұрыс пен бұрыс
Dialogue: 0,0:43:59.48,0:44:04.35,Default,,0,0,0,,Жақсылық пен жамандық және Инь мен Ян
Dialogue: 0,0:44:04.35,0:44:07.69,Default,,0,0,0,,Екі жабық жады ашылады.
Dialogue: 0,0:44:07.69,0:44:12.13,Default,,0,0,0,,Жоқтан туған, шексіз күш қозғала бастайды
Dialogue: 0,0:44:12.13,0:44:17.53,Default,,0,0,0,,Ал енді жаңа бет ашылады
Dialogue: 0,0:44:50.86,0:44:52.86,Default,,0,0,0,,Не?
Dialogue: 0,0:44:58.14,0:45:00.14,Default,,0,0,0,,Бұл өте жауапсыздық.
Dialogue: 0,0:45:06.58,0:45:10.88,Default,,0,0,0,,Жүрегімде күннің қанаты
Dialogue: 0,0:45:17.22,0:45:19.22,Default,,0,0,0,,Мифтік акварион
Dialogue: 0,0:45:23.83,0:45:25.83,Default,,0,0,0,,Амата-кун
Dialogue: 0,0:45:25.83,0:45:29.03,Default,,0,0,0,,Қақпа ашылды. Біз де барайық. иә?
Dialogue: 0,0:45:43.62,0:45:46.92,Default,,0,0,0,,2 Ұрлаушылар және мифтік акварион
Dialogue: 0,0:45:46.92,0:45:51.79,Default,,0,0,0,,Өлшемді қақпаға кірді
Dialogue: 0,0:45:51.79,0:45:55.10,Default,,0,0,0,,Өтінемін, төраға Клэр.
Dialogue: 0,0:45:55.10,0:46:00.90,Default,,0,0,0,,Тағы да... тағы да, мені жіберіңізші.
Dialogue: 0,0:46:00.90,0:46:05.30,Default,,0,0,0,,Бұл жолы өміріңді жоғалтасың.
Dialogue: 0,0:46:08.48,0:46:10.41,Default,,0,0,0,,Сіз алдыңыз
Dialogue: 0,0:46:10.41,0:46:14.31,Default,,0,0,0,,Сіз мұны мен Нео Диваға келген кезден білуіңіз керек еді.
Dialogue: 0,0:46:14.31,0:46:17.11,Default,,0,0,0,,Бұл күн бір күні келеді деп үміттенемін
Dialogue: 0,0:46:36.54,0:46:39.17,Default,,0,0,0,,Маған бір нәрсеге уәде бер
Dialogue: 0,0:46:39.17,0:46:43.97,Default,,0,0,0,,Аяқталған әнді маған да тыңдауға рұқсат етемін деді.
Dialogue: 0,0:46:52.29,0:46:54.29,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:46:56.92,0:46:58.92,Default,,0,0,0,,Schrade
Dialogue: 0,0:47:00.79,0:47:04.99,Default,,0,0,0,,Екі вектор да өлшемді қақпаға кіреді және монитор үзіледі.
Dialogue: 0,0:47:11.27,0:47:13.87,Default,,0,0,0,,Миконо мен Кагура ше? Амата
Dialogue: 0,0:47:19.85,0:47:22.85,Default,,0,0,0,,Соңғы әнді ойнатпас бұрын
Dialogue: 0,0:47:22.85,0:47:26.05,Default,,0,0,0,,Алдымен мифтік Акварионды қайтарыңыз
Dialogue: 0,0:47:26.05,0:47:29.79,Default,,0,0,0,,Бірақ екеуің ғана болсаңдар... Мен саған қосыламын.
Dialogue: 0,0:47:29.79,0:47:33.09,Default,,0,0,0,,Джессика жақсы болды ма?
Dialogue: 0,0:47:33.09,0:47:37.56,Default,,0,0,0,,Амата Бұл менің махаббатымның түрі
Dialogue: 0,0:47:37.56,0:47:42.36,Default,,0,0,0,,Тағдыр Одағы Алға Акварион
Dialogue: 0,0:47:50.61,0:47:54.41,Default,,0,0,0,,Амата рахмет Джессика
Dialogue: 0,0:47:54.41,0:47:58.01,Default,,0,0,0,,Әй, жаным дірілдеп тұр
Dialogue: 0,0:48:02.76,0:48:05.86,Default,,0,0,0,,Акварион спада
Dialogue: 0,0:48:08.70,0:48:10.70,Default,,0,0,0,,Мифтік тип
Dialogue: 0,0:48:14.77,0:48:16.77,Default,,0,0,0,,Бұл қажет болды
Dialogue: 0,0:48:20.54,0:48:22.54,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:48:22.54,0:48:26.01,Default,,0,0,0,,Енді өкін.
Dialogue: 0,0:48:26.01,0:48:28.61,Default,,0,0,0,,Айқышқа шегеленген қылыш
Dialogue: 0,0:48:47.30,0:48:49.30,Default,,0,0,0,,Шрейд
Dialogue: 0,0:48:54.57,0:48:58.58,Default,,0,0,0,,Өлшем қақпасы іске қосылды Митра Гунис менің патшалығыма кіреді
Dialogue: 0,0:48:58.58,0:49:01.35,Default,,0,0,0,,Кабинадағы сирек Иглер реакциясы
Dialogue: 0,0:49:01.35,0:49:06.12,Default,,0,0,0,,Кагура өте қыңыр Сирек Игура
Dialogue: 0,0:49:06.12,0:49:10.02,Default,,0,0,0,,Менің ойымша, бұл жолы нағыз Хауа
Dialogue: 0,0:49:10.02,0:49:12.23,Default,,0,0,0,,Ұшуға дайындалу
Dialogue: 0,0:49:12.23,0:49:16.83,Default,,0,0,0,,Біз Кагураның шынайы Хауаны монополиялауына жол бере алмаймыз.
Dialogue: 0,0:49:22.77,0:49:26.71,Default,,0,0,0,,Дүние жүзінде жер қыртысының қозғалысы және қалыптан тыс ауа райы туралы мәліметтер бар.
Dialogue: 0,0:49:26.71,0:49:31.14,Default,,0,0,0,,Мифтік Акварион мөрі сынған
Dialogue: 0,0:49:31.14,0:49:35.98,Default,,0,0,0,,Альтеа мен Вега арасында сақталған тепе-теңдік бұзылды.
Dialogue: 0,0:49:35.98,0:49:38.35,Default,,0,0,0,,Мифтік акварион ұрланды
Dialogue: 0,0:49:38.35,0:49:42.66,Default,,0,0,0,,Шрейдпен және басқалармен байланыс үзілген.
Dialogue: 0,0:49:42.66,0:49:45.06,Default,,0,0,0,,Біздің қолымыздан келетін нәрсе бар ма?
Dialogue: 0,0:49:45.06,0:49:47.86,Default,,0,0,0,,Дүние не болады?
Dialogue: 0,0:49:47.86,0:49:50.66,Default,,0,0,0,,Бас тартуға әлі ерте
Dialogue: 0,0:49:50.66,0:49:55.03,Default,,0,0,0,,Таңдалған элементтерсіз Күннің қанаттары
Dialogue: 0,0:49:55.03,0:49:57.33,Default,,0,0,0,,Қозғалмай тұр
Dialogue: 0,0:50:00.77,0:50:03.67,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:50:06.25,0:50:09.62,Default,,0,0,0,,Уәдеңді орындағаныңды қалаймын.
Dialogue: 0,0:50:09.62,0:50:13.12,Default,,0,0,0,,Сен жасыл шашсың
Dialogue: 0,0:51:46.08,0:51:48.98,Default,,0,0,0,,Маған ұнайтын нәрсені айтайын
Dialogue: 0,0:51:48.98,0:51:52.82,Default,,0,0,0,,Ала жапырақшалар Кагураның айқайы
Dialogue: 0,0:51:52.82,0:51:55.25,Default,,0,0,0,,Нені ұнатпайтыныңызды айтыңыз
Dialogue: 0,0:51:55.25,0:52:00.05,Default,,0,0,0,,Бұл өтірік, сатқындық және сол адам.
Dialogue: 0,0:52:01.55,0:52:07.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory