Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.94,0:00:42.87,Default,,0,0,0,,Басқару жұмыс істемейді!
Dialogue: 0,0:00:42.87,0:00:44.87,Default,,0,0,0,,Барған сайын сыпырылып кету
Dialogue: 0,0:00:46.81,0:00:49.28,Default,,0,0,0,,Өлшемдер арасында
Dialogue: 0,0:00:49.28,0:00:52.08,Default,,0,0,0,,Бұрмаланған кеңістіктің ыңырсы
Dialogue: 0,0:00:52.08,0:00:54.08,Default,,0,0,0,,Үмітсіздік диссонансы
Dialogue: 0,0:00:58.92,0:01:02.19,Default,,0,0,0,,Осы қарқынмен, ақырында біз де солай боламыз.
Dialogue: 0,0:01:02.19,0:01:04.13,Default,,0,0,0,,Уф
Dialogue: 0,0:01:04.13,0:01:06.97,Default,,0,0,0,,Шрейд!
Dialogue: 0,0:01:06.97,0:01:09.87,Default,,0,0,0,,Қайтадан қосылайық. Бұл денемен мүмкін емес.
Dialogue: 0,0:01:15.17,0:01:17.14,Default,,0,0,0,,Біріктірілсе
Dialogue: 0,0:01:17.14,0:01:20.98,Default,,0,0,0,,Өлшемді ағынның масштабын оқи алады
Dialogue: 0,0:01:20.98,0:01:22.98,Default,,0,0,0,,Шрейд
Dialogue: 0,0:01:22.98,0:01:24.98,Default,,0,0,0,,Ағысқа қарсы шықпаңыз
Dialogue: 0,0:01:24.98,0:01:27.28,Default,,0,0,0,,Айналадағы дыбыстармен әрекеттесу
Dialogue: 0,0:01:34.53,0:01:38.16,Default,,0,0,0,,Сіз мұны сезінесіз бе?
Dialogue: 0,0:01:38.16,0:01:41.73,Default,,0,0,0,,Бұл менің соңғы бірлестігім
Dialogue: 0,0:01:41.73,0:01:44.64,Default,,0,0,0,,Симфониялық одақ
Dialogue: 0,0:01:44.64,0:01:46.64,Default,,0,0,0,,Акварион!
Dialogue: 0,0:02:09.73,0:02:11.96,Default,,0,0,0,,Барлығы осында.
Dialogue: 0,0:02:11.96,0:02:14.76,Default,,0,0,0,,Бәріңе айтарым маңызды.
Dialogue: 0,0:02:18.60,0:02:20.54,Default,,0,0,0,,Әрі қарай не айтылады
Dialogue: 0,0:02:20.54,0:02:23.07,Default,,0,0,0,,10 000 жыл және 2000 жыл
Dialogue: 0,0:02:23.07,0:02:26.08,Default,,0,0,0,,Және одан әрі
Dialogue: 0,0:02:26.08,0:02:28.21,Default,,0,0,0,,Мұрагерлік
Dialogue: 0,0:02:28.21,0:02:30.75,Default,,0,0,0,,Мәңгілік миф
Dialogue: 0,0:02:30.75,0:02:34.35,Default,,0,0,0,,Ақымақ ертегілерді айтып үлгерсең
Dialogue: 0,0:02:34.35,0:02:36.75,Default,,0,0,0,,Аматаны және басқаларды мүмкіндігінше тезірек қолдаңыз...
Dialogue: 0,0:02:43.66,0:02:45.63,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:02:45.63,0:02:51.40,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:51.40,0:02:53.64,Default,,0,0,0,,Кітапта?
Dialogue: 0,0:02:53.64,0:02:57.94,Default,,0,0,0,,Бұл кітап әрқашан сізбен бірге болды.
Dialogue: 0,0:02:57.94,0:03:00.45,Default,,0,0,0,,Алыста, уақыт ағымымен сыпырылмады
Dialogue: 0,0:03:00.45,0:03:03.08,Default,,0,0,0,,Өзгермейтін кітап
Dialogue: 0,0:03:03.08,0:03:06.92,Default,,0,0,0,,Аты
Dialogue: 0,0:03:06.92,0:03:08.92,Default,,0,0,0,,Ал қазір
Dialogue: 0,0:03:10.82,0:03:13.66,Default,,0,0,0,,Тыйым салуды жою
Dialogue: 0,0:03:13.66,0:03:16.46,Default,,0,0,0,,Ооо
Dialogue: 0,0:03:20.83,0:03:22.77,Default,,0,0,0,,Уақыт
Dialogue: 0,0:03:22.77,0:03:25.67,Default,,0,0,0,,20 000 және 4 000 жыл бұрынғыға бару
Dialogue: 0,0:03:32.98,0:03:34.91,Default,,0,0,0,,Бұл көрініс
Dialogue: 0,0:03:34.91,0:03:37.68,Default,,0,0,0,,Менің үмітсіздік туралы болжамымнан да анық...
Dialogue: 0,0:03:37.68,0:03:39.68,Default,,0,0,0,,Уф
Dialogue: 0,0:03:56.40,0:03:59.30,Default,,0,0,0,,Бұл семсер резонансты камертон болып табылады.
Dialogue: 0,0:03:59.30,0:04:02.20,Default,,0,0,0,,Шығу шамын табуға арналған компас
Dialogue: 0,0:04:08.98,0:04:10.95,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:04:10.95,0:04:12.98,Default,,0,0,0,,Резонанстық камера
Dialogue: 0,0:04:12.98,0:04:15.75,Default,,0,0,0,,Кеңістік пен уақыт арасында ойып жазылған естеліктер
Dialogue: 0,0:04:15.75,0:04:18.79,Default,,0,0,0,,Ояну
Dialogue: 0,0:04:18.79,0:04:21.43,Default,,0,0,0,,Шрейд Шрейд!
Dialogue: 0,0:04:21.43,0:04:23.43,Default,,0,0,0,,Тек алға қара
Dialogue: 0,0:04:33.10,0:04:35.61,Default,,0,0,0,,Оны адамзаттың табиғи жауы деп те атауға болады.
Dialogue: 0,0:04:35.61,0:04:38.51,Default,,0,0,0,,Құлаған қанат тайпасы
Dialogue: 0,0:04:38.51,0:04:40.51,Default,,0,0,0,,Сансыз жеңіліс және
Dialogue: 0,0:04:40.51,0:04:43.28,Default,,0,0,0,,Сансыз өлім
Dialogue: 0,0:04:43.28,0:04:45.38,Default,,0,0,0,,Жоюдың жорғалау ізі
Dialogue: 0,0:04:47.55,0:04:50.56,Default,,0,0,0,,Иә
Dialogue: 0,0:04:50.56,0:04:52.56,Default,,0,0,0,,Аполлоний
Dialogue: 0,0:04:55.96,0:04:59.16,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:04:59.16,0:05:01.66,Default,,0,0,0,,Бір махаббат ғажайып жаратты
Dialogue: 0,0:05:04.64,0:05:07.21,Default,,0,0,0,,Аполлоний болуы мүмкін
Dialogue: 0,0:05:07.21,0:05:10.11,Default,,0,0,0,,Жау болуы керек адам әйелі
Dialogue: 0,0:05:10.11,0:05:12.51,Default,,0,0,0,,Мен Селианға ғашық болдым.
Dialogue: 0,0:05:15.91,0:05:19.82,Default,,0,0,0,,Бұл мифтік Акварион.
Dialogue: 0,0:05:19.82,0:05:22.82,Default,,0,0,0,,Аполлонийдің механикалық қанаты болып табылады
Dialogue: 0,0:05:22.82,0:05:25.19,Default,,0,0,0,,Құлаған қанатты атып түсіру
Dialogue: 0,0:05:25.19,0:05:28.29,Default,,0,0,0,,Сүйікті серианы мен адамзатты қорғадым.
Dialogue: 0,0:05:30.33,0:05:34.10,Default,,0,0,0,,Бірақ жарық бар жерде қараңғылық та бар.
Dialogue: 0,0:05:34.10,0:05:36.03,Default,,0,0,0,,Бұл Аполлонийге бас изеу болды.
Dialogue: 0,0:05:36.03,0:05:37.97,Default,,0,0,0,,Құлаған қанаттар
Dialogue: 0,0:05:37.97,0:05:40.64,Default,,0,0,0,,Өзіне опасыздық жасаған Аполлонийге
Dialogue: 0,0:05:40.64,0:05:44.51,Default,,0,0,0,,Мен махаббат пен жек көрушілікті сезіндім.
Dialogue: 0,0:05:44.51,0:05:47.21,Default,,0,0,0,,Және тағы бір нәрсе
Dialogue: 0,0:05:47.21,0:05:50.92,Default,,0,0,0,,Қараңғыда жарық іздейтін кішкентай
Dialogue: 0,0:05:50.92,0:05:53.95,Default,,0,0,0,,Не?
Dialogue: 0,0:05:53.95,0:05:57.39,Default,,0,0,0,,Аполлонийдің соңынан ерді.
Dialogue: 0,0:05:57.39,0:05:59.62,Default,,0,0,0,,Қанатты ит
Dialogue: 0,0:05:59.62,0:06:01.56,Default,,0,0,0,,Ол болуы мүмкін
Dialogue: 0,0:06:01.56,0:06:04.10,Default,,0,0,0,,Менің қожайынымның сүйікті Серианға
Dialogue: 0,0:06:04.10,0:06:07.97,Default,,0,0,0,,Менде жауапсыз махаббат болды.
Dialogue: 0,0:06:07.97,0:06:09.97,Default,,0,0,0,,Бейшара Полон
Dialogue: 0,0:06:09.97,0:06:12.34,Default,,0,0,0,,Түнгі аспанның қараңғылығын тілеймін
Dialogue: 0,0:06:12.34,0:06:14.27,Default,,0,0,0,,Егер мен қайта туылсам
Dialogue: 0,0:06:14.27,0:06:16.27,Default,,0,0,0,,Серианмен қосылғым келеді.
Dialogue: 0,0:06:18.48,0:06:21.38,Default,,0,0,0,,Бас қанаттарды жек көру
Dialogue: 0,0:06:21.38,0:06:23.82,Default,,0,0,0,,Әртүрлі ойларды қалдыру
Dialogue: 0,0:06:23.82,0:06:26.72,Default,,0,0,0,,Уақыт өте жылдам өтіп жатыр
Dialogue: 0,0:06:26.72,0:06:28.75,Default,,0,0,0,,Өлілердің көлеңкесі
Dialogue: 0,0:06:28.75,0:06:30.96,Default,,0,0,0,,Тірілердің азабы
Dialogue: 0,0:06:30.96,0:06:34.63,Default,,0,0,0,,Қараңғылық қуанышы
Dialogue: 0,0:06:34.63,0:06:37.90,Default,,0,0,0,,Бәріміз бір кісідей жиналайық
Dialogue: 0,0:06:37.90,0:06:41.77,Default,,0,0,0,,Оны әдемі шілтерге ораңыз
Dialogue: 0,0:06:41.77,0:06:44.14,Default,,0,0,0,,Күндізгі жарық – өмір
Dialogue: 0,0:06:44.14,0:06:46.10,Default,,0,0,0,,Түннің қараңғылығы – өлім
Dialogue: 0,0:06:46.10,0:06:48.64,Default,,0,0,0,,Ол хаосқа араласады
Dialogue: 0,0:06:48.64,0:06:51.48,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:06:51.48,0:06:53.41,Default,,0,0,0,,Жақынырақ қараңыз
Dialogue: 0,0:06:53.41,0:06:56.11,Default,,0,0,0,,Міне, мифтің екінші тарауы
Dialogue: 0,0:07:01.05,0:07:03.09,Default,,0,0,0,,Бұл қандай көрініс?
Dialogue: 0,0:07:03.09,0:07:05.29,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:07:05.29,0:07:07.23,Default,,0,0,0,,Ұзақ уақыттан тыс
Dialogue: 0,0:07:07.23,0:07:09.69,Default,,0,0,0,,Жаңғырған Құлаған қанаттар
Dialogue: 0,0:07:09.69,0:07:13.13,Default,,0,0,0,,Ол адамзатқа үлкен қараңғылық ретінде шабуыл жасайды.
Dialogue: 0,0:07:13.13,0:07:15.07,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:07:15.07,0:07:19.90,Default,,0,0,0,,Олар өздерін құтқарған аңызды ұмытпады.
Dialogue: 0,0:07:19.90,0:07:21.87,Default,,0,0,0,,Уа, Жоғарғы Бас қолбасшы!
Dialogue: 0,0:07:21.87,0:07:24.71,Default,,0,0,0,,Неге мұнда?
Dialogue: 0,0:07:24.71,0:07:27.31,Default,,0,0,0,,Бұл 12 000 жыл бұрынғы көрініс, солай емес пе?
Dialogue: 0,0:07:30.42,0:07:32.35,Default,,0,0,0,,Қарамаңдар
Dialogue: 0,0:07:32.35,0:07:36.25,Default,,0,0,0,,Біз мифтің ортасындамыз
Dialogue: 0,0:07:36.25,0:07:38.25,Default,,0,0,0,,Уау
Dialogue: 0,0:07:41.06,0:07:43.96,Default,,0,0,0,,Адамдар аңыздарды басшылыққа ала отырып, оны қазған.
Dialogue: 0,0:07:43.96,0:07:46.43,Default,,0,0,0,,Қолында ежелгі механикалық Тенвингпен
Dialogue: 0,0:07:46.43,0:07:49.03,Default,,0,0,0,,Мен орнымнан тұрдым.
Dialogue: 0,0:07:49.03,0:07:51.94,Default,,0,0,0,,Бұл дәуір
Dialogue: 0,0:07:51.94,0:07:54.81,Default,,0,0,0,,Акварионды кім басқарады?
Dialogue: 0,0:07:54.81,0:07:57.11,Default,,0,0,0,,Аполлон есімді бала
Dialogue: 0,0:07:57.11,0:08:01.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:01.05,0:08:03.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:03.88,0:08:06.48,Default,,0,0,0,,Оның бастапқы жаны
Dialogue: 0,0:08:13.93,0:08:17.50,Default,,0,0,0,,Кагура-ме, шын Хауаны жекешелендіру үшін бе?
Dialogue: 0,0:08:17.50,0:08:19.53,Default,,0,0,0,,Мемлекетке опасыздық жасаудың анық әрекеті
Dialogue: 0,0:08:19.53,0:08:21.80,Default,,0,0,0,,Енді бұл Альтейде жоқ
Dialogue: 0,0:08:21.80,0:08:23.80,Default,,0,0,0,,Сізге қайтатын жер жоқ!
Dialogue: 0,0:08:27.61,0:08:29.61,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:08:33.95,0:08:36.85,Default,,0,0,0,,Сильфиді ешкімге берме
Dialogue: 0,0:08:36.85,0:08:39.55,Default,,0,0,0,,Мен саған қандай питч лақтыратынымды айтамын дедім.
Dialogue: 0,0:08:39.55,0:08:42.32,Default,,0,0,0,,Аполлон
Dialogue: 0,0:08:42.32,0:08:45.02,Default,,0,0,0,,Иә
Dialogue: 0,0:08:45.02,0:08:47.86,Default,,0,0,0,,Бұл қайта туылған пішін болды.
Dialogue: 0,0:08:47.86,0:08:50.16,Default,,0,0,0,,Аңызға айналған Аполлонның бұрынғы өмірі
Dialogue: 0,0:08:50.16,0:08:52.10,Default,,0,0,0,,Бұл қанатты ит болды.
Dialogue: 0,0:08:52.10,0:08:55.00,Default,,0,0,0,,Және оның сүйіктісі Сериан.
Dialogue: 0,0:08:55.00,0:08:58.44,Default,,0,0,0,,Мен Сильвия болып қайта тудым.
Dialogue: 0,0:08:58.44,0:09:01.34,Default,,0,0,0,,Оларды біртүрлі тағдыр кездестірді
Dialogue: 0,0:09:01.34,0:09:05.51,Default,,0,0,0,,Біз шайқаста бір-бірімізге тартыламыз.
Dialogue: 0,0:09:05.51,0:09:09.01,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:09:11.15,0:09:13.68,Default,,0,0,0,,Құлаған қанаттардың бас қанаттары да
Dialogue: 0,0:09:13.68,0:09:17.46,Default,,0,0,0,,Ол осы дәуірде реинкарнацияланды.
Dialogue: 0,0:09:17.46,0:09:21.23,Default,,0,0,0,,Махаббат пен өшпенділіктің жүрегіне енші болған қанаттар
Dialogue: 0,0:09:21.23,0:09:23.49,Default,,0,0,0,,Аполлоний қорғаған адамзат
Dialogue: 0,0:09:23.49,0:09:26.23,Default,,0,0,0,,Мен жоюды жоспарлап отырмын
Dialogue: 0,0:09:26.23,0:09:29.07,Default,,0,0,0,,Бірақ оның бұрмаланған махаббаты
Dialogue: 0,0:09:29.07,0:09:32.57,Default,,0,0,0,,Құлаған қанат тайпасы да жойылады деп шешілді.
Dialogue: 0,0:09:32.57,0:09:34.64,Default,,0,0,0,,Құлаған қанат тайпасы
Dialogue: 0,0:09:34.64,0:09:36.91,Default,,0,0,0,,Отырғызылған өмір ағашы
Dialogue: 0,0:09:36.91,0:09:38.84,Default,,0,0,0,,Жеміссіз
Dialogue: 0,0:09:38.84,0:09:41.08,Default,,0,0,0,,Осы планетаның жерін қатыстыру
Dialogue: 0,0:09:41.08,0:09:43.08,Default,,0,0,0,,Құрып кету
Dialogue: 0,0:09:45.72,0:09:48.75,Default,,0,0,0,,Егер жолы болса
Dialogue: 0,0:09:48.75,0:09:51.49,Default,,0,0,0,,Қайта кездескенше
Dialogue: 0,0:09:51.49,0:09:53.42,Default,,0,0,0,,Аполлон
Dialogue: 0,0:09:53.42,0:09:55.36,Default,,0,0,0,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,0:09:55.36,0:09:57.90,Default,,0,0,0,,Адамдар, аспан қанаттары және бұл жұлдыз
Dialogue: 0,0:09:57.90,0:10:00.30,Default,,0,0,0,,Жаңа туынды үшін!
Dialogue: 0,0:10:03.80,0:10:08.17,Default,,0,0,0,,О
Dialogue: 0,0:10:08.17,0:10:11.91,Default,,0,0,0,,12000 жыл бұрынғы тілегін орындай алмады.
Dialogue: 0,0:10:11.91,0:10:16.08,Default,,0,0,0,,Тағы да қоштасатын кез келді.
Dialogue: 0,0:10:16.08,0:10:19.48,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:10:31.56,0:10:35.77,Default,,0,0,0,,Мифтер
Dialogue: 0,0:10:35.77,0:10:38.67,Default,,0,0,0,,3-тараудың 3-тарауына өту керек пе?
Dialogue: 0,0:10:38.67,0:10:43.11,Default,,0,0,0,,Жоқ, иә
Dialogue: 0,0:10:43.11,0:10:45.11,Default,,0,0,0,,Қазіргі
Dialogue: 0,0:10:53.58,0:10:57.22,Default,,0,0,0,,О, жер бөлініп жатыр.
Dialogue: 0,0:10:57.22,0:10:59.69,Default,,0,0,0,,Өмір ағашы қурағанда
Dialogue: 0,0:10:59.69,0:11:01.99,Default,,0,0,0,,Дүниенің тепе-теңдігі бұзылады
Dialogue: 0,0:11:01.99,0:11:04.63,Default,,0,0,0,,Жер екіге бөлінді.
Dialogue: 0,0:11:04.63,0:11:08.97,Default,,0,0,0,,Жарық пен қараңғылық
Dialogue: 0,0:11:08.97,0:11:11.27,Default,,0,0,0,,Екі қарама-қайшы спора
Dialogue: 0,0:11:11.27,0:11:13.70,Default,,0,0,0,,Оны Құс жолы жауып тұр
Dialogue: 0,0:11:13.70,0:11:15.64,Default,,0,0,0,,Орихиме және Хикобоши
Dialogue: 0,0:11:15.64,0:11:17.64,Default,,0,0,0,,Вега және Альтей
Dialogue: 0,0:11:21.01,0:11:23.68,Default,,0,0,0,,Яғни
Dialogue: 0,0:11:23.68,0:11:26.98,Default,,0,0,0,,Өлшемдік қақпадан тыс жер
Dialogue: 0,0:11:26.98,0:11:29.59,Default,,0,0,0,,Мақтана алатын ұлыңмын. Иә.
Dialogue: 0,0:11:29.59,0:11:33.76,Default,,0,0,0,,Дүниеге қарсылық бастапқыда бір болды дейсіз бе?
Dialogue: 0,0:11:33.76,0:11:36.33,Default,,0,0,0,,Бұл Құдайдың сүйек ойынының сыйы ма?
Dialogue: 0,0:11:36.33,0:11:39.10,Default,,0,0,0,,Әлде екі түрдің де араласуы ма?
Dialogue: 0,0:11:39.10,0:11:41.37,Default,,0,0,0,,Бөлінгеніне қарамастан
Dialogue: 0,0:11:41.37,0:11:43.93,Default,,0,0,0,,Екі дүние бір-біріне тартылады
Dialogue: 0,0:11:43.93,0:11:45.87,Default,,0,0,0,,Сынған жұлдыз
Dialogue: 0,0:11:45.87,0:11:47.87,Default,,0,0,0,,Жыртылған жан
Dialogue: 0,0:11:51.38,0:11:53.78,Default,,0,0,0,,Бұл «Егіз жұлдыздар кітабы».
Dialogue: 0,0:11:58.28,0:12:01.05,Default,,0,0,0,,Мен Аматаны іздегендеймін
Dialogue: 0,0:12:01.05,0:12:04.92,Default,,0,0,0,,Ол дүние де біздің дүниені іздеді.
Dialogue: 0,0:12:04.92,0:12:06.92,Default,,0,0,0,,Жұлдыздар бір-біріне тартыла ма?
Dialogue: 0,0:12:08.83,0:12:12.23,Default,,0,0,0,,Schrade Жарайды.
Dialogue: 0,0:12:12.23,0:12:14.97,Default,,0,0,0,,Мен өзімді біртүрлі жақсы сезінемін.
Dialogue: 0,0:12:14.97,0:12:17.54,Default,,0,0,0,,Менде табылар деген сезім бар.
Dialogue: 0,0:12:17.54,0:12:21.51,Default,,0,0,0,,Мен іздеген соңғы әуен
Dialogue: 0,0:12:21.51,0:12:23.67,Default,,0,0,0,,Екі жұлдыз бірін-бірі іздейді
Dialogue: 0,0:12:23.67,0:12:25.68,Default,,0,0,0,,Екі әуен
Dialogue: 0,0:12:25.68,0:12:29.15,Default,,0,0,0,,Екеуінің де жалғыз екеніне сенімдімін.
Dialogue: 0,0:12:29.15,0:12:31.08,Default,,0,0,0,,Мен сияқты
Dialogue: 0,0:12:31.08,0:12:33.98,Default,,0,0,0,,Мен өзімді жалғыз сезінемін
Dialogue: 0,0:12:33.98,0:12:36.05,Default,,0,0,0,,Сондықтан мен оны қудым
Dialogue: 0,0:12:36.05,0:12:38.29,Default,,0,0,0,,Менің жүрегімдегі саңылау
Dialogue: 0,0:12:38.29,0:12:41.66,Default,,0,0,0,,Мен оның орнын толтырғым келеді!
Dialogue: 0,0:12:41.66,0:12:44.60,Default,,0,0,0,,Уақыт өтеді
Dialogue: 0,0:12:44.60,0:12:48.33,Default,,0,0,0,,Одан әрі реинкарнацияға қол жеткізді
Dialogue: 0,0:12:48.33,0:12:50.60,Default,,0,0,0,,Вега әлемінің дивасы
Dialogue: 0,0:12:50.60,0:12:52.54,Default,,0,0,0,,Алисияның баласы ретінде
Dialogue: 0,0:12:52.54,0:12:55.94,Default,,0,0,0,,Adidas
Dialogue: 0,0:12:55.94,0:12:58.01,Default,,0,0,0,,Kyaah
Dialogue: 0,0:12:58.01,0:13:02.35,Default,,0,0,0,,Одан бұрын бұл дүниеге қайта тірілген адам болған.
Dialogue: 0,0:13:02.35,0:13:05.62,Default,,0,0,0,,Өткеннің барлық естеліктерімен
Dialogue: 0,0:13:05.62,0:13:07.55,Default,,0,0,0,,Донал
Dialogue: 0,0:13:07.55,0:13:09.52,Default,,0,0,0,,Бұл ауырсыну
Dialogue: 0,0:13:09.52,0:13:13.46,Default,,0,0,0,,Аполлон Аполлоний емес
Dialogue: 0,0:13:13.46,0:13:17.13,Default,,0,0,0,,Ол мені ұрды
Dialogue: 0,0:13:17.13,0:13:19.70,Default,,0,0,0,,Жек көру
Dialogue: 0,0:13:19.70,0:13:22.53,Default,,0,0,0,,Кек
Dialogue: 0,0:13:22.53,0:13:24.47,Default,,0,0,0,,Кек алу!
Dialogue: 0,0:13:24.47,0:13:28.34,Default,,0,0,0,,Сол адам
Dialogue: 0,0:13:28.34,0:13:30.91,Default,,0,0,0,,Алисия дүниеге әкелген сәбидің жаны.
Dialogue: 0,0:13:30.91,0:13:32.84,Default,,0,0,0,,екіге бөліңіз
Dialogue: 0,0:13:32.84,0:13:34.85,Default,,0,0,0,,А
Dialogue: 0,0:13:34.85,0:13:37.78,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:13:37.78,0:13:40.55,Default,,0,0,0,,Аполлон осылайша бөлініп кетті.
Dialogue: 0,0:13:40.55,0:13:44.26,Default,,0,0,0,,Селиан өзінің жанын мұра еткен Сильвияны жақсы көреді.
Dialogue: 0,0:13:44.26,0:13:47.93,Default,,0,0,0,,Бұл дүниеде әділ өмір болып қайта тірілген
Dialogue: 0,0:13:47.93,0:13:50.29,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:13:50.29,0:13:53.86,Default,,0,0,0,,Шынымен
Dialogue: 0,0:13:53.86,0:13:55.96,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:14:01.27,0:14:03.21,Default,,0,0,0,,Миконо
Dialogue: 0,0:14:03.21,0:14:06.51,Default,,0,0,0,,Миконо-сан
Dialogue: 0,0:14:06.51,0:14:08.51,Default,,0,0,0,,Джессика
Dialogue: 0,0:14:11.38,0:14:13.68,Default,,0,0,0,,Амата – Аполлонның жаны.
Dialogue: 0,0:14:13.68,0:14:16.29,Default,,0,0,0,,Мен мұны жартысы ғана деп ойладым...
Dialogue: 0,0:14:16.29,0:14:21.59,Default,,0,0,0,,Ақырында маған орын қалмады.
Dialogue: 0,0:14:21.59,0:14:24.56,Default,,0,0,0,,Екі жұлдыз шайқасы
Dialogue: 0,0:14:24.56,0:14:28.37,Default,,0,0,0,,Ал Аполлонның өмірі екіге бөлінді.
Dialogue: 0,0:14:28.37,0:14:32.60,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:14:32.60,0:14:34.64,Default,,0,0,0,,Осы трагедияны сахналау
Dialogue: 0,0:14:34.64,0:14:36.91,Default,,0,0,0,,Қараңғылықтың болуы
Dialogue: 0,0:14:36.91,0:14:38.84,Default,,0,0,0,,20000 және 4000 жыл бұрын
Dialogue: 0,0:14:38.84,0:14:42.35,Default,,0,0,0,,Тым терең махаббатқа батқан жан
Dialogue: 0,0:14:42.35,0:14:45.35,Default,,0,0,0,,Бұл бұрынғы бас пен қанаттың ішіндегі қараңғылық.
Dialogue: 0,0:14:45.35,0:14:48.59,Default,,0,0,0,,Бұл дәуірдегі атау болды
Dialogue: 0,0:14:48.59,0:14:50.62,Default,,0,0,0,,Микадж
Dialogue: 0,0:14:50.62,0:14:54.33,Default,,0,0,0,,Және осы қайғылы мифті тоқтату
Dialogue: 0,0:14:54.33,0:14:57.80,Default,,0,0,0,,Мұнда тек сен ғана
Dialogue: 0,0:14:57.80,0:15:00.60,Default,,0,0,0,,Маған айтылған оқиға
Dialogue: 0,0:15:00.60,0:15:03.40,Default,,0,0,0,,Міне, күте тұрыңыз.
Dialogue: 0,0:15:03.40,0:15:06.87,Default,,0,0,0,,Болашақ екі дүние кітабында жазылған емес пе?
Dialogue: 0,0:15:06.87,0:15:08.84,Default,,0,0,0,,Менің болжауым да оны болжай алмайды.
Dialogue: 0,0:15:08.84,0:15:12.18,Default,,0,0,0,,Бұл шайқастың нәтижесі қандай болады?
Dialogue: 0,0:15:12.18,0:15:14.18,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:15:17.38,0:15:19.68,Default,,0,0,0,,Уау
Dialogue: 0,0:15:19.68,0:15:21.62,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:21.62,0:15:23.62,Default,,0,0,0,,Егер бұл бос бет болса
Dialogue: 0,0:15:23.62,0:15:25.99,Default,,0,0,0,,Келесі бет
Dialogue: 0,0:15:25.99,0:15:28.49,Default,,0,0,0,,Сіз жазуды жалғастырасыз.
Dialogue: 0,0:15:50.05,0:15:52.12,Default,,0,0,0,,Аяқ киім
Dialogue: 0,0:15:52.12,0:15:55.85,Default,,0,0,0,,Сіз ақыры ояндыңыз.
Dialogue: 0,0:15:55.85,0:15:57.85,Default,,0,0,0,,Мен не болды деп ойладым.
Dialogue: 0,0:15:59.79,0:16:02.96,Default,,0,0,0,,Не?
Dialogue: 0,0:16:02.96,0:16:05.66,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:07.87,0:16:11.07,Default,,0,0,0,,Өйткені мен кешірім сұрай аламын
Dialogue: 0,0:16:13.37,0:16:15.41,Default,,0,0,0,,Мәңгі және мәңгі
Dialogue: 0,0:16:15.41,0:16:19.11,Default,,0,0,0,,Сезіміңді байқамай тұра алмаймын.
Dialogue: 0,0:16:19.11,0:16:21.11,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:26.48,0:16:28.58,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:16:33.96,0:16:37.26,Default,,0,0,0,,Бұл өте айналма жол болды.
Dialogue: 0,0:16:37.26,0:16:40.16,Default,,0,0,0,,Екі жұлдыздың масштабтары қабаттасады
Dialogue: 0,0:16:40.16,0:16:42.90,Default,,0,0,0,,Таза ақ жарыққа айналады
Dialogue: 0,0:16:42.90,0:16:46.67,Default,,0,0,0,,Бұл сіздің жүрегіңіздегі бос орын
Dialogue: 0,0:16:46.67,0:16:49.57,Default,,0,0,0,,Немесе жаңа әлем
Dialogue: 0,0:16:49.57,0:16:53.17,Default,,0,0,0,,Бірдей
Dialogue: 0,0:16:59.38,0:17:01.38,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:17:08.33,0:17:10.93,Default,,0,0,0,,Schrade Бұл әуен
Dialogue: 0,0:17:16.87,0:17:20.47,Default,,0,0,0,,Бұл мен тапқан соңғы әуен
Dialogue: 0,0:17:20.47,0:17:24.34,Default,,0,0,0,,Жоқтан жасалған True Aquarion музыкасы
Dialogue: 0,0:17:24.34,0:17:28.24,Default,,0,0,0,,Иә
Dialogue: 0,0:17:37.39,0:17:39.32,Default,,0,0,0,,Өмір сүру деген нені білдіреді
Dialogue: 0,0:17:39.32,0:17:41.26,Default,,0,0,0,,Ою дегенді білдіреді.
Dialogue: 0,0:17:41.26,0:17:44.90,Default,,0,0,0,,Өмірмен ойнау
Dialogue: 0,0:17:44.90,0:17:47.70,Default,,0,0,0,,Жолыңды ойып алайық
Dialogue: 0,0:17:56.61,0:17:58.74,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:17:58.74,0:18:01.55,Default,,0,0,0,,Мен бұл туралы бұрын ешқашан армандаған емеспін
Dialogue: 0,0:18:01.55,0:18:03.48,Default,,0,0,0,,Біреу үшін
Dialogue: 0,0:18:03.48,0:18:05.68,Default,,0,0,0,,Өмір ойнап тұрғандай
Dialogue: 0,0:18:08.32,0:18:10.32,Default,,0,0,0,,Шрейд!
Dialogue: 0,0:18:47.69,0:18:49.69,Default,,0,0,0,,Шрейд!
Dialogue: 0,0:18:56.40,0:18:58.37,Default,,0,0,0,,Ол келді ме?
Dialogue: 0,0:18:58.37,0:19:01.07,Default,,0,0,0,,Менің зерттеуім
Dialogue: 0,0:19:16.22,0:19:19.22,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:19.22,0:19:23.33,Default,,0,0,0,,Жоқ... бұл біртүрлі.
Dialogue: 0,0:19:23.33,0:19:25.60,Default,,0,0,0,,Сіздің қазіргі сезімдеріңіз
Dialogue: 0,0:19:25.60,0:19:29.47,Default,,0,0,0,,Мен түсіндім деп ойлаймын.
Dialogue: 0,0:19:29.47,0:19:33.27,Default,,0,0,0,,A. Мифтер төгілген қаннан құралады.
Dialogue: 0,0:19:33.27,0:19:35.64,Default,,0,0,0,,Емле жоқ
Dialogue: 0,0:19:35.64,0:19:37.57,Default,,0,0,0,,Болашақ туралы мифтер
Dialogue: 0,0:19:37.57,0:19:39.77,Default,,0,0,0,,Қазір жаңадан қосылды
Dialogue: 0,0:19:55.06,0:19:57.66,Default,,0,0,0,,Амата! Амата
Dialogue: 0,0:19:59.83,0:20:02.73,Default,,0,0,0,,Амата!
Dialogue: 0,0:20:02.73,0:20:04.70,Default,,0,0,0,,Мен көптен күттім.
Dialogue: 0,0:20:04.70,0:20:06.80,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:20:09.51,0:20:11.61,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:20:20.48,0:20:23.48,Default,,0,0,0,,Иә
Dialogue: 0,0:20:40.80,0:20:44.04,Default,,0,0,0,,О
Dialogue: 0,0:20:44.04,0:20:47.04,Default,,0,0,0,,Қандай керемет!
Dialogue: 0,0:20:47.04,0:20:50.18,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:50.18,0:20:52.48,Default,,0,0,0,,Мен өз денемді ешқашан ойламадым
Dialogue: 0,0:20:52.48,0:20:55.99,Default,,0,0,0,,Сіз керемет денесіз
Dialogue: 0,0:20:55.99,0:21:01.23,Default,,0,0,0,,Енді мен көптен күткен арманымды орындай аламын.
Dialogue: 0,0:21:01.23,0:21:03.16,Default,,0,0,0,,Маған денемді қайтар
Dialogue: 0,0:21:03.16,0:21:07.03,Default,,0,0,0,,Уәделер орындалады
Dialogue: 0,0:21:07.03,0:21:09.00,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:21:09.00,0:21:11.94,Default,,0,0,0,,Менің атым Микадж
Dialogue: 0,0:21:11.94,0:21:15.31,Default,,0,0,0,,Махаббат көлеңкесінде өмір сүретіндер
Dialogue: 0,0:21:15.31,0:21:17.24,Default,,0,0,0,,Алғыс айту
Dialogue: 0,0:21:17.24,0:21:19.18,Default,,0,0,0,,Қанатсыз адам аспанның қанаттарын қалай сақтай алады?
Dialogue: 0,0:21:19.18,0:21:22.08,Default,,0,0,0,,Сирек
Dialogue: 0,0:21:22.08,0:21:25.28,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:21:25.28,0:21:28.48,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:21:30.82,0:21:33.12,Default,,0,0,0,,Кяааааааа төңкеріп!
Dialogue: 0,0:21:37.93,0:21:41.37,Default,,0,0,0,,Кагура
Dialogue: 0,0:21:41.37,0:21:44.57,Default,,0,0,0,,Бізге момын және шынайы Хауа ананы бер.
Dialogue: 0,0:21:44.57,0:21:47.44,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:21:47.44,0:21:49.87,Default,,0,0,0,,Боқ әйеліңді ешкімге берме.
Dialogue: 0,0:21:49.87,0:21:52.14,Default,,0,0,0,,Өйткені мен жалғыз лас әйелмін
Dialogue: 0,0:21:52.14,0:21:54.95,Default,,0,0,0,,Миконау!
Dialogue: 0,0:21:54.95,0:21:56.88,Default,,0,0,0,,Джессика
Dialogue: 0,0:21:56.88,0:21:59.12,Default,,0,0,0,,Мен
Dialogue: 0,0:21:59.12,0:22:02.45,Default,,0,0,0,,Біз байсалдылығын жоғалтқан бұл планетаның көшбасшысын жеңуіміз керек.
Dialogue: 0,0:22:02.45,0:22:05.32,Default,,0,0,0,,Шайқас ешқашан аяқталмайды! Джессика?
Dialogue: 0,0:22:05.32,0:22:07.96,Default,,0,0,0,,Сонымен
Dialogue: 0,0:22:07.96,0:22:09.89,Default,,0,0,0,,Күн акварионына қоңырау шалыңыз
Dialogue: 0,0:22:09.89,0:22:11.83,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:22:11.83,0:22:14.10,Default,,0,0,0,,Аполлон жанының мұрагері болсаң
Dialogue: 0,0:22:14.10,0:22:16.40,Default,,0,0,0,,Мен мұны істеуге болатынына сенімдімін
Dialogue: 0,0:22:16.40,0:22:18.40,Default,,0,0,0,,Иә
Dialogue: 0,0:22:22.07,0:22:26.97,Default,,0,0,0,,Арк Аэриорн
Dialogue: 0,0:22:41.53,0:22:43.53,Default,,0,0,0,,Бұл шынымен де келді
Dialogue: 0,0:22:51.87,0:22:53.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:07.75,0:23:10.59,Default,,0,0,0,,Күннің қанаттары
Dialogue: 0,0:23:10.59,0:23:13.19,Default,,0,0,0,,Менің жолыма бөгет боласың ба?
Dialogue: 0,0:23:16.96,0:23:18.90,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:23:18.90,0:23:21.87,Default,,0,0,0,,Сөзімізді бастайық па?
Dialogue: 0,0:23:21.87,0:23:24.37,Default,,0,0,0,,Нағыз мифтер
Dialogue: 0,0:24:57.06,0:24:59.00,Default,,0,0,0,,Көзіңді жұмсаң
Dialogue: 0,0:24:59.00,0:25:01.90,Default,,0,0,0,,Сіз әрқашан сол бейбіт таңға орала аласыз
Dialogue: 0,0:25:01.90,0:25:03.83,Default,,0,0,0,,Әлі де I
Dialogue: 0,0:25:03.83,0:25:06.24,Default,,0,0,0,,Көзіңді ашу керек
Dialogue: 0,0:25:06.24,0:25:10.54,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:27:31.05,0:27:33.05,Default,,0,0,0,,Дүние жүзі бойынша
Dialogue: 0,0:27:33.05,0:27:35.89,Default,,0,0,0,,Ол күшейе береді
Dialogue: 0,0:27:35.89,0:27:39.16,Default,,0,0,0,,Мифтік Акварион мөрінің сынуы
Dialogue: 0,0:27:39.16,0:27:42.06,Default,,0,0,0,,Бүкіл әлемге таралу
Dialogue: 0,0:27:42.06,0:27:44.36,Default,,0,0,0,,Аматаның және басқалардың қайда екенін де біле алмаймын.
Dialogue: 0,0:27:44.36,0:27:47.36,Default,,0,0,0,,Менің қосалқы ұшағыммен оны қайтадан басып алу үшін Альтаирге барудан басқа амалым жоқ.
Dialogue: 0,0:27:47.36,0:27:51.20,Default,,0,0,0,,Бірақ
Dialogue: 0,0:27:51.20,0:27:53.50,Default,,0,0,0,,Өлшемді тесемін
Dialogue: 0,0:27:53.50,0:27:56.27,Default,,0,0,0,,Е-е, бұл кездейсоқ туған құдірет.
Dialogue: 0,0:27:56.27,0:27:58.91,Default,,0,0,0,,Шрейдтің көмегімен
Dialogue: 0,0:27:58.91,0:28:01.81,Default,,0,0,0,,Сонда да мен бір рет жетістікке жеттім.
Dialogue: 0,0:28:01.81,0:28:04.71,Default,,0,0,0,,Біз мұны істей аламыз ба, Энди? Біз мұны осында істеуіміз керек.
Dialogue: 0,0:28:04.71,0:28:07.62,Default,,0,0,0,,Осы уақытқа дейін саңылауларды не үшін бұрғыладыңыз?
Dialogue: 0,0:28:07.62,0:28:09.82,Default,,0,0,0,,Мені жіберіңізші
Dialogue: 0,0:28:12.49,0:28:14.92,Default,,0,0,0,,Энди В. Холл
Dialogue: 0,0:28:14.92,0:28:17.82,Default,,0,0,0,,Өз күшіңізге ставка жасаңыз
Dialogue: 0,0:28:30.34,0:28:32.91,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:28:32.91,0:28:35.71,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:28:35.71,0:28:37.81,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:28:47.66,0:28:50.46,Default,,0,0,0,,Жолыңда күннің қанаты тұр ма?
Dialogue: 0,0:28:57.70,0:29:00.34,Default,,0,0,0,,Мақсат - шынайы Хауа ананы қамтамасыз ету.
Dialogue: 0,0:29:00.34,0:29:02.27,Default,,0,0,0,,Негізгі бөлікке тікелей соққылардан аулақ болыңыз
Dialogue: 0,0:29:02.27,0:29:04.27,Default,,0,0,0,,Тек ұрыс күшін алып тастаңыз
Dialogue: 0,0:29:06.48,0:29:09.11,Default,,0,0,0,,Кяаааааааааааааааааааа
Dialogue: 0,0:29:09.11,0:29:12.71,Default,,0,0,0,,Изумоның жігіті, жалап ал!
Dialogue: 0,0:29:18.76,0:29:21.46,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:29:31.90,0:29:34.80,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:29:34.80,0:29:37.44,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:29:37.44,0:29:39.54,Default,,0,0,0,,Не?
Dialogue: 0,0:29:42.25,0:29:45.55,Default,,0,0,0,,Гунистің отрядын бір сәтте жоюға жеткілікті күш.
Dialogue: 0,0:29:45.55,0:29:49.42,Default,,0,0,0,,Мен сізге екі есе соманы қайтарамын.
Dialogue: 0,0:29:49.42,0:29:51.39,Default,,0,0,0,,Екі есе қайтару
Dialogue: 0,0:29:51.39,0:29:53.39,Default,,0,0,0,,Сонда ол төңкерілген!
Dialogue: 0,0:29:58.13,0:30:00.46,Default,,0,0,0,,Төңкерілген күш?
Dialogue: 0,0:30:00.46,0:30:02.77,Default,,0,0,0,,Менің қосарланған қайтарымым ығыстырылған.
Dialogue: 0,0:30:02.77,0:30:05.80,Default,,0,0,0,,Изумо Мен өлсем де сол қарғыс атқыр әйелден бас тартпаймын.
Dialogue: 0,0:30:05.80,0:30:07.97,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:30:07.97,0:30:10.64,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:30:10.64,0:30:14.14,Default,,0,0,0,,Өйткені ол менің жалғыз әйелім.
Dialogue: 0,0:30:14.14,0:30:17.91,Default,,0,0,0,,Балаларға тән заттар
Dialogue: 0,0:30:17.91,0:30:20.01,Default,,0,0,0,,Құрметті Изумо
Dialogue: 0,0:30:22.45,0:30:25.05,Default,,0,0,0,,Әлгі ұрлаушы
Dialogue: 0,0:30:25.05,0:30:27.05,Default,,0,0,0,,Араластырыңыз
Dialogue: 0,0:30:29.39,0:30:31.33,Default,,0,0,0,,Альтеяның болашағы қандай?
Dialogue: 0,0:30:31.33,0:30:33.33,Default,,0,0,0,,Мен Изумо-самамен біргемін.
Dialogue: 0,0:30:36.17,0:30:38.77,Default,,0,0,0,,Барлығы
Dialogue: 0,0:30:50.71,0:30:53.88,Default,,0,0,0,,Бізде тек ер адамдар ғана қосылып жүргеніне көп уақыт болды.
Dialogue: 0,0:30:53.88,0:30:55.89,Default,,0,0,0,,Біз мақсатты нүктеге жетеміз
Dialogue: 0,0:30:55.89,0:30:59.29,Default,,0,0,0,,Тезірек барайық! Ерлерге толы қанды одақ!
Dialogue: 0,0:30:59.29,0:31:01.32,Default,,0,0,0,,Мұндай одақ бар ма? Эх
Dialogue: 0,0:31:01.32,0:31:04.13,Default,,0,0,0,,Ыстық қанды Масуара ер комбинациясы
Dialogue: 0,0:31:04.13,0:31:06.93,Default,,0,0,0,,GO Aquarion!
Dialogue: 0,0:31:12.80,0:31:15.50,Default,,0,0,0,,Акварион
Dialogue: 0,0:31:19.21,0:31:21.41,Default,,0,0,0,,Уууу
Dialogue: 0,0:31:25.98,0:31:28.89,Default,,0,0,0,,MIX Тіпті егер сіз
Dialogue: 0,0:31:28.89,0:31:30.85,Default,,0,0,0,,Қандай денеңіз болса да
Dialogue: 0,0:31:30.85,0:31:32.85,Default,,0,0,0,,Мен сені міндетті түрде алып кетемін
Dialogue: 0,0:31:36.16,0:31:38.86,Default,,0,0,0,,Мен оны MIX алдында айттым
Dialogue: 0,0:31:38.86,0:31:41.76,Default,,0,0,0,,Тесіктер - әлемді байланыстыратын тесіктер
Dialogue: 0,0:31:41.76,0:31:44.03,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:31:44.03,0:31:48.20,Default,,0,0,0,,Мен сізді өмір сүретін әлеммен міндетті түрде байланыстырамын.
Dialogue: 0,0:31:48.20,0:31:50.87,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:31:50.87,0:31:54.18,Default,,0,0,0,,Мен үлкен шұңқыр ашып, ішіне көмемін.
Dialogue: 0,0:31:54.18,0:31:56.28,Default,,0,0,0,,Үлкен тесік!
Dialogue: 0,0:32:15.40,0:32:17.33,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:32:17.33,0:32:19.57,Default,,0,0,0,,Псевдоөлшемді қақпа
Dialogue: 0,0:32:19.57,0:32:21.54,Default,,0,0,0,,Жоспар
Dialogue: 0,0:32:21.54,0:32:24.44,Default,,0,0,0,,Уууу
Dialogue: 0,0:32:30.68,0:32:32.62,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:32:32.62,0:32:35.52,Default,,0,0,0,,ＭＩＸ ！
Dialogue: 0,0:32:35.52,0:32:40.19,Default,,0,0,0,,Біреу
Dialogue: 0,0:32:40.19,0:32:44.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:32:44.06,0:32:46.53,Default,,0,0,0,,Уууу
Dialogue: 0,0:32:46.53,0:32:50.03,Default,,0,0,0,,Увааааааааааааааааааааааааааааа
Dialogue: 0,0:32:50.03,0:32:54.44,Default,,0,0,0,,Мұны тоқтатыңыз
Dialogue: 0,0:32:54.44,0:32:56.37,Default,,0,0,0,,Ол менің досым
Dialogue: 0,0:32:56.37,0:32:58.77,Default,,0,0,0,,Менің досым келе жатыр.
Dialogue: 0,0:33:03.11,0:33:05.05,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:33:05.05,0:33:08.55,Default,,0,0,0,,Чи
Dialogue: 0,0:33:08.55,0:33:10.55,Default,,0,0,0,,Амата-кун
Dialogue: 0,0:33:20.66,0:33:23.57,Default,,0,0,0,,Амата
Dialogue: 0,0:33:23.57,0:33:26.34,Default,,0,0,0,,Амата
Dialogue: 0,0:33:26.34,0:33:29.37,Default,,0,0,0,,Кім?
Dialogue: 0,0:33:29.37,0:33:32.14,Default,,0,0,0,,Амата
Dialogue: 0,0:33:32.14,0:33:34.24,Default,,0,0,0,,Амата
Dialogue: 0,0:33:42.35,0:33:44.29,Default,,0,0,0,,Бұл
Dialogue: 0,0:33:44.29,0:33:46.29,Default,,0,0,0,,Амата
Dialogue: 0,0:33:56.90,0:33:59.64,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:33:59.64,0:34:02.67,Default,,0,0,0,,Уау, төңкеріп
Dialogue: 0,0:34:02.67,0:34:04.81,Default,,0,0,0,,Құрметті Изумо
Dialogue: 0,0:34:04.81,0:34:08.11,Default,,0,0,0,,Уау, басыңды тік.
Dialogue: 0,0:34:10.71,0:34:13.42,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:34:13.42,0:34:15.82,Default,,0,0,0,,Өлтір, тоқта
Dialogue: 0,0:34:20.72,0:34:23.16,Default,,0,0,0,,Бұл ұшақ
Dialogue: 0,0:34:23.16,0:34:25.86,Default,,0,0,0,,Aquarion Gepard дегеніміз не?
Dialogue: 0,0:34:25.86,0:34:28.30,Default,,0,0,0,,Кенет ұрыс ортасында
Dialogue: 0,0:34:28.30,0:34:30.27,Default,,0,0,0,,Екі ұрлаушы және мифтік тип
Dialogue: 0,0:34:30.27,0:34:34.10,Default,,0,0,0,,Кайенді кім басқарады?
Dialogue: 0,0:34:34.10,0:34:36.97,Default,,0,0,0,,Миконо
Dialogue: 0,0:34:36.97,0:34:40.84,Default,,0,0,0,,MIX Бұл MIX ұшағы!
Dialogue: 0,0:34:40.84,0:34:43.28,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:34:43.28,0:34:45.31,Default,,0,0,0,,Миконо нысанаға алынды.
Dialogue: 0,0:34:45.31,0:34:48.89,Default,,0,0,0,,Амат пен Шрейд екі ұрлаушымен не болды?
Dialogue: 0,0:34:48.89,0:34:50.92,Default,,0,0,0,,Amata дегеніміз не?
Dialogue: 0,0:34:50.92,0:34:55.02,Default,,0,0,0,,Шрейд қайтыс болды.
Dialogue: 0,0:34:55.02,0:34:56.96,Default,,0,0,0,,Өлшемдер арасында
Dialogue: 0,0:34:56.96,0:35:01.36,Default,,0,0,0,,Соңғы әнді ойнату
Dialogue: 0,0:35:01.36,0:35:03.76,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:35:18.18,0:35:21.62,Default,,0,0,0,,Schrade…
Dialogue: 0,0:35:21.62,0:35:24.05,Default,,0,0,0,,Сіз де Изумо-саманың жолына түскіңіз келе ме?
Dialogue: 0,0:35:24.05,0:35:25.99,Default,,0,0,0,,Сіз не туралы айтып отырсыз? MIX
Dialogue: 0,0:35:25.99,0:35:28.26,Default,,0,0,0,,Мен сенің қайтып келгеніңді қалаймын
Dialogue: 0,0:35:28.26,0:35:31.13,Default,,0,0,0,,Оны қайтарып алу керек пе? MIX есте сақтаңыз
Dialogue: 0,0:35:31.13,0:35:34.46,Default,,0,0,0,,Мен
Dialogue: 0,0:35:34.46,0:35:38.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:38.07,0:35:40.37,Default,,0,0,0,,Сіздің сөздеріңіз жағымсыз!
Dialogue: 0,0:35:40.37,0:35:42.37,Default,,0,0,0,,ＭＩＸ
Dialogue: 0,0:35:46.51,0:35:48.75,Default,,0,0,0,,Қарашы, Кагура
Dialogue: 0,0:35:48.75,0:35:51.15,Default,,0,0,0,,Альтейді құтқарғыңыз келмей ме?
Dialogue: 0,0:35:51.15,0:35:53.08,Default,,0,0,0,,Осымен
Dialogue: 0,0:35:53.08,0:35:55.05,Default,,0,0,0,,Жұлдыздардың болашағы маңызды емес.
Dialogue: 0,0:35:55.05,0:35:58.89,Default,,0,0,0,,Маған бар болғаны әлгі әйел керек
Dialogue: 0,0:35:58.89,0:36:01.32,Default,,0,0,0,,Бүкіл дүние саған жау болса да
Dialogue: 0,0:36:01.32,0:36:04.23,Default,,0,0,0,,Мен ол қарғыс атқан әйелді жібермеймін
Dialogue: 0,0:36:04.23,0:36:08.23,Default,,0,0,0,,ＭＩＸ ＭＩＸ ！
Dialogue: 0,0:36:08.23,0:36:11.73,Default,,0,0,0,,Әйелге арналған иглар?
Dialogue: 0,0:36:14.87,0:36:16.87,Default,,0,0,0,,Алисия…
Dialogue: 0,0:36:24.65,0:36:27.32,Default,,0,0,0,,Маған қоңырау шалып жатқан дауыс
Dialogue: 0,0:36:27.32,0:36:29.25,Default,,0,0,0,,Сол жерден
Dialogue: 0,0:36:29.25,0:36:31.25,Default,,0,0,0,,Амата
Dialogue: 0,0:36:53.54,0:36:56.35,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,0:36:56.35,0:36:58.35,Default,,0,0,0,,Амата
Dialogue: 0,0:37:03.89,0:37:07.52,Default,,0,0,0,,Жұлдыздар мен жерде ұйықтап жатқан тіршілік
Dialogue: 0,0:37:07.52,0:37:09.49,Default,,0,0,0,,Мұның бәрі қазір
Dialogue: 0,0:37:09.49,0:37:13.00,Default,,0,0,0,,Оянуға жақын
Dialogue: 0,0:37:13.00,0:37:14.93,Default,,0,0,0,,Күн қанатының қайта тірілуі
Dialogue: 0,0:37:14.93,0:37:17.83,Default,,0,0,0,,Екі жүзді қылыш
Dialogue: 0,0:37:17.83,0:37:21.57,Default,,0,0,0,,Дүниені бөлетін күшке айнала ма?
Dialogue: 0,0:37:21.57,0:37:24.27,Default,,0,0,0,,Ол байланыстырушы күш бола ма?
Dialogue: 0,0:37:33.18,0:37:37.09,Default,,0,0,0,,Қайта оралыңыз MIX
Dialogue: 0,0:37:37.09,0:37:40.69,Default,,0,0,0,,Кеңістіктік өтемақы
Dialogue: 0,0:37:40.69,0:37:43.89,Default,,0,0,0,,Міне, біз тағы да қайталаймыз, бір нәрсе қайта-қайта.
Dialogue: 0,0:37:43.89,0:37:45.86,Default,,0,0,0,,Мен мұны қанша қаласам, сонша жасаймын
Dialogue: 0,0:37:45.86,0:37:48.33,Default,,0,0,0,,MIX-ті қолыма ұстағанша
Dialogue: 0,0:37:48.33,0:37:51.23,Default,,0,0,0,,Мен тесік ашамын, ал MIX оны жабады.
Dialogue: 0,0:37:51.23,0:37:54.23,Default,,0,0,0,,Осылайша бір-бірімізді түсіндік!
Dialogue: 0,0:37:56.57,0:37:58.57,Default,,0,0,0,,Иә
Dialogue: 0,0:37:58.57,0:38:02.78,Default,,0,0,0,,Ахх
Dialogue: 0,0:38:02.78,0:38:07.12,Default,,0,0,0,,Неліктен бұл бедеу әрекет қайталанады?
Dialogue: 0,0:38:07.12,0:38:09.12,Default,,0,0,0,,Әйтеуір сағыныш
Dialogue: 0,0:38:11.52,0:38:14.19,Default,,0,0,0,,Амата
Dialogue: 0,0:38:14.19,0:38:17.66,Default,,0,0,0,,Біз ақыры кездестік
Dialogue: 0,0:38:17.66,0:38:19.66,Default,,0,0,0,,Өсу
Dialogue: 0,0:38:22.90,0:38:24.83,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:38:24.83,0:38:27.34,Default,,0,0,0,,Мені тастап кетсең де
Dialogue: 0,0:38:27.34,0:38:31.24,Default,,0,0,0,,Осы уақытқа дейін қандай ойлармен өмір сүргенімді білесің бе?
Dialogue: 0,0:38:31.24,0:38:33.64,Default,,0,0,0,,Бұл қазір
Dialogue: 0,0:38:33.64,0:38:37.48,Default,,0,0,0,,Маған қоңырау шалыңыз
Dialogue: 0,0:38:37.48,0:38:39.48,Default,,0,0,0,,Амата
Dialogue: 0,0:38:42.62,0:38:45.22,Default,,0,0,0,,Кешірім сұрауға болмайды
Dialogue: 0,0:38:45.22,0:38:49.93,Default,,0,0,0,,Бірақ
Dialogue: 0,0:38:49.93,0:38:54.23,Default,,0,0,0,,Мен сені неге тастап кеттім?
Dialogue: 0,0:38:54.23,0:38:57.33,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:38:59.90,0:39:03.81,Default,,0,0,0,,Сенің әкең Жерден емес.
Dialogue: 0,0:39:03.81,0:39:06.48,Default,,0,0,0,,Изумо Камуроги
Dialogue: 0,0:39:06.48,0:39:08.68,Default,,0,0,0,,Альтеяның Жоғарғы Көшбасшысы
Dialogue: 0,0:39:13.72,0:39:15.72,Default,,0,0,0,,Бұл адам?
Dialogue: 0,0:39:20.92,0:39:23.63,Default,,0,0,0,,Мен жеңілуге шыдай алмаймын
Dialogue: 0,0:39:23.63,0:39:25.56,Default,,0,0,0,,Хауа ананың қарғысына
Dialogue: 0,0:39:25.56,0:39:27.60,Default,,0,0,0,,Рейглердің қасіреті туралы
Dialogue: 0,0:39:27.60,0:39:30.20,Default,,0,0,0,,Оған нүкте қою
Dialogue: 0,0:39:30.20,0:39:32.13,Default,,0,0,0,,Әкем
Dialogue: 0,0:39:32.13,0:39:35.81,Default,,0,0,0,,Өлшемді телепортацияға төтеп бере алатын әйелді қайтару миссиясында.
Dialogue: 0,0:39:35.81,0:39:39.78,Default,,0,0,0,,Жерге келді
Dialogue: 0,0:39:39.78,0:39:42.38,Default,,0,0,0,,Бұл мен әлі актриса болған кезім.
Dialogue: 0,0:40:33.66,0:40:37.47,Default,,0,0,0,,Жүйе ақаулығына байланысты мен Вегаға апатты түрде қондым.
Dialogue: 0,0:40:37.47,0:40:40.67,Default,,0,0,0,,Мені құтқарған адам
Dialogue: 0,0:40:40.67,0:40:44.47,Default,,0,0,0,,Алисия біз іздеген Рейглер екенін түсінгенше.
Dialogue: 0,0:40:44.47,0:40:47.84,Default,,0,0,0,,Бұл көпке созылмады.
Dialogue: 0,0:40:47.84,0:40:49.94,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:40:52.75,0:40:54.85,Default,,0,0,0,,Одан да көп
Dialogue: 0,0:40:57.32,0:40:59.32,Default,,0,0,0,,Бізді бір-бірімізге тартты
Dialogue: 0,0:41:11.20,0:41:14.40,Default,,0,0,0,,Кагураға күле алмайсың
Dialogue: 0,0:41:14.40,0:41:17.67,Default,,0,0,0,,Мен бір рет
Dialogue: 0,0:41:17.67,0:41:21.38,Default,,0,0,0,,Ол Альтейге опасыздық жасамақ болды.
Dialogue: 0,0:41:21.38,0:41:24.28,Default,,0,0,0,,Оның бар екенін жоғарғы басшылықтан құпия ұстау
Dialogue: 0,0:41:24.28,0:41:27.18,Default,,0,0,0,,Мен Альтеяға оралдым
Dialogue: 0,0:41:27.18,0:41:29.69,Default,,0,0,0,,Бірақ
Dialogue: 0,0:41:29.69,0:41:31.69,Default,,0,0,0,,Алдамаған
Dialogue: 0,0:41:39.43,0:41:43.90,Default,,0,0,0,,Араға жылдар салып, ол қайтадан пайда болған
Dialogue: 0,0:41:43.90,0:41:47.34,Default,,0,0,0,,Сіз сонда болдыңыз
Dialogue: 0,0:41:47.34,0:41:51.31,Default,,0,0,0,,Бірақ
Dialogue: 0,0:41:51.31,0:41:54.11,Default,,0,0,0,,Мен...
Dialogue: 0,0:41:54.11,0:41:56.81,Default,,0,0,0,,Мен барамын, жарай ма?
Dialogue: 0,0:41:56.81,0:41:59.35,Default,,0,0,0,,Рейглерге қалай қарайды?
Dialogue: 0,0:41:59.35,0:42:01.35,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:42:01.35,0:42:03.89,Default,,0,0,0,,Сіздің
Dialogue: 0,0:42:03.89,0:42:06.79,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:42:06.79,0:42:08.79,Default,,0,0,0,,Алисия
Dialogue: 0,0:42:15.46,0:42:17.43,Default,,0,0,0,,Мен сені өзіммен бірге ала кетейін бе?
Dialogue: 0,0:42:17.43,0:42:19.87,Default,,0,0,0,,Мен әбден абдырап қалдым.
Dialogue: 0,0:42:19.87,0:42:22.34,Default,,0,0,0,,Бірақ
Dialogue: 0,0:42:22.34,0:42:24.94,Default,,0,0,0,,Маған қауіп төндірме
Dialogue: 0,0:42:24.94,0:42:28.24,Default,,0,0,0,,Мазасыздық көбірек болды
Dialogue: 0,0:42:28.24,0:42:33.22,Default,,0,0,0,,Мен мұндай ұзақ қоштасу болады деп ойламаппын.
Dialogue: 0,0:42:33.22,0:42:36.52,Default,,0,0,0,,Жоқ
Dialogue: 0,0:42:36.52,0:42:39.42,Default,,0,0,0,,Мен сені тастап кеткен болуым керек
Dialogue: 0,0:42:39.42,0:42:43.09,Default,,0,0,0,,Мен сүйіктімнің жұлдызын жақсы көремін
Dialogue: 0,0:42:43.09,0:42:45.89,Default,,0,0,0,,Сүйікті адам
Dialogue: 0,0:42:57.74,0:43:01.34,Default,,0,0,0,,Мен сені әрқашан жек көретінмін
Dialogue: 0,0:43:05.68,0:43:08.38,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:43:11.12,0:43:13.06,Default,,0,0,0,,Мен жек көретін нәрсе
Dialogue: 0,0:43:13.06,0:43:15.39,Default,,0,0,0,,Менің қолымнан келгені тек оны шығарып салу болды.
Dialogue: 0,0:43:15.39,0:43:17.89,Default,,0,0,0,,Мен сол кезде
Dialogue: 0,0:43:17.89,0:43:20.50,Default,,0,0,0,,Сүйген адамыңның соңынан еру
Dialogue: 0,0:43:20.50,0:43:22.43,Default,,0,0,0,,Сізге
Dialogue: 0,0:43:22.43,0:43:25.90,Default,,0,0,0,,Менде жоқ еді.
Dialogue: 0,0:43:25.90,0:43:30.64,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:43:30.64,0:43:32.64,Default,,0,0,0,,Амата
Dialogue: 0,0:43:47.46,0:43:49.86,Default,,0,0,0,,Не болса да
Dialogue: 0,0:43:49.86,0:43:51.79,Default,,0,0,0,,Мен жеңілуге шыдай алмаймын
Dialogue: 0,0:43:51.79,0:43:55.73,Default,,0,0,0,,Алисияның құрбандығы бекер болмас үшін.
Dialogue: 0,0:43:55.73,0:43:58.57,Default,,0,0,0,,Мифтік акварион соғысуда
Dialogue: 0,0:43:58.57,0:44:00.50,Default,,0,0,0,,Изумо болды және
Dialogue: 0,0:44:00.50,0:44:02.47,Default,,0,0,0,,Басқа сіз
Dialogue: 0,0:44:02.47,0:44:05.37,Default,,0,0,0,,Кагура?
Dialogue: 0,0:44:05.37,0:44:08.24,Default,,0,0,0,,Менің анам
Dialogue: 0,0:44:08.24,0:44:10.24,Default,,0,0,0,,Темір теңіз
Dialogue: 0,0:44:25.19,0:44:28.63,Default,,0,0,0,,Не?
Dialogue: 0,0:44:28.63,0:44:30.67,Default,,0,0,0,,Альтеяның толық энергиясы тең
Dialogue: 0,0:44:30.67,0:44:33.07,Default,,0,0,0,,Біз Афра Гуниске назар аударамыз ба?
Dialogue: 0,0:44:41.51,0:44:43.51,Default,,0,0,0,,Альтеа зеңбірек
Dialogue: 0,0:44:54.09,0:44:56.39,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:44:56.39,0:44:58.39,Default,,0,0,0,,Не!
Dialogue: 0,0:45:09.41,0:45:13.88,Default,,0,0,0,,Бұл жарық Альтеяның құдіреті.
Dialogue: 0,0:45:13.88,0:45:15.88,Default,,0,0,0,,Izumome
Dialogue: 0,0:45:20.22,0:45:22.89,Default,,0,0,0,,Бұл жай ғана ескерту.
Dialogue: 0,0:45:22.89,0:45:25.49,Default,,0,0,0,,Мен саған шынайы Хауаны беруім керек.
Dialogue: 0,0:45:25.49,0:45:27.59,Default,,0,0,0,,Келесі жолы бар күшіңізбен атыңыз
Dialogue: 0,0:45:30.33,0:45:32.33,Default,,0,0,0,,Джессика
Dialogue: 0,0:45:32.33,0:45:34.33,Default,,0,0,0,,Не?
Dialogue: 0,0:45:41.94,0:45:44.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:44.01,0:45:46.01,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:45:51.11,0:45:53.11,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,0:46:03.49,0:46:05.93,Default,,0,0,0,,Кагура!
Dialogue: 0,0:46:05.93,0:46:08.83,Default,,0,0,0,,Алисия!
Dialogue: 0,0:46:08.83,0:46:11.23,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:46:16.11,0:46:18.47,Default,,0,0,0,,Жылау
Dialogue: 0,0:46:18.47,0:46:22.37,Default,,0,0,0,,Шексіз соққы
Dialogue: 0,0:46:29.85,0:46:32.29,Default,,0,0,0,,Уау
Dialogue: 0,0:46:32.29,0:46:34.79,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:46:38.79,0:46:40.89,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:46:48.37,0:46:50.91,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:46:50.91,0:46:55.18,Default,,0,0,0,,Бұл күш
Dialogue: 0,0:46:55.18,0:46:59.05,Default,,0,0,0,,Бұл сіздің әрекетіңіз бе?
Dialogue: 0,0:46:59.05,0:47:01.05,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:47:04.45,0:47:06.39,Default,,0,0,0,,Кяаааааааааааааааааааа
Dialogue: 0,0:47:06.39,0:47:08.69,Default,,0,0,0,,Сильфи!
Dialogue: 0,0:47:40.56,0:47:43.89,Default,,0,0,0,,Алисия…
Dialogue: 0,0:47:43.89,0:47:45.89,Default,,0,0,0,,Мықты
Dialogue: 0,0:47:53.90,0:47:56.81,Default,,0,0,0,,Мен анамды кездестірдім
Dialogue: 0,0:47:56.81,0:47:59.51,Default,,0,0,0,,Мен де сен туралы естідім.
Dialogue: 0,0:47:59.51,0:48:01.51,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:48:07.18,0:48:09.52,Default,,0,0,0,,Мені өзіңізбен бірге алыңыз.
Dialogue: 0,0:48:09.52,0:48:11.52,Default,,0,0,0,,Алисияға
Dialogue: 0,0:48:17.06,0:48:20.43,Default,,0,0,0,,Кешірім сұрауға сөз жоқ.
Dialogue: 0,0:48:20.43,0:48:23.93,Default,,0,0,0,,Менің анам сенен
Dialogue: 0,0:48:23.93,0:48:25.93,Default,,0,0,0,,Мен...
Dialogue: 0,0:48:31.17,0:48:33.11,Default,,0,0,0,,Яғни
Dialogue: 0,0:48:33.11,0:48:35.11,Default,,0,0,0,,Майфли?
Dialogue: 0,0:48:35.11,0:48:39.52,Default,,0,0,0,,Балалық шақ
Dialogue: 0,0:48:39.52,0:48:41.45,Default,,0,0,0,,Әйел жоғалады
Dialogue: 0,0:48:41.45,0:48:44.89,Default,,0,0,0,,Баяғыда жойылып кетуі керек еді
Dialogue: 0,0:48:44.89,0:48:46.89,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:48:53.90,0:48:57.37,Default,,0,0,0,,Бұл 337-аудан
Dialogue: 0,0:48:57.37,0:49:01.24,Default,,0,0,0,,Темір теңізінің қиындықтары жиі болатын жерлерде
Dialogue: 0,0:49:01.24,0:49:05.24,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:49:08.51,0:49:13.15,Default,,0,0,0,,Жер-Ана
Dialogue: 0,0:49:13.15,0:49:15.95,Default,,0,0,0,,Жердің берекесі молшылық әкеледі.
Dialogue: 0,0:49:15.95,0:49:20.12,Default,,0,0,0,,Әйелдік нышанмен бейнеленген
Dialogue: 0,0:49:20.12,0:49:23.66,Default,,0,0,0,,Әйел және еркек
Dialogue: 0,0:49:23.66,0:49:25.59,Default,,0,0,0,,Тек осы екі шектен шыққандықтан
Dialogue: 0,0:49:25.59,0:49:29.87,Default,,0,0,0,,Әлем
Dialogue: 0,0:49:29.87,0:49:35.37,Default,,0,0,0,,Адамдар да, жер де
Dialogue: 0,0:49:35.37,0:49:40.88,Default,,0,0,0,,Темір теңіз – жұлдызды жерден энергия алатын жүйе.
Dialogue: 0,0:49:40.88,0:49:42.81,Default,,0,0,0,,Бірақ сонымен бірге
Dialogue: 0,0:49:42.81,0:49:44.88,Default,,0,0,0,,Жұлдыздарда не бар
Dialogue: 0,0:49:44.88,0:49:48.35,Default,,0,0,0,,Мүмкін, ол ұрлық жасаған шығар
Dialogue: 0,0:49:48.35,0:49:50.42,Default,,0,0,0,,Егер
Dialogue: 0,0:49:50.42,0:49:54.66,Default,,0,0,0,,Мұның бәріне кінәлі – Темір теңіз
Dialogue: 0,0:49:54.66,0:49:58.03,Default,,0,0,0,,Өмір бойы
Dialogue: 0,0:49:58.03,0:50:00.43,Default,,0,0,0,,Бұл бекер болды ма?
Dialogue: 0,0:50:03.20,0:50:06.44,Default,,0,0,0,,Мықты бол, мен сені кездестіру үшін қиындық көрдім.
Dialogue: 0,0:50:06.44,0:50:09.64,Default,,0,0,0,,Әке.
Dialogue: 0,0:50:13.51,0:50:15.51,Default,,0,0,0,,Бекер емес
Dialogue: 0,0:50:21.38,0:50:23.38,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,0:50:27.06,0:50:29.32,Default,,0,0,0,,Алисия
Dialogue: 0,0:50:29.32,0:50:32.63,Default,,0,0,0,,Сіздің өміріңіз ешқашан босқа кетпейді
Dialogue: 0,0:50:32.63,0:50:35.86,Default,,0,0,0,,Өйткені мен бұл дүниеде Аматаны тастадым.
Dialogue: 0,0:50:35.86,0:50:38.86,Default,,0,0,0,,Бұл бала болуы керек
Dialogue: 0,0:50:42.27,0:50:44.54,Default,,0,0,0,,Амата
Dialogue: 0,0:50:44.54,0:50:48.11,Default,,0,0,0,,Сен біздің махаббатымыздың дәлелісің
Dialogue: 0,0:50:48.11,0:50:51.41,Default,,0,0,0,,Амата
Dialogue: 0,0:50:51.41,0:50:53.82,Default,,0,0,0,,Сіздің
Dialogue: 0,0:50:53.82,0:50:55.92,Default,,0,0,0,,Сізді басқалардан артық көретін адам
Dialogue: 0,0:50:58.55,0:51:01.82,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,0:51:01.82,0:51:04.02,Default,,0,0,0,,Анашым!
Dialogue: 0,0:51:46.87,0:51:50.14,Default,,0,0,0,,Менің тағдырлас әйелім
Dialogue: 0,0:51:50.14,0:51:52.07,Default,,0,0,0,,Сіздің шын есіміңіз кім?
Dialogue: 0,0:51:52.07,0:51:54.08,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:51:54.08,0:51:57.55,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:51:57.55,0:52:00.45,Default,,0,0,0,,Мен сенің бәрін жұтып алғым келеді
