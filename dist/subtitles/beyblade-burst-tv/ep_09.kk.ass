Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.67,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.89,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.97,0:00:18.85,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.39,0:00:24.14,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.23,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.77,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.40,0:00:33.53,Default,,0,0,0,,Жарайды 4-тур
Dialogue: 0,0:00:33.61,0:00:36.11,Default,,0,0,0,,Шуу Куренай мен Киодзи Арами арасындағы шайқас!
Dialogue: 0,0:00:36.20,0:00:38.45,Default,,0,0,0,,Біз қандай қорытындыға тап боламыз?
Dialogue: 0,0:00:38.53,0:00:41.24,Default,,0,0,0,,Қазіргі уақытта Куришу 1 ұпаймен алда.
Dialogue: 0,0:00:41.49,0:00:44.16,Default,,0,0,0,,Шу болса, бір-ақ жасайсың!
Dialogue: 0,0:00:44.25,0:00:45.83,Default,,0,0,0,,Бір ату КО
Dialogue: 0,0:00:46.17,0:00:48.00,Default,,0,0,0,,Эй, сәлем
Dialogue: 0,0:00:48.08,0:00:50.30,Default,,0,0,0,,Енді салқын әрекет ететін уақыт.
Dialogue: 0,0:00:50.50,0:00:53.09,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:00:53.17,0:00:56.97,Default,,0,0,0,,Себебі ол сәл ессіз және күшті және қыздар арасында танымал.
Dialogue: 0,0:00:57.05,0:00:58.64,Default,,0,0,0,,Шукун
Dialogue: 0,0:00:58.72,0:01:00.18,Default,,0,0,0,,Ішек
Dialogue: 0,0:01:00.26,0:01:01.85,Default,,0,0,0,,Алаңдамаңыз
Dialogue: 0,0:01:01.93,0:01:03.85,Default,,0,0,0,,Идиот! Сегізаяқ! Сәлем!
Dialogue: 0,0:01:03.93,0:01:06.06,Default,,0,0,0,,Бұл өте шулы нәрсе.
Dialogue: 0,0:01:06.14,0:01:09.48,Default,,0,0,0,,Бұл оларды ашуландырып, зейінін шоғырландырудан сақтайтын стратегия болса керек.
Dialogue: 0,0:01:09.56,0:01:11.23,Default,,0,0,0,,Мен кішкентай нысанмын.
Dialogue: 0,0:01:11.32,0:01:12.78,Default,,0,0,0,,Айтқандай
Dialogue: 0,0:01:12.98,0:01:15.20,Default,,0,0,0,,О, менің қарағым Хебой Барто да
Dialogue: 0,0:01:15.28,0:01:16.95,Default,,0,0,0,,Ол сондай бейшара жігіт.
Dialogue: 0,0:01:17.03,0:01:19.28,Default,,0,0,0,,Хебоның достары Хебо ма?
Dialogue: 0,0:01:19.78,0:01:23.04,Default,,0,0,0,,Не! Хебо деген кім!
Dialogue: 0,0:01:23.12,0:01:24.25,Default,,0,0,0,,Мені мінгізбе
Dialogue: 0,0:01:24.33,0:01:25.79,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:01:26.33,0:01:28.46,Default,,0,0,0,,Аузыңызды қозғалтпаңыз, зейініңізді аударыңыз.
Dialogue: 0,0:01:28.79,0:01:29.92,Default,,0,0,0,,Ке...!
Dialogue: 0,0:01:30.00,0:01:32.09,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:01:32.17,0:01:35.63,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:01:35.72,0:01:37.84,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:01:39.09,0:01:41.05,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:01:41.14,0:01:43.35,Default,,0,0,0,,Қайсысы үздік 4-ке кіреді?
Dialogue: 0,0:01:46.27,0:01:47.94,Default,,0,0,0,,Киодзи Арами
Dialogue: 0,0:01:48.35,0:01:51.15,Default,,0,0,0,,Оның шығанақ үні аздап дірілдеп тұр.
Dialogue: 0,0:01:51.77,0:01:54.19,Default,,0,0,0,,Куришудың алдында қорқасың.
Dialogue: 0,0:01:55.86,0:01:57.78,Default,,0,0,0,,Куришудың Спригганы
Dialogue: 0,0:01:58.86,0:02:00.74,Default,,0,0,0,,асыл және сақ
Dialogue: 0,0:02:00.82,0:02:02.28,Default,,0,0,0,,және күшті
Dialogue: 0,0:02:02.83,0:02:04.24,Default,,0,0,0,,Жақында келесіз бе?
Dialogue: 0,0:02:04.83,0:02:05.66,Default,,0,0,0,,Анна…
Dialogue: 0,0:02:07.00,0:02:07.87,Default,,0,0,0,,Жасау…
Dialogue: 0,0:02:09.08,0:02:09.96,Default,,0,0,0,,Троа!
Dialogue: 0,0:02:10.04,0:02:12.50,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:02:12.71,0:02:14.50,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:02:15.09,0:02:17.55,Default,,0,0,0,,Куришуу 3-0
Dialogue: 0,0:02:17.63,0:02:19.22,Default,,0,0,0,,Қандай керемет жеңіс!
Dialogue: 0,0:02:19.34,0:02:20.72,Default,,0,0,0,,Керемет
Dialogue: 0,0:02:20.80,0:02:22.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:22.22,0:02:23.68,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:02:23.76,0:02:25.93,Default,,0,0,0,,Ол менің қарсыласым!
Dialogue: 0,0:02:33.82,0:02:36.19,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:02:36.53,0:02:41.70,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:53.00,0:02:56.38,Default,,0,0,0,,Әркімде бар екеніне сенімдімін.
Dialogue: 0,0:02:56.88,0:02:59.01,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:59.42,0:03:03.55,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:03:03.68,0:03:06.89,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:03:07.02,0:03:13.44,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:03:13.73,0:03:18.15,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:03:18.65,0:03:24.07,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:03:24.20,0:03:26.45,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:26.53,0:03:31.25,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:03:31.41,0:03:36.50,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:03:36.79,0:03:39.05,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:03:39.26,0:03:41.59,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:03:41.88,0:03:45.80,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:03:45.97,0:03:50.98,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:51.18,0:03:53.35,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:57.61,0:03:59.73,Default,,0,0,0,,Сіздің жолыңызда винт тұр!
Dialogue: 0,0:04:01.24,0:04:02.36,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:04:02.45,0:04:06.12,Default,,0,0,0,,Йонекома аудандық турнирінің үздік төрттігімен таныстыру!
Dialogue: 0,0:04:06.70,0:04:09.54,Default,,0,0,0,,Блок өкілі Аои Барто
Dialogue: 0,0:04:09.62,0:04:12.83,Default,,0,0,0,,B блогының өкілі Комурасаки Вакия
Dialogue: 0,0:04:12.91,0:04:16.04,Default,,0,0,0,,C блогының өкілі Ginblade Orochi
Dialogue: 0,0:04:16.13,0:04:19.17,Default,,0,0,0,,D блогының өкілі Куришуу
Dialogue: 0,0:04:19.25,0:04:22.55,Default,,0,0,0,,Сол жүзшілерге үлкен қошемет~
Dialogue: 0,0:04:22.63,0:04:24.59,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:25.05,0:04:26.76,Default,,0,0,0,,Жарайсың Балто
Dialogue: 0,0:04:26.84,0:04:28.93,Default,,0,0,0,,Біз осы уақытқа дейін жеттік.
Dialogue: 0,0:04:29.01,0:04:29.97,Default,,0,0,0,,Ах
Dialogue: 0,0:04:30.06,0:04:31.98,Default,,0,0,0,,Себебі мен Шуға уәде бергенмін
Dialogue: 0,0:04:32.06,0:04:34.39,Default,,0,0,0,,Финалдағы шайқас
Dialogue: 0,0:04:34.48,0:04:35.44,Default,,0,0,0,,♬~
Dialogue: 0,0:04:37.02,0:04:38.73,Default,,0,0,0,,Шу қаласы ше?
Dialogue: 0,0:04:38.82,0:04:40.65,Default,,0,0,0,,Тәжірибе бар.
Dialogue: 0,0:04:40.73,0:04:42.11,Default,,0,0,0,,Мен үйге тез қайттым.
Dialogue: 0,0:04:42.19,0:04:43.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:43.49,0:04:45.03,Default,,0,0,0,,Мен жеңіле алмаймын.
Dialogue: 0,0:04:45.11,0:04:47.74,Default,,0,0,0,,Жарайды, үйге барып жаттығу жасайық.
Dialogue: 0,0:04:47.82,0:04:51.24,Default,,0,0,0,,Күте тұрыңыз, Бал-ни, Ника жуынатын бөлмеден қайтып келген жоқ.
Dialogue: 0,0:04:51.45,0:04:53.16,Default,,0,0,0,,Мүмкін мен адасып қалған шығармын
Dialogue: 0,0:04:53.25,0:04:54.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:55.54,0:04:59.50,Default,,0,0,0,,(Есікті ашуға тырысқан дыбыс)
Dialogue: 0,0:04:59.71,0:05:01.88,Default,,0,0,0,,Не? Ол ашылмайды...
Dialogue: 0,0:05:01.96,0:05:04.92,Default,,0,0,0,,Мен не істеуім керек? Ол ашылмайды.
Dialogue: 0,0:05:05.01,0:05:07.80,Default,,0,0,0,,Үлкен ағасы Кумичо
Dialogue: 0,0:05:07.89,0:05:10.60,Default,,0,0,0,,Шукун
Dialogue: 0,0:05:10.68,0:05:12.02,Default,,0,0,0,,Уф
Dialogue: 0,0:05:12.10,0:05:13.98,Default,,0,0,0,,Эй, кішкентай бала, сен өте шулысың.
Dialogue: 0,0:05:14.18,0:05:15.48,Default,,0,0,0,,Тез шық
Dialogue: 0,0:05:15.56,0:05:16.44,Default,,0,0,0,,Не? Ит пе?
Dialogue: 0,0:05:17.02,0:05:18.90,Default,,0,0,0,,Ника~
Dialogue: 0,0:05:19.19,0:05:21.77,Default,,0,0,0,,А, Ника, мен сені іздедім.
Dialogue: 0,0:05:21.86,0:05:23.23,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:05:23.53,0:05:25.32,Default,,0,0,0,,Үйге дұрыс емес жол
Dialogue: 0,0:05:25.40,0:05:27.20,Default,,0,0,0,,Мен қоймада қамалып отырмын.
Dialogue: 0,0:05:27.66,0:05:29.95,Default,,0,0,0,,Сонда ол адам...
Dialogue: 0,0:05:31.12,0:05:33.16,Default,,0,0,0,,Маған көмектестіңіз бе?
Dialogue: 0,0:05:33.24,0:05:34.58,Default,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,0:05:34.66,0:05:36.41,Default,,0,0,0,,А...а?
Dialogue: 0,0:05:36.50,0:05:37.71,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:37.83,0:05:40.21,Default,,0,0,0,,Ол дос емес жігіт.
Dialogue: 0,0:05:41.00,0:05:42.55,Default,,0,0,0,,Күміс жүзі Орочи
Dialogue: 0,0:05:42.88,0:05:44.63,Default,,0,0,0,,Әлемге әйгілі дирижердің ұлы.
Dialogue: 0,0:05:45.30,0:05:47.97,Default,,0,0,0,,Оны құдай құлағы бар бала дейді.
Dialogue: 0,0:05:48.22,0:05:49.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:49.97,0:05:51.93,Default,,0,0,0,,Оның дыбыс деңгейін жақсы сезінеді.
Dialogue: 0,0:05:52.01,0:05:54.64,Default,,0,0,0,,Сіз жарылған мәренің алдын ала болжамын көре аласыз ба?
Dialogue: 0,0:05:54.72,0:05:56.02,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:05:56.10,0:05:58.27,Default,,0,0,0,,(фортепиано пьесасы)
Dialogue: 0,0:05:58.98,0:06:00.44,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:06:01.36,0:06:03.61,Default,,0,0,0,,Оның дыбысы күшті, бірақ әлсіз болып көрінеді
Dialogue: 0,0:06:04.07,0:06:05.82,Default,,0,0,0,,Әлсіз, бірақ күшті көрінеді
Dialogue: 0,0:06:06.44,0:06:07.86,Default,,0,0,0,,Бұл біртүрлі дыбыс болды
Dialogue: 0,0:06:08.70,0:06:09.99,Default,,0,0,0,,Тағы да-
Dialogue: 0,0:06:10.07,0:06:11.82,Default,,0,0,0,,Мен бұл дыбысты естігім келеді
Dialogue: 0,0:06:15.70,0:06:16.75,Default,,0,0,0,,О
Dialogue: 0,0:06:17.87,0:06:21.17,Default,,0,0,0,,Менің ойымша, сіздің қабілетіңіз көп емес.
Dialogue: 0,0:06:21.25,0:06:24.30,Default,,0,0,0,,Кенеттен жарылғыш күш шығады
Dialogue: 0,0:06:26.05,0:06:28.93,Default,,0,0,0,,Хоудзи Балт Аои күшті болды ма?
Dialogue: 0,0:06:29.43,0:06:31.55,Default,,0,0,0,,Иә, күшті болды.
Dialogue: 0,0:06:31.64,0:06:32.51,Default,,0,0,0,,Тек...
Dialogue: 0,0:06:33.18,0:06:35.31,Default,,0,0,0,,Тек... не?
Dialogue: 0,0:06:35.39,0:06:38.48,Default,,0,0,0,,Мен қалыпты күштен сәл басқаша сезінемін...
Dialogue: 0,0:06:38.56,0:06:40.48,Default,,0,0,0,,Жақсы айта алмаймын, бірақ
Dialogue: 0,0:06:40.56,0:06:42.48,Default,,0,0,0,,Бэймен сөйлесіп тұрған сияқтымын...
Dialogue: 0,0:06:44.94,0:06:47.86,Default,,0,0,0,,Мен ойлағаннан да қызық сияқты.
Dialogue: 0,0:06:47.94,0:06:50.53,Default,,0,0,0,,Маған ұнады, Аои Барто
Dialogue: 0,0:06:51.03,0:06:52.41,Default,,0,0,0,,Иә
Dialogue: 0,0:06:52.49,0:06:54.83,Default,,0,0,0,,Мен қолданып көргім келген техниканы жаңа ғана аяқтадым.
Dialogue: 0,0:06:55.91,0:06:57.41,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:06:57.91,0:06:59.25,Default,,0,0,0,,Е!
Dialogue: 0,0:06:59.87,0:07:01.58,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:01.92,0:07:04.17,Default,,0,0,0,,Балто, маған тез көмектесіңізші.
Dialogue: 0,0:07:04.50,0:07:07.30,Default,,0,0,0,,Осы мөлшердегі нанға не болды?
Dialogue: 0,0:07:07.76,0:07:10.80,Default,,0,0,0,,Дәл қазір мен кенеттен нанға тапсырыс алдым.
Dialogue: 0,0:07:10.88,0:07:14.39,Default,,0,0,0,,Ал, мен Кумичомен және басқалармен жаттығуға барамын.
Dialogue: 0,0:07:14.47,0:07:17.14,Default,,0,0,0,,Әй, бұл ұят.
Dialogue: 0,0:07:17.22,0:07:20.64,Default,,0,0,0,,Бүгін мен Бейге жаттығу жасаймын, мен саған құпия әдісті үйретемін...
Dialogue: 0,0:07:20.73,0:07:22.31,Default,,0,0,0,,Тренинг? құпия?
Dialogue: 0,0:07:22.40,0:07:24.23,Default,,0,0,0,,Бұл не? Бұл таңқаларлық па?
Dialogue: 0,0:07:24.44,0:07:25.90,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:07:26.36,0:07:30.90,Default,,0,0,0,,Дене күші! Сот! Лезде! Икемділік!
Dialogue: 0,0:07:30.99,0:07:34.53,Default,,0,0,0,,Олардың барлығын жаттықтыруға мүмкіндік беретін құпия әдістеме.
Dialogue: 0,0:07:34.95,0:07:36.28,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:36.91,0:07:38.12,Default,,0,0,0,,«Әскери полиция корпусына деген күдік күшейіп барады»…
Dialogue: 0,0:07:38.74,0:07:42.92,Default,,0,0,0,,Енді қалған 130 нанды аяқтап, жеткізуіміз керек.
Dialogue: 0,0:07:43.00,0:07:44.88,Default,,0,0,0,,3 сағаттан аз уақыт қалды!
Dialogue: 0,0:07:44.96,0:07:47.17,Default,,0,0,0,,Бұл өтірік болуы керек~
Dialogue: 0,0:07:47.38,0:07:50.34,Default,,0,0,0,,Ах, бірақ жаттығу болса көмектесе алмайды.
Dialogue: 0,0:07:50.42,0:07:51.88,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:07:54.39,0:07:56.80,Default,,0,0,0,,Ах~ 300 дана аяқталды~
Dialogue: 0,0:07:57.39,0:08:00.02,Default,,0,0,0,,Бүгінгі тренинг... Керемет емес.
Dialogue: 0,0:08:00.52,0:08:01.98,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:08:02.06,0:08:03.35,Default,,0,0,0,,Мен қозғала алмаймын...
Dialogue: 0,0:08:03.94,0:08:04.98,Default,,0,0,0,,Барт
Dialogue: 0,0:08:05.06,0:08:06.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:06.11,0:08:08.52,Default,,0,0,0,,Баратын жер Комурасакидің үйі
Dialogue: 0,0:08:08.61,0:08:09.94,Default,,0,0,0,,Иә Карта
Dialogue: 0,0:08:10.40,0:08:11.61,Default,,0,0,0,,Сіз оны оқи аласыз, солай ма?
Dialogue: 0,0:08:13.11,0:08:15.03,Default,,0,0,0,,Комурасаки...?
Dialogue: 0,0:08:15.11,0:08:17.95,Default,,0,0,0,,Мен мұны бір жерден естігендей болдым...
Dialogue: 0,0:08:18.03,0:08:20.70,Default,,0,0,0,,(көліктің жүгіре бастаған дыбысы)
Dialogue: 0,0:08:23.54,0:08:25.42,Default,,0,0,0,,(Өтіп бара жатқан көліктердің дыбысы)
Dialogue: 0,0:08:25.50,0:08:26.96,Default,,0,0,0,,(Көлік тежегішінің дыбысы)
Dialogue: 0,0:08:27.04,0:08:28.59,Default,,0,0,0,,(Көліктің жүгіру дыбысы)
Dialogue: 0,0:08:29.38,0:08:30.25,Default,,0,0,0,,Әлде бұл жыныстық сипаттағы қорлау үшін сылтау ма?
Dialogue: 0,0:08:30.80,0:08:32.17,Default,,0,0,0,,Сәлем Балто~
Dialogue: 0,0:08:32.26,0:08:33.84,Default,,0,0,0,,Мен мұнда бірнеше рет болдым.
Dialogue: 0,0:08:33.92,0:08:34.97,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:08:35.05,0:08:36.59,Default,,0,0,0,,Мен жаңа ғана өтіп кеттім!
Dialogue: 0,0:08:44.85,0:08:46.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:47.52,0:08:49.73,Default,,0,0,0,,Сіз Ginblade Orochiсіз, солай ма?
Dialogue: 0,0:08:49.82,0:08:51.48,Default,,0,0,0,,Сол кезде апам маған рахмет айтты~
Dialogue: 0,0:08:51.61,0:08:53.24,Default,,0,0,0,,I Барто Аои
Dialogue: 0,0:08:53.32,0:08:55.40,Default,,0,0,0,,Орочи, сен бұл туралы бірдеңе білесің бе?
Dialogue: 0,0:08:55.86,0:08:57.62,Default,,0,0,0,,Сіз мұны түсінесіз бе?
Dialogue: 0,0:08:58.49,0:08:59.78,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:08:59.87,0:09:01.83,Default,,0,0,0,,О~ Түсіндің бе?
Dialogue: 0,0:09:01.91,0:09:03.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:03.50,0:09:06.12,Default,,0,0,0,,Жүр, маған қазір көрсет.
Dialogue: 0,0:09:06.21,0:09:06.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:06.87,0:09:09.21,Default,,0,0,0,,Бұл өте жаман, мін, мін
Dialogue: 0,0:09:09.63,0:09:12.30,Default,,0,0,0,,Бұл кішкентай, бірақ өтінемін.
Dialogue: 0,0:09:13.42,0:09:15.30,Default,,0,0,0,,Мен сені күттім, Балто.
Dialogue: 0,0:09:15.63,0:09:16.72,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:16.80,0:09:18.55,Default,,0,0,0,,Бұл Хоудзидің үйі ме?
Dialogue: 0,0:09:18.64,0:09:20.60,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:09:20.68,0:09:21.72,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:22.18,0:09:23.10,Default,,0,0,0,,Орочи…
Dialogue: 0,0:09:23.77,0:09:25.89,Default,,0,0,0,,Бұл Комурасаки Вакияның үйі
Dialogue: 0,0:09:25.98,0:09:27.98,Default,,0,0,0,,Дұрыс, Хоудзи Конта
Dialogue: 0,0:09:28.06,0:09:30.82,Default,,0,0,0,,Не! Екеуің бір-біріңді танисыңдар ма?
Dialogue: 0,0:09:30.90,0:09:31.98,Default,,0,0,0,,Орочи...?
Dialogue: 0,0:09:32.44,0:09:34.32,Default,,0,0,0,,Вакия күтіп тұр, солай ма?
Dialogue: 0,0:09:34.74,0:09:36.20,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:09:36.36,0:09:37.41,Default,,0,0,0,,Хмм?
Dialogue: 0,0:09:37.49,0:09:39.12,Default,,0,0,0,,Балт, менімен бірге жүр.
Dialogue: 0,0:09:39.66,0:09:42.16,Default,,0,0,0,,А, мен әлі нан жеткізіп жатырмын...
Dialogue: 0,0:09:42.74,0:09:44.66,Default,,0,0,0,,Бұл сенің досыңның үйі ме?
Dialogue: 0,0:09:44.75,0:09:47.54,Default,,0,0,0,,Жарайды, қалғанын шешем шешеді.
Dialogue: 0,0:09:48.00,0:09:49.00,Default,,0,0,0,,Кетіңіз
Dialogue: 0,0:09:49.08,0:09:50.75,Default,,0,0,0,,Ангато! анам
Dialogue: 0,0:09:54.51,0:09:57.38,Default,,0,0,0,,Жертөледе не бар? Апыр-ай!
Dialogue: 0,0:09:57.47,0:10:00.26,Default,,0,0,0,,Уакия Шуды ғана көреді
Dialogue: 0,0:10:00.34,0:10:01.51,Default,,0,0,0,,Күрсін
Dialogue: 0,0:10:01.72,0:10:04.18,Default,,0,0,0,,Бүгін мен қызықты дыбыстарды естимін деп ойлаймын.
Dialogue: 0,0:10:04.47,0:10:05.52,Default,,0,0,0,,О
Dialogue: 0,0:10:05.81,0:10:07.14,Default,,0,0,0,,келді!
Dialogue: 0,0:10:09.85,0:10:12.11,Default,,0,0,0,,Ой, стадион бар.
Dialogue: 0,0:10:12.19,0:10:14.32,Default,,0,0,0,,Сәлем, Балто
Dialogue: 0,0:10:14.78,0:10:16.15,Default,,0,0,0,,Уакия~
Dialogue: 0,0:10:16.24,0:10:17.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:17.24,0:10:18.53,Default,,0,0,0,,Орочи?
Dialogue: 0,0:10:18.74,0:10:20.74,Default,,0,0,0,,Маған телефон соқпағаныңызға сенімдімін.
Dialogue: 0,0:10:20.82,0:10:23.70,Default,,0,0,0,,Уайымдамаңыз, мен жай ғана көрерменмін.
Dialogue: 0,0:10:24.16,0:10:25.16,Default,,0,0,0,,Әй
Dialogue: 0,0:10:26.62,0:10:27.75,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:10:27.83,0:10:28.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:28.91,0:10:30.21,Default,,0,0,0,,Бұл
Dialogue: 0,0:10:30.29,0:10:32.21,Default,,0,0,0,,Мен қазір сендермен жарыспақпын.
Dialogue: 0,0:10:32.54,0:10:33.54,Default,,0,0,0,,А...?
Dialogue: 0,0:10:33.92,0:10:36.96,Default,,0,0,0,,Матч алдында менімен төбелесуге болады.
Dialogue: 0,0:10:37.05,0:10:38.63,Default,,0,0,0,,Бұл құрмет.
Dialogue: 0,0:10:38.72,0:10:40.64,Default,,0,0,0,,Ұрыс көп болса ғой
Dialogue: 0,0:10:40.72,0:10:43.30,Default,,0,0,0,,Неге біздің клубқа қосылмайсыз?
Dialogue: 0,0:10:43.39,0:10:44.85,Default,,0,0,0,,Ха...
Dialogue: 0,0:10:44.93,0:10:48.93,Default,,0,0,0,,Ең жақсы жаттығу машиналары осында.
Dialogue: 0,0:10:49.02,0:10:50.39,Default,,0,0,0,,Балалар сендер сияқты
Dialogue: 0,0:10:50.48,0:10:53.61,Default,,0,0,0,,Тек көңіл көтеру үшін құрылған достар клубы дегеніміз не? Заттар қымбаттайды.
Dialogue: 0,0:10:53.81,0:10:57.28,Default,,0,0,0,,Не? Біз де қатты жаттығу жасадық.
Dialogue: 0,0:10:57.49,0:10:59.07,Default,,0,0,0,,Еңбек ету...?
Dialogue: 0,0:10:59.15,0:11:00.45,Default,,0,0,0,,Балалар?
Dialogue: 0,0:11:00.53,0:11:01.99,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:02.07,0:11:03.74,Default,,0,0,0,,Қызықты нәрсе айтыңыз
Dialogue: 0,0:11:03.82,0:11:05.58,Default,,0,0,0,,Букчин!
Dialogue: 0,0:11:05.66,0:11:09.04,Default,,0,0,0,,Жарайды, мына матчты алайық!
Dialogue: 0,0:11:11.04,0:11:12.54,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:11:12.63,0:11:13.83,Default,,0,0,0,,Ku...
Dialogue: 0,0:11:13.92,0:11:14.92,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:11:18.46,0:11:21.76,Default,,0,0,0,,Оның тұлғасы түсінікті эмоционалды.
Dialogue: 0,0:11:22.51,0:11:24.89,Default,,0,0,0,,Мен бұл жігіттің Хоудзиді ұрғанына сене алар емеспін...
Dialogue: 0,0:11:25.76,0:11:28.06,Default,,0,0,0,,Бұл позиция асығыс ату.
Dialogue: 0,0:11:28.68,0:11:30.48,Default,,0,0,0,,Идиот бір нәрсені есіне алды ма?
Dialogue: 0,0:11:31.06,0:11:33.85,Default,,0,0,0,,Вакия Виверн қорғаныс түрі болып табылады.
Dialogue: 0,0:11:34.02,0:11:36.90,Default,,0,0,0,,Valkyrie шабуыл түрі үйлесімді емес
Dialogue: 0,0:11:37.57,0:11:40.95,Default,,0,0,0,,Енді не істеуіміз керек? Барто Аои
Dialogue: 0,0:11:41.61,0:11:43.45,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:11:44.07,0:11:47.03,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:47.58,0:11:49.83,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:50.58,0:11:52.54,Default,,0,0,0,,Сәлем! Оян!
Dialogue: 0,0:11:52.62,0:11:55.17,Default,,0,0,0,,Мұны кім жасады? Эй
Dialogue: 0,0:11:56.25,0:11:57.29,Default,,0,0,0,,...мм
Dialogue: 0,0:11:57.71,0:12:00.92,Default,,0,0,0,,Иә? Кумичо (Рантаро) О!
Dialogue: 0,0:12:01.01,0:12:02.05,Default,,0,0,0,,Жақсы
Dialogue: 0,0:12:02.13,0:12:03.72,Default,,0,0,0,,Ол тірі болды.
Dialogue: 0,0:12:03.80,0:12:04.47,Default,,0,0,0,,Е...
Dialogue: 0,0:12:04.55,0:12:06.85,Default,,0,0,0,,Әй, Балто қайда кетті?
Dialogue: 0,0:12:06.93,0:12:08.64,Default,,0,0,0,,Эй Бар-нии
Dialogue: 0,0:12:08.72,0:12:10.93,Default,,0,0,0,,Комурасакиге жеткізілді...
Dialogue: 0,0:12:11.02,0:12:12.98,Default,,0,0,0,,Нани~
Dialogue: 0,0:12:13.06,0:12:14.85,Default,,0,0,0,,Бұл кішкентай күлгін!
Dialogue: 0,0:12:14.94,0:12:18.61,Default,,0,0,0,,Әлгі мыңжапырақ сондай қорқынышты еліктеуші еді.
Dialogue: 0,0:12:18.69,0:12:19.28,Default,,0,0,0,,Эй
Dialogue: 0,0:12:19.36,0:12:20.53,Default,,0,0,0,,Рэм де көмектеседі.
Dialogue: 0,0:12:20.61,0:12:23.49,Default,,0,0,0,,Біз оларды міндетті түрде құтқарамыз.
Dialogue: 0,0:12:23.74,0:12:25.78,Default,,0,0,0,,Кеттік! Екеуміз де!
Dialogue: 0,0:12:25.87,0:12:28.45,Default,,0,0,0,,Доя!
Dialogue: 0,0:12:28.95,0:12:30.66,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:12:31.08,0:12:32.00,Default,,0,0,0,,А...?
Dialogue: 0,0:12:36.88,0:12:38.79,Default,,0,0,0,,Кел, кел!
Dialogue: 0,0:12:38.88,0:12:41.42,Default,,0,0,0,,Сәттілік Валькири
Dialogue: 0,0:12:46.43,0:12:48.39,Default,,0,0,0,,Шабуыл жұмыс істемейді
Dialogue: 0,0:12:48.47,0:12:50.81,Default,,0,0,0,,Бұл қалқан ату күші
Dialogue: 0,0:12:51.52,0:12:54.35,Default,,0,0,0,,Вайверннің күшті айналу дыбысы
Dialogue: 0,0:12:54.44,0:12:56.90,Default,,0,0,0,,Валькири дыбысы жұтылып жатыр
Dialogue: 0,0:12:57.15,0:12:59.65,Default,,0,0,0,,Виверн орбитасының драйвері
Dialogue: 0,0:12:59.73,0:13:01.57,Default,,0,0,0,,Ұшына бекітілген шар
Dialogue: 0,0:13:02.07,0:13:04.95,Default,,0,0,0,,Өйткені ол еркін айналады
Dialogue: 0,0:13:05.24,0:13:07.70,Default,,0,0,0,,Ол қарсыластың импульсін жояды.
Dialogue: 0,0:13:08.82,0:13:11.12,Default,,0,0,0,,Жедел түсіру жұмыс істемейді.
Dialogue: 0,0:13:11.20,0:13:12.54,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:13:13.08,0:13:15.46,Default,,0,0,0,,Мен сөйлеп тұрғанда Ақырзаман
Dialogue: 0,0:13:15.54,0:13:17.37,Default,,0,0,0,,Бұл өте жылдам болды.
Dialogue: 0,0:13:17.96,0:13:19.13,Default,,0,0,0,,Фортепиано
Dialogue: 0,0:13:19.79,0:13:20.84,Default,,0,0,0,,Ритардандо
Dialogue: 0,0:13:21.50,0:13:22.96,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:13:23.05,0:13:24.67,Default,,0,0,0,,Дәл солай...
Dialogue: 0,0:13:25.51,0:13:26.59,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:30.22,0:13:31.72,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:32.60,0:13:34.85,Default,,0,0,0,,Wyvern Spin Finish
Dialogue: 0,0:13:34.93,0:13:37.31,Default,,0,0,0,,Вакия Бочан 1 ұпай
Dialogue: 0,0:13:37.39,0:13:40.15,Default,,0,0,0,,Жарайсыңдар, өте көп жұмыс жасадыңдар.
Dialogue: 0,0:13:41.07,0:13:41.94,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:42.02,0:13:43.53,Default,,0,0,0,,Менің Валькириім
Dialogue: 0,0:13:43.61,0:13:45.49,Default,,0,0,0,,Әлі олай емес.
Dialogue: 0,0:13:45.57,0:13:46.49,Default,,0,0,0,,...хе
Dialogue: 0,0:13:46.57,0:13:48.20,Default,,0,0,0,,Жасай берейік
Dialogue: 0,0:13:48.61,0:13:49.78,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:50.32,0:13:53.08,Default,,0,0,0,,Бұл мен естігім келген дыбыс емес
Dialogue: 0,0:13:54.08,0:13:56.58,Default,,0,0,0,,Не болды, Аои Барто?
Dialogue: 0,0:13:57.37,0:14:00.08,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:14:00.17,0:14:01.88,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:14:01.96,0:14:04.42,Default,,0,0,0,,Мен сенің қарсыласыңмын, жүр!
Dialogue: 0,0:14:04.51,0:14:06.63,Default,,0,0,0,,Балто, мен көмектесуге келдім.
Dialogue: 0,0:14:06.72,0:14:07.72,Default,,0,0,0,,А…?
Dialogue: 0,0:14:08.84,0:14:09.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:09.93,0:14:11.22,Default,,0,0,0,,Бұл ұрыс емес пе?
Dialogue: 0,0:14:11.30,0:14:12.89,Default,,0,0,0,,Ұрыс кезінде?
Dialogue: 0,0:14:13.39,0:14:14.77,Default,,0,0,0,,Ақыры әлем есін жиды.
Dialogue: 0,0:14:14.85,0:14:17.77,Default,,0,0,0,,Кумичо! Inusuke! Дина!
Dialogue: 0,0:14:17.85,0:14:21.02,Default,,0,0,0,,Достар клубы, бәрі жинала ма?
Dialogue: 0,0:14:21.11,0:14:21.86,Default,,0,0,0,,Ах
Dialogue: 0,0:14:21.94,0:14:23.52,Default,,0,0,0,,Қолдау артты
Dialogue: 0,0:14:23.61,0:14:25.28,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:14:25.36,0:14:28.28,Default,,0,0,0,,Хона, екінші шайқасты бастайық.
Dialogue: 0,0:14:29.41,0:14:32.41,Default,,0,0,0,,Балт 1 ұпай алдың ба?
Dialogue: 0,0:14:32.58,0:14:35.45,Default,,0,0,0,,Шабуыл түрі бірінші кезекте тиімсіз.
Dialogue: 0,0:14:35.54,0:14:36.91,Default,,0,0,0,,Басқа адам ақымақ
Dialogue: 0,0:14:37.33,0:14:38.83,Default,,0,0,0,,Егер қандай да бір жоспар болса...
Dialogue: 0,0:14:39.62,0:14:41.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:42.00,0:14:44.59,Default,,0,0,0,,Сәлем Балто! Бұл жаңа техника
Dialogue: 0,0:14:44.67,0:14:45.50,Default,,0,0,0,,…Ах
Dialogue: 0,0:14:45.59,0:14:46.76,Default,,0,0,0,,Жаңа техника?
Dialogue: 0,0:14:47.05,0:14:48.88,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:14:48.97,0:14:51.09,Default,,0,0,0,,Бұл қызық. Көру жақсы.
Dialogue: 0,0:14:52.30,0:14:54.85,Default,,0,0,0,,Флэш түсіру әлі аяқталмаған.
Dialogue: 0,0:14:55.39,0:14:56.81,Default,,0,0,0,,Бірақ егер солай болса...
Dialogue: 0,0:14:58.02,0:14:59.48,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:15:00.19,0:15:01.85,Default,,0,0,0,,Жарайды, мен шештім!
Dialogue: 0,0:15:01.94,0:15:04.23,Default,,0,0,0,,Мұны істеу керек, досым!
Dialogue: 0,0:15:05.11,0:15:06.65,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:15:09.07,0:15:12.03,Default,,0,0,0,,Rush Shoot сияқты пішінге ұқсайды
Dialogue: 0,0:15:12.11,0:15:14.24,Default,,0,0,0,,Білектеріңізді тік ұстаңыз
Dialogue: 0,0:15:14.74,0:15:18.20,Default,,0,0,0,,Іске қосу құрылғысы да стадионға параллель...?
Dialogue: 0,0:15:18.70,0:15:20.71,Default,,0,0,0,,Бұрынғыдан да мұқият болыңыз.
Dialogue: 0,0:15:21.21,0:15:22.96,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:15:23.71,0:15:27.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:27.09,0:15:29.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:33.51,0:15:34.97,Default,,0,0,0,,(Қабырғаға соғылған дыбыс)
Dialogue: 0,0:15:35.05,0:15:36.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:36.10,0:15:37.85,Default,,0,0,0,,Бұл сәтсіз ату.
Dialogue: 0,0:15:37.93,0:15:40.02,Default,,0,0,0,,Бей бақылаудан шығып барады
Dialogue: 0,0:15:40.10,0:15:42.65,Default,,0,0,0,,(қабырғаны тырнаған дыбыс)
Dialogue: 0,0:15:42.73,0:15:43.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:44.65,0:15:48.11,Default,,0,0,0,,(еденге құлаған шығанақтың дыбысы)
Dialogue: 0,0:15:49.07,0:15:50.03,Default,,0,0,0,,Ах
Dialogue: 0,0:15:51.11,0:15:52.36,Default,,0,0,0,,(Аңқылдаған дыбыс)
Dialogue: 0,0:15:53.45,0:15:54.41,Default,,0,0,0,,...Куч
Dialogue: 0,0:15:54.49,0:15:55.95,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:15:56.41,0:15:57.28,Default,,0,0,0,,Ха~
Dialogue: 0,0:15:57.83,0:16:00.75,Default,,0,0,0,,Wild Wyvern Overfinish
Dialogue: 0,0:16:00.83,0:16:03.83,Default,,0,0,0,,Вакия Бочан 2-0 есебімен жеңіске жетті.
Dialogue: 0,0:16:04.29,0:16:05.92,Default,,0,0,0,,А, а...
Dialogue: 0,0:16:06.29,0:16:07.46,Default,,0,0,0,,Валькирия
Dialogue: 0,0:16:08.30,0:16:10.38,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:16:10.76,0:16:12.26,Default,,0,0,0,,Дайын бол!
Dialogue: 0,0:16:12.34,0:16:13.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.34,0:16:15.01,Default,,0,0,0,,Негізгі қызметтер және
Dialogue: 0,0:16:15.09,0:16:17.76,Default,,0,0,0,,Мен ағымдағы нүктені жоғалтамын.
Dialogue: 0,0:16:17.85,0:16:19.72,Default,,0,0,0,,Сіз, Вайдың жаңа техникасы -
Dialogue: 0,0:16:19.81,0:16:21.35,Default,,0,0,0,,Мен оны әлі көре алмаймын.
Dialogue: 0,0:16:21.85,0:16:22.94,Default,,0,0,0,,Жаңа техника?
Dialogue: 0,0:16:23.39,0:16:25.06,Default,,0,0,0,,Мен оны көргім келеді.
Dialogue: 0,0:16:26.19,0:16:27.02,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:27.90,0:16:29.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:29.44,0:16:31.44,Default,,0,0,0,,Бұрынғыдай қателескенім үшін кешіріңіз.
Dialogue: 0,0:16:31.99,0:16:33.20,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:16:33.65,0:16:35.11,Default,,0,0,0,,және басқа да байланыс құралдарын—өшіріп, сол үстелге қойыңыз.
Dialogue: 0,0:16:35.20,0:16:37.32,Default,,0,0,0,,Шайқас аяқталды.
Dialogue: 0,0:16:37.41,0:16:40.12,Default,,0,0,0,,Сіз маған жаңа әдіс-тәсілдерді көрсету үшін бар күшіңізді саласыз ба?
Dialogue: 0,0:16:40.20,0:16:42.33,Default,,0,0,0,,Сіз өте сенімді болуыңыз керек.
Dialogue: 0,0:16:42.79,0:16:45.12,Default,,0,0,0,,Шапшаң ату нәтиже бермеді
Dialogue: 0,0:16:45.21,0:16:47.33,Default,,0,0,0,,Флэш түсіру үлкен сәтсіздікке ұшырады...
Dialogue: 0,0:16:47.67,0:16:49.46,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:16:50.34,0:16:52.26,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:16:52.59,0:16:55.55,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:56.59,0:16:58.10,Default,,0,0,0,,Жарық түсіру
Dialogue: 0,0:16:58.22,0:16:59.43,Default,,0,0,0,,Сіз жүгіруге бардыңыз ба?
Dialogue: 0,0:17:00.14,0:17:01.31,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:01.39,0:17:03.89,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:05.10,0:17:06.31,Default,,0,0,0,,Соңғы минутта өзгертілді!
Dialogue: 0,0:17:06.40,0:17:07.65,Default,,0,0,0,,Бұл финт пе?
Dialogue: 0,0:17:07.73,0:17:10.65,Default,,0,0,0,,Жоқ, бұл таңқаларлық емес.
Dialogue: 0,0:17:11.53,0:17:13.36,Default,,0,0,0,,Ең жылдам!
Dialogue: 0,0:17:13.44,0:17:16.36,Default,,0,0,0,,Ол мұны ең соңында жасады.
Dialogue: 0,0:17:17.03,0:17:19.24,Default,,0,0,0,,...Ха, иә, иә!
Dialogue: 0,0:17:19.74,0:17:21.33,Default,,0,0,0,,Керемет! валкири
Dialogue: 0,0:17:24.96,0:17:26.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:26.08,0:17:28.67,Default,,0,0,0,,Оны жеңу үшін жай ғана Rush Shoot пайдаланыңыз.
Dialogue: 0,0:17:31.71,0:17:33.26,Default,,0,0,0,,Алға, жолдасым!
Dialogue: 0,0:17:33.34,0:17:35.38,Default,,0,0,0,,Осындай нәрсемен көңіл көтеруге болатын кезде
Dialogue: 0,0:17:35.47,0:17:36.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:36.47,0:17:38.01,Default,,0,0,0,,Ұялған жігіт
Dialogue: 0,0:17:38.64,0:17:41.76,Default,,0,0,0,,Шапшаң атудың дыбысы, әрине, керемет.
Dialogue: 0,0:17:41.85,0:17:45.31,Default,,0,0,0,,Бірақ қалқан ату тіпті оған сәйкес келмейді.
Dialogue: 0,0:17:45.39,0:17:47.77,Default,,0,0,0,,Жылдам, дәл және күшті
Dialogue: 0,0:17:48.52,0:17:49.86,Default,,0,0,0,,Бұл жұмыс істемейді...
Dialogue: 0,0:17:49.94,0:17:51.27,Default,,0,0,0,,Тіпті 1 мм де емес
Dialogue: 0,0:17:51.36,0:17:52.11,Default,,0,0,0,,На
Dialogue: 0,0:17:52.19,0:17:53.32,Default,,0,0,0,,Қазір...
Dialogue: 0,0:17:53.40,0:17:55.03,Default,,0,0,0,,Ашылу уақыты
Dialogue: 0,0:18:01.78,0:18:02.70,Default,,0,0,0,,Әй
Dialogue: 0,0:18:02.79,0:18:04.29,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:18:04.37,0:18:07.54,Default,,0,0,0,,Вайверн Валькиридің күшін пайдаланады
Dialogue: 0,0:18:07.62,0:18:09.75,Default,,0,0,0,,Жүргізушінің ұшында тұрған доп
Dialogue: 0,0:18:09.83,0:18:12.21,Default,,0,0,0,,Қарсыласыңыздың шабуылын жай ғана өлтірмеңіз
Dialogue: 0,0:18:12.54,0:18:13.71,Default,,0,0,0,,Маятник принципі бойынша -
Dialogue: 0,0:18:13.80,0:18:15.92,Default,,0,0,0,,Шабуылды қалай қайтаруға болады?
Dialogue: 0,0:18:17.13,0:18:18.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:19.22,0:18:21.97,Default,,0,0,0,,Валькири сізді қаншалықты қатты соғады, соғұрлым көп
Dialogue: 0,0:18:22.05,0:18:24.18,Default,,0,0,0,,Виверннің күші артады!
Dialogue: 0,0:18:24.26,0:18:26.35,Default,,0,0,0,,Бұл Вайдың жаңа ерекше қозғалысы!
Dialogue: 0,0:18:26.43,0:18:28.02,Default,,0,0,0,,Қалқан апаты!
Dialogue: 0,0:18:28.10,0:18:29.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:29.48,0:18:31.36,Default,,0,0,0,,Валькири шабуыл жасай алмайды
Dialogue: 0,0:18:31.44,0:18:33.27,Default,,0,0,0,,Күте тұрыңыз, Валькири!
Dialogue: 0,0:18:33.48,0:18:35.32,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:18:35.53,0:18:36.57,Default,,0,0,0,,Вайверн!
Dialogue: 0,0:18:36.69,0:18:39.99,Default,,0,0,0,,Ама-чанға шындықты айт!
Dialogue: 0,0:18:40.07,0:18:41.41,Default,,0,0,0,,Финал
Dialogue: 0,0:18:43.58,0:18:44.74,Default,,0,0,0,,Анна…
Dialogue: 0,0:18:45.83,0:18:46.62,Default,,0,0,0,,Жасау…
Dialogue: 0,0:18:48.29,0:18:49.08,Default,,0,0,0,,Троа!
Dialogue: 0,0:18:49.41,0:18:51.58,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:51.67,0:18:53.67,Default,,0,0,0,,Жоқ... Ах...
Dialogue: 0,0:18:53.79,0:18:54.92,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:18:55.34,0:18:56.84,Default,,0,0,0,,Не?
Dialogue: 0,0:18:56.92,0:18:59.34,Default,,0,0,0,,Бұл өте көңілсіз болды.
Dialogue: 0,0:18:59.59,0:19:00.97,Default,,0,0,0,,Жақсы, бірақ
Dialogue: 0,0:19:01.34,0:19:03.14,Default,,0,0,0,,Сіз барынша тырысып жатырсыз ба?
Dialogue: 0,0:19:03.22,0:19:06.35,Default,,0,0,0,,Бұл Shield Crash үшін сынақ үстеліне ұқсамайды.
Dialogue: 0,0:19:06.81,0:19:08.35,Default,,0,0,0,,Тәжірибе стенді...?
Dialogue: 0,0:19:08.43,0:19:09.31,Default,,0,0,0,,Ха
Dialogue: 0,0:19:10.02,0:19:11.15,Default,,0,0,0,,10-шы эпизод
Dialogue: 0,0:19:11.23,0:19:14.23,Default,,0,0,0,,Сіз сынақ пәні ретінде Валькириді қолдандыңыз ба?
Dialogue: 0,0:19:14.31,0:19:15.65,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:19:15.73,0:19:18.11,Default,,0,0,0,,Тоқта, Балто, тыныштал!
Dialogue: 0,0:19:18.19,0:19:19.15,Default,,0,0,0,,Сөйле!
Dialogue: 0,0:19:19.24,0:19:20.82,Default,,0,0,0,,Сабыр ет!
Dialogue: 0,0:19:20.90,0:19:24.12,Default,,0,0,0,,Аға, сіз бұл шығанақты өзгертуіңіз керек.
Dialogue: 0,0:19:24.20,0:19:26.08,Default,,0,0,0,,Y-ге қолданылмайды.
Dialogue: 0,0:19:26.16,0:19:26.95,Default,,0,0,0,,Не!
Dialogue: 0,0:19:27.04,0:19:28.00,Default,,0,0,0,,Және-
Dialogue: 0,0:19:28.33,0:19:31.58,Default,,0,0,0,,Сіз оның серіктесі болсаңыз, Валькири де сізді аяйды.
Dialogue: 0,0:19:31.79,0:19:34.92,Default,,0,0,0,,Сонымен... сүйкімді... иә...
Dialogue: 0,0:19:37.71,0:19:38.63,Default,,0,0,0,,Барт…
Dialogue: 0,0:19:42.93,0:19:45.05,Default,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,0:19:45.64,0:19:47.68,Default,,0,0,0,,Шұңқыр неде?
Dialogue: 0,0:19:47.76,0:19:49.60,Default,,0,0,0,,Келесіде мен жеңемін деп үміттенемін.
Dialogue: 0,0:19:49.68,0:19:51.44,Default,,0,0,0,,Күл, күл
Dialogue: 0,0:19:51.52,0:19:52.69,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:53.19,0:19:54.19,Default,,0,0,0,,Барт…
Dialogue: 0,0:19:55.40,0:19:56.57,Default,,0,0,0,,Валькирия...
Dialogue: 0,0:19:56.77,0:19:57.73,Default,,0,0,0,,Менің серіктесім...
Dialogue: 0,0:19:57.82,0:19:59.65,Default,,0,0,0,,Уф, аман қалдым.
Dialogue: 0,0:19:59.74,0:20:00.86,Default,,0,0,0,,Ах
Dialogue: 0,0:20:02.82,0:20:05.20,Default,,0,0,0,,Сіз бүгін уақытыңызды босқа өткіздіңіз.
Dialogue: 0,0:20:06.62,0:20:09.37,Default,,0,0,0,,Бұл мен естігім келген дыбыс емес еді
Dialogue: 0,0:20:09.95,0:20:11.50,Default,,0,0,0,,Сол кезде мен естіген дыбыс...
Dialogue: 0,0:20:12.12,0:20:13.50,Default,,0,0,0,,Бұл жай ғана менің қиялым болды ма?
Dialogue: 0,0:20:14.33,0:20:16.13,Default,,0,0,0,,(қарға)
Dialogue: 0,0:20:18.42,0:20:20.38,Default,,0,0,0,,Йо Куришуу
Dialogue: 0,0:20:20.84,0:20:21.84,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:21.92,0:20:23.18,Default,,0,0,0,,О, Дару-кун, мына жерде оденнің банкасы бар.
Dialogue: 0,0:20:24.22,0:20:25.22,Default,,0,0,0,,Рей-чан бүгін жақсы бала болғаны үшін 60 ұпай алады!
Dialogue: 0,0:20:25.30,0:20:27.85,Default,,0,0,0,,Бүгін олай айтпа.
Dialogue: 0,0:20:27.93,0:20:30.10,Default,,0,0,0,,Мен сенің нөкерлеріңді жеңдім.
Dialogue: 0,0:20:30.18,0:20:31.48,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:20:32.06,0:20:33.52,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:20:36.90,0:20:40.03,Default,,0,0,0,,Бұл үлкен мәселе емес еді, мен одан құтылдым.
Dialogue: 0,0:20:40.57,0:20:43.86,Default,,0,0,0,,Иә! Жеңіспен шығасың!
Dialogue: 0,0:20:43.95,0:20:45.91,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:20:45.99,0:20:47.57,Default,,0,0,0,,Дайындық уақыты!
Dialogue: 0,0:20:49.79,0:20:50.87,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:20:51.54,0:20:52.62,Default,,0,0,0,,Айтпақшы, сіз кімсіз өзі?
Dialogue: 0,0:20:52.70,0:20:54.41,Default,,0,0,0,,Иә? Бар аға
Dialogue: 0,0:20:54.50,0:20:56.29,Default,,0,0,0,,...
Dialogue: 0,0:20:56.79,0:20:58.88,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:20:58.96,0:21:01.00,Default,,0,0,0,,Сол балалармен ұрысқандыңыз ба?
Dialogue: 0,0:21:01.84,0:21:03.17,Default,,0,0,0,,Анашым...
Dialogue: 0,0:21:03.26,0:21:03.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:04.47,0:21:06.30,Default,,0,0,0,,Гууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:21:08.14,0:21:10.22,Default,,0,0,0,,Не болды? Балтық
Dialogue: 0,0:21:10.85,0:21:14.35,Default,,0,0,0,,Анашым! Мені жаттықтырыңыз!
Dialogue: 0,0:21:14.43,0:21:16.23,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:21:16.31,0:21:20.07,Default,,0,0,0,,Енді жаттығуым керек!
Dialogue: 0,0:21:20.94,0:21:23.69,Default,,0,0,0,,(Балтоның айқайы)
Dialogue: 0,0:21:25.11,0:21:26.70,Default,,0,0,0,,Ах~
Dialogue: 0,0:21:26.78,0:21:29.32,Default,,0,0,0,,Ах~
Dialogue: 0,0:21:29.83,0:21:32.41,Default,,0,0,0,,Шапшаң ату нәтиже бермеді
Dialogue: 0,0:21:32.49,0:21:34.33,Default,,0,0,0,,Жарық түсіру – бұл...
Dialogue: 0,0:21:34.41,0:21:36.96,Default,,0,0,0,,Әй
Dialogue: 0,0:21:37.04,0:21:39.13,Default,,0,0,0,,Зертханалық орындық дегеніміз не?
Dialogue: 0,0:21:39.21,0:21:42.09,Default,,0,0,0,,Валькири жұмыс істемейді дегенді қалай түсінесіз?
Dialogue: 0,0:21:42.17,0:21:43.67,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:21:44.59,0:21:46.17,Default,,0,0,0,,Ах
Dialogue: 0,0:21:46.26,0:21:47.80,Default,,0,0,0,,Мооооо
Dialogue: 0,0:21:47.88,0:21:49.89,Default,,0,0,0,,Бұл жиіркенішті! Бұл жиіркенішті!
Dialogue: 0,0:21:49.97,0:21:53.10,Default,,0,0,0,,Өте жаман!
Dialogue: 0,0:22:09.11,0:22:15.20,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.41,0:22:21.54,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.00,0:22:27.55,Default,,0,0,0,,Арманыңыздағы билетті мықтап ұстаңыз
Dialogue: 0,0:22:28.01,0:22:31.34,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.51,0:22:36.43,Default,,0,0,0,,Сіз енді ешқашан жоғалмайсыз
Dialogue: 0,0:22:38.35,0:22:41.06,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.15,0:22:44.36,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.44,0:22:50.78,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.03,0:22:56.58,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.75,0:23:03.34,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.92,0:23:09.34,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.51,0:23:12.68,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.18,0:23:17.14,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.53,0:23:30.40,Default,,0,0,0,,Қарғыс атқыр, мен нені қарасам да, басымды қағатын сияқтымын.
Dialogue: 0,0:23:30.49,0:23:31.49,Default,,0,0,0,,Сол мыңжапырақ
Dialogue: 0,0:23:31.57,0:23:33.16,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:23:33.24,0:23:35.53,Default,,0,0,0,,Иә! Шу пішінін өзгертті ме?
Dialogue: 0,0:23:35.62,0:23:37.41,Default,,0,0,0,,Жаңа техниканы үйрендіңіз бе?
Dialogue: 0,0:23:37.49,0:23:40.87,Default,,0,0,0,,Шуу, өтінемін, маған бір оқ беріп, оқ берші!
Dialogue: 0,0:23:40.96,0:23:42.96,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.25,0:23:45.75,Default,,0,0,0,,Оны жеңіңіз! Валькирияға сеніңіз!
Dialogue: 0,0:23:45.84,0:23:47.67,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.13,0:23:49.84,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.34,0:23:57.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory