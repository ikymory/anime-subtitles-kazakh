Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.21,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.30,0:00:12.42,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.51,0:00:14.68,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.76,0:00:16.89,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.97,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.64,0:00:24.06,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.14,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.61,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:40.83,0:00:41.87,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:00:41.95,0:00:43.25,Default,,0,0,0,,Міне, барамын!
Dialogue: 0,0:00:43.33,0:00:45.12,Default,,0,0,0,,Nu~!
Dialogue: 0,0:00:51.00,0:00:52.26,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:52.59,0:00:53.55,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:53.63,0:00:56.13,Default,,0,0,0,,Lost Longinus Burst Finish
Dialogue: 0,0:00:56.34,0:00:57.47,Default,,0,0,0,,3-2
Dialogue: 0,0:00:57.55,0:00:59.60,Default,,0,0,0,,Руи Ширасагидің жеңісі
Dialogue: 0,0:01:01.10,0:01:04.43,Default,,0,0,0,,Шу Луиді шетіне итеріп жіберді.
Dialogue: 0,0:01:04.73,0:01:05.81,Default,,0,0,0,,Бірақ
Dialogue: 0,0:01:06.27,0:01:08.15,Default,,0,0,0,,Луи жеңімпаз болды.
Dialogue: 0,0:01:10.61,0:01:11.73,Default,,0,0,0,,Ум...
Dialogue: 0,0:01:12.36,0:01:13.44,Default,,0,0,0,,Бұрынғы матч...
Dialogue: 0,0:01:13.53,0:01:15.57,Default,,0,0,0,,Финалда жеңіске жету
Dialogue: 0,0:01:20.24,0:01:21.58,Default,,0,0,0,,Сіз жеңе аласыз
Dialogue: 0,0:01:22.08,0:01:22.91,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:01:24.50,0:01:26.79,Default,,0,0,0,,Егер бұл сен болмасаң, мен Луиді жеңе алмаймын.
Dialogue: 0,0:01:27.37,0:01:28.37,Default,,0,0,0,,Иә
Dialogue: 0,0:01:28.71,0:01:29.83,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:01:31.71,0:01:32.75,Default,,0,0,0,,Міндетті түрде орындаңыз
Dialogue: 0,0:01:32.84,0:01:34.71,Default,,0,0,0,,Сондай-ақ Шу мен Спригган үшін
Dialogue: 0,0:01:34.80,0:01:37.59,Default,,0,0,0,,Мен және Валькири бар күш-жігерімізбен күресеміз
Dialogue: 0,0:01:45.77,0:01:48.14,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:48.48,0:01:53.65,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:04.95,0:02:08.33,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:08.83,0:02:10.96,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:11.38,0:02:15.51,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:15.63,0:02:18.84,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:18.97,0:02:25.39,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:25.68,0:02:30.10,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:30.60,0:02:36.03,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:36.15,0:02:38.40,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:38.49,0:02:43.20,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:43.37,0:02:48.45,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:48.75,0:02:51.00,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:51.21,0:02:53.54,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:53.84,0:02:57.76,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:57.92,0:03:02.93,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:03.14,0:03:05.31,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:09.14,0:03:11.64,Default,,0,0,0,,Оны жеңейік! Абсолютті чемпион!
Dialogue: 0,0:03:13.73,0:03:16.27,Default,,0,0,0,,Неге...
Dialogue: 0,0:03:16.36,0:03:18.69,Default,,0,0,0,,Мен стадионның ішіндемін бе?
Dialogue: 0,0:03:18.78,0:03:20.24,Default,,0,0,0,,(Шұңқырдың жүгіру дыбысы)
Dialogue: 0,0:03:21.49,0:03:23.24,Default,,0,0,0,,Уау! Ахх
Dialogue: 0,0:03:23.87,0:03:24.95,Default,,0,0,0,,Лонгинус?
Dialogue: 0,0:03:27.08,0:03:27.99,Default,,0,0,0,,Уау
Dialogue: 0,0:03:28.87,0:03:30.87,Default,,0,0,0,,Мен сені талқандаймын
Dialogue: 0,0:03:33.21,0:03:35.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:35.21,0:03:36.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:41.55,0:03:45.26,Default,,0,0,0,,Түсімде жеңілсем де, өзімді қатты жаман сезінемін!
Dialogue: 0,0:03:45.68,0:03:49.31,Default,,0,0,0,,Ах~ Келесі жолы мен міндетті түрде жеңіске жетуді армандаймын.
Dialogue: 0,0:03:51.39,0:03:53.85,Default,,0,0,0,,Жеңіске жетуді армандағанша оянба
Dialogue: 0,0:03:53.94,0:03:56.86,Default,,0,0,0,,Жеңіс жеңіп, жеңіске жетті~
Dialogue: 0,0:03:58.02,0:03:59.23,Default,,0,0,0,,Ааах!
Dialogue: 0,0:03:59.32,0:04:01.57,Default,,0,0,0,,Мен ұйықтайын десем, ұйықтай алмаймын.
Dialogue: 0,0:04:02.20,0:04:03.53,Default,,0,0,0,,Боқта~
Dialogue: 0,0:04:05.49,0:04:07.45,Default,,0,0,0,,Токонацу Ника
Dialogue: 0,0:04:07.53,0:04:09.62,Default,,0,0,0,,Балтоны оятатын кез келді.
Dialogue: 0,0:04:09.70,0:04:11.25,Default,,0,0,0,,Иә
Dialogue: 0,0:04:14.87,0:04:16.17,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:04:16.83,0:04:18.54,Default,,0,0,0,,Бал-нии, ояусың ба?
Dialogue: 0,0:04:18.63,0:04:20.09,Default,,0,0,0,,Бұл сирек.
Dialogue: 0,0:04:20.59,0:04:22.05,Default,,0,0,0,,Bar-nii?
Dialogue: 0,0:04:23.05,0:04:26.09,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:31.60,0:04:32.85,Default,,0,0,0,,Ұйықтау!
Dialogue: 0,0:04:32.93,0:04:34.10,Default,,0,0,0,,Хехе...
Dialogue: 0,0:04:34.35,0:04:35.65,Default,,0,0,0,,Бал-нии! Оян...
Dialogue: 0,0:04:35.73,0:04:37.40,Default,,0,0,0,,Кеттік! (2 адам) Уау!
Dialogue: 0,0:04:37.48,0:04:38.98,Default,,0,0,0,,Арнайы дайындық!
Dialogue: 0,0:04:39.07,0:04:40.11,Default,,0,0,0,,Бал аға
Dialogue: 0,0:04:40.19,0:04:41.69,Default,,0,0,0,,оянды
Dialogue: 0,0:04:45.03,0:04:47.32,Default,,0,0,0,,Луи мен Лонгинусты жеңу
Dialogue: 0,0:04:47.41,0:04:51.16,Default,,0,0,0,,Менің ойымша, Бакусу Шотпен бірге барудан басқа амалым жоқ.
Dialogue: 0,0:04:51.45,0:04:54.00,Default,,0,0,0,,Ал, мен бұл анық екеніне сенімдімін.
Dialogue: 0,0:04:54.25,0:04:55.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:55.29,0:04:58.38,Default,,0,0,0,,Nightmare Shot фильмінің күші керемет
Dialogue: 0,0:04:58.46,0:04:59.50,Default,,0,0,0,,Оны қалай жеңуге болады
Dialogue: 0,0:04:59.59,0:05:02.17,Default,,0,0,0,,Одан артық күшпен атудан басқа амал жоқ.
Dialogue: 0,0:05:02.46,0:05:04.42,Default,,0,0,0,,Жарылғыш оқпен
Dialogue: 0,0:05:04.88,0:05:06.68,Default,,0,0,0,,Барлығы солай ойлады.
Dialogue: 0,0:05:06.76,0:05:08.47,Default,,0,0,0,,Сондықтан мен арнайы дайындықты қалаймын
Dialogue: 0,0:05:08.55,0:05:10.22,Default,,0,0,0,,Сіз оны атадыңыз, солай ма?
Dialogue: 0,0:05:10.31,0:05:12.02,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:05:12.10,0:05:13.68,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:05:13.77,0:05:15.02,Default,,0,0,0,,Тәжірибе әдісі
Dialogue: 0,0:05:15.10,0:05:17.98,Default,,0,0,0,,Барто: Сіз солай ойладыңыз ба?
Dialogue: 0,0:05:18.06,0:05:21.52,Default,,0,0,0,,Бізде тағы бір бас поп болады ма?
Dialogue: 0,0:05:22.11,0:05:24.07,Default,,0,0,0,,Бұл қандай жаттығу әдісі?
Dialogue: 0,0:05:24.15,0:05:26.07,Default,,0,0,0,,Ләззат алу ләззат алу
Dialogue: 0,0:05:26.82,0:05:28.32,Default,,0,0,0,,Қараңғы кадр
Dialogue: 0,0:05:28.49,0:05:30.78,Default,,0,0,0,,Әй?Ах...
Dialogue: 0,0:05:30.99,0:05:33.12,Default,,0,0,0,,Шу мұны бұрын жасады ма?
Dialogue: 0,0:05:33.29,0:05:34.29,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:05:34.50,0:05:37.21,Default,,0,0,0,,Көзін жұмған адам:
Dialogue: 0,0:05:37.87,0:05:39.38,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:05:39.50,0:05:41.79,Default,,0,0,0,,Шуу-кун болғандықтан мен мұны істей алдым.
Dialogue: 0,0:05:42.25,0:05:44.51,Default,,0,0,0,,Мен де істеймін, және...
Dialogue: 0,0:05:44.96,0:05:47.26,Default,,0,0,0,,Көзіңді жұмып тұрсаң да
Dialogue: 0,0:05:47.34,0:05:49.14,Default,,0,0,0,,Менің ойымша, сіз сәтсіздікке ұшырамайсыз.
Dialogue: 0,0:05:49.22,0:05:52.26,Default,,0,0,0,,Түсіндім, көзіңді жұмысаң да қолыңнан келмесе.
Dialogue: 0,0:05:52.35,0:05:54.56,Default,,0,0,0,,Көзімді ашсам, жеңу оңай
Dialogue: 0,0:05:54.89,0:05:56.60,Default,,0,0,0,,Жоқ, ол әдеттегідей салқынқанды емес.
Dialogue: 0,0:05:57.06,0:05:58.35,Default,,0,0,0,,Сен ақылдысың!
Dialogue: 0,0:05:58.44,0:06:01.02,Default,,0,0,0,,Дұрыс, дұрыс~ Мен данышпанмын!
Dialogue: 0,0:06:01.11,0:06:03.52,Default,,0,0,0,,«Еңбектің қос әсері~»
Dialogue: 0,0:06:03.61,0:06:04.82,Default,,0,0,0,,«Нанимаро» мұнда!
Dialogue: 0,0:06:04.90,0:06:06.19,Default,,0,0,0,,Тез орындайық
Dialogue: 0,0:06:08.49,0:06:09.53,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:09.95,0:06:12.58,Default,,0,0,0,,Қараңғы жарылысты атаңыз
Dialogue: 0,0:06:12.66,0:06:14.04,Default,,0,0,0,,Мен шешемін.
Dialogue: 0,0:06:14.20,0:06:16.54,Default,,0,0,0,,Сіз мұны кенеттен жасайсыз ба?
Dialogue: 0,0:06:17.50,0:06:19.04,Default,,0,0,0,,Ойланбай
Dialogue: 0,0:06:19.25,0:06:21.00,Default,,0,0,0,,Барынша барыңыз
Dialogue: 0,0:06:21.21,0:06:22.63,Default,,0,0,0,,Бұл емес
Dialogue: 0,0:06:24.84,0:06:26.80,Default,,0,0,0,,Мен де байсалдымын.
Dialogue: 0,0:06:27.01,0:06:29.51,Default,,0,0,0,,Мен соқыр адамға жеңіле алмаймын.
Dialogue: 0,0:06:29.72,0:06:31.05,Default,,0,0,0,,Ұшып кетіңіз
Dialogue: 0,0:06:31.76,0:06:34.18,Default,,0,0,0,,Уайымдамаңыз, сіз мұны мүлдем жасай аласыз.
Dialogue: 0,0:06:37.06,0:06:39.27,Default,,0,0,0,,Жарайды, мен оны көріп тұрмын.
Dialogue: 0,0:06:40.69,0:06:41.65,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:06:42.36,0:06:44.36,Default,,0,0,0,,Мен Луиді көріп тұрмын
Dialogue: 0,0:06:44.77,0:06:47.36,Default,,0,0,0,,Бакусу атуды шешіңіз
Dialogue: 0,0:06:47.74,0:06:49.45,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:06:51.66,0:06:52.74,Default,,0,0,0,,Үш
Dialogue: 0,0:06:53.07,0:06:53.95,Default,,0,0,0,,Екі
Dialogue: 0,0:06:54.49,0:06:55.33,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:06:57.45,0:07:00.25,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:00.33,0:07:01.08,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:03.46,0:07:04.59,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,0:07:04.67,0:07:06.21,Default,,0,0,0,,Реактивті түсірілім
Dialogue: 0,0:07:14.14,0:07:16.26,Default,,0,0,0,,Уайдың жабайы Вайверн
Dialogue: 0,0:07:16.35,0:07:18.27,Default,,0,0,0,,Оны жалама!
Dialogue: 0,0:07:22.40,0:07:23.52,Default,,0,0,0,,Вайверн!
Dialogue: 0,0:07:23.60,0:07:25.69,Default,,0,0,0,,Hyper Shield апаты
Dialogue: 0,0:07:31.53,0:07:33.32,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:07:33.91,0:07:35.03,Default,,0,0,0,,Ах
Dialogue: 0,0:07:35.78,0:07:37.58,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:07:37.66,0:07:38.91,Default,,0,0,0,,Жарылыс
Dialogue: 0,0:07:39.20,0:07:40.50,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:40.58,0:07:41.25,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:41.37,0:07:43.25,Default,,0,0,0,,Сіз әлі көзіңізді ашқыңыз келе ме?
Dialogue: 0,0:07:43.33,0:07:44.88,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:45.29,0:07:48.00,Default,,0,0,0,,Валькири жарылған мәремен жеңеді.
Dialogue: 0,0:07:48.09,0:07:50.38,Default,,0,0,0,,Уау, мен жасадым!
Dialogue: 0,0:07:50.67,0:07:53.89,Default,,0,0,0,,Уау, көзін жұмған жігіт мені өлтірді.
Dialogue: 0,0:07:54.18,0:07:55.85,Default,,0,0,0,,Өйткені мен көзімді жұмдым
Dialogue: 0,0:07:55.93,0:07:58.31,Default,,0,0,0,,Балт өзінің максималды күшін көрсете алды.
Dialogue: 0,0:07:58.39,0:08:00.39,Default,,0,0,0,,Бұл үлкен шоғырлану болды.
Dialogue: 0,0:08:00.93,0:08:02.23,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,0:08:02.56,0:08:03.69,Default,,0,0,0,,Оқиға
Dialogue: 0,0:08:03.85,0:08:05.65,Default,,0,0,0,,Мен жай ғана сақамды түсірдім.
Dialogue: 0,0:08:05.73,0:08:07.06,Default,,0,0,0,,Ихихихихи…
Dialogue: 0,0:08:07.15,0:08:09.11,Default,,0,0,0,,Бірақ иә, мен түсірдім.
Dialogue: 0,0:08:09.19,0:08:10.36,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:10.61,0:08:12.24,Default,,0,0,0,,Алаңдамаңыз
Dialogue: 0,0:08:12.53,0:08:14.20,Default,,0,0,0,,Мінуге болмайды
Dialogue: 0,0:08:14.28,0:08:17.12,Default,,0,0,0,,♪Қараңғы жарылыс~
Dialogue: 0,0:08:17.20,0:08:20.62,Default,,0,0,0,,♪Қараңғы жарылыстың атысы~ (Рантаро) Көңіл-күйіңіз көтеріңкі емес пе!
Dialogue: 0,0:08:22.62,0:08:23.92,Default,,0,0,0,,Белгіленген
Dialogue: 0,0:08:24.00,0:08:25.63,Default,,0,0,0,,Сол жерге сүңгіңіз
Dialogue: 0,0:08:25.71,0:08:27.08,Default,,0,0,0,,Мұнда және осында
Dialogue: 0,0:08:27.34,0:08:28.50,Default,,0,0,0,,Мұнда секірді
Dialogue: 0,0:08:28.92,0:08:29.96,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:30.05,0:08:32.59,Default,,0,0,0,,Мен ұмытпас бұрын тағы бір рет!
Dialogue: 0,0:08:32.72,0:08:34.59,Default,,0,0,0,,Мен бұл жолы жеңілмеймін!
Dialogue: 0,0:08:37.85,0:08:39.18,Default,,0,0,0,,Балалар
Dialogue: 0,0:08:39.26,0:08:40.77,Default,,0,0,0,,Бірден келіңіз
Dialogue: 0,0:08:41.10,0:08:43.14,Default,,0,0,0,,Бұл 4-тен 1-ге дегенді білдіре ме?
Dialogue: 0,0:08:43.56,0:08:45.94,Default,,0,0,0,,Біз де атқа мініп бара жатырмыз.
Dialogue: 0,0:08:46.02,0:08:47.02,Default,,0,0,0,,Мақтаныш бар
Dialogue: 0,0:08:47.19,0:08:48.61,Default,,0,0,0,,Жеңіл қабылдамаңыз
Dialogue: 0,0:08:48.94,0:08:50.61,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:08:52.28,0:08:53.78,Default,,0,0,0,,Барлығын жаншып тастаңыз
Dialogue: 0,0:09:00.70,0:09:03.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:04.16,0:09:06.21,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:10.88,0:09:13.13,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:09:13.21,0:09:14.47,Default,,0,0,0,,Га
Dialogue: 0,0:09:14.59,0:09:15.68,Default,,0,0,0,,Ах
Dialogue: 0,0:09:15.93,0:09:16.88,Default,,0,0,0,,Уф
Dialogue: 0,0:09:17.26,0:09:19.18,Default,,0,0,0,,Бар, Гайя!
Dialogue: 0,0:09:23.14,0:09:24.60,Default,,0,0,0,,Гайя ұстап қалды
Dialogue: 0,0:09:26.31,0:09:27.52,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:09:31.90,0:09:34.07,Default,,0,0,0,,Қарғыс атқыр... қандай құдірет.
Dialogue: 0,0:09:35.49,0:09:37.20,Default,,0,0,0,,Мен тағы барамын
Dialogue: 0,0:09:40.20,0:09:42.54,Default,,0,0,0,,Маған кез келген жерден қоңырау шалыңыз!
Dialogue: 0,0:09:42.62,0:09:45.12,Default,,0,0,0,,Менің Рагнарук басқарады.
Dialogue: 0,0:09:45.71,0:09:47.62,Default,,0,0,0,,Кумичоға барайық
Dialogue: 0,0:09:53.25,0:09:55.21,Default,,0,0,0,,Уау, бұл тамаша.
Dialogue: 0,0:09:55.30,0:09:57.01,Default,,0,0,0,,Бал-нии керемет
Dialogue: 0,0:09:57.47,0:09:58.63,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:03.31,0:10:05.02,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:10:05.81,0:10:07.56,Default,,0,0,0,,Мен тағы бір рет шешемін
Dialogue: 0,0:10:09.56,0:10:13.23,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:14.94,0:10:16.57,Default,,0,0,0,,Бұл әзірге дәл.
Dialogue: 0,0:10:16.78,0:10:18.03,Default,,0,0,0,,Аа, өшірілді.
Dialogue: 0,0:10:19.03,0:10:21.20,Default,,0,0,0,,Ах, жай ғана тататата...
Dialogue: 0,0:10:21.28,0:10:22.33,Default,,0,0,0,,(Нәрсенің құлаған дыбысы)
Dialogue: 0,0:10:22.62,0:10:24.62,Default,,0,0,0,,Амансың ба? Балтық
Dialogue: 0,0:10:25.37,0:10:27.12,Default,,0,0,0,,Жарайды~
Dialogue: 0,0:10:27.96,0:10:30.50,Default,,0,0,0,,Соңғы секіру орны өшірілді.
Dialogue: 0,0:10:30.58,0:10:32.38,Default,,0,0,0,,Себебі мен қатты толқып кеттім.
Dialogue: 0,0:10:32.46,0:10:34.67,Default,,0,0,0,,Сабыр сақта, Балто.
Dialogue: 0,0:10:35.09,0:10:36.38,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,0:10:36.46,0:10:37.51,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:10:38.55,0:10:40.89,Default,,0,0,0,,Жарайды, бар күшімізді салайық.
Dialogue: 0,0:10:41.30,0:10:43.89,Default,,0,0,0,,Қолымнан келмейді, мен де сенімен кездесіп жүрмін.
Dialogue: 0,0:10:44.18,0:10:45.39,Default,,0,0,0,,Сенің қолыңнан келетініне сенімдімін
Dialogue: 0,0:10:45.85,0:10:46.93,Default,,0,0,0,,Егер Барт
Dialogue: 0,0:10:47.02,0:10:49.14,Default,,0,0,0,,Мен толқу үстіндемін.
Dialogue: 0,0:10:49.69,0:10:52.15,Default,,0,0,0,,Жарайды, мен істеймін.
Dialogue: 0,0:10:52.31,0:10:54.90,Default,,0,0,0,,Эй, Барто, тағы да барайық.
Dialogue: 0,0:10:54.98,0:10:56.48,Default,,0,0,0,,Инсуке Келесіні орындайық.
Dialogue: 0,0:10:56.57,0:10:58.49,Default,,0,0,0,,Ой, жарайды, жасайық, Балто.
Dialogue: 0,0:10:58.57,0:11:00.24,Default,,0,0,0,,Мен мұны жасадым, Кумичо.
Dialogue: 0,0:11:00.32,0:11:02.45,Default,,0,0,0,,Мен әлі атпадым.
Dialogue: 0,0:11:18.05,0:11:20.80,Default,,0,0,0,,Күрсін... Тағы бір бөтелке.
Dialogue: 0,0:11:28.97,0:11:31.56,Default,,0,0,0,,Жарайды, мен анық көріп тұрмын.
Dialogue: 0,0:11:32.52,0:11:35.19,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:39.36,0:11:40.53,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:11:41.36,0:11:42.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:44.41,0:11:45.70,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:11:46.45,0:11:47.95,Default,,0,0,0,,Жақсы жұмыс, Балто
Dialogue: 0,0:11:48.04,0:11:49.70,Default,,0,0,0,,Қазіргісі мінсіз.
Dialogue: 0,0:11:50.25,0:11:51.54,Default,,0,0,0,,Өте орынды.
Dialogue: 0,0:11:51.62,0:11:53.21,Default,,0,0,0,,Бұл сезімді ұмытпа
Dialogue: 0,0:11:53.75,0:11:55.25,Default,,0,0,0,,Ұмытасың ба?
Dialogue: 0,0:11:55.33,0:11:57.59,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:11:59.59,0:12:01.59,Default,,0,0,0,,Мен шаршадым~
Dialogue: 0,0:12:02.17,0:12:04.84,Default,,0,0,0,,Мен де қатты шаршадым.
Dialogue: 0,0:12:05.30,0:12:07.43,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:12:11.60,0:12:13.52,Default,,0,0,0,,Су мен нан болды.
Dialogue: 0,0:12:13.60,0:12:16.31,Default,,0,0,0,,Оны біреу тастап кеткен сияқты.
Dialogue: 0,0:12:16.40,0:12:17.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:19.40,0:12:20.90,Default,,0,0,0,,Ааах!
Dialogue: 0,0:12:21.19,0:12:22.28,Default,,0,0,0,,Аяғын батпаққа тығып алып, осы жардан құлап кеткен бе? ➡
Dialogue: 0,0:12:23.20,0:12:24.03,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:24.45,0:12:27.66,Default,,0,0,0,,Әлі жоқ! Барлығымыз, бәріміз барайық.
Dialogue: 0,0:12:27.99,0:12:29.16,Default,,0,0,0,,О!
Dialogue: 0,0:12:32.71,0:12:36.38,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:12:37.08,0:12:38.29,Default,,0,0,0,,Мен өз шегімдемін
Dialogue: 0,0:12:38.50,0:12:40.50,Default,,0,0,0,,Түсінуіңізді өтінемін, Луис мырза.
Dialogue: 0,0:12:46.68,0:12:48.68,Default,,0,0,0,,Спригган шықты!
Dialogue: 0,0:12:54.77,0:12:56.52,Default,,0,0,0,,Nu~!
Dialogue: 0,0:12:57.10,0:12:59.65,Default,,0,0,0,,Мені бұрышқа мәжбүрлеу, т.б.
Dialogue: 0,0:12:59.82,0:13:01.28,Default,,0,0,0,,Болмауы керек
Dialogue: 0,0:13:05.95,0:13:08.28,Default,,0,0,0,,Мен абсолютті чемпионмын
Dialogue: 0,0:13:09.20,0:13:10.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:11.41,0:13:12.62,Default,,0,0,0,,(сым кесу дыбысы)
Dialogue: 0,0:13:21.63,0:13:22.76,Default,,0,0,0,,Луис
Dialogue: 0,0:13:22.88,0:13:24.30,Default,,0,0,0,,Мен міндетті түрде жеңемін
Dialogue: 0,0:13:27.89,0:13:28.80,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:13:29.97,0:13:31.76,Default,,0,0,0,,Токонацу Ника
Dialogue: 0,0:13:31.85,0:13:33.52,Default,,0,0,0,,Бауырым, мені оятуыңды өтінемін.
Dialogue: 0,0:13:33.60,0:13:34.93,Default,,0,0,0,,Иә
Dialogue: 0,0:13:36.02,0:13:37.52,Default,,0,0,0,,ұйықтау ұйықтау
Dialogue: 0,0:13:37.90,0:13:39.36,Default,,0,0,0,,Кеттік~
Dialogue: 0,0:13:41.32,0:13:42.48,Default,,0,0,0,,Ihihi…
Dialogue: 0,0:13:43.65,0:13:45.86,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:45.95,0:13:46.95,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:13:47.03,0:13:48.03,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:13:48.28,0:13:51.08,Default,,0,0,0,,Мен оны ақыры түсіндім
Dialogue: 0,0:13:51.16,0:13:53.33,Default,,0,0,0,,Мен Лонгинусты жеңдім!
Dialogue: 0,0:13:53.41,0:13:54.25,Default,,0,0,0,,Бал аға
Dialogue: 0,0:13:54.33,0:13:55.29,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:13:55.37,0:13:56.25,Default,,0,0,0,,Уау
Dialogue: 0,0:13:56.33,0:13:57.41,Default,,0,0,0,,Сіз армандадыңыз ба?
Dialogue: 0,0:13:57.50,0:13:58.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:58.17,0:14:01.46,Default,,0,0,0,,Тез оян! Ойынға баратын уақыт!
Dialogue: 0,0:14:01.96,0:14:04.17,Default,,0,0,0,,Мен жеңдім, жеңдім!
Dialogue: 0,0:14:06.59,0:14:08.72,Default,,0,0,0,,Мен жеңдім, жеңдім, жеңдім!
Dialogue: 0,0:14:09.43,0:14:11.47,Default,,0,0,0,,Ойын әлі алда, солай ма?
Dialogue: 0,0:14:12.01,0:14:13.35,Default,,0,0,0,,Рахмет, анашым
Dialogue: 0,0:14:13.56,0:14:15.22,Default,,0,0,0,,Мен саған беремін!
Dialogue: 0,0:14:15.85,0:14:19.56,Default,,0,0,0,,Бару-нии, сен көп жаттығу жасадың, бірақ денең әлсіз бе?
Dialogue: 0,0:14:19.65,0:14:20.98,Default,,0,0,0,,Бұлшықет ауруы туралы не айтасыз?
Dialogue: 0,0:14:21.44,0:14:22.73,Default,,0,0,0,,Мәселе жоқ!
Dialogue: 0,0:14:22.82,0:14:24.48,Default,,0,0,0,,Ең жақсы!
Dialogue: 0,0:14:24.94,0:14:26.03,Default,,0,0,0,,Керемет...
Dialogue: 0,0:14:26.11,0:14:28.49,Default,,0,0,0,,Өзіңізге ұнайтын іспен айналысатыныңызға сенімдімін.
Dialogue: 0,0:14:28.74,0:14:30.49,Default,,0,0,0,,Бұл сізге ұнайтын нәрсе ме?
Dialogue: 0,0:14:30.99,0:14:33.24,Default,,0,0,0,,Шаршағаныңыз ұшады, солай ма?
Dialogue: 0,0:14:33.33,0:14:35.24,Default,,0,0,0,,Мен төсектен ұшып бара жаттым.
Dialogue: 0,0:14:35.62,0:14:37.75,Default,,0,0,0,,Сонда мен жеңемін.
Dialogue: 0,0:14:42.17,0:14:44.38,Default,,0,0,0,,Абсолютті жеңіс!
Dialogue: 0,0:14:44.46,0:14:47.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:52.14,0:14:52.97,Default,,0,0,0,,О!
Dialogue: 0,0:14:53.18,0:14:56.47,Default,,0,0,0,,Бар, ат! Апыр-ай!
Dialogue: 0,0:14:56.56,0:14:57.47,Default,,0,0,0,,Барт
Dialogue: 0,0:14:59.85,0:15:00.98,Default,,0,0,0,,О Шу
Dialogue: 0,0:15:01.44,0:15:03.94,Default,,0,0,0,,Мен тым ерте келіп қателесіппін.
Dialogue: 0,0:15:04.02,0:15:05.02,Default,,0,0,0,,Мен жүгірдім
Dialogue: 0,0:15:05.44,0:15:06.69,Default,,0,0,0,,Сізге ұқсайды.
Dialogue: 0,0:15:07.23,0:15:09.36,Default,,0,0,0,,Шуды да жасайық Даш
Dialogue: 0,0:15:09.45,0:15:10.36,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:15:10.45,0:15:12.32,Default,,0,0,0,,(судың шашырауы)
Dialogue: 0,0:15:13.78,0:15:14.70,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:15:14.78,0:15:15.70,Default,,0,0,0,,О!
Dialogue: 0,0:15:15.78,0:15:16.91,Default,,0,0,0,,Мен жай ғана жеңіске жету мақсатымен келдім—
Dialogue: 0,0:15:16.99,0:15:17.75,Default,,0,0,0,,Бұл дельфин.
Dialogue: 0,0:15:20.58,0:15:23.17,Default,,0,0,0,,Уау~ Мен тағы да ұштым
Dialogue: 0,0:15:23.25,0:15:24.50,Default,,0,0,0,,О, эй, Барто
Dialogue: 0,0:15:25.13,0:15:28.21,Default,,0,0,0,,Ей, мен міндетті түрде жеңемін.
Dialogue: 0,0:15:31.30,0:15:33.93,Default,,0,0,0,,Дельфин! Кездескенше
Dialogue: 0,0:15:34.01,0:15:35.30,Default,,0,0,0,,Кеттік, Балто.
Dialogue: 0,0:15:35.39,0:15:36.35,Default,,0,0,0,,О
Dialogue: 0,0:15:36.76,0:15:39.52,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:15:39.60,0:15:43.10,Default,,0,0,0,,Көптен күткен финал да келді.
Dialogue: 0,0:15:43.19,0:15:46.19,Default,,0,0,0,,Елдің түкпір-түкпіріндегі жүзшілер армандаған сахнаның шымылдығы ашылады.
Dialogue: 0,0:15:46.27,0:15:48.36,Default,,0,0,0,,Жақында шығады
Dialogue: 0,0:15:48.44,0:15:51.24,Default,,0,0,0,,Менің жүрегім күту мен толқуға толы.
Dialogue: 0,0:15:51.32,0:15:53.70,Default,,0,0,0,,Жарылу алдында тұр!
Dialogue: 0,0:15:53.78,0:15:55.78,Default,,0,0,0,,Сізді қандай шайқас күтіп тұр?
Dialogue: 0,0:15:55.87,0:15:58.16,Default,,0,0,0,,Драманың қандай түрі туады?
Dialogue: 0,0:15:58.37,0:16:01.16,Default,,0,0,0,,Барлығы дайынсың ба?
Dialogue: 0,0:16:01.25,0:16:04.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:07.42,0:16:09.55,Default,,0,0,0,,Бар... Барто... Эй...
Dialogue: 0,0:16:09.63,0:16:11.30,Default,,0,0,0,,Қобалжымаңыз.
Dialogue: 0,0:16:11.97,0:16:13.18,Default,,0,0,0,,Мұны жасамаңыз.
Dialogue: 0,0:16:13.55,0:16:16.60,Default,,0,0,0,,Хуаншань, қобалжысаңыз не істеу керек?
Dialogue: 0,0:16:16.68,0:16:17.72,Default,,0,0,0,,Менде жоқ!
Dialogue: 0,0:16:17.81,0:16:19.10,Default,,0,0,0,,Олар сіздің жағдайыңызды өздеріне тапсыруымды сұрады.
Dialogue: 0,0:16:19.18,0:16:21.98,Default,,0,0,0,,Аудандық турнирлер мен спортшылардың ант беруі кезінде
Dialogue: 0,0:16:22.18,0:16:24.52,Default,,0,0,0,,Балто қатты қобалжыды.
Dialogue: 0,0:16:24.60,0:16:25.69,Default,,0,0,0,,істеп жүрді
Dialogue: 0,0:16:26.11,0:16:27.94,Default,,0,0,0,,О, есімде жоқ.
Dialogue: 0,0:16:28.15,0:16:30.94,Default,,0,0,0,,Уау, өте ескі көрінеді.
Dialogue: 0,0:16:31.15,0:16:33.28,Default,,0,0,0,,Біз де қартайдық.
Dialogue: 0,0:16:33.49,0:16:34.70,Default,,0,0,0,,Тек сен
Dialogue: 0,0:16:34.78,0:16:35.86,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:16:35.95,0:16:39.12,Default,,0,0,0,,Менің арқам енді ауырмайды, ақымақ.
Dialogue: 0,0:16:39.20,0:16:40.37,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:16:40.45,0:16:41.87,Default,,0,0,0,,Кумичо күткендей
Dialogue: 0,0:16:41.95,0:16:43.58,Default,,0,0,0,,Бұл жақсы комбинация емес пе?
Dialogue: 0,0:16:43.66,0:16:45.00,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:16:53.92,0:16:54.80,Default,,0,0,0,,Ах
Dialogue: 0,0:16:55.88,0:16:56.76,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:56.84,0:16:57.97,Default,,0,0,0,,Мұның бәрі тек менің алаңдаған жүрегімді жылдамдатты
Dialogue: 0,0:17:02.85,0:17:04.44,Default,,0,0,0,,Жақсы концентрация.
Dialogue: 0,0:17:05.06,0:17:07.19,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:17:07.27,0:17:09.31,Default,,0,0,0,,Міне, ақыры басталды.
Dialogue: 0,0:17:09.40,0:17:11.28,Default,,0,0,0,,Барлығы ду қол шапалақтаумен
Dialogue: 0,0:17:11.36,0:17:14.11,Default,,0,0,0,,Ойыншыларды қайтарыңыз.
Dialogue: 0,0:17:14.19,0:17:17.78,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:19.87,0:17:21.66,Default,,0,0,0,,Қызыл бұрыштан
Dialogue: 0,0:17:21.74,0:17:23.50,Default,,0,0,0,,Ғажайып ғажайып бала
Dialogue: 0,0:17:23.58,0:17:25.75,Default,,0,0,0,,Бұл Барто Аои!
Dialogue: 0,0:17:28.21,0:17:30.09,Default,,0,0,0,,Көк бұрыштан
Dialogue: 0,0:17:30.17,0:17:33.63,Default,,0,0,0,,Турнирде бұрын-соңды болмаған бесінші рет жеңіске жетуге ұмтылатын абсолютті чемпион
Dialogue: 0,0:17:33.76,0:17:36.05,Default,,0,0,0,,Ширасаги сарайы Луис!
Dialogue: 0,0:17:36.30,0:17:37.93,Default,,0,0,0,,(Sunato) Менімен бір команда бол. (Ashido) Эй, Бакуго, сен де менімен бір команда боласың ба?
Dialogue: 0,0:17:38.01,0:17:39.60,Default,,0,0,0,,Ой, Аои Барто
Dialogue: 0,0:17:39.68,0:17:41.85,Default,,0,0,0,,Кенеттен стадионға қарай жүгіріңіз~
Dialogue: 0,0:17:41.93,0:17:42.97,Default,,0,0,0,,Ой...
Dialogue: 0,0:17:43.06,0:17:44.60,Default,,0,0,0,,Мен құладым~
Dialogue: 0,0:17:45.06,0:17:46.31,Default,,0,0,0,,Гуах
Dialogue: 0,0:17:46.39,0:17:48.02,Default,,0,0,0,,Техехехе
Dialogue: 0,0:17:48.48,0:17:49.48,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:49.73,0:17:51.40,Default,,0,0,0,,Мен тағы құладым
Dialogue: 0,0:17:51.48,0:17:53.86,Default,,0,0,0,,Аньяро, орындаңызшы.
Dialogue: 0,0:17:53.94,0:17:55.36,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:17:55.44,0:17:57.65,Default,,0,0,0,,Жарайсың, Балто!
Dialogue: 0,0:17:57.86,0:18:00.74,Default,,0,0,0,,Сол серпінмен бар күшіңізді салыңыз!
Dialogue: 0,0:18:00.82,0:18:01.87,Default,,0,0,0,,Анашым!
Dialogue: 0,0:18:01.95,0:18:03.74,Default,,0,0,0,,Сәлем Балто
Dialogue: 0,0:18:03.83,0:18:05.62,Default,,0,0,0,,Әкем маған үйреткендей
Dialogue: 0,0:18:05.70,0:18:07.41,Default,,0,0,0,,Бар күшіңізбен шабуыл жасаңыз!
Dialogue: 0,0:18:07.50,0:18:08.50,Default,,0,0,0,,Әке!
Dialogue: 0,0:18:08.87,0:18:10.96,Default,,0,0,0,,Ана әке
Dialogue: 0,0:18:11.04,0:18:12.25,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:18:12.54,0:18:14.71,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:18:14.80,0:18:15.84,Default,,0,0,0,,Сіз Титантардың бір-бірімен шайқасып жатқанын айтасыз ба?
Dialogue: 0,0:18:15.92,0:18:16.67,Default,,0,0,0,,Не?
Dialogue: 0,0:18:16.76,0:18:18.51,Default,,0,0,0,,Болашақ шешілді
Dialogue: 0,0:18:18.80,0:18:20.34,Default,,0,0,0,,Шешім жоқ
Dialogue: 0,0:18:20.68,0:18:23.97,Default,,0,0,0,,Ой! Бұл қатты тартыс болды!
Dialogue: 0,0:18:24.06,0:18:26.89,Default,,0,0,0,,Ұрыс басталып кетті!
Dialogue: 0,0:18:27.39,0:18:28.56,Default,,0,0,0,,Барт
Dialogue: 0,0:18:29.02,0:18:30.65,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:18:31.11,0:18:33.86,Default,,0,0,0,,Енді осыдан кейінгі уақыт
Dialogue: 0,0:18:33.94,0:18:36.65,Default,,0,0,0,,Бар болғаны екі Blader үшін
Dialogue: 0,0:18:37.15,0:18:38.90,Default,,0,0,0,,Жарылғыш атумен барайық
Dialogue: 0,0:18:38.99,0:18:40.36,Default,,0,0,0,,Сәйкес емес
Dialogue: 0,0:18:44.41,0:18:46.58,Default,,0,0,0,,Түнгі түсірілім
Dialogue: 0,0:18:48.25,0:18:52.04,Default,,0,0,0,,Бакусу Шот Лонгинуста да жұмыс істеуі керек.
Dialogue: 0,0:18:52.13,0:18:53.42,Default,,0,0,0,,Бұл жақсы идея.
Dialogue: 0,0:18:53.79,0:18:55.80,Default,,0,0,0,,Соңғы шоу басталады
Dialogue: 0,0:18:55.88,0:18:57.92,Default,,0,0,0,,Мен оны асыға күтемін хаха~
Dialogue: 0,0:18:58.47,0:18:59.55,Default,,0,0,0,,Луис…
Dialogue: 0,0:18:59.63,0:19:00.88,Default,,0,0,0,,Луис мырза
Dialogue: 0,0:19:01.18,0:19:02.97,Default,,0,0,0,,Мен соншалықты ерекше дайындықтан өттім.
Dialogue: 0,0:19:03.05,0:19:03.72,Default,,0,0,0,,Шешіңіз
Dialogue: 0,0:19:03.80,0:19:04.76,Default,,0,0,0,,Барт
Dialogue: 0,0:19:04.85,0:19:06.56,Default,,0,0,0,,істей алады
Dialogue: 0,0:19:08.35,0:19:09.94,Default,,0,0,0,,Ешкім нәтижелерге сәйкес келмейді.
Dialogue: 0,0:19:14.44,0:19:16.73,Default,,0,0,0,,Мен оны анық көремін
Dialogue: 0,0:19:16.86,0:19:18.53,Default,,0,0,0,,Луис сен
Dialogue: 0,0:19:18.99,0:19:20.61,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:19:20.70,0:19:22.49,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:19:22.57,0:19:23.74,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:19:26.16,0:19:27.33,Default,,0,0,0,,Үш
Dialogue: 0,0:19:28.12,0:19:28.91,Default,,0,0,0,,Екі
Dialogue: 0,0:19:29.66,0:19:30.58,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:19:31.96,0:19:34.71,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:34.79,0:19:35.71,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:19:39.55,0:19:43.47,Default,,0,0,0,,Валькири Лонгинус секіру арқылы қашып кетті.
Dialogue: 0,0:19:43.55,0:19:46.01,Default,,0,0,0,,Бұл реактивті ату
Dialogue: 0,0:19:46.10,0:19:48.10,Default,,0,0,0,,Буккамасе Валькири
Dialogue: 0,0:19:48.85,0:19:50.73,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:54.40,0:19:56.36,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:58.53,0:20:01.36,Default,,0,0,0,,Уф, өлім спиралы!
Dialogue: 0,0:20:05.53,0:20:07.49,Default,,0,0,0,,(айқай)
Dialogue: 0,0:20:07.58,0:20:08.62,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:20:20.55,0:20:21.76,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:20:22.09,0:20:22.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:23.34,0:20:24.38,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:24.51,0:20:25.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:28.76,0:20:31.27,Default,,0,0,0,,Lost Longinus Burst Finish
Dialogue: 0,0:20:31.35,0:20:32.64,Default,,0,0,0,,2-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:20:35.35,0:20:37.36,Default,,0,0,0,,Ауадағы Валькирия
Dialogue: 0,0:20:37.44,0:20:39.94,Default,,0,0,0,,Ол жарылып кетті.
Dialogue: 0,0:20:40.03,0:20:42.90,Default,,0,0,0,,Ғажайып бала Балто Аои әп-сәтте бұрышта қалды
Dialogue: 0,0:20:43.24,0:20:44.36,Default,,0,0,0,,Бал аға
Dialogue: 0,0:20:44.45,0:20:45.41,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:20:45.49,0:20:48.91,Default,,0,0,0,,Ку... Бұл ең жақсы жарылғыш ату болды.
Dialogue: 0,0:20:48.99,0:20:50.79,Default,,0,0,0,,Әлі жұмыс істемейсіз бе?
Dialogue: 0,0:20:51.04,0:20:52.41,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:20:53.46,0:20:54.67,Default,,0,0,0,,Бартқа қараңыз
Dialogue: 0,0:20:58.34,0:21:02.05,Default,,0,0,0,,Досым, бұл ең жақсы реактивті түсірілім болды.
Dialogue: 0,0:21:04.13,0:21:05.43,Default,,0,0,0,,Көбірек істеуге болады
Dialogue: 0,0:21:05.72,0:21:08.47,Default,,0,0,0,,Біз одан да әрі қарай жүре аламыз, Валькири.
Dialogue: 0,0:21:09.14,0:21:10.35,Default,,0,0,0,,Не?
Dialogue: 0,0:21:10.64,0:21:14.18,Default,,0,0,0,,Луи, мен қазір өзімді тамаша сезінемін.
Dialogue: 0,0:21:14.85,0:21:15.98,Default,,0,0,0,,Бал аға
Dialogue: 0,0:21:16.14,0:21:17.19,Default,,0,0,0,,Күлімсіреу
Dialogue: 0,0:21:17.52,0:21:18.94,Default,,0,0,0,,Аняр!
Dialogue: 0,0:21:19.02,0:21:20.69,Default,,0,0,0,,Бұл кәдімгі Балто.
Dialogue: 0,0:21:21.48,0:21:23.03,Default,,0,0,0,,Ахобалт!
Dialogue: 0,0:21:23.44,0:21:24.61,Default,,0,0,0,,Haha~n
Dialogue: 0,0:21:24.70,0:21:27.66,Default,,0,0,0,,Міне, Киракира-кун өзінің шынайы мүмкіндігін көрсетеді.
Dialogue: 0,0:21:27.74,0:21:28.87,Default,,0,0,0,,Na~is
Dialogue: 0,0:21:29.07,0:21:30.58,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:21:30.66,0:21:32.20,Default,,0,0,0,,Мынау мынау
Dialogue: 0,0:21:32.29,0:21:34.37,Default,,0,0,0,,Мен мұны көргім келді.
Dialogue: 0,0:21:34.75,0:21:36.62,Default,,0,0,0,,Иә, Барто.
Dialogue: 0,0:21:36.71,0:21:38.25,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:21:38.75,0:21:40.75,Default,,0,0,0,,Күн қызып барады~
Dialogue: 0,0:21:40.84,0:21:42.21,Default,,0,0,0,,Ол жанып тұр
Dialogue: 0,0:21:43.26,0:21:44.46,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:21:45.05,0:21:47.30,Default,,0,0,0,,кеттік досым
Dialogue: 0,0:21:47.51,0:21:49.22,Default,,0,0,0,,Чи…
Dialogue: 0,0:21:50.22,0:21:51.18,Default,,0,0,0,,Хмф!
Dialogue: 0,0:21:52.60,0:21:53.97,Default,,0,0,0,,Қиындық!
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.44,0:23:28.74,Default,,0,0,0,,Ойлана берсең, армандарың орындалады
Dialogue: 0,0:23:29.28,0:23:31.70,Default,,0,0,0,,Мен финалда Луимен күресіп жатырмын.
Dialogue: 0,0:23:32.53,0:23:34.87,Default,,0,0,0,,Сіз жеңе алмайтын қарсылас болмайды
Dialogue: 0,0:23:35.45,0:23:38.16,Default,,0,0,0,,Менің өте үмітсіз супер толық күшім
Dialogue: 0,0:23:38.25,0:23:40.37,Default,,0,0,0,,Барлығыңыз, қараңыздар!
Dialogue: 0,0:23:40.79,0:23:42.83,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:42.92,0:23:44.88,Default,,0,0,0,,Шешіңіз! Серіктес (Валкирия)!
Dialogue: 0,0:23:44.96,0:23:46.63,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.96,0:23:48.80,Default,,0,0,0,,Бар, ат!
