Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.50,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.21,0:00:12.72,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.80,0:00:14.80,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.88,0:00:17.10,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.18,0:00:19.26,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.10,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.23,0:00:26.15,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.23,0:00:28.73,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.07,0:00:33.07,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:33.65,0:00:35.11,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:00:35.41,0:00:38.78,Default,,0,0,0,,Шынымды айтсам, мен ұлттық турнирде ойыншы ретінде ант беремін.
Dialogue: 0,0:00:39.24,0:00:41.20,Default,,0,0,0,,Маған кеше қоңырау түсті.
Dialogue: 0,0:00:41.29,0:00:43.33,Default,,0,0,0,,WBBA штаб-пәтерінен.
Dialogue: 0,0:00:43.62,0:00:45.96,Default,,0,0,0,,Аа, неге мен емес?
Dialogue: 0,0:00:46.04,0:00:47.38,Default,,0,0,0,,Сіз мұны істегіңіз келді ме?
Dialogue: 0,0:00:47.54,0:00:48.59,Default,,0,0,0,,Өйткені
Dialogue: 0,0:00:48.67,0:00:52.84,Default,,0,0,0,,Мына Балттың ойыншы боламын деп ант беріп жатқанына сене аласыз ба?
Dialogue: 0,0:00:53.59,0:00:55.43,Default,,0,0,0,,Керемет рөл, Балто.
Dialogue: 0,0:00:55.76,0:00:57.43,Default,,0,0,0,,Хэхе~ Жақсы, жақсы.
Dialogue: 0,0:00:57.72,0:00:59.60,Default,,0,0,0,,Телефон қоңырауынан кейін қиын.
Dialogue: 0,0:00:59.68,0:01:01.18,Default,,0,0,0,,Ана...
Dialogue: 0,0:01:03.06,0:01:04.48,Default,,0,0,0,,(Бейне түсіру дыбысы)
Dialogue: 0,0:01:05.27,0:01:08.52,Default,,0,0,0,,Балттың шуақты көрінісін толық жазу
Dialogue: 0,0:01:09.69,0:01:12.19,Default,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:01:12.53,0:01:14.44,Default,,0,0,0,,Барлығы шу шығарып жатыр.
Dialogue: 0,0:01:14.53,0:01:16.24,Default,,0,0,0,,Бұл тым асыра айтылған ба?
Dialogue: 0,0:01:16.36,0:01:17.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:17.57,0:01:19.24,Default,,0,0,0,,Өйткені бұл оңай.
Dialogue: 0,0:01:19.32,0:01:22.54,Default,,0,0,0,,Менің ойымша, сіз шайқасты қазір бастаймын деп айта аласыз.
Dialogue: 0,0:01:22.83,0:01:24.50,Default,,0,0,0,,Оңай...?
Dialogue: 0,0:01:24.75,0:01:28.42,Default,,0,0,0,,Әй, сен ұлттық турнирдің не екенін білесің бе?
Dialogue: 0,0:01:28.50,0:01:30.84,Default,,0,0,0,,Сондықтан бәріміз бірге шайқасамыз.
Dialogue: 0,0:01:30.92,0:01:32.25,Default,,0,0,0,,Жеңіске ұмтылу
Dialogue: 0,0:01:32.67,0:01:35.80,Default,,0,0,0,,Бұл жолы қандай ерекшелік болды.
Dialogue: 0,0:01:36.01,0:01:37.47,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:37.55,0:01:41.68,Default,,0,0,0,,Блейдерлер мен желдеткіштер елдің түкпір-түкпірінен келеді және ол өте толы.
Dialogue: 0,0:01:41.93,0:01:43.43,Default,,0,0,0,,Көп...
Dialogue: 0,0:01:43.77,0:01:46.48,Default,,0,0,0,,Және барлық жарыстар теледидардан көрсетіледі.
Dialogue: 0,0:01:46.56,0:01:47.60,Default,,0,0,0,,Ах… Оу
Dialogue: 0,0:01:48.02,0:01:50.15,Default,,0,0,0,,Әрине, елдің түкпір-түкпіріндегі адамдар қарап отыр.
Dialogue: 0,0:01:50.40,0:01:51.82,Default,,0,0,0,,Ел бойынша?
Dialogue: 0,0:01:52.27,0:01:54.07,Default,,0,0,0,,Не болды?
Dialogue: 0,0:01:54.19,0:01:57.61,Default,,0,0,0,,Blader өкілі ретінде сіз сәтсіздікке ұшырай алмайсыз.
Dialogue: 0,0:01:57.95,0:02:00.07,Default,,0,0,0,,Сәтсіздікке ұшырау мүмкін емес...
Dialogue: 0,0:02:03.33,0:02:04.58,Default,,0,0,0,,Арнайы дайындық.
Dialogue: 0,0:02:12.84,0:02:15.21,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:02:15.55,0:02:20.72,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:32.02,0:02:35.40,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:35.90,0:02:38.03,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:38.44,0:02:42.57,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:42.70,0:02:45.91,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:46.04,0:02:52.46,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:52.75,0:02:57.17,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:57.67,0:03:03.09,Default,,0,0,0,,Дауысты дауыстап, дірілдеп ойнайық
Dialogue: 0,0:03:03.22,0:03:05.47,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:05.56,0:03:10.27,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:03:10.44,0:03:15.52,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:03:15.82,0:03:18.07,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:03:18.28,0:03:20.61,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:03:20.90,0:03:24.82,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:03:24.99,0:03:30.00,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:30.20,0:03:32.37,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:36.54,0:03:39.17,Default,,0,0,0,,№1 мақсат
Dialogue: 0,0:03:40.01,0:03:41.38,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:41.93,0:03:43.43,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:03:43.93,0:03:46.76,Default,,0,0,0,,Бұл біз ойлап тапқан спортшы антының мәтіні.
Dialogue: 0,0:03:46.85,0:03:49.35,Default,,0,0,0,,Сондықтан оны арнайы дайындықтан өткізсеңіз, бәрі жақсы болады.
Dialogue: 0,0:03:49.68,0:03:50.73,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:03:51.02,0:03:53.19,Default,,0,0,0,,Егер сізде бұл болса, сізде бәрі жақсы болады.
Dialogue: 0,0:03:54.10,0:03:54.94,Default,,0,0,0,,Құрметті...
Dialogue: 0,0:03:55.23,0:03:59.19,Default,,0,0,0,,Сәлем! Оны ұстап тұрғанда ештеңе істемейді деп ойлаймын.
Dialogue: 0,0:03:59.28,0:04:00.11,Default,,0,0,0,,Е! Жоқ?
Dialogue: 0,0:04:00.19,0:04:01.32,Default,,0,0,0,,No
Dialogue: 0,0:04:01.40,0:04:03.20,Default,,0,0,0,,Бұл есімде.
Dialogue: 0,0:04:06.62,0:04:09.45,Default,,0,0,0,,Е! Мүмкін емес, мүмкін емес, мүмкін емес!
Dialogue: 0,0:04:09.54,0:04:10.83,Default,,0,0,0,,Қашпа
Dialogue: 0,0:04:10.91,0:04:12.83,Default,,0,0,0,,Сіз мұны істеймін дедіңіз ғой, солай ма?
Dialogue: 0,0:04:12.91,0:04:16.29,Default,,0,0,0,,Менің есімде жоқ, бұл ұзақ.
Dialogue: 0,0:04:16.50,0:04:19.17,Default,,0,0,0,,Бұл дұрыс емес. Оны оқып көріңіз.
Dialogue: 0,0:04:25.76,0:04:27.93,Default,,0,0,0,,Se… ант
Dialogue: 0,0:04:28.01,0:04:30.31,Default,,0,0,0,,Біз, барлық жүзушілер,
Dialogue: 0,0:04:30.93,0:04:32.52,Default,,0,0,0,,Blader - бұл
Dialogue: 0,0:04:33.52,0:04:36.94,Default,,0,0,0,,Brea… Da… Brea
Dialogue: 0,0:04:37.15,0:04:38.65,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:04:38.98,0:04:41.73,Default,,0,0,0,,Мен канжиді оқи алмаймын
Dialogue: 0,0:04:42.99,0:04:44.82,Default,,0,0,0,,Қызып кеткен
Dialogue: 0,0:04:45.49,0:04:46.99,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:04:47.82,0:04:49.16,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:04:49.24,0:04:50.91,Default,,0,0,0,,Сабақтан кейін саябақта жаттығу.
Dialogue: 0,0:04:51.41,0:04:52.79,Default,,0,0,0,,Бейне жаттығуы!
Dialogue: 0,0:04:52.87,0:04:54.16,Default,,0,0,0,,Спортшының ант беруі
Dialogue: 0,0:04:57.33,0:05:00.50,Default,,0,0,0,,(скейтборд дыбысы)
Dialogue: 0,0:05:05.34,0:05:06.76,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:05:06.84,0:05:08.09,Default,,0,0,0,,Кеш болды~
Dialogue: 0,0:05:08.22,0:05:09.64,Default,,0,0,0,,Ха ха ха...?
Dialogue: 0,0:05:14.10,0:05:14.98,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:05:22.07,0:05:24.15,Default,,0,0,0,,Керемет, ғажап, ғажап!
Dialogue: 0,0:05:24.24,0:05:25.65,Default,,0,0,0,,Өте керемет
Dialogue: 0,0:05:25.74,0:05:27.82,Default,,0,0,0,,Иә? Бұл қалыпты жағдай
Dialogue: 0,0:05:27.91,0:05:29.66,Default,,0,0,0,,Мен мұндай нәрсені бірінші рет көріп тұрмын.
Dialogue: 0,0:05:30.03,0:05:32.33,Default,,0,0,0,,Мұны тағы бір рет орындаңыз.
Dialogue: 0,0:05:33.12,0:05:34.37,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:51.51,0:05:52.47,Default,,0,0,0,,Керемет
Dialogue: 0,0:05:52.93,0:05:55.39,Default,,0,0,0,,Сонымен, мен де солай істей аламын ба деп ойлаймын?
Dialogue: 0,0:05:55.64,0:05:58.39,Default,,0,0,0,,Бұл кенеттен мүмкін емес.
Dialogue: 0,0:05:58.81,0:06:00.23,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:06:00.31,0:06:01.40,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:06:01.98,0:06:04.11,Default,,0,0,0,,Ал, неге байқамайсың?
Dialogue: 0,0:06:04.19,0:06:05.23,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:06:08.74,0:06:10.57,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:06:11.45,0:06:13.41,Default,,0,0,0,,100км/сағ ~
Dialogue: 0,0:06:13.49,0:06:15.08,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:06:16.83,0:06:17.91,Default,,0,0,0,,Жақсы
Dialogue: 0,0:06:18.00,0:06:20.29,Default,,0,0,0,,Бұл қалай иіледі?
Dialogue: 0,0:06:20.37,0:06:22.71,Default,,0,0,0,,Тепе-теңдікті сақтай отырып, денеңізді еңкейтіңіз
Dialogue: 0,0:06:22.79,0:06:24.05,Default,,0,0,0,,Баланс…
Dialogue: 0,0:06:24.13,0:06:25.00,Default,,0,0,0,,Бұрынғы
Dialogue: 0,0:06:27.55,0:06:28.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:29.47,0:06:31.43,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:06:34.60,0:06:37.68,Default,,0,0,0,,Атта... Иә?
Dialogue: 0,0:06:38.94,0:06:40.27,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:06:40.94,0:06:42.11,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:06:44.48,0:06:45.65,Default,,0,0,0,,Ах
Dialogue: 0,0:06:47.03,0:06:48.07,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:48.44,0:06:51.07,Default,,0,0,0,,Жарайды, бірақ мен де абайсызда болдым.
Dialogue: 0,0:06:51.45,0:06:52.41,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:06:52.91,0:06:53.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:53.91,0:06:56.83,Default,,0,0,0,,Жақсы, мен сенің байқап көргің келетінін айттым.
Dialogue: 0,0:07:01.17,0:07:02.83,Default,,0,0,0,,Рахмет~
Dialogue: 0,0:07:03.50,0:07:05.25,Default,,0,0,0,,Оған көмектесу мүмкін емес. Жаяу жүруім керек пе?
Dialogue: 0,0:07:07.84,0:07:08.97,Default,,0,0,0,,Ах
Dialogue: 0,0:07:12.89,0:07:14.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:19.14,0:07:21.94,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:22.31,0:07:24.77,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:25.65,0:07:27.36,Default,,0,0,0,,Ақыры келді ме?
Dialogue: 0,0:07:27.48,0:07:29.69,Default,,0,0,0,,Сөйтпе.
Dialogue: 0,0:07:30.03,0:07:31.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:31.11,0:07:32.61,Default,,0,0,0,,Мен апатқа ұшырадым.
Dialogue: 0,0:07:32.91,0:07:33.87,Default,,0,0,0,,Жазатайым оқиға?
Dialogue: 0,0:07:33.95,0:07:35.74,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:07:35.91,0:07:38.20,Default,,0,0,0,,Арнайы жаттығу жасайық!
Dialogue: 0,0:07:43.29,0:07:44.75,Default,,0,0,0,,Шық!
Dialogue: 0,0:07:44.83,0:07:45.63,Default,,0,0,0,,Не?
Dialogue: 0,0:07:45.96,0:07:47.17,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:47.25,0:07:48.42,Default,,0,0,0,,Валькири туралы не деуге болады?
Dialogue: 0,0:07:49.30,0:07:51.09,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:07:51.38,0:07:52.84,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:07:53.34,0:07:55.34,Default,,0,0,0,,(Цубаки) Косей! Уф!
Dialogue: 0,0:07:55.43,0:07:57.39,Default,,0,0,0,,Жоқ! жоқ! жоқ!
Dialogue: 0,0:07:59.27,0:08:00.10,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:08:01.23,0:08:02.39,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:02.77,0:08:03.73,Default,,0,0,0,,Іске қосу құрылғысы туралы не деуге болады?
Dialogue: 0,0:08:05.61,0:08:06.73,Default,,0,0,0,,~ бар
Dialogue: 0,0:08:08.11,0:08:10.74,Default,,0,0,0,,Ей, эй, мықты бол, капитан.
Dialogue: 0,0:08:10.82,0:08:14.07,Default,,0,0,0,,Түскі үзіліс кезінде біз Bay Club-та айналысатын кезіміз болды, солай ма?
Dialogue: 0,0:08:14.16,0:08:16.20,Default,,0,0,0,,Сонда мен мектепке қайта баруым керек пе?
Dialogue: 0,0:08:16.45,0:08:17.66,Default,,0,0,0,,Мектеп... Ах!
Dialogue: 0,0:08:20.66,0:08:22.00,Default,,0,0,0,,Мүмкін сол кезде
Dialogue: 0,0:08:24.83,0:08:25.83,Default,,0,0,0,,Барт
Dialogue: 0,0:08:25.92,0:08:27.29,Default,,0,0,0,,Бар-нии-чан
Dialogue: 0,0:08:31.42,0:08:32.67,Default,,0,0,0,,Табылмады
Dialogue: 0,0:08:32.76,0:08:34.22,Default,,0,0,0,,Эй, еш жерде.
Dialogue: 0,0:08:34.30,0:08:35.68,Default,,0,0,0,,Бұл да
Dialogue: 0,0:08:35.76,0:08:37.89,Default,,0,0,0,,Хонма, сен мұны істей алмайсың.
Dialogue: 0,0:08:37.97,0:08:39.64,Default,,0,0,0,,Менің полиция жәшігіне хабарлаудан басқа амалым жоқ.
Dialogue: 0,0:08:40.22,0:08:43.14,Default,,0,0,0,,А... а...
Dialogue: 0,0:08:44.39,0:08:47.06,Default,,0,0,0,,Сіз Валькирисіз күресе аласыз ба?
Dialogue: 0,0:08:47.40,0:08:49.36,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:08:50.73,0:08:52.65,Default,,0,0,0,,Мықты бол, Балто.
Dialogue: 0,0:08:52.74,0:08:54.86,Default,,0,0,0,,О... менің…
Dialogue: 0,0:08:55.28,0:08:58.28,Default,,0,0,0,,Хехехе, дәл осы көк Балт.
Dialogue: 0,0:08:58.37,0:09:00.08,Default,,0,0,0,,Дәлірек айтқанда, зомбилер.
Dialogue: 0,0:09:01.20,0:09:03.00,Default,,0,0,0,,Val…
Dialogue: 0,0:09:04.12,0:09:05.96,Default,,0,0,0,,Val~!
Dialogue: 0,0:09:09.67,0:09:11.21,Default,,0,0,0,,913
Dialogue: 0,0:09:11.88,0:09:13.21,Default,,0,0,0,,914
Dialogue: 0,0:09:14.30,0:09:15.97,Default,,0,0,0,,Иә? Quon
Dialogue: 0,0:09:16.47,0:09:18.30,Default,,0,0,0,,Біраз уақыт болды, Юго.
Dialogue: 0,0:09:19.89,0:09:21.47,Default,,0,0,0,,Бұл Куон емес пе?
Dialogue: 0,0:09:21.72,0:09:23.43,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:09:23.52,0:09:24.43,Default,,0,0,0,,Енгізу
Dialogue: 0,0:09:24.52,0:09:26.52,Default,,0,0,0,,Ол қазірдің өзінде бар.
Dialogue: 0,0:09:27.02,0:09:29.06,Default,,0,0,0,,Бұл өзгермейді.
Dialogue: 0,0:09:29.15,0:09:30.15,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:30.77,0:09:33.15,Default,,0,0,0,,Сіз мұны істеп жатырсыз...
Dialogue: 0,0:09:33.69,0:09:34.78,Default,,0,0,0,,Ол бұзылды ма?
Dialogue: 0,0:09:35.44,0:09:37.95,Default,,0,0,0,,Мен сенің атаңнан сұрайын деп ойладым.
Dialogue: 0,0:09:38.20,0:09:42.16,Default,,0,0,0,,Гахахахахах, қарт адамға маманданған.
Dialogue: 0,0:09:42.24,0:09:44.45,Default,,0,0,0,,Жарайды... Жаңа айттым.
Dialogue: 0,0:09:44.54,0:09:45.75,Default,,0,0,0,,бірақ мен әлемді өзгерту үшін өзім кісі өлтірушіге айналар едім деп ойламаймын
Dialogue: 0,0:09:46.04,0:09:47.46,Default,,0,0,0,,Укио сонда ма?
Dialogue: 0,0:09:49.00,0:09:51.59,Default,,0,0,0,,Сіз мұнда жаңасыз ба?
Dialogue: 0,0:09:52.04,0:09:53.30,Default,,0,0,0,,Бұл Юкифуки Укио.
Dialogue: 0,0:09:53.80,0:09:55.92,Default,,0,0,0,,Мен мұнда сен кеткен соң келдім.
Dialogue: 0,0:09:56.51,0:09:57.88,Default,,0,0,0,,Мен сары-жасыл Квонмын
Dialogue: 0,0:09:58.05,0:09:58.88,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:09:59.39,0:10:01.97,Default,,0,0,0,,Мен сенің атыңды естідім. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:10:02.51,0:10:04.06,Default,,0,0,0,,Оны түзетіңіз.
Dialogue: 0,0:10:04.18,0:10:06.48,Default,,0,0,0,,Сіз мұны жақсы орындадыңыз, солай ма? Мынадай нәрсе
Dialogue: 0,0:10:07.27,0:10:08.77,Default,,0,0,0,,Бұл бірден орындалады
Dialogue: 0,0:10:09.65,0:10:11.52,Default,,0,0,0,,Сонымен бүгін не болды?
Dialogue: 0,0:10:11.65,0:10:14.19,Default,,0,0,0,,Ал, мен сәлем беруге келдім.
Dialogue: 0,0:10:14.28,0:10:15.48,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:15.86,0:10:18.28,Default,,0,0,0,,Мен де республикалық турнирге қатысамын.
Dialogue: 0,0:10:18.78,0:10:20.78,Default,,0,0,0,,О! Сіз де барасыз ба?
Dialogue: 0,0:10:21.37,0:10:23.49,Default,,0,0,0,,Біз енді бір дожода емеспіз.
Dialogue: 0,0:10:23.87,0:10:27.04,Default,,0,0,0,,Ел сахнасында мен сендермен жарысамын.
Dialogue: 0,0:10:27.33,0:10:29.79,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:10:30.71,0:10:32.38,Default,,0,0,0,,Шақа бақытты көрінеді.
Dialogue: 0,0:10:32.46,0:10:36.21,Default,,0,0,0,,Осы дойдо Шакаға кімнің күші жетеді?
Dialogue: 0,0:10:36.30,0:10:37.80,Default,,0,0,0,,Жай Куон
Dialogue: 0,0:10:38.72,0:10:40.93,Default,,0,0,0,,От Шака және Мұз Куоны
Dialogue: 0,0:10:41.05,0:10:43.51,Default,,0,0,0,,Екеуміз үнемі бір-бірімізбен жарысатынбыз.
Dialogue: 0,0:10:44.31,0:10:46.22,Default,,0,0,0,,Иә... әрқашан
Dialogue: 0,0:10:48.23,0:10:51.31,Default,,0,0,0,,Quon Quad Quetzalcatl қолданады
Dialogue: 0,0:10:51.90,0:10:53.81,Default,,0,0,0,,Оны жағымды да, зорлық та деуге болады.
Dialogue: 0,0:10:53.94,0:10:57.78,Default,,0,0,0,,Ксено Экскалибурдың шабуылдарына икемді түрде тосқауыл қоя алады.
Dialogue: 0,0:10:57.86,0:11:01.32,Default,,0,0,0,,Қорғаныс түрі шығанақ
Dialogue: 0,0:11:01.70,0:11:03.95,Default,,0,0,0,,Екеуінің арасындағы бәсеке әрқашан жақын.
Dialogue: 0,0:11:04.16,0:11:05.53,Default,,0,0,0,,Жай ғана қарсылас
Dialogue: 0,0:11:05.62,0:11:09.12,Default,,0,0,0,,Екеуміз де бір-бірімізді мойындадық, жарыстан ләззат алдық.
Dialogue: 0,0:11:09.66,0:11:12.21,Default,,0,0,0,,Олай болса Куон неге бұл жерден кетіп қалды?
Dialogue: 0,0:11:12.29,0:11:14.42,Default,,0,0,0,,Менің айтқаным осы
Dialogue: 0,0:11:16.59,0:11:20.30,Default,,0,0,0,,Мен өзімді кеңірек әлемге танытқым келеді.
Dialogue: 0,0:11:20.72,0:11:22.39,Default,,0,0,0,,Муша жаттығуы дегеніміз не?
Dialogue: 0,0:11:22.47,0:11:24.01,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:11:24.30,0:11:26.85,Default,,0,0,0,,Мықты жігіттер өте көп.
Dialogue: 0,0:11:26.93,0:11:29.64,Default,,0,0,0,,Мен олармен күресіп, өзімді жаттықтырғым келеді.
Dialogue: 0,0:11:30.39,0:11:33.10,Default,,0,0,0,,Мен сені бір күні солай айтатын шығар деп ойладым.
Dialogue: 0,0:11:34.77,0:11:37.23,Default,,0,0,0,,Барып қайт
Dialogue: 0,0:11:37.90,0:11:39.69,Default,,0,0,0,,Мен де қолымды сипап, күтіп тұрмын.
Dialogue: 0,0:11:40.69,0:11:42.95,Default,,0,0,0,,Жарайды, мен сен осылай айтасың деп ойладым.
Dialogue: 0,0:11:47.03,0:11:49.58,Default,,0,0,0,,Себебі күшті жаулар көбейді.
Dialogue: 0,0:11:50.66,0:11:52.79,Default,,0,0,0,,Қалай болды? Жауынгерлік дайындық туралы не деуге болады?
Dialogue: 0,0:11:52.96,0:11:55.25,Default,,0,0,0,,Бұл қызықты болды.
Dialogue: 0,0:11:55.50,0:11:58.21,Default,,0,0,0,,Менің ойымша, сіз оны дожо бұзу деп атай аласыз.
Dialogue: 0,0:11:59.00,0:12:01.01,Default,,0,0,0,,Мен әртүрлі шығанақ клубтарын араладым.
Dialogue: 0,0:12:07.14,0:12:08.26,Default,,0,0,0,,Мен сондамын
Dialogue: 0,0:12:08.35,0:12:11.31,Default,,0,0,0,,Мен шығанақтар мен шайқастар туралы әртүрлі ойлау тәсілдерін кездестірдім.
Dialogue: 0,0:12:12.14,0:12:13.89,Default,,0,0,0,,Құйрықтармен шайқас
Dialogue: 0,0:12:13.98,0:12:16.31,Default,,0,0,0,,Сен маған жаңа жол аштың.
Dialogue: 0,0:12:16.90,0:12:19.86,Default,,0,0,0,,Мен күресуді жалғастыра бердім, мен достар таптым.
Dialogue: 0,0:12:19.94,0:12:22.03,Default,,0,0,0,,Эй, бұл керемет.
Dialogue: 0,0:12:22.53,0:12:25.32,Default,,0,0,0,,Мен сол балалармен топ құрдым.
Dialogue: 0,0:12:25.66,0:12:28.62,Default,,0,0,0,,Командалық жарыстан бастап республикалық турнирге қатысу
Dialogue: 0,0:12:28.99,0:12:31.33,Default,,0,0,0,,Қылыш жалынына қайта оралмайсың ба?
Dialogue: 0,0:12:31.70,0:12:35.33,Default,,0,0,0,,Ал, мен тапқан жолдың қандай екенін көрсетемін.
Dialogue: 0,0:12:36.71,0:12:38.88,Default,,0,0,0,,Әйтпесе қызық болмас еді.
Dialogue: 0,0:12:39.34,0:12:40.63,Default,,0,0,0,,Бірақ Куон
Dialogue: 0,0:12:41.01,0:12:43.76,Default,,0,0,0,,Бейдің әлемі қозғалады
Dialogue: 0,0:12:45.01,0:12:46.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:46.72,0:12:49.51,Default,,0,0,0,,Сенбейтін пышақшалар үнемі пайда болады.
Dialogue: 0,0:12:49.64,0:12:52.06,Default,,0,0,0,,Ең сорақысы сенсің, солай ма?
Dialogue: 0,0:12:52.48,0:12:55.56,Default,,0,0,0,,Бұл тек мен емес, Куришу да.
Dialogue: 0,0:12:55.64,0:12:57.19,Default,,0,0,0,,Егер мен сізге Blader бар десем ше?
Dialogue: 0,0:12:57.94,0:12:59.61,Default,,0,0,0,,Куришуға дейін...
Dialogue: 0,0:13:00.48,0:13:02.86,Default,,0,0,0,,Ол қолданатын би - Валькири.
Dialogue: 0,0:13:02.94,0:13:06.49,Default,,0,0,0,,Сіз естіген жоқсыз ба? Өткен күнгі қайталау матчында... А?
Dialogue: 0,0:13:06.66,0:13:08.07,Default,,0,0,0,,Сіз, бұл...
Dialogue: 0,0:13:08.16,0:13:09.74,Default,,0,0,0,,Бұл Валькирия ма?
Dialogue: 0,0:13:10.20,0:13:12.12,Default,,0,0,0,,Сіз Балтомен кездестіңіз бе?
Dialogue: 0,0:13:12.20,0:13:13.83,Default,,0,0,0,,Ол Балто деп аталады ма?
Dialogue: 0,0:13:13.91,0:13:16.54,Default,,0,0,0,,Жарайды, ол менің скейтбордымды сындырды.
Dialogue: 0,0:13:16.87,0:13:18.63,Default,,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:13:18.71,0:13:21.13,Default,,0,0,0,,Мен қазір Балтоның жігітін іздеп жүрмін.
Dialogue: 0,0:13:21.25,0:13:22.51,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:13:22.88,0:13:24.59,Default,,0,0,0,,Егер сіз онымен соғыссаңыз
Dialogue: 0,0:13:24.72,0:13:28.01,Default,,0,0,0,,Сіздің жолыңыз одан әрі кеңеюі мүмкін.
Dialogue: 0,0:13:28.80,0:13:31.39,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:13:31.85,0:13:33.14,Default,,0,0,0,,Val…
Dialogue: 0,0:13:34.27,0:13:36.35,Default,,0,0,0,,Val… Va…
Dialogue: 0,0:13:37.39,0:13:38.73,Default,,0,0,0,,Әрқашан осылай болған
Dialogue: 0,0:13:38.81,0:13:40.65,Default,,0,0,0,,Бұл шынымен зомби.
Dialogue: 0,0:13:40.73,0:13:43.40,Default,,0,0,0,,Мен де оны полиция жәшігіне жеткіздім.
Dialogue: 0,0:13:43.48,0:13:44.15,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:13:45.95,0:13:47.32,Default,,0,0,0,,Сәлем, Барто
Dialogue: 0,0:13:47.40,0:13:50.41,Default,,0,0,0,,Жарайды, мен міндетті түрде қайтамын.
Dialogue: 0,0:13:50.49,0:13:52.49,Default,,0,0,0,,Валькири сіздің серіктесіңіз, солай ма?
Dialogue: 0,0:13:55.29,0:13:56.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:56.71,0:13:58.12,Default,,0,0,0,,Бұл ауыр.
Dialogue: 0,0:13:58.21,0:13:59.58,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:14:01.17,0:14:02.04,Default,,0,0,0,,Yes
Dialogue: 0,0:14:03.00,0:14:04.30,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:14:04.96,0:14:05.67,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:14:07.34,0:14:09.68,Default,,0,0,0,,A ba… ba…
Dialogue: 0,0:14:09.76,0:14:11.05,Default,,0,0,0,,Балто!
Dialogue: 0,0:14:11.26,0:14:12.39,Default,,0,0,0,,Тез түсіңіз
Dialogue: 0,0:14:12.51,0:14:13.14,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:13.22,0:14:14.01,Default,,0,0,0,,Не?
Dialogue: 0,0:14:14.18,0:14:16.64,Default,,0,0,0,,Валькири қайтып келді.
Dialogue: 0,0:14:16.85,0:14:18.35,Default,,0,0,0,,Валькирия
Dialogue: 0,0:14:18.48,0:14:19.69,Default,,0,0,0,,Бауырым, қиын.
Dialogue: 0,0:14:19.77,0:14:21.27,Default,,0,0,0,,Тіпті Валькири
Dialogue: 0,0:14:23.69,0:14:26.24,Default,,0,0,0,,Вал… Кири…
Dialogue: 0,0:14:26.36,0:14:27.53,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:14:28.90,0:14:31.32,Default,,0,0,0,,Валькирия! Апыр-ай!
Dialogue: 0,0:14:32.03,0:14:33.49,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:14:33.83,0:14:35.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:35.74,0:14:36.87,Default,,0,0,0,,Бұл сіздікі ме?
Dialogue: 0,0:14:37.79,0:14:40.04,Default,,0,0,0,,А... иә
Dialogue: 0,0:14:40.12,0:14:42.79,Default,,0,0,0,,менің супер менің
Dialogue: 0,0:14:42.96,0:14:44.80,Default,,0,0,0,,Уау...
Dialogue: 0,0:14:45.75,0:14:48.67,Default,,0,0,0,,Рахмет Рахмет Рахмет
Dialogue: 0,0:14:49.26,0:14:50.09,Default,,0,0,0,,Ум...
Dialogue: 0,0:14:50.18,0:14:51.47,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:14:52.55,0:14:53.93,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:14:54.43,0:14:56.10,Default,,0,0,0,,Эххе
Dialogue: 0,0:14:56.56,0:14:58.10,Default,,0,0,0,,Қайтып келдің!
Dialogue: 0,0:14:58.18,0:14:59.64,Default,,0,0,0,,Мен сенімен танысқым келді~
Dialogue: 0,0:14:59.77,0:15:01.35,Default,,0,0,0,,Саған жақсы, Бару-нии.
Dialogue: 0,0:15:01.56,0:15:02.73,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:02.81,0:15:04.23,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:04.57,0:15:05.52,Default,,0,0,0,,О.
Dialogue: 0,0:15:05.61,0:15:07.57,Default,,0,0,0,,(скейтборд дыбысы)
Dialogue: 0,0:15:10.03,0:15:12.03,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:15:14.53,0:15:15.83,Default,,0,0,0,,Құдай
Dialogue: 0,0:15:15.91,0:15:19.83,Default,,0,0,0,,Ол Валкириді осында әкелген Бейдің құдайы.
