Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.21,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.30,0:00:12.76,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.84,0:00:14.80,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.88,0:00:17.05,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.14,0:00:18.85,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.90,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.07,0:00:34.28,Default,,0,0,0,,Үш екі бір (Аои Уолд) Ұлттық турнир 1-тур
Dialogue: 0,0:00:34.57,0:00:37.74,Default,,0,0,0,,Барыңыз... Атыңыз!
Dialogue: 0,0:00:40.99,0:00:43.66,Default,,0,0,0,,Шуға Наоки кедергі жасады
Dialogue: 0,0:00:46.33,0:00:48.00,Default,,0,0,0,,Сол қолмен атуға ауыстырылды!
Dialogue: 0,0:00:48.59,0:00:50.13,Default,,0,0,0,,Не болды...
Dialogue: 0,0:00:50.21,0:00:52.96,Default,,0,0,0,,Мен ұшырғышты көзімді жұмып ұстадым!
Dialogue: 0,0:00:54.26,0:00:57.34,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:58.01,0:01:00.51,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:01:04.52,0:01:06.31,Default,,0,0,0,,Жоғарғы түсірілім!
Dialogue: 0,0:01:06.39,0:01:08.44,Default,,0,0,0,,Өлмеген ату!
Dialogue: 0,0:01:08.52,0:01:11.32,Default,,0,0,0,,Сонда да Шу жеңді...
Dialogue: 0,0:01:11.40,0:01:13.36,Default,,0,0,0,,Екінші турға өту
Dialogue: 0,0:01:14.40,0:01:16.49,Default,,0,0,0,,Келесі менің екінші турым.
Dialogue: 0,0:01:16.57,0:01:18.24,Default,,0,0,0,,Жанып жатыр!
Dialogue: 0,0:01:26.79,0:01:29.17,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:29.50,0:01:34.67,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:45.98,0:01:49.35,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:49.85,0:01:51.98,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:52.40,0:01:56.53,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:56.65,0:01:59.86,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:59.99,0:02:06.41,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:06.70,0:02:11.13,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:11.63,0:02:17.05,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:17.17,0:02:19.43,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:19.51,0:02:24.22,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:24.39,0:02:29.48,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:29.77,0:02:32.02,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:32.23,0:02:34.57,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:34.86,0:02:38.78,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:38.95,0:02:43.95,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:44.16,0:02:46.33,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:50.16,0:02:53.17,Default,,0,0,0,,Гейл ағыны!
Dialogue: 0,0:02:54.09,0:02:56.71,Default,,0,0,0,,Жарайды! ұлдар мен қыздар
Dialogue: 0,0:02:56.80,0:02:58.34,Default,,0,0,0,,Ұлттық турнир жекелей жарыс
Dialogue: 0,0:02:58.42,0:03:00.17,Default,,0,0,0,,Тек бірінші раунд қалды -
Dialogue: 0,0:03:00.26,0:03:02.01,Default,,0,0,0,,Тағы 3 топ қалды!
Dialogue: 0,0:03:04.10,0:03:05.26,Default,,0,0,0,,Әрі қарай!
Dialogue: 0,0:03:05.35,0:03:06.56,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:03:06.76,0:03:07.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:07.97,0:03:10.23,Default,,0,0,0,,Уау~
Dialogue: 0,0:03:15.19,0:03:17.78,Default,,0,0,0,,Бір әсер!
Dialogue: 0,0:03:20.86,0:03:21.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:22.07,0:03:23.28,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:03:23.36,0:03:26.16,Default,,0,0,0,,Бейблейд Төрт түрлендіру императоры Жанып тұрған храм Кайза
Dialogue: 0,0:03:26.37,0:03:28.54,Default,,0,0,0,,Біз кек алуға ант еткен командалық шайқастан.
Dialogue: 0,0:03:28.62,0:03:31.16,Default,,0,0,0,,Ол одан да күштірек!
Dialogue: 0,0:03:31.25,0:03:32.12,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:03:32.21,0:03:33.17,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:03:33.25,0:03:35.00,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:35.08,0:03:36.79,Default,,0,0,0,,Бұл қорқынышты...
Dialogue: 0,0:03:36.92,0:03:38.76,Default,,0,0,0,,Жақсы! Шака күткендей
Dialogue: 0,0:03:38.84,0:03:41.93,Default,,0,0,0,,Әрине! Уа... бұл...
Dialogue: 0,0:03:44.22,0:03:45.80,Default,,0,0,0,,Сары-жасыл квон…
Dialogue: 0,0:03:45.89,0:03:47.39,Default,,0,0,0,,Егер Шака жеңсе...
Dialogue: 0,0:03:47.47,0:03:50.56,Default,,0,0,0,,Куон мен Балт Аои жекпе-жегінің жеңімпазы шығар.
Dialogue: 0,0:03:50.64,0:03:52.19,Default,,0,0,0,,Қайсысы келеді...
Dialogue: 0,0:03:55.73,0:03:58.94,Default,,0,0,0,,Гигант Гайя 1 ұпай
Dialogue: 0,0:03:59.03,0:04:02.32,Default,,0,0,0,,Go Chakake 3-0 жеңді!
Dialogue: 0,0:04:02.40,0:04:03.40,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:04:03.49,0:04:04.74,Default,,0,0,0,,Чакаке барыңыз
Dialogue: 0,0:04:04.82,0:04:07.53,Default,,0,0,0,,Бірінші раундтан еркін сөйлеп өтті!
Dialogue: 0,0:04:07.62,0:04:08.95,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:09.04,0:04:11.08,Default,,0,0,0,,Гоның күші де артты.
Dialogue: 0,0:04:11.29,0:04:14.92,Default,,0,0,0,,Әй, әркім өз шегіне дейін жаттығады.
Dialogue: 0,0:04:15.00,0:04:18.13,Default,,0,0,0,,Керемет барлығы Тамаша...
Dialogue: 0,0:04:18.21,0:04:20.84,Default,,0,0,0,,Жарайсыңдар! Жанып жатыр!
Dialogue: 0,0:04:20.92,0:04:23.30,Default,,0,0,0,,Мен де мұны істеуім керек!
Dialogue: 0,0:04:31.02,0:04:32.89,Default,,0,0,0,,Жақсы ау
Dialogue: 0,0:04:33.31,0:04:34.31,Default,,0,0,0,,Quon…
Dialogue: 0,0:04:34.39,0:04:35.85,Default,,0,0,0,,Бір әсер
Dialogue: 0,0:04:35.94,0:04:37.65,Default,,0,0,0,,Мен оны жақсы көрдім.
Dialogue: 0,0:04:38.11,0:04:39.86,Default,,0,0,0,,Дақтарды кетірмеңіз.
Dialogue: 0,0:04:39.94,0:04:41.19,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:04:41.44,0:04:43.90,Default,,0,0,0,,Жарайды, мен сені жеңетін адаммын.
Dialogue: 0,0:04:43.99,0:04:45.15,Default,,0,0,0,,Менің алдымда-
Dialogue: 0,0:04:45.24,0:04:47.95,Default,,0,0,0,,Сізді жеңетін адам жоқ па?
Dialogue: 0,0:04:48.78,0:04:50.41,Default,,0,0,0,,Бұл күш Луиге қарсы шайқаста...
Dialogue: 0,0:04:51.24,0:04:54.79,Default,,0,0,0,,Мен сенімен бұрын соғысқан Балто емеспін.
Dialogue: 0,0:04:55.54,0:04:57.13,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз
Dialogue: 0,0:04:57.21,0:05:00.30,Default,,0,0,0,,Мен мұндайды ешқашан істеген емеспін.
Dialogue: 0,0:05:00.38,0:05:01.67,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:05:01.75,0:05:03.26,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:05:03.34,0:05:04.67,Default,,0,0,0,,Шака~!
Dialogue: 0,0:05:05.63,0:05:08.26,Default,,0,0,0,,Дәл қазір шайқас керемет болды!
Dialogue: 0,0:05:08.76,0:05:10.22,Default,,0,0,0,,Барто Аои…
Dialogue: 0,0:05:10.47,0:05:11.81,Default,,0,0,0,,Әй, Куон!
Dialogue: 0,0:05:12.06,0:05:14.43,Default,,0,0,0,,Келесі шайқасты асыға күтеміз!
Dialogue: 0,0:05:14.52,0:05:16.85,Default,,0,0,0,,Келесі жолы мен міндетті түрде жеңемін!
Dialogue: 0,0:05:16.94,0:05:18.31,Default,,0,0,0,,Сөз-
Dialogue: 0,0:05:18.40,0:05:20.48,Default,,0,0,0,,Мен оны дәл сізге қайтарамын.
Dialogue: 0,0:05:22.44,0:05:25.28,Default,,0,0,0,,Анубис қышқылы 2 ұпай
Dialogue: 0,0:05:25.36,0:05:27.95,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:28.28,0:05:30.24,Default,,0,0,0,,Бұл өте танымал...
Dialogue: 0,0:05:30.33,0:05:32.74,Default,,0,0,0,,Неге, ол менімен сырласады.
Dialogue: 0,0:05:33.12,0:05:35.71,Default,,0,0,0,,Жанға жол сілтейтін алтын шақал!
Dialogue: 0,0:05:35.79,0:05:38.71,Default,,0,0,0,,Анубис қышқылының айналу қабілеті керемет.
Dialogue: 0,0:05:38.79,0:05:41.84,Default,,0,0,0,,Екінші турға өтіп, соңғы орынды алыңыз!
Dialogue: 0,0:05:42.34,0:05:44.01,Default,,0,0,0,,А… Акира…
Dialogue: 0,0:05:44.26,0:05:47.26,Default,,0,0,0,,Қолдауыңыз үшін көп рахмет!
Dialogue: 0,0:05:47.34,0:05:49.05,Default,,0,0,0,,Барлығының сүйіспеншілігіне рахмет-
Dialogue: 0,0:05:49.14,0:05:52.10,Default,,0,0,0,,Ақ-кун осы уақытқа дейін келді!
Dialogue: 0,0:05:52.18,0:05:53.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:53.18,0:05:55.18,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:55.27,0:05:56.77,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:05:56.85,0:05:58.35,Default,,0,0,0,,Акира Ямабуки
Dialogue: 0,0:05:58.52,0:06:02.65,Default,,0,0,0,,Ол Зактың інісі ретінде дебют жасаған жаңа кумир.
Dialogue: 0,0:06:02.73,0:06:06.19,Default,,0,0,0,,Біраз танымал болғаны үшін олар өздерін алып кетеді.
Dialogue: 0,0:06:06.28,0:06:09.20,Default,,0,0,0,,Хахаан, сендер пісіп-жетілмеген екенсіңдер.
Dialogue: 0,0:06:09.74,0:06:11.82,Default,,0,0,0,,Жаңадан келген адам осылай істейді.
Dialogue: 0,0:06:11.91,0:06:14.49,Default,,0,0,0,,Бізге тек нық тұру керек.
Dialogue: 0,0:06:14.58,0:06:17.29,Default,,0,0,0,,Ах~ Зак Сенпай!
Dialogue: 0,0:06:17.37,0:06:19.33,Default,,0,0,0,,Зак Сенпай!
Dialogue: 0,0:06:19.42,0:06:23.63,Default,,0,0,0,,Аккун, мен Сенпайды осынша қудым!
Dialogue: 0,0:06:23.71,0:06:24.59,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:24.67,0:06:27.67,Default,,0,0,0,,Аккун сондай сүйкімді!
Dialogue: 0,0:06:27.76,0:06:29.05,Default,,0,0,0,,Эхехе...
Dialogue: 0,0:06:29.72,0:06:31.64,Default,,0,0,0,,Хаха... хахаха...
Dialogue: 0,0:06:31.72,0:06:32.93,Default,,0,0,0,,Na… Nais…
Dialogue: 0,0:06:33.01,0:06:34.85,Default,,0,0,0,,Хаха хахаха...
Dialogue: 0,0:06:35.43,0:06:38.02,Default,,0,0,0,,Не~! Вакия Сәлем!
Dialogue: 0,0:06:38.48,0:06:40.81,Default,,0,0,0,,Осы жерде қоштасыңыз.
Dialogue: 0,0:06:40.90,0:06:41.60,Default,,0,0,0,,Не!
Dialogue: 0,0:06:41.69,0:06:44.32,Default,,0,0,0,,Мен бүгін Bay Club-тан кетемін.
Dialogue: 0,0:06:44.40,0:06:46.90,Default,,0,0,0,,Иә? Мен оны түсінбеймін!
Dialogue: 0,0:06:46.98,0:06:49.11,Default,,0,0,0,,Біз осылай жеңіске жете береміз.
Dialogue: 0,0:06:49.20,0:06:51.57,Default,,0,0,0,,Егер сіз кездейсоқ қалсаңыз...
Dialogue: 0,0:06:51.66,0:06:53.70,Default,,0,0,0,,Ондай жағдайда біз жаумыз.
Dialogue: 0,0:06:53.78,0:06:55.49,Default,,0,0,0,,Жау дегеніміз не?
Dialogue: 0,0:06:55.58,0:06:56.41,Default,,0,0,0,,Осы уақытқа дейін...
Dialogue: 0,0:06:56.49,0:06:59.62,Default,,0,0,0,,Командалық жарыс және жеке жарыс Бірге ойнамаңыз!
Dialogue: 0,0:07:02.50,0:07:04.50,Default,,0,0,0,,Мен шыңды аламын!
Dialogue: 0,0:07:04.59,0:07:06.25,Default,,0,0,0,,Шу Балт
Dialogue: 0,0:07:06.34,0:07:08.30,Default,,0,0,0,,Балалар, сендерді ұрып тастаңдар!
Dialogue: 0,0:07:08.84,0:07:10.43,Default,,0,0,0,,Хона Сайнара
Dialogue: 0,0:07:10.51,0:07:12.47,Default,,0,0,0,,Ең болмағанда жаттығудың уақыты келді.
Dialogue: 0,0:07:12.55,0:07:14.18,Default,,0,0,0,,Сәлем Уакия!
Dialogue: 0,0:07:14.55,0:07:16.18,Default,,0,0,0,,Мына мыңжапырақ!
Dialogue: 0,0:07:16.89,0:07:20.06,Default,,0,0,0,,Қазір арақашықтықты сақтау жаман идея емес.
Dialogue: 0,0:07:20.73,0:07:22.90,Default,,0,0,0,,Жеке бәсекелес ретінде
Dialogue: 0,0:07:22.98,0:07:23.65,Default,,0,0,0,,Не!
Dialogue: 0,0:07:24.11,0:07:27.86,Default,,0,0,0,,Ол сені тастап кететінін айтпайды деп ойлаймын!
Dialogue: 0,0:07:27.94,0:07:28.94,Default,,0,0,0,,Шу…
Dialogue: 0,0:07:29.90,0:07:31.78,Default,,0,0,0,,Бірге жаттығу жасайық...
Dialogue: 0,0:07:32.91,0:07:33.91,Default,,0,0,0,,Барт
Dialogue: 0,0:07:33.99,0:07:35.16,Default,,0,0,0,,Финалда кездескенше
Dialogue: 0,0:07:35.49,0:07:36.58,Default,,0,0,0,,Шу…
Dialogue: 0,0:07:38.20,0:07:41.16,Default,,0,0,0,,Сәлем! Бұл не, екеуің?
Dialogue: 0,0:07:41.25,0:07:42.71,Default,,0,0,0,,Ақымақ болма, күт! Шу
Dialogue: 0,0:07:42.79,0:07:44.13,Default,,0,0,0,,Тоқта, Кумичо.
Dialogue: 0,0:07:44.21,0:07:46.04,Default,,0,0,0,,Олардың да идеялары бар.
Dialogue: 0,0:07:46.13,0:07:47.17,Default,,0,0,0,,Ах, міне олар! Садақ пен жебелер. Олар артқы қабырғаға ілініп тұр.
Dialogue: 0,0:07:47.25,0:07:50.42,Default,,0,0,0,,Командалық шайқас аяқталғаннан кейін біз енді дос емеспіз!
Dialogue: 0,0:07:50.51,0:07:52.18,Default,,0,0,0,,Команда деген осы ма?
Dialogue: 0,0:07:54.76,0:07:56.64,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:08:02.85,0:08:04.35,Default,,0,0,0,,Боқ~
Dialogue: 0,0:08:04.44,0:08:05.27,Default,,0,0,0,,Бұл ол!
Dialogue: 0,0:08:05.35,0:08:06.86,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:08:06.94,0:08:09.07,Default,,0,0,0,,Кумичо! Бере бер!
Dialogue: 0,0:08:09.15,0:08:10.57,Default,,0,0,0,,О, Уарий
Dialogue: 0,0:08:11.94,0:08:14.74,Default,,0,0,0,,Бұл Quetzalcatl туралы соңғы деректер
Dialogue: 0,0:08:15.03,0:08:17.62,Default,,0,0,0,,Менің жылдамдығым мен төзімділігім айтарлықтай артты.
Dialogue: 0,0:08:17.70,0:08:21.04,Default,,0,0,0,,Ол қорғаныс түрі болғандықтан, ол Валькиримен үйлеспейді.
Dialogue: 0,0:08:21.12,0:08:23.08,Default,,0,0,0,,Командалық матчта бір рет жеңілгендіктен...
Dialogue: 0,0:08:23.16,0:08:24.79,Default,,0,0,0,,Менің сырларым да ашылды...
Dialogue: 0,0:08:24.87,0:08:27.08,Default,,0,0,0,,Бұл жеңуге тұрарлық!
Dialogue: 0,0:08:27.17,0:08:29.59,Default,,0,0,0,,Жарайды, арнайы дайындық! Уакия өтінемін!
Dialogue: 0,0:08:29.67,0:08:32.47,Default,,0,0,0,,Дұрыс, эй, Балтоның тәжірибесі...
Dialogue: 0,0:08:34.47,0:08:35.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:35.80,0:08:39.10,Default,,0,0,0,,Сенің маған ең керек кезде жоғалып кеткеніңе сене алмаймын...
Dialogue: 0,0:08:40.60,0:08:42.98,Default,,0,0,0,,Аа~ білмеймін!
Dialogue: 0,0:08:43.06,0:08:45.14,Default,,0,0,0,,Бұл рас! Неге!
Dialogue: 0,0:08:45.23,0:08:47.90,Default,,0,0,0,,Неліктен біз бөлек жаттығу жасаймыз?
Dialogue: 0,0:08:47.98,0:08:50.23,Default,,0,0,0,,Егер мен Уакия немесе Шу болсам...
Dialogue: 0,0:08:50.40,0:08:52.82,Default,,0,0,0,,Мен де солай істеген болармын.
Dialogue: 0,0:08:52.90,0:08:54.07,Default,,0,0,0,,А...
Dialogue: 0,0:08:54.57,0:08:55.95,Default,,0,0,0,,Жеңіске жету
Dialogue: 0,0:09:03.41,0:09:06.96,Default,,0,0,0,,Барт... Қанша өссең де...
Dialogue: 0,0:09:07.04,0:09:09.34,Default,,0,0,0,,Жеңген адам осы!
Dialogue: 0,0:09:09.84,0:09:11.59,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:12.26,0:09:14.84,Default,,0,0,0,,Мен сенімен финалда жұдырықтасқым келеді!
Dialogue: 0,0:09:18.59,0:09:21.31,Default,,0,0,0,,Сіздің жолыңызда тұрған кез келген адамды жеңіңіз!
Dialogue: 0,0:09:21.76,0:09:24.85,Default,,0,0,0,,Кәне, Фредди, әлі біткен жоқ!
Dialogue: 0,0:09:25.27,0:09:26.81,Default,,0,0,0,,Енді тағы бір рет!
Dialogue: 0,0:09:26.89,0:09:27.98,Default,,0,0,0,,Зак мырза...
Dialogue: 0,0:09:28.06,0:09:29.61,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:09:29.69,0:09:30.86,Default,,0,0,0,,Демалу?
Dialogue: 0,0:09:30.94,0:09:32.02,Default,,0,0,0,,1 минут демалсаңыз...
Dialogue: 0,0:09:32.11,0:09:34.90,Default,,0,0,0,,60 секунд Басқа пышақтарға қарағанда әлсіз!
Dialogue: 0,0:09:34.99,0:09:36.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:36.65,0:09:38.32,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:41.87,0:09:44.12,Default,,0,0,0,,Бұл өте дөрекі дыбыс.
Dialogue: 0,0:09:44.20,0:09:45.58,Default,,0,0,0,,Зак сияқты емес
Dialogue: 0,0:09:49.33,0:09:51.21,Default,,0,0,0,,Фреддиді мен қабылдаймын
Dialogue: 0,0:09:52.34,0:09:55.42,Default,,0,0,0,,Зак, мен біраздан бері шу естимін.
Dialogue: 0,0:09:55.51,0:09:57.80,Default,,0,0,0,,Шу? Менің шайқасымнан?
Dialogue: 0,0:09:58.30,0:09:59.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:02.76,0:10:04.31,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:10:04.39,0:10:07.94,Default,,0,0,0,,Мен Зак Күн сәулесімін! Бірінші нөмірлі супер жұлдыз!
Dialogue: 0,0:10:08.39,0:10:10.73,Default,,0,0,0,,Сонымен, осы аптаның хит диаграммасы
Dialogue: 0,0:10:10.81,0:10:12.48,Default,,0,0,0,,Бірінші орын туралы хабарландыру
Dialogue: 0,0:10:12.82,0:10:15.15,Default,,0,0,0,,♪Бұл анық~
Dialogue: 0,0:10:15.23,0:10:17.49,Default,,0,0,0,,♪Мен осы аптада тағы да біріншімін
Dialogue: 0,0:10:17.57,0:10:18.82,Default,,0,0,0,,Ах! Ол кім?
Dialogue: 0,0:10:19.36,0:10:20.53,Default,,0,0,0,,1 орын
Dialogue: 0,0:10:20.62,0:10:22.28,Default,,0,0,0,,Жаңа ғана дебют жасаған жаңа кумир
Dialogue: 0,0:10:22.37,0:10:24.04,Default,,0,0,0,,Акира Ямабуки!
Dialogue: 0,0:10:24.12,0:10:26.70,Default,,0,0,0,,Танысқаныма қуаныштымын! Бұл Аккун!
Dialogue: 0,0:10:26.79,0:10:27.87,Default,,0,0,0,,Шаңқыру!
Dialogue: 0,0:10:27.96,0:10:29.67,Default,,0,0,0,,Куротецу Зенкуро Сенпай
Dialogue: 0,0:10:29.87,0:10:31.63,Default,,0,0,0,,Мені бұл атпен атама!
Dialogue: 0,0:10:31.71,0:10:34.09,Default,,0,0,0,,Ах, Аккунның үлкен сәтсіздігі~
Dialogue: 0,0:10:34.17,0:10:35.17,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:35.25,0:10:37.63,Default,,0,0,0,,Кешіріңіз Зенкуро Сенпай
Dialogue: 0,0:10:37.72,0:10:39.63,Default,,0,0,0,,Сондықтан мен Закпын!
Dialogue: 0,0:10:39.72,0:10:41.43,Default,,0,0,0,,Бұл Зак Күн сәулесі!
Dialogue: 0,0:10:41.51,0:10:44.60,Default,,0,0,0,,Эй, Сенпай, сен Бейблейд ойнайсың, солай ма?
Dialogue: 0,0:10:44.68,0:10:47.60,Default,,0,0,0,,Керемет~ Аккун да жасап көрді~
Dialogue: 0,0:10:47.68,0:10:48.89,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:10:48.98,0:10:49.98,Default,,0,0,0,,Аккунне
Dialogue: 0,0:10:50.06,0:10:52.86,Default,,0,0,0,,Сіз кез келген нәрсені өте тез жасай аласыз.
Dialogue: 0,0:10:53.69,0:10:54.77,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:10:54.86,0:10:58.19,Default,,0,0,0,,Осыншама қысқа мерзімде республикалық байқауға өту...
Dialogue: 0,0:10:59.32,0:11:00.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:04.83,0:11:07.24,Default,,0,0,0,,Маған шоғырлану жетіспеді...
Dialogue: 0,0:11:07.79,0:11:09.21,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:11:09.79,0:11:12.17,Default,,0,0,0,,Бұл, әрине, маған ұқсамайды.
Dialogue: 0,0:11:12.25,0:11:13.63,Default,,0,0,0,,Рахмет Орочи
Dialogue: 0,0:11:13.92,0:11:16.13,Default,,0,0,0,,Енді тағы бір рет!
Dialogue: 0,0:11:19.22,0:11:21.63,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:11:21.93,0:11:23.09,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:11:23.68,0:11:25.22,Default,,0,0,0,,Тағы бір!
Dialogue: 0,0:11:25.30,0:11:26.89,Default,,0,0,0,,Енді тоқтайық
Dialogue: 0,0:11:26.97,0:11:28.60,Default,,0,0,0,,Мен тым көп жаттығатынмын.
Dialogue: 0,0:11:30.18,0:11:31.27,Default,,0,0,0,,Тағы бір!
Dialogue: 0,0:11:32.35,0:11:33.56,Default,,0,0,0,,Жарайды, келіңдер!
Dialogue: 0,0:11:35.98,0:11:37.90,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:11:38.11,0:11:40.61,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:11:40.69,0:11:42.53,Default,,0,0,0,,Ұлттық турнир жекелей жарыс
Dialogue: 0,0:11:42.61,0:11:45.07,Default,,0,0,0,,Таңдалған Блейдерлер арасындағы қызу шайқас...
Dialogue: 0,0:11:45.16,0:11:46.95,Default,,0,0,0,,Екінші турдың уақыты келді!
Dialogue: 0,0:11:47.99,0:11:49.12,Default,,0,0,0,,Куон!
Dialogue: 0,0:11:52.87,0:11:55.58,Default,,0,0,0,,Куон Шаканың дойдосында болды!
Dialogue: 0,0:11:55.67,0:11:57.29,Default,,0,0,0,,Ал, солай ма?
Dialogue: 0,0:11:57.38,0:11:59.34,Default,,0,0,0,,Жекпе-жек жаттығуларына не үшін бардыңыз?
Dialogue: 0,0:11:59.42,0:12:01.22,Default,,0,0,0,,Сіздің шаруаңыз емес
Dialogue: 0,0:12:01.30,0:12:03.22,Default,,0,0,0,,Шақамен күнде күрескен жақсы.
Dialogue: 0,0:12:03.30,0:12:05.05,Default,,0,0,0,,Біз бірге күшті бола аламыз, солай ма?
Dialogue: 0,0:12:05.14,0:12:06.85,Default,,0,0,0,,Неге кеттіңіз?
Dialogue: 0,0:12:06.93,0:12:08.64,Default,,0,0,0,,Біз енді дос емеспіз бе?
Dialogue: 0,0:12:09.89,0:12:13.02,Default,,0,0,0,,Шақа менің досым, ең үлкен қарсыласым.
Dialogue: 0,0:12:14.77,0:12:16.90,Default,,0,0,0,,Мен оны басқалардан артық құптаймын.
Dialogue: 0,0:12:17.52,0:12:19.53,Default,,0,0,0,,Сол себепті мен сапарға шықтым
Dialogue: 0,0:12:20.07,0:12:21.24,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:12:22.99,0:12:25.03,Default,,0,0,0,,Мен мұны басқалардан артық мойындаймын...
Dialogue: 0,0:12:29.03,0:12:31.58,Default,,0,0,0,,Tsk! Бұл не, Вакия?
Dialogue: 0,0:12:31.66,0:12:34.08,Default,,0,0,0,,Орындарыңызды бөлуге жол бермеңіз.
Dialogue: 0,0:12:34.25,0:12:35.37,Default,,0,0,0,,Шу-кун ше?
Dialogue: 0,0:12:35.46,0:12:37.42,Default,,0,0,0,,Бір-бірін қолдаған дұрыс
Dialogue: 0,0:12:37.50,0:12:40.84,Default,,0,0,0,,Келіңіздер! Екінші турдың бірінші ойыны басталғалы жатыр!
Dialogue: 0,0:12:40.92,0:12:42.05,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:12:42.13,0:12:43.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:43.42,0:12:46.26,Default,,0,0,0,,Жарайды! конькиші
Dialogue: 0,0:12:46.34,0:12:47.43,Default,,0,0,0,,Сары-жасыл Квон!
Dialogue: 0,0:12:47.51,0:12:50.06,Default,,0,0,0,,Ыстық қанды, құдіретті балаға қарсы
Dialogue: 0,0:12:50.14,0:12:51.47,Default,,0,0,0,,Барто Аои!
Dialogue: 0,0:12:51.56,0:12:52.89,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:52.98,0:12:54.77,Default,,0,0,0,,Ұлттық турнир жекелей жарыс -
Dialogue: 0,0:12:54.85,0:12:56.73,Default,,0,0,0,,3 ұпайлық алдын ала таңдау жүйесі
Dialogue: 0,0:12:56.81,0:12:59.19,Default,,0,0,0,,Менің ең жақын достарым бір-бірімен соқтығысуда!
Dialogue: 0,0:12:59.27,0:13:00.86,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:13:00.94,0:13:02.40,Default,,0,0,0,,Өртеніп жатыр!
Dialogue: 0,0:13:02.65,0:13:05.40,Default,,0,0,0,,Менімен кім күреседі?
Dialogue: 0,0:13:05.74,0:13:07.28,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:13:11.58,0:13:13.75,Default,,0,0,0,,Өтінемін, досым...
Dialogue: 0,0:13:13.83,0:13:15.58,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:13:15.66,0:13:19.17,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:19.25,0:13:21.55,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:22.55,0:13:23.88,Default,,0,0,0,,Екеуі де атады!
Dialogue: 0,0:13:23.96,0:13:26.26,Default,,0,0,0,,Quad Quetzalcatl диагональ бойынша түсіреді!
Dialogue: 0,0:13:26.34,0:13:28.09,Default,,0,0,0,,Ортаны бірқалыпты айналдыр!
Dialogue: 0,0:13:28.18,0:13:30.93,Default,,0,0,0,,Валькири - бақылаудан тыс асығыс соққы!
Dialogue: 0,0:13:31.01,0:13:33.06,Default,,0,0,0,,О! Сіз өте ояусыз ба?
Dialogue: 0,0:13:33.14,0:13:34.85,Default,,0,0,0,,Жоқ... әлі жоқ.
Dialogue: 0,0:13:34.93,0:13:36.44,Default,,0,0,0,,Жүр, Валькири!
Dialogue: 0,0:13:36.52,0:13:39.10,Default,,0,0,0,,Асыққан асығыс!
Dialogue: 0,0:13:39.19,0:13:40.06,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:13:41.44,0:13:43.44,Default,,0,0,0,,Шабуыл тоқтатылды!
Dialogue: 0,0:13:43.53,0:13:46.24,Default,,0,0,0,,Коньки тебуші бала сияқты!
Dialogue: 0,0:13:46.86,0:13:48.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:51.24,0:13:52.87,Default,,0,0,0,,олжаны ұстаңыз!
Dialogue: 0,0:13:52.95,0:13:54.45,Default,,0,0,0,,Кецалькатл!
Dialogue: 0,0:13:57.54,0:13:59.04,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:13:59.25,0:14:01.34,Default,,0,0,0,,Quetzalcatl есептегіші!
Dialogue: 0,0:14:01.42,0:14:03.25,Default,,0,0,0,,Бар, Балто!
Dialogue: 0,0:14:05.09,0:14:08.38,Default,,0,0,0,,Кецалькатл! Байланысты ату!
Dialogue: 0,0:14:11.43,0:14:12.56,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:14:17.43,0:14:21.40,Default,,0,0,0,,Quad Quetzalcatl айналдыру үшін 1 ұпай!
Dialogue: 0,0:14:21.48,0:14:23.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:23.94,0:14:25.48,Default,,0,0,0,,Кецалькатл...
Dialogue: 0,0:14:25.57,0:14:27.82,Default,,0,0,0,,Валькирияны қатырыңыз
Dialogue: 0,0:14:27.90,0:14:30.20,Default,,0,0,0,,Куон керемет.
Dialogue: 0,0:14:30.28,0:14:32.49,Default,,0,0,0,,ағынды толығымен тартты
Dialogue: 0,0:14:32.58,0:14:34.95,Default,,0,0,0,,Ойын енді ғана басталды!
Dialogue: 0,0:14:35.04,0:14:36.75,Default,,0,0,0,,Қый!
Dialogue: 0,0:14:39.75,0:14:40.83,Default,,0,0,0,,Луис
Dialogue: 0,0:14:40.96,0:14:42.38,Default,,0,0,0,,Сіз ол үшін алаңдайсыз ба?
Dialogue: 0,0:14:44.04,0:14:47.09,Default,,0,0,0,,Барто Аои өзін жақсы сезінбейді!
Dialogue: 0,0:14:47.17,0:14:49.17,Default,,0,0,0,,Соңғы ойын кездейсоқ болды.
Dialogue: 0,0:14:51.89,0:14:52.76,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:54.39,0:14:55.64,Default,,0,0,0,,Валькирия…
Dialogue: 0,0:14:56.02,0:14:58.43,Default,,0,0,0,,Балт, жолға орал!
Dialogue: 0,0:14:58.52,0:15:01.06,Default,,0,0,0,,Кууу! Мен сонда болсам...
Dialogue: 0,0:15:01.15,0:15:04.23,Default,,0,0,0,,Көңіліңді көтеру үшін арқаңнан қағып алсам ғой!
Dialogue: 0,0:15:04.82,0:15:07.65,Default,,0,0,0,,Мен жай ғана тоқтадым да, қарадым...
Dialogue: 0,0:15:07.74,0:15:10.74,Default,,0,0,0,,Не болып жатыр! Бұл ақымақ!
Dialogue: 0,0:15:10.82,0:15:12.87,Default,,0,0,0,,Не? Вакия?
Dialogue: 0,0:15:12.95,0:15:16.16,Default,,0,0,0,,Бос мимен қажетсіз нәрселерді ойлама...
Dialogue: 0,0:15:16.24,0:15:18.50,Default,,0,0,0,,Ұрысты қазір бастайық!
Dialogue: 0,0:15:18.58,0:15:20.29,Default,,0,0,0,,Жеңіске жетсең де, жеңе алмайсың!
Dialogue: 0,0:15:21.71,0:15:24.13,Default,,0,0,0,,Егер бұл сіз жасай алатын жалғыз шайқас болса...
Dialogue: 0,0:15:24.21,0:15:25.92,Default,,0,0,0,,Сіз бұл жерде ұтыласыз!
Dialogue: 0,0:15:26.00,0:15:27.17,Default,,0,0,0,,Вакия…
Dialogue: 0,0:15:27.42,0:15:29.42,Default,,0,0,0,,Шуды жеңе алмайсың!
Dialogue: 0,0:15:29.51,0:15:31.34,Default,,0,0,0,,Мен сені жеңетін адаммын!
Dialogue: 0,0:15:34.22,0:15:35.30,Default,,0,0,0,,Шу…
Dialogue: 0,0:15:36.14,0:15:38.77,Default,,0,0,0,,Мен оны басқалардан артық құптаймын.
Dialogue: 0,0:15:38.85,0:15:40.89,Default,,0,0,0,,Сол себепті мен саяхатқа шықтым
Dialogue: 0,0:15:41.56,0:15:42.94,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:15:43.48,0:15:45.61,Default,,0,0,0,,Вай ұзын!
Dialogue: 0,0:15:45.69,0:15:47.07,Default,,0,0,0,,Шу Барто
Dialogue: 0,0:15:47.15,0:15:48.94,Default,,0,0,0,,Балалар, сендерді ұрып тастаңдар!
Dialogue: 0,0:15:49.74,0:15:52.24,Default,,0,0,0,,Балто Финалда кездескенше
Dialogue: 0,0:15:52.86,0:15:55.78,Default,,0,0,0,,Екеуі де мені таниды...
Dialogue: 0,0:15:56.33,0:15:57.33,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:16:01.41,0:16:03.46,Default,,0,0,0,,Олармен күресу үшін...
Dialogue: 0,0:16:04.00,0:16:06.09,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:16:11.13,0:16:12.68,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:16:14.26,0:16:16.30,Default,,0,0,0,,Мен мұны күттім!
Dialogue: 0,0:16:16.72,0:16:18.47,Default,,0,0,0,,Сізді қазір жеңіңіз
Dialogue: 0,0:16:18.56,0:16:19.68,Default,,0,0,0,,Және…
Dialogue: 0,0:16:20.43,0:16:21.77,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:16:22.18,0:16:23.69,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:16:24.02,0:16:25.27,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:16:27.56,0:16:29.48,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:16:29.57,0:16:33.32,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:34.20,0:16:36.45,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:37.66,0:16:39.58,Default,,0,0,0,,Эй... мынау!
Dialogue: 0,0:16:39.66,0:16:42.08,Default,,0,0,0,,Дәл бұрынғы даму!
Dialogue: 0,0:16:42.16,0:16:43.58,Default,,0,0,0,,Кецалькатл орталыққа!
Dialogue: 0,0:16:43.66,0:16:46.17,Default,,0,0,0,,Валькири қайтадан бақылаудан шықты!
Dialogue: 0,0:16:46.25,0:16:50.00,Default,,0,0,0,,Иә! (Рантаро) Сіз тағы соққы аласыз!
Dialogue: 0,0:16:56.39,0:16:59.14,Default,,0,0,0,,Бұл ойнатуды көргендей!
Dialogue: 0,0:17:01.22,0:17:03.98,Default,,0,0,0,,Мен сені еземін, келесі Шақа!
Dialogue: 0,0:17:04.06,0:17:05.94,Default,,0,0,0,,Ұшсын!
Dialogue: 0,0:17:10.23,0:17:12.36,Default,,0,0,0,,Тағы бір күшті есептегіш!
Dialogue: 0,0:17:12.44,0:17:13.65,Default,,0,0,0,,Балто!
Dialogue: 0,0:17:13.74,0:17:15.99,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:17:22.54,0:17:25.91,Default,,0,0,0,,Не! Бэй кенеттен жылдамдады!
Dialogue: 0,0:17:26.00,0:17:27.04,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:27.12,0:17:28.08,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,0:17:28.29,0:17:31.13,Default,,0,0,0,,Балто Валькиримен біртұтас болды!
Dialogue: 0,0:17:31.34,0:17:34.92,Default,,0,0,0,,Валькирия! Реактивті ату!
Dialogue: 0,0:17:44.14,0:17:45.06,Default,,0,0,0,,Не...
Dialogue: 0,0:17:45.52,0:17:46.56,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:17:47.10,0:17:49.15,Default,,0,0,0,,Артық бітіру үшін 1 ұпай
Dialogue: 0,0:17:49.23,0:17:52.15,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:17:52.23,0:17:54.65,Default,,0,0,0,,Не... енді қандай қозғалыс?
Dialogue: 0,0:17:54.74,0:17:56.24,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:17:56.32,0:17:57.53,Default,,0,0,0,,1-ден 1-ге дейін!
Dialogue: 0,0:17:57.61,0:17:59.91,Default,,0,0,0,,Барто Аои қуып жетті!
Dialogue: 0,0:18:00.03,0:18:01.49,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:01.58,0:18:03.91,Default,,0,0,0,,Аняру, сен асығып тұрсың!
Dialogue: 0,0:18:04.37,0:18:06.41,Default,,0,0,0,,Эй, мен істеймін.
Dialogue: 0,0:18:06.75,0:18:08.79,Default,,0,0,0,,Өте ояту аяқталды!
Dialogue: 0,0:18:08.87,0:18:09.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:10.25,0:18:12.13,Default,,0,0,0,,Сәлем! Ай Балт!
Dialogue: 0,0:18:12.63,0:18:14.88,Default,,0,0,0,,Сол атумен тағы кел!
Dialogue: 0,0:18:15.13,0:18:17.09,Default,,0,0,0,,Кецалькатл кері серпілуде!
Dialogue: 0,0:18:21.51,0:18:22.85,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:18:26.73,0:18:29.56,Default,,0,0,0,,Мен Куонның мұндай түрін бірінші рет көруім.
Dialogue: 0,0:18:29.65,0:18:31.52,Default,,0,0,0,,Әрқашан сабырлы Куон...
Dialogue: 0,0:18:31.61,0:18:33.57,Default,,0,0,0,,Жанып тұр!
Dialogue: 0,0:18:33.94,0:18:35.78,Default,,0,0,0,,Мен мұны көргім келді!
Dialogue: 0,0:18:35.86,0:18:38.15,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:18:38.53,0:18:40.49,Default,,0,0,0,,Ең жақсы соққыммен-
Dialogue: 0,0:18:40.57,0:18:42.16,Default,,0,0,0,,Мұздату!
Dialogue: 0,0:18:44.54,0:18:46.41,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:18:46.50,0:18:49.87,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:49.96,0:18:52.25,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:53.59,0:18:55.71,Default,,0,0,0,,Quetzalcatl Керемет соққы!
Dialogue: 0,0:18:55.80,0:18:57.55,Default,,0,0,0,,Мен орталықты бір жолға түсірдім!
Dialogue: 0,0:18:57.63,0:18:58.84,Default,,0,0,0,,Және Валькири!
Dialogue: 0,0:18:58.92,0:19:01.05,Default,,0,0,0,,Жарылыс импульсі!
Dialogue: 0,0:19:02.22,0:19:03.97,Default,,0,0,0,,Мен қатты ояндым!
Dialogue: 0,0:19:04.05,0:19:05.51,Default,,0,0,0,,Сіз жеңе алмайсыз!
Dialogue: 0,0:19:05.60,0:19:07.68,Default,,0,0,0,,Жоқ, бұл оңай емес.
Dialogue: 0,0:19:09.81,0:19:12.31,Default,,0,0,0,,Сол жылдамдық пен қабырғаға соққан күш...
Dialogue: 0,0:19:12.94,0:19:15.02,Default,,0,0,0,,Төзімділік ұзаққа созылмайды
Dialogue: 0,0:19:19.40,0:19:22.66,Default,,0,0,0,,Кецалькатл ұшып кетті!
Dialogue: 0,0:19:22.74,0:19:24.32,Default,,0,0,0,,Кецалькатл!
Dialogue: 0,0:19:25.62,0:19:26.99,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:19:27.41,0:19:31.71,Default,,0,0,0,,Алға! Валькирия!
Dialogue: 0,0:19:33.33,0:19:35.17,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:41.47,0:19:45.05,Default,,0,0,0,,Оны ұсақтаңыз! Кецалькатл!
Dialogue: 0,0:19:48.77,0:19:50.35,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:51.06,0:19:52.44,Default,,0,0,0,,Кецалькатл!
Dialogue: 0,0:19:52.52,0:19:54.31,Default,,0,0,0,,Барстоу!
Dialogue: 0,0:20:01.61,0:20:05.12,Default,,0,0,0,,Барто Аои 3-1 жеңді!
Dialogue: 0,0:20:05.20,0:20:06.20,Default,,0,0,0,,…га
Dialogue: 0,0:20:06.87,0:20:08.16,Default,,0,0,0,,Біз...
Dialogue: 0,0:20:08.49,0:20:10.16,Default,,0,0,0,,Мен жеңдім...!
Dialogue: 0,0:20:10.50,0:20:11.91,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:20:17.71,0:20:19.80,Default,,0,0,0,,Бүгінгі шайқас менің есімнен кетпейді.
Dialogue: 0,0:20:22.09,0:20:23.97,Default,,0,0,0,,Тағы да шайқасайық!
Dialogue: 0,0:20:25.59,0:20:27.64,Default,,0,0,0,,Бұл шынымен де бұрынғы жігіт пе?
Dialogue: 0,0:20:27.93,0:20:30.77,Default,,0,0,0,,Керемет! Мен осы уақытқа дейін шындап келдім!
Dialogue: 0,0:20:30.85,0:20:32.94,Default,,0,0,0,,А, бұл ең үздік 8!
Dialogue: 0,0:20:33.14,0:20:34.06,Default,,0,0,0,,Бал-нии!
Dialogue: 0,0:20:34.14,0:20:35.44,Default,,0,0,0,,Керемет!
Dialogue: 0,0:20:53.79,0:20:55.92,Default,,0,0,0,,Куон Бұл жақсы шайқас болды.
Dialogue: 0,0:20:56.46,0:20:58.13,Default,,0,0,0,,Мен жеңіліп қалдым.
Dialogue: 0,0:20:58.79,0:21:00.63,Default,,0,0,0,,Шақа айтқандай болды.
Dialogue: 0,0:21:01.51,0:21:03.01,Default,,0,0,0,,Егер сіз онымен соғыссаңыз
Dialogue: 0,0:21:03.51,0:21:06.80,Default,,0,0,0,,Сіздің жолыңыз одан әрі кеңеюі мүмкін.
Dialogue: 0,0:21:09.01,0:21:11.64,Default,,0,0,0,,Енді дохжоға оралыңыз және жаттығу жасаңыз.
Dialogue: 0,0:21:11.85,0:21:13.85,Default,,0,0,0,,Е... иә~!
Dialogue: 0,0:21:14.14,0:21:16.94,Default,,0,0,0,,Сіз жауынгерлік дайындықты аяқтадыңыз ба?
Dialogue: 0,0:21:17.02,0:21:18.65,Default,,0,0,0,,Гахахаха!
Dialogue: 0,0:21:18.73,0:21:19.90,Default,,0,0,0,,Жақсы, жақсы!
Dialogue: 0,0:21:19.98,0:21:22.61,Default,,0,0,0,,Мен де сенімен төбелескім келді!
Dialogue: 0,0:21:27.61,0:21:28.78,Default,,0,0,0,,Барт
Dialogue: 0,0:21:28.87,0:21:31.16,Default,,0,0,0,,Джет Shoot Бұл тамаша болды!
Dialogue: 0,0:21:31.24,0:21:33.87,Default,,0,0,0,,Реактивті түсірілім? Бұл не?
Dialogue: 0,0:21:33.95,0:21:34.91,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:21:35.00,0:21:37.17,Default,,0,0,0,,Әй, сен матч кезінде айқайлап тұрған шығарсың.
Dialogue: 0,0:21:37.25,0:21:39.17,Default,,0,0,0,,Бұл таңғажайып кадр!
Dialogue: 0,0:21:39.25,0:21:40.79,Default,,0,0,0,,Мен мұны айттым ба?
Dialogue: 0,0:21:40.88,0:21:42.21,Default,,0,0,0,,Сіз байқамадыңыз ба?
Dialogue: 0,0:21:42.30,0:21:43.67,Default,,0,0,0,,Бартқа ұқсайды.
Dialogue: 0,0:21:44.21,0:21:45.88,Default,,0,0,0,,Реактивті түсірілім...
Dialogue: 0,0:21:46.76,0:21:48.05,Default,,0,0,0,,Керемет есім!
Dialogue: 0,0:21:48.80,0:21:50.43,Default,,0,0,0,,Жарайды, шешті!
Dialogue: 0,0:21:50.60,0:21:53.22,Default,,0,0,0,,Арнайы дайындық үшін мектепке оралу!
Dialogue: 0,0:21:53.31,0:21:54.68,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.19,0:23:28.53,Default,,0,0,0,,Инсуке мен Азуки Бен ақыры төбелеседі
Dialogue: 0,0:23:28.61,0:23:30.74,Default,,0,0,0,,Тек біреуі ғана аман қалады
Dialogue: 0,0:23:30.82,0:23:33.70,Default,,0,0,0,,Иә? Бен жаңа ерекше қадамы?
Dialogue: 0,0:23:33.78,0:23:36.45,Default,,0,0,0,,Жоғалтпа, Инуске! Мен сенемін!
Dialogue: 0,0:23:36.54,0:23:39.16,Default,,0,0,0,,Содан кейін Зак пен Го соқтығысады.
Dialogue: 0,0:23:39.25,0:23:41.58,Default,,0,0,0,,Бұл да тамаша шайқас болады!
Dialogue: 0,0:23:41.67,0:23:43.88,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.96,0:23:46.09,Default,,0,0,0,,Барк! Жануарлар шайқасы!
Dialogue: 0,0:23:46.17,0:23:47.88,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.96,0:23:49.59,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.09,0:23:57.09,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
