Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.63,0:00:14.72,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.80,0:00:16.93,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.01,0:00:19.10,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.27,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.35,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.65,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:30.94,0:00:33.45,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:00:33.53,0:00:35.78,Default,,0,0,0,,2-ші раунд 2-ші күн шайқасы
Dialogue: 0,0:00:35.86,0:00:37.45,Default,,0,0,0,,Әрі қарай не болады?
Dialogue: 0,0:00:37.53,0:00:39.45,Default,,0,0,0,,Wild Wyvern пайдаланушысы
Dialogue: 0,0:00:39.74,0:00:41.49,Default,,0,0,0,,Комурасаки Вакия
Dialogue: 0,0:00:41.58,0:00:43.37,Default,,0,0,0,,Күтілгендей, жеңімпаз үміткерлердің бірі
Dialogue: 0,0:00:43.46,0:00:44.79,Default,,0,0,0,,Босаңсыған өрнек
Dialogue: 0,0:00:44.87,0:00:46.67,Default,,0,0,0,,Ммм, тамаша!
Dialogue: 0,0:00:46.75,0:00:48.00,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:00:48.08,0:00:51.50,Default,,0,0,0,,Біз қандай шайқас көреміз?
Dialogue: 0,0:00:51.63,0:00:53.42,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:00:53.97,0:00:56.76,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:56.89,0:00:58.97,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:01:03.39,0:01:04.81,Default,,0,0,0,,Фуфууу!
Dialogue: 0,0:01:04.93,0:01:07.40,Default,,0,0,0,,Бірдей қорғаныс түрі
Dialogue: 0,0:01:07.48,0:01:10.02,Default,,0,0,0,,Виверннің айналу күші басым
Dialogue: 0,0:01:10.11,0:01:13.65,Default,,0,0,0,,Менің ойымша, бұл үлкен мәселе емес.
Dialogue: 0,0:01:14.49,0:01:16.78,Default,,0,0,0,,3 секундтан астам уақыт қалды.
Dialogue: 0,0:01:17.32,0:01:19.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:19.45,0:01:22.04,Default,,0,0,0,,3 2 1
Dialogue: 0,0:01:22.79,0:01:25.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:26.04,0:01:27.67,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:01:27.75,0:01:31.34,Default,,0,0,0,,Вакия Кожима 2-0 есебімен жеңіске жетті.
Dialogue: 0,0:01:32.17,0:01:34.92,Default,,0,0,0,,Біз әлі де жеңдік пе?
Dialogue: 0,0:01:42.76,0:01:45.14,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:45.48,0:01:50.65,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:01.95,0:02:05.33,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:05.83,0:02:07.96,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:08.37,0:02:12.50,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:12.63,0:02:15.84,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:15.96,0:02:22.39,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:22.68,0:02:27.10,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:27.60,0:02:33.02,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:33.15,0:02:35.40,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:35.48,0:02:40.20,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:40.36,0:02:45.45,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:45.74,0:02:48.00,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:48.20,0:02:50.54,Default,,0,0,0,,Бірге қуайық!
Dialogue: 0,0:02:50.83,0:02:54.75,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:54.92,0:02:59.92,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:00.13,0:03:02.30,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:05.85,0:03:09.23,Default,,0,0,0,,Қасқыр Корин! Қара өлім өлшемі!
Dialogue: 0,0:03:10.39,0:03:11.48,Default,,0,0,0,,Бәріңе
Dialogue: 0,0:03:11.56,0:03:14.77,Default,,0,0,0,,Облыстық турнирдің екінші турында да жеңімпаз атандым.
Dialogue: 0,0:03:15.44,0:03:18.86,Default,,0,0,0,,Қазіргі уақытта келесі шайқас үшін қуат зарядталуда
Dialogue: 0,0:03:19.28,0:03:22.49,Default,,0,0,0,,Балто! Жүр, оян!
Dialogue: 0,0:03:22.61,0:03:25.83,Default,,0,0,0,,Олай болса, кеттік Ника (Аои Хинацу) Иә.
Dialogue: 0,0:03:25.99,0:03:28.04,Default,,0,0,0,,Иссеиноза
Dialogue: 0,0:03:29.16,0:03:30.20,Default,,0,0,0,,Бар-нии-чан
Dialogue: 0,0:03:30.29,0:03:31.92,Default,,0,0,0,,Ояныңыз~
Dialogue: 0,0:03:32.00,0:03:33.25,Default,,0,0,0,,Аһ!
Dialogue: 0,0:03:33.33,0:03:35.63,Default,,0,0,0,,Чикоку, чикоку, чикоку!
Dialogue: 0,0:03:35.88,0:03:38.13,Default,,0,0,0,,Балто Күтіңіз, қараңыз!
Dialogue: 0,0:03:39.05,0:03:41.38,Default,,0,0,0,,Жаңа піскен, барғанша тамақтаныңыз.
Dialogue: 0,0:03:41.51,0:03:43.13,Default,,0,0,0,,Рахмет, анашым
Dialogue: 0,0:03:43.22,0:03:44.47,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:48.64,0:03:51.85,Default,,0,0,0,,Тағы екі мүше болса, бізде бәйге клубы бола ма?
Dialogue: 0,0:03:52.77,0:03:54.19,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:03:54.27,0:03:56.48,Default,,0,0,0,,Бүгін тағы бір жекпе-жек!
Dialogue: 0,0:03:57.11,0:03:59.48,Default,,0,0,0,,Бұл Чикоку ғой?
Dialogue: 0,0:03:59.61,0:04:02.61,Default,,0,0,0,,Уау... ха...
Dialogue: 0,0:04:03.11,0:04:05.41,Default,,0,0,0,,Қарғыс атсын, мектепке баратын уақыт болды.
Dialogue: 0,0:04:05.49,0:04:07.03,Default,,0,0,0,,Мен келесі шайқаста міндетті түрде жеңіске жетемін
Dialogue: 0,0:04:07.12,0:04:08.49,Default,,0,0,0,,Бейнен басқа өс.
Dialogue: 0,0:04:08.58,0:04:09.33,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:04:09.41,0:04:11.00,Default,,0,0,0,,Умм
Dialogue: 0,0:04:11.62,0:04:14.33,Default,,0,0,0,,Сіз Балто Аоисыз, солай ма?
Dialogue: 0,0:04:14.42,0:04:16.00,Default,,0,0,0,,О сен
Dialogue: 0,0:04:16.25,0:04:17.04,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:04:17.13,0:04:21.51,Default,,0,0,0,,Идиот, сенің келесі қарсыласың Дина Куроками болады.
Dialogue: 0,0:04:21.59,0:04:23.26,Default,,0,0,0,,Ах! Оқиға орнында көрдім
Dialogue: 0,0:04:25.18,0:04:27.22,Default,,0,0,0,,Бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:04:27.30,0:04:28.81,Default,,0,0,0,,Сіздің жүзіңіз басқаша.
Dialogue: 0,0:04:29.06,0:04:33.10,Default,,0,0,0,,Матчтарыңызды көріп отырып, жанкүйер болдым.
Dialogue: 0,0:04:33.18,0:04:35.23,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:04:35.31,0:04:37.19,Default,,0,0,0,,Әсіресе сол шапшаң соққы.
Dialogue: 0,0:04:37.27,0:04:39.32,Default,,0,0,0,,Сіз шынымен кереметсіз, солай емес пе?
Dialogue: 0,0:04:39.40,0:04:41.19,Default,,0,0,0,,Мақсатты тұлғаның қатысуы тиіс қоғамдық жиынға бару үшін
Dialogue: 0,0:04:41.28,0:04:42.99,Default,,0,0,0,,Эй, сен мұны естідің бе? Кумичо
Dialogue: 0,0:04:43.07,0:04:46.28,Default,,0,0,0,,Менің жанкүйерлерім де менікі.
Dialogue: 0,0:04:46.49,0:04:48.49,Default,,0,0,0,,Қателік бар емес пе?
Dialogue: 0,0:04:48.57,0:04:49.16,Default,,0,0,0,,Хехе...
Dialogue: 0,0:04:49.24,0:04:51.79,Default,,0,0,0,,Қарсы болмасаңыз.
Dialogue: 0,0:04:51.87,0:04:54.33,Default,,0,0,0,,Сабақтан кейін менімен шайқасасың ба?
Dialogue: 0,0:04:54.41,0:04:55.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:55.33,0:05:00.00,Default,,0,0,0,,Мен сенімен шайқасқа өте қуаныштымын, ертеңге дейін шыдамаймын.
Dialogue: 0,0:05:00.09,0:05:02.63,Default,,0,0,0,,Әрине жақсы, солай ма?
Dialogue: 0,0:05:02.71,0:05:03.72,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:03.80,0:05:06.26,Default,,0,0,0,,О! Мен оны қанша қажет болса, сонша аламын
Dialogue: 0,0:05:06.38,0:05:07.22,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:05:07.30,0:05:08.51,Default,,0,0,0,,Егер сіз шешсеңіз
Dialogue: 0,0:05:08.59,0:05:11.68,Default,,0,0,0,,Гимназияда шығанақ стадионын дайындап, күтемін.
Dialogue: 0,0:05:11.81,0:05:14.60,Default,,0,0,0,,Аа~ Мектеп бітті деп ойлаймын.
Dialogue: 0,0:05:16.14,0:05:18.15,Default,,0,0,0,,Бұл шайқас! Бұл шайқас!
Dialogue: 0,0:05:18.23,0:05:19.81,Default,,0,0,0,,На Дина!
Dialogue: 0,0:05:19.90,0:05:21.73,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:05:21.90,0:05:24.61,Default,,0,0,0,,Я, мен өте құрметтімін.
Dialogue: 0,0:05:25.19,0:05:27.49,Default,,0,0,0,,Динаның бейі - қараңғы өлімші
Dialogue: 0,0:05:27.86,0:05:30.20,Default,,0,0,0,,Ол Бару-нии сияқты шабуыл түрі.
Dialogue: 0,0:05:30.28,0:05:33.45,Default,,0,0,0,,Өткен күні шынымен де күшті болды. Мен оны асыға күтемін!
Dialogue: 0,0:05:33.54,0:05:36.50,Default,,0,0,0,,Олай болса, бірінші шайқасқа барайық.
Dialogue: 0,0:05:37.75,0:05:39.13,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:05:39.25,0:05:41.63,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:41.71,0:05:44.05,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:51.76,0:05:52.51,Default,,0,0,0,,Не!
Dialogue: 0,0:05:55.35,0:05:56.56,Default,,0,0,0,,Не?!
Dialogue: 0,0:05:56.77,0:05:58.90,Default,,0,0,0,,Ми... Сәтсіздік!
Dialogue: 0,0:05:59.52,0:06:05.32,Default,,0,0,0,,Валькири бірінші болып 1 ұпай алады ма?
Dialogue: 0,0:06:05.40,0:06:06.86,Default,,0,0,0,,Не?
Dialogue: 0,0:06:07.03,0:06:09.20,Default,,0,0,0,,Өткен жолғыдан мүлде басқаша.
Dialogue: 0,0:06:09.32,0:06:10.87,Default,,0,0,0,,Бұл жай ғана кездейсоқтық емес пе?
Dialogue: 0,0:06:10.95,0:06:12.53,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:12.62,0:06:14.83,Default,,0,0,0,,Сіз кездейсоқ қобалжусыз ба?
Dialogue: 0,0:06:14.91,0:06:16.33,Default,,0,0,0,,Хуббарка
Dialogue: 0,0:06:16.50,0:06:17.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:17.91,0:06:20.04,Default,,0,0,0,,Әдейі шешілген болуы керек.
Dialogue: 0,0:06:20.42,0:06:21.54,Default,,0,0,0,,Мақсат бойынша?
Dialogue: 0,0:06:21.71,0:06:24.42,Default,,0,0,0,,Әй, Дина, әдейі дегенді қалай түсінесің?
Dialogue: 0,0:06:24.59,0:06:27.72,Default,,0,0,0,,Маған асық атуды көрсетті.
Dialogue: 0,0:06:29.84,0:06:30.89,Default,,0,0,0,,Сондай-ақ-
Dialogue: 0,0:06:32.43,0:06:34.22,Default,,0,0,0,,Сіздің әлсіз жақтарыңыз да
Dialogue: 0,0:06:35.97,0:06:36.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:36.85,0:06:37.93,Default,,0,0,0,,Эх!
Dialogue: 0,0:06:38.10,0:06:39.64,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:39.77,0:06:41.65,Default,,0,0,0,,Неге сонша ашуланасың?
Dialogue: 0,0:06:41.77,0:06:42.52,Default,,0,0,0,,Не!
Dialogue: 0,0:06:42.61,0:06:45.15,Default,,0,0,0,,Ертең бәрібір солай болады
Dialogue: 0,0:06:45.23,0:06:46.53,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:06:47.57,0:06:49.36,Default,,0,0,0,,Валькирия
Dialogue: 0,0:06:52.20,0:06:54.53,Default,,0,0,0,,Бір минут күте тұрыңыз, Дина.
Dialogue: 0,0:06:57.54,0:06:58.33,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:06:59.08,0:07:00.16,Default,,0,0,0,,Оның шабуылдары ерекше төмен!
Dialogue: 0,0:07:00.62,0:07:02.13,Default,,0,0,0,,Валькириден кешірім сұрау
Dialogue: 0,0:07:02.50,0:07:03.21,Default,,0,0,0,,Барт
Dialogue: 0,0:07:03.92,0:07:05.38,Default,,0,0,0,,Сіз тітіркендіргішсіз.
Dialogue: 0,0:07:10.01,0:07:12.39,Default,,0,0,0,,Дина мен сені кешірмеймін.
Dialogue: 0,0:07:14.85,0:07:16.06,Default,,0,0,0,,Бал аға
Dialogue: 0,0:07:16.22,0:07:19.77,Default,,0,0,0,,Уау! Бұл өте жиіркенішті
Dialogue: 0,0:07:19.85,0:07:20.98,Default,,0,0,0,,Эх!
Dialogue: 0,0:07:21.06,0:07:22.10,Default,,0,0,0,,Сәлем Балто
Dialogue: 0,0:07:22.40,0:07:23.69,Default,,0,0,0,,Уау! (Рантаро) Күте тұрыңыз!
Dialogue: 0,0:07:23.81,0:07:25.65,Default,,0,0,0,,Күтіңіз.
Dialogue: 0,0:07:25.73,0:07:27.90,Default,,0,0,0,,Бауырым, қайда барасың?
Dialogue: 0,0:07:28.23,0:07:29.94,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:07:30.53,0:07:34.74,Default,,0,0,0,,Енді оның шапшаң соққысы пайдалы емес.
Dialogue: 0,0:07:34.87,0:07:37.08,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:07:38.54,0:07:40.04,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:07:41.66,0:07:43.12,Default,,0,0,0,,Аняро!
Dialogue: 0,0:07:45.25,0:07:47.04,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:07:49.51,0:07:55.30,Default,,0,0,0,,О! Ха ха ха
Dialogue: 0,0:07:56.01,0:07:57.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:58.72,0:08:02.52,Default,,0,0,0,,Bar-nii Rush Shoot Мен бір рет те үлгермедім.
Dialogue: 0,0:08:02.81,0:08:05.10,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:08:05.35,0:08:07.82,Default,,0,0,0,,Дина саған бірдеңе істеген жоқ па?
Dialogue: 0,0:08:07.94,0:08:09.44,Default,,0,0,0,,Шығанақта біраз жұмыс атқарылды.
Dialogue: 0,0:08:09.69,0:08:11.53,Default,,0,0,0,,Бэй мүлде проблема емес.
Dialogue: 0,0:08:12.45,0:08:15.28,Default,,0,0,0,,А, жаттығудың уақыты келді. Тәжірибеден басқа ештеңе қалмады.
Dialogue: 0,0:08:15.36,0:08:18.24,Default,,0,0,0,,Жарайды, қазір сенбон түсіруді бастайық.
Dialogue: 0,0:08:18.37,0:08:19.20,Default,,0,0,0,,Бір рет
Dialogue: 0,0:08:22.33,0:08:23.37,Default,,0,0,0,,Екі рет
Dialogue: 0,0:08:24.33,0:08:25.12,Default,,0,0,0,,3 рет
Dialogue: 0,0:08:26.67,0:08:27.63,Default,,0,0,0,,4 рет
Dialogue: 0,0:08:29.84,0:08:30.34,Default,,0,0,0,,5 рет
Dialogue: 0,0:08:31.76,0:08:33.55,Default,,0,0,0,,256
Dialogue: 0,0:08:35.22,0:08:36.93,Default,,0,0,0,,257
Dialogue: 0,0:08:38.35,0:08:40.18,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:08:40.26,0:08:42.02,Default,,0,0,0,,Сәлем
Dialogue: 0,0:08:42.81,0:08:44.48,Default,,0,0,0,,Мен сені мінгіземін, жүре бер.
Dialogue: 0,0:08:44.56,0:08:46.06,Default,,0,0,0,,Жарай, мен барып әкелейін.
Dialogue: 0,0:08:46.35,0:08:47.86,Default,,0,0,0,,Ақымақтарды жайына қалдыр
Dialogue: 0,0:08:51.44,0:08:53.44,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:08:53.53,0:08:55.91,Default,,0,0,0,,Алдымен үйге барамыз.
Dialogue: 0,0:08:56.24,0:08:57.20,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:08:57.28,0:08:58.12,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:08:59.70,0:09:01.04,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:09:02.62,0:09:03.79,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:05.33,0:09:07.08,Default,,0,0,0,,Неліктен мен мұны істей алмаймын?
Dialogue: 0,0:09:08.17,0:09:10.67,Default,,0,0,0,,Ертең бәрібір солай болады
Dialogue: 0,0:09:11.34,0:09:12.80,Default,,0,0,0,,Чикшо!
Dialogue: 0,0:09:13.13,0:09:14.47,Default,,0,0,0,,Уайымдама, жолдасым.
Dialogue: 0,0:09:14.55,0:09:17.18,Default,,0,0,0,,Мен саған енді ешқашан мұндай сезімге жол бермеймін.
Dialogue: 0,0:09:17.39,0:09:18.43,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:09:18.51,0:09:19.89,Default,,0,0,0,,Тез түсіру
Dialogue: 0,0:09:25.89,0:09:27.44,Default,,0,0,0,,Сәлем Балто
Dialogue: 0,0:09:28.10,0:09:29.98,Default,,0,0,0,,Сәлем Балто Сәлем
Dialogue: 0,0:09:30.06,0:09:32.44,Default,,0,0,0,,Мықты болыңыз. Не болды?
Dialogue: 0,0:09:33.15,0:09:34.36,Default,,0,0,0,,Хара
Dialogue: 0,0:09:34.44,0:09:36.07,Default,,0,0,0,,Хара? Хараға не болды?
Dialogue: 0,0:09:36.15,0:09:37.24,Default,,0,0,0,,(асқазанның айқайлауы)
Dialogue: 0,0:09:37.32,0:09:39.07,Default,,0,0,0,,Мен аштан өліп бара жатырмын…
Dialogue: 0,0:09:40.62,0:09:42.33,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:47.08,0:09:47.92,Default,,0,0,0,,Қайта толтырыңыз
Dialogue: 0,0:09:48.00,0:09:50.29,Default,,0,0,0,,Қанша стақан?
Dialogue: 0,0:09:50.84,0:09:51.63,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:09:51.84,0:09:53.09,Default,,0,0,0,,Yahoo
Dialogue: 0,0:09:53.67,0:09:55.84,Default,,0,0,0,,Шу қолдарыңды қайтадан көтердіңдер, солай емес пе?
Dialogue: 0,0:09:57.22,0:09:58.51,Default,,0,0,0,,Бұл қандай тағам?
Dialogue: 0,0:09:58.93,0:10:00.64,Default,,0,0,0,,Спагетти карбонарасы
Dialogue: 0,0:10:01.60,0:10:03.31,Default,,0,0,0,,Аузыңызда ештеңемен сөйлеспеңіз
Dialogue: 0,0:10:03.72,0:10:05.06,Default,,0,0,0,,Уме Уме
Dialogue: 0,0:10:05.89,0:10:09.69,Default,,0,0,0,,Шудың әкесі мен шешесі бұрынғыдай бос емес пе?
Dialogue: 0,0:10:10.02,0:10:11.90,Default,,0,0,0,,Менің әкем – академик.
Dialogue: 0,0:10:12.02,0:10:14.32,Default,,0,0,0,,Анам бүгін түнде зертханада қала ма деп ойлаймын.
Dialogue: 0,0:10:14.82,0:10:16.74,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:10:16.94,0:10:21.32,Default,,0,0,0,,Маған неаполитан бұл Кальбоға немесе басқаларға қарағанда көбірек ұнайды.
Dialogue: 0,0:10:23.41,0:10:25.24,Default,,0,0,0,,Барлығымыз рахмет айтайық
Dialogue: 0,0:10:25.33,0:10:27.58,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:10:27.66,0:10:28.87,Default,,0,0,0,,Қош бол
Dialogue: 0,0:10:29.46,0:10:30.58,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:30.71,0:10:33.79,Default,,0,0,0,,Сау болыңыз, жақында кездескенше
Dialogue: 0,0:10:35.92,0:10:39.51,Default,,0,0,0,,Ендеше, неге маған мұндай абайсыз тәрбие бердіңіз?
Dialogue: 0,0:10:39.59,0:10:42.85,Default,,0,0,0,,Rash Shoot Мен кенеттен мұны қайталай алмадым.
Dialogue: 0,0:10:43.22,0:10:43.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:44.26,0:10:47.85,Default,,0,0,0,,Бүгін мектепте Дина Куроками деген жігітпен төбелесіп қалдым.
Dialogue: 0,0:10:47.93,0:10:49.06,Default,,0,0,0,,Куроками Дина?
Dialogue: 0,0:10:49.35,0:10:50.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:50.56,0:10:53.06,Default,,0,0,0,,Есіме түскенде тағы да ашуландым.
Dialogue: 0,0:10:53.19,0:10:55.19,Default,,0,0,0,,Аняру, мен сені кешіре алмаймын.
Dialogue: 0,0:10:55.27,0:10:57.36,Default,,0,0,0,,Мен Валькирияның жауларына қамқор боламын.
Dialogue: 0,0:10:58.78,0:10:59.82,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:11:01.24,0:11:02.70,Default,,0,0,0,,Сонымен, ағайын.
Dialogue: 0,0:11:02.78,0:11:05.91,Default,,0,0,0,,Бүгін бізге қонаққа қуыршақ театрының адамдары келді.
Dialogue: 0,0:11:06.24,0:11:08.00,Default,,0,0,0,,Бұл өте қызық болды
Dialogue: 0,0:11:08.16,0:11:10.25,Default,,0,0,0,,Біз дос болдық.
Dialogue: 0,0:11:10.41,0:11:11.33,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:11.42,0:11:12.71,Default,,0,0,0,,Мен көп ойнадым.
Dialogue: 0,0:11:12.79,0:11:13.88,Default,,0,0,0,,Міне, болды, болды
Dialogue: 0,0:11:13.96,0:11:15.34,Default,,0,0,0,,Дина-кун
Dialogue: 0,0:11:15.42,0:11:17.09,Default,,0,0,0,,Кездесу аяқталуға жақын.
Dialogue: 0,0:11:17.59,0:11:18.21,Default,,0,0,0,,Иә
Dialogue: 0,0:11:18.38,0:11:19.17,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:19.67,0:11:20.76,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:11:20.84,0:11:22.72,Default,,0,0,0,,Үлкен аға, ертең ұрыс бар, солай ма?
Dialogue: 0,0:11:22.80,0:11:24.30,Default,,0,0,0,,Жеңіс пе? Сіз жеңесіз, солай ма?
Dialogue: 0,0:11:24.39,0:11:26.01,Default,,0,0,0,,Енді Соута-кунтара
Dialogue: 0,0:11:26.10,0:11:28.77,Default,,0,0,0,,Турнир болған сайын мен қатты толқыймын.
Dialogue: 0,0:11:28.93,0:11:30.27,Default,,0,0,0,,Ерте ұйықтаңыз
Dialogue: 0,0:11:30.60,0:11:32.31,Default,,0,0,0,,Мен температураңызды өлшеймін.
Dialogue: 0,0:11:32.73,0:11:33.98,Default,,0,0,0,,Yes
Dialogue: 0,0:11:35.40,0:11:37.15,Default,,0,0,0,,Жарайды, Сута.
Dialogue: 0,0:11:37.23,0:11:38.86,Default,,0,0,0,,Мен жеңемін
Dialogue: 0,0:11:41.15,0:11:43.16,Default,,0,0,0,,Ұлдар мен қыздар
Dialogue: 0,0:11:43.41,0:11:47.62,Default,,0,0,0,,Бейблейд Йонекома аудандық турнирі өзінің үшінші кезеңіне кірді.
Dialogue: 0,0:11:47.79,0:11:51.37,Default,,0,0,0,,Енді бірінші ойындағы пышақпен таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:11:51.46,0:11:55.08,Default,,0,0,0,,Белгісізден осы уақытқа дейін бірден өттім.
Dialogue: 0,0:11:55.17,0:11:57.88,Default,,0,0,0,,Золушка бала Барто Аои
Dialogue: 0,0:11:58.55,0:12:01.01,Default,,0,0,0,,Ал қарсылас фавориттердің бірі
Dialogue: 0,0:12:01.13,0:12:04.43,Default,,0,0,0,,Жұмбақ бала Куроками Дина
Dialogue: 0,0:12:04.51,0:12:06.43,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:06.51,0:12:07.64,Default,,0,0,0,,Гуш…
Dialogue: 0,0:12:09.35,0:12:10.02,Default,,0,0,0,,Пои!
Dialogue: 0,0:12:10.31,0:12:11.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:14.40,0:12:16.31,Default,,0,0,0,,Балто жігіт, не болды?
Dialogue: 0,0:12:16.40,0:12:19.69,Default,,0,0,0,,Ашуланғанда миың тегістеледі деген.
Dialogue: 0,0:12:20.15,0:12:21.94,Default,,0,0,0,,Сабыр ет, мен.
Dialogue: 0,0:12:22.03,0:12:24.45,Default,,0,0,0,,Мен жаттықтым. Жарайды.
Dialogue: 0,0:12:24.53,0:12:26.70,Default,,0,0,0,,Тыныштан, тыныштан.
Dialogue: 0,0:12:26.82,0:12:29.20,Default,,0,0,0,,Чикшо Анярио
Dialogue: 0,0:12:29.66,0:12:31.00,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:12:31.95,0:12:33.71,Default,,0,0,0,,Қарашы, Конняро.
Dialogue: 0,0:12:33.79,0:12:36.00,Default,,0,0,0,,Бұл мен күткеннен де тиімді болды.
Dialogue: 0,0:12:36.63,0:12:38.21,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:12:38.54,0:12:41.30,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:41.42,0:12:43.80,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:47.26,0:12:48.26,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:12:48.35,0:12:52.93,Default,,0,0,0,,Орындалды! Аои Барто күтпеген жерден соққы жіберіп алды
Dialogue: 0,0:12:53.06,0:12:54.27,Default,,0,0,0,,Валькирия
Dialogue: 0,0:12:54.39,0:12:56.85,Default,,0,0,0,,Дина Куроками жақсы кадр
Dialogue: 0,0:12:56.94,0:12:58.81,Default,,0,0,0,,Шайқас аяқталды ма?
Dialogue: 0,0:12:58.90,0:13:00.77,Default,,0,0,0,,Өлім Сізерді өлтіріңіз
Dialogue: 0,0:13:01.57,0:13:03.11,Default,,0,0,0,,（）
Dialogue: 0,0:13:06.24,0:13:08.07,Default,,0,0,0,,(Орағын сермеп жатқан Орақшының дыбысы)
Dialogue: 0,0:13:13.62,0:13:14.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:14.25,0:13:15.25,Default,,0,0,0,,Бар-нии
Dialogue: 0,0:13:15.37,0:13:18.17,Default,,0,0,0,,Валькири қуып шықты
Dialogue: 0,0:13:18.25,0:13:21.13,Default,,0,0,0,,Өлім мөлшерлемешісі 1 ұпай
Dialogue: 0,0:13:21.21,0:13:22.96,Default,,0,0,0,,Сабыр ет, Балто.
Dialogue: 0,0:13:23.05,0:13:23.84,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:24.01,0:13:25.67,Default,,0,0,0,,Тағы бір нүкте.
Dialogue: 0,0:13:25.88,0:13:26.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:26.51,0:13:29.39,Default,,0,0,0,,Ғажайыптар тудыратын керемет бала
Dialogue: 0,0:13:29.55,0:13:32.68,Default,,0,0,0,,Сіздің сәттіліктеріңіз таусылды ма?
Dialogue: 0,0:13:32.89,0:13:34.60,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:13:34.68,0:13:36.35,Default,,0,0,0,,Мен оның мақсаттарына құмармын.
Dialogue: 0,0:13:36.98,0:13:38.77,Default,,0,0,0,,Балто ойыншысы, жарай ма?
Dialogue: 0,0:13:38.94,0:13:40.86,Default,,0,0,0,,Екінші шайқас басталады.
Dialogue: 0,0:13:41.73,0:13:42.53,Default,,0,0,0,,Иә
Dialogue: 0,0:13:43.03,0:13:46.45,Default,,0,0,0,,Мен бұлай жалғастыра алмаймын, бірақ не істеуім керек?
Dialogue: 0,0:13:46.78,0:13:48.86,Default,,0,0,0,,Мен оны қалай жеңемін?
Dialogue: 0,0:13:49.53,0:13:51.20,Default,,0,0,0,,Барт хабарламасы
Dialogue: 0,0:13:51.62,0:13:54.41,Default,,0,0,0,,Енді күресу керек Дина емес.
Dialogue: 0,0:13:54.54,0:13:55.75,Default,,0,0,0,,Сіз өзіңіз.
Dialogue: 0,0:13:55.83,0:13:57.46,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:13:58.92,0:14:02.46,Default,,0,0,0,,Негізгі тапсырмаларды орындағандықтан жеңіске жетті.
Dialogue: 0,0:14:03.00,0:14:04.30,Default,,0,0,0,,Негізгі?
Dialogue: 0,0:14:05.05,0:14:05.80,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:07.42,0:14:08.63,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:14:11.35,0:14:13.06,Default,,0,0,0,,Эй, оның қолында.
Dialogue: 0,0:14:13.14,0:14:15.56,Default,,0,0,0,,Іске қосу бұрышы көлденең
Dialogue: 0,0:14:15.64,0:14:18.10,Default,,0,0,0,,Бұл асығыс ату формасы емес.
Dialogue: 0,0:14:18.31,0:14:21.48,Default,,0,0,0,,Тағы бір нүкте және The End фильмінен Балт Аои
Dialogue: 0,0:14:21.56,0:14:23.48,Default,,0,0,0,,Сіз қалай да қуып жете аласыз ба?
Dialogue: 0,0:14:23.94,0:14:25.82,Default,,0,0,0,,Негіздерді есте сақтаңыз
Dialogue: 0,0:14:26.28,0:14:28.07,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:28.20,0:14:31.24,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:31.53,0:14:33.37,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:14:36.04,0:14:38.12,Default,,0,0,0,,Иә! Сәтті түсіру
Dialogue: 0,0:14:38.21,0:14:40.25,Default,,0,0,0,,Жылдамдығы да бұрынғыдан жылдамырақ.
Dialogue: 0,0:14:40.37,0:14:42.21,Default,,0,0,0,,Валькирия Бұл жылдам
Dialogue: 0,0:14:42.29,0:14:44.13,Default,,0,0,0,,Deathsizer-ге хабарласыңыз
Dialogue: 0,0:14:44.21,0:14:45.75,Default,,0,0,0,,Жақсы, Валькири.
Dialogue: 0,0:14:45.84,0:14:46.88,Default,,0,0,0,,Тезірек
Dialogue: 0,0:14:46.96,0:14:48.30,Default,,0,0,0,,Go Death Sizeer
Dialogue: 0,0:14:53.35,0:14:54.31,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:14:59.64,0:15:01.90,Default,,0,0,0,,(өткізу орнындағы шу)
Dialogue: 0,0:15:01.98,0:15:03.06,Default,,0,0,0,,Қайсысы бірінші келеді?
Dialogue: 0,0:15:03.27,0:15:04.40,Default,,0,0,0,,Маған сән журналының түсірілімінде қолданылған осы киімді берді
Dialogue: 0,0:15:06.40,0:15:08.61,Default,,0,0,0,,Екеуі де бір уақытта аяқталады
Dialogue: 0,0:15:08.69,0:15:09.57,Default,,0,0,0,,Ұпай жоқ
Dialogue: 0,0:15:09.74,0:15:11.91,Default,,0,0,0,,Күтпеген жеребе
Dialogue: 0,0:15:11.99,0:15:13.74,Default,,0,0,0,,Келесі шайқасқа кіргізілді
Dialogue: 0,0:15:14.53,0:15:15.45,Default,,0,0,0,,Кездейсоқ
Dialogue: 0,0:15:17.66,0:15:19.25,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:15:19.37,0:15:22.21,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:22.33,0:15:24.17,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:15:32.84,0:15:36.22,Default,,0,0,0,,Бірінші шайқаста жеңілгенім өтірік болды.
Dialogue: 0,0:15:38.02,0:15:40.94,Default,,0,0,0,,Бір уақытта қайталап аяқтау
Dialogue: 0,0:15:41.06,0:15:42.94,Default,,0,0,0,,Енді ше? Сот
Dialogue: 0,0:15:43.27,0:15:45.40,Default,,0,0,0,,Ұпайларды салмаңыз
Dialogue: 0,0:15:45.69,0:15:46.69,Default,,0,0,0,,Сол бала менің одақтасым болады дегің келе ме?
Dialogue: 0,0:15:46.90,0:15:48.73,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:15:48.82,0:15:50.99,Default,,0,0,0,,Бұл үлкен шайқас болды.
Dialogue: 0,0:15:51.07,0:15:52.15,Default,,0,0,0,,Күшті шайқас
Dialogue: 0,0:15:52.40,0:15:54.66,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:55.12,0:15:56.24,Default,,0,0,0,,Сурет салу
Dialogue: 0,0:15:56.33,0:15:57.08,Default,,0,0,0,,Сурет салу
Dialogue: 0,0:15:57.62,0:15:58.54,Default,,0,0,0,,Сурет салу
Dialogue: 0,0:15:58.62,0:16:00.58,Default,,0,0,0,,Тіпті 6-шы шайқаста
Dialogue: 0,0:16:00.66,0:16:02.96,Default,,0,0,0,,Үкім әлі тең аяқталды
Dialogue: 0,0:16:03.04,0:16:05.58,Default,,0,0,0,,Барлық жарылыс бір уақытта аяқталады
Dialogue: 0,0:16:06.46,0:16:07.46,Default,,0,0,0,,Сурет салу
Dialogue: 0,0:16:07.54,0:16:09.17,Default,,0,0,0,,Ұпай жоқ
Dialogue: 0,0:16:09.38,0:16:11.63,Default,,0,0,0,,Керемет, шындап, ғажап
Dialogue: 0,0:16:11.72,0:16:13.72,Default,,0,0,0,,Мен мұндай матчты бұрын-соңды көрген емеспін.
Dialogue: 0,0:16:15.51,0:16:16.80,Default,,0,0,0,,Неліктен мен шеше алмаймын?
Dialogue: 0,0:16:17.47,0:16:19.10,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:16:19.18,0:16:20.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.14,0:16:22.73,Default,,0,0,0,,Серік, келесі жолы шешеміз.
Dialogue: 0,0:16:23.39,0:16:25.27,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:25.52,0:16:27.15,Default,,0,0,0,,Сегізінші шайқас
Dialogue: 0,0:16:27.52,0:16:29.07,Default,,0,0,0,,Шабуыл шабуылы
Dialogue: 0,0:16:29.15,0:16:30.78,Default,,0,0,0,,Әрі қарай жалғастырыңыз
Dialogue: 0,0:16:30.86,0:16:31.78,Default,,0,0,0,,Ах
Dialogue: 0,0:16:31.86,0:16:33.32,Default,,0,0,0,,Бұл қауіпті, абай болыңыз.
Dialogue: 0,0:16:34.20,0:16:36.74,Default,,0,0,0,,Сәлем! Көтеріп алды
Dialogue: 0,0:16:37.70,0:16:38.83,Default,,0,0,0,,Сурет салу
Dialogue: 0,0:16:39.28,0:16:40.45,Default,,0,0,0,,Матака?
Dialogue: 0,0:16:40.54,0:16:41.95,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:16:42.41,0:16:44.87,Default,,0,0,0,,Бірақ бұл өте қызық!
Dialogue: 0,0:16:45.00,0:16:46.71,Default,,0,0,0,,Бар-нидің жағдайы жақсарды.
Dialogue: 0,0:16:46.96,0:16:50.13,Default,,0,0,0,,Ол... өзінің әлсіздігін қаруға айналдырды.
Dialogue: 0,0:16:50.21,0:16:51.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:51.42,0:16:54.93,Default,,0,0,0,,7 дәйекті жарылыс аяқталады
Dialogue: 0,0:16:55.05,0:16:57.18,Default,,0,0,0,,Бұл шайқас аяқталады ма?
Dialogue: 0,0:16:57.89,0:17:00.76,Default,,0,0,0,,Толқып кетсе, бірдеңеге құмар болады.
Dialogue: 0,0:17:00.85,0:17:02.47,Default,,0,0,0,,Басқа заттарды көре алмайды
Dialogue: 0,0:17:03.23,0:17:04.98,Default,,0,0,0,,Оның басында не бар?
Dialogue: 0,0:17:05.06,0:17:08.31,Default,,0,0,0,,шығанақ көңілді болғаннан басқа, ол өте бос.
Dialogue: 0,0:17:08.94,0:17:10.65,Default,,0,0,0,,Мен ашуланғанымды ұмытып қалдым.
Dialogue: 0,0:17:11.03,0:17:12.69,Default,,0,0,0,,Сіз ақымақ дейсіз бе?
Dialogue: 0,0:17:12.82,0:17:14.19,Default,,0,0,0,,Оның мінезі жақсы.
Dialogue: 0,0:17:14.28,0:17:15.49,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:17:15.57,0:17:16.99,Default,,0,0,0,,Бальто аяқтарының орналасуы
Dialogue: 0,0:17:17.32,0:17:19.62,Default,,0,0,0,,Алдымен сол жақ алдыңғы болды, бірақ
Dialogue: 0,0:17:19.70,0:17:21.04,Default,,0,0,0,,Кері
Dialogue: 0,0:17:21.24,0:17:22.91,Default,,0,0,0,,Іске қосу құрылғысын қалай ұстау керек
Dialogue: 0,0:17:23.00,0:17:25.83,Default,,0,0,0,,Баудың тартылу бағыты бастапқыда басқаша болса да
Dialogue: 0,0:17:25.91,0:17:29.04,Default,,0,0,0,,Менің пішінімді орындасаңыз да, ол тиімді емес.
Dialogue: 0,0:17:29.25,0:17:31.42,Default,,0,0,0,,Сіз оны өзіңізге ыңғайлы етіп өзгерттіңіз бе?
Dialogue: 0,0:17:31.67,0:17:33.30,Default,,0,0,0,,Барлығы бейсаналық
Dialogue: 0,0:17:40.85,0:17:42.60,Default,,0,0,0,,Жарайды, Сута.
Dialogue: 0,0:17:42.93,0:17:44.73,Default,,0,0,0,,Бұл аз уақытты алды.
Dialogue: 0,0:17:45.77,0:17:47.81,Default,,0,0,0,,Соңында жеңетін менмін
Dialogue: 0,0:17:48.56,0:17:49.56,Default,,0,0,0,,Сәлем Дина
Dialogue: 0,0:17:49.73,0:17:51.27,Default,,0,0,0,,Сіз өте кереметсіз.
Dialogue: 0,0:17:51.94,0:17:53.86,Default,,0,0,0,,Менімен сөйлеспе, ақымақ
Dialogue: 0,0:17:53.98,0:17:56.32,Default,,0,0,0,,Өйткені мұндай шайқастар сирек кездеседі.
Dialogue: 0,0:17:56.40,0:17:58.11,Default,,0,0,0,,Оны аяқтамау босқа кетеді.
Dialogue: 0,0:17:58.20,0:17:58.82,Default,,0,0,0,,Ха...
Dialogue: 0,0:17:58.91,0:18:01.33,Default,,0,0,0,,Бауырым, тағы бір рет
Dialogue: 0,0:18:01.41,0:18:02.87,Default,,0,0,0,,Сәлем, өтінемін
Dialogue: 0,0:18:03.16,0:18:05.66,Default,,0,0,0,,Мен осылай мәңгілік күресуді қалаймын.
Dialogue: 0,0:18:06.25,0:18:09.63,Default,,0,0,0,,Мен осылай мәңгілік күресуді қалаймын, солай ма?
Dialogue: 0,0:18:10.08,0:18:11.17,Default,,0,0,0,,Өзімшіл болма
Dialogue: 0,0:18:11.25,0:18:13.25,Default,,0,0,0,,Бұл шынымен де соңғы рет
Dialogue: 0,0:18:13.34,0:18:15.17,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:18:16.13,0:18:17.09,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:18:17.17,0:18:18.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:18.55,0:18:20.22,Default,,0,0,0,,Шекара Regalia-ның қалқаны әрі жалғыз қаруы болып табылады.
Dialogue: 0,0:18:21.39,0:18:22.35,Default,,0,0,0,,Дина
Dialogue: 0,0:18:22.47,0:18:23.72,Default,,0,0,0,,Мен сенімен...
Dialogue: 0,0:18:23.81,0:18:26.31,Default,,0,0,0,,Мен тағы да жүздеген рет шайқасқым келеді.
Dialogue: 0,0:18:27.02,0:18:28.02,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:28.69,0:18:30.40,Default,,0,0,0,,Он үшінші шайқас
Dialogue: 0,0:18:35.94,0:18:37.69,Default,,0,0,0,,Шапшаң атуға дайын
Dialogue: 0,0:18:38.24,0:18:39.15,Default,,0,0,0,,Эй Шу
Dialogue: 0,0:18:39.28,0:18:41.45,Default,,0,0,0,,Мүмкін бұл менің қиялым шығар.
Dialogue: 0,0:18:41.70,0:18:42.28,Default,,0,0,0,,Не?
Dialogue: 0,0:18:42.37,0:18:44.70,Default,,0,0,0,,Динаның көңіл-күйі өзгерді ме?
Dialogue: 0,0:18:45.41,0:18:47.12,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:47.54,0:18:50.83,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:51.29,0:18:53.59,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:58.80,0:18:59.97,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:00.05,0:19:02.26,Default,,0,0,0,,Екеуі де көңілді жүрген сияқты Иә.
Dialogue: 0,0:19:03.72,0:19:06.52,Default,,0,0,0,,Жүр, Валькири!
Dialogue: 0,0:19:09.27,0:19:10.81,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:13.15,0:19:14.98,Default,,0,0,0,,Өлім өлшемін жойыңыз!
Dialogue: 0,0:19:15.11,0:19:16.23,Default,,0,0,0,,（）
Dialogue: 0,0:19:19.82,0:19:21.49,Default,,0,0,0,,(Орағын сермеп жатқан орақшының дыбысы)
Dialogue: 0,0:19:26.95,0:19:30.54,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:19:30.96,0:19:31.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:33.42,0:19:35.79,Default,,0,0,0,,Жеңіс Valkyrie Burst Finish
Dialogue: 0,0:19:35.88,0:19:38.96,Default,,0,0,0,,Аои Барто 2-1 есебімен жеңіске жетті
Dialogue: 0,0:19:39.21,0:19:41.26,Default,,0,0,0,,Жасайық
Dialogue: 0,0:19:41.34,0:19:43.76,Default,,0,0,0,,Сізде керемет шайқас болды!
Dialogue: 0,0:19:44.55,0:19:47.35,Default,,0,0,0,,Ұзақ, ұзақ, ұзақ шайқас
Dialogue: 0,0:19:47.43,0:19:48.93,Default,,0,0,0,,Соңында аяқталды
Dialogue: 0,0:19:49.02,0:19:51.10,Default,,0,0,0,,11 ұтыс ойынынан кейін
Dialogue: 0,0:19:51.19,0:19:52.35,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:19:52.44,0:19:54.73,Default,,0,0,0,,Ширек финалға өту
Dialogue: 0,0:19:56.90,0:19:58.03,Default,,0,0,0,,Дина!
Dialogue: 0,0:19:58.11,0:19:58.98,Default,,0,0,0,,Не?
Dialogue: 0,0:19:59.11,0:20:00.36,Default,,0,0,0,,Көңілді болды
Dialogue: 0,0:20:00.61,0:20:02.40,Default,,0,0,0,,Мен мұндай шайқаста бірінші рет болып тұрмын.
Dialogue: 0,0:20:02.70,0:20:05.32,Default,,0,0,0,,Қайтадан жасайық! Не!
Dialogue: 0,0:20:10.58,0:20:11.96,Default,,0,0,0,,Шекара Regalia-ның қалқаны әрі жалғыз қаруы болып табылады.
Dialogue: 0,0:20:12.41,0:20:14.46,Default,,0,0,0,,Бейблейдтер көңілді.
Dialogue: 0,0:20:15.79,0:20:16.92,Default,,0,0,0,,That's right.
Dialogue: 0,0:20:20.84,0:20:23.93,Default,,0,0,0,,О, Дина-кун, мен естідім.
Dialogue: 0,0:20:24.01,0:20:26.43,Default,,0,0,0,,Мен сенің кеше үлкен шайқас болғаныңды естідім.
Dialogue: 0,0:20:26.72,0:20:27.97,Default,,0,0,0,,Оны кімнен естідің?
Dialogue: 0,0:20:28.06,0:20:28.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:28.85,0:20:31.31,Default,,0,0,0,,Қазір Сута-кунның бөлмесінде, дос ретінде.
Dialogue: 0,0:20:33.81,0:20:35.15,Default,,0,0,0,,Кеттік, Сута
Dialogue: 0,0:20:35.23,0:20:37.02,Default,,0,0,0,,Біріктіріңіз!
Dialogue: 0,0:20:37.56,0:20:39.61,Default,,0,0,0,,Эй, Дина, сен кешігіп қалдың.
Dialogue: 0,0:20:39.69,0:20:41.49,Default,,0,0,0,,Бауырым, қарашы, қарашы!
Dialogue: 0,0:20:41.65,0:20:43.90,Default,,0,0,0,,Балалар, мұнда не үшін келдіңдер?
Dialogue: 0,0:20:43.99,0:20:46.57,Default,,0,0,0,,Мен ағамды барлауға келгеніңізді естідім.
Dialogue: 0,0:20:46.66,0:20:47.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:47.28,0:20:49.33,Default,,0,0,0,,Өйткені менің ағам шынымен мықты
Dialogue: 0,0:20:49.41,0:20:52.37,Default,,0,0,0,,Мен сенің бірге жаттығу жасап, күшейгің келетінін естідім.
Dialogue: 0,0:20:52.50,0:20:54.04,Default,,0,0,0,,Үлкен аға, бұл керемет!
Dialogue: 0,0:20:54.50,0:20:55.54,Default,,0,0,0,,Сота
Dialogue: 0,0:20:55.79,0:20:57.92,Default,,0,0,0,,Мен сенімен тағы да шайқасамын.
Dialogue: 0,0:20:58.09,0:21:00.42,Default,,0,0,0,,Ендеше бірге орындайық.
Dialogue: 0,0:21:00.50,0:21:01.63,Default,,0,0,0,,Бей клубы
Dialogue: 0,0:21:05.55,0:21:06.30,Default,,0,0,0,,Ал Вайолет ше?
Dialogue: 0,0:21:06.51,0:21:08.10,Default,,0,0,0,,Гарн
Dialogue: 0,0:21:08.43,0:21:10.35,Default,,0,0,0,,Мен сенің досың боламын ба?
Dialogue: 0,0:21:10.64,0:21:11.22,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:21:11.31,0:21:12.52,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:12.60,0:21:14.77,Default,,0,0,0,,Бұл дәл қазір дос болу процесі.
Dialogue: 0,0:21:15.94,0:21:16.73,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:18.77,0:21:20.15,Default,,0,0,0,,Валькири туралы не деуге болады?
Dialogue: 0,0:21:20.65,0:21:21.53,Default,,0,0,0,,Окабе?
Dialogue: 0,0:21:25.03,0:21:27.41,Default,,0,0,0,,Сіз шынымен де шыншыл емессіз.
Dialogue: 0,0:21:30.62,0:21:31.83,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:21:31.95,0:21:33.41,Default,,0,0,0,,Бұл клуб.
Dialogue: 0,0:21:34.20,0:21:35.46,Default,,0,0,0,,Бұл клуб.
Dialogue: 0,0:21:36.92,0:21:38.50,Default,,0,0,0,,Бұл клуб.
Dialogue: 0,0:21:39.38,0:21:42.92,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:43.01,0:21:45.51,Default,,0,0,0,,Бей клубы
Dialogue: 0,0:21:45.63,0:21:46.72,Default,,0,0,0,,Ұсталу аяқталды.
Dialogue: 0,0:21:47.18,0:21:50.01,Default,,0,0,0,,Ей, бірге жасайық, Бей клубы.
Dialogue: 0,0:21:50.10,0:21:51.35,Default,,0,0,0,,Сәлем Дина
Dialogue: 0,0:21:51.51,0:21:53.27,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:22:09.11,0:22:15.20,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.41,0:22:21.54,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.00,0:22:27.55,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.01,0:22:31.34,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.51,0:22:36.43,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.35,0:22:41.06,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.15,0:22:44.36,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.44,0:22:50.78,Default,,0,0,0,,Артынан қуып жетсең көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.03,0:22:56.58,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.75,0:23:03.34,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.92,0:23:09.34,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.51,0:23:12.68,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.18,0:23:17.14,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.44,0:23:27.40,Default,,0,0,0,,Мен
Dialogue: 0,0:23:27.48,0:23:30.28,Default,,0,0,0,,Бейбатл ойнағанда үнемі ашуланамын.
Dialogue: 0,0:23:30.49,0:23:32.66,Default,,0,0,0,,Валькири қатты тырысып жатыр.
Dialogue: 0,0:23:32.74,0:23:34.99,Default,,0,0,0,,Мен өзімнің кесірімнен ұтыла алмаймын.
Dialogue: 0,0:23:35.20,0:23:38.54,Default,,0,0,0,,Мені жаттықтыру үшін әркім өз күшін береді.
Dialogue: 0,0:23:38.62,0:23:40.25,Default,,0,0,0,,Сіз бақытты емессіз бе?
Dialogue: 0,0:23:40.41,0:23:42.25,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:42.54,0:23:44.33,Default,,0,0,0,,Таэро! Бұл арнайы тренинг!
Dialogue: 0,0:23:45.13,0:23:47.34,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.71,0:23:49.26,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.76,0:23:56.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory