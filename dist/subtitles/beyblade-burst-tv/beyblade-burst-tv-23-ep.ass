Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.17,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.25,0:00:12.67,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.23,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.31,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.86,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.44,0:00:33.40,Default,,0,0,0,,Жеңілген адам қайта жанданды
Dialogue: 0,0:00:33.49,0:00:36.07,Default,,0,0,0,,Аудан таңдау турнирі басталды.
Dialogue: 0,0:00:36.78,0:00:39.20,Default,,0,0,0,,Ашылу салтанатында өте танымал кумир болады.
Dialogue: 0,0:00:39.28,0:00:41.95,Default,,0,0,0,,Бейблейд төрт айналдырушы Зак та келді.
Dialogue: 0,0:00:42.04,0:00:44.50,Default,,0,0,0,,Өте қызу болды.
Dialogue: 0,0:00:45.50,0:00:48.84,Default,,0,0,0,,Валькири ақыры оянып, жалғыз мүйізді жеңеді.
Dialogue: 0,0:00:50.25,0:00:51.92,Default,,0,0,0,,Дина, Вакия және Орочи де
Dialogue: 0,0:00:52.01,0:00:54.26,Default,,0,0,0,,Екінші турға өту туралы шешім қабылданды.
Dialogue: 0,0:00:55.38,0:00:57.76,Default,,0,0,0,,Қалғаны - Кумичо мен Хоудзи.
Dialogue: 0,0:01:05.85,0:01:08.23,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:08.56,0:01:13.74,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:25.04,0:01:28.42,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:28.92,0:01:31.04,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:31.46,0:01:35.59,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:35.72,0:01:38.93,Default,,0,0,0,,Дұрыс, сіздің жүзіңіздегі өрнек
Dialogue: 0,0:01:39.05,0:01:45.48,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:45.77,0:01:50.19,Default,,0,0,0,,АУ! Айналып келе жатқан арман
Dialogue: 0,0:01:50.69,0:01:56.11,Default,,0,0,0,,Ыстық және тербеліс ойнайық
Dialogue: 0,0:01:56.24,0:01:58.49,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:01:58.57,0:02:03.28,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:03.45,0:02:08.54,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:08.83,0:02:11.08,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:11.29,0:02:13.63,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:13.92,0:02:17.84,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:18.01,0:02:23.01,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:23.22,0:02:25.39,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:29.48,0:02:31.31,Default,,0,0,0,,Жалғыз өлімші
Dialogue: 0,0:02:33.06,0:02:33.73,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:33.82,0:02:36.28,Default,,0,0,0,,Бұл да қызу шайқас
Dialogue: 0,0:02:36.36,0:02:38.32,Default,,0,0,0,,Екінші шайқасқа кіру
Dialogue: 0,0:02:38.74,0:02:40.57,Default,,0,0,0,,Харуто Аота алға шығуға мүмкіндік берді
Dialogue: 0,0:02:40.66,0:02:43.03,Default,,0,0,0,,Оны айналдыра аламыз ба?
Dialogue: 0,0:02:43.12,0:02:45.12,Default,,0,0,0,,Кумичо жүр~
Dialogue: 0,0:02:45.20,0:02:47.00,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:02:47.12,0:02:49.46,Default,,0,0,0,,Мен Рагнаруктың орталығын алуға келдім.
Dialogue: 0,0:02:49.54,0:02:51.96,Default,,0,0,0,,Бұл жақсы тактика.
Dialogue: 0,0:02:52.29,0:02:54.79,Default,,0,0,0,,Мен ортада жеңемін
Dialogue: 0,0:02:55.00,0:02:57.84,Default,,0,0,0,,Бұл бәрібір сенің аузың, жүр!
Dialogue: 0,0:02:58.05,0:03:01.30,Default,,0,0,0,,Рагнарук шабуылдардан қорықпайды
Dialogue: 0,0:03:01.38,0:03:03.18,Default,,0,0,0,,Ой, менің басым айналып кетті.
Dialogue: 0,0:03:03.26,0:03:05.14,Default,,0,0,0,,Ол тоқтайды ма? Ол тоқтады!
Dialogue: 0,0:03:05.47,0:03:08.14,Default,,0,0,0,,Рагнарук Айналдыру
Dialogue: 0,0:03:08.22,0:03:10.77,Default,,0,0,0,,Рантаро Кияма 2-0 есебімен жеңіске жетті
Dialogue: 0,0:03:11.19,0:03:12.02,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:03:12.10,0:03:13.10,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:13.19,0:03:15.19,Default,,0,0,0,,Жақсы, Кумичо.
Dialogue: 0,0:03:15.52,0:03:17.61,Default,,0,0,0,,Бүгінгі соңғы шайқас
Dialogue: 0,0:03:17.82,0:03:20.65,Default,,0,0,0,,Ходжи Конта VS Кейсуке Ямада!
Dialogue: 0,0:03:20.78,0:03:22.95,Default,,0,0,0,,Ұш, Хорсуд!
Dialogue: 0,0:03:23.41,0:03:25.07,Default,,0,0,0,,Hiyaho!
Dialogue: 0,0:03:25.16,0:03:26.95,Default,,0,0,0,,Хорсуды ұрып-соғу
Dialogue: 0,0:03:27.04,0:03:29.08,Default,,0,0,0,,Орталықты бір қимылмен алдым.
Dialogue: 0,0:03:36.46,0:03:38.80,Default,,0,0,0,,Horsudo Overfinish
Dialogue: 0,0:03:38.88,0:03:41.59,Default,,0,0,0,,Ходжи Конта 2-0 есебімен жеңіске жетті
Dialogue: 0,0:03:41.67,0:03:43.18,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:46.05,0:03:48.18,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:03:48.26,0:03:49.56,Default,,0,0,0,,Әлі көп жол бар
Dialogue: 0,0:03:50.06,0:03:53.31,Default,,0,0,0,,Енді бірінші айналым аяқталды.
Dialogue: 0,0:03:53.85,0:03:56.19,Default,,0,0,0,,Ағымдағы нәтижелерді қарастырайық
Dialogue: 0,0:03:56.69,0:03:59.03,Default,,0,0,0,,Екінші раундтағы кездесу шешілді.
Dialogue: 0,0:03:59.23,0:04:00.49,Default,,0,0,0,,Блок
Dialogue: 0,0:04:00.57,0:04:03.20,Default,,0,0,0,,Барто Аои Рантаро Кияма
Dialogue: 0,0:04:03.28,0:04:04.41,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:04.49,0:04:05.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:05.82,0:04:09.16,Default,,0,0,0,,Және С блок Комурасаки Вакия
Dialogue: 0,0:04:09.24,0:04:10.45,Default,,0,0,0,,Ходжи Конта
Dialogue: 0,0:04:10.54,0:04:11.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:11.83,0:04:15.21,Default,,0,0,0,,Бұл екі топ екеуі де жақын достар.
Dialogue: 0,0:04:15.67,0:04:18.38,Default,,0,0,0,,Бұл көруге болатын шайқас болады.
Dialogue: 0,0:04:18.75,0:04:20.59,Default,,0,0,0,,Керемет комбинация
Dialogue: 0,0:04:20.67,0:04:22.47,Default,,0,0,0,,Бұл ең жақсы достардың кездесуі.
Dialogue: 0,0:04:23.01,0:04:24.51,Default,,0,0,0,,Барт және т.б.
Dialogue: 0,0:04:25.51,0:04:26.72,Default,,0,0,0,,Ботчан
Dialogue: 0,0:04:27.60,0:04:31.18,Default,,0,0,0,,Бейді финалға кім шығарады?
Dialogue: 0,0:04:31.27,0:04:33.06,Default,,0,0,0,,Тағы кездескенше!
Dialogue: 0,0:04:36.81,0:04:39.65,Default,,0,0,0,,Кумичо, мен қатты күйіп қалдым.
Dialogue: 0,0:04:39.73,0:04:42.36,Default,,0,0,0,,Букьяро, мен оттырақпын.
Dialogue: 0,0:04:42.44,0:04:44.28,Default,,0,0,0,,Мен миллион есе жанып тұрмын!
Dialogue: 0,0:04:44.36,0:04:45.74,Default,,0,0,0,,Мен 100 миллион есе көп күйіп жатырмын!
Dialogue: 0,0:04:45.82,0:04:47.07,Default,,0,0,0,,Сонда мен 10 миллиард есе жақсы боламын!
Dialogue: 0,0:04:47.16,0:04:48.74,Default,,0,0,0,,Олай болса, мен 100 миллиард рет
Dialogue: 0,0:04:48.95,0:04:50.87,Default,,0,0,0,,Екеуің доғарыңдар.
Dialogue: 0,0:04:50.95,0:04:52.16,Default,,0,0,0,,Ұрыс болмайды
Dialogue: 0,0:04:52.37,0:04:54.46,Default,,0,0,0,,Бұл ұрыс емес
Dialogue: 0,0:04:54.54,0:04:56.33,Default,,0,0,0,,Мен матчты күте алмаймын.
Dialogue: 0,0:04:56.42,0:04:57.58,Default,,0,0,0,,О, мен де.
Dialogue: 0,0:04:57.67,0:04:58.92,Default,,0,0,0,,Жаттығу жасайық
Dialogue: 0,0:04:59.00,0:04:59.75,Default,,0,0,0,,О!
Dialogue: 0,0:05:01.30,0:05:03.05,Default,,0,0,0,,Иә~
Dialogue: 0,0:05:07.09,0:05:08.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:09.60,0:05:10.68,Default,,0,0,0,,Ботчан
Dialogue: 0,0:05:10.89,0:05:12.14,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:05:12.22,0:05:14.23,Default,,0,0,0,,Ботчан келесі матч
Dialogue: 0,0:05:14.64,0:05:17.52,Default,,0,0,0,,Мен оны тез аламын деп ойламаппын.
Dialogue: 0,0:05:17.90,0:05:18.94,Default,,0,0,0,,Иә
Dialogue: 0,0:05:19.27,0:05:21.98,Default,,0,0,0,,Егер екеуміз де шындап жасасақ, онда иә.
Dialogue: 0,0:05:23.11,0:05:24.15,Default,,0,0,0,,Ботчан
Dialogue: 0,0:05:25.15,0:05:28.41,Default,,0,0,0,,Мен сарайға біраз уақыт бармаймын.
Dialogue: 0,0:05:29.03,0:05:30.07,Default,,0,0,0,,Не?
Dialogue: 0,0:05:30.28,0:05:31.87,Default,,0,0,0,,Келесі матчқа дейін
Dialogue: 0,0:05:31.95,0:05:33.95,Default,,0,0,0,,Мен де монахпен кездесуді жоспарлап отырған жоқпын.
Dialogue: 0,0:05:34.29,0:05:35.54,Default,,0,0,0,,Сәлем Хоудзи
Dialogue: 0,0:05:35.62,0:05:37.75,Default,,0,0,0,,Өзімшіл болғаным үшін кешіріңіз
Dialogue: 0,0:05:42.96,0:05:45.17,Default,,0,0,0,,Мен сенің рухыңды қабылдадым.
Dialogue: 0,0:05:45.42,0:05:47.01,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:05:47.09,0:05:48.93,Default,,0,0,0,,Қара Құдай Дина
Dialogue: 0,0:05:49.18,0:05:51.22,Default,,0,0,0,,Менің дайындығымды дәлелдеу
Dialogue: 0,0:05:51.30,0:05:52.47,Default,,0,0,0,,Мен саған көрсетемін.
Dialogue: 0,0:05:54.31,0:05:55.85,Default,,0,0,0,,Бұл не? Сен сонда екенсің ғой.
Dialogue: 0,0:05:57.02,0:05:59.15,Default,,0,0,0,,Енді үйге қайтайық.
Dialogue: 0,0:05:59.23,0:06:01.06,Default,,0,0,0,,Соңғы жебеге айналғанша...
Dialogue: 0,0:06:01.27,0:06:04.19,Default,,0,0,0,,Тағы бір уақыт бар, Кумичо.
Dialogue: 0,0:06:04.28,0:06:05.15,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:05.23,0:06:07.45,Default,,0,0,0,,Кумичо менің орнымда
Dialogue: 0,0:06:07.53,0:06:08.95,Default,,0,0,0,,Тағы бір рет
Dialogue: 0,0:06:09.03,0:06:11.03,Default,,0,0,0,,Жоқ, мен келесімін.
Dialogue: 0,0:06:11.12,0:06:13.66,Default,,0,0,0,,Келесі жолы тағы да менмін.
Dialogue: 0,0:06:14.79,0:06:15.95,Default,,0,0,0,,Жасайық, Балто
Dialogue: 0,0:06:16.58,0:06:17.37,Default,,0,0,0,,О
Dialogue: 0,0:06:17.58,0:06:20.29,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:20.50,0:06:22.63,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:29.47,0:06:31.26,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:06:31.64,0:06:33.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:33.64,0:06:35.22,Default,,0,0,0,,Алып кетпе, Балто.
Dialogue: 0,0:06:35.31,0:06:36.18,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:36.27,0:06:38.56,Default,,0,0,0,,Мен сені келесі жолы жеңемін.
Dialogue: 0,0:06:38.64,0:06:41.10,Default,,0,0,0,,Бұл келе жатыр!
Dialogue: 0,0:06:44.44,0:06:46.69,Default,,0,0,0,,(ояту дабылы)
Dialogue: 0,0:06:56.24,0:06:58.08,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:06:59.71,0:07:01.54,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:03.13,0:07:04.29,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:07:05.75,0:07:06.80,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:07:08.67,0:07:11.55,Default,,0,0,0,,Валькири барған сайын өсіп келеді
Dialogue: 0,0:07:20.27,0:07:21.89,Default,,0,0,0,,Біз ұтыла аламыз ба?
Dialogue: 0,0:07:32.74,0:07:34.41,Default,,0,0,0,,Ояну...
Dialogue: 0,0:07:34.95,0:07:36.20,Default,,0,0,0,,(Мысық мияу)
Dialogue: 0,0:07:36.28,0:07:37.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:38.87,0:07:40.33,Default,,0,0,0,,(Мысық мияу)
Dialogue: 0,0:07:40.41,0:07:41.16,Default,,0,0,0,,Эй
Dialogue: 0,0:07:42.46,0:07:43.96,Default,,0,0,0,,(ырылдаған дыбыс)
Dialogue: 0,0:07:44.88,0:07:46.71,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:07:46.79,0:07:50.59,Default,,0,0,0,,Иә, рас па? Осыдан кейін мен мектепке барамын...
Dialogue: 0,0:07:50.97,0:07:52.18,Default,,0,0,0,,Ах~
Dialogue: 0,0:07:52.26,0:07:53.47,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:07:55.68,0:07:58.31,Default,,0,0,0,,Осылай болуы керек... Уақытында жетеміз бе?
Dialogue: 0,0:07:58.39,0:07:59.85,Default,,0,0,0,,О, Дина
Dialogue: 0,0:07:59.93,0:08:00.89,Default,,0,0,0,,Барт
Dialogue: 0,0:08:02.06,0:08:04.65,Default,,0,0,0,,Дина, бірге барайық.
Dialogue: 0,0:08:04.73,0:08:06.19,Default,,0,0,0,,Мен адамдардың өмірін сақтайтын жұмыста істедім
Dialogue: 0,0:08:06.86,0:08:10.07,Default,,0,0,0,,Эй... бұл не? Жарайсыңдар, жарыс!
Dialogue: 0,0:08:10.15,0:08:12.95,Default,,0,0,0,,Егер бұл жарыс болса, сіз жеңілуіңіз мүмкін.
Dialogue: 0,0:08:13.03,0:08:15.03,Default,,0,0,0,,Неліктен бұл орын алады?
Dialogue: 0,0:08:16.16,0:08:17.95,Default,,0,0,0,,Әрең қауіпсіз
Dialogue: 0,0:08:20.75,0:08:21.95,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:08:22.04,0:08:25.42,Default,,0,0,0,,Ку~ Бұл Бейбаттлдың жалғасы.
Dialogue: 0,0:08:25.75,0:08:26.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:26.96,0:08:30.59,Default,,0,0,0,,Барлығың тездетіп сыныпқа барыңдар.
Dialogue: 0,0:08:31.09,0:08:32.97,Default,,0,0,0,,Уау! иә
Dialogue: 0,0:08:35.84,0:08:38.43,Default,,0,0,0,,Олай болса, ертеңгілікті жалғастырайық.
Dialogue: 0,0:08:39.05,0:08:41.64,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:41.85,0:08:43.85,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:46.65,0:08:47.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:47.61,0:08:50.48,Default,,0,0,0,,Оянған Валькири асығыс
Dialogue: 0,0:08:51.90,0:08:54.82,Default,,0,0,0,,Мен бұл жігітті қалай жеңемін?
Dialogue: 0,0:08:54.90,0:08:56.32,Default,,0,0,0,,Ал, баста!
Dialogue: 0,0:08:57.99,0:09:00.24,Default,,0,0,0,,Жалғыз сіз өсіп жатқан жоқсыз.
Dialogue: 0,0:09:00.58,0:09:01.79,Default,,0,0,0,,Өлімді анықтаушы
Dialogue: 0,0:09:05.92,0:09:06.62,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:06.71,0:09:08.04,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:09:08.29,0:09:09.84,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:09:10.34,0:09:12.96,Default,,0,0,0,,О, сіз бұл жылдамдықты жеңдіңіз бе?
Dialogue: 0,0:09:13.05,0:09:14.22,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:09:14.55,0:09:17.72,Default,,0,0,0,,Бейбатт тек күш пен жылдамдыққа қатысты емес.
Dialogue: 0,0:09:17.80,0:09:19.47,Default,,0,0,0,,Уақытты анықтау маңызды.
Dialogue: 0,0:09:19.55,0:09:20.76,Default,,0,0,0,,Күткендей!
Dialogue: 0,0:09:20.85,0:09:22.35,Default,,0,0,0,,Дина керемет!
Dialogue: 0,0:09:24.31,0:09:26.94,Default,,0,0,0,,Мен келесі жолы жеңемін.Жалғастыру...Жалғастыру...
Dialogue: 0,0:09:27.02,0:09:29.23,Default,,0,0,0,,Жолдан кет, Балт, келесі мен.
Dialogue: 0,0:09:29.44,0:09:31.07,Default,,0,0,0,,Жарайды, келіңіз.
Dialogue: 0,0:09:32.28,0:09:35.28,Default,,0,0,0,,Сізді қазір ұрып-соғу әдісі пайдалы болды.
Dialogue: 0,0:09:35.36,0:09:36.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:36.70,0:09:37.57,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:09:37.91,0:09:38.86,Default,,0,0,0,,О
Dialogue: 0,0:09:39.24,0:09:42.24,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:42.74,0:09:44.75,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:44.83,0:09:46.91,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:09:47.00,0:09:49.63,Default,,0,0,0,,Барлығының жақсы болғанына қуаныштымын.
Dialogue: 0,0:09:50.67,0:09:51.63,Default,,0,0,0,,
Dialogue: 0,0:09:51.71,0:09:53.55,Default,,0,0,0,,Сота, мен оны ашамын.
Dialogue: 0,0:09:56.59,0:09:57.80,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:09:59.09,0:10:00.47,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:10:00.55,0:10:01.43,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:01.80,0:10:03.35,Default,,0,0,0,,Вахаха~
Dialogue: 0,0:10:03.43,0:10:06.56,Default,,0,0,0,,Әділдік одақтасы Жеңілмейтін адам пайда болады
Dialogue: 0,0:10:06.64,0:10:07.69,Default,,0,0,0,,Сота?
Dialogue: 0,0:10:07.77,0:10:10.69,Default,,0,0,0,,Үлкен аға, бұл Сута емес.
Dialogue: 0,0:10:10.77,0:10:12.44,Default,,0,0,0,,Жеңілмейтін адам
Dialogue: 0,0:10:12.52,0:10:13.90,Default,,0,0,0,,Жеңілмейтін адам?
Dialogue: 0,0:10:14.36,0:10:17.82,Default,,0,0,0,,Иә, жеңілмейтін, жеңілмейтін батыр
Dialogue: 0,0:10:18.11,0:10:19.49,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:10:19.57,0:10:21.82,Default,,0,0,0,,One Cool One
Dialogue: 0,0:10:21.91,0:10:24.04,Default,,0,0,0,,Жеңілмейтін адам міндетті түрде жеңеді
Dialogue: 0,0:10:24.12,0:10:25.24,Default,,0,0,0,,Жеңген адам
Dialogue: 0,0:10:25.58,0:10:28.16,Default,,0,0,0,,Сіз оны Инускемен бірге жасадыңыз ба?
Dialogue: 0,0:10:28.25,0:10:29.08,Default,,0,0,0,,Иә
Dialogue: 0,0:10:29.17,0:10:31.38,Default,,0,0,0,,Ол маған ауыспас бұрын айтты.
Dialogue: 0,0:10:31.63,0:10:35.09,Default,,0,0,0,,Мен қуыршақ театрына жаттығумен айналысып жатырмын.
Dialogue: 0,0:10:35.17,0:10:37.67,Default,,0,0,0,,Үлкен аға, екінші айналым да таяп қалды.
Dialogue: 0,0:10:37.76,0:10:39.43,Default,,0,0,0,,Жаттығуға барыңыз.
Dialogue: 0,0:10:39.51,0:10:40.34,Default,,0,0,0,,Е...
Dialogue: 0,0:10:40.80,0:10:42.47,Default,,0,0,0,,Жеңілмейтін сәуле!
Dialogue: 0,0:10:42.55,0:10:43.60,Default,,0,0,0,,Жеңіс, Бір!
Dialogue: 0,0:10:43.93,0:10:45.26,Default,,0,0,0,,Сота
Dialogue: 0,0:10:46.02,0:10:46.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:47.22,0:10:48.18,Default,,0,0,0,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 0,0:10:48.85,0:10:50.27,Default,,0,0,0,,Ол айналып өткеннен кейін әлсіз жақтарымнан шағын соққылар береді.
Dialogue: 0,0:10:52.56,0:10:55.48,Default,,0,0,0,,Соутаның жігіті қамқор жігіт.
Dialogue: 0,0:10:56.28,0:10:58.28,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:59.32,0:11:00.32,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:11:00.40,0:11:01.49,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:11:02.32,0:11:05.12,Default,,0,0,0,,Юго Нансуи ұлттық турнирдің қатысушысы
Dialogue: 0,0:11:05.58,0:11:06.74,Default,,0,0,0,,Қолданылатын шығанақ
Dialogue: 0,0:11:06.83,0:11:08.91,Default,,0,0,0,,Төзімділік түрі Yggdrasil
Dialogue: 0,0:11:09.46,0:11:12.58,Default,,0,0,0,,Шабуыл түріндегі Deathsizer тиімдірек
Dialogue: 0,0:11:14.79,0:11:16.63,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:11:16.88,0:11:18.17,Default,,0,0,0,,Сөзсіз жеңіңіз
Dialogue: 0,0:11:18.71,0:11:19.51,Default,,0,0,0,,Ах
Dialogue: 0,0:11:19.92,0:11:21.22,Default,,0,0,0,,Тағы да келдің бе?
Dialogue: 0,0:11:21.30,0:11:22.51,Default,,0,0,0,,(Мысық мияу)
Dialogue: 0,0:11:22.59,0:11:24.35,Default,,0,0,0,,Иесі уайымдап тұр.
Dialogue: 0,0:11:29.35,0:11:31.10,Default,,0,0,0,,Бар, жүр!
Dialogue: 0,0:11:31.44,0:11:32.65,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:11:32.73,0:11:34.73,Default,,0,0,0,,Керемет, Дина!
Dialogue: 0,0:11:34.81,0:11:35.48,Default,,0,0,0,,Мен?
Dialogue: 0,0:11:35.56,0:11:36.61,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:11:37.19,0:11:38.36,Default,,0,0,0,,Хехе...
Dialogue: 0,0:11:38.44,0:11:41.61,Default,,0,0,0,,Дина, бұл менің жеңісім.
Dialogue: 0,0:11:41.95,0:11:43.49,Default,,0,0,0,,Мен үшін уайымдама — тез арада көліктен шық
Dialogue: 0,0:11:43.57,0:11:45.41,Default,,0,0,0,,Жүр, сілкіп атайық!
Dialogue: 0,0:11:45.87,0:11:49.58,Default,,0,0,0,,Мінекей! Оны үрлеп тастаңыз!
Dialogue: 0,0:11:49.66,0:11:51.21,Default,,0,0,0,,Олар...
Dialogue: 0,0:11:51.29,0:11:52.58,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:53.04,0:11:54.54,Default,,0,0,0,,Сәлем Балто
Dialogue: 0,0:11:54.63,0:11:56.54,Default,,0,0,0,,Тұтынушылар таң қалады.
Dialogue: 0,0:11:56.88,0:11:59.17,Default,,0,0,0,,Ертең Dyna ойыны бар.
Dialogue: 0,0:11:59.26,0:12:01.84,Default,,0,0,0,,Сондықтан мен оған қолдау көрсетуге жаттығамын.
Dialogue: 0,0:12:02.17,0:12:04.55,Default,,0,0,0,,Сіздің істеп жатқан ісіңіз жақсы нәрсе.
Dialogue: 0,0:12:04.64,0:12:06.10,Default,,0,0,0,,Дауыс тым қатты
Dialogue: 0,0:12:06.51,0:12:07.81,Default,,0,0,0,,Иә
Dialogue: 0,0:12:08.43,0:12:10.18,Default,,0,0,0,,Иә, анашым.
Dialogue: 0,0:12:10.64,0:12:11.60,Default,,0,0,0,,Не?
Dialogue: 0,0:12:11.81,0:12:13.81,Default,,0,0,0,,Мен жақсы нәрсе ойладым
Dialogue: 0,0:12:15.65,0:12:17.11,Default,,0,0,0,,Балтық жігіті
Dialogue: 0,0:12:19.07,0:12:23.03,Default,,0,0,0,,Сіз өзіңізге емес, достарыңызға қолдау көрсетуге жаттығасыз ба?
Dialogue: 0,0:12:23.86,0:12:25.28,Default,,0,0,0,,Ол біртүрлі жігіт.
Dialogue: 0,0:12:28.33,0:12:29.66,Default,,0,0,0,,Ертең?
Dialogue: 0,0:12:33.58,0:12:36.29,Default,,0,0,0,,Джейгер Йггдрасилдің сипаттамалары
Dialogue: 0,0:12:36.46,0:12:38.13,Default,,0,0,0,,немесе әлсіздік
Dialogue: 0,0:12:38.38,0:12:39.42,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:12:39.50,0:12:42.88,Default,,0,0,0,,Yggdrasil ұшы арнайы материалдан жасалған.
Dialogue: 0,0:12:42.97,0:12:44.55,Default,,0,0,0,,Масацудың болмауы
Dialogue: 0,0:12:44.93,0:12:45.89,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:12:46.43,0:12:49.01,Default,,0,0,0,,Интернеттегі ақпарат осындай.
Dialogue: 0,0:12:49.22,0:12:51.02,Default,,0,0,0,,Мұнымен кез келген адам жеңе алады...
Dialogue: 0,0:12:51.10,0:12:52.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:53.10,0:12:54.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:54.60,0:12:56.40,Default,,0,0,0,,Сіз жеңгіңіз келе ме?
Dialogue: 0,0:12:56.48,0:12:57.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:57.77,0:13:01.53,Default,,0,0,0,,Бұл сайт сіздің досыңыз.
Dialogue: 0,0:13:01.73,0:13:03.15,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:13:03.24,0:13:05.32,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:13:05.40,0:13:07.45,Default,,0,0,0,,Олардың барлығы заңсыз әдістер емес пе?
Dialogue: 0,0:13:08.12,0:13:09.99,Default,,0,0,0,,Бұл да
Dialogue: 0,0:13:10.37,0:13:12.87,Default,,0,0,0,,Егер сіз мұны жасасаңыз, сіз сол жерде дисквалификацияланасыз.
Dialogue: 0,0:13:21.80,0:13:24.38,Default,,0,0,0,,Балттың сезіміне жауап беру үшін
Dialogue: 0,0:13:24.47,0:13:26.55,Default,,0,0,0,,Мен Югоды жеңемін
Dialogue: 0,0:13:27.43,0:13:30.26,Default,,0,0,0,,Тіке, мұқият.
Dialogue: 0,0:13:34.23,0:13:35.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:35.56,0:13:36.89,Default,,0,0,0,,Ал оның Регалияларының көбі шын мәнінде Нора болып шықты.
Dialogue: 0,0:13:36.98,0:13:40.02,Default,,0,0,0,,Жақсы! Матчты міндетті түрде жеңіңіз!
Dialogue: 0,0:13:40.11,0:13:42.23,Default,,0,0,0,,Арнайы котлет сэндвичі
Dialogue: 0,0:13:42.32,0:13:45.07,Default,,0,0,0,,Дина-кун, сенің бақытты болатыныңа сенімдімін.
Dialogue: 0,0:13:45.15,0:13:46.86,Default,,0,0,0,,Рахмет, анашым
Dialogue: 0,0:13:48.03,0:13:49.82,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:50.82,0:13:52.70,Default,,0,0,0,,Уақыт жақындады ма?
Dialogue: 0,0:13:53.08,0:13:54.45,Default,,0,0,0,,(Мысық мияу)
Dialogue: 0,0:13:55.96,0:13:57.46,Default,,0,0,0,,Мен міндетті түрде жеңемін
Dialogue: 0,0:13:57.96,0:13:59.83,Default,,0,0,0,,Жарайды, мен барамын.
Dialogue: 0,0:14:00.21,0:14:01.59,Default,,0,0,0,,(Мысық мияу)
Dialogue: 0,0:14:02.92,0:14:05.59,Default,,0,0,0,,Ұлдар мен қыздар!
Dialogue: 0,0:14:05.67,0:14:10.64,Default,,0,0,0,,Бейблейд аймағын іріктеу турнирі өзінің екінші кезеңіне өтті!
Dialogue: 0,0:14:10.72,0:14:14.60,Default,,0,0,0,,В блогының тағдыры жеңімпаздар мен жеңілгендер арасында бөлінген.
Dialogue: 0,0:14:15.27,0:14:17.18,Default,,0,0,0,,Келесі, C блогынан
Dialogue: 0,0:14:17.27,0:14:20.06,Default,,0,0,0,,Барлығыңыз бізге жылы лебізіңізді білдіріңіздер.
Dialogue: 0,0:14:20.15,0:14:21.27,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:14:21.52,0:14:24.36,Default,,0,0,0,,Сабырлы да сабырлы жұмбақ бала
Dialogue: 0,0:14:24.44,0:14:26.53,Default,,0,0,0,,Бей - қараңғы өлімші
Dialogue: 0,0:14:26.61,0:14:28.99,Default,,0,0,0,,Қара Құдай Дина!
Dialogue: 0,0:14:29.20,0:14:30.53,Default,,0,0,0,,Дина!
Dialogue: 0,0:14:30.61,0:14:31.82,Default,,0,0,0,,Жүр! Бар!
Dialogue: 0,0:14:32.16,0:14:34.41,Default,,0,0,0,,Самурай жанының жүзі
Dialogue: 0,0:14:34.49,0:14:37.37,Default,,0,0,0,,Бей - Джейгер Йггдрасил!
Dialogue: 0,0:14:37.45,0:14:39.54,Default,,0,0,0,,Нансуи Юго!
Dialogue: 0,0:14:39.62,0:14:42.25,Default,,0,0,0,,Yugo Go!
Dialogue: 0,0:14:42.67,0:14:44.17,Default,,0,0,0,,Екеуі де Алдыңғы
Dialogue: 0,0:14:48.51,0:14:50.05,Default,,0,0,0,,Қара Құдай Дина
Dialogue: 0,0:14:50.13,0:14:52.80,Default,,0,0,0,,Укиомен тең жарысқан адам.
Dialogue: 0,0:14:53.64,0:14:56.60,Default,,0,0,0,,Мен басқаларға қарағанда көбірек жаттығамын.
Dialogue: 0,0:14:57.47,0:14:59.64,Default,,0,0,0,,Мұны әдеттегідей орындаңыз.
Dialogue: 0,0:15:00.48,0:15:01.94,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:15:06.36,0:15:08.28,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:15:09.95,0:15:11.70,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:15:12.20,0:15:15.16,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:15.24,0:15:17.83,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:18.83,0:15:19.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:19.96,0:15:21.92,Default,,0,0,0,,Қараңғы өлім өлшемі
Dialogue: 0,0:15:22.25,0:15:24.50,Default,,0,0,0,,Жүгіруді бастағанда серпіннің болмауы
Dialogue: 0,0:15:24.63,0:15:25.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:25.50,0:15:26.63,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:15:26.71,0:15:29.47,Default,,0,0,0,,Сол қолым дірілдеп, сәтсіз оқ болды.
Dialogue: 0,0:15:29.55,0:15:32.38,Default,,0,0,0,,Йггдрасил күшпен кіріп келеді.
Dialogue: 0,0:15:32.47,0:15:33.39,Default,,0,0,0,,Ах
Dialogue: 0,0:15:34.05,0:15:35.30,Default,,0,0,0,,Даа!
Dialogue: 0,0:15:35.39,0:15:37.81,Default,,0,0,0,,Өлім Сізерді таң қалдырды!
Dialogue: 0,0:15:38.60,0:15:40.98,Default,,0,0,0,,Yggdrasil есептегіші
Dialogue: 0,0:15:41.77,0:15:45.36,Default,,0,0,0,,Yggdrasil 1 ұпай
Dialogue: 0,0:15:45.44,0:15:46.27,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:46.61,0:15:47.98,Default,,0,0,0,,Жарайсың Юго
Dialogue: 0,0:15:48.07,0:15:49.69,Default,,0,0,0,,Бірінші, 1 ұпай
Dialogue: 0,0:15:49.78,0:15:51.36,Default,,0,0,0,,Келесіні шешіңіз!
Dialogue: 0,0:15:51.45,0:15:52.82,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:53.16,0:15:54.07,Default,,0,0,0,,Дина
Dialogue: 0,0:15:54.16,0:15:55.95,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:15:56.28,0:15:58.24,Default,,0,0,0,,Сондықтан, жас ханым,
Dialogue: 0,0:15:59.20,0:16:01.79,Default,,0,0,0,,Мен, неге қазір?
Dialogue: 0,0:16:03.00,0:16:05.46,Default,,0,0,0,,Бұл қысым ма?
Dialogue: 0,0:16:06.21,0:16:08.84,Default,,0,0,0,,Ол ашуланып қалған болуы керек.
Dialogue: 0,0:16:08.92,0:16:09.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:09.88,0:16:11.51,Default,,0,0,0,,Эй, күте тұр, Дина.
Dialogue: 0,0:16:11.59,0:16:12.63,Default,,0,0,0,,Е!
Dialogue: 0,0:16:13.51,0:16:15.34,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:16:15.43,0:16:16.76,Default,,0,0,0,,Дина!
Dialogue: 0,0:16:17.22,0:16:18.93,Default,,0,0,0,,Бізде котлет сэндвичі бар!
Dialogue: 0,0:16:19.14,0:16:20.31,Default,,0,0,0,,Котлет сэндвичі?
Dialogue: 0,0:16:20.39,0:16:21.64,Default,,0,0,0,,Матч жүріп жатыр.
Dialogue: 0,0:16:21.73,0:16:24.02,Default,,0,0,0,,Сіз аш болуыңыз керек. Мынаны же.
Dialogue: 0,0:16:24.10,0:16:25.69,Default,,0,0,0,,Арнайы котлет сэндвичі
Dialogue: 0,0:16:25.77,0:16:28.11,Default,,0,0,0,,Егер сіз мұны жесеңіз, сіз ешқашан жоғалтпайсыз.
Dialogue: 0,0:16:28.69,0:16:30.78,Default,,0,0,0,,Не айттыңыз...
Dialogue: 0,0:16:30.99,0:16:32.74,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:16:32.82,0:16:34.32,Default,,0,0,0,,Матчты тоқтатыңыз
Dialogue: 0,0:16:34.82,0:16:35.99,Default,,0,0,0,,Барт…
Dialogue: 0,0:16:36.28,0:16:37.62,Default,,0,0,0,,Бар аға...
Dialogue: 0,0:16:38.41,0:16:39.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:40.70,0:16:41.41,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:16:42.37,0:16:44.71,Default,,0,0,0,,Сен шынымен ақымақсың.
Dialogue: 0,0:16:45.12,0:16:46.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:46.13,0:16:47.38,Default,,0,0,0,,Котлет сэндвичі
Dialogue: 0,0:16:47.46,0:16:50.30,Default,,0,0,0,,Жеңгеннен кейін жеген дұрыс.
Dialogue: 0,0:16:50.38,0:16:51.96,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:52.05,0:16:54.01,Default,,0,0,0,,Оны матч аяқталғаннан кейін алыңыз
Dialogue: 0,0:16:54.80,0:16:56.22,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:56.30,0:16:57.30,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:58.68,0:17:00.39,Default,,0,0,0,,Сөзсіз жеңіңіз
Dialogue: 0,0:17:03.10,0:17:04.81,Default,,0,0,0,,Ату қатесі дегеніміз не?
Dialogue: 0,0:17:04.89,0:17:07.10,Default,,0,0,0,,Менің ойым қатты бұзылды.
Dialogue: 0,0:17:08.02,0:17:10.15,Default,,0,0,0,,Тыныштал, зейініңді жинақта.
Dialogue: 0,0:17:10.98,0:17:14.19,Default,,0,0,0,,Бұл ойын менің жеңуім үшін.
Dialogue: 0,0:17:15.28,0:17:17.61,Default,,0,0,0,,Енді екінші шайқас.
Dialogue: 0,0:17:17.70,0:17:19.41,Default,,0,0,0,,Дина Куроками қайтып орала ма?
Dialogue: 0,0:17:19.49,0:17:22.83,Default,,0,0,0,,Әлде Юго Нансуи қашып кете ме?
Dialogue: 0,0:17:26.00,0:17:29.08,Default,,0,0,0,,Балто садақты дұрыс қайтарды.
Dialogue: 0,0:17:29.96,0:17:31.55,Default,,0,0,0,,Шулы
Dialogue: 0,0:17:31.88,0:17:32.80,Default,,0,0,0,,Дина
Dialogue: 0,0:17:32.88,0:17:35.05,Default,,0,0,0,,Ол котлет сэндвичімен бірге келеді.
Dialogue: 0,0:17:35.51,0:17:37.68,Default,,0,0,0,,Мен жеңуім керек
Dialogue: 0,0:17:37.89,0:17:40.18,Default,,0,0,0,,Толық кері қайтару, Дина!
Dialogue: 0,0:17:40.39,0:17:42.31,Default,,0,0,0,,Олар мені қолдайды.
Dialogue: 0,0:17:42.39,0:17:44.18,Default,,0,0,0,,Достарым үшін
Dialogue: 0,0:17:48.69,0:17:49.65,Default,,0,0,0,,Ах
Dialogue: 0,0:17:50.81,0:17:52.65,Default,,0,0,0,,Жеңіске жету мүмкін емес
Dialogue: 0,0:17:55.82,0:17:57.99,Default,,0,0,0,,Достарыңыз болса жеңе аласыз ба?
Dialogue: 0,0:17:58.07,0:17:58.74,Default,,0,0,0,,Ха...
Dialogue: 0,0:17:58.82,0:18:00.41,Default,,0,0,0,,Достық болса
Dialogue: 0,0:18:00.49,0:18:02.70,Default,,0,0,0,,Түсірілім сәтті бола ма?
Dialogue: 0,0:18:02.79,0:18:04.29,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:18:04.79,0:18:06.04,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:18:06.46,0:18:08.17,Default,,0,0,0,,Мен сенмін
Dialogue: 0,0:18:09.08,0:18:11.17,Default,,0,0,0,,А... мен мұны білсем де.
Dialogue: 0,0:18:12.21,0:18:13.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:13.17,0:18:16.51,Default,,0,0,0,,Жеңгенше жақсы, білінбесе жақсы.
Dialogue: 0,0:18:16.59,0:18:18.59,Default,,0,0,0,,Сіз немен айналысқыңыз келеді?
Dialogue: 0,0:18:19.05,0:18:20.30,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:18:20.39,0:18:22.14,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:18:22.64,0:18:25.72,Default,,0,0,0,,Олай болса болды.
Dialogue: 0,0:18:25.81,0:18:26.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:26.73,0:18:29.19,Default,,0,0,0,,Осы жерде аяқтайсыз
Dialogue: 0,0:18:29.77,0:18:31.02,Default,,0,0,0,,Қайда...
Dialogue: 0,0:18:31.40,0:18:32.44,Default,,0,0,0,,Соңы
Dialogue: 0,0:18:32.82,0:18:35.98,Default,,0,0,0,,Жеңіске жеткенде бәрі бақытты болар еді.
Dialogue: 0,0:18:36.57,0:18:39.15,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:18:39.24,0:18:41.32,Default,,0,0,0,,Өйткені сен әлсізсің
Dialogue: 0,0:18:41.99,0:18:44.66,Default,,0,0,0,,Сіздің қабілетіңіздің жоқтығынан
Dialogue: 0,0:18:45.79,0:18:47.12,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:18:48.96,0:18:51.88,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:18:51.96,0:18:54.29,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:57.34,0:18:58.47,Default,,0,0,0,,Мен жеңгім келеді
Dialogue: 0,0:18:58.84,0:19:00.51,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:00.80,0:19:04.26,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:04.97,0:19:05.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:05.72,0:19:07.98,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:08.06,0:19:09.10,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:09.64,0:19:10.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:10.89,0:19:14.06,Default,,0,0,0,,Бұл жолы Йггдрасил сәтсіз соққы жасайды.
Dialogue: 0,0:19:15.82,0:19:16.94,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:17.03,0:19:19.03,Default,,0,0,0,,Дина сәтті соққы жасады.
Dialogue: 0,0:19:19.11,0:19:19.95,Default,,0,0,0,,Тынш!
Dialogue: 0,0:19:20.03,0:19:21.28,Default,,0,0,0,,Дина~!
Dialogue: 0,0:19:21.86,0:19:23.07,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:19:23.37,0:19:25.58,Default,,0,0,0,,Escape Escape Yggdrasil
Dialogue: 0,0:19:25.66,0:19:27.41,Default,,0,0,0,,Өлім Сізер оны қуып келеді
Dialogue: 0,0:19:28.95,0:19:30.58,Default,,0,0,0,,Додж
Dialogue: 0,0:19:32.96,0:19:34.21,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:34.29,0:19:35.92,Default,,0,0,0,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,0:19:37.50,0:19:38.76,Default,,0,0,0,,Бұл – тура қызыл карта. (Бакуго) Тс.
Dialogue: 0,0:19:42.55,0:19:45.51,Default,,0,0,0,,Dark Death Sizeer Burst Finish
Dialogue: 0,0:19:45.89,0:19:48.93,Default,,0,0,0,,Дина Курогами 2-1 есебімен жеңді
Dialogue: 0,0:19:49.89,0:19:50.93,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:19:51.10,0:19:53.10,Default,,0,0,0,,Ah, I won.
Dialogue: 0,0:19:53.19,0:19:54.56,Default,,0,0,0,,Енді сен
Dialogue: 0,0:19:54.65,0:19:56.02,Default,,0,0,0,,Дина!
Dialogue: 0,0:19:56.11,0:19:58.57,Default,,0,0,0,,Иә! Дина жеңеді.
Dialogue: 0,0:19:58.65,0:20:00.57,Default,,0,0,0,,Керемет болды, Дина.
Dialogue: 0,0:20:00.78,0:20:02.11,Default,,0,0,0,,Қара Құдай Дина
Dialogue: 0,0:20:02.20,0:20:05.03,Default,,0,0,0,,Біз жартылай финалға артта қалған жеңіспен өтеміз.
Dialogue: 0,0:20:05.12,0:20:06.41,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:06.49,0:20:07.66,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:09.20,0:20:12.04,Default,,0,0,0,,Бір сәт басым айналып, қолым айналып кетті.
Dialogue: 0,0:20:12.83,0:20:14.25,Default,,0,0,0,,(Гиран) Қалай болғанда да, Курокири-сан, комиссия үшін саған сенемін.
Dialogue: 0,0:20:15.04,0:20:18.00,Default,,0,0,0,,Ұрыстың екінші раунды әлі жалғасуда.
Dialogue: 0,0:20:18.34,0:20:21.55,Default,,0,0,0,,Тағы да қызу шайқастар күтіп тұр.
Dialogue: 0,0:20:21.63,0:20:24.05,Default,,0,0,0,,Олай болса тағы кездескенше!
Dialogue: 0,0:20:33.85,0:20:36.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:36.15,0:20:37.56,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:37.65,0:20:38.65,Default,,0,0,0,,Біз көмектескіміз келеді, білесің бе.
Dialogue: 0,0:20:38.73,0:20:40.15,Default,,0,0,0,,Дина!
Dialogue: 0,0:20:40.23,0:20:42.36,Default,,0,0,0,,Үйге үнсіз барма
Dialogue: 0,0:20:42.95,0:20:45.41,Default,,0,0,0,,Қараңызшы, бұл ерекше котлет...
Dialogue: 0,0:20:50.12,0:20:51.08,Default,,0,0,0,,Е...
Dialogue: 0,0:20:51.95,0:20:52.75,Default,,0,0,0,,Ах
Dialogue: 0,0:20:53.37,0:20:55.17,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:56.21,0:20:57.08,Default,,0,0,0,,Ах
Dialogue: 0,0:20:59.04,0:21:00.17,Default,,0,0,0,,Сіз...
Dialogue: 0,0:21:02.71,0:21:03.92,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:21:04.76,0:21:06.55,Default,,0,0,0,,Ах
Dialogue: 0,0:21:07.68,0:21:10.35,Default,,0,0,0,,Кешіріңіз... Мен ойладым.
Dialogue: 0,0:21:11.27,0:21:13.43,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:13.52,0:21:16.56,Default,,0,0,0,,Арнайы котлет сэндвич Тез жеп алайық
Dialogue: 0,0:21:16.65,0:21:17.69,Default,,0,0,0,,О
Dialogue: 0,0:21:18.06,0:21:20.11,Default,,0,0,0,,Аму міңгірледі...
Dialogue: 0,0:21:20.65,0:21:22.61,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:21:22.69,0:21:23.65,Default,,0,0,0,,Дұрыс! Дұрыс!
Dialogue: 0,0:21:24.11,0:21:27.41,Default,,0,0,0,,Келесі біздің кезегіміз, Балто.
Dialogue: 0,0:21:27.74,0:21:28.66,Default,,0,0,0,,О
Dialogue: 0,0:21:28.99,0:21:29.95,Default,,0,0,0,,Ах
Dialogue: 0,0:21:31.79,0:21:33.20,Default,,0,0,0,,Мүлдем котлет!
Dialogue: 0,0:21:33.29,0:21:34.66,Default,,0,0,0,,Құм!
Dialogue: 0,0:21:34.75,0:21:36.25,Default,,0,0,0,,Ihi
Dialogue: 0,0:21:36.33,0:21:38.21,Default,,0,0,0,,Аму!
Dialogue: 0,0:21:38.29,0:21:39.79,Default,,0,0,0,,Уми~
Dialogue: 0,0:21:39.88,0:21:41.84,Default,,0,0,0,,Сенің анаң данышпан.
Dialogue: 0,0:21:41.92,0:21:43.80,Default,,0,0,0,,Мен мұны жасадым.
Dialogue: 0,0:21:44.76,0:21:46.13,Default,,0,0,0,,Куроками…
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Сіз енді ешқашан жоғалмайсыз
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.36,0:23:27.82,Default,,0,0,0,,Мен және Кумичо
Dialogue: 0,0:23:27.90,0:23:31.74,Default,,0,0,0,,Вакия мен Хоуджи соқтығысатын күн де келді.
Dialogue: 0,0:23:31.82,0:23:33.62,Default,,0,0,0,,Өйткені біз доспыз
Dialogue: 0,0:23:33.70,0:23:35.24,Default,,0,0,0,,Өйткені біз доспыз
Dialogue: 0,0:23:35.33,0:23:37.33,Default,,0,0,0,,Кесу бұрыштары жоқ.
Dialogue: 0,0:23:37.41,0:23:39.45,Default,,0,0,0,,Барлық ойларыңызды күшке айналдырыңыз
Dialogue: 0,0:23:39.54,0:23:40.75,Default,,0,0,0,,Икудзе Кумичо
Dialogue: 0,0:23:40.83,0:23:43.08,Default,,0,0,0,,Мен сені дәл ортасынан ұрамын
Dialogue: 0,0:23:43.17,0:23:45.09,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:45.17,0:23:46.55,Default,,0,0,0,,Байыпты және толық қуат!
Dialogue: 0,0:23:46.63,0:23:48.26,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.34,0:23:49.88,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.38,0:23:57.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory