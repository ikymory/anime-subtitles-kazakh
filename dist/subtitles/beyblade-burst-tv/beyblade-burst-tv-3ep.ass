Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.63,0:00:09.21,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.30,0:00:12.67,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.63,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.72,0:00:16.85,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.93,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.35,0:00:24.10,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.19,0:00:26.10,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.19,0:00:28.65,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.36,0:00:35.32,Default,,0,0,0,,Мен Йонекома аудандық WBBA турнирінің екінші айналымында болдым.
Dialogue: 0,0:00:35.74,0:00:39.03,Default,,0,0,0,,Мен күшті жауым Инусуке Мидорикавамен соқтығыстым.
Dialogue: 0,0:00:39.78,0:00:40.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:40.91,0:00:42.04,Default,,0,0,0,,Ах~
Dialogue: 0,0:00:44.83,0:00:47.17,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:00:47.83,0:00:50.55,Default,,0,0,0,,Ах...аа...аа...
Dialogue: 0,0:00:51.92,0:00:54.26,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:00:57.93,0:00:59.30,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:00:59.39,0:01:01.97,Default,,0,0,0,,Осындай маңызды шайқаста сәтсіздікке ұшырағаныма сене алар емеспін.
Dialogue: 0,0:01:04.18,0:01:06.19,Default,,0,0,0,,Енді шайқас басталады.
Dialogue: 0,0:01:06.52,0:01:07.65,Default,,0,0,0,,Әлі де шайқас...
Dialogue: 0,0:01:08.35,0:01:09.94,Default,,0,0,0,,Бұл біткен жоқ!
Dialogue: 0,0:01:10.19,0:01:11.82,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:01:11.90,0:01:12.94,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:01:17.91,0:01:20.37,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:01:20.45,0:01:23.20,Default,,0,0,0,,Валькири қалпына келді.
Dialogue: 0,0:01:23.70,0:01:25.96,Default,,0,0,0,,Алға!
Dialogue: 0,0:01:33.46,0:01:36.47,Default,,0,0,0,,Тек Кербеусты қағып кете беріңіз!
Dialogue: 0,0:01:44.77,0:01:47.14,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:47.39,0:01:52.52,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:03.91,0:02:07.29,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:07.79,0:02:09.92,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:10.33,0:02:14.46,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:14.59,0:02:17.80,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:17.92,0:02:24.35,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:24.76,0:02:29.06,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:29.56,0:02:34.86,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:35.11,0:02:37.36,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:37.44,0:02:42.16,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:42.32,0:02:47.41,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:47.70,0:02:49.96,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:50.16,0:02:52.50,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:52.79,0:02:56.71,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:56.88,0:03:01.89,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:02.09,0:03:04.26,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:07.81,0:03:10.31,Default,,0,0,0,,Жарылыс! Тез ату!
Dialogue: 0,0:03:12.35,0:03:15.82,Default,,0,0,0,,Бұл жол асығыс ату!
Dialogue: 0,0:03:24.57,0:03:26.12,Default,,0,0,0,,Валькиридің шабуылы
Dialogue: 0,0:03:26.20,0:03:27.58,Default,,0,0,0,,Бұл тоқтамайды!
Dialogue: 0,0:03:29.58,0:03:30.96,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:03:34.21,0:03:36.54,Default,,0,0,0,,Оны үрлеп тастаңыз!
Dialogue: 0,0:03:36.63,0:03:38.96,Default,,0,0,0,,Раш оқ шешілді
Dialogue: 0,0:03:39.05,0:03:40.17,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:03:40.26,0:03:41.47,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:03:41.88,0:03:43.76,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:03:44.18,0:03:46.22,Default,,0,0,0,,Толық қорғалған
Dialogue: 0,0:03:48.68,0:03:50.18,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:03:50.27,0:03:53.02,Default,,0,0,0,,Кайзер Кербеус шапшаң ату шабуылы-
Dialogue: 0,0:03:53.10,0:03:54.44,Default,,0,0,0,,Барлығы тыныш.
Dialogue: 0,0:03:54.52,0:03:55.48,Default,,0,0,0,,Не!
Dialogue: 0,0:03:55.90,0:03:57.86,Default,,0,0,0,,(Келдің қорқынышсыз күлкісі)
Dialogue: 0,0:03:58.27,0:04:00.69,Default,,0,0,0,,Кербеус тізбегіне ұқсас қабат...
Dialogue: 0,0:04:01.95,0:04:04.70,Default,,0,0,0,,Біз Бейдің залалын таратып жатырмыз.
Dialogue: 0,0:04:05.24,0:04:06.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:06.62,0:04:09.99,Default,,0,0,0,,Бұл Rush Shoot жұмыс істемейді дегенді білдіре ме?
Dialogue: 0,0:04:10.54,0:04:12.33,Default,,0,0,0,,Және пресс драйвері
Dialogue: 0,0:04:12.41,0:04:14.67,Default,,0,0,0,,Стадионды мықтап ұстаңыз
Dialogue: 0,0:04:14.87,0:04:17.50,Default,,0,0,0,,Кербеустың ұшқыны дерлік өзгермейді.
Dialogue: 0,0:04:18.09,0:04:19.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:19.59,0:04:20.63,Default,,0,0,0,,Бал аға
Dialogue: 0,0:04:21.09,0:04:22.38,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:04:22.47,0:04:25.34,Default,,0,0,0,,Сербеуста жылдам түсіру жұмыс істемейді.
Dialogue: 0,0:04:25.43,0:04:29.18,Default,,0,0,0,,Жетістікке жете ме, жоқ па маңызды емес.
Dialogue: 0,0:04:29.64,0:04:31.06,Default,,0,0,0,,Барто Аои!
Dialogue: 0,0:04:31.47,0:04:33.89,Default,,0,0,0,,Қорғаныс түрі Cerbeus болып табылады
Dialogue: 0,0:04:33.98,0:04:37.77,Default,,0,0,0,,Шабуыл түрі Valkyrie - күресудің ең оңай түрі!
Dialogue: 0,0:04:37.98,0:04:39.65,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:04:39.73,0:04:41.28,Default,,0,0,0,,Сенгісіз!
Dialogue: 0,0:04:41.36,0:04:43.78,Default,,0,0,0,,Ешбір шабуыл жұмыс істемейді!
Dialogue: 0,0:04:43.86,0:04:46.70,Default,,0,0,0,,Мұны «жер асты әлемінің күзетшісі» деп те атайды.
Dialogue: 0,0:04:46.78,0:04:48.62,Default,,0,0,0,,Кайзер Сербеус!
Dialogue: 0,0:04:49.74,0:04:50.54,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:04:50.62,0:04:52.08,Default,,0,0,0,,Менің Валькириям
Dialogue: 0,0:04:52.16,0:04:53.66,Default,,0,0,0,,Тәтті көрін!
Dialogue: 0,0:04:53.91,0:04:57.08,Default,,0,0,0,,Бірақ Валькиридің шабуылдары тоқтамайды.
Dialogue: 0,0:04:57.17,0:04:58.75,Default,,0,0,0,,Шындығында, сіз оны үнемі итермелейсіз!
Dialogue: 0,0:04:58.84,0:05:00.80,Default,,0,0,0,,Асықпаңыз!
Dialogue: 0,0:05:00.88,0:05:03.13,Default,,0,0,0,,Cerbeus аздап бұлыңғыр
Dialogue: 0,0:05:03.21,0:05:05.47,Default,,0,0,0,,Сіз бірте-бірте зиян келтіресіз бе?
Dialogue: 0,0:05:05.72,0:05:08.68,Default,,0,0,0,,А... Не?! Эх!
Dialogue: 0,0:05:09.30,0:05:11.56,Default,,0,0,0,,Айналу әлсірейді!
Dialogue: 0,0:05:14.06,0:05:16.94,Default,,0,0,0,,Алға! Валькирия!
Dialogue: 0,0:05:18.81,0:05:21.07,Default,,0,0,0,,Кербе, Кербеус!
Dialogue: 0,0:05:32.58,0:05:34.83,Default,,0,0,0,,Тағы да орталықта, қатты Кербеусқа
Dialogue: 0,0:05:34.91,0:05:37.71,Default,,0,0,0,,Валькири қайта-қайта шабуыл жасайды!
Dialogue: 0,0:05:37.79,0:05:40.92,Default,,0,0,0,,Бұл төзімділік шайқасы...
Dialogue: 0,0:05:41.25,0:05:44.71,Default,,0,0,0,,Уа! Екеуінің де айналуы сәл әлсіз болды ма?
Dialogue: 0,0:05:45.09,0:05:47.43,Default,,0,0,0,,Бір сәт те айналып тұрған шығанақ
Dialogue: 0,0:05:47.51,0:05:49.68,Default,,0,0,0,,Мен екінші шайқаста жеңемін!
Dialogue: 0,0:05:50.05,0:05:51.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:58.60,0:06:00.27,Default,,0,0,0,,Жабысқақ Валькирия!
Dialogue: 0,0:06:00.61,0:06:03.19,Default,,0,0,0,,Жабысқақ болса, Cerbeus жеңілмейді!
Dialogue: 0,0:06:04.23,0:06:06.49,Default,,0,0,0,,Сербей және Валькири
Dialogue: 0,0:06:06.57,0:06:09.11,Default,,0,0,0,,Қайсысы соңына дейін айналады?
Dialogue: 0,0:06:18.25,0:06:19.79,Default,,0,0,0,,Не... не!
Dialogue: 0,0:06:19.87,0:06:22.75,Default,,0,0,0,,Айналдыру бір уақытта дерлік аяқталады!
Dialogue: 0,0:06:26.71,0:06:27.88,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:06:27.97,0:06:30.22,Default,,0,0,0,,Е! Қайсысы?
Dialogue: 0,0:06:30.30,0:06:32.39,Default,,0,0,0,,Бұл дерлік бірдей болды, солай ма?
Dialogue: 0,0:06:32.47,0:06:34.64,Default,,0,0,0,,Какитани-кун, қайсысы?
Dialogue: 0,0:06:34.72,0:06:36.72,Default,,0,0,0,,А... қайсысы...?
Dialogue: 0,0:06:36.81,0:06:39.81,Default,,0,0,0,,Сіз төрешісіз, сондықтан түсіндіңіз бе?
Dialogue: 0,0:06:39.89,0:06:41.81,Default,,0,0,0,,Құдай-ай, қандай қорқақ! Саған бірден келіп шабуыл жаса деп айтып тұрмын!
Dialogue: 0,0:06:41.90,0:06:42.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:43.82,0:06:44.44,Default,,0,0,0,,А?
Dialogue: 0,0:06:45.98,0:06:49.32,Default,,0,0,0,,Қайсысы? Қайсысы?
Dialogue: 0,0:06:54.12,0:06:56.62,Default,,0,0,0,,Бір уақытта аяқтау
Dialogue: 0,0:06:56.74,0:06:57.87,Default,,0,0,0,,Ұпайлар жоқ!
Dialogue: 0,0:06:57.95,0:07:01.33,Default,,0,0,0,,О!
Dialogue: 0,0:07:01.67,0:07:04.92,Default,,0,0,0,,Эй... бұл жағдайда не болады...?
Dialogue: 0,0:07:05.38,0:07:08.63,Default,,0,0,0,,Екінші шайқас тең, үшінші шайқас басталады.
Dialogue: 0,0:07:08.71,0:07:11.05,Default,,0,0,0,,Келіңіздер! Шайқас әлі жалғасуда!
Dialogue: 0,0:07:11.51,0:07:12.97,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:13.05,0:07:16.39,Default,,0,0,0,,Ұрыстар соңына дейін жүргізіледі!
Dialogue: 0,0:07:17.06,0:07:21.02,Default,,0,0,0,,Бірақ... інім 1 ұпай ұтылды...
Dialogue: 0,0:07:21.77,0:07:23.40,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Бар-нии!
Dialogue: 0,0:07:23.48,0:07:24.61,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:07:25.06,0:07:27.57,Default,,0,0,0,,Валькири, сен керемет жұмыс жасадың.
Dialogue: 0,0:07:28.69,0:07:31.82,Default,,0,0,0,,Мен шапшаң соққы жасадым, бірақ дұрыс атамадым...
Dialogue: 0,0:07:31.90,0:07:33.41,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:07:33.49,0:07:35.87,Default,,0,0,0,,Амалсыз шайқасты.
Dialogue: 0,0:07:36.28,0:07:38.87,Default,,0,0,0,,Бұл мені бақытты етеді! Досым!
Dialogue: 0,0:07:41.37,0:07:44.71,Default,,0,0,0,,Бұл жолы мен керемет соққы жасаймын!
Dialogue: 0,0:07:45.04,0:07:45.92,Default,,0,0,0,,…Ах
Dialogue: 0,0:07:46.25,0:07:48.30,Default,,0,0,0,,Барто Аои!
Dialogue: 0,0:07:48.38,0:07:50.76,Default,,0,0,0,,Тағы да асығыс ату туралы мәлімдеме!
Dialogue: 0,0:07:50.84,0:07:54.93,Default,,0,0,0,,Үшінші шайқас та оқ ату болатынын болжадым.
Dialogue: 0,0:07:55.01,0:07:57.72,Default,,0,0,0,,Бұл жолы ол мүлдем мінсіз болады.
Dialogue: 0,0:07:58.10,0:07:59.77,Default,,0,0,0,,Мен оны сәтті орындаймын
Dialogue: 0,0:08:00.06,0:08:03.14,Default,,0,0,0,,Әлгі ақымақ мүлде ақымақ.
Dialogue: 0,0:08:03.23,0:08:05.77,Default,,0,0,0,,Қарсыласыңыздың дәл осындай қозғалыспен келе жатқанын түсінгенде
Dialogue: 0,0:08:05.86,0:08:07.94,Default,,0,0,0,,Қандай жағдай болмасын қарсы шараларды қолдануға болады.
Dialogue: 0,0:08:08.02,0:08:11.03,Default,,0,0,0,,Алдын ала мәлімдеме блеф болуы мүмкін
Dialogue: 0,0:08:11.57,0:08:15.66,Default,,0,0,0,,Бір клеткалы ақымақ психологиялық соғыс жүргізе алмайды.
Dialogue: 0,0:08:16.03,0:08:17.99,Default,,0,0,0,,Балтық бұқарасы
Dialogue: 0,0:08:18.08,0:08:19.91,Default,,0,0,0,,Керек емес сөздер айтасың!
Dialogue: 0,0:08:20.29,0:08:21.83,Default,,0,0,0,,Онсыз да қолайсыз қарсыласқа қарсы
Dialogue: 0,0:08:21.91,0:08:24.29,Default,,0,0,0,,Пайдалы ақпаратты бермеңіз
Dialogue: 0,0:08:24.37,0:08:26.96,Default,,0,0,0,,Жақсырақ жоспар ойлап тап, Бал-нии!
Dialogue: 0,0:08:27.04,0:08:27.96,Default,,0,0,0,,Бұл ысырап...
Dialogue: 0,0:08:28.04,0:08:28.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:29.63,0:08:32.09,Default,,0,0,0,,Балто дәл қазір ештеңе естімейді...
Dialogue: 0,0:08:32.72,0:08:35.34,Default,,0,0,0,,Менің алдымда тек Валькирия ғана...
Dialogue: 0,0:08:35.43,0:08:36.97,Default,,0,0,0,,Ол оны көре алмайды.
Dialogue: 0,0:08:37.18,0:08:38.47,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:08:38.55,0:08:41.35,Default,,0,0,0,,Мен жылдам соққы жасаймын!
Dialogue: 0,0:08:43.35,0:08:44.52,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:08:44.60,0:08:45.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:45.52,0:08:46.69,Default,,0,0,0,,Мұнан кеттік.
Dialogue: 0,0:08:46.77,0:08:48.61,Default,,0,0,0,,Бұл Балтоның жаман әдеті...
Dialogue: 0,0:08:48.69,0:08:49.86,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:08:49.94,0:08:51.94,Default,,0,0,0,,Мен тағы да қобалжыдым...
Dialogue: 0,0:08:52.32,0:08:54.86,Default,,0,0,0,,Менімен бірге жасаған кездегідей емес пе...
Dialogue: 0,0:08:55.28,0:08:57.87,Default,,0,0,0,,Бұл өспейді! Бұл керемет!
Dialogue: 0,0:08:59.45,0:09:01.41,Default,,0,0,0,,Мен... Мен шешемін...!
Dialogue: 0,0:09:03.29,0:09:05.92,Default,,0,0,0,,Ах! Ах! Ой, уау~
Dialogue: 0,0:09:06.00,0:09:08.71,Default,,0,0,0,,Уау уау уау~
Dialogue: 0,0:09:08.79,0:09:10.80,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:10.88,0:09:13.17,Default,,0,0,0,,Басыңыздан буды кетіріңіз!
Dialogue: 0,0:09:14.09,0:09:16.09,Default,,0,0,0,,Тағы бір сәтсіз ату?
Dialogue: 0,0:09:16.84,0:09:21.14,Default,,0,0,0,,Ең биікке көтерілетіні - екі қолды қуыршақ Yarrow...
Dialogue: 0,0:09:21.68,0:09:23.27,Default,,0,0,0,,Қарғыс атсын! Цуцуцу…
Dialogue: 0,0:09:23.72,0:09:25.52,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:09:26.35,0:09:26.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:27.19,0:09:30.31,Default,,0,0,0,,(Көрермен) Ол барып оны қоздырып, соққыға жығылды.
Dialogue: 0,0:09:32.32,0:09:34.24,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:09:34.32,0:09:35.78,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:09:36.24,0:09:37.11,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:37.20,0:09:38.28,Default,,0,0,0,,Барт
Dialogue: 0,0:09:38.36,0:09:41.53,Default,,0,0,0,,Балто! Балтық! Кенсуке! Кенсуке!
Dialogue: 0,0:09:41.74,0:09:48.50,Default,,0,0,0,,(аудиторияны қолдау)
Dialogue: 0,0:09:52.34,0:09:56.63,Default,,0,0,0,,Балто! Балтық! Кенсуке! Кенсуке!
Dialogue: 0,0:09:57.05,0:09:59.59,Default,,0,0,0,,Бауырым, босаң, босаң!
Dialogue: 0,0:09:59.68,0:10:01.72,Default,,0,0,0,,Иә! Егер бұл кәдімгі Бар-нии болса...
Dialogue: 0,0:10:01.80,0:10:03.60,Default,,0,0,0,,Ондай шығанақ жау емес!
Dialogue: 0,0:10:03.93,0:10:04.89,Default,,0,0,0,,Барт
Dialogue: 0,0:10:04.97,0:10:06.60,Default,,0,0,0,,Сабыр ет, сабыр ет!
Dialogue: 0,0:10:08.56,0:10:10.23,Default,,0,0,0,,О! Маған қалдырыңыз!
Dialogue: 0,0:10:10.31,0:10:11.81,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:10:12.15,0:10:14.40,Default,,0,0,0,,Әй, ағам мұны көрді.
Dialogue: 0,0:10:14.48,0:10:16.07,Default,,0,0,0,,Мен естідім! Мен естідім!
Dialogue: 0,0:10:16.40,0:10:17.65,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:10:17.74,0:10:19.41,Default,,0,0,0,,Іс тынышталған сияқты.
Dialogue: 0,0:10:19.49,0:10:21.24,Default,,0,0,0,,Мұның бәрі менің арқам.
Dialogue: 0,0:10:28.00,0:10:29.33,Default,,0,0,0,,Екеуі де Алдыңғы
Dialogue: 0,0:10:31.50,0:10:35.05,Default,,0,0,0,,Валькирия Біз бірге не істедік
Dialogue: 0,0:10:35.13,0:10:37.09,Default,,0,0,0,,Оны сол күйінде шығарған дұрыс.
Dialogue: 0,0:10:37.47,0:10:38.30,Default,,0,0,0,,♬~
Dialogue: 0,0:10:38.38,0:10:41.47,Default,,0,0,0,,Бұл жолы мен сізге мінсіз қорғанысымды көрсетемін!
Dialogue: 0,0:10:41.55,0:10:43.01,Default,,0,0,0,,Мен жекпе-жекке шығамын!
Dialogue: 0,0:10:43.10,0:10:45.43,Default,,0,0,0,,Мен айналдырумен жеңемін.
Dialogue: 0,0:10:47.64,0:10:49.06,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:10:49.64,0:10:51.10,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:10:55.44,0:10:57.32,Default,,0,0,0,,Егер мен қайтадан сәтсіздікке ұшырасам
Dialogue: 0,0:10:57.40,0:10:59.78,Default,,0,0,0,,Сіз мені өшіре жаздаңыз.
Dialogue: 0,0:10:59.86,0:11:00.61,Default,,0,0,0,,Дос
Dialogue: 0,0:11:11.21,0:11:13.42,Default,,0,0,0,,Енді, Мидорикава Инусуке...
Dialogue: 0,0:11:13.50,0:11:16.13,Default,,0,0,0,,Үшінші жекпе-жек 1 ұпаймен алға шықты
Dialogue: 0,0:11:16.21,0:11:17.88,Default,,0,0,0,,Бұл ақыры басталды!
Dialogue: 0,0:11:19.26,0:11:21.09,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:11:21.72,0:11:24.85,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:25.30,0:11:27.22,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:33.31,0:11:35.11,Default,,0,0,0,,Алға!
Dialogue: 0,0:11:35.19,0:11:36.48,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:11:36.57,0:11:38.90,Default,,0,0,0,,Қабат стадионға әрең тиіп тұр
Dialogue: 0,0:11:38.98,0:11:40.78,Default,,0,0,0,,Бұл құлайтын сияқты!
Dialogue: 0,0:11:45.83,0:11:47.66,Default,,0,0,0,,Алға!
Dialogue: 0,0:11:56.34,0:11:57.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:57.29,0:11:58.09,Default,,0,0,0,,Ах~
Dialogue: 0,0:11:58.17,0:11:59.21,Default,,0,0,0,,Құлау~
Dialogue: 0,0:12:01.88,0:12:02.80,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:03.30,0:12:04.18,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:12:04.30,0:12:06.22,Default,,0,0,0,,Валькири құламайды
Dialogue: 0,0:12:06.30,0:12:07.56,Default,,0,0,0,,Ұстау
Dialogue: 0,0:12:08.01,0:12:11.02,Default,,0,0,0,,Түсіру бұрышы тым терең болып көрінеді.
Dialogue: 0,0:12:11.10,0:12:13.64,Default,,0,0,0,,Күшті түсіру күшін жасайды
Dialogue: 0,0:12:14.27,0:12:15.90,Default,,0,0,0,,Төменгі күш?
Dialogue: 0,0:12:16.23,0:12:18.36,Default,,0,0,0,,Айналу нәтижесінде пайда болатын ауа ағыны
Dialogue: 0,0:12:18.44,0:12:19.82,Default,,0,0,0,,Күшті күшпен-
Dialogue: 0,0:12:19.90,0:12:22.19,Default,,0,0,0,,Бейді стадионға итермелеу
Dialogue: 0,0:12:22.61,0:12:23.99,Default,,0,0,0,,Айнымалы драйвер...
Dialogue: 0,0:12:24.07,0:12:26.57,Default,,0,0,0,,Ол стадионға мықтап бекітілген.
Dialogue: 0,0:12:27.37,0:12:28.83,Default,,0,0,0,,Жылдамдық қайтадан артты...
Dialogue: 0,0:12:29.24,0:12:30.54,Default,,0,0,0,,Керемет!
Dialogue: 0,0:12:30.62,0:12:32.50,Default,,0,0,0,,Тек алға!
Dialogue: 0,0:12:33.21,0:12:34.71,Default,,0,0,0,,Бірінші байланыс!
Dialogue: 0,0:12:34.79,0:12:36.88,Default,,0,0,0,,Валькири қатты итеріп кетті.
Dialogue: 0,0:12:36.96,0:12:39.59,Default,,0,0,0,,Бұл Кайзер Сербеус үшін де жұмыс істеді ме?
Dialogue: 0,0:12:39.67,0:12:41.30,Default,,0,0,0,,Тау көшті!
Dialogue: 0,0:12:42.01,0:12:45.18,Default,,0,0,0,,Алға! Валькирия!
Dialogue: 0,0:12:48.18,0:12:49.51,Default,,0,0,0,,Керемет
Dialogue: 0,0:12:49.60,0:12:51.56,Default,,0,0,0,,Бұл тамаша асығыс ату.
Dialogue: 0,0:12:51.64,0:12:53.64,Default,,0,0,0,,Валькирияның қарқынды шабуылы
Dialogue: 0,0:12:53.73,0:12:55.69,Default,,0,0,0,,Кербеусқа жақындау!
Dialogue: 0,0:12:58.06,0:13:00.94,Default,,0,0,0,,Ах! Cerbeus таң қалды!
Dialogue: 0,0:13:01.03,0:13:04.86,Default,,0,0,0,,Тау...Кербей тауы қозғалуын жалғастыруда!
Dialogue: 0,0:13:06.70,0:13:08.49,Default,,0,0,0,,Taero Cerbeus
Dialogue: 0,0:13:08.57,0:13:11.20,Default,,0,0,0,,Орталықты алсаңыз, ол осында~
Dialogue: 0,0:13:11.58,0:13:14.71,Default,,0,0,0,,Бұл маңызды емес. Тез түсірілім
Dialogue: 0,0:13:14.79,0:13:16.50,Default,,0,0,0,,(ДжоДжо) Сен қалай епті қозғалатыныңды көрсем—
Dialogue: 0,0:13:16.58,0:13:18.00,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:13:21.80,0:13:25.51,Default,,0,0,0,,Ой, Кербеустың айналуы бірте-бірте баяулайды!
Dialogue: 0,0:13:25.59,0:13:28.51,Default,,0,0,0,,Мен Валькиридің шабуылынан аман қала алмадым.
Dialogue: 0,0:13:29.51,0:13:32.06,Default,,0,0,0,,Сербей қатты әсер етті...
Dialogue: 0,0:13:32.14,0:13:33.93,Default,,0,0,0,,Айналмалы дөңгелек шайқалды!
Dialogue: 0,0:13:34.02,0:13:36.77,Default,,0,0,0,,Түсіндім! Бұл керемет, Бар-нии!
Dialogue: 0,0:13:36.98,0:13:39.44,Default,,0,0,0,,Қарсылақ атудың жылдамдығы жеңді.
Dialogue: 0,0:13:39.69,0:13:41.82,Default,,0,0,0,,Балтық жігіті
Dialogue: 0,0:13:42.57,0:13:44.36,Default,,0,0,0,,Cerbeus баспасөз драйвері
Dialogue: 0,0:13:44.44,0:13:46.20,Default,,0,0,0,,Сіз шыдай аласыз ба?
Dialogue: 0,0:13:48.78,0:13:50.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:50.82,0:13:53.24,Default,,0,0,0,,Cerbeus!
Dialogue: 0,0:13:54.58,0:13:59.83,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:14:01.67,0:14:03.67,Default,,0,0,0,,Алға!
Dialogue: 0,0:14:03.75,0:14:06.01,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:14:07.30,0:14:09.59,Default,,0,0,0,,
Dialogue: 0,0:14:14.27,0:14:16.81,Default,,0,0,0,,(шұңқырлар соқтығысқан дыбыс)
Dialogue: 0,0:14:21.56,0:14:24.23,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:14:29.20,0:14:30.95,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:14:31.07,0:14:34.66,Default,,0,0,0,,Cerbeus жарылып кетті!
Dialogue: 0,0:14:35.91,0:14:36.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:38.16,0:14:39.67,Default,,0,0,0,,Ng...
Dialogue: 0,0:14:39.75,0:14:41.42,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:14:41.50,0:14:43.04,Default,,0,0,0,,2 ұпай жинау
Dialogue: 0,0:14:43.13,0:14:45.88,Default,,0,0,0,,Барто Аои 2-1 жеңді!
Dialogue: 0,0:14:45.96,0:14:50.13,Default,,0,0,0,,Валькирияның жеңісі қандай үлкен жеңіс!
Dialogue: 0,0:14:50.22,0:14:52.22,Default,,0,0,0,,А... а...
Dialogue: 0,0:14:53.51,0:14:54.68,Default,,0,0,0,,Мен жеңдім...
Dialogue: 0,0:14:57.18,0:14:58.48,Default,,0,0,0,,Бал-нии жеңді!
Dialogue: 0,0:14:58.56,0:14:59.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:59.60,0:15:02.02,Default,,0,0,0,,Әлгі ақымақ Балт...
Dialogue: 0,0:15:02.10,0:15:03.52,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:15:04.19,0:15:06.19,Default,,0,0,0,,Мұндағы ең жақсы концентрация
Dialogue: 0,0:15:06.65,0:15:07.82,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:15:08.49,0:15:09.70,Default,,0,0,0,,Өте рахмет! (Ол Майт) Ахахаха!
Dialogue: 0,0:15:09.78,0:15:11.78,Default,,0,0,0,,Оны Бей жақсы көреді.
Dialogue: 0,0:15:16.41,0:15:18.75,Default,,0,0,0,,Рахмет сізге Валькири
Dialogue: 0,0:15:21.33,0:15:26.34,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:15:26.42,0:15:28.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:28.67,0:15:31.72,Default,,0,0,0,,Барто Аои үшінші раундқа өтті!
Dialogue: 0,0:15:31.80,0:15:34.14,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:15:34.22,0:15:35.22,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:15:38.22,0:15:39.43,Default,,0,0,0,,Мен жеңілдім...
Dialogue: 0,0:15:39.85,0:15:41.89,Default,,0,0,0,,Менің Кербеусым...
Dialogue: 0,0:15:43.15,0:15:44.69,Default,,0,0,0,,Қандай жігіт...
Dialogue: 0,0:15:44.77,0:15:46.23,Default,,0,0,0,,Барто Аои…
Dialogue: 0,0:15:47.98,0:15:49.15,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:15:49.57,0:15:52.36,Default,,0,0,0,,Мен күтпеген серіктесті таңдадым.
Dialogue: 0,0:15:52.45,0:15:55.12,Default,,0,0,0,,Маған қарсыластың кім екені маңызды емес.
Dialogue: 0,0:15:55.74,0:15:57.58,Default,,0,0,0,,Валькири - Бей
Dialogue: 0,0:15:57.66,0:15:59.45,Default,,0,0,0,,Бұл біраз қызықты шығанақ.
Dialogue: 0,0:15:59.79,0:16:01.91,Default,,0,0,0,,Шұңқырдың тек екі түрі бар.
Dialogue: 0,0:16:02.33,0:16:03.67,Default,,0,0,0,,Бей жеңе ме?
Dialogue: 0,0:16:03.75,0:16:05.04,Default,,0,0,0,,Бей жеңіледі
Dialogue: 0,0:16:05.58,0:16:08.25,Default,,0,0,0,,Қайсысы Динаның шығанағы болар екен...
Dialogue: 0,0:16:08.84,0:16:11.17,Default,,0,0,0,,Мен... жеңдім!
Dialogue: 0,0:16:16.51,0:16:17.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:18.89,0:16:20.22,Default,,0,0,0,,Қол алысайық
Dialogue: 0,0:16:20.68,0:16:23.23,Default,,0,0,0,,А... Ақшу...?
Dialogue: 0,0:16:23.31,0:16:26.15,Default,,0,0,0,,Сіз осындай нәрсе жасайсыз ба? Сізбен бірге!
Dialogue: 0,0:16:26.23,0:16:28.86,Default,,0,0,0,,Мен ешқашан Ақш сияқты нәрсені жасамас едім.
Dialogue: 0,0:16:28.94,0:16:30.65,Default,,0,0,0,,Ұялмаңыз!
Dialogue: 0,0:16:31.69,0:16:33.07,Default,,0,0,0,,Ааа~!
Dialogue: 0,0:16:33.78,0:16:34.78,Default,,0,0,0,,А...
Dialogue: 0,0:16:34.86,0:16:36.99,Default,,0,0,0,,Мына қуыршақпен осылай болды.
Dialogue: 0,0:16:37.07,0:16:40.49,Default,,0,0,0,,Не... Не істеп жатырсың? Маған Бетті қайтар!
Dialogue: 0,0:16:40.58,0:16:42.75,Default,,0,0,0,,Біраз жақсы, солай ма?
Dialogue: 0,0:16:42.83,0:16:44.12,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:16:44.21,0:16:46.08,Default,,0,0,0,,Жақсы, қайтарыңыз.
Dialogue: 0,0:16:46.17,0:16:47.21,Default,,0,0,0,,Қызықты
Dialogue: 0,0:16:47.29,0:16:49.46,Default,,0,0,0,,Ақымақ болма, қайтарып бер Хехе
Dialogue: 0,0:16:51.76,0:16:54.38,Default,,0,0,0,,Бұл екеуі не істеп жатыр...
Dialogue: 0,0:16:54.47,0:16:56.14,Default,,0,0,0,,Олар ойнап жатқан сияқты...
Dialogue: 0,0:16:56.22,0:16:58.14,Default,,0,0,0,,Біз қазірдің өзінде доспыз.
Dialogue: 0,0:16:58.43,0:17:01.10,Default,,0,0,0,,Менің ағам достасуда данышпан.
Dialogue: 0,0:17:02.98,0:17:03.93,Default,,0,0,0,,♬~
Dialogue: 0,0:17:04.02,0:17:05.85,Default,,0,0,0,,Мені қобалжытпа!
Dialogue: 0,0:17:06.35,0:17:10.15,Default,,0,0,0,,Мен оны керемет етіп көрсетуге тырыстым, бірақ мен оған тым көп күш жұмсадым.
Dialogue: 0,0:17:10.23,0:17:11.73,Default,,0,0,0,,Мұның несі керемет!
Dialogue: 0,0:17:11.82,0:17:14.70,Default,,0,0,0,,Мені ұрғандардың көбі Магур болды.
Dialogue: 0,0:17:14.78,0:17:16.57,Default,,0,0,0,,Мұндай нәрсе ақылға сыймайды
Dialogue: 0,0:17:16.66,0:17:18.74,Default,,0,0,0,,Magure дегеніміз не?
Dialogue: 0,0:17:18.82,0:17:22.54,Default,,0,0,0,,Түсіндім, Кумичо, сенің менен жеңілгенің ұят.
Dialogue: 0,0:17:22.62,0:17:23.95,Default,,0,0,0,,Не?!
Dialogue: 0,0:17:24.04,0:17:24.91,Default,,0,0,0,,Не!?
Dialogue: 0,0:17:25.00,0:17:26.83,Default,,0,0,0,,Фуфуфуфу
Dialogue: 0,0:17:27.33,0:17:29.84,Default,,0,0,0,,А, Шуу-кун, барыңды сал.
Dialogue: 0,0:17:30.21,0:17:32.96,Default,,0,0,0,,Шудың матчы келесі болды.
Dialogue: 0,0:17:33.05,0:17:34.21,Default,,0,0,0,,Жоғалтып алмаңыз!
Dialogue: 0,0:17:34.38,0:17:35.42,Default,,0,0,0,,О
Dialogue: 0,0:17:35.67,0:17:37.59,Default,,0,0,0,,Оның жеңіліп қалуы мүмкін емес.
Dialogue: 0,0:17:37.68,0:17:39.60,Default,,0,0,0,,Бакабалттан айырмашылығы.
Dialogue: 0,0:17:39.68,0:17:40.72,Default,,0,0,0,,Не?!
Dialogue: 0,0:17:40.80,0:17:42.31,Default,,0,0,0,,Не?!
Dialogue: 0,0:17:42.39,0:17:43.93,Default,,0,0,0,,Му~!
Dialogue: 0,0:17:44.52,0:17:47.56,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:17:47.64,0:17:49.15,Default,,0,0,0,,Блок 2-тур
Dialogue: 0,0:17:49.23,0:17:51.27,Default,,0,0,0,,Екінші матч басталады!
Dialogue: 0,0:17:51.36,0:17:53.53,Default,,0,0,0,,Пайда болған қылшықтар...
Dialogue: 0,0:17:53.61,0:17:54.99,Default,,0,0,0,,Куроками Динамен
Dialogue: 0,0:17:55.07,0:17:57.15,Default,,0,0,0,,Бұл Некота Мелос!
Dialogue: 0,0:17:58.70,0:17:59.99,Default,,0,0,0,,Өлімді анықтаушы
Dialogue: 0,0:18:00.28,0:18:01.95,Default,,0,0,0,,Мен бірнеше секундтан кейін шешемін!
Dialogue: 0,0:18:02.79,0:18:05.25,Default,,0,0,0,,Dark Death Sizeer шабуыл түрі болып табылады.
Dialogue: 0,0:18:05.50,0:18:07.62,Default,,0,0,0,,Мина қорғаныс түрі болып табылады.
Dialogue: 0,0:18:07.71,0:18:08.87,Default,,0,0,0,,Сөз жоқ
Dialogue: 0,0:18:08.96,0:18:10.33,Default,,0,0,0,,Мен үшін тиімді
Dialogue: 0,0:18:10.71,0:18:14.17,Default,,0,0,0,,Шабуыл түрі мен қорғаныс түрі арасындағы шайқас
Dialogue: 0,0:18:14.25,0:18:16.92,Default,,0,0,0,,Кездейсоқ, бұл бірінші сәйкестікпен бірдей комбинация.
Dialogue: 0,0:18:17.76,0:18:19.64,Default,,0,0,0,,Тіпті бірдей шабуыл түрімен
Dialogue: 0,0:18:19.72,0:18:22.97,Default,,0,0,0,,My Dark Death Sizer өте күшті.
Dialogue: 0,0:18:23.43,0:18:24.89,Default,,0,0,0,,Мен сізге айырмашылықты көрсетемін
Dialogue: 0,0:18:25.68,0:18:29.10,Default,,0,0,0,,Тағы бір таңғажайып сыпайы мыңжапырақ пайда болды!
Dialogue: 0,0:18:29.19,0:18:31.98,Default,,0,0,0,,Бірақ... бұл шынымен күшті көрінеді, солай емес пе?
Dialogue: 0,0:18:32.06,0:18:34.15,Default,,0,0,0,,(планшеттің жанасу дыбысы)
Dialogue: 0,0:18:34.23,0:18:38.07,Default,,0,0,0,,Е! Бірінші раунд 10 секундта жеңіске жетті!
Dialogue: 0,0:18:39.03,0:18:40.61,Default,,0,0,0,,5 секунд жеткілікті
Dialogue: 0,0:18:41.37,0:18:42.74,Default,,0,0,0,,О!
Dialogue: 0,0:18:42.83,0:18:45.54,Default,,0,0,0,,Дина Курокамидің бірнеше секунд ішінде өлтіру туралы мәлімдемесі жарияланды!
Dialogue: 0,0:18:45.62,0:18:46.95,Default,,0,0,0,,Бұл бар болғаны 5 секунд!
Dialogue: 0,0:18:47.20,0:18:48.41,Default,,0,0,0,,5 секунд…
Dialogue: 0,0:18:49.12,0:18:50.54,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:50.62,0:18:52.96,Default,,0,0,0,,Уф~ 5 секунд нешеге тең?
Dialogue: 0,0:18:53.04,0:18:55.13,Default,,0,0,0,,Менің шығанақты мазақ етіп тұрсың ба?
Dialogue: 0,0:18:55.21,0:18:57.05,Default,,0,0,0,,Мен тек шындықты айттым.
Dialogue: 0,0:18:57.80,0:18:58.80,Default,,0,0,0,,Куу~
Dialogue: 0,0:18:59.01,0:19:01.05,Default,,0,0,0,,Енді шайқас басталмай тұрып басталады.
Dialogue: 0,0:19:01.14,0:19:02.76,Default,,0,0,0,,Ол қызып жатыр.
Dialogue: 0,0:19:02.85,0:19:05.18,Default,,0,0,0,,Психологиялық соғыс басталып та кетті
Dialogue: 0,0:19:05.97,0:19:07.72,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:19:08.35,0:19:09.48,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:19:09.56,0:19:11.23,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:19:12.23,0:19:14.73,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:15.02,0:19:17.28,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:22.57,0:19:23.16,Default,,0,0,0,,(Bey Burst дыбысы)
Dialogue: 0,0:19:23.24,0:19:25.33,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:19:25.41,0:19:27.45,Default,,0,0,0,,Мен оны бір соққымен түсірдім!
Dialogue: 0,0:19:28.25,0:19:29.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:29.50,0:19:30.50,Default,,0,0,0,,Қараңғы өлім өлшемі
Dialogue: 0,0:19:30.58,0:19:32.04,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:19:32.25,0:19:35.21,Default,,0,0,0,,Дина Курогами 2-0 жеңді!
Dialogue: 0,0:19:36.04,0:19:37.05,Default,,0,0,0,,Не!
Dialogue: 0,0:19:37.13,0:19:40.22,Default,,0,0,0,,Болжағандай, бұл небәрі 5 секундта өлтірілді!
Dialogue: 0,0:19:40.55,0:19:43.43,Default,,0,0,0,,5 секундта мәреге жету – турнир рекорды!
Dialogue: 0,0:19:44.55,0:19:47.47,Default,,0,0,0,,Ғажайып, ғажап, әлгі жігіт ғажап!
Dialogue: 0,0:19:47.56,0:19:50.64,Default,,0,0,0,,Уәде етілгендей мен оны секундтарда өлтірдім!
Dialogue: 0,0:19:50.73,0:19:52.27,Default,,0,0,0,,Салқын
Dialogue: 0,0:19:52.35,0:19:56.36,Default,,0,0,0,,Мен одан да көп күресуді асыға күте бастадым!
Dialogue: 0,0:19:57.15,0:20:01.53,Default,,0,0,0,,Бұл жеңудің ақылсыз жолы болды.
Dialogue: 0,0:20:02.24,0:20:05.07,Default,,0,0,0,,Мен де бір күні солай істеймін...
Dialogue: 0,0:20:05.41,0:20:07.24,Default,,0,0,0,,Мен бұл туралы таң қалдым.
Dialogue: 0,0:20:07.58,0:20:10.75,Default,,0,0,0,,Уай шығанағы жабайы Вайверн күшті...
Dialogue: 0,0:20:10.83,0:20:12.16,Default,,0,0,0,,Соңында соққы алмасқан адамның сен болғаныңа қуаныштымын
Dialogue: 0,0:20:12.25,0:20:13.42,Default,,0,0,0,,Не?
Dialogue: 0,0:20:14.58,0:20:16.79,Default,,0,0,0,,5 секундта тағы бір рет
Dialogue: 0,0:20:16.88,0:20:19.84,Default,,0,0,0,,Қарсыласыңыздың шығанағын жарып аяқтаңыз!
Dialogue: 0,0:20:19.92,0:20:23.47,Default,,0,0,0,,Дина Курокамидің ертерек аяқтау уақытымен бірдей.
Dialogue: 0,0:20:24.05,0:20:26.05,Default,,0,0,0,,Жеңіске ықтимал үміткер
Dialogue: 0,0:20:26.14,0:20:28.31,Default,,0,0,0,,Қырмызы Шудың дауылы Спригган
Dialogue: 0,0:20:28.39,0:20:30.31,Default,,0,0,0,,Керемет күш!
Dialogue: 0,0:20:31.02,0:20:32.56,Default,,0,0,0,,Шу-кун!
Dialogue: 0,0:20:32.64,0:20:34.39,Default,,0,0,0,,Өте керемет!
Dialogue: 0,0:20:34.48,0:20:36.06,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:20:36.15,0:20:38.11,Default,,0,0,0,,Шу-кун күшті ғой.
Dialogue: 0,0:20:38.19,0:20:39.98,Default,,0,0,0,,Балт та жеңді...
Dialogue: 0,0:20:40.07,0:20:42.11,Default,,0,0,0,,Менің мектебім керемет, солай емес пе?
Dialogue: 0,0:20:42.19,0:20:45.20,Default,,0,0,0,,Менің ойымша, мұның бәрі Барто үшін.
Dialogue: 0,0:20:45.28,0:20:46.24,Default,,0,0,0,,(ащы күлімсіреу)
Dialogue: 0,0:20:48.49,0:20:50.37,Default,,0,0,0,,Иттің серіктесі болу-
Dialogue: 0,0:20:50.45,0:20:52.04,Default,,0,0,0,,Тек Бенишу
Dialogue: 0,0:20:52.54,0:20:55.00,Default,,0,0,0,,Мен финалды асыға күтемін.
Dialogue: 0,0:20:59.50,0:21:01.55,Default,,0,0,0,,Әй, Шуу!
Dialogue: 0,0:21:01.88,0:21:04.22,Default,,0,0,0,,Сіз кереметсіз!
Dialogue: 0,0:21:04.30,0:21:07.05,Default,,0,0,0,,Сіз соншалықты көп жаттығу жасағаныңыз таңқаларлық емес!
Dialogue: 0,0:21:07.14,0:21:09.47,Default,,0,0,0,,Маған қатты әсер қалдырды!
Dialogue: 0,0:21:09.97,0:21:10.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:11.27,0:21:14.64,Default,,0,0,0,,Өйткені, менің қарсыластарыма ғана болатын нәрселер бар!
Dialogue: 0,0:21:14.89,0:21:16.90,Default,,0,0,0,,Қарсыластардың болғаны жақсы.
Dialogue: 0,0:21:17.73,0:21:20.57,Default,,0,0,0,,Ұрыс кезінде бір-бірін...
Dialogue: 0,0:21:21.94,0:21:23.49,Default,,0,0,0,,Тат...тут...
Dialogue: 0,0:21:23.57,0:21:25.36,Default,,0,0,0,,Хмм…
Dialogue: 0,0:21:25.45,0:21:26.74,Default,,0,0,0,,Бірін-бірі ұлғайту
Dialogue: 0,0:21:27.20,0:21:28.62,Default,,0,0,0,,Иә, солай!
Dialogue: 0,0:21:28.70,0:21:30.49,Default,,0,0,0,,Дехехехехе
Dialogue: 0,0:21:30.58,0:21:32.12,Default,,0,0,0,,Біз бір-бірімізбен сондай биік болдық
Dialogue: 0,0:21:32.20,0:21:34.41,Default,,0,0,0,,Олар финалда соқтығысады!
Dialogue: 0,0:21:34.50,0:21:37.42,Default,,0,0,0,,Жарайды, жарайды, менің қарсыласым ең жақсы!
Dialogue: 0,0:21:37.50,0:21:39.21,Default,,0,0,0,,Мені ұмытпа!
Dialogue: 0,0:21:39.29,0:21:41.96,Default,,0,0,0,,О! Біз бәріміз қарсыласпыз!
Dialogue: 0,0:21:42.05,0:21:43.13,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:43.21,0:21:44.46,Default,,0,0,0,,Өз еркімен шешім қабылдамаңыз
Dialogue: 0,0:21:44.55,0:21:46.01,Default,,0,0,0,,Бұл жақсы, бұл жақсы
Dialogue: 0,0:21:46.09,0:21:48.01,Default,,0,0,0,,Осындай нәрселерді шешіңіз!
Dialogue: 0,0:21:48.47,0:21:49.93,Default,,0,0,0,,Бейбатл дегеніміз не?
Dialogue: 0,0:21:51.18,0:21:53.56,Default,,0,0,0,,Бұл өте қызық!
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Артынан қусаң көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.36,0:23:28.78,Default,,0,0,0,,Мен керемет нәрсе ойлап таптым.
Dialogue: 0,0:23:28.86,0:23:31.53,Default,,0,0,0,,Мектепте Бейблейд клубын ашыңыз.
Dialogue: 0,0:23:31.61,0:23:33.95,Default,,0,0,0,,Сонда сіз кез келген уақытта жаттығуға болады!
Dialogue: 0,0:23:34.03,0:23:36.08,Default,,0,0,0,,Алдымен мүшелерді жинайық!
Dialogue: 0,0:23:36.16,0:23:38.91,Default,,0,0,0,,Мақсат 5 адам, жоқ, 10 адам, жоқ, 100 адам
Dialogue: 0,0:23:39.00,0:23:40.58,Default,,0,0,0,,10 миллиард адам!
Dialogue: 0,0:23:41.29,0:23:43.17,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.25,0:23:45.54,Default,,0,0,0,,Бейблейд клубын жасайық!
Dialogue: 0,0:23:45.63,0:23:47.71,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.80,0:23:49.71,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.21,0:23:57.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory