Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.50,0:00:09.17,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.25,0:00:12.51,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.67,0:00:14.68,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.76,0:00:16.93,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.01,0:00:18.68,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.06,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.14,0:00:26.15,Default,,0,0,0,,Бейде арманмен күрес
Dialogue: 0,0:00:26.23,0:00:28.73,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:32.57,0:00:35.61,Default,,0,0,0,,Республикалық турнир командалық сайыс 2-тур
Dialogue: 0,0:00:35.86,0:00:38.83,Default,,0,0,0,,Yonekoma Academy Bay клубындағы біздің қарсыласымыз...
Dialogue: 0,0:00:38.91,0:00:41.33,Default,,0,0,0,,Шақаның командасының қылыш жалыны
Dialogue: 0,0:00:41.41,0:00:42.95,Default,,0,0,0,,Шақа мен оның достары күшті жауларға толы...
Dialogue: 0,0:00:43.04,0:00:45.58,Default,,0,0,0,,Біз оны жан-жақты шайқаста жеңдік.
Dialogue: 0,0:00:45.87,0:00:47.92,Default,,0,0,0,,Бірақ... Шу үлкен табысқа жетті...
Dialogue: 0,0:00:48.00,0:00:49.25,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:49.50,0:00:51.25,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,0:00:51.38,0:00:53.55,Default,,0,0,0,,Жоқ, бұл маңызды мәселе емес.
Dialogue: 0,0:00:54.05,0:00:55.72,Default,,0,0,0,,Ол дерлік сауығып кетуі керек.
Dialogue: 0,0:00:56.09,0:00:57.68,Default,,0,0,0,,Матчтан кейін -
Dialogue: 0,0:00:57.76,0:00:59.39,Default,,0,0,0,,Мен Шуды іздедім
Dialogue: 0,0:00:59.72,0:01:01.10,Default,,0,0,0,,Мен оны көрдім
Dialogue: 0,0:01:01.56,0:01:02.64,Default,,0,0,0,,Шу!
Dialogue: 0,0:01:03.39,0:01:05.48,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:01:06.52,0:01:07.48,Default,,0,0,0,,Не!
Dialogue: 0,0:01:08.48,0:01:09.61,Default,,0,0,0,,Шу...
Dialogue: 0,0:01:10.11,0:01:11.61,Default,,0,0,0,,Сол қолмен ату
Dialogue: 0,0:01:19.78,0:01:22.16,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:22.49,0:01:27.67,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:38.97,0:01:42.35,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:42.85,0:01:44.97,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:45.39,0:01:49.52,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:49.65,0:01:52.86,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:52.98,0:01:59.41,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:59.70,0:02:04.12,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:04.62,0:02:10.04,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:10.17,0:02:12.42,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:12.50,0:02:17.22,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:17.38,0:02:22.47,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:22.76,0:02:25.01,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:25.22,0:02:27.56,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:27.85,0:02:31.77,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:31.94,0:02:36.94,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:37.15,0:02:39.32,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:43.16,0:02:45.20,Default,,0,0,0,,Азу тістерін ашқан аңдар!
Dialogue: 0,0:02:49.25,0:02:50.37,Default,,0,0,0,,Міне келдік!
Dialogue: 0,0:02:50.46,0:02:52.25,Default,,0,0,0,,Дәмді~
Dialogue: 0,0:02:52.79,0:02:54.92,Default,,0,0,0,,Көптен бері көрмегелі, Инуске-күн
Dialogue: 0,0:02:55.00,0:02:56.84,Default,,0,0,0,,Көбірек жеп қойыңыз!
Dialogue: 0,0:02:56.92,0:03:00.05,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:03:00.17,0:03:02.51,Default,,0,0,0,,Мынау және мына Бейблейд табасы
Dialogue: 0,0:03:06.56,0:03:08.56,Default,,0,0,0,,Сізге жақсы, Балто.
Dialogue: 0,0:03:08.73,0:03:11.77,Default,,0,0,0,,Мен мектеп ауыстырсам да, сен маған осылай келесің.
Dialogue: 0,0:03:12.19,0:03:14.77,Default,,0,0,0,,Хехехе, мен де бақыттымын Инуске!
Dialogue: 0,0:03:15.27,0:03:16.90,Default,,0,0,0,,Инсуке-кунның командасы...
Dialogue: 0,0:03:16.98,0:03:19.61,Default,,0,0,0,,Балтоның келесі қарсыласы кім болады?
Dialogue: 0,0:03:19.78,0:03:20.57,Default,,0,0,0,,Иә
Dialogue: 0,0:03:20.65,0:03:23.57,Default,,0,0,0,,Бірақ мен бүгін тағы да бірге шайқасамыз деп ойладым.
Dialogue: 0,0:03:23.74,0:03:25.37,Default,,0,0,0,,О! Қанекей мынаны істейік!
Dialogue: 0,0:03:26.49,0:03:28.58,Default,,0,0,0,,Менің келгеніме біраз болды.
Dialogue: 0,0:03:29.29,0:03:32.71,Default,,0,0,0,,Өткен күні Шу осында жаттығады.
Dialogue: 0,0:03:32.79,0:03:34.54,Default,,0,0,0,,Бұл жігіт керемет
Dialogue: 0,0:03:34.63,0:03:36.46,Default,,0,0,0,,Шуға не болды?
Dialogue: 0,0:03:36.84,0:03:38.88,Default,,0,0,0,,Иық жарақаты, есіңізде ме?
Dialogue: 0,0:03:38.96,0:03:39.84,Default,,0,0,0,,Иә
Dialogue: 0,0:03:40.13,0:03:41.84,Default,,0,0,0,,Шынымен де нашарлады ма?
Dialogue: 0,0:03:41.93,0:03:44.30,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:03:46.26,0:03:48.10,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:48.77,0:03:50.93,Default,,0,0,0,,Шу сол қолымен атып тұр...
Dialogue: 0,0:03:52.06,0:03:52.94,Default,,0,0,0,,Шу!
Dialogue: 0,0:03:53.27,0:03:53.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:54.40,0:03:55.31,Default,,0,0,0,,Барт…
Dialogue: 0,0:03:55.61,0:03:57.90,Default,,0,0,0,,Сен дәл қазір сол қолыңмен атып тұрдың, солай ма?
Dialogue: 0,0:03:58.82,0:04:00.49,Default,,0,0,0,,Иық Бұл жаман ба?
Dialogue: 0,0:04:02.61,0:04:04.20,Default,,0,0,0,,Егер бұл сіздің иығыңыз болса, алаңдамаңыз.
Dialogue: 0,0:04:04.28,0:04:06.07,Default,,0,0,0,,Кішкене демалып алсаңыз жақсы болады.
Dialogue: 0,0:04:06.45,0:04:08.45,Default,,0,0,0,,Бұл жақсы, бірақ...
Dialogue: 0,0:04:09.24,0:04:12.04,Default,,0,0,0,,Мен бұрын сол қолмен атумен айналыстым.
Dialogue: 0,0:04:12.12,0:04:13.21,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:04:13.54,0:04:14.96,Default,,0,0,0,,Солға немесе оңға...
Dialogue: 0,0:04:15.04,0:04:17.46,Default,,0,0,0,,Ең жақсы кадрды жасай алсаңыз...
Dialogue: 0,0:04:17.58,0:04:20.17,Default,,0,0,0,,Сіз Спригганның күшін көбірек көрсете аласыз.
Dialogue: 0,0:04:21.26,0:04:22.92,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:24.76,0:04:26.84,Default,,0,0,0,,Аа, бұл рас.
Dialogue: 0,0:04:26.93,0:04:28.39,Default,,0,0,0,,Сіз тіпті солға қарай жүре аласыз!
Dialogue: 0,0:04:29.06,0:04:30.18,Default,,0,0,0,,Сол қолмен атсаңыз...
Dialogue: 0,0:04:30.27,0:04:32.64,Default,,0,0,0,,Себебі сіз бос қолыңызбен қосқышты түзете аласыз.
Dialogue: 0,0:04:32.81,0:04:35.81,Default,,0,0,0,,Оң қолмен дәлірек ата алатынымды түсіндім.
Dialogue: 0,0:04:37.86,0:04:40.11,Default,,0,0,0,,Сіз бұл дыбысты білесіз бе?
Dialogue: 0,0:04:40.94,0:04:43.15,Default,,0,0,0,,Спригганның айналуы тұрақты.
Dialogue: 0,0:04:43.24,0:04:45.82,Default,,0,0,0,,Түсіндім! Мен оны естимін!
Dialogue: 0,0:04:45.91,0:04:48.12,Default,,0,0,0,,Уау! Мен де жасап көремін!
Dialogue: 0,0:04:49.03,0:04:50.16,Default,,0,0,0,,Мені ал...
Dialogue: 0,0:04:51.87,0:04:53.54,Default,,0,0,0,,Мен де солақай атамын!
Dialogue: 0,0:04:54.50,0:04:56.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:58.08,0:04:59.04,Default,,0,0,0,,О...
Dialogue: 0,0:04:59.63,0:05:00.71,Default,,0,0,0,,(шықыру дыбысы)
Dialogue: 0,0:05:01.96,0:05:04.80,Default,,0,0,0,,Е, мүлде жоқ.
Dialogue: 0,0:05:05.22,0:05:08.18,Default,,0,0,0,,Балт оң қолы, кенеттен мұны істеу мүмкін емес.
Dialogue: 0,0:05:08.55,0:05:10.93,Default,,0,0,0,,Мен де көп жаттығамын.
Dialogue: 0,0:05:11.43,0:05:12.81,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:13.60,0:05:15.81,Default,,0,0,0,,Валькири оянғандай...
Dialogue: 0,0:05:15.89,0:05:19.02,Default,,0,0,0,,Мен Спригганның барлық күшін ашқым келеді.
Dialogue: 0,0:05:19.36,0:05:21.61,Default,,0,0,0,,Біз ойлағаннан да көп...
Dialogue: 0,0:05:21.94,0:05:24.40,Default,,0,0,0,,Бейблейдтің көптеген мүмкіндіктері бар
Dialogue: 0,0:05:24.86,0:05:26.57,Default,,0,0,0,,Мен және Спригган...
Dialogue: 0,0:05:26.78,0:05:28.91,Default,,0,0,0,,Сіз одан да жоғары көтеріле аласыз!
Dialogue: 0,0:05:30.58,0:05:32.58,Default,,0,0,0,,Шу! Өтінемін, күресіңіз!
Dialogue: 0,0:05:34.29,0:05:35.91,Default,,0,0,0,,Сол қолмен атумен!
Dialogue: 0,0:05:36.25,0:05:36.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:37.33,0:05:39.54,Default,,0,0,0,,Мен бірінші рет солақай күресіп жатырмын.
Dialogue: 0,0:05:42.34,0:05:44.88,Default,,0,0,0,,Балт шапшаң атуды көздейді.
Dialogue: 0,0:05:45.01,0:05:47.55,Default,,0,0,0,,Олай болса, Валькири жолын оқыңыз...
Dialogue: 0,0:05:47.63,0:05:49.09,Default,,0,0,0,,Спригган бастаманы өз қолына алады
Dialogue: 0,0:05:49.64,0:05:52.10,Default,,0,0,0,,Шу Қолымыздан келгенді жасайық!
Dialogue: 0,0:05:52.56,0:05:53.22,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:05:53.85,0:05:56.52,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:56.93,0:05:58.69,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:01.77,0:06:03.82,Default,,0,0,0,,Өйткені, сіз оны қалай оқисыз.
Dialogue: 0,0:06:03.90,0:06:06.03,Default,,0,0,0,,Жылжы! Валькирия!
Dialogue: 0,0:06:07.99,0:06:10.78,Default,,0,0,0,,Ах! Бұрынғыдан да жылдам қозғалу
Dialogue: 0,0:06:12.33,0:06:13.79,Default,,0,0,0,,(шығақтардың соқтығысқан дыбысы)
Dialogue: 0,0:06:17.21,0:06:19.21,Default,,0,0,0,,Алға! Валькирия!
Dialogue: 0,0:06:19.29,0:06:20.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:22.09,0:06:23.63,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:06:24.13,0:06:25.46,Default,,0,0,0,,Жеребе?
Dialogue: 0,0:06:25.88,0:06:27.51,Default,,0,0,0,,Менің күшім жетпейді.
Dialogue: 0,0:06:27.97,0:06:29.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:29.09,0:06:32.47,Default,,0,0,0,,Шпригган дәл мен көздегендей ата алады, бірақ...
Dialogue: 0,0:06:32.76,0:06:34.85,Default,,0,0,0,,Тұру әлі де сәл баяу
Dialogue: 0,0:06:35.31,0:06:37.35,Default,,0,0,0,,Қуат әлі де жеткіліксіз.
Dialogue: 0,0:06:37.43,0:06:39.56,Default,,0,0,0,,Валькири шабуылына ұшырады
Dialogue: 0,0:06:39.89,0:06:42.81,Default,,0,0,0,,Сол қолмен ату... әлі де жаттығуда
Dialogue: 0,0:06:43.56,0:06:44.82,Default,,0,0,0,,Барт…
Dialogue: 0,0:06:44.98,0:06:47.61,Default,,0,0,0,,Тіпті сіз Валькиридің күш-қуатын көбірек шығара аласыз.
Dialogue: 0,0:06:48.44,0:06:50.82,Default,,0,0,0,,О! Қанекей мынаны істейік!
Dialogue: 0,0:06:50.91,0:06:51.82,Default,,0,0,0,,ол маған шексіз артықшылық беретін қаруға айналады.
Dialogue: 0,0:06:52.74,0:06:54.74,Default,,0,0,0,,Төрт айналымнан тұратын император күткендей.
Dialogue: 0,0:06:54.83,0:06:56.87,Default,,0,0,0,,Сіз зерттеуге құмарсыз.
Dialogue: 0,0:06:56.95,0:06:59.50,Default,,0,0,0,,Ах~ мен де бар күшімді салуым керек.
Dialogue: 0,0:06:59.58,0:07:01.96,Default,,0,0,0,,Тіпті Валькири де оянды, солай ма?
Dialogue: 0,0:07:02.38,0:07:05.50,Default,,0,0,0,,Командалық шайқастар керемет болды.
Dialogue: 0,0:07:06.80,0:07:09.05,Default,,0,0,0,,Жақсы! Жарысайық!
Dialogue: 0,0:07:09.59,0:07:11.05,Default,,0,0,0,,Мен көптен күттім.
Dialogue: 0,0:07:14.68,0:07:17.10,Default,,0,0,0,,Алға! Cerbeus!
Dialogue: 0,0:07:17.18,0:07:19.56,Default,,0,0,0,,Валькирия! Маған көрсет!
Dialogue: 0,0:07:20.64,0:07:21.94,Default,,0,0,0,,Жоғалтып алмаңыз!
Dialogue: 0,0:07:22.02,0:07:24.73,Default,,0,0,0,,Сіздің құдіретіңіз осындай!
Dialogue: 0,0:07:30.11,0:07:30.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:32.99,0:07:35.24,Default,,0,0,0,,Бұл жылдамдық қандай?
Dialogue: 0,0:07:37.16,0:07:38.74,Default,,0,0,0,,Не болып жатыр...
Dialogue: 0,0:07:40.66,0:07:42.00,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:07:42.21,0:07:43.88,Default,,0,0,0,,Сіз бұл қозғалыс туралы айтып отырсыз ба?
Dialogue: 0,0:07:46.17,0:07:47.59,Default,,0,0,0,,(шығанақ шыққан дыбыс)
Dialogue: 0,0:07:48.50,0:07:50.72,Default,,0,0,0,,Сіз жаман қуықсыз.
Dialogue: 0,0:07:51.26,0:07:52.09,Default,,0,0,0,,Е...
Dialogue: 0,0:07:52.18,0:07:53.63,Default,,0,0,0,,Сіздің шығанақ туралы
Dialogue: 0,0:07:53.72,0:07:55.22,Default,,0,0,0,,Мен ештеңе түсінбеймін!
Dialogue: 0,0:07:57.31,0:07:59.43,Default,,0,0,0,,Луи маған осылай деді.
Dialogue: 0,0:08:00.56,0:08:03.02,Default,,0,0,0,,Ол байқаған болуы керек.
Dialogue: 0,0:08:03.44,0:08:05.44,Default,,0,0,0,,Мен оны сол кезде түсінбедім, бірақ...
Dialogue: 0,0:08:05.77,0:08:07.82,Default,,0,0,0,,Мүмкін Валькири...
Dialogue: 0,0:08:07.90,0:08:10.11,Default,,0,0,0,,Мүмкін ол қайтадан оятуға тырысатын шығар...
Dialogue: 0,0:08:10.53,0:08:11.94,Default,,0,0,0,,Мен сенімдімін! иә!
Dialogue: 0,0:08:12.03,0:08:14.20,Default,,0,0,0,,Оянудың оянуы
Dialogue: 0,0:08:14.28,0:08:16.53,Default,,0,0,0,,Өте ояту басталған жоқ па?
Dialogue: 0,0:08:16.62,0:08:17.99,Default,,0,0,0,,Өте ояту...?
Dialogue: 0,0:08:18.49,0:08:20.58,Default,,0,0,0,,Ах! Өте оянды!
Dialogue: 0,0:08:20.66,0:08:22.75,Default,,0,0,0,,Бұл керемет болады! Валькирия!
Dialogue: 0,0:08:23.50,0:08:25.46,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:08:25.83,0:08:26.79,Default,,0,0,0,,(Мектептегі шу)
Dialogue: 0,0:08:26.88,0:08:28.09,Default,,0,0,0,,Inusuke?
Dialogue: 0,0:08:28.84,0:08:30.46,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:08:30.55,0:08:33.05,Default,,0,0,0,,Қалыпты түрде шайқасайық
Dialogue: 0,0:08:33.13,0:08:35.09,Default,,0,0,0,,Інүсукеге ұқсайды.
Dialogue: 0,0:08:35.18,0:08:37.47,Default,,0,0,0,,Сонымен бізде шайқас болды...
Dialogue: 0,0:08:38.35,0:08:39.30,Default,,0,0,0,,Валькирия…
Dialogue: 0,0:08:39.72,0:08:41.18,Default,,0,0,0,,Мен қатты оянатын сияқтымын
Dialogue: 0,0:08:41.89,0:08:42.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:43.73,0:08:45.14,Default,,0,0,0,,Өте ояту...?
Dialogue: 0,0:08:45.23,0:08:47.06,Default,,0,0,0,,Валькирияның қимылдары...
Dialogue: 0,0:08:47.15,0:08:49.19,Default,,0,0,0,,Бұл бірінші оятуға ұқсас.
Dialogue: 0,0:08:49.27,0:08:50.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:50.19,0:08:51.40,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:08:51.69,0:08:52.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:52.94,0:08:55.20,Default,,0,0,0,,Өткен күні шайқаста көргенім...
Dialogue: 0,0:08:55.28,0:08:57.53,Default,,0,0,0,,Мүмкін бұл өте ояну белгісі болды.
Dialogue: 0,0:08:57.62,0:08:58.57,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:08:58.66,0:09:00.58,Default,,0,0,0,,Бұл жай Шуу, бұл Зурийжан
Dialogue: 0,0:09:00.66,0:09:01.70,Default,,0,0,0,,Маған да қара
Dialogue: 0,0:09:02.50,0:09:04.71,Default,,0,0,0,,Кәне, бәріңіз қараңыздар!
Dialogue: 0,0:09:06.04,0:09:07.12,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:09:07.75,0:09:09.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:11.92,0:09:13.26,Default,,0,0,0,,Сіз қалай ойлайсыз? Балтық
Dialogue: 0,0:09:13.34,0:09:15.17,Default,,0,0,0,,Бұл кеше болған жағдай ма?
Dialogue: 0,0:09:15.26,0:09:18.05,Default,,0,0,0,,Иә, мынау, мынау, мынау қозғалыс!
Dialogue: 0,0:09:18.47,0:09:19.51,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:19.76,0:09:22.68,Default,,0,0,0,,Мен сенімдімін... Тіпті Cyclone Bay стадионында...
Dialogue: 0,0:09:23.64,0:09:27.10,Default,,0,0,0,,Бұл стадионның кесірінен болған жоқ па?
Dialogue: 0,0:09:27.65,0:09:29.77,Default,,0,0,0,,Луи байқаған сияқты.
Dialogue: 0,0:09:29.86,0:09:32.15,Default,,0,0,0,,Олай болса, дұрыс айта аласың ба?
Dialogue: 0,0:09:32.23,0:09:33.82,Default,,0,0,0,,Алғашқы оянған кезде де...
Dialogue: 0,0:09:33.90,0:09:35.74,Default,,0,0,0,,Біраз уақыт тұрақсыз болды.
Dialogue: 0,0:09:35.82,0:09:38.32,Default,,0,0,0,,Валькири әлі оятуы керек...
Dialogue: 0,0:09:38.41,0:09:40.28,Default,,0,0,0,,Бұл одан да көп нәрсе бар дегенді білдіре ме?
Dialogue: 0,0:09:41.16,0:09:44.33,Default,,0,0,0,,Сондықтан Инуске мұны супер ояну деп атады.
Dialogue: 0,0:09:44.79,0:09:47.54,Default,,0,0,0,,Сонымен...Мен қазір осының ортасындамын?
Dialogue: 0,0:09:47.62,0:09:49.67,Default,,0,0,0,,Жақын арада келесі командалық матч болады.
Dialogue: 0,0:09:50.33,0:09:51.96,Default,,0,0,0,,Біз мұнымен күресе аламыз ба?
Dialogue: 0,0:09:52.04,0:09:53.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:53.09,0:09:55.30,Default,,0,0,0,,Инуске мұны көрді, солай ма?
Dialogue: 0,0:09:55.38,0:09:56.80,Default,,0,0,0,,А, мен көрдім.
Dialogue: 0,0:09:58.80,0:10:01.72,Default,,0,0,0,,Оянғаннан кейін ояну?
Dialogue: 0,0:10:01.80,0:10:03.97,Default,,0,0,0,,Кенеттен шықпаңыз! Кенеттен!
Dialogue: 0,0:10:04.06,0:10:05.64,Default,,0,0,0,,тым кеш.
Dialogue: 0,0:10:05.73,0:10:07.77,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:10:07.85,0:10:11.40,Default,,0,0,0,,Сіздің келесі қарсыласыңыз бұл туралы білді ме?
Dialogue: 0,0:10:11.48,0:10:12.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:12.61,0:10:14.19,Default,,0,0,0,,Айтатата~
Dialogue: 0,0:10:14.28,0:10:15.90,Default,,0,0,0,,Аканте бұл
Dialogue: 0,0:10:15.99,0:10:18.99,Default,,0,0,0,,Толтырылған ойыншық Yarrow кездескенімізде солай істедік
Dialogue: 0,0:10:19.07,0:10:20.49,Default,,0,0,0,,Бұл Инсуке!
Dialogue: 0,0:10:20.57,0:10:22.20,Default,,0,0,0,,Инсуке Мидорикава
Dialogue: 0,0:10:22.28,0:10:25.08,Default,,0,0,0,,Хмм... Олай болса Мидорикаваға барайық.
Dialogue: 0,0:10:25.16,0:10:27.20,Default,,0,0,0,,Қалай болғанда да ол адам сенің жауың!
Dialogue: 0,0:10:27.29,0:10:28.25,Default,,0,0,0,,Жау!
Dialogue: 0,0:10:28.33,0:10:29.29,Default,,0,0,0,,Жау…
Dialogue: 0,0:10:32.21,0:10:33.17,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:10:33.25,0:10:34.67,Default,,0,0,0,,Жау әсірелеуі мүмкін
Dialogue: 0,0:10:34.75,0:10:36.92,Default,,0,0,0,,Инуске біздің досымыз.
Dialogue: 0,0:10:37.01,0:10:38.88,Default,,0,0,0,,Иә? Бұл тәтті
Dialogue: 0,0:10:38.97,0:10:41.55,Default,,0,0,0,,Егер сіз осылай айтып жатсаңыз, келесі жолы ұтыласыз.
Dialogue: 0,0:10:41.64,0:10:43.43,Default,,0,0,0,,Мен жоғалтуға шыдай алмаймын~
Dialogue: 0,0:10:43.51,0:10:46.60,Default,,0,0,0,,Балто, егер сіз келесіде көрінсеңіз, кешіріңіз.
Dialogue: 0,0:10:46.68,0:10:47.81,Default,,0,0,0,,Мен енді сол қателігімді қайталамаймын.
Dialogue: 0,0:10:47.89,0:10:49.39,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:10:49.48,0:10:51.60,Default,,0,0,0,,Егер сіз Валькири ретінде шыға алсаңыз...
Dialogue: 0,0:10:51.69,0:10:53.19,Default,,0,0,0,,Тіпті жеңе алатындар да жеңе алмайды.
Dialogue: 0,0:10:53.27,0:10:55.52,Default,,0,0,0,,Жау Цуцункеяшиге
Dialogue: 0,0:10:55.61,0:10:56.65,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:56.73,0:10:59.53,Default,,0,0,0,,Тағы не айттыңыз? Айтып көріңіз
Dialogue: 0,0:10:59.74,0:11:01.57,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:01.66,0:11:04.66,Default,,0,0,0,,А, Шудың солақай ату жаттығуы.
Dialogue: 0,0:11:04.74,0:11:06.29,Default,,0,0,0,,Сол қолмен ату!
Dialogue: 0,0:11:06.37,0:11:08.45,Default,,0,0,0,,Аа, мен жаттығып жатырмын.
Dialogue: 0,0:11:08.95,0:11:10.87,Default,,0,0,0,,Мен оны әлі мінсіз деп айта алмаймын.
Dialogue: 0,0:11:10.96,0:11:14.42,Default,,0,0,0,,Бұл да өте маңызды тақырып емес пе?
Dialogue: 0,0:11:14.50,0:11:17.38,Default,,0,0,0,,Цуцунуке және Цуцунуке дадаморея
Dialogue: 0,0:11:17.46,0:11:19.01,Default,,0,0,0,,Қалағаныңды істе!
Dialogue: 0,0:11:19.09,0:11:20.59,Default,,0,0,0,,Басқа адам не білсе де...
Dialogue: 0,0:11:20.67,0:11:21.88,Default,,0,0,0,,Біз жеңеміз!
Dialogue: 0,0:11:21.97,0:11:22.84,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:11:22.93,0:11:24.72,Default,,0,0,0,,О! Біз жеңеміз!
Dialogue: 0,0:11:24.80,0:11:28.27,Default,,0,0,0,,Ендеше келесі командалық матчқа кім шығатынын анықтайық.
Dialogue: 0,0:11:28.35,0:11:30.89,Default,,0,0,0,,Не, кенет сен басқарып қалдың ба?
Dialogue: 0,0:11:30.98,0:11:33.69,Default,,0,0,0,,Дұрыс, ол капитан.
Dialogue: 0,0:11:33.77,0:11:37.11,Default,,0,0,0,,Олай болса кім тас, қағаз, қайшы ойнайтынын шешейік!
Dialogue: 0,0:11:37.19,0:11:38.44,Default,,0,0,0,,Не!
Dialogue: 0,0:11:38.53,0:11:40.74,Default,,0,0,0,,Тас, қағаз, қайшы бала ма?
Dialogue: 0,0:11:41.49,0:11:43.45,Default,,0,0,0,,Сіз ояту процесіндесіз.
Dialogue: 0,0:11:43.78,0:11:45.87,Default,,0,0,0,,Бұл жолы да ұстанған дұрыс емес пе?
Dialogue: 0,0:11:46.41,0:11:48.70,Default,,0,0,0,,Бірақ мен Инускемен жұдырықтасқым келеді.
Dialogue: 0,0:11:48.79,0:11:51.71,Default,,0,0,0,,Мен шайқасқым келеді! Мен тілеймін! Мен тілеймін!
Dialogue: 0,0:11:51.79,0:11:53.92,Default,,0,0,0,,Уау, бұл өте қатты
Dialogue: 0,0:11:54.21,0:11:56.84,Default,,0,0,0,,Бұл қызық, тас, қағаз, қайшы!
Dialogue: 0,0:11:57.04,0:11:59.13,Default,,0,0,0,,Кім болсаң да, қызғанба!
Dialogue: 0,0:11:59.21,0:12:01.97,Default,,0,0,0,,Хе, мен бәрібір жеңемін.
Dialogue: 0,0:12:02.05,0:12:03.34,Default,,0,0,0,,Шуды да жасайық!
Dialogue: 0,0:12:03.76,0:12:04.93,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:12:05.01,0:12:07.76,Default,,0,0,0,,А, жарайды! Біз жасаймыз ба?
Dialogue: 0,0:12:08.22,0:12:09.22,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:12:09.31,0:12:10.85,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:12:10.93,0:12:12.48,Default,,0,0,0,,Сіз жанып тұрсыз!
Dialogue: 0,0:12:12.56,0:12:13.73,Default,,0,0,0,,О!
Dialogue: 0,0:12:13.81,0:12:15.56,Default,,0,0,0,,Алдымен шығанақ!
Dialogue: 0,0:12:15.81,0:12:17.90,Default,,0,0,0,,Тас-қағаз-қайшы теннис!
Dialogue: 0,0:12:23.57,0:12:24.61,Default,,0,0,0,,О...
Dialogue: 0,0:12:25.07,0:12:26.32,Default,,0,0,0,,Inusuke~
Dialogue: 0,0:12:27.37,0:12:28.45,Default,,0,0,0,,Барт…
Dialogue: 0,0:12:29.08,0:12:30.37,Default,,0,0,0,,Менің ойымша, бұл жақсы
Dialogue: 0,0:12:30.49,0:12:31.62,Default,,0,0,0,,Ах
Dialogue: 0,0:12:34.75,0:12:37.67,Default,,0,0,0,,Балто мен сені құртамын.
Dialogue: 0,0:12:38.17,0:12:39.21,Default,,0,0,0,,Не!
Dialogue: 0,0:12:41.96,0:12:43.05,Default,,0,0,0,,Хмм!
Dialogue: 0,0:12:43.51,0:12:45.55,Default,,0,0,0,,Командалық финалға кім шығады?
Dialogue: 0,0:12:45.63,0:12:46.51,Default,,0,0,0,,Бұл біз!
Dialogue: 0,0:12:47.01,0:12:48.60,Default,,0,0,0,,Біз жеңеміз!
Dialogue: 0,0:12:49.18,0:12:50.39,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:12:52.52,0:12:55.48,Default,,0,0,0,,Бұл «Аңдар» фильміндегі Инсуке Мидорикава.
Dialogue: 0,0:12:55.56,0:12:57.35,Default,,0,0,0,,Сіз жауды айтасыз...
Dialogue: 0,0:13:05.40,0:13:07.70,Default,,0,0,0,,Бен, мүшелер бүгін не істемекші?
Dialogue: 0,0:13:07.78,0:13:09.03,Default,,0,0,0,,Мен келемін
Dialogue: 0,0:13:09.12,0:13:11.49,Default,,0,0,0,,О, ақыры осында.
Dialogue: 0,0:13:11.58,0:13:14.21,Default,,0,0,0,,Мақсат әлі Куришуу ма?
Dialogue: 0,0:13:14.29,0:13:16.08,Default,,0,0,0,,Барто Аои емес пе?\NМен бұл
Dialogue: 0,0:13:16.67,0:13:17.46,Default,,0,0,0,,Ах
Dialogue: 0,0:13:17.58,0:13:19.21,Default,,0,0,0,,деп ойладым
Dialogue: 0,0:13:19.29,0:13:20.79,Default,,0,0,0,,Барто Аои туралы айтқанда...
Dialogue: 0,0:13:20.88,0:13:22.80,Default,,0,0,0,,Маған сол Валькири жігіті керек
Dialogue: 0,0:13:22.88,0:13:24.63,Default,,0,0,0,,Бенді қызықтырды.
Dialogue: 0,0:13:24.72,0:13:26.97,Default,,0,0,0,,Мен мұны істей алатын адамды көріп тұрмын.
Dialogue: 0,0:13:27.47,0:13:29.39,Default,,0,0,0,,Қызықты қылшық
Dialogue: 0,0:13:29.64,0:13:31.26,Default,,0,0,0,,Көптеген жолдармен.
Dialogue: 0,0:13:31.56,0:13:32.72,Default,,0,0,0,,Мен де сонда боламын!
Dialogue: 0,0:13:33.02,0:13:33.68,Default,,0,0,0,,А?
Dialogue: 0,0:13:33.97,0:13:35.64,Default,,0,0,0,,Bay Club жігіттерімен...
Dialogue: 0,0:13:35.73,0:13:37.23,Default,,0,0,0,,Біз сөзсіз күресеміз!
Dialogue: 0,0:13:37.81,0:13:38.44,Default,,0,0,0,,Ах
Dialogue: 0,0:13:38.52,0:13:41.02,Default,,0,0,0,,Әрине, Бен Бегемотымен...
Dialogue: 0,0:13:41.11,0:13:43.40,Default,,0,0,0,,Мен сондай-ақ Валькири ойынын көргім келеді.
Dialogue: 0,0:13:43.48,0:13:45.32,Default,,0,0,0,,Барлығы қатты қорқады!
Dialogue: 0,0:13:45.40,0:13:46.45,Default,,0,0,0,,Бегемот!
Dialogue: 0,0:13:46.99,0:13:48.07,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:13:52.70,0:13:53.58,Default,,0,0,0,,О!
Dialogue: 0,0:13:54.08,0:13:55.33,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:13:55.41,0:13:56.96,Default,,0,0,0,,орындалды.
Dialogue: 0,0:13:57.04,0:13:58.08,Default,,0,0,0,,Ах
Dialogue: 0,0:13:58.42,0:14:00.04,Default,,0,0,0,,Бен мұны жасаған жоқ па?
Dialogue: 0,0:14:00.13,0:14:02.46,Default,,0,0,0,,Мен өте сенімдімін.
Dialogue: 0,0:14:03.63,0:14:06.01,Default,,0,0,0,,Бұл менің Кербеусым.
Dialogue: 0,0:14:06.09,0:14:08.88,Default,,0,0,0,,Егер сізде де Бен болса, неге оған қарсы ойнамасқа?
Dialogue: 0,0:14:10.64,0:14:11.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:11.89,0:14:13.51,Default,,0,0,0,,Сізді қызықтырмады ма?
Dialogue: 0,0:14:15.64,0:14:17.98,Default,,0,0,0,,Ой! Сізде жоқ па?
Dialogue: 0,0:14:18.06,0:14:19.77,Default,,0,0,0,,Мен Бейді бірінші рет көріп тұрмын.
Dialogue: 0,0:14:20.15,0:14:21.94,Default,,0,0,0,,Бегемот хайуан
Dialogue: 0,0:14:22.52,0:14:25.28,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:25.36,0:14:27.53,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:29.82,0:14:32.24,Default,,0,0,0,,Шабуыл түрі Beast Behemoth
Dialogue: 0,0:14:32.32,0:14:33.74,Default,,0,0,0,,Мұндай шығанақты бірінші рет көруім
Dialogue: 0,0:14:34.49,0:14:35.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:35.74,0:14:37.00,Default,,0,0,0,,Байқадыңыз ба...
Dialogue: 0,0:14:37.41,0:14:40.92,Default,,0,0,0,,Кез келген шығанақтың жылдамдығы уақыт өткен сайын төмендейді.
Dialogue: 0,0:14:41.29,0:14:43.21,Default,,0,0,0,,Бірақ Бегемот басқа!
Dialogue: 0,0:14:43.75,0:14:45.38,Default,,0,0,0,,Орта кезеңнен бастап жеделдету-
Dialogue: 0,0:14:45.46,0:14:46.88,Default,,0,0,0,,Өзіңіздің шынайы болмысыңызды көрсетіңіз!
Dialogue: 0,0:14:48.42,0:14:49.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:49.34,0:14:51.34,Default,,0,0,0,,Қайталап шабуыл жасайтын фигура...
Dialogue: 0,0:14:51.43,0:14:52.43,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:14:52.51,0:14:54.14,Default,,0,0,0,,Бұл аң болды.
Dialogue: 0,0:14:56.27,0:14:58.23,Default,,0,0,0,,Бұл мені таң қалдырды.
Dialogue: 0,0:14:58.56,0:15:01.44,Default,,0,0,0,,Сондықтан мен Балто мен басқалардың таң қалғанын қалаймын.
Dialogue: 0,0:15:01.52,0:15:02.61,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:15:02.69,0:15:04.57,Default,,0,0,0,,Тағы бір адам пайда болады?
Dialogue: 0,0:15:04.65,0:15:05.82,Default,,0,0,0,,О!
Dialogue: 0,0:15:06.32,0:15:07.69,Default,,0,0,0,,Okay!
Dialogue: 0,0:15:07.78,0:15:10.57,Default,,0,0,0,,WBBA Beyblade ұлттық турнирі
Dialogue: 0,0:15:10.65,0:15:13.45,Default,,0,0,0,,Командалық жарыстың 3-күні, жартылай финал!
Dialogue: 0,0:15:13.53,0:15:15.53,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:15.62,0:15:17.24,Default,,0,0,0,,Бірінші, А блогы
Dialogue: 0,0:15:18.58,0:15:21.29,Default,,0,0,0,,Йонекома Гакуэн Бэй клубы VS жыртқыштар!
Dialogue: 0,0:15:21.37,0:15:22.63,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:15:22.71,0:15:23.79,Default,,0,0,0,,Қызыл бұрыш
Dialogue: 0,0:15:23.88,0:15:25.71,Default,,0,0,0,,Дотоның тұрақты алға жылжуы жалғасуда.
Dialogue: 0,0:15:25.79,0:15:27.50,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:15:27.59,0:15:30.93,Default,,0,0,0,,Қызу шайқасты күтеміз! үлкен! үлкен!
Dialogue: 0,0:15:31.01,0:15:34.60,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз! Йонекома Гакуэн шығанағы клубы!
Dialogue: 0,0:15:34.93,0:15:36.56,Default,,0,0,0,,және көк бұрыш
Dialogue: 0,0:15:36.64,0:15:38.35,Default,,0,0,0,,Тұрған сайын жаңғырық...
Dialogue: 0,0:15:38.43,0:15:40.43,Default,,0,0,0,,Жануарлар әскерінің айқайы!
Dialogue: 0,0:15:40.52,0:15:42.35,Default,,0,0,0,,Аты - аңдар!
Dialogue: 0,0:15:42.44,0:15:44.77,Default,,0,0,0,,Сәттілік, Инуске де!
Dialogue: 0,0:15:44.86,0:15:46.02,Default,,0,0,0,,Енді екі команда.
Dialogue: 0,0:15:46.11,0:15:49.44,Default,,0,0,0,,Бұл матчқа қатысу үшін үш адам тіркелді!
Dialogue: 0,0:15:50.95,0:15:52.45,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:15:52.53,0:15:55.37,Default,,0,0,0,,Бар күш-қуатымызбен жүрейік!
Dialogue: 0,0:15:55.45,0:15:57.08,Default,,0,0,0,,Гах...
Dialogue: 0,0:15:57.45,0:15:58.58,Default,,0,0,0,,Atto
Dialogue: 0,0:15:58.66,0:16:00.91,Default,,0,0,0,,Балт Аои шығанақты бұрмас бұрын-
Dialogue: 0,0:16:01.00,0:16:03.04,Default,,0,0,0,,Мен бұрылдым~
Dialogue: 0,0:16:03.21,0:16:04.12,Default,,0,0,0,,А...
Dialogue: 0,0:16:04.21,0:16:06.29,Default,,0,0,0,,Бұл ұят нәрсе.
Dialogue: 0,0:16:06.67,0:16:09.30,Default,,0,0,0,,Екі команда да осы жолы қатысатын ойыншылар
Dialogue: 0,0:16:09.71,0:16:11.84,Default,,0,0,0,,Йонекома Гакуэн Бей клубынан-
Dialogue: 0,0:16:12.47,0:16:13.93,Default,,0,0,0,,Комурасаки Вакия
Dialogue: 0,0:16:14.47,0:16:15.89,Default,,0,0,0,,Рантаро Кияма
Dialogue: 0,0:16:16.30,0:16:18.31,Default,,0,0,0,,Және капитан Балто Аои!
Dialogue: 0,0:16:18.89,0:16:20.72,Default,,0,0,0,,Міне, келдің... Балто...
Dialogue: 0,0:16:20.85,0:16:22.85,Default,,0,0,0,,Ал аңдардан...
Dialogue: 0,0:16:22.94,0:16:24.44,Default,,0,0,0,,Инсуке Мидорикава!
Dialogue: 0,0:16:24.81,0:16:26.44,Default,,0,0,0,,Жақсы! Бұл Инуске!
Dialogue: 0,0:16:27.11,0:16:28.86,Default,,0,0,0,,Сакурадзима Кога
Dialogue: 0,0:16:28.94,0:16:31.03,Default,,0,0,0,,Және капитан Азуки Бен
Dialogue: 0,0:16:31.49,0:16:33.74,Default,,0,0,0,,Аңдар капитаны пайда болды.
Dialogue: 0,0:16:34.41,0:16:37.28,Default,,0,0,0,,Қолданылған би - Бегемот Бегемот.
Dialogue: 0,0:16:38.49,0:16:40.62,Default,,0,0,0,,Бірінші Бладер, алға шық.
Dialogue: 0,0:16:41.79,0:16:43.33,Default,,0,0,0,,Сіздің кезегіңіз келді!
Dialogue: 0,0:16:43.83,0:16:45.87,Default,,0,0,0,,Бар күшіңмен жабайы жүр
Dialogue: 0,0:16:45.96,0:16:48.25,Default,,0,0,0,,Кумичо, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:16:48.34,0:16:50.30,Default,,0,0,0,,Басынан жеңіліп қалмаңыз
Dialogue: 0,0:16:50.38,0:16:52.26,Default,,0,0,0,,Қалғаны қиын болады.
Dialogue: 0,0:16:52.34,0:16:53.67,Default,,0,0,0,,Мен қатты шаршадым
Dialogue: 0,0:16:53.76,0:16:55.09,Default,,0,0,0,,Үніңді жап, қара!
Dialogue: 0,0:16:56.05,0:16:58.18,Default,,0,0,0,,Келіңіздер, мұны кез келген адам жасай алады!
Dialogue: 0,0:16:58.26,0:16:59.60,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:01.68,0:17:04.52,Default,,0,0,0,,Инуске?… Жарайды.
Dialogue: 0,0:17:05.23,0:17:06.73,Default,,0,0,0,,Кумичомен.
Dialogue: 0,0:17:07.15,0:17:08.35,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:17:08.98,0:17:11.61,Default,,0,0,0,,Инсуке! Жанып тұрған жоқсың ба?
Dialogue: 0,0:17:11.73,0:17:13.57,Default,,0,0,0,,Кумичо мона
Dialogue: 0,0:17:13.86,0:17:18.20,Default,,0,0,0,,Бірінші шайқас - Рантаро Кияма мен Инусуке Мидорикава!
Dialogue: 0,0:17:18.57,0:17:20.66,Default,,0,0,0,,Кумичо Біз қалай күресуіміз керек?
Dialogue: 0,0:17:20.74,0:17:22.24,Default,,0,0,0,,Бұл дақ.
Dialogue: 0,0:17:22.66,0:17:24.62,Default,,0,0,0,,Бұл сізбен нағыз шайқас.
Dialogue: 0,0:17:24.71,0:17:26.08,Default,,0,0,0,,Мен мұны істегім келді!
Dialogue: 0,0:17:26.17,0:17:27.29,Default,,0,0,0,,Мен де!
Dialogue: 0,0:17:27.37,0:17:30.21,Default,,0,0,0,,Бірақ мен бірінші шайқаста боламын.
Dialogue: 0,0:17:30.29,0:17:31.34,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:17:31.46,0:17:32.92,Default,,0,0,0,,Cerbeus азу тістері...
Dialogue: 0,0:17:33.01,0:17:35.09,Default,,0,0,0,,Сен мені тістесең, мен сені жібермеймін.
Dialogue: 0,0:17:35.34,0:17:36.68,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:17:36.76,0:17:39.72,Default,,0,0,0,,Мен сені Рагнаруктың отымен өртеп жіберемін.
Dialogue: 0,0:17:40.26,0:17:43.43,Default,,0,0,0,,Инсуке... Атмосфера әйтеуір өзгерген жоқ па?
Dialogue: 0,0:17:44.02,0:17:47.14,Default,,0,0,0,,Бұл менің соңғы келгенімнен мүлде басқаша.
Dialogue: 0,0:17:47.23,0:17:49.61,Default,,0,0,0,,Сіз шайқасқа кіргеннен кейін дос болмайсыз.
Dialogue: 0,0:17:49.69,0:17:50.65,Default,,0,0,0,,Жау!
Dialogue: 0,0:17:51.27,0:17:53.32,Default,,0,0,0,,Мидорикава тістерін жұлып алады!
Dialogue: 0,0:17:53.98,0:17:55.36,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:55.69,0:17:57.78,Default,,0,0,0,,Кеттік! Inusuke!
Dialogue: 0,0:17:57.86,0:17:58.66,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:59.07,0:18:01.16,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:01.24,0:18:04.16,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:04.24,0:18:06.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:06.16,0:18:07.04,Default,,0,0,0,,Е!
Dialogue: 0,0:18:07.37,0:18:09.58,Default,,0,0,0,,Енді бірінші шайқас үшін...
Dialogue: 0,0:18:09.67,0:18:13.05,Default,,0,0,0,,Көтеріліп келе жатқан Рагнарук пен Кайзер Сербеус!
Dialogue: 0,0:18:13.34,0:18:15.42,Default,,0,0,0,,Егер бұл төзімділік шайқасы болса, бұл!
Dialogue: 0,0:18:15.51,0:18:17.88,Default,,0,0,0,,Төзімділік түрі Берілме!
Dialogue: 0,0:18:18.76,0:18:21.14,Default,,0,0,0,,Жарайсыңдар! Рагнарук аймағына барайық!
Dialogue: 0,0:18:23.22,0:18:23.97,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:18:24.06,0:18:26.02,Default,,0,0,0,,Ортасын алуға келесің бе?
Dialogue: 0,0:18:26.10,0:18:27.64,Default,,0,0,0,,Мен оны білдім!
Dialogue: 0,0:18:27.73,0:18:30.19,Default,,0,0,0,,Мен саған қарсы қанша рет ойнадым деп ойлайсың?
Dialogue: 0,0:18:30.27,0:18:31.98,Default,,0,0,0,,Ортасын алғыңыз келсе...
Dialogue: 0,0:18:32.06,0:18:33.82,Default,,0,0,0,,Мен де жеңілмеймін!
Dialogue: 0,0:18:34.19,0:18:35.03,Default,,0,0,0,,Куу!
Dialogue: 0,0:18:35.11,0:18:38.32,Default,,0,0,0,,Жүр! Тізбек ату!
Dialogue: 0,0:18:38.40,0:18:40.11,Default,,0,0,0,,(шығақтардың соқтығысқан дыбысы)
Dialogue: 0,0:18:40.41,0:18:41.41,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:18:41.49,0:18:43.70,Default,,0,0,0,,Дәл ортада Рагнаруктың орны!
Dialogue: 0,0:18:43.78,0:18:45.33,Default,,0,0,0,,Берілме!
Dialogue: 0,0:18:45.41,0:18:48.21,Default,,0,0,0,,Рагнарук аймағындағы тізбекті түсірілім!
Dialogue: 0,0:18:48.29,0:18:50.79,Default,,0,0,0,,Бір-бірінің ерекше қимылдары бірін-бірі қайталайды.
Dialogue: 0,0:18:50.87,0:18:52.54,Default,,0,0,0,,Бұл жақсы ойын.
Dialogue: 0,0:18:52.63,0:18:55.09,Default,,0,0,0,,Жабысқақ емес пе? Рагнарук
Dialogue: 0,0:18:55.17,0:18:56.84,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе! Кумичо!
Dialogue: 0,0:18:56.92,0:18:59.93,Default,,0,0,0,,Кербеуыстың шыдамы таусылғанын көздей береміз бе?
Dialogue: 0,0:19:00.18,0:19:01.55,Default,,0,0,0,,(шығақтардың соқтығысқан дыбысы)
Dialogue: 0,0:19:01.64,0:19:03.80,Default,,0,0,0,,Рагнарук күшті
Dialogue: 0,0:19:03.89,0:19:05.18,Default,,0,0,0,,Ол күткендей шайқалмайды
Dialogue: 0,0:19:05.51,0:19:06.18,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:08.10,0:19:10.85,Default,,0,0,0,,Әлі алда! Рагнарук!
Dialogue: 0,0:19:10.98,0:19:12.94,Default,,0,0,0,,Мақсат дұрыс болса...
Dialogue: 0,0:19:15.90,0:19:16.73,Default,,0,0,0,,О...
Dialogue: 0,0:19:17.07,0:19:18.49,Default,,0,0,0,,Рагнарук не болды?
Dialogue: 0,0:19:19.53,0:19:20.24,Default,,0,0,0,,Міне!
Dialogue: 0,0:19:20.40,0:19:21.82,Default,,0,0,0,,(Қатты соқтығыстың дыбысы)
Dialogue: 0,0:19:22.20,0:19:25.49,Default,,0,0,0,,Рагнарук Сіз әдеттегіден әлдеқайда дірілсізсіз.
Dialogue: 0,0:19:25.58,0:19:26.41,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:19:26.99,0:19:29.41,Default,,0,0,0,,Мен Мидорикаваның қарқынына тәуелді болып қалған шығармын.
Dialogue: 0,0:19:29.50,0:19:30.33,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:19:31.00,0:19:34.21,Default,,0,0,0,,Сол жекпе-жек стилін бірнеше рет көргеніңіз есіңізде жоқ па?
Dialogue: 0,0:19:35.00,0:19:37.46,Default,,0,0,0,,Түсіру кезінде диагональ бойынша ату.
Dialogue: 0,0:19:37.96,0:19:40.59,Default,,0,0,0,,Бұл сіз тізбекті атуды көздеген кезде ұстанатын ұстанымыңыз.
Dialogue: 0,0:19:41.13,0:19:43.05,Default,,0,0,0,,Тізбекті шұңқыр туралы айту
Dialogue: 0,0:19:43.55,0:19:45.22,Default,,0,0,0,,18 пышақ қабатымен-
Dialogue: 0,0:19:45.30,0:19:47.56,Default,,0,0,0,,Бұл қарсыласқа қайта-қайта соққы беретін әдіс.
Dialogue: 0,0:19:48.31,0:19:51.02,Default,,0,0,0,,Қарсыластың физикалық күшін біртіндеп төмендету.
Dialogue: 0,0:19:51.52,0:19:52.69,Default,,0,0,0,,Менің шыдамым бар, бірақ...
Dialogue: 0,0:19:52.77,0:19:54.98,Default,,0,0,0,,Қорғаныс күші төмен Рагнарук үшін-
Dialogue: 0,0:19:55.06,0:19:56.23,Default,,0,0,0,,Жарамды
Dialogue: 0,0:19:56.69,0:19:58.94,Default,,0,0,0,,Көрдім, азу тістерін жұлып ал.
Dialogue: 0,0:20:00.99,0:20:03.70,Default,,0,0,0,,Рагнаруктың физикалық күші қазірдің өзінде шегінде.
Dialogue: 0,0:20:03.78,0:20:04.62,Default,,0,0,0,,Кумичо!
Dialogue: 0,0:20:04.91,0:20:06.53,Default,,0,0,0,,Менің Рагнарукым!
Dialogue: 0,0:20:06.62,0:20:07.95,Default,,0,0,0,,Шатаспаңыз!
Dialogue: 0,0:20:10.66,0:20:13.75,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:20:16.13,0:20:19.05,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:20:19.63,0:20:22.05,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:20:22.30,0:20:24.47,Default,,0,0,0,,Түсіндім, Кумичо!
Dialogue: 0,0:20:27.14,0:20:29.06,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:20:32.23,0:20:34.10,Default,,0,0,0,,О... шындап...
Dialogue: 0,0:20:34.19,0:20:35.48,Default,,0,0,0,,Ах~
Dialogue: 0,0:20:35.56,0:20:37.02,Default,,0,0,0,,Маған айтпа.
Dialogue: 0,0:20:37.11,0:20:38.11,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:38.40,0:20:40.28,Default,,0,0,0,,Кайзер Сербеус
Dialogue: 0,0:20:40.44,0:20:42.44,Default,,0,0,0,,Айналдыру үшін 1 ұпай
Dialogue: 0,0:20:42.90,0:20:44.15,Default,,0,0,0,,Нуа~!
Dialogue: 0,0:20:44.24,0:20:46.16,Default,,0,0,0,,(Жеңіс айқайы)
Dialogue: 0,0:20:46.24,0:20:47.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:47.32,0:20:49.74,Default,,0,0,0,,Бірінші шайқас - Кайзер Кербеус...
Dialogue: 0,0:20:49.83,0:20:52.00,Default,,0,0,0,,Көтерілген Рагнарукты жеңу!
Dialogue: 0,0:20:52.45,0:20:55.37,Default,,0,0,0,,Ах~ Кумичо жеңіліп қалды.
Dialogue: 0,0:20:55.46,0:20:57.42,Default,,0,0,0,,Инсуке керемет
Dialogue: 0,0:20:59.50,0:21:02.01,Default,,0,0,0,,Рахмет сізге Cerbeus
Dialogue: 0,0:21:04.93,0:21:05.68,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:21:06.05,0:21:07.18,Default,,0,0,0,,Куу…
Dialogue: 0,0:21:07.26,0:21:09.01,Default,,0,0,0,,Мен шеше алмадым...
Dialogue: 0,0:21:09.51,0:21:11.97,Default,,0,0,0,,Мен төзімділік түріне тым көп сендім.
Dialogue: 0,0:21:12.72,0:21:15.39,Default,,0,0,0,,Сіздің қазіргі күшіңізге қанағаттануға мүмкіндік жоқ.
Dialogue: 0,0:21:15.48,0:21:18.36,Default,,0,0,0,,Егер бұл Кумичо болса, Рагнарук болуы мүмкін.
Dialogue: 0,0:21:18.44,0:21:20.11,Default,,0,0,0,,Сіз оны тартып алуыңыз керек.
Dialogue: 0,0:21:20.65,0:21:21.82,Default,,0,0,0,,Иттерге қызмет көрсету…
Dialogue: 0,0:21:22.90,0:21:24.32,Default,,0,0,0,,Сәлем! Inusuke!
Dialogue: 0,0:21:24.65,0:21:26.45,Default,,0,0,0,,Келесі жолы мен мұны сенімен жасаймын...
Dialogue: 0,0:21:26.86,0:21:28.99,Default,,0,0,0,,Бір қорқынышты нәрсе болғалы тұр!
Dialogue: 0,0:21:29.57,0:21:31.66,Default,,0,0,0,,Хмф, жанып тұр!
Dialogue: 0,0:21:31.74,0:21:33.62,Default,,0,0,0,,Балто Келесі - Вайя
Dialogue: 0,0:21:33.70,0:21:35.83,Default,,0,0,0,,Ал, мен барамын.
Dialogue: 0,0:21:35.91,0:21:37.33,Default,,0,0,0,,Мен оны қайтарып аламын!
Dialogue: 0,0:21:37.42,0:21:38.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:38.50,0:21:39.25,Default,,0,0,0,,Мен!
Dialogue: 0,0:21:39.33,0:21:40.84,Default,,0,0,0,,Екеуі де жақсы!
Dialogue: 0,0:21:41.00,0:21:43.67,Default,,0,0,0,,Менің және Рагнаруктың жаулары.
Dialogue: 0,0:21:43.88,0:21:44.92,Default,,0,0,0,,Оу!
Dialogue: 0,0:21:46.55,0:21:49.30,Default,,0,0,0,,Бұл жеңіс өтеді! Аңдар!
Dialogue: 0,0:21:49.59,0:21:50.51,Default,,0,0,0,,Оу!
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.32,0:23:29.03,Default,,0,0,0,,Жартылай финал, менің кезегім.
Dialogue: 0,0:23:29.11,0:23:31.03,Default,,0,0,0,,Қарсылас Азуки Бен
Dialogue: 0,0:23:31.11,0:23:33.70,Default,,0,0,0,,Бегемот Валькириге жақындайды
Dialogue: 0,0:23:33.78,0:23:35.33,Default,,0,0,0,,Аңға қарсы жеңу -
Dialogue: 0,0:23:35.41,0:23:37.24,Default,,0,0,0,,Мен де аңға айналамын!
Dialogue: 0,0:23:37.33,0:23:39.75,Default,,0,0,0,,Және Superstars and Ride Out
Dialogue: 0,0:23:39.83,0:23:42.00,Default,,0,0,0,,Кім жеңеді?
Dialogue: 0,0:23:42.08,0:23:43.96,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.04,0:23:46.42,Default,,0,0,0,,Аң! Бегемот хайуан!
Dialogue: 0,0:23:46.50,0:23:48.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.09,0:23:49.67,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.17,0:23:57.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory