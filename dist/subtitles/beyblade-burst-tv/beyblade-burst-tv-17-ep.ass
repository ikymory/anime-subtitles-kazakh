Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.17,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.25,0:00:12.67,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.84,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.93,0:00:17.01,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.10,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.68,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.40,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.48,0:00:28.73,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:32.11,0:00:35.49,Default,,0,0,0,,Шаканың шығанағы клубының қылыш жалындары
Dialogue: 0,0:00:35.74,0:00:37.41,Default,,0,0,0,,Бұл жерде ұшқын бар.
Dialogue: 0,0:00:37.49,0:00:39.83,Default,,0,0,0,,Ой, біз стадионда шайқас болып жатыр едік.
Dialogue: 0,0:00:39.91,0:00:42.41,Default,,0,0,0,,Сырттап өтіңіз! Yggdrasil!
Dialogue: 0,0:00:43.96,0:00:45.08,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:00:45.79,0:00:46.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:50.00,0:00:51.21,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:00:51.59,0:00:53.88,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:53.97,0:00:54.80,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:01:02.68,0:01:05.77,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:01:13.78,0:01:16.15,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:16.49,0:01:21.66,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:32.96,0:01:36.34,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:36.84,0:01:38.97,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:39.39,0:01:43.52,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:43.64,0:01:46.85,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:46.98,0:01:53.40,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:53.69,0:01:58.11,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:01:58.61,0:02:04.04,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:04.16,0:02:06.41,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:06.50,0:02:11.21,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:11.38,0:02:16.46,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:16.76,0:02:19.01,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:19.22,0:02:21.55,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:21.85,0:02:25.77,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:25.93,0:02:30.94,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:31.15,0:02:33.31,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:37.24,0:02:39.49,Default,,0,0,0,,Құдіретті Экскалибур!
Dialogue: 0,0:02:41.53,0:02:42.87,Default,,0,0,0,,Ойын бар!
Dialogue: 0,0:02:42.95,0:02:43.95,Default,,0,0,0,,Excalibur
Dialogue: 0,0:02:44.03,0:02:46.12,Default,,0,0,0,,Артық бітіру үшін 1 ұпай
Dialogue: 0,0:02:46.20,0:02:49.04,Default,,0,0,0,,Бұл Шақаның иығын сілкіп тастауға да көмектеспейді.
Dialogue: 0,0:02:49.12,0:02:51.17,Default,,0,0,0,,Алғашқы байланыста
Dialogue: 0,0:02:51.25,0:02:54.13,Default,,0,0,0,,Аяқталды Қандай күш!
Dialogue: 0,0:02:54.21,0:02:56.21,Default,,0,0,0,,Жаңа есіме түсті
Dialogue: 0,0:02:56.30,0:02:58.92,Default,,0,0,0,,«Шақа бәрін бұзады»
Dialogue: 0,0:02:59.01,0:03:00.05,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:00.13,0:03:02.55,Default,,0,0,0,,Осындай қауесеттер бар...
Dialogue: 0,0:03:02.64,0:03:04.64,Default,,0,0,0,,Барлығын құрту...
Dialogue: 0,0:03:07.97,0:03:08.73,Default,,0,0,0,,Уф
Dialogue: 0,0:03:10.06,0:03:11.77,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:03:11.85,0:03:13.77,Default,,0,0,0,,Өртеніп жатыр!
Dialogue: 0,0:03:13.86,0:03:16.11,Default,,0,0,0,,Шака шынымен де мықты!
Dialogue: 0,0:03:16.19,0:03:19.53,Default,,0,0,0,,Сенің соққың да жаман болмады, Балто.
Dialogue: 0,0:03:19.90,0:03:22.74,Default,,0,0,0,,Тек финалда Шуға қарсы шықтым.
Dialogue: 0,0:03:22.95,0:03:24.03,Default,,0,0,0,,Ішек
Dialogue: 0,0:03:24.12,0:03:26.66,Default,,0,0,0,,Шака! Мені неге мақтайсың?
Dialogue: 0,0:03:26.87,0:03:27.58,Default,,0,0,0,,Чика
Dialogue: 0,0:03:27.66,0:03:30.91,Default,,0,0,0,,Бір соққыдан артық финиш алған жоқсыз ба?
Dialogue: 0,0:03:31.00,0:03:33.88,Default,,0,0,0,,Орташа жігіт болса, жарылып кетеді.
Dialogue: 0,0:03:33.96,0:03:34.75,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:35.08,0:03:36.42,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:03:39.84,0:03:42.80,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:03:44.93,0:03:47.60,Default,,0,0,0,,Экскалибурдың бірінші соққысы
Dialogue: 0,0:03:47.68,0:03:48.85,Default,,0,0,0,,Егер сіз оны жесеңіз
Dialogue: 0,0:03:48.93,0:03:51.35,Default,,0,0,0,,Бірден бәрі аяқталды.
Dialogue: 0,0:03:51.56,0:03:52.44,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:03:53.06,0:03:54.90,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:03:54.98,0:03:58.23,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:03:58.52,0:04:00.94,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:05.16,0:04:06.53,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:04:06.62,0:04:07.91,Default,,0,0,0,,Бұрынғыдан жылдамырақ
Dialogue: 0,0:04:07.99,0:04:08.99,Default,,0,0,0,,Егер бұл...
Dialogue: 0,0:04:11.04,0:04:12.04,Default,,0,0,0,,Жалтарған
Dialogue: 0,0:04:12.12,0:04:14.42,Default,,0,0,0,,Жарайды, қазір шабуыл жасайық!
Dialogue: 0,0:04:14.50,0:04:15.75,Default,,0,0,0,,Жүр!
Dialogue: 0,0:04:20.00,0:04:20.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:21.17,0:04:23.63,Default,,0,0,0,,Шака ұшыру құралын көлденең ұстайды...
Dialogue: 0,0:04:23.72,0:04:25.34,Default,,0,0,0,,Мен өз жолымды өзгерттім.
Dialogue: 0,0:04:25.72,0:04:28.22,Default,,0,0,0,,Экскалибур бірінші соққымен тойтарыс берді.
Dialogue: 0,0:04:28.30,0:04:31.72,Default,,0,0,0,,Жылдамдаңыз және ағынды шұңқырдың бүйірінен айналып өтіңіз...
Dialogue: 0,0:04:31.81,0:04:33.02,Default,,0,0,0,,(Шабуыл дыбысы)
Dialogue: 0,0:04:33.10,0:04:34.48,Default,,0,0,0,,лақтырылды
Dialogue: 0,0:04:34.56,0:04:37.86,Default,,0,0,0,,Жоқ, сіз бұл биіктікте аяқтай алмайсыз.
Dialogue: 0,0:04:37.94,0:04:39.02,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:04:40.48,0:04:41.53,Default,,0,0,0,,Яббе
Dialogue: 0,0:04:41.61,0:04:42.61,Default,,0,0,0,,Спайк аймағы
Dialogue: 0,0:04:43.19,0:04:45.07,Default,,0,0,0,,Егер соны соқсаңыз...
Dialogue: 0,0:04:45.15,0:04:47.49,Default,,0,0,0,,Валькирия бұзылды
Dialogue: 0,0:04:49.62,0:04:51.45,Default,,0,0,0,,Таэро! валкири
Dialogue: 0,0:04:51.54,0:04:55.00,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:04:55.75,0:04:56.87,Default,,0,0,0,,Уау
Dialogue: 0,0:04:56.96,0:04:58.54,Default,,0,0,0,,Мен создым!
Dialogue: 0,0:04:58.63,0:05:00.13,Default,,0,0,0,,Жарылып кетпеңіз!
Dialogue: 0,0:05:00.21,0:05:01.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.17,0:05:04.42,Default,,0,0,0,,Бірақ Бейдің екпіні айтарлықтай баяулады.
Dialogue: 0,0:05:04.51,0:05:07.51,Default,,0,0,0,,Бұл не, бұл өзгереді ме?
Dialogue: 0,0:05:07.59,0:05:08.76,Default,,0,0,0,,Мен әлі білмеймін
Dialogue: 0,0:05:08.85,0:05:09.80,Default,,0,0,0,,​​О?
Dialogue: 0,0:05:09.89,0:05:13.31,Default,,0,0,0,,Excalibur - супер шабуыл түрі.
Dialogue: 0,0:05:13.77,0:05:16.35,Default,,0,0,0,,Шабуыл күшті болғанымен, шыдамдылық жоқ.
Dialogue: 0,0:05:16.89,0:05:19.94,Default,,0,0,0,,Сізде әлі де төзімділік бар сияқты.
Dialogue: 0,0:05:20.02,0:05:22.28,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,0:05:22.69,0:05:23.99,Default,,0,0,0,,Тағы бір соққы...
Dialogue: 0,0:05:24.19,0:05:26.61,Default,,0,0,0,,Валькири шыдай ала ма?
Dialogue: 0,0:05:26.95,0:05:28.32,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:05:29.62,0:05:30.95,Default,,0,0,0,,Дұрыс емес пе?
Dialogue: 0,0:05:31.03,0:05:33.04,Default,,0,0,0,,Валькирияның жылдамдығы төмендейді...
Dialogue: 0,0:05:33.16,0:05:34.91,Default,,0,0,0,,Уақыт өшірулі болды.
Dialogue: 0,0:05:35.00,0:05:36.87,Default,,0,0,0,,Мен қазір құтқарылдым...
Dialogue: 0,0:05:36.96,0:05:40.21,Default,,0,0,0,,Бірақ... Валькири қазірдің өзінде...
Dialogue: 0,0:05:40.29,0:05:42.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:42.17,0:05:43.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:43.67,0:05:46.72,Default,,0,0,0,,Экскалибур да шыдамсыз...
Dialogue: 0,0:05:47.76,0:05:51.05,Default,,0,0,0,,Аа, тоқтап қалды.
Dialogue: 0,0:05:55.43,0:05:58.10,Default,,0,0,0,,Сонымен қатар, бұл айналмалы финишпен ұтыс ойыны.
Dialogue: 0,0:05:58.19,0:05:59.65,Default,,0,0,0,,Ха~
Dialogue: 0,0:05:59.73,0:06:01.06,Default,,0,0,0,,Уф
Dialogue: 0,0:06:01.69,0:06:04.11,Default,,0,0,0,,Экскалибурдың шыдамдылығы жоқ...
Dialogue: 0,0:06:04.19,0:06:06.65,Default,,0,0,0,,Айналу төмендегенде, ол тез тоқтайды
Dialogue: 0,0:06:06.94,0:06:09.20,Default,,0,0,0,,Валькири өзін жақсы ұстады
Dialogue: 0,0:06:09.28,0:06:13.33,Default,,0,0,0,,Мен сізге жабысқақ жағымда қатты ұқсаймын, Балто.
Dialogue: 0,0:06:13.41,0:06:14.99,Default,,0,0,0,,Өйткені ол менің серіктесім
Dialogue: 0,0:06:16.08,0:06:18.54,Default,,0,0,0,,Гахаха...
Dialogue: 0,0:06:19.04,0:06:21.58,Default,,0,0,0,,Мен үшінші шайқасты асыға күтемін.
Dialogue: 0,0:06:21.67,0:06:23.34,Default,,0,0,0,,Мен де! Шака!
Dialogue: 0,0:06:26.21,0:06:27.30,Default,,0,0,0,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,0:06:29.68,0:06:31.97,Default,,0,0,0,,Раш қайтадан атылды
Dialogue: 0,0:06:32.30,0:06:33.89,Default,,0,0,0,,Бар күшімізбен жүрейік!
Dialogue: 0,0:06:34.22,0:06:37.23,Default,,0,0,0,,Мен қуаныштымын, Балто, бұл үшін...
Dialogue: 0,0:06:38.06,0:06:40.94,Default,,0,0,0,,Мен оны пайдаланамын деп ешқашан ойламадым.
Dialogue: 0,0:06:44.52,0:06:45.32,Default,,0,0,0,,Ах
Dialogue: 0,0:06:45.90,0:06:47.03,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:06:48.65,0:06:49.78,Default,,0,0,0,,Ха
Dialogue: 0,0:06:51.66,0:06:52.37,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:53.07,0:06:55.08,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:06:55.16,0:06:58.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:58.83,0:07:01.33,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:01.42,0:07:03.25,Default,,0,0,0,,Қалай?
Dialogue: 0,0:07:05.42,0:07:07.13,Default,,0,0,0,,Аа, бұрынғыдан басқаша.
Dialogue: 0,0:07:07.21,0:07:09.84,Default,,0,0,0,,Айналудың да, жылдамдықтың да шама реті әртүрлі.
Dialogue: 0,0:07:10.05,0:07:13.47,Default,,0,0,0,,Бұл соққы Шаканың физикалық қабілеті-
Dialogue: 0,0:07:13.55,0:07:16.22,Default,,0,0,0,,Бұл бұрынғы турнирден де жақсы.
Dialogue: 0,0:07:16.51,0:07:18.72,Default,,0,0,0,,Бару~ Валькирия
Dialogue: 0,0:07:19.14,0:07:21.81,Default,,0,0,0,,Сіз қайтадан аяқтайсыз.
Dialogue: 0,0:07:22.15,0:07:23.10,Default,,0,0,0,,Ха
Dialogue: 0,0:07:27.32,0:07:29.82,Default,,0,0,0,,Кешіріңіз! Бұл сәтсіз соққы
Dialogue: 0,0:07:32.66,0:07:34.74,Default,,0,0,0,,Шақаның оқуы дұрыс болмады ма?
Dialogue: 0,0:07:34.91,0:07:39.16,Default,,0,0,0,,Жақсы, мәселені шешуге бірнеше секунд қажет.
Dialogue: 0,0:07:43.29,0:07:44.25,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:44.33,0:07:45.71,Default,,0,0,0,,Экскалибур
Dialogue: 0,0:07:45.79,0:07:48.25,Default,,0,0,0,,Шабуыл қабаттың бір нүктесіне шоғырланды.
Dialogue: 0,0:07:48.34,0:07:50.09,Default,,0,0,0,,Бей бір соққымен
Dialogue: 0,0:07:50.21,0:07:53.13,Default,,0,0,0,,Шақаның құдіреті соған қосылса...!
Dialogue: 0,0:07:53.43,0:07:54.09,Default,,0,0,0,,Ха
Dialogue: 0,0:07:54.18,0:07:55.89,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:07:57.68,0:07:58.56,Default,,0,0,0,,Ааах!
Dialogue: 0,0:07:59.68,0:08:02.64,Default,,0,0,0,,Excalibur Burst Finish
Dialogue: 0,0:08:02.73,0:08:05.69,Default,,0,0,0,,Шака 3-0 жеңді!
Dialogue: 0,0:08:06.06,0:08:08.07,Default,,0,0,0,,Бұл Excalibur...
Dialogue: 0,0:08:08.15,0:08:09.98,Default,,0,0,0,,Бір жүзді қылыш
Dialogue: 0,0:08:10.07,0:08:12.70,Default,,0,0,0,,Шақа бәрін бұзады...
Dialogue: 0,0:08:12.78,0:08:15.11,Default,,0,0,0,,Сыбыс рас еді...
Dialogue: 0,0:08:17.07,0:08:18.53,Default,,0,0,0,,Уф
Dialogue: 0,0:08:18.62,0:08:20.62,Default,,0,0,0,,Бұл сәл көбірек болды
Dialogue: 0,0:08:20.70,0:08:25.33,Default,,0,0,0,,Ах, неге аяғында сәтсіз ату бар?
Dialogue: 0,0:08:25.42,0:08:26.25,Default,,0,0,0,,～
Dialogue: 0,0:08:26.33,0:08:28.88,Default,,0,0,0,,Мен сені осыншама жерге барады деп ойламаппын.
Dialogue: 0,0:08:28.96,0:08:29.92,Default,,0,0,0,,О...
Dialogue: 0,0:08:30.00,0:08:31.21,Default,,0,0,0,,Үшінші шайқас-
Dialogue: 0,0:08:31.30,0:08:33.80,Default,,0,0,0,,Мен кездейсоқ қуат жағын қолдандым.
Dialogue: 0,0:08:33.88,0:08:35.18,Default,,0,0,0,,Гахахаха
Dialogue: 0,0:08:36.14,0:08:37.72,Default,,0,0,0,,Қуат жағы?
Dialogue: 0,0:08:37.80,0:08:40.01,Default,,0,0,0,,дегеніміз не?
Dialogue: 0,0:08:40.22,0:08:41.56,Default,,0,0,0,,Хмм?
Dialogue: 0,0:08:41.64,0:08:44.94,Default,,0,0,0,,Шаканың ұшырғышы мен орағышы да ерекше.
Dialogue: 0,0:08:45.02,0:08:46.40,Default,,0,0,0,,Қылыш орауыш
Dialogue: 0,0:08:46.85,0:08:49.32,Default,,0,0,0,,Қылыш тәрізді орауыштың екі жағында-
Dialogue: 0,0:08:49.40,0:08:50.48,Default,,0,0,0,,Пышағы бар
Dialogue: 0,0:08:50.82,0:08:53.24,Default,,0,0,0,,Орамның екі жағында қалақшалар бар...
Dialogue: 0,0:08:53.32,0:08:55.32,Default,,0,0,0,,Әдетте бір жағы ғана, солай ма?
Dialogue: 0,0:08:55.70,0:08:59.08,Default,,0,0,0,,Қуат жағында ұшына дейін созылатын жүзі бар.
Dialogue: 0,0:08:59.87,0:09:02.70,Default,,0,0,0,,Орамның ұзындығы шекке дейін пайдаланылады
Dialogue: 0,0:09:02.79,0:09:04.79,Default,,0,0,0,,Бұл күшті атуға болатынын білдіре ме?
Dialogue: 0,0:09:04.87,0:09:06.75,Default,,0,0,0,,Бұл күш жағы…
Dialogue: 0,0:09:07.08,0:09:09.25,Default,,0,0,0,,Ату күшейеді, бірақ
Dialogue: 0,0:09:09.34,0:09:11.21,Default,,0,0,0,,Бұл бақылауды қиындатады.
Dialogue: 0,0:09:11.42,0:09:14.84,Default,,0,0,0,,Сәтсіз түсіру мүмкіндігі де арта ма?
Dialogue: 0,0:09:14.92,0:09:17.43,Default,,0,0,0,,Ах, бірақ егер сіз сәттілікке жетсеңіз ...
Dialogue: 0,0:09:17.51,0:09:19.26,Default,,0,0,0,,Өлімге әкелетін атуға айналады
Dialogue: 0,0:09:19.80,0:09:20.89,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:09:22.77,0:09:25.98,Default,,0,0,0,,Әлгі Шақа... ол байыпты.
Dialogue: 0,0:09:26.81,0:09:28.69,Default,,0,0,0,,Сіз оны әлі де сезінесіз бе?
Dialogue: 0,0:09:29.06,0:09:32.11,Default,,0,0,0,,Балтоның ішіндегі жүздік талант
Dialogue: 0,0:09:32.19,0:09:33.19,Default,,0,0,0,,Иә
Dialogue: 0,0:09:34.36,0:09:37.57,Default,,0,0,0,,(Жұмбақ гүрілдеген дыбыс)
Dialogue: 0,0:09:37.66,0:09:39.32,Default,,0,0,0,,Не? не?
Dialogue: 0,0:09:39.41,0:09:40.78,Default,,0,0,0,,Біртүрлі дыбыс шықты.
Dialogue: 0,0:09:40.87,0:09:42.24,Default,,0,0,0,,Мен де естідім.
Dialogue: 0,0:09:42.33,0:09:43.29,Default,,0,0,0,,Каминари?
Dialogue: 0,0:09:43.37,0:09:44.87,Default,,0,0,0,,Жер сілкінісі?
Dialogue: 0,0:09:44.95,0:09:47.08,Default,,0,0,0,,Не? Қазір не болды?
Dialogue: 0,0:09:47.16,0:09:48.62,Default,,0,0,0,,Бұл менің ішім.
Dialogue: 0,0:09:48.79,0:09:49.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:49.79,0:09:52.75,Default,,0,0,0,,(асқазанның айқайлауы)
Dialogue: 0,0:09:54.71,0:09:57.68,Default,,0,0,0,,Га~хахахаха
Dialogue: 0,0:09:58.18,0:10:00.76,Default,,0,0,0,,Тамақ ішейік! Меши! Меши!
Dialogue: 0,0:10:02.72,0:10:05.39,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:10:05.47,0:10:10.02,Default,,0,0,0,,Өйткені, шайқастан кейінгі ас ең жақсы.
Dialogue: 0,0:10:10.10,0:10:12.61,Default,,0,0,0,,Бар-нии әрқашан дәмді, солай ма?
Dialogue: 0,0:10:12.69,0:10:14.36,Default,,0,0,0,,Не жесең де
Dialogue: 0,0:10:14.44,0:10:17.82,Default,,0,0,0,,О! Анамның наны ең жақсы
Dialogue: 0,0:10:17.90,0:10:19.82,Default,,0,0,0,,О, бұл ностальгиялық.
Dialogue: 0,0:10:19.91,0:10:21.70,Default,,0,0,0,,Балтоның анасының наны!
Dialogue: 0,0:10:21.78,0:10:24.08,Default,,0,0,0,,Әдеттегідей дәмді!
Dialogue: 0,0:10:24.16,0:10:25.79,Default,,0,0,0,,Келесі жолы тамақтаныңыз!
Dialogue: 0,0:10:25.87,0:10:26.83,Default,,0,0,0,,Әрине!
Dialogue: 0,0:10:26.91,0:10:29.33,Default,,0,0,0,,Мен сені тойғызамын!
Dialogue: 0,0:10:29.54,0:10:31.92,Default,,0,0,0,,Шақа келгенде, дүкеннен нан ал.
Dialogue: 0,0:10:32.00,0:10:33.67,Default,,0,0,0,,Бәрі біткен сияқты
Dialogue: 0,0:10:33.75,0:10:37.09,Default,,0,0,0,,Хахаха, мен Токониканың сыбағасын қалдырамын.
Dialogue: 0,0:10:37.30,0:10:38.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:38.63,0:10:40.26,Default,,0,0,0,,Менің... Менікі не?
Dialogue: 0,0:10:40.34,0:10:41.72,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:10:41.80,0:10:43.43,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:43.51,0:10:44.85,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:10:44.93,0:10:46.64,Default,,0,0,0,,Бала күнгі дос...
Dialogue: 0,0:10:47.22,0:10:48.43,Default,,0,0,0,,Жақсы
Dialogue: 0,0:10:48.52,0:10:49.39,Default,,0,0,0,,Әлде бұл жыныстық сипаттағы қорлау үшін сылтау ма?
Dialogue: 0,0:10:52.27,0:10:54.73,Default,,0,0,0,,Жарайды, мен де тамақ жедім.
Dialogue: 0,0:10:56.07,0:10:57.07,Default,,0,0,0,,Сәлем Шака!
Dialogue: 0,0:10:57.15,0:10:57.65,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:57.74,0:10:59.61,Default,,0,0,0,,Енді менімен жарысатын кез келді!
Dialogue: 0,0:10:59.70,0:11:02.20,Default,,0,0,0,,Мен Балттың жоғалуы үшін жауап қайтарамын.
Dialogue: 0,0:11:02.28,0:11:03.24,Default,,0,0,0,,Кумичо!
Dialogue: 0,0:11:03.32,0:11:04.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:04.83,0:11:08.41,Default,,0,0,0,,Гахахахаха
Dialogue: 0,0:11:08.50,0:11:10.71,Default,,0,0,0,,Ей, күлкілі ештеңе айтпа.
Dialogue: 0,0:11:11.12,0:11:13.67,Default,,0,0,0,,Оле Бей бұрыштарды қия алмайды.
Dialogue: 0,0:11:13.75,0:11:16.92,Default,,0,0,0,,Бұл тым көп пе?
Dialogue: 0,0:11:17.00,0:11:20.38,Default,,0,0,0,,Аудандық турнирде сол жігіттен жеңіліп қалған шығарсың.
Dialogue: 0,0:11:20.47,0:11:23.05,Default,,0,0,0,,Шақа ондай әлжуаз адаммен жұмыс жасамайды.
Dialogue: 0,0:11:23.14,0:11:24.72,Default,,0,0,0,,Мен әлсіз емеспін
Dialogue: 0,0:11:24.80,0:11:28.56,Default,,0,0,0,,Тіпті Валькири де тәжірибелік матчтарда бірнеше рет жеңіске жетті.
Dialogue: 0,0:11:28.64,0:11:30.14,Default,,0,0,0,,Осы Рагнарукта
Dialogue: 0,0:11:30.23,0:11:31.56,Default,,0,0,0,,Рагнарук?
Dialogue: 0,0:11:32.14,0:11:35.11,Default,,0,0,0,,Сіз Рагнаруктың сары тауысыз ба?
Dialogue: 0,0:11:35.61,0:11:37.32,Default,,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:11:37.40,0:11:39.03,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:11:39.36,0:11:41.82,Default,,0,0,0,,Ендеше ол неге Кумичо деп аталады?
Dialogue: 0,0:11:42.11,0:11:44.70,Default,,0,0,0,,Шақа деп атайтын сияқтысың.
Dialogue: 0,0:11:45.37,0:11:47.45,Default,,0,0,0,,Мен Жанып тұрған ғибадатхананың «Шасымын
Dialogue: 0,0:11:47.54,0:11:49.70,Default,,0,0,0,,Қайзаның «Қасы» – Шақа.
Dialogue: 0,0:11:49.79,0:11:52.04,Default,,0,0,0,,Кумичо - Кумичо!
Dialogue: 0,0:11:52.12,0:11:55.33,Default,,0,0,0,,Кумичо керемет емес пе?
Dialogue: 0,0:11:55.42,0:11:58.50,Default,,0,0,0,,Облыстық турнирде жеңімпаз атанған фавориттердің бірі болды.
Dialogue: 0,0:11:59.09,0:12:01.42,Default,,0,0,0,,Түрлі жарыстарда да нәтижеге қол жеткізген.
Dialogue: 0,0:12:01.84,0:12:03.43,Default,,0,0,0,,Ол дарынды жүзші.
Dialogue: 0,0:12:03.51,0:12:05.01,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,0:12:05.09,0:12:06.85,Default,,0,0,0,,Мен оны қарап шыққан шығармын.
Dialogue: 0,0:12:06.93,0:12:08.06,Default,,0,0,0,,Сонымен қатар, лифчиктің ішкі толтырғышы бар, сондықтан шын мәнінде…
Dialogue: 0,0:12:08.14,0:12:10.06,Default,,0,0,0,,Менімен жарыс! Шака!
Dialogue: 0,0:12:10.14,0:12:11.31,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:11.39,0:12:12.89,Default,,0,0,0,,О, не?
Dialogue: 0,0:12:12.98,0:12:16.15,Default,,0,0,0,,Шу, сен қазір атаңның үйіне баруың керек.
Dialogue: 0,0:12:16.23,0:12:17.57,Default,,0,0,0,,Емдеуге уақыт келді.
Dialogue: 0,0:12:17.90,0:12:18.90,Default,,0,0,0,,О
Dialogue: 0,0:12:18.98,0:12:19.78,Default,,0,0,0,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 0,0:12:19.86,0:12:20.78,Default,,0,0,0,,Растау
Dialogue: 0,0:12:20.86,0:12:21.78,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:12:21.86,0:12:23.99,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:12:24.20,0:12:27.78,Default,,0,0,0,,Далалық жаттығу. Бұл түскі астан кейінгі күнделікті жұмыс.
Dialogue: 0,0:12:27.87,0:12:29.37,Default,,0,0,0,,Шайқас содан кейін болады
Dialogue: 0,0:12:29.45,0:12:30.74,Default,,0,0,0,,Арнайы дайындық!
Dialogue: 0,0:12:30.83,0:12:32.25,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,0:12:32.33,0:12:33.16,Default,,0,0,0,,Мен де!
Dialogue: 0,0:12:33.25,0:12:34.33,Default,,0,0,0,,Мен де!
Dialogue: 0,0:12:34.42,0:12:35.42,Default,,0,0,0,,Мен де!
Dialogue: 0,0:12:35.50,0:12:37.59,Default,,0,0,0,,（•）
Dialogue: 0,0:12:37.71,0:12:41.17,Default,,0,0,0,,Шақаның қатал жаттығуына ілесе алмайсың.
Dialogue: 0,0:12:41.26,0:12:42.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:43.55,0:12:45.68,Default,,0,0,0,,Сол балалар бірден дыбыс шығаруы керек.
Dialogue: 0,0:12:45.76,0:12:47.64,Default,,0,0,0,,Мен қайтып келетін шығармын
Dialogue: 0,0:12:49.81,0:12:52.85,Default,,0,0,0,,Алдымен өзегіңізді жаттықтырыңыз.
Dialogue: 0,0:12:52.93,0:12:55.14,Default,,0,0,0,,Тепе-теңдікті дамытуға жаттықтыру.
Dialogue: 0,0:12:55.23,0:12:57.23,Default,,0,0,0,,Уа, мен құлап жатырмын.
Dialogue: 0,0:12:57.31,0:12:59.61,Default,,0,0,0,,Иә! Иә!
Dialogue: 0,0:12:59.69,0:13:02.32,Default,,0,0,0,,Неліктен жаттығуға арналған әктас үңгірі?
Dialogue: 0,0:13:02.40,0:13:04.49,Default,,0,0,0,,Слип!
Dialogue: 0,0:13:04.57,0:13:05.74,Default,,0,0,0,,Өшіру…
Dialogue: 0,0:13:06.61,0:13:08.24,Default,,0,0,0,,Аяқ пен тізе неден ауырады?
Dialogue: 0,0:13:08.32,0:13:10.53,Default,,0,0,0,,Ең негізгісі!
Dialogue: 0,0:13:10.91,0:13:13.91,Default,,0,0,0,,Сіз бұл жерге көтеріліп жатырсыз ба?
Dialogue: 0,0:13:14.00,0:13:15.46,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:15.96,0:13:17.58,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:17.67,0:13:19.67,Default,,0,0,0,,Қол күшін арттырыңыз!
Dialogue: 0,0:13:19.75,0:13:20.59,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:13:20.67,0:13:22.67,Default,,0,0,0,,Соңғы жанасу - жол жұмысы!
Dialogue: 0,0:13:22.76,0:13:24.01,Default,,0,0,0,,Кіріңіз!
Dialogue: 0,0:13:24.47,0:13:25.26,Default,,0,0,0,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:13:25.34,0:13:26.72,Default,,0,0,0,,Жүгіріп жатырсыз ба?
Dialogue: 0,0:13:27.18,0:13:28.64,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:13:28.72,0:13:30.47,Default,,0,0,0,,Әй, Балто!
Dialogue: 0,0:13:30.55,0:13:31.68,Default,,0,0,0,,Иә
Dialogue: 0,0:13:32.26,0:13:34.27,Default,,0,0,0,,Бұл не? Сен... неге мені қуалап жүрсің?
Dialogue: 0,0:13:34.35,0:13:36.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.31,0:13:38.94,Default,,0,0,0,,Сіз осы уақытқа дейін келдіңіз. Барғың келе ме?
Dialogue: 0,0:13:39.02,0:13:41.32,Default,,0,0,0,,(Игги) Ұф! (Джозеф) Хи-хи
Dialogue: 0,0:13:42.11,0:13:44.69,Default,,0,0,0,,Хун хун тея!
Dialogue: 0,0:13:44.78,0:13:49.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:50.03,0:13:51.28,Default,,0,0,0,,Балто!
Dialogue: 0,0:13:51.37,0:13:54.45,Default,,0,0,0,,Бұл жол жұмысы қайда?
Dialogue: 0,0:13:54.54,0:13:56.96,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:13:57.04,0:13:58.12,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:13:58.21,0:13:59.08,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:13:59.79,0:14:02.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:02.13,0:14:04.26,Default,,0,0,0,,Ватто (Рантаро) Ауырып тұр
Dialogue: 0,0:14:04.46,0:14:05.76,Default,,0,0,0,,Уау! Уау
Dialogue: 0,0:14:07.17,0:14:08.76,Default,,0,0,0,,Wow...
Dialogue: 0,0:14:09.09,0:14:10.43,Default,,0,0,0,,Гяаах!
Dialogue: 0,0:14:10.51,0:14:14.64,Default,,0,0,0,,(Бөрененің сықырлаған дыбысы)
Dialogue: 0,0:14:14.72,0:14:15.35,Default,,0,0,0,,Хен
Dialogue: 0,0:14:15.43,0:14:17.14,Default,,0,0,0,,Жоқ, жоқ, жоқ...
Dialogue: 0,0:14:18.60,0:14:22.19,Default,,0,0,0,,Осы шөлдеген таулардың тереңінде—
Dialogue: 0,0:14:22.27,0:14:25.07,Default,,0,0,0,,Хун ғұн
Dialogue: 0,0:14:25.15,0:14:27.07,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:14:28.03,0:14:31.74,Default,,0,0,0,,Гугугугугу
Dialogue: 0,0:14:31.82,0:14:34.87,Default,,0,0,0,,Жарайды, барлығы келді.
Dialogue: 0,0:14:34.95,0:14:37.45,Default,,0,0,0,,Онда мен бірінші үйге барамын.
Dialogue: 0,0:14:39.12,0:14:40.08,Default,,0,0,0,,О!
Dialogue: 0,0:14:40.17,0:14:41.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:41.67,0:14:42.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:42.75,0:14:45.25,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:45.46,0:14:47.17,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:14:47.26,0:14:48.88,Default,,0,0,0,,Егер Шака мұны істесе...
Dialogue: 0,0:14:48.97,0:14:50.55,Default,,0,0,0,,Мен де!
Dialogue: 0,0:14:50.63,0:14:51.68,Default,,0,0,0,,Балто~
Dialogue: 0,0:14:52.22,0:14:53.89,Default,,0,0,0,,Өзіңізді қатты итермеңіз
Dialogue: 0,0:14:53.97,0:14:55.89,Default,,0,0,0,,Оны қазір айтуым керек пе?
Dialogue: 0,0:14:55.97,0:14:58.10,Default,,0,0,0,,Төрт он император күткендей
Dialogue: 0,0:14:58.18,0:15:00.44,Default,,0,0,0,,Ол адам емес.
Dialogue: 0,0:15:00.52,0:15:02.27,Default,,0,0,0,,Мен жеңілмеймін!
Dialogue: 0,0:15:02.61,0:15:03.86,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:15:05.77,0:15:08.61,Default,,0,0,0,,(Жапырақтардың сыбдыры)
Dialogue: 0,0:15:08.69,0:15:13.62,Default,,0,0,0,,Уф... Мен келдім.
Dialogue: 0,0:15:13.70,0:15:14.78,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:15:14.87,0:15:16.79,Default,,0,0,0,,Шакадан кейін...
Dialogue: 0,0:15:16.87,0:15:17.54,Default,,0,0,0,,Әй
Dialogue: 0,0:15:17.62,0:15:19.16,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:15:19.25,0:15:22.42,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:15:22.50,0:15:24.08,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:15:24.17,0:15:25.00,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:15:25.59,0:15:27.17,Default,,0,0,0,,Жақсы емес, балалар.
Dialogue: 0,0:15:27.80,0:15:29.55,Default,,0,0,0,,Барлығы, бұл үлкен мәселе!
Dialogue: 0,0:15:29.63,0:15:31.80,Default,,0,0,0,,Балтоның досы күткендей.
Dialogue: 0,0:15:32.13,0:15:33.09,Default,,0,0,0,,Хун
Dialogue: 0,0:15:33.30,0:15:34.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:34.60,0:15:35.85,Default,,0,0,0,,Хуаншанға не болды?
Dialogue: 0,0:15:35.93,0:15:37.60,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:15:38.10,0:15:41.69,Default,,0,0,0,,Ааааааааааааааааааааааааааааа
Dialogue: 0,0:15:41.77,0:15:45.61,Default,,0,0,0,,Дааа~
Dialogue: 0,0:15:45.69,0:15:46.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:47.15,0:15:48.90,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:15:48.98,0:15:50.24,Default,,0,0,0,,Кумичо…
Dialogue: 0,0:15:50.32,0:15:51.36,Default,,0,0,0,,Куу…
Dialogue: 0,0:15:51.82,0:15:54.41,Default,,0,0,0,,Көп уақыт өтті...
Dialogue: 0,0:15:54.49,0:15:55.20,Default,,0,0,0,,А?
Dialogue: 0,0:16:00.33,0:16:02.67,Default,,0,0,0,,Сонымен... иә!
Dialogue: 0,0:16:02.75,0:16:05.13,Default,,0,0,0,,Угяаа~
Dialogue: 0,0:16:05.21,0:16:08.09,Default,,0,0,0,,Шынжыр табандар~!
Dialogue: 0,0:16:08.71,0:16:11.30,Default,,0,0,0,,Иә~
Dialogue: 0,0:16:11.38,0:16:12.59,Default,,0,0,0,,Оқудан басқа
Dialogue: 0,0:16:12.68,0:16:15.22,Default,,0,0,0,,Менің ойымша, Кумичоға ұнамайтын нәрсе бар.
Dialogue: 0,0:16:15.30,0:16:16.39,Default,,0,0,0,,Эй
Dialogue: 0,0:16:16.47,0:16:19.06,Default,,0,0,0,,Шақа, сені қанша күтемін?
Dialogue: 0,0:16:19.14,0:16:20.35,Default,,0,0,0,,Нашар Нашар~
Dialogue: 0,0:16:20.43,0:16:23.06,Default,,0,0,0,,Әй, сенің түрің қорқынышты екен.
Dialogue: 0,0:16:23.14,0:16:24.44,Default,,0,0,0,,Сіз мұны айтпайсыз ба?
Dialogue: 0,0:16:24.52,0:16:25.98,Default,,0,0,0,,Гахахахаха
Dialogue: 0,0:16:31.07,0:16:32.90,Default,,0,0,0,,Сәттілік! Кумичо
Dialogue: 0,0:16:32.99,0:16:34.53,Default,,0,0,0,,Шака да жеңілмейді
Dialogue: 0,0:16:34.61,0:16:36.62,Default,,0,0,0,,Екеуіміз де жеңілмейміз!
Dialogue: 0,0:16:36.70,0:16:38.53,Default,,0,0,0,,Сонда сіз жеңе алмайсыз.
Dialogue: 0,0:16:38.62,0:16:40.12,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:16:40.20,0:16:42.33,Default,,0,0,0,,Бейбатлды үнемі көргім келеді.
Dialogue: 0,0:16:42.41,0:16:43.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:43.62,0:16:45.17,Default,,0,0,0,,Ұзақ уақыт бойы...
Dialogue: 0,0:16:45.25,0:16:48.96,Default,,0,0,0,,Бұл Шаканы алатын шайқас түрі, ол тек 30 секундты алады.
Dialogue: 0,0:16:49.04,0:16:51.96,Default,,0,0,0,,Xeno Excalibur Shaka Vs.
Dialogue: 0,0:16:52.05,0:16:54.80,Default,,0,0,0,,Рагнарук Рантаро Кияма көтерілуі
Dialogue: 0,0:16:55.34,0:16:56.59,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:16:57.72,0:17:00.14,Default,,0,0,0,,Excalibur – шабуыл түрі
Dialogue: 0,0:17:00.31,0:17:01.72,Default,,0,0,0,,Бұл күш...
Dialogue: 0,0:17:01.93,0:17:04.48,Default,,0,0,0,,Әлсіз шабуыл жасасаңыз да, жеңіске жету мүмкіндігіңіз аз.
Dialogue: 0,0:17:04.81,0:17:06.19,Default,,0,0,0,,Ал егер...
Dialogue: 0,0:17:06.44,0:17:09.36,Default,,0,0,0,,Балто сияқты, бірінші байланыстан аулақ болыңыз.
Dialogue: 0,0:17:09.44,0:17:10.82,Default,,0,0,0,,Өзіңіздің әлсіз жақтарыңызды табыңыз!
Dialogue: 0,0:17:11.03,0:17:12.69,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:17:13.07,0:17:16.24,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:16.66,0:17:18.91,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:18.99,0:17:19.87,Default,,0,0,0,,Урья~
Dialogue: 0,0:17:23.04,0:17:26.21,Default,,0,0,0,,Экскалибурдың әлсіздігі - төзімділіктің жоқтығы
Dialogue: 0,0:17:26.54,0:17:30.17,Default,,0,0,0,,Егер сіз орталық позицияны алып, қорғанысқа шықсаңыз, Рагнарук жеңеді!
Dialogue: 0,0:17:30.25,0:17:31.13,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:31.21,0:17:31.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:32.05,0:17:34.17,Default,,0,0,0,,Түсіру жылдамдығын реттеңіз -
Dialogue: 0,0:17:34.26,0:17:37.13,Default,,0,0,0,,Сіз орталықты кейінірек қабылдауды әдейі таңдадыңыз ба?
Dialogue: 0,0:17:37.22,0:17:39.14,Default,,0,0,0,,Керемет! Кумичо
Dialogue: 0,0:17:39.34,0:17:40.93,Default,,0,0,0,,Енді мен оны түсіндім!
Dialogue: 0,0:17:41.01,0:17:42.51,Default,,0,0,0,,Рагнарук аймағы!
Dialogue: 0,0:17:47.02,0:17:48.35,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:17:48.44,0:17:50.40,Default,,0,0,0,,Орталықтағы Рагнарук...
Dialogue: 0,0:17:50.48,0:17:52.90,Default,,0,0,0,,Шыдамдылықты жоғалтпай айналдыруды жалғастырыңыз!
Dialogue: 0,0:17:52.98,0:17:55.32,Default,,0,0,0,,Экскалибурдың тұрақты ауырлық орталығы болса да...
Dialogue: 0,0:17:55.40,0:17:57.57,Default,,0,0,0,,Рагнарук аймағын бұзу!
Dialogue: 0,0:17:57.78,0:17:59.36,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:17:59.45,0:18:00.16,Default,,0,0,0,,Не~!
Dialogue: 0,0:18:00.24,0:18:00.99,Default,,0,0,0,,Ах~
Dialogue: 0,0:18:01.08,0:18:03.37,Default,,0,0,0,,Ең ауыр ауырлық дискі-
Dialogue: 0,0:18:03.45,0:18:04.79,Default,,0,0,0,,Өте оңай...!
Dialogue: 0,0:18:04.87,0:18:06.04,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:18:09.21,0:18:10.08,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:18:10.17,0:18:12.38,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:12.46,0:18:13.96,Default,,0,0,0,,Сәйкестік болды!
Dialogue: 0,0:18:14.05,0:18:16.51,Default,,0,0,0,,Шака 2 ұпай алады
Dialogue: 0,0:18:16.59,0:18:19.43,Default,,0,0,0,,Шака 2-0 жеңді!
Dialogue: 0,0:18:19.84,0:18:21.85,Default,,0,0,0,,Экскалибурдың қозғалысы...
Dialogue: 0,0:18:21.93,0:18:23.47,Default,,0,0,0,,Қуат жылдамдығы
Dialogue: 0,0:18:24.10,0:18:26.89,Default,,0,0,0,,Барлығы алдыңғы Шакадан бірнеше саты жоғары.
Dialogue: 0,0:18:27.27,0:18:28.77,Default,,0,0,0,,Мен де ұтыла алмаймын
Dialogue: 0,0:18:29.27,0:18:32.31,Default,,0,0,0,,Қарғыс атқыр... Әп-сәтте жарылып кетті ме?
Dialogue: 0,0:18:32.40,0:18:34.32,Default,,0,0,0,,Бұл жақсы шайқас болды.
Dialogue: 0,0:18:34.78,0:18:37.49,Default,,0,0,0,,Не? Бұл тіпті ойын емес.
Dialogue: 0,0:18:37.69,0:18:40.24,Default,,0,0,0,,Түсіндім...? Мен көңілді болдым
Dialogue: 0,0:18:40.45,0:18:42.49,Default,,0,0,0,,Көңіл көтеруге уақытыңыз болмады.
Dialogue: 0,0:18:42.57,0:18:45.20,Default,,0,0,0,,Иә? Ойын ұзақ болса
Dialogue: 0,0:18:45.29,0:18:47.45,Default,,0,0,0,,Бұл жақсы шайқас емес пе?
Dialogue: 0,0:18:47.54,0:18:48.66,Default,,0,0,0,,Және-
Dialogue: 0,0:18:49.21,0:18:51.29,Default,,0,0,0,,Рагнаруктың көтерілуі
Dialogue: 0,0:18:51.46,0:18:52.67,Default,,0,0,0,,Керемет шығанақ!
Dialogue: 0,0:18:53.13,0:18:54.17,Default,,0,0,0,,Егер бұл шығанақ-
Dialogue: 0,0:18:54.25,0:18:56.51,Default,,0,0,0,,Бір сәтте жеңу әдеттегідей.
Dialogue: 0,0:18:56.59,0:18:57.38,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:18:57.92,0:18:58.84,Default,,0,0,0,,Ахем
Dialogue: 0,0:19:00.63,0:19:02.64,Default,,0,0,0,,Өте жақсы.
Dialogue: 0,0:19:05.39,0:19:06.89,Default,,0,0,0,,Бір сәтке де――
Dialogue: 0,0:19:06.97,0:19:08.81,Default,,0,0,0,,Бұл жақсы шайқас болатыны сөзсіз.
Dialogue: 0,0:19:08.89,0:19:10.77,Default,,0,0,0,,Мен бүгін жеңілдім.
Dialogue: 0,0:19:10.85,0:19:12.27,Default,,0,0,0,,That's right.
Dialogue: 0,0:19:12.35,0:19:15.86,Default,,0,0,0,,Гахахаха...
Dialogue: 0,0:19:16.65,0:19:18.49,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:19:18.69,0:19:21.91,Default,,0,0,0,,Өйткені, бұл Балттың бала күнгі досы ғана.
Dialogue: 0,0:19:21.99,0:19:24.20,Default,,0,0,0,,Маған ұнады, Шака!
Dialogue: 0,0:19:24.28,0:19:25.62,Default,,0,0,0,,Мен жақсы боламын
Dialogue: 0,0:19:25.70,0:19:26.83,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:19:26.91,0:19:27.74,Default,,0,0,0,,Ах
Dialogue: 0,0:19:27.83,0:19:29.87,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:19:29.96,0:19:31.71,Default,,0,0,0,,Шака! Иә?
Dialogue: 0,0:19:31.92,0:19:33.42,Default,,0,0,0,,Мен келесім!
Dialogue: 0,0:19:33.50,0:19:34.67,Default,,0,0,0,,Жоқ, мен істеймін.
Dialogue: 0,0:19:34.75,0:19:37.13,Default,,0,0,0,,Біз бұлай кері шегіне алмаймыз.
Dialogue: 0,0:19:37.21,0:19:39.17,Default,,0,0,0,,Екеуіңнің шығыныңды өтеймін.
Dialogue: 0,0:19:39.26,0:19:40.92,Default,,0,0,0,,Бұл Балтық жағалауы
Dialogue: 0,0:19:41.09,0:19:43.97,Default,,0,0,0,,Е, мен қатты толқып тұрмын...
Dialogue: 0,0:19:44.30,0:19:46.81,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, Кумичо аямайды.
Dialogue: 0,0:19:46.89,0:19:48.60,Default,,0,0,0,,Рұқсатсыз өлтіруге болмайды!
Dialogue: 0,0:19:48.68,0:19:50.93,Default,,0,0,0,,Тек менімен жарыс!
Dialogue: 0,0:19:51.14,0:19:53.65,Default,,0,0,0,,Мен де көбірек шайқасқым келеді.
Dialogue: 0,0:19:53.73,0:19:56.90,Default,,0,0,0,,Тезірек таудан түспесек, күн шығады
Dialogue: 0,0:19:57.11,0:19:59.65,Default,,0,0,0,,Уақыт таусылып қала ма деп қорқамын.
Dialogue: 0,0:20:01.24,0:20:05.16,Default,,0,0,0,,(Оқушылар туралы қауесет)
Dialogue: 0,0:20:05.24,0:20:07.66,Default,,0,0,0,,Бүгін көңілді болды, Балто!
Dialogue: 0,0:20:07.87,0:20:09.49,Default,,0,0,0,,А, мен де!
Dialogue: 0,0:20:09.91,0:20:12.79,Default,,0,0,0,,Иә? Шу-кун, менімен үйге бармайсың ба?
Dialogue: 0,0:20:13.37,0:20:16.00,Default,,0,0,0,,Маған әлі де ем керек.
Dialogue: 0,0:20:16.08,0:20:17.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:17.38,0:20:19.80,Default,,0,0,0,,Шуға қатысты, маған қамқорлық жасаңыз!
Dialogue: 0,0:20:19.88,0:20:23.76,Default,,0,0,0,,Әй, атама қалдырсаңыз, уайымдамаңыз.
Dialogue: 0,0:20:24.09,0:20:24.89,Default,,0,0,0,,Барт…
Dialogue: 0,0:20:25.68,0:20:28.43,Default,,0,0,0,,Мен міндетті түрде республикалық турнирге дейін толық сауығып кетемін.
Dialogue: 0,0:20:28.97,0:20:29.93,Default,,0,0,0,,Және…
Dialogue: 0,0:20:30.56,0:20:31.52,Default,,0,0,0,,Жеңіске жет!
Dialogue: 0,0:20:31.81,0:20:32.81,Default,,0,0,0,,Ха
Dialogue: 0,0:20:33.06,0:20:35.81,Default,,0,0,0,,Сонымен Балт...сен де жеңе аласың...
Dialogue: 0,0:20:35.90,0:20:37.48,Default,,0,0,0,,Республикалық сайысқа келіңіздер
Dialogue: 0,0:20:37.56,0:20:38.52,Default,,0,0,0,,А...
Dialogue: 0,0:20:38.61,0:20:40.32,Default,,0,0,0,,Ұлттық конвенция...
Dialogue: 0,0:20:40.40,0:20:42.44,Default,,0,0,0,,Мен ұтылып қалдым...
Dialogue: 0,0:20:42.53,0:20:43.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:43.65,0:20:46.07,Default,,0,0,0,,Әлі де мүмкіндік бар
Dialogue: 0,0:20:47.87,0:20:50.08,Default,,0,0,0,,Бұл аймақты таңдау турнирі деп аталады.
Dialogue: 0,0:20:50.16,0:20:52.37,Default,,0,0,0,,Аудандық турнирде жеңілген жүйрік...
Dialogue: 0,0:20:52.50,0:20:55.79,Default,,0,0,0,,Ұлттық турнирде қалған орындар үшін күрес
Dialogue: 0,0:20:56.04,0:20:58.09,Default,,0,0,0,,Бұл қайталау матч, былайша айтқанда.
Dialogue: 0,0:20:59.00,0:21:02.05,Default,,0,0,0,,Шақыруларды тек таңдалған пышақшылар алады.
Dialogue: 0,0:21:02.42,0:21:04.09,Default,,0,0,0,,Егер сен сонда аман қалсаң...
Dialogue: 0,0:21:05.09,0:21:07.72,Default,,0,0,0,,Республикалық жарыстарға қатысу
Dialogue: 0,0:21:07.84,0:21:09.22,Default,,0,0,0,,Ұлттық турнир!
Dialogue: 0,0:21:09.47,0:21:11.52,Default,,0,0,0,,Әлі біткен жоқ.
Dialogue: 0,0:21:11.60,0:21:12.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:12.85,0:21:14.14,Default,,0,0,0,,Анашым...
Dialogue: 0,0:21:15.02,0:21:17.98,Default,,0,0,0,,Жарайды, маған көбірек арнайы дайындық беріңіз.
Dialogue: 0,0:21:18.06,0:21:19.86,Default,,0,0,0,,Мен республикалық турнирге барамын!
Dialogue: 0,0:21:20.19,0:21:22.28,Default,,0,0,0,,Жаттығу матчы туралы не айтасыз?
Dialogue: 0,0:21:22.61,0:21:24.61,Default,,0,0,0,,Менің командам және сіздің командаңыз -
Dialogue: 0,0:21:24.70,0:21:26.15,Default,,0,0,0,,Командалық жекпе-жек өткізейік!
Dialogue: 0,0:21:26.24,0:21:27.49,Default,,0,0,0,,Шакамен және басқалармен?
Dialogue: 0,0:21:27.57,0:21:28.37,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:21:28.57,0:21:29.53,Default,,0,0,0,,Әрине!
Dialogue: 0,0:21:29.62,0:21:31.62,Default,,0,0,0,,Бұл екеумізге де жақсы тәжірибе.
Dialogue: 0,0:21:32.33,0:21:34.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:35.16,0:21:36.79,Default,,0,0,0,,Мен сені күтемін, Балто.
Dialogue: 0,0:21:36.92,0:21:38.42,Default,,0,0,0,,Ұлттық съезде!
Dialogue: 0,0:21:38.50,0:21:40.09,Default,,0,0,0,,Ұлттық съезде!
Dialogue: 0,0:21:40.17,0:21:41.75,Default,,0,0,0,,Ұлттық съезде!
Dialogue: 0,0:21:41.84,0:21:42.59,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:43.96,0:21:44.92,Default,,0,0,0,,Иә
Dialogue: 0,0:21:45.22,0:21:46.13,Default,,0,0,0,,Иә
Dialogue: 0,0:21:46.68,0:21:48.18,Default,,0,0,0,,Ұлттық турнир!
Dialogue: 0,0:21:48.76,0:21:50.47,Default,,0,0,0,,Мен міндетті түрде барамын!
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.53,0:23:27.78,Default,,0,0,0,,Топтық жарыс
Dialogue: 0,0:23:27.86,0:23:30.36,Default,,0,0,0,,Қарсылас – Шақаның қылыш оттары
Dialogue: 0,0:23:30.45,0:23:32.91,Default,,0,0,0,,Барлығымыз күш біріктіріп, шайқасайық
Dialogue: 0,0:23:32.99,0:23:34.53,Default,,0,0,0,,Бұл өте қызықты болады!
Dialogue: 0,0:23:34.62,0:23:37.08,Default,,0,0,0,,Оның үстіне ол осы уақытқа дейін жасырынып келген.
Dialogue: 0,0:23:37.16,0:23:38.62,Default,,0,0,0,,Ниндзя пайда болады
Dialogue: 0,0:23:38.70,0:23:40.41,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:23:40.50,0:23:42.62,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:42.71,0:23:44.88,Default,,0,0,0,,Өртен! командалық шайқас
Dialogue: 0,0:23:45.09,0:23:47.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.17,0:23:49.05,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.55,0:23:56.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory