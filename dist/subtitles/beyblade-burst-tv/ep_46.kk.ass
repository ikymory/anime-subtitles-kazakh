Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.21,0:00:12.51,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.63,0:00:14.72,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.80,0:00:16.93,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.01,0:00:19.01,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.43,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.40,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.48,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.03,0:00:33.11,Default,,0,0,0,,Ұлттық турнир жекелей жарыс
Dialogue: 0,0:00:33.19,0:00:34.82,Default,,0,0,0,,Үшінші турға кіру
Dialogue: 0,0:00:34.90,0:00:37.24,Default,,0,0,0,,Бірінші матч Шу мен Вакия.
Dialogue: 0,0:00:37.37,0:00:38.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:38.28,0:00:39.33,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:00:45.25,0:00:46.75,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:00:47.29,0:00:50.55,Default,,0,0,0,,Hyper Shield апаты!
Dialogue: 0,0:00:51.30,0:00:54.13,Default,,0,0,0,,Спригган! Жоғарғы түсірілім!
Dialogue: 0,0:00:55.22,0:00:58.09,Default,,0,0,0,,Бұл нағыз қызу шайқас болып шықты.
Dialogue: 0,0:00:59.18,0:01:01.14,Default,,0,0,0,,Не... Ято...!
Dialogue: 0,0:01:02.14,0:01:03.89,Default,,0,0,0,,Шу жеңді.
Dialogue: 0,0:01:04.18,0:01:05.64,Default,,0,0,0,,Енді екінші матчқа көшейік.
Dialogue: 0,0:01:05.73,0:01:08.56,Default,,0,0,0,,Инсуке Луиге қарсы барын салды
Dialogue: 0,0:01:09.02,0:01:12.15,Default,,0,0,0,,Я... Өлім спиралы!
Dialogue: 0,0:01:15.36,0:01:16.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:16.86,0:01:19.66,Default,,0,0,0,,Кешіріңіз, бірақ мен жеңілдім.
Dialogue: 0,0:01:20.58,0:01:22.20,Default,,0,0,0,,Ол күшті ғой, Луи.
Dialogue: 0,0:01:22.45,0:01:23.70,Default,,0,0,0,,Шу Руи және
Dialogue: 0,0:01:23.79,0:01:26.41,Default,,0,0,0,,Төрт он император жартылай финалға өтті.
Dialogue: 0,0:01:26.50,0:01:29.50,Default,,0,0,0,,Жарайды, үшінші ойынға менің кезегім келді.
Dialogue: 0,0:01:29.58,0:01:31.00,Default,,0,0,0,,Қарсылас – Шақа
Dialogue: 0,0:01:31.09,0:01:32.84,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:01:40.80,0:01:43.18,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:43.52,0:01:48.69,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:59.99,0:02:03.37,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:03.87,0:02:06.00,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:06.41,0:02:10.54,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:10.67,0:02:13.88,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:14.00,0:02:20.43,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:20.72,0:02:25.14,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:25.64,0:02:31.06,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:31.19,0:02:33.44,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:33.52,0:02:38.24,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:38.40,0:02:43.49,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:43.78,0:02:46.04,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:46.24,0:02:48.58,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:48.87,0:02:52.79,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:52.96,0:02:57.96,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:58.17,0:03:00.34,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:04.22,0:03:07.72,Default,,0,0,0,,Қатты шайқас! Балто Шакаға қарсы!
Dialogue: 0,0:03:08.02,0:03:11.64,Default,,0,0,0,,(орамалы дыбыс)
Dialogue: 0,0:03:15.06,0:03:17.61,Default,,0,0,0,,Сізді қызықтырмайтын шығарсыз.
Dialogue: 0,0:03:18.65,0:03:19.57,Default,,0,0,0,,Нуаа!
Dialogue: 0,0:03:21.11,0:03:23.45,Default,,0,0,0,,(орамалы дыбыс)
Dialogue: 0,0:03:24.03,0:03:26.45,Default,,0,0,0,,Балт Аои мен Кайза Шакенджи
Dialogue: 0,0:03:26.74,0:03:28.20,Default,,0,0,0,,Үшінші турда
Dialogue: 0,0:03:28.29,0:03:30.33,Default,,0,0,0,,Бұл мен ең көргім келетін кездесу.
Dialogue: 0,0:03:31.54,0:03:34.29,Default,,0,0,0,,Мен Барто Аоидың жеңгенін қалаймын.
Dialogue: 0,0:03:36.84,0:03:38.42,Default,,0,0,0,,Және тағы да
Dialogue: 0,0:03:38.63,0:03:40.38,Default,,0,0,0,,Мен сенімен төбелескім келеді
Dialogue: 0,0:03:40.88,0:03:42.13,Default,,0,0,0,,Дамаре
Dialogue: 0,0:03:43.47,0:03:44.72,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым.
Dialogue: 0,0:03:47.93,0:03:49.52,Default,,0,0,0,,Бал аға
Dialogue: 0,0:03:49.89,0:03:50.98,Default,,0,0,0,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:03:51.06,0:03:52.39,Default,,0,0,0,,Ауа атту
Dialogue: 0,0:03:52.85,0:03:56.65,Default,,0,0,0,,Оған бар күшімді салуым керек.
Dialogue: 0,0:03:57.82,0:03:59.73,Default,,0,0,0,,Мұны істеу қиын
Dialogue: 0,0:03:59.82,0:04:02.20,Default,,0,0,0,,Кумичо, концентрат.
Dialogue: 0,0:04:02.28,0:04:04.07,Default,,0,0,0,,Сол ыңырсығанның өзі тітіркендіреді.
Dialogue: 0,0:04:04.16,0:04:05.62,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:04:05.70,0:04:07.66,Default,,0,0,0,,Балто, сәл тыныштал.
Dialogue: 0,0:04:07.74,0:04:09.66,Default,,0,0,0,,Роджер!
Dialogue: 0,0:04:09.74,0:04:12.75,Default,,0,0,0,,Бірақ ол күркірегендей шығады.
Dialogue: 0,0:04:12.83,0:04:14.54,Default,,0,0,0,,Күн ыстық, Бару-нии.
Dialogue: 0,0:04:14.62,0:04:17.75,Default,,0,0,0,,Мен сізге көмектесетін бірдеңе бар-жоғын білу үшін келдім.
Dialogue: 0,0:04:18.21,0:04:19.63,Default,,0,0,0,,О! Сондықтан келесі жолы
Dialogue: 0,0:04:19.71,0:04:22.17,Default,,0,0,0,,Токонацу мен Ника менімен соғысыңыз.
Dialogue: 0,0:04:22.42,0:04:23.76,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:04:23.84,0:04:24.97,Default,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:04:25.05,0:04:27.85,Default,,0,0,0,,Мен жаттығудың ең жақсы тәсілі туралы ойладым.
Dialogue: 0,0:04:27.93,0:04:28.97,Default,,0,0,0,,Эхен
Dialogue: 0,0:04:30.01,0:04:32.73,Default,,0,0,0,,Кумичо-сама және Дина Токонацу Ника
Dialogue: 0,0:04:32.81,0:04:35.10,Default,,0,0,0,,Біз бәріміз бір-бірімізге қарсы тұрамыз.
Dialogue: 0,0:04:35.23,0:04:36.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:36.23,0:04:37.48,Default,,0,0,0,,Барлығы?
Dialogue: 0,0:04:37.69,0:04:38.90,Default,,0,0,0,,Қызықты
Dialogue: 0,0:04:38.98,0:04:40.19,Default,,0,0,0,,Иә, қызық
Dialogue: 0,0:04:40.53,0:04:43.74,Default,,0,0,0,,Толық күшіңіздің толық қуатын қалай шығаруға болады
Dialogue: 0,0:04:43.82,0:04:45.41,Default,,0,0,0,,Battle Royale
Dialogue: 0,0:04:45.49,0:04:48.95,Default,,0,0,0,,Балт, біздің барлық билерімізді ұшырып көріңіз.
Dialogue: 0,0:04:49.20,0:04:50.99,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:04:51.45,0:04:54.04,Default,,0,0,0,,Билерімізді желге ұшыратын құдіретім болса ғой.
Dialogue: 0,0:04:54.12,0:04:56.29,Default,,0,0,0,,Сіз тіпті Excalibur-ды жеңе аласыз.
Dialogue: 0,0:04:56.50,0:04:59.00,Default,,0,0,0,,Жасайық, Бар-нии, жасайық.
Dialogue: 0,0:04:59.50,0:05:00.71,Default,,0,0,0,,Біз тырысамыз ба?
Dialogue: 0,0:05:00.80,0:05:02.38,Default,,0,0,0,,1-ден 4-ке дейін, Балто.
Dialogue: 0,0:05:02.63,0:05:03.51,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:05:03.59,0:05:05.34,Default,,0,0,0,,Мен барлығын ұшырып жіберемін
Dialogue: 0,0:05:05.63,0:05:07.26,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:05:07.34,0:05:10.31,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:10.64,0:05:13.02,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:17.69,0:05:18.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:19.56,0:05:20.32,Default,,0,0,0,,Эх!
Dialogue: 0,0:05:21.36,0:05:22.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:23.36,0:05:24.36,Default,,0,0,0,,Керемет!
Dialogue: 0,0:05:26.78,0:05:28.24,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:05:35.50,0:05:37.62,Default,,0,0,0,,Ол әлі жұмыс істейді
Dialogue: 0,0:05:38.25,0:05:41.46,Default,,0,0,0,,Шаканы мұндай тыныш көру сирек.
Dialogue: 0,0:05:41.67,0:05:44.46,Default,,0,0,0,,Сіз де имидждік жаттығулар жасайсыз ба?
Dialogue: 0,0:05:49.01,0:05:51.18,Default,,0,0,0,,Шака мен саған қарсылас боламын.
Dialogue: 0,0:05:52.76,0:05:55.98,Default,,0,0,0,,Мен сенімен жеке кездесуде жұдырықтаса аламын деп ойладым.
Dialogue: 0,0:05:56.48,0:05:58.94,Default,,0,0,0,,Міне, мен де солай ойладым.
Dialogue: 0,0:05:59.19,0:06:01.44,Default,,0,0,0,,Мен оның өсуін бағаламадым.
Dialogue: 0,0:06:01.90,0:06:04.40,Default,,0,0,0,,Балтты мұқият бұру нәтижесінде
Dialogue: 0,0:06:04.57,0:06:08.07,Default,,0,0,0,,Мен ағынды шұңқырды шығарып алдым.
Dialogue: 0,0:06:08.24,0:06:10.32,Default,,0,0,0,,Жарайды, тағы да жарысайық!
Dialogue: 0,0:06:10.87,0:06:11.70,Default,,0,0,0,,О!
Dialogue: 0,0:06:12.53,0:06:14.49,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:06:15.04,0:06:17.87,Default,,0,0,0,,Бұл матчты көрмегелі көп болды.
Dialogue: 0,0:06:18.29,0:06:20.54,Default,,0,0,0,,Excalibur – шабуыл түрі.
Dialogue: 0,0:06:20.63,0:06:22.92,Default,,0,0,0,,Кецалькатль қорғаныс түрі болып табылады.
Dialogue: 0,0:06:23.25,0:06:26.67,Default,,0,0,0,,Мен Экскалибурдың қылышы бұл қорғанысты қалай бұзады деп ойлаймын.
Dialogue: 0,0:06:26.80,0:06:28.34,Default,,0,0,0,,Мұның бәрі шайқас туралы.
Dialogue: 0,0:06:28.47,0:06:30.64,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:06:30.72,0:06:33.43,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:33.93,0:06:36.77,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:36.93,0:06:38.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:49.11,0:06:50.86,Default,,0,0,0,,Байланысты ату!
Dialogue: 0,0:06:51.36,0:06:53.07,Default,,0,0,0,,олжаны ұстаңыз!
Dialogue: 0,0:06:53.16,0:06:54.41,Default,,0,0,0,,Кецалькатл!
Dialogue: 0,0:06:55.91,0:06:57.04,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:01.83,0:07:03.17,Default,,0,0,0,,Цурануке!
Dialogue: 0,0:07:03.54,0:07:05.42,Default,,0,0,0,,Excalibur!
Dialogue: 0,0:07:07.38,0:07:10.13,Default,,0,0,0,,Бір әсер!
Dialogue: 0,0:07:11.05,0:07:12.89,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:07:12.97,0:07:13.76,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:07:14.22,0:07:15.39,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:07:15.68,0:07:16.51,Default,,0,0,0,,О!
Dialogue: 0,0:07:16.93,0:07:19.18,Default,,0,0,0,,Кецалькатль жылдамырақ жарылады
Dialogue: 0,0:07:19.27,0:07:21.85,Default,,0,0,0,,Excalibur Burst Finish көмегімен жеңіңіз
Dialogue: 0,0:07:22.06,0:07:24.65,Default,,0,0,0,,Шака Бұл қауіпті болды.
Dialogue: 0,0:07:24.98,0:07:25.90,Default,,0,0,0,,Иә
Dialogue: 0,0:07:26.73,0:07:27.94,Default,,0,0,0,,Тағы да
Dialogue: 0,0:07:28.69,0:07:29.86,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:07:31.03,0:07:34.95,Default,,0,0,0,,Сіз бұл жігітке Балттан қанша ыстық қуат бере аласыз?
Dialogue: 0,0:07:35.03,0:07:37.12,Default,,0,0,0,,Менің де мұны қатты орындағым келеді.
Dialogue: 0,0:07:37.74,0:07:40.12,Default,,0,0,0,,Жарайды, Шақа жеңілмейді.
Dialogue: 0,0:07:40.50,0:07:42.54,Default,,0,0,0,,Ол ғана түсінбейді.
Dialogue: 0,0:07:42.67,0:07:43.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:43.79,0:07:46.17,Default,,0,0,0,,Әрқашан солай болған.
Dialogue: 0,0:07:46.25,0:07:48.71,Default,,0,0,0,,Біз ұрысқан кезде мен әдетте жеңемін.
Dialogue: 0,0:07:48.96,0:07:50.17,Default,,0,0,0,,Бірақ кейде
Dialogue: 0,0:07:50.26,0:07:52.72,Default,,0,0,0,,Ол мен күтпеген жерден келді.
Dialogue: 0,0:07:52.80,0:07:54.01,Default,,0,0,0,,Олар қарсы шығады.
Dialogue: 0,0:07:54.97,0:07:57.68,Default,,0,0,0,,Мен ешқашан күтпеген едім...
Dialogue: 0,0:07:57.85,0:07:59.43,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:08:02.06,0:08:03.06,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:08:03.14,0:08:04.23,Default,,0,0,0,,Бұл қандай жаман иіс?
Dialogue: 0,0:08:04.31,0:08:05.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:05.31,0:08:07.69,Default,,0,0,0,,Көптен бері қозғалмадың.
Dialogue: 0,0:08:07.77,0:08:09.23,Default,,0,0,0,,Сіз не ойладыңыз?
Dialogue: 0,0:08:09.61,0:08:10.44,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:08:10.53,0:08:11.69,Default,,0,0,0,,Ештеңе емес пе?
Dialogue: 0,0:08:11.78,0:08:13.70,Default,,0,0,0,,Мен басымды босаттым.
Dialogue: 0,0:08:14.49,0:08:16.99,Default,,0,0,0,,Бұл әрқашан солай.
Dialogue: 0,0:08:17.20,0:08:18.33,Default,,0,0,0,,Айтпайсың ба?
Dialogue: 0,0:08:18.41,0:08:21.66,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:08:22.08,0:08:23.33,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:08:23.46,0:08:26.88,Default,,0,0,0,,WBBA ұлттық турнирі 3-тур
Dialogue: 0,0:08:26.96,0:08:30.42,Default,,0,0,0,,Үздік 8 арасындағы кескілескен шайқас жалынды тұтандырады!
Dialogue: 0,0:08:30.51,0:08:33.38,Default,,0,0,0,,Күтілгендей, төрт он император осы алғашқы сегіздікке кіреді.
Dialogue: 0,0:08:33.47,0:08:34.97,Default,,0,0,0,,күшті күшті
Dialogue: 0,0:08:35.05,0:08:39.43,Default,,0,0,0,,Куришу Ширасадиджо Руи жартылай финалға шығуға шешім қабылдады.
Dialogue: 0,0:08:39.51,0:08:41.89,Default,,0,0,0,,Ал бүгін пайда болған төрт он император
Dialogue: 0,0:08:41.97,0:08:43.23,Default,,0,0,0,,Жанып тұрған ғибадатхана Кайзамен
Dialogue: 0,0:08:43.31,0:08:45.39,Default,,0,0,0,,Зак Күн сәулесі
Dialogue: 0,0:08:45.73,0:08:47.69,Default,,0,0,0,,Сол екі мықтыға кім қарсы шығады?
Dialogue: 0,0:08:47.77,0:08:49.32,Default,,0,0,0,,Екеуі де жаңадан келген ойыншылар.
Dialogue: 0,0:08:49.40,0:08:52.07,Default,,0,0,0,,Балт Аои жанып тұрған ғибадатханадағы Кайзаға қарсы шығады
Dialogue: 0,0:08:52.15,0:08:55.45,Default,,0,0,0,,Акира Ямабуки Зак Күн сәулесін шақырады
Dialogue: 0,0:08:55.53,0:08:59.74,Default,,0,0,0,,Біз қазіргі императордың бекінісін бұза аламыз ба?
Dialogue: 0,0:09:00.08,0:09:01.95,Default,,0,0,0,,Содан кейін үшінші тур
Dialogue: 0,0:09:02.04,0:09:04.08,Default,,0,0,0,,Үшінші ойынның уақыты келді.
Dialogue: 0,0:09:04.21,0:09:05.29,Default,,0,0,0,,Көк бұрыш
Dialogue: 0,0:09:05.37,0:09:07.17,Default,,0,0,0,,Шитенконың ең күшті шабуылшысы
Dialogue: 0,0:09:07.38,0:09:09.25,Default,,0,0,0,,Жанып жатқан ғибадатхана Кайза!
Dialogue: 0,0:09:11.46,0:09:12.34,Default,,0,0,0,,Қызыл бұрыш
Dialogue: 0,0:09:12.55,0:09:15.38,Default,,0,0,0,,Керемет бала Барто Аои!
Dialogue: 0,0:09:15.59,0:09:18.05,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:25.35,0:09:27.65,Default,,0,0,0,,Бар-нии, бұл тыныш.
Dialogue: 0,0:09:27.73,0:09:29.81,Default,,0,0,0,,Сіз қобалжыдыңыз ба?
Dialogue: 0,0:09:29.90,0:09:33.44,Default,,0,0,0,,Жоқ, мен әдеттегіден қатты қызып кеттім.
Dialogue: 0,0:09:33.53,0:09:35.40,Default,,0,0,0,,Қарсылас Шақа болғандықтан ба?
Dialogue: 0,0:09:35.49,0:09:37.49,Default,,0,0,0,,Әй, екеуміздің арамызда.
Dialogue: 0,0:09:37.57,0:09:39.45,Default,,0,0,0,,Шайқас басталып кетті.
Dialogue: 0,0:09:39.91,0:09:42.99,Default,,0,0,0,,Балто мен Шака, бұл шайқаста қатты қобалжымаңдар.
Dialogue: 0,0:09:43.16,0:09:44.12,Default,,0,0,0,,О
Dialogue: 0,0:09:44.50,0:09:47.71,Default,,0,0,0,,Ой! Бүгін не болды, екеуіңе?
Dialogue: 0,0:09:47.87,0:09:50.79,Default,,0,0,0,,Барто Аои, әдетте жоғары шиеленіспен кіреді.
Dialogue: 0,0:09:50.92,0:09:54.63,Default,,0,0,0,,Жанып тұрған ғибадатхана Кайза да көңілді күлкі арқылы жауынгерлік рухты арттырады.
Dialogue: 0,0:09:54.71,0:09:56.97,Default,,0,0,0,,Осы шайқас сахнасында пайда болу
Dialogue: 0,0:09:57.05,0:09:59.55,Default,,0,0,0,,Мүлдем сөз емес!
Dialogue: 0,0:09:59.89,0:10:01.26,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:10:05.31,0:10:06.73,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:10:07.02,0:10:08.39,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:10:08.94,0:10:10.90,Default,,0,0,0,,Кеттік, Шақа!
Dialogue: 0,0:10:10.98,0:10:12.15,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:10:12.23,0:10:16.94,Default,,0,0,0,,
Dialogue: 0,0:10:18.45,0:10:19.66,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:19.74,0:10:21.20,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:10:21.28,0:10:23.87,Default,,0,0,0,,Олар көпіршіктерге ұқсайды.
Dialogue: 0,0:10:24.12,0:10:27.04,Default,,0,0,0,,Екі хайуан сияқты.
Dialogue: 0,0:10:27.12,0:10:28.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:31.17,0:10:32.08,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:10:32.17,0:10:34.71,Default,,0,0,0,,Валькирия Біздің толық күшіміз
Dialogue: 0,0:10:34.80,0:10:36.55,Default,,0,0,0,,Шаканы ұрайық!
Dialogue: 0,0:10:36.92,0:10:38.72,Default,,0,0,0,,Кел, Экскалибур!
Dialogue: 0,0:10:38.80,0:10:41.01,Default,,0,0,0,,Осы үлкен сахнада жабайы болыңыз!
Dialogue: 0,0:10:41.34,0:10:43.01,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:10:43.55,0:10:46.64,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:46.72,0:10:48.93,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:49.02,0:10:50.35,Default,,0,0,0,,Яаа!
Dialogue: 0,0:10:50.44,0:10:52.61,Default,,0,0,0,,Енді екі ұшақ та атылды.
Dialogue: 0,0:10:52.81,0:10:54.48,Default,,0,0,0,,Шайқас басталды!
Dialogue: 0,0:10:58.32,0:10:59.95,Default,,0,0,0,,(Шығанақтың соғу дыбысы)
Dialogue: 0,0:11:01.03,0:11:02.45,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:11:02.53,0:11:03.78,Default,,0,0,0,,Міне!
Dialogue: 0,0:11:03.87,0:11:05.49,Default,,0,0,0,,Мен оны сеземін, Балто
Dialogue: 0,0:11:05.58,0:11:07.24,Default,,0,0,0,,Сіздің толық күшіңіз
Dialogue: 0,0:11:12.71,0:11:14.50,Default,,0,0,0,,Екі жақ та бір дюймді де тастамайды
Dialogue: 0,0:11:14.59,0:11:16.21,Default,,0,0,0,,Бұл ұшқынды шабуыл.
Dialogue: 0,0:11:19.17,0:11:20.13,Default,,0,0,0,,Жүр!
Dialogue: 0,0:11:20.22,0:11:21.84,Default,,0,0,0,,Менің теңдесі жоқ сүйікті машинам
Dialogue: 0,0:11:21.93,0:11:23.55,Default,,0,0,0,,Экскалибур!
Dialogue: 0,0:11:33.27,0:11:36.48,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:11:39.36,0:11:41.11,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:11:44.99,0:11:47.62,Default,,0,0,0,,Реактивті ату!
Dialogue: 0,0:11:48.12,0:11:50.70,Default,,0,0,0,,Қос әсер!
Dialogue: 0,0:11:51.66,0:11:53.04,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:11:54.96,0:11:57.13,Default,,0,0,0,,Екеуінің бір уақытта жарылуы арқылы сурет салу
Dialogue: 0,0:11:57.21,0:12:00.26,Default,,0,0,0,,Бірінші шайқас – қос жарылыс!
Dialogue: 0,0:12:00.42,0:12:02.93,Default,,0,0,0,,Кенеттен ұтыс! Куу!
Dialogue: 0,0:12:03.01,0:12:05.43,Default,,0,0,0,,Мен оны көргенде де ыстықты сезінемін.
Dialogue: 0,0:12:05.51,0:12:08.01,Default,,0,0,0,,Бұл қатты қақтығыс болды.
Dialogue: 0,0:12:08.51,0:12:10.18,Default,,0,0,0,,Валькирия
Dialogue: 0,0:12:10.27,0:12:11.64,Default,,0,0,0,,Мен оны сезінемін.
Dialogue: 0,0:12:12.23,0:12:14.19,Default,,0,0,0,,Кез келген алдыңғы шайқасқа қарағанда
Dialogue: 0,0:12:14.27,0:12:16.69,Default,,0,0,0,,Экскалибур өзін үлкен сезінеді.
Dialogue: 0,0:12:16.86,0:12:19.11,Default,,0,0,0,,Шақаның да көңіл-күйі зор.
Dialogue: 0,0:12:19.32,0:12:21.07,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:12:21.24,0:12:23.07,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:12:23.28,0:12:25.49,Default,,0,0,0,,Бізге бар күшімізбен күресу керек.
Dialogue: 0,0:12:25.57,0:12:27.58,Default,,0,0,0,,Дұрыс па? дос
Dialogue: 0,0:12:27.91,0:12:29.12,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:12:29.62,0:12:30.70,Default,,0,0,0,,Өте жеңіл!
Dialogue: 0,0:12:30.79,0:12:32.08,Default,,0,0,0,,Бұл жарық, Балто.
Dialogue: 0,0:12:32.46,0:12:35.75,Default,,0,0,0,,Финалда Шумен ойнағанда бұлай болмау керек еді.
Dialogue: 0,0:12:36.08,0:12:36.96,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:12:37.25,0:12:39.13,Default,,0,0,0,,Келесі жарылыс
Dialogue: 0,0:12:39.21,0:12:40.30,Default,,0,0,0,,Тек сен
Dialogue: 0,0:12:42.38,0:12:43.84,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:12:55.23,0:12:56.90,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:12:57.44,0:13:00.82,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:01.15,0:13:03.82,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:06.57,0:13:08.07,Default,,0,0,0,,Оны үрлеп тастаңыз!
Dialogue: 0,0:13:09.74,0:13:13.08,Default,,0,0,0,,Екеуінің де қуаты мен жылдамдығы жеткілікті.
Dialogue: 0,0:13:15.54,0:13:16.83,Default,,0,0,0,,Тағы бір соққы
Dialogue: 0,0:13:16.92,0:13:18.63,Default,,0,0,0,,Қанымды қайнат!
Dialogue: 0,0:13:22.30,0:13:23.21,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:13:27.72,0:13:28.89,Default,,0,0,0,,Осымен
Dialogue: 0,0:13:30.68,0:13:32.18,Default,,0,0,0,,Оны үрлеп тастаңыз!
Dialogue: 0,0:13:33.72,0:13:35.18,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:13:36.19,0:13:37.10,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:13:37.65,0:13:40.23,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:40.90,0:13:44.49,Default,,0,0,0,,Xeno Excalibur 2 ұпай, жарылған мәре
Dialogue: 0,0:13:44.69,0:13:46.90,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:47.28,0:13:48.82,Default,,0,0,0,,Кім жетекшілік етті?
Dialogue: 0,0:13:48.91,0:13:50.45,Default,,0,0,0,,Төрт он император ең күшті шабуылшы
Dialogue: 0,0:13:50.53,0:13:52.03,Default,,0,0,0,,Жанып тұрған ғибадатхана Кайза
Dialogue: 0,0:13:52.12,0:13:54.87,Default,,0,0,0,,Расында да қирау патшасы, оның күші нормадан асып түседі.
Dialogue: 0,0:13:55.62,0:13:56.66,Default,,0,0,0,,Толық шегіну.
Dialogue: 0,0:13:56.75,0:13:58.92,Default,,0,0,0,,Бұл өте қауіпті, мен қалтырап барамын
Dialogue: 0,0:13:59.33,0:14:00.96,Default,,0,0,0,,Эй, мен саған айттым ғой.
Dialogue: 0,0:14:01.21,0:14:03.80,Default,,0,0,0,,Келесіде жалғыз сіз жарылып кетесіз.
Dialogue: 0,0:14:04.30,0:14:05.88,Default,,0,0,0,,Олай болса Шака
Dialogue: 0,0:14:06.38,0:14:07.55,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:14:08.30,0:14:09.84,Default,,0,0,0,,О, көріңіз.
Dialogue: 0,0:14:09.93,0:14:12.47,Default,,0,0,0,,Менің жүрегімді одан сайын қыздыруға тырыс
Dialogue: 0,0:14:12.89,0:14:14.85,Default,,0,0,0,,О, мен мұны істеймін!
Dialogue: 0,0:14:15.27,0:14:16.52,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:14:21.90,0:14:23.32,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:14:25.36,0:14:27.07,Default,,0,0,0,,Мен келесісін аламын
Dialogue: 0,0:14:27.28,0:14:30.70,Default,,0,0,0,,Толығырақ... Күштірақ түсіріңіз.
Dialogue: 0,0:14:35.24,0:14:37.66,Default,,0,0,0,,Әй, не болды? Ай Барто
Dialogue: 0,0:14:37.91,0:14:40.17,Default,,0,0,0,,Мен стадионнан кетіп бара жатырмын.
Dialogue: 0,0:14:40.54,0:14:41.92,Default,,0,0,0,,
Dialogue: 0,0:14:42.00,0:14:44.13,Default,,0,0,0,,Анау ақымақ, сен не істеп жатырсың?
Dialogue: 0,0:14:44.67,0:14:45.96,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:14:46.26,0:14:49.09,Default,,0,0,0,,Балто Сіз байқаған жоқсыз.
Dialogue: 0,0:14:49.17,0:14:49.97,Default,,0,0,0,,О
Dialogue: 0,0:14:55.22,0:14:56.60,Default,,0,0,0,,Бұл шайқас
Dialogue: 0,0:14:56.68,0:14:59.69,Default,,0,0,0,,Жарылып жеңейік, жолдасым.
Dialogue: 0,0:14:59.89,0:15:01.23,Default,,0,0,0,,Сіз...
Dialogue: 0,0:15:01.73,0:15:03.27,Default,,0,0,0,,Кеттік! Шака!
Dialogue: 0,0:15:03.36,0:15:05.07,Default,,0,0,0,,Келіңіздер! Балтық!
Dialogue: 0,0:15:06.98,0:15:08.65,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:15:09.86,0:15:10.95,Default,,0,0,0,,Үш
Dialogue: 0,0:15:11.82,0:15:12.57,Default,,0,0,0,,Екі
Dialogue: 0,0:15:13.24,0:15:14.16,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:15:14.83,0:15:17.49,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:17.62,0:15:19.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:19.37,0:15:20.79,Default,,0,0,0,,Валькирия
Dialogue: 0,0:15:20.87,0:15:22.58,Default,,0,0,0,,Хоп қадамы
Dialogue: 0,0:15:22.67,0:15:24.54,Default,,0,0,0,,Секір!
Dialogue: 0,0:15:24.75,0:15:26.09,Default,,0,0,0,,Не!
Dialogue: 0,0:15:28.26,0:15:31.09,Default,,0,0,0,,Valkyrie Джет Shoot!
Dialogue: 0,0:15:33.26,0:15:34.64,Default,,0,0,0,,Артқа жанап өтіңіз!
Dialogue: 0,0:15:34.72,0:15:36.18,Default,,0,0,0,,Excalibur!
Dialogue: 0,0:15:39.52,0:15:41.77,Default,,0,0,0,,(Шығанақтың соғу дыбысы)
Dialogue: 0,0:15:45.27,0:15:47.11,Default,,0,0,0,,Валькири жабайы болады
Dialogue: 0,0:15:47.23,0:15:48.90,Default,,0,0,0,,Міне, Джет Shoot
Dialogue: 0,0:15:48.98,0:15:50.78,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:15:54.28,0:15:56.66,Default,,0,0,0,,Жарылыңыз!
Dialogue: 0,0:15:59.54,0:16:01.00,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:16:02.08,0:16:03.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:04.08,0:16:05.33,Default,,0,0,0,,Не?!
Dialogue: 0,0:16:05.42,0:16:06.29,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:06.67,0:16:10.88,Default,,0,0,0,,Жеңіс Валькири 2 ұпай
Dialogue: 0,0:16:11.22,0:16:14.93,Default,,0,0,0,,Қорқынышты Барто Аои төрт бұрылыс императорға шабуыл жасауға шешім қабылдады!
Dialogue: 0,0:16:15.14,0:16:15.97,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:16:16.05,0:16:18.22,Default,,0,0,0,,Бауырым! таңқаларлық!
Dialogue: 0,0:16:18.35,0:16:19.72,Default,,0,0,0,,екпінмен жүгірді
Dialogue: 0,0:16:19.81,0:16:21.98,Default,,0,0,0,,Бұл атуға күш берді.
Dialogue: 0,0:16:22.73,0:16:24.73,Default,,0,0,0,,Балтоның жарылысы!
Dialogue: 0,0:16:24.81,0:16:27.02,Default,,0,0,0,,Бұл керемет кадр!
Dialogue: 0,0:16:27.27,0:16:28.94,Default,,0,0,0,,Бұл керемет, Балто.
Dialogue: 0,0:16:29.02,0:16:29.98,Default,,0,0,0,,О
Dialogue: 0,0:16:31.99,0:16:33.36,Default,,0,0,0,,Шақа қалай?
Dialogue: 0,0:16:33.45,0:16:35.03,Default,,0,0,0,,Мен шешім қабылдадым.
Dialogue: 0,0:16:35.11,0:16:36.12,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:16:43.25,0:16:46.17,Default,,0,0,0,,Уф, мен де көруден шаршадым.
Dialogue: 0,0:16:46.25,0:16:48.54,Default,,0,0,0,,Толық қуат Толық қуат Супер толық қуат!
Dialogue: 0,0:16:48.67,0:16:50.67,Default,,0,0,0,,Шаршағандай ақымақ сөздер айтпа.
Dialogue: 0,0:16:50.80,0:16:53.59,Default,,0,0,0,,Сіз бұл үлкен толқынға міне алмайсыз.
Dialogue: 0,0:16:53.67,0:16:55.80,Default,,0,0,0,,Ағын Балтыққа келеді.
Dialogue: 0,0:16:56.22,0:16:57.51,Default,,0,0,0,,Сол Шака
Dialogue: 0,0:16:57.59,0:16:58.60,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:16:58.97,0:17:00.97,Default,,0,0,0,,Ойында тосынсыйлар болмайды.
Dialogue: 0,0:17:01.06,0:17:03.18,Default,,0,0,0,,Шаканы көбірек күйдіріңіз!
Dialogue: 0,0:17:03.43,0:17:06.27,Default,,0,0,0,,1 ұпай тағы 1 ұпай жеткілікті
Dialogue: 0,0:17:06.56,0:17:07.94,Default,,0,0,0,,Шеш, Балто
Dialogue: 0,0:17:08.60,0:17:09.94,Default,,0,0,0,,Күшті шайқас
Dialogue: 0,0:17:10.27,0:17:12.36,Default,,0,0,0,,Атто Аои Барто
Dialogue: 0,0:17:12.44,0:17:14.49,Default,,0,0,0,,Сіз қайтадан жүгіруді жоспарлап отырсыз ба?
Dialogue: 0,0:17:14.57,0:17:17.78,Default,,0,0,0,,Екінші жағынан, жанып тұрған ғибадатхананың Кайзасы мүлдем беймаза.
Dialogue: 0,0:17:18.45,0:17:20.58,Default,,0,0,0,,Енді шешейік.
Dialogue: 0,0:17:20.66,0:17:22.45,Default,,0,0,0,,Төртінші сәйкестік
Dialogue: 0,0:17:23.50,0:17:25.12,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:17:26.08,0:17:29.84,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:30.88,0:17:33.59,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:37.43,0:17:39.51,Default,,0,0,0,,Қақтығыс!
Dialogue: 0,0:17:39.60,0:17:40.97,Default,,0,0,0,,Тағы бір қақтығыс
Dialogue: 0,0:17:43.06,0:17:44.35,Default,,0,0,0,,Жақсы, Балто.
Dialogue: 0,0:17:44.43,0:17:46.02,Default,,0,0,0,,Мен келемін
Dialogue: 0,0:17:46.10,0:17:47.56,Default,,0,0,0,,Менің досым күткендей.
Dialogue: 0,0:17:47.90,0:17:49.52,Default,,0,0,0,,Сөзсіз жеңіңіз
Dialogue: 0,0:17:49.73,0:17:51.69,Default,,0,0,0,,Мен мәселені шешемін.
Dialogue: 0,0:17:51.77,0:17:53.40,Default,,0,0,0,,Бұл ерік-жігердің қақтығысы.
Dialogue: 0,0:17:53.48,0:17:55.61,Default,,0,0,0,,Екі машина да ұстап тұр
Dialogue: 0,0:17:58.24,0:18:00.28,Default,,0,0,0,,Уау! Цурануке!
Dialogue: 0,0:18:00.37,0:18:02.12,Default,,0,0,0,,Excalibur!
Dialogue: 0,0:18:02.20,0:18:05.00,Default,,0,0,0,,Шешіңіз! Валькирия!
Dialogue: 0,0:18:06.62,0:18:09.46,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:18:10.67,0:18:12.04,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:13.63,0:18:15.34,Default,,0,0,0,,Екеуінің бір уақытта жарылуы арқылы
Dialogue: 0,0:18:15.42,0:18:16.22,Default,,0,0,0,,Сурет салу
Dialogue: 0,0:18:16.55,0:18:19.22,Default,,0,0,0,,Тағы бір қос жарылыс
Dialogue: 0,0:18:19.30,0:18:21.60,Default,,0,0,0,,Ұпайлар әлі де 2-2.
Dialogue: 0,0:18:21.68,0:18:23.68,Default,,0,0,0,,Жарылғыш ату да керемет.
Dialogue: 0,0:18:23.89,0:18:26.60,Default,,0,0,0,,Шақаның құдіреті де тез артып келеді.
Dialogue: 0,0:18:26.89,0:18:29.39,Default,,0,0,0,,Бір-бірімізді ынталандырамыз
Dialogue: 0,0:18:29.48,0:18:31.61,Default,,0,0,0,,Қарсылас неғұрлым күшті болса, соғұрлым көп
Dialogue: 0,0:18:31.69,0:18:33.52,Default,,0,0,0,,Мен де күшейіп келемін
Dialogue: 0,0:18:33.73,0:18:34.73,Default,,0,0,0,,Барт
Dialogue: 0,0:18:34.82,0:18:37.24,Default,,0,0,0,,Сіз қайтадан дамып кеттіңіз.
Dialogue: 0,0:18:37.74,0:18:40.70,Default,,0,0,0,,Жалғыз мен емес, Валькири де.
Dialogue: 0,0:18:41.20,0:18:42.91,Default,,0,0,0,,Біз бірге күшті болдық.
Dialogue: 0,0:18:43.28,0:18:45.37,Default,,0,0,0,,Біз бұл шайқаста жеңеміз!
Dialogue: 0,0:18:46.20,0:18:47.87,Default,,0,0,0,,Жақсы, Барто.
Dialogue: 0,0:18:48.50,0:18:50.33,Default,,0,0,0,,Оны ұсақтау керек.
Dialogue: 0,0:18:50.83,0:18:52.13,Default,,0,0,0,,Бесінші шайқас
Dialogue: 0,0:18:54.50,0:18:57.55,Default,,0,0,0,,Енді, Бесінші шайқасқа қарай
Dialogue: 0,0:18:57.63,0:19:00.22,Default,,0,0,0,,Барто Аои қайтадан жүгіреді
Dialogue: 0,0:19:00.30,0:19:03.22,Default,,0,0,0,,Жанып тұрған Кайза храмындағы атыс
Dialogue: 0,0:19:03.60,0:19:05.31,Default,,0,0,0,,2-2 байлау
Dialogue: 0,0:19:05.64,0:19:07.18,Default,,0,0,0,,Келесі шайқаста
Dialogue: 0,0:19:07.27,0:19:09.14,Default,,0,0,0,,Бұл соңы ма?
Dialogue: 0,0:19:15.11,0:19:16.69,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:19:17.11,0:19:18.32,Default,,0,0,0,,Үш
Dialogue: 0,0:19:18.82,0:19:19.44,Default,,0,0,0,,Екі
Dialogue: 0,0:19:20.45,0:19:21.74,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:19:21.82,0:19:24.16,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:30.21,0:19:32.50,Default,,0,0,0,,Жабайы жүр! Валькирия!
Dialogue: 0,0:19:32.58,0:19:35.34,Default,,0,0,0,,Оны құрт! Экскалибур!
Dialogue: 0,0:19:44.51,0:19:46.31,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:46.39,0:19:48.89,Default,,0,0,0,,Бұл менің толық күшім!
Dialogue: 0,0:19:48.97,0:19:51.14,Default,,0,0,0,,Реактивті ату!
Dialogue: 0,0:19:51.23,0:19:53.40,Default,,0,0,0,,Теңдесі жоқ соққы
Dialogue: 0,0:19:53.90,0:19:55.65,Default,,0,0,0,,Қосарлы әсер ету
Dialogue: 0,0:19:55.73,0:19:58.53,Default,,0,0,0,,Бәрін құрт!
Dialogue: 0,0:19:58.65,0:20:00.78,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:20:00.99,0:20:02.74,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:20:05.37,0:20:06.70,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:10.37,0:20:13.08,Default,,0,0,0,,Жеңіс Valkyrie Burst Finish
Dialogue: 0,0:20:13.17,0:20:14.08,Default,,0,0,0,,2 ұпай
Dialogue: 0,0:20:14.42,0:20:15.63,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:20:15.71,0:20:17.38,Default,,0,0,0,,4-2 жеңді
Dialogue: 0,0:20:18.63,0:20:25.43,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:20:31.64,0:20:33.89,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:35.40,0:20:37.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:41.07,0:20:42.95,Default,,0,0,0,,Бар-нии-чан
Dialogue: 0,0:20:43.03,0:20:44.82,Default,,0,0,0,,Жарайсың Балто
Dialogue: 0,0:20:45.24,0:20:47.24,Default,,0,0,0,,Бұл ең жақсы шайқас болды
Dialogue: 0,0:20:47.57,0:20:50.58,Default,,0,0,0,,Саған рахмет, мен сенімен күрестім.
Dialogue: 0,0:20:50.83,0:20:52.79,Default,,0,0,0,,Бұл керемет, Барто.
Dialogue: 0,0:20:52.87,0:20:53.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:54.12,0:20:55.25,Default,,0,0,0,,Шака…
Dialogue: 0,0:20:55.54,0:20:57.21,Default,,0,0,0,,Мен өкінемін.
Dialogue: 0,0:20:57.71,0:21:00.05,Default,,0,0,0,,Барто Аои... иә?
Dialogue: 0,0:21:01.21,0:21:02.01,Default,,0,0,0,,Хун
Dialogue: 0,0:21:02.55,0:21:03.88,Default,,0,0,0,,Толық қуат?
Dialogue: 0,0:21:04.30,0:21:06.13,Default,,0,0,0,,Сіз бәрін бердіңіз, Балто.
Dialogue: 0,0:21:06.64,0:21:09.64,Default,,0,0,0,,Бұл үлкен бұрылыс, Сенгісіз
Dialogue: 0,0:21:09.72,0:21:12.31,Default,,0,0,0,,Қатты қызған шайқастың соңында
Dialogue: 0,0:21:12.39,0:21:14.23,Default,,0,0,0,,Ғажайып бала Барто Аои
Dialogue: 0,0:21:14.31,0:21:17.27,Default,,0,0,0,,Жанып жатқан ғибадатхананың төрт он императоры Кайзаны жеңіңіз!
Dialogue: 0,0:21:17.48,0:21:20.69,Default,,0,0,0,,Барт, мен қазір боспын.
Dialogue: 0,0:21:21.07,0:21:23.24,Default,,0,0,0,,Мен оған барымды бердім.
Dialogue: 0,0:21:23.32,0:21:25.03,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:21:25.24,0:21:27.78,Default,,0,0,0,,Менің әлі көп жұмысым бар.
Dialogue: 0,0:21:27.99,0:21:29.53,Default,,0,0,0,,Мен мұны жиі айтамын.
Dialogue: 0,0:21:29.62,0:21:31.87,Default,,0,0,0,,Бұл соншалықты дүрбелең болса да.
Dialogue: 0,0:21:32.12,0:21:33.66,Default,,0,0,0,,Осыны істеу керек
Dialogue: 0,0:21:33.79,0:21:35.87,Default,,0,0,0,,Шақаны жеңе алмаймын деп ойладым.
Dialogue: 0,0:21:36.42,0:21:39.33,Default,,0,0,0,,Балт Мені жеңген сенсің.
Dialogue: 0,0:21:39.42,0:21:42.42,Default,,0,0,0,,Егер бұл орын алса, барлық төрт императорды жеңіп көріңіз.
Dialogue: 0,0:21:42.88,0:21:44.92,Default,,0,0,0,,О, мен мұны істеймін!
Dialogue: 0,0:21:45.42,0:21:47.97,Default,,0,0,0,,Біз жеңеміз!
Dialogue: 0,0:22:06.11,0:22:12.20,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:12.41,0:22:18.54,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:19.00,0:22:24.55,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:25.01,0:22:28.34,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:28.51,0:22:33.43,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:35.35,0:22:38.06,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:38.14,0:22:41.35,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:41.44,0:22:47.78,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:48.03,0:22:53.58,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:53.74,0:23:00.33,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:00.92,0:23:06.34,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:06.51,0:23:09.67,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:10.18,0:23:14.14,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:23.36,0:23:24.77,Default,,0,0,0,,Мабуши~!
Dialogue: 0,0:23:24.86,0:23:26.48,Default,,0,0,0,,Идол жұлдыздары мен супержұлдыздары
Dialogue: 0,0:23:26.57,0:23:28.03,Default,,0,0,0,,Екі адам бірге шықты
Dialogue: 0,0:23:28.11,0:23:30.07,Default,,0,0,0,,Зак пен Акира төбелеседі
Dialogue: 0,0:23:30.15,0:23:33.57,Default,,0,0,0,,Акираның Закқа келуге деген құмарлығы өршиді.
Dialogue: 0,0:23:33.78,0:23:35.99,Default,,0,0,0,,Мен де бұл сезімді толық түсінемін.
Dialogue: 0,0:23:36.66,0:23:39.25,Default,,0,0,0,,Жартылай финалда менімен кім кездеседі?
Dialogue: 0,0:23:39.33,0:23:41.33,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:41.41,0:23:43.04,Default,,0,0,0,,Жұлдызды шайқас!
Dialogue: 0,0:23:43.13,0:23:44.67,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:44.75,0:23:46.09,Default,,0,0,0,,Бар, ат!
