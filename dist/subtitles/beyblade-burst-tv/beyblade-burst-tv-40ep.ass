Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.42,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.63,0:00:14.68,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.76,0:00:16.89,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.97,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.06,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.14,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:32.11,0:00:33.86,Default,,0,0,0,,Командалық финал
Dialogue: 0,0:00:34.03,0:00:36.66,Default,,0,0,0,,Мен Руи Ширасагимен төрт рет соғыстым.
Dialogue: 0,0:00:36.74,0:00:38.74,Default,,0,0,0,,Жүр!
Dialogue: 0,0:00:39.24,0:00:41.79,Default,,0,0,0,,Өлім спиралы!
Dialogue: 0,0:00:52.71,0:00:54.88,Default,,0,0,0,,Бірақ мен бір рет те жеңе алмадым.
Dialogue: 0,0:00:55.43,0:01:00.14,Default,,0,0,0,,Ұлттық турнирдің командалық жарысында жеңімпаз команда - Ride Out
Dialogue: 0,0:01:00.97,0:01:03.35,Default,,0,0,0,,(Балтоның айқайы)
Dialogue: 0,0:01:03.85,0:01:05.06,Default,,0,0,0,,Тұрған Барт
Dialogue: 0,0:01:05.56,0:01:06.60,Default,,0,0,0,,Өзі соққыны қабылдауға дайын қарсы шабуыл!
Dialogue: 0,0:01:08.86,0:01:11.36,Default,,0,0,0,,Менде әлі де жеке матч бар
Dialogue: 0,0:01:19.78,0:01:22.16,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:22.49,0:01:27.67,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:38.97,0:01:42.35,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:42.85,0:01:44.97,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:45.39,0:01:49.52,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:49.65,0:01:52.86,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:52.98,0:01:59.41,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:59.70,0:02:04.12,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:04.62,0:02:10.04,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:10.17,0:02:12.42,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:12.50,0:02:17.22,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:17.38,0:02:22.47,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:22.76,0:02:25.01,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:25.22,0:02:27.56,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:27.85,0:02:31.77,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:31.94,0:02:36.94,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:37.15,0:02:39.32,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:43.32,0:02:46.20,Default,,0,0,0,,Қабыл ал! Елімізде №1!
Dialogue: 0,0:02:47.04,0:02:50.83,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:02:51.21,0:02:52.96,Default,,0,0,0,,Таңғы ас дайын.
Dialogue: 0,0:02:53.04,0:02:54.67,Default,,0,0,0,,Токонацу Ника
Dialogue: 0,0:02:54.75,0:02:56.42,Default,,0,0,0,,Бауырым, мені оятшы.
Dialogue: 0,0:02:56.67,0:02:58.34,Default,,0,0,0,,Иә
Dialogue: 0,0:03:02.89,0:03:03.93,Default,,0,0,0,,Бал аға
Dialogue: 0,0:03:04.01,0:03:05.81,Default,,0,0,0,,Оян!
Dialogue: 0,0:03:07.64,0:03:08.81,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:09.43,0:03:10.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:22.78,0:03:25.53,Default,,0,0,0,,(Луидің күлкісі)
Dialogue: 0,0:03:26.33,0:03:28.45,Default,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,0:03:28.54,0:03:30.25,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:03:31.00,0:03:32.50,Default,,0,0,0,,Боқта~
Dialogue: 0,0:03:32.71,0:03:35.96,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:03:39.46,0:03:41.72,Default,,0,0,0,,Мен сені мүлде талқандаймын!
Dialogue: 0,0:03:42.22,0:03:43.38,Default,,0,0,0,,Луи!
Dialogue: 0,0:03:44.05,0:03:45.51,Default,,0,0,0,,Боқ~
Dialogue: 0,0:03:47.47,0:03:49.81,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:51.23,0:03:53.31,Default,,0,0,0,,Ату! Ат!
Dialogue: 0,0:03:53.39,0:03:55.15,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:55.36,0:03:56.52,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:03:56.61,0:03:57.48,Default,,0,0,0,,Барт…
Dialogue: 0,0:03:58.86,0:04:00.99,Default,,0,0,0,,Мен жеңілемін деп ойлаймын...
Dialogue: 0,0:04:02.57,0:04:04.03,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:04:04.36,0:04:06.24,Default,,0,0,0,,Жүр!
Dialogue: 0,0:04:07.78,0:04:10.87,Default,,0,0,0,,Оны Луи толығымен басып тастады
Dialogue: 0,0:04:10.95,0:04:11.87,Default,,0,0,0,,Бөлінген
Dialogue: 0,0:04:12.16,0:04:14.04,Default,,0,0,0,,Осындай психикалық күйде
Dialogue: 0,0:04:14.12,0:04:17.83,Default,,0,0,0,,Жеке жекпе-жектерде көрінетін мықты жігіттерге қарсы тұру қиын.
Dialogue: 0,0:04:18.21,0:04:20.46,Default,,0,0,0,,Шу сен және төрт он патша
Dialogue: 0,0:04:20.92,0:04:23.09,Default,,0,0,0,,Бұл Вайдың жалғыз мақсаты.
Dialogue: 0,0:04:23.17,0:04:24.43,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:04:24.51,0:04:26.01,Default,,0,0,0,,Мен дайынмын.
Dialogue: 0,0:04:28.76,0:04:29.68,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:04:29.76,0:04:31.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:31.31,0:04:33.94,Default,,0,0,0,,Бұл Барто Аои, солай ма?
Dialogue: 0,0:04:34.02,0:04:35.90,Default,,0,0,0,,Менің атым Mizusurface Naoki.
Dialogue: 0,0:04:36.23,0:04:37.36,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:04:37.44,0:04:40.36,Default,,0,0,0,,Маған командалық матчта сенің шайқасың көрсетілді.
Dialogue: 0,0:04:40.44,0:04:42.15,Default,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:04:42.57,0:04:43.74,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:04:43.95,0:04:45.66,Default,,0,0,0,,Сіздің ұстау күшіңіз қалыпты...
Dialogue: 0,0:04:45.74,0:04:46.95,Default,,0,0,0,,...
Dialogue: 0,0:04:47.24,0:04:48.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:48.41,0:04:51.24,Default,,0,0,0,,Мен көпіршіктерге зерттеу жүргізіп жатырмын.
Dialogue: 0,0:04:51.33,0:04:53.54,Default,,0,0,0,,Бладерді зерттеу?
Dialogue: 0,0:04:54.29,0:04:56.42,Default,,0,0,0,,Физикадан да, психологиядан да
Dialogue: 0,0:04:56.96,0:04:58.00,Default,,0,0,0,,Балто-кун
Dialogue: 0,0:04:58.08,0:05:01.09,Default,,0,0,0,,Сізді менің зерттеу пәнім еткенім дұрыс па?
Dialogue: 0,0:05:01.17,0:05:03.38,Default,,0,0,0,,Зерттеу объектісі дегеніміз не?
Dialogue: 0,0:05:03.46,0:05:07.01,Default,,0,0,0,,Сіз мен бұрын көрген пышақ емессіз.
Dialogue: 0,0:05:07.18,0:05:09.60,Default,,0,0,0,,Солай ма? Эххх...
Dialogue: 0,0:05:10.22,0:05:12.18,Default,,0,0,0,,Олай болса тәжірибені бастайық.
Dialogue: 0,0:05:14.14,0:05:17.06,Default,,0,0,0,,А, мен сенсорды қоямын, сондықтан қозғалмай тұрыңыз.
Dialogue: 0,0:05:20.36,0:05:22.57,Default,,0,0,0,,Ммм...
Dialogue: 0,0:05:23.32,0:05:27.32,Default,,0,0,0,,Бұл кадрлардың күші сияқты нәрселерді талдайтын қолданбаны қамтиды.
Dialogue: 0,0:05:27.41,0:05:29.32,Default,,0,0,0,,Әрине, мен оны дамыттым.
Dialogue: 0,0:05:31.12,0:05:32.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:32.87,0:05:34.12,Default,,0,0,0,,Тыныс алыңыз
Dialogue: 0,0:05:34.20,0:05:36.54,Default,,0,0,0,,Пхуха~!
Dialogue: 0,0:05:36.62,0:05:38.12,Default,,0,0,0,,Мен өлемін деп ойладым
Dialogue: 0,0:05:38.54,0:05:40.04,Default,,0,0,0,,О, мен
Dialogue: 0,0:05:40.13,0:05:42.46,Default,,0,0,0,,Менің IQ әдетте 200-ден жоғары.
Dialogue: 0,0:05:42.55,0:05:45.76,Default,,0,0,0,,Бұл нағыз данышпан деп аталатын деңгей.
Dialogue: 0,0:05:46.34,0:05:47.72,Default,,0,0,0,,IQ дегеніміз не?
Dialogue: 0,0:05:48.22,0:05:49.76,Default,,0,0,0,,Интеллект коэффициенті туралы
Dialogue: 0,0:05:49.84,0:05:50.76,Default,,0,0,0,,Бұл төмен сияқты...
Dialogue: 0,0:05:50.85,0:05:51.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:51.80,0:05:53.56,Default,,0,0,0,,Эксперимент қызықты, солай ма?
Dialogue: 0,0:05:53.85,0:05:55.98,Default,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:05:57.35,0:05:59.81,Default,,0,0,0,,Алдымен сүйікті асығыс кадрыңызды түсіріп көріңіз.
Dialogue: 0,0:06:00.15,0:06:01.02,Default,,0,0,0,,Йоши
Dialogue: 0,0:06:01.86,0:06:04.44,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:04.86,0:06:06.69,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:10.20,0:06:12.45,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:06:12.53,0:06:14.66,Default,,0,0,0,,Ату күші 600
Dialogue: 0,0:06:14.74,0:06:16.04,Default,,0,0,0,,Шамамен орташа мән
Dialogue: 0,0:06:16.25,0:06:17.66,Default,,0,0,0,,Хейкин Хейкин
Dialogue: 0,0:06:18.00,0:06:19.42,Default,,0,0,0,,«Орташа мән»
Dialogue: 0,0:06:19.50,0:06:21.92,Default,,0,0,0,,Бұл Луиге қарсы болғанның жартысына дейін төмендеді.
Dialogue: 0,0:06:22.17,0:06:23.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:23.13,0:06:25.13,Default,,0,0,0,,А, Бал-нии сонда болды!
Dialogue: 0,0:06:25.21,0:06:26.88,Default,,0,0,0,,Мен бәрінен бұрын жаттығатынмын.
Dialogue: 0,0:06:27.09,0:06:28.80,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:06:30.89,0:06:33.55,Default,,0,0,0,,Я, атыс күші азайып барады.
Dialogue: 0,0:06:33.64,0:06:34.64,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:34.72,0:06:37.23,Default,,0,0,0,,Бұл сөзсіз рухани нәрсе.
Dialogue: 0,0:06:37.31,0:06:38.89,Default,,0,0,0,,Сейшін?
Dialogue: 0,0:06:38.98,0:06:40.39,Default,,0,0,0,,Сезімдерді айтасыз ба?
Dialogue: 0,0:06:40.48,0:06:42.94,Default,,0,0,0,,Бал-нидің сезімі ешкімнен кем емес.
Dialogue: 0,0:06:43.73,0:06:45.57,Default,,0,0,0,,Тіпті түсінбей
Dialogue: 0,0:06:45.69,0:06:47.74,Default,,0,0,0,,Ол зақымдалған болуы керек.
Dialogue: 0,0:06:47.82,0:06:49.57,Default,,0,0,0,,Деректер өтірік айтпайды
Dialogue: 0,0:06:49.65,0:06:51.11,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:51.24,0:06:53.99,Default,,0,0,0,,Енді бір-бірімізге қарсы ойнайық.
Dialogue: 0,0:06:54.08,0:06:55.24,Default,,0,0,0,,Кіммен?
Dialogue: 0,0:06:55.91,0:06:56.99,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:01.25,0:07:03.54,Default,,0,0,0,,А, бұл менің шығанағым.
Dialogue: 0,0:07:03.63,0:07:05.25,Default,,0,0,0,,Бұл Жаңа Нептун.
Dialogue: 0,0:07:05.46,0:07:07.00,Default,,0,0,0,,Таза шығанағы
Dialogue: 0,0:07:07.38,0:07:09.26,Default,,0,0,0,,Нептун – теңіз құдайы
Dialogue: 0,0:07:09.59,0:07:11.47,Default,,0,0,0,,Бұл қолайлы қабат.
Dialogue: 0,0:07:11.76,0:07:14.43,Default,,0,0,0,,Теңіз құдайы ғажап
Dialogue: 0,0:07:14.51,0:07:16.68,Default,,0,0,0,,Қабат толқын түрінде.
Dialogue: 0,0:07:17.01,0:07:19.10,Default,,0,0,0,,Айтпақшы, бұл теңдестірілген түрі.
Dialogue: 0,0:07:19.18,0:07:20.77,Default,,0,0,0,,Бұл өте күшті.
Dialogue: 0,0:07:20.85,0:07:22.44,Default,,0,0,0,,көремін.
Dialogue: 0,0:07:22.52,0:07:24.56,Default,,0,0,0,,Кеттік! Барлығы Наоки!
Dialogue: 0,0:07:24.65,0:07:25.94,Default,,0,0,0,,Минамо Наоки!
Dialogue: 0,0:07:26.52,0:07:28.61,Default,,0,0,0,,Барлығы Наоки Жасайық!
Dialogue: 0,0:07:29.82,0:07:31.32,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:07:31.65,0:07:33.53,Default,,0,0,0,,Маған сіздің деректеріңізді жинауға рұқсат етіңіз.
Dialogue: 0,0:07:35.58,0:07:37.91,Default,,0,0,0,,Луимен сурет салған бірінші адам
Dialogue: 0,0:07:37.99,0:07:39.29,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:07:39.83,0:07:41.75,Default,,0,0,0,,Қандай мәліметтерді жинауға болады?
Dialogue: 0,0:07:41.87,0:07:44.08,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:07:46.46,0:07:49.09,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:49.17,0:07:51.55,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:51.63,0:07:52.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:00.35,0:08:02.56,Default,,0,0,0,,Мен сені осы жерден жіберемін.
Dialogue: 0,0:08:10.32,0:08:11.28,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:08:11.36,0:08:13.20,Default,,0,0,0,,Шабуыл түріне ұқсайды
Dialogue: 0,0:08:13.49,0:08:15.70,Default,,0,0,0,,Сіздің күшіңіз әлі толық жетпеген сияқты.
Dialogue: 0,0:08:20.16,0:08:22.41,Default,,0,0,0,,Бару~ Валькирия
Dialogue: 0,0:08:27.79,0:08:29.75,Default,,0,0,0,,Шынайы жарқыл түсіру
Dialogue: 0,0:08:29.84,0:08:31.96,Default,,0,0,0,,Деректерді енгізу аяқталды
Dialogue: 0,0:08:38.85,0:08:40.18,Default,,0,0,0,,Ах
Dialogue: 0,0:08:40.97,0:08:42.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:45.44,0:08:46.73,Default,,0,0,0,,Бал-нии
Dialogue: 0,0:08:46.81,0:08:48.15,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:08:48.48,0:08:49.94,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:50.65,0:08:52.28,Default,,0,0,0,,Ағымдағы атыс күші
Dialogue: 0,0:08:52.36,0:08:55.70,Default,,0,0,0,,Бұл Луиге қарсы уақыттың шамамен 50% ғана пайда болды.
Dialogue: 0,0:08:55.86,0:08:57.37,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:08:57.57,0:08:59.58,Default,,0,0,0,,Тағы бір рет! Тағы бір рет жасайық
Dialogue: 0,0:08:59.87,0:09:02.58,Default,,0,0,0,,Қазір қанша рет жасасаң да солай.
Dialogue: 0,0:09:03.00,0:09:03.79,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:09:03.87,0:09:04.96,Default,,0,0,0,,Ах~
Dialogue: 0,0:09:05.04,0:09:05.79,Default,,0,0,0,,Не?
Dialogue: 0,0:09:05.87,0:09:08.17,Default,,0,0,0,,Наоки Мизусурфэйс есімде...
Dialogue: 0,0:09:08.25,0:09:10.13,Default,,0,0,0,,Жеке ұрыстарға қатысатын пышақ.
Dialogue: 0,0:09:10.34,0:09:12.71,Default,,0,0,0,,Жеке жарысқа қатысасыз ба?
Dialogue: 0,0:09:13.21,0:09:15.51,Default,,0,0,0,,Сіз байқадыңыз.
Dialogue: 0,0:09:16.55,0:09:18.55,Default,,0,0,0,,Жеке жарыс өтетін жерде кездесейік
Dialogue: 0,0:09:19.01,0:09:20.05,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:09:20.30,0:09:22.56,Default,,0,0,0,,Өзіңізді жақсы сезінесіз деп үміттенемін.
Dialogue: 0,0:09:24.89,0:09:26.69,Default,,0,0,0,,Ху~ (2 адам) Иә!
Dialogue: 0,0:09:27.23,0:09:28.44,Default,,0,0,0,,Бал аға
Dialogue: 0,0:09:28.65,0:09:31.11,Default,,0,0,0,,Мен таңғы ас ішпедім.
Dialogue: 0,0:09:31.19,0:09:32.28,Default,,0,0,0,,Е!
Dialogue: 0,0:09:32.44,0:09:34.61,Default,,0,0,0,,Мен енді қозғала алмаймын
Dialogue: 0,0:09:36.11,0:09:38.95,Default,,0,0,0,,Ол сондай аянышты жігіт.
Dialogue: 0,0:09:39.24,0:09:42.49,Default,,0,0,0,,Өйткені менің ішімді айналдыруға күшім жетпеді.
Dialogue: 0,0:09:42.62,0:09:46.21,Default,,0,0,0,,Бірақ сіз Наоки деген жігіттен оңай жеңіліп қалдыңыз, солай ма?
Dialogue: 0,0:09:46.29,0:09:48.12,Default,,0,0,0,,Ату күші де төмендеді...
Dialogue: 0,0:09:48.21,0:09:49.17,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:09:49.25,0:09:50.33,Default,,0,0,0,,жартысында
Dialogue: 0,0:09:50.46,0:09:52.17,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:09:52.50,0:09:54.21,Default,,0,0,0,,Келесі жолы мен міндетті түрде жеңемін
Dialogue: 0,0:09:54.38,0:09:56.22,Default,,0,0,0,,Не деген сұмдық сылтау.
Dialogue: 0,0:09:56.30,0:09:57.22,Default,,0,0,0,,Не?
Dialogue: 0,0:09:57.30,0:09:58.47,Default,,0,0,0,,Жоғалту - жеңілу
Dialogue: 0,0:09:58.55,0:10:00.80,Default,,0,0,0,,Сіз мұны мойындамайсыз ба?
Dialogue: 0,0:10:02.26,0:10:05.35,Default,,0,0,0,,Не керек, мен жеке жекпе-жекке шығатынымды білмеймін.
Dialogue: 0,0:10:05.43,0:10:08.56,Default,,0,0,0,,Арнайы дағдыларыңызды көрсетіп, деректеріңізді алып жатырсыз ба?
Dialogue: 0,0:10:08.64,0:10:09.81,Default,,0,0,0,,Ақымақтықтың ең жоғарғы шегі
Dialogue: 0,0:10:10.02,0:10:11.81,Default,,0,0,0,,Мен білмедім.
Dialogue: 0,0:10:11.90,0:10:13.44,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:13.52,0:10:16.32,Default,,0,0,0,,Дәл қазір кіммен ойнасаң да, жеңе алмайсың.
Dialogue: 0,0:10:16.40,0:10:18.65,Default,,0,0,0,,Әй, сен олай айтпайсың.
Dialogue: 0,0:10:18.74,0:10:20.78,Default,,0,0,0,,Әй, мен жеңілуді әдетке айналдырдым.
Dialogue: 0,0:10:21.45,0:10:22.62,Default,,0,0,0,,Әдетті жоғалту?
Dialogue: 0,0:10:22.74,0:10:24.95,Default,,0,0,0,,Себебі Луи мені құртты
Dialogue: 0,0:10:25.04,0:10:28.25,Default,,0,0,0,,Мен түсінбей тұрып, жүрегім қысылып барады.
Dialogue: 0,0:10:28.33,0:10:30.83,Default,,0,0,0,,Сәлем! Абайсызда ештеңе айтпа
Dialogue: 0,0:10:30.92,0:10:32.21,Default,,0,0,0,,Тоқта, Кумичо.
Dialogue: 0,0:10:32.29,0:10:32.96,Default,,0,0,0,,Хмф!
Dialogue: 0,0:10:33.29,0:10:36.88,Default,,0,0,0,,Шу сен де мен сияқты ойлайсың, солай ма?
Dialogue: 0,0:10:40.22,0:10:42.01,Default,,0,0,0,,Атып көріңіз, Балто.
Dialogue: 0,0:10:46.56,0:10:48.27,Default,,0,0,0,,Наокиден кім жеңілді?
Dialogue: 0,0:10:48.35,0:10:50.14,Default,,0,0,0,,Себебі мен қарным ашып, сақамды түсірдім.
Dialogue: 0,0:10:50.56,0:10:53.40,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:53.48,0:10:55.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:58.57,0:10:59.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:11.33,0:11:12.92,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:11:13.00,0:11:14.92,Default,,0,0,0,,Сіз кенеттен не істеп жатырсыз? Шу!
Dialogue: 0,0:11:15.46,0:11:16.96,Default,,0,0,0,,Бұл қазір сенсің
Dialogue: 0,0:11:17.05,0:11:17.88,Default,,0,0,0,,Не!
Dialogue: 0,0:11:18.34,0:11:20.76,Default,,0,0,0,,Мен тіпті атуға дайынмын.
Dialogue: 0,0:11:20.84,0:11:22.76,Default,,0,0,0,,Сіз түсінбедіңіз
Dialogue: 0,0:11:23.05,0:11:26.35,Default,,0,0,0,,Мен бұрын істей алатын нәрселерді енді жасай алмайтыным анық.
Dialogue: 0,0:11:26.68,0:11:28.06,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:11:28.68,0:11:29.60,Default,,0,0,0,,Га
Dialogue: 0,0:11:30.18,0:11:32.81,Default,,0,0,0,,Мен сізге Луимен матчты тапсырдым.
Dialogue: 0,0:11:33.02,0:11:34.90,Default,,0,0,0,,Мен сені бұлай көру үшін келген жоқпын.
Dialogue: 0,0:11:35.19,0:11:37.27,Default,,0,0,0,,Мен сенімен финалда жұдырықтасқым келеді!
Dialogue: 0,0:11:39.11,0:11:40.40,Default,,0,0,0,,Финалға келіңіздер!
Dialogue: 0,0:11:42.20,0:11:43.11,Default,,0,0,0,,Шу…
Dialogue: 0,0:11:43.45,0:11:46.74,Default,,0,0,0,,Идиот! Финалда сенімен жұдырықтасуды шыдамаймын.
Dialogue: 0,0:11:47.79,0:11:50.45,Default,,0,0,0,,Барто Саған айтар бір сөзім бар.
Dialogue: 0,0:11:52.00,0:11:53.04,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:11:53.12,0:11:54.58,Default,,0,0,0,,Басқаларға қарағанда көбірек жаттығу
Dialogue: 0,0:11:54.67,0:11:56.71,Default,,0,0,0,,Луиден жеңілу қорқынышын жеңді
Dialogue: 0,0:11:56.79,0:11:59.55,Default,,0,0,0,,Мен саған қазір тітіркеніп барамын.
Dialogue: 0,0:11:59.80,0:12:00.97,Default,,0,0,0,,Вакия
Dialogue: 0,0:12:01.17,0:12:05.59,Default,,0,0,0,,А, сен ақымақсың. Келмейтін нәрсені неге айтпайсың?
Dialogue: 0,0:12:05.68,0:12:07.22,Default,,0,0,0,,Сіз тым сүйкімдісіз
Dialogue: 0,0:12:08.76,0:12:09.97,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:12:10.52,0:12:12.60,Default,,0,0,0,,Бұл не... Бұл не?
Dialogue: 0,0:12:14.98,0:12:18.19,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:12:18.69,0:12:20.65,Default,,0,0,0,,Деректерді талдау нәтижелері
Dialogue: 0,0:12:20.73,0:12:24.16,Default,,0,0,0,,Жеңіске жету ықтималдығы 90% жоғары
Dialogue: 0,0:12:24.49,0:12:28.03,Default,,0,0,0,,Куришуу Зак Бұл Кайза Кагакуенджи.
Dialogue: 0,0:12:28.12,0:12:29.37,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:12:29.45,0:12:31.75,Default,,0,0,0,,99% жоғары
Dialogue: 0,0:12:31.95,0:12:33.83,Default,,0,0,0,,Бұл төрт ондық император ма?
Dialogue: 0,0:12:34.17,0:12:37.59,Default,,0,0,0,,Біз оны талдамас бұрын білдік.
Dialogue: 0,0:12:37.84,0:12:41.71,Default,,0,0,0,,Белгісіздікті деректерді талдауға қосу
Dialogue: 0,0:12:41.80,0:12:43.42,Default,,0,0,0,,Басқаша айтқанда, сәттілік күші?
Dialogue: 0,0:12:43.51,0:12:44.47,Default,,0,0,0,,Дәл осы дәлелдер бар болғандықтан
Dialogue: 0,0:12:44.55,0:12:47.30,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:12:47.39,0:12:48.26,Default,,0,0,0,,О
Dialogue: 0,0:12:48.76,0:12:50.97,Default,,0,0,0,,Аои Бартоның жеңіске жету мүмкіндігі
Dialogue: 0,0:12:51.06,0:12:54.02,Default,,0,0,0,,50%-дан 80%-ға дейін өсті
Dialogue: 0,0:12:54.52,0:12:55.27,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:55.35,0:12:58.61,Default,,0,0,0,,Менің ойымша, дәл осы өргіштен абай болу керек.
Dialogue: 0,0:12:58.98,0:13:00.15,Default,,0,0,0,,Ахаха
Dialogue: 0,0:13:00.48,0:13:02.69,Default,,0,0,0,,Соны толығырақ қарастырайық.
Dialogue: 0,0:13:04.40,0:13:06.32,Default,,0,0,0,,Ұлдар мен қыздар
Dialogue: 0,0:13:06.41,0:13:08.16,Default,,0,0,0,,Бладердің киелі орны
Dialogue: 0,0:13:08.24,0:13:11.24,Default,,0,0,0,,Bay Arena ойынына қош келдіңіз!
Dialogue: 0,0:13:11.87,0:13:15.33,Default,,0,0,0,,Енді көптен күткен ұлттық турнир жекелей сайыс
Dialogue: 0,0:13:15.41,0:13:16.87,Default,,0,0,0,,Ақырында бұл ашылу!
Dialogue: 0,0:13:16.96,0:13:18.33,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:18.42,0:13:20.59,Default,,0,0,0,,WBBA турнирінің төрағасы
Dialogue: 0,0:13:20.67,0:13:22.96,Default,,0,0,0,,Синдзиро Комазакиден сәлем
Dialogue: 0,0:13:23.17,0:13:25.22,Default,,0,0,0,,Қиын іріктеу раундтарында жеңіске жету
Dialogue: 0,0:13:25.30,0:13:28.18,Default,,0,0,0,,Тағы да қайталау матчында жеңіске жеттік.
Dialogue: 0,0:13:28.26,0:13:30.01,Default,,0,0,0,,Таңдалған қалпақшалар
Dialogue: 0,0:13:30.30,0:13:33.68,Default,,0,0,0,,Енді нағыз чемпионды таңдайтын уақыт.
Dialogue: 0,0:13:34.02,0:13:36.89,Default,,0,0,0,,Мен әділ және қызу шайқас күтемін.
Dialogue: 0,0:13:36.98,0:13:38.52,Default,,0,0,0,,О!
Dialogue: 0,0:13:39.61,0:13:42.48,Default,,0,0,0,,1 тур 1 матч
Dialogue: 0,0:13:42.57,0:13:44.82,Default,,0,0,0,,Жақында басталады
Dialogue: 0,0:13:45.19,0:13:46.49,Default,,0,0,0,,Ақыры осында.
Dialogue: 0,0:13:46.57,0:13:49.11,Default,,0,0,0,,Қараңдаршы, барлығы сені қолдау үшін осында.
Dialogue: 0,0:13:49.24,0:13:49.82,Default,,0,0,0,,О
Dialogue: 0,0:13:49.91,0:13:51.37,Default,,0,0,0,,Хоудзи және басқалар
Dialogue: 0,0:13:51.45,0:13:53.41,Default,,0,0,0,,Жанып тұрған ғибадатхананың Доджо жігіттері де
Dialogue: 0,0:13:53.66,0:13:55.16,Default,,0,0,0,,Орочидің де орны
Dialogue: 0,0:13:57.92,0:14:00.00,Default,,0,0,0,,Біз осы уақытқа дейін жеттік.
Dialogue: 0,0:14:00.08,0:14:00.96,Default,,0,0,0,,О
Dialogue: 0,0:14:01.04,0:14:04.17,Default,,0,0,0,,Жеке шайқас Мен Балтомен ойнауды асыға күтемін.
Dialogue: 0,0:14:04.38,0:14:05.51,Default,,0,0,0,,Мен де
Dialogue: 0,0:14:05.59,0:14:07.72,Default,,0,0,0,,Әйтеуір мен кенеттен бір күшті сезіндім.
Dialogue: 0,0:14:07.80,0:14:09.43,Default,,0,0,0,,Менің қолым дірілдеп тұр
Dialogue: 0,0:14:09.51,0:14:12.81,Default,,0,0,0,,Сіз жеңілуден шаршап қана қоймай, тіпті қобалжыдыңыз ба?
Dialogue: 0,0:14:12.89,0:14:15.77,Default,,0,0,0,,Менің әдетім жоқ, мен де қобалжымаймын.
Dialogue: 0,0:14:15.85,0:14:17.14,Default,,0,0,0,,Менің қолым дірілдеп тұр.
Dialogue: 0,0:14:17.23,0:14:18.77,Default,,0,0,0,,Дірілдеме!
Dialogue: 0,0:14:19.31,0:14:21.23,Default,,0,0,0,,Екеуің де қалдырыңдар.
Dialogue: 0,0:14:21.31,0:14:22.82,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:14:22.90,0:14:24.94,Default,,0,0,0,,Аои Барто-кун телефонда.
Dialogue: 0,0:14:25.15,0:14:26.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:27.36,0:14:28.40,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:14:28.49,0:14:31.66,Default,,0,0,0,,Барт, осындай уақытта сізге қоңырау шалғаным үшін кешіріңіз.
Dialogue: 0,0:14:31.74,0:14:33.37,Default,,0,0,0,,Не болды, мама?
Dialogue: 0,0:14:33.45,0:14:35.79,Default,,0,0,0,,Мен ауырдым, дереу кел.
Dialogue: 0,0:14:35.87,0:14:37.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:37.33,0:14:38.62,Default,,0,0,0,,Анашым!
Dialogue: 0,0:14:40.83,0:14:42.08,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:44.25,0:14:45.13,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:49.09,0:14:50.26,Default,,0,0,0,,Ана
Dialogue: 0,0:14:54.60,0:14:55.76,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:14:55.85,0:14:58.77,Default,,0,0,0,,Белгісіздік деректері қалай өзгереді?
Dialogue: 0,0:14:59.27,0:15:01.98,Default,,0,0,0,,Хе... эксперимент жасау қызық.
Dialogue: 0,0:15:07.23,0:15:09.40,Default,,0,0,0,,1 тур 1 матч
Dialogue: 0,0:15:09.49,0:15:11.74,Default,,0,0,0,,О! Сенгісіз
Dialogue: 0,0:15:11.82,0:15:14.16,Default,,0,0,0,,Кенеттен жеңіске үміткер
Dialogue: 0,0:15:14.24,0:15:16.29,Default,,0,0,0,,Ширасаги сарайы Луиспен таныстыру.
Dialogue: 0,0:15:16.37,0:15:18.50,Default,,0,0,0,,Қарсылас – Какеру Некода
Dialogue: 0,0:15:18.58,0:15:20.75,Default,,0,0,0,,Жабайы мысықтың тырнақтары өткір.
Dialogue: 0,0:15:21.04,0:15:24.04,Default,,0,0,0,,Чемпионмен кездесу өткізгеніме қуаныштымын.
Dialogue: 0,0:15:24.13,0:15:25.21,Default,,0,0,0,,Мен жоғалтпаймын~
Dialogue: 0,0:15:27.00,0:15:28.38,Default,,0,0,0,,Мені назардан тыс қалдырмаңыз!
Dialogue: 0,0:15:30.72,0:15:31.84,Default,,0,0,0,,Мияу!
Dialogue: 0,0:15:31.93,0:15:34.47,Default,,0,0,0,,Лонгинус бір сәтте жарылды
Dialogue: 0,0:15:34.55,0:15:35.93,Default,,0,0,0,,Ханян…
Dialogue: 0,0:15:36.01,0:15:38.22,Default,,0,0,0,,Ширасаги сарайы Луис оңай
Dialogue: 0,0:15:38.31,0:15:40.52,Default,,0,0,0,,Екінші турға өту туралы шешім қабылданды!
Dialogue: 0,0:15:44.86,0:15:46.36,Default,,0,0,0,,Әкем полицияда қызмет етеді.
Dialogue: 0,0:15:46.44,0:15:47.32,Default,,0,0,0,,Не?
Dialogue: 0,0:15:47.65,0:15:48.86,Default,,0,0,0,,Балто жоқ
Dialogue: 0,0:15:48.94,0:15:50.53,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:15:50.61,0:15:52.07,Default,,0,0,0,,Содан бері көрмедім.
Dialogue: 0,0:15:52.28,0:15:53.36,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:54.66,0:15:55.91,Default,,0,0,0,,Комурасаки Вакия-кун
Dialogue: 0,0:15:55.99,0:15:57.58,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:15:57.74,0:15:59.91,Default,,0,0,0,,О, мен барамын.
Dialogue: 0,0:16:03.04,0:16:05.04,Default,,0,0,0,,Ана Ана
Dialogue: 0,0:16:07.63,0:16:09.63,Default,,0,0,0,,Анашым, амансыз ба?
Dialogue: 0,0:16:12.01,0:16:13.18,Default,,0,0,0,,Анашым...
Dialogue: 0,0:16:14.01,0:16:15.18,Default,,0,0,0,,Анашым!
Dialogue: 0,0:16:15.93,0:16:16.85,Default,,0,0,0,,Анашым!
Dialogue: 0,0:16:17.60,0:16:18.51,Default,,0,0,0,,Ана
Dialogue: 0,0:16:19.01,0:16:19.93,Default,,0,0,0,,Ана
Dialogue: 0,0:16:20.02,0:16:21.81,Default,,0,0,0,,Анашым!
Dialogue: 0,0:16:22.02,0:16:23.48,Default,,0,0,0,,Ха, аурухана!
Dialogue: 0,0:16:23.56,0:16:25.69,Default,,0,0,0,,Әй, Балто, не болды?
Dialogue: 0,0:16:25.77,0:16:27.15,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:16:27.23,0:16:28.61,Default,,0,0,0,,Жақсысың деп үміттенемін.
Dialogue: 0,0:16:28.94,0:16:30.15,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:30.61,0:16:32.28,Default,,0,0,0,,Қай жерде жарақат алдыңыз?
Dialogue: 0,0:16:32.70,0:16:34.61,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:16:35.20,0:16:36.62,Default,,0,0,0,,Уф, тым қызықсыз екен.
Dialogue: 0,0:16:37.32,0:16:39.99,Default,,0,0,0,,Сонымен қатар, Балт, матч қалай өтті?
Dialogue: 0,0:16:40.08,0:16:41.70,Default,,0,0,0,,Иә! Ах!
Dialogue: 0,0:16:41.79,0:16:42.79,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:42.87,0:16:44.12,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:16:48.63,0:16:51.84,Default,,0,0,0,,Жарайды! Келесі сары-жасыл Quon ...
Dialogue: 0,0:16:51.92,0:16:54.17,Default,,0,0,0,,Quad Quetzalcatl-мен таныстыру
Dialogue: 0,0:16:54.38,0:16:56.72,Default,,0,0,0,,Бальто сәйкестігі қандай сан?
Dialogue: 0,0:16:56.80,0:16:58.14,Default,,0,0,0,,Мен тыңдамадым.
Dialogue: 0,0:16:58.22,0:16:58.97,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:16:59.05,0:17:01.18,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:17:01.52,0:17:02.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:05.10,0:17:06.65,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:17:06.73,0:17:07.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:07.98,0:17:09.23,Default,,0,0,0,,Балто, жүгір!
Dialogue: 0,0:17:09.31,0:17:10.23,Default,,0,0,0,,Иә
Dialogue: 0,0:17:12.57,0:17:14.15,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:17:15.70,0:17:17.66,Default,,0,0,0,,(роботтың ұшып бара жатқан дыбысы)
Dialogue: 0,0:17:17.99,0:17:19.99,Default,,0,0,0,,Жолың болса, уақытында жетесің
Dialogue: 0,0:17:20.07,0:17:22.08,Default,,0,0,0,,Жолың болмаса, уақытында жете алмайсың.
Dialogue: 0,0:17:22.16,0:17:23.70,Default,,0,0,0,,Содан не болады?
Dialogue: 0,0:17:24.04,0:17:25.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:28.21,0:17:30.21,Default,,0,0,0,,Ааа, мен жеңілуді әдетке айналдырдым.
Dialogue: 0,0:17:30.71,0:17:33.17,Default,,0,0,0,,Бірдеңе бар!
Dialogue: 0,0:17:37.84,0:17:40.97,Default,,0,0,0,,Түсінбей тұрып, жүрегім қысылып барады.
Dialogue: 0,0:17:42.64,0:17:43.52,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:17:46.81,0:17:49.19,Default,,0,0,0,,Мен тарылып жатқан жоқпын!
Dialogue: 0,0:17:53.90,0:17:56.61,Default,,0,0,0,,Quad Quetzalcatl Burst Finish
Dialogue: 0,0:17:56.70,0:17:59.32,Default,,0,0,0,,Сары-жасыл Куон 3-0 есебімен жеңді
Dialogue: 0,0:17:59.62,0:18:00.99,Default,,0,0,0,,Кім жеңді
Dialogue: 0,0:18:01.08,0:18:03.04,Default,,0,0,0,,Бұл сары-жасыл Квон!
Dialogue: 0,0:18:03.12,0:18:05.29,Default,,0,0,0,,Әрине.
Dialogue: 0,0:18:07.00,0:18:08.83,Default,,0,0,0,,Балто қайтып келді ме?
Dialogue: 0,0:18:08.92,0:18:09.71,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:18:09.92,0:18:12.42,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:18:12.50,0:18:14.25,Default,,0,0,0,,Қызыл бұрыш
Dialogue: 0,0:18:14.34,0:18:16.67,Default,,0,0,0,,Қарсы кездесуде жеңіске жетті
Dialogue: 0,0:18:16.76,0:18:18.68,Default,,0,0,0,,Комурасаки Вакия!
Dialogue: 0,0:18:18.76,0:18:20.64,Default,,0,0,0,,Wild Wyvern қабілеті
Dialogue: 0,0:18:20.72,0:18:23.26,Default,,0,0,0,,Төрт он императорды қорқыта аласыз ба?
Dialogue: 0,0:18:23.35,0:18:25.93,Default,,0,0,0,,Сіздің сәйкестік келесі
Dialogue: 0,0:18:26.64,0:18:27.98,Default,,0,0,0,,Көк бұрыш
Dialogue: 0,0:18:28.06,0:18:30.85,Default,,0,0,0,,Топтық сайыс: Ең талантты 8 ойыншы
Dialogue: 0,0:18:30.94,0:18:32.98,Default,,0,0,0,,Энжодзи Такуто!
Dialogue: 0,0:18:34.36,0:18:37.19,Default,,0,0,0,,Жеке жарыс 3 балдық жүйе бойынша өтеді.
Dialogue: 0,0:18:37.40,0:18:40.53,Default,,0,0,0,,Айналдыру аяқталуы - 1 ұпай
Dialogue: 0,0:18:40.61,0:18:42.83,Default,,0,0,0,,Жедел мәре – 2 ұпай
Dialogue: 0,0:18:42.91,0:18:45.16,Default,,0,0,0,,Кім 3 ұпай алса, сол жеңеді.
Dialogue: 0,0:18:45.24,0:18:47.33,Default,,0,0,0,,Оссу! Қанекей мынаны істейік!
Dialogue: 0,0:18:47.41,0:18:48.87,Default,,0,0,0,,Бір сәт!
Dialogue: 0,0:18:48.96,0:18:50.00,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:18:50.08,0:18:51.96,Default,,0,0,0,,Жақсы
Dialogue: 0,0:18:52.04,0:18:54.13,Default,,0,0,0,,Бұл дегеніміз...
Dialogue: 0,0:18:54.21,0:18:55.96,Default,,0,0,0,,Эй... Эй, жуынатын бөлмеге барайық.
Dialogue: 0,0:18:56.09,0:18:57.21,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:18:57.34,0:19:00.93,Default,,0,0,0,,Уау! Тосын уақыт физиологиялық құбылыс болды.
Dialogue: 0,0:19:01.14,0:19:03.68,Default,,0,0,0,,Неліктен өзіңіз қаламайтын нәрсені жасайсыз?
Dialogue: 0,0:19:03.76,0:19:05.01,Default,,0,0,0,,Тым ұят!
Dialogue: 0,0:19:06.52,0:19:08.85,Default,,0,0,0,,Барто, сен сондасың ба?
Dialogue: 0,0:19:12.02,0:19:15.11,Default,,0,0,0,,Мен бұдан былай уақытты босқа өткізе алмаймын.
Dialogue: 0,0:19:17.40,0:19:19.44,Default,,0,0,0,,Мен енді білмеймін!
Dialogue: 0,0:19:20.82,0:19:21.99,Default,,0,0,0,,Комурасаки...
Dialogue: 0,0:19:24.70,0:19:27.04,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:19:27.54,0:19:29.71,Default,,0,0,0,,Мен сенімен финалда жұдырықтасқым келеді!
Dialogue: 0,0:19:30.21,0:19:33.42,Default,,0,0,0,,Шу, мен сенімен шайқасқым келеді.
Dialogue: 0,0:19:33.50,0:19:36.42,Default,,0,0,0,,Соңғы шайқаста бар күшіңізді салыңыз
Dialogue: 0,0:19:36.50,0:19:39.09,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:19:41.30,0:19:42.76,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:19:43.55,0:19:45.60,Default,,0,0,0,,Ұрысыңызға көңіл бөліңіз
Dialogue: 0,0:19:45.68,0:19:46.76,Default,,0,0,0,,Бару
Dialogue: 0,0:19:46.85,0:19:49.60,Default,,0,0,0,,Міне нағыз бәсеке осы жерден басталады!
Dialogue: 0,0:19:49.93,0:19:51.60,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:51.94,0:19:54.61,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:54.69,0:19:57.94,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:00.94,0:20:02.65,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:03.41,0:20:04.91,Default,,0,0,0,,Секундта өлтіріңіз!
Dialogue: 0,0:20:04.99,0:20:07.62,Default,,0,0,0,,Wild Wyvern Burst Finish
Dialogue: 0,0:20:07.83,0:20:10.79,Default,,0,0,0,,Шайқасқа келгенде уақытты үнемдей алмайсың.
Dialogue: 0,0:20:18.63,0:20:20.34,Default,,0,0,0,,Тағы бір екінші өлтіру
Dialogue: 0,0:20:21.13,0:20:22.47,Default,,0,0,0,,4-0
Dialogue: 0,0:20:22.55,0:20:24.43,Default,,0,0,0,,Вакия Комурасакидің жеңісі
Dialogue: 0,0:20:25.47,0:20:28.81,Default,,0,0,0,,Бұл менің жабайы Вайвернім бе?
Dialogue: 0,0:20:32.10,0:20:34.27,Default,,0,0,0,,Балто... Не болды?
Dialogue: 0,0:20:34.39,0:20:36.44,Default,,0,0,0,,Енді келесі шайқасқа.
Dialogue: 0,0:20:36.52,0:20:39.11,Default,,0,0,0,,Balt Aoi VS Naoki Mizusurface.
Dialogue: 0,0:20:39.19,0:20:40.32,Default,,0,0,0,,Командалық финалда
Dialogue: 0,0:20:40.40,0:20:44.36,Default,,0,0,0,,Қиян-кескі шайқасқа қатысқан Ширасаги Castle Louis және Wonder Boy.
Dialogue: 0,0:20:44.61,0:20:46.20,Default,,0,0,0,,Комета сияқты пайда болды
Dialogue: 0,0:20:46.28,0:20:48.53,Default,,0,0,0,,Бұл IQ bladers ойыны.
Dialogue: 0,0:20:49.28,0:20:52.58,Default,,0,0,0,,Бірінші болып Mizusurface Naoki пайда болды.
Dialogue: 0,0:20:53.54,0:20:57.46,Default,,0,0,0,,Келесі адам - ​​Аои Балт!
Dialogue: 0,0:20:57.54,0:21:00.75,Default,,0,0,0,,Әй, Аои Барто... Әй?
Dialogue: 0,0:21:00.84,0:21:03.01,Default,,0,0,0,,Ол жоқ Ол жерде жоқ Не болды?
Dialogue: 0,0:21:03.09,0:21:04.47,Default,,0,0,0,,Барто Аои!
Dialogue: 0,0:21:05.84,0:21:06.72,Default,,0,0,0,,Бар аға...
Dialogue: 0,0:21:06.80,0:21:07.80,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:07.89,0:21:08.93,Default,,0,0,0,,Әлгі ақымақ!
Dialogue: 0,0:21:09.64,0:21:11.85,Default,,0,0,0,,Хехе... Кешіріңіз.
Dialogue: 0,0:21:11.93,0:21:13.35,Default,,0,0,0,,Мен сіріңке ойнағым келді
Dialogue: 0,0:21:13.93,0:21:16.90,Default,,0,0,0,,Не болды! Ай Балт!
Dialogue: 0,0:21:16.98,0:21:17.90,Default,,0,0,0,,Барт…
Dialogue: 0,0:21:17.98,0:21:19.23,Default,,0,0,0,,Бітті.
Dialogue: 0,0:21:19.65,0:21:20.90,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:21:20.98,0:21:22.15,Default,,0,0,0,,Қалыс қалды деп есептелді…
Dialogue: 0,0:21:22.23,0:21:24.24,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:21:24.32,0:21:25.28,Default,,0,0,0,,
Dialogue: 0,0:21:25.49,0:21:26.32,Default,,0,0,0,,Ах
Dialogue: 0,0:21:26.41,0:21:27.57,Default,,0,0,0,,Хахаха
Dialogue: 0,0:21:27.78,0:21:31.08,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:21:31.16,0:21:33.87,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:21:35.46,0:21:37.92,Default,,0,0,0,,Хэхехе... Деректер дұрыс.
Dialogue: 0,0:21:42.46,0:21:44.09,Default,,0,0,0,,Амансың ба? Сіз
Dialogue: 0,0:21:44.55,0:21:47.05,Default,,0,0,0,,Бұл... жақсы!
Dialogue: 0,0:21:47.80,0:21:50.43,Default,,0,0,0,,Тәжірибелер қызықты
Dialogue: 0,0:21:50.76,0:21:53.85,Default,,0,0,0,,Жүр, шайқасайық!
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:25.98,0:23:27.73,Default,,0,0,0,,Транс жүргізуші?
Dialogue: 0,0:23:27.82,0:23:30.20,Default,,0,0,0,,Екі режим? Не айтқың келеді?
Dialogue: 0,0:23:30.28,0:23:32.82,Default,,0,0,0,,Шабуыл немесе төзімділік туралы анық болыңыз
Dialogue: 0,0:23:32.91,0:23:34.83,Default,,0,0,0,,Және одан да жұмбақ жүздер
Dialogue: 0,0:23:34.91,0:23:36.62,Default,,0,0,0,,Джин Айзава пайда болады
Dialogue: 0,0:23:36.74,0:23:39.16,Default,,0,0,0,,Сізді қамқоршы рух қорғай ма?
Dialogue: 0,0:23:39.25,0:23:41.29,Default,,0,0,0,,Наоки де, Джин де тым біртүрлі.
Dialogue: 0,0:23:41.37,0:23:43.29,Default,,0,0,0,,Балалар, не істеп жатырсыңдар?
Dialogue: 0,0:23:43.38,0:23:45.17,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:45.25,0:23:46.75,Default,,0,0,0,,Нептун тұзағы
Dialogue: 0,0:23:46.84,0:23:48.30,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.38,0:23:49.92,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.42,0:23:57.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory