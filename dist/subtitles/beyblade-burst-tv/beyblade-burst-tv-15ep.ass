Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.25,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.34,0:00:12.59,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.67,0:00:14.72,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.80,0:00:17.01,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.10,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.23,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.31,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.40,0:00:28.77,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.65,0:00:34.11,Default,,0,0,0,,Тез ату және қарсы үзіліс
Dialogue: 0,0:00:34.20,0:00:35.70,Default,,0,0,0,,Бетпе-бет соқтығыс
Dialogue: 0,0:00:35.78,0:00:38.45,Default,,0,0,0,,Бұл қорқынышты соқтығыс.
Dialogue: 0,0:00:38.66,0:00:40.58,Default,,0,0,0,,Тағы Валькирия!
Dialogue: 0,0:00:40.66,0:00:42.58,Default,,0,0,0,,Спригганды айналдыру
Dialogue: 0,0:00:45.21,0:00:46.46,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:00:46.54,0:00:48.63,Default,,0,0,0,,Оны қайтадан басыңыз!
Dialogue: 0,0:00:50.04,0:00:51.21,Default,,0,0,0,,Қазір! Спригган!
Dialogue: 0,0:00:51.38,0:00:52.88,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:00:56.26,0:00:57.01,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:00:57.18,0:00:59.18,Default,,0,0,0,,Спригган жылдамдығы артты
Dialogue: 0,0:01:00.56,0:01:02.72,Default,,0,0,0,,
Dialogue: 0,0:01:05.81,0:01:08.48,Default,,0,0,0,,Валькири ұшып кетті!
Dialogue: 0,0:01:09.48,0:01:10.69,Default,,0,0,0,,Спригган дауылы
Dialogue: 0,0:01:10.77,0:01:12.48,Default,,0,0,0,,1 ұпай артық аяқтау
Dialogue: 0,0:01:12.65,0:01:13.82,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:14.15,0:01:15.24,Default,,0,0,0,,Шу
Dialogue: 0,0:01:15.49,0:01:17.11,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:01:17.57,0:01:19.07,Default,,0,0,0,,Бұл қандай кадр?
Dialogue: 0,0:01:19.45,0:01:20.87,Default,,0,0,0,,Менің жаңа техникам
Dialogue: 0,0:01:21.41,0:01:22.95,Default,,0,0,0,,Жоғарғы түсіру
Dialogue: 0,0:01:30.75,0:01:33.13,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:33.46,0:01:38.64,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:49.94,0:01:53.32,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:53.82,0:01:55.94,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:56.36,0:02:00.49,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:00.62,0:02:03.83,Default,,0,0,0,,Дұрыс, бетпе-бет.
Dialogue: 0,0:02:03.95,0:02:10.38,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:10.67,0:02:15.09,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:15.59,0:02:21.01,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:21.14,0:02:23.39,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:23.47,0:02:28.18,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:28.35,0:02:33.44,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:33.73,0:02:35.98,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:36.19,0:02:38.53,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:38.82,0:02:42.74,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:42.91,0:02:47.91,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:48.12,0:02:50.29,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:53.88,0:02:57.30,Default,,0,0,0,,Қатты шайқас! Валькири Спригганға қарсы!
Dialogue: 0,0:02:58.13,0:03:03.60,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:03.80,0:03:05.56,Default,,0,0,0,,Осындай қызықты матч
Dialogue: 0,0:03:05.72,0:03:07.35,Default,,0,0,0,,Оның оңай аяқталуына жол бермеңіз
Dialogue: 0,0:03:07.47,0:03:08.93,Default,,0,0,0,,кеттік досым
Dialogue: 0,0:03:09.23,0:03:10.81,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:03:11.39,0:03:13.02,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:03:13.90,0:03:16.02,Default,,0,0,0,,Иығымның ауыруы күшейеді.
Dialogue: 0,0:03:16.15,0:03:17.86,Default,,0,0,0,,Жоқ, бұл туралы алаңдамаңыз.
Dialogue: 0,0:03:18.23,0:03:19.61,Default,,0,0,0,,Өз сезімдеріңізбен түсіріңіз
Dialogue: 0,0:03:19.78,0:03:21.95,Default,,0,0,0,,Шудың жоғарғы атуы
Dialogue: 0,0:03:22.07,0:03:23.62,Default,,0,0,0,,Одан қалай құтылуға болады?
Dialogue: 0,0:03:23.78,0:03:24.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:25.78,0:03:26.74,Default,,0,0,0,,Қатты жақын қашықтықтағы шайқаста ол дерлік ешқандай осал тұс қалдырмайды—
Dialogue: 0,0:03:26.83,0:03:28.62,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:03:28.70,0:03:30.37,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:03:30.46,0:03:33.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:33.58,0:03:34.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:34.71,0:03:36.63,Default,,0,0,0,,Менің ағам біртүрлі әрекет етеді.
Dialogue: 0,0:03:36.71,0:03:38.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:38.21,0:03:40.34,Default,,0,0,0,,Кәдімгі жаман әдеттер шықты.
Dialogue: 0,0:03:40.42,0:03:42.93,Default,,0,0,0,,Менің басым қайтадан пешкаға айналады.
Dialogue: 0,0:03:43.01,0:03:45.93,Default,,0,0,0,,Анау ақымақ, мұндай уақытта не істеп жүрсің?
Dialogue: 0,0:03:46.22,0:03:48.39,Default,,0,0,0,,Хахахаха... Ештеңе де өзгерген жоқ.
Dialogue: 0,0:03:48.47,0:03:50.56,Default,,0,0,0,,Балтоның жігіті сондай күлкілі
Dialogue: 0,0:03:51.52,0:03:54.02,Default,,0,0,0,,Сот Маған уақытыңызды беріңіз.
Dialogue: 0,0:03:54.48,0:03:56.02,Default,,0,0,0,,Уақыт күту уақыты
Dialogue: 0,0:03:57.32,0:04:00.57,Default,,0,0,0,,Не болды, Куришуу, сен уақытыңды алдың.
Dialogue: 0,0:04:00.65,0:04:03.99,Default,,0,0,0,,Ой, бұл біртүрлі әрекет ететін Аои Балт.
Dialogue: 0,0:04:04.07,0:04:05.78,Default,,0,0,0,,Тоңып қалыңыз және қозғалмаңыз
Dialogue: 0,0:04:06.37,0:04:07.28,Default,,0,0,0,,Балто ойыншысы
Dialogue: 0,0:04:07.37,0:04:08.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:08.33,0:04:09.99,Default,,0,0,0,,Пхуха~!
Dialogue: 0,0:04:10.08,0:04:11.54,Default,,0,0,0,,Мен өлемін деп ойладым!
Dialogue: 0,0:04:12.12,0:04:13.62,Default,,0,0,0,,Сіз деміңізді ұстадыңыз ба?
Dialogue: 0,0:04:13.92,0:04:15.46,Default,,0,0,0,,Сен өлесің
Dialogue: 0,0:04:15.63,0:04:17.83,Default,,0,0,0,,Балт, өзіңді ауыртпа, сабыр ет.
Dialogue: 0,0:04:17.92,0:04:19.55,Default,,0,0,0,,Көп ойланбаңыз
Dialogue: 0,0:04:19.88,0:04:21.59,Default,,0,0,0,,Жаттығуды ұмытпаңыз!
Dialogue: 0,0:04:22.05,0:04:23.42,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:04:23.63,0:04:25.72,Default,,0,0,0,,Тәжірибеде істемейтіндер
Dialogue: 0,0:04:25.80,0:04:27.43,Default,,0,0,0,,Сіз оны матчта да жасай алмайсыз.
Dialogue: 0,0:04:27.93,0:04:30.35,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:04:36.85,0:04:39.07,Default,,0,0,0,,Мен тек жаттығумен айналыстым.
Dialogue: 0,0:04:39.15,0:04:40.57,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:04:42.61,0:04:44.32,Default,,0,0,0,,Бар-нии, мынаны іш.
Dialogue: 0,0:04:48.57,0:04:50.41,Default,,0,0,0,,Барлығы дұрыс.
Dialogue: 0,0:04:50.49,0:04:52.33,Default,,0,0,0,,Мен қайталай жаздадым.
Dialogue: 0,0:04:53.33,0:04:55.04,Default,,0,0,0,,Мен өзімді сергек сезінемін!
Dialogue: 0,0:04:56.33,0:04:57.42,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:04:57.50,0:04:58.33,Default,,0,0,0,,Иә
Dialogue: 0,0:04:58.42,0:04:59.79,Default,,0,0,0,,Жарайды, жасайық.
Dialogue: 0,0:05:00.46,0:05:01.75,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:05:01.84,0:05:03.26,Default,,0,0,0,,қайтарылды
Dialogue: 0,0:05:03.34,0:05:04.92,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:05:05.93,0:05:07.72,Default,,0,0,0,,Бейбат кезінде
Dialogue: 0,0:05:07.97,0:05:09.89,Default,,0,0,0,,Мен біреу үшін бірінші рет уайымдап отырмын.
Dialogue: 0,0:05:11.10,0:05:12.18,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:05:14.02,0:05:15.18,Default,,0,0,0,,Барт
Dialogue: 0,0:05:15.27,0:05:17.31,Default,,0,0,0,,Сіздің жақсы достарыңыз бар сияқты.
Dialogue: 0,0:05:18.06,0:05:19.36,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:05:19.81,0:05:21.23,Default,,0,0,0,,Балто, кеттік.
Dialogue: 0,0:05:21.65,0:05:22.36,Default,,0,0,0,,О
Dialogue: 0,0:05:22.98,0:05:24.11,Default,,0,0,0,,Позиция қандай?
Dialogue: 0,0:05:24.32,0:05:26.20,Default,,0,0,0,,Бұл асығыс түсіру үшін арналған.
Dialogue: 0,0:05:26.90,0:05:28.95,Default,,0,0,0,,Қажетсіз нәрселер туралы ойламаңыз
Dialogue: 0,0:05:29.07,0:05:31.95,Default,,0,0,0,,Тек осы сәтке назар аударыңыз
Dialogue: 0,0:05:32.54,0:05:34.25,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:05:34.58,0:05:37.08,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:38.00,0:05:40.33,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:41.84,0:05:44.55,Default,,0,0,0,,Бірінші байланыс!
Dialogue: 0,0:05:44.67,0:05:48.09,Default,,0,0,0,,Спригган Валькиридің шабуылынан ығыстырылды
Dialogue: 0,0:05:48.18,0:05:51.05,Default,,0,0,0,,Бірақ Спригганның қарсы үзілісі бар.
Dialogue: 0,0:05:51.14,0:05:54.06,Default,,0,0,0,,Тіпті Flash Shoot бағдарламасының Спригганға еш қатысы жоқ.
Dialogue: 0,0:05:57.56,0:05:59.06,Default,,0,0,0,,Спригганға барыңыз
Dialogue: 0,0:06:01.27,0:06:02.02,Default,,0,0,0,,Ах
Dialogue: 0,0:06:02.15,0:06:03.48,Default,,0,0,0,,Есептегіш үзіліс
Dialogue: 0,0:06:03.65,0:06:06.57,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:06:06.65,0:06:07.24,Default,,0,0,0,,Ах
Dialogue: 0,0:06:07.53,0:06:09.95,Default,,0,0,0,,Додж Валкири Спригган
Dialogue: 0,0:06:10.03,0:06:11.82,Default,,0,0,0,,Стадионға жүгір!
Dialogue: 0,0:06:11.91,0:06:14.74,Default,,0,0,0,,Барыңыз~ Валькирия!
Dialogue: 0,0:06:15.91,0:06:18.08,Default,,0,0,0,,Валькирияның жылдамдығы артып келеді.
Dialogue: 0,0:06:18.16,0:06:21.33,Default,,0,0,0,,Есептегішті алып тастаңыз және спригганды арт жағынан соғыңыз.
Dialogue: 0,0:06:21.54,0:06:23.29,Default,,0,0,0,,Сыртқа шығаруға болады
Dialogue: 0,0:06:23.42,0:06:25.51,Default,,0,0,0,,Ол бірден таңғажайып нәрсе жасады.
Dialogue: 0,0:06:26.26,0:06:27.01,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:27.38,0:06:28.97,Default,,0,0,0,,Бұл дыбыс
Dialogue: 0,0:06:29.38,0:06:31.09,Default,,0,0,0,,Есептегіш үзіліс емес
Dialogue: 0,0:06:34.14,0:06:36.35,Default,,0,0,0,,Спригганның жоғарғы түсірілімі!
Dialogue: 0,0:06:38.89,0:06:40.44,Default,,0,0,0,,Түсіру сәті
Dialogue: 0,0:06:40.73,0:06:42.48,Default,,0,0,0,,Балтоның қимылдарына жауап ретінде
Dialogue: 0,0:06:42.56,0:06:44.57,Default,,0,0,0,,Оны жоғарғы кадрға өзгертті
Dialogue: 0,0:06:45.40,0:06:47.40,Default,,0,0,0,,Мұны істеме Шуу
Dialogue: 0,0:06:50.53,0:06:51.41,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:51.49,0:06:54.20,Default,,0,0,0,,Спригганның жоғарғы соққысы анықталды!
Dialogue: 0,0:06:54.33,0:06:55.20,Default,,0,0,0,,
Dialogue: 0,0:06:55.33,0:06:57.41,Default,,0,0,0,,Ол жарылып кетті!
Dialogue: 0,0:06:58.20,0:07:01.37,Default,,0,0,0,,Міне! Valkyrie Burst!
Dialogue: 0,0:07:01.46,0:07:02.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:03.42,0:07:04.17,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:04.67,0:07:05.34,Default,,0,0,0,,Міне, барамын!
Dialogue: 0,0:07:05.46,0:07:08.21,Default,,0,0,0,,Спригган үшін 2 ұпай
Dialogue: 0,0:07:08.30,0:07:09.92,Default,,0,0,0,,Барлығы 3 ұпай
Dialogue: 0,0:07:10.01,0:07:11.51,Default,,0,0,0,,Финалдық матч 3-0
Dialogue: 0,0:07:11.59,0:07:12.76,Default,,0,0,0,,Қатты күшпен
Dialogue: 0,0:07:12.84,0:07:16.01,Default,,0,0,0,,Куришудың жеңісімен...
Dialogue: 0,0:07:16.14,0:07:17.22,Default,,0,0,0,,О!
Dialogue: 0,0:07:17.85,0:07:21.64,Default,,0,0,0,,Үкім шығарылған жоқ па?
Dialogue: 0,0:07:21.85,0:07:23.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:23.44,0:07:24.36,Default,,0,0,0,,Не?
Dialogue: 0,0:07:24.69,0:07:25.82,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:07:26.23,0:07:29.24,Default,,0,0,0,,Жарылыс қону алдында немесе кейін болды ма?
Dialogue: 0,0:07:29.57,0:07:31.03,Default,,0,0,0,,Төреші де абдырап қалды.
Dialogue: 0,0:07:31.24,0:07:33.74,Default,,0,0,0,,Алдымен жарылып кетсе, бітті.
Dialogue: 0,0:07:33.82,0:07:35.53,Default,,0,0,0,,Бірақ кейінірек
Dialogue: 0,0:07:35.62,0:07:37.91,Default,,0,0,0,,Артық мәре үшін 1 ұпай
Dialogue: 0,0:07:37.99,0:07:39.70,Default,,0,0,0,,Шайқас әлі аяқталған жоқ.
Dialogue: 0,0:07:40.20,0:07:41.37,Default,,0,0,0,,Құдай-ай, қандай қорқақ! Саған бірден келіп шабуыл жаса деп айтып тұрмын!
Dialogue: 0,0:07:45.17,0:07:46.84,Default,,0,0,0,,Енді ойынға
Dialogue: 0,0:07:46.92,0:07:49.17,Default,,0,0,0,,Ол бейне сотқа жіберілді.
Dialogue: 0,0:07:55.22,0:07:58.39,Default,,0,0,0,,Бұл... жерге қосу бір сәтке жылдамырақ!
Dialogue: 0,0:07:58.60,0:07:59.39,Default,,0,0,0,,Спригган
Dialogue: 0,0:07:59.47,0:08:01.77,Default,,0,0,0,,Артық мәре үшін 1 ұпай
Dialogue: 0,0:08:01.85,0:08:03.23,Default,,0,0,0,,Барлығы 2 ұпай
Dialogue: 0,0:08:03.44,0:08:05.35,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:08:05.44,0:08:07.52,Default,,0,0,0,,Бұл аман қалу. Сен аман қалдың.
Dialogue: 0,0:08:07.61,0:08:09.82,Default,,0,0,0,,Ойын әлі аяқталған жоқ
Dialogue: 0,0:08:09.90,0:08:12.28,Default,,0,0,0,,Үшінші шайқас басталды!
Dialogue: 0,0:08:12.36,0:08:13.78,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:14.57,0:08:16.32,Default,,0,0,0,,Қауіпсіз сейф аман қалды!
Dialogue: 0,0:08:16.66,0:08:18.91,Default,,0,0,0,,Бірақ 2 ұпай алынады
Dialogue: 0,0:08:18.99,0:08:20.12,Default,,0,0,0,,Істейтін ештеңе қалмады
Dialogue: 0,0:08:20.45,0:08:22.71,Default,,0,0,0,,Қыңыр Балто
Dialogue: 0,0:08:23.04,0:08:24.62,Default,,0,0,0,,Өйткені, бәрі сіздің қабілетіңізге байланысты.
Dialogue: 0,0:08:24.79,0:08:26.88,Default,,0,0,0,,Шу ең жақсырақ.
Dialogue: 0,0:08:27.50,0:08:29.67,Default,,0,0,0,,Егер Y финалға шықса ше?
Dialogue: 0,0:08:29.75,0:08:30.59,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:08:31.92,0:08:35.01,Default,,0,0,0,,Кешіріңіз, Валькири жарылды.
Dialogue: 0,0:08:35.68,0:08:37.72,Default,,0,0,0,,Бірақ мен берілмеймін
Dialogue: 0,0:08:38.51,0:08:39.51,Default,,0,0,0,,Шу!
Dialogue: 0,0:08:40.01,0:08:42.23,Default,,0,0,0,,Бұл финалдық матч болды.
Dialogue: 0,0:08:42.31,0:08:44.48,Default,,0,0,0,,Осы уақытқа дейін біткен болар еді.
Dialogue: 0,0:08:45.39,0:08:46.10,Default,,0,0,0,,О
Dialogue: 0,0:08:46.48,0:08:47.48,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:08:47.56,0:08:49.23,Default,,0,0,0,,Сізбен ауыр шайқас
Dialogue: 0,0:08:49.52,0:08:50.90,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:08:54.45,0:08:55.99,Default,,0,0,0,,Алдыңғы қимылмен
Dialogue: 0,0:08:56.53,0:08:58.16,Default,,0,0,0,,Мен сені тағы да ренжіткен болармын.
Dialogue: 0,0:08:59.58,0:09:00.74,Default,,0,0,0,,Шу
Dialogue: 0,0:09:01.20,0:09:03.70,Default,,0,0,0,,Күтуден асатын лездік қозғалыстар үшін
Dialogue: 0,0:09:03.79,0:09:05.62,Default,,0,0,0,,Үлкен жүктеме
Dialogue: 0,0:09:06.08,0:09:07.25,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:09:07.33,0:09:08.67,Default,,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,0:09:10.59,0:09:12.13,Default,,0,0,0,,Келесі түсірілімде
Dialogue: 0,0:09:12.26,0:09:13.30,Default,,0,0,0,,Шешім
Dialogue: 0,0:09:13.38,0:09:15.01,Default,,0,0,0,,Екінші шайқасқа дейін аяқталды
Dialogue: 0,0:09:15.09,0:09:17.59,Default,,0,0,0,,Шуу Куренаи мен Барто Аои арасындағы финалдық матч
Dialogue: 0,0:09:17.72,0:09:20.43,Default,,0,0,0,,Жанымызды қыздырады
Dialogue: 0,0:09:20.51,0:09:21.97,Default,,0,0,0,,Қызықты!
Dialogue: 0,0:09:22.18,0:09:24.18,Default,,0,0,0,,Бару-нии, бар күшіңді сал!
Dialogue: 0,0:09:24.31,0:09:26.02,Default,,0,0,0,,Балто! Балтық!
Dialogue: 0,0:09:26.35,0:09:29.98,Default,,0,0,0,,Балто! Балтық!
Dialogue: 0,0:09:30.15,0:09:31.77,Default,,0,0,0,,Бауырым, сен ақымақ бола алмайсың.
Dialogue: 0,0:09:31.86,0:09:33.57,Default,,0,0,0,,Шу-кунды да қолдаңыз!
Dialogue: 0,0:09:33.73,0:09:35.74,Default,,0,0,0,,Ой... Жарайды, түсіндім.
Dialogue: 0,0:09:35.82,0:09:37.53,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Шуу
Dialogue: 0,0:09:37.86,0:09:40.07,Default,,0,0,0,,Шуу-кун, қолыңнан келгенін істе
Dialogue: 0,0:09:40.87,0:09:42.08,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:09:45.08,0:09:47.75,Default,,0,0,0,,Менің иығым шегінде, бірақ...
Dialogue: 0,0:09:48.33,0:09:51.09,Default,,0,0,0,,Барто Сезіміңізге жауап беру үшін,
Dialogue: 0,0:09:52.34,0:09:54.01,Default,,0,0,0,,Бар күшіңізбен атыңыз
Dialogue: 0,0:09:54.09,0:09:56.26,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе~
Dialogue: 0,0:09:56.42,0:09:58.55,Default,,0,0,0,,Уф… уф…
Dialogue: 0,0:09:58.93,0:09:59.93,Default,,0,0,0,,♬~
Dialogue: 0,0:10:00.26,0:10:02.01,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе~
Dialogue: 0,0:10:02.22,0:10:04.64,Default,,0,0,0,,Сәттілік тілеймін, Балто-кун
Dialogue: 0,0:10:04.97,0:10:05.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:06.02,0:10:06.64,Default,,0,0,0,,Уа!
Dialogue: 0,0:10:06.73,0:10:08.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:08.35,0:10:09.23,Default,,0,0,0,,♬~
Dialogue: 0,0:10:09.31,0:10:10.19,Default,,0,0,0,,Шака
Dialogue: 0,0:10:10.27,0:10:12.15,Default,,0,0,0,,Тағы бір рет, тағы бір шайқас.
Dialogue: 0,0:10:12.36,0:10:13.19,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:13.27,0:10:15.48,Default,,0,0,0,,Қанша рет тырыссаң да солай.
Dialogue: 0,0:10:15.69,0:10:17.57,Default,,0,0,0,,Балто, тоқтат.
Dialogue: 0,0:10:17.65,0:10:19.45,Default,,0,0,0,,Шакаға сәйкестік жоқ
Dialogue: 0,0:10:19.66,0:10:22.53,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:10:22.62,0:10:25.41,Default,,0,0,0,,Мен ұтыла аламын ба?
Dialogue: 0,0:10:28.12,0:10:29.21,Default,,0,0,0,,О!
Dialogue: 0,0:10:30.17,0:10:31.75,Default,,0,0,0,,Мен жеңіліске жол бере алмаймын!
Dialogue: 0,0:10:31.83,0:10:32.59,Default,,0,0,0,,Уау
Dialogue: 0,0:10:32.71,0:10:33.54,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:10:34.13,0:10:35.50,Default,,0,0,0,,Ауырды
Dialogue: 0,0:10:35.59,0:10:38.05,Default,,0,0,0,,Балто Басқа адам басқаша.
Dialogue: 0,0:10:38.13,0:10:40.43,Default,,0,0,0,,Кухаха...
Dialogue: 0,0:10:40.51,0:10:41.84,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:10:42.05,0:10:44.72,Default,,0,0,0,,Күлме!
Dialogue: 0,0:10:45.89,0:10:48.64,Default,,0,0,0,,Балто, сен өзгерген жоқсың.
Dialogue: 0,0:10:48.73,0:10:50.27,Default,,0,0,0,,Әрқашан түзу бол
Dialogue: 0,0:10:50.48,0:10:51.85,Default,,0,0,0,,Бар күшіңізбен соған қарай жүріңіз
Dialogue: 0,0:10:55.65,0:10:57.99,Default,,0,0,0,,Тез түсіру және жылдам түсіру
Dialogue: 0,0:10:58.07,0:10:59.82,Default,,0,0,0,,Өте жақсы басылған
Dialogue: 0,0:10:59.95,0:11:02.11,Default,,0,0,0,,Бірақ мен мұның осымен біткенін қаламаймын.
Dialogue: 0,0:11:02.62,0:11:05.83,Default,,0,0,0,,Мен сенімен көбірек шайқасқым келеді.
Dialogue: 0,0:11:05.91,0:11:09.91,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:11:10.00,0:11:12.92,Default,,0,0,0,,Серік, маған күшіңді бер.
Dialogue: 0,0:11:13.42,0:11:15.09,Default,,0,0,0,,Балтоның денесінен
Dialogue: 0,0:11:15.17,0:11:16.59,Default,,0,0,0,,Мен азырақ қобалжыдым.
Dialogue: 0,0:11:17.05,0:11:19.26,Default,,0,0,0,,Қандай заклинание жасадыңыз?
Dialogue: 0,0:11:19.47,0:11:21.22,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:11:21.68,0:11:24.47,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:24.55,0:11:27.18,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:27.81,0:11:29.43,Default,,0,0,0,,Мен атып тастадым!
Dialogue: 0,0:11:29.52,0:11:31.31,Default,,0,0,0,,Спригган орталыққа қарай бет алды
Dialogue: 0,0:11:31.39,0:11:34.23,Default,,0,0,0,,Валькири бірінші байланыста асығады!
Dialogue: 0,0:11:34.31,0:11:36.77,Default,,0,0,0,,Бұл флэш түсіру және қарсы үзіліс.
Dialogue: 0,0:11:37.19,0:11:39.94,Default,,0,0,0,,Бұл ауыр соқтығыс.
Dialogue: 0,0:11:40.32,0:11:41.86,Default,,0,0,0,,Мен атып тастадым!
Dialogue: 0,0:11:41.95,0:11:43.74,Default,,0,0,0,,Спригган орталыққа қарай
Dialogue: 0,0:11:43.82,0:11:46.66,Default,,0,0,0,,Валькири бірінші байланыста асығады!
Dialogue: 0,0:11:46.74,0:11:48.45,Default,,0,0,0,,Енді тағы да солай болады
Dialogue: 0,0:11:48.54,0:11:49.50,Default,,0,0,0,,Бал-нии...
Dialogue: 0,0:11:51.08,0:11:53.71,Default,,0,0,0,,Жоқ, Валькирияның күші артып келеді.
Dialogue: 0,0:11:54.00,0:11:55.71,Default,,0,0,0,,Бұл бұрынғыдан да керемет.
Dialogue: 0,0:11:58.80,0:12:01.26,Default,,0,0,0,,Менің шиеленісім жойылып, күшім артты.
Dialogue: 0,0:12:01.76,0:12:03.09,Default,,0,0,0,,Мұны істеме, Барто
Dialogue: 0,0:12:06.18,0:12:08.85,Default,,0,0,0,,Валькириялық қарсы үзілістен жалтарды
Dialogue: 0,0:12:08.93,0:12:10.64,Default,,0,0,0,,Валькирияға барыңыз
Dialogue: 0,0:12:10.98,0:12:12.31,Default,,0,0,0,,Жоғарғы түсірілім!
Dialogue: 0,0:12:14.52,0:12:17.15,Default,,0,0,0,,Спригганның жоғарғы соққысы
Dialogue: 0,0:12:18.07,0:12:18.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:18.77,0:12:19.86,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:19.94,0:12:23.03,Default,,0,0,0,,Валькири Спригганның алдынан жоғалып кетті.
Dialogue: 0,0:12:23.11,0:12:24.16,Default,,0,0,0,,Жоғары жылдамдықты қозғалыс... жоқ
Dialogue: 0,0:12:24.36,0:12:25.74,Default,,0,0,0,,Телепорталды!
Dialogue: 0,0:12:27.16,0:12:30.24,Default,,0,0,0,,Шынайы флэш түсіру!
Dialogue: 0,0:12:30.45,0:12:32.25,Default,,0,0,0,,Валькириялық шабуылдар
Dialogue: 0,0:12:32.33,0:12:34.71,Default,,0,0,0,,Бұл флеш түсірудің эволюциясы
Dialogue: 0,0:12:34.79,0:12:36.46,Default,,0,0,0,,Шынайы жарқыл түсіру
Dialogue: 0,0:12:36.92,0:12:37.75,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:12:43.01,0:12:44.01,Default,,0,0,0,,(Киё) Танжиро-сан, сен барынша тырысып жатырсың. (Суми) Иә!
Dialogue: 0,0:12:44.30,0:12:46.09,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:12:49.93,0:12:51.85,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:12:55.27,0:12:56.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:59.94,0:13:01.28,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:13:01.36,0:13:03.36,Default,,0,0,0,,Rash Shoot түріне өзгертілді
Dialogue: 0,0:13:03.65,0:13:04.57,Default,,0,0,0,,Керемет!
Dialogue: 0,0:13:04.65,0:13:07.62,Default,,0,0,0,,Валькирияның шынайы жарқылы
Dialogue: 0,0:13:07.70,0:13:09.16,Default,,0,0,0,,Тез ату?
Dialogue: 0,0:13:09.28,0:13:12.95,Default,,0,0,0,,(Киё) Танжиро-сан, сен барынша тырысып жатырсың. (Суми) Иә!
Dialogue: 0,0:13:14.08,0:13:15.87,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:13:16.54,0:13:18.04,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:13:20.38,0:13:21.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:22.42,0:13:26.09,Default,,0,0,0,,Спригган қалай жарылған?
Dialogue: 0,0:13:26.18,0:13:28.59,Default,,0,0,0,,Оқиғаның күтпеген бұрылысы!
Dialogue: 0,0:13:28.76,0:13:30.89,Default,,0,0,0,,Жарып біткен
Dialogue: 0,0:13:30.97,0:13:32.68,Default,,0,0,0,,Валькирия 2 ұпай
Dialogue: 0,0:13:33.68,0:13:37.02,Default,,0,0,0,,Менің көз алдымда адам сенбейтін нәрсе болып жатыр.
Dialogue: 0,0:13:37.10,0:13:38.94,Default,,0,0,0,,Осы уақытқа дейін мен бір ұпай жинаған жоқпын.
Dialogue: 0,0:13:39.02,0:13:41.11,Default,,0,0,0,,Осы уақытқа дейін келген Бенишудан
Dialogue: 0,0:13:41.19,0:13:43.36,Default,,0,0,0,,Аои Балттың Жеңіс Валькириясы
Dialogue: 0,0:13:43.44,0:13:45.90,Default,,0,0,0,,Мен нүктелерді түсірдім.
Dialogue: 0,0:13:48.91,0:13:51.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:51.66,0:13:54.58,Default,,0,0,0,,Барто Аои галстукке жетті!
Dialogue: 0,0:13:54.66,0:13:56.96,Default,,0,0,0,,Ойын әлі аяқталған жоқ.
Dialogue: 0,0:13:57.04,0:13:59.33,Default,,0,0,0,,Валькири жасады!
Dialogue: 0,0:13:59.92,0:14:01.63,Default,,0,0,0,,Бал-нии керемет
Dialogue: 0,0:14:01.71,0:14:03.25,Default,,0,0,0,,Үлкен аға керемет
Dialogue: 0,0:14:03.59,0:14:05.09,Default,,0,0,0,,Жақсы, Балто.
Dialogue: 0,0:14:05.17,0:14:06.97,Default,,0,0,0,,Бұл жаңа қулық.
Dialogue: 0,0:14:07.59,0:14:09.05,Default,,0,0,0,,Жаңа техника?
Dialogue: 0,0:14:09.55,0:14:11.68,Default,,0,0,0,,Жаңа техникаға атау беріңіз.
Dialogue: 0,0:14:11.80,0:14:12.76,Default,,0,0,0,,О!
Dialogue: 0,0:14:12.85,0:14:14.85,Default,,0,0,0,,Валькири Сіз не істейсіз?
Dialogue: 0,0:14:14.93,0:14:16.93,Default,,0,0,0,,Жаңа техникаңыздың атауы
Dialogue: 0,0:14:18.94,0:14:22.98,Default,,0,0,0,,Өйткені бұл True Flash Shot және Rash Shot комбинациясы.
Dialogue: 0,0:14:23.07,0:14:25.69,Default,,0,0,0,,Шынайы жылдам түсіру
Dialogue: 0,0:14:26.24,0:14:27.15,Default,,0,0,0,,Керемет
Dialogue: 0,0:14:27.24,0:14:28.32,Default,,0,0,0,,Немесе ол Колоссалдық Титан сияқты ма.
Dialogue: 0,0:14:28.90,0:14:30.99,Default,,0,0,0,,Валькири мұны мен үшін жасады.
Dialogue: 0,0:14:31.62,0:14:32.91,Default,,0,0,0,,Сізге ұқсайды.
Dialogue: 0,0:14:33.37,0:14:34.87,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:35.24,0:14:36.20,Default,,0,0,0,,Сот шешімі
Dialogue: 0,0:14:36.33,0:14:39.79,Default,,0,0,0,,Мен іске қосқышты ауыстырғым келеді, сондықтан маған уақыт беріңіз.
Dialogue: 0,0:14:39.87,0:14:41.33,Default,,0,0,0,,Күту уақыты
Dialogue: 0,0:14:41.42,0:14:43.59,Default,,0,0,0,,Кел, Куришу мұнда.
Dialogue: 0,0:14:43.67,0:14:46.17,Default,,0,0,0,,Іске қосу құралын ауыстыруға біраз уақыт бөліңіз
Dialogue: 0,0:14:46.26,0:14:48.17,Default,,0,0,0,,Күту бөлмесіне оралу.
Dialogue: 0,0:14:53.35,0:14:54.76,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:55.89,0:14:56.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:57.10,0:14:58.89,Default,,0,0,0,,Тағы бір рет жеткілікті
Dialogue: 0,0:14:59.02,0:15:00.27,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:15:00.60,0:15:01.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:01.98,0:15:03.06,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:15:03.36,0:15:04.52,Default,,0,0,0,,Шу
Dialogue: 0,0:15:04.61,0:15:05.86,Default,,0,0,0,,Ол сынған ба?
Dialogue: 0,0:15:07.40,0:15:09.11,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:15:09.28,0:15:10.40,Default,,0,0,0,,Іске қосу құралы
Dialogue: 0,0:15:10.49,0:15:11.66,Default,,0,0,0,,Алдамаңыз
Dialogue: 0,0:15:11.74,0:15:14.16,Default,,0,0,0,,Ол қатты қиналған сияқты.
Dialogue: 0,0:15:15.99,0:15:17.49,Default,,0,0,0,,Қолыңызды көтере алмайсыз ба?
Dialogue: 0,0:15:19.79,0:15:21.54,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:15:21.62,0:15:24.13,Default,,0,0,0,,Мен мұндай нәрселерді жиі жасаймын.
Dialogue: 0,0:15:25.38,0:15:28.92,Default,,0,0,0,,Мен тоқтасам да сен жасайсың.
Dialogue: 0,0:15:29.09,0:15:31.09,Default,,0,0,0,,Білсеңіздер кетіңіздер.
Dialogue: 0,0:15:31.63,0:15:33.84,Default,,0,0,0,,Гахаха...
Dialogue: 0,0:15:34.18,0:15:36.35,Default,,0,0,0,,Өздеріңіз білетіндей, мен
Dialogue: 0,0:15:36.43,0:15:37.89,Default,,0,0,0,,Ол жақсы жігіт.
Dialogue: 0,0:15:38.35,0:15:39.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:39.64,0:15:41.44,Default,,0,0,0,,Өте мейірімді
Dialogue: 0,0:15:41.52,0:15:43.94,Default,,0,0,0,,Шақа – халық ұнататын адам.
Dialogue: 0,0:15:44.02,0:15:45.98,Default,,0,0,0,,Ух... аа аа
Dialogue: 0,0:15:46.36,0:15:47.27,Default,,0,0,0,,Тыныш отырыңыз
Dialogue: 0,0:15:47.36,0:15:51.40,Default,,0,0,0,,(резонанс)
Dialogue: 0,0:15:51.49,0:15:52.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:52.91,0:15:53.61,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:56.41,0:15:57.24,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:57.62,0:15:58.79,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:15:59.04,0:16:01.66,Default,,0,0,0,,Мен ауырсынуды басатын қысым нүктелерін басып, назарымды аудардым.
Dialogue: 0,0:16:01.79,0:16:04.04,Default,,0,0,0,,Егер сізде тағы бір оқ болса
Dialogue: 0,0:16:04.12,0:16:05.71,Default,,0,0,0,,Бұл бірдеңе жасайды
Dialogue: 0,0:16:08.17,0:16:09.84,Default,,0,0,0,,Ауырсыну басылды
Dialogue: 0,0:16:10.46,0:16:12.59,Default,,0,0,0,,Бірақ бұл уақытша алдау.
Dialogue: 0,0:16:12.97,0:16:15.09,Default,,0,0,0,,Матчтан кейін дұрыс ем алуым керек.
Dialogue: 0,0:16:15.18,0:16:16.85,Default,,0,0,0,,Ол одан сайын нашарлайды.
Dialogue: 0,0:16:16.93,0:16:18.10,Default,,0,0,0,,Шака…
Dialogue: 0,0:16:18.35,0:16:20.85,Default,,0,0,0,,Мен Балто екеуіңнің бар күшімен күрескендеріңді қалаймын.
Dialogue: 0,0:16:20.93,0:16:22.73,Default,,0,0,0,,Мен оны соңына дейін көргім келеді.
Dialogue: 0,0:16:25.31,0:16:26.36,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:16:26.44,0:16:28.52,Default,,0,0,0,,Балто стадионда күтіп тұр.
Dialogue: 0,0:16:28.61,0:16:29.23,Default,,0,0,0,,О
Dialogue: 0,0:16:37.74,0:16:39.12,Default,,0,0,0,,Және мен
Dialogue: 0,0:16:39.20,0:16:41.25,Default,,0,0,0,,Мен сенімен тағы да ұрысқым келеді
Dialogue: 0,0:16:44.54,0:16:47.25,Default,,0,0,0,,Енді тағдырлы күштер шайқасы
Dialogue: 0,0:16:47.33,0:16:49.63,Default,,0,0,0,,Шумен жарыса алсаң
Dialogue: 0,0:16:49.71,0:16:50.38,Default,,0,0,0,,Шығып бара жатырсың ба?
Dialogue: 0,0:16:50.46,0:16:53.17,Default,,0,0,0,,True Flash Rush Shoot - бұл жалғыз жол.
Dialogue: 0,0:16:53.92,0:16:56.68,Default,,0,0,0,,Балтоның жаңа техникасына қалай қарсы тұру керек
Dialogue: 0,0:16:57.18,0:16:58.64,Default,,0,0,0,,Менің оны босатудан басқа амалым жоқ.
Dialogue: 0,0:16:58.93,0:17:00.47,Default,,0,0,0,,Өтінемін, досым.
Dialogue: 0,0:17:00.93,0:17:02.47,Default,,0,0,0,,Жасайық Спригган
Dialogue: 0,0:17:03.10,0:17:04.85,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:17:05.44,0:17:08.77,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:08.86,0:17:11.57,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:13.69,0:17:17.78,Default,,0,0,0,,Екі еркек те алға зарядтайды. Қайсысы бірінші қадам жасайды?
Dialogue: 0,0:17:18.41,0:17:21.24,Default,,0,0,0,,Бірінші контактіні Валькири итермеледі.
Dialogue: 0,0:17:22.24,0:17:24.12,Default,,0,0,0,,(Киё) Танжиро-сан, сен барынша тырысып жатырсың. (Суми) Иә!
Dialogue: 0,0:17:24.20,0:17:26.42,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:17:28.29,0:17:29.96,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:17:32.63,0:17:35.84,Default,,0,0,0,,Шынайы флэш түсіру!
Dialogue: 0,0:17:35.92,0:17:38.43,Default,,0,0,0,,Айнымалы жүргізуші стадионның ойықтарын ұстайды
Dialogue: 0,0:17:38.51,0:17:40.72,Default,,0,0,0,,Жылдамдық кенет өсті!
Dialogue: 0,0:17:40.80,0:17:42.31,Default,,0,0,0,,(Киё) Танжиро-сан, сен барынша тырысып жатырсың. (Суми) Иә!
Dialogue: 0,0:17:42.39,0:17:43.72,Default,,0,0,0,,Спригган!
Dialogue: 0,0:17:47.60,0:17:50.36,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:17:52.40,0:17:53.32,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:17:53.40,0:17:55.57,Default,,0,0,0,,Спригган да телепортация жасайды!
Dialogue: 0,0:17:55.65,0:17:58.20,Default,,0,0,0,,Нағыз есептегіш үзіліс!
Dialogue: 0,0:18:01.66,0:18:04.12,Default,,0,0,0,,Жылдам Екеуі де шексіз жылдам
Dialogue: 0,0:18:04.20,0:18:06.91,Default,,0,0,0,,Олар адам сенгісіз жылдамдықпен соқтығысуда.
Dialogue: 0,0:18:10.88,0:18:12.92,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:18:19.64,0:18:21.18,Default,,0,0,0,,Жылдамдық төмендеді
Dialogue: 0,0:18:21.26,0:18:24.14,Default,,0,0,0,,Не болады, не болады, не болады!
Dialogue: 0,0:18:27.27,0:18:29.39,Default,,0,0,0,,Екі ұшақ бірдей дерлік тоқтады!
Dialogue: 0,0:18:29.73,0:18:30.35,Default,,0,0,0,,Ах
Dialogue: 0,0:18:31.98,0:18:32.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:38.78,0:18:40.07,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:18:43.08,0:18:46.58,Default,,0,0,0,,Сторм Спригган 1 ұпай айналдырумен
Dialogue: 0,0:18:47.00,0:18:49.33,Default,,0,0,0,,Куришуу 3-2 есебімен жеңді!
Dialogue: 0,0:18:49.58,0:18:50.58,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:50.79,0:18:53.67,Default,,0,0,0,,Ах~
Dialogue: 0,0:18:54.63,0:18:57.88,Default,,0,0,0,,Жеңімпаз Сторм Спригган болды.
Dialogue: 0,0:18:58.01,0:18:59.80,Default,,0,0,0,,Йонекома аудандық турнирінің жеңімпазы
Dialogue: 0,0:18:59.88,0:19:01.30,Default,,0,0,0,,Бенишу
Dialogue: 0,0:19:01.39,0:19:03.80,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:19:05.51,0:19:06.85,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:19:06.93,0:19:10.02,Default,,0,0,0,,Уф... Уф... Уф...
Dialogue: 0,0:19:10.10,0:19:11.56,Default,,0,0,0,,Мен жеңілдім~
Dialogue: 0,0:19:12.56,0:19:15.94,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:16.15,0:19:18.11,Default,,0,0,0,,Тұр, Балто.
Dialogue: 0,0:19:18.78,0:19:21.11,Default,,0,0,0,,Сенің жүзіңді бәрі көргісі келеді
Dialogue: 0,0:19:21.20,0:19:21.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:25.24,0:19:27.41,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:27.49,0:19:30.08,Default,,0,0,0,,Балто!
Dialogue: 0,0:19:31.75,0:19:32.92,Default,,0,0,0,,Бал аға
Dialogue: 0,0:19:33.00,0:19:34.38,Default,,0,0,0,,Бұл тамаша болды
Dialogue: 0,0:19:34.46,0:19:36.50,Default,,0,0,0,,Эй, Балто, сен керемет жұмыс жасадың.
Dialogue: 0,0:19:36.59,0:19:38.05,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:19:39.46,0:19:40.63,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:19:41.55,0:19:44.22,Default,,0,0,0,,Мен ең жақсы симфонияны естідім.
Dialogue: 0,0:19:44.55,0:19:45.76,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:19:46.01,0:19:47.56,Default,,0,0,0,,Осындай шайқас
Dialogue: 0,0:19:47.64,0:19:49.02,Default,,0,0,0,,Егер мен...
Dialogue: 0,0:19:49.10,0:19:51.35,Default,,0,0,0,,Жарайсыңдар, назар аударыңдар!
Dialogue: 0,0:19:51.44,0:19:54.10,Default,,0,0,0,,Бұл Куришу, жеңімпаз.
Dialogue: 0,0:19:54.40,0:19:57.32,Default,,0,0,0,,Бұл тарихта қалатын ұлы шайқас болды.
Dialogue: 0,0:19:57.52,0:19:59.53,Default,,0,0,0,,сөзсіз Лорд Дэмиан болары анық.
Dialogue: 0,0:19:59.61,0:20:01.82,Default,,0,0,0,,Мен шынымен жеңе алатынымды білмедім.
Dialogue: 0,0:20:01.95,0:20:04.41,Default,,0,0,0,,Бірақ мен жеңгеніме өте қуаныштымын.
Dialogue: 0,0:20:04.62,0:20:06.70,Default,,0,0,0,,Құттықтаймыз Шу-кун
Dialogue: 0,0:20:06.78,0:20:07.91,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:20:08.12,0:20:09.79,Default,,0,0,0,,Финалға шолу
Dialogue: 0,0:20:09.87,0:20:12.16,Default,,0,0,0,,Маған қазір өзіңізді қалай сезінетініңізді айта аласыз ба?
Dialogue: 0,0:20:12.79,0:20:15.29,Default,,0,0,0,,Бұл үлкен шайқас болды.
Dialogue: 0,0:20:15.54,0:20:17.50,Default,,0,0,0,,Балто мен Валькириге рахмет
Dialogue: 0,0:20:17.59,0:20:19.25,Default,,0,0,0,,Хехе...
Dialogue: 0,0:20:19.34,0:20:20.92,Default,,0,0,0,,Және Барто Аои
Dialogue: 0,0:20:21.01,0:20:22.09,Default,,0,0,0,,А...
Dialogue: 0,0:20:22.22,0:20:24.51,Default,,0,0,0,,Қазір қандай сезімде екеніңізді айтыңыз.
Dialogue: 0,0:20:24.59,0:20:27.76,Default,,0,0,0,,А... мен? Ал...
Dialogue: 0,0:20:28.06,0:20:29.89,Default,,0,0,0,,Бірінші рет шыққанда екінші орын
Dialogue: 0,0:20:30.02,0:20:31.56,Default,,0,0,0,,Шынымен де ғажайып бала
Dialogue: 0,0:20:31.64,0:20:33.60,Default,,0,0,0,,Енді өзіңізді қалай сезінетініңізді айтыңыз.
Dialogue: 0,0:20:33.69,0:20:35.60,Default,,0,0,0,,Ах... о... мен
Dialogue: 0,0:20:35.69,0:20:36.86,Default,,0,0,0,,Бірдеңе айт!
Dialogue: 0,0:20:36.94,0:20:38.27,Default,,0,0,0,,Дұрыс сөйле
Dialogue: 0,0:20:38.36,0:20:39.48,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:20:40.19,0:20:42.32,Default,,0,0,0,,Бұл шынымен тітіркендіргіш
Dialogue: 0,0:20:42.40,0:20:45.49,Default,,0,0,0,,Бірақ мен осы уақытқа дейін барлық достарымның арқасында келдім.
Dialogue: 0,0:20:45.82,0:20:48.58,Default,,0,0,0,,Ум, Дина Инуске
Dialogue: 0,0:20:48.66,0:20:51.66,Default,,0,0,0,,Сосын уф уф
Dialogue: 0,0:20:52.45,0:20:53.54,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:20:53.75,0:20:55.37,Default,,0,0,0,,Гүлп Мен ше?
Dialogue: 0,0:20:55.46,0:20:57.83,Default,,0,0,0,,Осы Кумичоны ұмытпа!
Dialogue: 0,0:21:00.05,0:21:01.26,Default,,0,0,0,,Ана
Dialogue: 0,0:21:01.46,0:21:02.80,Default,,0,0,0,,Сен маған бұны бердің.
Dialogue: 0,0:21:02.88,0:21:04.88,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:21:04.97,0:21:06.80,Default,,0,0,0,,Жылама, Барто
Dialogue: 0,0:21:07.34,0:21:09.35,Default,,0,0,0,,Бұл осымен бітпейді.
Dialogue: 0,0:21:09.43,0:21:10.97,Default,,0,0,0,,Осы жерден басталады, солай ма?
Dialogue: 0,0:21:11.64,0:21:12.72,Default,,0,0,0,,Ана
Dialogue: 0,0:21:13.02,0:21:15.39,Default,,0,0,0,,Мен шаршадым~
Dialogue: 0,0:21:15.48,0:21:18.90,Default,,0,0,0,,Анамның тоқаштарын жеп қой~
Dialogue: 0,0:21:18.98,0:21:23.03,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:21:23.24,0:21:25.32,Default,,0,0,0,,Екеуінен де жақсы жекпе-жек!
Dialogue: 0,0:21:25.53,0:21:27.74,Default,,0,0,0,,Біз ең жақсы шайқасты көрдік.
Dialogue: 0,0:21:30.95,0:21:31.70,Default,,0,0,0,,Шу
Dialogue: 0,0:21:32.08,0:21:33.91,Default,,0,0,0,,Ұлттық конгрессте кездескенше
Dialogue: 0,0:21:34.00,0:21:34.79,Default,,0,0,0,,О
Dialogue: 0,0:21:37.04,0:21:37.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:38.25,0:21:38.92,Default,,0,0,0,,Шу!
Dialogue: 0,0:21:39.50,0:21:42.17,Default,,0,0,0,,Маған осылай ұйықтауға рұқсат етіңіз.
Dialogue: 0,0:21:43.13,0:21:45.38,Default,,0,0,0,,Сіз осы уақытқа дейін шыдадыңыз.
Dialogue: 0,0:21:45.47,0:21:46.93,Default,,0,0,0,,Жақсы ұйықтаңыз
Dialogue: 0,0:21:47.01,0:21:48.39,Default,,0,0,0,,Әкем мені құтқарды.
Dialogue: 0,0:21:49.64,0:21:50.93,Default,,0,0,0,,Шу…
Dialogue: 0,0:22:09.16,0:22:15.25,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.45,0:22:21.59,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:22.04,0:22:27.59,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.05,0:22:31.39,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.55,0:22:36.48,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.39,0:22:41.10,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.19,0:22:44.40,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.48,0:22:50.82,Default,,0,0,0,,Артынан қуып барсаң, көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.07,0:22:56.62,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.79,0:23:03.38,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.96,0:23:09.38,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.55,0:23:12.72,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.22,0:23:17.18,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.27,0:23:29.03,Default,,0,0,0,,Шақа, сен бізді қайда апарасың?
Dialogue: 0,0:23:29.11,0:23:31.03,Default,,0,0,0,,Жанып тұрған Доджо храмы?
Dialogue: 0,0:23:31.20,0:23:32.57,Default,,0,0,0,,Қылыш оттары?
Dialogue: 0,0:23:32.82,0:23:35.24,Default,,0,0,0,,Менің достарым да керемет жігіттер.
Dialogue: 0,0:23:35.45,0:23:37.49,Default,,0,0,0,,Ал бұл қандай стадион?
Dialogue: 0,0:23:37.58,0:23:39.29,Default,,0,0,0,,Мен мұндайды бірінші рет көріп тұрмын.
Dialogue: 0,0:23:39.45,0:23:40.71,Default,,0,0,0,,Жаса, істе
Dialogue: 0,0:23:41.08,0:23:42.92,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.17,0:23:45.04,Default,,0,0,0,,Таң қалдырыңыз! Арнайы жанып жатқан храм!
Dialogue: 0,0:23:45.29,0:23:47.05,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.50,0:23:49.30,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.80,0:23:56.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory