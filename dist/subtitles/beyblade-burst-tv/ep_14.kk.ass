Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.21,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.30,0:00:12.67,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.93,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.01,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.90,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:36.20,0:00:37.74,Default,,0,0,0,,Енді аяқталды!
Dialogue: 0,0:00:37.95,0:00:39.03,Default,,0,0,0,,Шешіңіз!
Dialogue: 0,0:00:43.58,0:00:45.54,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:00:46.33,0:00:48.25,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:48.75,0:00:49.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:52.46,0:00:54.30,Default,,0,0,0,,Ba Burst
Dialogue: 0,0:00:54.38,0:00:56.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:57.05,0:00:59.93,Default,,0,0,0,,Шу жартылай финалда Ginblade Orochi командасын жеңді.
Dialogue: 0,0:01:00.51,0:01:03.43,Default,,0,0,0,,Сіз маған уәде еткендей финалға өттіңіз.
Dialogue: 0,0:01:03.81,0:01:04.81,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:01:05.52,0:01:08.15,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, оның жазылуына көп уақыт қажет болады.
Dialogue: 0,0:01:08.56,0:01:11.32,Default,,0,0,0,,Бейблейдтерге иығыңыз үшін тыйым салынған.
Dialogue: 0,0:01:11.98,0:01:14.36,Default,,0,0,0,,Мен тек финалда ойнағым келеді.
Dialogue: 0,0:01:14.74,0:01:17.07,Default,,0,0,0,,Бұл доспен уәде.
Dialogue: 0,0:01:17.82,0:01:19.45,Default,,0,0,0,,Шудың жарақаты…
Dialogue: 0,0:01:19.53,0:01:21.87,Default,,0,0,0,,Барған сайын нашарлай берді...
Dialogue: 0,0:01:29.79,0:01:32.17,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:32.50,0:01:37.68,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:48.98,0:01:52.36,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:52.86,0:01:54.98,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:55.40,0:01:59.53,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:59.66,0:02:02.87,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:02.99,0:02:09.41,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:09.71,0:02:14.38,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:14.63,0:02:20.05,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:20.18,0:02:22.43,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:22.51,0:02:27.23,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:27.39,0:02:32.48,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:32.77,0:02:35.02,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:35.23,0:02:37.57,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:37.86,0:02:41.78,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:41.95,0:02:46.95,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:47.16,0:02:49.33,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:53.50,0:02:55.38,Default,,0,0,0,,Ант берудің соңғы кездесуі!
Dialogue: 0,0:02:58.01,0:02:59.47,Default,,0,0,0,,Қалағаныңды істе!
Dialogue: 0,0:02:59.80,0:03:00.76,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:03:00.84,0:03:02.05,Default,,0,0,0,,Содан кейін Барт
Dialogue: 0,0:03:02.14,0:03:03.85,Default,,0,0,0,,Мен сенімен біттім.
Dialogue: 0,0:03:03.97,0:03:05.68,Default,,0,0,0,,Біз дос емеспіз немесе ештеңе емеспіз.
Dialogue: 0,0:03:05.89,0:03:06.81,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:03:06.89,0:03:07.64,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:03:07.81,0:03:10.02,Default,,0,0,0,,Сіз «иә» деп айтқанша
Dialogue: 0,0:03:10.10,0:03:11.85,Default,,0,0,0,,Мен ешқашан үйге бармаймын
Dialogue: 0,0:03:11.98,0:03:13.02,Default,,0,0,0,,Балто!
Dialogue: 0,0:03:16.32,0:03:19.44,Default,,0,0,0,,Куришуу-кун Аои Балт-кун
Dialogue: 0,0:03:19.53,0:03:21.61,Default,,0,0,0,,Екеуіңізге де көп рахмет.
Dialogue: 0,0:03:22.03,0:03:24.87,Default,,0,0,0,,Біздің мектептен Бейблейд облыстық турнирінің финалына дейін.
Dialogue: 0,0:03:24.95,0:03:26.99,Default,,0,0,0,,Екі адам қатысуға шешім қабылдады
Dialogue: 0,0:03:27.29,0:03:29.87,Default,,0,0,0,,Мен де өте қуаныштымын.
Dialogue: 0,0:03:29.95,0:03:31.12,Default,,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,0:03:31.21,0:03:32.46,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:33.08,0:03:35.46,Default,,0,0,0,,Ол мектептегі тікелей эфирде көрсетілуде.
Dialogue: 0,0:03:35.54,0:03:37.21,Default,,0,0,0,,Екеуі қол алысады!
Dialogue: 0,0:03:45.93,0:03:47.93,Default,,0,0,0,,Балто ақыры финалға шықты ма?
Dialogue: 0,0:03:48.26,0:03:50.43,Default,,0,0,0,,Мен баруым керек еді.
Dialogue: 0,0:03:50.68,0:03:52.19,Default,,0,0,0,,Бұл көңілсіз, солай емес пе?
Dialogue: 0,0:03:52.64,0:03:54.40,Default,,0,0,0,,Барлығы бірдей сезінеді
Dialogue: 0,0:03:54.73,0:03:57.36,Default,,0,0,0,,Бірақ мен өзімді бақытты сезінемін.
Dialogue: 0,0:03:57.48,0:03:58.36,Default,,0,0,0,,Мен де!
Dialogue: 0,0:03:58.65,0:04:00.32,Default,,0,0,0,,Мен ол болғанына қуаныштымын
Dialogue: 0,0:04:00.49,0:04:02.86,Default,,0,0,0,,Ол біртүрлі жігіт, Балто.
Dialogue: 0,0:04:02.95,0:04:05.62,Default,,0,0,0,,Шу-кун өте керемет~
Dialogue: 0,0:04:06.28,0:04:08.74,Default,,0,0,0,,Бал-нии, басқасы бар емес пе?
Dialogue: 0,0:04:08.83,0:04:11.41,Default,,0,0,0,,Мен әдетте көбірек көңілді және ойнақымын.
Dialogue: 0,0:04:11.96,0:04:12.83,Default,,0,0,0,,Хмм?
Dialogue: 0,0:04:15.29,0:04:17.54,Default,,0,0,0,,Иә! Трансляция аяқталды!
Dialogue: 0,0:04:17.67,0:04:19.55,Default,,0,0,0,,Ынтымақтастық үшін рахмет
Dialogue: 0,0:04:20.42,0:04:23.34,Default,,0,0,0,,Екеуің қатты күресіңдер.
Dialogue: 0,0:04:23.55,0:04:24.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:24.97,0:04:26.22,Default,,0,0,0,,Ах
Dialogue: 0,0:04:27.35,0:04:29.72,Default,,0,0,0,,Сіз не істеп жатырсыз? Барайық.
Dialogue: 0,0:04:29.81,0:04:31.10,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:04:31.18,0:04:33.18,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:33.27,0:04:35.02,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:35.10,0:04:36.06,Default,,0,0,0,,Сәлем! Балтық
Dialogue: 0,0:04:36.48,0:04:37.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:37.61,0:04:38.48,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:04:47.70,0:04:48.91,Default,,0,0,0,,Тағы кездескенше!
Dialogue: 0,0:04:56.25,0:04:59.88,Default,,0,0,0,,Не болды? Сіз қазірден бастап көп қателіктер жібердіңіз.
Dialogue: 0,0:05:00.04,0:05:01.09,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:05:01.17,0:05:02.63,Default,,0,0,0,,Өкінбе
Dialogue: 0,0:05:02.71,0:05:04.30,Default,,0,0,0,,Мотивацияңыз бар ма?
Dialogue: 0,0:05:05.30,0:05:06.59,Default,,0,0,0,,Сабыр ет, Кумичо.
Dialogue: 0,0:05:06.93,0:05:10.01,Default,,0,0,0,,Сондықтан финалда Шуды жеңе аласың ба?
Dialogue: 0,0:05:10.10,0:05:11.76,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:05:13.31,0:05:15.85,Default,,0,0,0,,Сіз бізді жеңдіңіз.
Dialogue: 0,0:05:15.94,0:05:18.48,Default,,0,0,0,,Сондықтан сіз біздің орнымызды басып отырсыз.
Dialogue: 0,0:05:18.56,0:05:21.02,Default,,0,0,0,,Бұл финалға қатысумен бірдей.
Dialogue: 0,0:05:21.86,0:05:22.82,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:05:22.90,0:05:25.36,Default,,0,0,0,,Егер сіз не істеп жатқаныңызды білсеңіз, оны дұрыс орындаңыз.
Dialogue: 0,0:05:25.45,0:05:28.16,Default,,0,0,0,,Балто, сен бірдеңені жасырып тұрсың.
Dialogue: 0,0:05:31.16,0:05:32.29,Default,,0,0,0,,Барт…
Dialogue: 0,0:05:33.12,0:05:35.20,Default,,0,0,0,,Біз кімбіз?
Dialogue: 0,0:05:36.96,0:05:38.29,Default,,0,0,0,,Біз кімбіз?
Dialogue: 0,0:05:38.67,0:05:39.83,Default,,0,0,0,,Балтоға жауап
Dialogue: 0,0:05:41.25,0:05:44.26,Default,,0,0,0,,Біз Бейблейд клубының мүшелеріміз.
Dialogue: 0,0:05:44.51,0:05:45.84,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:46.22,0:05:47.30,Default,,0,0,0,,Дина…
Dialogue: 0,0:05:47.59,0:05:49.72,Default,,0,0,0,,Егер сізді алаңдататын нәрсе болса
Dialogue: 0,0:05:49.89,0:05:51.68,Default,,0,0,0,,Кез келген нәрсе туралы сұраңыз
Dialogue: 0,0:05:51.80,0:05:52.97,Default,,0,0,0,,Иә
Dialogue: 0,0:05:53.06,0:05:53.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:54.02,0:05:55.22,Default,,0,0,0,,Сөйлеу
Dialogue: 0,0:05:55.31,0:05:56.77,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,0:06:03.19,0:06:06.24,Default,,0,0,0,,Мені байқамайсың, ақымақ көрінесің.
Dialogue: 0,0:06:08.32,0:06:11.78,Default,,0,0,0,,Шудың иығы әлі жазылмаған.
Dialogue: 0,0:06:12.45,0:06:14.87,Default,,0,0,0,,Бейблейдті пайдалана алмауым мүмкін.
Dialogue: 0,0:06:15.50,0:06:16.66,Default,,0,0,0,,Міне!
Dialogue: 0,0:06:16.75,0:06:17.91,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:06:18.00,0:06:20.88,Default,,0,0,0,,Ол өзін сонша итермеледі ме?
Dialogue: 0,0:06:21.50,0:06:23.67,Default,,0,0,0,,Жарайды, Шу данышпан.
Dialogue: 0,0:06:23.75,0:06:25.96,Default,,0,0,0,,Ол мені міндетті түрде емдейтінін айтты.
Dialogue: 0,0:06:26.05,0:06:27.88,Default,,0,0,0,,Жақсы болар еді...
Dialogue: 0,0:06:27.97,0:06:29.76,Default,,0,0,0,,Сіз тым оптимистсіз бе?
Dialogue: 0,0:06:29.84,0:06:31.72,Default,,0,0,0,,Бұл қысқа уақыт ішінде мүмкін емес.
Dialogue: 0,0:06:32.26,0:06:33.22,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:06:34.31,0:06:36.72,Default,,0,0,0,,Мен Шуумен төбелескім келеді
Dialogue: 0,0:06:36.81,0:06:40.48,Default,,0,0,0,,Бірақ Шу бейблейд жасай алмаса...
Dialogue: 0,0:06:44.69,0:06:45.94,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:06:46.15,0:06:48.69,Default,,0,0,0,,Қош келдіңіз, Балто, қарыныңыз ашты.
Dialogue: 0,0:06:49.03,0:06:51.70,Default,,0,0,0,,Үстелде нан бар.
Dialogue: 0,0:06:51.82,0:06:52.62,Default,,0,0,0,,Иә
Dialogue: 0,0:06:54.03,0:06:55.20,Default,,0,0,0,,Айтпақшы, сіз кімсіз өзі?
Dialogue: 0,0:06:55.28,0:06:56.66,Default,,0,0,0,,Қызу!
Dialogue: 0,0:06:56.74,0:07:01.00,Default,,0,0,0,,Әдетте қарным ашқанда ең бірінші тамақ ішемін.
Dialogue: 0,0:07:01.67,0:07:05.17,Default,,0,0,0,,Бәлкім, ағаң да қобалжыған шығар, өйткені финал жақын.
Dialogue: 0,0:07:05.55,0:07:08.13,Default,,0,0,0,,Қобалжыған шығарсың, Бал-нии.
Dialogue: 0,0:07:08.34,0:07:09.26,Default,,0,0,0,,(Бей дыбысы)
Dialogue: 0,0:07:09.34,0:07:11.13,Default,,0,0,0,,Ника жеңді!
Dialogue: 0,0:07:11.22,0:07:12.64,Default,,0,0,0,,Тағы бір рет
Dialogue: 0,0:07:12.72,0:07:15.26,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:15.35,0:07:16.72,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:16.81,0:07:18.43,Default,,0,0,0,,Жарайды, жүр!
Dialogue: 0,0:07:18.56,0:07:20.64,Default,,0,0,0,,Мұндай шабуыл жұмыс істемейді.
Dialogue: 0,0:07:21.14,0:07:23.15,Default,,0,0,0,,Жүр! Бар! Бар!
Dialogue: 0,0:07:24.23,0:07:27.07,Default,,0,0,0,,Балто мен де Бейді алдым.
Dialogue: 0,0:07:27.44,0:07:28.73,Default,,0,0,0,,Саябақта күту
Dialogue: 0,0:07:28.82,0:07:30.95,Default,,0,0,0,,Жарайды, бірден кетейік!
Dialogue: 0,0:07:32.07,0:07:35.24,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:07:37.58,0:07:40.08,Default,,0,0,0,,Ой және...
Dialogue: 0,0:07:40.16,0:07:41.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:41.21,0:07:43.58,Default,,0,0,0,,Уау (ер адам мен әйел) А, иә?
Dialogue: 0,0:07:43.79,0:07:45.71,Default,,0,0,0,,Шу~!
Dialogue: 0,0:07:45.79,0:07:47.88,Default,,0,0,0,,Ик!
Dialogue: 0,0:07:48.38,0:07:51.17,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:07:51.92,0:07:53.55,Default,,0,0,0,,Кеш болды, Балто.
Dialogue: 0,0:07:56.01,0:07:57.47,Default,,0,0,0,,Бұл менің шығанағым!
Dialogue: 0,0:07:57.60,0:07:58.56,Default,,0,0,0,,Спригган
Dialogue: 0,0:07:58.85,0:08:00.60,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:08:00.68,0:08:03.39,Default,,0,0,0,,Дегенмен, сіз менің Валькириімнен ұтасыз.
Dialogue: 0,0:08:03.81,0:08:05.35,Default,,0,0,0,,Бірінші Бейбат болды
Dialogue: 0,0:08:05.44,0:08:08.02,Default,,0,0,0,,Мен мұны әрқашан сенімен жасағым келді.
Dialogue: 0,0:08:08.48,0:08:09.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:09.36,0:08:10.03,Default,,0,0,0,,Иә
Dialogue: 0,0:08:10.49,0:08:13.45,Default,,0,0,0,,Жарайды, Бейбатл жасайық
Dialogue: 0,0:08:14.49,0:08:16.87,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:17.03,0:08:18.62,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:19.83,0:08:20.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:20.66,0:08:21.54,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:08:21.62,0:08:23.12,Default,,0,0,0,,Мен тағы да жеңдім.
Dialogue: 0,0:08:23.21,0:08:27.34,Default,,0,0,0,,Қарғыс атқыр... Менің жіберген қателігім менің іске қосқышымның қозғалуы болды.
Dialogue: 0,0:08:27.63,0:08:29.50,Default,,0,0,0,,Тағы бір рет Тағы бір шайқас
Dialogue: 0,0:08:29.96,0:08:32.72,Default,,0,0,0,,Мен шаршадым. Бір үзіліс жасайық.
Dialogue: 0,0:08:33.17,0:08:34.22,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:08:34.30,0:08:35.89,Default,,0,0,0,,Тағы бір шайқас, Балто.
Dialogue: 0,0:08:36.14,0:08:39.18,Default,,0,0,0,,Мен оны тез арада меңгеретін сияқтымын.
Dialogue: 0,0:08:39.47,0:08:41.68,Default,,0,0,0,,Жарайды, жарайды, жасайық!
Dialogue: 0,0:08:42.06,0:08:43.06,Default,,0,0,0,,Барт
Dialogue: 0,0:08:43.18,0:08:43.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.69,0:08:45.98,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:08:46.27,0:08:47.65,Default,,0,0,0,,Өте қызықты
Dialogue: 0,0:08:48.31,0:08:49.32,Default,,0,0,0,,О
Dialogue: 0,0:08:50.15,0:08:54.53,Default,,0,0,0,,Мен міндетті түрде осы Спригганға лайық жүзуші боламын.
Dialogue: 0,0:08:54.99,0:08:56.61,Default,,0,0,0,,Мүлдем күшейеді
Dialogue: 0,0:08:57.45,0:08:58.45,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:58.53,0:09:01.41,Default,,0,0,0,,Шу мені әп-сәтте басып озды.
Dialogue: 0,0:09:01.49,0:09:04.04,Default,,0,0,0,,Соңғы облыстық турнирге қатысты
Dialogue: 0,0:09:04.29,0:09:06.29,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:08.63,0:09:10.38,Default,,0,0,0,,Бұны жеңсек, бүкіл елді жеңеміз.
Dialogue: 0,0:09:10.46,0:09:11.67,Default,,0,0,0,,Өте керемет!
Dialogue: 0,0:09:11.75,0:09:14.84,Default,,0,0,0,,Шуу сияқты адамдарды данышпан деп атайды.
Dialogue: 0,0:09:15.55,0:09:17.34,Default,,0,0,0,,Шуу-кун, барыңды істе!
Dialogue: 0,0:09:17.43,0:09:19.01,Default,,0,0,0,,Сәттілік! Шуу!
Dialogue: 0,0:09:19.43,0:09:23.60,Default,,0,0,0,,Енді финал - Куришуу мен Комурасаки Вакия арасындағы кездесу.
Dialogue: 0,0:09:23.68,0:09:26.56,Default,,0,0,0,,Спригган мен Вайверн соқтығысады!
Dialogue: 0,0:09:26.64,0:09:28.23,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:09:28.44,0:09:31.36,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:31.61,0:09:33.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:36.45,0:09:37.86,Default,,0,0,0,,Жүр! Спригган!
Dialogue: 0,0:09:38.20,0:09:40.12,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:09:40.24,0:09:43.20,Default,,0,0,0,,Спригганның қиян-кескі шабуылы
Dialogue: 0,0:09:43.45,0:09:45.58,Default,,0,0,0,,Виверннің қорғанысын елемеу
Dialogue: 0,0:09:45.66,0:09:47.25,Default,,0,0,0,,Мейірімсіз шабуыл
Dialogue: 0,0:09:48.42,0:09:50.13,Default,,0,0,0,,Қызық! Вайверн!
Dialogue: 0,0:09:50.21,0:09:51.75,Default,,0,0,0,,Шешіңіз! Спригган!
Dialogue: 0,0:09:53.17,0:09:54.76,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:09:55.42,0:09:56.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:57.05,0:09:59.43,Default,,0,0,0,,Уайверн жарылды!
Dialogue: 0,0:10:01.43,0:10:04.64,Default,,0,0,0,,Сол сәттен бастап Шу менің мақсатыма айналды.
Dialogue: 0,0:10:06.10,0:10:09.27,Default,,0,0,0,,Ақыры Шуды қуып жеттім.
Dialogue: 0,0:10:14.44,0:10:16.28,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:10:17.49,0:10:19.07,Default,,0,0,0,,Бұл кенеттен не болды?
Dialogue: 0,0:10:19.45,0:10:20.53,Default,,0,0,0,,Шу…
Dialogue: 0,0:10:21.45,0:10:23.87,Default,,0,0,0,,Келесі матчтан бас тартыңыз.
Dialogue: 0,0:10:24.45,0:10:25.29,Default,,0,0,0,,Не?
Dialogue: 0,0:10:25.54,0:10:28.08,Default,,0,0,0,,Сіздің иықтарыңыз шегінде, солай ма?
Dialogue: 0,0:10:28.16,0:10:29.83,Default,,0,0,0,,Егер жағдай нашарласа ше?
Dialogue: 0,0:10:29.92,0:10:32.13,Default,,0,0,0,,Бей мұны істей алмауы мүмкін.
Dialogue: 0,0:10:32.63,0:10:33.67,Default,,0,0,0,,Барт
Dialogue: 0,0:10:34.21,0:10:36.51,Default,,0,0,0,,Мен өзімді жақсы білемін
Dialogue: 0,0:10:36.76,0:10:37.92,Default,,0,0,0,,Болжам жасамаңыз
Dialogue: 0,0:10:39.13,0:10:40.93,Default,,0,0,0,,Егер қалыс қалмасаңыз...
Dialogue: 0,0:10:41.22,0:10:42.47,Default,,0,0,0,,Мен қалыс қалдым
Dialogue: 0,0:10:43.60,0:10:44.89,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:10:45.93,0:10:47.43,Default,,0,0,0,,Қалыс қалу!
Dialogue: 0,0:10:47.56,0:10:48.68,Default,,0,0,0,,Қалағаныңды істе!
Dialogue: 0,0:10:48.89,0:10:49.77,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:10:49.85,0:10:51.06,Default,,0,0,0,,Содан кейін Барто...
Dialogue: 0,0:10:51.15,0:10:52.94,Default,,0,0,0,,Мен сенімен біттім.
Dialogue: 0,0:10:53.02,0:10:54.77,Default,,0,0,0,,Біз дос емеспіз.
Dialogue: 0,0:10:54.98,0:10:55.90,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:10:55.98,0:10:56.82,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:10:56.90,0:10:59.03,Default,,0,0,0,,Сіз «иә» деп айтқанша
Dialogue: 0,0:10:59.11,0:11:01.20,Default,,0,0,0,,Мен ешқашан оралмаймын
Dialogue: 0,0:11:01.28,0:11:02.03,Default,,0,0,0,,Балто!
Dialogue: 0,0:11:02.41,0:11:03.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:05.58,0:11:06.58,Default,,0,0,0,,Шу
Dialogue: 0,0:11:08.87,0:11:10.00,Default,,0,0,0,,Үйге қайт
Dialogue: 0,0:11:10.25,0:11:11.25,Default,,0,0,0,,Шу
Dialogue: 0,0:11:12.50,0:11:14.00,Default,,0,0,0,,Шу
Dialogue: 0,0:11:14.21,0:11:15.34,Default,,0,0,0,,Мен
Dialogue: 0,0:11:15.63,0:11:18.71,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:11:20.88,0:11:21.88,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:11:21.97,0:11:23.97,Default,,0,0,0,,(есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:11:27.35,0:11:28.85,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:11:29.23,0:11:30.68,Default,,0,0,0,,Бұл менің бірінші шайқасым болды.
Dialogue: 0,0:11:31.69,0:11:32.52,Default,,0,0,0,,Иә
Dialogue: 0,0:11:32.94,0:11:34.40,Default,,0,0,0,,Сол кезде мен...
Dialogue: 0,0:11:34.77,0:11:36.57,Default,,0,0,0,,Мен сені мүлде жеңе алмадым
Dialogue: 0,0:11:37.02,0:11:37.86,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:38.23,0:11:39.78,Default,,0,0,0,,Бұл өте қызық
Dialogue: 0,0:11:39.90,0:11:42.28,Default,,0,0,0,,Мен Бейблейдке қатты ғашық болдым.
Dialogue: 0,0:11:42.36,0:11:43.36,Default,,0,0,0,,Ал мен...
Dialogue: 0,0:11:43.45,0:11:45.62,Default,,0,0,0,,Мен күштірек болғым келді.
Dialogue: 0,0:11:47.62,0:11:50.33,Default,,0,0,0,,Сондықтан мен шамам келгенше жаттығу жасадым.
Dialogue: 0,0:11:52.83,0:11:54.08,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:11:54.79,0:11:56.04,Default,,0,0,0,,Мұқият қараңдар.
Dialogue: 0,0:11:56.38,0:11:58.30,Default,,0,0,0,,Шу, тоқтат.
Dialogue: 0,0:11:58.38,0:11:59.84,Default,,0,0,0,,Бұл енді менмін!
Dialogue: 0,0:12:03.13,0:12:04.84,Default,,0,0,0,,Жүр! Спригган!
Dialogue: 0,0:12:07.39,0:12:09.43,Default,,0,0,0,,Көбірек, көбірек!
Dialogue: 0,0:12:12.98,0:12:15.10,Default,,0,0,0,,Қуат одан да жоғары
Dialogue: 0,0:12:18.48,0:12:20.32,Default,,0,0,0,,Импульс мүлде төмендемейді
Dialogue: 0,0:12:20.44,0:12:22.03,Default,,0,0,0,,Бұл қандай қозғалыс?
Dialogue: 0,0:12:22.36,0:12:24.36,Default,,0,0,0,,Ғажайып Спригган
Dialogue: 0,0:12:27.99,0:12:30.66,Default,,0,0,0,,Мен әрқашан сенімен күресуге келдім.
Dialogue: 0,0:12:31.20,0:12:33.29,Default,,0,0,0,,Саған берген уәдемді орындау үшін
Dialogue: 0,0:12:33.71,0:12:35.54,Default,,0,0,0,,Менімен күрес! Балтық!
Dialogue: 0,0:12:35.92,0:12:37.84,Default,,0,0,0,,Түсіндім, Шу.
Dialogue: 0,0:12:38.17,0:12:40.42,Default,,0,0,0,,Бар күшіммен күресемін
Dialogue: 0,0:12:43.34,0:12:45.43,Default,,0,0,0,,Менің қарным ашты~
Dialogue: 0,0:12:45.89,0:12:48.72,Default,,0,0,0,,Қараңызшы, Балтоның сүйікті ет тоқашы
Dialogue: 0,0:12:48.85,0:12:50.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:51.52,0:12:54.81,Default,,0,0,0,,Үйге аш келерсің деп ойлап, мен саған біраз жасап бердім.
Dialogue: 0,0:12:55.02,0:12:56.23,Default,,0,0,0,,Уме!
Dialogue: 0,0:12:56.31,0:12:59.19,Default,,0,0,0,,Анамның наны ең жақсы ғой.
Dialogue: 0,0:12:59.36,0:13:01.40,Default,,0,0,0,,Балто Сіз жылап жатырсыз ба?
Dialogue: 0,0:13:01.48,0:13:05.07,Default,,0,0,0,,Өте жақсы, көзімнен тер шықты~
Dialogue: 0,0:13:05.45,0:13:07.62,Default,,0,0,0,,Әй, көзіңдегі терді сүрт.
Dialogue: 0,0:13:12.66,0:13:13.87,Default,,0,0,0,,Анашым...
Dialogue: 0,0:13:14.33,0:13:16.29,Default,,0,0,0,,Финалға өтуіңізбен құттықтаймыз
Dialogue: 0,0:13:16.75,0:13:18.29,Default,,0,0,0,,Бұл Баймисанга
Dialogue: 0,0:13:18.50,0:13:20.34,Default,,0,0,0,,Анамның сыйлығы
Dialogue: 0,0:13:20.42,0:13:22.71,Default,,0,0,0,,Балтоның тілегі орындалсын
Dialogue: 0,0:13:23.59,0:13:25.01,Default,,0,0,0,,Ана
Dialogue: 0,0:13:29.01,0:13:30.97,Default,,0,0,0,,Тіл тістеу~
Dialogue: 0,0:13:31.06,0:13:34.48,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:34.60,0:13:36.69,Default,,0,0,0,,Балто күшейе түсті
Dialogue: 0,0:13:36.77,0:13:38.52,Default,,0,0,0,,Мен сенің күшті болатыныңа сенімдімін
Dialogue: 0,0:13:38.60,0:13:39.77,Default,,0,0,0,,Бірақ мен де-
Dialogue: 0,0:13:39.86,0:13:41.32,Default,,0,0,0,,Күшті болыңыз
Dialogue: 0,0:13:42.69,0:13:45.19,Default,,0,0,0,,Мен мұндай жерде ешқашан құламас едім.
Dialogue: 0,0:13:46.07,0:13:48.36,Default,,0,0,0,,Спригган! Финалға өтуіңізді сұраймын!
Dialogue: 0,0:13:51.12,0:13:53.24,Default,,0,0,0,,Шу – данышпан.
Dialogue: 0,0:13:53.79,0:13:55.87,Default,,0,0,0,,Тіпті жарақаттар да күшке айналады
Dialogue: 0,0:13:56.33,0:13:57.33,Default,,0,0,0,,Мен жеңгім келеді
Dialogue: 0,0:13:57.62,0:14:00.83,Default,,0,0,0,,Шу, Валькирияны жеңгім келеді.
Dialogue: 0,0:14:02.55,0:14:04.92,Default,,0,0,0,,Жарайды! ұлдар мен қыздар
Dialogue: 0,0:14:05.01,0:14:08.01,Default,,0,0,0,,Аймақтық турнирдің финалдық күні де жетті!
Dialogue: 0,0:14:08.09,0:14:10.93,Default,,0,0,0,,Барлығына! Толқып, қобалжымайсыз ба?
Dialogue: 0,0:14:11.05,0:14:12.64,Default,,0,0,0,,Анами қатты толқыды!
Dialogue: 0,0:14:14.64,0:14:16.27,Default,,0,0,0,,Токонацу күтіңіз~
Dialogue: 0,0:14:16.35,0:14:19.77,Default,,0,0,0,,Тезірек, Никабар-ниидің кездесуі басталғалы жатыр~
Dialogue: 0,0:14:19.85,0:14:21.48,Default,,0,0,0,,Күтіңіз~
Dialogue: 0,0:14:22.61,0:14:23.61,Default,,0,0,0,,Ах~
Dialogue: 0,0:14:23.98,0:14:24.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:28.07,0:14:31.03,Default,,0,0,0,,Амансың ба? Бұл қауіпті болды
Dialogue: 0,0:14:34.03,0:14:35.54,Default,,0,0,0,,Бұл мен Шака~
Dialogue: 0,0:14:35.62,0:14:37.16,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:14:37.25,0:14:38.37,Default,,0,0,0,,Шака?
Dialogue: 0,0:14:38.71,0:14:42.00,Default,,0,0,0,,Сен әлі жас едің, мені есіңе түсірмейсің бе?
Dialogue: 0,0:14:42.84,0:14:43.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:44.00,0:14:45.21,Default,,0,0,0,,Шака!
Dialogue: 0,0:14:46.88,0:14:49.17,Default,,0,0,0,,Мені еске алғаныңызға рахмет.
Dialogue: 0,0:14:50.55,0:14:52.55,Default,,0,0,0,,
Dialogue: 0,0:14:53.68,0:14:54.93,Default,,0,0,0,,Ол...
Dialogue: 0,0:14:55.14,0:14:57.64,Default,,0,0,0,,Өткен жылғы ұлттық турнирдің үздік 4-і
Dialogue: 0,0:14:57.73,0:15:00.64,Default,,0,0,0,,Трансформацияланған төрт императордың бірі Кайза жанып тұрған храм.
Dialogue: 0,0:15:01.48,0:15:03.40,Default,,0,0,0,,Оны Шака деп атайды.
Dialogue: 0,0:15:03.48,0:15:04.90,Default,,0,0,0,,Неліктен ол
Dialogue: 0,0:15:04.98,0:15:07.07,Default,,0,0,0,,Токонацу Никамен бірге ме?
Dialogue: 0,0:15:07.48,0:15:10.61,Default,,0,0,0,,Эй, Шу, мен финалды ойнаймыз деп ойладым.
Dialogue: 0,0:15:10.70,0:15:13.03,Default,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:15:13.12,0:15:13.91,Default,,0,0,0,,О
Dialogue: 0,0:15:13.99,0:15:15.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:16.74,0:15:18.37,Default,,0,0,0,,Ей, екеуің.
Dialogue: 0,0:15:18.45,0:15:19.66,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:15:20.21,0:15:21.54,Default,,0,0,0,,Шака
Dialogue: 0,0:15:21.62,0:15:23.67,Default,,0,0,0,,Екі адам соқтығысады дегенді естігенде
Dialogue: 0,0:15:23.75,0:15:25.21,Default,,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:15:25.29,0:15:27.21,Default,,0,0,0,,Мына матчты көрсетейін.
Dialogue: 0,0:15:27.38,0:15:29.01,Default,,0,0,0,,Келгеніңізге қуаныштымын.
Dialogue: 0,0:15:29.34,0:15:30.17,Default,,0,0,0,,О!
Dialogue: 0,0:15:31.26,0:15:32.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:32.89,0:15:34.72,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,0:15:35.05,0:15:36.51,Default,,0,0,0,,Бару~
Dialogue: 0,0:15:36.60,0:15:38.39,Default,,0,0,0,,Бұл өте күшті!
Dialogue: 0,0:15:40.43,0:15:43.85,Default,,0,0,0,,Финал Мен ең жақсы шайқасты күтемін.
Dialogue: 0,0:15:43.94,0:15:45.90,Default,,0,0,0,,О, оны маған қалдырыңыз.
Dialogue: 0,0:15:45.98,0:15:48.40,Default,,0,0,0,,Мен бар күшімді саламын. Эй, Шу.
Dialogue: 0,0:15:48.78,0:15:49.57,Default,,0,0,0,,О
Dialogue: 0,0:15:51.74,0:15:52.57,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:53.82,0:15:54.99,Default,,0,0,0,,Бала күнгі досым?
Dialogue: 0,0:15:55.53,0:15:57.70,Default,,0,0,0,,Балабақшада бірге болдық.
Dialogue: 0,0:15:57.87,0:15:59.20,Default,,0,0,0,,Шу-кун да.
Dialogue: 0,0:15:59.41,0:16:01.62,Default,,0,0,0,,Танысқанымызға көп уақыт болды.
Dialogue: 0,0:16:01.71,0:16:03.42,Default,,0,0,0,,Ол үлкейе бастады.
Dialogue: 0,0:16:03.62,0:16:05.79,Default,,0,0,0,,Барттың достары көп.
Dialogue: 0,0:16:05.96,0:16:08.46,Default,,0,0,0,,Бұл менің ағамның мамандығы.
Dialogue: 0,0:16:08.55,0:16:09.59,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:16:10.05,0:16:11.88,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:16:16.68,0:16:19.43,Default,,0,0,0,,Жарайды! ұлдар мен қыздар
Dialogue: 0,0:16:19.52,0:16:21.18,Default,,0,0,0,,Йонекома ауданының алдын ала турнирі
Dialogue: 0,0:16:21.27,0:16:23.14,Default,,0,0,0,,Соңғы шайқас басталады!
Dialogue: 0,0:16:23.56,0:16:26.69,Default,,0,0,0,,Финалистер – осы екеуі!
Dialogue: 0,0:16:27.02,0:16:29.73,Default,,0,0,0,,Бірінші жүзгіш Балто Аои болды.
Dialogue: 0,0:16:29.82,0:16:32.24,Default,,0,0,0,,Пайдаланылған шығанақ - Жеңіс Валькири
Dialogue: 0,0:16:32.32,0:16:35.32,Default,,0,0,0,,Мен осыншама із қалдырмай келдім.
Dialogue: 0,0:16:35.41,0:16:37.66,Default,,0,0,0,,Мен мұны енді ғажайып деп айтпаймын!
Dialogue: 0,0:16:37.87,0:16:39.49,Default,,0,0,0,,Бал-нии! Аға
Dialogue: 0,0:16:39.58,0:16:41.25,Default,,0,0,0,,Сәттілік! Балтық!
Dialogue: 0,0:16:41.33,0:16:44.21,Default,,0,0,0,,Ал ең күшті жүзік Куришуу
Dialogue: 0,0:16:44.29,0:16:47.00,Default,,0,0,0,,Пайдалану алаңы, әрине, Спригган дауылы
Dialogue: 0,0:16:47.08,0:16:49.50,Default,,0,0,0,,Өйткені, біз осы уақытқа дейін жеттік.
Dialogue: 0,0:16:49.59,0:16:52.67,Default,,0,0,0,,Бей құдайы жақсы көретін періште бала!
Dialogue: 0,0:16:52.76,0:16:54.88,Default,,0,0,0,,(Қыздар қолдайды)
Dialogue: 0,0:16:54.97,0:16:57.55,Default,,0,0,0,,Шу бұрынғыдай танымал.
Dialogue: 0,0:16:57.64,0:16:59.05,Default,,0,0,0,,Гах ха ха ха
Dialogue: 0,0:16:59.68,0:17:03.48,Default,,0,0,0,,Келіңдер~ Мына екеуін айқайлап, шапалақтап жіберіңдер~
Dialogue: 0,0:17:06.69,0:17:07.77,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:07.85,0:17:10.82,Default,,0,0,0,,Мен сонда болуым керек еді.
Dialogue: 0,0:17:10.94,0:17:12.44,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,0:17:12.57,0:17:15.32,Default,,0,0,0,,Бірақ бүгін мен Балтоға құмармын.
Dialogue: 0,0:17:15.40,0:17:17.61,Default,,0,0,0,,Мен міндетті түрде келесідей боламын
Dialogue: 0,0:17:21.20,0:17:23.45,Default,,0,0,0,,Сіз қанша қашықтыққа барасыз?
Dialogue: 0,0:17:23.54,0:17:26.42,Default,,0,0,0,,Мен сені қадағалаймын, Балто
Dialogue: 0,0:17:28.58,0:17:31.38,Default,,0,0,0,,Финал 3 балдық жүйе бойынша өтеді.
Dialogue: 0,0:17:31.63,0:17:35.26,Default,,0,0,0,,Айналдыру аяқталуы - 1 ұпай
Dialogue: 0,0:17:35.38,0:17:37.47,Default,,0,0,0,,Жедел мәре – 2 ұпай
Dialogue: 0,0:17:38.14,0:17:41.18,Default,,0,0,0,,Бірінші 3 ұпай алған адам жеңеді.
Dialogue: 0,0:17:44.64,0:17:45.93,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:46.14,0:17:49.23,Default,,0,0,0,,Шешуші шайқас ақыры басталды!
Dialogue: 0,0:17:54.69,0:17:57.40,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:18:03.04,0:18:05.54,Default,,0,0,0,,Шудың пішіні басқаша
Dialogue: 0,0:18:05.62,0:18:07.71,Default,,0,0,0,,Мен иығымды ауыртып алған шығармын.
Dialogue: 0,0:18:07.92,0:18:10.83,Default,,0,0,0,,Бальто, сен мені ойладың.
Dialogue: 0,0:18:10.92,0:18:12.71,Default,,0,0,0,,Мен шынымен бақытты болдым.
Dialogue: 0,0:18:12.80,0:18:13.88,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:14.00,0:18:17.67,Default,,0,0,0,,Мен мұндай жарақаттың сенімен кездесуіме кедергі келтіруіне жол бере алмаймын.
Dialogue: 0,0:18:17.76,0:18:20.26,Default,,0,0,0,,Мен сенімен бар күшіммен күресемін!
Dialogue: 0,0:18:24.43,0:18:28.10,Default,,0,0,0,,Шудың сезімін бәрінен де түсінуім керек еді.
Dialogue: 0,0:18:28.19,0:18:29.73,Default,,0,0,0,,«қалыс» деп айту...
Dialogue: 0,0:18:29.81,0:18:30.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:30.65,0:18:34.23,Default,,0,0,0,,Мен осында болғаныма өте қуаныштымын.
Dialogue: 0,0:18:36.90,0:18:38.86,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:39.03,0:18:42.24,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:42.78,0:18:45.33,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:45.66,0:18:48.04,Default,,0,0,0,,Бейді стадионға жіберді.
Dialogue: 0,0:18:48.25,0:18:50.71,Default,,0,0,0,,Валькирияның жолы - Rush Shoot!
Dialogue: 0,0:18:50.79,0:18:53.46,Default,,0,0,0,,Спригганға ашулы шабуыл
Dialogue: 0,0:18:53.67,0:18:55.84,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:18:56.59,0:18:58.63,Default,,0,0,0,,Бірінші байланыс
Dialogue: 0,0:18:58.76,0:19:01.22,Default,,0,0,0,,Мен оны Spriggan Counter Break арқылы ұстадым.
Dialogue: 0,0:19:01.51,0:19:05.35,Default,,0,0,0,,Unite жүргізушісінің резеңке тұтқасы стадионды ұстайды және жібермейді.
Dialogue: 0,0:19:05.60,0:19:07.27,Default,,0,0,0,,Жақсы! Спригган!
Dialogue: 0,0:19:07.47,0:19:11.06,Default,,0,0,0,,Валькири күтіп тұрған Спригганға жүгіреді.
Dialogue: 0,0:19:11.40,0:19:13.73,Default,,0,0,0,,Тез ату және қарсы үзіліс
Dialogue: 0,0:19:13.94,0:19:15.36,Default,,0,0,0,,Бетпе-бет соқтығыс
Dialogue: 0,0:19:15.44,0:19:17.86,Default,,0,0,0,,Бұл қорқынышты соқтығыс.
Dialogue: 0,0:19:21.07,0:19:23.07,Default,,0,0,0,,Толығырақ! Валькирия!
Dialogue: 0,0:19:27.08,0:19:28.91,Default,,0,0,0,,Алып өтіңіз! Спригган!
Dialogue: 0,0:19:34.96,0:19:37.09,Default,,0,0,0,,Бүкіл жан-дүниеңді қамтыған соқтығысу
Dialogue: 0,0:19:37.34,0:19:39.34,Default,,0,0,0,,жалғастыру үшін жалғастыру
Dialogue: 0,0:19:39.42,0:19:41.30,Default,,0,0,0,,Бұл қақтығыс қанша уақытқа созылады?
Dialogue: 0,0:19:41.84,0:19:44.97,Default,,0,0,0,,Валькири шпригганды бірте-бірте итеріп жатыр.
Dialogue: 0,0:19:45.72,0:19:48.43,Default,,0,0,0,,Шудың иығын жарақаттап алғаны ма?
Dialogue: 0,0:19:48.64,0:19:50.77,Default,,0,0,0,,Балто, кеттік!
Dialogue: 0,0:19:53.44,0:19:54.56,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:19:54.65,0:19:56.61,Default,,0,0,0,,Оны қайтадан итеріңіз!
Dialogue: 0,0:19:58.07,0:19:59.03,Default,,0,0,0,,Қазір! Спригган!
Dialogue: 0,0:19:59.32,0:20:00.99,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:20:05.45,0:20:08.45,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:20:12.46,0:20:13.25,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:20:13.33,0:20:15.50,Default,,0,0,0,,Спригган жылдамдығы артты
Dialogue: 0,0:20:15.58,0:20:16.63,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:20:19.71,0:20:21.72,Default,,0,0,0,,
Dialogue: 0,0:20:24.72,0:20:27.18,Default,,0,0,0,,Валькири ұшып кетті!
Dialogue: 0,0:20:27.30,0:20:28.31,Default,,0,0,0,,Спригган -
Dialogue: 0,0:20:28.39,0:20:29.97,Default,,0,0,0,,Фуми қалды
Dialogue: 0,0:20:31.85,0:20:33.19,Default,,0,0,0,,Не!
Dialogue: 0,0:20:33.56,0:20:34.98,Default,,0,0,0,,Спригган дауылы
Dialogue: 0,0:20:35.06,0:20:37.19,Default,,0,0,0,,Артық мәре үшін 1 ұпай
Dialogue: 0,0:20:37.27,0:20:40.48,Default,,0,0,0,,Әлі де күшті Бенишу
Dialogue: 0,0:20:41.15,0:20:42.40,Default,,0,0,0,,А...
Dialogue: 0,0:20:42.86,0:20:43.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:43.86,0:20:44.70,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:20:44.78,0:20:45.61,Default,,0,0,0,,Иә
Dialogue: 0,0:20:47.99,0:20:49.20,Default,,0,0,0,,Шу
Dialogue: 0,0:20:49.28,0:20:51.33,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:20:51.41,0:20:52.96,Default,,0,0,0,,Бұл қандай кадр?
Dialogue: 0,0:20:53.25,0:20:54.79,Default,,0,0,0,,Менің жаңа техникам
Dialogue: 0,0:20:55.21,0:20:56.50,Default,,0,0,0,,Жоғарғы түсіру
Dialogue: 0,0:20:56.83,0:20:59.54,Default,,0,0,0,,Жоғарғы түсірілім? Мен соққы алдым.
Dialogue: 0,0:20:59.88,0:21:02.63,Default,,0,0,0,,Бірақ... бұл шынымен қызық болып барады.
Dialogue: 0,0:21:02.80,0:21:05.38,Default,,0,0,0,,Ах! Жақсы сезінеді!
Dialogue: 0,0:21:05.68,0:21:07.22,Default,,0,0,0,,Бал-нии күліп тұр
Dialogue: 0,0:21:07.30,0:21:08.89,Default,,0,0,0,,Өте қызықты көрінеді
Dialogue: 0,0:21:09.47,0:21:12.56,Default,,0,0,0,,Ол жігіт 1 ұпай алды.
Dialogue: 0,0:21:12.64,0:21:13.73,Default,,0,0,0,,Көңіл-күйлеріңіз көтеріңкі болсын!
Dialogue: 0,0:21:14.23,0:21:16.85,Default,,0,0,0,,Гахахахаха! күлкілі!
Dialogue: 0,0:21:17.15,0:21:18.65,Default,,0,0,0,,Бұл қызық, Балто.
Dialogue: 0,0:21:18.90,0:21:21.11,Default,,0,0,0,,Маған сенің күресуің ұнайды.
Dialogue: 0,0:21:21.19,0:21:23.03,Default,,0,0,0,,Балто күткендей.
Dialogue: 0,0:21:23.65,0:21:27.11,Default,,0,0,0,,Балт-кун 1 ұпайды алып тастады, сондықтан ол кемшілікте, солай ма?
Dialogue: 0,0:21:27.20,0:21:29.20,Default,,0,0,0,,Бұл солай болуы керек.
Dialogue: 0,0:21:29.53,0:21:31.24,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:21:31.70,0:21:33.45,Default,,0,0,0,,Сізбен шайқаста
Dialogue: 0,0:21:33.54,0:21:35.16,Default,,0,0,0,,Жарақат маңызды емес
Dialogue: 0,0:21:35.25,0:21:37.58,Default,,0,0,0,,Бұл сезімдердің соқтығысуы.
Dialogue: 0,0:21:37.75,0:21:39.71,Default,,0,0,0,,Кімнің сезімі күшті?
Dialogue: 0,0:21:39.88,0:21:41.13,Default,,0,0,0,,Валькирия
Dialogue: 0,0:21:41.25,0:21:44.67,Default,,0,0,0,,Мен финалда Шумен шын күрестім.
Dialogue: 0,0:21:44.84,0:21:46.13,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:21:46.43,0:21:47.97,Default,,0,0,0,,Осындай қызықты матч
Dialogue: 0,0:21:48.05,0:21:49.85,Default,,0,0,0,,Бұл оңайлықпен бітпейді
Dialogue: 0,0:21:49.93,0:21:51.51,Default,,0,0,0,,Кеттік! Досым!
Dialogue: 0,0:22:09.16,0:22:15.25,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.45,0:22:21.59,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:22.04,0:22:27.59,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.05,0:22:31.39,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.55,0:22:36.48,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.39,0:22:41.10,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.19,0:22:44.40,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.48,0:22:50.82,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.07,0:22:56.62,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.79,0:23:03.38,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.96,0:23:09.38,Default,,0,0,0,,Даңққа жететін күнге дейін
Dialogue: 0,0:23:09.55,0:23:12.72,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.22,0:23:17.18,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:25.94,0:23:27.90,Default,,0,0,0,,Шуға қарсы арман финалдық матч
Dialogue: 0,0:23:27.98,0:23:30.03,Default,,0,0,0,,Мен ешқашан берілмеймін
Dialogue: 0,0:23:30.11,0:23:33.20,Default,,0,0,0,,Осы уақытқа дейін жетсеңіз, міндетті түрде жеңесіз! Жеңіс жең!
Dialogue: 0,0:23:33.28,0:23:34.32,Default,,0,0,0,,Менің толық күшім
Dialogue: 0,0:23:34.41,0:23:36.45,Default,,0,0,0,,Шуды мүмкіндігінше қатты соғыңыз
Dialogue: 0,0:23:36.54,0:23:38.66,Default,,0,0,0,,Толық қуат, толық қуат, толық қуат!
Dialogue: 0,0:23:38.75,0:23:40.75,Default,,0,0,0,,Бұл шайқас өте күлкілі
Dialogue: 0,0:23:41.58,0:23:43.42,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.50,0:23:46.17,Default,,0,0,0,,Қатты шайқас! Валькири Спригганға қарсы
Dialogue: 0,0:23:46.25,0:23:48.55,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.63,0:23:50.09,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.59,0:23:57.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory