Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.55,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.67,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.93,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.01,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.43,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.86,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.07,0:00:34.28,Default,,0,0,0,,Бұл да, бұл да (Комурасаки Вакия) Доя Доя
Dialogue: 0,0:00:34.53,0:00:38.07,Default,,0,0,0,,Бұл да, мынау да...! Доя Доя Доя
Dialogue: 0,0:00:38.16,0:00:41.54,Default,,0,0,0,,Вакиядан жеңілу өте жаман болды.
Dialogue: 0,0:00:41.62,0:00:43.54,Default,,0,0,0,,Мен жеңгім келді
Dialogue: 0,0:00:43.96,0:00:46.33,Default,,0,0,0,,Мен жарқылмен түсіруді меңгергім келеді.
Dialogue: 0,0:00:46.71,0:00:48.63,Default,,0,0,0,,Әйтпесе, Уакияны жеңе алмайсың.
Dialogue: 0,0:00:49.34,0:00:51.30,Default,,0,0,0,,Жаттығу...Менімен бірге келесіз деп үміттенемін.
Dialogue: 0,0:00:51.38,0:00:52.46,Default,,0,0,0,,Барт
Dialogue: 0,0:00:52.55,0:00:53.26,Default,,0,0,0,,О
Dialogue: 0,0:00:54.17,0:00:55.84,Default,,0,0,0,,Біз жаттығу үстеліміз бе?
Dialogue: 0,0:00:56.09,0:00:56.89,Default,,0,0,0,,Иә...
Dialogue: 0,0:00:57.05,0:00:58.47,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:00:59.18,0:01:00.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:01.72,0:01:03.27,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:03.60,0:01:05.02,Default,,0,0,0,,Мен неге жеңілемін?
Dialogue: 0,0:01:05.77,0:01:07.73,Default,,0,0,0,,Сіз өзіңіздің қолтықтарыңызға тым сенімдісіз.
Dialogue: 0,0:01:07.90,0:01:09.27,Default,,0,0,0,,Келесі жолы менімен бірге жасаңыз
Dialogue: 0,0:01:09.56,0:01:10.94,Default,,0,0,0,,№
Dialogue: 0,0:01:11.36,0:01:13.19,Default,,0,0,0,,Мен жеңілгім келмейді.
Dialogue: 0,0:01:13.28,0:01:14.03,Default,,0,0,0,,Не...
Dialogue: 0,0:01:18.03,0:01:19.66,Default,,0,0,0,,Жеңіңіз немесе жеңіліңіз...
Dialogue: 0,0:01:20.12,0:01:21.20,Default,,0,0,0,,Сіз күлесіз...
Dialogue: 0,0:01:24.20,0:01:25.75,Default,,0,0,0,,Даа!
Dialogue: 0,0:01:25.83,0:01:28.50,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:01:31.42,0:01:32.55,Default,,0,0,0,,(Қайшының кесу дыбысы)
Dialogue: 0,0:01:35.47,0:01:36.59,Default,,0,0,0,,Менің есімде.
Dialogue: 0,0:01:37.18,0:01:39.05,Default,,0,0,0,,Бар күшіңмен күресудің қызығы!
Dialogue: 0,0:01:39.59,0:01:41.76,Default,,0,0,0,,Бэй осылай болуы керек!
Dialogue: 0,0:01:42.26,0:01:44.56,Default,,0,0,0,,Уакиямен шайқас күтіп тұр!
Dialogue: 0,0:01:54.82,0:01:57.20,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:57.53,0:02:02.70,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:14.00,0:02:17.38,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:17.88,0:02:20.01,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:20.43,0:02:24.56,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:24.68,0:02:27.89,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:28.02,0:02:34.44,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:34.73,0:02:39.15,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:39.65,0:02:45.08,Default,,0,0,0,,Ыстық және діріл ойнайық
Dialogue: 0,0:02:45.20,0:02:47.45,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:47.54,0:02:52.25,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:52.42,0:02:57.51,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:57.80,0:03:00.05,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:03:00.26,0:03:02.59,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:03:02.89,0:03:06.81,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:03:06.97,0:03:11.98,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:12.19,0:03:14.36,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:18.28,0:03:20.24,Default,,0,0,0,,Үмітсіздік Спригган
Dialogue: 0,0:03:23.32,0:03:25.62,Default,,0,0,0,,Не істедің, Шу-кун?
Dialogue: 0,0:03:26.28,0:03:29.58,Default,,0,0,0,,Мен сені соңғы көргеннен де жаман болды, солай емес пе?
Dialogue: 0,0:03:31.33,0:03:32.79,Default,,0,0,0,,Сізде Бейбатл болды...
Dialogue: 0,0:03:33.96,0:03:34.88,Default,,0,0,0,,Иә
Dialogue: 0,0:03:34.96,0:03:36.34,Default,,0,0,0,,Бұл жаман емес пе?
Dialogue: 0,0:03:36.42,0:03:38.42,Default,,0,0,0,,Сіздің иығыңыз толық сауығып кеткенше -
Dialogue: 0,0:03:38.50,0:03:40.51,Default,,0,0,0,,Бэйге тыйым салынғанын айтпадым ба?
Dialogue: 0,0:03:40.59,0:03:41.88,Default,,0,0,0,,Бірақ сэр
Dialogue: 0,0:03:41.97,0:03:43.01,Default,,0,0,0,,Турнир...
Dialogue: 0,0:03:43.09,0:03:44.64,Default,,0,0,0,,Егер мен қазір өзімді мәжбүрлесем...
Dialogue: 0,0:03:44.72,0:03:47.76,Default,,0,0,0,,Болашақта Бейбаттл ойынын өткізе алмауымыз мүмкін.
Dialogue: 0,0:03:47.85,0:03:48.97,Default,,0,0,0,,Керісінше -
Dialogue: 0,0:03:49.06,0:03:51.35,Default,,0,0,0,,Қолыңызды пайдалануды жоғалтуыңыз мүмкін.
Dialogue: 0,0:03:51.43,0:03:52.19,Default,,0,0,0,,А...
Dialogue: 0,0:03:52.81,0:03:54.56,Default,,0,0,0,,Тағы бір турнир болады
Dialogue: 0,0:03:54.65,0:03:57.73,Default,,0,0,0,,Қазір денеңіз туралы ойланыңыз.
Dialogue: 0,0:03:59.48,0:04:01.19,Default,,0,0,0,,Ай! (Мектеп оқушысы) Ой, қоңырау соғылды.
Dialogue: 0,0:04:05.95,0:04:08.28,Default,,0,0,0,,Турнирден бас тартуым керек дейсіз бе...!
Dialogue: 0,0:04:12.04,0:04:13.83,Default,,0,0,0,,Әй, бұл Шу-кун!
Dialogue: 0,0:04:13.92,0:04:15.63,Default,,0,0,0,,Шуукун!
Dialogue: 0,0:04:17.63,0:04:19.46,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:22.80,0:04:25.55,Default,,0,0,0,,Аға, мен Шу-күнді ерте көрдім.
Dialogue: 0,0:04:25.89,0:04:28.22,Default,,0,0,0,,Шақырдым, бірақ байқамай кетіп қалдым.
Dialogue: 0,0:04:28.30,0:04:30.10,Default,,0,0,0,,Мен өзімді нашар сезіндім бе?
Dialogue: 0,0:04:30.18,0:04:33.02,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Шу жақсы.
Dialogue: 0,0:04:33.10,0:04:35.44,Default,,0,0,0,,Бірақ дәрігер шықты ма?
Dialogue: 0,0:04:35.52,0:04:36.73,Default,,0,0,0,,Суық па?
Dialogue: 0,0:04:36.81,0:04:38.40,Default,,0,0,0,,Мен жөтеліп жатқан жоқпын.
Dialogue: 0,0:04:38.48,0:04:40.90,Default,,0,0,0,,Менің ойымша, сіз қандай да бір түрде жарақат алдыңыз ба?
Dialogue: 0,0:04:40.98,0:04:41.86,Default,,0,0,0,,Жарақат?
Dialogue: 0,0:04:42.74,0:04:43.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:43.65,0:04:45.86,Default,,0,0,0,,Әй, Шу-кун!
Dialogue: 0,0:04:47.03,0:04:48.66,Default,,0,0,0,,Мүмкін сол кезде...?
Dialogue: 0,0:04:49.24,0:04:51.24,Default,,0,0,0,,Қараңдаршы, балалар саябағы!
Dialogue: 0,0:04:51.33,0:04:52.95,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:04:53.25,0:04:53.83,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:54.33,0:04:56.46,Default,,0,0,0,,Мен өткен күні балалар саябағында болдым...
Dialogue: 0,0:04:56.54,0:04:58.75,Default,,0,0,0,,Шу-кунға соқтығысып қала жаздадым.
Dialogue: 0,0:04:58.84,0:05:01.80,Default,,0,0,0,,Шуу оқ атпақшы болды...
Dialogue: 0,0:05:01.88,0:05:03.55,Default,,0,0,0,,Бұл қашан болды?
Dialogue: 0,0:05:03.63,0:05:05.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:05.80,0:05:08.85,Default,,0,0,0,,Бір күн бұрын ағам Шуу-кунмен соғысқан
Dialogue: 0,0:05:08.93,0:05:10.81,Default,,0,0,0,,Мүмкін сонда...
Dialogue: 0,0:05:11.26,0:05:12.06,Default,,0,0,0,,Шу!
Dialogue: 0,0:05:12.14,0:05:13.77,Default,,0,0,0,,А, Бал-нии?
Dialogue: 0,0:05:20.48,0:05:21.86,Default,,0,0,0,,Егер мен қазір өзімді мәжбүрлесем...
Dialogue: 0,0:05:21.94,0:05:24.86,Default,,0,0,0,,Біз болашақта Бейбатл ойынын ойнай алмауымыз мүмкін.
Dialogue: 0,0:05:30.45,0:05:31.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:32.12,0:05:32.99,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:05:33.66,0:05:35.41,Default,,0,0,0,,Көбірек турнирлер бар
Dialogue: 0,0:05:35.50,0:05:38.79,Default,,0,0,0,,Енді өз денеңіз туралы ойланыңыз
Dialogue: 0,0:05:38.88,0:05:40.33,Default,,0,0,0,,Бұл турнир
Dialogue: 0,0:05:40.42,0:05:41.75,Default,,0,0,0,,Бұл қазір немесе ешқашан...!
Dialogue: 0,0:05:45.72,0:05:47.76,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:48.97,0:05:49.76,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:54.47,0:05:56.14,Default,,0,0,0,,Иығың ауырды ма?
Dialogue: 0,0:05:57.19,0:05:57.98,Default,,0,0,0,,Барт…
Dialogue: 0,0:05:58.39,0:06:00.69,Default,,0,0,0,,Солай ма? Шуу!
Dialogue: 0,0:06:02.40,0:06:04.23,Default,,0,0,0,,Сен де жаттығуға келдің бе?
Dialogue: 0,0:06:04.69,0:06:06.53,Default,,0,0,0,,Мен біттім
Dialogue: 0,0:06:06.61,0:06:08.15,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:06:11.78,0:06:14.04,Default,,0,0,0,,Қараңдар, жолдан кетіңдер. Бұл дұрыс.
Dialogue: 0,0:06:14.12,0:06:15.66,Default,,0,0,0,,Сіз бізге кедергі келтіріп жатырсыз.
Dialogue: 0,0:06:15.79,0:06:18.21,Default,,0,0,0,,Мен бұл туралы Никадан естідім!
Dialogue: 0,0:06:18.87,0:06:20.21,Default,,0,0,0,,Сіз дәрігерге бардыңыз ба?
Dialogue: 0,0:06:21.33,0:06:22.71,Default,,0,0,0,,Оның сізге қатысы жоқ.
Dialogue: 0,0:06:22.79,0:06:23.84,Default,,0,0,0,,Мен кінә сезіміне толымын
Dialogue: 0,0:06:23.96,0:06:25.80,Default,,0,0,0,,Ника кінәлі емес, үйге қайт.
Dialogue: 0,0:06:25.88,0:06:28.30,Default,,0,0,0,,Сіз ренжітсеңіз де, мені жалғыз қалдырар ма едіңіз?
Dialogue: 0,0:06:29.30,0:06:30.26,Default,,0,0,0,,Барт…
Dialogue: 0,0:06:30.89,0:06:33.30,Default,,0,0,0,,Амансың ба? Бұл шынымен жаман ба?
Dialogue: 0,0:06:33.81,0:06:34.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:35.22,0:06:36.43,Default,,0,0,0,,Үлкен мәселе емес
Dialogue: 0,0:06:37.02,0:06:38.64,Default,,0,0,0,,Оны аздап салқындату арқылы емдеуге болады.
Dialogue: 0,0:06:44.73,0:06:46.65,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:06:47.07,0:06:48.53,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:49.70,0:06:52.78,Default,,0,0,0,,Балто... Бұған не болды...
Dialogue: 0,0:06:52.87,0:06:54.91,Default,,0,0,0,,Иық Сіз оны суытыңыз дедіңіз ғой, солай ма?
Dialogue: 0,0:06:54.99,0:06:56.29,Default,,0,0,0,,Мен мұз әкелдім!
Dialogue: 0,0:06:56.74,0:06:58.08,Default,,0,0,0,,Йотто!
Dialogue: 0,0:06:58.58,0:07:01.08,Default,,0,0,0,,А, мен тістегім келді.
Dialogue: 0,0:07:02.50,0:07:04.92,Default,,0,0,0,,Иә~ Иә~
Dialogue: 0,0:07:05.50,0:07:06.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:06.92,0:07:09.09,Default,,0,0,0,,Иықтарыңызды салқындату үшін осыншама мұз керек пе?
Dialogue: 0,0:07:09.17,0:07:10.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:13.05,0:07:13.97,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:14.05,0:07:16.31,Default,,0,0,0,,Қырылған мұз дәмді!
Dialogue: 0,0:07:17.27,0:07:19.93,Default,,0,0,0,,Бізге анда-санда келіп тұру керек.
Dialogue: 0,0:07:20.27,0:07:22.52,Default,,0,0,0,,Ка-чанның наны да дәмді.
Dialogue: 0,0:07:22.60,0:07:23.94,Default,,0,0,0,,Менің тәжірибем бар.
Dialogue: 0,0:07:24.02,0:07:26.11,Default,,0,0,0,,Олай болса, оны шығанақ клубына сал.
Dialogue: 0,0:07:26.19,0:07:28.65,Default,,0,0,0,,Мұнда Инсуке, Дина және Кумичо бар...
Dialogue: 0,0:07:28.73,0:07:31.86,Default,,0,0,0,,Бірге жасасаңыз, жаттығу жасағаныңыз дұрыс.
Dialogue: 0,0:07:31.95,0:07:33.82,Default,,0,0,0,,Мен жалғыз болғанды жөн көремін
Dialogue: 0,0:07:33.91,0:07:35.41,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:35.49,0:07:36.37,Default,,0,0,0,,Бірақ
Dialogue: 0,0:07:36.45,0:07:37.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:37.33,0:07:40.33,Default,,0,0,0,,Менің ойымша, сізде қазіргі әдіс бар.
Dialogue: 0,0:07:40.71,0:07:42.79,Default,,0,0,0,,Сен Хуаншан және басқалармен кездескеннен кейін
Dialogue: 0,0:07:43.04,0:07:45.00,Default,,0,0,0,,Бейдің өнері барған сайын шыңдалады.
Dialogue: 0,0:07:45.08,0:07:46.79,Default,,0,0,0,,Рахмет Шу!
Dialogue: 0,0:07:48.46,0:07:49.51,Default,,0,0,0,,Сен жақсы боласың, иә?
Dialogue: 0,0:07:50.01,0:07:52.30,Default,,0,0,0,,Мен де сенің өсуіңе таң қалдым.
Dialogue: 0,0:07:55.64,0:07:57.89,Default,,0,0,0,,Мен сені жеңе аламын...
Dialogue: 0,0:07:57.97,0:07:59.02,Default,,0,0,0,,Әлі емес...
Dialogue: 0,0:07:59.10,0:08:01.56,Default,,0,0,0,,Сен менің таңымсың, мақсатымсың.
Dialogue: 0,0:08:01.89,0:08:04.94,Default,,0,0,0,,Мен сізге қарсы жан-жақты шайқаста жеңгім келеді
Dialogue: 0,0:08:05.02,0:08:07.36,Default,,0,0,0,,Финалға кел, Балто
Dialogue: 0,0:08:07.44,0:08:08.86,Default,,0,0,0,,Мен де міндетті түрде барамын.
Dialogue: 0,0:08:08.94,0:08:09.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:10.03,0:08:11.44,Default,,0,0,0,,Финалда жарысатын кез келді!
Dialogue: 0,0:08:11.53,0:08:13.28,Default,,0,0,0,,Менің қарсыласым болсаң да...
Dialogue: 0,0:08:13.36,0:08:15.41,Default,,0,0,0,,Менің қысқартуға ниетім жоқ.
Dialogue: 0,0:08:15.49,0:08:16.95,Default,,0,0,0,,Бұрыштарды кессем ше...
Dialogue: 0,0:08:17.03,0:08:18.99,Default,,0,0,0,,Мен сенімен енді ешқашан сөйлеспеймін!
Dialogue: 0,0:08:19.54,0:08:20.66,Default,,0,0,0,,♬~
Dialogue: 0,0:08:20.75,0:08:22.50,Default,,0,0,0,,Хехехе!
Dialogue: 0,0:08:22.58,0:08:23.83,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:23.92,0:08:25.08,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:28.84,0:08:30.42,Default,,0,0,0,,Өйткені біз асықпай тамақтанамыз.
Dialogue: 0,0:08:32.01,0:08:33.05,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:35.84,0:08:37.05,Default,,0,0,0,,Хаха
Dialogue: 0,0:08:37.14,0:08:38.93,Default,,0,0,0,,Шу да Кеен болды!
Dialogue: 0,0:08:39.01,0:08:40.06,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:08:40.14,0:08:42.64,Default,,0,0,0,,Түсіндім, Кин көңілді!
Dialogue: 0,0:08:42.73,0:08:44.27,Default,,0,0,0,,Мұны бірге жасамаңыз!
Dialogue: 0,0:08:44.35,0:08:47.06,Default,,0,0,0,,Неліктен? Біз ең жақсы достармыз, солай ма?
Dialogue: 0,0:08:51.36,0:08:53.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:56.70,0:08:57.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:57.57,0:08:59.08,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:08:59.16,0:09:01.12,Default,,0,0,0,,Nga! Бірақ...
Dialogue: 0,0:09:04.00,0:09:05.75,Default,,0,0,0,,Иә, бұл...
Dialogue: 0,0:09:09.38,0:09:10.80,Default,,0,0,0,,♬~
Dialogue: 0,0:09:10.88,0:09:12.30,Default,,0,0,0,,Уау! Тотото…
Dialogue: 0,0:09:15.05,0:09:16.97,Default,,0,0,0,,Хехе...
Dialogue: 0,0:09:18.18,0:09:19.39,Default,,0,0,0,,Хой
Dialogue: 0,0:09:19.47,0:09:21.68,Default,,0,0,0,,Бүгін тура үйге барасыз, солай ма?
Dialogue: 0,0:09:22.72,0:09:23.35,Default,,0,0,0,,Қайта бер.
Dialogue: 0,0:09:23.43,0:09:24.81,Default,,0,0,0,,Әлде дәрігерге баруым керек пе?
Dialogue: 0,0:09:24.89,0:09:26.06,Default,,0,0,0,,Мен саған қайтар деп айттым.
Dialogue: 0,0:09:26.14,0:09:29.11,Default,,0,0,0,,Әй, бір жерден айналма жолмен жүрсең, мен сенімен бірге шығамын!
Dialogue: 0,0:09:29.19,0:09:30.82,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:09:32.86,0:09:35.57,Default,,0,0,0,,Не, не, қандай шу?
Dialogue: 0,0:09:35.65,0:09:38.20,Default,,0,0,0,,Шу мен Балто соғысып жатыр ма?
Dialogue: 0,0:09:38.28,0:09:39.95,Default,,0,0,0,,Бесоқ
Dialogue: 0,0:09:40.03,0:09:41.91,Default,,0,0,0,,Бұл сізге әсер еткен кезде ме?
Dialogue: 0,0:09:42.24,0:09:43.95,Default,,0,0,0,,Мен олардың төбелесіп жатқанына сене алар емеспін.
Dialogue: 0,0:09:44.04,0:09:46.00,Default,,0,0,0,,Бұл үлкен мәселе болуы керек.
Dialogue: 0,0:09:47.00,0:09:48.50,Default,,0,0,0,,Балалар!
Dialogue: 0,0:09:48.83,0:09:50.08,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:50.17,0:09:51.67,Default,,0,0,0,,Ұрыстың себебі неде?
Dialogue: 0,0:09:51.75,0:09:52.92,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:09:53.00,0:09:55.76,Default,,0,0,0,,Ештеңе емес, сіз жарақат алдыңыз!
Dialogue: 0,0:09:55.84,0:09:57.05,Default,,0,0,0,,Жарақат?
Dialogue: 0,0:09:57.13,0:09:58.30,Default,,0,0,0,,Қазірдің өзінде сауығып кетті
Dialogue: 0,0:09:58.93,0:10:00.51,Default,,0,0,0,,Балто тым көп шу шығарып жатыр.
Dialogue: 0,0:10:00.60,0:10:03.10,Default,,0,0,0,,Шынымен бе? Ол шынымен емделді ме?
Dialogue: 0,0:10:03.39,0:10:04.27,Default,,0,0,0,,О
Dialogue: 0,0:10:04.35,0:10:05.81,Default,,0,0,0,,Бұл шынымен рас па?
Dialogue: 0,0:10:05.89,0:10:07.06,Default,,0,0,0,,Сіз бізге кедергі келтіріп жатырсыз.
Dialogue: 0,0:10:07.85,0:10:08.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:10.31,0:10:12.65,Default,,0,0,0,,Шынымен, шынымен, шынымен бе?
Dialogue: 0,0:10:15.61,0:10:16.65,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:10:23.58,0:10:25.41,Default,,0,0,0,,Дәл Куроками
Dialogue: 0,0:10:25.66,0:10:27.16,Default,,0,0,0,,Менің серіктесім бол
Dialogue: 0,0:10:28.12,0:10:29.21,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:10:29.58,0:10:31.67,Default,,0,0,0,,Мен оны біраз уақыттан бері сынап көргім келеді.
Dialogue: 0,0:10:32.08,0:10:33.63,Default,,0,0,0,,Сіз мені мұқият бақылап отырсыз.
Dialogue: 0,0:10:34.05,0:10:35.96,Default,,0,0,0,,Менің жарақатым жазылды ма, жазылмады ма
Dialogue: 0,0:10:38.09,0:10:40.84,Default,,0,0,0,,Ісіну төмендеді, бірақ ауырсыну әлі сақталады.
Dialogue: 0,0:10:40.93,0:10:42.68,Default,,0,0,0,,Шынымды айтсам, мен уайымдаймын, бірақ...
Dialogue: 0,0:10:42.76,0:10:44.10,Default,,0,0,0,,Егер бұл пішін...
Dialogue: 0,0:10:46.06,0:10:47.06,Default,,0,0,0,,Егер мен қазір өзімді мәжбүрлесем...
Dialogue: 0,0:10:47.56,0:10:50.56,Default,,0,0,0,,Біз болашақта Бейбатл ойынын ойнай алмауымыз мүмкін.
Dialogue: 0,0:10:51.52,0:10:53.86,Default,,0,0,0,,Қолыңызды пайдалануды жоғалтуыңыз мүмкін.
Dialogue: 0,0:10:54.52,0:10:56.28,Default,,0,0,0,,Әлі де I
Dialogue: 0,0:10:56.86,0:10:57.90,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:10:59.24,0:11:01.49,Default,,0,0,0,,Мен қазір Бей ойнағым келеді!
Dialogue: 0,0:11:01.57,0:11:04.45,Default,,0,0,0,,Бастайық: Шу мен Дина шайқасы
Dialogue: 0,0:11:04.53,0:11:06.74,Default,,0,0,0,,Бұл 2 балдық жүйе. Жақсы.
Dialogue: 0,0:11:06.91,0:11:07.79,Default,,0,0,0,,О
Dialogue: 0,0:11:08.25,0:11:10.79,Default,,0,0,0,,Үнемі өзгеріп отыратын Unite драйвері
Dialogue: 0,0:11:10.96,0:11:12.63,Default,,0,0,0,,Сіз қандай стратегияны қолданасыз?
Dialogue: 0,0:11:12.71,0:11:14.25,Default,,0,0,0,,Егер ол сүйреп кетсе...
Dialogue: 0,0:11:14.34,0:11:16.38,Default,,0,0,0,,Соған сәйкес иыққа түсетін жүк те артады.
Dialogue: 0,0:11:17.17,0:11:20.13,Default,,0,0,0,,Бұл жерде жылдам аяқтауды мақсат етіңіз.
Dialogue: 0,0:11:21.09,0:11:23.09,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:11:23.18,0:11:26.47,Default,,0,0,0,,Иығымды зақымдағаннан кейін күшті оқты қалай атуға болады?
Dialogue: 0,0:11:26.76,0:11:28.81,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:11:28.89,0:11:31.98,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:32.40,0:11:35.02,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:41.49,0:11:44.07,Default,,0,0,0,,Бұл орталықта Деатсайзерді күту жоспары ма?
Dialogue: 0,0:11:44.16,0:11:45.78,Default,,0,0,0,,Бұл әдеттегіден жылдамырақ!
Dialogue: 0,0:11:45.87,0:11:48.16,Default,,0,0,0,,Жылдамдыққа келетін болсақ, Deathsizer - ең жақсы!
Dialogue: 0,0:11:50.62,0:11:52.83,Default,,0,0,0,,Барып шайқаңыз!
Dialogue: 0,0:12:03.38,0:12:05.68,Default,,0,0,0,,Жылдамдыққа келетін болсақ, Deathsizer - ең жақсы!
Dialogue: 0,0:12:08.14,0:12:10.60,Default,,0,0,0,,Барып шайқаңыз!
Dialogue: 0,0:12:22.03,0:12:23.57,Default,,0,0,0,,Аукционды Deathsizer жеңіп алды.
Dialogue: 0,0:12:23.86,0:12:24.66,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:12:28.41,0:12:29.95,Default,,0,0,0,,Не! Спригган!
Dialogue: 0,0:12:32.87,0:12:33.66,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:12:33.91,0:12:35.62,Default,,0,0,0,,Көңілді өлім өлшемі!
Dialogue: 0,0:12:41.63,0:12:42.92,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:12:44.47,0:12:46.01,Default,,0,0,0,,А, а...
Dialogue: 0,0:12:46.55,0:12:49.22,Default,,0,0,0,,Спригганның сәтті аяқталуы!
Dialogue: 0,0:12:49.89,0:12:51.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:52.27,0:12:54.85,Default,,0,0,0,,Шу 2:0 есебімен жеңіске жетті!
Dialogue: 0,0:12:56.77,0:13:00.44,Default,,0,0,0,,Біз жақсы шайқас өткіздік. Сен күткендей, Шу.
Dialogue: 0,0:13:01.19,0:13:02.11,Default,,0,0,0,,Сіз де
Dialogue: 0,0:13:02.53,0:13:05.86,Default,,0,0,0,,Бұл жарақат алған қуықтың соққысы емес.
Dialogue: 0,0:13:05.95,0:13:08.62,Default,,0,0,0,,Бұрынғыдан жақсырақ.
Dialogue: 0,0:13:08.91,0:13:10.83,Default,,0,0,0,,Түсіндің бе, Балто?
Dialogue: 0,0:13:10.91,0:13:13.54,Default,,0,0,0,,Ах! Бұл шынымен емделді!
Dialogue: 0,0:13:13.62,0:13:15.00,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:13:15.08,0:13:17.42,Default,,0,0,0,,Келесі жолы міндетті түрде жеңемін!
Dialogue: 0,0:13:17.50,0:13:19.54,Default,,0,0,0,,Жеңіп, финалға шығамыз Шу!
Dialogue: 0,0:13:19.63,0:13:21.96,Default,,0,0,0,,Финалды бірге ойнайық!
Dialogue: 0,0:13:22.55,0:13:23.51,Default,,0,0,0,,О
Dialogue: 0,0:13:23.59,0:13:26.18,Default,,0,0,0,,Спригган өте күшті!
Dialogue: 0,0:13:26.26,0:13:28.22,Default,,0,0,0,,Өлім Сізер де дәмді болды.
Dialogue: 0,0:13:28.30,0:13:30.18,Default,,0,0,0,,Бұл дерлік болды.
Dialogue: 0,0:13:30.26,0:13:33.64,Default,,0,0,0,,Мен Валькирияның қаншалықты жарамды болатынына таңғаламын.
Dialogue: 0,0:13:33.72,0:13:36.56,Default,,0,0,0,,Не! Валькири жеңілмейді
Dialogue: 0,0:13:36.64,0:13:38.69,Default,,0,0,0,,Сөзсіз жеңіңіз! Жарайды
Dialogue: 0,0:13:38.77,0:13:40.40,Default,,0,0,0,,Практика!
Dialogue: 0,0:13:40.48,0:13:41.73,Default,,0,0,0,,Келесі мен...
Dialogue: 0,0:13:41.82,0:13:42.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:42.98,0:13:45.74,Default,,0,0,0,,Кім бірінші келеді... (Барлығы) Шығанақтағы шайқас!
Dialogue: 0,0:13:46.49,0:13:49.53,Default,,0,0,0,,Жарайды! Бейблейд Йонекома аудандық турнирі
Dialogue: 0,0:13:49.62,0:13:51.62,Default,,0,0,0,,Бұл жартылай финал!
Dialogue: 0,0:13:51.95,0:13:53.95,Default,,0,0,0,,Біріншіден, біз осы уақытқа дейін жеттік.
Dialogue: 0,0:13:54.04,0:13:57.08,Default,,0,0,0,,Төрт Бейблейдермен таныстыру!
Dialogue: 0,0:13:58.42,0:14:01.63,Default,,0,0,0,,Біріншісі - Барто Аои!
Dialogue: 0,0:14:01.92,0:14:03.30,Default,,0,0,0,,Менің бірінші рет қатысуым болса да...
Dialogue: 0,0:14:03.38,0:14:06.05,Default,,0,0,0,,Мықты қарсыластарын жеңіп, төрттікке енді
Dialogue: 0,0:14:06.13,0:14:07.76,Default,,0,0,0,,Қара жылқы!
Dialogue: 0,0:14:07.84,0:14:09.59,Default,,0,0,0,,Бару-нии, бар күшіңді сал!
Dialogue: 0,0:14:09.68,0:14:11.10,Default,,0,0,0,,Фаито!
Dialogue: 0,0:14:11.18,0:14:12.68,Default,,0,0,0,,Жарылыспен шешіңіз!
Dialogue: 0,0:14:12.76,0:14:14.89,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:14:14.97,0:14:18.60,Default,,0,0,0,,Екінші адам - ​​Вакия Комурасаки!
Dialogue: 0,0:14:18.69,0:14:22.15,Default,,0,0,0,,Қарсыласқа бір ұпай да бермейтін мінсіз қорғаныс.
Dialogue: 0,0:14:22.23,0:14:24.69,Default,,0,0,0,,Өткен жылғы екінші орынды күткендей!
Dialogue: 0,0:14:24.78,0:14:27.32,Default,,0,0,0,,Маған көрсетші, балам.
Dialogue: 0,0:14:27.40,0:14:29.61,Default,,0,0,0,,Виверннің басым күші
Dialogue: 0,0:14:30.11,0:14:33.24,Default,,0,0,0,,Ал үшінші адам - Джинблейд Орочи!
Dialogue: 0,0:14:34.08,0:14:36.50,Default,,0,0,0,,Бей дирижері ойнайтын симфония
Dialogue: 0,0:14:36.58,0:14:37.96,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:14:40.25,0:14:42.00,Default,,0,0,0,,Енді соңғысы...
Dialogue: 0,0:14:42.08,0:14:43.46,Default,,0,0,0,,Бұл Куришуу!
Dialogue: 0,0:14:43.92,0:14:45.67,Default,,0,0,0,,Алдыңғы турнирдің жеңімпазы –
Dialogue: 0,0:14:45.75,0:14:49.68,Default,,0,0,0,,Біз бұл жолы да бірінші орынға шықтық!
Dialogue: 0,0:14:49.76,0:14:51.97,Default,,0,0,0,,Шу-кун, барыңды істе!
Dialogue: 0,0:14:52.64,0:14:54.68,Default,,0,0,0,,Әдеттегідей керемет жігіт
Dialogue: 0,0:14:54.76,0:14:56.60,Default,,0,0,0,,Оның керемет жағы да осында.
Dialogue: 0,0:14:56.68,0:14:59.77,Default,,0,0,0,,Шынымен бе? Өйткені, адам қызу қанды ғой!
Dialogue: 0,0:15:00.98,0:15:03.77,Default,,0,0,0,,Финалға кім шығады!
Dialogue: 0,0:15:03.86,0:15:06.57,Default,,0,0,0,,Олардың екеуі ғана аман қалады!
Dialogue: 0,0:15:06.65,0:15:09.32,Default,,0,0,0,,Валькири финалға барайық!
Dialogue: 0,0:15:09.49,0:15:12.28,Default,,0,0,0,,Бұл жолы мен чемпионатты жеңемін.
Dialogue: 0,0:15:12.95,0:15:14.99,Default,,0,0,0,,Жеңістің әдептілігін ұстанатын менмін.
Dialogue: 0,0:15:15.70,0:15:18.25,Default,,0,0,0,,Біз көздеген шың алда
Dialogue: 0,0:15:18.45,0:15:21.12,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:15:21.21,0:15:23.75,Default,,0,0,0,,Кернеу максималды деңгейде!
Dialogue: 0,0:15:23.83,0:15:25.09,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:25.17,0:15:27.63,Default,,0,0,0,,Сақтықты түсіріп, Орочиден жеңіліп қалмаңыз.
Dialogue: 0,0:15:28.26,0:15:30.55,Default,,0,0,0,,Менің финалдағы қарсыласым сенсің.
Dialogue: 0,0:15:30.63,0:15:31.51,Default,,0,0,0,,Бірақ қазіргі тепе-теңдік қашан бұзылатынын біз білмейміз
Dialogue: 0,0:15:31.59,0:15:33.59,Default,,0,0,0,,Сіз Балтонды төмендетіп жатқан сияқтысыз.
Dialogue: 0,0:15:33.80,0:15:36.43,Default,,0,0,0,,Бұл жігітті жеңе алады...
Dialogue: 0,0:15:36.76,0:15:37.89,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:15:39.02,0:15:40.14,Default,,0,0,0,,Енді сіз білесіз
Dialogue: 0,0:15:42.19,0:15:45.69,Default,,0,0,0,,Қызықты шайқас басталғалы тұр!
Dialogue: 0,0:15:45.77,0:15:47.27,Default,,0,0,0,,Бірінші жартылай финалдық ойын-
Dialogue: 0,0:15:47.36,0:15:49.23,Default,,0,0,0,,Бұл екеуінің шайқасы!
Dialogue: 0,0:15:49.74,0:15:52.91,Default,,0,0,0,,Вакия Комурасаки VS Балт Аои!
Dialogue: 0,0:15:53.16,0:15:57.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:57.28,0:15:59.24,Default,,0,0,0,,Бару-нии, бар күшіңді сал!
Dialogue: 0,0:15:59.33,0:16:00.91,Default,,0,0,0,,Оны жең!
Dialogue: 0,0:16:03.21,0:16:05.58,Default,,0,0,0,,Финалға кел, Балто...!
Dialogue: 0,0:16:05.96,0:16:09.25,Default,,0,0,0,,Бұл кездесу Уакияның жеңісімен шешіледі.
Dialogue: 0,0:16:09.76,0:16:11.88,Default,,0,0,0,,Айналдыру аяқталуы
Dialogue: 0,0:16:11.97,0:16:13.34,Default,,0,0,0,,1 ұпай
Dialogue: 0,0:16:13.43,0:16:15.59,Default,,0,0,0,,Жедел мәре – 2 ұпай
Dialogue: 0,0:16:15.68,0:16:18.39,Default,,0,0,0,,Бірінші 2 ұпай алған адам жеңеді.
Dialogue: 0,0:16:18.47,0:16:20.89,Default,,0,0,0,,Валькири қандай төбелессе де,
Dialogue: 0,0:16:20.98,0:16:23.06,Default,,0,0,0,,Қалқан атудан жеңе алмайды
Dialogue: 0,0:16:23.14,0:16:25.56,Default,,0,0,0,,Оны тез аяқтап, финалға дайындал.
Dialogue: 0,0:16:25.94,0:16:29.15,Default,,0,0,0,,Вайверннің қалқан соққысы керемет
Dialogue: 0,0:16:29.48,0:16:32.11,Default,,0,0,0,,Менің шабуылымның барлық күшін жойыңыз.
Dialogue: 0,0:16:32.90,0:16:34.28,Default,,0,0,0,,Ал бұл техника...
Dialogue: 0,0:16:34.53,0:16:36.87,Default,,0,0,0,,Жедел оқпен қуып жетуге тырыссаңыз да
Dialogue: 0,0:16:36.95,0:16:39.20,Default,,0,0,0,,Қалқанның құлауымен қарсы шабуыл
Dialogue: 0,0:16:39.74,0:16:42.12,Default,,0,0,0,,Бару-нии, әдеттегіден басқа нәрсе.
Dialogue: 0,0:16:42.20,0:16:43.96,Default,,0,0,0,,Сіз бұл туралы ойлайсыз ба?
Dialogue: 0,0:16:44.04,0:16:46.63,Default,,0,0,0,,Менің басым қайтадан пешкаға айналады~
Dialogue: 0,0:16:46.71,0:16:49.71,Default,,0,0,0,,Флэш түсіру әлі жетілмеген
Dialogue: 0,0:16:49.80,0:16:50.80,Default,,0,0,0,,Егер сәтсіз болса
Dialogue: 0,0:16:50.88,0:16:52.97,Default,,0,0,0,,Ұпайлар Уакияға беріледі
Dialogue: 0,0:16:53.30,0:16:56.01,Default,,0,0,0,,Флэш түсіруді пайдалану мүмкін емес... бірақ...
Dialogue: 0,0:16:56.09,0:16:59.22,Default,,0,0,0,,Rush Shoot Shield Shoot-ты жеңе ала ма?
Dialogue: 0,0:16:59.39,0:17:01.72,Default,,0,0,0,,Барынша бар, Бартоу!
Dialogue: 0,0:17:02.18,0:17:05.73,Default,,0,0,0,,Ойланып қарасаңыз да, жақсы идея болмайды!
Dialogue: 0,0:17:05.81,0:17:07.85,Default,,0,0,0,,Өкінішке орай...
Dialogue: 0,0:17:08.52,0:17:09.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:09.48,0:17:11.40,Default,,0,0,0,,Жоқ, Кумичо!
Dialogue: 0,0:17:11.48,0:17:13.86,Default,,0,0,0,,Мен бұл туралы ойлап отырмын, сондықтан мені мазалама!
Dialogue: 0,0:17:14.99,0:17:15.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:16.78,0:17:18.99,Default,,0,0,0,,Сен Хуаншан және басқалармен кездескеннен кейін
Dialogue: 0,0:17:19.07,0:17:21.08,Default,,0,0,0,,Бейдің өнері барған сайын шыңдалады
Dialogue: 0,0:17:21.45,0:17:22.54,Default,,0,0,0,,(Кения) Бірақ білесің бе, біз оны Саторудың аурухана шығындарын жабуға көмектеседі деп ойладық➡
Dialogue: 0,0:17:22.87,0:17:24.04,Default,,0,0,0,,Біз-
Dialogue: 0,0:17:24.12,0:17:27.29,Default,,0,0,0,,Содан бері бәріміз көп жаттығу жасадық, солай емес пе?
Dialogue: 0,0:17:27.37,0:17:30.21,Default,,0,0,0,,Мен бұрын Вакиямен жекпе-жек өткізген кездегі адамнан басқашамын.
Dialogue: 0,0:17:30.42,0:17:32.63,Default,,0,0,0,,Тіпті Rush Shoot өсіп келеді.
Dialogue: 0,0:17:33.67,0:17:36.05,Default,,0,0,0,,Егер менің қазіргі соққым...
Dialogue: 0,0:17:37.59,0:17:40.85,Default,,0,0,0,,Міне, жартылай финалдың басы.
Dialogue: 0,0:17:40.93,0:17:44.64,Default,,0,0,0,,Кім аман қалады - жеңген үміткер Вакия Кодзима немесе
Dialogue: 0,0:17:44.73,0:17:45.89,Default,,0,0,0,,Аои Барто...
Dialogue: 0,0:17:45.98,0:17:48.60,Default,,0,0,0,,Сіз жеңген үміткерді қайтадан жеңесіз бе?
Dialogue: 0,0:17:49.15,0:17:51.11,Default,,0,0,0,,Не істеу керек Валькирия
Dialogue: 0,0:17:51.19,0:17:53.03,Default,,0,0,0,,Қалай ойлайсың, досым?
Dialogue: 0,0:17:55.32,0:17:56.57,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:17:56.65,0:17:58.11,Default,,0,0,0,,Тағы да күл
Dialogue: 0,0:17:58.20,0:18:00.66,Default,,0,0,0,,Бұл жігіт нағыз ақымақ.
Dialogue: 0,0:18:01.24,0:18:02.62,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:18:02.83,0:18:05.50,Default,,0,0,0,,Қалқанмен атумен аяқтау
Dialogue: 0,0:18:05.58,0:18:06.83,Default,,0,0,0,,Міне.
Dialogue: 0,0:18:08.08,0:18:09.83,Default,,0,0,0,,Маған сеніңіз
Dialogue: 0,0:18:10.42,0:18:11.54,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:18:11.63,0:18:13.34,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:13.75,0:18:16.59,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:17.13,0:18:19.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:20.01,0:18:21.43,Default,,0,0,0,,Жабайы уайверн
Dialogue: 0,0:18:21.51,0:18:24.47,Default,,0,0,0,,Стадион арқылы орталыққа қарай сырғыңыз!
Dialogue: 0,0:18:24.56,0:18:26.64,Default,,0,0,0,,Бұл қалқан ату ғой!
Dialogue: 0,0:18:26.89,0:18:30.27,Default,,0,0,0,,Сіз де темірмен қапталған қорғаныс позасын шешесіз бе?
Dialogue: 0,0:18:30.35,0:18:33.65,Default,,0,0,0,,Жеңіс Валькири вивернаға жүгіреді!
Dialogue: 0,0:18:33.73,0:18:35.07,Default,,0,0,0,,Сол қозғалыс...!
Dialogue: 0,0:18:35.44,0:18:36.53,Default,,0,0,0,,Бұл дыбыс...!
Dialogue: 0,0:18:39.45,0:18:42.45,Default,,0,0,0,,Валькири уивернді қағып жіберді!
Dialogue: 0,0:18:42.53,0:18:43.91,Default,,0,0,0,,Бұрынғыдан басқаша!
Dialogue: 0,0:18:44.54,0:18:45.99,Default,,0,0,0,,(Масато) Қандай күш! Жоқ, күте тұр—
Dialogue: 0,0:18:46.08,0:18:47.91,Default,,0,0,0,,Бұл асығыс ату емес пе?
Dialogue: 0,0:18:48.00,0:18:49.75,Default,,0,0,0,,Жаңа техника ойлап таптыңыз ба?
Dialogue: 0,0:18:49.83,0:18:51.50,Default,,0,0,0,,Мен үнемі сәтсіздікке ұшырасам да!
Dialogue: 0,0:18:51.58,0:18:53.54,Default,,0,0,0,,Таусылып қалдың, Балто.
Dialogue: 0,0:18:54.92,0:18:56.80,Default,,0,0,0,,Оған сену керек
Dialogue: 0,0:18:56.88,0:18:58.63,Default,,0,0,0,,Дұрыс, Валькири!
Dialogue: 0,0:18:58.72,0:19:01.18,Default,,0,0,0,,Оқиғаны тез арада өлтіріңіз
Dialogue: 0,0:19:01.26,0:19:03.39,Default,,0,0,0,,Валькирия шабуылдары!
Dialogue: 0,0:19:03.47,0:19:05.64,Default,,0,0,0,,Жасадың, бейбақ!
Dialogue: 0,0:19:05.85,0:19:06.72,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:19:06.81,0:19:07.81,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:19:07.89,0:19:10.77,Default,,0,0,0,,Жарқын түсірілім!
Dialogue: 0,0:19:10.85,0:19:12.40,Default,,0,0,0,,Мақтана алатын ұлыңмын. Иә.
Dialogue: 0,0:19:12.48,0:19:13.86,Default,,0,0,0,,Сіз бұрын ешқашан көрмеген шабуыл!
Dialogue: 0,0:19:13.94,0:19:15.82,Default,,0,0,0,,Темірмен қапталған қорғаныс виверні
Dialogue: 0,0:19:15.90,0:19:17.36,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:19:17.44,0:19:18.32,Default,,0,0,0,,Не?
Dialogue: 0,0:19:18.61,0:19:19.49,Default,,0,0,0,,Бала...!
Dialogue: 0,0:19:20.40,0:19:22.16,Default,,0,0,0,,Сол кездегі үнге оралдың ба?
Dialogue: 0,0:19:23.28,0:19:26.08,Default,,0,0,0,,Сізді сыртқа шығарып жібереді!
Dialogue: 0,0:19:26.16,0:19:28.20,Default,,0,0,0,,Егер жарқылды түсіру жылдамдығы болса
Dialogue: 0,0:19:28.29,0:19:30.58,Default,,0,0,0,,Виверн өзінің бастапқы орнына оралғанға дейін
Dialogue: 0,0:19:30.66,0:19:32.50,Default,,0,0,0,,Қайта шабуыл жасай алады
Dialogue: 0,0:19:33.00,0:19:35.00,Default,,0,0,0,,Шабуылға ұшыраған виверн
Dialogue: 0,0:19:35.09,0:19:37.67,Default,,0,0,0,,Зақымдану үшін сыртқа қарай жылжытыңыз
Dialogue: 0,0:19:37.75,0:19:40.38,Default,,0,0,0,,Сол жерде оларға тағы да шабуыл жасалып, сыртқа шықты.
Dialogue: 0,0:19:40.47,0:19:41.72,Default,,0,0,0,,Соңында...
Dialogue: 0,0:19:43.05,0:19:45.14,Default,,0,0,0,,Күте тұрыңыз, Вайверн!
Dialogue: 0,0:19:47.60,0:19:48.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:48.39,0:19:51.31,Default,,0,0,0,,Жабайы Уайверн ұшып кетті!
Dialogue: 0,0:19:51.39,0:19:53.90,Default,,0,0,0,,Ой, Валькири де тоқтап тұрған сияқты!
Dialogue: 0,0:19:53.98,0:19:55.19,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:19:55.27,0:19:56.77,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:20:01.99,0:20:03.70,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:20:03.78,0:20:06.03,Default,,0,0,0,,Бірінші 1 ұпай алу үшін аяқтаңыз
Dialogue: 0,0:20:06.12,0:20:08.33,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:20:08.41,0:20:10.12,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:10.20,0:20:12.83,Default,,0,0,0,,Қандай жабайы уивер
Dialogue: 0,0:20:12.92,0:20:15.29,Default,,0,0,0,,Темірмен қапталған қорғаныс бұзылды!
Dialogue: 0,0:20:15.96,0:20:18.30,Default,,0,0,0,,Ағымдағы түсірілім қандай...
Dialogue: 0,0:20:18.63,0:20:19.88,Default,,0,0,0,,Бұл турнир-
Dialogue: 0,0:20:19.96,0:20:23.05,Default,,0,0,0,,Комурасаки Вакия барлығын 2-0 есебімен жеңді.
Dialogue: 0,0:20:23.13,0:20:25.76,Default,,0,0,0,,Мен бірінші рет 1 ұпай алдым!
Dialogue: 0,0:20:25.84,0:20:27.85,Default,,0,0,0,,Жарайсыңдар! (Токонацу Ника) Ия!
Dialogue: 0,0:20:27.93,0:20:31.68,Default,,0,0,0,,Жақсы, солай! Екінші шайқасқа да қатысыңыз!
Dialogue: 0,0:20:33.19,0:20:35.94,Default,,0,0,0,,Күшті және әлсіз Әлсіз, бірақ күшті...
Dialogue: 0,0:20:36.52,0:20:38.57,Default,,0,0,0,,Құлағымда күмән жоқ
Dialogue: 0,0:20:38.82,0:20:40.44,Default,,0,0,0,,Қызық болып барады...
Dialogue: 0,0:20:40.53,0:20:42.95,Default,,0,0,0,,Қалқанның шұңқырын сындырмаңыз!
Dialogue: 0,0:20:43.03,0:20:46.20,Default,,0,0,0,,Керемет! Қазіргі флэш түсірілім!
Dialogue: 0,0:20:46.28,0:20:47.24,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:47.32,0:20:49.53,Default,,0,0,0,,Сіз күткендей, досым!
Dialogue: 0,0:20:49.62,0:20:50.66,Default,,0,0,0,,Шамасы...
Dialogue: 0,0:20:50.74,0:20:53.54,Default,,0,0,0,,Маған қаншалықты байсалды екеніңізді көрсетіңіз. Мен түсінбедім.
Dialogue: 0,0:20:55.92,0:20:57.46,Default,,0,0,0,,Бала, мүмкін емес...
Dialogue: 0,0:20:57.54,0:20:58.71,Default,,0,0,0,,Фалько…
Dialogue: 0,0:20:58.79,0:21:01.30,Default,,0,0,0,,Вакия жігіт, сен не істеп жатырсың?
Dialogue: 0,0:21:01.38,0:21:02.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:03.42,0:21:04.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:09.55,0:21:11.27,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:11.52,0:21:13.60,Default,,0,0,0,,(Қатты құлаған дыбыс)
Dialogue: 0,0:21:14.06,0:21:15.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:17.65,0:21:18.56,Default,,0,0,0,,Әй
Dialogue: 0,0:21:18.94,0:21:20.23,Default,,0,0,0,,Салмағы?
Dialogue: 0,0:21:22.99,0:21:24.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:28.32,0:21:29.66,Default,,0,0,0,,Әлгі жігіт-
Dialogue: 0,0:21:29.74,0:21:32.20,Default,,0,0,0,,Сіз осындай бірдеңені киіп ұрысып қалдыңыз ба...?
Dialogue: 0,0:21:34.37,0:21:37.79,Default,,0,0,0,,Аа~ мен жеңіл ыңылдадым.
Dialogue: 0,0:21:37.87,0:21:40.75,Default,,0,0,0,,Міне, қызық осымен аяқталады.
Dialogue: 0,0:21:42.92,0:21:44.38,Default,,0,0,0,,Ең күшті шығанақ –
Dialogue: 0,0:21:44.46,0:21:46.43,Default,,0,0,0,,Мынау жабайы уивер!
Dialogue: 0,0:21:46.51,0:21:47.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:07.57,0:22:13.66,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:13.87,0:22:20.00,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:20.46,0:22:26.01,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:26.47,0:22:29.80,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:29.97,0:22:34.89,Default,,0,0,0,,Сіз енді ешқашан жоғалмайсыз
Dialogue: 0,0:22:36.81,0:22:39.52,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:39.60,0:22:42.81,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:42.90,0:22:49.24,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:49.49,0:22:55.04,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:55.20,0:23:01.79,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:02.38,0:23:07.80,Default,,0,0,0,,Даңққа жететін күнге дейін
Dialogue: 0,0:23:07.96,0:23:11.13,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:11.64,0:23:15.60,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:25.07,0:23:27.28,Default,,0,0,0,,Флэш түсіру жұмыс істемейді!
Dialogue: 0,0:23:27.36,0:23:28.82,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:23:28.90,0:23:31.45,Default,,0,0,0,,Мен де киімімді тігіп, салмақты шешемін!
Dialogue: 0,0:23:31.53,0:23:33.24,Default,,0,0,0,,Мен оны қоймадым!
Dialogue: 0,0:23:33.32,0:23:36.20,Default,,0,0,0,,Не? Шуды да Орочи бұрышта ма?
Dialogue: 0,0:23:36.28,0:23:39.45,Default,,0,0,0,,Бұл өтірік! Шу сондай...
Dialogue: 0,0:23:40.04,0:23:42.08,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:42.17,0:23:44.13,Default,,0,0,0,,Қалқанның таңғажайып апаты!
Dialogue: 0,0:23:44.67,0:23:46.21,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.29,0:23:48.17,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:49.67,0:23:55.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory