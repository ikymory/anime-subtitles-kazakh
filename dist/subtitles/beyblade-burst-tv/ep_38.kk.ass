Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.67,0:00:14.80,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.88,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:19.35,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.06,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.19,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:32.03,0:00:33.74,Default,,0,0,0,,Ең күшті команда
Dialogue: 0,0:00:33.82,0:00:36.28,Default,,0,0,0,,Ридеутқа қарсы команда финалы
Dialogue: 0,0:00:36.70,0:00:39.87,Default,,0,0,0,,Бірінші шайқаста Кумичо жеңді.
Dialogue: 0,0:00:40.04,0:00:43.46,Default,,0,0,0,,Өкінішке орай, Дина екінші шайқаста жеңіліп қалды.
Dialogue: 0,0:00:44.04,0:00:46.92,Default,,0,0,0,,Ал үшінші шайқас Шудың жеңісі.
Dialogue: 0,0:00:47.00,0:00:48.71,Default,,0,0,0,,Әзірге 3-тен 1-ге дейін
Dialogue: 0,0:00:48.79,0:00:51.30,Default,,0,0,0,,Біз, Йонекома Гакуэн, көш басындамыз.
Dialogue: 0,0:00:51.50,0:00:53.13,Default,,0,0,0,,Не болып жатыр өзі?
Dialogue: 0,0:00:53.21,0:00:55.43,Default,,0,0,0,,Мен мұндай жігітті қалай жеңемін...
Dialogue: 0,0:00:55.51,0:00:57.84,Default,,0,0,0,,Ондай жағдайда жоғал! Бұл ояту қоңырауы!
Dialogue: 0,0:00:57.93,0:00:58.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:00.47,0:01:03.52,Default,,0,0,0,,Ал үшінші шайқас аяқталғанда
Dialogue: 0,0:01:03.68,0:01:05.35,Default,,0,0,0,,Ол келді
Dialogue: 0,0:01:06.77,0:01:07.65,Default,,0,0,0,,Луис
Dialogue: 0,0:01:07.73,0:01:09.23,Default,,0,0,0,,Сіз естіген жоқсыз ба?
Dialogue: 0,0:01:09.31,0:01:09.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:11.86,0:01:13.28,Default,,0,0,0,,Жоғал
Dialogue: 0,0:01:13.36,0:01:16.11,Default,,0,0,0,,Сіздің атқа мінуге құқығыңыз жоқ.
Dialogue: 0,0:01:17.24,0:01:18.66,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:01:19.12,0:01:21.12,Default,,0,0,0,,Нашар жүзгіштер жоқ.
Dialogue: 0,0:01:22.37,0:01:23.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:31.75,0:01:34.13,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:34.46,0:01:39.64,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:50.94,0:01:54.32,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:54.82,0:01:56.95,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:57.36,0:02:01.49,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:01.62,0:02:04.83,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:04.95,0:02:11.38,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:11.67,0:02:16.09,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:16.59,0:02:22.01,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:22.14,0:02:24.39,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:24.47,0:02:29.19,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:29.35,0:02:34.44,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:34.73,0:02:36.99,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:37.19,0:02:39.53,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:39.82,0:02:43.74,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:43.91,0:02:48.91,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:49.12,0:02:51.29,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:55.00,0:02:57.76,Default,,0,0,0,,Өлім шайқасы! Лонгинуспен шайқас!
Dialogue: 0,0:02:59.38,0:03:02.30,Default,,0,0,0,,
Dialogue: 0,0:03:02.64,0:03:05.89,Default,,0,0,0,,Міне! Ақырында Төрт айналған императордың бірі
Dialogue: 0,0:03:05.97,0:03:08.14,Default,,0,0,0,,Ширасаги сарайы Луис пайда болды.
Dialogue: 0,0:03:08.31,0:03:12.48,Default,,0,0,0,,Командалық шайқастарда бұрын-соңды көрмеген ең күшті Blader пайда болады.
Dialogue: 0,0:03:12.60,0:03:14.40,Default,,0,0,0,,Оның салдары қандай?
Dialogue: 0,0:03:14.48,0:03:16.40,Default,,0,0,0,,Өте оқиғаға толы финалдық матч!
Dialogue: 0,0:03:16.61,0:03:19.57,Default,,0,0,0,,Сәлем Луис! Кенеттен не болды?
Dialogue: 0,0:03:19.65,0:03:21.95,Default,,0,0,0,,Білікті емес дегенді түсінбедім.
Dialogue: 0,0:03:22.03,0:03:23.53,Default,,0,0,0,,Жаңа ғана не айттыңыз?
Dialogue: 0,0:03:23.62,0:03:25.95,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:03:26.03,0:03:27.70,Default,,0,0,0,,Сіз мұны айттыңыз
Dialogue: 0,0:03:27.79,0:03:30.50,Default,,0,0,0,,«Осындай жігітті қалай жеңе аламын?»
Dialogue: 0,0:03:36.96,0:03:38.96,Default,,0,0,0,,Мен мұны айттым.
Dialogue: 0,0:03:39.21,0:03:43.30,Default,,0,0,0,,Қарсыласыңды ғажап деп ойласаң, Куришуды жеңе алмайсың.
Dialogue: 0,0:03:43.64,0:03:44.68,Default,,0,0,0,,Ешқашан
Dialogue: 0,0:03:45.09,0:03:46.10,Default,,0,0,0,,Не!
Dialogue: 0,0:03:46.51,0:03:48.06,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:03:48.56,0:03:51.48,Default,,0,0,0,,Сіз мені ешқашан жеңе алмайсыз
Dialogue: 0,0:03:51.56,0:03:54.15,Default,,0,0,0,,Сіз мені керемет деп ойлаған кезде...
Dialogue: 0,0:03:54.23,0:03:55.90,Default,,0,0,0,,Сіз ұтылып қалдыңыз
Dialogue: 0,0:03:57.44,0:03:58.57,Default,,0,0,0,,Сіз жеңе аласыз
Dialogue: 0,0:03:58.65,0:04:00.78,Default,,0,0,0,,Қазіргі шайқастың мазмұны ше?
Dialogue: 0,0:04:00.86,0:04:01.69,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:04:02.20,0:04:03.70,Default,,0,0,0,,Луи жеткілікті
Dialogue: 0,0:04:04.11,0:04:06.78,Default,,0,0,0,,Rideout осындай ма?
Dialogue: 0,0:04:06.87,0:04:08.16,Default,,0,0,0,,Жеңіске немесе жеңіске жетудің абсолютті шарттары жоқ.
Dialogue: 0,0:04:09.37,0:04:11.79,Default,,0,0,0,,Сенің мұндай сөзді айтасың деп ойламаппын.
Dialogue: 0,0:04:14.54,0:04:16.29,Default,,0,0,0,,Кел, мен сенімен сөйлесуім керек.
Dialogue: 0,0:04:20.67,0:04:21.76,Default,,0,0,0,,Луи!
Dialogue: 0,0:04:22.97,0:04:24.22,Default,,0,0,0,,Менімен күрес
Dialogue: 0,0:04:27.30,0:04:28.30,Default,,0,0,0,,Луи!
Dialogue: 0,0:04:29.64,0:04:30.77,Default,,0,0,0,,Хун
Dialogue: 0,0:04:32.93,0:04:35.56,Default,,0,0,0,,Менің де ұрысқым келеді.
Dialogue: 0,0:04:35.69,0:04:37.52,Default,,0,0,0,,Ширасаги сарайы Руидің пайда болуымен
Dialogue: 0,0:04:37.61,0:04:40.02,Default,,0,0,0,,Залдағы атмосфера бірден қызады.
Dialogue: 0,0:04:40.57,0:04:44.03,Default,,0,0,0,,Қазіргі уақытта Йонекома Гакуэн Бэй клубы 3-1 есебімен көш бастады.
Dialogue: 0,0:04:44.11,0:04:47.49,Default,,0,0,0,,Тағы да финал ережелерін түсіндіру.
Dialogue: 0,0:04:47.57,0:04:50.03,Default,,0,0,0,,Егер шайқас үшінші шайқаста шешілмесе
Dialogue: 0,0:04:50.41,0:04:55.04,Default,,0,0,0,,Келесі шайқаста команданың бес мүшесінің кез келгені ойнай алады.
Dialogue: 0,0:04:55.50,0:04:59.34,Default,,0,0,0,,Жеңіс үшін күш шайқасында қай пышақ күреседі?
Dialogue: 0,0:04:59.42,0:05:00.96,Default,,0,0,0,,Енді үміттенейік!
Dialogue: 0,0:05:01.55,0:05:04.13,Default,,0,0,0,,Ширасаги Castle Louis шыға ма?
Dialogue: 0,0:05:04.22,0:05:06.55,Default,,0,0,0,,Бұл дауылды ескерту.
Dialogue: 0,0:05:06.63,0:05:08.89,Default,,0,0,0,,Денем дірілдеп жатыр~
Dialogue: 0,0:05:08.97,0:05:11.93,Default,,0,0,0,,Әй, қызық болып барады.
Dialogue: 0,0:05:12.02,0:05:15.35,Default,,0,0,0,,Мазасыз, расында, неге отырмайсың?
Dialogue: 0,0:05:15.44,0:05:18.31,Default,,0,0,0,,Ол Луиге қатты ренжіген болуы керек.
Dialogue: 0,0:05:18.40,0:05:20.77,Default,,0,0,0,,Бұл өте қиын. Луи - жезөкше.
Dialogue: 0,0:05:20.94,0:05:23.82,Default,,0,0,0,,Достарыңды жоғал деп айтатын қандай жүйкең бар?
Dialogue: 0,0:05:24.15,0:05:26.57,Default,,0,0,0,,Дұрыс? Ол шынымен жаман жігіт
Dialogue: 0,0:05:26.95,0:05:29.78,Default,,0,0,0,,А, мен оны міндетті түрде жеңемін.
Dialogue: 0,0:05:30.16,0:05:33.08,Default,,0,0,0,,Күшті шайқас Луи келуі мүмкін
Dialogue: 0,0:05:33.33,0:05:34.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:34.16,0:05:35.66,Default,,0,0,0,,Бұл мүмкін.
Dialogue: 0,0:05:35.79,0:05:40.21,Default,,0,0,0,,Бұрын шықпаған жігіт кенет осында келді.
Dialogue: 0,0:05:40.46,0:05:41.71,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:05:41.79,0:05:44.09,Default,,0,0,0,,Мен күшпен шайқасқа шығамын
Dialogue: 0,0:05:44.17,0:05:48.01,Default,,0,0,0,,Күте тұрыңыз, 2 ұпай қалды, Жарылуыммен берік шешім қабылдадым.
Dialogue: 0,0:05:48.34,0:05:49.34,Default,,0,0,0,,Мен!
Dialogue: 0,0:05:49.43,0:05:50.80,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:05:51.35,0:05:53.18,Default,,0,0,0,,Хмм!
Dialogue: 0,0:05:54.14,0:05:57.10,Default,,0,0,0,,Менің ойымша, сізді командалық жарыстар қызықтырмайды.
Dialogue: 0,0:05:57.19,0:05:58.10,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:05:58.19,0:06:00.35,Default,,0,0,0,,Онда не үшін келдің?
Dialogue: 0,0:06:01.40,0:06:05.32,Default,,0,0,0,,Міне. Сіз мені әлі танымайсыз ба?
Dialogue: 0,0:06:05.40,0:06:08.28,Default,,0,0,0,,Кё, үндеме. Мен Луиге айтамын.
Dialogue: 0,0:06:08.74,0:06:09.57,Default,,0,0,0,,Иә
Dialogue: 0,0:06:09.95,0:06:13.37,Default,,0,0,0,,Сіз оны бірінші шайқастан бері қарап отырсаңыз керек.
Dialogue: 0,0:06:13.62,0:06:15.08,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:06:15.33,0:06:18.25,Default,,0,0,0,,Әйтпесе маған олай айта алмас едің.
Dialogue: 0,0:06:18.33,0:06:21.92,Default,,0,0,0,,...
Dialogue: 0,0:06:23.21,0:06:24.96,Default,,0,0,0,,Көптеген адамдар қарап тұрғанда
Dialogue: 0,0:06:25.05,0:06:28.05,Default,,0,0,0,,Синки-санның сенен жоғалуыңды сұрауы аздап қорқынышты емес пе?
Dialogue: 0,0:06:28.59,0:06:31.47,Default,,0,0,0,,Мен Куришудың күштілігін шынымды айттым.
Dialogue: 0,0:06:31.55,0:06:32.85,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:06:33.72,0:06:34.68,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:06:35.18,0:06:37.68,Default,,0,0,0,,Бар, мына жігіт туралы бірдеңе істе.
Dialogue: 0,0:06:37.77,0:06:39.19,Default,,0,0,0,,Ең нашар ауа
Dialogue: 0,0:06:39.81,0:06:42.36,Default,,0,0,0,,Луи, біз бәріміз бір командадамыз.
Dialogue: 0,0:06:42.61,0:06:44.27,Default,,0,0,0,,Осы жерде Шинкиден кешірім сұраңыз.
Dialogue: 0,0:06:44.69,0:06:46.32,Default,,0,0,0,,Ол құлады.
Dialogue: 0,0:06:46.40,0:06:47.61,Default,,0,0,0,,Жолға шығу
Dialogue: 0,0:06:48.74,0:06:50.07,Default,,0,0,0,,Сіз асыра айтып жатырсыз, Луис.
Dialogue: 0,0:06:50.78,0:06:52.99,Default,,0,0,0,,Күшке мақтануға болмайды
Dialogue: 0,0:06:53.49,0:06:55.58,Default,,0,0,0,,Тек нашар қуық бар.
Dialogue: 0,0:06:56.04,0:06:57.37,Default,,0,0,0,,Тәкаппарлық дегеніміз не?
Dialogue: 0,0:06:57.45,0:07:00.79,Default,,0,0,0,,Captain Force Battle Мені жіберуге рұқсат етіңіз
Dialogue: 0,0:07:01.00,0:07:03.38,Default,,0,0,0,,Мен Луиге күшімді көрсетемін.
Dialogue: 0,0:07:03.92,0:07:05.00,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:07:05.09,0:07:06.13,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:07:06.71,0:07:08.88,Default,,0,0,0,,Луи, сіз келесідесіз.
Dialogue: 0,0:07:09.38,0:07:10.34,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:07:10.68,0:07:11.68,Default,,0,0,0,,Не! Гваааах!
Dialogue: 0,0:07:14.14,0:07:16.18,Default,,0,0,0,,Гунуну~
Dialogue: 0,0:07:16.47,0:07:18.39,Default,,0,0,0,,Вакия, сен жеңілдің.
Dialogue: 0,0:07:18.60,0:07:19.77,Default,,0,0,0,,Не!
Dialogue: 0,0:07:19.85,0:07:20.56,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:07:21.19,0:07:23.98,Default,,0,0,0,,Нені жоғалтады? Бұл сәттілік әкеледі!
Dialogue: 0,0:07:24.06,0:07:28.44,Default,,0,0,0,,Эй, матч басталмас бұрын мен Балтоға шешім қабылдауын айттым.
Dialogue: 0,0:07:28.53,0:07:31.07,Default,,0,0,0,,Мен саған капитанға лайық нәрсе жасауға рұқсат етемін.
Dialogue: 0,0:07:31.15,0:07:31.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:33.95,0:07:36.41,Default,,0,0,0,,Капитан кім?
Dialogue: 0,0:07:37.62,0:07:39.95,Default,,0,0,0,,Сен, Балто
Dialogue: 0,0:07:40.04,0:07:41.96,Default,,0,0,0,,Бұл үлкен шешім!
Dialogue: 0,0:07:42.04,0:07:44.29,Default,,0,0,0,,Күшті шайқас - Аои Балт!
Dialogue: 0,0:07:44.38,0:07:46.63,Default,,0,0,0,,Уау! Менің ақымақ~
Dialogue: 0,0:07:46.71,0:07:48.80,Default,,0,0,0,,Мұнда Балтықпен бірге барайық.
Dialogue: 0,0:07:48.88,0:07:50.97,Default,,0,0,0,,Олар кімді жібереді?
Dialogue: 0,0:07:51.26,0:07:52.51,Default,,0,0,0,,Луи келе жатыр
Dialogue: 0,0:07:52.59,0:07:54.39,Default,,0,0,0,,Ол менімен күресуге келді.
Dialogue: 0,0:07:54.80,0:07:56.43,Default,,0,0,0,,Сенімділік қандай?
Dialogue: 0,0:07:56.51,0:07:58.51,Default,,0,0,0,,Жауабы анық
Dialogue: 0,0:07:58.60,0:08:00.52,Default,,0,0,0,,Бұл Луи немесе басқа біреу ме, бәрібір.
Dialogue: 0,0:08:00.60,0:08:02.10,Default,,0,0,0,,Балт жеңеді!
Dialogue: 0,0:08:02.19,0:08:03.48,Default,,0,0,0,,Өтінемін, Балто!
Dialogue: 0,0:08:03.60,0:08:04.40,Default,,0,0,0,,О!
Dialogue: 0,0:08:04.48,0:08:06.73,Default,,0,0,0,,Егер бұл орын алса, мен жеңбеймін.
Dialogue: 0,0:08:06.98,0:08:09.23,Default,,0,0,0,,О, оны маған қалдырыңыз.
Dialogue: 0,0:08:11.03,0:08:12.15,Default,,0,0,0,,Мен қарсымын.
Dialogue: 0,0:08:12.53,0:08:14.41,Default,,0,0,0,,Капитан кетуі керек.
Dialogue: 0,0:08:14.49,0:08:16.41,Default,,0,0,0,,Жоқ, Луис - ең жақсы таңдау.
Dialogue: 0,0:08:16.49,0:08:17.87,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:08:17.95,0:08:21.20,Default,,0,0,0,,Шинки-сан мен Катана-сан, бірдеңе айтыңызшы.
Dialogue: 0,0:08:21.29,0:08:22.79,Default,,0,0,0,,Синки де, Катана да
Dialogue: 0,0:08:23.00,0:08:26.17,Default,,0,0,0,,Егер сіз нақты ұпай алғыңыз келсе, Луиден басқа ешкім жоқ екенін білесіз.
Dialogue: 0,0:08:27.92,0:08:29.30,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:08:29.38,0:08:31.26,Default,,0,0,0,,Мен оны қабылдай алмаймын.
Dialogue: 0,0:08:31.92,0:08:32.76,Default,,0,0,0,,Луис
Dialogue: 0,0:08:33.17,0:08:35.43,Default,,0,0,0,,Мен осы мүшемен жеңгім келеді.
Dialogue: 0,0:08:35.80,0:08:37.97,Default,,0,0,0,,Мен капитан ретінде сізден сұраймын
Dialogue: 0,0:08:39.43,0:08:40.89,Default,,0,0,0,,Шық, Луис.
Dialogue: 0,0:08:41.52,0:08:43.18,Default,,0,0,0,,Өзіңіз ше?
Dialogue: 0,0:08:44.31,0:08:46.90,Default,,0,0,0,,Капитан ретінде салқын әрекет етпеңіз.
Dialogue: 0,0:08:47.23,0:08:48.77,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:49.36,0:08:50.40,Default,,0,0,0,,I-
Dialogue: 0,0:08:50.90,0:08:53.07,Default,,0,0,0,,Мен сенің төбелескеніңді көргім келеді
Dialogue: 0,0:08:53.49,0:08:54.49,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:08:55.11,0:08:56.28,Default,,0,0,0,,Австралиялық сенпай
Dialogue: 0,0:08:58.70,0:09:01.66,Default,,0,0,0,,Ойын қызықсыз болып шықса, мен үйге барамын.
Dialogue: 0,0:09:02.20,0:09:04.62,Default,,0,0,0,,Кәне, күшпен шайқас
Dialogue: 0,0:09:04.71,0:09:07.88,Default,,0,0,0,,Екі команданың да пышақтары кім болады?
Dialogue: 0,0:09:07.96,0:09:09.00,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:09:09.09,0:09:12.67,Default,,0,0,0,,Йонекома Гакуэн Бэй клубының Форс Blader
Dialogue: 0,0:09:12.76,0:09:14.84,Default,,0,0,0,,Бұл капитан Балто Аои.
Dialogue: 0,0:09:15.30,0:09:16.51,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе~
Dialogue: 0,0:09:16.59,0:09:17.64,Default,,0,0,0,,Бал аға
Dialogue: 0,0:09:17.93,0:09:19.01,Default,,0,0,0,,Барт?
Dialogue: 0,0:09:19.10,0:09:21.10,Default,,0,0,0,,Келді, келді, келді.
Dialogue: 0,0:09:21.47,0:09:23.89,Default,,0,0,0,,Сіз келдіңіз бе?
Dialogue: 0,0:09:24.31,0:09:26.10,Default,,0,0,0,,Луи, шығыңыз.
Dialogue: 0,0:09:26.27,0:09:30.06,Default,,0,0,0,,Rideout's Force Blader-ге қарсы,
Dialogue: 0,0:09:32.36,0:09:33.57,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:33.65,0:09:36.07,Default,,0,0,0,,Ақыры бұл кісі төбелеседі
Dialogue: 0,0:09:36.15,0:09:37.70,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:09:37.78,0:09:40.49,Default,,0,0,0,,Ширасаги сарайы Руи төрт айналымды императорлардың ішіндегі ең күштісі деп айтылады.
Dialogue: 0,0:09:40.58,0:09:42.83,Default,,0,0,0,,Мен командалық жарысқа бірінші рет қатысып отырмын.
Dialogue: 0,0:09:42.91,0:09:44.12,Default,,0,0,0,,Хола
Dialogue: 0,0:09:44.20,0:09:47.12,Default,,0,0,0,,Луи, сен менімен күресуге келдің ғой, солай ма?
Dialogue: 0,0:09:49.96,0:09:51.92,Default,,0,0,0,,Бұл шынымен де шықты.
Dialogue: 0,0:09:52.00,0:09:54.09,Default,,0,0,0,,Бұл дұрыс жауап емес пе, Шу?
Dialogue: 0,0:09:54.17,0:09:54.84,Default,,0,0,0,,О
Dialogue: 0,0:09:54.92,0:09:58.38,Default,,0,0,0,,Сіз шынымен Балтомен соғысуға келдіңіз бе?
Dialogue: 0,0:09:58.51,0:10:01.01,Default,,0,0,0,,Мен алған сияқтымын.
Dialogue: 0,0:10:01.60,0:10:04.47,Default,,0,0,0,,Сіздің көзқарасыңыз бізді жеңіліске ұшыратты.
Dialogue: 0,0:10:04.56,0:10:06.02,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:06.14,0:10:07.06,Default,,0,0,0,,Бірақ Австралия
Dialogue: 0,0:10:07.14,0:10:09.52,Default,,0,0,0,,Аои Балт осы уақытқа дейін болған барлық шайқастарды көргеннен кейін де,
Dialogue: 0,0:10:09.60,0:10:11.44,Default,,0,0,0,,Ұту әдістері біркелкі емес
Dialogue: 0,0:10:11.52,0:10:14.19,Default,,0,0,0,,Бұл Луиді ашуландыратын адам емес пе?
Dialogue: 0,0:10:14.28,0:10:17.28,Default,,0,0,0,,Білмеймін, тек мынаны айта аламын
Dialogue: 0,0:10:17.36,0:10:20.28,Default,,0,0,0,,Луи қазір Аои Бартоға қарай бет алды.
Dialogue: 0,0:10:20.87,0:10:22.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:22.53,0:10:24.49,Default,,0,0,0,,Көп емес дейді
Dialogue: 0,0:10:24.58,0:10:25.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:25.29,0:10:27.04,Default,,0,0,0,,Сіз білмедіңіз бе?
Dialogue: 0,0:10:27.12,0:10:30.79,Default,,0,0,0,,Луи бір-екі рет емес, орта жолда оралды.
Dialogue: 0,0:10:31.67,0:10:35.05,Default,,0,0,0,,Неліктен мен мұндай адамға еңкейуім керек?
Dialogue: 0,0:10:35.17,0:10:38.05,Default,,0,0,0,,Неліктен австралиялық Сенпай Луи-санға көп көңіл бөледі?
Dialogue: 0,0:10:38.17,0:10:39.38,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:10:40.13,0:10:41.47,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:10:42.09,0:10:43.80,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,0:10:43.89,0:10:44.85,Default,,0,0,0,,That's right.
Dialogue: 0,0:10:46.02,0:10:50.60,Default,,0,0,0,,Менің ойымша, Луидің тәкаппар мінезі оның біраз уақыт шетелде тұруына байланысты.
Dialogue: 0,0:10:51.65,0:10:55.44,Default,,0,0,0,,Мен Жапонияға қайтып келгенімде, ауыспалы студент болған мына жігітті кездестірдім.
Dialogue: 0,0:10:56.40,0:10:59.99,Default,,0,0,0,,Менің сыныбымдағылардың барлығы бұған қызығушылық танытты, өйткені бұл сирек болатын.
Dialogue: 0,0:11:00.40,0:11:02.41,Default,,0,0,0,,Менімен сөйлеспе.
Dialogue: 0,0:11:02.82,0:11:05.58,Default,,0,0,0,,Оның көздерінде әрқашан ашулы көрініс болды.
Dialogue: 0,0:11:06.16,0:11:09.37,Default,,0,0,0,,Жарайды, сен бастауыш сынып оқушысына ұқсамадың.
Dialogue: 0,0:11:09.91,0:11:11.92,Default,,0,0,0,,Ол бірдеңе ойлап отырған сияқты
Dialogue: 0,0:11:12.21,0:11:14.21,Default,,0,0,0,,Бұл әрқашан қиын.
Dialogue: 0,0:11:15.34,0:11:16.75,Default,,0,0,0,,Мен сол кезде болдым.
Dialogue: 0,0:11:16.84,0:11:19.13,Default,,0,0,0,,Мен клуб іс-шараларында Бейді жаттықтырумен айналыстым.
Dialogue: 0,0:11:19.80,0:11:20.67,Default,,0,0,0,,Онда
Dialogue: 0,0:11:21.13,0:11:22.72,Default,,0,0,0,,Луи кенеттен келді.
Dialogue: 0,0:11:27.35,0:11:30.89,Default,,0,0,0,,Осыдан кейін ол күнде көріне бастады.
Dialogue: 0,0:11:31.77,0:11:33.81,Default,,0,0,0,,Сіз менің жаттығуымды бақылап отырдыңыз.
Dialogue: 0,0:11:34.77,0:11:36.44,Default,,0,0,0,,Мен де, әйтеуір
Dialogue: 0,0:11:36.52,0:11:38.19,Default,,0,0,0,,Маған қоңырау шалу қиын.
Dialogue: 0,0:11:39.03,0:11:40.15,Default,,0,0,0,,Және бір күні
Dialogue: 0,0:11:43.49,0:11:44.49,Default,,0,0,0,,Эй
Dialogue: 0,0:11:44.57,0:11:45.74,Default,,0,0,0,,Ұрысайық
Dialogue: 0,0:11:47.45,0:11:49.87,Default,,0,0,0,,Сіз Blader болдыңыз ба?
Dialogue: 0,0:11:50.54,0:11:53.42,Default,,0,0,0,,Сіз тікелей шығанаққа барасыз.
Dialogue: 0,0:11:53.50,0:11:55.21,Default,,0,0,0,,Бұл мен төбелескім келетін адам.
Dialogue: 0,0:11:56.84,0:11:58.09,Default,,0,0,0,,Адалдық
Dialogue: 0,0:11:58.17,0:12:00.21,Default,,0,0,0,,Бұл не? Мен өзім ойландым.
Dialogue: 0,0:12:02.38,0:12:04.80,Default,,0,0,0,,Бірақ күш шын болды.
Dialogue: 0,0:12:05.93,0:12:07.39,Default,,0,0,0,,Жақында
Dialogue: 0,0:12:07.47,0:12:09.97,Default,,0,0,0,,Республикалық турнирде қатарынан төрт рет жеңімпаз атанды.
Dialogue: 0,0:12:11.10,0:12:14.15,Default,,0,0,0,,Күшті, қайратты болса да, алға қарай түзу.
Dialogue: 0,0:12:14.69,0:12:16.15,Default,,0,0,0,,Сондықтан мен өзіме қатты қиналамын
Dialogue: 0,0:12:16.94,0:12:19.44,Default,,0,0,0,,Өзіңіз сияқты басқалардан бірдей нәрсені іздеңіз
Dialogue: 0,0:12:19.53,0:12:21.32,Default,,0,0,0,,Ол қиын жігіт.
Dialogue: 0,0:12:21.40,0:12:22.11,Default,,0,0,0,,О
Dialogue: 0,0:12:22.70,0:12:24.45,Default,,0,0,0,,Мұндай адам сирек кездеседі
Dialogue: 0,0:12:24.53,0:12:26.41,Default,,0,0,0,,Командалық шайқаста тұру
Dialogue: 0,0:12:26.49,0:12:27.58,Default,,0,0,0,,Бұл қыңырлық па?
Dialogue: 0,0:12:28.20,0:12:31.04,Default,,0,0,0,,Мен еріксіз төбелесетін жігіт емеспін.
Dialogue: 0,0:12:33.83,0:12:36.17,Default,,0,0,0,,Енді жеңіске бірден асығасың ба?
Dialogue: 0,0:12:36.25,0:12:37.71,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:12:37.79,0:12:41.13,Default,,0,0,0,,Әлде чемпионның шынайы күшін көрсетесіз бе? Жүгіру
Dialogue: 0,0:12:41.42,0:12:43.51,Default,,0,0,0,,Бұл қарауға болатын күш шайқасы.
Dialogue: 0,0:12:43.59,0:12:45.72,Default,,0,0,0,,Мен жаман Блейдермін бе, жоқ па
Dialogue: 0,0:12:45.89,0:12:47.26,Default,,0,0,0,,Мен саған көрсетемін, Луис.
Dialogue: 0,0:12:47.97,0:12:48.97,Default,,0,0,0,,Хун
Dialogue: 0,0:12:49.43,0:12:50.81,Default,,0,0,0,,Күшті шайқас
Dialogue: 0,0:12:54.23,0:12:56.23,Default,,0,0,0,,Кеттік! дос
Dialogue: 0,0:12:56.31,0:12:57.40,Default,,0,0,0,,Серіктес?
Dialogue: 0,0:12:57.98,0:12:59.90,Default,,0,0,0,,Бұл бала есімі.
Dialogue: 0,0:13:00.36,0:13:03.74,Default,,0,0,0,,Мен және Валькири бірге күшейе түстік.
Dialogue: 0,0:13:03.82,0:13:05.03,Default,,0,0,0,,Сондықтан мен сенің серігіңмін
Dialogue: 0,0:13:05.36,0:13:06.99,Default,,0,0,0,,Ол шулы жігіт.
Dialogue: 0,0:13:07.07,0:13:08.41,Default,,0,0,0,,Мен келдім~
Dialogue: 0,0:13:08.53,0:13:12.04,Default,,0,0,0,,Ширасагижолуидің Бейблейді Оның аты Лостронгинус
Dialogue: 0,0:13:13.00,0:13:14.41,Default,,0,0,0,,Лонгинус
Dialogue: 0,0:13:14.96,0:13:16.46,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:13:16.75,0:13:18.17,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:13:18.46,0:13:22.42,Default,,0,0,0,,Лостронгинус, көптеген атақты сіріңкелерді шығарған чемпион шығанағы.
Dialogue: 0,0:13:22.51,0:13:26.51,Default,,0,0,0,,Көрермендердің бұл қызықты жекпе-жектен үміті зор!
Dialogue: 0,0:13:26.59,0:13:28.51,Default,,0,0,0,,Лостронгинус
Dialogue: 0,0:13:28.59,0:13:29.85,Default,,0,0,0,,Ол қандай шығанақ?
Dialogue: 0,0:13:30.05,0:13:31.47,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:13:32.10,0:13:35.27,Default,,0,0,0,,Егер шайқас қызықсыз болса, мен үйге жарты жолда барамын.
Dialogue: 0,0:13:35.48,0:13:37.27,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:13:37.69,0:13:40.31,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:41.02,0:13:43.40,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:48.11,0:13:49.28,Default,,0,0,0,,Не?
Dialogue: 0,0:13:52.20,0:13:55.50,Default,,0,0,0,,Жүр, Бейді стадионға оқ жаудырды.
Dialogue: 0,0:13:55.58,0:13:56.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:56.50,0:13:57.58,Default,,0,0,0,,Бұл жүгіру...
Dialogue: 0,0:13:57.75,0:14:01.34,Default,,0,0,0,,А, Рострогинус солақай би екен.
Dialogue: 0,0:14:01.42,0:14:02.46,Default,,0,0,0,,Сол жақ?
Dialogue: 0,0:14:02.96,0:14:05.13,Default,,0,0,0,,Мен мұндай шығанақты бұрын-соңды көрген емеспін.
Dialogue: 0,0:14:10.64,0:14:12.81,Default,,0,0,0,,Бұл фронтальды шабуыл ма?
Dialogue: 0,0:14:12.89,0:14:14.43,Default,,0,0,0,,Қарама-қарсы жолдармен жүгіру
Dialogue: 0,0:14:14.52,0:14:16.48,Default,,0,0,0,,Бұл сол жақ айналу алаңының күші.
Dialogue: 0,0:14:16.56,0:14:17.60,Default,,0,0,0,,Лонгинус
Dialogue: 0,0:14:17.69,0:14:20.60,Default,,0,0,0,,Таңғажайып солға бұрылыспен Валькириге жақындау
Dialogue: 0,0:14:22.48,0:14:23.98,Default,,0,0,0,,Мен одан қаштым!
Dialogue: 0,0:14:25.69,0:14:27.53,Default,,0,0,0,,Керемет! Валькирия!
Dialogue: 0,0:14:27.70,0:14:28.61,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:28.70,0:14:30.32,Default,,0,0,0,,Сен істейсің, Балто.
Dialogue: 0,0:14:30.41,0:14:31.74,Default,,0,0,0,,Қарсы шабуыл туралы шешім қабылдау
Dialogue: 0,0:14:32.41,0:14:35.08,Default,,0,0,0,,Лонгинус Валькириді басып ала алмады
Dialogue: 0,0:14:35.62,0:14:37.87,Default,,0,0,0,,Жарайды! Супер ояну!
Dialogue: 0,0:14:38.12,0:14:39.54,Default,,0,0,0,,Өте ояту...
Dialogue: 0,0:14:43.71,0:14:45.75,Default,,0,0,0,,Сіз қалай ойлайсыз? бұл менің құрбым
Dialogue: 0,0:14:45.84,0:14:47.05,Default,,0,0,0,,Бұл Валькири!
Dialogue: 0,0:14:53.14,0:14:54.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:01.06,0:15:03.23,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:15:06.23,0:15:07.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:07.99,0:15:09.32,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:15:10.07,0:15:13.16,Default,,0,0,0,,Лонгинусты үзіліссіз аяқтау үшін 2 ұпай жоғалтты
Dialogue: 0,0:15:13.66,0:15:16.29,Default,,0,0,0,,Күшті шайқаста Rideout жеңді.
Dialogue: 0,0:15:16.54,0:15:19.37,Default,,0,0,0,,Ұпайлар енді 3-3-ке тең.
Dialogue: 0,0:15:19.46,0:15:20.50,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:21.00,0:15:22.58,Default,,0,0,0,,Бір ғана соққы
Dialogue: 0,0:15:22.67,0:15:24.25,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:15:24.34,0:15:25.59,Default,,0,0,0,,Не?
Dialogue: 0,0:15:26.30,0:15:29.72,Default,,0,0,0,,Лостронгинус солға бұрылып қана қоймайды.
Dialogue: 0,0:15:30.13,0:15:33.97,Default,,0,0,0,,Бұл ауыр, өйткені қабатта металл бөлшектер бар.
Dialogue: 0,0:15:34.85,0:15:37.68,Default,,0,0,0,,Соққы әдеттегі шайқастан бірнеше есе көп.
Dialogue: 0,0:15:37.77,0:15:39.39,Default,,0,0,0,,Бірден жарылды
Dialogue: 0,0:15:39.85,0:15:41.44,Default,,0,0,0,,Бұл құбыжық па?
Dialogue: 0,0:15:41.52,0:15:43.40,Default,,0,0,0,,Шу Қашансың?
Dialogue: 0,0:15:43.90,0:15:46.32,Default,,0,0,0,,Дәл солай, бір соққы.
Dialogue: 0,0:15:50.28,0:15:51.86,Default,,0,0,0,,Бар-нии-чан
Dialogue: 0,0:15:51.95,0:15:55.62,Default,,0,0,0,,Командалық финал бесінші шайқасқа әкелді.
Dialogue: 0,0:15:55.91,0:15:57.53,Default,,0,0,0,,Чемпионат не болады?
Dialogue: 0,0:15:57.70,0:15:59.33,Default,,0,0,0,,Йонекома Гакуэн Бей клубы?
Dialogue: 0,0:15:59.41,0:16:01.66,Default,,0,0,0,,Әлде чемпиондық жарыс па?
Dialogue: 0,0:16:02.33,0:16:04.04,Default,,0,0,0,,Өте ояту...
Dialogue: 0,0:16:04.17,0:16:05.88,Default,,0,0,0,,Бұл мүлдем жақсы болмады.
Dialogue: 0,0:16:06.59,0:16:08.71,Default,,0,0,0,,Бұл күшті болды ма?
Dialogue: 0,0:16:08.80,0:16:10.38,Default,,0,0,0,,Шуды жеңген
Dialogue: 0,0:16:10.88,0:16:12.30,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:16:12.63,0:16:14.47,Default,,0,0,0,,Керемет Луи
Dialogue: 0,0:16:14.76,0:16:16.85,Default,,0,0,0,,Ғажайып Лонгинус
Dialogue: 0,0:16:27.77,0:16:28.73,Default,,0,0,0,,Луи!
Dialogue: 0,0:16:30.82,0:16:32.11,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:16:32.82,0:16:34.95,Default,,0,0,0,,Уау! О...
Dialogue: 0,0:16:35.11,0:16:36.74,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:16:40.58,0:16:43.58,Default,,0,0,0,,Сен өте кереметсің, Луи.
Dialogue: 0,0:16:47.50,0:16:50.21,Default,,0,0,0,,Мен саған әрқашан ашуландым
Dialogue: 0,0:16:50.30,0:16:51.88,Default,,0,0,0,,Лонгинус шынымен таң қалдырады
Dialogue: 0,0:16:52.30,0:16:54.43,Default,,0,0,0,,Тағы бір шайқас жасайық
Dialogue: 0,0:16:56.84,0:16:57.97,Default,,0,0,0,,Эй
Dialogue: 0,0:16:58.64,0:16:59.93,Default,,0,0,0,,Сәлем Луис!
Dialogue: 0,0:17:00.81,0:17:02.39,Default,,0,0,0,,Уақыт
Dialogue: 0,0:17:03.43,0:17:04.44,Default,,0,0,0,,Не!
Dialogue: 0,0:17:04.52,0:17:06.40,Default,,0,0,0,,Куришуудан шыққан уақыт.
Dialogue: 0,0:17:06.48,0:17:07.40,Default,,0,0,0,,Не, не?
Dialogue: 0,0:17:08.10,0:17:09.69,Default,,0,0,0,,Бұл не, Шуу?
Dialogue: 0,0:17:09.86,0:17:10.90,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:17:10.98,0:17:12.03,Default,,0,0,0,,О, күте тұрыңыз ...
Dialogue: 0,0:17:12.65,0:17:15.11,Default,,0,0,0,,Мен сіз шешесіз деп ойладым.
Dialogue: 0,0:17:15.20,0:17:17.57,Default,,0,0,0,,Бұл галстук па? Қызық болып барады.
Dialogue: 0,0:17:21.41,0:17:22.54,Default,,0,0,0,,Не?
Dialogue: 0,0:17:22.62,0:17:24.62,Default,,0,0,0,,Мен жолда үйге бармадым.
Dialogue: 0,0:17:25.87,0:17:26.87,Default,,0,0,0,,Ішіңіз
Dialogue: 0,0:17:27.21,0:17:28.29,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:17:28.38,0:17:30.25,Default,,0,0,0,,Ішіп, тынышталыңыз.
Dialogue: 0,0:17:30.34,0:17:33.46,Default,,0,0,0,,Сіз не айтып тұрғаныңызды білесіз бе?
Dialogue: 0,0:17:40.60,0:17:42.89,Default,,0,0,0,,А, өте жақсы сезіледі
Dialogue: 0,0:17:42.97,0:17:44.02,Default,,0,0,0,,~ толтырыңыз
Dialogue: 0,0:17:44.31,0:17:46.35,Default,,0,0,0,,Сіз тынышталған сияқтысыз.
Dialogue: 0,0:17:46.98,0:17:49.06,Default,,0,0,0,,Шу ашулысың ба?
Dialogue: 0,0:17:49.65,0:17:50.86,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:17:50.94,0:17:54.07,Default,,0,0,0,,Бұл жерде қайталаймын деп қымсынбаңыз.
Dialogue: 0,0:17:54.28,0:17:56.32,Default,,0,0,0,,Турнирлер ойындардан ерекшеленеді.
Dialogue: 0,0:17:56.40,0:17:59.16,Default,,0,0,0,,Лонгинус ішімнен жарылды.
Dialogue: 0,0:17:59.53,0:18:02.74,Default,,0,0,0,,Мен бұл нені білдіретінін білмеймін, бірақ мен жылуды сезінемін.
Dialogue: 0,0:18:02.83,0:18:05.58,Default,,0,0,0,,Бастапқыда бұл жігіт осындай болған.
Dialogue: 0,0:18:05.66,0:18:07.41,Default,,0,0,0,,Ал, бұл жеңу немесе жеңілу мәселесі емес.
Dialogue: 0,0:18:07.50,0:18:09.12,Default,,0,0,0,,Балтықтағы бұл шиеленіс
Dialogue: 0,0:18:09.29,0:18:10.54,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:18:10.79,0:18:13.84,Default,,0,0,0,,Онымен барынша күресу керек.
Dialogue: 0,0:18:13.92,0:18:15.46,Default,,0,0,0,,Дұрыс, дұрыс.
Dialogue: 0,0:18:15.80,0:18:18.72,Default,,0,0,0,,Шынында да басқа ештеңе жоқ.
Dialogue: 0,0:18:19.34,0:18:22.85,Default,,0,0,0,,Келесі жолы, әрине, олар Куришуды шығарады.
Dialogue: 0,0:18:22.93,0:18:24.77,Default,,0,0,0,,Бұл тең түсті.
Dialogue: 0,0:18:25.14,0:18:27.23,Default,,0,0,0,,Олар әлдеқашан бұрышта тұр.
Dialogue: 0,0:18:27.31,0:18:29.14,Default,,0,0,0,,Амалсыз келетініне сенімдімін.
Dialogue: 0,0:18:29.23,0:18:30.19,Default,,0,0,0,,That's right.
Dialogue: 0,0:18:30.27,0:18:33.69,Default,,0,0,0,,Бұл жағдайда біз Луиспен де, Гомен де қашып құтыла аламыз.
Dialogue: 0,0:18:34.27,0:18:37.69,Default,,0,0,0,,Маған таңдау керек болса, Луисті таңдар едім.
Dialogue: 0,0:18:37.78,0:18:38.49,Default,,0,0,0,,Хун
Dialogue: 0,0:18:39.24,0:18:40.66,Default,,0,0,0,,Барт
Dialogue: 0,0:18:40.74,0:18:42.41,Default,,0,0,0,,Тек Валькири емес
Dialogue: 0,0:18:42.49,0:18:45.33,Default,,0,0,0,,Сіз де өте оянуға тырысып жатырсыз ба?
Dialogue: 0,0:18:45.62,0:18:48.12,Default,,0,0,0,,О, мен қатты ояндым ба?
Dialogue: 0,0:18:48.21,0:18:50.12,Default,,0,0,0,,Олай болса келесі жолы қолдануға рұқсат етіңіз.
Dialogue: 0,0:18:50.33,0:18:51.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:51.42,0:18:53.09,Default,,0,0,0,,Иә, сабыр етіңіз.
Dialogue: 0,0:18:53.17,0:18:54.96,Default,,0,0,0,,Бірге орындайық
Dialogue: 0,0:18:55.05,0:18:57.71,Default,,0,0,0,,Мен көбірек шайқасқым келеді.
Dialogue: 0,0:18:57.80,0:18:58.67,Default,,0,0,0,,Сіз...
Dialogue: 0,0:18:58.80,0:19:02.93,Default,,0,0,0,,Уакия-саманың бұл үлкен ойынға шықпауы мүмкін емес.
Dialogue: 0,0:19:03.01,0:19:04.30,Default,,0,0,0,,Барлығы да, солай ма?
Dialogue: 0,0:19:04.81,0:19:07.31,Default,,0,0,0,,Арғы жағы Луи болып қайта келеді.
Dialogue: 0,0:19:07.72,0:19:08.73,Default,,0,0,0,,Не?
Dialogue: 0,0:19:08.81,0:19:10.77,Default,,0,0,0,,Егер сіз жарылыспен 2 ұпай алсаңыз
Dialogue: 0,0:19:10.85,0:19:12.31,Default,,0,0,0,,Жеңімпаз анықталды
Dialogue: 0,0:19:12.56,0:19:15.77,Default,,0,0,0,,Сонда мен ең күшті Луисті алып шығуым керек еді.
Dialogue: 0,0:19:16.90,0:19:18.11,Default,,0,0,0,,Сейана
Dialogue: 0,0:19:18.19,0:19:19.86,Default,,0,0,0,,Сонда бұл Шу
Dialogue: 0,0:19:19.95,0:19:21.16,Default,,0,0,0,,Мұны сіз үшін жасайық
Dialogue: 0,0:19:21.24,0:19:24.20,Default,,0,0,0,,Жарайды, солай емес пе?
Dialogue: 0,0:19:27.29,0:19:28.91,Default,,0,0,0,,Мен баруға өте қуаныштымын
Dialogue: 0,0:19:29.25,0:19:31.42,Default,,0,0,0,,Мен Луиден жеңілген сол күннен бастап
Dialogue: 0,0:19:31.67,0:19:33.00,Default,,0,0,0,,Мен көптен бері күттім
Dialogue: 0,0:19:33.42,0:19:34.46,Default,,0,0,0,,Иә
Dialogue: 0,0:19:35.00,0:19:36.21,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:19:36.88,0:19:40.47,Default,,0,0,0,,Сіз күресуге тұрарлық Бладерді қашан таптыңыз?
Dialogue: 0,0:19:40.55,0:19:41.80,Default,,0,0,0,,Бұл Куришуу.
Dialogue: 0,0:19:42.47,0:19:44.18,Default,,0,0,0,,Кетуден басқа амал жоқ.
Dialogue: 0,0:19:44.34,0:19:46.76,Default,,0,0,0,,Сіз ең жақсы шайқасты көре аласыз.
Dialogue: 0,0:19:46.85,0:19:48.47,Default,,0,0,0,,Мен шоу емеспін.
Dialogue: 0,0:19:48.56,0:19:50.56,Default,,0,0,0,,Мен олай айтқым келген жоқ.
Dialogue: 0,0:19:51.06,0:19:52.90,Default,,0,0,0,,Ең жақсы екі пышақ
Dialogue: 0,0:19:53.40,0:19:56.48,Default,,0,0,0,,Менің ойымша, бұл жекпе-жекке қызықпайтын қулық жоқ.
Dialogue: 0,0:19:58.78,0:20:01.07,Default,,0,0,0,,Маған қайта келуге рұқсат ет, Шу.
Dialogue: 0,0:20:01.15,0:20:02.95,Default,,0,0,0,,Сіз өзімшіл болып жатырсыз.
Dialogue: 0,0:20:03.03,0:20:04.53,Default,,0,0,0,,Мен де вай салдым
Dialogue: 0,0:20:04.62,0:20:06.66,Default,,0,0,0,,Бұл өте ояту үшін ме?
Dialogue: 0,0:20:06.78,0:20:09.87,Default,,0,0,0,,Жоқ, мен бар күшіммен Луиді ұрғым келеді.
Dialogue: 0,0:20:09.95,0:20:12.16,Default,,0,0,0,,Бұл командалық шайқастарға арналған кезең.
Dialogue: 0,0:20:12.25,0:20:13.92,Default,,0,0,0,,Сіз тағы да ұмытып кеткен боларсыз.
Dialogue: 0,0:20:14.21,0:20:16.88,Default,,0,0,0,,Ұмытпа, мен тағы да жарысқым келеді.
Dialogue: 0,0:20:17.42,0:20:19.05,Default,,0,0,0,,Мен де солай сезінемін.
Dialogue: 0,0:20:19.13,0:20:20.34,Default,,0,0,0,,Мен бұл жерден бас тартпаймын.
Dialogue: 0,0:20:21.17,0:20:22.59,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:20:22.67,0:20:24.13,Default,,0,0,0,,Егер Барт бұлай деуге дейін барса.
Dialogue: 0,0:20:24.51,0:20:27.14,Default,,0,0,0,,Рахмет сізге Кумичо...
Dialogue: 0,0:20:27.22,0:20:29.14,Default,,0,0,0,,Менің де көрінгім келеді!
Dialogue: 0,0:20:29.22,0:20:29.89,Default,,0,0,0,,Эх!
Dialogue: 0,0:20:29.97,0:20:32.18,Default,,0,0,0,,Не! Егер сіз оны жіберіп алсаңыз, жақсы көрініңіз
Dialogue: 0,0:20:32.27,0:20:34.81,Default,,0,0,0,,Оны тарту арқылы салқын етіп көрсету әрекетін тоқтатыңыз.
Dialogue: 0,0:20:34.98,0:20:36.98,Default,,0,0,0,,Не? Барлығы сыртқа шыққысы келе ме?
Dialogue: 0,0:20:37.40,0:20:40.11,Default,,0,0,0,,Ештеңе етпейді, маған кімнің келгені бәрібір.
Dialogue: 0,0:20:40.19,0:20:42.36,Default,,0,0,0,,Бұл жағдайда көпшілік дауыспен шешейік.
Dialogue: 0,0:20:42.44,0:20:45.78,Default,,0,0,0,,Келіңіздер! Қызық екен, жасайық
Dialogue: 0,0:20:45.86,0:20:47.20,Default,,0,0,0,,Сынып жиналысы?
Dialogue: 0,0:20:47.28,0:20:48.87,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:48.95,0:20:51.16,Default,,0,0,0,,Бір ғана адам қолын бір рет көтере алады.
Dialogue: 0,0:20:51.29,0:20:54.41,Default,,0,0,0,,Сонымен, бұл Кумичо-саманы кім жақсы деп санайды?
Dialogue: 0,0:20:54.50,0:20:55.75,Default,,0,0,0,,Шин
Dialogue: 0,0:20:56.17,0:20:57.79,Default,,0,0,0,,Жалғыз мен бе...
Dialogue: 0,0:20:57.88,0:21:00.30,Default,,0,0,0,,Джая Вакияны кім жақсы деп санайды?
Dialogue: 0,0:21:00.38,0:21:01.17,Default,,0,0,0,,Қалай?
Dialogue: 0,0:21:01.59,0:21:03.13,Default,,0,0,0,,Шин
Dialogue: 0,0:21:03.26,0:21:05.84,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:21:05.93,0:21:07.89,Default,,0,0,0,,Кім Динаны жақсы деп санайды?
Dialogue: 0,0:21:09.01,0:21:10.18,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:21:10.35,0:21:11.77,Default,,0,0,0,,Жарайды келесі
Dialogue: 0,0:21:12.22,0:21:14.85,Default,,0,0,0,,Сонымен, Балтоны кім жақсы деп санайды?
Dialogue: 0,0:21:14.94,0:21:15.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:17.48,0:21:19.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:19.77,0:21:21.78,Default,,0,0,0,,Рахмет саған Дина!
Dialogue: 0,0:21:21.86,0:21:23.61,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:21:23.69,0:21:24.99,Default,,0,0,0,,Міне.
Dialogue: 0,0:21:25.99,0:21:27.95,Default,,0,0,0,,Бесінші шайқас өтінемін
Dialogue: 0,0:21:28.03,0:21:30.08,Default,,0,0,0,,Бар күшіммен істеймін
Dialogue: 0,0:21:30.62,0:21:32.58,Default,,0,0,0,,Мен бұл жолы Луиді жеңемін
Dialogue: 0,0:21:33.00,0:21:35.25,Default,,0,0,0,,
Dialogue: 0,0:21:37.79,0:21:38.71,Default,,0,0,0,,Ах
Dialogue: 0,0:21:39.13,0:21:40.25,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:21:40.34,0:21:41.80,Default,,0,0,0,,Бұл қайтадан Бал-нии.
Dialogue: 0,0:21:41.88,0:21:43.13,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе~
Dialogue: 0,0:21:43.67,0:21:45.42,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:21:45.51,0:21:48.34,Default,,0,0,0,,Йонекома Гакуэн ойыннан бас тартты ма?
Dialogue: 0,0:21:48.64,0:21:55.23,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.78,0:23:29.44,Default,,0,0,0,,Жеңіс жолын маған достарым жалғады
Dialogue: 0,0:23:29.53,0:23:31.53,Default,,0,0,0,,Мен оны тоқтатуға жол бере алмаймын.
Dialogue: 0,0:23:31.78,0:23:34.37,Default,,0,0,0,,Валькириге сеніңіз, сонда біз соқтығысамыз
Dialogue: 0,0:23:34.91,0:23:36.87,Default,,0,0,0,,Мен мұндай сезімді бірінші рет көріп тұрмын.
Dialogue: 0,0:23:37.37,0:23:40.16,Default,,0,0,0,,Валькири екеуміз бір болдық
Dialogue: 0,0:23:40.71,0:23:42.92,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.00,0:23:45.25,Default,,0,0,0,,Жарылыс! Өлім спиралы!
Dialogue: 0,0:23:45.79,0:23:47.80,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.88,0:23:49.84,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.34,0:23:57.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory