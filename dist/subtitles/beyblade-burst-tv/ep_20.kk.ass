Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.59,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.80,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.88,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.85,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.78,0:00:34.03,Default,,0,0,0,,Мен мектептерді ауыстыруым керек.
Dialogue: 0,0:00:34.61,0:00:35.49,Default,,0,0,0,,Не!
Dialogue: 0,0:00:36.32,0:00:38.78,Default,,0,0,0,,Осы жаттығу матчы аяқталғаннан кейін...
Dialogue: 0,0:00:38.91,0:00:41.12,Default,,0,0,0,,Қалаға қайтып келгенде, көшіңіз.
Dialogue: 0,0:00:41.66,0:00:43.41,Default,,0,0,0,,Не... неге...?
Dialogue: 0,0:00:43.50,0:00:45.79,Default,,0,0,0,,Біз команда бола алсақ та...
Dialogue: 0,0:00:45.87,0:00:48.04,Default,,0,0,0,,Команда да бөлек...
Dialogue: 0,0:00:48.54,0:00:51.38,Default,,0,0,0,,Бұл жақсы емес! Мен тоқтай алмаймын...
Dialogue: 0,0:00:52.80,0:00:55.26,Default,,0,0,0,,Мен де тастағым келмейді...
Dialogue: 0,0:00:55.59,0:00:57.05,Default,,0,0,0,,Мен тастағым келмейді...
Dialogue: 0,0:00:58.34,0:00:59.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:59.60,0:01:02.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:06.14,0:01:08.69,Default,,0,0,0,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:01:08.77,0:01:10.40,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:01:10.48,0:01:11.61,Default,,0,0,0,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:01:16.95,0:01:18.99,Default,,0,0,0,,Бұл өтірік, Инуске...
Dialogue: 0,0:01:19.53,0:01:21.58,Default,,0,0,0,,Дос болып қалсақ та...
Dialogue: 0,0:01:22.49,0:01:24.16,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:33.76,0:01:36.13,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:36.47,0:01:41.64,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:52.94,0:01:56.32,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:56.82,0:01:58.95,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:59.36,0:02:03.49,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:03.62,0:02:06.83,Default,,0,0,0,,Дұрыс, сіздің жүзіңіздегі өрнек
Dialogue: 0,0:02:06.96,0:02:13.38,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:13.67,0:02:18.09,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:18.59,0:02:24.01,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:24.14,0:02:26.39,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:26.47,0:02:31.19,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:31.35,0:02:36.44,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:36.73,0:02:38.99,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:39.20,0:02:41.53,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:41.82,0:02:45.74,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:45.91,0:02:50.92,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:51.12,0:02:53.29,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:56.96,0:02:59.72,Default,,0,0,0,,Қосылыңыз! Тізбек ату!
Dialogue: 0,0:03:06.72,0:03:08.31,Default,,0,0,0,,Иттерге қызмет көрсету…
Dialogue: 0,0:03:08.73,0:03:09.89,Default,,0,0,0,,Еркек!
Dialogue: 0,0:03:10.06,0:03:11.44,Default,,0,0,0,,Қылыш оттары қарсы.
Dialogue: 0,0:03:11.52,0:03:14.23,Default,,0,0,0,,Йонекома Гакуэн Бей клубымен жаттығу матчы
Dialogue: 0,0:03:14.31,0:03:16.07,Default,,0,0,0,,Үшінші ойынды бастайық!
Dialogue: 0,0:03:16.40,0:03:19.36,Default,,0,0,0,,Қылыш жалындары Юкифуки Укио болып қала береді
Dialogue: 0,0:03:20.15,0:03:22.20,Default,,0,0,0,,№3 Йонекома Гакуен-
Dialogue: 0,0:03:22.28,0:03:23.57,Default,,0,0,0,,Инсуке Мидорикава
Dialogue: 0,0:03:24.95,0:03:25.70,Default,,0,0,0,,Әй
Dialogue: 0,0:03:27.41,0:03:29.41,Default,,0,0,0,,Кайзер Сербеус…
Dialogue: 0,0:03:29.58,0:03:32.92,Default,,0,0,0,,Менің құлпы ашылған жалғыз мүйізім сияқты қорғаныс түрі
Dialogue: 0,0:03:33.00,0:03:35.50,Default,,0,0,0,,Бұл таныс сияқты.
Dialogue: 0,0:03:36.00,0:03:38.25,Default,,0,0,0,,Сондықтан бізде қорғаныс түрі бірдей.
Dialogue: 0,0:03:38.34,0:03:40.63,Default,,0,0,0,,Біз мүлдем ұтылмаймыз.
Dialogue: 0,0:03:40.72,0:03:43.72,Default,,0,0,0,,Кумичоның шайқасын зая кетпеу үшін!
Dialogue: 0,0:03:44.09,0:03:47.22,Default,,0,0,0,,Сен қатты толқыдың, Мидорикава.
Dialogue: 0,0:03:47.31,0:03:48.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:49.52,0:03:51.73,Default,,0,0,0,,Оның бұрынғыдан басқаша екені анық...
Dialogue: 0,0:03:52.48,0:03:53.77,Default,,0,0,0,,Не болды...
Dialogue: 0,0:03:55.98,0:03:57.23,Default,,0,0,0,,Иттерге қызмет көрсету…
Dialogue: 0,0:03:57.32,0:03:59.86,Default,,0,0,0,,Осы уақытқа дейін неге үндемедің...
Dialogue: 0,0:04:00.32,0:04:04.32,Default,,0,0,0,,Неліктен мен енді сізбен жаттығу жасай алмаймын?
Dialogue: 0,0:04:05.24,0:04:07.53,Default,,0,0,0,,Мен оны енді өзгерте алмаймын...
Dialogue: 0,0:04:08.28,0:04:11.20,Default,,0,0,0,,Тыныштық, ағайын.
Dialogue: 0,0:04:11.29,0:04:12.33,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:12.54,0:04:13.58,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:04:13.67,0:04:16.17,Default,,0,0,0,,Ер адам! Бірінші шайқас!
Dialogue: 0,0:04:18.21,0:04:20.88,Default,,0,0,0,,Кайзер Кербеус қалай пайда болады?
Dialogue: 0,0:04:21.38,0:04:24.26,Default,,0,0,0,,Бір мүйізді мүйіздің атысы күшті.
Dialogue: 0,0:04:24.80,0:04:27.68,Default,,0,0,0,,Бұл қорғаныс түрі болса да, оның керемет шабуыл күші бар...
Dialogue: 0,0:04:28.30,0:04:29.85,Default,,0,0,0,,Дұрыс тамақтансаңыз...
Dialogue: 0,0:04:30.43,0:04:31.89,Default,,0,0,0,,Оған шыдауға болады ма, жоқ па...
Dialogue: 0,0:04:32.35,0:04:33.31,Default,,0,0,0,,Ал егер...!
Dialogue: 0,0:04:33.60,0:04:35.44,Default,,0,0,0,,Дайын жиынтық!
Dialogue: 0,0:04:35.60,0:04:37.81,Default,,0,0,0,,Үш екі... (Инуске) Мен осымен барамын!
Dialogue: 0,0:04:37.90,0:04:39.44,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:41.86,0:04:42.99,Default,,0,0,0,,Гү… гүг… Дұрыс.
Dialogue: 0,0:04:43.19,0:04:44.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:44.40,0:04:46.28,Default,,0,0,0,,Қазір ол ұшып жатыр.
Dialogue: 0,0:04:48.57,0:04:50.66,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:50.74,0:04:52.87,Default,,0,0,0,,Инсуке тым ерте атып жіберді
Dialogue: 0,0:04:53.00,0:04:54.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:54.75,0:04:56.21,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:04:56.29,0:04:58.21,Default,,0,0,0,,Сіз шынымен қобалжыған боларсыз.
Dialogue: 0,0:04:58.58,0:05:00.17,Default,,0,0,0,,Қайтадан ату
Dialogue: 0,0:05:00.38,0:05:02.55,Default,,0,0,0,,Шака! Егер бұл әдейі болса, сіз дисквалификацияланасыз.
Dialogue: 0,0:05:02.63,0:05:04.63,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:05:04.72,0:05:05.97,Default,,0,0,0,,Сіз не білесіз?
Dialogue: 0,0:05:06.51,0:05:07.68,Default,,0,0,0,,Иттерге қызмет көрсету…
Dialogue: 0,0:05:08.05,0:05:09.22,Default,,0,0,0,,олардың әрекеттерін күшейту қаупі бар.
Dialogue: 0,0:05:09.43,0:05:10.76,Default,,0,0,0,,Қайталап көрейік
Dialogue: 0,0:05:10.93,0:05:11.93,Default,,0,0,0,,Еркек!
Dialogue: 0,0:05:12.02,0:05:13.52,Default,,0,0,0,,Түсірілімді қайталаңыз
Dialogue: 0,0:05:13.77,0:05:15.02,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:05:15.60,0:05:17.90,Default,,0,0,0,,Мидорикаваның мұндай қателік жасайтынына сене алар емеспін...
Dialogue: 0,0:05:18.31,0:05:19.98,Default,,0,0,0,,ренжіген
Dialogue: 0,0:05:20.44,0:05:22.03,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:05:22.11,0:05:23.61,Default,,0,0,0,,Осындай маңызды матчта!
Dialogue: 0,0:05:23.94,0:05:24.90,Default,,0,0,0,,Инсуке!
Dialogue: 0,0:05:25.40,0:05:26.57,Default,,0,0,0,,Сабыр ет!
Dialogue: 0,0:05:26.65,0:05:27.86,Default,,0,0,0,,Егер солай істесем…
Dialogue: 0,0:05:28.36,0:05:30.33,Default,,0,0,0,,Біз мұны барлығымен бірге жасай аламыз.
Dialogue: 0,0:05:30.41,0:05:32.45,Default,,0,0,0,,Бұл соңғы матч болса да...
Dialogue: 0,0:05:35.96,0:05:37.29,Default,,0,0,0,,Қол алысайық!
Dialogue: 0,0:05:37.96,0:05:40.17,Default,,0,0,0,,А... Ақшу...?
Dialogue: 0,0:05:40.54,0:05:43.30,Default,,0,0,0,,Сіз осындай нәрсе жасайсыз ба? Сен ше!
Dialogue: 0,0:05:43.38,0:05:46.01,Default,,0,0,0,,Ешқашан қол алыспаңыз
Dialogue: 0,0:05:46.09,0:05:47.76,Default,,0,0,0,,Ұялмаңыз!
Dialogue: 0,0:05:47.93,0:05:49.89,Default,,0,0,0,,А... аа!
Dialogue: 0,0:05:57.89,0:05:59.35,Default,,0,0,0,,Барт…
Dialogue: 0,0:05:59.94,0:06:01.69,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:06:01.77,0:06:04.15,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:04.53,0:06:06.24,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:06.74,0:06:07.78,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:11.20,0:06:13.53,Default,,0,0,0,,Tsk! Тағы бір ату қатесі!
Dialogue: 0,0:06:15.33,0:06:17.21,Default,,0,0,0,,Алдымен орталықты басып алады!
Dialogue: 0,0:06:17.29,0:06:19.37,Default,,0,0,0,,Аяғыңнан тұр, Кербеус!
Dialogue: 0,0:06:28.05,0:06:29.51,Default,,0,0,0,,Бұл тамаша Unicorn
Dialogue: 0,0:06:29.59,0:06:32.89,Default,,0,0,0,,Қарсыласыңыздың шыдамдылығын төгу үшін манеңізді пайдаланыңыз!
Dialogue: 0,0:06:32.97,0:06:35.01,Default,,0,0,0,,Тоқта, Кербеус!
Dialogue: 0,0:06:35.47,0:06:37.31,Default,,0,0,0,,Мен нәтижені көрдім.
Dialogue: 0,0:06:42.90,0:06:44.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:46.78,0:06:48.82,Default,,0,0,0,,Жалғыз мүйізді айналдыру
Dialogue: 0,0:06:48.90,0:06:50.70,Default,,0,0,0,,Юкифуки Укиоға 1 ұпай!
Dialogue: 0,0:06:51.66,0:06:54.37,Default,,0,0,0,,Келесі жолы мен сені жарып жіберемін.
Dialogue: 0,0:06:54.70,0:06:55.79,Default,,0,0,0,,Инуске!
Dialogue: 0,0:06:55.87,0:06:58.79,Default,,0,0,0,,Мен саған сіріңкені босқа өткізбе деп айтпадым ба?
Dialogue: 0,0:06:58.87,0:07:00.41,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:07:00.50,0:07:02.17,Default,,0,0,0,,Эй, Кумичо, сабыр ет.
Dialogue: 0,0:07:02.25,0:07:03.29,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:07:03.63,0:07:05.17,Default,,0,0,0,,Тіпті Инускенің өзі шарасыз!
Dialogue: 0,0:07:07.88,0:07:08.76,Default,,0,0,0,,Балто!
Dialogue: 0,0:07:12.68,0:07:14.18,Default,,0,0,0,,Не істеуім керек Шака...
Dialogue: 0,0:07:14.26,0:07:16.39,Default,,0,0,0,,Сіз жалғастыруды шештіңіз.
Dialogue: 0,0:07:16.47,0:07:17.56,Default,,0,0,0,,Ешқашан тоқтамаңыз
Dialogue: 0,0:07:18.14,0:07:20.23,Default,,0,0,0,,Ер адам! екінші шайқас
Dialogue: 0,0:07:25.69,0:07:28.11,Default,,0,0,0,,Балалар сендерге не болды?
Dialogue: 0,0:07:28.19,0:07:29.36,Default,,0,0,0,,Ештеңе...
Dialogue: 0,0:07:29.99,0:07:31.90,Default,,0,0,0,,Команда ыдыраған жоқ па?
Dialogue: 0,0:07:31.99,0:07:32.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:32.95,0:07:35.32,Default,,0,0,0,,Бұл командалық ойындарды ойнағанда мағынасы жоқ.
Dialogue: 0,0:07:37.33,0:07:40.71,Default,,0,0,0,,Инсуке... басқа мектепке ауысып, командадан кетеді...
Dialogue: 0,0:07:41.04,0:07:42.67,Default,,0,0,0,,Италиялықтар тегіне мақтанады
Dialogue: 0,0:07:42.83,0:07:46.00,Default,,0,0,0,,Бұл біткенде, мен басқа жаққа кетемін...
Dialogue: 0,0:07:46.67,0:07:49.76,Default,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:07:51.42,0:07:53.59,Default,,0,0,0,,Сен кімсің, Мидорикава?
Dialogue: 0,0:07:54.09,0:07:54.93,Default,,0,0,0,,А...
Dialogue: 0,0:07:55.55,0:07:56.85,Default,,0,0,0,,Соғыс күші жағынан олар сөзсіз сенімді.
Dialogue: 0,0:08:02.85,0:08:05.19,Default,,0,0,0,,Ах~ Антоки қуыршақ!
Dialogue: 0,0:08:05.27,0:08:08.19,Default,,0,0,0,,Барто Аои Сіз мені жеңе алмайсыз
Dialogue: 0,0:08:08.27,0:08:10.53,Default,,0,0,0,,Біз жеңеміз
Dialogue: 0,0:08:11.24,0:08:13.11,Default,,0,0,0,,Бей клубына қосылыңыз
Dialogue: 0,0:08:13.20,0:08:13.91,Default,,0,0,0,,Не!
Dialogue: 0,0:08:13.99,0:08:14.74,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:08:15.03,0:08:16.82,Default,,0,0,0,,Күте тұрыңыз, Инуске!
Dialogue: 0,0:08:16.91,0:08:17.78,Default,,0,0,0,,(Демін ала-шала)
Dialogue: 0,0:08:19.04,0:08:19.91,Default,,0,0,0,,​​Не!
Dialogue: 0,0:08:19.99,0:08:21.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:21.50,0:08:24.46,Default,,0,0,0,,Сол себепті финалда Шуды жеңе алмайсың ба?
Dialogue: 0,0:08:24.54,0:08:26.17,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:08:27.92,0:08:29.13,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:08:29.75,0:08:31.59,Default,,0,0,0,,Ол менікі...
Dialogue: 0,0:08:31.67,0:08:32.72,Default,,0,0,0,,Эй
Dialogue: 0,0:08:33.38,0:08:35.09,Default,,0,0,0,,Дәретхана тым ұзын!
Dialogue: 0,0:08:35.18,0:08:36.59,Default,,0,0,0,,Бар-нии, тез кел!
Dialogue: 0,0:08:36.68,0:08:37.43,Default,,0,0,0,,Е...
Dialogue: 0,0:08:37.89,0:08:39.51,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:08:42.02,0:08:43.23,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:43.31,0:08:44.52,Default,,0,0,0,,Әдейі...?
Dialogue: 0,0:08:44.60,0:08:46.69,Default,,0,0,0,,Инсуке, тезірек!
Dialogue: 0,0:08:47.10,0:08:48.73,Default,,0,0,0,,Эй, сен мені естисің!
Dialogue: 0,0:08:48.81,0:08:49.77,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:08:50.48,0:08:52.94,Default,,0,0,0,,Мұндай нәрсені кешіруге бола ма?
Dialogue: 0,0:08:53.03,0:08:55.28,Default,,0,0,0,,Ресми матчта бұл мүмкін емес еді...
Dialogue: 0,0:08:55.36,0:08:58.53,Default,,0,0,0,,Енді жақсы емес пе, Укио?
Dialogue: 0,0:08:58.62,0:09:00.99,Default,,0,0,0,,Бұл әзілдеу операциясы емес сияқты.
Dialogue: 0,0:09:01.20,0:09:04.25,Default,,0,0,0,,Мен мұндай епті еліктеулерді жасай алатын типтен емеспін.
Dialogue: 0,0:09:04.62,0:09:05.58,Default,,0,0,0,,Инуске!
Dialogue: 0,0:09:06.04,0:09:08.79,Default,,0,0,0,,Барт, менің матчымды қараңыз.
Dialogue: 0,0:09:09.09,0:09:10.04,Default,,0,0,0,,Е...!
Dialogue: 0,0:09:10.29,0:09:12.05,Default,,0,0,0,,Инуске сөйледі!
Dialogue: 0,0:09:12.38,0:09:14.97,Default,,0,0,0,,Мен енді атуды жіберіп алмаймын
Dialogue: 0,0:09:15.22,0:09:17.26,Default,,0,0,0,,Мен міндетті түрде жеңемін
Dialogue: 0,0:09:17.47,0:09:20.18,Default,,0,0,0,,Сондықтан осы ойынды мұқият қарап шығыңыз.
Dialogue: 0,0:09:21.68,0:09:22.89,Default,,0,0,0,,Иттерге қызмет көрсету…
Dialogue: 0,0:09:23.47,0:09:25.56,Default,,0,0,0,,Енді ойынды жалғастырайық!
Dialogue: 0,0:09:25.77,0:09:28.06,Default,,0,0,0,,Ер адам! Екінші шайқас!
Dialogue: 0,0:09:29.06,0:09:31.07,Default,,0,0,0,,Оны қалпына келтіру мүмкін болмайды
Dialogue: 0,0:09:31.32,0:09:34.32,Default,,0,0,0,,Инсуке! Бұл тек мен... Кешіріңіз!
Dialogue: 0,0:09:34.40,0:09:36.95,Default,,0,0,0,,Біз дос болсақ та, біраз тәртіпсіз...
Dialogue: 0,0:09:37.03,0:09:38.03,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:09:38.36,0:09:39.66,Default,,0,0,0,,Барт…
Dialogue: 0,0:09:40.37,0:09:42.58,Default,,0,0,0,,Өзіңді жақсы сезінесің бе, Инуске?
Dialogue: 0,0:09:42.95,0:09:45.75,Default,,0,0,0,,Бейблейд клубына қосылсаңыз, өзіңізді жақсы сезінесіз!
Dialogue: 0,0:09:45.83,0:09:46.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:46.83,0:09:48.42,Default,,0,0,0,,Өте көзге түседі.
Dialogue: 0,0:09:48.50,0:09:50.96,Default,,0,0,0,,Бірге жаттығу қызық болар еді.
Dialogue: 0,0:09:51.04,0:09:52.04,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:09:52.13,0:09:53.67,Default,,0,0,0,,Өйткені сіз...
Dialogue: 0,0:09:54.01,0:09:54.92,Default,,0,0,0,,Ол менің жауым.
Dialogue: 0,0:09:55.01,0:09:56.17,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:09:56.51,0:09:58.51,Default,,0,0,0,,Жау емес
Dialogue: 0,0:09:58.59,0:09:59.64,Default,,0,0,0,,Бұл бәсекелес!
Dialogue: 0,0:10:00.26,0:10:01.39,Default,,0,0,0,,Қарсылас...?
Dialogue: 0,0:10:01.76,0:10:03.72,Default,,0,0,0,,Оның үстіне біз бұрыннан доспыз.
Dialogue: 0,0:10:05.02,0:10:06.48,Default,,0,0,0,,Достар...?
Dialogue: 0,0:10:07.27,0:10:09.48,Default,,0,0,0,,Сен менің досымсың!
Dialogue: 0,0:10:10.06,0:10:12.73,Default,,0,0,0,,Қай жерде болсаңыз да, не істеп жатсаңыз да...
Dialogue: 0,0:10:12.82,0:10:14.61,Default,,0,0,0,,Бұл өзгермейді, эй!
Dialogue: 0,0:10:16.44,0:10:18.99,Default,,0,0,0,,Инсуке, бар күшіңді салып жүр!
Dialogue: 0,0:10:19.07,0:10:20.91,Default,,0,0,0,,Мен қарап тұрмын!
Dialogue: 0,0:10:21.70,0:10:23.87,Default,,0,0,0,,Себебі сен мені бақылап тұрсың...
Dialogue: 0,0:10:24.79,0:10:26.54,Default,,0,0,0,,Мен күресе аламын!
Dialogue: 0,0:10:27.04,0:10:29.17,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:10:29.58,0:10:33.09,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:33.17,0:10:35.55,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:38.38,0:10:40.30,Default,,0,0,0,,Жарайды, бұл жолы істейік!
Dialogue: 0,0:10:40.38,0:10:41.89,Default,,0,0,0,,Жылдамдық артты!
Dialogue: 0,0:10:41.97,0:10:43.47,Default,,0,0,0,,Орталықты ала аласыз!
Dialogue: 0,0:10:45.14,0:10:47.06,Default,,0,0,0,,Жарайды, жақсы өтті!
Dialogue: 0,0:10:47.48,0:10:49.23,Default,,0,0,0,,Шабуыл болжамды болды
Dialogue: 0,0:10:49.60,0:10:51.65,Default,,0,0,0,,Мен көлеңке түсірейін
Dialogue: 0,0:10:51.73,0:10:53.23,Default,,0,0,0,,Жалғыз мүйізге барыңыз
Dialogue: 0,0:10:57.65,0:10:59.61,Default,,0,0,0,,Қазір! Мүйіз ату!
Dialogue: 0,0:11:01.36,0:11:04.45,Default,,0,0,0,,Cerbeus! Бұл тізбекті түсірілім!
Dialogue: 0,0:11:06.58,0:11:12.42,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:11:15.42,0:11:16.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:16.75,0:11:19.22,Default,,0,0,0,,Сербеустың ерекше қозғалысы осында!
Dialogue: 0,0:11:19.38,0:11:20.80,Default,,0,0,0,,Тізбекті ату!
Dialogue: 0,0:11:20.88,0:11:24.43,Default,,0,0,0,,Қабаттар тізбегі қарсыластың шабуылдарын егжей-тегжейлі блоктайды.
Dialogue: 0,0:11:24.51,0:11:26.35,Default,,0,0,0,,Төзімділікті ұрлаңыз!
Dialogue: 0,0:11:26.43,0:11:28.39,Default,,0,0,0,,Жүр!
Dialogue: 0,0:11:34.56,0:11:35.27,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:11:35.40,0:11:38.69,Default,,0,0,0,,Кербеус бір мүйізді итеріп жатыр!
Dialogue: 0,0:11:38.98,0:11:40.69,Default,,0,0,0,,Қорғаныс техникасы тізбекті ату
Dialogue: 0,0:11:40.78,0:11:42.36,Default,,0,0,0,,Мен оны шабуыл ретінде пайдаландым!
Dialogue: 0,0:11:42.45,0:11:44.70,Default,,0,0,0,,Міне, Кербеустың күші!
Dialogue: 0,0:11:44.78,0:11:46.08,Default,,0,0,0,,Жүр!
Dialogue: 0,0:11:46.37,0:11:49.04,Default,,0,0,0,,Тек итеруді жалғастырыңыз!
Dialogue: 0,0:11:49.12,0:11:50.33,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:11:57.71,0:12:00.76,Default,,0,0,0,,Осылай жалғастыра берсек, екеуміз де төбеге жетеміз!
Dialogue: 0,0:12:00.97,0:12:02.34,Default,,0,0,0,,Бұл сауда-саттық болады...
Dialogue: 0,0:12:05.34,0:12:08.10,Default,,0,0,0,,Кербеус Мен саған сенемін!
Dialogue: 0,0:12:11.35,0:12:12.35,Default,,0,0,0,,Не!
Dialogue: 0,0:12:12.44,0:12:14.44,Default,,0,0,0,,Екеуі де ұстады!
Dialogue: 0,0:12:14.52,0:12:16.94,Default,,0,0,0,,Бірақ шығын айтарлықтай болды.
Dialogue: 0,0:12:17.02,0:12:18.86,Default,,0,0,0,,Cerbeus жақсы!
Dialogue: 0,0:12:18.94,0:12:21.86,Default,,0,0,0,,Жүр! жалғыз мүйізді!
Dialogue: 0,0:12:25.66,0:12:27.78,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:12:28.16,0:12:30.66,Default,,0,0,0,,Мүйіз қайтадан атылды!
Dialogue: 0,0:12:32.62,0:12:34.58,Default,,0,0,0,,Жақсы, Укио.
Dialogue: 0,0:12:35.79,0:12:37.17,Default,,0,0,0,,Тек тістеп ал!
Dialogue: 0,0:12:37.25,0:12:38.71,Default,,0,0,0,,Cerbeus!
Dialogue: 0,0:12:38.79,0:12:40.00,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:12:42.34,0:12:45.01,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:12:45.93,0:12:47.05,Default,,0,0,0,,Не...
Dialogue: 0,0:12:47.72,0:12:50.51,Default,,0,0,0,,Кербеус 2 ұпай
Dialogue: 0,0:12:51.10,0:12:54.06,Default,,0,0,0,,Мидорикава Инусукенің жеңген ер адамы!
Dialogue: 0,0:12:54.14,0:12:55.90,Default,,0,0,0,,Жақсы! Мен жеңдім!
Dialogue: 0,0:12:55.98,0:12:57.81,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:12:57.90,0:12:59.36,Default,,0,0,0,,Керемет, Инуске!
Dialogue: 0,0:13:00.82,0:13:03.40,Default,,0,0,0,,Cerbeus Бұл өте күшті болды!
Dialogue: 0,0:13:03.49,0:13:05.03,Default,,0,0,0,,Сіз күткендей, Инуске!
Dialogue: 0,0:13:05.53,0:13:06.91,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:07.11,0:13:08.66,Default,,0,0,0,,Барлығына рахмет
Dialogue: 0,0:13:08.78,0:13:12.66,Default,,0,0,0,,Өйткені бәрі маған шынжырмен ату жаттығуларын жасауға көмектесті...
Dialogue: 0,0:13:12.83,0:13:15.29,Default,,0,0,0,,Сіздің қабілетіңіз!
Dialogue: 0,0:13:15.37,0:13:17.54,Default,,0,0,0,,Ауырды... Балто
Dialogue: 0,0:13:17.88,0:13:21.05,Default,,0,0,0,,Қабаттары шынжырмен жабылған Cerbeus үшін -
Dialogue: 0,0:13:21.13,0:13:23.51,Default,,0,0,0,,Жалғыз мүйіздің шабуылға арналған бір мүйізі бар...
Dialogue: 0,0:13:23.59,0:13:26.59,Default,,0,0,0,,Осыған байланысты зиян одан да ауыр болды.
Dialogue: 0,0:13:27.51,0:13:29.30,Default,,0,0,0,,Мидорикаваның стратегиясы – жеңіс.
Dialogue: 0,0:13:29.60,0:13:33.31,Default,,0,0,0,,Ах... команданың атмосферасы бұрынғы қалпына келді.
Dialogue: 0,0:13:36.10,0:13:37.98,Default,,0,0,0,,Жоғары қара, Укио.
Dialogue: 0,0:13:38.06,0:13:38.98,Default,,0,0,0,,Е...
Dialogue: 0,0:13:39.06,0:13:41.36,Default,,0,0,0,,Жеңілу ұят емес.
Dialogue: 0,0:13:41.69,0:13:44.99,Default,,0,0,0,,Маңыздысы келесі қадамға қалай қосылу керек.
Dialogue: 0,0:13:45.57,0:13:46.65,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:13:47.11,0:13:49.41,Default,,0,0,0,,Дегенмен, қазіргі шайқасқа келетін болсақ...
Dialogue: 0,0:13:49.62,0:13:52.28,Default,,0,0,0,,Мидорикаваның рухы жеңді.
Dialogue: 0,0:13:52.54,0:13:54.29,Default,,0,0,0,,Мен мойындауым керек
Dialogue: 0,0:13:54.66,0:13:56.66,Default,,0,0,0,,Егер сіз самурай болсаңыз, рухыңыздың арқасында жоғалта алмайсыз.
Dialogue: 0,0:13:56.75,0:13:57.83,Default,,0,0,0,,Рұқсат етілмейді
Dialogue: 0,0:13:58.50,0:14:01.25,Default,,0,0,0,,Гюго, мен саған ептілігіңді көрсетейін.
Dialogue: 0,0:14:01.84,0:14:04.51,Default,,0,0,0,,Оны менің Джейгер Юдграсилге қалдырыңыз.
Dialogue: 0,0:14:05.01,0:14:06.92,Default,,0,0,0,,Шақаның оң қолы ретінде
Dialogue: 0,0:14:07.01,0:14:09.80,Default,,0,0,0,,Қалғанының бәрін жеңіп, аяқтаймын!
Dialogue: 0,0:14:09.89,0:14:12.72,Default,,0,0,0,,Жүр, мені де оңаша қалдыр.
Dialogue: 0,0:14:12.81,0:14:15.81,Default,,0,0,0,,Бұл менің жеңілетінімді білдіреді.
Dialogue: 0,0:14:15.89,0:14:17.85,Default,,0,0,0,,Бұл сөздерді орындама!
Dialogue: 0,0:14:17.94,0:14:20.19,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:14:21.31,0:14:23.77,Default,,0,0,0,,Yggdrasil - төзімділік түрі.
Dialogue: 0,0:14:24.32,0:14:26.82,Default,,0,0,0,,Cerbeus қорғаныс түрі үшін...
Dialogue: 0,0:14:26.90,0:14:28.45,Default,,0,0,0,,Бұл қолайсыз қарсылас.
Dialogue: 0,0:14:28.53,0:14:29.95,Default,,0,0,0,,Ал...
Dialogue: 0,0:14:30.03,0:14:32.24,Default,,0,0,0,,Арнайы материал ПОМ...
Dialogue: 0,0:14:32.32,0:14:34.20,Default,,0,0,0,,Super Tay…
Dialogue: 0,0:14:34.29,0:14:35.91,Default,,0,0,0,,Өте төмен Масацуно-
Dialogue: 0,0:14:36.00,0:14:38.37,Default,,0,0,0,,Жеңіл жүргізуші бар
Dialogue: 0,0:14:38.71,0:14:39.83,Default,,0,0,0,,Барт
Dialogue: 0,0:14:40.08,0:14:43.04,Default,,0,0,0,,Соңғы рет соғысқанда қандай сезімде болдыңыз?
Dialogue: 0,0:14:43.13,0:14:44.63,Default,,0,0,0,,Ия... және...
Dialogue: 0,0:14:46.05,0:14:48.17,Default,,0,0,0,,Әйтеуір Рейги дұрыс айтты.
Dialogue: 0,0:14:48.51,0:14:50.76,Default,,0,0,0,,Немесе соған ұқсас нәрсе.
Dialogue: 0,0:14:50.84,0:14:54.35,Default,,0,0,0,,Inusuke үшін пайдалы ақпарат бар ма?
Dialogue: 0,0:14:54.43,0:14:56.18,Default,,0,0,0,,Пайдалы заттар…
Dialogue: 0,0:14:58.23,0:14:59.48,Default,,0,0,0,,Сіздің қозғалыстарыңыз-
Dialogue: 0,0:14:59.56,0:15:00.69,Default,,0,0,0,,Мен бәрінен бас тарттым!
Dialogue: 0,0:15:01.94,0:15:04.98,Default,,0,0,0,,Ол... Валькиридің қимылдарын оқып отырды.
Dialogue: 0,0:15:05.11,0:15:07.78,Default,,0,0,0,,Бәлкім, Юго мұндай нәрсеге шебер шығар.
Dialogue: 0,0:15:07.99,0:15:10.15,Default,,0,0,0,,Бірақ мен оны ұрдым.
Dialogue: 0,0:15:10.53,0:15:12.24,Default,,0,0,0,,Шынайы жарқылмен түсіру
Dialogue: 0,0:15:16.74,0:15:18.12,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:15:18.70,0:15:21.50,Default,,0,0,0,,Юго Балтодан жеңілген кездегідей емес.
Dialogue: 0,0:15:21.92,0:15:23.96,Default,,0,0,0,,Ол одан да күштірек болуы керек.
Dialogue: 0,0:15:24.25,0:15:27.63,Default,,0,0,0,,Пайдалы ештеңе айта алмаймыз.
Dialogue: 0,0:15:27.71,0:15:28.67,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:15:28.76,0:15:30.26,Default,,0,0,0,,Иә, жақсы!
Dialogue: 0,0:15:30.47,0:15:32.26,Default,,0,0,0,,Ер адам! 4-ойын
Dialogue: 0,0:15:32.34,0:15:34.39,Default,,0,0,0,,№3 Инсуке Мидорикава қарсы.
Dialogue: 0,0:15:34.47,0:15:36.81,Default,,0,0,0,,№2 Нансуи Юго
Dialogue: 0,0:15:37.60,0:15:38.93,Default,,0,0,0,,Yggdrasil бұл-
Dialogue: 0,0:15:39.02,0:15:41.48,Default,,0,0,0,,Бұл ұзақ шайқас болатынына сенімдімін.
Dialogue: 0,0:15:41.56,0:15:44.31,Default,,0,0,0,,Онда мен оны бастаймын!
Dialogue: 0,0:15:49.15,0:15:51.49,Default,,0,0,0,,Югоның рәсімі басталды
Dialogue: 0,0:15:51.74,0:15:53.45,Default,,0,0,0,,Рухани бірлік...
Dialogue: 0,0:15:53.70,0:15:55.07,Default,,0,0,0,,Мұны істеу арқылы-
Dialogue: 0,0:15:55.16,0:15:57.49,Default,,0,0,0,,Мен қарсыластың мінез-құлқын оқуға тырысамын.
Dialogue: 0,0:15:58.08,0:16:01.50,Default,,0,0,0,,Адамдардың не ойлайтыны әрқашан шығады
Dialogue: 0,0:16:01.87,0:16:03.25,Default,,0,0,0,,Оны тап-
Dialogue: 0,0:16:03.33,0:16:04.63,Default,,0,0,0,,Қарсыласыңызды басқарыңыз!
Dialogue: 0,0:16:06.04,0:16:07.29,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:16:12.72,0:16:14.68,Default,,0,0,0,,Еріндері қатты қысылған...
Dialogue: 0,0:16:15.55,0:16:18.22,Default,,0,0,0,,Мен түйілген жұдырығымдағы кернеуді көріп тұрмын.
Dialogue: 0,0:16:18.93,0:16:21.10,Default,,0,0,0,,Аяғымда да күш бар.
Dialogue: 0,0:16:21.56,0:16:22.98,Default,,0,0,0,,Шабуыл жасау...
Dialogue: 0,0:16:23.14,0:16:23.98,Default,,0,0,0,,Сонда!
Dialogue: 0,0:16:24.31,0:16:26.44,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:16:26.52,0:16:29.57,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:29.65,0:16:31.82,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:34.24,0:16:36.24,Default,,0,0,0,,Жүр! Cerbeus!
Dialogue: 0,0:16:36.32,0:16:39.08,Default,,0,0,0,,Білсең қашу оңай!
Dialogue: 0,0:16:40.91,0:16:41.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:41.91,0:16:43.62,Default,,0,0,0,,Күткендей менің қимылдарым оқылды.
Dialogue: 0,0:16:46.21,0:16:48.63,Default,,0,0,0,,Бұл қозғалыс күтілді!
Dialogue: 0,0:16:53.84,0:16:54.88,Default,,0,0,0,,Не!
Dialogue: 0,0:16:54.97,0:16:57.34,Default,,0,0,0,,Жүр! Cerbeus!
Dialogue: 0,0:17:02.27,0:17:04.18,Default,,0,0,0,,Қорғаныс түрі Cerbeus...
Dialogue: 0,0:17:04.27,0:17:05.81,Default,,0,0,0,,Мен шабуылға шығуға батылым бардым!
Dialogue: 0,0:17:05.89,0:17:07.65,Default,,0,0,0,,Жаныңды бермей осында келдің!
Dialogue: 0,0:17:07.73,0:17:09.73,Default,,0,0,0,,Ауыр пресс жүргізушісі...
Dialogue: 0,0:17:09.81,0:17:11.73,Default,,0,0,0,,Бұл стадионды жеп жатыр!
Dialogue: 0,0:17:11.82,0:17:13.49,Default,,0,0,0,,Бұл керемет, Инуске!
Dialogue: 0,0:17:13.57,0:17:15.65,Default,,0,0,0,,Тек шабуылды жалғастырыңыз!
Dialogue: 0,0:17:15.74,0:17:17.66,Default,,0,0,0,,Төзімділігім жоғалса да...
Dialogue: 0,0:17:17.74,0:17:19.41,Default,,0,0,0,,Мен бірден шабуылға шығуды көздеп отырмын.
Dialogue: 0,0:17:19.49,0:17:21.74,Default,,0,0,0,,Кербеус, шабуыл!
Dialogue: 0,0:17:23.95,0:17:25.96,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:17:26.04,0:17:27.96,Default,,0,0,0,,Таэро! Yggdrasil!
Dialogue: 0,0:17:29.84,0:17:32.00,Default,,0,0,0,,Секір!
Dialogue: 0,0:17:34.63,0:17:35.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:35.51,0:17:36.68,Default,,0,0,0,,Тэкита!
Dialogue: 0,0:17:36.76,0:17:38.30,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:38.39,0:17:40.18,Default,,0,0,0,,Мен нәтижені көрдім.
Dialogue: 0,0:17:40.30,0:17:41.72,Default,,0,0,0,,Ағымдағы шабуылмен-
Dialogue: 0,0:17:41.81,0:17:43.85,Default,,0,0,0,,Cerbeus шыдамдылығын жоғалтады
Dialogue: 0,0:17:50.36,0:17:51.65,Default,,0,0,0,,А...
Dialogue: 0,0:17:51.73,0:17:54.78,Default,,0,0,0,,Айналдыру аяқталуы Yggdrasil-ге 1 ұпай береді!
Dialogue: 0,0:17:54.86,0:17:55.57,Default,,0,0,0,,Еркек!
Dialogue: 0,0:17:55.99,0:17:56.78,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:59.11,0:18:00.45,Default,,0,0,0,,Иттерге қызмет көрсету…
Dialogue: 0,0:18:00.53,0:18:02.24,Default,,0,0,0,,Жарайды ма деп ойлаймын...
Dialogue: 0,0:18:02.99,0:18:05.29,Default,,0,0,0,,Инсуке Керемет емес пе!
Dialogue: 0,0:18:06.46,0:18:10.25,Default,,0,0,0,,Қорғаныс түрі Cerbeus бір уақытта қалай шабуыл жасай алады?
Dialogue: 0,0:18:10.33,0:18:12.21,Default,,0,0,0,,Бұл өте ауыр болды.
Dialogue: 0,0:18:12.29,0:18:14.88,Default,,0,0,0,,Мен қатты толқыдым!
Dialogue: 0,0:18:14.96,0:18:15.96,Default,,0,0,0,,Барт…
Dialogue: 0,0:18:16.30,0:18:18.97,Default,,0,0,0,,Ағымдағы шабуыл әрекетсіз!
Dialogue: 0,0:18:19.05,0:18:21.72,Default,,0,0,0,,Ей, сен сол шайқаста күресе алдың.
Dialogue: 0,0:18:21.80,0:18:23.60,Default,,0,0,0,,Бұл келесі шайқас.
Dialogue: 0,0:18:24.01,0:18:25.39,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:18:25.47,0:18:28.19,Default,,0,0,0,,Мен екінші шайқаста міндетті түрде жеңемін!
Dialogue: 0,0:18:28.27,0:18:29.39,Default,,0,0,0,,О!
Dialogue: 0,0:18:30.19,0:18:32.48,Default,,0,0,0,,Ер адам! Екінші шайқас!
Dialogue: 0,0:18:34.78,0:18:37.44,Default,,0,0,0,,Барлығы бірге күреседі.
Dialogue: 0,0:18:37.57,0:18:38.95,Default,,0,0,0,,Бұл сезім-
Dialogue: 0,0:18:39.03,0:18:41.03,Default,,0,0,0,,Мен міндетті түрде жауап беремін!
Dialogue: 0,0:18:43.53,0:18:46.45,Default,,0,0,0,,Мен Кербеустың шабуыл жасайтынын білсем де...
Dialogue: 0,0:18:46.54,0:18:48.66,Default,,0,0,0,,Мен шегіне дейін итермеледім...
Dialogue: 0,0:18:48.91,0:18:51.50,Default,,0,0,0,,Ұпайлар алынып тасталса, таң қалмас еді.
Dialogue: 0,0:18:51.71,0:18:53.42,Default,,0,0,0,,Югоның жігіті
Dialogue: 0,0:18:53.54,0:18:55.59,Default,,0,0,0,,Керісінше, мен бұрышта қалдым.
Dialogue: 0,0:18:55.88,0:18:58.42,Default,,0,0,0,,Ол жаттығып жүрген болуы керек...
Dialogue: 0,0:18:58.88,0:19:00.76,Default,,0,0,0,,Басқа адамға қараңыз
Dialogue: 0,0:19:04.14,0:19:05.97,Default,,0,0,0,,Бірінші шайқас сияқты
Dialogue: 0,0:19:06.64,0:19:08.10,Default,,0,0,0,,Қайтадан шабуыл
Dialogue: 0,0:19:08.85,0:19:09.73,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:19:09.94,0:19:11.98,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:19:12.06,0:19:15.61,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:15.69,0:19:18.11,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:21.28,0:19:23.95,Default,,0,0,0,,Мен ұшырғышты теңестіріп, атып жібердім!
Dialogue: 0,0:19:24.03,0:19:26.37,Default,,0,0,0,,Бұл менің сүйікті қорғаныс стилім!
Dialogue: 0,0:19:26.74,0:19:29.29,Default,,0,0,0,,Инуске, сен...
Dialogue: 0,0:19:29.54,0:19:33.08,Default,,0,0,0,,Cerbeus Валькиридің шабуылына тосқауыл қоюда!
Dialogue: 0,0:19:33.17,0:19:35.67,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:37.46,0:19:39.84,Default,,0,0,0,,Менімен алғаш ұрысқан кездегідей...
Dialogue: 0,0:19:40.17,0:19:42.55,Default,,0,0,0,,Жоқ, күштірек!
Dialogue: 0,0:19:42.97,0:19:46.43,Default,,0,0,0,,Қайзер Кербеус осылайша шайқасады!
Dialogue: 0,0:19:46.60,0:19:50.64,Default,,0,0,0,,Енді ойлануға болмайды! Тізбек ату!
Dialogue: 0,0:19:50.73,0:19:52.85,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:19:57.44,0:20:00.40,Default,,0,0,0,,Қорғаныс тізбегі қарсыласқа зақым келтіруде!
Dialogue: 0,0:20:05.82,0:20:07.16,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:20:08.12,0:20:09.24,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:20:10.16,0:20:11.08,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:11.16,0:20:13.33,Default,,0,0,0,,Сербеус жарылған аяқтау
Dialogue: 0,0:20:13.42,0:20:14.63,Default,,0,0,0,,2 ұпай
Dialogue: 0,0:20:14.71,0:20:17.84,Default,,0,0,0,,Мидорикава Инускэнің жеңісі ер адам!
Dialogue: 0,0:20:17.92,0:20:20.21,Default,,0,0,0,,Иә! (Рантаро) Мен жасадым!
Dialogue: 0,0:20:20.30,0:20:21.34,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:21.42,0:20:22.67,Default,,0,0,0,,Э-э, не істеп жатырсыз, мырза?
Dialogue: 0,0:20:22.76,0:20:24.64,Default,,0,0,0,,Инсуке керемет!
Dialogue: 0,0:20:24.72,0:20:27.05,Default,,0,0,0,,Дегенмен, заттары көп екен.
Dialogue: 0,0:20:27.97,0:20:30.43,Default,,0,0,0,,Кайзер Сербеус керемет болды
Dialogue: 0,0:20:32.98,0:20:36.44,Default,,0,0,0,,Мидорикава шабуылда тізбекті соққыны қолданды.
Dialogue: 0,0:20:36.52,0:20:38.44,Default,,0,0,0,,Мен мұны оқи алмадым...
Dialogue: 0,0:20:38.52,0:20:39.94,Default,,0,0,0,,Югоның жеңілу себебі
Dialogue: 0,0:20:40.03,0:20:41.53,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:20:41.65,0:20:43.28,Default,,0,0,0,,О, бұл керемет болды!
Dialogue: 0,0:20:43.61,0:20:46.37,Default,,0,0,0,,Балто Кумичо Дина…
Dialogue: 0,0:20:46.45,0:20:49.08,Default,,0,0,0,,Себебі мені бәрі қолдады...
Dialogue: 0,0:20:49.91,0:20:50.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:51.04,0:20:52.12,Default,,0,0,0,,Бұл субтитрлер JOJO's Bizarre Adventure форумы, Yuhari Subtitles және Gods Subtitles Group бірлесіп дайындады
Dialogue: 0,0:20:53.00,0:20:54.46,Default,,0,0,0,,Бұл менмін...
Dialogue: 0,0:20:54.71,0:20:55.79,Default,,0,0,0,,Кен-
Dialogue: 0,0:20:56.00,0:20:59.00,Default,,0,0,0,,Сенімен алғаш кездескен кез есіме түсті.
Dialogue: 0,0:20:59.88,0:21:01.67,Default,,0,0,0,,Токонацу Ника
Dialogue: 0,0:21:01.76,0:21:03.01,Default,,0,0,0,,Не?
Dialogue: 0,0:21:03.09,0:21:05.30,Default,,0,0,0,,Мен толқыдым ба?
Dialogue: 0,0:21:06.84,0:21:08.35,Default,,0,0,0,,Бакайару
Dialogue: 0,0:21:08.47,0:21:10.22,Default,,0,0,0,,Практика!
Dialogue: 0,0:21:10.35,0:21:12.18,Default,,0,0,0,,Жаттығу!
Dialogue: 0,0:21:12.27,0:21:13.64,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:21:13.73,0:21:15.64,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:15.94,0:21:16.85,Default,,0,0,0,,Уау
Dialogue: 0,0:21:16.94,0:21:18.52,Default,,0,0,0,,Келл! Бет!
Dialogue: 0,0:21:18.61,0:21:20.82,Default,,0,0,0,,Батырдың ығысып кеткені жақсы емес.
Dialogue: 0,0:21:20.90,0:21:23.36,Default,,0,0,0,,Батыр болсаң, тұр!
Dialogue: 0,0:21:23.44,0:21:25.11,Default,,0,0,0,,О! Иә
Dialogue: 0,0:21:25.20,0:21:25.99,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:21:26.07,0:21:27.53,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:21:27.61,0:21:29.03,Default,,0,0,0,,Мықты болыңыз~
Dialogue: 0,0:21:29.70,0:21:30.53,Default,,0,0,0,,Инсуке
Dialogue: 0,0:21:30.70,0:21:33.87,Default,,0,0,0,,Сіз мені көптен бері таз етіп жүрсіз.
Dialogue: 0,0:21:34.71,0:21:35.91,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:21:36.16,0:21:37.04,Default,,0,0,0,,Иә
Dialogue: 0,0:21:37.12,0:21:39.67,Default,,0,0,0,,Мен қазір сенімен шайқаспақпын!
Dialogue: 0,0:21:40.00,0:21:42.25,Default,,0,0,0,,Керемет, шайқасайық!
Dialogue: 0,0:21:43.55,0:21:45.76,Default,,0,0,0,,Ләззат менікі.
Dialogue: 0,0:21:45.84,0:21:46.84,Default,,0,0,0,,Шака…
Dialogue: 0,0:21:47.26,0:21:49.76,Default,,0,0,0,,Ақыры менің кезегім де келді.
Dialogue: 0,0:21:49.85,0:21:54.77,Default,,0,0,0,,Гухахаха...гахахахаха
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Артынан қуып жетсең көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.44,0:23:29.19,Default,,0,0,0,,Бұл шынымен де соңғы рет пе?
Dialogue: 0,0:23:29.28,0:23:31.15,Default,,0,0,0,,Инусуке мен Кербеус арасындағы шайқас
Dialogue: 0,0:23:31.24,0:23:33.07,Default,,0,0,0,,Мен оны көзіме оттаймын!
Dialogue: 0,0:23:33.16,0:23:36.37,Default,,0,0,0,,Мен шайқастарымда Инускенің көзін оттаймын!
Dialogue: 0,0:23:36.87,0:23:39.58,Default,,0,0,0,,Бірақ Валькири біртүрлі әрекет етеді...
Dialogue: 0,0:23:39.66,0:23:42.21,Default,,0,0,0,,Сәлем досым! Не болды!
Dialogue: 0,0:23:42.71,0:23:44.75,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.84,0:23:46.04,Default,,0,0,0,,Достық шайқасы!
Dialogue: 0,0:23:46.34,0:23:48.05,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.34,0:23:49.76,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.26,0:23:57.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory