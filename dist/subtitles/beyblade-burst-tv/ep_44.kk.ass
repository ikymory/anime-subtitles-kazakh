Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.63,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.23,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.31,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.86,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.86,0:00:35.24,Default,,0,0,0,,Шу мен Уақия командалық шайқаста бірге соғысқан...
Dialogue: 0,0:00:35.32,0:00:37.28,Default,,0,0,0,,Бей клубынан шықты
Dialogue: 0,0:00:37.45,0:00:40.37,Default,,0,0,0,,Бірақ бұл жеке шайқас, солай ма?
Dialogue: 0,0:00:41.45,0:00:43.37,Default,,0,0,0,,Менің екінші раундтағы қарсыласым
Dialogue: 0,0:00:43.46,0:00:46.50,Default,,0,0,0,,Quad Quetzalcatl пайдаланыңыз Бұл сары-жасыл Квон.
Dialogue: 0,0:00:46.58,0:00:48.71,Default,,0,0,0,,Осы қызу және қызу шайқаста
Dialogue: 0,0:00:48.79,0:00:51.05,Default,,0,0,0,,Валькири ақыры оянып кетті
Dialogue: 0,0:00:54.09,0:00:56.47,Default,,0,0,0,,Реактивті ату!
Dialogue: 0,0:00:59.01,0:01:02.81,Default,,0,0,0,,Және супер ояну арқылы жасалған жаңа ерекше қозғалыс
Dialogue: 0,0:01:02.89,0:01:04.93,Default,,0,0,0,,Аты - Jet Shoot!
Dialogue: 0,0:01:05.23,0:01:06.77,Default,,0,0,0,,Бұл керемет, досым!
Dialogue: 0,0:01:06.85,0:01:09.31,Default,,0,0,0,,Енді біз үшінші турдан өте аламыз!
Dialogue: 0,0:01:17.78,0:01:20.16,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:20.49,0:01:25.66,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:36.97,0:01:40.35,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:40.85,0:01:42.97,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:43.39,0:01:47.52,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:47.64,0:01:50.86,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:50.98,0:01:57.40,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:57.70,0:02:02.12,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:02.62,0:02:08.04,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:08.16,0:02:10.42,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:10.50,0:02:15.21,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:15.38,0:02:20.47,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:20.76,0:02:23.01,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:23.22,0:02:25.56,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:25.85,0:02:29.77,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:29.94,0:02:34.94,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:35.15,0:02:37.32,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:41.41,0:02:43.91,Default,,0,0,0,,Барк! Жануарлар шайқасы!
Dialogue: 0,0:03:00.59,0:03:02.05,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:02.14,0:03:04.51,Default,,0,0,0,,Күткендей, Йотенко мықты.
Dialogue: 0,0:03:04.60,0:03:06.51,Default,,0,0,0,,Бір ғана қалды
Dialogue: 0,0:03:06.60,0:03:09.10,Default,,0,0,0,,Барт та осы уақытқа дейін тұра алды.
Dialogue: 0,0:03:09.18,0:03:11.73,Default,,0,0,0,,Хмм, мен кереметпін бе?
Dialogue: 0,0:03:11.81,0:03:14.11,Default,,0,0,0,,Алып кетпе, ағайын.
Dialogue: 0,0:03:14.19,0:03:16.61,Default,,0,0,0,,Күшті жаулар ғана қалды!
Dialogue: 0,0:03:16.69,0:03:19.07,Default,,0,0,0,,Иә! Тек күшті жаулар!
Dialogue: 0,0:03:19.15,0:03:20.95,Default,,0,0,0,,Тез шайқас~
Dialogue: 0,0:03:22.20,0:03:25.66,Default,,0,0,0,,Бал-нии, бұл кездесу де назар аударарлық карта.
Dialogue: 0,0:03:25.87,0:03:28.49,Default,,0,0,0,,Түсіндім, Инусуке Азуки Бенге қарсы
Dialogue: 0,0:03:28.58,0:03:30.37,Default,,0,0,0,,Олар Аңдардың достары.
Dialogue: 0,0:03:30.66,0:03:32.87,Default,,0,0,0,,Біз дос емеспіз, жаумыз!
Dialogue: 0,0:03:33.21,0:03:35.13,Default,,0,0,0,,Әй, сен олай айтпайсың ба?
Dialogue: 0,0:03:35.21,0:03:37.38,Default,,0,0,0,,Мені «жау» деуге қалай дәтің бар?
Dialogue: 0,0:03:37.71,0:03:39.09,Default,,0,0,0,,Басқа адамға ұқсайды
Dialogue: 0,0:03:39.17,0:03:40.59,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:03:40.67,0:03:43.01,Default,,0,0,0,,Жарайды, Уақия да солай деді.
Dialogue: 0,0:03:43.51,0:03:45.89,Default,,0,0,0,,Оны басында Инуске айтты.
Dialogue: 0,0:03:46.43,0:03:47.81,Default,,0,0,0,,Командалық жарыстар кезінде...
Dialogue: 0,0:03:48.22,0:03:51.10,Default,,0,0,0,,Балто мен сені құртамын.
Dialogue: 0,0:03:51.68,0:03:53.69,Default,,0,0,0,,Мен басқа командада болсам да...
Dialogue: 0,0:03:53.77,0:03:56.48,Default,,0,0,0,,Достарым бір-бірімен соқтығысады деп қатты қуандым, бірақ...
Dialogue: 0,0:03:57.32,0:03:58.90,Default,,0,0,0,,Инуске басқаша болды.
Dialogue: 0,0:03:59.11,0:04:02.78,Default,,0,0,0,,Ол кезде Ынускенің өте өткір болғаны рас.
Dialogue: 0,0:04:02.86,0:04:05.45,Default,,0,0,0,,Аңдар жабайы аң дегенді білдіреді ме?
Dialogue: 0,0:04:05.53,0:04:08.24,Default,,0,0,0,,Мен саған қарап тұрғандай болдым.
Dialogue: 0,0:04:08.33,0:04:12.21,Default,,0,0,0,,Сонда Азуки Бен көбірек аң болды, солай ма?
Dialogue: 0,0:04:12.29,0:04:15.00,Default,,0,0,0,,Кууууууууу асығыңыз және қараңыз!
Dialogue: 0,0:04:15.08,0:04:16.63,Default,,0,0,0,,Инсуке Бенге қарсы!
Dialogue: 0,0:04:18.42,0:04:19.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:19.80,0:04:21.38,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:04:21.46,0:04:24.05,Default,,0,0,0,,Жарайсыңдар! Мен тағы да жеңемін!
Dialogue: 0,0:04:24.13,0:04:25.59,Default,,0,0,0,,Келесі ойын!
Dialogue: 0,0:04:25.93,0:04:27.55,Default,,0,0,0,,Бір дем алайық
Dialogue: 0,0:04:27.64,0:04:29.10,Default,,0,0,0,,Жеті рет қатарынан...
Dialogue: 0,0:04:29.18,0:04:32.02,Default,,0,0,0,,Бұл жоғалту, жоғалту, жоғалту дауылы!
Dialogue: 0,0:04:32.48,0:04:35.02,Default,,0,0,0,,Өтінемін~Райта~
Dialogue: 0,0:04:35.10,0:04:38.06,Default,,0,0,0,,Мен сенің жанып тұрғаныңды білемін.
Dialogue: 0,0:04:38.15,0:04:40.57,Default,,0,0,0,,Өзіңізді одан да қатты итеріңіз
Dialogue: 0,0:04:40.65,0:04:41.94,Default,,0,0,0,,Басқа адам - Бен.
Dialogue: 0,0:04:42.03,0:04:43.61,Default,,0,0,0,,Егер сіз іс жүзінде осыншама жоғалтсаңыз...
Dialogue: 0,0:04:43.70,0:04:45.49,Default,,0,0,0,,Мен нағыз матчта жеңіске жететіндей сезінемін.
Dialogue: 0,0:04:45.70,0:04:47.37,Default,,0,0,0,,Бұл қандай логика?
Dialogue: 0,0:04:47.66,0:04:50.12,Default,,0,0,0,,Мен Бенге ешқашан жеңілгім келмейді.
Dialogue: 0,0:04:50.41,0:04:52.08,Default,,0,0,0,,Ыстық, Инуске!
Dialogue: 0,0:04:52.41,0:04:54.87,Default,,0,0,0,,Бен мені таныды.
Dialogue: 0,0:04:55.33,0:04:56.75,Default,,0,0,0,,Бәсекелес ретінде!
Dialogue: 0,0:04:57.04,0:04:58.67,Default,,0,0,0,,Қарсылас...
Dialogue: 0,0:04:59.96,0:05:02.46,Default,,0,0,0,,Ал, Beasts, сіз және капитан.
Dialogue: 0,0:05:02.55,0:05:04.22,Default,,0,0,0,,Сіз әрқашан жақсы күресетінсіз.
Dialogue: 0,0:05:04.30,0:05:07.01,Default,,0,0,0,,Бен Мен оның дәл қазір жаттығу жасап жатқанына сенімдімін.
Dialogue: 0,0:05:07.09,0:05:08.85,Default,,0,0,0,,Менің де жеңілгім келмейді
Dialogue: 0,0:05:10.01,0:05:12.56,Default,,0,0,0,,Міне, Аңдардың рухы.
Dialogue: 0,0:05:15.89,0:05:18.48,Default,,0,0,0,,Тыныш шайқас...
Dialogue: 0,0:05:18.69,0:05:19.81,Default,,0,0,0,,Говасу
Dialogue: 0,0:05:20.90,0:05:22.03,Default,,0,0,0,,О
Dialogue: 0,0:05:23.32,0:05:25.03,Default,,0,0,0,,Жануардың жаны?
Dialogue: 0,0:05:25.11,0:05:26.53,Default,,0,0,0,,Капитан осылай деді ме?
Dialogue: 0,0:05:26.78,0:05:30.62,Default,,0,0,0,,Менімен келесі матчта кездесесің деп шешілгенде...
Dialogue: 0,0:05:35.96,0:05:38.88,Default,,0,0,0,,Маған хайуан жаныңды көрсет
Dialogue: 0,0:05:38.96,0:05:40.71,Default,,0,0,0,,Жануар рухы…
Dialogue: 0,0:05:40.79,0:05:43.42,Default,,0,0,0,,Иә! Менде де Аңдар рухы бар
Dialogue: 0,0:05:43.76,0:05:44.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:47.01,0:05:50.47,Default,,0,0,0,,Соны естігенде мен қатты қуандым.
Dialogue: 0,0:05:50.55,0:05:52.14,Default,,0,0,0,,Бұл шайқаста жеңіңіз
Dialogue: 0,0:05:52.22,0:05:54.89,Default,,0,0,0,,Бен менің қазір қаншалықты күшті екенімді көрсін.
Dialogue: 0,0:05:55.14,0:05:59.23,Default,,0,0,0,,Ал, капитан сені «Аңдарға» шақырды.
Dialogue: 0,0:05:59.56,0:06:02.94,Default,,0,0,0,,Иә, бұл екі рет болды.
Dialogue: 0,0:06:03.02,0:06:06.15,Default,,0,0,0,,Дос табу қиын, өйткені мен қозғала беремін...
Dialogue: 0,0:06:06.24,0:06:08.78,Default,,0,0,0,,Маған қосылғаныңызға қуаныштымын.
Dialogue: 0,0:06:08.86,0:06:10.45,Default,,0,0,0,,Бұл капитан ба?
Dialogue: 0,0:06:10.53,0:06:11.74,Default,,0,0,0,,Тағы бір адам
Dialogue: 0,0:06:11.82,0:06:13.95,Default,,0,0,0,,Бұл Йонекома академиясынан Барто Аои!
Dialogue: 0,0:06:15.04,0:06:17.41,Default,,0,0,0,,А, бұл сен қашан болдың?
Dialogue: 0,0:06:17.50,0:06:20.17,Default,,0,0,0,,Балт Аои мен капитан бір-біріне ұқсайды дедіңіз бе?
Dialogue: 0,0:06:20.25,0:06:21.58,Default,,0,0,0,,Балт пен Бен-
Dialogue: 0,0:06:21.67,0:06:24.05,Default,,0,0,0,,Ол мен үшін өте маңызды дос.
Dialogue: 0,0:06:24.50,0:06:26.88,Default,,0,0,0,,Сонымен, осы екі қарсыласты жеңу...
Dialogue: 0,0:06:26.96,0:06:30.47,Default,,0,0,0,,Маған қоңырау шалғаныңыз үшін рахмет айтамын...
Dialogue: 0,0:06:32.18,0:06:34.89,Default,,0,0,0,,Бұл төрт он патша сіздің қарсыласыңыз дегенді білдірмейді ме?
Dialogue: 0,0:06:34.97,0:06:36.72,Default,,0,0,0,,Осыншама көп жаттығу жасамасаңыз да...
Dialogue: 0,0:06:37.10,0:06:37.89,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:38.14,0:06:40.39,Default,,0,0,0,,Бұл тым ақсақ.
Dialogue: 0,0:06:40.48,0:06:41.23,Default,,0,0,0,,О
Dialogue: 0,0:06:41.31,0:06:42.56,Default,,0,0,0,,Өйткені бұл Инсуке.
Dialogue: 0,0:06:42.65,0:06:44.82,Default,,0,0,0,,Капитан да байсалды.
Dialogue: 0,0:06:45.36,0:06:46.98,Default,,0,0,0,,Ах! ...хех
Dialogue: 0,0:06:47.69,0:06:51.86,Default,,0,0,0,,Жарайды! WBBA ұлттық турнирінің жеке матчы!
Dialogue: 0,0:06:51.95,0:06:53.95,Default,,0,0,0,,Бүгінгі күні де құмарлықтардың арасындағы шайқас
Dialogue: 0,0:06:54.03,0:06:55.28,Default,,0,0,0,,Үміттенейік!
Dialogue: 0,0:06:55.37,0:06:58.20,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:58.54,0:07:02.29,Default,,0,0,0,,2 раунд Күннің бірінші шайқасы осы екеуімен!
Dialogue: 0,0:07:02.38,0:07:05.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:06.42,0:07:09.55,Default,,0,0,0,,Қызыл бұрыш Үш басты ит күресуші!
Dialogue: 0,0:07:09.88,0:07:11.76,Default,,0,0,0,,Инсуке Мидорикава!
Dialogue: 0,0:07:11.84,0:07:13.59,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:13.68,0:07:16.72,Default,,0,0,0,,Көк бұрыштағы қатыгез аңшы
Dialogue: 0,0:07:16.81,0:07:18.35,Default,,0,0,0,,Азуки Бен!
Dialogue: 0,0:07:18.43,0:07:20.35,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:20.44,0:07:23.06,Default,,0,0,0,,Кешегі дос – бүгінгі жау
Dialogue: 0,0:07:23.15,0:07:25.90,Default,,0,0,0,,Бірін-бірі жақсы тани отырып, жүзшілер арасындағы тартыс та...
Dialogue: 0,0:07:25.98,0:07:28.03,Default,,0,0,0,,Бұл жеке шайқастың Дайго дәмі!
Dialogue: 0,0:07:28.36,0:07:30.53,Default,,0,0,0,,Әй, жүрегім лүпілдеп тұр!
Dialogue: 0,0:07:30.61,0:07:33.36,Default,,0,0,0,,Бегемот хайуан - айбатты жау.
Dialogue: 0,0:07:33.45,0:07:34.28,Default,,0,0,0,,Инсуке!
Dialogue: 0,0:07:34.78,0:07:36.49,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе!
Dialogue: 0,0:07:37.29,0:07:38.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.54,0:07:40.71,Default,,0,0,0,,Мен саған жыртқыш рухты көрсетемін!
Dialogue: 0,0:07:41.96,0:07:42.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:43.62,0:07:44.96,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:07:46.42,0:07:47.34,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:47.55,0:07:51.30,Default,,0,0,0,,Ой, Инусуке Мидорикаваның ату формасына назар аударыңыз!
Dialogue: 0,0:07:51.38,0:07:54.26,Default,,0,0,0,,Сіз осы биіктіктен атуды жоспарлап отырсыз ба?
Dialogue: 0,0:07:54.59,0:07:56.93,Default,,0,0,0,,Мен мұндай пішінді ешқашан көрген емеспін!
Dialogue: 0,0:07:57.26,0:07:58.97,Default,,0,0,0,,Тіпті Бен таң қалды.
Dialogue: 0,0:07:59.06,0:08:00.81,Default,,0,0,0,,Сіз бұл пішінді бірінші рет пайдаланып отырсыз ба?
Dialogue: 0,0:08:00.89,0:08:03.39,Default,,0,0,0,,Қызық, бұл қандай стратегия?
Dialogue: 0,0:08:03.60,0:08:05.69,Default,,0,0,0,,Неге бұл затты сүртіп жатырсың?
Dialogue: 0,0:08:05.77,0:08:07.27,Default,,0,0,0,,Капитан шаралары?
Dialogue: 0,0:08:07.36,0:08:09.40,Default,,0,0,0,,Мен мұны әртүрлі нәрселерді сынап көргеннен кейін жасай алдым.
Dialogue: 0,0:08:09.73,0:08:13.11,Default,,0,0,0,,Бегемотқа қарсы Инсукенің Киба Тайы!
Dialogue: 0,0:08:13.70,0:08:15.28,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:08:15.49,0:08:18.87,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:18.95,0:08:21.33,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:23.16,0:08:24.83,Default,,0,0,0,,Қандай Кербеус!
Dialogue: 0,0:08:24.92,0:08:28.09,Default,,0,0,0,,Сергітетін серпіліспен ол бірден Бегемотқа жақындады!
Dialogue: 0,0:08:28.29,0:08:30.46,Default,,0,0,0,,Сербеусты сипап өт!
Dialogue: 0,0:08:30.80,0:08:33.55,Default,,0,0,0,,Ах! Бегемотты тістеп ал!
Dialogue: 0,0:08:38.01,0:08:40.56,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:08:41.10,0:08:43.60,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:08:47.94,0:08:49.57,Default,,0,0,0,,(айқай)
Dialogue: 0,0:08:57.74,0:08:58.66,Default,,0,0,0,,Ах...!
Dialogue: 0,0:08:58.74,0:09:00.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:00.28,0:09:02.25,Default,,0,0,0,,Шынайы ма? Өте жылдам шабуыл!
Dialogue: 0,0:09:02.50,0:09:03.87,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:09:03.96,0:09:06.17,Default,,0,0,0,,Бегемот хайуан 2 ұпай
Dialogue: 0,0:09:06.25,0:09:07.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:07.96,0:09:10.42,Default,,0,0,0,,Бірінші нүкте – Азуки Бен!
Dialogue: 0,0:09:10.50,0:09:13.46,Default,,0,0,0,,Бегемот Кербеусқа асығыс шабуыл жасады!
Dialogue: 0,0:09:13.80,0:09:15.97,Default,,0,0,0,,Стратегия: Мүлдем жақсы емес
Dialogue: 0,0:09:16.05,0:09:18.26,Default,,0,0,0,,Тәжірибе жақсы өтті деп үміттенемін.
Dialogue: 0,0:09:18.34,0:09:19.22,Default,,0,0,0,,Баттен...
Dialogue: 0,0:09:19.51,0:09:21.76,Default,,0,0,0,,Мен сізге Кербеустың жақсы жақтарын көрсетпес бұрын...
Dialogue: 0,0:09:21.85,0:09:23.35,Default,,0,0,0,,Жарылыс
Dialogue: 0,0:09:23.56,0:09:26.48,Default,,0,0,0,,Сол серпілу күші сонда болды...
Dialogue: 0,0:09:26.56,0:09:29.86,Default,,0,0,0,,Десе де, мен Бегемоттың күші көбірек болған сияқты.
Dialogue: 0,0:09:29.94,0:09:31.15,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:09:31.23,0:09:32.44,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:09:32.65,0:09:36.74,Default,,0,0,0,,Стадионмен жүгіру кезіндегі импульс әртүрлі...
Dialogue: 0,0:09:41.08,0:09:42.79,Default,,0,0,0,,Келесі жолы олай болмайды.
Dialogue: 0,0:09:42.87,0:09:44.04,Default,,0,0,0,,О
Dialogue: 0,0:09:44.37,0:09:45.87,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:09:47.58,0:09:48.87,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:09:49.00,0:09:50.92,Default,,0,0,0,,Біз Бегемотты жеңген кезде!
Dialogue: 0,0:09:54.42,0:09:55.42,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:09:55.76,0:09:57.43,Default,,0,0,0,,Енді келесіге көшейік.
Dialogue: 0,0:09:57.63,0:09:58.51,Default,,0,0,0,,Инсуке!
Dialogue: 0,0:09:58.84,0:10:00.47,Default,,0,0,0,,...Не?
Dialogue: 0,0:10:00.89,0:10:02.60,Default,,0,0,0,,Ей, бұрынғы шайқас...
Dialogue: 0,0:10:02.68,0:10:03.93,Default,,0,0,0,,Ол «Кемоно» деп аталды!
Dialogue: 0,0:10:05.39,0:10:06.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:11.44,0:10:13.07,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:10:13.15,0:10:15.28,Default,,0,0,0,,Кайзер Кербеус 1 ұпай
Dialogue: 0,0:10:15.36,0:10:16.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:16.99,0:10:18.03,Default,,0,0,0,,Тынш!
Dialogue: 0,0:10:19.66,0:10:22.95,Default,,0,0,0,,Екінші шайқаста Кайзер Кербеус жеңді!
Dialogue: 0,0:10:23.03,0:10:25.54,Default,,0,0,0,,Енді нүктелер 2-ден 1-ге дейін
Dialogue: 0,0:10:25.95,0:10:28.75,Default,,0,0,0,,Түсіндім! Inusuke формасының мағынасы
Dialogue: 0,0:10:28.83,0:10:29.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:29.62,0:10:32.59,Default,,0,0,0,,Бегемотқа секіру және жылдам соғу арқылы...
Dialogue: 0,0:10:32.67,0:10:35.21,Default,,0,0,0,,Қуатты жоғалту уақытын қысқартады.
Dialogue: 0,0:10:35.30,0:10:36.38,Default,,0,0,0,,Сіз —
Dialogue: 0,0:10:36.46,0:10:40.34,Default,,0,0,0,,Егер сіз осындай биік жерден атсаңыз, қателесуіңіз мүмкін.
Dialogue: 0,0:10:40.43,0:10:41.68,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:10:41.76,0:10:44.10,Default,,0,0,0,,Оны Инуске де білуі керек.
Dialogue: 0,0:10:44.18,0:10:45.60,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:45.68,0:10:48.31,Default,,0,0,0,,Бегемоттың үдеуін тоқтату үшін...
Dialogue: 0,0:10:48.39,0:10:51.40,Default,,0,0,0,,Тәуекел жоғары болса да, бұл сіздің жалғыз нұсқаңыз деп ойлаған шығарсыз.
Dialogue: 0,0:10:51.60,0:10:53.02,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:10:56.23,0:10:58.32,Default,,0,0,0,,Аң келді, Инуске!
Dialogue: 0,0:10:58.40,0:11:00.57,Default,,0,0,0,,Бірақ бұл... бітті!
Dialogue: 0,0:11:00.95,0:11:04.24,Default,,0,0,0,,Енді үшінші раундқа өтуімізді осы матч шеше ме?
Dialogue: 0,0:11:04.33,0:11:06.29,Default,,0,0,0,,Тағдырлы үшінші шайқас!
Dialogue: 0,0:11:06.49,0:11:08.37,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:11:08.45,0:11:11.92,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:12.00,0:11:14.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:21.38,0:11:23.05,Default,,0,0,0,,Оны құлат!
Dialogue: 0,0:11:23.26,0:11:25.26,Default,,0,0,0,,Шайнаңыз!
Dialogue: 0,0:11:27.18,0:11:29.68,Default,,0,0,0,,Егер сіз жаруды шешсеңіз, Инусуке жеңеді!
Dialogue: 0,0:11:29.77,0:11:31.19,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:11:36.48,0:11:40.11,Default,,0,0,0,,Аяқталды! Қайзер Кербеус 1 ұпай
Dialogue: 0,0:11:40.19,0:11:41.70,Default,,0,0,0,,Керемет, Инуске!
Dialogue: 0,0:11:41.78,0:11:42.86,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:11:43.53,0:11:46.62,Default,,0,0,0,,Өйткені, Инуске ұрысты бастапқы кезеңде шешеді.
Dialogue: 0,0:11:46.70,0:11:48.45,Default,,0,0,0,,Осылай жалғаса берсе, келесі мен боламын!
Dialogue: 0,0:11:48.54,0:11:49.79,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:11:49.87,0:11:52.87,Default,,0,0,0,,Тіпті Бен Инускенің қалай шабуыл жасайтынын түсіне бастады.
Dialogue: 0,0:11:52.96,0:11:55.21,Default,,0,0,0,,Мен оны мүлдем оқи алмаймын.
Dialogue: 0,0:11:55.29,0:11:57.29,Default,,0,0,0,,Сәттілік... Инуске!
Dialogue: 0,0:11:57.75,0:12:00.34,Default,,0,0,0,,Ұпайлар 2-2 тең!
Dialogue: 0,0:12:00.42,0:12:03.76,Default,,0,0,0,,Мидорикава Инусуке мен Сербеусты қуу басталды!
Dialogue: 0,0:12:04.14,0:12:06.93,Default,,0,0,0,,Инсуке Мидорикава қуып келеді Азуки Бенді қуып келеді
Dialogue: 0,0:12:07.01,0:12:09.77,Default,,0,0,0,,Келесі күш шайқасы шешуші фактор бола ма?
Dialogue: 0,0:12:11.31,0:12:13.56,Default,,0,0,0,,Мен жеттім... Бен!
Dialogue: 0,0:12:14.02,0:12:15.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:16.73,0:12:18.65,Default,,0,0,0,,Кербей мен Бегемот
Dialogue: 0,0:12:18.73,0:12:20.48,Default,,0,0,0,,Орталықта қақтығыс!
Dialogue: 0,0:12:25.11,0:12:26.20,Default,,0,0,0,,Күшті шайқас –
Dialogue: 0,0:12:26.28,0:12:29.08,Default,,0,0,0,,Бір уақытта үстіңгі әрлеумен сурет сал!
Dialogue: 0,0:12:29.66,0:12:32.83,Default,,0,0,0,,Енді бесінші шайқастың уақыты келді!
Dialogue: 0,0:12:36.17,0:12:37.42,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:37.50,0:12:39.92,Default,,0,0,0,,Мен өлгенше қорқамын!
Dialogue: 0,0:12:40.00,0:12:42.51,Default,,0,0,0,,Инсуке! Жарылыңыз!
Dialogue: 0,0:12:42.84,0:12:45.68,Default,,0,0,0,,Жануарлар басынан бері әйгілі матч
Dialogue: 0,0:12:45.76,0:12:48.01,Default,,0,0,0,,Мен Бен үстемдік етеді деп ойладым...
Dialogue: 0,0:12:48.10,0:12:50.10,Default,,0,0,0,,Ештеңе істеме, Инуске
Dialogue: 0,0:12:51.06,0:12:52.60,Default,,0,0,0,,Бесінші шайқас
Dialogue: 0,0:12:53.02,0:12:54.98,Default,,0,0,0,,Осы шайқаста шешілді!
Dialogue: 0,0:12:55.06,0:12:55.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:59.65,0:13:02.28,Default,,0,0,0,,Мен мұндай ұстанымды ешқашан көрген емеспін...
Dialogue: 0,0:13:02.36,0:13:05.78,Default,,0,0,0,,Ватт! Азуки Бен өзінің түсірілім формасын өзгертті!
Dialogue: 0,0:13:05.86,0:13:07.74,Default,,0,0,0,,Шектелген тактикаға қарсы ма?
Dialogue: 0,0:13:08.12,0:13:09.66,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз...
Dialogue: 0,0:13:09.74,0:13:12.50,Default,,0,0,0,,Осы уақытқа дейін келгенімді ойламаппын!
Dialogue: 0,0:13:12.95,0:13:14.75,Default,,0,0,0,,Инсуке, жең!
Dialogue: 0,0:13:14.83,0:13:18.17,Default,,0,0,0,,Қандай ерекше қозғалыс болса да, Сербеус жеңеді!
Dialogue: 0,0:13:18.50,0:13:19.71,Default,,0,0,0,,Иттерге қызмет көрсету…
Dialogue: 0,0:13:19.79,0:13:22.63,Default,,0,0,0,,Мен де сенің Аңдар рухыңа жауап беремін!
Dialogue: 0,0:13:23.13,0:13:25.01,Default,,0,0,0,,Мен оны бір рет қоямын!
Dialogue: 0,0:13:26.05,0:13:27.72,Default,,0,0,0,,Мен жеңемін, Бен.
Dialogue: 0,0:13:28.22,0:13:29.64,Default,,0,0,0,,Мен сені жеңуім керек.
Dialogue: 0,0:13:29.80,0:13:31.43,Default,,0,0,0,,Мен тіпті Балтомен де күресе алмаймын!
Dialogue: 0,0:13:32.18,0:13:33.77,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:13:33.97,0:13:37.31,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:37.39,0:13:39.81,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:44.28,0:13:45.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:45.28,0:13:46.78,Default,,0,0,0,,Не... Не?!
Dialogue: 0,0:13:46.86,0:13:48.82,Default,,0,0,0,,Ол құлағалы тұрған сияқты!
Dialogue: 0,0:13:48.91,0:13:51.16,Default,,0,0,0,,Жоқ, ол өте теңдестірілген.
Dialogue: 0,0:13:51.45,0:13:53.41,Default,,0,0,0,,Мен білмей тұрып, осылай атып тұрдым!
Dialogue: 0,0:13:54.20,0:13:56.79,Default,,0,0,0,,Ахх!
Dialogue: 0,0:13:59.21,0:14:02.38,Default,,0,0,0,,Бегемот Джиндору орталықта!
Dialogue: 0,0:14:02.46,0:14:05.97,Default,,0,0,0,,Содан кейін Кербеустың тынымсыз шабуылы!
Dialogue: 0,0:14:06.84,0:14:07.68,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:14:07.76,0:14:09.89,Default,,0,0,0,,Бірақ Бегемот құламайды!
Dialogue: 0,0:14:09.97,0:14:10.64,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:14:10.72,0:14:12.18,Default,,0,0,0,,Аң аулайтын аң...
Dialogue: 0,0:14:12.26,0:14:14.97,Default,,0,0,0,,Өз олжасының тозғанын күтіп тұрғандай!
Dialogue: 0,0:14:15.06,0:14:16.52,Default,,0,0,0,,Бұл Бегемот-
Dialogue: 0,0:14:16.60,0:14:18.31,Default,,0,0,0,,Жыртқыштар!
Dialogue: 0,0:14:19.77,0:14:22.98,Default,,0,0,0,,Cerbeus! Бұл тізбекті соққы!
Dialogue: 0,0:14:23.57,0:14:27.32,Default,,0,0,0,,Beast Hold VS Chain Shoot арасындағы кескілескен шайқас!
Dialogue: 0,0:14:27.40,0:14:30.03,Default,,0,0,0,,Енді бұл ұзақ шайқас. Не болады...
Dialogue: 0,0:14:30.24,0:14:32.32,Default,,0,0,0,,Шайқас қалай аяқталады?
Dialogue: 0,0:14:34.41,0:14:36.58,Default,,0,0,0,,Маған Жан-жануарларыңды көрсет!
Dialogue: 0,0:14:38.25,0:14:40.75,Default,,0,0,0,,Күте тұрыңыз... Cerbeus!
Dialogue: 0,0:14:41.63,0:14:42.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:45.09,0:14:48.34,Default,,0,0,0,,Жануар рухы! Cerbeus!
Dialogue: 0,0:14:48.42,0:14:49.84,Default,,0,0,0,,Бегемот!
Dialogue: 0,0:14:49.93,0:14:54.81,Default,,0,0,0,,Ааа!
Dialogue: 0,0:14:55.89,0:14:59.39,Default,,0,0,0,,Айналдыру Финиш Кайзер Кербеус 1 ұпай
Dialogue: 0,0:14:59.48,0:15:02.48,Default,,0,0,0,,Инсуке Мидорикава 3-2 есебімен жеңіске жетті
Dialogue: 0,0:15:02.69,0:15:04.44,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:15:04.52,0:15:06.48,Default,,0,0,0,,Бесінші шайқас аяқталды!
Dialogue: 0,0:15:06.78,0:15:08.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:08.15,0:15:09.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:09.57,0:15:11.36,Default,,0,0,0,,Инсуке жеңеді деп үміттенемін!
Dialogue: 0,0:15:11.45,0:15:12.62,Default,,0,0,0,,Говасу...
Dialogue: 0,0:15:12.70,0:15:13.78,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:15:14.12,0:15:16.95,Default,,0,0,0,,Инсуке жеңді!
Dialogue: 0,0:15:17.04,0:15:19.12,Default,,0,0,0,,Жылама, ренжітеді!
Dialogue: 0,0:15:19.20,0:15:21.00,Default,,0,0,0,,Көз жасын алады~
Dialogue: 0,0:15:21.08,0:15:23.13,Default,,0,0,0,,Бәрің дымқылсың, Бал-нии!
Dialogue: 0,0:15:23.92,0:15:26.25,Default,,0,0,0,,Рахмет сізге Cerbeus...
Dialogue: 0,0:15:33.76,0:15:34.76,Default,,0,0,0,,Бен…
Dialogue: 0,0:15:35.51,0:15:36.56,Default,,0,0,0,,О
Dialogue: 0,0:15:36.85,0:15:38.72,Default,,0,0,0,,Сіздің хайуандық рухыңыз
Dialogue: 0,0:15:38.81,0:15:39.98,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:15:40.14,0:15:41.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:43.19,0:15:44.48,Default,,0,0,0,,Жеңіске алға!
Dialogue: 0,0:15:44.56,0:15:46.40,Default,,0,0,0,,Сол аң рухымен!
Dialogue: 0,0:15:46.77,0:15:47.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:49.36,0:15:51.82,Default,,0,0,0,,Жасай ма, жоқ па? Толтырылған ойыншық Yarrow
Dialogue: 0,0:15:52.53,0:15:53.86,Default,,0,0,0,,Мидорикава.
Dialogue: 0,0:15:53.95,0:15:55.78,Default,,0,0,0,,Жарайды, мен де ол сияқты жақсымын.
Dialogue: 0,0:15:55.87,0:15:57.91,Default,,0,0,0,,Неге біз сияқты қатты жүрмейміз!
Dialogue: 0,0:15:59.29,0:16:00.83,Default,,0,0,0,,Мен біріншімін
Dialogue: 0,0:16:04.88,0:16:07.21,Default,,0,0,0,,Үшінші турға өтуге шешім қабылдаған адамдар:
Dialogue: 0,0:16:07.29,0:16:09.67,Default,,0,0,0,,Трансформацияланған төрт императордың бірі Бенишу!
Dialogue: 0,0:16:09.76,0:16:13.43,Default,,0,0,0,,Сонымен қатар, Комурасаки Вакия да үшінші раундқа өтеді!
Dialogue: 0,0:16:14.26,0:16:16.26,Default,,0,0,0,,Дәл солай!
Dialogue: 0,0:16:18.60,0:16:20.89,Default,,0,0,0,,Төрт айналмалы император, жанып тұрған ғибадатхананың Кайзасы!
Dialogue: 0,0:16:20.98,0:16:23.94,Default,,0,0,0,,Ксено Экскалибур оны жыртып тастады!
Dialogue: 0,0:16:28.82,0:16:32.03,Default,,0,0,0,,Және төрт айналмалы император Ширасадиджо Луи!
Dialogue: 0,0:16:32.11,0:16:35.36,Default,,0,0,0,,Лонгинустың соққысы чемпионның күшін көрсетеді!
Dialogue: 0,0:16:35.95,0:16:39.20,Default,,0,0,0,,Енді бұл екінші айналымға қалған жалғыз матч.
Dialogue: 0,0:16:39.28,0:16:42.33,Default,,0,0,0,,Соңғы ұяшықты қай пышақ алады?
Dialogue: 0,0:16:42.58,0:16:43.91,Default,,0,0,0,,Қызыл бұрыш
Dialogue: 0,0:16:44.00,0:16:46.75,Default,,0,0,0,,Сол Ширасаги қамал Руи де қарады.
Dialogue: 0,0:16:46.83,0:16:49.21,Default,,0,0,0,,Күшті қолды ұстаңыз Чакаке өтіңіз!
Dialogue: 0,0:16:49.29,0:16:52.13,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:52.76,0:16:54.34,Default,,0,0,0,,Ал көк бұрыш
Dialogue: 0,0:16:54.43,0:16:56.76,Default,,0,0,0,,Жыпырлаған жұлдыздар арасында
Dialogue: 0,0:16:56.84,0:16:59.10,Default,,0,0,0,,Күн нұрын шашады...
Dialogue: 0,0:16:59.18,0:17:00.60,Default,,0,0,0,,Трансформацияланған төрт императордың бірі
Dialogue: 0,0:17:00.68,0:17:03.43,Default,,0,0,0,,Зак Күн сәулесі!
Dialogue: 0,0:17:03.52,0:17:05.48,Default,,0,0,0,,(Қыздар қолдайды)
Dialogue: 0,0:17:05.56,0:17:07.52,Default,,0,0,0,,Зак Сенпай!
Dialogue: 0,0:17:07.81,0:17:08.86,Default,,0,0,0,,Ой…
Dialogue: 0,0:17:08.98,0:17:10.94,Default,,0,0,0,,Сәттілік! Зак Сенпай!
Dialogue: 0,0:17:11.23,0:17:14.40,Default,,0,0,0,,Ак-кун, мен саған сенемін! Зак Сенпайдың...
Dialogue: 0,0:17:14.49,0:17:16.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:18.11,0:17:20.74,Default,,0,0,0,,Менің кіші қызым Акира Ямабукиден...
Dialogue: 0,0:17:20.83,0:17:22.58,Default,,0,0,0,,Ыстық але!
Dialogue: 0,0:17:23.58,0:17:24.91,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:25.25,0:17:26.58,Default,,0,0,0,,Haha~n
Dialogue: 0,0:17:29.25,0:17:31.80,Default,,0,0,0,,Келіңіздер, Зак VS Go Chakake
Dialogue: 0,0:17:31.88,0:17:33.59,Default,,0,0,0,,Кім жеңеді!
Dialogue: 0,0:17:33.67,0:17:35.38,Default,,0,0,0,,Сенпай!
Dialogue: 0,0:17:38.89,0:17:41.56,Default,,0,0,0,,Сенпай, естімей тұрсың ба?
Dialogue: 0,0:17:41.89,0:17:43.64,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:17:43.97,0:17:47.27,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:47.35,0:17:49.73,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:58.61,0:17:59.53,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:18:00.37,0:18:03.54,Default,,0,0,0,,Гигант Гайя 2 ұпай
Dialogue: 0,0:18:03.74,0:18:06.41,Default,,0,0,0,,Сәлем! Жақсы!
Dialogue: 0,0:18:06.50,0:18:09.50,Default,,0,0,0,,Біріншіден, Гигант Гайя жылдам шабуыл жасады!
Dialogue: 0,0:18:09.58,0:18:12.25,Default,,0,0,0,,Төрт айналмалы Закқа қатты қысым!
Dialogue: 0,0:18:13.17,0:18:14.21,Default,,0,0,0,,Мен мұны істеймін...
Dialogue: 0,0:18:14.55,0:18:16.26,Default,,0,0,0,,Йоцутен императоры сіздің қарсыласыңыз.
Dialogue: 0,0:18:16.34,0:18:18.38,Default,,0,0,0,,Бірінші нүктені алсаңыз да...
Dialogue: 0,0:18:18.47,0:18:19.76,Default,,0,0,0,,Сіз сақтықты төмендете алмайсыз
Dialogue: 0,0:18:20.22,0:18:23.01,Default,,0,0,0,,Хаха, бұл жақсы идея!
Dialogue: 0,0:18:23.10,0:18:25.27,Default,,0,0,0,,Бірақ мен жақында жетемін.
Dialogue: 0,0:18:25.35,0:18:26.64,Default,,0,0,0,,Мен құрметке бөлендім
Dialogue: 0,0:18:26.93,0:18:29.10,Default,,0,0,0,,Төрт-он император қуып бара жатыр ма?
Dialogue: 0,0:18:29.19,0:18:29.94,Default,,0,0,0,,Иә
Dialogue: 0,0:18:30.44,0:18:31.94,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:18:35.94,0:18:37.53,Default,,0,0,0,,(Еденге соғылған сымның дыбысы)
Dialogue: 0,0:18:37.61,0:18:39.15,Default,,0,0,0,,(орам сымының дыбысы)
Dialogue: 0,0:18:39.82,0:18:42.03,Default,,0,0,0,,(Еденге түскен сымның дыбысы)
Dialogue: 0,0:18:46.50,0:18:47.79,Default,,0,0,0,,Хаха!
Dialogue: 0,0:18:47.87,0:18:51.25,Default,,0,0,0,,Циллион Зевс! Аяқтау үшін 1 ұпай
Dialogue: 0,0:18:51.33,0:18:54.63,Default,,0,0,0,,Енді 1-ге қарсы 2 Зак, қууды бастайық!
Dialogue: 0,0:18:55.25,0:18:56.67,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:18:56.88,0:18:58.63,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:18:58.92,0:19:02.22,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:02.30,0:19:04.43,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:04.51,0:19:05.51,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:19:06.93,0:19:10.44,Default,,0,0,0,,Циллион Зевс Гигант Гайаның соққысынан құтылды!
Dialogue: 0,0:19:10.52,0:19:12.23,Default,,0,0,0,,Ал мен орталықты алдым!
Dialogue: 0,0:19:18.28,0:19:19.99,Default,,0,0,0,,Жарылыспен жеңіңіз!
Dialogue: 0,0:19:20.07,0:19:22.24,Default,,0,0,0,,Жарық көзі менде!
Dialogue: 0,0:19:23.62,0:19:24.99,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:25.58,0:19:26.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:27.04,0:19:30.12,Default,,0,0,0,,Зиллион Зевс 2 ұпай
Dialogue: 0,0:19:30.21,0:19:33.42,Default,,0,0,0,,Zack the Sunshine 3-2 жеңеді!
Dialogue: 0,0:19:33.50,0:19:35.88,Default,,0,0,0,,(Қыздар қолдайды)
Dialogue: 0,0:19:35.96,0:19:38.67,Default,,0,0,0,,Жеңімпазды Зак!
Dialogue: 0,0:19:39.63,0:19:41.13,Default,,0,0,0,,Гигант Гая
Dialogue: 0,0:19:41.22,0:19:43.68,Default,,0,0,0,,Соқтығыс алдында жарылып кетті!
Dialogue: 0,0:19:43.76,0:19:46.14,Default,,0,0,0,,Қорқынышты Циллион Зевс!
Dialogue: 0,0:19:46.64,0:19:48.64,Default,,0,0,0,,Сенпайдың өзі сондай салмақты!
Dialogue: 0,0:19:48.97,0:19:52.19,Default,,0,0,0,,Zack the Sunshine Сізді жеңетін адам -
Dialogue: 0,0:19:52.27,0:19:54.06,Default,,0,0,0,,Бұл мен және Анубис.
Dialogue: 0,0:19:54.90,0:19:57.07,Default,,0,0,0,,Ал мен жаңа...
Dialogue: 0,0:19:57.15,0:19:58.86,Default,,0,0,0,,Супер жұлдыз бол!
Dialogue: 0,0:19:59.19,0:20:00.94,Default,,0,0,0,,Барлығы ...
Dialogue: 0,0:20:01.03,0:20:02.15,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:02.70,0:20:04.49,Default,,0,0,0,,Бұл жақсы шайқас болды.
Dialogue: 0,0:20:04.57,0:20:05.45,Default,,0,0,0,,О
Dialogue: 0,0:20:05.91,0:20:09.66,Default,,0,0,0,,Мен сізден алған бірінші жарылыс өте тиімді болды.
Dialogue: 0,0:20:09.75,0:20:12.37,Default,,0,0,0,,Супер жұлдыз үлкен қиындыққа тап болды! Бұл дұрыс
Dialogue: 0,0:20:14.04,0:20:17.00,Default,,0,0,0,,Үшінші шайқас Мен жеңдім деп ойладым.
Dialogue: 0,0:20:17.46,0:20:20.21,Default,,0,0,0,,Мен тағы да жарысқым келеді хаха~
Dialogue: 0,0:20:34.69,0:20:36.02,Default,,0,0,0,,Атуға үлгермей тұрып байқап қалды.
Dialogue: 0,0:20:36.23,0:20:37.77,Default,,0,0,0,,Төрт айналымнан тұратын император күткендей.
Dialogue: 0,0:20:38.23,0:20:39.82,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:20:39.94,0:20:40.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:41.11,0:20:42.61,Default,,0,0,0,,Жоғалту - бұл шығын!
Dialogue: 0,0:20:42.69,0:20:45.78,Default,,0,0,0,,Қарсыласыңды мақтау әдемі!
Dialogue: 0,0:20:47.66,0:20:49.45,Default,,0,0,0,,Мен досымды жоғалтамын
Dialogue: 0,0:20:53.66,0:20:56.79,Default,,0,0,0,,Енді екінші тур аяқталды.
Dialogue: 0,0:20:56.88,0:20:59.75,Default,,0,0,0,,Үшінші раундқа өткен жүзушілер шықты!
Dialogue: 0,0:20:59.96,0:21:03.01,Default,,0,0,0,,Біріншіден, бірінші адам - ​​Аои Барто!
Dialogue: 0,0:21:03.09,0:21:04.26,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:21:04.63,0:21:07.51,Default,,0,0,0,,Қолданылатын шығанақ - Жеңіс Валькири!
Dialogue: 0,0:21:08.10,0:21:10.89,Default,,0,0,0,,Екінші адам! Акира Ямабуки!
Dialogue: 0,0:21:10.97,0:21:13.60,Default,,0,0,0,,Пайдаланылатын шығанағы - Анубис қышқылы!
Dialogue: 0,0:21:13.98,0:21:16.60,Default,,0,0,0,,Үшінші адам! Мидорикава Инусуке!
Dialogue: 0,0:21:16.81,0:21:19.61,Default,,0,0,0,,Қолданылатын шығанақ - Кайзер Кербеус!
Dialogue: 0,0:21:20.15,0:21:22.57,Default,,0,0,0,,Төртінші адам! Қызыл Шу!
Dialogue: 0,0:21:22.65,0:21:25.24,Default,,0,0,0,,Қолданылатын шығанақ - Сторм Спригган!
Dialogue: 0,0:21:25.53,0:21:28.32,Default,,0,0,0,,Бесінші адам! Комурасаки Вакия!
Dialogue: 0,0:21:28.41,0:21:30.70,Default,,0,0,0,,Қолданылатын шығанақ - Жабайы Вайверн!
Dialogue: 0,0:21:30.91,0:21:33.62,Default,,0,0,0,,6-адам! Жанып жатқан ғибадатхана Кайза!
Dialogue: 0,0:21:33.70,0:21:36.75,Default,,0,0,0,,Қолданылатын шығанақ - Xeno Excalibur!
Dialogue: 0,0:21:37.17,0:21:40.04,Default,,0,0,0,,Жетінші адам! Ширасаги сарайы Луис!
Dialogue: 0,0:21:40.13,0:21:42.50,Default,,0,0,0,,Қолданылатын шығанақ - Лостронгинус!
Dialogue: 0,0:21:42.84,0:21:46.22,Default,,0,0,0,,8-ші адам! Zack the Sunshine!
Dialogue: 0,0:21:46.30,0:21:48.47,Default,,0,0,0,,Қолданылатын шығанақ - Циллион Зевс!
Dialogue: 0,0:21:48.93,0:21:51.72,Default,,0,0,0,,Бұл 8 адам! Қызу шайқас -
Dialogue: 0,0:21:51.81,0:21:53.81,Default,,0,0,0,,Үміттенейік!
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.53,0:23:28.65,Default,,0,0,0,,Ақыры Шу мен Уақия соқтығысады!
Dialogue: 0,0:23:28.74,0:23:31.95,Default,,0,0,0,,Вакия Шуды жеңу үшін жаңа ерекше қимыл жасайды!
Dialogue: 0,0:23:32.03,0:23:35.28,Default,,0,0,0,,Қай тарапты қолдайтынымды білмеймін!
Dialogue: 0,0:23:35.62,0:23:38.95,Default,,0,0,0,,Ал Инусуке мен Ширасагижоруи арасындағы шайқас басталады.
Dialogue: 0,0:23:39.04,0:23:41.62,Default,,0,0,0,,Мен Инускені міндетті түрде қолдаймын!
Dialogue: 0,0:23:41.71,0:23:43.79,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.88,0:23:45.71,Default,,0,0,0,,Спригган В.С.Виверн!
