Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.55,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.63,0:00:14.68,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.76,0:00:16.89,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.97,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.64,0:00:24.06,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.14,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.61,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.90,0:00:34.36,Default,,0,0,0,,Ұлттық турнир жекелей 1 тур
Dialogue: 0,0:00:34.95,0:00:37.70,Default,,0,0,0,,Біртүрлі телефон қоңырауынан естен танып қала жаздадым...
Dialogue: 0,0:00:37.78,0:00:39.16,Default,,0,0,0,,Мен су бетіндегі Наокимін.
Dialogue: 0,0:00:39.24,0:00:41.37,Default,,0,0,0,,Мен Нова Нептунмен күресіп, жеңдім!
Dialogue: 0,0:00:43.08,0:00:44.33,Default,,0,0,0,,Сол күні мен кездестірген адам-
Dialogue: 0,0:00:44.41,0:00:47.17,Default,,0,0,0,,Шудың қарсыласы Джин Айзава
Dialogue: 0,0:00:47.92,0:00:50.71,Default,,0,0,0,,Ол мені әдейі ұрмақ болды.
Dialogue: 0,0:00:51.13,0:00:54.42,Default,,0,0,0,,Ол шын мәнінде лас әдістерді қолданатын пышақ болды.
Dialogue: 0,0:00:54.76,0:00:57.01,Default,,0,0,0,,Шудың бірінші раундтағы қарсыласы.
Dialogue: 0,0:00:57.72,0:00:59.60,Default,,0,0,0,,Шуға қауіп төніп тұр!
Dialogue: 0,0:01:07.85,0:01:10.23,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:10.57,0:01:15.74,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:27.04,0:01:30.42,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:30.92,0:01:33.05,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:33.46,0:01:37.59,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:37.72,0:01:40.93,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:41.05,0:01:47.48,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:47.77,0:01:52.19,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:01:52.69,0:01:58.11,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:01:58.24,0:02:00.49,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:00.57,0:02:05.29,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:05.45,0:02:10.54,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:10.83,0:02:13.09,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:13.29,0:02:15.63,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:15.92,0:02:19.84,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:20.01,0:02:25.01,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:25.22,0:02:27.39,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:31.06,0:02:33.65,Default,,0,0,0,,Жылан! Джормунганд!
Dialogue: 0,0:02:37.19,0:02:38.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:39.53,0:02:40.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:40.74,0:02:42.57,Default,,0,0,0,,Жарайды, әдеттен тыс ештеңе жоқ!
Dialogue: 0,0:02:44.66,0:02:45.91,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:49.00,0:02:50.50,Default,,0,0,0,,Әй
Dialogue: 0,0:02:50.58,0:02:51.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:51.67,0:02:53.29,Default,,0,0,0,,Әй, Шу!
Dialogue: 0,0:02:54.59,0:02:56.17,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:02:56.25,0:02:58.13,Default,,0,0,0,,Оққағардан озып кетпеу.
Dialogue: 0,0:02:58.42,0:03:00.80,Default,,0,0,0,,Мен оққағар сұраған жоқпын.
Dialogue: 0,0:03:00.88,0:03:03.64,Default,,0,0,0,,Саған бірдеңе болса ше?
Dialogue: 0,0:03:03.72,0:03:04.47,Default,,0,0,0,,№.
Dialogue: 0,0:03:04.76,0:03:05.97,Default,,0,0,0,,Жоғалған жоқ!
Dialogue: 0,0:03:06.06,0:03:09.56,Default,,0,0,0,,Джин Айзаваның қайда көздеп жатқанын білмеймін.
Dialogue: 0,0:03:09.64,0:03:11.19,Default,,0,0,0,,Барто дұрыс айтады!
Dialogue: 0,0:03:11.27,0:03:13.27,Default,,0,0,0,,Шиеленіс сезімімен және миссия сезімімен.
Dialogue: 0,0:03:13.35,0:03:14.94,Default,,0,0,0,,Бар күшіңізбен ұрыңыз!
Dialogue: 0,0:03:15.02,0:03:17.98,Default,,0,0,0,,Бұл қауіпсіздіктің алтын ережесі!
Dialogue: 0,0:03:18.07,0:03:20.99,Default,,0,0,0,,О~ Кумичо, тамаша!
Dialogue: 0,0:03:21.07,0:03:23.70,Default,,0,0,0,,Хехе, күте тұрыңыз, бұл жай ғана қарттың саудасы.
Dialogue: 0,0:03:24.03,0:03:25.37,Default,,0,0,0,,Мейвакуда
Dialogue: 0,0:03:27.41,0:03:29.12,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:32.79,0:03:33.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:34.21,0:03:36.25,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:37.80,0:03:40.09,Default,,0,0,0,,Дәрігер мәлімет бергеннен кейін
Dialogue: 0,0:03:40.17,0:03:41.47,Default,,0,0,0,,Аои Балт әрқашан...
Dialogue: 0,0:03:41.55,0:03:44.18,Default,,0,0,0,,Куришюді қорғау үшін мінез-құлық көрсету
Dialogue: 0,0:03:45.18,0:03:48.14,Default,,0,0,0,,Бұл өте маңызды болмыс, солай емес пе?
Dialogue: 0,0:03:48.22,0:03:50.27,Default,,0,0,0,,Дәрігердің болжамы бойынша.
Dialogue: 0,0:03:50.85,0:03:52.64,Default,,0,0,0,,Ол кеткенде...
Dialogue: 0,0:03:52.73,0:03:54.73,Default,,0,0,0,,Саған не болады?
Dialogue: 0,0:03:54.81,0:03:56.06,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:56.15,0:03:58.82,Default,,0,0,0,,Тәжірибелер өте қызықты!
Dialogue: 0,0:04:00.69,0:04:02.15,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:04:02.24,0:04:04.07,Default,,0,0,0,,Енді Бей босатылды!
Dialogue: 0,0:04:04.28,0:04:06.41,Default,,0,0,0,,(Қыздар қолдайды)
Dialogue: 0,0:04:06.62,0:04:08.45,Default,,0,0,0,,Уау! жақсы!
Dialogue: 0,0:04:08.53,0:04:12.04,Default,,0,0,0,,Циллион Зевс Секундына үздіксіз жарылыс
Dialogue: 0,0:04:12.12,0:04:13.67,Default,,0,0,0,,Зак Күн сәулесі
Dialogue: 0,0:04:13.75,0:04:16.00,Default,,0,0,0,,Екінші турға тамаша өтті!
Dialogue: 0,0:04:16.13,0:04:18.09,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:21.76,0:04:23.34,Default,,0,0,0,,Мен шештім!
Dialogue: 0,0:04:23.42,0:04:24.88,Default,,0,0,0,,Ах...!
Dialogue: 0,0:04:24.97,0:04:27.64,Default,,0,0,0,,Жеңімпаз - Азуки Бен!
Dialogue: 0,0:04:27.72,0:04:30.27,Default,,0,0,0,,Жабайы аң одан сайын қорқынышты болды...
Dialogue: 0,0:04:30.35,0:04:32.18,Default,,0,0,0,,Біз екінші турға өттік!
Dialogue: 0,0:04:32.27,0:04:33.98,Default,,0,0,0,,Керемет! Бен!
Dialogue: 0,0:04:34.06,0:04:35.73,Default,,0,0,0,,Келесі - Инуске.
Dialogue: 0,0:04:35.81,0:04:36.85,Default,,0,0,0,,Ах
Dialogue: 0,0:04:36.94,0:04:38.77,Default,,0,0,0,,Жеңіске жет, Инуске!
Dialogue: 0,0:04:41.82,0:04:44.07,Default,,0,0,0,,Кайзер Сербеус!
Dialogue: 0,0:04:44.15,0:04:46.78,Default,,0,0,0,,Қарсыласыңыздың шабуылдарынан аулақ болыңыз!
Dialogue: 0,0:04:46.86,0:04:47.87,Default,,0,0,0,,Инсуке Мидорикава
Dialogue: 0,0:04:47.95,0:04:49.95,Default,,0,0,0,,Екінші турға өту туралы шешім қабылданды!
Dialogue: 0,0:04:50.41,0:04:51.79,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:51.87,0:04:53.25,Default,,0,0,0,,Істейміз, Инуске!
Dialogue: 0,0:04:55.04,0:04:57.08,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз! Шуу!
Dialogue: 0,0:04:57.17,0:04:58.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:00.42,0:05:02.55,Default,,0,0,0,,Жарайды! Миссия аяқталды!
Dialogue: 0,0:05:02.63,0:05:04.42,Default,,0,0,0,,Күту залдары бөлек...
Dialogue: 0,0:05:04.51,0:05:05.97,Default,,0,0,0,,Мен қазір өзімді қауіпсіз сезінемін.
Dialogue: 0,0:05:06.93,0:05:09.80,Default,,0,0,0,,Жарайды! ұлдар мен қыздар
Dialogue: 0,0:05:09.89,0:05:13.43,Default,,0,0,0,,Бүгін біз соңғы ойынның пышақтарымен таныстырамыз!
Dialogue: 0,0:05:13.52,0:05:16.44,Default,,0,0,0,,Қызыл бұрыш Соңғы турнирдің жүлдегері
Dialogue: 0,0:05:16.52,0:05:18.02,Default,,0,0,0,,Бенишу!
Dialogue: 0,0:05:18.10,0:05:21.57,Default,,0,0,0,,Жұмбақ пердеге оранған көк бұрыш
Dialogue: 0,0:05:21.65,0:05:23.23,Default,,0,0,0,,Джин Айзава!
Dialogue: 0,0:05:23.32,0:05:25.65,Default,,0,0,0,,Екі пышақ пайда болады!
Dialogue: 0,0:05:27.11,0:05:28.57,Default,,0,0,0,,Жеңіс, Шу.
Dialogue: 0,0:05:28.78,0:05:31.87,Default,,0,0,0,,Сен менің жаншылдымның ортасындасың
Dialogue: 0,0:05:32.20,0:05:33.75,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:05:35.25,0:05:37.62,Default,,0,0,0,,Джормунгандр - төзімділік түрі.
Dialogue: 0,0:05:38.00,0:05:40.33,Default,,0,0,0,,Еркін айналмалы сақинасы бар велосипед жүргізушісі...
Dialogue: 0,0:05:40.42,0:05:41.96,Default,,0,0,0,,Таңғажайып табандылық көрсетеді
Dialogue: 0,0:05:42.05,0:05:43.55,Default,,0,0,0,,Спригган…
Dialogue: 0,0:05:43.63,0:05:46.05,Default,,0,0,0,,Протеин қозғалысын көрсету
Dialogue: 0,0:05:46.59,0:05:48.59,Default,,0,0,0,,Сіз қандай тактиканы қолданасыз...?
Dialogue: 0,0:05:48.68,0:05:49.76,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:05:49.97,0:05:51.47,Default,,0,0,0,,Бірден шабуыл
Dialogue: 0,0:05:51.55,0:05:52.56,Default,,0,0,0,,Ха
Dialogue: 0,0:05:52.64,0:05:54.77,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:05:54.85,0:05:58.14,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:58.23,0:06:00.77,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:01.94,0:06:04.23,Default,,0,0,0,,Бей стадионға шығарылды!
Dialogue: 0,0:06:04.32,0:06:05.49,Default,,0,0,0,,Жүр!
Dialogue: 0,0:06:07.95,0:06:09.24,Default,,0,0,0,,Жоғарғы түсірілім!
Dialogue: 0,0:06:10.03,0:06:11.87,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:06:11.95,0:06:13.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:13.12,0:06:16.83,Default,,0,0,0,,Ах! Джормунганд еңкейіп қалды
Dialogue: 0,0:06:16.91,0:06:18.66,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:06:20.58,0:06:22.63,Default,,0,0,0,,Қабат стадионға түседі-
Dialogue: 0,0:06:22.71,0:06:24.25,Default,,0,0,0,,Бірден айналдыру аяқталуы...
Dialogue: 0,0:06:24.46,0:06:25.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:25.34,0:06:29.97,Default,,0,0,0,,Ах! Ооооооооооо! Мен оны қайта құрдым!
Dialogue: 0,0:06:30.05,0:06:31.05,Default,,0,0,0,,Не!
Dialogue: 0,0:06:31.14,0:06:34.06,Default,,0,0,0,,Еркін айналмалы сақинасы бар велосипед жүргізушісі -
Dialogue: 0,0:06:34.14,0:06:35.52,Default,,0,0,0,,Сіз шыдадыңыз!
Dialogue: 0,0:06:35.60,0:06:36.97,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:37.06,0:06:40.85,Default,,0,0,0,,Күтілгендей, бұл тек күшейтілген орталықтан тепкіш күші бар жүргізуші.
Dialogue: 0,0:06:41.15,0:06:42.36,Default,,0,0,0,,Хехе...
Dialogue: 0,0:06:42.44,0:06:45.82,Default,,0,0,0,,Бұл Джормунгандтың ерекше өлмеген кадры
Dialogue: 0,0:06:46.03,0:06:48.36,Default,,0,0,0,,Джормунганд орталықты алады!
Dialogue: 0,0:06:48.44,0:06:49.32,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:06:49.40,0:06:51.95,Default,,0,0,0,,Спригган тағы!
Dialogue: 0,0:06:52.41,0:06:53.62,Default,,0,0,0,,Жоғарғы түсірілім!
Dialogue: 0,0:06:53.70,0:06:56.99,Default,,0,0,0,,Йо... Джормунганд қайтадан орнынан тұрды!
Dialogue: 0,0:06:57.08,0:06:59.21,Default,,0,0,0,,Спригганның жоғарғы қашу-
Dialogue: 0,0:06:59.29,0:07:01.54,Default,,0,0,0,,Үздіксіз шабуыл~!
Dialogue: 0,0:07:01.62,0:07:03.88,Default,,0,0,0,,Бірақ! Йормунганд құламайды!
Dialogue: 0,0:07:03.96,0:07:06.38,Default,,0,0,0,,Қорқынышты «Өлмеген атыс»!
Dialogue: 0,0:07:07.17,0:07:08.88,Default,,0,0,0,,Қандай жабысқақ!
Dialogue: 0,0:07:08.97,0:07:11.88,Default,,0,0,0,,Жоғарғы соққысы бар қарсыласқа қарсы... Әзірге...
Dialogue: 0,0:07:11.97,0:07:14.97,Default,,0,0,0,,Джормунгандр - жерде жорғалайтын улы жылан...
Dialogue: 0,0:07:15.05,0:07:17.81,Default,,0,0,0,,Бізді ешкім жеңе алмайды
Dialogue: 0,0:07:17.89,0:07:19.02,Default,,0,0,0,,Спригган!
Dialogue: 0,0:07:20.10,0:07:22.90,Default,,0,0,0,,Spriggan Upper қайтадан ату!
Dialogue: 0,0:07:22.98,0:07:26.32,Default,,0,0,0,,Қанша рет жеңсең де солай...
Dialogue: 0,0:07:26.40,0:07:27.90,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:07:27.98,0:07:28.94,Default,,0,0,0,,А...
Dialogue: 0,0:07:30.28,0:07:32.82,Default,,0,0,0,,Дауыл Спригганның жарылуы аяқталды
Dialogue: 0,0:07:33.20,0:07:35.20,Default,,0,0,0,,Шу күреңайға 2 ұпай
Dialogue: 0,0:07:35.53,0:07:36.83,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:07:36.91,0:07:38.49,Default,,0,0,0,,Жақсы, Шу!
Dialogue: 0,0:07:38.58,0:07:40.71,Default,,0,0,0,,Бір қарағанда, ешқандай зақым жоқ сияқты, бірақ...
Dialogue: 0,0:07:41.16,0:07:45.17,Default,,0,0,0,,Жоғарғы соққы Джормунгандты міндетті түрде бұрышқа түсірді.
Dialogue: 0,0:07:46.34,0:07:49.21,Default,,0,0,0,,Енді ұпайлар 2-0.
Dialogue: 0,0:07:49.30,0:07:52.13,Default,,0,0,0,,Жүр, Айзава Джин, істейтін ештеңе қалмады~!
Dialogue: 0,0:07:52.59,0:07:53.38,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:55.43,0:07:58.26,Default,,0,0,0,,Сіз мені капюшонымды шешуге мәжбүр еттіңіз.
Dialogue: 0,0:07:58.60,0:08:01.27,Default,,0,0,0,,Мен білмеймін. Не болса да...
Dialogue: 0,0:08:01.73,0:08:06.06,Default,,0,0,0,,Менде 323 қамқоршы рух бар.
Dialogue: 0,0:08:06.15,0:08:07.27,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:08:09.03,0:08:12.28,Default,,0,0,0,,Ол... Менің ойымша, оның ештеңе істеуге ниеті жоқ.
Dialogue: 0,0:08:12.36,0:08:14.16,Default,,0,0,0,,Ойын басталды
Dialogue: 0,0:08:14.24,0:08:15.82,Default,,0,0,0,,Мен енді ештеңе істей алмаймын
Dialogue: 0,0:08:15.91,0:08:17.83,Default,,0,0,0,,(планшеттің жанасу дыбысы)
Dialogue: 0,0:08:20.91,0:08:22.41,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:08:22.50,0:08:25.92,Default,,0,0,0,,Спригган Күтілгеннен көп шабуыл күші
Dialogue: 0,0:08:26.00,0:08:27.63,Default,,0,0,0,,Джормунганд…
Dialogue: 0,0:08:27.71,0:08:29.00,Default,,0,0,0,,Әлі де жабысқақ
Dialogue: 0,0:08:29.25,0:08:30.17,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:30.55,0:08:32.34,Default,,0,0,0,,Күшке назар аударуды жалғастырыңыз.
Dialogue: 0,0:08:32.84,0:08:34.72,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:08:34.80,0:08:37.93,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:38.30,0:08:41.52,Default,,0,0,0,,Барыңыз... Атыңыз!
Dialogue: 0,0:08:42.64,0:08:46.19,Default,,0,0,0,,Куришу күтпеген жерден сәтсіз соққы жасады!
Dialogue: 0,0:08:46.27,0:08:47.06,Default,,0,0,0,,Не!
Dialogue: 0,0:08:47.15,0:08:48.94,Default,,0,0,0,,Импульс мүлде жоқ.
Dialogue: 0,0:08:49.65,0:08:52.44,Default,,0,0,0,,Бірінші хабарласыңыз Ahhh
Dialogue: 0,0:08:52.57,0:08:56.57,Default,,0,0,0,,Спригганды Джайльормунгандр ұшырып жіберді
Dialogue: 0,0:08:56.66,0:08:58.99,Default,,0,0,0,,артығымен орындағаны үшін 1 ұпай!
Dialogue: 0,0:08:59.08,0:08:59.74,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:09:00.41,0:09:03.79,Default,,0,0,0,,Екінші шайқаста Джин Айзава жеңді.
Dialogue: 0,0:09:03.87,0:09:06.25,Default,,0,0,0,,Ол маған бекітілген
Dialogue: 0,0:09:06.54,0:09:09.92,Default,,0,0,0,,323 қамқоршы рухтар...
Dialogue: 0,0:09:10.00,0:09:10.92,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:09:13.01,0:09:16.05,Default,,0,0,0,,Дәл қазір бірдеңе дұрыс болмады.
Dialogue: 0,0:09:16.13,0:09:16.97,Default,,0,0,0,,Ах
Dialogue: 0,0:09:17.05,0:09:19.18,Default,,0,0,0,,Мен бұл Джин жігітін ешқашан күтпедім...
Dialogue: 0,0:09:19.26,0:09:20.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:21.26,0:09:22.77,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:09:23.39,0:09:24.68,Default,,0,0,0,,Бұрынғы жарық...
Dialogue: 0,0:09:25.94,0:09:27.69,Default,,0,0,0,,Бұл кездейсоқ емес
Dialogue: 0,0:09:28.27,0:09:30.36,Default,,0,0,0,,Маған бағытталғаны анық.
Dialogue: 0,0:09:30.65,0:09:32.48,Default,,0,0,0,,Олай болса, үшінші шайқас...
Dialogue: 0,0:09:33.82,0:09:36.20,Default,,0,0,0,,Не ойлап тұрсың, Шуу...
Dialogue: 0,0:09:40.16,0:09:41.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:42.74,0:09:43.87,Default,,0,0,0,,(Дыбысты орнату)
Dialogue: 0,0:09:44.20,0:09:45.71,Default,,0,0,0,,Сол қолмен атуға ауыстырылды!
Dialogue: 0,0:09:46.12,0:09:47.79,Default,,0,0,0,,Бұл не, Куришуу?
Dialogue: 0,0:09:47.87,0:09:51.29,Default,,0,0,0,,Оң қолмен атудан сол қолмен атуға ауыстырылды!
Dialogue: 0,0:09:52.50,0:09:55.17,Default,,0,0,0,,Сол қолмен ату оң қолмен атуға қарағанда аз күшке ие.
Dialogue: 0,0:09:55.26,0:09:58.18,Default,,0,0,0,,Бірақ мен бос қолыммен іске қосқышты жөндей алатындықтан...
Dialogue: 0,0:09:58.26,0:10:00.43,Default,,0,0,0,,Ату дәлдігі жоғарылады
Dialogue: 0,0:10:00.85,0:10:01.97,Default,,0,0,0,,Егер бұл...
Dialogue: 0,0:10:07.31,0:10:09.44,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:10:10.19,0:10:11.69,Default,,0,0,0,,Не болды...
Dialogue: 0,0:10:11.77,0:10:14.40,Default,,0,0,0,,Мен ұшырғышты көзімді жұмып ұстадым!
Dialogue: 0,0:10:14.61,0:10:16.94,Default,,0,0,0,,Шу? (Рантаро) Мүмкін емес...
Dialogue: 0,0:10:17.03,0:10:19.41,Default,,0,0,0,,Сен олай атпайсың деп ойлаймын.
Dialogue: 0,0:10:20.41,0:10:21.95,Default,,0,0,0,,Мыңдаған рет…
Dialogue: 0,0:10:22.03,0:10:23.66,Default,,0,0,0,,Мен мұны ондаған мың рет жасадым...
Dialogue: 0,0:10:24.54,0:10:26.16,Default,,0,0,0,,Барлығы дәл
Dialogue: 0,0:10:26.83,0:10:28.50,Default,,0,0,0,,Мұны әдеттегідей орындаңыз.
Dialogue: 0,0:10:29.37,0:10:31.21,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:10:31.29,0:10:34.55,Default,,0,0,0,,Сіз нені мақсат етесіз?
Dialogue: 0,0:10:35.59,0:10:36.55,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:36.76,0:10:38.92,Default,,0,0,0,,Не істесеңіз де...
Dialogue: 0,0:10:39.01,0:10:39.93,Default,,0,0,0,,Жеңіс!
Dialogue: 0,0:10:45.10,0:10:46.18,Default,,0,0,0,,Шу!
Dialogue: 0,0:10:47.39,0:10:50.44,Default,,0,0,0,,Енді үшінші шайқастың уақыты келді.
Dialogue: 0,0:10:50.77,0:10:53.65,Default,,0,0,0,,Мұнда Куришу 2-1 есебімен алға шықты.
Dialogue: 0,0:10:53.73,0:10:56.15,Default,,0,0,0,,Джин Айзава Екінші шайқастың қарқынымен-
Dialogue: 0,0:10:56.23,0:10:57.86,Default,,0,0,0,,Ол айналады ма?
Dialogue: 0,0:10:57.94,0:10:59.90,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:11:00.15,0:11:02.99,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:03.12,0:11:04.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:04.37,0:11:06.70,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:06.79,0:11:07.58,Default,,0,0,0,,Нуах!
Dialogue: 0,0:11:09.83,0:11:11.04,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:11:11.12,0:11:13.42,Default,,0,0,0,,Уау! Бұл керемет Шу!
Dialogue: 0,0:11:13.71,0:11:17.05,Default,,0,0,0,,Мұны жасамасаң, жеңсең де қызық емес.
Dialogue: 0,0:11:17.13,0:11:19.76,Default,,0,0,0,,Спригган орасан зор күшпен-
Dialogue: 0,0:11:19.84,0:11:22.09,Default,,0,0,0,,Джормунгандқа жақындау!
Dialogue: 0,0:11:23.30,0:11:25.43,Default,,0,0,0,,Шешіңіз! Спригган!
Dialogue: 0,0:11:28.89,0:11:32.48,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:11:32.94,0:11:34.40,Default,,0,0,0,,Артқа жанап өтіңіз!
Dialogue: 0,0:11:34.48,0:11:35.94,Default,,0,0,0,,Джормунганд!
Dialogue: 0,0:11:41.03,0:11:42.49,Default,,0,0,0,,Жоғарғы түсірілім!
Dialogue: 0,0:11:42.57,0:11:44.37,Default,,0,0,0,,Өлмеген ату!
Dialogue: 0,0:11:45.70,0:11:48.95,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:11:50.29,0:11:51.91,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:11:53.25,0:11:55.25,Default,,0,0,0,,Дауыл Спригганның жарылуы аяқталды
Dialogue: 0,0:11:55.33,0:11:58.00,Default,,0,0,0,,Куришуу 4-1 жеңді!
Dialogue: 0,0:11:58.42,0:11:59.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:59.96,0:12:02.26,Default,,0,0,0,,Бенишу жеңді.
Dialogue: 0,0:12:02.34,0:12:03.34,Default,,0,0,0,,Йормунгандр
Dialogue: 0,0:12:03.43,0:12:05.80,Default,,0,0,0,,Бұл таңғажайып табандылық көрсетті, бірақ нәтиже бермеді ...
Dialogue: 0,0:12:07.35,0:12:09.56,Default,,0,0,0,,Екінші турға кім өтті...
Dialogue: 0,0:12:09.64,0:12:11.18,Default,,0,0,0,,Бұл Куришуу!
Dialogue: 0,0:12:12.64,0:12:13.85,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:13.94,0:12:17.11,Default,,0,0,0,,Оның 323 қамқоршы рухы бар.
Dialogue: 0,0:12:17.48,0:12:18.98,Default,,0,0,0,,Мен жоғалтуға жол жоқ ...
Dialogue: 0,0:12:19.40,0:12:20.90,Default,,0,0,0,,Мен жоғалтуым керек еді...
Dialogue: 0,0:12:22.53,0:12:25.36,Default,,0,0,0,,(жылау)
Dialogue: 0,0:12:30.95,0:12:32.66,Default,,0,0,0,,Бұл жерде екені анық.
Dialogue: 0,0:12:32.75,0:12:34.33,Default,,0,0,0,,Иә, осы жерде
Dialogue: 0,0:12:34.67,0:12:36.38,Default,,0,0,0,,Жылтыр болды.
Dialogue: 0,0:12:36.46,0:12:37.59,Default,,0,0,0,,Жарқ етті~
Dialogue: 0,0:12:37.67,0:12:38.79,Default,,0,0,0,,Ой!
Dialogue: 0,0:12:38.88,0:12:39.59,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:40.17,0:12:41.88,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:12:42.21,0:12:43.72,Default,,0,0,0,,Қалам шамын пайдалану -
Dialogue: 0,0:12:43.80,0:12:45.84,Default,,0,0,0,,Бұл алыстан басқарылатын машина сияқты.
Dialogue: 0,0:12:46.18,0:12:47.09,Default,,0,0,0,,Мүмкін-
Dialogue: 0,0:12:47.76,0:12:50.18,Default,,0,0,0,,Осыны Шуды соқыр ету үшін пайдаландым.
Dialogue: 0,0:12:50.39,0:12:53.18,Default,,0,0,0,,Ах! Джин жігіт!
Dialogue: 0,0:12:53.27,0:12:54.94,Default,,0,0,0,,Мен сені кешіре алмаймын!
Dialogue: 0,0:12:55.02,0:12:55.98,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:12:56.06,0:12:57.73,Default,,0,0,0,,Жібер, Дина!
Dialogue: 0,0:12:57.81,0:12:58.94,Default,,0,0,0,,Джин емес
Dialogue: 0,0:12:59.02,0:13:01.03,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Кінәлі Джин...
Dialogue: 0,0:13:01.11,0:13:02.78,Default,,0,0,0,,Джин Айзава емес!
Dialogue: 0,0:13:02.86,0:13:03.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:04.11,0:13:06.66,Default,,0,0,0,,Матч алдында мен Джинмен сөйлестім.
Dialogue: 0,0:13:07.45,0:13:09.37,Default,,0,0,0,,Мен оны жалғыз қалдыра алмаймын.
Dialogue: 0,0:13:10.74,0:13:12.66,Default,,0,0,0,,Мен сіздің жеңгіңіз келетінін түсіндім.
Dialogue: 0,0:13:13.25,0:13:14.37,Default,,0,0,0,,Мен де солай болдым.
Dialogue: 0,0:13:15.08,0:13:17.21,Default,,0,0,0,,Бірақ олар білмесе де...
Dialogue: 0,0:13:17.67,0:13:20.38,Default,,0,0,0,,Сіз не істегеніңізді жақсы білетін адамсыз.
Dialogue: 0,0:13:20.75,0:13:23.76,Default,,0,0,0,,Сіз маған заң бұзбаңыз деп айтқыңыз келе ме?
Dialogue: 0,0:13:24.30,0:13:26.13,Default,,0,0,0,,Қазір әлі уақыт бар
Dialogue: 0,0:13:26.51,0:13:28.68,Default,,0,0,0,,Шығанағыңызды бұзбаңыз
Dialogue: 0,0:13:30.05,0:13:31.56,Default,,0,0,0,,Бұл менің бірінші рет...
Dialogue: 0,0:13:31.93,0:13:33.77,Default,,0,0,0,,Әзірге оқиға...
Dialogue: 0,0:13:33.85,0:13:34.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:34.77,0:13:36.64,Default,,0,0,0,,Сен маған төмен қарайсың
Dialogue: 0,0:13:36.98,0:13:38.06,Default,,0,0,0,,Менімен-
Dialogue: 0,0:13:38.48,0:13:40.23,Default,,0,0,0,,Джормунганд!
Dialogue: 0,0:13:41.11,0:13:42.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:42.40,0:13:43.44,Default,,0,0,0,,Біз -
Dialogue: 0,0:13:43.53,0:13:46.40,Default,,0,0,0,,Мен бұзық жасамайынша жеңе алмайтындай әлсіз емеспін.
Dialogue: 0,0:13:48.03,0:13:49.87,Default,,0,0,0,,Бұл көздерде өтірік болған жоқ
Dialogue: 0,0:13:50.20,0:13:51.33,Default,,0,0,0,,Джин Айзава бұл...
Dialogue: 0,0:13:51.41,0:13:53.83,Default,,0,0,0,,Мен әлсіз қолдарымды пайдаланатын қуық емеспін.
Dialogue: 0,0:13:53.91,0:13:55.54,Default,,0,0,0,,Ендеше, ол кім?
Dialogue: 0,0:13:55.62,0:13:58.17,Default,,0,0,0,,Мұны жасайтын басқа ешкім жоқ.
Dialogue: 0,0:13:58.25,0:14:00.92,Default,,0,0,0,,Дұрыс, Наоки де солай айтты.
Dialogue: 0,0:14:01.00,0:14:02.13,Default,,0,0,0,,Не!
Dialogue: 0,0:14:03.50,0:14:06.67,Default,,0,0,0,,Үшінші шайқас таңғажайып соққы болды
Dialogue: 0,0:14:07.68,0:14:10.22,Default,,0,0,0,,Сенің жаның иеленді.
Dialogue: 0,0:14:10.68,0:14:13.26,Default,,0,0,0,,Бұл түсірілімді көзіңізді жұмып көріңіз...
Dialogue: 0,0:14:13.43,0:14:15.18,Default,,0,0,0,,Ол қорқынышты.
Dialogue: 0,0:14:15.27,0:14:16.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:16.81,0:14:18.60,Default,,0,0,0,,Егер мен сенен жеңілсем...
Dialogue: 0,0:14:18.85,0:14:22.15,Default,,0,0,0,,323 қамқоршы рухтар да түсінеді
Dialogue: 0,0:14:22.82,0:14:23.90,Default,,0,0,0,,Бенишу...
Dialogue: 0,0:14:24.57,0:14:26.36,Default,,0,0,0,,Мен сенімен күрескеніме қуаныштымын.
Dialogue: 0,0:14:27.36,0:14:28.40,Default,,0,0,0,,Жоғарыдағылар не ойлап отыр екен? Трост ауданына кіру – тек бекер өлімге апарады.
Dialogue: 0,0:14:28.49,0:14:29.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:31.03,0:14:33.53,Default,,0,0,0,,Мен бүгін шаршадым.
Dialogue: 0,0:14:33.62,0:14:34.70,Default,,0,0,0,,Эй!
Dialogue: 0,0:14:34.79,0:14:36.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:36.70,0:14:38.41,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:14:38.50,0:14:42.17,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:14:43.38,0:14:46.09,Default,,0,0,0,,Шукун
Dialogue: 0,0:14:50.84,0:14:52.97,Default,,0,0,0,,Түсіндірейін.
Dialogue: 0,0:14:53.47,0:14:55.39,Default,,0,0,0,,Неліктен Балтоға өтірік айттың?
Dialogue: 0,0:14:55.72,0:14:56.85,Default,,0,0,0,,Бұл қулық...
Dialogue: 0,0:14:56.93,0:14:58.77,Default,,0,0,0,,Бұл сіздің әрекетіңіз болуы керек!
Dialogue: 0,0:14:58.85,0:14:59.52,Default,,0,0,0,,Эй!
Dialogue: 0,0:15:00.98,0:15:03.15,Default,,0,0,0,,Демек, сіз бұл түсінбеушілік деп айтасыз!
Dialogue: 0,0:15:03.65,0:15:07.15,Default,,0,0,0,,Наоки маған Шудың менің ең жақын досым екенін айтты.
Dialogue: 0,0:15:07.23,0:15:10.40,Default,,0,0,0,,Балто... Осындай уақытта қоңырау шалғаным үшін кешіріңіз.
Dialogue: 0,0:15:10.78,0:15:13.32,Default,,0,0,0,,Мен ауырдым, дереу кел!
Dialogue: 0,0:15:13.66,0:15:14.74,Default,,0,0,0,,А...
Dialogue: 0,0:15:15.08,0:15:16.20,Default,,0,0,0,,Бұл…
Dialogue: 0,0:15:16.58,0:15:17.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:18.45,0:15:21.08,Default,,0,0,0,,Сол кезде... анамның дауысы!
Dialogue: 0,0:15:21.87,0:15:23.71,Default,,0,0,0,,Неліктен Наокидің планшетінен?
Dialogue: 0,0:15:23.79,0:15:26.09,Default,,0,0,0,,Балтоның анасының дауысын естідің бе?
Dialogue: 0,0:15:26.17,0:15:26.96,Default,,0,0,0,,Ой...!
Dialogue: 0,0:15:27.71,0:15:30.59,Default,,0,0,0,,Сол телефон қоңырауы... ол сен бе?
Dialogue: 0,0:15:31.22,0:15:32.22,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:32.43,0:15:35.22,Default,,0,0,0,,Тіпті IQ деңгейіңіз болса да түсіндіңіз бе?
Dialogue: 0,0:15:35.47,0:15:36.31,Default,,0,0,0,,…!
Dialogue: 0,0:15:36.72,0:15:38.22,Default,,0,0,0,,Токонацу Ника
Dialogue: 0,0:15:38.31,0:15:39.85,Default,,0,0,0,,Бауырыңды оят
Dialogue: 0,0:15:39.93,0:15:40.81,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:15:41.06,0:15:42.69,Default,,0,0,0,,(планшеттің жанасу дыбысы)
Dialogue: 0,0:15:44.31,0:15:47.52,Default,,0,0,0,,Дұрыс, мұның бәрі менің экспериментім.
Dialogue: 0,0:15:48.03,0:15:51.40,Default,,0,0,0,,Бейблейд теңдеуі үшін қажет болды.
Dialogue: 0,0:15:51.78,0:15:54.78,Default,,0,0,0,,Бейблейд...теңдеу...?
Dialogue: 0,0:15:55.49,0:15:57.91,Default,,0,0,0,,Сіздің деңгейлі сөздеріңізде...
Dialogue: 0,0:15:57.99,0:16:00.33,Default,,0,0,0,,Әр шайқаста қалай жеңуге болады
Dialogue: 0,0:16:01.00,0:16:02.79,Default,,0,0,0,,Ол аяқталуға жақын болды.
Dialogue: 0,0:16:02.87,0:16:06.00,Default,,0,0,0,,Барто Аои деп аталатын белгісіз элемент пайда болды.
Dialogue: 0,0:16:06.21,0:16:08.46,Default,,0,0,0,,Сондықтан сізді зерттеңіз ...
Dialogue: 0,0:16:08.55,0:16:09.88,Default,,0,0,0,,Мен тәжірибе жасадым.
Dialogue: 0,0:16:10.30,0:16:11.22,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:16:11.34,0:16:12.34,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:12.84,0:16:14.39,Default,,0,0,0,,Балтоны алдау
Dialogue: 0,0:16:14.47,0:16:16.76,Default,,0,0,0,,Шуды жаншу әрекеті эксперимент болды!
Dialogue: 0,0:16:16.93,0:16:17.76,Default,,0,0,0,,Иә
Dialogue: 0,0:16:17.85,0:16:20.18,Default,,0,0,0,,Сіздің арқаңызда біз жақсы мәліметтер ала алдық.
Dialogue: 0,0:16:20.89,0:16:22.94,Default,,0,0,0,,Тәжірибелер қызықты
Dialogue: 0,0:16:23.02,0:16:24.31,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:25.35,0:16:27.65,Default,,0,0,0,,Егер бұл сізге қажет болса, кешіріңіз.
Dialogue: 0,0:16:27.73,0:16:29.11,Default,,0,0,0,,Мен бос емеспін...
Dialogue: 0,0:16:29.53,0:16:30.48,Default,,0,0,0,,шығанақ...
Dialogue: 0,0:16:30.57,0:16:31.53,Default,,0,0,0,,Әлде бұл жыныстық сипаттағы қорлау үшін сылтау ма?
Dialogue: 0,0:16:31.74,0:16:32.99,Default,,0,0,0,,Бей!
Dialogue: 0,0:16:33.07,0:16:35.07,Default,,0,0,0,,Мұны эксперимент деп атамаңыз!
Dialogue: 0,0:16:35.86,0:16:38.03,Default,,0,0,0,,Эксперимент - бұл эксперимент.
Dialogue: 0,0:16:38.12,0:16:39.12,Default,,0,0,0,,…!
Dialogue: 0,0:16:39.33,0:16:40.66,Default,,0,0,0,,Балто!
Dialogue: 0,0:16:40.74,0:16:41.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:42.96,0:16:44.25,Default,,0,0,0,,Шу!
Dialogue: 0,0:16:47.50,0:16:49.55,Default,,0,0,0,,Жақсы, егер сіз қуық болсаңыз...
Dialogue: 0,0:16:49.63,0:16:51.42,Default,,0,0,0,,Беймен шайқасты шешіңіз.
Dialogue: 0,0:16:51.63,0:16:54.34,Default,,0,0,0,,Ах! Мен сені күшті етіп көрсетемін!
Dialogue: 0,0:16:54.43,0:16:57.43,Default,,0,0,0,,Мен шығанақта эксперимент жасайтын адамға ешқашан жеңілмеймін!
Dialogue: 0,0:16:57.80,0:16:59.93,Default,,0,0,0,,Иә! Ол сізге айтып береді.
Dialogue: 0,0:17:00.39,0:17:01.72,Default,,0,0,0,,Олай болса, бастайық!
Dialogue: 0,0:17:01.81,0:17:04.10,Default,,0,0,0,,Бұл шайқас бір оқтық матч!
Dialogue: 0,0:17:04.31,0:17:05.19,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:17:05.27,0:17:06.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:06.85,0:17:10.11,Default,,0,0,0,,Бұл менің жаңа теңдеуімді сынап көрудің жақсы мүмкіндігі
Dialogue: 0,0:17:10.77,0:17:13.53,Default,,0,0,0,,Ол сонымен қатар осы экспериментті растау ретінде қызмет етеді.
Dialogue: 0,0:17:13.99,0:17:15.74,Default,,0,0,0,,Бей эксперимент емес!
Dialogue: 0,0:17:16.20,0:17:17.03,Default,,0,0,0,,шығанақ...
Dialogue: 0,0:17:17.95,0:17:19.07,Default,,0,0,0,,шығанақ...
Dialogue: 0,0:17:20.03,0:17:20.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:21.79,0:17:23.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:23.66,0:17:25.79,Default,,0,0,0,,Иә... дұрыс...
Dialogue: 0,0:17:26.25,0:17:28.54,Default,,0,0,0,,Осылай ұрыссаң,
Dialogue: 0,0:17:28.63,0:17:31.17,Default,,0,0,0,,Валькири мені жек көретін болды.
Dialogue: 0,0:17:32.92,0:17:34.59,Default,,0,0,0,,Шайқас басталады!
Dialogue: 0,0:17:36.68,0:17:40.26,Default,,0,0,0,,Бұл жолы мен сені Нептун толқындарымен жұтамын!
Dialogue: 0,0:17:41.18,0:17:42.68,Default,,0,0,0,,(қосу режимдерінің дыбысы)
Dialogue: 0,0:17:42.77,0:17:44.85,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:17:44.93,0:17:47.98,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:48.06,0:17:50.06,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:53.86,0:17:56.53,Default,,0,0,0,,Сіздің ату күші түзетілді.
Dialogue: 0,0:17:56.61,0:17:57.91,Default,,0,0,0,,Нептунда...
Dialogue: 0,0:17:59.74,0:18:00.78,Default,,0,0,0,,​​О?
Dialogue: 0,0:18:00.87,0:18:03.29,Default,,0,0,0,,1100? Ақымақ!
Dialogue: 0,0:18:03.37,0:18:05.79,Default,,0,0,0,,Алға, Валькири!
Dialogue: 0,0:18:07.12,0:18:09.37,Default,,0,0,0,,Асық! асығыс! асығыс!
Dialogue: 0,0:18:09.46,0:18:11.79,Default,,0,0,0,,Не... Мынау не жігіт...
Dialogue: 0,0:18:13.59,0:18:15.84,Default,,0,0,0,,Менің теңдеуім абсолютті!
Dialogue: 0,0:18:15.92,0:18:17.34,Default,,0,0,0,,Нептун!
Dialogue: 0,0:18:18.18,0:18:19.80,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:18:21.47,0:18:24.77,Default,,0,0,0,,Асық! Валькирия!
Dialogue: 0,0:18:27.02,0:18:29.06,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:18:34.36,0:18:37.78,Default,,0,0,0,,(Қатты соқтығыстың дыбысы)
Dialogue: 0,0:18:37.86,0:18:39.28,Default,,0,0,0,,Толқынды ату!
Dialogue: 0,0:18:43.66,0:18:46.41,Default,,0,0,0,,Жүр!
Dialogue: 0,0:18:47.25,0:18:49.87,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:50.17,0:18:51.00,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:18:51.08,0:18:53.79,Default,,0,0,0,,Валькирияның жарылуы аяқталды!
Dialogue: 0,0:18:53.88,0:18:55.88,Default,,0,0,0,,Балто жеңді!
Dialogue: 0,0:18:56.21,0:18:58.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:00.30,0:19:02.72,Default,,0,0,0,,Бұл қызық болды!
Dialogue: 0,0:19:02.80,0:19:04.30,Default,,0,0,0,,Не? Валькири?
Dialogue: 0,0:19:04.39,0:19:07.52,Default,,0,0,0,,Жарайды, енді үйге ыңғайлы түрде бара аласыз!
Dialogue: 0,0:19:07.60,0:19:09.69,Default,,0,0,0,,Бұл таңқаларлық болды, бұл жарылды!
Dialogue: 0,0:19:09.77,0:19:10.85,Default,,0,0,0,,Ах
Dialogue: 0,0:19:11.23,0:19:12.90,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:12.98,0:19:13.94,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:15.36,0:19:19.11,Default,,0,0,0,,Осылайша, түсіру бұрышын 38 градусқа орнату арқылы
Dialogue: 0,0:19:19.49,0:19:23.37,Default,,0,0,0,,Соққы 13% күшті болады.
Dialogue: 0,0:19:23.57,0:19:26.49,Default,,0,0,0,,Үнемі осылай істе... (ер оқушы) Осы жерде жасайық.
Dialogue: 0,0:19:26.58,0:19:28.45,Default,,0,0,0,,О, жасайық!
Dialogue: 0,0:19:28.54,0:19:31.54,Default,,0,0,0,,Мен Наокидің не айтып тұрғанын мүлде түсінбеймін.
Dialogue: 0,0:19:31.62,0:19:33.33,Default,,0,0,0,,Аа, бұл өте қиын
Dialogue: 0,0:19:33.42,0:19:34.50,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:19:34.59,0:19:36.71,Default,,0,0,0,,Ешкім түсінбейді
Dialogue: 0,0:19:36.80,0:19:39.05,Default,,0,0,0,,Жарайды, енді кім барады?
Dialogue: 0,0:19:39.13,0:19:42.13,Default,,0,0,0,,Жоқ, сіз ғана түсінесіз.
Dialogue: 0,0:19:42.38,0:19:45.60,Default,,0,0,0,,Нептун, маған тек түсіну керек.
Dialogue: 0,0:19:45.68,0:19:48.47,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:52.19,0:19:53.40,Default,,0,0,0,,Ку...!
Dialogue: 0,0:19:53.60,0:19:56.36,Default,,0,0,0,,Мұндай нәрсенің пайдасы жоқ.
Dialogue: 0,0:19:59.32,0:20:01.36,Default,,0,0,0,,А...
Dialogue: 0,0:20:01.45,0:20:02.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:02.95,0:20:05.91,Default,,0,0,0,,Қал... Не істеп жатырсың, Наоки?
Dialogue: 0,0:20:05.99,0:20:08.41,Default,,0,0,0,,Керемет зерттеу, тіпті...
Dialogue: 0,0:20:08.49,0:20:09.87,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:20:09.95,0:20:11.04,Default,,0,0,0,,Зерттеу…
Dialogue: 0,0:20:12.08,0:20:13.92,Default,,0,0,0,,Өйткені сіз...
Dialogue: 0,0:20:14.00,0:20:17.09,Default,,0,0,0,,Олар деректерді жинау үшін таңғажайып машиналарды пайдалануы керек.
Dialogue: 0,0:20:17.17,0:20:19.59,Default,,0,0,0,,Мен шығанақтағы эксперименттерге рұқсат бере алмаймын...
Dialogue: 0,0:20:19.67,0:20:22.26,Default,,0,0,0,,Менің ойымша, сіздің зерттеу жүргізіп жатқаныңыз таңқаларлық!
Dialogue: 0,0:20:22.76,0:20:23.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:25.05,0:20:26.14,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:20:26.80,0:20:28.39,Default,,0,0,0,,Тағы да шайқасайық!
Dialogue: 0,0:20:28.81,0:20:32.10,Default,,0,0,0,,Мен сенімен көбірек шайқасамын.
Dialogue: 0,0:20:32.52,0:20:33.44,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,0:20:33.52,0:20:34.48,Default,,0,0,0,,Не!
Dialogue: 0,0:20:35.65,0:20:37.15,Default,,0,0,0,,Соны айтайын деп келдім.
Dialogue: 0,0:20:37.52,0:20:38.48,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:20:40.48,0:20:43.40,Default,,0,0,0,,Күтілгендей, белгісіздік көп
Dialogue: 0,0:20:44.57,0:20:46.87,Default,,0,0,0,,Болжау мүмкін емес
Dialogue: 0,0:20:47.74,0:20:49.28,Default,,0,0,0,,Менің теңдеуімде-
Dialogue: 0,0:20:49.37,0:20:51.75,Default,,0,0,0,,Жаңа айнымалыны қоспасаңыз
Dialogue: 0,0:20:52.12,0:20:53.04,Default,,0,0,0,,(сүріну дыбысы)
Dialogue: 0,0:20:53.12,0:20:54.37,Default,,0,0,0,,Ах~
Dialogue: 0,0:20:54.92,0:20:56.63,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:20:56.71,0:20:59.17,Default,,0,0,0,,Барлық деректерді жою аяқталды
Dialogue: 0,0:21:00.13,0:21:03.38,Default,,0,0,0,,Ой~!
Dialogue: 0,0:21:04.51,0:21:06.89,Default,,0,0,0,,Бұл керемет, Шу.
Dialogue: 0,0:21:06.97,0:21:08.30,Default,,0,0,0,,Тіпті көзім жұмылса да...
Dialogue: 0,0:21:08.39,0:21:11.18,Default,,0,0,0,,Сіз осындай таңғажайып кадр түсіре аласыз!
Dialogue: 0,0:21:11.85,0:21:12.85,Default,,0,0,0,,Өлім!
Dialogue: 0,0:21:12.93,0:21:14.89,Default,,0,0,0,,Қараңғыда ат! Уау...
Dialogue: 0,0:21:14.98,0:21:16.60,Default,,0,0,0,,Кішкене...
Dialogue: 0,0:21:16.69,0:21:17.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:18.48,0:21:20.32,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:21:20.48,0:21:21.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:25.78,0:21:27.32,Default,,0,0,0,,Бірақ мен қуаныштымын...
Dialogue: 0,0:21:27.74,0:21:29.20,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:21:29.78,0:21:30.49,Default,,0,0,0,,​​О?
Dialogue: 0,0:21:32.79,0:21:34.50,Default,,0,0,0,,Рахмет Балто
Dialogue: 0,0:21:38.67,0:21:39.58,Default,,0,0,0,,Hihii
Dialogue: 0,0:21:43.38,0:21:44.38,Default,,0,0,0,,♬~
Dialogue: 0,0:21:47.43,0:21:48.26,Default,,0,0,0,,Ха
Dialogue: 0,0:21:49.59,0:21:50.47,Default,,0,0,0,,Иә
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.44,0:23:28.19,Default,,0,0,0,,Е, Уакия...
Dialogue: 0,0:23:28.28,0:23:30.57,Default,,0,0,0,,Топтан кету деген нені білдіреді?
Dialogue: 0,0:23:30.65,0:23:33.53,Default,,0,0,0,,Осы уақытқа дейін бірге соғысып келдік емес пе?
Dialogue: 0,0:23:33.62,0:23:36.16,Default,,0,0,0,,Шу, саған...
Dialogue: 0,0:23:36.49,0:23:39.25,Default,,0,0,0,,Бұрынғыдай дос бола алмаймыз ба?
Dialogue: 0,0:23:39.33,0:23:41.58,Default,,0,0,0,,Жеңіс деген нені білдіреді?
Dialogue: 0,0:23:41.67,0:23:43.88,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.96,0:23:45.88,Default,,0,0,0,,Гейл ағыны!
Dialogue: 0,0:23:45.96,0:23:48.09,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.17,0:23:49.84,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.34,0:23:57.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory