Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:10.84,Default,,0,0,0,,Әлемдегі ең ләззат
Dialogue: 0,0:00:10.92,0:00:12.67,Default,,0,0,0,,Бұл тек шайқасқа арналған күнжіт
Dialogue: 0,0:00:12.76,0:00:14.80,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.88,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:34.32,0:00:36.45,Default,,0,0,0,,Керемет Беймен таныстыру!
Dialogue: 0,0:00:36.82,0:00:38.91,Default,,0,0,0,,Шака пайдаланған Xeno Excalibur
Dialogue: 0,0:00:38.99,0:00:40.29,Default,,0,0,0,,Өте керемет!
Dialogue: 0,0:00:40.83,0:00:43.12,Default,,0,0,0,,Мен де, Кумичо да жеңіліп қалдық.
Dialogue: 0,0:00:43.62,0:00:46.00,Default,,0,0,0,,Шақа бәрін бұзады...
Dialogue: 0,0:00:46.08,0:00:47.50,Default,,0,0,0,,Бұл ауыр болды ма?
Dialogue: 0,0:00:48.88,0:00:51.96,Default,,0,0,0,,Мен...Шақаны міндетті түрде жеңемін!
Dialogue: 0,0:00:52.46,0:00:54.84,Default,,0,0,0,,Келесі - командалар арасындағы топты таңдау.
Dialogue: 0,0:01:03.89,0:01:06.27,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:06.60,0:01:11.78,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:23.08,0:01:26.46,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:26.96,0:01:29.08,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:29.50,0:01:33.63,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:33.76,0:01:36.97,Default,,0,0,0,,Дұрыс, бетпе-бет.
Dialogue: 0,0:01:37.09,0:01:43.52,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:43.81,0:01:48.23,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:01:48.73,0:01:54.15,Default,,0,0,0,,Дауысты дауыстап, дірілдеп ойнайық
Dialogue: 0,0:01:54.28,0:01:56.53,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:01:56.61,0:02:01.32,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:01.49,0:02:06.58,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:06.87,0:02:09.12,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:09.33,0:02:11.67,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:11.96,0:02:15.88,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:16.05,0:02:21.05,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:21.26,0:02:23.43,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:27.18,0:02:29.60,Default,,0,0,0,,Өртен! Командалық шайқас!
Dialogue: 0,0:02:31.06,0:02:34.11,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:02:34.90,0:02:37.65,Default,,0,0,0,,Белгіленген уақыт таяп қалды.
Dialogue: 0,0:02:37.78,0:02:40.53,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:40.91,0:02:42.91,Default,,0,0,0,,Мен сені күттім, Балто.
Dialogue: 0,0:02:44.33,0:02:47.54,Default,,0,0,0,,Ой, ой, міне, келдік, Шақа!
Dialogue: 0,0:02:47.62,0:02:48.87,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:02:48.96,0:02:51.00,Default,,0,0,0,,Бұл өткен күн үшін кек!
Dialogue: 0,0:02:51.37,0:02:53.38,Default,,0,0,0,,О, мен де осыны қалаймын.
Dialogue: 0,0:02:53.46,0:02:54.67,Default,,0,0,0,,Өйткені, біз
Dialogue: 0,0:02:54.75,0:02:57.71,Default,,0,0,0,,Бәйшешек жасау – менің бірінші командалық жарысым.
Dialogue: 0,0:02:57.80,0:02:59.59,Default,,0,0,0,,Бұл өте жанып тұр
Dialogue: 0,0:02:59.67,0:03:00.51,Default,,0,0,0,,Не?
Dialogue: 0,0:03:00.59,0:03:02.97,Default,,0,0,0,,Командалық жарысқа бірінші рет қатысып жатырсыз ба?
Dialogue: 0,0:03:03.05,0:03:03.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:04.35,0:03:05.72,Default,,0,0,0,,Бұл қызық!
Dialogue: 0,0:03:05.81,0:03:07.18,Default,,0,0,0,,Оған тәуелді боласыз.
Dialogue: 0,0:03:07.27,0:03:09.31,Default,,0,0,0,,Тәуелдісіз бе?
Dialogue: 0,0:03:09.39,0:03:11.02,Default,,0,0,0,,Мен асығыспын
Dialogue: 0,0:03:11.10,0:03:12.48,Default,,0,0,0,,Сол рюкзак...
Dialogue: 0,0:03:12.56,0:03:14.44,Default,,0,0,0,,Бұл мүмкін емес, өте үлкен.
Dialogue: 0,0:03:14.52,0:03:15.94,Default,,0,0,0,,А... мынау...?
Dialogue: 0,0:03:16.48,0:03:20.65,Default,,0,0,0,,Түскі асқа анам жасаған бейблейд наны!
Dialogue: 0,0:03:20.74,0:03:21.65,Default,,0,0,0,,(Тынысы тарылған дыбыс)
Dialogue: 0,0:03:21.74,0:03:25.53,Default,,0,0,0,,Қараңдар, қараңдар (Токонацу Аои) Қайсысы екенін білесіңдер ме?
Dialogue: 0,0:03:26.83,0:03:29.04,Default,,0,0,0,,О~ Менің Рагнарук!
Dialogue: 0,0:03:29.12,0:03:32.75,Default,,0,0,0,,Валкири, Спригган және Деатсайзер бар ма?
Dialogue: 0,0:03:32.83,0:03:34.79,Default,,0,0,0,,Кербеус те бар.
Dialogue: 0,0:03:34.88,0:03:36.29,Default,,0,0,0,,Сондай-ақ осындай нәрсе бар
Dialogue: 0,0:03:36.38,0:03:38.30,Default,,0,0,0,,Кел мен Бет те бар.
Dialogue: 0,0:03:38.38,0:03:40.05,Default,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:03:40.13,0:03:41.42,Default,,0,0,0,,Мен өте қуаныштымын~
Dialogue: 0,0:03:41.51,0:03:42.13,Default,,0,0,0,,Ихихи
Dialogue: 0,0:03:42.22,0:03:44.01,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,0:03:44.09,0:03:46.55,Default,,0,0,0,,Бұл ысырап, мен оны жей алмаймын.
Dialogue: 0,0:03:46.64,0:03:49.47,Default,,0,0,0,,Эй, бәрі жақсы жасалған!
Dialogue: 0,0:03:49.72,0:03:52.98,Default,,0,0,0,,Шака Бұған таң қалуға әлі ерте.
Dialogue: 0,0:03:53.06,0:03:54.48,Default,,0,0,0,,Бүгінгі маңызды оқиға!
Dialogue: 0,0:03:54.56,0:03:56.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:56.44,0:03:58.02,Default,,0,0,0,,Экскалибур наны!
Dialogue: 0,0:03:58.23,0:03:59.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:59.36,0:04:01.03,Default,,0,0,0,,Кухахаха
Dialogue: 0,0:04:01.11,0:04:02.32,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:02.40,0:04:04.11,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:04:04.20,0:04:07.33,Default,,0,0,0,,Мен пішінді есте сақтауға барынша тырыстым және оны жасадым.
Dialogue: 0,0:04:07.41,0:04:08.58,Default,,0,0,0,,Есіңде ме...?
Dialogue: 0,0:04:08.66,0:04:11.37,Default,,0,0,0,,Бұл Бал-ни жазған Экскалибур.
Dialogue: 0,0:04:11.45,0:04:13.12,Default,,0,0,0,,Мен нанға үлгі ретінде қолдандым.
Dialogue: 0,0:04:15.00,0:04:16.58,Default,,0,0,0,,Оны әкелдің бе?
Dialogue: 0,0:04:16.67,0:04:18.50,Default,,0,0,0,,Бұл Excalibur ма?
Dialogue: 0,0:04:18.59,0:04:20.46,Default,,0,0,0,,Хмм, олар бір-біріне ұқсамайды.
Dialogue: 0,0:04:20.55,0:04:24.09,Default,,0,0,0,,Сипаттамаларды түсіндім деп айта аласыз ба...
Dialogue: 0,0:04:24.18,0:04:25.30,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:25.39,0:04:27.72,Default,,0,0,0,,Жарайды...Мен оны бір рет қана көрдім.
Dialogue: 0,0:04:27.80,0:04:29.51,Default,,0,0,0,,Хахаха
Dialogue: 0,0:04:29.93,0:04:31.68,Default,,0,0,0,,Дәмді көрінеді, солай емес пе?
Dialogue: 0,0:04:31.77,0:04:34.14,Default,,0,0,0,,Менің Yggdrasilpan...?
Dialogue: 0,0:04:34.35,0:04:35.44,Default,,0,0,0,,Мен үлгермедім.
Dialogue: 0,0:04:35.52,0:04:36.15,Default,,0,0,0,,Иә
Dialogue: 0,0:04:36.23,0:04:37.73,Default,,0,0,0,,Е...
Dialogue: 0,0:04:39.32,0:04:43.32,Default,,0,0,0,,Sword Flames және Йонекома академиясы арасындағы командалық шайқас
Dialogue: 0,0:04:43.40,0:04:44.40,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:04:44.49,0:04:46.03,Default,,0,0,0,,Бәріміз жеңейік!
Dialogue: 0,0:04:46.11,0:04:47.16,Default,,0,0,0,,О!
Dialogue: 0,0:04:47.24,0:04:49.74,Default,,0,0,0,,...Екі ғанасың ба?
Dialogue: 0,0:04:49.83,0:04:51.70,Default,,0,0,0,,Сан сәйкес емес
Dialogue: 0,0:04:51.79,0:04:52.58,Default,,0,0,0,,Хун
Dialogue: 0,0:04:52.83,0:04:55.58,Default,,0,0,0,,Сіз байқамаған сияқтысыз.
Dialogue: 0,0:04:55.67,0:04:57.17,Default,,0,0,0,,Тағы бір адам бар.
Dialogue: 0,0:04:57.25,0:04:58.67,Default,,0,0,0,,Сіз жаңа ғана сөйледіңіз.
Dialogue: 0,0:04:58.75,0:04:59.71,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,0:04:59.79,0:05:01.05,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,0:05:01.13,0:05:03.30,Default,,0,0,0,,Жоқ... елес...
Dialogue: 0,0:05:03.38,0:05:04.63,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:05:04.72,0:05:06.22,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:05:06.30,0:05:09.43,Default,,0,0,0,,Бұл елес пе? Ұқсас нәрсе.
Dialogue: 0,0:05:09.51,0:05:12.31,Default,,0,0,0,,Ұқсас нәрсе қандай?
Dialogue: 0,0:05:12.39,0:05:13.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:17.06,0:05:18.10,Default,,0,0,0,,Уау~
Dialogue: 0,0:05:18.19,0:05:19.36,Default,,0,0,0,,Уау
Dialogue: 0,0:05:19.77,0:05:21.23,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:05:21.98,0:05:22.65,Default,,0,0,0,,Хун
Dialogue: 0,0:05:24.86,0:05:27.24,Default,,0,0,0,,Сізді бірінші рет кездестіруім
Dialogue: 0,0:05:27.36,0:05:28.99,Default,,0,0,0,,Мен Укио Юкифукимін
Dialogue: 0,0:05:29.28,0:05:30.03,Default,,0,0,0,,Хун
Dialogue: 0,0:05:30.12,0:05:31.33,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:05:31.58,0:05:33.83,Default,,0,0,0,,Эй, сен қайда болдың?
Dialogue: 0,0:05:33.91,0:05:35.50,Default,,0,0,0,,Мен онда көптен бері жүрмін
Dialogue: 0,0:05:35.58,0:05:36.79,Default,,0,0,0,,Менің қасымда...
Dialogue: 0,0:05:36.87,0:05:39.58,Default,,0,0,0,,Мені Кейдж Фумидің Укиосы деп атайды.
Dialogue: 0,0:05:40.04,0:05:42.67,Default,,0,0,0,,Бұл біздің Доджоның құпия қаруы.
Dialogue: 0,0:05:42.75,0:05:44.26,Default,,0,0,0,,Құпия қару?
Dialogue: 0,0:05:44.34,0:05:46.13,Default,,0,0,0,,Өзіңіз айтасыз ба?
Dialogue: 0,0:05:46.22,0:05:47.76,Default,,0,0,0,,Укио – көлеңке
Dialogue: 0,0:05:47.84,0:05:49.64,Default,,0,0,0,,Ол әдетте көрінбейді.
Dialogue: 0,0:05:49.72,0:05:51.97,Default,,0,0,0,,Оның қандай адам екенін білмеймін.
Dialogue: 0,0:05:52.26,0:05:54.43,Default,,0,0,0,,Құпия қару дегеніміз не?
Dialogue: 0,0:05:54.52,0:05:57.19,Default,,0,0,0,,Біз сіз туралы білмейміз.
Dialogue: 0,0:05:57.27,0:06:00.31,Default,,0,0,0,,Бірақ сен де, бізде қандай шайқас болады?
Dialogue: 0,0:06:00.40,0:06:01.40,Default,,0,0,0,,Сіз білмейсіз.
Dialogue: 0,0:06:01.48,0:06:04.11,Default,,0,0,0,,Сіз байқамай қалдыңыз.
Dialogue: 0,0:06:04.19,0:06:05.74,Default,,0,0,0,,Мен әрқашан болдым
Dialogue: 0,0:06:05.82,0:06:08.11,Default,,0,0,0,,Әрқашан Шақаның қасында бол...
Dialogue: 0,0:06:08.99,0:06:09.99,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:06:10.62,0:06:11.87,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:06:11.95,0:06:13.74,Default,,0,0,0,,Ал сол кезде...
Dialogue: 0,0:06:13.83,0:06:17.04,Default,,0,0,0,,Мен бәріңді бақылап отырдым.
Dialogue: 0,0:06:17.12,0:06:18.92,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:06:19.00,0:06:20.83,Default,,0,0,0,,Сізге қоңырау шалу қиын болды ма деп ойлаймын.
Dialogue: 0,0:06:20.92,0:06:22.13,Default,,0,0,0,,Сіз сонда болдыңыз ба...?
Dialogue: 0,0:06:22.21,0:06:23.92,Default,,0,0,0,,Олай болса шық!
Dialogue: 0,0:06:24.00,0:06:25.92,Default,,0,0,0,,Бұл шынымен де көлеңкеге ұқсайды
Dialogue: 0,0:06:26.01,0:06:28.51,Default,,0,0,0,,Немесе... бұл жолы ниндзя ма?
Dialogue: 0,0:06:28.59,0:06:30.30,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:06:30.59,0:06:31.89,Default,,0,0,0,,Самурай мен Ниндзя
Dialogue: 0,0:06:32.22,0:06:33.35,Default,,0,0,0,,Менің дожом
Dialogue: 0,0:06:33.51,0:06:34.85,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:06:35.22,0:06:36.06,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:06:36.31,0:06:39.10,Default,,0,0,0,,Сіз де Шақаның командасының мүшесісіз, солай ма?
Dialogue: 0,0:06:39.23,0:06:42.27,Default,,0,0,0,,Мен Барто Аоимын. Бүгін танысқаныма қуаныштымын.
Dialogue: 0,0:06:43.77,0:06:44.69,Default,,0,0,0,,Әй...
Dialogue: 0,0:06:44.86,0:06:47.03,Default,,0,0,0,,Қол алысайық па?
Dialogue: 0,0:06:47.44,0:06:49.57,Default,,0,0,0,,Бұл іске қосқышты ұстап тұрған оң қол.
Dialogue: 0,0:06:49.65,0:06:52.07,Default,,0,0,0,,Мен оны ешкімге қалдырмаймын деп шештім.
Dialogue: 0,0:06:52.24,0:06:53.99,Default,,0,0,0,,Бұл жай ғана қол алысу.
Dialogue: 0,0:06:54.08,0:06:56.70,Default,,0,0,0,,Бірақ жүздің қолы киелі
Dialogue: 0,0:06:56.79,0:07:00.92,Default,,0,0,0,,Қол алысуың жүрегіммен қабыл болады.
Dialogue: 0,0:07:01.46,0:07:03.13,Default,,0,0,0,,Не... мына жігіт...
Dialogue: 0,0:07:03.21,0:07:05.21,Default,,0,0,0,,Ол мен түсінбейтін адам.
Dialogue: 0,0:07:06.30,0:07:08.17,Default,,0,0,0,,Түсінбейтін сенсің.
Dialogue: 0,0:07:08.26,0:07:09.26,Default,,0,0,0,,Уау
Dialogue: 0,0:07:09.34,0:07:10.80,Default,,0,0,0,,Мен сол қуыршақтан өтуім керек.
Dialogue: 0,0:07:10.88,0:07:14.10,Default,,0,0,0,,Сіз жолдастарыңызбен сөйлесе алмайсыз ба?
Dialogue: 0,0:07:14.18,0:07:15.05,Default,,0,0,0,,Мені жайына қалдыр
Dialogue: 0,0:07:15.14,0:07:16.47,Default,,0,0,0,,Кел және Бет
Dialogue: 0,0:07:16.56,0:07:18.18,Default,,0,0,0,,Сіз мұны есте сақтайсыз деп үміттенемін.
Dialogue: 0,0:07:18.27,0:07:19.56,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:19.64,0:07:21.19,Default,,0,0,0,,Мен оны есімде сақтаймын.
Dialogue: 0,0:07:22.06,0:07:24.23,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:07:24.31,0:07:25.40,Default,,0,0,0,,Укио
Dialogue: 0,0:07:25.48,0:07:27.40,Default,,0,0,0,,Барлығын қатты қорқытпа.
Dialogue: 0,0:07:27.48,0:07:28.82,Default,,0,0,0,,Сәлемдесу.
Dialogue: 0,0:07:28.90,0:07:30.11,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:30.19,0:07:32.07,Default,,0,0,0,,Олай болса, бастайық па?
Dialogue: 0,0:07:32.82,0:07:34.82,Default,,0,0,0,,Иә? Тек үш адам?
Dialogue: 0,0:07:34.91,0:07:36.83,Default,,0,0,0,,Мұнда бес адам бар.
Dialogue: 0,0:07:36.91,0:07:39.75,Default,,0,0,0,,Тоқта, күт, күт, Шу әлі жасай алмайды.
Dialogue: 0,0:07:39.83,0:07:42.25,Default,,0,0,0,,А, түсіндім. Төрт адам?
Dialogue: 0,0:07:42.33,0:07:44.63,Default,,0,0,0,,Командаға қосылғаным есімде жоқ.
Dialogue: 0,0:07:44.71,0:07:46.92,Default,,0,0,0,,Жарайды, біз командамыз.
Dialogue: 0,0:07:47.38,0:07:49.38,Default,,0,0,0,,Үшеуіміз жеткілікті.
Dialogue: 0,0:07:49.46,0:07:50.34,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:07:50.42,0:07:51.30,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:07:51.38,0:07:53.30,Default,,0,0,0,,Әдетте 4-тен 4-ке дейін болады.
Dialogue: 0,0:07:53.38,0:07:56.47,Default,,0,0,0,,Мен «қалыпты» деген нені білдіретінін білмеймін...
Dialogue: 0,0:07:56.55,0:07:57.72,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:57.81,0:07:59.27,Default,,0,0,0,,Баскетбол және волейбол
Dialogue: 0,0:07:59.35,0:08:02.23,Default,,0,0,0,,Барлық спорт түрлері бірдей адамдармен ойналады.
Dialogue: 0,0:08:02.31,0:08:05.73,Default,,0,0,0,,Бұл сіздің бет-әлпетіңізге сәйкес келмейді және сіз парасаттылықты қолданасыз.
Dialogue: 0,0:08:05.81,0:08:07.36,Default,,0,0,0,,Бет артық! Бет!
Dialogue: 0,0:08:07.44,0:08:08.90,Default,,0,0,0,,Күте тұрыңыз! Кумичо
Dialogue: 0,0:08:08.98,0:08:10.03,Default,,0,0,0,,Ұстаңыз
Dialogue: 0,0:08:10.11,0:08:11.28,Default,,0,0,0,,Жеңіске жетуге болады
Dialogue: 0,0:08:11.36,0:08:14.28,Default,,0,0,0,,Дұрыс! Барлығымыз жеңеміз деп үміттенемін
Dialogue: 0,0:08:14.36,0:08:15.45,Default,,0,0,0,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:08:16.87,0:08:17.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:18.20,0:08:18.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:18.95,0:08:21.45,Default,,0,0,0,,Қызықты. Барлығы жеңе ме?
Dialogue: 0,0:08:21.75,0:08:24.50,Default,,0,0,0,,Сол рух командалық шайқастардың мәні болып табылады.
Dialogue: 0,0:08:24.75,0:08:27.38,Default,,0,0,0,,Ах! Жеңіске жетейік! Мен жеңемін!
Dialogue: 0,0:08:27.46,0:08:29.21,Default,,0,0,0,,Қарашы, Шақа!
Dialogue: 0,0:08:29.30,0:08:31.09,Default,,0,0,0,,Қатты қызба, Кумичо
Dialogue: 0,0:08:31.17,0:08:33.13,Default,,0,0,0,,Қарқынға алданып қалмаңыз
Dialogue: 0,0:08:33.22,0:08:34.67,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:08:34.76,0:08:37.35,Default,,0,0,0,,Осы тік стадионда кек алыңыз!
Dialogue: 0,0:08:37.55,0:08:40.72,Default,,0,0,0,,Хахахаха жанып тұрған ғибадатхана арнайы
Dialogue: 0,0:08:40.81,0:08:41.89,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:08:42.93,0:08:45.39,Default,,0,0,0,,Бұл командалық жекпе-жек нокаутпен өтеді.
Dialogue: 0,0:08:45.48,0:08:46.56,Default,,0,0,0,,Нокаутпен кездесу…
Dialogue: 0,0:08:46.65,0:08:47.56,Default,,0,0,0,,Иә
Dialogue: 0,0:08:47.69,0:08:49.86,Default,,0,0,0,,Әр командадан бір адаммен шайқас.
Dialogue: 0,0:08:49.94,0:08:52.44,Default,,0,0,0,,Жеңімпаз келесі қарсыласымен жұдырықтасады...
Dialogue: 0,0:08:52.53,0:08:54.28,Default,,0,0,0,,Жеңілсек, кезектесіп аламыз.
Dialogue: 0,0:08:54.70,0:08:55.70,Default,,0,0,0,,Осыны жалғастырыңыз-
Dialogue: 0,0:08:55.78,0:08:59.33,Default,,0,0,0,,Соңына дейін пышақтары қалған команда жеңеді.
Dialogue: 0,0:08:59.41,0:09:01.54,Default,,0,0,0,,Енді тәртіпті шешіңіз.
Dialogue: 0,0:09:01.62,0:09:02.54,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:02.62,0:09:04.00,Default,,0,0,0,,Мен біріншімін
Dialogue: 0,0:09:04.08,0:09:06.50,Default,,0,0,0,,Е, маған №1 ұнайды.
Dialogue: 0,0:09:06.58,0:09:08.04,Default,,0,0,0,,Жарайды, мен істеймін!
Dialogue: 0,0:09:08.13,0:09:09.59,Default,,0,0,0,,Кербеустың кезегі!
Dialogue: 0,0:09:09.71,0:09:11.30,Default,,0,0,0,,Бұл Бал-нии...
Dialogue: 0,0:09:11.38,0:09:12.96,Default,,0,0,0,,Мен серпін алғым келеді.
Dialogue: 0,0:09:13.05,0:09:14.67,Default,,0,0,0,,Бұл Cerbeus~
Dialogue: 0,0:09:14.76,0:09:16.97,Default,,0,0,0,,Мен сендердің сезімдеріңді түсінемін.
Dialogue: 0,0:09:17.05,0:09:19.22,Default,,0,0,0,,Бірақ маған осында баруға рұқсат етіңіз.
Dialogue: 0,0:09:19.30,0:09:21.56,Default,,0,0,0,,Мен ұтылғым келмейді.
Dialogue: 0,0:09:22.01,0:09:23.52,Default,,0,0,0,,Мен де солай істеймін.
Dialogue: 0,0:09:25.81,0:09:26.89,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:09:26.98,0:09:27.73,Default,,0,0,0,,Дина?
Dialogue: 0,0:09:27.81,0:09:28.69,Default,,0,0,0,,Ах
Dialogue: 0,0:09:28.77,0:09:30.48,Default,,0,0,0,,Мен бірінші орында үздікпін.
Dialogue: 0,0:09:30.57,0:09:31.98,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:32.07,0:09:33.61,Default,,0,0,0,,Сол Укио жігіті...
Dialogue: 0,0:09:33.78,0:09:36.07,Default,,0,0,0,,Сіз бізді танитыныңызды айттыңыз.
Dialogue: 0,0:09:36.15,0:09:38.32,Default,,0,0,0,,Мен олармен өткен жолы ойнамадым.
Dialogue: 0,0:09:38.49,0:09:41.33,Default,,0,0,0,,Мен оның құпия қаруы боламын.
Dialogue: 0,0:09:41.53,0:09:43.08,Default,,0,0,0,,А, түсіндім.
Dialogue: 0,0:09:43.16,0:09:44.87,Default,,0,0,0,,Егер солай болса, мен оны сұрадым.
Dialogue: 0,0:09:44.95,0:09:46.66,Default,,0,0,0,,А, оны маған қалдырыңыз!
Dialogue: 0,0:09:46.87,0:09:49.33,Default,,0,0,0,,Мұндағы нөмір бірінші... Укио!
Dialogue: 0,0:09:49.42,0:09:50.38,Default,,0,0,0,,Сен бар
Dialogue: 0,0:09:51.63,0:09:52.38,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:55.26,0:09:56.80,Default,,0,0,0,,Бүгінгі сот үкімі -
Dialogue: 0,0:09:56.88,0:09:58.97,Default,,0,0,0,,Казама, сен істейсің.
Dialogue: 0,0:09:59.05,0:10:00.64,Default,,0,0,0,,Казама ер адам!
Dialogue: 0,0:10:02.05,0:10:05.14,Default,,0,0,0,,Қылыш жалындары Йонекома Гакуэн командасына қарсы
Dialogue: 0,0:10:05.22,0:10:06.93,Default,,0,0,0,,Нокаут матчын бастаңыз
Dialogue: 0,0:10:07.44,0:10:09.40,Default,,0,0,0,,Шайқас 2 ұпайлық жүйе
Dialogue: 0,0:10:09.65,0:10:12.36,Default,,0,0,0,,Бірінші 2 ұпай алған жеңеді.
Dialogue: 0,0:10:12.69,0:10:13.44,Default,,0,0,0,,Еркек!
Dialogue: 0,0:10:13.73,0:10:14.82,Default,,0,0,0,,Екінші дауыс жіпшелері: дауысты өзгертетін механизм маскасы
Dialogue: 0,0:10:14.90,0:10:17.32,Default,,0,0,0,,Қылыш оттары №1 Укио қарсы.
Dialogue: 0,0:10:17.40,0:10:20.49,Default,,0,0,0,,Йонекома академиясының №1 командасы Куроками Дина
Dialogue: 0,0:10:20.57,0:10:21.91,Default,,0,0,0,,Өтінемін, Дина!
Dialogue: 0,0:10:21.99,0:10:23.74,Default,,0,0,0,,Тікенектен сақ бол
Dialogue: 0,0:10:23.83,0:10:25.41,Default,,0,0,0,,Қатты жеңіске жету жақсы, бірақ...
Dialogue: 0,0:10:25.49,0:10:27.62,Default,,0,0,0,,Бізге де қалдырыңыз.
Dialogue: 0,0:10:28.21,0:10:30.12,Default,,0,0,0,,Мен ешқандай уәде бере алмаймын.
Dialogue: 0,0:10:30.71,0:10:32.63,Default,,0,0,0,,Қараңғы өлім өлшемі...
Dialogue: 0,0:10:33.04,0:10:34.38,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:34.46,0:10:36.92,Default,,0,0,0,,Қасқыр аты бар Бейблейд
Dialogue: 0,0:10:37.01,0:10:38.97,Default,,0,0,0,,Орақтың алдамшы соққысына —
Dialogue: 0,0:10:39.05,0:10:41.22,Default,,0,0,0,,Мен көптеген Блейдерлердің тарап кеткенін естідім.
Dialogue: 0,0:10:41.64,0:10:43.89,Default,,0,0,0,,Шинигами есімімен мақтанады
Dialogue: 0,0:10:43.97,0:10:46.97,Default,,0,0,0,,Бұл Deathsizer маған жақсы сәйкес келеді.
Dialogue: 0,0:10:47.14,0:10:48.60,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:49.94,0:10:52.19,Default,,0,0,0,,Енді көрсетейін.
Dialogue: 0,0:10:55.40,0:10:57.65,Default,,0,0,0,,Менің жалғыз мүйізді мүйізді құлпын ашыңыз!
Dialogue: 0,0:10:57.78,0:10:58.65,Default,,0,0,0,,Хм...!
Dialogue: 0,0:10:58.74,0:11:00.70,Default,,0,0,0,,Unicorn құлпын ашу керек пе?
Dialogue: 0,0:11:00.78,0:11:02.32,Default,,0,0,0,,Мен оны бірінші рет көрдім.
Dialogue: 0,0:11:02.41,0:11:03.87,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:11:03.95,0:11:07.66,Default,,0,0,0,,Оның қандай бек екенін сіз онымен күрескеннен кейін білесіз.
Dialogue: 0,0:11:07.75,0:11:09.66,Default,,0,0,0,,Ер адам! бірінші шайқас
Dialogue: 0,0:11:13.38,0:11:15.29,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:11:15.38,0:11:18.84,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:18.92,0:11:21.30,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:25.05,0:11:26.93,Default,,0,0,0,,Барыңыз~ Өлім өлшемі!
Dialogue: 0,0:11:27.01,0:11:28.47,Default,,0,0,0,,Бір кадрда шешім қабылдаңыз
Dialogue: 0,0:11:30.39,0:11:33.02,Default,,0,0,0,,Бұл дыбыс... ауырлық центрі айтарлықтай төмен.
Dialogue: 0,0:11:35.40,0:11:37.82,Default,,0,0,0,,Ол шайқалмайды, тұрақты
Dialogue: 0,0:11:37.90,0:11:38.65,Default,,0,0,0,,О
Dialogue: 0,0:11:42.24,0:11:43.86,Default,,0,0,0,,Ол қандай шабуылмен келеді?
Dialogue: 0,0:11:43.99,0:11:45.74,Default,,0,0,0,,Жақынырақ қараңыз
Dialogue: 0,0:11:45.99,0:11:47.99,Default,,0,0,0,,Unicorn құлпын ашу…
Dialogue: 0,0:11:48.16,0:11:50.29,Default,,0,0,0,,Жауды тыныш күту -
Dialogue: 0,0:11:50.54,0:11:52.54,Default,,0,0,0,,Және Фуми көлеңке!
Dialogue: 0,0:11:57.00,0:11:57.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:57.96,0:12:00.17,Default,,0,0,0,,Өлім Сізер жеңілді
Dialogue: 0,0:12:00.26,0:12:02.55,Default,,0,0,0,,Бұл шабуыл... ауыр...
Dialogue: 0,0:12:05.47,0:12:06.22,Default,,0,0,0,,Спайс!
Dialogue: 0,0:12:06.30,0:12:07.60,Default,,0,0,0,,Соқтығыс~
Dialogue: 0,0:12:08.39,0:12:09.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:09.47,0:12:10.43,Default,,0,0,0,,Ах~
Dialogue: 0,0:12:10.52,0:12:12.14,Default,,0,0,0,,Бұл жаман болған жоқ.
Dialogue: 0,0:12:12.23,0:12:13.73,Default,,0,0,0,,Неге жасырып жатырсың?
Dialogue: 0,0:12:14.10,0:12:15.94,Default,,0,0,0,,Маған қоңырау шалыңыз
Dialogue: 0,0:12:16.02,0:12:20.73,Default,,0,0,0,,Маған бір мүйіздің мақтаншақ жалын тигізуге рұқсат етіңіз
Dialogue: 0,0:12:27.03,0:12:28.24,Default,,0,0,0,,Өлім өлшемі!
Dialogue: 0,0:12:29.74,0:12:30.62,Default,,0,0,0,,Ах~
Dialogue: 0,0:12:32.00,0:12:33.08,Default,,0,0,0,,Таета!
Dialogue: 0,0:12:33.16,0:12:34.46,Default,,0,0,0,,Бұл стадион
Dialogue: 0,0:12:34.54,0:12:36.75,Default,,0,0,0,,Төбелерді соққан жеңеді!
Dialogue: 0,0:12:40.09,0:12:42.13,Default,,0,0,0,,Кеттік~ Өлімсіз!
Dialogue: 0,0:12:42.21,0:12:43.88,Default,,0,0,0,,Оны өшіріңіз!
Dialogue: 0,0:12:48.43,0:12:49.26,Default,,0,0,0,,Меніңше, бұл дұрыс; жеңілген ағам қателік жіберді.
Dialogue: 0,0:12:51.27,0:12:52.31,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:12:52.85,0:12:53.81,Default,,0,0,0,,Не...
Dialogue: 0,0:13:00.27,0:13:01.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:02.23,0:13:03.07,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:13:03.69,0:13:06.57,Default,,0,0,0,,(Еденге құлаған шығанақтың дыбысы)
Dialogue: 0,0:13:06.74,0:13:09.20,Default,,0,0,0,,Қараңғы өлім өлшемі аяқталды!
Dialogue: 0,0:13:09.28,0:13:11.29,Default,,0,0,0,,Куроками Динаға 1 ұпай!
Dialogue: 0,0:13:11.37,0:13:12.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:12.75,0:13:14.04,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:13:14.12,0:13:15.33,Default,,0,0,0,,Керемет! Дина!
Dialogue: 0,0:13:15.79,0:13:17.58,Default,,0,0,0,,Өлім Сізердің орағы...
Dialogue: 0,0:13:18.58,0:13:20.84,Default,,0,0,0,,Саған көлеңке түсірейін бе?
Dialogue: 0,0:13:21.75,0:13:24.97,Default,,0,0,0,,Ол бір жол тапқан сияқты.
Dialogue: 0,0:13:25.84,0:13:28.01,Default,,0,0,0,,Укио алдын ала алады...
Dialogue: 0,0:13:28.09,0:13:29.76,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:13:29.85,0:13:32.01,Default,,0,0,0,,Бұл да ойын.
Dialogue: 0,0:13:32.31,0:13:34.48,Default,,0,0,0,,Сіз қалай ойлайсыз? Бір мүйізділер ше?
Dialogue: 0,0:13:34.56,0:13:37.65,Default,,0,0,0,,Жалғыз мүйізділердің ауырлық орталығы өте төмен.
Dialogue: 0,0:13:37.73,0:13:40.86,Default,,0,0,0,,Сондықтан болар, тұрақты.
Dialogue: 0,0:13:40.94,0:13:43.57,Default,,0,0,0,,Мен жақсы жақтарын байқадым.
Dialogue: 0,0:13:43.65,0:13:44.78,Default,,0,0,0,,Уау
Dialogue: 0,0:13:44.86,0:13:47.15,Default,,0,0,0,,Жалғыз мүйіздің жалында тоғыз жүзі бар.
Dialogue: 0,0:13:47.24,0:13:50.07,Default,,0,0,0,,Қарсыластың шабуыл күшін таратады.
Dialogue: 0,0:13:50.16,0:13:52.16,Default,,0,0,0,,Тоғыз пышақ жалда?
Dialogue: 0,0:13:52.24,0:13:54.20,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:54.29,0:13:57.33,Default,,0,0,0,,Бірақ Deathsizer-тің ретсіз қимылдарымен және осы стадионмен...
Dialogue: 0,0:13:57.41,0:13:58.46,Default,,0,0,0,,Жеңіске жету мүмкіндігі бар!
Dialogue: 0,0:14:00.67,0:14:02.71,Default,,0,0,0,,Стратегия шешілді ме?
Dialogue: 0,0:14:03.05,0:14:04.26,Default,,0,0,0,,Бұл да ма?
Dialogue: 0,0:14:04.63,0:14:07.47,Default,,0,0,0,,Мен тек бір мүйізділерге сенемін
Dialogue: 0,0:14:07.55,0:14:11.14,Default,,0,0,0,,Unicorn-ның ең үлкен ерекшелігі - ине жүргізуші.
Dialogue: 0,0:14:11.22,0:14:14.52,Default,,0,0,0,,Өйткені ол Death Sizer шабуылын блоктайды.
Dialogue: 0,0:14:14.60,0:14:16.06,Default,,0,0,0,,Ине жүргізуші?
Dialogue: 0,0:14:16.64,0:14:17.98,Default,,0,0,0,,Міне.
Dialogue: 0,0:14:18.06,0:14:20.94,Default,,0,0,0,,Әлгі жүргізушінің басы үлкен.
Dialogue: 0,0:14:21.02,0:14:23.40,Default,,0,0,0,,Орталықты баяу айналдырыңыз
Dialogue: 0,0:14:23.48,0:14:25.03,Default,,0,0,0,,Оның тұрақты қозғалысы –
Dialogue: 0,0:14:25.11,0:14:27.53,Default,,0,0,0,,Шабуылдаушы қарсыластың күшін босатыңыз
Dialogue: 0,0:14:27.61,0:14:31.24,Default,,0,0,0,,Сондықтан оның үрлеу қиын болатын қасиеті бар.
Dialogue: 0,0:14:33.95,0:14:37.00,Default,,0,0,0,,Тұрақты емес қозғалыстармен сипатталатын Deathsizer дегеніміз не...
Dialogue: 0,0:14:37.08,0:14:38.91,Default,,0,0,0,,Үйлесімділік өте нашар.
Dialogue: 0,0:14:39.00,0:14:41.29,Default,,0,0,0,,Бұл қозғалыс бір мүйізділерге арналған...
Dialogue: 0,0:14:41.38,0:14:43.88,Default,,0,0,0,,Көлеңкеге қадам басуға тамаша мүмкіндік жасайды
Dialogue: 0,0:14:44.34,0:14:45.34,Default,,0,0,0,,(Иида) Турбо Герой Ингениумды білесің бе?
Dialogue: 0,0:14:45.42,0:14:47.51,Default,,0,0,0,,Сіз түтін шығарған жоқсыз ба?
Dialogue: 0,0:14:48.05,0:14:49.88,Default,,0,0,0,,Дәл қазір...
Dialogue: 0,0:14:50.22,0:14:52.68,Default,,0,0,0,,Бірінші шайқаста жеңіске жеттіңіз.
Dialogue: 0,0:14:52.93,0:14:55.56,Default,,0,0,0,,Мен сені қудым.
Dialogue: 0,0:14:55.64,0:14:56.93,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:14:57.02,0:15:00.39,Default,,0,0,0,,Бұл бірінші алынған нүктені қорғау үшін шайқас болады.
Dialogue: 0,0:15:00.48,0:15:01.77,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:15:01.85,0:15:05.23,Default,,0,0,0,,Қорғау шабуылға қарағанда қиынырақ.
Dialogue: 0,0:15:05.32,0:15:06.69,Default,,0,0,0,,Логика...
Dialogue: 0,0:15:06.78,0:15:09.40,Default,,0,0,0,,Қалыпты стадионда төбешіктер болмайды.
Dialogue: 0,0:15:09.49,0:15:12.32,Default,,0,0,0,,Енді бұл міндетті емес.
Dialogue: 0,0:15:12.82,0:15:13.45,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:14.12,0:15:15.78,Default,,0,0,0,,Аняру~
Dialogue: 0,0:15:15.87,0:15:18.25,Default,,0,0,0,,Сіз жеңіліп жатсаңыз да, маған соны айтып жатырсыз.
Dialogue: 0,0:15:18.33,0:15:19.96,Default,,0,0,0,,Шырылдап жатыр!
Dialogue: 0,0:15:20.04,0:15:22.29,Default,,0,0,0,,Екінші шайқас өрескел болуы мүмкін...
Dialogue: 0,0:15:22.37,0:15:23.33,Default,,0,0,0,,Мені міндетті түрде өлтіреді! ➡
Dialogue: 0,0:15:23.42,0:15:25.67,Default,,0,0,0,,Екінші шайқас та Динаныкі.
Dialogue: 0,0:15:25.75,0:15:28.01,Default,,0,0,0,,Дина жеңді! Мүлдем!
Dialogue: 0,0:15:28.09,0:15:29.63,Default,,0,0,0,,Гахахаха
Dialogue: 0,0:15:29.72,0:15:31.93,Default,,0,0,0,,Бұл шайқас жақсы емес пе?
Dialogue: 0,0:15:32.01,0:15:34.55,Default,,0,0,0,,Укио біраз уақыттан кейін бірінші рет толқып тұр!
Dialogue: 0,0:15:34.64,0:15:36.60,Default,,0,0,0,,Ұрысуға болатын қиын қарсылас
Dialogue: 0,0:15:36.68,0:15:38.35,Default,,0,0,0,,Міне.
Dialogue: 0,0:15:38.43,0:15:39.31,Default,,0,0,0,,Басталуы!
Dialogue: 0,0:15:39.39,0:15:40.39,Default,,0,0,0,,Еркек!
Dialogue: 0,0:15:40.56,0:15:42.14,Default,,0,0,0,,Екінші шайқас!
Dialogue: 0,0:15:47.15,0:15:48.44,Default,,0,0,0,,Екеуі де...
Dialogue: 0,0:15:48.73,0:15:50.44,Default,,0,0,0,,Мен оны өте қиғаш етіп жасадым.
Dialogue: 0,0:15:50.99,0:15:53.20,Default,,0,0,0,,Мен келесі матч болады деп шештім.
Dialogue: 0,0:15:53.53,0:15:56.08,Default,,0,0,0,,Күту және көру сияқты бірінші шайқас қандай болды?
Dialogue: 0,0:15:56.16,0:15:57.74,Default,,0,0,0,,Рух мүлде басқа
Dialogue: 0,0:15:57.95,0:15:59.41,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:15:59.50,0:16:00.83,Default,,0,0,0,,Жауап болды
Dialogue: 0,0:16:01.08,0:16:03.17,Default,,0,0,0,,Келесі шайқасқа мен де қатысамын!
Dialogue: 0,0:16:04.17,0:16:06.25,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:16:06.34,0:16:09.59,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:10.17,0:16:11.88,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:15.14,0:16:17.10,Default,,0,0,0,,Алып өтіңіз, Deathsizer!
Dialogue: 0,0:16:18.26,0:16:19.26,Default,,0,0,0,,Әй
Dialogue: 0,0:16:19.35,0:16:21.60,Default,,0,0,0,,Бұл Deathsizer болды ма?
Dialogue: 0,0:16:21.68,0:16:23.44,Default,,0,0,0,,Ауырлық центрі төмен шығанақтан күтілгендей.
Dialogue: 0,0:16:23.52,0:16:24.81,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:16:24.90,0:16:26.23,Default,,0,0,0,,Икке~
Dialogue: 0,0:16:29.69,0:16:31.32,Default,,0,0,0,,Әй~ тырнақтар!
Dialogue: 0,0:16:34.74,0:16:35.78,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:16:35.86,0:16:37.24,Default,,0,0,0,,Біз ұстадық!
Dialogue: 0,0:16:40.54,0:16:43.16,Default,,0,0,0,,Қызықты қимылдар жасаңыз
Dialogue: 0,0:16:43.50,0:16:45.67,Default,,0,0,0,,Бұл да есеп бойынша...
Dialogue: 0,0:16:45.75,0:16:48.63,Default,,0,0,0,,Deathsizer дағдарысты мүмкіндікке айналдырады!
Dialogue: 0,0:16:48.71,0:16:49.63,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:16:54.59,0:16:56.34,Default,,0,0,0,,Бірінші 1 ұпай алсаңыз да-
Dialogue: 0,0:16:56.43,0:16:58.93,Default,,0,0,0,,Мен қорғанысқа шықпаймын, мен шабуылға шығамын!
Dialogue: 0,0:16:59.01,0:17:00.93,Default,,0,0,0,,Бұл сізді қызықтырады.
Dialogue: 0,0:17:01.02,0:17:03.35,Default,,0,0,0,,Бірақ бір мүйізді мүйізділер тайынбайды!
Dialogue: 0,0:17:04.85,0:17:05.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:07.31,0:17:08.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:09.94,0:17:11.32,Default,,0,0,0,,Қандай шығанақ
Dialogue: 0,0:17:11.40,0:17:13.90,Default,,0,0,0,,Осыншама атудан кейін де ол құлап кетпей ме?
Dialogue: 0,0:17:13.99,0:17:17.45,Default,,0,0,0,,Осыншама күшті таратсаң да, ол тоқтамайды...
Dialogue: 0,0:17:17.66,0:17:19.20,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:17:19.28,0:17:20.66,Default,,0,0,0,,Бұл Қасқыр...
Dialogue: 0,0:17:24.41,0:17:26.04,Default,,0,0,0,,Сәттілік Deathsizer!
Dialogue: 0,0:17:26.12,0:17:27.04,Default,,0,0,0,,Жоғалтпа~
Dialogue: 0,0:17:27.12,0:17:28.13,Default,,0,0,0,,Жақсы шайқас
Dialogue: 0,0:17:28.25,0:17:32.00,Default,,0,0,0,,This is the first time I've been this tough against a unicorn.
Dialogue: 0,0:17:33.51,0:17:35.34,Default,,0,0,0,,Енді сіз және Deathsizer...
Dialogue: 0,0:17:35.42,0:17:37.30,Default,,0,0,0,,Сіз стадионды басқарасыз ба?
Dialogue: 0,0:17:37.38,0:17:38.59,Default,,0,0,0,,Ол неге ұқсайды?
Dialogue: 0,0:17:39.18,0:17:40.39,Default,,0,0,0,,Өкінішке орай...
Dialogue: 0,0:17:40.97,0:17:43.22,Default,,0,0,0,,Мен саған көлеңкем түспесін!
Dialogue: 0,0:17:43.31,0:17:45.39,Default,,0,0,0,,Шешіңіз! Өлім сенер!
Dialogue: 0,0:17:46.06,0:17:47.60,Default,,0,0,0,,（）
Dialogue: 0,0:17:50.61,0:17:52.11,Default,,0,0,0,,(Орағын сермеп жатқан Орақшының дыбысы)
Dialogue: 0,0:17:52.52,0:17:54.19,Default,,0,0,0,,Сіз сайысқа түстіңіз бе?
Dialogue: 0,0:17:54.28,0:17:56.28,Default,,0,0,0,,Шайқаңыз!
Dialogue: 0,0:17:58.57,0:18:00.95,Default,,0,0,0,,Цурануке! жалғыз мүйізді!
Dialogue: 0,0:18:09.37,0:18:10.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:12.75,0:18:14.21,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:17.13,0:18:17.97,Default,,0,0,0,,А...
Dialogue: 0,0:18:18.05,0:18:19.05,Default,,0,0,0,,Не...
Dialogue: 0,0:18:19.13,0:18:20.51,Default,,0,0,0,,А...
Dialogue: 0,0:18:20.59,0:18:21.51,Default,,0,0,0,,Ха
Dialogue: 0,0:18:21.60,0:18:23.60,Default,,0,0,0,,Жалғыз мүйізді жару
Dialogue: 0,0:18:23.68,0:18:26.31,Default,,0,0,0,,Укио Юкифуки 2-1 есебімен жеңіске жетті.
Dialogue: 0,0:18:26.39,0:18:29.14,Default,,0,0,0,,Team Battle Sword Flames жеңеді
Dialogue: 0,0:18:29.23,0:18:29.98,Default,,0,0,0,,Еркек!
Dialogue: 0,0:18:34.44,0:18:36.65,Default,,0,0,0,,Маған ұнады.
Dialogue: 0,0:18:36.78,0:18:38.07,Default,,0,0,0,,Куроками Дина...
Dialogue: 0,0:18:40.74,0:18:43.49,Default,,0,0,0,,Маған Укионы таңдау қиын болды.
Dialogue: 0,0:18:43.58,0:18:46.16,Default,,0,0,0,,Шынымды айтсам, қиын болды.
Dialogue: 0,0:18:46.25,0:18:49.16,Default,,0,0,0,,Бірақ бұл қорғаныс түрінің күштілігі.
Dialogue: 0,0:18:49.25,0:18:53.21,Default,,0,0,0,,Deathsizer қуатын тоғыз пышақпен таратыңыз.
Dialogue: 0,0:18:53.29,0:18:54.71,Default,,0,0,0,,Қорғадық және жеңдік!
Dialogue: 0,0:18:54.80,0:18:57.09,Default,,0,0,0,,Бұл жал ғажап
Dialogue: 0,0:18:57.17,0:18:58.09,Default,,0,0,0,,Тіпті бұл-
Dialogue: 0,0:18:58.17,0:19:01.26,Default,,0,0,0,,Unicorn әлі ешқандай арнайы қозғалыстарды көрсеткен жоқ.
Dialogue: 0,0:19:01.47,0:19:02.80,Default,,0,0,0,,Мен өліп жатырмын~
Dialogue: 0,0:19:02.89,0:19:05.18,Default,,0,0,0,,Тіпті ұрыспасам да~
Dialogue: 0,0:19:05.26,0:19:07.22,Default,,0,0,0,,Yggdrasilpan жоқ
Dialogue: 0,0:19:07.31,0:19:09.02,Default,,0,0,0,,Мүмкін сіз ашуланған шығарсыз
Dialogue: 0,0:19:09.10,0:19:12.06,Default,,0,0,0,,Мен ондай жігіт емеспін.
Dialogue: 0,0:19:12.15,0:19:14.90,Default,,0,0,0,,Қорғау және жеңу деген нені білдіреді?
Dialogue: 0,0:19:15.11,0:19:16.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:19.19,0:19:21.70,Default,,0,0,0,,Неге... мен жеңбедім...
Dialogue: 0,0:19:25.62,0:19:26.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:26.95,0:19:27.87,Default,,0,0,0,,Дина…
Dialogue: 0,0:19:28.66,0:19:31.58,Default,,0,0,0,,Бұлай бірінші болу керемет емес.
Dialogue: 0,0:19:31.67,0:19:34.17,Default,,0,0,0,,Құпия қарулар туралы айту аянышты.
Dialogue: 0,0:19:34.67,0:19:36.09,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:19:36.17,0:19:38.01,Default,,0,0,0,,Біз оны қайтарамыз.
Dialogue: 0,0:19:40.42,0:19:42.97,Default,,0,0,0,,Дина... жақсысың ба...
Dialogue: 0,0:19:43.22,0:19:43.89,Default,,0,0,0,,Ах
Dialogue: 0,0:19:44.34,0:19:46.35,Default,,0,0,0,,Келесі мен барамын!
Dialogue: 0,0:19:46.89,0:19:47.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:47.60,0:19:49.22,Default,,0,0,0,,Мен екіншімін!
Dialogue: 0,0:19:49.31,0:19:50.48,Default,,0,0,0,,Кумичо...
Dialogue: 0,0:19:50.89,0:19:53.35,Default,,0,0,0,,Мен Өлімсізердің жауымын!
Dialogue: 0,0:19:53.69,0:19:54.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:54.86,0:19:57.90,Default,,0,0,0,,Маған қалдырыңыз! Командалық шайқастар маған жарасады!
Dialogue: 0,0:19:57.98,0:20:01.99,Default,,0,0,0,,Достар үшін күресу - ең жанып тұрған үлгі!
Dialogue: 0,0:20:02.07,0:20:04.03,Default,,0,0,0,,Түсіндім! Кумичо!
Dialogue: 0,0:20:04.11,0:20:06.41,Default,,0,0,0,,Менде де жанып тұрған өрнегі бар.
Dialogue: 0,0:20:06.49,0:20:09.04,Default,,0,0,0,,Бұл жерді Кумичоға қалдырайық.
Dialogue: 0,0:20:09.45,0:20:11.91,Default,,0,0,0,,Кумичо, жеңілме!
Dialogue: 0,0:20:12.00,0:20:14.58,Default,,0,0,0,,Мұндай жағдайда «жеңді» деп айту дұрыс болар еді.
Dialogue: 0,0:20:14.67,0:20:16.00,Default,,0,0,0,,Сәлем Кейдж Фуми
Dialogue: 0,0:20:16.08,0:20:17.84,Default,,0,0,0,,Келесі қарсылас – мен!
Dialogue: 0,0:20:18.17,0:20:19.96,Default,,0,0,0,,Бұл Рагнарук.
Dialogue: 0,0:20:20.05,0:20:21.55,Default,,0,0,0,,Алайық
Dialogue: 0,0:20:22.09,0:20:23.55,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:20:23.80,0:20:24.97,Default,,0,0,0,,Сәлем, Балто
Dialogue: 0,0:20:25.05,0:20:26.80,Default,,0,0,0,,Мені шығанақ клубына шақырғаны үшін
Dialogue: 0,0:20:26.89,0:20:28.01,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:20:28.35,0:20:30.18,Default,,0,0,0,,Кенеттен не болды...
Dialogue: 0,0:20:30.27,0:20:32.81,Default,,0,0,0,,Ойынды топпен байланыстыр...
Dialogue: 0,0:20:33.06,0:20:35.44,Default,,0,0,0,,Бұл өте жақсы, солай емес пе? Мынадай нәрсе
Dialogue: 0,0:20:35.85,0:20:36.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:37.06,0:20:39.52,Default,,0,0,0,,Өйткені маған бұл мүше ұнайды.
Dialogue: 0,0:20:39.86,0:20:42.44,Default,,0,0,0,,Менің байқауым барлығына пайдалы болатынына сене алмаймын.
Dialogue: 0,0:20:42.53,0:20:43.86,Default,,0,0,0,,Бұл тамаша болар еді!
Dialogue: 0,0:20:43.95,0:20:44.78,Default,,0,0,0,,Иә
Dialogue: 0,0:20:45.28,0:20:47.07,Default,,0,0,0,,Иә! Бұл дұрыс!
Dialogue: 0,0:20:47.16,0:20:49.83,Default,,0,0,0,,Бұл жай ғана қарттың саудасы.
Dialogue: 0,0:20:49.91,0:20:50.99,Default,,0,0,0,,Қария...?
Dialogue: 0,0:20:51.08,0:20:52.25,Default,,0,0,0,,Ах
Dialogue: 0,0:20:52.54,0:20:54.79,Default,,0,0,0,,Ол менің ескі детективім...
Dialogue: 0,0:20:55.25,0:20:57.13,Default,,0,0,0,,Сіз маған үнемі айтасыз
Dialogue: 0,0:20:57.21,0:21:00.25,Default,,0,0,0,,Қоғамға пайдалы адам болу...
Dialogue: 0,0:21:01.63,0:21:02.80,Default,,0,0,0,,Көлеңке Фуми!
Dialogue: 0,0:21:03.05,0:21:04.93,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:21:05.01,0:21:06.89,Default,,0,0,0,,Динаға еңбегіңіз үшін рахмет.
Dialogue: 0,0:21:06.97,0:21:09.30,Default,,0,0,0,,Мен жалғыз мүйізді шайқастан бас тарттым!
Dialogue: 0,0:21:09.39,0:21:12.39,Default,,0,0,0,,Мен сіздің соңғы шайқасыңызды бақылап отырдым.
Dialogue: 0,0:21:12.72,0:21:13.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:13.85,0:21:15.14,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:21:15.23,0:21:17.90,Default,,0,0,0,,Менің қазіргі адамым бұрынғы адамнан басқаша.
Dialogue: 0,0:21:17.98,0:21:18.81,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:21:18.90,0:21:20.36,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:21:20.44,0:21:22.99,Default,,0,0,0,,Мен оны жек көрмеймін~ Бұл рух
Dialogue: 0,0:21:23.07,0:21:25.40,Default,,0,0,0,,Жақсылап қарайық.
Dialogue: 0,0:21:25.49,0:21:28.03,Default,,0,0,0,,Кәне, жасайық! жалғыз мүйізді!
Dialogue: 0,0:21:28.12,0:21:30.03,Default,,0,0,0,,Мен сенің бұрышыңды бұзамын!
Dialogue: 0,0:21:30.37,0:21:31.37,Default,,0,0,0,,Бірмүйіз
Dialogue: 0,0:21:31.45,0:21:33.70,Default,,0,0,0,,Рагнаруктың көлеңкесінде жүреміз бе?
Dialogue: 0,0:21:34.29,0:21:35.91,Default,,0,0,0,,Бұл сізді алаңдатпасын!
Dialogue: 0,0:21:36.00,0:21:36.96,Default,,0,0,0,,Еркек!
Dialogue: 0,0:21:37.12,0:21:40.13,Default,,0,0,0,,Іріктеу матчтарының екінші кезеңі басталды.
Dialogue: 0,0:21:41.00,0:21:42.21,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:42.50,0:21:43.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:44.34,0:21:46.51,Default,,0,0,0,,Кумичо жеңді!
Dialogue: 0,0:21:46.88,0:21:48.80,Default,,0,0,0,,Кумичо жүр!
Dialogue: 0,0:21:48.89,0:21:51.56,Default,,0,0,0,,Әй, бұл шайқас өртеніп жатыр!
Dialogue: 0,0:22:09.74,0:22:15.83,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:16.04,0:22:22.17,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.63,0:22:28.18,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.63,0:22:31.97,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:32.14,0:22:37.06,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.98,0:22:41.69,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.77,0:22:44.98,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:45.07,0:22:51.41,Default,,0,0,0,,Артынан қусаң көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.66,0:22:57.20,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:57.37,0:23:03.96,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.54,0:23:09.97,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:10.13,0:23:13.30,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.80,0:23:17.77,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.98,0:23:30.57,Default,,0,0,0,,Кумичо мен Укио Кагефуми арасындағы кездесу өте керемет.
Dialogue: 0,0:23:30.65,0:23:33.03,Default,,0,0,0,,Арнайы қозғалыстар бетпе-бет соқтығысады
Dialogue: 0,0:23:33.12,0:23:35.03,Default,,0,0,0,,Бұл адамның ойыны!
Dialogue: 0,0:23:35.33,0:23:37.04,Default,,0,0,0,,Осындай текетірестің ортасында...
Dialogue: 0,0:23:37.12,0:23:39.00,Default,,0,0,0,,Инуске біртүрлі әрекет етеді.
Dialogue: 0,0:23:39.08,0:23:40.41,Default,,0,0,0,,Бірдеңе болды ма...
Dialogue: 0,0:23:40.50,0:23:42.12,Default,,0,0,0,,Маған жауап бер, Инуске.
Dialogue: 0,0:23:42.54,0:23:44.67,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.75,0:23:46.84,Default,,0,0,0,,Рагнарук VS Unicorn!
Dialogue: 0,0:23:46.92,0:23:48.71,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.80,0:23:50.30,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.80,0:23:57.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory