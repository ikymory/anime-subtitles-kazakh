Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.42,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.51,0:00:14.68,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.76,0:00:16.89,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.97,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.64,0:00:24.06,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.14,0:00:26.23,Default,,0,0,0,,Бейде арманмен күрес
Dialogue: 0,0:00:26.35,0:00:28.61,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.03,0:00:32.69,Default,,0,0,0,,Енді келесі шайқас
Dialogue: 0,0:00:32.78,0:00:35.32,Default,,0,0,0,,Balt Aoi VS Naoki Mizusurface.
Dialogue: 0,0:00:35.78,0:00:38.78,Default,,0,0,0,,Бірінші пайда болған адам - Mizusurface Naoki
Dialogue: 0,0:00:39.91,0:00:43.75,Default,,0,0,0,,Келесі адам - Аои Барто!
Dialogue: 0,0:00:43.83,0:00:46.96,Default,,0,0,0,,Әй, Аои Барто... Әй?
Dialogue: 0,0:00:47.08,0:00:47.88,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:00:47.96,0:00:49.09,Default,,0,0,0,,Бар аға...
Dialogue: 0,0:00:49.17,0:00:50.13,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:00:50.21,0:00:51.25,Default,,0,0,0,,Әлгі ақымақ!
Dialogue: 0,0:00:51.84,0:00:54.47,Default,,0,0,0,,Не болды! Ай Балт!
Dialogue: 0,0:00:54.55,0:00:55.68,Default,,0,0,0,,Барт…
Dialogue: 0,0:00:55.76,0:00:57.14,Default,,0,0,0,,Бітті.
Dialogue: 0,0:00:57.30,0:00:58.76,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:00:58.89,0:00:59.80,Default,,0,0,0,,Қалыс қалды деп есептелді…
Dialogue: 0,0:00:59.89,0:01:02.06,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:01:03.85,0:01:05.44,Default,,0,0,0,,Хаха...
Dialogue: 0,0:01:05.52,0:01:08.35,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:01:09.23,0:01:11.36,Default,,0,0,0,,Бірінші раунд Мизусурфэйс Наокиге қарсы
Dialogue: 0,0:01:11.78,0:01:13.69,Default,,0,0,0,,Әйтеуір дер кезінде үлгердім
Dialogue: 0,0:01:14.61,0:01:16.28,Default,,0,0,0,,Амансың ба? Сіз
Dialogue: 0,0:01:16.82,0:01:19.03,Default,,0,0,0,,Бұл... жақсы!
Dialogue: 0,0:01:19.99,0:01:22.74,Default,,0,0,0,,Тәжірибелер қызықты
Dialogue: 0,0:01:22.83,0:01:25.58,Default,,0,0,0,,Жүр, шайқасайық!
Dialogue: 0,0:01:33.76,0:01:36.13,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:36.47,0:01:41.64,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:52.94,0:01:56.32,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:56.82,0:01:58.95,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:59.36,0:02:03.49,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:03.62,0:02:06.83,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:06.96,0:02:13.38,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:13.67,0:02:18.09,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:18.59,0:02:24.01,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:24.14,0:02:26.39,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:26.47,0:02:31.19,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:31.35,0:02:36.44,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:36.73,0:02:38.99,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:39.20,0:02:41.53,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:41.82,0:02:45.74,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:45.91,0:02:50.92,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:51.12,0:02:53.29,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:57.38,0:02:59.17,Default,,0,0,0,,Нептун тұзағы
Dialogue: 0,0:03:01.43,0:03:02.64,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:03:02.72,0:03:04.26,Default,,0,0,0,,Ұлдар мен қыздар!
Dialogue: 0,0:03:04.35,0:03:06.97,Default,,0,0,0,,Блейдерді тағы да таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:03:07.81,0:03:10.73,Default,,0,0,0,,Beyblade IQ Blader туралы ғылым
Dialogue: 0,0:03:10.81,0:03:12.44,Default,,0,0,0,,Mizusurface Naoki!
Dialogue: 0,0:03:12.52,0:03:14.36,Default,,0,0,0,,шығанақ - Жаңа Нептун
Dialogue: 0,0:03:14.73,0:03:16.77,Default,,0,0,0,,Стадионға түскен теңіз құдайы...
Dialogue: 0,0:03:16.86,0:03:19.61,Default,,0,0,0,,Жеңіс толқынын жасай аламыз ба?
Dialogue: 0,0:03:20.11,0:03:21.57,Default,,0,0,0,,Бұл ақымақ сұрақ.
Dialogue: 0,0:03:21.65,0:03:24.53,Default,,0,0,0,,Деректерге қарасаңыз, менің жеңгенім анық.
Dialogue: 0,0:03:25.45,0:03:27.95,Default,,0,0,0,,Ал командалық жарыстың жүлдегері...
Dialogue: 0,0:03:28.04,0:03:30.50,Default,,0,0,0,,Bay Arena-да жаңа сезіммен тұру!
Dialogue: 0,0:03:30.58,0:03:33.75,Default,,0,0,0,,Керемет ғажайып бала Барто Аои!
Dialogue: 0,0:03:33.83,0:03:36.13,Default,,0,0,0,,шығанақ - бұл Жеңіс Валькирия!
Dialogue: 0,0:03:36.46,0:03:39.05,Default,,0,0,0,,Біз қызу шайқас күтеміз!
Dialogue: 0,0:03:41.72,0:03:43.68,Default,,0,0,0,,Ұлттық турнир 1-тур
Dialogue: 0,0:03:43.89,0:03:46.47,Default,,0,0,0,,Жеңіске жетейік, Валькири!
Dialogue: 0,0:03:46.55,0:03:48.85,Default,,0,0,0,,Күтуден шаршадым, Балто.
Dialogue: 0,0:03:48.93,0:03:51.06,Default,,0,0,0,,Мен жеңе алмайтынымды қабылдай алмаймын.
Dialogue: 0,0:03:51.14,0:03:53.65,Default,,0,0,0,,Бар-нии шайқасы~! Ұрыс~!
Dialogue: 0,0:03:53.73,0:03:55.69,Default,,0,0,0,,Сіз оны уақытында жасай алдыңыз ба?
Dialogue: 0,0:03:55.77,0:03:56.65,Default,,0,0,0,,Ах
Dialogue: 0,0:03:57.23,0:03:59.86,Default,,0,0,0,,Сіз қамқор адам болуыңыз керек, хонма.
Dialogue: 0,0:04:00.40,0:04:01.99,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:04:03.53,0:04:06.32,Default,,0,0,0,,Мен бүгін нанды көп жедім деп ойлаймын.
Dialogue: 0,0:04:06.87,0:04:09.33,Default,,0,0,0,,Бұрынғыдай емес, Наоки!
Dialogue: 0,0:04:09.74,0:04:12.29,Default,,0,0,0,,Ғылым күн сайын дамып келеді
Dialogue: 0,0:04:12.66,0:04:15.50,Default,,0,0,0,,Мәліметтерді жинау және талдау арқылы.
Dialogue: 0,0:04:16.50,0:04:17.46,Default,,0,0,0,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:04:17.63,0:04:19.17,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:04:20.17,0:04:21.46,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:04:25.59,0:04:27.51,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:04:28.01,0:04:30.97,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:31.06,0:04:33.18,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:36.77,0:04:38.27,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:04:38.36,0:04:40.57,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:04:42.65,0:04:44.32,Default,,0,0,0,,Деректер бойынша
Dialogue: 0,0:04:47.37,0:04:48.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:48.41,0:04:50.83,Default,,0,0,0,,Өткен күнгі Нептуннан айырмашылығы бар ма?
Dialogue: 0,0:04:50.91,0:04:53.54,Default,,0,0,0,,Валькири саған қарай жүгіреді
Dialogue: 0,0:04:53.62,0:04:55.71,Default,,0,0,0,,Жарайсыңдар! Мен оны түсіндім!
Dialogue: 0,0:04:55.79,0:04:57.83,Default,,0,0,0,,Алып өтіңіз! Валькирия!
Dialogue: 0,0:04:57.92,0:04:59.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:59.29,0:05:01.17,Default,,0,0,0,,Нептун қашып кетті!
Dialogue: 0,0:05:01.34,0:05:04.55,Default,,0,0,0,,Асық, Валькири! Шабуыл жасай беріңіз!
Dialogue: 0,0:05:06.55,0:05:09.47,Default,,0,0,0,,Ой, міне, тағы барамыз! Мен Нептуннан жалтардым!
Dialogue: 0,0:05:09.55,0:05:11.31,Default,,0,0,0,,Бұл жігіт күшті
Dialogue: 0,0:05:11.39,0:05:12.81,Default,,0,0,0,,Сенгісіз!
Dialogue: 0,0:05:12.89,0:05:15.77,Default,,0,0,0,,Валькири қаша береді!
Dialogue: 0,0:05:15.85,0:05:17.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:17.27,0:05:19.61,Default,,0,0,0,,Валькири қарқынын жоғалтады.
Dialogue: 0,0:05:19.69,0:05:21.82,Default,,0,0,0,,Сіз қанша уақыт шыдай аласыз?
Dialogue: 0,0:05:21.90,0:05:22.86,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:05:23.19,0:05:24.94,Default,,0,0,0,,Міне!
Dialogue: 0,0:05:25.11,0:05:26.45,Default,,0,0,0,,Ол тоқтады!
Dialogue: 0,0:05:26.53,0:05:29.32,Default,,0,0,0,,Нептун ыңғайлы жұмыс істейді!
Dialogue: 0,0:05:29.99,0:05:33.58,Default,,0,0,0,,Су бетінде сырғанап жатқан толқындар сияқты әсем.
Dialogue: 0,0:05:34.12,0:05:37.62,Default,,0,0,0,,Spin Finish Nova Neptun 1 ұпай!
Dialogue: 0,0:05:37.75,0:05:39.42,Default,,0,0,0,,Бірінші шайқас –
Dialogue: 0,0:05:39.50,0:05:42.55,Default,,0,0,0,,Төзімділік шайқасында Мизусурфэйс Наоки алға шықты!
Dialogue: 0,0:05:42.63,0:05:44.05,Default,,0,0,0,,Шабуыл...
Dialogue: 0,0:05:44.34,0:05:46.05,Default,,0,0,0,,Барлығы қашып кетті
Dialogue: 0,0:05:46.38,0:05:48.55,Default,,0,0,0,,Егер сізде қарсыластың соққы деректері болса -
Dialogue: 0,0:05:48.93,0:05:50.76,Default,,0,0,0,,Болдырмау үшін жол радиусы...
Dialogue: 0,0:05:50.85,0:05:53.22,Default,,0,0,0,,Жылдамдықты анықтау оңай.
Dialogue: 0,0:05:53.31,0:05:55.56,Default,,0,0,0,,Айтпа, бейбақ.
Dialogue: 0,0:05:55.81,0:05:57.85,Default,,0,0,0,,Мен Нептунға сенімдімін...
Dialogue: 0,0:05:57.94,0:05:59.52,Default,,0,0,0,,Бұл теңдестірілген тип болды.
Dialogue: 0,0:05:59.81,0:06:00.61,Default,,0,0,0,,Ах
Dialogue: 0,0:06:00.69,0:06:02.61,Default,,0,0,0,,Қазіргі қозғалыс...
Dialogue: 0,0:06:02.69,0:06:04.57,Default,,0,0,0,,Бұл төзімділік түрі сияқты көрінді, бірақ...
Dialogue: 0,0:06:04.65,0:06:06.19,Default,,0,0,0,,(планшеттің жанасу дыбысы)
Dialogue: 0,0:06:06.53,0:06:08.45,Default,,0,0,0,,Тіпті трансформатор жүргізушісі!
Dialogue: 0,0:06:08.65,0:06:09.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:10.03,0:06:11.70,Default,,0,0,0,,Оны жындармен бірге басын кесеміз!
Dialogue: 0,0:06:11.78,0:06:14.58,Default,,0,0,0,,Nova Neptune трансформаторының драйвері -
Dialogue: 0,0:06:14.66,0:06:16.04,Default,,0,0,0,,Шабуыл және төзімділік
Dialogue: 0,0:06:16.12,0:06:19.21,Default,,0,0,0,,Екі режим арасында ауыса алады
Dialogue: 0,0:06:19.29,0:06:21.38,Default,,0,0,0,,Шабуыл шабуыл түрі болып табылады -
Dialogue: 0,0:06:21.46,0:06:26.30,Default,,0,0,0,,Төзімділік шыдамдылық типті қозғалыстарды орындауға мүмкіндік береді...
Dialogue: 0,0:06:26.59,0:06:27.84,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:06:28.05,0:06:30.18,Default,,0,0,0,,Бұл деформацияланатын бұрағыш болды ма?
Dialogue: 0,0:06:30.64,0:06:31.89,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:06:31.97,0:06:33.43,Default,,0,0,0,,Бірінші шайқас алдында-
Dialogue: 0,0:06:35.39,0:06:37.48,Default,,0,0,0,,Режимді осылай ауыстырдыңыз.
Dialogue: 0,0:06:38.14,0:06:39.64,Default,,0,0,0,,Мен ағама айтуым керек.
Dialogue: 0,0:06:39.73,0:06:40.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:40.77,0:06:42.44,Default,,0,0,0,,Бару-нии~ Нии-чан~
Dialogue: 0,0:06:42.69,0:06:45.11,Default,,0,0,0,,Режим өзгереді!
Dialogue: 0,0:06:45.32,0:06:47.86,Default,,0,0,0,,Бар-нии~ Бұрынғы Нептун
Dialogue: 0,0:06:47.99,0:06:51.11,Default,,0,0,0,,Ол мен онымен соңғы соғысқандағыдан басқа бек сияқты көрінді.
Dialogue: 0,0:06:51.61,0:06:52.70,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:52.78,0:06:54.53,Default,,0,0,0,,Мен оны мүлде байқамаймын
Dialogue: 0,0:06:54.91,0:06:57.16,Default,,0,0,0,,Бұл мүлдем жақсы емес.
Dialogue: 0,0:06:59.33,0:07:00.67,Default,,0,0,0,,Мұқият тыңдаңыз~
Dialogue: 0,0:07:00.75,0:07:04.04,Default,,0,0,0,,Идиот Балт~!
Dialogue: 0,0:07:04.13,0:07:06.84,Default,,0,0,0,,Ақымақ деген не? Бакаку Мичо!
Dialogue: 0,0:07:06.92,0:07:07.88,Default,,0,0,0,,Музика мүлде шайтанға ұқсамайды.
Dialogue: 0,0:07:07.96,0:07:11.38,Default,,0,0,0,,Нептунның шабуыл және төзімділік режимдері бар.
Dialogue: 0,0:07:11.47,0:07:14.10,Default,,0,0,0,,Оны бұрауышпен ауыстыруға болады!
Dialogue: 0,0:07:14.89,0:07:16.01,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:07:16.81,0:07:19.35,Default,,0,0,0,,Мен оны бірінші рет шабуыл режимінде көрдім...
Dialogue: 0,0:07:19.73,0:07:22.10,Default,,0,0,0,,Бұл төзімділік режимі болды ма?
Dialogue: 0,0:07:23.02,0:07:25.19,Default,,0,0,0,,Рахмет сізге Кумичо
Dialogue: 0,0:07:26.27,0:07:28.03,Default,,0,0,0,,Екі режим!
Dialogue: 0,0:07:28.11,0:07:29.53,Default,,0,0,0,,Бұл керемет шығанақ!
Dialogue: 0,0:07:30.24,0:07:31.45,Default,,0,0,0,,Нептун –
Dialogue: 0,0:07:31.53,0:07:34.91,Default,,0,0,0,,Сіз оны қарсыласыңызға сәйкес өзгертуге болады.
Dialogue: 0,0:07:36.95,0:07:38.33,Default,,0,0,0,,Менің аналитикалық қабілетім және
Dialogue: 0,0:07:38.41,0:07:40.75,Default,,0,0,0,,Жетілдірілген стратегия және-
Dialogue: 0,0:07:41.12,0:07:44.75,Default,,0,0,0,,Екі режимі бар Нептунның жауап беру қабілеті біріктірілсе
Dialogue: 0,0:07:45.04,0:07:47.80,Default,,0,0,0,,Кез келген қарсыласты қалай жеңуге болады
Dialogue: 0,0:07:48.42,0:07:51.59,Default,,0,0,0,,«Бейблейд теңдеуін» табуға болады
Dialogue: 0,0:07:52.05,0:07:53.43,Default,,0,0,0,,Және бұл -
Dialogue: 0,0:07:54.05,0:07:55.68,Default,,0,0,0,,Абсолюттік патша
Dialogue: 0,0:07:55.76,0:07:58.68,Default,,0,0,0,,Ширасадиджо Луимен шайқаста көрсетілді
Dialogue: 0,0:08:01.43,0:08:03.48,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:08:03.56,0:08:04.65,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:08:04.73,0:08:08.73,Default,,0,0,0,,Мен оны жеңгенімде, менің теңдеуім толық болады.
Dialogue: 0,0:08:09.65,0:08:11.74,Default,,0,0,0,,Ширасаги қамалымен қалай күресуге болады.
Dialogue: 0,0:08:11.82,0:08:14.57,Default,,0,0,0,,Финалға міндетті түрде өту керек
Dialogue: 0,0:08:14.82,0:08:16.32,Default,,0,0,0,,Шұғыл хабар, шұғыл хабар!
Dialogue: 0,0:08:16.57,0:08:19.20,Default,,0,0,0,,Жарайды, енді қызық болып барады!
Dialogue: 0,0:08:19.29,0:08:20.29,Default,,0,0,0,,Балто-кун
Dialogue: 0,0:08:20.37,0:08:21.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:21.29,0:08:23.46,Default,,0,0,0,,Сіз зерттелдіңіз
Dialogue: 0,0:08:23.54,0:08:25.25,Default,,0,0,0,,Не істесең де, мені жеңе алмайсың
Dialogue: 0,0:08:25.50,0:08:26.96,Default,,0,0,0,,Не?!
Dialogue: 0,0:08:27.04,0:08:28.71,Default,,0,0,0,,Барлығы осында
Dialogue: 0,0:08:29.21,0:08:30.42,Default,,0,0,0,,Сіздің де болашағыңыз
Dialogue: 0,0:08:31.21,0:08:32.72,Default,,0,0,0,,(планшеттің жанасу дыбысы)
Dialogue: 0,0:08:33.80,0:08:34.76,Default,,0,0,0,,Ах...!
Dialogue: 0,0:08:36.47,0:08:37.55,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:37.64,0:08:38.43,Default,,0,0,0,,...Сәлем!
Dialogue: 0,0:08:38.51,0:08:39.85,Default,,0,0,0,,Жоқ, бұл арандатушылық!
Dialogue: 0,0:08:40.06,0:08:41.47,Default,,0,0,0,,Балто!
Dialogue: 0,0:08:41.56,0:08:42.31,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:42.93,0:08:44.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:44.64,0:08:48.31,Default,,0,0,0,,Валькириді мазақ еткенде, мен сабыр сақтай алмаймын.
Dialogue: 0,0:08:48.40,0:08:49.94,Default,,0,0,0,,Деректер бойынша
Dialogue: 0,0:08:50.02,0:08:51.73,Default,,0,0,0,,Мен ұстай алдым, бірақ...
Dialogue: 0,0:08:51.82,0:08:53.90,Default,,0,0,0,,Мен әлі таң қалдым.
Dialogue: 0,0:08:53.99,0:08:57.11,Default,,0,0,0,,Оны ағама көрсету өте қулық.
Dialogue: 0,0:08:57.49,0:08:58.95,Default,,0,0,0,,Әлсіз болсаң, ұтыласың...
Dialogue: 0,0:08:59.03,0:09:00.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.24,0:09:02.50,Default,,0,0,0,,Бұл да құмар ойын.
Dialogue: 0,0:09:10.29,0:09:11.63,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:09:11.71,0:09:15.22,Default,,0,0,0,,Енді сіздің ату дәлдігі 8%-ға дейін төмендейді.
Dialogue: 0,0:09:15.30,0:09:17.13,Default,,0,0,0,,Жарылыс ықтималдығы...
Dialogue: 0,0:09:19.18,0:09:21.47,Default,,0,0,0,,99,9%
Dialogue: 0,0:09:23.18,0:09:25.06,Default,,0,0,0,,Жарылуға рұқсат етіңіз!
Dialogue: 0,0:09:25.14,0:09:26.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:26.31,0:09:29.40,Default,,0,0,0,,Бұл Наокидің жарылған мәлімдемесі!
Dialogue: 0,0:09:30.11,0:09:31.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:31.90,0:09:33.07,Default,,0,0,0,,Балто~
Dialogue: 0,0:09:33.15,0:09:35.15,Default,,0,0,0,,Шан мен Сейя Бөке!
Dialogue: 0,0:09:36.74,0:09:38.11,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:09:38.20,0:09:40.78,Default,,0,0,0,,Күресуге деген ерік-жігерді толығымен жоғалту...
Dialogue: 0,0:09:41.03,0:09:43.20,Default,,0,0,0,,Күтуден жоғары әсерлер
Dialogue: 0,0:09:43.29,0:09:45.83,Default,,0,0,0,,Эксперименттер көңілді
Dialogue: 0,0:09:45.91,0:09:49.63,Default,,0,0,0,,Ku… U… Ku…
Dialogue: 0,0:09:50.92,0:09:53.38,Default,,0,0,0,,Мен сізге Луимен матчты тапсырдым.
Dialogue: 0,0:09:53.46,0:09:55.30,Default,,0,0,0,,Мен сені бұлай көру үшін келген жоқпын.
Dialogue: 0,0:09:55.38,0:09:56.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:02.14,0:10:03.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:04.18,0:10:05.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:06.02,0:10:08.27,Default,,0,0,0,,Шуға уәде бер!
Dialogue: 0,0:10:10.06,0:10:11.19,Default,,0,0,0,,О
Dialogue: 0,0:10:11.56,0:10:13.32,Default,,0,0,0,,Балтоға уәде бер!
Dialogue: 0,0:10:14.23,0:10:16.57,Default,,0,0,0,,Әй, бұл не деген сұмдық?
Dialogue: 0,0:10:16.65,0:10:19.16,Default,,0,0,0,,Барто Аои! Бұл қандай декларация!
Dialogue: 0,0:10:19.66,0:10:20.95,Default,,0,0,0,,Финалда...
Dialogue: 0,0:10:21.32,0:10:22.66,Default,,0,0,0,,Финалда...
Dialogue: 0,0:10:23.28,0:10:25.08,Default,,0,0,0,,Финалда сайысайық!
Dialogue: 0,0:10:26.83,0:10:27.83,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:10:28.46,0:10:29.46,Default,,0,0,0,,Хмм…
Dialogue: 0,0:10:31.33,0:10:32.67,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:10:34.71,0:10:37.09,Default,,0,0,0,,Енді екінші шайқас жалғасуда!
Dialogue: 0,0:10:37.17,0:10:39.43,Default,,0,0,0,,Су бетіндегі Наоки сізді итеріп жібере ме?
Dialogue: 0,0:10:39.51,0:10:42.51,Default,,0,0,0,,Әлде Барто Аои камбэк жасай ма?
Dialogue: 0,0:10:42.60,0:10:44.43,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:10:44.93,0:10:47.98,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:48.18,0:10:50.44,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:53.40,0:10:54.57,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:10:54.65,0:10:56.78,Default,,0,0,0,,Валькиридің шабуылы қалыпты...
Dialogue: 0,0:10:56.86,0:10:57.90,Default,,0,0,0,,Не!
Dialogue: 0,0:11:01.36,0:11:03.74,Default,,0,0,0,,(еденге құлаған шығанақтың дыбысы)
Dialogue: 0,0:11:04.03,0:11:05.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:05.91,0:11:07.66,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:11:07.75,0:11:09.54,Default,,0,0,0,,Артық мәре үшін 1 ұпай!
Dialogue: 0,0:11:09.62,0:11:11.21,Default,,0,0,0,,1-1 тармақтар
Dialogue: 0,0:11:11.42,0:11:12.67,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:11:13.21,0:11:16.05,Default,,0,0,0,,Даму бірінші шайқаспен бірдей болды.
Dialogue: 0,0:11:16.42,0:11:17.84,Default,,0,0,0,,Наокиді көрдіңіз бе?
Dialogue: 0,0:11:17.92,0:11:19.80,Default,,0,0,0,,Бұл Валькири!
Dialogue: 0,0:11:20.13,0:11:21.84,Default,,0,0,0,,Керемет!
Dialogue: 0,0:11:21.93,0:11:23.64,Default,,0,0,0,,Бұл жігіт қызық болып барады!
Dialogue: 0,0:11:23.72,0:11:26.76,Default,,0,0,0,,Екі жақ та бір дюймді бермеді, 1-1 есебімен тең түсті.
Dialogue: 0,0:11:26.85,0:11:29.02,Default,,0,0,0,,Үшінші шайқас басталды!
Dialogue: 0,0:11:32.02,0:11:34.69,Default,,0,0,0,,Жарайды, оны айналдырайық!
Dialogue: 0,0:11:35.19,0:11:37.65,Default,,0,0,0,,Бұрынғыдан қандай айырмашылығы бар?
Dialogue: 0,0:11:40.99,0:11:42.82,Default,,0,0,0,,Қуат 1000!
Dialogue: 0,0:11:42.91,0:11:44.95,Default,,0,0,0,,Күтуден асып түсті
Dialogue: 0,0:11:45.53,0:11:46.37,Default,,0,0,0,,Хун
Dialogue: 0,0:11:46.99,0:11:49.25,Default,,0,0,0,,Мен бұл мақсаттың жоғалу себебін түсінемін.
Dialogue: 0,0:11:49.91,0:11:51.29,Default,,0,0,0,,Себебін білсеңіз...
Dialogue: 0,0:11:51.37,0:11:53.62,Default,,0,0,0,,Шешу оңай
Dialogue: 0,0:11:53.71,0:11:55.17,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:11:55.75,0:11:57.92,Default,,0,0,0,,Менің теңдеуім өзгермейді!
Dialogue: 0,0:12:03.59,0:12:04.80,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:12:05.59,0:12:07.43,Default,,0,0,0,,Наоки қай жолмен келеді?
Dialogue: 0,0:12:07.97,0:12:10.39,Default,,0,0,0,,Төзімділік режимі немесе шабуыл режимі...
Dialogue: 0,0:12:10.52,0:12:11.52,Default,,0,0,0,,(Ауысу режимдерінің дыбысы)
Dialogue: 0,0:12:12.18,0:12:14.23,Default,,0,0,0,,Не істеу керек Валькирия
Dialogue: 0,0:12:17.06,0:12:18.98,Default,,0,0,0,,Кеттік! Досым!
Dialogue: 0,0:12:23.28,0:12:24.95,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:12:25.28,0:12:28.53,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:28.91,0:12:31.29,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:32.29,0:12:33.54,Default,,0,0,0,,Валькирия –
Dialogue: 0,0:12:33.62,0:12:35.96,Default,,0,0,0,,Үш шапшаң ату!
Dialogue: 0,0:12:36.04,0:12:39.38,Default,,0,0,0,,Нептун туралы не деуге болады? О! Бұл бұрынғыдан басқа қимыл!
Dialogue: 0,0:12:39.46,0:12:41.26,Default,,0,0,0,,Кенет көтерілу!
Dialogue: 0,0:12:42.26,0:12:44.05,Default,,0,0,0,,Шабуыл режимі мүмкін болды ма?
Dialogue: 0,0:12:44.13,0:12:45.26,Default,,0,0,0,,Нептун…
Dialogue: 0,0:12:45.34,0:12:48.30,Default,,0,0,0,,Бұл өткен күні Бал-нидің жеңіліп қалған кезі сияқты.
Dialogue: 0,0:12:48.39,0:12:49.56,Default,,0,0,0,,Иә! Не!
Dialogue: 0,0:12:50.01,0:12:53.31,Default,,0,0,0,,Ол кезде мақсат деректер жинау еді...
Dialogue: 0,0:12:53.89,0:12:55.90,Default,,0,0,0,,Бүгін мен бар күшіммен барамын!
Dialogue: 0,0:12:56.94,0:12:58.98,Default,,0,0,0,,Қатты күйзеліспен...
Dialogue: 0,0:12:59.06,0:13:01.53,Default,,0,0,0,,Екеуі де қайтарылды!
Dialogue: 0,0:13:04.03,0:13:06.49,Default,,0,0,0,,Нептун! Бұл толқынды түсірілім!
Dialogue: 0,0:13:09.33,0:13:11.99,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:13.12,0:13:16.75,Default,,0,0,0,,Алға, Валькири!
Dialogue: 0,0:13:18.33,0:13:20.59,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:13:28.89,0:13:30.22,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:13:31.10,0:13:32.43,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:13:32.52,0:13:33.22,Default,,0,0,0,,Иә
Dialogue: 0,0:13:35.35,0:13:37.56,Default,,0,0,0,,Не... не... не!
Dialogue: 0,0:13:37.65,0:13:39.86,Default,,0,0,0,,Валькири үлкен күшпен қозғалады
Dialogue: 0,0:13:39.94,0:13:41.61,Default,,0,0,0,,Жабайы болып кетті!
Dialogue: 0,0:13:41.69,0:13:43.73,Default,,0,0,0,,Бұл тек өзін-өзі жоюға әкеледі.
Dialogue: 0,0:13:49.66,0:13:51.28,Default,,0,0,0,,Не! Жақсы!
Dialogue: 0,0:13:51.37,0:13:53.62,Default,,0,0,0,,(Қатты соқтығыстың дыбысы)
Dialogue: 0,0:13:53.70,0:13:55.50,Default,,0,0,0,,(сыртылдаған дыбыс)
Dialogue: 0,0:13:56.21,0:13:57.46,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:57.54,0:13:59.79,Default,,0,0,0,,Дүрбелең Валкириге түсіп қалды...
Dialogue: 0,0:13:59.88,0:14:02.00,Default,,0,0,0,,Нептун да қуылды!
Dialogue: 0,0:14:02.09,0:14:03.46,Default,,0,0,0,,Егер бұл жол болса...
Dialogue: 0,0:14:03.55,0:14:05.51,Default,,0,0,0,,Бір уақытта аяқтау арқылы сурет салу
Dialogue: 0,0:14:06.01,0:14:07.80,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:14:12.47,0:14:13.93,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:14:14.43,0:14:16.81,Default,,0,0,0,,Валькирияның жеңісі 2 ұпай
Dialogue: 0,0:14:16.89,0:14:19.94,Default,,0,0,0,,Барто Аои 3-1 есебімен жеңді!
Dialogue: 0,0:14:20.02,0:14:21.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:23.65,0:14:25.15,Default,,0,0,0,,Керемет! Досым!
Dialogue: 0,0:14:26.19,0:14:27.61,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:14:28.90,0:14:32.03,Default,,0,0,0,,Ақырында, толық аяқталды!
Dialogue: 0,0:14:32.12,0:14:35.41,Default,,0,0,0,,Артынан келіп, бірінші раундта жеңіске жеткен – Барто Аои!
Dialogue: 0,0:14:35.49,0:14:37.04,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:14:37.12,0:14:39.71,Default,,0,0,0,,Иә! Мен жеңдім!
Dialogue: 0,0:14:40.29,0:14:42.38,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:44.30,0:14:46.21,Default,,0,0,0,,Ақымақ Балт~!
Dialogue: 0,0:14:46.30,0:14:47.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:47.26,0:14:49.30,Default,,0,0,0,,Сен не істеп жүрсің!
Dialogue: 0,0:14:49.38,0:14:52.72,Default,,0,0,0,,Мен матчты тастап, жеңіліп қала жаздадым.
Dialogue: 0,0:14:52.80,0:14:54.85,Default,,0,0,0,,Мен уақытында әрең жеттім.
Dialogue: 0,0:14:54.93,0:14:56.85,Default,,0,0,0,,Ашуланба, Кумичо.
Dialogue: 0,0:14:56.93,0:14:58.35,Default,,0,0,0,,Уақытында үлгермеу
Dialogue: 0,0:14:58.43,0:14:59.73,Default,,0,0,0,,Егер Уакия болмаса...
Dialogue: 0,0:14:59.81,0:15:02.27,Default,,0,0,0,,Сіздің ұлттық турниріңіз аяқталды.
Dialogue: 0,0:15:02.35,0:15:03.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:03.15,0:15:06.07,Default,,0,0,0,,Вакия өзінің кездесуін әдейі ұзартты
Dialogue: 0,0:15:06.15,0:15:07.94,Default,,0,0,0,,Сіз менің уақытымды үнемдедіңіз.
Dialogue: 0,0:15:08.40,0:15:11.91,Default,,0,0,0,,Мен сенің ұлттық турниріңді аяқтаймын.
Dialogue: 0,0:15:12.32,0:15:13.78,Default,,0,0,0,,Уакия~
Dialogue: 0,0:15:13.87,0:15:15.87,Default,,0,0,0,,Басқа қалпақшаларға және-
Dialogue: 0,0:15:15.95,0:15:18.25,Default,,0,0,0,,Төбелеспесең, ұтыласың,... деп айтқаным есімде.
Dialogue: 0,0:15:18.33,0:15:19.87,Default,,0,0,0,,Рахмет сізге Вакия!
Dialogue: 0,0:15:19.96,0:15:23.58,Default,,0,0,0,,Достар - бұл сізде болуы керек нәрсе.
Dialogue: 0,0:15:23.67,0:15:25.84,Default,,0,0,0,,Тоқташы, тітіркендіреді...
Dialogue: 0,0:15:26.30,0:15:29.47,Default,,0,0,0,,Ах! (Айзава Джин) Ах...кешіріңіз...уф
Dialogue: 0,0:15:30.01,0:15:30.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.05,0:15:31.84,Default,,0,0,0,,Не?
Dialogue: 0,0:15:31.93,0:15:34.18,Default,,0,0,0,,Мен оны өзім соқтым, рұқсатсыз мүк үстіме құлады.
Dialogue: 0,0:15:34.89,0:15:37.26,Default,,0,0,0,,Эй... жақсысың ба?
Dialogue: 0,0:15:37.56,0:15:39.39,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:15:40.81,0:15:43.27,Default,,0,0,0,,Себебі менде бар...
Dialogue: 0,0:15:43.35,0:15:46.86,Default,,0,0,0,,323 қамқоршы рухтар
Dialogue: 0,0:15:46.94,0:15:47.73,Default,,0,0,0,,Хехе...
Dialogue: 0,0:15:47.82,0:15:49.07,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:49.23,0:15:50.28,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:15:52.40,0:15:53.36,Default,,0,0,0,,Не!
Dialogue: 0,0:15:55.82,0:15:58.29,Default,,0,0,0,,Мен осындай жерде болдым
Dialogue: 0,0:15:58.41,0:16:00.04,Default,,0,0,0,,Не...?
Dialogue: 0,0:16:00.91,0:16:03.25,Default,,0,0,0,,Иә~ Иә...
Dialogue: 0,0:16:03.33,0:16:04.92,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:16:05.00,0:16:07.75,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:16:07.84,0:16:08.96,Default,,0,0,0,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:16:09.76,0:16:11.55,Default,,0,0,0,,Мен ештеңе істемеймін...
Dialogue: 0,0:16:11.97,0:16:12.76,Default,,0,0,0,,Жарайды, операцияны басынан бастауға тура келеді.
Dialogue: 0,0:16:12.84,0:16:14.43,Default,,0,0,0,,Ал... әлі жоқ.
Dialogue: 0,0:16:14.80,0:16:16.80,Default,,0,0,0,,Енді сіз білесіз
Dialogue: 0,0:16:18.01,0:16:19.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:20.27,0:16:21.68,Default,,0,0,0,,Менің ұйқым келді~
Dialogue: 0,0:16:28.82,0:16:29.78,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:16:33.28,0:16:34.82,Default,,0,0,0,,А…?
Dialogue: 0,0:16:37.16,0:16:40.12,Default,,0,0,0,,Ол мені әдейі ұрмақ болды.
Dialogue: 0,0:16:40.20,0:16:41.08,Default,,0,0,0,,А...
Dialogue: 0,0:16:41.16,0:16:42.91,Default,,0,0,0,,Бұл соғыс жариялау ма?
Dialogue: 0,0:16:43.00,0:16:45.50,Default,,0,0,0,,Шу! Сені қиратқан Рутчу
Dialogue: 0,0:16:46.54,0:16:49.09,Default,,0,0,0,,Әй, ол кім?
Dialogue: 0,0:16:49.71,0:16:51.13,Default,,0,0,0,,Джин Айзава...
Dialogue: 0,0:16:51.59,0:16:54.09,Default,,0,0,0,,Джайльормунгандты пайдаланатын Blader
Dialogue: 0,0:16:55.38,0:16:57.76,Default,,0,0,0,,Шудың бірінші раундтағы қарсыласы.
Dialogue: 0,0:16:59.72,0:17:01.43,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:17:03.60,0:17:05.10,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:17:07.06,0:17:10.61,Default,,0,0,0,,Талдау да, стратегия да мінсіз болуы керек еді.
Dialogue: 0,0:17:11.15,0:17:14.03,Default,,0,0,0,,Уау, мен түсінбедім!
Dialogue: 0,0:17:14.11,0:17:15.28,Default,,0,0,0,,(үстелді түрту дыбысы)
Dialogue: 0,0:17:15.40,0:17:19.16,Default,,0,0,0,,Мен түсінбеймін! Мен білмеймін!
Dialogue: 0,0:17:19.24,0:17:21.37,Default,,0,0,0,,Неліктен менің теңдеуім бұзылды?
Dialogue: 0,0:17:21.45,0:17:22.91,Default,,0,0,0,,Жерде не болды?
Dialogue: 0,0:17:23.00,0:17:25.12,Default,,0,0,0,,Жеңілістің себебі қайда болды?
Dialogue: 0,0:17:25.50,0:17:27.21,Default,,0,0,0,,Қанша рет қарасам да...
Dialogue: 0,0:17:27.58,0:17:30.96,Default,,0,0,0,,Деректерді қанша талдасам да, түсінбеймін!
Dialogue: 0,0:17:31.05,0:17:32.59,Default,,0,0,0,,Giii...!
Dialogue: 0,0:17:36.88,0:17:37.76,Default,,0,0,0,,Хм...!
Dialogue: 0,0:17:40.97,0:17:43.43,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:17:43.77,0:17:45.48,Default,,0,0,0,,Жаңа пісірілген Бейблейд наны
Dialogue: 0,0:17:45.56,0:17:47.77,Default,,0,0,0,,Бұл дәмді. Ал ше?
Dialogue: 0,0:17:47.85,0:17:51.77,Default,,0,0,0,,О? Сіз Балтоның қарсыласы екеніне сенімдісіз бе?
Dialogue: 0,0:17:52.11,0:17:53.78,Default,,0,0,0,,Барлығына да, Наоки-кун!
Dialogue: 0,0:17:53.86,0:17:54.61,Default,,0,0,0,,А...
Dialogue: 0,0:17:55.19,0:17:57.53,Default,,0,0,0,,Ах... хаха, бұл генетикалық.
Dialogue: 0,0:17:58.36,0:18:00.49,Default,,0,0,0,,Сіздің сүйікті наныңыз қандай, Барт?
Dialogue: 0,0:18:00.91,0:18:01.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:02.28,0:18:04.29,Default,,0,0,0,,Маған бәрі ұнайды.
Dialogue: 0,0:18:05.45,0:18:06.66,Default,,0,0,0,,Хмм…
Dialogue: 0,0:18:07.29,0:18:10.71,Default,,0,0,0,,Бұл нан Балт Аоидың қуат көзі...
Dialogue: 0,0:18:11.75,0:18:12.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:13.17,0:18:14.17,Default,,0,0,0,,Хмм…
Dialogue: 0,0:18:15.05,0:18:16.76,Default,,0,0,0,,(планшеттің жанасу дыбысы)
Dialogue: 0,0:18:19.93,0:18:22.51,Default,,0,0,0,,Бұл серпімділік, осы тәттілік
Dialogue: 0,0:18:22.60,0:18:24.22,Default,,0,0,0,,Текстураның нәзіктігі…
Dialogue: 0,0:18:25.85,0:18:27.60,Default,,0,0,0,,Бұл сөзсіз жақсы, бірақ...
Dialogue: 0,0:18:27.68,0:18:30.19,Default,,0,0,0,,Маған әлі де шешуші фактор жетіспейді...
Dialogue: 0,0:18:30.27,0:18:32.31,Default,,0,0,0,,J Soul Gund дегеніміз не?
Dialogue: 0,0:18:32.40,0:18:34.15,Default,,0,0,0,,Бұл Джайрёрмунганд.
Dialogue: 0,0:18:34.40,0:18:36.69,Default,,0,0,0,,Демек, бұл Джойфул Гунд, солай ма?
Dialogue: 0,0:18:36.78,0:18:38.82,Default,,0,0,0,,Джайльормунганд!
Dialogue: 0,0:18:38.90,0:18:42.07,Default,,0,0,0,,Бұл Йонекома Гакуэн Бей клубының мүшесі
Dialogue: 0,0:18:42.45,0:18:44.87,Default,,0,0,0,,Иә, бұл қандай шығанақ?
Dialogue: 0,0:18:44.95,0:18:46.79,Default,,0,0,0,,Сол... Йорганд.
Dialogue: 0,0:18:46.87,0:18:48.25,Default,,0,0,0,,Мен оны айта алмаймын.
Dialogue: 0,0:18:48.66,0:18:51.50,Default,,0,0,0,,Джормунгандр - төзімді типті бей.
Dialogue: 0,0:18:51.58,0:18:55.00,Default,,0,0,0,,Еркін айналу сақинасы құлауды қиындатады және бәрібір жабысқақ
Dialogue: 0,0:18:55.30,0:18:56.92,Default,,0,0,0,,Қандай бекке қарсы тұрсаңыз да...
Dialogue: 0,0:18:57.01,0:18:59.72,Default,,0,0,0,,Шу-кун міндетті түрде жеңеді! Эй~
Dialogue: 0,0:18:59.80,0:19:00.93,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:19:01.01,0:19:02.68,Default,,0,0,0,,Оңай жеңіс Оңай жеңіс
Dialogue: 0,0:19:02.76,0:19:04.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:04.72,0:19:06.77,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:19:06.85,0:19:07.93,Default,,0,0,0,,Айт...
Dialogue: 0,0:19:08.02,0:19:09.56,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:19:09.64,0:19:10.48,Default,,0,0,0,,Хмм…
Dialogue: 0,0:19:11.23,0:19:12.69,Default,,0,0,0,,Бұл гипотеза…
Dialogue: 0,0:19:12.77,0:19:14.98,Default,,0,0,0,,Оны зерттеген жөн сияқты.
Dialogue: 0,0:19:16.23,0:19:17.69,Default,,0,0,0,,Доктор Наоки
Dialogue: 0,0:19:18.32,0:19:19.78,Default,,0,0,0,,Барт Аоиға қарсы
Dialogue: 0,0:19:19.86,0:19:23.82,Default,,0,0,0,,Bay Club мүшелерінің әсерін талдау нәтижелері шығарылды.
Dialogue: 0,0:19:23.91,0:19:25.33,Default,,0,0,0,,Жарайды, қарайық.
Dialogue: 0,0:19:25.41,0:19:26.41,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:19:26.49,0:19:27.95,Default,,0,0,0,,Рантаро Кияма
Dialogue: 0,0:19:29.33,0:19:31.29,Default,,0,0,0,,Мынадай нәрсе... Келесі
Dialogue: 0,0:19:32.12,0:19:33.33,Default,,0,0,0,,Қара Құдай Дина
Dialogue: 0,0:19:34.17,0:19:35.46,Default,,0,0,0,,Орта...
Dialogue: 0,0:19:35.54,0:19:36.42,Default,,0,0,0,,көріп тұрғаныңыздай, кітапхананы қамтиды—
Dialogue: 0,0:19:36.50,0:19:37.75,Default,,0,0,0,,Комурасаки Вакия
Dialogue: 0,0:19:38.71,0:19:41.47,Default,,0,0,0,,Хмм... Мұны да елемеуге болады.
Dialogue: 0,0:19:41.80,0:19:42.72,Default,,0,0,0,,көріп тұрғаныңыздай, кітапхананы қамтиды—
Dialogue: 0,0:19:43.01,0:19:44.09,Default,,0,0,0,,Бенишу
Dialogue: 0,0:19:44.18,0:19:45.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:46.10,0:19:48.39,Default,,0,0,0,,Шуға уәде бер!
Dialogue: 0,0:19:51.85,0:19:53.94,Default,,0,0,0,,Осыны айтып тұрсың ба?
Dialogue: 0,0:19:55.81,0:19:58.15,Default,,0,0,0,,Тәжірибелер қызықты
Dialogue: 0,0:19:58.69,0:20:01.86,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:20:01.95,0:20:03.86,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:03.95,0:20:06.28,Default,,0,0,0,,Екі соққы да сәтті болды!
Dialogue: 0,0:20:06.37,0:20:07.70,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:20:07.78,0:20:09.58,Default,,0,0,0,,Бұл Айзава Джиннің кездесуі.
Dialogue: 0,0:20:09.83,0:20:11.87,Default,,0,0,0,,Ол маған электрондық пошта арқылы жіберілді.
Dialogue: 0,0:20:11.96,0:20:13.00,Default,,0,0,0,,Ах
Dialogue: 0,0:20:13.08,0:20:14.54,Default,,0,0,0,,Маған көрсет Маған көрсет
Dialogue: 0,0:20:14.63,0:20:17.04,Default,,0,0,0,,Бұл кескілескен шайқас!
Dialogue: 0,0:20:17.13,0:20:20.34,Default,,0,0,0,,Джормунганд, еңкейген
Dialogue: 0,0:20:20.67,0:20:21.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:22.05,0:20:24.13,Default,,0,0,0,,Бірақ! құламайды
Dialogue: 0,0:20:24.22,0:20:25.89,Default,,0,0,0,,Иә! Не!
Dialogue: 0,0:20:27.39,0:20:29.93,Default,,0,0,0,,Бос айналдыру дискі стадионға тиеді.
Dialogue: 0,0:20:30.02,0:20:32.10,Default,,0,0,0,,Ол тепе-теңдікті қалпына келтіруде!
Dialogue: 0,0:20:32.18,0:20:33.69,Default,,0,0,0,,Бұл қазір керемет!
Dialogue: 0,0:20:33.77,0:20:35.31,Default,,0,0,0,,Мен құлап кетемін деп ойладым.
Dialogue: 0,0:20:36.15,0:20:37.48,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:20:38.61,0:20:39.94,Default,,0,0,0,,Тағы кездескенше
Dialogue: 0,0:20:40.07,0:20:41.61,Default,,0,0,0,,Керемет! таңқаларлық!
Dialogue: 0,0:20:43.07,0:20:44.15,Default,,0,0,0,,А...
Dialogue: 0,0:20:44.57,0:20:46.07,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:20:46.16,0:20:47.66,Default,,0,0,0,,Ааа
Dialogue: 0,0:20:47.74,0:20:49.66,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,0:20:49.74,0:20:51.25,Default,,0,0,0,,Жарылыс~!
Dialogue: 0,0:20:51.33,0:20:54.00,Default,,0,0,0,,Жеңімпаз - Джейрёрмунганд!
Dialogue: 0,0:20:54.96,0:20:56.08,Default,,0,0,0,,Балто~
Dialogue: 0,0:20:56.63,0:20:59.63,Default,,0,0,0,,Барлығына қоңырау шалыңыз, бұл Наоки-кун.
Dialogue: 0,0:21:01.13,0:21:03.84,Default,,0,0,0,,Мен жіберген бейнені көрдіңіз бе?
Dialogue: 0,0:21:03.92,0:21:05.22,Default,,0,0,0,,Мен көрдім! Мен көрдім!
Dialogue: 0,0:21:05.55,0:21:07.59,Default,,0,0,0,,Бұл өте керемет шайқас болды!
Dialogue: 0,0:21:07.68,0:21:10.51,Default,,0,0,0,,Қарағаныңызға рахмет.
Dialogue: 0,0:21:10.60,0:21:12.93,Default,,0,0,0,,Мен оны байқамадым деп ойлаймын.
Dialogue: 0,0:21:13.02,0:21:13.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:13.68,0:21:15.81,Default,,0,0,0,,Сіз соншалықты ақылдысыз ба?
Dialogue: 0,0:21:15.89,0:21:17.81,Default,,0,0,0,,А... не?
Dialogue: 0,0:21:18.27,0:21:19.86,Default,,0,0,0,,Джин Айзава бұл...
Dialogue: 0,0:21:19.94,0:21:23.53,Default,,0,0,0,,Ол жеңу үшін кез келген лас құралдарды пайдаланады.
Dialogue: 0,0:21:23.74,0:21:24.70,Default,,0,0,0,,А...
Dialogue: 0,0:21:25.07,0:21:26.91,Default,,0,0,0,,Сол шайқастағы қарсылас да...
Dialogue: 0,0:21:26.99,0:21:29.20,Default,,0,0,0,,Шындығында, біз жеңіліске ұшырадық.
Dialogue: 0,0:21:31.24,0:21:32.37,Default,,0,0,0,,Ол қазір.
Dialogue: 0,0:21:32.45,0:21:34.20,Default,,0,0,0,,Әдейі соғуға тырысты
Dialogue: 0,0:21:34.91,0:21:36.21,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:21:36.29,0:21:38.29,Default,,0,0,0,,Оның келесі қарсыласы-
Dialogue: 0,0:21:38.38,0:21:40.50,Default,,0,0,0,,Мен оның сіздің ең жақын досыңыз болғанына сенімдімін.
Dialogue: 0,0:21:40.59,0:21:41.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:43.34,0:21:44.97,Default,,0,0,0,,Куришу-кун да...
Dialogue: 0,0:21:45.38,0:21:47.34,Default,,0,0,0,,Қауіпті болуы мүмкін
Dialogue: 0,0:21:47.88,0:21:49.51,Default,,0,0,0,,Шуға қауіп төніп тұр ма?
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.40,0:23:28.53,Default,,0,0,0,,Джин Айдзава Шуды нысанаға алады
Dialogue: 0,0:23:28.61,0:23:30.07,Default,,0,0,0,,Оққағар бол-
Dialogue: 0,0:23:30.15,0:23:31.95,Default,,0,0,0,,Мен Шуды қорғаймын!
Dialogue: 0,0:23:32.03,0:23:33.20,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:23:33.28,0:23:35.87,Default,,0,0,0,,Мен бірдеңе болып жатқандай сезінемін.
Dialogue: 0,0:23:35.95,0:23:37.54,Default,,0,0,0,,Иә! Шуу!
Dialogue: 0,0:23:37.62,0:23:38.87,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:23:38.95,0:23:40.91,Default,,0,0,0,,Бұлай жасамаңыз.
Dialogue: 0,0:23:41.29,0:23:43.33,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.42,0:23:45.59,Default,,0,0,0,,Жылан! Йормунганд
Dialogue: 0,0:23:45.96,0:23:47.59,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.67,0:23:49.17,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.67,0:23:56.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory