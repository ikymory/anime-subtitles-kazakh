Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.05,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.80,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.88,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:19.43,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.23,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:34.36,0:00:36.41,Default,,0,0,0,,Шеш, Гайя!
Dialogue: 0,0:00:36.95,0:00:38.99,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:40.54,0:00:42.12,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:00:42.95,0:00:44.75,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:00:44.87,0:00:47.50,Default,,0,0,0,,Соңғы жау Rideout деп шешілді.
Dialogue: 0,0:00:52.92,0:00:56.01,Default,,0,0,0,,(Еденге соғылған сымның дыбысы)
Dialogue: 0,0:00:59.68,0:01:02.97,Default,,0,0,0,,Мен мағынасыз шайқастармен күреспеймін
Dialogue: 0,0:01:03.06,0:01:04.73,Default,,0,0,0,,Әсіресе сен сияқты...
Dialogue: 0,0:01:04.81,0:01:06.77,Default,,0,0,0,,Жаман өру дегеніміз не?
Dialogue: 0,0:01:06.85,0:01:08.86,Default,,0,0,0,,Мен жаман қуық емеспін.
Dialogue: 0,0:01:09.27,0:01:11.82,Default,,0,0,0,,Гррр!
Dialogue: 0,0:01:13.15,0:01:14.19,Default,,0,0,0,,Даа!
Dialogue: 0,0:01:14.28,0:01:15.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:17.07,0:01:19.37,Default,,0,0,0,,Мен оларды жеңуім керек.
Dialogue: 0,0:01:19.53,0:01:21.53,Default,,0,0,0,,Жоқ, мен міндетті түрде жеңемін.
Dialogue: 0,0:01:31.75,0:01:34.13,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:34.46,0:01:39.64,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:50.94,0:01:54.32,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:54.82,0:01:56.95,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:57.36,0:02:01.49,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:01.62,0:02:04.83,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:04.95,0:02:11.38,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:11.67,0:02:16.09,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:16.59,0:02:22.01,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:22.14,0:02:24.39,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:24.47,0:02:29.19,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:29.35,0:02:34.44,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:34.73,0:02:36.99,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:37.19,0:02:39.53,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:39.82,0:02:43.74,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:43.91,0:02:48.91,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:49.12,0:02:51.29,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:55.13,0:02:57.26,Default,,0,0,0,,Біздің финалдық матч!
Dialogue: 0,0:03:08.27,0:03:09.68,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:03:09.77,0:03:12.90,Default,,0,0,0,,Бұл машиналардың барлығы менің кеңсемде болды, солай ма?
Dialogue: 0,0:03:12.98,0:03:14.94,Default,,0,0,0,,Осы уақытқа дейін әкелдің бе?
Dialogue: 0,0:03:15.06,0:03:17.78,Default,,0,0,0,,Мен күшті болсам да, көмектеспейді
Dialogue: 0,0:03:17.86,0:03:19.32,Default,,0,0,0,,Мен оны қазір сізге қарызға беремін.
Dialogue: 0,0:03:19.82,0:03:22.24,Default,,0,0,0,,Бар болғаны қатты жаттығу.
Dialogue: 0,0:03:22.82,0:03:24.91,Default,,0,0,0,,Эй, Шу-кун, қолданбайсың ба?
Dialogue: 0,0:03:25.03,0:03:26.66,Default,,0,0,0,,А, мен жақсымын.
Dialogue: 0,0:03:27.04,0:03:28.75,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:29.45,0:03:32.75,Default,,0,0,0,,Сіз мені ешқашан жеңе алмайсыз
Dialogue: 0,0:03:32.87,0:03:34.46,Default,,0,0,0,,Пучин!
Dialogue: 0,0:03:34.67,0:03:35.96,Default,,0,0,0,,Бұл!
Dialogue: 0,0:03:36.04,0:03:38.67,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:03:39.63,0:03:42.43,Default,,0,0,0,,Уау...Сәрсенбі~
Dialogue: 0,0:03:43.34,0:03:45.05,Default,,0,0,0,,Таку
Dialogue: 0,0:03:45.18,0:03:47.06,Default,,0,0,0,,Балалар сендер де демалуларың керек.
Dialogue: 0,0:03:47.31,0:03:48.89,Default,,0,0,0,,Әлі жоқ~
Dialogue: 0,0:03:49.39,0:03:52.02,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:03:52.31,0:03:54.56,Default,,0,0,0,,Келесі кезекте бір-бірден атуды жаттықтырды.
Dialogue: 0,0:03:55.02,0:03:57.98,Default,,0,0,0,,Кеттік! Тез ату!
Dialogue: 0,0:04:04.57,0:04:05.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:06.07,0:04:07.12,Default,,0,0,0,,Қазір
Dialogue: 0,0:04:07.20,0:04:08.53,Default,,0,0,0,,Сәтсіз ату?
Dialogue: 0,0:04:08.95,0:04:09.79,Default,,0,0,0,,Уау
Dialogue: 0,0:04:11.41,0:04:13.16,Default,,0,0,0,,Жол белгісіз
Dialogue: 0,0:04:17.71,0:04:19.46,Default,,0,0,0,,Жоқ, ақымақ.
Dialogue: 0,0:04:20.38,0:04:21.42,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:04:21.92,0:04:23.51,Default,,0,0,0,,Оның себебі неде?
Dialogue: 0,0:04:23.59,0:04:24.80,Default,,0,0,0,,Бұл машина...
Dialogue: 0,0:04:24.88,0:04:27.47,Default,,0,0,0,,Не! Барлығы соңғы
Dialogue: 0,0:04:27.55,0:04:28.85,Default,,0,0,0,,Неге...
Dialogue: 0,0:04:29.43,0:04:31.35,Default,,0,0,0,,Себеп - шаршау.
Dialogue: 0,0:04:32.02,0:04:32.93,Default,,0,0,0,,Шаршау?
Dialogue: 0,0:04:33.02,0:04:35.65,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мен мүлде шаршаған жоқпын.
Dialogue: 0,0:04:36.27,0:04:38.82,Default,,0,0,0,,Дұрыс, әлі де көп орын бар.
Dialogue: 0,0:04:43.40,0:04:46.07,Default,,0,0,0,,Балалар, мұны істеу тәсілдеріңіз өте ерекше.
Dialogue: 0,0:04:46.16,0:04:48.28,Default,,0,0,0,,Әсіресе қосқышты қолдайтын сол қол
Dialogue: 0,0:04:48.37,0:04:52.04,Default,,0,0,0,,Ес-түссіз, бірте-бірте шаршадым.
Dialogue: 0,0:04:52.25,0:04:54.62,Default,,0,0,0,,Сол себепті кадр дірілдеп кетті ме?
Dialogue: 0,0:04:54.91,0:04:56.67,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:04:57.54,0:04:59.71,Default,,0,0,0,,Практикадан 1 күн демалыс
Dialogue: 0,0:05:00.88,0:05:02.38,Default,,0,0,0,,Эх!
Dialogue: 0,0:05:02.46,0:05:04.55,Default,,0,0,0,,Сіз не туралы айтып отырсыз? 1 күн.
Dialogue: 0,0:05:04.63,0:05:06.09,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:06.18,0:05:09.35,Default,,0,0,0,,Бұл арада Rideout күшейе түсті.
Dialogue: 0,0:05:09.43,0:05:11.47,Default,,0,0,0,,Демалуға болмайды, Балто.
Dialogue: 0,0:05:11.64,0:05:12.68,Default,,0,0,0,,Демалайық!
Dialogue: 0,0:05:12.77,0:05:13.85,Default,,0,0,0,,Эй!
Dialogue: 0,0:05:13.93,0:05:14.89,Default,,0,0,0,,Шешім!
Dialogue: 0,0:05:14.98,0:05:17.65,Default,,0,0,0,,Bay Club бүгіннен ертеңге дейін жабық болады.
Dialogue: 0,0:05:17.77,0:05:19.15,Default,,0,0,0,,Эй, күте тұрыңыз!
Dialogue: 0,0:05:19.23,0:05:20.65,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:05:20.73,0:05:24.19,Default,,0,0,0,,Жақсы, демалу жаттығудың бір бөлігі.
Dialogue: 0,0:05:24.53,0:05:25.57,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:05:25.65,0:05:26.49,Default,,0,0,0,,О
Dialogue: 0,0:05:29.82,0:05:31.08,Default,,0,0,0,,Ах
Dialogue: 0,0:05:31.49,0:05:33.79,Default,,0,0,0,,Иә, солай дедім.
Dialogue: 0,0:05:33.87,0:05:36.16,Default,,0,0,0,,Өйткені, мен жаттығып жатырмын.
Dialogue: 0,0:05:37.46,0:05:38.75,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:38.83,0:05:41.17,Default,,0,0,0,,Мен мұны өзім айттым.
Dialogue: 0,0:05:41.25,0:05:43.00,Default,,0,0,0,,...бірақ
Dialogue: 0,0:05:43.09,0:05:46.01,Default,,0,0,0,,А, жаттығу!
Dialogue: 0,0:05:46.09,0:05:49.34,Default,,0,0,0,,Бар-нии, өте шулы, ұйықтай алмаймын.
Dialogue: 0,0:05:49.64,0:05:51.76,Default,,0,0,0,,Вакия мырза жоқ дейді.
Dialogue: 0,0:05:52.18,0:05:54.77,Default,,0,0,0,,Мен бүгін жаттығу жасамаймын. Бұл уәде, солай ма?
Dialogue: 0,0:05:54.85,0:05:56.31,Default,,0,0,0,,Бұл маңызды ма?
Dialogue: 0,0:05:56.43,0:05:57.35,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:59.27,0:06:02.69,Default,,0,0,0,,А... Машина қайда кетті?
Dialogue: 0,0:06:03.48,0:06:06.94,Default,,0,0,0,,Вакия мырза станокты бей-клубқа әкелді...
Dialogue: 0,0:06:07.03,0:06:08.70,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:06:08.78,0:06:10.53,Default,,0,0,0,,Қандай ақымақ~
Dialogue: 0,0:06:10.62,0:06:12.20,Default,,0,0,0,,Солай~
Dialogue: 0,0:06:12.95,0:06:15.20,Default,,0,0,0,,Аа, менің уақытым бар.
Dialogue: 0,0:06:15.29,0:06:18.46,Default,,0,0,0,,Маған үзіліс жаса десе де, не істеуім керек?
Dialogue: 0,0:06:18.54,0:06:20.88,Default,,0,0,0,,Хонма, сен ақымақсың.
Dialogue: 0,0:06:20.96,0:06:21.71,Default,,0,0,0,,Ах
Dialogue: 0,0:06:22.17,0:06:25.30,Default,,0,0,0,,Әй, сен жасырын жаттығып жатқан жоқсың ғой?
Dialogue: 0,0:06:25.38,0:06:27.22,Default,,0,0,0,,Мен сенен басқашамын.
Dialogue: 0,0:06:27.30,0:06:30.01,Default,,0,0,0,,Демалыс күнін алудың мәні жоқ.
Dialogue: 0,0:06:30.09,0:06:30.76,Default,,0,0,0,,Не?!
Dialogue: 0,0:06:30.84,0:06:31.39,Default,,0,0,0,,Не!
Dialogue: 0,0:06:33.85,0:06:35.93,Default,,0,0,0,,Сота разряды туралы шешім
Dialogue: 0,0:06:38.10,0:06:39.64,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:06:39.73,0:06:41.56,Default,,0,0,0,,Жақсы жұмыс, Сота
Dialogue: 0,0:06:41.81,0:06:42.56,Default,,0,0,0,,Иә
Dialogue: 0,0:06:42.81,0:06:45.61,Default,,0,0,0,,Енді мен Динаның ойынын көруге болады.
Dialogue: 0,0:06:45.69,0:06:47.28,Default,,0,0,0,,Біз бірге барамыз.
Dialogue: 0,0:06:47.65,0:06:51.03,Default,,0,0,0,,Ей, ағайындар, сендер міндетті түрде жеңесіңдер, солай ма?
Dialogue: 0,0:06:51.41,0:06:54.20,Default,,0,0,0,,Әрине, Соута оны көруге келеді.
Dialogue: 0,0:06:54.41,0:06:56.45,Default,,0,0,0,,Тағы да бірге шайқасайық
Dialogue: 0,0:06:56.79,0:06:59.00,Default,,0,0,0,,Иә, жеңілмейтін сәуле
Dialogue: 0,0:07:01.08,0:07:03.33,Default,,0,0,0,,Жеңілмейтін сәуле Super
Dialogue: 0,0:07:04.09,0:07:06.63,Default,,0,0,0,,Ерекше жеңілмейтіндік Ах...
Dialogue: 0,0:07:09.01,0:07:11.38,Default,,0,0,0,,Үлкен аға ұйықтап жатыр.
Dialogue: 0,0:07:11.47,0:07:12.89,Default,,0,0,0,,Менің ойымша, сіз жеңілдеп қалдыңыз.
Dialogue: 0,0:07:13.47,0:07:15.81,Default,,0,0,0,,Дина да барын салды.
Dialogue: 0,0:07:15.93,0:07:17.31,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:07:17.68,0:07:20.35,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:07:20.56,0:07:23.23,Default,,0,0,0,,Сәлем! Бізге жаттығуға рұқсат етілмейді, солай ма?
Dialogue: 0,0:07:23.31,0:07:25.11,Default,,0,0,0,,Егер мен сені жіберіп алсам, сен тоқтауың керек.
Dialogue: 0,0:07:25.19,0:07:27.73,Default,,0,0,0,,Алдымен сіз тоқтаңыз.
Dialogue: 0,0:07:29.69,0:07:30.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:31.03,0:07:32.82,Default,,0,0,0,,Әй, шарлар!
Dialogue: 0,0:07:33.11,0:07:36.37,Default,,0,0,0,,Иә! Ахх! кешіріңіз~
Dialogue: 0,0:07:37.12,0:07:41.08,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:07:41.16,0:07:44.17,Default,,0,0,0,,Осы жерде күтіңіз. Осы жерде күтіңіз.
Dialogue: 0,0:07:45.13,0:07:47.46,Default,,0,0,0,,Сіз ыңғайсыз адамсыз, төменде күтіңіз.
Dialogue: 0,0:07:47.55,0:07:50.34,Default,,0,0,0,,Сіз не айтып тұрсыз? Жолда тұрған сенсің.
Dialogue: 0,0:07:50.72,0:07:52.93,Default,,0,0,0,,Құдай-ау, бұл не?
Dialogue: 0,0:07:53.01,0:07:55.14,Default,,0,0,0,,Бұдан былай мен әр қозғалған сайын
Dialogue: 0,0:07:55.22,0:07:57.05,Default,,0,0,0,,Жеңіл дене
Dialogue: 0,0:07:58.01,0:07:59.60,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:07:59.68,0:08:02.23,Default,,0,0,0,,Сәлем! Мен шарды алдым
Dialogue: 0,0:08:02.31,0:08:03.98,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:08:04.69,0:08:05.73,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:08:06.02,0:08:08.11,Default,,0,0,0,,Жоқ, мен түсе алмаймын.
Dialogue: 0,0:08:08.69,0:08:10.90,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:08:11.86,0:08:15.87,Default,,0,0,0,,Угья (Рантаро), сабыр ет, мені шайқама.
Dialogue: 0,0:08:21.91,0:08:23.79,Default,,0,0,0,,Шу~
Dialogue: 0,0:08:24.17,0:08:25.67,Default,,0,0,0,,Мен, мен…
Dialogue: 0,0:08:25.75,0:08:27.71,Default,,0,0,0,,Соғысайық!
Dialogue: 0,0:08:27.79,0:08:28.63,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:08:28.88,0:08:31.09,Default,,0,0,0,,Демалу өте шаршады.
Dialogue: 0,0:08:31.17,0:08:33.76,Default,,0,0,0,,Менің денем дірілдеп тұр.
Dialogue: 0,0:08:33.84,0:08:35.64,Default,,0,0,0,,Шуға да солай, солай ма?
Dialogue: 0,0:08:36.39,0:08:38.60,Default,,0,0,0,,О, сен не қарап тұрсың?
Dialogue: 0,0:08:39.22,0:08:42.23,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:08:42.56,0:08:45.23,Default,,0,0,0,,Қуырылған жұмыртқаны қараңыз!
Dialogue: 0,0:08:45.31,0:08:46.65,Default,,0,0,0,,Сізге ұқсайды.
Dialogue: 0,0:08:47.86,0:08:49.11,Default,,0,0,0,,Сәлем Барто
Dialogue: 0,0:08:49.48,0:08:52.28,Default,,0,0,0,,Мен... Жақсы көрінгені сонша, қарным ашты.
Dialogue: 0,0:08:52.69,0:08:56.28,Default,,0,0,0,,Уау! Дәмді көрінеді Дәмді көрінеді
Dialogue: 0,0:08:56.36,0:08:58.49,Default,,0,0,0,,Үлкен, үлкен
Dialogue: 0,0:08:58.57,0:08:59.95,Default,,0,0,0,,Аха…
Dialogue: 0,0:09:00.03,0:09:02.95,Default,,0,0,0,,Мені өз командаңызға қабылдағаныңыз үшін рахмет.
Dialogue: 0,0:09:03.04,0:09:05.37,Default,,0,0,0,,Финал Мен бар күшімді саламын!
Dialogue: 0,0:09:05.46,0:09:07.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:07.29,0:09:09.59,Default,,0,0,0,,Балалар сендер де осында келдіңдер ме?
Dialogue: 0,0:09:09.67,0:09:11.46,Default,,0,0,0,,Өйткені стадион бар.
Dialogue: 0,0:09:11.55,0:09:13.76,Default,,0,0,0,,Егер бұл Блейдер болса, ол келер еді.
Dialogue: 0,0:09:14.22,0:09:15.17,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:09:15.59,0:09:17.43,Default,,0,0,0,,Демалу ғажап.
Dialogue: 0,0:09:17.51,0:09:19.85,Default,,0,0,0,,Мен оның қаншалықты жеңіл екеніне таң қалдым.
Dialogue: 0,0:09:19.93,0:09:21.43,Default,,0,0,0,,Бұл жігіт жаңа ғана болды...
Dialogue: 0,0:09:21.60,0:09:22.77,Default,,0,0,0,,Т-тоқта… бұл мүмкін емес қой…
Dialogue: 0,0:09:22.85,0:09:26.44,Default,,0,0,0,,Бүгінгі күннің барлығы үшін демалыс күні тым көп емес пе?
Dialogue: 0,0:09:26.52,0:09:27.81,Default,,0,0,0,,Жаттығу жасайық!
Dialogue: 0,0:09:27.90,0:09:29.81,Default,,0,0,0,,Мені де араластырыңыз, араластырыңыз
Dialogue: 0,0:09:33.03,0:09:33.99,Default,,0,0,0,,Иә
Dialogue: 0,0:09:35.53,0:09:36.99,Default,,0,0,0,,Оны осы жерде қалдырайық.
Dialogue: 0,0:09:37.07,0:09:38.53,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:38.61,0:09:39.70,Default,,0,0,0,,Демалайық
Dialogue: 0,0:09:40.83,0:09:43.62,Default,,0,0,0,,Сіз шешім қабылдағаннан кейін оны ұстануыңыз керек.
Dialogue: 0,0:09:43.83,0:09:45.37,Default,,0,0,0,,Балто~
Dialogue: 0,0:09:47.25,0:09:48.75,Default,,0,0,0,,Нихихихи…
Dialogue: 0,0:09:49.83,0:09:54.01,Default,,0,0,0,,(орамалы дыбыс)
Dialogue: 0,0:09:58.30,0:09:59.64,Default,,0,0,0,,Даа!
Dialogue: 0,0:10:01.89,0:10:05.27,Default,,0,0,0,,(орамалы дыбыс)
Dialogue: 0,0:10:08.56,0:10:11.77,Default,,0,0,0,,Менің ойымша, бұл менің көп уақытымды алатын нәрсе.
Dialogue: 0,0:10:12.02,0:10:13.15,Default,,0,0,0,,Австралия
Dialogue: 0,0:10:13.23,0:10:16.11,Default,,0,0,0,,Луи, сіз жалғыз уақытыңызды бағалайсыз.
Dialogue: 0,0:10:16.19,0:10:17.45,Default,,0,0,0,,Мен өте жақсы білемін
Dialogue: 0,0:10:17.70,0:10:20.49,Default,,0,0,0,,Бірақ Rideout матчы да маңызды.
Dialogue: 0,0:10:20.91,0:10:24.41,Default,,0,0,0,,Мен сізге команда туралы бәрін қалдырамын дедім.
Dialogue: 0,0:10:24.49,0:10:28.96,Default,,0,0,0,,Мен күресуге тұрарлық деп санайтындармен ғана күресемін.
Dialogue: 0,0:10:29.04,0:10:29.83,Default,,0,0,0,,Луис
Dialogue: 0,0:10:29.96,0:10:30.75,Default,,0,0,0,,Шығу
Dialogue: 0,0:10:31.92,0:10:32.84,Default,,0,0,0,,Таку
Dialogue: 0,0:10:33.96,0:10:35.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:44.01,0:10:47.48,Default,,0,0,0,,көремін. Инускені бірінші рет жеп жатырсыз ба?
Dialogue: 0,0:10:47.56,0:10:50.10,Default,,0,0,0,,Дәмді Шудың неаполитаны
Dialogue: 0,0:10:57.65,0:10:58.74,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:58.99,0:11:00.32,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:11:00.78,0:11:03.28,Default,,0,0,0,,Дұрыс па? Көп жеңіз
Dialogue: 0,0:11:03.49,0:11:04.87,Default,,0,0,0,,Шуды толтыру
Dialogue: 0,0:11:04.95,0:11:05.79,Default,,0,0,0,,Мен де
Dialogue: 0,0:11:06.16,0:11:07.04,Default,,0,0,0,,Ваймоя
Dialogue: 0,0:11:07.37,0:11:08.87,Default,,0,0,0,,Балалар...
Dialogue: 0,0:11:09.04,0:11:10.71,Default,,0,0,0,,Мен сізге бір нәрсемен көмектесе аламын ба?
Dialogue: 0,0:11:10.79,0:11:11.75,Default,,0,0,0,,Одаққа қатысты оқиғалар немесе байқаулар туралы ешқандай хабар жоқ
Dialogue: 0,0:11:17.42,0:11:19.97,Default,,0,0,0,,Сіз өте шеберсіз. Сіз мұны екі қолыңызбен жасай аласыз ба?
Dialogue: 0,0:11:20.34,0:11:22.59,Default,,0,0,0,,А, мен жаттықтым.
Dialogue: 0,0:11:23.30,0:11:24.80,Default,,0,0,0,,Құрметті ойыншылар
Dialogue: 0,0:11:24.89,0:11:27.01,Default,,0,0,0,,Жеке күш қана емес
Dialogue: 0,0:11:27.10,0:11:28.14,Default,,0,0,0,,Топтық жұмыс
Dialogue: 0,0:11:28.43,0:11:29.98,Default,,0,0,0,,Бір-біріне көмектесу
Dialogue: 0,0:11:30.06,0:11:32.27,Default,,0,0,0,,Ол факторлар жеңіске немесе жеңіліске байланысты.
Dialogue: 0,0:11:32.35,0:11:33.81,Default,,0,0,0,,Топтық жарыс
Dialogue: 0,0:11:33.90,0:11:36.73,Default,,0,0,0,,Мен бүгін тамаша матчты күтемін.
Dialogue: 0,0:11:36.94,0:11:40.57,Default,,0,0,0,,Турнир төрағасы Синдзиро Комазаки болды.
Dialogue: 0,0:11:40.65,0:11:41.90,Default,,0,0,0,,Енді, ақырында
Dialogue: 0,0:11:41.99,0:11:44.87,Default,,0,0,0,,Финалға өткен екі топты таныстыру.
Dialogue: 0,0:11:44.95,0:11:45.74,Default,,0,0,0,,Камун
Dialogue: 0,0:11:46.95,0:11:48.20,Default,,0,0,0,,Қызыл бұрыш
Dialogue: 0,0:11:48.29,0:11:51.66,Default,,0,0,0,,Дотоның Йонекома Гакуэн Бей клубындағы жылдам дамуы
Dialogue: 0,0:11:52.08,0:11:53.12,Default,,0,0,0,,Бал-нии~
Dialogue: 0,0:11:53.21,0:11:54.29,Default,,0,0,0,,Шу-кун~
Dialogue: 0,0:11:54.63,0:11:56.04,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:11:56.34,0:11:59.67,Default,,0,0,0,,Көк бұрыш Бейблейдтің ең күшті тобы
Dialogue: 0,0:11:59.76,0:12:01.97,Default,,0,0,0,,Чемпионға шығу
Dialogue: 0,0:12:02.05,0:12:05.26,Default,,0,0,0,,О? Бүгін де Ширасадиджо Руи жоқ па?
Dialogue: 0,0:12:05.68,0:12:08.18,Default,,0,0,0,,Австралиялық Сенпай Луи туралы не деуге болады?
Dialogue: 0,0:12:08.43,0:12:10.77,Default,,0,0,0,,Финалда төртеуміз жеңдік.
Dialogue: 0,0:12:10.89,0:12:12.10,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:12:12.18,0:12:12.81,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:12:13.39,0:12:16.77,Default,,0,0,0,,Енді финалдық матч 5 ұпайлық жеңіс жүйесі.
Dialogue: 0,0:12:16.86,0:12:18.36,Default,,0,0,0,,Үш мүше тіркелуі мүмкін.
Dialogue: 0,0:12:18.69,0:12:21.78,Default,,0,0,0,,Алғашқы үш шайқас нәтижесіз болса
Dialogue: 0,0:12:21.86,0:12:23.15,Default,,0,0,0,,Ойын овертаймға өтеді.
Dialogue: 0,0:12:23.24,0:12:26.07,Default,,0,0,0,,Одан кейін кімнің қатысқаны маңызды емес.
Dialogue: 0,0:12:26.45,0:12:28.24,Default,,0,0,0,,Бұл жеңіс үшін шайқас
Dialogue: 0,0:12:28.33,0:12:30.58,Default,,0,0,0,,Мүшелеріңізді мұқият таңдаңыз
Dialogue: 0,0:12:31.04,0:12:33.04,Default,,0,0,0,,Демалғаннан кейін өзімді жеңіл сезінемін.
Dialogue: 0,0:12:33.50,0:12:35.67,Default,,0,0,0,,Аа, сіз тамаша істеп жатырсыз.
Dialogue: 0,0:12:35.75,0:12:38.42,Default,,0,0,0,,Алғашқы үштікке кім кіреді?
Dialogue: 0,0:12:38.88,0:12:39.92,Default,,0,0,0,,О? Ммм
Dialogue: 0,0:12:40.00,0:12:41.76,Default,,0,0,0,,Барт, сен шешесің.
Dialogue: 0,0:12:41.84,0:12:43.09,Default,,0,0,0,,Е, мен
Dialogue: 0,0:12:43.59,0:12:46.01,Default,,0,0,0,,Әй, бұл қандай жел?
Dialogue: 0,0:12:46.22,0:12:49.39,Default,,0,0,0,,Финалда мен капитанға тән нәрселерді жасаймын.
Dialogue: 0,0:12:49.64,0:12:51.47,Default,,0,0,0,,О, мен түсіндім.
Dialogue: 0,0:12:51.72,0:12:54.02,Default,,0,0,0,,Жарайсың Дина Шу
Dialogue: 0,0:12:54.10,0:12:56.40,Default,,0,0,0,,Және Кумичо.
Dialogue: 0,0:12:56.48,0:12:57.81,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:12:57.90,0:12:59.90,Default,,0,0,0,,Сонда сізде жоқ па?
Dialogue: 0,0:13:06.07,0:13:07.24,Default,,0,0,0,,(Қате дыбысы)
Dialogue: 0,0:13:07.87,0:13:09.53,Default,,0,0,0,,Иә? неге?
Dialogue: 0,0:13:09.95,0:13:11.70,Default,,0,0,0,,Сіз үш адамды таңдадыңыз, солай ма?
Dialogue: 0,0:13:11.79,0:13:14.91,Default,,0,0,0,,Аа, мені қоюды ұмытып кетіппін.
Dialogue: 0,0:13:16.50,0:13:18.46,Default,,0,0,0,,Бірінші шығу
Dialogue: 0,0:13:18.58,0:13:21.55,Default,,0,0,0,,Жас ұпай иегері Кио Саннай
Dialogue: 0,0:13:21.63,0:13:24.17,Default,,0,0,0,,Йонекома Гакуэн Бей клубына қарсы
Dialogue: 0,0:13:24.26,0:13:27.09,Default,,0,0,0,,Диареяның жаны Рантаро Кияма
Dialogue: 0,0:13:27.18,0:13:29.51,Default,,0,0,0,,Ақыры финалға жетті
Dialogue: 0,0:13:29.97,0:13:33.81,Default,,0,0,0,,Қазір баяғыда сияқты.
Dialogue: 0,0:13:34.64,0:13:37.39,Default,,0,0,0,,Мен және Дина жеке матчтарға қатыспаймыз.
Dialogue: 0,0:13:37.48,0:13:38.77,Default,,0,0,0,,Сонымен, бұл...
Dialogue: 0,0:13:38.85,0:13:41.02,Default,,0,0,0,,Бұл турнирдің соңғы шайқасы.
Dialogue: 0,0:13:41.86,0:13:43.57,Default,,0,0,0,,Мен жеңіле алмаймын!
Dialogue: 0,0:13:45.74,0:13:48.49,Default,,0,0,0,,Жарайды! Мен жеңемін!
Dialogue: 0,0:13:49.53,0:13:53.58,Default,,0,0,0,,Десе де, сіздің шығанақтарыңыз тас-талқан болып жатыр.
Dialogue: 0,0:13:53.66,0:13:55.75,Default,,0,0,0,,Мен оны жұлып аламын
Dialogue: 0,0:13:55.83,0:13:57.08,Default,,0,0,0,,Ой
Dialogue: 0,0:13:57.16,0:14:01.34,Default,,0,0,0,,Рантаро Киямадан күшті жеңіс туралы мәлімдеме шықты.
Dialogue: 0,0:14:01.67,0:14:04.38,Default,,0,0,0,,Қатты дауыс шығарып жеңе алмайсың.
Dialogue: 0,0:14:04.71,0:14:08.13,Default,,0,0,0,,Ей, мен сенен ұтыла алмаймын.
Dialogue: 0,0:14:08.47,0:14:09.39,Default,,0,0,0,,Не?!
Dialogue: 0,0:14:09.76,0:14:11.47,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:14:13.56,0:14:17.10,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:17.18,0:14:19.27,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:19.35,0:14:20.31,Default,,0,0,0,,Бұл – Демоноруқтар корпусы! Мұнда ойланбастан кіруге болмайды!
Dialogue: 0,0:14:22.27,0:14:25.57,Default,,0,0,0,,Рагнаруктың көтерілуі Орталықта аяқталды
Dialogue: 0,0:14:25.65,0:14:29.07,Default,,0,0,0,,Мен сізге ерлер арасындағы қызу шайқасты көрсетейін!
Dialogue: 0,0:14:29.45,0:14:31.28,Default,,0,0,0,,Мен жеңген адаммын
Dialogue: 0,0:14:33.41,0:14:35.24,Default,,0,0,0,,Бірінші байланыс
Dialogue: 0,0:14:35.33,0:14:37.79,Default,,0,0,0,,Бірақ Рагнарук орнынан қозғалмады.
Dialogue: 0,0:14:38.12,0:14:40.21,Default,,0,0,0,,Келесі соққы жарылады.
Dialogue: 0,0:14:40.58,0:14:42.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:42.17,0:14:44.55,Default,,0,0,0,,Рагнарук аймағы
Dialogue: 0,0:14:45.05,0:14:47.67,Default,,0,0,0,,Оны бөліктерге бөліңіз
Dialogue: 0,0:14:52.89,0:14:53.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:54.18,0:14:55.85,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:14:56.02,0:14:59.39,Default,,0,0,0,,Көтерілген Рагнарук мәреге жеткені үшін 1 ұпай
Dialogue: 0,0:15:00.14,0:15:01.31,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:02.10,0:15:03.90,Default,,0,0,0,,Көрдіңіз бе? Балтық
Dialogue: 0,0:15:03.98,0:15:05.15,Default,,0,0,0,,Кумичо
Dialogue: 0,0:15:05.48,0:15:07.19,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:15:07.74,0:15:09.61,Default,,0,0,0,,Бұл ерлердің шайқасы!
Dialogue: 0,0:15:10.20,0:15:11.91,Default,,0,0,0,,Мен ол адамды көрдім...
Dialogue: 0,0:15:11.99,0:15:13.37,Default,,0,0,0,,Қызу шайқас!
Dialogue: 0,0:15:13.82,0:15:15.99,Default,,0,0,0,,Кумичо керемет~
Dialogue: 0,0:15:16.54,0:15:18.66,Default,,0,0,0,,Хуаншанның рухы басым болды.
Dialogue: 0,0:15:19.46,0:15:21.04,Default,,0,0,0,,Мен де осы турнирге қатысамын
Dialogue: 0,0:15:21.12,0:15:22.67,Default,,0,0,0,,Оны ауыртпалықсыз шайқасқа айналдырыңыз
Dialogue: 0,0:15:23.63,0:15:25.13,Default,,0,0,0,,Келесі
Dialogue: 0,0:15:25.21,0:15:27.46,Default,,0,0,0,,Rideout-тың абсолютті көшбасшысы
Dialogue: 0,0:15:27.55,0:15:28.88,Default,,0,0,0,,Чакаке барыңыз
Dialogue: 0,0:15:28.96,0:15:33.18,Default,,0,0,0,,Қарсылас – орақ орағы бар адам.
Dialogue: 0,0:15:33.26,0:15:34.85,Default,,0,0,0,,Қара Құдай Дина
Dialogue: 0,0:15:36.76,0:15:38.64,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:15:39.06,0:15:40.73,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:15:40.81,0:15:42.10,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:15:42.19,0:15:44.15,Default,,0,0,0,,Жеңілмейтін сәуле
Dialogue: 0,0:15:44.23,0:15:44.94,Default,,0,0,0,,Әй
Dialogue: 0,0:15:45.11,0:15:46.73,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:15:47.40,0:15:49.44,Default,,0,0,0,,Гигант Гая – теңдестірілген тип
Dialogue: 0,0:15:49.90,0:15:53.03,Default,,0,0,0,,Мен сияқты шабуыл түрі бар Одинмен соғысқанда.
Dialogue: 0,0:15:53.49,0:15:55.78,Default,,0,0,0,,Орталықты көздеді.
Dialogue: 0,0:15:55.87,0:15:56.91,Default,,0,0,0,,Бұл жолы да шығар
Dialogue: 0,0:15:57.66,0:16:00.33,Default,,0,0,0,,Сонда мен оны алдаймын.
Dialogue: 0,0:16:00.41,0:16:02.25,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:16:02.67,0:16:05.67,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:06.13,0:16:08.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:09.59,0:16:11.34,Default,,0,0,0,,Екі кадр да
Dialogue: 0,0:16:11.42,0:16:14.13,Default,,0,0,0,,Ой, Deathsizer көлденең шұңқыры.
Dialogue: 0,0:16:14.22,0:16:16.22,Default,,0,0,0,,Гигант Гая - қиғаш түсіру
Dialogue: 0,0:16:16.35,0:16:17.30,Default,,0,0,0,,Оқыңыз
Dialogue: 0,0:16:17.39,0:16:18.18,Default,,0,0,0,,Не!
Dialogue: 0,0:16:18.64,0:16:20.47,Default,,0,0,0,,Бір қозғалысты екі рет қолданасыз ба?
Dialogue: 0,0:16:22.18,0:16:23.77,Default,,0,0,0,,Dodge Death Sizeer
Dialogue: 0,0:16:24.27,0:16:26.86,Default,,0,0,0,,Гигант Гайя қайтадан жақындап келеді
Dialogue: 0,0:16:26.94,0:16:28.77,Default,,0,0,0,,Жалтарған өлімші
Dialogue: 0,0:16:29.40,0:16:30.44,Default,,0,0,0,,Жалтарған
Dialogue: 0,0:16:30.53,0:16:31.65,Default,,0,0,0,,Қайтадан қашты
Dialogue: 0,0:16:32.32,0:16:34.11,Default,,0,0,0,,Қайтадан қашып кетті
Dialogue: 0,0:16:34.20,0:16:36.49,Default,,0,0,0,,Осы қарқынмен менің төзімділігім...
Dialogue: 0,0:16:36.74,0:16:38.12,Default,,0,0,0,,Енді қарсы шабуылға шығу уақыты келді.
Dialogue: 0,0:16:38.24,0:16:40.58,Default,,0,0,0,,Жүр!
Dialogue: 0,0:16:44.67,0:16:45.67,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:16:48.29,0:16:50.84,Default,,0,0,0,,Оны жуыңыз! өлім өлшемі
Dialogue: 0,0:16:50.92,0:16:53.05,Default,,0,0,0,,Жүр! Гая!
Dialogue: 0,0:17:03.48,0:17:05.19,Default,,0,0,0,,Айналмалы есептегіш!
Dialogue: 0,0:17:05.89,0:17:07.44,Default,,0,0,0,,Үйге қайт!
Dialogue: 0,0:17:16.53,0:17:17.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:17.78,0:17:20.24,Default,,0,0,0,,Қайсысы бірінші күштірек болады?
Dialogue: 0,0:17:20.58,0:17:22.33,Default,,0,0,0,,Қатты шабуыл және қорғаныс
Dialogue: 0,0:17:22.41,0:17:25.37,Default,,0,0,0,,Соңында бұл төзімділік сынағы болды.
Dialogue: 0,0:17:25.46,0:17:27.25,Default,,0,0,0,,Енді қайсысы бірінші келеді?
Dialogue: 0,0:17:27.33,0:17:28.17,Default,,0,0,0,,бірінші
Dialogue: 0,0:17:28.25,0:17:30.21,Default,,0,0,0,,А-а-а
Dialogue: 0,0:17:30.29,0:17:33.26,Default,,0,0,0,,Deathsizer айналуы сәл ертерек тоқтады.
Dialogue: 0,0:17:33.34,0:17:34.13,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:34.21,0:17:37.43,Default,,0,0,0,,Гигант Гая 1 ұпай айналдыру үшін
Dialogue: 0,0:17:37.80,0:17:39.30,Default,,0,0,0,,Ах... Куу!
Dialogue: 0,0:17:40.14,0:17:41.22,Default,,0,0,0,,А...
Dialogue: 0,0:17:43.64,0:17:45.64,Default,,0,0,0,,Австралиялық Сенпай керемет
Dialogue: 0,0:17:45.73,0:17:48.69,Default,,0,0,0,,Мен де Сенпай сияқты күресуді мақсат тұтамын.
Dialogue: 0,0:17:48.77,0:17:51.11,Default,,0,0,0,,Қалғанын саған тапсырамын, Шинки.
Dialogue: 0,0:17:51.19,0:17:52.23,Default,,0,0,0,,О
Dialogue: 0,0:17:52.52,0:17:53.94,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:17:54.94,0:17:57.95,Default,,0,0,0,,Сута Әлі жоқ, Дина жеңілген жоқ.
Dialogue: 0,0:17:58.07,0:17:58.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:58.99,0:18:01.45,Default,,0,0,0,,Rideout 1 ұпай алады
Dialogue: 0,0:18:01.62,0:18:03.29,Default,,0,0,0,,Бұл 1-1 тең.
Dialogue: 0,0:18:04.37,0:18:06.66,Default,,0,0,0,,Кешіріңіз, бәріңіз.
Dialogue: 0,0:18:08.50,0:18:11.42,Default,,0,0,0,,Біреуді алса, досы қайтарып алады.
Dialogue: 0,0:18:11.54,0:18:13.30,Default,,0,0,0,,Бұл командалық шайқас.
Dialogue: 0,0:18:14.25,0:18:15.84,Default,,0,0,0,,Сіз мұны айттыңыз.
Dialogue: 0,0:18:16.22,0:18:17.55,Default,,0,0,0,,Вакия
Dialogue: 0,0:18:17.63,0:18:19.26,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:18:19.55,0:18:20.64,Default,,0,0,0,,Сота
Dialogue: 0,0:18:21.05,0:18:25.22,Default,,0,0,0,,Инсуке-чан командалық жарыста барлығы бірге күресетінін айтты.
Dialogue: 0,0:18:25.31,0:18:28.31,Default,,0,0,0,,Сондықтан ағам әлі жеңілген жоқ.
Dialogue: 0,0:18:28.73,0:18:32.23,Default,,0,0,0,,Ағамның шайқасы келесіге апарады.
Dialogue: 0,0:18:33.48,0:18:36.94,Default,,0,0,0,,Жүр! Йонекома Гакуен!
Dialogue: 0,0:18:38.24,0:18:40.45,Default,,0,0,0,,Ол ең жақсы іні емес пе?
Dialogue: 0,0:18:41.99,0:18:42.91,Default,,0,0,0,,О
Dialogue: 0,0:18:44.66,0:18:45.54,Default,,0,0,0,,Барт
Dialogue: 0,0:18:46.12,0:18:47.50,Default,,0,0,0,,Оны сақтаңыз.
Dialogue: 0,0:18:47.58,0:18:49.41,Default,,0,0,0,,Не? Шу
Dialogue: 0,0:18:51.25,0:18:52.50,Default,,0,0,0,,Қолғаптар
Dialogue: 0,0:18:52.88,0:18:55.84,Default,,0,0,0,,Ридоуттың миы Шинки Микуни
Dialogue: 0,0:18:55.92,0:18:59.47,Default,,0,0,0,,Йонекома академиясында төрт құбылмалы император Бенишу пайда болды.
Dialogue: 0,0:18:59.76,0:19:02.34,Default,,0,0,0,,Бір кезде иығын ауыртты деген қауесет тарады.
Dialogue: 0,0:19:02.47,0:19:04.05,Default,,0,0,0,,Бүгін қалайсың?
Dialogue: 0,0:19:04.22,0:19:06.60,Default,,0,0,0,,Бұл қауесет емес.
Dialogue: 0,0:19:06.72,0:19:09.02,Default,,0,0,0,,Аурудан айыққаннан кейін соғұрлым көп жеңе аласыз
Dialogue: 0,0:19:09.10,0:19:11.06,Default,,0,0,0,,Сыртқа шығу оңай емес.
Dialogue: 0,0:19:11.56,0:19:14.44,Default,,0,0,0,,Әй, қолғапыңа не болды?
Dialogue: 0,0:19:15.98,0:19:17.15,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:19:23.57,0:19:24.62,Default,,0,0,0,,Не?
Dialogue: 0,0:19:24.87,0:19:27.33,Default,,0,0,0,,
Dialogue: 0,0:19:27.66,0:19:29.96,Default,,0,0,0,,Бұл... бұл Куришуу
Dialogue: 0,0:19:30.04,0:19:33.25,Default,,0,0,0,,Әй, ол солақай атуға көшті.
Dialogue: 0,0:19:33.33,0:19:34.54,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:19:35.34,0:19:36.34,Default,,0,0,0,,Шу
Dialogue: 0,0:19:36.67,0:19:39.42,Default,,0,0,0,,Куришуу оң қолы, солай ма?
Dialogue: 0,0:19:39.51,0:19:40.59,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:19:40.67,0:19:41.59,Default,,0,0,0,,Шулы!
Dialogue: 0,0:19:41.68,0:19:42.93,Default,,0,0,0,,Сол қолмен ату…
Dialogue: 0,0:19:43.76,0:19:45.10,Default,,0,0,0,,(Норияки) Онда Үндістанмен қоштасу уақыты келді
Dialogue: 0,0:19:45.89,0:19:46.97,Default,,0,0,0,,Хуаншан
Dialogue: 0,0:19:47.06,0:19:48.14,Default,,0,0,0,,Қара құдай
Dialogue: 0,0:19:48.72,0:19:51.56,Default,,0,0,0,,Сезіміңді байланыстырамын
Dialogue: 0,0:19:51.94,0:19:53.94,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:19:54.44,0:19:57.94,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:58.03,0:20:00.28,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:02.03,0:20:03.70,Default,,0,0,0,,Керемет! Апыр-ай!
Dialogue: 0,0:20:03.78,0:20:07.45,Default,,0,0,0,,Бұл ешбір серпілмей, шынымен тегіс қону.
Dialogue: 0,0:20:07.53,0:20:10.58,Default,,0,0,0,,Оң қолмен атуға қарағанда ату тұрақтырақ.
Dialogue: 0,0:20:10.66,0:20:14.29,Default,,0,0,0,,Іске қосқышты тыңдаушы қолыңызбен ұстаған кезде діріл азайды ма?
Dialogue: 0,0:20:14.63,0:20:17.25,Default,,0,0,0,,Бірінші байланыс
Dialogue: 0,0:20:17.34,0:20:18.80,Default,,0,0,0,,Бұл қатты шабуыл.
Dialogue: 0,0:20:19.71,0:20:22.72,Default,,0,0,0,,Сол қолмен атуды шынымен де меңгергіңіз келе ме?
Dialogue: 0,0:20:22.80,0:20:25.01,Default,,0,0,0,,Жақсы, оны ұсақтап тастаңыз.
Dialogue: 0,0:20:29.56,0:20:31.48,Default,,0,0,0,,Бұл күшті шабуыл.
Dialogue: 0,0:20:32.64,0:20:35.44,Default,,0,0,0,,Спригганға қарсы үзіліс!
Dialogue: 0,0:20:38.57,0:20:39.86,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:42.82,0:20:46.82,Default,,0,0,0,,Сторм Спригган 2 ұпай
Dialogue: 0,0:20:47.45,0:20:49.62,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:50.91,0:20:54.50,Default,,0,0,0,,Куришуу күтпеген жерден сол қолмен соққымен жеңіске жетті
Dialogue: 0,0:20:54.58,0:20:55.92,Default,,0,0,0,,Енді 3-тен 1-ге дейін
Dialogue: 0,0:20:56.29,0:20:59.67,Default,,0,0,0,,Йонекома Гакуэн Бэй клубы 2 ұпаймен алда
Dialogue: 0,0:20:59.96,0:21:01.38,Default,,0,0,0,,Не болып жатыр өзі?
Dialogue: 0,0:21:01.46,0:21:03.63,Default,,0,0,0,,Мен мұндай жігітті қалай жеңемін...
Dialogue: 0,0:21:03.76,0:21:06.34,Default,,0,0,0,,Егер солай болса, кет! Бұл ояту қоңырауы!
Dialogue: 0,0:21:06.43,0:21:07.01,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:09.26,0:21:10.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:16.10,0:21:17.10,Default,,0,0,0,,Луис мырза...
Dialogue: 0,0:21:18.11,0:21:22.23,Default,,0,0,0,,Ширасаги Castle Louis осы уақытқа дейін ешқашан командалық матчқа қатысқан емес.
Dialogue: 0,0:21:22.32,0:21:23.49,Default,,0,0,0,,Соғысқа ақыры қосылдың ба?
Dialogue: 0,0:21:24.61,0:21:26.11,Default,,0,0,0,,Луи~!
Dialogue: 0,0:21:26.20,0:21:27.95,Default,,0,0,0,,Сабыр ет, Балто.
Dialogue: 0,0:21:28.24,0:21:28.95,Default,,0,0,0,,Луис
Dialogue: 0,0:21:29.03,0:21:30.78,Default,,0,0,0,,Сіз естіген жоқсыз ба?
Dialogue: 0,0:21:30.87,0:21:31.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:33.16,0:21:34.37,Default,,0,0,0,,Жоғал
Dialogue: 0,0:21:34.54,0:21:36.87,Default,,0,0,0,,Сіздің атқа мінуге құқығыңыз жоқ.
Dialogue: 0,0:21:38.83,0:21:40.21,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:21:40.63,0:21:42.55,Default,,0,0,0,,Жақсы қуық жоқ
Dialogue: 0,0:21:44.05,0:21:45.51,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:51.56,0:21:53.85,Default,,0,0,0,,(қорқынышсыз күлімсіреу)
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.44,0:23:28.53,Default,,0,0,0,,Ол ақыры келді.
Dialogue: 0,0:23:28.65,0:23:32.03,Default,,0,0,0,,Күшті шайқасқа шығыңыз, Ширасаги Castle Louis
Dialogue: 0,0:23:32.11,0:23:35.03,Default,,0,0,0,,Мен сізге өте оянған Валькирияның күшін көрсетемін.
Dialogue: 0,0:23:35.58,0:23:38.12,Default,,0,0,0,,Солға бұрылыңыз... Бұл не?
Dialogue: 0,0:23:38.62,0:23:40.46,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:23:41.00,0:23:43.21,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.29,0:23:45.88,Default,,0,0,0,,Өлім шайқасы! Лонгинуспен шайқас!
Dialogue: 0,0:23:45.96,0:23:47.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.84,0:23:49.67,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.17,0:23:57.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory