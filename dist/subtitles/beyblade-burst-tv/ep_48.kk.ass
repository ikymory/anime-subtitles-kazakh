Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.63,0:00:14.80,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.88,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:19.10,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.36,0:00:34.36,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:34.49,0:00:36.87,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:36.95,0:00:38.03,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:00:38.12,0:00:38.99,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:00:42.50,0:00:44.50,Default,,0,0,0,,Керемет шеңбер
Dialogue: 0,0:00:44.62,0:00:46.12,Default,,0,0,0,,Бұл менің сахнам!
Dialogue: 0,0:00:46.21,0:00:48.88,Default,,0,0,0,,Циллион Зевс финалы!
Dialogue: 0,0:00:56.93,0:00:59.26,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:01.60,0:01:02.89,Default,,0,0,0,,Анубис…
Dialogue: 0,0:01:03.68,0:01:06.90,Default,,0,0,0,,Менің жартылай финалдағы қарсыласым Зак болып шешілді.
Dialogue: 0,0:01:07.40,0:01:09.06,Default,,0,0,0,,Зактың домалаған соққысы
Dialogue: 0,0:01:09.19,0:01:10.77,Default,,0,0,0,,Өте керемет
Dialogue: 0,0:01:11.02,0:01:13.49,Default,,0,0,0,,Мен сені міндетті түрде жеңемін.
Dialogue: 0,0:01:22.79,0:01:25.16,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:25.50,0:01:30.67,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:41.97,0:01:45.35,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:45.85,0:01:47.98,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:48.39,0:01:52.52,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:52.65,0:01:55.86,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:55.99,0:02:02.41,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:02.70,0:02:07.12,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:07.62,0:02:13.04,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:13.17,0:02:15.42,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:15.51,0:02:20.22,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:20.39,0:02:25.47,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:25.77,0:02:28.02,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:28.23,0:02:30.56,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:30.85,0:02:34.77,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:34.94,0:02:39.95,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:40.16,0:02:42.32,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:46.54,0:02:50.00,Default,,0,0,0,,Бакутан VS Бакусу!
Dialogue: 0,0:02:51.21,0:02:53.96,Default,,0,0,0,,Зактың домалау соққысын қалай жеңуге болады
Dialogue: 0,0:02:54.13,0:02:55.25,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:02:55.34,0:02:56.84,Default,,0,0,0,,Бұл жарылыс.
Dialogue: 0,0:02:57.21,0:02:58.84,Default,,0,0,0,,Бакусу атылды ма?
Dialogue: 0,0:02:58.97,0:03:00.22,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:00.30,0:03:02.26,Default,,0,0,0,,Шақаға қарсы көрсеткеніңіз...
Dialogue: 0,0:03:02.34,0:03:04.89,Default,,0,0,0,,Ол Дэн Дэн Дарн деп аталады.
Dialogue: 0,0:03:05.22,0:03:07.68,Default,,0,0,0,,Мен мұны істедім бе?
Dialogue: 0,0:03:07.77,0:03:09.52,Default,,0,0,0,,Қараңызшы, міне, осы.
Dialogue: 0,0:03:10.73,0:03:12.40,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:03:13.06,0:03:14.02,Default,,0,0,0,,Үш
Dialogue: 0,0:03:14.73,0:03:15.73,Default,,0,0,0,,Екі
Dialogue: 0,0:03:16.19,0:03:17.15,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:03:17.69,0:03:20.65,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:23.87,0:03:25.66,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:03:26.16,0:03:27.95,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:03:28.04,0:03:31.00,Default,,0,0,0,,Не, шынымен есіңде жоқ па?
Dialogue: 0,0:03:31.21,0:03:32.17,Default,,0,0,0,,О
Dialogue: 0,0:03:32.25,0:03:34.42,Default,,0,0,0,,Сіз өте шоғырланған болуыңыз керек.
Dialogue: 0,0:03:34.92,0:03:37.80,Default,,0,0,0,,Мен осындай керемет нәрсе жасадым ба?
Dialogue: 0,0:03:40.05,0:03:42.84,Default,,0,0,0,,Мен бұл аймаққа байланысты екеніне сенімдімін.
Dialogue: 0,0:03:43.26,0:03:45.14,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:03:46.14,0:03:47.01,Default,,0,0,0,,Үш
Dialogue: 0,0:03:47.26,0:03:48.14,Default,,0,0,0,,Екі
Dialogue: 0,0:03:48.51,0:03:49.39,Default,,0,0,0,,Бір…
Dialogue: 0,0:03:49.52,0:03:50.81,Default,,0,0,0,,Уау~
Dialogue: 0,0:03:51.39,0:03:53.69,Default,,0,0,0,,Бару-нии (Хинацу Аои) Аға, аа...
Dialogue: 0,0:03:54.48,0:03:55.52,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:03:55.61,0:03:56.52,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,0:03:56.81,0:03:58.94,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:03:59.03,0:04:00.03,Default,,0,0,0,,Үш
Dialogue: 0,0:04:00.24,0:04:01.19,Default,,0,0,0,,Екі
Dialogue: 0,0:04:01.53,0:04:02.36,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:04:03.82,0:04:04.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:05.20,0:04:07.62,Default,,0,0,0,,Менімен қалжыңдауға болмайды.
Dialogue: 0,0:04:08.03,0:04:09.41,Default,,0,0,0,,Жарайды, Балто.
Dialogue: 0,0:04:09.49,0:04:11.25,Default,,0,0,0,,Енді жарылғыш жаттығулардың уақыты келді.
Dialogue: 0,0:04:12.04,0:04:13.16,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:04:13.50,0:04:14.83,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,0:04:14.92,0:04:15.63,Default,,0,0,0,,О
Dialogue: 0,0:04:16.54,0:04:18.17,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:18.67,0:04:20.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:20.59,0:04:21.63,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:04:21.71,0:04:23.30,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:23.55,0:04:24.59,Default,,0,0,0,,Ну!
Dialogue: 0,0:04:25.89,0:04:26.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:30.10,0:04:31.47,Default,,0,0,0,,Ах~
Dialogue: 0,0:04:31.56,0:04:33.77,Default,,0,0,0,,Неліктен мен мұны істей алмаймын?
Dialogue: 0,0:04:33.85,0:04:35.44,Default,,0,0,0,,Мен мұны естігім келеді.
Dialogue: 0,0:04:35.52,0:04:38.48,Default,,0,0,0,,Осының бәрінен кейін бір рет болса да мен қалай жетістікке жете аламын?
Dialogue: 0,0:04:38.56,0:04:41.90,Default,,0,0,0,,Шакаға қарсы бірнеше рет гол соқты.
Dialogue: 0,0:04:41.99,0:04:44.03,Default,,0,0,0,,Одан айырмашылығы неде?
Dialogue: 0,0:04:44.78,0:04:46.57,Default,,0,0,0,,Бакусу түсірілімі үшін
Dialogue: 0,0:04:47.20,0:04:49.41,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:49.49,0:04:51.12,Default,,0,0,0,,Тіпті домалау үшін
Dialogue: 0,0:04:51.20,0:04:52.41,Default,,0,0,0,,Мен сенің жеңетініңе сенімдімін
Dialogue: 0,0:04:52.70,0:04:53.96,Default,,0,0,0,,Бакусу ату
Dialogue: 0,0:04:54.04,0:04:55.96,Default,,0,0,0,,Мен оны міндетті түрде сәтті орындаймын
Dialogue: 0,0:04:56.50,0:04:57.46,Default,,0,0,0,,О
Dialogue: 0,0:04:59.09,0:05:00.96,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:05:01.63,0:05:02.88,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:05:04.05,0:05:07.97,Default,,0,0,0,,Бір екі бір екі
Dialogue: 0,0:05:08.72,0:05:10.76,Default,,0,0,0,,Киракира-кунның жарылғыш атуы
Dialogue: 0,0:05:11.18,0:05:12.85,Default,,0,0,0,,Бұған қалай қарсы тұруға болады
Dialogue: 0,0:05:13.64,0:05:14.64,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:05:15.35,0:05:16.35,Default,,0,0,0,,Не!
Dialogue: 0,0:05:21.19,0:05:22.03,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:05:22.40,0:05:24.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:27.66,0:05:29.62,Default,,0,0,0,,Мен әлі де баруым керек.
Dialogue: 0,0:05:29.70,0:05:31.20,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:05:31.28,0:05:32.66,Default,,0,0,0,,Күшті
Dialogue: 0,0:05:37.54,0:05:38.67,Default,,0,0,0,,Спригган
Dialogue: 0,0:05:39.17,0:05:41.29,Default,,0,0,0,,Біздің жолымызды ашыңыз
Dialogue: 0,0:05:41.75,0:05:42.92,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:05:44.13,0:05:45.88,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:46.55,0:05:47.68,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:47.80,0:05:49.09,Default,,0,0,0,,(Еденге түскен сымның дыбысы)
Dialogue: 0,0:05:49.59,0:05:51.68,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:05:52.89,0:05:54.43,Default,,0,0,0,,Нуаа!
Dialogue: 0,0:05:54.72,0:05:56.31,Default,,0,0,0,,(Еденге соғылған сымның дыбысы)
Dialogue: 0,0:05:58.98,0:06:01.52,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:06:01.65,0:06:06.03,Default,,0,0,0,,WBBA ұлттық турнирінің соңында жартылай финал
Dialogue: 0,0:06:06.44,0:06:07.36,Default,,0,0,0,,Келіңдер, бәрің
Dialogue: 0,0:06:07.70,0:06:10.03,Default,,0,0,0,,Финалға шығуға тырысатын блейдерлер
Dialogue: 0,0:06:10.11,0:06:11.66,Default,,0,0,0,,Ыстық шайқас
Dialogue: 0,0:06:11.74,0:06:13.08,Default,,0,0,0,,Үміттенейік
Dialogue: 0,0:06:13.70,0:06:15.37,Default,,0,0,0,,Мен сіздің шайқастарыңызды көрмеймін
Dialogue: 0,0:06:15.45,0:06:16.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:16.75,0:06:18.75,Default,,0,0,0,,Келесі жолы ойыннан кейін кездесеміз.
Dialogue: 0,0:06:19.25,0:06:21.38,Default,,0,0,0,,Мен шайқасқа назар аударамын
Dialogue: 0,0:06:21.88,0:06:24.34,Default,,0,0,0,,А, мен жеңемін.
Dialogue: 0,0:06:24.84,0:06:26.09,Default,,0,0,0,,Сонымен Шу
Dialogue: 0,0:06:26.46,0:06:27.42,Default,,0,0,0,,Иә
Dialogue: 0,0:06:28.05,0:06:31.51,Default,,0,0,0,,Енді бірінші жартылай финалдық ойынға арналған ойын
Dialogue: 0,0:06:31.59,0:06:34.76,Default,,0,0,0,,Қиын шайқастан кейін жанып тұрған ғибадатхананың төрт өзгерген императоры Кайзаны жеңді.
Dialogue: 0,0:06:35.72,0:06:39.06,Default,,0,0,0,,Ғажайып бала Балто Аои!
Dialogue: 0,0:06:39.69,0:06:41.23,Default,,0,0,0,,Барыңды істе, ағайын!
Dialogue: 0,0:06:41.60,0:06:42.73,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:06:43.73,0:06:45.57,Default,,0,0,0,,Және қарсы
Dialogue: 0,0:06:45.98,0:06:48.07,Default,,0,0,0,,Жұлдыз жарығы!
Dialogue: 0,0:06:49.49,0:06:51.57,Default,,0,0,0,,Барлық жұлдыздар жарқырайды
Dialogue: 0,0:06:51.66,0:06:53.57,Default,,0,0,0,,Асыл және күшті жарық
Dialogue: 0,0:06:55.24,0:06:58.08,Default,,0,0,0,,Бүкіл әлемді нұрландыратын күн
Dialogue: 0,0:06:58.20,0:06:58.96,Default,,0,0,0,,О!
Dialogue: 0,0:06:59.25,0:07:01.58,Default,,0,0,0,,Зак Күн сәулесі
Dialogue: 0,0:07:01.79,0:07:03.75,Default,,0,0,0,,(Қыздар қолдайды)
Dialogue: 0,0:07:07.13,0:07:08.59,Default,,0,0,0,,Әр адамның күні
Dialogue: 0,0:07:08.67,0:07:11.43,Default,,0,0,0,,Мәңгі жанады хаха~
Dialogue: 0,0:07:15.51,0:07:17.60,Default,,0,0,0,,Раушан гүлдері билеп жатқанда
Dialogue: 0,0:07:17.68,0:07:19.77,Default,,0,0,0,,Бүгін тағы бір жарқыраған көрініс
Dialogue: 0,0:07:20.14,0:07:21.69,Default,,0,0,0,,Оу!
Dialogue: 0,0:07:22.19,0:07:24.02,Default,,0,0,0,,Галактикадағы супер жұлдыз
Dialogue: 0,0:07:24.11,0:07:26.82,Default,,0,0,0,,Төрт бұрылыс император Зак Күн сәулесі
Dialogue: 0,0:07:27.11,0:07:28.15,Default,,0,0,0,,Менің шоуым
Dialogue: 0,0:07:28.40,0:07:29.61,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:07:30.07,0:07:31.40,Default,,0,0,0,,Haha~n
Dialogue: 0,0:07:35.45,0:07:37.24,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:40.71,0:07:43.25,Default,,0,0,0,,Соңында мен ешқашан жетістікке жете алмадым.
Dialogue: 0,0:07:43.33,0:07:44.58,Default,,0,0,0,,Бакусу ату
Dialogue: 0,0:07:44.67,0:07:45.46,Default,,0,0,0,,О
Dialogue: 0,0:07:45.79,0:07:47.80,Default,,0,0,0,,Жұлдыздың бір бөлігі болдың
Dialogue: 0,0:07:47.88,0:07:49.96,Default,,0,0,0,,Ақыры осы уақытқа дейін жеттік.
Dialogue: 0,0:07:50.72,0:07:52.55,Default,,0,0,0,,Мен бақыттымын, Киракира-кун
Dialogue: 0,0:07:52.97,0:07:54.89,Default,,0,0,0,,Менің көзім ісінген жоқ.
Dialogue: 0,0:07:55.30,0:07:56.85,Default,,0,0,0,,Мен де бақыттымын.
Dialogue: 0,0:07:56.93,0:07:58.35,Default,,0,0,0,,Закпен ұрыс
Dialogue: 0,0:07:58.68,0:08:00.39,Default,,0,0,0,,Бірақ бәрі осы.
Dialogue: 0,0:08:00.56,0:08:02.48,Default,,0,0,0,,Жұлдыздар жарқырап тұрғаны жақсы
Dialogue: 0,0:08:03.77,0:08:05.15,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:08:07.02,0:08:08.61,Default,,0,0,0,,Сіздің жарығыңыз
Dialogue: 0,0:08:08.69,0:08:10.69,Default,,0,0,0,,Мен оны жарығыммен өшіремін
Dialogue: 0,0:08:11.57,0:08:13.32,Default,,0,0,0,,Кеттік! Валькирия!
Dialogue: 0,0:08:13.40,0:08:14.57,Default,,0,0,0,,Толық қуат!
Dialogue: 0,0:08:15.03,0:08:16.66,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:08:17.07,0:08:20.54,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:20.62,0:08:23.00,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:23.12,0:08:23.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:26.00,0:08:28.29,Default,,0,0,0,,Реактивті ату! Валькирия!
Dialogue: 0,0:08:29.09,0:08:30.63,Default,,0,0,0,,Кел, билейміз!
Dialogue: 0,0:08:32.13,0:08:32.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:33.05,0:08:34.76,Default,,0,0,0,,Зевс шабуылдарынан жалтарады
Dialogue: 0,0:08:34.84,0:08:36.39,Default,,0,0,0,,Бір және екі қайтадан қашады
Dialogue: 0,0:08:36.47,0:08:37.93,Default,,0,0,0,,Би билеген сияқты
Dialogue: 0,0:08:38.01,0:08:41.02,Default,,0,0,0,,Реактивті оқтың шабуыл күші қаншалықты күшті болса да,
Dialogue: 0,0:08:41.10,0:08:43.94,Default,,0,0,0,,Болжамасаң не пайда?
Dialogue: 0,0:08:44.06,0:08:45.27,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:08:47.15,0:08:48.44,Default,,0,0,0,,Стадион
Dialogue: 0,0:08:48.56,0:08:51.03,Default,,0,0,0,,Зак Сенпайдың сахнасына ұқсайды
Dialogue: 0,0:08:51.40,0:08:52.86,Default,,0,0,0,,Жарқыраған жұлдыздар
Dialogue: 0,0:08:52.94,0:08:55.45,Default,,0,0,0,,Күннің алдында бір сәтте жоғалады
Dialogue: 0,0:08:55.53,0:08:57.28,Default,,0,0,0,,Шешіңіз! Зевс!
Dialogue: 0,0:09:00.33,0:09:01.83,Default,,0,0,0,,(ұшқан дыбыс)
Dialogue: 0,0:09:02.95,0:09:03.91,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:04.29,0:09:06.29,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:09:06.67,0:09:07.92,Default,,0,0,0,,Циллион Зевс
Dialogue: 0,0:09:08.00,0:09:10.09,Default,,0,0,0,,Артық бітіру үшін 1 ұпай
Dialogue: 0,0:09:10.42,0:09:12.30,Default,,0,0,0,,Циллион Зевс
Dialogue: 0,0:09:12.38,0:09:15.72,Default,,0,0,0,,Зактың өзі жынданып кеткендей болды.
Dialogue: 0,0:09:15.80,0:09:17.34,Default,,0,0,0,,Алдын алу
Dialogue: 0,0:09:18.34,0:09:20.64,Default,,0,0,0,,Бұл айналмалы ату
Dialogue: 0,0:09:21.10,0:09:22.72,Default,,0,0,0,,Бірінші шайқастан
Dialogue: 0,0:09:22.85,0:09:25.77,Default,,0,0,0,,Нағыз ғажайып кадр жарылады
Dialogue: 0,0:09:27.90,0:09:29.27,Default,,0,0,0,,(Еденге түскен сымның дыбысы)
Dialogue: 0,0:09:29.48,0:09:32.28,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:32.36,0:09:34.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:37.91,0:09:38.86,Default,,0,0,0,,Толық шегіну.
Dialogue: 0,0:09:39.28,0:09:40.95,Default,,0,0,0,,Зактың жігіті
Dialogue: 0,0:09:41.03,0:09:42.58,Default,,0,0,0,,Ширек финал сәтінен бастап
Dialogue: 0,0:09:42.66,0:09:44.37,Default,,0,0,0,,Менің қорқынышым артып келеді
Dialogue: 0,0:09:44.66,0:09:45.96,Default,,0,0,0,,Бірақ Барт
Dialogue: 0,0:09:46.08,0:09:48.67,Default,,0,0,0,,Сіз мені қазір жеңе алуыңыз керек.
Dialogue: 0,0:09:50.13,0:09:51.09,Default,,0,0,0,,Зак
Dialogue: 0,0:09:51.75,0:09:53.92,Default,,0,0,0,,Бұл әлі ашылу.
Dialogue: 0,0:09:54.42,0:09:56.01,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:09:56.42,0:09:57.38,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:09:57.55,0:09:59.47,Default,,0,0,0,,Зак сол қалпында шешім қабылдай ма?
Dialogue: 0,0:09:59.55,0:10:02.14,Default,,0,0,0,,Әлде Барто Аои қуып жете ме?
Dialogue: 0,0:10:02.39,0:10:03.72,Default,,0,0,0,,Келесі шайқас
Dialogue: 0,0:10:03.81,0:10:05.18,Default,,0,0,0,,Оны барлық жағдайда қабылдаңыз
Dialogue: 0,0:10:06.43,0:10:08.69,Default,,0,0,0,,Домалауды бұзыңыз
Dialogue: 0,0:10:10.19,0:10:10.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:11.36,0:10:13.27,Default,,0,0,0,,Бұл Шакамен шайқас кезіндегі Балто.
Dialogue: 0,0:10:15.28,0:10:17.40,Default,,0,0,0,,Кеттік! Досым!
Dialogue: 0,0:10:17.49,0:10:19.91,Default,,0,0,0,,Хаха~ Ақыры келді.
Dialogue: 0,0:10:19.99,0:10:21.20,Default,,0,0,0,,Олай болса, мен де.
Dialogue: 0,0:10:21.28,0:10:22.70,Default,,0,0,0,,Охироммен барамыз ба?
Dialogue: 0,0:10:25.33,0:10:26.95,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:10:27.87,0:10:28.87,Default,,0,0,0,,Үш
Dialogue: 0,0:10:29.25,0:10:30.17,Default,,0,0,0,,Екі
Dialogue: 0,0:10:30.88,0:10:31.88,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:10:32.59,0:10:35.42,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:35.50,0:10:36.63,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:10:37.01,0:10:38.97,Default,,0,0,0,,Бір қызығы, бұл жолы екі айналым.
Dialogue: 0,0:10:39.05,0:10:41.89,Default,,0,0,0,,Домалауға көбірек айналу қосу арқылы
Dialogue: 0,0:10:41.97,0:10:43.85,Default,,0,0,0,,Зевстің жылдамдығы артып келеді
Dialogue: 0,0:10:45.43,0:10:47.43,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:10:52.56,0:10:54.52,Default,,0,0,0,,Күнге жұлдыздар сәйкес келмейді
Dialogue: 0,0:10:55.44,0:10:57.61,Default,,0,0,0,,Екі жақ Қарқынды байланыс
Dialogue: 0,0:10:57.69,0:10:59.24,Default,,0,0,0,,Зевс ұзатты
Dialogue: 0,0:11:01.24,0:11:02.53,Default,,0,0,0,,Жүр!
Dialogue: 0,0:11:02.95,0:11:04.58,Default,,0,0,0,,Тағы бір қақтығыс?
Dialogue: 0,0:11:04.66,0:11:05.91,Default,,0,0,0,,(ұшқан дыбыс)
Dialogue: 0,0:11:05.99,0:11:07.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:07.45,0:11:08.45,Default,,0,0,0,,Не!
Dialogue: 0,0:11:09.12,0:11:11.00,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:11:11.33,0:11:13.17,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:11:13.25,0:11:15.09,Default,,0,0,0,,Артық бітіру үшін 1 ұпай
Dialogue: 0,0:11:15.25,0:11:16.30,Default,,0,0,0,,Бірден бірге
Dialogue: 0,0:11:16.63,0:11:18.30,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:11:18.51,0:11:19.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:20.47,0:11:21.88,Default,,0,0,0,,Ақырында сәттілік
Dialogue: 0,0:11:21.97,0:11:22.93,Default,,0,0,0,,О
Dialogue: 0,0:11:23.01,0:11:24.43,Default,,0,0,0,,Енді баруға болады.
Dialogue: 0,0:11:24.76,0:11:26.10,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:11:26.18,0:11:29.02,Default,,0,0,0,,Мен жарылғыш ату арқылы есепті теңестірдім.
Dialogue: 0,0:11:29.10,0:11:32.81,Default,,0,0,0,,Ку... жұлдыздар мен үшін осында...
Dialogue: 0,0:11:33.60,0:11:35.65,Default,,0,0,0,,Екеуі де бір дюймді бермей
Dialogue: 0,0:11:35.73,0:11:36.86,Default,,0,0,0,,Бірден
Dialogue: 0,0:11:36.94,0:11:38.65,Default,,0,0,0,,Үшінші шайқасқа кіру
Dialogue: 0,0:11:39.15,0:11:40.65,Default,,0,0,0,,Мен саған айттым.
Dialogue: 0,0:11:40.74,0:11:43.32,Default,,0,0,0,,Жұлдыздар тек осы уақытқа дейін жарқырай алады
Dialogue: 0,0:11:45.91,0:11:47.12,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:11:49.37,0:11:51.04,Default,,0,0,0,,Сіздің жарқырауыңыз
Dialogue: 0,0:11:51.12,0:11:52.46,Default,,0,0,0,,Мен оны өшіремін.
Dialogue: 0,0:11:53.50,0:11:55.08,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:11:55.17,0:11:56.92,Default,,0,0,0,,Финалға кім шығады?
Dialogue: 0,0:11:57.00,0:11:58.96,Default,,0,0,0,,Зак немесе Барто Аои?
Dialogue: 0,0:11:59.59,0:12:02.05,Default,,0,0,0,,Жарылғыш атумен жүр! Балтық!
Dialogue: 0,0:12:02.13,0:12:03.72,Default,,0,0,0,,Менің денем қазір есімде.
Dialogue: 0,0:12:03.80,0:12:05.55,Default,,0,0,0,,Сіз мұны істей алуыңыз керек.
Dialogue: 0,0:12:05.64,0:12:06.47,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:08.97,0:12:10.89,Default,,0,0,0,,Кел, Аои Барто
Dialogue: 0,0:12:10.98,0:12:13.35,Default,,0,0,0,,Баяу қозғала бастады.
Dialogue: 0,0:12:16.77,0:12:17.98,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:12:18.07,0:12:20.44,Default,,0,0,0,,Тағы бір жарылғышпен атайық!
Dialogue: 0,0:12:20.82,0:12:22.36,Default,,0,0,0,,Бұл өкінішті
Dialogue: 0,0:12:22.70,0:12:25.20,Default,,0,0,0,,Адамдар біз бірдей қимылдарды пайдалана аламыз деп ойлайды.
Dialogue: 0,0:12:25.70,0:12:27.87,Default,,0,0,0,,Мен супержұлдызмын
Dialogue: 0,0:12:28.08,0:12:29.66,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:12:30.70,0:12:31.58,Default,,0,0,0,,Үш
Dialogue: 0,0:12:32.46,0:12:33.46,Default,,0,0,0,,Екі
Dialogue: 0,0:12:34.25,0:12:35.25,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:12:35.33,0:12:38.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:38.54,0:12:39.25,Default,,0,0,0,,С-сәлем… Қалайсың? Өткенде бәрі үшін рахмет…
Dialogue: 0,0:12:39.42,0:12:42.01,Default,,0,0,0,,Не... Қазір түсіру тәсілі қандай?
Dialogue: 0,0:12:43.67,0:12:45.93,Default,,0,0,0,,Күн сәулесін айналдыру
Dialogue: 0,0:12:46.14,0:12:47.51,Default,,0,0,0,,Циллион Зевс
Dialogue: 0,0:12:47.60,0:12:49.93,Default,,0,0,0,,Үлкен күшпен бұрылыңыз
Dialogue: 0,0:12:50.01,0:12:50.81,Default,,0,0,0,,…Аа!
Dialogue: 0,0:12:50.89,0:12:53.27,Default,,0,0,0,,Валькири еңкейіп қалады.
Dialogue: 0,0:12:53.43,0:12:55.31,Default,,0,0,0,,Сәтсіз ату өте өкінішті
Dialogue: 0,0:12:56.10,0:12:57.15,Default,,0,0,0,,Зевс!
Dialogue: 0,0:12:57.69,0:12:59.15,Default,,0,0,0,,(ұшқан дыбыс)
Dialogue: 0,0:13:00.77,0:13:01.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:01.98,0:13:03.28,Default,,0,0,0,,Циллион Зевс
Dialogue: 0,0:13:03.36,0:13:05.40,Default,,0,0,0,,Артық бітіру үшін 1 ұпай
Dialogue: 0,0:13:05.49,0:13:06.66,Default,,0,0,0,,2-1
Dialogue: 0,0:13:06.74,0:13:09.99,Default,,0,0,0,,Зак, бұл жолы 3 айналым
Dialogue: 0,0:13:11.16,0:13:13.04,Default,,0,0,0,,Мен барамын деп ойладым.
Dialogue: 0,0:13:13.37,0:13:15.87,Default,,0,0,0,,Неліктен маңызды сәтте сәтсіз соққы жасадыңыз?
Dialogue: 0,0:13:16.17,0:13:19.54,Default,,0,0,0,,Күн сәулесін айналдыру
Dialogue: 0,0:13:19.88,0:13:22.00,Default,,0,0,0,,Би арқылы жаттығатын негізгі күш
Dialogue: 0,0:13:22.09,0:13:23.26,Default,,0,0,0,,Тепе-теңдік сезімі
Dialogue: 0,0:13:23.34,0:13:24.17,Default,,0,0,0,,Яғни
Dialogue: 0,0:13:24.26,0:13:26.88,Default,,0,0,0,,Тек Зак Сенпай жасай алатын әдістер
Dialogue: 0,0:13:27.59,0:13:28.80,Default,,0,0,0,,Haha~n
Dialogue: 0,0:13:29.89,0:13:31.39,Default,,0,0,0,,Күшті шайқас
Dialogue: 0,0:13:31.72,0:13:32.85,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:13:32.93,0:13:34.10,Default,,0,0,0,,Мен шешемін
Dialogue: 0,0:13:34.18,0:13:35.39,Default,,0,0,0,,Бакусу атылды!
Dialogue: 0,0:13:35.94,0:13:37.27,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:13:37.39,0:13:39.61,Default,,0,0,0,,Қайтадан кері қадам жасау
Dialogue: 0,0:13:40.15,0:13:41.77,Default,,0,0,0,,Тағы барасыз ба?
Dialogue: 0,0:13:41.86,0:13:43.48,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ.
Dialogue: 0,0:13:43.57,0:13:44.69,Default,,0,0,0,,Барт
Dialogue: 0,0:13:45.15,0:13:46.86,Default,,0,0,0,,Маған ешкім тең келе алмайды
Dialogue: 0,0:13:47.66,0:13:50.32,Default,,0,0,0,,Өйткені менің жарқырауым – әлемдегі ең жақсы
Dialogue: 0,0:13:50.82,0:13:52.41,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:13:53.41,0:13:54.41,Default,,0,0,0,,Үш
Dialogue: 0,0:13:54.79,0:13:55.62,Default,,0,0,0,,Екі
Dialogue: 0,0:13:56.16,0:13:57.04,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:13:57.96,0:14:00.96,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:02.04,0:14:02.96,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:14:04.92,0:14:06.92,Default,,0,0,0,,Жүр!
Dialogue: 0,0:14:10.68,0:14:11.80,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:14:11.89,0:14:12.97,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:14:13.06,0:14:13.81,Default,,0,0,0,,Китаде~
Dialogue: 0,0:14:13.89,0:14:15.10,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:14:18.23,0:14:19.65,Default,,0,0,0,,Валькирия
Dialogue: 0,0:14:19.73,0:14:21.40,Default,,0,0,0,,Қатты шабуыл
Dialogue: 0,0:14:21.90,0:14:23.36,Default,,0,0,0,,Жақсы, Валькири.
Dialogue: 0,0:14:23.69,0:14:26.53,Default,,0,0,0,,Күн дүниенің ортасында жарқырайды
Dialogue: 0,0:14:28.32,0:14:29.74,Default,,0,0,0,,Циллион Зевс
Dialogue: 0,0:14:29.82,0:14:31.49,Default,,0,0,0,,ортасында тұрып қалды
Dialogue: 0,0:14:32.74,0:14:34.03,Default,,0,0,0,,Бар, жүр!
Dialogue: 0,0:14:34.37,0:14:35.70,Default,,0,0,0,,Hyahoo!
Dialogue: 0,0:14:35.95,0:14:37.29,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:14:37.37,0:14:38.62,Default,,0,0,0,,Бұл қатыгез шабуыл.
Dialogue: 0,0:14:40.21,0:14:41.67,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:14:41.75,0:14:43.29,Default,,0,0,0,,Міне солай.
Dialogue: 0,0:14:43.50,0:14:45.63,Default,,0,0,0,,Зевс ешқашан босаңсымайды
Dialogue: 0,0:14:46.26,0:14:48.76,Default,,0,0,0,,Ортада тұра берсең ғана жұлдыз боласың
Dialogue: 0,0:14:49.05,0:14:51.34,Default,,0,0,0,,Циллион Зевстің айналуы құламайды
Dialogue: 0,0:14:51.43,0:14:53.55,Default,,0,0,0,,Металл шарлардың шынайы қуатын көрсету
Dialogue: 0,0:14:53.64,0:14:55.64,Default,,0,0,0,,Циллион Зевс финалы!
Dialogue: 0,0:15:04.02,0:15:05.86,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:15:13.95,0:15:16.08,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:15:16.20,0:15:17.87,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:15:29.13,0:15:31.26,Default,,0,0,0,,Жақсы тамаша
Dialogue: 0,0:15:32.84,0:15:35.10,Default,,0,0,0,,Бұл өте қызықты.
Dialogue: 0,0:15:35.18,0:15:37.22,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:15:38.77,0:15:40.64,Default,,0,0,0,,Бұл супер жұлдыз
Dialogue: 0,0:15:40.94,0:15:42.77,Default,,0,0,0,,Бұл Циллион Зевс!
Dialogue: 0,0:15:43.69,0:15:44.90,Default,,0,0,0,,Ой
Dialogue: 0,0:15:45.02,0:15:48.15,Default,,0,0,0,,Валькирия, сенің жылдамдығың кенет төмендеді.
Dialogue: 0,0:15:48.23,0:15:51.32,Default,,0,0,0,,Қозғалыс қарқынын жоғалтты.
Dialogue: 0,0:15:51.40,0:15:54.41,Default,,0,0,0,,Сен осылай қозғалуды доғарайын ба?
Dialogue: 0,0:15:54.82,0:15:56.12,Default,,0,0,0,,Шыдамсыз ба?
Dialogue: 0,0:15:56.20,0:15:58.20,Default,,0,0,0,,Осы уақытқа дейін итерейік
Dialogue: 0,0:15:58.29,0:15:59.16,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:59.24,0:16:00.91,Default,,0,0,0,,Зак Сенпай жеңеді
Dialogue: 0,0:16:01.00,0:16:01.91,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:16:02.00,0:16:04.25,Default,,0,0,0,,Валькири тоқтамайды
Dialogue: 0,0:16:04.71,0:16:06.92,Default,,0,0,0,,Қандай ақымақ.
Dialogue: 0,0:16:07.00,0:16:09.42,Default,,0,0,0,,Жоқ, тоқтамаңыз.
Dialogue: 0,0:16:09.76,0:16:12.76,Default,,0,0,0,,Хаха~ Көңілді шайқас үшін рахмет.
Dialogue: 0,0:16:12.84,0:16:14.13,Default,,0,0,0,,Киракира-кун
Dialogue: 0,0:16:14.59,0:16:16.64,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:16:17.05,0:16:18.68,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:16:19.52,0:16:22.60,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:16:24.52,0:16:26.27,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:16:27.52,0:16:28.98,Default,,0,0,0,,Қауіпсіз жүргізіңіз.
Dialogue: 0,0:16:29.57,0:16:31.49,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:16:32.11,0:16:33.45,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:16:33.53,0:16:34.70,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:16:34.82,0:16:37.62,Default,,0,0,0,,Барто Аои 3-2 есебімен жеңді
Dialogue: 0,0:16:38.83,0:16:41.66,Default,,0,0,0,,Сіз жеңдіңіз бе?
Dialogue: 0,0:16:45.87,0:16:48.09,Default,,0,0,0,,Иә! Мен жеңдім!
Dialogue: 0,0:16:49.63,0:16:52.80,Default,,0,0,0,,Қандай керемет жеңіс
Dialogue: 0,0:16:52.88,0:16:55.09,Default,,0,0,0,,Керемет Барто Аои
Dialogue: 0,0:16:55.18,0:16:56.59,Default,,0,0,0,,Төрт ондық императорды қайтадан жеңу
Dialogue: 0,0:16:56.68,0:16:59.10,Default,,0,0,0,,Ақыры финалға шықтық!
Dialogue: 0,0:16:59.43,0:17:00.97,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:17:01.22,0:17:03.06,Default,,0,0,0,,Жарайсыңдар! Жақсы!
Dialogue: 0,0:17:03.43,0:17:05.98,Default,,0,0,0,,Мен сенің қорқып кеткеніңді қаламаймын.
Dialogue: 0,0:17:06.31,0:17:08.52,Default,,0,0,0,,Мен бітті деп ойладым.
Dialogue: 0,0:17:08.90,0:17:11.98,Default,,0,0,0,,Шынымды айтсам, солай деп ойладым.
Dialogue: 0,0:17:12.65,0:17:14.15,Default,,0,0,0,,Бірақ Барт...
Dialogue: 0,0:17:14.24,0:17:15.99,Default,,0,0,0,,Бас тарту жаман
Dialogue: 0,0:17:16.07,0:17:17.82,Default,,0,0,0,,Балто да, Валькири де
Dialogue: 0,0:17:18.11,0:17:21.16,Default,,0,0,0,,Ей, біз жақсы шайқастық.
Dialogue: 0,0:17:21.66,0:17:23.95,Default,,0,0,0,,Жеңімпаз - Барто Аои
Dialogue: 0,0:17:24.04,0:17:26.37,Default,,0,0,0,,Шитенко Закку осында үзіледі
Dialogue: 0,0:17:27.37,0:17:28.54,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:17:28.83,0:17:30.00,Default,,0,0,0,,Зевс...
Dialogue: 0,0:17:30.63,0:17:33.42,Default,,0,0,0,,Қалай қарасаң да, Сенпай жеңді.
Dialogue: 0,0:17:33.51,0:17:36.59,Default,,0,0,0,,Аз ғана айырмашылық нәтижені анықтады.
Dialogue: 0,0:17:36.93,0:17:38.14,Default,,0,0,0,,Екі дыбыс
Dialogue: 0,0:17:38.30,0:17:40.43,Default,,0,0,0,,Дәл осындай сәуле шығарылды
Dialogue: 0,0:17:40.76,0:17:41.97,Default,,0,0,0,,Сенпай...
Dialogue: 0,0:17:43.06,0:17:46.19,Default,,0,0,0,,Жарқыраған ыстық жан жарылады
Dialogue: 0,0:17:47.02,0:17:50.02,Default,,0,0,0,,Күн енді батып бара жатыр
Dialogue: 0,0:17:50.48,0:17:52.52,Default,,0,0,0,,Айналамдағы жұлдыздар
Dialogue: 0,0:17:53.36,0:17:56.20,Default,,0,0,0,,Әй, бұл күнді ұмытпа
Dialogue: 0,0:17:57.40,0:17:59.70,Default,,0,0,0,,Мен қулықтан кетемін.
Dialogue: 0,0:18:00.03,0:18:00.87,Default,,0,0,0,,Эх!
Dialogue: 0,0:18:01.08,0:18:02.49,Default,,0,0,0,,
Dialogue: 0,0:18:05.75,0:18:07.46,Default,,0,0,0,,Циао Зевс
Dialogue: 0,0:18:07.71,0:18:09.08,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:18:10.54,0:18:14.71,Default,,0,0,0,,Жоқ! Тоқтамаңыз!
Dialogue: 0,0:18:15.09,0:18:18.09,Default,,0,0,0,,Жоқ... Бұл жай түс пе, әлде елес пе?
Dialogue: 0,0:18:18.18,0:18:19.22,Default,,0,0,0,,Зак қалай
Dialogue: 0,0:18:19.30,0:18:21.72,Default,,0,0,0,,Бұл күтпеген зейнеткерлікке шығу туралы хабарландыру.
Dialogue: 0,0:18:21.80,0:18:25.31,Default,,0,0,0,,
Dialogue: 0,0:18:25.64,0:18:27.52,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,0:18:27.60,0:18:31.11,Default,,0,0,0,,Зактың қайта оралуы
Dialogue: 0,0:18:32.94,0:18:34.15,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:18:34.73,0:18:37.86,Default,,0,0,0,,Мені және Циллион Зевсті жақсы көргеніңіз үшін рахмет.
Dialogue: 0,0:18:38.15,0:18:40.45,Default,,0,0,0,,Мен бәріңді ешқашан ұмытпаймын
Dialogue: 0,0:18:40.99,0:18:42.91,Default,,0,0,0,,Жүрегімде мәңгілік
Dialogue: 0,0:18:43.33,0:18:45.33,Default,,0,0,0,,Алған әсеріңізге рахмет.
Dialogue: 0,0:18:45.41,0:18:46.66,Default,,0,0,0,,Зак Күн сәулесі
Dialogue: 0,0:18:47.70,0:18:49.87,Default,,0,0,0,,Кәне, екінші жартылай финалдық ойын
Dialogue: 0,0:18:49.96,0:18:52.58,Default,,0,0,0,,Бұл турнирдің ең қызықты шайқасы.
Dialogue: 0,0:18:52.96,0:18:54.13,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:18:54.21,0:18:57.21,Default,,0,0,0,,Соңғы турнирдің финалындағы қанды шайқас
Dialogue: 0,0:18:57.30,0:18:59.59,Default,,0,0,0,,Бір қызығы, финалды күтпестен
Dialogue: 0,0:18:59.68,0:19:02.51,Default,,0,0,0,,Екеуі жақында соқтығысады!
Dialogue: 0,0:19:05.39,0:19:07.10,Default,,0,0,0,,Спригган
Dialogue: 0,0:19:08.39,0:19:09.43,Default,,0,0,0,,Егер Мавару жеңілсе —
Dialogue: 0,0:19:09.52,0:19:10.98,Default,,0,0,0,,Оны жеңу
Dialogue: 0,0:19:11.60,0:19:12.69,Default,,0,0,0,,Құдай-ай!
Dialogue: 0,0:19:12.81,0:19:15.77,Default,,0,0,0,,(әйнек сынған дыбыс)
Dialogue: 0,0:19:17.23,0:19:19.78,Default,,0,0,0,,Енді міне, қуық келді.
Dialogue: 0,0:19:20.03,0:19:21.95,Default,,0,0,0,,Соңғы турнир жеңімпазы
Dialogue: 0,0:19:22.03,0:19:24.41,Default,,0,0,0,,4 рет қатарынан жеңіске жеткен абсолютті чемпион
Dialogue: 0,0:19:24.49,0:19:25.91,Default,,0,0,0,,Осы уақытқа дейінгі барлық шайқастар
Dialogue: 0,0:19:26.03,0:19:28.41,Default,,0,0,0,,Бірде-бір ұпай жоғалтпай өттік.
Dialogue: 0,0:19:28.66,0:19:30.33,Default,,0,0,0,,Perfect Blader
Dialogue: 0,0:19:30.41,0:19:32.96,Default,,0,0,0,,Ширасаги сарайы Луис!
Dialogue: 0,0:19:34.21,0:19:35.29,Default,,0,0,0,,Мақсат
Dialogue: 0,0:19:35.38,0:19:38.30,Default,,0,0,0,,Турнирде бұрын-соңды болмаған қатарынан бесінші жеңіс.
Dialogue: 0,0:19:38.71,0:19:41.47,Default,,0,0,0,,Ал алдыңғы сайыстың жүлдегері
Dialogue: 0,0:19:41.55,0:19:43.89,Default,,0,0,0,,Қорлықтан өртенген кемеңгер жүзі
Dialogue: 0,0:19:43.97,0:19:46.39,Default,,0,0,0,,Одан әрі эволюциямен оралды
Dialogue: 0,0:19:47.06,0:19:48.85,Default,,0,0,0,,Бенишу!
Dialogue: 0,0:19:49.43,0:19:50.56,Default,,0,0,0,,Шу
Dialogue: 0,0:19:51.06,0:19:53.94,Default,,0,0,0,,Сол қолмен ату деп аталатын жаңа атуды меңгеру
Dialogue: 0,0:19:54.06,0:19:56.86,Default,,0,0,0,,Мақсаты абсолютті чемпионды құлату.
Dialogue: 0,0:19:57.57,0:19:59.74,Default,,0,0,0,,Шуу-кун, қолыңнан келгенін істе
Dialogue: 0,0:20:00.28,0:20:03.41,Default,,0,0,0,,Бұл іс жүзінде финалдық матч болады.
Dialogue: 0,0:20:04.16,0:20:05.66,Default,,0,0,0,,Жеңіс, Шу
Dialogue: 0,0:20:09.33,0:20:10.91,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:20:11.08,0:20:13.50,Default,,0,0,0,,Мен сені жеңемін.
Dialogue: 0,0:20:13.92,0:20:16.04,Default,,0,0,0,,Хмф, бұл мүмкін емес.
Dialogue: 0,0:20:16.96,0:20:18.17,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:20:20.01,0:20:21.42,Default,,0,0,0,,Сол қолмен ату?
Dialogue: 0,0:20:21.84,0:20:24.26,Default,,0,0,0,,Мен бақылауға баса назар аударатын атумен барамын.
Dialogue: 0,0:20:24.34,0:20:25.93,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:20:26.47,0:20:28.93,Default,,0,0,0,,Барлығы осы шайқас үшін
Dialogue: 0,0:20:29.18,0:20:30.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:30.39,0:20:33.10,Default,,0,0,0,,Не... Бұл қандай ұстаным?
Dialogue: 0,0:20:33.39,0:20:36.19,Default,,0,0,0,,Іске қосу құрылғысы бұл пішінде тұрақты емес.
Dialogue: 0,0:20:36.36,0:20:37.15,Default,,0,0,0,,Шу
Dialogue: 0,0:20:40.03,0:20:41.40,Default,,0,0,0,,Не істесеңіз де
Dialogue: 0,0:20:41.49,0:20:43.11,Default,,0,0,0,,Сен мені жеңе алмайсың
Dialogue: 0,0:20:43.40,0:20:44.82,Default,,0,0,0,,Сізді жеңіңіз
Dialogue: 0,0:20:44.91,0:20:47.07,Default,,0,0,0,,Сондықтан мен мұндамын
Dialogue: 0,0:20:47.57,0:20:49.08,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:20:49.58,0:20:52.83,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:20:52.91,0:20:55.25,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:58.38,0:21:00.17,Default,,0,0,0,,Оңтүстік крест
Dialogue: 0,0:21:00.50,0:21:02.01,Default,,0,0,0,,Спригган дауылы
Dialogue: 0,0:21:02.09,0:21:04.88,Default,,0,0,0,,Стадион арқылы үлкен қарқынмен жүгіру
Dialogue: 0,0:21:04.97,0:21:06.76,Default,,0,0,0,,Үзіліс! Спригган!
Dialogue: 0,0:21:08.51,0:21:11.27,Default,,0,0,0,,Екеуі қатты соқтығысты.
Dialogue: 0,0:21:13.14,0:21:14.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:14.52,0:21:15.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:16.98,0:21:18.40,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:21:20.32,0:21:21.61,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:21:22.07,0:21:23.61,Default,,0,0,0,,Спригган дауылы
Dialogue: 0,0:21:23.74,0:21:25.70,Default,,0,0,0,,2 ұпай
Dialogue: 0,0:21:25.86,0:21:26.86,Default,,0,0,0,,2-ден 0-ге дейін
Dialogue: 0,0:21:26.95,0:21:28.91,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:29.07,0:21:30.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:30.74,0:21:32.49,Default,,0,0,0,,Біз мұны жасадық! Шу
Dialogue: 0,0:21:33.04,0:21:35.29,Default,,0,0,0,,Досым, сенің екпініңді естісем, ағылшын сияқтысың.
Dialogue: 0,0:21:35.58,0:21:36.62,Default,,0,0,0,,Теңізді ластайтын ешқандай ірі қалалар жоқ—
Dialogue: 0,0:21:37.79,0:21:38.75,Default,,0,0,0,,Жарылыс
Dialogue: 0,0:21:39.38,0:21:42.13,Default,,0,0,0,,Лостронгин жарылып кетті!
Dialogue: 0,0:21:43.34,0:21:46.13,Default,,0,0,0,,Әрине, сіз бұрынғыдан да күштірек сияқтысыз.
Dialogue: 0,0:21:48.14,0:21:48.89,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:21:49.22,0:21:50.05,Default,,0,0,0,,Мен саған осылай үнсіз өлуді айта алмаймын!!
Dialogue: 0,0:22:09.74,0:22:15.83,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:16.04,0:22:22.17,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.63,0:22:28.18,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.63,0:22:31.97,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:32.14,0:22:37.06,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.98,0:22:41.69,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.77,0:22:44.98,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:45.07,0:22:51.41,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.66,0:22:57.20,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:57.37,0:23:03.96,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.54,0:23:09.97,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:10.13,0:23:13.30,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.80,0:23:17.77,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:27.23,0:23:29.36,Default,,0,0,0,,Шудың оңтүстік крест атуы
Dialogue: 0,0:23:29.49,0:23:31.74,Default,,0,0,0,,Луи жаңа әдіспен есептейді.
Dialogue: 0,0:23:31.86,0:23:33.32,Default,,0,0,0,,Шу өртеніп жатыр
Dialogue: 0,0:23:33.41,0:23:34.99,Default,,0,0,0,,Луи де жанып жатыр
Dialogue: 0,0:23:35.08,0:23:37.99,Default,,0,0,0,,Бұл екеуінің жауынгерлік рухы тым құмар
Dialogue: 0,0:23:38.08,0:23:40.29,Default,,0,0,0,,Шу жеңді~
Dialogue: 0,0:23:40.96,0:23:43.17,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.25,0:23:46.13,Default,,0,0,0,,Төрт айналдыратын император! Луиге қарсы Шу!
Dialogue: 0,0:23:46.21,0:23:48.34,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.42,0:23:50.05,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.55,0:23:57.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory