Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.05,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.13,0:00:12.67,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.72,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.80,0:00:16.85,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.93,0:00:18.68,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.82,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:36.36,0:00:38.16,Default,,0,0,0,,Хорсудқа барыңыз
Dialogue: 0,0:00:38.37,0:00:40.24,Default,,0,0,0,,Уайверн шешім қабылдады
Dialogue: 0,0:00:45.12,0:00:46.92,Default,,0,0,0,,Осылайша, менің «Қызыл Патшам» әлемнің шыңына көтеріледі…
Dialogue: 0,0:00:47.00,0:00:50.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:50.30,0:00:52.59,Default,,0,0,0,,Вайдың толық жеңілуі және Хоудзи
Dialogue: 0,0:00:52.67,0:00:53.92,Default,,0,0,0,,Ботчан
Dialogue: 0,0:00:54.26,0:00:55.72,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:57.14,0:00:58.51,Default,,0,0,0,,Ха...
Dialogue: 0,0:00:58.64,0:00:59.89,Default,,0,0,0,,Бұл түс пе?
Dialogue: 0,0:01:06.39,0:01:07.81,Default,,0,0,0,,Тағы да...
Dialogue: 0,0:01:15.74,0:01:18.11,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:18.45,0:01:23.62,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:34.92,0:01:38.30,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:38.80,0:01:40.93,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:41.35,0:01:45.48,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:45.60,0:01:48.81,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:48.94,0:01:55.36,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:55.65,0:02:00.07,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:00.57,0:02:06.00,Default,,0,0,0,,Ыстық және діріл ойнайық
Dialogue: 0,0:02:06.12,0:02:08.37,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:08.46,0:02:13.17,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:13.34,0:02:18.42,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:18.72,0:02:20.97,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:21.18,0:02:23.51,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:23.81,0:02:27.73,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:27.89,0:02:32.90,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:33.11,0:02:35.28,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:39.36,0:02:41.20,Default,,0,0,0,,Байыпты және толық қуат!
Dialogue: 0,0:02:46.20,0:02:49.50,Default,,0,0,0,,Үлкен аға, сен бүгін сарайға бармайсың ба?
Dialogue: 0,0:02:49.58,0:02:50.42,Default,,0,0,0,,Мен бармаймын
Dialogue: 0,0:02:50.83,0:02:52.83,Default,,0,0,0,,Бүгін не болды?
Dialogue: 0,0:02:52.92,0:02:54.79,Default,,0,0,0,,Келесіде Бочанмен бірге жеңетініңізге бәс тігемін
Dialogue: 0,0:02:54.88,0:02:55.96,Default,,0,0,0,,Иә
Dialogue: 0,0:02:56.05,0:02:58.38,Default,,0,0,0,,Ал, иықтарыңызды босаңсытыңыз.
Dialogue: 0,0:02:58.51,0:03:00.84,Default,,0,0,0,,Әдеттегідей көңіл көтеріңіз.
Dialogue: 0,0:03:01.59,0:03:02.55,Default,,0,0,0,,Иә
Dialogue: 0,0:03:03.30,0:03:04.89,Default,,0,0,0,,Баланың жағдайы қалай?
Dialogue: 0,0:03:05.26,0:03:08.60,Default,,0,0,0,,Әкем сені көп көрмейді.
Dialogue: 0,0:03:09.02,0:03:09.93,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:10.31,0:03:11.98,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:03:12.06,0:03:14.15,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:03:17.44,0:03:19.11,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:19.19,0:03:20.95,Default,,0,0,0,,Иә? Ботчан
Dialogue: 0,0:03:21.11,0:03:22.61,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:22.82,0:03:24.49,Default,,0,0,0,,Хоудзи не істеп жатыр?
Dialogue: 0,0:03:24.57,0:03:27.95,Default,,0,0,0,,Біз бүгін келесі ойынға тағы да жаттығамыз.
Dialogue: 0,0:03:28.29,0:03:29.33,Default,,0,0,0,,Сейана
Dialogue: 0,0:03:29.41,0:03:32.42,Default,,0,0,0,,Жаттығу және жаттығу және қайта-қайта жаттығу.
Dialogue: 0,0:03:32.50,0:03:35.34,Default,,0,0,0,,Сіз мені жеңе алмайсыз, иә иә
Dialogue: 0,0:03:37.46,0:03:39.46,Default,,0,0,0,,Біз қарсыласпыз, солай емес пе?
Dialogue: 0,0:03:40.30,0:03:42.43,Default,,0,0,0,,А, мұны пайдаланғыңыз келе ме?
Dialogue: 0,0:03:42.51,0:03:44.14,Default,,0,0,0,,Жақсы
Dialogue: 0,0:03:44.47,0:03:47.35,Default,,0,0,0,,Сіз Bay Club-та жаттығу жасамайсыз ба?
Dialogue: 0,0:03:47.72,0:03:48.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:48.97,0:03:51.48,Default,,0,0,0,,Кейбір нәрселерді орындау қиын.
Dialogue: 0,0:03:51.68,0:03:53.06,Default,,0,0,0,,Орындау қиын ба?
Dialogue: 0,0:03:53.14,0:03:55.36,Default,,0,0,0,,Мен Балтоға келесі соққымды тигіздім.
Dialogue: 0,0:03:55.44,0:03:57.86,Default,,0,0,0,,Ол күшейе түсуде.
Dialogue: 0,0:03:58.52,0:04:00.19,Default,,0,0,0,,Менің жеңілгім келмейді.
Dialogue: 0,0:04:00.61,0:04:03.95,Default,,0,0,0,,Қазіргі Валькирияның бұрынғыдан өзгеше екені рас.
Dialogue: 0,0:04:04.49,0:04:06.74,Default,,0,0,0,,Кесу жиегі өткірленді.
Dialogue: 0,0:04:06.82,0:04:09.70,Default,,0,0,0,,Дұрыс, дұрыс, дұрыс! Сол себепті
Dialogue: 0,0:04:09.79,0:04:11.91,Default,,0,0,0,,Оны өз жолыммен қалай түсіруім керек?
Dialogue: 0,0:04:12.00,0:04:14.17,Default,,0,0,0,,Бұл керемет ерекше қозғалыс бола ма?
Dialogue: 0,0:04:14.25,0:04:16.00,Default,,0,0,0,,Мен үлкен зерттеу жүргізіп жатырмын.
Dialogue: 0,0:04:16.71,0:04:18.34,Default,,0,0,0,,Мен сіздің рухыңызды түсінемін, бірақ
Dialogue: 0,0:04:18.42,0:04:20.30,Default,,0,0,0,,Бұлай көріну мүмкін емес.
Dialogue: 0,0:04:22.05,0:04:23.26,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:23.55,0:04:25.76,Default,,0,0,0,,Мен оны өте жақсы байқадым.
Dialogue: 0,0:04:25.84,0:04:29.31,Default,,0,0,0,,Иә? Неге кеңседе жаттығу жасамайсың?
Dialogue: 0,0:04:30.39,0:04:32.77,Default,,0,0,0,,Мен де сен сияқтымын
Dialogue: 0,0:04:33.14,0:04:33.85,Default,,0,0,0,,​​О?
Dialogue: 0,0:04:34.85,0:04:37.40,Default,,0,0,0,,Қараңдар, мен де келесі матчтамын.
Dialogue: 0,0:04:37.86,0:04:40.78,Default,,0,0,0,,Иә, негрлер
Dialogue: 0,0:04:43.11,0:04:44.36,Default,,0,0,0,,(Арқанның дыбысы)
Dialogue: 0,0:04:44.53,0:04:45.91,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:04:46.07,0:04:47.41,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:04:47.62,0:04:50.24,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:04:51.33,0:04:52.79,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:04:52.87,0:04:54.21,Default,,0,0,0,,Бұл аянышты
Dialogue: 0,0:04:55.16,0:04:57.04,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:04:57.13,0:05:00.21,Default,,0,0,0,,Біз Хоуджи мырзадан өзгешеміз.
Dialogue: 0,0:05:00.30,0:05:03.26,Default,,0,0,0,,Шынымды айтсам, Хоудзи менің артымнан еруі мүмкін еді.
Dialogue: 0,0:05:05.51,0:05:07.09,Default,,0,0,0,,Тұрып тұру ойыны
Dialogue: 0,0:05:07.43,0:05:10.26,Default,,0,0,0,,Маған тағы біраз демалу керек.
Dialogue: 0,0:05:11.10,0:05:12.97,Default,,0,0,0,,Өйткені Хоудзи мырза менің қарсыласым.
Dialogue: 0,0:05:13.06,0:05:15.48,Default,,0,0,0,,Сіз онша көп жаттығу жасамайсыз, солай ма?
Dialogue: 0,0:05:15.56,0:05:18.98,Default,,0,0,0,,Дұрыс, мен мұнда көп жеңіске жеттім.
Dialogue: 0,0:05:19.48,0:05:20.65,Default,,0,0,0,,Балалар
Dialogue: 0,0:05:20.73,0:05:22.90,Default,,0,0,0,,Хоудзи мен Хорсуд туралы
Dialogue: 0,0:05:22.98,0:05:24.49,Default,,0,0,0,,Мен оны мүлдем түсінбеймін.
Dialogue: 0,0:05:25.07,0:05:26.57,Default,,0,0,0,,Қорғаныс Уайверн және
Dialogue: 0,0:05:26.65,0:05:28.32,Default,,0,0,0,,Төзімділік Хорсудосы
Dialogue: 0,0:05:28.41,0:05:29.66,Default,,0,0,0,,Үйлесімділік бойынша
Dialogue: 0,0:05:29.74,0:05:31.49,Default,,0,0,0,,Хорсуд тиімдірек
Dialogue: 0,0:05:31.91,0:05:33.95,Default,,0,0,0,,Виверннің қалқан тактикасы да
Dialogue: 0,0:05:35.04,0:05:36.83,Default,,0,0,0,,Оның жеуі
Dialogue: 0,0:05:37.37,0:05:38.71,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:05:38.79,0:05:41.59,Default,,0,0,0,,Хорсуд Виверн шабуылына қалай төтеп берді
Dialogue: 0,0:05:41.67,0:05:42.92,Default,,0,0,0,,Көп рет
Dialogue: 0,0:05:43.46,0:05:45.47,Default,,0,0,0,,Ол өзіне байсалды.
Dialogue: 0,0:05:45.55,0:05:47.13,Default,,0,0,0,,Мен оны сізге көрсеткім келеді
Dialogue: 0,0:05:47.22,0:05:49.09,Default,,0,0,0,,Егер ол шынымен келсе
Dialogue: 0,0:05:49.26,0:05:51.47,Default,,0,0,0,,Мен де шындап жауап беруім керек.
Dialogue: 0,0:05:51.55,0:05:52.51,Default,,0,0,0,,Иә
Dialogue: 0,0:05:53.56,0:05:55.64,Default,,0,0,0,,Жарайды, Вакия мырза.
Dialogue: 0,0:05:55.73,0:05:57.19,Default,,0,0,0,,Ботчан мен Ходжи-санның ойлары
Dialogue: 0,0:05:57.27,0:05:58.85,Default,,0,0,0,,Бізге де хабарланды.
Dialogue: 0,0:05:59.23,0:06:01.73,Default,,0,0,0,,Осыған байсалды түрде кірісейік.
Dialogue: 0,0:06:02.40,0:06:04.15,Default,,0,0,0,,Сасакиден бастайық!
Dialogue: 0,0:06:04.23,0:06:05.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:06.61,0:06:09.16,Default,,0,0,0,,Бала мұны маған бұрын да айтқан.
Dialogue: 0,0:06:09.57,0:06:12.95,Default,,0,0,0,,Ресми матчта маған қарсы ойнау қызық болмас еді.
Dialogue: 0,0:06:13.20,0:06:15.75,Default,,0,0,0,,Сіз мұны үнемі жасайсыз дейсіз бе?
Dialogue: 0,0:06:16.20,0:06:18.16,Default,,0,0,0,,Мен осы сәттен бастап шешім қабылдадым.
Dialogue: 0,0:06:18.41,0:06:21.13,Default,,0,0,0,,Егер біз ресми матчта соқтығыссақ
Dialogue: 0,0:06:21.25,0:06:22.88,Default,,0,0,0,,Үйге барма
Dialogue: 0,0:06:23.13,0:06:24.67,Default,,0,0,0,,Мен монахты да кездестірмеймін.
Dialogue: 0,0:06:25.17,0:06:28.09,Default,,0,0,0,,Уау, бұл өте жақсы.
Dialogue: 0,0:06:28.51,0:06:30.47,Default,,0,0,0,,Балалар сендер бір нәрсені өзгерттіңдер.
Dialogue: 0,0:06:30.55,0:06:32.51,Default,,0,0,0,,Мені «Ботчан» деп атамаңыз
Dialogue: 0,0:06:32.64,0:06:33.93,Default,,0,0,0,,Иә
Dialogue: 0,0:06:34.18,0:06:37.06,Default,,0,0,0,,Бұл... қожайын мен қызметші сияқты.
Dialogue: 0,0:06:37.56,0:06:39.10,Default,,0,0,0,,Менің қызметшім
Dialogue: 0,0:06:40.19,0:06:42.36,Default,,0,0,0,,Менің ойымша, бұл солай көрінеді.
Dialogue: 0,0:06:45.19,0:06:46.94,Default,,0,0,0,,Тіпті біз алғаш кездескен кезде де
Dialogue: 0,0:06:47.15,0:06:48.57,Default,,0,0,0,,Баланың әкесінен
Dialogue: 0,0:06:48.65,0:06:51.36,Default,,0,0,0,,Ол маған ойын құрбы болуымды өтінді.
Dialogue: 0,0:06:53.45,0:06:56.70,Default,,0,0,0,,Бей де баладан үйренді.
Dialogue: 0,0:06:58.37,0:07:00.25,Default,,0,0,0,,Осы сияқты әртүрлі заттар.
Dialogue: 0,0:07:00.67,0:07:03.29,Default,,0,0,0,,Кешіріңіз, сіз жаттығуға кедергі келтірдіңіз.
Dialogue: 0,0:07:03.46,0:07:05.55,Default,,0,0,0,,Сіз бұл орынды пайдалана аласыз.
Dialogue: 0,0:07:05.71,0:07:06.71,Default,,0,0,0,,Эй
Dialogue: 0,0:07:06.88,0:07:08.38,Default,,0,0,0,,Жарысқа қатысқыңыз келе ме?
Dialogue: 0,0:07:08.84,0:07:09.76,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:11.43,0:07:14.05,Default,,0,0,0,,Жақын достар мен бір-бірімен соқтығысатын адамдар арасындағы
Dialogue: 0,0:07:14.43,0:07:16.06,Default,,0,0,0,,Келесі ойында жеңіске жететін болсақ
Dialogue: 0,0:07:16.14,0:07:18.27,Default,,0,0,0,,Бұл екі блоктың финалы.
Dialogue: 0,0:07:18.81,0:07:21.56,Default,,0,0,0,,Жаса немесе ұрыспа
Dialogue: 0,0:07:22.06,0:07:24.65,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:24.98,0:07:26.73,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:31.74,0:07:33.57,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:07:36.87,0:07:39.20,Default,,0,0,0,,Неге бүгін ғана...
Dialogue: 0,0:07:40.00,0:07:40.96,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:41.12,0:07:43.54,Default,,0,0,0,,Бұл кері түс.
Dialogue: 0,0:07:47.04,0:07:50.26,Default,,0,0,0,,Бұл жерде. Мұнда. Мұнда.
Dialogue: 0,0:07:50.34,0:07:52.01,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:52.59,0:07:54.76,Default,,0,0,0,,Кумичо мен басқалары күтіп тұр.
Dialogue: 0,0:07:55.51,0:07:57.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:57.39,0:07:58.64,Default,,0,0,0,,Бал-нии!
Dialogue: 0,0:08:00.60,0:08:02.81,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:08:03.27,0:08:04.98,Default,,0,0,0,,Хахан
Dialogue: 0,0:08:05.27,0:08:07.06,Default,,0,0,0,,Мен осылаймын
Dialogue: 0,0:08:07.36,0:08:08.36,Default,,0,0,0,,Хаха?
Dialogue: 0,0:08:08.44,0:08:09.44,Default,,0,0,0,,Иә
Dialogue: 0,0:08:09.69,0:08:11.65,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:08:11.74,0:08:13.70,Default,,0,0,0,,О! Жарайды, жарайды
Dialogue: 0,0:08:13.78,0:08:16.41,Default,,0,0,0,,Керемет, жарқырап тұр.
Dialogue: 0,0:08:16.49,0:08:17.41,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:08:17.87,0:08:19.24,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:08:19.49,0:08:20.87,Default,,0,0,0,,Бұл анық емес.
Dialogue: 0,0:08:20.95,0:08:22.75,Default,,0,0,0,,Әрқашан мінсіз
Dialogue: 0,0:08:22.83,0:08:24.25,Default,,0,0,0,,Менің бетперделеу техникам
Dialogue: 0,0:08:24.58,0:08:25.63,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:25.71,0:08:28.75,Default,,0,0,0,,Эй, эй, сен де Блейдерсің бе?
Dialogue: 0,0:08:29.25,0:08:31.96,Default,,0,0,0,,Жақсы сұрақ.
Dialogue: 0,0:08:32.30,0:08:34.17,Default,,0,0,0,,Хаха!
Dialogue: 0,0:08:34.26,0:08:35.89,Default,,0,0,0,,На~ису.
Dialogue: 0,0:08:35.97,0:08:37.43,Default,,0,0,0,,Егер ол ондаған күн бойы осылай көңілді жүретін болса, онда Киса қалыпты емес болар еді.
Dialogue: 0,0:08:37.85,0:08:39.93,Default,,0,0,0,,Жоқ, солай емес пе?
Dialogue: 0,0:08:42.27,0:08:44.31,Default,,0,0,0,,Бүгін де келді.
Dialogue: 0,0:08:44.64,0:08:46.81,Default,,0,0,0,,Бүгін де келді.
Dialogue: 0,0:08:47.15,0:08:49.11,Default,,0,0,0,,Тыңдаңыздар, мынаны есте сақтаңыздар.
Dialogue: 0,0:08:49.19,0:08:52.44,Default,,0,0,0,,А блогының өкілі осы Кумичо-сама.
Dialogue: 0,0:08:52.53,0:08:54.20,Default,,0,0,0,,Жоқ, бұл менмін.
Dialogue: 0,0:08:54.28,0:08:56.24,Default,,0,0,0,,Бүгін сіз үшін аяқталды.
Dialogue: 0,0:08:56.32,0:08:59.12,Default,,0,0,0,,Маған кездескеніңізге өкінесіз.
Dialogue: 0,0:08:59.20,0:09:00.28,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:09:00.62,0:09:01.58,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:09:01.66,0:09:03.62,Default,,0,0,0,,Мен бүгін керемет көрінемін
Dialogue: 0,0:09:03.70,0:09:05.25,Default,,0,0,0,,Мен тіпті таң қалдым.
Dialogue: 0,0:09:05.33,0:09:08.29,Default,,0,0,0,,Мен таңғы асқа қанша болдыңыз деп ойладым.
Dialogue: 0,0:09:09.00,0:09:11.75,Default,,0,0,0,,Қанша кесе жегеніңді білмеймін.
Dialogue: 0,0:09:12.09,0:09:13.59,Default,,0,0,0,,Менде 5 кесе бар!
Dialogue: 0,0:09:13.92,0:09:15.38,Default,,0,0,0,,Ku oh~
Dialogue: 0,0:09:15.59,0:09:17.34,Default,,0,0,0,,Каккакка~
Dialogue: 0,0:09:17.43,0:09:19.14,Default,,0,0,0,,Қай жерде жарысуға болады? сонда
Dialogue: 0,0:09:19.22,0:09:20.51,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:09:20.97,0:09:22.97,Default,,0,0,0,,Таңертеңнен бері бос емес.
Dialogue: 0,0:09:23.18,0:09:23.89,Default,,0,0,0,,Шу!
Dialogue: 0,0:09:24.68,0:09:26.94,Default,,0,0,0,,Егер сіз мұны жасасаңыз, сіз оны нақты шоуға да жеткізе алмайсыз.
Dialogue: 0,0:09:27.19,0:09:28.81,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:28.90,0:09:31.11,Default,,0,0,0,,Бүгін мен және Валькири
Dialogue: 0,0:09:31.65,0:09:33.15,Default,,0,0,0,,Мен жақсы жұмыс істеп жатырмын.
Dialogue: 0,0:09:33.57,0:09:34.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:35.70,0:09:37.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:37.61,0:09:39.16,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,0:09:42.03,0:09:43.54,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:09:43.62,0:09:44.91,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:09:45.12,0:09:46.91,Default,,0,0,0,,Валькирияның оянуының сыры
Dialogue: 0,0:09:47.25,0:09:50.59,Default,,0,0,0,,Айнымалы драйвердің ұшы қырылған.
Dialogue: 0,0:09:50.67,0:09:51.88,Default,,0,0,0,,Пішін өзгерді
Dialogue: 0,0:09:52.17,0:09:53.59,Default,,0,0,0,,Иә, бұл рас.
Dialogue: 0,0:09:53.67,0:09:55.67,Default,,0,0,0,,Бұл құпия ма?
Dialogue: 0,0:09:55.76,0:09:57.13,Default,,0,0,0,,Біртүрлі~
Dialogue: 0,0:09:57.51,0:09:59.05,Default,,0,0,0,,Осы пішінге байланысты
Dialogue: 0,0:09:59.14,0:10:01.30,Default,,0,0,0,,Сіз сол қарқынды қозғалысты жасай аласыз.
Dialogue: 0,0:10:01.51,0:10:03.26,Default,,0,0,0,,Керемет~
Dialogue: 0,0:10:03.35,0:10:05.52,Default,,0,0,0,,Керемет Валькирия
Dialogue: 0,0:10:05.60,0:10:07.69,Default,,0,0,0,,Мен саған осылай тап болдым.
Dialogue: 0,0:10:07.77,0:10:09.85,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:10:09.94,0:10:10.90,Default,,0,0,0,,Мен де
Dialogue: 0,0:10:10.98,0:10:13.48,Default,,0,0,0,,Сізді жеңіп, ояныңыз!
Dialogue: 0,0:10:13.77,0:10:16.36,Default,,0,0,0,,Сонымен... тыңдамадың! Эй
Dialogue: 0,0:10:16.49,0:10:19.20,Default,,0,0,0,,Дина! ояту сыры
Dialogue: 0,0:10:19.28,0:10:20.53,Default,,0,0,0,,Мұнда қараңыз.
Dialogue: 0,0:10:21.91,0:10:23.49,Default,,0,0,0,,Нашар
Dialogue: 0,0:10:24.70,0:10:26.58,Default,,0,0,0,,Мен қазір шоғырланып жатырмын.
Dialogue: 0,0:10:38.13,0:10:39.59,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:10:43.30,0:10:45.35,Default,,0,0,0,,Сәттілік, ағайын.
Dialogue: 0,0:10:45.43,0:10:47.31,Default,,0,0,0,,Бала, мен сені таң қалдырамын.
Dialogue: 0,0:10:47.43,0:10:48.48,Default,,0,0,0,,Эй
Dialogue: 0,0:10:48.93,0:10:51.35,Default,,0,0,0,,О, маған қарашы.
Dialogue: 0,0:10:51.60,0:10:56.53,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:58.90,0:11:00.45,Default,,0,0,0,,Na~is
Dialogue: 0,0:11:00.61,0:11:03.03,Default,,0,0,0,,На~ бәрі на~
Dialogue: 0,0:11:05.33,0:11:07.08,Default,,0,0,0,,Барт
Dialogue: 0,0:11:07.91,0:11:08.95,Default,,0,0,0,,Вакия
Dialogue: 0,0:11:09.29,0:11:10.46,Default,,0,0,0,,Жоғалтпа
Dialogue: 0,0:11:11.21,0:11:13.83,Default,,0,0,0,,О, мен міндетті түрде жеңемін!
Dialogue: 0,0:11:14.34,0:11:16.42,Default,,0,0,0,,Ұлттық конгрессте кездескенше
Dialogue: 0,0:11:16.80,0:11:19.80,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:11:20.13,0:11:22.39,Default,,0,0,0,,Бейблейд аймағын таңдау турнирі
Dialogue: 0,0:11:22.47,0:11:24.22,Default,,0,0,0,,Бүгін де көңілді болайық
Dialogue: 0,0:11:24.55,0:11:25.85,Default,,0,0,0,,Алға қарай жүрейік
Dialogue: 0,0:11:25.93,0:11:27.26,Default,,0,0,0,,Бүкіл елге барайық
Dialogue: 0,0:11:27.56,0:11:30.02,Default,,0,0,0,,Жеңіс, мен сені сүйем.
Dialogue: 0,0:11:32.81,0:11:35.52,Default,,0,0,0,,Біріншіден, А блогының бірінші ойыны
Dialogue: 0,0:11:35.73,0:11:37.78,Default,,0,0,0,,Қауіптің оянуы жалғасуда
Dialogue: 0,0:11:37.86,0:11:40.44,Default,,0,0,0,,Барто Аоимен таныстыру
Dialogue: 0,0:11:41.24,0:11:44.28,Default,,0,0,0,,Өрт регентіне қарсы
Dialogue: 0,0:11:44.37,0:11:47.08,Default,,0,0,0,,Рантаро Кияма!
Dialogue: 0,0:11:49.33,0:11:50.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:50.83,0:11:53.25,Default,,0,0,0,,Кумичо шайқасынан ләззат алайық
Dialogue: 0,0:11:54.50,0:11:56.09,Default,,0,0,0,,Көңілді боласың ба?
Dialogue: 0,0:11:56.79,0:11:59.63,Default,,0,0,0,,Жылы сөз айтпа, Балто.
Dialogue: 0,0:12:00.09,0:12:01.59,Default,,0,0,0,,Сен менікісің
Dialogue: 0,0:12:01.67,0:12:02.84,Default,,0,0,0,,Жау
Dialogue: 0,0:12:04.09,0:12:05.55,Default,,0,0,0,,Жау?
Dialogue: 0,0:12:07.18,0:12:10.02,Default,,0,0,0,,Балто Бұл тағдырдың жазуы.
Dialogue: 0,0:12:10.60,0:12:12.89,Default,,0,0,0,,Бұл шайқаста мен жеңемін
Dialogue: 0,0:12:12.98,0:12:15.10,Default,,0,0,0,,Иә, мен де жеңемін.
Dialogue: 0,0:12:15.19,0:12:16.40,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:12:16.81,0:12:19.98,Default,,0,0,0,,Эй, сен оянатын нәрсеге қуанып тұрған сияқтысың.
Dialogue: 0,0:12:20.48,0:12:22.78,Default,,0,0,0,,Сіз бұл үлкен ойында жеңе алмайсыз.
Dialogue: 0,0:12:23.32,0:12:24.78,Default,,0,0,0,,Оны үрлейміз
Dialogue: 0,0:12:25.16,0:12:27.49,Default,,0,0,0,,Жанның Рагнарукы
Dialogue: 0,0:12:28.28,0:12:29.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:29.74,0:12:30.87,Default,,0,0,0,,Жан болса
Dialogue: 0,0:12:30.95,0:12:33.33,Default,,0,0,0,,Мен де жанып тұрмын
Dialogue: 0,0:12:33.83,0:12:36.29,Default,,0,0,0,,Мен көбірек күйіп тұрмын
Dialogue: 0,0:12:36.38,0:12:38.42,Default,,0,0,0,,Мен оттырақпын
Dialogue: 0,0:12:38.50,0:12:39.84,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:12:40.42,0:12:43.63,Default,,0,0,0,,Сонда мынау одан 10 000 000 000 есе көп жанады.
Dialogue: 0,0:12:43.72,0:12:46.34,Default,,0,0,0,,Олай десеңіз, 100 миллион есе көп!
Dialogue: 0,0:12:46.47,0:12:48.35,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:12:48.43,0:12:50.72,Default,,0,0,0,,Қазір бастай аламыз ба?
Dialogue: 0,0:12:52.64,0:12:53.85,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:12:55.85,0:12:57.56,Default,,0,0,0,,Кумичоға барайық
Dialogue: 0,0:12:58.31,0:12:59.82,Default,,0,0,0,,Кой Балто
Dialogue: 0,0:12:59.90,0:13:01.69,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:13:02.28,0:13:05.49,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:05.57,0:13:07.82,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:11.12,0:13:12.91,Default,,0,0,0,,Ой, Валькири
Dialogue: 0,0:13:13.00,0:13:14.46,Default,,0,0,0,,Тұрақсыз бастау
Dialogue: 0,0:13:14.79,0:13:15.83,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:16.21,0:13:17.96,Default,,0,0,0,,Сен істедің, Балто.
Dialogue: 0,0:13:18.17,0:13:20.84,Default,,0,0,0,,Рагнарук ортаны алды.
Dialogue: 0,0:13:20.92,0:13:22.21,Default,,0,0,0,,Валькирияның жылдамдығы
Dialogue: 0,0:13:22.30,0:13:24.63,Default,,0,0,0,,Бұл әлі де шектен тыс.
Dialogue: 0,0:13:24.72,0:13:26.63,Default,,0,0,0,,Fast Fast стадионы
Dialogue: 0,0:13:26.72,0:13:28.59,Default,,0,0,0,,Барлық жерде.
Dialogue: 0,0:13:28.68,0:13:30.47,Default,,0,0,0,,Мықты бол, Валькири.
Dialogue: 0,0:13:32.72,0:13:34.81,Default,,0,0,0,,Бұл әлі де ояту ма?
Dialogue: 0,0:13:35.64,0:13:37.31,Default,,0,0,0,,Бұл үлкен какофония емес пе?
Dialogue: 0,0:13:39.48,0:13:40.52,Default,,0,0,0,,Жүр!
Dialogue: 0,0:13:42.36,0:13:43.94,Default,,0,0,0,,Жақсы, Рагнарук.
Dialogue: 0,0:13:45.19,0:13:49.11,Default,,0,0,0,,Валькири Рагнарук қатты қақтығысты
Dialogue: 0,0:13:50.57,0:13:51.20,Default,,0,0,0,,Не?
Dialogue: 0,0:13:51.28,0:13:52.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:53.70,0:13:55.54,Default,,0,0,0,,Рагнарук Таэро
Dialogue: 0,0:14:01.42,0:14:03.38,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:03.46,0:14:04.55,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:04.84,0:14:07.51,Default,,0,0,0,,Жеңіс Valkyrie айналдыру финиш
Dialogue: 0,0:14:07.59,0:14:08.84,Default,,0,0,0,,1 ұпай бірінші
Dialogue: 0,0:14:09.89,0:14:13.18,Default,,0,0,0,,Валькирияның күші мені құтқарды, Балто.
Dialogue: 0,0:14:13.51,0:14:15.47,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:14:15.68,0:14:17.60,Default,,0,0,0,,Ырғақ бұзыла береді.
Dialogue: 0,0:14:18.35,0:14:19.65,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:14:20.60,0:14:22.57,Default,,0,0,0,,Келесі жолы олай болмайды.
Dialogue: 0,0:14:24.98,0:14:26.07,Default,,0,0,0,,Валькирия
Dialogue: 0,0:14:26.69,0:14:28.49,Default,,0,0,0,,Бар күшіммен ұшамын
Dialogue: 0,0:14:29.15,0:14:30.78,Default,,0,0,0,,Пішін өзгертілді
Dialogue: 0,0:14:30.87,0:14:32.87,Default,,0,0,0,,Сіз әртүрлі заттарды сынап көресіз бе?
Dialogue: 0,0:14:33.37,0:14:35.91,Default,,0,0,0,,Жоқ, бұл жай ғана инстинкт.
Dialogue: 0,0:14:36.12,0:14:37.96,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:38.41,0:14:41.92,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:42.00,0:14:44.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:48.05,0:14:49.88,Default,,0,0,0,,Рагнарукты жою
Dialogue: 0,0:14:50.09,0:14:52.64,Default,,0,0,0,,Рагнарук орталықты ерте алды.
Dialogue: 0,0:14:52.76,0:14:54.81,Default,,0,0,0,,Екінші жағынан, Валькири...
Dialogue: 0,0:14:54.89,0:14:56.85,Default,,0,0,0,,Бір нәрсе қазірдің өзінде жабайы болып жатыр.
Dialogue: 0,0:14:58.14,0:14:59.94,Default,,0,0,0,,Кел, Балто
Dialogue: 0,0:15:01.35,0:15:03.15,Default,,0,0,0,,Жүр!
Dialogue: 0,0:15:08.82,0:15:11.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:11.36,0:15:12.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:12.24,0:15:15.58,Default,,0,0,0,,Рагнарук мәреден жоғары көтерілу 1 ұпай
Dialogue: 0,0:15:15.91,0:15:17.29,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:15:17.37,0:15:18.54,Default,,0,0,0,,Өтірікші...
Dialogue: 0,0:15:19.20,0:15:21.54,Default,,0,0,0,,Қандай жабайы жылқы!
Dialogue: 0,0:15:22.29,0:15:23.00,Default,,0,0,0,,Хун
Dialogue: 0,0:15:23.50,0:15:25.88,Default,,0,0,0,,Кондукторды да ояту керек.
Dialogue: 0,0:15:26.42,0:15:28.71,Default,,0,0,0,,Екі нүкте де 1:1
Dialogue: 0,0:15:28.80,0:15:31.93,Default,,0,0,0,,Матч келесі шайқасқа ауыстырылды.
Dialogue: 0,0:15:32.01,0:15:33.18,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:15:35.05,0:15:37.31,Default,,0,0,0,,Бұл шайқас шешіледі.
Dialogue: 0,0:15:37.93,0:15:40.39,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:15:40.48,0:15:42.60,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:15:42.69,0:15:46.15,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:46.23,0:15:49.15,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:50.44,0:15:52.15,Default,,0,0,0,,Сәтті түсіру
Dialogue: 0,0:15:52.24,0:15:54.57,Default,,0,0,0,,Рагнарук Ортасын ұстаңыз
Dialogue: 0,0:15:59.16,0:16:00.79,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:16:00.87,0:16:03.37,Default,,0,0,0,,Мен бұл Валькириді күттім.
Dialogue: 0,0:16:03.46,0:16:05.08,Default,,0,0,0,,Бүгін қылыш айналдыру жаттығуын жасадым
Dialogue: 0,0:16:05.17,0:16:06.63,Default,,0,0,0,,Мен сені үрлеймін
Dialogue: 0,0:16:10.05,0:16:12.51,Default,,0,0,0,,Қашықтық
Dialogue: 0,0:16:12.59,0:16:15.59,Default,,0,0,0,,Хмм, бұл Рагнарук үшін жұмыс істемейді.
Dialogue: 0,0:16:19.72,0:16:20.98,Default,,0,0,0,,Жеңілу мүмкін емес
Dialogue: 0,0:16:21.06,0:16:24.60,Default,,0,0,0,,Ортада тұрған Рагнарук ше?
Dialogue: 0,0:16:24.69,0:16:27.06,Default,,0,0,0,,Мен ешқашан құламаймын
Dialogue: 0,0:16:27.15,0:16:29.32,Default,,0,0,0,,Мен сені міндетті түрде жеңемін.
Dialogue: 0,0:16:29.94,0:16:33.11,Default,,0,0,0,,Валькирия Сіз жасай аласыз.
Dialogue: 0,0:16:37.12,0:16:39.74,Default,,0,0,0,,Төзімділік түрі Оны атамаңыз.
Dialogue: 0,0:16:39.83,0:16:42.41,Default,,0,0,0,,Сырттап өтіңіз!
Dialogue: 0,0:16:43.21,0:16:46.08,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:48.04,0:16:49.88,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:16:49.96,0:16:51.71,Default,,0,0,0,,Бұл Валькири
Dialogue: 0,0:16:51.80,0:16:54.51,Default,,0,0,0,,Толық қуат!
Dialogue: 0,0:16:55.51,0:16:57.39,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:16:58.64,0:17:00.31,Default,,0,0,0,,А... бар күшің бар ма?
Dialogue: 0,0:17:01.14,0:17:02.22,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:17:02.56,0:17:03.68,Default,,0,0,0,,Балтық
Dialogue: 0,0:17:04.48,0:17:06.48,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:17:10.06,0:17:11.61,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:17:11.69,0:17:14.24,Default,,0,0,0,,Серпінді финиш 3-тен 1-ге дейін
Dialogue: 0,0:17:14.32,0:17:15.99,Default,,0,0,0,,Барто Аоидың жеңісі
Dialogue: 0,0:17:16.32,0:17:18.32,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:18.41,0:17:21.04,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:17:21.12,0:17:23.75,Default,,0,0,0,,Бұл әлі қауіпті, Балто.
Dialogue: 0,0:17:24.08,0:17:25.21,Default,,0,0,0,,Біртіндеп
Dialogue: 0,0:17:25.29,0:17:27.83,Default,,0,0,0,,Оянған Валькирді басқару
Dialogue: 0,0:17:27.92,0:17:29.75,Default,,0,0,0,,Енді мен мұны істей аламын.
Dialogue: 0,0:17:34.13,0:17:38.22,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:17:38.59,0:17:40.10,Default,,0,0,0,,Блок
Dialogue: 0,0:17:40.18,0:17:42.06,Default,,0,0,0,,Финалға бірінші шыққан адам
Dialogue: 0,0:17:42.14,0:17:45.23,Default,,0,0,0,,Бұл Барто Аои.
Dialogue: 0,0:17:47.77,0:17:51.32,Default,,0,0,0,,Танымал батырлар агенттігіне қосылғаныңыз жөн—
Dialogue: 0,0:17:51.40,0:17:52.61,Default,,0,0,0,,Жылау
Dialogue: 0,0:17:52.98,0:17:54.74,Default,,0,0,0,,Сол Кумичо
Dialogue: 0,0:17:54.94,0:17:56.28,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:17:56.90,0:17:58.24,Default,,0,0,0,,Кумичо
Dialogue: 0,0:17:59.45,0:18:00.99,Default,,0,0,0,,Балто!
Dialogue: 0,0:18:02.53,0:18:03.95,Default,,0,0,0,,Сен
Dialogue: 0,0:18:04.04,0:18:06.58,Default,,0,0,0,,Республикалық турнирге барайық!
Dialogue: 0,0:18:08.17,0:18:09.46,Default,,0,0,0,,Егер сіз жоғалтсаңыз
Dialogue: 0,0:18:11.25,0:18:13.25,Default,,0,0,0,,Мен оны тегін қалдыра алмаймын.
Dialogue: 0,0:18:15.80,0:18:17.67,Default,,0,0,0,,О, оны маған қалдырыңыз.
Dialogue: 0,0:18:17.88,0:18:21.01,Default,,0,0,0,,Мен міндетті түрде жеңіп, елге барамын.
Dialogue: 0,0:18:21.51,0:18:23.68,Default,,0,0,0,,О, бұл уәде.
Dialogue: 0,0:18:25.85,0:18:27.94,Default,,0,0,0,,Жақсы тамаша
Dialogue: 0,0:18:28.02,0:18:30.56,Default,,0,0,0,,Достыққа тост деп аталады.
Dialogue: 0,0:18:31.06,0:18:34.36,Default,,0,0,0,,Блок: Келесі матчты шешкен нәрсе
Dialogue: 0,0:18:34.44,0:18:35.90,Default,,0,0,0,,Күміс жүзі Орочи
Dialogue: 0,0:18:35.98,0:18:38.57,Default,,0,0,0,,Обелиск Один шынымен күшті
Dialogue: 0,0:18:39.07,0:18:41.37,Default,,0,0,0,,Аудандық іріктеу турнирі қызу бәсекемен жалғасуда
Dialogue: 0,0:18:41.45,0:18:44.83,Default,,0,0,0,,Финалистер әр блок бойынша бірінен соң бірі анықталады.
Dialogue: 0,0:18:44.91,0:18:46.91,Default,,0,0,0,,Енді C блогына кірейік.
Dialogue: 0,0:18:47.79,0:18:49.00,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:49.08,0:18:51.13,Default,,0,0,0,,Алдымен стадионнан өтіңіз
Dialogue: 0,0:18:51.21,0:18:52.63,Default,,0,0,0,,Жабайы жел
Dialogue: 0,0:18:52.71,0:18:54.50,Default,,0,0,0,,Комурасаки Вакия
Dialogue: 0,0:18:55.05,0:18:58.63,Default,,0,0,0,,Күннің ашық, жұмсақ сәулесіне қарсы
Dialogue: 0,0:18:58.72,0:19:00.55,Default,,0,0,0,,Ходжи Конта
Dialogue: 0,0:19:01.43,0:19:03.51,Default,,0,0,0,,Сәттілік, ағайын.
Dialogue: 0,0:19:03.60,0:19:04.89,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе~
Dialogue: 0,0:19:04.97,0:19:07.52,Default,,0,0,0,,Бауырым, сен міндетті түрде жеңесің.
Dialogue: 0,0:19:10.10,0:19:13.36,Default,,0,0,0,,Хоудзи Вайдың Маджи шоуы Тарде
Dialogue: 0,0:19:14.15,0:19:15.73,Default,,0,0,0,,Иә, кішкентай бала.
Dialogue: 0,0:19:16.53,0:19:18.99,Default,,0,0,0,,Бұл шайқасты мен аламын
Dialogue: 0,0:19:19.90,0:19:23.03,Default,,0,0,0,,Мен де осы ниетпен тұрмын.
Dialogue: 0,0:19:27.45,0:19:28.83,Default,,0,0,0,,Ботчаннан
Dialogue: 0,0:19:28.91,0:19:31.83,Default,,0,0,0,,Мен бұрын-соңды сезінбеген рухты сезінемін.
Dialogue: 0,0:19:32.75,0:19:34.59,Default,,0,0,0,,Бұл бала байсалды ма?
Dialogue: 0,0:19:35.46,0:19:36.17,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:19:36.67,0:19:38.92,Default,,0,0,0,,Мен баланың әдеті туралы бәрін білемін.
Dialogue: 0,0:19:39.30,0:19:41.68,Default,,0,0,0,,Виверннің жолын көріп тұрмын
Dialogue: 0,0:19:42.63,0:19:44.30,Default,,0,0,0,,Жеңіске бір ғана мүмкіндік бар
Dialogue: 0,0:19:44.39,0:19:47.06,Default,,0,0,0,,Виверннің күрт бұрылысының соңында
Dialogue: 0,0:19:47.14,0:19:48.81,Default,,0,0,0,,Хорсудты ату
Dialogue: 0,0:19:48.89,0:19:50.39,Default,,0,0,0,,Бастаманы өз қолыңызға алыңыз
Dialogue: 0,0:19:51.73,0:19:53.23,Default,,0,0,0,,Сезіңіз
Dialogue: 0,0:19:53.31,0:19:54.86,Default,,0,0,0,,Сіздің байыптылығыңыз
Dialogue: 0,0:19:55.27,0:19:56.94,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:57.23,0:19:58.32,Default,,0,0,0,,Үш
Dialogue: 0,0:19:58.94,0:20:00.78,Default,,0,0,0,,Бұл ойын, балам.
Dialogue: 0,0:20:01.11,0:20:02.03,Default,,0,0,0,,Екі
Dialogue: 0,0:20:02.49,0:20:04.07,Default,,0,0,0,,Мына жігітті тартсаң
Dialogue: 0,0:20:04.41,0:20:05.53,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:20:05.62,0:20:07.24,Default,,0,0,0,,Бәрі шешілді
Dialogue: 0,0:20:07.33,0:20:09.83,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:09.91,0:20:11.91,Default,,0,0,0,,Хорсуд ұшады
Dialogue: 0,0:20:16.79,0:20:19.46,Default,,0,0,0,,Не, сіздің қозғалыстарыңыз әдеттегіден басқаша?
Dialogue: 0,0:20:21.59,0:20:23.80,Default,,0,0,0,,Сіз жарысуға келдіңіз бе? Хоудзи
Dialogue: 0,0:20:27.22,0:20:29.01,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:29.51,0:20:30.81,Default,,0,0,0,,Не!
Dialogue: 0,0:20:31.89,0:20:34.48,Default,,0,0,0,,Wild Wyvern Burst Finish
Dialogue: 0,0:20:34.81,0:20:37.52,Default,,0,0,0,,Вакия Кожима 2-0
Dialogue: 0,0:20:37.61,0:20:38.44,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:20:38.52,0:20:39.69,Default,,0,0,0,,(Куджо Йотаро) Польнареф, мына жігіт… Бұл адам кім өзі?
Dialogue: 0,0:20:39.78,0:20:41.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:41.24,0:20:43.45,Default,,0,0,0,,Ах~
Dialogue: 0,0:20:43.86,0:20:44.99,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:20:45.07,0:20:46.20,Default,,0,0,0,,Жарылыс
Dialogue: 0,0:20:46.28,0:20:48.28,Default,,0,0,0,,Виверн де қауіпті болды.
Dialogue: 0,0:20:49.03,0:20:51.16,Default,,0,0,0,,Хорсуд вивернаға айналады
Dialogue: 0,0:20:51.25,0:20:54.21,Default,,0,0,0,,Менің ойымша, олар алдын ала соққы беруге тырысты.
Dialogue: 0,0:20:54.29,0:20:56.50,Default,,0,0,0,,Тек уақыт өшірулі болды.
Dialogue: 0,0:20:56.88,0:21:00.17,Default,,0,0,0,,Егер ол Конта оқыған кезде қозғалса...
Dialogue: 0,0:21:01.63,0:21:02.67,Default,,0,0,0,,Ботчан
Dialogue: 0,0:21:03.17,0:21:04.88,Default,,0,0,0,,Бұл күшті
Dialogue: 0,0:21:04.97,0:21:06.43,Default,,0,0,0,,Әрине
Dialogue: 0,0:21:06.51,0:21:09.51,Default,,0,0,0,,Мен саған айттым, сен мені жеңе алмайсың.
Dialogue: 0,0:21:11.01,0:21:12.31,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:12.39,0:21:14.35,Default,,0,0,0,,Хорсуд қай жерде ұшып келеді
Dialogue: 0,0:21:14.43,0:21:15.98,Default,,0,0,0,,Егер оның тереңдігі бір шығанақ болса
Dialogue: 0,0:21:16.06,0:21:18.27,Default,,0,0,0,,Нәтиже керісінше болуы мүмкін.
Dialogue: 0,0:21:18.86,0:21:19.82,Default,,0,0,0,,Ботчан
Dialogue: 0,0:21:20.02,0:21:22.78,Default,,0,0,0,,Бұл соңғы минуттық ойын!
Dialogue: 0,0:21:25.57,0:21:26.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:27.57,0:21:28.62,Default,,0,0,0,,На
Dialogue: 0,0:21:30.74,0:21:33.00,Default,,0,0,0,,Сарайдағы тағы бір шайқас...
Dialogue: 0,0:21:34.12,0:21:35.33,Default,,0,0,0,,♪ Вуф-вуф, вуф-вуф
Dialogue: 0,0:21:35.41,0:21:37.21,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:21:37.29,0:21:38.96,Default,,0,0,0,,Тез оралыңыз.
Dialogue: 0,0:21:39.04,0:21:42.17,Default,,0,0,0,,Сен қызықсыз.
Dialogue: 0,0:21:44.55,0:21:45.55,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:45.63,0:21:46.88,Default,,0,0,0,,Хмм.
Dialogue: 0,0:21:46.97,0:21:48.14,Default,,0,0,0,,Шу!
Dialogue: 0,0:21:48.22,0:21:51.05,Default,,0,0,0,,Мен қышиды~
Dialogue: 0,0:21:51.76,0:21:53.77,Default,,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.48,0:23:30.20,Default,,0,0,0,,Менің алдымнан ғажайып түрлену кейіпкері шықты.
Dialogue: 0,0:23:30.28,0:23:32.86,Default,,0,0,0,,Өте күшті шығанақ сізді матчқа шақырады.
Dialogue: 0,0:23:32.95,0:23:35.37,Default,,0,0,0,,Оның аты Бейблейд маскасы
Dialogue: 0,0:23:35.45,0:23:36.99,Default,,0,0,0,,Өте керемет~
Dialogue: 0,0:23:37.08,0:23:39.12,Default,,0,0,0,,Енді мен де батыр болғым келеді
Dialogue: 0,0:23:39.20,0:23:42.87,Default,,0,0,0,,Оның аты – Балтман! Не?
Dialogue: 0,0:23:42.96,0:23:44.79,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.88,0:23:46.67,Default,,0,0,0,,Бейблейдтің жұмбақ маскасы!
