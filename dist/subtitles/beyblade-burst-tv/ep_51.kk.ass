Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.21,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.30,0:00:12.42,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.63,0:00:14.68,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.76,0:00:16.89,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.97,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.64,0:00:24.14,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.23,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.73,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.11,0:00:32.86,Default,,0,0,0,,Ешкім нәтижелерге сәйкес келмейді.
Dialogue: 0,0:00:37.07,0:00:39.20,Default,,0,0,0,,Мен оны анық көремін
Dialogue: 0,0:00:39.45,0:00:41.16,Default,,0,0,0,,Луис сен
Dialogue: 0,0:00:41.49,0:00:43.12,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:00:43.20,0:00:44.29,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:00:46.42,0:00:49.38,Default,,0,0,0,,Ширасаги Castle Rui командасына қарсы финалдық ойын басталды.
Dialogue: 0,0:00:50.96,0:00:52.96,Default,,0,0,0,,Буккамасе Валькири
Dialogue: 0,0:00:53.76,0:00:55.13,Default,,0,0,0,,Жүр!
Dialogue: 0,0:00:56.43,0:00:58.18,Default,,0,0,0,,Өлім спиралы
Dialogue: 0,0:01:06.52,0:01:07.65,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:01:07.98,0:01:08.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:09.36,0:01:11.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:14.61,0:01:17.03,Default,,0,0,0,,Жоғалған Longinus Burst Finish
Dialogue: 0,0:01:17.11,0:01:18.45,Default,,0,0,0,,2-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:01:22.04,0:01:25.79,Default,,0,0,0,,Бірінші шайқаста Лонгинус жарылды.
Dialogue: 0,0:01:26.00,0:01:26.96,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:01:27.04,0:01:28.83,Default,,0,0,0,,Матч басталғалы жатыр.
Dialogue: 0,0:01:28.92,0:01:30.34,Default,,0,0,0,,Қатты жүрейік!
Dialogue: 0,0:01:38.80,0:01:41.18,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:41.51,0:01:46.68,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:57.99,0:02:01.37,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:01.87,0:02:03.99,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:04.41,0:02:08.54,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:08.66,0:02:11.88,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:12.00,0:02:18.42,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:18.72,0:02:23.14,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:23.64,0:02:29.06,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:29.19,0:02:31.44,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:31.52,0:02:36.23,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:36.40,0:02:41.49,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:41.78,0:02:44.03,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:44.24,0:02:46.58,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:46.87,0:02:50.79,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:50.96,0:02:55.96,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:56.17,0:02:58.34,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:02.47,0:03:04.55,Default,,0,0,0,,Шешіңіз! Серіктес (Валкирия)!
Dialogue: 0,0:03:06.18,0:03:08.85,Default,,0,0,0,,Ұпайлар 2-0
Dialogue: 0,0:03:08.93,0:03:10.94,Default,,0,0,0,,Енді Аои Барто бұрышта тұр.
Dialogue: 0,0:03:11.02,0:03:12.94,Default,,0,0,0,,Істейтін ештеңе қалмады
Dialogue: 0,0:03:14.02,0:03:17.40,Default,,0,0,0,,Реактивті түсіруді қалай жақсартуға болады...
Dialogue: 0,0:03:17.69,0:03:19.11,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:03:19.19,0:03:22.45,Default,,0,0,0,,Бұл пайдасыз. Не істесең де, мені жеңе алмайсың.
Dialogue: 0,0:03:27.04,0:03:29.58,Default,,0,0,0,,Не істеп жатырсың, Балто?
Dialogue: 0,0:03:29.66,0:03:30.83,Default,,0,0,0,,Өзінше
Dialogue: 0,0:03:30.91,0:03:33.29,Default,,0,0,0,,Мен қарсы тұрудың жолдарын ойлап жатырмын.
Dialogue: 0,0:03:33.63,0:03:35.13,Default,,0,0,0,,Ақан Ақан
Dialogue: 0,0:03:35.21,0:03:36.96,Default,,0,0,0,,Ойланып қарасаңыз, уайымдамаңыз
Dialogue: 0,0:03:37.05,0:03:39.17,Default,,0,0,0,,Бұл поп болады.
Dialogue: 0,0:03:39.26,0:03:42.18,Default,,0,0,0,,Валь-ни Валькириден сұрап тұр.
Dialogue: 0,0:03:42.26,0:03:45.30,Default,,0,0,0,,Валькири ағама айт.
Dialogue: 0,0:03:45.60,0:03:47.81,Default,,0,0,0,,Сіз оны табасыз.
Dialogue: 0,0:03:48.56,0:03:49.81,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:03:50.98,0:03:52.94,Default,,0,0,0,,Сіз не істер едіңіз?
Dialogue: 0,0:03:53.02,0:03:54.19,Default,,0,0,0,,Валькирия
Dialogue: 0,0:03:55.73,0:03:56.98,Default,,0,0,0,,Валькирия…
Dialogue: 0,0:04:07.95,0:04:10.50,Default,,0,0,0,,Ай!
Dialogue: 0,0:04:24.38,0:04:26.34,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:04:28.01,0:04:28.93,Default,,0,0,0,,Үш
Dialogue: 0,0:04:29.31,0:04:30.31,Default,,0,0,0,,Екі
Dialogue: 0,0:04:31.06,0:04:31.98,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:04:32.31,0:04:33.10,Default,,0,0,0,,Міне!
Dialogue: 0,0:04:33.52,0:04:36.98,Default,,0,0,0,,Не! Аои Балт ұшып кетті
Dialogue: 0,0:04:37.98,0:04:40.61,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:40.69,0:04:41.86,Default,,0,0,0,,Urya!
Dialogue: 0,0:04:47.41,0:04:49.12,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:04:49.58,0:04:51.66,Default,,0,0,0,,Валькири соққысы
Dialogue: 0,0:04:51.74,0:04:53.79,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:04:53.87,0:04:57.38,Default,,0,0,0,,Ұшатын шабуыл! Және қайтадан ұшыңыз!
Dialogue: 0,0:04:57.92,0:04:59.00,Default,,0,0,0,,Не!
Dialogue: 0,0:04:59.21,0:05:01.21,Default,,0,0,0,,Валькири шабуылы!
Dialogue: 0,0:05:01.42,0:05:04.59,Default,,0,0,0,,Тағы бір сүңгуір шабуыл!
Dialogue: 0,0:05:05.09,0:05:06.43,Default,,0,0,0,,Шешім қайтадан қабылданды!
Dialogue: 0,0:05:06.51,0:05:08.72,Default,,0,0,0,,Ол сондай-ақ реактивті түсірілімге айналды.
Dialogue: 0,0:05:09.05,0:05:10.60,Default,,0,0,0,,Лонгинусқа шабуыл
Dialogue: 0,0:05:15.27,0:05:18.31,Default,,0,0,0,,Лонгинус жалтарып кетті
Dialogue: 0,0:05:20.61,0:05:22.82,Default,,0,0,0,,Валькири бас тартқан жоқ
Dialogue: 0,0:05:24.69,0:05:26.86,Default,,0,0,0,,Жүгіру! Валькирия!
Dialogue: 0,0:05:26.95,0:05:30.41,Default,,0,0,0,,Валькири Бұл керемет жылдамдық.
Dialogue: 0,0:05:37.54,0:05:39.88,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:05:43.09,0:05:45.13,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:05:47.38,0:05:49.59,Default,,0,0,0,,Жүр!
Dialogue: 0,0:05:49.68,0:05:52.72,Default,,0,0,0,,Нағыз реактивті ату!
Dialogue: 0,0:05:58.90,0:06:00.98,Default,,0,0,0,,Бұл апатқа ұшырады!
Dialogue: 0,0:06:01.06,0:06:03.32,Default,,0,0,0,,Екеуі де ұшып кетті!
Dialogue: 0,0:06:03.40,0:06:04.61,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:06:04.86,0:06:05.61,Default,,0,0,0,,Не!
Dialogue: 0,0:06:05.69,0:06:08.15,Default,,0,0,0,,Жарылыс! Лонгинус жарылды!
Dialogue: 0,0:06:08.24,0:06:10.78,Default,,0,0,0,,Бұл бір сәт болды, бірақ жарылу тез болды!
Dialogue: 0,0:06:10.87,0:06:12.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:12.53,0:06:13.95,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:06:14.29,0:06:17.08,Default,,0,0,0,,Жеңіс Valkyrie Burst Finish
Dialogue: 0,0:06:17.16,0:06:18.46,Default,,0,0,0,,2-2 тармақтар
Dialogue: 0,0:06:19.42,0:06:21.79,Default,,0,0,0,,Мен оны алдым...
Dialogue: 0,0:06:21.88,0:06:23.09,Default,,0,0,0,,Жарылыс
Dialogue: 0,0:06:24.09,0:06:25.34,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:06:26.09,0:06:28.72,Default,,0,0,0,,Ку~ Түсіндім!
Dialogue: 0,0:06:29.05,0:06:31.64,Default,,0,0,0,,Ол ұшып кетті, Балто.
Dialogue: 0,0:06:31.72,0:06:33.76,Default,,0,0,0,,ұшты ұшты
Dialogue: 0,0:06:33.85,0:06:35.60,Default,,0,0,0,,Бұл аймақ
Dialogue: 0,0:06:35.68,0:06:37.81,Default,,0,0,0,,Бұл жай ғана тәжірибе.
Dialogue: 0,0:06:38.35,0:06:40.31,Default,,0,0,0,,Балто ес-түссіз ұшты.
Dialogue: 0,0:06:41.27,0:06:42.90,Default,,0,0,0,,Амбили~Бабо
Dialogue: 0,0:06:43.27,0:06:45.36,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:06:45.44,0:06:47.65,Default,,0,0,0,,Мен сізге бір ғажайып нәрсе көрсетемін!
Dialogue: 0,0:06:47.74,0:06:48.65,Default,,0,0,0,,Балто!
Dialogue: 0,0:06:48.90,0:06:51.20,Default,,0,0,0,,Бұл қазір қандай ату?
Dialogue: 0,0:06:51.28,0:06:53.12,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:06:53.20,0:06:54.74,Default,,0,0,0,,Әңгімелесу
Dialogue: 0,0:06:54.83,0:06:56.20,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:06:56.29,0:06:57.95,Default,,0,0,0,,Бауырыңнан сұра
Dialogue: 0,0:06:58.04,0:06:59.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:59.12,0:07:00.50,Default,,0,0,0,,Бар-нии-чан
Dialogue: 0,0:07:02.38,0:07:04.13,Default,,0,0,0,,Сіздің қазіргі кадрыңыз қандай?
Dialogue: 0,0:07:10.93,0:07:13.47,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,0:07:13.55,0:07:14.68,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:07:15.14,0:07:17.64,Default,,0,0,0,,Мына жігіт оны ес-түссіз босатып жіберді ме?
Dialogue: 0,0:07:18.81,0:07:20.60,Default,,0,0,0,,Бұл керемет, мен.
Dialogue: 0,0:07:21.10,0:07:23.10,Default,,0,0,0,,Қайтадан алданып қалма.
Dialogue: 0,0:07:23.44,0:07:25.98,Default,,0,0,0,,Эй, қазіргі түсірілімді ата.
Dialogue: 0,0:07:26.07,0:07:27.48,Default,,0,0,0,,Оған ат беріңіз!
Dialogue: 0,0:07:27.90,0:07:30.24,Default,,0,0,0,,Олай болса, Ирука... О, жоқ.
Dialogue: 0,0:07:30.32,0:07:31.74,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:32.32,0:07:33.49,Default,,0,0,0,,Биіктікке секіру…
Dialogue: 0,0:07:34.24,0:07:35.87,Default,,0,0,0,,Биіктікке секіру!
Dialogue: 0,0:07:36.24,0:07:39.00,Default,,0,0,0,,Мен биіктікке секіруден оқ алдым!
Dialogue: 0,0:07:39.41,0:07:40.71,Default,,0,0,0,,Шу!
Dialogue: 0,0:07:41.83,0:07:43.92,Default,,0,0,0,,Эй, Луис, біз жеттік.
Dialogue: 0,0:07:44.92,0:07:46.00,Default,,0,0,0,,Қызықты
Dialogue: 0,0:07:46.79,0:07:48.75,Default,,0,0,0,,Хухахахаха
Dialogue: 0,0:07:49.17,0:07:51.26,Default,,0,0,0,,Луи жымиып тұр
Dialogue: 0,0:07:51.59,0:07:53.59,Default,,0,0,0,,Ұпайлар алынса да
Dialogue: 0,0:07:53.76,0:07:55.64,Default,,0,0,0,,Әлі де орын бар.
Dialogue: 0,0:07:55.85,0:07:56.68,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:57.22,0:07:59.93,Default,,0,0,0,,Луи оны шындап басып тастамақшы.
Dialogue: 0,0:08:00.77,0:08:01.93,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:08:02.64,0:08:04.44,Default,,0,0,0,,Аз ғана уақыт Уақыт
Dialogue: 0,0:08:04.52,0:08:05.73,Default,,0,0,0,,Маған әжетханаға баруға рұқсат етіңіз
Dialogue: 0,0:08:05.94,0:08:06.90,Default,,0,0,0,,Күту уақыты
Dialogue: 0,0:08:08.40,0:08:09.57,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:19.37,0:08:20.95,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:21.04,0:08:22.71,Default,,0,0,0,,жансыз
Dialogue: 0,0:08:23.25,0:08:25.17,Default,,0,0,0,,Фу Фу
Dialogue: 0,0:08:25.25,0:08:27.25,Default,,0,0,0,,Сіз қонған кезде жасадыңыз.
Dialogue: 0,0:08:27.92,0:08:29.34,Default,,0,0,0,,Шу
Dialogue: 0,0:08:30.55,0:08:33.09,Default,,0,0,0,,Бұл орынсыз болғандықтан, осымен суытайық.
Dialogue: 0,0:08:33.72,0:08:34.55,Default,,0,0,0,,Чибети!
Dialogue: 0,0:08:34.63,0:08:37.09,Default,,0,0,0,,Бұл анық. Бұл ауырады ма?
Dialogue: 0,0:08:37.93,0:08:39.68,Default,,0,0,0,,Мен аздап ұйып қалдым.
Dialogue: 0,0:08:39.76,0:08:41.52,Default,,0,0,0,,Сіз үлкен шымшусыз.
Dialogue: 0,0:08:44.44,0:08:45.39,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:08:47.61,0:08:49.65,Default,,0,0,0,,Балто, мынаны ал.
Dialogue: 0,0:08:55.57,0:08:56.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:57.28,0:08:59.45,Default,,0,0,0,,Бұл өте жансыз, солай емес пе?
Dialogue: 0,0:08:59.53,0:09:01.12,Default,,0,0,0,,Сіз қобалжыдыңыз ба?
Dialogue: 0,0:09:01.20,0:09:02.08,Default,,0,0,0,,Барт…
Dialogue: 0,0:09:02.58,0:09:05.16,Default,,0,0,0,,Осы арқылы қосқышты түзете алмайсыз.
Dialogue: 0,0:09:05.25,0:09:06.75,Default,,0,0,0,,Басқару маңызды
Dialogue: 0,0:09:07.67,0:09:09.25,Default,,0,0,0,,Осылай жүре берсек, ұтамыз.
Dialogue: 0,0:09:09.34,0:09:10.46,Default,,0,0,0,,Вакия
Dialogue: 0,0:09:10.55,0:09:12.26,Default,,0,0,0,,Әй, олай айтпа!
Dialogue: 0,0:09:12.34,0:09:14.47,Default,,0,0,0,,Мен тек шындықты айтып тұрмын.
Dialogue: 0,0:09:14.59,0:09:16.63,Default,,0,0,0,,Менің ойымша, мұны айтудың жақсы жолы бар.
Dialogue: 0,0:09:17.05,0:09:18.55,Default,,0,0,0,,Екеуің де тоқтаңдар.
Dialogue: 0,0:09:18.68,0:09:19.47,Default,,0,0,0,,Хой
Dialogue: 0,0:09:19.55,0:09:20.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:20.14,0:09:20.76,Default,,0,0,0,,Хой
Dialogue: 0,0:09:20.85,0:09:21.39,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:09:21.47,0:09:22.81,Default,,0,0,0,,Чибетат!
Dialogue: 0,0:09:23.02,0:09:24.31,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:24.89,0:09:26.52,Default,,0,0,0,,Күн тым ыстық.
Dialogue: 0,0:09:26.85,0:09:27.77,Default,,0,0,0,,Барт
Dialogue: 0,0:09:27.85,0:09:28.81,Default,,0,0,0,,Сіз...
Dialogue: 0,0:09:29.27,0:09:31.07,Default,,0,0,0,,Мен болсам, жақсы боламын.
Dialogue: 0,0:09:31.15,0:09:31.90,Default,,0,0,0,,Иә
Dialogue: 0,0:09:31.98,0:09:32.78,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:09:32.86,0:09:33.86,Default,,0,0,0,,Нихихи…
Dialogue: 0,0:09:34.94,0:09:36.61,Default,,0,0,0,,Тістеуден құтылдың ба?
Dialogue: 0,0:09:36.82,0:09:40.28,Default,,0,0,0,,А, қалғандарына рахмет, мен қазірдің өзінде қыжылдап жатырмын.
Dialogue: 0,0:09:41.03,0:09:43.49,Default,,0,0,0,,Мазалағандарыңызға рахмет.
Dialogue: 0,0:09:43.79,0:09:44.83,Default,,0,0,0,,(жеңілдік күлкі)
Dialogue: 0,0:09:44.91,0:09:46.46,Default,,0,0,0,,Мен уайымдап ақша жоғалттым.
Dialogue: 0,0:09:46.79,0:09:48.87,Default,,0,0,0,,Маған тағы бір оқ беріңіз.
Dialogue: 0,0:09:49.50,0:09:50.25,Default,,0,0,0,,О!
Dialogue: 0,0:09:50.67,0:09:51.71,Default,,0,0,0,,Шешіңіз!
Dialogue: 0,0:09:52.34,0:09:53.13,Default,,0,0,0,,О!
Dialogue: 0,0:09:53.46,0:09:55.09,Default,,0,0,0,,Рухпен жеңілме
Dialogue: 0,0:09:55.88,0:09:57.01,Default,,0,0,0,,Бірақ ол күн астында жүгіре алмады
Dialogue: 0,0:09:57.63,0:09:59.05,Default,,0,0,0,,Маған бар күшіңді көрсет
Dialogue: 0,0:09:59.39,0:10:00.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:00.89,0:10:02.93,Default,,0,0,0,,Барлығыңызды және Валькириді шығарып алыңыз.
Dialogue: 0,0:10:03.51,0:10:04.77,Default,,0,0,0,,Әрине.
Dialogue: 0,0:10:13.32,0:10:14.86,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:10:15.94,0:10:16.82,Default,,0,0,0,,Луис
Dialogue: 0,0:10:18.36,0:10:19.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:20.87,0:10:22.70,Default,,0,0,0,,Емдеу аяқталды ма?
Dialogue: 0,0:10:22.78,0:10:24.91,Default,,0,0,0,,Е, сен қайдан білесің?
Dialogue: 0,0:10:24.99,0:10:25.79,Default,,0,0,0,,№~
Dialogue: 0,0:10:25.87,0:10:27.58,Default,,0,0,0,,Уккукуку…
Dialogue: 0,0:10:27.83,0:10:30.58,Default,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,0:10:30.83,0:10:31.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:32.04,0:10:33.92,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:10:38.22,0:10:39.05,Default,,0,0,0,,Даа!
Dialogue: 0,0:10:39.13,0:10:39.84,Default,,0,0,0,,Хмф!
Dialogue: 0,0:10:44.60,0:10:48.43,Default,,0,0,0,,Хмф, жарақат алған қарсыласты жеңу қызықсыз.
Dialogue: 0,0:10:51.73,0:10:53.86,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:54.27,0:10:55.19,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:10:55.27,0:10:57.90,Default,,0,0,0,,Екеуің шайқас сахнасына қайта оралдыңдар.
Dialogue: 0,0:10:57.99,0:10:59.95,Default,,0,0,0,,Енді сергіп қалдың, келіңдер!
Dialogue: 0,0:11:00.03,0:11:02.16,Default,,0,0,0,,Ойын қайта басталады.
Dialogue: 0,0:11:02.53,0:11:03.62,Default,,0,0,0,,Барт
Dialogue: 0,0:11:04.16,0:11:06.04,Default,,0,0,0,,Мен жақсы дедім.
Dialogue: 0,0:11:06.12,0:11:08.00,Default,,0,0,0,,Кейбір зиянды әсерлер болуы керек.
Dialogue: 0,0:11:08.08,0:11:09.54,Default,,0,0,0,,Жоқ, бұл маңызды емес.
Dialogue: 0,0:11:09.71,0:11:11.00,Default,,0,0,0,,Мұнда тағы бір ату
Dialogue: 0,0:11:11.08,0:11:12.58,Default,,0,0,0,,Бұл биіктікке секіру.
Dialogue: 0,0:11:12.67,0:11:15.67,Default,,0,0,0,,Бұл әдісті Балто бейсаналық түрде орындаған.
Dialogue: 0,0:11:15.75,0:11:18.05,Default,,0,0,0,,Оны білген бойда қиын болады.
Dialogue: 0,0:11:18.13,0:11:21.18,Default,,0,0,0,,Бакусу Шотпен де солай болды.
Dialogue: 0,0:11:21.34,0:11:23.22,Default,,0,0,0,,Сонда не істеуіміз керек?
Dialogue: 0,0:11:23.30,0:11:26.47,Default,,0,0,0,,Егер Балто аймаққа қайтадан кіре алса
Dialogue: 0,0:11:26.64,0:11:29.10,Default,,0,0,0,,Бауырым! Концентрат концентрат!
Dialogue: 0,0:11:29.18,0:11:30.98,Default,,0,0,0,,Балт Өз жігеріңді көрсет!
Dialogue: 0,0:11:31.06,0:11:32.81,Default,,0,0,0,,Барынша тырысыңыз!
Dialogue: 0,0:11:32.90,0:11:34.73,Default,,0,0,0,,Толық қуат Толық қуат!
Dialogue: 0,0:11:35.06,0:11:39.15,Default,,0,0,0,,Хаха~ Биіктікке секіру үшін тағы бір оқ атар едім.
Dialogue: 0,0:11:39.24,0:11:40.74,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:11:41.49,0:11:42.36,Default,,0,0,0,,Барт
Dialogue: 0,0:11:42.45,0:11:44.45,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:11:46.95,0:11:49.20,Default,,0,0,0,,Мен не қажет болса да істеймін
Dialogue: 0,0:11:51.21,0:11:52.75,Default,,0,0,0,,Жақсы! Мен бара аламын
Dialogue: 0,0:11:54.13,0:11:55.75,Default,,0,0,0,,Жасайық досым
Dialogue: 0,0:11:56.17,0:11:58.67,Default,,0,0,0,,Сіз концентрацияңызды одан әрі жақсартыңыз.
Dialogue: 0,0:12:02.43,0:12:05.05,Default,,0,0,0,,Ху... Лонгинус бақытты.
Dialogue: 0,0:12:05.43,0:12:07.81,Default,,0,0,0,,Хухахахаха
Dialogue: 0,0:12:07.89,0:12:08.76,Default,,0,0,0,,Ах
Dialogue: 0,0:12:08.97,0:12:11.52,Default,,0,0,0,,Барто Аои Мен сені мақтаймын
Dialogue: 0,0:12:11.98,0:12:13.35,Default,,0,0,0,,Менің Лонгинусым
Dialogue: 0,0:12:13.44,0:12:15.23,Default,,0,0,0,,Мені сонша бақытты ететін не?
Dialogue: 0,0:12:17.44,0:12:19.69,Default,,0,0,0,,Валькири де өте бақытты.
Dialogue: 0,0:12:20.15,0:12:22.99,Default,,0,0,0,,(Джозефтің ауыр демі)
Dialogue: 0,0:12:23.07,0:12:25.78,Default,,0,0,0,,Міне, мен бұл шығанақтың күшін сонша шығардым.
Dialogue: 0,0:12:26.32,0:12:29.20,Default,,0,0,0,,Мен Валькирияның күшін шығарған жоқпын.
Dialogue: 0,0:12:29.41,0:12:31.95,Default,,0,0,0,,Валькири менің күшімді шығарды.
Dialogue: 0,0:12:32.20,0:12:34.62,Default,,0,0,0,,Ха... бірақ бәрі осы.
Dialogue: 0,0:12:34.83,0:12:37.04,Default,,0,0,0,,Мен оны толығымен талқандаймын.
Dialogue: 0,0:12:37.25,0:12:39.00,Default,,0,0,0,,Ол жаншып кете ме?
Dialogue: 0,0:12:39.50,0:12:40.96,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:12:48.39,0:12:49.93,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:12:50.43,0:12:52.14,Default,,0,0,0,,Кеттік, Валькири
Dialogue: 0,0:12:59.02,0:13:01.36,Default,,0,0,0,,Бұл қызық, досым.
Dialogue: 0,0:13:04.78,0:13:06.53,Default,,0,0,0,,Жарайды, сіз аймақтасыз.
Dialogue: 0,0:13:06.61,0:13:08.16,Default,,0,0,0,,Келді, келді, келді.
Dialogue: 0,0:13:10.91,0:13:11.99,Default,,0,0,0,,Иә, солай сияқты.
Dialogue: 0,0:13:12.08,0:13:12.95,Default,,0,0,0,,Бұл не? Мен байланғанмын.
Dialogue: 0,0:13:13.04,0:13:15.00,Default,,0,0,0,,Бар, Балто!
Dialogue: 0,0:13:15.21,0:13:17.00,Default,,0,0,0,,Менің жүрегім ауырады
Dialogue: 0,0:13:18.17,0:13:19.34,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:13:19.50,0:13:22.05,Default,,0,0,0,,Сіз мені өртеп жібересіз бе?
Dialogue: 0,0:13:22.38,0:13:25.59,Default,,0,0,0,,Енді екеуің ату жағдайына келіңдер.
Dialogue: 0,0:13:25.93,0:13:27.22,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:13:27.30,0:13:29.05,Default,,0,0,0,,Түнгі түсірілім
Dialogue: 0,0:13:29.14,0:13:31.93,Default,,0,0,0,,Барто Аои - керемет кадр
Dialogue: 0,0:13:34.31,0:13:35.35,Default,,0,0,0,,Ой, не?
Dialogue: 0,0:13:35.43,0:13:38.23,Default,,0,0,0,,Барто Аои... А... А? Өтірік
Dialogue: 0,0:13:38.31,0:13:41.02,Default,,0,0,0,,Әрі қарай артқа қарай
Dialogue: 0,0:13:41.11,0:13:45.15,Default,,0,0,0,,Бұл жылдамдықты одан да арттырады!
Dialogue: 0,0:14:00.83,0:14:02.63,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:14:04.55,0:14:05.59,Default,,0,0,0,,Үш
Dialogue: 0,0:14:06.67,0:14:07.68,Default,,0,0,0,,Екі
Dialogue: 0,0:14:08.43,0:14:09.51,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:14:09.84,0:14:12.30,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:12.39,0:14:13.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:19.94,0:14:22.77,Default,,0,0,0,,Стадионда екі шығанақ пайда болды
Dialogue: 0,0:14:22.86,0:14:26.28,Default,,0,0,0,,Бір таңқаларлығы, стадион соғудан жарылып кетті.
Dialogue: 0,0:14:26.61,0:14:27.78,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:14:28.24,0:14:29.53,Default,,0,0,0,,Лонгинус!
Dialogue: 0,0:14:29.61,0:14:31.28,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:14:31.37,0:14:34.03,Default,,0,0,0,,Екі шығанақ ауада соқтығысады
Dialogue: 0,0:14:46.76,0:14:49.30,Default,,0,0,0,,Стадионға соғылды
Dialogue: 0,0:14:49.38,0:14:51.09,Default,,0,0,0,,Әй, бұл не?
Dialogue: 0,0:14:51.18,0:14:53.60,Default,,0,0,0,,Валькиридің қалпы бүгілген.
Dialogue: 0,0:14:53.93,0:14:55.01,Default,,0,0,0,,Алыңыз!
Dialogue: 0,0:14:55.72,0:14:58.35,Default,,0,0,0,,Валькири қайта салынды
Dialogue: 0,0:14:58.43,0:14:59.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:59.60,0:15:02.06,Default,,0,0,0,,Бұл матчта не болады?
Dialogue: 0,0:15:02.98,0:15:04.73,Default,,0,0,0,,Лонгинусты бұзыңыз!
Dialogue: 0,0:15:05.07,0:15:07.48,Default,,0,0,0,,Лонгинус шабуылдары
Dialogue: 0,0:15:07.57,0:15:08.44,Default,,0,0,0,,Валькирия
Dialogue: 0,0:15:08.53,0:15:11.20,Default,,0,0,0,,Шынайы флэш түсіру!
Dialogue: 0,0:15:13.53,0:15:15.58,Default,,0,0,0,,Валькириден қашты
Dialogue: 0,0:15:16.49,0:15:17.33,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:17.41,0:15:18.50,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:15:18.58,0:15:20.04,Default,,0,0,0,,Кеттік, Балто.
Dialogue: 0,0:15:20.25,0:15:21.71,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:15:22.17,0:15:25.50,Default,,0,0,0,,Жүр!
Dialogue: 0,0:15:27.50,0:15:29.72,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:15:31.51,0:15:33.76,Default,,0,0,0,,Валькиридің қарсы шабуылы!
Dialogue: 0,0:15:33.84,0:15:36.35,Default,,0,0,0,,Лонгинусқа шабуыл
Dialogue: 0,0:15:36.68,0:15:38.68,Default,,0,0,0,,Лонгинус!
Dialogue: 0,0:15:42.35,0:15:44.27,Default,,0,0,0,,(айқай)
Dialogue: 0,0:15:44.36,0:15:46.61,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:15:52.15,0:15:54.99,Default,,0,0,0,,Лонгинус мұны да жоғары бағалады.
Dialogue: 0,0:15:57.58,0:16:00.37,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:16:05.79,0:16:07.96,Default,,0,0,0,,Екеуі де екпінін қоя алмайды
Dialogue: 0,0:16:08.05,0:16:10.63,Default,,0,0,0,,Бұл өлімге әкелетін шайқас. Бұл шайқас қанша уақытқа созылады?
Dialogue: 0,0:16:12.68,0:16:14.84,Default,,0,0,0,,Лонгинус әлі де жүгіре ала ма?
Dialogue: 0,0:16:14.93,0:16:15.72,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:16:15.80,0:16:17.35,Default,,0,0,0,,Валькири әлі де...
Dialogue: 0,0:16:17.43,0:16:18.26,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:18.43,0:16:19.60,Default,,0,0,0,,Дерлік
Dialogue: 0,0:16:19.68,0:16:20.64,Default,,0,0,0,,Балто!
Dialogue: 0,0:16:20.98,0:16:22.02,Default,,0,0,0,,Жабыңыз!
Dialogue: 0,0:16:22.10,0:16:23.64,Default,,0,0,0,,Балтоны жеңіңіз!
Dialogue: 0,0:16:23.89,0:16:24.56,Default,,0,0,0,,Луи!
Dialogue: 0,0:16:24.65,0:16:25.48,Default,,0,0,0,,Луис мырза!
Dialogue: 0,0:16:27.73,0:16:31.69,Default,,0,0,0,,Содан кейін Валькири мен Лонгинус соқтығысады.
Dialogue: 0,0:16:35.24,0:16:37.07,Default,,0,0,0,,Жарып өт, Валькири!
Dialogue: 0,0:16:37.37,0:16:39.45,Default,,0,0,0,,Оны ұсақтап таста, Лонгинус!
Dialogue: 0,0:16:46.08,0:16:48.46,Default,,0,0,0,,Менің жаным… Ұйықтар алдында әр түн сайын➡
Dialogue: 0,0:16:48.54,0:16:50.59,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:16:51.38,0:16:53.67,Default,,0,0,0,,Тағы да кет! Апыр-ай!
Dialogue: 0,0:16:53.76,0:16:55.97,Default,,0,0,0,,Лонгинус Импульс жоқ.
Dialogue: 0,0:16:56.43,0:16:57.39,Default,,0,0,0,,Не?
Dialogue: 0,0:16:57.68,0:16:59.56,Default,,0,0,0,,Валькири туралы не деуге болады?
Dialogue: 0,0:16:59.76,0:17:01.43,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:01.52,0:17:03.48,Default,,0,0,0,,Сізде әлі біраз күш бар сияқты!
Dialogue: 0,0:17:03.56,0:17:05.14,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:17:05.23,0:17:06.35,Default,,0,0,0,,Жүр!
Dialogue: 0,0:17:06.44,0:17:07.44,Default,,0,0,0,,Луи!
Dialogue: 0,0:17:08.02,0:17:10.69,Default,,0,0,0,,Валькирия! Толық қуат!
Dialogue: 0,0:17:13.36,0:17:15.03,Default,,0,0,0,,Әлі жоқ, Лонгинус!
Dialogue: 0,0:17:15.40,0:17:16.86,Default,,0,0,0,,Жеңіңіз!
Dialogue: 0,0:17:20.58,0:17:22.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:27.96,0:17:29.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:45.48,0:17:47.64,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:17:47.85,0:17:51.27,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:17:51.73,0:17:54.40,Default,,0,0,0,,Шайқас ақыры аяқталды!
Dialogue: 0,0:17:54.49,0:17:59.32,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:00.16,0:18:03.37,Default,,0,0,0,,Лонгинус 2 ұпайдан айырылды
Dialogue: 0,0:18:03.70,0:18:05.83,Default,,0,0,0,,Финалдық матч 4:2 болды.
Dialogue: 0,0:18:06.08,0:18:08.29,Default,,0,0,0,,Руи Ширасагидің жеңісі
Dialogue: 0,0:18:08.37,0:18:09.71,Default,,0,0,0,,Жеңімпаз
Dialogue: 0,0:18:09.79,0:18:11.59,Default,,0,0,0,,Бұл Ширасадиджо Луи.
Dialogue: 0,0:18:11.67,0:18:14.59,Default,,0,0,0,,Валькири абсолютті чемпионды шегіне дейін бұрыштамаға салды
Dialogue: 0,0:18:14.96,0:18:16.55,Default,,0,0,0,,Бірақ соңында
Dialogue: 0,0:18:16.63,0:18:19.38,Default,,0,0,0,,Стадионға салған тыртықтарына сүріну
Dialogue: 0,0:18:19.47,0:18:20.93,Default,,0,0,0,,Ол жарылып кетті.
Dialogue: 0,0:18:21.26,0:18:23.72,Default,,0,0,0,,Сол кезде Аой Балттың қолынан
Dialogue: 0,0:18:23.81,0:18:26.10,Default,,0,0,0,,Жеңіске жетіп, Жеңіс шықты
Dialogue: 0,0:18:26.18,0:18:27.35,Default,,0,0,0,,қашып кетті
Dialogue: 0,0:18:30.02,0:18:35.44,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:18:35.53,0:18:37.82,Default,,0,0,0,,Уау, Балто!
Dialogue: 0,0:18:37.95,0:18:39.86,Default,,0,0,0,,(Балтоның айқайы)
Dialogue: 0,0:18:42.49,0:18:47.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:52.46,0:18:54.13,Default,,0,0,0,,Тағы бір шайқас!
Dialogue: 0,0:18:54.34,0:18:55.88,Default,,0,0,0,,Ах... Луи
Dialogue: 0,0:18:56.38,0:18:58.09,Default,,0,0,0,,Бірақ... сіз
Dialogue: 0,0:18:58.59,0:19:01.22,Default,,0,0,0,,Менің жеңісімді кездейсоқ шешті.
Dialogue: 0,0:19:01.30,0:19:02.59,Default,,0,0,0,,Мен оларды кешіре алмаймын!
Dialogue: 0,0:19:07.77,0:19:09.27,Default,,0,0,0,,Жеңілу - жеңілу
Dialogue: 0,0:19:10.19,0:19:11.60,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:19:12.94,0:19:16.02,Default,,0,0,0,,Луи, сен шынымен мықтысың.
Dialogue: 0,0:19:16.19,0:19:17.07,Default,,0,0,0,,Хун
Dialogue: 0,0:19:17.15,0:19:19.90,Default,,0,0,0,,Бірақ келесі жолы мен міндетті түрде жеңемін!
Dialogue: 0,0:19:19.99,0:19:22.57,Default,,0,0,0,,Сіз мені ешқашан жеңе алмайсыз
Dialogue: 0,0:19:22.95,0:19:24.37,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:19:24.70,0:19:26.66,Default,,0,0,0,,Болашақ шешілді
Dialogue: 0,0:19:26.74,0:19:31.21,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:19:31.87,0:19:33.38,Default,,0,0,0,,Шешілмеген!
Dialogue: 0,0:19:34.13,0:19:35.00,Default,,0,0,0,,Иә
Dialogue: 0,0:19:38.67,0:19:41.01,Default,,0,0,0,,Кім шыңға жетті?
Dialogue: 0,0:19:41.09,0:19:43.47,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:19:43.55,0:19:45.05,Default,,0,0,0,,Бұрын-соңды болмаған 5 қатарынан жеңіс
Dialogue: 0,0:19:45.14,0:19:46.47,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:19:50.56,0:19:52.81,Default,,0,0,0,,Рахмет досым
Dialogue: 0,0:19:56.52,0:19:57.65,Default,,0,0,0,,Балто!
Dialogue: 0,0:19:57.73,0:19:59.90,Default,,0,0,0,,Кел, оян!
Dialogue: 0,0:20:01.20,0:20:03.03,Default,,0,0,0,,Менің ағам мұнда жоқ.
Dialogue: 0,0:20:03.11,0:20:05.53,Default,,0,0,0,,Бару-нии, менің ойымша, сен жаттығуға бардың.
Dialogue: 0,0:20:05.62,0:20:07.91,Default,,0,0,0,,Тойлау үшін нан пісіріп, қиналдым.
Dialogue: 0,0:20:10.20,0:20:12.12,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:20:13.67,0:20:16.00,Default,,0,0,0,,Қарның ашқанда қайтасың.
Dialogue: 0,0:20:16.21,0:20:18.59,Default,,0,0,0,,Денсаулық ең жақсы, жарайды, жарайды.
Dialogue: 0,0:20:25.26,0:20:26.76,Default,,0,0,0,,О...! Оссу!
Dialogue: 0,0:20:26.85,0:20:28.10,Default,,0,0,0,,Қарқыны баяу.
Dialogue: 0,0:20:28.64,0:20:30.47,Default,,0,0,0,,Ағам саған айтпады ма?
Dialogue: 0,0:20:30.93,0:20:32.18,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:20:33.19,0:20:36.10,Default,,0,0,0,,Жолдан кет! Жолдан кет!
Dialogue: 0,0:20:36.31,0:20:38.02,Default,,0,0,0,,Келіңдер, балалар!
Dialogue: 0,0:20:39.57,0:20:41.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:41.36,0:20:42.53,Default,,0,0,0,,Алдымен барайық!
Dialogue: 0,0:20:42.61,0:20:44.24,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:20:44.78,0:20:46.91,Default,,0,0,0,,Вакия Кумичо
Dialogue: 0,0:20:46.99,0:20:49.24,Default,,0,0,0,,Ал, мен жетемін!
Dialogue: 0,0:20:49.33,0:20:52.00,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:20:52.79,0:20:55.50,Default,,0,0,0,,Ха, мен тағы жеңілдім.
Dialogue: 0,0:20:55.58,0:20:57.75,Default,,0,0,0,,Бейбатлға тыйым салынған.
Dialogue: 0,0:20:57.83,0:20:59.00,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:21:01.30,0:21:02.26,Default,,0,0,0,,Ах
Dialogue: 0,0:21:02.34,0:21:05.09,Default,,0,0,0,,(Балто және басқалардың дауыстары)
Dialogue: 0,0:21:05.18,0:21:06.34,Default,,0,0,0,,Олар...
Dialogue: 0,0:21:06.43,0:21:08.10,Default,,0,0,0,,шығанақ клубының жиналысы?
Dialogue: 0,0:21:08.18,0:21:09.22,Default,,0,0,0,,Дұрыс, дұрыс.
Dialogue: 0,0:21:09.30,0:21:11.43,Default,,0,0,0,,Инсуке, сен де кел.
Dialogue: 0,0:21:11.52,0:21:12.52,Default,,0,0,0,,Иә
Dialogue: 0,0:21:12.60,0:21:14.14,Default,,0,0,0,,Кеттік, Инуске.
Dialogue: 0,0:21:14.73,0:21:16.06,Default,,0,0,0,,Біз де барайық
Dialogue: 0,0:21:16.56,0:21:20.40,Default,,0,0,0,,(Ұжымдық күрсіну)
Dialogue: 0,0:21:20.65,0:21:22.23,Default,,0,0,0,,Э-э, не істеп жатырсыз, мырза?
Dialogue: 0,0:21:22.32,0:21:24.61,Default,,0,0,0,,Не? Мен №1мін!
Dialogue: 0,0:21:24.70,0:21:26.11,Default,,0,0,0,,Вай я Вай!
Dialogue: 0,0:21:26.20,0:21:27.32,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:21:27.41,0:21:29.03,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:21:29.57,0:21:31.70,Default,,0,0,0,,Барлығы нан әкелді.
Dialogue: 0,0:21:31.83,0:21:33.29,Default,,0,0,0,,Бірінші тұлғадан.
Dialogue: 0,0:21:33.45,0:21:34.45,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:21:34.87,0:21:36.00,Default,,0,0,0,,Мен де!
Dialogue: 0,0:21:36.29,0:21:37.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:37.58,0:21:38.50,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:21:38.88,0:21:39.88,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:21:40.00,0:21:42.13,Default,,0,0,0,,Гяаах!
Dialogue: 0,0:21:42.63,0:21:43.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:43.84,0:21:44.72,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:21:47.84,0:21:51.10,Default,,0,0,0,,Мен біріншімін!
Dialogue: 0,0:22:09.61,0:22:15.70,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.91,0:22:22.04,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.50,0:22:28.05,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.51,0:22:31.85,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:32.01,0:22:36.93,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.85,0:22:41.56,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.65,0:22:44.86,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.94,0:22:51.28,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.53,0:22:57.08,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:57.25,0:23:03.84,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.42,0:23:09.84,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:10.01,0:23:13.18,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.68,0:23:17.64,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:19.14,0:23:25.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory