Dialogue: 0,0:10:57.19,0:10:59.78,Default,,0,0,0,,Тікелей эфир алдында
Dialogue: 0,0:11:02.53,0:11:03.18,Default,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:11:03.84,0:11:05.42,Default,,0,0,0,,Сізде жауапкершілік бар
Dialogue: 0,0:11:07.33,0:11:09.07,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз
Dialogue: 0,0:11:09.91,0:11:11.17,Default,,0,0,0,,Сізге ұнайтын әндер
Dialogue: 0,0:11:11.83,0:11:13.70,Default,,0,0,0,,Басынан бергі ең жақсы жанды орындау
Dialogue: 0,0:11:14.99,0:11:15.58,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:11:19.07,0:11:20.77,Default,,0,0,0,,Қазіргі уақытта
Dialogue: 0,0:11:21.26,0:11:21.81,Default,,0,0,0,,Сеніңше, қалай?
Dialogue: 0,0:11:22.29,0:11:23.60,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:11:23.94,0:11:26.31,Default,,0,0,0,,20 адам алдыңызда оңға және солға
Dialogue: 0,0:11:26.70,0:11:28.08,Default,,0,0,0,,10 адамды қайтару аяқталды
Dialogue: 0,0:11:28.44,0:11:31.45,Default,,0,0,0,,Билет ала аламын ба?
Dialogue: 0,0:11:32.66,0:11:34.48,Default,,0,0,0,,Қабылдау мерзіміне қатысты.
Dialogue: 0,0:11:34.65,0:11:40.21,Default,,0,0,0,,Дұрыс емес
Dialogue: 0,0:11:41.13,0:11:42.28,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:11:43.15,0:11:45.92,Default,,0,0,0,,Досыммен кездескен ең аз уақыт
Dialogue: 0,0:11:46.22,0:11:47.44,Default,,0,0,0,,...
Dialogue: 0,0:11:48.36,0:11:49.81,Default,,0,0,0,,Қарт Итақайдың келуі
Dialogue: 0,0:11:50.06,0:11:51.17,Default,,0,0,0,,Табиғи түрде аяқталды
Dialogue: 0,0:11:51.89,0:11:55.34,Default,,0,0,0,,Мен өз қауымдастығымды қолдаймын.
Dialogue: 0,0:11:56.17,0:11:58.38,Default,,0,0,0,,Дегенмен, егер сіз орынды көргіңіз келсе
Dialogue: 0,0:12:07.67,0:12:09.23,Default,,0,0,0,,...
Dialogue: 0,0:12:11.00,0:12:13.19,Default,,0,0,0,,Тікелей эфирде Нораи
Dialogue: 0,0:12:15.16,0:12:16.70,Default,,0,0,0,,Әлеуметтік аудан бірлестігі?
Dialogue: 0,0:12:17.54,0:12:20.75,Default,,0,0,0,,Басқа адамның теріс қылығы
Dialogue: 0,0:12:23.37,0:12:24.15,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:12:28.07,0:12:30.44,Default,,0,0,0,,Бүкіл армия жойылды
Dialogue: 0,0:12:44.75,0:12:46.48,Default,,0,0,0,,«Тұрақты жүреді!»
Dialogue: 0,0:12:47.97,0:12:50.78,Default,,0,0,0,,Үй иесі – шытырман оқиғаны бастайтын тәкаппар адам.
Dialogue: 0,0:12:52.52,0:12:53.49,Default,,0,0,0,,Зиян
Dialogue: 0,0:12:54.48,0:12:55.72,Default,,0,0,0,,Күтулер
Dialogue: 0,0:12:57.14,0:12:58.68,Default,,0,0,0,,Біз сізге дереу қызмет көрсету үшін бар күшімізді саламыз.
Dialogue: 0,0:12:59.27,0:13:01.71,Default,,0,0,0,,Кездесуге қолайлы уақыт.
Dialogue: 0,0:13:02.64,0:13:05.37,Default,,0,0,0,,Бірден жеткізу, сонымен қатар тұрақты сынақ
Dialogue: 0,0:13:07.08,0:13:08.89,Default,,0,0,0,,Іске қосу және босату мүмкін емес
Dialogue: 0,0:13:10.15,0:13:13.70,Default,,0,0,0,,Белгілі бір өкінішке бару керек.
Dialogue: 0,0:13:16.38,0:13:17.43,Default,,0,0,0,,Төменде қараңыз
Dialogue: 0,0:13:18.34,0:13:19.38,Default,,0,0,0,,Мен Аргонависпін.
Dialogue: 0,0:13:20.79,0:13:22.75,Default,,0,0,0,,...
Dialogue: 0,0:13:23.58,0:13:24.52,Default,,0,0,0,,Төменде қараңыз
Dialogue: 0,0:13:26.71,0:13:27.64,Default,,0,0,0,,Аргонавис
Dialogue: 0,0:13:28.06,0:13:30.97,Default,,0,0,0,,Аргонависке қараңыз
Dialogue: 0,0:13:33.01,0:13:33.74,Default,,0,0,0,,Төменде қараңыз
Dialogue: 0,0:13:34.58,0:13:36.96,Default,,0,0,0,,Бұл біздің алғашқы тікелей эфиріміз
Dialogue: 0,0:13:37.82,0:13:39.16,Default,,0,0,0,,Бару
Dialogue: 0,0:13:43.90,0:13:44.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:49.90,0:13:51.36,Default,,0,0,0,,Аргонавис
Dialogue: 0,0:13:53.44,0:13:54.71,Default,,0,0,0,,Сіз бөлмедесіз
Dialogue: 0,0:13:55.95,0:13:56.58,Default,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:13:57.14,0:13:59.54,Default,,0,0,0,,Бірінші сайт тікелей эфирде
Dialogue: 0,0:13:59.99,0:14:01.42,Default,,0,0,0,,Аспанды тыңдау
Dialogue: 0,0:14:06.92,0:14:08.45,Default,,0,0,0,,Жинақ
Dialogue: 0,0:14:27.79,0:14:29.57,Default,,0,0,0,,Қарауға оңай қол жеткізу
Dialogue: 0,0:14:30.11,0:14:30.76,Default,,0,0,0,,Қазірге дейін
Dialogue: 0,0:14:31.23,0:14:32.78,Default,,0,0,0,,Gate ойын-сауық агенті?
Dialogue: 0,0:14:33.78,0:14:34.94,Default,,0,0,0,,Гарайоу
Dialogue: 0,0:14:37.38,0:14:39.58,Default,,0,0,0,,Ойын-сауыққа бару
Dialogue: 0,0:14:40.28,0:14:41.65,Default,,0,0,0,,...
Dialogue: 0,0:14:44.79,0:14:45.93,Default,,0,0,0,,Ол шабуылын қалай бастайды екен?
Dialogue: 0,0:14:46.87,0:14:47.54,Default,,0,0,0,,Енді мен өз нұсқауларымды жеткіземін.
Dialogue: 0,0:14:50.25,0:14:50.86,Default,,0,0,0,,Келмейсіз бе?
Dialogue: 0,0:14:51.13,0:14:53.37,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:14:53.57,0:14:56.45,Default,,0,0,0,,Жөндеуші келгенше, мен бос емеспін.
Dialogue: 0,0:14:57.28,0:15:00.04,Default,,0,0,0,,Бұл жолмен жүру керек
Dialogue: 0,0:15:01.25,0:15:02.96,Default,,0,0,0,,Ескі тақта істен шықты ма?
Dialogue: 0,0:15:03.52,0:15:05.37,Default,,0,0,0,,...
Dialogue: 0,0:15:05.61,0:15:07.07,Default,,0,0,0,,Шынайы үміт және басқа қабілеттер
Dialogue: 0,0:15:09.70,0:15:10.45,Default,,0,0,0,,?
Dialogue: 0,0:15:11.85,0:15:14.59,Default,,0,0,0,,Қолайсыз мақтаныш сезімі
Dialogue: 0,0:15:20.54,0:15:22.38,Default,,0,0,0,,Сато Ярай аяқталмады.
Dialogue: 0,0:15:24.07,0:15:25.08,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:25.58,0:15:27.28,Default,,0,0,0,,Бастау үшін тікелей жұмыс қажет
Dialogue: 0,0:15:30.65,0:15:31.77,Default,,0,0,0,,Енді Полпо өлген соң, Буггарати әрекетке көшуі керек.
Dialogue: 0,0:15:33.06,0:15:34.26,Default,,0,0,0,,...
Dialogue: 0,0:15:37.81,0:15:39.07,Default,,0,0,0,,...
Dialogue: 0,0:15:39.32,0:15:41.45,Default,,0,0,0,,Бір адам келмеді
Dialogue: 0,0:15:43.00,0:15:48.35,Default,,0,0,0,,Дұрыс емес
Dialogue: 0,0:15:48.97,0:15:50.54,Default,,0,0,0,,Ескі тақтаның нұсқасы
Dialogue: 0,0:15:52.40,0:15:53.55,Default,,0,0,0,,...
Dialogue: 0,0:15:54.28,0:15:56.08,Default,,0,0,0,,Менің досым
Dialogue: 0,0:15:56.50,0:15:58.61,Default,,0,0,0,,Аспан жоғалып кетті.
Dialogue: 0,0:15:59.56,0:16:02.30,Default,,0,0,0,,Қолайсыз әңгіме болуы мүмкін.
Dialogue: 0,0:16:03.71,0:16:04.46,Default,,0,0,0,,?
Dialogue: 0,0:16:07.09,0:16:07.76,Default,,0,0,0,,Кешір мені.
Dialogue: 0,0:16:08.58,0:16:09.86,Default,,0,0,0,,Шынайы ақиқат
Dialogue: 0,0:16:10.31,0:16:11.93,Default,,0,0,0,,Тұрақты емес жиналысты өзгерту
Dialogue: 0,0:16:12.53,0:16:14.04,Default,,0,0,0,,Бұл сенің кінәң емес.
Dialogue: 0,0:16:14.60,0:16:16.28,Default,,0,0,0,,Менің де қолым бос емес.
Dialogue: 0,0:16:17.58,0:16:18.70,Default,,0,0,0,,Жоғалу
Dialogue: 0,0:16:19.94,0:16:22.62,Default,,0,0,0,,Менің соңғы әңгімем аз болды.
Dialogue: 0,0:16:23.58,0:16:25.67,Default,,0,0,0,,Үй иесі қазір үйден шығып жатыр.
Dialogue: 0,0:16:26.03,0:16:26.92,Default,,0,0,0,,?
Dialogue: 0,0:16:27.17,0:16:29.60,Default,,0,0,0,,Орындауға дейінгі мерзім
Dialogue: 0,0:16:29.60,0:16:30.97,Default,,0,0,0,,...
Dialogue: 0,0:16:30.97,0:16:33.53,Default,,0,0,0,,Тәубе беріп, алған соң өкінген жоқ.
Dialogue: 0,0:16:34.37,0:16:35.10,Default,,0,0,0,,...
Dialogue: 0,0:16:36.46,0:16:38.12,Default,,0,0,0,,Бар немесе мүмкін емес
Dialogue: 0,0:16:38.68,0:16:41.59,Default,,0,0,0,,Орыннан шыққанда, ол жерге жете аласыз.
Dialogue: 0,0:16:43.07,0:16:44.55,Default,,0,0,0,,Ширайшидің сатып алу бағасы
Dialogue: 0,0:16:45.18,0:16:45.74,Default,,0,0,0,,Эжектор
Dialogue: 0,0:16:46.95,0:16:48.27,Default,,0,0,0,,Сұрақтар мен жауаптар
Dialogue: 0,0:17:09.96,0:17:11.92,Default,,0,0,0,,Орындауды аяқтау уақыты
Dialogue: 0,0:17:12.39,0:17:14.39,Default,,0,0,0,,Ешкім келмеді
Dialogue: 0,0:17:17.32,0:17:18.49,Default,,0,0,0,,Бұл менің жауапкершілігім.
Dialogue: 0,0:17:20.17,0:17:22.04,Default,,0,0,0,,Салықтан алынатын салық
Dialogue: 0,0:17:22.81,0:17:23.69,Default,,0,0,0,,Гоцу
Dialogue: 0,0:17:23.98,0:17:24.92,Default,,0,0,0,,3-бөлім: Түрмедегі бандиттермен кездесу
Dialogue: 0,0:17:25.50,0:17:27.10,Default,,0,0,0,,Мен мұны елестете алмаймын.
Dialogue: 0,0:17:27.76,0:17:29.09,Default,,0,0,0,,Иә, мен.
Dialogue: 0,0:17:30.56,0:17:31.77,Default,,0,0,0,,Не айту керек
Dialogue: 0,0:17:33.37,0:17:36.05,Default,,0,0,0,,Қожайын пікірінің түйінді ойлары
Dialogue: 0,0:17:36.76,0:17:39.34,Default,,0,0,0,,Сондықтан бұл үй иесінің жауапкершілігі.
Dialogue: 0,0:17:40.41,0:17:41.36,Default,,0,0,0,,Саяхат
Dialogue: 0,0:17:42.19,0:17:45.69,Default,,0,0,0,,Қазіргі қасірет туралы естеліктер
Dialogue: 0,0:17:46.70,0:17:48.59,Default,,0,0,0,,...
Dialogue: 0,0:17:50.80,0:17:51.56,Default,,0,0,0,,Сіз осындасыз
Dialogue: 0,0:17:56.10,0:17:59.15,Default,,0,0,0,,Аргонавистің тікелей басталуы
Dialogue: 0,0:17:59.67,0:18:03.19,Default,,0,0,0,,Тікелей эфирден бас тарту қажет...
Dialogue: 0,0:18:03.44,0:18:05.95,Default,,0,0,0,,Live
Dialogue: 0,0:18:07.76,0:18:10.38,Default,,0,0,0,,Тек бір адам басқа адамды көре алады.
Dialogue: 0,0:18:11.87,0:18:14.94,Default,,0,0,0,,Үміт жырлары және басқа өлеңдер
Dialogue: 0,0:18:15.46,0:18:17.05,Default,,0,0,0,,Жақсы жаңалық
Dialogue: 0,0:18:18.67,0:18:19.48,Default,,0,0,0,,Таймлайн: Йи Хуа; Пост-өндіріс: Blackfeather; Арнайы эффектілер: akk; Кодтау: prpr Dog; BD түзетулері: Xizi Ganle
Dialogue: 0,0:18:23.88,0:18:27.27,Default,,0,0,0,,Бүгін біз Аргонависпен жүзуді бастаймыз.
Dialogue: 0,0:18:28.08,0:18:29.62,Default,,0,0,0,,Біздің орындауымызды қараңыз
Dialogue: 0,0:18:34.85,0:18:38.53,Default,,0,0,0,,Аргонависке бірінші рет оралуымыз
Dialogue: 0,0:18:39.75,0:18:41.39,Default,,0,0,0,,Жұмысқа орналасу талаптарының басталуы
Dialogue: 0,0:18:50.46,0:18:51.92,Default,,0,0,0,,Тұрақты жүреді!
Dialogue: 0,0:20:44.80,0:20:46.70,Default,,0,0,0,,Нағыз өкініш
Dialogue: 0,0:20:47.10,0:20:51.55,Default,,0,0,0,,Менің ескі тақтадан естігім келетіні осы.
Dialogue: 0,0:20:53.89,0:20:56.11,Default,,0,0,0,,Бірінші астана – осы жер.
Dialogue: 0,0:20:56.25,0:20:59.42,Default,,0,0,0,,Электр энергиясының жоғалуы
Dialogue: 0,0:21:00.04,0:21:02.05,Default,,0,0,0,,Төмендегі шарттарды орындамау
Dialogue: 0,0:21:02.58,0:21:04.10,Default,,0,0,0,,Толық қанағаттандырылуы керек
Dialogue: 0,0:21:05.29,0:21:07.15,Default,,0,0,0,,Бұл есеп шығын болып табылады.
Dialogue: 0,0:21:08.91,0:21:11.12,Default,,0,0,0,,Көрермендер алдында ойнап бітірдім.
Dialogue: 0,0:21:12.02,0:21:14.14,Default,,0,0,0,,Аргонавистің әндерін оқу
Dialogue: 0,0:21:15.08,0:21:17.60,Default,,0,0,0,,Адамдардың санын көбейтудің қалаған мүмкіндігі
Dialogue: 0,0:21:18.89,0:21:20.00,Default,,0,0,0,,Растау
Dialogue: 0,0:21:20.99,0:21:23.07,Default,,0,0,0,,...
Dialogue: 0,0:21:23.69,0:21:24.94,Default,,0,0,0,,...
Dialogue: 0,0:21:28.21,0:21:29.30,Default,,0,0,0,,Тірі үй
Dialogue: 0,0:21:31.49,0:21:32.42,Default,,0,0,0,,Мен қайдамын
Dialogue: 0,0:21:32.68,0:21:34.42,Default,,0,0,0,,Бұрын өткізілген
Dialogue: 0,0:21:35.65,0:21:36.38,Default,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:21:38.52,0:21:39.70,Default,,0,0,0,,Шынайы оқиға
Dialogue: 0,0:21:40.97,0:21:43.97,Default,,0,0,0,,қолайлы Iwa Oya сауда көлемі Ichige
Dialogue: 0,0:21:46.36,0:21:49.57,Default,,0,0,0,,Бұл жер туралы не ойлайсыз?
Dialogue: 0,0:21:50.24,0:21:50.86,Default,,0,0,0,,Жылу өрісі?
Dialogue: 0,0:21:51.44,0:21:52.38,Default,,0,0,0,,Сондай-ақ танымал
Dialogue: 0,0:21:52.76,0:21:54.46,Default,,0,0,0,,Бұл дұрыс әрекет пе?
Dialogue: 0,0:21:55.02,0:21:59.14,Default,,0,0,0,,Мұны ГИРОАКСИЯ деп айту
Dialogue: 0,0:21:59.64,0:22:00.99,Default,,0,0,0,,ГИРОКСИЯ?
Dialogue: 0,0:22:01.62,0:22:02.45,Default,,0,0,0,,Жақсы таяқ
Dialogue: 0,0:22:03.15,0:22:05.98,Default,,0,0,0,,GYROAXIA Live қолданбасын қашан бастадым?
Dialogue: 0,0:22:09.81,0:22:10.80,Default,,0,0,0,,...
Dialogue: 0,0:23:42.76,0:23:45.73,Default,,0,0,0,,GYROAXIA ерекше өнімділікті көрсетеді
Dialogue: 0,0:23:46.22,0:23:48.07,Default,,0,0,0,,Наюта Макотоның қылмысы
Dialogue: 0,0:23:48.53,0:23:50.99,Default,,0,0,0,,Бір ұпай және жақсы Наюта Мен Нуиджоға үміттенемін
Dialogue: 0,0:23:51.66,0:23:53.88,Default,,0,0,0,,Төменгі «Bang Dream ARGONAVIS!»
Dialogue: 0,0:23:54.21,0:23:55.57,Default,,0,0,0,,Өткен тарихтың тарихы
Dialogue: 0,0:23:55.79,0:23:56.69,Default,,0,0,0,,Құрмет күту
