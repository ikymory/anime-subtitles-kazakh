Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:25.45,0:00:31.45,Default,,0,0,0,,(Бива орындауы)
Dialogue: 0,0:00:34.75,0:00:37.33,Default,,0,0,0,,♪Енді өткен күн
Dialogue: 0,0:00:38.00,0:00:43.79,Default,,0,0,0,,♪Но труппалары әлемді жаулап алған кезде
Dialogue: 0,0:00:46.45,0:00:49.33,Default,,0,0,0,,♪Жоқ, олай емес.
Dialogue: 0,0:00:49.91,0:00:53.12,Default,,0,0,0,,♪Көбірек
Dialogue: 0,0:00:53.37,0:00:59.16,Default,,0,0,0,,♪Көбірек
Dialogue: 0,0:00:59.83,0:01:03.66,Default,,0,0,0,,♪Баяғыда
Dialogue: 0,0:01:13.12,0:01:18.20,Default,,0,0,0,,Қазір баяғыда Нохты «Саругаку» деп атаған.
Dialogue: 0,0:01:18.33,0:01:21.79,Default,,0,0,0,,Бұл елде екі императорлық сот болды.
Dialogue: 0,0:01:21.91,0:01:24.04,Default,,0,0,0,,Яғни, екі император бар.
Dialogue: 0,0:01:24.16,0:01:28.20,Default,,0,0,0,,Солтүстік немесе Оңтүстік соттардың заңды екендігі белгісіз болды.
Dialogue: 0,0:01:28.33,0:01:33.66,Default,,0,0,0,,Солтүстік императорлық сот генерал үш қасиетті қазынаны қалайды.
Dialogue: 0,0:01:33.79,0:01:40.33,Default,,0,0,0,,Үш қасиетті қазынаға ие болғандар заңды императордың дәлелі.
Dialogue: 0,0:01:45.66,0:01:48.45,Default,,0,0,0,,Ах! Тіпті қасиетті қазыналардың бірі
Dialogue: 0,0:01:48.58,0:01:51.37,Default,,0,0,0,,Кем дегенде біреуі осында болса!
Dialogue: 0,0:01:51.50,0:01:56.04,Default,,0,0,0,,♪Бар болса, Қолыңнан келсе
Dialogue: 0,0:01:56.16,0:02:01.16,Default,,0,0,0,,♪Егер менде бар болса, менде бар болса, мен оны алуым керек
Dialogue: 0,0:02:01.29,0:02:05.16,Default,,0,0,0,,♪Түсініңіз
Dialogue: 0,0:02:07.12,0:02:11.25,Default,,0,0,0,,(Бива орындауы)
Dialogue: 0,0:02:13.29,0:02:19.25,Default,,0,0,0,,(Охайаши)
Dialogue: 0,0:02:32.62,0:02:36.62,Default,,0,0,0,,Уф~ Ах~!
Dialogue: 0,0:02:47.08,0:02:47.87,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:02:50.66,0:02:52.16,Default,,0,0,0,,Эй!
Dialogue: 0,0:02:58.50,0:03:03.33,Default,,0,0,0,,Осы елдің 600 жыл бұрынғы тарихы
Dialogue: 0,0:03:04.75,0:03:10.00,Default,,0,0,0,,Біздің ұрланған және жоғалған тарихымыз
Dialogue: 0,0:03:21.62,0:03:23.62,Default,,0,0,0,,~♪
Dialogue: 0,0:03:23.75,0:03:29.66,Default,,0,0,0,,(Шайқас дыбыстары)
Dialogue: 0,0:03:31.25,0:03:38.12,Default,,0,0,0,,Сен оған тек құрал ғана болдың…
Dialogue: 0,0:03:38.25,0:03:44.25,Default,,0,0,0,,(Сарбаздардың ыңырануы)
Dialogue: 0,0:04:36.33,0:04:38.58,Default,,0,0,0,,Пуха
Dialogue: 0,0:04:41.54,0:04:43.50,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,0:04:43.62,0:04:46.20,Default,,0,0,0,,Не болды? Эй, сен білесің бе?
Dialogue: 0,0:04:46.33,0:04:49.87,Default,,0,0,0,,Жоқ, білмеймін, бірақ сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:04:50.00,0:04:52.08,Default,,0,0,0,,Ей, менен ештеңе сұрама.
Dialogue: 0,0:04:58.16,0:05:00.87,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:05:01.04,0:05:03.50,Default,,0,0,0,,Әй, несі жаман?
Dialogue: 0,0:05:03.91,0:05:06.25,Default,,0,0,0,,Бірдеңе келе жатыр!
Dialogue: 0,0:05:09.45,0:05:11.00,Default,,0,0,0,,Кибитчоке!
Dialogue: 0,0:05:12.54,0:05:14.50,Default,,0,0,0,,Бұл жай ғана мәселе емес.
Dialogue: 0,0:05:14.70,0:05:17.25,Default,,0,0,0,,Біртүрлі нәрсе
Dialogue: 0,0:05:17.37,0:05:19.00,Default,,0,0,0,,Бұл дұрыс болуы мүмкін.
Dialogue: 0,0:05:28.25,0:05:30.45,Default,,0,0,0,,Сұраныс
Dialogue: 0,0:05:32.87,0:05:34.70,Default,,0,0,0,,Ол жер сол
Dialogue: 0,0:05:35.08,0:05:36.58,Default,,0,0,0,,Мұнда
Dialogue: 0,0:05:37.79,0:05:39.58,Default,,0,0,0,,Орара отбасы 60 жыл бірге.
Dialogue: 0,0:05:39.70,0:05:42.95,Default,,0,0,0,,Осы Дан-но-урада мен Хейке отбасының жәдігерлерін жинадым.
Dialogue: 0,0:05:43.08,0:05:46.16,Default,,0,0,0,,Мен мұндай қазына қалғанын елестете алмаймын.
Dialogue: 0,0:05:46.29,0:05:47.58,Default,,0,0,0,,Сөз жоқ.
Dialogue: 0,0:05:47.70,0:05:51.50,Default,,0,0,0,,Үш қабат балшық пен ағаш жәшікке оралған фигура сіздің денеңіздің биіктігімен бірдей.
Dialogue: 0,0:05:51.62,0:05:54.04,Default,,0,0,0,,Бір қарағанда, қазынаға ұқсамайды. (Томоо) А...
Dialogue: 0,0:05:54.16,0:05:55.70,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:05:56.29,0:05:59.95,Default,,0,0,0,,Бір ауылда түсімде көрдім.
Dialogue: 0,0:06:00.08,0:06:02.70,Default,,0,0,0,,Бұл Гейкенің жасырын алқабы немесе басқа нәрсе ме?
Dialogue: 0,0:06:02.87,0:06:05.58,Default,,0,0,0,,А, біз мұны істейміз бе, жоқ па!!
Dialogue: 0,0:06:08.16,0:06:09.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:28.16,0:06:29.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:30.04,0:06:30.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:32.70,0:06:34.50,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:06:34.62,0:06:38.16,Default,,0,0,0,,Онда ашулы жүзді шаян бар.
Dialogue: 0,0:06:38.29,0:06:41.79,Default,,0,0,0,,Коэцу жүздерін теңізге жасырады
Dialogue: 0,0:06:41.91,0:06:45.25,Default,,0,0,0,,Бұл... осында қырылған Хайке руының қарғысы.
Dialogue: 0,0:06:45.37,0:06:46.62,Default,,0,0,0,,Бұл ырым!!
Dialogue: 0,0:06:46.75,0:06:50.29,Default,,0,0,0,,Мен теңізден шыққанда ғана қарғыс айтамын.
Dialogue: 0,0:07:27.75,0:07:29.41,Default,,0,0,0,,О (Досым) Хаа Хаа
Dialogue: 0,0:07:29.54,0:07:31.08,Default,,0,0,0,,Иә? Уау...
Dialogue: 0,0:07:32.87,0:07:34.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:36.41,0:07:37.95,Default,,0,0,0,,Уау
Dialogue: 0,0:07:39.79,0:07:40.95,Default,,0,0,0,,Уау (хабаршы) Ах...
Dialogue: 0,0:07:48.50,0:07:49.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:50.20,0:07:51.20,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:07:54.33,0:07:55.70,Default,,0,0,0,,Hii (хабаршы) Ах...
Dialogue: 0,0:08:06.95,0:08:08.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:21.87,0:08:24.91,Default,,0,0,0,,Тотойой! Қатты қараңғы!!
Dialogue: 0,0:08:25.45,0:08:27.54,Default,,0,0,0,,Хэй (қызметші) Мені кешіріңіз!
Dialogue: 0,0:08:27.66,0:08:29.12,Default,,0,0,0,,Тотойой!
Dialogue: 0,0:08:29.25,0:08:30.25,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:08:30.37,0:08:31.87,Default,,0,0,0,,Тотойой!
Dialogue: 0,0:08:32.20,0:08:35.70,Default,,0,0,0,,Мен көрмеймін! Тым қараңғы
Dialogue: 0,0:08:41.66,0:08:44.54,Default,,0,0,0,,Киотолық Аетсура, сен не айттың?
Dialogue: 0,0:08:44.66,0:08:46.54,Default,,0,0,0,,Мен қашып кеттім
Dialogue: 0,0:08:46.66,0:08:48.95,Default,,0,0,0,,Сыртқы түрі: Сіз соқырсыз ба?
Dialogue: 0,0:08:49.08,0:08:50.79,Default,,0,0,0,,Хагай-жоқ-
Dialogue: 0,0:08:50.91,0:08:52.87,Default,,0,0,0,,Денья Моротанка?
Dialogue: 0,0:08:53.00,0:08:57.04,Default,,0,0,0,,Онсыз, жоқ күйеуім өліп, балам соқыр болып қалды.
Dialogue: 0,0:08:57.16,0:09:00.12,Default,,0,0,0,,Илеудің қажеті жоқ
Dialogue: 0,0:09:00.25,0:09:04.08,Default,,0,0,0,,Аецура Аецура Қызық, бұл кім болды?
Dialogue: 0,0:09:04.20,0:09:07.50,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:07.75,0:09:13.29,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:16.50,0:09:20.37,Default,,0,0,0,,Олай болса, Томойоши, Аетацураны тауып алайық!
Dialogue: 0,0:09:20.50,0:09:24.37,Default,,0,0,0,,Өкініш үшін кек алайын.
Dialogue: 0,0:09:24.83,0:09:29.62,Default,,0,0,0,,Сіздің өкінішіңіз, Ио отбасының өкініші.
Dialogue: 0,0:09:29.75,0:09:34.37,Default,,0,0,0,,Өзіңіз жек көретін адамдарды табыңыз және өкінішіңіз үшін кек алыңыз!
Dialogue: 0,0:09:39.70,0:09:45.66,Default,,0,0,0,,Мен оларды қырдым
Dialogue: 0,0:09:46.54,0:09:50.37,Default,,0,0,0,,(Жапырақтардың сыбдыры)
Dialogue: 0,0:09:53.50,0:09:55.87,Default,,0,0,0,,(ағаш кесу дыбысы)
Dialogue: 0,0:09:56.00,0:10:02.37,Default,,0,0,0,,(ағаш құлаған дыбыс)
Dialogue: 0,0:10:02.50,0:10:08.12,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:10:08.25,0:10:12.45,Default,,0,0,0,,(лайлы ағынның дыбысы)
Dialogue: 0,0:10:53.04,0:10:54.08,Default,,0,0,0,,(Бива орындауы)
Dialogue: 0,0:10:54.20,0:10:58.95,Default,,0,0,0,,♪Хейке әлемі аяқталды.
Dialogue: 0,0:10:59.62,0:11:02.45,Default,,0,0,0,,♪Хейктің қызыл туы артқа қарай төмен түседі
Dialogue: 0,0:11:02.58,0:11:07.16,Default,,0,0,0,,♪Генджидің ақ туы сонда итеріп кетті
Dialogue: 0,0:11:11.12,0:11:15.08,Default,,0,0,0,,♪Бұл соңғы орын сияқты көрінді
Dialogue: 0,0:11:15.20,0:11:19.25,Default,,0,0,0,,♪Даннура теңізінде
Dialogue: 0,0:11:28.75,0:11:32.20,Default,,0,0,0,,♪Екінші дәрежелі монах орнынан тұрады
Dialogue: 0,0:11:32.33,0:11:36.79,Default,,0,0,0,,♪Сегіз жасар императормен сөйлесу
Dialogue: 0,0:11:36.91,0:11:39.79,Default,,0,0,0,,♪Толқынның астында да астана бар
Dialogue: 0,0:11:39.91,0:11:42.66,Default,,0,0,0,,♪Рюгу сарайына барайық
Dialogue: 0,0:11:42.79,0:11:45.79,Default,,0,0,0,,♪Жас император
Dialogue: 0,0:11:45.91,0:11:49.37,Default,,0,0,0,,♪Қасиетті Құсанағы қылышпен
Dialogue: 0,0:11:49.50,0:11:55.54,Default,,0,0,0,,♪Кеменің шетінен толқындардың астына дейін
Dialogue: 0,0:11:55.95,0:11:59.54,Default,,0,0,0,,♪Ол батып кетті
Dialogue: 0,0:12:00.20,0:12:04.25,Default,,0,0,0,,♪Рюгу сарайына жеттіңіз бе?
Dialogue: 0,0:12:04.37,0:12:07.54,Default,,0,0,0,,♪Рюгуджо бар ма?
Dialogue: 0,0:12:08.04,0:12:09.45,Default,,0,0,0,,Уау~ (Досы) Ах.
Dialogue: 0,0:12:09.58,0:12:11.04,Default,,0,0,0,,Мм, не?!
Dialogue: 0,0:12:11.16,0:12:13.04,Default,,0,0,0,,Ұстама (Томоо) Мен не айтып тұрғанымды білемін!
Dialogue: 0,0:12:13.16,0:12:16.70,Default,,0,0,0,,Дан-но-ура Шичичоруға батқан қазына қылыш!
Dialogue: 0,0:12:17.33,0:12:18.95,Default,,0,0,0,,Әрине білесіз.
Dialogue: 0,0:12:19.08,0:12:22.50,Default,,0,0,0,,Жапониядағы Хейке руының құлауы туралы әйгілі оқиға
Dialogue: 0,0:12:22.62,0:12:23.79,Default,,0,0,0,,Барлығы біледі
Dialogue: 0,0:12:23.91,0:12:26.83,Default,,0,0,0,,Сіз осында ән айтасыз ба?
Dialogue: 0,0:12:26.95,0:12:29.45,Default,,0,0,0,,Мен мұнда Ицукусиманы еске алу кешіне келдім.
Dialogue: 0,0:12:29.58,0:12:33.62,Default,,0,0,0,,Менің айналамда маған ұқсайтын адамдар көп.
Dialogue: 0,0:12:33.75,0:12:37.25,Default,,0,0,0,,Қараңдар, Ицукусима теңізде.
Dialogue: 0,0:12:37.91,0:12:39.91,Default,,0,0,0,,Ай!
Dialogue: 0,0:12:40.41,0:12:43.25,Default,,0,0,0,,Мен көрдім, бірақ сен оны көрмейсің, сен соқырсың.
Dialogue: 0,0:12:43.37,0:12:45.91,Default,,0,0,0,,Не! Бізде де солай.
Dialogue: 0,0:12:46.04,0:12:52.37,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:12:52.50,0:12:55.41,Default,,0,0,0,,Соқыр болсаң да ән айтып, дыбыс шығара аласың ба?
Dialogue: 0,0:12:55.54,0:12:58.00,Default,,0,0,0,,Бұл тамақ болғандықтан.
Dialogue: 0,0:12:58.12,0:13:00.20,Default,,0,0,0,,Нушидің аты кім?
Dialogue: 0,0:13:00.33,0:13:01.58,Default,,0,0,0,,Ионың досы балық!
Dialogue: 0,0:13:01.70,0:13:05.29,Default,,0,0,0,,Мен Даннурадан Хейкенің жасырын алқабының тарихын табу үшін келдім!
Dialogue: 0,0:13:08.25,0:13:11.08,Default,,0,0,0,,Бұл менің аты-жөнім.
Dialogue: 0,0:13:14.54,0:13:16.16,Default,,0,0,0,,Тани… Бір…
Dialogue: 0,0:13:16.29,0:13:17.50,Default,,0,0,0,,Сіз оқи аласыз ба?
Dialogue: 0,0:13:17.62,0:13:19.16,Default,,0,0,0,,Дұрыс, Ио Даннура...
Dialogue: 0,0:13:19.29,0:13:21.66,Default,,0,0,0,,Қараңдар, сол жақтағы тас белгіні түртіңдер.
Dialogue: 0,0:13:23.50,0:13:27.33,Default,,0,0,0,,(Бива орындауы)
Dialogue: 0,0:13:27.50,0:13:30.37,Default,,0,0,0,,♪Бұл Ицукусимаға ұқсайды
Dialogue: 0,0:13:30.50,0:13:33.54,Default,,0,0,0,,♪Хейке генерал Кийомори жасаған-
Dialogue: 0,0:13:33.66,0:13:36.79,Default,,0,0,0,,♪Теңіздегі алақан
Dialogue: 0,0:13:59.62,0:14:06.54,Default,,0,0,0,,(Бива ансамблі)
Dialogue: 0,0:14:09.37,0:14:20.00,Default,,0,0,0,,(сутраларды дауыспен оқу)
Dialogue: 0,0:14:34.79,0:14:35.83,Default,,0,0,0,,Ах
Dialogue: 0,0:14:47.45,0:14:52.50,Default,,0,0,0,,(Охайаши)
Dialogue: 0,0:15:05.12,0:15:11.12,Default,,0,0,0,,(Бива орындауы)
Dialogue: 0,0:15:30.83,0:15:33.12,Default,,0,0,0,,Менің ойымша, сіз оны көре алмайсыз.
Dialogue: 0,0:15:33.25,0:15:37.66,Default,,0,0,0,,Даннура қаласында туылған, біз екі жыл бірге саяхаттап келеміз.
Dialogue: 0,0:15:37.79,0:15:40.58,Default,,0,0,0,,О, Даннурадан
Dialogue: 0,0:15:44.83,0:15:48.41,Default,,0,0,0,,Тому Хейкенің жасырын аңғарын іздейді.
Dialogue: 0,0:15:48.54,0:15:52.08,Default,,0,0,0,,Ол жерден Хайке әңгімелерін таба аласыз.
Dialogue: 0,0:15:52.20,0:15:55.12,Default,,0,0,0,,Мен де оны алғым келеді.
Dialogue: 0,0:15:55.50,0:15:57.33,Default,,0,0,0,,Тек сақ болыңыз
Dialogue: 0,0:15:57.45,0:16:02.29,Default,,0,0,0,,Жаңа Хейке отбасыларын алған бива шеберлері енді қалмады.
Dialogue: 0,0:16:04.25,0:16:07.62,Default,,0,0,0,,Ракуда біреу кесіп тастады...
Dialogue: 0,0:16:08.04,0:16:10.75,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:16:15.04,0:16:16.29,Default,,0,0,0,,Ондаған адамдар
Dialogue: 0,0:16:17.83,0:16:19.75,Default,,0,0,0,,Әрбір адам
Dialogue: 0,0:16:20.37,0:16:24.04,Default,,0,0,0,,Не! Бұл кувабаракувабара
Dialogue: 0,0:16:24.16,0:16:27.45,Default,,0,0,0,,Мен мұны кім жасағанын әлі білмеймін.
Dialogue: 0,0:16:27.66,0:16:29.00,Default,,0,0,0,,Бұл қатыгездік
Dialogue: 0,0:16:29.12,0:16:31.95,Default,,0,0,0,,Мононоке шығармашылығы туралы қауесеттер бар.
Dialogue: 0,0:16:32.08,0:16:35.25,Default,,0,0,0,,Ал, абай болу керек.
Dialogue: 0,0:16:35.45,0:16:38.45,Default,,0,0,0,,♪~
Dialogue: 0,0:16:40.37,0:16:41.75,Default,,0,0,0,,(инелік жеген дыбыс)
Dialogue: 0,0:16:47.75,0:16:48.75,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:16:51.87,0:16:52.75,Default,,0,0,0,,Тағы бір… үкі ме?
Dialogue: 0,0:16:57.29,0:17:00.00,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:17:04.62,0:17:07.00,Default,,0,0,0,,Ахаха хаха Тоқта!
Dialogue: 0,0:17:07.58,0:17:09.50,Default,,0,0,0,,Тоқта, өтінемін, тоқтат, тоқтат.
Dialogue: 0,0:17:10.29,0:17:13.29,Default,,0,0,0,,~♪
Dialogue: 0,0:17:16.83,0:17:18.50,Default,,0,0,0,,(Ит патшасының екінші ағасының айқайы)
Dialogue: 0,0:17:19.45,0:17:25.41,Default,,0,0,0,,(Охайаши)
Dialogue: 0,0:17:35.08,0:17:37.91,Default,,0,0,0,,Жоқ, жоқ, жоқ! неге алмайды
Dialogue: 0,0:17:38.04,0:17:42.04,Default,,0,0,0,,Нушира осы Хиейза тақтасының мұрагері болады!!
Dialogue: 0,0:17:42.16,0:17:44.25,Default,,0,0,0,,Киотодағы ең үздік болуы керек
Dialogue: 0,0:17:45.04,0:17:46.58,Default,,0,0,0,,Тағы да!
Dialogue: 0,0:17:46.87,0:17:51.54,Default,,0,0,0,,(Охайаши)
Dialogue: 0,0:17:54.66,0:17:57.04,Default,,0,0,0,,Жоқ, жоқ, қайталап көріңіз!
Dialogue: 0,0:18:38.41,0:18:41.00,Default,,0,0,0,,А, не?
Dialogue: 0,0:18:41.37,0:18:44.95,Default,,0,0,0,,Ах~ Ой
Dialogue: 0,0:18:45.08,0:18:49.08,Default,,0,0,0,,Уау... Ах!
Dialogue: 0,0:18:49.20,0:18:50.62,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:18:50.75,0:18:54.45,Default,,0,0,0,,♪~
Dialogue: 0,0:18:54.58,0:18:56.95,Default,,0,0,0,,Yaho!
Dialogue: 0,0:18:57.25,0:19:00.45,Default,,0,0,0,,Хи хи хи хи хи...
Dialogue: 0,0:19:00.58,0:19:01.95,Default,,0,0,0,,Ахаха ахаха
Dialogue: 0,0:19:02.33,0:19:04.29,Default,,0,0,0,,Уау (ер адам) Не?
Dialogue: 0,0:19:04.41,0:19:07.58,Default,,0,0,0,,Йо~ Тааа
Dialogue: 0,0:19:07.70,0:19:09.41,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:09.54,0:19:11.45,Default,,0,0,0,,Балалар? (Еркек) Сен баласың ба?
Dialogue: 0,0:19:12.08,0:19:13.87,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:19:14.00,0:19:16.04,Default,,0,0,0,,Йотто!
Dialogue: 0,0:19:16.16,0:19:19.04,Default,,0,0,0,,фуфуфуфуфуфуфу таааааааа!
Dialogue: 0,0:19:19.16,0:19:20.33,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:20.62,0:19:22.04,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:19:22.54,0:19:23.54,Default,,0,0,0,,Асқабақ?
Dialogue: 0,0:19:23.66,0:19:25.04,Default,,0,0,0,,Асқабақ маскасы?
Dialogue: 0,0:19:25.50,0:19:27.25,Default,,0,0,0,,Бала көп жасырады
Dialogue: 0,0:19:27.37,0:19:30.04,Default,,0,0,0,,Барлығы бірге... Мен сені ұрлаймын.
Dialogue: 0,0:19:30.16,0:19:33.33,Default,,0,0,0,,Хяхахахахаха!
Dialogue: 0,0:19:33.45,0:19:36.66,Default,,0,0,0,,Ха! Хи хи хи хи хи хи...
Dialogue: 0,0:19:38.29,0:19:39.29,Default,,0,0,0,,Не?
Dialogue: 0,0:19:39.41,0:19:41.54,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:19:47.33,0:19:48.70,Default,,0,0,0,,Сәлем
Dialogue: 0,0:19:50.83,0:19:52.70,Default,,0,0,0,,Ей, бұл қорқынышты!
Dialogue: 0,0:19:52.83,0:19:57.66,Default,,0,0,0,,Киахахахахаха…
Dialogue: 0,0:19:57.79,0:19:59.45,Default,,0,0,0,,~♪
Dialogue: 0,0:20:02.66,0:20:05.33,Default,,0,0,0,,Сағыныш иісі
Dialogue: 0,0:20:06.58,0:20:10.54,Default,,0,0,0,,Мен он жылдан астам уақыт ішінде алғаш рет Киото астанасына оралдым.
Dialogue: 0,0:20:10.66,0:20:11.83,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:20:11.95,0:20:13.04,Default,,0,0,0,,Уау (әйел) Кяаа
Dialogue: 0,0:20:13.16,0:20:15.58,Default,,0,0,0,,Хяхахаха
Dialogue: 0,0:20:19.70,0:20:21.20,Default,,0,0,0,,Астана өртенді
Dialogue: 0,0:20:21.33,0:20:24.37,Default,,0,0,0,,Өйткені қақтығыстар мен өрттер ешқашан тоқтамайды.
Dialogue: 0,0:20:24.50,0:20:26.08,Default,,0,0,0,,Ештеңе өзгермейді
Dialogue: 0,0:20:27.00,0:20:29.54,Default,,0,0,0,,Ашикағаның бақылауы жерге дейін жетеді.
Dialogue: 0,0:20:29.66,0:20:31.33,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:20:31.45,0:20:34.45,Default,,0,0,0,,Бұл астананың иісі!
Dialogue: 0,0:20:34.58,0:20:35.58,Default,,0,0,0,,Уақытыңызды алыңыз
Dialogue: 0,0:20:38.20,0:20:42.58,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:20:42.70,0:20:49.91,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:20:50.04,0:20:57.20,Default,,0,0,0,,(Күріш дыбысы)
Dialogue: 0,0:20:57.33,0:21:01.75,Default,,0,0,0,,(торғай жылайды)
Dialogue: 0,0:21:01.87,0:21:02.87,Default,,0,0,0,,Әй, бұл осылай. (Адам) Не істеп жатырсың?
Dialogue: 0,0:21:02.87,0:21:04.08,Default,,0,0,0,,Әй, бұл осылай. (Адам) Не істеп жатырсың?
Dialogue: 0,0:21:02.87,0:21:04.08,Default,,0,0,0,,♪~
Dialogue: 0,0:21:04.08,0:21:04.41,Default,,0,0,0,,♪~
Dialogue: 0,0:21:04.41,0:21:05.29,Default,,0,0,0,,♪~
Dialogue: 0,0:21:04.41,0:21:05.29,Default,,0,0,0,,Йосеои
Dialogue: 0,0:21:05.41,0:21:07.25,Default,,0,0,0,,Сәлем! (Ер) Сәлем!
Dialogue: 0,0:21:17.62,0:21:18.87,Default,,0,0,0,,Қараңыз (ер) Тартыңыз, тартыңыз
Dialogue: 0,0:21:19.00,0:21:20.50,Default,,0,0,0,,Жақсы (ер) тартылды
Dialogue: 0,0:21:20.62,0:21:22.00,Default,,0,0,0,,(сылақ қабырға сазының дыбысы)
Dialogue: 0,0:21:22.12,0:21:24.00,Default,,0,0,0,,(ағаш шегелердің соғылған дыбысы)
Dialogue: 0,0:21:24.12,0:21:26.50,Default,,0,0,0,,(тоқыма тоқыма дыбысы)
Dialogue: 0,0:21:26.62,0:21:27.91,Default,,0,0,0,,(Қылыш қайраған дыбыс)
Dialogue: 0,0:21:28.04,0:21:29.79,Default,,0,0,0,,(темір соққан дыбыс)
Dialogue: 0,0:21:29.91,0:21:33.29,Default,,0,0,0,,(Күріш дыбысы)
Dialogue: 0,0:21:37.79,0:21:39.79,Default,,0,0,0,,~♪
Dialogue: 0,0:21:39.91,0:21:43.79,Default,,0,0,0,,Фугафуга...
Dialogue: 0,0:21:45.87,0:21:49.54,Default,,0,0,0,,Жарайды, онда ол адамға «бір» таңбасын беріңіз.
Dialogue: 0,0:21:49.66,0:21:52.16,Default,,0,0,0,,Рахмет (Томо) Иә?
Dialogue: 0,0:21:52.29,0:21:54.50,Default,,0,0,0,,Хасуичи Иә
Dialogue: 0,0:21:54.62,0:21:59.45,Default,,0,0,0,,Осы орындыққа жататын барлық бива шеберлері Какуичи-саманың ичи-но-джиін алады.
Dialogue: 0,0:21:59.58,0:22:02.00,Default,,0,0,0,,Демек, Юүо Юичиге айналады.
Dialogue: 0,0:22:02.12,0:22:04.08,Default,,0,0,0,,Бар, жүр! Бұл қиын
Dialogue: 0,0:22:04.20,0:22:05.95,Default,,0,0,0,,А? Мен не істей аламын?
Dialogue: 0,0:22:06.08,0:22:07.70,Default,,0,0,0,,Балықтың досы? (Досы) А
Dialogue: 0,0:22:07.83,0:22:09.12,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:22:09.25,0:22:11.33,Default,,0,0,0,,А... ештеңе болуы мүмкін емес.
Dialogue: 0,0:22:19.54,0:22:23.08,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:22:31.33,0:22:32.87,Default,,0,0,0,,Мүмкін емес пе?
Dialogue: 0,0:22:33.54,0:22:36.87,Default,,0,0,0,,Аты-жөніңізді өзгертсеңіз, оны таба алмайсыз.
Dialogue: 0,0:22:37.00,0:22:38.79,Default,,0,0,0,,Сіз оны атамайынша көре алмайсыз.
Dialogue: 0,0:22:38.91,0:22:40.04,Default,,0,0,0,,Орындықта өсу
Dialogue: 0,0:22:40.16,0:22:42.50,Default,,0,0,0,,Юйчичу есімінің мағынасы жоқ.
Dialogue: 0,0:22:42.62,0:22:46.70,Default,,0,0,0,,Бұл Томоо. Бұл Даннурадан келген Томоо.
Dialogue: 0,0:22:46.83,0:22:49.08,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:22:49.50,0:22:51.29,Default,,0,0,0,,Өкінішімізді айтайық
Dialogue: 0,0:22:51.41,0:22:55.50,Default,,0,0,0,,Менің қол-аяғым сол үшін.
Dialogue: 0,0:23:02.50,0:23:06.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:07.12,0:23:09.00,Default,,0,0,0,,Бұл өрт. (Адам) Бұл от.
Dialogue: 0,0:23:09.12,0:23:11.83,Default,,0,0,0,,Уау! (Самурай) Не болды, Асқабақ!?
Dialogue: 0,0:23:11.95,0:23:13.08,Default,,0,0,0,,Қылыш алынды!
Dialogue: 0,0:23:13.45,0:23:16.04,Default,,0,0,0,,Жылаған баланың да үнін бауыз жауып тастайды
Dialogue: 0,0:23:16.16,0:23:18.54,Default,,0,0,0,,Сұмдық... құбыжық! (Ину) Қараңдар, қараңдар.
Dialogue: 0,0:23:18.66,0:23:19.79,Default,,0,0,0,,Ал, эй, эй
Dialogue: 0,0:23:19.91,0:23:21.16,Default,,0,0,0,,Қылыш! Қарғыс атсын (Инуо) мұнда, міне
Dialogue: 0,0:23:21.29,0:23:24.00,Default,,0,0,0,,О, құбыжық!
Dialogue: 0,0:23:24.20,0:23:28.16,Default,,0,0,0,,Хахахаха Жеңілмейтін асқабақ!
Dialogue: 0,0:23:28.29,0:23:29.91,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:23:31.54,0:23:35.95,Default,,0,0,0,,Бірақ бірақ бірақ бірақ бірақ...
Dialogue: 0,0:23:36.08,0:23:38.45,Default,,0,0,0,,Жолдан кет! Бұл асқабақ
Dialogue: 0,0:23:42.20,0:23:45.87,Default,,0,0,0,,(Иттің қатты тыныс алуы)
Dialogue: 0,0:23:46.00,0:23:49.33,Default,,0,0,0,,Асқабақ бетін алып тастаймын!
Dialogue: 0,0:23:49.45,0:23:51.95,Default,,0,0,0,,Оның асқабақ маскасы бар ма?
Dialogue: 0,0:23:53.70,0:23:54.75,Default,,0,0,0,,О!
Dialogue: 0,0:23:54.87,0:23:56.58,Default,,0,0,0,,Бетті алып тастағанда не болады?
Dialogue: 0,0:23:56.70,0:23:59.58,Default,,0,0,0,,Бір нәрсені көргенде таңдану, шошып кету
Dialogue: 0,0:23:59.70,0:24:01.62,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:24:03.00,0:24:04.12,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:24:04.25,0:24:06.58,Default,,0,0,0,,Асқабақтың бетін алып тастадың ба?
Dialogue: 0,0:24:06.70,0:24:08.54,Default,,0,0,0,,О! бұл менің қиындығым
Dialogue: 0,0:24:08.66,0:24:12.00,Default,,0,0,0,,Қараңызшы!
Dialogue: 0,0:24:13.08,0:24:14.33,Default,,0,0,0,,Сіз оны көре алмайсыз.
Dialogue: 0,0:24:14.45,0:24:15.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:15.95,0:24:17.00,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:24:17.12,0:24:20.08,Default,,0,0,0,,Сонда оның мағынасы жоқ, солай ма?
Dialogue: 0,0:24:20.54,0:24:22.50,Default,,0,0,0,,Ең алдымен...
Dialogue: 0,0:24:22.62,0:24:25.04,Default,,0,0,0,,Бива, сен оны ойнай аласың ба?
Dialogue: 0,0:24:25.16,0:24:27.50,Default,,0,0,0,,Hmph, әрине.
Dialogue: 0,0:24:28.75,0:24:34.00,Default,,0,0,0,,(Бива орындауы)
Dialogue: 0,0:24:41.95,0:24:43.83,Default,,0,0,0,,Бұл жақсы (Томоюки) әрине!
Dialogue: 0,0:24:48.12,0:24:49.54,Default,,0,0,0,,Бұл жаңа.
Dialogue: 0,0:24:50.04,0:24:52.29,Default,,0,0,0,,Бұл мен естіген дыбыс болды (Инуо) Камминг
Dialogue: 0,0:24:52.41,0:24:54.04,Default,,0,0,0,,Әрі қарай жүрейік
Dialogue: 0,0:24:54.16,0:24:59.25,Default,,0,0,0,,(Бива орындауы)
Dialogue: 0,0:25:22.54,0:25:25.54,Default,,0,0,0,,~♪
Dialogue: 0,0:25:26.08,0:25:28.66,Default,,0,0,0,,N (иіскеу дыбысы)
Dialogue: 0,0:25:31.12,0:25:33.20,Default,,0,0,0,,Сіздің атыңыз кім? (Инуо) Манжуда
Dialogue: 0,0:25:33.58,0:25:35.45,Default,,0,0,0,,Фумайхара (дос балық) хехехе
Dialogue: 0,0:25:37.50,0:25:38.87,Default,,0,0,0,,Сақ бол.
Dialogue: 0,0:25:39.75,0:25:42.12,Default,,0,0,0,,Менің естігенім сенің есімің еді.
Dialogue: 0,0:25:42.25,0:25:44.04,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:25:44.16,0:25:45.16,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:25:45.29,0:25:48.58,Default,,0,0,0,,Менің атым Томоо!
Dialogue: 0,0:25:48.70,0:25:52.08,Default,,0,0,0,,Менің атым Тому... немесе Юичи
Dialogue: 0,0:25:52.20,0:25:54.87,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:25:55.00,0:25:56.25,Default,,0,0,0,,Ешкім...
Dialogue: 0,0:25:56.37,0:25:58.00,Default,,0,0,0,,Какуичи қайда орналасқан?
Dialogue: 0,0:25:58.12,0:26:02.16,Default,,0,0,0,,Ол сол жерде лордпен байланысты, сондықтан ол әлі де үлкейе береді.
Dialogue: 0,0:26:02.37,0:26:03.87,Default,,0,0,0,,Сонымен сенің атың кім?
Dialogue: 0,0:26:04.16,0:26:05.41,Default,,0,0,0,,Менің атым жоқ
Dialogue: 0,0:26:05.54,0:26:08.50,Default,,0,0,0,,Не? Неліктен оның аты жоқ? Бұл ыңғайсыз емес пе?
Dialogue: 0,0:26:08.62,0:26:11.08,Default,,0,0,0,,Ааа, хабарласатын ешкім жоқ.
Dialogue: 0,0:26:15.50,0:26:17.08,Default,,0,0,0,,Сәлем, Юичи!
Dialogue: 0,0:26:17.20,0:26:19.25,Default,,0,0,0,,Иә, дос балық?
Dialogue: 0,0:26:19.66,0:26:22.00,Default,,0,0,0,,Мүмкін Юичи шығар! Юичи!
Dialogue: 0,0:26:22.12,0:26:24.20,Default,,0,0,0,,Мен Каку труппасындамын
Dialogue: 0,0:26:25.16,0:26:29.08,Default,,0,0,0,,Эй, эй! Атаусыз табу қиын
Dialogue: 0,0:26:29.20,0:26:31.45,Default,,0,0,0,,Мен сені қалай атаймын?
Dialogue: 0,0:26:31.66,0:26:33.83,Default,,0,0,0,,Негізі мен шешіп қойдым.
Dialogue: 0,0:26:33.95,0:26:36.33,Default,,0,0,0,,Сіз шешім қабылдадыңыз ба? Өзіңізбен бе?
Dialogue: 0,0:26:36.45,0:26:40.16,Default,,0,0,0,,А, өз атыңды таңдап, есіміңді жария ет.
Dialogue: 0,0:26:41.95,0:26:46.20,Default,,0,0,0,,Хиеиза сахнасында өз есіміңізді танымал етіңіз!
Dialogue: 0,0:26:46.33,0:26:49.33,Default,,0,0,0,,♪~
Dialogue: 0,0:26:50.70,0:26:56.00,Default,,0,0,0,,♪Будда әрқашан
Dialogue: 0,0:26:56.12,0:27:01.58,Default,,0,0,0,,♪Кешіріңіз
Dialogue: 0,0:27:02.33,0:27:09.75,Default,,0,0,0,,♪Егер олай болмаса, мені ая.
Dialogue: 0,0:27:09.87,0:27:20.37,Default,,0,0,0,,♪Ешкім дыбыс шығармағанда таң ата
Dialogue: 0,0:27:20.50,0:27:32.20,Default,,0,0,0,,♪Бұл түс сияқты көрінді
Dialogue: 0,0:27:34.95,0:27:37.58,Default,,0,0,0,,Тэйичи, еңбегіңіз үшін рахмет.
Dialogue: 0,0:27:37.70,0:27:40.91,Default,,0,0,0,,Марқұм атам да разы болса керек.
Dialogue: 0,0:27:41.04,0:27:44.33,Default,,0,0,0,,Өкінішке орай, солтүстік және оңтүстік императорлық соттардың бірігуі биыл да жалғасады.
Dialogue: 0,0:27:44.45,0:27:46.45,Default,,0,0,0,,Нені хабарлау мүмкін болмады
Dialogue: 0,0:27:48.37,0:27:52.00,Default,,0,0,0,,Егер бұл Йошимицу-сама болса, мен оның орындалатынына сенімдімін.
Dialogue: 0,0:27:52.83,0:27:55.70,Default,,0,0,0,,Жарайсың, Канами Фудзивака
Dialogue: 0,0:27:56.66,0:27:57.83,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:27:57.95,0:28:03.12,Default,,0,0,0,,Маған Жоғарғы Лорд пен марқұм Ұлы Мастердің алдында билеуге мүмкіндік бергеніңіз үшін рахмет.
Dialogue: 0,0:28:03.25,0:28:07.00,Default,,0,0,0,,Мен өте бақыттымын.
Dialogue: 0,0:28:07.29,0:28:10.25,Default,,0,0,0,,Енді би билейік.
Dialogue: 0,0:28:10.41,0:28:16.00,Default,,0,0,0,,(Охайаши)
Dialogue: 0,0:28:40.58,0:28:42.70,Default,,0,0,0,,Бұл талғампаз тон.
Dialogue: 0,0:28:42.83,0:28:45.25,Default,,0,0,0,,Би де талғампаз болуы керек.
Dialogue: 0,0:28:45.37,0:28:50.45,Default,,0,0,0,,Кан'ами мен Фудзивака саругакудың шыңы деп танылды.
Dialogue: 0,0:28:50.58,0:28:53.33,Default,,0,0,0,,шыңы Хиэй емес пе еді?
Dialogue: 0,0:28:53.45,0:28:57.41,Default,,0,0,0,,Кішіпейіл Хиейза Керемет Канзеза
Dialogue: 0,0:28:58.00,0:29:03.00,Default,,0,0,0,,Фудзивака сұлулығы мен биіне байланысты сегундар арасында ерекше танымал болған сияқты.
Dialogue: 0,0:29:04.54,0:29:06.25,Default,,0,0,0,,Хехе...
Dialogue: 0,0:29:30.41,0:29:32.41,Default,,0,0,0,,~♪
Dialogue: 0,0:29:34.08,0:29:38.00,Default,,0,0,0,,Бақа сумосы? Мен оны Фудзиваканың қасына осылай қоюым керек пе?
Dialogue: 0,0:29:38.12,0:29:39.45,Default,,0,0,0,,Өтінемін, мені кешіріңіз Өтінемін, мені кешіріңіз
Dialogue: 0,0:29:39.58,0:29:41.20,Default,,0,0,0,,Кешірім сұрағаныңды кешірмеймін.
Dialogue: 0,0:29:41.33,0:29:44.95,Default,,0,0,0,,Осылай уақытың болса, өлемін деген ниетпен істе! тағы бір рет!
Dialogue: 0,0:29:45.08,0:29:48.08,Default,,0,0,0,,(Охайаши)
Dialogue: 0,0:29:52.58,0:29:54.20,Default,,0,0,0,,Уваах! Көзім…
Dialogue: 0,0:29:54.33,0:29:58.41,Default,,0,0,0,,Әдеміге, түпкі сұлулыққа жақындау
Dialogue: 0,0:29:58.54,0:30:00.25,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:30:00.37,0:30:03.45,Default,,0,0,0,,Ах, о...
Dialogue: 0,0:30:12.79,0:30:18.45,Default,,0,0,0,,(Охайаши)
Dialogue: 0,0:30:19.50,0:30:20.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:21.58,0:30:22.45,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:30:23.33,0:30:24.45,Default,,0,0,0,,Әке!
Dialogue: 0,0:30:24.58,0:30:29.08,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:30:29.20,0:30:30.45,Default,,0,0,0,,Ішек
Dialogue: 0,0:30:31.16,0:30:33.62,Default,,0,0,0,,Сізге жаттығудың қажеті жоқ!
Dialogue: 0,0:30:33.75,0:30:38.00,Default,,0,0,0,,Сол ыңғайсыз ұзын қолдарыңыз болғанша, сіз сахнаға шыға аласыз ба?
Dialogue: 0,0:30:38.12,0:30:39.79,Default,,0,0,0,,Ұсқынсыз құбыжық!
Dialogue: 0,0:30:39.91,0:30:40.95,Default,,0,0,0,,(Хаяши музыкантының күрсінуі)
Dialogue: 0,0:30:41.08,0:30:47.25,Default,,0,0,0,,(қабықтың дірілдеген дыбысы)
Dialogue: 0,0:30:51.00,0:30:57.20,Default,,0,0,0,,♪Арманшыл болмай тұрып
Dialogue: 0,0:30:57.33,0:31:01.16,Default,,0,0,0,,♪Мен секіруім керек
Dialogue: 0,0:31:01.29,0:31:05.62,Default,,0,0,0,,♪Қазір босатыңыз
Dialogue: 0,0:31:05.75,0:31:13.45,Default,,0,0,0,,♪Аң ұйықтар алдында
Dialogue: 0,0:31:17.08,0:31:19.70,Default,,0,0,0,,Хаа... Бұл дененің себеп-салдары қандай?
Dialogue: 0,0:31:19.83,0:31:23.37,Default,,0,0,0,,Артқы жағындағы қабыршақ, аузы болуы керек жерде емес
Dialogue: 0,0:31:23.50,0:31:28.04,Default,,0,0,0,,Қалыпты бетперде кигенде екі көз де көрінбейді.
Dialogue: 0,0:31:28.87,0:31:30.83,Default,,0,0,0,,Бұл қол пайдалы!
Dialogue: 0,0:31:33.37,0:31:36.08,Default,,0,0,0,,Кім осындай нәрсені жасай алады?
Dialogue: 0,0:31:39.41,0:31:40.41,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:31:40.54,0:31:44.16,Default,,0,0,0,,Бірақ осы көзқарастың кесірінен Хиейзаның үстінде тұруым қиын.
Dialogue: 0,0:31:44.29,0:31:45.87,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:31:46.00,0:31:48.25,Default,,0,0,0,,Аяқтар Кеуде іші
Dialogue: 0,0:31:48.37,0:31:51.12,Default,,0,0,0,,Бір қулықты меңгерген сайын, бірінен соң бірі.
Dialogue: 0,0:31:51.25,0:31:54.79,Default,,0,0,0,,Дененің бөліктері иеленген зат құлағандай өзгереді.
Dialogue: 0,0:31:54.91,0:31:57.16,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:31:57.29,0:32:00.70,Default,,0,0,0,,Иә, бұл қарғыс сияқты.
Dialogue: 0,0:32:03.75,0:32:04.95,Default,,0,0,0,,Қарғыс?
Dialogue: 0,0:32:05.37,0:32:07.58,Default,,0,0,0,,Бұл елестің жұмысы болуы мүмкін.
Dialogue: 0,0:32:09.87,0:32:13.16,Default,,0,0,0,,Мен сондаймын, бірақ елестермен араласпаймын.
Dialogue: 0,0:32:13.45,0:32:16.29,Default,,0,0,0,,Менің ондай қарым-қатынасым жоқ...
Dialogue: 0,0:32:16.70,0:32:19.79,Default,,0,0,0,,Жоқ, болды! Менімен де сөйлесетін рух бар
Dialogue: 0,0:32:21.08,0:32:24.83,Default,,0,0,0,,Тотойой! Жақсы!
Dialogue: 0,0:32:24.95,0:32:28.08,Default,,0,0,0,,Тотойой! Бұл Юичи!
Dialogue: 0,0:32:28.20,0:32:30.00,Default,,0,0,0,,Маме Нака!
Dialogue: 0,0:32:30.66,0:32:32.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:32.70,0:32:34.87,Default,,0,0,0,,Эй, көре аласың ба?
Dialogue: 0,0:32:35.25,0:32:38.95,Default,,0,0,0,,Аты-жөнімді өзгертсем, таба алмас едім.
Dialogue: 0,0:32:39.33,0:32:42.41,Default,,0,0,0,,Тотойо, дос балық!
Dialogue: 0,0:32:42.54,0:32:47.50,Default,,0,0,0,,Ио руының досы, Даннураның досы!
Dialogue: 0,0:32:47.62,0:32:51.58,Default,,0,0,0,,Тотойой, сен мына дауысқа жауап бересің бе?
Dialogue: 0,0:32:51.70,0:32:52.75,Default,,0,0,0,,Балықтың досы?
Dialogue: 0,0:32:52.87,0:32:54.70,Default,,0,0,0,,Ой!
Dialogue: 0,0:32:55.37,0:32:56.87,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:32:57.00,0:33:00.66,Default,,0,0,0,,Елестерге келгенде «Маменака?» накарогая болып табылады.
Dialogue: 0,0:33:00.79,0:33:01.79,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:33:01.91,0:33:05.58,Default,,0,0,0,,Аты-жөніңізді өзгертсеңіз, оны таба алмайсыз!
Dialogue: 0,0:33:05.70,0:33:09.08,Default,,0,0,0,,Уау, Дан-но-ураның досы балық!
Dialogue: 0,0:33:10.37,0:33:13.41,Default,,0,0,0,,Даннурадағы үйрек өлді.
Dialogue: 0,0:33:13.54,0:33:14.58,Default,,0,0,0,,Не!
Dialogue: 0,0:33:14.70,0:33:17.91,Default,,0,0,0,,Шіріктен кейін, сіз Буддалыққа жете аласыз деп үміттенемін.
Dialogue: 0,0:33:19.87,0:33:23.62,Default,,0,0,0,,Солай ма? Бұл қорқынышты болды.
Dialogue: 0,0:33:23.87,0:33:27.79,Default,,0,0,0,,Мен де жоғалып кететін сияқтымын.
Dialogue: 0,0:33:27.91,0:33:30.70,Default,,0,0,0,,Күте аласыз ба? Мен бұрын бірдеңе естігенмін.
Dialogue: 0,0:33:31.16,0:33:33.79,Default,,0,0,0,,Дәл қазір жақын жерде елес бар, солай ма?
Dialogue: 0,0:33:33.91,0:33:35.16,Default,,0,0,0,,Орагаору
Dialogue: 0,0:33:35.29,0:33:38.04,Default,,0,0,0,,Түсіндім. Тағы не?
Dialogue: 0,0:33:39.95,0:33:43.29,Default,,0,0,0,,Ооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо
Dialogue: 0,0:33:43.41,0:33:47.54,Default,,0,0,0,,О, ой, ой, ой, ой, ой, кеттік.
Dialogue: 0,0:33:47.66,0:33:49.58,Default,,0,0,0,,Ол жігіттің қолында ма?
Dialogue: 0,0:33:49.70,0:33:51.87,Default,,0,0,0,,Буддалыққа жету және Хайке отбасына айналу.
Dialogue: 0,0:33:52.00,0:33:55.41,Default,,0,0,0,,Туысқан Самураралардың атаулары өте көп.
Dialogue: 0,0:33:55.54,0:33:57.95,Default,,0,0,0,,Хайке көп! (Ину) Хейке!?
Dialogue: 0,0:33:58.08,0:34:00.62,Default,,0,0,0,,Кел, ынталы өмір сүр.
Dialogue: 0,0:34:01.62,0:34:05.87,Default,,0,0,0,,(Елестердің дауыстары)
Dialogue: 0,0:34:06.00,0:34:07.45,Default,,0,0,0,,Мен естимін...
Dialogue: 0,0:34:08.00,0:34:11.41,Default,,0,0,0,,Сіз мені естисіз бе? Мен таң қалдым!
Dialogue: 0,0:34:14.29,0:34:15.41,Default,,0,0,0,,Сіз оны көре аласыз ба?
Dialogue: 0,0:34:15.54,0:34:17.75,Default,,0,0,0,,Ах! Біріншіден, бұл дауыс
Dialogue: 0,0:34:17.87,0:34:20.91,Default,,0,0,0,,Мен оны туғаннан бері естіп жүргендей сезінемін.
Dialogue: 0,0:34:21.12,0:34:23.37,Default,,0,0,0,,Не, ауырады ма?
Dialogue: 0,0:34:23.50,0:34:25.87,Default,,0,0,0,,Айтшы, мен тыңдаймын.
Dialogue: 0,0:34:26.20,0:34:29.91,Default,,0,0,0,,Иә иә иә иә иә иә иә
Dialogue: 0,0:34:30.04,0:34:33.04,Default,,0,0,0,,Не айтып тұрғаныңызды түсіндім!
Dialogue: 0,0:34:33.16,0:34:36.20,Default,,0,0,0,,Кезекпен сөйле, мен тыңдаймын.
Dialogue: 0,0:34:36.33,0:34:39.33,Default,,0,0,0,,♪~
Dialogue: 0,0:34:36.33,0:34:39.33,Default,,0,0,0,,Мен сіздің әрбір әңгімеңізді тыңдаймын!
Dialogue: 0,0:34:39.33,0:34:41.45,Default,,0,0,0,,Мен сіздің әрбір әңгімеңізді тыңдаймын!
Dialogue: 0,0:34:41.58,0:34:46.70,Default,,0,0,0,,(Елестердің дауысы)
Dialogue: 0,0:34:49.20,0:34:53.20,Default,,0,0,0,,Мен қазірден бастап жаңа әңгіме бастағым келеді.
Dialogue: 0,0:34:53.62,0:34:56.33,Default,,0,0,0,,Жаңа әңгіме (Бива Хоши) Жаңа жұмыс?
Dialogue: 0,0:34:56.45,0:34:58.00,Default,,0,0,0,,Соңғы кездері біртүрлі болып кетті.
Dialogue: 0,0:34:58.12,0:35:00.95,Default,,0,0,0,,Біртүрлі иіс шығады (Бива Хоши) Бұл жезөкшенің хош иісі.
Dialogue: 0,0:35:03.95,0:35:10.33,Default,,0,0,0,,Бұл жерленген Хейке оқиғасын тапқан адамның оқиғасы.
Dialogue: 0,0:35:11.33,0:35:22.20,Default,,0,0,0,,♪
Dialogue: 0,0:35:22.33,0:35:27.66,Default,,0,0,0,,♪Үмітсіздік пен қайғының қарғысына оранған
Dialogue: 0,0:35:27.79,0:35:32.79,Default,,0,0,0,,♪Бір сәби дүниеге келді.
Dialogue: 0,0:35:32.91,0:35:37.58,Default,,0,0,0,,♪Жорғалап, итпен бірге тамақтан
Dialogue: 0,0:35:37.70,0:35:42.95,Default,,0,0,0,,♪Ол жеген қулығың боқ сияқты
Dialogue: 0,0:35:44.87,0:35:45.66,Default,,0,0,0,,Уф
Dialogue: 0,0:35:52.83,0:35:58.16,Default,,0,0,0,,♪Мәңгілік кек кию
Dialogue: 0,0:35:58.29,0:36:03.37,Default,,0,0,0,,♪До Нитакару - Хейке руының елесі
Dialogue: 0,0:36:03.50,0:36:08.12,Default,,0,0,0,,♪ Әңгімелерді бір-бірден жинаңыз
Dialogue: 0,0:36:08.25,0:36:13.25,Default,,0,0,0,,♪Қарғысты бұзып, адам бол
Dialogue: 0,0:36:13.37,0:36:18.37,Default,,0,0,0,,♪Біртүрлі тағдыр
Dialogue: 0,0:36:22.12,0:36:23.37,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:36:24.87,0:36:25.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:28.66,0:36:33.91,Default,,0,0,0,,♪Оми Хейзаның қарғыс атқан баласы
Dialogue: 0,0:36:34.04,0:36:39.08,Default,,0,0,0,,♪Дәл осы сәтте сахнада тұру
Dialogue: 0,0:36:39.20,0:36:43.75,Default,,0,0,0,,♪Рокуджо Каварадағы көпірдің астында
Dialogue: 0,0:36:44.00,0:36:48.66,Default,,0,0,0,,♪Айта басталатын оқиға
Dialogue: 0,0:36:49.00,0:36:54.04,Default,,0,0,0,,♪Сонымен танысайық
Dialogue: 0,0:36:55.87,0:36:58.00,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:37:01.79,0:37:05.41,Default,,0,0,0,,♪Сонымен танысайық
Dialogue: 0,0:37:12.04,0:37:14.54,Default,,0,0,0,,♪Бәрін жақсы көрейік
Dialogue: 0,0:37:19.83,0:37:20.79,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:37:20.91,0:37:24.25,Default,,0,0,0,,♪Бұған қарап көрейік
Dialogue: 0,0:37:25.08,0:37:27.95,Default,,0,0,0,,Хиэиза? (Әйел) Тіпті Хииза.
Dialogue: 0,0:37:28.08,0:37:30.66,Default,,0,0,0,,(Әйел) Сіздің екі ұлыңыз болған жоқ па?
Dialogue: 0,0:37:31.16,0:37:32.33,Default,,0,0,0,,Who?
Dialogue: 0,0:37:33.37,0:37:35.75,Default,,0,0,0,,Хииза Гион-сан емес пе?
Dialogue: 0,0:37:35.87,0:37:39.29,Default,,0,0,0,,Джиён-сан ағаш ұстасының іссапарда екенін айтады.
Dialogue: 0,0:37:39.41,0:37:41.79,Default,,0,0,0,,Рокуджо көпірі...
Dialogue: 0,0:37:41.91,0:37:42.91,Default,,0,0,0,,Басқа нәрсе
Dialogue: 0,0:37:43.04,0:37:45.50,Default,,0,0,0,,Ол ұстаның үшінші ұлы ма?
Dialogue: 0,0:37:45.91,0:37:47.79,Default,,0,0,0,,Ата-аналар мен балалар бірге жұмыс істей ме?
Dialogue: 0,0:37:47.91,0:37:48.91,Default,,0,0,0,,Тақтаны туралау
Dialogue: 0,0:37:49.04,0:37:50.83,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,0:37:54.95,0:37:58.95,Default,,0,0,0,,(Охайаши)
Dialogue: 0,0:38:04.54,0:38:06.00,Default,,0,0,0,,Бұл ағаш шебері.
Dialogue: 0,0:38:06.12,0:38:09.33,Default,,0,0,0,,Бұл ғибадатхана емес, ол Рокуджо көпірінің астында.
Dialogue: 0,0:38:09.45,0:38:10.45,Default,,0,0,0,,Өзен арнасы?
Dialogue: 0,0:38:10.58,0:38:12.58,Default,,0,0,0,,Хиэиза да өзен жағасында іссапармен жүрген көрінеді.
Dialogue: 0,0:38:12.70,0:38:15.08,Default,,0,0,0,,Көретін нәрсе сияқты. (Адам) Жарайды, кеттік. Асығыңыз, асығыңыз.
Dialogue: 0,0:38:18.20,0:38:23.20,Default,,0,0,0,,♪ Буддалыққа жету үшін еске алу кешін іздеуде (аудитория қол соғуды жалғастыруда)
Dialogue: 0,0:38:23.62,0:38:28.75,Default,,0,0,0,,♪Олар да маған ағылады.
Dialogue: 0,0:38:28.87,0:38:33.87,Default,,0,0,0,,♪Жорғалған елес туралы әңгіме
Dialogue: 0,0:38:34.00,0:38:38.20,Default,,0,0,0,,♪Ән айтып алып алатын сияқты.
Dialogue: 0,0:38:48.91,0:38:53.95,Default,,0,0,0,,♪Үмітсіздік пен пессимизм дауысы кезінде
Dialogue: 0,0:38:54.08,0:38:59.04,Default,,0,0,0,,♪Туғанда айғайлаған атаусыз өмір
Dialogue: 0,0:38:59.41,0:39:03.91,Default,,0,0,0,,♪Еркін биле
Dialogue: 0,0:39:04.04,0:39:08.87,Default,,0,0,0,,♪ Сахнаға өзіңіз тұрыңыз
Dialogue: 0,0:39:09.29,0:39:14.66,Default,,0,0,0,,♪Тек қарапайым болыңыз
Dialogue: 0,0:39:24.58,0:39:29.79,Default,,0,0,0,,♪Бізде де осындай нәрсе бар, иә.
Dialogue: 0,0:39:29.91,0:39:34.70,Default,,0,0,0,,♪Қараңғы қараңғылықтан қашу
Dialogue: 0,0:39:35.12,0:39:39.79,Default,,0,0,0,,♪Аспанға жорғала
Dialogue: 0,0:39:39.91,0:39:45.00,Default,,0,0,0,,♪Мен ойып алған оқиға
Dialogue: 0,0:39:45.12,0:39:49.33,Default,,0,0,0,,♪Енді атыңызды жариялайтын кез келді
Dialogue: 0,0:39:59.91,0:40:02.04,Default,,0,0,0,,♪Бірге келіңдер
Dialogue: 0,0:40:04.20,0:40:06.29,Default,,0,0,0,,♪Бұған қарап көрейік
Dialogue: 0,0:40:08.33,0:40:10.29,Default,,0,0,0,,♪Бізбен бірге
Dialogue: 0,0:40:11.83,0:40:14.54,Default,,0,0,0,,♪Бұған қарап көрейік
Dialogue: 0,0:40:18.20,0:40:22.33,Default,,0,0,0,,♪Енді атыңызды жариялайтын кез келді
Dialogue: 0,0:40:22.45,0:40:28.45,Default,,0,0,0,,(Топтың шуы)
Dialogue: 0,0:40:31.37,0:40:33.41,Default,,0,0,0,,Менің атым Ит патшасы
Dialogue: 0,0:40:34.33,0:40:37.50,Default,,0,0,0,,«Умезука» Инуу!
Dialogue: 0,0:40:39.58,0:40:40.62,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:40:40.75,0:40:42.58,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:40:42.70,0:40:45.16,Default,,0,0,0,,(Ит патшасының үруі)
Dialogue: 0,0:40:45.54,0:40:49.75,Default,,0,0,0,,Уақыт - Жуэй 3-ші жыл, Ичинотани Гэндзи мен Хейке арасындағы шайқас.
Dialogue: 0,0:40:49.87,0:40:55.12,Default,,0,0,0,,Таданори Хейкенің оң қолы шынтақтан жоғары түсірілді.
Dialogue: 0,0:40:56.04,0:40:57.62,Default,,0,0,0,,Оның да басы кесілді!
Dialogue: 0,0:40:57.75,0:40:59.95,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:41:00.08,0:41:03.87,Default,,0,0,0,,♪Қолымды кесіп тастады
Dialogue: 0,0:41:04.00,0:41:05.79,Default,,0,0,0,,♪Басы да шешілді
Dialogue: 0,0:41:05.95,0:41:09.58,Default,,0,0,0,,♪ Таданоридің шамамен 100 рыцарьдан тұратын әскері
Dialogue: 0,0:41:09.70,0:41:14.58,Default,,0,0,0,,♪Уа, құдай! Тәңірім, беріл де қаш
Dialogue: 0,0:41:22.16,0:41:27.20,Default,,0,0,0,,♪Иә! 100 адам жиналды
Dialogue: 0,0:41:27.33,0:41:31.83,Default,,0,0,0,,♪Бәрі жағаға шегінді
Dialogue: 0,0:41:31.95,0:41:37.58,Default,,0,0,0,,♪Жоқ, жоқ, ол көздерімен
Dialogue: 0,0:41:37.70,0:41:40.62,Default,,0,0,0,,♪Мына құрмаға қараңдар
Dialogue: 0,0:41:40.75,0:41:44.33,Default,,0,0,0,,♪Бұл ағаштың әлі жемісі жоқ
Dialogue: 0,0:41:44.45,0:41:49.12,Default,,0,0,0,,♪Бірақ ол бір күні жемісін береді
Dialogue: 0,0:41:49.25,0:41:53.00,Default,,0,0,0,,♪Кім қайықпен қашып кетті!?
Dialogue: 0,0:41:53.12,0:41:57.95,Default,,0,0,0,,♪Сонымен қатар, Хайке сарбаздары, Изуко?
Dialogue: 0,0:41:58.08,0:41:59.87,Default,,0,0,0,,♪Изуко
Dialogue: 0,0:42:02.41,0:42:03.87,Default,,0,0,0,,Иә~
Dialogue: 0,0:42:07.50,0:42:10.66,Default,,0,0,0,,Ао~!
Dialogue: 0,0:42:13.79,0:42:15.75,Default,,0,0,0,,Барлығың қолдарыңды созыңдар.
Dialogue: 0,0:42:17.25,0:42:19.16,Default,,0,0,0,,Жұдырықты көтер
Dialogue: 0,0:42:21.00,0:42:24.12,Default,,0,0,0,,Сені құтқарудың еш амалы жоқ
Dialogue: 0,0:42:24.75,0:42:28.45,Default,,0,0,0,,Хой Хой Хой (қол шапалақтау)
Dialogue: 0,0:42:30.41,0:42:32.70,Default,,0,0,0,,Ei Ei
Dialogue: 0,0:42:32.83,0:42:36.95,Default,,0,0,0,,♪Олар қашып бара жатқан кемеге қарай ағылды.
Dialogue: 0,0:42:37.08,0:42:41.33,Default,,0,0,0,,♪Мың солдат батып барады!
Dialogue: 0,0:42:41.45,0:42:44.95,Default,,0,0,0,,♪ Жабыңыз
Dialogue: 0,0:42:45.08,0:42:50.08,Default,,0,0,0,,♪Қолымды кесіп алсаң, жақсы боламын
Dialogue: 0,0:42:50.50,0:42:54.29,Default,,0,0,0,,♪Босқа ұмтылу
Dialogue: 0,0:42:54.41,0:42:58.95,Default,,0,0,0,,♪Батып бара жатқан кеме көпіршіктерді ұстап алады
Dialogue: 0,0:42:59.08,0:43:03.12,Default,,0,0,0,,♪Көптеген қолды кесіп тастаңыз
Dialogue: 0,0:43:03.25,0:43:07.41,Default,,0,0,0,,♪Тек күй дұрыс
Dialogue: 0,0:43:07.54,0:43:11.87,Default,,0,0,0,,♪Ұстамаңыз! Мені жіберме!
Dialogue: 0,0:43:12.00,0:43:16.37,Default,,0,0,0,,♪Сарбаздарда тек қару бар
Dialogue: 0,0:43:16.50,0:43:22.00,Default,,0,0,0,,♪Не ілулі қалады
Dialogue: 0,0:43:22.12,0:43:25.62,Default,,0,0,0,,♪Қарулар Тек қарулар!
Dialogue: 0,0:43:29.29,0:43:33.58,Default,,0,0,0,,♪Мен Сацума Ками оның күзетшісі болады деп күтпедім.
Dialogue: 0,0:43:33.70,0:43:36.79,Default,,0,0,0,,♪Бәрі қашып кеткенін естідім.
Dialogue: 0,0:43:36.91,0:43:42.16,Default,,0,0,0,,♪Мүмкін емес! Асығыңыз!
Dialogue: 0,0:43:42.29,0:43:45.91,Default,,0,0,0,,♪Таданори-самаға
Dialogue: 0,0:43:46.04,0:43:50.87,Default,,0,0,0,,♪Бірақ уақытында көргенім
Dialogue: 0,0:43:51.00,0:43:56.54,Default,,0,0,0,,♪Мойын немесе торсық жоқ
Dialogue: 0,0:43:56.66,0:43:59.66,Default,,0,0,0,,♪Тек оң қолы қалды
Dialogue: 0,0:43:59.79,0:44:03.95,Default,,0,0,0,,♪ Жағада жуылды
Dialogue: 0,0:44:04.08,0:44:08.29,Default,,0,0,0,,♪Көп қол мен өкініш
Dialogue: 0,0:44:08.41,0:44:12.45,Default,,0,0,0,,♪Өміріңді сақтай алмағаныма өкінемін.
Dialogue: 0,0:44:12.58,0:44:17.04,Default,,0,0,0,,♪Жинадым, жоқтадым.
Dialogue: 0,0:44:17.16,0:44:21.20,Default,,0,0,0,,♪Осы қолдың өтеуі
Dialogue: 0,0:44:21.33,0:44:25.70,Default,,0,0,0,,♪Тыныштық тыныш болсын деп айта алмаймын!
Dialogue: 0,0:44:25.83,0:44:31.79,Default,,0,0,0,,♪Қибата Муша 1000 қару
Dialogue: 0,0:44:31.91,0:44:34.16,Default,,0,0,0,,♪Сацуманың қолымен ками жоқ!
Dialogue: 0,0:44:34.29,0:44:38.70,Default,,0,0,0,,♪ Қолыңды көм, Армезука
Dialogue: 0,0:44:38.83,0:44:43.20,Default,,0,0,0,,♪ Оны арнаңыз! Уақыт келді
Dialogue: 0,0:44:44.54,0:44:45.91,Default,,0,0,0,,Қол шапалақтаңыз!
Dialogue: 0,0:44:46.04,0:44:51.66,Default,,0,0,0,,(көпшілік қол шапалақтау)
Dialogue: 0,0:44:56.62,0:45:02.91,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:45:10.25,0:45:17.45,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:45:26.45,0:45:30.91,Default,,0,0,0,,♪Қалың бұтақтардың ұшында
Dialogue: 0,0:45:31.04,0:45:35.25,Default,,0,0,0,,♪Мың білектің жемісін береді
Dialogue: 0,0:45:35.37,0:45:41.54,Default,,0,0,0,,♪Аа, бұл Армезука
Dialogue: 0,0:45:41.66,0:45:44.37,Default,,0,0,0,,♪Бұл енді басы!
Dialogue: 0,0:45:44.50,0:45:45.54,Default,,0,0,0,,(Елестердің дауыстары)
Dialogue: 0,0:45:45.66,0:45:46.87,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:45:56.75,0:45:59.75,Default,,0,0,0,,♪~
Dialogue: 0,0:46:01.00,0:46:02.04,Default,,0,0,0,,Ит патшасы?
Dialogue: 0,0:46:02.16,0:46:05.54,Default,,0,0,0,,Әй, әңгіме жаңа, ал трюк таңқаларлық.
Dialogue: 0,0:46:05.66,0:46:07.87,Default,,0,0,0,,Бәрінен бұрын ән мен би тың.
Dialogue: 0,0:46:08.16,0:46:10.79,Default,,0,0,0,,Аяқ-қолдарыңызды қозғалтуыңызды сұраймын.
Dialogue: 0,0:46:10.91,0:46:13.37,Default,,0,0,0,,Мен де ырғақпен ән айтқым келеді
Dialogue: 0,0:46:13.50,0:46:15.37,Default,,0,0,0,,Шебер ағаш ұстасы Хейке де жақсы болды.
Dialogue: 0,0:46:15.50,0:46:16.79,Default,,0,0,0,,Бұл қатынас емес.
Dialogue: 0,0:46:16.91,0:46:21.29,Default,,0,0,0,,Ұста ескі, бірақ Инуу жаңа.
Dialogue: 0,0:46:22.62,0:46:24.79,Default,,0,0,0,,Ину: Бұл қызық.
Dialogue: 0,0:46:24.91,0:46:26.62,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:46:26.75,0:46:28.20,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:46:28.33,0:46:29.62,Default,,0,0,0,,Сүйреп бара жатып билеу
Dialogue: 0,0:46:29.75,0:46:31.50,Default,,0,0,0,,Қонақтар жынды сияқты билейді
Dialogue: 0,0:46:31.75,0:46:33.29,Default,,0,0,0,,Бетіңізді жабық ұстаңыз
Dialogue: 0,0:46:33.41,0:46:36.33,Default,,0,0,0,,Ештеңе айта алмаймын, қызық оқиға.
Dialogue: 0,0:46:36.70,0:46:40.00,Default,,0,0,0,,Басы кесілген аруақ ән салады, би билейді.
Dialogue: 0,0:46:40.12,0:46:42.12,Default,,0,0,0,,Елес? (Еркек) Хайкенің елесі...
Dialogue: 0,0:46:42.25,0:46:44.12,Default,,0,0,0,,Жеке сөйлеу және билеу
Dialogue: 0,0:46:44.25,0:46:45.79,Default,,0,0,0,,Бұл жаңа.
Dialogue: 0,0:46:45.91,0:46:47.50,Default,,0,0,0,,Ән де сирек кездеседі.
Dialogue: 0,0:46:47.62,0:46:50.16,Default,,0,0,0,,Соғу күшті, маған сөйлейді
Dialogue: 0,0:46:50.29,0:46:51.58,Default,,0,0,0,,Сью
Dialogue: 0,0:46:51.91,0:46:53.79,Default,,0,0,0,,Биге де сұрау
Dialogue: 0,0:46:54.29,0:46:56.04,Default,,0,0,0,,Инууя
Dialogue: 0,0:46:58.20,0:46:59.70,Default,,0,0,0,,Бұл Шимизудегі сахна!
Dialogue: 0,0:47:00.20,0:47:03.62,Default,,0,0,0,,Бұдан былай! Дәл Хиеиза, бірақ Инуу.
Dialogue: 0,0:47:03.75,0:47:05.79,Default,,0,0,0,,Дұрыс, бұл ит патшасы!
Dialogue: 0,0:47:05.91,0:47:07.58,Default,,0,0,0,,Бұл ит патшасы!
Dialogue: 0,0:47:09.33,0:47:14.45,Default,,0,0,0,,♪Фантастикалық қауесеттер кезеңі
Dialogue: 0,0:47:14.75,0:47:19.45,Default,,0,0,0,,♪Біртүрлі қол адам қолына айналады
Dialogue: 0,0:47:19.91,0:47:24.54,Default,,0,0,0,,♪Қарғыс жойылған сияқты.
Dialogue: 0,0:47:24.66,0:47:29.70,Default,,0,0,0,,♪Ары қарай не өзгереді?
Dialogue: 0,0:47:40.50,0:47:45.62,Default,,0,0,0,,♪Таусылмас ренішке оранып
Dialogue: 0,0:47:45.75,0:47:50.79,Default,,0,0,0,,♪Хейкенің елесі оған қарай жорғалап келеді
Dialogue: 0,0:47:50.91,0:47:55.54,Default,,0,0,0,,♪Тыңдап алып алатын сияқтымын.
Dialogue: 0,0:47:55.66,0:48:00.79,Default,,0,0,0,,♪Тек ит патшасы ән айтып, билейді
Dialogue: 0,0:48:00.91,0:48:05.95,Default,,0,0,0,,♪Әңгіме
Dialogue: 0,0:48:16.83,0:48:21.79,Default,,0,0,0,,♪Тіпті Оми Хиеизаның көшбасшысы
Dialogue: 0,0:48:21.91,0:48:27.04,Default,,0,0,0,,♪Адамдардың саусақтарын аузына салып үндемейтін атағы бар сахна
Dialogue: 0,0:48:27.16,0:48:32.20,Default,,0,0,0,,♪Тіпті өрмелеп жатқан аспанға
Dialogue: 0,0:48:32.33,0:48:37.04,Default,,0,0,0,,♪Ол бізге ұқсайды.
Dialogue: 0,0:48:37.16,0:48:42.16,Default,,0,0,0,,♪Бұған қарап көрейік
Dialogue: 0,0:48:45.91,0:48:47.54,Default,,0,0,0,,♪Ей, бірге.
Dialogue: 0,0:48:48.83,0:48:51.79,Default,,0,0,0,,♪Сонымен танысайық
Dialogue: 0,0:48:53.75,0:48:55.12,Default,,0,0,0,,♪Уау.
Dialogue: 0,0:48:56.25,0:48:58.33,Default,,0,0,0,,♪ Уау.
Dialogue: 0,0:48:58.75,0:49:03.41,Default,,0,0,0,,♪Бірге тамашалайық
Dialogue: 0,0:49:10.79,0:49:16.16,Default,,0,0,0,,♪Бұл бір ғана сахналық қойылым.
Dialogue: 0,0:49:16.29,0:49:21.41,Default,,0,0,0,,♪Бір оқиғаны екі рет айтпа
Dialogue: 0,0:49:21.54,0:49:26.16,Default,,0,0,0,,♪Умезука мен Шигемори деген қауесет
Dialogue: 0,0:49:26.29,0:49:31.41,Default,,0,0,0,,♪Енді не билейсіз?
Dialogue: 0,0:49:31.54,0:49:36.62,Default,,0,0,0,,♪Оны жіберіп алмаңыз!
Dialogue: 0,0:49:36.95,0:49:42.91,Default,,0,0,0,,(халықтың қошеметі)
Dialogue: 0,0:49:45.41,0:49:51.91,Default,,0,0,0,,♪Ей, бірге тамашалайық.
Dialogue: 0,0:49:52.58,0:49:57.37,Default,,0,0,0,,♪Жақсы істерді бірге жасайық
Dialogue: 0,0:49:59.29,0:50:02.16,Default,,0,0,0,,♪Бұған қарап көрейік
Dialogue: 0,0:50:02.29,0:50:03.79,Default,,0,0,0,,О!
Dialogue: 0,0:50:08.41,0:50:11.75,Default,,0,0,0,,♪Эй, эй, сен
Dialogue: 0,0:50:12.79,0:50:14.50,Default,,0,0,0,,♪Ей, сен маған қарап тұрсың ғой?
Dialogue: 0,0:50:17.00,0:50:19.58,Default,,0,0,0,,♪Ей, мен де көріп тұрмын.
Dialogue: 0,0:50:19.70,0:50:21.33,Default,,0,0,0,,♪ Уау.
Dialogue: 0,0:50:22.25,0:50:23.62,Default,,0,0,0,,♪Уау
Dialogue: 0,0:50:28.45,0:50:33.79,Default,,0,0,0,,♪Қорқынышты арқа және түкті кеуде
Dialogue: 0,0:50:33.91,0:50:38.95,Default,,0,0,0,,♪Бәлкім, қарғыс жойылғанда бәрі өзгерер
Dialogue: 0,0:50:39.08,0:50:44.12,Default,,0,0,0,,♪Бір-ақ рет, Сахнаға бір-ақ рет шығады
Dialogue: 0,0:50:44.25,0:50:49.00,Default,,0,0,0,,♪Сен екеуміз бірге тексерейік.
Dialogue: 0,0:50:51.75,0:50:54.87,Default,,0,0,0,,♪Оны тексеріп көрейік
Dialogue: 0,0:50:56.00,0:50:57.41,Default,,0,0,0,,О!
Dialogue: 0,0:51:02.08,0:51:05.25,Default,,0,0,0,,♪Оны тексеріп көрейік
Dialogue: 0,0:51:05.37,0:51:07.37,Default,,0,0,0,,~♪
Dialogue: 0,0:51:13.12,0:51:14.29,Default,,0,0,0,,Сіз осында болдыңыз ба?
Dialogue: 0,0:51:14.41,0:51:15.95,Default,,0,0,0,,Мен оны тезірек көргім келеді.
Dialogue: 0,0:51:16.08,0:51:18.25,Default,,0,0,0,,Біз бірге билейміз, солай ма?
Dialogue: 0,0:51:18.37,0:51:21.00,Default,,0,0,0,,Әңгіме қарғыс атқан бала Хайке туралы.
Dialogue: 0,0:51:22.70,0:51:23.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:23.91,0:51:25.00,Default,,0,0,0,,Эй
Dialogue: 0,0:51:25.12,0:51:27.91,Default,,0,0,0,,«Кит» Инуу!
Dialogue: 0,0:51:28.04,0:51:30.95,Default,,0,0,0,,(халықтың қошеметі)
Dialogue: 0,0:51:31.08,0:51:33.33,Default,,0,0,0,,Генряку 2 курс Даннура
Dialogue: 0,0:51:33.45,0:51:36.66,Default,,0,0,0,,Гендзи руының алдында, Хейке руының басшысы Мунемори,
Dialogue: 0,0:51:36.79,0:51:40.12,Default,,0,0,0,,Мен оны кемеден көріп, болжадым.
Dialogue: 0,0:51:40.66,0:51:42.50,Default,,0,0,0,,Ит патшасы!!
Dialogue: 0,0:51:43.75,0:51:45.75,Default,,0,0,0,,Ит патшасы!
Dialogue: 0,0:51:45.87,0:51:48.75,Default,,0,0,0,,(халықтың қошеметі)
Dialogue: 0,0:51:48.87,0:51:53.83,Default,,0,0,0,,♪Бұл үлкен, үлкен кит
Dialogue: 0,0:51:53.95,0:52:00.12,Default,,0,0,0,,♪Үлкен кит жақындап келеді
Dialogue: 0,0:52:00.25,0:52:00.91,Default,,0,0,0,,Міне.
Dialogue: 0,0:52:01.04,0:52:05.87,Default,,0,0,0,,♪Үлкен, үлкен, үлкен кит
Dialogue: 0,0:52:06.00,0:52:12.45,Default,,0,0,0,,♪Үлкен кит жақындап келеді
Dialogue: 0,0:52:12.58,0:52:17.66,Default,,0,0,0,,♪Бұл мың дельфинмен бәс тігу
Dialogue: 0,0:52:17.79,0:52:23.87,Default,,0,0,0,,♪Даннура, қайтып жүзіп өтсеңіз жеңе аласыз
Dialogue: 0,0:52:24.00,0:52:24.66,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:52:24.79,0:52:29.12,Default,,0,0,0,,♪Үлкен, үлкен, үлкен кит
Dialogue: 0,0:52:29.25,0:52:30.25,Default,,0,0,0,,Ән айт!
Dialogue: 0,0:52:30.37,0:52:36.25,Default,,0,0,0,,♪Үлкен кит жақындап келеді
Dialogue: 0,0:52:36.37,0:52:41.00,Default,,0,0,0,,♪Әр адамның тағдырын болжайтын дельфин
Dialogue: 0,0:52:41.12,0:52:47.54,Default,,0,0,0,,♪Қай жолмен жүреміз? Болжалды дельфин
Dialogue: 0,0:52:47.66,0:52:48.33,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:52:48.45,0:52:52.12,Default,,0,0,0,,♪Үлкен, үлкен, үлкен кит
Dialogue: 0,0:52:52.25,0:52:53.25,Default,,0,0,0,,Міне!
Dialogue: 0,0:52:53.37,0:52:58.29,Default,,0,0,0,,♪Үлкен кит жақындап келеді
Dialogue: 0,0:52:58.41,0:52:59.62,Default,,0,0,0,,Келіңіздер, бәріңіз!
Dialogue: 0,0:52:59.75,0:53:02.62,Default,,0,0,0,,♪Үлкен, үлкен, үлкен кит
Dialogue: 0,0:53:02.75,0:53:04.83,Default,,0,0,0,,♪Үлкен кит
Dialogue: 0,0:53:04.95,0:53:11.16,Default,,0,0,0,,♪Үлкен кит жақындап келеді
Dialogue: 0,0:53:11.41,0:53:47.45,Default,,0,0,0,,♪
Dialogue: 0,0:53:47.58,0:53:51.50,Default,,0,0,0,,Кя~ Инуу~!
Dialogue: 0,0:53:54.62,0:53:56.25,Default,,0,0,0,,Мунемори!
Dialogue: 0,0:54:02.70,0:54:05.58,Default,,0,0,0,,Мунемори (ер) Мунемори
Dialogue: 0,0:54:10.29,0:54:12.87,Default,,0,0,0,,Ит патшасы! (Ер) Мунемори!
Dialogue: 0,0:54:21.58,0:54:26.41,Default,,0,0,0,,♪Балық аулаудан шаршадым, Жүз жылдық кит
Dialogue: 0,0:54:26.54,0:54:32.87,Default,,0,0,0,,♪ Сәлем! Мың дельфин Хайке отбасын тастап кетті
Dialogue: 0,0:54:33.00,0:54:33.66,Default,,0,0,0,,Міне.
Dialogue: 0,0:54:33.79,0:54:38.50,Default,,0,0,0,,♪Кит келмеді
Dialogue: 0,0:54:38.62,0:54:45.16,Default,,0,0,0,,♪Кит келмеді
Dialogue: 0,0:54:45.29,0:54:50.66,Default,,0,0,0,,♪Хейке отбасы жойылды, бірақ әлі біткен жоқ.
Dialogue: 0,0:54:50.79,0:54:57.12,Default,,0,0,0,,♪Бұл оқиғаның соңы ма?
Dialogue: 0,0:54:57.25,0:55:02.16,Default,,0,0,0,,♪Кит әлі келген жоқ
Dialogue: 0,0:55:02.29,0:55:08.79,Default,,0,0,0,,♪Кит әлі келген жоқ
Dialogue: 0,0:55:08.91,0:55:13.95,Default,,0,0,0,,♪Мен көптен күттім
Dialogue: 0,0:55:14.08,0:55:20.70,Default,,0,0,0,,♪Киттер қайтып келгеніне жүз жыл болды
Dialogue: 0,0:55:20.83,0:55:25.87,Default,,0,0,0,,♪ Мыңдаған құйрықтар күтіп тұр
Dialogue: 0,0:55:26.00,0:55:32.41,Default,,0,0,0,,♪Мен жүз жыл күттім
Dialogue: 0,0:55:32.54,0:55:37.62,Default,,0,0,0,,♪Арғы жағаның шетінен
Dialogue: 0,0:55:37.75,0:55:43.62,Default,,0,0,0,,♪Осында тағы да жүзетін күнім
Dialogue: 0,0:55:43.75,0:55:44.54,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:55:44.66,0:55:49.41,Default,,0,0,0,,♪Мен мәңгі күттім
Dialogue: 0,0:55:49.58,0:55:56.00,Default,,0,0,0,,♪Мен мәңгі күтемін
Dialogue: 0,0:55:56.12,0:56:01.33,Default,,0,0,0,,♪Мен сенемін
Dialogue: 0,0:56:01.45,0:56:04.62,Default,,0,0,0,,♪Сыйақы болмаса да
Dialogue: 0,0:56:04.75,0:56:08.04,Default,,0,0,0,,♪Мәңгілік, мәңгілік
Dialogue: 0,0:56:08.16,0:56:12.95,Default,,0,0,0,,♪Сенің келуіңді күтемін
Dialogue: 0,0:56:13.08,0:56:17.04,Default,,0,0,0,,♪Мен мәңгі күтемін
Dialogue: 0,0:56:17.16,0:56:19.70,Default,,0,0,0,,(Ину Кингтің жалғандығы)
Dialogue: 0,0:56:19.83,0:56:24.66,Default,,0,0,0,,♪Сенің келуіңді күтемін
Dialogue: 0,0:56:24.79,0:56:31.25,Default,,0,0,0,,♪Ән айтып, күтемін
Dialogue: 0,0:56:31.37,0:56:34.00,Default,,0,0,0,,♪
Dialogue: 0,0:56:34.00,0:56:36.95,Default,,0,0,0,,♪
Dialogue: 0,0:56:34.00,0:56:36.95,Default,,0,0,0,,(Ину Кингтің жалғандығы)
Dialogue: 0,0:56:36.95,0:56:50.20,Default,,0,0,0,,♪
Dialogue: 0,0:56:50.33,0:56:54.62,Default,,0,0,0,,(халықтың қошеметі)
Dialogue: 0,0:57:03.12,0:57:05.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:05.75,0:57:12.50,Default,,0,0,0,,♪Кит
Dialogue: 0,0:57:13.66,0:57:17.75,Default,,0,0,0,,(Ину Кингтің жалғандығы)
Dialogue: 0,0:57:17.87,0:58:14.25,Default,,0,0,0,,♪
Dialogue: 0,0:58:14.37,0:58:16.70,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:58:16.70,0:58:19.70,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:58:16.70,0:58:19.70,Default,,0,0,0,,~♪
Dialogue: 0,0:58:20.16,0:58:21.58,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:58:25.70,0:58:29.70,Default,,0,0,0,,Екеуміз бір орындықта төбелесеміз деп ойламаппын! Ит патшасы дегеніміз не?
Dialogue: 0,0:58:29.83,0:58:32.54,Default,,0,0,0,,Хиезаны қызықты еткен менмін.
Dialogue: 0,0:58:32.66,0:58:34.79,Default,,0,0,0,,Менің барлық саругакуларым
Dialogue: 0,0:58:34.91,0:58:38.25,Default,,0,0,0,,Мұның бәрін мен жасадым!
Dialogue: 0,0:58:39.87,0:58:41.16,Default,,0,0,0,,Хаа…
Dialogue: 0,0:58:42.70,0:58:48.25,Default,,0,0,0,,Жаңа әңгімені қайдан және кімнен алдың?
Dialogue: 0,0:58:48.79,0:58:51.62,Default,,0,0,0,,Юичидікі енді бива емес.
Dialogue: 0,0:58:51.75,0:58:53.87,Default,,0,0,0,,Бұл мені қызықтырады.
Dialogue: 0,0:58:54.00,0:58:57.25,Default,,0,0,0,,Жезөкшенің киімін кию, тіпті бояну
Dialogue: 0,0:58:57.37,0:59:00.91,Default,,0,0,0,,Мұндағы бива шебері лечер деген қауесет бар.
Dialogue: 0,0:59:01.04,0:59:02.54,Default,,0,0,0,,Бұл шектен шыққан емес пе?
Dialogue: 0,0:59:02.66,0:59:06.16,Default,,0,0,0,,Мына ұзын шаштың несі бар?
Dialogue: 0,0:59:06.29,0:59:09.37,Default,,0,0,0,,Биваның шебері - жүзімді бұйралау және оны дөңгелектеу ...
Dialogue: 0,0:59:09.50,0:59:11.37,Default,,0,0,0,,Сіз көре аласыз ба?
Dialogue: 0,0:59:11.50,0:59:14.45,Default,,0,0,0,,А, жоқ, мен оны көрмеймін.
Dialogue: 0,0:59:14.58,0:59:15.58,Default,,0,0,0,,Тұрақты!
Dialogue: 0,0:59:15.70,0:59:18.12,Default,,0,0,0,,Мен көргім келеді
Dialogue: 0,0:59:18.25,0:59:23.00,Default,,0,0,0,,Қызық емес пе? Олар қанша биіктікке көтеріледі?
Dialogue: 0,0:59:23.12,0:59:27.75,Default,,0,0,0,,(Бива орындауы)
Dialogue: 0,0:59:27.87,0:59:32.25,Default,,0,0,0,,(Асылдардың күлкісі)
Dialogue: 0,0:59:32.75,0:59:35.33,Default,,0,0,0,,Ән айтсаң да жеңбейсің бе?
Dialogue: 0,0:59:35.45,0:59:37.75,Default,,0,0,0,,Сіз Inuou томын білмейсіз бе?
Dialogue: 0,0:59:37.87,0:59:39.83,Default,,0,0,0,,Қорқынышты сипатта болып көрінеді.
Dialogue: 0,0:59:39.95,0:59:43.66,Default,,0,0,0,,Мені ақымақ деп атаңыз, бұл клиенттерді тартатын Йота.
Dialogue: 0,0:59:43.79,0:59:46.50,Default,,0,0,0,,Дұрыс (ақсүйек) Әй.
Dialogue: 0,0:59:46.79,0:59:49.37,Default,,0,0,0,,Инуу оқиғасы көркем шығарма.
Dialogue: 0,0:59:49.50,0:59:54.25,Default,,0,0,0,,Менің түрім сондай әдемі, мен оған ғашықпын
Dialogue: 0,0:59:54.37,0:59:57.25,Default,,0,0,0,,О, масканың астында әдемі екен.
Dialogue: 0,0:59:57.37,0:59:58.45,Default,,0,0,0,,Әрине!
Dialogue: 0,0:59:58.58,1:00:03.04,Default,,0,0,0,,Сол сұлу жүз де жай ғана маска.
Dialogue: 0,1:00:03.16,1:00:04.54,Default,,0,0,0,,Е, нені айтып тұрсың?
Dialogue: 0,1:00:04.66,1:00:07.08,Default,,0,0,0,,Мұның бәрі фантастика.
Dialogue: 0,1:00:07.20,1:00:09.41,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,1:00:09.54,1:00:11.00,Default,,0,0,0,,Хмм?
Dialogue: 0,1:00:11.12,1:00:13.45,Default,,0,0,0,,Бұл ұсқынсыз ба? Әдемі ме?
Dialogue: 0,1:00:13.58,1:00:17.04,Default,,0,0,0,,Ақырында Хитаменге табынатыныңызға сенімдімін.
Dialogue: 0,1:00:17.16,1:00:22.25,Default,,0,0,0,,Ха ха ха ха ха ха...
Dialogue: 0,1:00:22.37,1:00:24.33,Default,,0,0,0,,Бұлай асықпа
Dialogue: 0,1:00:28.54,1:00:30.54,Default,,0,0,0,,~♪
Dialogue: 0,1:00:30.66,1:00:36.66,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,1:00:40.29,1:00:42.25,Default,,0,0,0,,Сен сонда ішесің бе?
Dialogue: 0,1:00:42.37,1:00:44.04,Default,,0,0,0,,Мен банкетті жек көремін.
Dialogue: 0,1:00:44.50,1:00:46.37,Default,,0,0,0,,Сол жүз жылда қанша өмір сүрдіңіз?
Dialogue: 0,1:00:46.50,1:00:49.79,Default,,0,0,0,,Биваны қоңыз сияқты қолданыңыз.
Dialogue: 0,1:00:51.25,1:00:53.25,Default,,0,0,0,,Маған бұл ұнайды.
Dialogue: 0,1:00:53.37,1:00:56.66,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,1:00:56.79,1:01:00.41,Default,,0,0,0,,Юичи мен ақыры түсіндім.
Dialogue: 0,1:01:00.54,1:01:02.50,Default,,0,0,0,,Мені аңдып жүрген елестер
Dialogue: 0,1:01:02.62,1:01:05.29,Default,,0,0,0,,Сен мені қарғап тұрғандай емессің.
Dialogue: 0,1:01:05.66,1:01:09.95,Default,,0,0,0,,Біздің осы дүниеде болғанымызды білгендеріңізді қалаймын.
Dialogue: 0,1:01:10.08,1:01:15.20,Default,,0,0,0,,Бар болғаны бәрі білуі керек, сізге сауап беріледі.
Dialogue: 0,1:01:15.33,1:01:21.29,Default,,0,0,0,,Сондықтан мен бұл адамдардың бар екенін әңгіме арқылы жеткіземін.
Dialogue: 0,1:01:21.41,1:01:23.79,Default,,0,0,0,,Бұл олардың жоқтауы болады.
Dialogue: 0,1:01:23.91,1:01:26.33,Default,,0,0,0,,Біз қаншалықты қатыгез болсақ, соғұрлым зорлықшыл боламыз.
Dialogue: 0,1:01:26.45,1:01:29.79,Default,,0,0,0,,Мына жігіттер де көңіл көтеріп, қуанып айқайлап жатқан сияқты.
Dialogue: 0,1:01:29.91,1:01:32.20,Default,,0,0,0,,Біз осындамыз.
Dialogue: 0,1:01:32.66,1:01:34.79,Default,,0,0,0,,Біз осындамыз...
Dialogue: 0,1:01:35.87,1:01:38.12,Default,,0,0,0,,Ит патшасы мен шештім!
Dialogue: 0,1:01:38.25,1:01:42.70,Default,,0,0,0,,Мен Инуоның тарихын барлық елдерге одан да көп таратамын.
Dialogue: 0,1:01:43.91,1:01:47.12,Default,,0,0,0,,Сондықтан мен жаңа есім алып жатырмын!
Dialogue: 0,1:01:48.70,1:01:50.00,Default,,0,0,0,,Томоари
Dialogue: 0,1:01:50.12,1:01:52.33,Default,,0,0,0,,Досың бар ма?
Dialogue: 0,1:01:55.58,1:01:58.00,Default,,0,0,0,,Иә, «біз осындамыз»
Dialogue: 0,1:01:58.12,1:01:59.12,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,1:01:59.25,1:02:03.25,Default,,0,0,0,,Біз осындамыз...!
Dialogue: 0,1:02:03.37,1:02:05.83,Default,,0,0,0,,Хмм, бұл жақсы.
Dialogue: 0,1:02:05.95,1:02:09.04,Default,,0,0,0,,Ахахаха ахахха
Dialogue: 0,1:02:09.37,1:02:11.37,Default,,0,0,0,,♪~
Dialogue: 0,1:02:09.37,1:02:11.37,Default,,0,0,0,,Оны естігенде аяқ-қолың, денесі табиғи түрде қозғала бастайды дейді.
Dialogue: 0,1:02:11.37,1:02:13.62,Default,,0,0,0,,Оны естігенде аяқ-қолың, денесі табиғи түрде қозғала бастайды дейді.
Dialogue: 0,1:02:13.75,1:02:17.62,Default,,0,0,0,,Бива мен тайконың кез келген комбинациясы
Dialogue: 0,1:02:17.75,1:02:21.12,Default,,0,0,0,,«Томоари» - астанадағы танымал бива труппасы!
Dialogue: 0,1:02:21.45,1:02:26.20,Default,,0,0,0,,Биік таулары мен өзендері бар Inuou no Maki
Dialogue: 0,1:02:26.33,1:02:30.62,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,1:02:30.75,1:02:48.25,Default,,0,0,0,,♪
Dialogue: 0,1:02:48.25,1:02:49.62,Default,,0,0,0,,♪
Dialogue: 0,1:02:48.25,1:02:49.62,Default,,0,0,0,,(халықтың қошеметі)
Dialogue: 0,1:02:49.62,1:03:06.12,Default,,0,0,0,,♪
Dialogue: 0,1:03:11.33,1:03:14.16,Default,,0,0,0,,Біртүрлі бива соңғы кезде танымал болған сияқты.
Dialogue: 0,1:03:14.29,1:03:16.20,Default,,0,0,0,,Бұл Томоариза.
Dialogue: 0,1:03:16.33,1:03:19.12,Default,,0,0,0,,Алдыңғы орындықты тастап, туды көтерген ол.
Dialogue: 0,1:03:19.25,1:03:20.50,Default,,0,0,0,,Жаңа комбинациямен
Dialogue: 0,1:03:20.62,1:03:23.75,Default,,0,0,0,,Ынталы қолдау басқа елдерге таралуда
Dialogue: 0,1:03:23.87,1:03:25.12,Default,,0,0,0,,Алда қанша...
Dialogue: 0,1:03:25.50,1:03:26.58,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,1:03:26.91,1:03:29.00,Default,,0,0,0,,Мен қиналып жатырмын...
Dialogue: 0,1:03:30.12,1:03:32.79,Default,,0,0,0,,Көптен күткен Солтүстік пен Оңтүстіктің бірігуіне аз ғана уақыт қалды
Dialogue: 0,1:03:32.91,1:03:36.50,Default,,0,0,0,,Үш қасиетті қазына ақыры осы солтүстік сарайға өтеді.
Dialogue: 0,1:03:36.95,1:03:38.12,Default,,0,0,0,,Енді біз біріктірдік
Dialogue: 0,1:03:38.25,1:03:42.25,Default,,0,0,0,,Сегунат мызғымас және берік болуы керек.
Dialogue: 0,1:03:42.37,1:03:47.08,Default,,0,0,0,,Какуичи Кенгё жазған Хейке кітабы түпнұсқа кітап болып саналады.
Dialogue: 0,1:03:47.20,1:03:49.58,Default,,0,0,0,,Ха...
Dialogue: 0,1:03:52.25,1:03:54.79,Default,,0,0,0,,Кітапқа Хейке хикаясы енгізілген.
Dialogue: 0,1:03:54.91,1:03:58.20,Default,,0,0,0,,Жаңа Хейке шықпаса жақсы болар еді.
Dialogue: 0,1:04:00.08,1:04:01.12,Default,,0,0,0,,Ха…
Dialogue: 0,1:04:01.66,1:04:04.87,Default,,0,0,0,,Басқа күштер таралса, қиындық тудырар еді.
Dialogue: 0,1:04:05.00,1:04:08.62,Default,,0,0,0,,Ашикага қолдау таба алатын жалғыз адам.
Dialogue: 0,1:04:09.54,1:04:12.12,Default,,0,0,0,,Теиичи мен түсінемін.
Dialogue: 0,1:04:13.08,1:04:17.58,Default,,0,0,0,,Генерал Ашикага Йошимитсу өткізген Китайама әнінде
Dialogue: 0,1:04:17.70,1:04:21.83,Default,,0,0,0,,Бұл Хиэйзаның Саругакусын орындауға берілген бұйрық.
Dialogue: 0,1:04:29.33,1:04:31.83,Default,,0,0,0,,Бұл менің қолымнан келмейтін құрмет!
Dialogue: 0,1:04:31.95,1:04:34.95,Default,,0,0,0,,Өнерімді меңгеруге талпынғаныма қанша жыл болды?
Dialogue: 0,1:04:35.08,1:04:37.33,Default,,0,0,0,,Сегунның алдында билей алу...
Dialogue: 0,1:04:37.45,1:04:40.04,Default,,0,0,0,,Бұл сен емес, ит патшасы.
Dialogue: 0,1:04:42.08,1:04:43.25,Default,,0,0,0,,Не!
Dialogue: 0,1:04:44.25,1:04:48.58,Default,,0,0,0,,Алайда Хиезаның маңдайшасы мен!
Dialogue: 0,1:04:48.70,1:04:53.83,Default,,0,0,0,,Басқарма отырысы кезінде оның танымалдылығы Ину-одан төмен болғаны айтылады.
Dialogue: 0,1:04:56.91,1:05:00.79,Default,,0,0,0,,Оның заңды әйелі Норико-сама Инууды қалайды.
Dialogue: 0,1:05:00.91,1:05:05.41,Default,,0,0,0,,Әйтпесе, ол Ямато no Kanze no za деп атала береді.
Dialogue: 0,1:05:05.54,1:05:10.00,Default,,0,0,0,,Канзенің орны лорд Йошимицудың таңдауы!
Dialogue: 0,1:05:11.91,1:05:14.04,Default,,0,0,0,,Мен сізден бірде сұрайын деп едім.
Dialogue: 0,1:05:14.16,1:05:19.50,Default,,0,0,0,,Мен ит патшасының маскасының астында нағыз құбыжық бар деген қауесеттерді естідім.
Dialogue: 0,1:05:19.62,1:05:21.45,Default,,0,0,0,,Шынында не болып жатыр?
Dialogue: 0,1:05:23.29,1:05:24.79,Default,,0,0,0,,Бұл...
Dialogue: 0,1:05:24.91,1:05:29.29,Default,,0,0,0,,Бұл жай ғана әңгіме: Нарико-саманың ішінде бірдеңе бар.
Dialogue: 0,1:05:29.41,1:05:32.12,Default,,0,0,0,,Өйткені мен саған жаман ештеңе көрсете алмаймын.
Dialogue: 0,1:05:32.25,1:05:35.33,Default,,0,0,0,,Егер мұндай жағдай орын алса,
Dialogue: 0,1:05:35.45,1:05:41.95,Default,,0,0,0,,Танымал ит патшасының басы Камо өзенінің жағасында алынуы мүмкін.
Dialogue: 0,1:05:42.62,1:05:44.58,Default,,0,0,0,,Менің ойымша, бұл жақсы ма?
Dialogue: 0,1:05:47.25,1:05:50.04,Default,,0,0,0,,Әрине.
Dialogue: 0,1:05:50.58,1:05:59.45,Default,,0,0,0,,(Қабынды діріл дыбысы)
Dialogue: 0,1:06:00.95,1:06:02.83,Default,,0,0,0,,Бұл керемет, ит патшасы!
Dialogue: 0,1:06:02.95,1:06:04.62,Default,,0,0,0,,Жақында келеді.
Dialogue: 0,1:06:05.79,1:06:11.04,Default,,0,0,0,,Генерал маған тағы бір маңызды жайтты айтты.
Dialogue: 0,1:06:12.00,1:06:15.20,Default,,0,0,0,,Соңғы тарау бір бетпен орындалады.
Dialogue: 0,1:06:15.33,1:06:16.87,Default,,0,0,0,,На (Инуудың екінші ағасы) Ия...
Dialogue: 0,1:06:17.37,1:06:21.37,Default,,0,0,0,,Ол масканың астындағы бетті көргісі келетін сияқты.
Dialogue: 0,1:06:21.50,1:06:24.16,Default,,0,0,0,,Канзенің орны Фудзивака өзінің сұлулығымен танымал.
Dialogue: 0,1:06:24.29,1:06:28.41,Default,,0,0,0,,Көбінесе бетперде кимей билейді дейді.
Dialogue: 0,1:06:28.54,1:06:30.45,Default,,0,0,0,,Бірақ ит патшасы!
Dialogue: 0,1:06:30.58,1:06:32.12,Default,,0,0,0,,Егер сіз бас тартсаңыз...
Dialogue: 0,1:06:33.08,1:06:34.62,Default,,0,0,0,,Бұл болған жоқ.
Dialogue: 0,1:06:34.75,1:06:37.25,Default,,0,0,0,,Әуелі, шіркін түріңді көрсетсең,
Dialogue: 0,1:06:37.37,1:06:39.25,Default,,0,0,0,,Сіздің мойныңызға қауіп төніп тұр.
Dialogue: 0,1:06:39.37,1:06:40.37,Default,,0,0,0,,Бұл оқиға...
Dialogue: 0,1:06:40.50,1:06:41.75,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:06:41.87,1:06:44.50,Default,,0,0,0,,Мен сенің сұрағаныңды орындаймын.
Dialogue: 0,1:06:44.62,1:06:46.04,Default,,0,0,0,,Иә? Ха
Dialogue: 0,1:06:46.33,1:06:47.70,Default,,0,0,0,,Ең үздік батыр болу үшін
Dialogue: 0,1:06:48.58,1:06:53.79,Default,,0,0,0,,Бивамен (елестердің дауыстары)
Dialogue: 0,1:06:54.16,1:06:58.70,Default,,0,0,0,,♪Енді уақыт келді
Dialogue: 0,1:06:59.00,1:07:05.29,Default,,0,0,0,,♪Қарғысқа боялған адам, Даңқының шыңында
Dialogue: 0,1:07:05.41,1:07:10.25,Default,,0,0,0,,♪Генералға қарау берілген
Dialogue: 0,1:07:10.37,1:07:15.58,Default,,0,0,0,,♪Өмірде бір рет болатын шуақты кезең
Dialogue: 0,1:07:15.70,1:07:21.66,Default,,0,0,0,,(Халықтың қошеметі)
Dialogue: 0,1:07:26.16,1:07:31.87,Default,,0,0,0,,♪Ән айтып, билеп, жынды бол
Dialogue: 0,1:07:32.00,1:07:33.75,Default,,0,0,0,,О!
Dialogue: 0,1:07:33.87,1:07:41.08,Default,,0,0,0,,♪Хейкенің барлық елестері Буддалық дәрежесіне жетсін.
Dialogue: 0,1:07:41.20,1:07:45.95,Default,,0,0,0,,♪Шуақты кезеңнің шарықтау шегі
Dialogue: 0,1:07:46.08,1:07:51.58,Default,,0,0,0,,♪Оны бізбен бірге көрейік
Dialogue: 0,1:07:52.08,1:07:54.62,Default,,0,0,0,,Соңында бір жүзбен билейтін сияқты
Dialogue: 0,1:07:54.75,1:07:56.58,Default,,0,0,0,,Әдемі деген өсек
Dialogue: 0,1:07:56.70,1:07:59.70,Default,,0,0,0,,Орындау кезінде бетін алу
Dialogue: 0,1:07:59.83,1:08:01.79,Default,,0,0,0,,Гитамен бол
Dialogue: 0,1:08:01.91,1:08:04.37,Default,,0,0,0,,Қорқынышты бет т.б.
Dialogue: 0,1:08:04.50,1:08:08.62,Default,,0,0,0,,Құпия ашылды
Dialogue: 0,1:08:08.75,1:08:10.75,Default,,0,0,0,,~♪
Dialogue: 0,1:08:11.75,1:08:15.08,Default,,0,0,0,,Соңында жалғыз бетке билейтін сияқты.
Dialogue: 0,1:08:15.20,1:08:16.79,Default,,0,0,0,,Гитамен бол
Dialogue: 0,1:08:16.91,1:08:18.45,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,1:08:18.58,1:08:22.62,Default,,0,0,0,,Мен мұндай сахна бива діни қызметкеріне келеді деп ешқашан күтпедім.
Dialogue: 0,1:08:22.75,1:08:25.45,Default,,0,0,0,,Тұрақты және біркелкі кескіш көз.
Dialogue: 0,1:08:26.62,1:08:28.20,Default,,0,0,0,,Ит патшасы!
Dialogue: 0,1:08:28.33,1:08:31.12,Default,,0,0,0,,Ит патшасы! (Асыл адам) Inuou~
Dialogue: 0,1:08:33.16,1:08:35.12,Default,,0,0,0,,Ит патшасы!
Dialogue: 0,1:08:35.25,1:08:37.45,Default,,0,0,0,,Мырза, тағы бір айдаһар болады ма?
Dialogue: 0,1:08:37.87,1:08:41.70,Default,,0,0,0,,Маңызды уақыт болғандықтан, қатты толқымаңыз.
Dialogue: 0,1:08:41.83,1:08:45.91,Default,,0,0,0,,Инуудың сахнасы өте қызықты, мен бір орында отыра алмаймын.
Dialogue: 0,1:08:46.04,1:08:47.54,Default,,0,0,0,,Ит патшалары қарапайым адамдар ғана емес.
Dialogue: 0,1:08:47.66,1:08:51.79,Default,,0,0,0,,Ол сарай дворяндары мен самурайлардың жүрегін жаулап алды.
Dialogue: 0,1:08:52.45,1:08:56.04,Default,,0,0,0,,Басқалар қабылдамауы үшін неге бізге көбірек қолдау көрсетпейсіз?
Dialogue: 0,1:08:56.16,1:08:59.83,Default,,0,0,0,,Фудзивакаға ғана назар аудармаңыз.
Dialogue: 0,1:09:02.79,1:09:04.62,Default,,0,0,0,,(Елестердің дауыстары)
Dialogue: 0,1:09:04.75,1:09:06.91,Default,,0,0,0,,Елес кәдімгіден де қобалжыды.
Dialogue: 0,1:09:07.04,1:09:09.66,Default,,0,0,0,,Мен бұл менің соңғы күнім екенін білемін.
Dialogue: 0,1:09:10.04,1:09:14.33,Default,,0,0,0,,Біз Буддалыққа қол жеткіземіз бе? А... Менің басым ұшып кете ме?
Dialogue: 0,1:09:14.45,1:09:16.41,Default,,0,0,0,,Екіден бір
Dialogue: 0,1:09:16.58,1:09:20.16,Default,,0,0,0,,Бұл соңғы кезең болуы мүмкін.
Dialogue: 0,1:09:20.29,1:09:24.50,Default,,0,0,0,,Nukase Біз осы жерден бастаймыз.
Dialogue: 0,1:09:25.04,1:09:29.00,Default,,0,0,0,,Бізден басқа бәріміз Буддалыққа жетейік.
Dialogue: 0,1:09:29.45,1:09:31.29,Default,,0,0,0,,Ит патшасы
Dialogue: 0,1:09:31.41,1:09:33.87,Default,,0,0,0,,Ит патшасы~!
Dialogue: 0,1:09:38.04,1:09:39.33,Default,,0,0,0,,Не болса да...!
Dialogue: 0,1:09:39.45,1:09:41.37,Default,,0,0,0,,Біз қазір осындамыз
Dialogue: 0,1:09:41.50,1:09:43.58,Default,,0,0,0,,Барлығың жұдырықтай жұмыңдар
Dialogue: 0,1:09:44.70,1:09:45.91,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:09:46.25,1:09:47.29,Default,,0,0,0,,О!!
Dialogue: 0,1:09:47.41,1:09:48.79,Default,,0,0,0,,О!
Dialogue: 0,1:09:49.00,1:09:52.37,Default,,0,0,0,,«Рю Чушо» Инуу
Dialogue: 0,1:09:59.91,1:10:02.16,Default,,0,0,0,,Ай күннің жанында
Dialogue: 0,1:10:03.08,1:10:08.50,Default,,0,0,0,,♪Кеңейіп жатқан теңізге
Dialogue: 0,1:10:08.79,1:10:13.75,Default,,0,0,0,,♪Жүзбелі дене
Dialogue: 0,1:10:13.87,1:10:19.41,Default,,0,0,0,,♪Өткен, бүгін және болашақ
Dialogue: 0,1:10:20.20,1:10:24.87,Default,,0,0,0,,♪ Еріп кетеді
Dialogue: 0,1:10:25.16,1:10:30.87,Default,,0,0,0,,♪Сен тірісің бе?
Dialogue: 0,1:10:31.00,1:10:38.66,Default,,0,0,0,,♪Сен өлдің бе?
Dialogue: 0,1:10:38.79,1:10:44.58,Default,,0,0,0,,♪Елес сияқты
Dialogue: 0,1:10:44.70,1:10:52.20,Default,,0,0,0,,♪ Тек сол жерде тұрмын
Dialogue: 0,1:10:52.33,1:10:58.29,Default,,0,0,0,,♪Есте сақтаңыз
Dialogue: 0,1:10:58.41,1:11:05.62,Default,,0,0,0,,♪Менің атым
Dialogue: 0,1:11:05.75,1:11:11.41,Default,,0,0,0,,♪Гейк генерал-лейтенант
Dialogue: 0,1:11:11.54,1:11:19.50,Default,,0,0,0,,♪Бұл кім болды?
Dialogue: 0,1:11:22.62,1:11:28.83,Default,,0,0,0,,♪Арман
Dialogue: 0,1:11:28.95,1:11:35.50,Default,,0,0,0,,♪Рюгудың соңында
Dialogue: 0,1:11:35.79,1:11:41.95,Default,,0,0,0,,♪Шынайылық пен адалдық
Dialogue: 0,1:11:42.08,1:11:50.50,Default,,0,0,0,,♪Мағынасы бар ма?
Dialogue: 0,1:11:57.62,1:12:00.25,Default,,0,0,0,,Мен сендерді сахнаға шығара алмаймын.
Dialogue: 0,1:12:00.37,1:12:02.00,Default,,0,0,0,,Бұл Хиеиза кезеңі.
Dialogue: 0,1:12:06.62,1:12:12.41,Default,,0,0,0,,♪ Мен өзімді қайда тастадым
Dialogue: 0,1:12:12.54,1:12:19.79,Default,,0,0,0,,♪Капитал бар
Dialogue: 0,1:12:19.91,1:12:26.00,Default,,0,0,0,,♪Мен сендім, сүңгідім
Dialogue: 0,1:12:26.12,1:12:33.29,Default,,0,0,0,,♪Тыныштық іздеу
Dialogue: 0,1:12:33.41,1:12:40.29,Default,,0,0,0,,♪«Егер сен сенсең»
Dialogue: 0,1:12:40.41,1:12:50.29,Default,,0,0,0,,♪«Біз сонда жете аламыз.»
Dialogue: 0,1:12:51.12,1:12:54.41,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,1:12:55.08,1:12:57.79,Default,,0,0,0,,Не болды? Елестер Буддалыққа жете алмайды.
Dialogue: 0,1:12:57.91,1:12:59.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:12:59.33,1:13:00.41,Default,,0,0,0,,Бірдеңе жетіспеді ме?
Dialogue: 0,1:13:00.95,1:13:02.16,Default,,0,0,0,,Неліктен Буддалыққа жете алмайсың?
Dialogue: 0,1:13:04.00,1:13:05.41,Default,,0,0,0,,Оны әлі алған жоқсыз ба?
Dialogue: 0,1:13:07.70,1:13:09.54,Default,,0,0,0,,Оқиға алынбады
Dialogue: 0,1:13:09.66,1:13:11.66,Default,,0,0,0,,~♪
Dialogue: 0,1:13:12.41,1:13:15.04,Default,,0,0,0,,♪Арманға апаратын бір ғана жол бар
Dialogue: 0,1:13:15.16,1:13:18.58,Default,,0,0,0,,♪Бұл дұрыс Heike жолы
Dialogue: 0,1:13:18.70,1:13:21.54,Default,,0,0,0,,♪Мен жоғалып кеткен отбасын ұмытамын
Dialogue: 0,1:13:21.66,1:13:24.33,Default,,0,0,0,,♪ Деформация және соқырлық арқылы жиналады
Dialogue: 0,1:13:24.62,1:13:25.91,Default,,0,0,0,,♪ Арман (Инуу) ♪ Сол қолдармен
Dialogue: 0,1:13:26.08,1:13:27.33,Default,,0,0,0,,♪Не қаласаңыз да
Dialogue: 0,1:13:27.50,1:13:29.04,Default,,0,0,0,,♪Таң қалды (Томоари)♪Күле бастайды
Dialogue: 0,1:13:29.33,1:13:31.62,Default,,0,0,0,,♪ Ченнің арманымен бірге
Dialogue: 0,1:13:31.75,1:13:43.20,Default,,0,0,0,,(хормен)
Dialogue: 0,1:13:46.41,1:13:49.54,Default,,0,0,0,,♪Естілу керек дауыстар
Dialogue: 0,1:13:49.66,1:13:52.58,Default,,0,0,0,,♪Неге! ести алмайды
Dialogue: 0,1:13:52.70,1:13:55.87,Default,,0,0,0,,♪ Жауап! Өтінемін, маған жауап беріңізші
Dialogue: 0,1:13:56.04,1:13:58.95,Default,,0,0,0,,♪Неге?
Dialogue: 0,1:13:59.37,1:14:02.12,Default,,0,0,0,,♪Неге?
Dialogue: 0,1:14:02.25,1:14:05.20,Default,,0,0,0,,♪Бірдеңе кедергі болып тұр
Dialogue: 0,1:14:05.33,1:14:08.29,Default,,0,0,0,,♪Бар
Dialogue: 0,1:14:08.41,1:14:13.12,Default,,0,0,0,,♪Нағыз тұлғаны анықтайтын уақыт келді
Dialogue: 0,1:14:13.25,1:14:17.75,Default,,0,0,0,,♪Терең сүңгіңіз, енді алыңыз!
Dialogue: 0,1:14:17.87,1:14:31.50,Default,,0,0,0,,♪
Dialogue: 0,1:14:31.87,1:14:34.25,Default,,0,0,0,,Қасиетті қазына көргенде не болады?
Dialogue: 0,1:14:34.37,1:14:36.66,Default,,0,0,0,,Бұл рас болды.
Dialogue: 0,1:14:38.70,1:14:41.08,Default,,0,0,0,,Бұл жолы қаптан шығарудың қажеті жоқ.
Dialogue: 0,1:14:41.20,1:14:45.12,Default,,0,0,0,,Бұл дүниені біріктіру үшін жоғарының бұйрығы.
Dialogue: 0,1:14:45.25,1:14:47.08,Default,,0,0,0,,Қорқынышты
Dialogue: 0,1:14:47.20,1:14:50.95,Default,,0,0,0,,Бізге ең болмаса үш қасиетті қазынаның біреуі керек.
Dialogue: 0,1:14:52.54,1:14:55.95,Default,,0,0,0,,Мен туралы жеткілікті, ит патша туралы айтайық.
Dialogue: 0,1:14:56.08,1:15:14.08,Default,,0,0,0,,♪
Dialogue: 0,1:15:14.58,1:15:20.58,Default,,0,0,0,,♪Бұл қалада не танымал
Dialogue: 0,1:15:20.75,1:15:26.87,Default,,0,0,0,,♪Түнде ұрлық, жалған соғыс
Dialogue: 0,1:15:27.25,1:15:33.16,Default,,0,0,0,,♪Басы кесілген бас діни қызметкер Буку Даймё
Dialogue: 0,1:15:33.29,1:15:36.25,Default,,0,0,0,,♪Әбігер
Dialogue: 0,1:15:36.37,1:15:38.37,Default,,0,0,0,,♪~
Dialogue: 0,1:15:43.20,1:15:45.25,Default,,0,0,0,,Ах... (тайғанақ, құлаған дыбыс)
Dialogue: 0,1:15:47.58,1:15:50.75,Default,,0,0,0,,Бұлай емес Бұлай емес!
Dialogue: 0,1:15:51.37,1:15:54.16,Default,,0,0,0,,Сіз болғыңыз келе ме?
Dialogue: 0,1:15:57.83,1:16:03.83,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:16:04.16,1:16:06.25,Default,,0,0,0,,(Найзағай)
Dialogue: 0,1:16:17.83,1:16:23.79,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:16:42.95,1:16:44.91,Default,,0,0,0,,Сіз болғыңыз келе ме?
Dialogue: 0,1:16:45.04,1:16:46.70,Default,,0,0,0,,Мен болғым келеді...
Dialogue: 0,1:16:47.00,1:16:50.50,Default,,0,0,0,,Мен өмірімдегі ең тамаша адам болғым келеді.
Dialogue: 0,1:16:50.62,1:16:57.33,Default,,0,0,0,,Мен сендерге ерекше оқиға беремін.
Dialogue: 0,1:17:00.29,1:17:07.04,Default,,0,0,0,,Хейке руының ұрпақтары жасырынған жасырын алқап
Dialogue: 0,1:17:07.87,1:17:12.12,Default,,0,0,0,,Онда сирек кездесетін Хайке бар.
Dialogue: 0,1:17:12.25,1:17:15.37,Default,,0,0,0,,ұйықтау
Dialogue: 0,1:17:16.20,1:17:21.04,Default,,0,0,0,,Биуа шеберлерінің жинаған әңгімелері
Dialogue: 0,1:17:21.29,1:17:24.37,Default,,0,0,0,,Мен оны саған беремін
Dialogue: 0,1:17:24.50,1:17:26.54,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:17:27.29,1:17:32.54,Default,,0,0,0,,Әр адамға бір
Dialogue: 0,1:17:34.16,1:17:37.33,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,1:17:38.62,1:17:41.25,Default,,0,0,0,,(Елестердің дауыстары)
Dialogue: 0,1:17:41.37,1:17:46.45,Default,,0,0,0,,Иә, бәрі менікі!
Dialogue: 0,1:17:49.79,1:17:52.91,Default,,0,0,0,,Бұл тек менікі...
Dialogue: 0,1:17:58.25,1:18:02.04,Default,,0,0,0,,Әлі емес... әлі де жеткіліксіз
Dialogue: 0,1:18:02.58,1:18:04.87,Default,,0,0,0,,Сұлулықты әлі де меңгеру керек!
Dialogue: 0,1:18:05.00,1:18:07.00,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,1:18:07.79,1:18:09.50,Default,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,1:18:09.62,1:18:13.62,Default,,0,0,0,,Өзіңіздің керемет кінәсіздігіңізді ұсыныңыз
Dialogue: 0,1:18:13.75,1:18:14.66,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:18:14.79,1:18:17.16,Default,,0,0,0,,Оны ұсыныңыз.
Dialogue: 0,1:18:17.29,1:18:18.75,Default,,0,0,0,,Жарайды, міне, гострайтингі тапсырысы формасы.
Dialogue: 0,1:18:19.29,1:18:20.83,Default,,0,0,0,,Хаа…
Dialogue: 0,1:18:22.16,1:18:24.16,Default,,0,0,0,,Түсінікті.
Dialogue: 0,1:18:26.45,1:18:27.91,Default,,0,0,0,,Сәлем
Dialogue: 0,1:18:28.04,1:18:30.41,Default,,0,0,0,,Барлығын ал!
Dialogue: 0,1:18:33.00,1:18:37.83,Default,,0,0,0,,Тоқта! Мен өлемін. Ит патшасы өледі.
Dialogue: 0,1:18:38.04,1:18:41.00,Default,,0,0,0,,Бұл тым көп, көмектесіңізші.
Dialogue: 0,1:18:41.12,1:18:44.37,Default,,0,0,0,,Енді бәрі жақсы!
Dialogue: 0,1:18:45.25,1:18:46.41,Default,,0,0,0,,Біреу!!
Dialogue: 0,1:18:46.54,1:18:52.54,Default,,0,0,0,,(Елестердің дауыстары)
Dialogue: 0,1:19:01.45,1:19:02.45,Default,,0,0,0,,Ha
Dialogue: 0,1:19:03.45,1:19:04.58,Default,,0,0,0,,алынды
Dialogue: 0,1:19:04.70,1:19:06.00,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,1:19:06.12,1:19:07.50,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,1:19:08.08,1:19:10.00,Default,,0,0,0,,А, мен көрдім.
Dialogue: 0,1:19:10.45,1:19:14.83,Default,,0,0,0,,(Елестердің дауыстары)
Dialogue: 0,1:19:18.41,1:19:24.95,Default,,0,0,0,,♪Тіпті естеліктер
Dialogue: 0,1:19:25.08,1:19:32.58,Default,,0,0,0,,♪ Түс көргеннен кейін
Dialogue: 0,1:19:33.20,1:19:39.87,Default,,0,0,0,,♪Бұл Хайке
Dialogue: 0,1:19:41.50,1:19:48.20,Default,,0,0,0,,♪Арман оқиғасы
Dialogue: 0,1:19:49.54,1:19:56.37,Default,,0,0,0,,♪Біз мұнда ән айту үшін жиналамыз
Dialogue: 0,1:19:57.66,1:20:05.29,Default,,0,0,0,,♪Сутра «Айдаһар хайуан сутрасы»
Dialogue: 0,1:20:05.95,1:20:12.45,Default,,0,0,0,,♪Мұхит түбіне дейін
Dialogue: 0,1:20:12.58,1:20:20.29,Default,,0,0,0,,♪Маған тек әндер жетеді
Dialogue: 0,1:20:31.75,1:20:33.95,Default,,0,0,0,,Жоқ, әңгіме басқаша.
Dialogue: 0,1:20:34.08,1:20:36.29,Default,,0,0,0,,Ол жерде мен болуым керек еді.
Dialogue: 0,1:20:37.79,1:20:41.58,Default,,0,0,0,,Неге, бұл мен болуым керек, неге әлгі құбыжық!
Dialogue: 0,1:20:41.70,1:20:45.45,Default,,0,0,0,,Гүлденген мен болуым керек
Dialogue: 0,1:20:46.04,1:20:50.25,Default,,0,0,0,,Керемет емес...?
Dialogue: 0,1:20:50.37,1:20:53.70,Default,,0,0,0,,Дұрыс, мен болуым керек. Сіз сенімдісіз бе?
Dialogue: 0,1:20:54.87,1:20:57.33,Default,,0,0,0,,Көбірек алғыңыз келе ме...
Dialogue: 0,1:20:57.45,1:20:59.20,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,1:20:59.50,1:21:02.00,Default,,0,0,0,,Мына құбыжықты жерлеңіз!
Dialogue: 0,1:21:09.58,1:21:12.83,Default,,0,0,0,,Сіз ұсынған бала?
Dialogue: 0,1:21:12.95,1:21:15.45,Default,,0,0,0,,Иә, өшіріңіз!
Dialogue: 0,1:21:15.58,1:21:21.45,Default,,0,0,0,,♪ Бар ма?
Dialogue: 0,1:21:26.58,1:21:33.95,Default,,0,0,0,,♪Ол болуы керек
Dialogue: 0,1:21:34.29,1:21:36.45,Default,,0,0,0,,Тез, мына құбыжық!
Dialogue: 0,1:21:38.33,1:21:42.54,Default,,0,0,0,,Уәдеде тұрасың ба...
Dialogue: 0,1:21:43.08,1:21:47.95,Default,,0,0,0,,Сен маған бергеніңді құрт деп жатырсың.
Dialogue: 0,1:21:50.54,1:21:51.87,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:21:52.00,1:21:56.00,Default,,0,0,0,,Содан кейін оны бұзу керек.
Dialogue: 0,1:21:59.20,1:22:05.79,Default,,0,0,0,,♪Рюгуджо
Dialogue: 0,1:22:05.91,1:22:08.91,Default,,0,0,0,,♪Болады, болады, болады.
Dialogue: 0,1:22:09.04,1:22:12.08,Default,,0,0,0,,♪Мен үнемі соны іздедім
Dialogue: 0,1:22:12.20,1:22:15.62,Default,,0,0,0,,♪Жететіндермен ән
Dialogue: 0,1:22:15.75,1:22:18.79,Default,,0,0,0,,♪Мен оны таптым
Dialogue: 0,1:22:18.91,1:22:22.12,Default,,0,0,0,,♪Ал мен оны түсінгенім үшін марапатқа ие болдым.
Dialogue: 0,1:22:22.25,1:22:32.33,Default,,0,0,0,,♪Рюгу сарайына келдік
Dialogue: 0,1:22:32.45,1:22:39.95,Default,,0,0,0,,♪Ра рах рах рах рах рах
Dialogue: 0,1:22:40.08,1:22:45.12,Default,,0,0,0,,♪ Ла ла ла ла ла
Dialogue: 0,1:22:45.25,1:22:53.00,Default,,0,0,0,,♪Біздің жүрегіміз
Dialogue: 0,1:22:53.12,1:23:02.08,Default,,0,0,0,,♪Біз мұнда біргеміз
Dialogue: 0,1:23:02.70,1:23:03.66,Default,,0,0,0,,Кеттік, кеттік
Dialogue: 0,1:23:03.79,1:23:05.33,Default,,0,0,0,,Міне, міне! иә?
Dialogue: 0,1:23:11.45,1:23:15.66,Default,,0,0,0,,Бүгін, дәл осы күн үшін, Томури-заны жабыңыз!
Dialogue: 0,1:23:15.79,1:23:19.83,Default,,0,0,0,,Өйткені жаңа Хэйкёку тыйымның ұлылығын бұзады!
Dialogue: 0,1:23:20.08,1:23:21.58,Default,,0,0,0,,Тецу (Бива Хоши) Ах!
Dialogue: 0,1:23:24.20,1:23:27.20,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,1:23:28.70,1:23:31.50,Default,,0,0,0,,Ей, жолдан кет! Түсіңіз, түсіңіз
Dialogue: 0,1:23:31.62,1:23:33.95,Default,,0,0,0,,Ей, қайт, қайт!
Dialogue: 0,1:23:36.91,1:23:40.45,Default,,0,0,0,,Тодоза әлемде танылған жалғыз Бива орны болды.
Dialogue: 0,1:23:40.58,1:23:44.79,Default,,0,0,0,,Бастапқы кітапқа енбеген әнді орындауға болмайды.
Dialogue: 0,1:23:44.91,1:23:46.04,Default,,0,0,0,,Тоқтаңыз!
Dialogue: 0,1:23:46.16,1:23:49.16,Default,,0,0,0,,Мені кешіріңіз! Ааа...
Dialogue: 0,1:23:49.29,1:23:50.79,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,1:23:53.37,1:23:59.08,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:24:00.62,1:24:02.00,Default,,0,0,0,,Ой! (Адам) Не?
Dialogue: 0,1:24:02.12,1:24:03.50,Default,,0,0,0,,(ит үреді)
Dialogue: 0,1:24:03.62,1:24:06.37,Default,,0,0,0,,Тұрақты! Уф...
Dialogue: 0,1:24:07.58,1:24:08.58,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:24:08.70,1:24:09.83,Default,,0,0,0,,Тұрақты!
Dialogue: 0,1:24:09.95,1:24:13.04,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:24:13.16,1:24:14.87,Default,,0,0,0,,(сенсорлық дыбыс)
Dialogue: 0,1:24:16.37,1:24:19.66,Default,,0,0,0,,Бекітілген біркелкі бекітілген форма!
Dialogue: 0,1:24:19.79,1:24:21.29,Default,,0,0,0,,Томоари?!
Dialogue: 0,1:24:21.41,1:24:24.33,Default,,0,0,0,,Менің орным...оның үстінде отырғандар қатты зардап шекті.
Dialogue: 0,1:24:25.66,1:24:28.29,Default,,0,0,0,,Неге біздің әндерді айтпайсың?
Dialogue: 0,1:24:28.41,1:24:30.25,Default,,0,0,0,,Томуриза жақсы емес пе?
Dialogue: 0,1:24:30.37,1:24:35.29,Default,,0,0,0,,Лорд Какуичи Хейке отбасының түпнұсқа қолжазбаларын құрастырды.
Dialogue: 0,1:24:35.45,1:24:40.25,Default,,0,0,0,,Кітапта жазылмаған Хайке енді ән айта алмайды.
Dialogue: 0,1:24:40.37,1:24:42.41,Default,,0,0,0,,Бірақ біздің ән!
Dialogue: 0,1:24:43.45,1:24:45.79,Default,,0,0,0,,Сегунат осылай шешті.
Dialogue: 0,1:24:46.33,1:24:48.91,Default,,0,0,0,,Маған ұнамайды. Ит патшасының әңгімесі ит патшаға тиесілі.
Dialogue: 0,1:24:49.04,1:24:51.25,Default,,0,0,0,,Ән айту – менің әңгімем
Dialogue: 0,1:24:51.37,1:24:54.00,Default,,0,0,0,,Сіз оны алып кетемін дейсіз бе?
Dialogue: 0,1:24:54.87,1:24:58.83,Default,,0,0,0,,Томоари Қанағаттанбасаңыз да, ``ари'' сөзін тастаңыз.
Dialogue: 0,1:24:58.95,1:25:01.41,Default,,0,0,0,,Тодозаға оралыңыз.
Dialogue: 0,1:25:01.54,1:25:03.95,Default,,0,0,0,,Менің атым Томоари. Менің атым Томоари.
Dialogue: 0,1:25:04.08,1:25:05.66,Default,,0,0,0,,Мен бұл есімді өзім таңдадым.
Dialogue: 0,1:25:05.79,1:25:07.91,Default,,0,0,0,,Біз осындамыз!
Dialogue: 0,1:25:09.62,1:25:11.54,Default,,0,0,0,,Ит патшасы келісті.
Dialogue: 0,1:25:11.66,1:25:16.50,Default,,0,0,0,,Менің жаңа Хайкеге немесе өзімнің әңгімеме қатысым жоқ.
Dialogue: 0,1:25:16.62,1:25:17.62,Default,,0,0,0,,Маған ол маңызды емес! Рем ше? Ремге не болды!
Dialogue: 0,1:25:17.75,1:25:19.66,Default,,0,0,0,,Бұл өтірік, амал жоқ
Dialogue: 0,1:25:19.79,1:25:22.29,Default,,0,0,0,,Бұл біздің әңгімеміз, бұл біздің әніміз!
Dialogue: 0,1:25:22.41,1:25:23.37,Default,,0,0,0,,Досым!
Dialogue: 0,1:25:23.50,1:25:25.54,Default,,0,0,0,,Ит патшасы Томоариге елікте
Dialogue: 0,1:25:25.66,1:25:27.41,Default,,0,0,0,,(есік құлаған дыбыс)
Dialogue: 0,1:25:27.54,1:25:29.70,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,1:25:29.83,1:25:34.12,Default,,0,0,0,,Томоари! Томуриза тарап кетуі керек еді.
Dialogue: 0,1:25:34.25,1:25:37.66,Default,,0,0,0,,Мен сізді тыйымды бұзғаны үшін алып кетемін (Томоари) Уф...
Dialogue: 0,1:25:37.79,1:25:38.79,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,1:25:38.91,1:25:41.12,Default,,0,0,0,,Томоари өзіңізді Юичи деп атаңыз.
Dialogue: 0,1:25:41.25,1:25:44.29,Default,,0,0,0,,Жоқ! (Самурай) Сен маған бағынбайсың ба?
Dialogue: 0,1:25:44.54,1:25:47.87,Default,,0,0,0,,Бұл адам Юичи, Тодоза.
Dialogue: 0,1:25:48.00,1:25:49.20,Default,,0,0,0,,Зорлық-зомбылықты тоқтатыңыз
Dialogue: 0,1:25:49.33,1:25:52.62,Default,,0,0,0,,Бұл Какуичи-саманың Тодозасында.
Dialogue: 0,1:25:52.75,1:25:57.16,Default,,0,0,0,,Бұл адам түпнұсқада жоқ әндерді ойнатпайды!
Dialogue: 0,1:25:57.29,1:25:59.87,Default,,0,0,0,,Мен Томоаризаның Томоаримін.
Dialogue: 0,1:26:00.00,1:26:02.45,Default,,0,0,0,,Жауапсыз оқиғаны теріп ал
Dialogue: 0,1:26:02.58,1:26:06.20,Default,,0,0,0,,Юичи тез Юичи болса... Юичи болса!
Dialogue: 0,1:26:06.58,1:26:09.41,Default,,0,0,0,,Біз тарихымыздың жойылуына жол бермейміз!
Dialogue: 0,1:26:09.54,1:26:10.58,Default,,0,0,0,,Уф...
Dialogue: 0,1:26:10.70,1:26:12.41,Default,,0,0,0,,Уф...
Dialogue: 0,1:26:13.41,1:26:15.79,Default,,0,0,0,,Бұл жігіт... (Тэйчи) Таничи?
Dialogue: 0,1:26:15.91,1:26:16.91,Default,,0,0,0,,Тани мырза
Dialogue: 0,1:26:17.41,1:26:19.33,Default,,0,0,0,,Жолға түсіңіз
Dialogue: 0,1:26:19.54,1:26:22.66,Default,,0,0,0,,Таничи! (Бива шеберлері) Тани мырза!
Dialogue: 0,1:26:24.87,1:26:25.91,Default,,0,0,0,,Бауырым!
Dialogue: 0,1:26:26.29,1:26:30.29,Default,,0,0,0,,Мына жігіттер жақсы... Уф
Dialogue: 0,1:26:30.41,1:26:33.91,Default,,0,0,0,,Мен Томоаримін, қашпаймын, тығылмаймын!
Dialogue: 0,1:26:34.04,1:26:35.54,Default,,0,0,0,,Өз атыңызды таңдаңыз
Dialogue: 0,1:26:35.66,1:26:38.00,Default,,0,0,0,,Йосе Юичи (Томоари) Ешкім... Ешкім...
Dialogue: 0,1:26:38.12,1:26:39.75,Default,,0,0,0,,Юичи! (Томоари) Мен сізге кедергі келтірмеймін!
Dialogue: 0,1:26:39.87,1:26:44.37,Default,,0,0,0,,Ах, а... (Томоари) Ах!
Dialogue: 0,1:26:44.95,1:26:45.95,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,1:26:46.45,1:26:49.45,Default,,0,0,0,,Жібер, жібер
Dialogue: 0,1:26:49.58,1:26:52.75,Default,,0,0,0,,Бауырым~!
Dialogue: 0,1:27:05.79,1:27:11.08,Default,,0,0,0,,Ақырында, мұнда сенен басқа гүлдер билеп жатыр, Инуу.
Dialogue: 0,1:27:11.20,1:27:12.45,Default,,0,0,0,,Га
Dialogue: 0,1:27:12.58,1:27:13.70,Default,,0,0,0,,Би қашан басталады?
Dialogue: 0,1:27:13.83,1:27:18.33,Default,,0,0,0,,Бұл дүниеден тыс болып көрінген керемет және күшті оқиға болды.
Dialogue: 0,1:27:18.45,1:27:21.12,Default,,0,0,0,,Алғыс және бақыт сөздері
Dialogue: 0,1:27:21.91,1:27:23.70,Default,,0,0,0,,Алайда ит патшасы
Dialogue: 0,1:27:23.83,1:27:27.41,Default,,0,0,0,,Сіздің Хейке тым ауытқыған, оны қайталамаңыз.
Dialogue: 0,1:27:28.12,1:27:31.50,Default,,0,0,0,,Хейкенің әңгімелері түпнұсқа мәтінінде біртұтас болды.
Dialogue: 0,1:27:34.12,1:27:37.04,Default,,0,0,0,,Мен қорқамын, Шогун-сама, менің Хэйкем...
Dialogue: 0,1:27:37.16,1:27:39.66,Default,,0,0,0,,Томоариза таратылды.
Dialogue: 0,1:27:40.79,1:27:43.37,Default,,0,0,0,,Өйткені мен ит патшасының Хейке руын жауып тастаймын.
Dialogue: 0,1:27:43.50,1:27:48.70,Default,,0,0,0,,Бұл дүниеде мөрленген мазмұнды сөйлейтін биуа шебері болса, дүние дүр сілкіндіреді.
Dialogue: 0,1:27:50.12,1:27:54.00,Default,,0,0,0,,Өйткені бірлік үшін тәртіп керек.
Dialogue: 0,1:27:55.50,1:27:58.20,Default,,0,0,0,,Бива діни қызметкерімен кездеспеңіз
Dialogue: 0,1:28:00.83,1:28:02.04,Default,,0,0,0,,Егер мен...
Dialogue: 0,1:28:02.16,1:28:05.08,Default,,0,0,0,,Егер мен сізге Хайке отбасын ешқашан тастамайтынымды айтсам...
Dialogue: 0,1:28:05.20,1:28:08.87,Default,,0,0,0,,Сіз өзен жағасында жатқан бива діни қызметкерінің басын көргіңіз келе ме?
Dialogue: 0,1:28:10.41,1:28:12.29,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,1:28:16.95,1:28:20.45,Default,,0,0,0,,Хахахаха...
Dialogue: 0,1:28:20.58,1:28:25.41,Default,,0,0,0,,Мен қуана-қуана әңгімелерімді өзенге жіберемін.
Dialogue: 0,1:28:25.54,1:28:29.41,Default,,0,0,0,,Ху... Менің Бива Хошимен ешқандай қатысым жоқ.
Dialogue: 0,1:28:29.54,1:28:33.29,Default,,0,0,0,,Бұдан былай! Тек Иеміз үшін
Dialogue: 0,1:28:33.41,1:28:38.45,Default,,0,0,0,,Әсем биді тамашалаңыз
Dialogue: 0,1:28:38.58,1:28:39.62,Default,,0,0,0,,Жақсы айтылған
Dialogue: 0,1:28:39.75,1:28:43.29,Default,,0,0,0,,Биіңді көре алмасам, мұңаямын.
Dialogue: 0,1:28:44.04,1:28:45.45,Default,,0,0,0,,Хаха!
Dialogue: 0,1:28:49.45,1:28:50.45,Default,,0,0,0,,Хаа…
Dialogue: 0,1:28:53.08,1:28:59.04,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:29:01.75,1:29:06.70,Default,,0,0,0,,♪Инуу оқиғасы бір кездері тыйым салынған.
Dialogue: 0,1:29:07.00,1:29:13.25,Default,,0,0,0,,♪ Қасиетті үш қазынаны аңсаған дүниенің Ашикағасы
Dialogue: 0,1:29:14.29,1:29:18.91,Default,,0,0,0,,♪Дан-но-урада әкемнің өмірін қидым.
Dialogue: 0,1:29:20.04,1:29:24.29,Default,,0,0,0,,♪Анамның да үмітін үзген Ашықағаны жек көрді.
Dialogue: 0,1:29:24.41,1:29:27.45,Default,,0,0,0,,Бұл не? (Терако) Жүр...
Dialogue: 0,1:29:27.79,1:29:31.25,Default,,0,0,0,,Қолыңызды қалтаңызға салыңыз (ақша дыбысы)
Dialogue: 0,1:29:34.50,1:29:35.50,Default,,0,0,0,,Хун
Dialogue: 0,1:29:35.62,1:29:39.37,Default,,0,0,0,,Бива діни қызметкері оны Үлкен залдың қабіріне апаруымды өтінді.
Dialogue: 0,1:29:39.50,1:29:41.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:41.20,1:29:45.58,Default,,0,0,0,,♪ Тенчу Ашикаға Тенчу Ашикаға
Dialogue: 0,1:29:45.70,1:29:48.75,Default,,0,0,0,,Ештеңе білмедім деп елестетіңіз
Dialogue: 0,1:29:50.66,1:29:54.29,Default,,0,0,0,,(Бива орындауы)
Dialogue: 0,1:29:54.41,1:29:56.62,Default,,0,0,0,,♪Тыңдаңыз
Dialogue: 0,1:29:56.70,1:30:00.33,Default,,0,0,0,,♪Барлығы тыңдайды.
Dialogue: 0,1:30:01.12,1:30:05.75,Default,,0,0,0,,♪Менің дауысымды тыңда
Dialogue: 0,1:30:06.75,1:30:10.91,Default,,0,0,0,,♪Ұмытпаңыздар, өтейік
Dialogue: 0,1:30:11.04,1:30:12.04,Default,,0,0,0,,Уф...
Dialogue: 0,1:30:13.70,1:30:15.58,Default,,0,0,0,,♪Менің атым...
Dialogue: 0,1:30:17.62,1:30:20.12,Default,,0,0,0,,♪ Атымды алып тастаса да
Dialogue: 0,1:30:20.25,1:30:22.41,Default,,0,0,0,,♪Менің шын атым...
Dialogue: 0,1:30:22.54,1:30:23.58,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,1:30:25.37,1:30:26.45,Default,,0,0,0,,(Томоаридің жөтелі)
Dialogue: 0,1:30:28.95,1:30:29.95,Default,,0,0,0,,♪Менің атым...
Dialogue: 0,1:30:30.08,1:30:31.08,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,1:30:34.45,1:30:36.08,Default,,0,0,0,,(Томоаридің жөтелі)
Dialogue: 0,1:30:42.12,1:30:43.29,Default,,0,0,0,,Фу…
Dialogue: 0,1:30:45.12,1:30:49.08,Default,,0,0,0,,Бұл Даннураның дос балығы ғой!
Dialogue: 0,1:30:49.20,1:30:50.33,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,1:31:32.62,1:31:34.87,Default,,0,0,0,,(Бива орындауы)
Dialogue: 0,1:31:35.20,1:31:38.04,Default,,0,0,0,,♪Енді өткен күн
Dialogue: 0,1:31:39.00,1:31:42.12,Default,,0,0,0,,♪Баяғыда
Dialogue: 0,1:31:42.45,1:31:47.08,Default,,0,0,0,,♪Бір күні, қашан болды?
Dialogue: 0,1:31:48.79,1:31:50.20,Default,,0,0,0,,(жіптің үзілген дыбысы)
Dialogue: 0,1:31:53.00,1:31:55.66,Default,,0,0,0,,Мен қашаннан бері...
Dialogue: 0,1:31:56.41,1:32:01.00,Default,,0,0,0,,Мұнда «бар» ма...?
Dialogue: 0,1:32:06.41,1:32:08.45,Default,,0,0,0,,Мен ұзақ іздедім.
Dialogue: 0,1:32:09.95,1:32:11.37,Default,,0,0,0,,Алты жүз жыл
Dialogue: 0,1:32:12.87,1:32:17.75,Default,,0,0,0,,Ол дос болды ма? Есімін қайта өзгертсе, оны табу қиын.
Dialogue: 0,1:32:18.50,1:32:20.08,Default,,0,0,0,,Ол өзіне иелік етіп тұрған Триту рухын тесіп өтті
Dialogue: 0,1:32:20.29,1:32:22.75,Default,,0,0,0,,Өзіңіз атаған жоқсыз ба?
Dialogue: 0,1:32:22.87,1:32:27.58,Default,,0,0,0,,«Біз осындамыз», солай ма? Томоари
Dialogue: 0,1:32:39.91,1:32:40.91,Default,,0,0,0,,Аттракцион саябағы болса да, жан-жағында бір адам жоқ—
Dialogue: 0,1:32:41.16,1:32:44.00,Default,,0,0,0,,Сол қоңыз сізде әлі бар ма?
Dialogue: 0,1:32:44.12,1:32:46.08,Default,,0,0,0,,Сіз оны ойнай аласыз ба?
Dialogue: 0,1:32:50.95,1:32:52.08,Default,,0,0,0,,Әрине!
Dialogue: 0,1:32:52.20,1:32:58.20,Default,,0,0,0,,(Бива орындауы)
Dialogue: 0,1:33:00.25,1:33:02.12,Default,,0,0,0,,Жақсы (Томоари) Әрине!
Dialogue: 0,1:33:06.41,1:33:07.83,Default,,0,0,0,,Өзгеріс жоқ.
Dialogue: 0,1:33:08.25,1:33:09.58,Default,,0,0,0,,Of course!
Dialogue: 0,1:33:09.70,1:33:10.75,Default,,0,0,0,,Кальмар
Dialogue: 0,1:33:10.87,1:33:12.33,Default,,0,0,0,,Әрі қарай жүрейік!
Dialogue: 0,1:33:12.45,1:33:26.83,Default,,0,0,0,,♪
Dialogue: 0,1:33:26.95,1:33:28.29,Default,,0,0,0,,Ит патшасы
Dialogue: 0,1:33:28.41,1:33:29.83,Default,,0,0,0,,Томоари
Dialogue: 0,1:33:30.20,1:33:31.70,Default,,0,0,0,,Ит патшасы
Dialogue: 0,1:33:31.83,1:33:33.41,Default,,0,0,0,,Томоари
Dialogue: 0,1:33:34.41,1:33:35.75,Default,,0,0,0,,Ит патшасы
Dialogue: 0,1:33:36.25,1:33:37.87,Default,,0,0,0,,Томоари
Dialogue: 0,1:33:38.29,1:33:39.75,Default,,0,0,0,,Ит патшасы
Dialogue: 0,1:33:40.20,1:33:42.12,Default,,0,0,0,,Томоари
Dialogue: 0,1:33:42.25,1:33:48.25,Default,,0,0,0,,♪~
Dialogue: 0,1:37:16.95,1:37:22.95,Default,,0,0,0,,~♪
Dialogue: 0,1:37:24.45,1:37:30.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory