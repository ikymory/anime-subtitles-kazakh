Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.18,0:00:19.18,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:01:50.17,0:01:52.17,Default,,0,0,0,,...Сондықтан➡
Dialogue: 0,0:01:52.17,0:01:54.18,Default,,0,0,0,,Мен сендерге айтайын деп ойладым.
Dialogue: 0,0:01:54.18,0:01:56.68,Default,,0,0,0,,Широганның шынайы тұлғасы - Закуса...
Dialogue: 0,0:01:56.68,0:01:58.68,Default,,0,0,0,,Неліктен Uniformers?
Dialogue: 0,0:01:58.68,0:02:00.68,Default,,0,0,0,,Мені жайына қалдыр...!
Dialogue: 0,0:02:00.68,0:02:03.65,Default,,0,0,0,,Томари-чан жетіспеушіліктен көп ұзамай қайтып келеді.
Dialogue: 0,0:02:13.70,0:02:15.70,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:15.70,0:02:17.70,Default,,0,0,0,,Данжи мырза➡
Dialogue: 0,0:02:17.70,0:02:21.20,Default,,0,0,0,,Закуса мырзаны неге қайтармадың?
Dialogue: 0,0:02:21.20,0:02:23.21,Default,,0,0,0,,Мені қайтарасың ба? ➡
Dialogue: 0,0:02:23.21,0:02:26.21,Default,,0,0,0,,Неліктен? Оның өз жолы бар.
Dialogue: 0,0:02:26.21,0:02:28.21,Default,,0,0,0,,Сіз сенімдісіз бе? ➡
Dialogue: 0,0:02:28.21,0:02:31.15,Default,,0,0,0,,Осы қарқынмен бәріміз біркелкі боламыз!
Dialogue: 0,0:02:31.15,0:02:33.15,Default,,0,0,0,,Жарайды➡
Dialogue: 0,0:02:33.15,0:02:35.65,Default,,0,0,0,,Әркім мұны жасайды, өйткені бұл оларды күштірек етеді.
Dialogue: 0,0:02:35.65,0:02:37.65,Default,,0,0,0,,Бірақ содан кейін...!
Dialogue: 0,0:02:37.65,0:02:39.66,Default,,0,0,0,,Сонымен не істегіңіз келеді?
Dialogue: 0,0:02:39.66,0:02:41.66,Default,,0,0,0,,Е...Бұл...
Dialogue: 0,0:02:41.66,0:02:43.66,Default,,0,0,0,,Данжи-сан! а….
Dialogue: 0,0:02:43.66,0:02:45.66,Default,,0,0,0,,О! Мен қазір барамын.
Dialogue: 0,0:02:45.66,0:02:47.66,Default,,0,0,0,,U….
Dialogue: 0,0:02:47.66,0:02:50.13,Default,,0,0,0,,Мұқият ойлан.
Dialogue: 0,0:02:55.67,0:02:57.67,Default,,0,0,0,,Айтпақшы, Мегуми ше? ➡
Dialogue: 0,0:02:57.67,0:02:59.67,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:02:59.67,0:03:01.68,Default,,0,0,0,,Мен оны жақында көрмедім.
Dialogue: 0,0:03:01.68,0:03:04.18,Default,,0,0,0,,Мегуми... Мен формашы болған шығармын.
Dialogue: 0,0:03:04.18,0:03:06.18,Default,,0,0,0,,E?
Dialogue: 0,0:03:06.18,0:03:08.18,Default,,0,0,0,,Мегуми?
Dialogue: 0,0:03:08.18,0:03:11.69,Default,,0,0,0,,Деректер Deluxe нұсқасынан мүлде басқа адам➡
Dialogue: 0,0:03:11.69,0:03:13.69,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:13.69,0:03:15.66,Default,,0,0,0,,Менің ойымша, бұл жүректің өзгеруі.
Dialogue: 0,0:03:16.69,0:03:21.20,Default,,0,0,0,,Біреу Мегумиді формашылармен бірге көрді➡
Dialogue: 0,0:03:21.20,0:03:23.70,Default,,0,0,0,,Өшіру осылай тоқтап қала ма деп қорқамын...
Dialogue: 0,0:03:23.70,0:03:26.70,Default,,0,0,0,,Бұл өтірік! Мегумисіз мүмкін емес.
Dialogue: 0,0:03:26.70,0:03:29.70,Default,,0,0,0,,Барлығы Мегумиге арқа сүйейді.
Dialogue: 0,0:03:29.70,0:03:31.64,Default,,0,0,0,,Түсіндім! Солай деп ойлаймын➡
Dialogue: 0,0:03:31.64,0:03:34.64,Default,,0,0,0,,Ол қамқор, еңбекқор және берік➡
Dialogue: 0,0:03:34.64,0:03:36.65,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:03:36.65,0:03:40.15,Default,,0,0,0,,Неліктен ұятсыз көрінесіз? Мег-чан шағымданды!
Dialogue: 0,0:03:40.15,0:03:42.65,Default,,0,0,0,,Соңғы кездері сен маған мүлдем жауап бермейсің!
Dialogue: 0,0:03:42.65,0:03:44.65,Default,,0,0,0,,Ех!
Dialogue: 0,0:03:44.65,0:03:47.62,Default,,0,0,0,,Ge! Жоқ...Аа, олай емес...
Dialogue: 0,0:03:49.16,0:03:51.63,Default,,0,0,0,,Әртүрлі заттар бар...
Dialogue: 0,0:03:53.16,0:03:55.16,Default,,0,0,0,,Немесе➡
Dialogue: 0,0:03:55.16,0:03:57.17,Default,,0,0,0,,Бұлай айтудың қажеті жоқ, түсіндің бе?
Dialogue: 0,0:03:57.17,0:03:59.17,Default,,0,0,0,,Адам арқасынан сөйлейді!
Dialogue: 0,0:03:59.17,0:04:01.67,Default,,0,0,0,,Не болды! Ахаха….
Dialogue: 0,0:04:01.67,0:04:03.67,Default,,0,0,0,,E?
Dialogue: 0,0:04:03.67,0:04:06.17,Default,,0,0,0,,Осы жігіт себепкер болды ма?
Dialogue: 0,0:04:06.17,0:04:08.18,Default,,0,0,0,,Неге жауап бермейсіз?
Dialogue: 0,0:04:08.18,0:04:10.18,Default,,0,0,0,,Өту - ең жаманы.
Dialogue: 0,0:04:10.18,0:04:14.18,Default,,0,0,0,,Егер Мегуми Uniformers-ке барса, бұл Данжидің кінәсі болар еді!
Dialogue: 0,0:04:14.18,0:04:16.18,Default,,0,0,0,,Жауапкершілікті өз мойныңызға алыңыз!
Dialogue: 0,0:04:16.18,0:04:18.69,Default,,0,0,0,,Ха? Неге мен!
Dialogue: 0,0:04:18.69,0:04:21.16,Default,,0,0,0,,Жарайды, бара бер!
Dialogue: 0,0:04:26.70,0:04:28.70,Default,,0,0,0,,Хаа….
Dialogue: 0,0:04:28.70,0:04:31.63,Default,,0,0,0,,Біраз уақыт өтті. Соңғы кездері қалай болдыңыз?
Dialogue: 0,0:04:31.63,0:04:33.60,Default,,0,0,0,,Бұл бұлыңғыр.
Dialogue: 0,0:04:36.64,0:04:39.14,Default,,0,0,0,,Мен үйдемін...➡
Dialogue: 0,0:04:39.14,0:04:41.14,Default,,0,0,0,,Аники….
Dialogue: 0,0:04:41.14,0:04:43.65,Default,,0,0,0,,Ой! Мегуми.
Dialogue: 0,0:04:43.65,0:04:45.61,Default,,0,0,0,,Аа...
Dialogue: 0,0:04:50.15,0:04:52.15,Default,,0,0,0,,Мегуми.
Dialogue: 0,0:04:52.15,0:04:54.12,Default,,0,0,0,,Не үшін келдің?
Dialogue: 0,0:04:55.66,0:04:59.16,Default,,0,0,0,,Маған қызық, ол жігіттер қандай...
Dialogue: 0,0:04:59.16,0:05:01.66,Default,,0,0,0,,Ах! ➡
Dialogue: 0,0:05:01.66,0:05:03.67,Default,,0,0,0,,Тоқта, тоқта!
Dialogue: 0,0:05:03.67,0:05:05.67,Default,,0,0,0,,Сәлем! ➡
Dialogue: 0,0:05:05.67,0:05:09.14,Default,,0,0,0,,Жасайық! Біраз уақыт өтті.
Dialogue: 0,0:05:13.18,0:05:15.64,Default,,0,0,0,,Жарайды, бірақ...
Dialogue: 0,0:05:18.18,0:05:21.65,Default,,0,0,0,,Мен бұрынғыдай адаммын деп ойласаң, қиналып қаласың.
Dialogue: 0,0:05:25.19,0:05:27.19,Default,,0,0,0,,Ах➡
Dialogue: 0,0:05:27.19,0:05:29.16,Default,,0,0,0,,Ешқашан жеңілме!
Dialogue: 0,0:05:34.63,0:05:37.13,Default,,0,0,0,,Ым? жаңбыр! ➡
Dialogue: 0,0:05:37.13,0:05:39.13,Default,,0,0,0,,Тез тазалаңыз!
Dialogue: 0,0:05:39.13,0:05:41.10,Default,,0,0,0,,Асығыңыз...! Картаңызды тастаңыз.
Dialogue: 0,0:05:55.65,0:05:58.15,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:05:58.15,0:06:00.66,Default,,0,0,0,,Диаблос Иннокентий Мэтт.
Dialogue: 0,0:06:00.66,0:06:02.66,Default,,0,0,0,,Ағаш мүйізді аң Роте.
Dialogue: 0,0:06:02.66,0:06:05.16,Default,,0,0,0,,Менің кезегім Стив➡
Dialogue: 0,0:06:05.16,0:06:07.16,Default,,0,0,0,,Мэттке шеберлікпен және жан зарядымен қоңырау шалыңыз➡
Dialogue: 0,0:06:07.16,0:06:09.66,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім ➡
Dialogue: 0,0:06:09.66,0:06:12.17,Default,,0,0,0,,Кек тізбегіне мін!
Dialogue: 0,0:06:12.17,0:06:15.17,Default,,0,0,0,,О... Есте сақтау шеберлігімен 1 картаны салыңыз➡
Dialogue: 0,0:06:15.17,0:06:18.17,Default,,0,0,0,,Және кек тізбегі дағдысы бар 2 картаны салыңыз➡
Dialogue: 0,0:06:18.17,0:06:21.18,Default,,0,0,0,,Бір тапсырыс картасын тастаңыз➡
Dialogue: 0,0:06:21.18,0:06:23.18,Default,,0,0,0,,Бұл тасталатын карта.
Dialogue: 0,0:06:23.18,0:06:25.65,Default,,0,0,0,,Өкпе тізбегі.
Dialogue: 0,0:06:28.18,0:06:31.62,Default,,0,0,0,,Егер бұл өшпенділік болса, оны тез тастауға болады.
Dialogue: 0,0:06:31.62,0:06:34.12,Default,,0,0,0,,Әйтеуір... атмосфера өзгерген жоқ.
Dialogue: 0,0:06:34.12,0:06:37.13,Default,,0,0,0,,Мен айттым ғой, солай ма? Ол өзгерді.
Dialogue: 0,0:06:37.13,0:06:39.13,Default,,0,0,0,,Аа...!
Dialogue: 0,0:06:39.13,0:06:41.13,Default,,0,0,0,,Кек тізбегімен шабуыл!
Dialogue: 0,0:06:41.13,0:06:43.13,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:06:43.13,0:06:45.13,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:06:45.13,0:06:47.14,Default,,0,0,0,,Ричардқа бару➡
Dialogue: 0,0:06:47.14,0:06:50.14,Default,,0,0,0,,Жанға төсеніш салып, 1 картаны салу шеберлігін қолданыңыз➡
Dialogue: 0,0:06:50.14,0:06:52.14,Default,,0,0,0,,Ричардпен шабуыл!
Dialogue: 0,0:06:52.14,0:06:54.64,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:06:54.64,0:06:56.65,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:06:56.65,0:06:59.15,Default,,0,0,0,,Қара көз жасы қаңқа айдаһарына мініңіз! ➡
Dialogue: 0,0:06:59.15,0:07:01.15,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:07:01.15,0:07:03.62,Default,,0,0,0,,Қолыңызға түсірілген рухани конденсацияны қайтарыңыз.
Dialogue: 0,0:07:05.65,0:07:07.66,Default,,0,0,0,,)
Dialogue: 0,0:07:07.66,0:07:09.66,Default,,0,0,0,,Қара көз жасымен скелеттік айдаһармен шабуыл!
Dialogue: 0,0:07:09.66,0:07:11.66,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:07:11.66,0:07:13.66,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:07:13.66,0:07:15.66,Default,,0,0,0,,Барлығы уайымдады➡
Dialogue: 0,0:07:15.66,0:07:17.67,Default,,0,0,0,,Ол қайтып келмейді деп қорқамын.
Dialogue: 0,0:07:17.67,0:07:19.67,Default,,0,0,0,,Аники ше?
Dialogue: 0,0:07:19.67,0:07:21.67,Default,,0,0,0,,Е, мен...
Dialogue: 0,0:07:21.67,0:07:24.17,Default,,0,0,0,,А... маңызды емес, солай ма? Энн?
Dialogue: 0,0:07:24.17,0:07:28.68,Default,,0,0,0,,Сондықтан маған емес, Томари мен Закусаға сенесің.
Dialogue: 0,0:07:28.68,0:07:31.11,Default,,0,0,0,,Га? Не дедіңіз...?
Dialogue: 0,0:07:31.11,0:07:33.11,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:07:33.11,0:07:35.62,Default,,0,0,0,,Өйткені күшім жетпеді.
Dialogue: 0,0:07:35.62,0:07:37.62,Default,,0,0,0,,Мегуми….
Dialogue: 0,0:07:37.62,0:07:39.62,Default,,0,0,0,,Бірақ қазір басқаша➡
Dialogue: 0,0:07:39.62,0:07:42.62,Default,,0,0,0,,Қолыңнан келгенін тез жасамасаң, қиналып қаласың.
Dialogue: 0,0:07:42.62,0:07:44.63,Default,,0,0,0,,О... хе!
Dialogue: 0,0:07:44.63,0:07:46.63,Default,,0,0,0,,Жарайды, түсіндім! ➡
Dialogue: 0,0:07:46.63,0:07:49.13,Default,,0,0,0,,Үрген жүзіңді жасырма... Менің кезегім!
Dialogue: 0,0:07:49.13,0:07:51.13,Default,,0,0,0,,Гүрдірген жарылыс! ➡
Dialogue: 0,0:07:51.13,0:07:53.13,Default,,0,0,0,,Тоқтауға болмайтын соққы!
Dialogue: 0,0:07:53.13,0:07:56.64,Default,,0,0,0,,Жолыма бөгет болғанның бәрін талқандаймын!
Dialogue: 0,0:07:56.64,0:07:58.61,Default,,0,0,0,,Жүр!
Dialogue: 0,0:07:59.64,0:08:01.64,Default,,0,0,0,,)
Dialogue: 0,0:08:01.64,0:08:04.11,Default,,0,0,0,,Diablos Via Month Blues!
Dialogue: 0,0:08:06.15,0:08:08.65,Default,,0,0,0,,Леонард Стефани Джинаға қоңырау шалыңыз! ➡
Dialogue: 0,0:08:08.65,0:08:12.15,Default,,0,0,0,,Ұрыс кезеңінің басында барлық бөлімшелер Diablos!
Dialogue: 0,0:08:12.15,0:08:14.12,Default,,0,0,0,,Барлығы бірден!
Dialogue: 0,0:08:16.66,0:08:19.16,Default,,0,0,0,,Біраз уақыт өтті➡
Dialogue: 0,0:08:19.16,0:08:21.13,Default,,0,0,0,,Аникидің бірден жетістігі.
Dialogue: 0,0:08:22.16,0:08:25.67,Default,,0,0,0,,Stephanie's Boost Blues көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:08:25.67,0:08:27.67,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:08:27.67,0:08:30.67,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:08:30.67,0:08:32.67,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:08:32.67,0:08:34.68,Default,,0,0,0,,Триггерді тартыңыз! ➡
Dialogue: 0,0:08:34.68,0:08:37.18,Default,,0,0,0,,1 картаны салыңыз және Леонардтың күші +10000!
Dialogue: 0,0:08:37.18,0:08:39.18,Default,,0,0,0,,Зақымдануды тексеру➡
Dialogue: 0,0:08:39.18,0:08:41.18,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:08:41.18,0:08:43.18,Default,,0,0,0,,Джиномен шабуыл!
Dialogue: 0,0:08:43.18,0:08:45.19,Default,,0,0,0,,Күзетші. Леонардпен шабуыл.
Dialogue: 0,0:08:45.19,0:08:47.19,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:08:47.19,0:08:50.69,Default,,0,0,0,,Бұрылудың соңы Осы уақытта Джиноның шеберлігі белсендіріледі! ➡
Dialogue: 0,0:08:50.69,0:08:54.70,Default,,0,0,0,,Өзіңізді жан дүниеңізге қойып, жаныңыздан 1 картаны қолыңызға қосыңыз.
Dialogue: 0,0:08:54.70,0:08:57.20,Default,,0,0,0,,Джиноны қолыңызға қосыңыз.
Dialogue: 0,0:08:57.20,0:09:00.70,Default,,0,0,0,,Осылайша сіз оны Жан арқылы қолыңызға жинадыңыз.
Dialogue: 0,0:09:00.70,0:09:03.71,Default,,0,0,0,,Мен сені ұруға дайындалып жатырмын.
Dialogue: 0,0:09:03.71,0:09:05.71,Default,,0,0,0,,Фу...бокору.
Dialogue: 0,0:09:05.71,0:09:08.71,Default,,0,0,0,,Дәл солай, Аники бірдеңе айтқан сайын➡
Dialogue: 0,0:09:08.71,0:09:10.71,Default,,0,0,0,,Олар бір-бірімен жарысып жатты.
Dialogue: 0,0:09:10.71,0:09:12.71,Default,,0,0,0,,Ол кезде өте қызық еді.
Dialogue: 0,0:09:12.71,0:09:14.72,Default,,0,0,0,,Жарыссақ, бір күні➡
Dialogue: 0,0:09:14.72,0:09:17.22,Default,,0,0,0,,Өйткені мен Аники сияқты бола аламын деп ойладым.
Dialogue: 0,0:09:17.22,0:09:21.69,Default,,0,0,0,,Мен Аники сияқты сенім артатын адам болғым келді.
Dialogue: 0,0:09:22.72,0:09:24.73,Default,,0,0,0,,Бірақ қанша тырыссам да➡
Dialogue: 0,0:09:24.73,0:09:26.73,Default,,0,0,0,,Асылмайтын қабырға бар екенін білдім.
Dialogue: 0,0:09:26.73,0:09:29.23,Default,,0,0,0,,Сондай кездерде Урара-чан➡ арқылы
Dialogue: 0,0:09:29.23,0:09:31.67,Default,,0,0,0,,Мен униформашылармен таныстым.
Dialogue: 0,0:09:31.67,0:09:33.67,Default,,0,0,0,,Ал Халона Уокер не айтты➡
Dialogue: 0,0:09:33.67,0:09:36.67,Default,,0,0,0,,Күшті болыңыз➡
Dialogue: 0,0:09:36.67,0:09:39.67,Default,,0,0,0,,Мен күштірек болғым келеді. Мен қабырғаны еңсергім келеді.
Dialogue: 0,0:09:39.67,0:09:42.68,Default,,0,0,0,,Әрбір күрескерде болатын тілек➡
Dialogue: 0,0:09:42.68,0:09:45.18,Default,,0,0,0,,Егер Uniformers оны жүзеге асыра алса➡
Dialogue: 0,0:09:45.18,0:09:48.18,Default,,0,0,0,,Ішке кіріп, білгім келді.
Dialogue: 0,0:09:48.18,0:09:50.69,Default,,0,0,0,,Содан кейін мен олардың жолдарымен таныстым.
Dialogue: 0,0:09:50.69,0:09:53.69,Default,,0,0,0,,Мен Uniformers дұрыс деп ойламадым➡
Dialogue: 0,0:09:53.69,0:09:56.19,Default,,0,0,0,,Мен мұны дұрыс емес деп те ойламадым.
Dialogue: 0,0:09:56.19,0:10:00.16,Default,,0,0,0,,Өйткені мен осылайша мықты болдым.
Dialogue: 0,0:10:01.70,0:10:03.70,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:10:03.70,0:10:05.70,Default,,0,0,0,,Ағаш мүйізді аң патшасы Магнолияға мініңіз!
Dialogue: 0,0:10:05.70,0:10:09.70,Default,,0,0,0,,((Кез келгеннен жоғары, ешкімнен жоғары! ➡
Dialogue: 0,0:10:09.70,0:10:12.21,Default,,0,0,0,,Не болса да➡
Dialogue: 0,0:10:12.21,0:10:14.21,Default,,0,0,0,,Армандарыңыздан асып кетіңіз! ➡
Dialogue: 0,0:10:14.21,0:10:16.18,Default,,0,0,0,,Мен барамын! ))
Dialogue: 0,0:10:17.21,0:10:20.22,Default,,0,0,0,,Гидраглум шеберлігінің маскасымен➡
Dialogue: 0,0:10:20.22,0:10:22.72,Default,,0,0,0,,Ағаш мүйізді жануар апат патшасы➡
Dialogue: 0,0:10:22.72,0:10:24.72,Default,,0,0,0,,Магнолия маскаларына➡
Dialogue: 0,0:10:24.72,0:10:27.19,Default,,0,0,0,,Persona Ride! Го~!
Dialogue: 0,0:10:30.16,0:10:32.16,Default,,0,0,0,,Магнолия маскалары➡
Dialogue: 0,0:10:32.16,0:10:35.66,Default,,0,0,0,,Бұл апат маскасымен қайта туды➡
Dialogue: 0,0:10:35.66,0:10:38.17,Default,,0,0,0,,Жаңа ағаш мүйізді аң патшасы.
Dialogue: 0,0:10:38.17,0:10:40.17,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:10:40.17,0:10:42.67,Default,,0,0,0,,Сіз қорқынышты сезінесіз.
Dialogue: 0,0:10:42.67,0:10:44.67,Default,,0,0,0,,Серолға➡ қоңырау шалыңыз
Dialogue: 0,0:10:44.67,0:10:47.68,Default,,0,0,0,,Қолыңызға магнолия маскаларын қосу дағдысын пайдаланыңыз.
Dialogue: 0,0:10:47.68,0:10:50.18,Default,,0,0,0,,Қоңырау тереңдігі Айри Дағдыны белсендіру.
Dialogue: 0,0:10:50.18,0:10:52.68,Default,,0,0,0,,Рюки маркерін қойыңыз.
Dialogue: 0,0:10:52.68,0:10:54.68,Default,,0,0,0,,Вист Альвасқа қоңырау шалыңыз➡
Dialogue: 0,0:10:54.68,0:10:56.68,Default,,0,0,0,,Рюки маркерін шеберлікпен қойыңыз.
Dialogue: 0,0:10:56.68,0:10:58.69,Default,,0,0,0,,Шақыру кіріс импульсі➡
Dialogue: 0,0:10:58.69,0:11:02.62,Default,,0,0,0,,Тамшыдан кіріс импульсін шақыру үшін спирт конденсациясын пайдаланыңыз➡
Dialogue: 0,0:11:02.62,0:11:04.63,Default,,0,0,0,,Қуат плюс 5000.
Dialogue: 0,0:11:04.63,0:11:07.13,Default,,0,0,0,,Магнолия маскаларының шеберлігі іске қосылды!
Dialogue: 0,0:11:07.13,0:11:09.13,Default,,0,0,0,,Магнолия тамшысын ➡ қоспаңыз
Dialogue: 0,0:11:09.13,0:11:12.63,Default,,0,0,0,,Бұл бұрылыс, артқы қатардан артқы сақшы шабуыл жасағанда➡
Dialogue: 0,0:11:12.63,0:11:16.10,Default,,0,0,0,,Қарсыласыңыздың тыл қорғаушыларының бірін жұмыстан шығаруға болады.
Dialogue: 0,0:11:21.14,0:11:23.65,Default,,0,0,0,,Магнолия маскаларының екінші шеберлігі.
Dialogue: 0,0:11:23.65,0:11:27.15,Default,,0,0,0,,Рюки маркерімен бір шеңбердегі барлық артқы қорғаушылар ➡
Dialogue: 0,0:11:27.15,0:11:29.15,Default,,0,0,0,,Сіз тіпті артқы қатардан шабуыл жасай аласыз➡
Dialogue: 0,0:11:29.15,0:11:31.15,Default,,0,0,0,,Қуат плюс 10000.
Dialogue: 0,0:11:31.15,0:11:33.15,Default,,0,0,0,,Сонымен қатар, Серолдың шеберлігімен➡
Dialogue: 0,0:11:33.15,0:11:36.62,Default,,0,0,0,,Persona Ride сонымен қатар артқы қатардағы бірліктерге 10 000 қосады.
Dialogue: 0,0:11:37.66,0:11:39.66,Default,,0,0,0,,Оны өткізіп жібермейсіз бе?
Dialogue: 0,0:11:39.66,0:11:43.16,Default,,0,0,0,,Кіріс импульсі арқылы Авангардқа шабуыл жасаңыз! ➡
Dialogue: 0,0:11:43.16,0:11:45.13,Default,,0,0,0,,Леонардты шегіндіріңіз, себебі бұл артқы қатардағы шабуыл!
Dialogue: 0,0:11:46.17,0:11:49.64,Default,,0,0,0,,38 000...соншалықты жоғары! Күзетші жоқ.
Dialogue: 0,0:11:50.67,0:11:53.17,Default,,0,0,0,,Вист Альваспен шабуыл! ➡
Dialogue: 0,0:11:53.17,0:11:56.18,Default,,0,0,0,,Бұл да артқы қатардағы шабуыл, сондықтан Стефаниді шегіндіріңіз!
Dialogue: 0,0:11:56.18,0:11:58.68,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:11:58.68,0:12:02.12,Default,,0,0,0,,Апат азуын қабыл алыңыз!
Dialogue: 0,0:12:02.12,0:12:05.12,Default,,0,0,0,,Магнолия маскаларымен шабуыл!
Dialogue: 0,0:12:05.12,0:12:07.12,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:12:07.12,0:12:09.62,Default,,0,0,0,,Қос жетекті бірінші тексеру➡
Dialogue: 0,0:12:09.62,0:12:11.63,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:12:11.63,0:12:13.63,Default,,0,0,0,,Алдыңғы триггер!
Dialogue: 0,0:12:13.63,0:12:16.13,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 10 000!
Dialogue: 0,0:12:16.13,0:12:18.10,Default,,0,0,0,,Ой... Триггер!
Dialogue: 0,0:12:19.13,0:12:21.10,Default,,0,0,0,,Кіріс импульсі бар шабуыл!
Dialogue: 0,0:12:22.14,0:12:24.11,Default,,0,0,0,,)
Dialogue: 0,0:12:25.14,0:12:27.11,Default,,0,0,0,,Жоқ, күзетші жоқ!
Dialogue: 0,0:12:28.14,0:12:30.14,Default,,0,0,0,,Серолды күшейту➡
Dialogue: 0,0:12:30.14,0:12:33.15,Default,,0,0,0,,Тереңдігімен шабуыл!
Dialogue: 0,0:12:33.15,0:12:35.12,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:12:36.15,0:12:39.65,Default,,0,0,0,,Бұрылыстың соңында Inlet Pulse дағдысы іске қосылады.
Dialogue: 0,0:12:39.65,0:12:42.16,Default,,0,0,0,,Өйткені ол осы айналымда 4 рет немесе одан да көп шабуыл жасады➡
Dialogue: 0,0:12:42.16,0:12:45.13,Default,,0,0,0,,Жаныңызға 2 карта салып, 2 картаны салыңыз.
Dialogue: 0,0:12:46.66,0:12:50.16,Default,,0,0,0,,Хе! Егер сіз осылай шабуыл жасасаңыз, сіздің қолыңызда 9 карта болады.
Dialogue: 0,0:12:50.16,0:12:53.67,Default,,0,0,0,,Өзімнен асып түсетін қуат сұрадым.
Dialogue: 0,0:12:53.67,0:12:55.67,Default,,0,0,0,,Мен өзгердім!
Dialogue: 0,0:12:55.67,0:12:58.17,Default,,0,0,0,,Сіз өзгердіңіз...эй➡
Dialogue: 0,0:12:58.17,0:13:01.61,Default,,0,0,0,,Атмосфера өзгерген болуы мүмкін, бірақ...
Dialogue: 0,0:13:01.61,0:13:04.11,Default,,0,0,0,,Мегуми - Мегуми, солай ма? иә?
Dialogue: 0,0:13:04.11,0:13:06.11,Default,,0,0,0,,Сіз әрқашан күшті боласыз.
Dialogue: 0,0:13:06.11,0:13:10.12,Default,,0,0,0,,Мен сені жақсы білемін, өйткені мен сенімен көп ұрысқанмын.
Dialogue: 0,0:13:10.12,0:13:12.12,Default,,0,0,0,,Не...! Сондықтан мен әр кезде...!
Dialogue: 0,0:13:12.12,0:13:16.12,Default,,0,0,0,,Мен сенімен төбелескенде, қатты күйіп кетемін! ➡
Dialogue: 0,0:13:16.12,0:13:19.63,Default,,0,0,0,,Менің кезегім Persona Ride!
Dialogue: 0,0:13:19.63,0:13:21.63,Default,,0,0,0,,Патрик Джино➡
Dialogue: 0,0:13:21.63,0:13:24.63,Default,,0,0,0,,Хайди Мэйбель Тришке қоңырау шалыңыз!
Dialogue: 0,0:13:24.63,0:13:27.14,Default,,0,0,0,,Тістеріңізді қысыңыз➡
Dialogue: 0,0:13:27.14,0:13:29.10,Default,,0,0,0,,Барлығы бірден!
Dialogue: 0,0:13:32.64,0:13:34.64,Default,,0,0,0,,Кух…. Heidi's Boost! ➡
Dialogue: 0,0:13:34.64,0:13:37.65,Default,,0,0,0,,Патрикпен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:13:37.65,0:13:40.15,Default,,0,0,0,,Дағдыны белсендіру Егер сіз жарылыс күйінде болсаңыз➡
Dialogue: 0,0:13:40.15,0:13:44.15,Default,,0,0,0,,Қарсыласыңыздың артқы күзетін күзетші шеңберіне жылжыта аласыз.
Dialogue: 0,0:13:44.15,0:13:46.15,Default,,0,0,0,,Айри тереңдігін жылжытыңыз!
Dialogue: 0,0:13:46.15,0:13:48.16,Default,,0,0,0,,Керемет...Күзетші!
Dialogue: 0,0:13:48.16,0:13:50.16,Default,,0,0,0,,Trish's Boost➡
Dialogue: 0,0:13:50.16,0:13:53.16,Default,,0,0,0,,Джиномен шабуыл! күзетші!
Dialogue: 0,0:13:53.16,0:13:57.17,Default,,0,0,0,,Mabel's Boost Blues көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:13:57.17,0:14:00.13,Default,,0,0,0,,Патрик пен Хайдиге шеберлікпен тұрыңыз! ➡
Dialogue: 0,0:14:00.13,0:14:02.60,Default,,0,0,0,,Қуат плюс 5000! Қарғыс атсын!
Dialogue: 0,0:14:02.60,0:14:04.61,Default,,0,0,0,,Джиноның шеберлігін белсендіруді жалғастырыңыз ➡
Dialogue: 0,0:14:04.61,0:14:09.11,Default,,0,0,0,,Әрбір 2 зақымдар үшін бағанға бір артқы қорғаушыны қойыңыз.
Dialogue: 0,0:14:09.11,0:14:13.11,Default,,0,0,0,,Егер сіз 2 бөлікке тұрсаңыз, сіз қосымша 5000 қуат аласыз!
Dialogue: 0,0:14:13.11,0:14:15.12,Default,,0,0,0,,Мен қолдайтыным➡
Dialogue: 0,0:14:15.12,0:14:17.09,Default,,0,0,0,,Джино мен Триш!
Dialogue: 0,0:14:18.12,0:14:22.12,Default,,0,0,0,,Мэйбельдің шеберлігімен Брюс үш еселік жетекке ие болады.
Dialogue: 0,0:14:22.12,0:14:25.13,Default,,0,0,0,,Күзетші жоқ! Барайық! Үш жетек➡
Dialogue: 0,0:14:25.13,0:14:27.13,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:14:27.13,0:14:30.13,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:14:30.13,0:14:34.10,Default,,0,0,0,,Триггерді тартыңыз! 1 картаны және Джиноның күші плюс 10000 тартыңыз!
Dialogue: 0,0:14:35.64,0:14:37.64,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:14:37.64,0:14:39.64,Default,,0,0,0,,Критикалық триггер! ➡
Dialogue: 0,0:14:39.64,0:14:41.64,Default,,0,0,0,,Патриктің күші плюс 10 000!
Dialogue: 0,0:14:41.64,0:14:43.64,Default,,0,0,0,,Брюстің сыни плюс 1.
Dialogue: 0,0:14:43.64,0:14:46.65,Default,,0,0,0,,Екі триггер...
Dialogue: 0,0:14:46.65,0:14:48.65,Default,,0,0,0,,Зақымдануды тексеру➡
Dialogue: 0,0:14:48.65,0:14:51.15,Default,,0,0,0,,1-тармақ➡
Dialogue: 0,0:14:51.15,0:14:53.15,Default,,0,0,0,,Екінші тармақ➡
Dialogue: 0,0:14:53.15,0:14:55.66,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:14:55.66,0:14:57.66,Default,,0,0,0,,Триштің күшеюі➡
Dialogue: 0,0:14:57.66,0:14:59.66,Default,,0,0,0,,Джиномен шабуыл!
Dialogue: 0,0:14:59.66,0:15:01.60,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:15:01.60,0:15:05.10,Default,,0,0,0,,Heidi's Boost! Патриктен Авангард➡
Dialogue: 0,0:15:05.10,0:15:07.10,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:15:07.10,0:15:09.10,Default,,0,0,0,,Оны үрлеп тастаңыз!
Dialogue: 0,0:15:09.10,0:15:11.11,Default,,0,0,0,,Бист Альвас пен Серол дағдылары бар➡
Dialogue: 0,0:15:11.11,0:15:13.07,Default,,0,0,0,,Күзетшілер шеңберіне көшіңіз!
Dialogue: 0,0:15:14.61,0:15:17.61,Default,,0,0,0,,Толық күзет! Апыр-ай!
Dialogue: 0,0:15:17.61,0:15:19.61,Default,,0,0,0,,Сіз мұны оңай жасай аласыз!
Dialogue: 0,0:15:19.61,0:15:22.62,Default,,0,0,0,,Бұл оңай емес➡
Dialogue: 0,0:15:22.62,0:15:24.62,Default,,0,0,0,,Джиноның шеберлігі➡
Dialogue: 0,0:15:24.62,0:15:26.62,Default,,0,0,0,,Өзіңізді жанға орналастырыңыз➡
Dialogue: 0,0:15:26.62,0:15:29.12,Default,,0,0,0,,Жаннан қолға Licusal Hate қосыңыз➡
Dialogue: 0,0:15:29.12,0:15:31.13,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:15:31.13,0:15:34.60,Default,,0,0,0,,Күш қатты болса да, ол маған жетпеді...
Dialogue: 0,0:15:35.63,0:15:38.63,Default,,0,0,0,,Ku~Күшті! ➡
Dialogue: 0,0:15:38.63,0:15:40.64,Default,,0,0,0,,Келгеніңізге қуаныштымын!
Dialogue: 0,0:15:40.64,0:15:43.14,Default,,0,0,0,,Бұл не...? Un?
Dialogue: 0,0:15:43.14,0:15:46.64,Default,,0,0,0,,Қанша хабарлассам да елемеймін➡
Dialogue: 0,0:15:46.64,0:15:50.14,Default,,0,0,0,,Кенеттен келгені соншалықты ақымақтық.
Dialogue: 0,0:15:50.14,0:15:52.15,Default,,0,0,0,,Оны айналдыруға алаңдамаңыз!
Dialogue: 0,0:15:52.15,0:15:55.15,Default,,0,0,0,,О... бұл жаман.
Dialogue: 0,0:15:55.15,0:15:57.15,Default,,0,0,0,,Рұқсат етілмейді➡
Dialogue: 0,0:15:57.15,0:15:59.62,Default,,0,0,0,,Мен сені бүгін ұрып-соғамын!
Dialogue: 0,0:16:00.59,0:16:04.59,Default,,0,0,0,,Осыны айтқан соң, мен тылдағы күзетшілерімнің барлығын қырып тастадым➡
Dialogue: 0,0:16:04.59,0:16:07.60,Default,,0,0,0,,Қолыңыздағы 2 картадан қайта орналаса аласыз ба?
Dialogue: 0,0:16:07.60,0:16:09.60,Default,,0,0,0,,Аузыңды жап, қара! ➡
Dialogue: 0,0:16:09.60,0:16:11.60,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:16:11.60,0:16:13.60,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:16:13.60,0:16:16.60,Default,,0,0,0,,Тереңдік Айриге қоңырау шалыңыз! Дағдыларды белсендіру➡
Dialogue: 0,0:16:16.60,0:16:18.61,Default,,0,0,0,,Рюки маркерін қойыңыз.
Dialogue: 0,0:16:18.61,0:16:22.61,Default,,0,0,0,,Және... Force Doglow Dragon-ға қоңырау шалыңыз!
Dialogue: 0,0:16:22.61,0:16:24.61,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:16:24.61,0:16:28.12,Default,,0,0,0,,Рюки маркерлері қанша болса, тамшыдан сонша бірлік шақырыңыз.
Dialogue: 0,0:16:28.12,0:16:31.62,Default,,0,0,0,,Call Inlet Pulse Vist Alvas Seror!
Dialogue: 0,0:16:31.62,0:16:33.62,Default,,0,0,0,,Күте тұрыңыз... бұл тым қатал!
Dialogue: 0,0:16:33.62,0:16:35.62,Default,,0,0,0,,Магнолия маскаларымен➡
Dialogue: 0,0:16:35.62,0:16:38.13,Default,,0,0,0,,Артқы қатардан шабуыл жасағанда бұл бұрылыс➡
Dialogue: 0,0:16:38.13,0:16:40.63,Default,,0,0,0,,1 Қарсыластың тыл сақшысының шегінуі!
Dialogue: 0,0:16:40.63,0:16:43.13,Default,,0,0,0,,Жақсы…. Кіріс импульсімен шабуыл жасаңыз!
Dialogue: 0,0:16:43.13,0:16:45.13,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:16:45.13,0:16:48.14,Default,,0,0,0,,Көз жасы, ашу және сағыныш➡
Dialogue: 0,0:16:48.14,0:16:51.64,Default,,0,0,0,,Барлығын бірден ал, Аники!
Dialogue: 0,0:16:51.64,0:16:54.64,Default,,0,0,0,,Келе жатса, жүр... күзетпе!
Dialogue: 0,0:16:54.64,0:16:56.64,Default,,0,0,0,,Күшті ит жарқылымен шабуыл! ➡
Dialogue: 0,0:16:56.64,0:16:58.65,Default,,0,0,0,,Мэйбелді шеберлікпен шегіндіріңіз!
Dialogue: 0,0:16:58.65,0:17:00.65,Default,,0,0,0,,Бас…зақым➡
Dialogue: 0,0:17:00.65,0:17:02.65,Default,,0,0,0,,Тексеріңіз!
Dialogue: 0,0:17:02.65,0:17:07.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:10.16,0:17:12.16,Default,,0,0,0,,Шаа! Емдеу триггері➡
Dialogue: 0,0:17:12.16,0:17:14.16,Default,,0,0,0,,1 залал өндірілді! ➡
Dialogue: 0,0:17:14.16,0:17:16.16,Default,,0,0,0,,Блюз қуаты плюс 10000.
Dialogue: 0,0:17:16.16,0:17:18.67,Default,,0,0,0,,6 нүктелі өкше.
Dialogue: 0,0:17:18.67,0:17:22.14,Default,,0,0,0,,6 нүктені сауықтыру? ...Ах!
Dialogue: 0,0:17:34.68,0:17:36.68,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:17:36.68,0:17:41.19,Default,,0,0,0,,Ум мен ол кезде 6 балдық өкшелі едім.
Dialogue: 0,0:17:41.19,0:17:43.69,Default,,0,0,0,,Иә, сондықтан мен жеңілдім.
Dialogue: 0,0:17:43.69,0:17:46.19,Default,,0,0,0,,Иә, бұл жолы да➡
Dialogue: 0,0:17:46.19,0:17:48.20,Default,,0,0,0,,Мен жеңдім! ➡
Dialogue: 0,0:17:48.20,0:17:51.20,Default,,0,0,0,,Магнолия маскаларымен шабуыл! күзетші!
Dialogue: 0,0:17:51.20,0:17:54.20,Default,,0,0,0,,Қос жетекті бірінші тексеру➡
Dialogue: 0,0:17:54.20,0:17:56.20,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:17:56.20,0:17:59.21,Default,,0,0,0,,Триггерді тартыңыз! Бір картаны салыңыз➡
Dialogue: 0,0:17:59.21,0:18:01.64,Default,,0,0,0,,Вист Альвастың күші плюс 10 000!
Dialogue: 0,0:18:01.64,0:18:03.64,Default,,0,0,0,,Бист Альваспен шабуыл! ➡
Dialogue: 0,0:18:03.64,0:18:05.65,Default,,0,0,0,,Тришті шеберлікпен шегіндіріңіз!
Dialogue: 0,0:18:05.65,0:18:08.15,Default,,0,0,0,,Ха! Бұл толық күзетші.
Dialogue: 0,0:18:08.15,0:18:10.15,Default,,0,0,0,,Кук➡
Dialogue: 0,0:18:10.15,0:18:13.15,Default,,0,0,0,,Тереңдігімен шабуыл! күзетші!
Dialogue: 0,0:18:13.15,0:18:16.16,Default,,0,0,0,,Табанды бол! Тез құлаңыз➡
Dialogue: 0,0:18:16.16,0:18:18.16,Default,,0,0,0,,Авангардқа Серолмен шабуыл жасаңыз! ➡
Dialogue: 0,0:18:18.16,0:18:20.13,Default,,0,0,0,,Хайдиді шеберлікпен шегіндіріңіз!
Dialogue: 0,0:18:21.16,0:18:24.17,Default,,0,0,0,,Хе...толық күзетші!
Dialogue: 0,0:18:24.17,0:18:27.17,Default,,0,0,0,,Жоқ! Сізде басқасы болды ма?
Dialogue: 0,0:18:27.17,0:18:30.17,Default,,0,0,0,,Менің бас тартуым нашар.
Dialogue: 0,0:18:30.17,0:18:33.17,Default,,0,0,0,,Қарғыс атсын! Inlet Pulse шеберлігімен➡
Dialogue: 0,0:18:33.17,0:18:35.68,Default,,0,0,0,,Оны жан дүниеңізге салып, 1 картаны салыңыз➡
Dialogue: 0,0:18:35.68,0:18:37.68,Default,,0,0,0,,Бұрылудың соңы➡
Dialogue: 0,0:18:37.68,0:18:39.68,Default,,0,0,0,,Бір ғана қадам қалды...
Dialogue: 0,0:18:39.68,0:18:43.18,Default,,0,0,0,,Хахаха... Мен мүлдем жеңілдім! ➡
Dialogue: 0,0:18:43.18,0:18:46.15,Default,,0,0,0,,Бұл өте қызық! Сізбен ұрыс.
Dialogue: 0,0:18:47.69,0:18:51.69,Default,,0,0,0,,Бұл қызық...ол жарылып кетеді! ➡
Dialogue: 0,0:18:51.69,0:18:53.69,Default,,0,0,0,,Барынша күресейік!
Dialogue: 0,0:18:53.69,0:18:55.70,Default,,0,0,0,,Қалаған жерде!
Dialogue: 0,0:18:55.70,0:18:57.70,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:18:57.70,0:19:00.17,Default,,0,0,0,,Бірден Иден мен Май-Майға қоңырау шалыңыз! ➡
Dialogue: 0,0:19:00.17,0:19:03.14,Default,,0,0,0,,Май Майдың Эденмен шабуылын күшейту!
Dialogue: 0,0:19:03.14,0:19:05.14,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:19:05.14,0:19:08.11,Default,,0,0,0,,Кеттік! Авангардқа блюзмен шабуыл жасаңыз!
Dialogue: 0,0:19:09.14,0:19:11.15,Default,,0,0,0,,стенд Иден мен Май Май шеберлігімен➡
Dialogue: 0,0:19:11.15,0:19:13.15,Default,,0,0,0,,Қуат плюс 5000!
Dialogue: 0,0:19:13.15,0:19:15.65,Default,,0,0,0,,Күзетші! Ха! ➡
Dialogue: 0,0:19:15.65,0:19:18.15,Default,,0,0,0,,Мен оны триггермен жоямын!
Dialogue: 0,0:19:18.15,0:19:20.15,Default,,0,0,0,,Егер қолыңнан келсе!
Dialogue: 0,0:19:20.15,0:19:22.16,Default,,0,0,0,,О! Қос жетек➡
Dialogue: 0,0:19:22.16,0:19:25.16,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:19:25.16,0:19:27.66,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:19:27.66,0:19:29.66,Default,,0,0,0,,Алдыңғы триггер!
Dialogue: 0,0:19:29.66,0:19:31.67,Default,,0,0,0,,Алдыңғы қатардың қуаты плюс 10000➡
Dialogue: 0,0:19:31.67,0:19:34.17,Default,,0,0,0,,Күзетші ену!
Dialogue: 0,0:19:34.17,0:19:36.64,Default,,0,0,0,,Бұл өтірік, солай ма? Не көрдіңіз?
Dialogue: 0,0:19:37.67,0:19:40.14,Default,,0,0,0,,Жанның триггері!
Dialogue: 0,0:19:41.18,0:19:43.18,Default,,0,0,0,,Әлі жоқ. Зақымдануды тексеру!
Dialogue: 0,0:19:43.18,0:19:45.18,Default,,0,0,0,,Келіңіздер! ➡
Dialogue: 0,0:19:45.18,0:19:47.15,Default,,0,0,0,,А...жоқ, келме!
Dialogue: 0,0:19:52.19,0:19:56.16,Default,,0,0,0,,A...триггер жоқ.
Dialogue: 0,0:19:59.69,0:20:02.63,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:20:02.63,0:20:05.63,Default,,0,0,0,,А, міне, солай! иә?
Dialogue: 0,0:20:05.63,0:20:07.64,Default,,0,0,0,,Әрқашан осылай болатын➡
Dialogue: 0,0:20:07.64,0:20:12.11,Default,,0,0,0,,Мен бар күшіммен Аникиді ұруға тырыстым, бірақ оның орнына соққыға жығылдым...
Dialogue: 0,0:20:13.14,0:20:17.14,Default,,0,0,0,,Сонда да бұл өте қызық болды!
Dialogue: 0,0:20:17.14,0:20:20.15,Default,,0,0,0,,А...бәрі өзгерген жоқ.
Dialogue: 0,0:20:20.15,0:20:23.65,Default,,0,0,0,,Формаға барсам да, ештеңе өзгермеді.
Dialogue: 0,0:20:23.65,0:20:26.15,Default,,0,0,0,,Мен Аникиден күшті болғым келеді! ➡
Dialogue: 0,0:20:26.15,0:20:29.16,Default,,0,0,0,,Енді, өткенде және болашақта!
Dialogue: 0,0:20:29.16,0:20:33.13,Default,,0,0,0,,О! Олай болса, кеттік! қараңғылау.
Dialogue: 0,0:20:38.67,0:20:40.67,Default,,0,0,0,,Мегуми! Мегуми-чан!
Dialogue: 0,0:20:40.67,0:20:42.64,Default,,0,0,0,,Барлығына қазір!
Dialogue: 0,0:20:43.67,0:20:46.67,Default,,0,0,0,,Джинки Мука Софи Белл➡
Dialogue: 0,0:20:46.67,0:20:50.68,Default,,0,0,0,,Халона Уокер Масанори мен Заку... Широгане➡
Dialogue: 0,0:20:50.68,0:20:53.18,Default,,0,0,0,,Бұл біркелкілердің бес аспан патшасы.
Dialogue: 0,0:20:53.18,0:20:55.18,Default,,0,0,0,,Аспандағы бес патша?
Dialogue: 0,0:20:55.18,0:20:58.69,Default,,0,0,0,,Біркелкі киім киетіндердің ішінде сол бесеуі ерекше ➡
Dialogue: 0,0:20:58.69,0:21:01.16,Default,,0,0,0,,Түбін көре алмайтыным сонша...
Dialogue: 0,0:21:02.12,0:21:04.63,Default,,0,0,0,,...Сонымен Мег-чан не істейді?
Dialogue: 0,0:21:04.63,0:21:06.63,Default,,0,0,0,,Мен ештеңе істемеймін.
Dialogue: 0,0:21:06.63,0:21:09.13,Default,,0,0,0,,Uniformers дұрыс па, бұрыс па?➡
Dialogue: 0,0:21:09.13,0:21:11.13,Default,,0,0,0,,Менің сезімдерім➡
Dialogue: 0,0:21:11.13,0:21:14.14,Default,,0,0,0,,Бұл ешкімге мәжбүрлейтін нәрсе емес.
Dialogue: 0,0:21:14.14,0:21:16.10,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:22.64,0:21:25.15,Default,,0,0,0,,Мен бұл туралы ойладым➡
Dialogue: 0,0:21:25.15,0:21:27.65,Default,,0,0,0,,Мен күткендеймін➡
Dialogue: 0,0:21:27.65,0:21:31.15,Default,,0,0,0,,Маған бәрі бірдей формаға айналған болашақты қаламаймын.
Dialogue: 0,0:21:31.15,0:21:33.15,Default,,0,0,0,,Бірақ мен үшін қазір➡
Dialogue: 0,0:21:33.15,0:21:35.16,Default,,0,0,0,,Болашақты өзгертетін күш жоқ.
Dialogue: 0,0:21:35.16,0:21:37.16,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:37.16,0:21:40.13,Default,,0,0,0,,Мені жаттықтырыңызшы.
Dialogue: 0,0:21:46.67,0:21:49.67,Default,,0,0,0,,Сіз осылай сезінесіз бе?
Dialogue: 0,0:21:49.67,0:21:51.64,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:53.17,0:21:55.18,Default,,0,0,0,,Түсіндім➡
Dialogue: 0,0:21:55.18,0:21:57.65,Default,,0,0,0,,Бөксені тепкілеп, қашып кетпе!
Dialogue: 0,0:21:59.15,0:22:05.15,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory