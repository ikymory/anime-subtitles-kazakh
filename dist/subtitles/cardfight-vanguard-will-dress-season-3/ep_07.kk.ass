Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.60,0:00:04.20,Default,,0,0,0,,Менің ойымша, тастайтын уақыт келді➡
Dialogue: 0,0:00:04.20,0:00:08.20,Default,,0,0,0,,Формалар жекпе-жегі Бұл тұншықтырарлық.
Dialogue: 0,0:00:08.20,0:00:10.21,Default,,0,0,0,,Мен сені кешіре алмаймын➡
Dialogue: 0,0:00:10.21,0:00:14.21,Default,,0,0,0,,Біркелкілер Урара-чанға соны үйретті.
Dialogue: 0,0:00:14.21,0:00:16.21,Default,,0,0,0,,Томари мырза? ➡
Dialogue: 0,0:00:16.21,0:00:19.21,Default,,0,0,0,,Мен... Мен дұрыс күрескім келеді!
Dialogue: 0,0:00:19.21,0:00:22.22,Default,,0,0,0,,Карточка күресі, бұл сізді өзінше күресуге қабілетсіз етеді...
Dialogue: 0,0:00:34.23,0:00:36.23,Default,,0,0,0,,)
Dialogue: 0,0:02:13.70,0:02:15.73,Default,,0,0,0,,О...Юйю! Данжи де!
Dialogue: 0,0:02:15.73,0:02:17.73,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:02:17.73,0:02:20.24,Default,,0,0,0,,Сәлем бәріңе!
Dialogue: 0,0:02:20.24,0:02:22.24,Default,,0,0,0,,Туя-сан Урара-сан➡
Dialogue: 0,0:02:22.24,0:02:24.24,Default,,0,0,0,,Лейка да келді!
Dialogue: 0,0:02:24.24,0:02:26.74,Default,,0,0,0,,Оны жаңа ғана күшпен әкелді.
Dialogue: 0,0:02:26.74,0:02:29.71,Default,,0,0,0,,Аха…. Жаттығуларыңыз қалай өтті?
Dialogue: 0,0:02:29.71,0:02:33.18,Default,,0,0,0,,Сәлем! Мені Данжи мырза үйретті.
Dialogue: 0,0:02:33.18,0:02:35.68,Default,,0,0,0,,Жаттығуларыңыз қалай өтті, Туя-сан және басқалар?
Dialogue: 0,0:02:35.68,0:02:37.69,Default,,0,0,0,,барынша жылтыратылған!
Dialogue: 0,0:02:37.69,0:02:40.19,Default,,0,0,0,,Мен де талай ұрыстым!
Dialogue: 0,0:02:40.19,0:02:42.19,Default,,0,0,0,,Бұдан артық... а?
Dialogue: 0,0:02:42.19,0:02:44.69,Default,,0,0,0,,Нәтижелеріңізді бізге жылдам көрсетіңіз.
Dialogue: 0,0:02:44.69,0:02:46.70,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:46.70,0:02:48.70,Default,,0,0,0,,Қулық! Мен де! мен де...!
Dialogue: 0,0:02:48.70,0:02:50.70,Default,,0,0,0,,Тапсырысты құрметтеңіз.
Dialogue: 0,0:02:50.70,0:02:52.70,Default,,0,0,0,,Фу….
Dialogue: 0,0:02:52.70,0:02:55.67,Default,,0,0,0,,)
Dialogue: 0,0:02:58.21,0:03:01.21,Default,,0,0,0,,Енді жауынгерлер арасында болмайды➡
Dialogue: 0,0:03:01.21,0:03:03.21,Default,,0,0,0,,Үйкеліс тудырмауы керек➡
Dialogue: 0,0:03:03.21,0:03:06.21,Default,,0,0,0,,Ұйымдық құрылымды түбегейлі жақсартуларды ұсыну.
Dialogue: 0,0:03:06.21,0:03:08.72,Default,,0,0,0,,Бұл қажет емес.
Dialogue: 0,0:03:08.72,0:03:10.72,Default,,0,0,0,,Не?
Dialogue: 0,0:03:10.72,0:03:15.22,Default,,0,0,0,,Жақсартудың қажеті жоқ.Шын мәнінде бұл қуанышты жағдай.
Dialogue: 0,0:03:15.22,0:03:18.23,Default,,0,0,0,,Көп адам аз уақыт ішінде кетіп қалды.
Dialogue: 0,0:03:18.23,0:03:21.23,Default,,0,0,0,,Біркелкілердің жалпы саны артып келеді➡
Dialogue: 0,0:03:21.23,0:03:23.73,Default,,0,0,0,,Менің күш-қуатымның алдында➡
Dialogue: 0,0:03:23.73,0:03:27.24,Default,,0,0,0,,Барлық жауынгерлер формаға айналады➡
Dialogue: 0,0:03:27.24,0:03:29.20,Default,,0,0,0,,Дәл қазір бұл жай ғана процесс.
Dialogue: 0,0:03:32.17,0:03:34.68,Default,,0,0,0,,Бір кездері менде болған идеалдар...
Dialogue: 0,0:03:34.68,0:03:38.65,Default,,0,0,0,,Бәлкім, бір сәтте біртүрлі бағытта жүріп кеткен шығар.
Dialogue: 0,0:03:41.68,0:03:43.69,Default,,0,0,0,,((Алденмен шабуыл!
Dialogue: 0,0:03:43.69,0:03:47.19,Default,,0,0,0,,Уау! Хаа... күзетші жоқ.
Dialogue: 0,0:03:47.19,0:03:49.19,Default,,0,0,0,,А, мен жеңілдім.
Dialogue: 0,0:03:49.19,0:03:51.19,Default,,0,0,0,,Қолыңды көтермедің бе? Джинки.
Dialogue: 0,0:03:51.19,0:03:53.20,Default,,0,0,0,,Бұл өте қауіпті болды.
Dialogue: 0,0:03:53.20,0:03:55.20,Default,,0,0,0,,Мен сені ұрамын деп жиі айтамын➡
Dialogue: 0,0:03:55.20,0:03:58.70,Default,,0,0,0,,Ол тіпті ініме гүл алып келді...
Dialogue: 0,0:03:58.70,0:04:01.20,Default,,0,0,0,,Жекпе-жек әрқашан ауыр болады.
Dialogue: 0,0:04:01.20,0:04:03.71,Default,,0,0,0,,Сәлем... сосын тағы бір рет.
Dialogue: 0,0:04:03.71,0:04:05.71,Default,,0,0,0,,Кешіріңіз Джинки➡
Dialogue: 0,0:04:05.71,0:04:07.71,Default,,0,0,0,,Біз кездесу өткізгелі жатырмыз.
Dialogue: 0,0:04:07.71,0:04:10.21,Default,,0,0,0,,Бұл не? Сіз жеңіп, қашуға тырысасыз ба?
Dialogue: 0,0:04:10.21,0:04:13.22,Default,,0,0,0,,Кездесу ЦРУ-ға ұсынылды ма?
Dialogue: 0,0:04:13.22,0:04:15.22,Default,,0,0,0,,Жоқ...бұл басқа мәселе➡
Dialogue: 0,0:04:15.22,0:04:18.72,Default,,0,0,0,,Бұл менің идеалдарымды жүзеге асыруға арналған жоба.
Dialogue: 0,0:04:18.72,0:04:20.72,Default,,0,0,0,,Қызықты...
Dialogue: 0,0:04:20.72,0:04:23.73,Default,,0,0,0,,Сіздің идеал ағаңыз қандай?
Dialogue: 0,0:04:23.73,0:04:27.23,Default,,0,0,0,,Джинки...менің идеалым➡
Dialogue: 0,0:04:27.23,0:04:30.20,Default,,0,0,0,,Барлық күрескерлер бақытты болатын болашақ. ))
Dialogue: 0,0:04:35.17,0:04:37.17,Default,,0,0,0,,Хаа….
Dialogue: 0,0:04:37.17,0:04:39.17,Default,,0,0,0,,Өзіңізді жақсы сезінбейсіз!
Dialogue: 0,0:04:39.17,0:04:41.64,Default,,0,0,0,,Масанори…. Сәлем.
Dialogue: 0,0:04:45.18,0:04:48.18,Default,,0,0,0,,Сіз ағаңызды бұрын кездестіргенсіз, солай емес пе➡
Dialogue: 0,0:04:48.18,0:04:50.19,Default,,0,0,0,,Қандай әсер қалдырды?
Dialogue: 0,0:04:50.19,0:04:52.19,Default,,0,0,0,,Не... эй?
Dialogue: 0,0:04:52.19,0:04:55.19,Default,,0,0,0,,Біз алғаш рет Fight Space➡ алаңында кездестік
Dialogue: 0,0:04:55.19,0:04:57.69,Default,,0,0,0,,➡ секіру арқылы жеңіліс болмайды
Dialogue: 0,0:04:57.69,0:05:00.70,Default,,0,0,0,,Ол керемет күшті күрескер болды.
Dialogue: 0,0:05:00.70,0:05:04.70,Default,,0,0,0,,Бір қызығы, жеңілгендердің өзі көңіл көтеріп жүрген сияқты➡
Dialogue: 0,0:05:04.70,0:05:08.20,Default,,0,0,0,,Жарайды...Шыңги ең көңілді жүрген сияқты➡
Dialogue: 0,0:05:08.20,0:05:11.21,Default,,0,0,0,,Мен оны бейкүнә жігіт деп ойладым.
Dialogue: 0,0:05:11.21,0:05:13.68,Default,,0,0,0,,Менің ойымша, ол Авангардты жақсы көретін.
Dialogue: 0,0:05:17.71,0:05:19.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:22.72,0:05:26.22,Default,,0,0,0,,Жоғарыда Uniformers➡ айналасындағы ағымдағы жағдай көрсетілген
Dialogue: 0,0:05:26.22,0:05:28.22,Default,,0,0,0,,Іс қазіргідей жалғасатын болса, болашақта күресушілер көп болады➡
Dialogue: 0,0:05:28.22,0:05:30.16,Default,,0,0,0,,Сіз ұтыласыз➡
Dialogue: 0,0:05:30.16,0:05:33.16,Default,,0,0,0,,Осы жағдайды өзгертуге көмектесе аласыз ба?
Dialogue: 0,0:05:33.16,0:05:35.16,Default,,0,0,0,,Гай саясатын ұстану➡
Dialogue: 0,0:05:35.16,0:05:37.67,Default,,0,0,0,,Барлық жауынгерлерді қуанту...
Dialogue: 0,0:05:37.67,0:05:40.17,Default,,0,0,0,,Мен не болып жатыр деп уайымдадым➡
Dialogue: 0,0:05:40.17,0:05:42.17,Default,,0,0,0,,Осындай қызықсыз нәрселер сізді уайымдады ма?
Dialogue: 0,0:05:42.17,0:05:45.17,Default,,0,0,0,,Ха? Жігіт - Шингидің алтер-эгосы➡
Dialogue: 0,0:05:45.17,0:05:47.68,Default,,0,0,0,,Оның тазалығы оған көшті➡
Dialogue: 0,0:05:47.68,0:05:49.68,Default,,0,0,0,,Бұл қарғыс сияқты.
Dialogue: 0,0:05:49.68,0:05:52.18,Default,,0,0,0,,Сіз не айтқыңыз келеді?
Dialogue: 0,0:05:52.18,0:05:55.18,Default,,0,0,0,,Тазалықтың өзі шектен шығып кетсе, ақылсыздыққа айналуы мүмкін.
Dialogue: 0,0:05:55.18,0:05:58.19,Default,,0,0,0,,Гэйдің қазір жынды болып көрінуінің себебі, ол қолынан келгеннің бәрін істеп жатыр ➡
Dialogue: 0,0:05:58.19,0:06:01.69,Default,,0,0,0,,Шыңғыстың тілегін жүзеге асырмақ болғаның үшін емес пе?
Dialogue: 0,0:06:01.69,0:06:03.69,Default,,0,0,0,,Ондай жағдайда мен Жігітті тоқтатуым керек...
Dialogue: 0,0:06:03.69,0:06:05.69,Default,,0,0,0,,Не айтып тұрсың?!
Dialogue: 0,0:06:05.69,0:06:08.20,Default,,0,0,0,,Қызық енді басталады! ➡
Dialogue: 0,0:06:08.20,0:06:10.70,Default,,0,0,0,,Әркім өзін көрсетіп, бір-бірімен соқтығысады➡
Dialogue: 0,0:06:10.70,0:06:13.20,Default,,0,0,0,,Ең жақсы шоу уақыты басталғалы жатыр! Ахах...
Dialogue: 0,0:06:13.20,0:06:15.70,Default,,0,0,0,,Масанори Сіз басынан бастап...
Dialogue: 0,0:06:15.70,0:06:18.71,Default,,0,0,0,,Жұлдыздарға жете алмайтын адамдар➡
Dialogue: 0,0:06:18.71,0:06:21.21,Default,,0,0,0,,Маған не болып жатқаны бәрібір.
Dialogue: 0,0:06:21.21,0:06:24.21,Default,,0,0,0,,Джинкидің түсінбестік бар екеніне сенімдімін➡
Dialogue: 0,0:06:24.21,0:06:26.68,Default,,0,0,0,,Жігіт қателесуі мүмкін емес.
Dialogue: 0,0:06:33.15,0:06:36.66,Default,,0,0,0,,((Мен жігіттің ең алдымен көңілді не екенін білгенін қалаймын➡
Dialogue: 0,0:06:36.66,0:06:39.63,Default,,0,0,0,,Өйткені бұл идеалды жауынгер үшін өте маңызды. ))
Dialogue: 0,0:06:46.17,0:06:49.17,Default,,0,0,0,,((Гай үшін, Авангард қазір➡
Dialogue: 0,0:06:49.17,0:06:51.14,Default,,0,0,0,,Ол көңіл көтерудің символына айналды ма?
Dialogue: 0,0:06:53.68,0:06:57.68,Default,,0,0,0,,Егер сіз дұрыс емес бұрылыс жасасаңыз, оны түзетуіңіз керек.
Dialogue: 0,0:06:57.68,0:07:00.68,Default,,0,0,0,,Осы уақытқа дейін Жігітті бақылап жүрді➡
Dialogue: 0,0:07:00.68,0:07:02.65,Default,,0,0,0,,Бұл менің рөлім. ))
Dialogue: 0,0:07:07.69,0:07:10.19,Default,,0,0,0,,Не болды? Қайта келетініме сене алар емеспін.
Dialogue: 0,0:07:10.19,0:07:12.23,Default,,0,0,0,,Бір нәрсе үшін бе?
Dialogue: 0,0:07:12.23,0:07:14.70,Default,,0,0,0,,Жігіт... Uniformers болашағына қауіп төніп тұр➡
Dialogue: 0,0:07:14.70,0:07:16.70,Default,,0,0,0,,Менімен төбелескеніңді қалаймын.
Dialogue: 0,0:07:16.70,0:07:19.20,Default,,0,0,0,,Егер мен жеңсем➡
Dialogue: 0,0:07:19.20,0:07:21.70,Default,,0,0,0,,Өткен күні жасаған ұсынысымды қабыл алыңыз.
Dialogue: 0,0:07:21.70,0:07:23.71,Default,,0,0,0,,Сіз мұны қажет емес деп айттыңыз, солай ма?
Dialogue: 0,0:07:23.71,0:07:26.71,Default,,0,0,0,,Мен статус-квоны растаймын.
Dialogue: 0,0:07:26.71,0:07:29.68,Default,,0,0,0,,Мен де бас тарта алмайтын нәрселер бар.
Dialogue: 0,0:07:33.15,0:07:37.65,Default,,0,0,0,,Оны жауынгерлер арасындағы тартыспен шешейік!
Dialogue: 0,0:07:37.65,0:07:41.66,Default,,0,0,0,,Алден! Бұл Шинги пайдаланған карта емес пе?
Dialogue: 0,0:07:41.66,0:07:45.13,Default,,0,0,0,,А... қызық болатын сияқты, солай ма?
Dialogue: 0,0:07:50.73,0:07:53.20,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:07:54.24,0:07:56.24,Default,,0,0,0,,Глифосид.
Dialogue: 0,0:07:56.24,0:07:58.24,Default,,0,0,0,,Таң қаларлық рыцарь, Адмис.
Dialogue: 0,0:07:58.24,0:08:00.68,Default,,0,0,0,,Менің кезегім Мен мінбеймін.
Dialogue: 0,0:08:00.68,0:08:04.18,Default,,0,0,0,,Негізгі кезеңнің басында Глифосид шеберлігі іске қосылады➡
Dialogue: 0,0:08:04.18,0:08:08.18,Default,,0,0,0,,Соңының басын палубадан жанға салыңыз және бұрылысты аяқтаңыз➡
Dialogue: 0,0:08:08.18,0:08:11.19,Default,,0,0,0,,Сен сол палубамен қандай жекпе-жекке шығасың➡
Dialogue: 0,0:08:11.19,0:08:13.19,Default,,0,0,0,,Өте қызықты.
Dialogue: 0,0:08:13.19,0:08:15.19,Default,,0,0,0,,Көңіліңіз жеткенше ләззат алыңыз.
Dialogue: 0,0:08:15.19,0:08:18.19,Default,,0,0,0,,)
Dialogue: 0,0:08:18.19,0:08:21.70,Default,,0,0,0,,Менің кезегім Транкильядағы Тенью Найт міну➡
Dialogue: 0,0:08:21.70,0:08:23.70,Default,,0,0,0,,Шеберлікпен 1 картаны салыңыз➡
Dialogue: 0,0:08:23.70,0:08:26.20,Default,,0,0,0,,Транкилламен шабуыл!
Dialogue: 0,0:08:26.20,0:08:28.70,Default,,0,0,0,,Күзетсіз Менің кезегім➡
Dialogue: 0,0:08:28.70,0:08:31.21,Default,,0,0,0,,Жаныңызға қорқынышты өзгеріс әкелу➡
Dialogue: 0,0:08:31.21,0:08:33.21,Default,,0,0,0,,Глифосидпен шабуыл!
Dialogue: 0,0:08:33.21,0:08:35.71,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:08:35.71,0:08:37.71,Default,,0,0,0,,Сәлем жігіт➡
Dialogue: 0,0:08:37.71,0:08:39.71,Default,,0,0,0,,Карточка төбелестері қызықты ма? ➡
Dialogue: 0,0:08:39.71,0:08:42.72,Default,,0,0,0,,Мені қызықтырады, жауап беріңізші.
Dialogue: 0,0:08:42.72,0:08:44.72,Default,,0,0,0,,Төбелес қызық па екен...
Dialogue: 0,0:08:44.72,0:08:46.72,Default,,0,0,0,,Бұл қызық болатыны сөзсіз!
Dialogue: 0,0:08:46.72,0:08:48.72,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:48.72,0:08:50.69,Default,,0,0,0,,Біз жеңіске жеткенше!
Dialogue: 0,0:08:51.73,0:08:53.73,Default,,0,0,0,,Жеңіс – шайқастың нағыз қызығы➡
Dialogue: 0,0:08:53.73,0:08:56.73,Default,,0,0,0,,Күш - күрескердің бар болу себебі➡
Dialogue: 0,0:08:56.73,0:09:00.17,Default,,0,0,0,,Авангард ережесі - жеңіске жету үшін күресу➡
Dialogue: 0,0:09:00.17,0:09:03.14,Default,,0,0,0,,Жеңіс бәрінен де қызық болуы керек, солай ма?
Dialogue: 0,0:09:04.17,0:09:06.14,Default,,0,0,0,,Барлығына бірдей емес пе?
Dialogue: 0,0:09:07.68,0:09:09.68,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:09:09.68,0:09:12.18,Default,,0,0,0,,Тенру сері Сардиосқа мінеді!
Dialogue: 0,0:09:12.18,0:09:14.18,Default,,0,0,0,,Транкилла дағдылары➡
Dialogue: 0,0:09:14.18,0:09:17.69,Default,,0,0,0,,Қолыңыздан әртүрлі дәрежедегі 3 картаны ашу арқылы➡
Dialogue: 0,0:09:17.69,0:09:20.69,Default,,0,0,0,,Палубаның жоғарғы 5 картасынан ауырсынуды басатын дәріге қоңырау шалыңыз➡
Dialogue: 0,0:09:20.69,0:09:22.69,Default,,0,0,0,,Кальбрге➡ қоңырау шалыңыз
Dialogue: 0,0:09:22.69,0:09:24.69,Default,,0,0,0,,Филонға шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:09:24.69,0:09:27.70,Default,,0,0,0,,Филонды шақырғанда оның күші +2000.
Dialogue: 0,0:09:27.70,0:09:29.70,Default,,0,0,0,,Алғашқы кезеңде 3 тыл сақшылары➡
Dialogue: 0,0:09:29.70,0:09:33.20,Default,,0,0,0,,Гриффогиллаға қарсы шаралар өте жақсы сияқты.
Dialogue: 0,0:09:33.20,0:09:36.70,Default,,0,0,0,,Мен бұл картаның қаншалықты қорқынышты екенін бәрінен де жақсы білемін.
Dialogue: 0,0:09:36.70,0:09:38.71,Default,,0,0,0,,Қысқа шешуші шайқаста шешіңіз➡
Dialogue: 0,0:09:38.71,0:09:40.71,Default,,0,0,0,,Сардиоспен шабуыл!
Dialogue: 0,0:09:40.71,0:09:43.21,Default,,0,0,0,,Күзетші жоқ. Филонмен шабуыл!
Dialogue: 0,0:09:43.21,0:09:45.71,Default,,0,0,0,,Күзетші. Ауырсынуды басатын дәрі➡
Dialogue: 0,0:09:45.71,0:09:47.72,Default,,0,0,0,,Кальбрмен шабуыл!
Dialogue: 0,0:09:47.72,0:09:49.72,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:49.72,0:09:52.22,Default,,0,0,0,,Ауырсынуды басатын шеберлікпен 1 картаны салыңыз➡
Dialogue: 0,0:09:52.22,0:09:54.22,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:54.22,0:09:56.22,Default,,0,0,0,,Джинки күткендей.
Dialogue: 0,0:09:56.22,0:09:58.73,Default,,0,0,0,,Бірақ ол күтілетін ауқымда.
Dialogue: 0,0:09:58.73,0:10:00.66,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:10:00.66,0:10:03.16,Default,,0,0,0,,Глифосид дағдыларын белсендіру➡
Dialogue: 0,0:10:03.16,0:10:07.17,Default,,0,0,0,,Аяқтың келуін ат палубасынан жанға салыңыз➡
Dialogue: 0,0:10:07.17,0:10:09.67,Default,,0,0,0,,Басталып жатыр.
Dialogue: 0,0:10:09.67,0:10:11.67,Default,,0,0,0,,Келіңіз.
Dialogue: 0,0:10:11.67,0:10:13.68,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:10:13.68,0:10:15.68,Default,,0,0,0,,Жақсы...!
Dialogue: 0,0:10:15.68,0:10:17.68,Default,,0,0,0,,Жойылған бала! ➡
Dialogue: 0,0:10:17.68,0:10:20.68,Default,,0,0,0,,Тұтылу айдаһар ағашына мініңіз, Гриффогилла!
Dialogue: 0,0:10:20.68,0:10:23.65,Default,,0,0,0,,Гуо~!
Dialogue: 0,0:10:26.69,0:10:28.69,Default,,0,0,0,,Дәнекер Заркабты шақырыңыз➡
Dialogue: 0,0:10:28.69,0:10:31.19,Default,,0,0,0,,Бір Рюки маркерін шеберлікпен қойыңыз➡
Dialogue: 0,0:10:31.19,0:10:33.19,Default,,0,0,0,,Ампуланың шашырауын шақырыңыз➡
Dialogue: 0,0:10:33.19,0:10:35.70,Default,,0,0,0,,Дәнекер Закабтың шеберлігімен 1 картаны салыңыз➡
Dialogue: 0,0:10:35.70,0:10:39.20,Default,,0,0,0,,Сондай-ақ ампуланың шашырауы және паруми деп аталады.
Dialogue: 0,0:10:39.20,0:10:42.17,Default,,0,0,0,,Палубаның жоғарғы үш картасын кез келген ретпен орналастыру дағдыларын қолданыңыз.
Dialogue: 0,0:10:44.71,0:10:46.71,Default,,0,0,0,,Гриффогилламен шабуыл! ➡
Dialogue: 0,0:10:46.71,0:10:49.21,Default,,0,0,0,,Соңының басын есептемегенде.
Dialogue: 0,0:10:49.21,0:10:53.72,Default,,0,0,0,,((Барлық апат карталары жойылғаннан кейін, артық триггер пайда болады➡
Dialogue: 0,0:10:53.72,0:10:55.72,Default,,0,0,0,,Оған дейін... ))
Dialogue: 0,0:10:55.72,0:10:57.72,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:10:57.72,0:10:59.69,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:10:59.69,0:11:01.66,Default,,0,0,0,,Екінші тексеру триггері жоқ➡
Dialogue: 0,0:11:01.66,0:11:05.16,Default,,0,0,0,,Триггер жоқ. Триггер жоқ па?
Dialogue: 0,0:11:05.16,0:11:07.66,Default,,0,0,0,,Көңілдің ба? Біраз.
Dialogue: 0,0:11:07.66,0:11:11.17,Default,,0,0,0,,Мен сізді одан сайын толғандырамын, сондықтан хабардар болыңыз➡
Dialogue: 0,0:11:11.17,0:11:13.67,Default,,0,0,0,,Ампуланың шашырауымен шабуыл!
Dialogue: 0,0:11:13.67,0:11:17.17,Default,,0,0,0,,Күзетші жоқ. Басқа ампуланың шашырауымен шабуыл жасаңыз!
Dialogue: 0,0:11:17.17,0:11:20.68,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:11:20.68,0:11:24.68,Default,,0,0,0,,Өйткені мен шын жүректен барша жауынгерлердің бақытын тіледім➡
Dialogue: 0,0:11:24.68,0:11:27.18,Default,,0,0,0,,Мен сіздермен осы уақытқа дейін қызметтес болдым.
Dialogue: 0,0:11:27.18,0:11:29.68,Default,,0,0,0,,Иә, мен Джинкиге ризамын.
Dialogue: 0,0:11:29.68,0:11:34.19,Default,,0,0,0,,Бірақ Uniformers философиясын ұстанбайтын адамдар бар➡
Dialogue: 0,0:11:34.19,0:11:36.69,Default,,0,0,0,,Мен қалаған болашақ бұл жерде емес➡
Dialogue: 0,0:11:36.69,0:11:39.19,Default,,0,0,0,,Біреу Uniformers➡ қалдырды
Dialogue: 0,0:11:39.19,0:11:41.20,Default,,0,0,0,,Идеалға ұмтылғаннан кейін➡
Dialogue: 0,0:11:41.20,0:11:44.17,Default,,0,0,0,,Өзін де ойламайтын адамдар бар.
Dialogue: 0,0:11:45.70,0:11:47.70,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:11:47.70,0:11:49.70,Default,,0,0,0,,Сіздің идеалды болашағыңыз қандай?➡
Dialogue: 0,0:11:49.70,0:11:52.21,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:11:52.21,0:11:55.71,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін. Не болды?
Dialogue: 0,0:11:55.71,0:11:58.21,Default,,0,0,0,,Өзім де байқасам ғой➡
Dialogue: 0,0:11:58.21,0:12:00.65,Default,,0,0,0,,Бұл қиын сияқты.
Dialogue: 0,0:12:00.65,0:12:02.65,Default,,0,0,0,,Сізге түзетуге рұқсат етіңіз➡
Dialogue: 0,0:12:02.65,0:12:05.65,Default,,0,0,0,,Қазір қайтыс болған Шыңгінің орнына! ➡
Dialogue: 0,0:12:05.65,0:12:08.16,Default,,0,0,0,,Аспан мен жерді байланыстыратын рыцарь➡
Dialogue: 0,0:12:08.16,0:12:10.66,Default,,0,0,0,,Құдіретті қылышыңды ұста! ➡
Dialogue: 0,0:12:10.66,0:12:13.66,Default,,0,0,0,,Аспанды қосатын қылыш Алденге мін!
Dialogue: 0,0:12:13.66,0:12:16.16,Default,,0,0,0,,Кел, Алден!
Dialogue: 0,0:12:16.16,0:12:18.67,Default,,0,0,0,,Енді маған күшіңді көрсет!
Dialogue: 0,0:12:18.67,0:12:20.67,Default,,0,0,0,,Сардиос дағдылары➡
Dialogue: 0,0:12:20.67,0:12:24.17,Default,,0,0,0,,Қолыңыздан әртүрлі дәрежедегі 3 картаны ашу арқылы➡
Dialogue: 0,0:12:24.17,0:12:28.18,Default,,0,0,0,,Палубаның жоғарғы 5 картасынан Дриллинг Ангеліне қоңырау шалыңыз➡
Dialogue: 0,0:12:28.18,0:12:30.18,Default,,0,0,0,,Бұрғылау дағдыларын жалғастырыңыз➡
Dialogue: 0,0:12:30.18,0:12:32.18,Default,,0,0,0,,Палубаның жоғарғы 3 картасынан➡
Dialogue: 0,0:12:32.18,0:12:34.18,Default,,0,0,0,,Ауырсынуды басатын дәрі шақырыңыз!
Dialogue: 0,0:12:34.18,0:12:36.18,Default,,0,0,0,,Альденнің шеберлігі іске қосылды!
Dialogue: 0,0:12:36.18,0:12:39.19,Default,,0,0,0,,Лайтлидің айдаһарын өз қолыңыздан шақырыңыз➡
Dialogue: 0,0:12:39.19,0:12:41.19,Default,,0,0,0,,2 картаны сал!
Dialogue: 0,0:12:41.19,0:12:44.19,Default,,0,0,0,,Қосымша Philon Painkiller Boost➡ қоңырау шалыңыз
Dialogue: 0,0:12:44.19,0:12:47.20,Default,,0,0,0,,Бұрғылау арқылы ампуланың шашырауына шабуыл жасаңыз!
Dialogue: 0,0:12:47.20,0:12:49.20,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:12:49.20,0:12:51.20,Default,,0,0,0,,Painkiller шеберлігімен 1 картаны салыңыз➡
Dialogue: 0,0:12:51.20,0:12:54.70,Default,,0,0,0,,Алден болған кезде жеңіл ойыншылар күш алады➡
Dialogue: 0,0:12:54.70,0:12:56.70,Default,,0,0,0,,Lightlies Boost➡
Dialogue: 0,0:12:56.70,0:12:59.21,Default,,0,0,0,,Филонмен тағы бір ампуланың шашырауына шабуыл жасаңыз!
Dialogue: 0,0:12:59.21,0:13:01.14,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:13:01.14,0:13:03.65,Default,,0,0,0,,Жеңіл ату дағдылары Ұрыс соңында➡
Dialogue: 0,0:13:03.65,0:13:06.65,Default,,0,0,0,,Жанға бір бағанға бір бірлік қою арқылы➡
Dialogue: 0,0:13:06.65,0:13:09.15,Default,,0,0,0,,Альденнің күшін 10000➡-ке қосыңыз
Dialogue: 0,0:13:09.15,0:13:11.15,Default,,0,0,0,,Алденмен шабуыл!
Dialogue: 0,0:13:11.15,0:13:13.15,Default,,0,0,0,,Альденнің шеберлігін белсендіру➡
Dialogue: 0,0:13:13.15,0:13:16.16,Default,,0,0,0,,Әр түрлі дәрежедегі 3 артқы күзетші болған кезде➡
Dialogue: 0,0:13:16.16,0:13:18.66,Default,,0,0,0,,Өзіңіздің артқы қорғаушыларыңыздың бірін қолыңызға қайтарыңыз➡
Dialogue: 0,0:13:18.66,0:13:21.16,Default,,0,0,0,,Қайтарылған картаның бағасы одан төмен болуы керек➡
Dialogue: 0,0:13:21.16,0:13:23.67,Default,,0,0,0,,Сіздің қолыңыздан сол бағанға қоңырау шалу карталары➡
Dialogue: 0,0:13:23.67,0:13:26.17,Default,,0,0,0,,Lightlies-ді қолыңызға қайтарыңыз➡
Dialogue: 0,0:13:26.17,0:13:28.17,Default,,0,0,0,,Ермак пен Филонға қоңырау шалыңыз! ➡
Dialogue: 0,0:13:28.17,0:13:30.17,Default,,0,0,0,,Ermac шеберлігін белсендіру➡
Dialogue: 0,0:13:30.17,0:13:34.18,Default,,0,0,0,,Пауэр +15000 карта мүмкіндігімен пайда болған кезде!
Dialogue: 0,0:13:34.18,0:13:36.14,Default,,0,0,0,,Гуо~!
Dialogue: 0,0:13:38.68,0:13:40.68,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:13:40.68,0:13:42.65,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:13:45.69,0:13:48.19,Default,,0,0,0,,Гугя~!
Dialogue: 0,0:13:48.19,0:13:50.19,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:13:50.19,0:13:52.19,Default,,0,0,0,,Триггерді тарту 1 картаны тарту➡
Dialogue: 0,0:13:52.19,0:13:54.70,Default,,0,0,0,,Ermac қуаты плюс 10000 секундты тексеру➡
Dialogue: 0,0:13:54.70,0:13:56.70,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:13:56.70,0:13:59.67,Default,,0,0,0,,Унг Өйткені, Алден күшті карта.
Dialogue: 0,0:13:59.67,0:14:02.14,Default,,0,0,0,,Бұл үшін көп орын бар.
Dialogue: 0,0:14:02.14,0:14:04.14,Default,,0,0,0,,Зақымды тексеру➡
Dialogue: 0,0:14:04.14,0:14:06.14,Default,,0,0,0,,Емдеу триггері.
Dialogue: 0,0:14:06.14,0:14:08.11,Default,,0,0,0,,Ах...!
Dialogue: 0,0:14:09.64,0:14:12.65,Default,,0,0,0,,Күткендей, олар оны сол кезде дайындап жатқан.
Dialogue: 0,0:14:12.65,0:14:16.65,Default,,0,0,0,,1 зақымдарды және Грифогилланың қуатын +10000 қалпына келтіреді.
Dialogue: 0,0:14:16.65,0:14:20.15,Default,,0,0,0,,Philon's Boost Ermac көмегімен шабуыл!
Dialogue: 0,0:14:20.15,0:14:22.66,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:14:22.66,0:14:25.66,Default,,0,0,0,,Менің кезегім мен Кадвалланы шақырамын.
Dialogue: 0,0:14:25.66,0:14:27.66,Default,,0,0,0,,Сіз Персонаға мінбейсіз.
Dialogue: 0,0:14:27.66,0:14:31.17,Default,,0,0,0,,Гриффогилланың басқа да қолданылуы бар.
Dialogue: 0,0:14:31.17,0:14:33.67,Default,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:14:33.67,0:14:36.17,Default,,0,0,0,,Бұл кейінірек көңіл көтеру үшін➡
Dialogue: 0,0:14:36.17,0:14:38.17,Default,,0,0,0,,Ампуланың шашырауын шақырыңыз➡
Dialogue: 0,0:14:38.17,0:14:40.17,Default,,0,0,0,,Гриффогилламен шабуыл! ➡
Dialogue: 0,0:14:40.17,0:14:42.68,Default,,0,0,0,,Дағдылардың көмегімен қорқынышты өзгерістерді жойыңыз!
Dialogue: 0,0:14:42.68,0:14:44.68,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:14:44.68,0:14:46.68,Default,,0,0,0,,Ампула шашыратқышымен шабуыл!
Dialogue: 0,0:14:46.68,0:14:48.68,Default,,0,0,0,,Күзетші! Кадвалламен шабуыл жасаңыз!
Dialogue: 0,0:14:48.68,0:14:51.19,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:14:51.19,0:14:54.69,Default,,0,0,0,,Кадвалланың шеберлігі Бір картаны сызып, айналымды аяқтаңыз.
Dialogue: 0,0:14:54.69,0:14:57.69,Default,,0,0,0,,Guy Uniformers бағдарламасының мақсаты➡
Dialogue: 0,0:14:57.69,0:15:00.63,Default,,0,0,0,,Бұл барлық жауынгерлерді бақытты ету туралы, солай ма?
Dialogue: 0,0:15:00.63,0:15:04.63,Default,,0,0,0,,Әрине, сондықтан мен ақырғы шайқасқа келемін➡
Dialogue: 0,0:15:04.63,0:15:06.63,Default,,0,0,0,,Ең күшті жауынгер бол.
Dialogue: 0,0:15:06.63,0:15:09.14,Default,,0,0,0,,Тіпті көптеген жауынгерлердің құнына ма?
Dialogue: 0,0:15:09.14,0:15:12.64,Default,,0,0,0,,Соңғы шайқасқа жету - әрбір күрескердің шын ниеті.
Dialogue: 0,0:15:12.64,0:15:14.64,Default,,0,0,0,,Жетсем➡
Dialogue: 0,0:15:14.64,0:15:17.65,Default,,0,0,0,,Барлық жауынгерлер бақытты бола алады.
Dialogue: 0,0:15:17.65,0:15:19.65,Default,,0,0,0,,Жоқ... жұмысшы?
Dialogue: 0,0:15:19.65,0:15:21.62,Default,,0,0,0,,Жігіт, сен...
Dialogue: 0,0:15:23.15,0:15:25.15,Default,,0,0,0,,Persona Ride! ➡
Dialogue: 0,0:15:25.15,0:15:29.16,Default,,0,0,0,,Light Leeds-ке қоңырау шалу және 2 картаны тарту үшін Олденнің шеберлігін пайдаланыңыз➡
Dialogue: 0,0:15:29.16,0:15:32.16,Default,,0,0,0,,Басқа Light Leeds-ке қоңырау шалыңыз!
Dialogue: 0,0:15:32.16,0:15:35.16,Default,,0,0,0,,Мен барлық жауынгерлерді бірдей жақсы көремін!
Dialogue: 0,0:15:35.16,0:15:37.67,Default,,0,0,0,,Uniformers бағдарламасындағы жауынгерлерге сәттілік➡
Dialogue: 0,0:15:37.67,0:15:39.67,Default,,0,0,0,,Ол жасалған болуы керек!
Dialogue: 0,0:15:39.67,0:15:42.67,Default,,0,0,0,,Сіздің әдісіңіз үшін алақаныңыздан құлаған адамдар➡
Dialogue: 0,0:15:42.67,0:15:44.67,Default,,0,0,0,,Бұл сізді бақытты ете ала ма?
Dialogue: 0,0:15:44.67,0:15:46.67,Default,,0,0,0,,Бұл ұтымды емес➡
Dialogue: 0,0:15:46.67,0:15:49.18,Default,,0,0,0,,Дүниеде тек екі түрлі адамдар бар.
Dialogue: 0,0:15:49.18,0:15:51.68,Default,,0,0,0,,Ең күштісі ме, әлде басқасы ма?
Dialogue: 0,0:15:51.68,0:15:54.68,Default,,0,0,0,,Ха...! Сондықтан мен ең мықтымын➡
Dialogue: 0,0:15:54.68,0:15:56.68,Default,,0,0,0,,Өз күшіңізбен бөліссеңіз➡
Dialogue: 0,0:15:56.68,0:16:00.12,Default,,0,0,0,,Көбірек жауынгерлер бақытты бола алады!
Dialogue: 0,0:16:00.12,0:16:02.62,Default,,0,0,0,,Жоқ! Жеңіл Лидспен шабуыл!
Dialogue: 0,0:16:02.62,0:16:04.63,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:16:04.63,0:16:09.10,Default,,0,0,0,,Lightlies шеберлігін белсендіру Альденнің күші +10000!
Dialogue: 0,0:16:11.63,0:16:15.14,Default,,0,0,0,,Жігіт, мен сені түзетемін➡
Dialogue: 0,0:16:15.14,0:16:17.14,Default,,0,0,0,,Өзіңізді дайындаңыз! ➡
Dialogue: 0,0:16:17.14,0:16:19.11,Default,,0,0,0,,Алденмен шабуыл!
Dialogue: 0,0:16:20.14,0:16:22.14,Default,,0,0,0,,Дағды іске қосылды! ➡
Dialogue: 0,0:16:22.14,0:16:25.65,Default,,0,0,0,,Lightlies-ді қолыңызға қайтарыңыз және Ермак пен ауырсынуды басатын құралды шақырыңыз!
Dialogue: 0,0:16:25.65,0:16:27.65,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:16:27.65,0:16:29.65,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:16:29.65,0:16:32.15,Default,,0,0,0,,Триггерді екінші тексеру жоқ➡
Dialogue: 0,0:16:32.15,0:16:34.16,Default,,0,0,0,,Критикалық триггер! ➡
Dialogue: 0,0:16:34.16,0:16:37.66,Default,,0,0,0,,Ermac қуаты плюс 10000 критикалық плюс 1!
Dialogue: 0,0:16:37.66,0:16:40.66,Default,,0,0,0,,Бүктеу! Ауырсынуды басатын дәрі➡
Dialogue: 0,0:16:40.66,0:16:43.16,Default,,0,0,0,,Ермакпен шабуыл!
Dialogue: 0,0:16:43.16,0:16:45.17,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:16:45.17,0:16:48.17,Default,,0,0,0,,Philon's Boost Ermac көмегімен шабуыл!
Dialogue: 0,0:16:48.17,0:16:50.14,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:16:53.17,0:16:56.18,Default,,0,0,0,,((Жарайды, егер келесі кезекте шешсек➡
Dialogue: 0,0:16:56.18,0:16:58.68,Default,,0,0,0,,Триггерді іске қосу үшін уақытында қол жеткізілді. ))
Dialogue: 0,0:16:58.68,0:17:00.68,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:17:00.68,0:17:04.19,Default,,0,0,0,,Оны әрі қарай талқылаудың қажеті жоқ сияқты.
Dialogue: 0,0:17:04.19,0:17:07.19,Default,,0,0,0,,Жігіт, мен сен үшін ғанамын...
Dialogue: 0,0:17:07.19,0:17:09.69,Default,,0,0,0,,Жақында аяқтаймыз ба➡
Dialogue: 0,0:17:09.69,0:17:12.19,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:17:12.19,0:17:16.16,Default,,0,0,0,,Мен саған болашақты көрсетемін.
Dialogue: 0,0:17:19.70,0:17:21.70,Default,,0,0,0,,Бұл миазма туралы не деуге болады?
Dialogue: 0,0:17:21.70,0:17:25.21,Default,,0,0,0,,Апат бүршіктері енді гүлдеп жатыр!
Dialogue: 0,0:17:25.21,0:17:28.71,Default,,0,0,0,,Жұлдыз жейтін ақырғы айдаһар, түс!
Dialogue: 0,0:17:28.71,0:17:30.71,Default,,0,0,0,,Ешкімге… ешкімге…!!
Dialogue: 0,0:17:30.71,0:17:34.72,Default,,0,0,0,,Жойылып бара жатқан айдаһар ағашына, Griffogilla Vultex➡
Dialogue: 0,0:17:34.72,0:17:36.68,Default,,0,0,0,,Жүр!
Dialogue: 0,0:18:03.18,0:18:05.68,Default,,0,0,0,,Ах...! 11 сынып? ➡
Dialogue: 0,0:18:05.68,0:18:08.18,Default,,0,0,0,,Қуаты 18000!
Dialogue: 0,0:18:08.18,0:18:11.19,Default,,0,0,0,,Gryphogyra vartex➡ мінгенде
Dialogue: 0,0:18:11.19,0:18:14.66,Default,,0,0,0,,Griffo Escatology бағдарламасын тапсырыс аймағына орнатыңыз!
Dialogue: 0,0:18:16.19,0:18:18.69,Default,,0,0,0,,Grifo Escatology шеберлігі іске қосылды! ➡
Dialogue: 0,0:18:18.69,0:18:22.20,Default,,0,0,0,,Палубадан бір триггерді аттракционға қою арқылы➡
Dialogue: 0,0:18:22.20,0:18:24.70,Default,,0,0,0,,Тамшыдан Solder Zarkab-қа қоңырау шалыңыз➡
Dialogue: 0,0:18:24.70,0:18:27.20,Default,,0,0,0,,Рюки маркерін шеберлікпен қойыңыз➡
Dialogue: 0,0:18:27.20,0:18:29.70,Default,,0,0,0,,Қосымша эскатология дағдыларын белсендіріңіз! ➡
Dialogue: 0,0:18:29.70,0:18:33.21,Default,,0,0,0,,Гриффогилланы қолыңыздан тастаңыз және бір картаны салыңыз➡
Dialogue: 0,0:18:33.21,0:18:35.71,Default,,0,0,0,,Қосымша Рюки маркерін қойыңыз.
Dialogue: 0,0:18:35.71,0:18:38.21,Default,,0,0,0,,Бір шеңберде екі карта?
Dialogue: 0,0:18:38.21,0:18:42.72,Default,,0,0,0,,Содан кейін, зақымдалған жерге палубаның жоғарғы жағынан бір картаны қою арқылы ➡
Dialogue: 0,0:18:42.72,0:18:46.72,Default,,0,0,0,,Аяқтың келуін аттракционнан алып тастаңыз!
Dialogue: 0,0:18:46.72,0:18:49.72,Default,,0,0,0,,Нашар! Бұл...
Dialogue: 0,0:18:49.72,0:18:52.23,Default,,0,0,0,,Дұрыс? Жүрегің лүпілдеп тұр! ➡
Dialogue: 0,0:18:52.23,0:18:55.23,Default,,0,0,0,,Cadwalla Solder Zarkab's Boost➡ қоңырау шалыңыз
Dialogue: 0,0:18:55.23,0:18:57.73,Default,,0,0,0,,Кадвалламен шабуыл!
Dialogue: 0,0:18:57.73,0:18:59.70,Default,,0,0,0,,Ку... күзетші жоқ!
Dialogue: 0,0:19:00.67,0:19:04.17,Default,,0,0,0,,Парумидің Заркаб дәнекерімен күшейтетін шабуылы!
Dialogue: 0,0:19:04.17,0:19:06.67,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:19:06.67,0:19:08.68,Default,,0,0,0,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:19:08.68,0:19:12.65,Default,,0,0,0,,Салқын…. Бітті, Джинки.
Dialogue: 0,0:19:13.68,0:19:17.18,Default,,0,0,0,,Gryphogyra vartex өз айналымы кезінде➡
Dialogue: 0,0:19:17.18,0:19:20.69,Default,,0,0,0,,Қуат +10000 Критикалық +1 ➡
Dialogue: 0,0:19:20.69,0:19:23.69,Default,,0,0,0,,Gryphogyra Vultex-пен шабуыл! ➡
Dialogue: 0,0:19:23.69,0:19:26.16,Default,,0,0,0,,Барлық тыл сақшыларына шеберлікпен тұрыңыз!
Dialogue: 0,0:19:27.70,0:19:31.20,Default,,0,0,0,,Ал триггер➡
Dialogue: 0,0:19:31.20,0:19:33.20,Default,,0,0,0,,Мәжбүрлеп қосу!
Dialogue: 0,0:19:33.20,0:19:35.17,Default,,0,0,0,,Ку...!
Dialogue: 0,0:19:38.71,0:19:41.21,Default,,0,0,0,,Амартиноа іске қосылды➡
Dialogue: 0,0:19:41.21,0:19:44.21,Default,,0,0,0,,Gryphogyra Vultex қуаты плюс 100 миллион ➡
Dialogue: 0,0:19:44.21,0:19:47.72,Default,,0,0,0,,Тіпті осы бұрылыс кезінде тылшылар шабуыл жасаған ұрыстарда➡
Dialogue: 0,0:19:47.72,0:19:49.68,Default,,0,0,0,,Дискіні тексеруді орындаңыз.
Dialogue: 0,0:19:51.22,0:19:53.72,Default,,0,0,0,,Әрбір жұлдызды жойыңыз➡
Dialogue: 0,0:19:53.72,0:19:55.69,Default,,0,0,0,,Gryphogyra vartex!
Dialogue: 0,0:19:58.73,0:20:00.66,Default,,0,0,0,,Жігіт!
Dialogue: 0,0:20:00.66,0:20:04.67,Default,,0,0,0,,Сіз... барлық жауынгерлер бақытты болатын болашақ жасайсыз➡
Dialogue: 0,0:20:04.67,0:20:06.67,Default,,0,0,0,,Міне, сіз осыны мақсат етіп отырсыз!
Dialogue: 0,0:20:06.67,0:20:08.67,Default,,0,0,0,,Әрине➡
Dialogue: 0,0:20:08.67,0:20:10.67,Default,,0,0,0,,Әркім менің көшірмесім болса➡
Dialogue: 0,0:20:10.67,0:20:13.17,Default,,0,0,0,,Сіз міндетті түрде бақытты боласыз➡
Dialogue: 0,0:20:13.17,0:20:16.68,Default,,0,0,0,,Мені ешкім тоқтата алмайды.
Dialogue: 0,0:20:16.68,0:20:18.68,Default,,0,0,0,,Ку...! ➡
Dialogue: 0,0:20:18.68,0:20:21.18,Default,,0,0,0,,Зақымдануды тексеру 1-тармақ➡
Dialogue: 0,0:20:21.18,0:20:23.18,Default,,0,0,0,,Триггер жоқ➡
Dialogue: 0,0:20:23.18,0:20:25.19,Default,,0,0,0,,Екінші тармақ….
Dialogue: 0,0:20:25.19,0:20:27.19,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:27.19,0:20:29.16,Default,,0,0,0,,Жоқ…триггер.
Dialogue: 0,0:20:36.20,0:20:39.17,Default,,0,0,0,,Бұл менің жеңісім, Джинки.
Dialogue: 0,0:20:58.22,0:21:00.19,Default,,0,0,0,,Джинки мырза?
Dialogue: 0,0:21:01.16,0:21:06.16,Default,,0,0,0,,Күрескерлерді қуанту үшін соңғы жекпе-жекке жету➡
Dialogue: 0,0:21:06.16,0:21:10.16,Default,,0,0,0,,Осыған байланысты Гай екеуміздің мақсатымыз бір➡
Dialogue: 0,0:21:10.16,0:21:14.17,Default,,0,0,0,,Дегенмен, біз ұмтылатын әлем күрт өзгерді.
Dialogue: 0,0:21:14.17,0:21:18.17,Default,,0,0,0,,Мен барлық жауынгерлерді қуантқым келеді.
Dialogue: 0,0:21:18.17,0:21:22.68,Default,,0,0,0,,Бірақ Жігіт...қазір ол басқаруға тырысатын дүние➡
Dialogue: 0,0:21:22.68,0:21:25.18,Default,,0,0,0,,Тым тар➡
Dialogue: 0,0:21:25.18,0:21:29.15,Default,,0,0,0,,Оны жеткізу үшін жекпе-жекте одан асып түсу керек.
Dialogue: 0,0:21:30.18,0:21:32.19,Default,,0,0,0,,Менің бұлай айтуға жағдайым жоқ➡
Dialogue: 0,0:21:32.19,0:21:34.19,Default,,0,0,0,,Мен бұл туралы толық білемін.
Dialogue: 0,0:21:34.19,0:21:36.69,Default,,0,0,0,,Бірақ мен сендерден сұрай аламын.
Dialogue: 0,0:21:36.69,0:21:39.19,Default,,0,0,0,,Ах...! Өтінемін! ➡
Dialogue: 0,0:21:39.19,0:21:41.66,Default,,0,0,0,,Жігіттен асып түс!
Dialogue: 0,0:21:49.20,0:21:51.17,Default,,0,0,0,,Зинке мырза.
Dialogue: 0,0:21:53.71,0:21:55.71,Default,,0,0,0,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:21:55.71,0:21:58.68,Default,,0,0,0,,Мен міндетті түрде... асып түсемін!
Dialogue: 0,0:22:00.18,0:22:06.18,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory