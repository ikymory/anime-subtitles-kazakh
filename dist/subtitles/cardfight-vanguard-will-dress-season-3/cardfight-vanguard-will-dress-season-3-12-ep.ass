Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.27,0:00:05.30,Default,,0,0,0,,Эй, эй...! ➡
Dialogue: 0,0:00:05.30,0:00:09.81,Default,,0,0,0,,Авангардтың болашағын шешетін Паку тауының етегіндегі шешуші шайқас ақыры аяқталып келеді! ➡
Dialogue: 0,0:00:09.81,0:00:14.28,Default,,0,0,0,,Кім 2-1 есебімен жеңіп, Гайге қарсы шығуға құқылы болды?
Dialogue: 0,0:00:16.28,0:00:20.28,Default,,0,0,0,,Wildress командасы!
Dialogue: 0,0:00:20.28,0:00:23.25,Default,,0,0,0,,Уайлдрет... бізді айтасыз ба?
Dialogue: 0,0:00:23.25,0:00:25.32,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:00:25.32,0:00:28.32,Default,,0,0,0,,Жаңа буын командасынан шаршадым➡
Dialogue: 0,0:00:28.32,0:00:32.76,Default,,0,0,0,,Мен Шабдалы Яматаро мен оның достарының жақсы екенін айттым.
Dialogue: 0,0:00:32.76,0:00:36.27,Default,,0,0,0,,Біз...Wildless Өте жақсы!
Dialogue: 0,0:00:36.27,0:00:38.27,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:00:38.27,0:00:42.27,Default,,0,0,0,,Ерік…ерік немесе болашақ➡
Dialogue: 0,0:00:42.27,0:00:45.27,Default,,0,0,0,,Оны киіңіз...?
Dialogue: 0,0:00:50.35,0:00:52.38,Default,,0,0,0,,((Осы уақытқа дейін мен болдым➡
Dialogue: 0,0:00:52.38,0:00:56.35,Default,,0,0,0,,Ұрыс арқылы ойымды көйлектей кидім. )
Dialogue: 0,0:00:58.99,0:01:02.29,Default,,0,0,0,,((Басы - қараңғылық.
Dialogue: 0,0:01:02.29,0:01:05.76,Default,,0,0,0,,Ешкімнен бас тартпау рухымен тоқылған көйлектің түсі ➡
Dialogue: 0,0:01:05.76,0:01:08.86,Default,,0,0,0,,Неғұрлым шатастырылған болса, соғұрлым қалың болады➡
Dialogue: 0,0:01:08.86,0:01:11.27,Default,,0,0,0,,Түс нәзік қараңғылыққа айналды.
Dialogue: 0,0:01:11.27,0:01:14.30,Default,,0,0,0,,Сондықтан даралықты жоққа шығарыңыз➡
Dialogue: 0,0:01:14.30,0:01:18.77,Default,,0,0,0,,Барлығын бір түске бояйтын униформашыларды кешіре алмаймын➡
Dialogue: 0,0:01:18.77,0:01:21.81,Default,,0,0,0,,Мен оны күштеп түсіруге тырыстым.
Dialogue: 0,0:01:21.81,0:01:24.88,Default,,0,0,0,,Данжи мырза білгеніне сенімдімін.
Dialogue: 0,0:01:24.88,0:01:29.38,Default,,0,0,0,,Бірақ мен оны Закуса мырзадан жеңілгенше түсінбедім. )
Dialogue: 0,0:01:30.82,0:01:33.36,Default,,0,0,0,,((Менің ойым бір жағы ғана емес➡
Dialogue: 0,0:01:33.36,0:01:35.82,Default,,0,0,0,,Өзара болатын заттар. )
Dialogue: 0,0:01:37.93,0:01:40.90,Default,,0,0,0,,((Авангард - бұл хабарлаушы!)
Dialogue: 0,0:01:42.86,0:01:44.83,Default,,0,0,0,,((Бұл жолы➡
Dialogue: 0,0:01:44.83,0:01:47.34,Default,,0,0,0,,Мен Жігітпен дұрыстап бетпе-бет келіп, айтқым келеді. )
Dialogue: 0,0:02:02.78,0:02:04.75,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:03:47.22,0:03:49.22,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:04:02.74,0:04:04.74,Default,,0,0,0,,AR?
Dialogue: 0,0:04:04.74,0:04:07.71,Default,,0,0,0,,Енді, тау етегіндегі соңғы шайқас.
Dialogue: 0,0:04:07.71,0:04:11.75,Default,,0,0,0,,Мен Wildress командасының атынан келдім➡
Dialogue: 0,0:04:11.75,0:04:16.79,Default,,0,0,0,,Каганың Айдаһары Юю Кондо! ➡
Dialogue: 0,0:04:16.79,0:04:20.26,Default,,0,0,0,,Өкінішке орай Широганеден жеңіліп қалдық➡
Dialogue: 0,0:04:20.26,0:04:22.72,Default,,0,0,0,,Ойыңызды өзгертіңіз және онымен бетпе-бет келіңіз!
Dialogue: 0,0:04:25.23,0:04:27.26,Default,,0,0,0,,Қарсы! ➡
Dialogue: 0,0:04:27.26,0:04:30.23,Default,,0,0,0,,Формалар барлық жауынгерлерге бағыт берсін➡
Dialogue: 0,0:04:30.23,0:04:32.23,Default,,0,0,0,,Табиғаттан тыс күштердің болуы➡
Dialogue: 0,0:04:32.23,0:04:34.24,Default,,0,0,0,,Адамдар жасаған даналықтың кристалы➡
Dialogue: 0,0:04:34.24,0:04:36.24,Default,,0,0,0,,Ескі тәртіпті жою Құдайы➡
Dialogue: 0,0:04:36.24,0:04:39.27,Default,,0,0,0,,Болашақтың жаңа жаратушы құдайы?➡
Dialogue: 0,0:04:39.27,0:04:42.71,Default,,0,0,0,,Кибертеңізде жүзетін жасанды интеллект➡
Dialogue: 0,0:04:42.71,0:04:45.75,Default,,0,0,0,,Жігіт!
Dialogue: 0,0:04:45.75,0:04:48.72,Default,,0,0,0,,Соңғы шайқас... Маған қажет деректер ➡
Dialogue: 0,0:04:48.72,0:04:51.25,Default,,0,0,0,,Аяқтауға жақын➡
Dialogue: 0,0:04:51.25,0:04:55.76,Default,,0,0,0,,Бар болғаны өзіңізбен қарым-қатынас жасап жатқан адамды тартып алу➡
Dialogue: 0,0:04:55.76,0:05:00.23,Default,,0,0,0,,Бірақ... әлі келмеген сияқты.
Dialogue: 0,0:05:01.23,0:05:04.23,Default,,0,0,0,,Бірақ бәрібір, ол балалар да, сен де➡
Dialogue: 0,0:05:04.23,0:05:07.24,Default,,0,0,0,,Мен сізге міндетті түрде жол көрсетемін➡
Dialogue: 0,0:05:07.24,0:05:09.77,Default,,0,0,0,,Нағыз мықты➡
Dialogue: 0,0:05:09.77,0:05:12.24,Default,,0,0,0,,Бұдан асып кетіңіз.
Dialogue: 0,0:05:13.28,0:05:16.75,Default,,0,0,0,,Жекелік және жеке еместік Киім және форма➡
Dialogue: 0,0:05:16.75,0:05:19.21,Default,,0,0,0,,Қанша алыс жүрсек те, екеуі кездеспейді➡
Dialogue: 0,0:05:19.21,0:05:21.78,Default,,0,0,0,,Су мен май сияқты! ➡
Dialogue: 0,0:05:21.78,0:05:25.25,Default,,0,0,0,,Олар қарама-қарсы болғандықтан, соқтығысуы сөзсіз➡
Dialogue: 0,0:05:25.25,0:05:29.32,Default,,0,0,0,,Екеуінің арасындағы жекпе-жек басталғалы тұр! ➡
Dialogue: 0,0:05:29.32,0:05:32.73,Default,,0,0,0,,Жақынырақ қараңыз! Уильдреске қарсы униформалар➡
Dialogue: 0,0:05:32.73,0:05:35.73,Default,,0,0,0,,Бұл нағыз ақтық шайқас➡
Dialogue: 0,0:05:35.73,0:05:37.70,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:05:39.80,0:05:42.24,Default,,0,0,0,,Тұрақты Авангард.
Dialogue: 0,0:05:42.24,0:05:44.24,Default,,0,0,0,,Глифосид.
Dialogue: 0,0:05:44.24,0:05:46.24,Default,,0,0,0,,Тосын жұмыртқа.
Dialogue: 0,0:05:46.24,0:05:48.21,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:05:48.21,0:05:51.78,Default,,0,0,0,,Glyphoside шеберлігін белсендіру➡ мінбеңіз
Dialogue: 0,0:05:51.78,0:05:54.75,Default,,0,0,0,,Соңының басын жаныңа салып, кезегіңді аяқта.
Dialogue: 0,0:05:54.75,0:05:56.72,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:05:56.72,0:05:58.72,Default,,0,0,0,,Реноға бару.
Dialogue: 0,0:05:58.72,0:06:01.22,Default,,0,0,0,,1 картаны шеберлікпен салыңыз және Реномен шабуыл жасаңыз!
Dialogue: 0,0:06:01.22,0:06:04.73,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:06:04.73,0:06:06.73,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:06:06.73,0:06:08.73,Default,,0,0,0,,Жаныңызға қорқынышты өзгеріс әкелу➡
Dialogue: 0,0:06:08.73,0:06:10.73,Default,,0,0,0,,Глифозидпен шабуыл.
Dialogue: 0,0:06:10.73,0:06:12.73,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:06:12.73,0:06:14.74,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:06:14.74,0:06:17.74,Default,,0,0,0,,Триггердің бұрылыс ұшы жоқ.
Dialogue: 0,0:06:17.74,0:06:20.24,Default,,0,0,0,,Блантгейт….
Dialogue: 0,0:06:20.24,0:06:23.21,Default,,0,0,0,,Себебі мен Айдаһар империясында жеңдім.
Dialogue: 0,0:06:24.75,0:06:26.72,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:06:26.72,0:06:30.39,Default,,0,0,0,,Тристаға Рейлдің жүру шеберлігімен қоңырау шалыңыз!
Dialogue: 0,0:06:30.39,0:06:33.72,Default,,0,0,0,,Аспанды жарып тұрған айдаһарды Апаразия деп атаңыз!
Dialogue: 0,0:06:33.72,0:06:35.76,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:06:35.76,0:06:39.26,Default,,0,0,0,,Палубадан жалын аспанының сүйкімді айдаһары Нандикаға қоңырау шалыңыз!
Dialogue: 0,0:06:39.26,0:06:42.73,Default,,0,0,0,,Юю екі жаңа Прайя айдаһарына қоңырау шалыңыз!
Dialogue: 0,0:06:43.77,0:06:47.27,Default,,0,0,0,,Мен палубамды қайта қарастырдым. Бұл дұрыс шешім➡
Dialogue: 0,0:06:47.27,0:06:51.77,Default,,0,0,0,,Егер сіз мұны жасамасаңыз, сіз бұрынғыдай нәтижеге қол жеткізесіз.
Dialogue: 0,0:06:52.74,0:06:54.71,Default,,0,0,0,,Рейлмен шабуыл!
Dialogue: 0,0:06:54.71,0:06:56.75,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:06:56.75,0:06:59.25,Default,,0,0,0,,Нандикамен шабуыл! күзетші.
Dialogue: 0,0:06:59.25,0:07:02.25,Default,,0,0,0,,Апаразиямен шабуыл! күзетші.
Dialogue: 0,0:07:03.22,0:07:06.22,Default,,0,0,0,,Бұрылыстың соңы. Хмм….
Dialogue: 0,0:07:06.22,0:07:08.76,Default,,0,0,0,,Сізде бір нәрсе бар.
Dialogue: 0,0:07:08.76,0:07:11.26,Default,,0,0,0,,Әйтпесе➡
Dialogue: 0,0:07:11.26,0:07:14.23,Default,,0,0,0,,Олар сізге сеніп тапсыруға негіз жоқ.
Dialogue: 0,0:07:16.23,0:07:19.23,Default,,0,0,0,,Мен оны асыға күтемін, Юю Кондо➡
Dialogue: 0,0:07:19.23,0:07:23.24,Default,,0,0,0,,Сондықтан мені ренжітпе➡
Dialogue: 0,0:07:23.24,0:07:25.27,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:07:25.27,0:07:27.78,Default,,0,0,0,,Глифосид дағдыларын белсендіру➡
Dialogue: 0,0:07:27.78,0:07:31.21,Default,,0,0,0,,Аяқтың келуін ат палубасынан жанға салыңыз➡
Dialogue: 0,0:07:31.21,0:07:35.25,Default,,0,0,0,,Енді сізде үш апат картасы бар➡
Dialogue: 0,0:07:35.25,0:07:39.22,Default,,0,0,0,,Тұқымдар өседі, бірақ апат тамыр алады➡
Dialogue: 0,0:07:39.22,0:07:42.76,Default,,0,0,0,,Ұлы ағаш жұлдыздардың құнына тарайды➡
Dialogue: 0,0:07:42.76,0:07:46.23,Default,,0,0,0,,Келіңіз➡
Dialogue: 0,0:07:46.23,0:07:48.20,Default,,0,0,0,,Жойылған бала!
Dialogue: 0,0:07:50.73,0:07:53.77,Default,,0,0,0,,Барлығын жеу➡
Dialogue: 0,0:07:53.77,0:07:57.24,Default,,0,0,0,,Тұтылу айдаһар ағашына мініңіз, Гриффогилла!
Dialogue: 0,0:08:00.41,0:08:02.21,Default,,0,0,0,,((Келді….)
Dialogue: 0,0:08:02.21,0:08:05.21,Default,,0,0,0,,Сайба Кайтолға➡ қоңырау шалыңыз
Dialogue: 0,0:08:05.21,0:08:07.75,Default,,0,0,0,,Рюки маркерін шеберлікпен қойыңыз➡
Dialogue: 0,0:08:07.75,0:08:11.72,Default,,0,0,0,,Қолыңызға гидрагурум маскасын қосып, ойнаңыз.
Dialogue: 0,0:08:11.72,0:08:13.72,Default,,0,0,0,,Палубаның жоғарғы 5 картасынан➡
Dialogue: 0,0:08:13.72,0:08:17.23,Default,,0,0,0,,Гриффогилланы қолыңызға қосыңыз➡
Dialogue: 0,0:08:17.23,0:08:19.73,Default,,0,0,0,,Бобалмин мен Ллойд Акселусқа қоңырау шалыңыз➡
Dialogue: 0,0:08:19.73,0:08:22.73,Default,,0,0,0,,Рюки маркерін шеберлікпен қойыңыз➡
Dialogue: 0,0:08:22.73,0:08:25.73,Default,,0,0,0,,Гриффогилламен шабуыл!
Dialogue: 0,0:08:25.73,0:08:27.74,Default,,0,0,0,,4 Рюки маркері бар➡
Dialogue: 0,0:08:27.74,0:08:31.21,Default,,0,0,0,,Қуат плюс 20 000, критикалық плюс 1.
Dialogue: 0,0:08:32.31,0:08:36.78,Default,,0,0,0,,((Критикалық 2, бірақ әлі де 0 зиян➡
Dialogue: 0,0:08:36.78,0:08:39.71,Default,,0,0,0,,Міне...Мен қабылдаймын! )
Dialogue: 0,0:08:39.71,0:08:41.72,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:08:41.72,0:08:43.75,Default,,0,0,0,,Жарайды➡
Dialogue: 0,0:08:43.75,0:08:45.82,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:08:45.82,0:08:47.76,Default,,0,0,0,,Критикалық триггер.
Dialogue: 0,0:08:47.76,0:08:49.72,Default,,0,0,0,,Axelyus қуаты плюс 10000➡
Dialogue: 0,0:08:49.72,0:08:53.23,Default,,0,0,0,,Gryphogilla Critical Plus 1➡
Dialogue: 0,0:08:53.23,0:08:55.23,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:08:55.23,0:08:57.23,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:08:57.23,0:08:59.27,Default,,0,0,0,,Қандай сын! ➡
Dialogue: 0,0:08:59.27,0:09:02.74,Default,,0,0,0,,Ешбір күзетші таңдамаған Юю 3 ұпай алады!
Dialogue: 0,0:09:02.74,0:09:04.74,Default,,0,0,0,,Акзелуспен шабуыл.
Dialogue: 0,0:09:04.74,0:09:06.74,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:09:06.74,0:09:08.71,Default,,0,0,0,,Кайтолмен шабуыл.
Dialogue: 0,0:09:08.71,0:09:11.21,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:09:12.21,0:09:14.75,Default,,0,0,0,,Мен оны қабылдауды шештім, сондықтан бұл жақсы.
Dialogue: 0,0:09:14.75,0:09:16.72,Default,,0,0,0,,Шайқас басталады➡
Dialogue: 0,0:09:16.72,0:09:19.22,Default,,0,0,0,,Менің жеребе кезегім!
Dialogue: 0,0:09:20.26,0:09:23.22,Default,,0,0,0,,Тенрин Хорю Нирвана Дживаға барыңыз!
Dialogue: 0,0:09:23.22,0:09:25.26,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:09:25.26,0:09:27.23,Default,,0,0,0,,Трикста мен Брахмадаға тамшыдан қоңырау шалыңыз!
Dialogue: 0,0:09:28.26,0:09:32.73,Default,,0,0,0,,Биллс Верлинаға арналған кроссовер көйлек!
Dialogue: 0,0:09:33.74,0:09:35.74,Default,,0,0,0,,Нандика шеберлігін белсендіру➡
Dialogue: 0,0:09:35.74,0:09:37.77,Default,,0,0,0,,Биллс Верлина шабуыл жасағанда➡
Dialogue: 0,0:09:37.77,0:09:39.74,Default,,0,0,0,,Егер сіздің қарсыласыңыз өз қолынан 2 немесе одан да көп карта ойнамаса➡
Dialogue: 0,0:09:39.74,0:09:41.74,Default,,0,0,0,,Қорғауға болмайды!
Dialogue: 0,0:09:41.74,0:09:44.75,Default,,0,0,0,,Сонымен қатар, Биллс Верлинаның шеберлігін белсендіру➡
Dialogue: 0,0:09:44.75,0:09:47.72,Default,,0,0,0,,Гару Верлинаны тамшыдан қолыңызға қосыңыз➡
Dialogue: 0,0:09:47.72,0:09:49.72,Default,,0,0,0,,Кроссовер көйлек!
Dialogue: 0,0:09:52.72,0:09:54.76,Default,,0,0,0,,Хэхе... Apparasia дағдыларымен➡
Dialogue: 0,0:09:54.76,0:09:57.73,Default,,0,0,0,,Гару Верлина сіздің қарсыласыңыздың келесі айналымының соңына дейін қалады➡
Dialogue: 0,0:09:57.73,0:10:00.73,Default,,0,0,0,,Қабілеті бар таңдай алмасаңыз, 1 картаны салыңыз.
Dialogue: 0,0:10:00.73,0:10:02.73,Default,,0,0,0,,Кеттік...
Dialogue: 0,0:10:02.73,0:10:04.73,Default,,0,0,0,,Гару Верлинамен шабуыл!
Dialogue: 0,0:10:04.73,0:10:06.73,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:10:06.73,0:10:08.74,Default,,0,0,0,,Нирвана Дживамен шабуыл!
Dialogue: 0,0:10:08.74,0:10:11.24,Default,,0,0,0,,Гару Верлинаға шеберлікпен тұрыңыз!
Dialogue: 0,0:10:11.24,0:10:13.74,Default,,0,0,0,,Күзетші. Қос жетек➡
Dialogue: 0,0:10:13.74,0:10:16.21,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:10:16.21,0:10:18.25,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:10:18.25,0:10:20.25,Default,,0,0,0,,Емдеу триггері.
Dialogue: 0,0:10:20.25,0:10:22.22,Default,,0,0,0,,1 зақымдалған картаны қалпына келтіреді➡
Dialogue: 0,0:10:22.22,0:10:24.72,Default,,0,0,0,,Вексельдер Верлинаның күші плюс 10 000!
Dialogue: 0,0:10:24.72,0:10:27.26,Default,,0,0,0,,О, өкше триггер! ➡
Dialogue: 0,0:10:27.26,0:10:32.23,Default,,0,0,0,,Алдыңғы айналымдағы маңызды триггер жойылды!
Dialogue: 0,0:10:32.23,0:10:36.23,Default,,0,0,0,,Гару Верлинамен тұрып шабуыл жасаңыз!
Dialogue: 0,0:10:36.23,0:10:38.23,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:10:38.23,0:10:40.24,Default,,0,0,0,,Билл Верлинамен шабуыл!
Dialogue: 0,0:10:40.24,0:10:42.24,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:10:42.24,0:10:44.27,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:10:44.27,0:10:46.74,Default,,0,0,0,,Юйюдің ашулы үздіксіз шабуылы Гайге➡ 4 зиян келтіреді
Dialogue: 0,0:10:46.74,0:10:48.74,Default,,0,0,0,,Үстелдер айналды!
Dialogue: 0,0:10:48.74,0:10:51.75,Default,,0,0,0,,Ұнаса, көбірек көрсет➡
Dialogue: 0,0:10:51.75,0:10:54.75,Default,,0,0,0,,Егер мен сізден деректер жинай алсам➡
Dialogue: 0,0:10:54.75,0:10:56.72,Default,,0,0,0,,Соңғы шайқас үшін➡
Dialogue: 0,0:10:56.72,0:10:59.25,Default,,0,0,0,,Өйткені сен Шыңгидің арманына жақындайсың!
Dialogue: 0,0:10:59.25,0:11:01.39,Default,,0,0,0,,Шинги Мукае….
Dialogue: 0,0:11:01.39,0:11:05.23,Default,,0,0,0,,AI зерттеушісі және авангард данышпан➡
Dialogue: 0,0:11:05.23,0:11:09.73,Default,,0,0,0,,Мен ол арқылы жаратылғанмын.
Dialogue: 0,0:11:13.30,0:11:16.24,Default,,0,0,0,,((Шинги маған көп нәрсені үйретті➡
Dialogue: 0,0:11:16.24,0:11:18.31,Default,,0,0,0,,Мен де өз бетімше үйрендім➡
Dialogue: 0,0:11:18.31,0:11:20.28,Default,,0,0,0,,Және... )
Dialogue: 0,0:11:20.28,0:11:22.24,Default,,0,0,0,,((Не болды? Жігіт➡
Dialogue: 0,0:11:22.24,0:11:24.25,Default,,0,0,0,,Соңғы уақытта өзіңізді жақсы сезінбейтін сияқтысыз.
Dialogue: 0,0:11:24.25,0:11:26.21,Default,,0,0,0,,Мм...➡
Dialogue: 0,0:11:26.21,0:11:29.25,Default,,0,0,0,,Мен өзімді қазір өте жалғыз сезінемін.
Dialogue: 0,0:11:29.25,0:11:31.25,Default,,0,0,0,,Неге жалғызсың?
Dialogue: 0,0:11:31.25,0:11:34.22,Default,,0,0,0,,Мен жердің кез келген жеріне әп-сәтте бара аламын➡
Dialogue: 0,0:11:34.22,0:11:37.23,Default,,0,0,0,,Кез келген білімді бірден алуға болады➡
Dialogue: 0,0:11:37.23,0:11:39.73,Default,,0,0,0,,Бірақ мен Шыңғыға бара алмаймын➡
Dialogue: 0,0:11:39.73,0:11:42.73,Default,,0,0,0,,Мен басқа әлемде өмір сүріп жатқаныма қынжыламын.
Dialogue: 0,0:11:42.73,0:11:44.73,Default,,0,0,0,,Хмм….
Dialogue: 0,0:11:44.73,0:11:46.73,Default,,0,0,0,,Олай болса менің бір ұсынысым бар➡
Dialogue: 0,0:11:46.73,0:11:49.24,Default,,0,0,0,,Неліктен мұны есте сақтауға тырыспайсыз?
Dialogue: 0,0:11:49.24,0:11:51.24,Default,,0,0,0,,Бұл➡
Dialogue: 0,0:11:51.24,0:11:53.24,Default,,0,0,0,,Авангард?
Dialogue: 0,0:11:53.24,0:11:55.74,Default,,0,0,0,,Бұл жақсы ма? Жігіт➡
Dialogue: 0,0:11:55.74,0:11:58.25,Default,,0,0,0,,Бұл авангард - менің альтер эго➡
Dialogue: 0,0:11:58.25,0:12:00.75,Default,,0,0,0,,Мына жігітке мініп, онымен күрес.
Dialogue: 0,0:12:00.75,0:12:03.79,Default,,0,0,0,,Егер бұл басқа эго болса... онда мен де!
Dialogue: 0,0:12:03.79,0:12:07.26,Default,,0,0,0,,Иә! Сіз бір әлемде күресуге болады.
Dialogue: 0,0:12:07.26,0:12:09.22,Default,,0,0,0,,Менің есімде➡
Dialogue: 0,0:12:09.22,0:12:11.23,Default,,0,0,0,,Тез айт!
Dialogue: 0,0:12:15.23,0:12:18.73,Default,,0,0,0,,Триггер жоқ. Жарайды, мен жеңдім!
Dialogue: 0,0:12:18.73,0:12:20.77,Default,,0,0,0,,Шыңги тым күшті➡
Dialogue: 0,0:12:20.77,0:12:23.77,Default,,0,0,0,,Бұл мен ойлаған кез келген үлгіден асып түседі.
Dialogue: 0,0:12:23.77,0:12:28.24,Default,,0,0,0,,Хмм... Менде әлі де деректер жеткіліксіз➡
Dialogue: 0,0:12:28.24,0:12:32.25,Default,,0,0,0,,Енді, түпкілікті шайқас – бұл арман.
Dialogue: 0,0:12:32.25,0:12:35.22,Default,,0,0,0,,Соңғы шайқас? Un➡
Dialogue: 0,0:12:35.22,0:12:37.25,Default,,0,0,0,,Өзіңізді және басқаларды бақытты етіңіз➡
Dialogue: 0,0:12:37.25,0:12:40.26,Default,,0,0,0,,Әрбір күрескердің мақсаты.
Dialogue: 0,0:12:40.26,0:12:42.72,Default,,0,0,0,,Шынайы және ең күштісі одан тыс.
Dialogue: 0,0:12:43.73,0:12:46.73,Default,,0,0,0,,Нағыз мықтылардан басқа?
Dialogue: 0,0:12:46.73,0:12:49.23,Default,,0,0,0,,А, менің арманым.
Dialogue: 0,0:12:49.23,0:12:51.23,Default,,0,0,0,,Шыңгидің арманы?
Dialogue: 0,0:12:51.23,0:12:54.24,Default,,0,0,0,,Сіз ынтымақтастық жасайсыз ба? Жігіт.
Dialogue: 0,0:12:56.24,0:12:58.21,Default,,0,0,0,,Ум!
Dialogue: 0,0:13:00.24,0:13:03.71,Default,,0,0,0,,Бірақ... Шыңги дүниеден өтті.
Dialogue: 0,0:13:06.21,0:13:11.22,Default,,0,0,0,,Шыңги...жалғастырамын➡
Dialogue: 0,0:13:11.22,0:13:14.29,Default,,0,0,0,,Яғни➡
Dialogue: 0,0:13:14.29,0:13:16.29,Default,,0,0,0,,Өйткені бұл Шыңгидің арманы. )
Dialogue: 0,0:13:19.76,0:13:23.73,Default,,0,0,0,,Мен әлемнің түкпір-түкпірінен алынған үлкен көлемдегі деректерді талдадым➡
Dialogue: 0,0:13:23.73,0:13:26.20,Default,,0,0,0,,Бағдарламаны орындады.
Dialogue: 0,0:13:28.27,0:13:31.77,Default,,0,0,0,,Енді теориялық тұрғыдан маған тең келетін ешкім жоқ➡
Dialogue: 0,0:13:31.77,0:13:35.74,Default,,0,0,0,,Тек белгісіз деректеріңізді жинау ғана қалды➡
Dialogue: 0,0:13:35.74,0:13:37.75,Default,,0,0,0,,Мен сізден ынтымақтастық сұраймын➡
Dialogue: 0,0:13:37.75,0:13:40.72,Default,,0,0,0,,Шыңғыда және менің арманымда...
Dialogue: 0,0:13:40.72,0:13:43.25,Default,,0,0,0,,Келісім талап етілмейді.
Dialogue: 0,0:13:43.25,0:13:45.22,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:13:48.72,0:13:52.73,Default,,0,0,0,,Апат бүршіктері енді гүлдеп жатыр!
Dialogue: 0,0:13:58.23,0:14:01.77,Default,,0,0,0,,Жұлдыздарды жейтін ақырғы айдаһар➡
Dialogue: 0,0:14:01.77,0:14:05.24,Default,,0,0,0,,Келу!
Dialogue: 0,0:14:05.24,0:14:08.21,Default,,0,0,0,,Жою гегемония ағашы➡
Dialogue: 0,0:14:08.21,0:14:11.21,Default,,0,0,0,,Gryphogyra Vultex-ке мініңіз!
Dialogue: 0,0:14:14.22,0:14:17.29,Default,,0,0,0,,Gryphogyra vartex➡
Dialogue: 0,0:14:17.29,0:14:19.29,Default,,0,0,0,,11-сынып...!
Dialogue: 0,0:14:20.22,0:14:23.19,Default,,0,0,0,,Джинки мырза осылай деді...
Dialogue: 0,0:14:23.19,0:14:25.23,Default,,0,0,0,,Valtex➡ мінген кезде
Dialogue: 0,0:14:25.23,0:14:29.23,Default,,0,0,0,,Grifo Escatology параметрін тапсырыс аймағында орнатыңыз➡
Dialogue: 0,0:14:29.23,0:14:33.70,Default,,0,0,0,,Дағдыны белсендіру Kaitool-ке қоңырау шалыңыз➡
Dialogue: 0,0:14:33.70,0:14:37.21,Default,,0,0,0,,Осы дағдыны пайдаланып Рюки маркерін қойыңыз.
Dialogue: 0,0:14:37.21,0:14:40.24,Default,,0,0,0,,Эскатологияның дағдыларын одан әрі белсендіру➡
Dialogue: 0,0:14:40.24,0:14:43.71,Default,,0,0,0,,Гриффогилланы қолыңыздан тастаңыз және бір картаны салыңыз➡
Dialogue: 0,0:14:43.71,0:14:46.18,Default,,0,0,0,,Қосымша Рюки маркерін қойыңыз.
Dialogue: 0,0:14:47.35,0:14:50.25,Default,,0,0,0,,((Рюки маркері 6 болады...)
Dialogue: 0,0:14:50.25,0:14:53.69,Default,,0,0,0,,Және палубаның жоғарғы картасын зақымдалған жерге қою арқылы➡
Dialogue: 0,0:14:53.69,0:14:56.76,Default,,0,0,0,,Апаттық карталарды палубалардан алып тастаңыз.
Dialogue: 0,0:14:56.76,0:14:59.23,Default,,0,0,0,,Екінші апат картасы жоғалып кетті! ➡
Dialogue: 0,0:14:59.23,0:15:02.70,Default,,0,0,0,,Бұл артық триггердің тезірек іске қосылғанын білдіреді!
Dialogue: 0,0:15:02.70,0:15:04.70,Default,,0,0,0,,Кух….
Dialogue: 0,0:15:04.70,0:15:06.70,Default,,0,0,0,,Көңіліңіз толқып тұр ма?
Dialogue: 0,0:15:06.70,0:15:08.70,Default,,0,0,0,,Тағы не? ➡
Dialogue: 0,0:15:08.70,0:15:10.71,Default,,0,0,0,,Маған көбірек...деректер керек➡
Dialogue: 0,0:15:10.71,0:15:13.71,Default,,0,0,0,,Мен сізге бағыт-бағдар беремін➡
Dialogue: 0,0:15:13.71,0:15:16.71,Default,,0,0,0,,Гидраглум маскасын ойнаңыз! ➡
Dialogue: 0,0:15:16.71,0:15:20.21,Default,,0,0,0,,Ақзелусты қолыңызға қосып, қоңырау шалыңыз! ➡
Dialogue: 0,0:15:20.21,0:15:23.72,Default,,0,0,0,,Gryphogyra vartex қуаты 18000➡
Dialogue: 0,0:15:23.72,0:15:26.19,Default,,0,0,0,,Бұрылыс кезінде қуат +10000 және ➡
Dialogue: 0,0:15:26.19,0:15:28.72,Default,,0,0,0,,Critical Plus 1➡
Dialogue: 0,0:15:28.72,0:15:31.69,Default,,0,0,0,,Ал... Hydraglum және Ryuki маркерлерінің саны ➡
Dialogue: 0,0:15:31.69,0:15:33.69,Default,,0,0,0,,10 немесе одан да көп карта болған кезде ➡
Dialogue: 0,0:15:33.69,0:15:35.70,Default,,0,0,0,,Сонымен қатар, қуат 10 000-ға қосылады.
Dialogue: 0,0:15:40.27,0:15:42.70,Default,,0,0,0,,Салқын…. Valtex-пен шабуыл жасаңыз! ➡
Dialogue: 0,0:15:42.70,0:15:46.34,Default,,0,0,0,,Бір апат картасын шеберлікпен алып тастаңыз!
Dialogue: 0,0:15:46.34,0:15:48.21,Default,,0,0,0,,((Бұл үшінші...)
Dialogue: 0,0:15:48.21,0:15:50.21,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:15:50.21,0:15:52.21,Default,,0,0,0,,Кесу!
Dialogue: 0,0:15:52.21,0:15:55.22,Default,,0,0,0,,Қос жетекті бірінші тексеру➡
Dialogue: 0,0:15:55.22,0:15:57.22,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:15:57.22,0:15:59.22,Default,,0,0,0,,Триггерді салу➡
Dialogue: 0,0:15:59.22,0:16:02.22,Default,,0,0,0,,1 картаны салыңыз, Kaitool қуаты плюс 10000➡
Dialogue: 0,0:16:02.22,0:16:04.19,Default,,0,0,0,,(Есіктің ашылуы мен аяқ дыбыстары)
Dialogue: 0,0:16:04.19,0:16:07.70,Default,,0,0,0,,Біз кез келген қарсы шабуылға қарсы тұруымыз керек.
Dialogue: 0,0:16:08.70,0:16:10.70,Default,,0,0,0,,Bobal Mine Boost➡
Dialogue: 0,0:16:10.70,0:16:13.20,Default,,0,0,0,,Каитолмен Гару Верлинаға шабуыл жасаңыз!
Dialogue: 0,0:16:13.20,0:16:15.20,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:16:15.20,0:16:17.71,Default,,0,0,0,,Бобалмин дағдыларын белсендіру➡
Dialogue: 0,0:16:17.71,0:16:19.71,Default,,0,0,0,,Оны жанға салыңыз➡
Dialogue: 0,0:16:19.71,0:16:21.71,Default,,0,0,0,,Қарсы төлем! ➡
Dialogue: 0,0:16:21.71,0:16:23.71,Default,,0,0,0,,Авангардқа Кайтолмен шабуыл жасаңыз!
Dialogue: 0,0:16:23.71,0:16:26.21,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:16:26.21,0:16:28.22,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:16:28.22,0:16:31.22,Default,,0,0,0,,Юю Gryphogyra vartex алдында ➡
Dialogue: 0,0:16:31.22,0:16:33.69,Default,,0,0,0,,4 зақым және сіздің кезегіңіз➡
Dialogue: 0,0:16:33.69,0:16:36.19,Default,,0,0,0,,Қазіргі уақытта Гайде 5 зақым бар!
Dialogue: 0,0:16:36.19,0:16:38.23,Default,,0,0,0,,Тағы бір нүкте!
Dialogue: 0,0:16:38.23,0:16:40.76,Default,,0,0,0,,Алмасаң жаман... Е...?
Dialogue: 0,0:16:40.76,0:16:43.70,Default,,0,0,0,,Барлық апат карталары жойылды.
Dialogue: 0,0:16:43.70,0:16:46.20,Default,,0,0,0,,Жігіттің келесі бұрылысында➡
Dialogue: 0,0:16:46.20,0:16:48.70,Default,,0,0,0,,Триггер іске қосылды!
Dialogue: 0,0:16:52.74,0:16:56.24,Default,,0,0,0,,Hydraglum және Ryuki маркерлерінің саны 10 немесе одан көп болса ➡
Dialogue: 0,0:16:56.24,0:17:00.21,Default,,0,0,0,,10 000 қуат қосатын дағдылар тұрақты қабілеттер болып табылады.
Dialogue: 0,0:17:00.21,0:17:02.85,Default,,0,0,0,,Яғни, сіздің кезегіңізде➡
Dialogue: 0,0:17:02.85,0:17:06.35,Default,,0,0,0,,Валтекстің қуаты 28 000.
Dialogue: 0,0:17:09.69,0:17:11.69,Default,,0,0,0,,２８０００…。
Dialogue: 0,0:17:11.69,0:17:15.20,Default,,0,0,0,,Әлі де... Менің кетуден басқа амалым жоқ!
Dialogue: 0,0:17:15.20,0:17:18.20,Default,,0,0,0,,Менің жеребе кезегім!
Dialogue: 0,0:17:18.20,0:17:20.20,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:17:21.20,0:17:23.70,Default,,0,0,0,,Осы дағдымен бір картаны сал!
Dialogue: 0,0:17:25.21,0:17:27.34,Default,,0,0,0,,Ах...!
Dialogue: 0,0:17:27.34,0:17:29.34,Default,,0,0,0,,((Ол келді.)
Dialogue: 0,0:17:30.21,0:17:32.21,Default,,0,0,0,,Триста!
Dialogue: 0,0:17:32.21,0:17:34.72,Default,,0,0,0,,Брам Верлинаның киімі➡
Dialogue: 0,0:17:34.72,0:17:36.68,Default,,0,0,0,,Кроссовер көйлек!
Dialogue: 0,0:17:37.72,0:17:41.22,Default,,0,0,0,,2 картаны тарту және 1 картаны тастау үшін Брамада шеберлігін пайдаланыңыз!
Dialogue: 0,0:17:43.26,0:17:46.73,Default,,0,0,0,,((Сіздердің біреулеріңіз ғана айқас кие аласыз.
Dialogue: 0,0:17:46.73,0:17:49.73,Default,,0,0,0,,Гару Верлина немесе Мираз Верлина...
Dialogue: 0,0:17:51.20,0:17:53.20,Default,,0,0,0,,Тағы бір нүкте.
Dialogue: 0,0:17:54.24,0:17:57.24,Default,,0,0,0,,Гару Верлинаның күзет шектеу қабілеті бар➡
Dialogue: 0,0:17:57.24,0:18:00.24,Default,,0,0,0,,Бұл айналымды жеңу ықтималдығы артады, бірақ...
Dialogue: 0,0:18:03.28,0:18:05.78,Default,,0,0,0,,Не? Бұл сезім...)
Dialogue: 0,0:18:09.72,0:18:12.19,Default,,0,0,0,,Жарайды...Дживаның шеберлігін белсендіру➡
Dialogue: 0,0:18:12.19,0:18:14.26,Default,,0,0,0,,Trixta➡-қа түсіріңіз
Dialogue: 0,0:18:14.26,0:18:17.22,Default,,0,0,0,,Кальмодагты шақырыңыз, жанып тұрған көктегі айдаһар!
Dialogue: 0,0:18:20.23,0:18:23.20,Default,,0,0,0,,Миразверлинаға арналған кроссовер көйлек!
Dialogue: 0,0:18:24.23,0:18:26.20,Default,,0,0,0,,Түпнұсқа Кармодаг➡ шеберлігіне байланысты
Dialogue: 0,0:18:26.20,0:18:28.70,Default,,0,0,0,,Қарсыластың авангардының 1-сыныбына➡
Dialogue: 0,0:18:28.70,0:18:31.21,Default,,0,0,0,,Қуат плюс 2000!
Dialogue: 0,0:18:31.21,0:18:34.21,Default,,0,0,0,,Не! Valtex 11-сынып, сондықтан ➡
Dialogue: 0,0:18:34.21,0:18:36.24,Default,,0,0,0,,22 000 плюс! ➡
Dialogue: 0,0:18:36.24,0:18:40.21,Default,,0,0,0,,Валтекстің 28 000 қуатынан әлдеқайда асып түседі!
Dialogue: 0,0:18:41.22,0:18:43.28,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:43.28,0:18:46.22,Default,,0,0,0,,Миразверлинамен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:46.22,0:18:48.19,Default,,0,0,0,,Шеберлікпен 1 ​​картаны сал.
Dialogue: 0,0:18:50.26,0:18:53.23,Default,,0,0,0,,Найзағай тосқауылы, төтенше жағдайды орналастыру! Ойна!
Dialogue: 0,0:18:54.73,0:18:57.20,Default,,0,0,0,,Valtex қуаты плюс 30 000!
Dialogue: 0,0:18:58.20,0:19:00.77,Default,,0,0,0,,Күзет сәтті өтті! ➡
Dialogue: 0,0:19:00.77,0:19:06.74,Default,,0,0,0,,Миразверлинаның жан-жақты шабуылына Блант Гейттің техникалық күші тосқауыл болды!
Dialogue: 0,0:19:06.74,0:19:09.71,Default,,0,0,0,,Блиц тәртібі? Толық қорғаныс шаралары➡
Dialogue: 0,0:19:09.71,0:19:12.18,Default,,0,0,0,,Мүмкіндік жоқ.
Dialogue: 0,0:19:13.21,0:19:16.22,Default,,0,0,0,,Бұл жақсы шабуыл болды, бірақ күткен еді.
Dialogue: 0,0:19:18.19,0:19:21.19,Default,,0,0,0,,Әлі жоқ! Нирвана Дживада➡
Dialogue: 0,0:19:21.19,0:19:23.69,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:23.69,0:19:25.73,Default,,0,0,0,,Миразверлинаны шеберлікпен тұр!
Dialogue: 0,0:19:25.73,0:19:29.20,Default,,0,0,0,,Күзетші. Бірінші тексеру➡
Dialogue: 0,0:19:29.20,0:19:32.20,Default,,0,0,0,,Триггер жоқ…Екінші тексеру➡
Dialogue: 0,0:19:32.20,0:19:34.24,Default,,0,0,0,,Триггерді тартыңыз!
Dialogue: 0,0:19:34.24,0:19:37.74,Default,,0,0,0,,1 картаны сал, Брам Верлинаның күші +10000!
Dialogue: 0,0:19:41.71,0:19:44.21,Default,,0,0,0,,Брамверлинада➡
Dialogue: 0,0:19:44.21,0:19:46.18,Default,,0,0,0,,Шабуыл~!
Dialogue: 0,0:19:47.72,0:19:49.68,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:19:51.22,0:19:53.22,Default,,0,0,0,,Миразверлинада➡
Dialogue: 0,0:19:53.22,0:19:55.19,Default,,0,0,0,,Шабуыл~!
Dialogue: 0,0:19:56.19,0:19:58.19,Default,,0,0,0,,１
Dialogue: 0,0:20:02.23,0:20:04.20,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:20:05.73,0:20:07.70,Default,,0,0,0,,Бұрылу...аяқтау.
Dialogue: 0,0:20:08.70,0:20:10.70,Default,,0,0,0,,Бұл сізге жетпейді.
Dialogue: 0,0:20:31.73,0:20:35.70,Default,,0,0,0,,Келесі бұрылыс Триггердің үстіндегі доғал қақпа...
Dialogue: 0,0:20:35.70,0:20:38.73,Default,,0,0,0,,Мүмкін Эльдобрейт➡
Dialogue: 0,0:20:38.73,0:20:42.74,Default,,0,0,0,,Алдыңғы қатардағы барлық бөлімшелерде қос қуат және сыни соққылар бар.
Dialogue: 0,0:20:47.21,0:20:49.21,Default,,0,0,0,,Юйю-сан….
Dialogue: 0,0:20:52.71,0:20:54.72,Default,,0,0,0,,Юю….
Dialogue: 0,0:20:56.72,0:20:59.22,Default,,0,0,0,,Мен міндетті түрде орындаймын➡
Dialogue: 0,0:20:59.22,0:21:02.22,Default,,0,0,0,,Соңғы шайқасқа қол жеткізіңіз.
Dialogue: 0,0:21:03.29,0:21:06.69,Default,,0,0,0,,Және оны барлық жауынгерлерге тарат.
Dialogue: 0,0:21:06.69,0:21:09.73,Default,,0,0,0,,Сонда бәрі бақытты болады.
Dialogue: 0,0:21:09.73,0:21:13.23,Default,,0,0,0,,Бақытты бол... Иә➡
Dialogue: 0,0:21:13.23,0:21:16.20,Default,,0,0,0,,Мен барлығын бақытты еткім келеді!
Dialogue: 0,0:21:16.20,0:21:19.17,Default,,0,0,0,,Юю Кондо Әрине сен де.
Dialogue: 0,0:21:20.71,0:21:23.18,Default,,0,0,0,,Барлығын бақытты ет...
Dialogue: 0,0:21:25.21,0:21:27.21,Default,,0,0,0,,Сосын мен де➡
Dialogue: 0,0:21:27.21,0:21:29.72,Default,,0,0,0,,Мен сол бақытпен ынтымақтасқым келеді!
Dialogue: 0,0:21:29.72,0:21:31.72,Default,,0,0,0,,Не...! Е~?
Dialogue: 0,0:21:31.72,0:21:33.69,Default,,0,0,0,,Аа...
Dialogue: 0,0:21:34.69,0:21:37.19,Default,,0,0,0,,Сіз түсіндіңіз бе? Un➡
Dialogue: 0,0:21:37.19,0:21:39.19,Default,,0,0,0,,Мен сізді түсінгім келеді.
Dialogue: 0,0:21:39.19,0:21:41.20,Default,,0,0,0,,Ал сізге➡
Dialogue: 0,0:21:41.20,0:21:44.20,Default,,0,0,0,,Мені түсінгеніңізді қалаймын.
Dialogue: 0,0:21:53.71,0:21:56.21,Default,,0,0,0,,Сондықтан мен сенімен біргемін➡
Dialogue: 0,0:21:56.21,0:21:58.21,Default,,0,0,0,,Сізге қарсы жеңіңіз!
