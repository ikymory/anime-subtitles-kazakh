Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.70,0:00:06.20,Default,,0,0,0,,Эй...эй! Vanguard➡ болашағын шешу
Dialogue: 0,0:00:06.20,0:00:09.71,Default,,0,0,0,,Тау етегіндегі шешуші шайқас.
Dialogue: 0,0:00:09.71,0:00:12.21,Default,,0,0,0,,Ағымдағы ұпай 1:1➡
Dialogue: 0,0:00:12.21,0:00:15.21,Default,,0,0,0,,Барлығы келесі шайқасқа байланысты!
Dialogue: 0,0:00:27.22,0:00:29.22,Default,,0,0,0,,Әлемдегі барлық Vanguard жанкүйерлері трансляцияны көреді! ➡
Dialogue: 0,0:00:29.22,0:00:31.73,Default,,0,0,0,,Тағдырлы сәтті жіберіп алмаңыз!
Dialogue: 0,0:00:33.23,0:00:37.23,Default,,0,0,0,,Сонымен...! Үшінші матчтың ойыншыларымен таныстыру➡
Dialogue: 0,0:00:37.23,0:00:40.74,Default,,0,0,0,,18 жасқа дейінгі Авангард Чемпионатының жеке турнирінің жеңімпазы! ➡
Dialogue: 0,0:00:40.74,0:00:43.24,Default,,0,0,0,,Және Deluxe екінші орыны! ➡
Dialogue: 0,0:00:43.24,0:00:47.24,Default,,0,0,0,,Мен өте құрметтейтін Мичиру Кайманың ойларын мұраға алып, мен жеңемін! ➡
Dialogue: 0,0:00:47.24,0:00:50.75,Default,,0,0,0,,Қорқынышты дворян, Райка Китсунешиба!
Dialogue: 0,0:00:52.25,0:00:54.75,Default,,0,0,0,,Авангардқа қарсы ғана емес ➡
Dialogue: 0,0:00:54.75,0:00:57.75,Default,,0,0,0,,Түрлі жарыстарда керемет рекорд қалдырыңыз➡
Dialogue: 0,0:00:57.75,0:01:01.19,Default,,0,0,0,,Құдіретті данышпан жұлдызды теңдеумен басқарылады➡
Dialogue: 0,0:01:01.19,0:01:04.19,Default,,0,0,0,,Оның бет-әлпетіне бәрі баурап алады➡
Dialogue: 0,0:01:04.19,0:01:08.70,Default,,0,0,0,,Жұлдызды аспанның сиқыршысы Софи Белл!
Dialogue: 0,0:01:08.70,0:01:11.20,Default,,0,0,0,,1 жеңіс, 1 жеңіліс...
Dialogue: 0,0:01:11.20,0:01:15.70,Default,,0,0,0,,Біздің рекордымыз қазіргі ұпайымызбен бірдей.
Dialogue: 0,0:01:16.71,0:01:18.71,Default,,0,0,0,,Не айтпақшысың?
Dialogue: 0,0:01:18.71,0:01:21.71,Default,,0,0,0,,Бұл үлкен жауапкершілік. Егер сіз жоғалтсаңыз ➡
Dialogue: 0,0:01:21.71,0:01:25.71,Default,,0,0,0,,Бұл Авангардтың болашағын құртатын жағдай, солай емес пе?
Dialogue: 0,0:01:25.71,0:01:27.72,Default,,0,0,0,,Қорқынышты ма? Сіз жылайсыз ба?
Dialogue: 0,0:01:27.72,0:01:30.22,Default,,0,0,0,,Басыңызды шайқауды тоқтатыңыз➡
Dialogue: 0,0:01:30.22,0:01:32.22,Default,,0,0,0,,Мен міндетті түрде жеңемін.
Dialogue: 0,0:01:32.22,0:01:35.22,Default,,0,0,0,,А... аа!
Dialogue: 0,0:01:35.22,0:01:37.23,Default,,0,0,0,,Уфуфуфу…!
Dialogue: 0,0:01:39.23,0:01:41.73,Default,,0,0,0,,Біз көп көңіл көтереміз бе? Ит.
Dialogue: 0,0:01:41.73,0:01:43.73,Default,,0,0,0,,Бұл ойын емес...бұл төбелес!
Dialogue: 0,0:01:43.73,0:01:45.73,Default,,0,0,0,,Эй….
Dialogue: 0,0:01:45.73,0:01:48.24,Default,,0,0,0,,Келіңіздер! Сонымен, үшінші матчқа...
Dialogue: 0,0:01:50.74,0:01:53.24,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:01:55.24,0:01:57.25,Default,,0,0,0,,Тұрақты Авангард.
Dialogue: 0,0:03:32.51,0:03:34.51,Default,,0,0,0,,Артымнан қуып келе жатқан жастар.
Dialogue: 0,0:03:34.51,0:03:36.51,Default,,0,0,0,,Almajesta Pipis Murche.
Dialogue: 0,0:03:36.51,0:03:39.51,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:03:39.51,0:03:42.52,Default,,0,0,0,,Ride Youth ойынын іске қосу және бұрылысты аяқтау.
Dialogue: 0,0:03:42.52,0:03:44.52,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:03:44.52,0:03:48.12,Default,,0,0,0,,Sureto Ride Spada шеберлігімен 1 картаны салыңыз➡
Dialogue: 0,0:03:48.12,0:03:50.13,Default,,0,0,0,,Суретпен шабуыл.
Dialogue: 0,0:03:50.13,0:03:52.13,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:03:52.13,0:03:54.13,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:03:54.13,0:03:56.63,Default,,0,0,0,,((Мен Мичиру-санға ант бердім➡
Dialogue: 0,0:03:56.63,0:03:58.63,Default,,0,0,0,,Арнайы дайындықты есте сақтаңыз➡
Dialogue: 0,0:03:58.63,0:04:01.64,Default,,0,0,0,,Соғыс жағдайын байсалды түрде талдаңыз➡
Dialogue: 0,0:04:01.64,0:04:03.64,Default,,0,0,0,,Және жең! ))
Dialogue: 0,0:04:03.64,0:04:05.64,Default,,0,0,0,,Менің жеребе кезегім!
Dialogue: 0,0:04:05.64,0:04:07.64,Default,,0,0,0,,Жарық серігі жастарға➡
Dialogue: 0,0:04:07.64,0:04:12.15,Default,,0,0,0,,Палубаның жоғарғы үш картасын көру үшін шеберлікті пайдаланыңыз және Юсбергті қолыңызға қосыңыз➡
Dialogue: 0,0:04:12.15,0:04:14.15,Default,,0,0,0,,Жастармен шабуыл.
Dialogue: 0,0:04:14.15,0:04:16.15,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:04:16.15,0:04:18.15,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:04:18.15,0:04:20.16,Default,,0,0,0,,Тұран Динаға міну➡
Dialogue: 0,0:04:20.16,0:04:23.16,Default,,0,0,0,,Сурет шеберлігімен 2 карта жан заряды➡
Dialogue: 0,0:04:23.16,0:04:25.66,Default,,0,0,0,,1 картаны тарту Айрамға қоңырау шалыңыз➡
Dialogue: 0,0:04:25.66,0:04:27.66,Default,,0,0,0,,Тұранмен шабуыл➡
Dialogue: 0,0:04:27.66,0:04:31.60,Default,,0,0,0,,Ирамның шеберлігімен триггерді жанға салыңыз.
Dialogue: 0,0:04:31.60,0:04:33.60,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:04:33.60,0:04:35.60,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:04:35.60,0:04:38.61,Default,,0,0,0,,Сіз әрқашан көп жұмыс жасайсыз және кереметсіз➡
Dialogue: 0,0:04:38.61,0:04:40.61,Default,,0,0,0,,Мен де сенен үйренуім керек.
Dialogue: 0,0:04:40.61,0:04:42.61,Default,,0,0,0,,Мен ешқашан күтпеген нәрсе.
Dialogue: 0,0:04:42.61,0:04:44.61,Default,,0,0,0,,Сізде де жеңіске құштарлық бар➡
Dialogue: 0,0:04:44.61,0:04:46.62,Default,,0,0,0,,Жеңілуден қорықпаңыз➡
Dialogue: 0,0:04:46.62,0:04:51.09,Default,,0,0,0,,Мені униформашылардың болашағы былай қойғанда, Авангардтың тағдыры қызықтырмайды.
Dialogue: 0,0:04:53.12,0:04:56.12,Default,,0,0,0,,Фу…. Бұл маңызды емес, солай ма?
Dialogue: 0,0:04:56.12,0:04:59.13,Default,,0,0,0,,Барлығы! Уху...
Dialogue: 0,0:04:59.13,0:05:01.10,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:05:02.13,0:05:04.13,Default,,0,0,0,,Аспанды түсіретін уақыт келді➡
Dialogue: 0,0:05:04.13,0:05:07.14,Default,,0,0,0,,Юсбергтен Скайфолл Армсқа дейін➡
Dialogue: 0,0:05:07.14,0:05:09.14,Default,,0,0,0,,Жүр!
Dialogue: 0,0:05:09.14,0:05:13.64,Default,,0,0,0,,Юсбергтің шеберлігі Палубаның жоғарғы үш картасын қараңыз➡
Dialogue: 0,0:05:13.64,0:05:15.64,Default,,0,0,0,,Қолыңызға Zest қосыңыз➡
Dialogue: 0,0:05:15.64,0:05:18.15,Default,,0,0,0,,Фельготаны шақырыңыз, жойылу сиқыршысы➡
Dialogue: 0,0:05:18.15,0:05:22.65,Default,,0,0,0,,Густты палубадан жанға жіберу үшін шеберлікті пайдаланыңыз.
Dialogue: 0,0:05:22.65,0:05:25.65,Default,,0,0,0,,Әртүрлі түстер бірінен соң бірі.
Dialogue: 0,0:05:25.65,0:05:27.66,Default,,0,0,0,,Фриде➡ қоңырау шалыңыз
Dialogue: 0,0:05:27.66,0:05:29.66,Default,,0,0,0,,Жастбергпен шабуыл.
Dialogue: 0,0:05:29.66,0:05:32.09,Default,,0,0,0,,Күзетші. Дискіні➡ тексеріңіз
Dialogue: 0,0:05:32.09,0:05:34.60,Default,,0,0,0,,1➡ жетек
Dialogue: 0,0:05:34.60,0:05:36.60,Default,,0,0,0,,2-жүргізуші➡
Dialogue: 0,0:05:36.60,0:05:38.60,Default,,0,0,0,,Критикалық триггер➡
Dialogue: 0,0:05:38.60,0:05:41.57,Default,,0,0,0,,Фрид қуаты плюс 10000 критикалық плюс 1.
Dialogue: 0,0:05:43.61,0:05:46.61,Default,,0,0,0,,Бүгін мен сол алдаудың бетпердесін жұлып аламын.
Dialogue: 0,0:05:46.61,0:05:48.61,Default,,0,0,0,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:05:48.61,0:05:51.11,Default,,0,0,0,,Құла...қалаған жерге!
Dialogue: 0,0:05:51.11,0:05:53.11,Default,,0,0,0,,Револ➡
Dialogue: 0,0:05:53.11,0:05:55.08,Default,,0,0,0,,Киім!
Dialogue: 0,0:06:08.13,0:06:11.10,Default,,0,0,0,,Youthberg Revolform Tempest!
Dialogue: 0,0:06:12.63,0:06:14.64,Default,,0,0,0,,Дағды алдыңғы қатарға 5000 қуат қосады➡
Dialogue: 0,0:06:14.64,0:06:17.64,Default,,0,0,0,,Палубаның жоғарғы екі картасын ашыңыз➡
Dialogue: 0,0:06:17.64,0:06:20.64,Default,,0,0,0,,Айрамды палубаның төменгі жағына қойыңыз➡
Dialogue: 0,0:06:20.64,0:06:24.15,Default,,0,0,0,,Фельгосаның шеберлік күші +5000➡
Dialogue: 0,0:06:24.15,0:06:26.15,Default,,0,0,0,,Темпестпен шабуыл.
Dialogue: 0,0:06:26.15,0:06:28.65,Default,,0,0,0,,Күзетші жоқ. Фридемен шабуыл.
Dialogue: 0,0:06:28.65,0:06:30.59,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:06:30.59,0:06:32.59,Default,,0,0,0,,Фельгосамен шабуыл.
Dialogue: 0,0:06:32.59,0:06:34.59,Default,,0,0,0,,Күзет. Бұрылыс соңында➡
Dialogue: 0,0:06:34.59,0:06:36.56,Default,,0,0,0,,Сеулдегі Скайфолл Армсқа бару.
Dialogue: 0,0:06:38.09,0:06:40.60,Default,,0,0,0,,Зақым 3➡
Dialogue: 0,0:06:40.60,0:06:43.10,Default,,0,0,0,,Мен өте көп алдым.
Dialogue: 0,0:06:43.10,0:06:45.60,Default,,0,0,0,,Өзіңізді біршама байсалдырақ сезінесіз бе?
Dialogue: 0,0:06:45.60,0:06:49.10,Default,,0,0,0,,Ал, қорқынышты! Мен әрқашан байсалды болдым.
Dialogue: 0,0:06:49.10,0:06:51.11,Default,,0,0,0,,Ку...! Уууу.
Dialogue: 0,0:06:51.11,0:06:53.61,Default,,0,0,0,,((А...
Dialogue: 0,0:06:53.61,0:06:55.58,Default,,0,0,0,,Мен шөлдедім... ))
Dialogue: 0,0:07:00.62,0:07:03.12,Default,,0,0,0,,((Сізге жұлдыздар ұнайды ма?
Dialogue: 0,0:07:03.12,0:07:05.12,Default,,0,0,0,,A...?
Dialogue: 0,0:07:05.12,0:07:07.59,Default,,0,0,0,,Әмбебап данышпан Софи Белл.
Dialogue: 0,0:07:10.13,0:07:12.63,Default,,0,0,0,,Қол қоюдан бас тарта аласыз ба?
Dialogue: 0,0:07:12.63,0:07:15.13,Default,,0,0,0,,Мен дәл қазір ондай сезінбеймін.
Dialogue: 0,0:07:15.13,0:07:17.13,Default,,0,0,0,,Жақсы, жақсы!
Dialogue: 0,0:07:17.13,0:07:19.10,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:07:21.64,0:07:25.11,Default,,0,0,0,,Мүмкін мен сенің шөліңді қандырармын. ))
Dialogue: 0,0:07:27.14,0:07:30.11,Default,,0,0,0,,((соңында шөлімді қандыра алмадым➡
Dialogue: 0,0:07:30.11,0:07:33.08,Default,,0,0,0,,Маған ешкім жете алмайды➡
Dialogue: 0,0:07:33.08,0:07:35.05,Default,,0,0,0,,Менің әлемімді төңкеру үшін... ))
Dialogue: 0,0:07:40.09,0:07:43.09,Default,,0,0,0,,Уууу... менің кезегім➡
Dialogue: 0,0:07:43.09,0:07:46.09,Default,,0,0,0,,Көптеген жарқыраған жұлдыздар➡
Dialogue: 0,0:07:46.09,0:07:48.60,Default,,0,0,0,,Маған күш бер.
Dialogue: 0,0:07:48.60,0:07:51.60,Default,,0,0,0,,Almajesta Astroa Unica көлігімен жүріңіз.
Dialogue: 0,0:07:51.60,0:07:54.10,Default,,0,0,0,,Тұран мен Шуатты шеберлікпен шақырыңыз➡
Dialogue: 0,0:07:54.10,0:07:58.07,Default,,0,0,0,,Гидраглум шеберлігінің тамшы маскасы іске қосылды.
Dialogue: 0,0:08:02.61,0:08:05.11,Default,,0,0,0,,)
Dialogue: 0,0:08:05.11,0:08:08.12,Default,,0,0,0,,Жұлдыздар, аспан мен жер, тағдыр!
Dialogue: 0,0:08:08.12,0:08:11.09,Default,,0,0,0,,Бетперде кию оны жабады!
Dialogue: 0,0:08:16.62,0:08:21.13,Default,,0,0,0,,Xenoar Majesta Persona Astroa Bicon Mascus көлігінде жүр!
Dialogue: 0,0:08:21.13,0:08:23.13,Default,,0,0,0,,Ой...!
Dialogue: 0,0:08:23.13,0:08:25.63,Default,,0,0,0,,Опера жұлдызының фонографына қоңырау шалыңыз➡
Dialogue: 0,0:08:25.63,0:08:27.64,Default,,0,0,0,,Шеберлікпен 1 картаны салыңыз➡
Dialogue: 0,0:08:27.64,0:08:31.14,Default,,0,0,0,,Гунгунурам шақыру дағдысы бар 1 картаны салыңыз➡
Dialogue: 0,0:08:31.14,0:08:33.64,Default,,0,0,0,,Twinmarval➡ қоңырау шалыңыз
Dialogue: 0,0:08:33.64,0:08:37.15,Default,,0,0,0,,Тұран шеберлігінің 2 триггерін жанға салыңыз➡
Dialogue: 0,0:08:37.15,0:08:39.65,Default,,0,0,0,,Қуат плюс 5000.
Dialogue: 0,0:08:39.65,0:08:43.65,Default,,0,0,0,,Суреттің шеберлігі Жанның сыни триггерін байлау➡
Dialogue: 0,0:08:43.65,0:08:45.65,Default,,0,0,0,,Қуат плюс 10000➡
Dialogue: 0,0:08:45.65,0:08:49.16,Default,,0,0,0,,Astro Masks Skill Retreating Friede➡
Dialogue: 0,0:08:49.16,0:08:51.13,Default,,0,0,0,,Drive Plus 1.
Dialogue: 0,0:08:53.16,0:08:56.16,Default,,0,0,0,,Сабыр ет, ит.
Dialogue: 0,0:08:56.16,0:08:59.67,Default,,0,0,0,,Егер ол бірден бұзылса, сізге ұнамайды, солай ма?
Dialogue: 0,0:08:59.67,0:09:01.67,Default,,0,0,0,,Бұл өтірік болғандықтан ба?>
