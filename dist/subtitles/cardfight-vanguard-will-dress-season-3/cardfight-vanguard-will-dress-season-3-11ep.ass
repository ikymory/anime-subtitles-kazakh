Dialogue: 0,0:16:29.62,0:16:31.59,Default,,0,0,0,,E?
Dialogue: 0,0:16:35.62,0:16:39.63,Default,,0,0,0,,Қызық, сіз қандай жауынгерді айтып тұрсыз?
Dialogue: 0,0:16:39.63,0:16:41.63,Default,,0,0,0,,Алдыңыздағы адамға қара➡
Dialogue: 0,0:16:41.63,0:16:43.63,Default,,0,0,0,,Авангардқа бет бұрыңыз➡
Dialogue: 0,0:16:43.63,0:16:45.60,Default,,0,0,0,,Байыпты күресетін адам.
Dialogue: 0,0:16:46.63,0:16:48.64,Default,,0,0,0,,Яғни➡
Dialogue: 0,0:16:48.64,0:16:50.64,Default,,0,0,0,,Бұл жауынгер.
Dialogue: 0,0:16:50.64,0:16:52.61,Default,,0,0,0,,Бұл... жауынгер.
Dialogue: 0,0:16:57.14,0:16:59.15,Default,,0,0,0,,((екінші жағындағы зиян 4➡
Dialogue: 0,0:16:59.15,0:17:01.15,Default,,0,0,0,,Қолында 8 карта бар рок қатты➡
Dialogue: 0,0:17:01.15,0:17:03.65,Default,,0,0,0,,Екінші жағынан, менде нөлдік карталар бар➡
Dialogue: 0,0:17:03.65,0:17:06.65,Default,,0,0,0,,Тақта да жойқын ➡
Dialogue: 0,0:17:06.65,0:17:08.66,Default,,0,0,0,,Бірақ бәрібір... ))
Dialogue: 0,0:17:08.66,0:17:10.66,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:17:10.66,0:17:12.66,Default,,0,0,0,,Youthberg дағдылары➡
Dialogue: 0,0:17:12.66,0:17:14.66,Default,,0,0,0,,Палубаның жоғарғы үш картасын қараңыз...
Dialogue: 0,0:17:14.66,0:17:16.66,Default,,0,0,0,,Ах! орталық….
Dialogue: 0,0:17:16.66,0:17:18.67,Default,,0,0,0,,Қолыңызға Ghast қосыңыз.
Dialogue: 0,0:17:18.67,0:17:21.67,Default,,0,0,0,,Мен Густты жаңа ғана тартып алсам да...
Dialogue: 0,0:17:21.67,0:17:23.67,Default,,0,0,0,,Густқа қоңырау шалыңыз.
Dialogue: 0,0:17:23.67,0:17:26.17,Default,,0,0,0,,Сіз оны Revoldress-те қалдырмайсыз, солай ма?
Dialogue: 0,0:17:26.17,0:17:28.14,Default,,0,0,0,,Фу….
Dialogue: 0,0:17:29.18,0:17:31.18,Default,,0,0,0,,Youthberg-те➡
Dialogue: 0,0:17:31.18,0:17:33.18,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:17:33.18,0:17:35.18,Default,,0,0,0,,Күзетшілерді ұстау.
Dialogue: 0,0:17:35.18,0:17:39.19,Default,,0,0,0,,Дұрыс айтасыз...Жылдар шайқас толқынын өзгерте алмайды.
Dialogue: 0,0:17:39.19,0:17:42.19,Default,,0,0,0,,Бірақ бұл ең жақсы нәтиже.
Dialogue: 0,0:17:42.19,0:17:44.19,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:17:44.19,0:17:47.70,Default,,0,0,0,,Мен шабуылдап қана қоймай, қараған үшеуінің арасынан ол картаны көрмедім.
Dialogue: 0,0:17:47.70,0:17:49.70,Default,,0,0,0,,Бұл карта?
Dialogue: 0,0:17:49.70,0:17:51.70,Default,,0,0,0,,Бұл жағдайды өзгерту үшін жасалған қозғалыс.
Dialogue: 0,0:17:51.70,0:17:54.20,Default,,0,0,0,,Барлығы әлі палубада.
Dialogue: 0,0:17:54.20,0:17:56.20,Default,,0,0,0,,Мұнда сурет салу мүмкіндігі жоғары.
Dialogue: 0,0:17:56.20,0:17:58.21,Default,,0,0,0,,Фу….
Dialogue: 0,0:17:58.21,0:18:00.64,Default,,0,0,0,,Дискіні тексеріңіз! 1➡ жүргізу
Dialogue: 0,0:18:00.64,0:18:02.64,Default,,0,0,0,,Триггер жоқ➡
Dialogue: 0,0:18:02.64,0:18:04.65,Default,,0,0,0,,2-диск….
Dialogue: 0,0:18:04.65,0:18:06.65,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:18:06.65,0:18:09.12,Default,,0,0,0,,Ютбергтің жаңа түрі?
Dialogue: 0,0:18:11.15,0:18:13.15,Default,,0,0,0,,Мен менмін➡
Dialogue: 0,0:18:13.15,0:18:15.12,Default,,0,0,0,,Мәңгілік асуды жалғастырыңыз.
Dialogue: 0,0:18:16.66,0:18:18.66,Default,,0,0,0,,Аспан➡
Dialogue: 0,0:18:18.66,0:18:20.66,Default,,0,0,0,,Жұлдыздар➡
Dialogue: 0,0:18:20.66,0:18:22.66,Default,,0,0,0,,Ату уақыты келді!
Dialogue: 0,0:18:22.66,0:18:24.63,Default,,0,0,0,,Револресс!
Dialogue: 0,0:18:29.17,0:18:31.14,Default,,0,0,0,,Юсберг….
Dialogue: 0,0:18:35.18,0:18:37.18,Default,,0,0,0,,Айналмалы пішін➡
Dialogue: 0,0:18:37.18,0:18:39.18,Default,,0,0,0,,Толық жарылыс!
Dialogue: 0,0:18:39.18,0:18:42.18,Default,,0,0,0,,Толық жарылыс дағдысын белсендіру➡
Dialogue: 0,0:18:42.18,0:18:45.69,Default,,0,0,0,,Соулда Зест, Екпінді және Дауылдың болуына байланысты➡
Dialogue: 0,0:18:45.69,0:18:48.69,Default,,0,0,0,,Максималды шығысты жеткізіңіз.
Dialogue: 0,0:18:48.69,0:18:51.69,Default,,0,0,0,,Жеке Critical Plus 1 Drive Plus 1➡
Dialogue: 0,0:18:51.69,0:18:54.70,Default,,0,0,0,,Қарсыласыңыздың артқы қорғаушыларының бірін палубаның төменгі жағына қойыңыз.
Dialogue: 0,0:18:54.70,0:18:58.67,Default,,0,0,0,,Сонымен қатар, алдыңғы қатардағы барлық блоктардың қуаты +15 000.
Dialogue: 0,0:19:01.64,0:19:04.61,Default,,0,0,0,,Осы мақсатта Жанға әртүрлі түстерді жинаңыз...
Dialogue: 0,0:19:06.14,0:19:10.14,Default,,0,0,0,,Мен бұл соққыға бар жан-тәнімді саламын!
Dialogue: 0,0:19:10.14,0:19:12.15,Default,,0,0,0,,Жақсы➡
Dialogue: 0,0:19:12.15,0:19:14.12,Default,,0,0,0,,Кел!
Dialogue: 0,0:19:17.15,0:19:19.65,Default,,0,0,0,,Толық жарылыс➡
Dialogue: 0,0:19:19.65,0:19:21.62,Default,,0,0,0,,Авангардқа….
Dialogue: 0,0:19:23.66,0:19:25.63,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:19:28.16,0:19:30.13,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:19:33.17,0:19:35.17,Default,,0,0,0,,((мен түсінемін➡
Dialogue: 0,0:19:35.17,0:19:37.17,Default,,0,0,0,,Мен бұл дүмпуді бірінші рет сезініп тұрмын➡
Dialogue: 0,0:19:37.17,0:19:40.17,Default,,0,0,0,,Бұл салқындық➡
Dialogue: 0,0:19:40.17,0:19:42.18,Default,,0,0,0,,Жеңілуден қорқу! ))
Dialogue: 0,0:19:42.18,0:19:44.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:45.68,0:19:47.68,Default,,0,0,0,,Дискіні тексеріңіз! ➡
Dialogue: 0,0:19:47.68,0:19:49.68,Default,,0,0,0,,Draw Trigger алыңыз!
Dialogue: 0,0:19:49.68,0:19:51.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:51.69,0:19:53.65,Default,,0,0,0,,Толық жарылыс қуаты плюс 10 000!
Dialogue: 0,0:19:56.19,0:19:58.16,Default,,0,0,0,,Зақымдануды тексеру….
Dialogue: 0,0:20:05.13,0:20:07.10,Default,,0,0,0,,U….
Dialogue: 0,0:20:09.14,0:20:11.14,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:20:11.14,0:20:13.11,Default,,0,0,0,,Жоқ…триггер.
Dialogue: 0,0:20:18.15,0:20:20.11,Default,,0,0,0,,Хаа….
Dialogue: 0,0:20:24.15,0:20:26.65,Default,,0,0,0,,Жеңімпаз….
Dialogue: 0,0:20:26.65,0:20:29.12,Default,,0,0,0,,Түлкі Шиба Лейка!
Dialogue: 0,0:20:32.66,0:20:34.66,Default,,0,0,0,,Жоғалған.
Dialogue: 0,0:20:34.66,0:20:37.16,Default,,0,0,0,,Сіз күрескерсіз➡
Dialogue: 0,0:20:37.16,0:20:39.13,Default,,0,0,0,,Бұл өте күшті болды.
Dialogue: 0,0:20:42.67,0:20:45.14,Default,,0,0,0,,Шайқас...Көп рахмет.
Dialogue: 0,0:20:48.18,0:20:50.14,Default,,0,0,0,,Хмм….
Dialogue: 0,0:21:02.12,0:21:04.13,Default,,0,0,0,,((Кішкене көбірек➡
Dialogue: 0,0:21:04.13,0:21:07.13,Default,,0,0,0,,Мен Vanguard ойнауды жалғастырамын деп ойлаймын. ))
Dialogue: 0,0:21:07.13,0:21:09.10,Default,,0,0,0,,Фу….
Dialogue: 0,0:21:10.63,0:21:13.13,Default,,0,0,0,,2 таудың етегіндегі шешуші шайқас 1-ге қарсы➡
Dialogue: 0,0:21:13.13,0:21:16.14,Default,,0,0,0,,Жаңа буын командасы жеңеді! ➡
Dialogue: 0,0:21:16.14,0:21:19.14,Default,,0,0,0,,Енді сіз жігітке қарсы шығуға құқығыңыз бар!
Dialogue: 0,0:21:19.14,0:21:21.11,Default,,0,0,0,,Лейка!
Dialogue: 0,0:21:22.14,0:21:24.11,Default,,0,0,0,,Лейка мырза.
Dialogue: 0,0:21:25.65,0:21:27.62,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:21:34.16,0:21:37.16,Default,,0,0,0,,Ой gii! Келесі кезек сізде➡
Dialogue: 0,0:21:37.16,0:21:39.13,Default,,0,0,0,,Қашпа!
Dialogue: 0,0:21:40.16,0:21:42.16,Default,,0,0,0,,Мен мұны істемеймін.
Dialogue: 0,0:21:42.16,0:21:44.67,Default,,0,0,0,,Өйткені мен мінсізмін.
Dialogue: 0,0:21:44.67,0:21:47.64,Default,,0,0,0,,Сонымен... менің қарсыласым кім?
Dialogue: 0,0:21:49.17,0:21:51.64,Default,,0,0,0,,Юйю Кондо. Юю мырза.
Dialogue: 0,0:21:53.67,0:21:55.68,Default,,0,0,0,,Жоғары➡
Dialogue: 0,0:21:55.68,0:21:57.65,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:21:59.15,0:22:05.15,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory