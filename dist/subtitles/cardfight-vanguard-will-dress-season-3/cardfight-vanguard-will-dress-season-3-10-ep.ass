Dialogue: 0,0:16:16.04,0:16:18.04,Default,,0,0,0,,Триггерді салу➡
Dialogue: 0,0:16:18.04,0:16:21.54,Default,,0,0,0,,1 картаны салыңыз Amanagurgio Mascus қуаты +10000➡
Dialogue: 0,0:16:21.54,0:16:23.54,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:16:23.54,0:16:25.55,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:16:25.55,0:16:27.55,Default,,0,0,0,,Зақымдануды тексеру.
Dialogue: 0,0:16:27.55,0:16:29.55,Default,,0,0,0,,♬～
Dialogue: 0,0:16:29.55,0:16:32.05,Default,,0,0,0,,)
Dialogue: 0,0:16:32.05,0:16:34.06,Default,,0,0,0,,Триггерді салу➡
Dialogue: 0,0:16:34.06,0:16:36.06,Default,,0,0,0,,♬~ Ха!
Dialogue: 0,0:16:36.06,0:16:39.56,Default,,0,0,0,,Тітіркендіргішті тартсаң да қуат көбеймейді... басқаша!
Dialogue: 0,0:16:39.56,0:16:41.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:43.56,0:16:46.07,Default,,0,0,0,,Әлі жоқ! Жоқ емес пе?
Dialogue: 0,0:16:46.07,0:16:48.04,Default,,0,0,0,,1 картаны сал!
Dialogue: 0,0:16:54.08,0:16:57.08,Default,,0,0,0,,Мен оны дұрыс естідім!
Dialogue: 0,0:16:57.08,0:17:01.08,Default,,0,0,0,,Уф... Аманагурджио Маскус шеберлікпен тұр!
Dialogue: 0,0:17:01.08,0:17:03.08,Default,,0,0,0,,Жүргізіңіз минус 1!
Dialogue: 0,0:17:03.08,0:17:05.59,Default,,0,0,0,,Аманагургио Маскуспен тағы бір рет шабуыл жасаңыз!
Dialogue: 0,0:17:05.59,0:17:07.56,Default,,0,0,0,,Күзет және тосқауыл қой!
Dialogue: 0,0:17:09.59,0:17:12.59,Default,,0,0,0,,Уау! Көлікті тексеру➡
Dialogue: 0,0:17:12.59,0:17:16.60,Default,,0,0,0,,Алдыңғы триггер! Алдыңғы қатардағы қуат плюс 10 000!
Dialogue: 0,0:17:16.60,0:17:19.60,Default,,0,0,0,,Қасірет қанатымен шабуыл!
Dialogue: 0,0:17:19.60,0:17:21.60,Default,,0,0,0,,Мұнда толық күзет!
Dialogue: 0,0:17:21.60,0:17:24.61,Default,,0,0,0,,Ух...! Соңына бұрылу.
Dialogue: 0,0:17:24.61,0:17:26.61,Default,,0,0,0,,Сәлем! Халона. жұмысшы….
Dialogue: 0,0:17:26.61,0:17:31.61,Default,,0,0,0,,Мен, мен бәрін жақсы істеуім керек деп ойлайтынмын.
Dialogue: 0,0:17:31.61,0:17:35.12,Default,,0,0,0,,Олай етпесең, күле алмайсың.
Dialogue: 0,0:17:35.12,0:17:38.59,Default,,0,0,0,,Бірақ мен сияқты болғаным дұрыс...
Dialogue: 0,0:17:41.12,0:17:43.62,Default,,0,0,0,,Мен де солай ойлаған жерім болды.
Dialogue: 0,0:17:43.62,0:17:46.63,Default,,0,0,0,,Маған да Харонаға да қатысты➡
Dialogue: 0,0:17:46.63,0:17:49.13,Default,,0,0,0,,Харонамен бірге болу қызық.
Dialogue: 0,0:17:49.13,0:17:52.13,Default,,0,0,0,,Сонымен, Харона...!
Dialogue: 0,0:17:52.13,0:17:55.14,Default,,0,0,0,,Бірақ мен формалымын.
Dialogue: 0,0:17:55.14,0:17:58.14,Default,,0,0,0,,Сондықтан Урарамен тіл табыса алмаймын.
Dialogue: 0,0:17:58.14,0:18:00.58,Default,,0,0,0,,Бұл дұрыс емес! жұмысшы?
Dialogue: 0,0:18:00.58,0:18:04.08,Default,,0,0,0,,Формашы болғаныма қуаныштымын➡
Dialogue: 0,0:18:04.08,0:18:06.08,Default,,0,0,0,,Мен сараңмын➡
Dialogue: 0,0:18:06.08,0:18:08.05,Default,,0,0,0,,Менің көзім таусылғандықтан...
Dialogue: 0,0:18:10.08,0:18:12.59,Default,,0,0,0,,Тирнаног жастарында….
Dialogue: 0,0:18:12.59,0:18:14.59,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:18:14.59,0:18:16.59,Default,,0,0,0,,Біркелкі киімдер!
Dialogue: 0,0:18:16.59,0:18:19.59,Default,,0,0,0,,Ха! Сондықтан Харона және бәрі жақсы!
Dialogue: 0,0:18:19.59,0:18:22.60,Default,,0,0,0,,Барлығын жақсы көрген дұрыс!
Dialogue: 0,0:18:22.60,0:18:25.10,Default,,0,0,0,,Бірге көбірек көңіл көтерейік!
Dialogue: 0,0:18:25.10,0:18:27.60,Default,,0,0,0,,Халона!
Dialogue: 0,0:18:27.60,0:18:30.10,Default,,0,0,0,,Жүр, кеттік! Менің кезегім ➡
Dialogue: 0,0:18:30.10,0:18:32.07,Default,,0,0,0,,Ұтыс!
Dialogue: 0,0:18:33.61,0:18:36.61,Default,,0,0,0,,Барлық дыбыстарды бір дыбысқа біріктіру➡
Dialogue: 0,0:18:36.61,0:18:40.11,Default,,0,0,0,,Біріктіріңіз және әлемге жаңғырық!
Dialogue: 0,0:18:40.11,0:18:43.08,Default,,0,0,0,,Марке Флер Рианнон Вивасқа...
Dialogue: 0,0:18:44.62,0:18:46.62,Default,,0,0,0,,Юнисон көйлек!
Dialogue: 0,0:18:46.62,0:18:55.63,Default,,0,0,0,,♬～
Dialogue: 0,0:18:55.63,0:18:57.60,Default,,0,0,0,,Унисон… көйлек?
Dialogue: 0,0:18:59.63,0:19:02.07,Default,,0,0,0,,Иә...бұл➡
Dialogue: 0,0:19:02.07,0:19:04.07,Default,,0,0,0,,Жаңа мен!
Dialogue: 0,0:19:04.07,0:19:06.07,Default,,0,0,0,,Шеберлікпен 1 картаны салыңыз➡
Dialogue: 0,0:19:06.07,0:19:09.08,Default,,0,0,0,,Эрентис пен Диантаға қоңырау шалыңыз!
Dialogue: 0,0:19:09.08,0:19:12.58,Default,,0,0,0,,Резонанстық айдаһарға шеберлікпен қоңырау шалыңыз!
Dialogue: 0,0:19:12.58,0:19:16.08,Default,,0,0,0,,Elentis's Boost Resonance көмегімен шабуыл!
Dialogue: 0,0:19:16.08,0:19:19.09,Default,,0,0,0,,Күзетші! Таза күшейту➡
Dialogue: 0,0:19:19.09,0:19:21.09,Default,,0,0,0,,Диантамен шабуыл!
Dialogue: 0,0:19:21.09,0:19:23.09,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:19:23.09,0:19:25.59,Default,,0,0,0,,Түрлі-түсті дыбыстарға толы...
Dialogue: 0,0:19:25.59,0:19:28.60,Default,,0,0,0,,Барлығының дыбыстарын қабаттастыру➡
Dialogue: 0,0:19:28.60,0:19:30.60,Default,,0,0,0,,Бірге ораныңыз.
Dialogue: 0,0:19:30.60,0:19:32.60,Default,,0,0,0,,Бұл Юнисон көйлегі!
Dialogue: 0,0:19:32.60,0:19:35.10,Default,,0,0,0,,Рианорн Виваспен шабуыл!
Dialogue: 0,0:19:35.10,0:19:37.10,Default,,0,0,0,,Дағды іске қосылды! ➡
Dialogue: 0,0:19:37.10,0:19:41.11,Default,,0,0,0,,Барлық артқы қорғаушыларды тұрып, барлық 5-пен күшейтіңіз!
Dialogue: 0,0:19:41.11,0:19:47.62,Default,,0,0,0,,♬～
Dialogue: 0,0:19:47.62,0:19:50.08,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:54.12,0:19:56.12,Default,,0,0,0,,Still➡
Dialogue: 0,0:19:56.12,0:19:58.13,Default,,0,0,0,,Оның сізге жетуіне жол бермеңіз!
Dialogue: 0,0:19:58.13,0:20:00.09,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:20:00.09,0:20:02.06,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:20:02.06,0:20:05.07,Default,,0,0,0,,Триггер жоқ…Екінші тексеру➡
Dialogue: 0,0:20:05.07,0:20:07.07,Default,,0,0,0,,Триггер жоқ➡
Dialogue: 0,0:20:07.07,0:20:09.07,Default,,0,0,0,,Әлі жоқ! ➡
Dialogue: 0,0:20:09.07,0:20:11.57,Default,,0,0,0,,Юнисон көйлектер әлі аяқталған жоқ!
Dialogue: 0,0:20:11.57,0:20:14.08,Default,,0,0,0,,Шайқастың соңында Рианорн Вивас➡
Dialogue: 0,0:20:14.08,0:20:16.58,Default,,0,0,0,,Стенд резонансы Айдаһар Дианта➡
Dialogue: 0,0:20:16.58,0:20:20.08,Default,,0,0,0,,Қуат плюс 5000! Жүргізу минус 1.
Dialogue: 0,0:20:20.08,0:20:23.58,Default,,0,0,0,,Үш бөлік! Дәлірек айтқанда, Vanguard да стенд пе?
Dialogue: 0,0:20:23.58,0:20:25.59,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,0:20:25.59,0:20:27.59,Default,,0,0,0,,Унисондық көйлекті кінәламаңыз!
Dialogue: 0,0:20:27.59,0:20:30.59,Default,,0,0,0,,Тағы да Rhianorn Vivace➡
Dialogue: 0,0:20:30.59,0:20:32.59,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:20:32.59,0:20:34.60,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:20:34.60,0:20:36.60,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:20:36.60,0:20:38.60,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:20:38.60,0:20:40.60,Default,,0,0,0,,Диантаның күші плюс 10 000! ➡
Dialogue: 0,0:20:40.60,0:20:42.60,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:20:42.60,0:20:44.61,Default,,0,0,0,,U….
Dialogue: 0,0:20:44.61,0:20:46.61,Default,,0,0,0,,Диантамен шабуыл!
Dialogue: 0,0:20:46.61,0:20:48.58,Default,,0,0,0,,Күзетші! Кесу.
Dialogue: 0,0:20:51.11,0:20:54.12,Default,,0,0,0,,Резонанстық айдаһар➡ көмегімен авангард болыңыз
Dialogue: 0,0:20:54.12,0:20:56.12,Default,,0,0,0,,Шабуыл.
Dialogue: 0,0:20:56.12,0:20:58.09,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:20:59.62,0:21:02.09,Default,,0,0,0,,Жоқ... күзетші.
Dialogue: 0,0:21:05.06,0:21:09.06,Default,,0,0,0,,Жеңімпаз... Урара Ханеяма!
Dialogue: 0,0:21:09.06,0:21:11.07,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:11.07,0:21:13.57,Default,,0,0,0,,О!
Dialogue: 0,0:21:13.57,0:21:15.54,Default,,0,0,0,,A…. Хехе.
Dialogue: 0,0:21:17.57,0:21:20.07,Default,,0,0,0,,Урара бұл➡
Dialogue: 0,0:21:20.07,0:21:23.08,Default,,0,0,0,,Клэйдің әңгімесін тыңдағанды ұнатқандай болған кезде➡
Dialogue: 0,0:21:23.08,0:21:25.08,Default,,0,0,0,,​​Мен бақытты болдым.
Dialogue: 0,0:21:25.08,0:21:28.58,Default,,0,0,0,,Маған Vanguard әлемі ұнайды➡
Dialogue: 0,0:21:28.58,0:21:31.09,Default,,0,0,0,,Мен бірлік әңгімелерді жақсы көремін➡
Dialogue: 0,0:21:31.09,0:21:34.56,Default,,0,0,0,,Авангард мені Урарамен байланыстырды.
Dialogue: 0,0:21:38.09,0:21:41.06,Default,,0,0,0,,Сен менің досым боласың ба?
Dialogue: 0,0:21:43.60,0:21:46.10,Default,,0,0,0,,А...у!
Dialogue: 0,0:21:46.10,0:21:48.60,Default,,0,0,0,,Бірақ бұл көңілсіз! ➡
Dialogue: 0,0:21:48.60,0:21:50.60,Default,,0,0,0,,Қайтадан жасайық! Юн, жасайық! ➡
Dialogue: 0,0:21:50.60,0:21:52.61,Default,,0,0,0,,Кейін көп ұрысайық!
Dialogue: 0,0:21:52.61,0:21:57.58,Default,,0,0,0,,♬～
Dialogue: 0,0:21:59.08,0:22:05.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory