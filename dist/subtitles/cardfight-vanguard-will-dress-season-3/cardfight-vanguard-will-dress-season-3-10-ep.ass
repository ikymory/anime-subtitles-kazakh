Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.16,0:00:16.14,Default,,0,0,0,,(((флейта дыбысы)
Dialogue: 0,0:00:18.18,0:00:20.18,Default,,0,0,0,,Керемет! Урара: Сен жақсысың.
Dialogue: 0,0:00:20.18,0:00:22.68,Default,,0,0,0,,Эхехе...рахмет! ➡
Dialogue: 0,0:00:22.68,0:00:24.69,Default,,0,0,0,,Соңғы уақытта, тіпті тәжірибеде➡
Dialogue: 0,0:00:24.69,0:00:26.69,Default,,0,0,0,,Енді мен ~➡ дыбыстарын сәйкестендіремін
Dialogue: 0,0:00:26.69,0:00:30.69,Default,,0,0,0,,Харонамен жекпе-жек те қызықты және жақсы нәрселерге толы!
Dialogue: 0,0:00:30.69,0:00:32.66,Default,,0,0,0,,Ухуху…. ))
Dialogue: 0,0:00:47.21,0:00:49.18,Default,,0,0,0,,Енді ол жерде кім болады?
Dialogue: 0,0:00:52.71,0:00:54.72,Default,,0,0,0,,Урара-сан➡
Dialogue: 0,0:00:54.72,0:00:56.72,Default,,0,0,0,,Сәттілік.
Dialogue: 0,0:00:56.72,0:00:58.72,Default,,0,0,0,,Мен сізге қысым көрсеткім келмейді, бірақ➡
Dialogue: 0,0:00:58.72,0:01:02.16,Default,,0,0,0,,Жеңілсең, ойыннан шығасың.
Dialogue: 0,0:01:02.16,0:01:04.63,Default,,0,0,0,,Бұл жынның қысымы...
Dialogue: 0,0:01:06.16,0:01:08.66,Default,,0,0,0,,Сізде бәрі жақсы болады.
Dialogue: 0,0:01:08.66,0:01:10.63,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:01:18.67,0:01:20.68,Default,,0,0,0,,Сәлем! ➡
Dialogue: 0,0:01:20.68,0:01:23.15,Default,,0,0,0,,Мен кетемін.
Dialogue: 0,0:01:30.69,0:01:32.69,Default,,0,0,0,,Күткеніңізге рахмет! ➡
Dialogue: 0,0:01:32.69,0:01:34.66,Default,,0,0,0,,Халона.
Dialogue: 0,0:01:36.69,0:01:38.69,Default,,0,0,0,,Өйткені, бұл урара➡
Dialogue: 0,0:01:38.69,0:01:40.66,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:01:42.70,0:01:44.67,Default,,0,0,0,,Мен сені ұрып-соғамын.
Dialogue: 0,0:03:17.16,0:03:20.16,Default,,0,0,0,,Келіңіздер! Баексан тауының етегіндегі шайқас, екінші раунд➡
Dialogue: 0,0:03:20.16,0:03:22.66,Default,,0,0,0,,Қарсы ұшқышты кесіңіз➡
Dialogue: 0,0:03:22.66,0:03:25.67,Default,,0,0,0,,Бірдей мықты командадан туды кім алды?
Dialogue: 0,0:03:25.67,0:03:28.67,Default,,0,0,0,,Мен Vanguard ойнауды 12 жасымда бастадым! ➡
Dialogue: 0,0:03:28.67,0:03:30.61,Default,,0,0,0,,Күрескерді мықтыға жетелеу➡
Dialogue: 0,0:03:30.61,0:03:34.11,Default,,0,0,0,,Формалар бағдарламасы бойынша жылтыратылған данышпан қыз➡
Dialogue: 0,0:03:34.11,0:03:36.11,Default,,0,0,0,,Мынаны қараңыз! ➡
Dialogue: 0,0:03:36.11,0:03:40.12,Default,,0,0,0,,Жаман көзді құбыжық Халона Уокер!
Dialogue: 0,0:03:40.12,0:03:42.12,Default,,0,0,0,,Қарсы! ➡
Dialogue: 0,0:03:42.12,0:03:46.12,Default,,0,0,0,,Жаңадан бастағандар үшін үлкен алтын жұлдыздар туралы айтатын болсақ, бұл қыз да жеңілген жоқ! ➡
Dialogue: 0,0:03:46.12,0:03:48.12,Default,,0,0,0,,Мен Vanguard➡ ойнай бастадым
Dialogue: 0,0:03:48.12,0:03:50.63,Default,,0,0,0,,Люкс финалдық турниріне өтті➡
Dialogue: 0,0:03:50.63,0:03:53.13,Default,,0,0,0,,Ең күшті ұшатын жаңа ойыншы➡
Dialogue: 0,0:03:53.13,0:03:55.60,Default,,0,0,0,,Урара Ханеяма~!
Dialogue: 0,0:03:57.63,0:03:59.63,Default,,0,0,0,,Білесің бе, Харона, мен...
Dialogue: 0,0:03:59.63,0:04:01.64,Default,,0,0,0,,Мен Урараны жеңемін.
Dialogue: 0,0:04:02.64,0:04:04.64,Default,,0,0,0,,Біркелкілер дұрыс➡
Dialogue: 0,0:04:04.64,0:04:07.14,Default,,0,0,0,,Мен оны жеңу арқылы дәлелдеймін.
Dialogue: 0,0:04:07.14,0:04:09.64,Default,,0,0,0,,Мен де ұтыла алмаймын➡
Dialogue: 0,0:04:09.64,0:04:11.61,Default,,0,0,0,,Себебі мен де жеңгім келеді!
Dialogue: 0,0:04:12.65,0:04:14.65,Default,,0,0,0,,Жеңіс пен Харона тағы да...
Dialogue: 0,0:04:14.65,0:04:17.12,Default,,0,0,0,,Қателіктеріңізді есте сақтаңыз.
Dialogue: 0,0:04:18.15,0:04:21.62,Default,,0,0,0,,Мен сізді ең күшті болу жолыңыздан бас тартқаныңызға өкінемін.
Dialogue: 0,0:04:23.16,0:04:27.16,Default,,0,0,0,,Енді, Тау етегіндегі екінші шайқас.
Dialogue: 0,0:04:27.16,0:04:29.13,Default,,0,0,0,,Бастау!
Dialogue: 0,0:04:31.60,0:04:34.10,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:04:34.10,0:04:36.10,Default,,0,0,0,,Жаман көзді аң Аманакити.
Dialogue: 0,0:04:36.10,0:04:38.61,Default,,0,0,0,,Корфи бұлағын хабарлайтын жел.
Dialogue: 0,0:04:38.61,0:04:42.11,Default,,0,0,0,,Менің кезегім Аманаклогқа ➡ міну
Dialogue: 0,0:04:42.11,0:04:45.61,Default,,0,0,0,,Аманагурджио Маскусты қолыңызға қосу шеберлігін пайдаланыңыз.
Dialogue: 0,0:04:45.61,0:04:47.62,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:04:47.62,0:04:50.12,Default,,0,0,0,,Қалай ойлайсың, Ұлала мені жеңе алады ма? ➡
Dialogue: 0,0:04:50.12,0:04:53.12,Default,,0,0,0,,Менің күшімді ұмыттыңыз ба?
Dialogue: 0,0:04:53.12,0:04:55.62,Default,,0,0,0,,Мен Харонаның керемет екенін білемін.
Dialogue: 0,0:04:55.62,0:04:58.63,Default,,0,0,0,,Бірақ мен бұрынғы адамнан аздап басқашамын! ➡
Dialogue: 0,0:04:58.63,0:05:01.13,Default,,0,0,0,,Менің кезегім Грасияға барамын➡
Dialogue: 0,0:05:01.13,0:05:03.13,Default,,0,0,0,,Шеберлікпен 1 картаны салыңыз➡
Dialogue: 0,0:05:03.13,0:05:06.13,Default,,0,0,0,,Call Gracia көмегімен Элентиске шабуыл жасаңыз!
Dialogue: 0,0:05:06.13,0:05:08.14,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:05:08.14,0:05:10.14,Default,,0,0,0,,Элентиспен шабуыл!
Dialogue: 0,0:05:10.14,0:05:12.64,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:05:12.64,0:05:14.64,Default,,0,0,0,,Әр айналымды аяқтаңыз➡
Dialogue: 0,0:05:14.64,0:05:17.15,Default,,0,0,0,,Урара дереу артқы күзетшіні➡ шақырады
Dialogue: 0,0:05:17.15,0:05:19.65,Default,,0,0,0,,Кенет шабуыл! ➡
Dialogue: 0,0:05:19.65,0:05:21.65,Default,,0,0,0,,Басынан бастап керемет жекпе-жек! ➡
Dialogue: 0,0:05:21.65,0:05:25.15,Default,,0,0,0,,Бұл Урара Ханеяма!
Dialogue: 0,0:05:25.15,0:05:27.16,Default,,0,0,0,,Әрине өзгерді.
Dialogue: 0,0:05:27.16,0:05:30.13,Default,,0,0,0,,Иә, бұл менің карта төбелесім.
Dialogue: 0,0:05:30.13,0:05:32.59,Default,,0,0,0,,Ұнатпау. жұмысшы...?
Dialogue: 0,0:05:32.59,0:05:35.60,Default,,0,0,0,,Менің кезегім: Қолыңыздан бір картаны тастаңыз➡
Dialogue: 0,0:05:35.60,0:05:37.60,Default,,0,0,0,,Амана үкілеріне міну➡
Dialogue: 0,0:05:37.60,0:05:42.10,Default,,0,0,0,,Алдыңғы триггерді палубадан жанға қойып, 1 картаны тарту шеберлігін пайдаланыңыз➡
Dialogue: 0,0:05:42.10,0:05:44.61,Default,,0,0,0,,Амана үкілерімен шабуыл.
Dialogue: 0,0:05:44.61,0:05:47.08,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:05:48.11,0:05:51.61,Default,,0,0,0,,Қайтып келсең кешірермін деп ойладым➡
Dialogue: 0,0:05:51.61,0:05:54.62,Default,,0,0,0,,Мен форманы лақтырып жіберген осындай ұрыс➡
Dialogue: 0,0:05:54.62,0:05:57.62,Default,,0,0,0,,Мен мұндайды мойындамаймын!
Dialogue: 0,0:05:57.62,0:06:00.62,Default,,0,0,0,,Мен мұны естуге дайын болдым.
Dialogue: 0,0:06:00.62,0:06:04.63,Default,,0,0,0,,Сонда да мен Харонамен осы жекпе-жек арқылы бітіскім келеді! ➡
Dialogue: 0,0:06:04.63,0:06:06.63,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:06:06.63,0:06:09.13,Default,,0,0,0,,Керемет әуенге мініңіз!
Dialogue: 0,0:06:09.13,0:06:11.63,Default,,0,0,0,,Грасияға шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:06:11.63,0:06:15.14,Default,,0,0,0,,Көңілді айдаһар Флуттер Айдаһарға қоңырау шалыңыз!
Dialogue: 0,0:06:15.14,0:06:17.64,Default,,0,0,0,,Көңілді айдаһармен шабуыл!
Dialogue: 0,0:06:17.64,0:06:20.14,Default,,0,0,0,,Күзетші. шабуыл!
Dialogue: 0,0:06:20.14,0:06:22.14,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:06:22.14,0:06:24.11,Default,,0,0,0,,Шабуыл! Күзетші жоқ.
Dialogue: 0,0:06:27.15,0:06:29.15,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:06:29.15,0:06:31.59,Default,,0,0,0,,Мен ақымақ сияқты көп қоңырау шалдым➡
Dialogue: 0,0:06:31.59,0:06:34.09,Default,,0,0,0,,Сіз дұрыс ойлайсыз ба?
Dialogue: 0,0:06:34.09,0:06:37.09,Default,,0,0,0,,Әрине, мен өзімнің жекпе-жек түрін ойлап жүрмін➡
Dialogue: 0,0:06:37.09,0:06:40.60,Default,,0,0,0,,Жеңіске жету үшін бар күш-жігеріңізді салудың еш жамандығы жоқ!
Dialogue: 0,0:06:40.60,0:06:43.10,Default,,0,0,0,,Мағынасы мен түсінбеймін.
Dialogue: 0,0:06:43.10,0:06:46.10,Default,,0,0,0,,Хмм...дұрыс➡
Dialogue: 0,0:06:46.10,0:06:49.60,Default,,0,0,0,,Мағынасын түсінбедім➡
Dialogue: 0,0:06:49.60,0:06:54.08,Default,,0,0,0,,Мен сол кезде Blackout-ты таңдадым.
Dialogue: 0,0:06:55.11,0:06:59.11,Default,,0,0,0,,Бірақ бұл менің Харонаны жек көретінімді білдірмейді.
Dialogue: 0,0:06:59.11,0:07:01.12,Default,,0,0,0,,Өйткені маған Blackout➡ ұнайды
Dialogue: 0,0:07:01.12,0:07:05.12,Default,,0,0,0,,Өйткені мен төбелескенді және карталарды тыңдағанды жақсы көремін!
Dialogue: 0,0:07:05.12,0:07:09.12,Default,,0,0,0,,Сөйтіп, ақырында ол бізге ескі досын таңдады.
Dialogue: 0,0:07:09.12,0:07:11.63,Default,,0,0,0,,Жоқ! Ол емес➡
Dialogue: 0,0:07:11.63,0:07:15.13,Default,,0,0,0,,Мен Халонаны әлі де жақсы көремін!
Dialogue: 0,0:07:15.13,0:07:19.13,Default,,0,0,0,,Сондықтан Blackout-ты тастап, Uniformers-ке оралыңыз!
Dialogue: 0,0:07:19.13,0:07:21.14,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:07:21.14,0:07:23.14,Default,,0,0,0,,Иә? Неліктен бұл болып жатыр?
Dialogue: 0,0:07:23.14,0:07:26.64,Default,,0,0,0,,Тату болғың келсе, бәрі әңгіме, солай емес пе? ➡
Dialogue: 0,0:07:26.64,0:07:29.64,Default,,0,0,0,,Қайтпасаң, Ұра, өтірікші!
Dialogue: 0,0:07:29.64,0:07:31.58,Default,,0,0,0,,Мен бұл нені білдіретінін білмеймін!
Dialogue: 0,0:07:31.58,0:07:34.08,Default,,0,0,0,,Өтірік айтсаң мен саған бірдеңе көрсетемін!
Dialogue: 0,0:07:34.08,0:07:36.08,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:07:36.08,0:07:39.09,Default,,0,0,0,,Жаман көзді айдаһар Аманагурджиоға мін!
Dialogue: 0,0:07:39.09,0:07:41.59,Default,,0,0,0,,Шеберлігі бар палубаның жоғарғы 5 картасынан➡
Dialogue: 0,0:07:41.59,0:07:44.59,Default,,0,0,0,,Аманагурджио Маскін қолыңызға қосыңыз.
Dialogue: 0,0:07:44.59,0:07:47.60,Default,,0,0,0,,Мен Урара екеумізді ұқсас деп ойладым➡
Dialogue: 0,0:07:47.60,0:07:50.60,Default,,0,0,0,,Карточкалар мен жүректермен сөйлесе алатындар➡
Dialogue: 0,0:07:50.60,0:07:53.10,Default,,0,0,0,,Бірақ ол басқаша болды➡
Dialogue: 0,0:07:53.10,0:07:55.60,Default,,0,0,0,,Күшті болудан бас тартқан саған➡
Dialogue: 0,0:07:55.60,0:07:57.61,Default,,0,0,0,,Ізгі хабар естілмейді!
Dialogue: 0,0:07:57.61,0:07:59.57,Default,,0,0,0,,Ах...!
Dialogue: 0,0:08:02.61,0:08:05.11,Default,,0,0,0,,Аманагуруджио шеберлігі! ➡
Dialogue: 0,0:08:05.11,0:08:08.12,Default,,0,0,0,,Құлыстың алдыңғы триггерін байлаңыз➡
Dialogue: 0,0:08:08.12,0:08:11.12,Default,,0,0,0,,Гидрагрумның тамшы маскасы арқылы➡
Dialogue: 0,0:08:11.12,0:08:15.62,Default,,0,0,0,,Жаман көзді айдаһар император Аманагурджио Маскусқа➡
Dialogue: 0,0:08:15.62,0:08:17.59,Default,,0,0,0,,Жүр!
Dialogue: 0,0:08:23.13,0:08:26.13,Default,,0,0,0,,Гуо~!
Dialogue: 0,0:08:26.13,0:08:29.64,Default,,0,0,0,,Билеушінің қызыл көзін шақыр, Линдалкия!
Dialogue: 0,0:08:29.64,0:08:33.64,Default,,0,0,0,,Палубаның жоғарғы 5 картасынан Гунгунурамға қоңырау шалу шеберлігін пайдаланыңыз➡
Dialogue: 0,0:08:33.64,0:08:36.64,Default,,0,0,0,,Тамшыны емдеу триггерін байлаңыз!
Dialogue: 0,0:08:36.64,0:08:39.65,Default,,0,0,0,,Гунгунурам шеберлігімен 1 картаны салыңыз➡
Dialogue: 0,0:08:39.65,0:08:42.15,Default,,0,0,0,,Бейшара қанатты шақырыңыз!
Dialogue: 0,0:08:42.15,0:08:44.15,Default,,0,0,0,,Шеберлікпен 1 картаны салыңыз➡
Dialogue: 0,0:08:44.15,0:08:47.16,Default,,0,0,0,,Гунгунурам мен Демон Шеридерді шақырыңыз!
Dialogue: 0,0:08:47.16,0:08:51.16,Default,,0,0,0,,Бір Рюки маркерін шеберлікпен қойыңыз➡
Dialogue: 0,0:08:51.16,0:08:53.16,Default,,0,0,0,,Amanagurgio Mascus дағдылары➡
Dialogue: 0,0:08:53.16,0:08:56.16,Default,,0,0,0,,Құлаудың сыни триггерін байланыстырыңыз!
Dialogue: 0,0:08:56.16,0:08:58.17,Default,,0,0,0,,К….
Dialogue: 0,0:08:58.17,0:09:00.17,Default,,0,0,0,,Енді осы бұрылыс кезінде➡
Dialogue: 0,0:09:00.17,0:09:03.17,Default,,0,0,0,,Алдыңғы өкшенің сыни триггері➡
Dialogue: 0,0:09:03.17,0:09:05.67,Default,,0,0,0,,Қуатты арттыру әсері өшірілген➡
Dialogue: 0,0:09:05.67,0:09:08.18,Default,,0,0,0,,Қалқан минус 5000!
Dialogue: 0,0:09:08.18,0:09:10.68,Default,,0,0,0,,Мейірім жоқ! ➡
Dialogue: 0,0:09:10.68,0:09:12.68,Default,,0,0,0,,Күшті дағдылармен құлдық➡
Dialogue: 0,0:09:12.68,0:09:16.68,Default,,0,0,0,,Урара әбден байлаулы!
Dialogue: 0,0:09:16.68,0:09:18.69,Default,,0,0,0,,Қасірет қанатымен шабуыл!
Dialogue: 0,0:09:18.69,0:09:21.16,Default,,0,0,0,,Күзетші жоқ! Зақымдануды тексеру...
Dialogue: 0,0:09:22.69,0:09:25.69,Default,,0,0,0,,((Ах! Мен естіп тұрмын...Е?➡
Dialogue: 0,0:09:25.69,0:09:28.16,Default,,0,0,0,,Дыбыс... ))
Dialogue: 0,0:09:32.13,0:09:34.10,Default,,0,0,0,,Алдыңғы триггер.
Dialogue: 0,0:09:35.64,0:09:38.61,Default,,0,0,0,,)
Dialogue: 0,0:09:40.14,0:09:42.64,Default,,0,0,0,,Қанша достарың болса да➡
Dialogue: 0,0:09:42.64,0:09:45.65,Default,,0,0,0,,Әлсіз болса мағынасыз➡
Dialogue: 0,0:09:45.65,0:09:48.65,Default,,0,0,0,,Аманагургио Маскуспен шабуыл!
Dialogue: 0,0:09:48.65,0:09:51.65,Default,,0,0,0,,Күзетші! Бірінші тексеру➡
Dialogue: 0,0:09:51.65,0:09:55.16,Default,,0,0,0,,Триггерді екінші тексеру жоқ➡
Dialogue: 0,0:09:55.16,0:09:57.16,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:09:57.16,0:10:00.16,Default,,0,0,0,,Amanagurgio Mascus шеберлігін белсендіру➡
Dialogue: 0,0:10:00.16,0:10:03.67,Default,,0,0,0,,Артқы қатардағы екі қорғаушыны жанға салып, тұрыңыз➡
Dialogue: 0,0:10:03.67,0:10:05.67,Default,,0,0,0,,Жүргізу минус 1➡
Dialogue: 0,0:10:05.67,0:10:09.17,Default,,0,0,0,,Аманагургио Маскуспен тағы да шабуыл жасаңыз!
Dialogue: 0,0:10:09.17,0:10:12.17,Default,,0,0,0,,Керемет... күзетші!
Dialogue: 0,0:10:12.17,0:10:14.18,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:10:14.18,0:10:16.18,Default,,0,0,0,,Критикалық триггер➡
Dialogue: 0,0:10:16.18,0:10:18.18,Default,,0,0,0,,Линдалкияның күші плюс 10000➡
Dialogue: 0,0:10:18.18,0:10:20.15,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:10:21.68,0:10:23.69,Default,,0,0,0,,Линдалкиямен шабуыл!
Dialogue: 0,0:10:23.69,0:10:25.69,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:10:25.69,0:10:27.69,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:10:27.69,0:10:30.16,Default,,0,0,0,,Күшті! Күшті маскалар палубасы! ➡
Dialogue: 0,0:10:30.16,0:10:33.63,Default,,0,0,0,,Бұл Халона Уокердің нағыз күші!
Dialogue: 0,0:10:35.13,0:10:38.63,Default,,0,0,0,,((Ураны жеңіп, бәрін аяқтаңыз.
Dialogue: 0,0:10:38.63,0:10:41.14,Default,,0,0,0,,Менің досым➡
Dialogue: 0,0:10:41.14,0:10:43.61,Default,,0,0,0,,Бұл жай ғана Жігіт. ))
Dialogue: 0,0:10:52.11,0:10:54.12,Default,,0,0,0,,((Дұрыс➡
Dialogue: 0,0:10:54.12,0:10:57.12,Default,,0,0,0,,Әлемде мен деп аталатын бір ғана AI бар.
Dialogue: 0,0:10:57.12,0:11:02.06,Default,,0,0,0,,Бір мағынада бұл әлемдегі ең жалғыз тіршілік деп айтуға болады.
Dialogue: 0,0:11:02.06,0:11:05.53,Default,,0,0,0,,)
Dialogue: 0,0:11:08.56,0:11:10.53,Default,,0,0,0,,Мен жеңілдім...
Dialogue: 0,0:11:12.07,0:11:14.04,Default,,0,0,0,,Бұл! Палуба...
Dialogue: 0,0:11:20.07,0:11:23.08,Default,,0,0,0,,Дос табу қиын.
Dialogue: 0,0:11:23.08,0:11:26.58,Default,,0,0,0,,Көмек болмас, ерекше бала екенсің.
Dialogue: 0,0:11:26.58,0:11:28.58,Default,,0,0,0,,Арнайы?
Dialogue: 0,0:11:28.58,0:11:31.59,Default,,0,0,0,,Иә...жалғыздық – таланттылардың тағдыры➡
Dialogue: 0,0:11:31.59,0:11:33.59,Default,,0,0,0,,Софиге➡ қараңыз
Dialogue: 0,0:11:33.59,0:11:35.59,Default,,0,0,0,,Ол әрқашан жалғыз, бірақ...
Dialogue: 0,0:11:35.59,0:11:38.59,Default,,0,0,0,,Ум мен жалғызбын, бірақ бұл керемет.
Dialogue: 0,0:11:38.59,0:11:42.60,Default,,0,0,0,,Басқаша айтқанда, әлсіздердің деңгейіне бейімделудің қажеті жоқ.
Dialogue: 0,0:11:42.60,0:11:45.10,Default,,0,0,0,,Жоқ, әлемге…
Dialogue: 0,0:11:45.10,0:11:47.10,Default,,0,0,0,,Қарапайымдылық Тек мықты бол.
Dialogue: 0,0:11:47.10,0:11:49.10,Default,,0,0,0,,E?
Dialogue: 0,0:11:49.10,0:11:51.61,Default,,0,0,0,,Тұрақты емес билік қызғаныш тудырады, бірақ➡
Dialogue: 0,0:11:51.61,0:11:54.61,Default,,0,0,0,,Оның күш-қуаты қызғаныш тудырады ➡
Dialogue: 0,0:11:54.61,0:11:57.11,Default,,0,0,0,,Жеңісті жалғастырудың соңында➡
Dialogue: 0,0:11:57.11,0:11:59.61,Default,,0,0,0,,Сіз де көшбасшы бола аласыз.
Dialogue: 0,0:11:59.61,0:12:01.55,Default,,0,0,0,,Көшбасшы….
Dialogue: 0,0:12:01.55,0:12:03.52,Default,,0,0,0,,Уау! мм.
Dialogue: 0,0:12:04.55,0:12:06.52,Default,,0,0,0,,)
Dialogue: 0,0:12:07.56,0:12:09.56,Default,,0,0,0,,)
Dialogue: 0,0:12:09.56,0:12:11.53,Default,,0,0,0,,Харона~!
Dialogue: 0,0:12:17.07,0:12:19.57,Default,,0,0,0,,)
Dialogue: 0,0:12:19.57,0:12:21.57,Default,,0,0,0,,((Егер сіз бәрібір жоғалып кететін болсаңыз➡
Dialogue: 0,0:12:21.57,0:12:24.04,Default,,0,0,0,,Дос болып көрінбе. ))
Dialogue: 0,0:12:27.58,0:12:29.58,Default,,0,0,0,,Сіз қалай ойлайсыз? ➡
Dialogue: 0,0:12:29.58,0:12:31.58,Default,,0,0,0,,Сіз күштің айырмашылығын түсіндіңіз бе?
Dialogue: 0,0:12:31.58,0:12:34.08,Default,,0,0,0,,Мүлде жоқ! Керісінше, бұл күткендей.
Dialogue: 0,0:12:34.08,0:12:36.08,Default,,0,0,0,,Бұл бәрібір өтірік, солай ма?
Dialogue: 0,0:12:36.08,0:12:39.09,Default,,0,0,0,,Урара шынымен өзімшіл және өтірікке толы.
Dialogue: 0,0:12:39.09,0:12:41.09,Default,,0,0,0,,Не...! Қорқынышты➡
Dialogue: 0,0:12:41.09,0:12:43.09,Default,,0,0,0,,Тіпті Харона қыңыр және қыңыр!
Dialogue: 0,0:12:43.09,0:12:46.09,Default,,0,0,0,,Сіз шынымен де мұндай ерікті шешімдер қабылдауды доғарғаныңыз жөн!
Dialogue: 0,0:12:46.09,0:12:48.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:48.10,0:12:50.60,Default,,0,0,0,,Өйткені бұл рас, саңырауқұлақ басты!
Dialogue: 0,0:12:50.60,0:12:52.60,Default,,0,0,0,,Бұл қазір маңызды емес, солай ма?
Dialogue: 0,0:12:52.60,0:12:56.60,Default,,0,0,0,,Харона Кейде адамдар ұзын болғаны үшін ғана адамдарға төмен қарайды.
Dialogue: 0,0:12:56.60,0:12:58.61,Default,,0,0,0,,Бұл жай ғана ұрыс...
Dialogue: 0,0:12:58.61,0:13:00.58,Default,,0,0,0,,Уху….
Dialogue: 0,0:13:02.04,0:13:04.55,Default,,0,0,0,,((Сізге көп рахмет!
Dialogue: 0,0:13:04.55,0:13:08.05,Default,,0,0,0,,Мен соған жету үшін бар күшімді саламын!
Dialogue: 0,0:13:08.05,0:13:11.55,Default,,0,0,0,,Мм, сіз өзіңіздің шынайы сезімдеріңізді жеткізе аласыз деп үміттенемін.
Dialogue: 0,0:13:11.55,0:13:13.55,Default,,0,0,0,,Мен сізге айтайын.
Dialogue: 0,0:13:13.55,0:13:15.56,Default,,0,0,0,,Барлық шатастырылған сезімдеріңізді түкіріп тастаңыз➡
Dialogue: 0,0:13:15.56,0:13:17.56,Default,,0,0,0,,Татуласамыз деп үміттенемін!
Dialogue: 0,0:13:17.56,0:13:19.53,Default,,0,0,0,,Сәлем! Мен қолымнан келгеннің бәрін жасаймын. ))
Dialogue: 0,0:13:22.06,0:13:25.57,Default,,0,0,0,,Менен үлкен болса да, әпкеге мүлдем ұқсамайды! ➡
Dialogue: 0,0:13:25.57,0:13:28.57,Default,,0,0,0,,Неліктен әртүрлі жерлерді аралап, аздап тынышталмайсыз?
Dialogue: 0,0:13:28.57,0:13:31.57,Default,,0,0,0,,Хидои! Сіз де бұл туралы ойлайсыз ба?
Dialogue: 0,0:13:31.57,0:13:35.08,Default,,0,0,0,,Содан бері мен көп нәрсені ойладым, енді осында тұрмын➡
Dialogue: 0,0:13:35.08,0:13:38.08,Default,,0,0,0,,Палубамды қайта қарастырғаннан кейін Харонаға не айтуым керек?➡
Dialogue: 0,0:13:38.08,0:13:40.08,Default,,0,0,0,,Шарасыз ойлау...
Dialogue: 0,0:13:40.08,0:13:42.08,Default,,0,0,0,,Сондықтан мен сізге дұрыс айтамын! ➡
Dialogue: 0,0:13:42.08,0:13:45.55,Default,,0,0,0,,Мен Харонамен қайтадан дос болғым келеді!
Dialogue: 0,0:13:46.59,0:13:49.06,Default,,0,0,0,,Мен боянғым келеді! Ха….
Dialogue: 0,0:13:52.59,0:13:55.10,Default,,0,0,0,,Сіз шынымен де осылай айтып отырсыз ба?
Dialogue: 0,0:13:55.10,0:13:58.10,Default,,0,0,0,,Әрине! Өйткені мен Халонаны жақсы көремін.
Dialogue: 0,0:13:58.10,0:14:01.04,Default,,0,0,0,,Мен сондаймын... Кеттік! ➡
Dialogue: 0,0:14:01.04,0:14:03.54,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:14:03.54,0:14:07.04,Default,,0,0,0,,Гүлденген керемет шеру Рианорнға бару➡
Dialogue: 0,0:14:07.04,0:14:09.54,Default,,0,0,0,,Тамшыдан Пуритті шеберлікпен шақырыңыз! ➡
Dialogue: 0,0:14:09.54,0:14:12.05,Default,,0,0,0,,1 Рианорн дағдысын салыңыз➡
Dialogue: 0,0:14:12.05,0:14:14.55,Default,,0,0,0,,Festoso Dragon➡ қоңырау шалыңыз
Dialogue: 0,0:14:14.55,0:14:17.55,Default,,0,0,0,,Резонанстық айдаһарды шеберлікпен шақырыңыз➡
