Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:05.87,Default,,0,0,0,,♬～
Dialogue: 0,0:00:05.87,0:00:12.37,Default,,0,0,0,,Мен Кимбл мырзаның кешкі асқа шақыруына уақытында үлгере алмаймын.
Dialogue: 0,0:00:12.37,0:00:16.25,Default,,0,0,0,,Тым болмаса бұл жердің қай жерде екенін анықтай алсам ғой...
Dialogue: 0,0:00:16.25,0:00:20.58,Default,,0,0,0,,<Мені және Диананы досым шақырды➡
Dialogue: 0,0:00:20.58,0:00:25.09,Default,,0,0,0,,Мен орманның тереңінде адасып қалдым＞
Dialogue: 0,0:00:25.09,0:00:29.39,Default,,0,0,0,,Не істеу керек? Артқа бұрылып, үйге қайтайық па?
Dialogue: 0,0:00:29.39,0:00:32.59,Default,,0,0,0,,Күтіңіз. Менің үйім бар.
Dialogue: 0,0:00:35.83,0:00:40.00,Default,,0,0,0,,Бұл Ямабикосо!
Dialogue: 0,0:00:40.00,0:00:42.27,Default,,0,0,0,,(қақпаның ашылған дыбысы)
Dialogue: 0,0:00:42.27,0:00:45.54,Default,,0,0,0,,Бұл эксцентрик ретінде танымал Лаванда Льюистің үйі.
Dialogue: 0,0:00:45.54,0:00:47.81,Default,,0,0,0,,Лаванда Льюис?
Dialogue: 0,0:00:47.81,0:00:49.75,Default,,0,0,0,,Flashback (Рейчел Линд) Бала Полдың әкесі кім?
Dialogue: 0,0:00:49.75,0:00:52.05,Default,,0,0,0,,Бұл Стивен Ирвинг.
Dialogue: 0,0:00:52.05,0:00:56.29,Default,,0,0,0,,Есіңде ме? Middle Grafton Road Beyond…➡
Dialogue: 0,0:00:56.29,0:00:59.19,Default,,0,0,0,,Ол Лаванда Льюиспен кездесіп жүрген...
Dialogue: 0,0:00:59.19,0:01:04.16,Default,,0,0,0,,Мен бұл есімді бұрын естігенмін.
Dialogue: 0,0:01:04.16,0:01:05.73,Default,,0,0,0,,Хмм! (Анна Диана) А...
Dialogue: 0,0:01:05.73,0:01:09.93,Default,,0,0,0,,Міне, ханымдар. Лаванда осында ма?
Dialogue: 0,0:01:09.93,0:01:13.90,Default,,0,0,0,,Иә, мен сізге дәл қазір хабарлаймын.
Dialogue: 0,0:01:13.90,0:01:17.24,Default,,0,0,0,,Уф... Міне, келдің.
Dialogue: 0,0:01:17.24,0:01:19.24,Default,,0,0,0,,Сіз бағыт сұрауыңыз керек емес пе еді?
Dialogue: 0,0:01:19.24,0:01:23.15,Default,,0,0,0,,Мен Лаванда миссімен танысқым келді.
Dialogue: 0,0:01:30.72,0:01:33.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:33.39,0:01:36.06,Default,,0,0,0,,♬～
Dialogue: 0,0:01:36.06,0:01:39.39,Default,,0,0,0,,Хехе, Ямабикосоға қош келдіңіз.
Dialogue: 0,0:01:39.39,0:01:42.36,Default,,0,0,0,,Қарсы болмасаң, менімен шай ішуге келер ме едің?
Dialogue: 0,0:01:42.36,0:01:46.17,Default,,0,0,0,,Бірақ... Қызық, басқа қонақтар келе ме?
Dialogue: 0,0:01:46.17,0:01:48.90,Default,,0,0,0,,Жоқ. Мұнда келетін адамдар➡
Dialogue: 0,0:01:48.90,0:01:51.34,Default,,0,0,0,,Сирек. Біз жай➡
Dialogue: 0,0:01:51.34,0:01:54.24,Default,,0,0,0,,Мен жай ғана шай ішемін деп жүрдім. Иә.
Dialogue: 0,0:01:54.24,0:01:56.65,Default,,0,0,0,,Ах... Ах... (Лаванда) Мен өзіме сенімдімін➡
Dialogue: 0,0:01:56.65,0:01:59.31,Default,,0,0,0,,Сіз мұны күлкілі деп ойлайтыныңызға сенімдімін. Ондай нәрсе...!
Dialogue: 0,0:01:59.31,0:02:01.25,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:01.25,0:02:03.22,Default,,0,0,0,,Бұл өте күлкілі.
Dialogue: 0,0:02:03.22,0:02:06.12,Default,,0,0,0,,Мен тіпті таң қалдым. Хехе.
Dialogue: 0,0:02:06.12,0:02:15.36,Default,,0,0,0,,♬～
Dialogue: 0,0:02:15.36,0:02:20.04,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:02:20.04,0:02:22.57,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:02:22.57,0:02:24.51,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:02:24.51,0:02:28.38,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:02:28.38,0:02:30.71,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:30.71,0:02:32.95,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:32.95,0:02:37.49,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:02:37.49,0:02:42.69,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін».
Dialogue: 0,0:02:42.69,0:02:44.63,Default,,0,0,0,,♬ «Ол маған айтты».
Dialogue: 0,0:02:44.63,0:02:48.50,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:48.50,0:02:51.90,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:51.90,0:02:54.34,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:02:54.34,0:02:56.61,Default,,0,0,0,,♬ «Эй, мен күтемін.»
Dialogue: 0,0:02:56.61,0:03:00.78,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:03:00.78,0:03:03.25,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:03:03.25,0:03:05.58,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:03:05.58,0:03:09.05,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:03:09.05,0:03:12.35,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:03:12.35,0:03:14.59,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:03:14.59,0:03:18.86,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:03:18.86,0:03:21.36,Default,,0,0,0,,♬ «Мен санауды күтемін».
Dialogue: 0,0:03:21.36,0:03:23.67,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:03:23.67,0:03:25.67,Default,,0,0,0,,♬ «Мен сені алып кетейін.»
Dialogue: 0,0:03:25.67,0:03:30.04,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:30.04,0:03:33.94,Default,,0,0,0,,♬～
Dialogue: 0,0:03:36.71,0:03:41.28,Default,,0,0,0,,♬～
Dialogue: 0,0:03:41.28,0:03:43.35,Default,,0,0,0,,Лаванда Льюис? ➡
Dialogue: 0,0:03:43.35,0:03:47.06,Default,,0,0,0,,15 жылдан бері көрмедім.
Dialogue: 0,0:03:47.06,0:03:49.83,Default,,0,0,0,,Жас кезінде ол ең сұлу әйелдердің бірі болған.
Dialogue: 0,0:03:49.83,0:03:51.86,Default,,0,0,0,,Хехе. Бұл Дэви! ➡
Dialogue: 0,0:03:51.86,0:03:54.70,Default,,0,0,0,,Үстелге отырмаңыз! Шашы ақ болғаны рас, бірақ...➡
Dialogue: 0,0:03:54.70,0:03:58.23,Default,,0,0,0,,Жас, әдемі және...➡
Dialogue: 0,0:03:58.23,0:04:00.64,Default,,0,0,0,,Қызықты...
Dialogue: 0,0:04:00.64,0:04:03.44,Default,,0,0,0,,Еске алу (Лаванда) Жақсы ересек адам үйшік ойнап жүр. ➡
Dialogue: 0,0:04:03.44,0:04:07.18,Default,,0,0,0,,Бірақ мен ешкімді мазаламаймын➡
Dialogue: 0,0:04:07.18,0:04:09.58,Default,,0,0,0,,Бір ақымақтық жасай алмасаңыз➡
Dialogue: 0,0:04:09.58,0:04:13.18,Default,,0,0,0,,Жалғыз өмір сүре алмайтындар. Хехе.
Dialogue: 0,0:04:13.18,0:04:17.19,Default,,0,0,0,,Лаванда мырза да көп нәрсені елестететін адам.
Dialogue: 0,0:04:18.99,0:04:21.02,Default,,0,0,0,,Сонымен, үйге бара жатырсың➡
Dialogue: 0,0:04:21.02,0:04:24.49,Default,,0,0,0,,Бақшадан гүл теріп жүргенде...➡
Dialogue: 0,0:04:24.49,0:04:27.30,Default,,0,0,0,,Кездейсоқ...
Dialogue: 0,0:04:29.97,0:04:33.70,Default,,0,0,0,,Пол Ирвингті еске алу...?
Dialogue: 0,0:04:33.70,0:04:36.47,Default,,0,0,0,,Ол менің кішкентай оқушым.
Dialogue: 0,0:04:36.47,0:04:38.71,Default,,0,0,0,,Өткен жылы Бостоннан келдім...➡
Dialogue: 0,0:04:38.71,0:04:42.71,Default,,0,0,0,,Қазіргі уақытта мен әжеммен теңіз жағасындағы үйде тұрамын.
Dialogue: 0,0:04:42.71,0:04:45.48,Default,,0,0,0,,(солқылдаған гүлдердің дыбысы)
Dialogue: 0,0:04:45.48,0:04:47.48,Default,,0,0,0,,Бұл сіздің ұлыңыз...
Dialogue: 0,0:04:47.48,0:04:50.89,Default,,0,0,0,,Стивен Ирвинг….
Dialogue: 0,0:04:52.82,0:04:54.76,Default,,0,0,0,,Бұл ойланбастан болды...
Dialogue: 0,0:04:54.76,0:04:57.16,Default,,0,0,0,,Араласатын еліктеуші болма.
Dialogue: 0,0:04:57.16,0:05:00.56,Default,,0,0,0,,Мен бұлай айтқым келген жоқ!
Dialogue: 0,0:05:02.10,0:05:04.83,Default,,0,0,0,,Лаванда мырза мен Полдың әкесі арасындағы➡
Dialogue: 0,0:05:04.83,0:05:07.37,Default,,0,0,0,,Өткенде не болды деп ойлаймын...
Dialogue: 0,0:05:07.37,0:05:09.30,Default,,0,0,0,,Келісім сәтсіз аяқталды➡
Dialogue: 0,0:05:09.30,0:05:12.21,Default,,0,0,0,,Стефан Америкаға барып, қайтып оралмады.
Dialogue: 0,0:05:12.21,0:05:15.01,Default,,0,0,0,,Бірдеңе қорқынышты болуы керек.
Dialogue: 0,0:05:15.01,0:05:17.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:17.58,0:05:21.58,Default,,0,0,0,,Немесе бұл күтпеген тривиальды нәрсе болуы мүмкін. (Дора Дэви) Ахха!
Dialogue: 0,0:05:23.29,0:05:25.22,Default,,0,0,0,,Жақсарту жиналысына баратын кез келді.
Dialogue: 0,0:05:25.22,0:05:28.26,Default,,0,0,0,,Линдтің тәтесіне Лаванда мырза туралы айтпа.
Dialogue: 0,0:05:28.26,0:05:31.49,Default,,0,0,0,,Мен айтпаймын. Өйткені Томас өзін жақсы сезінбейді➡
Dialogue: 0,0:05:31.49,0:05:34.10,Default,,0,0,0,,Менің ойымша, Рейчел де олай болмайды.
Dialogue: 0,0:05:34.10,0:05:36.33,Default,,0,0,0,,Бұл Дэви!
Dialogue: 0,0:05:36.33,0:05:38.27,Default,,0,0,0,,О, бұл өте жақсы! Жыланбалық сияқты➡
Dialogue: 0,0:05:38.27,0:05:40.70,Default,,0,0,0,,Денеңізді бұлдырмаңыз!
Dialogue: 0,0:05:40.70,0:05:43.07,Default,,0,0,0,,<Мен және Диана➡
Dialogue: 0,0:05:43.07,0:05:46.94,Default,,0,0,0,,Осыдан кейін мен Ямабикосоға талай рет бардым＞
Dialogue: 0,0:05:46.94,0:05:49.81,Default,,0,0,0,,Уфуфуфуфуфу.
Dialogue: 0,0:05:49.81,0:05:51.75,Default,,0,0,0,,<Диана бармайтын күндерде➡
Dialogue: 0,0:05:51.75,0:05:54.45,Default,,0,0,0,,Мен жалғыз болсам да...>
Dialogue: 0,0:05:56.28,0:05:58.22,Default,,0,0,0,,Лаванда мырза!
Dialogue: 0,0:05:58.22,0:06:01.42,Default,,0,0,0,,А... а... а Анн! ➡
Dialogue: 0,0:06:01.42,0:06:03.93,Default,,0,0,0,,Сенің келетініңе сенімді едім!
Dialogue: 0,0:06:05.96,0:06:09.00,Default,,0,0,0,,Шарлотта IV бүгін түнде қайтып келмейді.
Dialogue: 0,0:06:09.00,0:06:13.70,Default,,0,0,0,,Сен келмегенде, мен өте жалғыз түнді өткізер едім.
Dialogue: 0,0:06:13.70,0:06:18.54,Default,,0,0,0,,Мен Мариллаға бүгін Ямабико-сода болатынымды айттым.
Dialogue: 0,0:06:18.54,0:06:20.98,Default,,0,0,0,,Хехехе… Біраз мақтанып қояйын
Dialogue: 0,0:06:20.98,0:06:25.75,Default,,0,0,0,,Мен қуаныштымын, Энн. Сіз қаншалықты әдемісіз?
Dialogue: 0,0:06:25.75,0:06:27.68,Default,,0,0,0,,Хехе.
Dialogue: 0,0:06:27.68,0:06:32.55,Default,,0,0,0,,Шарлотта IV төрт апалы-сіңлілілердің ең кенжесі.
Dialogue: 0,0:06:32.55,0:06:35.42,Default,,0,0,0,,Сіздің шын есіміңіз кім?
Dialogue: 0,0:06:35.42,0:06:37.69,Default,,0,0,0,,Хмм... Леонора!
Dialogue: 0,0:06:37.69,0:06:40.23,Default,,0,0,0,,Шарлотта IV Леонора ма?
Dialogue: 0,0:06:40.23,0:06:44.70,Default,,0,0,0,,«Шарлотта» – менің үлкен әпкемнің аты.
Dialogue: 0,0:06:44.70,0:06:49.27,Default,,0,0,0,,Ол маған 16 жасыма дейін осы үйде көмектесті➡
Dialogue: 0,0:06:49.27,0:06:52.17,Default,,0,0,0,,Келесі келген сіңлісі... Мм...➡
Dialogue: 0,0:06:52.17,0:06:56.71,Default,,0,0,0,,Иә! Джульетта әпкесіне қатты ұқсайды➡
Dialogue: 0,0:06:56.71,0:06:59.92,Default,,0,0,0,,Мен оны қателесіп Шарлотта деп атадым.
Dialogue: 0,0:06:59.92,0:07:02.25,Default,,0,0,0,,А... Джульетта да бәрібір.
Dialogue: 0,0:07:02.25,0:07:07.99,Default,,0,0,0,,Мен шын есімімді есте сақтаудан бас тарттым және оны Шарлотта II деп атауға шешім қабылдадым.
Dialogue: 0,0:07:07.99,0:07:12.83,Default,,0,0,0,,Одан кейін Эвалина келді, бұл Шарлотта III.
Dialogue: 0,0:07:12.83,0:07:15.76,Default,,0,0,0,,Енді ол Шарлотта IV болды.
Dialogue: 0,0:07:15.76,0:07:17.97,Default,,0,0,0,,Хэхе...хехе! иә?
Dialogue: 0,0:07:17.97,0:07:20.67,Default,,0,0,0,,Хэхе! (Лаванда) Мен біртүрлі нәрсе айттым ба?
Dialogue: 0,0:07:20.67,0:07:24.47,Default,,0,0,0,,Ух...хехехехе!
Dialogue: 0,0:07:24.47,0:07:26.44,Default,,0,0,0,,(жанып жатқан ағаштың дыбысы)
Dialogue: 0,0:07:26.44,0:07:28.78,Default,,0,0,0,,Стивен Ирвинг екеуміз ше?
Dialogue: 0,0:07:28.78,0:07:32.35,Default,,0,0,0,,Иә. Сені құда түсіпті деп естідім.
Dialogue: 0,0:07:32.35,0:07:35.88,Default,,0,0,0,,А... той көйлегі де бітті.
Dialogue: 0,0:07:35.88,0:07:39.59,Default,,0,0,0,,Бұл қазірдің өзінде... 25 жыл бұрын. ➡
Dialogue: 0,0:07:39.59,0:07:45.39,Default,,0,0,0,,Жоқ... Жас кезімізден құда болдық деп те айтуға болады.
Dialogue: 0,0:07:47.10,0:07:50.00,Default,,0,0,0,,Менде 6, ал оның 9...
Dialogue: 0,0:07:50.00,0:07:52.00,Default,,0,0,0,,Реминисценция (Стивен Ирвинг) Ха ха-ха! ➡
Dialogue: 0,0:07:52.00,0:07:56.24,Default,,0,0,0,,О! (Лаванда Льюис) Ах! а….
Dialogue: 0,0:07:56.24,0:07:58.17,Default,,0,0,0,,Ху... хехе.
Dialogue: 0,0:07:58.17,0:08:01.08,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:08:01.08,0:08:04.55,Default,,0,0,0,,Ол мұны екінші рет кездескенімізде айтты. ➡
Dialogue: 0,0:08:04.55,0:08:08.35,Default,,0,0,0,,Ол өскенде саған үйленемін деді.
Dialogue: 0,0:08:08.35,0:08:11.99,Default,,0,0,0,,Мен: «Рахмет» деп жауап бердім.
Dialogue: 0,0:08:11.99,0:08:14.46,Default,,0,0,0,,Бірақ... а....
Dialogue: 0,0:08:14.46,0:08:17.36,Default,,0,0,0,,Біз құда түскеннен кейін біраз уақыттан кейін➡
Dialogue: 0,0:08:17.36,0:08:21.30,Default,,0,0,0,,Бізде өте жиі кездесетін және ақымақ пікірталас болды. ➡
Dialogue: 0,0:08:21.30,0:08:24.47,Default,,0,0,0,,Ол сезімтал, сезімтал адам. ➡
Dialogue: 0,0:08:24.47,0:08:29.00,Default,,0,0,0,,Менің ақымақ болғаным сонша, байсалды жігітімді ашуландырдым. ➡
Dialogue: 0,0:08:29.00,0:08:35.31,Default,,0,0,0,,Бір күні Стефан татуласу үшін маған қонаққа келді.
Dialogue: 0,0:08:37.38,0:08:40.58,Default,,0,0,0,,Біз жеңіске жеттік!!
Dialogue: 0,0:08:40.58,0:08:43.99,Default,,0,0,0,,Олар тыңдаудан бас тартты.
Dialogue: 0,0:08:46.22,0:08:52.03,Default,,0,0,0,,Осылайша Стефан мәңгілікке кетті.
Dialogue: 0,0:08:54.93,0:09:00.10,Default,,0,0,0,,«Қайтып келші» деп айта алсам ғой... ➡
Dialogue: 0,0:09:00.10,0:09:03.97,Default,,0,0,0,,Бірақ ол жұмыс істемеді. Бұл менмендік болды. ➡
Dialogue: 0,0:09:03.97,0:09:07.51,Default,,0,0,0,,Стефанға тұрмысқа шыға алмасам➡
Dialogue: 0,0:09:07.51,0:09:10.31,Default,,0,0,0,,Мен өмір бойы бойдақ қаламын деп ойладым.
Dialogue: 0,0:09:10.31,0:09:12.71,Default,,0,0,0,,А... Энн?
Dialogue: 0,0:09:14.52,0:09:17.52,Default,,0,0,0,,Кешіріңіз, мен...
Dialogue: 0,0:09:20.32,0:09:26.13,Default,,0,0,0,,Сіз небәрі 17 жастасыз. Бірақ олай мұңайма. ➡
Dialogue: 0,0:09:26.13,0:09:30.00,Default,,0,0,0,,Сол кезде жүрегім жарылып кететіндей болғаны рас, бірақ➡
Dialogue: 0,0:09:30.00,0:09:33.57,Default,,0,0,0,,Өмір сені бақытсыз қалдырмайды.
Dialogue: 0,0:09:33.57,0:09:35.50,Default,,0,0,0,,Сезімталдыққа батқанмен➡
Dialogue: 0,0:09:35.50,0:09:39.67,Default,,0,0,0,,Мен осылай бақытты өмір сүріп жатырмын. ➡
Dialogue: 0,0:09:39.67,0:09:43.78,Default,,0,0,0,,Түс көріп, Ямабико мен кәмпиттен ләззат алу кезінде.
Dialogue: 0,0:09:47.25,0:09:49.75,Default,,0,0,0,,Сіз мұнда алғаш келген күн➡
Dialogue: 0,0:09:49.75,0:09:52.12,Default,,0,0,0,,Стефанның баласын тыңдаңыз➡
Dialogue: 0,0:09:52.12,0:09:54.36,Default,,0,0,0,,Мен таң қалдым, Энн.
Dialogue: 0,0:09:54.36,0:09:56.79,Default,,0,0,0,,Сіз қандай баласыз?
Dialogue: 0,0:09:56.79,0:10:00.20,Default,,0,0,0,,Ол өте сүйкімді, мейірімді бала.
Dialogue: 0,0:10:01.96,0:10:03.90,Default,,0,0,0,,Мен сенімен танысқым келеді.
Dialogue: 0,0:10:03.90,0:10:06.37,Default,,0,0,0,,Бала мұнда мәңгі өмір сүрді➡
Dialogue: 0,0:10:06.37,0:10:09.34,Default,,0,0,0,,«Армандағы балаға» ұқсайды ма? ➡
Dialogue: 0,0:10:09.34,0:10:12.47,Default,,0,0,0,,Балама.
Dialogue: 0,0:10:12.47,0:10:16.34,Default,,0,0,0,,...Мен сені бір күні осында әкелемін.
Dialogue: 0,0:10:16.34,0:10:18.68,Default,,0,0,0,,Шынымен бе? Иә.
Dialogue: 0,0:10:18.68,0:10:23.08,Default,,0,0,0,,Асықпаудың қажеті жоқ. Психикалық дайындықты қажет ететін нәрсе. Хехе.
Dialogue: 0,0:10:23.08,0:10:26.39,Default,,0,0,0,,Жүрегімдегі үн А... тағы да бейқам болған жоқпын ба?
Dialogue: 0,0:10:26.39,0:10:29.62,Default,,0,0,0,,Еске түсіру Бұлай еліктегіш болма.
Dialogue: 0,0:10:29.62,0:10:32.06,Default,,0,0,0,,Жүрегімнің үні: Мен Мариллаға үндемеймін. ➡
Dialogue: 0,0:10:32.06,0:10:34.30,Default,,0,0,0,,Павелде…➡
Dialogue: 0,0:10:34.30,0:10:37.60,Default,,0,0,0,,Мен Пауылға не айтуым керек?
Dialogue: 0,0:10:42.54,0:10:46.31,Default,,0,0,0,,Неліктен ол ханым менімен кездескісі келеді?
Dialogue: 0,0:10:46.31,0:10:48.28,Default,,0,0,0,,Біз сияқты➡
Dialogue: 0,0:10:48.28,0:10:51.28,Default,,0,0,0,,Лаванда-сан да көп нәрсені елестететін адам.
Dialogue: 0,0:10:51.28,0:10:53.45,Default,,0,0,0,,Пауыл да➡
Dialogue: 0,0:10:53.45,0:10:56.15,Default,,0,0,0,,Менің ойымша, сіз менімен сөйлескіңіз келеді.
Dialogue: 0,0:10:56.15,0:10:59.19,Default,,0,0,0,,Дұрыс. Мен оны асыға күтемін!
Dialogue: 0,0:10:59.19,0:11:01.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:05.56,0:11:07.50,Default,,0,0,0,,Қош келдің.
Dialogue: 0,0:11:07.50,0:11:10.53,Default,,0,0,0,,Бұл Павел. Бұл лаванда.
Dialogue: 0,0:11:10.53,0:11:12.77,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:11:12.77,0:11:15.77,Default,,0,0,0,,Ах... иә Сәлем.
Dialogue: 0,0:11:20.28,0:11:24.15,Default,,0,0,0,,Сіз... әкеңізге ұқсайсыз.
Dialogue: 0,0:11:24.15,0:11:26.81,Default,,0,0,0,,Иә. үшін солай айтады.
Dialogue: 0,0:11:26.81,0:11:29.98,Default,,0,0,0,,Сіз менің әкемді білесіз бе?
Dialogue: 0,0:11:29.98,0:11:32.39,Default,,0,0,0,,Иә... баяғыда.
Dialogue: 0,0:11:32.39,0:11:34.39,Default,,0,0,0,,<Бұл кездесу күтпеген болды➡
Dialogue: 0,0:11:34.39,0:11:37.73,Default,,0,0,0,,Лаванда-сан ауруын тудыратыныма сене алар емеспін➡
Dialogue: 0,0:11:37.73,0:11:41.43,Default,,0,0,0,,Мен оны елестете де алмадым>
Dialogue: 0,0:11:43.67,0:11:48.07,Default,,0,0,0,,♬～
Dialogue: 0,0:11:49.40,0:11:51.64,Default,,0,0,0,,♬～
Dialogue: 0,0:11:51.64,0:11:54.28,Default,,0,0,0,,Осыдан кейін Лаванда мен Пол➡
Dialogue: 0,0:11:54.28,0:11:57.75,Default,,0,0,0,,Біз оны бірден алдық. Бұл дұрыс.
Dialogue: 0,0:11:57.75,0:12:02.65,Default,,0,0,0,,Мен бұл үйдің неліктен «Ямабикосо» деп аталатынын да білдім.
Dialogue: 0,0:12:02.65,0:12:04.65,Default,,0,0,0,,Реминисценция (тыныс алу дыбысы) (мүйіз)
Dialogue: 0,0:12:04.65,0:12:06.79,Default,,0,0,0,,(мүйіз)
Dialogue: 0,0:12:06.79,0:12:09.79,Default,,0,0,0,,(Ямабико мүйіз)
Dialogue: 0,0:12:09.79,0:12:12.23,Default,,0,0,0,,Мен және Шарлотта IV➡
Dialogue: 0,0:12:12.23,0:12:15.66,Default,,0,0,0,,Мен осында жиі отырамын және Ямабикодан ләззат аламын.
Dialogue: 0,0:12:15.66,0:12:18.20,Default,,0,0,0,,Ха... Yahoo!
Dialogue: 0,0:12:18.20,0:12:21.14,Default,,0,0,0,,...
Dialogue: 0,0:12:21.14,0:12:23.14,Default,,0,0,0,,Жақсы жұмыс.
Dialogue: 0,0:12:23.14,0:12:25.27,Default,,0,0,0,,Ахахаха. Бұл таңқаларлық Пол.
Dialogue: 0,0:12:25.27,0:12:28.18,Default,,0,0,0,,Сонымен, Пауыл үйіне қайтып бара жатыр еді➡
Dialogue: 0,0:12:28.18,0:12:31.71,Default,,0,0,0,,«Сен мені сүйе аласың», - дедім мен Лавандаға.
Dialogue: 0,0:12:31.71,0:12:35.48,Default,,0,0,0,,Иә!? Әрине, қоштасу.
Dialogue: 0,0:12:35.48,0:12:37.79,Default,,0,0,0,,(сүю дыбысы)
Dialogue: 0,0:12:37.79,0:12:41.29,Default,,0,0,0,,Мен сені сүйгім келетінін қайдан білдің?
Dialogue: 0,0:12:41.29,0:12:46.16,Default,,0,0,0,,Өйткені апам маған анамның көзімен қарап отырды.
Dialogue: 0,0:12:46.16,0:12:48.16,Default,,0,0,0,,Не? а….
Dialogue: 0,0:12:48.16,0:12:51.70,Default,,0,0,0,,Лаванда мырза, қаласаңыз➡
Dialogue: 0,0:12:51.70,0:12:54.60,Default,,0,0,0,,Сен де менің досым боласың ба?
Dialogue: 0,0:12:54.60,0:12:58.51,Default,,0,0,0,,О... иә... әрине Пол.
Dialogue: 0,0:12:58.51,0:13:02.68,Default,,0,0,0,,Мұғалім. Мен сол кемпірді жақсы көремін.
Dialogue: 0,0:13:02.68,0:13:06.18,Default,,0,0,0,,Ол адамның маған қалай қарайтыны➡
Dialogue: 0,0:13:06.18,0:13:11.05,Default,,0,0,0,,Ал мына тас үй және Шарлотта IV!
Dialogue: 0,0:13:11.05,0:13:14.96,Default,,0,0,0,,Мен Павелге не айтарымды білмедім.
Dialogue: 0,0:13:14.96,0:13:19.19,Default,,0,0,0,,Болашағы жоқ әңгіме сияқты.
Dialogue: 0,0:13:19.19,0:13:22.03,Default,,0,0,0,,Маңызды сұрақ.
Dialogue: 0,0:13:22.03,0:13:23.97,Default,,0,0,0,,Анна Гилбертті ұната ма?
Dialogue: 0,0:13:23.97,0:13:26.57,Default,,0,0,0,,Мен сені дос ретінде жақсы көремін.
Dialogue: 0,0:13:26.57,0:13:29.57,Default,,0,0,0,,Бірақ егер бұл Диананың ойындағысын білдірсе➡
Dialogue: 0,0:13:29.57,0:13:31.71,Default,,0,0,0,,Жауабы жоқ.
Dialogue: 0,0:13:31.71,0:13:34.94,Default,,0,0,0,,Диана, сен менің идеалды типімді білесің, солай ма?
Dialogue: 0,0:13:34.94,0:13:37.48,Default,,0,0,0,,Хехе. Жіңішке және биік➡
Dialogue: 0,0:13:37.48,0:13:41.95,Default,,0,0,0,,Мұңға толы сырлы көздерімен кербез жүз.
Dialogue: 0,0:13:41.95,0:13:45.92,Default,,0,0,0,,Және балқыған нәзік дауыс.
Dialogue: 0,0:13:45.92,0:13:50.06,Default,,0,0,0,,Осындай адам пайда болса екен.
Dialogue: 0,0:13:50.06,0:13:52.99,Default,,0,0,0,,Бірақ идеалдар өзгеруі мүмкін.
Dialogue: 0,0:13:52.99,0:13:57.70,Default,,0,0,0,,Шынымен! Фред Райт Диананың идеал түрі емес.
Dialogue: 0,0:13:57.70,0:14:01.34,Default,,0,0,0,,Ах...! Бірақ менің идеалдарым өзгерген жоқ.
Dialogue: 0,0:14:01.34,0:14:05.21,Default,,0,0,0,,Егер сіз өзіңіздің идеалды серіктесіңізді кездестірмесеңіз не істер едіңіз?
Dialogue: 0,0:14:05.21,0:14:08.11,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:14:08.11,0:14:10.04,Default,,0,0,0,,Еске алу (Лаванда дауысы) Өмір бұл ➡
Dialogue: 0,0:14:10.04,0:14:12.65,Default,,0,0,0,,Адамдарды бақытсыз қалдырмаңыз.
Dialogue: 0,0:14:12.65,0:14:15.62,Default,,0,0,0,,Сонда мен бойдақ өлемін.
Dialogue: 0,0:14:15.62,0:14:19.75,Default,,0,0,0,,Менің ойымша, бұл жаман нәрсе емес.
Dialogue: 0,0:14:19.75,0:14:24.59,Default,,0,0,0,,Жарайды! Аннамен сіз өзіңіздің идеалды серіктесіңізді кездестіретініңізге сенімдімін.
Dialogue: 0,0:14:24.59,0:14:27.30,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:14:30.26,0:14:34.14,Default,,0,0,0,,(Қарлыған мүйіз)
Dialogue: 0,0:14:34.14,0:14:38.61,Default,,0,0,0,,Күрсіну…. Мен Шарлотта IV сияқты жақсы ойнай алмаймын.
Dialogue: 0,0:14:38.61,0:14:42.48,Default,,0,0,0,,Жоқ, сіз бірінші таймер үшін өте жақсысыз.
Dialogue: 0,0:14:42.48,0:14:45.48,Default,,0,0,0,,Бойыңыз әлдеқайда өсті, солай емес пе? полюс.
Dialogue: 0,0:14:45.48,0:14:49.28,Default,,0,0,0,,Мен көп жеп, әкемдей өсуді жоспарлап отырмын. ➡
Dialogue: 0,0:14:49.28,0:14:52.52,Default,,0,0,0,,Әкемнің бойы шамамен 6 фут.
Dialogue: 0,0:14:52.52,0:14:55.36,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:55.36,0:14:58.39,Default,,0,0,0,,(Қарлыған мүйіз)
Dialogue: 0,0:14:58.39,0:15:00.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:00.33,0:15:02.70,Default,,0,0,0,,Хмм….
Dialogue: 0,0:15:02.70,0:15:05.47,Default,,0,0,0,,Не болды? Шарлотта.
Dialogue: 0,0:15:05.47,0:15:09.90,Default,,0,0,0,,Негізі Лаванда-сама өзін жақсы сезінбейді.
Dialogue: 0,0:15:09.90,0:15:11.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:11.91,0:15:14.61,Default,,0,0,0,,Пол Бочама мұнда алғаш келгеннен бері...
Dialogue: 0,0:15:14.61,0:15:16.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:16.54,0:15:19.08,Default,,0,0,0,,Ол үнемі шаршаған және жалғыз көрінеді➡
Dialogue: 0,0:15:19.08,0:15:22.68,Default,,0,0,0,,Қонақтарды қиялмен де қуантпаймыз.
Dialogue: 0,0:15:22.68,0:15:24.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:24.62,0:15:26.92,Default,,0,0,0,,Маған неге олай қарап тұрсың?
Dialogue: 0,0:15:26.92,0:15:29.26,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:15:29.26,0:15:33.83,Default,,0,0,0,,Саған қарасам, өткен күн есіме түседі.
Dialogue: 0,0:15:33.83,0:15:36.60,Default,,0,0,0,,Нағашың жас кезінде солай ма?
Dialogue: 0,0:15:36.60,0:15:41.34,Default,,0,0,0,,Хехехе, дұрыс айтасың, мен кемпір сияқтымын.
Dialogue: 0,0:15:41.34,0:15:43.40,Default,,0,0,0,,Хмм, мен білмеймін.
Dialogue: 0,0:15:43.40,0:15:46.64,Default,,0,0,0,,Оның шашының түсі кемпірге ұқсайды➡
Dialogue: 0,0:15:46.64,0:15:50.11,Default,,0,0,0,,Күлімсірегенде, сіз профессор Энн сияқты жас көрінесіз.
Dialogue: 0,0:15:50.11,0:15:52.05,Default,,0,0,0,,Хехе.
Dialogue: 0,0:15:52.05,0:15:54.32,Default,,0,0,0,,Хехе, апам ана атанса да➡
Dialogue: 0,0:15:54.32,0:15:56.88,Default,,0,0,0,,Менің ойымша, бұл тамаша.
Dialogue: 0,0:15:58.65,0:16:00.66,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:16:00.66,0:16:02.89,Default,,0,0,0,,Хэхе...➡
Dialogue: 0,0:16:02.89,0:16:04.89,Default,,0,0,0,,Оның... Лаванда-сан➡
Dialogue: 0,0:16:04.89,0:16:07.66,Default,,0,0,0,,Сенің менің анам сияқты көздерің бар!
Dialogue: 0,0:16:07.66,0:16:10.67,Default,,0,0,0,,Себебі мен істеймін!
Dialogue: 0,0:16:10.67,0:16:13.13,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:16:18.61,0:16:23.81,Default,,0,0,0,,Қалай ойлайсыз, Пол Лаванда мырзамен кездеспегені дұрыс па?
Dialogue: 0,0:16:23.81,0:16:26.08,Default,,0,0,0,,Енді не айтып тұрсың? ➡
Dialogue: 0,0:16:26.08,0:16:29.95,Default,,0,0,0,,Менің ойымша, бұл Лаванда сізді кездестіргісі келді.
Dialogue: 0,0:16:29.95,0:16:32.19,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:16:32.19,0:16:34.12,Default,,0,0,0,,Менің жүрегімдегі дауыс, Лаванда туралы бірдеңе➡
Dialogue: 0,0:16:34.12,0:16:36.39,Default,,0,0,0,,Көңіліңді көтерудің жолы бар ма екен...
Dialogue: 0,0:16:36.39,0:16:38.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.30,0:16:46.07,Default,,0,0,0,,♬～
Dialogue: 0,0:16:48.50,0:16:50.84,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:50.84,0:16:54.64,Default,,0,0,0,,♬～
Dialogue: 0,0:16:54.64,0:16:57.08,Default,,0,0,0,,Мен қаншалықты жеңілмін?
Dialogue: 0,0:16:57.08,0:17:00.95,Default,,0,0,0,,Жаңа көйлек тігіп жатқаныма қатты толқыдым.
Dialogue: 0,0:17:00.95,0:17:03.02,Default,,0,0,0,,Хэхехе!
Dialogue: 0,0:17:08.12,0:17:11.99,Default,,0,0,0,,Жүрек үні Сене алар емеспін Павел екі күн қатарынан демалыс алды...
Dialogue: 0,0:17:11.99,0:17:16.66,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:17:16.66,0:17:19.40,Default,,0,0,0,,Мен оның осында екеніне сенімдімін...
Dialogue: 0,0:17:19.40,0:17:22.27,Default,,0,0,0,,(ағаш кесу дыбысы)
Dialogue: 0,0:17:22.27,0:17:25.91,Default,,0,0,0,,Иә? Ах! Мұғалім Анна!
Dialogue: 0,0:17:25.91,0:17:27.84,Default,,0,0,0,,Сәлем Павел.
Dialogue: 0,0:17:27.84,0:17:30.48,Default,,0,0,0,,Ұстаз, менің әкем Америкадан келді!
Dialogue: 0,0:17:30.48,0:17:32.41,Default,,0,0,0,,Ах…. Әке! ➡
Dialogue: 0,0:17:32.41,0:17:35.62,Default,,0,0,0,,Бұл мұғалім Энн! Ол менің ұстазым!
Dialogue: 0,0:17:35.62,0:17:37.92,Default,,0,0,0,,Жүрек үні Павелдің әкесі. ➡
Dialogue: 0,0:17:37.92,0:17:42.62,Default,,0,0,0,,Ал... Лаванда ханзадасы...
Dialogue: 0,0:17:42.62,0:17:44.56,Default,,0,0,0,,Пауылдың хаттарында ➡
Dialogue: 0,0:17:44.56,0:17:46.59,Default,,0,0,0,,Сіз туралы үнемі бірдеңе жазылады.
Dialogue: 0,0:17:46.59,0:17:50.50,Default,,0,0,0,,Мен бір-бірімізді бұрыннан білетіндей сезінемін. ➡
Dialogue: 0,0:17:50.50,0:17:54.64,Default,,0,0,0,,Ширли, сен әрқашан Полға мейірімді болдың➡
Dialogue: 0,0:17:54.64,0:17:56.57,Default,,0,0,0,,Рахмет. ➡
Dialogue: 0,0:17:56.57,0:18:01.84,Default,,0,0,0,,Ең бастысы, сіз бұл балаға қажетті нұсқаулықты бердіңіз. ➡
Dialogue: 0,0:18:01.84,0:18:03.84,Default,,0,0,0,,Мен шынымен ризамын. ➡
Dialogue: 0,0:18:03.84,0:18:08.08,Default,,0,0,0,,Пол, әжеңе шай дайындап беруін сұрай аласыз ба?
Dialogue: 0,0:18:08.08,0:18:10.38,Default,,0,0,0,,Иә! Хехе. ➡
Dialogue: 0,0:18:10.38,0:18:12.32,Default,,0,0,0,,Әже!
Dialogue: 0,0:18:12.32,0:18:16.76,Default,,0,0,0,,Хатта Ямабикосоға бірге барғандары айтылған.
Dialogue: 0,0:18:16.76,0:18:18.69,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:18:18.69,0:18:23.66,Default,,0,0,0,,Сіз оған жақынсыз ба? Иә, біз өте жақын доспыз.
Dialogue: 0,0:18:23.66,0:18:27.17,Default,,0,0,0,,Сонымен, сіз қаншалықты білесіз?
Dialogue: 0,0:18:27.17,0:18:29.80,Default,,0,0,0,,Мен және ол туралы.
Dialogue: 0,0:18:29.80,0:18:33.67,Default,,0,0,0,,Мен бәрін толық білемін.
Dialogue: 0,0:18:33.67,0:18:36.28,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:36.28,0:18:39.18,Default,,0,0,0,,♬～
Dialogue: 0,0:18:39.18,0:18:41.15,Default,,0,0,0,,Стефан қайтып келді.
Dialogue: 0,0:18:41.15,0:18:44.02,Default,,0,0,0,,А... мұны кім естіді?
Dialogue: 0,0:18:44.02,0:18:48.42,Default,,0,0,0,,Сенің жүзің мен сөйлеген сөзің мені солай ойлады.
Dialogue: 0,0:18:48.42,0:18:50.36,Default,,0,0,0,,Ирвинг мырза➡
Dialogue: 0,0:18:50.36,0:18:53.29,Default,,0,0,0,,Ол Лаванда мырзамен кездескісі келеді.
Dialogue: 0,0:18:53.29,0:18:56.03,Default,,0,0,0,,(Есік ашылған дыбыс) (Recovery Girl) Қарым-қатынас дағдылары
Dialogue: 0,0:18:56.03,0:18:58.07,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:18:58.07,0:19:01.84,Default,,0,0,0,,Стефан ескі досы ретінде қонаққа келеді.
Dialogue: 0,0:19:01.84,0:19:05.44,Default,,0,0,0,,Бас тартуға ешқандай себеп жоқ.
Dialogue: 0,0:19:05.44,0:19:07.68,Default,,0,0,0,,Жүрек үні Ирвинг мырза әлі де➡
Dialogue: 0,0:19:07.68,0:19:12.01,Default,,0,0,0,,Мен Лаванда мырзаны жақсы көремін. Бұған күмән жоқ. ➡
Dialogue: 0,0:19:12.01,0:19:15.88,Default,,0,0,0,,Лаванда мырза да...
Dialogue: 0,0:19:15.88,0:19:23.46,Default,,0,0,0,,♬～
Dialogue: 0,0:19:23.46,0:19:25.39,Default,,0,0,0,,(қақпаның ашылған дыбысы)
Dialogue: 0,0:19:25.39,0:19:31.37,Default,,0,0,0,,Бұл үй мен бақша осыдан 25 жыл бұрынғыдай.
Dialogue: 0,0:19:37.71,0:19:39.67,Default,,0,0,0,,Күте тұрыңыз. ➡
Dialogue: 0,0:19:39.67,0:19:42.48,Default,,0,0,0,,Лаванда-сама жақында келеді.
Dialogue: 0,0:19:42.48,0:19:44.71,Default,,0,0,0,,Иә? (аяқ дыбыстары)
Dialogue: 0,0:19:44.71,0:19:46.98,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:46.98,0:19:48.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:48.98,0:19:54.62,Default,,0,0,0,,♬～
Dialogue: 0,0:19:54.62,0:19:57.06,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:19:57.06,0:20:05.77,Default,,0,0,0,,♬～
Dialogue: 0,0:20:05.77,0:20:09.67,Default,,0,0,0,,Қараңыз. Ол қазірдің өзінде ақ шашы бар кемпір.
Dialogue: 0,0:20:09.67,0:20:14.81,Default,,0,0,0,,♬～
Dialogue: 0,0:20:14.81,0:20:17.51,Default,,0,0,0,,Ирвинг және Лаванда мырза➡
Dialogue: 0,0:20:17.51,0:20:22.32,Default,,0,0,0,,Сіз үйленесіз бе? Иә, қызық.
Dialogue: 0,0:20:22.32,0:20:24.75,Default,,0,0,0,,Мен сені көптен бері уайымдап жүрмін.
Dialogue: 0,0:20:24.75,0:20:28.16,Default,,0,0,0,,16-ға толып, осы жерден кететін күн келгенде➡
Dialogue: 0,0:20:28.16,0:20:30.42,Default,,0,0,0,,Лаванда-сама жалғыз қалады...
Dialogue: 0,0:20:30.42,0:20:32.36,Default,,0,0,0,,Үміт болу керек.
Dialogue: 0,0:20:32.36,0:20:34.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:34.40,0:20:37.20,Default,,0,0,0,,Үйге ерте келгеніңізге сене алар емеспін...
Dialogue: 0,0:20:37.20,0:20:40.20,Default,,0,0,0,,Аа... Бұл жұмыс істемегеніне сенімдімін... ➡
Dialogue: 0,0:20:40.20,0:20:42.44,Default,,0,0,0,,Бітті...
Dialogue: 0,0:20:42.44,0:20:45.41,Default,,0,0,0,,Шарлоттаға қара. иә...?
Dialogue: 0,0:20:45.41,0:20:48.24,Default,,0,0,0,,♬～
Dialogue: 0,0:20:48.24,0:20:50.21,Default,,0,0,0,,А... Анна ханым!
Dialogue: 0,0:20:50.21,0:20:54.05,Default,,0,0,0,,Бұл үйлену туралы ұсыныс болса керек!
Dialogue: 0,0:20:54.05,0:20:57.69,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:20:57.69,0:21:01.59,Default,,0,0,0,,Мен пайғамбар емеспін, бірақ мен бұл жерде болжам жасаймын.
Dialogue: 0,0:21:01.59,0:21:03.89,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:21:03.89,0:21:06.29,Default,,0,0,0,,Үйеңкілер түсі өзгермес бұрын➡
Dialogue: 0,0:21:06.29,0:21:08.53,Default,,0,0,0,,Мына ескі тас үйде➡
Dialogue: 0,0:21:08.53,0:21:10.56,Default,,0,0,0,,Кейбір ерекше рәсім➡
Dialogue: 0,0:21:10.56,0:21:12.70,Default,,0,0,0,,Ол өткізіледі.
Dialogue: 0,0:21:12.70,0:21:16.57,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:21:16.57,0:21:19.97,Default,,0,0,0,,Бұл нені білдіретінін түсінесіз бе? Шарлотта.
Dialogue: 0,0:21:19.97,0:21:22.94,Default,,0,0,0,,Иә... Иә, түсіндім... ➡
Dialogue: 0,0:21:22.94,0:21:26.45,Default,,0,0,0,,Неге жылайсың?
Dialogue: 0,0:21:26.45,0:21:29.08,Default,,0,0,0,,Неге...
Dialogue: 0,0:21:29.08,0:21:32.92,Default,,0,0,0,,Бәрі де әдемі, ертегідей➡
Dialogue: 0,0:21:32.92,0:21:34.89,Default,,0,0,0,,Романтикалық…➡
Dialogue: 0,0:21:34.89,0:21:39.26,Default,,0,0,0,,Өкінішті...
Dialogue: 0,0:21:39.26,0:21:44.77,Default,,0,0,0,,♬～
Dialogue: 0,0:21:44.77,0:21:48.74,Default,,0,0,0,,Лаванда-сан өте мейірімді адам. ➡
Dialogue: 0,0:21:48.74,0:21:53.37,Default,,0,0,0,,Анаммен де кездессек, жақсы араласар едік деген сенімдемін. ➡
Dialogue: 0,0:21:53.37,0:21:56.28,Default,,0,0,0,,Сосын, анашым. ➡
Dialogue: 0,0:21:56.28,0:22:01.55,Default,,0,0,0,,Мен сені әрқашан жақсы көрдім.
Dialogue: 0,0:22:05.29,0:22:14.96,Default,,0,0,0,,♬～
Dialogue: 0,0:22:14.96,0:22:17.83,Default,,0,0,0,,♬ «Маңыздысы»
Dialogue: 0,0:22:17.83,0:22:24.97,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.97,0:22:29.64,Default,,0,0,0,,♬ «Білмей тұрып өтетін қала»
Dialogue: 0,0:22:29.64,0:22:34.85,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.85,0:22:39.69,Default,,0,0,0,,♬ «Таң жарқыраған таңға»
Dialogue: 0,0:22:39.69,0:22:44.63,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.63,0:22:51.73,Default,,0,0,0,,♬ «Мен аңсаған дүние менің қабақтың сыртында»
Dialogue: 0,0:22:51.73,0:22:55.74,Default,,0,0,0,,♬ «Мен оны тауып алып, сонда бара аламын».
Dialogue: 0,0:22:55.74,0:23:00.88,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.88,0:23:06.05,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.05,0:23:10.62,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.62,0:23:15.59,Default,,0,0,0,,♬ «Менің сезгенім бәрі болды».
Dialogue: 0,0:23:15.59,0:23:24.27,Default,,0,0,0,,♬ «Жүрегің қалаған жолмен жүр».
Dialogue: 0,0:23:24.27,0:23:29.50,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.50,0:23:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.41,0:23:57.10,Default,,0,0,0,,♬～
