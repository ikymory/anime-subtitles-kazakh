Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:03.17,Default,,0,0,0,,<Дэйви мен Дора➡
Dialogue: 0,0:00:03.17,0:00:05.23,Default,,0,0,0,,Green Gables-ке келу➡
Dialogue: 0,0:00:05.23,0:00:08.47,Default,,0,0,0,,10 ай болды. ➡
Dialogue: 0,0:00:08.47,0:00:11.37,Default,,0,0,0,,Екеуміз үйге үйреніп жатқан кезіміз➡
Dialogue: 0,0:00:11.37,0:00:15.38,Default,,0,0,0,,Мен жақында келген адам туралы керемет жаңалық алдым.＞
Dialogue: 0,0:00:17.18,0:00:20.12,Default,,0,0,0,,Менің қарным қатты ашты.
Dialogue: 0,0:00:20.12,0:00:22.58,Default,,0,0,0,,Содан кейін печенье алыңыз.
Dialogue: 0,0:00:22.58,0:00:25.49,Default,,0,0,0,,Бұл аштыққа жол бермейді!
Dialogue: 0,0:00:25.49,0:00:28.19,Default,,0,0,0,,Бұл қара өрік торты болуы керек!
Dialogue: 0,0:00:28.19,0:00:30.63,Default,,0,0,0,,Асқазаннан құтылғыңыз келсе ➡
Dialogue: 0,0:00:30.63,0:00:32.59,Default,,0,0,0,,Сіз сәл ұзағырақ шыдай аласыз, солай ма?
Dialogue: 0,0:00:32.59,0:00:37.07,Default,,0,0,0,,Мм! Бұл жағдайда печенье жақсы болады.
Dialogue: 0,0:00:37.07,0:00:40.34,Default,,0,0,0,,Иә? ...Тч.
Dialogue: 0,0:00:40.34,0:00:44.21,Default,,0,0,0,,О, Марилла! Бұл не хат деп ойлайсыңдар?
Dialogue: 0,0:00:44.21,0:00:46.17,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:00:46.17,0:00:48.54,Default,,0,0,0,,Бұл мен Королева академиясына бірге барған Присцилладан.
Dialogue: 0,0:00:48.54,0:00:50.51,Default,,0,0,0,,Морган ханым➡
Dialogue: 0,0:00:50.51,0:00:52.75,Default,,0,0,0,,Мен сіздің ханзада Эдвард аралына келе жатқаныңызды естідім!
Dialogue: 0,0:00:52.75,0:00:56.95,Default,,0,0,0,,Морган ханым сіз үнемі оқитын романист пе?
Dialogue: 0,0:00:56.95,0:00:58.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:58.89,0:01:02.12,Default,,0,0,0,,Солардың ішінде ``Раушан бағы'' менің сүйікті романдарымның бірі.
Dialogue: 0,0:01:02.12,0:01:05.13,Default,,0,0,0,,Жазушы Прискиланың алыс туысы.
Dialogue: 0,0:01:05.13,0:01:08.23,Default,,0,0,0,,Ал бейсенбі күні ауа райы жақсы болса➡
Dialogue: 0,0:01:08.23,0:01:10.90,Default,,0,0,0,,Сіз түскі асқа осы үйге тоқтайтын сияқтысыз.
Dialogue: 0,0:01:10.90,0:01:15.70,Default,,0,0,0,,О, қандай керемет! Бұл арман сияқты!
Dialogue: 0,0:01:15.70,0:01:19.68,Default,,0,0,0,,Миссис Морганның басқа адамдардан еш айырмашылығы жоқ.
Dialogue: 0,0:01:19.68,0:01:23.81,Default,,0,0,0,,Марилла, тамақ пен әшекейлерді маған қалдыр!
Dialogue: 0,0:01:23.81,0:01:27.75,Default,,0,0,0,,Мен ``Рушан бағы'' авторы үшін қолымнан келгеннің бәрін жасағым келеді!
Dialogue: 0,0:01:27.75,0:01:31.52,Default,,0,0,0,,Жақсы емес десем де, олар бас тартады деп ойламаймын. ➡
Dialogue: 0,0:01:31.52,0:01:33.59,Default,,0,0,0,,Жарайды, көріңіз.
Dialogue: 0,0:01:33.59,0:01:35.82,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:01:35.82,0:01:39.33,Default,,0,0,0,,Содан кейін Алан мырза мен Миссис пен доктор Стейсиді де шақырыңыз.
Dialogue: 0,0:01:39.33,0:01:42.06,Default,,0,0,0,,Мен Дианадан маған көмектесуін өтінемін.
Dialogue: 0,0:01:42.06,0:01:45.97,Default,,0,0,0,,Тым қобалжымаңыз. иә!
Dialogue: 0,0:01:45.97,0:01:50.41,Default,,0,0,0,,Қандай тағам ұсыну керек... Қандай әшекей қолдану керек?
Dialogue: 0,0:01:50.41,0:01:53.01,Default,,0,0,0,,Мен үшін Морган ханым➡
Dialogue: 0,0:01:53.01,0:01:56.31,Default,,0,0,0,,Мен сізге міндетті түрде керемет түскі ас дайындаймын!
Dialogue: 0,0:01:56.31,0:02:05.35,Default,,0,0,0,,♬～
Dialogue: 0,0:02:05.35,0:02:10.03,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:02:10.03,0:02:12.56,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:02:12.56,0:02:14.50,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:02:14.50,0:02:18.37,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:02:18.37,0:02:20.70,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:20.70,0:02:22.94,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:22.94,0:02:27.48,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:02:27.48,0:02:32.68,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін.»
Dialogue: 0,0:02:32.68,0:02:34.62,Default,,0,0,0,,♬ «Ол маған айтты».
Dialogue: 0,0:02:34.62,0:02:38.49,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:38.49,0:02:41.89,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:41.89,0:02:44.33,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:02:44.33,0:02:46.60,Default,,0,0,0,,♬ «Эй, мен күтемін.»
Dialogue: 0,0:02:46.60,0:02:50.83,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:02:50.83,0:02:53.30,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:02:53.30,0:02:55.64,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:02:55.64,0:02:59.11,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:02:59.11,0:03:02.34,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:03:02.34,0:03:04.58,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:03:04.58,0:03:08.85,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:03:08.85,0:03:11.35,Default,,0,0,0,,♬ «Мен санауды күтемін.»
Dialogue: 0,0:03:11.35,0:03:13.66,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:03:13.66,0:03:15.66,Default,,0,0,0,,♬ «Мен сені алып кетемін».
Dialogue: 0,0:03:15.66,0:03:20.03,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:20.03,0:03:23.93,Default,,0,0,0,,♬～
Dialogue: 0,0:03:26.77,0:03:31.27,Default,,0,0,0,,♬～
Dialogue: 0,0:03:31.27,0:03:35.24,Default,,0,0,0,,Менің ойымша, алдымен жеңіл сорпаны жеп көргім келеді.
Dialogue: 0,0:03:35.24,0:03:38.41,Default,,0,0,0,,Олай болса екі қуырылған тауық жасайық.
Dialogue: 0,0:03:38.41,0:03:41.32,Default,,0,0,0,,Апам тауықтың аяғын ұстаса➡
Dialogue: 0,0:03:41.32,0:03:43.39,Default,,0,0,0,,Мен мұны балтамен істеймін!
Dialogue: 0,0:03:43.39,0:03:46.15,Default,,0,0,0,,Олай болса мен сенен бір жақсылық сұрайын. Хехе.
Dialogue: 0,0:03:46.15,0:03:48.72,Default,,0,0,0,,Қалғаны бұршақ және бұршақ➡
Dialogue: 0,0:03:48.72,0:03:51.69,Default,,0,0,0,,Кілегейде бұқтырылған картоп пен салат салаты.
Dialogue: 0,0:03:51.69,0:03:55.40,Default,,0,0,0,,Дора, сен маған бұршақтың қабығын тазалауға көмектесе аласың ба?
Dialogue: 0,0:03:55.40,0:03:57.33,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:03:57.33,0:04:01.14,Default,,0,0,0,,Екеуіңде ертең менің маңызды тұтынушыларым бар.
Dialogue: 0,0:04:01.14,0:04:04.04,Default,,0,0,0,,Өзіңізді ұстаңыз. (2 адам) Иә!
Dialogue: 0,0:04:04.04,0:04:06.94,Default,,0,0,0,,Олай болса, тазалаудан бастайық!
Dialogue: 0,0:04:06.94,0:04:09.01,Default,,0,0,0,,(сыртқы дыбыс)
Dialogue: 0,0:04:09.01,0:04:11.11,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:14.72,0:04:16.72,Default,,0,0,0,,Сәлем Анна.
Dialogue: 0,0:04:16.72,0:04:19.19,Default,,0,0,0,,Миссис Морган қандай адам?
Dialogue: 0,0:04:19.19,0:04:22.59,Default,,0,0,0,,Мен бұған қатысты нәрселерді елестетуге тырыстым.
Dialogue: 0,0:04:22.59,0:04:25.79,Default,,0,0,0,,Қандай адам сөйлеп жатыр, не айтылып жатыр?
Dialogue: 0,0:04:25.79,0:04:30.00,Default,,0,0,0,,Содан мен кенет мұрнымдағы сепкілдерді байқай бастадым.
Dialogue: 0,0:04:30.00,0:04:31.93,Default,,0,0,0,,Морган ханымның кейіпкерлері➡
Dialogue: 0,0:04:31.93,0:04:34.57,Default,,0,0,0,,Әр адамның терісі мінсіз.
Dialogue: 0,0:04:34.57,0:04:38.17,Default,,0,0,0,,Бұл соншалықты байқалмайды. Менің ойымша...
Dialogue: 0,0:04:38.17,0:04:40.11,Default,,0,0,0,,Егер сізді шынымен қызықтырса➡
Dialogue: 0,0:04:40.11,0:04:42.38,Default,,0,0,0,,Бүгін кешке маған лимон шырынын құйып көріңіз.
Dialogue: 0,0:04:42.38,0:04:44.81,Default,,0,0,0,,Мен жасап көремін!
Dialogue: 0,0:04:44.81,0:04:47.15,Default,,0,0,0,,Әпке. ➡
Dialogue: 0,0:04:47.15,0:04:49.95,Default,,0,0,0,,Мұрыныңыз жылтыр. неге?
Dialogue: 0,0:04:49.95,0:04:51.89,Default,,0,0,0,,Мен лимон шырынын жағып қойдым.
Dialogue: 0,0:04:51.89,0:04:54.62,Default,,0,0,0,,Неліктен мұрныңызға лимон шырынын жағасыз?
Dialogue: 0,0:04:54.62,0:04:57.93,Default,,0,0,0,,А... Мен әдемі болғым келеді.
Dialogue: 0,0:04:57.93,0:05:02.76,Default,,0,0,0,,өтіңіз. Дэви, бүгінгі кешке көмектескеніңіз үшін рахмет.
Dialogue: 0,0:05:02.76,0:05:05.27,Default,,0,0,0,,Ертең де өзіңізді ұстаңыз.
Dialogue: 0,0:05:05.27,0:05:07.77,Default,,0,0,0,,Ертең күні бойы жақсы бала болсам➡
Dialogue: 0,0:05:07.77,0:05:10.81,Default,,0,0,0,,Келесі күні мен қалағандай жаман бола аламын ба?
Dialogue: 0,0:05:10.81,0:05:13.07,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:05:13.07,0:05:16.48,Default,,0,0,0,,Бірақ мен сені Дора екеуіңді қайыққа отырғызып, сен үшін қатарға отырғыза аламын.
Dialogue: 0,0:05:16.48,0:05:18.55,Default,,0,0,0,,Шынымен!? Бұл уәде!
Dialogue: 0,0:05:18.55,0:05:20.95,Default,,0,0,0,,Ертең мен Гаррисон мырзаның ➡ үйіне барамын
Dialogue: 0,0:05:20.95,0:05:23.85,Default,,0,0,0,,Мен Джингерді миниатюралық мылтықпен ұратын болдым, бірақ... Эх...
Dialogue: 0,0:05:23.85,0:05:27.36,Default,,0,0,0,,Бұл тағы бір күн. Басқа күн де ​​емес.
Dialogue: 0,0:05:27.36,0:05:32.26,Default,,0,0,0,,Мен ертең жақсы қыз боламын, сондықтан қызықсыз күн болар.
Dialogue: 0,0:05:32.26,0:05:34.50,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:05:34.50,0:05:37.10,Default,,0,0,0,,Менің сүйікті Морган ханымды шақырамын➡
Dialogue: 0,0:05:37.10,0:05:40.60,Default,,0,0,0,,Түскі ас. Бұл қызықты күн болады!
Dialogue: 0,0:05:40.60,0:05:45.57,Default,,0,0,0,,♬～
Dialogue: 0,0:05:45.57,0:05:47.78,Default,,0,0,0,,Сот….
Dialogue: 0,0:05:47.78,0:05:50.68,Default,,0,0,0,,Бұл тамаша күн болады.
Dialogue: 0,0:05:50.68,0:05:55.38,Default,,0,0,0,,♬～
Dialogue: 0,0:05:55.38,0:05:58.82,Default,,0,0,0,,Қайырлы таң Анна. Қайырлы таң Диана.
Dialogue: 0,0:05:58.82,0:06:00.79,Default,,0,0,0,,Мына алжапқыш жақсы екен.
Dialogue: 0,0:06:00.79,0:06:03.12,Default,,0,0,0,,Бұл тамақ дайындауға арналған➡
Dialogue: 0,0:06:03.12,0:06:07.13,Default,,0,0,0,,Мен түскі асқа мына ақ муслинді киюді ойлап жүрмін.
Dialogue: 0,0:06:07.13,0:06:10.93,Default,,0,0,0,,Бұл сізге сәйкес келеді. Бірақ бұл аздап тығыз.
Dialogue: 0,0:06:10.93,0:06:13.57,Default,,0,0,0,,Мен өткен айдан бері төрт фунт қостым.
Dialogue: 0,0:06:13.57,0:06:18.07,Default,,0,0,0,,Миссис Морганның барлық кейіпкерлері ұзын және сымбатты.
Dialogue: 0,0:06:18.07,0:06:22.98,Default,,0,0,0,,Бұл нені білдіреді? Диана Берли сүйкімді күлімсіреп.
Dialogue: 0,0:06:22.98,0:06:25.81,Default,,0,0,0,,Әзірге қызықты нәрселер туралы ойланайық.
Dialogue: 0,0:06:25.81,0:06:30.45,Default,,0,0,0,,Менде де сепкілдер бар, бірақ мұрнымның пішіні өте жақсы, солай ма?
Dialogue: 0,0:06:30.45,0:06:34.86,Default,,0,0,0,,Иә. Лимон шырыны қаншалықты тиімді?
Dialogue: 0,0:06:34.86,0:06:36.86,Default,,0,0,0,,Менің ойымша, бұл жұмыс істеді. Шынымен!?
Dialogue: 0,0:06:36.86,0:06:38.86,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:38.86,0:06:41.36,Default,,0,0,0,,Мен сендерге гүл теруге көмектесемін. Иә.
Dialogue: 0,0:06:41.36,0:06:46.20,Default,,0,0,0,,Алдымен бөлмені безендірейік, сосын тамақ әзірлейік.
Dialogue: 0,0:06:46.20,0:06:50.07,Default,,0,0,0,,Прискила және басқалары сағат 12-лер шамасында келеді. иә!
Dialogue: 0,0:06:50.07,0:06:55.38,Default,,0,0,0,,♬～
Dialogue: 0,0:06:55.38,0:07:00.12,Default,,0,0,0,,Миссис Морганның орнын раушан гүл бақшасында деп елестетіңіз.
Dialogue: 0,0:07:00.12,0:07:02.75,Default,,0,0,0,,Керемет көрінеді! (2 адам) Хехе.
Dialogue: 0,0:07:02.75,0:07:04.82,Default,,0,0,0,,Қазір, оның орнына…
Dialogue: 0,0:07:04.82,0:07:08.62,Default,,0,0,0,,♬～
Dialogue: 0,0:07:08.62,0:07:12.43,Default,,0,0,0,,Мм. иә? Уф...!
Dialogue: 0,0:07:12.43,0:07:14.66,Default,,0,0,0,,Уау! Ахаха.
Dialogue: 0,0:07:14.66,0:07:16.60,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:07:16.60,0:07:19.43,Default,,0,0,0,,Дэви Тыныштық болғаныңыз өте жақсы.
Dialogue: 0,0:07:19.43,0:07:21.77,Default,,0,0,0,,Себебі мен саған уәде бергенмін.
Dialogue: 0,0:07:21.77,0:07:23.87,Default,,0,0,0,,Уф.
Dialogue: 0,0:07:25.57,0:07:29.24,Default,,0,0,0,,Менің сепкілдерім көрінбейді деп үміттенемін.
Dialogue: 0,0:07:29.24,0:07:32.01,Default,,0,0,0,,Мен жақсы сөйлей аламын ба деп ойлаймын.
Dialogue: 0,0:07:32.01,0:07:35.25,Default,,0,0,0,,Менімен сөйлесе алмаймын деп уайымдамаңыз.
Dialogue: 0,0:07:35.25,0:07:38.22,Default,,0,0,0,,Аха!
Dialogue: 0,0:07:38.22,0:07:41.09,Default,,0,0,0,,Барлығыңызға қош келдіңіздер.
Dialogue: 0,0:07:41.09,0:07:44.66,Default,,0,0,0,,Бүгін мені шақырғаныңызға рахмет.
Dialogue: 0,0:07:44.66,0:07:47.10,Default,,0,0,0,,Мен оны қатты күттім.
Dialogue: 0,0:07:47.10,0:07:50.00,Default,,0,0,0,,Энн Диана Біраз уақыт өтті.
Dialogue: 0,0:07:50.00,0:07:52.07,Default,,0,0,0,,Екеуің де өте жақсысыңдар.
Dialogue: 0,0:07:52.07,0:07:54.70,Default,,0,0,0,,Ах...! рақмет сізге!
Dialogue: 0,0:07:54.70,0:07:57.01,Default,,0,0,0,,(сағаттың қозғалу дыбысы)
Dialogue: 0,0:07:57.01,0:07:59.91,Default,,0,0,0,,Кеш болды...
Dialogue: 0,0:07:59.91,0:08:03.51,Default,,0,0,0,,Келе алмасаң... Сол себепті...
Dialogue: 0,0:08:03.51,0:08:08.12,Default,,0,0,0,,Бірақ... келер кез келді...
Dialogue: 0,0:08:11.15,0:08:16.09,Default,,0,0,0,,Энн Стейси боялған тақталарды көргісі келеді.
Dialogue: 0,0:08:16.09,0:08:18.76,Default,,0,0,0,,Міне, мен қазір сүртіп жатырмын.
Dialogue: 0,0:08:18.76,0:08:20.76,Default,,0,0,0,,⚟ (қатты шу)
Dialogue: 0,0:08:24.63,0:08:27.00,Default,,0,0,0,,Уф... ➡
Dialogue: 0,0:08:27.00,0:08:29.00,Default,,0,0,0,,Ах…. Дэйви⁉
Dialogue: 0,0:08:29.00,0:08:31.24,Default,,0,0,0,,Себебі мен желіні ашып бітірдім➡
Dialogue: 0,0:08:31.24,0:08:33.21,Default,,0,0,0,,Мен сөреге қоюды ойладым, бірақ...
Dialogue: 0,0:08:33.21,0:08:35.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:35.48,0:08:38.45,Default,,0,0,0,,Дэви, мен саған бұл үстелге отырма дедім ғой!
Dialogue: 0,0:08:38.45,0:08:41.28,Default,,0,0,0,,А... мен ұмытып кетіппін.
Dialogue: 0,0:08:41.28,0:08:43.32,Default,,0,0,0,,Апай тым көп айтады➡
Dialogue: 0,0:08:43.32,0:08:45.45,Default,,0,0,0,,Менің есімде жоқ.
Dialogue: 0,0:08:45.45,0:08:47.89,Default,,0,0,0,,Тамақтанып болғанша жоғарыға көтеріл!
Dialogue: 0,0:08:47.89,0:08:52.73,Default,,0,0,0,,А... Мен пирогқа құлайын деген жоқпын.
Dialogue: 0,0:08:52.73,0:08:58.23,Default,,0,0,0,,Әй, мына бәліштің бір бөлігін сенімен ала кетейін бе...?
Dialogue: 0,0:08:58.23,0:09:00.17,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:00.17,0:09:02.60,Default,,0,0,0,,Десерт…➡
Dialogue: 0,0:09:02.60,0:09:04.54,Default,,0,0,0,,Біз не істеуіміз керек...? (Дэви) Ах!
Dialogue: 0,0:09:04.54,0:09:07.48,Default,,0,0,0,,Мен алдын ала дайындалған тәтті құлпынай бар екеніне сенімдімін.
Dialogue: 0,0:09:07.48,0:09:12.11,Default,,0,0,0,,Ыдыста әлі біраз кілегей қалды!
Dialogue: 0,0:09:12.11,0:09:14.18,Default,,0,0,0,,(ауаның ағу дыбысы)
Dialogue: 0,0:09:14.18,0:09:16.75,Default,,0,0,0,,(ауаның ағу дыбысы)
Dialogue: 0,0:09:16.75,0:09:20.26,Default,,0,0,0,,Бірдеңе болған болуы керек...
Dialogue: 0,0:09:20.26,0:09:25.13,Default,,0,0,0,,Мен Мистер мен Миссис Алан мен Доктор Стейсиді бұдан былай күте алмаймын.
Dialogue: 0,0:09:25.13,0:09:28.76,Default,,0,0,0,,Не істеу керек? Сіз бірінші тамақтанғыңыз келе ме?
Dialogue: 0,0:09:28.76,0:09:34.77,Default,,0,0,0,,Жоқ, болатынына сенімдімін. Миссис Морганның кейіпкері де солай.
Dialogue: 0,0:09:38.11,0:09:42.68,Default,,0,0,0,,А... Анн: Бұршаққа қант салдыңыз ба?
Dialogue: 0,0:09:42.68,0:09:46.61,Default,,0,0,0,,Иә, бір қасық. Менің үйімде мұны үнемі жасаймыз.
Dialogue: 0,0:09:46.61,0:09:50.15,Default,,0,0,0,,Пешке қойғанда, мен оған да қасық саламын.
Dialogue: 0,0:09:50.15,0:09:52.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:52.55,0:09:54.49,Default,,0,0,0,,Қандай тәтті!
Dialogue: 0,0:09:54.49,0:09:57.26,Default,,0,0,0,,Бұл аспаз тым көп болды.
Dialogue: 0,0:09:57.26,0:10:00.16,Default,,0,0,0,,Мен Энн ұмытып кетеді деп ойладым➡
Dialogue: 0,0:10:00.16,0:10:04.37,Default,,0,0,0,,Мен де бір қасық қостым...
Dialogue: 0,0:10:04.37,0:10:07.27,Default,,0,0,0,,Уф... Ахахха!
Dialogue: 0,0:10:07.27,0:10:10.94,Default,,0,0,0,,Жарайды. Бүгін бұршақ жоқ.
Dialogue: 0,0:10:10.94,0:10:12.87,Default,,0,0,0,,⚟ (сықырлаған дыбыс) Ах...
Dialogue: 0,0:10:12.87,0:10:16.51,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:10:16.51,0:10:19.41,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:10:19.41,0:10:21.45,Default,,0,0,0,,Дэви!
Dialogue: 0,0:10:21.45,0:10:23.79,Default,,0,0,0,,Сіз бұл конус қабығын әдейі соқтыңыз ба?
Dialogue: 0,0:10:23.79,0:10:27.29,Default,,0,0,0,,Жоқ! Қарным ашылып, төмен түспек болдым ➡
Dialogue: 0,0:10:27.29,0:10:29.79,Default,,0,0,0,,Менің қолым тайып кетті...
Dialogue: 0,0:10:29.79,0:10:31.73,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:10:31.73,0:10:34.66,Default,,0,0,0,,Дэвиге ұрыспа, Марилла. сурет?
Dialogue: 0,0:10:34.66,0:10:36.66,Default,,0,0,0,,Мен табақты➡ жасаймын
Dialogue: 0,0:10:36.66,0:10:39.40,Default,,0,0,0,,Мен оны баспалдақта қалдырмауым керек еді.
Dialogue: 0,0:10:41.34,0:10:45.14,Default,,0,0,0,,Морган ханым⁉ Осы уақытта?
Dialogue: 0,0:10:47.14,0:10:49.41,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:10:49.41,0:10:51.35,Default,,0,0,0,,Рейчел….
Dialogue: 0,0:10:51.35,0:10:53.28,Default,,0,0,0,,Не... Не?
Dialogue: 0,0:10:53.28,0:10:55.52,Default,,0,0,0,,«На-да» нені білдіреді?
Dialogue: 0,0:10:55.52,0:10:57.49,Default,,0,0,0,,Мен жаңа ғана пошта бөлімшесіне бардым➡
Dialogue: 0,0:10:57.49,0:11:01.69,Default,,0,0,0,,Менің сізге хатым бар еді, оны жеткізуге келдім.
Dialogue: 0,0:11:01.69,0:11:06.36,Default,,0,0,0,,Прискиладан. Кеше шыққан сияқты.
Dialogue: 0,0:11:06.36,0:11:08.33,Default,,0,0,0,,«Анна, мен асығып тұрмын➡
Dialogue: 0,0:11:08.33,0:11:10.90,Default,,0,0,0,,Нағашым аяғын созып алды. ➡
Dialogue: 0,0:11:10.90,0:11:14.77,Default,,0,0,0,,Сіз сауыққан кезде Торонтоға оралуыңыз керек➡
Dialogue: 0,0:11:14.77,0:11:17.21,Default,,0,0,0,,Кешіріңіз➡
Dialogue: 0,0:11:17.21,0:11:21.51,Default,,0,0,0,,Мен Green Gables-ке бара алмаймын.''
Dialogue: 0,0:11:23.11,0:11:25.28,Default,,0,0,0,,(ыдыстарды пайдалану дыбысы)
Dialogue: 0,0:11:25.28,0:11:29.15,Default,,0,0,0,,Бұл мен үшін жаман.
Dialogue: 0,0:11:29.15,0:11:32.05,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:11:32.05,0:11:35.39,Default,,0,0,0,,Диана екеуміз ағарған кемпір атанған кезде➡
Dialogue: 0,0:11:35.39,0:11:37.96,Default,,0,0,0,,Бұл күнді еске алсаң күлесің.
Dialogue: 0,0:11:37.96,0:11:39.89,Default,,0,0,0,,Бірақ қазір бұл мүмкін емес.
Dialogue: 0,0:11:39.89,0:11:42.40,Default,,0,0,0,,Менің көңілім қалды.
Dialogue: 0,0:11:42.40,0:11:44.73,Default,,0,0,0,,Сіз аудиторияның қабырғалары туралы естідіңіз бе?
Dialogue: 0,0:11:44.73,0:11:49.04,Default,,0,0,0,,А, мен оны жарқыраған көк түске боялғанын естідім.
Dialogue: 0,0:11:49.04,0:11:51.71,Default,,0,0,0,,Негізі оны әдемі жасыл түске бояңыз ➡
Dialogue: 0,0:11:51.71,0:11:55.71,Default,,0,0,0,,Бұл біздің жетілдіру тобының қызметінің символы болуы керек еді.
Dialogue: 0,0:11:55.71,0:11:58.85,Default,,0,0,0,,Сіз заттардан тым көп нәрсені күтесіз. ➡
Dialogue: 0,0:11:58.85,0:12:03.22,Default,,0,0,0,,Бұл соншалықты ауыр көңілді қалдырар еді.
Dialogue: 0,0:12:03.22,0:12:06.02,Default,,0,0,0,,Иә... дәл солай.
Dialogue: 0,0:12:06.02,0:12:09.86,Default,,0,0,0,,Менің ойымша, керемет нәрсе болады➡
Dialogue: 0,0:12:09.86,0:12:15.10,Default,,0,0,0,,Қиялымның қанатымен көкке самғағаныма қуанамын.
Dialogue: 0,0:12:15.10,0:12:17.77,Default,,0,0,0,,Ұшу кезінде өте жақсы.
Dialogue: 0,0:12:17.77,0:12:21.30,Default,,0,0,0,,Күн батқанға қалықтағандай...
Dialogue: 0,0:12:21.30,0:12:23.34,Default,,0,0,0,,Одан кейін соғылып құласа да➡
Dialogue: 0,0:12:23.34,0:12:25.71,Default,,0,0,0,,Оның орнын толтыру үшін жеткілікті.
Dialogue: 0,0:12:25.71,0:12:29.04,Default,,0,0,0,,Мен болсам, тыныш жүргім келеді.
Dialogue: 0,0:12:29.04,0:12:32.48,Default,,0,0,0,,Дэви ұйықтап қалды ма? Иә.
Dialogue: 0,0:12:32.48,0:12:36.48,Default,,0,0,0,,Ертең мен уәде бойынша Дэйви мен Дораны қайыққа мінгіземін.
Dialogue: 0,0:12:36.48,0:12:40.62,Default,,0,0,0,,Дэви жақсы бала болуға тырысты.
Dialogue: 0,0:12:40.62,0:12:45.46,Default,,0,0,0,,Сіз де, егіздер де құлап, суға батып кетпесін.
Dialogue: 0,0:12:45.46,0:12:49.46,Default,,0,0,0,,Марилла да ше? Кешіріңіз.
Dialogue: 0,0:12:49.46,0:12:51.63,Default,,0,0,0,,О. ➡
Dialogue: 0,0:12:51.63,0:12:54.60,Default,,0,0,0,,Гилберт сонда келе жатыр.
Dialogue: 0,0:12:54.60,0:12:57.44,Default,,0,0,0,,Неге мені қайыққа шақырмайсың?
Dialogue: 0,0:12:57.44,0:13:02.61,Default,,0,0,0,,Иә. Мен не істеуім керек...
Dialogue: 0,0:13:02.61,0:13:07.02,Default,,0,0,0,,♬～
Dialogue: 0,0:13:08.35,0:13:12.35,Default,,0,0,0,,(Мизуон)
Dialogue: 0,0:13:12.35,0:13:15.46,Default,,0,0,0,,Хе хе хе хе хе хе.
Dialogue: 0,0:13:15.46,0:13:17.86,Default,,0,0,0,,Уау! Қайық керемет!
Dialogue: 0,0:13:17.86,0:13:20.16,Default,,0,0,0,,А-а-а-а! (Гилберт Блайт) Қауіп!
Dialogue: 0,0:13:21.80,0:13:24.47,Default,,0,0,0,,Құлап кетсем жақсы болар еді.
Dialogue: 0,0:13:24.47,0:13:28.07,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін. Бірақ Дэви, сен жүзе аласың ба?
Dialogue: 0,0:13:28.07,0:13:31.57,Default,,0,0,0,,Жоқ! Сонда ондай сөздерді айтпау керек.
Dialogue: 0,0:13:31.57,0:13:35.21,Default,,0,0,0,,Суға батып кетсең, ішің суға толады.
Dialogue: 0,0:13:35.21,0:13:37.78,Default,,0,0,0,,Ахахаха, бұл не~! Ахаха! Ахахха! ➡
Dialogue: 0,0:13:37.78,0:13:40.68,Default,,0,0,0,,Тапутапу Мен оған айналуға тырыстым! Хехехе!
Dialogue: 0,0:13:40.68,0:13:44.22,Default,,0,0,0,,Дора жүзе алады ма? (Дора) Хмм...
Dialogue: 0,0:13:44.22,0:13:46.79,Default,,0,0,0,,Жарайды, келесі жолы айтамын.
Dialogue: 0,0:13:46.79,0:13:50.22,Default,,0,0,0,,Шынымен бе? Мен Гилберт-оний-чанды жақсы көремін!
Dialogue: 0,0:13:50.22,0:13:53.10,Default,,0,0,0,,Бірақ мен кенеттен жүзе алатыныма сенімдімін.
Dialogue: 0,0:13:53.10,0:13:56.40,Default,,0,0,0,,Қайықтар көңілді.
Dialogue: 0,0:13:56.40,0:13:58.33,Default,,0,0,0,,Менің жүзгім келеді!
Dialogue: 0,0:13:58.33,0:14:00.94,Default,,0,0,0,,Менде бүгін ештеңе дайын емес.
Dialogue: 0,0:14:00.94,0:14:02.87,Default,,0,0,0,,Не? Бұл қызықсыз.
Dialogue: 0,0:14:02.87,0:14:06.11,Default,,0,0,0,,Суланып, шашырап кетсем ғой. ➡
Dialogue: 0,0:14:06.11,0:14:08.34,Default,,0,0,0,,Эй, мен сонда жүздім.
Dialogue: 0,0:14:08.34,0:14:10.45,Default,,0,0,0,,(Кілтті құлыптау дыбысы)
Dialogue: 0,0:14:25.89,0:14:29.10,Default,,0,0,0,,⚟Мұғалім Ан! иә? а….
Dialogue: 0,0:14:29.10,0:14:32.00,Default,,0,0,0,,Павел!
Dialogue: 0,0:14:32.00,0:14:35.24,Default,,0,0,0,,Сен де бейіт басына барасың ба? (Пол Ирвинг) Иә.
Dialogue: 0,0:14:35.24,0:14:39.14,Default,,0,0,0,,Әже бұл гераньді атаға тапсырмамен берген.
Dialogue: 0,0:14:39.14,0:14:41.71,Default,,0,0,0,,Сосын мына ақ раушан➡
Dialogue: 0,0:14:41.71,0:14:44.91,Default,,0,0,0,,Мен оны анама беруді шештім...
Dialogue: 0,0:14:46.98,0:14:50.95,Default,,0,0,0,,Полдың анасы Америкада қайтыс болды, солай ма?
Dialogue: 0,0:14:50.95,0:14:56.16,Default,,0,0,0,,Иә. Бүгін анамның өмірден өткеніне тура үш жыл болды.
Dialogue: 0,0:14:56.16,0:15:00.56,Default,,0,0,0,,Менің әкем де қазір Бостондағы бейітке барады деп ойлаймын.
Dialogue: 0,0:15:02.03,0:15:05.83,Default,,0,0,0,,А... үш жыл болды...
Dialogue: 0,0:15:05.83,0:15:09.20,Default,,0,0,0,,Павел…. Ұзақ уақыт болды➡
Dialogue: 0,0:15:09.20,0:15:11.21,Default,,0,0,0,,Мен әлі де көңілсізмін.
Dialogue: 0,0:15:11.21,0:15:13.44,Default,,0,0,0,,Өте өкінішті➡
Dialogue: 0,0:15:13.44,0:15:15.38,Default,,0,0,0,,Қолдан ештеңе келмейтін кездер болады.
Dialogue: 0,0:15:15.38,0:15:18.08,Default,,0,0,0,,Әлі де сен➡
Dialogue: 0,0:15:18.08,0:15:20.38,Default,,0,0,0,,Енді мұңайғың келмейді, солай ма?
Dialogue: 0,0:15:20.38,0:15:24.22,Default,,0,0,0,,А... Мен анамды ұмытып бара жатқандай сезінемін➡
Dialogue: 0,0:15:24.22,0:15:26.15,Default,,0,0,0,,Қанша қайғылы болса да➡
Dialogue: 0,0:15:26.15,0:15:29.96,Default,,0,0,0,,Анаңды ұмытқың келмейді, солай ма?
Dialogue: 0,0:15:29.96,0:15:33.36,Default,,0,0,0,,Мұғалім жақсы түсінеді. ➡
Dialogue: 0,0:15:33.36,0:15:37.23,Default,,0,0,0,,Мен әкеммен анам туралы айта алмадым. ➡
Dialogue: 0,0:15:37.23,0:15:39.93,Default,,0,0,0,,Өйткені бұл мені қатты қынжылтады.
Dialogue: 0,0:15:39.93,0:15:42.97,Default,,0,0,0,,Әкем екі қолымен бетін жапқанда➡
Dialogue: 0,0:15:42.97,0:15:45.37,Default,,0,0,0,,А, мен тоқтатуым керек...➡
Dialogue: 0,0:15:45.37,0:15:48.28,Default,,0,0,0,,Біз бұлай сөйлеспеуіміз керек ...
Dialogue: 0,0:15:48.28,0:15:50.38,Default,,0,0,0,,Пауыл….
Dialogue: 0,0:15:52.28,0:15:56.78,Default,,0,0,0,,Жарайсың ба? полюс. Саған ешнәрсе жоқ.
Dialogue: 0,0:15:56.78,0:15:59.52,Default,,0,0,0,,Әке, әрине.
Dialogue: 0,0:15:59.52,0:16:04.06,Default,,0,0,0,,Менің әкем әдетте өте жақсы адам.
Dialogue: 0,0:16:04.06,0:16:07.43,Default,,0,0,0,,Мен әкемді дүниеде бәрінен де жақсы көремін.
Dialogue: 0,0:16:07.43,0:16:09.36,Default,,0,0,0,,Келесі кезекте әже.
Dialogue: 0,0:16:09.36,0:16:12.00,Default,,0,0,0,,Содан кейін профессор Энн. о қымбаттым!
Dialogue: 0,0:16:12.00,0:16:15.44,Default,,0,0,0,,Негізі менің әкемнен кейінгі мұғалім Анна➡
Dialogue: 0,0:16:15.44,0:16:18.34,Default,,0,0,0,,Менің әжем маған өте жақсы.
Dialogue: 0,0:16:18.34,0:16:22.11,Default,,0,0,0,,Дұрыс, мұғалім де Павелді жақсы көреді.
Dialogue: 0,0:16:22.11,0:16:26.45,Default,,0,0,0,,Маған анаңның әңгімесін айтып берші. иә! ➡
Dialogue: 0,0:16:26.45,0:16:30.65,Default,,0,0,0,,Бір күні Линдтің тәтесі менің үйіме келді➡
Dialogue: 0,0:16:30.65,0:16:34.66,Default,,0,0,0,,Анамның суретіне қарап отырып: ``Ол сондай әдемі адам.➡
Dialogue: 0,0:16:34.66,0:16:38.99,Default,,0,0,0,,Бірақ әкең басқа әйел алады.''➡
Dialogue: 0,0:16:38.99,0:16:40.93,Default,,0,0,0,,Мен осылай дедім. ➡
Dialogue: 0,0:16:40.93,0:16:44.53,Default,,0,0,0,,Мені таң қалдырғаны сонша, тынысым тарылды...
Dialogue: 0,0:16:52.47,0:16:54.41,Default,,0,0,0,,Амансың ба? Дэви. ➡
Dialogue: 0,0:16:54.41,0:16:57.35,Default,,0,0,0,,Тыныш болыңыз және Эннге кедергі жасамаңыз.
Dialogue: 0,0:16:57.35,0:17:00.21,Default,,0,0,0,,Мен әдейі еркелік ойнауға тырыспаймын.
Dialogue: 0,0:17:00.21,0:17:03.62,Default,,0,0,0,,Бірақ егер мен кездейсоқ бірдеңе жасасам, не істеуім керек?
Dialogue: 0,0:17:03.62,0:17:06.52,Default,,0,0,0,,Тек абай болмау үшін абай болу керек.
Dialogue: 0,0:17:06.52,0:17:09.42,Default,,0,0,0,,Энн Егер Ширер мырза келсе➡
Dialogue: 0,0:17:09.42,0:17:12.33,Default,,0,0,0,,Маған стейкке ет әкеліңізші.
Dialogue: 0,0:17:12.33,0:17:15.66,Default,,0,0,0,,Мен түсіндім. Мен сонда барамын.
Dialogue: 0,0:17:15.66,0:17:18.13,Default,,0,0,0,,Қош келдіңіз. Қош келдіңіз!
Dialogue: 0,0:17:18.13,0:17:21.77,Default,,0,0,0,,Кел, Дэви. Мен бүгін бүкіл үйді жинаймын.
Dialogue: 0,0:17:21.77,0:17:24.14,Default,,0,0,0,,Маған көмектесіңізші. Иә!
Dialogue: 0,0:17:24.14,0:17:26.11,Default,,0,0,0,,Бірақ алдымен бірнеше печенье...
Dialogue: 0,0:17:26.11,0:17:28.91,Default,,0,0,0,,Бұл аяқталғаннан кейін ғана!
Dialogue: 0,0:17:28.91,0:17:36.65,Default,,0,0,0,,♬～
Dialogue: 0,0:17:36.65,0:17:39.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.19,0:17:41.19,Default,,0,0,0,,Тағы да қараңғы...
Dialogue: 0,0:17:43.69,0:17:46.19,Default,,0,0,0,,А... Анна апа, не іздеп жүрсіз?
Dialogue: 0,0:17:46.19,0:17:50.46,Default,,0,0,0,,Бұл журналдан оқып, дайындаған сепкілдерді кетіретін дәрі.
Dialogue: 0,0:17:50.46,0:17:52.67,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:55.20,0:17:58.07,Default,,0,0,0,,Ах...!
Dialogue: 0,0:17:58.07,0:18:00.51,Default,,0,0,0,,⚟ Ах. Ах. Бұл Ширер.
Dialogue: 0,0:18:00.51,0:18:03.18,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:03.18,0:18:06.55,Default,,0,0,0,,Ширер мырза: Стейкке арналған ет...
Dialogue: 0,0:18:06.55,0:18:08.62,Default,,0,0,0,,Энн кенеттен болғаны үшін кешіріңіз.
Dialogue: 0,0:18:08.62,0:18:10.85,Default,,0,0,0,,Міне, Морган ханыммен➡
Dialogue: 0,0:18:10.85,0:18:13.89,Default,,0,0,0,,Пендекстер ханым. …сурет?
Dialogue: 0,0:18:13.89,0:18:16.02,Default,,0,0,0,,Иә? Хмм?
Dialogue: 0,0:18:16.02,0:18:18.99,Default,,0,0,0,,Мо Мо Мо Миссис Морган⁉
Dialogue: 0,0:18:18.99,0:18:23.63,Default,,0,0,0,,Green Gables ойынына қош келдіңіз! Сізбен танысқаным мақтаныш.
Dialogue: 0,0:18:23.63,0:18:27.44,Default,,0,0,0,,Менің атым Энн Ширли.
Dialogue: 0,0:18:27.44,0:18:32.24,Default,,0,0,0,,Морган ханымның шашы ақ, кішкентай екеніне таң қалдым.
Dialogue: 0,0:18:32.24,0:18:35.14,Default,,0,0,0,,Ұзыны - Пендекстер ханым.
Dialogue: 0,0:18:35.14,0:18:37.85,Default,,0,0,0,,Ол Нью-Йоркте тұратын атақты адам.
Dialogue: 0,0:18:37.85,0:18:42.15,Default,,0,0,0,,Сонда да кенеттен болды, мен әлі де қобалжыдым.
Dialogue: 0,0:18:42.15,0:18:46.45,Default,,0,0,0,,Кешіріңіз. Апамның аяғы мен ойлағаннан да жақсы➡
Dialogue: 0,0:18:46.45,0:18:49.79,Default,,0,0,0,,Энн де менімен кездескісі келді, сондықтан мен оны алып келдім.
Dialogue: 0,0:18:49.79,0:18:53.03,Default,,0,0,0,,Одан да, Энн... анау мұрын...
Dialogue: 0,0:18:53.03,0:18:56.70,Default,,0,0,0,,Сіз сепкілдерді айтасыз ба? Мен түссіндім. Өйткені бәрі жақсы.
Dialogue: 0,0:18:56.70,0:18:59.40,Default,,0,0,0,,Мен тез шай дайындап келейін. Ахх...
Dialogue: 0,0:19:01.07,0:19:04.94,Default,,0,0,0,,Марилланың кәмпиттер жасағаны үлкен көмек болды.
Dialogue: 0,0:19:04.94,0:19:09.34,Default,,0,0,0,,Энн Онда бейтаныс вагон тұрды. Клиент пе?
Dialogue: 0,0:19:09.34,0:19:12.01,Default,,0,0,0,,Диана! Сіз дұрыс жерге келдіңіз.
Dialogue: 0,0:19:12.01,0:19:16.35,Default,,0,0,0,,Қазір! Осы сәт! Қонақ бөлмесінде кім бар деп ойлайсың?
Dialogue: 0,0:19:16.35,0:19:21.16,Default,,0,0,0,,Не? Менің сепкілдеріме осылай қарайсың ба?
Dialogue: 0,0:19:21.16,0:19:24.06,Default,,0,0,0,,Жоқ, Энн. Бұл мұрын.
Dialogue: 0,0:19:24.06,0:19:29.06,Default,,0,0,0,,Мұрын? Менің мұрныма не болды?
Dialogue: 0,0:19:30.83,0:19:34.04,Default,,0,0,0,,Не? Аа!? Ахаха….
Dialogue: 0,0:19:36.64,0:19:38.64,Default,,0,0,0,,Сен не істедің?
Dialogue: 0,0:19:38.64,0:19:41.08,Default,,0,0,0,,сепкілдерге қарсы дәрі ретінде арналған➡
Dialogue: 0,0:19:41.08,0:19:44.91,Default,,0,0,0,,Марилла кілемді қызыл бояумен бояды.
Dialogue: 0,0:19:44.91,0:19:46.85,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:19:46.85,0:19:49.08,Default,,0,0,0,,Мен олай айтпаймын...➡
Dialogue: 0,0:19:49.08,0:19:51.92,Default,,0,0,0,,Бұл қызыл қызыл. Апыр-ай!
Dialogue: 0,0:19:51.92,0:19:56.16,Default,,0,0,0,,Хмм! Маған оның қаншалықты ауыратыны маңызды емес!
Dialogue: 0,0:19:56.16,0:19:59.06,Default,,0,0,0,,Барынша тырысыңыз! Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:19:59.06,0:20:01.96,Default,,0,0,0,,Бұрын шашымды жасыл түске бояйтынмын...➡
Dialogue: 0,0:20:01.96,0:20:04.87,Default,,0,0,0,,Бұл жолы мұрныңды қызылға боядың...
Dialogue: 0,0:20:04.87,0:20:07.47,Default,,0,0,0,,Марилла шашымды қиды➡
Dialogue: 0,0:20:07.47,0:20:10.04,Default,,0,0,0,,Мұрнымды кесіп тастай алмаймын...!
Dialogue: 0,0:20:10.04,0:20:13.91,Default,,0,0,0,,Сіз өте қыңырсыз! Біраз ауырады! ол аурады!
Dialogue: 0,0:20:13.91,0:20:17.28,Default,,0,0,0,,Егер ол өшіп, қызарып кетсе, мен не істеуім керек?
Dialogue: 0,0:20:17.28,0:20:21.28,Default,,0,0,0,,Мен ренжітуге болмайды дедім! Эй... эй!
Dialogue: 0,0:20:22.98,0:20:26.95,Default,,0,0,0,,Бұл тәтті алхоры керемет дәм береді.
Dialogue: 0,0:20:26.95,0:20:29.76,Default,,0,0,0,,Иә, Марилла орындады.
Dialogue: 0,0:20:29.76,0:20:32.29,Default,,0,0,0,,Дәмі өте талғампаз.
Dialogue: 0,0:20:32.29,0:20:34.90,Default,,0,0,0,,Мен толтырсам қарсы боласыз ба?
Dialogue: 0,0:20:34.90,0:20:36.83,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:20:36.83,0:20:42.64,Default,,0,0,0,,♬～
Dialogue: 0,0:20:42.64,0:20:48.14,Default,,0,0,0,,Мен шашымның қара болғанын қалап, шашқа бояу жағып едім, неге екені белгісіз жасыл түсті.
Dialogue: 0,0:20:48.14,0:20:50.81,Default,,0,0,0,,Шаштың қызыл болғаны бәрібір жақсы болды.
Dialogue: 0,0:20:50.81,0:20:52.78,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:52.78,0:20:54.82,Default,,0,0,0,,Содан бері төрт жыл өтті➡
Dialogue: 0,0:20:54.82,0:20:58.55,Default,,0,0,0,,Бүгін мен сепкілге қарсы дәрі-дәрмекті дұрыс қолданбадым, мұрным ашық қызыл!
Dialogue: 0,0:20:58.55,0:21:01.46,Default,,0,0,0,,Мен сурет салуда өте нашармын!
Dialogue: 0,0:21:01.46,0:21:03.39,Default,,0,0,0,,Аха! Аха (күлді)
Dialogue: 0,0:21:03.39,0:21:05.33,Default,,0,0,0,,Ахххх!
Dialogue: 0,0:21:05.33,0:21:09.23,Default,,0,0,0,,Ех хе хе хе хе хе.
Dialogue: 0,0:21:09.23,0:21:12.03,Default,,0,0,0,,Қайырлы күн.
Dialogue: 0,0:21:12.03,0:21:14.03,Default,,0,0,0,,Сау болыңыз! (Дэви) Сау болыңыз! ➡
Dialogue: 0,0:21:14.03,0:21:16.50,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:21:16.50,0:21:21.34,Default,,0,0,0,,♬～
Dialogue: 0,0:21:21.34,0:21:25.35,Default,,0,0,0,,Бүгінгі күн шынымен де жан алмасу болды.
Dialogue: 0,0:21:25.35,0:21:30.58,Default,,0,0,0,,Морган ханымның ғажайып оқиғасы мен Пендекстер ханымның сұлулығы!
Dialogue: 0,0:21:30.58,0:21:34.22,Default,,0,0,0,,Қайсысына ғашық болатынымды білмедім.
Dialogue: 0,0:21:34.22,0:21:39.49,Default,,0,0,0,,Бай болса да, Пендекстер мырза кәмпиттерді қайта толтыратын.
Dialogue: 0,0:21:39.49,0:21:41.83,Default,,0,0,0,,Ағылшын графы болсаңыз да➡
Dialogue: 0,0:21:41.83,0:21:46.53,Default,,0,0,0,,Сіз Марилланың кәмпиттелген қара өріктеріне тәнті боласыз.
Dialogue: 0,0:21:49.90,0:21:52.81,Default,,0,0,0,,Мен енді ешқашан сепкілге қарсы дәрі қолданбаймын.
Dialogue: 0,0:21:52.81,0:21:55.31,Default,,0,0,0,,Мен ашық қызыл мұрынды жақсы көремін➡
Dialogue: 0,0:21:55.31,0:22:00.15,Default,,0,0,0,,Бірнеше сепкіл болса жақсы болар еді.
Dialogue: 0,0:22:00.15,0:22:03.45,Default,,0,0,0,,Бұл маған көбірек ұқсайды.
Dialogue: 0,0:22:05.12,0:22:15.03,Default,,0,0,0,,♬～
Dialogue: 0,0:22:15.03,0:22:17.80,Default,,0,0,0,,♬ «Маңыздысы»
Dialogue: 0,0:22:17.80,0:22:24.94,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.94,0:22:29.61,Default,,0,0,0,,♬ «Білмей тұрып өтетін қаладан»
Dialogue: 0,0:22:29.61,0:22:34.82,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.82,0:22:39.65,Default,,0,0,0,,♬ «Таң жарқыраған таңға»
Dialogue: 0,0:22:39.65,0:22:44.59,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.59,0:22:51.70,Default,,0,0,0,,♬ «Мен аңсаған дүние қабақтың сыртында»
Dialogue: 0,0:22:51.70,0:22:55.70,Default,,0,0,0,,♬ «Мен оны дұрыстап тауып, сонда бара аламын».
Dialogue: 0,0:22:55.70,0:23:00.84,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.84,0:23:06.01,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.01,0:23:10.58,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.58,0:23:15.56,Default,,0,0,0,,♬ «Сіз не сезінесіз, бәрі де».
Dialogue: 0,0:23:15.56,0:23:24.23,Default,,0,0,0,,♬ «Жүрегің қалаған жолмен жүр».
Dialogue: 0,0:23:24.23,0:23:29.47,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.47,0:23:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.38,0:23:52.09,Default,,0,0,0,,♬～
Dialogue: 0,0:23:52.09,0:23:57.30,Default,,0,0,0,,♬～
