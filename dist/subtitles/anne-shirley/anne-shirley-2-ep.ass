Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:03.23,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:00:06.13,0:00:08.57,Default,,0,0,0,,♬～
Dialogue: 0,0:00:08.57,0:00:11.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:11.47,0:00:13.68,Default,,0,0,0,,(Сиырдың улауы)
Dialogue: 0,0:00:15.91,0:00:17.85,Default,,0,0,0,,Жақсы…. (Мэтью Катберт) Энн...➡
Dialogue: 0,0:00:17.85,0:00:20.12,Default,,0,0,0,,Сіздің сүйікті тәттіңіз бар ма?
Dialogue: 0,0:00:20.12,0:00:23.95,Default,,0,0,0,,Хм... Шоколад/карамель?
Dialogue: 0,0:00:23.95,0:00:31.23,Default,,0,0,0,,♬～
Dialogue: 0,0:00:31.23,0:00:33.73,Default,,0,0,0,,Бұл! Өтінемін➡
Dialogue: 0,0:00:33.73,0:00:37.93,Default,,0,0,0,,Сіз мені басқа жаққа жібересіз бе, жоқ па, айта аласыз ба?
Dialogue: 0,0:00:37.93,0:00:40.20,Default,,0,0,0,,Егер ол жұмыс істемесе, онда ол анық айтады ...
Dialogue: 0,0:00:40.20,0:00:44.41,Default,,0,0,0,,Мен бұдан былай күте алмаймын!
Dialogue: 0,0:00:44.41,0:00:48.38,Default,,0,0,0,,Ыдыс-аяқты таза қайнаған сумен зарарсыздандырған жоқсыз. ➡
Dialogue: 0,0:00:48.38,0:00:51.18,Default,,0,0,0,,Далада болсам да, ессіз қалдым ➡
Dialogue: 0,0:00:51.18,0:00:53.18,Default,,0,0,0,,Бірдеңе сұраудың орнына➡
Dialogue: 0,0:00:53.18,0:00:56.42,Default,,0,0,0,,Мен өзім істеуім керек нәрсені істеуім керек.
Dialogue: 0,0:00:56.42,0:00:58.82,Default,,0,0,0,,...және біз сізді емдейміз➡
Dialogue: 0,0:00:58.82,0:01:01.12,Default,,0,0,0,,Мен оны сонда қалдыруды шештім.
Dialogue: 0,0:01:01.12,0:01:02.99,Default,,0,0,0,,Не? Әрине➡
Dialogue: 0,0:01:02.99,0:01:06.46,Default,,0,0,0,,Жақсы қыз болуға тырысқанша.
Dialogue: 0,0:01:06.46,0:01:08.70,Default,,0,0,0,,О? не болды?
Dialogue: 0,0:01:08.70,0:01:12.00,Default,,0,0,0,,Білмеймін... Мен бақыттымын...➡
Dialogue: 0,0:01:12.00,0:01:14.90,Default,,0,0,0,,А... бұл жеткіліксіз...
Dialogue: 0,0:01:14.90,0:01:17.41,Default,,0,0,0,,Мен өте бақыттымын...
Dialogue: 0,0:01:17.41,0:01:19.34,Default,,0,0,0,,Мен жақсы қыз боламын!
Dialogue: 0,0:01:19.34,0:01:21.28,Default,,0,0,0,,Мен бар күшімді саламын!
Dialogue: 0,0:01:21.28,0:01:24.71,Default,,0,0,0,,Бұл оңай емес шығар, бірақ...
Dialogue: 0,0:01:24.71,0:01:30.05,Default,,0,0,0,,Хехехе... Көз жасы мұңды да, қуантады да...
Dialogue: 0,0:01:30.05,0:01:34.72,Default,,0,0,0,,Мен қазір қуаныштан жылап отырмын...
Dialogue: 0,0:01:34.72,0:01:43.30,Default,,0,0,0,,♬～
Dialogue: 0,0:01:43.30,0:01:46.20,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:01:47.97,0:01:51.31,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:01:51.31,0:01:55.84,Default,,0,0,0,,Үлкен ара гүлден құлап түсті.
Dialogue: 0,0:01:55.84,0:01:57.91,Default,,0,0,0,,Қандай тамаша мекен!
Dialogue: 0,0:01:57.91,0:02:00.22,Default,,0,0,0,,Бұл шотланд раушан гүлі. а….
Dialogue: 0,0:02:00.22,0:02:06.09,Default,,0,0,0,,Матай сүйетін гүл. Оны анамыз отырғызған.
Dialogue: 0,0:02:06.09,0:02:08.86,Default,,0,0,0,,Марилла апайдың анасы?
Dialogue: 0,0:02:08.86,0:02:12.46,Default,,0,0,0,,Бұл не? Мендей анам ешқашан болған емес.
Dialogue: 0,0:02:12.46,0:02:16.43,Default,,0,0,0,,Одан гөрі мені «Кішкентай ана» деп атауды доғарыңыз. «Марилла» жақсы.
Dialogue: 0,0:02:16.43,0:02:21.87,Default,,0,0,0,,Мен сізді «Марилла ана» деп атағым келеді. Бұл адам өзін нағыз туыс сияқты сезінеді.
Dialogue: 0,0:02:21.87,0:02:26.81,Default,,0,0,0,,Бұл жақсы емес. Мен сенің нағыз туысың емеспін.
Dialogue: 0,0:02:26.81,0:02:29.31,Default,,0,0,0,,Мен түсіндім...
Dialogue: 0,0:02:29.31,0:02:32.25,Default,,0,0,0,,Бірақ сіз оны өз қиялыңызда қалағаныңызша атай аласыз!
Dialogue: 0,0:02:32.25,0:02:34.58,Default,,0,0,0,,Қалағаныңды істе.
Dialogue: 0,0:02:34.58,0:02:37.92,Default,,0,0,0,,Мариллада. Мен Огаваға қайырлы таң айтқым келеді!
Dialogue: 0,0:02:37.92,0:02:39.86,Default,,0,0,0,,Уау! Ахаха!
Dialogue: 0,0:02:39.86,0:02:41.86,Default,,0,0,0,,Тез жүрсең, құлайсың!
Dialogue: 0,0:02:41.86,0:02:44.49,Default,,0,0,0,,Уайымдамаңыз! (күрсіну)
Dialogue: 0,0:02:44.49,0:02:46.43,Default,,0,0,0,,(жүру дыбысы)
Dialogue: 0,0:02:46.43,0:02:49.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:49.36,0:02:52.13,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:02:52.13,0:02:54.07,Default,,0,0,0,,Қайырлы таң Рахила.
Dialogue: 0,0:02:54.07,0:02:57.54,Default,,0,0,0,,Ах! Әй... Әй, Марилла! Хаха….
Dialogue: 0,0:02:57.54,0:03:02.84,Default,,0,0,0,,２
Dialogue: 0,0:03:02.84,0:03:07.02,Default,,0,0,0,,...
Dialogue: 0,0:03:07.02,0:03:11.35,Default,,0,0,0,,...
Dialogue: 0,0:03:11.35,0:03:13.76,Default,,0,0,0,,Бұл қорқынышты апат болды.
Dialogue: 0,0:03:13.76,0:03:15.72,Default,,0,0,0,,…
Dialogue: 0,0:03:15.72,0:03:18.26,Default,,0,0,0,,Ол соншалықты жаман емес.
Dialogue: 0,0:03:18.26,0:03:22.13,Default,,0,0,0,,...
Dialogue: 0,0:03:22.13,0:03:24.17,Default,,0,0,0,,⚟Марилла~! а….
Dialogue: 0,0:03:24.17,0:03:26.80,Default,,0,0,0,,Ол балада солай ма?
Dialogue: 0,0:03:26.80,0:03:29.70,Default,,0,0,0,,➡
Dialogue: 0,0:03:29.70,0:03:33.58,Default,,0,0,0,,➡
Dialogue: 0,0:03:33.58,0:03:35.88,Default,,0,0,0,,Оның үстіне шашы қызыл!
Dialogue: 0,0:03:35.88,0:03:37.88,Default,,0,0,0,,Дәл сәбіз сияқты!
Dialogue: 0,0:03:37.88,0:03:42.65,Default,,0,0,0,,...
Dialogue: 0,0:03:42.65,0:03:47.39,Default,,0,0,0,,♬～
Dialogue: 0,0:03:47.39,0:03:49.36,Default,,0,0,0,,Мен кемпірлерді жек көремін! а….
Dialogue: 0,0:03:49.36,0:03:52.96,Default,,0,0,0,,Мен оны жек көремін! жек көру! Да~ Иккирай!
Dialogue: 0,0:03:52.96,0:03:54.90,Default,,0,0,0,,Энн! о?
Dialogue: 0,0:03:54.90,0:03:57.73,Default,,0,0,0,,Мені тым арық деп айтуға қалай дәтің бар!
Dialogue: 0,0:03:57.73,0:04:00.64,Default,,0,0,0,,...
Dialogue: 0,0:04:00.64,0:04:03.34,Default,,0,0,0,,⁉
Dialogue: 0,0:04:03.34,0:04:06.91,Default,,0,0,0,,Егер біреу сенің семіз, арсыз немесе қиялың жоқ деп айтса➡
Dialogue: 0,0:04:06.91,0:04:08.84,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:04:08.84,0:04:12.15,Default,,0,0,0,,...
Dialogue: 0,0:04:12.15,0:04:15.02,Default,,0,0,0,,...
Dialogue: 0,0:04:15.02,0:04:17.25,Default,,0,0,0,,Мен кемпірді кешірмеймін!
Dialogue: 0,0:04:17.25,0:04:19.79,Default,,0,0,0,,Мен сені ешқашан, ешқашан кешірмеймін!
Dialogue: 0,0:04:19.79,0:04:23.16,Default,,0,0,0,,Сәлем! Эй...эй!
Dialogue: 0,0:04:23.16,0:04:25.76,Default,,0,0,0,,Энн! Бөлмеңе қайт. Аа, аа, аа...
Dialogue: 0,0:04:25.76,0:04:29.36,Default,,0,0,0,,Мен бармайынша шықпа.
Dialogue: 0,0:04:29.36,0:04:31.77,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:04:34.00,0:04:35.94,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:04:35.94,0:04:38.37,Default,,0,0,0,,Мен мұндай қорқынышты баланы көрген емеспін.
Dialogue: 0,0:04:38.37,0:04:42.91,Default,,0,0,0,,Оның келбетіне түсініктеме беру жақсы емес, Рейчел.
Dialogue: 0,0:04:42.91,0:04:45.58,Default,,0,0,0,,Марилла? Сіз, мүмкін емес➡
Dialogue: 0,0:04:45.58,0:04:48.08,Default,,0,0,0,,Осылай қыздың иығында тұрғың келе ме?
Dialogue: 0,0:04:48.08,0:04:52.02,Default,,0,0,0,,Жоқ. Мен ол балаға кейінірек айтамын.
Dialogue: 0,0:04:52.02,0:04:55.82,Default,,0,0,0,,Бірақ мен де сен ол қызға тым көп айтып жатырсың деп ойлаймын!
Dialogue: 0,0:04:55.82,0:04:57.83,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:04:57.83,0:05:00.80,Default,,0,0,0,,…Жарайды. Алдағы уақытта да сақ боламын.
Dialogue: 0,0:05:00.80,0:05:05.17,Default,,0,0,0,,Бірақ кім екені белгісіз жетім бала соншалықты маңызды ма? ➡
Dialogue: 0,0:05:05.17,0:05:09.91,Default,,0,0,0,,Мен ашулы емеспін, солай ма? Тек сені аяймын.
Dialogue: 0,0:05:09.91,0:05:12.91,Default,,0,0,0,,Қайырлы күн!
Dialogue: 0,0:05:12.91,0:05:19.05,Default,,0,0,0,,Мен өмірімде бірінші рет осылай қорланып отырмын.
Dialogue: 0,0:05:19.05,0:05:21.15,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:05:24.92,0:05:30.06,Default,,0,0,0,,Энн Төсектен тұр.
Dialogue: 0,0:05:30.06,0:05:33.80,Default,,0,0,0,,Энн! ➡
Dialogue: 0,0:05:33.80,0:05:37.10,Default,,0,0,0,,Бұл керемет. Ұялмайсың ба?
Dialogue: 0,0:05:37.10,0:05:41.30,Default,,0,0,0,,Ол кісінің мені қызыл деп айтуға құқығы жоқ.
Dialogue: 0,0:05:41.30,0:05:43.34,Default,,0,0,0,,Сіз де.
Dialogue: 0,0:05:43.34,0:05:46.98,Default,,0,0,0,,Сіз әрқашан шашыңыздың түсі туралы айтасыз.
Dialogue: 0,0:05:46.98,0:05:49.51,Default,,0,0,0,,Адамдардың айтқаны басқа!
Dialogue: 0,0:05:49.51,0:05:53.28,Default,,0,0,0,,Қалай болғанда да, Рахиладан кешірім сұрау керек.
Dialogue: 0,0:05:53.28,0:05:56.18,Default,,0,0,0,,Мен мұны істей алмаймын. Неге!
Dialogue: 0,0:05:56.18,0:05:58.42,Default,,0,0,0,,Өйткені мен оны жаман емес деп ойлаймын!
Dialogue: 0,0:05:58.42,0:06:03.66,Default,,0,0,0,,Айтпасам да, кешіремін деп айта алмаймын!
Dialogue: 0,0:06:03.66,0:06:07.43,Default,,0,0,0,,Аа... Меніңше, сен жақсы қыз боларсың, солай ма?
Dialogue: 0,0:06:07.43,0:06:11.63,Default,,0,0,0,,А... Қатты тырысу керек емес пе?
Dialogue: 0,0:06:11.63,0:06:14.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:14.10,0:06:18.01,Default,,0,0,0,,Кешірім сұрағың келгенше осы бөлмеде бол.
Dialogue: 0,0:06:18.01,0:06:20.88,Default,,0,0,0,,Сонда сіз мәңгілікке осында боласыз.
Dialogue: 0,0:06:20.88,0:06:22.98,Default,,0,0,0,,Мұны рұқсатсыз жасаңыз!
Dialogue: 0,0:06:24.75,0:06:29.28,Default,,0,0,0,,күрсіну…. Ол нағыз қыңыр бала.
Dialogue: 0,0:06:29.28,0:06:32.79,Default,,0,0,0,,Еске алу Сәлем!
Dialogue: 0,0:06:32.79,0:06:35.69,Default,,0,0,0,,Хэхе...хехехе....
Dialogue: 0,0:06:35.69,0:06:40.66,Default,,0,0,0,,Хм... Сөйлеп тұрған кемпірге қиналғаным жақсы болды.
Dialogue: 0,0:06:40.66,0:06:45.90,Default,,0,0,0,,Матай! Ол балаға әдептілік үйретілмеген.
Dialogue: 0,0:06:45.90,0:06:49.67,Default,,0,0,0,,Дәлірек айтқанда, мен саған тамақ әкелемін, солай ма?
Dialogue: 0,0:06:49.67,0:06:53.17,Default,,0,0,0,,Әрине. Мен сені бөлмеден шығарамын. ➡
Dialogue: 0,0:06:53.17,0:06:56.08,Default,,0,0,0,,Сол бала кешірім сұраса.
Dialogue: 0,0:06:56.08,0:07:00.92,Default,,0,0,0,,(жәндіктердің дауысы)
Dialogue: 0,0:07:00.92,0:07:04.12,Default,,0,0,0,,(әтеш айқайлайды)
Dialogue: 0,0:07:04.12,0:07:09.36,Default,,0,0,0,,(әтеш айқайлайды)
Dialogue: 0,0:07:09.36,0:07:12.99,Default,,0,0,0,,...
Dialogue: 0,0:07:12.99,0:07:14.93,Default,,0,0,0,,Тыныш... (әтеш айқайлайды)
Dialogue: 0,0:07:17.17,0:07:19.13,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:07:19.13,0:07:21.57,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:07:21.57,0:07:26.78,Default,,0,0,0,,Жақсы, мен қалай болса да басқарып жатырмын. Бұл жалғыздық, бірақ мен оған үйренуім керек.
Dialogue: 0,0:07:26.78,0:07:32.95,Default,,0,0,0,,Міне, Энн. Жарайды... неліктен бұл мәселені шешуге тырыспайсыз?
Dialogue: 0,0:07:32.95,0:07:36.35,Default,,0,0,0,,Сіз Линдтің анасынан кешірім сұрайсыз ба?
Dialogue: 0,0:07:36.35,0:07:41.19,Default,,0,0,0,,Иә, солай. Тек барып мені жұбат. ➡
Dialogue: 0,0:07:41.19,0:07:45.06,Default,,0,0,0,,Біз мұнда мәңгі қала алмаймыз, солай емес пе?
Dialogue: 0,0:07:45.06,0:07:48.46,Default,,0,0,0,,Марилла сен айтқаннан кейін шегінбейді.
Dialogue: 0,0:07:48.46,0:07:53.00,Default,,0,0,0,,Мен мұны Мэтью үшін істей аламын! Мен бұл жаман болды деп айта аламын!
Dialogue: 0,0:07:53.00,0:07:56.40,Default,,0,0,0,,Егер Мэтью шынымен солай істегеніңді қаласа.
Dialogue: 0,0:07:56.40,0:08:00.81,Default,,0,0,0,,О, әрине. Мен сенің солай істегеніңді қалаймын.
Dialogue: 0,0:08:00.81,0:08:05.05,Default,,0,0,0,,Егер сіз төмен түспесеңіз, мен қатты жалғызсырайтын едім.
Dialogue: 0,0:08:05.05,0:08:07.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:07.02,0:08:10.45,Default,,0,0,0,,Марилла менің не айтқанымды білмеді, солай ма?
Dialogue: 0,0:08:10.45,0:08:12.39,Default,,0,0,0,,Хехе.
Dialogue: 0,0:08:12.39,0:08:15.66,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:08:15.66,0:08:19.43,Default,,0,0,0,,♬～
Dialogue: 0,0:08:19.43,0:08:22.23,Default,,0,0,0,,⚟Марилла? Эй.
Dialogue: 0,0:08:22.23,0:08:24.93,Default,,0,0,0,,Мен қатты өкінемін.
Dialogue: 0,0:08:24.93,0:08:28.17,Default,,0,0,0,,Мен Линдоның анасына осылай айтамын.
Dialogue: 0,0:08:28.17,0:08:31.11,Default,,0,0,0,,Жарайды. Бірге барайық.
Dialogue: 0,0:08:31.11,0:08:33.44,Default,,0,0,0,,(баспалдақтан түскен дыбыс)
Dialogue: 0,0:08:33.44,0:08:35.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:35.74,0:08:38.01,Default,,0,0,0,,Шынымен кешіріңіз... ➡
Dialogue: 0,0:08:38.01,0:08:40.88,Default,,0,0,0,,Анама айтқаным...
Dialogue: 0,0:08:40.88,0:08:42.82,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:42.82,0:08:44.82,Default,,0,0,0,,Мен оны елестетіп отырмын.
Dialogue: 0,0:08:44.82,0:08:48.92,Default,,0,0,0,,Линдоның анасынан қалай кешірім сұрауым керек...
Dialogue: 0,0:08:48.92,0:08:50.86,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:08:50.86,0:08:55.23,Default,,0,0,0,,(тоқыма дыбысы)
Dialogue: 0,0:08:55.23,0:08:57.47,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:57.47,0:09:00.17,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:09:00.17,0:09:02.17,Default,,0,0,0,,Хмм….
Dialogue: 0,0:09:04.07,0:09:08.64,Default,,0,0,0,,Әй, кішкентай ана! Мен өте өкінемін!
Dialogue: 0,0:09:08.64,0:09:11.11,Default,,0,0,0,,Ах…. А, күткендей...
Dialogue: 0,0:09:11.11,0:09:15.02,Default,,0,0,0,,Қанша өкінсем де, қандай сөз қолдансам да➡
Dialogue: 0,0:09:15.02,0:09:17.62,Default,,0,0,0,,Оны айта алмаймын!
Dialogue: 0,0:09:17.62,0:09:20.72,Default,,0,0,0,,Маған айтқаныңыздың бәрі рас!
Dialogue: 0,0:09:20.72,0:09:24.63,Default,,0,0,0,,Мен қызыл шашты, сепкілдері көп арық жігітпін!
Dialogue: 0,0:09:24.63,0:09:28.46,Default,,0,0,0,,Анама айтқаным да рас...
Dialogue: 0,0:09:28.46,0:09:30.40,Default,,0,0,0,,Ах...⁉
Dialogue: 0,0:09:30.40,0:09:32.73,Default,,0,0,0,,Бірақ сен олай айтпауың керек еді!
Dialogue: 0,0:09:32.73,0:09:34.40,Default,,0,0,0,,Әй, анашым...
Dialogue: 0,0:09:34.40,0:09:37.17,Default,,0,0,0,,Менің мінезім сұмдық болса да ➡
Dialogue: 0,0:09:37.17,0:09:41.04,Default,,0,0,0,,Кедей жетімге өмір бойы мұңды арту➡
Dialogue: 0,0:09:41.04,0:09:43.08,Default,,0,0,0,,Кішкентай ананың ешқашан істемейтіні➡
Dialogue: 0,0:09:43.08,0:09:45.21,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:09:45.21,0:09:47.85,Default,,0,0,0,,Енді мені кешіретініңді айт!
Dialogue: 0,0:09:47.85,0:09:50.49,Default,,0,0,0,,Ах... Өтінемін...
Dialogue: 0,0:09:50.49,0:09:52.42,Default,,0,0,0,,Бағана. ➡
Dialogue: 0,0:09:52.42,0:09:54.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:54.36,0:09:56.36,Default,,0,0,0,,Жүрек үні Бұл бала...➡
Dialogue: 0,0:09:56.36,0:09:58.36,Default,,0,0,0,,Мен көңілді жүрмін.
Dialogue: 0,0:09:58.36,0:10:01.60,Default,,0,0,0,,Ха…➡
Dialogue: 0,0:10:01.60,0:10:03.57,Default,,0,0,0,,Кел, жоғары қара.
Dialogue: 0,0:10:03.57,0:10:05.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:05.77,0:10:09.64,Default,,0,0,0,,Әрине мен сені кешіремін. Бұл рас па? аа. ➡
Dialogue: 0,0:10:09.64,0:10:12.67,Default,,0,0,0,,Мен де қорқынышты түрде айттым.
Dialogue: 0,0:10:12.67,0:10:15.11,Default,,0,0,0,,Негізі бұл мен білетін бала➡
Dialogue: 0,0:10:15.11,0:10:17.88,Default,,0,0,0,,Қызыл шашы әдемі қоңыр түске боялған бала болды.
Dialogue: 0,0:10:17.88,0:10:20.78,Default,,0,0,0,,Иә!? Сондықтан шашыңыз осылай көрінсе де➡
Dialogue: 0,0:10:20.78,0:10:23.02,Default,,0,0,0,,Бұл таңқаларлық емес.
Dialogue: 0,0:10:23.02,0:10:26.82,Default,,0,0,0,,Анам маған үміт сыйлады.
Dialogue: 0,0:10:26.82,0:10:29.62,Default,,0,0,0,,Сен менің жанашырымсың!
Dialogue: 0,0:10:29.62,0:10:33.60,Default,,0,0,0,,Сіз аман-есен шыққан сияқтысыз.
Dialogue: 0,0:10:33.60,0:10:35.96,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:10:35.96,0:10:38.00,Default,,0,0,0,,Менің Рахилаға айтар сөзім бар➡
Dialogue: 0,0:10:38.00,0:10:40.70,Default,,0,0,0,,Сені бақшада көруге рұқсат етіңізші.
Dialogue: 0,0:10:40.70,0:10:44.41,Default,,0,0,0,,Қаласаңыз, бұрыштағы ақ нарцисті теруге болады.
Dialogue: 0,0:10:44.41,0:10:47.08,Default,,0,0,0,,Рахмет! Хехе.
Dialogue: 0,0:10:47.08,0:10:49.84,Default,,0,0,0,,Ол баланың сөйлемдері басқаша болса да➡
Dialogue: 0,0:10:49.84,0:10:52.78,Default,,0,0,0,,Адамдарды қызықтыратын бір нәрсе бар.
Dialogue: 0,0:10:52.78,0:10:54.82,Default,,0,0,0,,Ол адал бала.
Dialogue: 0,0:10:54.82,0:10:58.62,Default,,0,0,0,,Маған ұнады, Марилла.
Dialogue: 0,0:10:58.62,0:11:02.46,Default,,0,0,0,,Әрине... бұл мені қобалжытты, бірақ бұл кешірім болды➡
Dialogue: 0,0:11:02.46,0:11:07.60,Default,,0,0,0,,Дегенмен, оны кешіргеніңіз үшін рахмет, Рэйчел.
Dialogue: 0,0:11:07.60,0:11:11.37,Default,,0,0,0,,Маған осындай әдемі гүлдер сыйлағаныңызға сене алар емеспін➡
Dialogue: 0,0:11:11.37,0:11:14.27,Default,,0,0,0,,Линдтің анасы шынымен мейірімді.
Dialogue: 0,0:11:14.27,0:11:20.07,Default,,0,0,0,,А, бірақ мен сенің әзірше олай кешірім сұрағаныңды қаламаймын.
Dialogue: 0,0:11:20.07,0:11:23.95,Default,,0,0,0,,Себебі менің сыртқы түрім туралы көп айтасың.
Dialogue: 0,0:11:23.95,0:11:26.38,Default,,0,0,0,,Сыртқы түрі соншалықты маңызды ма?
Dialogue: 0,0:11:26.38,0:11:28.45,Default,,0,0,0,,Мені соншалықты ұсқынсыз ететін ➡
Dialogue: 0,0:11:28.45,0:11:30.62,Default,,0,0,0,,Мен өте жақсы түсінемін.
Dialogue: 0,0:11:30.62,0:11:33.42,Default,,0,0,0,,Сонда да маған әдемі нәрселер ұнайды.
Dialogue: 0,0:11:33.42,0:11:38.79,Default,,0,0,0,,Айнада маған ұнамайтын нәрсе әрқашан көрінеді➡
Dialogue: 0,0:11:38.79,0:11:42.13,Default,,0,0,0,,Адамдардың сізге бұлай айту үшін барғанын қаламайсыз, солай ма?
Dialogue: 0,0:11:42.13,0:11:46.90,Default,,0,0,0,,Жүрегің әдемі болса, келбетің де әдемі көрінеді.
Dialogue: 0,0:11:46.90,0:11:49.40,Default,,0,0,0,,Мен бұған сене алмаймын.
Dialogue: 0,0:11:49.40,0:11:53.41,Default,,0,0,0,,Бірақ кешірім сұрап, кешірілу жақсы.
Dialogue: 0,0:11:55.21,0:11:58.11,Default,,0,0,0,,Марилла Үйде болғаным жақсы.
Dialogue: 0,0:11:58.11,0:12:01.95,Default,,0,0,0,,Сіздің үйіңіз деп шешілген жерге оралу.
Dialogue: 0,0:12:01.95,0:12:05.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:05.65,0:12:07.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:07.66,0:12:11.09,Default,,0,0,0,,Маған Green Gables ұнайды.
Dialogue: 0,0:12:11.09,0:12:14.46,Default,,0,0,0,,Осы уақытқа дейін менің сүйікті жерім болған емес➡
Dialogue: 0,0:12:14.46,0:12:20.37,Default,,0,0,0,,Марилла Мен қазір шынымен бақыттымын.
Dialogue: 0,0:12:20.37,0:12:23.17,Default,,0,0,0,,Жақсы қыз болғанша...➡
Dialogue: 0,0:12:23.17,0:12:28.14,Default,,0,0,0,,Мен әрқашан бақыттымын, Энн.
Dialogue: 0,0:12:28.14,0:12:32.05,Default,,0,0,0,,♬～
Dialogue: 0,0:12:33.82,0:12:35.75,Default,,0,0,0,,(Арба дыбысы)
Dialogue: 0,0:12:35.75,0:12:37.75,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:12:37.75,0:12:39.95,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:12:39.95,0:12:41.96,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:41.96,0:12:44.29,Default,,0,0,0,,Маған ұнады деп ойлаймын.
Dialogue: 0,0:12:44.29,0:12:49.26,Default,,0,0,0,,«Негізделген»? Мен тіккен киімдер саған не ұнамайды?
Dialogue: 0,0:12:49.26,0:12:52.17,Default,,0,0,0,,Мен оны бағалаймын, бірақ ол ескі.
Dialogue: 0,0:12:52.17,0:12:55.40,Default,,0,0,0,,Уф. Жеңдер сәл болса да шығып кетсе➡
Dialogue: 0,0:12:55.40,0:12:57.84,Default,,0,0,0,,Қуаныштан толқыдым деп ойлаймын. ⚟ (сиырдың улауы)
Dialogue: 0,0:12:57.84,0:13:00.38,Default,,0,0,0,,Қобалжымаңыз.
Dialogue: 0,0:13:00.38,0:13:03.75,Default,,0,0,0,,Бұл қалпақ тым қарапайым.
Dialogue: 0,0:13:03.75,0:13:08.98,Default,,0,0,0,,Күлсін... Е-е, менің бас ауруым ақыры күшейіп барады.
Dialogue: 0,0:13:08.98,0:13:12.35,Default,,0,0,0,,Шіркеуге өзіңіз барып, оқыңыз.
Dialogue: 0,0:13:12.35,0:13:14.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:14.29,0:13:17.09,Default,,0,0,0,,Мен ол жерден сенімді адам табамын деп ойлайсыз ба?
Dialogue: 0,0:13:17.09,0:13:20.86,Default,,0,0,0,,Сенімді адам? Бұл менің ең жақын досым туралы.
Dialogue: 0,0:13:20.86,0:13:23.60,Default,,0,0,0,,Одан кейін Диана Берли бар.
Dialogue: 0,0:13:23.60,0:13:26.27,Default,,0,0,0,,Арпа?
Dialogue: 0,0:13:26.27,0:13:30.00,Default,,0,0,0,,Берли тоғаны! «Жарқыраған көл суы»!
Dialogue: 0,0:13:30.00,0:13:33.31,Default,,0,0,0,,Аа... бүгін келе алмайтын сияқтысың➡
Dialogue: 0,0:13:33.31,0:13:37.25,Default,,0,0,0,,Ол сол тоғанның жанында тұрады және әдемі және өте сүйкімді қыз.
Dialogue: 0,0:13:37.25,0:13:41.15,Default,,0,0,0,,Менің сырласым сұлу болса, айтар сөзім болмас еді!
Dialogue: 0,0:13:41.15,0:13:45.05,Default,,0,0,0,,Маңыздысы оның сыртқы түрі емес, ішіндегісі.
Dialogue: 0,0:13:45.05,0:13:47.19,Default,,0,0,0,,Фуфу~ Диана~. ➡
Dialogue: 0,0:13:47.19,0:13:50.63,Default,,0,0,0,,Диана Берли Энн Ширли! Хехехе!
Dialogue: 0,0:13:50.63,0:13:52.93,Default,,0,0,0,,А... уау! Ха!
Dialogue: 0,0:13:52.93,0:13:58.87,Default,,0,0,0,,♬～
Dialogue: 0,0:13:58.87,0:14:01.97,Default,,0,0,0,,Хехе. Ах!
Dialogue: 0,0:14:01.97,0:14:03.94,Default,,0,0,0,,(дыбысты таңдау)
Dialogue: 0,0:14:03.94,0:14:08.78,Default,,0,0,0,,♬～
Dialogue: 0,0:14:08.78,0:14:10.78,Default,,0,0,0,,Ах. (Шіркеу қыздары) Иә?
Dialogue: 0,0:14:10.78,0:14:13.25,Default,,0,0,0,,Қараңыз. Қараңдар, қараңдар.
Dialogue: 0,0:14:13.25,0:14:15.18,Default,,0,0,0,,Гүлдер салынған.
Dialogue: 0,0:14:15.18,0:14:23.69,Default,,0,0,0,,♬～
Dialogue: 0,0:14:23.69,0:14:25.99,Default,,0,0,0,,Хехе.
Dialogue: 0,0:14:25.99,0:14:27.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:27.96,0:14:30.00,Default,,0,0,0,,Ах... а...➡
Dialogue: 0,0:14:30.00,0:14:32.10,Default,,0,0,0,,Уау! Ах! Ах...
Dialogue: 0,0:14:38.57,0:14:41.38,Default,,0,0,0,,Құдайдың да қолынан келмейтін нәрселер бар.
Dialogue: 0,0:14:41.38,0:14:43.78,Default,,0,0,0,,Жүрек үні Тіпті жеңдерім де томпайып... (Болл пастор) Соны айтсам да...
Dialogue: 0,0:14:43.78,0:14:46.41,Default,,0,0,0,,Жүрек үні Тіпті жеңдерім де томпайып... ➡
Dialogue: 0,0:14:46.41,0:14:48.38,Default,,0,0,0,,Бұл менікі...➡
Dialogue: 0,0:14:48.38,0:14:51.19,Default,,0,0,0,,Бұл менікі...
Dialogue: 0,0:14:51.19,0:14:53.99,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:57.63,0:15:00.43,Default,,0,0,0,,А... жақсы.
Dialogue: 0,0:15:02.26,0:15:04.77,Default,,0,0,0,,(Сиырдың улауы)
Dialogue: 0,0:15:04.77,0:15:09.44,Default,,0,0,0,,(терең тыныс алу дыбысы)
Dialogue: 0,0:15:09.44,0:15:12.24,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:15:12.24,0:15:16.91,Default,,0,0,0,,Ах... иә. Қысқа айналма жолдан кейін қайтып келдім.
Dialogue: 0,0:15:16.91,0:15:20.38,Default,,0,0,0,,(жүру дыбысы)
Dialogue: 0,0:15:20.38,0:15:23.32,Default,,0,0,0,,Рейчел дәл қазір осында болды.
Dialogue: 0,0:15:23.32,0:15:28.12,Default,,0,0,0,,Сіз шіркеуге гүлмен безендірілген қалпақпен бардыңыз ба?
Dialogue: 0,0:15:28.12,0:15:30.06,Default,,0,0,0,,Е... иә….
Dialogue: 0,0:15:30.06,0:15:35.40,Default,,0,0,0,,Мен мүлдем ақымақтық жасадым. Сіз жақсы күлген болуыңыз керек.
Dialogue: 0,0:15:35.40,0:15:39.27,Default,,0,0,0,,Бірақ... киіміне гүл киген балалар көп болды.
Dialogue: 0,0:15:39.27,0:15:41.20,Default,,0,0,0,,Сонда бұл қалпақ болар еді...
Dialogue: 0,0:15:41.20,0:15:44.61,Default,,0,0,0,,Мен қиындыққа тап болдым! а...!
Dialogue: 0,0:15:44.61,0:15:48.78,Default,,0,0,0,,Мен бәрінің бұл туралы жаман сөздер айтқанын естідім.
Dialogue: 0,0:15:48.78,0:15:51.25,Default,,0,0,0,,Менің ақыл-парасатым болмағандықтан болар➡
Dialogue: 0,0:15:51.25,0:15:53.95,Default,,0,0,0,,Сені олар сені солай етті деп ойлайтыныңа сенімдімін.
Dialogue: 0,0:15:53.95,0:15:55.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:55.88,0:15:58.29,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:15:58.29,0:16:00.22,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:16:00.22,0:16:03.06,Default,,0,0,0,,Мен Марилланы тағы да ұятқа қалдырдым...
Dialogue: 0,0:16:03.06,0:16:05.76,Default,,0,0,0,,Бұл менің ниетім емес еді...!
Dialogue: 0,0:16:05.76,0:16:08.00,Default,,0,0,0,,Мен өзімнен қорқамын.
Dialogue: 0,0:16:08.00,0:16:11.47,Default,,0,0,0,,Мен болашақта Мариллаға бұдан да көп қиындық тудыратыныма сенімдімін.
Dialogue: 0,0:16:11.47,0:16:14.00,Default,,0,0,0,,Балалар үйінде немесе кез келген жерде➡
Dialogue: 0,0:16:14.00,0:16:16.34,Default,,0,0,0,,Қайтарып жіберген дұрыс деп ойлаймын.
Dialogue: 0,0:16:16.34,0:16:20.01,Default,,0,0,0,,Грин Гейблсте қала алмайтыныма қатты өкінемін➡
Dialogue: 0,0:16:20.01,0:16:23.24,Default,,0,0,0,,Бұл Марилланы ұятқа қалдырғаннан жақсы...
Dialogue: 0,0:16:23.24,0:16:27.55,Default,,0,0,0,,Уф... у... ой...
Dialogue: 0,0:16:27.55,0:16:29.55,Default,,0,0,0,,Сіз не туралы айтып отырсыз? ➡
Dialogue: 0,0:16:29.55,0:16:33.15,Default,,0,0,0,,Мен сені балалар үйіне қайтарамын деп ойламаймын!
Dialogue: 0,0:16:33.15,0:16:37.49,Default,,0,0,0,,Иә, иә...! Мен сенің тым басқаша әрекет еткеніңді қаламаймын.
Dialogue: 0,0:16:37.49,0:16:39.96,Default,,0,0,0,,Сіздің үйіңіз осында. ➡
Dialogue: 0,0:16:39.96,0:16:41.93,Default,,0,0,0,,Тек Green Gables.
Dialogue: 0,0:16:41.93,0:16:44.23,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:16:44.23,0:16:46.10,Default,,0,0,0,,Иә, жақсы жаңалығым бар.
Dialogue: 0,0:16:46.10,0:16:48.77,Default,,0,0,0,,Диана бүгін түстен кейін үйге келді. ➡
Dialogue: 0,0:16:48.77,0:16:51.27,Default,,0,0,0,,Мен де сенімен бірге барамын.
Dialogue: 0,0:16:51.27,0:16:54.18,Default,,0,0,0,,Енді ше? Дәл қазір.
Dialogue: 0,0:16:54.18,0:16:56.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:58.05,0:17:00.95,Default,,0,0,0,,Марилла Мен қорқамын.
Dialogue: 0,0:17:00.95,0:17:04.85,Default,,0,0,0,,Диана мені ұнатпайтын болса ше...
Dialogue: 0,0:17:04.85,0:17:09.19,Default,,0,0,0,,Дәл қазір мен бұл аралдағы ең қобалжыған және қорқатын адаммын.
Dialogue: 0,0:17:09.19,0:17:11.13,Default,,0,0,0,,Бұл асыра сілтеу.
Dialogue: 0,0:17:11.13,0:17:13.96,Default,,0,0,0,,Диана сені міндетті түрде ұнатады. ➡
Dialogue: 0,0:17:13.96,0:17:17.27,Default,,0,0,0,,Бірақ сақтығыңызды төмендетпеңіз. Иә.
Dialogue: 0,0:17:17.27,0:17:20.74,Default,,0,0,0,,Диананың анасы өте қатал.
Dialogue: 0,0:17:20.74,0:17:22.67,Default,,0,0,0,,Иә! иә!
Dialogue: 0,0:17:22.67,0:17:26.34,Default,,0,0,0,,Қош келдіңіз. Ал, бұл бала...
Dialogue: 0,0:17:26.34,0:17:30.58,Default,,0,0,0,,Иә. Бұл жолы менің үйіме келген Энн Ширли.
Dialogue: 0,0:17:30.58,0:17:32.51,Default,,0,0,0,,Хмм. Ахх.
Dialogue: 0,0:17:32.51,0:17:35.25,Default,,0,0,0,,А... Энн соңында «e» әрпімен жазылған.
Dialogue: 0,0:17:35.25,0:17:37.18,Default,,0,0,0,,Жоқ... (Берли ханым) Иә?
Dialogue: 0,0:17:37.18,0:17:40.92,Default,,0,0,0,,Өзіңізді қалай сезінесіз? Энн?
Dialogue: 0,0:17:40.92,0:17:45.49,Default,,0,0,0,,Менде бәрі жақсы. Жүрегім аздап абыржыды, бірақ...
Dialogue: 0,0:17:45.49,0:17:48.90,Default,,0,0,0,,Хмм? Ха… ха ха… ха ха ха….
Dialogue: 0,0:17:48.90,0:17:53.73,Default,,0,0,0,,Мен де қуанамын, өйткені маңайда ойнайтын адам бар сияқты.
Dialogue: 0,0:17:53.73,0:17:57.61,Default,,0,0,0,,Диана. Біз бұл туралы бұрын айтқанбыз, солай ма? ➡
Dialogue: 0,0:17:57.61,0:18:01.08,Default,,0,0,0,,Бұл Энн Ширли, қазір Green Gables-те. ➡
Dialogue: 0,0:18:01.08,0:18:03.91,Default,,0,0,0,,Сен анда-санда сыртқа шық➡
Dialogue: 0,0:18:03.91,0:18:06.35,Default,,0,0,0,,Неге Аннаға бақшаны көрсетпейсің? (Диана Берли) Ах...
Dialogue: 0,0:18:06.35,0:18:08.65,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:18:08.65,0:18:10.59,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:18:10.59,0:18:12.89,Default,,0,0,0,,♬～
Dialogue: 0,0:18:12.89,0:18:16.66,Default,,0,0,0,,Сізге кітап ұнайды ма? Е... иә.
Dialogue: 0,0:18:16.66,0:18:20.53,Default,,0,0,0,,Ілгерім түскенде, күні бойы оқимын.
Dialogue: 0,0:18:20.53,0:18:25.23,Default,,0,0,0,,Маған әсерлі, трагедиялық және романтикалық оқиғалар ұнайды.
Dialogue: 0,0:18:25.23,0:18:29.14,Default,,0,0,0,,Бірақ анам кітап оқу көзге зиян дейді.
Dialogue: 0,0:18:29.14,0:18:32.34,Default,,0,0,0,,Сондықтан өз маңайыңызда достар табыңыз➡
Dialogue: 0,0:18:32.34,0:18:36.21,Default,,0,0,0,,Мені көбірек алып кеткіңіз келетініне сенімдімін!
Dialogue: 0,0:18:36.21,0:18:38.78,Default,,0,0,0,,Ах. кешіріңіз….
Dialogue: 0,0:18:38.78,0:18:40.72,Default,,0,0,0,,Мен саған бір қорқынышты нәрсе айтып тұрмын ба?
Dialogue: 0,0:18:40.72,0:18:45.35,Default,,0,0,0,,Ха... «Мидианның қорқынышты күнінде өлтірілді➡
Dialogue: 0,0:18:45.35,0:18:48.79,Default,,0,0,0,,Атты әскер сияқты жылдам.
Dialogue: 0,0:18:48.79,0:18:51.69,Default,,0,0,0,,Аа... солай шығар...
Dialogue: 0,0:18:51.69,0:18:54.60,Default,,0,0,0,,Иә, мен оны бүгін шіркеуде оқыдым.
Dialogue: 0,0:18:54.60,0:18:59.57,Default,,0,0,0,,Пастордың әңгімесі қызықсыз болды, бірақ бұл үзінді мені тітіркендірді.
Dialogue: 0,0:18:59.57,0:19:03.00,Default,,0,0,0,,Қайғылы және өте қызықты, солай ма?
Dialogue: 0,0:19:03.00,0:19:05.01,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:19:05.01,0:19:08.71,Default,,0,0,0,,Сәлем Диана. Диана маған ғашық бола ала ма?
Dialogue: 0,0:19:08.71,0:19:10.68,Default,,0,0,0,,Не? Иә!?
Dialogue: 0,0:19:10.68,0:19:13.18,Default,,0,0,0,,Сен менің сырласым бола аласың ба?
Dialogue: 0,0:19:13.18,0:19:15.45,Default,,0,0,0,,Хм... Фукушин?
Dialogue: 0,0:19:15.45,0:19:17.42,Default,,0,0,0,,Басқаша айтқанда, мен оның болғанын қалаймын.
Dialogue: 0,0:19:17.42,0:19:20.25,Default,,0,0,0,,Менікі! Менің ең жақын досыма!
Dialogue: 0,0:19:20.25,0:19:22.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:22.19,0:19:24.13,Default,,0,0,0,,Аа... а….
Dialogue: 0,0:19:24.13,0:19:27.33,Default,,0,0,0,,Фуфуфуфуфу…фуфуфуфуфуфуфуфу!
Dialogue: 0,0:19:27.33,0:19:30.23,Default,,0,0,0,,Хахаха! иә?
Dialogue: 0,0:19:30.23,0:19:35.57,Default,,0,0,0,,Менің қолымнан келеді деп ойлаймын. Мен, сен Грин Гейблске келдіңіз➡
Dialogue: 0,0:19:35.57,0:19:38.34,Default,,0,0,0,,Мен қазір шынымен бақыттымын.
Dialogue: 0,0:19:38.34,0:19:40.34,Default,,0,0,0,,Ах...! Олай болса➡
Dialogue: 0,0:19:40.34,0:19:43.21,Default,,0,0,0,,Менің ең жақын досым болуға уәде бере аласың ба?
Dialogue: 0,0:19:43.21,0:19:46.48,Default,,0,0,0,,Жақсы. Мен не істеуім керек?
Dialogue: 0,0:19:46.48,0:19:48.45,Default,,0,0,0,,Алдымен қолыңызды шығарыңыз.
Dialogue: 0,0:19:48.45,0:19:50.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:57.69,0:20:00.10,Default,,0,0,0,,Менен кейін ант ет.
Dialogue: 0,0:20:00.10,0:20:05.27,Default,,0,0,0,,Ха... «Күн мен ай қанша уақытқа созылады➡
Dialogue: 0,0:20:05.27,0:20:09.27,Default,,0,0,0,,Менің сырласым Диана Берлиге адал бол➡
Dialogue: 0,0:20:09.27,0:20:11.81,Default,,0,0,0,,Мен бұл туралы салтанатты түрде ант етемін.
Dialogue: 0,0:20:11.81,0:20:14.08,Default,,0,0,0,,Хехехе. иә?
Dialogue: 0,0:20:14.08,0:20:17.28,Default,,0,0,0,,Мен сені шынымен ұнатамын деп ойлаймын.
Dialogue: 0,0:20:17.28,0:20:19.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:19.28,0:20:23.15,Default,,0,0,0,,Ант етемін! Аннаның соңына «e» қосыңыз.
Dialogue: 0,0:20:23.15,0:20:26.95,Default,,0,0,0,,Ха... «Күн мен ай қанша уақытқа созылғанша➡
Dialogue: 0,0:20:26.95,0:20:30.49,Default,,0,0,0,,Менің сырласым Энн Ширлиге адал болу➡
Dialogue: 0,0:20:30.49,0:20:33.06,Default,,0,0,0,,Мен бұл туралы салтанатты түрде ант етемін.
Dialogue: 0,0:20:33.06,0:20:37.03,Default,,0,0,0,,Сіз қалай ойлайсыз? Жарайды! «Е» сезімі тамаша!
Dialogue: 0,0:20:37.03,0:20:39.73,Default,,0,0,0,,Айтпақшы, «Мидиан» дегеніміз не?
Dialogue: 0,0:20:39.73,0:20:42.17,Default,,0,0,0,,Келіңіздер ме? «Жарайды?» Мен айттым...
Dialogue: 0,0:20:42.17,0:20:47.01,Default,,0,0,0,,Сіз дәл қазір осы аралда ең бақытты көрінесіз.
Dialogue: 0,0:20:47.01,0:20:48.94,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:20:48.94,0:20:52.21,Default,,0,0,0,,Диананың туған күні ақпанда, ал менікі наурызда.
Dialogue: 0,0:20:52.21,0:20:54.82,Default,,0,0,0,,Қандай таңғаларлық сәйкестік.
Dialogue: 0,0:20:54.82,0:21:00.29,Default,,0,0,0,,Диананың көздері өте рухани. Менің де көзім сондай болса...
Dialogue: 0,0:21:00.29,0:21:04.49,Default,,0,0,0,,Содан кейін Диана маған келесі жолы сурет салатынын айтты.
Dialogue: 0,0:21:04.49,0:21:06.43,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:06.43,0:21:10.26,Default,,0,0,0,,Бірақ адамдар менің жұмысымды да ұмытып кетсе, мен қиналып қалар едім.
Dialogue: 0,0:21:10.26,0:21:13.17,Default,,0,0,0,,Дұрыс... Мен де бірдеңе➡
Dialogue: 0,0:21:13.17,0:21:16.77,Default,,0,0,0,,Дианаға беретін бірдеңе бар деп үміттенемін...
Dialogue: 0,0:21:19.71,0:21:23.48,Default,,0,0,0,,Себебі сіз шоколад пен карамельді жақсы көресіз➡
Dialogue: 0,0:21:23.48,0:21:25.48,Default,,0,0,0,,Мен аз мөлшерде сатып алдым.
Dialogue: 0,0:21:25.48,0:21:27.72,Default,,0,0,0,,Рахмет сізге Мэтью!
Dialogue: 0,0:21:27.72,0:21:30.38,Default,,0,0,0,,Аа, осындай нәрсе. иә?
Dialogue: 0,0:21:30.38,0:21:33.35,Default,,0,0,0,,Бұл баланың тісіне де, асқазанына да жақсы емес.
Dialogue: 0,0:21:33.35,0:21:35.36,Default,,0,0,0,,Е... Ах...
Dialogue: 0,0:21:35.36,0:21:37.53,Default,,0,0,0,,Бұл бетті жасама. ➡
Dialogue: 0,0:21:37.53,0:21:41.46,Default,,0,0,0,,Жақсы, жақсы. Мэтью оны маған сатып алу үшін барын салды. ➡
Dialogue: 0,0:21:41.46,0:21:43.70,Default,,0,0,0,,Оны жеуге болады.
Dialogue: 0,0:21:43.70,0:21:45.93,Default,,0,0,0,,Шынымен!? Ах.
Dialogue: 0,0:21:45.93,0:21:48.20,Default,,0,0,0,,Хехехе. Бірақ барлығын бірден жеуге болмайды.
Dialogue: 0,0:21:48.20,0:21:51.97,Default,,0,0,0,,Иә. Мен бүгін кешке тек біреуін ұстанамын.
Dialogue: 0,0:21:51.97,0:21:56.28,Default,,0,0,0,,Хехе осының жартысын Дианаға берсем бола ма?
Dialogue: 0,0:21:56.28,0:21:59.18,Default,,0,0,0,,Иә. Сосын екінші жартысы➡
Dialogue: 0,0:21:59.18,0:22:01.12,Default,,0,0,0,,Бұл екі есе дәмді болады!
Dialogue: 0,0:22:01.12,0:22:03.38,Default,,0,0,0,,Дианаға беретін бірдеңе бар деп ойлаған кезде➡
Dialogue: 0,0:22:03.38,0:22:05.69,Default,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:22:05.69,0:22:17.43,Default,,0,0,0,,♬～
Dialogue: 0,0:22:17.43,0:22:19.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:21.24,0:22:24.81,Default,,0,0,0,,Оның келгеніне 3 апта ғана болды➡
Dialogue: 0,0:22:24.81,0:22:28.58,Default,,0,0,0,,Ол жерде мәңгі болған сияқты. ➡
Dialogue: 0,0:22:28.58,0:22:30.95,Default,,0,0,0,,Ол баласыз енді мынау не үй➡
Dialogue: 0,0:22:30.95,0:22:33.65,Default,,0,0,0,,Мен оны елестете де алмаймын.
Dialogue: 0,0:22:36.38,0:22:40.25,Default,,0,0,0,,Хмм. Сіз менің айтқанымдай сияқтысыз.
Dialogue: 0,0:22:40.25,0:22:43.72,Default,,0,0,0,,Иә, иә, сол баланы асырап алғаныма қуаныштымын➡
Dialogue: 0,0:22:43.72,0:22:46.13,Default,,0,0,0,,Мен мұны қуана мойындаймын.
Dialogue: 0,0:22:47.70,0:22:51.50,Default,,0,0,0,,Хмм? не. Табандысыз, аға.
Dialogue: 0,0:22:51.50,0:22:53.83,Default,,0,0,0,,Фуфуфуфуфу!
Dialogue: 0,0:22:53.83,0:22:57.64,Default,,0,0,0,,Жүрек үні Тәңірім, Дос таптым бүгін. ➡
Dialogue: 0,0:22:57.64,0:23:01.11,Default,,0,0,0,,Оларға карамель беріп жатқаныңызды елестетіп көріңіз➡
Dialogue: 0,0:23:01.11,0:23:03.04,Default,,0,0,0,,Өзімді сондай бақытты сезінемін➡
Dialogue: 0,0:23:03.04,0:23:04.98,Default,,0,0,0,,Ол мұны сіз үшін жасайды. ➡
Dialogue: 0,0:23:04.98,0:23:09.55,Default,,0,0,0,,Диана бақытты бола ма деп ойлаймын.
Dialogue: 0,0:23:09.55,0:23:22.93,Default,,0,0,0,,♬～
Dialogue: 0,0:23:22.93,0:23:25.17,Default,,0,0,0,,Жүрек үні Қайырлы түн. ➡
Dialogue: 0,0:23:25.17,0:23:27.67,Default,,0,0,0,,Жасыл Гейблс Аннасы.
Dialogue: 0,0:23:29.37,0:23:32.67,Default,,0,0,0,,Жүрек үні Қайырлы түн.
Dialogue: 0,0:23:35.18,0:23:49.39,Default,,0,0,0,,♬～
Dialogue: 0,0:23:49.39,0:23:57.30,Default,,0,0,0,,♬～
