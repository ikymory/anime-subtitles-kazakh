Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.77,0:00:08.17,Default,,0,0,0,,Күлсін... Ол баламен не істерімді білмеймін.
Dialogue: 0,0:00:08.17,0:00:12.47,Default,,0,0,0,,Еске алу (Энн Ширли) Сондықтан мен енді ешқашан мектепке бармаймын.
Dialogue: 0,0:00:12.47,0:00:15.24,Default,,0,0,0,,Онымен сөйлесе бастасаң, ол тыңдамайды...
Dialogue: 0,0:00:15.24,0:00:20.38,Default,,0,0,0,,Ммм... 10 бала тәрбиелеп өсірген адам ретінде менің ойымша...➡
Dialogue: 0,0:00:20.38,0:00:23.59,Default,,0,0,0,,Оны біраз уақытқа қалдырыңыз және не болатынын көріңіз.
Dialogue: 0,0:00:23.59,0:00:26.59,Default,,0,0,0,,Сонымен, мен оны демалуым керек деп ойлайсыз ба?
Dialogue: 0,0:00:26.59,0:00:29.39,Default,,0,0,0,,Иә, бала өзі айтқанша➡
Dialogue: 0,0:00:29.39,0:00:34.00,Default,,0,0,0,,«Мектеп» деген сөзді айтпай, оны қадағалаңыз.
Dialogue: 0,0:00:34.00,0:00:36.43,Default,,0,0,0,,Хмм….
Dialogue: 0,0:00:36.43,0:00:40.07,Default,,0,0,0,,Бір аптадан кейін өз бетіңізше бара аласыз.
Dialogue: 0,0:00:40.07,0:00:42.04,Default,,0,0,0,,Осындай нәрсе ме?
Dialogue: 0,0:00:42.04,0:00:44.34,Default,,0,0,0,,Екінші жағынан, егер сіз...
Dialogue: 0,0:00:44.34,0:00:46.74,Default,,0,0,0,,Иә? Дәл қазір сол қызды алыңыз➡
Dialogue: 0,0:00:46.74,0:00:48.71,Default,,0,0,0,,Мені жіберейін десең➡
Dialogue: 0,0:00:48.71,0:00:52.55,Default,,0,0,0,,Бұл бұрынғыдан да қиын болуы мүмкін.
Dialogue: 0,0:00:52.55,0:00:54.52,Default,,0,0,0,,Ах…. (жылау)
Dialogue: 0,0:00:54.52,0:00:57.75,Default,,0,0,0,,Анн. Не болды?
Dialogue: 0,0:00:57.75,0:01:00.09,Default,,0,0,0,,Маған Диана ұнайды...
Dialogue: 0,0:01:00.09,0:01:03.13,Default,,0,0,0,,Мен Дианасыз өмір сүре алмаймын...
Dialogue: 0,0:01:03.13,0:01:05.59,Default,,0,0,0,,Дианамен бірдеңе болды ма?
Dialogue: 0,0:01:05.59,0:01:07.56,Default,,0,0,0,,Умм…➡
Dialogue: 0,0:01:07.56,0:01:09.80,Default,,0,0,0,,Диана есейгенде➡
Dialogue: 0,0:01:09.80,0:01:11.73,Default,,0,0,0,,Саған үйленетініне сенімдімін...
Dialogue: 0,0:01:11.73,0:01:14.64,Default,,0,0,0,,Мен қалдым...
Dialogue: 0,0:01:14.64,0:01:17.47,Default,,0,0,0,,Сонда мен не істеуім керек?
Dialogue: 0,0:01:17.47,0:01:21.24,Default,,0,0,0,,Мен Диананың күйеуін жек көремін! хехе... хехехе...
Dialogue: 0,0:01:21.24,0:01:23.18,Default,,0,0,0,,Мен сені қатты жек көремін!
Dialogue: 0,0:01:23.18,0:01:25.15,Default,,0,0,0,,Уф! (Мэтью Катберт) Иә?
Dialogue: 0,0:01:25.15,0:01:28.98,Default,,0,0,0,,Хехехе... Қиялдың болғаны жақсы➡
Dialogue: 0,0:01:28.98,0:01:30.99,Default,,0,0,0,,Оны асыра алмаңыз.
Dialogue: 0,0:01:30.99,0:01:34.72,Default,,0,0,0,,Иә. Мен ертең түстен кейін шығамын➡
Dialogue: 0,0:01:34.72,0:01:38.29,Default,,0,0,0,,Диананы шайға шақыру керек.
Dialogue: 0,0:01:38.29,0:01:40.93,Default,,0,0,0,,Ал... Марилла шынымен...?
Dialogue: 0,0:01:40.93,0:01:45.50,Default,,0,0,0,,Шкафтың екінші сөресінде құлпынай суы бар, оны екеуің де ішіңдер. ➡
Dialogue: 0,0:01:45.50,0:01:49.04,Default,,0,0,0,,Тортты кесіп, печенье жеуге болады.
Dialogue: 0,0:01:49.04,0:01:51.27,Default,,0,0,0,,Бұл тамаша...
Dialogue: 0,0:01:51.27,0:01:54.04,Default,,0,0,0,,Тіпті Марилланың да қиялы бар.
Dialogue: 0,0:01:54.04,0:01:56.75,Default,,0,0,0,,Егер жоқ болса, мен осыны күткен едім➡
Dialogue: 0,0:01:56.75,0:01:58.71,Default,,0,0,0,,Нені білмеу керек!
Dialogue: 0,0:01:58.71,0:02:00.65,Default,,0,0,0,,Керемет! Не деген шай➡
Dialogue: 0,0:02:00.65,0:02:03.25,Default,,0,0,0,,Мен өзімді ересек адамға айналғандай сезінемін! Хахаха.
Dialogue: 0,0:02:03.25,0:02:12.36,Default,,0,0,0,,♬～
Dialogue: 0,0:02:12.36,0:02:17.03,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:02:17.03,0:02:19.57,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:02:19.57,0:02:21.50,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:02:21.50,0:02:25.37,Default,,0,0,0,,♬ «Мен ойларды оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:02:25.37,0:02:27.71,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:27.71,0:02:29.95,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:29.95,0:02:34.48,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:02:34.48,0:02:39.69,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін.»
Dialogue: 0,0:02:39.69,0:02:41.62,Default,,0,0,0,,♬ «Ол маған айтты».
Dialogue: 0,0:02:41.62,0:02:45.49,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:45.49,0:02:48.90,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:48.90,0:02:51.33,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:02:51.33,0:02:53.60,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:02:53.60,0:02:57.84,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:02:57.84,0:03:00.24,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:03:00.24,0:03:02.58,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:03:02.58,0:03:06.05,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:03:06.05,0:03:09.35,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:03:09.35,0:03:11.59,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:03:11.59,0:03:15.86,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:03:15.86,0:03:18.36,Default,,0,0,0,,♬ «Мен санауды күтемін.»
Dialogue: 0,0:03:18.36,0:03:20.66,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:03:20.66,0:03:23.00,Default,,0,0,0,,♬ «Мен сені алып кетемін».
Dialogue: 0,0:03:23.00,0:03:26.90,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:26.90,0:03:30.81,Default,,0,0,0,,♬～
Dialogue: 0,0:03:33.51,0:03:38.28,Default,,0,0,0,,♬～
Dialogue: 0,0:03:42.15,0:03:45.15,Default,,0,0,0,,⚟ (жүгіру дыбысы)
Dialogue: 0,0:03:47.82,0:03:50.43,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:03:50.43,0:03:53.96,Default,,0,0,0,,Сізге рахмет, мен өте жақсы жұмыс істеп жатырмын.
Dialogue: 0,0:03:53.96,0:03:56.26,Default,,0,0,0,,Аа... Куку….
Dialogue: 0,0:03:56.26,0:04:00.87,Default,,0,0,0,,Шай ішкіңіз келе ме? Фуфуфу!
Dialogue: 0,0:04:02.67,0:04:08.98,Default,,0,0,0,,Есімде дұрыс болса, құлпынай суы шкафтың екінші сөресінде...
Dialogue: 0,0:04:08.98,0:04:11.58,Default,,0,0,0,,Міне.
Dialogue: 0,0:04:13.25,0:04:15.75,Default,,0,0,0,,Марилланың ерекше құлпынай суы.
Dialogue: 0,0:04:15.75,0:04:19.05,Default,,0,0,0,,Ләззат алыңыз.
Dialogue: 0,0:04:19.05,0:04:23.56,Default,,0,0,0,,Бұл өте әдемі түс. Мен мұны ұнатамын.
Dialogue: 0,0:04:25.26,0:04:27.26,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:04:27.26,0:04:29.70,Default,,0,0,0,,Құлпынай суының соншалықты дәмді екеніне сене алар емеспін➡
Dialogue: 0,0:04:29.70,0:04:31.67,Default,,0,0,0,,Мен білмедім!
Dialogue: 0,0:04:31.67,0:04:34.17,Default,,0,0,0,,Сізге ұнағанына қуаныштымын!
Dialogue: 0,0:04:34.17,0:04:40.08,Default,,0,0,0,,Қалағаныңызша ішіңіз. Мен пештегі отты тамашалауға барамын.
Dialogue: 0,0:04:40.08,0:04:43.95,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:04:43.95,0:04:46.95,Default,,0,0,0,,Өте дәмді!
Dialogue: 0,0:04:50.02,0:04:53.22,Default,,0,0,0,,Күрсін...! Хехе.
Dialogue: 0,0:04:55.72,0:05:00.43,Default,,0,0,0,,Басқа сусын туралы не айтасыз? Мен аламын.
Dialogue: 0,0:05:02.43,0:05:06.97,Default,,0,0,0,,Бұндай дәмді бірінші рет көріп тұр. Бұл анадан мүлдем басқаша.
Dialogue: 0,0:05:06.97,0:05:09.64,Default,,0,0,0,,Марилла өте жақсы аспаз.
Dialogue: 0,0:05:09.64,0:05:12.47,Default,,0,0,0,,Бірақ тамақ пісіру тек ережелерді сақтау болып табылады➡
Dialogue: 0,0:05:12.47,0:05:14.44,Default,,0,0,0,,Қиялға орын жоқ. Күрсіну….
Dialogue: 0,0:05:14.44,0:05:16.78,Default,,0,0,0,,Жасалу жолын үйретеді➡
Dialogue: 0,0:05:16.78,0:05:20.65,Default,,0,0,0,,Өйткені мен әр түрлі нәрселерді елестетемін... (шу)
Dialogue: 0,0:05:20.65,0:05:23.39,Default,,0,0,0,,Диана, не болды?
Dialogue: 0,0:05:23.39,0:05:27.69,Default,,0,0,0,,Мен... Мен өзімді өте нашар сезінемін...
Dialogue: 0,0:05:27.69,0:05:29.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.62,0:05:32.39,Default,,0,0,0,,Амансың ба? Сонымен... Сіз диванға жатқыңыз келе ме?
Dialogue: 0,0:05:32.39,0:05:35.10,Default,,0,0,0,,Мен... үйге бара жатырмын...
Dialogue: 0,0:05:35.10,0:05:38.00,Default,,0,0,0,,Бірақ... Мен әлі шай ішкен жоқпын...
Dialogue: 0,0:05:38.00,0:05:42.40,Default,,0,0,0,,Үйге бару…. Түсіндім. Мен сені үйге апарамын.
Dialogue: 0,0:05:42.40,0:05:44.51,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:05:53.15,0:05:55.95,Default,,0,0,0,,Ана... Марилла сонда ма?
Dialogue: 0,0:05:55.95,0:05:59.32,Default,,0,0,0,,Мен шығамын. Кіріңіз. Мен шай дайындаймын.
Dialogue: 0,0:05:59.32,0:06:03.56,Default,,0,0,0,,О, жарайды. Мен жай ғана жағдайды білу үшін тоқтадым. ➡
Dialogue: 0,0:06:03.56,0:06:06.66,Default,,0,0,0,,Сонда кездескенше. Иә.
Dialogue: 0,0:06:08.76,0:06:11.07,Default,,0,0,0,,Энн, сен...➡
Dialogue: 0,0:06:11.07,0:06:13.57,Default,,0,0,0,,Дианаға не іштің?
Dialogue: 0,0:06:13.57,0:06:15.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:15.97,0:06:18.87,Default,,0,0,0,,Диананы мас қылдың!? (Анна жылайды)
Dialogue: 0,0:06:18.87,0:06:21.78,Default,,0,0,0,,Маған не іштірдің?
Dialogue: 0,0:06:21.78,0:06:24.18,Default,,0,0,0,,Жай ғана құлпынай суы...
Dialogue: 0,0:06:24.18,0:06:27.48,Default,,0,0,0,,Мен ешкімнің құлпынай суына мас болғанын естіген емеспін...
Dialogue: 0,0:06:27.48,0:06:29.42,Default,,0,0,0,,Тіпті Диана➡ сияқты
Dialogue: 0,0:06:29.42,0:06:32.22,Default,,0,0,0,,Үш үлкен стақан ішсем де...
Dialogue: 0,0:06:32.22,0:06:36.09,Default,,0,0,0,,Анн. Сіз қиындық тудыратын данышпансыз.
Dialogue: 0,0:06:36.09,0:06:40.93,Default,,0,0,0,,Ол Дианаға құлпынай суын емес, шарап берді.
Dialogue: 0,0:06:40.93,0:06:43.16,Default,,0,0,0,,Шарап...?
Dialogue: 0,0:06:43.16,0:06:45.70,Default,,0,0,0,,Құлпынай суы жертөледе сақталды. ➡
Dialogue: 0,0:06:45.70,0:06:48.67,Default,,0,0,0,,Мен сізге қате айттым...
Dialogue: 0,0:06:48.67,0:06:51.37,Default,,0,0,0,,Иә!? Сіз ішкен жоқсыз ба?
Dialogue: 0,0:06:51.37,0:06:55.68,Default,,0,0,0,,Иә... өйткені олар қонақжайлылық көрсетуге барынша тырысты.
Dialogue: 0,0:06:55.68,0:06:59.11,Default,,0,0,0,,Диана Берлидің анасынан не болғанын сұрады.
Dialogue: 0,0:06:59.11,0:07:01.75,Default,,0,0,0,,Тек дауыстап күліңіз➡
Dialogue: 0,0:07:01.75,0:07:05.52,Default,,0,0,0,,Кішкентай ана сол демді иіскеп, мас екенін түсінді.
Dialogue: 0,0:07:05.52,0:07:08.42,Default,,0,0,0,,Мен қатты ашуланып тұрмын...
Dialogue: 0,0:07:08.42,0:07:12.29,Default,,0,0,0,,Мен енді Диананың менімен ойнауына жол бермеймін...
Dialogue: 0,0:07:12.29,0:07:14.86,Default,,0,0,0,,Уф... у... ой...!
Dialogue: 0,0:07:14.86,0:07:18.47,Default,,0,0,0,,Иә, мен Берли мырзамен сөйлесемін. (жылау)
Dialogue: 0,0:07:18.47,0:07:20.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:20.40,0:07:23.31,Default,,0,0,0,,Бұл жазықсыз қателік болды.
Dialogue: 0,0:07:23.31,0:07:28.04,Default,,0,0,0,,Онымен дұрыс сөйлессең, Арпа-сан да түсінеді.
Dialogue: 0,0:07:28.04,0:07:31.35,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:07:34.22,0:07:36.92,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:07:38.75,0:07:40.69,Default,,0,0,0,,…Марилла?
Dialogue: 0,0:07:40.69,0:07:44.46,Default,,0,0,0,,Жоқ, менің ойымша, ешкім ондай надан емес. ➡
Dialogue: 0,0:07:44.46,0:07:48.36,Default,,0,0,0,,Мен сізге бұл мүлдем дұрыс емес екенін және бұл Аннаның кінәсі емес екенін айттым➡
Dialogue: 0,0:07:48.36,0:07:50.60,Default,,0,0,0,,Мен сенбеймін. сурет….
Dialogue: 0,0:07:50.60,0:07:52.63,Default,,0,0,0,,Бірден үш стакан шарап ішуге болмайды➡
Dialogue: 0,0:07:52.63,0:07:55.47,Default,,0,0,0,,Мен мысқылдап едім. Иә...?
Dialogue: 0,0:07:55.47,0:07:57.97,Default,,0,0,0,,А... аа...!
Dialogue: 0,0:07:57.97,0:08:01.21,Default,,0,0,0,,Ха... ха... ха...!
Dialogue: 0,0:08:01.21,0:08:04.11,Default,,0,0,0,,Ал ол мақтаныш – шайқас мақтанышы, зорлық-зомбылық мақтанышы.
Dialogue: 0,0:08:04.11,0:08:06.11,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:08:06.11,0:08:08.75,Default,,0,0,0,,Кішкентай ана, мені кешіріңіз!
Dialogue: 0,0:08:08.75,0:08:12.55,Default,,0,0,0,,Диананы мас қылайын деген ойым болған жоқ!
Dialogue: 0,0:08:12.55,0:08:17.39,Default,,0,0,0,,Елестетіңізші, анамның әлемдегі жалғыз сырласы бар!
Dialogue: 0,0:08:17.39,0:08:21.26,Default,,0,0,0,,Ең жақын досыңды мас қылу үшін барын салар ма едің?
Dialogue: 0,0:08:21.26,0:08:23.93,Default,,0,0,0,,Өтінемін, мен саған енді Дианамен ойнауға рұқсат бермеймін➡
Dialogue: 0,0:08:23.93,0:08:25.87,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:08:25.87,0:08:27.87,Default,,0,0,0,,Олай болса, Ана ➡
Dialogue: 0,0:08:27.87,0:08:31.34,Default,,0,0,0,,Өмірімді мұңның қара бұлты жауар!
Dialogue: 0,0:08:31.34,0:08:33.58,Default,,0,0,0,,Осындай театрландырылған жолдармен➡
Dialogue: 0,0:08:33.58,0:08:35.54,Default,,0,0,0,,Үлкендерді мазақ ету...
Dialogue: 0,0:08:35.54,0:08:37.75,Default,,0,0,0,,Менде сен бар➡
Dialogue: 0,0:08:37.75,0:08:39.71,Default,,0,0,0,,Дианамен кездескен дұрыс қыз кім?
Dialogue: 0,0:08:39.71,0:08:41.92,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:08:41.92,0:08:44.65,Default,,0,0,0,,Үйге барып, тыныш бол. Күте тұрыңыз!
Dialogue: 0,0:08:44.65,0:08:46.72,Default,,0,0,0,,Енді мен Дианамен қоштасамын➡
Dialogue: 0,0:08:46.72,0:08:48.86,Default,,0,0,0,,Сізбен кездесуге рұқсат бересіз бе?
Dialogue: 0,0:08:48.86,0:08:50.79,Default,,0,0,0,,Диана қазір ұйықтап жатыр.
Dialogue: 0,0:08:50.79,0:08:53.73,Default,,0,0,0,,Қайтадан қош келдіңіз! Әй, бірақ...!
Dialogue: 0,0:08:53.73,0:08:56.16,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:08:56.16,0:08:58.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.80,0:09:03.17,Default,,0,0,0,,Жүрегімнің үні, соңғы үмітім➡
Dialogue: 0,0:09:03.17,0:09:05.11,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:09:05.11,0:09:07.08,Default,,0,0,0,,Ах…. Ах...
Dialogue: 0,0:09:07.08,0:09:10.98,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:09:17.79,0:09:19.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:22.32,0:09:26.76,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:09:26.76,0:09:28.96,Default,,0,0,0,,Диана!
Dialogue: 0,0:09:31.33,0:09:35.97,Default,,0,0,0,,Анаң мені әлі кешірмейді...
Dialogue: 0,0:09:35.97,0:09:38.54,Default,,0,0,0,,Мен жыладым...
Dialogue: 0,0:09:38.54,0:09:41.21,Default,,0,0,0,,Мен сізге бұл Энн кінәлі емес екенін бірнеше рет айтсам да...
Dialogue: 0,0:09:41.21,0:09:46.68,Default,,0,0,0,,Көп ренжіткеннен кейін маған қоштасуға 10 минут уақыт берілді...
Dialogue: 0,0:09:46.68,0:09:52.25,Default,,0,0,0,,Мәңгі қоштасамыз... 10 минут аз уақыт...
Dialogue: 0,0:09:52.25,0:09:55.79,Default,,0,0,0,,О, Диана…. Маған уәде беріңізші.
Dialogue: 0,0:09:55.79,0:09:59.26,Default,,0,0,0,,Болашақта қанша адаммен жақын аралассам да➡
Dialogue: 0,0:09:59.26,0:10:03.70,Default,,0,0,0,,Мен жас кезімдегі досымды ешқашан ұмытпауым керек...
Dialogue: 0,0:10:03.70,0:10:05.67,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:05.67,0:10:09.57,Default,,0,0,0,,Оның үстіне менің сырластарым да, жақын достарым да болмайды.
Dialogue: 0,0:10:09.57,0:10:11.77,Default,,0,0,0,,Кім болсаң да➡
Dialogue: 0,0:10:11.77,0:10:14.14,Default,,0,0,0,,Мен сені сүйгендей сүйе алмаймын...
Dialogue: 0,0:10:14.14,0:10:16.08,Default,,0,0,0,,Ал, Диана...!
Dialogue: 0,0:10:16.08,0:10:18.38,Default,,0,0,0,,Сіз мені шынымен жақсы көресіз бе?
Dialogue: 0,0:10:18.38,0:10:22.05,Default,,0,0,0,,Әрине! Анна білмеді ме?
Dialogue: 0,0:10:22.05,0:10:27.72,Default,,0,0,0,,Мен сені сүйесің деп ойладым, бірақ сен мені сүйеді деп ешқашан күтпедім...
Dialogue: 0,0:10:27.72,0:10:30.29,Default,,0,0,0,,О, бұл тамаша!
Dialogue: 0,0:10:30.29,0:10:33.53,Default,,0,0,0,,Диана, қайталап айтшы.
Dialogue: 0,0:10:33.53,0:10:36.56,Default,,0,0,0,,Мен сені шын жүрегіммен жақсы көремін, Энн.
Dialogue: 0,0:10:36.56,0:10:39.73,Default,,0,0,0,,Бұдан былай әрқашан осылай болады.
Dialogue: 0,0:10:39.73,0:10:41.67,Default,,0,0,0,,Мен де, бұдан былай➡
Dialogue: 0,0:10:41.67,0:10:44.17,Default,,0,0,0,,Мен Диананы әрқашан жақсы көремін.
Dialogue: 0,0:10:47.84,0:10:52.75,Default,,0,0,0,,Маған естелік ретінде бір бұрым шашыңызды бере аласыз ба?
Dialogue: 0,0:10:55.25,0:10:58.45,Default,,0,0,0,,Жарайсың ба? Иә.
Dialogue: 0,0:11:01.69,0:11:05.26,Default,,0,0,0,,Жүрек үні Қош бол, қымбатты досым. ➡
Dialogue: 0,0:11:05.26,0:11:08.16,Default,,0,0,0,,Біз енді бөтен боламыз➡
Dialogue: 0,0:11:08.16,0:11:10.47,Default,,0,0,0,,Менің жүрегім...➡
Dialogue: 0,0:11:10.47,0:11:14.67,Default,,0,0,0,,Мен сенімен мәңгі бірге боламын. ➡
Dialogue: 0,0:11:14.67,0:11:17.57,Default,,0,0,0,,Мен саған адал боламын...
Dialogue: 0,0:11:19.27,0:11:24.15,Default,,0,0,0,,♬～
Dialogue: 0,0:11:24.15,0:11:27.05,Default,,0,0,0,,(әтеш айқайлайды)
Dialogue: 0,0:11:28.88,0:11:30.82,Default,,0,0,0,,Мен мектепке қайта барамын.
Dialogue: 0,0:11:30.82,0:11:33.62,Default,,0,0,0,,Енді мен сырласымнан айырылдым➡
Dialogue: 0,0:11:33.62,0:11:36.42,Default,,0,0,0,,Маған тек мектеп қалды.
Dialogue: 0,0:11:36.42,0:11:39.69,Default,,0,0,0,,Мектепте Диананы алыстан көруге болады...
Dialogue: 0,0:11:39.69,0:11:42.20,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:42.20,0:11:47.10,Default,,0,0,0,,Онда біреудің басынан шифермен ұрма.
Dialogue: 0,0:11:47.10,0:11:49.70,Default,,0,0,0,,Мен үлгілі оқушы боламын!
Dialogue: 0,0:11:49.70,0:11:51.91,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:11:54.68,0:11:56.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:56.81,0:11:59.28,Default,,0,0,0,,Энн! (Джейн Эндрюс) Сіз оралдыңыз!
Dialogue: 0,0:11:59.28,0:12:01.32,Default,,0,0,0,,♬～
Dialogue: 0,0:12:01.32,0:12:04.12,Default,,0,0,0,,Энн!
Dialogue: 0,0:12:04.12,0:12:06.05,Default,,0,0,0,,♬～
Dialogue: 0,0:12:06.05,0:12:08.59,Default,,0,0,0,,Өтінемін. Ләззат алыңыз.
Dialogue: 0,0:12:08.59,0:12:11.03,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:12:11.03,0:12:12.96,Default,,0,0,0,,Энн Бұл.
Dialogue: 0,0:12:12.96,0:12:15.20,Default,,0,0,0,,Не?
Dialogue: 0,0:12:15.20,0:12:17.27,Default,,0,0,0,,Қандай әдемі!
Dialogue: 0,0:12:17.27,0:12:19.20,Default,,0,0,0,,Рахмет сізге Элла! Хехе.
Dialogue: 0,0:12:19.20,0:12:21.24,Default,,0,0,0,,Энн Мынаны да қабыл алыңыз.
Dialogue: 0,0:12:21.24,0:12:23.40,Default,,0,0,0,,Менен де қабыл алыңыз.
Dialogue: 0,0:12:23.40,0:12:26.81,Default,,0,0,0,,Барлығыңызға рахмет. Мен оны бағалаймын!
Dialogue: 0,0:12:26.81,0:12:29.41,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:12:29.41,0:12:31.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:31.68,0:12:34.58,Default,,0,0,0,,Баршаның қастерлі болғаны қандай жақсы.
Dialogue: 0,0:12:34.58,0:12:36.52,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:12:36.52,0:12:39.45,Default,,0,0,0,,Мұғалімнің айтқанын тыңдайтыныңызға сенімдісіз бе?
Dialogue: 0,0:12:39.45,0:12:41.49,Default,,0,0,0,,Әрине.
Dialogue: 0,0:12:41.49,0:12:44.69,Default,,0,0,0,,Бірақ Диана менің көзіме қарамайды.
Dialogue: 0,0:12:44.69,0:12:48.96,Default,,0,0,0,,Маған бір-ақ рет күліп қарасаңшы...
Dialogue: 0,0:12:48.96,0:12:52.90,Default,,0,0,0,,Енді бүгін бәріміз үйреніп жатқан осы мектеп ғимараты туралы айтайық➡
Dialogue: 0,0:12:52.90,0:12:55.20,Default,,0,0,0,,Оқушыларға эссе жазу. ➡
Dialogue: 0,0:12:55.20,0:12:57.74,Default,,0,0,0,,Ең алдымен тақтаға жазылады➡
Dialogue: 0,0:12:57.74,0:13:00.07,Default,,0,0,0,,Оларды осы ретпен жазып көріңіз.
Dialogue: 0,0:13:00.07,0:13:02.04,Default,,0,0,0,,«Сағынышты Аннаға.➡
Dialogue: 0,0:13:02.04,0:13:06.25,Default,,0,0,0,,Анам мектепте де сенімен сөйлесуге рұқсат жоқ дейді. ➡
Dialogue: 0,0:13:06.25,0:13:09.05,Default,,0,0,0,,Бірақ өтінемін, мені жек көрме. ➡
Dialogue: 0,0:13:09.05,0:13:10.99,Default,,0,0,0,,Мен бұрынғыдаймын➡
Dialogue: 0,0:13:10.99,0:13:12.92,Default,,0,0,0,,Мен сені сүйемін.''
Dialogue: 0,0:13:12.92,0:13:16.46,Default,,0,0,0,,Ах…. Менде түсіндіретін нәрсе бар. ➡
Dialogue: 0,0:13:16.46,0:13:19.79,Default,,0,0,0,,Сонымен, сауатты жаза білген бала...
Dialogue: 0,0:13:19.79,0:13:21.73,Default,,0,0,0,,Иә? Олай етпеген балалар да болды
Dialogue: 0,0:13:21.73,0:13:23.77,Default,,0,0,0,,Мәселе мынада….
Dialogue: 0,0:13:23.77,0:13:25.93,Default,,0,0,0,,«Сүйікті Дианаға.➡
Dialogue: 0,0:13:25.93,0:13:27.90,Default,,0,0,0,,Мен сені қалай жек көремін? ➡
Dialogue: 0,0:13:27.90,0:13:31.84,Default,,0,0,0,,Біздің жүрегіміз бір-бірімен тығыз байланысты. ➡
Dialogue: 0,0:13:31.84,0:13:36.21,Default,,0,0,0,,Бүгін түнде сенің хатыңды жастығымның астына қойып ұйықтаймын. ➡
Dialogue: 0,0:13:36.21,0:13:39.11,Default,,0,0,0,,Корделиядан немесе сіздің Аннаңыздан».
Dialogue: 0,0:13:39.11,0:13:42.02,Default,,0,0,0,,Әзірше осы.
Dialogue: 0,0:13:42.02,0:13:44.49,Default,,0,0,0,,Энн Ширли.
Dialogue: 0,0:13:44.49,0:13:46.95,Default,,0,0,0,,Сіз жапон тілін жақсы білесіз, солай емес пе?
Dialogue: 0,0:13:46.95,0:13:49.96,Default,,0,0,0,,Маған бір нәрсе айтқым келеді...
Dialogue: 0,0:13:49.96,0:13:52.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:52.16,0:13:54.40,Default,,0,0,0,,Энн шынымен сенімен сөйлеспейді.
Dialogue: 0,0:13:54.40,0:13:58.23,Default,,0,0,0,,Балалар сендер оқуларыңда бір-бірлеріңмен жарысасыңдар.
Dialogue: 0,0:13:58.23,0:14:02.10,Default,,0,0,0,,Математикадан бүгінгі нөмірі бірінші ➡
Dialogue: 0,0:14:02.10,0:14:05.71,Default,,0,0,0,,Гилберт.
Dialogue: 0,0:14:07.44,0:14:09.41,Default,,0,0,0,,Математикадан бүгінгі нөмірі бірінші ➡
Dialogue: 0,0:14:09.41,0:14:12.58,Default,,0,0,0,,Бұл Анн. (Оқушылар) Уау...!
Dialogue: 0,0:14:12.58,0:14:15.85,Default,,0,0,0,,Уау...!
Dialogue: 0,0:14:15.85,0:14:20.05,Default,,0,0,0,,Гилберт пен Энн бүгінде математикадан бірінші орынды иемденді.
Dialogue: 0,0:14:20.05,0:14:22.12,Default,,0,0,0,,Ах...! а….
Dialogue: 0,0:14:22.12,0:14:25.56,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:14:25.56,0:14:29.96,Default,,0,0,0,,Мен ешқашан математикаға ғашық болмаймын.
Dialogue: 0,0:14:29.96,0:14:32.50,Default,,0,0,0,,Қиялға орын жоқ сияқты.
Dialogue: 0,0:14:32.50,0:14:37.27,Default,,0,0,0,,Бірақ Гил... басқа балалардың кейбірі бұған жақсы.
Dialogue: 0,0:14:37.27,0:14:39.21,Default,,0,0,0,,Тіпті Диана…➡
Dialogue: 0,0:14:39.21,0:14:42.81,Default,,0,0,0,,Диананың мені ұрғаны маған бәрібір...
Dialogue: 0,0:14:42.81,0:14:47.62,Default,,0,0,0,,Енді бір-бірімізді танымайтындай әрекет етеміз...➡
Dialogue: 0,0:14:47.62,0:14:51.42,Default,,0,0,0,,Менің Дианаға деген махаббатым ешқашан өлмейді.
Dialogue: 0,0:14:51.42,0:14:53.82,Default,,0,0,0,,Мен Дианамен сөйлесе алмаймын➡
Dialogue: 0,0:14:53.82,0:14:55.76,Default,,0,0,0,,Өте өкінішті...
Dialogue: 0,0:14:55.76,0:14:57.79,Default,,0,0,0,,Хм…. Бірақ ➡
Dialogue: 0,0:14:57.79,0:15:00.09,Default,,0,0,0,,Осындай қызық әлемде➡
Dialogue: 0,0:15:00.09,0:15:03.10,Default,,0,0,0,,Иә, мен мәңгілік мұңая алмаймын.
Dialogue: 0,0:15:03.10,0:15:05.27,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:15:05.27,0:15:07.20,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:15:07.20,0:15:10.74,Default,,0,0,0,,Қиындық болса да, Мен оны тамаша жеңемін.
Dialogue: 0,0:15:10.74,0:15:13.64,Default,,0,0,0,,Хехе. Енді жеп, аяқта.
Dialogue: 0,0:15:13.64,0:15:15.74,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:19.25,0:15:23.12,Default,,0,0,0,,<Сол жылдың қысында бір оқиға болды. ➡
Dialogue: 0,0:15:23.12,0:15:28.92,Default,,0,0,0,,Бұл аралға Канаданың премьер-министрі келеді екен. ➡
Dialogue: 0,0:15:28.92,0:15:34.60,Default,,0,0,0,,Сөзді тыңдауға ауылдың көптеген үлкендері шықты. ➡
Dialogue: 0,0:15:34.60,0:15:38.13,Default,,0,0,0,,Бірақ бұл жалғыз оқиға емес еді.
Dialogue: 0,0:15:43.77,0:15:47.28,Default,,0,0,0,,Марилласыз түндер өткізу жақсы.
Dialogue: 0,0:15:47.28,0:15:49.78,Default,,0,0,0,,Ах.
Dialogue: 0,0:15:49.78,0:15:52.15,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:52.15,0:15:54.62,Default,,0,0,0,,Диана! не болды?
Dialogue: 0,0:15:54.62,0:15:57.49,Default,,0,0,0,,Анаң сені ақыры кешірді ме?
Dialogue: 0,0:15:57.49,0:15:59.49,Default,,0,0,0,,Жоқ! а….
Dialogue: 0,0:15:59.49,0:16:02.96,Default,,0,0,0,,Энн, менің үйіме кел! Минни Мэй біртүрлі әрекет етеді!
Dialogue: 0,0:16:02.96,0:16:04.89,Default,,0,0,0,,Бұл ларингит болуы мүмкін!
Dialogue: 0,0:16:04.89,0:16:07.56,Default,,0,0,0,,Иә? Анам мен әкем жоқ➡
Dialogue: 0,0:16:07.56,0:16:10.60,Default,,0,0,0,,Мэри не істерін білмеген сияқты...
Dialogue: 0,0:16:10.60,0:16:13.20,Default,,0,0,0,,Мен қорқамын...
Dialogue: 0,0:16:13.20,0:16:15.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:15.14,0:16:18.34,Default,,0,0,0,,Жарайды! Мэтью дәрігерді алып кетуге кетті.
Dialogue: 0,0:16:18.34,0:16:20.58,Default,,0,0,0,,Ларингитпен ауырса не істеу керек➡
Dialogue: 0,0:16:20.58,0:16:23.24,Default,,0,0,0,,Білемін, өйткені мен оған күтуші едім.
Dialogue: 0,0:16:23.24,0:16:26.45,Default,,0,0,0,,Бір минут күтіңіз. Мен дәрі әкелемін.
Dialogue: 0,0:16:26.45,0:16:29.35,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:16:29.35,0:16:33.05,Default,,0,0,0,,Ах... а... (Есіктің ашылған дыбысы) Ах!
Dialogue: 0,0:16:33.05,0:16:36.92,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:16:36.92,0:16:38.86,Default,,0,0,0,,Энн... қалай?
Dialogue: 0,0:16:38.86,0:16:41.16,Default,,0,0,0,,Менің ойымша, бұл ларингит.
Dialogue: 0,0:16:41.16,0:16:43.56,Default,,0,0,0,,Егіздердің 3 жиынтығымен бірдей.
Dialogue: 0,0:16:43.56,0:16:46.87,Default,,0,0,0,,Менің жүрегімдегі дауыс өте нашар, бірақ... Ха... ха... ха....
Dialogue: 0,0:16:46.87,0:16:50.47,Default,,0,0,0,,Ауыспалы киім мен фланель мата... Мен оны дереу дайындаймын.
Dialogue: 0,0:16:50.47,0:16:54.94,Default,,0,0,0,,Мэри Суды көп қайнатыңыз. (Мэри) Иә!
Dialogue: 0,0:16:54.94,0:17:00.25,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:17:00.25,0:17:03.92,Default,,0,0,0,,Кел, Минни Мэй. Осыны байқап көрейік.
Dialogue: 0,0:17:03.92,0:17:06.25,Default,,0,0,0,,Хмм. а….
Dialogue: 0,0:17:06.25,0:17:10.09,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:17:10.09,0:17:12.03,Default,,0,0,0,,Кехо Кехо!
Dialogue: 0,0:17:12.03,0:17:13.96,Default,,0,0,0,,Иә, сен жақсы қызсың.
Dialogue: 0,0:17:13.96,0:17:15.96,Default,,0,0,0,,(боранның дыбысы)
Dialogue: 0,0:17:15.96,0:17:27.98,Default,,0,0,0,,♬～
Dialogue: 0,0:17:30.44,0:17:33.35,Default,,0,0,0,,Тұншығып қаламын ба...
Dialogue: 0,0:17:35.92,0:17:38.82,Default,,0,0,0,,Минни Мэй⁉ Минни Мэй, мықты бол!
Dialogue: 0,0:17:38.82,0:17:40.82,Default,,0,0,0,,Минни Мэй!
Dialogue: 0,0:17:45.73,0:17:48.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:48.36,0:17:52.23,Default,,0,0,0,,Матай! Кешіріңіз. Мен Спенсер Веллге барып, кешігіп қалдым.
Dialogue: 0,0:17:52.23,0:17:55.24,Default,,0,0,0,,Науқас кім? Мынау.
Dialogue: 0,0:18:00.01,0:18:02.01,Default,,0,0,0,,Иә... ➡
Dialogue: 0,0:18:02.01,0:18:05.41,Default,,0,0,0,,Сіз тынышсыз. (2 адам) Ах...!
Dialogue: 0,0:18:05.41,0:18:08.42,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:18:08.42,0:18:12.09,Default,,0,0,0,,Мен бұл жақсы емес шығар деп ойладым...
Dialogue: 0,0:18:12.09,0:18:14.99,Default,,0,0,0,,Тұншығып қаламын ба деп қорқамын...
Dialogue: 0,0:18:14.99,0:18:17.89,Default,,0,0,0,,Сіз дәрі қабылдадыңыз ба?
Dialogue: 0,0:18:17.89,0:18:19.83,Default,,0,0,0,,Ипикаку.
Dialogue: 0,0:18:19.83,0:18:22.73,Default,,0,0,0,,Соңғы жұтымды жұтқаннан кейін өзімді әлдеқайда жақсы сезіндім.
Dialogue: 0,0:18:22.73,0:18:24.73,Default,,0,0,0,,Мұғалім…➡
Dialogue: 0,0:18:24.73,0:18:26.90,Default,,0,0,0,,Мен қаншалықты жеңілдеп қалдым➡
Dialogue: 0,0:18:26.90,0:18:28.84,Default,,0,0,0,,Мен мұны сіздің қиялыңызға қалдырамын.
Dialogue: 0,0:18:28.84,0:18:31.21,Default,,0,0,0,,Сөзбен айтып жеткізу қиын.
Dialogue: 0,0:18:31.21,0:18:35.81,Default,,0,0,0,,Сөзбен айтып жеткізу мүмкін емес нәрселер бар ғой, солай емес пе?
Dialogue: 0,0:18:37.85,0:18:39.78,Default,,0,0,0,,Таңертеңгілік күн қандай әдемі.
Dialogue: 0,0:18:39.78,0:18:42.15,Default,,0,0,0,,Мен ақ аязды әлемде өмір сүремін➡
Dialogue: 0,0:18:42.15,0:18:44.15,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:18:44.15,0:18:49.86,Default,,0,0,0,,Аа... Ұйқым келіп тұр... Бүгін сабаққа бара аламын ба...
Dialogue: 0,0:18:49.86,0:18:56.13,Default,,0,0,0,,Бірақ мен үзіліс жасағым келмейді... Өйткені... басқа біреу...
Dialogue: 0,0:18:56.13,0:19:00.33,Default,,0,0,0,,О... мен бірінші боламын...
Dialogue: 0,0:19:00.33,0:19:02.87,Default,,0,0,0,,Мен мұны қайталайтыныңызға сенімдімін➡
Dialogue: 0,0:19:02.87,0:19:06.21,Default,,0,0,0,,Сіз ең жақсы бола аласыз.
Dialogue: 0,0:19:06.21,0:19:08.74,Default,,0,0,0,,Бұл баланың өмірін кім құтқарды➡
Dialogue: 0,0:19:08.74,0:19:11.65,Default,,0,0,0,,Катберттер отбасынан шыққан қызыл шашты кішкентай қыз.
Dialogue: 0,0:19:11.65,0:19:13.68,Default,,0,0,0,,Ах…. сурет….
Dialogue: 0,0:19:13.68,0:19:17.15,Default,,0,0,0,,Егер ол бала болмаса, кеш болуы мүмкін.
Dialogue: 0,0:19:17.15,0:19:19.09,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:19:19.09,0:19:22.06,Default,,0,0,0,,Маған сол баланың көзі туралы айтыңыз➡
Dialogue: 0,0:19:22.06,0:19:24.73,Default,,0,0,0,,Оны немен салыстырар едіңіз? ➡
Dialogue: 0,0:19:24.73,0:19:27.43,Default,,0,0,0,,Сөзбен айтып жеткізе алмаймын...
Dialogue: 0,0:19:33.13,0:19:36.10,Default,,0,0,0,,Қайтадан қош келдіңіз, Марилла.
Dialogue: 0,0:19:36.10,0:19:38.11,Default,,0,0,0,,Сіз аштыңыз ба?
Dialogue: 0,0:19:38.11,0:19:41.78,Default,,0,0,0,,Қазанда көже бар. ➡
Dialogue: 0,0:19:41.78,0:19:46.35,Default,,0,0,0,,Сондай-ақ тәтті жасыл алхоры.
Dialogue: 0,0:19:46.35,0:19:49.22,Default,,0,0,0,,Мен Юбе туралы Мэтьюден естідім.
Dialogue: 0,0:19:49.22,0:19:51.22,Default,,0,0,0,,Сізге сәттілік. ➡
Dialogue: 0,0:19:51.22,0:19:54.49,Default,,0,0,0,,Мен болсам, мен бұл туралы ештеңе істей алмас едім. ➡
Dialogue: 0,0:19:54.49,0:19:59.33,Default,,0,0,0,,Мен ларингитпен ауырған адамды ешқашан көрген емеспін.
Dialogue: 0,0:19:59.33,0:20:04.27,Default,,0,0,0,,Марилла Бұл менмін... Тамақ ішіп отырып сөйлеме. ➡
Dialogue: 0,0:20:04.27,0:20:08.04,Default,,0,0,0,,Мен сенің сөйлейтініңді білемін, бірақ➡
Dialogue: 0,0:20:08.04,0:20:11.14,Default,,0,0,0,,Әңгіме бұзылмайды.
Dialogue: 0,0:20:14.28,0:20:16.21,Default,,0,0,0,,⚟ (тұру дыбысы)
Dialogue: 0,0:20:16.21,0:20:20.08,Default,,0,0,0,,Енді, Анн. Берлидің әйелін бұрын көрдім➡
Dialogue: 0,0:20:20.08,0:20:26.22,Default,,0,0,0,,Минни Мэйдің өмірін сақтап қалғаныңыз үшін рахмет және шарапқа дөрекі болғаныңыз үшін кешірім сұраңыз.
Dialogue: 0,0:20:26.22,0:20:28.16,Default,,0,0,0,,А...?
Dialogue: 0,0:20:28.16,0:20:30.39,Default,,0,0,0,,Содан кейін қайталап көріңіз➡
Dialogue: 0,0:20:30.39,0:20:32.73,Default,,0,0,0,,Ол менің Дианамен тіл табысқанымды қалайды.
Dialogue: 0,0:20:32.73,0:20:34.70,Default,,0,0,0,,Ах... Марилла!
Dialogue: 0,0:20:34.70,0:20:37.43,Default,,0,0,0,,Дәл қазір Дианаға баруға бола ма?
Dialogue: 0,0:20:37.43,0:20:39.73,Default,,0,0,0,,Үйге келгенде ыдыс жуамын.
Dialogue: 0,0:20:39.73,0:20:42.70,Default,,0,0,0,,Жарайды, жарайды. Қазір барыңыз.
Dialogue: 0,0:20:42.70,0:20:45.44,Default,,0,0,0,,Мен қалпақ пен пальтомды қазір әкелемін...
Dialogue: 0,0:20:45.44,0:20:47.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:47.37,0:20:49.31,Default,,0,0,0,,Мүлдем емес... ➡
Dialogue: 0,0:20:49.31,0:20:54.15,Default,,0,0,0,,Суық тиіп қалсам не істеуім керек?
Dialogue: 0,0:20:54.15,0:20:56.15,Default,,0,0,0,,Энн!
Dialogue: 0,0:20:56.15,0:20:58.15,Default,,0,0,0,,Диана!
Dialogue: 0,0:20:58.15,0:21:00.79,Default,,0,0,0,,Аха!
Dialogue: 0,0:21:00.79,0:21:19.27,Default,,0,0,0,,♬～
Dialogue: 0,0:21:19.27,0:21:21.94,Default,,0,0,0,,Қызыл шаш проблема емес!
Dialogue: 0,0:21:21.94,0:21:25.91,Default,,0,0,0,,Ересек адамдай қарау өте жақсы!
Dialogue: 0,0:21:25.91,0:21:29.18,Default,,0,0,0,,Өскенде керемет болуы керек!
Dialogue: 0,0:21:29.18,0:21:32.09,Default,,0,0,0,,Ал, бұл қандай зат?
Dialogue: 0,0:21:32.09,0:21:35.96,Default,,0,0,0,,Диана маған шілтер тоқудың жаңа әдісін үйретті.
Dialogue: 0,0:21:35.96,0:21:39.83,Default,,0,0,0,,Және әдемі карталар! Оның раушан гүлінің гирляндиясы бар➡
Dialogue: 0,0:21:39.83,0:21:42.73,Default,,0,0,0,,Өте жақсы өлең жазылған!
Dialogue: 0,0:21:42.73,0:21:44.70,Default,,0,0,0,,Жеміс пен... қосылған торт
Dialogue: 0,0:21:44.70,0:21:46.70,Default,,0,0,0,,«Құрметті Анна.➡
Dialogue: 0,0:21:46.70,0:21:49.60,Default,,0,0,0,,Мен сені жақсы көремін➡
Dialogue: 0,0:21:49.60,0:21:53.34,Default,,0,0,0,,Сен де мені жақсы көрсең...».
Dialogue: 0,0:21:53.34,0:21:58.85,Default,,0,0,0,,«Бізді ажырататын нәрсе...➡
Dialogue: 0,0:21:58.85,0:22:02.85,Default,,0,0,0,,Өлімнен басқа ештеңе жоқ».
Dialogue: 0,0:22:05.62,0:22:14.93,Default,,0,0,0,,♬～
Dialogue: 0,0:22:14.93,0:22:17.80,Default,,0,0,0,,♬ «Не маңызды?»
Dialogue: 0,0:22:17.80,0:22:24.94,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.94,0:22:29.61,Default,,0,0,0,,♬ «Білмей тұрып өтетін қаладан»
Dialogue: 0,0:22:29.61,0:22:34.82,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.82,0:22:39.65,Default,,0,0,0,,♬ «Таң жарқыраған таңға»
Dialogue: 0,0:22:39.65,0:22:44.59,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.59,0:22:51.70,Default,,0,0,0,,♬ «Мен аңсаған дүние менің қабақтың сыртында»
Dialogue: 0,0:22:51.70,0:22:55.70,Default,,0,0,0,,♬ «Мен оны дұрыстап тауып, сонда бара аламын».
Dialogue: 0,0:22:55.70,0:23:00.84,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.84,0:23:06.01,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.01,0:23:10.58,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.58,0:23:15.56,Default,,0,0,0,,♬ «Сіздің сезінгеніңіз – бәрі».
Dialogue: 0,0:23:15.56,0:23:24.23,Default,,0,0,0,,♬ «Жүрегің қалаған жолмен жүр».
Dialogue: 0,0:23:24.23,0:23:29.47,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.47,0:23:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.38,0:23:51.43,Default,,0,0,0,,♬～
Dialogue: 0,0:23:51.43,0:23:57.23,Default,,0,0,0,,♬～
