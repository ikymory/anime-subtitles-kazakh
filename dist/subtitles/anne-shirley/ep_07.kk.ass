Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.60,0:00:06.77,Default,,0,0,0,,Анна екеуміз жаз бойы осында ойнадық.
Dialogue: 0,0:00:06.77,0:00:08.84,Default,,0,0,0,,Қандай керемет жер!
Dialogue: 0,0:00:08.84,0:00:11.11,Default,,0,0,0,,➡
Dialogue: 0,0:00:11.11,0:00:13.78,Default,,0,0,0,,Пирс. Сондай-ақ қайық бар.
Dialogue: 0,0:00:13.78,0:00:16.18,Default,,0,0,0,,Әкемнің қайығы.
Dialogue: 0,0:00:16.18,0:00:18.81,Default,,0,0,0,,Не істеу керек? Есумен ойнағыңыз келе ме?
Dialogue: 0,0:00:18.81,0:00:22.25,Default,,0,0,0,,Сіз де форель аулауға барасыз ба? Екеуі де жақсы.
Dialogue: 0,0:00:22.25,0:00:24.49,Default,,0,0,0,,～ （ ）
Dialogue: 0,0:00:24.49,0:00:28.26,Default,,0,0,0,,Эй, неге бәріміз Элейн ханшайымын ойнап көрмейміз?
Dialogue: 0,0:00:28.26,0:00:31.26,Default,,0,0,0,,«Артур патша туралы аңыз»! иә!
Dialogue: 0,0:00:31.26,0:00:35.03,Default,,0,0,0,,Элейн ханшайым Найт Ланселотты жақсы көретін➡
Dialogue: 0,0:00:35.03,0:00:37.90,Default,,0,0,0,,Ол махаббат Ланселотқа жеткен жоқ.
Dialogue: 0,0:00:37.90,0:00:39.84,Default,,0,0,0,,Себебі Ланселот➡
Dialogue: 0,0:00:39.84,0:00:43.71,Default,,0,0,0,,Өйткені ол өзінің қожайын король Артурдың әйелі Гиневерді жақсы көретін.
Dialogue: 0,0:00:43.71,0:00:47.01,Default,,0,0,0,,Қайғыдан кейін Элейн қайтыс болды...
Dialogue: 0,0:00:47.01,0:00:51.51,Default,,0,0,0,,Оның өсиеті бойынша оның отбасы оны өзенге апаратын қайықты жүзіп жіберді...
Dialogue: 0,0:00:51.51,0:00:55.38,Default,,0,0,0,,Менің қымбатты Ланселот оны төменнен тауып алды.
Dialogue: 0,0:00:55.38,0:00:57.85,Default,,0,0,0,,Энн Тамаша идея!
Dialogue: 0,0:00:57.85,0:01:00.76,Default,,0,0,0,,Егер сіз қайықты осы жерден төмен қарай бухтаға алып барсаңыз➡
Dialogue: 0,0:01:00.76,0:01:04.46,Default,,0,0,0,,Сіз Элейн ханшайымның қайғылы махаббат хикаясын тамаша қайта жасай аласыз.
Dialogue: 0,0:01:04.46,0:01:08.10,Default,,0,0,0,,...
Dialogue: 0,0:01:08.10,0:01:10.03,Default,,0,0,0,,Ах. Уф...
Dialogue: 0,0:01:10.03,0:01:13.77,Default,,0,0,0,,Төменгі ағынмен сыпырылып кетуге батылым жетпейді...
Dialogue: 0,0:01:13.77,0:01:16.67,Default,,0,0,0,,Мен де бәріміз бірге атқа мінсек жақсы болар еді...
Dialogue: 0,0:01:16.67,0:01:19.57,Default,,0,0,0,,...
Dialogue: 0,0:01:19.57,0:01:22.31,Default,,0,0,0,,Сонда Элейн кім болады?
Dialogue: 0,0:01:22.31,0:01:24.81,Default,,0,0,0,,⁉
Dialogue: 0,0:01:24.81,0:01:27.42,Default,,0,0,0,,Иә, Анна! асылу!
Dialogue: 0,0:01:27.42,0:01:29.79,Default,,0,0,0,,Қызыл шашты Элейн біртүрлі.
Dialogue: 0,0:01:29.79,0:01:31.79,Default,,0,0,0,,Аннаның шашы ➡
Dialogue: 0,0:01:31.79,0:01:34.09,Default,,0,0,0,,Түсі мен кескенге қарағанда әлдеқайда күңгірт болып кетті...
Dialogue: 0,0:01:34.09,0:01:37.96,Default,,0,0,0,,Не? Және бұл өте әдемі болып шықты.
Dialogue: 0,0:01:37.96,0:01:43.30,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба? иә! Иә иә! Хехе.
Dialogue: 0,0:01:43.30,0:01:52.41,Default,,0,0,0,,♬～
Dialogue: 0,0:01:52.41,0:01:57.08,Default,,0,0,0,,♬「」
Dialogue: 0,0:01:57.08,0:01:59.62,Default,,0,0,0,,♬「」
Dialogue: 0,0:01:59.62,0:02:01.55,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:02:01.55,0:02:05.42,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:02:05.42,0:02:07.69,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:07.69,0:02:09.93,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:09.93,0:02:14.46,Default,,0,0,0,,♬「 」
Dialogue: 0,0:02:14.46,0:02:19.67,Default,,0,0,0,,♬「 」
Dialogue: 0,0:02:19.67,0:02:21.60,Default,,0,0,0,,♬ «Мені үйретті».
Dialogue: 0,0:02:21.60,0:02:25.47,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:25.47,0:02:28.88,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:28.88,0:02:31.31,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:02:31.31,0:02:33.58,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:02:33.58,0:02:37.82,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:02:37.82,0:02:40.29,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:02:40.29,0:02:42.62,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:02:42.62,0:02:46.09,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:02:46.09,0:02:49.40,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:02:49.40,0:02:51.63,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:02:51.63,0:02:55.90,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:02:55.90,0:02:58.41,Default,,0,0,0,,♬ «Мен санауды күтемін».
Dialogue: 0,0:02:58.41,0:03:00.64,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:03:00.64,0:03:02.64,Default,,0,0,0,,♬ «Мен сені алып кетемін».
Dialogue: 0,0:03:02.64,0:03:07.02,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:07.02,0:03:10.92,Default,,0,0,0,,♬～
Dialogue: 0,0:03:13.79,0:03:18.26,Default,,0,0,0,,♬～
Dialogue: 0,0:03:18.26,0:03:22.13,Default,,0,0,0,,Джейн Сен Элейннің әкесін ойнайсың.
Dialogue: 0,0:03:22.13,0:03:24.13,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:03:24.13,0:03:26.60,Default,,0,0,0,,Диана мен Руби ағайынды. (2 адам) Иә.
Dialogue: 0,0:03:26.60,0:03:30.17,Default,,0,0,0,,Ақ лалагүлді алмастыратын нәрсе бар ма деп ойлаймын...
Dialogue: 0,0:03:30.17,0:03:32.11,Default,,0,0,0,,Бұл туралы не ойлайсыз?
Dialogue: 0,0:03:32.11,0:03:35.71,Default,,0,0,0,,Ахаха, Ирис. Жақсы.
Dialogue: 0,0:03:35.71,0:03:38.75,Default,,0,0,0,,Жарайды, ол шынымен өлген сияқты.
Dialogue: 0,0:03:38.75,0:03:41.28,Default,,0,0,0,,Мен қорқа бастадым.
Dialogue: 0,0:03:41.28,0:03:43.25,Default,,0,0,0,,Осындай нәрсені істеуге болады ма?
Dialogue: 0,0:03:43.25,0:03:47.09,Default,,0,0,0,,Жарайды. Енді мен сөйлесуді тоқтатамын.
Dialogue: 0,0:03:47.09,0:03:50.59,Default,,0,0,0,,Өйткені ол өлді.
Dialogue: 0,0:03:53.33,0:03:57.73,Default,,0,0,0,,Ардақты апа, қош болыңыз мәңгілік.
Dialogue: 0,0:03:57.73,0:04:01.70,Default,,0,0,0,,Қош бол, сұлу әпкем.
Dialogue: 0,0:04:01.70,0:04:05.54,Default,,0,0,0,,Қош бол, қызым.
Dialogue: 0,0:04:05.54,0:04:08.24,Default,,0,0,0,,Хехе.
Dialogue: 0,0:04:18.99,0:04:23.29,Default,,0,0,0,,Енді төмен қарай Элейн ханшайымды күтейік.
Dialogue: 0,0:04:23.29,0:04:28.60,Default,,0,0,0,,Ланселотқа Артур патшаның әйелі Гиневере бол!
Dialogue: 0,0:04:28.60,0:04:34.14,Default,,0,0,0,,♬～
Dialogue: 0,0:04:34.14,0:04:37.04,Default,,0,0,0,,Жүрек үні Бұл романтиканың шыңы. ➡
Dialogue: 0,0:04:37.04,0:04:42.48,Default,,0,0,0,,Осыншама тыныш түсте өлгендер не ойлайды екен...
Dialogue: 0,0:04:42.48,0:04:44.81,Default,,0,0,0,,А…?
Dialogue: 0,0:04:44.81,0:04:47.62,Default,,0,0,0,,Е...
Dialogue: 0,0:04:47.62,0:04:50.09,Default,,0,0,0,,А... ааа... а!
Dialogue: 0,0:04:50.09,0:04:52.05,Default,,0,0,0,,Бұл өлетін уақыт емес!
Dialogue: 0,0:04:52.05,0:04:56.93,Default,,0,0,0,,Олар мінген қайық суға батып бара жатқанда не ойлау керек?
Dialogue: 0,0:04:56.93,0:05:01.33,Default,,0,0,0,,Жоқ... Біреу бар ма?! Біреу!
Dialogue: 0,0:05:01.33,0:05:03.83,Default,,0,0,0,,О... сабыр ет, Энн.
Dialogue: 0,0:05:03.83,0:05:07.24,Default,,0,0,0,,Осындай кезде сабырлы болу керек...
Dialogue: 0,0:05:07.24,0:05:09.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:09.17,0:05:11.64,Default,,0,0,0,,Жүрегімнің үні, Құдайым, мені әлі тастамасаң➡
Dialogue: 0,0:05:11.64,0:05:13.61,Default,,0,0,0,,Мына қайықты алыңыз➡
Dialogue: 0,0:05:13.61,0:05:16.44,Default,,0,0,0,,Оны сол көпір арқалығына апарыңыз! ➡
Dialogue: 0,0:05:16.44,0:05:19.75,Default,,0,0,0,,Қалғанын өзім шешемін!
Dialogue: 0,0:05:21.65,0:05:24.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:24.29,0:05:26.69,Default,,0,0,0,,Уф….
Dialogue: 0,0:05:26.69,0:05:29.02,Default,,0,0,0,,Қараңдар! Элейн ханшайым келді!
Dialogue: 0,0:05:29.02,0:05:30.99,Default,,0,0,0,,Мен тура осында келе жатырмын!
Dialogue: 0,0:05:30.99,0:05:33.03,Default,,0,0,0,,Пирстен қайықтар шайылып кетті➡
Dialogue: 0,0:05:33.03,0:05:37.30,Default,,0,0,0,,Мен бұл бухтаға міндетті түрде жетемін...
Dialogue: 0,0:05:37.30,0:05:40.34,Default,,0,0,0,,Қатты! Анна депрессияға түсті!
Dialogue: 0,0:05:40.34,0:05:42.77,Default,,0,0,0,,Біреу қоңырау шалып жатыр!
Dialogue: 0,0:05:42.77,0:05:44.84,Default,,0,0,0,,Ах! Мен мындамын!
Dialogue: 0,0:05:44.84,0:05:47.31,Default,,0,0,0,,Мен осындамын! Апыр-ай!
Dialogue: 0,0:05:47.31,0:05:49.71,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:05:49.71,0:05:53.42,Default,,0,0,0,,Уф, қолым... енді жоқ...
Dialogue: 0,0:05:53.42,0:05:56.05,Default,,0,0,0,,Хаммондтың анасы➡
Dialogue: 0,0:05:56.05,0:05:59.82,Default,,0,0,0,,Неге маған жүзуді үйретпедің?
Dialogue: 0,0:05:59.82,0:06:01.92,Default,,0,0,0,,Ах.
Dialogue: 0,0:06:07.46,0:06:10.17,Default,,0,0,0,,Энн Ширли? Осындай жерде➡
Dialogue: 0,0:06:10.17,0:06:13.57,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:13.57,0:06:16.47,Default,,0,0,0,,Абайлаңыз! баяу.
Dialogue: 0,0:06:16.47,0:06:18.44,Default,,0,0,0,,Қолдарыңызды алыңыз.
Dialogue: 0,0:06:18.44,0:06:20.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:25.18,0:06:27.15,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:27.15,0:06:30.35,Default,,0,0,0,,...Мен Элейн ханшайымына айналдым.
Dialogue: 0,0:06:30.35,0:06:32.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:32.29,0:06:34.36,Default,,0,0,0,,Мен Камелотқа баруым керек еді➡
Dialogue: 0,0:06:34.36,0:06:38.23,Default,,0,0,0,,Су кенеттен ағып кетті...
Dialogue: 0,0:06:38.23,0:06:41.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:41.50,0:06:46.10,Default,,0,0,0,,Сонымен... Кешіріңіз, бірақ...
Dialogue: 0,0:06:46.10,0:07:04.29,Default,,0,0,0,,(есу дыбысы)
Dialogue: 0,0:07:10.43,0:07:12.93,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:14.76,0:07:16.70,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:07:16.70,0:07:18.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:18.63,0:07:20.64,Default,,0,0,0,,Сәлем, Энн!
Dialogue: 0,0:07:20.64,0:07:24.24,Default,,0,0,0,,Дос бола аламыз ба деп ойлаймын.
Dialogue: 0,0:07:24.24,0:07:30.11,Default,,0,0,0,,Сенің шашыңды мазақ еткенім үшін өзімді қатты жаман сезіндім.
Dialogue: 0,0:07:30.11,0:07:33.25,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:33.25,0:07:36.79,Default,,0,0,0,,Дос болайық.
Dialogue: 0,0:07:36.79,0:07:39.79,Default,,0,0,0,,Дос болайық?
Dialogue: 0,0:07:45.26,0:07:47.20,Default,,0,0,0,,Сәбізді еске түсіру.
Dialogue: 0,0:07:47.20,0:07:50.10,Default,,0,0,0,,...
Dialogue: 0,0:07:50.10,0:07:54.04,Default,,0,0,0,,Жоқ... Мен сенімен дос бола алмаймын.
Dialogue: 0,0:07:54.04,0:07:56.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:56.04,0:07:58.54,Default,,0,0,0,,Мен болғым келмейді.
Dialogue: 0,0:08:04.35,0:08:07.05,Default,,0,0,0,,Иә... түсіндім.
Dialogue: 0,0:08:08.75,0:08:13.36,Default,,0,0,0,,Мен сенен енді ешқашан дос болуыңды сұрамаймын, Энн Ширли.
Dialogue: 0,0:08:15.62,0:08:22.40,Default,,0,0,0,,(есу дыбысы)
Dialogue: 0,0:08:22.40,0:08:26.57,Default,,0,0,0,,Жүрегімде дауыс Неге олай жауап бердім деп ойлаймын... ➡
Dialogue: 0,0:08:26.57,0:08:30.44,Default,,0,0,0,,Иә? Мен өкінемін...
Dialogue: 0,0:08:30.44,0:08:32.37,Default,,0,0,0,,Ах! Ах.
Dialogue: 0,0:08:32.37,0:08:34.64,Default,,0,0,0,,Ха ха ха ха ха…➡
Dialogue: 0,0:08:34.64,0:08:36.58,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:36.58,0:08:39.25,Default,,0,0,0,,Ал, Гилберт ше?
Dialogue: 0,0:08:39.25,0:08:43.12,Default,,0,0,0,,Қандай керемет! Бұл өте романтикалық.
Dialogue: 0,0:08:43.12,0:08:46.02,Default,,0,0,0,,Демек, сен Гилбертпен жақсы араласасың, солай ма?
Dialogue: 0,0:08:46.02,0:08:50.36,Default,,0,0,0,,Мен алмаймын. Бұл романтикалық немесе басқа нәрсе емес еді.
Dialogue: 0,0:08:50.36,0:08:53.19,Default,,0,0,0,,Не? Сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:08:53.19,0:08:56.10,Default,,0,0,0,,Мен де әкемнің қайығын қираттым.
Dialogue: 0,0:08:56.10,0:08:59.93,Default,,0,0,0,,Мен қадірлеуім керек адам➡
Dialogue: 0,0:08:59.93,0:09:02.20,Default,,0,0,0,,Сіз маған үнемі қиындық келтіресіз ...
Dialogue: 0,0:09:02.20,0:09:04.74,Default,,0,0,0,,Қандай қиын бала!
Dialogue: 0,0:09:04.74,0:09:08.21,Default,,0,0,0,,Мен Берли мырзадан кешірім сұрадым. ➡
Dialogue: 0,0:09:08.21,0:09:11.11,Default,,0,0,0,,Мен тесігі бар қайықтан шықтым➡
Dialogue: 0,0:09:11.11,0:09:13.95,Default,,0,0,0,,Ол мені кешірді, себебі бұл менің кінәм болды. ➡
Dialogue: 0,0:09:13.95,0:09:17.19,Default,,0,0,0,,Сосын Гилберттің үйінде... А...?
Dialogue: 0,0:09:17.19,0:09:20.36,Default,,0,0,0,,Күрсіну... Дәл қашан?➡
Dialogue: 0,0:09:20.36,0:09:22.76,Default,,0,0,0,,Сенің ақылың бар деп үміттенемін!
Dialogue: 0,0:09:22.76,0:09:26.93,Default,,0,0,0,,Бір қателік жасасам, өліп қалуым мүмкін еді.
Dialogue: 0,0:09:26.93,0:09:32.57,Default,,0,0,0,,Жарайды, Марилла. Сіз оны анықтауға жақсы мүмкіндік бар.
Dialogue: 0,0:09:32.57,0:09:34.50,Default,,0,0,0,,Ал, бұл қандай зат?
Dialogue: 0,0:09:34.50,0:09:39.17,Default,,0,0,0,,Грин Гейблске келгеннен бері мен көп қателесіп жүрмін➡
Dialogue: 0,0:09:39.17,0:09:44.01,Default,,0,0,0,,Мен мұны істеген сайын, мен әлсіз жақтарымның жақсарғанын байқаймын.
Dialogue: 0,0:09:44.01,0:09:46.92,Default,,0,0,0,,Тоғанға батып кете жаздаған кезім➡
Dialogue: 0,0:09:46.92,0:09:48.95,Default,,0,0,0,,Нені үйренгіңіз келеді?
Dialogue: 0,0:09:48.95,0:09:52.39,Default,,0,0,0,,Мен тым романтикпін.
Dialogue: 0,0:09:52.39,0:09:56.26,Default,,0,0,0,,Қалай болғанда да, романтика танымал емес.
Dialogue: 0,0:09:56.26,0:10:00.76,Default,,0,0,0,,Менің мүлде өзгеретін уақыт келді.
Dialogue: 0,0:10:00.76,0:10:03.10,Default,,0,0,0,,Уф….
Dialogue: 0,0:10:03.10,0:10:07.70,Default,,0,0,0,,Егер солай болса, жақсы болар еді.
Dialogue: 0,0:10:09.67,0:10:12.57,Default,,0,0,0,,Анн.
Dialogue: 0,0:10:12.57,0:10:20.18,Default,,0,0,0,,Жарайды... романтикадан толық бас тартпа. ➡
Dialogue: 0,0:10:20.18,0:10:24.42,Default,,0,0,0,,Тым көп жақсы емес, бірақ аз...➡
Dialogue: 0,0:10:24.42,0:10:27.89,Default,,0,0,0,,Кішкене болса жақсы нәрсе.
Dialogue: 0,0:10:27.89,0:10:34.30,Default,,0,0,0,,♬～
Dialogue: 0,0:10:34.30,0:10:38.40,Default,,0,0,0,,♬～
Dialogue: 0,0:10:40.10,0:10:42.80,Default,,0,0,0,,Мен үйдемін! Қайтадан қош келдіңіз. ➡
Dialogue: 0,0:10:42.80,0:10:44.74,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:10:44.74,0:10:47.64,Default,,0,0,0,,Мен Дианамен бірге Аруақты орманда серуендедім.
Dialogue: 0,0:10:47.64,0:10:52.01,Default,,0,0,0,,Доктор Стейси дәл қазір осында болды.
Dialogue: 0,0:10:52.01,0:10:57.52,Default,,0,0,0,,Ах... мен сабақта ``Бен-Хурды'' оқып жатқанда ұсталдым...
Dialogue: 0,0:10:57.52,0:10:59.59,Default,,0,0,0,,Иә? Уф.
Dialogue: 0,0:10:59.59,0:11:02.36,Default,,0,0,0,,Хахахаха менің айтып тұрғаным ол емес.
Dialogue: 0,0:11:02.36,0:11:07.10,Default,,0,0,0,,Мұғалім бүгін жақсы оқитын оқушыларды жинауға келді➡
Dialogue: 0,0:11:07.10,0:11:10.60,Default,,0,0,0,,Мен Queen Academy қабылдау емтиханына дайындық сыныбын жасаймын➡
Dialogue: 0,0:11:10.60,0:11:12.93,Default,,0,0,0,,Мен сені сол топқа қоссам бола ма?➡
Dialogue: 0,0:11:12.93,0:11:16.24,Default,,0,0,0,,Ол Матай екеумізбен сөйлесуге келді.
Dialogue: 0,0:11:16.24,0:11:19.94,Default,,0,0,0,,Шынымен бе? А...бірақ...
Dialogue: 0,0:11:19.94,0:11:22.84,Default,,0,0,0,,Ақшаға алаңдаудың қажеті жоқ.
Dialogue: 0,0:11:22.84,0:11:27.08,Default,,0,0,0,,Егер қаласаңыз, оқуыңызға қолдау көрсетеміз.
Dialogue: 0,0:11:27.08,0:11:29.42,Default,,0,0,0,,О, Марилла!
Dialogue: 0,0:11:29.42,0:11:32.02,Default,,0,0,0,,Әрине көргім келеді!
Dialogue: 0,0:11:32.02,0:11:34.72,Default,,0,0,0,,Мен риза болатын нәрсе бар ма?
Dialogue: 0,0:11:34.72,0:11:36.66,Default,,0,0,0,,Қатты оқу➡
Dialogue: 0,0:11:36.66,0:11:39.69,Default,,0,0,0,,Мен Марилла мен Мэтьюдің мақтанышы болу үшін барымды саламын!
Dialogue: 0,0:11:39.69,0:11:43.06,Default,,0,0,0,,Хехе. Сіз жасай аласыз.
Dialogue: 0,0:11:43.06,0:11:45.97,Default,,0,0,0,,Хмм….
Dialogue: 0,0:11:45.97,0:11:48.74,Default,,0,0,0,,Міне, бүгінгі күннің бәрі осы.
Dialogue: 0,0:11:48.74,0:11:52.01,Default,,0,0,0,,Емтиханға дайындық сыныбында оқитын балалар, қалып қойыңыздар.
Dialogue: 0,0:11:52.01,0:11:54.91,Default,,0,0,0,,Басқа балалар, үйге бара жатқанда абай болыңыз.
Dialogue: 0,0:11:54.91,0:11:58.51,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:11:58.51,0:12:00.45,Default,,0,0,0,,Онда мен бірінші үйге барамын.
Dialogue: 0,0:12:00.45,0:12:04.92,Default,,0,0,0,,Иә. ертең кездескенше. Ертең кездескенше...
Dialogue: 0,0:12:04.92,0:12:06.99,Default,,0,0,0,,Сәттілік.
Dialogue: 0,0:12:06.99,0:12:09.26,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:09.26,0:12:11.19,Default,,0,0,0,,Жүрек үні, не істесек те➡
Dialogue: 0,0:12:11.19,0:12:13.90,Default,,0,0,0,,Біз әрқашан бірге болдық. жақсы!
Dialogue: 0,0:12:15.93,0:12:20.37,Default,,0,0,0,,Жүректің дауысы Диана енді «Ғашықтар жолы» мен «Күлгін алқабына» барады➡
Dialogue: 0,0:12:20.37,0:12:24.77,Default,,0,0,0,,Үйге өзім баруым керек.
Dialogue: 0,0:12:24.77,0:12:28.64,Default,,0,0,0,,Өмірде әрбір адамға мақсат керек➡
Dialogue: 0,0:12:28.64,0:12:32.38,Default,,0,0,0,,Сіз онымен бірге жүруіңіз керек. ➡
Dialogue: 0,0:12:32.38,0:12:36.82,Default,,0,0,0,,Жалғыз сұрақ - мақсаттың нақты құндылығы.
Dialogue: 0,0:12:36.82,0:12:39.75,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:12:39.75,0:12:42.62,Default,,0,0,0,,Бұл баланың ата-анасы Диана➡
Dialogue: 0,0:12:42.62,0:12:45.59,Default,,0,0,0,,Оның Королева академиясына түсуге ниеті жоқ сияқты.
Dialogue: 0,0:12:45.59,0:12:50.90,Default,,0,0,0,,Бұл маған кемелдікке үміттену қаншалықты қиын екенін түсінді.
Dialogue: 0,0:12:50.90,0:12:55.64,Default,,0,0,0,,Күрсіну…. Емтиханға дайындық сабағы қалай өтіп жатыр?
Dialogue: 0,0:12:55.64,0:12:58.54,Default,,0,0,0,,Иә, бұл қызық болады.
Dialogue: 0,0:12:58.54,0:13:03.18,Default,,0,0,0,,Мен де оқумен бәсекеге қабілетті боламын. Бұл керемет емес пе?
Dialogue: 0,0:13:03.18,0:13:07.85,Default,,0,0,0,,Үйге қайтар жолда бәріміз өмірдегі мақсаттарымыз туралы әңгімелестік.
Dialogue: 0,0:13:07.85,0:13:11.09,Default,,0,0,0,,Өмір бойы? Бұл өте асыра сілтеу.
Dialogue: 0,0:13:11.09,0:13:13.45,Default,,0,0,0,,Маған профессор Стейси айтты.
Dialogue: 0,0:13:13.45,0:13:16.36,Default,,0,0,0,,Оның болуы өте маңызды.
Dialogue: 0,0:13:16.36,0:13:20.23,Default,,0,0,0,,үшін көп нәрсені ойлады. Рубин сияқты бірдеңе...
Dialogue: 0,0:13:20.23,0:13:22.60,Default,,0,0,0,,Менің мақсатым – үйлену.
Dialogue: 0,0:13:22.60,0:13:26.47,Default,,0,0,0,,Королева академиясын бітірсем, екі жыл жұмыс істеймін➡
Dialogue: 0,0:13:26.47,0:13:29.14,Default,,0,0,0,,Мен көп ұзамай үйленемін.
Dialogue: 0,0:13:29.14,0:13:31.67,Default,,0,0,0,,Джейн ше? Мен…➡
Dialogue: 0,0:13:31.67,0:13:34.91,Default,,0,0,0,,Мен өмір бойы сақтай алатын жұмыс тапқым келеді.
Dialogue: 0,0:13:34.91,0:13:37.21,Default,,0,0,0,,Онда мен ешқашан үйленбеймін.
Dialogue: 0,0:13:37.21,0:13:40.78,Default,,0,0,0,,Неліктен? Жұмыс жасасаңыз айлық аласыз➡
Dialogue: 0,0:13:40.78,0:13:42.85,Default,,0,0,0,,Күйеуім маған ештеңе бермейді.
Dialogue: 0,0:13:42.85,0:13:47.69,Default,,0,0,0,,Менің әкеме қарап білуге ​​болады. Өйткені ол өте сараң.
Dialogue: 0,0:13:47.69,0:13:49.82,Default,,0,0,0,,Ахахаха!
Dialogue: 0,0:13:49.82,0:13:54.40,Default,,0,0,0,,Джози... (Джози Пай) Маған өз ақшамды табудың қажеті жоқ➡
Dialogue: 0,0:13:54.40,0:13:57.23,Default,,0,0,0,,Мен Queen's-ке оқуға барамын.
Dialogue: 0,0:13:57.23,0:13:59.97,Default,,0,0,0,,Джозидің отбасы бай.
Dialogue: 0,0:13:59.97,0:14:05.24,Default,,0,0,0,,Иә. Олардың мейіріммен өмір сүретін кейбір жетімдерден айырмашылығы бар.
Dialogue: 0,0:14:05.24,0:14:07.48,Default,,0,0,0,,Жетімдерді шетке итеріп жібереді➡
Dialogue: 0,0:14:07.48,0:14:11.25,Default,,0,0,0,,Бұл қиын, өйткені сіз өз жолыңызды жасауыңыз керек.
Dialogue: 0,0:14:11.25,0:14:14.65,Default,,0,0,0,,Ондай дөрекі баланы жалғыз қалдыру керек.
Dialogue: 0,0:14:14.65,0:14:17.02,Default,,0,0,0,,Хехехе, мен мұны істеймін.
Dialogue: 0,0:14:17.02,0:14:18.95,Default,,0,0,0,,Moody Spurgeon - бұл➡
Dialogue: 0,0:14:18.95,0:14:21.49,Default,,0,0,0,,Менің мақсатым – пастор болу.
Dialogue: 0,0:14:21.49,0:14:23.56,Default,,0,0,0,,Чарли Слоан – бұл➡
Dialogue: 0,0:14:23.56,0:14:25.76,Default,,0,0,0,,Сіз саясаткер болғыңыз келеді дейсіз.
Dialogue: 0,0:14:25.76,0:14:30.10,Default,,0,0,0,,Слоун отбасы өте мейірімді, сондықтан қиын болады.
Dialogue: 0,0:14:30.10,0:14:32.37,Default,,0,0,0,,Иә. Айтпақшы➡
Dialogue: 0,0:14:32.37,0:14:34.34,Default,,0,0,0,,Гилберт Блайт➡
Dialogue: 0,0:14:34.34,0:14:37.21,Default,,0,0,0,,Болашақта қандай болуды жоспарлайсыз?
Dialogue: 0,0:14:37.21,0:14:39.61,Default,,0,0,0,,Еске алу Мен түсінемін.
Dialogue: 0,0:14:39.61,0:14:44.61,Default,,0,0,0,,Мен сенен енді ешқашан дос болуыңды сұрамаймын, Энн Ширли.
Dialogue: 0,0:14:46.48,0:14:49.35,Default,,0,0,0,,Гилберт Блайт кім болғысы келеді➡
Dialogue: 0,0:14:49.35,0:14:51.72,Default,,0,0,0,,Мені бұл қызықтырмайды.
Dialogue: 0,0:14:51.72,0:14:54.29,Default,,0,0,0,,Мм... Сосын Энн➡
Dialogue: 0,0:14:54.29,0:14:57.16,Default,,0,0,0,,Сіздің өмірлік мақсаттарыңыз қандай➡
Dialogue: 0,0:14:57.16,0:14:59.16,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:59.16,0:15:02.06,Default,,0,0,0,,А... менікі? Бұл дұрыс...
Dialogue: 0,0:15:02.06,0:15:04.23,Default,,0,0,0,,Жақсы…➡
Dialogue: 0,0:15:04.23,0:15:07.14,Default,,0,0,0,,Менің өмірдегі мақсатым...
Dialogue: 0,0:15:07.14,0:15:09.94,Default,,0,0,0,,Жүрек үні Бұл үлкен мәселе. ➡
Dialogue: 0,0:15:09.94,0:15:14.81,Default,,0,0,0,,Мен дәл қазір өмірімді арнауға тұрарлық мақсат табуым керек...
Dialogue: 0,0:15:14.81,0:15:19.95,Default,,0,0,0,,Күрсін... Диана өз бетімен жақсы болды ма деп ойлаймын...
Dialogue: 0,0:15:19.95,0:15:22.25,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:15:22.25,0:15:26.02,Default,,0,0,0,,Кэрри мен Джулия бүгін менімен бірге үйге келеді.
Dialogue: 0,0:15:26.02,0:15:29.66,Default,,0,0,0,,Сонымен, Энн, емтиханға назар аударыңыз!
Dialogue: 0,0:15:29.66,0:15:32.03,Default,,0,0,0,,Ах... рахмет...
Dialogue: 0,0:15:32.03,0:15:34.46,Default,,0,0,0,,Өмірлік мақсат?
Dialogue: 0,0:15:34.46,0:15:37.30,Default,,0,0,0,,Дұрыс. Жарайды, өскенде➡
Dialogue: 0,0:15:37.30,0:15:39.60,Default,,0,0,0,,Диана және мен➡
Dialogue: 0,0:15:39.60,0:15:41.57,Default,,0,0,0,,Бірге тұру керек пе деп ойлаймын.
Dialogue: 0,0:15:41.57,0:15:45.27,Default,,0,0,0,,Екеуміз жұмыс істеп, әже болған соң да бірге боламыз.
Dialogue: 0,0:15:45.27,0:15:47.61,Default,,0,0,0,,Бұл көңілді сияқты. Дұрыс па?
Dialogue: 0,0:15:47.61,0:15:52.31,Default,,0,0,0,,Бірақ күте тұрыңыз. Бұл менің өмірлік мақсатым, сондықтан мен оның мәнді болғанын қалаймын.
Dialogue: 0,0:15:52.31,0:15:54.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:54.38,0:15:57.79,Default,,0,0,0,,Мысалы, түзелмейтін жас жігітке тұрмысқа шығу➡
Dialogue: 0,0:15:57.79,0:16:00.79,Default,,0,0,0,,Мен ол адамды махаббатыммен айналдырамын.
Dialogue: 0,0:16:00.79,0:16:04.33,Default,,0,0,0,,Бұл өте қымбат және асыл сезім, солай емес пе?
Dialogue: 0,0:16:04.33,0:16:06.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:11.77,0:16:13.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.77,0:16:15.97,Default,,0,0,0,,Эй, Энн, не болды?
Dialogue: 0,0:16:15.97,0:16:18.74,Default,,0,0,0,,Мұғалім Стейси…. Не?
Dialogue: 0,0:16:18.74,0:16:22.61,Default,,0,0,0,,Мен өмірлік мақсатымды қалай таба аламын?
Dialogue: 0,0:16:22.61,0:16:24.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:24.61,0:16:28.85,Default,,0,0,0,,Қалғандардың барлығы қазірден бастап не істегісі келетінін нақты түсінеді.
Dialogue: 0,0:16:28.85,0:16:33.25,Default,,0,0,0,,Менде әлі ондай ештеңе жоқ.
Dialogue: 0,0:16:35.29,0:16:38.13,Default,,0,0,0,,Мүмкін сізге көп уайымдаудың қажеті жоқ шығар.
Dialogue: 0,0:16:38.13,0:16:41.03,Default,,0,0,0,,Өйткені сізде тамаша нәтижелер➡
Dialogue: 0,0:16:41.03,0:16:43.40,Default,,0,0,0,,Оны жай ғана табыңыз.
Dialogue: 0,0:16:43.40,0:16:46.70,Default,,0,0,0,,Бірақ мен оны таба алмасам ше?
Dialogue: 0,0:16:46.70,0:16:50.67,Default,,0,0,0,,Менің сөздерім саған ауыр тиді.
Dialogue: 0,0:16:50.67,0:16:53.81,Default,,0,0,0,,Ендеше бұл туралы былай ойланайық.
Dialogue: 0,0:16:53.81,0:16:58.01,Default,,0,0,0,,Королева академиясынан өту - сіздің бірінші мақсатыңыз➡
Dialogue: 0,0:16:58.01,0:17:01.25,Default,,0,0,0,,Содан кейін не болатынын ойланамын.
Dialogue: 0,0:17:01.25,0:17:05.75,Default,,0,0,0,,Үлкен мақсаттар міндетті түрде жақсы мақсаттар емес. ➡
Dialogue: 0,0:17:05.75,0:17:09.62,Default,,0,0,0,,Енді әр күнді бағалаңыз және қолыңыздан келгеннің бәрін жасаңыз.
Dialogue: 0,0:17:09.62,0:17:14.43,Default,,0,0,0,,Әр күнді бағалаңыз және қолыңыздан келгеннің бәрін жасаңыз...
Dialogue: 0,0:17:14.43,0:17:17.33,Default,,0,0,0,,Түсіндім! Мен тырысамын!
Dialogue: 0,0:17:17.33,0:17:23.44,Default,,0,0,0,,Өзіңізді қатты итермеңіз. рақмет сізге. Кешіріңіз!
Dialogue: 0,0:17:23.44,0:17:26.34,Default,,0,0,0,,Абайлаңыз.
Dialogue: 0,0:17:26.34,0:17:28.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:28.58,0:17:32.95,Default,,0,0,0,,Мұғалім Стейси. Мен сені өте қатты жақсы көремін!
Dialogue: 0,0:17:32.95,0:17:34.88,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:17:34.88,0:17:40.79,Default,,0,0,0,,＜Содан кейін жыл мезгілдері бақытты және тегіс өтті➡
Dialogue: 0,0:17:40.79,0:17:43.12,Default,,0,0,0,,Көктем келді➡
Dialogue: 0,0:17:43.12,0:17:46.13,Default,,0,0,0,,14 жасқа толдым>
Dialogue: 0,0:17:46.13,0:17:49.90,Default,,0,0,0,,Кешегі тестілеуден тамаша балл жинаған екі адам болды. ➡
Dialogue: 0,0:17:49.90,0:17:52.27,Default,,0,0,0,,Энн және Гилберт. (2 адам) А.
Dialogue: 0,0:17:52.27,0:17:54.20,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:17:54.20,0:17:59.14,Default,,0,0,0,,<Әр күніңді алдыңдағыны бағалаумен өткізсең➡
Dialogue: 0,0:17:59.14,0:18:01.41,Default,,0,0,0,,Ол күндер дәл➡ сияқты еді
Dialogue: 0,0:18:01.41,0:18:05.61,Default,,0,0,0,,Ожерельге таққан асыл тастай жарқырай бастады>
Dialogue: 0,0:18:07.92,0:18:09.85,Default,,0,0,0,,＜Жақында жаз болады➡
Dialogue: 0,0:18:09.85,0:18:13.42,Default,,0,0,0,,Біз күткендей сабақтан біраз шаршадық➡
Dialogue: 0,0:18:13.42,0:18:17.02,Default,,0,0,0,,Мектепке қауесет тарады＞
Dialogue: 0,0:18:17.02,0:18:20.33,Default,,0,0,0,,Эй, сен мұны естідің бе? (Сэм Боулдер) О, мен естідім, естідім.
Dialogue: 0,0:18:20.33,0:18:24.13,Default,,0,0,0,,Ол өзін туған жеріндегі мектеп шақырғанын айтты. Ха….
Dialogue: 0,0:18:25.87,0:18:27.87,Default,,0,0,0,,Қайырлы таң. қайырлы таң.
Dialogue: 0,0:18:27.87,0:18:30.07,Default,,0,0,0,,Эй, сен мұны естідің бе? Не? иә?
Dialogue: 0,0:18:30.07,0:18:34.71,Default,,0,0,0,,Стейси мырза осы жазда Авонли мектебінен кетеді.
Dialogue: 0,0:18:34.71,0:18:36.28,Default,,0,0,0,,А... а....
Dialogue: 0,0:18:36.28,0:18:41.12,Default,,0,0,0,,Бұл әлі өсек. Сіз оны растаған жоқсыз, солай ма?
Dialogue: 0,0:18:41.12,0:18:43.08,Default,,0,0,0,,Иә... бірақ...
Dialogue: 0,0:18:43.08,0:18:46.75,Default,,0,0,0,,Ұстазыңыздан сұрау керек пе?
Dialogue: 0,0:18:46.75,0:18:51.66,Default,,0,0,0,,Жоқ... Мен сұрауға қорқамын. Бұл дұрыс...
Dialogue: 0,0:18:51.66,0:18:55.16,Default,,0,0,0,,Осы семестрдегі сабақтар бүгін аяқталады.
Dialogue: 0,0:18:55.16,0:18:58.87,Default,,0,0,0,,Осы уақытқа дейін барлығыңыз өте жақсы оқыдыңыздар➡
Dialogue: 0,0:18:58.87,0:19:04.54,Default,,0,0,0,,Ертеңнен басталатын жазғы демалысыңызды толық өткізіңіз. ➡
Dialogue: 0,0:19:04.54,0:19:07.21,Default,,0,0,0,,Сыртқа шығып, көңіл көтеріңіз➡
Dialogue: 0,0:19:07.21,0:19:10.11,Default,,0,0,0,,Денсаулық пен мотивацияны сақтаңыз. ➡
Dialogue: 0,0:19:10.11,0:19:13.08,Default,,0,0,0,,Келесі жылы қабылдау емтиханы болады. ➡
Dialogue: 0,0:19:13.08,0:19:16.88,Default,,0,0,0,,Бұл шешуші шайқас алдындағы соңғы жыл.
Dialogue: 0,0:19:16.88,0:19:20.19,Default,,0,0,0,,үшін... не болды?
Dialogue: 0,0:19:20.19,0:19:22.99,Default,,0,0,0,,Мұғалім, менің сұрағым бар. (Чарли Руби) О.
Dialogue: 0,0:19:22.99,0:19:24.93,Default,,0,0,0,,(Танжиро) Толық шоғырланған тыныс алуды сақтай отырып жаттығу енді екінші табиғатқа айнала бастады.
Dialogue: 0,0:19:24.93,0:19:27.46,Default,,0,0,0,,Келесі семестрде де бізге сабақ бере аласыз ба?
Dialogue: 0,0:19:27.46,0:19:31.00,Default,,0,0,0,,Не? (Джози) Мұғалім басқа мектептен шақырылды➡
Dialogue: 0,0:19:31.00,0:19:34.37,Default,,0,0,0,,Мен сіз оны алуды жоспарлап жатырсыз деген қауесет естідім.
Dialogue: 0,0:19:34.37,0:19:37.91,Default,,0,0,0,,Мұғалім! Өтінемін, бас тартпаңыз!
Dialogue: 0,0:19:37.91,0:19:40.64,Default,,0,0,0,,Ах…. Ұстазымнан не үйренгім келеді➡
Dialogue: 0,0:19:40.64,0:19:43.61,Default,,0,0,0,,Әлі де көп! (Көңілді Чарли) Мен де!
Dialogue: 0,0:19:43.61,0:19:47.01,Default,,0,0,0,,Ешқайда кетпе! Шығармаңыз, сэр!
Dialogue: 0,0:19:47.01,0:19:49.45,Default,,0,0,0,,Ұстаз, тастамаңыз!
Dialogue: 0,0:19:49.45,0:19:51.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:51.45,0:19:54.26,Default,,0,0,0,,Жүрек үні үшінна...
Dialogue: 0,0:19:56.06,0:20:00.49,Default,,0,0,0,,Иә. Міндетті түрде шақыру болды.
Dialogue: 0,0:20:04.37,0:20:10.04,Default,,0,0,0,,Бірақ мен осында, Авонлеада қалуды шештім.
Dialogue: 0,0:20:10.04,0:20:11.97,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:20:11.97,0:20:15.71,Default,,0,0,0,,Мен туған жердегі мектепке баруды ойладым➡
Dialogue: 0,0:20:15.71,0:20:19.58,Default,,0,0,0,,Шынымды айтсам, маған қатты ұнады➡
Dialogue: 0,0:20:19.58,0:20:22.18,Default,,0,0,0,,Мен кете алмадым.
Dialogue: 0,0:20:22.18,0:20:26.39,Default,,0,0,0,,Олай болса, осы жерде сіздің оқу бітіруіңізге куә болуға рұқсат етіңіз.
Dialogue: 0,0:20:26.39,0:20:30.16,Default,,0,0,0,,Ах...! (Көңілсіз Чарли) Жарайсың! Ура!
Dialogue: 0,0:20:30.16,0:20:33.49,Default,,0,0,0,,Сәттілік! Ура! ➡
Dialogue: 0,0:20:33.49,0:20:37.26,Default,,0,0,0,,Сәттілік! (Стейси) үшін...
Dialogue: 0,0:20:37.26,0:20:39.83,Default,,0,0,0,,Рахмет…. ➡
Dialogue: 0,0:20:39.83,0:20:42.64,Default,,0,0,0,,Уф... хехе….
Dialogue: 0,0:20:42.64,0:20:48.84,Default,,0,0,0,,Сәлем Джейн. Мен өмірлік мақсатымды таптым.
Dialogue: 0,0:20:48.84,0:20:50.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:50.88,0:20:58.12,Default,,0,0,0,,Жүректің түбінде бұлдыр ойландым, бірақ бүгін көзім жетті.
Dialogue: 0,0:20:58.12,0:21:00.96,Default,,0,0,0,,Энн сен де.
Dialogue: 0,0:21:00.96,0:21:03.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:03.29,0:21:07.16,Default,,0,0,0,,Иә... бәрі де...
Dialogue: 0,0:21:07.16,0:21:12.47,Default,,0,0,0,,♬～
Dialogue: 0,0:21:12.47,0:21:15.90,Default,,0,0,0,,Марилла Мен мектеп мұғалімі боламын!
Dialogue: 0,0:21:15.90,0:21:20.67,Default,,0,0,0,,Мұғалімдік лицензияңызды алыңыз және Стейси ханым сияқты мұғалім болыңыз.
Dialogue: 0,0:21:20.67,0:21:23.11,Default,,0,0,0,,Бұл менің мақсатым!
Dialogue: 0,0:21:23.11,0:21:28.48,Default,,0,0,0,,Сондықтан бұл туралы көп ойланудың қажеті жоқ... Бірақ менде солай болатынын сездім.
Dialogue: 0,0:21:28.48,0:21:33.32,Default,,0,0,0,,Келесі семестрден бастап мен оқуымда бұрынғыдан да бәсекеге қабілетті боламын.
Dialogue: 0,0:21:33.32,0:21:36.26,Default,,0,0,0,,⚟ Сіз бәрін жақсы орындайсыз.
Dialogue: 0,0:21:36.26,0:21:39.96,Default,,0,0,0,,Уф... Бірақ бұл мен кітапқа жабыса алмаймын дегенді білдірмейді➡
Dialogue: 0,0:21:39.96,0:21:43.83,Default,,0,0,0,,Жарайды. Бұл жөнінде уайымдамаңыз. Иә мен істеймін.
Dialogue: 0,0:21:43.83,0:21:46.27,Default,,0,0,0,,Иә! Сондай-ақ Мэтью үшін... ⚟(шу)
Dialogue: 0,0:21:46.27,0:21:48.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:48.20,0:21:50.81,Default,,0,0,0,,Матай?
Dialogue: 0,0:21:52.74,0:21:55.34,Default,,0,0,0,,Ха... Матай! ➡
Dialogue: 0,0:21:55.34,0:21:58.71,Default,,0,0,0,,Не болды?! Ах...!
Dialogue: 0,0:21:58.71,0:22:00.71,Default,,0,0,0,,Ах... аа...! ➡
Dialogue: 0,0:22:00.71,0:22:05.55,Default,,0,0,0,,Мэтью!
Dialogue: 0,0:22:05.55,0:22:14.93,Default,,0,0,0,,♬～
Dialogue: 0,0:22:14.93,0:22:17.80,Default,,0,0,0,,♬ «Маңыздысы»
Dialogue: 0,0:22:17.80,0:22:24.94,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.94,0:22:29.61,Default,,0,0,0,,♬ «Сен білмей тұрып өтетін қаладан»
Dialogue: 0,0:22:29.61,0:22:34.82,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.82,0:22:39.65,Default,,0,0,0,,♬ «Таңертеңгілік таңға таң»
Dialogue: 0,0:22:39.65,0:22:44.59,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.59,0:22:51.70,Default,,0,0,0,,♬ «Мен аңсаған дүние менің қабақтың сыртында»
Dialogue: 0,0:22:51.70,0:22:55.70,Default,,0,0,0,,♬ «Мен оны тауып алып, сонда бара аламын».
Dialogue: 0,0:22:55.70,0:23:00.84,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.84,0:23:06.01,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.01,0:23:10.58,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.58,0:23:15.56,Default,,0,0,0,,♬ «Менің сезгенім бәрі болды».
Dialogue: 0,0:23:15.56,0:23:24.23,Default,,0,0,0,,♬ «Жүрегің қалаған бағытта жүр».
Dialogue: 0,0:23:24.23,0:23:29.47,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.47,0:23:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.38,0:23:51.43,Default,,0,0,0,,♬～
Dialogue: 0,0:23:51.43,0:23:57.23,Default,,0,0,0,,♬～
