Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.46,0:00:06.75,Default,,0,0,0,,Өтінемін, бір нәрсені қайта-қайта айтпа, Которита-сан.
Dialogue: 0,0:00:08.46,0:00:10.05,Default,,0,0,0,,Біз де еріктіміз.
Dialogue: 0,0:00:10.13,0:00:13.09,Default,,0,0,0,,Мен жай ғана несие беруші емеспін.
Dialogue: 0,0:00:14.22,0:00:17.30,Default,,0,0,0,,Сенімді бол... Ақшаңды міндетті түрде қайтарамын!
Dialogue: 0,0:00:17.39,0:00:21.56,Default,,0,0,0,,Бірақ бұған дейін Кирики Сабуро Кирикимен кездесуге рұқсат етіңіз!
Dialogue: 0,0:00:21.64,0:00:25.27,Default,,0,0,0,,Сіз бұл мүмкін емес деп айтуыңыз мүмкін.
Dialogue: 0,0:00:26.56,0:00:28.44,Default,,0,0,0,,Президент қазір бос емес.
Dialogue: 0,0:00:28.52,0:00:30.90,Default,,0,0,0,,Адамдарды кездестіретін жер жоқ.
Dialogue: 0,0:00:30.98,0:00:32.53,Default,,0,0,0,,Бірақ бұл ақша
Dialogue: 0,0:00:32.61,0:00:35.91,Default,,0,0,0,,Сабуро Кирикиден жеке қарызға алған ақшаммен...
Dialogue: 0,0:00:35.99,0:00:37.74,Default,,0,0,0,,Сіз де табандысыз!
Dialogue: 0,0:00:37.82,0:00:41.20,Default,,0,0,0,,Шағымдансаң, тезірек Қанадеге сәлем айт!
Dialogue: 0,0:00:41.29,0:00:43.71,Default,,0,0,0,,Ашулану мүмкін емес!
Dialogue: 0,0:00:43.79,0:00:44.71,Default,,0,0,0,,Уф…
Dialogue: 0,0:00:44.79,0:00:46.62,Default,,0,0,0,,Сіз!
Dialogue: 0,0:00:46.71,0:00:48.46,Default,,0,0,0,,Сіз!
Dialogue: 0,0:00:54.30,0:00:55.88,Default,,0,0,0,,Уууу…
Dialogue: 0,0:00:55.97,0:00:57.89,Default,,0,0,0,,Уау...
Dialogue: 0,0:01:03.10,0:01:08.02,Default,,0,0,0,,(Газдың ағу дыбысы)
Dialogue: 0,0:01:08.10,0:01:12.98,Default,,0,0,0,,(Газдың ағу дыбысы)
Dialogue: 0,0:01:13.07,0:01:16.20,Default,,0,0,0,,(Газдың ағу дыбысы)
Dialogue: 0,0:01:16.28,0:01:21.91,Default,,0,0,0,,(Газдың ағу дыбысы)
Dialogue: 0,0:01:21.99,0:01:23.12,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:01:23.20,0:01:26.58,Default,,0,0,0,,(Газдың ағу дыбысы)
Dialogue: 0,0:01:26.66,0:01:32.88,Default,,0,0,0,,(Газдың ағу дыбысы)
Dialogue: 0,0:01:32.96,0:01:33.84,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:01:33.92,0:01:36.76,Default,,0,0,0,,(Газдың ағу дыбысы)
Dialogue: 0,0:01:36.84,0:01:38.22,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:01:38.30,0:01:39.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:39.30,0:01:42.18,Default,,0,0,0,,Бұл — «mercy rule» (рақымшылдық ережесі) бойынша ойын сол сәтте тоқтатылатынын ұмытпа
Dialogue: 0,0:01:42.26,0:01:45.68,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:01:48.44,0:01:49.94,Default,,0,0,0,,(Өрт сөндіру машинасының сиренасы)
Dialogue: 0,0:01:50.02,0:01:56.74,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:01:56.82,0:02:00.95,Default,,0,0,0,,Тағы бір керемет трансфер студент келді.
Dialogue: 0,0:02:01.03,0:02:04.41,Default,,0,0,0,,Қазір Чугоку мен Сикокудағы бокс клубының шыңы...
Dialogue: 0,0:02:04.49,0:02:07.16,Default,,0,0,0,,Бұл енді қате емес.
Dialogue: 0,0:02:07.25,0:02:09.50,Default,,0,0,0,,Мен мұның соншалықты нашар болатынын ешқашан күтпедім.
Dialogue: 0,0:02:09.58,0:02:12.00,Default,,0,0,0,,Мен мұны білмедім.
Dialogue: 0,0:02:13.55,0:02:17.22,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:17.30,0:02:20.97,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:21.47,0:02:23.05,Default,,0,0,0,,Ал, бүгін...
Dialogue: 0,0:02:23.14,0:02:25.43,Default,,0,0,0,,Біздің сыныпқа жаңа мүше қосылды.
Dialogue: 0,0:02:26.22,0:02:29.52,Default,,0,0,0,,Неге екені белгісіз, мен сендерден бір жас үлкенмін.
Dialogue: 0,0:02:29.60,0:02:31.69,Default,,0,0,0,,Барлығыңыз жақсы араласыңыз, жарай ма?
Dialogue: 0,0:02:32.56,0:02:34.44,Default,,0,0,0,,Бұл Синдзи Которита.
Dialogue: 0,0:02:34.52,0:02:37.94,Default,,0,0,0,,Егер бірдеңе түсінбесеңіз, маған хабарлаңыз.
Dialogue: 0,0:02:42.82,0:02:44.37,Default,,0,0,0,,Ал...
Dialogue: 0,0:02:44.83,0:02:47.20,Default,,0,0,0,,Неге қарап тұрдың?
Dialogue: 0,0:02:47.29,0:02:50.04,Default,,0,0,0,,О? Мен сені өлтіремін!
Dialogue: 0,0:02:54.88,0:02:57.26,Default,,0,0,0,,Қайдан шыққанын білмеймін, бірақ...
Dialogue: 0,0:02:57.34,0:03:01.55,Default,,0,0,0,,Біздің қандай адамдар екенімізді білмеймін. О?
Dialogue: 0,0:03:02.09,0:03:03.60,Default,,0,0,0,,Білу
Dialogue: 0,0:03:03.68,0:03:08.22,Default,,0,0,0,,Жұмақ көбелек Бұл күндері желді адамдардың ең төменгісі болсам да.
Dialogue: 0,0:03:08.31,0:03:10.69,Default,,0,0,0,,Не? Мұнда!
Dialogue: 0,0:03:12.02,0:03:13.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:13.27,0:03:14.48,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:03:16.19,0:03:17.03,Default,,0,0,0,,Уф…
Dialogue: 0,0:03:17.11,0:03:18.23,Default,,0,0,0,,Гаха…
Dialogue: 0,0:03:18.32,0:03:20.24,Default,,0,0,0,,Аа аа аа...
Dialogue: 0,0:03:20.78,0:03:21.82,Default,,0,0,0,,Чи…
Dialogue: 0,0:03:24.99,0:03:26.66,Default,,0,0,0,,- (Тайдзи) Гах... - (Рйосуке) Тайджи!
Dialogue: 0,0:03:26.74,0:03:28.75,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:03:28.83,0:03:34.54,Default,,0,0,0,,Гокуракучоның басшысы Цукаса Кирики екені рас па?
Dialogue: 0,0:03:34.63,0:03:36.25,Default,,0,0,0,,Сонда мен не істеуім керек? ?
Dialogue: 0,0:03:36.34,0:03:39.92,Default,,0,0,0,,Ақыры... таптым.
Dialogue: 0,0:03:40.59,0:03:42.68,Default,,0,0,0,,Не? Бұл жігіт...
Dialogue: 0,0:03:45.47,0:03:46.89,Default,,0,0,0,,Маған жол көрсет!
Dialogue: 0,0:03:46.97,0:03:49.10,Default,,0,0,0,,Цукаса Кирикидің орнында!
Dialogue: 0,0:03:52.94,0:03:53.98,Default,,0,0,0,,(Цукасаның есінеу)
Dialogue: 0,0:03:54.06,0:03:56.19,Default,,0,0,0,,Да! Қарғыс атсын!
Dialogue: 0,0:03:56.27,0:03:59.03,Default,,0,0,0,,Цукаса! Келіңіздер, тістеріңізді тазалаңыздар!
Dialogue: 0,0:03:59.11,0:04:01.99,Default,,0,0,0,,Оянсам бұрышта есінеймін.
Dialogue: 0,0:04:02.07,0:04:03.74,Default,,0,0,0,,Әдеттегідей,
Dialogue: 0,0:04:03.82,0:04:05.37,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:04:05.87,0:04:08.12,Default,,0,0,0,,Хонжа қызықсыз.
Dialogue: 0,0:04:08.20,0:04:11.33,Default,,0,0,0,,Қызықты нәрсе жоқ па?
Dialogue: 0,0:04:12.29,0:04:15.92,Default,,0,0,0,,А-а-а... Толық емес жұмысымнан бір күн демалсам да...
Dialogue: 0,0:04:16.00,0:04:19.17,Default,,0,0,0,,Кішкентай бөлмеде үлкен кісі ерініп жүр.
Dialogue: 0,0:04:19.25,0:04:21.42,Default,,0,0,0,,Хиромен жекпе-жекке барайық.
Dialogue: 0,0:04:22.76,0:04:26.01,Default,,0,0,0,,Осуған кезде сөйлеме!
Dialogue: 0,0:04:26.09,0:04:27.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:27.47,0:04:30.22,Default,,0,0,0,,Иә? Не болды? Цукаса
Dialogue: 0,0:04:30.31,0:04:31.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:32.85,0:04:34.31,Default,,0,0,0,,Өрт болған үй
Dialogue: 0,0:04:34.39,0:04:36.85,Default,,0,0,0,,Оны маңайдағылар елу үй деп атайды.
Dialogue: 0,0:04:36.94,0:04:38.73,Default,,0,0,0,,Үлкен ғимаратта
Dialogue: 0,0:04:38.82,0:04:41.40,Default,,0,0,0,,Ол бұрын Кирики тобы президентінің резиденциясы болған, бірақ...
Dialogue: 0,0:04:41.48,0:04:43.65,Default,,0,0,0,,Қазіргі уақытта үй толығымен бос.
Dialogue: 0,0:04:44.40,0:04:45.91,Default,,0,0,0,,Полиция тергеуіне сәйкес
Dialogue: 0,0:04:45.99,0:04:48.37,Default,,0,0,0,,Өрт қою күдігі бар болғандықтан, біз өрттің сөндірілуін күтіп отырмыз...
Dialogue: 0,0:04:48.45,0:04:50.29,Default,,0,0,0,,Эй, мына сарай...
Dialogue: 0,0:04:50.95,0:04:52.79,Default,,0,0,0,,Цукасаның үйі
Dialogue: 0,0:04:55.00,0:04:56.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:06.38,0:05:08.64,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:05:15.10,0:05:16.73,Default,,0,0,0,,Сәлем Цукаса
Dialogue: 0,0:05:16.81,0:05:18.35,Default,,0,0,0,,- (Хисао) Эйзи... - Не болып жатыр?
Dialogue: 0,0:05:18.86,0:05:21.69,Default,,0,0,0,,Мен оны біраз уақытқа қалдырамын.
Dialogue: 0,0:05:21.77,0:05:22.82,Default,,0,0,0,,О
Dialogue: 0,0:05:29.62,0:05:32.29,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:05:32.37,0:05:34.54,Default,,0,0,0,,А, бұл тітіркендіргіш!
Dialogue: 0,0:05:36.00,0:05:38.00,Default,,0,0,0,,(Курокири) Шигараки, күткен нәтижеңді алдың ба?
Dialogue: 0,0:05:38.67,0:05:41.71,Default,,0,0,0,,О, сәлем, Цукаса-сан?
Dialogue: 0,0:05:41.79,0:05:44.46,Default,,0,0,0,,А... Не қалжыңдап тұрсың, Тайджи?
Dialogue: 0,0:05:44.55,0:05:47.18,Default,,0,0,0,,Мен сенің дауысыңды ғана түсінемін.
Dialogue: 0,0:05:47.26,0:05:50.60,Default,,0,0,0,,О, біз бүгін сабақты жібереміз.
Dialogue: 0,0:05:50.68,0:05:53.43,Default,,0,0,0,,Солай ма? Сіз толық емес жұмыс уақытыңызда үзіліс жасайсыз ба?
Dialogue: 0,0:05:53.51,0:05:54.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:54.52,0:05:56.52,Default,,0,0,0,,Ал, қазір бос уақытыңыз көп, солай ма?
Dialogue: 0,0:05:56.60,0:05:58.56,Default,,0,0,0,,Адамдардың айтқанын тыңдаңыз! ?
Dialogue: 0,0:05:59.19,0:06:03.19,Default,,0,0,0,,Бірақ кейін мені шын мықты жігіт ұрды...
Dialogue: 0,0:06:03.27,0:06:05.78,Default,,0,0,0,,Цукаса-сан, маған көмектесші.
Dialogue: 0,0:06:05.86,0:06:07.99,Default,,0,0,0,,Жалғыз келіңізші.
Dialogue: 0,0:06:18.92,0:06:21.63,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:06:46.23,0:06:52.03,Default,,0,0,0,,(қозғалтқыштың атқылау дыбысы)
Dialogue: 0,0:06:57.54,0:06:59.46,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:06:59.54,0:07:04.67,Default,,0,0,0,,(қозғалтқыштың атқылау дыбысы)
Dialogue: 0,0:07:05.25,0:07:08.42,Default,,0,0,0,,Хехехе... Мен енді түсіндім, Такуя.
Dialogue: 0,0:07:08.51,0:07:11.09,Default,,0,0,0,,Бұл нашар ойын болды.
Dialogue: 0,0:07:11.18,0:07:15.18,Default,,0,0,0,,Өлсек те Цукаса мырзаға ондай аянышты сөздер айтпаймыз.
Dialogue: 0,0:07:15.26,0:07:16.89,Default,,0,0,0,,Хехе... Мен бірден алдым.
Dialogue: 0,0:07:18.56,0:07:19.85,Default,,0,0,0,,Т-тоқта… бұл мүмкін емес қой…
Dialogue: 0,0:07:20.56,0:07:24.65,Default,,0,0,0,,Цукаса-санды мен сияқты біреу қорқытқаны үшін кім атайды?
Dialogue: 0,0:07:26.77,0:07:29.24,Default,,0,0,0,,Цукаса-сан біздің достарымыздың бірі!
Dialogue: 0,0:07:29.86,0:07:33.03,Default,,0,0,0,,Гокуракучо басқа командалардан ерекше.
Dialogue: 0,0:07:33.11,0:07:36.66,Default,,0,0,0,,Цукаса-санның соңынан ерейік.
Dialogue: 0,0:07:36.74,0:07:41.50,Default,,0,0,0,,Бізге бұйырса да, Цукаса-санды шын жүректен қорғаймыз!
Dialogue: 0,0:07:41.58,0:07:44.88,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:07:44.96,0:07:46.34,Default,,0,0,0,,Мені күлдір!
Dialogue: 0,0:07:46.42,0:07:47.17,Default,,0,0,0,,Не...
Dialogue: 0,0:07:47.25,0:07:49.67,Default,,0,0,0,,Достар мен жолдастар...
Dialogue: 0,0:07:49.76,0:07:51.84,Default,,0,0,0,,Бұл әлсіз адамның сөзі.
Dialogue: 0,0:07:51.92,0:07:55.22,Default,,0,0,0,,Мен өз күшіммен ештеңе істей алмаймын, мен әлсіз адаммын.
Dialogue: 0,0:07:55.97,0:07:57.10,Default,,0,0,0,,Ноу?
Dialogue: 0,0:07:58.43,0:08:01.56,Default,,0,0,0,,Бұл жігіт өте күшті
Dialogue: 0,0:08:01.64,0:08:04.81,Default,,0,0,0,,Егер мен сені Цукаса-санмен кездестіруге рұқсат етсем, қорқынышты нәрсе болады.
Dialogue: 0,0:08:05.44,0:08:08.52,Default,,0,0,0,,Бұл Кирикидің досы деп ойлайсың ба?
Dialogue: 0,0:08:09.07,0:08:11.53,Default,,0,0,0,,Ол өте бақытты жігіт.
Dialogue: 0,0:08:11.61,0:08:12.99,Default,,0,0,0,,Ийда…
Dialogue: 0,0:08:13.07,0:08:16.99,Default,,0,0,0,,А... Мен сені нөлден бастап өлтіремін.
Dialogue: 0,0:08:17.62,0:08:19.62,Default,,0,0,0,,Цу... Цукаса-сан!
Dialogue: 0,0:08:25.54,0:08:27.84,Default,,0,0,0,,Бұл бәрібір кірді кетіре ме?
Dialogue: 0,0:08:27.92,0:08:29.84,Default,,0,0,0,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:08:29.92,0:08:31.63,Default,,0,0,0,,Оны дұрыс жылтыратыңыз
Dialogue: 0,0:08:32.01,0:08:35.01,Default,,0,0,0,,Иә, мен бар күшімді саламын.
Dialogue: 0,0:08:41.10,0:08:42.68,Default,,0,0,0,,Әй... Охару-сан?
Dialogue: 0,0:08:44.64,0:08:47.27,Default,,0,0,0,,Цукаса Обочама...
Dialogue: 0,0:08:47.81,0:08:49.52,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:08:50.65,0:08:51.98,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:08:53.15,0:08:54.95,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:08:55.70,0:08:59.66,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:00.95,0:09:03.08,Default,,0,0,0,,Менің көңілім түсіп кеткені сонша, бұл әдепсіз.
Dialogue: 0,0:09:03.16,0:09:04.58,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:04.66,0:09:08.21,Default,,0,0,0,,Кирики отбасына қарыздар болған кездегідей емес, бірақ...
Dialogue: 0,0:09:08.29,0:09:10.38,Default,,0,0,0,,Тоқта, Охару-сан.
Dialogue: 0,0:09:10.46,0:09:12.63,Default,,0,0,0,,Мен енді бай бонбон емеспін.
Dialogue: 0,0:09:15.09,0:09:18.64,Default,,0,0,0,,Сіз шынымен де ұлы адам болдыңыз.
Dialogue: 0,0:09:18.72,0:09:21.72,Default,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:09:22.64,0:09:25.02,Default,,0,0,0,,Әй... Охару-сан, протездерің бар!
Dialogue: 0,0:09:25.10,0:09:26.60,Default,,0,0,0,,Ннн…
Dialogue: 0,0:09:26.69,0:09:28.69,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:09:29.15,0:09:31.90,Default,,0,0,0,,Бірақ мен оны да байқадым.
Dialogue: 0,0:09:31.98,0:09:32.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:33.44,0:09:37.61,Default,,0,0,0,,Ерлі-зайыптылар шетелге қашып кеткен соң...
Dialogue: 0,0:09:37.70,0:09:40.91,Default,,0,0,0,,Түрлі жұмыстарды атқардым.
Dialogue: 0,0:09:40.99,0:09:46.16,Default,,0,0,0,,Бірақ адамдар осылай өмір сүргенде ғана түсінеді.
Dialogue: 0,0:09:47.29,0:09:50.17,Default,,0,0,0,,Мен баяғыда Цукаса Ботчаманға не істедім...
Dialogue: 0,0:09:50.79,0:09:53.55,Default,,0,0,0,,Бұл қате болды
Dialogue: 0,0:09:56.17,0:09:59.59,Default,,0,0,0,,Охару-санды кездестіргеніме өте қуаныштымын.
Dialogue: 0,0:10:00.43,0:10:02.05,Default,,0,0,0,,Менімен жиі кездесуге келіңіз.
Dialogue: 0,0:10:03.26,0:10:04.93,Default,,0,0,0,,Саған да сәттілік, Охару-сан.
Dialogue: 0,0:10:05.02,0:10:08.10,Default,,0,0,0,,Иә, Цукаса Оботчамамо.
Dialogue: 0,0:10:10.81,0:10:13.73,Default,,0,0,0,,Мен бұрынғыдай емеспін
Dialogue: 0,0:10:14.23,0:10:17.74,Default,,0,0,0,,Менің ойымша, «мүмкін емес» деген шындық болса да—
Dialogue: 0,0:10:17.82,0:10:20.53,Default,,0,0,0,,Бәрін тастап, қайта тудым.
Dialogue: 0,0:10:20.87,0:10:24.99,Default,,0,0,0,,Цукаса Кирики - Гокуракучоның 8-басшысы.
Dialogue: 0,0:10:37.59,0:10:41.76,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:10:44.31,0:10:45.22,Default,,0,0,0,,ал күнделікті шығындарға қалған ақшаны алыстағы туысы жымқырып кетті
Dialogue: 0,0:10:45.89,0:10:47.56,Default,,0,0,0,,- (Такуя) А... - (Йодзи және т.б.) Иә?
Dialogue: 0,0:10:47.64,0:10:49.39,Default,,0,0,0,,Хаха... Йоджи-сан...
Dialogue: 0,0:10:50.06,0:10:51.35,Default,,0,0,0,,Ал егер?
Dialogue: 0,0:10:51.44,0:10:53.52,Default,,0,0,0,,Ха... Тайджи және басқалар...
Dialogue: 0,0:10:53.61,0:10:55.07,Default,,0,0,0,,Уф... Тайджи және басқалар...
Dialogue: 0,0:10:55.15,0:10:58.03,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:11:06.49,0:11:07.95,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:11:08.04,0:11:11.46,Default,,0,0,0,,Біз Цукаса-санды өз күшімізбен қорғағымыз келді...
Dialogue: 0,0:11:11.54,0:11:14.84,Default,,0,0,0,,Бірақ соңында мен Йоджиге және басқаларға көмектесетін бірдеңе жасадым...
Dialogue: 0,0:11:14.92,0:11:16.55,Default,,0,0,0,,Бұл өте аянышты.
Dialogue: 0,0:11:17.46,0:11:19.92,Default,,0,0,0,,Бірақ ол өте қауіпті!
Dialogue: 0,0:11:20.01,0:11:21.88,Default,,0,0,0,,Мен мұны бір қарағанда түсіндім.
Dialogue: 0,0:11:22.59,0:11:25.14,Default,,0,0,0,,Тайджи және басқалар да солай ойлайтын шығар.
Dialogue: 0,0:11:25.22,0:11:27.35,Default,,0,0,0,,Ол бізді шақырды деп ойлаймын.
Dialogue: 0,0:11:27.43,0:11:31.56,Default,,0,0,0,,Ақымақ... Жаман сөз айтпасаң.
Dialogue: 0,0:11:31.64,0:11:32.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:37.57,0:11:39.15,Default,,0,0,0,,О!
Dialogue: 0,0:11:40.74,0:11:42.57,Default,,0,0,0,,Тайджи және басқалар, көмектесейік!
Dialogue: 0,0:11:42.66,0:11:44.16,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:11:53.87,0:11:55.08,Default,,0,0,0,,Киотодан келген вице-канцлер де сол жоғары лауазымды тұлғалардың бірі ғой, иә?
Dialogue: 0,0:12:01.59,0:12:03.80,Default,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,0:12:06.18,0:12:07.72,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:08.31,0:12:10.14,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:12:11.02,0:12:12.73,Default,,0,0,0,,Ол өте қауіпті!
Dialogue: 0,0:12:12.81,0:12:15.27,Default,,0,0,0,,Мен оны бір қарағанда түсіндім.
Dialogue: 0,0:12:15.69,0:12:19.15,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:12:21.44,0:12:22.19,Default,,0,0,0,,Уф…
Dialogue: 0,0:12:24.66,0:12:26.32,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:12:26.41,0:12:29.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:29.37,0:12:31.12,Default,,0,0,0,,(Дене соқтығысқан дыбыс)
Dialogue: 0,0:12:31.20,0:12:32.25,Default,,0,0,0,,Тек қолтаңба ғана — ерекше алғыс
Dialogue: 0,0:12:32.33,0:12:34.50,Default,,0,0,0,,Сіз оны аша аласыз ба?
Dialogue: 0,0:12:43.42,0:12:45.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:45.68,0:12:46.89,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:48.55,0:12:50.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:52.06,0:12:53.23,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:53.77,0:12:55.64,Default,,0,0,0,,Урия!
Dialogue: 0,0:12:55.73,0:12:58.11,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:58.19,0:13:00.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:00.40,0:13:01.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:03.15,0:13:04.99,Default,,0,0,0,,Не... Мынау не жігіт...
Dialogue: 0,0:13:06.74,0:13:08.20,Default,,0,0,0,,Курутори Ягару…
Dialogue: 0,0:13:08.28,0:13:09.41,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:13:10.74,0:13:12.37,Default,,0,0,0,,Уууу…
Dialogue: 0,0:13:16.17,0:13:17.50,Default,,0,0,0,,Ммм...
Dialogue: 0,0:13:18.21,0:13:22.42,Default,,0,0,0,,А... Ақыр соңында Кирики келмейді.
Dialogue: 0,0:13:22.51,0:13:26.30,Default,,0,0,0,,Цукаса мырзамен кездесуге кім рұқсат береді?
Dialogue: 0,0:13:26.80,0:13:29.14,Default,,0,0,0,,Тек Йоджи-сан және басқалар сенімен сөйлессін.
Dialogue: 0,0:13:29.22,0:13:30.64,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:13:33.06,0:13:33.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:33.89,0:13:34.85,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:13:41.82,0:13:47.20,Default,,0,0,0,,Мм... сендер неге Кирикиге сонша амбициялармен жүрсіңдер?
Dialogue: 0,0:13:47.82,0:13:52.12,Default,,0,0,0,,Цукасада қандай кек бар екенін білмеймін, бірақ бұл менің басым ғана.
Dialogue: 0,0:13:52.79,0:13:55.91,Default,,0,0,0,,Цукасаны нысанаға алған адамды өлтіремін!
Dialogue: 0,0:13:56.00,0:13:56.83,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:13:56.91,0:13:58.71,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:13:59.33,0:14:01.34,Default,,0,0,0,,Тоқта, тоқта!
Dialogue: 0,0:14:01.42,0:14:05.71,Default,,0,0,0,,Сенің көзің мен сияқты еді, сондықтан маған көмектесер едің деп ойладым.
Dialogue: 0,0:14:05.80,0:14:08.55,Default,,0,0,0,,Егер Кирикидің досы болғың келсе...
Dialogue: 0,0:14:09.30,0:14:11.26,Default,,0,0,0,,Мен де сені өлтірдім.
Dialogue: 0,0:14:14.39,0:14:16.02,Default,,0,0,0,,Ннн…
Dialogue: 0,0:14:18.56,0:14:19.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:24.07,0:14:25.48,Default,,0,0,0,,Ха... Ах!
Dialogue: 0,0:14:27.40,0:14:28.90,Default,,0,0,0,,Ахх...
Dialogue: 0,0:14:33.70,0:14:36.16,Default,,0,0,0,,Ахх...
Dialogue: 0,0:14:48.55,0:14:51.30,Default,,0,0,0,,Жоқ! Мен оны ұнатпаймын!
Dialogue: 0,0:14:52.64,0:14:56.85,Default,,0,0,0,,Шинжи: Масако апайдың айтқанын мұқият тыңдаңыз.
Dialogue: 0,0:14:57.39,0:15:00.10,Default,,0,0,0,,Жарайды, Макото.
Dialogue: 0,0:15:00.19,0:15:02.48,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:15:02.56,0:15:05.27,Default,,0,0,0,,Мен әкем мен анамның қасындамын!
Dialogue: 0,0:15:05.90,0:15:08.24,Default,,0,0,0,,Сәл ғана, мен сені бірден алып кетейін.
Dialogue: 0,0:15:08.32,0:15:10.70,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:15:10.78,0:15:12.95,Default,,0,0,0,,Масако-сан, өтінемін.
Dialogue: 0,0:15:13.03,0:15:13.87,Default,,0,0,0,,Камадо!
Dialogue: 0,0:15:13.95,0:15:16.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:16.79,0:15:19.29,Default,,0,0,0,,(Таксидің басталған дыбысы)
Dialogue: 0,0:15:23.83,0:15:28.34,Default,,0,0,0,,Мүмкін мен содан кейін түсіндім.
Dialogue: 0,0:15:30.09,0:15:34.93,Default,,0,0,0,,Мен әкем мен анамды ешқашан көрмейтіндей өмір сүрмеймін деп үміттенемін.
Dialogue: 0,0:15:37.77,0:15:42.02,Default,,0,0,0,,Жарайды... Мен оны аяймын, өйткені ол газбен өз-өзіне қол жұмсады.
Dialogue: 0,0:15:42.10,0:15:45.02,Default,,0,0,0,,Которита мырза екеуміз күнде қарыз жинайтынбыз.
Dialogue: 0,0:15:45.11,0:15:48.11,Default,,0,0,0,,О... Менің ойымша, бұл көмектеспейді.
Dialogue: 0,0:15:49.32,0:15:52.15,Default,,0,0,0,,Сол кезде мен...
Dialogue: 0,0:15:52.70,0:15:54.20,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:58.70,0:16:00.96,Default,,0,0,0,,Бақатареге!
Dialogue: 0,0:16:04.38,0:16:05.67,Default,,0,0,0,,- (Йодзи) Уф! -(Хисао жасы) Йоджи!
Dialogue: 0,0:16:05.75,0:16:06.63,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:06.71,0:16:09.92,Default,,0,0,0,,Мен жаңа ғана тозақтан шықтым!
Dialogue: 0,0:16:10.01,0:16:12.09,Default,,0,0,0,,Әкем мен шешеме жау болу үшін!
Dialogue: 0,0:16:12.17,0:16:14.59,Default,,0,0,0,,(Ясуджи мен оның достарының айқайы)
Dialogue: 0,0:16:15.09,0:16:17.81,Default,,0,0,0,,Мен оны таптым деп ойлаған кезде...
Dialogue: 0,0:16:17.89,0:16:21.06,Default,,0,0,0,,Қарапайым лақ – ру басы! ?
Dialogue: 0,0:16:21.14,0:16:25.31,Default,,0,0,0,,Мені бәрінен де осындай ақымақтар ренжітеді!
Dialogue: 0,0:16:25.40,0:16:26.98,Default,,0,0,0,,Мен Кирикидің қанын жек көремін
Dialogue: 0,0:16:27.82,0:16:29.32,Default,,0,0,0,,Мен де өртеген сарайды...
Dialogue: 0,0:16:29.40,0:16:33.99,Default,,0,0,0,,Кирикидің айналасындағылардың бәрін өлтірсем ше!
Dialogue: 0,0:16:34.07,0:16:39.49,Default,,0,0,0,,(Өрт сөндіру машинасының сиренасы)
Dialogue: 0,0:16:39.58,0:16:46.00,Default,,0,0,0,,(Өрт сөндіру машинасының сиренасы)
Dialogue: 0,0:16:50.21,0:16:52.92,Default,,0,0,0,,Мен қайта дүниеге келдім
Dialogue: 0,0:16:59.22,0:16:59.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:05.02,0:17:06.65,Default,,0,0,0,,Мұны Кирикиге айт.
Dialogue: 0,0:17:07.23,0:17:11.19,Default,,0,0,0,,Сіз айтқандай, мен бұрынғыдан басқа адам болғым келсе...
Dialogue: 0,0:17:11.90,0:17:15.32,Default,,0,0,0,,Қашып, менің алдымда көрін.
Dialogue: 0,0:17:15.40,0:17:16.53,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:17:16.61,0:17:19.95,Default,,0,0,0,,Күте тұрыңыз, Йоджи! Тайджи мен басқаларды жайына қалдыр, Поли да келеді.
Dialogue: 0,0:17:20.03,0:17:21.03,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:17:23.33,0:17:24.54,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:25.25,0:17:31.21,Default,,0,0,0,,Тайджи мен Риосуке Акихико үшеуі де күйік және көгерген жарақаттармен ауруханаға түсті.
Dialogue: 0,0:17:35.34,0:17:39.64,Default,,0,0,0,,Мойындағым келмейді, бірақ ол адам сөзсіз күшті.
Dialogue: 0,0:17:39.72,0:17:42.18,Default,,0,0,0,,Мен өзімді Хиро мен Даннодан өзгеше сезінемін.
Dialogue: 0,0:17:43.35,0:17:46.31,Default,,0,0,0,,Мен де осылай соққы алатынымды білдім.
Dialogue: 0,0:17:47.19,0:17:49.69,Default,,0,0,0,,Ол сені шынымен өлтіргісі келеді.
Dialogue: 0,0:17:49.77,0:17:50.86,Default,,0,0,0,,…тұздық
Dialogue: 0,0:17:50.94,0:17:53.28,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:17:54.32,0:17:56.95,Default,,0,0,0,,Күте тұрыңыз, Цукаса! Қайда бара жатырсың? ?
Dialogue: 0,0:17:57.03,0:17:58.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:58.16,0:17:59.53,Default,,0,0,0,,Мені жіберіңіз, Йо Чан.
Dialogue: 0,0:17:59.62,0:18:02.03,Default,,0,0,0,,Менің кесірімнен бәрі қиыншылықта...
Dialogue: 0,0:18:02.12,0:18:03.79,Default,,0,0,0,,Мен кесімді жасаймын!
Dialogue: 0,0:18:03.87,0:18:07.00,Default,,0,0,0,,Бақатаре! Неге сен кінәлісің?
Dialogue: 0,0:18:07.08,0:18:10.50,Default,,0,0,0,,Неліктен бір-біріңе ата-анаңды жүктеулерің керек?
Dialogue: 0,0:18:12.63,0:18:16.09,Default,,0,0,0,,Менің үйімді отқа жаққан Которита болды.
Dialogue: 0,0:18:16.17,0:18:17.93,Default,,0,0,0,,Мен ақыры түсіндім.
Dialogue: 0,0:18:19.97,0:18:22.60,Default,,0,0,0,,Содан бері менде бір түйсік бар.
Dialogue: 0,0:18:23.97,0:18:27.52,Default,,0,0,0,,Менімен дерлік құрдас болса да...
Dialogue: 0,0:18:27.60,0:18:31.27,Default,,0,0,0,,Жабайы аң Митуна...
Dialogue: 0,0:18:31.36,0:18:33.40,Default,,0,0,0,,Менің көргенім осы болды
Dialogue: 0,0:18:34.40,0:18:38.99,Default,,0,0,0,,Сол көздер түсімде көріне берді, қалай ұйықтай алмағаным есімде.
Dialogue: 0,0:18:40.49,0:18:41.99,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:18:42.07,0:18:43.45,Default,,0,0,0,,Директор…
Dialogue: 0,0:18:44.24,0:18:48.00,Default,,0,0,0,,Мүмкін ол әлі Тістелген шығар.
Dialogue: 0,0:18:48.41,0:18:52.04,Default,,0,0,0,,Кішкентай кезімде бәрінен қорған болып өстім.
Dialogue: 0,0:18:52.13,0:18:53.92,Default,,0,0,0,,Сіз аңғал болдыңыз.
Dialogue: 0,0:18:55.09,0:19:00.01,Default,,0,0,0,,Сол кездегі қорқыныш сезімін әлі ұмыта алмаймын.
Dialogue: 0,0:19:08.93,0:19:11.44,Default,,0,0,0,,Еңбегіңіз үшін көп рахмет.
Dialogue: 0,0:19:19.28,0:19:20.61,Default,,0,0,0,,Кішкене ғана...
Dialogue: 0,0:19:22.03,0:19:26.12,Default,,0,0,0,,А... сен де бүгін көп жұмыс істедің.
Dialogue: 0,0:19:26.87,0:19:28.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:29.29,0:19:30.46,Default,,0,0,0,,О, менің...
Dialogue: 0,0:19:30.54,0:19:31.71,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:19:32.37,0:19:36.00,Default,,0,0,0,,Ой, кешіріңіз, мен басқа жаққа қарадым...
Dialogue: 0,0:19:38.17,0:19:39.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:40.09,0:19:41.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:43.97,0:19:47.68,Default,,0,0,0,,Хмм... бір жерде кездестік пе?
Dialogue: 0,0:19:50.27,0:19:52.90,Default,,0,0,0,,Бірақ бұл анық
Dialogue: 0,0:19:53.73,0:19:56.36,Default,,0,0,0,,Мен бұрынғыдай емеспін
Dialogue: 0,0:19:56.44,0:19:57.98,Default,,0,0,0,,(қозғалтқыштың атқылау дыбысы)
Dialogue: 0,0:19:58.61,0:20:03.86,Default,,0,0,0,,Мен мұны жеңе аламын және өзімнің бұрынғы менден толықтай асып кете аламын.
Dialogue: 0,0:20:03.95,0:20:08.16,Default,,0,0,0,,Бүлінгенім сонша, мен жайлы өмір сүрдім!
Dialogue: 0,0:20:09.62,0:20:14.04,Default,,0,0,0,,Бұл бізге қажет емес деп ойлаймын. Бізге керек емес еді.
Dialogue: 0,0:20:14.12,0:20:15.71,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:20:15.79,0:20:19.67,Default,,0,0,0,,Біраз әбігер болды, бірақ мен мұнда Цукасаның түрін көрсетемін.
Dialogue: 0,0:20:21.17,0:20:23.51,Default,,0,0,0,,Жеңіске жет, Цукаса!
Dialogue: 0,0:20:25.43,0:20:28.51,Default,,0,0,0,,(қозғалтқыштың атқылау дыбысы)
Dialogue: 0,0:20:38.40,0:20:41.32,Default,,0,0,0,,Біз маңызды нәрсені ұмытып кете жаздадық.
Dialogue: 0,0:20:42.24,0:20:45.24,Default,,0,0,0,,Қиын кезде ең көп арқа сүйей алатын адам.
Dialogue: 0,0:20:45.91,0:20:48.99,Default,,0,0,0,,Ашулы Цукаса Жапониядағы ең мықты!
Dialogue: 0,0:20:54.58,0:20:56.04,Default,,0,0,0,,Бұл... жарайды!
Dialogue: 0,0:20:56.12,0:20:58.63,Default,,0,0,0,,Цу... Цукасаға сену керек!
Dialogue: 0,0:20:59.17,0:21:00.42,Default,,0,0,0,,Мен өлсем бола ма?
Dialogue: 0,0:21:10.39,0:21:14.31,Default,,0,0,0,,Өзіңіздің... өз күшіңізге сеніңіз.
Dialogue: 0,0:21:17.15,0:21:20.61,Default,,0,0,0,,Маған... Қорқатын ештеңе жоқ!
Dialogue: 0,0:21:22.03,0:21:24.15,Default,,0,0,0,,Мен Цукаса Кирикимін!
Dialogue: 0,0:21:25.20,0:21:30.58,Default,,0,0,0,,Бұл Цукаса Кирики, Гокуракучоның 8-басшысы!
Dialogue: 0,0:21:48.05,0:21:50.76,Default,,0,0,0,,(бір-бірін соғу дыбысы)
Dialogue: 0,0:21:50.85,0:21:52.51,Default,,0,0,0,,Кек…
Dialogue: 0,0:21:52.60,0:21:56.94,Default,,0,0,0,,Осы екі әріптің арқасында қайта тудым.
Dialogue: 0,0:21:58.85,0:22:00.52,Default,,0,0,0,,Мен мұны өзім анықтадым
Dialogue: 0,0:22:02.19,0:22:07.24,Default,,0,0,0,,Бірақ мен мектеп табалдырығын аттағанша өзімді-өзім басып қалдым...
Dialogue: 0,0:22:07.32,0:22:10.20,Default,,0,0,0,,Мен боксқа толы өмір сүрдім.
Dialogue: 0,0:22:11.24,0:22:13.29,Default,,0,0,0,,Сіз қорқып қалдыңыз
Dialogue: 0,0:22:13.37,0:22:16.25,Default,,0,0,0,,Менің ішімде Кирикиге деген өшпенділік...
Dialogue: 0,0:22:16.33,0:22:19.67,Default,,0,0,0,,Ақылсызда үлкейе түсу
Dialogue: 0,0:22:20.38,0:22:21.42,Default,,0,0,0,,Демоноруқтар корпусын төмен санауға батпа!
Dialogue: 0,0:22:24.67,0:22:29.34,Default,,0,0,0,,Мен ұстап тұрғанның бәрі сол сәтте кенеттен ашылды...
Dialogue: 0,0:22:34.72,0:22:35.97,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:40.19,0:22:41.61,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:22:43.69,0:22:45.53,Default,,0,0,0,,Қазір не болып жатыр?
Dialogue: 0,0:22:45.61,0:22:48.24,Default,,0,0,0,,Данно мырзаға тең келетін ешкім әлі жоқ па?
Dialogue: 0,0:22:48.32,0:22:49.70,Default,,0,0,0,,Жақсы
Dialogue: 0,0:22:49.78,0:22:54.79,Default,,0,0,0,,Хонжага, жұмақ көбелегі үлкен өзгеріс жасады.
Dialogue: 0,0:22:55.58,0:22:59.25,Default,,0,0,0,,Гокуракучо десеңіз, ессіз командада боласыз.
Dialogue: 0,0:22:59.79,0:23:02.46,Default,,0,0,0,,Бұл қазір өзгеруде.
Dialogue: 0,0:23:02.54,0:23:03.63,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:23:03.71,0:23:05.17,Default,,0,0,0,,Цукаса Кирики былай дейді:
Dialogue: 0,0:23:05.25,0:23:08.76,Default,,0,0,0,,Бастапқыда Бонбон деген бай адам бас болды.
Dialogue: 0,0:23:08.84,0:23:11.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:11.93,0:23:13.51,Default,,0,0,0,,Ақырында...
Dialogue: 0,0:23:13.60,0:23:17.06,Default,,0,0,0,,Мен Цукаса Кирикиді таптым!
Dialogue: 0,0:23:17.56,0:23:20.19,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:23:20.27,0:23:22.90,Default,,0,0,0,,Кел, Которита!
Dialogue: 0,0:23:25.52,0:23:29.61,Default,,0,0,0,,Аңырап қайнауды жалғастырдым.
Dialogue: 0,0:23:29.95,0:23:32.49,Default,,0,0,0,,Мен Котоританы іздеуді жалғастырдым.
Dialogue: 0,0:23:33.03,0:23:37.04,Default,,0,0,0,,Бірақ бұл менің бүкіл денемдегі діріл не?
Dialogue: 0,0:23:38.08,0:23:41.75,Default,,0,0,0,,Мен шынымен Котоританы тапқым келеді ме?
Dialogue: 0,0:23:41.83,0:23:45.17,Default,,0,0,0,,Дәл осылай... Дәл осылай, мен...
Dialogue: 0,0:23:48.55,0:23:51.97,Default,,0,0,0,,(қозғалтқыштың атқылау дыбысы)
Dialogue: 0,0:23:52.05,0:23:55.89,Default,,0,0,0,,(қозғалтқыштың атқылау дыбысы)
Dialogue: 0,0:23:55.97,0:24:01.06,Default,,0,0,0,,(қозғалтқыштың атқылау дыбысы)
Dialogue: 0,0:24:01.14,0:24:03.52,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:24:12.07,0:24:14.99,Default,,0,0,0,,Әке, мен оны таптым.
Dialogue: 0,0:24:39.18,0:24:43.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:44.44,0:24:45.60,Default,,0,0,0,,Оля!
Dialogue: 0,0:24:45.69,0:24:46.86,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:24:48.86,0:24:49.73,Default,,0,0,0,,Уф…
Dialogue: 0,0:24:51.99,0:24:53.95,Default,,0,0,0,,Өзгеріс жоқ
Dialogue: 0,0:24:54.03,0:24:58.78,Default,,0,0,0,,Жайлы өскен жас бала кезімде
Dialogue: 0,0:25:00.16,0:25:01.70,Default,,0,0,0,,Дея!
Dialogue: 0,0:25:01.79,0:25:03.33,Default,,0,0,0,,Оля!
Dialogue: 0,0:25:03.41,0:25:05.25,Default,,0,0,0,,Тея!
Dialogue: 0,0:25:06.25,0:25:09.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:25:09.21,0:25:10.21,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:25:10.30,0:25:12.51,Default,,0,0,0,,Дорья!
Dialogue: 0,0:25:14.09,0:25:15.38,Default,,0,0,0,,Гү…
Dialogue: 0,0:25:18.51,0:25:20.97,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,0:25:21.51,0:25:24.39,Default,,0,0,0,,Мен тозақтың дәмін таттым...
Dialogue: 0,0:25:24.48,0:25:27.90,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,0:25:35.74,0:25:37.07,Default,,0,0,0,,Әлі жоқ
Dialogue: 0,0:25:37.16,0:25:38.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:40.12,0:25:41.53,Default,,0,0,0,,Ха! Тат!
Dialogue: 0,0:25:41.62,0:25:42.87,Default,,0,0,0,,Ха! Тат!
Dialogue: 0,0:25:42.95,0:25:44.54,Default,,0,0,0,,Ха! Хмф!
Dialogue: 0,0:25:44.62,0:25:46.04,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:25:46.12,0:25:48.00,Default,,0,0,0,,Ха! Хааа!
Dialogue: 0,0:25:48.08,0:25:50.00,Default,,0,0,0,,Сәлем! Хааа!
Dialogue: 0,0:25:50.09,0:25:55.22,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:25:55.30,0:25:57.22,Default,,0,0,0,,Ахх...
Dialogue: 0,0:25:58.59,0:26:00.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:00.30,0:26:02.22,Default,,0,0,0,,Әлі өлме!
Dialogue: 0,0:26:02.31,0:26:03.89,Default,,0,0,0,,Кирики!
Dialogue: 0,0:26:03.97,0:26:09.94,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:26:11.02,0:26:15.53,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:26:15.61,0:26:16.65,Default,,0,0,0,,Уф…
Dialogue: 0,0:26:19.95,0:26:20.99,Default,,0,0,0,,Уууу…
Dialogue: 0,0:26:24.62,0:26:26.04,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:26:26.96,0:26:30.79,Default,,0,0,0,,Мен бұл жігітті жеңе алмаймын...
Dialogue: 0,0:26:30.88,0:26:34.21,Default,,0,0,0,,Арқада алып жүретін заттың көлемі тым бөлек.
Dialogue: 0,0:26:45.52,0:26:46.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:47.39,0:26:49.52,Default,,0,0,0,,Охару…сан
Dialogue: 0,0:26:49.60,0:26:52.65,Default,,0,0,0,,Хмф... Мен солай ойлаймын.
Dialogue: 0,0:26:52.73,0:26:55.07,Default,,0,0,0,,Біз көшеде кездейсоқ кездесіп қалдық.
Dialogue: 0,0:26:55.15,0:26:58.90,Default,,0,0,0,,Кәрі қарт мені есіне де түсірмеді.
Dialogue: 0,0:26:58.99,0:27:01.49,Default,,0,0,0,,Мен ұмытуға мүмкіндік жоқ.
Dialogue: 0,0:27:01.99,0:27:03.95,Default,,0,0,0,,Сіз ұмыта аласыз ба?
Dialogue: 0,0:27:04.03,0:27:07.45,Default,,0,0,0,,Мен сендерді қашуға жол бермеймін, мен бәріңді өлтіремін!
Dialogue: 0,0:27:08.04,0:27:09.91,Default,,0,0,0,,Ммм...
Dialogue: 0,0:27:11.17,0:27:14.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:15.50,0:27:16.88,Default,,0,0,0,,Хмм... Аа...
Dialogue: 0,0:27:25.39,0:27:26.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:30.14,0:27:31.19,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:27:31.27,0:27:32.31,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:27:38.61,0:27:41.74,Default,,0,0,0,,Ммм...
Dialogue: 0,0:27:43.20,0:27:44.32,Default,,0,0,0,,Уууу…
Dialogue: 0,0:27:44.41,0:27:47.16,Default,,0,0,0,,Мынау не жігіт... кенет...
Dialogue: 0,0:27:47.24,0:27:49.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:49.70,0:27:52.83,Default,,0,0,0,,Өлді! Қарғыс атсын!
Dialogue: 0,0:27:53.46,0:27:54.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:27:55.38,0:28:00.13,Default,,0,0,0,,Менде ешкімнен кем болмайтын күш пен сенімділік бар.
Dialogue: 0,0:28:00.59,0:28:03.43,Default,,0,0,0,,Ммм...
Dialogue: 0,0:28:04.30,0:28:05.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:28:06.18,0:28:07.47,Default,,0,0,0,,Уф!
Dialogue: 0,0:28:07.56,0:28:08.35,Default,,0,0,0,,Ахх...
Dialogue: 0,0:28:08.85,0:28:11.43,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:28:11.52,0:28:12.81,Default,,0,0,0,,Уф!
Dialogue: 0,0:28:12.89,0:28:14.90,Default,,0,0,0,,Мен сені ұрсам да, ұрсам да...
Dialogue: 0,0:28:14.98,0:28:17.65,Default,,0,0,0,,Кирики жолда келе жатыр!
Dialogue: 0,0:28:18.15,0:28:19.36,Default,,0,0,0,,Өл, өл!
Dialogue: 0,0:28:19.44,0:28:22.36,Default,,0,0,0,,(Тодороки) Камино… (Камино) Жарайды, алдым.
Dialogue: 0,0:28:25.57,0:28:27.49,Default,,0,0,0,,Уау...
Dialogue: 0,0:28:27.58,0:28:28.95,Default,,0,0,0,,Ннн…
Dialogue: 0,0:28:29.49,0:28:31.87,Default,,0,0,0,,А... неге...
Dialogue: 0,0:28:31.96,0:28:36.21,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:28:36.71,0:28:39.67,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:28:39.75,0:28:42.63,Default,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,0:28:42.72,0:28:45.34,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:28:46.47,0:28:47.30,Default,,0,0,0,,Ах…
Dialogue: 0,0:28:49.81,0:28:52.27,Default,,0,0,0,,Дааа!
Dialogue: 0,0:28:52.81,0:28:55.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:28:56.27,0:28:59.11,Default,,0,0,0,,Оля!
Dialogue: 0,0:29:00.90,0:29:01.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:29:06.32,0:29:07.95,Default,,0,0,0,,Ммм...
Dialogue: 0,0:29:16.67,0:29:17.96,Default,,0,0,0,,Иә! Хмм!
Dialogue: 0,0:29:18.04,0:29:19.42,Default,,0,0,0,,Иә! Хмм!
Dialogue: 0,0:29:19.50,0:29:22.96,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:29:23.05,0:29:24.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:24.22,0:29:26.43,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:29:27.18,0:29:28.30,Default,,0,0,0,,Уф!
Dialogue: 0,0:29:28.85,0:29:30.26,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:29:30.85,0:29:33.73,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:29:34.27,0:29:35.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:35.77,0:29:36.73,Default,,0,0,0,,Ннн!
Dialogue: 0,0:29:38.27,0:29:39.31,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:29:42.32,0:29:45.65,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:29:45.74,0:29:49.57,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:29:49.66,0:29:51.58,Default,,0,0,0,,Ннн…
Dialogue: 0,0:29:51.66,0:29:55.08,Default,,0,0,0,,А, қарғыс атсын!
Dialogue: 0,0:29:56.25,0:29:57.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:57.54,0:30:00.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:30:00.50,0:30:01.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:30:04.30,0:30:05.72,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:30:12.51,0:30:13.72,Default,,0,0,0,,Ах…
Dialogue: 0,0:30:13.81,0:30:15.98,Default,,0,0,0,,Сен сол қарттың жауысың ба?
Dialogue: 0,0:30:16.06,0:30:18.39,Default,,0,0,0,,Досың өлтірілді ме?
Dialogue: 0,0:30:18.85,0:30:22.73,Default,,0,0,0,,Жеңілсең де неге тұрасың?
Dialogue: 0,0:30:22.82,0:30:23.94,Default,,0,0,0,,Ахх...
Dialogue: 0,0:30:24.03,0:30:27.99,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:30:28.07,0:30:31.41,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:30:35.45,0:30:37.29,Default,,0,0,0,,Ннн… Ннн…
Dialogue: 0,0:30:37.87,0:30:39.71,Default,,0,0,0,,Ннн…
Dialogue: 0,0:30:39.79,0:30:41.42,Default,,0,0,0,,Ахх...
Dialogue: 0,0:30:44.25,0:30:45.67,Default,,0,0,0,,Ннн!
Dialogue: 0,0:30:46.21,0:30:49.63,Default,,0,0,0,,Әке!
Dialogue: 0,0:30:55.01,0:30:58.85,Default,,0,0,0,,Менің ең жақын досым Сабуро Кирикиге
Dialogue: 0,0:30:59.27,0:31:03.44,Default,,0,0,0,,Мен сізбен кездесіп, рахмет айтқым келді.
Dialogue: 0,0:31:03.52,0:31:07.86,Default,,0,0,0,,Көп нәрсе болды, бірақ мен сенгендей болды.
Dialogue: 0,0:31:07.94,0:31:11.86,Default,,0,0,0,,Мені өз компанияңыздың құнына да қорғағаны үшін.
Dialogue: 0,0:31:11.95,0:31:14.03,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:31:14.91,0:31:18.58,Default,,0,0,0,,Бірақ мен сізге бұдан былай қиындық туғыза алмаймын.
Dialogue: 0,0:31:20.29,0:31:23.54,Default,,0,0,0,,Мен күткендей шаршадым.
Dialogue: 0,0:31:29.17,0:31:33.72,Default,,0,0,0,,Бірақ мен саған бір сәтке де күмәнданбадым.
Dialogue: 0,0:31:34.47,0:31:36.68,Default,,0,0,0,,Мен мұны мақтан тұтамын
Dialogue: 0,0:31:40.44,0:31:45.86,Default,,0,0,0,,Сабуро, егер баламды бір жерде кездестірсеңіз, маған хабарлаңыз.
Dialogue: 0,0:31:46.48,0:31:48.86,Default,,0,0,0,,Қолынан ештеңе келмейтін шарасыз әке еді.
Dialogue: 0,0:31:49.78,0:31:54.53,Default,,0,0,0,,Досқа сену деген мақтаныш - менің мұрагер болғым келетін нәрсе.
Dialogue: 0,0:31:58.16,0:31:59.87,Default,,0,0,0,,- (Ясуо) Синдзи - (Шиндзи) Не?
Dialogue: 0,0:31:59.95,0:32:01.79,Default,,0,0,0,,Иә? Синдзи
Dialogue: 0,0:32:01.87,0:32:05.67,Default,,0,0,0,,Сіз мұны бір адаммен жасай аласыз. Ең жақсы дос деп атауға болатын дос табыңыз.
Dialogue: 0,0:32:05.75,0:32:07.67,Default,,0,0,0,,(1-қыз) Өзіңізге ұнағанша торт алыңыз
Dialogue: 0,0:32:08.92,0:32:11.09,Default,,0,0,0,,Адамдар жалғыз өмір сүре алмайды
Dialogue: 0,0:32:11.17,0:32:14.64,Default,,0,0,0,,Ең жақын досыңыз болса, қандай жағдай болмасын...
Dialogue: 0,0:32:14.72,0:32:18.10,Default,,0,0,0,,Қабырға қанша үлкен болса да, оны жеңуге күшіңіз жетеді.
Dialogue: 0,0:32:18.18,0:32:19.68,Default,,0,0,0,,Хмм?
Dialogue: 0,0:32:20.43,0:32:23.35,Default,,0,0,0,,Хахахаха... Шинджидің қытығы бар...
Dialogue: 0,0:32:23.44,0:32:28.27,Default,,0,0,0,,Бұл қиын болды ма? Иә? Хахаха...
Dialogue: 0,0:32:57.10,0:32:57.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:01.39,0:33:03.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:33:05.06,0:33:07.06,Default,,0,0,0,,Хи хи хи...
Dialogue: 0,0:33:07.69,0:33:08.77,Default,,0,0,0,,Цукаса!
Dialogue: 0,0:33:08.86,0:33:10.94,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:33:11.65,0:33:13.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:13.28,0:33:16.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:16.28,0:33:17.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:22.41,0:33:26.33,Default,,0,0,0,,Хмф... Ең болмаса сақ болыңыз.
Dialogue: 0,0:33:27.00,0:33:29.00,Default,,0,0,0,,Сіз әлі де нысанаға алған адам...
Dialogue: 0,0:33:29.09,0:33:30.88,Default,,0,0,0,,Танмари ордасы
Dialogue: 0,0:33:35.17,0:33:37.76,Default,,0,0,0,,Мен ішке кіргенде
Dialogue: 0,0:33:37.84,0:33:40.97,Default,,0,0,0,,Бұл шынымен қауіпті, бірақ бәрі соған ұмтылады.
Dialogue: 0,0:33:42.85,0:33:45.06,Default,,0,0,0,,Мен сені көздеп отырмын
Dialogue: 0,0:33:48.65,0:33:49.69,Default,,0,0,0,,Фу…
Dialogue: 0,0:34:04.25,0:34:06.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:07.46,0:34:08.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:34:11.63,0:34:13.59,Default,,0,0,0,,Әкем айтқандай-
Dialogue: 0,0:34:14.09,0:34:16.59,Default,,0,0,0,,Адамдар жалғыз өмір сүре алатын адамдар түрі.
Dialogue: 0,0:34:16.67,0:34:18.09,Default,,0,0,0,,Оранджару
Dialogue: 0,0:34:19.14,0:34:23.85,Default,,0,0,0,,Егер... онда, егер сен достарыңа шынымен сенсең...
Dialogue: 0,0:34:24.52,0:34:28.52,Default,,0,0,0,,Қанша қиналсам да, қанша қиын болса да—
Dialogue: 0,0:34:29.44,0:34:32.98,Default,,0,0,0,,Өз өміріңді қима
Dialogue: 0,0:34:34.78,0:34:39.61,Default,,0,0,0,,Ең жаманы, мен өз өмірімді де қорғай алмадым.
Dialogue: 0,0:34:39.70,0:34:41.70,Default,,0,0,0,,Ол менің әкем.
Dialogue: 0,0:34:42.83,0:34:47.83,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:34:48.66,0:34:53.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:56.46,0:34:58.47,Default,,0,0,0,,♪～
Dialogue: 0,0:37:34.08,0:37:36.08,Default,,0,0,0,,～♪
