Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.00,0:00:06.92,Default,,0,0,0,,Папа папа!
Dialogue: 0,0:00:07.00,0:00:09.63,Default,,0,0,0,,Әке, асығыңыз!
Dialogue: 0,0:00:09.71,0:00:12.22,Default,,0,0,0,,Әке, тұрыңыз!
Dialogue: 0,0:00:12.30,0:00:14.88,Default,,0,0,0,,Хмм... Бұл не? Таңертең ерте.
Dialogue: 0,0:00:14.97,0:00:17.80,Default,,0,0,0,,Бұл тітіркендіргіш... хмм?
Dialogue: 0,0:00:17.89,0:00:19.51,Default,,0,0,0,,Ммм
Dialogue: 0,0:00:19.60,0:00:21.81,Default,,0,0,0,,Мм... кім?
Dialogue: 0,0:00:21.89,0:00:24.31,Default,,0,0,0,,Әке! Пи!
Dialogue: 0,0:00:25.90,0:00:27.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:27.23,0:00:28.65,Default,,0,0,0,,Пи...
Dialogue: 0,0:00:29.82,0:00:33.03,Default,,0,0,0,,Хаха ха... Хмф!
Dialogue: 0,0:00:33.74,0:00:34.99,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:00:35.95,0:00:38.58,Default,,0,0,0,,Хаа... Хаа~
Dialogue: 0,0:00:40.08,0:00:41.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:43.79,0:00:46.04,Default,,0,0,0,,Әкемнің еркелігі~
Dialogue: 0,0:00:46.12,0:00:46.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:47.50,0:00:49.42,Default,,0,0,0,,Ол келмейді~
Dialogue: 0,0:00:51.21,0:00:52.42,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:00:52.51,0:00:54.51,Default,,0,0,0,,(ағын судың дыбысы)
Dialogue: 0,0:00:54.59,0:00:57.14,Default,,0,0,0,,Сіз шымшып қалдыңыз, әке.
Dialogue: 0,0:00:57.68,0:00:58.51,Default,,0,0,0,,О
Dialogue: 0,0:00:58.60,0:00:59.80,Default,,0,0,0,,Құшақтау~
Dialogue: 0,0:00:59.89,0:01:00.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:00.72,0:01:02.89,Default,,0,0,0,,Қолыңызды жуыңыз!
Dialogue: 0,0:01:04.18,0:01:04.73,Default,,0,0,0,,Эххе
Dialogue: 0,0:01:04.81,0:01:07.02,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:01:08.48,0:01:10.48,Default,,0,0,0,,♪～
Dialogue: 0,0:02:35.94,0:02:37.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:42.53,0:02:46.20,Default,,0,0,0,,Ой... Бұл сенің әкеңнің үйі ме?
Dialogue: 0,0:02:46.29,0:02:49.50,Default,,0,0,0,,А? Иә, мен жай ғана жүк тиеушімін.
Dialogue: 0,0:02:49.58,0:02:50.96,Default,,0,0,0,,Isolo?
Dialogue: 0,0:02:53.54,0:02:57.13,Default,,0,0,0,,О, керемет! Тіпті миллиметрді бұзыңыз!
Dialogue: 0,0:02:57.21,0:02:58.63,Default,,0,0,0,,Ах~ Жоқ, жоқ, жоқ
Dialogue: 0,0:02:58.72,0:02:59.63,Default,,0,0,0,,Эх!
Dialogue: 0,0:02:59.72,0:03:01.97,Default,,0,0,0,,Ол бәрібір сізге жетпейді.
Dialogue: 0,0:03:02.05,0:03:05.10,Default,,0,0,0,,Хмм... Хмф!
Dialogue: 0,0:03:09.14,0:03:11.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:11.52,0:03:13.69,Default,,0,0,0,,Бұл ауыр!
Dialogue: 0,0:03:13.77,0:03:15.06,Default,,0,0,0,,Ах, о... сен!
Dialogue: 0,0:03:15.15,0:03:16.44,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:03:17.19,0:03:18.03,Default,,0,0,0,,Ах! (Икки) О, қазірдің өзінде!
Dialogue: 0,0:03:18.11,0:03:19.40,Default,,0,0,0,,Не істеп жатырсың! (Нөл) Хмм...
Dialogue: 0,0:03:19.49,0:03:22.66,Default,,0,0,0,,Эххехе... Мири де жұмыртқаны сындырғысы келеді!
Dialogue: 0,0:03:22.74,0:03:25.20,Default,,0,0,0,,Бір орында тұрып, күте тұрыңыз! Бұл қызықсыз!
Dialogue: 0,0:03:25.28,0:03:26.58,Default,,0,0,0,,Бұл күлкілі емес!
Dialogue: 0,0:03:26.66,0:03:27.91,Default,,0,0,0,,Не?
Dialogue: 0,0:03:29.25,0:03:31.21,Default,,0,0,0,,Нөл Дәл дұрыс жерде!
Dialogue: 0,0:03:31.29,0:03:33.83,Default,,0,0,0,,Мири Нөл, папа менімен ойнауға рұқсат етіңіз.
Dialogue: 0,0:03:33.92,0:03:35.04,Default,,0,0,0,,Нөл папа?
Dialogue: 0,0:03:35.54,0:03:36.96,Default,,0,0,0,,Мен әке емеспін
Dialogue: 0,0:03:37.55,0:03:39.09,Default,,0,0,0,,Сонда, ағай?
Dialogue: 0,0:03:40.51,0:03:41.84,Default,,0,0,0,,Нөл жақсы.
Dialogue: 0,0:03:41.93,0:03:44.93,Default,,0,0,0,,Бұл «қарттың» ойыны көп~
Dialogue: 0,0:03:45.01,0:03:46.64,Default,,0,0,0,,Өтінемін, менімен ойнаңыз~
Dialogue: 0,0:03:46.72,0:03:49.18,Default,,0,0,0,,Шынымен бе? «Мори карт» бар ма?
Dialogue: 0,0:03:49.27,0:03:50.06,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:03:52.60,0:03:55.61,Default,,0,0,0,,Уау~ Бұл рас! Көптеген ойындар!
Dialogue: 0,0:03:55.69,0:03:56.40,Default,,0,0,0,,Е...күте тұрыңыз...
Dialogue: 0,0:03:56.48,0:03:58.11,Default,,0,0,0,,Бұл түймелерге толы!
Dialogue: 0,0:03:58.19,0:03:59.15,Default,,0,0,0,,А... тиіспе...
Dialogue: 0,0:03:59.23,0:04:01.40,Default,,0,0,0,,(бағдарламалық құралдың құлау дыбысы)
Dialogue: 0,0:04:01.49,0:04:02.03,Default,,0,0,0,,…Осылайша мен осы сұмдыққа ат қойдым
Dialogue: 0,0:04:02.11,0:04:03.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:03.66,0:04:06.28,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:11.79,0:04:13.83,Default,,0,0,0,,Міне, орындалды!
Dialogue: 0,0:04:13.92,0:04:15.79,Default,,0,0,0,,Қараңдар, мына жерден жеуге болады.
Dialogue: 0,0:04:15.88,0:04:19.21,Default,,0,0,0,,Уау! Дәмді көрінеді!
Dialogue: 0,0:04:19.71,0:04:20.51,Default,,0,0,0,,Кішкене
Dialogue: 0,0:04:20.59,0:04:21.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:21.59,0:04:24.38,Default,,0,0,0,,Тамақ ішер алдында «Итадакимасу» деңіз
Dialogue: 0,0:04:24.47,0:04:26.89,Default,,0,0,0,,Нөл Сіз де! (Нөл) Ах...
Dialogue: 0,0:04:26.97,0:04:28.64,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:04:28.72,0:04:31.02,Default,,0,0,0,,Итадакимашу!
Dialogue: 0,0:04:32.27,0:04:33.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:34.31,0:04:35.52,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:04:36.90,0:04:38.73,Default,,0,0,0,,Ммм.
Dialogue: 0,0:04:39.23,0:04:42.40,Default,,0,0,0,,Қандай қиын бала.
Dialogue: 0,0:04:42.49,0:04:43.95,Default,,0,0,0,,Оны кім алды?
Dialogue: 0,0:04:44.03,0:04:45.66,Default,,0,0,0,,Мен бірдеңе істеймін...
Dialogue: 0,0:04:45.74,0:04:46.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:52.00,0:04:54.41,Default,,0,0,0,,«Бұл бала сенікі».
Dialogue: 0,0:04:54.50,0:04:55.71,Default,,0,0,0,,«Сол кезде сен»
Dialogue: 0,0:04:55.79,0:04:58.50,Default,,0,0,0,,«Сен мені құрсағындағы балаларыңмен бірге тастап кеттің».
Dialogue: 0,0:04:58.58,0:05:00.30,Default,,0,0,0,,«Мен әлі де кек сақтаймын»
Dialogue: 0,0:05:00.80,0:05:03.21,Default,,0,0,0,,«Осы баланы өсіріңізші»
Dialogue: 0,0:05:03.30,0:05:05.34,Default,,0,0,0,,«Егер сіз әйеліңіздің білгенін қаламасаңыз».
Dialogue: 0,0:05:05.43,0:05:09.26,Default,,0,0,0,,«Алдыңғы балаға алимент пен алимент төлеуіңізді сұраймыз».
Dialogue: 0,0:05:09.76,0:05:11.51,Default,,0,0,0,,Бұл оның қожайынның баласы екенін білдіре ме?
Dialogue: 0,0:05:12.02,0:05:14.73,Default,,0,0,0,,Қарғыс атсын, мен талап қоюшыны өлтірдім.
Dialogue: 0,0:05:15.44,0:05:19.06,Default,,0,0,0,,Біздің жұмыс Сол қыз сені бақылап тұрды, солай ма?
Dialogue: 0,0:05:19.56,0:05:21.61,Default,,0,0,0,,Өйткені мен мұны көз алдымда жасадым.
Dialogue: 0,0:05:21.69,0:05:23.15,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:05:23.65,0:05:26.95,Default,,0,0,0,,Мен оны полицияға әкеле алмаймын...
Dialogue: 0,0:05:27.45,0:05:30.70,Default,,0,0,0,,Оны анасына қайтарудан басқа амалымыз жоқ.
Dialogue: 0,0:05:31.20,0:05:32.66,Default,,0,0,0,,Сіз қайда тұрасыз?
Dialogue: 0,0:05:32.74,0:05:35.16,Default,,0,0,0,,Хмм, мен мұны түсінбеймін.
Dialogue: 0,0:05:36.25,0:05:37.33,Default,,0,0,0,,Эй (нөл) иә?
Dialogue: 0,0:05:40.67,0:05:42.17,Default,,0,0,0,,Иә~
Dialogue: 0,0:05:42.88,0:05:45.13,Default,,0,0,0,,Хаа~
Dialogue: 0,0:05:47.97,0:05:50.05,Default,,0,0,0,,Ми-ри-чан, иә?
Dialogue: 0,0:05:50.14,0:05:52.18,Default,,0,0,0,,Уау, бұл жабысқақ.
Dialogue: 0,0:05:52.26,0:05:53.39,Default,,0,0,0,,Міне!
Dialogue: 0,0:05:53.47,0:05:54.81,Default,,0,0,0,,Сіз де өзгермейсіз.
Dialogue: 0,0:05:54.89,0:05:57.19,Default,,0,0,0,,(Миридің күлуі)
Dialogue: 0,0:05:57.27,0:05:59.15,Default,,0,0,0,,Әй, сен қайдансың?
Dialogue: 0,0:05:59.73,0:06:01.11,Default,,0,0,0,,(Мыңдаған дауыс)
Dialogue: 0,0:06:01.19,0:06:03.90,Default,,0,0,0,,Ух... Иә, тамақ ішер алдында жеуге болады.
Dialogue: 0,0:06:03.98,0:06:05.03,Default,,0,0,0,,Алыста!
Dialogue: 0,0:06:05.11,0:06:06.99,Default,,0,0,0,,Сен кіммен келдің?
Dialogue: 0,0:06:07.07,0:06:08.20,Default,,0,0,0,,Жалғыз!
Dialogue: 0,0:06:08.28,0:06:09.24,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:06:09.32,0:06:12.33,Default,,0,0,0,,Мен көп жүрдім, пойызға отырдым.
Dialogue: 0,0:06:12.41,0:06:13.91,Default,,0,0,0,,Ой! Қай станция?
Dialogue: 0,0:06:13.99,0:06:15.58,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:06:15.66,0:06:16.66,Default,,0,0,0,,Бұл қандай пойыз?
Dialogue: 0,0:06:16.75,0:06:18.08,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:06:18.16,0:06:19.17,Default,,0,0,0,,Сіздің үй мекенжайыңыз қандай?
Dialogue: 0,0:06:19.25,0:06:21.00,Default,,0,0,0,,Мен шырын ішкім келеді!
Dialogue: 0,0:06:26.38,0:06:28.34,Default,,0,0,0,,Тек газдалған су
Dialogue: 0,0:06:28.42,0:06:31.34,Default,,0,0,0,,Сол қонақүйге жетуіміз бір керемет болды.
Dialogue: 0,0:06:31.84,0:06:34.43,Default,,0,0,0,,Баладан сұрау қате болды
Dialogue: 0,0:06:34.51,0:06:35.77,Default,,0,0,0,,Толығырақ қарастырайық
Dialogue: 0,0:06:37.31,0:06:39.39,Default,,0,0,0,,Хмм, Қара~и!
Dialogue: 0,0:06:40.27,0:06:42.23,Default,,0,0,0,,Сонымен, сенің атың кім?
Dialogue: 0,0:06:42.86,0:06:45.40,Default,,0,0,0,,Мири Кайзака 4 жаста
Dialogue: 0,0:06:45.48,0:06:48.15,Default,,0,0,0,,Анам ән айтуды жақсы біледі.
Dialogue: 0,0:06:48.65,0:06:51.20,Default,,0,0,0,,Жұмыс істеп жүрсем де ән айтамын.
Dialogue: 0,0:06:51.78,0:06:53.07,Default,,0,0,0,,А, қайда?
Dialogue: 0,0:06:53.16,0:06:55.37,Default,,0,0,0,,Хмм, мен түсінбедім.
Dialogue: 0,0:06:55.99,0:07:00.62,Default,,0,0,0,,♪ Уу~ Уу~ Уу~
Dialogue: 0,0:07:00.71,0:07:04.00,Default,,0,0,0,,Хаа... Менде маңызды ақпарат жоқ.
Dialogue: 0,0:07:04.09,0:07:06.34,Default,,0,0,0,,Мафияның жасырын баласын іздеуге мүмкіндік жоқ.
Dialogue: 0,0:07:06.42,0:07:08.63,Default,,0,0,0,,Ах~ Ах~ (Икки) Хмм... тиіспе.
Dialogue: 0,0:07:09.63,0:07:11.18,Default,,0,0,0,,Мен мұны істегім келмейді
Dialogue: 0,0:07:11.26,0:07:13.22,Default,,0,0,0,,Хиса-чанмен бірге барайын ба?
Dialogue: 0,0:07:13.30,0:07:14.26,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:07:14.35,0:07:16.56,Default,,0,0,0,,Сен мына жігітпен үйде отырсың.
Dialogue: 0,0:07:18.47,0:07:20.89,Default,,0,0,0,,Мен де істеймін! (Икки) Ух...
Dialogue: 0,0:07:21.52,0:07:22.52,Default,,0,0,0,,Уау! (Икки) Ах!
Dialogue: 0,0:07:22.60,0:07:24.61,Default,,0,0,0,,Бұл... Жақсысың ба? Ыстық емес пе?
Dialogue: 0,0:07:24.69,0:07:27.36,Default,,0,0,0,,Эххехехе кешіріңіз.
Dialogue: 0,0:07:31.15,0:07:32.11,Default,,0,0,0,,Букка!
Dialogue: 0,0:07:32.70,0:07:35.53,Default,,0,0,0,,Иә, әзірше оны киіңіз.
Dialogue: 0,0:07:35.62,0:07:36.95,Default,,0,0,0,,Ендеше мынаған да назар аударыңыз.
Dialogue: 0,0:07:37.03,0:07:39.58,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:07:39.66,0:07:42.87,Default,,0,0,0,,«Веджит биі» басталғалы жатыр!
Dialogue: 0,0:07:42.96,0:07:43.96,Default,,0,0,0,,Йойо... Эй Эй...
Dialogue: 0,0:07:44.04,0:07:46.50,Default,,0,0,0,,Милли Маған бұл ұнайды!
Dialogue: 0,0:07:46.59,0:07:48.17,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:07:48.25,0:07:50.67,Default,,0,0,0,,Тыңда, тыныш бол.
Dialogue: 0,0:07:50.76,0:07:51.88,Default,,0,0,0,,Эххехе…
Dialogue: 0,0:07:56.47,0:07:57.51,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:07:58.39,0:07:59.72,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:07:59.81,0:08:02.64,Default,,0,0,0,,Иә? Зероның сыртқа шығуы сирек.
Dialogue: 0,0:08:02.73,0:08:05.27,Default,,0,0,0,,Мен үйде ойын ойнай алмаймын.
Dialogue: 0,0:08:06.27,0:08:07.11,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:07.19,0:08:08.61,Default,,0,0,0,,Әйелдердің менімен әзілдескеніне шыдамаймын, білесің бе
Dialogue: 0,0:08:10.65,0:08:11.86,Default,,0,0,0,,Сіз мұны керемет орындадыңыз.
Dialogue: 0,0:08:11.94,0:08:14.20,Default,,0,0,0,,Ал... жақсы...
Dialogue: 0,0:08:14.28,0:08:16.91,Default,,0,0,0,,Бұл Рождестволық ойын-сауық үшін тамаша емес пе?
Dialogue: 0,0:08:16.99,0:08:18.70,Default,,0,0,0,,Мен сені мақтамаймын (Икки) А...
Dialogue: 0,0:08:18.78,0:08:21.58,Default,,0,0,0,,Бұған да шектеулер бар.
Dialogue: 0,0:08:22.29,0:08:25.08,Default,,0,0,0,,Сіздің орнын басатын адамдар көп.
Dialogue: 0,0:08:25.79,0:08:27.42,Default,,0,0,0,,Кешіріңіз Хиса Чан...
Dialogue: 0,0:08:28.88,0:08:30.55,Default,,0,0,0,,Қалған өтемақы
Dialogue: 0,0:08:30.63,0:08:34.55,Default,,0,0,0,,Сондай-ақ менің шұғыл жұмысым бар, сізден бірдеңе сұрасам бола ма?
Dialogue: 0,0:08:34.63,0:08:35.97,Default,,0,0,0,,Материалдар қол жетімді
Dialogue: 0,0:08:36.76,0:08:38.30,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:38.89,0:08:39.89,Default,,0,0,0,,Бұл пайдалы.
Dialogue: 0,0:08:41.60,0:08:42.64,Default,,0,0,0,,Аванстық төлем
Dialogue: 0,0:08:44.77,0:08:46.94,Default,,0,0,0,,Қалғаны әдеттегідей
Dialogue: 0,0:08:47.02,0:08:48.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:49.73,0:08:50.94,Default,,0,0,0,,Айтпақшы, Хиса-чан
Dialogue: 0,0:08:51.53,0:08:52.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:52.53,0:08:54.11,Default,,0,0,0,,Кешегі мақсат...
Dialogue: 0,0:08:55.11,0:08:57.16,Default,,0,0,0,,Сіздің балаларыңыз болды ма?
Dialogue: 0,0:08:57.24,0:09:00.41,Default,,0,0,0,,Жоқ, бұл құжаттарда жоқ деп ойлаймын...
Dialogue: 0,0:09:00.49,0:09:01.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:01.29,0:09:04.79,Default,,0,0,0,,Жоқ, ол... ол жүзі оған жараспайды.
Dialogue: 0,0:09:04.87,0:09:08.08,Default,,0,0,0,,Сен сүйкімді қуыршақ әкелдің, солай ма?
Dialogue: 0,0:09:08.17,0:09:09.92,Default,,0,0,0,,Бұл Рождество болды, солай емес пе?
Dialogue: 0,0:09:10.42,0:09:13.05,Default,,0,0,0,,Материалдарда қате жоқ, солай ма?
Dialogue: 0,0:09:13.13,0:09:15.93,Default,,0,0,0,,А... жаман дәм қалдырады, солай емес пе?
Dialogue: 0,0:09:19.10,0:09:22.93,Default,,0,0,0,,Зерттеу қатесі болуы мүмкін. Оны қарастырайық.
Dialogue: 0,0:09:23.43,0:09:25.56,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:09:31.82,0:09:32.65,Default,,0,0,0,,Сен осы уақыт бойы мұнда болдың ба? Кофе жарай ма?
Dialogue: 0,0:09:32.73,0:09:33.94,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:09:34.61,0:09:37.66,Default,,0,0,0,,Жарайды, Хиса-чан байқамайды.
Dialogue: 0,0:09:37.74,0:09:39.28,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:09:39.78,0:09:42.24,Default,,0,0,0,,Қош келдіңіз...
Dialogue: 0,0:09:42.33,0:09:43.58,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:09:47.21,0:09:50.71,Default,,0,0,0,,Біраз уақыт өтті. Қайтып келдіңіз бе?
Dialogue: 0,0:09:51.34,0:09:52.09,Default,,0,0,0,,О
Dialogue: 0,0:09:52.67,0:09:55.26,Default,,0,0,0,,Мен бұл қалада біраз уақыт қиындыққа тап боламын.
Dialogue: 0,0:09:56.26,0:09:58.63,Default,,0,0,0,,Жұмыс қолжетімді болған кезде маған хабарлаңыз.
Dialogue: 0,0:10:02.26,0:10:03.10,Default,,0,0,0,,Незуко! Мен төмен түсемін
Dialogue: 0,0:10:05.35,0:10:06.73,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:10:12.65,0:10:13.98,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:10:14.07,0:10:16.15,Default,,0,0,0,,Эй, мен қайтып келдім...
Dialogue: 0,0:10:16.24,0:10:17.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:17.99,0:10:19.53,Default,,0,0,0,,Иә? Эй!
Dialogue: 0,0:10:34.05,0:10:35.25,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:35.34,0:10:37.59,Default,,0,0,0,,Шынайы ма? Эй... Мири!
Dialogue: 0,0:10:37.67,0:10:38.55,Default,,0,0,0,,(шу)
Dialogue: 0,0:10:39.13,0:10:40.05,Default,,0,0,0,,Не!
Dialogue: 0,0:10:42.64,0:10:43.18,Default,,0,0,0,,Милли!
Dialogue: 0,0:10:43.26,0:10:46.35,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:10:48.35,0:10:49.89,Default,,0,0,0,,Жасырынбақ...
Dialogue: 0,0:10:49.98,0:10:50.90,Default,,0,0,0,,Толық көрінеді
Dialogue: 0,0:10:50.98,0:10:53.23,Default,,0,0,0,,Эххехе... Сағындым~
Dialogue: 0,0:10:53.81,0:10:56.28,Default,,0,0,0,,Сонда Мири келесі жын болады.
Dialogue: 0,0:10:56.36,0:10:56.90,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:10:56.98,0:10:58.94,Default,,0,0,0,,Сәлем! Бұл шынайы!
Dialogue: 0,0:10:59.03,0:11:00.15,Default,,0,0,0,,Онда оқ жоқ.
Dialogue: 0,0:11:00.24,0:11:01.49,Default,,0,0,0,,Кяхаха...
Dialogue: 0,0:11:01.57,0:11:02.95,Default,,0,0,0,,Жоқ... күте тұрыңыз!
Dialogue: 0,0:11:03.03,0:11:05.12,Default,,0,0,0,,Жоқ, енді әкенің кезегі!
Dialogue: 0,0:11:05.20,0:11:07.45,Default,,0,0,0,,Қарғыс атсын... зұлым бәйбіше!
Dialogue: 0,0:11:07.54,0:11:09.66,Default,,0,0,0,,Кяхахаха... (Икки) Эй!
Dialogue: 0,0:11:09.75,0:11:11.37,Default,,0,0,0,,Үйде отыру жоқ...
Dialogue: 0,0:11:11.46,0:11:12.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:16.21,0:11:17.00,Default,,0,0,0,,Аму
Dialogue: 0,0:11:17.96,0:11:19.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:22.30,0:11:25.89,Default,,0,0,0,,Нысана - бухтадағы сарайда тұратын есірткі ұйымының бастығы.
Dialogue: 0,0:11:26.76,0:11:28.68,Default,,0,0,0,,Шетелдік мафиямен бірігу
Dialogue: 0,0:11:28.77,0:11:31.23,Default,,0,0,0,,Басқа топтармен үнемі қақтығыс болып тұратын сияқты.
Dialogue: 0,0:11:31.73,0:11:34.81,Default,,0,0,0,,Бастық әбден қорқақ деген қауесет бар.
Dialogue: 0,0:11:34.90,0:11:37.65,Default,,0,0,0,,Сарайдың қауіпсіздігі өте қатаң сияқты.
Dialogue: 0,0:11:38.40,0:11:40.11,Default,,0,0,0,,Сақшылар саны да көп.
Dialogue: 0,0:11:40.19,0:11:43.66,Default,,0,0,0,,Ешқандай ақыл-оймен ішке кіру мүмкін емес.
Dialogue: 0,0:11:44.32,0:11:47.91,Default,,0,0,0,,Үйді қоршап тұрған айлақ болғандықтан, тіпті алыстан ату кезінде де,
Dialogue: 0,0:11:47.99,0:11:50.91,Default,,0,0,0,,Сарайға қарау мүмкін емес.
Dialogue: 0,0:11:51.41,0:11:52.67,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:11:52.75,0:11:54.88,Default,,0,0,0,,Барлығын фронтальды серпіліс арқылы өлтіріңіз
Dialogue: 0,0:11:54.96,0:11:55.92,Default,,0,0,0,,Мен мұны істей аламын ба деп ойлаймын!
Dialogue: 0,0:11:56.50,0:11:58.71,Default,,0,0,0,,Жалпы айтқанда, мен жай ғана айттым: «Бұл өте көзге түседі».
Dialogue: 0,0:11:58.80,0:12:01.38,Default,,0,0,0,,Хиса-чан жаңа ғана тырнағыма пышақ сұғып алды!
Dialogue: 0,0:12:01.47,0:12:04.05,Default,,0,0,0,,Жаңалықтарға қайта түсуге шамам жетпейді.
Dialogue: 0,0:12:04.14,0:12:05.76,Default,,0,0,0,,Әй, папа (Икки) иә?
Dialogue: 0,0:12:05.85,0:12:07.68,Default,,0,0,0,,Бұл басқаша
Dialogue: 0,0:12:07.76,0:12:08.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:08.64,0:12:10.60,Default,,0,0,0,,Анамның гамбургерінен айырмашылығы
Dialogue: 0,0:12:11.10,0:12:14.52,Default,,0,0,0,,Түсіндің бе, Мири!
Dialogue: 0,0:12:14.60,0:12:16.73,Default,,0,0,0,,Иә! А5 дәрежелі тартылған ет
Dialogue: 0,0:12:16.81,0:12:18.90,Default,,0,0,0,,Етті шырынды ету үшін мускат жаңғағын пайдаланыңыз!
Dialogue: 0,0:12:18.98,0:12:21.24,Default,,0,0,0,,Менің қолдан жасалған гамбургерім...
Dialogue: 0,0:12:21.32,0:12:23.15,Default,,0,0,0,,Анамның дәмі жақсырақ
Dialogue: 0,0:12:25.07,0:12:25.99,Default,,0,0,0,,Менің тамырларым жарылып кетеді?
Dialogue: 0,0:12:27.12,0:12:31.20,Default,,0,0,0,,Хмм, анашым, қазір не істеп жатырсыз.
Dialogue: 0,0:12:31.29,0:12:32.96,Default,,0,0,0,,Не? Не, кенеттен?
Dialogue: 0,0:12:33.04,0:12:35.62,Default,,0,0,0,,Сіз өзіңізді жалғыз сезінесіз бе?
Dialogue: 0,0:12:35.71,0:12:37.96,Default,,0,0,0,,О... Эй... Мири?
Dialogue: 0,0:12:40.96,0:12:41.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:42.05,0:12:42.63,Default,,0,0,0,,Өте беделді адамды әкеліпсің ғой, иә?
Dialogue: 0,0:12:42.72,0:12:44.76,Default,,0,0,0,,Кяхахаха... (Икки) Эй!
Dialogue: 0,0:12:44.84,0:12:46.72,Default,,0,0,0,,Бұл жасырынбақ!
Dialogue: 0,0:12:46.80,0:12:48.60,Default,,0,0,0,,Ол әлі тамақтанып жатыр!
Dialogue: 0,0:12:50.85,0:12:51.93,Default,,0,0,0,,Гааах!
Dialogue: 0,0:12:54.52,0:12:55.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:55.48,0:12:56.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:58.65,0:12:59.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:04.11,0:13:06.28,Default,,0,0,0,,…Әр дүкен соғысқа дайындалады.
Dialogue: 0,0:13:06.36,0:13:08.20,Default,,0,0,0,,Түрлі іс-шаралар өткіземіз
Dialogue: 0,0:13:08.28,0:13:09.53,Default,,0,0,0,,Ихихихи... (Икки) Ах!
Dialogue: 0,0:13:09.62,0:13:11.33,Default,,0,0,0,,Шық!
Dialogue: 0,0:13:11.41,0:13:12.33,Default,,0,0,0,,Ояншы, ояншы, енді оян
Dialogue: 0,0:13:12.41,0:13:13.87,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:13:13.95,0:13:15.08,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:13:15.16,0:13:16.25,Default,,0,0,0,,Милли!
Dialogue: 0,0:13:16.33,0:13:17.79,Default,,0,0,0,,Кя~ Хахаха! (Икки) Қарғыс атқыр...
Dialogue: 0,0:13:18.38,0:13:19.88,Default,,0,0,0,,Жасырынбақ жақсы.
Dialogue: 0,0:13:19.96,0:13:21.55,Default,,0,0,0,,Бұл жасырынбақ емес!
Dialogue: 0,0:13:21.63,0:13:25.01,Default,,0,0,0,,Мені жай ғана жылдам бұрыс итермелеп жатыр...
Dialogue: 0,0:13:25.09,0:13:25.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:26.55,0:13:29.68,Default,,0,0,0,,Түсіндім, мұны істеудің жолы бар...
Dialogue: 0,0:13:31.76,0:13:33.77,Default,,0,0,0,,Дабыл құрылғысы...
Dialogue: 0,0:13:33.85,0:13:35.94,Default,,0,0,0,,Жасырынбақ аяқталды ма?
Dialogue: 0,0:13:36.02,0:13:37.44,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:13:37.52,0:13:39.90,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:40.44,0:13:41.86,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:13:49.03,0:13:53.20,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:14:20.56,0:14:21.86,Default,,0,0,0,,Хааа~
Dialogue: 0,0:14:22.52,0:14:23.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:23.15,0:14:25.32,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:14:25.40,0:14:26.15,Default,,0,0,0,,Иә
Dialogue: 0,0:14:26.24,0:14:27.44,Default,,0,0,0,,Мири де барады!
Dialogue: 0,0:14:27.53,0:14:29.66,Default,,0,0,0,,Әкеммен бірге шығу!
Dialogue: 0,0:14:29.74,0:14:31.66,Default,,0,0,0,,Не істеу керек? Бұл
Dialogue: 0,0:14:31.74,0:14:33.41,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:14:33.49,0:14:35.20,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:14:35.29,0:14:37.37,Default,,0,0,0,,Енді сіз қалағаныңызша жей аласыз.
Dialogue: 0,0:14:37.45,0:14:39.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:39.25,0:14:42.59,Default,,0,0,0,,Егер сізде осы ғана болса, келесі жолы үнсіз қаласыз.
Dialogue: 0,0:14:42.67,0:14:45.84,Default,,0,0,0,,Жеммен балық аулау, үй жануарына қамқорлық жасау сияқты.
Dialogue: 0,0:14:48.47,0:14:50.47,Default,,0,0,0,,Эххехе…
Dialogue: 0,0:14:50.55,0:14:52.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:52.34,0:14:53.85,Default,,0,0,0,,Папа! (Икки) О, жоқ!
Dialogue: 0,0:14:53.93,0:14:54.85,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:54.93,0:14:58.02,Default,,0,0,0,,Әке, барма!
Dialogue: 0,0:14:58.10,0:14:59.94,Default,,0,0,0,,Эй... тыныш бол!
Dialogue: 0,0:15:00.02,0:15:01.60,Default,,0,0,0,,«Маған қалдыр» деген не?
Dialogue: 0,0:15:01.69,0:15:03.27,Default,,0,0,0,,Мені артта қалдырма (Икки)...
Dialogue: 0,0:15:03.36,0:15:04.86,Default,,0,0,0,,Сізге хабарланады.
Dialogue: 0,0:15:04.94,0:15:06.19,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:15:06.28,0:15:07.74,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:15:07.82,0:15:09.86,Default,,0,0,0,,А, жоқ, бәрі жақсы.
Dialogue: 0,0:15:10.45,0:15:12.62,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:15:12.70,0:15:16.62,Default,,0,0,0,,Мири менімен бірге барады~ Ух...
Dialogue: 0,0:15:16.70,0:15:18.37,Default,,0,0,0,,Менде жағымсыз сезім бар
Dialogue: 0,0:15:19.20,0:15:20.92,Default,,0,0,0,,Менің жоспарым...
Dialogue: 0,0:15:22.42,0:15:27.63,Default,,0,0,0,,Ай!
Dialogue: 0,0:15:28.71,0:15:30.13,Default,,0,0,0,,Бухтаның ішінде
Dialogue: 0,0:15:30.22,0:15:33.18,Default,,0,0,0,,Барлық жерде бақылау камералары бар.
Dialogue: 0,0:15:33.26,0:15:36.51,Default,,0,0,0,,Сыртқа шыққанда нысана қорғансыз болады.
Dialogue: 0,0:15:36.60,0:15:39.77,Default,,0,0,0,,Егер сіз кіреберіс жағынан эвакуация жолын жауып тастасаңыз
Dialogue: 0,0:15:39.85,0:15:42.56,Default,,0,0,0,,Құтылудың жалғыз жолы - бухта қайықпен.
Dialogue: 0,0:15:42.65,0:15:44.77,Default,,0,0,0,,Сол жерде пайда болған бастық бухтаның сыртында еді.
Dialogue: 0,0:15:44.86,0:15:47.27,Default,,0,0,0,,Күтіңіз және тоқтаңыз
Dialogue: 0,0:15:47.36,0:15:50.36,Default,,0,0,0,,Бұл үлкен мәміле болмайтынын білдіреді.
Dialogue: 0,0:15:53.36,0:15:54.45,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:56.37,0:15:57.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:58.16,0:15:59.04,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:16:01.00,0:16:03.58,Default,,0,0,0,,Милли! Өтінемін тыныш жүріңізші...
Dialogue: 0,0:16:03.67,0:16:04.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:05.54,0:16:06.42,Default,,0,0,0,,Не?
Dialogue: 0,0:16:06.50,0:16:07.92,Default,,0,0,0,,Ағай!
Dialogue: 0,0:16:08.00,0:16:09.67,Default,,0,0,0,,Сол бала менің одақтасым болады дегің келе ме?
Dialogue: 0,0:16:09.76,0:16:11.55,Default,,0,0,0,,Уф... шыдамды бол!
Dialogue: 0,0:16:11.63,0:16:12.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:12.63,0:16:15.72,Default,,0,0,0,,Мен дереу қайтып келемін, сондықтан тыныш болыңыз!
Dialogue: 0,0:16:15.80,0:16:18.06,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:16:18.14,0:16:20.31,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:16:22.64,0:16:24.52,Default,,0,0,0,,Күзет құралдарын тексеру
Dialogue: 0,0:16:24.60,0:16:27.65,Default,,0,0,0,,Өткен күнгі жалған дабыл жүйедегі қате сияқты.
Dialogue: 0,0:16:30.23,0:16:31.32,Default,,0,0,0,,Жаңа бет?
Dialogue: 0,0:16:31.40,0:16:33.90,Default,,0,0,0,,Хаха, сен мені үнемі осылай баурап аласың ба?
Dialogue: 0,0:16:33.99,0:16:34.86,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:34.95,0:16:36.87,Default,,0,0,0,,Кешіріңіз, мен жай қалжыңдадым.
Dialogue: 0,0:16:43.21,0:16:46.88,Default,,0,0,0,,Құжатқа сәйкес қауіпсіздік қатаң...
Dialogue: 0,0:16:46.96,0:16:48.88,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:16:48.96,0:16:49.84,Default,,0,0,0,,Иә
Dialogue: 0,0:16:53.72,0:16:56.64,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:16:59.18,0:17:01.93,Default,,0,0,0,,Мм... бұл үшін кешіріңіз...
Dialogue: 0,0:17:02.02,0:17:03.81,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:17:03.89,0:17:06.52,Default,,0,0,0,,Осы тексеру кодын тексеріңіз
Dialogue: 0,0:17:06.60,0:17:07.52,Default,,0,0,0,,Аһ!
Dialogue: 0,0:17:07.60,0:17:08.65,Default,,0,0,0,,Ga!
Dialogue: 0,0:17:09.61,0:17:10.77,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:11.98,0:17:15.15,Default,,0,0,0,,Жарқыраған ештеңе жасамасаңыз да, керемет жұмыс жасай аласыз.
Dialogue: 0,0:17:15.24,0:17:16.91,Default,,0,0,0,,Маған көрсетейін
Dialogue: 0,0:17:18.24,0:17:21.16,Default,,0,0,0,,Осылайша жау сарай ішінен шабуыл жасайды.
Dialogue: 0,0:17:21.24,0:17:23.91,Default,,0,0,0,,Бетперде болсаң, қорқақ бастық
Dialogue: 0,0:17:24.00,0:17:27.00,Default,,0,0,0,,Бірден жағаға қарай жүгірген дұрыс.
Dialogue: 0,0:17:32.80,0:17:34.09,Default,,0,0,0,,Польнарефф, бірдеңе болды ма?
Dialogue: 0,0:17:34.17,0:17:36.97,Default,,0,0,0,,Дәретхана~ (Минион) О! сен қандайсың...
Dialogue: 0,0:17:37.05,0:17:39.60,Default,,0,0,0,,Маған дәретханаға бару керек!
Dialogue: 0,0:17:41.06,0:17:43.22,Default,,0,0,0,,Пи... Дайын
Dialogue: 0,0:17:44.48,0:17:46.52,Default,,0,0,0,,Ал... Уф!
Dialogue: 0,0:17:46.60,0:17:47.81,Default,,0,0,0,,Я~
Dialogue: 0,0:17:48.44,0:17:50.86,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:17:50.94,0:17:52.86,Default,,0,0,0,,О, уақытында жасағаныңызға қуаныштымын.
Dialogue: 0,0:17:52.94,0:17:55.40,Default,,0,0,0,,Неге ол жігіт?
Dialogue: 0,0:17:55.49,0:17:56.11,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:57.82,0:17:58.74,Default,,0,0,0,,Микке әке!
Dialogue: 0,0:17:58.82,0:17:59.91,Default,,0,0,0,,Иә? (Икки) Ех!
Dialogue: 0,0:17:59.99,0:18:02.16,Default,,0,0,0,,Не істеп жатырсың! Күзетші ше?
Dialogue: 0,0:18:02.24,0:18:03.70,Default,,0,0,0,,Ой... ой... ой...
Dialogue: 0,0:18:03.79,0:18:06.96,Default,,0,0,0,,Әке, сіз не істеп жатырсыз? жасырынбақ?
Dialogue: 0,0:18:07.04,0:18:09.83,Default,,0,0,0,,Жоқ, сен не айтып тұрсың, бала?
Dialogue: 0,0:18:10.42,0:18:11.79,Default,,0,0,0,,Сол жерде қалмаңыз.
Dialogue: 0,0:18:12.88,0:18:14.05,Default,,0,0,0,,TDL! Мен TDL-ге барғым келеді!
Dialogue: 0,0:18:14.13,0:18:16.22,Default,,0,0,0,,Папа бұл жолы жын~ (Икки) Бұл өтірік!
Dialogue: 0,0:18:16.30,0:18:17.22,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:18:17.30,0:18:18.72,Default,,0,0,0,,Кяхаха...
Dialogue: 0,0:18:24.64,0:18:26.31,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:18:27.10,0:18:28.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:31.36,0:18:32.31,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:36.57,0:18:37.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:38.61,0:18:39.53,Default,,0,0,0,,Не?
Dialogue: 0,0:18:40.82,0:18:42.41,Default,,0,0,0,,Тоқта, Мири!
Dialogue: 0,0:18:42.49,0:18:43.99,Default,,0,0,0,,Шулы!
Dialogue: 0,0:18:46.87,0:18:48.46,Default,,0,0,0,,Ылғалды!
Dialogue: 0,0:18:48.54,0:18:49.33,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:49.41,0:18:51.08,Default,,0,0,0,,Ахахаха~
Dialogue: 0,0:18:51.96,0:18:54.34,Default,,0,0,0,,Тәтті, артқы есікке бар!
Dialogue: 0,0:18:55.42,0:18:57.34,Default,,0,0,0,,Ендеше менің қалпына келу қабілетім…
Dialogue: 0,0:18:57.42,0:18:58.30,Default,,0,0,0,,Кя~
Dialogue: 0,0:18:58.38,0:18:59.55,Default,,0,0,0,,Күте тұрыңыз, Мири! О!
Dialogue: 0,0:19:00.34,0:19:02.26,Default,,0,0,0,,Әй... бұл не деген!
Dialogue: 0,0:19:02.34,0:19:03.51,Default,,0,0,0,,Жасырынбақ!
Dialogue: 0,0:19:03.60,0:19:05.39,Default,,0,0,0,,Жоқ, бұл тег ойыны!
Dialogue: 0,0:19:05.47,0:19:07.60,Default,,0,0,0,,Эй... Түсіндім!
Dialogue: 0,0:19:07.68,0:19:09.14,Default,,0,0,0,,Ояншы, ояншы, енді оян
Dialogue: 0,0:19:15.36,0:19:18.15,Default,,0,0,0,,Хаха... Мен ұсталдым.
Dialogue: 0,0:19:18.24,0:19:19.65,Default,,0,0,0,,Иә... орында!
Dialogue: 0,0:19:22.45,0:19:22.99,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:23.07,0:19:24.62,Default,,0,0,0,,Гах! (Миньон) Уф!
Dialogue: 0,0:19:25.16,0:19:26.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:34.96,0:19:36.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:36.84,0:19:38.84,Default,,0,0,0,,Сәлем! (Икки) Эй, эй...
Dialogue: 0,0:19:43.43,0:19:44.85,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:46.35,0:19:47.85,Default,,0,0,0,,Гах! (Миньон) Уау!
Dialogue: 0,0:19:49.73,0:19:51.81,Default,,0,0,0,,Мен мұны басынан бастап істеуім керек еді.
Dialogue: 0,0:19:52.44,0:19:54.19,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:19:57.52,0:19:59.19,Default,,0,0,0,,Шулы!
Dialogue: 0,0:19:59.28,0:20:01.61,Default,,0,0,0,,Ақымақ! Біз әлі бармыз
Dialogue: 0,0:20:04.66,0:20:05.28,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:05.37,0:20:08.08,Default,,0,0,0,,Кяхахаха мен ұшақ көрдім!
Dialogue: 0,0:20:08.16,0:20:09.37,Default,,0,0,0,,Операция сәтсіз аяқталды.
Dialogue: 0,0:20:09.45,0:20:11.54,Default,,0,0,0,,Қаш!
Dialogue: 0,0:20:11.62,0:20:12.25,Default,,0,0,0,,Хмф!
Dialogue: 0,0:20:12.33,0:20:14.25,Default,,0,0,0,,Буу~ун (Икки) Ку~!
Dialogue: 0,0:20:14.33,0:20:18.71,Default,,0,0,0,,Кяхахаха... (Икки) Ахх!
Dialogue: 0,0:20:20.88,0:20:22.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:24.09,0:20:27.10,Default,,0,0,0,,Таку! Сіз тағы да бірдеңе жасадыңыз
Dialogue: 0,0:20:27.18,0:20:28.76,Default,,0,0,0,,Мен бүгін ешкімді өлтірген жоқпын.
Dialogue: 0,0:20:28.85,0:20:30.77,Default,,0,0,0,,Олай етпесең жақсы емес.
Dialogue: 0,0:20:30.85,0:20:32.27,Default,,0,0,0,,Және Милли! иә?
Dialogue: 0,0:20:32.35,0:20:34.85,Default,,0,0,0,,Жоспар сенің кесіріңнен бұзылды!
Dialogue: 0,0:20:35.35,0:20:36.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:36.98,0:20:39.02,Default,,0,0,0,,Өлсең не істейсің?
Dialogue: 0,0:20:39.11,0:20:40.65,Default,,0,0,0,,Мені алаңдатпа!
Dialogue: 0,0:20:40.73,0:20:41.99,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:20:42.99,0:20:45.07,Default,,0,0,0,,Түсіндім, әке!
Dialogue: 0,0:20:45.74,0:20:46.95,Default,,0,0,0,,О, және!
Dialogue: 0,0:20:47.03,0:20:49.66,Default,,0,0,0,,Енді сыртта мені әке деме.
Dialogue: 0,0:20:49.74,0:20:50.41,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:20:50.49,0:20:52.00,Default,,0,0,0,,Иә, әке!
Dialogue: 0,0:20:52.08,0:20:54.71,Default,,0,0,0,,Иә, сіз түсінбейсіз!
Dialogue: 0,0:20:56.50,0:20:59.67,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:20:59.75,0:21:00.92,Default,,0,0,0,,Сіз қате жібердіңіз.
Dialogue: 0,0:21:01.00,0:21:02.30,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:21:02.38,0:21:06.43,Default,,0,0,0,,Жынды ғой... Мына жігіт қасында болса мен жұмыс істей алмаймын.
Dialogue: 0,0:21:06.51,0:21:08.35,Default,,0,0,0,,Бізге тез арада бірдеңе істеу керек...
Dialogue: 0,0:21:08.43,0:21:10.64,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:21:12.47,0:21:13.27,Default,,0,0,0,,Yabe...
Dialogue: 0,0:21:15.10,0:21:16.23,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:21:16.31,0:21:17.52,Default,,0,0,0,,А... Мм, бұл жолы...
Dialogue: 0,0:21:17.60,0:21:20.52,Default,,0,0,0,,Мен енді бұл іске араласудың қажеті жоқ.
Dialogue: 0,0:21:21.15,0:21:22.90,Default,,0,0,0,,Мен мәселені осында шешемін.
Dialogue: 0,0:21:23.78,0:21:24.78,Default,,0,0,0,,Иә...
Dialogue: 0,0:21:25.36,0:21:26.99,Default,,0,0,0,,Ал зерттеу туралы...
Dialogue: 0,0:21:28.12,0:21:30.66,Default,,0,0,0,,Қожаның баласы бар сияқты.
Dialogue: 0,0:21:31.16,0:21:32.29,Default,,0,0,0,,Бұл қыз
Dialogue: 0,0:21:32.87,0:21:34.75,Default,,0,0,0,,Мәліметтер кейінірек жіберіледі
Dialogue: 0,0:21:35.71,0:21:38.17,Default,,0,0,0,,Ах, рахмет Хиса-чан
Dialogue: 0,0:21:38.25,0:21:40.25,Default,,0,0,0,,♪～
Dialogue: 0,0:21:40.34,0:21:42.59,Default,,0,0,0,,Мен анамның қайда екенін білдім.
Dialogue: 0,0:21:42.67,0:21:43.67,Default,,0,0,0,,Иә
Dialogue: 0,0:21:43.76,0:21:46.88,Default,,0,0,0,,Енді сіз өз қиындықтарыңызды өтей аласыз.
Dialogue: 0,0:23:17.06,0:23:19.06,Default,,0,0,0,,～♪
Dialogue: 0,0:23:21.02,0:23:22.73,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:23:28.49,0:23:29.99,Default,,0,0,0,,Хи хи хи!
Dialogue: 0,0:23:30.07,0:23:31.41,Default,,0,0,0,,Кішкене… тоқтатыңыз.
Dialogue: 0,0:23:31.49,0:23:33.03,Default,,0,0,0,,Тәт... Ташукете...
Dialogue: 0,0:23:33.99,0:23:35.49,Default,,0,0,0,,Маған тыңдауға рұқсат етіңіз.
Dialogue: 0,0:23:35.99,0:23:38.79,Default,,0,0,0,,Өміріңіздің соңғы сөзі
Dialogue: 0,0:23:38.87,0:23:40.87,Default,,0,0,0,,Кез келген ақша сомасы
Dialogue: 0,0:23:40.96,0:23:42.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:42.29,0:23:43.54,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:23:47.25,0:23:48.84,Default,,0,0,0,,Орташа
Dialogue: 0,0:23:48.92,0:23:52.34,Default,,0,0,0,,Сөздерің менің жинағыма арналған
Dialogue: 0,0:23:52.43,0:23:55.18,Default,,0,0,0,,мәні жоқ
Dialogue: 0,0:23:56.68,0:24:02.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory