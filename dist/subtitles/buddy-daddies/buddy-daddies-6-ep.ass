Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.75,0:00:05.75,Default,,0,0,0,,Сіздің ұлыңыз жарақат алды ма?
Dialogue: 0,0:00:05.83,0:00:07.17,Default,,0,0,0,,Бұл үшінші рет.
Dialogue: 0,0:00:07.25,0:00:08.42,Default,,0,0,0,,Сіздің ата-ана ретінде қандай міндеттеріңіз бар?
Dialogue: 0,0:00:08.50,0:00:10.21,Default,,0,0,0,,Сіз оны алуды жоспарлап отырсыз ба?
Dialogue: 0,0:00:10.30,0:00:11.67,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:00:12.26,0:00:13.68,Default,,0,0,0,,Балаңызға жақсы көңіл бөліңіз
Dialogue: 0,0:00:13.76,0:00:15.14,Default,,0,0,0,,Сіз оны көрмеген шығарсыз.
Dialogue: 0,0:00:15.22,0:00:17.26,Default,,0,0,0,,Ата-аналар бұл күндері болды
Dialogue: 0,0:00:17.35,0:00:19.43,Default,,0,0,0,,Мен сені тым қатты бүлдіріп жатырмын.
Dialogue: 0,0:00:19.51,0:00:22.39,Default,,0,0,0,,Бірдеңе айту керек болса, айту керек!
Dialogue: 0,0:00:22.48,0:00:25.10,Default,,0,0,0,,Бала тәрбиесі осындай ма?
Dialogue: 0,0:00:25.65,0:00:28.52,Default,,0,0,0,,Мүмкін біз тым тәтті болып жатқан шығармыз.
Dialogue: 0,0:00:29.11,0:00:32.32,Default,,0,0,0,,Ха! Мүмкін ол жігіт те...
Dialogue: 0,0:00:37.07,0:00:39.91,Default,,0,0,0,,Неліктен дүкенді ұрладың? Милли~
Dialogue: 0,0:00:39.99,0:00:42.20,Default,,0,0,0,,Жаманның әйелі өсіргендіктен болар.
Dialogue: 0,0:00:42.29,0:00:43.37,Default,,0,0,0,,Қарт ақсақал!
Dialogue: 0,0:00:43.46,0:00:45.29,Default,,0,0,0,,Қарт адам емес
Dialogue: 0,0:00:46.00,0:00:48.33,Default,,0,0,0,,Тек миллиметрде мен сенбеймін...
Dialogue: 0,0:00:48.88,0:00:50.38,Default,,0,0,0,,Жоқ, бірақ анамның достары да
Dialogue: 0,0:00:50.46,0:00:53.38,Default,,0,0,0,,«Тек балам үшін» дегенді жиі айтамын.
Dialogue: 0,0:00:53.47,0:00:54.88,Default,,0,0,0,,Анам достар?
Dialogue: 0,0:00:54.97,0:00:58.22,Default,,0,0,0,,Эй, Мири Янкиге айналса, сен не істер едің?
Dialogue: 0,0:00:58.30,0:00:59.51,Default,,0,0,0,,Сіз мұны айта аласыз ба?
Dialogue: 0,0:00:59.60,0:01:02.18,Default,,0,0,0,,Керісінше, мен айта аламын, өйткені бұл мен.
Dialogue: 0,0:01:02.27,0:01:04.35,Default,,0,0,0,,Қараңдаршы, мені әке-шешем тастап кетті.
Dialogue: 0,0:01:04.43,0:01:05.89,Default,,0,0,0,,Осылай болатын еді.
Dialogue: 0,0:01:05.98,0:01:07.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:07.23,0:01:10.32,Default,,0,0,0,,Өйткені, ата-ананың рөлі зор.
Dialogue: 0,0:01:10.86,0:01:11.57,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:01:11.65,0:01:14.90,Default,,0,0,0,,Мириді тәрбиелеп отырған адам ретінде мен бар күшімді салуым керек!
Dialogue: 0,0:01:14.99,0:01:16.95,Default,,0,0,0,,Енді жаңалықтардан
Dialogue: 0,0:01:17.03,0:01:18.87,Default,,0,0,0,,Кеше түнде қаладағы дүкенде.
Dialogue: 0,0:01:18.95,0:01:20.87,Default,,0,0,0,,Тонау орын алды
Dialogue: 0,0:01:20.95,0:01:22.91,Default,,0,0,0,,Қылмыскер мылтық тәрізді бірдеңе ұстаған...
Dialogue: 0,0:01:23.50,0:01:25.50,Default,,0,0,0,,♪～
Dialogue: 0,0:02:50.96,0:02:52.96,Default,,0,0,0,,～♪
Dialogue: 0,0:02:53.71,0:02:56.71,Default,,0,0,0,,Милли-чан, әке мені алып кетуге келді.
Dialogue: 0,0:02:56.80,0:02:59.97,Default,,0,0,0,,Папа Икки, сәл күте тұрыңыз~
Dialogue: 0,0:03:00.05,0:03:01.68,Default,,0,0,0,,(Кен Канеки) Менеджер… (Хидеоши Нагачика) Канеки
Dialogue: 0,0:03:02.18,0:03:03.89,Default,,0,0,0,,Ертең саяхат бар ма?
Dialogue: 0,0:03:03.97,0:03:06.72,Default,,0,0,0,,Түскі ас қорабы Мен көңіл-күйімді көтеруім керек.
Dialogue: 0,0:03:07.22,0:03:08.89,Default,,0,0,0,,Бір сәтке қарсы боласыз ба?
Dialogue: 0,0:03:08.98,0:03:10.56,Default,,0,0,0,,Анна Сенсей
Dialogue: 0,0:03:10.64,0:03:12.65,Default,,0,0,0,,Умм, бүгін Милли-чан...
Dialogue: 0,0:03:13.40,0:03:16.65,Default,,0,0,0,,Мен досыммен ұрысып қалдым деп ойлаймын.
Dialogue: 0,0:03:16.73,0:03:17.90,Default,,0,0,0,,Ұрыс?
Dialogue: 0,0:03:17.98,0:03:21.40,Default,,0,0,0,,Мен емес, қарап тұрған бала болды
Dialogue: 0,0:03:21.49,0:03:24.32,Default,,0,0,0,,Мири-чан бұл қадамды бірінші жасағанын айтты.
Dialogue: 0,0:03:24.41,0:03:25.66,Default,,0,0,0,,Не, Мири?
Dialogue: 0,0:03:25.74,0:03:27.74,Default,,0,0,0,,Халықтың өзінен сұрасаң да
Dialogue: 0,0:03:27.83,0:03:31.46,Default,,0,0,0,,Мен әлі баламын, сондықтан жақсы түсіндіре алмаймын.
Dialogue: 0,0:03:31.54,0:03:36.17,Default,,0,0,0,,Әкем Мириден сізбен сөйлесуін сұрай ала ма?
Dialogue: 0,0:03:36.25,0:03:39.92,Default,,0,0,0,,Хмм... Сонымен бірден сізге кезек келді.
Dialogue: 0,0:03:40.63,0:03:41.84,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:03:41.93,0:03:44.93,Default,,0,0,0,,Мұны екі папаға қалдырыңыз!
Dialogue: 0,0:03:45.01,0:03:47.68,Default,,0,0,0,,Уау~ Сенімді~
Dialogue: 0,0:03:47.76,0:03:50.10,Default,,0,0,0,,Менеджер болудан басқа.
Dialogue: 0,0:03:50.18,0:03:51.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:58.94,0:04:02.03,Default,,0,0,0,,Wow~ Zero Papa өте жақсы!
Dialogue: 0,0:04:02.11,0:04:04.36,Default,,0,0,0,,(Миридің күлуі)
Dialogue: 0,0:04:04.45,0:04:08.20,Default,,0,0,0,,Нөл Папа – «Мори карттың» шебері~
Dialogue: 0,0:04:08.28,0:04:08.83,Default,,0,0,0,,Кяхаха
Dialogue: 0,0:04:12.21,0:04:13.08,Default,,0,0,0,,Сәлем Мири
Dialogue: 0,0:04:13.16,0:04:15.12,Default,,0,0,0,,Хмм, не?
Dialogue: 0,0:04:15.21,0:04:17.59,Default,,0,0,0,,Әке, мен оны Анна-чаннан естідім.
Dialogue: 0,0:04:17.67,0:04:19.96,Default,,0,0,0,,Бүгін төбелескеніңізді естідім бе?
Dialogue: 0,0:04:20.05,0:04:21.05,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:04:21.13,0:04:22.26,Default,,0,0,0,,Иә? О!
Dialogue: 0,0:04:22.34,0:04:25.18,Default,,0,0,0,,Жоқ, қарашы, сенің сыныбыңда бір қызбен ұрысып қалдың ғой, солай ма?
Dialogue: 0,0:04:25.26,0:04:27.26,Default,,0,0,0,,Иә! Кері қайтару!
Dialogue: 0,0:04:27.35,0:04:30.06,Default,,0,0,0,,Мири, бұл маңызды тақырып.
Dialogue: 0,0:04:30.14,0:04:31.72,Default,,0,0,0,,Маған дұрыстап қара
Dialogue: 0,0:04:31.81,0:04:32.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:32.85,0:04:35.02,Default,,0,0,0,,Сіз ұрысып қалдыңыз ба?
Dialogue: 0,0:04:35.10,0:04:36.10,Default,,0,0,0,,Не?
Dialogue: 0,0:04:36.19,0:04:39.82,Default,,0,0,0,,Жоқ, сол себепті мен досымды ұрдым деп айтпадым.
Dialogue: 0,0:04:40.32,0:04:41.78,Default,,0,0,0,,Ұрыс? Сіз жеңдіңіз бе?
Dialogue: 0,0:04:41.86,0:04:43.74,Default,,0,0,0,,Керек емес сөздерді айтпа!
Dialogue: 0,0:04:44.24,0:04:45.66,Default,,0,0,0,,Сіз қалай ойлайсыз? мм
Dialogue: 0,0:04:45.74,0:04:46.91,Default,,0,0,0,,Хмм?
Dialogue: 0,0:04:46.99,0:04:49.12,Default,,0,0,0,,Мені ұрғаның рас па?
Dialogue: 0,0:04:49.20,0:04:50.41,Default,,0,0,0,,Мен сені ұрған жоқпын.
Dialogue: 0,0:04:50.49,0:04:54.96,Default,,0,0,0,,Олай болса, әкеңе не болғанын түсіндір.
Dialogue: 0,0:04:55.04,0:04:57.33,Default,,0,0,0,,Әке сізді мұқият тыңдайды.
Dialogue: 0,0:04:57.42,0:04:58.92,Default,,0,0,0,,Неге сонша толқып тұрсың?
Dialogue: 0,0:04:59.00,0:05:01.88,Default,,0,0,0,,Хмм, осындай нәрсе.
Dialogue: 0,0:05:01.96,0:05:04.17,Default,,0,0,0,,Тайға-күн жаман бала еді.
Dialogue: 0,0:05:04.26,0:05:06.76,Default,,0,0,0,,О? Не айтқың келеді?
Dialogue: 0,0:05:06.84,0:05:08.05,Default,,0,0,0,,өшпенділік
Dialogue: 0,0:05:08.14,0:05:10.43,Default,,0,0,0,,Бұл мағынасы жоқ~ Мири
Dialogue: 0,0:05:10.51,0:05:13.60,Default,,0,0,0,,Кім кінәлі? Неліктен ұрыс басталды?
Dialogue: 0,0:05:13.68,0:05:14.89,Default,,0,0,0,,Біз сөйлесуіміз керек
Dialogue: 0,0:05:14.98,0:05:16.19,Default,,0,0,0,,Осындай кездерде
Dialogue: 0,0:05:16.27,0:05:18.90,Default,,0,0,0,,Ата-ана мен бала арасындағы қарым-қатынас маңызды
Dialogue: 0,0:05:18.98,0:05:21.61,Default,,0,0,0,,Хмм, білмеймін...
Dialogue: 0,0:05:21.69,0:05:22.82,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:05:22.90,0:05:24.19,Default,,0,0,0,,Сондықтан араласпаңыз!
Dialogue: 0,0:05:24.28,0:05:25.95,Default,,0,0,0,,Әкем ашулы
Dialogue: 0,0:05:26.03,0:05:27.70,Default,,0,0,0,,Жоқ, мен ашуланбаймын.
Dialogue: 0,0:05:27.78,0:05:30.24,Default,,0,0,0,,Әкем Миримен сөйлескісі келеді.
Dialogue: 0,0:05:30.83,0:05:34.50,Default,,0,0,0,,Егер сіз бірдеңе дұрыс істесеңіз, мен сізге дұрыс ұрысуым керек.
Dialogue: 0,0:05:34.58,0:05:36.29,Default,,0,0,0,,Бұл әкенің жұмысы.
Dialogue: 0,0:05:37.37,0:05:39.29,Default,,0,0,0,,Милли жаман емес.
Dialogue: 0,0:05:39.38,0:05:42.09,Default,,0,0,0,,Мұны әке шешеді.
Dialogue: 0,0:05:42.17,0:05:45.47,Default,,0,0,0,,Мири ненің жақсы не жаман екенін әлі білмейді.
Dialogue: 0,0:05:45.55,0:05:46.38,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:05:46.47,0:05:48.80,Default,,0,0,0,,Жоқ, жоқ, мен бала болғандықтан түсінбеймін.
Dialogue: 0,0:05:48.89,0:05:50.43,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:05:50.93,0:05:51.76,Default,,0,0,0,,Хмм!
Dialogue: 0,0:05:52.43,0:05:53.43,Default,,0,0,0,,Жарайды, милли
Dialogue: 0,0:05:53.51,0:05:56.56,Default,,0,0,0,,Әке, осыны айтқанда мен сізді ойлаймын.
Dialogue: 0,0:05:56.64,0:05:58.06,Default,,0,0,0,,Осындай кездерде Екі Папа...
Dialogue: 0,0:05:58.14,0:05:59.94,Default,,0,0,0,,Жоқ! Әке қорқынышты!
Dialogue: 0,0:06:01.36,0:06:02.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:02.82,0:06:03.78,Default,,0,0,0,,Сәлем Мири!
Dialogue: 0,0:06:05.28,0:06:07.61,Default,,0,0,0,,Мен әкемді жек көремін! Мен оны жек көремін!
Dialogue: 0,0:06:07.70,0:06:08.82,Default,,0,0,0,,Бау!
Dialogue: 0,0:06:09.41,0:06:12.08,Default,,0,0,0,,Жек көремін, жек көремін... (Икки) Е... Е...
Dialogue: 0,0:06:13.66,0:06:15.79,Default,,0,0,0,,Өйткені мен үйренбеген іспен айналысамын.
Dialogue: 0,0:06:15.87,0:06:19.92,Default,,0,0,0,,Жоқ... бұл дұрыс емес. Мен әке ретінде...
Dialogue: 0,0:06:20.42,0:06:23.38,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:06:25.46,0:06:26.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:28.88,0:06:29.88,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:06:29.97,0:06:31.43,Default,,0,0,0,,Толығырақ!
Dialogue: 0,0:06:31.51,0:06:33.35,Default,,0,0,0,,Бүгін далаға саяхат.
Dialogue: 0,0:06:33.43,0:06:35.35,Default,,0,0,0,,Мириге керемет қорап әкелсін.
Dialogue: 0,0:06:35.43,0:06:39.60,Default,,0,0,0,,Менің қызым ең жақсы екенін бәрі білсін.
Dialogue: 0,0:06:39.69,0:06:41.27,Default,,0,0,0,,Тек сізге ұнауға тырысамын, солай ма?
Dialogue: 0,0:06:41.35,0:06:42.36,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:42.98,0:06:43.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:44.23,0:06:45.82,Default,,0,0,0,,(Рэй) Уф… (Эмма) Ех!
Dialogue: 0,0:06:45.90,0:06:48.40,Default,,0,0,0,,Мен кеше болған оқиғаға әлі жауап беріп жатырмын.
Dialogue: 0,0:06:48.99,0:06:50.61,Default,,0,0,0,,Қайырлы таң Нөл папа
Dialogue: 0,0:06:50.70,0:06:51.49,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:51.57,0:06:52.91,Default,,0,0,0,,Қайырлы таң Мири~
Dialogue: 0,0:06:52.99,0:06:54.28,Default,,0,0,0,,Хмф! (Икки) Ах!
Dialogue: 0,0:06:54.37,0:06:57.29,Default,,0,0,0,,Хахаха... Бүгінгі экскурсияны асыға күтемін!
Dialogue: 0,0:06:57.37,0:06:59.54,Default,,0,0,0,,Ауа-райы жақсы және көңілді ~
Dialogue: 0,0:06:59.62,0:07:00.79,Default,,0,0,0,,Мен әкемді жек көремін
Dialogue: 0,0:07:00.87,0:07:02.29,Default,,0,0,0,,Не!
Dialogue: 0,0:07:03.33,0:07:04.59,Default,,0,0,0,,Ми... милли?
Dialogue: 0,0:07:04.67,0:07:06.92,Default,,0,0,0,,Хайуанаттар бағы Әкем бірге келуі керек пе?
Dialogue: 0,0:07:07.00,0:07:08.26,Default,,0,0,0,,Жоқ! (Икки) Гах...
Dialogue: 0,0:07:08.34,0:07:10.34,Default,,0,0,0,,Сіз менің артымнан жүре алмайсыз.
Dialogue: 0,0:07:10.43,0:07:13.22,Default,,0,0,0,,Қараңыз: «Өтінемін, бұлай жасамаңыз».
Dialogue: 0,0:07:13.30,0:07:15.10,Default,,0,0,0,,Ой, мен білемін!
Dialogue: 0,0:07:15.18,0:07:19.52,Default,,0,0,0,,Бірақ әкем қасымда болса қызық болар еді~ Мири
Dialogue: 0,0:07:19.60,0:07:21.73,Default,,0,0,0,,Мен бүгін нөл әкеммен балабақшаға барамын.
Dialogue: 0,0:07:21.81,0:07:23.98,Default,,0,0,0,,Неге мен...
Dialogue: 0,0:07:24.06,0:07:25.15,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:27.36,0:07:28.99,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:07:32.61,0:07:34.12,Default,,0,0,0,,«Мен әкемді жек көремін»
Dialogue: 0,0:07:34.95,0:07:36.24,Default,,0,0,0,,Хаа~
Dialogue: 0,0:07:36.33,0:07:39.04,Default,,0,0,0,,Егер ата-ана мен бала қарым-қатынасы сәтсіздікке ұшыраса,
Dialogue: 0,0:07:39.12,0:07:42.00,Default,,0,0,0,,Янки Милли Егер сіз түзу сызыққа түссеңіз...
Dialogue: 0,0:07:42.67,0:07:45.25,Default,,0,0,0,,(жылау)
Dialogue: 0,0:07:45.33,0:07:46.79,Default,,0,0,0,,Кешіріңіз Мири
Dialogue: 0,0:07:46.88,0:07:49.13,Default,,0,0,0,,Әке, мен сізді түсінбеймін...
Dialogue: 0,0:07:49.21,0:07:51.63,Default,,0,0,0,,Мені мазақ етпе, әке!
Dialogue: 0,0:07:51.72,0:07:54.64,Default,,0,0,0,,Мен сені әрқашан қорқынышты жігіт деп ойлайтынмын.
Dialogue: 0,0:07:54.72,0:07:55.47,Default,,0,0,0,,Қарт ақсақал!
Dialogue: 0,0:07:55.55,0:07:57.22,Default,,0,0,0,,(гүл шайнайтын дыбыс)
Dialogue: 0,0:07:57.31,0:07:59.68,Default,,0,0,0,,Қарт емес... А!
Dialogue: 0,0:08:00.52,0:08:01.56,Default,,0,0,0,,Ия!
Dialogue: 0,0:08:01.64,0:08:04.40,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:08:04.48,0:08:05.06,Default,,0,0,0,,Ах
Dialogue: 0,0:08:06.15,0:08:07.36,Default,,0,0,0,,Ах, нөл!
Dialogue: 0,0:08:07.44,0:08:07.94,Default,,0,0,0,,Не?
Dialogue: 0,0:08:08.02,0:08:09.94,Default,,0,0,0,,Түскі ас қорабы! Мен оны қоюды ұмытып кеттім.
Dialogue: 0,0:08:10.03,0:08:11.86,Default,,0,0,0,,Балабақша Мен жеткізіп беремін!
Dialogue: 0,0:08:11.94,0:08:13.45,Default,,0,0,0,,Е... Менің енді қолымнан келмейді.
Dialogue: 0,0:08:13.53,0:08:15.07,Default,,0,0,0,,Автобус кетті.
Dialogue: 0,0:08:15.16,0:08:17.58,Default,,0,0,0,,Барған кезде абай болыңыз.
Dialogue: 0,0:08:17.66,0:08:18.70,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:08:18.78,0:08:20.41,Default,,0,0,0,,Ол жоғалды...
Dialogue: 0,0:08:20.50,0:08:21.62,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:08:21.70,0:08:23.16,Default,,0,0,0,,Қарғыс атқыр... күте тұр, Мири.
Dialogue: 0,0:08:23.25,0:08:25.92,Default,,0,0,0,,Папа міндетті түрде жеткізеді!
Dialogue: 0,0:08:26.00,0:08:28.34,Default,,0,0,0,,Сіз оны жеткізесіз бе? Неге мазалау керек?
Dialogue: 0,0:08:28.42,0:08:30.17,Default,,0,0,0,,Бұл тамаша экскурсия болса да
Dialogue: 0,0:08:30.25,0:08:32.30,Default,,0,0,0,,Түскі ас қорабы болмаса өзіңізді жаман сезінбейсіз бе?
Dialogue: 0,0:08:32.38,0:08:34.05,Default,,0,0,0,,Бірақ маған келме деді.
Dialogue: 0,0:08:34.13,0:08:36.43,Default,,0,0,0,,Анна-чан ешқашан білмейді.
Dialogue: 0,0:08:37.22,0:08:38.22,Default,,0,0,0,,Кеттік, Нөл!
Dialogue: 0,0:08:38.30,0:08:39.64,Default,,0,0,0,,Әй, не?
Dialogue: 0,0:08:39.72,0:08:41.02,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:08:41.10,0:08:42.56,Default,,0,0,0,,Бұл Мириге арналған! Цукаи!
Dialogue: 0,0:08:42.64,0:08:45.39,Default,,0,0,0,,Жоқ, бұл сізге~
Dialogue: 0,0:08:47.98,0:08:51.15,Default,,0,0,0,,Олай болса, барлығы Аозора балабақшасындағылар~
Dialogue: 0,0:08:51.23,0:08:54.11,Default,,0,0,0,,Мұғалімнің соңынан мұқият болыңыз~
Dialogue: 0,0:08:54.20,0:08:55.40,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:09:24.02,0:09:27.19,Default,,0,0,0,,Олай болса, бұл келесісі~
Dialogue: 0,0:09:27.27,0:09:29.36,Default,,0,0,0,,Иә
Dialogue: 0,0:09:30.77,0:09:35.19,Default,,0,0,0,,(Балабақша тәрбиеленушілерінің шулы дауыстары)
Dialogue: 0,0:09:35.28,0:09:38.20,Default,,0,0,0,,Қарашы, қарашы, маймылдың баласы!
Dialogue: 0,0:09:38.28,0:09:39.99,Default,,0,0,0,,Мен сенің үмітіңе сүйенемін, Гран Торино
Dialogue: 0,0:09:40.07,0:09:41.45,Default,,0,0,0,,Мына жаққа қараңыз~
Dialogue: 0,0:09:42.62,0:09:43.79,Default,,0,0,0,,Уау! Эй!
Dialogue: 0,0:09:45.29,0:09:47.54,Default,,0,0,0,,А, мен кеттім...
Dialogue: 0,0:09:47.62,0:09:49.33,Default,,0,0,0,,Тоқта, Тайга-кун!
Dialogue: 0,0:09:49.42,0:09:51.75,Default,,0,0,0,,Дауыстап айтсаң, таң қаласың!
Dialogue: 0,0:09:51.84,0:09:53.71,Default,,0,0,0,,Милли-чан, жарайды.
Dialogue: 0,0:09:53.80,0:09:56.80,Default,,0,0,0,,Тайга-күн сондай арам, кеттік.
Dialogue: 0,0:09:59.80,0:10:00.89,Default,,0,0,0,,Ммм~
Dialogue: 0,0:10:01.39,0:10:05.35,Default,,0,0,0,,О, керемет! Мына жерде арыстан бар!
Dialogue: 0,0:10:05.43,0:10:06.48,Default,,0,0,0,,Кеттік
Dialogue: 0,0:10:06.56,0:10:07.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:07.81,0:10:09.77,Default,,0,0,0,,Жалғыз жүрсеңіз қауіпті.
Dialogue: 0,0:10:09.85,0:10:10.98,Default,,0,0,0,,Тыныш тыныш
Dialogue: 0,0:10:11.06,0:10:13.82,Default,,0,0,0,,Әй, мен адасып бара жатырмын!
Dialogue: 0,0:10:14.36,0:10:16.78,Default,,0,0,0,,Милли-чан? Қайда бара жатырсың?
Dialogue: 0,0:10:17.86,0:10:18.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:18.82,0:10:22.24,Default,,0,0,0,,Мен саған тәттілерді ішке тастама дедім ғой?
Dialogue: 0,0:10:22.33,0:10:23.99,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:10:25.75,0:10:28.54,Default,,0,0,0,,Күрсін, шынымен де кең көрінеді.
Dialogue: 0,0:10:28.62,0:10:31.88,Default,,0,0,0,,Мен оны бірден тауып аламын да, түскі қорапты сізге жеткіземін!
Dialogue: 0,0:10:31.96,0:10:32.84,Default,,0,0,0,,Хой...
Dialogue: 0,0:10:32.92,0:10:35.13,Default,,0,0,0,,Менің хайуанаттар бағында бірінші рет келуім
Dialogue: 0,0:10:35.21,0:10:39.22,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:10:39.30,0:10:40.34,Default,,0,0,0,,(Монеталар дыбысы)
Dialogue: 0,0:10:40.43,0:10:41.47,Default,,0,0,0,,Чи…
Dialogue: 0,0:10:44.43,0:10:46.97,Default,,0,0,0,,Әй, арыстан қайда?
Dialogue: 0,0:10:47.06,0:10:48.85,Default,,0,0,0,,Ей, тез қайтайық!
Dialogue: 0,0:10:48.93,0:10:50.35,Default,,0,0,0,,Сәлем Милли-чан
Dialogue: 0,0:10:50.44,0:10:52.15,Default,,0,0,0,,Мұғалімдер жоқ.
Dialogue: 0,0:10:52.23,0:10:52.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:53.48,0:10:54.69,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:10:54.77,0:10:56.57,Default,,0,0,0,,Мен адасып қалдым.
Dialogue: 0,0:10:57.32,0:10:58.49,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:10:58.57,0:11:02.41,Default,,0,0,0,,Мири Мен бір рет адасып қалдым, бірақ жақсы болды.
Dialogue: 0,0:11:02.49,0:11:03.37,Default,,0,0,0,,Менің артымнан жүр!
Dialogue: 0,0:11:05.53,0:11:07.87,Default,,0,0,0,,Әй, Тайга-күн, бірге барайық!
Dialogue: 0,0:11:07.95,0:11:09.54,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:11:09.62,0:11:11.54,Default,,0,0,0,,О, күте тұрыңыз~
Dialogue: 0,0:11:12.50,0:11:16.92,Default,,0,0,0,,Мм... Мири қайда...
Dialogue: 0,0:11:19.38,0:11:20.42,Default,,0,0,0,,Бұл тым көп емес пе?
Dialogue: 0,0:11:20.51,0:11:22.47,Default,,0,0,0,,Біз кәсіби мамандармыз
Dialogue: 0,0:11:22.55,0:11:25.39,Default,,0,0,0,,Миссияны орындау үшін бар күшіңізді салыңыз!
Dialogue: 0,0:11:26.26,0:11:27.31,Default,,0,0,0,,Мақсат табылды!
Dialogue: 0,0:11:29.02,0:11:30.23,Default,,0,0,0,,​​Не!
Dialogue: 0,0:11:30.31,0:11:31.19,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:31.27,0:11:34.02,Default,,0,0,0,,Ми... Милли сен!
Dialogue: 0,0:11:36.98,0:11:39.19,Default,,0,0,0,,Бұл Миллидің жігіті~
Dialogue: 0,0:11:39.28,0:11:42.61,Default,,0,0,0,,Біз бір-бірімізге шын ғашықпыз
Dialogue: 0,0:11:42.70,0:11:44.07,Default,,0,0,0,,Махаббат~!
Dialogue: 0,0:11:44.82,0:11:45.70,Default,,0,0,0,,Һм? Ә… Не? Неге?
Dialogue: 0,0:11:45.78,0:11:47.20,Default,,0,0,0,,Не?
Dialogue: 0,0:11:47.28,0:11:49.37,Default,,0,0,0,,Арам емес жыныстық қатынас, мені кешіріңіз!
Dialogue: 0,0:11:49.45,0:11:51.58,Default,,0,0,0,,Сіз менің алдымда керемет көрінесіз!
Dialogue: 0,0:11:51.66,0:11:52.29,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:11:52.37,0:11:54.71,Default,,0,0,0,,Қызыма тиісіп
Dialogue: 0,0:11:54.79,0:11:56.84,Default,,0,0,0,,Мен сені өкіндіремін!
Dialogue: 0,0:11:56.92,0:11:57.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:57.80,0:12:01.88,Default,,0,0,0,,А... анау бала, басқа әйелдер бар ма?
Dialogue: 0,0:12:01.97,0:12:03.76,Default,,0,0,0,,Милли ойнап жатқан жоқ!
Dialogue: 0,0:12:03.84,0:12:05.97,Default,,0,0,0,,О? Эй! (Нөл) Дауыс тым қатты
Dialogue: 0,0:12:06.05,0:12:07.51,Default,,0,0,0,,Мен сені кешірмеймін, әке...
Dialogue: 0,0:12:07.60,0:12:09.89,Default,,0,0,0,,Анашым, бұл не?
Dialogue: 0,0:12:09.97,0:12:12.02,Default,,0,0,0,,Бұған қарамаңыз.
Dialogue: 0,0:12:12.10,0:12:13.64,Default,,0,0,0,,Milli~!
Dialogue: 0,0:12:13.73,0:12:15.90,Default,,0,0,0,,Біреуді шақырсаң жақсы емес пе?
Dialogue: 0,0:12:16.48,0:12:20.15,Default,,0,0,0,,Ендеше, жаман жігітке құмар болмаңыз!
Dialogue: 0,0:12:22.74,0:12:25.49,Default,,0,0,0,,Хаа... Менің қарным ашты.
Dialogue: 0,0:12:25.99,0:12:27.99,Default,,0,0,0,,Анначан!
Dialogue: 0,0:12:28.08,0:12:29.62,Default,,0,0,0,,Сондай мұғалім!
Dialogue: 0,0:12:29.70,0:12:31.16,Default,,0,0,0,,Барлығы қайда?
Dialogue: 0,0:12:31.25,0:12:34.17,Default,,0,0,0,,Анна-чан, жауап беріңізші~
Dialogue: 0,0:12:34.25,0:12:36.79,Default,,0,0,0,,Олар жоғалып кетті ме?
Dialogue: 0,0:12:36.88,0:12:38.79,Default,,0,0,0,,Түскі қорапшаны тез беріп, үйге қайтайық.
Dialogue: 0,0:12:38.88,0:12:41.84,Default,,0,0,0,,Жоқ, әзірге, мен барлығына қайтып келгенше.
Dialogue: 0,0:12:41.92,0:12:43.42,Default,,0,0,0,,Мен оны көруім керек
Dialogue: 0,0:12:44.84,0:12:46.68,Default,,0,0,0,,Бұл айтарлықтай байқалады емес пе?
Dialogue: 0,0:12:47.26,0:12:48.60,Default,,0,0,0,,Егер Анна мені тауып алса
Dialogue: 0,0:12:48.68,0:12:50.47,Default,,0,0,0,,Сіз қатты ашуланасыз.
Dialogue: 0,0:12:50.56,0:12:52.10,Default,,0,0,0,,Ата-ана ешқашан келмеуі керек...
Dialogue: 0,0:12:52.18,0:12:52.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:52.89,0:12:54.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:55.23,0:12:56.56,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:56.65,0:12:59.40,Default,,0,0,0,,Хмм, ештеңе жоқ.
Dialogue: 0,0:12:59.48,0:13:01.53,Default,,0,0,0,,Милли-чан, сен қайда барасың?
Dialogue: 0,0:13:01.61,0:13:02.78,Default,,0,0,0,,Қауіп
Dialogue: 0,0:13:02.86,0:13:06.11,Default,,0,0,0,,Қатысуды сезіне алатын қызым күткендей.
Dialogue: 0,0:13:06.20,0:13:08.07,Default,,0,0,0,,Біздің қанымыз ағады
Dialogue: 0,0:13:08.16,0:13:09.16,Default,,0,0,0,,Өте көзге түседі.
Dialogue: 0,0:13:10.24,0:13:11.04,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:11.12,0:13:12.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:14.50,0:13:16.00,Default,,0,0,0,,Ми... Милли-чан?
Dialogue: 0,0:13:16.08,0:13:19.29,Default,,0,0,0,,Кешіріңіз, Анна-чан, мен сізді таптым деп ойладым.
Dialogue: 0,0:13:19.88,0:13:21.92,Default,,0,0,0,,Кеттік! О... ой
Dialogue: 0,0:13:22.00,0:13:23.30,Default,,0,0,0,,Ги… әрең…
Dialogue: 0,0:13:23.38,0:13:25.38,Default,,0,0,0,,Бір үміт болуы мүмкін.
Dialogue: 0,0:13:35.48,0:13:36.81,Default,,0,0,0,,Не болды? Шынымен де біреу бізді аңдап жүрген екен ғой?
Dialogue: 0,0:13:36.89,0:13:38.85,Default,,0,0,0,,Тексеріңіз, мен шаршадым.
Dialogue: 0,0:13:38.94,0:13:41.32,Default,,0,0,0,,Жоқ, Тайга-кун, тезірек Анна-чан...
Dialogue: 0,0:13:41.40,0:13:42.82,Default,,0,0,0,,Тайга?
Dialogue: 0,0:13:42.90,0:13:44.69,Default,,0,0,0,,Әй, Тайга...
Dialogue: 0,0:13:45.28,0:13:47.45,Default,,0,0,0,,Тайға-күн жаман бала еді.
Dialogue: 0,0:13:47.53,0:13:51.08,Default,,0,0,0,,Кеше Мири қимыл жасады деп айтқан жігіт пе?
Dialogue: 0,0:13:51.16,0:13:54.62,Default,,0,0,0,,Амансың ба? Қайта ұрыспаймыз деп ойлаймын.
Dialogue: 0,0:13:54.70,0:13:55.96,Default,,0,0,0,,Мен үзіліс жасаймын
Dialogue: 0,0:13:56.04,0:13:57.50,Default,,0,0,0,,Иә~ Ммм!
Dialogue: 0,0:13:57.58,0:13:59.25,Default,,0,0,0,,Тек өзімшіл
Dialogue: 0,0:13:59.33,0:14:01.79,Default,,0,0,0,,Олай болса, кішкене үзіліс жасайық.
Dialogue: 0,0:14:01.88,0:14:04.05,Default,,0,0,0,,А, мен шөлдеп тұрмын.
Dialogue: 0,0:14:05.42,0:14:07.01,Default,,0,0,0,,Уф... аа!
Dialogue: 0,0:14:07.09,0:14:08.22,Default,,0,0,0,,…Осылайша мен осы сұмдыққа ат қойдым
Dialogue: 0,0:14:08.30,0:14:09.51,Default,,0,0,0,,Сүрту
Dialogue: 0,0:14:09.59,0:14:10.72,Default,,0,0,0,,Мені жай қалдырыңыз~
Dialogue: 0,0:14:12.30,0:14:14.72,Default,,0,0,0,,Әй... Жарайды, тоқтат!
Dialogue: 0,0:14:14.81,0:14:16.98,Default,,0,0,0,,Жарайды, қозғалма.
Dialogue: 0,0:14:17.56,0:14:21.36,Default,,0,0,0,,Ол төбелескен адамға қамқорлық көрсете ме?
Dialogue: 0,0:14:21.44,0:14:22.31,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:14:25.82,0:14:28.36,Default,,0,0,0,,Су ішкеннен кейін өзімді жақсы сезінемін!
Dialogue: 0,0:14:28.45,0:14:29.86,Default,,0,0,0,,Миллиметр де~
Dialogue: 0,0:14:29.95,0:14:30.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:36.08,0:14:38.25,Default,,0,0,0,,Мен оны әлі алған жоқпын.
Dialogue: 0,0:14:38.33,0:14:38.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:39.46,0:14:42.17,Default,,0,0,0,,Дүкендегілерді алыңыз.
Dialogue: 0,0:14:42.25,0:14:46.09,Default,,0,0,0,,Супермаркеттен бірдеңе сатып алғанда, сұрау керек.
Dialogue: 0,0:14:46.17,0:14:46.92,Default,,0,0,0,,Цк
Dialogue: 0,0:14:49.63,0:14:50.76,Default,,0,0,0,,Оны таңдаңыз!
Dialogue: 0,0:14:50.84,0:14:53.26,Default,,0,0,0,,Не деген сұмдық бала!
Dialogue: 0,0:14:54.31,0:14:55.97,Default,,0,0,0,,Ах! Хмм?
Dialogue: 0,0:14:56.06,0:14:59.44,Default,,0,0,0,,Кешіріңіз! Мен дүкеннен біраз уақытқа шықтым
Dialogue: 0,0:14:59.52,0:15:01.31,Default,,0,0,0,,Сатып алынды ма?
Dialogue: 0,0:15:01.40,0:15:03.81,Default,,0,0,0,,Жақсы, мен оны сатып алуды тоқтаттым!
Dialogue: 0,0:15:04.86,0:15:06.86,Default,,0,0,0,,Цк... есіңізде болсын.
Dialogue: 0,0:15:07.74,0:15:10.07,Default,,0,0,0,,Милли-чан, ол кім?
Dialogue: 0,0:15:10.15,0:15:11.82,Default,,0,0,0,,Милли-чан, жақсысың ба?
Dialogue: 0,0:15:11.91,0:15:15.95,Default,,0,0,0,,Иә, мен саған мұны істе дедім.
Dialogue: 0,0:15:16.04,0:15:18.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:18.12,0:15:20.25,Default,,0,0,0,,Күдікті адамдар көп...
Dialogue: 0,0:15:23.29,0:15:24.42,Default,,0,0,0,,Анна-чан!
Dialogue: 0,0:15:24.50,0:15:26.25,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:15:26.34,0:15:28.46,Default,,0,0,0,,Ах! иә?
Dialogue: 0,0:15:29.67,0:15:32.30,Default,,0,0,0,,Уау~ Бұл Морика!
Dialogue: 0,0:15:32.38,0:15:35.35,Default,,0,0,0,,Бұл рас! Мен Милли Мориканы жақсы көремін!
Dialogue: 0,0:15:35.43,0:15:37.01,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:15:37.10,0:15:38.68,Default,,0,0,0,,Менің әкем мұны жақсы біледі.
Dialogue: 0,0:15:38.77,0:15:40.89,Default,,0,0,0,,Барлық курстар бойынша 1 орынға қол жеткізді
Dialogue: 0,0:15:40.98,0:15:42.98,Default,,0,0,0,,Шынайы ма? Өте керемет!
Dialogue: 0,0:15:43.06,0:15:44.73,Default,,0,0,0,,Сонымен, сіз мұны білесіз бе?
Dialogue: 0,0:15:44.81,0:15:47.23,Default,,0,0,0,,Егер сіз барлық тапсырмаларды орындасаңыз, платина бөліктерін ала аласыз.
Dialogue: 0,0:15:47.32,0:15:48.98,Default,,0,0,0,,Әке, менде бәрі бар.
Dialogue: 0,0:15:49.07,0:15:49.99,Default,,0,0,0,,Керемет!
Dialogue: 0,0:15:50.07,0:15:52.61,Default,,0,0,0,,Тайга-кун көңілді жүрген сияқты
Dialogue: 0,0:15:52.70,0:15:54.37,Default,,0,0,0,,Біз жақсы дос болдық.
Dialogue: 0,0:15:54.45,0:15:57.53,Default,,0,0,0,,Уау~ Әкең өте керемет!
Dialogue: 0,0:15:57.62,0:16:00.33,Default,,0,0,0,,Иә, Мири, мен Зеро Папаны жақсы көремін!
Dialogue: 0,0:16:00.41,0:16:01.96,Default,,0,0,0,,Миллиметр ~
Dialogue: 0,0:16:02.04,0:16:03.21,Default,,0,0,0,,Huh (Ikki) Ku!
Dialogue: 0,0:16:03.29,0:16:07.46,Default,,0,0,0,,Куу~ Тек осындай кезде ғана мақтанасың!
Dialogue: 0,0:16:07.54,0:16:10.05,Default,,0,0,0,,Келесі жолы мен әкемнен сабақ беруін өтінемін.
Dialogue: 0,0:16:10.13,0:16:11.22,Default,,0,0,0,,О!
Dialogue: 0,0:16:13.80,0:16:15.84,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:16:15.93,0:16:17.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:23.27,0:16:24.94,Default,,0,0,0,,Сәлем Милли-чан
Dialogue: 0,0:16:25.02,0:16:26.36,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:16:26.44,0:16:28.73,Default,,0,0,0,,Түскі ас ішейік
Dialogue: 0,0:16:28.82,0:16:29.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:29.82,0:16:31.15,Default,,0,0,0,,Бенто ше? (Нөл) Яба
Dialogue: 0,0:16:31.24,0:16:31.99,Default,,0,0,0,,Мен де жеймін!
Dialogue: 0,0:16:33.40,0:16:34.49,Default,,0,0,0,,Соңғы алты күн үшін үлкен рақмет.
Dialogue: 0,0:16:34.57,0:16:38.03,Default,,0,0,0,,Ендеше, түскі асымызды ішіп болған соң тағы іздейік!
Dialogue: 0,0:16:38.12,0:16:38.99,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:16:40.74,0:16:43.12,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:16:44.54,0:16:45.58,Default,,0,0,0,,Та-да!
Dialogue: 0,0:16:45.67,0:16:47.29,Default,,0,0,0,,Әй, сүйкімді
Dialogue: 0,0:16:47.38,0:16:49.29,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:16:49.80,0:16:52.80,Default,,0,0,0,,Не? Миридің түскі ас қорабы...
Dialogue: 0,0:16:52.88,0:16:54.80,Default,,0,0,0,,Иә? Ұмытып қалдыңыз ба?
Dialogue: 0,0:16:54.88,0:16:57.05,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:57.14,0:16:58.60,Default,,0,0,0,,Мен оны жеткіземін!
Dialogue: 0,0:16:58.68,0:17:00.26,Default,,0,0,0,,Білсе жаман болар еді.
Dialogue: 0,0:17:00.35,0:17:02.18,Default,,0,0,0,,Мен сені аяймын!
Dialogue: 0,0:17:02.27,0:17:03.35,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:03.43,0:17:05.52,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:17:05.60,0:17:06.73,Default,,0,0,0,,Жаса, иә?
Dialogue: 0,0:17:06.81,0:17:07.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:07.81,0:17:08.56,Default,,0,0,0,,Не!
Dialogue: 0,0:17:09.06,0:17:10.15,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:17:10.23,0:17:12.99,Default,,0,0,0,,Hey... We're Morika friends!
Dialogue: 0,0:17:14.19,0:17:15.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:15.53,0:17:17.57,Default,,0,0,0,,Thank you Taiga-kun
Dialogue: 0,0:17:17.66,0:17:18.37,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:18.45,0:17:20.24,Default,,0,0,0,,Бәріміз тамақтанайық!
Dialogue: 0,0:17:20.33,0:17:22.12,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:17:22.20,0:17:24.50,Default,,0,0,0,,Taiga-kun fried chicken
Dialogue: 0,0:17:24.58,0:17:26.50,Default,,0,0,0,,Ол оңай жаман болады...
Dialogue: 0,0:17:26.58,0:17:27.96,Default,,0,0,0,,I won't do it anymore.
Dialogue: 0,0:17:28.04,0:17:28.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:28.79,0:17:30.38,Default,,0,0,0,,Ммм
Dialogue: 0,0:17:32.38,0:17:34.47,Default,,0,0,0,,I won't do it again. Кешіріңіз.
Dialogue: 0,0:17:37.34,0:17:38.47,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:17:38.55,0:17:42.22,Default,,0,0,0,,Шаа! Well then, let's all have lunch together.
Dialogue: 0,0:17:45.31,0:17:46.98,Default,,0,0,0,,Мына күріш шары дәмді~
Dialogue: 0,0:17:47.06,0:17:51.07,Default,,0,0,0,,Хехехе... Анамның күріш шарлары әлемдегі ең жақсысы.
Dialogue: 0,0:17:51.57,0:17:53.82,Default,,0,0,0,,Should I take this home?
Dialogue: 0,0:17:54.32,0:17:56.99,Default,,0,0,0,,Don't do that guy called Taiga.
Dialogue: 0,0:17:57.07,0:17:58.99,Default,,0,0,0,,Жақсы, бірақ...
Dialogue: 0,0:17:59.07,0:18:01.87,Default,,0,0,0,,Мен мұны Миллидің жігіті Пиппиге ешқашан мойындамаймын.
Dialogue: 0,0:18:01.95,0:18:03.24,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:18:03.33,0:18:04.62,Default,,0,0,0,,Give it to me quickly!
Dialogue: 0,0:18:04.70,0:18:06.58,Default,,0,0,0,,Менің қарным ашты, тітіркеніп кеттім!
Dialogue: 0,0:18:06.66,0:18:07.33,Default,,0,0,0,,Милли-чан!
Dialogue: 0,0:18:07.41,0:18:09.83,Default,,0,0,0,,Жоқ! Эй Эй
Dialogue: 0,0:18:09.92,0:18:11.38,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,0:18:11.46,0:18:12.38,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:12.46,0:18:13.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:13.96,0:18:14.71,Default,,0,0,0,,Мугю
Dialogue: 0,0:18:14.80,0:18:17.17,Default,,0,0,0,,Менің жолыма түспе, қарғыс атқыр бала.
Dialogue: 0,0:18:17.26,0:18:18.97,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:19.05,0:18:22.01,Default,,0,0,0,,Hey... that kid from earlier!
Dialogue: 0,0:18:22.10,0:18:23.76,Default,,0,0,0,,Тайга-кунды босат!
Dialogue: 0,0:18:23.85,0:18:24.97,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:27.64,0:18:29.77,Default,,0,0,0,,Shut up and give me the food.
Dialogue: 0,0:18:29.85,0:18:32.15,Default,,0,0,0,,Бұл жақсы емес...
Dialogue: 0,0:18:32.23,0:18:33.90,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:18:39.99,0:18:41.78,Default,,0,0,0,,Не... не сұмдық!
Dialogue: 0,0:18:41.87,0:18:44.91,Default,,0,0,0,,Өтіп бара жатқан қоян мен альпака
Dialogue: 0,0:18:44.99,0:18:47.04,Default,,0,0,0,,Баланы босатыңыз, Пака.
Dialogue: 0,0:18:47.12,0:18:49.62,Default,,0,0,0,,Қарғыс атқыр... әзіл!
Dialogue: 0,0:18:49.71,0:18:51.67,Default,,0,0,0,,Мм... Пён
Dialogue: 0,0:18:51.75,0:18:52.79,Default,,0,0,0,,Пи-ён
Dialogue: 0,0:18:52.88,0:18:54.34,Default,,0,0,0,,Итатата... (Икки) Пён
Dialogue: 0,0:18:56.17,0:18:57.88,Default,,0,0,0,,Уф... Иә?
Dialogue: 0,0:19:00.97,0:19:02.97,Default,,0,0,0,,Қарғыс атсын... бейбақ!
Dialogue: 0,0:19:03.05,0:19:04.68,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:19:05.26,0:19:05.97,Default,,0,0,0,,Ах
Dialogue: 0,0:19:06.72,0:19:07.27,Default,,0,0,0,,Пака…
Dialogue: 0,0:19:07.35,0:19:09.89,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:10.39,0:19:12.23,Default,,0,0,0,,Сәттілік немесе жеңіліс Пака
Dialogue: 0,0:19:13.23,0:19:14.73,Default,,0,0,0,,Хмм... секіру.
Dialogue: 0,0:19:15.73,0:19:17.28,Default,,0,0,0,,Ойыншық Дапён
Dialogue: 0,0:19:17.36,0:19:18.86,Default,,0,0,0,,Иә! (Котори Хината) Уау!
Dialogue: 0,0:19:18.94,0:19:20.53,Default,,0,0,0,,Альпака күшті!
Dialogue: 0,0:19:21.28,0:19:23.28,Default,,0,0,0,,Амансың ба? балалар
Dialogue: 0,0:19:23.87,0:19:25.53,Default,,0,0,0,,Рахмет саған, Қоян!
Dialogue: 0,0:19:25.62,0:19:28.37,Default,,0,0,0,,Маған көмектескені үшін Миридің достары
Dialogue: 0,0:19:29.96,0:19:31.17,Default,,0,0,0,,Керемет!
Dialogue: 0,0:19:31.25,0:19:32.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:32.58,0:19:34.63,Default,,0,0,0,,Сенің аман болғаныңа қуаныштымын, Пён.
Dialogue: 0,0:19:34.71,0:19:36.21,Default,,0,0,0,,Олай болса, Пака...
Dialogue: 0,0:19:36.30,0:19:37.88,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:19:37.96,0:19:38.92,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:19:39.01,0:19:40.47,Default,,0,0,0,,«Бастап көріп, не боларын көрейік» дегендей. Хмм…
Dialogue: 0,0:19:41.38,0:19:42.47,Default,,0,0,0,,Қош бол, рахмет
Dialogue: 0,0:19:42.55,0:19:43.64,Default,,0,0,0,,Жақында кездескенше~
Dialogue: 0,0:19:43.72,0:19:45.68,Default,,0,0,0,,Иә? Менің костюмім ше?
Dialogue: 0,0:19:45.76,0:19:47.01,Default,,0,0,0,,Сіз қайда бардыңыз?
Dialogue: 0,0:19:47.81,0:19:49.10,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:19:49.77,0:19:51.60,Default,,0,0,0,,Сіз ұсталған жоқсыз.
Dialogue: 0,0:19:52.10,0:19:53.69,Default,,0,0,0,,Жақсы пака
Dialogue: 0,0:19:55.15,0:19:57.19,Default,,0,0,0,,Милли-чан! Барлығына!
Dialogue: 0,0:19:57.90,0:19:59.23,Default,,0,0,0,,Анна-чан!
Dialogue: 0,0:19:59.32,0:20:01.20,Default,,0,0,0,,А... бұл жақсы~
Dialogue: 0,0:20:01.28,0:20:03.91,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:20:03.99,0:20:06.95,Default,,0,0,0,,Кешіріңіз, мұғалім, мен оны бірден таба алмадым.
Dialogue: 0,0:20:07.03,0:20:08.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:08.37,0:20:09.83,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:20:09.91,0:20:11.50,Default,,0,0,0,,Тайга-кун жоқ
Dialogue: 0,0:20:11.58,0:20:14.21,Default,,0,0,0,,Анна-чаннан кешірім сұраңыз.
Dialogue: 0,0:20:15.25,0:20:16.84,Default,,0,0,0,,Анна-чан, кешіріңіз!
Dialogue: 0,0:20:16.92,0:20:20.71,Default,,0,0,0,,А... Мири-чан мен Тайга-кун татуласты ма?
Dialogue: 0,0:20:20.80,0:20:23.51,Default,,0,0,0,,Иә? Біз мәңгі доспыз
Dialogue: 0,0:20:23.59,0:20:24.97,Default,,0,0,0,,Біз доспыз.
Dialogue: 0,0:20:25.05,0:20:26.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:26.80,0:20:27.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:28.06,0:20:29.47,Default,,0,0,0,,Ол қамауға алынған сияқты.
Dialogue: 0,0:20:29.56,0:20:31.48,Default,,0,0,0,,Дүкенді тонау? Мұнда?
Dialogue: 0,0:20:31.56,0:20:33.27,Default,,0,0,0,,Өйткені бұл ерекше экскурсия
Dialogue: 0,0:20:33.35,0:20:36.02,Default,,0,0,0,,Бізді қайта бөлуге жол бермеңіз.
Dialogue: 0,0:20:36.10,0:20:37.23,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:20:40.69,0:20:43.86,Default,,0,0,0,,Бұл мен күткеннен әлдеқайда берік.
Dialogue: 0,0:20:44.36,0:20:45.16,Default,,0,0,0,,Не?
Dialogue: 0,0:20:45.24,0:20:47.49,Default,,0,0,0,,Бұл шамамен милли (нөл) Ah.
Dialogue: 0,0:20:48.33,0:20:52.00,Default,,0,0,0,,Әкеге тән ешнәрсе жасамауға тырысып отырдым.
Dialogue: 0,0:20:52.54,0:20:56.00,Default,,0,0,0,,Мен балама көбірек сену керек сияқты болдым.
Dialogue: 0,0:20:56.08,0:20:57.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:58.34,0:21:01.13,Default,,0,0,0,,Бар болғаны тырысу керек, солай ма?
Dialogue: 0,0:21:04.72,0:21:05.68,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:21:06.18,0:21:08.68,Default,,0,0,0,,Папа Икки үйде!
Dialogue: 0,0:21:08.76,0:21:09.68,Default,,0,0,0,,Милли~!
Dialogue: 0,0:21:09.76,0:21:12.39,Default,,0,0,0,,Экскурсия қызықты болды!
Dialogue: 0,0:21:12.98,0:21:14.98,Default,,0,0,0,,О, бұл жақсы.
Dialogue: 0,0:21:15.06,0:21:18.44,Default,,0,0,0,,Аа, дұрыс, мен түскі асымды жинауды ұмытып кетіппін. Өкінішті.
Dialogue: 0,0:21:18.52,0:21:19.61,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:19.69,0:21:22.53,Default,,0,0,0,,Көрдің бе, үлкен қоян болған!
Dialogue: 0,0:21:22.61,0:21:23.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:23.24,0:21:24.40,Default,,0,0,0,,Я~
Dialogue: 0,0:21:24.49,0:21:26.45,Default,,0,0,0,,Мири Мен қатты қысылдым!
Dialogue: 0,0:21:26.53,0:21:27.57,Default,,0,0,0,,Мм... Альпа...
Dialogue: 0,0:21:27.66,0:21:28.91,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:21:29.66,0:21:32.87,Default,,0,0,0,,Жүкті қойғаннан кейін қолыңызды жуыңыз және шайыңыз. Ілгері жүру.
Dialogue: 0,0:21:32.95,0:21:34.16,Default,,0,0,0,,Иә
Dialogue: 0,0:21:35.25,0:21:36.50,Default,,0,0,0,,Қараңызшы (Икки) Иә?
Dialogue: 0,0:21:39.21,0:21:40.38,Default,,0,0,0,,Анна Чаннан?
Dialogue: 0,0:21:40.46,0:21:43.88,Default,,0,0,0,,Кешегі жекпе-жек Мири қатыгез болуды тоқтатуға тырысты
Dialogue: 0,0:21:43.96,0:21:45.92,Default,,0,0,0,,Жай ғана қолымыз соқтығысты
Dialogue: 0,0:21:46.01,0:21:48.64,Default,,0,0,0,,Басқаша айтқанда, Мири араласқан сияқты емес.
Dialogue: 0,0:21:48.72,0:21:50.55,Default,,0,0,0,,Екеуміз ұрысып жатқандай емес едік.
Dialogue: 0,0:21:50.64,0:21:51.97,Default,,0,0,0,,Мен солай ойлаймын
Dialogue: 0,0:21:53.39,0:21:55.43,Default,,0,0,0,,Екі Папа~!
Dialogue: 0,0:21:55.52,0:21:58.35,Default,,0,0,0,,Мен әкемнің түскі асын жедім!
Dialogue: 0,0:21:59.69,0:22:02.86,Default,,0,0,0,,Ой... милли~!
Dialogue: 0,0:22:02.94,0:22:06.15,Default,,0,0,0,,Кешіріңіз~ Бұл әкемнің кінәсі.
Dialogue: 0,0:22:06.24,0:22:08.11,Default,,0,0,0,,Милли жаман емес~
Dialogue: 0,0:22:08.20,0:22:10.12,Default,,0,0,0,,Хехе, қытық екен.
Dialogue: 0,0:22:10.20,0:22:12.74,Default,,0,0,0,,Әке, мені жіберші~ (Икки) Сен жақсы қызсың.
Dialogue: 0,0:22:12.83,0:22:15.79,Default,,0,0,0,,Кяхахаха... (Икки) Жарайды, жарайды...
Dialogue: 0,0:22:15.87,0:22:17.87,Default,,0,0,0,,♪～
Dialogue: 0,0:23:45.84,0:23:47.84,Default,,0,0,0,,～♪
Dialogue: 0,0:23:53.18,0:23:54.59,Default,,0,0,0,,Қош келдіңіз...
Dialogue: 0,0:23:54.68,0:23:55.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:57.60,0:23:58.72,Default,,0,0,0,,Карин-чан...
Dialogue: 0,0:24:00.22,0:24:06.22,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory