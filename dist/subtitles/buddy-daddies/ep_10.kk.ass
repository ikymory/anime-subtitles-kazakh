Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.21,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:00:06.29,0:00:08.17,Default,,0,0,0,,Келесі Рождество кешінде
Dialogue: 0,0:00:08.25,0:00:11.05,Default,,0,0,0,,Ана мен әкенің алдында
Dialogue: 0,0:00:11.13,0:00:13.72,Default,,0,0,0,,Қане бәріміз ән айтайық
Dialogue: 0,0:00:13.80,0:00:16.68,Default,,0,0,0,,Бұл «Түнсіз түн» атты Рождестволық ән.
Dialogue: 0,0:00:16.76,0:00:18.47,Default,,0,0,0,,Бұл қандай ән?
Dialogue: 0,0:00:18.56,0:00:20.18,Default,,0,0,0,,Оны асыға күтемін~
Dialogue: 0,0:00:20.27,0:00:23.18,Default,,0,0,0,,Ал, ең алдымен мұғалім үлгі бойынша ән айтады.
Dialogue: 0,0:00:23.27,0:00:25.31,Default,,0,0,0,,Мұқият тыңдаңыз
Dialogue: 0,0:00:25.90,0:00:28.40,Default,,0,0,0,,(сүрінетін өнімділік)
Dialogue: 0,0:00:28.48,0:00:30.69,Default,,0,0,0,,♪ Тыныш түн!
Dialogue: 0,0:00:30.78,0:00:32.90,Default,,0,0,0,,Сирена? Шш!
Dialogue: 0,0:00:32.99,0:00:36.03,Default,,0,0,0,,♪ Қасиетті түн...
Dialogue: 0,0:00:36.11,0:00:36.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:36.74,0:00:38.58,Default,,0,0,0,,Біртүрлі дыбыс шықты!
Dialogue: 0,0:00:38.66,0:00:40.20,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:00:40.29,0:00:43.04,Default,,0,0,0,,Ха... Кешіріңіз.
Dialogue: 0,0:00:43.12,0:00:45.58,Default,,0,0,0,,Мен Рождестволық кешке дейін көп жаттығу жасаймын.
Dialogue: 0,0:00:46.58,0:00:49.67,Default,,0,0,0,,Анна-чан, Мири, мен бұл әнді айта аламын!
Dialogue: 0,0:00:49.75,0:00:50.96,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:00:51.05,0:00:51.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:51.71,0:00:54.01,Default,,0,0,0,,Мен анаммен бірге ән айтқанмын.
Dialogue: 0,0:00:54.55,0:00:57.97,Default,,0,0,0,,♪ Тыныш түн!
Dialogue: 0,0:00:58.05,0:01:00.31,Default,,0,0,0,,Жақсы! Керемет!
Dialogue: 0,0:01:00.39,0:01:01.51,Default,,0,0,0,,Эхехе
Dialogue: 0,0:01:02.02,0:01:06.48,Default,,0,0,0,,Олай болса, бірге жаттығу жасайық~
Dialogue: 0,0:01:06.56,0:01:08.02,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:01:09.40,0:01:10.61,Default,,0,0,0,,Сыйлық па?
Dialogue: 0,0:01:11.11,0:01:13.53,Default,,0,0,0,,Рождество жақындап қалды
Dialogue: 0,0:01:13.61,0:01:16.45,Default,,0,0,0,,Мири Маған бірдеңе керек. Солай ма?
Dialogue: 0,0:01:16.53,0:01:18.11,Default,,0,0,0,,«Моликардың 2-ші басылымы»
Dialogue: 0,0:01:18.20,0:01:20.45,Default,,0,0,0,,Жоқ, сенің қалағаның осы!
Dialogue: 0,0:01:20.53,0:01:21.37,Default,,0,0,0,,Сақталған
Dialogue: 0,0:01:21.45,0:01:23.66,Default,,0,0,0,,Екі болса да көмектеспейді.
Dialogue: 0,0:01:27.12,0:01:27.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:31.09,0:01:32.00,Default,,0,0,0,,Ах
Dialogue: 0,0:01:33.30,0:01:34.55,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:01:35.34,0:01:37.05,Default,,0,0,0,,Миридің анасы
Dialogue: 0,0:01:38.51,0:01:40.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:05.89,0:03:07.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:10.73,0:03:12.81,Default,,0,0,0,,Бұл Мисаки Кайзака.
Dialogue: 0,0:03:13.40,0:03:15.77,Default,,0,0,0,,Осы бөлімдегі көмегіңіз үшін рахмет.
Dialogue: 0,0:03:19.61,0:03:21.03,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:03:21.65,0:03:24.32,Default,,0,0,0,,Мен Миллиді алуға келдім...
Dialogue: 0,0:03:24.41,0:03:25.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:25.62,0:03:27.87,Default,,0,0,0,,Эй, мен оны қабылдаймын...
Dialogue: 0,0:03:28.45,0:03:30.66,Default,,0,0,0,,Қалағаныңды айтпа.
Dialogue: 0,0:03:30.75,0:03:31.46,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:31.54,0:03:33.96,Default,,0,0,0,,Мириді жауапсыздықпен лақтырыңыз
Dialogue: 0,0:03:34.04,0:03:37.05,Default,,0,0,0,,Менің бетімді көргің келмейтінін айттың ғой.
Dialogue: 0,0:03:37.13,0:03:38.76,Default,,0,0,0,,Сіз нені білдіреді?
Dialogue: 0,0:03:38.84,0:03:41.05,Default,,0,0,0,,Мен анамын
Dialogue: 0,0:03:41.55,0:03:44.22,Default,,0,0,0,,Сіздің қызыңызбен тұруға құқығыңыз бар
Dialogue: 0,0:03:44.30,0:03:46.64,Default,,0,0,0,,Енді не айтып тұрсың... біз!
Dialogue: 0,0:03:46.72,0:03:47.51,Default,,0,0,0,,Эй
Dialogue: 0,0:03:50.81,0:03:52.85,Default,,0,0,0,,Әй, бұл ана!
Dialogue: 0,0:03:52.94,0:03:56.44,Default,,0,0,0,,Бұл ана! Анашым!
Dialogue: 0,0:03:56.52,0:03:57.61,Default,,0,0,0,,Милли күту...
Dialogue: 0,0:03:57.69,0:03:58.90,Default,,0,0,0,,Кяхаха!
Dialogue: 0,0:04:00.40,0:04:03.32,Default,,0,0,0,,Мири, мен сені сағындым.
Dialogue: 0,0:04:04.32,0:04:05.99,Default,,0,0,0,,Бұл ана~
Dialogue: 0,0:04:20.34,0:04:22.72,Default,,0,0,0,,Мири мұны салды.
Dialogue: 0,0:04:22.80,0:04:25.01,Default,,0,0,0,,Уау, бұл жақсы емес.
Dialogue: 0,0:04:25.09,0:04:27.76,Default,,0,0,0,,Бұл достың салған суреті.
Dialogue: 0,0:04:27.85,0:04:29.85,Default,,0,0,0,,Мені мұнда неге әкелдің?
Dialogue: 0,0:04:29.93,0:04:33.23,Default,,0,0,0,,Ондай жерде күрделі талқылаулар өткізуге мүмкіндік жоқ.
Dialogue: 0,0:04:33.31,0:04:35.56,Default,,0,0,0,,Сен оны қуып жіберуің керек еді!
Dialogue: 0,0:04:35.65,0:04:37.44,Default,,0,0,0,,Сіз мұны Миллидің алдында жасай аласыз ба?
Dialogue: 0,0:04:37.52,0:04:39.02,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:04:39.11,0:04:41.69,Default,,0,0,0,,Мама, тезірек!
Dialogue: 0,0:04:44.65,0:04:46.61,Default,,0,0,0,,Бұл Миридің бөлмесі!
Dialogue: 0,0:04:47.12,0:04:48.62,Default,,0,0,0,,Я~
Dialogue: 0,0:04:50.16,0:04:51.24,Default,,0,0,0,,CERN-ге қарсы шыққан террорист.
Dialogue: 0,0:04:52.66,0:04:55.00,Default,,0,0,0,,Мұның бәрі миллиметрде ме?
Dialogue: 0,0:04:55.08,0:04:57.54,Default,,0,0,0,,Оны маған әкем сатып алған.
Dialogue: 0,0:04:57.63,0:04:59.00,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:59.50,0:05:02.67,Default,,0,0,0,,Эй Мири, сен күнде көңілді боласың ба?
Dialogue: 0,0:05:02.76,0:05:03.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:04.26,0:05:08.34,Default,,0,0,0,,Олай болса, анаңның қасында болғаннан гөрі осында болғанды ​​қалайсың ба?
Dialogue: 0,0:05:08.43,0:05:09.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:09.51,0:05:10.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:12.77,0:05:14.39,Default,,0,0,0,,Мен анамды жақсы көремін
Dialogue: 0,0:05:16.73,0:05:18.56,Default,,0,0,0,,Маған да әкелер ұнайды
Dialogue: 0,0:05:21.27,0:05:24.69,Default,,0,0,0,,Кешіріңіз, анашым, бірдеңе дұрыс болмады.
Dialogue: 0,0:05:25.19,0:05:27.74,Default,,0,0,0,,Мириден бөліну...
Dialogue: 0,0:05:28.24,0:05:29.91,Default,,0,0,0,,Мама гамбургер!
Dialogue: 0,0:05:29.99,0:05:30.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:31.08,0:05:34.16,Default,,0,0,0,,Милли Мен анамның гамбургерін жегім келеді!
Dialogue: 0,0:05:35.96,0:05:38.25,Default,,0,0,0,,Не деген...
Dialogue: 0,0:05:38.33,0:05:41.13,Default,,0,0,0,,Бүгін бұл анамның гамбургері!
Dialogue: 0,0:05:41.21,0:05:41.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:41.79,0:05:44.13,Default,,0,0,0,,Мири гамбургер жегісі келеді.
Dialogue: 0,0:05:44.21,0:05:46.26,Default,,0,0,0,,Біз бірге дүкен аралауға шықтық.
Dialogue: 0,0:05:46.34,0:05:49.09,Default,,0,0,0,,Бірге тамақтанайық, әкелер!
Dialogue: 0,0:05:49.18,0:05:52.14,Default,,0,0,0,,Әй, ана, тез жет!
Dialogue: 0,0:05:52.22,0:05:55.31,Default,,0,0,0,,Кешіріңіз, мен асүйді қарызға аламын.
Dialogue: 0,0:05:57.23,0:05:58.56,Default,,0,0,0,,Бұл Мириге арналған.
Dialogue: 0,0:05:59.06,0:06:01.56,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:06:01.65,0:06:05.74,Default,,0,0,0,,Басқа біреудің ас үйіңізді рұқсатсыз пайдалануы қандай тітіркендіргіш!
Dialogue: 0,0:06:05.82,0:06:06.40,Default,,0,0,0,,Онда?
Dialogue: 0,0:06:06.49,0:06:08.36,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:13.70,0:06:14.79,Default,,0,0,0,,(Микротолқынды дыбыс)
Dialogue: 0,0:06:24.25,0:06:26.05,Default,,0,0,0,,Бұл дәмді, анашым!
Dialogue: 0,0:06:26.13,0:06:28.30,Default,,0,0,0,,Мені бақытты еткеніңіз үшін рахмет.
Dialogue: 0,0:06:28.38,0:06:30.51,Default,,0,0,0,,Иә, менің гамбургерім
Dialogue: 0,0:06:30.59,0:06:33.43,Default,,0,0,0,,А5 дәрежелі жапондық қара сиыр еті тартылған ет
Dialogue: 0,0:06:33.51,0:06:36.47,Default,,0,0,0,,Нагоя Кочиндегі Аваджи аралынан алынған органикалық жолмен өсірілген пияз...
Dialogue: 0,0:06:36.56,0:06:37.89,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:06:37.98,0:06:39.31,Default,,0,0,0,,Ngiiiii!
Dialogue: 0,0:06:41.65,0:06:44.52,Default,,0,0,0,,Эй, мен Рождестволық кеште ән айтып жатырмын.
Dialogue: 0,0:06:44.61,0:06:47.61,Default,,0,0,0,,Иә! «Тыныш түн» деп аталатын ән
Dialogue: 0,0:06:47.69,0:06:49.86,Default,,0,0,0,,Біз бұрын бірге ән айтқанбыз.
Dialogue: 0,0:06:49.95,0:06:52.16,Default,,0,0,0,,Онда маған көп жаттығу керек.
Dialogue: 0,0:06:52.24,0:06:53.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:53.91,0:06:55.58,Default,,0,0,0,,Анашым, бірге ән айтайық!
Dialogue: 0,0:06:59.79,0:07:02.04,Default,,0,0,0,,Маманың әндері қымбат.
Dialogue: 0,0:07:02.13,0:07:04.88,Default,,0,0,0,,Мен әкелерімнен ақша төлеуім керек.
Dialogue: 0,0:07:04.96,0:07:07.26,Default,,0,0,0,,Мен сізге оны тегін естуге рұқсат ете алмаймын.
Dialogue: 0,0:07:07.76,0:07:09.47,Default,,0,0,0,,Әке ақша!
Dialogue: 0,0:07:09.55,0:07:10.55,Default,,0,0,0,,Кім төлейді!
Dialogue: 0,0:07:13.22,0:07:16.72,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:07:17.64,0:07:19.89,Default,,0,0,0,,Енді негізгі тақырыпқа көшейік.
Dialogue: 0,0:07:21.02,0:07:22.81,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:07:23.65,0:07:24.23,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:26.73,0:07:28.23,Default,,0,0,0,,Біз темекі шекпейміз.
Dialogue: 0,0:07:30.99,0:07:34.95,Default,,0,0,0,,Мен жұмыстан қуылдым, жігіт мені тастап кетті.
Dialogue: 0,0:07:35.99,0:07:38.58,Default,,0,0,0,,Қатерлі ісік осы уақытқа дейін метастазданған.
Dialogue: 0,0:07:38.66,0:07:40.62,Default,,0,0,0,,Мен енді ән айта алмаймын
Dialogue: 0,0:07:41.79,0:07:43.58,Default,,0,0,0,,Сен өлесің бе? (Икки) Эй
Dialogue: 0,0:07:43.67,0:07:45.79,Default,,0,0,0,,Құдай жаман
Dialogue: 0,0:07:46.34,0:07:50.97,Default,,0,0,0,,Қаншама қиындықтан кейін маған қалай қарайсың?
Dialogue: 0,0:07:51.05,0:07:53.34,Default,,0,0,0,,Маған сіздің жағдайыңыз маңызды емес.
Dialogue: 0,0:07:53.43,0:07:54.89,Default,,0,0,0,,Ол миллиметр болса да маңызды емес.
Dialogue: 0,0:07:56.68,0:08:01.14,Default,,0,0,0,,Мен қанша өмір сүретінімді де білмеймін.
Dialogue: 0,0:08:02.77,0:08:07.40,Default,,0,0,0,,Сондықтан мені аяп, өзімшілдігім үшін кешіріңіз.
Dialogue: 0,0:08:07.90,0:08:10.94,Default,,0,0,0,,Мен қызыммен қайтадан басынан бастағым келеді.
Dialogue: 0,0:08:11.44,0:08:13.40,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:08:13.49,0:08:16.41,Default,,0,0,0,,Мен ең бастысын түсіндім.
Dialogue: 0,0:08:16.91,0:08:20.37,Default,,0,0,0,,Мен ата-анамның үйіне оралып, дұрыс және байыпты өмір сүремін.
Dialogue: 0,0:08:21.33,0:08:24.87,Default,,0,0,0,,Ол бала менде болғанша, маған басқа ештеңе керек емес.
Dialogue: 0,0:08:24.96,0:08:27.96,Default,,0,0,0,,Өтінемін... өтінемін
Dialogue: 0,0:08:30.17,0:08:31.13,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:08:31.92,0:08:35.09,Default,,0,0,0,,Мири Рождество кешін асыға күтуде.
Dialogue: 0,0:08:35.59,0:08:37.89,Default,,0,0,0,,Қазір қоршаған ортаны өзгерту өкінішті болар еді.
Dialogue: 0,0:08:38.68,0:08:42.14,Default,,0,0,0,,Мен сізге біраз уақытқа қазіргі балабақшаңызға баруға рұқсат етемін.
Dialogue: 0,0:08:42.23,0:08:43.89,Default,,0,0,0,,Жақын жерде пәтер жалдаңыз
Dialogue: 0,0:08:43.98,0:08:47.36,Default,,0,0,0,,Мен сол балаға ауыртпалық түсірмеу үшін бәрін жасаймын.
Dialogue: 0,0:08:50.15,0:08:51.98,Default,,0,0,0,,Сіз өзгердіңіз.
Dialogue: 0,0:08:52.49,0:08:55.32,Default,,0,0,0,,Қанша қиыншылықты басынан өткерсем, бұдан былай
Dialogue: 0,0:08:55.40,0:08:58.32,Default,,0,0,0,,Мен тек Мири үшін өмір сүргім келеді.
Dialogue: 0,0:08:59.70,0:09:01.58,Default,,0,0,0,,Қалағаныңды айтпа
Dialogue: 0,0:09:02.08,0:09:04.00,Default,,0,0,0,,Миридің сезімі туралы да мәселе бар.
Dialogue: 0,0:09:05.25,0:09:06.54,Default,,0,0,0,,Мен білемін...
Dialogue: 0,0:09:11.96,0:09:15.88,Default,,0,0,0,,Мириге осы уақытқа дейін қамқорлық жасағаныңызға көп рахмет.
Dialogue: 0,0:09:17.89,0:09:18.84,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:09:19.35,0:09:22.56,Default,,0,0,0,,Сіздердің бәріңіздің қауіпті жұмысыңыз бар екенін де білеміз.
Dialogue: 0,0:09:22.64,0:09:23.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:25.73,0:09:28.85,Default,,0,0,0,,Ана ретінде сізге айтар сөзім жоқ.
Dialogue: 0,0:09:28.94,0:09:31.32,Default,,0,0,0,,Мен Мириді қамауда қалдыра алмаймын.
Dialogue: 0,0:09:32.11,0:09:35.15,Default,,0,0,0,,Егер сіз де Миллидің ата-анасы болсаңыз.
Dialogue: 0,0:09:35.65,0:09:37.32,Default,,0,0,0,,Сіз солай ойлайсыз, солай ма?
Dialogue: 0,0:09:47.50,0:09:49.88,Default,,0,0,0,,Мен бүгін үйге барамын.
Dialogue: 0,0:09:52.63,0:09:55.05,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:09:55.55,0:09:56.67,Default,,0,0,0,,Хаа~
Dialogue: 0,0:09:59.22,0:10:01.64,Default,,0,0,0,,Миридің анасы келді ме?
Dialogue: 0,0:10:01.72,0:10:05.02,Default,,0,0,0,,А, кенет біреу кіріп келді.
Dialogue: 0,0:10:05.10,0:10:07.48,Default,,0,0,0,,Себебі Мири ұйықтап жатқанда оны қуып жібердім.
Dialogue: 0,0:10:07.56,0:10:09.35,Default,,0,0,0,,Ұйықтау қиын болды.
Dialogue: 0,0:10:10.52,0:10:11.73,Default,,0,0,0,,Неліктен бұл адам?
Dialogue: 0,0:10:11.81,0:10:13.94,Default,,0,0,0,,Миридің тұрған жері және біздің жұмысымыз туралы.
Dialogue: 0,0:10:14.03,0:10:15.40,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:10:16.03,0:10:16.86,Default,,0,0,0,,Мен саған үйреттім
Dialogue: 0,0:10:16.94,0:10:17.86,Default,,0,0,0,,Боу!
Dialogue: 0,0:10:17.95,0:10:18.65,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:10:19.16,0:10:23.08,Default,,0,0,0,,Не... Неге, Хиса-чан, сен онымен хабарластың?
Dialogue: 0,0:10:26.33,0:10:27.08,Default,,0,0,0,,Бұл…
Dialogue: 0,0:10:27.58,0:10:29.50,Default,,0,0,0,,Бұл біз түсірген фото емес.
Dialogue: 0,0:10:30.17,0:10:32.67,Default,,0,0,0,,Бұл Рио Огино, сіз оны білесіз.
Dialogue: 0,0:10:34.59,0:10:36.13,Default,,0,0,0,,Неліктен милли?
Dialogue: 0,0:10:36.71,0:10:38.38,Default,,0,0,0,,Бұл ескерту
Dialogue: 0,0:10:39.13,0:10:40.47,Default,,0,0,0,,Сол баланың бар болуы
Dialogue: 0,0:10:40.55,0:10:43.43,Default,,0,0,0,,Сіздің жұмысыңыздың дәлдігін сөзсіз баяулатады
Dialogue: 0,0:10:43.93,0:10:45.60,Default,,0,0,0,,Ұйым рұқсат бермейді.
Dialogue: 0,0:10:47.93,0:10:49.94,Default,,0,0,0,,Сондықтан мен анама хабарластым.
Dialogue: 0,0:10:50.48,0:10:53.77,Default,,0,0,0,,Тез кетпесеңіз, ескерту жеткіліксіз болады.
Dialogue: 0,0:10:53.86,0:10:56.19,Default,,0,0,0,,Жоқ... Милли?
Dialogue: 0,0:10:56.82,0:11:00.99,Default,,0,0,0,,Ұйымға садақ тартуға дайынсыз ба?
Dialogue: 0,0:11:01.82,0:11:03.07,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:06.66,0:11:08.45,Default,,0,0,0,,Ұйымға опасыздық жасады
Dialogue: 0,0:11:08.95,0:11:12.12,Default,,0,0,0,,Үмітіңізді ақтамаңыз.
Dialogue: 0,0:11:20.51,0:11:22.30,Default,,0,0,0,,Сізге де
Dialogue: 0,0:11:22.39,0:11:25.05,Default,,0,0,0,,Анаға да, Мириге де
Dialogue: 0,0:11:25.14,0:11:27.47,Default,,0,0,0,,Бұл ең жақсы нұсқа
Dialogue: 0,0:11:28.14,0:11:31.48,Default,,0,0,0,,Жоқ, сондықтан кенеттен миллиметрді қайтаруымды өтінді...
Dialogue: 0,0:11:31.56,0:11:32.69,Default,,0,0,0,,Ах, өрттен келтірілген зиянды жөндеп жатқанда, мен де біраз жөндеу жұмыстарын жүргізгім келеді
Dialogue: 0,0:11:33.56,0:11:36.82,Default,,0,0,0,,Әкесін сол баладан тартып алдық.
Dialogue: 0,0:11:36.90,0:11:37.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:38.32,0:11:41.11,Default,,0,0,0,,Бірақ екеуің біргесіңдер
Dialogue: 0,0:11:41.20,0:11:43.41,Default,,0,0,0,,Жақсы адам болып, отбасын ойнау?
Dialogue: 0,0:11:43.91,0:11:46.99,Default,,0,0,0,,Балаларыңызды мазақ етуден қорықпаңыз.
Dialogue: 0,0:11:49.20,0:11:51.54,Default,,0,0,0,,Енді өтірік айтпа
Dialogue: 0,0:11:53.62,0:11:55.54,Default,,0,0,0,,Бұл ән арманы еді
Dialogue: 0,0:11:57.55,0:11:59.96,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:12:03.30,0:12:03.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:04.01,0:12:06.22,Default,,0,0,0,,Жарайды, оян, Мири!
Dialogue: 0,0:12:06.30,0:12:08.97,Default,,0,0,0,,Балабақша жабылды.
Dialogue: 0,0:12:09.06,0:12:11.10,Default,,0,0,0,,Сыртқа шығайық. Дайын бол!
Dialogue: 0,0:12:12.31,0:12:13.56,Default,,0,0,0,,Сыртқа шығасыз ба?
Dialogue: 0,0:12:13.64,0:12:16.81,Default,,0,0,0,,(қоңырау металл дыбысы)
Dialogue: 0,0:12:16.90,0:12:18.69,Default,,0,0,0,,Оян, оян! Нөл әке!
Dialogue: 0,0:12:18.77,0:12:20.78,Default,,0,0,0,,Шығу!
Dialogue: 0,0:12:20.86,0:12:21.44,Default,,0,0,0,,Гуааа…
Dialogue: 0,0:12:23.24,0:12:25.41,Default,,0,0,0,,Әй әке, қайда барасыз?
Dialogue: 0,0:12:25.49,0:12:27.03,Default,,0,0,0,,Құпия
Dialogue: 0,0:12:27.12,0:12:28.78,Default,,0,0,0,,К-чи-
Dialogue: 0,0:12:29.49,0:12:31.66,Default,,0,0,0,,Эй, сен қайдасың? (Нөл) Неге кенеттен?
Dialogue: 0,0:12:31.75,0:12:33.96,Default,,0,0,0,,Отбасы қызметтері.
Dialogue: 0,0:12:34.04,0:12:34.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:35.21,0:12:38.13,Default,,0,0,0,,Өкінбеймін деп
Dialogue: 0,0:12:40.63,0:12:44.05,Default,,0,0,0,,♪ Тыныш түн!
Dialogue: 0,0:12:46.14,0:12:47.60,Default,,0,0,0,,Жая~!
Dialogue: 0,0:12:47.68,0:12:50.22,Default,,0,0,0,,Бүгінгі баратын жер осында!
Dialogue: 0,0:12:50.31,0:12:51.31,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:12:51.39,0:12:53.77,Default,,0,0,0,,Не? Мұнда не?
Dialogue: 0,0:12:54.35,0:12:57.23,Default,,0,0,0,,Кокохана - балалар үшін танымал орын.
Dialogue: 0,0:12:57.31,0:12:59.19,Default,,0,0,0,,Олар өте көп!
Dialogue: 0,0:12:59.27,0:13:00.86,Default,,0,0,0,,Қараңызшы, осындай нәрсе...
Dialogue: 0,0:13:00.94,0:13:02.19,Default,,0,0,0,,Уау~ (Икки) Мынадай нәрсе!
Dialogue: 0,0:13:02.28,0:13:04.65,Default,,0,0,0,,Қызық көрінеді!
Dialogue: 0,0:13:05.15,0:13:07.11,Default,,0,0,0,,Мен оны асыға күтемін, Нөл папа!
Dialogue: 0,0:13:07.70,0:13:09.45,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:13:09.95,0:13:10.74,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:10.83,0:13:13.54,Default,,0,0,0,,Бүгінгі күнді көңілді өткізейік!
Dialogue: 0,0:13:13.62,0:13:14.71,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:13:17.79,0:13:19.79,Default,,0,0,0,,О~
Dialogue: 0,0:13:23.55,0:13:26.22,Default,,0,0,0,,Ой уау уау вау кяхахахаха!
Dialogue: 0,0:13:28.30,0:13:30.22,Default,,0,0,0,,Уау! (Икки) Жоқ!
Dialogue: 0,0:13:30.30,0:13:31.72,Default,,0,0,0,,Иә, ірімшік!
Dialogue: 0,0:13:31.81,0:13:32.72,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:13:32.81,0:13:34.73,Default,,0,0,0,,Уау (Икки) Ах, Мири!
Dialogue: 0,0:13:35.31,0:13:36.23,Default,,0,0,0,,Иә! (Нөл) Иә
Dialogue: 0,0:13:39.31,0:13:41.15,Default,,0,0,0,,Сәлем! Гунну...
Dialogue: 0,0:13:41.23,0:13:42.19,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:13:42.27,0:13:44.49,Default,,0,0,0,,Ой... баламның басына бірдеңе болып қалса ше...
Dialogue: 0,0:13:44.57,0:13:46.28,Default,,0,0,0,,Әке, бәрі жақсы.
Dialogue: 0,0:13:46.36,0:13:48.53,Default,,0,0,0,,Жоқ, бірақ мен тайып кетсем ше?
Dialogue: 0,0:13:48.61,0:13:50.24,Default,,0,0,0,,Бізде қауіпсіздік құрылғылары да орнатылған.
Dialogue: 0,0:13:50.32,0:13:52.16,Default,,0,0,0,,Бірақ жағдайға байланысты!
Dialogue: 0,0:13:52.24,0:13:53.95,Default,,0,0,0,,Әр шулы
Dialogue: 0,0:14:00.46,0:14:02.55,Default,,0,0,0,,Нөл Папа керемет!
Dialogue: 0,0:14:03.46,0:14:05.13,Default,,0,0,0,,Ахх...
Dialogue: 0,0:14:05.63,0:14:08.01,Default,,0,0,0,,Бұл қауіпті! Қорқынышты!
Dialogue: 0,0:14:08.09,0:14:10.68,Default,,0,0,0,,Икки Папа өте керемет!
Dialogue: 0,0:14:21.27,0:14:23.61,Default,,0,0,0,,Мен әлі де ойнағым келеді!
Dialogue: 0,0:14:24.15,0:14:25.19,Default,,0,0,0,,Жоспар
Dialogue: 0,0:14:25.69,0:14:26.78,Default,,0,0,0,,Сіз қарныңыз ашты.
Dialogue: 0,0:14:26.86,0:14:28.36,Default,,0,0,0,,Жүр, тамақ ішейік
Dialogue: 0,0:14:28.45,0:14:29.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:32.62,0:14:34.95,Default,,0,0,0,,Әке, мен мынаны жегім келеді!
Dialogue: 0,0:14:35.04,0:14:36.08,Default,,0,0,0,,А, бұл дәмді көрінеді.
Dialogue: 0,0:14:36.75,0:14:37.75,Default,,0,0,0,,Барып сатып алыңыз.
Dialogue: 0,0:14:37.83,0:14:39.67,Default,,0,0,0,,Мен сізге орын сақтаймын.
Dialogue: 0,0:14:40.17,0:14:40.96,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:14:41.04,0:14:44.00,Default,,0,0,0,,Хмм, мен де құлпынай мен бананды жақсы көремін...
Dialogue: 0,0:14:46.51,0:14:47.01,Default,,0,0,0,,О
Dialogue: 0,0:14:49.59,0:14:51.51,Default,,0,0,0,,О, қандай үлкен!
Dialogue: 0,0:14:51.59,0:14:54.01,Default,,0,0,0,,Мм, м... Мен бәрін қойдым.
Dialogue: 0,0:14:54.10,0:14:56.27,Default,,0,0,0,,Бұл таңқаларлық дәмді көрінеді.
Dialogue: 0,0:14:56.35,0:14:58.39,Default,,0,0,0,,Менің де жегім келеді.
Dialogue: 0,0:14:59.85,0:15:02.02,Default,,0,0,0,,Екі папа Аххх
Dialogue: 0,0:15:02.61,0:15:03.61,Default,,0,0,0,,Сіз...
Dialogue: 0,0:15:04.36,0:15:06.03,Default,,0,0,0,,Жақсы бала!
Dialogue: 0,0:15:06.11,0:15:07.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:08.32,0:15:10.86,Default,,0,0,0,,Иә, нөл әке де.
Dialogue: 0,0:15:10.95,0:15:12.45,Default,,0,0,0,,Е, жоқ, мен...
Dialogue: 0,0:15:13.32,0:15:14.45,Default,,0,0,0,,(Фушигуро) Ол іссапарда. (Итадори) Ә?
Dialogue: 0,0:15:19.29,0:15:20.66,Default,,0,0,0,,Иә, керемет.
Dialogue: 0,0:15:20.75,0:15:23.13,Default,,0,0,0,,Үш адамға уақыттың жартысы
Dialogue: 0,0:15:23.21,0:15:25.29,Default,,0,0,0,,Бұндай жағдай бұрын да болған.
Dialogue: 0,0:15:25.38,0:15:28.42,Default,,0,0,0,,Бірге тамақтансаңыз, одан да дәмді болады!
Dialogue: 0,0:15:33.84,0:15:35.68,Default,,0,0,0,,Эй Мири, маған тағы бір тістеп берші.
Dialogue: 0,0:15:36.35,0:15:37.56,Default,,0,0,0,,Енді жоқ~
Dialogue: 0,0:15:37.64,0:15:40.23,Default,,0,0,0,,Иә~ Әлі көп нәрсе қалды.
Dialogue: 0,0:15:40.31,0:15:42.60,Default,,0,0,0,,Кішкене болса жақсы.
Dialogue: 0,0:15:43.60,0:15:44.36,Default,,0,0,0,,Ах
Dialogue: 0,0:15:44.86,0:15:46.40,Default,,0,0,0,,Бұл милли!
Dialogue: 0,0:15:46.48,0:15:47.94,Default,,0,0,0,,сараң ~ сараң
Dialogue: 0,0:15:48.03,0:15:49.23,Default,,0,0,0,,Әке!
Dialogue: 0,0:15:49.32,0:15:50.86,Default,,0,0,0,,Есік емес!
Dialogue: 0,0:15:50.95,0:15:52.07,Default,,0,0,0,,«Сараң»
Dialogue: 0,0:15:52.15,0:15:54.16,Default,,0,0,0,,Есік, есек, есек әке!
Dialogue: 0,0:15:54.24,0:15:55.74,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:15:57.83,0:16:00.16,Default,,0,0,0,,А, өте дәмді болды.
Dialogue: 0,0:16:00.25,0:16:02.12,Default,,0,0,0,,Ауыз және ауыз жабысқақ.
Dialogue: 0,0:16:02.21,0:16:04.00,Default,,0,0,0,,Эй, мұнда кел.
Dialogue: 0,0:16:08.05,0:16:10.92,Default,,0,0,0,,Oh, now it's clean.
Dialogue: 0,0:16:11.01,0:16:12.63,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,0:16:13.84,0:16:15.39,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:16:15.47,0:16:16.72,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:17.39,0:16:19.52,Default,,0,0,0,,Mom wanted to eat with me too!
Dialogue: 0,0:16:22.85,0:16:24.77,Default,,0,0,0,,Mommy... I want to go there!
Dialogue: 0,0:16:24.85,0:16:26.52,Default,,0,0,0,,I want Mitchu (Mother) Yeah.
Dialogue: 0,0:16:27.73,0:16:31.74,Default,,0,0,0,,Дұрыс Мири, мен анаммен тамақтанғым келді.
Dialogue: 0,0:16:32.24,0:16:34.86,Default,,0,0,0,,Бірге жесең дәмді болады.
Dialogue: 0,0:16:34.95,0:16:36.49,Default,,0,0,0,,Милли дұрыс айтады.
Dialogue: 0,0:16:41.16,0:16:43.33,Default,,0,0,0,,Не болды? әке
Dialogue: 0,0:16:43.96,0:16:46.50,Default,,0,0,0,,Маған хабарлағаныңыз үшін рахмет.
Dialogue: 0,0:16:46.58,0:16:49.59,Default,,0,0,0,,Қитықтады~ Кяхаха!
Dialogue: 0,0:16:52.76,0:16:53.76,Default,,0,0,0,,Өткенге… электрондық хат па?
Dialogue: 0,0:16:54.26,0:16:55.93,Default,,0,0,0,,О, ештеңе.
Dialogue: 0,0:16:56.01,0:16:58.89,Default,,0,0,0,,Okay, what should we play next?
Dialogue: 0,0:16:58.97,0:17:01.68,Default,,0,0,0,,Милли Мен ойын ойнағым келеді!
Dialogue: 0,0:17:03.77,0:17:04.94,Default,,0,0,0,,Сәлем Нөл
Dialogue: 0,0:17:05.02,0:17:05.94,Default,,0,0,0,,Не?
Dialogue: 0,0:17:06.56,0:17:10.98,Default,,0,0,0,,Біз анамыздың бақытын тартып алдық па?
Dialogue: 0,0:17:11.78,0:17:12.69,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:17:13.90,0:17:16.41,Default,,0,0,0,,If I tell Miri the truth
Dialogue: 0,0:17:16.91,0:17:18.70,Default,,0,0,0,,Will you forgive me?
Dialogue: 0,0:17:19.78,0:17:22.16,Default,,0,0,0,,Айтсам да, қазір түсінбеймін.
Dialogue: 0,0:17:22.83,0:17:23.62,Default,,0,0,0,,Иә
Dialogue: 0,0:17:26.50,0:17:28.67,Default,,0,0,0,,Бүгін көңілді өтіңіз.
Dialogue: 0,0:17:29.79,0:17:32.05,Default,,0,0,0,,Let's go, Miri is waiting.
Dialogue: 0,0:17:39.97,0:17:42.22,Default,,0,0,0,,Zero Papa is so good!
Dialogue: 0,0:17:44.39,0:17:47.10,Default,,0,0,0,,Жарайды ма? Is it okay to have so many?
Dialogue: 0,0:17:47.19,0:17:49.94,Default,,0,0,0,,Ол үшін уайымдамаңыз, қалағаныңызша сатып алыңыз!
Dialogue: 0,0:17:50.02,0:17:54.36,Default,,0,0,0,,Мен ойында нашармын, бірақ әйелдерге ақша жұмсауда жақсымын.
Dialogue: 0,0:17:54.44,0:17:55.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:55.74,0:17:58.41,Default,,0,0,0,,Thank you Ikki Papa
Dialogue: 0,0:17:59.49,0:18:02.16,Default,,0,0,0,,I wore this at a Christmas party.
Dialogue: 0,0:18:02.24,0:18:03.87,Default,,0,0,0,,Иә, бұл сізге сәйкес келеді.
Dialogue: 0,0:18:03.95,0:18:05.75,Default,,0,0,0,,Сіз ханшайымға ұқсайсыз.
Dialogue: 0,0:18:05.83,0:18:09.42,Default,,0,0,0,,Хехехе, міндетті түрде келіңдер, көріңдер, әкелер!
Dialogue: 0,0:18:09.50,0:18:11.59,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:18:16.72,0:18:17.22,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:18:17.30,0:18:19.93,Default,,0,0,0,,Енді, бүгінгі күннің шарықтау шегі.
Dialogue: 0,0:18:20.51,0:18:22.60,Default,,0,0,0,,Такай!
Dialogue: 0,0:18:22.68,0:18:25.47,Default,,0,0,0,,Милли айналу дөңгелегі бірінші рет
Dialogue: 0,0:18:26.98,0:18:29.02,Default,,0,0,0,,Дөңгелегі қорқынышты ма?
Dialogue: 0,0:18:29.10,0:18:30.02,Default,,0,0,0,,Қорқынышты емес
Dialogue: 0,0:18:31.15,0:18:33.02,Default,,0,0,0,,Сіз алысты көре аласыз
Dialogue: 0,0:18:38.03,0:18:39.99,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:18:41.45,0:18:43.87,Default,,0,0,0,,Әдемі!
Dialogue: 0,0:18:44.79,0:18:46.41,Default,,0,0,0,,Бұл қорқынышты емес, солай ма?
Dialogue: 0,0:18:46.50,0:18:47.45,Default,,0,0,0,,Иә
Dialogue: 0,0:18:55.80,0:18:59.55,Default,,0,0,0,,Өткен қыста сен мысық алдың.
Dialogue: 0,0:19:00.80,0:19:01.84,Default,,0,0,0,,Ашулы
Dialogue: 0,0:19:02.34,0:19:04.93,Default,,0,0,0,,Менің айтқаным есіңде ме?
Dialogue: 0,0:19:06.06,0:19:06.97,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:19:08.14,0:19:10.31,Default,,0,0,0,,«Қатыспау – мейірімділік».
Dialogue: 0,0:19:15.90,0:19:19.65,Default,,0,0,0,,«Кейде жауапсыздыққа араласу өкінішті».
Dialogue: 0,0:19:20.24,0:19:22.74,Default,,0,0,0,,«Егер мен саған соңына дейін қамқорлық жасай алмасам...»
Dialogue: 0,0:19:23.32,0:19:25.74,Default,,0,0,0,,«Жартылай қимыл жасама»
Dialogue: 0,0:19:27.20,0:19:28.33,Default,,0,0,0,,тым кеш...
Dialogue: 0,0:19:28.83,0:19:32.37,Default,,0,0,0,,Маған бауыр басып қалған соң олай айтудың өзі жауыздық.
Dialogue: 0,0:19:33.17,0:19:34.79,Default,,0,0,0,,Қазір әлі уақыт бар
Dialogue: 0,0:19:35.46,0:19:36.30,Default,,0,0,0,,Сіз уақытындасыз ба?
Dialogue: 0,0:19:36.80,0:19:37.50,Default,,0,0,0,,Менде қандай да бір дарын бар адам сияқты көрінемін бе?
Dialogue: 0,0:19:39.05,0:19:40.26,Default,,0,0,0,,Қарапайым бақыт
Dialogue: 0,0:19:40.34,0:19:41.47,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:43.39,0:19:46.68,Default,,0,0,0,,Мен сенің гамбургер жеп, мәңгі күлгеніңді қалаймын.
Dialogue: 0,0:19:47.26,0:19:51.35,Default,,0,0,0,,Достармен төбелесу және жүгіруге жаттықтыру
Dialogue: 0,0:19:51.89,0:19:53.60,Default,,0,0,0,,Мен сенің ән айтқаныңды қалаймын.
Dialogue: 0,0:19:55.73,0:19:57.07,Default,,0,0,0,,Мен түсіндім, бірақ...
Dialogue: 0,0:19:57.61,0:20:02.36,Default,,0,0,0,,Қазір біз бір ғана нәрсе істей аламыз.
Dialogue: 0,0:20:07.49,0:20:10.12,Default,,0,0,0,,Ah, top, top!
Dialogue: 0,0:20:10.20,0:20:13.29,Default,,0,0,0,,Қарашы, қарашы, әке, мынау шың!
Dialogue: 0,0:20:13.87,0:20:15.42,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:20:15.50,0:20:17.38,Default,,0,0,0,,Бұл ең жақсы бөлік.
Dialogue: 0,0:20:17.46,0:20:18.84,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:20:18.92,0:20:19.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:21.17,0:20:22.05,Default,,0,0,0,,Жоспар
Dialogue: 0,0:20:28.22,0:20:30.31,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:20:31.39,0:20:32.31,Default,,0,0,0,,О
Dialogue: 0,0:20:33.31,0:20:35.65,Default,,0,0,0,,Бұл өте әдемі.
Dialogue: 0,0:20:41.57,0:20:44.07,Default,,0,0,0,,А, ол төмендеп жатыр...
Dialogue: 0,0:20:45.41,0:20:48.33,Default,,0,0,0,,Мен қазірдің өзінде көңілді болдым.
Dialogue: 0,0:20:49.16,0:20:52.91,Default,,0,0,0,,Миридің арқасында мен бұрын көрмеген табиғатты тамашаладым.
Dialogue: 0,0:20:55.17,0:20:58.46,Default,,0,0,0,,Арман уақыты аяқталды
Dialogue: 0,0:21:13.52,0:21:14.64,Default,,0,0,0,,Ана?
Dialogue: 0,0:21:15.14,0:21:19.40,Default,,0,0,0,,Бұл әкемнің соңғы тосын сыйы.
Dialogue: 0,0:21:19.48,0:21:23.03,Default,,0,0,0,,Бүгін мен анаммен жалғыз ұйықтап жатырмын.
Dialogue: 0,0:21:25.03,0:21:26.41,Default,,0,0,0,,Thank you, Dad!
Dialogue: 0,0:21:27.03,0:21:30.49,Default,,0,0,0,,Kyahahaha~!
Dialogue: 0,0:21:40.75,0:21:41.71,Default,,0,0,0,,Милли!
Dialogue: 0,0:21:42.34,0:21:42.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:51.60,0:21:53.27,Default,,0,0,0,,Суық тигізбе
Dialogue: 0,0:21:53.35,0:21:54.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:01.65,0:22:05.57,Default,,0,0,0,,Ертең кездескенше, папа!
Dialogue: 0,0:22:12.28,0:22:14.29,Default,,0,0,0,,♪～
Dialogue: 0,0:22:19.33,0:22:21.79,Default,,0,0,0,,We can't change
Dialogue: 0,0:22:22.88,0:22:23.71,Default,,0,0,0,,О
Dialogue: 0,0:23:58.93,0:24:00.93,Default,,0,0,0,,～♪
Dialogue: 0,0:24:02.43,0:24:08.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory