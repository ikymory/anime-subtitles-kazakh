Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.75,0:00:05.17,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:00:09.09,0:00:10.92,Default,,0,0,0,,Хаа~а
Dialogue: 0,0:00:11.88,0:00:15.39,Default,,0,0,0,,(Ойын дыбысы)
Dialogue: 0,0:00:21.47,0:00:23.52,Default,,0,0,0,,Сіз мұны қанша уақыттан бері істеп жүрсіз?
Dialogue: 0,0:00:24.02,0:00:25.65,Default,,0,0,0,,Таңертең ұйықтаңыз
Dialogue: 0,0:00:25.73,0:00:28.27,Default,,0,0,0,,Жоқ, қазірдің өзінде таң.
Dialogue: 0,0:00:31.94,0:00:33.15,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:00:33.99,0:00:35.41,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:00:49.59,0:00:50.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:57.59,0:01:00.85,Default,,0,0,0,,Қалғанын жіберуім керек...
Dialogue: 0,0:01:10.36,0:01:11.52,Default,,0,0,0,,(қағазды аудару дыбысы)
Dialogue: 0,0:01:12.03,0:01:12.57,Default,,0,0,0,,Ах
Dialogue: 0,0:01:18.95,0:01:22.83,Default,,0,0,0,,Әкелер, әрқашан рахмет!
Dialogue: 0,0:01:26.29,0:01:29.58,Default,,0,0,0,,Жарайды... Шаң басқан шығар.
Dialogue: 0,0:01:29.67,0:01:31.25,Default,,0,0,0,,Желдету керек
Dialogue: 0,0:01:32.25,0:01:35.17,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:01:39.51,0:01:41.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:06.89,0:03:08.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:27.49,0:03:29.08,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:03:32.96,0:03:33.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:45.51,0:03:47.43,Default,,0,0,0,,(қыздың күлкісі)
Dialogue: 0,0:03:49.68,0:03:51.73,Default,,0,0,0,,Бұл күндіз бірдеңе дұрыс емес.
Dialogue: 0,0:03:51.81,0:03:53.14,Default,,0,0,0,,Ол күдікті адам.
Dialogue: 0,0:03:53.23,0:03:55.27,Default,,0,0,0,,Полицияға хабарлауым керек пе?
Dialogue: 0,0:03:55.36,0:03:58.11,Default,,0,0,0,,Балаларды алыс ұстаңыз
Dialogue: 0,0:03:58.19,0:04:00.61,Default,,0,0,0,,Бұл Овакон Овакон ба?
Dialogue: 0,0:04:00.69,0:04:02.28,Default,,0,0,0,,Овакон дегеніміз не?
Dialogue: 0,0:04:02.36,0:04:03.74,Default,,0,0,0,,Бұл не? Нигоу
Dialogue: 0,0:04:03.82,0:04:05.53,Default,,0,0,0,,Не, сен білмейсің бе?
Dialogue: 0,0:04:05.62,0:04:06.37,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:04:07.12,0:04:08.62,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:04:08.70,0:04:10.20,Default,,0,0,0,,Бірақ Овакон
Dialogue: 0,0:04:10.70,0:04:13.87,Default,,0,0,0,,Бұл отбасы үшін қайғылы оқиға болды.
Dialogue: 0,0:04:13.96,0:04:15.00,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:04:15.08,0:04:17.50,Default,,0,0,0,,Бұл енді ешқашан қайталанбауы керек.
Dialogue: 0,0:04:17.59,0:04:19.88,Default,,0,0,0,,Әлсіреп қалма — жолды бөгеп тұрсың.
Dialogue: 0,0:04:28.68,0:04:31.02,Default,,0,0,0,,Темекі шегетініңді көрмеймін.
Dialogue: 0,0:04:31.10,0:04:32.18,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:04:33.27,0:04:37.19,Default,,0,0,0,,Темекі иісі, оны Мириге қоюға болмайды...
Dialogue: 0,0:04:37.27,0:04:38.36,Default,,0,0,0,,Мен мұны айттым ба?
Dialogue: 0,0:04:38.98,0:04:40.98,Default,,0,0,0,,Әй... мен айттым ба?
Dialogue: 0,0:04:44.70,0:04:48.62,Default,,0,0,0,,Мирисіз үйде соншалықты тыныш болса керек.
Dialogue: 0,0:04:49.45,0:04:51.87,Default,,0,0,0,,Мен сіздің ойыныңыздың дыбысын ғана естимін.
Dialogue: 0,0:04:52.45,0:04:54.58,Default,,0,0,0,,Тамақ та жиі кесілген.
Dialogue: 0,0:04:54.66,0:04:58.00,Default,,0,0,0,,Егер солай деп ойласаңыз, оны сізге жеткізуге болады.
Dialogue: 0,0:04:58.08,0:04:59.71,Default,,0,0,0,,Мен солай істейтінмін.
Dialogue: 0,0:05:01.63,0:05:02.55,Default,,0,0,0,,Миллиметр бұл...
Dialogue: 0,0:05:02.63,0:05:03.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:03.30,0:05:05.80,Default,,0,0,0,,Сіз дұрыс тамақтанып жатырсыз ба?
Dialogue: 0,0:05:08.26,0:05:11.06,Default,,0,0,0,,Уайымдама, мен сенімдімін
Dialogue: 0,0:05:15.64,0:05:18.90,Default,,0,0,0,,Жаңа жыл біткенде мен үйге барамын.
Dialogue: 0,0:05:18.98,0:05:22.15,Default,,0,0,0,,Иә? (Нөл) Маған кері қайтуды айтып жатыр.
Dialogue: 0,0:05:22.73,0:05:23.90,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:24.40,0:05:28.53,Default,,0,0,0,,Екеуміздің бірге болуымыздың мәні жоқ.
Dialogue: 0,0:05:28.61,0:05:30.70,Default,,0,0,0,,Мен саған мына бөлмені беремін.
Dialogue: 0,0:05:31.33,0:05:32.74,Default,,0,0,0,,Қалауыңызша пайдалана аласыз.
Dialogue: 0,0:05:33.49,0:05:34.58,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:35.16,0:05:38.54,Default,,0,0,0,,Жоқ, мен де кішкентай жерді іздеймін.
Dialogue: 0,0:05:38.62,0:05:42.30,Default,,0,0,0,,Бір адамның мұндай үлкен жерде жұмыс істеуі тым үлкен.
Dialogue: 0,0:05:44.63,0:05:45.59,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:05:46.09,0:05:49.34,Default,,0,0,0,,Мирисіз өмір қандай болды?
Dialogue: 0,0:05:49.84,0:05:51.22,Default,,0,0,0,,Мен есімде жоқ.
Dialogue: 0,0:05:52.39,0:05:53.93,Default,,0,0,0,,Икки (Икки) Иә?
Dialogue: 0,0:05:54.64,0:05:55.22,Default,,0,0,0,,О
Dialogue: 0,0:05:55.31,0:05:56.14,Default,,0,0,0,,Жасаңыз
Dialogue: 0,0:06:00.02,0:06:03.02,Default,,0,0,0,,Аа... бұл қоштасу.
Dialogue: 0,0:06:04.48,0:06:05.94,Default,,0,0,0,,Мүмкін… Сондықтан сендер
Dialogue: 0,0:06:06.03,0:06:08.20,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:06:08.28,0:06:10.32,Default,,0,0,0,,Бұл гамбургер!
Dialogue: 0,0:06:10.91,0:06:12.95,Default,,0,0,0,,Сізге ұнайды, солай ма? гамбургер
Dialogue: 0,0:06:13.03,0:06:13.95,Default,,0,0,0,,Маған ұнайды!
Dialogue: 0,0:06:14.04,0:06:15.33,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:06:18.54,0:06:19.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:23.59,0:06:24.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:24.30,0:06:27.22,Default,,0,0,0,,Мама, бұл әдеттегідей емес.
Dialogue: 0,0:06:28.76,0:06:31.43,Default,,0,0,0,,Дәмі анау арзан тағамнан да жақсы, солай ма?
Dialogue: 0,0:06:31.51,0:06:34.31,Default,,0,0,0,,Анашым, сіз оны жасау үшін көп еңбек еттіңіз.
Dialogue: 0,0:06:34.39,0:06:36.72,Default,,0,0,0,,Эй, сен де көкөніс жегің келе ме?
Dialogue: 0,0:06:37.31,0:06:40.94,Default,,0,0,0,,Анашым, осы уақытқа дейін мені төзгеніңіздің орнын толтыру үшін барымды саламын.
Dialogue: 0,0:06:41.02,0:06:41.98,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:46.19,0:06:48.44,Default,,0,0,0,,Милли Маған да бұл ұнайды!
Dialogue: 0,0:06:49.15,0:06:51.82,Default,,0,0,0,,Бүгін балабақшада не істедің?
Dialogue: 0,0:06:51.91,0:06:54.66,Default,,0,0,0,,Бүгін біз ән айтуға машықтанамыз!
Dialogue: 0,0:06:55.16,0:06:58.83,Default,,0,0,0,,Сіз білесіз бе? Анна-чан пианинода ойнағанда ғана қорқады!
Dialogue: 0,0:06:58.91,0:07:01.29,Default,,0,0,0,,Хехе, дұрыс.
Dialogue: 0,0:07:02.75,0:07:04.34,Default,,0,0,0,,Ах~
Dialogue: 0,0:07:04.92,0:07:08.38,Default,,0,0,0,,Ку-чан, сенің жұмысың жоқ па?
Dialogue: 0,0:07:08.46,0:07:11.30,Default,,0,0,0,,Енді сізге қалдыратын жұмыс жоқ.
Dialogue: 0,0:07:11.38,0:07:14.18,Default,,0,0,0,,Кез келген адам бәрін жасай алады.
Dialogue: 0,0:07:14.76,0:07:16.72,Default,,0,0,0,,Қараңызшы (Икки) А?
Dialogue: 0,0:07:16.81,0:07:19.31,Default,,0,0,0,,Оны әзірше өмір сүруге жұмсаңыз.
Dialogue: 0,0:07:20.02,0:07:22.81,Default,,0,0,0,,Қаринге бергенім осы емес пе?
Dialogue: 0,0:07:22.90,0:07:26.32,Default,,0,0,0,,Сізге қайтарылғанның бәрін қайтарыңыз!
Dialogue: 0,0:07:26.40,0:07:28.53,Default,,0,0,0,,Барлығын бірден берсеңіз, барлық соманы жұмсайсыз.
Dialogue: 0,0:07:28.61,0:07:30.95,Default,,0,0,0,,Сіз менің анамсыз ба?
Dialogue: 0,0:07:31.03,0:07:32.11,Default,,0,0,0,,Хаа~
Dialogue: 0,0:07:33.53,0:07:37.62,Default,,0,0,0,,Ол баланың өмірі мен ойлағаннан да үлкен болды ма?
Dialogue: 0,0:07:37.70,0:07:39.50,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:07:39.58,0:07:41.75,Default,,0,0,0,,Жоқ, нөлге не болды?
Dialogue: 0,0:07:42.46,0:07:44.75,Default,,0,0,0,,Ол ата-анасының үйіне қайтатынын айтты.
Dialogue: 0,0:07:44.83,0:07:47.00,Default,,0,0,0,,Бүгін тағы да таңертең шықтым.
Dialogue: 0,0:07:47.09,0:07:49.88,Default,,0,0,0,,Әкеңе сәлем беруге барған шығарсың.
Dialogue: 0,0:07:50.47,0:07:51.26,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:51.34,0:07:54.80,Default,,0,0,0,,Ол шынымен үйге бару керек пе?
Dialogue: 0,0:07:55.30,0:07:57.31,Default,,0,0,0,,Нөлдің таңдауы жоқ
Dialogue: 0,0:07:57.39,0:07:59.02,Default,,0,0,0,,Анау үй сондай.
Dialogue: 0,0:08:00.18,0:08:04.35,Default,,0,0,0,,Маған анау қария да, Нөл де ұнамайды.
Dialogue: 0,0:08:06.94,0:08:08.73,Default,,0,0,0,,Қайтып оралғыңыз келді ме?
Dialogue: 0,0:08:08.82,0:08:10.23,Default,,0,0,0,,Иә Бастық
Dialogue: 0,0:08:10.74,0:08:11.99,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:08:12.57,0:08:16.37,Default,,0,0,0,,Енді менің қасыма отырып, жұмысымды үйрен.
Dialogue: 0,0:08:17.07,0:08:21.29,Default,,0,0,0,,Сува отбасының маған бергенін мен саған беремін.
Dialogue: 0,0:08:21.79,0:08:25.12,Default,,0,0,0,,Бәрі де дәл солай, есінен танып қалмай.
Dialogue: 0,0:08:26.54,0:08:28.71,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:08:29.21,0:08:33.42,Default,,0,0,0,,♪ Тыныш түн!
Dialogue: 0,0:08:33.51,0:08:37.43,Default,,0,0,0,,♪ Қасиетті түн!
Dialogue: 0,0:08:37.51,0:08:41.93,Default,,0,0,0,,♪ Бәрі тыныш,
Dialogue: 0,0:08:42.02,0:08:44.85,Default,,0,0,0,,♪ бәрі жарқын,
Dialogue: 0,0:08:44.94,0:08:51.61,Default,,0,0,0,,♪ Жұмақтағы тыныштықта ұйықтаңыз.
Dialogue: 0,0:08:51.69,0:08:53.40,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:08:54.36,0:08:55.53,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:08:55.61,0:08:56.66,Default,,0,0,0,,Кяхаха!
Dialogue: 0,0:08:56.74,0:09:00.83,Default,,0,0,0,,Анна-чан да, Хината-чан да мені жақсы болғаным үшін мақтады!
Dialogue: 0,0:09:00.91,0:09:04.21,Default,,0,0,0,,Ол әншінің қызы, сондықтан бұл табиғи нәрсе.
Dialogue: 0,0:09:05.25,0:09:05.83,Default,,0,0,0,,Ах
Dialogue: 0,0:09:10.29,0:09:13.88,Default,,0,0,0,,Папа Икки мен Папа Зеро да мені мақтады.
Dialogue: 0,0:09:14.38,0:09:18.93,Default,,0,0,0,,Әкелер, мені алып кетуге қашан келесіздер?
Dialogue: 0,0:09:19.01,0:09:20.05,Default,,0,0,0,,Милли?
Dialogue: 0,0:09:20.72,0:09:23.72,Default,,0,0,0,,Бұл адамдар Миридің әкесі емес.
Dialogue: 0,0:09:23.81,0:09:24.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:25.06,0:09:28.56,Default,,0,0,0,,Папа Икки де, Папа Нөл де Миридің әкесі.
Dialogue: 0,0:09:29.06,0:09:32.28,Default,,0,0,0,,Папа Икки жақсы аспазшы.
Dialogue: 0,0:09:32.36,0:09:35.32,Default,,0,0,0,,Zero Papa ойындарда жақсы!
Dialogue: 0,0:09:35.40,0:09:38.82,Default,,0,0,0,,Бірақ олар маған шитаке саңырауқұлақтарын тамақтандыруға тырысады.
Dialogue: 0,0:09:38.91,0:09:42.24,Default,,0,0,0,,Бірақ Милли, мен әкелеріңді жақсы көремін.
Dialogue: 0,0:09:42.83,0:09:46.54,Default,,0,0,0,,Әкелер мен аналар, бірге болған жақсы.
Dialogue: 0,0:09:47.58,0:09:48.50,Default,,0,0,0,,Ана?
Dialogue: 0,0:09:48.58,0:09:51.38,Default,,0,0,0,,Сізді жалғыз сезінгенім үшін кешіріңіз.
Dialogue: 0,0:09:51.88,0:09:53.42,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:09:53.92,0:09:55.92,Default,,0,0,0,,Өйткені ол дұрыс өзгереді
Dialogue: 0,0:09:56.47,0:09:59.18,Default,,0,0,0,,Мен Миридің сүйікті анасы боламын.
Dialogue: 0,0:09:59.68,0:10:01.80,Default,,0,0,0,,(Мисакидің жылағаны)
Dialogue: 0,0:10:01.89,0:10:05.02,Default,,0,0,0,,Мири анасын жақсы көреді.
Dialogue: 0,0:10:06.56,0:10:08.39,Default,,0,0,0,,Жұмысты меңгеру алдында
Dialogue: 0,0:10:08.48,0:10:10.98,Default,,0,0,0,,Мен бір нәрсе істеуім керек.
Dialogue: 0,0:10:12.82,0:10:15.48,Default,,0,0,0,,Мен әлі істерімді реттеген жоқпын.
Dialogue: 0,0:10:20.24,0:10:20.91,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:22.37,0:10:25.20,Default,,0,0,0,,Сіз әлі де құлдықтасыз
Dialogue: 0,0:10:25.83,0:10:28.00,Default,,0,0,0,,Қолжетімсіз қуыршақ
Dialogue: 0,0:10:28.08,0:10:31.08,Default,,0,0,0,,Дүкен сөресіне мәңгілік қарайтын баладай
Dialogue: 0,0:10:31.58,0:10:33.96,Default,,0,0,0,,сонда байланыстырылған
Dialogue: 0,0:10:34.46,0:10:37.13,Default,,0,0,0,,Жақында ол сіздің бұғауларыңызға айналады.
Dialogue: 0,0:10:37.21,0:10:40.18,Default,,0,0,0,,Суваның атына дақ қалдырады.
Dialogue: 0,0:10:40.97,0:10:43.18,Default,,0,0,0,,Бірақ уайымдамаңыз
Dialogue: 0,0:10:43.76,0:10:45.51,Default,,0,0,0,,Мен оны өшіремін.
Dialogue: 0,0:10:50.19,0:10:52.06,Default,,0,0,0,,Миллиметрді ұстамаңыз
Dialogue: 0,0:10:52.56,0:10:54.48,Default,,0,0,0,,Жағымсыз еліктеулерді жасамаңыз
Dialogue: 0,0:10:55.15,0:10:57.15,Default,,0,0,0,,Кез келген жұмысты жақсы орындаңыз
Dialogue: 0,0:10:57.65,0:10:59.40,Default,,0,0,0,,Мен кез келген адамды өлтіремін
Dialogue: 0,0:10:59.49,0:11:01.28,Default,,0,0,0,,Бірақ Милли...
Dialogue: 0,0:11:01.36,0:11:04.16,Default,,0,0,0,,Өзінің табандылығы кедергі екенін айтады.
Dialogue: 0,0:11:04.24,0:11:05.87,Default,,0,0,0,,Бастық... (Сува) Нөл!
Dialogue: 0,0:11:05.95,0:11:08.70,Default,,0,0,0,,Сіз Сува отбасының мұрагерісіз.
Dialogue: 0,0:11:08.79,0:11:11.62,Default,,0,0,0,,Отбасының тарихын, қанын қорғау
Dialogue: 0,0:11:11.71,0:11:13.71,Default,,0,0,0,,Барлық шуды жою
Dialogue: 0,0:11:14.21,0:11:18.71,Default,,0,0,0,,Бұл Сува отбасының қазіргі басшысы ретінде менің жауапкершілігім.
Dialogue: 0,0:11:26.01,0:11:28.27,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:11:28.35,0:11:30.77,Default,,0,0,0,,Иә, иә, не болды?
Dialogue: 0,0:11:30.85,0:11:32.73,Default,,0,0,0,,Икки, сен қазір қайдасың?
Dialogue: 0,0:11:32.81,0:11:36.19,Default,,0,0,0,,Қайда... Мен Хиса-чанмен бірге үйге бара жатырмын.
Dialogue: 0,0:11:36.27,0:11:37.02,Default,,0,0,0,,А, кешкі ас...
Dialogue: 0,0:11:37.11,0:11:38.40,Default,,0,0,0,,Мириге барыңыз!
Dialogue: 0,0:11:38.90,0:11:40.19,Default,,0,0,0,,Өтінемін, асығыңыз!
Dialogue: 0,0:11:40.28,0:11:42.99,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:11:43.07,0:11:45.12,Default,,0,0,0,,Не, бірдеңені ұмыттың ба?
Dialogue: 0,0:11:45.20,0:11:47.45,Default,,0,0,0,,Хиса-чан, Миридің үйіне хабарлассам болады ма?
Dialogue: 0,0:11:47.54,0:11:50.29,Default,,0,0,0,,Оларға дереу кетуді айт!
Dialogue: 0,0:11:56.04,0:11:58.46,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:11:59.09,0:12:00.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:01.59,0:12:02.88,Default,,0,0,0,,Иә
Dialogue: 0,0:12:03.97,0:12:05.51,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:12:06.01,0:12:07.39,Default,,0,0,0,,Бұл курьерлік қызмет.
Dialogue: 0,0:12:07.47,0:12:08.97,Default,,0,0,0,,Үйге жеткізу?
Dialogue: 0,0:12:09.06,0:12:12.69,Default,,0,0,0,,Жіберуші Курусу мырза.
Dialogue: 0,0:12:12.77,0:12:14.60,Default,,0,0,0,,Бұл Миридің жүгі ме?
Dialogue: 0,0:12:19.61,0:12:20.36,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:29.79,0:12:30.95,Default,,0,0,0,,А...
Dialogue: 0,0:12:32.75,0:12:35.17,Default,,0,0,0,,Мистер Йошитоки
Dialogue: 0,0:12:36.83,0:12:37.33,Default,,0,0,0,,Гррр…
Dialogue: 0,0:12:38.34,0:12:40.00,Default,,0,0,0,,Мен абдырап қалдым.
Dialogue: 0,0:12:40.09,0:12:41.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:42.76,0:12:44.09,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:12:44.18,0:12:47.47,Default,,0,0,0,,"Неге? Неге мен?"
Dialogue: 0,0:12:47.97,0:12:49.56,Default,,0,0,0,,Бұл табиғи сұрақ.
Dialogue: 0,0:12:50.06,0:12:52.10,Default,,0,0,0,,Саған ешнәрсе жоқ
Dialogue: 0,0:12:52.93,0:12:56.81,Default,,0,0,0,,Клиенттің сізге деген өшпенділігі жоқ.
Dialogue: 0,0:12:56.90,0:12:58.36,Default,,0,0,0,,Қызыңызға да
Dialogue: 0,0:12:59.23,0:13:02.86,Default,,0,0,0,,Ол кісі үшін сенің өлімің ғана маңызды.
Dialogue: 0,0:13:03.90,0:13:04.78,Default,,0,0,0,,Милли…
Dialogue: 0,0:13:05.45,0:13:07.49,Default,,0,0,0,,Сұрақтарға жауап берілді
Dialogue: 0,0:13:07.99,0:13:11.95,Default,,0,0,0,,Енді соңғы сөзіңді айт.
Dialogue: 0,0:13:12.54,0:13:13.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:13.37,0:13:14.79,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:16.87,0:13:18.21,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:13:19.38,0:13:20.29,Default,,0,0,0,,Аһ!
Dialogue: 0,0:13:23.59,0:13:24.51,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:27.01,0:13:27.51,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:31.31,0:13:34.18,Default,,0,0,0,,Гах... нгх...
Dialogue: 0,0:13:34.27,0:13:38.98,Default,,0,0,0,,Какки Курусу Сен менің де мақсатымсың...
Dialogue: 0,0:13:40.61,0:13:41.27,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:42.36,0:13:43.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:43.48,0:13:44.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:46.24,0:13:47.78,Default,,0,0,0,,Дүрбелеңге түспеңіз
Dialogue: 0,0:13:47.86,0:13:50.70,Default,,0,0,0,,Алдымен әлгі әйелдің айтқанын тыңда.
Dialogue: 0,0:13:50.78,0:13:52.03,Default,,0,0,0,,Келесі менің қызым.
Dialogue: 0,0:13:52.83,0:13:56.54,Default,,0,0,0,,Менің бұлай демалуға уақытым жоқ шығар.
Dialogue: 0,0:13:56.62,0:13:57.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:57.54,0:13:59.79,Default,,0,0,0,,Сіз полицияның не екенін білесіз бе?
Dialogue: 0,0:13:59.88,0:14:04.55,Default,,0,0,0,,өтіңіз... Ол бейбітшілікті қорғайтын әділдіктің одақтасы сияқты.
Dialogue: 0,0:14:04.63,0:14:07.68,Default,,0,0,0,,Құжат бойынша бұл үшінші ставка.
Dialogue: 0,0:14:08.18,0:14:10.26,Default,,0,0,0,,Жақында бәрі бітеді.
Dialogue: 0,0:14:10.34,0:14:13.68,Default,,0,0,0,,Жоқ, бұл жерде біттіңіз.
Dialogue: 0,0:14:16.56,0:14:17.31,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:14:18.56,0:14:20.56,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,0:14:21.27,0:14:24.90,Default,,0,0,0,,Хехе... Мен миға жауаптымын.
Dialogue: 0,0:14:25.40,0:14:26.32,Default,,0,0,0,,Енді, нөл!
Dialogue: 0,0:14:33.20,0:14:33.91,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:34.41,0:14:37.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:39.21,0:14:40.88,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,0:14:40.96,0:14:43.13,Default,,0,0,0,,Дөрекі еліктеу
Dialogue: 0,0:14:43.67,0:14:45.88,Default,,0,0,0,,Хахаха, шынымен емес.
Dialogue: 0,0:14:45.96,0:14:48.63,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:14:48.72,0:14:51.14,Default,,0,0,0,,Полиция! Мылтығыңызды лақтырыңыз!
Dialogue: 0,0:14:52.14,0:14:53.64,Default,,0,0,0,,Уақыт таусылды.
Dialogue: 0,0:14:53.72,0:14:55.64,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:14:57.77,0:14:58.39,Default,,0,0,0,,Гах...
Dialogue: 0,0:14:58.48,0:15:01.56,Default,,0,0,0,,Мына әйелдің сөзін сізге қалдырамын.
Dialogue: 0,0:15:02.06,0:15:04.73,Default,,0,0,0,,Соңғы сәттеріңізді ойлаңыз
Dialogue: 0,0:15:05.23,0:15:09.15,Default,,0,0,0,,Сөздерің ақыры естілетін болады.
Dialogue: 0,0:15:09.65,0:15:11.86,Default,,0,0,0,,Қайғыдан қалтырап
Dialogue: 0,0:15:16.99,0:15:20.08,Default,,0,0,0,,Икки, нағыз полиция жақында...
Dialogue: 0,0:15:20.62,0:15:23.13,Default,,0,0,0,,Әй, өзіңді дайында.
Dialogue: 0,0:15:23.63,0:15:24.54,Default,,0,0,0,,Миллиметр…
Dialogue: 0,0:15:24.63,0:15:27.59,Default,,0,0,0,,Жоқ, барма, Мири жылайды!
Dialogue: 0,0:15:27.67,0:15:29.84,Default,,0,0,0,,Тіпті Рождестволық кеш бар...
Dialogue: 0,0:15:30.34,0:15:34.01,Default,,0,0,0,,Мири... артқы бөлмеде...
Dialogue: 0,0:15:36.97,0:15:39.39,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:15:39.48,0:15:40.43,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:15:40.52,0:15:42.52,Default,,0,0,0,,Кеттік! Миримен бірге қашыңыз
Dialogue: 0,0:15:43.10,0:15:47.23,Default,,0,0,0,,Мириді қорғаңыз...
Dialogue: 0,0:15:47.32,0:15:49.99,Default,,0,0,0,,Балаларын қорғау ата-ананың міндеті!
Dialogue: 0,0:15:50.49,0:15:53.91,Default,,0,0,0,,Онда ол қыздан кешірім сұра.
Dialogue: 0,0:15:54.53,0:15:57.79,Default,,0,0,0,,Кешіріңіз, мен Рождестволық кешке бара алмадым.
Dialogue: 0,0:15:57.87,0:15:59.04,Default,,0,0,0,,Тоқта
Dialogue: 0,0:15:59.12,0:16:01.62,Default,,0,0,0,,Сәлем! Мириді жалғыз қалдырмаңыз
Dialogue: 0,0:16:01.71,0:16:03.67,Default,,0,0,0,,Оған ата-ана керек!
Dialogue: 0,0:16:03.75,0:16:05.63,Default,,0,0,0,,Менің отбасым бар!
Dialogue: 0,0:16:07.34,0:16:08.30,Default,,0,0,0,,Екі...
Dialogue: 0,0:16:17.89,0:16:21.81,Default,,0,0,0,,Ата-анам соңына дейін өзімшіл болды...
Dialogue: 0,0:16:22.39,0:16:23.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:24.98,0:16:25.65,Default,,0,0,0,,Миллиметр…
Dialogue: 0,0:16:26.15,0:16:27.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:32.36,0:16:36.28,Default,,0,0,0,,(Полиция көлігінің жақындаған сиренасы)
Dialogue: 0,0:16:36.37,0:16:39.54,Default,,0,0,0,,Кеттік. Осында қалсам, қиналып қаламын.
Dialogue: 0,0:16:50.42,0:16:51.55,Default,,0,0,0,,Жара туралы не деуге болады?
Dialogue: 0,0:16:51.63,0:16:53.84,Default,,0,0,0,,Бұл қатты ауырады, бірақ...
Dialogue: 0,0:16:55.13,0:16:57.30,Default,,0,0,0,,Оқ тесіп кетті, әйтеуір...
Dialogue: 0,0:16:57.39,0:16:58.72,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:59.26,0:17:00.64,Default,,0,0,0,,Миллиметр
Dialogue: 0,0:17:00.72,0:17:03.85,Default,,0,0,0,,Оны полицияға тапсырған дұрыс болар еді...
Dialogue: 0,0:17:03.93,0:17:07.44,Default,,0,0,0,,Егер бұлай болса, Мири де сен туралы айтады.
Dialogue: 0,0:17:08.31,0:17:11.28,Default,,0,0,0,,Полиция шақырған себебім Огинодан құтылу болды.
Dialogue: 0,0:17:16.74,0:17:18.70,Default,,0,0,0,,Бұл Хиса Чанның үйі ме?
Dialogue: 0,0:17:19.37,0:17:21.70,Default,,0,0,0,,Менің үйімді Сува отбасы да біледі.
Dialogue: 0,0:17:22.29,0:17:24.62,Default,,0,0,0,,Бұл жер қауіпсіз үй сияқты.
Dialogue: 0,0:17:25.16,0:17:27.04,Default,,0,0,0,,Бұл біраз уақытқа дейін қауіпсіз болады.
Dialogue: 0,0:17:27.12,0:17:29.33,Default,,0,0,0,,Нөл үшін бе? (Кутаро) Маған айтты.
Dialogue: 0,0:17:29.42,0:17:30.84,Default,,0,0,0,,(Есікті қағу)
Dialogue: 0,0:17:31.84,0:17:32.80,Default,,0,0,0,,Миллиметрлер ше?
Dialogue: 0,0:17:33.30,0:17:35.05,Default,,0,0,0,,(жүгіріп бара жатқан дыбыс)
Dialogue: 0,0:17:36.30,0:17:39.14,Default,,0,0,0,,Мен тірімін...хаха~
Dialogue: 0,0:17:39.22,0:17:42.10,Default,,0,0,0,,Мири Хана анасына келсек...
Dialogue: 0,0:17:42.60,0:17:43.97,Default,,0,0,0,,Милли бұл...
Dialogue: 0,0:17:44.56,0:17:45.52,Default,,0,0,0,,Мен оны көрген жоқпын.
Dialogue: 0,0:17:45.60,0:17:48.69,Default,,0,0,0,,Мири әлі анасының қайтыс болғанын білмейді.
Dialogue: 0,0:17:48.77,0:17:50.06,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:17:56.36,0:17:57.82,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:58.61,0:18:00.62,Default,,0,0,0,,Хиса-чан неге кешірім сұрады?
Dialogue: 0,0:18:00.70,0:18:03.41,Default,,0,0,0,,Бастық нөлге тексеру жүргізді.
Dialogue: 0,0:18:03.49,0:18:04.83,Default,,0,0,0,,О, әрине — бұл уақыт машинасы ғой.
Dialogue: 0,0:18:05.37,0:18:10.00,Default,,0,0,0,,Сондықтан мен Мириді сенен айырып, анасына қайтардым.
Dialogue: 0,0:18:10.88,0:18:13.30,Default,,0,0,0,,Мен сенімен барлық байланысты үзгенімше
Dialogue: 0,0:18:13.38,0:18:15.51,Default,,0,0,0,,Егер бастық араласпаса...
Dialogue: 0,0:18:16.38,0:18:18.30,Default,,0,0,0,,Мен ол кісіні бағаламадым.
Dialogue: 0,0:18:18.80,0:18:20.01,Default,,0,0,0,,Мұның бәрі менің жауапкершілігім.
Dialogue: 0,0:18:21.51,0:18:24.35,Default,,0,0,0,,Жоқ, мен оны Мириден алдым.
Dialogue: 0,0:18:25.35,0:18:28.44,Default,,0,0,0,,Әке, ана, бәрі...
Dialogue: 0,0:18:29.44,0:18:32.77,Default,,0,0,0,,Ана... Мм...
Dialogue: 0,0:18:33.52,0:18:35.53,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:18:35.61,0:18:38.86,Default,,0,0,0,,Мири оянғанда тамақ болады.
Dialogue: 0,0:18:38.95,0:18:40.32,Default,,0,0,0,,Сізге де
Dialogue: 0,0:18:48.75,0:18:50.04,Default,,0,0,0,,Қызыл теңіз
Dialogue: 0,0:18:50.87,0:18:52.67,Default,,0,0,0,,Миллидің бар болуын өшіріңіз
Dialogue: 0,0:18:53.17,0:18:57.42,Default,,0,0,0,,Жалған өлім және Миридің барлық іздерін өшіру
Dialogue: 0,0:18:57.51,0:19:01.43,Default,,0,0,0,,Сосын мен оны алыстағы қарттар үйіне қалдырамын.
Dialogue: 0,0:19:02.18,0:19:05.43,Default,,0,0,0,,About Miri... protect her.
Dialogue: 0,0:19:05.51,0:19:08.35,Default,,0,0,0,,Мені ешкім жете алмайтын жерге апарыңыз
Dialogue: 0,0:19:08.85,0:19:12.44,Default,,0,0,0,,Біз енді Миридің алдынан шықпаймыз.
Dialogue: 0,0:19:13.06,0:19:16.36,Default,,0,0,0,,Ата-анам соңына дейін өзімшіл болды...
Dialogue: 0,0:19:16.86,0:19:17.94,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:18.90,0:19:19.82,Default,,0,0,0,,Миллиметр…
Dialogue: 0,0:19:20.74,0:19:23.66,Default,,0,0,0,,Өйткені, біз астыртын бизнестегі адамдармыз.
Dialogue: 0,0:19:24.16,0:19:25.83,Default,,0,0,0,,Мен Мириді де қорғаймын.
Dialogue: 0,0:19:25.91,0:19:28.33,Default,,0,0,0,,I can't even make you happy!
Dialogue: 0,0:19:30.66,0:19:32.96,Default,,0,0,0,,I... want to adopt Miri.
Dialogue: 0,0:19:33.04,0:19:35.21,Default,,0,0,0,,Hah... Don't be stupid.
Dialogue: 0,0:19:35.71,0:19:37.84,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,0:19:37.92,0:19:39.46,Default,,0,0,0,,Ештеңе істеу мүмкін болмады
Dialogue: 0,0:19:39.97,0:19:41.72,Default,,0,0,0,,Тіпті тырыспады
Dialogue: 0,0:19:41.80,0:19:45.14,Default,,0,0,0,,Шындықтан бет бұрып, әкеңнен қаш
Dialogue: 0,0:19:45.64,0:19:47.97,Default,,0,0,0,,It was just a breathing doll.
Dialogue: 0,0:19:48.89,0:19:50.39,Default,,0,0,0,,Бұл жақсы болды
Dialogue: 0,0:19:51.39,0:19:53.48,Default,,0,0,0,,Бірақ мен білдім
Dialogue: 0,0:19:54.56,0:19:56.32,Default,,0,0,0,,That someone's hands are warm
Dialogue: 0,0:19:58.28,0:20:00.74,Default,,0,0,0,,That there is a comfortable place
Dialogue: 0,0:20:00.82,0:20:01.74,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:20:01.82,0:20:04.91,Default,,0,0,0,,Мириді жалғыз қалдырсақ не болады?
Dialogue: 0,0:20:05.41,0:20:07.37,Default,,0,0,0,,Taking away my parents from Miri
Dialogue: 0,0:20:07.45,0:20:10.29,Default,,0,0,0,,Do you forget without making any amends?
Dialogue: 0,0:20:10.83,0:20:12.04,Default,,0,0,0,,Алдағыны ойлайлық.
Dialogue: 0,0:20:12.54,0:20:14.46,Default,,0,0,0,,Менің Миримен енді ешқандай қатысым болмауы керек.
Dialogue: 0,0:20:14.54,0:20:16.13,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:20:16.21,0:20:18.63,Default,,0,0,0,,We have to protect it, right?
Dialogue: 0,0:20:18.71,0:20:19.88,Default,,0,0,0,,Ойлан
Dialogue: 0,0:20:19.96,0:20:22.09,Default,,0,0,0,,What can we do for Miri?
Dialogue: 0,0:20:22.17,0:20:25.30,Default,,0,0,0,,You're better at thinking, Ikki!
Dialogue: 0,0:20:25.80,0:20:27.55,Default,,0,0,0,,We're going to change.
Dialogue: 0,0:20:28.06,0:20:30.18,Default,,0,0,0,,This time, make Miri happy!
Dialogue: 0,0:20:30.27,0:20:31.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:34.85,0:20:35.77,Default,,0,0,0,,If Ikki
Dialogue: 0,0:20:35.85,0:20:38.61,Default,,0,0,0,,Ол баланы да қуанта алатыныңызға сенімдімін.
Dialogue: 0,0:20:42.82,0:20:44.53,Default,,0,0,0,,Ана?
Dialogue: 0,0:20:46.62,0:20:48.28,Default,,0,0,0,,Әлсіреп қалма — жолды бөгеп тұрсың.
Dialogue: 0,0:20:48.37,0:20:50.04,Default,,0,0,0,,Миллиметр?
Dialogue: 0,0:20:50.12,0:20:54.54,Default,,0,0,0,,Papa Ikki, Papa Zero, why are you here?
Dialogue: 0,0:20:54.62,0:20:57.54,Default,,0,0,0,,Huh... What about mom?
Dialogue: 0,0:20:57.63,0:21:00.13,Default,,0,0,0,,Мұнда қайда?
Dialogue: 0,0:21:00.21,0:21:01.26,Default,,0,0,0,,Миллиметр…
Dialogue: 0,0:21:04.01,0:21:07.01,Default,,0,0,0,,Анам бір шаруаны орындау үшін сыртқа шығуы керек.
Dialogue: 0,0:21:07.09,0:21:09.76,Default,,0,0,0,,Сонымен біз қайтадан біргеміз
Dialogue: 0,0:21:10.35,0:21:12.10,Default,,0,0,0,,Анам да сенімен бірге ме?
Dialogue: 0,0:21:12.18,0:21:14.56,Default,,0,0,0,,Ах, қайтып келсеңші.
Dialogue: 0,0:21:14.64,0:21:16.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:18.69,0:21:21.86,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:21:22.44,0:21:23.24,Default,,0,0,0,,Аа...
Dialogue: 0,0:21:23.74,0:21:25.78,Default,,0,0,0,,Ауысыммен ұйықтау
Dialogue: 0,0:21:25.86,0:21:28.16,Default,,0,0,0,,Don't skip picking up and dropping off at nursery school.
Dialogue: 0,0:21:28.24,0:21:28.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:28.95,0:21:31.99,Default,,0,0,0,,And brushing your teeth after taking a bath.
Dialogue: 0,0:21:32.58,0:21:35.00,Default,,0,0,0,,I'll make the food, but I'll help you clean up.
Dialogue: 0,0:21:35.54,0:21:38.50,Default,,0,0,0,,When washing dishes, put away dry dishes first.
Dialogue: 0,0:21:39.08,0:21:42.63,Default,,0,0,0,,Шаң сору кезінде астындағы заттарды алып тастаңыз
Dialogue: 0,0:21:42.71,0:21:44.38,Default,,0,0,0,,Осындай ұсақ бөлшектер
Dialogue: 0,0:21:44.46,0:21:47.43,Default,,0,0,0,,I read on the internet that children grow up watching.
Dialogue: 0,0:21:47.51,0:21:48.26,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:48.34,0:21:49.18,Default,,0,0,0,,Иә
Dialogue: 0,0:21:49.68,0:21:51.68,Default,,0,0,0,,Себебі мен көп нәрсені тастадым.
Dialogue: 0,0:21:51.76,0:21:55.10,Default,,0,0,0,,At the very least, I will ask you to follow the rules of the household.
Dialogue: 0,0:21:55.18,0:21:55.89,Default,,0,0,0,,Иә
Dialogue: 0,0:21:58.10,0:21:59.73,Default,,0,0,0,,Ойын... (Икки) күніне 1 сағат
Dialogue: 0,0:21:59.81,0:22:00.69,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:22:03.36,0:22:04.36,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:22:05.61,0:22:06.70,Default,,0,0,0,,Не болды?
Dialogue: 0,0:22:06.78,0:22:07.95,Default,,0,0,0,,Хиса-чан
Dialogue: 0,0:22:08.03,0:22:11.41,Default,,0,0,0,,Біз өлтіруші ретінде жұмыстан шығамыз.
Dialogue: 0,0:22:12.33,0:22:13.41,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:22:13.49,0:22:16.12,Default,,0,0,0,,Біз Миридің әкесі боламыз.
Dialogue: 0,0:22:16.20,0:22:18.12,Default,,0,0,0,,♪～
Dialogue: 0,0:22:18.21,0:22:22.21,Default,,0,0,0,,Do you intend to carry on with a false relationship while still carrying the burden of sin?
Dialogue: 0,0:22:22.71,0:22:24.84,Default,,0,0,0,,Өтірік айтпа
Dialogue: 0,0:22:25.34,0:22:29.47,Default,,0,0,0,,Бұл жолы біз нағыз отбасы боламыз.
Dialogue: 0,0:23:58.85,0:24:00.85,Default,,0,0,0,,～♪
Dialogue: 0,0:24:02.35,0:24:08.35,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory