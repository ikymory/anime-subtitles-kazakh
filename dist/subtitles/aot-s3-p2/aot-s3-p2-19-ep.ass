Dialogue: 0,0:21:11.23,0:21:12.34,JP,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:21:13.48,0:21:16.50,JP,,0000,0000,0000,,Осы Титанды тірі ұста
Dialogue: 0,0:21:21.52,0:21:23.42,JP,,0000,0000,0000,,Ерен, көрдің бе?
Dialogue: 0,0:21:23.54,0:21:25.35,JP,,0000,0000,0000,,Біз сол Титанды қолға түсірдік
Dialogue: 0,0:21:26.01,0:21:28.10,JP,,0000,0000,0000,,Бұл – Зерттеу корпусының күші
Dialogue: 0,0:21:28.10,0:21:29.89,JP,,0000,0000,0000,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:21:30.00,0:21:31.64,JP,,0000,0000,0000,,Енді түсіндің бе?
Dialogue: 0,0:21:33.59,0:21:34.55,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:21:38.90,0:21:40.79,JP,,0000,0000,0000,,Қозғалысын тоқтатқан сияқты
Dialogue: 0,0:21:41.66,0:21:43.03,JP,,0000,0000,0000,,Әлі де сақ болуымыз керек
Dialogue: 0,0:21:43.78,0:21:47.09,JP,,0000,0000,0000,,Дегенмен, оны дәл осы жерге алдап әкелгенің үшін жақсы істедің
Dialogue: 0,0:21:48.63,0:21:51.71,JP,,0000,0000,0000,,Соғыста өмірлерін қатерге тіккен артқы жасаққа рахмет
Dialogue: 0,0:21:52.07,0:21:53.44,JP,,0000,0000,0000,,Өзімізге біраз уақыт сатып алдық
Dialogue: 0,0:21:54.51,0:21:56.35,JP,,0000,0000,0000,,Олар болмаса, бұл мүмкін болмас еді
Dialogue: 0,0:21:57.22,0:21:58.24,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:21:58.68,0:21:59.74,JP,,0000,0000,0000,,Иә.
Dialogue: 0,0:22:01.64,0:22:03.21,JP,,0000,0000,0000,,Оларға рахмет
Dialogue: 0,0:22:03.56,0:22:06.25,JP,,0000,0000,0000,,Осы сұмның мойын артына кіріп жатқан жанмен кездесе аламыз
Dialogue: 0,0:22:08.97,0:22:11.68,JP,,0000,0000,0000,,Тек ішіне зәр шығарып алмаса екен.
Dialogue: 0,0:23:53.74,0:23:55.97,JP,,0000,0000,0000,,Сендер, қылыштарыңды тартыңдар!
