Dialogue: 0,0:04:16.71,0:04:21.39,JP,,0000,0000,0000,,Егер ол өзін көрсетсе,
Dialogue: 0,0:04:25.66,0:04:27.00,JP,,0000,0000,0000,,Тағы біреу қаза тапты.
Dialogue: 0,0:04:27.87,0:04:29.97,JP,,0000,0000,0000,,Біз оны құтқара алар едік.
Dialogue: 0,0:04:33.83,0:04:37.03,JP,,0000,0000,0000,,Ол тез.
